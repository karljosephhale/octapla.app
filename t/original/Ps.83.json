[{"ref":"Ps.83.1","start":19083001,"end":19083001,"break":"paragraph","text":"שִׁ֖יר מִזְמ֣וֹר לְאָסָֽף׃"},{"ref":"Ps.83.2","start":19083001,"end":19083001,"break":"none","text":"אֱלֹהִ֥ים אַל־דֳּמִי־לָ֑ךְ אַל־תֶּחֱרַ֖שׁ וְאַל־תִּשְׁקֹ֣ט אֵֽל׃"},{"ref":"Ps.83.3","start":19083002,"end":19083002,"break":"none","text":"כִּֽי־הִנֵּ֣ה א֭וֹיְבֶיךָ יֶהֱמָי֑וּן וּ֝מְשַׂנְאֶ֗יךָ נָ֣שְׂאוּ רֹֽאשׁ׃"},{"ref":"Ps.83.4","start":19083003,"end":19083003,"break":"none","text":"עַֽל־עַ֭מְּךָ יַעֲרִ֣ימוּ ס֑וֹד וְ֝יִתְיָעֲצ֗וּ עַל־צְפוּנֶֽיךָ׃"},{"ref":"Ps.83.5","start":19083004,"end":19083004,"break":"none","text":"אָמְר֗וּ לְ֭כוּ וְנַכְחִידֵ֣ם מִגּ֑וֹי וְלֹֽא־יִזָּכֵ֖ר שֵֽׁם־יִשְׂרָאֵ֣ל עֽוֹד׃"},{"ref":"Ps.83.6","start":19083005,"end":19083005,"break":"none","text":"כִּ֤י נוֹעֲצ֣וּ לֵ֣ב יַחְדָּ֑ו עָ֝לֶ֗יךָ בְּרִ֣ית יִכְרֹֽתוּ׃"},{"ref":"Ps.83.7","start":19083006,"end":19083006,"break":"none","text":"אָהֳלֵ֣י אֱ֭דוֹם וְיִשְׁמְעֵאלִ֗ים מוֹאָ֥ב וְהַגְרִֽים׃"},{"ref":"Ps.83.8","start":19083007,"end":19083007,"break":"none","text":"גְּבָ֣ל וְ֭עַמּוֹן וַעֲמָלֵ֑ק פְּ֝לֶ֗שֶׁת עִם־יֹ֥שְׁבֵי צֽוֹר׃"},{"ref":"Ps.83.9","start":19083008,"end":19083008,"break":"none","text":"גַּם־אַ֭שּׁוּר נִלְוָ֣ה עִמָּ֑ם הָ֤י֥וּ זְר֖וֹעַ לִבְנֵי־ל֣וֹט סֶֽלָה׃"},{"ref":"Ps.83.10","start":19083009,"end":19083009,"break":"none","text":"עֲשֵֽׂה־לָהֶ֥ם כְּמִדְיָ֑ן כְּֽסִֽיסְרָ֥א כְ֝יָבִ֗ין בְּנַ֣חַל קִישֽׁוֹן׃"},{"ref":"Ps.83.11","start":19083010,"end":19083010,"break":"none","text":"נִשְׁמְד֥וּ בְֽעֵין־דֹּ֑אר הָ֥יוּ דֹּ֝֗מֶן לָאֲדָמָֽה׃"},{"ref":"Ps.83.12","start":19083011,"end":19083011,"break":"none","text":"שִׁיתֵ֣מוֹ נְ֭דִיבֵמוֹ כְּעֹרֵ֣ב וְכִזְאֵ֑ב וּֽכְזֶ֥בַח וּ֝כְצַלְמֻנָּ֗ע כָּל־נְסִיכֵֽמוֹ׃"},{"ref":"Ps.83.13","start":19083012,"end":19083012,"break":"none","text":"אֲשֶׁ֣ר אָ֭מְרוּ נִ֣ירֲשָׁה לָּ֑נוּ אֵ֝֗ת נְא֣וֹת אֱלֹהִֽים׃"},{"ref":"Ps.83.14","start":19083013,"end":19083013,"break":"none","text":"אֱֽלֹהַ֗י שִׁיתֵ֥מוֹ כַגַּלְגַּ֑ל כְּ֝קַ֗שׁ לִפְנֵי־רֽוּחַ׃"},{"ref":"Ps.83.15","start":19083014,"end":19083014,"break":"none","text":"כְּאֵ֥שׁ תִּבְעַר־יָ֑עַר וּ֝כְלֶהָבָ֗ה תְּלַהֵ֥ט הָרִֽים׃"},{"ref":"Ps.83.16","start":19083015,"end":19083015,"break":"none","text":"כֵּ֭ן תִּרְדְּפֵ֣ם בְּסַעֲרֶ֑ךָ וּבְסוּפָתְךָ֥ תְבַהֲלֵֽם׃"},{"ref":"Ps.83.17","start":19083016,"end":19083016,"break":"none","text":"מַלֵּ֣א פְנֵיהֶ֣ם קָל֑וֹן וִֽיבַקְשׁ֖וּ שִׁמְךָ֣ יְהוָֽה׃"},{"ref":"Ps.83.18","start":19083017,"end":19083017,"break":"none","text":"יֵבֹ֖שׁוּ וְיִבָּהֲל֥וּ עֲדֵי־עַ֗ד וְֽיַחְפְּר֥וּ וְיֹאבֵֽדוּ׃"},{"ref":"Ps.83.19","start":19083018,"end":19083018,"break":"none","text":"וְֽיֵדְע֗וּ כִּֽי־אַתָּ֬ה שִׁמְךָ֣ יְהוָ֣ה לְבַדֶּ֑ךָ עֶ֝לְי֗וֹן עַל־כָּל־הָאָֽרֶץ׃"}]