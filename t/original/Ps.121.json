[{"ref":"Ps.121.1","start":19121001,"end":19121001,"break":"paragraph","text":"שִׁ֗יר לַֽמַּ֫עֲל֥וֹת אֶשָּׂ֣א עֵ֭ינַי אֶל־הֶהָרִ֑ים מֵ֝אַ֗יִן יָבֹ֥א עֶזְרִֽי׃"},{"ref":"Ps.121.2","start":19121002,"end":19121002,"break":"none","text":"עֶ֭זְרִי מֵעִ֣ם יְהוָ֑ה עֹ֝שֵׂ֗ה שָׁמַ֥יִם וָאָֽרֶץ׃"},{"ref":"Ps.121.3","start":19121003,"end":19121003,"break":"none","text":"אַל־יִתֵּ֣ן לַמּ֣וֹט רַגְלֶ֑ךָ אַל־יָ֝נ֗וּם שֹֽׁמְרֶֽךָ׃"},{"ref":"Ps.121.4","start":19121004,"end":19121004,"break":"none","text":"הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃"},{"ref":"Ps.121.5","start":19121005,"end":19121005,"break":"none","text":"יְהוָ֥ה שֹׁמְרֶ֑ךָ יְהוָ֥ה צִ֝לְּךָ֗ עַל־יַ֥ד יְמִינֶֽךָ׃"},{"ref":"Ps.121.6","start":19121006,"end":19121006,"break":"none","text":"יוֹמָ֗ם הַשֶּׁ֥מֶשׁ לֹֽא־יַכֶּ֗כָּה וְיָרֵ֥חַ בַּלָּֽיְלָה׃"},{"ref":"Ps.121.7","start":19121007,"end":19121007,"break":"none","text":"יְֽהוָ֗ה יִשְׁמָרְךָ֥ מִכָּל־רָ֑ע יִ֝שְׁמֹ֗ר אֶת־נַפְשֶֽׁךָ׃"},{"ref":"Ps.121.8","start":19121008,"end":19121008,"break":"none","text":"יְֽהוָ֗ה יִשְׁמָר־צֵאתְךָ֥ וּבוֹאֶ֑ךָ מֵֽ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃"}]