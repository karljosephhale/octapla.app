[{"ref":"Ps.130.1","start":19130001,"end":19130001,"break":"paragraph","text":"שִׁ֥יר הַֽמַּעֲל֑וֹת מִמַּעֲמַקִּ֖ים קְרָאתִ֣יךָ יְהוָֽה׃"},{"ref":"Ps.130.2","start":19130002,"end":19130002,"break":"none","text":"אֲדֹנָי֮ שִׁמְעָ֪ה בְק֫וֹלִ֥י תִּהְיֶ֣ינָה אָ֭זְנֶיךָ קַשֻּׁב֑וֹת לְ֝ק֗וֹל תַּחֲנוּנָֽי׃"},{"ref":"Ps.130.3","start":19130003,"end":19130003,"break":"none","text":"אִם־עֲוֺנ֥וֹת תִּשְׁמָר־יָ֑הּ אֲ֝דֹנָ֗י מִ֣י יַעֲמֹֽד׃"},{"ref":"Ps.130.4","start":19130004,"end":19130004,"break":"none","text":"כִּֽי־עִמְּךָ֥ הַסְּלִיחָ֑ה לְ֝מַ֗עַן תִּוָּרֵֽא׃"},{"ref":"Ps.130.5","start":19130005,"end":19130005,"break":"none","text":"קִוִּ֣יתִי יְ֭הוָה קִוְּתָ֣ה נַפְשִׁ֑י וְֽלִדְבָר֥וֹ הוֹחָֽלְתִּי׃"},{"ref":"Ps.130.6","start":19130006,"end":19130006,"break":"none","text":"נַפְשִׁ֥י לַֽאדֹנָ֑י מִשֹּׁמְרִ֥ים לַ֝בֹּ֗קֶר שֹׁמְרִ֥ים לַבֹּֽקֶר׃"},{"ref":"Ps.130.7","start":19130007,"end":19130007,"break":"none","text":"יַחֵ֥ל יִשְׂרָאֵ֗ל אֶל־יְה֫וָה כִּֽי־עִם־יְהוָ֥ה הַחֶ֑סֶד וְהַרְבֵּ֖ה עִמּ֣וֹ פְדֽוּת׃"},{"ref":"Ps.130.8","start":19130008,"end":19130008,"break":"none","text":"וְ֭הוּא יִפְדֶּ֣ה אֶת־יִשְׂרָאֵ֑ל מִ֝כֹּ֗ל עֲוֺנֹתָֽיו׃"}]