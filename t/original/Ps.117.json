[{"ref":"Ps.117.1","start":19117001,"end":19117001,"break":"paragraph","text":"הַֽלְל֣וּ אֶת־יְ֭הוָה כָּל־גּוֹיִ֑ם שַׁ֝בְּח֗וּהוּ כָּל־הָאֻמִּֽים׃"},{"ref":"Ps.117.2","start":19117002,"end":19117002,"break":"none","text":"כִּ֥י גָ֘בַ֤ר עָלֵ֨ינוּ ׀ חַסְדּ֗וֹ וֶֽאֱמֶת־יְהוָ֥ה לְעוֹלָ֗ם הַֽלְלוּ־יָֽהּ׃"}]