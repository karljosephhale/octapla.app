[{"ref":"Job.26.1","start":18026001,"end":18026001,"break":"paragraph","text":"וַיַּ֥עַן אִיּ֗וֹב וַיֹּאמַֽר׃"},{"ref":"Job.26.2","start":18026002,"end":18026002,"break":"none","text":"מֶה־עָזַ֥רְתָּ לְלֹא־כֹ֑חַ ה֝וֹשַׁ֗עְתָּ זְר֣וֹעַ לֹא־עֹֽז׃"},{"ref":"Job.26.3","start":18026003,"end":18026003,"break":"none","text":"מַה־יָּ֭עַצְתָּ לְלֹ֣א חָכְמָ֑ה וְ֝תוּשִׁיָּ֗ה לָרֹ֥ב הוֹדָֽעְתָּ׃"},{"ref":"Job.26.4","start":18026004,"end":18026004,"break":"none","text":"אֶת־מִ֭י הִגַּ֣דְתָּ מִלִּ֑ין וְנִשְׁמַת־מִ֝י יָצְאָ֥ה מִמֶּֽךָּ׃"},{"ref":"Job.26.5","start":18026005,"end":18026005,"break":"none","text":"הָרְפָאִ֥ים יְחוֹלָ֑לוּ מִתַּ֥חַת מַ֝֗יִם וְשֹׁכְנֵיהֶֽם׃"},{"ref":"Job.26.6","start":18026006,"end":18026006,"break":"none","text":"עָר֣וֹם שְׁא֣וֹל נֶגְדּ֑וֹ וְאֵ֥ין כְּ֝ס֗וּת לָֽאֲבַדּֽוֹן׃"},{"ref":"Job.26.7","start":18026007,"end":18026007,"break":"none","text":"נֹטֶ֣ה צָפ֣וֹן עַל־תֹּ֑הוּ תֹּ֥לֶה אֶ֝֗רֶץ עַל־בְּלִי־מָֽה׃"},{"ref":"Job.26.8","start":18026008,"end":18026008,"break":"none","text":"צֹרֵֽר־מַ֥יִם בְּעָבָ֑יו וְלֹא־נִבְקַ֖ע עָנָ֣ן תַּחְתָּֽם׃"},{"ref":"Job.26.9","start":18026009,"end":18026009,"break":"none","text":"מְאַחֵ֥ז פְּנֵי־כִסֵּ֑ה פַּרְשֵׁ֖ז עָלָ֣יו עֲנָנֽוֹ׃"},{"ref":"Job.26.10","start":18026010,"end":18026010,"break":"none","text":"חֹֽק־חָ֭ג עַל־פְּנֵי־מָ֑יִם עַד־תַּכְלִ֖ית א֣וֹר עִם־חֹֽשֶׁךְ׃"},{"ref":"Job.26.11","start":18026011,"end":18026011,"break":"none","text":"עַמּוּדֵ֣י שָׁמַ֣יִם יְרוֹפָ֑פוּ וְ֝יִתְמְה֗וּ מִגַּעֲרָתֽוֹ׃"},{"ref":"Job.26.12","start":18026012,"end":18026012,"break":"none","text":"בְּ֭כֹחוֹ רָגַ֣ע הַיָּ֑ם ובתובנתו מָ֣חַץ רָֽהַב׃"},{"ref":"Job.26.13","start":18026013,"end":18026013,"break":"none","text":"בְּ֭רוּחוֹ שָׁמַ֣יִם שִׁפְרָ֑ה חֹֽלֲלָ֥ה יָ֝ד֗וֹ נָחָ֥שׁ בָּרִֽיחַ׃"},{"ref":"Job.26.14","start":18026014,"end":18026014,"break":"none","section":"setumah","text":"הֶן־אֵ֤לֶּה ׀ קְצ֬וֹת דרכו וּמַה־שֵּׁ֣מֶץ דָּ֭בָר נִשְׁמַע־בּ֑וֹ וְרַ֥עַם גבורתו מִ֣י יִתְבּוֹנָֽן׃"}]