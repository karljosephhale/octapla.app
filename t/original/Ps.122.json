[{"ref":"Ps.122.1","start":19122001,"end":19122001,"break":"paragraph","text":"שִׁ֥יר הַֽמַּעֲל֗וֹת לְדָ֫וִ֥ד שָׂ֭מַחְתִּי בְּאֹמְרִ֣ים לִ֑י בֵּ֖ית יְהוָ֣ה נֵלֵֽךְ׃"},{"ref":"Ps.122.2","start":19122002,"end":19122002,"break":"none","text":"עֹ֭מְדוֹת הָי֣וּ רַגְלֵ֑ינוּ בִּ֝שְׁעָרַ֗יִךְ יְרוּשָׁלִָֽם׃"},{"ref":"Ps.122.3","start":19122003,"end":19122003,"break":"none","text":"יְרוּשָׁלִַ֥ם הַבְּנוּיָ֑ה כְּ֝עִ֗יר שֶׁחֻבְּרָה־לָּ֥הּ יַחְדָּֽו׃"},{"ref":"Ps.122.4","start":19122004,"end":19122004,"break":"none","text":"שֶׁשָּׁ֨ם עָל֪וּ שְׁבָטִ֡ים שִׁבְטֵי־יָ֭הּ עֵד֣וּת לְיִשְׂרָאֵ֑ל לְ֝הֹד֗וֹת לְשֵׁ֣ם יְהוָֽה׃"},{"ref":"Ps.122.5","start":19122005,"end":19122005,"break":"none","text":"כִּ֤י שָׁ֨מָּה ׀ יָשְׁב֣וּ כִסְא֣וֹת לְמִשְׁפָּ֑ט כִּ֝סְא֗וֹת לְבֵ֣ית דָּוִֽיד׃"},{"ref":"Ps.122.6","start":19122006,"end":19122006,"break":"none","text":"שַׁ֭אֲלוּ שְׁל֣וֹם יְרוּשָׁלִָ֑ם יִ֝שְׁלָ֗יוּ אֹהֲבָֽיִךְ׃"},{"ref":"Ps.122.7","start":19122007,"end":19122007,"break":"none","text":"יְהִֽי־שָׁל֥וֹם בְּחֵילֵ֑ךְ שַׁ֝לְוָ֗ה בְּאַרְמְנוֹתָֽיִךְ׃"},{"ref":"Ps.122.8","start":19122008,"end":19122008,"break":"none","text":"לְ֭מַעַן אַחַ֣י וְרֵעָ֑י אֲדַבְּרָה־נָּ֖א שָׁל֣וֹם בָּֽךְ׃"},{"ref":"Ps.122.9","start":19122009,"end":19122009,"break":"none","text":"לְ֭מַעַן בֵּית־יְהוָ֣ה אֱלֹהֵ֑ינוּ אֲבַקְשָׁ֖ה ט֣וֹב לָֽךְ׃"}]