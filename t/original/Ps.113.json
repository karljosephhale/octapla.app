[{"ref":"Ps.113.1","start":19113001,"end":19113001,"break":"paragraph","text":"הַ֥לְלוּ יָ֨הּ ׀ הַ֭לְלוּ עַבְדֵ֣י יְהוָ֑ה הַֽ֝לְלוּ אֶת־שֵׁ֥ם יְהוָֽה׃"},{"ref":"Ps.113.2","start":19113002,"end":19113002,"break":"none","text":"יְהִ֤י שֵׁ֣ם יְהוָ֣ה מְבֹרָ֑ךְ מֵֽ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃"},{"ref":"Ps.113.3","start":19113003,"end":19113003,"break":"none","text":"מִמִּזְרַח־שֶׁ֥מֶשׁ עַד־מְבוֹא֑וֹ מְ֝הֻלָּ֗ל שֵׁ֣ם יְהוָֽה׃"},{"ref":"Ps.113.4","start":19113004,"end":19113004,"break":"none","text":"רָ֖ם עַל־כָּל־גּוֹיִ֥ם ׀ יְהוָ֑ה עַ֖ל הַשָּׁמַ֣יִם כְּבוֹדֽוֹ׃"},{"ref":"Ps.113.5","start":19113005,"end":19113005,"break":"none","text":"מִ֭י כַּיהוָ֣ה אֱלֹהֵ֑ינוּ הַֽמַּגְבִּיהִ֥י לָשָֽׁבֶת׃"},{"ref":"Ps.113.6","start":19113006,"end":19113006,"break":"none","text":"הַֽמַּשְׁפִּילִ֥י לִרְא֑וֹת בַּשָּׁמַ֥יִם וּבָאָֽרֶץ׃"},{"ref":"Ps.113.7","start":19113007,"end":19113007,"break":"none","text":"מְקִֽימִ֣י מֵעָפָ֣ר דָּ֑ל מֵֽ֝אַשְׁפֹּ֗ת יָרִ֥ים אֶבְיֽוֹן׃"},{"ref":"Ps.113.8","start":19113008,"end":19113008,"break":"none","text":"לְהוֹשִׁיבִ֥י עִם־נְדִיבִ֑ים עִ֝֗ם נְדִיבֵ֥י עַמּֽוֹ׃"},{"ref":"Ps.113.9","start":19113009,"end":19113009,"break":"none","text":"מֽוֹשִׁיבִ֨י ׀ עֲקֶ֬רֶת הַבַּ֗יִת אֵֽם־הַבָּנִ֥ים שְׂמֵחָ֗ה הַֽלְלוּ־יָֽהּ׃"}]