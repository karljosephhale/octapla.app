[{"ref":"Ps.119.1","start":19119001,"end":19119001,"break":"paragraph","text":"אַשְׁרֵ֥י תְמִֽימֵי־דָ֑רֶךְ הַֽ֝הֹלְכִ֗ים בְּתוֹרַ֥ת יְהוָֽה׃"},{"ref":"Ps.119.2","start":19119002,"end":19119002,"break":"none","text":"אַ֭שְׁרֵי נֹצְרֵ֥י עֵדֹתָ֗יו בְּכָל־לֵ֥ב יִדְרְשֽׁוּהוּ׃"},{"ref":"Ps.119.3","start":19119003,"end":19119003,"break":"none","text":"אַ֭ף לֹֽא־פָעֲל֣וּ עַוְלָ֑ה בִּדְרָכָ֥יו הָלָֽכוּ׃"},{"ref":"Ps.119.4","start":19119004,"end":19119004,"break":"none","text":"אַ֭תָּה צִוִּ֥יתָה פִקֻּדֶ֗יךָ לִשְׁמֹ֥ר מְאֹֽד׃"},{"ref":"Ps.119.5","start":19119005,"end":19119005,"break":"none","text":"אַ֭חֲלַי יִכֹּ֥נוּ דְרָכָ֗י לִשְׁמֹ֥ר חֻקֶּֽיךָ׃"},{"ref":"Ps.119.6","start":19119006,"end":19119006,"break":"none","text":"אָ֥ז לֹא־אֵב֑וֹשׁ בְּ֝הַבִּיטִ֗י אֶל־כָּל־מִצְוֺתֶֽיךָ׃"},{"ref":"Ps.119.7","start":19119007,"end":19119007,"break":"none","text":"א֭וֹדְךָ בְּיֹ֣שֶׁר לֵבָ֑ב בְּ֝לָמְדִ֗י מִשְׁפְּטֵ֥י צִדְקֶֽךָ׃"},{"ref":"Ps.119.8","start":19119008,"end":19119008,"break":"none","text":"אֶת־חֻקֶּ֥יךָ אֶשְׁמֹ֑ר אַֽל־תַּעַזְבֵ֥נִי עַד־מְאֹֽד׃"},{"ref":"Ps.119.9","start":19119009,"end":19119009,"break":"none","text":"בַּמֶּ֣ה יְזַכֶּה־נַּ֭עַר אֶת־אָרְח֑וֹ לִ֝שְׁמֹ֗ר כִּדְבָרֶֽךָ׃"},{"ref":"Ps.119.10","start":19119010,"end":19119010,"break":"none","text":"בְּכָל־לִבִּ֥י דְרַשְׁתִּ֑יךָ אַל־תַּ֝שְׁגֵּ֗נִי מִמִּצְוֺתֶֽיךָ׃"},{"ref":"Ps.119.11","start":19119011,"end":19119011,"break":"none","text":"בְּ֭לִבִּי צָפַ֣נְתִּי אִמְרָתֶ֑ךָ לְ֝מַ֗עַן לֹ֣א אֶֽחֱטָא־לָֽךְ׃"},{"ref":"Ps.119.12","start":19119012,"end":19119012,"break":"none","text":"בָּר֖וּךְ אַתָּ֥ה יְהוָ֗ה לַמְּדֵ֥נִי חֻקֶּֽיךָ׃"},{"ref":"Ps.119.13","start":19119013,"end":19119013,"break":"none","text":"בִּשְׂפָתַ֥י סִפַּ֑רְתִּי כֹּ֝֗ל מִשְׁפְּטֵי־פִֽיךָ׃"},{"ref":"Ps.119.14","start":19119014,"end":19119014,"break":"none","text":"בְּדֶ֖רֶךְ עֵדְוֺתֶ֥יךָ שַׂ֗שְׂתִּי כְּעַ֣ל כָּל־הֽוֹן׃"},{"ref":"Ps.119.15","start":19119015,"end":19119015,"break":"none","text":"בְּפִקֻּדֶ֥יךָ אָשִׂ֑יחָה וְ֝אַבִּ֗יטָה אֹרְחֹתֶֽיךָ׃"},{"ref":"Ps.119.16","start":19119016,"end":19119016,"break":"none","text":"בְּחֻקֹּתֶ֥יךָ אֶֽשְׁתַּעֲשָׁ֑ע לֹ֭א אֶשְׁכַּ֣ח דְּבָרֶֽךָ׃"},{"ref":"Ps.119.17","start":19119017,"end":19119017,"break":"none","text":"גְּמֹ֖ל עַֽל־עַבְדְּךָ֥ אֶֽחְיֶ֗ה וְאֶשְׁמְרָ֥ה דְבָרֶֽךָ׃"},{"ref":"Ps.119.18","start":19119018,"end":19119018,"break":"none","text":"גַּל־עֵינַ֥י וְאַבִּ֑יטָה נִ֝פְלָא֗וֹת מִתּוֹרָתֶֽךָ׃"},{"ref":"Ps.119.19","start":19119019,"end":19119019,"break":"none","text":"גֵּ֣ר אָנֹכִ֣י בָאָ֑רֶץ אַל־תַּסְתֵּ֥ר מִ֝מֶּ֗נִּי מִצְוֺתֶֽיךָ׃"},{"ref":"Ps.119.20","start":19119020,"end":19119020,"break":"none","text":"גָּרְסָ֣ה נַפְשִׁ֣י לְתַאֲבָ֑ה אֶֽל־מִשְׁפָּטֶ֥יךָ בְכָל־עֵֽת׃"},{"ref":"Ps.119.21","start":19119021,"end":19119021,"break":"none","text":"גָּ֭עַרְתָּ זֵדִ֣ים אֲרוּרִ֑ים הַ֝שֹּׁגִים מִמִּצְוֺתֶֽיךָ׃"},{"ref":"Ps.119.22","start":19119022,"end":19119022,"break":"none","text":"גַּ֣ל מֵֽ֭עָלַי חֶרְפָּ֣ה וָב֑וּז כִּ֖י עֵדֹתֶ֣יךָ נָצָֽרְתִּי׃"},{"ref":"Ps.119.23","start":19119023,"end":19119023,"break":"none","text":"גַּ֤ם יָֽשְׁב֣וּ שָׂ֭רִים בִּ֣י נִדְבָּ֑רוּ עַ֝בְדְּךָ֗ יָשִׂ֥יחַ בְּחֻקֶּֽיךָ׃"},{"ref":"Ps.119.24","start":19119024,"end":19119024,"break":"none","text":"גַּֽם־עֵ֭דֹתֶיךָ שַׁעֲשֻׁעָ֗י אַנְשֵׁ֥י עֲצָתִֽי׃"},{"ref":"Ps.119.25","start":19119025,"end":19119025,"break":"none","text":"דָּֽבְקָ֣ה לֶעָפָ֣ר נַפְשִׁ֑י חַ֝יֵּ֗נִי כִּדְבָרֶֽךָ׃"},{"ref":"Ps.119.26","start":19119026,"end":19119026,"break":"none","text":"דְּרָכַ֣י סִ֭פַּרְתִּי וַֽתַּעֲנֵ֗נִי לַמְּדֵ֥נִי חֻקֶּֽיךָ׃"},{"ref":"Ps.119.27","start":19119027,"end":19119027,"break":"none","text":"דֶּֽרֶךְ־פִּקּוּדֶ֥יךָ הֲבִינֵ֑נִי וְ֝אָשִׂ֗יחָה בְּנִפְלְאוֹתֶֽיךָ׃"},{"ref":"Ps.119.28","start":19119028,"end":19119028,"break":"none","text":"דָּלְפָ֣ה נַ֭פְשִׁי מִתּוּגָ֑ה קַ֝יְּמֵ֗נִי כִּדְבָרֶֽךָ׃"},{"ref":"Ps.119.29","start":19119029,"end":19119029,"break":"none","text":"דֶּֽרֶךְ־שֶׁ֭קֶר הָסֵ֣ר מִמֶּ֑נִּי וְֽתוֹרָתְךָ֥ חָנֵּֽנִי׃"},{"ref":"Ps.119.30","start":19119030,"end":19119030,"break":"none","text":"דֶּֽרֶךְ־אֱמוּנָ֥ה בָחָ֑רְתִּי מִשְׁפָּטֶ֥יךָ שִׁוִּֽיתִי׃"},{"ref":"Ps.119.31","start":19119031,"end":19119031,"break":"none","text":"דָּבַ֥קְתִּי בְעֵֽדְוֺתֶ֑יךָ יְ֝הוָ֗ה אַל־תְּבִישֵֽׁנִי׃"},{"ref":"Ps.119.32","start":19119032,"end":19119032,"break":"none","text":"דֶּֽרֶךְ־מִצְוֺתֶ֥יךָ אָר֑וּץ כִּ֖י תַרְחִ֣יב לִבִּֽי׃"},{"ref":"Ps.119.33","start":19119033,"end":19119033,"break":"none","text":"הוֹרֵ֣נִי יְ֭הוָה דֶּ֥רֶךְ חֻקֶּ֗יךָ וְאֶצְּרֶ֥נָּה עֵֽקֶב׃"},{"ref":"Ps.119.34","start":19119034,"end":19119034,"break":"none","text":"הֲ֭בִינֵנִי וְאֶצְּרָ֥ה תֽוֹרָתֶ֗ךָ וְאֶשְׁמְרֶ֥נָּה בְכָל־לֵֽב׃"},{"ref":"Ps.119.35","start":19119035,"end":19119035,"break":"none","text":"הַ֭דְרִיכֵנִי בִּנְתִ֣יב מִצְוֺתֶ֑יךָ כִּי־ב֥וֹ חָפָֽצְתִּי׃"},{"ref":"Ps.119.36","start":19119036,"end":19119036,"break":"none","text":"הַט־לִ֭בִּי אֶל־עֵדְוֺתֶ֗יךָ וְאַ֣ל אֶל־בָּֽצַע׃"},{"ref":"Ps.119.37","start":19119037,"end":19119037,"break":"none","text":"הַעֲבֵ֣ר עֵ֭ינַי מֵרְא֣וֹת שָׁ֑וְא בִּדְרָכֶ֥ךָ חַיֵּֽנִי׃"},{"ref":"Ps.119.38","start":19119038,"end":19119038,"break":"none","text":"הָקֵ֣ם לְ֭עַבְדְּךָ אִמְרָתֶ֑ךָ אֲ֝שֶׁ֗ר לְיִרְאָתֶֽךָ׃"},{"ref":"Ps.119.39","start":19119039,"end":19119039,"break":"none","text":"הַעֲבֵ֣ר חֶ֭רְפָּתִי אֲשֶׁ֣ר יָגֹ֑רְתִּי כִּ֖י מִשְׁפָּטֶ֣יךָ טוֹבִֽים׃"},{"ref":"Ps.119.40","start":19119040,"end":19119040,"break":"none","text":"הִ֭נֵּה תָּאַ֣בְתִּי לְפִקֻּדֶ֑יךָ בְּצִדְקָתְךָ֥ חַיֵּֽנִי׃"},{"ref":"Ps.119.41","start":19119041,"end":19119041,"break":"none","text":"וִֽיבֹאֻ֣נִי חֲסָדֶ֣ךָ יְהוָ֑ה תְּ֝שֽׁוּעָתְךָ֗ כְּאִמְרָתֶֽךָ׃"},{"ref":"Ps.119.42","start":19119042,"end":19119042,"break":"none","text":"וְאֶֽעֱנֶ֣ה חֹרְפִ֣י דָבָ֑ר כִּֽי־בָ֝טַחְתִּי בִּדְבָרֶֽךָ׃"},{"ref":"Ps.119.43","start":19119043,"end":19119043,"break":"none","text":"וְֽאַל־תַּצֵּ֬ל מִפִּ֣י דְבַר־אֱמֶ֣ת עַד־מְאֹ֑ד כִּ֖י לְמִשְׁפָּטֶ֣ךָ יִחָֽלְתִּי׃"},{"ref":"Ps.119.44","start":19119044,"end":19119044,"break":"none","text":"וְאֶשְׁמְרָ֖ה תוֹרָתְךָ֥ תָמִ֗יד לְעוֹלָ֥ם וָעֶֽד׃"},{"ref":"Ps.119.45","start":19119045,"end":19119045,"break":"none","text":"וְאֶתְהַלְּכָ֥ה בָרְחָבָ֑ה כִּ֖י פִקֻּדֶ֣יךָ דָרָֽשְׁתִּי׃"},{"ref":"Ps.119.46","start":19119046,"end":19119046,"break":"none","text":"וַאֲדַבְּרָ֣ה בְ֭עֵדֹתֶיךָ נֶ֥גֶד מְלָכִ֗ים וְלֹ֣א אֵבֽוֹשׁ׃"},{"ref":"Ps.119.47","start":19119047,"end":19119047,"break":"none","text":"וְאֶשְׁתַּֽעֲשַׁ֥ע בְּמִצְוֺתֶ֗יךָ אֲשֶׁ֣ר אָהָֽבְתִּי׃"},{"ref":"Ps.119.48","start":19119048,"end":19119048,"break":"none","text":"וְאֶשָּֽׂא־כַפַּ֗י אֶֽל־מִ֭צְוֺתֶיךָ אֲשֶׁ֥ר אָהָ֗בְתִּי וְאָשִׂ֥יחָה בְחֻקֶּֽיךָ׃"},{"ref":"Ps.119.49","start":19119049,"end":19119049,"break":"none","text":"זְכֹר־דָּבָ֥ר לְעַבְדֶּ֑ךָ עַ֝֗ל אֲשֶׁ֣ר יִֽחַלְתָּֽנִי׃"},{"ref":"Ps.119.50","start":19119050,"end":19119050,"break":"none","text":"זֹ֣את נֶחָמָתִ֣י בְעָנְיִ֑י כִּ֖י אִמְרָתְךָ֣ חִיָּֽתְנִי׃"},{"ref":"Ps.119.51","start":19119051,"end":19119051,"break":"none","text":"זֵ֭דִים הֱלִיצֻ֣נִי עַד־מְאֹ֑ד מִ֝תּֽוֹרָתְךָ֗ לֹ֣א נָטִֽיתִי׃"},{"ref":"Ps.119.52","start":19119052,"end":19119052,"break":"none","text":"זָ֘כַ֤רְתִּי מִשְׁפָּטֶ֖יךָ מֵעוֹלָ֥ם ׀ יְהוָ֗ה וָֽאֶתְנֶחָֽם׃"},{"ref":"Ps.119.53","start":19119053,"end":19119053,"break":"none","text":"זַלְעָפָ֣ה אֲ֭חָזַתְנִי מֵרְשָׁעִ֑ים עֹ֝זְבֵ֗י תּוֹרָתֶֽךָ׃"},{"ref":"Ps.119.54","start":19119054,"end":19119054,"break":"none","text":"זְ֭מִרוֹת הָֽיוּ־לִ֥י חֻקֶּ֗יךָ בְּבֵ֣ית מְגוּרָֽי׃"},{"ref":"Ps.119.55","start":19119055,"end":19119055,"break":"none","text":"זָ֘כַ֤רְתִּי בַלַּ֣יְלָה שִׁמְךָ֣ יְהוָ֑ה וָֽ֝אֶשְׁמְרָ֗ה תּוֹרָתֶֽךָ׃"},{"ref":"Ps.119.56","start":19119056,"end":19119056,"break":"none","text":"זֹ֥את הָֽיְתָה־לִּ֑י כִּ֖י פִקֻּדֶ֣יךָ נָצָֽרְתִּי׃"},{"ref":"Ps.119.57","start":19119057,"end":19119057,"break":"none","text":"חֶלְקִ֖י יְהוָ֥ה אָמַ֗רְתִּי לִשְׁמֹ֥ר דְּבָרֶֽיךָ׃"},{"ref":"Ps.119.58","start":19119058,"end":19119058,"break":"none","text":"חִלִּ֣יתִי פָנֶ֣יךָ בְכָל־לֵ֑ב חָ֝נֵּ֗נִי כְּאִמְרָתֶֽךָ׃"},{"ref":"Ps.119.59","start":19119059,"end":19119059,"break":"none","text":"חִשַּׁ֥בְתִּי דְרָכָ֑י וָאָשִׁ֥יבָה רַ֝גְלַ֗י אֶל־עֵדֹתֶֽיךָ׃"},{"ref":"Ps.119.60","start":19119060,"end":19119060,"break":"none","text":"חַ֭שְׁתִּי וְלֹ֣א הִתְמַהְמָ֑הְתִּי לִ֝שְׁמֹ֗ר מִצְוֺתֶֽיךָ׃"},{"ref":"Ps.119.61","start":19119061,"end":19119061,"break":"none","text":"חֶבְלֵ֣י רְשָׁעִ֣ים עִוְּדֻ֑נִי תּֽ֝וֹרָתְךָ֗ לֹ֣א שָׁכָֽחְתִּי׃"},{"ref":"Ps.119.62","start":19119062,"end":19119062,"break":"none","text":"חֲצֽוֹת־לַ֗יְלָה אָ֭קוּם לְהוֹד֣וֹת לָ֑ךְ עַ֝֗ל מִשְׁפְּטֵ֥י צִדְקֶֽךָ׃"},{"ref":"Ps.119.63","start":19119063,"end":19119063,"break":"none","text":"חָבֵ֣ר אָ֭נִי לְכָל־אֲשֶׁ֣ר יְרֵא֑וּךָ וּ֝לְשֹׁמְרֵ֗י פִּקּוּדֶֽיךָ׃"},{"ref":"Ps.119.64","start":19119064,"end":19119064,"break":"none","text":"חַסְדְּךָ֣ יְ֭הוָה מָלְאָ֥ה הָאָ֗רֶץ חֻקֶּ֥יךָ לַמְּדֵֽנִי׃"},{"ref":"Ps.119.65","start":19119065,"end":19119065,"break":"none","text":"ט֭וֹב עָשִׂ֣יתָ עִֽם־עַבְדְּךָ֑ יְ֝הוָ֗ה כִּדְבָרֶֽךָ׃"},{"ref":"Ps.119.66","start":19119066,"end":19119066,"break":"none","text":"ט֤וּב טַ֣עַם וָדַ֣עַת לַמְּדֵ֑נִי כִּ֖י בְמִצְוֺתֶ֣יךָ הֶאֱמָֽנְתִּי׃"},{"ref":"Ps.119.67","start":19119067,"end":19119067,"break":"none","text":"טֶ֣רֶם אֶ֭עֱנֶה אֲנִ֣י שֹׁגֵ֑ג וְ֝עַתָּ֗ה אִמְרָתְךָ֥ שָׁמָֽרְתִּי׃"},{"ref":"Ps.119.68","start":19119068,"end":19119068,"break":"none","text":"טוֹב־אַתָּ֥ה וּמֵטִ֗יב לַמְּדֵ֥נִי חֻקֶּֽיךָ׃"},{"ref":"Ps.119.69","start":19119069,"end":19119069,"break":"none","text":"טָפְל֬וּ עָלַ֣י שֶׁ֣קֶר זֵדִ֑ים אֲ֝נִ֗י בְּכָל־לֵ֤ב ׀ אֱצֹּ֬ר פִּקּוּדֶֽיךָ׃"},{"ref":"Ps.119.70","start":19119070,"end":19119070,"break":"none","text":"טָפַ֣שׁ כַּחֵ֣לֶב לִבָּ֑ם אֲ֝נִ֗י תּוֹרָתְךָ֥ שִֽׁעֲשָֽׁעְתִּי׃"},{"ref":"Ps.119.71","start":19119071,"end":19119071,"break":"none","text":"טֽוֹב־לִ֥י כִֽי־עֻנֵּ֑יתִי לְ֝מַ֗עַן אֶלְמַ֥ד חֻקֶּֽיךָ׃"},{"ref":"Ps.119.72","start":19119072,"end":19119072,"break":"none","text":"טֽוֹב־לִ֥י תֽוֹרַת־פִּ֑יךָ מֵ֝אַלְפֵ֗י זָהָ֥ב וָכָֽסֶף׃"},{"ref":"Ps.119.73","start":19119073,"end":19119073,"break":"none","text":"יָדֶ֣יךָ עָ֭שׂוּנִי וַֽיְכוֹנְנ֑וּנִי הֲ֝בִינֵ֗נִי וְאֶלְמְדָ֥ה מִצְוֺתֶֽיךָ׃"},{"ref":"Ps.119.74","start":19119074,"end":19119074,"break":"none","text":"יְ֭רֵאֶיךָ יִרְא֣וּנִי וְיִשְׂמָ֑חוּ כִּ֖י לִדְבָרְךָ֣ יִחָֽלְתִּי׃"},{"ref":"Ps.119.75","start":19119075,"end":19119075,"break":"none","text":"יָדַ֣עְתִּי יְ֭הוָה כִּי־צֶ֣דֶק מִשְׁפָּטֶ֑יךָ וֶ֝אֱמוּנָ֗ה עִנִּיתָֽנִי׃"},{"ref":"Ps.119.76","start":19119076,"end":19119076,"break":"none","text":"יְהִי־נָ֣א חַסְדְּךָ֣ לְנַחֲמֵ֑נִי כְּאִמְרָתְךָ֥ לְעַבְדֶּֽךָ׃"},{"ref":"Ps.119.77","start":19119077,"end":19119077,"break":"none","text":"יְבֹא֣וּנִי רַחֲמֶ֣יךָ וְאֶֽחְיֶ֑ה כִּי־תֽ֝וֹרָתְךָ֗ שַֽׁעֲשֻׁעָֽי׃"},{"ref":"Ps.119.78","start":19119078,"end":19119078,"break":"none","text":"יֵבֹ֣שׁוּ זֵ֭דִים כִּי־שֶׁ֣קֶר עִוְּת֑וּנִי אֲ֝נִ֗י אָשִׂ֥יחַ בְּפִקּוּדֶֽיךָ׃"},{"ref":"Ps.119.79","start":19119079,"end":19119079,"break":"none","text":"יָשׁ֣וּבוּ לִ֣י יְרֵאֶ֑יךָ וידעו עֵדֹתֶֽיךָ׃"},{"ref":"Ps.119.80","start":19119080,"end":19119080,"break":"none","text":"יְהִֽי־לִבִּ֣י תָמִ֣ים בְּחֻקֶּ֑יךָ לְ֝מַ֗עַן לֹ֣א אֵבֽוֹשׁ׃"},{"ref":"Ps.119.81","start":19119081,"end":19119081,"break":"none","text":"כָּלְתָ֣ה לִתְשׁוּעָתְךָ֣ נַפְשִׁ֑י לִדְבָרְךָ֥ יִחָֽלְתִּי׃"},{"ref":"Ps.119.82","start":19119082,"end":19119082,"break":"none","text":"כָּל֣וּ עֵ֭ינַי לְאִמְרָתֶ֑ךָ לֵ֝אמֹ֗ר מָתַ֥י תְּֽנַחֲמֵֽנִי׃"},{"ref":"Ps.119.83","start":19119083,"end":19119083,"break":"none","text":"כִּֽי־הָ֭יִיתִי כְּנֹ֣אד בְּקִיט֑וֹר חֻ֝קֶּ֗יךָ לֹ֣א שָׁכָֽחְתִּי׃"},{"ref":"Ps.119.84","start":19119084,"end":19119084,"break":"none","text":"כַּמָּ֥ה יְמֵֽי־עַבְדֶּ֑ךָ מָתַ֬י תַּעֲשֶׂ֖ה בְרֹדְפַ֣י מִשְׁפָּֽט׃"},{"ref":"Ps.119.85","start":19119085,"end":19119085,"break":"none","text":"כָּֽרוּ־לִ֣י זֵדִ֣ים שִׁיח֑וֹת אֲ֝שֶׁ֗ר לֹ֣א כְתוֹרָתֶֽךָ׃"},{"ref":"Ps.119.86","start":19119086,"end":19119086,"break":"none","text":"כָּל־מִצְוֺתֶ֥יךָ אֱמוּנָ֑ה שֶׁ֖קֶר רְדָפ֣וּנִי עָזְרֵֽנִי׃"},{"ref":"Ps.119.87","start":19119087,"end":19119087,"break":"none","text":"כִּ֭מְעַט כִּלּ֣וּנִי בָאָ֑רֶץ וַ֝אֲנִ֗י לֹא־עָזַ֥בְתִּי פִקֻּודֶֽיךָ׃"},{"ref":"Ps.119.88","start":19119088,"end":19119088,"break":"none","text":"כְּחַסְדְּךָ֥ חַיֵּ֑נִי וְ֝אֶשְׁמְרָ֗ה עֵד֥וּת פִּֽיךָ׃"},{"ref":"Ps.119.89","start":19119089,"end":19119089,"break":"none","text":"לְעוֹלָ֥ם יְהוָ֑ה דְּ֝בָרְךָ֗ נִצָּ֥ב בַּשָּׁמָֽיִם׃"},{"ref":"Ps.119.90","start":19119090,"end":19119090,"break":"none","text":"לְדֹ֣ר וָ֭דֹר אֱמֽוּנָתֶ֑ךָ כּוֹנַ֥נְתָּ אֶ֝֗רֶץ וַֽתַּעֲמֹֽד׃"},{"ref":"Ps.119.91","start":19119091,"end":19119091,"break":"none","text":"לְֽ֭מִשְׁפָּטֶיךָ עָמְד֣וּ הַיּ֑וֹם כִּ֖י הַכֹּ֣ל עֲבָדֶֽיךָ׃"},{"ref":"Ps.119.92","start":19119092,"end":19119092,"break":"none","text":"לוּלֵ֣י ת֭וֹרָתְךָ שַׁעֲשֻׁעָ֑י אָ֝֗ז אָבַ֥דְתִּי בְעָנְיִֽי׃"},{"ref":"Ps.119.93","start":19119093,"end":19119093,"break":"none","text":"לְ֭עוֹלָם לֹא־אֶשְׁכַּ֣ח פִּקּוּדֶ֑יךָ כִּ֥י בָ֝֗ם חִיִּיתָֽנִי׃"},{"ref":"Ps.119.94","start":19119094,"end":19119094,"break":"none","text":"לְֽךָ־אֲ֭נִי הוֹשִׁיעֵ֑נִי כִּ֖י פִקּוּדֶ֣יךָ דָרָֽשְׁתִּי׃"},{"ref":"Ps.119.95","start":19119095,"end":19119095,"break":"none","text":"לִ֤י קִוּ֣וּ רְשָׁעִ֣ים לְאַבְּדֵ֑נִי עֵ֝דֹתֶ֗יךָ אֶתְבּוֹנָֽן׃"},{"ref":"Ps.119.96","start":19119096,"end":19119096,"break":"none","text":"לְֽכָל תִּ֭כְלָה רָאִ֣יתִי קֵ֑ץ רְחָבָ֖ה מִצְוָתְךָ֣ מְאֹֽד׃"},{"ref":"Ps.119.97","start":19119097,"end":19119097,"break":"none","text":"מָֽה־אָהַ֥בְתִּי תוֹרָתֶ֑ךָ כָּל־הַ֝יּ֗וֹם הִ֣יא שִׂיחָתִֽי׃"},{"ref":"Ps.119.98","start":19119098,"end":19119098,"break":"none","text":"מֵ֭אֹ֣יְבַי תְּחַכְּמֵ֣נִי מִצְוֺתֶ֑ךָ כִּ֖י לְעוֹלָ֣ם הִיא־לִֽי׃"},{"ref":"Ps.119.99","start":19119099,"end":19119099,"break":"none","text":"מִכָּל־מְלַמְּדַ֥י הִשְׂכַּ֑לְתִּי כִּ֥י עֵ֝דְוֺתֶ֗יךָ שִׂ֣יחָה לִֽֿי׃"},{"ref":"Ps.119.100","start":19119100,"end":19119100,"break":"none","text":"מִזְּקֵנִ֥ים אֶתְבּוֹנָ֑ן כִּ֖י פִקּוּדֶ֣יךָ נָצָֽרְתִּי׃"},{"ref":"Ps.119.101","start":19119101,"end":19119101,"break":"none","text":"מִכָּל־אֹ֣רַח רָ֭ע כָּלִ֣אתִי רַגְלָ֑י לְ֝מַ֗עַן אֶשְׁמֹ֥ר דְּבָרֶֽךָ׃"},{"ref":"Ps.119.102","start":19119102,"end":19119102,"break":"none","text":"מִמִּשְׁפָּטֶ֥יךָ לֹא־סָ֑רְתִּי כִּֽי־אַ֝תָּ֗ה הוֹרֵתָֽנִי׃"},{"ref":"Ps.119.103","start":19119103,"end":19119103,"break":"none","text":"מַה־נִּמְלְצ֣וּ לְ֭חִכִּי אִמְרָתֶ֗ךָ מִדְּבַ֥שׁ לְפִֽי׃"},{"ref":"Ps.119.104","start":19119104,"end":19119104,"break":"none","text":"מִפִּקּוּדֶ֥יךָ אֶתְבּוֹנָ֑ן עַל־כֵּ֝֗ן שָׂנֵ֤אתִי ׀ כָּל־אֹ֬רַח שָֽׁקֶר׃"},{"ref":"Ps.119.105","start":19119105,"end":19119105,"break":"none","text":"נֵר־לְרַגְלִ֥י דְבָרֶ֑ךָ וְ֝א֗וֹר לִנְתִיבָתִֽי׃"},{"ref":"Ps.119.106","start":19119106,"end":19119106,"break":"none","text":"נִשְׁבַּ֥עְתִּי וָאֲקַיֵּ֑מָה לִ֝שְׁמֹ֗ר מִשְׁפְּטֵ֥י צִדְקֶֽךָ׃"},{"ref":"Ps.119.107","start":19119107,"end":19119107,"break":"none","text":"נַעֲנֵ֥יתִי עַד־מְאֹ֑ד יְ֝הוָ֗ה חַיֵּ֥נִי כִדְבָרֶֽךָ׃"},{"ref":"Ps.119.108","start":19119108,"end":19119108,"break":"none","text":"נִדְב֣וֹת פִּ֭י רְצֵה־נָ֣א יְהוָ֑ה וּֽמִשְׁפָּטֶ֥יךָ לַמְּדֵֽנִי׃"},{"ref":"Ps.119.109","start":19119109,"end":19119109,"break":"none","text":"נַפְשִׁ֣י בְכַפִּ֣י תָמִ֑יד וְ֝תֽוֹרָתְךָ֗ לֹ֣א שָׁכָֽחְתִּי׃"},{"ref":"Ps.119.110","start":19119110,"end":19119110,"break":"none","text":"נָתְנ֬וּ רְשָׁעִ֣ים פַּ֣ח לִ֑י וּ֝מִפִּקּוּדֶ֗יךָ לֹ֣א תָעִֽיתִי׃"},{"ref":"Ps.119.111","start":19119111,"end":19119111,"break":"none","text":"נָחַ֣לְתִּי עֵדְוֺתֶ֣יךָ לְעוֹלָ֑ם כִּֽי־שְׂשׂ֖וֹן לִבִּ֣י הֵֽמָּה׃"},{"ref":"Ps.119.112","start":19119112,"end":19119112,"break":"none","text":"נָטִ֣יתִי לִ֭בִּי לַעֲשׂ֥וֹת חֻקֶּ֗יךָ לְעוֹלָ֥ם עֵֽקֶב׃"},{"ref":"Ps.119.113","start":19119113,"end":19119113,"break":"none","text":"סֵעֲפִ֥ים שָׂנֵ֑אתִי וְֽתוֹרָתְךָ֥ אָהָֽבְתִּי׃"},{"ref":"Ps.119.114","start":19119114,"end":19119114,"break":"none","text":"סִתְרִ֣י וּמָגִנִּ֣י אָ֑תָּה לִדְבָרְךָ֥ יִחָֽלְתִּי׃"},{"ref":"Ps.119.115","start":19119115,"end":19119115,"break":"none","text":"סֽוּרוּ־מִמֶּ֥נִּי מְרֵעִ֑ים וְ֝אֶצְּרָ֗ה מִצְוֺ֥ת אֱלֹהָֽי׃"},{"ref":"Ps.119.116","start":19119116,"end":19119116,"break":"none","text":"סָמְכֵ֣נִי כְאִמְרָתְךָ֣ וְאֶֽחְיֶ֑ה וְאַל־תְּ֝בִישֵׁ֗נִי מִשִּׂבְרִֽי׃"},{"ref":"Ps.119.117","start":19119117,"end":19119117,"break":"none","text":"סְעָדֵ֥נִי וְאִוָּשֵׁ֑עָה וְאֶשְׁעָ֖ה בְחֻקֶּ֣יךָ תָמִֽיד׃"},{"ref":"Ps.119.118","start":19119118,"end":19119118,"break":"none","text":"סָ֭לִיתָ כָּל־שׁוֹגִ֣ים מֵחֻקֶּ֑יךָ כִּי־שֶׁ֝֗קֶר תַּרְמִיתָֽם׃"},{"ref":"Ps.119.119","start":19119119,"end":19119119,"break":"none","text":"סִגִ֗ים הִשְׁבַּ֥תָּ כָל־רִשְׁעֵי־אָ֑רֶץ לָ֝כֵ֗ן אָהַ֥בְתִּי עֵדֹתֶֽיךָ׃"},{"ref":"Ps.119.120","start":19119120,"end":19119120,"break":"none","text":"סָמַ֣ר מִפַּחְדְּךָ֣ בְשָׂרִ֑י וּֽמִמִּשְׁפָּטֶ֥יךָ יָרֵֽאתִי׃"},{"ref":"Ps.119.121","start":19119121,"end":19119121,"break":"none","text":"עָ֭שִׂיתִי מִשְׁפָּ֣ט וָצֶ֑דֶק בַּל־תַּ֝נִּיחֵ֗נִי לְעֹֽשְׁקָֽי׃"},{"ref":"Ps.119.122","start":19119122,"end":19119122,"break":"none","text":"עֲרֹ֣ב עַבְדְּךָ֣ לְט֑וֹב אַֽל־יַעַשְׁקֻ֥נִי זֵדִֽים׃"},{"ref":"Ps.119.123","start":19119123,"end":19119123,"break":"none","text":"עֵ֭ינַי כָּל֣וּ לִֽישׁוּעָתֶ֑ךָ וּלְאִמְרַ֥ת צִדְקֶֽךָ׃"},{"ref":"Ps.119.124","start":19119124,"end":19119124,"break":"none","text":"עֲשֵׂ֖ה עִם־עַבְדְּךָ֥ כְחַסְדֶּ֗ךָ וְחֻקֶּ֥יךָ לַמְּדֵֽנִי׃"},{"ref":"Ps.119.125","start":19119125,"end":19119125,"break":"none","text":"עַבְדְּךָ־אָ֥נִי הֲבִינֵ֑נִי וְ֝אֵדְעָ֗ה עֵדֹתֶֽיךָ׃"},{"ref":"Ps.119.126","start":19119126,"end":19119126,"break":"none","text":"עֵ֭ת לַעֲשׂ֣וֹת לַיהוָ֑ה הֵ֝פֵ֗רוּ תּוֹרָתֶֽךָ׃"},{"ref":"Ps.119.127","start":19119127,"end":19119127,"break":"none","text":"עַל־כֵּ֭ן אָהַ֣בְתִּי מִצְוֺתֶ֑יךָ מִזָּהָ֥ב וּמִפָּֽז׃"},{"ref":"Ps.119.128","start":19119128,"end":19119128,"break":"none","text":"עַל־כֵּ֤ן ׀ כָּל־פִּקּ֣וּדֵי כֹ֣ל יִשָּׁ֑רְתִּי כָּל־אֹ֖רַח שֶׁ֣קֶר שָׂנֵֽאתִי׃"},{"ref":"Ps.119.129","start":19119129,"end":19119129,"break":"none","text":"פְּלָא֥וֹת עֵדְוֺתֶ֑יךָ עַל־כֵּ֝֗ן נְצָרָ֥תַם נַפְשִֽׁי׃"},{"ref":"Ps.119.130","start":19119130,"end":19119130,"break":"none","text":"פֵּ֖תַח דְּבָרֶ֥יךָ יָאִ֗יר מֵבִ֥ין פְּתָיִֽים׃"},{"ref":"Ps.119.131","start":19119131,"end":19119131,"break":"none","text":"פִּֽי־פָ֭עַרְתִּי וָאֶשְׁאָ֑פָה כִּ֖י לְמִצְוֺתֶ֣יךָ יָאָֽבְתִּי׃"},{"ref":"Ps.119.132","start":19119132,"end":19119132,"break":"none","text":"פְּנֵה־אֵלַ֥י וְחָנֵּ֑נִי כְּ֝מִשְׁפָּ֗ט לְאֹהֲבֵ֥י שְׁמֶֽךָ׃"},{"ref":"Ps.119.133","start":19119133,"end":19119133,"break":"none","text":"פְּ֭עָמַי הָכֵ֣ן בְּאִמְרָתֶ֑ךָ וְֽאַל־תַּשְׁלֶט־בִּ֥י כָל־אָֽוֶן׃"},{"ref":"Ps.119.134","start":19119134,"end":19119134,"break":"none","text":"פְּ֭דֵנִי מֵעֹ֣שֶׁק אָדָ֑ם וְ֝אֶשְׁמְרָ֗ה פִּקּוּדֶֽיךָ׃"},{"ref":"Ps.119.135","start":19119135,"end":19119135,"break":"none","text":"פָּ֭נֶיךָ הָאֵ֣ר בְּעַבְדֶּ֑ךָ וְ֝לַמְּדֵ֗נִי אֶת־חֻקֶּֽיךָ׃"},{"ref":"Ps.119.136","start":19119136,"end":19119136,"break":"none","text":"פַּלְגֵי־מַ֭יִם יָרְד֣וּ עֵינָ֑י עַ֝֗ל לֹא־שָׁמְר֥וּ תוֹרָתֶֽךָ׃"},{"ref":"Ps.119.137","start":19119137,"end":19119137,"break":"none","text":"צַדִּ֣יק אַתָּ֣ה יְהוָ֑ה וְ֝יָשָׁ֗ר מִשְׁפָּטֶֽיךָ׃"},{"ref":"Ps.119.138","start":19119138,"end":19119138,"break":"none","text":"צִ֭וִּיתָ צֶ֣דֶק עֵדֹתֶ֑יךָ וֶֽאֱמוּנָ֥ה מְאֹֽד׃"},{"ref":"Ps.119.139","start":19119139,"end":19119139,"break":"none","text":"צִמְּתַ֥תְנִי קִנְאָתִ֑י כִּֽי־שָׁכְח֖וּ דְבָרֶ֣יךָ צָרָֽי׃"},{"ref":"Ps.119.140","start":19119140,"end":19119140,"break":"none","text":"צְרוּפָ֖ה אִמְרָתְךָ֥ מְאֹ֗ד וְֽעַבְדְּךָ֥ אֲהֵבָֽהּ׃"},{"ref":"Ps.119.141","start":19119141,"end":19119141,"break":"none","text":"צָעִ֣יר אָנֹכִ֣י וְנִבְזֶ֑ה פִּ֝קֻּדֶ֗יךָ לֹ֣א שָׁכָֽחְתִּי׃"},{"ref":"Ps.119.142","start":19119142,"end":19119142,"break":"none","text":"צִדְקָתְךָ֣ צֶ֣דֶק לְעוֹלָ֑ם וְֽתוֹרָתְךָ֥ אֱמֶֽת׃"},{"ref":"Ps.119.143","start":19119143,"end":19119143,"break":"none","text":"צַר־וּמָצ֥וֹק מְצָא֑וּנִי מִ֝צְוֺתֶ֗יךָ שַׁעֲשֻׁעָֽי׃"},{"ref":"Ps.119.144","start":19119144,"end":19119144,"break":"none","text":"צֶ֖דֶק עֵדְוֺתֶ֥יךָ לְעוֹלָ֗ם הֲבִינֵ֥נִי וְאֶחְיֶֽה׃"},{"ref":"Ps.119.145","start":19119145,"end":19119145,"break":"none","text":"קָרָ֣אתִי בְכָל־לֵ֭ב עֲנֵ֥נִי יְהוָ֗ה חֻקֶּ֥יךָ אֶצֹּֽרָה׃"},{"ref":"Ps.119.146","start":19119146,"end":19119146,"break":"none","text":"קְרָאתִ֥יךָ הוֹשִׁיעֵ֑נִי וְ֝אֶשְׁמְרָ֗ה עֵדֹתֶֽיךָ׃"},{"ref":"Ps.119.147","start":19119147,"end":19119147,"break":"none","text":"קִדַּ֣מְתִּי בַ֭נֶּשֶׁף וָאֲשַׁוֵּ֑עָה לדבריך יִחָֽלְתִּי׃"},{"ref":"Ps.119.148","start":19119148,"end":19119148,"break":"none","text":"קִדְּמ֣וּ עֵ֭ינַי אַשְׁמֻר֑וֹת לָ֝שִׂ֗יחַ בְּאִמְרָתֶֽךָ׃"},{"ref":"Ps.119.149","start":19119149,"end":19119149,"break":"none","text":"ק֭וֹלִי שִׁמְעָ֣ה כְחַסְדֶּ֑ךָ יְ֝הוָ֗ה כְּֽמִשְׁפָּטֶ֥ךָ חַיֵּֽנִי׃"},{"ref":"Ps.119.150","start":19119150,"end":19119150,"break":"none","text":"קָ֭רְבוּ רֹדְפֵ֣י זִמָּ֑ה מִתּוֹרָתְךָ֥ רָחָֽקוּ׃"},{"ref":"Ps.119.151","start":19119151,"end":19119151,"break":"none","text":"קָר֣וֹב אַתָּ֣ה יְהוָ֑ה וְֽכָל־מִצְוֺתֶ֥יךָ אֱמֶֽת׃"},{"ref":"Ps.119.152","start":19119152,"end":19119152,"break":"none","text":"קֶ֣דֶם יָ֭דַעְתִּי מֵעֵדֹתֶ֑יךָ כִּ֖י לְעוֹלָ֣ם יְסַדְתָּֽם׃"},{"ref":"Ps.119.153","start":19119153,"end":19119153,"break":"none","text":"רְאֵֽה־עָנְיִ֥י וְחַלְּצֵ֑נִי כִּי־תֽ֝וֹרָתְךָ֗ לֹ֣א שָׁכָֽחְתִּי׃"},{"ref":"Ps.119.154","start":19119154,"end":19119154,"break":"none","text":"רִיבָ֣ה רִ֭יבִי וּגְאָלֵ֑נִי לְאִמְרָתְךָ֥ חַיֵּֽנִי׃"},{"ref":"Ps.119.155","start":19119155,"end":19119155,"break":"none","text":"רָח֣וֹק מֵרְשָׁעִ֣ים יְשׁוּעָ֑ה כִּֽי־חֻ֝קֶּיךָ לֹ֣א דָרָֽשׁוּ׃"},{"ref":"Ps.119.156","start":19119156,"end":19119156,"break":"none","text":"רַחֲמֶ֖יךָ רַבִּ֥ים ׀ יְהוָ֑ה כְּֽמִשְׁפָּטֶ֥יךָ חַיֵּֽנִי׃"},{"ref":"Ps.119.157","start":19119157,"end":19119157,"break":"none","text":"רַ֭בִּים רֹדְפַ֣י וְצָרָ֑י מֵ֝עֵדְוֺתֶ֗יךָ לֹ֣א נָטִֽיתִי׃"},{"ref":"Ps.119.158","start":19119158,"end":19119158,"break":"none","text":"רָאִ֣יתִי בֹ֭גְדִים וָֽאֶתְקוֹטָ֑טָה אֲשֶׁ֥ר אִ֝מְרָתְךָ֗ לֹ֣א שָׁמָֽרוּ׃"},{"ref":"Ps.119.159","start":19119159,"end":19119159,"break":"none","text":"רְ֭אֵה כִּי־פִקּוּדֶ֣יךָ אָהָ֑בְתִּי יְ֝הוָ֗ה כְּֽחַסְדְּךָ֥ חַיֵּֽנִי׃"},{"ref":"Ps.119.160","start":19119160,"end":19119160,"break":"none","text":"רֹאשׁ־דְּבָרְךָ֥ אֱמֶ֑ת וּ֝לְעוֹלָ֗ם כָּל־מִשְׁפַּ֥ט צִדְקֶֽךָ׃"},{"ref":"Ps.119.161","start":19119161,"end":19119161,"break":"none","text":"שָׂ֭רִים רְדָפ֣וּנִי חִנָּ֑ם ומדבריך פָּחַ֥ד לִבִּֽי׃"},{"ref":"Ps.119.162","start":19119162,"end":19119162,"break":"none","text":"שָׂ֣שׂ אָ֭נֹכִֽי עַל־אִמְרָתֶ֑ךָ כְּ֝מוֹצֵ֗א שָׁלָ֥ל רָֽב׃"},{"ref":"Ps.119.163","start":19119163,"end":19119163,"break":"none","text":"שֶׁ֣קֶר שָׂ֭נֵאתִי וַאֲתַעֵ֑בָה תּוֹרָתְךָ֥ אָהָֽבְתִּי׃"},{"ref":"Ps.119.164","start":19119164,"end":19119164,"break":"none","text":"שֶׁ֣בַע בַּ֭יּוֹם הִלַּלְתִּ֑יךָ עַ֝֗ל מִשְׁפְּטֵ֥י צִדְקֶֽךָ׃"},{"ref":"Ps.119.165","start":19119165,"end":19119165,"break":"none","text":"שָׁל֣וֹם רָ֭ב לְאֹהֲבֵ֣י תוֹרָתֶ֑ךָ וְאֵֽין־לָ֥מוֹ מִכְשֽׁוֹל׃"},{"ref":"Ps.119.166","start":19119166,"end":19119166,"break":"none","text":"שִׂבַּ֣רְתִּי לִֽישׁוּעָתְךָ֣ יְהוָ֑ה וּֽמִצְוֺתֶ֥יךָ עָשִֽׂיתִי׃"},{"ref":"Ps.119.167","start":19119167,"end":19119167,"break":"none","text":"שָֽׁמְרָ֣ה נַ֭פְשִׁי עֵדֹתֶ֑יךָ וָאֹהֲבֵ֥ם מְאֹֽד׃"},{"ref":"Ps.119.168","start":19119168,"end":19119168,"break":"none","text":"שָׁמַ֣רְתִּי פִ֭קּוּדֶיךָ וְעֵדֹתֶ֑יךָ כִּ֖י כָל־דְּרָכַ֣י נֶגְדֶּֽךָ׃"},{"ref":"Ps.119.169","start":19119169,"end":19119169,"break":"none","text":"תִּקְרַ֤ב רִנָּתִ֣י לְפָנֶ֣יךָ יְהוָ֑ה כִּדְבָרְךָ֥ הֲבִינֵֽנִי׃"},{"ref":"Ps.119.170","start":19119170,"end":19119170,"break":"none","text":"תָּב֣וֹא תְּחִנָּתִ֣י לְפָנֶ֑יךָ כְּ֝אִמְרָתְךָ֗ הַצִּילֵֽנִי׃"},{"ref":"Ps.119.171","start":19119171,"end":19119171,"break":"none","text":"תַּבַּ֣עְנָה שְׂפָתַ֣י תְּהִלָּ֑ה כִּ֖י תְלַמְּדֵ֣נִי חֻקֶּֽיךָ׃"},{"ref":"Ps.119.172","start":19119172,"end":19119172,"break":"none","text":"תַּ֣עַן לְ֭שׁוֹנִי אִמְרָתֶ֑ךָ כִּ֖י כָל־מִצְוֺתֶ֣יךָ צֶּֽדֶק׃"},{"ref":"Ps.119.173","start":19119173,"end":19119173,"break":"none","text":"תְּהִֽי־יָדְךָ֥ לְעָזְרֵ֑נִי כִּ֖י פִקּוּדֶ֣יךָ בָחָֽרְתִּי׃"},{"ref":"Ps.119.174","start":19119174,"end":19119174,"break":"none","text":"תָּאַ֣בְתִּי לִֽישׁוּעָתְךָ֣ יְהוָ֑ה וְ֝תֽוֹרָתְךָ֗ שַׁעֲשֻׁעָֽי׃"},{"ref":"Ps.119.175","start":19119175,"end":19119175,"break":"none","text":"תְּֽחִי־נַ֭פְשִׁי וּֽתְהַֽלְלֶ֑ךָּ וּֽמִשְׁפָּטֶ֥ךָ יַעֲזְרֻֽנִי׃"},{"ref":"Ps.119.176","start":19119176,"end":19119176,"break":"none","text":"תָּעִ֗יתִי כְּשֶׂ֣ה אֹ֭בֵד בַּקֵּ֣שׁ עַבְדֶּ֑ךָ כִּ֥י מִ֝צְוֺתֶ֗יךָ לֹ֣א שָׁכָֽחְתִּי׃"}]