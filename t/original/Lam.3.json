[{"ref":"Lam.3.1","start":25003001,"end":25003001,"break":"paragraph","text":"אֲנִ֤י הַגֶּ֨בֶר֙ רָאָ֣ה עֳנִ֔י בְּשֵׁ֖בֶט עֶבְרָתֽוֹ׃"},{"ref":"Lam.3.2","start":25003002,"end":25003002,"break":"none","text":"אוֹתִ֥י נָהַ֛ג וַיֹּלַ֖ךְ חֹ֥שֶׁךְ וְלֹא־אֽוֹר׃"},{"ref":"Lam.3.3","start":25003003,"end":25003003,"break":"none","section":"setumah","text":"אַ֣ךְ בִּ֥י יָשֻׁ֛ב יַהֲפֹ֥ךְ יָד֖וֹ כָּל־הַיּֽוֹם׃"},{"ref":"Lam.3.4","start":25003004,"end":25003004,"break":"none","text":"בִּלָּ֤ה בְשָׂרִי֙ וְעוֹרִ֔י שִׁבַּ֖ר עַצְמוֹתָֽי׃"},{"ref":"Lam.3.5","start":25003005,"end":25003005,"break":"none","text":"בָּנָ֥ה עָלַ֛י וַיַּקַּ֖ף רֹ֥אשׁ וּתְלָאָֽה׃"},{"ref":"Lam.3.6","start":25003006,"end":25003006,"break":"none","section":"setumah","text":"בְּמַחֲשַׁכִּ֥ים הוֹשִׁיבַ֖נִי כְּמֵתֵ֥י עוֹלָֽם׃"},{"ref":"Lam.3.7","start":25003007,"end":25003007,"break":"none","text":"גָּדַ֧ר בַּעֲדִ֛י וְלֹ֥א אֵצֵ֖א הִכְבִּ֥יד נְחָשְׁתִּֽי׃"},{"ref":"Lam.3.8","start":25003008,"end":25003008,"break":"none","text":"גַּ֣ם כִּ֤י אֶזְעַק֙ וַאֲשַׁוֵּ֔עַ שָׂתַ֖ם תְּפִלָּתִֽי׃"},{"ref":"Lam.3.9","start":25003009,"end":25003009,"break":"none","section":"setumah","text":"גָּדַ֤ר דְּרָכַי֙ בְּגָזִ֔ית נְתִיבֹתַ֖י עִוָּֽה׃"},{"ref":"Lam.3.10","start":25003010,"end":25003010,"break":"none","text":"דֹּ֣ב אֹרֵ֥ב הוּא֙ לִ֔י אריה בְּמִסְתָּרִֽים׃"},{"ref":"Lam.3.11","start":25003011,"end":25003011,"break":"none","text":"דְּרָכַ֥י סוֹרֵ֛ר וַֽיְפַשְּׁחֵ֖נִי שָׂמַ֥נִי שֹׁמֵֽם׃"},{"ref":"Lam.3.12","start":25003012,"end":25003012,"break":"none","section":"setumah","text":"דָּרַ֤ךְ קַשְׁתוֹ֙ וַיַּצִּיבֵ֔נִי כַּמַּטָּרָ֖א לַחֵֽץ׃"},{"ref":"Lam.3.13","start":25003013,"end":25003013,"break":"none","text":"הֵבִיא֙ בְּכִלְיוֹתָ֔י בְּנֵ֖י אַשְׁפָּתֽוֹ׃"},{"ref":"Lam.3.14","start":25003014,"end":25003014,"break":"none","text":"הָיִ֤יתִי שְּׂחֹק֙ לְכָל־עַמִּ֔י נְגִינָתָ֖ם כָּל־הַיּֽוֹם׃"},{"ref":"Lam.3.15","start":25003015,"end":25003015,"break":"none","section":"setumah","text":"הִשְׂבִּיעַ֥נִי בַמְּרוֹרִ֖ים הִרְוַ֥נִי לַעֲנָֽה׃"},{"ref":"Lam.3.16","start":25003016,"end":25003016,"break":"none","text":"וַיַּגְרֵ֤ס בֶּֽחָצָץ֙ שִׁנָּ֔י הִכְפִּישַׁ֖נִי בָּאֵֽפֶר׃"},{"ref":"Lam.3.17","start":25003017,"end":25003017,"break":"none","text":"וַתִּזְנַ֧ח מִשָּׁל֛וֹם נַפְשִׁ֖י נָשִׁ֥יתִי טוֹבָֽה׃"},{"ref":"Lam.3.18","start":25003018,"end":25003018,"break":"none","section":"setumah","text":"וָאֹמַר֙ אָבַ֣ד נִצְחִ֔י וְתוֹחַלְתִּ֖י מֵיְהוָֽה׃"},{"ref":"Lam.3.19","start":25003019,"end":25003019,"break":"none","text":"זְכָר־עָנְיִ֥י וּמְרוּדִ֖י לַעֲנָ֥ה וָרֹֽאשׁ׃"},{"ref":"Lam.3.20","start":25003020,"end":25003020,"break":"none","text":"זָכ֣וֹר תִּזְכּ֔וֹר ותשיח עָלַ֖י נַפְשִֽׁי׃"},{"ref":"Lam.3.21","start":25003021,"end":25003021,"break":"none","section":"setumah","text":"זֹ֛את אָשִׁ֥יב אֶל־לִבִּ֖י עַל־כֵּ֥ן אוֹחִֽיל׃"},{"ref":"Lam.3.22","start":25003022,"end":25003022,"break":"none","text":"חַֽסְדֵ֤י יְהוָה֙ כִּ֣י לֹא־תָ֔מְנוּ כִּ֥י לֹא־כָל֖וּ רַחֲמָֽיו׃"},{"ref":"Lam.3.23","start":25003023,"end":25003023,"break":"none","text":"חֲדָשִׁים֙ לַבְּקָרִ֔ים רַבָּ֖ה אֱמוּנָתֶֽךָ׃"},{"ref":"Lam.3.24","start":25003024,"end":25003024,"break":"none","section":"setumah","text":"חֶלְקִ֤י יְהוָה֙ אָמְרָ֣ה נַפְשִׁ֔י עַל־כֵּ֖ן אוֹחִ֥יל לֽוֹ׃"},{"ref":"Lam.3.25","start":25003025,"end":25003025,"break":"none","text":"ט֤וֹב יְהוָה֙ לְקוָֹ֔ו לְנֶ֖פֶשׁ תִּדְרְשֶֽׁנּוּ׃"},{"ref":"Lam.3.26","start":25003026,"end":25003026,"break":"none","text":"ט֤וֹב וְיָחִיל֙ וְדוּמָ֔ם לִתְשׁוּעַ֖ת יְהוָֽה׃"},{"ref":"Lam.3.27","start":25003027,"end":25003027,"break":"none","section":"setumah","text":"ט֣וֹב לַגֶּ֔בֶר כִּֽי־יִשָּׂ֥א עֹ֖ל בִּנְעוּרָֽיו׃"},{"ref":"Lam.3.28","start":25003028,"end":25003028,"break":"none","text":"יֵשֵׁ֤ב בָּדָד֙ וְיִדֹּ֔ם כִּ֥י נָטַ֖ל עָלָֽיו׃"},{"ref":"Lam.3.29","start":25003029,"end":25003029,"break":"none","text":"יִתֵּ֤ן בֶּֽעָפָר֙ פִּ֔יהוּ אוּלַ֖י יֵ֥שׁ תִּקְוָֽה׃"},{"ref":"Lam.3.30","start":25003030,"end":25003030,"break":"none","section":"setumah","text":"יִתֵּ֧ן לְמַכֵּ֛הוּ לֶ֖חִי יִשְׂבַּ֥ע בְּחֶרְפָּֽה׃"},{"ref":"Lam.3.31","start":25003031,"end":25003031,"break":"none","text":"כִּ֣י לֹ֥א יִזְנַ֛ח לְעוֹלָ֖ם אֲדֹנָֽי׃"},{"ref":"Lam.3.32","start":25003032,"end":25003032,"break":"none","text":"כִּ֣י אִם־הוֹגָ֔ה וְרִחַ֖ם כְּרֹ֥ב חסדו׃"},{"ref":"Lam.3.33","start":25003033,"end":25003033,"break":"none","section":"setumah","text":"כִּ֣י לֹ֤א עִנָּה֙ מִלִּבּ֔וֹ וַיַּגֶּ֖ה בְנֵי־אִֽישׁ׃"},{"ref":"Lam.3.34","start":25003034,"end":25003034,"break":"none","text":"לְדַכֵּא֙ תַּ֣חַת רַגְלָ֔יו כֹּ֖ל אֲסִ֥ירֵי אָֽרֶץ׃"},{"ref":"Lam.3.35","start":25003035,"end":25003035,"break":"none","text":"לְהַטּוֹת֙ מִשְׁפַּט־גָּ֔בֶר נֶ֖גֶד פְּנֵ֥י עֶלְיֽוֹן׃"},{"ref":"Lam.3.36","start":25003036,"end":25003036,"break":"none","section":"setumah","text":"לְעַוֵּ֤ת אָדָם֙ בְּרִיב֔וֹ אֲדֹנָ֖י לֹ֥א רָאָֽה׃"},{"ref":"Lam.3.37","start":25003037,"end":25003037,"break":"none","text":"מִ֣י זֶ֤ה אָמַר֙ וַתֶּ֔הִי אֲדֹנָ֖י לֹ֥א צִוָּֽה׃"},{"ref":"Lam.3.38","start":25003038,"end":25003038,"break":"none","text":"מִפִּ֤י עֶלְיוֹן֙ לֹ֣א תֵצֵ֔א הָרָע֖וֹת וְהַטּֽוֹב׃"},{"ref":"Lam.3.39","start":25003039,"end":25003039,"break":"none","section":"setumah","text":"מַה־יִּתְאוֹנֵן֙ אָדָ֣ם חָ֔י גֶּ֖בֶר עַל־חטאו׃"},{"ref":"Lam.3.40","start":25003040,"end":25003040,"break":"none","text":"נַחְפְּשָׂ֤ה דְרָכֵ֨ינוּ֙ וְֽנַחְקֹ֔רָה וְנָשׁ֖וּבָה עַד־יְהוָֽה׃"},{"ref":"Lam.3.41","start":25003041,"end":25003041,"break":"none","text":"נִשָּׂ֤א לְבָבֵ֨נוּ֙ אֶל־כַּפָּ֔יִם אֶל־אֵ֖ל בַּשָּׁמָֽיִם׃"},{"ref":"Lam.3.42","start":25003042,"end":25003042,"break":"none","section":"setumah","text":"נַ֤חְנוּ פָשַׁ֨עְנוּ֙ וּמָרִ֔ינוּ אַתָּ֖ה לֹ֥א סָלָֽחְתָּ׃"},{"ref":"Lam.3.43","start":25003043,"end":25003043,"break":"none","text":"סַכֹּ֤תָה בָאַף֙ וַֽתִּרְדְּפֵ֔נוּ הָרַ֖גְתָּ לֹ֥א חָמָֽלְתָּ׃"},{"ref":"Lam.3.44","start":25003044,"end":25003044,"break":"none","text":"סַכּ֤וֹתָה בֶֽעָנָן֙ לָ֔ךְ מֵעֲב֖וֹר תְּפִלָּֽה׃"},{"ref":"Lam.3.45","start":25003045,"end":25003045,"break":"none","section":"setumah","text":"סְחִ֧י וּמָא֛וֹס תְּשִׂימֵ֖נוּ בְּקֶ֥רֶב הָעַמִּֽים׃"},{"ref":"Lam.3.46","start":25003046,"end":25003046,"break":"none","text":"פָּצ֥וּ עָלֵ֛ינוּ פִּיהֶ֖ם כָּל־אֹיְבֵֽינוּ׃"},{"ref":"Lam.3.47","start":25003047,"end":25003047,"break":"none","text":"פַּ֧חַד וָפַ֛חַת הָ֥יָה לָ֖נוּ הַשֵּׁ֥את וְהַשָּֽׁבֶר׃"},{"ref":"Lam.3.48","start":25003048,"end":25003048,"break":"none","section":"setumah","text":"פַּלְגֵי־מַ֨יִם֙ תֵּרַ֣ד עֵינִ֔י עַל־שֶׁ֖בֶר בַּת־עַמִּֽי׃"},{"ref":"Lam.3.49","start":25003049,"end":25003049,"break":"none","text":"עֵינִ֧י נִגְּרָ֛ה וְלֹ֥א תִדְמֶ֖ה מֵאֵ֥ין הֲפֻגֽוֹת׃"},{"ref":"Lam.3.50","start":25003050,"end":25003050,"break":"none","text":"עַד־יַשְׁקִ֣יף וְיֵ֔רֶא יְהוָ֖ה מִשָּׁמָֽיִם׃"},{"ref":"Lam.3.51","start":25003051,"end":25003051,"break":"none","section":"setumah","text":"עֵינִי֙ עֽוֹלְלָ֣ה לְנַפְשִׁ֔י מִכֹּ֖ל בְּנ֥וֹת עִירִֽי׃"},{"ref":"Lam.3.52","start":25003052,"end":25003052,"break":"none","text":"צ֥וֹד צָד֛וּנִי כַּצִּפּ֖וֹר אֹיְבַ֥י חִנָּֽם׃"},{"ref":"Lam.3.53","start":25003053,"end":25003053,"break":"none","text":"צָֽמְת֤וּ בַבּוֹר֙ חַיָּ֔י וַיַּדּוּ־אֶ֖בֶן בִּֽי׃"},{"ref":"Lam.3.54","start":25003054,"end":25003054,"break":"none","section":"setumah","text":"צָֽפוּ־מַ֥יִם עַל־רֹאשִׁ֖י אָמַ֥רְתִּי נִגְזָֽרְתִּי׃"},{"ref":"Lam.3.55","start":25003055,"end":25003055,"break":"none","text":"קָרָ֤אתִי שִׁמְךָ֙ יְהוָ֔ה מִבּ֖וֹר תַּחְתִּיּֽוֹת׃"},{"ref":"Lam.3.56","start":25003056,"end":25003056,"break":"none","text":"קוֹלִ֖י שָׁמָ֑עְתָּ אַל־תַּעְלֵ֧ם אָזְנְךָ֛ לְרַוְחָתִ֖י לְשַׁוְעָתִֽי׃"},{"ref":"Lam.3.57","start":25003057,"end":25003057,"break":"none","section":"setumah","text":"קָרַ֨בְתָּ֙ בְּי֣וֹם אֶקְרָאֶ֔ךָּ אָמַ֖רְתָּ אַל־תִּירָֽא׃"},{"ref":"Lam.3.58","start":25003058,"end":25003058,"break":"none","text":"רַ֧בְתָּ אֲדֹנָ֛י רִיבֵ֥י נַפְשִׁ֖י גָּאַ֥לְתָּ חַיָּֽי׃"},{"ref":"Lam.3.59","start":25003059,"end":25003059,"break":"none","text":"רָאִ֤יתָה יְהוָה֙ עַוָּ֣תָתִ֔י שָׁפְטָ֖ה מִשְׁפָּטִֽי׃"},{"ref":"Lam.3.60","start":25003060,"end":25003060,"break":"none","section":"setumah","text":"רָאִ֨יתָה֙ כָּל־נִקְמָתָ֔ם כָּל־מַחְשְׁבֹתָ֖ם לִֽי׃"},{"ref":"Lam.3.61","start":25003061,"end":25003061,"break":"none","text":"שָׁמַ֤עְתָּ חֶרְפָּתָם֙ יְהוָ֔ה כָּל־מַחְשְׁבֹתָ֖ם עָלָֽי׃"},{"ref":"Lam.3.62","start":25003062,"end":25003062,"break":"none","text":"שִׂפְתֵ֤י קָמַי֙ וְהֶגְיוֹנָ֔ם עָלַ֖י כָּל־הַיּֽוֹם׃"},{"ref":"Lam.3.63","start":25003063,"end":25003063,"break":"none","section":"setumah","text":"שִׁבְתָּ֤ם וְקִֽימָתָם֙ הַבִּ֔יטָה אֲנִ֖י מַנְגִּינָתָֽם׃"},{"ref":"Lam.3.64","start":25003064,"end":25003064,"break":"none","text":"תָּשִׁ֨יב לָהֶ֥ם גְּמ֛וּל יְהוָ֖ה כְּמַעֲשֵׂ֥ה יְדֵיהֶֽם׃"},{"ref":"Lam.3.65","start":25003065,"end":25003065,"break":"none","text":"תִּתֵּ֤ן לָהֶם֙ מְגִנַּת־לֵ֔ב תַּאֲלָֽתְךָ֖ לָהֶֽם׃"},{"ref":"Lam.3.66","start":25003066,"end":25003066,"break":"none","section":"petuchah","text":"תִּרְדֹּ֤ף בְּאַף֙ וְתַשְׁמִידֵ֔ם מִתַּ֖חַת שְׁמֵ֥י יְהוָֽה׃"}]