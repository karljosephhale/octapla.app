[{"ref":"Ps.114.1","start":19114001,"end":19114001,"break":"paragraph","text":"בְּצֵ֣את יִ֭שְׂרָאֵל מִמִּצְרָ֑יִם בֵּ֥ית יַ֝עֲקֹ֗ב מֵעַ֥ם לֹעֵֽז׃"},{"ref":"Ps.114.2","start":19114002,"end":19114002,"break":"none","text":"הָיְתָ֣ה יְהוּדָ֣ה לְקָדְשׁ֑וֹ יִ֝שְׂרָאֵ֗ל מַמְשְׁלוֹתָֽיו׃"},{"ref":"Ps.114.3","start":19114003,"end":19114003,"break":"none","text":"הַיָּ֣ם רָ֭אָה וַיָּנֹ֑ס הַ֝יַּרְדֵּ֗ן יִסֹּ֥ב לְאָחֽוֹר׃"},{"ref":"Ps.114.4","start":19114004,"end":19114004,"break":"none","text":"הֶֽ֭הָרִים רָקְד֣וּ כְאֵילִ֑ים גְּ֝בָע֗וֹת כִּבְנֵי־צֹֽאן׃"},{"ref":"Ps.114.5","start":19114005,"end":19114005,"break":"none","text":"מַה־לְּךָ֣ הַ֭יָּם כִּ֣י תָנ֑וּס הַ֝יַּרְדֵּ֗ן תִּסֹּ֥ב לְאָחֽוֹר׃"},{"ref":"Ps.114.6","start":19114006,"end":19114006,"break":"none","text":"הֶֽ֭הָרִים תִּרְקְד֣וּ כְאֵילִ֑ים גְּ֝בָע֗וֹת כִּבְנֵי־צֹֽאן׃"},{"ref":"Ps.114.7","start":19114007,"end":19114007,"break":"none","text":"מִלִּפְנֵ֣י אָ֭דוֹן ח֣וּלִי אָ֑רֶץ מִ֝לִּפְנֵ֗י אֱל֣וֹהַּ יַעֲקֹֽב׃"},{"ref":"Ps.114.8","start":19114008,"end":19114008,"break":"none","text":"הַהֹפְכִ֣י הַצּ֣וּר אֲגַם־מָ֑יִם חַ֝לָּמִ֗ישׁ לְמַעְיְנוֹ־מָֽיִם׃"}]