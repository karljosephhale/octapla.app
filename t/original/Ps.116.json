[{"ref":"Ps.116.1","start":19116001,"end":19116001,"break":"paragraph","text":"אָ֭הַבְתִּי כִּֽי־יִשְׁמַ֥ע ׀ יְהוָ֑ה אֶת־ק֝וֹלִ֗י תַּחֲנוּנָֽי׃"},{"ref":"Ps.116.2","start":19116002,"end":19116002,"break":"none","text":"כִּֽי־הִטָּ֣ה אָזְנ֣וֹ לִ֑י וּבְיָמַ֥י אֶקְרָֽא׃"},{"ref":"Ps.116.3","start":19116003,"end":19116003,"break":"none","text":"אֲפָפ֤וּנִי ׀ חֶבְלֵי־מָ֗וֶת וּמְצָרֵ֣י שְׁא֣וֹל מְצָא֑וּנִי צָרָ֖ה וְיָג֣וֹן אֶמְצָֽא׃"},{"ref":"Ps.116.4","start":19116004,"end":19116004,"break":"none","text":"וּבְשֵֽׁם־יְהוָ֥ה אֶקְרָ֑א אָנָּ֥ה יְ֝הוָ֗ה מַלְּטָ֥ה נַפְשִֽׁי׃"},{"ref":"Ps.116.5","start":19116005,"end":19116005,"break":"none","text":"חַנּ֣וּן יְהֹוָ֣ה וְצַדִּ֑יק וֵ֖אלֹהֵ֣ינוּ מְרַחֵֽם׃"},{"ref":"Ps.116.6","start":19116006,"end":19116006,"break":"none","text":"שֹׁמֵ֣ר פְּתָאיִ֣ם יְהֹוָ֑ה דַּ֝לּוֹתִ֗י וְלִ֣י יְהוֹשִֽׁיעַ׃"},{"ref":"Ps.116.7","start":19116007,"end":19116007,"break":"none","text":"שׁוּבִ֣י נַ֭פְשִׁי לִמְנוּחָ֑יְכִי כִּֽי־יְ֝הוָ֗ה גָּמַ֥ל עָלָֽיְכִי׃"},{"ref":"Ps.116.8","start":19116008,"end":19116008,"break":"none","text":"כִּ֤י חִלַּ֥צְתָּ נַפְשִׁ֗י מִ֫מָּ֥וֶת אֶת־עֵינִ֥י מִן־דִּמְעָ֑ה אֶת־רַגְלִ֥י מִדֶּֽחִי׃"},{"ref":"Ps.116.9","start":19116009,"end":19116009,"break":"none","text":"אֶ֭תְהַלֵּךְ לִפְנֵ֣י יְהוָ֑ה בְּ֝אַרְצ֗וֹת הַֽחַיִּֽים׃"},{"ref":"Ps.116.10","start":19116010,"end":19116010,"break":"none","text":"הֶ֭אֱמַנְתִּי כִּ֣י אֲדַבֵּ֑ר אֲ֝נִ֗י עָנִ֥יתִי מְאֹֽד׃"},{"ref":"Ps.116.11","start":19116011,"end":19116011,"break":"none","text":"אֲ֭נִי אָמַ֣רְתִּי בְחָפְזִ֑י כָּֽל־הָאָדָ֥ם כֹּזֵֽב׃"},{"ref":"Ps.116.12","start":19116012,"end":19116012,"break":"none","text":"מָֽה־אָשִׁ֥יב לַיהוָ֑ה כָּֽל־תַּגְמוּל֥וֹהִי עָלָֽי׃"},{"ref":"Ps.116.13","start":19116013,"end":19116013,"break":"none","text":"כּוֹס־יְשׁוּע֥וֹת אֶשָּׂ֑א וּבְשֵׁ֖ם יְהוָ֣ה אֶקְרָֽא׃"},{"ref":"Ps.116.14","start":19116014,"end":19116014,"break":"none","text":"נְ֭דָרַי לַיהוָ֣ה אֲשַׁלֵּ֑ם נֶגְדָה־נָּ֝֗א לְכָל־עַמּֽוֹ׃"},{"ref":"Ps.116.15","start":19116015,"end":19116015,"break":"none","text":"יָ֭קָר בְּעֵינֵ֣י יְהוָ֑ה הַ֝מָּ֗וְתָה לַחֲסִידָֽיו׃"},{"ref":"Ps.116.16","start":19116016,"end":19116016,"break":"none","text":"אָֽנָּ֣ה יְהוָה֮ כִּֽי־אֲנִ֪י עַ֫בְדֶּ֥ךָ אֲֽנִי־עַ֭בְדְּךָ בֶּן־אֲמָתֶ֑ךָ פִּ֝תַּ֗חְתָּ לְמוֹסֵרָֽי׃"},{"ref":"Ps.116.17","start":19116017,"end":19116017,"break":"none","text":"לְֽךָ־אֶ֭זְבַּח זֶ֣בַח תּוֹדָ֑ה וּבְשֵׁ֖ם יְהוָ֣ה אֶקְרָֽא׃"},{"ref":"Ps.116.18","start":19116018,"end":19116018,"break":"none","text":"נְ֭דָרַי לַיהוָ֣ה אֲשַׁלֵּ֑ם נֶגְדָה־נָּ֝֗א לְכָל־עַמּֽוֹ׃"},{"ref":"Ps.116.19","start":19116019,"end":19116019,"break":"none","text":"בְּחַצְר֤וֹת ׀ בֵּ֤ית יְהוָ֗ה בְּֽת֘וֹכֵ֤כִי יְֽרוּשָׁלִָ֗ם הַֽלְלוּ־יָֽהּ׃"}]