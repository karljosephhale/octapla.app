[{"ref":"Ps.150.1","start":19150001,"end":19150001,"break":"paragraph","text":"הַ֥לְלוּ יָ֨הּ ׀ הַֽלְלוּ־אֵ֥ל בְּקָדְשׁ֑וֹ הַֽ֝לְל֗וּהוּ בִּרְקִ֥יעַ עֻזּֽוֹ׃"},{"ref":"Ps.150.2","start":19150002,"end":19150002,"break":"none","text":"הַֽלְל֥וּהוּ בִגְבוּרֹתָ֑יו הַֽ֝לְל֗וּהוּ כְּרֹ֣ב גֻּדְלֽוֹ׃"},{"ref":"Ps.150.3","start":19150003,"end":19150003,"break":"none","text":"הַֽ֭לְלוּהוּ בְּתֵ֣קַע שׁוֹפָ֑ר הַֽ֝לְל֗וּהוּ בְּנֵ֣בֶל וְכִנּֽוֹר׃"},{"ref":"Ps.150.4","start":19150004,"end":19150004,"break":"none","text":"הַֽ֭לְלוּהוּ בְתֹ֣ף וּמָח֑וֹל הַֽ֝לְל֗וּהוּ בְּמִנִּ֥ים וְעוּגָֽב׃"},{"ref":"Ps.150.5","start":19150005,"end":19150005,"break":"none","text":"הַֽלְל֥וּהוּ בְצִלְצְלֵי־שָׁ֑מַע הַֽ֝לְל֗וּהוּ בְּֽצִלְצְלֵ֥י תְרוּעָֽה׃"},{"ref":"Ps.150.6","start":19150006,"end":19150006,"break":"none","text":"כֹּ֣ל הַ֭נְּשָׁמָה תְּהַלֵּ֥ל יָ֗הּ הַֽלְלוּ־יָֽהּ׃"}]