[{"ref":"Ps.108.1","start":19108001,"end":19108001,"break":"paragraph","text":"שִׁ֖יר מִזְמ֣וֹר לְדָוִֽד׃"},{"ref":"Ps.108.2","start":19108001,"end":19108001,"break":"none","text":"נָכ֣וֹן לִבִּ֣י אֱלֹהִ֑ים אָשִׁ֥ירָה וַ֝אֲזַמְּרָ֗ה אַף־כְּבוֹדִֽי׃"},{"ref":"Ps.108.3","start":19108002,"end":19108002,"break":"none","text":"ע֭וּרָֽה הַנֵּ֥בֶל וְכִנּ֗וֹר אָעִ֥ירָה שָּֽׁחַר׃"},{"ref":"Ps.108.4","start":19108003,"end":19108003,"break":"none","text":"אוֹדְךָ֖ בָעַמִּ֥ים ׀ יְהוָ֑ה וַ֝אֲזַמֶּרְךָ֗ בַּל־אֻמִּֽים׃"},{"ref":"Ps.108.5","start":19108004,"end":19108004,"break":"none","text":"כִּֽי־גָד֣וֹל מֵֽעַל־שָׁמַ֣יִם חַסְדֶּ֑ךָ וְֽעַד־שְׁחָקִ֥ים אֲמִתֶּֽךָ׃"},{"ref":"Ps.108.6","start":19108005,"end":19108005,"break":"none","text":"ר֣וּמָה עַל־שָׁמַ֣יִם אֱלֹהִ֑ים וְעַ֖ל כָּל־הָאָ֣רֶץ כְּבוֹדֶֽךָ׃"},{"ref":"Ps.108.7","start":19108006,"end":19108006,"break":"none","text":"לְ֭מַעַן יֵחָלְצ֣וּן יְדִידֶ֑יךָ הוֹשִׁ֖יעָה יְמִֽינְךָ֣ וַעֲנֵֽנִי׃"},{"ref":"Ps.108.8","start":19108007,"end":19108007,"break":"none","text":"אֱלֹהִ֤ים ׀ דִּבֶּ֥ר בְּקָדְשׁ֗וֹ אֶעְלֹ֥זָה אֲחַלְּקָ֥ה שְׁכֶ֑ם וְעֵ֖מֶק סֻכּ֣וֹת אֲמַדֵּֽד׃"},{"ref":"Ps.108.9","start":19108008,"end":19108008,"break":"none","text":"לִ֤י גִלְעָ֨ד ׀ לִ֤י מְנַשֶּׁ֗ה וְ֭אֶפְרַיִם מָע֣וֹז רֹאשִׁ֑י יְ֝הוּדָ֗ה מְחֹקְקִֽי׃"},{"ref":"Ps.108.10","start":19108009,"end":19108009,"break":"none","text":"מוֹאָ֤ב ׀ סִ֬יר רַחְצִ֗י עַל־אֱ֭דוֹם אַשְׁלִ֣יךְ נַעֲלִ֑י עֲלֵֽי־פְ֝לֶ֗שֶׁת אֶתְרוֹעָֽע׃"},{"ref":"Ps.108.11","start":19108010,"end":19108010,"break":"none","text":"מִ֣י יֹ֭בִלֵנִי עִ֣יר מִבְצָ֑ר מִ֖י נָחַ֣נִי עַד־אֱדֽוֹם׃"},{"ref":"Ps.108.12","start":19108011,"end":19108011,"break":"none","text":"הֲלֹֽא־אֱלֹהִ֥ים זְנַחְתָּ֑נוּ וְֽלֹא־תֵצֵ֥א אֱ֝לֹהִ֗ים בְּצִבְאֹתֵֽינוּ׃"},{"ref":"Ps.108.13","start":19108012,"end":19108012,"break":"none","text":"הָֽבָה־לָּ֣נוּ עֶזְרָ֣ת מִצָּ֑ר וְ֝שָׁ֗וְא תְּשׁוּעַ֥ת אָדָֽם׃"},{"ref":"Ps.108.14","start":19108013,"end":19108013,"break":"none","text":"בֵּֽאלֹהִ֥ים נַעֲשֶׂה־חָ֑יִל וְ֝ה֗וּא יָב֥וּס צָרֵֽינוּ׃"}]