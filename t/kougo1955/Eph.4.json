[{"ref":"Eph.4.1","start":49004001,"end":49004001,"break":"paragraph","ruby":[[3,1,"しゅ"],[7,2,"しゅうじん"],[23,1,"すす"],[33,1,"め"],[39,1,"め"],[47,1,"ある"]],"text":"さて、主にある囚人であるわたしは、あなたがたに勧める。あなたがたが召されたその召しにふさわしく歩き、"},{"ref":"Eph.4.2","start":49004002,"end":49004002,"break":"none","ruby":[[3,1,"かぎ"],[5,2,"けんきょ"],[11,2,"にゅうわ"],[17,2,"かんよう"],[20,1,"しめ"],[23,1,"あい"],[28,1,"たがい"],[30,1,"しの"]],"text":"できる限り謙虚で、かつ柔和であり、寛容を示し、愛をもって互に忍びあい、"},{"ref":"Eph.4.3","start":49004003,"end":49004003,"break":"none","ruby":[[0,2,"へいわ"],[7,1,"むす"],[12,2,"せいれい"],[17,2,"いっち"],[20,1,"まも"],[22,1,"つづ"],[28,1,"つと"]],"text":"平和のきずなで結ばれて、聖霊による一致を守り続けるように努めなさい。"},{"ref":"Eph.4.4","start":49004004,"end":49004004,"break":"none","ruby":[[7,2,"みたま"],[22,1,"め"],[32,1,"のぞ"],[35,1,"め"],[39,1,"め"],[45,2,"どうよう"]],"text":"からだは一つ、御霊も一つである。あなたがたが召されたのは、一つの望みを目ざして召されたのと同様である。"},{"ref":"Eph.4.5","start":49004005,"end":49004005,"break":"none","ruby":[[0,1,"しゅ"],[5,2,"しんこう"]],"text":"主は一つ、信仰は一つ、バプテスマは一つ。"},{"ref":"Eph.4.6","start":49004006,"end":49004006,"break":"none","ruby":[[7,1,"うえ"],[19,1,"つらぬ"],[29,1,"うち"],[42,1,"ちち"],[45,1,"かみ"]],"text":"すべてのものの上にあり、すべてのものを貫き、すべてのものの内にいます、すべてのものの父なる神は一つである。"},{"ref":"Eph.4.7","start":49004007,"end":49004007,"break":"none","ruby":[[10,1,"たま"],[13,2,"たまもの"],[20,1,"したが"],[37,1,"めぐ"],[40,1,"あた"]],"text":"しかし、キリストから賜わる賜物のはかりに従って、わたしたちひとりびとりに、恵みが与えられている。"},{"ref":"Eph.4.8","start":49004008,"end":49004008,"break":"none","breaks":[[13,"stanza"],[27,"line"],[39,"line"]],"ruby":[[6,1,"い"],[14,1,"かれ"],[16,1,"たか"],[22,1,"のぼ"],[25,1,"とき"],[31,1,"とら"],[34,1,"ひ"],[36,1,"ゆ"],[39,2,"ひとびと"],[42,2,"たまもの"],[45,1,"わ"],[47,1,"あた"]],"text":"そこで、こう言われている、「彼は高いところに上った時、とりこを捕えて引き行き、人々に賜物を分け与えた」。"},{"ref":"Eph.4.9","start":49004009,"end":49004009,"break":"none","ruby":[[3,1,"のぼ"],[8,1,"い"],[10,2,"いじょう"],[15,2,"ちか"],[18,1,"ひく"],[20,1,"そこ"],[23,1,"お"]],"text":"さて「上った」と言う以上、また地下の低い底にも降りてこられたわけではないか。"},{"ref":"Eph.4.10","start":49004010,"end":49004010,"break":"none","ruby":[[0,1,"お"],[7,1,"もの"],[8,2,"じしん"],[12,2,"どうじ"],[23,1,"み"],[35,1,"てん"],[37,1,"うえ"],[41,1,"のぼ"]],"text":"降りてこられた者自身は、同時に、あらゆるものに満ちるために、もろもろの天の上にまで上られたかたなのである。"},{"ref":"Eph.4.11","start":49004011,"end":49004011,"break":"none","ruby":[[3,1,"かれ"],[8,1,"ひと"],[10,2,"しと"],[17,1,"ひと"],[19,3,"よげんしゃ"],[27,1,"ひと"],[29,3,"でんどうしゃ"],[37,1,"ひと"],[39,2,"ぼくし"],[42,2,"きょうし"],[49,1,"た"]],"text":"そして彼は、ある人を使徒とし、ある人を預言者とし、ある人を伝道者とし、ある人を牧師、教師として、お立てになった。"},{"ref":"Eph.4.12","start":49004012,"end":49004012,"break":"none","ruby":[[4,2,"せいと"],[14,2,"ほうし"],[32,1,"た"]],"text":"それは、聖徒たちをととのえて奉仕のわざをさせ、キリストのからだを建てさせ、"},{"ref":"Eph.4.13","start":49004013,"end":49004013,"break":"none","ruby":[[9,1,"もの"],[12,1,"かみ"],[14,1,"こ"],[16,1,"しん"],[19,2,"しんこう"],[22,2,"いっち"],[25,1,"かれ"],[27,1,"し"],[29,2,"ちしき"],[32,2,"いっち"],[36,2,"とうたつ"],[40,1,"まった"],[42,1,"ひと"],[56,1,"み"],[61,1,"とく"],[63,1,"たか"],[68,1,"いた"]],"text":"わたしたちすべての者が、神の子を信じる信仰の一致と彼を知る知識の一致とに到達し、全き人となり、ついに、キリストの満ちみちた徳の高さにまで至るためである。"},{"ref":"Eph.4.14","start":49004014,"end":49004014,"break":"none","ruby":[[14,2,"こども"],[26,1,"まど"],[29,2,"さくりゃく"],[35,2,"ひとびと"],[38,2,"わるだく"],[45,1,"おこ"],[47,2,"さまざま"],[50,1,"おしえ"],[52,1,"かぜ"],[54,1,"ふ"]],"text":"こうして、わたしたちはもはや子供ではないので、だまし惑わす策略により、人々の悪巧みによって起る様々な教の風に吹きまわされたり、もてあそばれたりすることがなく、"},{"ref":"Eph.4.15","start":49004015,"end":49004015,"break":"none","ruby":[[0,1,"あい"],[5,2,"しんり"],[8,1,"かた"],[15,1,"てん"],[20,2,"せいちょう"],[34,1,"たっ"]],"text":"愛にあって真理を語り、あらゆる点において成長し、かしらなるキリストに達するのである。"},{"ref":"Eph.4.16","start":49004016,"end":49004016,"break":"none","ruby":[[8,1,"もとい"],[13,2,"ぜんしん"],[20,2,"ふしぶし"],[23,1,"たす"],[34,1,"く"],[36,1,"あ"],[40,1,"むす"],[42,1,"あ"],[52,2,"ぶぶん"],[55,1,"ぶん"],[57,1,"おう"],[60,1,"はたら"],[67,2,"せいちょう"],[72,1,"あい"],[77,1,"そだ"]],"text":"また、キリストを基として、全身はすべての節々の助けにより、しっかりと組み合わされ結び合わされ、それぞれの部分は分に応じて働き、からだを成長させ、愛のうちに育てられていくのである。"},{"ref":"Eph.4.17","start":49004017,"end":49004017,"break":"paragraph","ruby":[[8,1,"しゅ"],[18,1,"すす"],[28,2,"こんご"],[31,3,"いほうじん"],[39,1,"こころ"],[41,1,"ある"],[49,1,"ある"]],"text":"そこで、わたしは主にあっておごそかに勧める。あなたがたは今後、異邦人がむなしい心で歩いているように歩いてはならない。"},{"ref":"Eph.4.18","start":49004018,"end":49004018,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ちりょく"],[6,1,"くら"],[13,1,"うち"],[16,2,"むち"],[19,1,"こころ"],[21,2,"こうか"],[28,1,"かみ"],[35,1,"とお"],[37,1,"はな"]],"text":"彼らの知力は暗くなり、その内なる無知と心の硬化とにより、神のいのちから遠く離れ、"},{"ref":"Eph.4.19","start":49004019,"end":49004019,"break":"none","ruby":[[0,1,"みずか"],[2,3,"むかんかく"],[20,2,"ふけつ"],[23,1,"おこな"],[29,2,"ほうじゅう"],[32,1,"み"]],"text":"自ら無感覚になって、ほしいままにあらゆる不潔な行いをして、放縦に身をゆだねている。"},{"ref":"Eph.4.20","start":49004020,"end":49004020,"break":"none","ruby":[[20,1,"まな"]],"text":"しかしあなたがたは、そのようにキリストに学んだのではなかった。"},{"ref":"Eph.4.21","start":49004021,"end":49004021,"break":"none","ruby":[[10,1,"かれ"],[12,1,"き"],[15,1,"かれ"],[20,1,"おし"],[32,2,"しんり"],[39,1,"まな"]],"text":"あなたがたはたしかに彼に聞き、彼にあって教えられて、イエスにある真理をそのまま学んだはずである。"},{"ref":"Eph.4.22","start":49004022,"end":49004022,"break":"none","ruby":[[12,2,"いぜん"],[15,2,"せいかつ"],[18,1,"ぞく"],[22,2,"じょうよく"],[25,1,"まよ"],[28,1,"ほろ"],[30,1,"い"],[32,1,"ふる"],[34,1,"ひと"],[36,1,"ぬ"],[38,1,"す"]],"text":"すなわち、あなたがたは、以前の生活に属する、情欲に迷って滅び行く古き人を脱ぎ捨て、"},{"ref":"Eph.4.23","start":49004023,"end":49004023,"break":"none","ruby":[[0,1,"こころ"],[2,1,"ふか"],[6,1,"あら"]],"text":"心の深みまで新たにされて、"},{"ref":"Eph.4.24","start":49004024,"end":49004024,"break":"none","ruby":[[0,1,"しん"],[2,1,"ぎ"],[4,1,"せい"],[11,1,"かみ"],[18,1,"つく"],[22,1,"あたら"],[25,1,"ひと"],[27,1,"き"]],"text":"真の義と聖とをそなえた神にかたどって造られた新しき人を着るべきである。"},{"ref":"Eph.4.25","start":49004025,"end":49004025,"break":"paragraph","ruby":[[16,1,"いつわ"],[19,1,"す"],[27,1,"とな"],[29,1,"ひと"],[31,1,"たい"],[35,2,"しんじつ"],[38,1,"かた"],[52,1,"たがい"],[54,2,"したい"]],"text":"こういうわけだから、あなたがたは偽りを捨てて、おのおの隣り人に対して、真実を語りなさい。わたしたちは、お互に肢体なのであるから。"},{"ref":"Eph.4.26","start":49004026,"end":49004026,"break":"none","ruby":[[0,1,"いか"],[10,1,"つみ"],[12,1,"おか"],[21,1,"いきどお"],[28,1,"ひ"],[30,1,"く"]],"text":"怒ることがあっても、罪を犯してはならない。憤ったままで、日が暮れるようであってはならない。"},{"ref":"Eph.4.27","start":49004027,"end":49004027,"break":"none","ruby":[[3,2,"あくま"],[6,2,"きかい"],[9,1,"あた"]],"text":"また、悪魔に機会を与えてはいけない。"},{"ref":"Eph.4.28","start":49004028,"end":49004028,"break":"none","ruby":[[0,1,"ぬす"],[3,1,"もの"],[6,2,"こんご"],[9,1,"ぬす"],[22,1,"まず"],[25,2,"ひとびと"],[28,1,"わ"],[30,1,"あた"],[42,2,"じぶん"],[45,1,"て"],[47,2,"せいとう"],[50,1,"はたら"]],"text":"盗んだ者は、今後、盗んではならない。むしろ、貧しい人々に分け与えるようになるために、自分の手で正当な働きをしなさい。"},{"ref":"Eph.4.29","start":49004029,"end":49004029,"break":"none","ruby":[[0,1,"わる"],[2,2,"ことば"],[16,1,"くち"],[19,1,"だ"],[28,2,"ひつよう"],[35,1,"ひと"],[37,1,"とく"],[39,1,"たか"],[44,2,"やくだ"],[50,2,"ことば"],[53,1,"かた"],[57,1,"き"],[62,1,"もの"],[64,1,"えき"]],"text":"悪い言葉をいっさい、あなたがたの口から出してはいけない。必要があれば、人の徳を高めるのに役立つような言葉を語って、聞いている者の益になるようにしなさい。"},{"ref":"Eph.4.30","start":49004030,"end":49004030,"break":"none","ruby":[[0,1,"かみ"],[2,2,"せいれい"],[5,1,"かな"],[28,1,"ひ"],[34,2,"せいれい"],[37,2,"しょういん"],[40,1,"う"]],"text":"神の聖霊を悲しませてはいけない。あなたがたは、あがないの日のために、聖霊の証印を受けたのである。"},{"ref":"Eph.4.31","start":49004031,"end":49004031,"break":"none","ruby":[[4,3,"むじひ"],[8,1,"いきどお"],[11,1,"いか"],[14,1,"さわ"],[29,2,"あくい"],[32,1,"す"],[34,1,"さ"]],"text":"すべての無慈悲、憤り、怒り、騒ぎ、そしり、また、いっさいの悪意を捨て去りなさい。"},{"ref":"Eph.4.32","start":49004032,"end":49004032,"break":"none","ruby":[[0,1,"たがい"],[2,2,"なさけぶか"],[10,1,"ぶか"],[12,1,"もの"],[17,1,"かみ"],[37,1,"くだ"],[51,1,"たがい"],[56,1,"あ"]],"text":"互に情深く、あわれみ深い者となり、神がキリストにあってあなたがたをゆるして下さったように、あなたがたも互にゆるし合いなさい。"}]