[{"ref":"Lev.27.1","start":3027001,"end":3027001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Lev.27.2","start":3027002,"end":3027002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[17,1,"ひと"],[23,1,"ね"],[24,1,"づも"],[27,1,"したが"],[30,1,"しゅ"],[32,1,"み"],[38,2,"せいがん"],[43,1,"とき"]],"text":"「イスラエルの人々に言いなさい、『人があなたの値積りに従って主に身をささげる誓願をする時は、"},{"ref":"Lev.27.3","start":3027003,"end":3027003,"break":"none","ruby":[[4,1,"ね"],[5,1,"づも"],[11,1,"さい"],[16,1,"さい"],[20,1,"おとこ"],[26,1,"ね"],[27,1,"づも"],[30,2,"せいじょ"],[37,1,"したが"],[40,1,"ぎん"]],"text":"あなたの値積りは、二十歳から六十歳までの男には、その値積りを聖所のシケルに従って銀五十シケルとし、"},{"ref":"Lev.27.4","start":3027004,"end":3027004,"break":"none","ruby":[[0,1,"おんな"],[6,1,"ね"],[7,1,"づも"]],"text":"女には、その値積りは三十シケルとしなければならない。"},{"ref":"Lev.27.5","start":3027005,"end":3027005,"break":"none","ruby":[[3,1,"さい"],[8,1,"さい"],[13,1,"おとこ"],[18,1,"ね"],[19,1,"づも"],[30,1,"おんな"]],"text":"また五歳から二十歳までは、男にはその値積りを二十シケルとし、女には十シケルとしなければならない。"},{"ref":"Lev.27.6","start":3027006,"end":3027006,"break":"none","ruby":[[2,1,"げつ"],[6,1,"さい"],[11,1,"おとこ"],[16,1,"ね"],[17,1,"づも"],[20,1,"ぎん"],[28,1,"おんな"],[33,1,"ね"],[34,1,"づも"],[37,1,"ぎん"]],"text":"一か月から五歳までは、男にはその値積りを銀五シケルとし、女にはその値積りを銀三シケルとしなければならない。"},{"ref":"Lev.27.7","start":3027007,"end":3027007,"break":"none","ruby":[[4,1,"さい"],[5,2,"いじょう"],[9,1,"おとこ"],[14,1,"ね"],[15,1,"づも"],[26,1,"おんな"]],"text":"また六十歳以上は、男にはその値積りを十五シケルとし、女には十シケルとしなければならない。"},{"ref":"Lev.27.8","start":3027008,"end":3027008,"break":"none","ruby":[[4,1,"ひと"],[6,1,"まず"],[15,1,"ね"],[16,1,"づも"],[19,1,"おう"],[33,2,"さいし"],[36,1,"まえ"],[38,1,"た"],[41,2,"さいし"],[44,1,"ね"],[45,1,"づも"],[48,1,"う"],[59,2,"さいし"],[64,2,"せいがん"],[66,1,"しゃ"],[68,1,"ちから"],[70,1,"したが"],[73,1,"ね"],[74,1,"づも"]],"text":"もしその人が貧しくて、あなたの値積りに応じることができないならば、祭司の前に立ち、祭司の値積りを受けなければならない。祭司はその誓願者の力に従って値積らなければならない。"},{"ref":"Lev.27.9","start":3027009,"end":3027009,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"そな"],[4,1,"もの"],[14,2,"かちく"],[18,1,"ひと"],[20,1,"しゅ"],[32,1,"せい"],[35,1,"もの"]],"text":"主に供え物とすることができる家畜で、人が主にささげるものはすべて聖なる物となる。"},{"ref":"Lev.27.10","start":3027010,"end":3027010,"break":"none","ruby":[[9,2,"だいよう"],[19,1,"よ"],[21,1,"もの"],[23,1,"わる"],[25,1,"もの"],[28,1,"わる"],[30,1,"もの"],[32,1,"よ"],[34,1,"もの"],[36,1,"と"],[38,1,"か"],[49,2,"かちく"],[52,2,"かちく"],[56,1,"と"],[58,1,"か"],[67,1,"もの"],[73,1,"と"],[75,1,"か"],[78,1,"もの"],[80,1,"とも"],[82,1,"せい"],[85,1,"もの"]],"text":"ほかのものをそれに代用してはならない。良い物を悪い物に、悪い物を良い物に取り換えてはならない。もし家畜と家畜とを取り換えるならば、その物も、それと取り換えた物も共に聖なる物となるであろう。"},{"ref":"Lev.27.11","start":3027011,"end":3027011,"break":"none","ruby":[[5,1,"けが"],[8,2,"かちく"],[12,1,"しゅ"],[14,1,"そな"],[16,1,"もの"],[38,1,"ひと"],[42,2,"かちく"],[45,2,"さいし"],[48,1,"まえ"],[50,1,"ひ"]],"text":"もしそれが汚れた家畜で、主に供え物としてささげられないものであるならば、その人はその家畜を祭司の前に引いてこなければならない。"},{"ref":"Lev.27.12","start":3027012,"end":3027012,"break":"none","ruby":[[0,2,"さいし"],[5,1,"よ"],[7,1,"わる"],[10,1,"したが"],[17,1,"ね"],[18,1,"づも"],[32,2,"さいし"],[35,2,"ねづも"]],"text":"祭司はその良い悪いに従って、それを値積らなければならない。それは祭司が値積るとおりになるであろう。"},{"ref":"Lev.27.13","start":3027013,"end":3027013,"break":"none","ruby":[[4,1,"ひと"],[24,1,"ね"],[25,1,"づも"],[31,1,"ぶん"],[35,1,"くわ"]],"text":"もしその人が、それをあがなおうとするならば、その値積りにその五分の一を加えなければならない。"},{"ref":"Lev.27.14","start":3027014,"end":3027014,"break":"paragraph","ruby":[[2,1,"ひと"],[4,2,"じぶん"],[7,1,"いえ"],[9,1,"しゅ"],[11,1,"せい"],[14,1,"もの"],[26,2,"さいし"],[31,1,"よ"],[33,1,"わる"],[36,1,"したが"],[43,1,"ね"],[44,1,"づも"],[58,2,"さいし"],[61,1,"ね"],[62,1,"づも"]],"text":"もし人が自分の家を主に聖なる物としてささげるときは、祭司はその良い悪いに従って、それを値積らなければならない。それは祭司が値積ったとおりになるであろう。"},{"ref":"Lev.27.15","start":3027015,"end":3027015,"break":"none","ruby":[[4,1,"いえ"],[10,1,"ひと"],[30,1,"ね"],[31,1,"づも"],[34,1,"かね"],[40,1,"ぶん"],[44,1,"くわ"],[64,1,"かれ"]],"text":"もしその家をささげる人が、それをあがなおうとするならば、その値積りの金に、その五分の一を加えなければならない。そうすれば、それは彼のものとなるであろう。"},{"ref":"Lev.27.16","start":3027016,"end":3027016,"break":"paragraph","ruby":[[2,1,"ひと"],[4,2,"そうぞく"],[8,1,"はたけ"],[10,2,"いちぶ"],[13,1,"しゅ"],[32,1,"たね"],[34,2,"たしょう"],[37,1,"おう"],[41,1,"ね"],[42,1,"づも"],[58,2,"おおむぎ"],[65,1,"たね"],[67,1,"ぎん"],[74,1,"ね"],[75,1,"づも"]],"text":"もし人が相続した畑の一部を主にささげるときは、あなたはそこにまく種の多少に応じて、値積らなければならない。すなわち、大麦一ホメルの種を銀五十シケルに値積らなければならない。"},{"ref":"Lev.27.17","start":3027017,"end":3027017,"break":"none","ruby":[[4,1,"はたけ"],[10,1,"とし"],[25,1,"あたい"],[31,1,"ね"],[32,1,"づも"]],"text":"もしその畑をヨベルの年からささげるのであれば、その価はあなたの値積りのとおりになるであろう。"},{"ref":"Lev.27.18","start":3027018,"end":3027018,"break":"none","ruby":[[4,1,"はたけ"],[10,1,"とし"],[12,1,"のち"],[24,2,"さいし"],[31,1,"とし"],[35,1,"のこ"],[40,1,"とし"],[42,1,"かず"],[44,1,"したが"],[49,1,"かね"],[51,1,"かぞ"],[61,1,"ね"],[62,1,"づも"],[68,1,"ひ"]],"text":"もしその畑をヨベルの年の後にささげるのであれば、祭司はヨベルの年までに残っている年の数に従ってその金を数え、それをあなたの値積りからさし引かなければならない。"},{"ref":"Lev.27.19","start":3027019,"end":3027019,"break":"none","ruby":[[7,1,"はたけ"],[13,1,"ひと"],[35,1,"ね"],[36,1,"づも"],[39,1,"かね"],[44,1,"ぶん"],[48,1,"くわ"],[68,1,"かれ"],[73,1,"き"]],"text":"もしまた、その畑をささげる人が、それをあがなおうとするならば、あなたの値積りの金にその五分の一を加えなければならない。そうすれば、それは彼のものと決まるであろう。"},{"ref":"Lev.27.20","start":3027020,"end":3027020,"break":"none","ruby":[[8,1,"はたけ"],[21,1,"た"],[23,1,"ひと"],[25,1,"う"]],"text":"しかし、もしその畑をあがなわず、またそれを他の人に売るならば、それはもはやあがなうことができないであろう。"},{"ref":"Lev.27.21","start":3027021,"end":3027021,"break":"none","ruby":[[2,1,"はたけ"],[9,1,"とし"],[14,2,"きげん"],[17,1,"き"],[24,2,"ほうのう"],[27,1,"はたけ"],[29,1,"おな"],[33,1,"しゅ"],[35,1,"せい"],[38,1,"もの"],[43,2,"さいし"],[46,2,"しょゆう"]],"text":"その畑は、ヨベルの年になって期限が切れるならば、奉納の畑と同じく、主の聖なる物となり、祭司の所有となるであろう。"},{"ref":"Lev.27.22","start":3027022,"end":3027022,"break":"none","ruby":[[4,2,"そうぞく"],[8,1,"はたけ"],[10,2,"いちぶ"],[16,1,"か"],[19,1,"はたけ"],[21,1,"しゅ"],[27,1,"とき"]],"text":"もしまた相続した畑の一部でなく、買った畑を主にささげる時は、"},{"ref":"Lev.27.23","start":3027023,"end":3027023,"break":"none","ruby":[[0,2,"さいし"],[3,1,"ね"],[4,1,"づも"],[12,1,"とし"],[16,1,"かね"],[18,1,"かぞ"],[31,1,"ひと"],[35,1,"ね"],[36,1,"づも"],[39,1,"かね"],[43,1,"ひ"],[45,1,"しゅ"],[52,1,"せい"],[55,1,"もの"]],"text":"祭司は値積りしてヨベルの年までの金を数えなければならない。その人はその値積りの金をその日に主にささげて、聖なる物としなければならない。"},{"ref":"Lev.27.24","start":3027024,"end":3027024,"break":"none","ruby":[[4,1,"とし"],[8,1,"はたけ"],[10,1,"う"],[12,1,"ぬし"],[18,1,"ち"],[20,2,"そうぞく"],[22,1,"しゃ"],[24,1,"かえ"]],"text":"ヨベルの年にその畑は売り主であるその地の相続者に返るであろう。"},{"ref":"Lev.27.25","start":3027025,"end":3027025,"break":"none","ruby":[[7,1,"ね"],[8,1,"づも"],[11,2,"せいじょ"]],"text":"すべてあなたの値積りは聖所のシケルによってしなければならない。二十ゲラを一シケルとする。"},{"ref":"Lev.27.26","start":3027026,"end":3027026,"break":"paragraph","ruby":[[4,2,"かちく"],[21,1,"しゅ"],[45,1,"うし"],[48,1,"ひつじ"],[55,1,"しゅ"]],"text":"しかし、家畜のういごは、ういごとしてすでに主のものだから、だれもこれをささげてはならない。牛でも羊でも、それは主のものである。"},{"ref":"Lev.27.27","start":3027027,"end":3027027,"break":"none","ruby":[[2,1,"けが"],[5,2,"かちく"],[18,1,"ね"],[19,1,"づも"],[25,1,"ぶん"],[29,1,"くわ"],[35,1,"ひと"],[68,1,"ね"],[69,1,"づも"],[72,1,"したが"],[75,1,"う"]],"text":"もし汚れた家畜であるならば、あなたの値積りにその五分の一を加えて、その人はこれをあがなわなければならない。もしあがなわないならば、それを値積りに従って売らなければならない。"},{"ref":"Lev.27.28","start":3027028,"end":3027028,"break":"paragraph","ruby":[[4,1,"ひと"],[6,2,"じぶん"],[9,1,"も"],[21,3,"ほうのうぶつ"],[27,1,"しゅ"],[37,1,"ひと"],[44,2,"かちく"],[54,2,"そうぞく"],[57,1,"はたけ"],[71,1,"う"],[93,3,"ほうのうぶつ"],[100,1,"しゅ"],[102,1,"ぞく"],[107,1,"せい"],[110,1,"もの"]],"text":"ただし、人が自分の持っているもののうちから奉納物として主にささげたものは、人であっても、家畜であっても、また相続の畑であっても、いっさいこれを売ってはならない。またあがなってはならない。奉納物はすべて主に属するいと聖なる物である。"},{"ref":"Lev.27.29","start":3027029,"end":3027029,"break":"none","ruby":[[5,1,"ひと"],[11,3,"ほうのうぶつ"],[23,1,"ひと"],[37,1,"かれ"],[39,1,"かなら"],[41,1,"ころ"]],"text":"またすべて人のうちから奉納物としてささげられた人は、あがなってはならない。彼は必ず殺されなければならない。"},{"ref":"Lev.27.30","start":3027030,"end":3027030,"break":"paragraph","ruby":[[0,1,"ち"],[3,1,"ぶん"],[7,1,"ち"],[9,2,"さんぶつ"],[15,1,"き"],[17,1,"み"],[25,1,"しゅ"],[34,1,"しゅ"],[36,1,"せい"],[39,1,"もの"]],"text":"地の十分の一は地の産物であれ、木の実であれ、すべて主のものであって、主に聖なる物である。"},{"ref":"Lev.27.31","start":3027031,"end":3027031,"break":"none","ruby":[[2,1,"ひと"],[7,1,"ぶん"],[19,1,"とき"],[28,1,"ぶん"],[32,1,"くわ"]],"text":"もし人がその十分の一をあがなおうとする時は、それにその五分の一を加えなければならない。"},{"ref":"Lev.27.32","start":3027032,"end":3027032,"break":"none","ruby":[[0,1,"うし"],[4,1,"ひつじ"],[7,1,"ぶん"],[19,2,"ぼくしゃ"],[25,1,"した"],[28,2,"ばんめ"],[31,1,"とお"],[37,1,"しゅ"],[39,1,"せい"],[42,1,"もの"]],"text":"牛または羊の十分の一については、すべて牧者のつえの下を十番目に通るものは、主に聖なる物である。"},{"ref":"Lev.27.33","start":3027033,"end":3027033,"break":"none","ruby":[[2,1,"よ"],[4,1,"わる"],[7,1,"と"],[21,1,"と"],[23,1,"か"],[34,1,"と"],[36,1,"か"],[49,1,"と"],[51,1,"か"],[59,1,"とも"],[61,1,"せい"],[64,1,"もの"]],"text":"その良い悪いを問うてはならない。またそれを取り換えてはならない。もし取り換えたならば、それと、その取り換えたものとは、共に聖なる物となるであろう。それをあがなうことはできない』」。"},{"ref":"Lev.27.34","start":3027034,"end":3027034,"break":"paragraph","ruby":[[4,1,"しゅ"],[10,1,"さん"],[19,2,"ひとびと"],[30,1,"めい"],[35,1,"いまし"]],"text":"これらは主が、シナイ山で、イスラエルの人々のために、モーセに命じられた戒めである。"}]