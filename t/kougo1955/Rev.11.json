[{"ref":"Rev.11.1","start":66011001,"end":66011001,"break":"paragraph","ruby":[[15,1,"はか"],[20,1,"あた"],[28,1,"めい"],[37,1,"た"],[41,1,"かみ"],[43,2,"せいじょ"],[46,2,"さいだん"],[53,2,"れいはい"],[59,2,"ひとびと"],[64,1,"はか"]],"text":"それから、わたしはつえのような測りざおを与えられて、こう命じられた、「さあ立って、神の聖所と祭壇と、そこで礼拝している人々とを、測りなさい。"},{"ref":"Rev.11.2","start":66011002,"end":66011002,"break":"none","ruby":[[0,2,"せいじょ"],[3,1,"そと"],[5,1,"にわ"],[23,1,"はか"],[35,3,"いほうじん"],[39,1,"あた"],[44,1,"ところ"],[49,1,"かれ"],[57,1,"げつ"],[59,1,"あいだ"],[62,1,"せい"],[65,1,"みやこ"],[67,1,"ふ"]],"text":"聖所の外の庭はそのままにしておきなさい。それを測ってはならない。そこは異邦人に与えられた所だから。彼らは、四十二か月の間この聖なる都を踏みにじるであろう。"},{"ref":"Rev.11.3","start":66011003,"end":66011003,"break":"none","ruby":[[16,2,"しょうにん"],[20,2,"あらぬの"],[23,1,"き"],[31,1,"にち"],[36,2,"よげん"],[43,1,"ゆる"]],"text":"そしてわたしは、わたしのふたりの証人に、荒布を着て、千二百六十日のあいだ預言することを許そう」。"},{"ref":"Rev.11.4","start":66011004,"end":66011004,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ぜん"],[5,1,"ち"],[7,1,"しゅ"],[13,1,"た"],[19,1,"ほん"],[25,1,"き"],[33,2,"しょくだい"]],"text":"彼らは、全地の主のみまえに立っている二本のオリブの木、また、二つの燭台である。"},{"ref":"Rev.11.5","start":66011005,"end":66011005,"break":"none","ruby":[[2,1,"かれ"],[5,1,"がい"],[7,1,"くわ"],[14,1,"もの"],[20,1,"かれ"],[23,1,"くち"],[26,1,"ひ"],[28,1,"で"],[33,1,"てき"],[35,1,"ほろ"],[45,1,"かれ"],[48,1,"がい"],[50,1,"くわ"],[57,1,"もの"],[65,1,"もの"],[72,1,"ころ"]],"text":"もし彼らに害を加えようとする者があれば、彼らの口から火が出て、その敵を滅ぼすであろう。もし彼らに害を加えようとする者があれば、その者はこのように殺されねばならない。"},{"ref":"Rev.11.6","start":66011006,"end":66011006,"break":"none","ruby":[[0,2,"よげん"],[7,2,"きかん"],[10,1,"かれ"],[14,1,"てん"],[16,1,"と"],[19,1,"あめ"],[21,1,"ふ"],[31,1,"ちから"],[33,1,"も"],[45,1,"みず"],[47,1,"ち"],[49,1,"か"],[52,1,"なに"],[53,1,"ど"],[56,1,"おも"],[66,2,"さいがい"],[69,1,"ち"],[71,1,"う"],[73,1,"ちから"],[75,1,"も"]],"text":"預言をしている期間、彼らは、天を閉じて雨を降らせないようにする力を持っている。さらにまた、水を血に変え、何度でも思うままに、あらゆる災害で地を打つ力を持っている。"},{"ref":"Rev.11.7","start":66011007,"end":66011007,"break":"none","ruby":[[4,1,"かれ"],[13,1,"お"],[18,1,"そこ"],[19,1,"し"],[22,1,"ところ"],[29,1,"く"],[31,1,"けもの"],[34,1,"かれ"],[37,1,"たたか"],[40,1,"う"],[42,1,"か"],[45,1,"かれ"],[48,1,"ころ"]],"text":"そして、彼らがそのあかしを終えると、底知れぬ所からのぼって来る獣が、彼らと戦って打ち勝ち、彼らを殺す。"},{"ref":"Rev.11.8","start":66011008,"end":66011008,"break":"none","ruby":[[0,1,"かれ"],[3,2,"したい"],[24,1,"おお"],[28,1,"みやこ"],[30,2,"おおどお"],[40,1,"かれ"],[43,1,"しゅ"],[48,1,"みやこ"],[50,3,"じゅうじか"]],"text":"彼らの死体はソドムや、エジプトにたとえられている大いなる都の大通りにさらされる。彼らの主も、この都で十字架につけられたのである。"},{"ref":"Rev.11.9","start":66011009,"end":66011009,"break":"none","ruby":[[5,2,"みんぞく"],[8,2,"ぶぞく"],[11,2,"こくご"],[14,2,"こくみん"],[17,1,"ぞく"],[20,2,"ひとびと"],[25,1,"か"],[26,1,"はん"],[28,1,"あいだ"],[30,1,"かれ"],[33,2,"したい"],[44,2,"したい"],[47,1,"はか"],[49,1,"おさ"],[55,1,"ゆる"]],"text":"いろいろな民族、部族、国語、国民に属する人々が、三日半の間、彼らの死体をながめるが、その死体を墓に納めることは許さない。"},{"ref":"Rev.11.10","start":66011010,"end":66011010,"break":"none","ruby":[[0,1,"ち"],[2,1,"す"],[4,2,"ひとびと"],[8,1,"かれ"],[14,1,"よろこ"],[16,1,"たの"],[20,1,"たがい"],[22,1,"おく"],[24,1,"もの"],[36,3,"よげんしゃ"],[41,1,"ち"],[43,1,"す"],[45,1,"もの"],[49,1,"なや"]],"text":"地に住む人々は、彼らのことで喜び楽しみ、互に贈り物をしあう。このふたりの預言者は、地に住む者たちを悩ましたからである。"},{"ref":"Rev.11.11","start":66011011,"end":66011011,"break":"none","ruby":[[1,1,"か"],[2,1,"はん"],[4,1,"のち"],[10,1,"いき"],[13,1,"かみ"],[16,1,"で"],[18,1,"かれ"],[21,1,"なか"],[31,1,"かれ"],[34,1,"た"],[36,1,"あ"],[46,1,"み"],[48,2,"ひとびと"],[51,2,"ひじょう"],[54,2,"きょうふ"],[57,1,"おそ"]],"text":"三日半の後、いのちの息が、神から出て彼らの中にはいり、そして、彼らが立ち上がったので、それを見た人々は非常な恐怖に襲われた。"},{"ref":"Rev.11.12","start":66011012,"end":66011012,"break":"none","ruby":[[2,1,"とき"],[4,1,"てん"],[7,1,"おお"],[10,1,"こえ"],[19,1,"のぼ"],[28,1,"い"],[33,1,"かれ"],[36,1,"き"],[44,1,"かれ"],[47,1,"くも"],[49,1,"の"],[52,1,"てん"],[54,1,"のぼ"],[58,1,"かれ"],[61,1,"てき"],[66,1,"み"]],"text":"その時、天から大きな声がして、「ここに上ってきなさい」と言うのを、彼らは聞いた。そして、彼らは雲に乗って天に上った。彼らの敵はそれを見た。"},{"ref":"Rev.11.13","start":66011013,"end":66011013,"break":"none","ruby":[[2,1,"とき"],[4,1,"だい"],[5,2,"じしん"],[8,1,"おこ"],[12,1,"みやこ"],[14,2,"じゅうぶん"],[19,1,"たお"],[24,2,"じしん"],[29,1,"にん"],[31,1,"し"],[34,1,"い"],[36,1,"のこ"],[39,2,"ひとびと"],[42,1,"おどろ"],[44,1,"おそ"],[48,1,"てん"],[50,1,"かみ"],[52,2,"えいこう"],[55,1,"き"]],"text":"この時、大地震が起って、都の十分の一は倒れ、その地震で七千人が死に、生き残った人々は驚き恐れて、天の神に栄光を帰した。"},{"ref":"Rev.11.14","start":66011014,"end":66011014,"break":"paragraph","ruby":[[0,1,"だい"],[9,1,"す"],[11,1,"さ"],[15,1,"み"],[18,1,"だい"],[29,1,"く"]],"text":"第二のわざわいは、過ぎ去った。見よ、第三のわざわいがすぐに来る。"},{"ref":"Rev.11.15","start":66011015,"end":66011015,"break":"paragraph","breaks":[[37,"stanza"],[45,"line"],[65,"line"]],"ruby":[[0,1,"だい"],[3,2,"みつかい"],[11,1,"ふ"],[13,1,"な"],[22,1,"おお"],[25,2,"こえごえ"],[28,1,"てん"],[30,1,"おこ"],[33,1,"い"],[40,1,"よ"],[42,1,"くに"],[49,1,"しゅ"],[59,1,"くに"],[65,1,"しゅ"],[67,2,"よよ"],[69,1,"かぎ"],[73,2,"しはい"]],"text":"第七の御使が、ラッパを吹き鳴らした。すると、大きな声々が天に起って言った、「この世の国は、われらの主とそのキリストとの国となった。主は世々限りなく支配なさるであろう」。"},{"ref":"Rev.11.16","start":66011016,"end":66011016,"break":"none","ruby":[[4,1,"かみ"],[10,1,"ざ"],[20,1,"にん"],[22,2,"ちょうろう"],[28,1,"ふ"],[31,1,"かみ"],[33,1,"はい"],[36,1,"い"]],"text":"そして、神のみまえで座についている二十四人の長老は、ひれ伏し、神を拝して言った、"},{"ref":"Rev.11.17","start":66011017,"end":66011017,"break":"stanza","breaks":[[24,"line"],[45,"line"]],"ruby":[[1,1,"いま"],[6,1,"むかし"],[12,3,"ぜんのうしゃ"],[18,1,"しゅ"],[21,1,"かみ"],[24,1,"おお"],[28,1,"み"],[29,1,"ちから"],[35,2,"しはい"],[45,2,"かんしゃ"]],"text":"「今いまし、昔いませる、全能者にして主なる神よ。大いなる御力をふるって支配なさったことを、感謝します。"},{"ref":"Rev.11.18","start":66011018,"end":66011018,"break":"line","breaks":[[13,"line"],[29,"line"],[47,"line"],[67,"line"],[90,"line"]],"ruby":[[0,1,"しょ"],[1,2,"こくみん"],[4,1,"いか"],[6,1,"くる"],[17,1,"いか"],[33,2,"しにん"],[44,1,"しもべ"],[47,3,"よげんしゃ"],[51,2,"せいと"],[54,1,"ちい"],[57,1,"もの"],[60,1,"おお"],[64,1,"もの"],[70,2,"みな"],[77,1,"もの"],[81,1,"むく"],[84,1,"あた"],[90,1,"ち"],[92,1,"ほろ"],[95,1,"もの"],[99,1,"ほろ"],[103,1,"くだ"],[106,1,"とき"]],"text":"諸国民は怒り狂いましたが、あなたも怒りをあらわされました。そして、死人をさばき、あなたの僕なる預言者、聖徒、小さき者も、大いなる者も、すべて御名をおそれる者たちに報いを与え、また、地を滅ぼす者どもを滅ぼして下さる時がきました」。"},{"ref":"Rev.11.19","start":66011019,"end":66011019,"break":"paragraph","ruby":[[4,1,"てん"],[8,1,"かみ"],[10,2,"せいじょ"],[13,1,"ひら"],[17,2,"せいじょ"],[20,1,"なか"],[22,2,"けいやく"],[25,1,"はこ"],[27,1,"み"],[45,1,"こえ"],[48,2,"らいめい"],[52,2,"じしん"],[56,1,"おこ"],[59,2,"おおつぶ"],[62,1,"ひょう"],[64,1,"ふ"]],"text":"そして、天にある神の聖所が開けて、聖所の中に契約の箱が見えた。また、いなずまと、もろもろの声と、雷鳴と、地震とが起り、大粒の雹が降った。"}]