[{"ref":"Jer.9.1","start":24009001,"end":24009001,"break":"paragraph","breaks":[[14,"line"],[32,"line"],[55,"line"]],"ruby":[[7,1,"あたま"],[9,1,"みず"],[18,1,"め"],[20,1,"なみだ"],[22,1,"いずみ"],[42,1,"たみ"],[44,1,"むすめ"],[46,1,"ころ"],[50,1,"もの"],[55,1,"ひる"],[57,1,"よる"],[59,1,"なげ"]],"text":"ああ、わたしの頭が水となり、わたしの目が涙の泉となればよいのに。そうすれば、わたしは民の娘の殺された者のために昼も夜も嘆くことができる。"},{"ref":"Jer.9.2","start":24009002,"end":24009002,"break":"line","breaks":[[11,"line"],[30,"line"],[45,"line"],[57,"line"],[68,"line"]],"ruby":[[7,2,"あらの"],[11,2,"たいしょう"],[14,1,"やど"],[16,1,"え"],[40,1,"たみ"],[42,1,"はな"],[45,1,"さ"],[48,1,"い"],[57,1,"かれ"],[62,2,"かんいん"],[66,1,"もの"],[68,2,"ふしん"]],"text":"ああ、わたしが荒野に、隊商の宿を得ることができればよいのに。そうすれば、わたしは民を離れて去って行くことができる。彼らはみな姦淫する者、不信のともがらだからである。"},{"ref":"Jer.9.3","start":24009003,"end":24009003,"break":"line","breaks":[[19,"line"],[39,"line"],[50,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ゆみ"],[13,1,"した"],[15,1,"ま"],[19,2,"しんじつ"],[26,1,"いつわ"],[31,1,"ち"],[33,1,"つよ"],[39,1,"かれ"],[42,1,"あく"],[45,1,"あく"],[47,1,"すす"],[56,1,"し"],[62,1,"しゅ"],[64,1,"い"]],"text":"彼らは弓をひくように、その舌を曲げる。真実ではなく、偽りがこの地に強くなった。彼らは悪より悪に進み、またわたしを知らないと、主は言われる。"},{"ref":"Jer.9.4","start":24009004,"end":24009004,"break":"stanza","breaks":[[20,"line"],[35,"line"],[51,"line"]],"ruby":[[10,1,"とな"],[12,1,"びと"],[14,1,"き"],[22,2,"きょうだい"],[26,1,"しん"],[35,2,"きょうだい"],[41,1,"お"],[46,1,"もの"],[51,1,"とな"],[53,1,"びと"],[63,1,"ある"],[65,1,"もの"]],"text":"あなたがたはおのおの隣り人に気をつけよ。どの兄弟をも信じてはならない。兄弟はみな、押しのける者であり、隣り人はみな、ののしって歩く者だからである。"},{"ref":"Jer.9.5","start":24009005,"end":24009005,"break":"line","breaks":[[14,"line"],[24,"line"],[43,"line"]],"ruby":[[0,1,"ひと"],[7,1,"とな"],[9,1,"びと"],[11,1,"あざむ"],[14,2,"しんじつ"],[17,1,"い"],[19,1,"もの"],[24,1,"かれ"],[27,2,"じぶん"],[30,1,"した"],[32,1,"いつわ"],[35,1,"い"],[40,1,"おし"],[43,1,"あく"],[45,1,"おこな"],[48,1,"つか"],[51,1,"く"],[53,1,"あらた"]],"text":"人はみな、その隣り人を欺き、真実を言う者はない。彼らは自分の舌に偽りを言うことを教え、悪を行い、疲れて悔い改めるいとまもなく、"},{"ref":"Jer.9.6","start":24009006,"end":24009006,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[11,1,"つ"],[13,1,"かさ"],[16,1,"いつわ"],[19,1,"いつわ"],[22,1,"つ"],[24,1,"かさ"],[31,1,"し"],[36,1,"こば"],[43,1,"しゅ"],[45,1,"い"]],"text":"しえたげに、しえたげを積み重ね、偽りに偽りを積み重ね、わたしを知ることを拒んでいると、主は言われる。"},{"ref":"Jer.9.7","start":24009007,"end":24009007,"break":"stanza","breaks":[[16,"line"],[35,"line"]],"ruby":[[4,2,"ばんぐん"],[7,1,"しゅ"],[11,1,"い"],[17,1,"み"],[24,1,"かれ"],[27,1,"と"],[31,1,"こころ"],[42,1,"たみ"]],"text":"それゆえ万軍の主はこう言われる、「見よ、わたしは彼らを溶かし、試みる。このほか、わが民をどうすることができよう。"},{"ref":"Jer.9.8","start":24009008,"end":24009008,"break":"line","breaks":[[13,"line"],[22,"line"],[44,"line"]],"ruby":[[0,1,"かれ"],[3,1,"した"],[5,1,"ころ"],[7,1,"や"],[16,1,"いつわ"],[19,1,"い"],[24,1,"くち"],[31,1,"とな"],[33,1,"びと"],[40,1,"かた"],[46,1,"こころ"],[49,1,"かれ"],[51,1,"ま"],[53,1,"ぶ"],[56,1,"はか"],[61,1,"た"]],"text":"彼らの舌は殺す矢のようだ、それは偽りを言う。その口ではおのおの隣り人におだやかに語るが、その心では彼を待ち伏せる計りごとを立てる。"},{"ref":"Jer.9.9","start":24009009,"end":24009009,"break":"line","breaks":[[18,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[22,1,"かれ"],[25,1,"ばっ"],[43,1,"たみ"],[48,1,"かえ"]],"text":"主は言われる、これらのことのために、わたしが彼らを罰しないだろうか。わたしがこのような民にあだを返さないだろうか。"},{"ref":"Jer.9.10","start":24009010,"end":24009010,"break":"stanza","breaks":[[22,"line"],[43,"line"],[59,"line"]],"ruby":[[0,1,"やま"],[5,1,"な"],[7,1,"さけ"],[10,1,"の"],[12,2,"まきば"],[18,1,"かな"],[26,1,"あ"],[33,1,"とお"],[35,1,"す"],[38,1,"ひと"],[47,1,"うし"],[49,1,"ひつじ"],[51,1,"な"],[53,1,"こえ"],[55,1,"きこ"],[59,1,"そら"],[61,1,"とり"],[63,1,"けもの"],[65,1,"みな"],[66,1,"に"],[68,1,"さ"]],"text":"山のために泣き叫び、野の牧場のために悲しめ。これらは荒れすたれて、通り過ぎる人もない。ここには牛、羊の鳴く声も聞えず、空の鳥も獣も皆逃げ去った。"},{"ref":"Jer.9.11","start":24009011,"end":24009011,"break":"line","breaks":[[23,"line"]],"ruby":[[10,2,"あれづか"],[15,2,"やまいぬ"],[18,1,"す"],[28,2,"まちまち"],[31,1,"あら"],[35,1,"す"],[37,1,"ひと"],[41,1,"ところ"]],"text":"わたしはエルサレムを荒塚とし、山犬の巣とする。またユダの町々を荒して、住む人もない所とする」。"},{"ref":"Jer.9.12","start":24009012,"end":24009012,"break":"paragraph","ruby":[[0,2,"ちえ"],[10,1,"さと"],[18,1,"ひと"],[24,1,"しゅ"],[26,1,"くち"],[28,2,"ことば"],[38,1,"しめ"],[40,1,"ひと"],[48,1,"ち"],[50,1,"ほろ"],[55,2,"あらの"],[64,1,"とお"],[66,1,"す"],[69,1,"ひと"]],"text":"知恵があって、これを悟ることのできる人はだれか。主の口の言葉をうけて、それを示す人はだれか。この地が滅ぼされて荒野のようになり、通り過ぎる人もなくなったのはどういうわけか。"},{"ref":"Jer.9.13","start":24009013,"end":24009013,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"かれ"],[14,1,"まえ"],[20,1,"た"],[27,1,"かれ"],[30,1,"す"],[38,1,"こえ"],[40,1,"き"],[42,1,"したが"],[52,1,"ある"]],"text":"主は言われる、「それは彼らの前にわたしが立てたおきてを彼らが捨てて、わたしの声に聞き従わず、そのとおりに歩かなかったからである。"},{"ref":"Jer.9.14","start":24009014,"end":24009014,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ごうじょう"],[6,2,"じぶん"],[9,1,"こころ"],[11,1,"したが"],[16,2,"せんぞ"],[19,1,"おし"],[29,1,"したが"]],"text":"彼らは強情に自分の心に従い、また先祖の教えたようにバアルに従った。"},{"ref":"Jer.9.15","start":24009015,"end":24009015,"break":"none","ruby":[[4,2,"ばんぐん"],[7,1,"しゅ"],[15,1,"かみ"],[19,1,"い"],[24,1,"み"],[33,1,"たみ"],[42,1,"た"],[47,1,"どく"],[49,1,"みず"],[51,1,"の"]],"text":"それゆえ万軍の主、イスラエルの神はこう言われる、見よ、わたしはこの民に、にがよもぎを食べさせ、毒の水を飲ませ、"},{"ref":"Jer.9.16","start":24009016,"end":24009016,"break":"none","ruby":[[0,1,"かれ"],[6,2,"せんぞ"],[11,1,"し"],[17,1,"くに"],[24,1,"かれ"],[27,1,"ち"],[33,1,"かれ"],[36,1,"ほろ"],[39,1,"つく"]],"text":"彼らも、その先祖たちも知らなかった国びとのうちに彼らを散らし、また彼らを滅ぼし尽すまで、そのうしろに、つるぎをつかわす」。"},{"ref":"Jer.9.17","start":24009017,"end":24009017,"break":"paragraph","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"い"],[15,1,"かんが"],[19,1,"な"],[21,1,"おんな"],[23,1,"よ"],[28,1,"ひと"],[35,1,"たく"],[38,1,"おんな"],[40,1,"まね"]],"text":"万軍の主はこう言われる、「よく考えて、泣き女を呼べ。また人をつかわして巧みな女を招け。"},{"ref":"Jer.9.18","start":24009018,"end":24009018,"break":"line","breaks":[[10,"line"],[26,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[3,1,"いそ"],[18,1,"な"],[20,1,"かな"],[31,1,"め"],[33,1,"なみだ"],[45,1,"みず"]],"text":"彼らに急いでこさせ、われわれのために泣き悲しませて、われわれの目に涙をこぼさせ、まぶたから水をあふれさせよ。"},{"ref":"Jer.9.19","start":24009019,"end":24009019,"break":"line","breaks":[[15,"line"],[35,"line"],[50,"line"],[62,"line"]],"ruby":[[5,1,"かな"],[9,1,"こえ"],[11,1,"きこ"],[18,1,"い"],[30,1,"ほろ"],[57,1,"ち"],[59,1,"さ"],[62,1,"かれ"]],"text":"シオンから悲しみの声が聞える。それは言う、『ああ、われわれは滅ぼされ、いたく、はずかしめられている。われわれはその地を去り、彼らがわれわれのすみかをこわしたからだ』」。"},{"ref":"Jer.9.20","start":24009020,"end":24009020,"break":"stanza","breaks":[[13,"line"],[33,"line"],[50,"line"]],"ruby":[[0,1,"おんな"],[5,1,"しゅ"],[7,2,"ことば"],[10,1,"き"],[19,1,"みみ"],[24,1,"くち"],[26,2,"ことば"],[39,1,"むすめ"],[41,1,"かな"],[45,1,"うた"],[47,1,"おし"],[56,1,"とな"],[58,1,"びと"],[60,2,"あいとう"],[63,1,"うた"],[65,1,"おし"]],"text":"女たちよ、主の言葉を聞け。あなたがたの耳に、その口の言葉をいれよ。あなたがたの娘に悲しみの歌を教え、おのおのその隣り人に哀悼の歌を教えよ。"},{"ref":"Jer.9.21","start":24009021,"end":24009021,"break":"line","breaks":[[14,"line"],[28,"line"],[43,"line"]],"ruby":[[0,1,"し"],[7,1,"まど"],[9,1,"のぼ"],[12,1,"き"],[19,2,"ていたく"],[22,1,"なか"],[34,1,"こ"],[39,1,"た"],[43,2,"ひろば"],[48,1,"わか"],[50,1,"ひと"],[54,1,"ころ"]],"text":"死がわれわれの窓に上って来、われわれの邸宅の中にはいり、ちまたにいる子どもらを絶やし、広場にいる若い人たちを殺そうとしているからだ。"},{"ref":"Jer.9.22","start":24009022,"end":24009022,"break":"line","breaks":[[12,"line"],[33,"line"],[46,"line"],[63,"line"]],"ruby":[[6,1,"い"],[13,1,"しゅ"],[15,1,"い"],[21,1,"ひと"],[23,2,"したい"],[26,2,"ふんど"],[33,1,"の"],[35,1,"たお"],[48,2,"かりい"],[53,1,"ひと"],[59,1,"のこ"],[66,1,"あつ"],[75,1,"たば"]],"text":"あなたはこう言いなさい、「主は言われる、『人の死体が糞土のように、野に倒れているようになり、また刈入れする人のうしろに残って、だれも集めることをしない束のようになる』」。"},{"ref":"Jer.9.23","start":24009023,"end":24009023,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"い"],[10,2,"ちえ"],[14,1,"ひと"],[18,2,"ちえ"],[21,1,"ほこ"],[30,1,"ちから"],[33,1,"ひと"],[37,1,"ちから"],[39,1,"ほこ"],[48,1,"と"],[51,1,"もの"],[55,1,"とみ"],[57,1,"ほこ"]],"text":"主はこう言われる、「知恵ある人はその知恵を誇ってはならない。力ある人はその力を誇ってはならない。富める者はその富を誇ってはならない。"},{"ref":"Jer.9.24","start":24009024,"end":24009024,"break":"none","ruby":[[0,1,"ほこ"],[2,1,"もの"],[7,1,"ほこり"],[28,1,"し"],[40,1,"しゅ"],[46,1,"ち"],[55,2,"こうへい"],[58,2,"せいぎ"],[61,1,"い"],[66,1,"もの"],[73,1,"し"],[92,1,"こと"],[94,1,"よろこ"],[98,1,"しゅ"],[100,1,"い"]],"text":"誇る者はこれを誇とせよ。すなわち、さとくあって、わたしを知っていること、わたしが主であって、地に、いつくしみと公平と正義を行っている者であることを知ることがそれである。わたしはこれらの事を喜ぶと、主は言われる」。"},{"ref":"Jer.9.25","start":24009025,"end":24009025,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"み"],[16,1,"ひ"],[18,1,"く"],[23,1,"ひ"],[27,2,"かつれい"],[35,1,"こころ"],[37,2,"かつれい"],[50,1,"ひと"],[56,1,"ばっ"]],"text":"主は言われる、「見よ、このような日が来る。その日には、割礼をうけても、心に割礼をうけていないすべての人をわたしは罰する。"},{"ref":"Jer.9.26","start":24009026,"end":24009026,"break":"none","ruby":[[17,2,"ひとびと"],[27,1,"の"],[32,1,"かみ"],[34,1,"け"],[43,2,"ひとびと"],[56,1,"くに"],[62,2,"かつれい"],[71,1,"もの"],[82,2,"ぜんか"],[87,1,"こころ"],[89,2,"かつれい"],[98,1,"もの"]],"text":"エジプト、ユダ、エドム、アンモンの人々、モアブ、および野にいて、髪の毛のすみずみをそる人々はそれである。これらの国びとはみな割礼をうけていない者であり、イスラエルの全家もみな心に割礼をうけていない者である」。"}]