[{"ref":"Ps.11.1","start":19011001,"end":19011001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[11,"line"],[35,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"よ"],[8,1,"たの"],[30,1,"い"],[36,1,"とり"],[41,1,"やま"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"わたしは主に寄り頼む。なにゆえ、あなたがたはわたしにむかって言うのか、「鳥のように山にのがれよ。"},{"ref":"Ps.11.2","start":19011002,"end":19011002,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[0,1,"み"],[3,1,"あ"],[6,1,"もの"],[9,1,"くら"],[14,1,"こころ"],[16,1,"なお"],[18,1,"もの"],[20,1,"い"],[24,1,"ゆみ"],[26,1,"は"],[29,1,"げん"],[31,1,"や"]],"text":"見よ、悪しき者は、暗やみで、心の直き者を射ようと弓を張り、弦に矢をつがえている。"},{"ref":"Ps.11.3","start":19011003,"end":19011003,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"もとい"],[2,1,"と"],[13,1,"ただ"],[16,1,"もの"],[18,1,"なに"],[22,1,"え"]],"text":"基が取りこわされるならば、正しい者は何をなし得ようか」と。"},{"ref":"Ps.11.4","start":19011004,"end":19011004,"break":"line","breaks":[[24,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"せい"],[7,1,"みや"],[13,1,"しゅ"],[19,1,"てん"],[26,1,"め"],[28,1,"ひと"],[30,1,"こ"],[45,1,"ひと"],[47,1,"こ"],[50,1,"しら"]],"text":"主はその聖なる宮にいまし、主のみくらは天にあり、その目は人の子らをみそなわし、そのまぶたは人の子らを調べられる。"},{"ref":"Ps.11.5","start":19011005,"end":19011005,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ただ"],[5,1,"もの"],[9,1,"あ"],[12,1,"もの"],[15,1,"しら"],[21,1,"こころ"],[23,2,"らんぼう"],[26,1,"この"],[28,1,"もの"],[30,1,"にく"]],"text":"主は正しき者をも、悪しき者をも調べ、そのみ心は乱暴を好む者を憎まれる。"},{"ref":"Ps.11.6","start":19011006,"end":19011006,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"あ"],[5,1,"もの"],[7,1,"うえ"],[9,2,"すみび"],[12,2,"いおう"],[16,1,"ふ"],[23,1,"も"],[26,1,"かぜ"],[28,1,"かれ"],[33,1,"さかずき"]],"text":"主は悪しき者の上に炭火と硫黄とを降らせられる。燃える風は彼らがその杯にうくべきものである。"},{"ref":"Ps.11.7","start":19011007,"end":19011007,"break":"line","breaks":[[10,"line"],[25,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ただ"],[10,1,"ただ"],[13,1,"こと"],[15,1,"あい"],[25,1,"なお"],[27,1,"もの"],[29,1,"しゅ"],[32,1,"かお"],[34,1,"あお"],[36,1,"み"]],"text":"主は正しくいまして、正しい事を愛されるからである。直き者は主のみ顔を仰ぎ見るであろう。"}]