[{"ref":"Lev.23.1","start":3023001,"end":3023001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.23.2","start":3023002,"end":3023002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[26,1,"しめ"],[29,1,"せい"],[30,1,"かい"],[35,1,"しゅ"],[37,1,"さだ"],[40,1,"まつり"],[42,1,"つぎ"],[59,1,"さだ"],[62,1,"まつり"]],"text":"「イスラエルの人々に言いなさい、『あなたがたが、ふれ示して聖会とすべき主の定めの祭は次のとおりである。これらはわたしの定めの祭である。"},{"ref":"Lev.23.3","start":3023003,"end":3023003,"break":"none","ruby":[[1,1,"か"],[3,1,"あいだ"],[5,2,"しごと"],[18,1,"だい"],[20,1,"にち"],[22,1,"まった"],[24,1,"やす"],[27,3,"あんそくにち"],[34,1,"せい"],[35,1,"かい"],[45,2,"しごと"],[76,1,"まも"],[80,1,"しゅ"],[82,3,"あんそくにち"]],"text":"六日の間は仕事をしなければならない。第七日は全き休みの安息日であり、聖会である。どのような仕事もしてはならない。これはあなたがたのすべてのすまいにおいて守るべき主の安息日である。"},{"ref":"Lev.23.4","start":3023004,"end":3023004,"break":"paragraph","ruby":[[2,2,"ときどき"],[15,1,"しめ"],[19,1,"しゅ"],[21,1,"さだ"],[24,1,"まつり"],[27,1,"せい"],[28,1,"かい"],[30,1,"つぎ"]],"text":"その時々に、あなたがたが、ふれ示すべき主の定めの祭なる聖会は次のとおりである。"},{"ref":"Lev.23.5","start":3023005,"end":3023005,"break":"none","ruby":[[0,2,"しょうがつ"],[5,1,"か"],[7,1,"ゆう"],[9,1,"しゅ"],[11,2,"すぎこし"],[14,1,"まつり"]],"text":"正月の十四日の夕は主の過越の祭である。"},{"ref":"Lev.23.6","start":3023006,"end":3023006,"break":"none","ruby":[[4,1,"つき"],[8,1,"にち"],[10,1,"しゅ"],[12,1,"たね"],[13,1,"い"],[19,1,"まつり"],[30,2,"なぬか"],[33,1,"あいだ"],[35,1,"たね"],[36,1,"い"],[42,1,"た"]],"text":"またその月の十五日は主の種入れぬパンの祭である。あなたがたは七日の間は種入れぬパンを食べなければならない。"},{"ref":"Lev.23.7","start":3023007,"end":3023007,"break":"none","ruby":[[2,1,"はじ"],[5,1,"ひ"],[7,1,"せい"],[8,1,"かい"],[10,1,"ひら"],[24,2,"ろうどう"]],"text":"その初めの日に聖会を開かなければならない。どんな労働もしてはならない。"},{"ref":"Lev.23.8","start":3023008,"end":3023008,"break":"none","ruby":[[6,2,"なぬか"],[9,1,"あいだ"],[11,1,"しゅ"],[13,2,"かさい"],[28,1,"だい"],[30,1,"にち"],[36,1,"せい"],[37,1,"かい"],[39,1,"ひら"],[47,2,"ろうどう"]],"text":"あなたがたは七日の間、主に火祭をささげなければならない。第七日には、また聖会を開き、どのような労働もしてはならない』」。"},{"ref":"Lev.23.9","start":3023009,"end":3023009,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.23.10","start":3023010,"end":3023010,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[21,1,"あた"],[24,1,"ち"],[30,2,"こくもつ"],[33,1,"か"],[35,1,"い"],[47,2,"こくもつ"],[50,2,"はつほ"],[53,1,"たば"],[56,2,"さいし"],[63,1,"たずさ"]],"text":"「イスラエルの人々に言いなさい、『わたしが与える地にはいって穀物を刈り入れるとき、あなたがたは穀物の初穂の束を、祭司のところへ携えてこなければならない。"},{"ref":"Lev.23.11","start":3023011,"end":3023011,"break":"none","ruby":[[0,1,"かれ"],[8,1,"う"],[10,1,"い"],[21,1,"たば"],[23,1,"しゅ"],[25,1,"まえ"],[27,1,"ゆ"],[29,1,"うご"],[42,2,"さいし"],[45,3,"あんそくにち"],[49,2,"よくじつ"],[56,1,"ゆ"],[58,1,"うご"]],"text":"彼はあなたがたの受け入れられるように、その束を主の前に揺り動かすであろう。すなわち、祭司は安息日の翌日に、これを揺り動かすであろう。"},{"ref":"Lev.23.12","start":3023012,"end":3023012,"break":"none","ruby":[[4,1,"たば"],[6,1,"ゆ"],[8,1,"うご"],[11,1,"ひ"],[15,1,"さい"],[17,1,"おす"],[19,2,"こひつじ"],[22,1,"まった"],[27,2,"はんさい"],[32,1,"しゅ"]],"text":"またその束を揺り動かす日に、一歳の雄の小羊の全きものを燔祭として主にささげなければならない。"},{"ref":"Lev.23.13","start":3023013,"end":3023013,"break":"none","ruby":[[2,2,"そさい"],[6,1,"あぶら"],[8,1,"ま"],[11,2,"むぎこ"],[14,1,"ぶん"],[20,1,"もち"],[26,1,"しゅ"],[32,2,"かさい"],[37,1,"こう"],[59,2,"かんさい"],[67,1,"しゅ"],[73,1,"ぶん"],[77,1,"もち"]],"text":"その素祭には油を混ぜた麦粉十分の二エパを用い、これを主にささげて火祭とし、香ばしいかおりとしなければならない。またその灌祭には、ぶどう酒一ヒンの四分の一を用いなければならない。"},{"ref":"Lev.23.14","start":3023014,"end":3023014,"break":"none","ruby":[[6,1,"かみ"],[10,1,"そな"],[12,1,"もの"],[20,1,"ひ"],[34,2,"やきむぎ"],[38,2,"しんこく"],[41,1,"た"],[71,2,"よよ"],[76,1,"まも"],[80,1,"さだ"]],"text":"あなたがたの神にこの供え物をささげるその日まで、あなたがたはパンも、焼麦も、新穀も食べてはならない。これはあなたがたのすべてのすまいにおいて、代々ながく守るべき定めである。"},{"ref":"Lev.23.15","start":3023015,"end":3023015,"break":"paragraph","ruby":[[2,3,"あんそくにち"],[6,2,"よくじつ"],[14,2,"ようさい"],[17,1,"たば"],[23,1,"ひ"],[26,1,"まん"],[28,1,"しゅう"],[30,1,"かぞ"]],"text":"また安息日の翌日、すなわち、揺祭の束をささげた日から満七週を数えなければならない。"},{"ref":"Lev.23.16","start":3023016,"end":3023016,"break":"none","ruby":[[5,1,"だい"],[8,3,"あんそくにち"],[12,2,"よくじつ"],[20,1,"にち"],[22,1,"かぞ"],[26,2,"しんこく"],[29,2,"そさい"],[32,1,"しゅ"]],"text":"すなわち、第七の安息日の翌日までに、五十日を数えて、新穀の素祭を主にささげなければならない。"},{"ref":"Lev.23.17","start":3023017,"end":3023017,"break":"none","ruby":[[15,1,"ぶん"],[21,2,"むぎこ"],[24,1,"たね"],[26,1,"い"],[29,1,"や"],[35,1,"こ"],[37,1,"たずさ"],[42,2,"ようさい"],[58,2,"はつほ"],[63,1,"しゅ"]],"text":"またあなたがたのすまいから、十分の二エパの麦粉に種を入れて焼いたパン二個を携えてきて揺祭としなければならない。これは初穂として主にささげるものである。"},{"ref":"Lev.23.18","start":3023018,"end":3023018,"break":"none","ruby":[[16,1,"さい"],[18,1,"まった"],[20,2,"こひつじ"],[23,1,"とう"],[26,1,"わか"],[28,2,"おうし"],[31,1,"とう"],[34,2,"おひつじ"],[37,1,"とう"],[62,2,"そさい"],[67,2,"かんさい"],[73,1,"しゅ"],[79,2,"はんさい"],[95,2,"かさい"],[102,1,"しゅ"],[104,1,"こう"]],"text":"あなたがたはまたパンのほかに、一歳の全き小羊七頭と、若き雄牛一頭と、雄羊二頭をささげなければならない。すなわち、これらをその素祭および灌祭とともに主にささげて燔祭としなければならない。これは火祭であって、主に香ばしいかおりとなるであろう。"},{"ref":"Lev.23.19","start":3023019,"end":3023019,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[18,1,"さい"],[20,2,"こひつじ"],[23,1,"とう"],[25,3,"しゅうおんさい"],[29,2,"ぎせい"]],"text":"また雄やぎ一頭を罪祭としてささげ、一歳の小羊二頭を酬恩祭の犠牲としてささげなければならない。"},{"ref":"Lev.23.20","start":3023020,"end":3023020,"break":"none","ruby":[[3,2,"さいし"],[8,2,"はつほ"],[14,1,"とも"],[20,1,"とう"],[22,2,"こひつじ"],[25,1,"しゅ"],[27,1,"まえ"],[29,2,"ようさい"],[34,1,"ゆ"],[36,1,"うご"],[52,1,"しゅ"],[58,1,"せい"],[61,1,"もの"],[67,2,"さいし"],[70,1,"き"]],"text":"そして祭司はその初穂のパンと共に、この二頭の小羊を主の前に揺祭として揺り動かさなければならない。これらは主にささげる聖なる物であって、祭司に帰するであろう。"},{"ref":"Lev.23.21","start":3023021,"end":3023021,"break":"none","ruby":[[9,1,"ひ"],[13,1,"しめ"],[17,1,"せい"],[18,1,"かい"],[20,1,"ひら"],[36,2,"ろうどう"],[68,2,"よよ"],[73,1,"まも"],[77,1,"さだ"]],"text":"あなたがたは、その日にふれ示して、聖会を開かなければならない。どのような労働もしてはならない。これはあなたがたのすべてのすまいにおいて、代々ながく守るべき定めである。"},{"ref":"Lev.23.22","start":3023022,"end":3023022,"break":"paragraph","ruby":[[6,1,"ち"],[8,2,"こくもつ"],[11,1,"か"],[13,1,"い"],[22,2,"かりい"],[31,1,"はたけ"],[39,1,"か"],[57,2,"こくもつ"],[60,1,"お"],[62,1,"ぼ"],[64,1,"ひろ"],[73,1,"まず"],[76,1,"もの"],[78,3,"きりゅうしゃ"],[89,1,"のこ"],[113,1,"かみ"],[115,1,"しゅ"]],"text":"あなたがたの地の穀物を刈り入れるときは、その刈入れにあたって、畑のすみずみまで刈りつくしてはならない。またあなたの穀物の落ち穂を拾ってはならない。貧しい者と寄留者のために、それを残しておかなければならない。わたしはあなたがたの神、主である』」。"},{"ref":"Lev.23.23","start":3023023,"end":3023023,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.23.24","start":3023024,"end":3023024,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[18,1,"がつ"],[20,1,"にち"],[28,2,"あんそく"],[31,1,"ひ"],[39,1,"ふ"],[41,1,"な"],[45,2,"きねん"],[49,1,"せい"],[50,1,"かい"]],"text":"「イスラエルの人々に言いなさい、『七月一日をあなたがたの安息の日とし、ラッパを吹き鳴らして記念する聖会としなければならない。"},{"ref":"Lev.23.25","start":3023025,"end":3023025,"break":"none","ruby":[[5,2,"ろうどう"],[20,1,"しゅ"],[22,2,"かさい"]],"text":"どのような労働もしてはならない。しかし、主に火祭をささげなければならない』」。"},{"ref":"Lev.23.26","start":3023026,"end":3023026,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.23.27","start":3023027,"end":3023027,"break":"none","ruby":[[1,1,"とく"],[6,1,"がつ"],[9,1,"か"],[11,2,"しょくざい"],[14,1,"ひ"],[25,1,"せい"],[26,1,"かい"],[28,1,"ひら"],[31,1,"み"],[33,1,"なや"],[37,1,"しゅ"],[39,2,"かさい"]],"text":"「特にその七月の十日は贖罪の日である。あなたがたは聖会を開き、身を悩まし、主に火祭をささげなければならない。"},{"ref":"Lev.23.28","start":3023028,"end":3023028,"break":"none","ruby":[[2,1,"ひ"],[11,2,"しごと"],[41,1,"かみ"],[43,1,"しゅ"],[45,1,"まえ"],[56,2,"しょくざい"],[59,1,"ひ"]],"text":"その日には、どのような仕事もしてはならない。これはあなたがたのために、あなたがたの神、主の前にあがないをなすべき贖罪の日だからである。"},{"ref":"Lev.23.29","start":3023029,"end":3023029,"break":"none","ruby":[[5,1,"ひ"],[7,1,"み"],[9,1,"なや"],[14,1,"もの"],[17,1,"たみ"],[23,1,"た"]],"text":"すべてその日に身を悩まさない者は、民のうちから断たれるであろう。"},{"ref":"Lev.23.30","start":3023030,"end":3023030,"break":"none","ruby":[[7,1,"ひ"],[14,2,"しごと"],[23,1,"ひと"],[29,1,"たみ"],[35,1,"ほろ"],[38,1,"さ"]],"text":"またすべてその日にどのような仕事をしても、その人をわたしは民のうちから滅ぼし去るであろう。"},{"ref":"Lev.23.31","start":3023031,"end":3023031,"break":"none","ruby":[[11,2,"しごと"],[43,2,"よよ"],[48,1,"まも"],[52,1,"さだ"]],"text":"あなたがたはどのような仕事もしてはならない。これはあなたがたのすべてのすまいにおいて、代々ながく守るべき定めである。"},{"ref":"Lev.23.32","start":3023032,"end":3023032,"break":"none","ruby":[[9,1,"まった"],[11,1,"やす"],[14,3,"あんそくにち"],[27,1,"み"],[29,1,"なや"],[45,1,"つき"],[48,1,"か"],[50,1,"ゆう"],[56,1,"ゆう"],[59,1,"つぎ"],[61,1,"ゆう"],[64,2,"あんそく"],[67,1,"まも"]],"text":"これはあなたがたの全き休みの安息日である。あなたがたは身を悩まさなければならない。またその月の九日の夕には、その夕から次の夕まで安息を守らなければならない」。"},{"ref":"Lev.23.33","start":3023033,"end":3023033,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.23.34","start":3023034,"end":3023034,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[20,1,"がつ"],[24,1,"にち"],[26,2,"かりいお"],[29,1,"まつり"],[34,2,"なぬか"],[37,1,"あいだ"],[39,1,"しゅ"],[41,1,"まえ"],[46,1,"まも"]],"text":"「イスラエルの人々に言いなさい、『その七月の十五日は仮庵の祭である。七日の間、主の前にそれを守らなければならない。"},{"ref":"Lev.23.35","start":3023035,"end":3023035,"break":"none","ruby":[[0,1,"はじ"],[3,1,"ひ"],[5,1,"せい"],[6,1,"かい"],[8,1,"ひら"],[24,2,"ろうどう"]],"text":"初めの日に聖会を開かなければならない。どのような労働もしてはならない。"},{"ref":"Lev.23.36","start":3023036,"end":3023036,"break":"none","ruby":[[2,2,"なぬか"],[5,1,"あいだ"],[7,1,"しゅ"],[9,2,"かさい"],[25,1,"か"],[26,1,"め"],[29,1,"せい"],[30,1,"かい"],[32,1,"ひら"],[35,1,"しゅ"],[37,2,"かさい"],[55,1,"せい"],[56,1,"かい"],[58,1,"ひ"],[70,2,"ろうどう"]],"text":"また七日の間、主に火祭をささげなければならない。八日目には聖会を開き、主に火祭をささげなければならない。これは聖会の日であるから、どのような労働もしてはならない。"},{"ref":"Lev.23.37","start":3023037,"end":3023037,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"さだ"],[9,1,"まつり"],[23,1,"しめ"],[26,1,"せい"],[27,1,"かい"],[31,1,"しゅ"],[33,2,"かさい"],[40,2,"はんさい"],[43,2,"そさい"],[46,2,"ぎせい"],[51,2,"かんさい"],[62,1,"ひ"]],"text":"これらは主の定めの祭であって、あなたがたがふれ示して聖会とし、主に火祭すなわち、燔祭、素祭、犠牲および灌祭を、そのささぐべき日にささげなければならない。"},{"ref":"Lev.23.38","start":3023038,"end":3023038,"break":"none","ruby":[[5,1,"しゅ"],[7,3,"あんそくにち"],[29,1,"もの"],[51,2,"せいがん"],[54,1,"そな"],[56,1,"もの"],[80,2,"じはつ"],[83,1,"そな"],[85,1,"もの"],[94,1,"みな"],[101,1,"しゅ"]],"text":"このほかに主の安息日があり、またほかに、あなたがたのささげ物があり、またほかに、あなたがたのもろもろの誓願の供え物があり、またそのほかに、あなたがたのもろもろの自発の供え物がある。これらは皆あなたがたが主にささげるものである。"},{"ref":"Lev.23.39","start":3023039,"end":3023039,"break":"paragraph","ruby":[[7,1,"ち"],[9,2,"さんぶつ"],[12,1,"あつ"],[14,1,"おわ"],[22,1,"がつ"],[26,1,"にち"],[29,2,"なぬか"],[36,1,"しゅ"],[38,1,"まつり"],[40,1,"まも"],[56,1,"はじ"],[59,1,"ひ"],[62,2,"あんそく"],[68,1,"か"],[69,1,"め"],[72,2,"あんそく"]],"text":"あなたがたが、地の産物を集め終ったときは、七月の十五日から七日のあいだ、主の祭を守らなければならない。すなわち、初めの日にも安息をし、八日目にも安息をしなければならない。"},{"ref":"Lev.23.40","start":3023040,"end":3023040,"break":"none","ruby":[[0,1,"はじ"],[3,1,"ひ"],[6,1,"うつく"],[9,1,"き"],[11,1,"み"],[20,1,"えだ"],[23,1,"しげ"],[26,1,"き"],[28,1,"えだ"],[31,1,"たに"],[39,1,"えだ"],[41,1,"と"],[45,2,"なぬか"],[48,1,"あいだ"],[55,1,"かみ"],[57,1,"しゅ"],[59,1,"まえ"],[61,1,"たの"]],"text":"初めの日に、美しい木の実と、なつめやしの枝と、茂った木の枝と、谷のはこやなぎの枝を取って、七日の間あなたがたの神、主の前に楽しまなければならない。"},{"ref":"Lev.23.41","start":3023041,"end":3023041,"break":"none","ruby":[[6,1,"ねん"],[8,2,"なぬか"],[11,1,"あいだ"],[13,1,"しゅ"],[17,1,"まつり"],[19,1,"まも"],[39,2,"よよ"],[44,1,"まも"],[48,1,"さだ"],[56,1,"がつ"],[61,1,"まも"]],"text":"あなたがたは年に七日の間、主にこの祭を守らなければならない。これはあなたがたの代々ながく守るべき定めであって、七月にこれを守らなければならない。"},{"ref":"Lev.23.42","start":3023042,"end":3023042,"break":"none","ruby":[[6,2,"なぬか"],[9,1,"あいだ"],[11,2,"かりいお"],[14,1,"す"],[23,1,"うま"],[26,1,"もの"],[30,2,"かりいお"],[33,1,"す"]],"text":"あなたがたは七日の間、仮庵に住み、イスラエルで生れた者はみな仮庵に住まなければならない。"},{"ref":"Lev.23.43","start":3023043,"end":3023043,"break":"none","ruby":[[13,2,"ひとびと"],[21,1,"くに"],[24,1,"みちび"],[26,1,"だ"],[32,1,"かれ"],[35,2,"かりいお"],[38,1,"す"],[43,1,"こと"],[52,2,"よよ"],[55,2,"しそん"],[58,1,"し"],[78,1,"かみ"],[80,1,"しゅ"]],"text":"これはわたしがイスラエルの人々をエジプトの国から導き出したとき、彼らを仮庵に住まわせた事を、あなたがたの代々の子孫に知らせるためである。わたしはあなたがたの神、主である』」。"},{"ref":"Lev.23.44","start":3023044,"end":3023044,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"さだ"],[9,1,"まつり"],[17,2,"ひとびと"],[20,1,"つ"]],"text":"モーセは主の定めの祭をイスラエルの人々に告げた。"}]