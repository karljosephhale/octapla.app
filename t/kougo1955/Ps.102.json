[{"ref":"Ps.102.1","start":19102001,"end":19102001,"break":"paragraph","title":"苦しむ者が思いくずおれてその嘆きを主のみ前に注ぎ出すときの祈","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"いのり"],[10,1,"き"],[21,1,"さけ"],[25,1,"まえ"],[27,1,"いた"]],"titleRuby":[[0,1,"くる"],[3,1,"もの"],[5,1,"おも"],[14,1,"なげ"],[17,1,"しゅ"],[20,1,"まえ"],[22,1,"そそ"],[24,1,"だ"],[29,1,"いのり"]],"text":"主よ、わたしの祈をお聞きください。わたしの叫びをみ前に至らせてください。"},{"ref":"Ps.102.2","start":19102002,"end":19102002,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[4,1,"なや"],[7,1,"ひ"],[10,1,"かお"],[12,1,"かく"],[23,1,"みみ"],[29,1,"かたむ"],[34,1,"よ"],[38,1,"ひ"],[47,1,"こた"]],"text":"わたしの悩みの日にみ顔を隠すことなく、あなたの耳をわたしに傾け、わが呼ばわる日に、すみやかにお答えください。"},{"ref":"Ps.102.3","start":19102003,"end":19102003,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"ひ"],[6,1,"けむり"],[11,1,"き"],[18,1,"ほね"],[20,1,"ろ"],[25,1,"も"]],"text":"わたしの日は煙のように消え、わたしの骨は炉のように燃えるからです。"},{"ref":"Ps.102.4","start":19102004,"end":19102004,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"こころ"],[6,1,"くさ"],[11,1,"う"],[30,1,"た"],[36,1,"わす"]],"text":"わたしの心は草のように撃たれて、しおれました。わたしはパンを食べることを忘れました。"},{"ref":"Ps.102.5","start":19102005,"end":19102005,"break":"line","breaks":[[10,"line"]],"ruby":[[2,1,"なげ"],[5,1,"こえ"],[14,1,"ほね"],[20,1,"にく"],[22,1,"つ"]],"text":"わが嘆きの声によってわたしの骨はわたしの肉に着きます。"},{"ref":"Ps.102.6","start":19102006,"end":19102006,"break":"line","breaks":[[16,"line"]],"ruby":[[4,2,"あらの"],[16,1,"あ"],[19,1,"あと"]],"text":"わたしは荒野のはげたかのごとく、荒れた跡のふくろうのようです。"},{"ref":"Ps.102.7","start":19102007,"end":19102007,"break":"line","breaks":[[8,"line"]],"ruby":[[4,1,"ねむ"],[8,2,"やね"]],"text":"わたしは眠らずに屋根にひとりいるすずめのようです。"},{"ref":"Ps.102.8","start":19102008,"end":19102008,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"てき"],[27,1,"もの"],[31,1,"な"]],"text":"わたしの敵はひねもす、わたしをそしり、わたしをあざける者はわが名によってのろいます。"},{"ref":"Ps.102.9","start":19102009,"end":19102009,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"はい"],[12,1,"た"],[19,1,"の"],[21,1,"もの"],[23,1,"なみだ"],[25,1,"まじ"]],"text":"わたしは灰をパンのように食べ、わたしの飲み物に涙を交えました。"},{"ref":"Ps.102.10","start":19102010,"end":19102010,"break":"line","breaks":[[18,"line"]],"ruby":[[7,1,"いきどお"],[10,1,"いか"],[30,1,"な"]],"text":"これはあなたの憤りと怒りのゆえです。あなたはわたしをもたげて投げすてられました。"},{"ref":"Ps.102.11","start":19102011,"end":19102011,"break":"line","breaks":[[19,"line"]],"ruby":[[8,2,"ゆうぐれ"],[11,1,"ひ"],[12,1,"かげ"],[23,1,"くさ"]],"text":"わたしのよわいは夕暮の日影のようです。わたしは草のようにしおれました。"},{"ref":"Ps.102.12","start":19102012,"end":19102012,"break":"line","breaks":[[22,"line"]],"ruby":[[3,1,"しゅ"],[19,1,"ざ"],[25,1,"な"],[30,1,"よ"],[32,1,"およ"]],"text":"しかし主よ、あなたはとこしえにみくらに座し、そのみ名はよろず代に及びます。"},{"ref":"Ps.102.13","start":19102013,"end":19102013,"break":"line","breaks":[[22,"line"],[38,"line"]],"ruby":[[4,1,"た"],[29,1,"めぐ"],[33,1,"とき"],[38,1,"さだ"],[42,1,"とき"],[44,1,"き"]],"text":"あなたは立ってシオンをあわれまれるでしょう。これはシオンを恵まれる時であり、定まった時が来たからです。"},{"ref":"Ps.102.14","start":19102014,"end":19102014,"break":"line","breaks":[[18,"line"]],"ruby":[[12,1,"いし"],[15,1,"よろこ"]],"text":"あなたのしもべはシオンの石をも喜び、そのちりをさえあわれむのです。"},{"ref":"Ps.102.15","start":19102015,"end":19102015,"break":"line","breaks":[[16,"line"]],"ruby":[[5,2,"くにたみ"],[8,1,"しゅ"],[11,1,"な"],[13,1,"おそ"],[16,1,"ち"],[23,1,"おう"],[29,2,"えいこう"],[32,1,"おそ"]],"text":"もろもろの国民は主のみ名を恐れ、地のもろもろの王はあなたの栄光を恐れるでしょう。"},{"ref":"Ps.102.16","start":19102016,"end":19102016,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"きず"],[11,2,"えいこう"],[17,1,"あらわ"]],"text":"主はシオンを築き、その栄光をもって現れ、"},{"ref":"Ps.102.17","start":19102017,"end":19102017,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"とぼ"],[3,1,"もの"],[5,1,"いのり"],[12,1,"かれ"],[15,1,"ねが"]],"text":"乏しい者の祈をかえりみ、彼らの願いをかろしめられないからです。"},{"ref":"Ps.102.18","start":19102018,"end":19102018,"break":"line","breaks":[[25,"line"],[40,"line"]],"ruby":[[5,1,"よ"],[13,1,"こと"],[15,1,"か"],[30,1,"あたら"],[33,1,"つく"],[37,1,"たみ"],[40,1,"しゅ"]],"text":"きたるべき代のために、この事を書きしるしましょう。そうすれば新しく造られる民は、主をほめたたえるでしょう。"},{"ref":"Ps.102.19","start":19102019,"end":19102019,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"せい"],[7,1,"たか"],[9,1,"ところ"],[12,1,"み"],[17,1,"てん"],[20,1,"ち"],[22,1,"み"]],"text":"主はその聖なる高き所から見おろし、天から地を見られた。"},{"ref":"Ps.102.20","start":19102020,"end":19102020,"break":"line","breaks":[[14,"line"]],"ruby":[[3,1,"とら"],[6,1,"びと"],[8,1,"なげ"],[11,1,"き"],[14,1,"し"],[16,1,"さだ"],[21,1,"もの"],[23,1,"と"],[25,1,"はな"]],"text":"これは捕われ人の嘆きを聞き、死に定められた者を解き放ち、"},{"ref":"Ps.102.21","start":19102021,"end":19102021,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ひとびと"],[7,1,"しゅ"],[10,1,"な"],[25,1,"ほまれ"]],"text":"人々がシオンで主のみ名をあらわし、エルサレムでその誉をあらわすためです。"},{"ref":"Ps.102.22","start":19102022,"end":19102022,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"とき"],[8,1,"たみ"],[15,1,"くに"],[20,1,"あつ"],[25,1,"しゅ"],[27,1,"つか"]],"text":"その時もろもろの民、もろもろの国はともに集まって、主に仕えるでしょう。"},{"ref":"Ps.102.23","start":19102023,"end":19102023,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ちから"],[8,2,"ちゅうと"],[23,1,"みじか"]],"text":"主はわたしの力を中途でくじき、わたしのよわいを短くされました。"},{"ref":"Ps.102.24","start":19102024,"end":19102024,"break":"line","breaks":[[16,"line"],[31,"line"],[47,"line"]],"ruby":[[4,1,"い"],[13,1,"かみ"],[28,1,"なか"],[35,1,"と"],[37,1,"さ"],[58,1,"よ"],[60,1,"およ"]],"text":"わたしは言いました、「わが神よ、どうか、わたしのよわいの半ばでわたしを取り去らないでください。あなたのよわいはよろず代に及びます」と。"},{"ref":"Ps.102.25","start":19102025,"end":19102025,"break":"line","breaks":[[21,"line"]],"ruby":[[9,1,"ち"],[11,1,"もとい"],[21,1,"てん"],[30,1,"て"]],"text":"あなたはいにしえ、地の基をすえられました。天もまたあなたのみ手のわざです。"},{"ref":"Ps.102.26","start":19102026,"end":19102026,"break":"line","breaks":[[12,"line"],[27,"line"],[46,"line"],[67,"line"]],"ruby":[[4,1,"ほろ"],[19,1,"なが"],[33,1,"ころも"],[38,1,"ふる"],[54,2,"うわぎ"],[60,1,"か"],[71,1,"す"],[73,1,"さ"]],"text":"これらは滅びるでしょう。しかしあなたは長らえられます。これらはみな衣のように古びるでしょう。あなたがこれらを上着のように替えられると、これらは過ぎ去ります。"},{"ref":"Ps.102.27","start":19102027,"end":19102027,"break":"line","breaks":[[14,"line"]],"ruby":[[7,1,"かわ"],[22,1,"おわ"]],"text":"しかしあなたは変ることなく、あなたのよわいは終ることがありません。"},{"ref":"Ps.102.28","start":19102028,"end":19102028,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"こ"],[11,1,"やす"],[15,1,"す"],[20,2,"しそん"],[27,1,"まえ"],[29,1,"かた"],[31,1,"た"]],"text":"あなたのしもべの子らは安らかに住み、その子孫はあなたの前に堅く立てられるでしょう。"}]