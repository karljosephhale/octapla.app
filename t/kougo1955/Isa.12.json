[{"ref":"Isa.12.1","start":23012001,"end":23012001,"break":"paragraph","breaks":[[10,"stanza"],[28,"line"],[50,"line"]],"ruby":[[2,1,"ひ"],[7,1,"い"],[11,1,"しゅ"],[22,2,"かんしゃ"],[44,1,"いか"],[52,1,"いか"],[63,1,"なぐさ"]],"text":"その日あなたは言う、「主よ、わたしはあなたに感謝します。あなたは、さきにわたしにむかって怒られたが、その怒りはやんで、わたしを慰められたからです。"},{"ref":"Isa.12.2","start":23012002,"end":23012002,"break":"line","breaks":[[12,"line"],[29,"line"],[45,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[7,1,"すくい"],[16,2,"しんらい"],[20,1,"おそ"],[29,1,"しゅ"],[32,1,"かみ"],[36,1,"ちから"],[40,1,"うた"],[47,1,"すくい"]],"text":"見よ、神はわが救である。わたしは信頼して恐れることはない。主なる神はわが力、わが歌であり、わが救となられたからである」。"},{"ref":"Isa.12.3","start":23012003,"end":23012003,"break":"paragraph","ruby":[[6,1,"よろこ"],[13,1,"すくい"],[15,2,"いど"],[19,1,"みず"]],"text":"あなたがたは喜びをもって、救の井戸から水をくむ。"},{"ref":"Isa.12.4","start":23012004,"end":23012004,"break":"none","breaks":[[13,"stanza"],[21,"line"],[29,"line"],[49,"line"]],"ruby":[[2,1,"ひ"],[10,1,"い"],[14,1,"しゅ"],[16,2,"かんしゃ"],[24,1,"な"],[26,1,"よ"],[40,1,"たみ"],[42,1,"なか"],[52,1,"な"],[62,1,"かた"]],"text":"その日、あなたがたは言う、「主に感謝せよ。そのみ名を呼べ。そのみわざをもろもろの民の中につたえよ。そのみ名のあがむべきことを語りつげよ。"},{"ref":"Isa.12.5","start":23012005,"end":23012005,"break":"line","breaks":[[8,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"しゅ"],[23,1,"と"],[34,1,"ぜん"],[35,1,"ち"],[37,1,"の"],[39,1,"つた"]],"text":"主をほめうたえ。主はそのみわざを、みごとになし遂げられたから。これを全地に宣べ伝えよ。"},{"ref":"Isa.12.6","start":23012006,"end":23012006,"break":"line","breaks":[[21,"line"],[39,"line"]],"ruby":[[4,1,"す"],[6,1,"もの"],[9,1,"こえ"],[15,1,"よろこ"],[27,2,"せいじゃ"],[39,1,"おお"],[43,1,"もの"]],"text":"シオンに住む者よ、声をあげて、喜びうたえ。イスラエルの聖者はあなたがたのうちで大いなる者だから」。"}]