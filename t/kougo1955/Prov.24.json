[{"ref":"Prov.24.1","start":20024001,"end":20024001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[0,1,"あく"],[2,1,"おこな"],[4,1,"ひと"],[19,1,"かれ"],[22,1,"とも"],[29,1,"ねが"]],"text":"悪を行う人をうらやんではならない、また彼らと共におることを願ってはならない。"},{"ref":"Prov.24.2","start":20024002,"end":20024002,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[5,1,"こころ"],[7,2,"ごうだつ"],[10,1,"はか"],[20,1,"ひと"],[29,1,"かた"]],"text":"彼らはその心に強奪を計り、そのくちびるに人をそこなうことを語るからである。"},{"ref":"Prov.24.3","start":20024003,"end":20024003,"break":"line","ruby":[[0,1,"いえ"],[2,2,"ちえ"],[8,1,"た"],[13,1,"さと"],[19,1,"かた"]],"text":"家は知恵によって建てられ、悟りによって堅くせられ、"},{"ref":"Prov.24.4","start":20024004,"end":20024004,"break":"line","breaks":[[20,"line"]],"ruby":[[6,2,"ちしき"],[17,1,"たっと"],[20,1,"うるわ"],[23,1,"たから"],[25,1,"み"]],"text":"また、へやは知識によってさまざまの尊く、麗しい宝で満たされる。"},{"ref":"Prov.24.5","start":20024005,"end":20024005,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[6,1,"つよ"],[8,1,"ひと"],[12,1,"つよ"],[15,2,"ちしき"],[19,1,"ひと"],[21,1,"ちから"],[24,1,"ひと"],[28,1,"つよ"]],"text":"知恵ある者は強い人よりも強く、知識ある人は力ある人よりも強い。"},{"ref":"Prov.24.6","start":20024006,"end":20024006,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"よ"],[2,2,"しき"],[8,1,"たたか"],[19,2,"しょうり"],[22,1,"おお"],[25,1,"ぎ"],[28,1,"もの"]],"text":"良い指揮によって戦いをすることができ、勝利は多くの議する者がいるからである。"},{"ref":"Prov.24.7","start":20024007,"end":20024007,"break":"line","breaks":[[21,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"たか"],[6,1,"おろ"],[9,1,"もの"],[11,1,"およ"],[21,1,"おろ"],[24,1,"もの"],[26,1,"もん"],[28,1,"くち"],[30,1,"ひら"]],"text":"知恵は高くて愚かな者の及ぶところではない、愚かな者は門で口を開くことができない。"},{"ref":"Prov.24.8","start":20024008,"end":20024008,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"あく"],[2,1,"おこな"],[7,1,"はか"],[9,1,"もの"],[11,1,"ひと"],[17,1,"もの"]],"text":"悪を行うことを計る者を人はいたずら者ととなえる。"},{"ref":"Prov.24.9","start":20024009,"end":20024009,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"はか"],[11,1,"つみ"],[20,1,"もの"],[22,1,"ひと"],[24,1,"にく"]],"text":"愚かな者の計るところは罪であり、あざける者は人に憎まれる。"},{"ref":"Prov.24.10","start":20024010,"end":20024010,"break":"stanza","breaks":[[20,"line"]],"ruby":[[6,1,"なや"],[9,1,"ひ"],[11,1,"き"],[24,1,"ちから"],[26,1,"よわ"]],"text":"もしあなたが悩みの日に気をくじくならば、あなたの力は弱い。"},{"ref":"Prov.24.11","start":20024011,"end":20024011,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"しち"],[8,1,"もの"],[10,1,"たす"],[12,1,"だ"],[15,1,"ほろ"],[24,1,"もの"],[26,1,"すく"]],"text":"死地にひかれゆく者を助け出せ、滅びによろめきゆく者を救え。"},{"ref":"Prov.24.12","start":20024012,"end":20024012,"break":"line","breaks":[[25,"line"],[45,"line"],[68,"line"]],"ruby":[[13,1,"し"],[25,1,"こころ"],[30,1,"もの"],[35,1,"さと"],[49,1,"たましい"],[51,1,"まも"],[53,1,"もの"],[58,1,"し"],[68,1,"かれ"],[75,1,"おこな"],[81,1,"ひと"],[83,1,"むく"]],"text":"あなたが、われわれはこれを知らなかったといっても、心をはかる者はそれを悟らないであろうか。あなたの魂を守る者はそれを知らないであろうか。彼はおのおのの行いにより、人に報いないであろうか。"},{"ref":"Prov.24.13","start":20024013,"end":20024013,"break":"stanza","breaks":[[22,"line"]],"ruby":[[2,1,"こ"],[5,1,"みつ"],[7,1,"た"],[14,1,"よ"],[25,1,"はち"],[27,1,"す"],[38,1,"くち"],[40,1,"あま"]],"text":"わが子よ、蜜を食べよ、これは良いものである、また、蜂の巣のしたたりはあなたの口に甘い。"},{"ref":"Prov.24.14","start":20024014,"end":20024014,"break":"line","breaks":[[23,"line"]],"ruby":[[0,2,"ちえ"],[7,1,"たましい"],[20,1,"し"],[26,1,"え"],[36,1,"むく"],[47,1,"のぞ"]],"text":"知恵もあなたの魂にはそのようであることを知れ。それを得るならば、かならず報いがあって、あなたの望みは、すたらない。"},{"ref":"Prov.24.15","start":20024015,"end":20024015,"break":"line","breaks":[[11,"line"],[29,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[11,1,"ただ"],[14,1,"もの"],[16,1,"いえ"],[31,1,"す"],[33,1,"ところ"],[35,2,"らんぼう"]],"text":"悪しき者がするように、正しい者の家をうかがってはならない、その住む所に乱暴をしてはならない。"},{"ref":"Prov.24.16","start":20024016,"end":20024016,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[8,1,"たお"],[15,1,"お"],[25,1,"あ"],[28,1,"もの"],[30,1,"わざわい"],[35,1,"ほろ"]],"text":"正しい者は七たび倒れても、また起きあがる、しかし、悪しき者は災によって滅びる。"},{"ref":"Prov.24.17","start":20024017,"end":20024017,"break":"line","breaks":[[22,"line"]],"ruby":[[7,1,"たお"],[12,1,"たの"],[22,1,"かれ"],[30,1,"こころ"],[32,1,"よろこ"]],"text":"あなたのあだが倒れるとき楽しんではならない、彼のつまずくとき心に喜んではならない。"},{"ref":"Prov.24.18","start":20024018,"end":20024018,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"み"],[7,1,"わる"],[16,1,"いか"],[19,1,"かれ"],[22,1,"てん"]],"text":"主はそれを見て悪いこととし、その怒りを彼から転じられる。"},{"ref":"Prov.24.19","start":20024019,"end":20024019,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"あく"],[2,1,"おこな"],[4,1,"もの"],[9,1,"こころ"],[11,1,"なや"],[26,1,"もの"]],"text":"悪を行う者のゆえに心を悩ましてはならない、よこしまな者をうらやんではならない。"},{"ref":"Prov.24.20","start":20024020,"end":20024020,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[6,1,"のち"],[8,1,"よ"],[10,1,"むく"],[21,1,"もの"],[28,1,"け"]],"text":"悪しき者には後の良い報いはない、よこしまな者のともしびは消される。"},{"ref":"Prov.24.21","start":20024021,"end":20024021,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"こ"],[5,1,"しゅ"],[7,1,"おう"],[10,1,"おそ"],[21,1,"ふ"],[22,2,"じゅうじゅん"]],"text":"わが子よ、主と王とを恐れよ、そのいずれにも不従順であってはならない。"},{"ref":"Prov.24.22","start":20024022,"end":20024022,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"わざわい"],[8,1,"おこ"],[21,1,"もの"],[26,1,"ほろ"],[32,1,"し"],[34,1,"え"]],"text":"その災はたちまち起るからである。この二つの者からくる滅びをだれが知り得ようか。"},{"ref":"Prov.24.23","start":20024023,"end":20024023,"break":"stanza","breaks":[[18,"stanza"]],"ruby":[[6,2,"ちえ"],[10,1,"もの"],[12,2,"しんげん"],[18,2,"かたよ"]],"text":"これらもまた知恵ある者の箴言である。片寄ったさばきをするのは、よくない。"},{"ref":"Prov.24.24","start":20024024,"end":20024024,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"む"],[15,1,"ただ"],[22,1,"もの"],[25,2,"ひとびと"],[32,2,"しょみん"],[35,1,"にく"]],"text":"悪しき者に向かって、「あなたは正しい」という者を、人々はのろい、諸民は憎む。"},{"ref":"Prov.24.25","start":20024025,"end":20024025,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[8,1,"もの"],[10,1,"めぐ"],[13,1,"え"],[18,2,"こうふく"],[21,1,"あた"]],"text":"悪しき者をせめる者は恵みを得る、また幸福が与えられる。"},{"ref":"Prov.24.26","start":20024026,"end":20024026,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"ただ"],[3,1,"こたえ"],[7,1,"もの"],[16,1,"くち"]],"text":"正しい答をする者は、くちびるに、口づけするのである。"},{"ref":"Prov.24.27","start":20024027,"end":20024027,"break":"line","breaks":[[13,"line"],[32,"line"]],"ruby":[[0,1,"そと"],[7,2,"しごと"],[10,1,"ととの"],[13,1,"はたけ"],[20,1,"もの"],[29,1,"そな"],[34,1,"のち"],[39,1,"いえ"],[41,1,"た"]],"text":"外で、あなたの仕事を整え、畑で、すべての物をおのれのために備え、その後あなたの家を建てるがよい。"},{"ref":"Prov.24.28","start":20024028,"end":20024028,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"とな"],[6,1,"びと"],[8,1,"てき"],[12,2,"しょうげん"],[31,1,"あざむ"]],"text":"ゆえなく隣り人に敵して、証言をしてはならない、くちびるをもって欺いてはならない。"},{"ref":"Prov.24.29","start":20024029,"end":20024029,"break":"line","breaks":[[23,"line"],[41,"line"]],"ruby":[[1,1,"かれ"],[17,1,"かれ"],[27,1,"ひと"],[43,1,"ひと"],[45,1,"むく"],[51,1,"い"]],"text":"「彼がわたしにしたように、わたしも彼にしよう、わたしは人がしたところにしたがって、その人に報いよう」と言ってはならない。"},{"ref":"Prov.24.30","start":20024030,"end":20024030,"break":"stanza","breaks":[[15,"line"]],"ruby":[[7,1,"もの"],[9,1,"はたけ"],[15,2,"ちえ"],[20,1,"ひと"],[25,1,"はたけ"],[30,1,"とお"]],"text":"わたしはなまけ者の畑のそばと、知恵のない人のぶどう畑のそばを通ってみたが、"},{"ref":"Prov.24.31","start":20024031,"end":20024031,"break":"line","breaks":[[23,"line"]],"ruby":[[4,2,"いちめん"],[7,1,"は"],[16,2,"じめん"],[25,1,"いし"]],"text":"いばらが一面に生え、あざみがその地面をおおい、その石がきはくずれていた。"},{"ref":"Prov.24.32","start":20024032,"end":20024032,"break":"line","breaks":[[15,"line"]],"ruby":[[9,1,"こころ"],[18,1,"み"],[20,2,"きょうくん"],[23,1,"え"]],"text":"わたしはこれをみて心をとどめ、これを見て教訓を得た。"},{"ref":"Prov.24.33","start":20024033,"end":20024033,"break":"line","breaks":[[17,"line"]],"ruby":[[5,1,"ねむ"],[17,1,"て"],[31,1,"やす"]],"text":"「しばらく眠り、しばらくまどろみ、手をこまぬいて、またしばらく休む」。"},{"ref":"Prov.24.34","start":20024034,"end":20024034,"break":"line","breaks":[[23,"line"]],"ruby":[[5,1,"まず"],[9,1,"ぬす"],[21,1,"き"],[23,1,"とぼ"],[41,1,"く"]],"text":"それゆえ、貧しさは盗びとのように、あなたに来、乏しさは、つわもののように、あなたに来る。"}]