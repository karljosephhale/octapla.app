[{"ref":"Ps.129.1","start":19129001,"end":19129001,"break":"paragraph","title":"都もうでの歌","breaks":[[10,"line"]],"ruby":[[0,1,"いま"],[7,1,"い"],[11,1,"かれ"],[18,1,"わか"],[20,1,"とき"],[31,1,"なや"]],"titleRuby":[[0,1,"みやこ"],[5,1,"うた"]],"text":"今イスラエルは言え、「彼らはわたしの若い時から、ひどくわたしを悩ました。"},{"ref":"Ps.129.2","start":19129002,"end":19129002,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"かれ"],[7,1,"わか"],[9,1,"とき"],[20,1,"なや"],[32,1,"か"]],"text":"彼らはわたしの若い時から、ひどくわたしを悩ました。しかしわたしに勝つことができなかった。"},{"ref":"Ps.129.3","start":19129003,"end":19129003,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"たがや"],[2,1,"もの"],[8,1,"せ"],[10,1,"うえ"],[25,1,"なが"]],"text":"耕す者はわたしの背の上をたがやして、そのうねみぞを長くした」と。"},{"ref":"Ps.129.4","start":19129004,"end":19129004,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ただ"],[11,1,"あ"],[14,1,"もの"],[19,1,"た"],[21,1,"き"]],"text":"主は正しくいらせられ、悪しき者のなわを断ち切られた。"},{"ref":"Ps.129.5","start":19129005,"end":19129005,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"にく"],[6,1,"もの"],[11,1,"はじ"],[13,1,"え"],[16,1,"しりぞ"]],"text":"シオンを憎む者はみな、恥を得て、退くように。"},{"ref":"Ps.129.6","start":19129006,"end":19129006,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[4,1,"そだ"],[11,1,"か"],[14,2,"やね"],[17,1,"くさ"]],"text":"彼らを、育たないさきに枯れる屋根の草のようにしてください。"},{"ref":"Ps.129.7","start":19129007,"end":19129007,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"か"],[5,1,"もの"],[9,1,"て"],[11,1,"み"],[22,1,"もの"],[31,1,"み"]],"text":"これを刈る者はその手に満たず、これをたばねる者はそのふところに満たない。"},{"ref":"Ps.129.8","start":19129008,"end":19129008,"break":"line","breaks":[[11,"line"],[29,"line"],[41,"line"]],"ruby":[[5,1,"す"],[8,1,"もの"],[12,1,"しゅ"],[14,1,"めぐ"],[21,1,"うえ"],[33,1,"しゅ"],[36,1,"な"],[47,2,"しゅくふく"],[53,1,"い"]],"text":"かたわらを過ぎる者は、「主の恵みがあなたの上にあるように。われらは主のみ名によってあなたがたを祝福する」と言わない。"}]