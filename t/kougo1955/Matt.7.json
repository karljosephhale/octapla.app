[{"ref":"Matt.7.1","start":40007001,"end":40007001,"break":"paragraph","ruby":[[0,1,"ひと"],[7,2,"じぶん"]],"text":"人をさばくな。自分がさばかれないためである。"},{"ref":"Matt.7.2","start":40007002,"end":40007002,"break":"none","ruby":[[16,2,"じぶん"],[30,1,"はか"],[39,2,"じぶん"],[43,1,"はか"],[45,1,"あた"]],"text":"あなたがたがさばくそのさばきで、自分もさばかれ、あなたがたの量るそのはかりで、自分にも量り与えられるであろう。"},{"ref":"Matt.7.3","start":40007003,"end":40007003,"break":"none","ruby":[[3,2,"きょうだい"],[6,1,"め"],[13,1,"み"],[18,2,"じぶん"],[21,1,"め"],[25,1,"はり"],[27,1,"みと"]],"text":"なぜ、兄弟の目にあるちりを見ながら、自分の目にある梁を認めないのか。"},{"ref":"Matt.7.4","start":40007004,"end":40007004,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"め"],[6,1,"はり"],[17,2,"きょうだい"],[29,1,"め"],[35,1,"と"],[45,1,"い"]],"text":"自分の目には梁があるのに、どうして兄弟にむかって、あなたの目からちりを取らせてください、と言えようか。"},{"ref":"Matt.7.5","start":40007005,"end":40007005,"break":"none","ruby":[[0,3,"ぎぜんしゃ"],[7,2,"じぶん"],[10,1,"め"],[13,1,"はり"],[15,1,"と"],[34,1,"み"],[44,2,"きょうだい"],[47,1,"め"],[53,1,"と"]],"text":"偽善者よ、まず自分の目から梁を取りのけるがよい。そうすれば、はっきり見えるようになって、兄弟の目からちりを取りのけることができるだろう。"},{"ref":"Matt.7.6","start":40007006,"end":40007006,"break":"paragraph","ruby":[[0,1,"せい"],[6,1,"いぬ"],[14,2,"しんじゅ"],[17,1,"ぶた"],[19,1,"な"],[26,1,"おそ"],[29,1,"かれ"],[36,1,"あし"],[38,1,"ふ"],[43,1,"む"]],"text":"聖なるものを犬にやるな。また真珠を豚に投げてやるな。恐らく彼らはそれらを足で踏みつけ、向きなおってあなたがたにかみついてくるであろう。"},{"ref":"Matt.7.7","start":40007007,"end":40007007,"break":"paragraph","ruby":[[0,1,"もと"],[10,1,"あた"],[20,1,"さが"],[29,1,"み"],[38,1,"もん"]],"text":"求めよ、そうすれば、与えられるであろう。捜せ、そうすれば、見いだすであろう。門をたたけ、そうすれば、あけてもらえるであろう。"},{"ref":"Matt.7.8","start":40007008,"end":40007008,"break":"none","ruby":[[3,1,"もと"],[6,1,"もの"],[8,1,"え"],[10,1,"さが"],[12,1,"もの"],[14,1,"み"],[19,1,"もん"],[24,1,"もの"]],"text":"すべて求める者は得、捜す者は見いだし、門をたたく者はあけてもらえるからである。"},{"ref":"Matt.7.9","start":40007009,"end":40007009,"break":"none","ruby":[[10,2,"じぶん"],[13,1,"こ"],[18,1,"もと"],[24,1,"いし"],[26,1,"あた"],[29,1,"もの"]],"text":"あなたがたのうちで、自分の子がパンを求めるのに、石を与える者があろうか。"},{"ref":"Matt.7.10","start":40007010,"end":40007010,"break":"none","ruby":[[0,1,"うお"],[2,1,"もと"],[11,1,"あた"],[14,1,"もの"]],"text":"魚を求めるのに、へびを与える者があろうか。"},{"ref":"Matt.7.11","start":40007011,"end":40007011,"break":"none","ruby":[[12,1,"わる"],[14,1,"もの"],[21,2,"じぶん"],[24,2,"こども"],[29,1,"よ"],[31,1,"おく"],[33,1,"もの"],[40,1,"し"],[50,1,"てん"],[61,1,"ちち"],[68,1,"もと"],[73,1,"もの"],[75,1,"よ"],[80,1,"くだ"]],"text":"このように、あなたがたは悪い者であっても、自分の子供には、良い贈り物をすることを知っているとすれば、天にいますあなたがたの父はなおさら、求めてくる者に良いものを下さらないことがあろうか。"},{"ref":"Matt.7.12","start":40007012,"end":40007012,"break":"none","ruby":[[4,2,"なにごと"],[8,2,"ひとびと"],[18,1,"のぞ"],[24,2,"ひとびと"],[40,2,"りっぽう"],[45,3,"よげんしゃ"]],"text":"だから、何事でも人々からしてほしいと望むことは、人々にもそのとおりにせよ。これが律法であり預言者である。"},{"ref":"Matt.7.13","start":40007013,"end":40007013,"break":"paragraph","ruby":[[0,1,"せま"],[2,1,"もん"],[9,1,"ほろ"],[15,1,"もん"],[17,1,"おお"],[23,1,"みち"],[25,1,"ひろ"],[40,1,"い"],[42,1,"もの"],[44,1,"おお"]],"text":"狭い門からはいれ。滅びにいたる門は大きく、その道は広い。そして、そこからはいって行く者が多い。"},{"ref":"Matt.7.14","start":40007014,"end":40007014,"break":"none","ruby":[[0,1,"いのち"],[5,1,"もん"],[7,1,"せま"],[12,1,"みち"],[14,1,"ほそ"],[24,1,"み"],[28,1,"もの"],[30,1,"すく"]],"text":"命にいたる門は狭く、その道は細い。そして、それを見いだす者が少ない。"},{"ref":"Matt.7.15","start":40007015,"end":40007015,"break":"paragraph","ruby":[[2,3,"よげんしゃ"],[6,2,"けいかい"],[11,1,"かれ"],[15,1,"ひつじ"],[17,1,"ころも"],[19,1,"き"],[31,1,"く"],[37,2,"うちがわ"],[40,2,"ごうよく"]],"text":"にせ預言者を警戒せよ。彼らは、羊の衣を着てあなたがたのところに来るが、その内側は強欲なおおかみである。"},{"ref":"Matt.7.16","start":40007016,"end":40007016,"break":"none","ruby":[[9,1,"み"],[14,1,"かれ"],[17,1,"み"],[26,1,"いばら"],[44,1,"あつ"],[47,1,"もの"]],"text":"あなたがたは、その実によって彼らを見わけるであろう。茨からぶどうを、あざみからいちじくを集める者があろうか。"},{"ref":"Matt.7.17","start":40007017,"end":40007017,"break":"none","ruby":[[9,1,"よ"],[11,1,"き"],[13,1,"よ"],[15,1,"み"],[17,1,"むす"],[20,1,"わる"],[22,1,"き"],[24,1,"わる"],[26,1,"み"],[28,1,"むす"]],"text":"そのように、すべて良い木は良い実を結び、悪い木は悪い実を結ぶ。"},{"ref":"Matt.7.18","start":40007018,"end":40007018,"break":"none","ruby":[[0,1,"よ"],[2,1,"き"],[4,1,"わる"],[6,1,"み"],[19,1,"わる"],[21,1,"き"],[23,1,"よ"],[25,1,"み"]],"text":"良い木が悪い実をならせることはないし、悪い木が良い実をならせることはできない。"},{"ref":"Matt.7.19","start":40007019,"end":40007019,"break":"none","ruby":[[0,1,"よ"],[2,1,"み"],[4,1,"むす"],[8,1,"き"],[15,1,"き"],[20,1,"ひ"],[22,1,"なか"],[24,1,"な"],[26,1,"こ"]],"text":"良い実を結ばない木はことごとく切られて、火の中に投げ込まれる。"},{"ref":"Matt.7.20","start":40007020,"end":40007020,"break":"none","ruby":[[14,1,"み"],[19,1,"かれ"],[22,1,"み"]],"text":"このように、あなたがたはその実によって彼らを見わけるのである。"},{"ref":"Matt.7.21","start":40007021,"end":40007021,"break":"none","ruby":[[9,1,"しゅ"],[12,1,"しゅ"],[16,1,"い"],[18,1,"もの"],[23,2,"てんごく"],[38,1,"てん"],[45,1,"ちち"],[47,2,"みむね"],[50,1,"おこな"],[52,1,"もの"]],"text":"わたしにむかって『主よ、主よ』と言う者が、みな天国にはいるのではなく、ただ、天にいますわが父の御旨を行う者だけが、はいるのである。"},{"ref":"Matt.7.22","start":40007022,"end":40007022,"break":"none","ruby":[[2,1,"ひ"],[6,1,"おお"],[9,1,"もの"],[21,1,"しゅ"],[24,1,"しゅ"],[37,1,"な"],[42,2,"よげん"],[62,1,"な"],[67,2,"あくれい"],[70,1,"お"],[72,1,"だ"],[79,1,"な"],[84,1,"おお"],[87,1,"ちから"],[93,1,"おこな"],[106,1,"い"]],"text":"その日には、多くの者が、わたしにむかって『主よ、主よ、わたしたちはあなたの名によって預言したではありませんか。また、あなたの名によって悪霊を追い出し、あなたの名によって多くの力あるわざを行ったではありませんか』と言うであろう。"},{"ref":"Matt.7.23","start":40007023,"end":40007023,"break":"none","ruby":[[9,1,"かれ"],[19,1,"い"],[30,1,"まった"],[32,1,"し"],[37,2,"ふほう"],[40,1,"はたら"],[42,1,"もの"],[47,1,"い"]],"text":"そのとき、わたしは彼らにはっきり、こう言おう、『あなたがたを全く知らない。不法を働く者どもよ、行ってしまえ』。"},{"ref":"Matt.7.24","start":40007024,"end":40007024,"break":"paragraph","ruby":[[12,2,"ことば"],[15,1,"き"],[18,1,"おこな"],[24,1,"いわ"],[26,1,"うえ"],[28,2,"じぶん"],[31,1,"いえ"],[33,1,"た"],[36,1,"かしこ"],[38,1,"ひと"],[40,1,"くら"]],"text":"それで、わたしのこれらの言葉を聞いて行うものを、岩の上に自分の家を建てた賢い人に比べることができよう。"},{"ref":"Matt.7.25","start":40007025,"end":40007025,"break":"none","ruby":[[0,1,"あめ"],[2,1,"ふ"],[5,2,"こうずい"],[8,1,"お"],[10,1,"よ"],[13,1,"かぜ"],[15,1,"ふ"],[20,1,"いえ"],[22,1,"う"],[29,1,"たお"],[38,1,"いわ"],[40,2,"どだい"]],"text":"雨が降り、洪水が押し寄せ、風が吹いてその家に打ちつけても、倒れることはない。岩を土台としているからである。"},{"ref":"Matt.7.26","start":40007026,"end":40007026,"break":"none","ruby":[[11,2,"ことば"],[14,1,"き"],[18,1,"おこな"],[22,1,"もの"],[25,1,"すな"],[27,1,"うえ"],[29,2,"じぶん"],[32,1,"いえ"],[34,1,"た"],[37,1,"おろ"],[40,1,"ひと"],[42,1,"くら"]],"text":"また、わたしのこれらの言葉を聞いても行わない者を、砂の上に自分の家を建てた愚かな人に比べることができよう。"},{"ref":"Matt.7.27","start":40007027,"end":40007027,"break":"none","ruby":[[0,1,"あめ"],[2,1,"ふ"],[5,2,"こうずい"],[8,1,"お"],[10,1,"よ"],[13,1,"かぜ"],[15,1,"ふ"],[20,1,"いえ"],[22,1,"う"],[29,1,"たお"],[41,1,"たお"],[43,1,"かた"]],"text":"雨が降り、洪水が押し寄せ、風が吹いてその家に打ちつけると、倒れてしまう。そしてその倒れ方はひどいのである」。"},{"ref":"Matt.7.28","start":40007028,"end":40007028,"break":"paragraph","ruby":[[8,1,"ことば"],[10,1,"かた"],[12,1,"お"],[19,2,"ぐんしゅう"],[24,1,"おしえ"],[29,1,"おどろ"]],"text":"イエスがこれらの言を語り終えられると、群衆はその教にひどく驚いた。"},{"ref":"Matt.7.29","start":40007029,"end":40007029,"break":"none","ruby":[[3,2,"りっぽう"],[5,2,"がくしゃ"],[18,2,"けんい"],[22,1,"もの"],[28,1,"おし"]],"text":"それは律法学者たちのようにではなく、権威ある者のように、教えられたからである。"}]