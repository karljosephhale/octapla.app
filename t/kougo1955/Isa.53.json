[{"ref":"Isa.53.1","start":23053001,"end":23053001,"break":"paragraph","breaks":[[14,"line"],[20,"line"]],"ruby":[[8,1,"き"],[14,1,"しん"],[16,1,"え"],[20,1,"しゅ"],[22,1,"うで"]],"text":"だれがわれわれの聞いたことを信じ得たか。主の腕は、だれにあらわれたか。"},{"ref":"Isa.53.2","start":23053002,"end":23053002,"break":"line","breaks":[[13,"line"],[31,"line"],[54,"line"]],"ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"まえ"],[6,2,"わかぎ"],[17,1,"つち"],[20,1,"で"],[22,1,"ね"],[27,1,"そだ"],[31,1,"かれ"],[39,1,"み"],[43,1,"すがた"],[48,2,"いげん"],[59,1,"した"],[63,1,"うつく"]],"text":"彼は主の前に若木のように、かわいた土から出る根のように育った。彼にはわれわれの見るべき姿がなく、威厳もなく、われわれの慕うべき美しさもない。"},{"ref":"Isa.53.3","start":23053003,"end":23053003,"break":"line","breaks":[[13,"line"],[28,"line"],[49,"line"]],"ruby":[[0,1,"かれ"],[2,1,"あなど"],[6,1,"ひと"],[8,1,"す"],[13,1,"かな"],[17,1,"ひと"],[20,1,"やまい"],[22,1,"し"],[30,1,"かお"],[36,1,"い"],[43,1,"もの"],[49,1,"かれ"],[51,1,"あなど"],[61,1,"かれ"],[63,1,"たっと"]],"text":"彼は侮られて人に捨てられ、悲しみの人で、病を知っていた。また顔をおおって忌みきらわれる者のように、彼は侮られた。われわれも彼を尊ばなかった。"},{"ref":"Isa.53.4","start":23053004,"end":23053004,"break":"line","breaks":[[16,"line"],[30,"line"],[44,"line"]],"ruby":[[4,1,"かれ"],[11,1,"やまい"],[13,1,"お"],[21,1,"かな"],[40,1,"おも"],[44,1,"かれ"],[46,1,"う"],[50,1,"かみ"],[57,1,"くる"]],"text":"まことに彼はわれわれの病を負い、われわれの悲しみをになった。しかるに、われわれは思った、彼は打たれ、神にたたかれ、苦しめられたのだと。"},{"ref":"Isa.53.5","start":23053005,"end":23053005,"break":"line","breaks":[[22,"line"],[40,"line"],[54,"line"],[65,"line"],[77,"line"]],"ruby":[[3,1,"かれ"],[16,1,"きず"],[27,2,"ふぎ"],[33,1,"くだ"],[40,1,"かれ"],[46,1,"こら"],[59,2,"へいあん"],[62,1,"あた"],[67,1,"う"],[71,1,"きず"]],"text":"しかし彼はわれわれのとがのために傷つけられ、われわれの不義のために砕かれたのだ。彼はみずから懲しめをうけて、われわれに平安を与え、その打たれた傷によって、われわれはいやされたのだ。"},{"ref":"Isa.53.6","start":23053006,"end":23053006,"break":"line","breaks":[[16,"line"],[33,"line"],[49,"line"]],"ruby":[[7,1,"ひつじ"],[12,1,"まよ"],[20,2,"じぶん"],[23,1,"みち"],[25,1,"む"],[29,1,"い"],[33,1,"しゅ"],[43,1,"もの"],[45,2,"ふぎ"],[49,1,"かれ"],[51,1,"うえ"]],"text":"われわれはみな羊のように迷って、おのおの自分の道に向かって行った。主はわれわれすべての者の不義を、彼の上におかれた。"},{"ref":"Isa.53.7","start":23053007,"end":23053007,"break":"line","breaks":[[20,"line"],[29,"line"],[47,"line"],[68,"line"]],"ruby":[[0,1,"かれ"],[9,1,"くる"],[20,1,"くち"],[22,1,"ひら"],[32,1,"ば"],[38,1,"い"],[40,2,"こひつじ"],[49,1,"け"],[51,1,"き"],[53,1,"もの"],[55,1,"まえ"],[57,1,"だま"],[62,1,"ひつじ"],[68,1,"くち"],[70,1,"ひら"]],"text":"彼はしえたげられ、苦しめられたけれども、口を開かなかった。ほふり場にひかれて行く小羊のように、また毛を切る者の前に黙っている羊のように、口を開かなかった。"},{"ref":"Isa.53.8","start":23053008,"end":23053008,"break":"line","breaks":[[19,"line"],[40,"line"],[57,"line"]],"ruby":[[0,1,"かれ"],[2,2,"ぼうぎゃく"],[12,1,"と"],[14,1,"さ"],[21,1,"よ"],[23,1,"ひと"],[31,1,"おも"],[40,1,"かれ"],[44,1,"たみ"],[52,1,"う"],[57,1,"い"],[63,1,"ち"],[66,1,"た"]],"text":"彼は暴虐なさばきによって取り去られた。その代の人のうち、だれが思ったであろうか、彼はわが民のとがのために打たれて、生けるものの地から断たれたのだと。"},{"ref":"Isa.53.9","start":23053009,"end":23053009,"break":"line","breaks":[[9,"line"],[26,"line"],[42,"line"]],"ruby":[[0,1,"かれ"],[2,2,"ぼうぎゃく"],[5,1,"おこな"],[11,1,"くち"],[14,1,"いつわ"],[28,1,"はか"],[30,1,"あ"],[33,1,"もの"],[35,1,"とも"],[37,1,"もう"],[44,1,"つか"],[46,1,"あく"],[50,1,"もの"],[52,1,"とも"]],"text":"彼は暴虐を行わず、その口には偽りがなかったけれども、その墓は悪しき者と共に設けられ、その塚は悪をなす者と共にあった。"},{"ref":"Isa.53.10","start":23053010,"end":23053010,"break":"line","breaks":[[18,"line"],[28,"line"],[46,"line"],[59,"line"],[75,"line"]],"ruby":[[3,1,"かれ"],[5,1,"くだ"],[10,1,"しゅ"],[13,1,"むね"],[18,1,"しゅ"],[20,1,"かれ"],[22,1,"なや"],[28,1,"かれ"],[30,2,"じぶん"],[37,1,"そな"],[39,1,"もの"],[48,2,"しそん"],[51,1,"み"],[61,1,"いのち"],[77,1,"しゅ"],[80,1,"むね"],[82,1,"かれ"],[84,1,"て"],[89,1,"さか"]],"text":"しかも彼を砕くことは主のみ旨であり、主は彼を悩まされた。彼が自分を、とがの供え物となすとき、その子孫を見ることができ、その命をながくすることができる。かつ主のみ旨が彼の手によって栄える。"},{"ref":"Isa.53.11","start":23053011,"end":23053011,"break":"line","breaks":[[22,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[2,2,"じぶん"],[5,1,"たましい"],[7,1,"くる"],[13,1,"ひかり"],[15,1,"み"],[17,2,"まんぞく"],[22,1,"ぎ"],[33,2,"ちしき"],[40,1,"おお"],[43,1,"ひと"],[45,1,"ぎ"],[51,1,"かれ"],[54,2,"ふぎ"],[57,1,"お"]],"text":"彼は自分の魂の苦しみにより光を見て満足する。義なるわがしもべはその知識によって、多くの人を義とし、また彼らの不義を負う。"},{"ref":"Isa.53.12","start":23053012,"end":23053012,"break":"line","breaks":[[19,"line"],[29,"line"],[46,"line"],[70,"line"],[89,"line"],[104,"line"]],"ruby":[[9,1,"かれ"],[11,1,"おお"],[15,1,"もの"],[17,1,"とも"],[19,1,"もの"],[21,1,"わ"],[24,1,"と"],[29,1,"かれ"],[31,1,"つよ"],[33,1,"もの"],[35,1,"とも"],[37,2,"えもの"],[40,1,"わ"],[43,1,"と"],[49,1,"かれ"],[51,1,"し"],[59,2,"じぶん"],[62,1,"たましい"],[74,1,"もの"],[76,1,"とも"],[78,1,"かぞ"],[92,1,"かれ"],[94,1,"おお"],[97,1,"ひと"],[99,1,"つみ"],[101,1,"お"],[108,1,"もの"]],"text":"それゆえ、わたしは彼に大いなる者と共に物を分かち取らせる。彼は強い者と共に獲物を分かち取る。これは彼が死にいたるまで、自分の魂をそそぎだし、とがある者と共に数えられたからである。しかも彼は多くの人の罪を負い、とがある者のためにとりなしをした。"}]