[{"ref":"Isa.36.1","start":23036001,"end":23036001,"break":"paragraph","ruby":[[4,1,"おう"],[6,1,"だい"],[9,1,"ねん"],[18,1,"おう"],[25,1,"のぼ"],[38,2,"けんご"],[41,2,"まちまち"],[44,1,"せ"],[46,1,"と"]],"text":"ヒゼキヤ王の第十四年に、アッスリヤの王セナケリブが上ってきて、ユダのすべての堅固な町々を攻め取った。"},{"ref":"Isa.36.2","start":23036002,"end":23036002,"break":"none","ruby":[[6,1,"おう"],[30,2,"たいぐん"],[33,1,"ひき"],[40,1,"おう"],[45,1,"い"],[56,1,"ぬの"],[61,1,"の"],[63,1,"い"],[65,2,"おおじ"],[68,1,"そ"],[71,1,"うえ"],[73,1,"いけ"],[75,2,"すいどう"],[83,1,"た"]],"text":"アッスリヤの王はラキシからラブシャケをエルサレムにつかわし、大軍を率いてヒゼキヤ王のもとへ行かせた。ラブシャケは布さらしの野へ行く大路に沿う、上の池の水道のかたわらに立った。"},{"ref":"Isa.36.3","start":23036003,"end":23036003,"break":"none","ruby":[[2,1,"とき"],[8,1,"こ"],[12,3,"くないきょう"],[21,3,"しょきかん"],[34,1,"こ"],[38,2,"しかん"],[43,1,"かれ"],[45,1,"ところ"],[47,1,"で"]],"text":"この時ヒルキヤの子である宮内卿エリアキム、書記官セブナおよびアサフの子である史官ヨアが彼の所に出てきた。"},{"ref":"Isa.36.4","start":23036004,"end":23036004,"break":"paragraph","ruby":[[6,1,"かれ"],[9,1,"い"],[19,1,"い"],[26,2,"だいおう"],[34,1,"おう"],[38,1,"おお"],[48,1,"たの"],[53,1,"もの"],[55,1,"なに"]],"text":"ラブシャケは彼らに言った、「ヒゼキヤに言いなさい、『大王アッスリヤの王はこう仰せられる、あなたが頼みとする者は何か。"},{"ref":"Isa.36.5","start":23036005,"end":23036005,"break":"none","ruby":[[0,2,"くちさき"],[5,2,"ことば"],[8,2,"せんそう"],[13,2,"けいりゃく"],[16,1,"ちから"],[19,1,"かんが"],[29,1,"いま"],[33,1,"たよ"]],"text":"口先だけの言葉が戦争をする計略と力だと考えるのか。あなたは今だれを頼んで、わたしにそむいたのか。"},{"ref":"Isa.36.6","start":23036006,"end":23036006,"break":"none","ruby":[[0,1,"み"],[9,1,"お"],[16,1,"あし"],[25,1,"たの"],[37,1,"ひと"],[39,1,"よ"],[49,1,"ひと"],[51,1,"て"],[53,1,"さ"],[55,1,"とお"],[63,1,"おう"],[70,1,"よ"],[72,1,"たの"],[74,1,"もの"]],"text":"見よ、あなたはかの折れかけている葦のつえエジプトを頼みとしているが、それは人が寄りかかるとき、その人の手を刺し通す。エジプトの王パロはすべて寄り頼む者にそのようにするのだ。"},{"ref":"Isa.36.7","start":23036007,"end":23036007,"break":"none","ruby":[[21,1,"かみ"],[23,1,"しゅ"],[25,1,"たの"],[33,1,"い"],[53,1,"つ"],[66,2,"さいだん"],[69,1,"まえ"],[71,2,"れいはい"],[84,1,"い"],[87,1,"のぞ"],[95,1,"かみ"],[97,1,"たか"],[99,1,"ところ"],[101,2,"さいだん"]],"text":"しかし、あなたがもし「われわれはわれわれの神、主を頼む」とわたしに言うならば、ヒゼキヤがユダとエルサレムに告げて、「あなたがたはこの祭壇の前で礼拝しなければならない」と言って除いたのは、その神の高き所と祭壇ではなかったのか。"},{"ref":"Isa.36.8","start":23036008,"end":23036008,"break":"none","ruby":[[3,1,"いま"],[8,2,"しゅくん"],[16,1,"おう"],[30,1,"ほう"],[32,1,"の"],[34,1,"ひと"],[46,1,"うま"],[49,1,"とう"],[51,1,"あた"]],"text":"さあ、今わたしの主君アッスリヤの王とかけをせよ。もしあなたの方に乗る人があるならば、わたしは馬二千頭を与えよう。"},{"ref":"Isa.36.9","start":23036009,"end":23036009,"break":"none","ruby":[[9,1,"たの"],[12,2,"せんしゃ"],[15,2,"きへい"],[18,1,"こ"],[20,1,"もと"],[31,2,"しゅくん"],[34,2,"けらい"],[40,1,"もっと"],[42,1,"ちい"],[46,2,"たいちょう"],[56,2,"げきたい"]],"text":"あなたはエジプトを頼み、戦車と騎兵を請い求めているが、わたしの主君の家来のうちの最も小さい一隊長でさえ、どうして撃退することができようか。"},{"ref":"Isa.36.10","start":23036010,"end":23036010,"break":"none","ruby":[[6,1,"くに"],[8,1,"ほろ"],[14,1,"のぼ"],[22,1,"しゅ"],[24,1,"ゆる"],[39,1,"しゅ"],[48,1,"くに"],[50,1,"せ"],[52,1,"のぼ"],[59,1,"ほろ"],[63,1,"い"]],"text":"わたしがこの国を滅ぼすために上ってきたのは、主の許しなしでしたことであろうか。主はわたしに、この国へ攻め上って、これを滅ぼせと言われたのだ』」。"},{"ref":"Isa.36.11","start":23036011,"end":23036011,"break":"paragraph","ruby":[[2,1,"とき"],[25,1,"い"],[37,1,"ご"],[45,1,"はな"],[70,2,"じょうへき"],[73,1,"うえ"],[77,1,"たみ"],[79,1,"き"],[99,2,"ことば"],[102,1,"はな"]],"text":"その時、エリアキム、セブナおよびヨアはラブシャケに言った、「どうぞ、アラム語でしもべたちに話してください。わたしたちはそれがわかるからです。城壁の上にいる民の聞いているところで、わたしたちにユダヤの言葉で話さないでください」。"},{"ref":"Isa.36.12","start":23036012,"end":23036012,"break":"none","ruby":[[9,1,"い"],[18,2,"しゅくん"],[26,2,"しゅくん"],[39,2,"じょうへき"],[42,1,"うえ"],[44,1,"ざ"],[49,2,"ひとびと"],[56,2,"ことば"],[59,1,"つ"],[83,1,"かれ"],[94,1,"とも"],[96,2,"じぶん"],[99,2,"ふんにょう"],[102,1,"く"],[104,1,"の"],[109,1,"いた"]],"text":"しかしラブシャケは言った、「わたしの主君は、あなたの主君とあなたにだけでなく、城壁の上に座している人々にも、この言葉を告げるために、わたしをつかわされたのではないか。彼らをも、あなたがたと共に自分の糞尿を食い飲みするに至らせるためではないか」。"},{"ref":"Isa.36.13","start":23036013,"end":23036013,"break":"paragraph","ruby":[[9,1,"た"],[19,2,"ことば"],[22,2,"おおごえ"],[25,1,"よ"],[30,1,"い"],[35,2,"だいおう"],[44,1,"おう"],[46,2,"ことば"],[49,1,"き"]],"text":"そしてラブシャケは立ちあがり、ユダヤの言葉で大声に呼ばわって言った、「大王、アッスリヤの王の言葉を聞け。"},{"ref":"Isa.36.14","start":23036014,"end":23036014,"break":"none","ruby":[[0,1,"おう"],[4,1,"おお"],[22,1,"あざむ"],[32,1,"かれ"],[40,1,"すく"],[42,1,"だ"]],"text":"王はこう仰せられる、『あなたがたはヒゼキヤに欺かれてはならない。彼はあなたがたを救い出すことはできない。"},{"ref":"Isa.36.15","start":23036015,"end":23036015,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"かなら"],[15,1,"すく"],[17,1,"だ"],[24,1,"まち"],[32,1,"おう"],[34,1,"て"],[36,1,"おちい"],[45,1,"い"],[56,1,"しゅ"],[58,1,"たの"]],"text":"ヒゼキヤが、主は必ずわれわれを救い出される。この町はアッスリヤの王の手に陥ることはない、と言っても、あなたがたは主を頼みとしてはならない』。"},{"ref":"Isa.36.16","start":23036016,"end":23036016,"break":"none","ruby":[[11,2,"ことば"],[14,1,"き"],[29,1,"おう"],[33,1,"おお"],[51,1,"わ"],[61,2,"こうふく"],[82,2,"じぶん"],[89,1,"み"],[91,1,"た"],[98,2,"じぶん"],[106,1,"み"],[108,1,"た"],[115,2,"じぶん"],[118,2,"いど"],[121,1,"みず"],[123,1,"の"]],"text":"あなたがたはヒゼキヤの言葉を聞いてはならない。アッスリヤの王はこう仰せられる、『あなたがたは、わたしと和ぼくして、わたしに降服せよ。そうすれば、あなたがたはめいめい自分のぶどうの実を食べ、めいめい自分のいちじくの実を食べ、めいめい自分の井戸の水を飲むことができる。"},{"ref":"Isa.36.17","start":23036017,"end":23036017,"break":"none","ruby":[[8,1,"き"],[20,1,"くに"],[22,1,"つ"],[25,1,"い"],[38,1,"くに"],[43,2,"こくもつ"],[49,1,"しゅ"],[51,1,"おお"],[53,1,"ち"],[61,1,"はたけ"],[63,1,"おお"],[65,1,"ち"]],"text":"やがて、わたしが来て、あなたがたを一つの国へ連れて行く。それは、あなたがたの国のように穀物とぶどう酒の多い地、パンとぶどう畑の多い地だ。"},{"ref":"Isa.36.18","start":23036018,"end":23036018,"break":"none","ruby":[[6,1,"しゅ"],[13,1,"すく"],[19,1,"い"],[29,1,"まど"],[40,1,"き"],[51,1,"くに"],[53,2,"かみがみ"],[61,1,"かみ"],[65,1,"くに"],[73,1,"おう"],[75,1,"て"],[78,1,"すく"]],"text":"ヒゼキヤが、主はわれわれを救われる、と言って、あなたがたを惑わすことのないように気をつけよ。もろもろの国の神々のうち、どの神がその国をアッスリヤの王の手から救ったか。"},{"ref":"Isa.36.19","start":23036019,"end":23036019,"break":"none","ruby":[[9,2,"かみがみ"],[26,2,"かみがみ"],[36,1,"かれ"],[48,1,"て"],[51,1,"すく"],[53,1,"だ"]],"text":"ハマテやアルパデの神々はどこにいるか。セパルワイムの神々はどこにいるか。彼らはサマリヤをわたしの手から救い出したか。"},{"ref":"Isa.36.20","start":23036020,"end":23036020,"break":"none","ruby":[[4,2,"くにぐに"],[11,2,"かみがみ"],[23,1,"くに"],[29,1,"て"],[32,1,"すく"],[34,1,"だ"],[37,1,"もの"],[43,1,"しゅ"],[59,1,"て"],[62,1,"すく"],[64,1,"だ"]],"text":"これらの国々のすべての神々のうちに、だれかその国をわたしの手から救い出した者があるか。主がどうしてエルサレムをわたしの手から救い出すことができよう』」。"},{"ref":"Isa.36.21","start":23036021,"end":23036021,"break":"paragraph","ruby":[[3,1,"たみ"],[5,1,"だま"],[10,1,"こと"],[12,1,"こた"],[19,1,"おう"],[21,1,"めい"],[26,1,"かれ"],[28,1,"こた"],[38,1,"い"]],"text":"しかし民は黙ってひと言も答えなかった。王が命じて、「彼に答えてはならない」と言っておいたからである。"},{"ref":"Isa.36.22","start":23036022,"end":23036022,"break":"none","ruby":[[2,1,"とき"],[8,1,"こ"],[12,3,"くないきょう"],[21,3,"しょきかん"],[34,1,"こ"],[38,2,"しかん"],[43,1,"ころも"],[45,1,"さ"],[56,1,"き"],[65,2,"ことば"],[68,1,"かれ"],[70,1,"つ"]],"text":"その時ヒルキヤの子である宮内卿エリアキム、書記官セブナおよびアサフの子である史官ヨアは衣を裂き、ヒゼキヤのもとに来て、ラブシャケの言葉を彼に告げた。"}]