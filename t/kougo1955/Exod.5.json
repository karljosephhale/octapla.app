[{"ref":"Exod.5.1","start":2005001,"end":2005001,"break":"paragraph","ruby":[[2,1,"のち"],[12,1,"い"],[18,1,"い"],[29,1,"かみ"],[31,1,"しゅ"],[35,1,"い"],[45,1,"たみ"],[47,1,"さ"],[51,2,"あらの"],[62,1,"まつり"]],"text":"その後、モーセとアロンは行ってパロに言った、「イスラエルの神、主はこう言われる、『わたしの民を去らせ、荒野で、わたしのために祭をさせなさい』と」。"},{"ref":"Exod.5.2","start":2005002,"end":2005002,"break":"none","ruby":[[3,1,"い"],[8,1,"しゅ"],[15,2,"なにもの"],[25,1,"こえ"],[27,1,"き"],[29,1,"したが"],[38,1,"さ"],[56,1,"しゅ"],[58,1,"し"],[71,1,"さ"]],"text":"パロは言った、「主とはいったい何者か。わたしがその声に聞き従ってイスラエルを去らせなければならないのか。わたしは主を知らない。またイスラエルを去らせはしない」。"},{"ref":"Exod.5.3","start":2005003,"end":2005003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[14,1,"かみ"],[22,1,"あらわ"],[39,1,"か"],[41,1,"みち"],[46,2,"あらの"],[49,1,"い"],[59,1,"かみ"],[61,1,"しゅ"],[63,2,"ぎせい"],[84,1,"しゅ"],[86,2,"えきびょう"],[104,1,"なや"]],"text":"彼らは言った、「ヘブルびとの神がわたしたちに現れました。どうか、わたしたちを三日の道のりほど荒野に行かせ、わたしたちの神、主に犠牲をささげさせてください。そうしなければ主は疫病か、つるぎをもって、わたしたちを悩まされるからです」。"},{"ref":"Exod.5.4","start":2005004,"end":2005004,"break":"none","ruby":[[5,1,"おう"],[7,1,"かれ"],[10,1,"い"],[33,1,"たみ"],[35,1,"はたら"],[50,2,"じぶん"],[53,2,"ろうえき"]],"text":"エジプトの王は彼らに言った、「モーセとアロンよ、あなたがたは、なぜ民に働きをやめさせようとするのか。自分の労役につくがよい」。"},{"ref":"Exod.5.5","start":2005005,"end":2005005,"break":"none","ruby":[[5,1,"い"],[10,1,"み"],[13,1,"いま"],[15,2,"どみん"],[18,1,"かず"],[20,1,"おお"],[33,1,"かれ"],[36,2,"ろうえき"],[39,1,"やす"]],"text":"パロはまた言った、「見よ、今や土民の数は多い。しかも、あなたがたは彼らに労役を休ませようとするのか」。"},{"ref":"Exod.5.6","start":2005006,"end":2005006,"break":"none","ruby":[[2,1,"ひ"],[7,1,"たみ"],[9,1,"お"],[11,1,"つか"],[13,1,"もの"],[16,1,"たみ"],[24,1,"めい"],[27,1,"い"]],"text":"その日、パロは民を追い使う者と、民のかしらたちに命じて言った、"},{"ref":"Exod.5.7","start":2005007,"end":2005007,"break":"none","ruby":[[12,1,"つく"],[25,1,"いま"],[35,1,"たみ"],[37,1,"あた"],[46,1,"かれ"],[49,2,"じぶん"],[52,1,"い"],[59,1,"あつ"]],"text":"「あなたがたは、れんがを作るためのわらを、もはや、今までのように、この民に与えてはならない。彼らに自分で行って、わらを集めさせなさい。"},{"ref":"Exod.5.8","start":2005008,"end":2005008,"break":"none","ruby":[[2,1,"まえ"],[4,1,"つく"],[14,1,"かず"],[19,1,"かれ"],[22,1,"つく"],[29,1,"へ"],[39,1,"かれ"],[45,1,"もの"],[54,1,"かれ"],[57,1,"さけ"],[62,1,"い"],[71,1,"かみ"],[73,2,"ぎせい"],[84,1,"い"]],"text":"また前に作っていた、れんがの数どおりに彼らに作らせ、それを減らしてはならない。彼らはなまけ者だ。それだから、彼らは叫んで、『行ってわたしたちの神に犠牲をささげさせよ』と言うのだ。"},{"ref":"Exod.5.9","start":2005009,"end":2005009,"break":"none","ruby":[[2,2,"ひとびと"],[5,2,"ろうえき"],[8,1,"おも"],[13,1,"はたら"],[17,1,"いつわ"],[20,2,"ことば"],[23,1,"こころ"],[25,1,"よ"]],"text":"この人々の労役を重くして、働かせ、偽りの言葉に心を寄せさせぬようにしなさい」。"},{"ref":"Exod.5.10","start":2005010,"end":2005010,"break":"paragraph","ruby":[[3,1,"たみ"],[5,1,"お"],[7,1,"つか"],[9,1,"もの"],[14,1,"たみ"],[22,1,"で"],[24,1,"い"],[28,1,"たみ"],[30,1,"い"],[40,1,"おお"],[57,1,"あた"]],"text":"そこで民を追い使う者たちと、民のかしらたちは出て行って、民に言った、「パロはこう仰せられる、『あなたがたに、わらは与えない。"},{"ref":"Exod.5.11","start":2005011,"end":2005011,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"い"],[7,1,"み"],[11,1,"ところ"],[18,1,"と"],[21,1,"く"],[30,1,"はたら"],[33,1,"すこ"],[36,1,"へ"]],"text":"自分で行って、見つかる所から、わらを取って来るがよい。しかし働きは少しも減らしてはならない』と」。"},{"ref":"Exod.5.12","start":2005012,"end":2005012,"break":"none","ruby":[[3,1,"たみ"],[10,1,"ぜん"],[11,1,"ち"],[13,1,"ち"],[25,1,"か"],[27,1,"かぶ"],[29,1,"あつ"]],"text":"そこで民はエジプトの全地に散って、わらのかわりに、刈り株を集めた。"},{"ref":"Exod.5.13","start":2005013,"end":2005013,"break":"none","ruby":[[0,1,"お"],[2,1,"つか"],[4,1,"もの"],[9,1,"かれ"],[14,1,"た"],[17,1,"い"],[28,1,"とき"],[30,1,"おな"],[42,1,"はたら"],[46,1,"ひ"],[50,1,"ぶん"],[52,2,"しあ"]],"text":"追い使う者たちは、彼らをせき立てて言った、「わらがあった時と同じように、あなたがたの働きの、日ごとの分を仕上げなければならない」。"},{"ref":"Exod.5.14","start":2005014,"end":2005014,"break":"none","ruby":[[3,1,"お"],[5,1,"つか"],[7,1,"もの"],[17,2,"ひとびと"],[20,1,"うえ"],[22,1,"た"],[32,1,"う"],[51,1,"つく"],[54,2,"しごと"],[63,1,"まえ"],[68,2,"しあ"],[77,1,"い"]],"text":"パロの追い使う者たちがイスラエルの人々の上に立てたかしらたちは、打たれて、「なぜ、あなたがたは、れんが作りの仕事を、きょうも、前のように仕上げないのか」と言われた。"},{"ref":"Exod.5.15","start":2005015,"end":2005015,"break":"paragraph","ruby":[[10,2,"ひとびと"],[26,1,"い"],[29,1,"さけ"],[32,1,"い"]],"text":"そこで、イスラエルの人々のかしらたちはパロのところに行き、叫んで言った、「あなたはなぜ、しもべどもにこんなことをなさるのですか。"},{"ref":"Exod.5.16","start":2005016,"end":2005016,"break":"none","ruby":[[10,1,"あた"],[19,1,"かれ"],[34,1,"つく"],[38,1,"い"],[46,1,"うえ"],[54,1,"う"],[62,1,"つみ"],[68,1,"たみ"]],"text":"しもべどもは、わらを与えられず、しかも彼らはわたしたちに、『れんがは作れ』と言うのです。その上、しもべどもは打たれています。罪はあなたの民にあるのです」。"},{"ref":"Exod.5.17","start":2005017,"end":2005017,"break":"none","ruby":[[3,1,"い"],[18,1,"もの"],[24,1,"もの"],[34,1,"い"],[38,1,"しゅ"],[40,2,"ぎせい"],[51,1,"い"]],"text":"パロは言った、「あなたがたは、なまけ者だ、なまけ者だ。それだから、『行って、主に犠牲をささげさせよ』と言うのだ。"},{"ref":"Exod.5.18","start":2005018,"end":2005018,"break":"none","ruby":[[3,1,"い"],[6,1,"はたら"],[15,1,"あた"],[29,1,"さだ"],[32,1,"かず"],[38,1,"おさ"]],"text":"さあ、行って働きなさい。わらは与えないが、なおあなたがたは定めた数のれんがを納めなければならない」。"},{"ref":"Exod.5.19","start":2005019,"end":2005019,"break":"none","ruby":[[6,2,"ひとびと"],[21,1,"ひ"],[25,1,"ぶん"],[27,1,"へ"],[38,1,"い"],[45,1,"わる"],[47,2,"じたい"],[56,1,"し"]],"text":"イスラエルの人々のかしらたちは、「れんがの日ごとの分を減らしてはならない」と言われたので、悪い事態になったことを知った。"},{"ref":"Exod.5.20","start":2005020,"end":2005020,"break":"none","ruby":[[0,1,"かれ"],[6,1,"はな"],[9,1,"で"],[13,1,"とき"],[15,1,"かれ"],[18,1,"あ"],[24,1,"た"],[37,1,"あ"]],"text":"彼らがパロを離れて出てきた時、彼らに会おうとして立っていたモーセとアロンに会ったので、"},{"ref":"Exod.5.21","start":2005021,"end":2005021,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[8,1,"しゅ"],[52,2,"けらい"],[66,1,"かれ"],[69,1,"て"],[71,1,"わた"],[75,1,"ころ"]],"text":"彼らに言った、「主があなたがたをごらんになって、さばかれますように。あなたがたは、わたしたちをパロとその家来たちにきらわせ、つるぎを彼らの手に渡して、殺させようとしておられるのです」。"},{"ref":"Exod.5.22","start":2005022,"end":2005022,"break":"paragraph","ruby":[[4,1,"しゅ"],[9,1,"かえ"],[12,1,"い"],[17,1,"しゅ"],[29,1,"たみ"],[34,1,"め"]],"text":"モーセは主のもとに帰って言った、「主よ、あなたは、なぜこの民をひどい目にあわされるのですか。なんのためにわたしをつかわされたのですか。"},{"ref":"Exod.5.23","start":2005023,"end":2005023,"break":"none","ruby":[[10,1,"い"],[18,1,"な"],[23,1,"かた"],[33,1,"かれ"],[37,1,"たみ"],[42,1,"め"],[70,1,"たみ"],[72,1,"すく"]],"text":"わたしがパロのもとに行って、あなたの名によって語ってからこのかた、彼はこの民をひどい目にあわせるばかりです。また、あなたは、すこしもあなたの民を救おうとなさいません」。"}]