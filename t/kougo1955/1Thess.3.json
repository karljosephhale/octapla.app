[{"ref":"1Thess.3.1","start":52003001,"end":52003001,"break":"paragraph","ruby":[[12,2,"いじょう"],[14,1,"た"],[42,1,"さだ"]],"text":"そこで、わたしたちはこれ以上耐えられなくなって、わたしたちだけがアテネに留まることに定め、"},{"ref":"1Thess.3.2","start":52003002,"end":52003002,"break":"none","ruby":[[6,2,"きょうだい"],[15,2,"ふくいん"],[21,1,"かみ"],[23,3,"どうろうしゃ"],[46,2,"しんこう"],[49,1,"つよ"]],"text":"わたしたちの兄弟で、キリストの福音における神の同労者テモテをつかわした。それは、あなたがたの信仰を強め、"},{"ref":"1Thess.3.3","start":52003003,"end":52003003,"break":"none","ruby":[[5,2,"かんなん"],[8,1,"なか"],[14,2,"どうよう"],[18,1,"もの"],[29,1,"はげ"],[45,1,"し"],[60,2,"かんなん"],[63,1,"あ"],[68,1,"さだ"]],"text":"このような患難の中にあって、動揺する者がひとりもないように励ますためであった。あなたがたの知っているとおり、わたしたちは患難に会うように定められているのである。"},{"ref":"1Thess.3.4","start":52003004,"end":52003004,"break":"none","ruby":[[10,1,"ところ"],[26,2,"かんなん"],[29,1,"あ"],[39,1,"い"],[53,1,"し"],[62,1,"いま"]],"text":"そして、あなたがたの所にいたとき、わたしたちがやがて患難に会うことをあらかじめ言っておいたが、あなたがたの知っているように、今そのとおりになったのである。"},{"ref":"1Thess.3.5","start":52003005,"end":52003005,"break":"none","ruby":[[10,2,"いじょう"],[12,1,"た"],[26,1,"こころ"],[29,1,"もの"],[38,1,"こころ"],[52,2,"ろうく"],[66,1,"き"],[78,2,"しんこう"],[81,1,"し"],[87,1,"かれ"]],"text":"そこで、わたしはこれ以上耐えられなくなって、もしや「試みる者」があなたがたを試み、そのためにわたしたちの労苦がむだになりはしないかと気づかって、あなたがたの信仰を知るために、彼をつかわしたのである。"},{"ref":"1Thess.3.6","start":52003006,"end":52003006,"break":"none","ruby":[[4,1,"いま"],[16,1,"ところ"],[28,1,"かえ"],[40,2,"しんこう"],[43,1,"あい"],[49,1,"し"],[74,1,"おぼ"],[89,1,"あ"],[93,1,"おも"],[99,1,"おな"],[115,1,"あ"],[126,2,"きっぽう"]],"text":"ところが今テモテが、あなたがたの所からわたしたちのもとに帰ってきて、あなたがたの信仰と愛とについて知らせ、また、あなたがたがいつもわたしたちのことを覚え、わたしたちがあなたがたに会いたく思っていると同じように、わたしたちにしきりに会いたがっているという吉報をもたらした。"},{"ref":"1Thess.3.7","start":52003007,"end":52003007,"break":"none","ruby":[[0,2,"きょうだい"],[23,2,"くなん"],[26,2,"かんなん"],[30,1,"なか"],[44,2,"しんこう"],[50,1,"なぐさ"]],"text":"兄弟たちよ。それによって、わたしたちはあらゆる苦難と患難との中にありながら、あなたがたの信仰によって慰められた。"},{"ref":"1Thess.3.8","start":52003008,"end":52003008,"break":"none","ruby":[[11,1,"しゅ"],[16,1,"かた"],[18,1,"た"],[35,1,"い"]],"text":"なぜなら、あなたがたが主にあって堅く立ってくれるなら、わたしたちはいま生きることになるからである。"},{"ref":"1Thess.3.9","start":52003009,"end":52003009,"break":"none","ruby":[[12,1,"かみ"],[28,1,"よろこ"],[30,1,"おお"],[33,1,"よろこ"],[43,2,"かんしゃ"],[46,1,"かみ"]],"text":"ほんとうに、わたしたちの神のみまえで、あなたがたのことで喜ぶ大きな喜びのために、どんな感謝を神にささげたらよいだろうか。"},{"ref":"1Thess.3.10","start":52003010,"end":52003010,"break":"none","ruby":[[13,1,"かお"],[15,1,"み"],[23,2,"しんこう"],[26,1,"た"],[34,1,"おぎな"],[40,2,"にちや"],[46,1,"ねが"]],"text":"わたしたちは、あなたがたの顔を見、あなたがたの信仰の足りないところを補いたいと、日夜しきりに願っているのである。"},{"ref":"1Thess.3.11","start":52003011,"end":52003011,"break":"paragraph","ruby":[[10,1,"ちち"],[13,1,"かみ"],[15,2,"じしん"],[25,1,"しゅ"],[42,1,"い"],[44,1,"みち"],[53,1,"ひら"],[56,1,"くだ"]],"text":"どうか、わたしたちの父なる神ご自身と、わたしたちの主イエスとが、あなたがたのところへ行く道を、わたしたちに開いて下さるように。"},{"ref":"1Thess.3.12","start":52003012,"end":52003012,"break":"none","ruby":[[4,1,"しゅ"],[12,2,"そうご"],[15,1,"あい"],[21,1,"ひと"],[23,1,"たい"],[26,1,"あい"],[42,1,"あい"],[45,1,"あい"],[47,1,"おな"],[53,1,"ま"],[55,1,"くわ"],[58,1,"ゆた"],[63,1,"くだ"]],"text":"どうか、主が、あなたがた相互の愛とすべての人に対する愛とを、わたしたちがあなたがたを愛する愛と同じように、増し加えて豊かにして下さるように。"},{"ref":"1Thess.3.13","start":52003013,"end":52003013,"break":"none","ruby":[[14,1,"しゅ"],[26,1,"せい"],[29,1,"もの"],[31,1,"とも"],[37,1,"とき"],[39,1,"かみ"],[52,1,"こころ"],[54,1,"つよ"],[57,1,"きよ"],[60,1,"せ"],[71,1,"もの"],[75,1,"くだ"]],"text":"そして、どうか、わたしたちの主イエスが、そのすべての聖なる者と共にこられる時、神のみまえに、あなたがたの心を強め、清く、責められるところのない者にして下さるように。"}]