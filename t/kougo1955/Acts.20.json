[{"ref":"Acts.20.1","start":44020001,"end":44020001,"break":"paragraph","ruby":[[0,1,"さわ"],[6,1,"のち"],[12,2,"でし"],[17,1,"よ"],[19,1,"あつ"],[22,2,"げきれい"],[25,1,"あた"],[28,1,"うえ"],[30,1,"わか"],[38,1,"の"],[47,1,"む"],[51,2,"しゅっぱつ"]],"text":"騒ぎがやんだ後、パウロは弟子たちを呼び集めて激励を与えた上、別れのあいさつを述べ、マケドニヤへ向かって出発した。"},{"ref":"Acts.20.2","start":44020002,"end":44020002,"break":"none","ruby":[[6,2,"ちほう"],[13,1,"おお"],[16,2,"ことば"],[19,2,"ひとびと"],[22,1,"はげ"]],"text":"そして、その地方をとおり、多くの言葉で人々を励ましたのち、ギリシヤにきた。"},{"ref":"Acts.20.3","start":44020003,"end":44020003,"break":"none","ruby":[[0,1,"かれ"],[7,1,"げつ"],[9,1,"す"],[22,1,"む"],[27,2,"ふなで"],[37,2,"やさき"],[40,1,"かれ"],[42,1,"たい"],[48,1,"じん"],[50,2,"いんぼう"],[53,1,"おこ"],[65,2,"けいゆ"],[69,1,"かえ"],[74,1,"けっ"]],"text":"彼はそこで三か月を過ごした。それからシリヤへ向かって、船出しようとしていた矢先、彼に対するユダヤ人の陰謀が起ったので、マケドニヤを経由して帰ることに決した。"},{"ref":"Acts.20.4","start":44020004,"end":44020004,"break":"none","ruby":[[3,1,"こ"],[10,1,"びと"],[21,1,"びと"],[37,1,"びと"],[55,1,"びと"],[69,3,"どうこうしゃ"]],"text":"プロの子であるエペソ人ソパテロ、テサロニケ人アリスタルコとセクンド、デルベ人ガイオ、それからテモテ、またアジヤ人テキコとトロピモがパウロの同行者であった。"},{"ref":"Acts.20.5","start":44020005,"end":44020005,"break":"none","ruby":[[2,1,"ひと"],[6,1,"せん"],[7,1,"ぱつ"],[22,1,"ま"]],"text":"この人たちは先発して、トロアスでわたしたちを待っていた。"},{"ref":"Acts.20.6","start":44020006,"end":44020006,"break":"none","ruby":[[7,3,"じょこうさい"],[11,1,"おわ"],[23,2,"しゅっぱん"],[28,1,"か"],[38,2,"とうちゃく"],[43,1,"かれ"],[46,1,"お"],[48,1,"あ"],[54,3,"なぬかかん"],[57,2,"たいざい"]],"text":"わたしたちは、除酵祭が終ったのちに、ピリピから出帆し、五日かかってトロアスに到着して、彼らと落ち合い、そこに七日間滞在した。"},{"ref":"Acts.20.7","start":44020007,"end":44020007,"break":"paragraph","ruby":[[0,1,"しゅう"],[2,1,"はじ"],[5,1,"ひ"],[22,1,"あつ"],[26,1,"とき"],[32,2,"よくじつ"],[34,2,"しゅっぱつ"],[52,2,"ひとびと"],[55,1,"かた"],[57,1,"あ"],[60,2,"よなか"],[64,1,"かた"]],"text":"週の初めの日に、わたしたちがパンをさくために集まった時、パウロは翌日出発することにしていたので、しきりに人々と語り合い、夜中まで語りつづけた。"},{"ref":"Acts.20.8","start":44020008,"end":44020008,"break":"none","ruby":[[6,1,"あつ"],[12,2,"おくじょう"],[15,1,"ま"]],"text":"わたしたちが集まっていた屋上の間には、あかりがたくさんともしてあった。"},{"ref":"Acts.20.9","start":44020009,"end":44020009,"break":"none","ruby":[[6,2,"わかもの"],[9,1,"まど"],[11,1,"こし"],[26,1,"はなし"],[33,1,"つづ"],[41,1,"ねむ"],[58,2,"ねい"],[67,1,"かい"],[70,1,"した"],[72,1,"お"],[76,1,"いだ"],[78,1,"おこ"],[87,1,"し"]],"text":"ユテコという若者が窓に腰をかけていたところ、パウロの話がながながと続くので、ひどく眠けがさしてきて、とうとうぐっすり寝入ってしまい、三階から下に落ちた。抱き起してみたら、もう死んでいた。"},{"ref":"Acts.20.10","start":44020010,"end":44020010,"break":"none","ruby":[[7,1,"お"],[13,2,"わかもの"],[16,1,"うえ"],[18,1,"み"],[24,1,"かれ"],[26,1,"いだ"],[33,1,"さわ"],[43,1,"いのち"],[49,1,"い"]],"text":"そこでパウロは降りてきて、若者の上に身をかがめ、彼を抱きあげて、「騒ぐことはない。まだ命がある」と言った。"},{"ref":"Acts.20.11","start":44020011,"end":44020011,"break":"none","ruby":[[6,1,"あ"],[10,1,"い"],[20,1,"た"],[26,1,"あ"],[32,1,"なが"],[37,2,"ひとびと"],[40,1,"かた"],[42,1,"あ"],[49,2,"しゅっぱつ"]],"text":"そして、また上がって行って、パンをさいて食べてから、明けがたまで長いあいだ人々と語り合って、ついに出発した。"},{"ref":"Acts.20.12","start":44020012,"end":44020012,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"い"],[9,2,"わかもの"],[12,1,"つ"],[25,1,"なぐさ"]],"text":"人々は生きかえった若者を連れかえり、ひとかたならず慰められた。"},{"ref":"Acts.20.13","start":44020013,"end":44020013,"break":"paragraph","ruby":[[9,1,"さき"],[11,1,"ふね"],[13,1,"の"],[15,1,"こ"],[22,1,"む"],[26,2,"しゅっぱん"],[39,1,"ふね"],[41,1,"の"],[44,1,"い"],[54,1,"かれ"],[58,2,"りくろ"],[66,1,"き"]],"text":"さて、わたしたちは先に舟に乗り込み、アソスへ向かって出帆した。そこからパウロを舟に乗せて行くことにしていた。彼だけは陸路をとることに決めていたからである。"},{"ref":"Acts.20.14","start":44020014,"end":44020014,"break":"none","ruby":[[15,1,"お"],[17,1,"あ"],[20,1,"とき"],[28,1,"かれ"],[30,1,"ふね"],[32,1,"の"],[40,1,"い"]],"text":"パウロがアソスで、わたしたちと落ち合った時、わたしたちは彼を舟に乗せてミテレネに行った。"},{"ref":"Acts.20.15","start":44020015,"end":44020015,"break":"none","ruby":[[4,2,"しゅっぱん"],[9,2,"よくじつ"],[15,2,"おきあい"],[22,1,"つぎ"],[24,1,"ひ"],[30,1,"よ"],[35,2,"よくじつ"],[41,1,"つ"]],"text":"そこから出帆して、翌日キヨスの沖合にいたり、次の日にサモスに寄り、その翌日ミレトに着いた。"},{"ref":"Acts.20.16","start":44020016,"end":44020016,"break":"none","ruby":[[12,2,"じかん"],[28,1,"よ"],[33,1,"ぞっ"],[34,1,"こう"],[40,1,"き"],[51,1,"かれ"],[65,1,"ひ"],[75,1,"つ"],[86,1,"たび"],[88,1,"いそ"]],"text":"それは、パウロがアジヤで時間をとられないため、エペソには寄らないで続航することに決めていたからである。彼は、できればペンテコステの日には、エルサレムに着いていたかったので、旅を急いだわけである。"},{"ref":"Acts.20.17","start":44020017,"end":44020017,"break":"paragraph","ruby":[[17,1,"つかい"],[23,2,"きょうかい"],[26,2,"ちょうろう"],[31,1,"よ"],[33,1,"よ"]],"text":"そこでパウロは、ミレトからエペソに使をやって、教会の長老たちを呼び寄せた。"},{"ref":"Acts.20.18","start":44020018,"end":44020018,"break":"none","breaks":[[27,"paragraph"]],"ruby":[[4,1,"かれ"],[10,1,"よ"],[12,1,"あつ"],[18,1,"とき"],[20,1,"かれ"],[23,1,"い"],[37,1,"ち"],[39,1,"あし"],[41,1,"ふ"],[43,1,"い"],[46,2,"さいしょ"],[49,1,"ひ"],[50,2,"いらい"],[68,1,"す"],[79,1,"ぞん"]],"text":"そして、彼のところに寄り集まってきた時、彼らに言った。「わたしが、アジヤの地に足を踏み入れた最初の日以来、いつもあなたがたとどんなふうに過ごしてきたか、よくご存じである。"},{"ref":"Acts.20.19","start":44020019,"end":44020019,"break":"none","ruby":[[5,2,"けんそん"],[8,1,"かぎ"],[15,1,"なみだ"],[17,1,"なが"],[23,1,"じん"],[25,2,"いんぼう"],[35,1,"み"],[37,1,"およ"],[40,2,"かずかず"],[43,2,"しれん"],[46,1,"なか"],[52,1,"しゅ"],[54,1,"つか"]],"text":"すなわち、謙遜の限りをつくし、涙を流し、ユダヤ人の陰謀によってわたしの身に及んだ数々の試練の中にあって、主に仕えてきた。"},{"ref":"Acts.20.20","start":44020020,"end":44020020,"break":"none","ruby":[[9,1,"えき"],[17,2,"こうしゅう"],[20,1,"まえ"],[26,2,"いえいえ"],[42,1,"はな"],[45,1,"き"],[51,1,"おし"]],"text":"また、あなたがたの益になることは、公衆の前でも、また家々でも、すべてあますところなく話して聞かせ、また教え、"},{"ref":"Acts.20.21","start":44020021,"end":44020021,"break":"none","ruby":[[3,1,"じん"],[10,1,"じん"],[14,1,"かみ"],[16,1,"たい"],[19,2,"くいあらた"],[30,1,"しゅ"],[35,1,"たい"],[38,2,"しんこう"],[43,1,"つよ"],[45,1,"すす"]],"text":"ユダヤ人にもギリシヤ人にも、神に対する悔改めと、わたしたちの主イエスに対する信仰とを、強く勧めてきたのである。"},{"ref":"Acts.20.22","start":44020022,"end":44020022,"break":"none","ruby":[[0,1,"いま"],[7,2,"みたま"],[10,1,"せま"],[20,1,"い"],[25,1,"みやこ"],[31,1,"こと"],[37,1,"み"],[45,1,"く"]],"text":"今や、わたしは御霊に迫られてエルサレムへ行く。あの都で、どんな事がわたしの身にふりかかって来るか、わたしにはわからない。"},{"ref":"Acts.20.23","start":44020023,"end":44020023,"break":"none","ruby":[[3,2,"せいれい"],[6,1,"いた"],[12,2,"まちまち"],[24,1,"つ"],[32,2,"とうごく"],[35,2,"かんなん"],[44,1,"ま"]],"text":"ただ、聖霊が至るところの町々で、わたしにはっきり告げているのは、投獄と患難とが、わたしを待ちうけているということだ。"},{"ref":"Acts.20.24","start":44020024,"end":44020024,"break":"none","ruby":[[8,2,"じぶん"],[11,2,"こうてい"],[14,1,"はし"],[16,1,"お"],[19,1,"しゅ"],[25,1,"たま"],[30,1,"かみ"],[36,2,"ふくいん"],[44,2,"にんむ"],[47,1,"はた"],[49,1,"え"],[62,2,"じぶん"],[69,1,"すこ"],[72,1,"お"],[77,1,"おも"]],"text":"しかし、わたしは自分の行程を走り終え、主イエスから賜わった、神のめぐみの福音をあかしする任務を果し得さえしたら、このいのちは自分にとって、少しも惜しいとは思わない。"},{"ref":"Acts.20.25","start":44020025,"end":44020025,"break":"none","ruby":[[6,1,"しん"],[18,1,"あいだ"],[20,1,"ある"],[22,1,"まわ"],[25,2,"みくに"],[28,1,"の"],[30,1,"つた"],[39,1,"かお"],[46,2,"こんご"],[49,1,"ど"],[51,1,"み"]],"text":"わたしはいま信じている、あなたがたの間を歩き回って御国を宣べ伝えたこのわたしの顔を、みんなが今後二度と見ることはあるまい。"},{"ref":"Acts.20.26","start":44020026,"end":44020026,"break":"none","ruby":[[10,1,"ひ"],[18,2,"だんげん"],[34,1,"ひと"],[36,1,"ち"],[45,2,"せきにん"]],"text":"だから、きょう、この日にあなたがたに断言しておく。わたしは、すべての人の血について、なんら責任がない。"},{"ref":"Acts.20.27","start":44020027,"end":44020027,"break":"none","ruby":[[0,1,"かみ"],[3,1,"むね"],[5,1,"みな"],[21,1,"つた"]],"text":"神のみ旨を皆あますところなく、あなたがたに伝えておいたからである。"},{"ref":"Acts.20.28","start":44020028,"end":44020028,"break":"none","ruby":[[9,2,"じしん"],[12,1,"き"],[24,1,"む"],[27,1,"き"],[40,2,"せいれい"],[44,1,"かみ"],[46,2,"みこ"],[49,1,"ち"],[55,1,"と"],[59,1,"かみ"],[61,2,"きょうかい"],[64,1,"ぼく"],[80,1,"む"],[83,3,"かんとくしゃ"],[88,1,"た"]],"text":"どうか、あなたがた自身に気をつけ、また、すべての群れに気をくばっていただきたい。聖霊は、神が御子の血であがない取られた神の教会を牧させるために、あなたがたをその群れの監督者にお立てになったのである。"},{"ref":"Acts.20.29","start":44020029,"end":44020029,"break":"none","ruby":[[4,1,"さ"],[7,1,"のち"],[9,2,"きょうぼう"],[24,1,"なか"],[29,1,"こ"],[35,2,"ようしゃ"],[39,1,"む"],[42,1,"あら"],[57,1,"し"]],"text":"わたしが去った後、狂暴なおおかみが、あなたがたの中にはいり込んできて、容赦なく群れを荒すようになることを、わたしは知っている。"},{"ref":"Acts.20.30","start":44020030,"end":44020030,"break":"none","ruby":[[8,2,"じしん"],[11,1,"なか"],[20,1,"まが"],[26,1,"い"],[30,2,"でし"],[35,2,"じぶん"],[38,1,"ほう"],[45,1,"こ"],[51,1,"もの"],[54,1,"おこ"]],"text":"また、あなたがた自身の中からも、いろいろ曲ったことを言って、弟子たちを自分の方に、ひっぱり込もうとする者らが起るであろう。"},{"ref":"Acts.20.31","start":44020031,"end":44020031,"break":"none","ruby":[[4,1,"め"],[24,1,"ねん"],[26,1,"あいだ"],[28,1,"よる"],[30,1,"ひる"],[32,1,"なみだ"],[50,1,"た"],[63,1,"わす"]],"text":"だから、目をさましていなさい。そして、わたしが三年の間、夜も昼も涙をもって、あなたがたひとりびとりを絶えずさとしてきたことを、忘れないでほしい。"},{"ref":"Acts.20.32","start":44020032,"end":44020032,"break":"none","ruby":[[0,1,"いま"],[6,1,"しゅ"],[10,1,"めぐ"],[13,1,"ことば"],[28,2,"みことば"],[39,1,"とく"],[44,1,"せい"],[45,1,"べつ"],[53,2,"ひとびと"],[56,1,"とも"],[59,2,"みくに"],[66,1,"ちから"]],"text":"今わたしは、主とその恵みの言とに、あなたがたをゆだねる。御言には、あなたがたの徳をたて、聖別されたすべての人々と共に、御国をつがせる力がある。"},{"ref":"Acts.20.33","start":44020033,"end":44020033,"break":"none","ruby":[[5,1,"ひと"],[7,1,"きん"],[9,1,"ぎん"],[11,2,"いふく"]],"text":"わたしは、人の金や銀や衣服をほしがったことはない。"},{"ref":"Acts.20.34","start":44020034,"end":44020034,"break":"none","ruby":[[5,2,"じしん"],[8,1,"し"],[23,2,"りょうて"],[27,2,"じぶん"],[30,2,"せいかつ"],[40,2,"いっしょ"],[45,1,"ひと"],[54,1,"はたら"]],"text":"あなたがた自身が知っているとおり、わたしのこの両手は、自分の生活のためにも、また一緒にいた人たちのためにも、働いてきたのだ。"},{"ref":"Acts.20.35","start":44020035,"end":44020035,"break":"none","ruby":[[16,1,"はたら"],[20,1,"よわ"],[22,1,"もの"],[24,1,"たす"],[40,1,"う"],[46,1,"あた"],[49,1,"ほう"],[61,1,"い"],[65,1,"しゅ"],[70,2,"ことば"],[73,2,"きおく"],[85,2,"ばんじ"],[91,1,"おし"],[93,1,"しめ"]],"text":"わたしは、あなたがたもこのように働いて、弱い者を助けなければならないこと、また『受けるよりは与える方が、さいわいである』と言われた主イエスの言葉を記憶しているべきことを、万事について教え示したのである」。"},{"ref":"Acts.20.36","start":44020036,"end":44020036,"break":"paragraph","ruby":[[2,1,"い"],[10,2,"いちどう"],[13,1,"とも"],[21,1,"いの"]],"text":"こう言って、パウロは一同と共にひざまずいて祈った。"},{"ref":"Acts.20.37","start":44020037,"end":44020037,"break":"none","ruby":[[4,1,"もの"],[11,1,"な"],[13,1,"かな"],[21,1,"くび"],[23,1,"いだ"],[27,2,"いくど"],[30,2,"せっぷん"]],"text":"みんなの者は、はげしく泣き悲しみ、パウロの首を抱いて、幾度も接吻し、"},{"ref":"Acts.20.38","start":44020038,"end":44020038,"break":"none","ruby":[[3,1,"ど"],[5,2,"じぶん"],[8,1,"かお"],[10,1,"み"],[20,1,"かれ"],[22,1,"い"],[28,1,"とく"],[30,1,"こころ"],[32,1,"いた"],[40,1,"かれ"],[42,1,"ふね"],[45,2,"みおく"]],"text":"もう二度と自分の顔を見ることはあるまいと彼が言ったので、特に心を痛めた。それから彼を舟まで見送った。"}]