[{"ref":"Ps.119.1","start":19119001,"end":19119001,"break":"paragraph","title":"アレフ","breaks":[[10,"line"]],"ruby":[[3,1,"みち"],[5,1,"まった"],[10,1,"しゅ"],[16,1,"あゆ"],[18,1,"もの"]],"text":"おのが道を全くして、主のおきてに歩む者はさいわいです。"},{"ref":"Ps.119.2","start":19119002,"end":19119002,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"まも"],[13,1,"こころ"],[19,1,"しゅ"],[21,1,"たず"],[23,1,"もと"]],"text":"主のもろもろのあかしを守り心をつくして主を尋ね求め、"},{"ref":"Ps.119.3","start":19119003,"end":19119003,"break":"line","ruby":[[2,1,"あく"],[4,1,"おこな"],[8,1,"しゅ"],[10,1,"みち"],[12,1,"あゆ"],[14,1,"もの"]],"text":"また悪を行わず、主の道に歩む者はさいわいです。"},{"ref":"Ps.119.4","start":19119004,"end":19119004,"break":"line","ruby":[[8,1,"めい"],[17,1,"まも"]],"text":"あなたはさとしを命じて、ねんごろに守らせられます。"},{"ref":"Ps.119.5","start":19119005,"end":19119005,"break":"line","breaks":[[14,"line"]],"ruby":[[7,1,"みち"],[9,1,"かた"],[18,1,"さだ"],[21,1,"まも"]],"text":"どうかわたしの道を堅くして、あなたの定めを守らせてください。"},{"ref":"Ps.119.6","start":19119006,"end":19119006,"break":"line","breaks":[[24,"line"]],"ruby":[[14,1,"いまし"],[17,1,"め"],[22,1,"とき"],[24,1,"は"]],"text":"わたしは、あなたのもろもろの戒めに目をとめる時、恥じることはありません。"},{"ref":"Ps.119.7","start":19119007,"end":19119007,"break":"line","breaks":[[21,"line"]],"ruby":[[9,1,"ただ"],[16,1,"まな"],[21,1,"ただ"],[24,1,"こころ"],[33,2,"かんしゃ"]],"text":"わたしは、あなたの正しいおきてを学ぶとき、正しい心をもってあなたに感謝します。"},{"ref":"Ps.119.8","start":19119008,"end":19119008,"break":"line","breaks":[[16,"line"]],"ruby":[[8,1,"さだ"],[11,1,"まも"],[20,1,"まった"],[23,1,"す"]],"text":"わたしはあなたの定めを守ります。わたしを全くお捨てにならないでください。"},{"ref":"Ps.119.9","start":19119009,"end":19119009,"break":"paragraph","title":"ベス","breaks":[[13,"line"],[29,"line"],[39,"line"]],"ruby":[[0,1,"わか"],[2,1,"ひと"],[11,1,"みち"],[13,1,"きよ"],[15,1,"たも"],[30,2,"ことば"],[42,1,"まも"]],"text":"若い人はどうしておのが道を清く保つことができるでしょうか。み言葉にしたがって、それを守るよりほかにありません。"},{"ref":"Ps.119.10","start":19119010,"end":19119010,"break":"line","breaks":[[21,"line"],[33,"line"]],"ruby":[[4,1,"こころ"],[14,1,"たず"],[16,1,"もと"],[29,1,"いまし"],[33,1,"まよ"],[35,1,"だ"]],"text":"わたしは心をつくしてあなたを尋ね求めます。わたしをあなたの戒めから迷い出させないでください。"},{"ref":"Ps.119.11","start":19119011,"end":19119011,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[12,1,"つみ"],[14,1,"おか"],[25,1,"こころ"],[31,2,"ことば"]],"text":"わたしはあなたにむかって罪を犯すことのないように、心のうちにみ言葉をたくわえました。"},{"ref":"Ps.119.12","start":19119012,"end":19119012,"break":"line","breaks":[[14,"line"]],"ruby":[[11,1,"しゅ"],[18,1,"さだ"],[25,1,"おし"]],"text":"あなたはほむべきかな、主よ、あなたの定めをわたしに教えてください。"},{"ref":"Ps.119.13","start":19119013,"end":19119013,"break":"line","breaks":[[13,"line"],[22,"line"]],"ruby":[[17,1,"くち"],[20,1,"で"],[31,1,"い"]],"text":"わたしはくちびるをもって、あなたの口から出るもろもろのおきてを言いあらわします。"},{"ref":"Ps.119.14","start":19119014,"end":19119014,"break":"line","breaks":[[20,"line"]],"ruby":[[14,1,"よろこ"],[28,1,"みち"],[30,1,"よろこ"]],"text":"わたしは、もろもろのたからを喜ぶように、あなたのあかしの道を喜びます。"},{"ref":"Ps.119.15","start":19119015,"end":19119015,"break":"line","breaks":[[16,"line"]],"ruby":[[13,1,"おも"],[20,1,"みち"],[22,1,"め"]],"text":"わたしは、あなたのさとしを思い、あなたの道に目をとめます。"},{"ref":"Ps.119.16","start":19119016,"end":19119016,"break":"line","breaks":[[14,"line"]],"ruby":[[8,1,"さだ"],[11,1,"よろこ"],[19,2,"ことば"],[22,1,"わす"]],"text":"わたしはあなたの定めを喜び、あなたのみ言葉を忘れません。"},{"ref":"Ps.119.17","start":19119017,"end":19119017,"break":"paragraph","title":"ギメル","breaks":[[17,"line"],[26,"line"]],"ruby":[[8,1,"ゆた"],[17,1,"い"],[27,2,"ことば"],[30,1,"まも"]],"text":"あなたのしもべを豊かにあしらって、生きながらえさせ、み言葉を守らせてください。"},{"ref":"Ps.119.18","start":19119018,"end":19119018,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"め"],[6,1,"ひら"],[25,1,"こと"],[27,1,"み"]],"text":"わたしの目を開いて、あなたのおきてのうちのくすしき事を見させてください。"},{"ref":"Ps.119.19","start":19119019,"end":19119019,"break":"line","breaks":[[18,"line"]],"ruby":[[6,1,"ち"],[12,3,"きりゅうしゃ"],[22,1,"いまし"],[29,1,"かく"]],"text":"わたしはこの地にあっては寄留者です。あなたの戒めをわたしに隠さないでください。"},{"ref":"Ps.119.20","start":19119020,"end":19119020,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"たましい"],[15,1,"した"],[19,1,"た"]],"text":"わが魂はつねにあなたのおきてを慕って、絶えいるばかりです。"},{"ref":"Ps.119.21","start":19119021,"end":19119021,"break":"line","breaks":[[17,"line"]],"ruby":[[9,1,"いまし"],[13,1,"まよ"],[15,1,"で"],[17,1,"たか"],[20,1,"もの"],[27,1,"もの"],[29,1,"せ"]],"text":"あなたは、あなたの戒めから迷い出る高ぶる者、のろわれた者を責められます。"},{"ref":"Ps.119.22","start":19119022,"end":19119022,"break":"line","breaks":[[18,"line"],[29,"line"]],"ruby":[[12,1,"まも"],[18,1,"かれ"],[25,1,"あなど"],[34,1,"と"],[36,1,"さ"]],"text":"わたしはあなたのあかしを守りました。彼らのそしりと侮りとをわたしから取り去ってください。"},{"ref":"Ps.119.23","start":19119023,"end":19119023,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[8,1,"きみ"],[10,1,"ざ"],[24,1,"はか"],[42,1,"さだ"],[45,1,"ふか"],[47,1,"おも"]],"text":"たといもろもろの君が座して、わたしをそこなおうと図っても、あなたのしもべは、あなたの定めを深く思います。"},{"ref":"Ps.119.24","start":19119024,"end":19119024,"break":"line","breaks":[[17,"line"]],"ruby":[[13,1,"よろこ"],[21,1,"おし"]],"text":"あなたのあかしは、わたしを喜ばせ、わたしを教えさとすものです。"},{"ref":"Ps.119.25","start":19119025,"end":19119025,"break":"paragraph","title":"ダレス","breaks":[[14,"line"]],"ruby":[[2,1,"たましい"],[15,2,"ことば"],[18,1,"したが"],[26,1,"い"],[28,1,"かえ"]],"text":"わが魂はちりについています。み言葉に従って、わたしを生き返らせてください。"},{"ref":"Ps.119.26","start":19119026,"end":19119026,"break":"line","breaks":[[18,"line"],[34,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"あゆ"],[10,1,"みち"],[12,1,"かた"],[26,1,"こた"],[38,1,"さだ"],[45,1,"おし"]],"text":"わたしが自分の歩んだ道を語ったとき、あなたはわたしに答えられました。あなたの定めをわたしに教えてください。"},{"ref":"Ps.119.27","start":19119027,"end":19119027,"break":"line","breaks":[[10,"line"],[26,"line"]],"ruby":[[8,1,"みち"],[42,1,"ふか"],[44,1,"おも"]],"text":"あなたのさとしの道をわたしにわきまえさせてください。わたしはあなたのくすしきみわざを深く思います。"},{"ref":"Ps.119.28","start":19119028,"end":19119028,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"たましい"],[4,1,"かな"],[11,1,"と"],[13,1,"さ"],[19,2,"ことば"],[22,1,"したが"],[30,1,"つよ"]],"text":"わが魂は悲しみによって溶け去ります。み言葉に従って、わたしを強くしてください。"},{"ref":"Ps.119.29","start":19119029,"end":19119029,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"いつわ"],[3,1,"みち"],[10,1,"とお"],[27,1,"おし"]],"text":"偽りの道をわたしから遠ざけ、あなたのおきてをねんごろに教えてください。"},{"ref":"Ps.119.30","start":19119030,"end":19119030,"break":"line","breaks":[[12,"line"]],"ruby":[[4,2,"しんじつ"],[7,1,"みち"],[9,1,"えら"],[24,1,"まえ"],[26,1,"お"]],"text":"わたしは真実の道を選び、あなたのおきてをわたしの前に置きました。"},{"ref":"Ps.119.31","start":19119031,"end":19119031,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[15,1,"かた"],[17,1,"したが"],[24,1,"ねが"]],"text":"主よ、わたしはあなたのあかしに堅く従っています。願わくは、わたしをはずかしめないでください。"},{"ref":"Ps.119.32","start":19119032,"end":19119032,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"こころ"],[10,1,"ひろ"],[26,1,"いまし"],[29,1,"みち"],[31,1,"はし"]],"text":"あなたがわたしの心を広くされるとき、わたしはあなたの戒めの道を走ります。"},{"ref":"Ps.119.33","start":19119033,"end":19119033,"break":"paragraph","title":"ヘ","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"さだ"],[10,1,"みち"],[16,1,"おし"],[28,1,"おわ"],[35,1,"まも"]],"text":"主よ、あなたの定めの道をわたしに教えてください。わたしは終りまでこれを守ります。"},{"ref":"Ps.119.34","start":19119034,"end":19119034,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[4,2,"ちえ"],[7,1,"あた"],[27,1,"まも"],[30,1,"こころ"],[39,1,"したが"]],"text":"わたしに知恵を与えてください。わたしはあなたのおきてを守り、心をつくしてこれに従います。"},{"ref":"Ps.119.35","start":19119035,"end":19119035,"break":"line","breaks":[[21,"line"]],"ruby":[[8,1,"いまし"],[11,1,"みち"],[13,1,"みちび"],[28,1,"よろこ"]],"text":"わたしをあなたの戒めの道に導いてください。わたしはそれを喜ぶからです。"},{"ref":"Ps.119.36","start":19119036,"end":19119036,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"こころ"],[14,1,"かたむ"],[19,2,"ふせい"],[22,2,"りとく"],[25,1,"かたむ"]],"text":"わたしの心をあなたのあかしに傾けさせ、不正な利得に傾けさせないでください。"},{"ref":"Ps.119.37","start":19119037,"end":19119037,"break":"line","breaks":[[25,"line"]],"ruby":[[4,1,"め"],[20,1,"み"],[29,1,"みち"],[39,1,"い"]],"text":"わたしの目をほかにむけて、むなしいものを見させず、あなたの道をもって、わたしを生かしてください。"},{"ref":"Ps.119.38","start":19119038,"end":19119038,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"おそ"],[7,1,"もの"],[13,2,"やくそく"],[24,1,"かた"]],"text":"あなたを恐れる者にかかわる約束をあなたのしもべに堅くしてください。"},{"ref":"Ps.119.39","start":19119039,"end":19119039,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"おそ"],[11,1,"のぞ"],[27,1,"ただ"]],"text":"わたしの恐れるそしりを除いてください。あなたのおきては正しいからです。"},{"ref":"Ps.119.40","start":19119040,"end":19119040,"break":"line","breaks":[[20,"line"],[30,"line"]],"ruby":[[0,1,"み"],[15,1,"した"],[24,1,"ぎ"],[34,1,"い"]],"text":"見よ、わたしはあなたのさとしを慕います。あなたの義をもって、わたしを生かしてください。"},{"ref":"Ps.119.41","start":19119041,"end":19119041,"break":"paragraph","title":"ワウ","breaks":[[16,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"やくそく"],[31,1,"すくい"],[37,1,"のぞ"]],"text":"主よ、あなたの約束にしたがって、あなたのいつくしみと、あなたの救をわたしに臨ませてください。"},{"ref":"Ps.119.42","start":19119042,"end":19119042,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[13,1,"もの"],[16,1,"こた"],[36,2,"ことば"],[39,2,"しんらい"]],"text":"そうすれば、わたしをそしる者に、答えることができます。わたしはあなたのみ言葉に信頼するからです。"},{"ref":"Ps.119.43","start":19119043,"end":19119043,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[6,1,"くち"],[9,2,"しんり"],[12,2,"ことば"],[20,1,"のぞ"],[34,1,"のぞ"]],"text":"またわたしの口から真理の言葉をことごとく除かないでください。わたしの望みはあなたのおきてにあるからです。"},{"ref":"Ps.119.44","start":19119044,"end":19119044,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"た"],[22,1,"まも"]],"text":"わたしは絶えず、とこしえに、あなたのおきてを守ります。"},{"ref":"Ps.119.45","start":19119045,"end":19119045,"break":"line","breaks":[[18,"line"]],"ruby":[[12,1,"もと"],[18,2,"じゆう"],[21,1,"あゆ"]],"text":"わたしはあなたのさとしを求めたので、自由に歩むことができます。"},{"ref":"Ps.119.46","start":19119046,"end":19119046,"break":"line","breaks":[[12,"line"]],"ruby":[[6,1,"おう"],[10,1,"まえ"],[20,1,"かた"],[23,1,"は"]],"text":"わたしはまた王たちの前にあなたのあかしを語って恥じることはありません。"},{"ref":"Ps.119.47","start":19119047,"end":19119047,"break":"line","breaks":[[19,"line"]],"ruby":[[9,1,"あい"],[16,1,"いまし"],[19,2,"じぶん"],[22,1,"よろこ"],[25,1,"み"]],"text":"わたしは、わたしの愛するあなたの戒めに自分の喜びを見いだすからです。"},{"ref":"Ps.119.48","start":19119048,"end":19119048,"break":"line","breaks":[[22,"line"]],"ruby":[[9,1,"あい"],[16,1,"いまし"],[19,1,"たっと"],[26,1,"さだ"],[29,1,"ふか"],[31,1,"おも"]],"text":"わたしは、わたしの愛するあなたの戒めを尊び、あなたの定めを深く思います。"},{"ref":"Ps.119.49","start":19119049,"end":19119049,"break":"paragraph","title":"ザイン","breaks":[[16,"line"],[30,"line"]],"ruby":[[12,1,"い"],[17,2,"ことば"],[20,1,"おも"],[22,1,"だ"],[41,1,"のぞ"]],"text":"どうか、あなたのしもべに言われたみ言葉を思い出してください。あなたはわたしにそれを望ませられました。"},{"ref":"Ps.119.50","start":19119050,"end":19119050,"break":"line","breaks":[[17,"line"]],"ruby":[[4,2,"やくそく"],[11,1,"い"],[19,1,"なや"],[22,1,"とき"],[24,1,"なぐさ"]],"text":"あなたの約束はわたしを生かすので、わが悩みの時の慰めです。"},{"ref":"Ps.119.51","start":19119051,"end":19119051,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"たか"],[3,1,"もの"],[5,1,"おお"],[14,1,"わら"],[34,1,"はな"]],"text":"高ぶる者は大いにわたしをあざ笑います。しかしわたしはあなたのおきてを離れません。"},{"ref":"Ps.119.52","start":19119052,"end":19119052,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"むかし"],[19,1,"おも"],[21,1,"だ"],[29,1,"なぐさ"]],"text":"主よ、わたしはあなたの昔からのおきてを思い出して、みずから慰めます。"},{"ref":"Ps.119.53","start":19119053,"end":19119053,"break":"line","breaks":[[20,"line"]],"ruby":[[8,1,"す"],[11,1,"あ"],[14,1,"もの"],[24,1,"はげ"],[27,1,"いきどお"],[30,1,"おこ"]],"text":"あなたのおきてを捨てる悪しき者のゆえに、わたしは激しい憤りを起します。"},{"ref":"Ps.119.54","start":19119054,"end":19119054,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"さだ"],[9,1,"たび"],[11,1,"いえ"],[18,1,"うた"]],"text":"あなたの定めはわが旅の家で、わたしの歌となりました。"},{"ref":"Ps.119.55","start":19119055,"end":19119055,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"よ"],[9,1,"ま"],[16,1,"な"],[18,1,"おも"],[20,1,"だ"],[32,1,"まも"]],"text":"主よ、わたしは夜の間にあなたのみ名を思い出して、あなたのおきてを守ります。"},{"ref":"Ps.119.56","start":19119056,"end":19119056,"break":"line","breaks":[[22,"line"]],"ruby":[[12,1,"まも"],[24,2,"しゅくふく"],[31,1,"のぞ"]],"text":"わたしはあなたのさとしを守ったことによって、この祝福がわたしに臨みました。"},{"ref":"Ps.119.57","start":19119057,"end":19119057,"break":"paragraph","title":"ヘス","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"う"],[10,1,"ぶん"],[23,2,"ことば"],[26,1,"まも"],[31,2,"やくそく"]],"text":"主はわたしの受くべき分です。わたしはあなたのみ言葉を守ることを約束します。"},{"ref":"Ps.119.58","start":19119058,"end":19119058,"break":"line","breaks":[[25,"line"],[38,"line"]],"ruby":[[4,1,"こころ"],[15,1,"めぐ"],[18,1,"こ"],[20,1,"もと"],[29,2,"やくそく"],[43,1,"めぐ"]],"text":"わたしは心をつくして、あなたの恵みを請い求めます。あなたの約束にしたがって、わたしをお恵みください。"},{"ref":"Ps.119.59","start":19119059,"end":19119059,"break":"line","breaks":[[16,"line"]],"ruby":[[9,1,"みち"],[11,1,"おも"],[16,1,"あし"],[31,1,"む"]],"text":"わたしは、あなたの道を思うとき、足をかえして、あなたのあかしに向かいます。"},{"ref":"Ps.119.60","start":19119060,"end":19119060,"break":"line","breaks":[[16,"line"]],"ruby":[[8,1,"いまし"],[11,1,"まも"]],"text":"わたしはあなたの戒めを守るのに、すみやかで、ためらいません。"},{"ref":"Ps.119.61","start":19119061,"end":19119061,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"あ"],[7,1,"もの"],[16,1,"とら"],[33,1,"わす"]],"text":"たとい、悪しき者のなわがわたしを捕えても、わたしはあなたのおきてを忘れません。"},{"ref":"Ps.119.62","start":19119062,"end":19119062,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"ただ"],[18,2,"やはん"],[21,1,"お"],[29,2,"かんしゃ"]],"text":"わたしはあなたの正しいおきてのゆえに夜半に起きて、あなたに感謝します。"},{"ref":"Ps.119.63","start":19119063,"end":19119063,"break":"line","breaks":[[17,"line"]],"ruby":[[12,1,"おそ"],[15,1,"もの"],[27,1,"まも"],[29,1,"もの"],[31,2,"なかま"]],"text":"わたしは、すべてあなたを恐れる者、またあなたのさとしを守る者の仲間です。"},{"ref":"Ps.119.64","start":19119064,"end":19119064,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"ち"],[15,1,"み"],[26,1,"さだ"],[33,1,"おし"]],"text":"主よ、地はあなたのいつくしみで満ちています。あなたの定めをわたしに教えてください。"},{"ref":"Ps.119.65","start":19119065,"end":19119065,"break":"paragraph","title":"テス","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[8,2,"ことば"]],"text":"主よ、あなたはみ言葉にしたがってしもべをよくあしらわれました。"},{"ref":"Ps.119.66","start":19119066,"end":19119066,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"よ"],[6,2,"はんだん"],[9,2,"ちしき"],[13,1,"おし"],[29,1,"いまし"],[32,1,"しん"]],"text":"わたしに良い判断と知識とを教えてください。わたしはあなたの戒めを信じるからです。"},{"ref":"Ps.119.67","start":19119067,"end":19119067,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"くる"],[9,1,"まえ"],[12,1,"まよ"],[21,1,"いま"],[24,2,"ことば"],[27,1,"まも"]],"text":"わたしは苦しまない前には迷いました。しかし今はみ言葉を守ります。"},{"ref":"Ps.119.68","start":19119068,"end":19119068,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"ぜん"],[8,1,"ぜん"],[10,1,"おこな"],[20,1,"さだ"],[27,1,"おし"]],"text":"あなたは善にして善を行われます。あなたの定めをわたしに教えてください。"},{"ref":"Ps.119.69","start":19119069,"end":19119069,"break":"line","breaks":[[11,"line"],[26,"line"],[39,"line"]],"ruby":[[0,1,"たか"],[3,1,"もの"],[5,1,"いつわ"],[33,1,"こころ"],[47,1,"まも"]],"text":"高ぶる者は偽りをもってわたしをことごとくおおいます。しかしわたしは心をつくしてあなたのさとしを守ります。"},{"ref":"Ps.119.70","start":19119070,"end":19119070,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こころ"],[5,1,"こ"],[7,1,"ふと"],[10,2,"しぼう"],[33,1,"よろこ"]],"text":"彼らの心は肥え太って脂肪のようです。しかしわたしはあなたのおきてを喜びます。"},{"ref":"Ps.119.71","start":19119071,"end":19119071,"break":"line","breaks":[[21,"line"],[39,"line"]],"ruby":[[0,1,"くる"],[15,1,"よ"],[17,1,"こと"],[39,1,"まな"]],"text":"苦しみにあったことは、わたしに良い事です。これによってわたしはあなたのおきてを学ぶことができました。"},{"ref":"Ps.119.72","start":19119072,"end":19119072,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"くち"],[19,1,"いく"],[22,2,"きんぎん"],[24,2,"かへい"]],"text":"あなたの口のおきては、わたしのためには幾千の金銀貨幣にもまさるのです。"},{"ref":"Ps.119.73","start":19119073,"end":19119073,"break":"paragraph","title":"ヨード","breaks":[[14,"line"],[25,"line"],[36,"line"]],"ruby":[[5,1,"て"],[11,1,"つく"],[18,1,"かたち"],[19,1,"つく"],[29,2,"ちえ"],[32,1,"あた"],[40,1,"いまし"],[43,1,"まな"]],"text":"あなたのみ手はわたしを造り、わたしを形造りました。わたしに知恵を与えて、あなたの戒めを学ばせてください。"},{"ref":"Ps.119.74","start":19119074,"end":19119074,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"おそ"],[7,1,"もの"],[13,1,"み"],[15,1,"よろこ"],[27,2,"ことば"],[33,1,"のぞ"]],"text":"あなたを恐れる者はわたしを見て喜ぶでしょう。わたしはみ言葉によって望みをいだいたからです。"},{"ref":"Ps.119.75","start":19119075,"end":19119075,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[0,1,"しゅ"],[15,1,"ただ"],[26,2,"しんじつ"],[36,1,"くる"],[45,1,"し"]],"text":"主よ、わたしはあなたのさばきの正しく、また、あなたが真実をもってわたしを苦しめられたことを知っています。"},{"ref":"Ps.119.76","start":19119076,"end":19119076,"break":"line","breaks":[[22,"line"]],"ruby":[[8,1,"つ"],[13,2,"やくそく"],[34,1,"なぐさ"]],"text":"あなたがしもべに告げられた約束にしたがって、あなたのいつくしみをわが慰めとしてください。"},{"ref":"Ps.119.77","start":19119077,"end":19119077,"break":"line","breaks":[[17,"line"],[30,"line"]],"ruby":[[13,1,"のぞ"],[21,1,"い"],[40,1,"よろこ"]],"text":"あなたのあわれみをわたしに臨ませ、わたしを生かしてください。あなたのおきてはわが喜びだからです。"},{"ref":"Ps.119.78","start":19119078,"end":19119078,"break":"line","breaks":[[18,"line"],[43,"line"]],"ruby":[[0,1,"たか"],[3,1,"もの"],[5,1,"はじ"],[18,1,"かれ"],[21,1,"いつわ"],[58,1,"ふか"],[60,1,"おも"]],"text":"高ぶる者に恥をこうむらせてください。彼らは偽りをもって、わたしをくつがえしたからです。しかしわたしはあなたのさとしを深く思います。"},{"ref":"Ps.119.79","start":19119079,"end":19119079,"break":"line","breaks":[[11,"line"],[24,"line"]],"ruby":[[8,1,"もの"],[19,1,"し"],[21,1,"もの"],[28,1,"かえ"]],"text":"あなたをおそれる者と、あなたのあかしを知る者とをわたしに帰らせてください。"},{"ref":"Ps.119.80","start":19119080,"end":19119080,"break":"line","breaks":[[11,"line"],[27,"line"]],"ruby":[[4,1,"こころ"],[6,1,"まった"],[15,1,"さだ"],[18,1,"まも"],[36,1,"はじ"]],"text":"わたしの心を全くして、あなたの定めを守らせてください。そうすればわたしは恥をこうむることがありません。"},{"ref":"Ps.119.81","start":19119081,"end":19119081,"break":"paragraph","title":"カフ","breaks":[[23,"line"]],"ruby":[[2,1,"たましい"],[8,1,"すくい"],[10,1,"した"],[13,1,"た"],[28,2,"ことば"],[34,1,"のぞ"]],"text":"わが魂はあなたの救を慕って絶えいるばかりです。わたしはみ言葉によって望みをいだきます。"},{"ref":"Ps.119.82","start":19119082,"end":19119082,"break":"line","breaks":[[22,"line"],[45,"line"]],"ruby":[[4,1,"め"],[10,2,"やくそく"],[13,1,"ま"],[19,1,"おとろ"],[34,1,"なぐさ"],[45,1,"たず"]],"text":"わたしの目はあなたの約束を待つによって衰え、「いつ、あなたはわたしを慰められるのですか」と尋ねます。"},{"ref":"Ps.119.83","start":19119083,"end":19119083,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"けむり"],[6,1,"なか"],[8,1,"かわ"],[9,1,"ぶくろ"],[28,1,"さだ"],[31,1,"わす"]],"text":"わたしは煙の中の皮袋のようになりましたが、なお、あなたの定めを忘れませんでした。"},{"ref":"Ps.119.84","start":19119084,"end":19119084,"break":"line","breaks":[[22,"line"],[39,"line"]],"ruby":[[8,1,"ひ"],[14,1,"つづ"],[33,2,"はくがい"],[37,1,"もの"]],"text":"あなたのしもべの日はどれほど続くでしょうか。いつあなたは、わたしを迫害する者をさばかれるでしょうか。"},{"ref":"Ps.119.85","start":19119085,"end":19119085,"break":"line","breaks":[[17,"line"],[25,"line"]],"ruby":[[0,1,"たか"],[3,1,"もの"],[17,1,"あな"],[19,1,"ほ"],[25,1,"かれ"],[36,1,"したが"],[40,2,"ひとびと"]],"text":"高ぶる者はわたしをおとしいれようと穴を掘りました。彼らはあなたのおきてに従わない人々です。"},{"ref":"Ps.119.86","start":19119086,"end":19119086,"break":"line","breaks":[[14,"line"],[33,"line"]],"ruby":[[4,1,"いまし"],[9,2,"しんじつ"],[14,1,"かれ"],[17,1,"いつわ"],[27,2,"はくがい"],[38,1,"たす"]],"text":"あなたの戒めはみな真実です。彼らは偽りをもってわたしを迫害します。わたしをお助けください。"},{"ref":"Ps.119.87","start":19119087,"end":19119087,"break":"line","breaks":[[11,"line"],[26,"line"]],"ruby":[[0,1,"かれ"],[5,1,"ち"],[19,1,"ほろ"],[42,1,"す"]],"text":"彼らはこの地において、ほとんどわたしを滅ぼしました。しかし、わたしはあなたのさとしを捨てませんでした。"},{"ref":"Ps.119.88","start":19119088,"end":19119088,"break":"line","breaks":[[15,"line"],[28,"line"],[46,"line"]],"ruby":[[19,1,"い"],[41,1,"くち"],[44,1,"で"],[50,1,"まも"]],"text":"あなたのいつくしみにしたがってわたしを生かしてください。そうすればわたしはあなたの口から出るあかしを守ります。"},{"ref":"Ps.119.89","start":19119089,"end":19119089,"break":"paragraph","title":"ラメド","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[8,2,"ことば"],[11,1,"てん"],[21,1,"かた"],[23,1,"さだ"]],"text":"主よ、あなたのみ言葉は天においてとこしえに堅く定まり、"},{"ref":"Ps.119.90","start":19119090,"end":19119090,"break":"line","breaks":[[18,"line"]],"ruby":[[13,1,"およ"],[22,1,"ち"],[24,1,"さだ"],[32,1,"ち"],[34,1,"かた"],[36,1,"た"]],"text":"あなたのまことはよろずよに及びます。あなたが地を定められたので、地は堅く立っています。"},{"ref":"Ps.119.91","start":19119091,"end":19119091,"break":"line","breaks":[[17,"line"],[32,"line"]],"ruby":[[11,1,"おお"],[17,1,"かた"],[19,1,"た"],[22,2,"こんにち"],[25,1,"いた"],[39,1,"みな"]],"text":"これらのものはあなたの仰せにより、堅く立って今日に至っています。よろずのものは皆あなたのしもべだからです。"},{"ref":"Ps.119.92","start":19119092,"end":19119092,"break":"line","breaks":[[23,"line"]],"ruby":[[10,1,"よろこ"],[30,1,"なや"],[36,1,"ほろ"]],"text":"あなたのおきてがわが喜びとならなかったならば、わたしはついに悩みのうちに滅びたでしょう。"},{"ref":"Ps.119.93","start":19119093,"end":19119093,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"つね"],[14,1,"わす"],[35,1,"い"]],"text":"わたしは常にあなたのさとしを忘れません。あなたはこれをもって、わたしを生かされたからです。"},{"ref":"Ps.119.94","start":19119094,"end":19119094,"break":"line","breaks":[[13,"line"],[25,"line"]],"ruby":[[18,1,"すく"],[37,1,"もと"]],"text":"わたしはあなたのものです。わたしをお救いください。わたしはあなたのさとしを求めました。"},{"ref":"Ps.119.95","start":19119095,"end":19119095,"break":"line","breaks":[[14,"line"],[23,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[9,1,"ほろ"],[14,1,"ま"],[16,1,"ぶ"],[39,1,"おも"]],"text":"悪しき者はわたしを滅ぼそうと待ち伏せています。しかし、わたしはあなたのあかしを思います。"},{"ref":"Ps.119.96","start":19119096,"end":19119096,"break":"line","breaks":[[13,"line"],[25,"line"]],"ruby":[[8,1,"まった"],[13,1,"かぎ"],[20,1,"み"],[32,1,"いまし"],[35,1,"かぎ"],[39,1,"ひろ"]],"text":"わたしはすべての全きことに限りあることを見ました。しかしあなたの戒めは限りなく広いのです。"},{"ref":"Ps.119.97","start":19119097,"end":19119097,"break":"paragraph","title":"メム","breaks":[[15,"line"],[25,"line"]],"ruby":[[15,1,"あい"],[36,1,"ふか"],[38,1,"おも"]],"text":"いかにわたしはあなたのおきてを愛することでしょう。わたしはひねもすこれを深く思います。"},{"ref":"Ps.119.98","start":19119098,"end":19119098,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"いまし"],[7,1,"つね"],[13,1,"とも"],[26,1,"てき"],[32,1,"かしこ"]],"text":"あなたの戒めは常にわたしと共にあるので、わたしをわが敵にまさって賢くします。"},{"ref":"Ps.119.99","start":19119099,"end":19119099,"break":"line","breaks":[[19,"line"]],"ruby":[[12,1,"ふか"],[14,1,"おも"],[25,1,"し"],[31,2,"ちえ"]],"text":"わたしはあなたのあかしを深く思うので、わがすべての師にまさって知恵があります。"},{"ref":"Ps.119.100","start":19119100,"end":19119100,"break":"line","breaks":[[17,"line"]],"ruby":[[12,1,"まも"],[17,1,"お"],[20,1,"もの"],[26,1,"こと"]],"text":"わたしはあなたのさとしを守るので、老いた者にまさって事をわきまえます。"},{"ref":"Ps.119.101","start":19119101,"end":19119101,"break":"line","breaks":[[14,"line"]],"ruby":[[5,2,"ことば"],[8,1,"まも"],[16,1,"あし"],[27,1,"わる"],[29,1,"みち"],[31,1,"い"]],"text":"わたしはみ言葉を守るために、わが足をとどめて、すべての悪い道に行かせません。"},{"ref":"Ps.119.102","start":19119102,"end":19119102,"break":"line","breaks":[[16,"line"]],"ruby":[[8,1,"おし"],[28,1,"はな"]],"text":"あなたがわたしを教えられたので、わたしはあなたのおきてを離れません。"},{"ref":"Ps.119.103","start":19119103,"end":19119103,"break":"line","breaks":[[16,"line"],[25,"line"]],"ruby":[[5,2,"ことば"],[16,1,"あま"],[25,1,"みつ"],[33,1,"くち"],[35,1,"あま"]],"text":"あなたのみ言葉はいかにわがあごに甘いことでしょう。蜜にまさってわが口に甘いのです。"},{"ref":"Ps.119.104","start":19119104,"end":19119104,"break":"line","breaks":[[23,"line"]],"ruby":[[15,2,"ちえ"],[18,1,"え"],[32,1,"いつわ"],[39,1,"みち"],[41,1,"にく"]],"text":"わたしはあなたのさとしによって知恵を得ました。それゆえ、わたしは偽りのすべての道を憎みます。"},{"ref":"Ps.119.105","start":19119105,"end":19119105,"break":"paragraph","title":"ヌン","breaks":[[17,"line"]],"ruby":[[5,2,"ことば"],[10,1,"あし"],[19,1,"みち"],[21,1,"ひかり"]],"text":"あなたのみ言葉はわが足のともしび、わが道の光です。"},{"ref":"Ps.119.106","start":19119106,"end":19119106,"break":"line","breaks":[[23,"line"]],"ruby":[[8,1,"ただ"],[15,1,"まも"],[20,1,"ちか"],[28,2,"じっこう"]],"text":"わたしはあなたの正しいおきてを守ることを誓い、かつこれを実行しました。"},{"ref":"Ps.119.107","start":19119107,"end":19119107,"break":"line","breaks":[[14,"line"]],"ruby":[[7,1,"くる"],[14,1,"しゅ"],[18,2,"ことば"],[21,1,"したが"],[29,1,"い"]],"text":"わたしはいたく苦しみました。主よ、み言葉に従って、わたしを生かしてください。"},{"ref":"Ps.119.108","start":19119108,"end":19119108,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"そな"],[11,1,"もの"],[25,1,"おし"]],"text":"主よ、わがさんびの供え物をうけて、あなたのおきてを教えてください。"},{"ref":"Ps.119.109","start":19119109,"end":19119109,"break":"line","breaks":[[22,"line"]],"ruby":[[8,1,"つね"],[10,2,"きけん"],[38,1,"わす"]],"text":"わたしのいのちは常に危険にさらされています。しかし、わたしはあなたのおきてを忘れません。"},{"ref":"Ps.119.110","start":19119110,"end":19119110,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[15,1,"もう"],[38,1,"まよ"],[40,1,"で"]],"text":"悪しき者はわたしのためにわなを設けました。しかし、わたしはあなたのさとしから迷い出ません。"},{"ref":"Ps.119.111","start":19119111,"end":19119111,"break":"line","breaks":[[20,"line"]],"ruby":[[15,1,"し"],[16,1,"ぎょう"],[33,1,"こころ"],[35,1,"よろこ"]],"text":"あなたのあかしはとこしえにわが嗣業です。まことに、そのあかしはわが心の喜びです。"},{"ref":"Ps.119.112","start":19119112,"end":19119112,"break":"line","breaks":[[16,"line"]],"ruby":[[8,1,"さだ"],[11,1,"おわ"],[21,1,"まも"],[25,1,"こころ"],[27,1,"かたむ"]],"text":"わたしはあなたの定めを終りまで、とこしえに守ろうと心を傾けます。"},{"ref":"Ps.119.113","start":19119113,"end":19119113,"break":"paragraph","title":"サメク","breaks":[[14,"line"]],"ruby":[[4,2,"ふたごころ"],[7,1,"もの"],[9,1,"にく"],[25,1,"あい"]],"text":"わたしは二心の者を憎みます。しかしあなたのおきてを愛します。"},{"ref":"Ps.119.114","start":19119114,"end":19119114,"break":"line","breaks":[[16,"line"]],"ruby":[[6,1,"かく"],[8,1,"ば"],[12,1,"たて"],[21,2,"ことば"],[27,1,"のぞ"]],"text":"あなたはわが隠れ場、わが盾です。わたしはみ言葉によって望みをいだきます。"},{"ref":"Ps.119.115","start":19119115,"end":19119115,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"あく"],[4,1,"もの"],[11,1,"はな"],[13,1,"さ"],[22,1,"かみ"],[24,1,"いまし"],[27,1,"まも"]],"text":"悪をなす者よ、わたしを離れ去れ、わたしはわが神の戒めを守るのです。"},{"ref":"Ps.119.116","start":19119116,"end":19119116,"break":"line","breaks":[[13,"line"],[29,"line"],[43,"line"]],"ruby":[[4,2,"やくそく"],[31,1,"のぞ"],[37,1,"は"]],"text":"あなたの約束にしたがって、わたしをささえて、ながらえさせ、わが望みについて恥じることのないようにしてください。"},{"ref":"Ps.119.117","start":19119117,"end":19119117,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[23,1,"やす"],[28,1,"つね"],[34,1,"さだ"],[37,1,"こころ"]],"text":"わたしをささえてください。そうすれば、わたしは安らかで、常にあなたの定めに心をそそぎます。"},{"ref":"Ps.119.118","start":19119118,"end":19119118,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[7,1,"さだ"],[11,1,"まよ"],[13,1,"で"],[15,1,"もの"],[36,1,"かれ"],[39,1,"あざむ"]],"text":"すべてあなたの定めから迷い出る者をあなたは、かろしめられます。まことに、彼らの欺きはむなしいのです。"},{"ref":"Ps.119.119","start":19119119,"end":19119119,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[4,1,"ち"],[10,1,"あ"],[13,1,"もの"],[16,1,"かな"],[47,1,"あい"]],"text":"あなたは地のすべての悪しき者を、金かすのようにみなされます。それゆえ、わたしはあなたのあかしを愛します。"},{"ref":"Ps.119.120","start":19119120,"end":19119120,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"にく"],[8,1,"おそ"],[13,1,"ふる"],[30,1,"おそ"]],"text":"わが肉はあなたを恐れるので震えます。わたしはあなたのさばきを恐れます。"},{"ref":"Ps.119.121","start":19119121,"end":19119121,"break":"paragraph","title":"アイン","breaks":[[22,"line"],[37,"line"]],"ruby":[[4,1,"ただ"],[7,1,"ぎ"],[16,1,"おこな"],[26,1,"す"],[35,1,"もの"]],"text":"わたしは正しく義にかなったことを行いました。わたしを捨てて、しえたげる者にゆだねないでください。"},{"ref":"Ps.119.122","start":19119122,"end":19119122,"break":"line","breaks":[[15,"line"]],"ruby":[[7,3,"ほしょうにん"],[15,1,"たか"],[18,1,"もの"]],"text":"しもべのために保証人となって、高ぶる者にわたしを、しえたげさせないでください。"},{"ref":"Ps.119.123","start":19119123,"end":19119123,"break":"line","breaks":[[11,"line"]],"ruby":[[2,1,"め"],[8,1,"すくい"],[15,1,"ただ"],[18,2,"やくそく"],[22,1,"ま"],[24,1,"のぞ"],[27,1,"おとろ"]],"text":"わが目はあなたの救と、あなたの正しい約束とを待ち望んで衰えます。"},{"ref":"Ps.119.124","start":19119124,"end":19119124,"break":"line","breaks":[[25,"line"]],"ruby":[[29,1,"さだ"],[32,1,"おし"]],"text":"あなたのいつくしみにしたがって、しもべをあしらい、あなたの定めを教えてください。"},{"ref":"Ps.119.125","start":19119125,"end":19119125,"break":"line","breaks":[[14,"line"],[25,"line"]],"ruby":[[18,2,"ちえ"],[21,1,"あた"],[33,1,"し"]],"text":"わたしはあなたのしもべです。わたしに知恵を与えて、あなたのあかしを知らせてください。"},{"ref":"Ps.119.126","start":19119126,"end":19119126,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[11,1,"やぶ"],[17,1,"いま"],[19,1,"しゅ"],[27,1,"とき"]],"text":"彼らはあなたのおきてを破りました。今は主のはたらかれる時です。"},{"ref":"Ps.119.127","start":19119127,"end":19119127,"break":"line","breaks":[[14,"line"]],"ruby":[[9,1,"きん"],[14,2,"じゅんきん"],[27,1,"いまし"],[30,1,"あい"]],"text":"それゆえ、わたしは金よりも、純金よりもまさってあなたの戒めを愛します。"},{"ref":"Ps.119.128","start":19119128,"end":19119128,"break":"line","breaks":[[19,"line"],[37,"line"]],"ruby":[[29,1,"ただ"],[32,1,"みち"],[34,1,"あゆ"],[41,1,"いつわ"],[44,1,"みち"],[46,1,"にく"]],"text":"それゆえ、わたしは、あなたのもろもろのさとしにしたがって、正しき道に歩み、すべての偽りの道を憎みます。"},{"ref":"Ps.119.129","start":19119129,"end":19119129,"break":"paragraph","title":"ペ","breaks":[[17,"line"]],"ruby":[[8,1,"おどろ"],[24,1,"たましい"],[29,1,"まも"]],"text":"あなたのあかしは驚くべきものです。それゆえ、わが魂はこれを守ります。"},{"ref":"Ps.119.130","start":19119130,"end":19119130,"break":"line","breaks":[[14,"line"]],"ruby":[[1,2,"ことば"],[4,1,"あ"],[8,1,"ひかり"],[10,1,"はな"],[14,2,"むがく"],[17,1,"もの"],[19,2,"ちえ"],[22,1,"あた"]],"text":"み言葉が開けると光を放って、無学な者に知恵を与えます。"},{"ref":"Ps.119.131","start":19119131,"end":19119131,"break":"line","breaks":[[17,"line"]],"ruby":[[8,1,"いまし"],[11,1,"した"],[17,1,"くち"],[19,1,"ひろ"],[27,1,"もと"]],"text":"わたしはあなたの戒めを慕うゆえに、口を広くあけてあえぎ求めました。"},{"ref":"Ps.119.132","start":19119132,"end":19119132,"break":"line","breaks":[[17,"line"]],"ruby":[[1,1,"な"],[3,1,"あい"],[6,1,"もの"],[8,1,"つね"]],"text":"み名を愛する者に常にされるように、わたしをかえりみ、わたしをあわれんでください。"},{"ref":"Ps.119.133","start":19119133,"end":19119133,"break":"line","breaks":[[23,"line"]],"ruby":[[4,2,"やくそく"],[15,1,"あゆ"],[18,1,"たし"],[27,2,"ふぎ"],[30,2,"しはい"]],"text":"あなたの約束にしたがって、わが歩みを確かにし、すべての不義に支配されないようにしてください。"},{"ref":"Ps.119.134","start":19119134,"end":19119134,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"ひと"],[40,1,"まも"]],"text":"わたしを人のしえたげからあがなってください。そうすればわたしは、あなたのさとしを守ります。"},{"ref":"Ps.119.135","start":19119135,"end":19119135,"break":"line","breaks":[[12,"line"]],"ruby":[[1,1,"かお"],[7,1,"うえ"],[9,1,"てら"],[16,1,"さだ"],[19,1,"おし"]],"text":"み顔をしもべの上に照し、あなたの定めを教えてください。"},{"ref":"Ps.119.136","start":19119136,"end":19119136,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"ひとびと"],[11,1,"まも"],[20,1,"め"],[22,1,"なみだ"],[24,1,"かわ"],[29,1,"なが"]],"text":"人々があなたのおきてを守らないので、わが目の涙は川のように流れます。"},{"ref":"Ps.119.137","start":19119137,"end":19119137,"break":"paragraph","title":"ツァデー","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"ただ"],[19,1,"ただ"]],"text":"主よ、あなたは正しく、あなたのさばきは正しいのです。"},{"ref":"Ps.119.138","start":19119138,"end":19119138,"break":"line","breaks":[[20,"line"]],"ruby":[[4,2,"せいぎ"],[10,1,"うえ"],[13,2,"しんじつ"],[28,1,"めい"]],"text":"あなたの正義と、この上ない真実とをもってあなたのあかしを命じられました。"},{"ref":"Ps.119.139","start":19119139,"end":19119139,"break":"line","breaks":[[22,"line"]],"ruby":[[13,2,"ことば"],[16,1,"わす"],[24,2,"ねっしん"],[31,1,"ほろ"]],"text":"わたしのあだが、あなたのみ言葉を忘れるので、わが熱心はわたしを滅ぼすのです。"},{"ref":"Ps.119.140","start":19119140,"end":19119140,"break":"line","breaks":[[16,"line"]],"ruby":[[4,2,"やくそく"],[11,1,"たし"],[27,1,"あい"]],"text":"あなたの約束はまことに確かです。あなたのしもべはこれを愛します。"},{"ref":"Ps.119.141","start":19119141,"end":19119141,"break":"line","breaks":[[25,"line"]],"ruby":[[4,1,"と"],[11,1,"もの"],[14,1,"ひと"],[16,1,"あなど"],[36,1,"わす"]],"text":"わたしは取るにたらない者で、人に侮られるけれども、なお、あなたのさとしを忘れません。"},{"ref":"Ps.119.142","start":19119142,"end":19119142,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"ぎ"],[11,1,"ただ"]],"text":"あなたの義はとこしえに正しく、あなたのおきてはまことです。"},{"ref":"Ps.119.143","start":19119143,"end":19119143,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"なや"],[3,1,"くる"],[11,1,"のぞ"],[24,1,"いまし"],[31,1,"よろこ"]],"text":"悩みと苦しみがわたしに臨みました。しかしあなたの戒めはわたしの喜びです。"},{"ref":"Ps.119.144","start":19119144,"end":19119144,"break":"line","breaks":[[20,"line"]],"ruby":[[13,1,"ただ"],[24,2,"ちえ"],[27,1,"あた"],[31,1,"い"]],"text":"あなたのあかしはとこしえに正しいのです。わたしに知恵を与えて、生きながらえさせてください。"},{"ref":"Ps.119.145","start":19119145,"end":19119145,"break":"paragraph","title":"コフ","breaks":[[17,"line"],[28,"line"]],"ruby":[[4,1,"こころ"],[10,1,"よ"],[17,1,"しゅ"],[21,1,"こた"],[36,1,"さだ"],[39,1,"まも"]],"text":"わたしは心をつくして呼ばわります。主よ、お答えください。わたしはあなたの定めを守ります。"},{"ref":"Ps.119.146","start":19119146,"end":19119146,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[8,1,"よ"],[20,1,"すく"],[39,1,"まも"]],"text":"わたしはあなたに呼ばわります。わたしをお救いください。わたしはあなたのあかしを守ります。"},{"ref":"Ps.119.147","start":19119147,"end":19119147,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"あさ"],[5,1,"はや"],[7,1,"お"],[9,1,"で"],[11,1,"よ"],[23,2,"ことば"],[29,1,"のぞ"]],"text":"わたしは朝早く起き出て呼ばわります。わたしはみ言葉によって望みをいだくのです。"},{"ref":"Ps.119.148","start":19119148,"end":19119148,"break":"line","breaks":[[20,"line"]],"ruby":[[2,1,"め"],[4,2,"やけい"],[7,2,"こうたい"],[11,1,"とき"],[13,1,"さき"],[24,2,"やくそく"],[27,1,"ふか"],[29,1,"おも"]],"text":"わが目は夜警の交代する時に先だってさめ、あなたの約束を深く思います。"},{"ref":"Ps.119.149","start":19119149,"end":19119149,"break":"line","breaks":[[16,"line"],[28,"line"],[44,"line"]],"ruby":[[18,1,"こえ"],[20,1,"き"],[28,1,"しゅ"],[35,2,"こうぎ"],[48,1,"い"]],"text":"あなたのいつくしみにしたがって、わが声を聞いてください。主よ、あなたの公義にしたがって、わたしを生かしてください。"},{"ref":"Ps.119.150","start":19119150,"end":19119150,"break":"line","breaks":[[11,"line"],[29,"line"]],"ruby":[[9,1,"もの"],[11,1,"わる"],[21,1,"ちか"],[29,1,"かれ"],[40,1,"とお"]],"text":"わたしをしえたげる者が悪いたくらみをもって近づいています。彼らはあなたのおきてを遠くはなれているのです。"},{"ref":"Ps.119.151","start":19119151,"end":19119151,"break":"line","breaks":[[20,"line"]],"ruby":[[3,1,"しゅ"],[10,1,"ちか"],[29,1,"いまし"]],"text":"しかし主よ、あなたは近くいらせられます。あなたのもろもろの戒めはまことです。"},{"ref":"Ps.119.152","start":19119152,"end":19119152,"break":"line","breaks":[[20,"line"],[32,"line"]],"ruby":[[4,1,"はや"],[32,1,"た"],[40,1,"し"]],"text":"わたしは早くからあなたのあかしによって、あなたがこれをとこしえに立てられたことを知りました。"},{"ref":"Ps.119.153","start":19119153,"end":19119153,"break":"paragraph","title":"レシ","breaks":[[20,"line"]],"ruby":[[2,1,"なや"],[5,1,"み"],[13,1,"すく"],[32,1,"わす"]],"text":"わが悩みを見て、わたしをお救いください。わたしはあなたのおきてを忘れないからです。"},{"ref":"Ps.119.154","start":19119154,"end":19119154,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[2,1,"うった"],[5,2,"べんご"],[23,2,"やくそく"],[36,1,"い"]],"text":"わが訴えを弁護して、わたしをあがない、あなたの約束にしたがって、わたしを生かしてください。"},{"ref":"Ps.119.155","start":19119155,"end":19119155,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"すくい"],[2,1,"あ"],[5,1,"もの"],[7,1,"とお"],[9,1,"はな"],[15,1,"かれ"],[22,1,"さだ"],[25,1,"もと"]],"text":"救は悪しき者を遠く離れている。彼らはあなたの定めを求めないからです。"},{"ref":"Ps.119.156","start":19119156,"end":19119156,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[12,1,"おお"],[20,2,"こうぎ"],[23,1,"したが"],[31,1,"い"]],"text":"主よ、あなたのあわれみは大きい。あなたの公義に従って、わたしを生かしてください。"},{"ref":"Ps.119.157","start":19119157,"end":19119157,"break":"line","breaks":[[11,"line"],[24,"line"]],"ruby":[[9,1,"もの"],[19,1,"もの"],[21,1,"おお"],[40,1,"はな"]],"text":"わたしをしえたげる者、わたしをあだする者は多い。しかしわたしは、あなたのあかしを離れません。"},{"ref":"Ps.119.158","start":19119158,"end":19119158,"break":"line","breaks":[[21,"line"]],"ruby":[[0,3,"ふしんこう"],[4,1,"もの"],[11,2,"ことば"],[14,1,"まも"],[25,1,"かれ"],[28,1,"み"],[36,1,"おも"]],"text":"不信仰な者があなたのみ言葉を守らないので、わたしは彼らを見て、いとわしく思います。"},{"ref":"Ps.119.159","start":19119159,"end":19119159,"break":"line","breaks":[[15,"line"],[28,"line"],[47,"line"]],"ruby":[[15,1,"あい"],[21,1,"さっ"],[28,1,"しゅ"],[51,1,"い"]],"text":"わたしがいかにあなたのさとしを愛するかをお察しください。主よ、あなたのいつくしみにしたがって、わたしを生かしてください。"},{"ref":"Ps.119.160","start":19119160,"end":19119160,"break":"line","breaks":[[16,"line"],[31,"line"]],"ruby":[[5,2,"ことば"],[8,2,"ぜんたい"],[11,2,"しんり"],[20,1,"ただ"],[36,1,"た"]],"text":"あなたのみ言葉の全体は真理です。あなたの正しいおきてのすべてはとこしえに絶えることはありません。"},{"ref":"Ps.119.161","start":19119161,"end":19119161,"break":"paragraph","title":"シン","breaks":[[22,"line"]],"ruby":[[5,1,"きみ"],[27,1,"こころ"],[30,2,"ことば"]],"text":"もろもろの君はゆえなくわたしをしえたげます。しかしわが心はみ言葉をおそれます。"},{"ref":"Ps.119.162","start":19119162,"end":19119162,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"おお"],[8,2,"えもの"],[11,1,"え"],[13,1,"もの"],[23,2,"ことば"],[26,1,"よろこ"]],"text":"わたしは大いなる獲物を得た者のようにあなたのみ言葉を喜びます。"},{"ref":"Ps.119.163","start":19119163,"end":19119163,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"いつわ"],[7,1,"にく"],[10,1,"い"],[29,1,"あい"]],"text":"わたしは偽りを憎み、忌みきらいます。しかしあなたのおきてを愛します。"},{"ref":"Ps.119.164","start":19119164,"end":19119164,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"ただ"],[20,1,"にち"]],"text":"わたしはあなたの正しいおきてのゆえに、一日に七たびあなたをほめたたえます。"},{"ref":"Ps.119.165","start":19119165,"end":19119165,"break":"line","breaks":[[24,"line"]],"ruby":[[8,1,"あい"],[11,1,"もの"],[14,1,"おお"],[18,2,"へいあん"],[24,1,"なに"],[28,1,"かれ"]],"text":"あなたのおきてを愛する者には大いなる平安があり、何ものも彼らをつまずかすことはできません。"},{"ref":"Ps.119.166","start":19119166,"end":19119166,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"すくい"],[13,1,"のぞ"],[20,1,"いまし"]],"text":"主よ、わたしはあなたの救を望み、あなたの戒めをおこないます。"},{"ref":"Ps.119.167","start":19119167,"end":19119167,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"たましい"],[13,1,"まも"],[28,1,"あい"]],"text":"わが魂は、あなたのあかしを守ります。わたしはいたくこれを愛します。"},{"ref":"Ps.119.168","start":19119168,"end":19119168,"break":"line","breaks":[[20,"line"]],"ruby":[[6,1,"みち"],[13,1,"まえ"],[38,1,"まも"]],"text":"わがすべての道があなたのみ前にあるので、わたしはあなたのさとしと、あかしとを守ります。"},{"ref":"Ps.119.169","start":19119169,"end":19119169,"break":"paragraph","title":"タウ","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"さけ"],[13,1,"まえ"],[21,2,"ことば"],[24,1,"したが"],[32,2,"ちえ"],[36,1,"あた"]],"text":"主よ、どうか、わが叫びをみ前にいたらせ、み言葉に従って、わたしに知恵をお与えください。"},{"ref":"Ps.119.170","start":19119170,"end":19119170,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"ねが"],[6,1,"まえ"],[14,2,"ことば"],[28,1,"たす"]],"text":"わが願いをみ前にいたらせ、み言葉にしたがって、わたしをお助けください。"},{"ref":"Ps.119.171","start":19119171,"end":19119171,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"さだ"],[11,1,"おし"],[30,1,"とな"]],"text":"あなたの定めをわたしに教えられるので、わがくちびるはさんびを唱えます。"},{"ref":"Ps.119.172","start":19119172,"end":19119172,"break":"line","breaks":[[17,"line"]],"ruby":[[8,1,"いまし"],[11,1,"ただ"],[19,1,"した"],[22,2,"ことば"],[25,1,"うた"]],"text":"あなたのすべての戒めは正しいので、わが舌はみ言葉を歌います。"},{"ref":"Ps.119.173","start":19119173,"end":19119173,"break":"line","breaks":[[18,"line"]],"ruby":[[12,1,"えら"],[23,1,"て"],[26,1,"つね"],[30,1,"たす"]],"text":"わたしはあなたのさとしを選びました。あなたのみ手を、常にわが助けとしてください。"},{"ref":"Ps.119.174","start":19119174,"end":19119174,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"すくい"],[13,1,"した"],[30,1,"よろこ"]],"text":"主よ、わたしはあなたの救を慕います。あなたのおきてはわたしの喜びです。"},{"ref":"Ps.119.175","start":19119175,"end":19119175,"break":"line","breaks":[[9,"line"],[21,"line"]],"ruby":[[4,1,"い"],[32,1,"たす"]],"text":"わたしを生かして、あなたをほめたたえさせ、あなたのおきてを、わが助けとしてください。"},{"ref":"Ps.119.176","start":19119176,"end":19119176,"break":"line","breaks":[[20,"line"],[38,"line"]],"ruby":[[4,1,"うしな"],[8,1,"ひつじ"],[13,1,"まよ"],[15,1,"で"],[28,1,"さが"],[30,1,"だ"],[46,1,"いまし"],[49,1,"わす"]],"text":"わたしは失われた羊のように迷い出ました。あなたのしもべを捜し出してください。わたしはあなたの戒めを忘れないからです。"}]