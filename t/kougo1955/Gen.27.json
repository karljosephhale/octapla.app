[{"ref":"Gen.27.1","start":1027001,"end":1027001,"break":"paragraph","ruby":[[4,2,"としお"],[8,1,"め"],[14,1,"み"],[21,1,"とき"],[23,2,"ちょうし"],[29,1,"よ"],[32,1,"い"],[37,1,"こ"],[41,1,"かれ"],[43,1,"こた"],[46,1,"い"]],"text":"イサクは年老い、目がかすんで見えなくなった時、長子エサウを呼んで言った、「子よ」。彼は答えて言った、「ここにおります」。"},{"ref":"Gen.27.2","start":1027002,"end":1027002,"break":"none","ruby":[[4,1,"い"],[13,2,"としお"],[20,1,"し"],[24,1,"し"]],"text":"イサクは言った。「わたしは年老いて、いつ死ぬかも知れない。"},{"ref":"Gen.27.3","start":1027003,"end":1027003,"break":"none","ruby":[[7,2,"ぶき"],[10,2,"ゆみや"],[16,1,"の"],[18,1,"で"],[33,1,"にく"]],"text":"それであなたの武器、弓矢をもって野に出かけ、わたしのために、しかの肉をとってきて、"},{"ref":"Gen.27.4","start":1027004,"end":1027004,"break":"none","ruby":[[4,1,"す"],[11,1,"た"],[13,1,"もの"],[15,1,"つく"],[18,1,"も"],[23,1,"た"],[33,1,"し"],[35,1,"まえ"],[41,2,"しゅくふく"]],"text":"わたしの好きなおいしい食べ物を作り、持ってきて食べさせよ。わたしは死ぬ前にあなたを祝福しよう」。"},{"ref":"Gen.27.5","start":1027005,"end":1027005,"break":"paragraph","ruby":[[6,1,"こ"],[11,1,"かた"],[19,1,"き"],[36,1,"にく"],[38,1,"え"],[42,1,"の"],[44,1,"で"]],"text":"イサクがその子エサウに語るのをリベカは聞いていた。やがてエサウが、しかの肉を獲ようと野に出かけたとき、"},{"ref":"Gen.27.6","start":1027006,"end":1027006,"break":"none","ruby":[[6,1,"こ"],[11,1,"い"],[20,1,"き"],[29,1,"ちち"],[31,1,"あに"]],"text":"リベカはその子ヤコブに言った、「わたしは聞いていましたが、父は兄エサウに、"},{"ref":"Gen.27.7","start":1027007,"end":1027007,"break":"none","ruby":[[12,1,"にく"],[24,1,"た"],[26,1,"もの"],[28,1,"つく"],[35,1,"た"],[45,1,"し"],[47,1,"まえ"],[50,1,"しゅ"],[52,1,"まえ"],[58,2,"しゅくふく"],[65,1,"い"]],"text":"『わたしのために、しかの肉をとってきて、おいしい食べ物を作り、わたしに食べさせよ。わたしは死ぬ前に、主の前であなたを祝福しよう』と言いました。"},{"ref":"Gen.27.8","start":1027008,"end":1027008,"break":"none","ruby":[[4,1,"こ"],[11,2,"ことば"],[23,1,"い"]],"text":"それで、子よ、わたしの言葉にしたがい、わたしの言うとおりにしなさい。"},{"ref":"Gen.27.9","start":1027009,"end":1027009,"break":"none","ruby":[[0,1,"む"],[3,1,"ところ"],[5,1,"い"],[16,1,"こ"],[18,1,"よ"],[23,1,"とう"],[28,1,"ところ"],[30,1,"と"],[45,1,"ちち"],[51,1,"ちち"],[53,1,"す"],[60,1,"た"],[62,1,"もの"],[64,1,"つく"]],"text":"群れの所へ行って、そこからやぎの子の良いのを二頭わたしの所に取ってきなさい。わたしはそれで父のために、父の好きなおいしい食べ物を作りましょう。"},{"ref":"Gen.27.10","start":1027010,"end":1027010,"break":"none","ruby":[[7,1,"も"],[10,1,"い"],[13,1,"ちち"],[15,1,"た"],[23,1,"ちち"],[25,1,"し"],[27,1,"まえ"],[33,2,"しゅくふく"]],"text":"あなたはそれを持って行って父に食べさせなさい。父は死ぬ前にあなたを祝福するでしょう」。"},{"ref":"Gen.27.11","start":1027011,"end":1027011,"break":"none","ruby":[[4,1,"はは"],[9,1,"い"],[14,1,"あに"],[19,2,"けぶか"],[22,1,"ひと"]],"text":"ヤコブは母リベカに言った、「兄エサウは毛深い人ですが、わたしはなめらかです。"},{"ref":"Gen.27.12","start":1027012,"end":1027012,"break":"none","ruby":[[4,1,"ちち"],[30,1,"ちち"],[32,1,"あざむ"],[34,1,"もの"],[36,1,"おも"],[40,2,"しゅくふく"],[43,1,"う"],[55,1,"う"]],"text":"おそらく父はわたしにさわってみるでしょう。そうすればわたしは父を欺く者と思われ、祝福を受けず、かえってのろいを受けるでしょう」。"},{"ref":"Gen.27.13","start":1027013,"end":1027013,"break":"none","ruby":[[0,1,"はは"],[2,1,"かれ"],[4,1,"い"],[9,1,"こ"],[27,1,"う"],[39,2,"ことば"],[42,1,"したが"],[45,1,"い"],[48,1,"と"]],"text":"母は彼に言った、「子よ、あなたがうけるのろいはわたしが受けます。ただ、わたしの言葉に従い、行って取ってきなさい」。"},{"ref":"Gen.27.14","start":1027014,"end":1027014,"break":"none","ruby":[[3,1,"かれ"],[5,1,"い"],[11,1,"こ"],[13,1,"と"],[16,1,"はは"],[18,1,"ところ"],[20,1,"も"],[28,1,"はは"],[30,1,"ちち"],[32,1,"す"],[39,1,"た"],[41,1,"もの"],[43,1,"つく"]],"text":"そこで彼は行ってやぎの子を取り、母の所に持ってきたので、母は父の好きなおいしい食べ物を作った。"},{"ref":"Gen.27.15","start":1027015,"end":1027015,"break":"none","ruby":[[4,1,"いえ"],[9,2,"ちょうし"],[15,2,"はれぎ"],[18,1,"と"],[22,1,"おとうと"],[27,1,"き"]],"text":"リベカは家にあった長子エサウの晴着を取って、弟ヤコブに着せ、"},{"ref":"Gen.27.16","start":1027016,"end":1027016,"break":"none","ruby":[[2,1,"こ"],[6,1,"かわ"],[8,1,"て"],[10,1,"くび"],[17,1,"ところ"]],"text":"また子やぎの皮を手と首のなめらかな所とにつけさせ、"},{"ref":"Gen.27.17","start":1027017,"end":1027017,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"つく"],[10,1,"た"],[12,1,"もの"],[20,1,"こ"],[25,1,"て"]],"text":"彼女が作ったおいしい食べ物とパンとをその子ヤコブの手にわたした。"},{"ref":"Gen.27.18","start":1027018,"end":1027018,"break":"paragraph","ruby":[[7,1,"ちち"],[9,1,"ところ"],[11,1,"い"],[14,1,"い"],[19,1,"ちち"],[26,1,"ちち"],[28,1,"い"],[43,1,"こ"]],"text":"そこでヤコブは父の所へ行って言った、「父よ」。すると父は言った、「わたしはここにいる。子よ、あなたはだれか」。"},{"ref":"Gen.27.19","start":1027019,"end":1027019,"break":"none","ruby":[[4,1,"ちち"],[6,1,"い"],[11,2,"ちょうし"],[27,1,"い"],[45,1,"お"],[60,1,"にく"],[62,1,"た"],[76,2,"しゅくふく"]],"text":"ヤコブは父に言った、「長子エサウです。あなたがわたしに言われたとおりにいたしました。どうぞ起きて、すわってわたしのしかの肉を食べ、あなたみずからわたしを祝福してください」。"},{"ref":"Gen.27.20","start":1027020,"end":1027020,"break":"none","ruby":[[6,1,"こ"],[8,1,"い"],[13,1,"こ"],[28,1,"はや"],[30,1,"て"],[32,1,"い"],[39,1,"かれ"],[41,1,"い"],[50,1,"かみ"],[52,1,"しゅ"],[63,1,"さづ"]],"text":"イサクはその子に言った、「子よ、どうしてあなたはこんなに早く手に入れたのか」。彼は言った、「あなたの神、主がわたしにしあわせを授けられたからです」。"},{"ref":"Gen.27.21","start":1027021,"end":1027021,"break":"none","ruby":[[8,1,"い"],[13,1,"こ"],[16,2,"ちかよ"],[39,1,"たし"],[44,1,"こ"]],"text":"イサクはヤコブに言った、「子よ、近寄りなさい。わたしは、さわってみて、あなたが確かにわが子エサウであるかどうかをみよう」。"},{"ref":"Gen.27.22","start":1027022,"end":1027022,"break":"none","ruby":[[5,1,"ちち"],[10,2,"ちかよ"],[21,1,"かれ"],[29,1,"い"],[34,1,"こえ"],[40,1,"こえ"],[44,1,"て"],[50,1,"て"]],"text":"ヤコブが、父イサクに近寄ったので、イサクは彼にさわってみて言った、「声はヤコブの声だが、手はエサウの手だ」。"},{"ref":"Gen.27.23","start":1027023,"end":1027023,"break":"none","ruby":[[4,1,"て"],[6,1,"あに"],[11,1,"て"],[16,2,"けぶか"],[32,1,"み"],[48,1,"かれ"],[50,2,"しゅくふく"]],"text":"ヤコブの手が兄エサウの手のように毛深かったため、イサクはヤコブを見わけることができなかったので、彼を祝福した。"},{"ref":"Gen.27.24","start":1027024,"end":1027024,"break":"none","ruby":[[4,1,"い"],[13,1,"たし"],[18,1,"こ"],[27,1,"かれ"],[29,1,"い"]],"text":"イサクは言った、「あなたは確かにわが子エサウですか」。彼は言った、「そうです」。"},{"ref":"Gen.27.25","start":1027025,"end":1027025,"break":"none","ruby":[[4,1,"い"],[13,1,"ところ"],[15,1,"も"],[25,1,"こ"],[30,1,"にく"],[32,1,"た"],[48,2,"しゅくふく"],[62,1,"かれ"],[64,1,"ところ"],[66,1,"も"],[74,1,"かれ"],[76,1,"た"],[85,1,"しゅ"],[87,1,"も"],[95,1,"かれ"],[97,1,"の"]],"text":"イサクは言った、「わたしの所へ持ってきなさい。わが子のしかの肉を食べて、わたしみずから、あなたを祝福しよう」。ヤコブがそれを彼の所に持ってきたので、彼は食べた。またぶどう酒を持ってきたので、彼は飲んだ。"},{"ref":"Gen.27.26","start":1027026,"end":1027026,"break":"none","ruby":[[3,1,"ちち"],[8,1,"かれ"],[10,1,"い"],[15,1,"こ"],[21,2,"ちかよ"],[29,1,"くち"]],"text":"そして父イサクは彼に言った、「子よ、さあ、近寄ってわたしに口づけしなさい」。"},{"ref":"Gen.27.27","start":1027027,"end":1027027,"break":"none","breaks":[[39,"stanza"],[52,"line"]],"ruby":[[0,1,"かれ"],[2,2,"ちかよ"],[6,1,"くち"],[11,1,"とき"],[19,2,"きもの"],[29,1,"かれ"],[31,2,"しゅくふく"],[35,1,"い"],[45,1,"こ"],[52,1,"しゅ"],[54,2,"しゅくふく"],[59,1,"の"]],"text":"彼が近寄って口づけした時、イサクはその着物のかおりをかぎ、彼を祝福して言った、「ああ、わが子のかおりは、主が祝福された野のかおりのようだ。"},{"ref":"Gen.27.28","start":1027028,"end":1027028,"break":"line","breaks":[[11,"line"],[28,"line"]],"ruby":[[3,1,"かみ"],[6,1,"てん"],[8,1,"つゆ"],[11,1,"ち"],[13,1,"こ"],[21,1,"おお"],[24,2,"こくもつ"],[28,1,"あたら"],[34,1,"しゅ"],[41,1,"たま"]],"text":"どうか神が、天の露と、地の肥えたところと、多くの穀物と、新しいぶどう酒とをあなたに賜わるように。"},{"ref":"Gen.27.29","start":1027029,"end":1027029,"break":"line","breaks":[[14,"line"],[32,"line"],[46,"line"],[56,"line"],[71,"line"],[85,"line"]],"ruby":[[5,1,"たみ"],[11,1,"つか"],[19,1,"くに"],[25,1,"み"],[36,2,"きょうだい"],[41,1,"しゅ"],[50,1,"はは"],[52,1,"こ"],[60,1,"み"],[78,1,"もの"],[89,2,"しゅくふく"],[93,1,"もの"],[95,2,"しゅくふく"]],"text":"もろもろの民はあなたに仕え、もろもろの国はあなたに身をかがめる。あなたは兄弟たちの主となり、あなたの母の子らは、あなたに身をかがめるであろう。あなたをのろう者はのろわれ、あなたを祝福する者は祝福される」。"},{"ref":"Gen.27.30","start":1027030,"end":1027030,"break":"paragraph","ruby":[[8,2,"しゅくふく"],[11,1,"おわ"],[19,1,"ちち"],[24,1,"まえ"],[27,1,"で"],[29,1,"い"],[35,1,"あに"],[40,1,"かり"],[43,1,"かえ"]],"text":"イサクがヤコブを祝福し終って、ヤコブが父イサクの前から出て行くとすぐ、兄エサウが狩から帰ってきた。"},{"ref":"Gen.27.31","start":1027031,"end":1027031,"break":"none","ruby":[[0,1,"かれ"],[8,1,"た"],[10,1,"もの"],[12,1,"つく"],[16,1,"ちち"],[18,1,"ところ"],[20,1,"も"],[26,1,"い"],[31,1,"ちち"],[34,1,"お"],[41,1,"こ"],[46,1,"にく"],[48,1,"た"],[63,2,"しゅくふく"]],"text":"彼もまたおいしい食べ物を作って、父の所に持ってきて、言った、「父よ、起きてあなたの子のしかの肉を食べ、あなたみずから、わたしを祝福してください」。"},{"ref":"Gen.27.32","start":1027032,"end":1027032,"break":"none","ruby":[[0,1,"ちち"],[5,1,"かれ"],[7,1,"い"],[22,1,"かれ"],[24,1,"い"],[37,1,"こ"],[39,2,"ちょうし"]],"text":"父イサクは彼に言った、「あなたは、だれか」。彼は言った、「わたしはあなたの子、長子エサウです」。"},{"ref":"Gen.27.33","start":1027033,"end":1027033,"break":"none","ruby":[[4,1,"はげ"],[11,1,"い"],[26,1,"にく"],[28,1,"と"],[36,1,"も"],[41,1,"もの"],[55,1,"く"],[57,1,"まえ"],[63,1,"た"],[66,1,"かれ"],[68,2,"しゅくふく"],[76,1,"かれ"],[78,2,"しゅくふく"],[81,1,"え"]],"text":"イサクは激しくふるえて言った、「それでは、あのしかの肉を取って、わたしに持ってきた者はだれか。わたしはあなたが来る前に、みんな食べて彼を祝福した。ゆえに彼が祝福を得るであろう」。"},{"ref":"Gen.27.34","start":1027034,"end":1027034,"break":"none","ruby":[[4,1,"ちち"],[6,2,"ことば"],[9,1,"き"],[12,1,"とき"],[14,2,"おおごえ"],[20,1,"はげ"],[23,1,"さけ"],[27,1,"ちち"],[29,1,"い"],[34,1,"ちち"],[47,2,"しゅくふく"]],"text":"エサウは父の言葉を聞いた時、大声をあげ、激しく叫んで、父に言った、「父よ、わたしを、わたしをも祝福してください」。"},{"ref":"Gen.27.35","start":1027035,"end":1027035,"break":"none","ruby":[[4,1,"い"],[13,1,"おとうと"],[15,1,"いつわ"],[28,2,"しゅくふく"],[31,1,"うば"]],"text":"イサクは言った、「あなたの弟が偽ってやってきて、あなたの祝福を奪ってしまった」。"},{"ref":"Gen.27.36","start":1027036,"end":1027036,"break":"none","ruby":[[4,1,"い"],[16,1,"な"],[24,1,"かれ"],[27,1,"ど"],[50,2,"ちょうし"],[53,2,"とっけん"],[56,1,"うば"],[67,2,"しゅくふく"],[70,1,"うば"],[77,1,"い"],[93,2,"しゅくふく"],[96,1,"のこ"]],"text":"エサウは言った、「よくもヤコブと名づけたものだ。彼は二度までもわたしをおしのけた。さきには、わたしの長子の特権を奪い、こんどはわたしの祝福を奪った」。また言った、「あなたはわたしのために祝福を残しておかれませんでしたか」。"},{"ref":"Gen.27.37","start":1027037,"end":1027037,"break":"none","ruby":[[4,1,"こた"],[11,1,"い"],[20,1,"かれ"],[26,2,"しゅじん"],[31,2,"きょうだい"],[36,1,"みな"],[43,1,"かれ"],[45,1,"あた"],[50,2,"こくもつ"],[56,1,"しゅ"],[58,1,"かれ"],[60,1,"さづ"],[66,1,"こ"],[69,1,"いま"],[83,1,"なに"]],"text":"イサクは答えてエサウに言った、「わたしは彼をあなたの主人とし、兄弟たちを皆しもべとして彼に与え、また穀物とぶどう酒を彼に授けた。わが子よ、今となっては、あなたのために何ができようか」。"},{"ref":"Gen.27.38","start":1027038,"end":1027038,"break":"none","ruby":[[4,1,"ちち"],[6,1,"い"],[11,1,"ちち"],[18,2,"しゅくふく"],[31,1,"ちち"],[44,2,"しゅくふく"],[58,1,"こえ"],[63,1,"な"]],"text":"エサウは父に言った、「父よ、あなたの祝福はただ一つだけですか。父よ、わたしを、わたしをも祝福してください」。エサウは声をあげて泣いた。"},{"ref":"Gen.27.39","start":1027039,"end":1027039,"break":"paragraph","breaks":[[14,"stanza"],[34,"line"]],"ruby":[[0,1,"ちち"],[5,1,"こた"],[8,1,"かれ"],[10,1,"い"],[23,1,"ち"],[25,1,"こ"],[28,1,"ところ"],[31,1,"はな"],[36,1,"うえ"],[39,1,"てん"],[41,1,"つゆ"],[44,1,"はな"]],"text":"父イサクは答えて彼に言った、「あなたのすみかは地の肥えた所から離れ、また上なる天の露から離れるであろう。"},{"ref":"Gen.27.40","start":1027040,"end":1027040,"break":"line","breaks":[[16,"line"],[30,"line"],[44,"line"]],"ruby":[[11,1,"よ"],[13,1,"わた"],[20,1,"おとうと"],[22,1,"つか"],[38,1,"いさ"],[40,1,"た"],[42,1,"とき"],[44,1,"くび"],[54,1,"ふ"],[56,1,"おと"]],"text":"あなたはつるぎをもって世を渡り、あなたの弟に仕えるであろう。しかし、あなたが勇み立つ時、首から、そのくびきを振り落すであろう」。"},{"ref":"Gen.27.41","start":1027041,"end":1027041,"break":"paragraph","ruby":[[8,1,"ちち"],[14,1,"あた"],[17,2,"しゅくふく"],[27,1,"にく"],[35,1,"こころ"],[37,1,"うち"],[39,1,"い"],[44,1,"ちち"],[46,1,"も"],[48,1,"ひ"],[50,1,"とお"],[62,1,"とき"],[64,1,"おとうと"],[69,1,"ころ"]],"text":"こうしてエサウは父がヤコブに与えた祝福のゆえにヤコブを憎んだ。エサウは心の内で言った、「父の喪の日も遠くはないであろう。その時、弟ヤコブを殺そう」。"},{"ref":"Gen.27.42","start":1027042,"end":1027042,"break":"none","ruby":[[7,2,"ちょうし"],[15,2,"ことば"],[18,1,"ひと"],[22,1,"き"],[28,1,"ひと"],[33,1,"おとうと"],[38,1,"よ"],[41,1,"い"],[46,1,"あに"],[55,1,"ころ"],[59,1,"かんが"],[67,1,"なぐさ"]],"text":"しかしリベカは長子エサウのこの言葉を人づてに聞いたので、人をやり、弟ヤコブを呼んで言った、「兄エサウはあなたを殺そうと考えて、みずから慰めています。"},{"ref":"Gen.27.43","start":1027043,"end":1027043,"break":"none","ruby":[[0,1,"こ"],[3,1,"いま"],[8,2,"ことば"],[11,1,"したが"],[27,1,"あに"]],"text":"子よ、今わたしの言葉に従って、すぐハランにいるわたしの兄ラバンのもとにのがれ、"},{"ref":"Gen.27.44","start":1027044,"end":1027044,"break":"none","ruby":[[4,1,"あに"],[6,1,"いか"],[9,1,"と"],[19,1,"かれ"],[21,1,"ところ"]],"text":"あなたの兄の怒りが解けるまで、しばらく彼の所にいなさい。"},{"ref":"Gen.27.45","start":1027045,"end":1027045,"break":"none","ruby":[[0,1,"あに"],[2,1,"いきどお"],[5,1,"と"],[15,1,"こと"],[17,1,"あに"],[19,1,"わす"],[36,1,"ひと"],[50,1,"むか"],[67,1,"にち"],[81,1,"うしな"]],"text":"兄の憤りが解けて、あなたのした事を兄が忘れるようになったならば、わたしは人をやって、あなたをそこから迎えましょう。どうして、わたしは一日のうちにあなたがたふたりを失ってよいでしょうか」。"},{"ref":"Gen.27.46","start":1027046,"end":1027046,"break":"paragraph","ruby":[[8,1,"い"],[22,1,"むすめ"],[30,1,"い"],[54,1,"ち"],[59,1,"むすめ"],[71,1,"むすめ"],[73,1,"つま"],[85,1,"い"],[91,1,"なに"]],"text":"リベカはイサクに言った、「わたしはヘテびとの娘どものことで、生きているのがいやになりました。もしヤコブがこの地の、あの娘どものようなヘテびとの娘を妻にめとるなら、わたしは生きていて、何になりましょう」。"}]