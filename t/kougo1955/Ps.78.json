[{"ref":"Ps.78.1","start":19078001,"end":19078001,"break":"paragraph","title":"アサフのマスキールの歌","breaks":[[12,"line"]],"ruby":[[2,1,"たみ"],[7,1,"おしえ"],[9,1,"き"],[14,1,"くち"],[16,2,"ことば"],[19,1,"みみ"],[21,1,"かたむ"]],"titleRuby":[[10,1,"うた"]],"text":"わが民よ、わが教を聞き、わが口の言葉に耳を傾けよ。"},{"ref":"Ps.78.2","start":19078002,"end":19078002,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"くち"],[6,1,"ひら"],[14,1,"かた"],[28,1,"かた"]],"text":"わたしは口を開いて、たとえを語り、いにしえからの、なぞを語ろう。"},{"ref":"Ps.78.3","start":19078003,"end":19078003,"break":"line","breaks":[[19,"line"],[30,"line"]],"ruby":[[10,1,"き"],[13,1,"し"],[25,2,"せんぞ"],[34,1,"かた"],[36,1,"つた"]],"text":"これはわれらがさきに聞いて知ったこと、またわれらの先祖たちがわれらに語り伝えたことである。"},{"ref":"Ps.78.4","start":19078004,"end":19078004,"break":"line","breaks":[[25,"line"],[45,"line"]],"ruby":[[7,2,"しそん"],[10,1,"かく"],[14,1,"しゅ"],[16,2,"こうえい"],[27,1,"ちから"],[30,1,"しゅ"],[50,1,"よ"],[52,1,"つ"]],"text":"われらはこれを子孫に隠さず、主の光栄あるみわざと、その力と、主のなされたくすしきみわざとをきたるべき代に告げるであろう。"},{"ref":"Ps.78.5","start":19078005,"end":19078005,"break":"line","breaks":[[16,"line"],[33,"line"],[45,"line"]],"ruby":[[0,1,"しゅ"],[29,1,"さだ"],[35,2,"しそん"],[38,1,"おしえ"],[49,2,"せんぞ"],[54,1,"めい"]],"text":"主はあかしをヤコブのうちにたて、おきてをイスラエルのうちに定めて、その子孫に教うべきことをわれらの先祖たちに命じられた。"},{"ref":"Ps.78.6","start":19078006,"end":19078006,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"つぎ"],[5,1,"よ"],[7,1,"うま"],[10,2,"しそん"],[16,1,"し"],[23,1,"おこ"],[31,2,"しそん"],[37,1,"つた"]],"text":"これは次の代に生れる子孫がこれを知り、みずから起って、そのまた子孫にこれを伝え、"},{"ref":"Ps.78.7","start":19078007,"end":19078007,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[5,1,"かみ"],[7,1,"のぞ"],[13,1,"かみ"],[19,1,"わす"],[25,1,"いまし"],[28,1,"まも"]],"text":"彼らをして神に望みをおき、神のみわざを忘れず、その戒めを守らせるためである。"},{"ref":"Ps.78.8","start":19078008,"end":19078008,"break":"line","breaks":[[18,"line"],[40,"line"],[55,"line"]],"ruby":[[4,2,"せんぞ"],[21,1,"もの"],[32,1,"こころ"],[34,1,"さだ"],[42,1,"たましい"],[44,1,"かみ"],[46,2,"ちゅうじつ"]],"text":"またその先祖たちのようにかたくなで、そむく者のやからとなり、その心が定まりなく、その魂が神に忠実でないやからとならないためである。"},{"ref":"Ps.78.9","start":19078009,"end":19078009,"break":"line","breaks":[[20,"line"]],"ruby":[[6,2,"ひとびと"],[9,2,"ぶそう"],[13,1,"ゆみ"],[15,1,"たずさ"],[20,1,"たたか"],[23,1,"ひ"],[25,1,"ひ"],[27,1,"かえ"]],"text":"エフライムの人々は武装し、弓を携えたが、戦いの日に引き返した。"},{"ref":"Ps.78.10","start":19078010,"end":19078010,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,2,"けいやく"],[8,1,"まも"],[23,1,"あゆ"],[28,1,"こば"]],"text":"彼らは神の契約を守らず、そのおきてにしたがって歩むことを拒み、"},{"ref":"Ps.78.11","start":19078011,"end":19078011,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"かみ"],[6,1,"こと"],[9,1,"かれ"],[12,1,"しめ"],[25,1,"わす"]],"text":"神がなされた事と、彼らに示されたくすしきみわざとを忘れた。"},{"ref":"Ps.78.12","start":19078012,"end":19078012,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[7,1,"ち"],[14,1,"の"],[24,1,"かれ"],[27,2,"せんぞ"],[32,1,"まえ"],[34,1,"おこな"]],"text":"神はエジプトの地と、ゾアンの野でくすしきみわざを彼らの先祖たちの前に行われた。"},{"ref":"Ps.78.13","start":19078013,"end":19078013,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[2,1,"うみ"],[4,1,"わ"],[7,1,"かれ"],[10,1,"とお"],[14,1,"みず"],[16,1,"た"],[20,1,"やま"]],"text":"神は海を分けて彼らを通らせ、水を立たせて山のようにされた。"},{"ref":"Ps.78.14","start":19078014,"end":19078014,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ひる"],[2,1,"くも"],[7,1,"かれ"],[10,1,"みちび"],[13,1,"よる"],[21,1,"ひ"],[23,1,"ひかり"],[28,1,"かれ"],[31,1,"みちび"]],"text":"昼は雲をもって彼らを導き、夜は、よもすがら火の光をもって彼らを導かれた。"},{"ref":"Ps.78.15","start":19078015,"end":19078015,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"かみ"],[2,2,"あらの"],[5,1,"いわ"],[7,1,"さ"],[10,1,"ふち"],[13,1,"の"],[18,1,"ゆた"],[21,1,"かれ"],[24,1,"の"]],"text":"神は荒野で岩を裂き、淵から飲むように豊かに彼らに飲ませ、"},{"ref":"Ps.78.16","start":19078016,"end":19078016,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"いわ"],[5,1,"なが"],[8,1,"ひ"],[12,1,"かわ"],[17,1,"みず"],[19,1,"なが"]],"text":"また岩から流れを引いて、川のように水を流れさせられた。"},{"ref":"Ps.78.17","start":19078017,"end":19078017,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"かれ"],[9,1,"かみ"],[15,1,"つみ"],[21,2,"あらの"],[26,1,"たか"],[28,1,"もの"]],"text":"ところが彼らはなお神にむかって罪をかさね、荒野でいと高き者にそむき、"},{"ref":"Ps.78.18","start":19078018,"end":19078018,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"よく"],[8,2,"しょくもつ"],[11,1,"もと"],[17,1,"こころ"],[22,1,"かみ"],[24,1,"こころ"]],"text":"おのが欲のために食物を求めて、その心のうちに神を試みた。"},{"ref":"Ps.78.19","start":19078019,"end":19078019,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"かれ"],[5,1,"かみ"],[7,1,"さか"],[11,1,"い"],[16,1,"かみ"],[18,2,"あらの"],[21,1,"うたげ"],[23,1,"もう"]],"text":"また彼らは神に逆らって言った、「神は荒野に宴を設けることができるだろうか。"},{"ref":"Ps.78.20","start":19078020,"end":19078020,"break":"line","breaks":[[13,"line"],[31,"line"],[52,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[5,1,"いわ"],[7,1,"う"],[13,1,"みず"],[23,1,"なが"],[31,1,"かみ"],[38,1,"あた"],[52,1,"たみ"],[57,1,"にく"],[59,1,"そな"]],"text":"見よ、神が岩を打たれると、水はほとばしりいで、流れがあふれた。神はまたパンを与えることができるだろうか。民のために肉を備えることができるだろうか」と。"},{"ref":"Ps.78.21","start":19078021,"end":19078021,"break":"line","breaks":[[15,"line"],[31,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"き"],[10,1,"いきどお"],[15,1,"ひ"],[25,1,"も"],[31,1,"いか"],[44,1,"た"]],"text":"それゆえ、主は聞いて憤られた。火はヤコブにむかって燃えあがり、怒りはイスラエルにむかって立ちのぼった。"},{"ref":"Ps.78.22","start":19078022,"end":19078022,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"かれ"],[6,1,"かみ"],[8,1,"しん"],[14,1,"すくい"],[16,1,"ちから"],[18,2,"しんよう"]],"text":"これは彼らが神を信ぜず、その救の力を信用しなかったからである。"},{"ref":"Ps.78.23","start":19078023,"end":19078023,"break":"line","ruby":[[3,1,"かみ"],[5,1,"うえ"],[8,2,"おおぞら"],[11,1,"めい"],[14,1,"てん"],[16,1,"と"],[18,1,"ひら"]],"text":"しかし神は上なる大空に命じて天の戸を開き、"},{"ref":"Ps.78.24","start":19078024,"end":19078024,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"うえ"],[8,1,"ふ"],[12,1,"た"],[17,1,"てん"],[19,2,"こくもつ"],[22,1,"かれ"],[25,1,"あた"]],"text":"彼らの上にマナを降らせて食べさせ、天の穀物を彼らに与えられた。"},{"ref":"Ps.78.25","start":19078025,"end":19078025,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ひと"],[2,2,"てんし"],[8,1,"た"],[12,1,"かみ"],[14,1,"かれ"],[17,2,"しょくもつ"],[24,1,"あ"],[26,1,"た"]],"text":"人は天使のパンを食べた。神は彼らに食物をおくって飽き足らせられた。"},{"ref":"Ps.78.26","start":19078026,"end":19078026,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かみ"],[2,1,"てん"],[4,2,"ひがしかぜ"],[7,1,"ふ"],[12,1,"ちから"],[17,2,"みなみかぜ"],[20,1,"みちび"]],"text":"神は天に東風を吹かせ、み力をもって南風を導かれた。"},{"ref":"Ps.78.27","start":19078027,"end":19078027,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[5,1,"うえ"],[7,1,"にく"],[15,1,"ふ"],[19,1,"つばさ"],[22,1,"とり"],[24,1,"うみ"],[26,1,"すな"],[31,1,"ふ"]],"text":"神は彼らの上に肉をちりのように降らせ、翼ある鳥を海の砂のように降らせて、"},{"ref":"Ps.78.28","start":19078028,"end":19078028,"break":"line","ruby":[[2,2,"しゅくえい"],[18,1,"おと"]],"text":"その宿営のなか、そのすまいのまわりに落された。"},{"ref":"Ps.78.29","start":19078029,"end":19078029,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"かれ"],[7,1,"た"],[11,1,"あ"],[13,1,"た"],[22,1,"かみ"],[24,1,"かれ"],[29,1,"のぞ"],[35,1,"あた"]],"text":"こうして彼らは食べて、飽き足ることができた。神が彼らにその望んだものを与えられたからである。"},{"ref":"Ps.78.30","start":19078030,"end":19078030,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"かれ"],[11,1,"よく"],[13,1,"はな"],[17,2,"しょくもつ"],[22,1,"くち"],[24,1,"なか"]],"text":"ところが彼らがまだその欲を離れず、食物がなお口の中にあるうちに、"},{"ref":"Ps.78.31","start":19078031,"end":19078031,"break":"line","breaks":[[18,"line"],[33,"line"]],"ruby":[[0,1,"かみ"],[2,1,"いか"],[5,1,"かれ"],[12,1,"た"],[18,1,"かれ"],[24,1,"もっと"],[26,1,"つよ"],[28,1,"もの"],[30,1,"ころ"],[44,1,"ぬ"],[47,1,"もの"],[49,1,"う"],[51,1,"たお"]],"text":"神の怒りが彼らにむかって立ちのぼり、彼らのうちの最も強い者を殺し、イスラエルのうちのえり抜きの者を打ち倒された。"},{"ref":"Ps.78.32","start":19078032,"end":19078032,"break":"line","breaks":[[20,"line"],[30,"line"]],"ruby":[[7,1,"こと"],[20,1,"かれ"],[25,1,"つみ"],[27,1,"おか"],[40,1,"しん"]],"text":"すべてこれらの事があったにもかかわらず、彼らはなお罪を犯し、そのくすしきみわざを信じなかった。"},{"ref":"Ps.78.33","start":19078033,"end":19078033,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"かみ"],[6,1,"かれ"],[9,1,"ひ"],[11,1,"いき"],[16,1,"き"],[21,1,"かれ"],[24,1,"とし"],[26,1,"おそ"],[32,1,"す"]],"text":"それゆえ神は彼らの日を息のように消えさせ、彼らの年を恐れをもって過ごさせられた。"},{"ref":"Ps.78.34","start":19078034,"end":19078034,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[5,1,"ころ"],[12,1,"かれ"],[15,1,"かみ"],[21,1,"く"],[24,1,"かみ"],[26,2,"ねっしん"],[29,1,"もと"]],"text":"神が彼らを殺されたとき、彼らは神をたずね、悔いて神を熱心に求めた。"},{"ref":"Ps.78.35","start":19078035,"end":19078035,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"かれ"],[8,1,"かみ"],[10,1,"かれ"],[13,1,"いわ"],[17,1,"たか"],[19,1,"かみ"],[21,1,"かれ"],[36,1,"おも"],[38,1,"だ"]],"text":"こうして彼らは、神は彼らの岩、いと高き神は彼らのあがないぬしであることを思い出した。"},{"ref":"Ps.78.36","start":19078036,"end":19078036,"break":"line","breaks":[[20,"line"]],"ruby":[[3,1,"かれ"],[8,1,"くち"],[13,1,"かみ"],[22,1,"した"],[27,1,"かみ"],[29,1,"いつわ"],[32,1,"い"]],"text":"しかし彼らはその口をもって神にへつらい、その舌をもって神に偽りを言った。"},{"ref":"Ps.78.37","start":19078037,"end":19078037,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こころ"],[5,1,"かみ"],[11,2,"けんじつ"],[17,1,"かみ"],[19,2,"けいやく"],[22,2,"しんじつ"]],"text":"彼らの心は神にむかって堅実でなく、神の契約に真実でなかった。"},{"ref":"Ps.78.38","start":19078038,"end":19078038,"break":"line","breaks":[[17,"line"],[32,"line"],[46,"line"]],"ruby":[[3,1,"かみ"],[10,1,"と"],[17,1,"かれ"],[20,2,"ふぎ"],[27,1,"ほろ"],[38,1,"いか"],[48,1,"いきどお"],[58,1,"おこ"]],"text":"しかし神はあわれみに富まれるので、彼らの不義をゆるして滅ぼさず、しばしばその怒りをおさえて、その憤りをことごとくふり起されなかった。"},{"ref":"Ps.78.39","start":19078039,"end":19078039,"break":"line","breaks":[[16,"line"],[34,"line"]],"ruby":[[2,1,"かみ"],[5,1,"かれ"],[10,1,"にく"],[16,1,"す"],[18,1,"さ"],[21,1,"ふたた"],[23,1,"かえ"],[27,1,"かぜ"],[34,1,"おも"],[36,1,"だ"]],"text":"また神は、彼らがただ肉であって、過ぎ去れば再び帰りこぬ風であることを思い出された。"},{"ref":"Ps.78.40","start":19078040,"end":19078040,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"いく"],[3,1,"かれ"],[6,1,"の"],[8,1,"かみ"],[14,2,"あらの"],[17,1,"かみ"],[19,1,"かな"]],"text":"幾たび彼らは野で神にそむき、荒野で神を悲しませたことであろうか。"},{"ref":"Ps.78.41","start":19078041,"end":19078041,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[9,1,"かみ"],[11,1,"こころ"],[20,2,"せいじゃ"],[23,1,"いか"]],"text":"彼らはかさねがさね神を試み、イスラエルの聖者を怒らせた。"},{"ref":"Ps.78.42","start":19078042,"end":19078042,"break":"line","breaks":[[9,"line"],[27,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,1,"ちから"],[9,1,"かみ"],[11,1,"かれ"],[24,1,"ひ"],[27,1,"おも"],[29,1,"だ"]],"text":"彼らは神の力をも、神が彼らをあだからあがなわれた日をも思い出さなかった。"},{"ref":"Ps.78.43","start":19078043,"end":19078043,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かみ"],[25,1,"の"],[32,2,"きせき"]],"text":"神はエジプトでもろもろのしるしをおこない、ゾアンの野でもろもろの奇跡をおこない、"},{"ref":"Ps.78.44","start":19078044,"end":19078044,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かわ"],[5,1,"ち"],[7,1,"かわ"],[14,1,"なが"],[17,1,"の"]],"text":"彼らの川を血に変らせて、その流れを飲むことができないようにされた。"},{"ref":"Ps.78.45","start":19078045,"end":19078045,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かみ"],[5,1,"む"],[8,1,"かれ"],[14,1,"おく"],[17,1,"かれ"],[20,1,"く"],[28,1,"おく"],[31,1,"かれ"],[34,1,"ほろ"]],"text":"神ははえの群れを彼らのうちに送って彼らを食わせ、かえるを送って彼らを滅ぼされた。"},{"ref":"Ps.78.46","start":19078046,"end":19078046,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"かみ"],[4,1,"かれ"],[7,2,"さくもつ"],[10,2,"あおむし"],[17,1,"かれ"],[20,2,"きんろう"],[23,1,"み"]],"text":"また神は彼らの作物を青虫にわたし、彼らの勤労の実をいなごにわたされた。"},{"ref":"Ps.78.47","start":19078047,"end":19078047,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かみ"],[9,1,"かれ"],[16,1,"き"],[18,1,"か"],[22,1,"しも"],[27,1,"かれ"],[34,1,"くわ"],[36,1,"き"],[38,1,"か"]],"text":"神はひょうをもって彼らのぶどうの木を枯らし、霜をもって彼らのいちじく桑の木を枯らされた。"},{"ref":"Ps.78.48","start":19078048,"end":19078048,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[5,2,"かちく"],[16,1,"かれ"],[19,1,"む"],[22,1,"も"]],"text":"神は彼らの家畜をひょうにわたし、彼らの群れを燃えるいなずまにわたされた。"},{"ref":"Ps.78.49","start":19078049,"end":19078049,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[5,1,"うえ"],[7,1,"はげ"],[10,1,"いか"],[14,1,"いきどお"],[18,1,"うら"],[22,1,"なや"],[26,1,"ほろ"],[29,2,"てんし"],[32,1,"む"],[36,1,"はな"]],"text":"神は彼らの上に激しい怒りと、憤りと、恨みと、悩みと、滅ぼす天使の群れとを放たれた。"},{"ref":"Ps.78.50","start":19078050,"end":19078050,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[0,1,"かみ"],[4,1,"いか"],[10,1,"みち"],[12,1,"もう"],[15,1,"かれ"],[18,1,"たましい"],[20,1,"し"],[23,1,"まぬか"],[35,2,"えきびょう"]],"text":"神はその怒りのために道を設け、彼らの魂を死から免れさせず、そのいのちを疫病にわたされた。"},{"ref":"Ps.78.51","start":19078051,"end":19078051,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[15,1,"う"],[21,2,"てんまく"],[24,1,"かれ"],[27,1,"ちから"],[29,1,"はじ"],[32,1,"こ"],[34,1,"う"]],"text":"神はエジプトですべてのういごを撃ち、ハムの天幕で彼らの力の初めの子を撃たれた。"},{"ref":"Ps.78.52","start":19078052,"end":19078052,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"かみ"],[10,1,"たみ"],[12,1,"ひつじ"],[17,1,"ひ"],[19,1,"だ"],[22,1,"かれ"],[25,2,"あらの"],[28,1,"ひつじ"],[30,1,"む"],[36,1,"みちび"]],"text":"こうして神はおのれの民を羊のように引き出し、彼らを荒野で羊の群れのように導き、"},{"ref":"Ps.78.53","start":19078053,"end":19078053,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[0,1,"かれ"],[3,1,"やす"],[7,1,"みちび"],[13,1,"かれ"],[16,1,"おそ"],[30,1,"うみ"],[32,1,"かれ"],[35,1,"てき"]],"text":"彼らを安らかに導かれたので彼らは恐れることがなかった。しかし海は彼らの敵をのみつくした。"},{"ref":"Ps.78.54","start":19078054,"end":19078054,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[7,2,"せいち"],[10,1,"ともな"],[15,1,"みぎ"],[17,1,"て"],[22,1,"え"],[26,1,"やま"],[28,1,"ともな"]],"text":"神は彼らをその聖地に伴い、その右の手をもって獲たこの山に伴いこられた。"},{"ref":"Ps.78.55","start":19078055,"end":19078055,"break":"line","breaks":[[21,"line"],[33,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[5,1,"まえ"],[13,2,"くにたみ"],[16,1,"お"],[18,1,"だ"],[23,1,"ち"],[25,1,"わ"],[28,1,"し"],[29,1,"ぎょう"],[39,1,"しょ"],[40,1,"ぞく"],[42,1,"かれ"],[45,2,"てんまく"],[48,1,"す"]],"text":"神は彼らの前からもろもろの国民を追い出し、その地を分けて嗣業とし、イスラエルの諸族を彼らの天幕に住まわせられた。"},{"ref":"Ps.78.56","start":19078056,"end":19078056,"break":"line","breaks":[[23,"line"]],"ruby":[[3,1,"かれ"],[8,1,"たか"],[10,1,"かみ"],[12,1,"こころ"],[34,1,"まも"]],"text":"しかし彼らはいと高き神を試み、これにそむいて、そのもろもろのあかしを守らず、"},{"ref":"Ps.78.57","start":19078057,"end":19078057,"break":"line","breaks":[[21,"line"]],"ruby":[[3,1,"さ"],[7,2,"せんぞ"],[15,2,"しんじつ"],[18,1,"うしな"],[21,1,"くる"],[24,1,"ゆみ"]],"text":"そむき去って、先祖たちのように真実を失い、狂った弓のようにねじれた。"},{"ref":"Ps.78.58","start":19078058,"end":19078058,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[3,1,"たか"],[5,1,"ところ"],[7,1,"もう"],[10,1,"かみ"],[12,1,"いか"],[16,1,"きざ"],[19,1,"ぞう"],[24,1,"かみ"],[30,1,"おこ"]],"text":"彼らは高き所を設けて神を怒らせ、刻んだ像をもって神のねたみを起した。"},{"ref":"Ps.78.59","start":19078059,"end":19078059,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かみ"],[2,1,"き"],[5,1,"おお"],[8,1,"いか"],[17,1,"まった"]],"text":"神は聞いて大いに怒り、イスラエルを全くしりぞけられた。"},{"ref":"Ps.78.60","start":19078060,"end":19078060,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かみ"],[2,2,"ひとびと"],[8,1,"もう"],[11,2,"まくや"],[22,1,"す"]],"text":"神は人々のなかに設けた幕屋なるシロのすまいを捨て、"},{"ref":"Ps.78.61","start":19078061,"end":19078061,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"ちから"],[14,2,"えいこう"],[20,1,"て"]],"text":"その力をとりことならせ、その栄光をあだの手にわたされた。"},{"ref":"Ps.78.62","start":19078062,"end":19078062,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[4,1,"たみ"],[16,1,"し"],[17,1,"ぎょう"],[23,1,"おお"],[27,1,"いか"]],"text":"神はその民をつるぎにわたし、その嗣業にむかって大いなる怒りをもらされた。"},{"ref":"Ps.78.63","start":19078063,"end":19078063,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ひ"],[2,1,"かれ"],[5,2,"わかもの"],[10,1,"や"],[16,1,"かれ"],[25,2,"こんいん"],[28,1,"うた"],[30,1,"うしな"]],"text":"火は彼らの若者たちを焼きつくし、彼らのおとめたちは婚姻の歌を失い、"},{"ref":"Ps.78.64","start":19078064,"end":19078064,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,2,"さいし"],[15,1,"たお"],[18,1,"かれ"],[27,1,"なげ"],[29,1,"かな"]],"text":"彼らの祭司たちはつるぎによって倒れ、彼らのやもめたちは嘆き悲しむことさえしなかった。"},{"ref":"Ps.78.65","start":19078065,"end":19078065,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"ねむ"],[9,1,"もの"],[18,2,"ゆうし"],[21,1,"さけ"],[26,1,"さけ"],[31,1,"め"]],"text":"そのとき主は眠った者のさめたように、勇士が酒によって叫ぶように目をさまして、"},{"ref":"Ps.78.66","start":19078066,"end":19078066,"break":"line","breaks":[[10,"line"]],"ruby":[[5,1,"う"],[7,1,"しりぞ"],[15,1,"はじ"],[17,1,"かれ"],[20,1,"お"]],"text":"そのあだを撃ち退け、とこしえの恥を彼らに負わせられた。"},{"ref":"Ps.78.67","start":19078067,"end":19078067,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[6,2,"てんまく"],[20,2,"ぶぞく"],[23,1,"えら"]],"text":"神はヨセフの天幕をしりぞけ、エフライムの部族を選ばず、"},{"ref":"Ps.78.68","start":19078068,"end":19078068,"break":"line","breaks":[[9,"line"]],"ruby":[[3,2,"ぶぞく"],[6,1,"えら"],[9,1,"かみ"],[11,1,"あい"],[18,1,"やま"],[20,1,"えら"]],"text":"ユダの部族を選び、神の愛するシオンの山を選ばれた。"},{"ref":"Ps.78.69","start":19078069,"end":19078069,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かみ"],[4,2,"せいじょ"],[7,1,"たか"],[9,1,"てん"],[14,1,"た"],[22,1,"もとい"],[24,1,"さだ"],[29,1,"ち"],[34,1,"た"]],"text":"神はその聖所を高い天のように建て、とこしえに基を定められた地のように建てられた。"},{"ref":"Ps.78.70","start":19078070,"end":19078070,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かみ"],[11,1,"えら"],[15,1,"ひつじ"],[21,1,"と"]],"text":"神はそのしもべダビデを選んで、羊のおりから取り、"},{"ref":"Ps.78.71","start":19078071,"end":19078071,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"ちち"],[2,1,"あた"],[5,1,"めす"],[6,1,"ひつじ"],[8,1,"ばん"],[20,1,"き"],[25,1,"たみ"],[32,1,"し"],[33,1,"ぎょう"],[40,2,"ぼくしゃ"]],"text":"乳を与える雌羊の番をするところからつれて来て、その民ヤコブ、その嗣業イスラエルの牧者とされた。"},{"ref":"Ps.78.72","start":19078072,"end":19078072,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かれ"],[6,1,"なお"],[8,1,"こころ"],[13,1,"かれ"],[16,1,"ぼく"],[19,1,"たく"],[22,1,"て"],[27,1,"かれ"],[30,1,"みちび"]],"text":"こうして彼は直き心をもって彼らを牧し、巧みな手をもって彼らを導いた。"}]