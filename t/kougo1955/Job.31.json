[{"ref":"Job.31.1","start":18031001,"end":18031001,"break":"paragraph","breaks":[[11,"line"],[18,"line"]],"ruby":[[9,1,"め"],[11,2,"けいやく"],[14,1,"むす"],[27,1,"した"]],"text":"わたしは、わたしの目と契約を結んだ、どうして、おとめを慕うことができようか。"},{"ref":"Job.31.2","start":18031002,"end":18031002,"break":"line","breaks":[[18,"line"],[27,"line"],[44,"line"]],"ruby":[[7,1,"うえ"],[10,1,"かみ"],[12,1,"くだ"],[16,1,"ぶん"],[27,1,"たか"],[29,1,"ところ"],[32,3,"ぜんのうしゃ"],[36,1,"あた"],[41,1,"し"],[42,1,"ぎょう"]],"text":"もしそうすれば上から神の下される分はどんなであろうか。高き所から全能者の与えられる嗣業はどんなであろうか。"},{"ref":"Job.31.3","start":18031003,"end":18031003,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"ふぎ"],[4,1,"もの"],[7,1,"わざわい"],[9,1,"くだ"],[19,1,"あく"],[23,1,"もの"],[26,2,"さいなん"],[29,1,"のぞ"]],"text":"不義なる者には災が下らないであろうか。悪をなす者には災難が臨まないであろうか。"},{"ref":"Job.31.4","start":18031004,"end":18031004,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[6,1,"みち"],[18,1,"あゆ"],[26,1,"かぞ"]],"text":"彼はわたしの道をみそなわし、わたしの歩みをことごとく数えられぬであろうか。"},{"ref":"Job.31.5","start":18031005,"end":18031005,"break":"line","breaks":[[15,"line"],[28,"line"]],"ruby":[[10,1,"とも"],[12,1,"あゆ"],[19,1,"あし"],[21,1,"いつわ"],[28,1,"いそ"]],"text":"もし、わたしがうそと共に歩み、わたしの足が偽りにむかって急いだことがあるなら、"},{"ref":"Job.31.6","start":18031006,"end":18031006,"break":"line","breaks":[[18,"line"]],"ruby":[[1,1,"ただ"],[15,1,"はか"],[23,1,"かみ"],[29,2,"けっぱく"],[32,1,"し"]],"text":"（正しいはかりをもってわたしを量れ、そうすれば神はわたしの潔白を知られるであろう。）"},{"ref":"Job.31.7","start":18031007,"end":18031007,"break":"line","breaks":[[16,"line"],[36,"line"]],"ruby":[[6,1,"あゆ"],[10,1,"みち"],[20,1,"こころ"],[26,1,"め"],[33,1,"あゆ"],[40,1,"て"],[42,1,"けが"]],"text":"もしわたしの歩みが、道をはなれ、わたしの心がわたしの目にしたがって歩み、わたしの手に汚れがついていたなら、"},{"ref":"Job.31.8","start":18031008,"end":18031008,"break":"line","breaks":[[16,"line"],[31,"line"]],"ruby":[[9,1,"た"],[11,1,"ひと"],[13,1,"た"],[23,2,"せいちょう"],[31,1,"ぬ"],[33,1,"と"]],"text":"わたしのまいたのを他の人が食べ、わたしのために成長するものが、抜き取られてもかまわない。"},{"ref":"Job.31.9","start":18031009,"end":18031009,"break":"line","breaks":[[22,"line"],[34,"line"]],"ruby":[[7,1,"こころ"],[10,1,"おんな"],[12,1,"まよ"],[28,1,"とな"],[30,1,"びと"],[32,1,"もん"],[34,1,"ま"],[36,1,"ぶ"]],"text":"もし、わたしの心が、女に迷ったことがあるか、またわたしが隣り人の門で待ち伏せしたことがあるなら、"},{"ref":"Job.31.10","start":18031010,"end":18031010,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"つま"],[6,1,"た"],[8,1,"ひと"],[19,1,"た"],[21,1,"ひと"],[23,2,"かのじょ"],[26,1,"うえ"],[28,1,"ね"]],"text":"わたしの妻が他の人のためにうすをひき、他の人が彼女の上に寝てもかまわない。"},{"ref":"Job.31.11","start":18031011,"end":18031011,"break":"line","breaks":[[11,"line"]],"ruby":[[3,1,"おも"],[5,1,"つみ"],[17,1,"ばっ"],[24,2,"あくじ"]],"text":"これは重い罪であって、さばきびとに罰せられるべき悪事だからである。"},{"ref":"Job.31.12","start":18031012,"end":18031012,"break":"line","breaks":[[22,"line"]],"ruby":[[3,1,"ほろ"],[6,1,"いた"],[11,1,"や"],[16,1,"ひ"],[30,2,"さんぎょう"],[33,1,"ね"],[37,1,"や"]],"text":"これは滅びに至るまでも焼きつくす火であって、わたしのすべての産業を根こそぎ焼くであろう。"},{"ref":"Job.31.13","start":18031013,"end":18031013,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[20,1,"い"],[22,1,"あらそ"],[37,1,"い"],[39,1,"ぶん"],[41,1,"しりぞ"]],"text":"わたしのしもべ、また、はしためがわたしと言い争ったときに、わたしがもしその言い分を退けたことがあるなら、"},{"ref":"Job.31.14","start":18031014,"end":18031014,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かみ"],[2,1,"た"],[4,1,"あ"],[23,1,"かみ"],[25,1,"たず"],[37,1,"こた"]],"text":"神が立ち上がられるとき、わたしはどうしようか、神が尋ねられるとき、なんとお答えしようか。"},{"ref":"Job.31.15","start":18031015,"end":18031015,"break":"line","breaks":[[14,"line"],[28,"line"],[45,"line"]],"ruby":[[4,2,"たいない"],[7,1,"つく"],[11,1,"もの"],[14,1,"かれ"],[17,1,"つく"],[33,1,"はら"],[35,1,"うち"],[37,1,"かたち"],[38,1,"つく"],[42,1,"もの"]],"text":"わたしを胎内に造られた者は、彼をも造られたのではないか。われわれを腹の内に形造られた者は、ただひとりではないか。"},{"ref":"Job.31.16","start":18031016,"end":18031016,"break":"line","breaks":[[17,"line"]],"ruby":[[6,1,"まず"],[9,1,"もの"],[11,1,"ねが"],[14,1,"しりぞ"],[21,1,"め"],[23,1,"おとろ"]],"text":"わたしがもし貧しい者の願いを退け、やもめの目を衰えさせ、"},{"ref":"Job.31.17","start":18031017,"end":18031017,"break":"line","breaks":[[18,"line"]],"ruby":[[11,2,"しょくもつ"],[14,1,"た"],[23,1,"た"]],"text":"あるいはわたしひとりで食物を食べて、みなしごに食べさせなかったことがあるなら、"},{"ref":"Job.31.18","start":18031018,"end":18031018,"break":"line","breaks":[[22,"line"]],"ruby":[[5,1,"かれ"],[7,1,"おさな"],[9,1,"とき"],[12,1,"ちち"],[17,1,"かれ"],[19,1,"そだ"],[26,1,"はは"],[28,1,"たい"],[30,1,"で"],[36,1,"かれ"],[38,1,"みちび"]],"text":"（わたしは彼の幼い時から父のように彼を育て、またその母の胎を出たときから彼を導いた。）"},{"ref":"Job.31.19","start":18031019,"end":18031019,"break":"line","breaks":[[19,"line"]],"ruby":[[2,2,"きもの"],[10,1,"し"],[16,1,"もの"],[19,1,"み"],[24,1,"もの"],[28,1,"まず"],[31,1,"ひと"],[37,1,"み"],[39,1,"とき"]],"text":"もし着物がないために死のうとする者や、身をおおう物のない貧しい人をわたしが見た時に、"},{"ref":"Job.31.20","start":18031020,"end":18031020,"break":"line","breaks":[[13,"line"],[25,"line"]],"ruby":[[2,1,"こし"],[8,2,"しゅくふく"],[15,1,"かれ"],[21,1,"ひつじ"],[23,1,"け"],[25,1,"あたた"]],"text":"その腰がわたしを祝福せず、また彼がわたしの羊の毛で暖まらなかったことがあるなら、"},{"ref":"Job.31.21","start":18031021,"end":18031021,"break":"line","breaks":[[20,"line"],[35,"line"]],"ruby":[[6,1,"たす"],[9,1,"もの"],[11,1,"もん"],[17,1,"み"],[33,1,"て"],[35,1,"ふ"],[37,1,"あ"]],"text":"もしわたしを助ける者が門におるのを見て、みなしごにむかってわたしの手を振り上げたことがあるなら、"},{"ref":"Job.31.22","start":18031022,"end":18031022,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"かた"],[5,1,"ほね"],[8,1,"かた"],[11,1,"お"],[18,1,"うで"],[23,1,"ね"],[26,1,"お"]],"text":"わたしの肩骨が、肩から落ち、わたしの腕が、つけ根から折れてもかまわない。"},{"ref":"Job.31.23","start":18031023,"end":18031023,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"かみ"],[7,1,"で"],[9,1,"わざわい"],[11,1,"おそ"],[17,2,"いこう"],[20,1,"まえ"],[23,2,"なにごと"]],"text":"わたしは神から出る災を恐れる、その威光の前には何事もなすことはできない。"},{"ref":"Job.31.24","start":18031024,"end":18031024,"break":"line","breaks":[[15,"line"]],"ruby":[[6,1,"きん"],[10,1,"のぞ"],[15,1,"せい"],[16,1,"きん"],[20,1,"たの"],[23,1,"い"]],"text":"わたしがもし金をわが望みとし、精金をわが頼みと言ったことがあるなら、"},{"ref":"Job.31.25","start":18031025,"end":18031025,"break":"line","breaks":[[17,"line"],[33,"line"]],"ruby":[[8,1,"とみ"],[10,1,"おお"],[14,1,"こと"],[21,1,"て"],[23,1,"おお"],[26,1,"もの"],[28,1,"え"],[30,1,"こと"],[33,1,"よろこ"]],"text":"わたしがもしわが富の大いなる事と、わたしの手に多くの物を獲た事とを喜んだことがあるなら、"},{"ref":"Job.31.26","start":18031026,"end":18031026,"break":"line","breaks":[[14,"line"]],"ruby":[[6,1,"ひ"],[8,1,"かがや"],[12,1,"み"],[17,1,"つき"],[19,1,"て"],[25,1,"うご"],[29,1,"み"],[31,1,"とき"]],"text":"わたしがもし日の輝くのを見、または月の照りわたって動くのを見た時、"},{"ref":"Job.31.27","start":18031027,"end":18031027,"break":"line","ruby":[[0,1,"こころ"],[5,1,"まよ"],[9,1,"て"],[11,1,"くち"]],"text":"心ひそかに迷って、手に口づけしたことがあるなら、"},{"ref":"Job.31.28","start":18031028,"end":18031028,"break":"line","breaks":[[21,"line"]],"ruby":[[11,1,"ばっ"],[17,2,"あくじ"],[25,1,"うえ"],[28,1,"かみ"],[30,1,"あざむ"]],"text":"これもまたさばきびとに罰せらるべき悪事だ。わたしは上なる神を欺いたからである。"},{"ref":"Job.31.29","start":18031029,"end":18031029,"break":"line","breaks":[[22,"line"],[35,"line"]],"ruby":[[10,1,"にく"],[12,1,"もの"],[14,1,"ほろ"],[19,1,"よろこ"],[25,1,"わざわい"],[27,1,"かれ"],[29,1,"のぞ"],[35,1,"か"],[37,1,"ほこ"]],"text":"わたしがもしわたしを憎む者の滅びるのを喜び、または災が彼に臨んだとき、勝ち誇ったことがあるなら、"},{"ref":"Job.31.30","start":18031030,"end":18031030,"break":"line","breaks":[[16,"line"]],"ruby":[[7,1,"くち"],[9,1,"つみ"],[11,1,"おか"],[23,1,"かれ"],[25,1,"いのち"],[27,1,"もと"]],"text":"（わたしはわが口に罪を犯させず、のろいをもって彼の命を求めたことはなかった。）"},{"ref":"Job.31.31","start":18031031,"end":18031031,"break":"line","breaks":[[14,"line"],[36,"line"]],"ruby":[[7,2,"てんまく"],[10,2,"ひとびと"],[18,1,"かれ"],[20,1,"にく"],[22,1,"あ"],[28,1,"もの"],[36,1,"い"]],"text":"もし、わたしの天幕の人々で、『だれか彼の肉に飽きなかった者があるか』と、言わなかったことがあるなら、"},{"ref":"Job.31.32","start":18031032,"end":18031032,"break":"line","breaks":[[13,"line"]],"ruby":[[1,2,"たこく"],[3,1,"じん"],[9,1,"やど"],[19,1,"もん"],[21,1,"たび"],[25,1,"ひら"]],"text":"（他国人はちまたに宿らず、わたしはわが門を旅びとに開いた。）"},{"ref":"Job.31.33","start":18031033,"end":18031033,"break":"line","breaks":[[22,"line"]],"ruby":[[6,2,"ひとびと"],[9,1,"まえ"],[26,2,"あくじ"],[29,1,"むね"],[31,1,"なか"],[33,1,"かく"]],"text":"わたしがもし人々の前にわたしのとがをおおい、わたしの悪事を胸の中に隠したことがあるなら、"},{"ref":"Job.31.34","start":18031034,"end":18031034,"break":"line","breaks":[[20,"line"]],"ruby":[[4,2,"たいしゅう"],[7,1,"おそ"],[10,2,"そうぞく"],[13,1,"あなど"],[20,1,"くち"],[22,1,"と"],[25,1,"もん"],[27,1,"で"]],"text":"わたしが大衆を恐れ、宗族の侮りにおぢて、口を閉じ、門を出なかったことがあるなら、"},{"ref":"Job.31.35","start":18031035,"end":18031035,"break":"line","breaks":[[24,"line"],[40,"line"],[62,"line"],[74,"line"]],"ruby":[[7,1,"き"],[13,1,"もの"],[44,3,"ぜんのうしゃ"],[52,1,"こた"],[69,1,"てき"],[71,1,"か"],[74,2,"こくそ"],[76,1,"じょう"]],"text":"ああ、わたしに聞いてくれる者があればよいのだが、（わたしのかきはんがここにある。どうか、全能者がわたしに答えられるように。）ああ、わたしの敵の書いた告訴状があればよいのだが。"},{"ref":"Job.31.36","start":18031036,"end":18031036,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"かなら"],[9,1,"かた"],[11,1,"お"],[14,1,"かんむり"],[24,1,"み"],[26,1,"むす"]],"text":"わたしは必ずこれを肩に負い、冠のようにこれをわが身に結び、"},{"ref":"Job.31.37","start":18031037,"end":18031037,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"あゆ"],[5,1,"かず"],[7,1,"かれ"],[9,1,"の"],[12,1,"きみ"],[15,1,"もの"],[23,1,"かれ"],[25,1,"ちか"]],"text":"わが歩みの数を彼に述べ、君たる者のようにして、彼に近づくであろう。"},{"ref":"Job.31.38","start":18031038,"end":18031038,"break":"line","breaks":[[20,"line"]],"ruby":[[4,2,"たはた"],[11,1,"む"],[15,1,"よ"],[27,1,"とも"],[29,1,"な"],[31,1,"さけ"]],"text":"もしわが田畑がわたしに向かって呼ばわり、そのうねみぞが共に泣き叫んだことがあるなら、"},{"ref":"Job.31.39","start":18031039,"end":18031039,"break":"line","breaks":[[21,"line"]],"ruby":[[6,1,"きん"],[8,1,"はら"],[15,2,"さんぶつ"],[18,1,"た"],[23,1,"も"],[25,1,"ぬし"],[27,1,"し"]],"text":"もしわたしが金を払わないでその産物を食べ、その持ち主を死なせたことがあるなら、"},{"ref":"Job.31.40","start":18031040,"end":18031040,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"こむぎ"],[3,1,"かわ"],[14,2,"おおむぎ"],[17,1,"かわ"],[20,2,"ざっそう"],[37,2,"ことば"],[40,1,"おわ"]],"text":"小麦の代りに、いばらがはえ、大麦の代りに雑草がはえてもかまわない」。ヨブの言葉は終った。"}]