[{"ref":"Exod.26.1","start":2026001,"end":2026001,"break":"paragraph","ruby":[[7,1,"まい"],[9,1,"まく"],[14,2,"まくや"],[17,1,"つく"],[32,2,"あま"],[35,2,"ねんし"],[38,1,"あお"],[39,1,"いと"],[41,1,"むらさき"],[42,1,"いと"],[44,1,"ひ"],[45,1,"いと"],[47,1,"まく"],[49,1,"つく"],[52,1,"たく"],[70,1,"お"],[72,1,"だ"]],"text":"あなたはまた十枚の幕をもって幕屋を造らなければならない。すなわち亜麻の撚糸、青糸、紫糸、緋糸で幕を作り、巧みなわざをもって、それにケルビムを織り出さなければならない。"},{"ref":"Exod.26.2","start":2026002,"end":2026002,"break":"none","ruby":[[0,1,"まく"],[2,1,"なが"],[18,1,"まく"],[20,1,"はば"],[34,1,"まく"],[36,1,"みな"],[37,1,"おな"],[39,2,"すんぽう"]],"text":"幕の長さは、おのおの二十八キュビト、幕の幅は、おのおの四キュビトで、幕は皆同じ寸法でなければならない。"},{"ref":"Exod.26.3","start":2026003,"end":2026003,"break":"none","ruby":[[2,1,"まく"],[4,1,"まい"],[6,1,"たがい"],[8,1,"つら"],[10,1,"あ"],[16,1,"た"],[19,1,"まい"],[21,1,"まく"],[24,1,"たがい"],[26,1,"つら"],[28,1,"あ"]],"text":"その幕五枚を互に連ね合わせ、また他の五枚の幕をも互に連ね合わせなければならない。"},{"ref":"Exod.26.4","start":2026004,"end":2026004,"break":"none","ruby":[[2,2,"いちれん"],[5,1,"はし"],[9,1,"まく"],[11,1,"ふち"],[13,2,"あおいろ"],[16,1,"ち"],[23,1,"た"],[25,2,"いちれん"],[28,1,"はし"],[32,1,"まく"],[34,1,"ふち"]],"text":"その一連の端にある幕の縁に青色の乳をつけ、また他の一連の端にある幕の縁にもそのようにしなければならない。"},{"ref":"Exod.26.5","start":2026005,"end":2026005,"break":"none","ruby":[[8,1,"まい"],[10,1,"まく"],[12,1,"ち"],[21,1,"た"],[23,2,"いちれん"],[26,1,"まく"],[28,1,"はし"],[31,1,"ち"],[40,1,"ち"],[42,1,"たがい"],[44,1,"あい"],[45,1,"む"]],"text":"あなたは、その一枚の幕に乳五十をつけ、また他の一連の幕の端にも乳五十をつけ、その乳を互に相向かわせなければならない。"},{"ref":"Exod.26.6","start":2026006,"end":2026006,"break":"none","ruby":[[6,1,"きん"],[8,1,"わ"],[12,1,"つく"],[17,1,"わ"],[19,1,"まく"],[21,1,"たがい"],[23,1,"つら"],[25,1,"あ"],[32,2,"まくや"]],"text":"あなたはまた金の輪五十を作り、その輪で幕を互に連ね合わせて一つの幕屋にしなければならない。"},{"ref":"Exod.26.7","start":2026007,"end":2026007,"break":"paragraph","ruby":[[2,2,"まくや"],[8,2,"てんまく"],[17,2,"けいと"],[20,1,"まく"],[22,1,"つく"],[37,1,"まく"],[40,1,"まい"],[42,1,"つく"]],"text":"また幕屋をおおう天幕のためにやぎの毛糸で幕を作らなければならない。すなわち幕十一枚を作り、"},{"ref":"Exod.26.8","start":2026008,"end":2026008,"break":"none","ruby":[[3,1,"まい"],[5,1,"まく"],[7,1,"なが"],[20,1,"まい"],[22,1,"まく"],[24,1,"はば"],[37,1,"まい"],[39,1,"まく"],[41,1,"おな"],[43,2,"すんぽう"]],"text":"その一枚の幕の長さは三十キュビト、その一枚の幕の幅は四キュビトで、その十一枚の幕は同じ寸法でなければならない。"},{"ref":"Exod.26.9","start":2026009,"end":2026009,"break":"none","ruby":[[6,1,"まく"],[8,1,"まい"],[13,1,"つら"],[15,1,"あ"],[23,1,"まく"],[25,1,"まい"],[30,1,"つら"],[32,1,"あ"],[40,1,"まい"],[41,1,"め"],[43,1,"まく"],[45,2,"てんまく"],[48,1,"まえ"],[50,1,"お"],[52,1,"かさ"]],"text":"そして、その幕五枚を一つに連ね合わせ、またその幕六枚を一つに連ね合わせて、その六枚目の幕を天幕の前で折り重ねなければならない。"},{"ref":"Exod.26.10","start":2026010,"end":2026010,"break":"none","ruby":[[4,2,"いちれん"],[7,1,"はし"],[11,1,"まく"],[13,1,"ふち"],[15,1,"ち"],[22,1,"た"],[24,2,"いちれん"],[27,1,"まく"],[29,1,"ふち"],[32,1,"ち"]],"text":"またその一連の端にある幕の縁に乳五十をつけ、他の一連の幕の縁にも乳五十をつけなさい。"},{"ref":"Exod.26.11","start":2026011,"end":2026011,"break":"paragraph","ruby":[[3,2,"せいどう"],[6,1,"わ"],[10,1,"つく"],[15,1,"わ"],[17,1,"ち"],[19,1,"か"],[24,2,"てんまく"],[27,1,"つら"],[29,1,"あ"]],"text":"そして青銅の輪五十を作り、その輪を乳に掛け、その天幕を連ね合わせて一つにし、"},{"ref":"Exod.26.12","start":2026012,"end":2026012,"break":"none","ruby":[[2,2,"てんまく"],[5,1,"まく"],[7,1,"のこ"],[10,1,"た"],[13,2,"ぶぶん"],[22,1,"のこ"],[25,1,"はん"],[26,1,"まく"],[28,2,"まくや"],[35,1,"た"]],"text":"その天幕の幕の残りの垂れる部分、すなわちその残りの半幕を幕屋のうしろに垂れさせなければならない。"},{"ref":"Exod.26.13","start":2026013,"end":2026013,"break":"none","ruby":[[3,2,"てんまく"],[6,1,"まく"],[11,1,"あま"],[38,2,"まくや"],[50,2,"りょうがわ"],[62,1,"た"]],"text":"そして天幕の幕のたけで余るものの、こちらのキュビトと、あちらのキュビトとは、幕屋をおおうように、その両側のこちらとあちらとに垂れさせなければならない。"},{"ref":"Exod.26.14","start":2026014,"end":2026014,"break":"none","ruby":[[6,1,"ぞ"],[9,2,"おひつじ"],[12,1,"かわ"],[14,2,"てんまく"],[27,1,"かわ"],[31,1,"うえ"],[41,1,"つく"]],"text":"また、あかね染めの雄羊の皮で天幕のおおいと、じゅごんの皮でその上にかけるおおいとを造らなければならない。"},{"ref":"Exod.26.15","start":2026015,"end":2026015,"break":"paragraph","ruby":[[4,2,"まくや"],[15,1,"ざい"],[17,1,"たて"],[18,1,"わく"],[20,1,"つく"]],"text":"あなたは幕屋のために、アカシヤ材で立枠を造らなければならない。"},{"ref":"Exod.26.16","start":2026016,"end":2026016,"break":"none","ruby":[[0,1,"わく"],[2,1,"なが"],[11,1,"わく"],[13,1,"はば"],[20,1,"はん"]],"text":"枠の長さを十キュビト、枠の幅を一キュビト半とし、"},{"ref":"Exod.26.17","start":2026017,"end":2026017,"break":"none","ruby":[[0,1,"わく"],[7,1,"ほぞ"],[9,1,"つく"],[20,1,"く"],[22,1,"あ"],[27,2,"まくや"],[34,1,"わく"]],"text":"枠ごとに二つの柄を造って、かれとこれとを食い合わさせ、幕屋のすべての枠にこのようにしなければならない。"},{"ref":"Exod.26.18","start":2026018,"end":2026018,"break":"none","ruby":[[4,2,"まくや"],[10,1,"わく"],[12,1,"つく"],[15,2,"みなみがわ"],[21,1,"わく"]],"text":"あなたは幕屋のために枠を造り、南側のために枠二十とし、"},{"ref":"Exod.26.19","start":2026019,"end":2026019,"break":"none","ruby":[[5,1,"わく"],[7,1,"した"],[9,1,"ぎん"],[11,1,"ざ"],[15,1,"つく"],[21,1,"わく"],[23,1,"した"],[31,1,"ほぞ"],[39,1,"ざ"],[41,1,"お"],[46,1,"わく"],[48,1,"した"],[56,1,"ほぞ"],[64,1,"ざ"],[66,1,"お"]],"text":"その二十の枠の下に銀の座四十を造って、この枠の下に、その二つの柄のために二つの座を置き、かの枠の下にもその二つの柄のために二つの座を置かなければならない。"},{"ref":"Exod.26.20","start":2026020,"end":2026020,"break":"none","ruby":[[2,2,"まくや"],[5,1,"た"],[7,1,"がわ"],[13,2,"きたがわ"],[20,1,"わく"],[24,1,"つく"]],"text":"また幕屋の他の側、すなわち北側のためにも枠二十を造り、"},{"ref":"Exod.26.21","start":2026021,"end":2026021,"break":"none","ruby":[[2,1,"ぎん"],[4,1,"ざ"],[8,1,"つく"],[14,1,"わく"],[16,1,"した"],[22,1,"ざ"],[24,1,"お"],[29,1,"わく"],[31,1,"した"],[37,1,"ざ"],[39,1,"お"]],"text":"その銀の座四十を造って、この枠の下に、二つの座を置き、かの枠の下にも二つの座を置かなければならない。"},{"ref":"Exod.26.22","start":2026022,"end":2026022,"break":"none","ruby":[[2,2,"まくや"],[13,2,"にしがわ"],[19,1,"わく"],[23,1,"つく"]],"text":"また幕屋のうしろ、すなわち西側のために枠六つを造り、"},{"ref":"Exod.26.23","start":2026023,"end":2026023,"break":"none","ruby":[[0,2,"まくや"],[16,1,"わく"],[20,1,"つく"]],"text":"幕屋のうしろの二つのすみのために枠二つを造らなければならない。"},{"ref":"Exod.26.24","start":2026024,"end":2026024,"break":"none","ruby":[[4,1,"した"],[6,1,"かさ"],[9,1,"あ"],[12,1,"おな"],[17,1,"いただき"],[20,1,"だい"],[23,1,"かん"],[26,1,"かさ"],[29,1,"あ"],[70,1,"もう"]],"text":"これらは下で重なり合い、同じくその頂でも第一の環まで重なり合うようにし、その二つともそのようにしなければならない。それらは二つのすみのために設けるものである。"},{"ref":"Exod.26.25","start":2026025,"end":2026025,"break":"none","ruby":[[6,1,"わく"],[13,1,"ぎん"],[15,1,"ざ"],[22,1,"わく"],[24,1,"した"],[29,1,"ざ"],[33,1,"わく"],[35,1,"した"],[41,1,"ざ"],[43,1,"お"]],"text":"こうしてその枠は八つ、その銀の座は十六、この枠の下に二つの座、かの枠の下にも二つの座を置かなければならない。"},{"ref":"Exod.26.26","start":2026026,"end":2026026,"break":"none","ruby":[[6,1,"ざい"],[8,2,"よこぎ"],[11,1,"つく"],[26,2,"まくや"],[31,1,"がわ"],[33,1,"わく"]],"text":"またアカシヤ材で横木を造らなければならない。すなわち幕屋のこの側の枠のために五つ、"},{"ref":"Exod.26.27","start":2026027,"end":2026027,"break":"none","ruby":[[2,2,"まくや"],[7,1,"がわ"],[9,1,"わく"],[14,2,"よこぎ"],[19,2,"まくや"],[26,2,"にしがわ"],[29,1,"わく"],[34,2,"よこぎ"],[39,1,"つく"]],"text":"また幕屋のかの側の枠のために横木五つ、幕屋のうしろの西側の枠のために横木五つを造り、"},{"ref":"Exod.26.28","start":2026028,"end":2026028,"break":"none","ruby":[[0,1,"わく"],[4,1,"なか"],[8,2,"ちゅうおう"],[11,2,"よこぎ"],[14,1,"はし"],[17,1,"はし"],[20,1,"とお"]],"text":"枠のまん中にある中央の横木は端から端まで通るようにしなければならない。"},{"ref":"Exod.26.29","start":2026029,"end":2026029,"break":"none","ruby":[[5,1,"わく"],[7,1,"きん"],[15,2,"よこぎ"],[18,1,"とお"],[22,1,"かん"],[24,1,"きん"],[26,1,"つく"],[34,2,"よこぎ"],[37,1,"きん"]],"text":"そしてその枠を金でおおい、また横木を通すその環を金で造り、また、その横木を金でおおわなければならない。"},{"ref":"Exod.26.30","start":2026030,"end":2026030,"break":"none","ruby":[[8,1,"やま"],[10,1,"しめ"],[14,2,"ようしき"],[17,1,"したが"],[20,2,"まくや"],[23,1,"た"]],"text":"こうしてあなたは山で示された様式に従って幕屋を建てなければならない。"},{"ref":"Exod.26.31","start":2026031,"end":2026031,"break":"paragraph","ruby":[[2,1,"あお"],[3,1,"いと"],[5,1,"むらさき"],[6,1,"いと"],[8,1,"ひ"],[9,1,"いと"],[11,2,"あま"],[14,2,"ねんし"],[17,2,"たれまく"],[20,1,"つく"],[23,1,"たく"],[41,1,"お"],[43,1,"だ"]],"text":"また青糸、紫糸、緋糸、亜麻の撚糸で垂幕を作り、巧みなわざをもって、それにケルビムを織り出さなければならない。"},{"ref":"Exod.26.32","start":2026032,"end":2026032,"break":"none","ruby":[[3,1,"きん"],[16,1,"ざい"],[18,1,"はしら"],[20,1,"きん"],[22,1,"こま"],[27,1,"か"],[32,1,"はしら"],[37,1,"ぎん"],[39,1,"ざ"],[41,1,"うえ"]],"text":"そして金でおおった四つのアカシヤ材の柱の金の鉤にこれを掛け、その柱は四つの銀の座の上にすえなければならない。"},{"ref":"Exod.26.33","start":2026033,"end":2026033,"break":"none","ruby":[[2,2,"たれまく"],[5,1,"わ"],[7,1,"こま"],[9,1,"か"],[14,2,"たれまく"],[17,1,"うち"],[23,1,"はこ"],[25,1,"おさ"],[33,2,"たれまく"],[45,2,"せいじょ"],[48,3,"しせいじょ"],[53,1,"へだ"],[55,1,"わ"]],"text":"その垂幕の輪を鉤に掛け、その垂幕の内にあかしの箱を納めなさい。その垂幕はあなたがたのために聖所と至聖所とを隔て分けるであろう。"},{"ref":"Exod.26.34","start":2026034,"end":2026034,"break":"none","ruby":[[2,3,"しせいじょ"],[12,1,"はこ"],[14,1,"うえ"],[16,3,"しょくざいしょ"],[20,1,"お"]],"text":"また至聖所にあるあかしの箱の上に贖罪所を置かなければならない。"},{"ref":"Exod.26.35","start":2026035,"end":2026035,"break":"none","ruby":[[5,2,"たれまく"],[8,1,"そと"],[10,1,"つくえ"],[12,1,"お"],[15,2,"まくや"],[18,2,"みなみがわ"],[22,1,"つくえ"],[24,1,"む"],[27,1,"あ"],[31,2,"しょくだい"],[34,1,"お"],[48,1,"つくえ"],[50,2,"きたがわ"],[53,1,"お"]],"text":"そしてその垂幕の外に机を置き、幕屋の南側に、机に向かい合わせて燭台を置かなければならない。ただし机は北側に置かなければならない。"},{"ref":"Exod.26.36","start":2026036,"end":2026036,"break":"paragraph","ruby":[[6,2,"てんまく"],[9,2,"いりぐち"],[15,1,"あお"],[16,1,"いと"],[18,1,"むらさき"],[19,1,"いと"],[21,1,"ひ"],[22,1,"いと"],[24,2,"あま"],[27,2,"ねんし"],[31,1,"いろ"],[37,1,"お"],[44,1,"つく"]],"text":"あなたはまた天幕の入口のために青糸、紫糸、緋糸、亜麻の撚糸で、色とりどりに織ったとばりを作らなければならない。"},{"ref":"Exod.26.37","start":2026037,"end":2026037,"break":"none","ruby":[[17,1,"ざい"],[19,1,"はしら"],[23,1,"つく"],[29,1,"きん"],[37,1,"こま"],[39,1,"きん"],[41,1,"つく"],[48,1,"はしら"],[53,2,"せいどう"],[56,1,"ざ"],[60,1,"い"],[62,1,"つく"]],"text":"あなたはそのとばりのためにアカシヤ材の柱五つを造り、これを金でおおい、その鉤を金で造り、またその柱のために青銅の座五つを鋳て造らなければならない。"}]