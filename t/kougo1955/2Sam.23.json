[{"ref":"2Sam.23.1","start":10023001,"end":10023001,"break":"paragraph","breaks":[[16,"line"],[29,"line"],[42,"line"],[56,"line"]],"ruby":[[7,2,"さいご"],[10,2,"ことば"],[21,1,"こ"],[26,2,"たくせん"],[33,1,"たか"],[35,1,"あ"],[40,1,"ひと"],[46,1,"かみ"],[48,1,"あぶら"],[50,1,"そそ"],[54,1,"ひと"],[62,1,"よ"],[64,1,"うた"],[68,2,"たくせん"]],"text":"これはダビデの最後の言葉である。エッサイの子ダビデの託宣、すなわち高く挙げられた人、ヤコブの神に油を注がれた人、イスラエルの良き歌びとの託宣。"},{"ref":"2Sam.23.2","start":10023002,"end":10023002,"break":"line","breaks":[[15,"line"]],"ruby":[[1,1,"しゅ"],[3,1,"れい"],[12,1,"かた"],[17,2,"ことば"],[24,1,"した"],[26,1,"うえ"]],"text":"「主の霊はわたしによって語る、その言葉はわたしの舌の上にある。"},{"ref":"2Sam.23.3","start":10023003,"end":10023003,"break":"line","breaks":[[13,"line"],[30,"line"],[41,"line"]],"ruby":[[6,1,"かみ"],[8,1,"かた"],[19,1,"いわ"],[25,1,"い"],[31,1,"ひと"],[33,1,"ただ"],[36,1,"おさ"],[39,1,"もの"],[41,1,"かみ"],[43,1,"おそ"],[47,1,"おさ"],[50,1,"もの"]],"text":"イスラエルの神は語られた、イスラエルの岩はわたしに言われた、『人を正しく治める者、神を恐れて、治める者は、"},{"ref":"2Sam.23.4","start":10023004,"end":10023004,"break":"line","breaks":[[8,"line"],[26,"line"]],"ruby":[[0,1,"あさ"],[2,1,"ひかり"],[8,1,"くも"],[12,1,"あさ"],[15,1,"かがや"],[19,2,"たいよう"],[26,1,"ち"],[28,2,"わかくさ"],[31,1,"め"],[37,1,"あめ"],[42,1,"ひと"],[44,1,"のぞ"]],"text":"朝の光のように、雲のない朝に、輝きでる太陽のように、地に若草を芽ばえさせる雨のように人に臨む』。"},{"ref":"2Sam.23.5","start":10023005,"end":10023005,"break":"line","breaks":[[15,"line"],[27,"line"],[44,"line"],[64,"line"],[80,"line"]],"ruby":[[7,1,"や"],[15,1,"かみ"],[17,1,"とも"],[31,1,"かみ"],[37,1,"そな"],[41,1,"たし"],[49,2,"けいやく"],[56,1,"むす"],[68,1,"かれ"],[74,1,"すくい"],[76,1,"ねが"],[80,1,"みな"]],"text":"まことに、わが家はそのように、神と共にあるではないか。それは、神が、よろず備わって確かなとこしえの契約をわたしと結ばれたからだ。どうして彼はわたしの救と願いを、皆なしとげられぬことがあろうか。"},{"ref":"2Sam.23.6","start":10023006,"end":10023006,"break":"line","breaks":[[20,"line"],[37,"line"]],"ruby":[[9,1,"ひと"],[20,1,"て"],[25,1,"と"],[39,1,"とも"],[41,1,"す"]],"text":"しかし、よこしまな人は、いばらのようで、手をもって取ることができないゆえ、みな共に捨てられるであろう。"},{"ref":"2Sam.23.7","start":10023007,"end":10023007,"break":"line","breaks":[[12,"line"],[28,"line"]],"ruby":[[3,1,"ふ"],[10,1,"ひと"],[12,1,"てつ"],[18,1,"え"],[23,2,"ぶそう"],[28,1,"かれ"],[36,1,"ひ"],[38,1,"や"]],"text":"これに触れようとする人は鉄や、やりの柄をもって武装する、彼らはことごとく火で焼かれるであろう」。"},{"ref":"2Sam.23.8","start":10023008,"end":10023008,"break":"paragraph","ruby":[[4,2,"ゆうし"],[9,1,"な"],[11,1,"つぎ"],[39,1,"にん"],[44,1,"ちょう"],[51,1,"かれ"],[59,1,"にん"],[61,1,"む"],[76,1,"ころ"]],"text":"ダビデの勇士たちの名は次のとおりである。タクモンびとヨセブ・バッセベテはかの三人のうちの長であったが、彼はいちじに八百人に向かって、やりをふるい、それを殺した。"},{"ref":"2Sam.23.9","start":10023009,"end":10023009,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"つぎ"],[12,1,"こ"],[24,2,"ゆうし"],[34,1,"かれ"],[37,1,"たたか"],[46,1,"あつ"],[57,1,"む"],[61,1,"たたか"],[74,2,"ひとびと"],[77,1,"しりぞ"],[80,1,"とき"],[86,1,"とも"]],"text":"彼の次はアホアびとドドの子エレアザルであって、三勇士のひとりである。彼は、戦おうとしてそこに集まったペリシテびとに向かって戦いをいどみ、イスラエルの人々が退いた時、ダビデと共にいたが、"},{"ref":"2Sam.23.10","start":10023010,"end":10023010,"break":"none","ruby":[[0,1,"た"],[10,1,"う"],[16,1,"て"],[18,1,"つか"],[21,1,"て"],[27,1,"つ"],[30,1,"はな"],[43,1,"ひ"],[45,1,"しゅ"],[47,1,"おお"],[51,2,"しょうり"],[54,1,"あた"],[60,1,"たみ"],[62,1,"かれ"],[67,1,"かえ"],[75,1,"ころ"],[79,1,"もの"],[83,1,"と"]],"text":"立ってペリシテびとを撃ち、ついに手が疲れ、手がつるぎに着いて離れないほどになった。その日、主は大いなる勝利を与えられた。民は彼のあとに帰ってきて、ただ殺された者をはぎ取るばかりであった。"},{"ref":"2Sam.23.11","start":10023011,"end":10023011,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"つぎ"],[12,1,"こ"],[24,1,"とき"],[36,1,"あつ"],[44,2,"いちめん"],[50,1,"まめ"],[52,1,"つく"],[55,2,"じしょ"],[62,1,"たみ"],[71,1,"まえ"],[74,1,"に"]],"text":"彼の次はハラルびとアゲの子シャンマであった。ある時、ペリシテびとはレヒに集まった。そこに一面にレンズ豆を作った地所があった。民はペリシテびとの前から逃げたが、"},{"ref":"2Sam.23.12","start":10023012,"end":10023012,"break":"none","ruby":[[0,1,"かれ"],[4,2,"じしょ"],[7,1,"なか"],[9,1,"た"],[16,1,"ふせ"],[26,1,"ころ"],[33,1,"しゅ"],[35,1,"おお"],[39,1,"すくい"],[41,1,"あた"]],"text":"彼はその地所の中に立って、これを防ぎ、ペリシテびとを殺した。そして主は大いなる救を与えられた。"},{"ref":"2Sam.23.13","start":10023013,"end":10023013,"break":"paragraph","ruby":[[2,1,"にん"],[4,1,"ちょう"],[12,1,"にん"],[14,1,"くだ"],[17,1,"い"],[20,2,"かりい"],[35,1,"あな"],[49,1,"とき"],[59,1,"たい"],[66,1,"たに"],[68,1,"じん"],[70,1,"と"]],"text":"三十人の長たちのうちの三人は下って行って刈入れのころに、アドラムのほら穴にいるダビデのもとにきた。時にペリシテびとの一隊はレパイムの谷に陣を取っていた。"},{"ref":"2Sam.23.14","start":10023014,"end":10023014,"break":"none","ruby":[[2,1,"とき"],[7,2,"ようがい"],[20,2,"せんじん"]],"text":"その時ダビデは要害におり、ペリシテびとの先陣はベツレヘムにあったが、"},{"ref":"2Sam.23.15","start":10023015,"end":10023015,"break":"none","ruby":[[8,1,"のぞ"],[22,1,"もん"],[31,2,"いど"],[34,1,"みず"],[40,1,"の"],[55,1,"い"]],"text":"ダビデは、せつに望んで、「だれかベツレヘムの門のかたわらにある井戸の水をわたしに飲ませてくれるとよいのだが」と言った。"},{"ref":"2Sam.23.16","start":10023016,"end":10023016,"break":"none","ruby":[[6,1,"にん"],[8,2,"ゆうし"],[20,1,"じん"],[22,1,"つ"],[24,1,"とお"],[34,1,"もん"],[43,2,"いど"],[46,1,"みず"],[48,1,"く"],[50,1,"と"],[61,1,"たずさ"],[77,1,"の"],[85,1,"しゅ"],[87,1,"まえ"],[92,1,"そそ"]],"text":"そこでその三人の勇士たちはペリシテびとの陣を突き通って、ベツレヘムの門のかたわらにある井戸の水を汲み取って、ダビデのもとに携えてきた。しかしダビデはそれを飲もうとはせず、主の前にそれを注いで、"},{"ref":"2Sam.23.17","start":10023017,"end":10023017,"break":"none","ruby":[[0,1,"い"],[5,1,"しゅ"],[12,1,"だん"],[15,1,"の"],[34,1,"い"],[37,2,"ひとびと"],[40,1,"ち"],[51,1,"の"],[68,1,"かれ"],[73,1,"の"],[85,2,"ゆうし"],[95,1,"おこな"]],"text":"言った、「主よ、わたしは断じて飲むことをいたしません。いのちをかけて行った人々の血を、どうしてわたしは飲むことができましょう」。こうして彼はそれを飲もうとはしなかった。三勇士はこれらのことを行った。"},{"ref":"2Sam.23.18","start":10023018,"end":10023018,"break":"paragraph","ruby":[[4,1,"こ"],[9,2,"きょうだい"],[19,1,"にん"],[21,1,"ちょう"],[27,1,"かれ"],[31,1,"にん"],[33,1,"む"],[48,1,"ころ"],[56,1,"かれ"],[59,1,"にん"],[61,1,"とも"],[63,1,"な"],[65,1,"え"]],"text":"ゼルヤの子ヨアブの兄弟アビシャイは三十人の長であった。彼は三百人に向かって、やりをふるい、それを殺した。そして、彼は三人と共に名を得た。"},{"ref":"2Sam.23.19","start":10023019,"end":10023019,"break":"none","ruby":[[0,1,"かれ"],[4,1,"にん"],[8,1,"もっと"],[10,1,"たっと"],[14,1,"もの"],[17,1,"かれ"],[20,1,"ちょう"],[33,1,"にん"],[36,1,"およ"]],"text":"彼は三十人のうち最も尊ばれた者で、彼らの長となった。しかし、かの三人には及ばなかった。"},{"ref":"2Sam.23.20","start":10023020,"end":10023020,"break":"paragraph","ruby":[[5,1,"こ"],[15,2,"しゅっしん"],[18,2,"ゆうし"],[25,1,"おお"],[32,1,"た"],[36,1,"かれ"],[51,1,"こ"],[53,1,"う"],[55,1,"ころ"],[59,1,"かれ"],[63,1,"ゆき"],[65,1,"ひ"],[67,1,"くだ"],[74,1,"あな"],[76,1,"なか"],[81,1,"う"],[83,1,"ころ"]],"text":"エホヤダの子ベナヤはカブジエル出身の勇士であって、多くのてがらを立てた。彼はモアブのアリエルのふたりの子を撃ち殺した。彼はまた雪の日に下っていって、穴の中でししを撃ち殺した。"},{"ref":"2Sam.23.21","start":10023021,"end":10023021,"break":"none","ruby":[[0,1,"かれ"],[4,1,"すがた"],[18,1,"う"],[20,1,"ころ"],[33,1,"て"],[38,1,"も"],[57,1,"ところ"],[59,1,"くだ"],[72,1,"て"],[92,1,"ころ"]],"text":"彼はまた姿のうるわしいエジプトびとを撃ち殺した。そのエジプトびとは手にやりを持っていたが、ベナヤはつえをとってその所に下っていき、エジプトびとの手からやりをもぎとって、そのやりをもって殺した。"},{"ref":"2Sam.23.22","start":10023022,"end":10023022,"break":"none","ruby":[[5,1,"こ"],[14,1,"こと"],[19,2,"ゆうし"],[22,1,"とも"],[24,1,"な"],[26,1,"え"]],"text":"エホヤダの子ベナヤはこれらの事をして三勇士と共に名を得た。"},{"ref":"2Sam.23.23","start":10023023,"end":10023023,"break":"none","ruby":[[0,1,"かれ"],[4,1,"にん"],[9,2,"ゆうめい"],[20,1,"にん"],[23,1,"およ"],[34,1,"かれ"],[36,2,"じえい"],[39,1,"ちょう"]],"text":"彼は三十人のうちに有名であったが、かの三人には及ばなかった。ダビデは彼を侍衛の長とした。"},{"ref":"2Sam.23.24","start":10023024,"end":10023024,"break":"paragraph","ruby":[[2,1,"にん"],[17,2,"きょうだい"],[29,2,"しゅっしん"],[35,1,"こ"]],"text":"三十人のうちにあったのは、ヨアブの兄弟アサヘル。ベツレヘム出身のドドの子エルハナン。"},{"ref":"2Sam.23.25","start":10023025,"end":10023025,"break":"none","ruby":[[3,2,"しゅっしん"],[14,2,"しゅっしん"]],"text":"ハロデ出身のシャンマ。ハロデ出身のエリカ。"},{"ref":"2Sam.23.26","start":10023026,"end":10023026,"break":"none","ruby":[[12,2,"しゅっしん"],[20,1,"こ"]],"text":"パルテびとヘレヅ。テコア出身のイッケシの子イラ。"},{"ref":"2Sam.23.27","start":10023027,"end":10023027,"break":"none","ruby":[[4,2,"しゅっしん"]],"text":"アナトテ出身のアビエゼル。ホシャびとメブンナイ。"},{"ref":"2Sam.23.28","start":10023028,"end":10023028,"break":"none","ruby":[[13,2,"しゅっしん"]],"text":"アホアびとザルモン。ネトパ出身のマハライ。"},{"ref":"2Sam.23.29","start":10023029,"end":10023029,"break":"none","ruby":[[3,2,"しゅっしん"],[10,1,"こ"],[28,1,"で"],[34,1,"こ"]],"text":"ネトパ出身のバアナの子ヘレブ。ベニヤミンびとのギベアから出たリバイの子イッタイ。"},{"ref":"2Sam.23.30","start":10023030,"end":10023030,"break":"none","ruby":[[13,1,"たに"],[14,2,"しゅっしん"]],"text":"ピラトンのベナヤ。ガアシの谷出身のヒダイ。"},{"ref":"2Sam.23.31","start":10023031,"end":10023031,"break":"none","ruby":[[17,2,"しゅっしん"]],"text":"アルバテびとアビアルボン。バホリム出身のアズマウテ。"},{"ref":"2Sam.23.32","start":10023032,"end":10023032,"break":"none","ruby":[[5,2,"しゅっしん"],[17,1,"こ"]],"text":"シャルボン出身のエリヤバ。ヤセンの子たち。ヨナタン。"},{"ref":"2Sam.23.33","start":10023033,"end":10023033,"break":"none","ruby":[[20,1,"こ"]],"text":"ハラルびとシャンマ。ハラルびとシャラルの子アヒアム。"},{"ref":"2Sam.23.34","start":10023034,"end":10023034,"break":"none","ruby":[[3,2,"しゅっしん"],[12,1,"こ"],[21,2,"しゅっしん"],[30,1,"こ"]],"text":"マアカ出身のアハスバイの子エリペレテ。ギロ出身のアヒトペルの子エリアム。"},{"ref":"2Sam.23.35","start":10023035,"end":10023035,"break":"none","ruby":[[4,2,"しゅっしん"]],"text":"カルメル出身のヘヅロ。アルバびとパアライ。"},{"ref":"2Sam.23.36","start":10023036,"end":10023036,"break":"none","ruby":[[2,2,"しゅっしん"],[9,1,"こ"]],"text":"ゾバ出身のナタンの子イガル。ガドびとバニ。"},{"ref":"2Sam.23.37","start":10023037,"end":10023037,"break":"none","ruby":[[14,1,"こ"],[19,2,"ぶき"],[22,1,"と"],[24,1,"もの"],[30,2,"しゅっしん"]],"text":"アンモンびとゼレク。ゼルヤの子ヨアブの武器を執る者、ベエロテ出身のナハライ。"},{"ref":"2Sam.23.38","start":10023038,"end":10023038,"break":"none","text":"イテルびとイラ。イテルびとガレブ。"},{"ref":"2Sam.23.39","start":10023039,"end":10023039,"break":"none","ruby":[[8,1,"あ"],[15,1,"にん"]],"text":"ヘテびとウリヤ。合わせて三十七人である。"}]