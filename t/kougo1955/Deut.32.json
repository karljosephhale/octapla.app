[{"ref":"Deut.32.1","start":5032001,"end":5032001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[1,1,"てん"],[4,1,"みみ"],[6,1,"かたむ"],[14,1,"かた"],[17,1,"ち"],[24,1,"くち"],[26,2,"ことば"],[29,1,"き"]],"text":"「天よ、耳を傾けよ、わたしは語る、地よ、わたしの口の言葉を聞け。"},{"ref":"Deut.32.2","start":5032002,"end":5032002,"break":"line","breaks":[[17,"line"],[38,"line"],[52,"line"]],"ruby":[[4,1,"おしえ"],[6,1,"あめ"],[11,1,"ふ"],[21,2,"ことば"],[24,1,"つゆ"],[38,2,"わかくさ"],[41,1,"うえ"],[43,1,"ふ"],[45,2,"こさめ"],[52,2,"あおくさ"],[55,1,"うえ"],[60,2,"ゆうだ"]],"text":"わたしの教は雨のように降りそそぎ、わたしの言葉は露のようにしたたるであろう。若草の上に降る小雨のように、青草の上にくだる夕立ちのように。"},{"ref":"Deut.32.3","start":5032003,"end":5032003,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"な"],[18,1,"かみ"],[20,2,"えいこう"],[23,1,"かえ"]],"text":"わたしは主の名をのべよう、われわれの神に栄光を帰せよ。"},{"ref":"Deut.32.4","start":5032004,"end":5032004,"break":"line","breaks":[[17,"line"],[27,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"いわ"],[14,1,"まった"],[19,1,"みち"],[23,1,"ただ"],[27,1,"しゅ"],[29,2,"しんじつ"],[33,1,"かみ"],[39,1,"いつわ"],[44,1,"ぎ"],[50,1,"せい"]],"text":"主は岩であって、そのみわざは全く、その道はみな正しい。主は真実なる神であって、偽りなく、義であって、正である。"},{"ref":"Deut.32.5","start":5032005,"end":5032005,"break":"line","breaks":[[14,"line"],[35,"line"]],"ruby":[[0,1,"かれ"],[3,1,"しゅ"],[9,1,"あく"],[11,1,"おこな"],[26,1,"しゅ"],[28,1,"こ"],[41,1,"まが"]],"text":"彼らは主にむかって悪を行い、そのきずのゆえに、もはや主の子らではなく、よこしまで、曲ったやからである。"},{"ref":"Deut.32.6","start":5032006,"end":5032006,"break":"line","breaks":[[11,"line"],[32,"line"],[48,"line"]],"ruby":[[0,1,"おろ"],[3,2,"ちえ"],[8,1,"たみ"],[24,1,"しゅ"],[26,1,"むく"],[32,1,"しゅ"],[38,1,"う"],[45,1,"つく"],[52,1,"かた"],[54,1,"た"],[63,1,"ちち"]],"text":"愚かな知恵のない民よ、あなたがたはこのようにして主に報いるのか。主はあなたを生み、あなたを造り、あなたを堅く立てられたあなたの父ではないか。"},{"ref":"Deut.32.7","start":5032007,"end":5032007,"break":"line","breaks":[[10,"line"],[18,"line"],[27,"line"],[41,"line"],[49,"line"]],"ruby":[[5,1,"ひ"],[7,1,"おぼ"],[10,2,"よよ"],[13,1,"とし"],[15,1,"おも"],[22,1,"ちち"],[24,1,"と"],[27,1,"かれ"],[33,1,"つ"],[41,2,"ちょうろう"],[46,1,"と"],[49,1,"かれ"],[56,1,"かた"]],"text":"いにしえの日を覚え、代々の年を思え。あなたの父に問え、彼はあなたに告げるであろう。長老たちに問え、彼らはあなたに語るであろう。"},{"ref":"Deut.32.8","start":5032008,"end":5032008,"break":"line","breaks":[[14,"line"],[31,"line"],[46,"line"]],"ruby":[[2,1,"たか"],[4,1,"もの"],[6,1,"ひと"],[8,1,"こ"],[11,1,"わ"],[14,1,"しょ"],[15,2,"こくみん"],[20,1,"し"],[21,1,"ぎょう"],[23,1,"あた"],[37,1,"こ"],[40,1,"かず"],[42,1,"てら"],[51,1,"たみ"],[53,1,"さかい"],[55,1,"さだ"]],"text":"いと高き者は人の子らを分け、諸国民にその嗣業を与えられたとき、イスラエルの子らの数に照して、もろもろの民の境を定められた。"},{"ref":"Deut.32.9","start":5032009,"end":5032009,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ぶん"],[6,1,"たみ"],[18,1,"さだ"],[23,1,"し"],[24,1,"ぎょう"]],"text":"主の分はその民であって、ヤコブはその定められた嗣業である。"},{"ref":"Deut.32.10","start":5032010,"end":5032010,"break":"line","breaks":[[15,"line"],[27,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[5,2,"あらの"],[8,1,"ち"],[10,1,"み"],[15,1,"けもの"],[20,1,"あ"],[22,1,"ち"],[24,1,"あ"],[30,1,"めぐ"],[32,1,"かこ"],[40,1,"め"],[49,1,"まも"]],"text":"主はこれを荒野の地で見いだし、獣のほえる荒れ地で会い、これを巡り囲んでいたわり、目のひとみのように守られた。"},{"ref":"Deut.32.11","start":5032011,"end":5032011,"break":"line","breaks":[[15,"line"],[27,"line"],[41,"line"]],"ruby":[[5,1,"す"],[10,1,"よ"],[12,1,"おこ"],[17,1,"こ"],[19,1,"うえ"],[21,1,"ま"],[29,1,"はね"],[35,1,"かれ"],[47,1,"うえ"],[52,1,"お"]],"text":"わしがその巣のひなを呼び起し、その子の上に舞いかけり、その羽をひろげて彼らをのせ、そのつばさの上にこれを負うように、"},{"ref":"Deut.32.12","start":5032012,"end":5032012,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"かれ"],[10,1,"みちび"],[18,2,"かみがみ"]],"text":"主はただひとりで彼を導かれて、ほかの神々はあずからなかった。"},{"ref":"Deut.32.13","start":5032013,"end":5032013,"break":"line","breaks":[[16,"line"],[26,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"ち"],[6,1,"たか"],[8,1,"ところ"],[10,1,"の"],[12,1,"とお"],[16,2,"たはた"],[19,2,"さんぶつ"],[22,1,"く"],[26,1,"いわ"],[28,1,"なか"],[31,1,"みつ"],[33,1,"す"],[37,1,"かた"],[39,1,"いわ"],[42,1,"あぶら"],[44,1,"す"]],"text":"主は彼に地の高き所を乗り通らせ、田畑の産物を食わせ、岩の中から蜜を吸わせ、堅い岩から油を吸わせ、"},{"ref":"Deut.32.14","start":5032014,"end":5032014,"break":"line","breaks":[[9,"line"],[18,"line"],[29,"line"],[43,"line"]],"ruby":[[0,1,"うし"],[2,2,"ぎょうにゅう"],[5,1,"ひつじ"],[7,1,"ちち"],[9,2,"こひつじ"],[12,2,"おひつじ"],[15,2,"しぼう"],[23,1,"うし"],[25,1,"お"],[29,2,"こむぎ"],[32,1,"よ"],[34,1,"もの"],[36,1,"く"],[58,1,"た"],[60,1,"さけ"],[62,1,"の"]],"text":"牛の凝乳、羊の乳、小羊と雄羊の脂肪、バシャンの牛と雄やぎ、小麦の良い物を食わせられた。またあなたはぶどうのしるのあわ立つ酒を飲んだ。"},{"ref":"Deut.32.15","start":5032015,"end":5032015,"break":"line","breaks":[[22,"line"],[40,"line"],[51,"line"]],"ruby":[[10,1,"こ"],[12,1,"ふと"],[16,1,"あし"],[26,1,"こ"],[28,1,"ふと"],[40,2,"じぶん"],[43,1,"つく"],[46,1,"かみ"],[48,1,"す"],[51,1,"すくい"],[53,1,"いわ"],[55,1,"あなど"]],"text":"しかるにエシュルンは肥え太って、足でけった。あなたは肥え太って、つややかになり、自分を造った神を捨て、救の岩を侮った。"},{"ref":"Deut.32.16","start":5032016,"end":5032016,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[6,2,"かみがみ"],[9,1,"つか"],[13,1,"しゅ"],[19,1,"おこ"],[22,1,"にく"],[34,1,"しゅ"],[36,1,"いか"],[41,1,"おこ"]],"text":"彼らはほかの神々に仕えて、主のねたみを起し、憎むべきおこないをもって主の怒りをひき起した。"},{"ref":"Deut.32.17","start":5032017,"end":5032017,"break":"line","breaks":[[19,"line"],[37,"line"],[48,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かみ"],[8,2,"あくれい"],[11,2,"ぎせい"],[22,1,"かれ"],[28,1,"し"],[34,2,"かみがみ"],[37,1,"ちか"],[40,1,"で"],[42,1,"あたら"],[45,2,"かみがみ"],[48,2,"せんぞ"],[53,1,"おそ"],[64,1,"もの"]],"text":"彼らは神でもない悪霊に犠牲をささげた。それは彼らがかつて知らなかった神々、近ごろ出た新しい神々、先祖たちの恐れることもしなかった者である。"},{"ref":"Deut.32.18","start":5032018,"end":5032018,"break":"line","breaks":[[16,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"う"],[10,1,"いわ"],[12,1,"かろ"],[16,2,"じぶん"],[19,1,"つく"],[22,1,"かみ"],[24,1,"わす"]],"text":"あなたは自分を生んだ岩を軽んじ、自分を造った神を忘れた。"},{"ref":"Deut.32.19","start":5032019,"end":5032019,"break":"line","breaks":[[7,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"み"],[13,1,"むすめ"],[15,1,"いか"],[21,1,"す"]],"text":"主はこれを見、そのむすこ、娘を怒ってそれを捨てられた。"},{"ref":"Deut.32.20","start":5032020,"end":5032020,"break":"line","breaks":[[8,"line"],[26,"line"],[46,"line"],[60,"line"]],"ruby":[[3,1,"い"],[17,1,"かお"],[19,1,"かれ"],[22,1,"かく"],[30,1,"かれ"],[33,1,"おわ"],[42,1,"み"],[46,1,"かれ"],[60,2,"しんじつ"],[65,1,"こ"]],"text":"そして言われた、『わたしはわたしの顔を彼らに隠そう。わたしは彼らの終りがどうなるかを見よう。彼らはそむき、もとるやから、真実のない子らである。"},{"ref":"Deut.32.21","start":5032021,"end":5032021,"break":"line","breaks":[[14,"line"],[26,"line"],[42,"line"],[64,"line"],[75,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かみ"],[8,1,"もの"],[22,1,"おこ"],[26,2,"ぐうぞう"],[37,1,"いか"],[51,1,"たみ"],[58,1,"もの"],[64,1,"かれ"],[71,1,"おこ"],[75,1,"おろ"],[78,1,"たみ"],[84,1,"かれ"],[87,1,"いか"]],"text":"彼らは神でもない者をもって、わたしにねたみを起させ、偶像をもって、わたしを怒らせた。それゆえ、わたしは民ともいえない者をもって、彼らにねたみを起させ、愚かな民をもって、彼らを怒らせるであろう。"},{"ref":"Deut.32.22","start":5032022,"end":5032022,"break":"line","breaks":[[18,"line"],[31,"line"],[45,"line"]],"ruby":[[4,1,"いか"],[11,1,"ひ"],[13,1,"も"],[18,2,"よみ"],[21,1,"ふか"],[26,1,"も"],[28,1,"い"],[31,1,"ち"],[35,2,"さんぶつ"],[39,1,"や"],[45,2,"やまやま"],[48,1,"もとい"],[50,1,"も"]],"text":"わたしの怒りによって、火は燃えいで、陰府の深みにまで燃え行き、地とその産物とを焼きつくし、山々の基を燃やすであろう。"},{"ref":"Deut.32.23","start":5032023,"end":5032023,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"かれ"],[7,1,"うえ"],[9,1,"わざわい"],[11,1,"つ"],[21,1,"や"],[23,1,"かれ"],[30,1,"い"]],"text":"わたしは彼らの上に災を積みかさね、わたしの矢を彼らにむかって射つくすであろう。"},{"ref":"Deut.32.24","start":5032024,"end":5032024,"break":"line","breaks":[[12,"line"],[31,"line"],[47,"line"]],"ruby":[[0,1,"かれ"],[3,1,"う"],[9,1,"おとろ"],[12,2,"ねつびょう"],[15,1,"わる"],[17,2,"えきびょう"],[23,1,"ほろ"],[35,1,"かれ"],[38,1,"けもの"],[40,1,"は"],[47,1,"ち"],[49,1,"は"],[54,1,"どく"]],"text":"彼らは飢えて、やせ衰え、熱病と悪い疫病によって滅びるであろう。わたしは彼らを獣の歯にかからせ、地に這うものの毒にあたらせるであろう。"},{"ref":"Deut.32.25","start":5032025,"end":5032025,"break":"line","breaks":[[17,"line"],[26,"line"]],"ruby":[[0,1,"そと"],[7,1,"うち"],[10,1,"おそ"],[17,1,"わか"],[19,1,"おとこ"],[21,1,"わか"],[23,1,"おんな"],[26,1,"ち"],[29,1,"ご"],[36,1,"ひと"],[38,1,"ほろ"]],"text":"外にはつるぎ、内には恐れがあって、若き男も若き女も、乳のみ子も、しらがの人も滅びるであろう。"},{"ref":"Deut.32.26","start":5032026,"end":5032026,"break":"line","breaks":[[24,"line"]],"ruby":[[7,1,"い"],[15,1,"かれ"],[18,1,"とお"],[20,1,"ち"],[24,1,"かれ"],[27,1,"こと"],[29,2,"ひとびと"],[32,2,"きおく"]],"text":"わたしはまさに言おうとした、「彼らを遠く散らし、彼らの事を人々が記憶しないようにしよう」。"},{"ref":"Deut.32.27","start":5032027,"end":5032027,"break":"line","breaks":[[18,"line"],[35,"line"],[51,"line"]],"ruby":[[8,1,"てき"],[10,1,"ほこ"],[14,1,"おそ"],[28,1,"い"],[41,1,"て"],[43,1,"か"],[56,1,"しゅ"]],"text":"しかし、わたしは敵が誇るのを恐れる。あだびとはまちがえて言うであろう、「われわれの手が勝ちをえたのだ。これはみな主がされたことではない」』。"},{"ref":"Deut.32.28","start":5032028,"end":5032028,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[3,2,"しりょ"],[6,1,"か"],[9,1,"たみ"],[17,2,"ちしき"]],"text":"彼らは思慮の欠けた民、そのうちには知識がない。"},{"ref":"Deut.32.29","start":5032029,"end":5032029,"break":"line","breaks":[[20,"line"]],"ruby":[[3,1,"かれ"],[6,2,"ちえ"],[22,1,"み"],[24,1,"おわ"]],"text":"もし、彼らに知恵があれば、これをさとり、その身の終りをわきまえたであろうに。"},{"ref":"Deut.32.30","start":5032030,"end":5032030,"break":"line","breaks":[[12,"line"],[29,"line"],[44,"line"]],"ruby":[[0,1,"かれ"],[3,1,"いわ"],[5,1,"かれ"],[8,1,"う"],[12,1,"しゅ"],[14,1,"かれ"],[39,1,"にん"],[41,1,"お"],[48,1,"まん"],[49,1,"にん"],[51,1,"やぶ"]],"text":"彼らの岩が彼らを売らず、主が彼らをわたされなかったならば、どうして、ひとりで千人を追い、ふたりで万人を敗ることができたであろう。"},{"ref":"Deut.32.31","start":5032031,"end":5032031,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[3,1,"いわ"],[9,1,"いわ"],[11,1,"およ"],[20,1,"てき"],[25,1,"みと"]],"text":"彼らの岩はわれらの岩に及ばない。われらの敵もこれを認めている。"},{"ref":"Deut.32.32","start":5032032,"end":5032032,"break":"line","breaks":[[10,"line"],[26,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[7,1,"き"],[18,1,"き"],[21,1,"で"],[32,1,"の"],[35,1,"で"],[46,1,"どく"],[56,1,"にが"]],"text":"彼らのぶどうの木は、ソドムのぶどうの木から出たもの、またゴモラの野から出たもの、そのぶどうは毒ぶどう、そのふさは苦い。"},{"ref":"Deut.32.33","start":5032033,"end":5032033,"break":"line","breaks":[[15,"line"]],"ruby":[[5,1,"しゅ"],[10,1,"どく"],[19,1,"おそ"],[23,1,"どく"]],"text":"そのぶどう酒はへびの毒のよう、まむしの恐ろしい毒のようである。"},{"ref":"Deut.32.34","start":5032034,"end":5032034,"break":"line","breaks":[[17,"line"]],"ruby":[[21,1,"くら"],[23,1,"ふう"],[25,1,"こ"]],"text":"これはわたしのもとにたくわえられ、わたしの倉に封じ込められているではないか。"},{"ref":"Deut.32.35","start":5032035,"end":5032035,"break":"line","breaks":[[11,"line"],[31,"line"],[41,"line"],[48,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あし"],[18,1,"かえ"],[21,1,"むく"],[31,1,"かれ"],[34,1,"わざわい"],[36,1,"ひ"],[38,1,"ちか"],[41,1,"かれ"],[44,2,"はめつ"],[53,1,"く"]],"text":"彼らの足がすべるとき、わたしはあだを返し、報いをするであろう。彼らの災の日は近く、彼らの破滅は、すみやかに来るであろう。"},{"ref":"Deut.32.36","start":5032036,"end":5032036,"break":"line","breaks":[[13,"line"],[35,"line"],[48,"line"],[64,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"たみ"],[25,1,"くわ"],[38,1,"かれ"],[41,1,"ちから"],[45,1,"さ"],[53,1,"もの"],[61,1,"もの"],[76,1,"しゅ"],[78,1,"み"]],"text":"主はついにその民をさばき、そのしもべらにあわれみを加えられるであろう。これは彼らの力がうせ去り、つながれた者もつながれない者も、もはやいなくなったのを、主が見られるからである。"},{"ref":"Deut.32.37","start":5032037,"end":5032037,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"い"],[16,1,"かれ"],[19,2,"かみがみ"],[29,1,"かれ"],[32,1,"たの"],[37,1,"いわ"]],"text":"そのとき主は言われるであろう、『彼らの神々はどこにいるか、彼らの頼みとした岩はどこにあるか。"},{"ref":"Deut.32.38","start":5032038,"end":5032038,"break":"line","breaks":[[13,"line"],[30,"line"],[48,"line"]],"ruby":[[0,1,"かれ"],[3,2,"ぎせい"],[10,1,"く"],[13,2,"かんさい"],[16,1,"さけ"],[18,1,"の"],[21,1,"もの"],[30,1,"た"],[42,1,"たす"],[54,1,"まも"]],"text":"彼らの犠牲のあぶらを食い、灌祭の酒を飲んだ者はどこにいるか。立ちあがってあなたがたを助けさせよ、あなたがたを守らせよ。"},{"ref":"Deut.32.39","start":5032039,"end":5032039,"break":"line","breaks":[[15,"line"],[27,"line"],[40,"line"],[50,"line"]],"ruby":[[0,2,"いまみ"],[10,1,"かれ"],[22,1,"かみ"],[31,1,"ころ"],[36,1,"い"],[40,1,"きず"],[54,1,"て"],[57,1,"すく"],[59,1,"だ"]],"text":"今見よ、わたしこそは彼である。わたしのほかに神はない。わたしは殺し、また生かし、傷つけ、またいやす。わたしの手から救い出しうるものはない。"},{"ref":"Deut.32.40","start":5032040,"end":5032040,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"てん"],[9,1,"て"],[14,1,"ちか"],[22,2,"えいえん"],[25,1,"い"]],"text":"わたしは天にむかい手をあげて誓う、「わたしは永遠に生きる。"},{"ref":"Deut.32.41","start":5032041,"end":5032041,"break":"line","breaks":[[15,"line"],[26,"line"],[38,"line"]],"ruby":[[15,1,"て"],[21,1,"にぎ"],[30,1,"てき"],[35,1,"かえ"],[42,1,"にく"],[44,1,"もの"],[46,2,"ほうふく"]],"text":"わたしがきらめくつるぎをとぎ、手にさばきを握るとき、わたしは敵にあだを返し、わたしを憎む者に報復するであろう。"},{"ref":"Deut.32.42","start":5032042,"end":5032042,"break":"line","breaks":[[12,"line"],[31,"line"],[50,"line"]],"ruby":[[4,1,"や"],[6,1,"ち"],[8,1,"よ"],[20,1,"にく"],[22,1,"く"],[31,1,"ころ"],[35,1,"もの"],[37,1,"とら"],[42,1,"もの"],[44,1,"ち"],[46,1,"の"],[50,1,"てき"],[52,2,"ちょうはつ"],[55,1,"あたま"],[57,1,"にく"],[59,1,"く"]],"text":"わたしの矢を血に酔わせ、わたしのつるぎに肉を食わせるであろう。殺された者と捕えられた者の血を飲ませ、敵の長髪の頭の肉を食わせるであろう」』。"},{"ref":"Deut.32.43","start":5032043,"end":5032043,"break":"line","breaks":[[18,"line"],[35,"line"],[45,"line"]],"ruby":[[0,2,"くにぐに"],[3,1,"たみ"],[6,1,"しゅ"],[8,1,"たみ"],[13,1,"よろこ"],[15,1,"うた"],[18,1,"しゅ"],[26,1,"ち"],[31,2,"ほうふく"],[37,1,"てき"],[42,1,"かえ"],[47,1,"たみ"],[49,1,"ち"],[51,1,"けが"],[54,1,"きよ"]],"text":"国々の民よ、主の民のために喜び歌え。主はそのしもべの血のために報復し、その敵にあだを返し、その民の地の汚れを清められるからである」。"},{"ref":"Deut.32.44","start":5032044,"end":5032044,"break":"paragraph","ruby":[[7,1,"こ"],[13,1,"とも"],[15,1,"い"],[21,1,"うた"],[23,2,"ことば"],[32,1,"たみ"],[34,1,"よ"],[36,1,"き"]],"text":"モーセとヌンの子ヨシュアは共に行って、この歌の言葉を、ことごとく民に読み聞かせた。"},{"ref":"Deut.32.45","start":5032045,"end":5032045,"break":"none","ruby":[[6,2,"ことば"],[25,1,"ひと"],[27,1,"つ"],[29,1,"おわ"]],"text":"モーセはこの言葉を、ことごとくイスラエルのすべての人に告げ終って、"},{"ref":"Deut.32.46","start":5032046,"end":5032046,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[29,1,"めい"],[38,2,"ことば"],[41,1,"こころ"],[47,2,"こども"],[55,2,"りっぽう"],[62,2,"ことば"],[65,1,"まも"],[67,1,"おこな"],[72,1,"めい"]],"text":"彼らに言った、「あなたがたはわたしが、きょう、あなたがたに命じるこのすべての言葉を心におさめ、子供たちにもこの律法のすべての言葉を守り行うことを命じなければならない。"},{"ref":"Deut.32.47","start":5032047,"end":5032047,"break":"none","ruby":[[2,2,"ことば"],[19,2,"ことば"],[44,2,"ことば"],[61,1,"わた"],[64,1,"い"],[67,1,"と"],[69,1,"ち"],[72,1,"なが"],[74,1,"いのち"],[76,1,"たも"]],"text":"この言葉はあなたがたにとって、むなしい言葉ではない。これはあなたがたのいのちである。この言葉により、あなたがたはヨルダンを渡って行って取る地で、長く命を保つことができるであろう」。"},{"ref":"Deut.32.48","start":5032048,"end":5032048,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"しゅ"],[10,1,"い"]],"text":"この日、主はモーセに言われた、"},{"ref":"Deut.32.49","start":5032049,"end":5032049,"break":"none","ruby":[[9,1,"たい"],[16,1,"ち"],[24,1,"やま"],[31,1,"やま"],[33,1,"のぼ"],[46,2,"ひとびと"],[49,1,"あた"],[52,1,"え"],[60,1,"ち"],[62,2,"みわ"]],"text":"「あなたはエリコに対するモアブの地にあるアバリム山すなわちネボ山に登り、わたしがイスラエルの人々に与えて獲させるカナンの地を見渡たせ。"},{"ref":"Deut.32.50","start":5032050,"end":5032050,"break":"none","ruby":[[4,1,"のぼ"],[7,1,"い"],[11,1,"やま"],[13,1,"し"],[20,1,"たみ"],[22,1,"つら"],[34,2,"きょうだい"],[42,1,"やま"],[44,1,"し"],[49,1,"たみ"],[51,1,"つら"]],"text":"あなたは登って行くその山で死に、あなたの民に連なるであろう。あなたの兄弟アロンがホル山で死んでその民に連なったようになるであろう。"},{"ref":"Deut.32.51","start":5032051,"end":5032051,"break":"none","ruby":[[12,2,"あらの"],[26,1,"みず"],[39,2,"ひとびと"],[59,2,"ひとびと"],[69,1,"せい"],[77,1,"うやま"]],"text":"これはあなたがたがチンの荒野にあるメリバテ・カデシの水のほとりで、イスラエルの人々のうちでわたしにそむき、イスラエルの人々のうちでわたしを聖なるものとして敬わなかったからである。"},{"ref":"Deut.32.52","start":5032052,"end":5032052,"break":"none","ruby":[[17,2,"ひとびと"],[20,1,"あた"],[23,1,"ち"],[26,1,"め"],[28,1,"まえ"],[30,1,"み"],[43,1,"ち"]],"text":"それであなたはわたしがイスラエルの人々に与える地を、目の前に見るであろう。しかし、その地に、はいることはできない」。"}]