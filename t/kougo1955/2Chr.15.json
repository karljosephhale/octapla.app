[{"ref":"2Chr.15.1","start":14015001,"end":14015001,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"かみ"],[4,1,"れい"],[10,1,"こ"],[16,1,"のぞ"]],"text":"時に神の霊がオデデの子アザリヤに臨んだので、"},{"ref":"2Chr.15.2","start":14015002,"end":14015002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"で"],[10,1,"むか"],[16,1,"い"],[35,2,"ひとびと"],[43,1,"き"],[55,1,"しゅ"],[57,1,"とも"],[61,1,"あいだ"],[64,1,"しゅ"],[72,1,"とも"],[89,1,"かれ"],[91,1,"もと"],[98,1,"かれ"],[100,1,"あ"],[111,1,"かれ"],[113,1,"す"],[120,1,"かれ"],[128,1,"す"]],"text":"彼は出ていってアサを迎え、これに言った、「アサおよびユダとベニヤミンの人々よ、わたしに聞きなさい。あなたがたが主と共におる間は、主もあなたがたと共におられます。あなたがたが、もし彼を求めるならば、彼に会うでしょう。しかし、彼を捨てるならば、彼もあなたがたを捨てられるでしょう。"},{"ref":"2Chr.15.3","start":14015003,"end":14015003,"break":"none","ruby":[[12,1,"なが"],[14,1,"あいだ"],[20,1,"かみ"],[25,1,"おしえ"],[29,2,"さいし"],[35,2,"りっぽう"]],"text":"そもそも、イスラエルには長い間、まことの神がなく、教をなす祭司もなく、律法もなかった。"},{"ref":"2Chr.15.4","start":14015004,"end":14015004,"break":"none","ruby":[[4,1,"なや"],[7,1,"とき"],[9,1,"かれ"],[18,1,"かみ"],[20,1,"しゅ"],[22,1,"た"],[24,1,"かえ"],[27,1,"かれ"],[29,1,"もと"],[34,1,"かれ"],[36,1,"あ"]],"text":"しかし、悩みの時、彼らがイスラエルの神、主に立ち返り、彼を求めたので彼に会った。"},{"ref":"2Chr.15.5","start":14015005,"end":14015005,"break":"none","ruby":[[6,1,"で"],[8,1,"もの"],[11,1,"い"],[13,1,"もの"],[17,2,"へいあん"],[23,1,"おお"],[27,2,"そうらん"],[30,2,"くにぐに"],[37,2,"じゅうみん"],[40,1,"なや"]],"text":"そのころは、出る者にも入る者にも、平安がなく、大いなる騒乱が国々のすべての住民を悩ました。"},{"ref":"2Chr.15.6","start":14015006,"end":14015006,"break":"none","ruby":[[0,1,"くに"],[2,1,"くに"],[5,1,"まち"],[7,1,"まち"],[9,1,"う"],[11,1,"くだ"],[16,1,"かみ"],[23,1,"なや"],[29,1,"かれ"],[32,1,"くる"]],"text":"国は国に、町は町に撃ち砕かれた。神がもろもろの悩みをもって彼らを苦しめられたからです。"},{"ref":"2Chr.15.7","start":14015007,"end":14015007,"break":"none","ruby":[[9,2,"ゆうき"],[12,1,"だ"],[18,1,"て"],[20,1,"よわ"],[40,1,"むく"]],"text":"しかしあなたがたは勇気を出しなさい。手を弱くしてはならない。あなたがたのわざには報いがあるからです」。"},{"ref":"2Chr.15.8","start":14015008,"end":14015008,"break":"paragraph","ruby":[[7,2,"ことば"],[17,1,"こ"],[23,2,"よげん"],[26,1,"き"],[29,2,"ゆうき"],[32,1,"え"],[34,1,"にく"],[38,2,"ぐうぞう"],[50,1,"ぜん"],[51,1,"ち"],[54,1,"のぞ"],[59,1,"かれ"],[67,2,"さんち"],[70,1,"え"],[72,2,"まちまち"],[76,1,"のぞ"],[79,1,"しゅ"],[81,1,"みや"],[83,1,"ろう"],[85,1,"まえ"],[90,1,"しゅ"],[92,2,"さいだん"],[95,2,"さいこう"]],"text":"アサはこれらの言葉すなわちオデデの子アザリヤの預言を聞いて勇気を得、憎むべき偶像をユダとベニヤミンの全地から除き、また彼がエフライムの山地で得た町々から除き、主の宮の廊の前にあった主の祭壇を再興した。"},{"ref":"2Chr.15.9","start":14015009,"end":14015009,"break":"none","ruby":[[0,1,"かれ"],[13,2,"ひとびと"],[34,1,"き"],[37,1,"かれ"],[40,1,"あいだ"],[42,2,"きりゅう"],[48,1,"もの"],[50,1,"あつ"],[56,1,"かみ"],[58,1,"しゅ"],[63,1,"とも"],[71,1,"み"],[87,1,"くだ"],[90,1,"もの"],[92,1,"おお"]],"text":"彼はまたユダとベニヤミンの人々およびエフライム、マナセ、シメオンから来て、彼らの間に寄留していた者を集めた。その神、主がアサと共におられるのを見て、イスラエルからアサのもとに下った者が多くあったからである。"},{"ref":"2Chr.15.10","start":14015010,"end":14015010,"break":"none","ruby":[[0,1,"かれ"],[6,2,"ちせい"],[11,1,"ねん"],[14,1,"がつ"],[22,1,"あつ"]],"text":"彼らはアサの治世の十五年の三月にエルサレムに集まり、"},{"ref":"2Chr.15.11","start":14015011,"end":14015011,"break":"none","ruby":[[0,1,"たずさ"],[9,1,"もの"],[15,1,"うし"],[18,1,"とう"],[20,1,"ひつじ"],[23,1,"とう"],[27,1,"ひ"],[28,1,"しゅ"]],"text":"携えてきたぶんどり物のうちから牛七百頭、羊七千頭をその日主にささげた。"},{"ref":"2Chr.15.12","start":14015012,"end":14015012,"break":"none","ruby":[[3,1,"かれ"],[6,2,"けいやく"],[9,1,"むす"],[12,1,"こころ"],[18,2,"せいしん"],[25,2,"せんぞ"],[28,1,"かみ"],[30,1,"しゅ"],[32,1,"もと"]],"text":"そして彼らは契約を結び、心をつくし、精神をつくして先祖の神、主を求めることと、"},{"ref":"2Chr.15.13","start":14015013,"end":14015013,"break":"none","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[13,1,"もと"],[17,1,"もの"],[19,2,"ろうよう"],[21,2,"だんじょ"],[24,1,"べつ"],[27,1,"ころ"],[35,1,"やく"]],"text":"すべてイスラエルの神、主を求めない者は老幼男女の別なく殺さるべきことを約した。"},{"ref":"2Chr.15.14","start":14015014,"end":14015014,"break":"none","ruby":[[3,1,"かれ"],[6,2,"おおごえ"],[12,1,"さけ"],[19,1,"ふ"],[22,2,"つのぶえ"],[25,1,"な"],[30,1,"しゅ"],[32,1,"ちか"],[35,1,"た"]],"text":"そして彼らは大声をあげて叫び、ラッパを吹き、角笛を鳴らして、主に誓いを立てた。"},{"ref":"2Chr.15.15","start":14015015,"end":14015015,"break":"none","ruby":[[3,1,"みな"],[6,1,"ちか"],[9,1,"よろこ"],[13,1,"かれ"],[16,1,"こころ"],[22,1,"ちか"],[25,1,"た"],[28,2,"せいしん"],[35,1,"しゅ"],[37,1,"もと"],[43,1,"しゅ"],[45,1,"かれ"],[48,1,"あ"],[51,2,"しほう"],[54,1,"かれ"],[57,2,"あんそく"],[60,1,"たま"]],"text":"ユダは皆その誓いを喜んだ。彼らは心をつくして誓いを立て、精神をつくして主を求めたので、主は彼らに会い、四方で彼らに安息を賜わった。"},{"ref":"2Chr.15.16","start":14015016,"end":14015016,"break":"paragraph","ruby":[[2,1,"おう"],[4,1,"はは"],[16,1,"にく"],[20,1,"ぞう"],[22,1,"つく"],[31,2,"かのじょ"],[38,2,"たいこう"],[46,1,"にく"],[50,1,"ぞう"],[52,1,"き"],[54,1,"たお"],[57,2,"こなごな"],[60,1,"くだ"],[67,1,"かわ"],[72,1,"や"]],"text":"アサ王の母マアカがアシラのために憎むべき像を造ったので、アサは彼女をおとして太后とせず、その憎むべき像を切り倒して粉々に砕き、キデロン川でそれを焼いた。"},{"ref":"2Chr.15.17","start":14015017,"end":14015017,"break":"none","ruby":[[3,1,"たか"],[5,1,"ところ"],[14,1,"のぞ"],[25,1,"こころ"],[27,2,"いっしょう"],[30,1,"あいだ"],[32,1,"ただ"]],"text":"ただし高き所はイスラエルから除かなかったが、アサの心は一生の間、正しかった。"},{"ref":"2Chr.15.18","start":14015018,"end":14015018,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ちち"],[13,1,"もの"],[17,2,"じぶん"],[24,1,"もの"],[30,1,"ぎん"],[32,1,"きん"],[33,1,"なら"],[36,2,"うつわもの"],[41,1,"しゅ"],[43,1,"みや"],[45,1,"たずさ"],[47,1,"い"]],"text":"彼はまた、その父のささげた物および自分のささげた物、すなわち銀、金並びに器物などを主の宮に携え入れた。"},{"ref":"2Chr.15.19","start":14015019,"end":14015019,"break":"none","ruby":[[6,2,"ちせい"],[12,1,"ねん"],[16,1,"ふたた"],[18,2,"せんそう"]],"text":"そしてアサの治世の三十五年までは再び戦争がなかった。"}]