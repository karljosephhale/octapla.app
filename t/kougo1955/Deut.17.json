[{"ref":"Deut.17.1","start":5017001,"end":5017001,"break":"paragraph","ruby":[[3,1,"きず"],[8,1,"か"],[11,1,"ところ"],[15,1,"うし"],[19,1,"ひつじ"],[25,1,"かみ"],[27,1,"しゅ"],[51,1,"かみ"],[53,1,"しゅ"],[55,1,"い"]],"text":"すべて傷があり、欠けた所のある牛または羊はあなたの神、主にささげてはならない。そのようなものはあなたの神、主の忌みきらわれるものだからである。"},{"ref":"Deut.17.2","start":5017002,"end":5017002,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"たま"],[11,1,"まち"],[26,2,"だんし"],[31,2,"じょし"],[38,1,"かみ"],[40,1,"しゅ"],[42,1,"まえ"],[44,2,"あくじ"],[53,2,"けいやく"]],"text":"あなたの神、主が賜わる町で、あなたがたのうちに、もし男子または女子があなたの神、主の前に悪事をおこなって、契約にそむき、"},{"ref":"Deut.17.3","start":5017003,"end":5017003,"break":"none","ruby":[[0,1,"い"],[3,1,"た"],[5,2,"かみがみ"],[8,1,"つか"],[14,1,"おが"],[21,1,"きん"],[25,1,"ひ"],[27,1,"つき"],[31,1,"た"],[33,1,"てん"],[35,2,"ばんしょう"],[38,1,"おが"]],"text":"行って他の神々に仕え、それを拝み、わたしの禁じる、日や月やその他の天の万象を拝むことがあり、"},{"ref":"Deut.17.4","start":5017004,"end":5017004,"break":"none","ruby":[[2,1,"こと"],[4,1,"し"],[8,1,"もの"],[21,1,"き"],[36,1,"しら"],[52,1,"こと"],[54,2,"しんじつ"],[65,1,"にく"],[69,1,"こと"],[71,1,"たし"],[83,1,"おこな"]],"text":"その事を知らせる者があって、あなたがそれを聞くならば、あなたはそれをよく調べなければならない。そしてその事が真実であり、そのような憎むべき事が確かにイスラエルのうちに行われていたならば、"},{"ref":"Deut.17.5","start":5017005,"end":5017005,"break":"none","ruby":[[6,2,"あくじ"],[14,2,"だんし"],[19,2,"じょし"],[22,1,"まち"],[24,1,"もん"],[28,1,"だ"],[33,2,"だんし"],[38,2,"じょし"],[41,1,"いし"],[43,1,"う"],[45,1,"ころ"]],"text":"あなたはその悪事をおこなった男子または女子を町の門にひき出し、その男子または女子を石で撃ち殺さなければならない。"},{"ref":"Deut.17.6","start":5017006,"end":5017006,"break":"none","ruby":[[4,2,"しょうにん"],[10,1,"にん"],[12,2,"しょうにん"],[15,2,"しょうげん"],[21,1,"ころ"],[25,1,"もの"],[27,1,"ころ"],[44,2,"しょうにん"],[47,2,"しょうげん"],[53,1,"ころ"]],"text":"ふたりの証人または三人の証人の証言によって殺すべき者を殺さなければならない。ただひとりの証人の証言によって殺してはならない。"},{"ref":"Deut.17.7","start":5017007,"end":5017007,"break":"none","ruby":[[5,1,"もの"],[7,1,"ころ"],[12,2,"しょうにん"],[17,1,"て"],[19,1,"くだ"],[26,1,"たみ"],[28,1,"みな"],[30,1,"て"],[32,1,"くだ"],[55,1,"あく"],[57,1,"のぞ"],[59,1,"さ"]],"text":"そのような者を殺すには、証人がまず手を下し、それから民が皆、手を下さなければならない。こうしてあなたのうちから悪を除き去らなければならない。"},{"ref":"Deut.17.8","start":5017008,"end":5017008,"break":"paragraph","ruby":[[0,1,"まち"],[2,1,"うち"],[4,1,"うった"],[6,1,"こと"],[8,1,"おこ"],[13,2,"じけん"],[18,1,"ち"],[20,1,"なが"],[22,1,"こと"],[27,2,"けんり"],[30,1,"あらそ"],[32,1,"こと"],[37,1,"ひと"],[39,1,"う"],[42,1,"こと"],[66,1,"とき"],[69,1,"た"],[76,1,"かみ"],[78,1,"しゅ"],[80,1,"えら"],[84,2,"ばしょ"]],"text":"町の内に訴え事が起り、その事件がもし血を流す事、または権利を争う事、または人を撃った事などであって、あなたが、さばきかねるものである時は、立ってあなたの神、主が選ばれる場所にのぼり、"},{"ref":"Deut.17.9","start":5017009,"end":5017009,"break":"none","ruby":[[7,2,"さいし"],[13,1,"とき"],[15,3,"さいばんにん"],[20,1,"い"],[23,1,"たず"],[34,1,"かれ"],[41,2,"はんけつ"],[44,2,"ことば"],[47,1,"つ"]],"text":"レビびとである祭司と、その時の裁判人とに行って尋ねなければならない。彼らはあなたに判決の言葉を告げるであろう。"},{"ref":"Deut.17.10","start":5017010,"end":5017010,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"えら"],[13,2,"ばしょ"],[17,1,"かれ"],[20,1,"つ"],[23,2,"ことば"],[26,1,"したが"],[37,1,"かれ"],[40,1,"おし"],[46,1,"まも"],[48,1,"おこな"]],"text":"あなたは、主が選ばれるその場所で、彼らが告げる言葉に従っておこない、すべて彼らが教えるように守り行わなければならない。"},{"ref":"Deut.17.11","start":5017011,"end":5017011,"break":"none","ruby":[[4,1,"かれ"],[7,1,"おし"],[10,2,"りっぽう"],[14,1,"かれ"],[17,1,"つ"],[20,2,"はんけつ"],[24,1,"したが"],[27,1,"おこな"],[38,1,"かれ"],[41,1,"つ"],[44,2,"ことば"],[52,1,"みぎ"],[55,1,"ひだり"]],"text":"すなわち彼らが教える律法と、彼らが告げる判決とに従って行わなければならない。彼らが告げる言葉にそむいて、右にも左にもかたよってはならない。"},{"ref":"Deut.17.12","start":5017012,"end":5017012,"break":"none","ruby":[[2,1,"ひと"],[19,1,"かみ"],[21,1,"しゅ"],[23,1,"まえ"],[25,1,"た"],[28,1,"つか"],[31,2,"さいし"],[36,3,"さいばんにん"],[40,1,"き"],[42,1,"したが"],[52,1,"ひと"],[54,1,"ころ"],[68,1,"あく"],[70,1,"のぞ"]],"text":"もし人がほしいままにふるまい、あなたの神、主の前に立って仕える祭司または裁判人に聞き従わないならば、その人を殺して、イスラエルのうちから悪を除かなければならない。"},{"ref":"Deut.17.13","start":5017013,"end":5017013,"break":"none","ruby":[[5,1,"たみ"],[7,1,"みな"],[9,1,"き"],[12,1,"おそ"],[15,1,"かさ"]],"text":"そうすれば民は皆、聞いて恐れ、重ねてほしいままにふるまうことをしないであろう。"},{"ref":"Deut.17.14","start":5017014,"end":5017014,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"たま"],[11,1,"ち"],[13,1,"い"],[19,1,"え"],[24,1,"す"],[31,1,"とき"],[44,2,"しゅうい"],[51,1,"くに"],[63,1,"うえ"],[65,1,"おう"],[67,1,"た"],[73,1,"い"]],"text":"あなたの神、主が賜わる地に行き、それを獲てそこに住むようになる時、もしあなたが『わたしも周囲のすべての国びとのように、わたしの上に王を立てよう』と言うならば、"},{"ref":"Deut.17.15","start":5017015,"end":5017015,"break":"none","ruby":[[0,1,"かなら"],[6,1,"かみ"],[8,1,"しゅ"],[10,1,"えら"],[14,1,"もの"],[21,1,"うえ"],[23,1,"た"],[26,1,"おう"],[38,2,"どうほう"],[50,1,"うえ"],[52,1,"た"],[55,1,"おう"],[67,2,"どうほう"],[72,2,"がいこく"],[74,1,"じん"],[80,1,"うえ"],[82,1,"た"]],"text":"必ずあなたの神、主が選ばれる者を、あなたの上に立てて王としなければならない。同胞のひとりを、あなたの上に立てて王としなければならない。同胞でない外国人をあなたの上に立ててはならない。"},{"ref":"Deut.17.16","start":5017016,"end":5017016,"break":"none","ruby":[[0,1,"おう"],[4,1,"ひと"],[6,2,"じぶん"],[12,1,"うま"],[14,1,"おお"],[16,1,"え"],[30,1,"うま"],[32,1,"おお"],[34,1,"え"],[39,1,"たみ"],[46,1,"かえ"],[56,1,"しゅ"],[72,1,"のち"],[79,1,"みち"],[81,1,"かえ"],[91,1,"おお"]],"text":"王となる人は自分のために馬を多く獲ようとしてはならない。また馬を多く獲るために民をエジプトに帰らせてはならない。主はあなたがたにむかって、『この後かさねてこの道に帰ってはならない』と仰せられたからである。"},{"ref":"Deut.17.17","start":5017017,"end":5017017,"break":"none","ruby":[[2,1,"つま"],[4,1,"おお"],[6,1,"も"],[9,1,"こころ"],[12,1,"まよ"],[24,2,"じぶん"],[30,2,"きんぎん"],[33,1,"おお"]],"text":"また妻を多く持って心を、迷わしてはならない。また自分のために金銀を多くたくわえてはならない。"},{"ref":"Deut.17.18","start":5017018,"end":5017018,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"くに"],[4,2,"おうい"],[24,2,"さいし"],[27,2,"ほかん"],[31,2,"しょもつ"],[38,2,"りっぽう"],[41,1,"うつ"],[47,2,"しょもつ"],[50,1,"か"]],"text":"彼が国の王位につくようになったら、レビびとである祭司の保管する書物から、この律法の写しを一つの書物に書きしるさせ、"},{"ref":"Deut.17.19","start":5017019,"end":5017019,"break":"none","ruby":[[0,1,"よ"],[2,1,"い"],[9,1,"ひ"],[11,1,"あいだ"],[13,1,"つね"],[18,2,"じぶん"],[24,1,"お"],[27,1,"よ"],[36,1,"かみ"],[38,1,"しゅ"],[40,1,"おそ"],[46,1,"まな"],[51,2,"りっぽう"],[58,2,"ことば"],[66,1,"さだ"],[70,1,"まも"],[73,1,"おこな"]],"text":"世に生きながらえる日の間、常にそれを自分のもとに置いて読み、こうしてその神、主を恐れることを学び、この律法のすべての言葉と、これらの定めとを守って行わなければならない。"},{"ref":"Deut.17.20","start":5017020,"end":5017020,"break":"none","ruby":[[5,1,"かれ"],[7,1,"こころ"],[9,2,"どうほう"],[12,1,"み"],[18,1,"たか"],[28,1,"いまし"],[31,1,"はな"],[35,1,"みぎ"],[38,1,"ひだり"],[41,1,"まが"],[50,2,"しそん"],[53,1,"とも"],[65,1,"なが"],[69,1,"くらい"]],"text":"そうすれば彼の心が同胞を見くだして、高ぶることなく、また戒めを離れて、右にも左にも曲ることなく、その子孫と共にイスラエルにおいて、長くその位にとどまることができるであろう。"}]