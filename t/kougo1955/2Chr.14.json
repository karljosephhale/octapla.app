[{"ref":"2Chr.14.1","start":14014001,"end":14014001,"break":"paragraph","ruby":[[6,2,"せんぞ"],[11,1,"とも"],[13,1,"ねむ"],[21,1,"まち"],[23,1,"ほうむ"],[29,1,"こ"],[33,1,"かわ"],[36,1,"おう"],[45,2,"ちせい"],[48,1,"くに"],[51,1,"ねん"],[53,1,"あいだ"],[55,1,"おだ"]],"text":"アビヤはその先祖たちと共に眠って、ダビデの町に葬られ、その子アサが代って王となった。アサの治世に国は十年の間、穏やかであった。"},{"ref":"2Chr.14.2","start":14014002,"end":14014002,"break":"none","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[9,1,"め"],[11,1,"よ"],[14,1,"み"],[19,1,"ただ"],[22,1,"み"],[28,1,"おこな"]],"text":"アサはその神、主の目に良しと見え、また正しと見えることを行った。"},{"ref":"2Chr.14.3","start":14014003,"end":14014003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こと"],[5,2,"さいだん"],[14,1,"たか"],[16,1,"ところ"],[18,1,"と"],[20,1,"のぞ"],[23,2,"せきちゅう"],[33,1,"ぞう"],[35,1,"き"],[37,1,"たお"]],"text":"彼は異なる祭壇と、もろもろの高き所を取り除き、石柱をこわし、アシラ像を切り倒し、"},{"ref":"2Chr.14.4","start":14014004,"end":14014004,"break":"none","ruby":[[3,1,"めい"],[8,2,"せんぞ"],[13,1,"かみ"],[15,1,"しゅ"],[17,1,"もと"],[26,1,"いまし"],[30,1,"おこな"]],"text":"ユダに命じてその先祖たちの神、主を求めさせ、おきてと戒めとを行わせ、"},{"ref":"2Chr.14.5","start":14014005,"end":14014005,"break":"none","ruby":[[7,2,"まちまち"],[12,1,"たか"],[14,1,"ところ"],[16,1,"こう"],[18,2,"さいだん"],[22,1,"と"],[24,1,"のぞ"],[31,1,"くに"],[33,1,"かれ"],[38,1,"おだ"]],"text":"ユダのすべての町々から、高き所と香の祭壇とを取り除いた。そして国は彼のもとに穏やかであった。"},{"ref":"2Chr.14.6","start":14014006,"end":14014006,"break":"none","ruby":[[0,1,"かれ"],[2,1,"くに"],[4,1,"おだ"],[14,2,"ようがい"],[17,1,"まち"],[18,2,"すうこ"],[24,1,"た"],[30,1,"しゅ"],[32,1,"かれ"],[34,2,"へいあん"],[37,1,"たま"],[46,1,"とし"],[49,2,"せんそう"]],"text":"彼は国が穏やかであったので、要害の町数個をユダに建てた。また主が彼に平安を賜わったので、この年ごろ戦争がなかった。"},{"ref":"2Chr.14.7","start":14014007,"end":14014007,"break":"none","ruby":[[0,1,"かれ"],[5,1,"い"],[19,1,"まち"],[21,1,"た"],[26,2,"しゅうい"],[29,1,"いし"],[33,1,"きず"],[40,1,"た"],[43,1,"もん"],[45,1,"かん"],[47,1,"き"],[49,1,"もう"],[64,1,"かみ"],[66,1,"しゅ"],[68,1,"もと"],[76,1,"くに"],[96,1,"かれ"],[98,1,"もと"],[104,2,"しほう"],[116,2,"へいあん"],[119,1,"たま"],[129,1,"かれ"],[132,1,"とどこお"],[136,1,"た"],[138,1,"おわ"]],"text":"彼はユダに言った、「われわれはこれらの町を建て、その周囲に石がきを築き、やぐらを建て、門と貫の木を設けよう。われわれがわれわれの神、主を求めたので、この国はなおわれわれのものであり、われわれが彼を求めたので、四方において、われわれに平安を賜わった」。こうして彼らは滞りなく建て終った。"},{"ref":"2Chr.14.8","start":14014008,"end":14014008,"break":"none","ruby":[[3,2,"ぐんたい"],[10,1,"で"],[12,1,"もの"],[16,1,"にん"],[21,1,"たて"],[36,1,"で"],[38,1,"もの"],[43,1,"にん"],[48,2,"こだて"],[54,1,"ゆみ"],[56,1,"ひ"],[65,1,"だい"],[66,2,"ゆうし"]],"text":"アサの軍隊はユダから出た者三十万人あって、盾とやりをとり、ベニヤミンから出た者二十八万人あって、小盾をとり、弓を引いた。これはみな大勇士であった。"},{"ref":"2Chr.14.9","start":14014009,"end":14014009,"break":"paragraph","ruby":[[14,2,"ぐんたい"],[20,2,"せんしゃ"],[23,1,"ひき"],[33,1,"せ"]],"text":"エチオピヤびとゼラが、百万の軍隊と三百の戦車を率いて、マレシャまで攻めてきた。"},{"ref":"2Chr.14.10","start":14014010,"end":14014010,"break":"none","ruby":[[3,1,"で"],[9,1,"むか"],[21,1,"たに"],[23,1,"たたか"],[26,1,"そな"]],"text":"アサは出て、これを迎え、マレシャのゼパタの谷に戦いの備えをした。"},{"ref":"2Chr.14.11","start":14014011,"end":14014011,"break":"none","ruby":[[0,1,"とき"],[7,1,"かみ"],[9,1,"しゅ"],[11,1,"む"],[15,1,"よ"],[20,1,"い"],[25,1,"しゅ"],[28,1,"ちから"],[32,1,"もの"],[34,1,"たす"],[41,1,"ちから"],[45,1,"もの"],[47,1,"たす"],[62,1,"こと"],[79,1,"かみ"],[81,1,"しゅ"],[90,1,"たす"],[106,1,"よ"],[108,1,"たの"],[115,1,"な"],[122,2,"たいぐん"],[125,1,"あた"],[130,1,"しゅ"],[142,1,"かみ"],[149,1,"ひと"],[155,1,"か"]],"text":"時にアサはその神、主に向かって呼ばわって言った、「主よ、力のある者を助けることも、力のない者を助けることも、あなたにおいては異なることはありません。われわれの神、主よ、われわれをお助けください。われわれはあなたに寄り頼み、あなたの名によってこの大軍に当ります。主よ、あなたはわれわれの神です。どうぞ人をあなたに勝たせないでください」。"},{"ref":"2Chr.14.12","start":14014012,"end":14014012,"break":"none","ruby":[[3,1,"しゅ"],[8,1,"まえ"],[13,1,"まえ"],[23,1,"う"],[25,1,"やぶ"],[40,1,"に"],[42,1,"さ"]],"text":"そこで主はアサの前とユダの前でエチオピヤびとを撃ち敗られたので、エチオピヤびとは逃げ去った。"},{"ref":"2Chr.14.13","start":14014013,"end":14014013,"break":"none","ruby":[[3,1,"かれ"],[5,1,"したが"],[7,1,"たみ"],[9,1,"かれ"],[17,2,"ついげき"],[32,1,"たお"],[36,1,"い"],[38,1,"のこ"],[41,1,"もの"],[52,1,"しゅ"],[54,1,"しゅ"],[56,2,"ぐんぜい"],[59,1,"まえ"],[61,1,"う"],[63,1,"やぶ"],[76,2,"ひとびと"],[79,1,"え"],[85,1,"もの"],[87,2,"ひじょう"],[90,1,"おお"]],"text":"アサと彼に従う民は彼らをゲラルまで追撃したので、エチオピヤびとは倒れて、生き残った者はひとりもなかった。主と主の軍勢の前に撃ち破られたからである。ユダの人々の得たぶんどり物は非常に多かった。"},{"ref":"2Chr.14.14","start":14014014,"end":14014014,"break":"none","ruby":[[0,1,"かれ"],[10,2,"しゅうい"],[13,2,"まちまち"],[21,1,"う"],[23,1,"やぶ"],[27,1,"しゅ"],[29,1,"おそ"],[32,1,"かれ"],[35,1,"うえ"],[37,1,"のぞ"],[49,1,"かれ"],[58,1,"まち"],[63,1,"うば"],[69,1,"うち"],[71,1,"おお"],[74,1,"もの"]],"text":"彼らはまた、ゲラルの周囲の町々をことごとく撃ち破った。主の恐れが彼らの上に臨んだからである。そして彼らはそのすべての町をかすめ奪った。その内に多くの物があったからである。"},{"ref":"2Chr.14.15","start":14014015,"end":14014015,"break":"none","ruby":[[2,2,"かちく"],[10,1,"もの"],[12,2,"てんまく"],[15,1,"おそ"],[18,1,"おお"],[21,1,"ひつじ"],[27,1,"うば"],[29,1,"と"],[39,1,"かえ"]],"text":"また家畜をもっている者の天幕を襲い、多くの羊とらくだを奪い取って、エルサレムに帰った。"}]