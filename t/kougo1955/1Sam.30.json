[{"ref":"1Sam.30.1","start":9030001,"end":9030001,"break":"paragraph","ruby":[[8,2,"じゅうしゃ"],[14,1,"か"],[15,1,"め"],[24,1,"とき"],[45,1,"おそ"],[51,1,"かれ"],[59,1,"う"],[62,1,"ひ"],[71,1,"や"]],"text":"さてダビデとその従者たちが三日目にチクラグにきた時、アマレクびとはすでにネゲブとチクラグを襲っていた。彼らはチクラグを撃ち、火をはなってこれを焼き、"},{"ref":"1Sam.30.2","start":9030002,"end":9030002,"break":"none","ruby":[[2,1,"なか"],[6,1,"おんな"],[16,1,"もの"],[18,2,"ほりょ"],[23,1,"ちい"],[26,1,"もの"],[29,1,"おお"],[32,1,"もの"],[40,1,"ころ"],[45,1,"ひ"],[51,1,"みち"],[53,1,"い"]],"text":"その中にいた女たちおよびすべての者を捕虜にし、小さい者をも大きい者をも、ひとりも殺さずに、引いて、その道に行った。"},{"ref":"1Sam.30.3","start":9030003,"end":9030003,"break":"none","ruby":[[4,2,"じゅうしゃ"],[11,1,"まち"],[16,1,"まち"],[18,1,"ひ"],[20,1,"や"],[26,1,"つま"],[31,1,"むすめ"],[34,2,"ほりょ"],[42,1,"み"]],"text":"ダビデと従者たちはその町にきて、町が火で焼かれ、その妻とむすこ娘らは捕虜となったのを見た。"},{"ref":"1Sam.30.4","start":9030004,"end":9030004,"break":"none","ruby":[[6,1,"かれ"],[8,1,"とも"],[12,1,"たみ"],[14,1,"こえ"],[19,1,"な"],[25,1,"な"],[27,1,"ちから"]],"text":"ダビデおよび彼と共にいた民は声をあげて泣き、ついに泣く力もなくなった。"},{"ref":"1Sam.30.5","start":9030005,"end":9030005,"break":"none","ruby":[[8,1,"つま"],[18,1,"おんな"],[36,1,"つま"],[47,2,"ほりょ"]],"text":"ダビデのふたりの妻すなわちエズレルの女アヒノアムと、カルメルびとナバルの妻であったアビガイルも捕虜になった。"},{"ref":"1Sam.30.6","start":9030006,"end":9030006,"break":"none","ruby":[[2,1,"とき"],[13,1,"なや"],[20,1,"たみ"],[33,1,"むすめ"],[38,1,"こころ"],[40,1,"いた"],[50,1,"いし"],[52,1,"う"],[56,1,"い"],[74,1,"かみ"],[76,1,"しゅ"],[81,2,"じぶん"],[84,1,"ちから"]],"text":"その時、ダビデはひじょうに悩んだ。それは民がみなおのおのそのむすこ娘のために心を痛めたため、ダビデを石で撃とうと言ったからである。しかしダビデはその神、主によって自分を力づけた。"},{"ref":"1Sam.30.7","start":9030007,"end":9030007,"break":"paragraph","ruby":[[10,1,"こ"],[12,2,"さいし"],[34,1,"も"],[43,1,"い"],[68,1,"も"]],"text":"ダビデはアヒメレクの子、祭司アビヤタルに、「エポデをわたしのところに持ってきなさい」と言ったので、アビヤタルは、エポデをダビデのところに持ってきた。"},{"ref":"1Sam.30.8","start":9030008,"end":9030008,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"うかが"],[12,1,"い"],[23,2,"ぐんたい"],[29,1,"お"],[44,1,"お"],[60,1,"しゅ"],[62,1,"かれ"],[64,1,"い"],[70,1,"お"],[80,1,"かなら"],[82,1,"お"],[88,1,"たし"],[91,1,"すく"],[93,1,"だ"]],"text":"ダビデは主に伺いをたてて言った、「わたしはこの軍隊のあとを追うべきですか。わたしはそれに追いつくことができましょうか」。主は彼に言われた、「追いなさい。あなたは必ず追いついて、確かに救い出すことができるであろう」。"},{"ref":"1Sam.30.9","start":9030009,"end":9030009,"break":"none","ruby":[[8,2,"いっしょ"],[15,1,"にん"],[17,1,"もの"],[19,1,"とも"],[21,2,"しゅったつ"],[28,1,"かわ"],[30,1,"い"],[38,1,"のこ"],[40,1,"もの"]],"text":"そこでダビデは、一緒にいた六百人の者と共に出立してベソル川へ行ったが、あとに残る者はそこにとどまった。"},{"ref":"1Sam.30.10","start":9030010,"end":9030010,"break":"none","ruby":[[10,1,"にん"],[12,1,"とも"],[14,2,"ついげき"],[23,1,"つか"],[29,1,"かわ"],[31,1,"わた"],[35,1,"もの"],[38,1,"にん"]],"text":"すなわちダビデは四百人と共に追撃をつづけたが、疲れてベソル川を渡れない者二百人はとどまった。"},{"ref":"1Sam.30.11","start":9030011,"end":9030011,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"の"],[17,1,"み"],[30,1,"ひ"],[39,1,"た"],[44,1,"みず"],[46,1,"の"]],"text":"彼らは野で、ひとりのエジプトびとを見て、それをダビデのもとに引いてきて、パンを食べさせ、水を飲ませた。"},{"ref":"1Sam.30.12","start":9030012,"end":9030012,"break":"none","ruby":[[2,1,"かれ"],[29,1,"かれ"],[31,1,"あた"],[35,1,"かれ"],[37,1,"た"],[40,2,"げんき"],[43,2,"かいふく"],[48,1,"かれ"],[51,1,"か"],[53,1,"よ"],[58,1,"た"],[62,1,"みず"],[64,1,"の"]],"text":"また彼らはほしいちじくのかたまり一つと、ほしぶどう二ふさを彼に与えた。彼は食べて元気を回復した。彼は三日三夜、パンを食べず、水を飲んでいなかったからである。"},{"ref":"1Sam.30.13","start":9030013,"end":9030013,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[32,1,"かれ"],[34,1,"い"],[48,2,"わかもの"],[59,2,"どれい"],[65,1,"か"],[66,1,"まえ"],[72,2,"びょうき"],[81,2,"しゅじん"],[88,1,"す"],[91,1,"い"]],"text":"ダビデは彼に言った、「あなたはだれのものか。どこからきたのか」。彼は言った、「わたしはエジプトの若者で、アマレクびとの奴隷です。三日前にわたしが病気になったので、主人はわたしを捨てて行きました。"},{"ref":"1Sam.30.14","start":9030014,"end":9030014,"break":"none","ruby":[[21,1,"ぞく"],[24,1,"ち"],[35,1,"おそ"],[40,1,"ひ"],[47,1,"や"]],"text":"わたしどもは、ケレテびとのネゲブと、ユダに属する地と、カレブのネゲブを襲い、また火でチクラグを焼きはらいました」。"},{"ref":"1Sam.30.15","start":9030015,"end":9030015,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[17,2,"ぐんたい"],[28,1,"みちび"],[30,1,"くだ"],[39,1,"かれ"],[41,1,"い"],[54,1,"ころ"],[67,2,"しゅじん"],[70,1,"て"],[72,1,"わた"],[80,1,"かみ"],[89,1,"ちか"],[108,2,"ぐんたい"],[115,1,"みちび"],[117,1,"くだ"]],"text":"ダビデは彼に言った、「あなたはその軍隊のところへわたしを導き下ってくれるか」。彼は言った、「あなたはわたしを殺さないこと、またわたしを主人の手に渡さないことを、神をさしてわたしに誓ってください。そうすればあなたをその軍隊のところへ導き下りましょう」。"},{"ref":"1Sam.30.16","start":9030016,"end":9030016,"break":"paragraph","ruby":[[0,1,"かれ"],[6,1,"みちび"],[8,1,"くだ"],[13,1,"み"],[16,1,"かれ"],[26,1,"ち"],[31,1,"ち"],[34,1,"うば"],[36,1,"と"],[44,1,"おお"],[51,1,"もの"],[57,1,"く"],[59,1,"の"],[64,1,"おど"],[70,1,"ち"],[80,1,"ち"]],"text":"彼はダビデを導き下ったが、見よ、彼らはペリシテびとの地とユダの地から奪い取ったさまざまの多くのぶんどり物のゆえに、食い飲み、かつ踊りながら、地のおもてにあまねく散りひろがっていた。"},{"ref":"1Sam.30.17","start":9030017,"end":9030017,"break":"none","ruby":[[4,1,"ゆう"],[9,2,"よくじつ"],[12,2,"ゆうがた"],[17,1,"かれ"],[20,1,"う"],[30,1,"の"],[33,1,"に"],[38,1,"にん"],[40,2,"わかもの"],[58,1,"もの"]],"text":"ダビデは夕ぐれから翌日の夕方まで、彼らを撃ったので、らくだに乗って逃げた四百人の若者たちのほかには、ひとりものがれた者はなかった。"},{"ref":"1Sam.30.18","start":9030018,"end":9030018,"break":"none","ruby":[[15,1,"うば"],[17,1,"と"],[25,1,"と"],[44,1,"つま"],[46,1,"すく"],[48,1,"だ"]],"text":"こうしてダビデはアマレクびとが奪い取ったものをみな取りもどした。またダビデはそのふたりの妻を救い出した。"},{"ref":"1Sam.30.19","start":9030019,"end":9030019,"break":"none","ruby":[[3,1,"かれ"],[6,1,"ぞく"],[13,1,"ちい"],[19,1,"おお"],[30,1,"むすめ"],[36,1,"もの"],[46,1,"うば"],[48,1,"さ"],[51,1,"もの"],[53,1,"なに"],[56,1,"うしな"],[68,1,"と"]],"text":"そして彼らに属するものは、小さいものも大きいものも、むすこも娘もぶんどり物も、アマレクびとが奪い去った物は何をも失わないで、ダビデがみな取りもどした。"},{"ref":"1Sam.30.20","start":9030020,"end":9030020,"break":"none","ruby":[[10,1,"ひつじ"],[12,1,"うし"],[14,1,"と"],[18,2,"ひとびと"],[25,2,"かちく"],[28,1,"かれ"],[30,1,"まえ"],[32,1,"お"],[35,1,"い"],[53,1,"もの"],[57,1,"い"]],"text":"ダビデはまたすべての羊と牛を取った。人々はこれらの家畜を彼の前に追って行きながら、「これはダビデのぶんどり物だ」と言った。"},{"ref":"1Sam.30.21","start":9030021,"end":9030021,"break":"paragraph","ruby":[[10,1,"つか"],[20,1,"い"],[33,1,"かわ"],[48,1,"にん"],[50,1,"もの"],[58,1,"とき"],[60,1,"かれ"],[63,1,"で"],[71,1,"むか"],[80,1,"とも"],[84,1,"たみ"],[86,1,"むか"],[94,1,"たみ"],[96,1,"ちか"],[102,2,"あんぴ"],[105,1,"と"]],"text":"そしてダビデが、あの疲れてダビデについて行くことができずに、ベソル川のほとりにとどまっていた二百人の者のところへきた時、彼らは出てきてダビデを迎え、またダビデと共にいる民を迎えた。ダビデは民に近づいてその安否を問うた。"},{"ref":"1Sam.30.22","start":9030022,"end":9030022,"break":"none","ruby":[[8,1,"とも"],[10,1,"い"],[13,2,"ひとびと"],[20,1,"わる"],[30,1,"もの"],[36,1,"い"],[41,1,"かれ"],[49,1,"とも"],[51,1,"い"],[69,2,"ひとびと"],[77,1,"と"],[87,1,"もの"],[89,1,"わ"],[91,1,"あた"],[111,2,"さいし"],[114,1,"あた"],[118,1,"つ"],[121,1,"い"]],"text":"そのときダビデと共に行った人々のうちで、悪く、かつよこしまな者どもはみな言った、「彼らはわれわれと共に行かなかったのだから、われわれはその人々にわれわれの取りもどしたぶんどり物を分け与えることはできない。ただおのおのにその妻子を与えて、連れて行かせましょう」。"},{"ref":"1Sam.30.23","start":9030023,"end":9030023,"break":"none","ruby":[[7,1,"い"],[12,2,"きょうだい"],[18,1,"しゅ"],[25,1,"まも"],[29,1,"せ"],[34,2,"ぐんたい"],[42,1,"て"],[44,1,"わた"],[51,1,"しゅ"],[53,1,"たま"]],"text":"しかしダビデは言った、「兄弟たちよ、主はわれわれを守って、攻めてきた軍隊をわれわれの手に渡された。その主が賜わったものを、あなたがたはそのようにしてはならない。"},{"ref":"1Sam.30.24","start":9030024,"end":9030024,"break":"none","ruby":[[5,1,"こと"],[17,1,"き"],[19,1,"したが"],[25,1,"たたか"],[28,1,"くだ"],[31,1,"い"],[34,1,"もの"],[36,1,"わ"],[38,1,"まえ"],[41,2,"にもつ"],[56,1,"もの"],[58,1,"わ"],[60,1,"まえ"],[62,2,"どうよう"],[75,1,"かれ"],[82,1,"わ"],[84,1,"まえ"],[86,1,"う"]],"text":"だれがこの事について、あなたがたに聞き従いますか。戦いに下って行った者の分け前と、荷物のかたわらにとどまっていた者の分け前を同様にしなければならない。彼らはひとしく分け前を受けるべきである」。"},{"ref":"1Sam.30.25","start":9030025,"end":9030025,"break":"none","ruby":[[2,1,"ひ"],[3,2,"いらい"],[19,1,"さだ"],[30,2,"こんにち"],[33,1,"およ"]],"text":"この日以来、ダビデはこれをイスラエルの定めとし、おきてとして今日に及んでいる。"},{"ref":"1Sam.30.26","start":9030026,"end":9030026,"break":"paragraph","ruby":[[18,1,"もの"],[20,2,"いちぶ"],[26,2,"ちょうろう"],[31,2,"ゆうじん"],[40,1,"い"],[48,1,"しゅ"],[50,1,"てき"],[53,1,"と"],[60,1,"もの"],[75,1,"おく"],[77,1,"もの"]],"text":"ダビデはチクラグにきて、そのぶんどり物の一部をユダの長老である友人たちにおくって言った、「これは主の敵から取ったぶんどり物のうちからあなたがたにおくる贈り物である」。"},{"ref":"1Sam.30.27","start":9030027,"end":9030027,"break":"none","ruby":[[5,1,"さき"],[14,2,"ひとびと"],[27,2,"ひとびと"],[37,2,"ひとびと"]],"text":"そのおくり先は、ベテルにいる人々、ネゲブのラモテにいる人々、ヤッテルにいる人々、"},{"ref":"1Sam.30.28","start":9030028,"end":9030028,"break":"none","ruby":[[7,2,"ひとびと"],[17,2,"ひとびと"],[28,2,"ひとびと"],[37,2,"ひとびと"]],"text":"アロエルにいる人々、シフモテにいる人々、エシテモアにいる人々、ラカルにいる人々、"},{"ref":"1Sam.30.29","start":9030029,"end":9030029,"break":"none","ruby":[[7,2,"まちまち"],[12,2,"ひとびと"],[20,2,"まちまち"],[25,2,"ひとびと"]],"text":"エラメルびとの町々にいる人々、ケニびとの町々にいる人々、"},{"ref":"1Sam.30.30","start":9030030,"end":9030030,"break":"none","ruby":[[6,2,"ひとびと"],[17,2,"ひとびと"],[26,2,"ひとびと"]],"text":"ホルマにいる人々、ボラシャンにいる人々、アタクにいる人々、"},{"ref":"1Sam.30.31","start":9030031,"end":9030031,"break":"none","ruby":[[7,2,"ひとびと"],[19,2,"じゅうしゃ"],[29,1,"ある"],[36,1,"ところ"],[40,2,"ひとびと"]],"text":"ヘブロンにいる人々、およびダビデとその従者たちが、さまよい歩いたすべての所にいる人々であった。"}]