[{"ref":"Luke.19.1","start":42019001,"end":42019001,"break":"paragraph","ruby":[[18,1,"まち"],[21,1,"とお"]],"text":"さて、イエスはエリコにはいって、その町をお通りになった。"},{"ref":"Luke.19.2","start":42019002,"end":42019002,"break":"none","ruby":[[15,1,"な"],[17,1,"ひと"],[24,1,"ひと"],[26,3,"しゅぜいにん"],[35,2,"かねもち"]],"text":"ところが、そこにザアカイという名の人がいた。この人は取税人のかしらで、金持であった。"},{"ref":"Luke.19.3","start":42019003,"end":42019003,"break":"none","ruby":[[0,1,"かれ"],[10,1,"ひと"],[12,1,"み"],[16,1,"おも"],[23,1,"せ"],[25,1,"ひく"],[32,2,"ぐんしゅう"],[41,1,"み"]],"text":"彼は、イエスがどんな人か見たいと思っていたが、背が低かったので、群衆にさえぎられて見ることができなかった。"},{"ref":"Luke.19.4","start":42019004,"end":42019004,"break":"none","ruby":[[7,1,"み"],[13,1,"まえ"],[15,1,"ほう"],[17,1,"はし"],[20,1,"い"],[28,1,"くわ"],[30,1,"き"],[32,1,"のぼ"],[39,1,"とお"]],"text":"それでイエスを見るために、前の方に走って行って、いちじく桑の木に登った。そこを通られるところだったからである。"},{"ref":"Luke.19.5","start":42019005,"end":42019005,"break":"none","ruby":[[7,2,"ばしょ"],[17,1,"うえ"],[19,1,"み"],[23,1,"い"],[35,1,"いそ"],[38,1,"くだ"],[54,1,"いえ"],[56,1,"と"]],"text":"イエスは、その場所にこられたとき、上を見あげて言われた、「ザアカイよ、急いで下りてきなさい。きょう、あなたの家に泊まることにしているから」。"},{"ref":"Luke.19.6","start":42019006,"end":42019006,"break":"none","ruby":[[8,1,"いそ"],[26,1,"むか"],[28,1,"い"]],"text":"そこでザアカイは急いでおりてきて、よろこんでイエスを迎え入れた。"},{"ref":"Luke.19.7","start":42019007,"end":42019007,"break":"none","ruby":[[0,2,"ひとびと"],[9,1,"み"],[17,1,"かれ"],[19,2,"つみびと"],[22,1,"いえ"],[28,1,"きゃく"],[35,1,"い"]],"text":"人々はみな、これを見てつぶやき、「彼は罪人の家にはいって客となった」と言った。"},{"ref":"Luke.19.8","start":42019008,"end":42019008,"break":"none","ruby":[[5,1,"た"],[8,1,"しゅ"],[10,1,"い"],[15,1,"しゅ"],[22,1,"ちか"],[25,2,"じぶん"],[28,2,"ざいさん"],[31,2,"はんぶん"],[34,2,"ひんみん"],[37,1,"ほどこ"],[52,2,"ふせい"],[55,2,"とりた"],[71,1,"ばい"],[75,1,"かえ"]],"text":"ザアカイは立って主に言った、「主よ、わたしは誓って自分の財産の半分を貧民に施します。また、もしだれかから不正な取立てをしていましたら、それを四倍にして返します」。"},{"ref":"Luke.19.9","start":42019009,"end":42019009,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[16,1,"すくい"],[20,1,"いえ"],[27,1,"ひと"],[35,1,"こ"]],"text":"イエスは彼に言われた、「きょう、救がこの家にきた。この人もアブラハムの子なのだから。"},{"ref":"Luke.19.10","start":42019010,"end":42019010,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[9,1,"うしな"],[16,1,"たず"],[18,1,"だ"],[21,1,"すく"]],"text":"人の子がきたのは、失われたものを尋ね出して救うためである」。"},{"ref":"Luke.19.11","start":42019011,"end":42019011,"break":"paragraph","ruby":[[0,2,"ひとびと"],[7,2,"ことば"],[10,1,"き"],[28,1,"たとえ"],[31,1,"はな"],[47,1,"ちか"],[59,2,"ひとびと"],[62,1,"かみ"],[64,1,"くに"],[70,1,"あらわ"],[74,1,"おも"]],"text":"人々がこれらの言葉を聞いているときに、イエスはなお一つの譬をお話しになった。それはエルサレムに近づいてこられたし、また人々が神の国はたちまち現れると思っていたためである。"},{"ref":"Luke.19.12","start":42019012,"end":42019012,"break":"none","ruby":[[3,1,"い"],[11,2,"みぶん"],[14,1,"たか"],[16,1,"ひと"],[19,2,"おうい"],[22,1,"う"],[25,1,"かえ"],[33,1,"とお"],[35,1,"ところ"],[37,2,"たびだ"]],"text":"それで言われた、「ある身分の高い人が、王位を受けて帰ってくるために遠い所へ旅立つことになった。"},{"ref":"Luke.19.13","start":42019013,"end":42019013,"break":"none","ruby":[[4,1,"にん"],[6,1,"しもべ"],[8,1,"よ"],[14,1,"わた"],[17,1,"い"],[26,1,"かえ"],[29,1,"く"],[37,2,"しょうばい"]],"text":"そこで十人の僕を呼び十ミナを渡して言った、『わたしが帰って来るまで、これで商売をしなさい』。"},{"ref":"Luke.19.14","start":42019014,"end":42019014,"break":"none","ruby":[[5,2,"ほんごく"],[8,2,"じゅうみん"],[11,1,"かれ"],[13,1,"にく"],[25,2,"ししゃ"],[36,1,"ひと"],[38,1,"おう"],[49,1,"のぞ"],[57,1,"い"]],"text":"ところが、本国の住民は彼を憎んでいたので、あとから使者をおくって、『この人が王になるのをわれわれは望んでいない』と言わせた。"},{"ref":"Luke.19.15","start":42019015,"end":42019015,"break":"none","ruby":[[3,1,"かれ"],[5,2,"おうい"],[8,1,"う"],[11,1,"かえ"],[33,1,"し"],[40,1,"かね"],[42,1,"わた"],[48,1,"しもべ"],[52,1,"よ"]],"text":"さて、彼が王位を受けて帰ってきたとき、だれがどんなもうけをしたかを知ろうとして、金を渡しておいた僕たちを呼んでこさせた。"},{"ref":"Luke.19.16","start":42019016,"end":42019016,"break":"none","ruby":[[0,2,"さいしょ"],[3,1,"もの"],[5,1,"すす"],[7,1,"で"],[9,1,"い"],[15,3,"しゅじんさま"]],"text":"最初の者が進み出て言った、『ご主人様、あなたの一ミナで十ミナをもうけました』。"},{"ref":"Luke.19.17","start":42019017,"end":42019017,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"い"],[10,1,"しもべ"],[24,1,"ちい"],[27,1,"こと"],[29,2,"ちゅうじつ"],[40,1,"まち"],[42,2,"しはい"]],"text":"主人は言った、『よい僕よ、うまくやった。あなたは小さい事に忠実であったから、十の町を支配させる』。"},{"ref":"Luke.19.18","start":42019018,"end":42019018,"break":"none","ruby":[[0,1,"つぎ"],[2,1,"もの"],[6,1,"い"],[12,3,"しゅじんさま"]],"text":"次の者がきて言った、『ご主人様、あなたの一ミナで五ミナをつくりました』。"},{"ref":"Luke.19.19","start":42019019,"end":42019019,"break":"none","ruby":[[5,1,"もの"],[20,1,"まち"],[30,1,"い"]],"text":"そこでこの者にも、『では、あなたは五つの町のかしらになれ』と言った。"},{"ref":"Luke.19.20","start":42019020,"end":42019020,"break":"none","ruby":[[11,1,"もの"],[15,1,"い"],[21,3,"しゅじんさま"],[55,1,"つつ"]],"text":"それから、もうひとりの者がきて言った、『ご主人様、さあ、ここにあなたの一ミナがあります。わたしはそれをふくさに包んで、しまっておきました。"},{"ref":"Luke.19.21","start":42019021,"end":42019021,"break":"none","ruby":[[8,1,"ほう"],[25,1,"と"],[43,1,"か"],[45,1,"ひと"]],"text":"あなたはきびしい方で、おあずけにならなかったものを取りたて、おまきにならなかったものを刈る人なので、おそろしかったのです』。"},{"ref":"Luke.19.22","start":42019022,"end":42019022,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,1,"わる"],[9,1,"しもべ"],[20,1,"い"],[25,2,"ことば"],[57,1,"と"],[71,1,"か"],[73,2,"にんげん"],[78,1,"し"]],"text":"彼に言った、『悪い僕よ、わたしはあなたの言ったその言葉であなたをさばこう。わたしがきびしくて、あずけなかったものを取りたて、まかなかったものを刈る人間だと、知っているのか。"},{"ref":"Luke.19.23","start":42019023,"end":42019023,"break":"none","ruby":[[9,1,"かね"],[11,2,"ぎんこう"],[14,1,"い"],[33,1,"かえ"],[43,1,"かね"],[45,2,"りし"],[48,2,"いっしょ"],[51,1,"ひ"],[53,1,"だ"]],"text":"では、なぜわたしの金を銀行に入れなかったのか。そうすれば、わたしが帰ってきたとき、その金を利子と一緒に引き出したであろうに』。"},{"ref":"Luke.19.24","start":42019024,"end":42019024,"break":"none","ruby":[[7,1,"た"],[12,2,"ひとびと"],[23,1,"かれ"],[26,1,"と"],[28,1,"あ"],[36,1,"も"],[41,1,"もの"],[43,1,"あた"],[50,1,"い"]],"text":"そして、そばに立っていた人々に、『その一ミナを彼から取り上げて、十ミナを持っている者に与えなさい』と言った。"},{"ref":"Luke.19.25","start":42019025,"end":42019025,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[9,3,"しゅじんさま"],[15,1,"ひと"],[17,1,"すで"],[23,1,"も"]],"text":"彼らは言った、『ご主人様、あの人は既に十ミナを持っています』。"},{"ref":"Luke.19.26","start":42019026,"end":42019026,"break":"none","ruby":[[7,1,"い"],[15,1,"も"],[20,1,"ひと"],[26,1,"あた"],[31,1,"も"],[37,1,"ひと"],[42,1,"も"],[52,1,"と"],[54,1,"あ"]],"text":"『あなたがたに言うが、おおよそ持っている人には、なお与えられ、持っていない人からは、持っているものまでも取り上げられるであろう。"},{"ref":"Luke.19.27","start":42019027,"end":42019027,"break":"none","ruby":[[7,1,"おう"],[14,1,"この"],[22,1,"てき"],[42,1,"まえ"],[44,1,"う"],[46,1,"ころ"]],"text":"しかしわたしが王になることを好まなかったあの敵どもを、ここにひっぱってきて、わたしの前で打ち殺せ』」。"},{"ref":"Luke.19.28","start":42019028,"end":42019028,"break":"paragraph","ruby":[[11,1,"い"],[17,2,"せんとう"],[20,1,"た"],[29,1,"のぼ"],[32,1,"い"]],"text":"イエスはこれらのことを言ったのち、先頭に立ち、エルサレムへ上って行かれた。"},{"ref":"Luke.19.29","start":42019029,"end":42019029,"break":"none","ruby":[[9,1,"やま"],[11,1,"そ"],[24,1,"ちか"],[36,2,"でし"],[44,1,"い"]],"text":"そしてオリブという山に沿ったベテパゲとベタニヤに近づかれたとき、ふたりの弟子をつかわして言われた、"},{"ref":"Luke.19.30","start":42019030,"end":42019030,"break":"none","ruby":[[1,1,"む"],[5,1,"むら"],[7,1,"い"],[27,1,"の"],[38,1,"こ"],[48,1,"み"],[58,1,"と"],[62,1,"ひ"]],"text":"「向こうの村へ行きなさい。そこにはいったら、まだだれも乗ったことのないろばの子がつないであるのを見るであろう。それを解いて、引いてきなさい。"},{"ref":"Luke.19.31","start":42019031,"end":42019031,"break":"none","ruby":[[9,1,"と"],[15,1,"と"],[21,1,"しゅ"],[24,1,"い"],[26,1,"よう"],[36,1,"い"]],"text":"もしだれかが『なぜ解くのか』と問うたら、『主がお入り用なのです』と、そう言いなさい」。"},{"ref":"Luke.19.32","start":42019032,"end":42019032,"break":"none","ruby":[[10,1,"もの"],[14,1,"い"],[17,1,"み"],[21,1,"はた"],[25,1,"い"]],"text":"そこで、つかわされた者たちが行って見ると、果して、言われたとおりであった。"},{"ref":"Luke.19.33","start":42019033,"end":42019033,"break":"none","ruby":[[0,1,"かれ"],[9,1,"こ"],[11,1,"と"],[20,1,"も"],[22,1,"ぬし"],[33,1,"こ"],[35,1,"と"],[41,1,"い"]],"text":"彼らが、そのろばの子を解いていると、その持ち主たちが、「なぜろばの子を解くのか」と言ったので、"},{"ref":"Luke.19.34","start":42019034,"end":42019034,"break":"none","ruby":[[1,1,"しゅ"],[4,1,"い"],[6,1,"よう"],[13,1,"こた"]],"text":"「主がお入り用なのです」と答えた。"},{"ref":"Luke.19.35","start":42019035,"end":42019035,"break":"none","ruby":[[14,1,"ひ"],[22,1,"こ"],[26,1,"うえ"],[28,2,"じぶん"],[33,2,"うわぎ"],[44,1,"の"]],"text":"そしてそれをイエスのところに引いてきて、その子ろばの上に自分たちの上着をかけてイエスをお乗せした。"},{"ref":"Luke.19.36","start":42019036,"end":42019036,"break":"none","ruby":[[3,1,"すす"],[6,1,"い"],[12,2,"ひとびと"],[15,2,"じぶん"],[20,2,"うわぎ"],[23,1,"みち"],[25,1,"し"]],"text":"そして進んで行かれると、人々は自分たちの上着を道に敷いた。"},{"ref":"Luke.19.37","start":42019037,"end":42019037,"break":"none","ruby":[[7,1,"やま"],[9,1,"くだ"],[11,1,"みち"],[16,1,"ちか"],[23,1,"おお"],[27,2,"でし"],[34,1,"よろこ"],[38,1,"かれ"],[41,1,"み"],[47,1,"ちから"],[58,1,"こえ"],[59,1,"たか"],[63,1,"かみ"],[70,1,"い"]],"text":"いよいよオリブ山の下り道あたりに近づかれると、大ぜいの弟子たちはみな喜んで、彼らが見たすべての力あるみわざについて、声高らかに神をさんびして言いはじめた、"},{"ref":"Luke.19.38","start":42019038,"end":42019038,"break":"stanza","breaks":[[15,"line"],[20,"line"],[26,"line"]],"ruby":[[1,1,"しゅ"],[3,2,"みな"],[12,1,"おう"],[15,2,"しゅくふく"],[20,1,"てん"],[23,2,"へいわ"],[28,1,"たか"],[35,2,"えいこう"]],"text":"「主の御名によってきたる王に、祝福あれ。天には平和、いと高きところには栄光あれ」。"},{"ref":"Luke.19.39","start":42019039,"end":42019039,"break":"none","ruby":[[5,2,"ぐんしゅう"],[8,1,"なか"],[18,1,"びと"],[26,1,"い"],[31,2,"せんせい"],[38,2,"でし"],[47,1,"くだ"]],"text":"ところが、群衆の中にいたあるパリサイ人たちがイエスに言った、「先生、あなたの弟子たちをおしかり下さい」。"},{"ref":"Luke.19.40","start":42019040,"end":42019040,"break":"none","ruby":[[0,1,"こた"],[3,1,"い"],[15,1,"い"],[23,1,"ひと"],[27,1,"だま"],[31,1,"いし"],[33,1,"さけ"]],"text":"答えて言われた、「あなたがたに言うが、もしこの人たちが黙れば、石が叫ぶであろう」。"},{"ref":"Luke.19.41","start":42019041,"end":42019041,"break":"paragraph","ruby":[[4,1,"みやこ"],[6,1,"ちか"],[15,1,"み"],[26,1,"な"],[29,1,"い"]],"text":"いよいよ都の近くにきて、それが見えたとき、そのために泣いて言われた、"},{"ref":"Luke.19.42","start":42019042,"end":42019042,"break":"none","ruby":[[10,1,"ひ"],[13,2,"へいわ"],[20,1,"みち"],[22,1,"し"],[39,1,"いま"],[44,1,"め"],[46,1,"かく"]],"text":"「もしおまえも、この日に、平和をもたらす道を知ってさえいたら……しかし、それは今おまえの目に隠されている。"},{"ref":"Luke.19.43","start":42019043,"end":42019043,"break":"none","ruby":[[5,1,"てき"],[7,2,"しゅうい"],[10,1,"るい"],[12,1,"きず"],[19,1,"と"],[26,2,"しほう"],[30,1,"お"],[32,1,"せま"]],"text":"いつかは、敵が周囲に塁を築き、おまえを取りかこんで、四方から押し迫り、"},{"ref":"Luke.19.44","start":42019044,"end":42019044,"break":"none","ruby":[[6,1,"うち"],[10,1,"こ"],[14,1,"ち"],[16,1,"う"],[18,1,"たお"],[21,2,"じょうない"],[27,1,"いし"],[29,1,"た"],[31,1,"いし"],[33,1,"うえ"],[35,1,"のこ"],[38,1,"お"],[42,1,"ひ"],[44,1,"く"],[59,1,"かみ"],[66,1,"とき"],[68,1,"し"]],"text":"おまえとその内にいる子らとを地に打ち倒し、城内の一つの石も他の石の上に残して置かない日が来るであろう。それは、おまえが神のおとずれの時を知らないでいたからである」。"},{"ref":"Luke.19.45","start":42019045,"end":42019045,"break":"none","ruby":[[4,1,"みや"],[10,3,"しょうばいにん"],[16,1,"お"],[18,1,"だ"]],"text":"それから宮にはいり、商売人たちを追い出しはじめて、"},{"ref":"Luke.19.46","start":42019046,"end":42019046,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[12,1,"や"],[14,1,"いのり"],[16,1,"いえ"],[25,1,"か"],[42,2,"とうぞく"],[45,1,"す"]],"text":"彼らに言われた、「『わが家は祈の家であるべきだ』と書いてあるのに、あなたがたはそれを盗賊の巣にしてしまった」。"},{"ref":"Luke.19.47","start":42019047,"end":42019047,"break":"paragraph","ruby":[[4,2,"まいにち"],[7,1,"みや"],[9,1,"おし"],[17,3,"さいしちょう"],[21,2,"りっぽう"],[23,2,"がくしゃ"],[27,2,"みんしゅう"],[30,2,"おもだ"],[34,1,"もの"],[42,1,"ころ"],[46,1,"おも"]],"text":"イエスは毎日、宮で教えておられた。祭司長、律法学者また民衆の重立った者たちはイエスを殺そうと思っていたが、"},{"ref":"Luke.19.48","start":42019048,"end":42019048,"break":"none","ruby":[[0,2,"みんしゅう"],[5,2,"ねっしん"],[12,1,"みみ"],[14,1,"かたむ"],[22,1,"て"]],"text":"民衆がみな熱心にイエスに耳を傾けていたので、手のくだしようがなかった。"}]