[{"ref":"Jer.43.1","start":24043001,"end":24043001,"break":"paragraph","ruby":[[9,1,"たみ"],[16,1,"かれ"],[19,1,"かみ"],[21,1,"しゅ"],[23,2,"ことば"],[31,1,"かた"],[34,1,"かれ"],[37,1,"かみ"],[39,1,"しゅ"],[41,2,"じぶん"],[49,1,"い"],[57,2,"ことば"],[62,1,"つ"],[64,1,"おわ"],[67,1,"とき"]],"text":"エレミヤがすべての民にむかって、彼らの神、主の言葉をことごとく語り、彼らの神、主が自分をつかわして言わせられるその言葉をみな告げ終った時、"},{"ref":"Jer.43.2","start":24043002,"end":24043002,"break":"none","ruby":[[5,1,"こ"],[16,1,"こ"],[24,2,"こうまん"],[27,2,"ひとびと"],[37,1,"い"],[46,1,"いつわ"],[49,1,"い"],[60,1,"かみ"],[62,1,"しゅ"],[71,1,"い"],[77,1,"す"],[82,1,"い"]],"text":"ホシャヤの子アザリヤと、カレヤの子ヨハナンおよび高慢な人々はみなエレミヤに言った、「あなたは偽りを言っている。われわれの神、主が、『エジプトへ行ってそこに住むな』と言わせるためにあなたをつかわされたのではない。"},{"ref":"Jer.43.3","start":24043003,"end":24043003,"break":"none","ruby":[[4,1,"こ"],[25,1,"さか"],[42,1,"て"],[44,1,"わた"],[47,1,"ころ"],[60,1,"とら"],[62,1,"うつ"]],"text":"ネリヤの子バルクがあなたをそそのかして、われわれに逆らわせ、われわれをカルデヤびとの手に渡して殺すか、あるいはバビロンに捕え移させるのだ」。"},{"ref":"Jer.43.4","start":24043004,"end":24043004,"break":"none","ruby":[[8,1,"こ"],[14,2,"ぐんぜい"],[17,1,"ちょう"],[23,1,"たみ"],[26,1,"みな"],[28,1,"しゅ"],[30,1,"こえ"],[41,1,"ち"]],"text":"こうしてカレヤの子ヨハナンと軍勢の長たちおよび民らは皆、主の声にしたがわず、ユダの地にとどまろうとしなかった。"},{"ref":"Jer.43.5","start":24043005,"end":24043005,"break":"none","ruby":[[7,1,"こ"],[13,2,"ぐんぜい"],[16,1,"ちょう"],[24,1,"のこ"],[29,1,"もの"],[34,1,"お"],[40,2,"くにぐに"],[47,1,"ち"],[49,1,"す"],[54,1,"かえ"],[59,1,"もの"]],"text":"そしてカレヤの子ヨハナンと軍勢の長たちは、ユダに残っている者すなわち追いやられた国々からユダの地に住むために帰ってきた者、――"},{"ref":"Jer.43.6","start":24043006,"end":24043006,"break":"none","ruby":[[0,1,"おとこ"],[2,1,"おんな"],[4,2,"こども"],[7,1,"おう"],[9,1,"むすめ"],[19,2,"じえい"],[22,1,"ちょう"],[35,1,"こ"],[44,1,"こ"],[50,1,"わた"],[56,1,"もの"],[62,3,"よげんしゃ"],[74,1,"こ"]],"text":"男、女、子供、王の娘たち、およびすべて侍衛の長ネブザラダンがシャパンの子であるアヒカムの子ゲダリヤに渡しておいた者、ならびに預言者エレミヤとネリヤの子バルクをつれて、"},{"ref":"Jer.43.7","start":24043007,"end":24043007,"break":"none","ruby":[[5,1,"ち"],[7,1,"い"],[11,1,"かれ"],[14,1,"しゅ"],[16,1,"こえ"],[34,1,"かれ"],[45,1,"い"]],"text":"エジプトの地へ行った。彼らは主の声にしたがわなかったのである。そして彼らはついにタパネスに行った。"},{"ref":"Jer.43.8","start":24043008,"end":24043008,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[15,1,"のぞ"]],"text":"主の言葉はタパネスでエレミヤに臨んだ、"},{"ref":"Jer.43.9","start":24043009,"end":24043009,"break":"none","ruby":[[1,1,"おお"],[4,1,"いし"],[6,1,"て"],[8,1,"と"],[14,2,"ひとびと"],[17,1,"め"],[19,1,"まえ"],[35,2,"きゅうでん"],[38,2,"いりぐち"],[41,2,"しきいし"],[49,1,"なか"],[51,1,"かく"]],"text":"「大きな石を手に取り、ユダの人々の目の前で、これをタパネスにあるパロの宮殿の入口の敷石のしっくいの中に隠して、"},{"ref":"Jer.43.10","start":24043010,"end":24043010,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[10,2,"ばんぐん"],[13,1,"しゅ"],[21,1,"かみ"],[25,1,"い"],[30,1,"み"],[37,2,"ししゃ"],[61,1,"おう"],[70,1,"まね"],[73,1,"かれ"],[77,1,"くらい"],[81,1,"かく"],[84,1,"いし"],[86,1,"うえ"],[93,1,"うえ"],[95,1,"おう"],[97,2,"てんがい"],[100,1,"は"]],"text":"彼らに言いなさい、『万軍の主、イスラエルの神はこう言われる、見よ、わたしは使者をつかわして、わたしのしもべであるバビロンの王ネブカデレザルを招く。彼はその位をこの隠した石の上にすえ、その上に王の天蓋を張る。"},{"ref":"Jer.43.11","start":24043011,"end":24043011,"break":"none","ruby":[[0,1,"かれ"],[2,1,"き"],[9,1,"ち"],[11,1,"う"],[14,2,"えきびょう"],[17,1,"さだ"],[23,1,"もの"],[25,2,"えきびょう"],[28,1,"わた"],[35,1,"さだ"],[41,1,"もの"],[53,1,"さだ"],[59,1,"もの"]],"text":"彼は来てエジプトの地を撃ち、疫病に定まっている者を疫病に渡し、とりこに定まっている者をとりこにし、つるぎに定まっている者をつるぎにかける。"},{"ref":"Jer.43.12","start":24043012,"end":24043012,"break":"none","ruby":[[0,1,"かれ"],[7,2,"かみがみ"],[10,1,"みや"],[12,1,"ひ"],[20,1,"や"],[23,1,"かれ"],[36,1,"ひつじ"],[38,1,"か"],[40,1,"もの"],[42,2,"きもの"],[45,1,"むし"],[63,1,"ち"],[70,1,"かれ"],[72,1,"やす"],[79,1,"さ"]],"text":"彼はエジプトの神々の宮に火をつけてこれを焼き、彼らをとりこにする。そして羊を飼う者が着物の虫をはらいきよめるように、エジプトの地をきよめる。彼は安らかにそこを去る。"},{"ref":"Jer.43.13","start":24043013,"end":24043013,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ち"],[33,2,"かみがみ"],[36,1,"みや"],[38,1,"ひ"],[40,1,"や"]],"text":"彼はエジプトの地にあるヘリオポリスのオベリスクをこわし、エジプトの神々の宮を火で焼く』」。"}]