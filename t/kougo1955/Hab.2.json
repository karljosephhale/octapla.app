[{"ref":"Hab.2.1","start":35002001,"end":35002001,"break":"paragraph","breaks":[[15,"line"],[26,"line"],[48,"line"],[60,"line"]],"ruby":[[8,2,"みはり"],[10,1,"じょ"],[12,1,"た"],[15,2,"ものみ"],[21,1,"み"],[23,1,"お"],[26,1,"のぞ"],[28,1,"み"],[31,1,"かれ"],[40,1,"かた"],[46,1,"み"],[54,1,"うった"],[63,1,"みずか"],[68,1,"こた"],[78,1,"み"]],"text":"わたしはわたしの見張所に立ち、物見やぐらに身を置き、望み見て、彼がわたしになんと語られるかを見、またわたしの訴えについてわたし自らなんと答えたらよかろうかを見よう。"},{"ref":"Hab.2.2","start":35002002,"end":35002002,"break":"line","breaks":[[14,"line"],[22,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"こた"],[9,1,"い"],[17,1,"まぼろし"],[19,1,"か"],[25,1,"いた"],[27,1,"うえ"],[29,1,"あき"],[37,1,"はし"],[47,1,"よ"]],"text":"主はわたしに答えて言われた、「この幻を書き、これを板の上に明らかにしるし、走りながらも、これを読みうるようにせよ。"},{"ref":"Hab.2.3","start":35002003,"end":35002003,"break":"line","breaks":[[17,"line"],[39,"line"],[52,"line"]],"ruby":[[2,1,"まぼろし"],[6,1,"さだ"],[14,1,"ま"],[17,1,"おわ"],[23,1,"いそ"],[32,1,"いつわ"],[46,1,"ま"],[55,1,"かなら"],[57,1,"のぞ"],[60,1,"とどこお"]],"text":"この幻はなお定められたときを待ち、終りをさして急いでいる。それは偽りではない。もしおそければ待っておれ。それは必ず臨む。滞りはしない。"},{"ref":"Hab.2.4","start":35002004,"end":35002004,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"み"],[5,1,"たましい"],[7,1,"ただ"],[12,1,"もの"],[14,1,"おとろ"],[21,2,"ぎじん"],[26,2,"しんこう"],[32,1,"い"]],"text":"見よ、その魂の正しくない者は衰える。しかし義人はその信仰によって生きる。"},{"ref":"Hab.2.5","start":35002005,"end":35002005,"break":"line","breaks":[[11,"line"],[23,"line"],[36,"line"],[54,"line"],[64,"line"]],"ruby":[[3,1,"さけ"],[5,1,"あざむ"],[11,1,"たか"],[14,1,"もの"],[16,1,"さだ"],[23,1,"かれ"],[25,1,"よく"],[27,2,"よみ"],[33,1,"ひろ"],[36,1,"かれ"],[38,1,"し"],[47,1,"あ"],[54,2,"ばんこく"],[61,1,"あつ"],[64,2,"ばんみん"]],"text":"また、酒は欺くものだ。高ぶる者は定まりがない。彼の欲は陰府のように広い。彼は死のようであって、飽くことなく、万国をおのれに集め、万民をおのれのものとしてつどわせる」。"},{"ref":"Hab.2.6","start":35002006,"end":35002006,"break":"stanza","breaks":[[20,"line"],[44,"line"],[51,"line"],[61,"line"],[80,"line"],[94,"line"]],"ruby":[[4,1,"みな"],[13,1,"かれ"],[31,1,"かれ"],[35,1,"わら"],[48,1,"い"],[65,1,"ぞく"],[72,1,"ま"],[74,1,"くわ"],[77,1,"もの"],[94,2,"しちもの"],[101,1,"おも"],[105,1,"もの"]],"text":"これらは皆ことわざをもって彼をあざけり、あざけりのなぞをもって彼をあざ笑わないだろうか。すなわち言う、「わざわいなるかな、おのれに属さないものを増し加える者よ。いつまでこのようであろうか。質物でおのれを重くする者よ」。"},{"ref":"Hab.2.7","start":35002007,"end":35002007,"break":"line","breaks":[[23,"line"],[47,"line"]],"ruby":[[4,3,"ふさいしゃ"],[13,1,"おこ"],[27,1,"はげ"],[34,1,"もの"],[36,1,"め"],[49,1,"とき"],[54,1,"かれ"]],"text":"あなたの負債者は、にわかに興らないであろうか。あなたを激しくゆすぶる者は目ざめないであろうか。その時あなたは彼らにかすめられる。"},{"ref":"Hab.2.8","start":35002008,"end":35002008,"break":"line","breaks":[[17,"line"],[41,"line"],[51,"line"],[68,"line"]],"ruby":[[4,1,"おお"],[7,2,"こくみん"],[24,1,"たみ"],[26,1,"のこ"],[29,1,"もの"],[31,1,"みな"],[44,1,"ひと"],[46,1,"ち"],[48,1,"なが"],[51,1,"くに"],[53,1,"まち"],[58,1,"なか"],[60,1,"す"],[66,1,"もの"],[68,2,"ぼうぎゃく"],[71,1,"おこな"]],"text":"あなたは多くの国民をかすめたゆえ、そのもろもろの民の残れる者は皆あなたをかすめる。これは人の血を流し、国と町と、その中に住むすべての者に暴虐を行ったからである。"},{"ref":"Hab.2.9","start":35002009,"end":35002009,"break":"stanza","breaks":[[9,"line"],[31,"line"]],"ruby":[[9,1,"わざわい"],[11,1,"て"],[13,1,"まぬか"],[19,1,"たか"],[21,1,"ところ"],[23,1,"す"],[25,1,"かま"],[34,1,"いえ"],[39,2,"ふぎ"],[42,1,"り"],[44,1,"と"],[46,1,"もの"]],"text":"わざわいなるかな、災の手を免れるために高い所に巣を構えようと、おのが家のために不義の利を取る者よ。"},{"ref":"Hab.2.10","start":35002010,"end":35002010,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"こと"],[10,2,"じぶん"],[13,1,"いえ"],[15,1,"はじ"],[17,1,"まね"],[20,1,"おお"],[23,1,"たみ"],[25,1,"ほろ"],[30,2,"じぶん"],[33,2,"せいめい"],[36,1,"うしな"]],"text":"あなたは事をはかって自分の家に恥を招き、多くの民を滅ぼして、自分の生命を失った。"},{"ref":"Hab.2.11","start":35002011,"end":35002011,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"いし"],[2,1,"いし"],[7,1,"さけ"],[10,1,"はり"],[12,2,"たてもの"],[19,1,"こた"]],"text":"石は石がきから叫び、梁は建物からこれに答えるからである。"},{"ref":"Hab.2.12","start":35002012,"end":35002012,"break":"stanza","breaks":[[9,"line"],[19,"line"]],"ruby":[[9,1,"ち"],[14,1,"まち"],[16,1,"た"],[19,1,"あく"],[24,1,"まち"],[26,1,"きず"],[28,1,"もの"]],"text":"わざわいなるかな、血をもって町を建て、悪をもって町を築く者よ。"},{"ref":"Hab.2.13","start":35002013,"end":35002013,"break":"line","breaks":[[18,"line"],[40,"line"]],"ruby":[[0,1,"み"],[8,1,"たみ"],[10,1,"ひ"],[15,1,"ろう"],[23,1,"くに"],[31,1,"こと"],[36,1,"つか"],[43,2,"ばんぐん"],[46,1,"しゅ"],[49,1,"で"],[51,2,"ことば"]],"text":"見よ、もろもろの民は火のために労し、もろもろの国びとはむなしい事のために疲れる。これは万軍の主から出る言葉ではないか。"},{"ref":"Hab.2.14","start":35002014,"end":35002014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"うみ"],[2,1,"みず"],[15,1,"ち"],[17,1,"しゅ"],[19,2,"えいこう"],[22,2,"ちしき"],[25,1,"み"]],"text":"海が水でおおわれているように、地は主の栄光の知識で満たされるからである。"},{"ref":"Hab.2.15","start":35002015,"end":35002015,"break":"stanza","breaks":[[9,"line"],[32,"line"]],"ruby":[[11,1,"とな"],[13,1,"びと"],[15,1,"いか"],[18,1,"はい"],[20,1,"の"],[28,1,"よ"],[32,1,"かれ"],[35,1,"かく"],[37,1,"どころ"],[39,1,"み"],[45,1,"もの"]],"text":"わざわいなるかな、その隣り人に怒りの杯を飲ませて、これを酔わせ、彼らの隠し所を見ようとする者よ。"},{"ref":"Hab.2.16","start":35002016,"end":35002016,"break":"line","breaks":[[14,"line"],[28,"line"],[46,"line"]],"ruby":[[4,1,"ほまれ"],[6,1,"かわ"],[9,1,"はじ"],[11,1,"あ"],[20,1,"の"],[28,1,"しゅ"],[30,1,"みぎ"],[32,1,"て"],[34,1,"はい"],[41,1,"めぐ"],[43,1,"く"],[46,1,"はじ"],[52,1,"ほまれ"],[54,1,"かわ"]],"text":"あなたは誉の代りに恥に飽き、あなたもまた飲んでよろめけ。主の右の手の杯は、あなたに巡り来る。恥はあなたの誉に代る。"},{"ref":"Hab.2.17","start":35002017,"end":35002017,"break":"line","breaks":[[23,"line"],[42,"line"],[52,"line"],[70,"line"]],"ruby":[[12,2,"ぼうぎゃく"],[20,1,"たお"],[23,1,"けもの"],[28,2,"めつぼう"],[36,1,"おそ"],[45,1,"ひと"],[47,1,"ち"],[49,1,"なが"],[52,1,"くに"],[54,1,"まち"],[57,1,"まち"],[59,1,"なか"],[61,1,"す"],[67,1,"もの"],[70,2,"ぼうぎゃく"],[73,1,"おこな"]],"text":"あなたがレバノンになした暴虐は、あなたを倒し、獣のような滅亡は、あなたを恐れさせる。これは人の血を流し、国と町と、町の中に住むすべての者に、暴虐を行ったからである。"},{"ref":"Hab.2.18","start":35002018,"end":35002018,"break":"stanza","breaks":[[19,"line"],[42,"line"],[58,"line"],[73,"line"]],"ruby":[[0,1,"きざ"],[3,1,"ぞう"],[5,1,"ちゅう"],[6,1,"ぞう"],[10,1,"いつわ"],[13,1,"おし"],[16,1,"もの"],[21,2,"さくしゃ"],[27,1,"きざ"],[35,1,"えき"],[44,2,"さくしゃ"],[47,2,"ものい"],[51,2,"ぐうぞう"],[54,1,"つく"],[60,1,"つく"],[66,1,"たの"],[76,1,"えき"]],"text":"刻める像、鋳像および偽りを教える者は、その作者がこれを刻んだとてなんの益があろうか。その作者が物言わぬ偶像を造って、その造ったものに頼んでみても、なんの益があろうか。"},{"ref":"Hab.2.19","start":35002019,"end":35002019,"break":"line","breaks":[[9,"line"],[23,"line"],[43,"line"],[56,"line"],[72,"line"]],"ruby":[[9,1,"き"],[11,1,"む"],[20,1,"い"],[23,2,"ものい"],[27,1,"いし"],[29,1,"む"],[34,1,"お"],[38,1,"い"],[40,1,"もの"],[46,2,"もくし"],[49,1,"あた"],[51,1,"え"],[56,1,"み"],[62,2,"きんぎん"],[74,1,"なか"],[77,1,"いのち"],[79,1,"いき"],[81,1,"すこ"]],"text":"わざわいなるかな、木に向かって、さめよと言い、物言わぬ石に向かって、起きよと言う者よ。これは黙示を与え得ようか。見よ、これは金銀をきせたもので、その中には命の息は少しもない。"},{"ref":"Hab.2.20","start":35002020,"end":35002020,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"しゅ"],[8,1,"せい"],[11,1,"みや"],[17,1,"ぜん"],[18,1,"ち"],[23,1,"まえ"],[25,2,"ちんもく"]],"text":"しかし、主はその聖なる宮にいます、全地はそのみ前に沈黙せよ。"}]