[{"ref":"Rev.17.1","start":66017001,"end":66017001,"break":"paragraph","ruby":[[8,1,"はち"],[10,1,"も"],[13,1,"にん"],[15,2,"みつかい"],[29,1,"かた"],[32,1,"い"],[45,1,"おお"],[48,1,"みず"],[50,1,"うえ"],[58,1,"おお"],[59,2,"いんぷ"],[62,1,"たい"],[70,1,"み"]],"text":"それから、七つの鉢を持つ七人の御使のひとりがきて、わたしに語って言った、「さあ、きなさい。多くの水の上にすわっている大淫婦に対するさばきを、見せよう。"},{"ref":"Rev.17.2","start":66017002,"end":66017002,"break":"none","ruby":[[0,1,"ち"],[2,1,"おう"],[8,1,"おんな"],[10,2,"かんいん"],[13,1,"おこな"],[16,1,"ち"],[18,1,"す"],[20,2,"ひとびと"],[25,1,"おんな"],[27,2,"かんいん"],[33,1,"しゅ"],[35,1,"よ"]],"text":"地の王たちはこの女と姦淫を行い、地に住む人々はこの女の姦淫のぶどう酒に酔いしれている」。"},{"ref":"Rev.17.3","start":66017003,"end":66017003,"break":"none","ruby":[[0,2,"みつかい"],[8,2,"みたま"],[11,1,"かん"],[17,2,"あらの"],[20,1,"つ"],[23,1,"い"],[39,1,"おんな"],[41,1,"あか"],[43,1,"けもの"],[45,1,"の"],[52,1,"み"],[57,1,"けもの"],[59,1,"かみ"],[61,1,"けが"],[68,1,"な"],[84,1,"あたま"],[88,1,"つの"]],"text":"御使は、わたしを御霊に感じたまま、荒野へ連れて行った。わたしは、そこでひとりの女が赤い獣に乗っているのを見た。その獣は神を汚すかずかずの名でおおわれ、また、それに七つの頭と十の角とがあった。"},{"ref":"Rev.17.4","start":66017004,"end":66017004,"break":"none","ruby":[[2,1,"おんな"],[4,1,"むらさき"],[6,1,"あか"],[8,1,"ころも"],[14,1,"きん"],[16,2,"ほうせき"],[19,2,"しんじゅ"],[23,1,"み"],[25,1,"かざ"],[28,1,"にく"],[35,2,"じぶん"],[38,2,"かんいん"],[41,1,"けが"],[45,1,"み"],[50,1,"きん"],[52,1,"さかずき"],[54,1,"て"],[56,1,"も"]],"text":"この女は紫と赤の衣をまとい、金と宝石と真珠とで身を飾り、憎むべきものと自分の姦淫の汚れとで満ちている金の杯を手に持ち、"},{"ref":"Rev.17.5","start":66017005,"end":66017005,"break":"none","ruby":[[2,1,"ひたい"],[9,1,"な"],[22,2,"おくぎ"],[30,1,"おお"],[39,2,"いんぷ"],[44,1,"ち"],[46,1,"にく"],[55,1,"はは"]],"text":"その額には、一つの名がしるされていた。それは奥義であって、「大いなるバビロン、淫婦どもと地の憎むべきものらとの母」というのであった。"},{"ref":"Rev.17.6","start":66017006,"end":66017006,"break":"none","breaks":[[35,"paragraph"]],"ruby":[[7,1,"おんな"],[9,2,"せいと"],[12,1,"ち"],[18,2,"しょうにん"],[21,1,"ち"],[23,1,"よ"],[32,1,"み"],[37,1,"おんな"],[39,1,"み"],[41,1,"とき"],[47,2,"ひじょう"],[50,1,"おどろ"]],"text":"わたしは、この女が聖徒の血とイエスの証人の血に酔いしれているのを見た。この女を見た時、わたしは非常に驚きあやしんだ。"},{"ref":"Rev.17.7","start":66017007,"end":66017007,"break":"none","ruby":[[4,2,"みつかい"],[11,1,"い"],[22,1,"おどろ"],[29,1,"おんな"],[31,2,"おくぎ"],[35,1,"おんな"],[37,1,"の"],[45,1,"あたま"],[49,1,"つの"],[53,1,"けもの"],[55,2,"おくぎ"],[60,1,"はな"]],"text":"すると、御使はわたしに言った、「なぜそんなに驚くのか。この女の奥義と、女を乗せている七つの頭と十の角のある獣の奥義とを、話してあげよう。"},{"ref":"Rev.17.8","start":66017008,"end":66017008,"break":"none","ruby":[[4,1,"み"],[6,1,"けもの"],[9,1,"むかし"],[15,1,"いま"],[28,1,"そこ"],[29,1,"し"],[32,1,"ところ"],[35,1,"のぼ"],[45,1,"ほろ"],[48,1,"いた"],[56,1,"ち"],[58,1,"す"],[60,1,"もの"],[65,1,"よ"],[67,1,"はじ"],[75,1,"しょ"],[77,1,"な"],[87,1,"もの"],[94,1,"けもの"],[97,1,"むかし"],[102,1,"いま"],[111,1,"く"],[115,1,"み"],[118,1,"おどろ"]],"text":"あなたの見た獣は、昔はいたが、今はおらず、そして、やがて底知れぬ所から上ってきて、ついには滅びに至るものである。地に住む者のうち、世の初めからいのちの書に名をしるされていない者たちは、この獣が、昔はいたが今はおらず、やがて来るのを見て、驚きあやしむであろう。"},{"ref":"Rev.17.9","start":66017009,"end":66017009,"break":"none","ruby":[[4,2,"ちえ"],[9,1,"こころ"],[11,2,"ひつよう"],[20,1,"あたま"],[25,1,"おんな"],[36,1,"やま"],[45,1,"にん"],[47,1,"おう"]],"text":"ここに、知恵のある心が必要である。七つの頭は、この女のすわっている七つの山であり、また、七人の王のことである。"},{"ref":"Rev.17.10","start":66017010,"end":66017010,"break":"none","ruby":[[6,1,"にん"],[11,1,"たお"],[18,1,"いま"],[40,1,"く"],[49,1,"あいだ"]],"text":"そのうちの五人はすでに倒れ、ひとりは今おり、もうひとりは、まだきていない。それが来れば、しばらくの間だけおることになっている。"},{"ref":"Rev.17.11","start":66017011,"end":66017011,"break":"none","ruby":[[0,1,"むかし"],[5,1,"いま"],[13,1,"けもの"],[20,1,"だい"],[39,1,"にん"],[41,1,"なか"],[55,1,"ほろ"],[58,1,"いた"]],"text":"昔はいたが今はいないという獣は、すなわち第八のものであるが、またそれは、かの七人の中のひとりであって、ついには滅びに至るものである。"},{"ref":"Rev.17.12","start":66017012,"end":66017012,"break":"none","ruby":[[4,1,"み"],[8,1,"つの"],[12,1,"にん"],[14,1,"おう"],[23,1,"かれ"],[28,1,"くに"],[30,1,"う"],[39,1,"けもの"],[41,1,"とも"],[44,2,"ひととき"],[48,1,"おう"],[53,2,"けんい"],[56,1,"う"]],"text":"あなたの見た十の角は、十人の王のことであって、彼らはまだ国を受けてはいないが、獣と共に、一時だけ王としての権威を受ける。"},{"ref":"Rev.17.13","start":66017013,"end":66017013,"break":"none","ruby":[[0,1,"かれ"],[3,1,"こころ"],[18,2,"じぶん"],[23,1,"ちから"],[25,2,"けんい"],[29,1,"けもの"],[31,1,"あた"]],"text":"彼らは心をひとつにしている。そして、自分たちの力と権威とを獣に与える。"},{"ref":"Rev.17.14","start":66017014,"end":66017014,"break":"none","ruby":[[0,1,"かれ"],[3,2,"こひつじ"],[6,1,"たたか"],[17,2,"こひつじ"],[21,1,"しゅ"],[23,1,"しゅ"],[25,1,"おう"],[27,1,"おう"],[34,1,"かれ"],[39,1,"か"],[45,2,"こひつじ"],[48,1,"とも"],[52,1,"め"],[57,1,"えら"],[62,2,"ちゅうじつ"],[65,1,"もの"],[70,2,"しょうり"],[73,1,"え"]],"text":"彼らは小羊に戦いをいどんでくるが、小羊は、主の主、王の王であるから、彼らにうち勝つ。また、小羊と共にいる召された、選ばれた、忠実な者たちも、勝利を得る」。"},{"ref":"Rev.17.15","start":66017015,"end":66017015,"break":"paragraph","ruby":[[0,2,"みつかい"],[10,1,"い"],[19,1,"み"],[21,1,"みず"],[28,2,"いんぷ"],[37,1,"ところ"],[44,2,"みんぞく"],[47,2,"ぐんしゅう"],[50,2,"こくみん"],[53,2,"こくご"]],"text":"御使はまた、わたしに言った、「あなたの見た水、すなわち、淫婦のすわっている所は、あらゆる民族、群衆、国民、国語である。"},{"ref":"Rev.17.16","start":66017016,"end":66017016,"break":"none","ruby":[[4,1,"み"],[8,1,"つの"],[10,1,"けもの"],[16,2,"いんぷ"],[19,1,"にく"],[26,1,"もの"],[30,1,"はだか"],[34,2,"かのじょ"],[37,1,"にく"],[39,1,"く"],[42,1,"ひ"],[44,1,"や"],[46,1,"つく"]],"text":"あなたの見た十の角と獣とは、この淫婦を憎み、みじめな者にし、裸にし、彼女の肉を食い、火で焼き尽すであろう。"},{"ref":"Rev.17.17","start":66017017,"end":66017017,"break":"none","ruby":[[0,1,"かみ"],[3,2,"みことば"],[6,2,"じょうじゅ"],[10,1,"とき"],[14,1,"かれ"],[17,1,"こころ"],[19,1,"なか"],[22,2,"みむね"],[25,1,"おこな"],[28,1,"おも"],[37,1,"かれ"],[40,2,"しはい"],[42,1,"けん"],[44,1,"けもの"],[46,1,"あた"],[49,1,"おも"],[52,1,"も"]],"text":"神は、御言が成就する時まで、彼らの心の中に、御旨を行い、思いをひとつにし、彼らの支配権を獣に与える思いを持つようにされたからである。"},{"ref":"Rev.17.18","start":66017018,"end":66017018,"break":"none","ruby":[[4,1,"み"],[8,1,"おんな"],[11,1,"ち"],[13,1,"おう"],[17,2,"しはい"],[21,1,"おお"],[25,1,"みやこ"]],"text":"あなたの見たかの女は、地の王たちを支配する大いなる都のことである」。"}]