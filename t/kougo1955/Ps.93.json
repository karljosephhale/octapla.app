[{"ref":"Ps.93.1","start":19093001,"end":19093001,"break":"paragraph","breaks":[[7,"line"],[19,"line"],[39,"line"],[53,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おう"],[7,2,"いこう"],[10,1,"ころも"],[19,1,"しゅ"],[21,1,"ころも"],[27,1,"ちから"],[32,1,"おび"],[44,2,"せかい"],[47,1,"かた"],[49,1,"た"],[53,1,"うご"]],"text":"主は王となり、威光の衣をまとわれます。主は衣をまとい、力をもって帯とされます。まことに、世界は堅く立って、動かされることはありません。"},{"ref":"Ps.93.2","start":19093002,"end":19093002,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"くらい"],[12,1,"かた"],[14,1,"た"]],"text":"あなたの位はいにしえより堅く立ち、あなたはとこしえよりいらせられます。"},{"ref":"Ps.93.3","start":19093003,"end":19093003,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[3,2,"おおみず"],[6,1,"こえ"],[14,2,"おおみず"],[19,1,"こえ"],[27,2,"おおみず"],[36,1,"こえ"]],"text":"主よ、大水は声をあげました。大水はその声をあげました。大水はそのとどろく声をあげます。"},{"ref":"Ps.93.4","start":19093004,"end":19093004,"break":"line","breaks":[[13,"line"],[32,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"たか"],[4,1,"ところ"],[15,1,"いきお"],[18,1,"おお"],[21,1,"みず"],[32,1,"うみ"],[34,2,"おおなみ"],[41,1,"さか"]],"text":"主は高き所にいらせられて、その勢いは多くの水のとどろきにまさり、海の大波にまさって盛んです。"},{"ref":"Ps.93.5","start":19093005,"end":19093005,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[11,1,"たし"],[16,1,"しゅ"],[19,1,"せい"],[36,1,"いえ"]],"text":"あなたのあかしはいとも確かです。主よ、聖なることはとこしえまでもあなたの家にふさわしいのです。"}]