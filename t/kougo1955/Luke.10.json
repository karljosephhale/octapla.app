[{"ref":"Luke.10.1","start":42010001,"end":42010001,"break":"paragraph","ruby":[[2,1,"のち"],[4,1,"しゅ"],[6,1,"べつ"],[11,1,"にん"],[13,1,"えら"],[16,1,"い"],[30,1,"まち"],[32,1,"むら"],[40,1,"さき"]],"text":"その後、主は別に七十二人を選び、行こうとしておられたすべての町や村へ、ふたりずつ先におつかわしになった。"},{"ref":"Luke.10.2","start":42010002,"end":42010002,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[14,2,"しゅうかく"],[17,1,"おお"],[21,1,"はたら"],[23,1,"びと"],[25,1,"すく"],[33,2,"しゅうかく"],[36,1,"しゅ"],[38,1,"ねが"],[44,2,"しゅうかく"],[50,1,"はたら"],[52,1,"びと"],[54,1,"おく"],[56,1,"だ"]],"text":"そのとき、彼らに言われた、「収穫は多いが、働き人が少ない。だから、収穫の主に願って、その収穫のために働き人を送り出すようにしてもらいなさい。"},{"ref":"Luke.10.3","start":42010003,"end":42010003,"break":"none","ruby":[[3,1,"い"],[26,2,"こひつじ"],[34,1,"なか"],[36,1,"おく"]],"text":"さあ、行きなさい。わたしがあなたがたをつかわすのは、小羊をおおかみの中に送るようなものである。"},{"ref":"Luke.10.4","start":42010004,"end":42010004,"break":"none","ruby":[[0,2,"さいふ"],[3,1,"ふくろ"],[8,1,"も"],[11,1,"い"],[19,1,"みち"]],"text":"財布も袋もくつも持って行くな。だれにも道であいさつするな。"},{"ref":"Luke.10.5","start":42010005,"end":42010005,"break":"none","ruby":[[4,1,"いえ"],[15,2,"へいあん"],[20,1,"いえ"],[29,1,"い"]],"text":"どこかの家にはいったら、まず『平安がこの家にあるように』と言いなさい。"},{"ref":"Luke.10.6","start":42010006,"end":42010006,"break":"none","ruby":[[2,2,"へいあん"],[5,1,"こ"],[20,1,"いの"],[22,2,"へいあん"],[27,1,"ひと"],[29,1,"うえ"],[60,1,"うえ"],[62,1,"かえ"],[65,1,"く"]],"text":"もし平安の子がそこにおれば、あなたがたの祈る平安はその人の上にとどまるであろう。もしそうでなかったら、それはあなたがたの上に帰って来るであろう。"},{"ref":"Luke.10.7","start":42010007,"end":42010007,"break":"none","ruby":[[6,1,"おな"],[8,1,"いえ"],[10,1,"とど"],[17,1,"いえ"],[19,1,"ひと"],[21,1,"だ"],[30,1,"の"],[32,1,"く"],[39,1,"はたら"],[41,1,"びと"],[45,1,"むく"],[48,1,"え"],[52,2,"とうぜん"],[58,1,"いえ"],[61,1,"いえ"],[64,1,"わた"],[66,1,"ある"]],"text":"それで、その同じ家に留まっていて、家の人が出してくれるものを飲み食いしなさい。働き人がその報いを得るのは当然である。家から家へと渡り歩くな。"},{"ref":"Luke.10.8","start":42010008,"end":42010008,"break":"none","ruby":[[2,1,"まち"],[10,2,"ひとびと"],[19,1,"むか"],[28,1,"まえ"],[30,1,"だ"],[37,1,"た"]],"text":"どの町へはいっても、人々があなたがたを迎えてくれるなら、前に出されるものを食べなさい。"},{"ref":"Luke.10.9","start":42010009,"end":42010009,"break":"none","ruby":[[6,1,"まち"],[10,2,"びょうにん"],[21,1,"かみ"],[23,1,"くに"],[31,1,"ちか"],[37,1,"い"]],"text":"そして、その町にいる病人をいやしてやり、『神の国はあなたがたに近づいた』と言いなさい。"},{"ref":"Luke.10.10","start":42010010,"end":42010010,"break":"none","ruby":[[6,1,"まち"],[14,2,"ひとびと"],[23,1,"むか"],[27,2,"ばあい"],[32,2,"おおどお"],[36,1,"で"],[38,1,"い"],[41,1,"い"]],"text":"しかし、どの町へはいっても、人々があなたがたを迎えない場合には、大通りに出て行って言いなさい、"},{"ref":"Luke.10.11","start":42010011,"end":42010011,"break":"none","ruby":[[7,1,"あし"],[16,1,"まち"],[25,1,"す"],[28,1,"い"],[35,1,"かみ"],[37,1,"くに"],[39,1,"ちか"],[47,2,"しょうち"]],"text":"『わたしたちの足についているこの町のちりも、ぬぐい捨てて行く。しかし、神の国が近づいたことは、承知しているがよい』。"},{"ref":"Luke.10.12","start":42010012,"end":42010012,"break":"none","ruby":[[6,1,"い"],[14,1,"ひ"],[20,1,"まち"],[28,1,"ほう"],[30,1,"た"]],"text":"あなたがたに言っておく。その日には、この町よりもソドムの方が耐えやすいであろう。"},{"ref":"Luke.10.13","start":42010013,"end":42010013,"break":"none","ruby":[[31,1,"なか"],[37,1,"ちから"],[60,1,"かれ"],[66,1,"むかし"],[69,2,"あらぬの"],[75,1,"はい"],[77,1,"なか"],[84,1,"く"],[86,1,"あらた"]],"text":"わざわいだ、コラジンよ。わざわいだ、ベツサイダよ。おまえたちの中でなされた力あるわざが、もしツロとシドンでなされたなら、彼らはとうの昔に、荒布をまとい灰の中にすわって、悔い改めたであろう。"},{"ref":"Luke.10.14","start":42010014,"end":42010014,"break":"none","ruby":[[8,1,"ひ"],[19,1,"ほう"],[30,1,"た"]],"text":"しかし、さばきの日には、ツロとシドンの方がおまえたちよりも、耐えやすいであろう。"},{"ref":"Luke.10.15","start":42010015,"end":42010015,"break":"none","ruby":[[14,1,"てん"],[18,1,"あ"],[32,2,"よみ"],[37,1,"おと"]],"text":"ああ、カペナウムよ、おまえは天にまで上げられようとでもいうのか。黄泉にまで落されるであろう。"},{"ref":"Luke.10.16","start":42010016,"end":42010016,"break":"none","ruby":[[6,1,"き"],[8,1,"したが"],[10,1,"もの"],[17,1,"き"],[19,1,"したが"],[32,1,"こば"],[34,1,"もの"],[41,1,"こば"],[55,1,"こば"],[57,1,"もの"],[76,1,"こば"]],"text":"あなたがたに聞き従う者は、わたしに聞き従うのであり、あなたがたを拒む者は、わたしを拒むのである。そしてわたしを拒む者は、わたしをおつかわしになったかたを拒むのである」。"},{"ref":"Luke.10.17","start":42010017,"end":42010017,"break":"paragraph","ruby":[[3,1,"にん"],[5,1,"よろこ"],[8,1,"かえ"],[13,1,"い"],[18,1,"しゅ"],[25,1,"な"],[37,2,"あくれい"],[48,2,"ふくじゅう"]],"text":"七十二人が喜んで帰ってきて言った、「主よ、あなたの名によっていたしますと、悪霊までがわたしたちに服従します」。"},{"ref":"Luke.10.18","start":42010018,"end":42010018,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[17,2,"でんこう"],[23,1,"てん"],[26,1,"お"],[31,1,"み"]],"text":"彼らに言われた、「わたしはサタンが電光のように天から落ちるのを見た。"},{"ref":"Luke.10.19","start":42010019,"end":42010019,"break":"none","ruby":[[18,1,"ふ"],[23,1,"てき"],[29,1,"ちから"],[31,1,"う"],[33,1,"か"],[35,2,"けんい"],[38,1,"さづ"],[52,1,"がい"],[58,1,"もの"],[64,1,"な"]],"text":"わたしはあなたがたに、へびやさそりを踏みつけ、敵のあらゆる力に打ち勝つ権威を授けた。だから、あなたがたに害をおよぼす者はまったく無いであろう。"},{"ref":"Luke.10.20","start":42010020,"end":42010020,"break":"none","ruby":[[4,1,"れい"],[12,2,"ふくじゅう"],[19,1,"よろこ"],[33,1,"な"],[35,1,"てん"],[47,1,"よろこ"]],"text":"しかし、霊があなたがたに服従することを喜ぶな。むしろ、あなたがたの名が天にしるされていることを喜びなさい」。"},{"ref":"Luke.10.21","start":42010021,"end":42010021,"break":"paragraph","ruby":[[9,2,"せいれい"],[15,1,"よろこ"],[21,1,"い"],[27,2,"てんち"],[30,1,"しゅ"],[33,1,"ちち"],[52,1,"こと"],[54,2,"ちえ"],[59,1,"もの"],[61,1,"かしこ"],[63,1,"もの"],[65,1,"かく"],[69,1,"おさ"],[71,1,"ご"],[86,1,"ちち"],[106,1,"こと"]],"text":"そのとき、イエスは聖霊によって喜びあふれて言われた、「天地の主なる父よ。あなたをほめたたえます。これらの事を知恵のある者や賢い者に隠して、幼な子にあらわしてくださいました。父よ、これはまことに、みこころにかなった事でした。"},{"ref":"Luke.10.22","start":42010022,"end":42010022,"break":"none","ruby":[[4,1,"こと"],[6,1,"ちち"],[13,1,"まか"],[26,1,"こ"],[36,1,"ちち"],[40,1,"し"],[45,1,"もの"],[55,1,"ちち"],[65,1,"こ"],[68,1,"ちち"],[78,1,"こ"],[80,1,"えら"],[83,1,"もの"],[92,1,"し"],[97,1,"もの"]],"text":"すべての事は父からわたしに任せられています。そして、子がだれであるかは、父のほか知っている者はありません。また父がだれであるかは、子と、父をあらわそうとして子が選んだ者とのほか、だれも知っている者はいません」。"},{"ref":"Luke.10.23","start":42010023,"end":42010023,"break":"none","ruby":[[4,2,"でし"],[9,1,"ほう"],[11,1,"ふ"],[21,1,"い"],[33,1,"み"],[40,1,"み"],[42,1,"め"]],"text":"それから弟子たちの方に振りむいて、ひそかに言われた、「あなたがたが見ていることを見る目は、さいわいである。"},{"ref":"Luke.10.24","start":42010024,"end":42010024,"break":"none","ruby":[[6,1,"い"],[12,1,"おお"],[15,3,"よげんしゃ"],[19,1,"おう"],[30,1,"み"],[37,1,"み"],[45,1,"み"],[60,1,"き"],[68,1,"き"],[76,1,"き"]],"text":"あなたがたに言っておく。多くの預言者や王たちも、あなたがたの見ていることを見ようとしたが、見ることができず、あなたがたの聞いていることを聞こうとしたが、聞けなかったのである」。"},{"ref":"Luke.10.25","start":42010025,"end":42010025,"break":"paragraph","ruby":[[9,2,"りっぽう"],[11,2,"がくしゃ"],[14,1,"あらわ"],[21,1,"こころ"],[28,1,"い"],[33,2,"せんせい"],[36,1,"なに"],[41,2,"えいえん"],[44,2,"せいめい"],[47,1,"う"]],"text":"するとそこへ、ある律法学者が現れ、イエスを試みようとして言った、「先生、何をしたら永遠の生命が受けられましょうか」。"},{"ref":"Luke.10.26","start":42010026,"end":42010026,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[8,2,"りっぽう"],[15,1,"か"],[28,1,"よ"]],"text":"彼に言われた、「律法にはなんと書いてあるか。あなたはどう読むか」。"},{"ref":"Luke.10.27","start":42010027,"end":42010027,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こた"],[5,1,"い"],[11,1,"こころ"],[17,2,"せいしん"],[24,1,"ちから"],[30,1,"おも"],[38,1,"しゅ"],[45,1,"かみ"],[47,1,"あい"],[56,2,"じぶん"],[59,1,"あい"],[70,1,"とな"],[72,1,"びと"],[74,1,"あい"]],"text":"彼は答えて言った、「『心をつくし、精神をつくし、力をつくし、思いをつくして、主なるあなたの神を愛せよ』。また、『自分を愛するように、あなたの隣り人を愛せよ』とあります」。"},{"ref":"Luke.10.28","start":42010028,"end":42010028,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[12,1,"こたえ"],[14,1,"ただ"],[23,1,"おこな"],[39,1,"え"]],"text":"彼に言われた、「あなたの答は正しい。そのとおり行いなさい。そうすれば、いのちが得られる」。"},{"ref":"Luke.10.29","start":42010029,"end":42010029,"break":"none","ruby":[[3,1,"かれ"],[5,2,"じぶん"],[8,2,"たちば"],[11,2,"べんご"],[17,1,"おも"],[25,1,"い"],[37,1,"とな"],[39,1,"びと"]],"text":"すると彼は自分の立場を弁護しようと思って、イエスに言った、「では、わたしの隣り人とはだれのことですか」。"},{"ref":"Luke.10.30","start":42010030,"end":42010030,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[15,1,"ひと"],[28,1,"くだ"],[31,1,"い"],[33,2,"とちゅう"],[36,2,"ごうとう"],[41,1,"かれ"],[43,1,"おそ"],[48,2,"きもの"],[53,1,"と"],[56,1,"きず"],[58,1,"お"],[62,2,"はんごろ"],[71,1,"に"],[73,1,"さ"]],"text":"イエスが答えて言われた、「ある人がエルサレムからエリコに下って行く途中、強盗どもが彼を襲い、その着物をはぎ取り、傷を負わせ、半殺しにしたまま、逃げ去った。"},{"ref":"Luke.10.31","start":42010031,"end":42010031,"break":"none","ruby":[[12,2,"さいし"],[17,1,"みち"],[19,1,"くだ"],[28,1,"ひと"],[30,1,"み"],[34,1,"む"],[37,1,"がわ"],[39,1,"とお"],[42,1,"い"]],"text":"するとたまたま、ひとりの祭司がその道を下ってきたが、この人を見ると、向こう側を通って行った。"},{"ref":"Luke.10.32","start":42010032,"end":42010032,"break":"none","ruby":[[0,2,"どうよう"],[6,1,"ひと"],[10,2,"ばしょ"],[23,1,"かれ"],[25,1,"み"],[28,1,"む"],[31,1,"がわ"],[33,1,"とお"],[36,1,"い"]],"text":"同様に、レビ人もこの場所にさしかかってきたが、彼を見ると向こう側を通って行った。"},{"ref":"Luke.10.33","start":42010033,"end":42010033,"break":"none","ruby":[[11,1,"びと"],[13,1,"たび"],[19,1,"ひと"],[25,1,"とお"],[31,1,"かれ"],[33,1,"み"],[35,1,"き"],[37,1,"どく"],[39,1,"おも"]],"text":"ところが、あるサマリヤ人が旅をしてこの人のところを通りかかり、彼を見て気の毒に思い、"},{"ref":"Luke.10.34","start":42010034,"end":42010034,"break":"none","ruby":[[0,2,"ちかよ"],[8,1,"きず"],[13,1,"ゆ"],[18,1,"しゅ"],[21,1,"そそ"],[34,2,"じぶん"],[37,2,"かちく"],[40,1,"の"],[43,2,"やどや"],[46,1,"つ"],[49,1,"い"],[52,2,"かいほう"]],"text":"近寄ってきてその傷にオリブ油とぶどう酒とを注いでほうたいをしてやり、自分の家畜に乗せ、宿屋に連れて行って介抱した。"},{"ref":"Luke.10.35","start":42010035,"end":42010035,"break":"none","ruby":[[0,2,"よくじつ"],[9,1,"と"],[11,1,"だ"],[14,2,"やどや"],[17,2,"しゅじん"],[20,2,"てわた"],[27,1,"ひと"],[29,1,"み"],[39,2,"ひよう"],[52,1,"かえ"],[62,2,"しはら"],[69,1,"い"]],"text":"翌日、デナリ二つを取り出して宿屋の主人に手渡し、『この人を見てやってください。費用がよけいにかかったら、帰りがけに、わたしが支払います』と言った。"},{"ref":"Luke.10.36","start":42010036,"end":42010036,"break":"none","ruby":[[3,1,"にん"],[11,2,"ごうとう"],[14,1,"おそ"],[18,1,"ひと"],[20,1,"とな"],[22,1,"びと"],[28,1,"おも"]],"text":"この三人のうち、だれが強盗に襲われた人の隣り人になったと思うか」。"},{"ref":"Luke.10.37","start":42010037,"end":42010037,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[9,1,"ひと"],[11,2,"じひ"],[13,1,"ぶか"],[15,1,"おこな"],[20,1,"ひと"],[32,1,"い"],[42,1,"い"],[45,1,"おな"]],"text":"彼が言った、「その人に慈悲深い行いをした人です」。そこでイエスは言われた、「あなたも行って同じようにしなさい」。"},{"ref":"Luke.10.38","start":42010038,"end":42010038,"break":"paragraph","ruby":[[0,2,"いちどう"],[3,1,"たび"],[5,1,"つづ"],[20,1,"むら"],[37,1,"な"],[39,1,"おんな"],[45,1,"いえ"],[47,1,"むか"],[49,1,"い"]],"text":"一同が旅を続けているうちに、イエスがある村へはいられた。するとマルタという名の女がイエスを家に迎え入れた。"},{"ref":"Luke.10.39","start":42010039,"end":42010039,"break":"none","ruby":[[2,1,"おんな"],[10,1,"いもうと"],[16,1,"しゅ"],[18,1,"あし"],[27,2,"みことば"],[30,1,"き"],[32,1,"い"]],"text":"この女にマリヤという妹がいたが、主の足もとにすわって、御言に聞き入っていた。"},{"ref":"Luke.10.40","start":42010040,"end":42010040,"break":"none","ruby":[[9,2,"せったい"],[15,1,"いそ"],[20,1,"こころ"],[38,1,"い"],[43,1,"しゅ"],[46,1,"いもうと"],[54,2,"せったい"],[70,1,"おも"],[84,2,"てつだ"],[93,1,"いもうと"]],"text":"ところが、マルタは接待のことで忙がしくて心をとりみだし、イエスのところにきて言った、「主よ、妹がわたしだけに接待をさせているのを、なんともお思いになりませんか。わたしの手伝いをするように妹におっしゃってください」。"},{"ref":"Luke.10.41","start":42010041,"end":42010041,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"こた"],[5,1,"い"],[25,1,"おお"],[31,1,"こころ"],[33,1,"くば"],[36,1,"おも"]],"text":"主は答えて言われた、「マルタよ、マルタよ、あなたは多くのことに心を配って思いわずらっている。"},{"ref":"Luke.10.42","start":42010042,"end":42010042,"break":"none","ruby":[[4,1,"な"],[13,1,"おお"],[36,1,"よ"],[38,1,"ほう"],[40,1,"えら"],[53,2,"かのじょ"],[57,1,"と"],[59,1,"さ"]],"text":"しかし、無くてならぬものは多くはない。いや、一つだけである。マリヤはその良い方を選んだのだ。そしてそれは、彼女から取り去ってはならないものである」。"}]