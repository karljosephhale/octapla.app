[{"ref":"Ezek.12.1","start":26012001,"end":26012001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.12.2","start":26012002,"end":26012002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,2,"はんぎゃく"],[13,1,"いえ"],[15,1,"なか"],[20,1,"かれ"],[23,1,"み"],[25,1,"め"],[30,1,"み"],[33,1,"き"],[35,1,"みみ"],[40,1,"き"],[44,1,"かれ"],[47,2,"はんぎゃく"],[50,1,"いえ"]],"text":"「人の子よ、あなたは反逆の家の中にいる。彼らは見る目があるが見ず、聞く耳があるが聞かず、彼らは反逆の家である。"},{"ref":"Ezek.12.3","start":26012003,"end":26012003,"break":"none","ruby":[[5,1,"ひと"],[7,1,"こ"],[10,2,"ほしゅう"],[13,2,"にもつ"],[16,1,"ととの"],[19,1,"かれ"],[22,1,"め"],[24,1,"まえ"],[26,1,"ひる"],[31,1,"うつ"],[34,1,"かれ"],[37,1,"め"],[39,1,"まえ"],[45,1,"ところ"],[48,1,"た"],[50,1,"ところ"],[52,1,"うつ"],[55,1,"かれ"],[58,2,"はんぎゃく"],[61,1,"いえ"],[71,1,"かれ"],[74,1,"かえり"]],"text":"それゆえ、人の子よ、捕囚の荷物を整え、彼らの目の前で昼のうちに移れ、彼らの目の前であなたの所から他の所に移れ。彼らは反逆の家であるが、あるいは彼らは顧みるところがあろう。"},{"ref":"Ezek.12.4","start":26012004,"end":26012004,"break":"none","ruby":[[5,2,"ほしゅう"],[8,2,"にもつ"],[18,2,"にもつ"],[22,1,"かれ"],[25,1,"め"],[27,1,"まえ"],[29,1,"ひる"],[34,1,"も"],[36,1,"だ"],[42,2,"ほしゅう"],[45,1,"ゆ"],[49,2,"ひとびと"],[56,1,"かれ"],[59,1,"め"],[61,1,"まえ"],[63,1,"ゆう"],[69,1,"で"],[71,1,"い"]],"text":"あなたは、捕囚の荷物のようなあなたの荷物を、彼らの目の前で昼のうちに持ち出せ。そして捕囚に行くべき人々のように、彼らの目の前で夕べのうちに出て行け。"},{"ref":"Ezek.12.5","start":26012005,"end":26012005,"break":"none","ruby":[[4,1,"かれ"],[7,1,"め"],[9,1,"まえ"],[11,1,"かべ"],[13,1,"あな"],[22,1,"で"],[24,1,"い"]],"text":"すなわち彼らの目の前で壁に穴をあけ、そこから出て行け。"},{"ref":"Ezek.12.6","start":26012006,"end":26012006,"break":"none","ruby":[[4,1,"かれ"],[7,1,"め"],[9,1,"まえ"],[13,2,"にもつ"],[16,1,"かた"],[18,1,"お"],[30,1,"はこ"],[32,1,"だ"],[39,1,"かお"],[45,1,"ち"],[47,1,"み"],[73,1,"いえ"],[75,1,"しめ"]],"text":"あなたは彼らの目の前でその荷物を肩に負い、やみのうちにそれを運び出せ。あなたの顔をおおって地を見るな。わたしはあなたをしるしとなして、イスラエルの家に示すのだ」。"},{"ref":"Ezek.12.7","start":26012007,"end":26012007,"break":"paragraph","ruby":[[7,1,"めい"],[17,2,"ほしゅう"],[20,2,"にもつ"],[26,2,"にもつ"],[29,1,"ひる"],[34,1,"も"],[36,1,"だ"],[39,1,"ゆう"],[47,1,"て"],[49,1,"かべ"],[51,1,"あな"],[62,1,"かれ"],[65,1,"め"],[67,1,"まえ"],[73,1,"かた"],[75,1,"お"],[78,1,"はこ"],[80,1,"だ"]],"text":"そこでわたしは命じられたようにし、捕囚の荷物のような荷物を昼のうちに持ち出し、夕べにはわたしの手で壁に穴をあけ、やみのうちに彼らの目の前で、これを肩に負って運び出した。"},{"ref":"Ezek.12.8","start":26012008,"end":26012008,"break":"paragraph","ruby":[[0,1,"つぎ"],[2,1,"あさ"],[4,1,"しゅ"],[6,2,"ことば"],[13,1,"のぞ"]],"text":"次の朝、主の言葉がわたしに臨んだ、"},{"ref":"Ezek.12.9","start":26012009,"end":26012009,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[6,2,"はんぎゃく"],[9,1,"いえ"],[19,1,"いえ"],[26,1,"む"],[32,1,"なに"],[42,1,"い"]],"text":"「人の子よ、反逆の家であるイスラエルの家は、あなたに向かって、『何をしているのか』と言わなかったか。"},{"ref":"Ezek.12.10","start":26012010,"end":26012010,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[14,1,"しゅ"],[17,1,"かみ"],[21,1,"い"],[28,2,"たくせん"],[37,1,"きみ"],[44,1,"なか"],[54,2,"ぜんか"]],"text":"あなたは彼らに言いなさい、『主なる神はこう言われる、この託宣はエルサレムの君、およびその中にあるイスラエルの全家にかかわるものである』と。"},{"ref":"Ezek.12.11","start":26012011,"end":26012011,"break":"none","ruby":[[2,1,"い"],[36,1,"かれ"],[43,1,"かれ"],[53,1,"うつ"]],"text":"また言いなさい、『わたしはあなたがたのしるしである。わたしがしたとおりに彼らもされる。彼らはとりこにされて移される』と。"},{"ref":"Ezek.12.12","start":26012012,"end":26012012,"break":"none","ruby":[[0,1,"かれ"],[6,1,"きみ"],[17,2,"にもつ"],[20,1,"かた"],[22,1,"の"],[25,1,"で"],[27,1,"い"],[30,1,"かれ"],[32,1,"かべ"],[34,1,"あな"],[44,1,"で"],[46,1,"い"],[49,1,"かれ"],[51,1,"かお"],[58,2,"じぶん"],[61,1,"め"],[65,1,"ち"],[67,1,"み"]],"text":"彼らのうちの君は、やみのうちにその荷物を肩に載せて出て行く。彼は壁に穴をあけて、そこから出て行く。彼は顔をおおって、自分の目でこの地を見ない。"},{"ref":"Ezek.12.13","start":26012013,"end":26012013,"break":"none","ruby":[[8,1,"あみ"],[10,1,"かれ"],[12,1,"うえ"],[14,1,"う"],[20,1,"かれ"],[37,1,"かれ"],[46,1,"ち"],[53,1,"ひ"],[56,1,"い"],[62,1,"かれ"],[67,1,"み"],[75,1,"し"]],"text":"わたしはわたしの網を彼の上に打ちかける。彼はわたしのわなにかかる。わたしは彼をカルデヤびとの地のバビロンに引いて行く。しかし彼はそれを見ないで、そこで死ぬであろう。"},{"ref":"Ezek.12.14","start":26012014,"end":26012014,"break":"none","ruby":[[5,1,"かれ"],[7,2,"しゅうい"],[12,1,"かれ"],[14,1,"たす"],[17,1,"もの"],[21,1,"かれ"],[23,2,"ぐんたい"],[31,2,"しほう"],[34,1,"ち"],[42,1,"ぬ"],[50,1,"お"]],"text":"またすべて彼の周囲にいて彼を助ける者および彼の軍隊を、わたしは四方に散らし、つるぎを抜いてそのあとを追う。"},{"ref":"Ezek.12.15","start":26012015,"end":26012015,"break":"none","ruby":[[4,1,"かれ"],[7,1,"しょ"],[8,2,"こくみん"],[11,1,"なか"],[13,1,"ち"],[17,2,"くにぐに"],[22,1,"ち"],[28,1,"かれ"],[35,1,"しゅ"],[42,1,"し"]],"text":"わたしが彼らを諸国民の中に散らし、国々にまき散らすとき、彼らはわたしが主であることを知る。"},{"ref":"Ezek.12.16","start":26012016,"end":26012016,"break":"none","ruby":[[8,1,"かれ"],[19,1,"もの"],[21,1,"のこ"],[35,2,"えきびょう"],[38,1,"まぬか"],[43,1,"かれ"],[56,1,"にく"],[64,1,"かれ"],[67,1,"ゆ"],[69,1,"くに"],[73,1,"なか"],[75,2,"こくはく"],[85,1,"かれ"],[92,1,"しゅ"],[99,1,"し"]],"text":"ただし、わたしは彼らのうちに、わずかの者を残して、つるぎと、ききんと、疫病を免れさせ、彼らがおこなったもろもろの憎むべきことを、彼らが行く国びとの中に告白させよう。そして彼らはわたしが主であることを知るようになる」。"},{"ref":"Ezek.12.17","start":26012017,"end":26012017,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"]],"text":"主の言葉がまたわたしに臨んだ、"},{"ref":"Ezek.12.18","start":26012018,"end":26012018,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[6,1,"ふる"],[16,1,"た"],[24,1,"おそ"],[31,1,"みず"],[33,1,"の"]],"text":"「人の子よ、震えてあなたのパンを食べ、おののきと恐れとをもって水を飲め。"},{"ref":"Ezek.12.19","start":26012019,"end":26012019,"break":"none","ruby":[[5,1,"ち"],[7,1,"たみ"],[12,1,"い"],[15,1,"しゅ"],[18,1,"かみ"],[26,1,"ち"],[34,1,"たみ"],[41,1,"い"],[46,1,"かれ"],[49,1,"おそ"],[60,1,"た"],[63,1,"おどろ"],[71,1,"みず"],[73,1,"の"],[86,1,"ち"],[94,1,"なか"],[96,1,"す"],[98,1,"もの"],[100,2,"ぼうぎゃく"],[106,1,"おとろ"],[109,1,"あ"],[111,1,"ち"]],"text":"そしてこの地の民について言え、主なる神はイスラエルの地のエルサレムの民についてこう言われる、彼らは恐れをもってそのパンを食べ、驚きをもってその水を飲むようになる。これはその地が、すべてその中に住む者の暴虐のために衰え、荒れ地となるからである。"},{"ref":"Ezek.12.20","start":26012020,"end":26012020,"break":"none","ruby":[[0,1,"ひと"],[2,1,"す"],[7,2,"まちまち"],[10,1,"あ"],[15,1,"ち"],[17,2,"あらつか"],[37,1,"しゅ"],[44,1,"し"]],"text":"人の住んでいた町々は荒れはて、地は荒塚となる。そしてあなたがたは、わたしが主であることを知るようになる」。"},{"ref":"Ezek.12.21","start":26012021,"end":26012021,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.12.22","start":26012022,"end":26012022,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[12,1,"ち"],[25,1,"ひ"],[27,1,"の"],[34,1,"まぼろし"]],"text":"「人の子よ、イスラエルの地について、あなたがたが『日は延び、すべての幻はむなしくなった』という、このことわざはなんであるか。"},{"ref":"Ezek.12.23","start":26012023,"end":26012023,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[12,1,"しゅ"],[15,1,"かみ"],[19,1,"い"],[40,1,"かれ"],[43,1,"ふたた"],[79,1,"かれ"],[82,1,"い"],[86,1,"ひ"],[92,1,"まぼろし"],[94,1,"み"],[95,1,"げん"],[98,1,"ちか"]],"text":"それゆえ、彼らに言え、『主なる神はこう言われる、わたしはこのことわざをやめさせ、彼らが再びイスラエルで、これをことわざとしないようにする』と。しかし、あなたは彼らに言え、『日とすべての幻の実現とは近づいた』と。"},{"ref":"Ezek.12.24","start":26012024,"end":26012024,"break":"none","ruby":[[6,1,"いえ"],[20,1,"まぼろし"],[23,1,"いつわ"],[26,1,"うらな"]],"text":"イスラエルの家のうちには、もはやむなしい幻も、偽りの占いもなくなる。"},{"ref":"Ezek.12.25","start":26012025,"end":26012025,"break":"none","ruby":[[3,1,"しゅ"],[13,1,"かた"],[20,1,"かた"],[26,1,"かなら"],[28,2,"じょうじゅ"],[33,1,"けっ"],[36,1,"の"],[48,2,"はんぎゃく"],[51,1,"いえ"],[58,1,"ひ"],[67,1,"かた"],[73,2,"じょうじゅ"],[79,1,"しゅ"],[82,1,"かみ"],[84,1,"い"]],"text":"しかし主なるわたしは、わが語るべきことを語り、それは必ず成就する。決して延びることはない。ああ、反逆の家よ、あなたの日にわたしはこれを語り、これを成就すると、主なる神は言われる」。"},{"ref":"Ezek.12.26","start":26012026,"end":26012026,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"]],"text":"主の言葉がまたわたしに臨んだ、"},{"ref":"Ezek.12.27","start":26012027,"end":26012027,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[6,1,"み"],[15,1,"いえ"],[17,1,"い"],[21,1,"かれ"],[23,1,"み"],[25,1,"まぼろし"],[30,1,"おお"],[33,1,"ひ"],[35,1,"のち"],[37,1,"こと"],[42,1,"かれ"],[44,2,"よげん"],[51,1,"とお"],[53,1,"のち"],[55,1,"とき"]],"text":"「人の子よ、見よ、イスラエルの家は言う、『彼の見る幻は、なお多くの日の後の事である。彼が預言することは遠い後の時のことである』と。"},{"ref":"Ezek.12.28","start":26012028,"end":26012028,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[11,1,"しゅ"],[14,1,"かみ"],[18,1,"い"],[27,2,"ことば"],[33,1,"の"],[42,1,"かた"],[44,2,"ことば"],[47,2,"じょうじゅ"],[53,1,"しゅ"],[56,1,"かみ"],[58,1,"い"]],"text":"それゆえ、彼らに言え、主なる神はこう言われる、わたしの言葉はもはや延びない。わたしの語る言葉は成就すると、主なる神は言われる」。"}]