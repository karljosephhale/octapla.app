[{"ref":"Judg.5.1","start":7005001,"end":7005001,"break":"paragraph","ruby":[[2,1,"ひ"],[13,1,"こ"],[18,1,"うた"],[21,1,"い"]],"text":"その日デボラとアビノアムの子バラクは歌って言った。"},{"ref":"Judg.5.2","start":7005002,"end":7005002,"break":"stanza","breaks":[[18,"line"],[30,"line"]],"ruby":[[7,3,"しどうしゃ"],[13,1,"さき"],[15,1,"た"],[18,1,"たみ"],[20,1,"よろこ"],[22,1,"いさ"],[25,1,"すす"],[27,1,"で"],[30,1,"しゅ"]],"text":"「イスラエルの指導者たちは先に立ち、民は喜び勇んで進み出た。主をさんびせよ。"},{"ref":"Judg.5.3","start":7005003,"end":7005003,"break":"line","breaks":[[10,"line"],[24,"line"],[38,"line"]],"ruby":[[5,1,"おう"],[7,1,"き"],[15,1,"きみ"],[18,1,"みみ"],[20,1,"かたむ"],[28,1,"しゅ"],[30,1,"む"],[34,1,"うた"],[48,1,"かみ"],[50,1,"しゅ"]],"text":"もろもろの王よ聞け、もろもろの君よ、耳を傾けよ。わたしは主に向かって歌おう、わたしはイスラエルの神、主をほめたたえよう。"},{"ref":"Judg.5.4","start":7005004,"end":7005004,"break":"line","breaks":[[13,"line"],[27,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"で"],[17,1,"ち"],[20,1,"すす"],[27,1,"ち"],[29,1,"ふる"],[32,1,"てん"],[39,1,"くも"],[41,1,"みず"]],"text":"主よ、あなたがセイルを出、エドムの地から進まれたとき、地は震い、天はしたたり、雲は水をしたたらせた。"},{"ref":"Judg.5.5","start":7005005,"end":7005005,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"やま"],[7,1,"しゅ"],[9,1,"まえ"],[11,1,"ゆ"],[13,1,"うご"],[20,1,"しゅ"],[32,1,"かみ"],[34,1,"しゅ"],[36,1,"まえ"],[38,1,"ゆ"],[40,1,"うご"]],"text":"もろもろの山は主の前に揺り動き、シナイの主、すなわちイスラエルの神、主の前に揺り動いた。"},{"ref":"Judg.5.6","start":7005006,"end":7005006,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[4,1,"こ"],[18,1,"とき"],[21,2,"たいしょう"],[24,1,"た"],[27,2,"たびびと"],[32,1,"みち"]],"text":"アナテの子シャムガルのとき、ヤエルの時には隊商は絶え、旅人はわき道をとおった。"},{"ref":"Judg.5.7","start":7005007,"end":7005007,"break":"line","breaks":[[13,"line"],[24,"line"],[42,"line"]],"ruby":[[7,2,"のうみん"],[10,1,"た"],[17,1,"た"],[19,1,"は"],[36,1,"た"],[42,1,"た"],[51,1,"はは"]],"text":"イスラエルには農民が絶え、かれらは絶え果てたが、デボラよ、ついにあなたは立ちあがり、立ってイスラエルの母となった。"},{"ref":"Judg.5.8","start":7005008,"end":7005008,"break":"line","breaks":[[15,"line"],[24,"line"],[38,"line"]],"ruby":[[0,2,"ひとびと"],[3,1,"あたら"],[6,2,"かみがみ"],[9,1,"えら"],[15,1,"たたか"],[18,1,"もん"],[20,1,"およ"],[32,1,"にん"],[38,1,"たて"],[43,1,"やり"],[45,1,"み"]],"text":"人々が新しい神々を選んだとき、戦いは門に及んだ。イスラエルの四万人のうちに、盾あるいは槍の見られたことがあったか。"},{"ref":"Judg.5.9","start":7005009,"end":7005009,"break":"line","breaks":[[16,"line"],[37,"line"]],"ruby":[[4,1,"こころ"],[6,1,"たみ"],[11,1,"よろこ"],[13,1,"いさ"],[16,1,"すす"],[18,1,"で"],[32,1,"とも"],[37,1,"しゅ"]],"text":"わたしの心は民のうちの喜び勇んで進み出たイスラエルのつかさたちと共にある。主をさんびせよ。"},{"ref":"Judg.5.10","start":7005010,"end":7005010,"break":"line","breaks":[[11,"line"],[22,"line"]],"ruby":[[0,2,"ちゃいろ"],[6,1,"の"],[11,2,"もうせん"],[14,1,"うえ"],[25,1,"みち"],[27,1,"あゆ"],[33,1,"とも"],[35,1,"うた"]],"text":"茶色のろばに乗るもの、毛氈の上にすわるもの、および道を歩むものよ、共に歌え。"},{"ref":"Judg.5.11","start":7005011,"end":7005011,"break":"line","breaks":[[15,"line"],[29,"line"],[46,"line"]],"ruby":[[0,2,"がくじん"],[3,1,"しら"],[6,1,"みず"],[9,1,"ところ"],[11,1,"きこ"],[22,1,"しゅ"],[24,1,"すくい"],[26,1,"とな"],[35,2,"のうみん"],[38,1,"すくい"],[40,1,"とな"],[48,1,"とき"],[50,1,"しゅ"],[52,1,"たみ"],[54,1,"もん"],[56,1,"くだ"],[59,1,"い"]],"text":"楽人の調べは水くむ所に聞える。かれらはそこで主の救を唱え、イスラエルの農民の救を唱えている。その時、主の民は門に下って行った。"},{"ref":"Judg.5.12","start":7005012,"end":7005012,"break":"line","breaks":[[12,"line"],[26,"line"],[42,"line"]],"ruby":[[0,1,"お"],[4,1,"お"],[12,1,"お"],[16,1,"お"],[20,1,"うた"],[26,1,"た"],[38,1,"とら"],[48,1,"こ"]],"text":"起きよ、起きよ、デボラ。起きよ、起きよ、歌をうたえ。立てよ、バラク、とりこを捕えよ、アビノアムの子よ。"},{"ref":"Judg.5.13","start":7005013,"end":7005013,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"とき"],[4,1,"のこ"],[7,1,"もの"],[9,1,"たっと"],[11,1,"もの"],[16,1,"くだ"],[19,1,"い"],[22,1,"しゅ"],[24,1,"たみ"],[26,2,"ゆうし"],[32,1,"くだ"],[35,1,"い"]],"text":"その時、残った者は尊い者のように下って行き、主の民は勇士のように下って行った。"},{"ref":"Judg.5.14","start":7005014,"end":7005014,"break":"line","breaks":[[17,"line"],[37,"line"],[55,"line"]],"ruby":[[0,1,"かれ"],[10,1,"で"],[12,1,"たに"],[14,1,"すす"],[17,2,"きょうだい"],[29,1,"たみ"],[49,1,"くだ"],[52,1,"い"],[62,2,"しき"],[65,1,"と"],[70,1,"くだ"],[73,1,"い"]],"text":"彼らはエフライムから出て谷に進み、兄弟ベニヤミンはあなたの民のうちにある。マキルからはつかさたちが下って行き、ゼブルンからは指揮を執るものが下って行った。"},{"ref":"Judg.5.15","start":7005015,"end":7005015,"break":"line","breaks":[[19,"line"],[33,"line"],[51,"line"]],"ruby":[[6,1,"きみ"],[14,1,"とも"],[29,1,"おな"],[33,1,"ただ"],[44,1,"たに"],[46,2,"とっしん"],[58,2,"しぞく"],[61,1,"おお"],[64,2,"しあん"]],"text":"イッサカルの君たちはデボラと共におり、イッサカルはバラクと同じく、直ちにそのあとについて谷に突進した。しかしルベンの氏族は大いに思案した。"},{"ref":"Judg.5.16","start":7005016,"end":7005016,"break":"line","breaks":[[19,"line"],[37,"line"]],"ruby":[[11,1,"あいだ"],[19,1,"ひつじ"],[21,1,"む"],[24,1,"ふえ"],[25,1,"ふ"],[29,1,"き"],[41,2,"しぞく"],[44,1,"おお"],[47,2,"しあん"]],"text":"なぜ、あなたは、おりの間にとどまって、羊の群れに笛吹くのを聞いているのか。ルベンの氏族は大いに思案した。"},{"ref":"Judg.5.17","start":7005017,"end":7005017,"break":"line","breaks":[[22,"line"],[42,"line"],[52,"line"]],"ruby":[[10,1,"む"],[28,1,"ふね"],[46,1,"はま"],[49,1,"ざ"],[54,3,"はとば"]],"text":"ギレアデはヨルダンの向こうにとどまっていた。なぜ、ダンは舟のかたわらにとどまったか。アセルは浜べに座し、その波止場のかたわらにとどまっていた。"},{"ref":"Judg.5.18","start":7005018,"end":7005018,"break":"line","breaks":[[21,"line"]],"ruby":[[5,1,"いのち"],[11,1,"し"],[13,1,"おそ"],[16,1,"たみ"],[21,1,"の"],[23,1,"たか"],[25,1,"ところ"]],"text":"ゼブルンは命をすてて、死を恐れぬ民である。野の高い所におるナフタリもまたそうであった。"},{"ref":"Judg.5.19","start":7005019,"end":7005019,"break":"line","breaks":[[15,"line"],[27,"line"],[46,"line"]],"ruby":[[5,1,"おう"],[11,1,"たたか"],[17,1,"とき"],[22,1,"おう"],[31,1,"みず"],[42,1,"たたか"],[46,1,"かれ"],[49,2,"いっぺん"],[52,1,"ぎん"],[55,1,"え"]],"text":"もろもろの王たちはきて戦った。その時カナンの王たちは、メギドの水のほとりのタアナクで戦った。彼らは一片の銀をも獲なかった。"},{"ref":"Judg.5.20","start":7005020,"end":7005020,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"ほし"],[7,1,"てん"],[10,1,"たたか"],[15,2,"きどう"],[26,1,"たたか"]],"text":"もろもろの星は天より戦い、その軌道をはなれてシセラと戦った。"},{"ref":"Judg.5.21","start":7005021,"end":7005021,"break":"line","breaks":[[16,"line"],[31,"line"]],"ruby":[[5,1,"かわ"],[7,1,"かれ"],[10,1,"お"],[12,1,"なが"],[16,1,"はげ"],[19,1,"なが"],[22,1,"かわ"],[29,1,"かわ"],[33,1,"たましい"],[36,1,"いさ"],[40,1,"すす"]],"text":"キションの川は彼らを押し流した、激しく流れる川、キションの川。わが魂よ、勇ましく進め。"},{"ref":"Judg.5.22","start":7005022,"end":7005022,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"とき"],[4,2,"ぐんば"],[9,1,"か"],[13,1,"うま"],[19,1,"ち"],[21,1,"ふ"]],"text":"その時、軍馬ははせ駆けり、馬のひずめは地を踏みならした。"},{"ref":"Judg.5.23","start":7005023,"end":7005023,"break":"line","breaks":[[17,"line"],[28,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,1,"い"],[17,1,"はげ"],[22,1,"たみ"],[28,1,"かれ"],[33,1,"しゅ"],[35,1,"たす"],[39,1,"しゅ"],[41,1,"たす"],[44,2,"ゆうし"],[47,1,"せ"]],"text":"主の使は言った、『メロズをのろえ、激しくその民をのろえ、彼らはきて主を助けず、主を助けて勇士を攻めなかったからである』。"},{"ref":"Judg.5.24","start":7005024,"end":7005024,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[8,1,"つま"],[14,1,"おんな"],[19,1,"もっと"],[21,1,"めぐ"],[25,1,"もの"],[27,2,"てんまく"],[30,1,"す"],[32,1,"おんな"],[36,1,"もっと"],[38,1,"めぐ"],[42,1,"もの"]],"text":"ケニびとヘベルの妻ヤエルは、女のうちの最も恵まれた者、天幕に住む女のうち最も恵まれた者である。"},{"ref":"Judg.5.25","start":7005025,"end":7005025,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"みず"],[6,1,"もと"],[15,1,"ちち"],[17,1,"あた"],[25,2,"きちょう"],[28,1,"はち"],[30,2,"ぎょうにゅう"],[33,1,"も"]],"text":"シセラが水を求めると、ヤエルは乳を与えた。すなわち貴重な鉢に凝乳を盛ってささげた。"},{"ref":"Judg.5.26","start":7005026,"end":7005026,"break":"line","breaks":[[12,"line"],[23,"line"],[37,"line"]],"ruby":[[7,1,"て"],[12,2,"みぎて"],[15,1,"おも"],[17,1,"つち"],[27,1,"う"],[32,1,"あたま"],[34,1,"くだ"],[37,2,"こなごな"],[50,1,"う"],[52,1,"つらぬ"]],"text":"ヤエルはくぎに手をかけ、右手に重い槌をとって、シセラを打ち、その頭を砕き、粉々にして、そのこめかみを打ち貫いた。"},{"ref":"Judg.5.27","start":7005027,"end":7005027,"break":"line","breaks":[[21,"line"],[34,"line"]],"ruby":[[8,1,"あし"],[16,1,"たお"],[18,1,"ふ"],[23,1,"あし"],[31,1,"たお"],[40,1,"ところ"],[42,1,"たお"],[45,1,"し"]],"text":"シセラはヤエルの足もとにかがんで倒れ伏し、その足もとにかがんで倒れ、そのかがんだ所に倒れて死んだ。"},{"ref":"Judg.5.28","start":7005028,"end":7005028,"break":"line","breaks":[[13,"line"],[25,"line"],[44,"line"]],"ruby":[[4,1,"はは"],[6,1,"まど"],[13,2,"こうし"],[15,1,"まど"],[18,1,"さけ"],[21,1,"い"],[30,1,"かれ"],[32,1,"くるま"],[34,1,"く"],[48,1,"かれ"],[50,1,"くるま"],[52,1,"あゆ"]],"text":"シセラの母は窓からながめ、格子窓から叫んで言った、『どうして彼の車の来るのがおそいのか、どうして彼の車の歩みがはかどらないのか』。"},{"ref":"Judg.5.29","start":7005029,"end":7005029,"break":"line","breaks":[[14,"line"]],"ruby":[[2,2,"じじょ"],[7,1,"かしこ"],[9,1,"もの"],[11,1,"こた"],[14,1,"はは"],[25,1,"こた"],[28,1,"い"]],"text":"その侍女たちの賢い者は答え、母またみずからおのれに答えて言った、"},{"ref":"Judg.5.30","start":7005030,"end":7005030,"break":"line","breaks":[[10,"line"],[25,"line"],[44,"line"],[57,"line"],[76,"line"],[95,"line"]],"ruby":[[1,1,"かれ"],[4,2,"えもの"],[7,1,"え"],[13,1,"わ"],[25,1,"ひと"],[41,1,"と"],[48,2,"えもの"],[51,1,"いろ"],[52,1,"ぞ"],[55,1,"ころも"],[57,1,"ぬ"],[59,1,"と"],[63,1,"いろ"],[64,1,"ぞ"],[67,1,"ころも"],[69,2,"えもの"],[80,1,"ぬ"],[82,1,"と"],[86,1,"いろ"],[87,1,"ぞ"],[90,1,"ころも"],[95,2,"えもの"]],"text":"『彼らは獲物を得て、それを分けているのではないか、人ごとにひとり、ふたりのおなごを取り、シセラの獲物は色染めの衣、縫い取りした色染めの衣の獲物であろう。すなわち縫い取りした色染めの衣二つを、獲物としてそのくびにまとうであろう』。"},{"ref":"Judg.5.31","start":7005031,"end":7005031,"break":"line","breaks":[[19,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"てき"],[16,1,"ほろ"],[23,1,"あい"],[26,1,"もの"],[28,2,"たいよう"],[31,1,"いきお"],[35,1,"のぼ"],[52,1,"のち"],[54,1,"くに"],[58,1,"ねん"],[63,2,"たいへい"]],"text":"主よ、あなたの敵はみなこのように滅び、あなたを愛する者を太陽の勢いよく上るようにしてください」。こうして後、国は四十年のあいだ太平であった。"}]