[{"ref":"Ezek.26.1","start":26026001,"end":26026001,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"ねん"],[5,1,"だい"],[7,1,"にち"],[9,1,"しゅ"],[11,2,"ことば"],[18,1,"のぞ"]],"text":"第十一年の第一日に主の言葉がわたしに臨んだ、"},{"ref":"Ezek.26.2","start":26026002,"end":26026002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[18,1,"い"],[31,2,"きみ"],[42,1,"たみ"],[44,1,"もん"],[46,1,"やぶ"],[54,1,"ひら"],[63,1,"ゆた"],[69,1,"かれ"],[71,1,"やぶ"]],"text":"「人の子よ、ツロはエルサレムについて言った、『ああ、それはよい気味である。もろもろの民の門は破れて、わたしに開かれた。わたしは豊かになり、彼は破れはてた』と。"},{"ref":"Ezek.26.3","start":26026003,"end":26026003,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[29,1,"せ"],[32,1,"うみ"],[36,1,"なみ"],[38,1,"おこ"],[48,1,"おお"],[51,2,"こくみん"],[59,1,"せ"]],"text":"それゆえ、主なる神はこう言われる、ツロよ、わたしはあなたを攻め、海がその波を起すように、わたしは多くの国民を、あなたに攻めこさせる。"},{"ref":"Ezek.26.4","start":26026004,"end":26026004,"break":"none","ruby":[[0,1,"かれ"],[6,2,"じょうへき"],[19,1,"たお"],[28,1,"つち"],[30,1,"はら"],[32,1,"さ"],[36,1,"はだか"],[38,1,"いわ"]],"text":"彼らはツロの城壁をこわし、そのやぐらを倒す。わたしはその土を払い去って、裸の岩にする。"},{"ref":"Ezek.26.5","start":26026005,"end":26026005,"break":"none","ruby":[[3,1,"うみ"],[5,1,"なか"],[11,1,"あみ"],[15,2,"ばしょ"],[28,1,"い"],[37,1,"しゅ"],[40,1,"かみ"],[42,1,"い"],[56,1,"たみ"]],"text":"ツロは海の中にあって、網をはる場所になる。これはわたしが言ったのであると、主なる神は言われる。ツロは、もろもろの民にかすめられ、"},{"ref":"Ezek.26.6","start":26026006,"end":26026006,"break":"none","ruby":[[2,2,"ほんど"],[7,1,"むすめ"],[16,1,"ころ"],[24,1,"かれ"],[32,1,"しゅ"],[39,1,"し"]],"text":"その本土におる娘たちは、つるぎで殺される。そして彼らは、わたしが主であることを知るようになる。"},{"ref":"Ezek.26.7","start":26026007,"end":26026007,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[12,1,"み"],[19,1,"おう"],[21,1,"おう"],[29,1,"おう"],[39,1,"うま"],[41,2,"せんしゃ"],[44,2,"きへい"],[50,1,"おお"],[53,2,"ぐんぜい"],[61,1,"きた"],[67,1,"せ"]],"text":"主なる神はこう言われる、見よ、わたしは王の王なるバビロンの王ネブカデレザルに、馬、戦車、騎兵、および多くの軍勢をひきいて、北からツロに攻めこさせる。"},{"ref":"Ezek.26.8","start":26026008,"end":26026008,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ほんど"],[11,1,"むすめ"],[20,1,"ころ"],[27,1,"む"],[31,2,"うんてい"],[34,1,"た"],[37,1,"るい"],[39,1,"きず"],[42,1,"たて"],[44,1,"そな"]],"text":"彼は本土におるあなたの娘たちを、つるぎで殺し、あなたに向かって雲悌を建て、塁を築き、盾を備え、"},{"ref":"Ezek.26.9","start":26026009,"end":26026009,"break":"none","ruby":[[0,1,"しろ"],[9,2,"じょうへき"],[12,1,"む"],[26,1,"う"],[28,1,"くだ"]],"text":"城くずしをあなたの城壁に向け、おのであなたのやぐらを打ち砕く。"},{"ref":"Ezek.26.10","start":26026010,"end":26026010,"break":"none","ruby":[[2,1,"おお"],[5,1,"うま"],[7,2,"つちけむり"],[19,1,"ひと"],[21,1,"やぶ"],[24,1,"まち"],[33,1,"かれ"],[39,1,"もん"],[44,1,"とき"],[46,2,"きへい"],[49,2,"かしゃ"],[52,2,"せんしゃ"],[55,1,"ひび"],[66,1,"いし"]],"text":"その多くの馬の土煙は、あなたをおおう。人が破れた町にはいるように、彼があなたの門にはいる時、騎兵と貨車と戦車の響きによって、あなたの石がきはゆるぐ。"},{"ref":"Ezek.26.11","start":26026011,"end":26026011,"break":"none","ruby":[[0,1,"かれ"],[4,1,"うま"],[23,1,"ふ"],[37,1,"たみ"],[39,1,"ころ"],[46,2,"ちからづよ"],[49,1,"はしら"],[51,1,"ち"],[53,1,"たお"]],"text":"彼はその馬のひずめで、あなたのすべてのちまたを踏みあらし、つるぎであなたの民を殺す。あなたの力強い柱は地に倒れる。"},{"ref":"Ezek.26.12","start":26026012,"end":26026012,"break":"none","ruby":[[0,1,"かれ"],[7,2,"ざいほう"],[10,1,"うば"],[13,2,"しょうひん"],[20,2,"じょうへき"],[27,1,"たの"],[30,1,"いえ"],[36,1,"いし"],[38,1,"き"],[40,1,"つち"],[43,1,"みず"],[45,1,"なか"],[47,1,"な"],[49,1,"こ"]],"text":"彼らはあなたの財宝を奪い、商品をかすめ、城壁をくずし、楽しい家をこわし、石と木と土とを水の中に投げ込む。"},{"ref":"Ezek.26.13","start":26026013,"end":26026013,"break":"none","ruby":[[8,1,"うた"],[10,1,"こえ"],[17,1,"こと"],[19,1,"ね"],[24,1,"きこ"]],"text":"わたしはあなたの歌の声をとどめる。琴の音はもはや聞えなくなる。"},{"ref":"Ezek.26.14","start":26026014,"end":26026014,"break":"none","ruby":[[8,1,"はだか"],[10,1,"いわ"],[19,1,"あみ"],[21,1,"は"],[23,2,"ばしょ"],[29,1,"ふたた"],[31,1,"た"],[42,1,"しゅ"],[52,1,"い"],[57,1,"しゅ"],[60,1,"かみ"],[62,1,"い"]],"text":"わたしはあなたを裸の岩にする。あなたは網を張る場所となり、再び建てられることはない。主なるわたしがこれを言ったと、主なる神は言われる。"},{"ref":"Ezek.26.15","start":26026015,"end":26026015,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[10,1,"い"],[15,2,"うみぞ"],[19,2,"くにぐに"],[26,1,"たお"],[29,1,"ひび"],[32,2,"てお"],[47,2,"さつじん"],[54,2,"みぶる"]],"text":"主なる神はツロにこう言われる、海沿いの国々はあなたの倒れる響き、手負いのうめき、あなたのうちの殺人のゆえに、身震いしないであろうか。"},{"ref":"Ezek.26.16","start":26026016,"end":26026016,"break":"none","ruby":[[2,1,"とき"],[4,1,"うみ"],[6,1,"きみ"],[10,1,"みな"],[13,1,"くらい"],[19,1,"あさ"],[20,1,"ふく"],[22,1,"ぬ"],[25,1,"ぬ"],[27,1,"と"],[30,2,"いふく"],[33,1,"と"],[35,1,"さ"],[38,1,"おそ"],[41,1,"み"],[47,1,"ち"],[49,1,"ざ"],[56,1,"おそ"],[63,1,"こと"],[65,1,"おどろ"]],"text":"その時、海の君たちは皆その位からおり、朝服を脱ぎ、縫い取りの衣服を取り去り、恐れを身にまとい、地に座して、いたく恐れ、あなたの事を驚き、"},{"ref":"Ezek.26.17","start":26026017,"end":26026017,"break":"none","breaks":[[19,"stanza"],[37,"line"],[59,"line"]],"ruby":[[7,1,"かな"],[11,1,"うた"],[16,1,"い"],[24,1,"うみ"],[30,1,"つよ"],[32,1,"ほまれ"],[35,1,"まち"],[37,2,"ほんど"],[40,1,"おそ"],[43,1,"あた"],[55,2,"じゅうみん"],[59,1,"うみ"],[62,1,"き"],[64,1,"さ"]],"text":"あなたのために悲しみの歌をのべて言う、『あなたは海にあって、強い誉ある町、本土に恐れを与えていたあなたも、その住民も、海から消え去った。"},{"ref":"Ezek.26.18","start":26026018,"end":26026018,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"しまじま"],[7,1,"たお"],[10,1,"ひ"],[12,2,"みぶる"],[18,1,"うみ"],[20,2,"しまじま"],[27,1,"さ"],[29,1,"い"],[34,1,"み"],[36,1,"おどろ"]],"text":"島々はあなたの倒れる日に身震いする。海の島々はあなたの去り行くことを見て驚く』。"},{"ref":"Ezek.26.19","start":26026019,"end":26026019,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[21,1,"あ"],[24,1,"まち"],[29,1,"す"],[31,1,"もの"],[35,1,"まち"],[42,1,"ふち"],[48,1,"む"],[59,2,"おおみず"],[71,1,"とき"]],"text":"主なる神はこう言われる、わたしはあなたを、荒れた町となし、住む者のない町のようにし、淵をあなたに向かってわきあがらせ、大水にあなたをおおわせる時、"},{"ref":"Ezek.26.20","start":26026020,"end":26026020,"break":"none","ruby":[[4,1,"あな"],[6,1,"くだ"],[8,1,"もの"],[12,1,"とも"],[15,1,"むかし"],[17,1,"たみ"],[19,1,"ところ"],[21,1,"くだ"],[24,1,"あな"],[26,1,"くだ"],[28,1,"もの"],[30,1,"とも"],[32,1,"した"],[34,1,"くに"],[37,1,"むかし"],[42,1,"あ"],[44,1,"あと"],[46,1,"なか"],[53,1,"す"],[67,1,"ひと"],[69,1,"す"],[71,1,"ところ"],[79,1,"なま"],[82,1,"もの"],[84,1,"ち"],[86,1,"ところ"],[88,1,"え"]],"text":"あなたを穴に下る者どもと共に、昔の民の所に下し、穴に下る者と共に下の国に、昔のままの荒れ跡の中に、あなたを住ませる。それゆえ、あなたは人の住む所とならず、また生ある者の地に所を得ない。"},{"ref":"Ezek.26.21","start":26026021,"end":26026021,"break":"none","ruby":[[8,1,"おわ"],[12,1,"おそ"],[26,1,"む"],[28,1,"き"],[36,1,"たず"],[39,1,"ひと"],[46,2,"えいきゅう"],[49,1,"み"],[57,1,"しゅ"],[60,1,"かみ"],[62,1,"い"]],"text":"わたしはあなたの終りを、恐るべきものとする。あなたは無に帰する。あなたを尋ねる人があっても、永久に見いださないと、主なる神は言われる」。"}]