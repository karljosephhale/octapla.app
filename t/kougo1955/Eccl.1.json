[{"ref":"Eccl.1.1","start":21001001,"end":21001001,"break":"paragraph","ruby":[[4,1,"こ"],[12,1,"おう"],[16,3,"でんどうしゃ"],[20,2,"ことば"]],"text":"ダビデの子、エルサレムの王である伝道者の言葉。"},{"ref":"Eccl.1.2","start":21001002,"end":21001002,"break":"paragraph","breaks":[[7,"line"]],"ruby":[[0,3,"でんどうしゃ"],[4,1,"い"],[7,1,"くう"],[9,1,"くう"],[11,1,"くう"],[13,1,"くう"],[20,1,"くう"]],"text":"伝道者は言う、空の空、空の空、いっさいは空である。"},{"ref":"Eccl.1.3","start":21001003,"end":21001003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ひ"],[2,1,"した"],[4,1,"ひと"],[6,1,"ろう"],[13,2,"ろうく"],[19,1,"み"],[24,1,"えき"]],"text":"日の下で人が労するすべての労苦は、その身になんの益があるか。"},{"ref":"Eccl.1.4","start":21001004,"end":21001004,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"よ"],[2,1,"さ"],[5,1,"よ"],[14,1,"ち"],[16,2,"えいえん"],[19,1,"かわ"]],"text":"世は去り、世はきたる。しかし地は永遠に変らない。"},{"ref":"Eccl.1.5","start":21001005,"end":21001005,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"ひ"],[5,1,"ひ"],[7,1,"ぼっ"],[12,1,"で"],[14,1,"ところ"],[16,1,"いそ"],[18,1,"い"]],"text":"日はいで、日は没し、その出た所に急ぎ行く。"},{"ref":"Eccl.1.6","start":21001006,"end":21001006,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かぜ"],[2,1,"みなみ"],[4,1,"ふ"],[9,1,"てん"],[13,1,"きた"],[15,1,"む"],[35,1,"ところ"],[37,1,"かえ"]],"text":"風は南に吹き、また転じて、北に向かい、めぐりにめぐって、またそのめぐる所に帰る。"},{"ref":"Eccl.1.7","start":21001007,"end":21001007,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"かわ"],[5,1,"うみ"],[7,1,"なが"],[9,1,"い"],[15,1,"うみ"],[17,1,"み"],[26,1,"かわ"],[30,1,"で"],[34,1,"ところ"],[38,1,"かえ"],[41,1,"い"]],"text":"川はみな、海に流れ入る、しかし海は満ちることがない。川はその出てきた所にまた帰って行く。"},{"ref":"Eccl.1.8","start":21001008,"end":21001008,"break":"line","breaks":[[16,"line"],[34,"line"],[50,"line"]],"ruby":[[4,1,"こと"],[6,1,"ひと"],[10,1,"つか"],[16,1,"ひと"],[21,1,"い"],[34,1,"め"],[36,1,"み"],[41,1,"あ"],[50,1,"みみ"],[52,1,"き"],[57,2,"まんぞく"]],"text":"すべての事は人をうみ疲れさせる、人はこれを言いつくすことができない。目は見ることに飽きることがなく、耳は聞くことに満足することがない。"},{"ref":"Eccl.1.9","start":21001009,"end":21001009,"break":"line","breaks":[[17,"line"],[36,"line"]],"ruby":[[0,1,"さき"],[11,1,"のち"],[17,1,"さき"],[23,1,"こと"],[28,1,"のち"],[36,1,"ひ"],[38,1,"した"],[41,1,"あたら"]],"text":"先にあったことは、また後にもある、先になされた事は、また後にもなされる。日の下には新しいものはない。"},{"ref":"Eccl.1.10","start":21001010,"end":21001010,"break":"line","breaks":[[15,"line"],[26,"line"],[43,"line"]],"ruby":[[1,1,"み"],[7,1,"あたら"],[15,1,"い"],[34,1,"まえ"],[39,2,"よよ"]],"text":"「見よ、これは新しいものだ」と言われるものがあるか、それはわれわれの前にあった世々に、すでにあったものである。"},{"ref":"Eccl.1.11","start":21001011,"end":21001011,"break":"line","breaks":[[18,"line"],[34,"line"]],"ruby":[[0,1,"まえ"],[2,1,"もの"],[7,1,"おぼ"],[26,1,"のち"],[28,1,"もの"],[34,1,"のち"],[36,1,"おこ"],[38,1,"もの"],[43,1,"おぼ"]],"text":"前の者のことは覚えられることがない、また、きたるべき後の者のことも、後に起る者はこれを覚えることがない。"},{"ref":"Eccl.1.12","start":21001012,"end":21001012,"break":"paragraph","ruby":[[0,3,"でんどうしゃ"],[23,1,"おう"]],"text":"伝道者であるわたしはエルサレムで、イスラエルの王であった。"},{"ref":"Eccl.1.13","start":21001013,"end":21001013,"break":"none","ruby":[[4,1,"こころ"],[10,2,"ちえ"],[13,1,"もち"],[17,1,"あめ"],[19,1,"した"],[21,1,"おこな"],[32,1,"たず"],[37,1,"しら"],[44,1,"かみ"],[47,1,"ひと"],[49,1,"こ"],[52,1,"あた"],[64,1,"くる"],[67,2,"しごと"]],"text":"わたしは心をつくし、知恵を用いて、天が下に行われるすべてのことを尋ね、また調べた。これは神が、人の子らに与えて、ほねおらせられる苦しい仕事である。"},{"ref":"Eccl.1.14","start":21001014,"end":21001014,"break":"none","ruby":[[4,1,"ひ"],[6,1,"した"],[8,1,"ひと"],[10,1,"おこな"],[19,1,"み"],[25,1,"くう"],[30,1,"かぜ"],[32,1,"とら"]],"text":"わたしは日の下で人が行うすべてのわざを見たが、みな空であって風を捕えるようである。"},{"ref":"Eccl.1.15","start":21001015,"end":21001015,"break":"stanza","breaks":[[22,"line"]],"ruby":[[0,1,"まが"],[22,1,"か"],[28,1,"かぞ"]],"text":"曲ったものは、まっすぐにすることができない、欠けたものは数えることができない。"},{"ref":"Eccl.1.16","start":21001016,"end":21001016,"break":"paragraph","ruby":[[4,1,"こころ"],[6,1,"なか"],[8,1,"かた"],[11,1,"い"],[26,1,"さき"],[34,1,"おさ"],[41,1,"もの"],[48,1,"おお"],[51,2,"ちえ"],[54,1,"え"],[61,1,"こころ"],[63,2,"ちえ"],[66,2,"ちしき"],[69,1,"おお"],[71,1,"え"]],"text":"わたしは心の中に語って言った、「わたしは、わたしより先にエルサレムを治めたすべての者にまさって、多くの知恵を得た。わたしの心は知恵と知識を多く得た」。"},{"ref":"Eccl.1.17","start":21001017,"end":21001017,"break":"none","ruby":[[4,1,"こころ"],[10,2,"ちえ"],[13,1,"し"],[18,2,"きょうき"],[21,2,"ぐち"],[25,1,"し"],[38,1,"かぜ"],[40,1,"とら"],[52,1,"さと"]],"text":"わたしは心をつくして知恵を知り、また狂気と愚痴とを知ろうとしたが、これもまた風を捕えるようなものであると悟った。"},{"ref":"Eccl.1.18","start":21001018,"end":21001018,"break":"stanza","breaks":[[16,"line"]],"ruby":[[3,2,"ちえ"],[6,1,"おお"],[10,1,"なや"],[13,1,"おお"],[16,2,"ちしき"],[19,1,"ま"],[21,1,"もの"],[23,1,"うれ"],[26,1,"ま"]],"text":"それは知恵が多ければ悩みが多く、知識を増す者は憂いを増すからである。"}]