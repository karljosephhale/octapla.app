[{"ref":"Phil.4.1","start":50004001,"end":50004001,"break":"paragraph","ruby":[[8,1,"あい"],[10,1,"した"],[15,2,"きょうだい"],[25,1,"よろこ"],[30,1,"かんむり"],[34,1,"あい"],[37,1,"もの"],[48,1,"しゅ"],[53,1,"かた"],[55,1,"た"]],"text":"だから、わたしの愛し慕っている兄弟たちよ。わたしの喜びであり冠である愛する者たちよ。このように、主にあって堅く立ちなさい。"},{"ref":"Phil.4.2","start":50004002,"end":50004002,"break":"paragraph","ruby":[[10,1,"すす"],[20,1,"すす"],[28,1,"しゅ"],[35,1,"おも"]],"text":"わたしはユウオデヤに勧め、またスントケに勧める。どうか、主にあって一つ思いになってほしい。"},{"ref":"Phil.4.3","start":50004003,"end":50004003,"break":"none","ruby":[[5,2,"しんじつ"],[8,3,"きょうりょくしゃ"],[18,1,"ねが"],[29,1,"おんな"],[31,1,"たす"],[40,1,"かれ"],[49,1,"しょ"],[52,1,"な"],[54,1,"か"],[72,1,"た"],[74,3,"どうろうしゃ"],[80,2,"きょうりょく"],[85,2,"ふくいん"],[95,1,"とも"],[97,1,"たたか"],[103,1,"おんな"]],"text":"ついては、真実な協力者よ。あなたにお願いする。このふたりの女を助けてあげなさい。彼らは、「いのちの書」に名を書きとめられているクレメンスや、その他の同労者たちと協力して、福音のためにわたしと共に戦ってくれた女たちである。"},{"ref":"Phil.4.4","start":50004004,"end":50004004,"break":"paragraph","ruby":[[7,1,"しゅ"],[15,1,"よろこ"],[21,1,"く"],[23,1,"かえ"],[26,1,"い"],[30,1,"よろこ"]],"text":"あなたがたは、主にあっていつも喜びなさい。繰り返して言うが、喜びなさい。"},{"ref":"Phil.4.5","start":50004005,"end":50004005,"break":"none","ruby":[[6,2,"かんよう"],[14,1,"ひと"],[16,1,"しめ"],[22,1,"しゅ"],[24,1,"ちか"]],"text":"あなたがたの寛容を、みんなの人に示しなさい。主は近い。"},{"ref":"Phil.4.6","start":50004006,"end":50004006,"break":"none","ruby":[[0,2,"なにごと"],[3,1,"おも"],[5,1,"わずら"],[17,1,"こと"],[22,2,"かんしゃ"],[28,1,"いのり"],[30,1,"ねが"],[44,1,"もと"],[51,1,"かみ"],[53,1,"もう"],[55,1,"あ"]],"text":"何事も思い煩ってはならない。ただ、事ごとに、感謝をもって祈と願いとをささげ、あなたがたの求めるところを神に申し上げるがよい。"},{"ref":"Phil.4.7","start":50004007,"end":50004007,"break":"none","ruby":[[6,2,"じんち"],[14,1,"はか"],[16,1,"し"],[25,1,"かみ"],[27,2,"へいあん"],[37,1,"こころ"],[39,1,"おも"],[56,1,"まも"]],"text":"そうすれば、人知ではとうてい測り知ることのできない神の平安が、あなたがたの心と思いとを、キリスト・イエスにあって守るであろう。"},{"ref":"Phil.4.8","start":50004008,"end":50004008,"break":"paragraph","ruby":[[0,2,"さいご"],[4,2,"きょうだい"],[13,2,"しんじつ"],[22,1,"たっと"],[32,1,"ただ"],[41,2,"じゅんしん"],[50,1,"あい"],[70,1,"とく"],[79,2,"しょうさん"],[82,1,"あたい"],[99,1,"こころ"]],"text":"最後に、兄弟たちよ。すべて真実なこと、すべて尊ぶべきこと、すべて正しいこと、すべて純真なこと、すべて愛すべきこと、すべてほまれあること、また徳といわれるもの、称賛に値するものがあれば、それらのものを心にとめなさい。"},{"ref":"Phil.4.9","start":50004009,"end":50004009,"break":"none","ruby":[[12,1,"まな"],[18,1,"う"],[24,1,"き"],[30,1,"み"],[39,2,"じっこう"],[52,2,"へいわ"],[55,1,"かみ"],[64,1,"とも"]],"text":"あなたがたが、わたしから学んだこと、受けたこと、聞いたこと、見たことは、これを実行しなさい。そうすれば、平和の神が、あなたがたと共にいますであろう。"},{"ref":"Phil.4.10","start":50004010,"end":50004010,"break":"paragraph","ruby":[[7,1,"しゅ"],[12,1,"おお"],[15,1,"よろこ"],[27,1,"おも"],[29,1,"こころ"],[38,1,"いま"],[44,1,"め"],[56,1,"じつ"],[73,1,"こころ"],[88,2,"きかい"]],"text":"さて、わたしが主にあって大いに喜んでいるのは、わたしを思う心が、あなたがたに今またついに芽ばえてきたことである。実は、あなたがたは、わたしのことを心にかけてくれてはいたが、よい機会がなかったのである。"},{"ref":"Phil.4.11","start":50004011,"end":50004011,"break":"none","ruby":[[4,1,"とぼ"],[12,1,"い"],[28,2,"きょうぐう"],[36,1,"た"],[41,1,"まな"]],"text":"わたしは乏しいから、こう言うのではない。わたしは、どんな境遇にあっても、足ることを学んだ。"},{"ref":"Phil.4.12","start":50004012,"end":50004012,"break":"none","ruby":[[4,1,"ひん"],[6,1,"しょ"],[9,1,"みち"],[11,1,"し"],[17,1,"とみ"],[21,1,"みち"],[23,1,"し"],[34,1,"あ"],[40,1,"う"],[48,1,"と"],[54,1,"とぼ"],[69,2,"きょうぐう"],[72,1,"しょ"],[75,1,"ひ"],[79,2,"こころえ"]],"text":"わたしは貧に処する道を知っており、富におる道も知っている。わたしは、飽くことにも飢えることにも、富むことにも乏しいことにも、ありとあらゆる境遇に処する秘けつを心得ている。"},{"ref":"Phil.4.13","start":50004013,"end":50004013,"break":"none","ruby":[[4,1,"つよ"],[8,1,"くだ"],[18,2,"なにごと"]],"text":"わたしを強くして下さるかたによって、何事でもすることができる。"},{"ref":"Phil.4.14","start":50004014,"end":50004014,"break":"none","ruby":[[18,2,"かんなん"],[21,1,"とも"]],"text":"しかし、あなたがたは、よくもわたしと患難を共にしてくれた。"},{"ref":"Phil.4.15","start":50004015,"end":50004015,"break":"none","ruby":[[4,1,"ひと"],[15,1,"し"],[28,2,"ふくいん"],[31,2,"せんでん"],[34,1,"はじ"],[47,1,"で"],[51,1,"い"],[54,1,"とき"],[56,1,"もの"],[69,1,"はたら"],[72,2,"さんか"],[76,2,"きょうかい"],[90,1,"まった"],[92,1,"な"]],"text":"ピリピの人たちよ。あなたがたも知っているとおり、わたしが福音を宣伝し始めたころ、マケドニヤから出かけて行った時、物のやりとりをしてわたしの働きに参加した教会は、あなたがたのほかには全く無かった。"},{"ref":"Phil.4.16","start":50004016,"end":50004016,"break":"none","ruby":[[10,2,"いっさい"],[16,1,"もの"],[18,1,"おく"],[25,2,"けつぼう"],[28,1,"おぎな"]],"text":"またテサロニケでも、一再ならず、物を送ってわたしの欠乏を補ってくれた。"},{"ref":"Phil.4.17","start":50004017,"end":50004017,"break":"none","ruby":[[5,1,"おく"],[7,1,"もの"],[9,1,"もと"],[24,1,"もと"],[38,2,"かんじょう"],[47,2,"かじつ"]],"text":"わたしは、贈り物を求めているのではない。わたしの求めているのは、あなたがたの勘定をふやしていく果実なのである。"},{"ref":"Phil.4.18","start":50004018,"end":50004018,"break":"none","ruby":[[9,1,"もの"],[11,1,"う"],[16,1,"あま"],[39,1,"おく"],[41,1,"もの"],[49,1,"あ"],[51,1,"た"],[73,1,"かみ"],[75,1,"よろこ"],[78,1,"う"],[81,1,"くだ"],[84,1,"そな"],[86,1,"もの"]],"text":"わたしは、すべての物を受けてあり余るほどである。エパフロデトから、あなたがたの贈り物をいただいて、飽き足りている。それは、かんばしいかおりであり、神の喜んで受けて下さる供え物である。"},{"ref":"Phil.4.19","start":50004019,"end":50004019,"break":"none","ruby":[[4,1,"かみ"],[8,2,"じしん"],[11,2,"えいこう"],[14,1,"とみ"],[16,1,"なか"],[31,2,"ひつよう"],[47,1,"み"],[51,1,"くだ"]],"text":"わたしの神は、ご自身の栄光の富の中から、あなたがたのいっさいの必要を、キリスト・イエスにあって満たして下さるであろう。"},{"ref":"Phil.4.20","start":50004020,"end":50004020,"break":"none","ruby":[[6,1,"ちち"],[9,1,"かみ"],[12,2,"えいこう"],[15,2,"よよ"],[17,1,"かぎ"]],"text":"わたしたちの父なる神に、栄光が世々限りなくあるように、アァメン。"},{"ref":"Phil.4.21","start":50004021,"end":50004021,"break":"paragraph","ruby":[[11,2,"せいと"],[31,2,"いっしょ"],[36,2,"きょうだい"]],"text":"キリスト・イエスにある聖徒のひとりびとりに、よろしく。わたしと一緒にいる兄弟たちから、あなたがたによろしく。"},{"ref":"Phil.4.22","start":50004022,"end":50004022,"break":"none","ruby":[[4,2,"せいと"],[11,1,"とく"],[18,1,"いえ"],[20,1,"もの"]],"text":"すべての聖徒たちから、特にカイザルの家の者たちから、よろしく。"},{"ref":"Phil.4.23","start":50004023,"end":50004023,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"めぐ"],[20,1,"れい"],[22,1,"とも"]],"text":"主イエス・キリストの恵みが、あなたがたの霊と共にあるように。"}]