[{"ref":"Josh.9.1","start":6009001,"end":6009001,"break":"paragraph","ruby":[[8,2,"にしがわ"],[12,2,"さんち"],[15,2,"へいち"],[28,2,"たいかい"],[31,2,"えんがん"],[34,1,"す"],[41,1,"おう"],[83,1,"おう"],[91,1,"き"]],"text":"さて、ヨルダンの西側の、山地、平地、およびレバノンまでの大海の沿岸に住むもろもろの王たち、すなわちヘテびと、アモリびと、カナンびと、ペリジびと、ヒビびと、エブスびとの王たちは、これを聞いて、"},{"ref":"Josh.9.2","start":6009002,"end":6009002,"break":"none","ruby":[[0,1,"こころ"],[2,1,"あ"],[6,1,"あい"],[7,1,"あつ"],[25,1,"たたか"]],"text":"心を合わせ、相集まって、ヨシュアおよびイスラエルと戦おうとした。"},{"ref":"Josh.9.3","start":6009003,"end":6009003,"break":"paragraph","ruby":[[9,2,"じゅうみん"],[35,1,"き"]],"text":"しかし、ギベオンの住民たちは、ヨシュアがエリコとアイにおこなったことを聞いて、"},{"ref":"Josh.9.4","start":6009004,"end":6009004,"break":"none","ruby":[[0,2,"じぶん"],[5,2,"さくりゃく"],[13,1,"い"],[16,2,"しょくりょう"],[18,1,"ひん"],[20,2,"じゅんび"],[24,1,"ふる"],[27,1,"ふくろ"],[30,1,"ふる"],[33,1,"やぶ"],[38,1,"つくろ"],[44,1,"しゅ"],[46,1,"かわ"],[47,1,"ぶくろ"],[54,1,"お"]],"text":"自分たちも策略をめぐらし、行って食料品を準備し、古びた袋と、古びて破れたのを繕ったぶどう酒の皮袋とを、ろばに負わせ、"},{"ref":"Josh.9.5","start":6009005,"end":6009005,"break":"none","ruby":[[0,1,"つくろ"],[3,1,"ふる"],[7,1,"あし"],[12,1,"ふる"],[15,2,"きもの"],[18,1,"み"],[24,1,"かれ"],[27,2,"しょくりょう"],[41,1,"くだ"]],"text":"繕った古ぐつを足にはき、古びた着物を身につけた。彼らの食料のパンは、みなかわいて、砕けていた。"},{"ref":"Josh.9.6","start":6009006,"end":6009006,"break":"none","ruby":[[0,1,"かれ"],[8,2,"じんえい"],[16,1,"ところ"],[21,1,"かれ"],[29,2,"ひとびと"],[32,1,"い"],[42,1,"とお"],[44,1,"くに"],[57,1,"いま"],[63,2,"けいやく"],[66,1,"むす"]],"text":"彼らはギルガルの陣営のヨシュアの所にきて、彼とイスラエルの人々に言った、「われわれは遠い国からまいりました。それで今われわれと契約を結んでください」。"},{"ref":"Josh.9.7","start":6009007,"end":6009007,"break":"none","ruby":[[10,2,"ひとびと"],[22,1,"い"],[41,1,"す"],[49,1,"し"],[71,2,"けいやく"],[74,1,"むす"]],"text":"しかし、イスラエルの人々はそのヒビびとたちに言った、「あなたがたはわれわれのうちに住んでいるのかも知れないから、われわれはどうしてあなたがたと契約が結べましょう」。"},{"ref":"Josh.9.8","start":6009008,"end":6009008,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[34,1,"かれ"],[37,1,"い"]],"text":"彼らはヨシュアに言った、「われわれはあなたのしもべです」。ヨシュアは彼らに言った、「あなたがたはだれですか。どこからきたのですか」。"},{"ref":"Josh.9.9","start":6009009,"end":6009009,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[23,1,"かみ"],[25,1,"しゅ"],[27,1,"な"],[38,1,"とお"],[40,1,"くに"],[55,1,"しゅ"],[57,2,"めいせい"],[63,1,"しゅ"],[70,1,"おこな"],[78,1,"こと"],[80,1,"き"]],"text":"彼らはヨシュアに言った、「しもべどもはあなたの神、主の名のゆえに、ひじょうに遠い国からまいりました。われわれは主の名声、および主がエジプトで行われたすべての事を聞き、"},{"ref":"Josh.9.10","start":6009010,"end":6009010,"break":"none","ruby":[[2,1,"しゅ"],[9,1,"む"],[12,1,"がわ"],[26,1,"おう"],[37,1,"おう"],[59,1,"おう"],[63,1,"おこな"],[74,1,"き"]],"text":"また主がヨルダンの向こう側にいたアモリびとのふたりの王、すなわちヘシボンの王シホン、およびアシタロテにおったバシャンの王オグに行われたすべてのことを聞いたからです。"},{"ref":"Josh.9.11","start":6009011,"end":6009011,"break":"none","ruby":[[9,2,"ちょうろう"],[17,1,"くに"],[19,2,"じゅうみん"],[29,1,"い"],[42,2,"たびじ"],[45,2,"しょくりょう"],[48,1,"て"],[50,1,"たずさ"],[57,1,"かれ"],[60,1,"あ"],[63,1,"い"],[90,1,"いま"],[96,2,"けいやく"],[99,1,"むす"]],"text":"それで、われわれの長老たち、および国の住民はみなわれわれに言いました、『おまえたちは旅路の食料を手に携えていって、彼らに会って言いなさい、「われわれはあなたがたのしもべです。それで今われわれと契約を結んでください」』。"},{"ref":"Josh.9.12","start":6009012,"end":6009012,"break":"none","ruby":[[17,1,"ところ"],[19,1,"く"],[29,2,"しゅったつ"],[33,1,"ひ"],[40,1,"いえ"],[53,1,"たび"],[55,2,"しょくりょう"],[60,2,"じゅんび"],[69,1,"いま"],[77,1,"くだ"]],"text":"ここにあるこのパンは、あなたがたの所に来るため、われわれが出立する日に、おのおの家から、まだあたたかなのを旅の食料として準備したのですが、今はもうかわいて砕けています。"},{"ref":"Josh.9.13","start":6009013,"end":6009013,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"み"],[15,1,"かわ"],[16,1,"ぶくろ"],[19,1,"あたら"],[29,1,"やぶ"],[42,2,"きもの"],[50,2,"たびじ"],[58,1,"なが"],[65,1,"ふる"]],"text":"またぶどう酒を満たしたこれらの皮袋も、新しかったのですが、破れました。われわれのこの着物も、くつも、旅路がひじょうに長かったので、古びてしまいました」。"},{"ref":"Josh.9.14","start":6009014,"end":6009014,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"かれ"],[15,2,"しょくりょう"],[17,1,"ひん"],[19,1,"とも"],[21,1,"た"],[24,1,"しゅ"],[30,1,"もと"]],"text":"そこでイスラエルの人々は彼らの食料品を共に食べ、主のさしずを求めようとはしなかった。"},{"ref":"Josh.9.15","start":6009015,"end":6009015,"break":"none","ruby":[[8,1,"かれ"],[11,1,"わ"],[13,1,"こう"],[16,2,"けいやく"],[19,1,"むす"],[23,1,"かれ"],[26,1,"い"],[34,2,"かいしゅう"],[37,1,"ちょう"],[41,1,"かれ"],[44,1,"ちか"],[47,1,"た"]],"text":"そしてヨシュアは彼らと和を講じ、契約を結んで、彼らを生かしておいた。会衆の長たちは彼らに誓いを立てた。"},{"ref":"Josh.9.16","start":6009016,"end":6009016,"break":"paragraph","ruby":[[0,2,"けいやく"],[3,1,"むす"],[7,1,"か"],[9,1,"のち"],[12,1,"かれ"],[17,2,"ひとびと"],[20,1,"ちか"],[23,2,"ひとびと"],[27,2,"じぶん"],[35,1,"す"],[46,1,"き"]],"text":"契約を結んで三日の後に、彼らはその人々が近くの人々で、自分たちのうちに住んでいるということを聞いた。"},{"ref":"Josh.9.17","start":6009017,"end":6009017,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"すす"],[14,1,"か"],[15,1,"め"],[19,2,"まちまち"],[22,1,"つ"],[28,2,"まちまち"]],"text":"イスラエルの人々は進んで、三日目にその町々に着いた。その町々とは、ギベオン、ケピラ、ベエロテおよびキリアテ・ヤリムであった。"},{"ref":"Josh.9.18","start":6009018,"end":6009018,"break":"none","ruby":[[4,2,"かいしゅう"],[7,1,"ちょう"],[21,1,"かみ"],[23,1,"しゅ"],[28,1,"かれ"],[31,1,"ちか"],[34,1,"た"],[48,2,"ひとびと"],[51,1,"かれ"],[54,1,"ころ"],[64,2,"かいしゅう"],[70,1,"ちょう"]],"text":"ところで会衆の長たちが、すでにイスラエルの神、主をさして彼らに誓いを立てていたので、イスラエルの人々は彼らを殺さなかった。そこで会衆はみな、長たちにむかってつぶやいた。"},{"ref":"Josh.9.19","start":6009019,"end":6009019,"break":"none","ruby":[[4,1,"ちょう"],[8,1,"みな"],[10,1,"ぜん"],[11,2,"かいしゅう"],[14,1,"い"],[30,1,"かみ"],[32,1,"しゅ"],[37,1,"かれ"],[40,1,"ちか"],[48,1,"いま"],[50,1,"かれ"],[53,1,"ふ"]],"text":"しかし、長たちは皆、全会衆に言った、「われわれはイスラエルの神、主をさして彼らに誓った。それゆえ今、彼らに触れてはならない。"},{"ref":"Josh.9.20","start":6009020,"end":6009020,"break":"none","ruby":[[10,1,"かれ"],[13,1,"い"],[32,1,"かれ"],[35,1,"た"],[38,1,"ちか"],[45,1,"いか"],[53,1,"のぞ"]],"text":"われわれは、こうして彼らを生かしておこう。そうすれば、われわれが彼らに立てた誓いのゆえに、怒りがわれわれに臨むことはないであろう」。"},{"ref":"Josh.9.21","start":6009021,"end":6009021,"break":"none","ruby":[[0,1,"ちょう"],[6,2,"ひとびと"],[10,1,"かれ"],[13,1,"い"],[22,1,"い"],[28,1,"かれ"],[35,1,"ぜん"],[36,2,"かいしゅう"],[47,1,"き"],[50,1,"みず"],[61,1,"ちょう"],[65,1,"かれ"],[68,1,"い"]],"text":"長たちはまた人々に「彼らを生かしておこう」と言ったので、彼らはついに、全会衆のために、たきぎを切り、水をくむものとなった。長たちが彼らに言ったとおりである。"},{"ref":"Josh.9.22","start":6009022,"end":6009022,"break":"paragraph","ruby":[[5,1,"かれ"],[8,1,"よ"],[10,1,"よ"],[13,1,"い"],[33,1,"す"],[55,1,"とお"],[57,1,"はな"],[64,1,"い"]],"text":"ヨシュアは彼らを呼び寄せて言った、「あなたがたは、われわれのうちに住みながら、なぜ『われわれはあなたがたからは遠く離れている』と言って、われわれをだましたのか。"},{"ref":"Josh.9.23","start":6009023,"end":6009023,"break":"none","ruby":[[9,1,"いま"],[15,2,"どれい"],[25,1,"かみ"],[27,1,"いえ"],[37,1,"き"],[40,1,"みず"],[48,1,"た"],[61,1,"で"]],"text":"それであなたがたは今のろわれ、奴隷となってわたしの神の家のために、たきぎを切り、水をくむものが、絶えずあなたがたのうちから出るであろう」。"},{"ref":"Josh.9.24","start":6009024,"end":6009024,"break":"none","ruby":[[0,1,"かれ"],[8,1,"こた"],[11,1,"い"],[20,1,"かみ"],[22,1,"しゅ"],[36,1,"ち"],[49,1,"あた"],[54,1,"ち"],[56,1,"す"],[58,1,"たみ"],[71,1,"まえ"],[74,1,"ほろ"],[77,1,"さ"],[85,1,"めい"],[101,1,"あき"],[105,1,"つた"],[107,1,"き"],[125,1,"いのち"],[127,1,"あやう"],[136,2,"ひじょう"],[139,1,"おそ"]],"text":"彼らはヨシュアに答えて言った、「あなたの神、主がそのしもべモーセに、この地をことごとくあなたがたに与え、この地に住む民をことごとくあなたがたの前から滅ぼし去るようにと、お命じになったことを、しもべどもは明らかに伝え聞きましたので、あなたがたのゆえに、命が危いと、われわれは非常に恐れて、このことをしたのです。"},{"ref":"Josh.9.25","start":6009025,"end":6009025,"break":"none","ruby":[[6,1,"いま"],[12,1,"て"],[33,1,"よ"],[36,1,"おも"],[39,1,"ただ"],[43,1,"おも"]],"text":"われわれは、今、あなたの手のうちにあります。われわれにあなたがして良いと思い、正しいと思うことをしてください」。"},{"ref":"Josh.9.26","start":6009026,"end":6009026,"break":"none","ruby":[[9,1,"かれ"],[19,1,"かれ"],[28,2,"ひとびと"],[31,1,"て"],[34,1,"すく"],[37,1,"ころ"]],"text":"そこでヨシュアは、彼らにそのようにし、彼らをイスラエルの人々の手から救って殺させなかった。"},{"ref":"Josh.9.27","start":6009027,"end":6009027,"break":"none","ruby":[[12,1,"ひ"],[14,1,"かれ"],[18,2,"かいしゅう"],[26,1,"しゅ"],[28,2,"さいだん"],[34,1,"しゅ"],[36,1,"えら"],[40,2,"ばしょ"],[48,1,"き"],[51,1,"みず"],[55,1,"もの"],[63,2,"こんにち"]],"text":"しかし、ヨシュアは、その日、彼らを、会衆のため、また主の祭壇のため、主が選ばれる場所で、たきぎを切り、水をくむ者とした。これは今日までつづいている。"}]