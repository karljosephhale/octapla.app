[{"ref":"Isa.21.1","start":23021001,"end":23021001,"break":"paragraph","breaks":[[12,"stanza"],[30,"line"]],"ruby":[[0,1,"うみ"],[2,2,"あらの"],[9,2,"たくせん"],[15,1,"かぜ"],[21,1,"ふ"],[23,1,"す"],[30,2,"あらの"],[35,1,"おそ"],[39,1,"ち"],[43,1,"く"]],"text":"海の荒野についての託宣。つむじ風がネゲブを吹き過ぎるように、荒野から、恐るべき地から、来るものがある。"},{"ref":"Isa.21.2","start":23021002,"end":23021002,"break":"line","breaks":[[18,"line"],[31,"line"],[40,"line"],[57,"line"]],"ruby":[[11,1,"まぼろし"],[13,1,"しめ"],[21,1,"うば"],[23,1,"もの"],[28,1,"うば"],[31,1,"ほろ"],[34,1,"もの"],[36,1,"ほろ"],[54,1,"かこ"],[65,1,"なげ"]],"text":"わたしは一つのきびしい幻を示された。かすめ奪う者はかすめ奪い、滅ぼす者は滅ぼす。エラムよ、のぼれ、メデアよ、囲め。わたしはすべての嘆きをやめさせる。"},{"ref":"Isa.21.3","start":23021003,"end":23021003,"break":"line","breaks":[[20,"line"],[38,"line"],[46,"line"],[64,"line"]],"ruby":[[7,1,"こし"],[9,1,"はげ"],[12,1,"いた"],[15,1,"み"],[20,2,"しゅっさん"],[23,1,"のぞ"],[25,1,"おんな"],[27,1,"くる"],[34,1,"くる"],[42,1,"とら"],[55,1,"き"],[64,1,"おそ"],[71,1,"み"]],"text":"それゆえ、わが腰は激しい痛みに満たされ、出産に臨む女の苦しみのような苦しみがわたしを捕えた。わたしは、かがんで聞くことができず、恐れおののいて見ることができない。"},{"ref":"Isa.21.4","start":23021004,"end":23021004,"break":"line","breaks":[[10,"line"],[27,"line"],[41,"line"]],"ruby":[[2,1,"こころ"],[7,1,"まど"],[14,1,"おそ"],[41,1,"かわ"]],"text":"わが心はみだれ惑い、わななき恐れること、はなはだしく、わたしのあこがれたたそがれは変っておののきとなった。"},{"ref":"Isa.21.5","start":23021005,"end":23021005,"break":"line","breaks":[[9,"line"],[25,"line"]],"ruby":[[0,1,"かれ"],[3,2,"しょくたく"],[6,1,"もう"],[15,1,"し"],[18,1,"く"],[20,1,"の"],[30,1,"きみ"],[33,1,"た"],[37,1,"たて"],[39,1,"あぶら"]],"text":"彼らは食卓を設け、じゅうたんを敷いて食い飲みする。もろもろの君よ、立って、盾に油をぬれ。"},{"ref":"Isa.21.6","start":23021006,"end":23021006,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"い"],[14,1,"い"],[18,2,"みはり"],[28,1,"み"],[34,1,"つ"]],"text":"主はわたしにこう言われた、「行って、見張びとをおき、その見るところを告げさせよ。"},{"ref":"Isa.21.7","start":23021007,"end":23021007,"break":"line","breaks":[[23,"line"],[41,"line"]],"ruby":[[0,1,"うま"],[2,1,"の"],[6,1,"れつ"],[8,1,"なら"],[11,1,"もの"],[17,1,"の"],[20,1,"もの"],[27,1,"の"],[30,1,"もの"],[33,1,"かれ"],[35,1,"み"],[41,1,"みみ"],[43,1,"かたむ"],[52,1,"き"]],"text":"馬に乗って二列に並んだ者と、ろばに乗った者と、らくだに乗った者とを彼が見るならば、耳を傾けてつまびらかに聞かせよ」。"},{"ref":"Isa.21.8","start":23021008,"end":23021008,"break":"line","breaks":[[18,"line"],[37,"line"]],"ruby":[[2,1,"とき"],[4,2,"みはり"],[9,1,"よ"],[14,1,"い"],[19,1,"しゅ"],[34,1,"た"],[37,1,"よ"],[44,2,"みはり"],[46,1,"じょ"],[48,1,"た"]],"text":"その時、見張びとは呼ばわって言った、「主よ、わたしがひねもすやぐらに立ち、夜もすがらわが見張所に立っていると、"},{"ref":"Isa.21.9","start":23021009,"end":23021009,"break":"line","breaks":[[24,"line"],[33,"line"],[47,"line"],[65,"line"]],"ruby":[[0,1,"み"],[3,1,"うま"],[5,1,"の"],[9,1,"れつ"],[11,1,"なら"],[14,1,"もの"],[19,1,"き"],[24,1,"かれ"],[26,1,"こた"],[29,1,"い"],[34,1,"たお"],[43,1,"たお"],[49,2,"かみがみ"],[52,1,"ぞう"],[59,1,"う"],[61,1,"くだ"],[65,1,"ち"],[67,1,"ふ"]],"text":"見よ、馬に乗って二列に並んだ者がここに来ます」。彼は答えて言った、「倒れた、バビロンは倒れた、その神々の像はことごとく打ち砕かれて地に伏した」。"},{"ref":"Isa.21.10","start":23021010,"end":23021010,"break":"line","breaks":[[23,"line"],[37,"line"],[51,"line"]],"ruby":[[3,1,"ふ"],[12,1,"たみ"],[16,1,"う"],[18,1,"ば"],[20,1,"こ"],[29,1,"かみ"],[31,2,"ばんぐん"],[34,1,"しゅ"],[41,1,"き"],[57,1,"つ"]],"text":"ああ、踏みにじられたわが民、わが打ち場の子よ、イスラエルの神、万軍の主からわたしが聞いたところのものをあなたがたに告げる。"},{"ref":"Isa.21.11","start":23021011,"end":23021011,"break":"paragraph","breaks":[[10,"stanza"],[28,"line"],[46,"line"]],"ruby":[[7,2,"たくせん"],[19,1,"よ"],[23,1,"もの"],[29,2,"よまわ"],[34,1,"いま"],[36,1,"よる"],[46,2,"よまわ"],[51,1,"いま"],[53,1,"よる"]],"text":"ドマについての託宣。セイルからわたしに呼ばわる者がある、「夜回りよ、今は夜のなんどきですか、夜回りよ、今は夜のなんどきですか」。"},{"ref":"Isa.21.12","start":23021012,"end":23021012,"break":"line","breaks":[[7,"line"],[22,"line"],[45,"line"]],"ruby":[[0,2,"よまわ"],[4,1,"い"],[8,1,"あさ"],[14,1,"よる"],[30,1,"き"],[34,1,"おも"],[39,1,"き"],[47,1,"き"]],"text":"夜回りは言う、「朝がきます、夜もまたきます。もしあなたがたが聞こうと思うならば聞きなさい、また来なさい」。"},{"ref":"Isa.21.13","start":23021013,"end":23021013,"break":"paragraph","breaks":[[12,"stanza"],[22,"line"]],"ruby":[[9,2,"たくせん"],[18,2,"たいしょう"],[33,1,"はやし"]],"text":"アラビヤについての託宣。デダンびとの隊商よ、あなたがたはアラビヤの林にやどる。"},{"ref":"Isa.21.14","start":23021014,"end":23021014,"break":"line","breaks":[[10,"line"],[25,"line"]],"ruby":[[3,1,"ち"],[5,1,"す"],[7,1,"たみ"],[10,1,"みず"],[12,1,"たずさ"],[20,1,"もの"],[22,1,"むか"],[32,1,"に"],[38,1,"もの"],[40,1,"むか"]],"text":"テマの地に住む民よ、水を携えて、かわいた者を迎え、パンをもって、逃げのがれた者を迎えよ。"},{"ref":"Isa.21.15","start":23021015,"end":23021015,"break":"line","breaks":[[20,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[7,1,"さ"],[10,1,"ぬ"],[17,1,"さ"],[20,1,"は"],[23,1,"ゆみ"],[25,1,"さ"],[30,1,"はげ"],[33,1,"たたか"],[36,1,"さ"],[40,1,"に"]],"text":"彼らはつるぎを避け、抜いたつるぎを避け、張った弓を避け、また激しい戦いを避けて、逃げてきたからである。"},{"ref":"Isa.21.16","start":23021016,"end":23021016,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[14,2,"やといにん"],[17,2,"ねんき"],[24,1,"ねん"],[25,2,"いない"],[36,2,"えいが"]],"text":"主はわたしにこう言われた、「雇人の年期のように一年以内にケダルのすべての栄華はつきはてる。"},{"ref":"Isa.21.17","start":23021017,"end":23021017,"break":"none","ruby":[[4,1,"こ"],[7,2,"ゆうし"],[11,2,"しゃしゅ"],[14,1,"のこ"],[16,1,"もの"],[18,1,"すく"],[32,1,"かみ"],[34,1,"しゅ"],[36,1,"かた"]],"text":"ケダルの子らの勇士で、射手の残る者は少ない」。これはイスラエルの神、主が語られたのである。"}]