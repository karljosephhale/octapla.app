[{"ref":"Matt.23.1","start":40023001,"end":40023001,"break":"paragraph","ruby":[[9,2,"ぐんしゅう"],[12,2,"でし"],[18,1,"かた"],[21,1,"い"]],"text":"そのときイエスは、群衆と弟子たちとに語って言われた、"},{"ref":"Matt.23.2","start":40023002,"end":40023002,"break":"none","ruby":[[1,2,"りっぽう"],[3,2,"がくしゃ"],[10,1,"びと"],[18,1,"ざ"]],"text":"「律法学者とパリサイ人とは、モーセの座にすわっている。"},{"ref":"Matt.23.3","start":40023003,"end":40023003,"break":"none","ruby":[[4,1,"かれ"],[13,1,"い"],[21,1,"まも"],[24,2,"じっこう"],[35,1,"かれ"],[50,1,"かれ"],[53,1,"い"],[59,2,"じっこう"]],"text":"だから、彼らがあなたがたに言うことは、みな守って実行しなさい。しかし、彼らのすることには、ならうな。彼らは言うだけで、実行しないから。"},{"ref":"Matt.23.4","start":40023004,"end":40023004,"break":"none","ruby":[[3,1,"おも"],[5,2,"にもつ"],[12,2,"ひとびと"],[15,1,"かた"],[25,1,"うご"],[32,2,"じぶん"],[36,1,"ゆび"],[38,1,"ぽん"],[40,1,"か"]],"text":"また、重い荷物をくくって人々の肩にのせるが、それを動かすために、自分では指一本も貸そうとはしない。"},{"ref":"Matt.23.5","start":40023005,"end":40023005,"break":"none","ruby":[[11,1,"ひと"],[13,1,"み"],[27,1,"かれ"],[30,2,"きょうふだ"],[33,2,"はばひろ"],[42,1,"ころも"],[47,1,"おお"]],"text":"そのすることは、すべて人に見せるためである。すなわち、彼らは経札を幅広くつくり、その衣のふさを大きくし、"},{"ref":"Matt.23.6","start":40023006,"end":40023006,"break":"none","ruby":[[3,2,"えんかい"],[6,2,"じょうざ"],[9,2,"かいどう"],[12,2,"じょうせき"],[15,1,"この"]],"text":"また、宴会の上座、会堂の上席を好み、"},{"ref":"Matt.23.7","start":40023007,"end":40023007,"break":"none","ruby":[[0,2,"ひろば"],[14,2,"ひとびと"],[18,2,"せんせい"],[21,1,"よ"],[28,1,"この"]],"text":"広場であいさつされることや、人々から先生と呼ばれることを好んでいる。"},{"ref":"Matt.23.8","start":40023008,"end":40023008,"break":"none","ruby":[[10,2,"せんせい"],[13,1,"よ"],[29,2,"せんせい"],[51,2,"きょうだい"]],"text":"しかし、あなたがたは先生と呼ばれてはならない。あなたがたの先生は、ただひとりであって、あなたがたはみな兄弟なのだから。"},{"ref":"Matt.23.9","start":40023009,"end":40023009,"break":"none","ruby":[[3,2,"ちじょう"],[11,1,"ちち"],[13,1,"よ"],[28,1,"ちち"],[41,1,"てん"],[46,1,"ちち"]],"text":"また、地上のだれをも、父と呼んではならない。あなたがたの父はただひとり、すなわち、天にいます父である。"},{"ref":"Matt.23.10","start":40023010,"end":40023010,"break":"none","ruby":[[9,2,"きょうし"],[12,1,"よ"],[28,2,"きょうし"]],"text":"また、あなたがたは教師と呼ばれてはならない。あなたがたの教師はただひとり、すなわち、キリストである。"},{"ref":"Matt.23.11","start":40023011,"end":40023011,"break":"none","ruby":[[17,1,"えら"],[19,1,"もの"],[22,1,"つか"],[25,1,"ひと"]],"text":"そこで、あなたがたのうちでいちばん偉い者は、仕える人でなければならない。"},{"ref":"Matt.23.12","start":40023012,"end":40023012,"break":"none","ruby":[[4,2,"じぶん"],[7,1,"たか"],[11,1,"もの"],[13,1,"ひく"],[18,2,"じぶん"],[21,1,"ひく"],[25,1,"もの"],[27,1,"たか"]],"text":"だれでも自分を高くする者は低くされ、自分を低くする者は高くされるであろう。"},{"ref":"Matt.23.13","start":40023013,"end":40023013,"break":"paragraph","ruby":[[0,2,"ぎぜん"],[3,2,"りっぽう"],[5,2,"がくしゃ"],[12,1,"びと"],[39,2,"てんごく"],[42,1,"と"],[46,2,"ひとびと"],[56,2,"じぶん"],[73,1,"ひと"]],"text":"偽善な律法学者、パリサイ人たちよ。あなたがたは、わざわいである。あなたがたは、天国を閉ざして人々をはいらせない。自分もはいらないし、はいろうとする人をはいらせもしない。〔"},{"ref":"Matt.23.14","start":40023014,"end":40023014,"break":"none","ruby":[[0,2,"ぎぜん"],[3,2,"りっぽう"],[5,2,"がくしゃ"],[12,1,"びと"],[45,1,"いえ"],[47,1,"く"],[49,1,"たお"],[52,1,"み"],[58,1,"なが"],[60,1,"いのり"],[80,1,"う"],[84,1,"ちが"]],"text":"偽善な律法学者、パリサイ人たちよ。あなたがたは、わざわいである。あなたがたは、やもめたちの家を食い倒し、見えのために長い祈をする。だから、もっときびしいさばきを受けるに違いない。〕"},{"ref":"Matt.23.15","start":40023015,"end":40023015,"break":"none","ruby":[[0,2,"ぎぜん"],[3,2,"りっぽう"],[5,2,"がくしゃ"],[12,1,"びと"],[42,3,"かいしゅうしゃ"],[53,1,"うみ"],[55,1,"りく"],[58,1,"めぐ"],[60,1,"ある"],[74,1,"かれ"],[76,2,"じぶん"],[80,1,"ばい"],[85,2,"じごく"],[88,1,"こ"]],"text":"偽善な律法学者、パリサイ人たちよ。あなたがたは、わざわいである。あなたがたはひとりの改宗者をつくるために、海と陸とを巡り歩く。そして、つくったなら、彼を自分より倍もひどい地獄の子にする。"},{"ref":"Matt.23.16","start":40023016,"end":40023016,"break":"paragraph","ruby":[[0,2,"もうもく"],[3,2,"あんない"],[5,1,"しゃ"],[31,1,"い"],[35,2,"しんでん"],[41,1,"ちか"],[55,2,"しんでん"],[58,2,"こがね"],[64,1,"ちか"],[69,1,"はた"],[71,2,"せきにん"]],"text":"盲目な案内者たちよ。あなたがたは、わざわいである。あなたがたは言う、『神殿をさして誓うなら、そのままでよいが、神殿の黄金をさして誓うなら、果す責任がある』と。"},{"ref":"Matt.23.17","start":40023017,"end":40023017,"break":"none","ruby":[[0,1,"おろ"],[3,2,"もうもく"],[6,1,"ひと"],[11,2,"こがね"],[15,2,"こがね"],[18,2,"しんせい"],[23,2,"しんでん"],[31,2,"だいじ"]],"text":"愚かな盲目な人たちよ。黄金と、黄金を神聖にする神殿と、どちらが大事なのか。"},{"ref":"Matt.23.18","start":40023018,"end":40023018,"break":"none","ruby":[[9,1,"い"],[13,2,"さいだん"],[19,1,"ちか"],[35,1,"うえ"],[37,1,"そな"],[39,1,"もの"],[44,1,"ちか"],[49,1,"はた"],[51,2,"せきにん"]],"text":"また、あなたがたは言う、『祭壇をさして誓うなら、そのままでよいが、その上の供え物をさして誓うなら、果す責任がある』と。"},{"ref":"Matt.23.19","start":40023019,"end":40023019,"break":"none","ruby":[[0,2,"もうもく"],[3,1,"ひと"],[8,1,"そな"],[10,1,"もの"],[12,1,"そな"],[14,1,"もの"],[16,2,"しんせい"],[21,2,"さいだん"],[28,2,"だいじ"]],"text":"盲目な人たちよ。供え物と供え物を神聖にする祭壇とどちらが大事なのか。"},{"ref":"Matt.23.20","start":40023020,"end":40023020,"break":"none","ruby":[[0,2,"さいだん"],[6,1,"ちか"],[8,1,"もの"],[11,2,"さいだん"],[17,1,"うえ"],[25,1,"もの"],[31,1,"ちか"]],"text":"祭壇をさして誓う者は、祭壇と、その上にあるすべての物とをさして誓うのである。"},{"ref":"Matt.23.21","start":40023021,"end":40023021,"break":"none","ruby":[[0,2,"しんでん"],[6,1,"ちか"],[8,1,"もの"],[11,2,"しんでん"],[16,1,"なか"],[18,1,"す"],[32,1,"ちか"]],"text":"神殿をさして誓う者は、神殿とその中に住んでおられるかたとをさして誓うのである。"},{"ref":"Matt.23.22","start":40023022,"end":40023022,"break":"none","ruby":[[3,1,"てん"],[8,1,"ちか"],[10,1,"もの"],[13,1,"かみ"],[15,2,"みざ"],[20,1,"うえ"],[37,1,"ちか"]],"text":"また、天をさして誓う者は、神の御座とその上にすわっておられるかたとをさして誓うのである。"},{"ref":"Matt.23.23","start":40023023,"end":40023023,"break":"paragraph","ruby":[[0,2,"ぎぜん"],[3,2,"りっぽう"],[5,2,"がくしゃ"],[12,1,"びと"],[47,2,"やくみ"],[51,1,"ぶん"],[55,1,"みや"],[57,1,"おさ"],[66,2,"りっぽう"],[69,1,"なか"],[74,2,"じゅうよう"],[78,2,"こうへい"],[86,2,"ちゅうじつ"],[90,1,"み"],[115,1,"み"]],"text":"偽善な律法学者、パリサイ人たちよ。あなたがたは、わざわいである。はっか、いのんど、クミンなどの薬味の十分の一を宮に納めておりながら、律法の中でもっと重要な、公平とあわれみと忠実とを見のがしている。それもしなければならないが、これも見のがしてはならない。"},{"ref":"Matt.23.24","start":40023024,"end":40023024,"break":"none","ruby":[[0,2,"もうもく"],[3,2,"あんない"],[5,1,"しゃ"]],"text":"盲目な案内者たちよ。あなたがたは、ぶよはこしているが、らくだはのみこんでいる。"},{"ref":"Matt.23.25","start":40023025,"end":40023025,"break":"paragraph","ruby":[[0,2,"ぎぜん"],[3,2,"りっぽう"],[5,2,"がくしゃ"],[12,1,"びと"],[32,1,"さかずき"],[34,1,"さら"],[37,2,"そとがわ"],[46,2,"うちがわ"],[49,2,"どんよく"],[52,2,"ほうじゅう"],[56,1,"み"]],"text":"偽善な律法学者、パリサイ人たちよ。あなたがたは、わざわいである。杯と皿との外側はきよめるが、内側は貪欲と放縦とで満ちている。"},{"ref":"Matt.23.26","start":40023026,"end":40023026,"break":"none","ruby":[[0,2,"もうもく"],[7,1,"びと"],[13,1,"さかずき"],[15,2,"うちがわ"],[32,2,"そとがわ"],[35,1,"きよ"]],"text":"盲目なパリサイ人よ。まず、杯の内側をきよめるがよい。そうすれば、外側も清くなるであろう。"},{"ref":"Matt.23.27","start":40023027,"end":40023027,"break":"paragraph","ruby":[[0,2,"ぎぜん"],[3,2,"りっぽう"],[5,2,"がくしゃ"],[12,1,"びと"],[38,1,"しろ"],[40,1,"ぬ"],[43,1,"はか"],[45,1,"に"],[50,2,"そとがわ"],[53,1,"うつく"],[56,1,"み"],[61,2,"うちがわ"],[64,2,"しにん"],[67,1,"ほね"],[74,2,"ふけつ"]],"text":"偽善な律法学者、パリサイ人たちよ。あなたがたは、わざわいである。あなたがたは白く塗った墓に似ている。外側は美しく見えるが、内側は死人の骨や、あらゆる不潔なものでいっぱいである。"},{"ref":"Matt.23.28","start":40023028,"end":40023028,"break":"none","ruby":[[12,2,"そとがわ"],[15,1,"ひと"],[17,1,"ただ"],[20,1,"み"],[25,2,"うちがわ"],[28,2,"ぎぜん"],[31,2,"ふほう"]],"text":"このようにあなたがたも、外側は人に正しく見えるが、内側は偽善と不法とでいっぱいである。"},{"ref":"Matt.23.29","start":40023029,"end":40023029,"break":"paragraph","ruby":[[0,2,"ぎぜん"],[3,2,"りっぽう"],[5,2,"がくしゃ"],[12,1,"びと"],[38,3,"よげんしゃ"],[42,1,"はか"],[44,1,"た"],[47,2,"ぎじん"],[50,1,"ひ"],[52,1,"かざ"],[54,1,"た"],[60,1,"い"]],"text":"偽善な律法学者、パリサイ人たちよ。あなたがたは、わざわいである。あなたがたは預言者の墓を建て、義人の碑を飾り立てて、こう言っている、"},{"ref":"Matt.23.30","start":40023030,"end":40023030,"break":"none","ruby":[[9,2,"せんぞ"],[12,2,"じだい"],[15,1,"い"],[23,3,"よげんしゃ"],[27,1,"ち"],[29,1,"なが"],[34,1,"くわ"]],"text":"『もしわたしたちが先祖の時代に生きていたなら、預言者の血を流すことに加わってはいなかっただろう』と。"},{"ref":"Matt.23.31","start":40023031,"end":40023031,"break":"none","ruby":[[14,3,"よげんしゃ"],[18,1,"ころ"],[21,1,"もの"],[23,2,"しそん"],[32,2,"じぶん"],[35,2,"しょうめい"]],"text":"このようにして、あなたがたは預言者を殺した者の子孫であることを、自分で証明している。"},{"ref":"Matt.23.32","start":40023032,"end":40023032,"break":"none","ruby":[[8,2,"せんぞ"],[15,1,"あく"],[17,2,"ますめ"],[20,1,"み"]],"text":"あなたがたもまた先祖たちがした悪の枡目を満たすがよい。"},{"ref":"Matt.23.33","start":40023033,"end":40023033,"break":"none","ruby":[[8,1,"こ"],[16,2,"じごく"],[19,2,"けいばつ"]],"text":"へびよ、まむしの子らよ、どうして地獄の刑罰をのがれることができようか。"},{"ref":"Matt.23.34","start":40023034,"end":40023034,"break":"none","ruby":[[11,3,"よげんしゃ"],[15,2,"ちしゃ"],[18,2,"りっぽう"],[20,2,"がくしゃ"],[44,1,"もの"],[46,1,"ころ"],[51,3,"じゅうじか"],[62,1,"もの"],[64,2,"かいどう"],[69,1,"う"],[74,1,"まち"],[77,1,"まち"],[80,2,"はくがい"],[84,1,"い"]],"text":"それだから、わたしは、預言者、知者、律法学者たちをあなたがたにつかわすが、そのうちのある者を殺し、また十字架につけ、そのある者を会堂でむち打ち、また町から町へと迫害して行くであろう。"},{"ref":"Matt.23.35","start":40023035,"end":40023035,"break":"none","ruby":[[4,2,"ぎじん"],[10,1,"ち"],[14,2,"せいじょ"],[17,2,"さいだん"],[21,1,"あいだ"],[29,1,"ころ"],[37,1,"こ"],[43,1,"ち"],[45,1,"いた"],[50,2,"ちじょう"],[53,1,"なが"],[57,2,"ぎじん"],[60,1,"ち"],[62,1,"むく"],[77,1,"およ"]],"text":"こうして義人アベルの血から、聖所と祭壇との間であなたがたが殺したバラキヤの子ザカリヤの血に至るまで、地上に流された義人の血の報いが、ことごとくあなたがたに及ぶであろう。"},{"ref":"Matt.23.36","start":40023036,"end":40023036,"break":"none","ruby":[[2,1,"い"],[15,1,"むく"],[21,1,"いま"],[23,2,"じだい"],[26,1,"およ"]],"text":"よく言っておく。これらのことの報いは、みな今の時代に及ぶであろう。"},{"ref":"Matt.23.37","start":40023037,"end":40023037,"break":"paragraph","ruby":[[15,3,"よげんしゃ"],[21,1,"ころ"],[34,1,"ひと"],[38,1,"いし"],[40,1,"う"],[42,1,"ころ"],[44,1,"もの"],[57,1,"つばさ"],[59,1,"した"],[66,1,"あつ"],[81,1,"こ"],[84,1,"いく"],[87,1,"あつ"],[113,1,"おう"]],"text":"ああ、エルサレム、エルサレム、預言者たちを殺し、おまえにつかわされた人たちを石で打ち殺す者よ。ちょうど、めんどりが翼の下にそのひなを集めるように、わたしはおまえの子らを幾たび集めようとしたことであろう。それだのに、おまえたちは応じようとしなかった。"},{"ref":"Matt.23.38","start":40023038,"end":40023038,"break":"none","ruby":[[0,1,"み"],[9,1,"いえ"],[11,2,"みす"]],"text":"見よ、おまえたちの家は見捨てられてしまう。"},{"ref":"Matt.23.39","start":40023039,"end":40023039,"break":"none","breaks":[[10,"stanza"]],"ruby":[[4,1,"い"],[11,1,"しゅ"],[13,2,"みな"],[22,1,"もの"],[25,2,"しゅくふく"],[37,1,"い"],[39,1,"とき"],[44,2,"こんご"],[55,1,"あ"]],"text":"わたしは言っておく、『主の御名によってきたる者に、祝福あれ』とおまえたちが言う時までは、今後ふたたび、わたしに会うことはないであろう」。"}]