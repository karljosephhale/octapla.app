[{"ref":"Joel.3.1","start":29003001,"end":29003001,"break":"paragraph","ruby":[[0,1,"み"],[17,2,"こうふく"],[23,1,"かえ"],[27,1,"ひ"],[31,1,"とき"]],"text":"見よ、わたしがユダとエルサレムとの幸福をもとに返すその日、その時、"},{"ref":"Joel.3.2","start":29003002,"end":29003002,"break":"none","ruby":[[4,2,"ばんこく"],[7,1,"たみ"],[9,1,"あつ"],[22,1,"たに"],[24,1,"たずさ"],[32,1,"ところ"],[36,1,"たみ"],[40,1,"し"],[41,1,"ぎょう"],[54,1,"かれ"],[61,1,"かれ"],[66,1,"たみ"],[68,1,"しょ"],[69,2,"こくみん"],[75,1,"ち"],[84,1,"ち"],[86,1,"わ"],[89,1,"と"]],"text":"わたしは万国の民を集めて、これをヨシャパテの谷に携えくだり、その所でわが民、わが嗣業であるイスラエルのために彼らをさばく。彼らがわが民を諸国民のうちに散らして、わたしの地を分かち取ったからである。"},{"ref":"Joel.3.3","start":29003003,"end":29003003,"break":"none","ruby":[[0,1,"かれ"],[5,1,"たみ"],[9,1,"び"],[14,2,"ゆうじょ"],[20,2,"しょうねん"],[27,1,"さけ"],[32,2,"しょうじょ"],[35,1,"う"],[38,1,"の"]],"text":"彼らはわが民をくじ引きにし、遊女のために少年をわたし、酒のために少女を売って飲んだ。"},{"ref":"Joel.3.4","start":29003004,"end":29003004,"break":"paragraph","ruby":[[17,2,"ちほう"],[54,2,"ほうふく"],[78,2,"ほうふく"],[93,1,"とき"],[117,2,"ほうふく"],[126,2,"ずじょう"]],"text":"ツロとシドンよ、ペリシテのすべての地方よ、おまえたちは、わたしとなんのかかわりがあるか。おまえたちはわたしに報復をしようとするのか。もしおまえたちがわたしに報復しようとするなら、わたしは時をうつさず、すみやかに、おまえたちのおこないの報復をおまえたちの頭上にこさせる。"},{"ref":"Joel.3.5","start":29003005,"end":29003005,"break":"none","ruby":[[13,1,"ぎん"],[15,1,"きん"],[25,2,"きちょう"],[28,1,"たから"],[36,1,"みや"],[38,1,"たずさ"],[40,1,"ゆ"]],"text":"これはおまえたちがわたしの銀と金とをとり、わたしの貴重な宝をおまえたちの宮に携え行き、"},{"ref":"Joel.3.6","start":29003006,"end":29003006,"break":"none","ruby":[[5,2,"ひとびと"],[14,2,"ひとびと"],[25,1,"う"],[31,2,"ほんごく"],[35,1,"とお"],[37,1,"はな"]],"text":"またユダの人々とエルサレムの人々とをギリシヤびとに売って、その本国から遠く離れさせたからである。"},{"ref":"Joel.3.7","start":29003007,"end":29003007,"break":"none","ruby":[[0,1,"み"],[13,1,"う"],[18,1,"ところ"],[21,1,"かれ"],[24,1,"おこ"],[39,2,"ほうふく"],[48,2,"ずじょう"]],"text":"見よ、わたしはおまえたちが売ったその所から彼らを起して、おまえたちのおこないの報復をおまえたちの頭上にこさせる。"},{"ref":"Joel.3.8","start":29003008,"end":29003008,"break":"none","ruby":[[13,1,"むすめ"],[20,2,"ひとびと"],[23,1,"て"],[25,1,"う"],[28,1,"かれ"],[34,1,"とお"],[36,1,"くに"],[47,1,"う"],[51,1,"しゅ"],[53,1,"い"]],"text":"わたしはおまえたちのむすこ娘たちをユダの人々の手に売る。彼らはこれを遠い国びとであるシバびとに売ると、主は言われる」。"},{"ref":"Joel.3.9","start":29003009,"end":29003009,"break":"stanza","breaks":[[16,"line"],[25,"line"],[35,"line"]],"ruby":[[5,2,"くにたみ"],[8,1,"なか"],[10,1,"の"],[12,1,"つた"],[16,1,"たたか"],[19,1,"そな"],[25,2,"ゆうし"],[31,1,"た"],[35,2,"へいし"],[43,1,"ちか"]],"text":"もろもろの国民の中に宣べ伝えよ。戦いの備えをなし、勇士をふるい立たせ、兵士をことごとく近づかせ、のぼらせよ。"},{"ref":"Joel.3.10","start":29003010,"end":29003010,"break":"line","breaks":[[15,"line"],[34,"line"]],"ruby":[[28,1,"う"],[34,1,"よわ"],[36,1,"もの"],[43,2,"ゆうし"],[50,1,"い"]],"text":"あなたがたのすきを、つるぎに、あなたがたのかまを、やりに打ちかえよ。弱い者に「わたしは勇士である」と言わせよ。"},{"ref":"Joel.3.11","start":29003011,"end":29003011,"break":"stanza","breaks":[[11,"line"],[20,"line"]],"ruby":[[0,2,"しゅうい"],[7,2,"くにたみ"],[11,1,"いそ"],[13,1,"き"],[16,1,"あつ"],[20,1,"しゅ"],[27,2,"ゆうし"],[35,1,"くだ"]],"text":"周囲のすべての国民よ、急ぎ来て、集まれ。主よ、あなたの勇士をかしこにお下しください。"},{"ref":"Joel.3.12","start":29003012,"end":29003012,"break":"line","breaks":[[15,"line"],[29,"line"],[40,"line"]],"ruby":[[5,2,"くにたみ"],[11,1,"た"],[21,1,"たに"],[36,1,"ざ"],[40,2,"しゅうい"],[47,2,"くにたみ"]],"text":"もろもろの国民をふるい立たせ、ヨシャパテの谷にのぼらせよ。わたしはそこに座して、周囲のすべての国民をさばく。"},{"ref":"Joel.3.13","start":29003013,"end":29003013,"break":"stanza","breaks":[[14,"line"],[19,"line"],[37,"line"]],"ruby":[[3,1,"い"],[7,2,"さくもつ"],[10,1,"じゅく"],[14,1,"き"],[16,1,"ふ"],[19,1,"さか"],[23,1,"み"],[26,1,"いし"],[37,1,"かれ"],[40,1,"あく"],[42,1,"おお"]],"text":"かまを入れよ、作物は熟した。来て踏め、酒ぶねは満ち、石がめはあふれている。彼らの悪が大きいからだ。"},{"ref":"Joel.3.14","start":29003014,"end":29003014,"break":"stanza","breaks":[[17,"line"]],"ruby":[[0,2,"ぐんしゅう"],[4,2,"ぐんしゅう"],[12,1,"たに"],[17,1,"しゅ"],[19,1,"ひ"],[25,1,"たに"],[27,1,"ちか"]],"text":"群衆また群衆は、さばきの谷におる。主の日がさばきの谷に近いからである。"},{"ref":"Joel.3.15","start":29003015,"end":29003015,"break":"line","ruby":[[0,1,"ひ"],[2,1,"つき"],[4,1,"くら"],[9,1,"ほし"],[13,1,"ひかり"],[15,1,"うしな"]],"text":"日も月も暗くなり、星もその光を失う。"},{"ref":"Joel.3.16","start":29003016,"end":29003016,"break":"stanza","breaks":[[13,"line"],[27,"line"],[37,"line"],[50,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"おおごえ"],[10,1,"さけ"],[20,1,"こえ"],[22,1,"だ"],[27,1,"てん"],[29,1,"ち"],[34,1,"うご"],[40,1,"しゅ"],[44,1,"たみ"],[46,1,"さ"],[48,1,"どころ"],[56,2,"ひとびと"]],"text":"主はシオンから大声で叫び、エルサレムから声を出される。天も地もふるい動く。しかし主はその民の避け所、イスラエルの人々のとりでである。"},{"ref":"Joel.3.17","start":29003017,"end":29003017,"break":"stanza","breaks":[[17,"line"],[35,"line"],[51,"line"],[63,"line"]],"ruby":[[10,1,"し"],[27,1,"かみ"],[29,1,"しゅ"],[37,1,"せい"],[40,1,"やま"],[45,1,"す"],[57,2,"せいじょ"],[63,2,"たこく"],[65,1,"じん"],[67,1,"かさ"],[72,1,"なか"],[74,1,"とお"]],"text":"「そこであなたがたは知るであろう、わたしはあなたがたの神、主であって、わが聖なる山シオンに住むことを。エルサレムは聖所となり、他国人は重ねてその中を通ることがない。"},{"ref":"Joel.3.18","start":29003018,"end":29003018,"break":"stanza","breaks":[[20,"line"],[32,"line"],[46,"line"],[56,"line"]],"ruby":[[2,1,"ひ"],[8,1,"やま"],[13,1,"さけ"],[25,1,"おか"],[27,1,"ちち"],[29,1,"なが"],[39,1,"かわ"],[41,1,"みず"],[43,1,"なが"],[46,1,"いずみ"],[48,1,"しゅ"],[50,1,"いえ"],[53,1,"で"],[61,1,"たに"],[63,1,"うるお"]],"text":"その日もろもろの山にうまい酒がしたたり、もろもろの丘は乳を流し、ユダのすべての川は水を流す。泉は主の家から出て、シッテムの谷を潤す。"},{"ref":"Joel.3.19","start":29003019,"end":29003019,"break":"stanza","breaks":[[22,"line"],[40,"line"]],"ruby":[[5,1,"あ"],[7,1,"ち"],[16,2,"あらの"],[22,1,"かれ"],[27,1,"くに"],[32,2,"ひとびと"],[40,1,"つみ"],[43,1,"もの"],[45,1,"ち"],[47,1,"なが"]],"text":"エジプトは荒れ地となり、エドムは荒野となる。彼らはその国でユダの人々をしえたげ、罪なき者の血を流したからである。"},{"ref":"Joel.3.20","start":29003020,"end":29003020,"break":"line","breaks":[[18,"line"]],"ruby":[[6,2,"えいえん"],[9,1,"ひと"],[11,1,"す"],[13,1,"ところ"],[24,2,"よよ"],[27,1,"たも"]],"text":"しかしユダは永遠に人の住む所となり、エルサレムは世々に保つ。"},{"ref":"Joel.3.21","start":29003021,"end":29003021,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[4,1,"かれ"],[7,1,"ち"],[9,2,"ほうふく"],[19,1,"もの"],[27,1,"しゅ"],[33,1,"す"]],"text":"わたしは彼らに血の報復をなし、とがある者をゆるさない。主はシオンに住まわれる」。"}]