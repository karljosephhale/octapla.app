[{"ref":"Isa.45.1","start":23045001,"end":23045001,"break":"paragraph","breaks":[[13,"line"],[21,"line"],[36,"line"],[48,"line"],[61,"line"],[77,"line"]],"ruby":[[6,3,"じゅこうしゃ"],[13,1,"みぎ"],[15,1,"て"],[26,1,"くに"],[30,1,"まえ"],[32,1,"したが"],[41,1,"おう"],[43,1,"こし"],[45,1,"と"],[54,1,"まえ"],[56,1,"ひら"],[61,1,"もん"],[63,1,"と"],[71,1,"い"],[75,1,"しゅ"],[79,3,"じゅこうしゃ"],[88,1,"い"]],"text":"わたしはわが受膏者クロスの右の手をとって、もろもろの国をその前に従わせ、もろもろの王の腰を解き、とびらをその前に開かせて、門を閉じさせない、と言われる主はその受膏者クロスにこう言われる、"},{"ref":"Isa.45.2","start":23045002,"end":23045002,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[9,1,"まえ"],[11,1,"い"],[20,1,"やま"],[22,1,"たい"],[27,2,"せいどう"],[38,1,"てつ"],[40,1,"かん"],[42,1,"き"],[44,1,"た"],[46,1,"き"]],"text":"「わたしはあなたの前に行って、もろもろの山を平らにし、青銅のとびらをこわし、鉄の貫の木を断ち切り、"},{"ref":"Isa.45.3","start":23045003,"end":23045003,"break":"line","breaks":[[15,"line"],[32,"line"],[47,"line"]],"ruby":[[5,1,"くら"],[7,1,"ところ"],[11,2,"ざいほう"],[19,1,"ところ"],[21,1,"かく"],[24,2,"ほうもつ"],[28,1,"あた"],[36,1,"しゅ"],[42,1,"な"],[44,1,"よ"],[53,1,"かみ"],[64,1,"し"]],"text":"あなたに、暗い所にある財宝と、ひそかな所に隠した宝物とを与えて、わたしは主、あなたの名を呼んだイスラエルの神であることをあなたに知らせよう。"},{"ref":"Isa.45.4","start":23045004,"end":23045004,"break":"line","breaks":[[13,"line"],[30,"line"],[44,"line"],[59,"line"]],"ruby":[[17,1,"えら"],[38,1,"な"],[40,1,"よ"],[52,1,"し"],[67,1,"な"],[69,1,"あた"]],"text":"わがしもべヤコブのために、わたしの選んだイスラエルのために、わたしはあなたの名を呼んだ。あなたがわたしを知らなくても、わたしはあなたに名を与えた。"},{"ref":"Isa.45.5","start":23045005,"end":23045005,"break":"line","breaks":[[9,"line"],[28,"line"],[43,"line"]],"ruby":[[4,1,"しゅ"],[16,1,"かみ"],[36,1,"し"],[51,1,"つよ"]],"text":"わたしは主である。わたしのほかに神はない、ひとりもない。あなたがわたしを知らなくても、わたしはあなたを強くする。"},{"ref":"Isa.45.6","start":23045006,"end":23045006,"break":"line","breaks":[[19,"line"],[36,"line"],[49,"line"]],"ruby":[[3,1,"ひ"],[5,1,"で"],[7,1,"ほう"],[13,1,"にし"],[15,1,"ほう"],[19,2,"ひとびと"],[29,1,"かみ"],[36,1,"し"],[53,1,"しゅ"],[65,1,"かみ"]],"text":"これは日の出る方から、また西の方から、人々がわたしのほかに神のないことを知るようになるためである。わたしは主である、わたしのほかに神はない。"},{"ref":"Isa.45.7","start":23045007,"end":23045007,"break":"line","breaks":[[19,"line"],[38,"line"],[47,"line"]],"ruby":[[4,1,"ひかり"],[12,1,"くら"],[15,2,"そうぞう"],[19,2,"はんえい"],[33,2,"そうぞう"],[42,1,"しゅ"],[54,1,"こと"],[58,1,"もの"]],"text":"わたしは光をつくり、また暗きを創造し、繁栄をつくり、またわざわいを創造する。わたしは主である、すべてこれらの事をなす者である。"},{"ref":"Isa.45.8","start":23045008,"end":23045008,"break":"paragraph","breaks":[[11,"line"],[20,"line"],[42,"line"]],"ruby":[[0,1,"てん"],[3,1,"うえ"],[6,1,"みず"],[8,1,"そそ"],[11,1,"くも"],[13,1,"ぎ"],[15,1,"ふ"],[20,1,"ち"],[22,1,"ひら"],[25,1,"すくい"],[27,1,"しょう"],[32,1,"ぎ"],[36,1,"は"],[42,1,"しゅ"],[52,2,"そうぞう"]],"text":"天よ、上より水を注げ、雲は義を降らせよ。地は開けて救を生じ、また義をも、生えさせよ。主なるわたしはこれを創造した。"},{"ref":"Isa.45.9","start":23045009,"end":23045009,"break":"paragraph","breaks":[[13,"line"],[32,"line"],[43,"line"],[58,"line"],[79,"line"]],"ruby":[[0,2,"とうき"],[3,2,"とうき"],[5,1,"し"],[7,1,"あらそ"],[17,1,"つく"],[20,1,"もの"],[22,1,"あらそ"],[24,1,"もの"],[32,2,"ねんど"],[35,2,"とうき"],[37,1,"し"],[48,1,"なに"],[50,1,"つく"],[55,1,"い"],[67,1,"つく"],[70,1,"もの"],[73,1,"て"],[79,1,"い"]],"text":"陶器が陶器師と争うように、おのれを造った者と争う者はわざわいだ。粘土は陶器師にむかって『あなたは何を造るか』と言い、あるいは『あなたの造った物には手がない』と言うだろうか。"},{"ref":"Isa.45.10","start":23045010,"end":23045010,"break":"line","breaks":[[6,"line"],[27,"line"],[37,"line"],[58,"line"]],"ruby":[[0,1,"ちち"],[14,1,"こ"],[24,1,"い"],[31,1,"おんな"],[45,1,"う"],[48,1,"くる"],[58,1,"い"],[60,1,"もの"]],"text":"父にむかって『あなたは、なぜ子をもうけるのか』と言い、あるいは女にむかって『あなたは、なぜ産みの苦しみをするのか』と言う者はわざわいだ」。"},{"ref":"Isa.45.11","start":23045011,"end":23045011,"break":"line","breaks":[[9,"line"],[28,"line"],[51,"line"]],"ruby":[[6,2,"せいじゃ"],[15,1,"つく"],[19,1,"しゅ"],[23,1,"い"],[38,1,"こ"],[48,1,"と"],[55,1,"て"],[67,1,"めい"]],"text":"イスラエルの聖者、イスラエルを造られた主はこう言われる、「あなたがたは、わが子らについてわたしに問い、またわが手のわざについてわたしに命ずるのか。"},{"ref":"Isa.45.12","start":23045012,"end":23045012,"break":"line","breaks":[[21,"line"],[35,"line"]],"ruby":[[4,1,"ち"],[6,1,"つく"],[12,1,"うえ"],[14,1,"ひと"],[16,2,"そうぞう"],[25,1,"て"],[30,1,"てん"],[37,2,"ばんぐん"],[40,2,"しき"]],"text":"わたしは地を造って、その上に人を創造した。わたしは手をもって天をのべ、その万軍を指揮した。"},{"ref":"Isa.45.13","start":23045013,"end":23045013,"break":"line","breaks":[[17,"line"],[38,"line"],[47,"line"],[60,"line"],[77,"line"]],"ruby":[[4,1,"ぎ"],[13,1,"おこ"],[21,1,"かれ"],[27,1,"みち"],[38,1,"かれ"],[42,1,"まち"],[44,1,"た"],[49,2,"ほしゅう"],[52,1,"あたい"],[62,1,"むく"],[71,1,"と"],[73,1,"はな"],[77,2,"ばんぐん"],[80,1,"しゅ"],[82,1,"い"]],"text":"わたしは義をもってクロスを起した。わたしは彼のすべての道をまっすぐにしよう。彼はわが町を建て、わが捕囚を価のためでなく、また報いのためでもなく解き放つ」と万軍の主は言われる。"},{"ref":"Isa.45.14","start":23045014,"end":23045014,"break":"paragraph","breaks":[[9,"line"],[28,"line"],[39,"line"],[63,"line"],[87,"line"],[97,"line"],[112,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[15,1,"とみ"],[24,2,"しょうひん"],[31,1,"たか"],[43,1,"き"],[60,1,"したが"],[63,1,"かれ"],[66,1,"くさり"],[73,1,"き"],[80,1,"まえ"],[84,1,"ふ"],[91,1,"ねが"],[94,1,"い"],[98,1,"かみ"],[106,1,"とも"],[117,1,"かみ"]],"text":"主はこう言われる、「エジプトの富と、エチオピヤの商品と、たけの高いセバびととはあなたに来て、あなたのものとなり、あなたに従い、彼らは鎖につながれて来て、あなたの前にひれ伏し、あなたに願って言う、『神はただあなたと共にいまし、このほかに神はなく、ひとりもない』」。"},{"ref":"Isa.45.15","start":23045015,"end":23045015,"break":"line","breaks":[[12,"line"],[21,"line"]],"ruby":[[6,1,"かみ"],[8,2,"すくいぬし"],[22,2,"じぶん"],[25,1,"かく"],[32,1,"かみ"]],"text":"イスラエルの神、救主よ、まことに、あなたはご自分を隠しておられる神である。"},{"ref":"Isa.45.16","start":23045016,"end":23045016,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"ぐうぞう"],[3,1,"つく"],[5,1,"もの"],[7,1,"みな"],[8,1,"はじ"],[10,1,"お"],[19,1,"う"],[34,1,"しりぞ"]],"text":"偶像を造る者は皆恥を負い、はずかしめを受け、ともに、あわてふためいて退く。"},{"ref":"Isa.45.17","start":23045017,"end":23045017,"break":"line","breaks":[[17,"line"],[27,"line"],[41,"line"]],"ruby":[[10,1,"しゅ"],[12,1,"すく"],[22,1,"すくい"],[24,1,"え"],[33,2,"よよ"],[41,1,"はじ"],[43,1,"お"],[53,1,"う"]],"text":"しかし、イスラエルは主に救われて、とこしえの救を得る。あなたがたは世々かぎりなく、恥を負わず、はずかしめを受けない。"},{"ref":"Isa.45.18","start":23045018,"end":23045018,"break":"paragraph","breaks":[[18,"line"],[35,"line"],[49,"line"],[71,"line"]],"ruby":[[0,1,"てん"],[2,2,"そうぞう"],[7,1,"しゅ"],[13,1,"かみ"],[20,1,"ち"],[23,1,"つく"],[25,1,"な"],[31,1,"かた"],[43,2,"そうぞう"],[52,1,"ひと"],[58,1,"つく"],[62,1,"しゅ"],[66,1,"い"],[76,1,"しゅ"],[88,1,"かみ"]],"text":"天を創造された主、すなわち神であってまた地をも造り成し、これを堅くし、いたずらにこれを創造されず、これを人のすみかに造られた主はこう言われる、「わたしは主である、わたしのほかに神はない。"},{"ref":"Isa.45.19","start":23045019,"end":23045019,"break":"line","breaks":[[21,"line"],[28,"line"],[50,"line"],[65,"line"]],"ruby":[[4,1,"かく"],[11,1,"ち"],[13,1,"くら"],[15,1,"ところ"],[17,1,"かた"],[25,2,"しそん"],[33,1,"たず"],[43,1,"い"],[50,1,"しゅ"],[57,1,"ただ"],[60,1,"こと"],[62,1,"かた"],[70,1,"こと"],[72,1,"つ"]],"text":"わたしは隠れたところ、地の暗い所で語らず、ヤコブの子孫に『わたしを尋ねるのはむだだ』と言わなかった。主なるわたしは正しい事を語り、まっすぐな事を告げる。"},{"ref":"Isa.45.20","start":23045020,"end":23045020,"break":"paragraph","breaks":[[17,"line"],[30,"line"],[37,"line"]],"ruby":[[5,1,"くに"],[14,1,"もの"],[17,1,"あつ"],[24,1,"とも"],[26,2,"ちかよ"],[30,2,"もくぞう"],[37,1,"すく"],[46,1,"かみ"],[48,1,"いの"],[50,1,"もの"],[52,2,"むち"]],"text":"もろもろの国からのがれてきた者よ、集まってきて、共に近寄れ。木像をにない、救うことのできない神に祈る者は無知である。"},{"ref":"Isa.45.21","start":23045021,"end":23045021,"break":"line","breaks":[[19,"line"],[28,"line"],[46,"line"],[57,"line"],[74,"line"],[86,"line"],[102,"line"]],"ruby":[[6,1,"い"],[8,1,"ぶん"],[10,1,"も"],[15,1,"の"],[21,1,"とも"],[23,2,"そうだん"],[30,1,"こと"],[41,1,"しめ"],[49,1,"むかし"],[52,1,"つ"],[65,1,"しゅ"],[81,1,"かみ"],[90,1,"ぎ"],[93,1,"かみ"],[95,2,"すくいぬし"],[109,1,"かみ"]],"text":"あなたがたの言い分を持ってきて述べよ。また共に相談せよ。この事をだれがいにしえから示したか。だれが昔から告げたか。わたし、すなわち主ではなかったか。わたしのほかに神はない。わたしは義なる神、救主であって、わたしのほかに神はない。"},{"ref":"Isa.45.22","start":23045022,"end":23045022,"break":"paragraph","breaks":[[13,"line"],[33,"line"]],"ruby":[[0,1,"ち"],[2,1,"はて"],[10,1,"ひと"],[17,1,"あお"],[28,1,"すく"],[37,1,"かみ"],[46,1,"かみ"]],"text":"地の果なるもろもろの人よ、わたしを仰ぎのぞめ、そうすれば救われる。わたしは神であって、ほかに神はないからだ。"},{"ref":"Isa.45.23","start":23045023,"end":23045023,"break":"line","breaks":[[14,"line"],[37,"line"],[53,"line"]],"ruby":[[4,2,"じぶん"],[10,1,"ちか"],[18,1,"くち"],[21,1,"で"],[23,1,"ただ"],[26,2,"ことば"],[29,1,"かえ"],[47,1,"まえ"],[57,1,"した"],[59,1,"ちか"]],"text":"わたしは自分をさして誓った、わたしの口から出た正しい言葉は帰ることがない、『すべてのひざはわが前にかがみ、すべての舌は誓いをたてる』。"},{"ref":"Isa.45.24","start":23045024,"end":23045024,"break":"paragraph","breaks":[[12,"line"],[28,"line"],[37,"line"]],"ruby":[[0,1,"ひと"],[9,1,"い"],[13,2,"せいぎ"],[16,1,"ちから"],[19,1,"しゅ"],[28,2,"ひとびと"],[31,1,"しゅ"],[37,1,"しゅ"],[43,1,"いか"],[45,1,"もの"],[47,1,"みな"],[48,1,"はじ"],[50,1,"う"]],"text":"人はわたしについて言う、『正義と力とは主にのみある』と。人々は主にきたり、主にむかって怒る者は皆恥を受ける。"},{"ref":"Isa.45.25","start":23045025,"end":23045025,"break":"line","breaks":[[13,"line"]],"ruby":[[9,2,"しそん"],[12,1,"みな"],[13,1,"しゅ"],[18,1,"か"],[20,1,"ほこ"]],"text":"しかしイスラエルの子孫は皆主によって勝ち誇ることができる」。"}]