[{"ref":"Num.30.1","start":4030001,"end":4030001,"break":"paragraph","ruby":[[10,2,"ひとびと"],[13,2,"ぶぞく"],[22,1,"い"],[30,1,"しゅ"],[32,1,"めい"],[37,1,"こと"]],"text":"モーセはイスラエルの人々の部族のかしらたちに言った、「これは主が命じられた事である。"},{"ref":"Num.30.2","start":4030002,"end":4030002,"break":"none","ruby":[[2,1,"ひと"],[4,1,"しゅ"],[6,2,"せいがん"],[17,1,"み"],[19,1,"もの"],[20,1,"だ"],[27,1,"ちか"],[38,2,"ことば"],[41,1,"やぶ"],[50,1,"くち"],[52,1,"い"],[62,1,"おこな"]],"text":"もし人が主に誓願をかけ、またはその身に物断ちをしようと誓いをするならば、その言葉を破ってはならない。口で言ったとおりにすべて行わなければならない。"},{"ref":"Num.30.3","start":4030003,"end":4030003,"break":"none","ruby":[[4,1,"おんな"],[8,1,"わか"],[11,1,"ちち"],[13,1,"いえ"],[18,1,"しゅ"],[20,2,"せいがん"],[31,1,"み"],[33,1,"もの"],[34,1,"だ"],[43,1,"とき"]],"text":"またもし女がまだ若く、父の家にいて、主に誓願をかけ、またはその身に物断ちをしようとする時、"},{"ref":"Num.30.4","start":4030004,"end":4030004,"break":"none","ruby":[[0,1,"ちち"],[2,2,"かのじょ"],[5,2,"せいがん"],[11,2,"かのじょ"],[14,1,"み"],[16,1,"た"],[19,1,"もの"],[20,1,"だ"],[26,1,"き"],[30,2,"かのじょ"],[33,1,"なに"],[35,1,"い"],[43,2,"かのじょ"],[49,2,"せいがん"],[52,1,"おこな"],[59,1,"み"],[61,1,"た"],[64,1,"もの"],[65,1,"だ"],[71,1,"まも"]],"text":"父が彼女の誓願、または彼女の身に断った物断ちのことを聞いて、彼女に何も言わないならば、彼女はすべて誓願を行い、またその身に断った物断ちをすべて守らなければならない。"},{"ref":"Num.30.5","start":4030005,"end":4030005,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"ちち"],[12,1,"き"],[15,1,"ひ"],[21,2,"しょうにん"],[26,1,"とき"],[29,2,"かのじょ"],[34,2,"せいがん"],[42,1,"み"],[44,1,"た"],[47,1,"もの"],[48,1,"だ"],[64,1,"ちち"],[66,2,"しょうにん"],[78,1,"しゅ"],[80,2,"かのじょ"]],"text":"しかし、彼女の父がそれを聞いた日に、それを承認しない時は、彼女はその誓願、またはその身に断った物断ちをすべてやめることができる。父が承認しないのであるから、主は彼女をゆるされるであろう。"},{"ref":"Num.30.6","start":4030006,"end":4030006,"break":"none","ruby":[[4,1,"おっと"],[8,1,"み"],[15,2,"せいがん"],[26,1,"み"],[28,1,"もの"],[29,1,"だ"],[37,2,"かるがる"],[41,1,"くち"],[43,1,"い"],[46,2,"ばあい"]],"text":"またもし夫のある身で、みずから誓願をかけ、またはその身に物断ちをしようと、軽々しく口で言った場合、"},{"ref":"Num.30.7","start":4030007,"end":4030007,"break":"none","ruby":[[0,1,"おっと"],[5,1,"き"],[11,1,"き"],[14,1,"ひ"],[16,2,"かのじょ"],[19,1,"なに"],[21,1,"い"],[29,2,"かのじょ"],[34,2,"せいがん"],[37,1,"おこな"],[42,1,"み"],[44,1,"た"],[47,1,"もの"],[48,1,"だ"],[51,1,"まも"]],"text":"夫がそれを聞き、それを聞いた日に彼女に何も言わないならば、彼女はその誓願を行い、その身に断った物断ちを守らなければならない。"},{"ref":"Num.30.8","start":4030008,"end":4030008,"break":"none","ruby":[[6,1,"おっと"],[11,1,"き"],[14,1,"ひ"],[20,2,"しょうにん"],[29,1,"おっと"],[33,1,"おんな"],[38,2,"せいがん"],[46,1,"み"],[48,1,"もの"],[49,1,"だ"],[57,2,"かるがる"],[61,1,"くち"],[63,1,"い"],[81,1,"しゅ"],[85,1,"おんな"]],"text":"しかし、もし夫がそれを聞いた日に、それを承認しないならば、夫はその女がかけた誓願、またはその身に物断ちをしようと、軽々しく口に言ったことをやめさせることができる。主はその女をゆるされるであろう。"},{"ref":"Num.30.9","start":4030009,"end":4030009,"break":"none","ruby":[[4,2,"かふ"],[10,2,"りえん"],[15,1,"おんな"],[17,2,"せいがん"],[25,1,"み"],[27,1,"た"],[30,1,"もの"],[31,1,"だ"],[38,1,"まも"]],"text":"しかし、寡婦あるいは離縁された女の誓願、すべてその身に断った物断ちは、それを守らなければならない。"},{"ref":"Num.30.10","start":4030010,"end":4030010,"break":"none","ruby":[[2,1,"おんな"],[4,1,"おっと"],[6,1,"いえ"],[8,2,"せいがん"],[19,1,"み"],[21,1,"もの"],[22,1,"だ"],[29,1,"ちか"],[32,1,"とき"]],"text":"もし女が夫の家で誓願をかけ、またはその身に物断ちをしようと誓った時、"},{"ref":"Num.30.11","start":4030011,"end":4030011,"break":"none","ruby":[[0,1,"おっと"],[5,1,"き"],[9,2,"かのじょ"],[12,1,"なに"],[14,1,"い"],[23,2,"はんたい"],[34,2,"せいがん"],[40,1,"おこな"],[55,1,"み"],[57,1,"た"],[60,1,"もの"],[61,1,"だ"],[67,1,"まも"]],"text":"夫がそれを聞いて、彼女に何も言わず、またそれに反対しないならば、その誓願はすべて行わなければならない。またその身に断った物断ちはすべて守らなければならない。"},{"ref":"Num.30.12","start":4030012,"end":4030012,"break":"none","ruby":[[6,1,"おっと"],[11,1,"き"],[14,1,"ひ"],[19,1,"みと"],[27,2,"かのじょ"],[30,2,"せいがん"],[36,1,"み"],[38,1,"もの"],[39,1,"だ"],[46,2,"かのじょ"],[49,1,"くち"],[51,1,"い"],[54,1,"こと"],[70,1,"おっと"],[75,1,"みと"],[86,1,"しゅ"],[90,1,"おんな"]],"text":"しかし、もし夫がそれを聞いた日にそれを認めないならば、彼女の誓願、または身の物断ちについて、彼女が口で言った事は、すべてやめることができる。夫がそれを認めなかったのだから、主はその女をゆるされるであろう。"},{"ref":"Num.30.13","start":4030013,"end":4030013,"break":"none","ruby":[[4,2,"せいがん"],[14,1,"み"],[16,1,"なや"],[19,1,"もの"],[20,1,"だ"],[23,2,"せいやく"],[27,1,"おっと"],[32,1,"まも"],[45,1,"おっと"]],"text":"すべての誓願およびすべてその身を悩ます物断ちの誓約は、夫がそれを守らせることができ、または夫がそれをやめさせることができる。"},{"ref":"Num.30.14","start":4030014,"end":4030014,"break":"none","ruby":[[2,1,"おっと"],[4,2,"かのじょ"],[7,1,"なに"],[9,1,"い"],[13,1,"ひ"],[15,1,"おく"],[21,1,"かれ"],[23,1,"つま"],[27,2,"せいがん"],[33,1,"もの"],[34,1,"だ"],[40,1,"みと"],[48,1,"かれ"],[53,1,"き"],[56,1,"ひ"],[58,1,"つま"],[60,1,"なに"],[62,1,"い"],[76,1,"みと"]],"text":"もし夫が彼女に何も言わずに日を送るならば、彼は妻がした誓願、または物断ちをすべて認めたのである。彼はそれを聞いた日に妻に何も言わなかったのだから、それを認めたのである。"},{"ref":"Num.30.15","start":4030015,"end":4030015,"break":"none","ruby":[[6,1,"おっと"],[11,1,"き"],[24,1,"みと"],[32,1,"かれ"],[34,1,"つま"],[36,1,"つみ"],[38,1,"お"]],"text":"しかし、もし夫がそれを聞き、あとになって、それを認めないならば、彼は妻の罪を負わなければならない」。"},{"ref":"Num.30.16","start":4030016,"end":4030016,"break":"paragraph","ruby":[[4,1,"しゅ"],[10,1,"めい"],[15,1,"さだ"],[22,1,"おっと"],[24,1,"つま"],[27,1,"あいだ"],[32,1,"ちち"],[36,1,"わか"],[39,1,"ちち"],[41,1,"いえ"],[45,1,"むすめ"],[48,1,"あいだ"],[50,1,"かん"]],"text":"これらは主がモーセに命じられた定めであって、夫と妻との間、および父とまだ若くて父の家にいる娘との間に関するものである。"}]