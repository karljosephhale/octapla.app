[{"ref":"Prov.2.1","start":20002001,"end":20002001,"break":"paragraph","breaks":[[11,"line"],[21,"line"]],"ruby":[[2,1,"こ"],[15,2,"ことば"],[18,1,"う"],[25,1,"いまし"],[33,1,"こころ"]],"text":"わが子よ、もしあなたがわたしの言葉を受け、わたしの戒めを、あなたの心におさめ、"},{"ref":"Prov.2.2","start":20002002,"end":20002002,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"みみ"],[6,2,"ちえ"],[9,1,"かたむ"],[16,1,"こころ"],[18,1,"さと"],[21,1,"む"]],"text":"あなたの耳を知恵に傾け、あなたの心を悟りに向け、"},{"ref":"Prov.2.3","start":20002003,"end":20002003,"break":"line","breaks":[[14,"line"]],"ruby":[[6,2,"ちしき"],[9,1,"よ"],[11,1,"もと"],[14,1,"さと"],[17,1,"え"],[26,1,"こえ"]],"text":"しかも、もし知識を呼び求め、悟りを得ようと、あなたの声をあげ、"},{"ref":"Prov.2.4","start":20002004,"end":20002004,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ぎん"],[2,1,"もと"],[12,1,"もと"],[19,1,"たから"],[21,1,"たず"],[31,1,"たず"]],"text":"銀を求めるように、これを求め、かくれた宝を尋ねるように、これを尋ねるならば、"},{"ref":"Prov.2.5","start":20002005,"end":20002005,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"おそ"],[13,1,"さと"],[16,1,"かみ"],[18,1,"し"]],"text":"あなたは、主を恐れることを悟り、神を知ることができるようになる。"},{"ref":"Prov.2.6","start":20002006,"end":20002006,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"しゅ"],[6,2,"ちえ"],[9,1,"あた"],[12,2,"ちしき"],[15,1,"さと"],[21,1,"くち"],[24,1,"で"]],"text":"これは、主が知恵を与え、知識と悟りとは、み口から出るからである。"},{"ref":"Prov.2.7","start":20002007,"end":20002007,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ただ"],[5,1,"ひと"],[11,1,"たし"],[14,2,"ちえ"],[22,2,"せいじつ"],[25,1,"あゆ"],[27,1,"もの"],[29,1,"たて"]],"text":"彼は正しい人のために、確かな知恵をたくわえ、誠実に歩む者の盾となって、"},{"ref":"Prov.2.8","start":20002008,"end":20002008,"break":"line","ruby":[[0,2,"こうせい"],[3,1,"みち"],[5,1,"たも"],[10,2,"せいと"],[15,2,"みちすじ"],[18,1,"まも"]],"text":"公正の道を保ち、その聖徒たちの道筋を守られる。"},{"ref":"Prov.2.9","start":20002009,"end":20002009,"break":"line","breaks":[[19,"line"]],"ruby":[[13,2,"せいぎ"],[16,2,"こうせい"],[19,2,"こうへい"],[26,1,"よ"],[28,1,"みち"],[30,1,"さと"]],"text":"そのとき、あなたは、ついに正義と公正、公平とすべての良い道を悟る。"},{"ref":"Prov.2.10","start":20002010,"end":20002010,"break":"line","breaks":[[17,"line"]],"ruby":[[3,2,"ちえ"],[11,1,"こころ"],[17,2,"ちしき"],[24,1,"たましい"],[26,1,"たの"]],"text":"これは知恵が、あなたの心にはいり、知識があなたの魂に楽しみとなるからである。"},{"ref":"Prov.2.11","start":20002011,"end":20002011,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"つつし"],[7,1,"まも"],[10,1,"さと"],[17,1,"たも"]],"text":"慎みはあなたを守り、悟りはあなたを保って、"},{"ref":"Prov.2.12","start":20002012,"end":20002012,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"あく"],[2,1,"みち"],[9,1,"すく"],[12,1,"いつわ"],[17,1,"もの"],[20,1,"すく"]],"text":"悪の道からあなたを救い、偽りをいう者から救う。"},{"ref":"Prov.2.13","start":20002013,"end":20002013,"break":"line","ruby":[[0,1,"かれ"],[3,1,"ただ"],[6,1,"みち"],[8,1,"はな"],[12,1,"くら"],[14,1,"みち"],[16,1,"あゆ"]],"text":"彼らは正しい道を離れて、暗い道に歩み、"},{"ref":"Prov.2.14","start":20002014,"end":20002014,"break":"line","ruby":[[0,1,"あく"],[2,1,"おこな"],[7,1,"たの"],[11,2,"あくにん"],[14,1,"いつわ"],[17,1,"よろこ"]],"text":"悪を行うことを楽しみ、悪人の偽りを喜び、"},{"ref":"Prov.2.15","start":20002015,"end":20002015,"break":"line","ruby":[[2,1,"みち"],[4,1,"まが"],[9,1,"おこな"]],"text":"その道は曲り、その行いは、よこしまである。"},{"ref":"Prov.2.16","start":20002016,"end":20002016,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"つつし"],[3,1,"さと"],[12,2,"ゆうじょ"],[16,1,"すく"],[19,2,"ことば"],[22,1,"たく"],[30,1,"おんな"],[33,1,"すく"]],"text":"慎みと悟りはまたあなたを遊女から救い、言葉の巧みな、みだらな女から救う。"},{"ref":"Prov.2.17","start":20002017,"end":20002017,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"わか"],[5,1,"とき"],[7,1,"とも"],[9,1,"す"],[14,1,"かみ"],[16,2,"けいやく"],[23,1,"わす"]],"text":"彼女は若い時の友を捨て、その神に契約したことを忘れている。"},{"ref":"Prov.2.18","start":20002018,"end":20002018,"break":"line","ruby":[[2,1,"いえ"],[4,1,"し"],[6,1,"くだ"],[11,1,"みち"],[13,2,"よみ"]],"text":"その家は死に下り、その道は陰府におもむく。"},{"ref":"Prov.2.19","start":20002019,"end":20002019,"break":"line","breaks":[[19,"line"]],"ruby":[[3,2,"かのじょ"],[9,1,"い"],[11,1,"もの"],[14,1,"かえ"],[21,1,"いのち"],[23,1,"みち"]],"text":"すべて彼女のもとへ行く者は、帰らない、また命の道にいたらない。"},{"ref":"Prov.2.20","start":20002020,"end":20002020,"break":"line","breaks":[[20,"line"]],"ruby":[[9,2,"ぜんりょう"],[12,2,"ひとびと"],[15,1,"みち"],[17,1,"あゆ"],[20,1,"ただ"],[23,2,"ひとびと"],[26,1,"みち"],[28,1,"まも"]],"text":"こうして、あなたは善良な人々の道に歩み、正しい人々の道を守ることができる。"},{"ref":"Prov.2.21","start":20002021,"end":20002021,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"ち"],[12,2,"せいじつ"],[15,1,"ひと"],[17,1,"ち"]],"text":"正しい人は地にながらえ、誠実な人は地にとどまる。"},{"ref":"Prov.2.22","start":20002022,"end":20002022,"break":"line","breaks":[[18,"line"]],"ruby":[[3,1,"あ"],[6,1,"もの"],[8,1,"ち"],[11,1,"た"],[13,1,"ほろ"],[18,3,"ふしんじつ"],[22,1,"もの"],[24,1,"ち"],[27,1,"ぬ"],[29,1,"す"]],"text":"しかし悪しき者は地から断ち滅ぼされ、不信実な者は地から抜き捨てられる。"}]