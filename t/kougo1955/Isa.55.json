[{"ref":"Isa.55.1","start":23055001,"end":23055001,"break":"paragraph","breaks":[[12,"line"],[20,"line"],[30,"line"],[41,"line"],[57,"line"]],"ruby":[[10,1,"もの"],[14,1,"みず"],[20,1,"かね"],[24,1,"もの"],[30,1,"き"],[32,1,"か"],[34,1,"もと"],[37,1,"た"],[47,1,"き"],[50,1,"かね"],[52,1,"だ"],[63,1,"しゅ"],[65,1,"ちち"],[68,1,"か"],[70,1,"もと"]],"text":"「さあ、かわいている者はみな水にきたれ。金のない者もきたれ。来て買い求めて食べよ。あなたがたは来て、金を出さずに、ただでぶどう酒と乳とを買い求めよ。"},{"ref":"Isa.55.2","start":23055002,"end":23055002,"break":"line","breaks":[[10,"line"],[28,"line"],[49,"line"],[60,"line"],[79,"line"]],"ruby":[[23,1,"かね"],[25,1,"ついや"],[28,1,"あ"],[43,1,"ろう"],[55,1,"き"],[57,1,"したが"],[66,1,"よ"],[68,1,"もの"],[70,1,"た"],[79,1,"もっと"],[81,1,"ゆた"],[84,2,"しょくもつ"],[88,2,"じぶん"],[91,1,"たの"]],"text":"なぜ、あなたがたは、かてにもならぬもののために金を費し、飽きることもできぬもののために労するのか。わたしによく聞き従え。そうすれば、良い物を食べることができ、最も豊かな食物で、自分を楽しませることができる。"},{"ref":"Isa.55.3","start":23055003,"end":23055003,"break":"line","breaks":[[14,"line"],[36,"line"],[60,"line"]],"ruby":[[0,1,"みみ"],[2,1,"かたむ"],[11,1,"き"],[26,1,"い"],[53,2,"けいやく"],[56,1,"た"],[64,2,"やくそく"],[68,1,"かわ"],[72,1,"たし"],[75,1,"めぐ"],[78,1,"あた"]],"text":"耳を傾け、わたしにきて聞け。そうすれば、あなたがたは生きることができる。わたしは、あなたがたと、とこしえの契約を立てて、ダビデに約束した変らない確かな恵みを与える。"},{"ref":"Isa.55.4","start":23055004,"end":23055004,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[0,1,"み"],[7,1,"かれ"],[9,1,"た"],[18,1,"たみ"],[21,2,"しょうにん"],[34,1,"たみ"],[36,1,"きみ"],[40,2,"めいれい"],[44,1,"もの"]],"text":"見よ、わたしは彼を立てて、もろもろの民への証人とし、また、もろもろの民の君とし、命令する者とした。"},{"ref":"Isa.55.5","start":23055005,"end":23055005,"break":"line","breaks":[[17,"line"],[28,"line"],[41,"line"],[52,"line"],[67,"line"]],"ruby":[[0,1,"み"],[7,1,"し"],[11,2,"くにたみ"],[14,1,"まね"],[21,1,"し"],[25,2,"くにたみ"],[35,1,"はし"],[48,1,"かみ"],[50,1,"しゅ"],[58,2,"せいじゃ"],[67,1,"しゅ"],[73,2,"こうえい"],[76,1,"あた"]],"text":"見よ、あなたは知らない国民を招く、あなたを知らない国民はあなたのもとに走ってくる。これはあなたの神、主、イスラエルの聖者のゆえであり、主があなたに光栄を与えられたからである。"},{"ref":"Isa.55.6","start":23055006,"end":23055006,"break":"paragraph","breaks":[[23,"line"],[29,"line"]],"ruby":[[6,1,"しゅ"],[9,1,"あ"],[23,1,"しゅ"],[25,1,"たず"],[29,1,"ちか"],[38,1,"よ"],[40,1,"もと"]],"text":"あなたがたは主にお会いすることのできるうちに、主を尋ねよ。近くおられるうちに呼び求めよ。"},{"ref":"Isa.55.7","start":23055007,"end":23055007,"break":"line","breaks":[[12,"line"],[31,"line"],[51,"line"],[61,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[7,1,"みち"],[9,1,"す"],[12,1,"ただしか"],[15,1,"ひと"],[19,1,"おも"],[22,1,"す"],[26,1,"しゅ"],[28,1,"かえ"],[37,1,"しゅ"],[39,1,"かれ"],[46,1,"ほどこ"],[56,1,"かみ"],[58,1,"かえ"],[61,1,"しゅ"],[63,1,"ゆた"],[70,1,"あた"]],"text":"悪しき者はその道を捨て、正らぬ人はその思いを捨てて、主に帰れ。そうすれば、主は彼にあわれみを施される。われわれの神に帰れ、主は豊かにゆるしを与えられる。"},{"ref":"Isa.55.8","start":23055008,"end":23055008,"break":"line","breaks":[[20,"line"],[41,"line"]],"ruby":[[2,1,"おも"],[12,1,"おも"],[16,1,"こと"],[22,1,"みち"],[31,1,"みち"],[34,1,"こと"],[41,1,"しゅ"],[43,1,"い"]],"text":"わが思いは、あなたがたの思いとは異なり、わが道は、あなたがたの道とは異なっていると主は言われる。"},{"ref":"Isa.55.9","start":23055009,"end":23055009,"break":"line","breaks":[[12,"line"],[30,"line"]],"ruby":[[0,1,"てん"],[2,1,"ち"],[6,1,"たか"],[14,1,"みち"],[23,1,"みち"],[27,1,"たか"],[32,1,"おも"],[42,1,"おも"],[47,1,"たか"]],"text":"天が地よりも高いように、わが道は、あなたがたの道よりも高く、わが思いは、あなたがたの思いよりも高い。"},{"ref":"Isa.55.10","start":23055010,"end":23055010,"break":"line","breaks":[[19,"line"],[38,"line"],[48,"line"]],"ruby":[[0,1,"てん"],[3,1,"あめ"],[5,1,"ふ"],[8,1,"ゆき"],[10,1,"お"],[15,1,"かえ"],[19,1,"ち"],[21,1,"うるお"],[24,1,"もの"],[26,1,"は"],[31,1,"め"],[33,1,"だ"],[38,1,"たね"],[41,1,"もの"],[43,1,"たね"],[45,1,"あた"],[48,1,"た"],[51,1,"もの"],[56,1,"あた"]],"text":"天から雨が降り、雪が落ちてまた帰らず、地を潤して物を生えさせ、芽を出させて、種まく者に種を与え、食べる者にかてを与える。"},{"ref":"Isa.55.11","start":23055011,"end":23055011,"break":"line","breaks":[[17,"line"],[30,"line"],[46,"line"]],"ruby":[[8,1,"くち"],[11,1,"で"],[13,2,"ことば"],[25,1,"かえ"],[34,1,"よろこ"],[50,1,"めい"],[52,1,"おく"],[55,1,"こと"],[57,1,"はた"]],"text":"このように、わが口から出る言葉も、むなしくわたしに帰らない。わたしの喜ぶところのことをなし、わたしが命じ送った事を果す。"},{"ref":"Isa.55.12","start":23055012,"end":23055012,"break":"line","breaks":[[17,"line"],[28,"line"],[49,"line"]],"ruby":[[6,1,"よろこ"],[12,1,"で"],[17,1,"やす"],[21,1,"みちび"],[25,1,"い"],[28,1,"やま"],[30,1,"おか"],[37,1,"まえ"],[39,1,"こえ"],[41,1,"はな"],[44,1,"よろこ"],[46,1,"うた"],[49,1,"の"],[53,1,"き"],[57,1,"て"],[59,1,"う"]],"text":"あなたがたは喜びをもって出てきて、安らかに導かれて行く。山と丘とはあなたの前に声を放って喜び歌い、野にある木はみな手を打つ。"},{"ref":"Isa.55.13","start":23055013,"end":23055013,"break":"line","breaks":[[16,"line"],[35,"line"],[46,"line"],[62,"line"]],"ruby":[[10,1,"かわ"],[13,1,"は"],[21,1,"き"],[28,1,"かわ"],[31,1,"は"],[38,1,"しゅ"],[40,2,"きねん"],[62,1,"た"]],"text":"いとすぎは、いばらに代って生え、ミルトスの木は、おどろに代って生える。これは主の記念となり、また、とこしえのしるしとなって、絶えることはない」。"}]