[{"ref":"Prov.10.1","start":20010001,"end":20010001,"break":"paragraph","breaks":[[8,"line"],[20,"line"]],"ruby":[[5,2,"しんげん"],[8,2,"ちえ"],[12,1,"こ"],[14,1,"ちち"],[16,1,"よろこ"],[20,1,"おろ"],[23,1,"こ"],[25,1,"はは"],[27,1,"かな"]],"text":"ソロモンの箴言。知恵ある子は父を喜ばせ、愚かな子は母の悲しみとなる。"},{"ref":"Prov.10.2","start":20010002,"end":20010002,"break":"line","breaks":[[9,"line"]],"ruby":[[0,2,"ふぎ"],[3,1,"たから"],[5,1,"えき"],[9,2,"せいぎ"],[12,1,"ひと"],[14,1,"すく"],[16,1,"だ"],[20,1,"し"],[22,1,"まぬか"]],"text":"不義の宝は益なく、正義は人を救い出して、死を免れさせる。"},{"ref":"Prov.10.3","start":20010003,"end":20010003,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ただ"],[5,1,"ひと"],[7,1,"う"],[13,1,"あ"],[16,1,"もの"],[18,2,"よくぼう"]],"text":"主は正しい人を飢えさせず、悪しき者の欲望をくじかれる。"},{"ref":"Prov.10.4","start":20010004,"end":20010004,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"て"],[2,1,"うご"],[8,1,"おこた"],[10,1,"もの"],[12,1,"まず"],[18,1,"つと"],[20,1,"はたら"],[22,1,"もの"],[24,1,"て"],[26,1,"とみ"],[28,1,"え"]],"text":"手を動かすことを怠る者は貧しくなり、勤め働く者の手は富を得る。"},{"ref":"Prov.10.5","start":20010005,"end":20010005,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"なつ"],[5,1,"あつ"],[8,1,"もの"],[10,1,"かしこ"],[12,1,"こ"],[17,2,"かりい"],[21,1,"とき"],[23,1,"ねむ"],[25,1,"もの"],[27,1,"はじ"],[34,1,"こ"]],"text":"夏のうちに集める者は賢い子であり、刈入れの時に眠る者は恥をきたらせる子である。"},{"ref":"Prov.10.6","start":20010006,"end":20010006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[10,2,"しゅくふく"],[16,1,"あ"],[19,1,"もの"],[21,1,"くち"],[23,2,"ぼうぎゃく"],[26,1,"かく"]],"text":"正しい者のこうべには祝福があり、悪しき者の口は暴虐を隠す。"},{"ref":"Prov.10.7","start":20010007,"end":20010007,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"な"],[12,1,"あ"],[15,1,"もの"],[17,1,"な"],[19,1,"く"]],"text":"正しい者の名はほめられ、悪しき者の名は朽ちる。"},{"ref":"Prov.10.8","start":20010008,"end":20010008,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"こころ"],[5,1,"もの"],[7,1,"いまし"],[10,1,"う"],[16,1,"くち"],[21,1,"おろ"],[24,1,"もの"],[26,1,"ほろ"]],"text":"心のさとき者は戒めを受ける、むだ口をたたく愚かな者は滅ぼされる。"},{"ref":"Prov.10.9","start":20010009,"end":20010009,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"あゆ"],[7,1,"もの"],[9,1,"あゆ"],[12,2,"あんぜん"],[24,1,"みち"],[26,1,"ま"],[29,1,"もの"],[31,1,"わざわい"]],"text":"まっすぐに歩む者の歩みは安全である、しかし、その道を曲げる者は災にあう。"},{"ref":"Prov.10.10","start":20010010,"end":20010010,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"め"],[9,1,"もの"],[11,1,"うれ"],[25,1,"いまし"],[28,1,"もの"],[30,2,"へいわ"]],"text":"目で、めくばせする者は憂いをおこし、あからさまに、戒める者は平和をきたらせる。"},{"ref":"Prov.10.11","start":20010011,"end":20010011,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"くち"],[7,1,"いのち"],[9,1,"いずみ"],[14,1,"あ"],[17,1,"もの"],[19,1,"くち"],[21,2,"ぼうぎゃく"],[24,1,"かく"]],"text":"正しい者の口は命の泉である、悪しき者の口は暴虐を隠す。"},{"ref":"Prov.10.12","start":20010012,"end":20010012,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"にく"],[5,1,"あらそ"],[8,1,"おこ"],[11,1,"あい"]],"text":"憎しみは、争いを起し、愛はすべてのとがをおおう。"},{"ref":"Prov.10.13","start":20010013,"end":20010013,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"もの"],[11,2,"ちえ"],[17,2,"ちえ"],[22,1,"もの"],[24,1,"せ"]],"text":"さとき者のくちびるには知恵があり、知恵のない者の背にはむちがある。"},{"ref":"Prov.10.14","start":20010014,"end":20010014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[6,2,"ちしき"],[15,1,"おろ"],[18,1,"もの"],[22,1,"くち"],[25,1,"いま"],[28,1,"ほろ"]],"text":"知恵ある者は知識をたくわえる、愚かな者のむだ口は、今にも滅びをきたらせる。"},{"ref":"Prov.10.15","start":20010015,"end":20010015,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"と"],[3,1,"もの"],[5,1,"たから"],[10,1,"かた"],[12,1,"しろ"],[17,1,"まず"],[20,1,"もの"],[22,1,"とぼ"],[29,1,"ほろ"]],"text":"富める者の宝は、その堅き城であり、貧しい者の乏しきは、その滅びである。"},{"ref":"Prov.10.16","start":20010016,"end":20010016,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"う"],[8,2,"ちんぎん"],[11,1,"いのち"],[13,1,"みちび"],[16,1,"あ"],[19,1,"もの"],[21,2,"りとく"],[24,1,"つみ"],[26,1,"いた"]],"text":"正しい者の受ける賃銀は命に導き、悪しき者の利得は罪に至る。"},{"ref":"Prov.10.17","start":20010017,"end":20010017,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"きょうくん"],[3,1,"まも"],[5,1,"もの"],[7,1,"いのち"],[9,1,"みち"],[14,1,"こら"],[18,1,"す"],[21,1,"もの"],[23,1,"みち"],[27,1,"まよ"]],"text":"教訓を守る者は命の道にあり、懲しめを捨てる者は道をふみ迷う。"},{"ref":"Prov.10.18","start":20010018,"end":20010018,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"にく"],[4,1,"かく"],[6,1,"もの"],[9,1,"いつわ"],[24,1,"くち"],[26,1,"だ"],[28,1,"もの"],[30,1,"おろ"],[33,1,"もの"]],"text":"憎しみを隠す者には偽りのくちびるがあり、そしりを口に出す者は愚かな者である。"},{"ref":"Prov.10.19","start":20010019,"end":20010019,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ことば"],[3,1,"おお"],[11,1,"まぬか"],[16,2,"じぶん"],[24,1,"せい"],[27,1,"もの"],[29,2,"ちえ"]],"text":"言葉が多ければ、とがを免れない、自分のくちびるを制する者は知恵がある。"},{"ref":"Prov.10.20","start":20010020,"end":20010020,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"した"],[7,1,"せい"],[8,1,"ぎん"],[13,1,"あ"],[16,1,"もの"],[18,1,"こころ"],[20,2,"かち"],[23,1,"すく"]],"text":"正しい者の舌は精銀である、悪しき者の心は価値が少ない。"},{"ref":"Prov.10.21","start":20010021,"end":20010021,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[10,1,"おお"],[13,1,"ひと"],[15,1,"やしな"],[18,1,"おろ"],[21,1,"もの"],[23,2,"ちえ"],[29,1,"し"]],"text":"正しい者のくちびるは多くの人を養い、愚かな者は知恵がなくて死ぬ。"},{"ref":"Prov.10.22","start":20010022,"end":20010022,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"しゅくふく"],[5,1,"ひと"],[7,1,"と"],[12,1,"しゅ"],[20,1,"かな"],[25,1,"くわ"]],"text":"主の祝福は人を富ませる、主はこれになんの悲しみをも加えない。"},{"ref":"Prov.10.23","start":20010023,"end":20010023,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[6,1,"たわむ"],[8,1,"ごと"],[13,1,"あく"],[15,1,"おこな"],[21,1,"ひと"],[24,1,"かしこ"],[26,1,"おこな"],[29,1,"たの"]],"text":"愚かな者は、戯れ事のように悪を行う、さとき人には賢い行いが楽しみである。"},{"ref":"Prov.10.24","start":20010024,"end":20010024,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"おそ"],[11,2,"じぶん"],[14,1,"きた"],[17,1,"ただ"],[20,1,"もの"],[22,1,"ねが"],[27,1,"あた"]],"text":"悪しき者の恐れることは自分に来り、正しい者の願うことは与えられる。"},{"ref":"Prov.10.25","start":20010025,"end":20010025,"break":"line","breaks":[[11,"line"],[27,"line"]],"ruby":[[4,1,"とお"],[9,1,"とき"],[11,1,"あ"],[14,1,"もの"],[27,1,"ただ"],[30,1,"もの"],[32,2,"えいきゅう"],[35,1,"かた"],[37,1,"た"]],"text":"あらしが通りすぎる時、悪しき者は、もはや、いなくなり、正しい者は永久に堅く立てられる。"},{"ref":"Prov.10.26","start":20010026,"end":20010026,"break":"line","breaks":[[20,"line"]],"ruby":[[3,1,"もの"],[13,1,"もの"],[20,1,"す"],[22,1,"は"],[28,1,"けむり"],[30,1,"め"],[32,1,"なや"]],"text":"なまけ者は、これをつかわす者にとっては、酢が歯をいため、煙が目を悩ますようなものだ。"},{"ref":"Prov.10.27","start":20010027,"end":20010027,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[8,1,"ひと"],[10,1,"いのち"],[12,1,"ひ"],[14,1,"おお"],[19,1,"あ"],[22,1,"もの"],[24,1,"とし"],[26,1,"ちぢ"]],"text":"主を恐れることは人の命の日を多くする、悪しき者の年は縮められる。"},{"ref":"Prov.10.28","start":20010028,"end":20010028,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"のぞ"],[8,1,"よろこ"],[11,1,"おわ"],[14,1,"あ"],[17,1,"もの"],[19,1,"のぞ"],[22,1,"た"]],"text":"正しい者の望みは喜びに終り、悪しき者の望みは絶える。"},{"ref":"Prov.10.29","start":20010029,"end":20010029,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"あゆ"],[10,1,"もの"],[13,1,"しろ"],[18,1,"あく"],[20,1,"おこな"],[22,1,"もの"],[25,1,"ほろ"]],"text":"主は、まっすぐに歩む者には城であり、悪を行う者には滅びである。"},{"ref":"Prov.10.30","start":20010030,"end":20010030,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[10,1,"うご"],[21,1,"あ"],[24,1,"もの"],[27,1,"ち"],[29,1,"す"]],"text":"正しい者はいつまでも動かされることはない、悪しき者は、地に住むことができない。"},{"ref":"Prov.10.31","start":20010031,"end":20010031,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"くち"],[7,2,"ちえ"],[14,1,"いつわ"],[17,1,"した"],[19,1,"ぬ"]],"text":"正しい者の口は知恵をいだし、偽りの舌は抜かれる。"},{"ref":"Prov.10.32","start":20010032,"end":20010032,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[10,1,"よろこ"],[23,1,"あ"],[26,1,"もの"],[28,1,"くち"],[30,1,"いつわ"],[33,1,"かた"]],"text":"正しい者のくちびるは喜ばるべきことをわきまえ、悪しき者の口は偽りを語る。"}]