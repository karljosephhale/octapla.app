[{"ref":"Isa.48.1","start":23048001,"end":23048001,"break":"paragraph","breaks":[[13,"line"],[36,"line"],[44,"line"],[54,"line"],[71,"line"]],"ruby":[[4,1,"いえ"],[10,1,"き"],[25,1,"な"],[39,1,"こし"],[42,1,"で"],[44,1,"しゅ"],[46,1,"な"],[51,1,"ちか"],[60,1,"かみ"],[71,2,"しんじつ"],[80,2,"せいぎ"]],"text":"ヤコブの家よ、これを聞け。あなたがたはイスラエルの名をもってとなえられ、ユダの腰から出、主の名によって誓い、イスラエルの神をとなえるけれども、真実をもってせず、正義をもってしない。"},{"ref":"Isa.48.2","start":23048002,"end":23048002,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[0,1,"かれ"],[7,1,"せい"],[10,1,"みやこ"],[25,1,"かみ"],[27,1,"よ"],[29,1,"たの"],[34,1,"な"],[36,2,"ばんぐん"],[39,1,"しゅ"]],"text":"彼らはみずから聖なる都のものととなえ、イスラエルの神に寄り頼む。その名は万軍の主という。"},{"ref":"Isa.48.3","start":23048003,"end":23048003,"break":"line","breaks":[[24,"line"],[42,"line"]],"ruby":[[8,1,"な"],[11,1,"こと"],[20,1,"つ"],[28,1,"くち"],[31,1,"だ"],[34,1,"かれ"],[37,1,"し"],[53,1,"こと"],[55,1,"おこな"],[61,1,"な"]],"text":"「わたしはさきに成った事を、いにしえから告げた。わたしは口から出して彼らに知らせた。わたしは、にわかにこの事を行い、そして成った。"},{"ref":"Isa.48.4","start":23048004,"end":23048004,"break":"line","breaks":[[23,"line"]],"ruby":[[17,1,"くび"],[19,1,"てつ"],[21,1,"すじ"],[25,1,"ひたい"],[27,2,"せいどう"],[35,1,"し"]],"text":"わたしはあなたが、かたくなで、その首は鉄の筋、その額は青銅であることを知るゆえに、"},{"ref":"Isa.48.5","start":23048005,"end":23048005,"break":"line","breaks":[[18,"line"],[40,"line"],[58,"line"],[72,"line"]],"ruby":[[9,1,"こと"],[15,1,"つ"],[20,1,"な"],[35,1,"き"],[52,1,"い"],[61,2,"ぐうぞう"],[74,1,"きざ"],[77,1,"ぞう"],[80,1,"い"],[82,1,"ぞう"],[87,1,"めい"]],"text":"いにしえから、かの事をあなたに告げ、その成らないさきに、これをあなたに聞かせた。そうでなければ、あなたは言うだろう、『わが偶像がこれをしたのだ、わが刻んだ像と、鋳た像がこれを命じたのだ』と。"},{"ref":"Isa.48.6","start":23048006,"end":23048006,"break":"line","breaks":[[11,"line"],[26,"line"],[44,"line"],[56,"line"],[71,"line"]],"ruby":[[7,1,"き"],[17,1,"な"],[23,1,"み"],[35,1,"の"],[37,1,"つた"],[48,1,"いま"],[51,1,"あたら"],[54,1,"こと"],[62,1,"し"],[66,1,"かく"],[69,1,"こと"],[75,1,"き"]],"text":"あなたはすでに聞いた、すべてこれが成ったことを見よ。あなたがたはこれを宣べ伝えないのか。わたしは今から新しい事、あなたがまだ知らない隠れた事をあなたに聞かせよう。"},{"ref":"Isa.48.7","start":23048007,"end":23048007,"break":"line","breaks":[[16,"line"],[31,"line"],[53,"line"],[71,"line"]],"ruby":[[4,1,"こと"],[8,2,"そうぞう"],[33,1,"ひ"],[34,2,"いぜん"],[46,1,"き"],[65,1,"い"],[72,1,"み"],[82,1,"し"]],"text":"これらの事はいま創造されたので、いにしえからあったのではない。この日以前には、あなたはこれを聞かなかった。そうでなければ、あなたは言うだろう、『見よ、わたしはこれを知っていた』と。"},{"ref":"Isa.48.8","start":23048008,"end":23048008,"break":"line","breaks":[[23,"line"],[44,"line"],[59,"line"],[77,"line"]],"ruby":[[7,1,"き"],[15,1,"し"],[27,1,"みみ"],[36,1,"ひら"],[52,1,"まった"],[54,3,"ふしんじつ"],[59,1,"うま"],[64,3,"はんぎゃくしゃ"],[77,1,"し"]],"text":"あなたはこれを聞くこともなく、知ることもなく、あなたの耳は、いにしえから開かれなかった。わたしはあなたが全く不信実で、生れながら反逆者ととなえられたことを知っていたからである。"},{"ref":"Isa.48.9","start":23048009,"end":23048009,"break":"line","breaks":[[21,"line"],[41,"line"]],"ruby":[[2,1,"な"],[12,1,"いか"],[23,1,"ほまれ"],[45,1,"た"],[47,1,"ほろ"]],"text":"わが名のために、わたしは怒りをおそくする。わが誉のために、わたしはこれをおさえて、あなたを断ち滅ぼすことをしない。"},{"ref":"Isa.48.10","start":23048010,"end":23048010,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[0,1,"み"],[11,1,"ね"],[18,1,"ぎん"],[29,1,"くる"],[33,1,"ろ"],[42,1,"こころ"]],"text":"見よ、わたしはあなたを練った。しかし銀のようにではなくて、苦しみの炉をもってあなたを試みた。"},{"ref":"Isa.48.11","start":23048011,"end":23048011,"break":"line","breaks":[[23,"line"],[43,"line"],[52,"line"]],"ruby":[[4,2,"じぶん"],[11,2,"じぶん"],[20,1,"おこな"],[29,1,"な"],[31,1,"けが"],[49,2,"えいこう"],[55,1,"もの"],[57,1,"あた"]],"text":"わたしは自分のために、自分のためにこれを行う。どうしてわが名を汚させることができよう。わたしはわが栄光をほかの者に与えることをしない。"},{"ref":"Isa.48.12","start":23048012,"end":23048012,"break":"paragraph","breaks":[[19,"line"],[26,"line"],[44,"line"]],"ruby":[[9,1,"め"],[23,1,"き"],[38,1,"はじ"],[50,1,"おわ"]],"text":"ヤコブよ、わたしの召したイスラエルよ、わたしに聞け。わたしはそれだ、わたしは初めであり、わたしはまた終りである。"},{"ref":"Isa.48.13","start":23048013,"end":23048013,"break":"line","breaks":[[11,"line"],[23,"line"]],"ruby":[[2,1,"て"],[4,1,"ち"],[6,1,"もとい"],[13,1,"みぎ"],[15,1,"て"],[17,1,"てん"],[27,1,"よ"],[31,1,"かれ"],[39,1,"た"]],"text":"わが手は地の基をすえ、わが右の手は天をのべた。わたしが呼ぶと、彼らはもろともに立つ。"},{"ref":"Isa.48.14","start":23048014,"end":23048014,"break":"line","breaks":[[14,"line"],[34,"line"],[43,"line"],[58,"line"]],"ruby":[[6,1,"みな"],[7,1,"あつ"],[11,1,"き"],[14,1,"かれ"],[27,1,"こと"],[29,1,"つ"],[34,1,"しゅ"],[36,1,"あい"],[41,1,"かれ"],[43,1,"しゅ"],[55,1,"おこな"],[60,1,"うで"],[69,1,"うえ"],[71,1,"のぞ"]],"text":"あなたがたは皆集まって聞け。彼らのうち、だれがこれらの事を告げたか。主の愛せられる彼は主のみこころをバビロンに行い、その腕はカルデヤびとの上に臨む。"},{"ref":"Isa.48.15","start":23048015,"end":23048015,"break":"line","breaks":[[16,"line"],[26,"line"],[37,"line"]],"ruby":[[0,1,"かた"],[20,1,"かれ"],[22,1,"め"],[30,1,"かれ"],[37,1,"かれ"],[41,1,"みち"],[43,1,"さか"]],"text":"語ったのは、ただわたしであって、わたしは彼を召した。わたしは彼をこさせた。彼はその道に栄える。"},{"ref":"Isa.48.16","start":23048016,"end":23048016,"break":"line","breaks":[[21,"line"],[41,"line"],[64,"line"]],"ruby":[[10,2,"ちかよ"],[18,1,"き"],[25,1,"はじ"],[34,1,"かた"],[44,1,"な"],[47,1,"とき"],[66,1,"しゅ"],[69,1,"かみ"],[78,1,"れい"]],"text":"あなたがたはわたしに近寄って、これを聞け。わたしは初めから、ひそかに語らなかった。それが成った時から、わたしはそこにいたのだ」。いま主なる神は、わたしとその霊とをつかわされた。"},{"ref":"Isa.48.17","start":23048017,"end":23048017,"break":"paragraph","breaks":[[19,"line"],[28,"line"],[44,"line"],[67,"line"]],"ruby":[[8,1,"ぬし"],[16,2,"せいじゃ"],[19,1,"しゅ"],[23,1,"い"],[37,1,"かみ"],[39,1,"しゅ"],[53,2,"りえき"],[64,1,"おし"],[71,1,"みちび"],[77,1,"い"],[81,1,"みち"],[83,1,"い"]],"text":"あなたのあがない主、イスラエルの聖者、主はこう言われる、「わたしはあなたの神、主である。わたしは、あなたの利益のために、あなたを教え、あなたを導いて、その行くべき道に行かせる。"},{"ref":"Isa.48.18","start":23048018,"end":23048018,"break":"line","breaks":[[23,"line"],[42,"line"]],"ruby":[[12,1,"いまし"],[15,1,"き"],[17,1,"したが"],[33,2,"へいあん"],[36,1,"かわ"],[46,1,"ぎ"],[48,1,"うみ"],[50,1,"なみ"]],"text":"どうか、あなたはわたしの戒めに聞き従うように。そうすれば、あなたの平安は川のように、あなたの義は海の波のようになり、"},{"ref":"Isa.48.19","start":23048019,"end":23048019,"break":"line","breaks":[[13,"line"],[30,"line"]],"ruby":[[7,1,"すな"],[17,2,"しそん"],[20,2,"すなつぶ"],[32,1,"な"],[36,1,"まえ"],[39,1,"た"],[48,1,"ほろ"]],"text":"あなたのすえは砂のように、あなたの子孫は砂粒のようになって、その名はわが前から断たれることなく、滅ぼされることはない」。"},{"ref":"Isa.48.20","start":23048020,"end":23048020,"break":"paragraph","breaks":[[14,"line"],[25,"line"],[42,"line"],[53,"line"]],"ruby":[[12,1,"で"],[25,1,"よろこ"],[28,1,"こえ"],[38,1,"き"],[42,1,"ち"],[44,1,"はて"],[48,1,"かた"],[50,1,"つた"],[54,1,"しゅ"],[73,1,"い"]],"text":"あなたがたはバビロンから出、カルデヤからのがれよ。喜びの声をもってこれをのべ聞かせ、地の果にまで語り伝え、「主はそのしもべヤコブをあがなわれた」と言え。"},{"ref":"Isa.48.21","start":23048021,"end":23048021,"break":"line","breaks":[[22,"line"],[38,"line"],[56,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"みちび"],[13,1,"とお"],[22,1,"かれ"],[38,1,"しゅ"],[40,1,"かれ"],[46,1,"いわ"],[49,1,"みず"],[51,1,"なが"],[58,1,"いわ"],[60,1,"さ"],[66,1,"みず"],[73,1,"で"]],"text":"主が彼らを導いて、さばくを通らせられたとき、彼らは、かわいたことがなかった。主は彼らのために岩から水を流れさせ、また岩を裂かれると、水がほとばしり出た。"},{"ref":"Isa.48.22","start":23048022,"end":23048022,"break":"line","breaks":[[7,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"わる"],[10,1,"もの"],[13,2,"へいあん"]],"text":"主は言われた、「悪い者には平安がない」と。"}]