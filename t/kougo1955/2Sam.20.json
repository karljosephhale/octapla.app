[{"ref":"2Sam.20.1","start":10020001,"end":10020001,"break":"paragraph","ruby":[[5,1,"ところ"],[16,1,"ひと"],[22,1,"な"],[35,1,"こ"],[50,1,"かれ"],[56,1,"ふ"],[59,1,"い"],[76,1,"ぶん"],[88,1,"こ"],[93,1,"し"],[94,1,"ぎょう"],[96,1,"も"],[114,2,"てんまく"],[117,1,"かえ"]],"text":"さて、その所にひとりのよこしまな人があって、名をシバといった。ビクリの子で、ベニヤミンびとであった。彼はラッパを吹いて言った、「われわれはダビデのうちに分がない。またエッサイの子のうちに嗣業を持たない。イスラエルよ、おのおのその天幕に帰りなさい」。"},{"ref":"2Sam.20.2","start":10020002,"end":10020002,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"みな"],[17,1,"したが"],[19,1,"こと"],[29,1,"こ"],[33,1,"したが"],[43,2,"ひとびと"],[48,1,"おう"],[52,1,"したが"],[68,1,"い"]],"text":"そこでイスラエルの人々は皆ダビデに従う事をやめて、ビクリの子シバに従った。しかしユダの人々はその王につき従って、ヨルダンからエルサレムへ行った。"},{"ref":"2Sam.20.3","start":10020003,"end":10020003,"break":"paragraph","ruby":[[10,2,"じぶん"],[13,1,"いえ"],[21,1,"おう"],[23,1,"いえ"],[25,1,"まも"],[30,1,"のこ"],[37,1,"にん"],[45,1,"と"],[52,1,"いえ"],[54,1,"い"],[57,1,"まも"],[62,1,"やしな"],[67,2,"かのじょ"],[72,1,"ところ"],[84,2,"かのじょ"],[89,1,"し"],[91,1,"ひ"],[94,1,"と"],[100,2,"いっしょう"],[103,2,"かふ"]],"text":"ダビデはエルサレムの自分の家にきた。そして王は家を守るために残しておいた十人のめかけたちを取って、一つの家に入れて守り、また養ったが、彼女たちの所には、はいらなかった。彼女たちは死ぬ日まで閉じこめられ一生、寡婦としてすごした。"},{"ref":"2Sam.20.4","start":10020004,"end":10020004,"break":"paragraph","ruby":[[0,1,"おう"],[6,1,"い"],[18,1,"か"],[26,2,"ひとびと"],[29,1,"よ"],[31,1,"あつ"]],"text":"王はアマサに言った、「わたしのため三日のうちにユダの人々を呼び集めて、ここにきなさい」。"},{"ref":"2Sam.20.5","start":10020005,"end":10020005,"break":"none","ruby":[[7,1,"よ"],[9,1,"あつ"],[15,1,"い"],[20,1,"かれ"],[22,1,"さだ"],[27,1,"とき"]],"text":"アマサはユダを呼び集めるために行ったが、彼は定められた時よりもおくれた。"},{"ref":"2Sam.20.6","start":10020006,"end":10020006,"break":"none","ruby":[[10,1,"い"],[19,1,"こ"],[23,1,"いま"],[37,1,"おお"],[40,1,"がい"],[53,2,"しゅくん"],[56,2,"けらい"],[61,1,"ひき"],[65,1,"かれ"],[70,1,"お"],[81,1,"かれ"],[83,2,"けんご"],[86,2,"まちまち"],[89,1,"え"],[97,1,"なや"]],"text":"ダビデはアビシャイに言った、「ビクリの子シバは今われわれにアブサロムよりも多くの害をするであろう。あなたの主君の家来たちを率いて、彼のあとを追いなさい。さもないと彼は堅固な町々を獲て、われわれを悩ますであろう」。"},{"ref":"2Sam.20.7","start":10020007,"end":10020007,"break":"none","ruby":[[27,2,"ゆうし"],[36,1,"したが"],[39,1,"で"],[46,1,"かれ"],[55,1,"で"],[62,1,"こ"],[69,1,"お"]],"text":"こうしてヨアブとケレテびととペレテびと、およびすべての勇士はアビシャイに従って出た。すなわち彼らはエルサレムを出て、ビクリの子シバのあとを追った。"},{"ref":"2Sam.20.8","start":10020008,"end":10020008,"break":"none","ruby":[[0,1,"かれ"],[10,2,"おおいし"],[19,1,"とき"],[27,1,"かれ"],[30,1,"あ"],[34,1,"とき"],[40,2,"ぐんぷく"],[43,1,"き"],[46,1,"おび"],[53,1,"うえ"],[58,1,"おさ"],[65,1,"こし"],[67,1,"むす"],[70,1,"お"],[77,1,"かれ"],[79,1,"すす"],[81,1,"で"],[83,1,"とき"],[88,1,"ぬ"],[90,1,"お"]],"text":"彼らがギベオンにある大石のところにいた時、アマサがきて彼らに会った。時にヨアブは軍服を着て、帯をしめ、その上にさやに納めたつるぎを腰に結んで帯びていたが、彼が進み出た時つるぎは抜け落ちた。"},{"ref":"2Sam.20.9","start":10020009,"end":10020009,"break":"none","ruby":[[10,2,"きょうだい"],[18,1,"やす"],[26,1,"い"],[34,1,"みぎ"],[36,1,"て"],[48,1,"とら"],[51,1,"かれ"],[53,1,"くち"]],"text":"ヨアブはアマサに、「兄弟よ、あなたは安らかですか」と言って、ヨアブは右の手をもってアマサのひげを捕えて彼に口づけしようとしたが、"},{"ref":"2Sam.20.10","start":10020010,"end":10020010,"break":"none","breaks":[[80,"paragraph"]],"ruby":[[8,1,"て"],[19,1,"き"],[43,2,"ふくぶ"],[46,1,"さ"],[57,1,"ち"],[59,1,"なが"],[61,1,"だ"],[64,1,"かさ"],[67,1,"う"],[74,1,"かれ"],[76,1,"ころ"],[90,2,"きょうだい"],[102,1,"こ"],[109,1,"お"]],"text":"アマサはヨアブの手につるぎがあることに気づかなかったので、ヨアブはそれをもってアマサの腹部を刺して、そのはらわたを地に流し出し、重ねて撃つこともなく彼を殺した。こうしてヨアブとその兄弟アビシャイはビクリの子シバのあとを追った。"},{"ref":"2Sam.20.11","start":10020011,"end":10020011,"break":"none","ruby":[[0,1,"とき"],[6,2,"わかもの"],[22,1,"た"],[25,1,"い"],[34,2,"みかた"],[38,1,"もの"],[46,1,"もの"],[55,1,"したが"]],"text":"時にヨアブの若者のひとりがアマサのかたわらに立って言った、「ヨアブに味方する者、ダビデにつく者はヨアブのあとに従いなさい」。"},{"ref":"2Sam.20.12","start":10020012,"end":10020012,"break":"none","ruby":[[4,1,"ち"],[6,1,"し"],[9,2,"おおじ"],[12,1,"なか"],[29,1,"く"],[31,1,"もの"],[35,1,"かれ"],[37,1,"み"],[39,1,"た"],[48,1,"ひと"],[50,1,"たみ"],[54,1,"た"],[61,1,"み"],[68,2,"おおじ"],[72,1,"はたけ"],[74,1,"うつ"],[77,2,"いふく"],[82,1,"うえ"]],"text":"アマサは血に染んで大路の中にころがっていたので、そのそばに来る者はみな彼を見て立ちどまった。この人は民がみな立ちどまるのを見て、アマサを大路から畑に移し、衣服をその上にかけた。"},{"ref":"2Sam.20.13","start":10020013,"end":10020013,"break":"none","ruby":[[4,2,"おおじ"],[8,1,"うつ"],[15,1,"たみ"],[17,1,"みな"],[22,1,"したが"],[25,1,"すす"],[32,1,"こ"],[39,1,"お"]],"text":"アマサが大路から移されたので、民は皆ヨアブに従って進み、ビクリの子シバのあとを追った。"},{"ref":"2Sam.20.14","start":10020014,"end":10020014,"break":"paragraph","ruby":[[13,2,"ぶぞく"],[19,1,"とお"],[41,1,"みな"],[43,1,"あつ"],[49,1,"かれ"],[51,1,"したが"]],"text":"シバはイスラエルのすべての部族のうちを通ってベテマアカのアベルにきた。ビクリびとは皆、集まってきて彼に従った。"},{"ref":"2Sam.20.15","start":10020015,"end":10020015,"break":"none","ruby":[[7,1,"とも"],[15,2,"ひとびと"],[21,1,"かれ"],[33,1,"かこ"],[36,1,"まち"],[38,1,"む"],[42,1,"つち"],[43,1,"るい"],[45,1,"きず"],[56,1,"む"],[60,1,"た"],[70,1,"かれ"],[73,2,"じょうへき"],[86,1,"う"]],"text":"そこでヨアブと共にいたすべての人々がきて、彼をベテマアカのアベルに囲み、町に向かって土塁を築いた。それはとりでに向かって立てられた。こうして彼らは城壁をくずそうとしてこれを撃った。"},{"ref":"2Sam.20.16","start":10020016,"end":10020016,"break":"none","ruby":[[2,1,"とき"],[8,1,"かしこ"],[10,1,"おんな"],[12,1,"まち"],[15,1,"よ"],[28,1,"き"],[40,1,"き"],[70,1,"い"],[81,1,"い"]],"text":"その時、ひとりの賢い女が町から呼ばわった、「あなたがたは聞きなさい。あなたがたは聞きなさい。ヨアブに、『ここにきてください。わたしはあなたに言うことがあります』と言ってください」。"},{"ref":"2Sam.20.17","start":10020017,"end":10020017,"break":"none","ruby":[[0,1,"かれ"],[4,1,"おんな"],[6,2,"ちかよ"],[11,1,"おんな"],[26,1,"い"],[30,1,"かれ"],[39,1,"こた"],[46,1,"おんな"],[48,1,"かれ"],[56,2,"ことば"],[60,1,"き"],[68,1,"い"],[75,1,"き"],[83,1,"かれ"],[85,1,"い"]],"text":"彼がその女に近寄ると、女は「あなたがヨアブですか」と言った。彼は「そうです」と答えた。すると女は彼に「はしための言葉をお聞きください」と言ったので、「聞きましょう」と彼は言った。"},{"ref":"2Sam.20.18","start":10020018,"end":10020018,"break":"none","ruby":[[3,1,"おんな"],[5,1,"い"],[10,1,"むかし"],[12,2,"ひとびと"],[24,1,"たず"],[31,1,"い"],[35,1,"こと"],[37,1,"さだ"]],"text":"そこで女は言った、「昔、人々はいつも、『アベルで尋ねなさい』と言って、事を定めました。"},{"ref":"2Sam.20.19","start":10020019,"end":10020019,"break":"none","ruby":[[13,2,"へいわ"],[17,2,"ちゅうせい"],[20,1,"もの"],[45,1,"はは"],[52,1,"まち"],[54,1,"ほろ"],[71,1,"しゅ"],[73,1,"し"],[74,1,"ぎょう"],[79,1,"つく"]],"text":"わたしはイスラエルのうちの平和な、忠誠な者です。そうであるのに、あなたはイスラエルのうちで母ともいうべき町を滅ぼそうとしておられます。どうして主の嗣業を、のみ尽そうとされるのですか」。"},{"ref":"2Sam.20.20","start":10020020,"end":10020020,"break":"none","ruby":[[4,1,"こた"],[13,1,"けっ"],[30,1,"つく"],[35,1,"ほろ"]],"text":"ヨアブは答えた、「いいえ、決してそうではなく、わたしが、のみ尽したり、滅ぼしたりすることはありません。"},{"ref":"2Sam.20.21","start":10020021,"end":10020021,"break":"none","ruby":[[0,2,"じじつ"],[16,2,"さんち"],[19,1,"ひと"],[24,1,"こ"],[26,1,"な"],[33,1,"もの"],[35,1,"て"],[40,1,"おう"],[59,1,"かれ"],[64,1,"わた"],[76,1,"まち"],[78,1,"さ"],[84,1,"おんな"],[90,1,"い"],[95,1,"かれ"],[97,1,"くび"],[99,2,"じょうへき"],[102,1,"うえ"],[109,1,"ところ"],[111,1,"な"]],"text":"事実はそうではなく、エフライムの山地の人ビクリの子、名をシバという者が手をあげて王ダビデにそむいたのです。あなたがたが彼ひとりを渡すならば、わたしはこの町を去ります」。女はヨアブに言った、「彼の首は城壁の上からあなたの所へ投げられるでしょう」。"},{"ref":"2Sam.20.22","start":10020022,"end":10020022,"break":"none","ruby":[[6,1,"おんな"],[8,2,"ちえ"],[19,1,"たみ"],[21,1,"ところ"],[23,1,"い"],[29,1,"かれ"],[36,1,"こ"],[40,1,"くび"],[49,1,"ところ"],[51,1,"な"],[53,1,"だ"],[68,1,"ふ"],[77,2,"ひとびと"],[80,1,"ち"],[83,1,"まち"],[85,1,"さ"],[92,1,"いえ"],[94,1,"かえ"],[110,1,"おう"],[115,1,"かえ"]],"text":"こうしてこの女が知恵をもって、すべての民の所に行ったので、彼らはビクリの子シバの首をはねてヨアブの所へ投げ出した。そこでヨアブはラッパを吹きならしたので、人々は散って町を去り、おのおの家に帰った。ヨアブはエルサレムにいる王のもとに帰った。"},{"ref":"2Sam.20.23","start":10020023,"end":10020023,"break":"paragraph","ruby":[[10,1,"ぜん"],[11,1,"ぐん"],[13,1,"ちょう"],[24,1,"こ"],[44,1,"ちょう"]],"text":"ヨアブはイスラエルの全軍の長であった。エホヤダの子ベナヤはケレテびと、およびペレテびとの長、"},{"ref":"2Sam.20.24","start":10020024,"end":10020024,"break":"none","ruby":[[5,2,"ちょうぼ"],[7,1,"にん"],[9,1,"ちょう"],[16,1,"こ"],[23,2,"しかん"]],"text":"アドラムは徴募人の長、アヒルデの子ヨシャパテは史官、"},{"ref":"2Sam.20.25","start":10020025,"end":10020025,"break":"none","ruby":[[3,3,"しょきかん"],[18,2,"さいし"]],"text":"シワは書記官、ザドクとアビヤタルとは祭司。"},{"ref":"2Sam.20.26","start":10020026,"end":10020026,"break":"none","ruby":[[14,2,"さいし"]],"text":"またヤイルびとイラはダビデの祭司であった。"}]