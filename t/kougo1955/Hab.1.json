[{"ref":"Hab.1.1","start":35001001,"end":35001001,"break":"paragraph","ruby":[[0,3,"よげんしゃ"],[8,1,"み"],[10,1,"かみ"],[12,2,"たくせん"]],"text":"預言者ハバククが見た神の託宣。"},{"ref":"Hab.1.2","start":35001002,"end":35001002,"break":"line","breaks":[[15,"line"],[36,"line"],[57,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"よ"],[23,1,"き"],[28,1,"くだ"],[45,2,"ぼうぎゃく"],[52,1,"うった"],[61,1,"たす"],[64,1,"くだ"]],"text":"主よ、わたしが呼んでいるのに、いつまであなたは聞きいれて下さらないのか。わたしはあなたに「暴虐がある」と訴えたが、あなたは助けて下さらないのか。"},{"ref":"Hab.1.3","start":35001003,"end":35001003,"break":"line","breaks":[[20,"line"],[38,"line"],[53,"line"]],"ruby":[[4,1,"なに"],[17,1,"み"],[20,1,"なに"],[28,1,"わざわい"],[30,1,"み"],[38,2,"りゃくだつ"],[41,2,"ぼうぎゃく"],[48,1,"まえ"],[55,2,"ろんそう"],[61,2,"とうそう"],[64,1,"おこ"]],"text":"あなたは何ゆえ、わたしによこしまを見せ、何ゆえ、わたしに災を見せられるのか。略奪と暴虐がわたしの前にあり、また論争があり、闘争も起っている。"},{"ref":"Hab.1.4","start":35001004,"end":35001004,"break":"line","breaks":[[20,"line"]],"ruby":[[5,2,"りっぽう"],[12,2,"こうぎ"],[15,1,"おこな"],[20,2,"あくにん"],[23,2,"ぎじん"],[26,1,"かこ"],[29,2,"こうぎ"],[32,1,"ま"],[35,1,"おこな"]],"text":"それゆえ、律法はゆるみ、公義は行われず、悪人は義人を囲み、公義は曲げて行われている。"},{"ref":"Hab.1.5","start":35001005,"end":35001005,"break":"stanza","breaks":[[12,"line"],[22,"line"],[42,"line"],[54,"line"]],"ruby":[[0,1,"しょ"],[1,2,"こくみん"],[7,1,"のぞ"],[9,1,"み"],[12,1,"おどろ"],[18,1,"あや"],[32,1,"ひ"],[37,1,"こと"],[42,1,"ひと"],[46,1,"こと"],[48,1,"し"],[64,1,"しん"]],"text":"諸国民のうちを望み見て、驚け、そして怪しめ。わたしはあなたがたの日に一つの事をする。人がこの事を知らせても、あなたがたはとうてい信じまい。"},{"ref":"Hab.1.6","start":35001006,"end":35001006,"break":"line","breaks":[[17,"line"],[34,"line"],[45,"line"]],"ruby":[[0,1,"み"],[14,1,"おこ"],[24,1,"はげ"],[27,2,"こくみん"],[34,1,"ち"],[36,2,"じゅうおう"],[39,1,"ゆ"],[45,2,"じぶん"],[59,1,"うば"]],"text":"見よ、わたしはカルデヤびとを興す。これはたけく、激しい国民であって、地を縦横に行きめぐり、自分たちのものでないすみかを奪う。"},{"ref":"Hab.1.7","start":35001007,"end":35001007,"break":"line","breaks":[[13,"line"]],"ruby":[[8,1,"おそ"],[19,2,"いげん"],[23,1,"かれ"],[25,2,"じしん"],[29,1,"で"]],"text":"これはきびしく、恐ろしく、そのさばきと威厳とは彼ら自身から出る。"},{"ref":"Hab.1.8","start":35001008,"end":35001008,"break":"line","breaks":[[13,"line"],[25,"line"],[37,"line"],[55,"line"]],"ruby":[[2,1,"うま"],[10,1,"はや"],[13,1,"よる"],[22,1,"あら"],[27,2,"きへい"],[30,2,"いせい"],[34,1,"すす"],[44,2,"きへい"],[47,1,"とお"],[49,1,"ところ"],[52,1,"く"],[55,1,"かれ"],[58,1,"もの"],[60,1,"く"],[64,1,"いそ"],[72,1,"と"]],"text":"その馬はひょうよりも速く、夜のおおかみよりも荒い。その騎兵は威勢よく進む。すなわち、その騎兵は遠い所から来る。彼らは物を食おうと急ぐわしのように飛ぶ。"},{"ref":"Hab.1.9","start":35001009,"end":35001009,"break":"line","breaks":[[14,"line"],[31,"line"]],"ruby":[[0,1,"かれ"],[5,2,"ぼうぎゃく"],[11,1,"く"],[14,1,"かれ"],[17,1,"おそ"],[20,1,"おそ"],[23,1,"かれ"],[26,1,"まえ"],[28,1,"い"],[31,1,"かれ"],[38,1,"すな"],[43,1,"あつ"]],"text":"彼らはみな暴虐のために来る。彼らを恐れる恐れが彼らの前を行く。彼らはとりこを砂のように集める。"},{"ref":"Hab.1.10","start":35001010,"end":35001010,"break":"line","breaks":[[21,"line"],[35,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おう"],[7,1,"あなど"],[21,1,"かれ"],[28,1,"しろ"],[32,1,"わら"],[35,1,"つち"],[37,1,"つ"],[39,1,"あ"],[45,1,"うば"]],"text":"彼らは王たちを侮り、つかさたちをあざける。彼らはすべての城をあざ笑い、土を積み上げてこれを奪う。"},{"ref":"Hab.1.11","start":35001011,"end":35001011,"break":"line","breaks":[[24,"line"]],"ruby":[[5,1,"かれ"],[8,1,"かぜ"],[15,1,"たお"],[18,1,"い"],[20,1,"す"],[24,1,"かれ"],[27,2,"つみぶか"],[30,1,"もの"],[37,1,"ちから"],[39,1,"かみ"]],"text":"こうして、彼らは風のようになぎ倒して行き過ぎる。彼らは罪深い者で、おのれの力を神となす。"},{"ref":"Hab.1.12","start":35001012,"end":35001012,"break":"stanza","breaks":[[12,"line"],[34,"line"],[49,"line"],[72,"line"]],"ruby":[[2,1,"かみ"],[4,1,"しゅ"],[8,2,"せいじゃ"],[16,2,"えいえん"],[40,1,"し"],[49,1,"しゅ"],[56,1,"かれ"],[66,1,"そな"],[72,1,"いわ"],[79,1,"かれ"],[82,1,"こら"],[89,1,"た"]],"text":"わが神、主、わが聖者よ。あなたは永遠からいますかたではありませんか。わたしたちは死んではならない。主よ、あなたは彼らをさばきのために備えられた。岩よ、あなたは彼らを懲しめのために立てられた。"},{"ref":"Hab.1.13","start":35001013,"end":35001013,"break":"line","breaks":[[18,"line"],[35,"line"],[58,"line"],[82,"line"]],"ruby":[[4,1,"め"],[6,1,"きよ"],[9,1,"あく"],[11,1,"み"],[16,1,"もの"],[20,2,"ふぎ"],[23,1,"み"],[28,1,"もの"],[35,1,"なに"],[38,1,"ふ"],[39,2,"しんじつ"],[42,1,"もの"],[44,1,"め"],[58,1,"あ"],[61,1,"もの"],[63,2,"じぶん"],[68,1,"ただ"],[71,1,"もの"],[76,1,"く"],[82,1,"なに"],[85,1,"だま"]],"text":"あなたは目が清く、悪を見られない者、また不義を見られない者であるのに、何ゆえ不真実な者に目をとめていられるのですか。悪しき者が自分よりも正しい者を、のみ食らうのに、何ゆえ黙っていられるのですか。"},{"ref":"Hab.1.14","start":35001014,"end":35001014,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"ひと"],[6,1,"うみ"],[8,1,"うお"],[15,1,"おさ"],[18,1,"もの"],[22,1,"は"],[24,1,"むし"]],"text":"あなたは人を海の魚のようにし、治める者のない這う虫のようにされる。"},{"ref":"Hab.1.15","start":35001015,"end":35001015,"break":"line","breaks":[[19,"line"],[27,"line"],[37,"line"]],"ruby":[[0,1,"かれ"],[4,1,"ばり"],[16,1,"あ"],[19,1,"あみ"],[24,1,"とら"],[27,1,"ひ"],[29,1,"あみ"],[34,1,"あつ"],[41,1,"かれ"],[43,1,"よろこ"],[45,1,"たの"]],"text":"彼はつり針でこれをことごとくつり上げ、網でこれを捕え、引き網でこれを集め、こうして彼は喜び楽しむ。"},{"ref":"Hab.1.16","start":35001016,"end":35001016,"break":"line","breaks":[[18,"line"],[29,"line"],[45,"line"]],"ruby":[[5,1,"かれ"],[9,1,"あみ"],[11,2,"ぎせい"],[20,1,"ひ"],[22,1,"あみ"],[24,1,"こう"],[35,1,"かれ"],[42,1,"くら"],[47,2,"しょくもつ"],[50,1,"ゆた"]],"text":"それゆえ、彼はその網に犠牲をささげ、その引き網に香をたく。これによって彼はぜいたくに暮し、その食物も豊かになるからである。"},{"ref":"Hab.1.17","start":35001017,"end":35001017,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"かれ"],[13,1,"あみ"],[15,2,"えもの"],[18,1,"と"],[20,1,"い"],[24,2,"むじょう"],[28,1,"しょ"],[29,2,"こくみん"],[32,1,"ころ"]],"text":"それで、彼はいつまでもその網の獲物を取り入れて、無情にも諸国民を殺すのであろうか。"}]