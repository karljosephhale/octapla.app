[{"ref":"Jer.26.1","start":24026001,"end":24026001,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"こ"],[15,1,"よ"],[17,1,"おさ"],[20,1,"はじ"],[26,1,"しゅ"],[31,2,"ことば"]],"text":"ユダの王ヨシヤの子エホヤキムが世を治めた初めのころ、主からこの言葉があった、"},{"ref":"Jer.26.2","start":24026002,"end":24026002,"break":"none","ruby":[[1,1,"しゅ"],[5,1,"おお"],[11,1,"しゅ"],[13,1,"みや"],[15,1,"にわ"],[17,1,"た"],[28,1,"めい"],[31,1,"い"],[39,2,"ことば"],[43,1,"しゅ"],[45,1,"みや"],[47,1,"れい"],[48,1,"はい"],[54,1,"き"],[61,2,"まちまち"],[64,2,"ひとびと"],[67,1,"つ"],[75,1,"こと"],[78,1,"い"],[80,1,"のこ"]],"text":"「主はこう仰せられる、主の宮の庭に立ち、わたしがあなたに命じて言わせるすべての言葉を、主の宮で礼拝するために来ているユダの町々の人々に告げなさい。ひと言をも言い残しておいてはならない。"},{"ref":"Jer.26.3","start":24026003,"end":24026003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"き"],[13,1,"わる"],[15,1,"みち"],[17,1,"はな"],[27,1,"し"],[41,1,"かれ"],[44,1,"おこな"],[47,1,"わる"],[53,1,"わざわい"],[55,1,"かれ"],[58,1,"くだ"],[66,1,"おも"]],"text":"彼らが聞いて、おのおのその悪い道を離れることがあるかも知れない。そのとき、わたしは彼らの行いの悪いために、災を彼らに下そうとしたのを思いなおす。"},{"ref":"Jer.26.4","start":24026004,"end":24026004,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[14,1,"しゅ"],[18,1,"おお"],[36,1,"き"],[38,1,"したが"],[52,1,"まえ"],[54,1,"さだ"],[59,2,"りっぽう"],[62,1,"おこな"]],"text":"あなたは彼らに言いなさい、『主はこう仰せられる、もしあなたがたがわたしに聞き従わず、わたしがあなたがたの前に定めおいた律法を行わず、"},{"ref":"Jer.26.5","start":24026005,"end":24026005,"break":"none","ruby":[[29,3,"よげんしゃ"],[33,2,"ことば"],[36,1,"き"],[38,1,"したが"],[53,1,"き"],[55,1,"したが"]],"text":"わたしがあなたがたに、しきりにつかわすわたしのしもべである預言者の言葉に聞き従わないならば、（あなたがたは聞き従わなかったが、）"},{"ref":"Jer.26.6","start":24026006,"end":24026006,"break":"none","ruby":[[6,1,"みや"],[20,1,"まち"],[22,1,"ち"],[24,2,"ばんこく"]],"text":"わたしはこの宮をシロのようにし、またこの町を地の万国にのろわれるものとする』」。"},{"ref":"Jer.26.7","start":24026007,"end":24026007,"break":"paragraph","ruby":[[0,2,"さいし"],[3,3,"よげんしゃ"],[13,1,"たみ"],[21,1,"しゅ"],[23,1,"みや"],[29,2,"ことば"],[32,1,"かた"],[36,1,"き"]],"text":"祭司と預言者およびすべての民は、エレミヤが主の宮でこれらの言葉を語るのを聞いた。"},{"ref":"Jer.26.8","start":24026008,"end":24026008,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"めい"],[16,2,"ことば"],[19,1,"たみ"],[21,1,"つ"],[23,1,"おわ"],[26,1,"とき"],[28,2,"さいし"],[31,3,"よげんしゃ"],[37,1,"たみ"],[41,1,"かれ"],[43,1,"とら"],[46,1,"い"],[55,1,"し"]],"text":"エレミヤが主に命じられたすべての言葉を民に告げ終った時、祭司と預言者および民はみな彼を捕えて言った、「あなたは死ななければならない。"},{"ref":"Jer.26.9","start":24026009,"end":24026009,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"な"],[13,2,"よげん"],[19,1,"みや"],[32,1,"まち"],[34,1,"あら"],[38,1,"す"],[40,1,"ひと"],[51,1,"い"],[59,1,"たみ"],[63,1,"しゅ"],[65,1,"みや"],[67,1,"あつ"],[76,1,"と"],[78,1,"かこ"]],"text":"なぜあなたは主の名によって預言し、この宮はシロのようになり、この町は荒されて住む人もなくなるであろうと言ったのか」と。民はみな主の宮に集まってエレミヤを取り囲んだ。"},{"ref":"Jer.26.10","start":24026010,"end":24026010,"break":"paragraph","ruby":[[11,1,"こと"],[13,1,"き"],[16,1,"おう"],[18,2,"きゅうでん"],[21,1,"で"],[23,1,"しゅ"],[25,1,"みや"],[27,1,"のぼ"],[30,1,"しゅ"],[32,1,"みや"],[35,1,"あたら"],[38,1,"もん"],[41,2,"いりぐち"],[44,1,"ざ"]],"text":"ユダのつかさたちはこの事を聞いて王の宮殿を出て主の宮に上り、主の宮の「新しい門」の入口に座した。"},{"ref":"Jer.26.11","start":24026011,"end":24026011,"break":"none","ruby":[[0,2,"さいし"],[3,3,"よげんしゃ"],[19,1,"たみ"],[21,1,"うった"],[24,1,"い"],[31,1,"ひと"],[33,2,"しけい"],[36,1,"しょ"],[40,1,"もの"],[50,2,"じぶん"],[53,1,"みみ"],[55,1,"き"],[65,1,"まち"],[67,1,"さか"],[70,2,"よげん"]],"text":"祭司と預言者らは、つかさたちとすべての民に訴えて言った、「この人は死刑に処すべき者です。あなたがたが自分の耳で聞かれたように、この町に逆らう預言をしたのです」。"},{"ref":"Jer.26.12","start":24026012,"end":24026012,"break":"paragraph","ruby":[[2,1,"とき"],[19,1,"たみ"],[21,1,"い"],[26,1,"しゅ"],[39,1,"みや"],[43,1,"まち"],[50,2,"よげん"],[67,2,"ことば"],[76,1,"き"]],"text":"その時エレミヤは、つかさたちとすべての民に言った、「主はわたしをつかわし、この宮とこの町にむかって、預言をさせられたので、そのすべての言葉をあなたがたは聞いた。"},{"ref":"Jer.26.13","start":24026013,"end":24026013,"break":"none","ruby":[[10,1,"いま"],[18,1,"みち"],[20,1,"おこな"],[23,1,"あらた"],[32,1,"かみ"],[34,1,"しゅ"],[36,1,"こえ"],[38,1,"き"],[40,1,"したが"],[53,1,"しゅ"],[61,1,"わざわい"],[63,1,"くだ"],[72,1,"おも"]],"text":"それで、あなたがたは今、あなたがたの道と行いを改め、あなたがたの神、主の声に聞き従いなさい。そうするならば主はあなたがたに災を下そうとしたことを思いなおされる。"},{"ref":"Jer.26.14","start":24026014,"end":24026014,"break":"none","ruby":[[0,1,"み"],[13,1,"て"],[15,1,"なか"],[26,1,"め"],[29,1,"よ"],[32,1,"み"],[35,1,"ただ"],[39,1,"おも"],[48,1,"おこな"]],"text":"見よ、わたしはあなたがたの手の中にある。あなたがたの目に、良いと見え、正しいと思うことをわたしに行うがよい。"},{"ref":"Jer.26.15","start":24026015,"end":24026015,"break":"none","ruby":[[2,1,"あき"],[11,1,"し"],[32,1,"ころ"],[38,1,"つみ"],[41,1,"もの"],[43,1,"ち"],[51,1,"み"],[56,1,"まち"],[61,2,"じゅうみん"],[65,1,"き"],[73,1,"しゅ"],[91,2,"ことば"],[100,1,"みみ"],[103,1,"つ"]],"text":"ただ明らかにこのことを知っておきなさい。もしあなたがたがわたしを殺すならば、罪なき者の血はあなたがたの身と、この町と、その住民とに帰する。まことに主がわたしをつかわして、このすべての言葉をあなたがたの耳に、告げさせられたからである」。"},{"ref":"Jer.26.16","start":24026016,"end":24026016,"break":"paragraph","ruby":[[11,1,"たみ"],[15,2,"さいし"],[18,3,"よげんしゃ"],[22,1,"い"],[29,1,"ひと"],[31,2,"しけい"],[34,1,"しょ"],[38,1,"もの"],[49,1,"かみ"],[51,1,"しゅ"],[53,1,"な"],[63,1,"かた"]],"text":"つかさたちと、すべての民とは、祭司と預言者に言った、「この人は死刑に処すべき者ではない。われわれの神、主の名によってわれわれに語ったのである」。"},{"ref":"Jer.26.17","start":24026017,"end":24026017,"break":"none","ruby":[[2,1,"とき"],[5,1,"ち"],[7,2,"ちょうろう"],[11,2,"すうにん"],[14,1,"た"],[21,1,"あつ"],[31,1,"もの"],[33,1,"つ"],[36,1,"い"]],"text":"その時この地の長老たち数人が立って、そこに集まっているすべての者に告げて言った、"},{"ref":"Jer.26.18","start":24026018,"end":24026018,"break":"none","breaks":[[53,"stanza"],[66,"line"],[78,"line"]],"ruby":[[4,1,"おう"],[10,1,"よ"],[29,1,"たみ"],[31,2,"よげん"],[35,1,"い"],[40,2,"ばんぐん"],[43,1,"しゅ"],[47,1,"おお"],[57,1,"はたけ"],[62,1,"たがや"],[72,2,"いしづか"],[78,1,"みや"],[80,1,"やま"],[82,1,"き"],[86,1,"しげ"],[88,1,"たか"],[90,1,"ところ"]],"text":"「ユダの王ヒゼキヤの世に、モレシテびとミカはユダのすべての民に預言して言った、『万軍の主はこう仰せられる、シオンは畑のように耕され、エルサレムは石塚となり、宮の山は木のおい茂る高い所となる』。"},{"ref":"Jer.26.19","start":24026019,"end":24026019,"break":"none","ruby":[[3,1,"おう"],[17,1,"ひと"],[19,1,"かれ"],[21,1,"ころ"],[40,1,"しゅ"],[42,1,"おそ"],[45,1,"しゅ"],[47,1,"めぐ"],[50,1,"もと"],[56,1,"しゅ"],[58,1,"かれ"],[61,1,"わざわい"],[63,1,"くだ"],[67,1,"つ"],[75,1,"おも"],[98,2,"じぶん"],[101,1,"み"],[103,1,"おお"],[106,1,"わざわい"],[108,1,"まね"]],"text":"ユダの王ヒゼキヤと、すべてのユダの人は彼を殺そうとしたことがあろうか。ヒゼキヤは主を恐れ、主の恵みを求めたので、主は彼らに災を下すとお告げになったのを思いなおされたではないか。しかし、われわれは、自分の身に大きな災を招こうとしている」。"},{"ref":"Jer.26.20","start":24026020,"end":24026020,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"な"],[7,2,"よげん"],[11,1,"ひと"],[38,1,"こ"],[46,1,"かれ"],[59,2,"ことば"],[68,1,"まち"],[72,1,"ち"],[78,2,"よげん"]],"text":"主の名によって預言した人がほかにもあった。すなわちキリアテ・ヤリムのシマヤの子ウリヤである。彼はエレミヤとおなじような言葉をもって、この町とこの地にむかって預言した。"},{"ref":"Jer.26.21","start":24026021,"end":24026021,"break":"none","ruby":[[5,1,"おう"],[14,2,"ゆうし"],[30,2,"ことば"],[33,1,"き"],[40,1,"おう"],[42,1,"かれ"],[44,1,"ころ"],[48,1,"おも"],[60,1,"き"],[63,1,"おそ"],[71,1,"に"],[74,1,"い"]],"text":"エホヤキム王と、そのすべての勇士と、すべてのつかさたちはその言葉を聞いた。そして王は彼を殺そうと思ったが、ウリヤはこれを聞いて恐れ、エジプトに逃げて行ったので、"},{"ref":"Jer.26.22","start":24026022,"end":24026022,"break":"none","ruby":[[5,1,"おう"],[7,1,"ひと"],[29,1,"こ"],[36,1,"た"],[38,1,"すう"],[39,1,"めい"],[41,1,"ひと"]],"text":"エホヤキム王は人をエジプトにつかわした。すなわちアクボルの子エルナタンと他の数名の人を、エジプトにつかわした。"},{"ref":"Jer.26.23","start":24026023,"end":24026023,"break":"none","ruby":[[0,1,"かれ"],[13,1,"ひ"],[15,1,"だ"],[23,1,"おう"],[28,1,"つ"],[36,1,"おう"],[45,1,"かれ"],[47,1,"ころ"],[52,2,"したい"],[55,2,"きょうどう"],[57,2,"ぼち"],[60,1,"す"]],"text":"彼らはウリヤをエジプトから引き出し、エホヤキム王のもとに連れてきたので、王はつるぎをもって彼を殺し、その死体を共同墓地に捨てさせた。"},{"ref":"Jer.26.24","start":24026024,"end":24026024,"break":"paragraph","ruby":[[8,1,"こ"],[19,1,"たす"],[22,1,"たみ"],[24,1,"て"],[26,1,"わた"],[30,1,"ころ"]],"text":"しかしシャパンの子アヒカムはエレミヤを助け、民の手に渡されて殺されることのないようにした。"}]