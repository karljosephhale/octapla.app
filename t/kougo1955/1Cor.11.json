[{"ref":"1Cor.11.1","start":46011001,"end":46011001,"break":"paragraph","ruby":[[12,1,"もの"],[33,1,"もの"]],"text":"わたしがキリストにならう者であるように、あなたがたもわたしにならう者になりなさい。"},{"ref":"1Cor.11.2","start":46011002,"end":46011002,"break":"paragraph","ruby":[[7,1,"なに"],[16,1,"おぼ"],[28,1,"つた"],[35,2,"いいつた"],[39,1,"まも"],[51,2,"まんぞく"],[54,1,"おも"]],"text":"あなたがたが、何かにつけわたしを覚えていて、あなたがたに伝えたとおりに言伝えを守っているので、わたしは満足に思う。"},{"ref":"1Cor.11.3","start":46011003,"end":46011003,"break":"none","ruby":[[10,1,"し"],[25,1,"おとこ"],[39,1,"おんな"],[45,1,"おとこ"],[59,1,"かみ"]],"text":"しかし、あなたがたに知っていてもらいたい。すべての男のかしらはキリストであり、女のかしらは男であり、キリストのかしらは神である。"},{"ref":"1Cor.11.4","start":46011004,"end":46011004,"break":"none","ruby":[[0,1,"いのり"],[5,2,"よげん"],[13,1,"とき"],[19,1,"もの"],[24,1,"おとこ"],[39,1,"もの"]],"text":"祈をしたり預言をしたりする時、かしらに物をかぶる男は、そのかしらをはずかしめる者である。"},{"ref":"1Cor.11.5","start":46011005,"end":46011005,"break":"none","ruby":[[0,1,"いのり"],[5,2,"よげん"],[13,1,"とき"],[27,1,"おんな"],[42,1,"もの"],[51,1,"かみ"],[62,1,"おな"]],"text":"祈をしたり預言をしたりする時、かしらにおおいをかけない女は、そのかしらをはずかしめる者である。それは、髪をそったのとまったく同じだからである。"},{"ref":"1Cor.11.6","start":46011006,"end":46011006,"break":"none","ruby":[[2,1,"おんな"],[15,1,"かみ"],[17,1,"き"],[27,1,"かみ"],[29,1,"き"],[42,1,"おんな"],[47,1,"は"]],"text":"もし女がおおいをかけないなら、髪を切ってしまうがよい。髪を切ったりそったりするのが、女にとって恥ずべきことであるなら、おおいをかけるべきである。"},{"ref":"1Cor.11.7","start":46011007,"end":46011007,"break":"none","ruby":[[0,1,"おとこ"],[3,1,"かみ"],[11,2,"えいこう"],[23,1,"もの"],[35,1,"おんな"],[40,1,"おとこ"],[42,2,"こうえい"]],"text":"男は、神のかたちであり栄光であるから、かしらに物をかぶるべきではない。女は、また男の光栄である。"},{"ref":"1Cor.11.8","start":46011008,"end":46011008,"break":"none","ruby":[[5,1,"おとこ"],[7,1,"おんな"],[10,1,"で"],[18,1,"おんな"],[20,1,"おとこ"],[23,1,"で"]],"text":"なぜなら、男が女から出たのではなく、女が男から出たのだからである。"},{"ref":"1Cor.11.9","start":46011009,"end":46011009,"break":"none","ruby":[[3,1,"おとこ"],[5,1,"おんな"],[10,1,"つく"],[20,1,"おんな"],[22,1,"おとこ"],[27,1,"つく"]],"text":"また、男は女のために造られたのではなく、女が男のために造られたのである。"},{"ref":"1Cor.11.10","start":46011010,"end":46011010,"break":"none","ruby":[[6,1,"おんな"],[13,2,"けんい"],[32,2,"てんし"]],"text":"それだから、女は、かしらに権威のしるしをかぶるべきである。それは天使たちのためでもある。"},{"ref":"1Cor.11.11","start":46011011,"end":46011011,"break":"none","ruby":[[3,1,"しゅ"],[10,1,"おとこ"],[15,1,"おんな"],[21,1,"おんな"],[26,1,"おとこ"]],"text":"ただ、主にあっては、男なしには女はないし、女なしには男はない。"},{"ref":"1Cor.11.12","start":46011012,"end":46011012,"break":"none","ruby":[[4,1,"おんな"],[6,1,"おとこ"],[9,1,"で"],[15,1,"おとこ"],[19,1,"おんな"],[22,1,"うま"],[42,1,"かみ"],[45,1,"で"]],"text":"それは、女が男から出たように、男もまた女から生れたからである。そして、すべてのものは神から出たのである。"},{"ref":"1Cor.11.13","start":46011013,"end":46011013,"break":"none","ruby":[[5,2,"じしん"],[8,2,"はんだん"],[18,1,"おんな"],[28,1,"かみ"],[30,1,"いの"]],"text":"あなたがた自身で判断してみるがよい。女がおおいをかけずに神に祈るのは、ふさわしいことだろうか。"},{"ref":"1Cor.11.14","start":46011014,"end":46011014,"break":"none","ruby":[[0,2,"しぜん"],[7,1,"おし"],[18,1,"おとこ"],[20,1,"なが"],[22,1,"かみ"],[27,1,"かれ"],[29,1,"はじ"]],"text":"自然そのものが教えているではないか。男に長い髪があれば彼の恥になり、"},{"ref":"1Cor.11.15","start":46011015,"end":46011015,"break":"none","ruby":[[0,1,"おんな"],[2,1,"なが"],[4,1,"かみ"],[9,2,"かのじょ"],[12,2,"こうえい"],[22,1,"なが"],[24,1,"かみ"],[30,1,"かわ"],[33,1,"おんな"],[35,1,"あた"]],"text":"女に長い髪があれば彼女の光栄になるのである。長い髪はおおいの代りに女に与えられているものだからである。"},{"ref":"1Cor.11.16","start":46011016,"end":46011016,"break":"none","ruby":[[11,2,"はんたい"],[14,2,"いけん"],[17,1,"も"],[27,2,"ふうしゅう"],[40,1,"かみ"],[42,1,"しょ"],[43,2,"きょうかい"]],"text":"しかし、だれかがそれに反対の意見を持っていても、そんな風習はわたしたちにはなく、神の諸教会にもない。"},{"ref":"1Cor.11.17","start":46011017,"end":46011017,"break":"paragraph","ruby":[[5,1,"つぎ"],[10,1,"めい"],[49,1,"あつ"],[53,2,"りえき"],[66,2,"そんしつ"]],"text":"ところで、次のことを命じるについては、あなたがたをほめるわけにはいかない。というのは、あなたがたの集まりが利益にならないで、かえって損失になっているからである。"},{"ref":"1Cor.11.18","start":46011018,"end":46011018,"break":"none","ruby":[[9,2,"きょうかい"],[12,1,"あつ"],[15,1,"とき"],[18,1,"たがい"],[20,1,"あいだ"],[22,2,"ぶんそう"],[35,1,"みみ"],[54,1,"しん"]],"text":"まず、あなたがたが教会に集まる時、お互の間に分争があることを、わたしは耳にしており、そしていくぶんか、それを信じている。"},{"ref":"1Cor.11.19","start":46011019,"end":46011019,"break":"none","ruby":[[11,1,"なか"],[18,1,"もの"],[20,1,"あき"],[32,2,"ぶんぱ"]],"text":"たしかに、あなたがたの中でほんとうの者が明らかにされるためには、分派もなければなるまい。"},{"ref":"1Cor.11.20","start":46011020,"end":46011020,"break":"none","ruby":[[10,2,"いっしょ"],[13,1,"あつ"],[19,1,"しゅ"],[21,2,"ばんさん"],[24,1,"まも"]],"text":"そこで、あなたがたが一緒に集まるとき、主の晩餐を守ることができないでいる。"},{"ref":"1Cor.11.21","start":46011021,"end":46011021,"break":"none","ruby":[[6,2,"しょくじ"],[9,1,"さい"],[11,2,"かくじ"],[14,2,"じぶん"],[17,2,"ばんさん"],[24,1,"さき"],[26,1,"た"],[32,1,"う"],[37,1,"ひと"],[43,1,"おも"],[47,1,"よ"],[52,1,"ひと"],[56,2,"しまつ"]],"text":"というのは、食事の際、各自が自分の晩餐をかってに先に食べるので、飢えている人があるかと思えば、酔っている人がある始末である。"},{"ref":"1Cor.11.22","start":46011022,"end":46011022,"break":"none","ruby":[[8,1,"の"],[10,1,"く"],[15,1,"いえ"],[27,1,"かみ"],[29,2,"きょうかい"],[32,1,"かろ"],[36,1,"まず"],[39,2,"ひとびと"],[61,1,"たい"],[68,1,"い"],[88,1,"こと"]],"text":"あなたがたには、飲み食いをする家がないのか。それとも、神の教会を軽んじ、貧しい人々をはずかしめるのか。わたしはあなたがたに対して、なんと言おうか。あなたがたを、ほめようか。この事では、ほめるわけにはいかない。"},{"ref":"1Cor.11.23","start":46011023,"end":46011023,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"う"],[24,1,"つた"],[37,1,"しゅ"],[43,1,"わた"],[47,1,"よ"]],"text":"わたしは、主から受けたことを、また、あなたがたに伝えたのである。すなわち、主イエスは、渡される夜、パンをとり、"},{"ref":"1Cor.11.24","start":46011024,"end":46011024,"break":"none","ruby":[[0,2,"かんしゃ"],[13,1,"い"],[47,2,"きねん"],[59,1,"おこな"]],"text":"感謝してこれをさき、そして言われた、「これはあなたがたのための、わたしのからだである。わたしを記念するため、このように行いなさい」。"},{"ref":"1Cor.11.25","start":46011025,"end":46011025,"break":"none","ruby":[[0,2,"しょくじ"],[6,1,"さかずき"],[9,1,"おな"],[16,1,"い"],[24,1,"さかずき"],[31,1,"ち"],[35,1,"あたら"],[38,2,"けいやく"],[44,1,"の"],[54,2,"きねん"],[65,1,"おこな"]],"text":"食事ののち、杯をも同じようにして言われた、「この杯は、わたしの血による新しい契約である。飲むたびに、わたしの記念として、このように行いなさい」。"},{"ref":"1Cor.11.26","start":46011026,"end":46011026,"break":"none","ruby":[[16,1,"しょく"],[21,1,"さかずき"],[23,1,"の"],[36,1,"しゅ"],[42,1,"とき"],[44,1,"いた"],[49,1,"しゅ"],[51,1,"し"],[53,1,"つ"],[55,1,"し"]],"text":"だから、あなたがたは、このパンを食し、この杯を飲むごとに、それによって、主がこられる時に至るまで、主の死を告げ知らせるのである。"},{"ref":"1Cor.11.27","start":46011027,"end":46011027,"break":"none","ruby":[[17,1,"しょく"],[19,1,"しゅ"],[21,1,"さかずき"],[23,1,"の"],[25,1,"もの"],[28,1,"しゅ"],[34,1,"ち"],[37,1,"おか"]],"text":"だから、ふさわしくないままでパンを食し主の杯を飲む者は、主のからだと血とを犯すのである。"},{"ref":"1Cor.11.28","start":46011028,"end":46011028,"break":"none","ruby":[[6,2,"じぶん"],[9,2,"ぎんみ"],[20,1,"た"],[22,1,"さかずき"],[24,1,"の"]],"text":"だれでもまず自分を吟味し、それからパンを食べ杯を飲むべきである。"},{"ref":"1Cor.11.29","start":46011029,"end":46011029,"break":"none","ruby":[[0,1,"しゅ"],[13,1,"の"],[15,1,"く"],[19,1,"もの"],[24,1,"の"],[26,1,"く"],[32,2,"じぶん"],[39,1,"まね"]],"text":"主のからだをわきまえないで飲み食いする者は、その飲み食いによって自分にさばきを招くからである。"},{"ref":"1Cor.11.30","start":46011030,"end":46011030,"break":"none","ruby":[[6,1,"なか"],[9,1,"よわ"],[11,1,"もの"],[13,2,"びょうにん"],[16,1,"おお"],[24,1,"ねむ"],[27,1,"もの"],[29,1,"すく"]],"text":"あなたがたの中に、弱い者や病人が大ぜいおり、また眠った者も少なくないのは、そのためである。"},{"ref":"1Cor.11.31","start":46011031,"end":46011031,"break":"none","ruby":[[4,2,"じぶん"]],"text":"しかし、自分をよくわきまえておくならば、わたしたちはさばかれることはないであろう。"},{"ref":"1Cor.11.32","start":46011032,"end":46011032,"break":"none","ruby":[[20,1,"よ"],[22,1,"とも"],[24,1,"つみ"],[26,1,"さだ"],[36,1,"しゅ"],[38,1,"こ"],[43,1,"う"]],"text":"しかし、さばかれるとすれば、それは、この世と共に罪に定められないために、主の懲らしめを受けることなのである。"},{"ref":"1Cor.11.33","start":46011033,"end":46011033,"break":"none","ruby":[[6,2,"きょうだい"],[12,2,"しょくじ"],[18,1,"あつ"],[21,1,"とき"],[25,1,"たがい"],[27,1,"ま"],[29,1,"あ"]],"text":"それだから、兄弟たちよ。食事のために集まる時には、互に待ち合わせなさい。"},{"ref":"1Cor.11.34","start":46011034,"end":46011034,"break":"none","ruby":[[2,2,"くうふく"],[14,1,"う"],[17,1,"あつ"],[30,1,"いえ"],[32,1,"た"],[44,1,"こと"],[51,1,"い"],[54,1,"とき"],[57,1,"さだ"]],"text":"もし空腹であったら、さばきを受けに集まることにならないため、家で食べるがよい。そのほかの事は、わたしが行った時に、定めることにしよう。"}]