[{"ref":"Deut.13.1","start":5013001,"end":5013001,"break":"paragraph","ruby":[[9,3,"よげんしゃ"],[15,1,"ゆめ"],[18,1,"もの"],[20,1,"た"],[28,2,"きせき"],[31,1,"しめ"]],"text":"あなたがたのうちに預言者または夢みる者が起って、しるしや奇跡を示し、"},{"ref":"Deut.13.2","start":5013002,"end":5013002,"break":"none","ruby":[[4,1,"つ"],[13,2,"きせき"],[16,2,"じつげん"],[29,1,"し"],[39,2,"かみがみ"],[48,1,"したが"],[50,1,"つか"],[56,1,"い"]],"text":"あなたに告げるそのしるしや奇跡が実現して、あなたがこれまで知らなかった『ほかの神々に、われわれは従い仕えよう』と言っても、"},{"ref":"Deut.13.3","start":5013003,"end":5013003,"break":"none","ruby":[[6,3,"よげんしゃ"],[12,1,"ゆめ"],[15,1,"もの"],[17,2,"ことば"],[20,1,"き"],[22,1,"したが"],[37,1,"かみ"],[39,1,"しゅ"],[47,1,"こころ"],[53,2,"せいしん"],[67,1,"かみ"],[69,1,"しゅ"],[71,1,"あい"],[80,1,"し"],[96,1,"こころ"]],"text":"あなたはその預言者または夢みる者の言葉に聞き従ってはならない。あなたがたの神、主はあなたがたが心をつくし、精神をつくして、あなたがたの神、主を愛するか、どうかを知ろうと、このようにあなたがたを試みられるからである。"},{"ref":"Deut.13.4","start":5013004,"end":5013004,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"したが"],[13,1,"あゆ"],[16,1,"かれ"],[18,1,"おそ"],[23,1,"いまし"],[26,1,"まも"],[31,2,"ことば"],[34,1,"き"],[36,1,"したが"],[39,1,"かれ"],[41,1,"つか"],[44,1,"かれ"],[48,1,"したが"]],"text":"あなたがたの神、主に従って歩み、彼を恐れ、その戒めを守り、その言葉に聞き従い、彼に仕え、彼につき従わなければならない。"},{"ref":"Deut.13.5","start":5013005,"end":5013005,"break":"none","ruby":[[2,3,"よげんしゃ"],[8,1,"ゆめ"],[11,1,"もの"],[13,1,"ころ"],[35,1,"くに"],[38,1,"みちび"],[40,1,"だ"],[43,2,"どれい"],[46,1,"いえ"],[61,1,"かみ"],[63,1,"しゅ"],[80,1,"かみ"],[82,1,"しゅ"],[84,1,"あゆ"],[87,1,"めい"],[92,1,"みち"],[94,1,"はな"],[103,1,"かた"],[125,1,"あく"],[127,1,"のぞ"],[129,1,"さ"]],"text":"その預言者または夢みる者を殺さなければならない。あなたがたをエジプトの国から導き出し、奴隷の家からあがなわれたあなたがたの神、主にあなたがたをそむかせ、あなたの神、主が歩めと命じられた道を離れさせようとして語るゆえである。こうしてあなたがたのうちから悪を除き去らなければならない。"},{"ref":"Deut.13.6","start":5013006,"end":5013006,"break":"paragraph","ruby":[[0,1,"おな"],[2,1,"はは"],[4,1,"うま"],[11,2,"きょうだい"],[25,1,"むすめ"],[39,1,"つま"],[48,2,"しんめい"],[51,1,"とも"],[55,1,"とも"],[62,1,"さそ"],[71,1,"い"],[74,1,"た"],[76,2,"かみがみ"],[79,1,"つか"],[85,1,"い"],[89,1,"し"],[101,2,"せんぞ"],[106,1,"し"],[112,2,"かみがみ"]],"text":"同じ母に生れたあなたの兄弟、またはあなたのむすこ、娘、またはあなたのふところの妻、またはあなたと身命を共にする友が、ひそかに誘って『われわれは行って他の神々に仕えよう』と言うかも知れない。これはあなたも先祖たちも知らなかった神々、"},{"ref":"Deut.13.7","start":5013007,"end":5013007,"break":"none","ruby":[[4,1,"ち"],[13,1,"ち"],[26,1,"ちか"],[33,1,"とお"],[40,2,"しゅうい"],[45,1,"たみ"],[47,2,"かみがみ"]],"text":"すなわち地のこのはてから、地のかのはてまで、あるいは近く、あるいは遠く、あなたの周囲にある民の神々である。"},{"ref":"Deut.13.8","start":5013008,"end":5013008,"break":"none","ruby":[[10,1,"ひと"],[12,1,"したが"],[23,1,"ひと"],[25,1,"い"],[30,1,"き"],[41,1,"ひと"],[56,1,"ひと"],[58,1,"お"],[70,1,"ひと"]],"text":"しかし、あなたはその人に従ってはならない。その人の言うことを聞いてはならない。その人をあわれんではならない。その人を惜しんではならない。その人をかばってはならない。"},{"ref":"Deut.13.9","start":5013009,"end":5013009,"break":"none","ruby":[[0,1,"かなら"],[2,1,"かれ"],[4,1,"ころ"],[15,1,"かれ"],[17,1,"ころ"],[28,1,"かれ"],[30,1,"て"],[32,1,"くだ"],[37,1,"のち"],[39,1,"たみ"],[43,1,"て"],[45,1,"くだ"]],"text":"必ず彼を殺さなければならない。彼を殺すには、あなたがまず彼に手を下し、その後、民がみな手を下さなければならない。"},{"ref":"Deut.13.10","start":5013010,"end":5013010,"break":"none","ruby":[[0,1,"かれ"],[7,1,"くに"],[9,2,"どれい"],[12,1,"いえ"],[19,1,"みちび"],[21,1,"だ"],[29,1,"かみ"],[31,1,"しゅ"],[38,1,"はな"],[58,1,"いし"],[63,1,"かれ"],[65,1,"う"],[67,1,"ころ"]],"text":"彼はエジプトの国、奴隷の家からあなたを導き出されたあなたの神、主からあなたを離れさせようとしたのであるから、あなたは石をもって彼を撃ち殺さなければならない。"},{"ref":"Deut.13.11","start":5013011,"end":5013011,"break":"none","ruby":[[11,1,"みな"],[12,1,"き"],[15,1,"おそ"],[18,1,"かさ"],[26,1,"わる"],[28,1,"こと"],[40,1,"おこな"]],"text":"そうすればイスラエルは皆聞いて恐れ、重ねてこのような悪い事を、あなたがたのうちに行わないであろう。"},{"ref":"Deut.13.12","start":5013012,"end":5013012,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[12,1,"あた"],[15,1,"す"],[22,1,"まち"]],"text":"あなたの神、主があなたに与えて住まわせられる町の一つで、"},{"ref":"Deut.13.13","start":5013013,"end":5013013,"break":"none","ruby":[[5,2,"ひとびと"],[17,1,"た"],[27,1,"し"],[37,2,"かみがみ"],[46,1,"い"],[49,1,"つか"],[55,1,"い"],[61,1,"まち"],[63,1,"す"],[65,2,"ひとびと"],[68,2,"ゆうわく"],[75,1,"き"]],"text":"よこしまな人々があなたがたのうちに起って、あなたがたの知らなかった『ほかの神々に、われわれは行って仕えよう』と言って、その町に住む人々を誘惑したことを聞くならば、"},{"ref":"Deut.13.14","start":5013014,"end":5013014,"break":"none","ruby":[[7,1,"たず"],[10,1,"さぐ"],[15,1,"と"],[38,1,"にく"],[42,1,"こと"],[53,1,"おこな"],[57,1,"こと"],[60,2,"しんじつ"],[64,1,"たし"]],"text":"あなたはそれを尋ね、探り、よく問いたださなければならない。そして、そのような憎むべき事があなたがたのうちに行われた事が、真実で、確かならば、"},{"ref":"Deut.13.15","start":5013015,"end":5013015,"break":"none","ruby":[[4,1,"かなら"],[9,1,"まち"],[11,1,"す"],[13,1,"もの"],[19,1,"は"],[24,1,"う"],[26,1,"ころ"],[31,1,"まち"],[45,1,"もの"],[52,2,"かちく"],[59,1,"は"],[70,1,"ほろ"]],"text":"あなたは必ず、その町に住む者をつるぎの刃にかけて撃ち殺し、その町と、そのうちにおるすべての者、およびその家畜をつるぎの刃にかけて、ことごとく滅ぼさなければならない。"},{"ref":"Deut.13.16","start":5013016,"end":5013016,"break":"none","ruby":[[12,1,"もの"],[15,1,"まち"],[17,2,"ひろば"],[20,2,"ちゅうおう"],[23,1,"あつ"],[26,1,"ひ"],[33,1,"まち"],[44,1,"もの"],[53,1,"や"],[61,1,"かみ"],[63,1,"しゅ"],[83,2,"あらつか"],[90,1,"ふたた"],[92,1,"た"],[94,1,"なお"]],"text":"またそのすべてのぶんどり物は、町の広場の中央に集め、火をもってその町と、すべてのぶんどり物とを、ことごとく焼いて、あなたの神、主にささげなければならない。これはながく荒塚となって、再び建て直されないであろう。"},{"ref":"Deut.13.17","start":5013017,"end":5013017,"break":"none","ruby":[[7,1,"もの"],[16,1,"て"],[18,1,"と"],[29,1,"しゅ"],[31,1,"はげ"],[34,1,"いか"],[44,2,"じひ"],[47,1,"ほどこ"],[60,2,"せんぞ"],[65,1,"ちか"],[77,1,"かず"],[79,1,"おお"]],"text":"そののろわれた物は一つもあなたの手に留めおいてはならない。主が激しい怒りをやめ、あなたに慈悲を施して、あなたをあわれみ、先祖たちに誓われたように、あなたの数を多くされるためである。"},{"ref":"Deut.13.18","start":5013018,"end":5013018,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,2,"ことば"],[11,1,"き"],[13,1,"したが"],[25,1,"めい"],[32,1,"いまし"],[35,1,"まも"],[42,1,"かみ"],[44,1,"しゅ"],[46,1,"ただ"],[50,1,"み"],[54,1,"こと"],[56,1,"おこな"]],"text":"あなたの神、主の言葉に聞き従い、わたしが、きょう、命じるすべての戒めを守り、あなたの神、主が正しいと見られる事を行うならば、このようになるであろう。"}]