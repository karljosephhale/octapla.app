[{"ref":"1Chr.21.1","start":13021001,"end":13021001,"break":"paragraph","ruby":[[0,1,"とき"],[6,1,"た"],[15,1,"てき"],[22,1,"うご"],[32,1,"かぞ"]],"text":"時にサタンが起ってイスラエルに敵し、ダビデを動かしてイスラエルを数えさせようとした。"},{"ref":"1Chr.21.2","start":13021002,"end":13021002,"break":"none","ruby":[[8,1,"ぐん"],[10,2,"しょうこう"],[15,1,"い"],[26,1,"い"],[48,1,"かぞ"],[53,1,"かず"],[55,1,"しら"],[62,1,"し"]],"text":"ダビデはヨアブと軍の将校たちに言った、「あなたがたは行って、ベエルシバからダンまでのイスラエルを数え、その数を調べてわたしに知らせなさい」。"},{"ref":"1Chr.21.3","start":13021003,"end":13021003,"break":"none","ruby":[[4,1,"い"],[25,1,"しゅ"],[29,1,"たみ"],[32,1,"ばい"],[34,1,"ま"],[45,1,"おう"],[48,1,"しゅ"],[51,1,"かれ"],[54,1,"みな"],[77,1,"しゅ"],[81,1,"こと"],[83,1,"もと"],[103,1,"つみ"],[105,1,"え"]],"text":"ヨアブは言った、「それがどのくらいあっても、どうか主がその民を百倍に増されるように。しかし王わが主よ、彼らは皆あなたのしもべではありませんか。どうしてわが主はこの事を求められるのですか。どうしてイスラエルに罪を得させられるのですか」。"},{"ref":"1Chr.21.4","start":13021004,"end":13021004,"break":"none","ruby":[[3,1,"おう"],[5,2,"ことば"],[12,1,"か"],[22,1,"で"],[24,1,"い"],[38,1,"い"],[40,1,"めぐ"],[49,1,"かえ"],[52,1,"き"]],"text":"しかし王の言葉がヨアブに勝ったので、ヨアブは出て行って、イスラエルをあまねく行き巡り、エルサレムに帰って来た。"},{"ref":"1Chr.21.5","start":13021005,"end":13021005,"break":"none","ruby":[[7,1,"たみ"],[9,2,"そうすう"],[16,1,"つ"],[35,1,"ぬ"],[37,1,"もの"],[42,1,"にん"],[52,1,"ぬ"],[54,1,"もの"],[60,1,"にん"]],"text":"そしてヨアブは民の総数をダビデに告げた。すなわちイスラエルにはつるぎを抜く者が百十万人、ユダにはつるぎを抜く者が四十七万人あった。"},{"ref":"1Chr.21.6","start":13021006,"end":13021006,"break":"none","ruby":[[7,1,"おう"],[9,2,"めいれい"],[12,1,"こころよ"],[35,1,"なか"],[37,1,"かぞ"]],"text":"しかしヨアブは王の命令を快しとしなかったので、レビとベニヤミンとはその中に数えなかった。"},{"ref":"1Chr.21.7","start":13021007,"end":13021007,"break":"paragraph","ruby":[[2,1,"こと"],[4,1,"かみ"],[6,1,"め"],[8,1,"わる"],[15,1,"かみ"],[23,1,"う"]],"text":"この事が神の目に悪かったので、神はイスラエルを撃たれた。"},{"ref":"1Chr.21.8","start":13021008,"end":13021008,"break":"none","ruby":[[7,1,"かみ"],[9,1,"い"],[20,1,"こと"],[22,1,"い"],[25,1,"おお"],[28,1,"つみ"],[30,1,"おか"],[39,1,"いま"],[48,1,"つみ"],[50,1,"のぞ"],[62,2,"ひじょう"],[65,1,"おろ"]],"text":"そこでダビデは神に言った、「わたしはこの事を行って大いに罪を犯しました。しかし今どうか、しもべの罪を除いてください。わたしは非常に愚かなことをいたしました」。"},{"ref":"1Chr.21.9","start":13021009,"end":13021009,"break":"none","ruby":[[0,1,"しゅ"],[6,3,"せんけんしゃ"],[12,1,"つ"],[15,1,"い"]],"text":"主はダビデの先見者ガデに告げて言われた、"},{"ref":"1Chr.21.10","start":13021010,"end":13021010,"break":"none","ruby":[[1,1,"い"],[8,1,"い"],[15,1,"しゅ"],[19,1,"おお"],[32,1,"こと"],[34,1,"しめ"],[46,1,"えら"],[63,1,"おこな"]],"text":"「行ってダビデに言いなさい、『主はこう仰せられる、わたしは三つの事を示す。あなたはその一つを選びなさい。わたしはそれをあなたに行おう』と」。"},{"ref":"1Chr.21.11","start":13021011,"end":13021011,"break":"none","ruby":[[10,1,"き"],[12,1,"い"],[17,1,"しゅ"],[21,1,"おお"],[33,1,"えら"]],"text":"ガデはダビデのもとに来て言った、「主はこう仰せられます、『あなたは選びなさい。"},{"ref":"1Chr.21.12","start":13021012,"end":13021012,"break":"none","ruby":[[5,1,"ねん"],[17,1,"がつ"],[19,1,"あいだ"],[28,1,"まえ"],[30,1,"やぶ"],[34,1,"てき"],[40,1,"お"],[53,1,"か"],[55,1,"あいだ"],[57,1,"しゅ"],[66,2,"えきびょう"],[71,1,"くに"],[77,1,"しゅ"],[79,1,"つかい"],[87,1,"ぜん"],[88,2,"りょういき"],[95,1,"ほろ"],[117,1,"こたえ"],[136,1,"き"]],"text":"すなわち三年のききんか、あるいは三月の間、あなたのあだの前に敗れて、敵のつるぎに追いつかれるか、あるいは三日の間、主のつるぎすなわち疫病がこの国にあって、主の使がイスラエルの全領域にわたって滅ぼすことをするか』。いま、わたしがどういう答をわたしをつかわしたものになすべきか決めなさい」。"},{"ref":"1Chr.21.13","start":13021013,"end":13021013,"break":"none","ruby":[[7,1,"い"],[16,2,"ひじょう"],[19,1,"なや"],[26,1,"しゅ"],[33,1,"おお"],[43,1,"しゅ"],[45,1,"て"],[47,1,"おちい"],[63,1,"ひと"],[65,1,"て"],[67,1,"おちい"]],"text":"ダビデはガデに言った、「わたしは非常に悩んでいるが、主のあわれみは大きいゆえ、わたしを主の手に陥らせてください。しかしわたしを人の手に陥らせないでください」。"},{"ref":"1Chr.21.14","start":13021014,"end":13021014,"break":"paragraph","ruby":[[3,1,"しゅ"],[11,2,"えきびょう"],[14,1,"くだ"],[33,1,"にん"],[35,1,"たお"]],"text":"そこで主はイスラエルに疫病を下されたので、イスラエルびとのうち七万人が倒れた。"},{"ref":"1Chr.21.15","start":13021015,"end":13021015,"break":"none","ruby":[[0,1,"かみ"],[5,1,"つかい"],[22,1,"ほろ"],[33,1,"つかい"],[38,1,"ほろ"],[48,1,"しゅ"],[50,1,"み"],[57,1,"わざわい"],[59,1,"く"],[64,1,"ほろ"],[68,1,"つかい"],[70,1,"い"],[85,1,"いま"],[90,1,"て"],[102,1,"しゅ"],[104,1,"つかい"],[116,1,"う"],[118,1,"ば"],[125,1,"た"]],"text":"神はまたみ使をエルサレムにつかわして、これを滅ぼそうとされたが、み使がまさに滅ぼそうとしたとき、主は見られて、この災を悔い、その滅ぼすみ使に言われた、「もうじゅうぶんだ。今あなたの手をとどめよ」。そのとき主の使はエブスびとオルナンの打ち場のかたわらに立っていた。"},{"ref":"1Chr.21.16","start":13021016,"end":13021016,"break":"none","ruby":[[4,1,"め"],[9,1,"み"],[13,1,"しゅ"],[15,1,"つかい"],[17,1,"ち"],[19,1,"てん"],[21,1,"あいだ"],[23,1,"た"],[27,1,"て"],[29,1,"ぬ"],[45,1,"うえ"],[49,1,"の"],[61,2,"ちょうろう"],[66,2,"あらぬの"],[69,1,"き"],[74,1,"ふ"]],"text":"ダビデが目をあげて見ると、主の使が地と天の間に立って、手に抜いたつるぎをもち、エルサレムの上にさし伸べていたので、ダビデと長老たちは荒布を着て、ひれ伏した。"},{"ref":"1Chr.21.17","start":13021017,"end":13021017,"break":"none","ruby":[[7,1,"かみ"],[9,1,"い"],[14,1,"たみ"],[16,1,"かぞ"],[20,1,"めい"],[37,1,"つみ"],[39,1,"おか"],[42,1,"わる"],[44,1,"こと"],[63,1,"ひつじ"],[65,1,"なに"],[75,1,"かみ"],[77,1,"しゅ"],[87,1,"て"],[98,1,"ちち"],[100,1,"いえ"],[113,1,"わざわい"],[119,1,"たみ"],[121,1,"くだ"]],"text":"そしてダビデは神に言った、「民を数えよと命じたのはわたしではありませんか。罪を犯し、悪い事をしたのはわたしです。しかしこれらの羊は何をしましたか。わが神、主よ、どうぞあなたの手をわたしと、わたしの父の家にむけてください。しかし災をあなたの民に下さないでください」。"},{"ref":"1Chr.21.18","start":13021018,"end":13021018,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,1,"つかい"],[9,1,"めい"],[16,1,"のぼ"],[19,1,"い"],[33,1,"う"],[35,1,"ば"],[37,1,"しゅ"],[45,2,"さいだん"],[48,1,"きず"],[53,1,"つ"]],"text":"時に主の使はガデに命じ、ダビデが上って行って、エブスびとオルナンの打ち場で主のために一つの祭壇を築くように告げさせた。"},{"ref":"1Chr.21.19","start":13021019,"end":13021019,"break":"none","ruby":[[10,1,"しゅ"],[12,1,"な"],[17,1,"つ"],[20,2,"ことば"],[23,1,"したが"],[26,1,"のぼ"],[29,1,"い"]],"text":"そこでダビデはガデが主の名をもって告げた言葉に従って上って行った。"},{"ref":"1Chr.21.20","start":13021020,"end":13021020,"break":"none","ruby":[[9,1,"むぎ"],[11,1,"う"],[25,1,"つかい"],[27,1,"み"],[37,1,"かれ"],[40,1,"にん"],[42,1,"こ"],[44,1,"み"]],"text":"そのときオルナンは麦を打っていたが、ふりかえってみ使を見たので、ともにいた彼の四人の子は身をかくした。"},{"ref":"1Chr.21.21","start":13021021,"end":13021021,"break":"none","ruby":[[9,1,"ちか"],[19,1,"め"],[21,1,"あ"],[28,1,"み"],[30,1,"う"],[32,1,"ば"],[35,1,"で"],[37,1,"き"],[39,1,"ち"],[43,1,"ふ"],[50,1,"はい"]],"text":"ダビデがオルナンに近づくと、オルナンは目を上げてダビデを見、打ち場から出て来て地にひれ伏してダビデを拝した。"},{"ref":"1Chr.21.22","start":13021022,"end":13021022,"break":"none","ruby":[[9,1,"い"],[16,1,"う"],[18,1,"ば"],[20,1,"ところ"],[26,1,"あた"],[36,1,"わざわい"],[38,1,"たみ"],[40,1,"くだ"],[54,1,"しゅ"],[62,2,"さいだん"],[65,1,"きず"],[83,1,"あたい"],[95,1,"あた"]],"text":"ダビデはオルナンに言った、「この打ち場の所をわたしに与えなさい。わたしは災が民に下るのをとどめるため、そこに主のために一つの祭壇を築きます。あなたは、そのじゅうぶんな価をとってこれをわたしに与えなさい」。"},{"ref":"1Chr.21.23","start":13021023,"end":13021023,"break":"none","ruby":[[9,1,"い"],[21,1,"と"],[30,1,"おう"],[33,1,"しゅ"],[35,1,"よ"],[38,1,"み"],[46,1,"おこな"],[56,1,"うし"],[58,2,"はんさい"],[65,1,"だ"],[66,1,"こっ"],[67,1,"き"],[77,1,"むぎ"],[79,2,"そさい"],[95,1,"みな"]],"text":"オルナンはダビデに言った、「どうぞこれをお取りなさい。そして王わが主の良しと見られるところを行いなさい。わたしは牛を燔祭のために、打穀機をたきぎのために、麦を素祭のためにささげます。わたしは皆これをささげます」。"},{"ref":"1Chr.21.24","start":13021024,"end":13021024,"break":"none","ruby":[[3,1,"おう"],[10,1,"い"],[29,2,"だいか"],[32,1,"はら"],[38,1,"か"],[47,1,"しゅ"],[59,1,"と"],[72,1,"つい"],[77,2,"はんさい"]],"text":"ダビデ王はオルナンに言った、「いいえ、わたしはじゅうぶんな代価を払ってこれを買います。わたしは主のためにあなたのものを取ることをしません。また、費えなしに燔祭をささげることをいたしません」。"},{"ref":"1Chr.21.25","start":13021025,"end":13021025,"break":"none","ruby":[[9,1,"ところ"],[14,1,"きん"],[31,1,"はら"]],"text":"それでダビデはその所のために金六百シケルをはかって、オルナンに払った。"},{"ref":"1Chr.21.26","start":13021026,"end":13021026,"break":"none","ruby":[[8,1,"しゅ"],[16,1,"ところ"],[21,2,"さいだん"],[24,1,"きず"],[27,2,"はんさい"],[30,3,"しゅうおんさい"],[39,1,"しゅ"],[41,1,"よ"],[45,1,"しゅ"],[47,2,"はんさい"],[50,2,"さいだん"],[53,1,"うえ"],[55,1,"てん"],[58,1,"ひ"],[60,1,"くだ"],[63,1,"こた"]],"text":"こうしてダビデは主のために、その所に一つの祭壇を築き、燔祭と酬恩祭をささげて、主を呼んだ。主は燔祭の祭壇の上に天から火を下して答えられた。"},{"ref":"1Chr.21.27","start":13021027,"end":13021027,"break":"none","ruby":[[2,1,"しゅ"],[5,1,"つかい"],[7,1,"めい"],[15,1,"かれ"]],"text":"また主がみ使に命じられたので、彼はつるぎをさやにおさめた。"},{"ref":"1Chr.21.28","start":13021028,"end":13021028,"break":"paragraph","ruby":[[2,1,"とき"],[7,1,"しゅ"],[19,1,"う"],[21,1,"ば"],[23,2,"じぶん"],[26,1,"こた"],[33,1,"み"],[40,1,"ところ"],[42,2,"ぎせい"]],"text":"その時ダビデは主がエブスびとオルナンの打ち場で自分に答えられたのを見たので、その所で犠牲をささげた。"},{"ref":"1Chr.21.29","start":13021029,"end":13021029,"break":"none","ruby":[[4,2,"あらの"],[7,1,"つく"],[10,1,"しゅ"],[12,2,"まくや"],[15,2,"はんさい"],[18,2,"さいだん"],[25,1,"とき"],[31,1,"たか"],[33,1,"ところ"]],"text":"モーセが荒野で造った主の幕屋と燔祭の祭壇とは、その時ギベオンの高き所にあったからである。"},{"ref":"1Chr.21.30","start":13021030,"end":13021030,"break":"none","ruby":[[9,1,"まえ"],[11,1,"い"],[14,1,"かみ"],[16,1,"もと"],[29,1,"かれ"],[31,1,"しゅ"],[33,1,"つかい"],[39,1,"おそ"]],"text":"しかしダビデはその前へ行って神に求めることができなかった。彼が主の使のつるぎを恐れたからである。"}]