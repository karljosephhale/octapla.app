[{"ref":"Ps.140.1","start":19140001,"end":19140001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[19,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"あ"],[6,2,"ひとびと"],[14,1,"たす"],[16,1,"だ"],[23,1,"まも"],[27,2,"らんぼう"],[30,2,"ひとびと"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"主よ、悪しき人々からわたしを助け出し、わたしを守って、乱暴な人々からのがれさせてください。"},{"ref":"Ps.140.2","start":19140002,"end":19140002,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こころ"],[8,1,"わる"],[10,1,"こと"],[16,1,"た"],[19,1,"たたか"],[22,1,"おこ"]],"text":"彼らは心のうちに悪い事をはかり、絶えず戦いを起します。"},{"ref":"Ps.140.3","start":19140003,"end":19140003,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[12,1,"した"],[14,1,"するど"],[25,1,"した"],[32,1,"どく"]],"text":"彼らはへびのようにおのが舌を鋭くし、そのくちびるの下にはまむしの毒があります。〔セラ"},{"ref":"Ps.140.4","start":19140004,"end":19140004,"break":"line","breaks":[[11,"line"],[25,"line"],[47,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"たも"],[11,1,"あ"],[14,1,"ひと"],[16,1,"て"],[29,1,"まも"],[35,1,"あし"],[47,2,"らんぼう"],[50,2,"ひとびと"]],"text":"主よ、わたしを保って、悪しき人の手からのがれさせ、わたしを守って、わが足をつまずかせようとする乱暴な人々からのがれさせてください。"},{"ref":"Ps.140.5","start":19140005,"end":19140005,"break":"line","breaks":[[18,"line"],[28,"line"]],"ruby":[[0,1,"たか"],[3,1,"もの"],[15,1,"ふ"],[18,1,"つな"],[23,1,"あみ"],[25,1,"は"],[28,1,"みち"],[37,1,"もう"]],"text":"高ぶる者はわたしのためにわなを伏せ、綱をもって網を張り、道のほとりにわなを設けました。〔セラ"},{"ref":"Ps.140.6","start":19140006,"end":19140006,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"い"],[18,1,"かみ"],[22,1,"しゅ"],[27,1,"ねが"],[30,1,"こえ"],[32,1,"みみ"],[34,1,"かたむ"]],"text":"わたしは主に言います、「あなたはわが神です。主よ、わが願いの声に耳を傾けてください。"},{"ref":"Ps.140.7","start":19140007,"end":19140007,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"すくい"],[4,1,"ちから"],[6,1,"しゅ"],[9,1,"かみ"],[16,1,"たたか"],[19,1,"ひ"]],"text":"わが救の力、主なる神よ、あなたは戦いの日に、わがこうべをおおわれました。"},{"ref":"Ps.140.8","start":19140008,"end":19140008,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"あ"],[6,1,"ひと"],[8,1,"ねが"],[24,1,"あ"],[27,2,"けいかく"]],"text":"主よ、悪しき人の願いをゆるさないでください。その悪しき計画をとげさせないでください。〔セラ"},{"ref":"Ps.140.9","start":19140009,"end":19140009,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"かこ"],[6,1,"もの"],[27,2,"がいあく"],[30,1,"かれ"]],"text":"わたしを囲む者がそのこうべをあげるとき、そのくちびるの害悪で彼らをおおってください。"},{"ref":"Ps.140.10","start":19140010,"end":19140010,"break":"line","breaks":[[18,"line"],[28,"line"]],"ruby":[[0,1,"も"],[3,1,"すみ"],[5,1,"かれ"],[8,1,"うえ"],[10,1,"おと"],[18,1,"かれ"],[21,1,"あな"],[23,1,"な"],[25,1,"い"],[28,1,"ふたた"],[30,1,"あ"]],"text":"燃える炭を彼らの上に落してください。彼らを穴に投げ入れ、再び上がることのできないようにしてください。"},{"ref":"Ps.140.11","start":19140011,"end":19140011,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"わるぐち"],[3,1,"い"],[5,1,"もの"],[7,1,"よ"],[9,1,"た"],[20,2,"らんぼう"],[23,1,"ひと"],[30,1,"わざわい"],[32,1,"お"],[34,1,"とら"]],"text":"悪口を言う者を世に立たせないでください。乱暴な人をすみやかに災に追い捕えさせてください」。"},{"ref":"Ps.140.12","start":19140012,"end":19140012,"break":"line","breaks":[[18,"line"],[33,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"くる"],[9,1,"もの"],[11,1,"うった"],[18,1,"まず"],[21,1,"もの"],[26,1,"ただ"],[33,1,"おこな"],[40,1,"し"]],"text":"わたしは主が苦しむ者の訴えをたすけ、貧しい者のために正しいさばきを行われることを知っています。"},{"ref":"Ps.140.13","start":19140013,"end":19140013,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"かなら"],[8,1,"な"],[10,2,"かんしゃ"],[14,1,"なお"],[16,1,"ひと"],[19,1,"まえ"],[21,1,"す"]],"text":"正しい人は必ずみ名に感謝し、直き人はみ前に住むでしょう。"}]