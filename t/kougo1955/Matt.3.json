[{"ref":"Matt.3.1","start":40003001,"end":40003001,"break":"paragraph","ruby":[[15,1,"あらわ"],[22,2,"あらの"],[25,1,"おしえ"],[27,1,"の"],[30,1,"い"]],"text":"そのころ、バプテスマのヨハネが現れ、ユダヤの荒野で教を宣べて言った、"},{"ref":"Matt.3.2","start":40003002,"end":40003002,"break":"none","ruby":[[1,1,"く"],[3,1,"あらた"],[7,2,"てんごく"],[10,1,"ちか"]],"text":"「悔い改めよ、天国は近づいた」。"},{"ref":"Matt.3.3","start":40003003,"end":40003003,"break":"none","breaks":[[11,"stanza"],[26,"line"],[35,"line"]],"ruby":[[0,3,"よげんしゃ"],[12,2,"あらの"],[15,1,"よ"],[19,1,"もの"],[21,1,"こえ"],[27,1,"しゅ"],[29,1,"みち"],[31,1,"そな"],[37,1,"みち"],[38,1,"すじ"],[50,1,"い"],[59,1,"ひと"]],"text":"預言者イザヤによって、「荒野で呼ばわる者の声がする、『主の道を備えよ、その道筋をまっすぐにせよ』」と言われたのは、この人のことである。"},{"ref":"Matt.3.4","start":40003004,"end":40003004,"break":"paragraph","ruby":[[11,1,"け"],[16,2,"きもの"],[21,1,"こし"],[23,1,"かわ"],[25,1,"おび"],[34,1,"の"],[35,1,"みつ"],[38,2,"しょくもつ"]],"text":"このヨハネは、らくだの毛ごろもを着物にし、腰に皮の帯をしめ、いなごと野蜜とを食物としていた。"},{"ref":"Matt.3.5","start":40003005,"end":40003005,"break":"none","ruby":[[13,2,"ぜんど"],[20,2,"ふきん"],[22,2,"いったい"],[25,2,"ひとびと"],[42,1,"で"]],"text":"すると、エルサレムとユダヤ全土とヨルダン附近一帯の人々が、ぞくぞくとヨハネのところに出てきて、"},{"ref":"Matt.3.6","start":40003006,"end":40003006,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"つみ"],[5,2,"こくはく"],[13,1,"がわ"],[26,1,"う"]],"text":"自分の罪を告白し、ヨルダン川でヨハネからバプテスマを受けた。"},{"ref":"Matt.3.7","start":40003007,"end":40003007,"break":"none","ruby":[[9,1,"びと"],[15,1,"びと"],[17,1,"おお"],[26,1,"う"],[37,1,"み"],[40,1,"かれ"],[43,1,"い"],[52,1,"こ"],[56,1,"せま"],[63,1,"かみ"],[65,1,"いか"],[87,1,"おし"]],"text":"ヨハネは、パリサイ人やサドカイ人が大ぜいバプテスマを受けようとしてきたのを見て、彼らに言った、「まむしの子らよ、迫ってきている神の怒りから、おまえたちはのがれられると、だれが教えたのか。"},{"ref":"Matt.3.8","start":40003008,"end":40003008,"break":"none","ruby":[[4,2,"くいあらた"],[13,1,"み"],[15,1,"むす"]],"text":"だから、悔改めにふさわしい実を結べ。"},{"ref":"Matt.3.9","start":40003009,"end":40003009,"break":"none","ruby":[[0,2,"じぶん"],[5,1,"ちち"],[20,1,"こころ"],[22,1,"なか"],[24,1,"おも"],[38,1,"い"],[44,1,"かみ"],[50,1,"いし"],[64,1,"こ"],[66,1,"おこ"]],"text":"自分たちの父にはアブラハムがあるなどと、心の中で思ってもみるな。おまえたちに言っておく、神はこれらの石ころからでも、アブラハムの子を起すことができるのだ。"},{"ref":"Matt.3.10","start":40003010,"end":40003010,"break":"none","ruby":[[0,1,"おの"],[5,1,"き"],[7,1,"ね"],[11,1,"お"],[22,1,"よ"],[24,1,"み"],[26,1,"むす"],[30,1,"き"],[37,1,"き"],[42,1,"ひ"],[44,1,"なか"],[46,1,"な"],[48,1,"こ"]],"text":"斧がすでに木の根もとに置かれている。だから、良い実を結ばない木はことごとく切られて、火の中に投げ込まれるのだ。"},{"ref":"Matt.3.11","start":40003011,"end":40003011,"break":"none","ruby":[[4,2,"くいあらた"],[12,1,"みず"],[26,1,"さづ"],[44,1,"く"],[46,1,"ひと"],[54,1,"ちから"],[78,1,"ね"],[91,2,"せいれい"],[94,1,"ひ"],[113,1,"さづ"]],"text":"わたしは悔改めのために、水でおまえたちにバプテスマを授けている。しかし、わたしのあとから来る人はわたしよりも力のあるかたで、わたしはそのくつをぬがせてあげる値うちもない。このかたは、聖霊と火とによっておまえたちにバプテスマをお授けになるであろう。"},{"ref":"Matt.3.12","start":40003012,"end":40003012,"break":"none","ruby":[[3,1,"み"],[5,1,"て"],[7,1,"も"],[11,1,"う"],[13,1,"ば"],[15,1,"むぎ"],[20,1,"わ"],[23,1,"むぎ"],[25,1,"くら"],[27,1,"おさ"],[33,1,"き"],[37,1,"ひ"],[39,1,"や"],[41,1,"す"]],"text":"また、箕を手に持って、打ち場の麦をふるい分け、麦は倉に納め、からは消えない火で焼き捨てるであろう」。"},{"ref":"Matt.3.13","start":40003013,"end":40003013,"break":"paragraph","ruby":[[14,1,"で"],[20,1,"がわ"],[22,1,"あらわ"],[42,1,"う"]],"text":"そのときイエスは、ガリラヤを出てヨルダン川に現れ、ヨハネのところにきて、バプテスマを受けようとされた。"},{"ref":"Matt.3.14","start":40003014,"end":40003014,"break":"none","ruby":[[12,1,"おも"],[24,1,"い"],[45,1,"う"]],"text":"ところがヨハネは、それを思いとどまらせようとして言った、「わたしこそあなたからバプテスマを受けるはずですのに、あなたがわたしのところにおいでになるのですか」。"},{"ref":"Matt.3.15","start":40003015,"end":40003015,"break":"none","ruby":[[8,1,"こた"],[11,1,"い"],[17,1,"いま"],[19,1,"う"],[40,1,"ただ"],[46,2,"じょうじゅ"],[81,1,"い"]],"text":"しかし、イエスは答えて言われた、「今は受けさせてもらいたい。このように、すべての正しいことを成就するのは、われわれにふさわしいことである」。そこでヨハネはイエスの言われるとおりにした。"},{"ref":"Matt.3.16","start":40003016,"end":40003016,"break":"none","ruby":[[10,1,"う"],[17,1,"みず"],[20,1,"あ"],[30,1,"み"],[33,1,"てん"],[35,1,"ひら"],[38,1,"かみ"],[40,2,"みたま"],[49,2,"じぶん"],[52,1,"うえ"],[54,1,"くだ"]],"text":"イエスはバプテスマを受けるとすぐ、水から上がられた。すると、見よ、天が開け、神の御霊がはとのように自分の上に下ってくるのを、ごらんになった。"},{"ref":"Matt.3.17","start":40003017,"end":40003017,"break":"none","ruby":[[2,1,"てん"],[5,1,"こえ"],[10,1,"い"],[22,1,"あい"],[25,1,"こ"],[31,1,"こころ"],[36,1,"もの"]],"text":"また天から声があって言った、「これはわたしの愛する子、わたしの心にかなう者である」。"}]