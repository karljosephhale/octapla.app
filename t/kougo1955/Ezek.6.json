[{"ref":"Ezek.6.1","start":26006001,"end":26006001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[10,1,"のぞ"],[13,1,"い"]],"text":"主の言葉が、わたしに臨んで言った、"},{"ref":"Ezek.6.2","start":26006002,"end":26006002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,1,"かお"],[18,2,"やまやま"],[21,1,"む"],[24,2,"よげん"]],"text":"「人の子よ、あなたの顔をイスラエルの山々に向け、預言して、"},{"ref":"Ezek.6.3","start":26006003,"end":26006003,"break":"none","ruby":[[0,1,"い"],[9,2,"やまやま"],[13,1,"しゅ"],[16,1,"かみ"],[18,2,"ことば"],[21,1,"き"],[24,1,"しゅ"],[27,1,"かみ"],[29,1,"やま"],[31,1,"おか"],[34,1,"たに"],[36,1,"かわ"],[38,1,"む"],[45,1,"い"],[50,1,"み"],[67,1,"おく"],[76,1,"たか"],[78,1,"ところ"],[80,1,"ほろ"]],"text":"言え。イスラエルの山々よ、主なる神の言葉を聞け。主なる神は山と丘と、谷と川に向かって、こう言われる、見よ、わたしはつるぎをあなたがたに送り、あなたがたの高き所を滅ぼす。"},{"ref":"Ezek.6.4","start":26006004,"end":26006004,"break":"none","ruby":[[6,2,"さいだん"],[9,1,"あら"],[19,1,"こう"],[21,2,"さいだん"],[40,2,"ぐうぞう"],[43,1,"まえ"],[52,1,"ころ"],[56,1,"もの"],[58,1,"な"],[60,1,"だ"]],"text":"あなたがたの祭壇は荒され、あなたがたの香の祭壇はこわされる。わたしはあなたがたの偶像の前に、あなたがたの殺された者を投げ出す。"},{"ref":"Ezek.6.5","start":26006005,"end":26006005,"break":"none","ruby":[[10,1,"たみ"],[12,2,"したい"],[15,1,"かれ"],[18,2,"ぐうぞう"],[21,1,"まえ"],[23,1,"お"],[26,1,"ほね"],[34,2,"さいだん"],[41,1,"ち"]],"text":"わたしはイスラエルの民の死体を彼らの偶像の前に置き、骨をあなたがたの祭壇のまわりに散らす。"},{"ref":"Ezek.6.6","start":26006006,"end":26006006,"break":"none","ruby":[[9,1,"す"],[11,1,"ところ"],[13,2,"まちまち"],[16,1,"ほろ"],[21,1,"たか"],[23,1,"ところ"],[25,1,"あら"],[40,2,"さいだん"],[46,1,"あら"],[56,2,"ぐうぞう"],[59,1,"くだ"],[63,1,"ほろ"],[72,1,"こう"],[74,2,"さいだん"],[77,1,"たお"],[90,1,"け"],[92,1,"さ"]],"text":"すべてあなたがたの住む所で町々は滅ぼされ、高き所は荒される。こうしてあなたがたの祭壇はこわし荒され、あなたがたの偶像は砕かれて滅び、あなたがたの香の祭壇は倒され、あなたがたのわざは消し去られる。"},{"ref":"Ezek.6.7","start":26006007,"end":26006007,"break":"none","ruby":[[2,1,"ころ"],[6,1,"もの"],[17,1,"たお"],[38,1,"しゅ"],[45,1,"し"]],"text":"また殺された者はあなたがたのうちに倒れる。これによって、あなたがたはわたしが主であることを知るようになる。"},{"ref":"Ezek.6.8","start":26006008,"end":26006008,"break":"paragraph","ruby":[[13,1,"もの"],[15,1,"い"],[37,2,"くにぐに"],[40,1,"なか"],[45,2,"くにぐに"],[48,1,"ち"],[53,1,"とき"]],"text":"わたしは、あなたがたのある者を生かしておく。あなたがたが、つるぎをのがれて国々の中におり、国々に散らされる時、"},{"ref":"Ezek.6.9","start":26006009,"end":26006009,"break":"none","ruby":[[13,1,"もの"],[18,1,"とら"],[20,1,"うつ"],[24,2,"くにぐに"],[27,1,"なか"],[33,1,"おも"],[35,1,"だ"],[46,1,"かれ"],[53,1,"はな"],[56,2,"かんいん"],[59,1,"こころ"],[62,2,"ぐうぞう"],[65,1,"した"],[68,2,"かんいん"],[71,1,"おこな"],[73,1,"め"],[87,1,"かれ"],[97,1,"にく"],[107,1,"おか"],[110,1,"あく"]],"text":"あなたがたのうちののがれた者は、その捕え移された国々の中でわたしを思い出す。これはわたしが、彼らのわたしを離れた姦淫の心と、偶像を慕って姦淫を行う目をくじくからである。そして彼らはそのもろもろの憎むべきことと、その犯した悪のために、みずからをいとうようになる。"},{"ref":"Ezek.6.10","start":26006010,"end":26006010,"break":"none","ruby":[[3,1,"かれ"],[10,1,"しゅ"],[17,1,"し"],[22,1,"わざわい"],[24,1,"かれ"],[27,1,"たい"],[30,1,"くだ"],[38,1,"い"],[43,1,"けっ"],[50,1,"こと"]],"text":"そして彼らはわたしが主であることを知る。この災を彼らに対して下すと、わたしが言ったのは決してむなしい事ではない」。"},{"ref":"Ezek.6.11","start":26006011,"end":26006011,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[17,1,"て"],[19,1,"う"],[22,1,"あし"],[24,1,"ふ"],[30,1,"い"],[42,1,"いえ"],[48,1,"あ"],[51,1,"にく"],[55,1,"もの"],[63,1,"かれ"],[76,2,"えきびょう"],[79,1,"たお"]],"text":"主なる神はこう言われる、「あなたは手を打ち、足を踏みならして言え。ああ、イスラエルの家のすべての悪しき憎むべき者はわざわいだ。彼らはつるぎと、ききんと、疫病に倒れるからである。"},{"ref":"Ezek.6.12","start":26006012,"end":26006012,"break":"none","ruby":[[0,1,"とお"],[5,1,"もの"],[7,2,"えきびょう"],[10,1,"し"],[13,1,"ちか"],[18,1,"もの"],[24,1,"たお"],[28,1,"い"],[30,1,"のこ"],[33,1,"み"],[35,1,"まっと"],[39,1,"もの"],[48,1,"し"],[62,1,"いきどお"],[65,1,"かれ"],[68,1,"うえ"],[70,1,"も"],[73,1,"つく"]],"text":"遠くにいる者は疫病で死に、近くにいる者はつるぎに倒れる。生き残って身を全うする者はききんによって死ぬ。このようにわたしはわが憤りを彼らの上に漏らし尽す。"},{"ref":"Ezek.6.13","start":26006013,"end":26006013,"break":"none","ruby":[[0,1,"かれ"],[3,1,"ころ"],[7,1,"もの"],[11,2,"ぐうぞう"],[14,1,"なか"],[21,2,"さいだん"],[35,1,"たか"],[37,1,"おか"],[39,1,"うえ"],[48,1,"やま"],[50,1,"いただき"],[59,1,"あお"],[60,1,"き"],[62,1,"した"],[71,1,"しげ"],[77,1,"き"],[79,1,"した"],[84,1,"かれ"],[101,2,"ぐうぞう"],[108,1,"ところ"],[112,1,"とき"],[124,1,"しゅ"],[131,1,"し"]],"text":"彼らの殺される者がその偶像の中にあり、その祭壇のまわりにあり、すべての高き丘の上にあり、すべての山の頂にあり、すべての青木の下にあり、すべての茂ったかしの木の下にあり、彼らがこうばしいかおりを、すべての偶像にささげた所にある時、あなたがたはわたしが主であることを知るのである。"},{"ref":"Ezek.6.14","start":26006014,"end":26006014,"break":"none","ruby":[[6,1,"て"],[8,1,"かれ"],[11,1,"うえ"],[13,1,"の"],[19,1,"ち"],[21,1,"あら"],[27,1,"かれ"],[30,1,"す"],[32,1,"ところ"],[35,2,"あらの"],[44,1,"あ"],[46,1,"ち"],[57,1,"かれ"],[64,1,"しゅ"],[71,1,"し"]],"text":"わたしはまた手を彼らの上に伸べて、その地を荒し、すべて彼らの住む所を、荒野からリブラまで荒れ地とする。これによって彼らはわたしが主であることを知るようになる」。"}]