[{"ref":"Judg.2.1","start":7002001,"end":7002001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[14,1,"のぼ"],[17,1,"い"],[38,1,"のぼ"],[49,2,"せんぞ"],[52,1,"ちか"],[55,1,"ち"],[57,1,"つ"],[63,1,"い"],[76,1,"むす"],[79,2,"けいやく"],[82,1,"けっ"],[85,1,"やぶ"]],"text":"主の使がギルガルからボキムに上って言った、「わたしはあなたがたをエジプトから上らせて、あなたがたの先祖に誓った地に連れてきて、言った、『わたしはあなたと結んだ契約を決して破ることはない。"},{"ref":"Judg.2.2","start":7002002,"end":7002002,"break":"none","ruby":[[8,1,"くに"],[10,2,"じゅうみん"],[13,2,"けいやく"],[16,1,"むす"],[25,1,"かれ"],[28,2,"さいだん"],[59,2,"めいれい"],[62,1,"したが"]],"text":"あなたがたはこの国の住民と契約を結んではならない。彼らの祭壇をこぼたなければならない』と。しかし、あなたがたはわたしの命令に従わなかった。あなたがたは、なんということをしたのか。"},{"ref":"Judg.2.3","start":7002003,"end":7002003,"break":"none","ruby":[[7,1,"い"],[21,1,"まえ"],[24,1,"かれ"],[27,1,"お"],[29,1,"はら"],[38,1,"かれ"],[51,1,"てき"],[56,1,"かれ"],[59,2,"かみがみ"]],"text":"それでわたしは言う、『わたしはあなたがたの前から彼らを追い払わないであろう。彼らはかえってあなたがたの敵となり、彼らの神々はあなたがたのわなとなるであろう』と」。"},{"ref":"Judg.2.4","start":7002004,"end":7002004,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[8,2,"ことば"],[21,2,"ひとびと"],[24,1,"つ"],[30,1,"たみ"],[32,1,"こえ"],[37,1,"な"]],"text":"主の使がこれらの言葉をイスラエルのすべての人々に告げたので、民は声をあげて泣いた。"},{"ref":"Judg.2.5","start":7002005,"end":7002005,"break":"none","ruby":[[5,1,"ところ"],[7,1,"な"],[13,1,"よ"],[20,1,"かれ"],[25,1,"ところ"],[27,1,"しゅ"],[29,2,"ぎせい"]],"text":"それでその所の名をボキムと呼んだ。そして彼らはその所で主に犠牲をささげた。"},{"ref":"Judg.2.6","start":7002006,"end":7002006,"break":"paragraph","ruby":[[5,1,"たみ"],[7,1,"さ"],[20,2,"ひとびと"],[29,2,"りょうち"],[32,1,"い"],[35,2,"とち"],[38,1,"え"]],"text":"ヨシュアが民を去らせたので、イスラエルの人々はおのおのその領地へ行って土地を獲た。"},{"ref":"Judg.2.7","start":7002007,"end":7002007,"break":"none","ruby":[[0,1,"たみ"],[7,3,"ざいせいちゅう"],[22,1,"い"],[24,1,"のこ"],[27,2,"ちょうろう"],[36,1,"しゅ"],[50,1,"おこな"],[58,1,"おお"],[65,1,"み"],[67,2,"ひとびと"],[70,3,"ざいせいちゅう"],[74,1,"しゅ"],[76,1,"つか"]],"text":"民はヨシュアの在世中も、またヨシュアのあとに生き残った長老たち、すなわち主がかつてイスラエルのために行われたすべての大いなるわざを見た人々の在世中も主に仕えた。"},{"ref":"Judg.2.8","start":7002008,"end":7002008,"break":"none","ruby":[[4,1,"しゅ"],[12,1,"こ"],[20,1,"さい"],[22,1,"し"]],"text":"こうして主のしもべヌンの子ヨシュアは百十歳で死んだ。"},{"ref":"Judg.2.9","start":7002009,"end":7002009,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"かれ"],[11,2,"さんち"],[17,1,"やま"],[19,1,"きた"],[32,1,"かれ"],[34,2,"りょうち"],[36,1,"うち"],[38,1,"ほうむ"]],"text":"人々は彼をエフライムの山地のガアシ山の北のテムナテ・ヘレスにある彼の領地内に葬った。"},{"ref":"Judg.2.10","start":7002010,"end":7002010,"break":"none","ruby":[[5,2,"じだい"],[8,1,"もの"],[19,2,"せんぞ"],[36,1,"のち"],[40,2,"じだい"],[43,1,"た"],[51,1,"しゅ"],[53,1,"し"],[59,1,"しゅ"],[70,1,"おこな"],[78,1,"し"]],"text":"そしてその時代の者もまたことごとくその先祖たちのもとにあつめられた。その後ほかの時代が起ったが、これは主を知らず、また主がイスラエルのために行われたわざをも知らなかった。"},{"ref":"Judg.2.11","start":7002011,"end":7002011,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"しゅ"],[11,1,"まえ"],[13,1,"あく"],[15,1,"おこな"],[27,1,"つか"]],"text":"イスラエルの人々は主の前に悪を行い、もろもろのバアルに仕え、"},{"ref":"Judg.2.12","start":7002012,"end":7002012,"break":"none","ruby":[[8,1,"ち"],[11,1,"かれ"],[14,1,"みちび"],[16,1,"だ"],[20,2,"せんぞ"],[25,1,"かみ"],[27,1,"しゅ"],[29,1,"す"],[36,2,"かみがみ"],[42,2,"しゅうい"],[47,2,"こくみん"],[50,2,"かみがみ"],[53,1,"したが"],[66,1,"しゅ"],[68,1,"いか"],[73,1,"おこ"]],"text":"かつてエジプトの地から彼らを導き出された先祖たちの神、主を捨てて、ほかの神々すなわち周囲にある国民の神々に従い、それにひざまずいて、主の怒りをひき起した。"},{"ref":"Judg.2.13","start":7002013,"end":7002013,"break":"none","ruby":[[4,1,"かれ"],[7,1,"しゅ"],[9,1,"す"],[23,1,"つか"]],"text":"すなわち彼らは主を捨てて、バアルとアシタロテに仕えたので、"},{"ref":"Judg.2.14","start":7002014,"end":7002014,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"いか"],[11,1,"たい"],[14,1,"も"],[20,1,"うば"],[22,1,"もの"],[24,1,"て"],[34,1,"うば"],[40,2,"しゅうい"],[48,1,"てき"],[50,1,"て"],[52,1,"う"],[59,1,"かれ"],[62,1,"ふたた"],[66,1,"てき"],[68,1,"た"],[70,1,"む"]],"text":"主の怒りがイスラエルに対して燃え、かすめ奪う者の手にわたして、かすめ奪わせ、かつ周囲のもろもろの敵の手に売られたので、彼らは再びその敵に立ち向かうことができなかった。"},{"ref":"Judg.2.15","start":7002015,"end":7002015,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[11,1,"しゅ"],[13,1,"て"],[15,1,"かれ"],[18,1,"わざわい"],[26,1,"しゅ"],[31,1,"い"],[37,1,"しゅ"],[39,1,"かれ"],[42,1,"ちか"],[51,1,"かれ"],[57,1,"なや"]],"text":"彼らがどこへ行っても、主の手は彼らに災をした。これは主がかつて言われ、また主が彼らに誓われたとおりで、彼らはひどく悩んだ。"},{"ref":"Judg.2.16","start":7002016,"end":7002016,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[13,1,"おこ"],[17,1,"かれ"],[23,1,"うば"],[25,1,"もの"],[27,1,"て"],[30,1,"すく"],[32,1,"だ"]],"text":"その時、主はさばきづかさを起して、彼らをかすめ奪う者の手から救い出された。"},{"ref":"Judg.2.17","start":7002017,"end":7002017,"break":"none","ruby":[[3,1,"かれ"],[16,1,"したが"],[27,2,"かみがみ"],[30,1,"した"],[36,2,"かんいん"],[39,1,"おこな"],[51,2,"せんぞ"],[56,1,"しゅ"],[58,2,"めいれい"],[61,1,"したが"],[64,1,"あゆ"],[67,1,"みち"],[75,1,"はな"],[77,1,"さ"],[87,1,"おこな"]],"text":"しかし彼らはそのさばきづかさにも従わず、かえってほかの神々を慕ってそれと姦淫を行い、それにひざまずき、先祖たちが主の命令に従って歩んだ道を、いちはやく離れ去って、そのようには行わなかった。"},{"ref":"Judg.2.18","start":7002018,"end":7002018,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[15,1,"おこ"],[31,3,"ざいせいちゅう"],[35,1,"しゅ"],[44,1,"とも"],[51,1,"かれ"],[54,1,"てき"],[56,1,"て"],[59,1,"すく"],[61,1,"だ"],[69,1,"かれ"],[72,2,"じぶん"],[79,1,"なや"],[83,1,"もの"],[92,1,"かな"],[99,1,"しゅ"],[101,1,"かれ"]],"text":"主が彼らのためにさばきづかさを起されたとき、そのさばきづかさの在世中、主はさばきづかさと共におられて、彼らを敵の手から救い出された。これは彼らが自分をしえたげ悩ました者のゆえに、うめき悲しんだので、主が彼らをあわれまれたからである。"},{"ref":"Judg.2.19","start":7002019,"end":7002019,"break":"none","ruby":[[10,1,"し"],[14,1,"かれ"],[22,2,"せんぞ"],[31,1,"あく"],[33,1,"おこな"],[39,2,"かみがみ"],[42,1,"したが"],[48,1,"つか"],[76,1,"みち"],[78,1,"はな"]],"text":"しかしさばきづかさが死ぬと、彼らはそむいて、先祖たちにまさって悪を行い、ほかの神々に従ってそれに仕え、それにひざまずいてそのおこないをやめず、かたくなな道を離れなかった。"},{"ref":"Judg.2.20","start":7002020,"end":7002020,"break":"none","ruby":[[3,1,"しゅ"],[11,1,"たい"],[13,1,"はげ"],[16,1,"いか"],[19,1,"い"],[27,1,"たみ"],[36,2,"せんぞ"],[41,1,"めい"],[44,2,"けいやく"],[47,1,"おか"],[54,2,"めいれい"],[57,1,"したが"]],"text":"それで主はイスラエルに対し激しく怒って言われた、「この民はわたしがかつて先祖たちに命じた契約を犯し、わたしの命令に従わないゆえ、"},{"ref":"Judg.2.21","start":7002021,"end":7002021,"break":"none","ruby":[[11,1,"し"],[17,1,"のこ"],[23,2,"こくみん"],[29,1,"のち"],[31,1,"かれ"],[34,1,"まえ"],[37,1,"お"],[39,1,"はら"]],"text":"わたしもまたヨシュアが死んだときに残しておいた国民を、この後、彼らの前から追い払わないであろう。"},{"ref":"Judg.2.22","start":7002022,"end":7002022,"break":"none","ruby":[[10,2,"せんぞ"],[15,1,"まも"],[21,1,"しゅ"],[23,1,"みち"],[25,1,"まも"],[31,1,"あゆ"],[42,1,"こころ"]],"text":"これはイスラエルが、先祖たちの守ったように主の道を守ってそれに歩むかどうかをわたしが試みるためである」。"},{"ref":"Judg.2.23","start":7002023,"end":7002023,"break":"none","ruby":[[4,1,"しゅ"],[10,2,"こくみん"],[13,1,"いそ"],[16,1,"お"],[18,1,"はら"],[22,1,"のこ"],[34,1,"て"]],"text":"それゆえ主はこれらの国民を急いで追い払わずに残しておいて、ヨシュアの手にわたされなかったのである。"}]