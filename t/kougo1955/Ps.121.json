[{"ref":"Ps.121.1","start":19121001,"end":19121001,"break":"paragraph","title":"都もうでの歌","breaks":[[16,"line"]],"ruby":[[4,1,"やま"],[10,1,"め"],[18,1,"たす"],[26,1,"く"]],"titleRuby":[[0,1,"みやこ"],[5,1,"うた"]],"text":"わたしは山にむかって目をあげる。わが助けは、どこから来るであろうか。"},{"ref":"Ps.121.2","start":19121002,"end":19121002,"break":"line","ruby":[[2,1,"たす"],[6,1,"てん"],[8,1,"ち"],[10,1,"つく"],[14,1,"しゅ"],[17,1,"く"]],"text":"わが助けは、天と地を造られた主から来る。"},{"ref":"Ps.121.3","start":19121003,"end":19121003,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"あし"],[8,1,"うご"],[26,1,"まも"],[28,1,"もの"]],"text":"主はあなたの足の動かされるのをゆるされない。あなたを守る者はまどろむことがない。"},{"ref":"Ps.121.4","start":19121004,"end":19121004,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"み"],[9,1,"まも"],[11,1,"もの"],[23,1,"ねむ"]],"text":"見よ、イスラエルを守る者はまどろむこともなく、眠ることもない。"},{"ref":"Ps.121.5","start":19121005,"end":19121005,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"まも"],[8,1,"もの"],[10,1,"しゅ"],[16,1,"みぎ"],[18,1,"て"],[23,1,"かげ"]],"text":"主はあなたを守る者、主はあなたの右の手をおおう陰である。"},{"ref":"Ps.121.6","start":19121006,"end":19121006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ひる"],[2,2,"たいよう"],[9,1,"う"],[16,1,"よる"],[18,1,"つき"],[24,1,"う"]],"text":"昼は太陽があなたを撃つことなく、夜は月があなたを撃つことはない。"},{"ref":"Ps.121.7","start":19121007,"end":19121007,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"まも"],[14,1,"わざわい"],[16,1,"まぬか"],[27,1,"いのち"],[29,1,"まも"]],"text":"主はあなたを守って、すべての災を免れさせ、またあなたの命を守られる。"},{"ref":"Ps.121.8","start":19121008,"end":19121008,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"いま"],[10,1,"いた"],[19,1,"で"],[22,1,"い"],[26,1,"まも"]],"text":"主は今からとこしえに至るまで、あなたの出ると入るとを守られるであろう。"}]