[{"ref":"Jer.47.1","start":24047001,"end":24047001,"break":"paragraph","ruby":[[8,1,"う"],[24,1,"こと"],[29,3,"よげんしゃ"],[37,1,"のぞ"],[40,1,"しゅ"],[42,2,"ことば"]],"text":"パロがまだガザを撃たなかったころ、ペリシテびとの事について預言者エレミヤに臨んだ主の言葉。"},{"ref":"Jer.47.2","start":24047002,"end":24047002,"break":"stanza","breaks":[[10,"line"],[28,"line"],[44,"line"],[65,"line"]],"ruby":[[1,1,"しゅ"],[5,1,"い"],[10,1,"み"],[13,1,"みず"],[15,1,"きた"],[18,1,"おこ"],[24,1,"なが"],[30,1,"ち"],[42,1,"もの"],[46,1,"まち"],[51,1,"なか"],[53,1,"す"],[55,1,"もの"],[67,1,"とき"],[69,2,"ひとびと"],[72,1,"さけ"],[77,1,"ち"],[79,1,"す"],[81,1,"もの"],[85,1,"なげ"]],"text":"「主はこう言われる、見よ、水は北から起り、あふれ流れて、この地と、そこにあるすべての物、その町と、その中に住む者とにあふれかかる。その時、人々は叫び、この地に住む者はみな嘆く。"},{"ref":"Jer.47.3","start":24047003,"end":24047003,"break":"line","breaks":[[23,"line"],[34,"line"],[48,"line"],[60,"line"]],"ruby":[[7,1,"うま"],[13,1,"ふ"],[15,1,"な"],[18,1,"おと"],[25,2,"せんしゃ"],[28,1,"ひび"],[36,2,"しゃりん"],[48,1,"ちち"],[52,1,"て"],[54,1,"よわ"],[60,2,"じぶん"],[63,1,"こ"],[66,1,"かえり"]],"text":"そのたくましい馬のひずめの踏み鳴らす音のため、その戦車の響きのため、その車輪のとどろきのために、父はその手が弱くなって、自分の子をも顧みない。"},{"ref":"Jer.47.4","start":24047004,"end":24047004,"break":"line","breaks":[[17,"line"],[34,"line"],[52,"line"],[67,"line"]],"ruby":[[11,1,"ほろ"],[14,1,"つく"],[24,1,"のこ"],[27,1,"たす"],[32,1,"もの"],[39,1,"た"],[42,1,"ひ"],[44,1,"く"],[52,1,"しゅ"],[59,2,"かいがん"],[62,1,"のこ"],[74,1,"ほろ"]],"text":"これは、ペリシテびとを滅ぼし尽し、ツロとシドンに残って助けをなす者をことごとく絶やす日が来るからである。主はカフトルの海岸に残っているペリシテびとを滅ぼされる。"},{"ref":"Jer.47.5","start":24047005,"end":24047005,"break":"line","breaks":[[18,"line"],[28,"line"],[40,"line"]],"ruby":[[4,1,"かみ"],[11,1,"はじ"],[24,1,"ほろ"],[34,1,"のこ"],[37,1,"たみ"],[44,2,"じぶん"],[47,1,"み"],[49,1,"きず"]],"text":"ガザには髪をそることが始まっている。アシケロンは滅びた。アナクびとの残りの民よ、いつまで自分の身に傷つけるのか。"},{"ref":"Jer.47.6","start":24047006,"end":24047006,"break":"line","breaks":[[7,"line"],[25,"line"]],"ruby":[[0,1,"しゅ"],[17,1,"しず"],[32,1,"かえ"],[35,1,"やす"],[38,1,"しず"]],"text":"主のつるぎよ、おまえはいつになれば静かになるのか。おまえのさやに帰り、休んで静かにしておれ。"},{"ref":"Jer.47.7","start":24047007,"end":24047007,"break":"line","breaks":[[14,"line"],[29,"line"],[46,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"いのち"],[7,1,"くだ"],[18,1,"しず"],[35,2,"かいがん"],[38,1,"ち"],[40,1,"せ"],[46,1,"さだ"]],"text":"主がこれに命を下されたのだ、どうして静かにしておれようか。アシケロンと海岸の地を攻めることを定められたのだ」。"}]