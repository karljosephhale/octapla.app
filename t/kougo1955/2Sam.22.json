[{"ref":"2Sam.22.1","start":10022001,"end":10022001,"break":"paragraph","ruby":[[4,1,"しゅ"],[11,1,"てき"],[13,1,"て"],[19,1,"て"],[23,2,"じぶん"],[26,1,"すく"],[28,1,"だ"],[32,1,"ひ"],[37,1,"うた"],[39,2,"ことば"],[42,1,"しゅ"],[44,1,"む"],[48,1,"の"]],"text":"ダビデは主がもろもろの敵の手とサウルの手から、自分を救い出された日に、この歌の言葉を主に向かって述べ、"},{"ref":"2Sam.22.2","start":10022002,"end":10022002,"break":"none","breaks":[[6,"stanza"]],"ruby":[[0,1,"かれ"],[2,1,"い"],[7,1,"しゅ"],[11,1,"いわ"],[15,1,"しろ"],[21,1,"すく"],[23,1,"もの"]],"text":"彼は言った、「主はわが岩、わが城、わたしを救う者、"},{"ref":"2Sam.22.3","start":10022003,"end":10022003,"break":"line","breaks":[[19,"line"],[29,"line"],[43,"line"]],"ruby":[[2,1,"かみ"],[6,1,"いわ"],[12,1,"かれ"],[14,1,"よ"],[16,1,"たの"],[21,1,"たて"],[25,1,"すくい"],[27,1,"つの"],[31,1,"たか"],[39,1,"さ"],[41,1,"どころ"],[45,2,"すくいぬし"],[56,2,"ぼうぎゃく"],[60,1,"すく"]],"text":"わが神、わが岩。わたしは彼に寄り頼む。わが盾、わが救の角、わが高きやぐら、わが避け所、わが救主。あなたはわたしを暴虐から救われる。"},{"ref":"2Sam.22.4","start":10022004,"end":10022004,"break":"line","breaks":[[20,"line"]],"ruby":[[12,1,"しゅ"],[14,1,"よ"],[24,1,"てき"],[27,1,"すく"]],"text":"わたしは、ほめまつるべき主に呼ばわって、わたしの敵から救われる。"},{"ref":"2Sam.22.5","start":10022005,"end":10022005,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"し"],[2,1,"なみ"],[13,1,"ほろ"],[16,2,"おおみず"],[23,1,"おそ"]],"text":"死の波はわたしをとりまき、滅びの大水はわたしを襲った。"},{"ref":"2Sam.22.6","start":10022006,"end":10022006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"よみ"],[3,1,"つな"],[15,1,"し"],[27,1,"む"]],"text":"陰府の綱はわたしをとりかこみ、死のわなはわたしに、たち向かった。"},{"ref":"2Sam.22.7","start":10022007,"end":10022007,"break":"line","breaks":[[15,"line"],[27,"line"],[45,"line"]],"ruby":[[0,2,"くなん"],[10,1,"しゅ"],[12,1,"よ"],[19,1,"かみ"],[21,1,"よ"],[27,1,"しゅ"],[31,1,"みや"],[38,1,"こえ"],[40,1,"き"],[49,1,"さけ"],[54,1,"みみ"]],"text":"苦難のうちにわたしは主を呼び、またわが神に呼ばわった。主がその宮からわたしの声を聞かれて、わたしの叫びはその耳にとどいた。"},{"ref":"2Sam.22.8","start":10022008,"end":10022008,"break":"line","breaks":[[11,"line"],[23,"line"]],"ruby":[[2,1,"とき"],[3,1,"ち"],[5,1,"ふる"],[11,1,"てん"],[13,1,"もとい"],[23,1,"かれ"],[25,1,"いか"]],"text":"その時地は震いうごき、天の基はゆるぎふるえた。彼が怒られたからである。"},{"ref":"2Sam.22.9","start":10022009,"end":10022009,"break":"line","breaks":[[12,"line"],[27,"line"]],"ruby":[[0,1,"けむり"],[4,1,"はな"],[9,1,"のぼ"],[12,1,"ひ"],[16,1,"くち"],[19,1,"で"],[21,1,"や"],[27,2,"はくねつ"],[30,1,"すみ"],[32,1,"かれ"],[35,1,"も"],[37,1,"で"]],"text":"煙はその鼻からたち上り、火はその口から出て焼きつくし、白熱の炭は彼から燃え出た。"},{"ref":"2Sam.22.10","start":10022010,"end":10022010,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[2,1,"てん"],[4,1,"ひく"],[8,1,"くだ"],[12,1,"くら"],[16,1,"かれ"],[18,1,"あし"],[20,1,"した"]],"text":"彼は天を低くして下られ、暗やみが彼の足の下にあった。"},{"ref":"2Sam.22.11","start":10022011,"end":10022011,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[6,1,"の"],[9,1,"と"],[12,1,"かぜ"],[14,1,"つばさ"],[16,1,"の"]],"text":"彼はケルブに乗って飛び、風の翼に乗ってあらわれた。"},{"ref":"2Sam.22.12","start":10022012,"end":10022012,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[4,2,"しゅうい"],[7,2,"まくや"],[16,1,"こ"],[18,1,"くも"],[20,1,"みず"],[22,1,"あつ"],[27,1,"お"]],"text":"彼はその周囲に幕屋として、やみと濃き雲と水の集まりとを置かれた。"},{"ref":"2Sam.22.13","start":10022013,"end":10022013,"break":"line","breaks":[[9,"line"]],"ruby":[[3,1,"まえ"],[5,1,"かがや"],[9,2,"すみび"],[12,1,"も"],[14,1,"で"]],"text":"そのみ前の輝きから炭火が燃え出た。"},{"ref":"2Sam.22.14","start":10022014,"end":10022014,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"てん"],[5,1,"かみなり"],[15,1,"たか"],[17,1,"もの"],[19,1,"こえ"],[21,1,"だ"]],"text":"主は天から雷をとどろかせ、いと高き者は声を出された。"},{"ref":"2Sam.22.15","start":10022015,"end":10022015,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[4,1,"や"],[6,1,"はな"],[9,1,"かれ"],[12,1,"ち"],[21,1,"はな"],[24,1,"かれ"],[27,1,"う"],[29,1,"やぶ"]],"text":"彼はまた矢を放って彼らを散らし、いなずまを放って彼らを撃ち破られた。"},{"ref":"2Sam.22.16","start":10022016,"end":10022016,"break":"line","breaks":[[20,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"はな"],[20,1,"うみ"],[22,1,"そこ"],[29,2,"せかい"],[32,1,"もとい"]],"text":"主のとがめと、その鼻のいぶきとによって、海の底はあらわれ、世界の基が、あらわになった。"},{"ref":"2Sam.22.17","start":10022017,"end":10022017,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[2,1,"たか"],[4,1,"ところ"],[7,1,"て"],[9,1,"の"],[16,1,"とら"],[19,2,"おおみず"],[22,1,"なか"],[29,1,"ひ"],[31,1,"あ"]],"text":"彼は高き所から手を伸べてわたしを捕え、大水の中からわたしを引き上げ、"},{"ref":"2Sam.22.18","start":10022018,"end":10022018,"break":"line","breaks":[[19,"line"],[28,"line"]],"ruby":[[4,1,"つよ"],[6,1,"てき"],[13,1,"にく"],[15,1,"もの"],[23,1,"すく"],[28,1,"かれ"],[44,1,"つよ"]],"text":"わたしの強い敵と、わたしを憎む者とからわたしを救われた。彼らはわたしにとって、あまりにも強かったからだ。"},{"ref":"2Sam.22.19","start":10022019,"end":10022019,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かれ"],[7,1,"わざわい"],[9,1,"ひ"],[18,1,"む"],[26,1,"しゅ"],[32,2,"しちゅう"]],"text":"彼らはわたしの災の日にわたしに、たち向かった。しかし主はわたしの支柱となられた。"},{"ref":"2Sam.22.20","start":10022020,"end":10022020,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[8,1,"ひろ"],[10,1,"ところ"],[12,1,"ひ"],[22,1,"よろこ"],[27,1,"すく"]],"text":"彼はまたわたしを広い所へ引きだされ、わたしを喜ばれて、救ってくださった。"},{"ref":"2Sam.22.21","start":10022021,"end":10022021,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ぎ"],[17,1,"むく"],[24,1,"て"],[26,1,"きよ"],[38,1,"むく"]],"text":"主はわたしの義にしたがってわたしに報い、わたしの手の清きにしたがってわたしに報いかえされた。"},{"ref":"2Sam.22.22","start":10022022,"end":10022022,"break":"line","breaks":[[21,"line"]],"ruby":[[8,1,"しゅ"],[10,1,"みち"],[12,1,"まも"],[15,1,"あく"],[17,1,"おこな"],[23,1,"かみ"],[26,1,"はな"]],"text":"それは、わたしが主の道を守り、悪を行わず、わが神から離れたことがないからである。"},{"ref":"2Sam.22.23","start":10022023,"end":10022023,"break":"line","breaks":[[20,"line"]],"ruby":[[14,1,"まえ"],[28,1,"さだ"],[31,1,"はな"]],"text":"そのすべてのおきてはわたしの前にあって、わたしはその、み定めを離れたことがない。"},{"ref":"2Sam.22.24","start":10022024,"end":10022024,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"まえ"],[8,1,"か"],[11,1,"ところ"],[15,1,"みずか"],[18,1,"まも"],[21,1,"つみ"],[23,1,"おか"]],"text":"わたしは主の前に欠けた所なく、自らを守って罪を犯さなかった。"},{"ref":"2Sam.22.25","start":10022025,"end":10022025,"break":"line","breaks":[[18,"line"],[38,"line"]],"ruby":[[5,1,"しゅ"],[11,1,"ぎ"],[20,1,"め"],[29,1,"きよ"],[42,1,"むく"]],"text":"それゆえ、主はわたしの義にしたがい、その目のまえにわたしの清きにしたがって、わたしに報いられた。"},{"ref":"2Sam.22.26","start":10022026,"end":10022026,"break":"line","breaks":[[19,"line"],[30,"line"]],"ruby":[[0,2,"ちゅうじつ"],[3,1,"もの"],[11,2,"ちゅうじつ"],[14,1,"もの"],[19,1,"か"],[22,1,"ところ"],[26,1,"ひと"],[34,1,"か"],[37,1,"ところ"],[41,1,"もの"]],"text":"忠実な者には、あなたは忠実な者となり、欠けた所のない人には、あなたは欠けた所のない者となり、"},{"ref":"2Sam.22.27","start":10022027,"end":10022027,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"きよ"],[2,1,"もの"],[10,1,"きよ"],[12,1,"もの"],[21,1,"もの"],[30,1,"もの"]],"text":"清い者には、あなたは清い者となり、まがった者には、かたいぢな者となられる。"},{"ref":"2Sam.22.28","start":10022028,"end":10022028,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[9,1,"たみ"],[11,1,"すく"],[23,1,"め"],[25,1,"たか"],[28,1,"もの"],[30,1,"み"]],"text":"あなたはへりくだる民を救われる、しかしあなたの目は高ぶる者を見てこれをひくくせられる。"},{"ref":"2Sam.22.29","start":10022029,"end":10022029,"break":"line","breaks":[[21,"line"]],"ruby":[[5,1,"しゅ"],[19,1,"び"],[23,1,"かみ"],[32,1,"てら"]],"text":"まことに、主よ、あなたはわたしのともし火、わが神はわたしのやみを照される。"},{"ref":"2Sam.22.30","start":10022030,"end":10022030,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[16,1,"てき"],[17,1,"ぐん"],[21,1,"ほろ"],[27,1,"かみ"],[32,1,"いし"],[38,1,"こ"]],"text":"まことに、あなたによってわたしは敵軍をふみ滅ぼし、わが神によって石がきをとび越えることができる。"},{"ref":"2Sam.22.31","start":10022031,"end":10022031,"break":"line","breaks":[[20,"line"],[31,"line"]],"ruby":[[2,1,"かみ"],[8,1,"みち"],[10,1,"ひ"],[20,1,"しゅ"],[22,2,"やくそく"],[25,2,"しんじつ"],[31,1,"かれ"],[36,1,"かれ"],[38,1,"よ"],[40,1,"たの"],[42,1,"もの"],[44,1,"たて"]],"text":"この神こそ、その道は非のうちどころなく、主の約束は真実である。彼はすべて彼に寄り頼む者の盾である。"},{"ref":"2Sam.22.32","start":10022032,"end":10022032,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"かみ"],[16,1,"かみ"],[24,1,"いわ"]],"text":"主のほかに、だれが神か、われらの神のほか、だれが岩であるか。"},{"ref":"2Sam.22.33","start":10022033,"end":10022033,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"かみ"],[9,2,"けんご"],[12,1,"さ"],[14,1,"どころ"],[23,1,"みち"],[25,2,"あんぜん"]],"text":"この神こそわたしの堅固な避け所であり、わたしの道を安全にされた。"},{"ref":"2Sam.22.34","start":10022034,"end":10022034,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"あし"],[10,1,"あし"],[22,1,"たか"],[24,1,"ところ"],[26,2,"あんぜん"],[29,1,"た"]],"text":"わたしの足をめじかの足のようにして、わたしを高い所に安全に立たせ、"},{"ref":"2Sam.22.35","start":10022035,"end":10022035,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"て"],[6,1,"たたか"],[9,1,"な"],[21,1,"うで"],[23,2,"せいどう"],[26,1,"ゆみ"],[28,1,"ひ"]],"text":"わたしの手を戦いに慣らされたので、わたしの腕は青銅の弓を引くことができる。"},{"ref":"2Sam.22.36","start":10022036,"end":10022036,"break":"line","breaks":[[17,"line"]],"ruby":[[6,1,"すくい"],[8,1,"たて"],[14,1,"あた"],[21,1,"たす"],[29,1,"おお"],[33,1,"もの"]],"text":"あなたはその救の盾をわたしに与え、あなたの助けは、わたしを大いなる者とされた。"},{"ref":"2Sam.22.37","start":10022037,"end":10022037,"break":"line","breaks":[[23,"line"]],"ruby":[[8,1,"ある"],[10,1,"ひろ"],[12,2,"ばしょ"],[15,1,"あた"],[27,1,"あし"]],"text":"あなたはわたしが歩く広い場所を与えられたので、わたしの足はすべらなかった。"},{"ref":"2Sam.22.38","start":10022038,"end":10022038,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"てき"],[6,1,"お"],[13,1,"ほろ"],[20,1,"た"],[26,1,"かえ"]],"text":"わたしは敵を追って、これを滅ぼし、これを絶やすまでは帰らなかった。"},{"ref":"2Sam.22.39","start":10022039,"end":10022039,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かれ"],[7,1,"た"],[11,1,"かれ"],[14,1,"くだ"],[19,1,"かれ"],[22,1,"た"],[35,1,"あし"],[39,1,"たお"]],"text":"わたしは彼らを絶やし、彼らを砕いたので彼らは立つことができず、わたしの足もとに倒れた。"},{"ref":"2Sam.22.40","start":10022040,"end":10022040,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"たたか"],[15,1,"ちから"],[17,1,"お"],[25,1,"せ"],[28,1,"もの"],[34,1,"した"]],"text":"あなたは戦いのために、わたしに力を帯びさせわたしを攻める者をわたしの下にかがませられた。"},{"ref":"2Sam.22.41","start":10022041,"end":10022041,"break":"line","breaks":[[10,"line"],[26,"line"]],"ruby":[[8,1,"てき"],[20,1,"む"],[30,1,"にく"],[32,1,"もの"],[38,1,"ほろ"]],"text":"あなたによって、敵はそのうしろをわたしに向けたので、わたしを憎む者をわたしは滅ぼした。"},{"ref":"2Sam.22.42","start":10022042,"end":10022042,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[3,1,"み"],[10,1,"すく"],[12,1,"もの"],[20,1,"かれ"],[23,1,"しゅ"],[25,1,"さけ"],[30,1,"かれ"],[34,1,"こた"]],"text":"彼らは見まわしたが、救う者はいなかった。彼らは主に叫んだが、彼らには答えられなかった。"},{"ref":"2Sam.22.43","start":10022043,"end":10022043,"break":"line","breaks":[[15,"line"],[24,"line"]],"ruby":[[4,1,"かれ"],[7,1,"ち"],[15,1,"こま"],[18,1,"う"],[35,1,"ふ"]],"text":"わたしは彼らを地のちりのように細かに打ちくだき、ちまたのどろのように、踏みにじった。"},{"ref":"2Sam.22.44","start":10022044,"end":10022044,"break":"line","breaks":[[23,"line"],[43,"line"]],"ruby":[[8,2,"くにぐに"],[11,1,"たみ"],[14,1,"あらそ"],[18,1,"すく"],[20,1,"だ"],[32,2,"こくみん"],[47,1,"し"],[53,1,"たみ"],[59,1,"つか"]],"text":"あなたはわたしを国々の民との争いから救い出し、わたしをもろもろの国民のかしらとされた。わたしの知らなかった民がわたしに仕えた。"},{"ref":"2Sam.22.45","start":10022045,"end":10022045,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"いこく"],[3,1,"ひと"],[20,1,"こと"],[22,1,"き"],[31,1,"したが"]],"text":"異国の人たちはきてわたしにこび、わたしの事を聞くとすぐわたしに従った。"},{"ref":"2Sam.22.46","start":10022046,"end":10022046,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"いこく"],[3,1,"ひと"],[16,1,"しろ"],[25,1,"で"]],"text":"異国の人たちは、うちしおれてその城からふるえながら出てきた。"},{"ref":"2Sam.22.47","start":10022047,"end":10022047,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"いわ"],[23,1,"かみ"],[27,1,"すくい"],[29,1,"いわ"]],"text":"主は生きておられる。わが岩はほむべきかな。わが神、わが救の岩はあがむべきかな。"},{"ref":"2Sam.22.48","start":10022048,"end":10022048,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"かみ"],[15,1,"むく"],[23,1,"たみ"],[29,1,"した"],[31,1,"お"]],"text":"この神はわたしのために、あだを報い、もろもろの民をわたしの下に置かれた。"},{"ref":"2Sam.22.49","start":10022049,"end":10022049,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[6,1,"てき"],[9,1,"すく"],[11,1,"だ"],[17,1,"うえ"],[26,2,"ぼうぎゃく"],[29,2,"ひとびと"],[37,1,"すく"],[39,1,"だ"]],"text":"またわたしを敵から救い出し、あだの上にわたしをあげ、暴虐の人々からわたしを救い出された。"},{"ref":"2Sam.22.50","start":10022050,"end":10022050,"break":"line","breaks":[[23,"line"],[31,"line"]],"ruby":[[5,1,"しゅ"],[17,2,"くにたみ"],[20,1,"なか"],[37,1,"な"],[41,1,"うた"]],"text":"それゆえ、主よ、わたしはもろもろの国民の中で、あなたをたたえ、あなたの、み名をほめ歌うであろう。"},{"ref":"2Sam.22.51","start":10022051,"end":10022051,"break":"line","breaks":[[16,"line"],[36,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"おう"],[6,1,"おお"],[10,2,"しょうり"],[13,1,"あた"],[16,1,"あぶら"],[18,1,"そそ"],[22,1,"もの"],[31,2,"しそん"],[48,1,"ほどこ"]],"text":"主はその王に大いなる勝利を与え、油を注がれた者に、ダビデとその子孫とに、とこしえに、いつくしみを施される」。"}]