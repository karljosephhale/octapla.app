[{"ref":"Ruth.4.1","start":8004001,"end":8004001,"break":"paragraph","ruby":[[4,1,"まち"],[6,1,"もん"],[12,1,"のぼ"],[38,1,"い"],[41,2,"しんせき"],[44,1,"ひと"],[46,1,"とお"],[48,1,"す"],[64,1,"ひと"],[66,1,"い"],[71,1,"とも"],[94,1,"かれ"]],"text":"ボアズは町の門のところへ上っていって、そこにすわった。すると、さきにボアズが言った親戚の人が通り過ぎようとしたので、ボアズはその人に言った、「友よ、こちらへきて、ここにおすわりください」。彼はきてすわった。"},{"ref":"Ruth.4.2","start":8004002,"end":8004002,"break":"none","ruby":[[6,1,"まち"],[8,2,"ちょうろう"],[11,1,"にん"],[13,1,"まね"],[16,1,"い"],[34,1,"かれ"],[41,1,"とき"]],"text":"ボアズはまた町の長老十人を招いて言った、「ここにおすわりください」。彼らがすわった時、"},{"ref":"Ruth.4.3","start":8004003,"end":8004003,"break":"none","ruby":[[4,2,"しんせき"],[7,1,"ひと"],[9,1,"い"],[18,1,"ち"],[21,1,"かえ"],[36,2,"しんぞく"],[44,2,"じしょ"],[47,1,"う"]],"text":"ボアズは親戚の人に言った、「モアブの地から帰ってきたナオミは、われわれの親族エリメレクの地所を売ろうとしています。"},{"ref":"Ruth.4.4","start":8004004,"end":8004004,"break":"none","ruby":[[16,1,"し"],[30,2,"ひとびと"],[34,1,"たみ"],[36,2,"ちょうろう"],[41,1,"まえ"],[47,1,"か"],[58,1,"い"],[62,1,"おも"],[85,1,"おも"],[130,1,"い"],[133,1,"し"],[149,1,"ひと"],[171,1,"つぎ"],[178,1,"かれ"],[180,1,"い"]],"text":"それでわたしはそのことをあなたに知らせて、ここにすわっている人々と、民の長老たちの前で、それを買いなさいと、あなたに言おうと思いました。もし、あなたが、それをあがなおうと思われるならば、あがなってください。しかし、あなたがそれをあがなわないならば、わたしにそう言って知らせてください。それをあがなう人は、あなたのほかにはなく、わたしはあなたの次ですから」。彼は言った、「わたしがあがないましょう」。"},{"ref":"Ruth.4.5","start":8004005,"end":8004005,"break":"none","ruby":[[7,1,"い"],[20,1,"て"],[25,2,"じしょ"],[28,1,"か"],[30,1,"とき"],[34,1,"し"],[37,1,"もの"],[39,1,"つま"],[48,1,"おんな"],[53,1,"か"],[57,1,"し"],[60,1,"もの"],[62,1,"な"],[64,1,"おこ"],[69,1,"し"],[70,1,"ぎょう"],[72,1,"つた"]],"text":"そこでボアズは言った、「あなたがナオミの手からその地所を買う時には、死んだ者の妻であったモアブの女ルツをも買って、死んだ者の名を起してその嗣業を伝えなければなりません」。"},{"ref":"Ruth.4.6","start":8004006,"end":8004006,"break":"none","ruby":[[2,2,"しんせき"],[5,1,"ひと"],[7,1,"い"],[44,2,"じぶん"],[47,1,"し"],[48,1,"ぎょう"],[65,1,"かわ"],[69,2,"じぶん"]],"text":"その親戚の人は言った、「それでは、わたしにはあがなうことができません。そんなことをすれば自分の嗣業をそこないます。あなたがわたしに代って、自分であがなってください。わたしはあがなうことができませんから」。"},{"ref":"Ruth.4.7","start":8004007,"end":8004007,"break":"none","ruby":[[11,1,"もの"],[17,1,"こと"],[20,2,"けんり"],[23,2,"じょうと"],[30,2,"ばんじ"],[33,2,"けってい"],[37,1,"とき"],[58,1,"ひと"],[61,2,"じぶん"],[67,1,"ぬ"],[71,2,"あいて"],[74,1,"ひと"],[76,1,"わた"],[90,2,"しょうめい"],[93,2,"ほうほう"]],"text":"むかしイスラエルでは、物をあがなう事と、権利の譲渡について、万事を決定する時のならわしはこうであった。すなわち、その人は、自分のくつを脱いで、相手の人に渡した。これがイスラエルでの証明の方法であった。"},{"ref":"Ruth.4.8","start":8004008,"end":8004008,"break":"none","ruby":[[3,2,"しんせき"],[6,1,"ひと"],[20,2,"じぶん"],[32,1,"い"],[41,1,"ぬ"]],"text":"そこで親戚の人がボアズにむかい「あなたが自分であがないなさい」と言って、そのくつを脱いだので、"},{"ref":"Ruth.4.9","start":8004009,"end":8004009,"break":"none","ruby":[[4,2,"ちょうろう"],[13,1,"たみ"],[15,1,"い"],[45,1,"もの"],[62,1,"もの"],[68,1,"て"],[71,1,"か"],[76,1,"こと"],[78,2,"しょうにん"]],"text":"ボアズは長老たちとすべての民に言った、「あなたがたは、きょう、わたしがエリメレクのすべての物およびキリオンとマロンのすべての物をナオミの手から買いとった事の証人です。"},{"ref":"Ruth.4.10","start":8004010,"end":8004010,"break":"none","ruby":[[10,1,"つま"],[19,1,"おんな"],[24,1,"か"],[32,1,"つま"],[44,1,"し"],[47,1,"もの"],[49,1,"な"],[51,1,"おこ"],[56,1,"し"],[57,1,"ぎょう"],[59,1,"つた"],[62,1,"し"],[65,1,"もの"],[67,1,"な"],[71,2,"いちぞく"],[80,2,"きょうり"],[83,1,"もん"],[86,2,"だんぜつ"],[113,2,"しょうにん"]],"text":"またわたしはマロンの妻であったモアブの女ルツをも買って、わたしの妻としました。これはあの死んだ者の名を起してその嗣業を伝え、死んだ者の名がその一族から、またその郷里の門から断絶しないようにするためです。きょうあなたがたは、その証人です」。"},{"ref":"Ruth.4.11","start":8004011,"end":8004011,"break":"none","ruby":[[3,1,"もん"],[11,1,"たみ"],[13,2,"ちょうろう"],[18,1,"い"],[29,2,"しょうにん"],[38,1,"しゅ"],[44,1,"いえ"],[49,1,"おんな"],[58,1,"いえ"],[97,1,"とみ"],[99,1,"え"],[107,1,"な"],[109,1,"あ"]],"text":"すると門にいたすべての民と長老たちは言った、「わたしたちは証人です。どうぞ、主があなたの家にはいる女を、イスラエルの家をたてたラケルとレアのふたりのようにされますよう。どうぞ、あなたがエフラタで富を得、ベツレヘムで名を揚げられますように。"},{"ref":"Ruth.4.12","start":8004012,"end":8004012,"break":"none","ruby":[[4,1,"しゅ"],[8,1,"わか"],[10,1,"おんな"],[19,1,"たま"],[22,2,"こども"],[32,1,"いえ"],[44,1,"う"],[51,1,"いえ"]],"text":"どうぞ、主がこの若い女によってあなたに賜わる子供により、あなたの家が、かのタマルがユダに産んだペレヅの家のようになりますように」。"},{"ref":"Ruth.4.13","start":8004013,"end":8004013,"break":"paragraph","ruby":[[15,1,"つま"],[19,2,"かのじょ"],[31,1,"しゅ"],[33,2,"かのじょ"],[47,2,"かのじょ"],[54,1,"おとこ"],[56,1,"こ"],[58,1,"う"]],"text":"こうしてボアズはルツをめとって妻とし、彼女のところにはいった。主は彼女をみごもらせられたので、彼女はひとりの男の子を産んだ。"},{"ref":"Ruth.4.14","start":8004014,"end":8004014,"break":"none","ruby":[[5,1,"おんな"],[13,1,"い"],[18,1,"しゅ"],[27,1,"しゅ"],[33,2,"みす"],[51,2,"きんしん"],[55,1,"さづ"],[70,1,"こ"],[72,1,"な"],[83,1,"たか"],[85,1,"あ"]],"text":"そのとき、女たちはナオミに言った、「主はほむべきかな、主はあなたを見捨てずに、きょう、あなたにひとりの近親をお授けになりました。どうぞ、その子の名がイスラエルのうちに高く揚げられますように。"},{"ref":"Ruth.4.15","start":8004015,"end":8004015,"break":"none","ruby":[[0,1,"かれ"],[10,1,"あら"],[19,2,"ろうねん"],[22,1,"やしな"],[24,1,"もの"],[37,1,"あい"],[44,1,"よめ"],[47,1,"にん"],[57,2,"かのじょ"],[60,1,"かれ"],[62,1,"う"]],"text":"彼はあなたのいのちを新たにし、あなたの老年を養う者となるでしょう。あなたを愛するあなたの嫁、七人のむすこにもまさる彼女が彼を産んだのですから」。"},{"ref":"Ruth.4.16","start":8004016,"end":8004016,"break":"none","ruby":[[9,1,"こ"],[19,1,"お"],[23,1,"やしな"],[25,1,"そだ"]],"text":"そこでナオミはその子をとり、ふところに置いて、養い育てた。"},{"ref":"Ruth.4.17","start":8004017,"end":8004017,"break":"none","ruby":[[0,2,"きんじょ"],[3,1,"おんな"],[12,1,"おとこ"],[14,1,"こ"],[16,1,"うま"],[21,1,"い"],[25,1,"かれ"],[27,1,"な"],[34,1,"な"],[40,1,"よ"],[44,1,"かれ"],[50,1,"ちち"],[59,1,"ちち"]],"text":"近所の女たちは「ナオミに男の子が生れた」と言って、彼に名をつけ、その名をオベデと呼んだ。彼はダビデの父であるエッサイの父となった。"},{"ref":"Ruth.4.18","start":8004018,"end":8004018,"break":"none","ruby":[[6,2,"しそん"],[9,1,"つぎ"],[28,1,"うま"]],"text":"さてペレヅの子孫は次のとおりである。ペレヅからヘヅロンが生れ、"},{"ref":"Ruth.4.19","start":8004019,"end":8004019,"break":"none","ruby":[[9,1,"うま"],[22,1,"うま"]],"text":"ヘヅロンからラムが生れ、ラムからアミナダブが生れ、"},{"ref":"Ruth.4.20","start":8004020,"end":8004020,"break":"none","ruby":[[12,1,"うま"],[26,1,"うま"]],"text":"アミナダブからナションが生れ、ナションからサルモンが生れ、"},{"ref":"Ruth.4.21","start":8004021,"end":8004021,"break":"none","ruby":[[10,1,"うま"],[22,1,"うま"]],"text":"サルモンからボアズが生れ、ボアズからオベデが生れ、"},{"ref":"Ruth.4.22","start":8004022,"end":8004022,"break":"none","ruby":[[10,1,"うま"],[23,1,"うま"]],"text":"オベデからエッサイが生れ、エッサイからダビデが生れた。"}]