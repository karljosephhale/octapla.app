[{"ref":"Esth.3.1","start":17003001,"end":17003001,"break":"paragraph","ruby":[[4,1,"こと"],[6,1,"のち"],[15,1,"おう"],[28,1,"こ"],[33,1,"おも"],[40,2,"しょうしん"],[46,2,"じぶん"],[49,1,"とも"],[57,2,"だいじん"],[62,1,"うえ"],[66,1,"せき"],[68,1,"さだ"]],"text":"これらの事の後、アハシュエロス王はアガグびとハンメダタの子ハマンを重んじ、これを昇進させて、自分と共にいるすべての大臣たちの上にその席を定めさせた。"},{"ref":"Esth.3.2","start":17003002,"end":17003002,"break":"none","ruby":[[0,1,"おう"],[2,1,"もん"],[4,1,"うち"],[8,1,"おう"],[10,2,"じしん"],[15,1,"みな"],[26,2,"けいれい"],[34,1,"おう"],[36,1,"かれ"],[48,1,"めい"],[75,2,"けいれい"]],"text":"王の門の内にいる王の侍臣たちは皆ひざまずいてハマンに敬礼した。これは王が彼についてこうすることを命じたからである。しかしモルデカイはひざまずかず、また敬礼しなかった。"},{"ref":"Esth.3.3","start":17003003,"end":17003003,"break":"none","ruby":[[3,1,"おう"],[5,1,"もん"],[9,1,"おう"],[11,2,"じしん"],[36,1,"おう"],[38,2,"めいれい"],[48,1,"い"]],"text":"そこで王の門にいる王の侍臣たちはモルデカイにむかって、「あなたはどうして王の命令にそむくのか」と言った。"},{"ref":"Esth.3.4","start":17003004,"end":17003004,"break":"none","ruby":[[0,1,"かれ"],[3,2,"まいにち"],[13,1,"い"],[19,1,"き"],[32,1,"こと"],[44,1,"み"],[56,1,"つ"],[73,2,"じぶん"],[79,1,"じん"],[86,1,"かれ"],[89,1,"かた"]],"text":"彼らは毎日モルデカイにこう言うけれども聞きいれなかったので、その事がゆるされるかどうかを見ようと、これをハマンに告げた。なぜならモルデカイはすでに自分のユダヤ人であることを彼らに語ったからである。"},{"ref":"Esth.3.5","start":17003005,"end":17003005,"break":"none","ruby":[[19,2,"じぶん"],[22,2,"けいれい"],[29,1,"み"],[31,1,"いか"],[34,1,"み"]],"text":"ハマンはモルデカイのひざまずかず、また自分に敬礼しないのを見て怒りに満たされたが、"},{"ref":"Esth.3.6","start":17003006,"end":17003006,"break":"none","ruby":[[10,1,"ころ"],[15,1,"いさぎよ"],[24,1,"かれ"],[33,1,"ぞく"],[36,1,"たみ"],[42,1,"し"],[61,1,"くに"],[75,1,"じん"],[87,1,"ぞく"],[90,1,"たみ"],[97,1,"ほろ"],[102,1,"はか"]],"text":"ただモルデカイだけを殺すことを潔しとしなかった。彼らがモルデカイの属する民をハマンに知らせたので、ハマンはアハシュエロスの国のうちにいるすべてのユダヤ人、すなわちモルデカイの属する民をことごとく滅ぼそうと図った。"},{"ref":"Esth.3.7","start":17003007,"end":17003007,"break":"paragraph","ruby":[[7,1,"おう"],[9,1,"だい"],[12,1,"ねん"],[14,2,"しょうがつ"],[24,1,"つき"],[31,1,"まえ"],[36,1,"がつ"],[45,1,"つき"],[50,1,"にち"],[52,1,"にち"],[58,1,"つき"],[60,1,"つき"],[75,1,"な"]],"text":"アハシュエロス王の第十二年の正月すなわちニサンの月に、ハマンの前で、十二月すなわちアダルの月まで、一日一日のため、一月一月のために、プルすなわちくじを投げさせた。"},{"ref":"Esth.3.8","start":17003008,"end":17003008,"break":"none","ruby":[[14,1,"おう"],[16,1,"い"],[22,1,"くに"],[24,2,"かくしゅう"],[29,2,"しょみん"],[36,1,"ち"],[42,1,"わか"],[44,1,"わか"],[55,1,"たみ"],[63,2,"ほうりつ"],[66,1,"た"],[72,1,"たみ"],[77,1,"こと"],[83,1,"かれ"],[86,1,"おう"],[88,2,"ほうりつ"],[91,1,"まも"],[101,1,"かれ"],[104,1,"ゆる"],[112,1,"おう"]],"text":"そしてハマンはアハシュエロス王に言った、「お国の各州にいる諸民のうちに、散らされて、別れ別れになっている一つの民がいます。その法律は他のすべての民のものと異なり、また彼らは王の法律を守りません。それゆえ彼らを許しておくことは王のためになりません。"},{"ref":"Esth.3.9","start":17003009,"end":17003009,"break":"none","ruby":[[2,1,"おう"],[14,1,"かれ"],[17,1,"ほろ"],[21,1,"みことのり"],[24,1,"か"],[40,1,"おう"],[42,1,"こと"],[49,1,"もの"],[53,1,"て"],[55,1,"ぎん"],[63,1,"はか"],[70,1,"おう"],[72,2,"きんこ"],[75,1,"い"]],"text":"もし王がよしとされるならば、彼らを滅ぼせと詔をお書きください。そうすればわたしは王の事をつかさどる者たちの手に銀一万タラントを量りわたして、王の金庫に入れさせましょう」。"},{"ref":"Esth.3.10","start":17003010,"end":17003010,"break":"none","ruby":[[3,1,"おう"],[5,1,"て"],[8,2,"ゆびわ"],[26,1,"こ"],[32,1,"ひと"],[34,1,"てき"]],"text":"そこで王は手から指輪をはずし、アガグびとハンメダタの子で、ユダヤ人の敵であるハマンにわたした。"},{"ref":"Esth.3.11","start":17003011,"end":17003011,"break":"none","ruby":[[3,1,"おう"],[9,1,"い"],[16,1,"ぎん"],[22,1,"あた"],[28,1,"たみ"],[36,1,"あた"],[45,1,"おも"]],"text":"そして王はハマンに言った、「その銀はあなたに与える。その民もまたあなたに与えるから、よいと思うようにしなさい」。"},{"ref":"Esth.3.12","start":17003012,"end":17003012,"break":"paragraph","ruby":[[3,2,"しょうがつ"],[8,1,"にち"],[10,1,"おう"],[12,3,"しょきかん"],[16,1,"め"],[18,1,"あつ"],[23,1,"おう"],[25,2,"そうとく"],[28,2,"かくしゅう"],[31,2,"ちじ"],[36,2,"しょみん"],[49,1,"めい"],[60,1,"か"],[71,2,"かくしゅう"],[74,1,"おく"],[82,2,"もんじ"],[85,1,"もち"],[88,2,"しょみん"],[91,1,"おく"],[99,2,"げんご"],[102,1,"もち"],[116,1,"おう"],[118,1,"な"],[126,1,"か"],[129,1,"おう"],[131,2,"ゆびわ"],[140,1,"いん"],[142,1,"お"]],"text":"そこで正月の十三日に王の書記官が召し集められ、王の総督、各州の知事および諸民のつかさたちにハマンが命じたことをことごとく書きしるした。すなわち各州に送るものにはその文字を用い、諸民に送るものにはその言語を用い、おのおのアハシュエロス王の名をもってそれを書き、王の指輪をもってそれに印を押した。"},{"ref":"Esth.3.13","start":17003013,"end":17003013,"break":"none","ruby":[[3,2,"きゅうし"],[11,1,"しょ"],[13,1,"おう"],[15,1,"しょ"],[16,1,"しゅう"],[18,1,"おく"],[23,1,"がつ"],[32,1,"つき"],[36,1,"にち"],[40,1,"にち"],[52,1,"ひと"],[55,1,"わか"],[57,1,"もの"],[59,1,"お"],[62,1,"もの"],[64,2,"こども"],[67,1,"おんな"],[69,1,"べつ"],[78,1,"ほろ"],[82,1,"ころ"],[85,1,"た"],[93,1,"か"],[94,1,"ざい"],[96,1,"うば"],[98,1,"と"],[101,1,"めい"]],"text":"そして急使をもってその書を王の諸州に送り、十二月すなわちアダルの月の十三日に、一日のうちにすべてのユダヤ人を、若い者、老いた者、子供、女の別なく、ことごとく滅ぼし、殺し、絶やし、かつその貨財を奪い取れと命じた。"},{"ref":"Esth.3.14","start":17003014,"end":17003014,"break":"none","ruby":[[2,2,"ぶんしょ"],[5,1,"うつ"],[8,1,"みことのり"],[12,2,"かくしゅう"],[15,1,"つた"],[22,1,"たみ"],[24,2,"こうじ"],[31,1,"ひ"],[36,1,"そな"]],"text":"この文書の写しを詔として各州に伝え、すべての民に公示して、その日のために備えさせようとした。"},{"ref":"Esth.3.15","start":17003015,"end":17003015,"break":"none","ruby":[[0,2,"きゅうし"],[3,1,"おう"],[5,2,"めいれい"],[10,1,"いそ"],[13,1,"で"],[21,1,"みことのり"],[23,2,"しゅと"],[28,2,"はっぷ"],[34,1,"とき"],[36,1,"おう"],[42,1,"ざ"],[45,1,"さけ"],[47,1,"の"],[57,1,"みやこ"],[62,1,"まど"]],"text":"急使は王の命令により急いで出ていった。この詔は首都スサで発布された。時に王とハマンは座して酒を飲んでいたが、スサの都はあわて惑った。"}]