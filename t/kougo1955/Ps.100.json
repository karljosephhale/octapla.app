[{"ref":"Ps.100.1","start":19100001,"end":19100001,"break":"paragraph","title":"感謝の供え物のための歌","ruby":[[0,1,"ぜん"],[1,1,"ち"],[4,1,"しゅ"],[10,1,"よろこ"],[14,1,"こえ"]],"titleRuby":[[0,2,"かんしゃ"],[3,1,"そな"],[5,1,"もの"],[10,1,"うた"]],"text":"全地よ、主にむかって喜ばしき声をあげよ。"},{"ref":"Ps.100.2","start":19100002,"end":19100002,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"よろこ"],[6,1,"しゅ"],[8,1,"つか"],[12,1,"うた"],[20,1,"まえ"]],"text":"喜びをもって主に仕えよ。歌いつつ、そのみ前にきたれ。"},{"ref":"Ps.100.3","start":19100003,"end":19100003,"break":"line","breaks":[[13,"line"],[30,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[10,1,"し"],[17,1,"つく"],[24,1,"しゅ"],[34,1,"しゅ"],[48,1,"たみ"],[52,1,"まき"],[54,1,"ひつじ"]],"text":"主こそ神であることを知れ。われらを造られたものは主であって、われらは主のものである。われらはその民、その牧の羊である。"},{"ref":"Ps.100.4","start":19100004,"end":19100004,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[0,2,"かんしゃ"],[8,1,"もん"],[10,1,"い"],[23,2,"おおにわ"],[26,1,"い"],[29,1,"しゅ"],[31,2,"かんしゃ"],[38,1,"な"]],"text":"感謝しつつ、その門に入り、ほめたたえつつ、その大庭に入れ。主に感謝し、そのみ名をほめまつれ。"},{"ref":"Ps.100.5","start":19100005,"end":19100005,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"めぐ"],[31,1,"よ"],[33,1,"およ"]],"text":"主は恵みふかく、そのいつくしみはかぎりなく、そのまことはよろず代に及ぶからである。"}]