[{"ref":"Luke.1.1","start":42001001,"end":42001001,"break":"paragraph","ruby":[[6,1,"あいだ"],[8,2,"じょうじゅ"],[13,3,"できごと"],[18,2,"さいしょ"],[22,1,"した"],[25,1,"み"],[27,2,"ひとびと"]],"text":"わたしたちの間に成就された出来事を、最初から親しく見た人々であって、"},{"ref":"Luke.1.2","start":42001002,"end":42001002,"break":"none","ruby":[[0,2,"みことば"],[3,1,"つか"],[6,2,"ひとびと"],[9,1,"つた"],[15,2,"ものがたり"],[18,1,"か"],[20,1,"つら"],[26,1,"おお"],[29,1,"ひと"],[31,1,"て"],[33,1,"つ"]],"text":"御言に仕えた人々が伝えたとおり物語に書き連ねようと、多くの人が手を着けましたが、"},{"ref":"Luke.1.3","start":42001003,"end":42001003,"break":"none","ruby":[[4,2,"かっか"],[16,1,"こと"],[18,1,"はじ"],[22,1,"くわ"],[25,1,"しら"],[41,2,"じゅんじょ"],[43,1,"ただ"],[46,1,"か"],[53,2,"かっか"],[56,1,"けん"]],"text":"テオピロ閣下よ、わたしもすべての事を初めから詳しく調べていますので、ここに、それを順序正しく書きつづって、閣下に献じることにしました。"},{"ref":"Luke.1.4","start":42001004,"end":42001004,"break":"none","ruby":[[4,1,"き"],[12,1,"こと"],[14,2,"かくじつ"],[29,2,"じゅうぶん"],[32,1,"し"]],"text":"すでにお聞きになっている事が確実であることを、これによって十分に知っていただきたいためであります。"},{"ref":"Luke.1.5","start":42001005,"end":42001005,"break":"paragraph","ruby":[[4,1,"おう"],[9,1,"よ"],[16,1,"くみ"],[18,2,"さいし"],[21,1,"な"],[30,1,"もの"],[37,1,"つま"],[42,1,"いえ"],[44,1,"むすめ"],[51,1,"な"]],"text":"ユダヤの王ヘロデの世に、アビヤの組の祭司で名をザカリヤという者がいた。その妻はアロン家の娘のひとりで、名をエリサベツといった。"},{"ref":"Luke.1.6","start":42001006,"end":42001006,"break":"none","ruby":[[5,1,"かみ"],[11,1,"ただ"],[14,1,"ひと"],[20,1,"しゅ"],[22,1,"いまし"],[25,1,"さだ"],[32,2,"おちど"],[36,1,"おこな"]],"text":"ふたりとも神のみまえに正しい人であって、主の戒めと定めとを、みな落度なく行っていた。"},{"ref":"Luke.1.7","start":42001007,"end":42001007,"break":"none","ruby":[[11,2,"ふにん"],[14,1,"おんな"],[22,1,"かれ"],[26,1,"こ"],[42,2,"としお"]],"text":"ところが、エリサベツは不妊の女であったため、彼らには子がなく、そしてふたりともすでに年老いていた。"},{"ref":"Luke.1.8","start":42001008,"end":42001008,"break":"paragraph","ruby":[[10,1,"くみ"],[12,2,"とうばん"],[17,1,"かみ"],[23,2,"さいし"],[26,1,"つとめ"]],"text":"さてザカリヤは、その組が当番になり神のみまえに祭司の務をしていたとき、"},{"ref":"Luke.1.9","start":42001009,"end":42001009,"break":"none","ruby":[[0,2,"さいし"],[2,1,"しょく"],[4,2,"かんれい"],[7,1,"したが"],[13,1,"ひ"],[20,1,"しゅ"],[22,2,"せいじょ"],[29,1,"こう"]],"text":"祭司職の慣例に従ってくじを引いたところ、主の聖所にはいって香をたくことになった。"},{"ref":"Luke.1.10","start":42001010,"end":42001010,"break":"none","ruby":[[0,1,"こう"],[7,1,"あいだ"],[9,1,"おお"],[12,2,"みんしゅう"],[17,1,"そと"],[19,1,"いの"]],"text":"香をたいている間、多くの民衆はみな外で祈っていた。"},{"ref":"Luke.1.11","start":42001011,"end":42001011,"break":"none","ruby":[[3,1,"しゅ"],[5,2,"みつかい"],[8,1,"あらわ"],[12,1,"こう"],[13,1,"だん"],[15,1,"みぎ"],[17,1,"た"]],"text":"すると主の御使が現れて、香壇の右に立った。"},{"ref":"Luke.1.12","start":42001012,"end":42001012,"break":"none","ruby":[[8,1,"み"],[13,1,"まど"],[16,2,"きょうふ"],[19,1,"ねん"],[21,1,"おそ"]],"text":"ザカリヤはこれを見て、おじ惑い、恐怖の念に襲われた。"},{"ref":"Luke.1.13","start":42001013,"end":42001013,"break":"none","ruby":[[3,2,"みつかい"],[6,1,"かれ"],[8,1,"い"],[13,1,"おそ"],[28,1,"いのり"],[30,1,"き"],[44,1,"つま"],[51,1,"おとこ"],[53,1,"こ"],[55,1,"う"],[64,1,"こ"],[70,1,"な"]],"text":"そこで御使が彼に言った、「恐れるな、ザカリヤよ、あなたの祈が聞きいれられたのだ。あなたの妻エリサベツは男の子を産むであろう。その子をヨハネと名づけなさい。"},{"ref":"Luke.1.14","start":42001014,"end":42001014,"break":"none","ruby":[[0,1,"かれ"],[6,1,"よろこ"],[9,1,"たの"],[19,1,"おお"],[22,2,"ひとびと"],[27,2,"たんじょう"],[30,1,"よろこ"]],"text":"彼はあなたに喜びと楽しみとをもたらし、多くの人々もその誕生を喜ぶであろう。"},{"ref":"Luke.1.15","start":42001015,"end":42001015,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[8,1,"おお"],[12,1,"もの"],[20,1,"しゅ"],[22,1,"つよ"],[24,1,"さけ"],[30,1,"の"],[34,1,"はは"],[36,2,"たいない"],[41,1,"とき"],[47,2,"せいれい"],[50,1,"み"]],"text":"彼は主のみまえに大いなる者となり、ぶどう酒や強い酒をいっさい飲まず、母の胎内にいる時からすでに聖霊に満たされており、"},{"ref":"Luke.1.16","start":42001016,"end":42001016,"break":"none","ruby":[[10,1,"おお"],[13,1,"こ"],[17,1,"しゅ"],[20,1,"かれ"],[23,1,"かみ"],[25,1,"た"],[27,1,"かえ"]],"text":"そして、イスラエルの多くの子らを、主なる彼らの神に立ち帰らせるであろう。"},{"ref":"Luke.1.17","start":42001017,"end":42001017,"break":"none","ruby":[[0,1,"かれ"],[6,1,"れい"],[8,1,"ちから"],[19,2,"さきだ"],[23,1,"い"],[26,1,"ちち"],[28,1,"こころ"],[30,1,"こ"],[32,1,"む"],[37,1,"さか"],[40,1,"もの"],[42,2,"ぎじん"],[45,1,"おも"],[48,1,"も"],[53,1,"ととの"],[58,1,"たみ"],[60,1,"しゅ"],[62,1,"そな"]],"text":"彼はエリヤの霊と力とをもって、みまえに先立って行き、父の心を子に向けさせ、逆らう者に義人の思いを持たせて、整えられた民を主に備えるであろう」。"},{"ref":"Luke.1.18","start":42001018,"end":42001018,"break":"none","ruby":[[8,2,"みつかい"],[11,1,"い"],[23,1,"こと"],[43,2,"ろうじん"],[49,1,"つま"],[51,1,"とし"]],"text":"するとザカリヤは御使に言った、「どうしてそんな事が、わたしにわかるでしょうか。わたしは老人ですし、妻も年をとっています」。"},{"ref":"Luke.1.19","start":42001019,"end":42001019,"break":"none","ruby":[[0,2,"みつかい"],[3,1,"こた"],[6,1,"い"],[15,1,"かみ"],[21,1,"た"],[35,1,"よろこ"],[39,1,"し"],[47,1,"かた"],[49,1,"つた"]],"text":"御使が答えて言った、「わたしは神のみまえに立つガブリエルであって、この喜ばしい知らせをあなたに語り伝えるために、つかわされたものである。"},{"ref":"Luke.1.20","start":42001020,"end":42001020,"break":"none","ruby":[[0,1,"とき"],[2,1,"く"],[5,2,"じょうじゅ"],[13,2,"ことば"],[16,1,"しん"],[37,1,"こと"],[39,1,"おこ"],[41,1,"ひ"],[48,1,"い"]],"text":"時が来れば成就するわたしの言葉を信じなかったから、あなたはおしになり、この事の起る日まで、ものが言えなくなる」。"},{"ref":"Luke.1.21","start":42001021,"end":42001021,"break":"none","ruby":[[0,2,"みんしゅう"],[8,1,"ま"],[16,1,"かれ"],[18,2,"せいじょ"],[20,1,"うち"],[22,1,"ひま"],[30,3,"ふしぎ"],[34,1,"おも"]],"text":"民衆はザカリヤを待っていたので、彼が聖所内で暇どっているのを不思議に思っていた。"},{"ref":"Luke.1.22","start":42001022,"end":42001022,"break":"none","ruby":[[3,1,"かれ"],[5,1,"で"],[11,1,"もの"],[13,1,"い"],[22,2,"ひとびと"],[25,1,"かれ"],[27,2,"せいじょ"],[29,1,"うち"],[36,1,"み"],[41,1,"さと"],[45,1,"かれ"],[47,1,"かれ"],[50,2,"あいず"],[59,1,"ひ"]],"text":"ついに彼は出てきたが、物が言えなかったので、人々は彼が聖所内でまぼろしを見たのだと悟った。彼は彼らに合図をするだけで、引きつづき、おしのままでいた。"},{"ref":"Luke.1.23","start":42001023,"end":42001023,"break":"none","ruby":[[4,1,"つとめ"],[6,2,"きじつ"],[9,1,"おわ"],[15,1,"いえ"],[17,1,"かえ"]],"text":"それから務の期日が終ったので、家に帰った。"},{"ref":"Luke.1.24","start":42001024,"end":42001024,"break":"paragraph","ruby":[[5,1,"つま"],[19,1,"げつ"],[24,1,"ひ"]],"text":"そののち、妻エリサベツはみごもり、五か月のあいだ引きこもっていたが、"},{"ref":"Luke.1.25","start":42001025,"end":42001025,"break":"none","ruby":[[1,1,"しゅ"],[4,1,"いま"],[9,1,"こころ"],[20,2,"ひとびと"],[23,1,"あいだ"],[30,1,"はじ"],[32,1,"と"],[34,1,"のぞ"],[53,1,"い"]],"text":"「主は、今わたしを心にかけてくださって、人々の間からわたしの恥を取り除くために、こうしてくださいました」と言った。"},{"ref":"Luke.1.26","start":42001026,"end":42001026,"break":"paragraph","ruby":[[2,1,"げつ"],[3,1,"め"],[6,2,"みつかい"],[15,1,"かみ"],[36,1,"まち"],[38,1,"いち"],[39,2,"しょじょ"]],"text":"六か月目に、御使ガブリエルが、神からつかわされて、ナザレというガリラヤの町の一処女のもとにきた。"},{"ref":"Luke.1.27","start":42001027,"end":42001027,"break":"none","ruby":[[2,2,"しょじょ"],[8,1,"いえ"],[10,1,"で"],[20,1,"ひと"],[34,1,"な"]],"text":"この処女はダビデ家の出であるヨセフという人のいいなづけになっていて、名をマリヤといった。"},{"ref":"Luke.1.28","start":42001028,"end":42001028,"break":"none","ruby":[[0,2,"みつかい"],[13,1,"い"],[18,1,"めぐ"],[22,1,"おんな"],[31,1,"しゅ"],[37,1,"とも"]],"text":"御使がマリヤのところにきて言った、「恵まれた女よ、おめでとう、主があなたと共におられます」。"},{"ref":"Luke.1.29","start":42001029,"end":42001029,"break":"none","ruby":[[2,2,"ことば"],[12,2,"むなさわ"],[29,1,"こと"],[37,1,"おも"]],"text":"この言葉にマリヤはひどく胸騒ぎがして、このあいさつはなんの事であろうかと、思いめぐらしていた。"},{"ref":"Luke.1.30","start":42001030,"end":42001030,"break":"none","ruby":[[3,2,"みつかい"],[6,1,"い"],[11,1,"おそ"],[25,1,"かみ"],[28,1,"めぐ"]],"text":"すると御使が言った、「恐れるな、マリヤよ、あなたは神から恵みをいただいているのです。"},{"ref":"Luke.1.31","start":42001031,"end":42001031,"break":"none","ruby":[[0,1,"み"],[12,1,"おとこ"],[14,1,"こ"],[16,1,"う"],[25,1,"こ"],[31,1,"な"]],"text":"見よ、あなたはみごもって男の子を産むでしょう。その子をイエスと名づけなさい。"},{"ref":"Luke.1.32","start":42001032,"end":42001032,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おお"],[6,1,"もの"],[13,1,"たか"],[15,1,"もの"],[17,1,"こ"],[35,1,"しゅ"],[38,1,"かみ"],[40,1,"かれ"],[42,1,"ちち"],[47,2,"おうざ"],[51,1,"あた"]],"text":"彼は大いなる者となり、いと高き者の子と、となえられるでしょう。そして、主なる神は彼に父ダビデの王座をお与えになり、"},{"ref":"Luke.1.33","start":42001033,"end":42001033,"break":"none","ruby":[[0,1,"かれ"],[11,1,"いえ"],[13,2,"しはい"],[19,2,"しはい"],[22,1,"かぎ"],[26,1,"つづ"]],"text":"彼はとこしえにヤコブの家を支配し、その支配は限りなく続くでしょう」。"},{"ref":"Luke.1.34","start":42001034,"end":42001034,"break":"none","ruby":[[7,2,"みつかい"],[10,1,"い"],[23,1,"こと"],[27,1,"え"],[41,1,"おっと"]],"text":"そこでマリヤは御使に言った、「どうして、そんな事があり得ましょうか。わたしにはまだ夫がありませんのに」。"},{"ref":"Luke.1.35","start":42001035,"end":42001035,"break":"none","ruby":[[0,2,"みつかい"],[3,1,"こた"],[6,1,"い"],[11,2,"せいれい"],[18,1,"のぞ"],[23,1,"たか"],[25,1,"もの"],[27,1,"ちから"],[47,1,"うま"],[49,1,"で"],[51,1,"こ"],[53,1,"せい"],[62,1,"かみ"],[64,1,"こ"]],"text":"御使が答えて言った、「聖霊があなたに臨み、いと高き者の力があなたをおおうでしょう。それゆえに、生れ出る子は聖なるものであり、神の子と、となえられるでしょう。"},{"ref":"Luke.1.36","start":42001036,"end":42001036,"break":"none","ruby":[[4,2,"しんぞく"],[12,2,"ろうねん"],[17,1,"こ"],[19,1,"やど"],[26,2,"ふにん"],[29,1,"おんな"],[44,1,"げつ"]],"text":"あなたの親族エリサベツも老年ながら子を宿しています。不妊の女といわれていたのに、はや六か月になっています。"},{"ref":"Luke.1.37","start":42001037,"end":42001037,"break":"none","ruby":[[0,1,"かみ"]],"text":"神には、なんでもできないことはありません」。"},{"ref":"Luke.1.38","start":42001038,"end":42001038,"break":"none","ruby":[[7,1,"い"],[16,1,"しゅ"],[26,2,"ことば"],[33,1,"み"],[35,1,"な"],[47,2,"みつかい"],[50,2,"かのじょ"],[54,1,"はな"],[57,1,"い"]],"text":"そこでマリヤが言った、「わたしは主のはしためです。お言葉どおりこの身に成りますように」。そして御使は彼女から離れて行った。"},{"ref":"Luke.1.39","start":42001039,"end":42001039,"break":"paragraph","ruby":[[9,1,"た"],[13,2,"おおいそ"],[17,2,"やまざと"],[26,1,"まち"],[28,1,"い"]],"text":"そのころ、マリヤは立って、大急ぎで山里へむかいユダの町に行き、"},{"ref":"Luke.1.40","start":42001040,"end":42001040,"break":"none","ruby":[[5,1,"いえ"]],"text":"ザカリヤの家にはいってエリサベツにあいさつした。"},{"ref":"Luke.1.41","start":42001041,"end":42001041,"break":"none","ruby":[[15,1,"き"],[23,1,"こ"],[25,2,"たいない"],[39,2,"せいれい"],[42,1,"み"]],"text":"エリサベツがマリヤのあいさつを聞いたとき、その子が胎内でおどった。エリサベツは聖霊に満たされ、"},{"ref":"Luke.1.42","start":42001042,"end":42001042,"break":"none","ruby":[[0,1,"こえ"],[1,1,"たか"],[3,1,"さけ"],[6,1,"い"],[15,1,"おんな"],[17,1,"なか"],[19,2,"しゅくふく"],[31,1,"たい"],[33,1,"み"],[35,2,"しゅくふく"]],"text":"声高く叫んで言った、「あなたは女の中で祝福されたかた、あなたの胎の実も祝福されています。"},{"ref":"Luke.1.43","start":42001043,"end":42001043,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ははうえ"],[27,2,"こうえい"]],"text":"主の母上がわたしのところにきてくださるとは、なんという光栄でしょう。"},{"ref":"Luke.1.44","start":42001044,"end":42001044,"break":"none","ruby":[[16,1,"こえ"],[22,1,"みみ"],[31,2,"こども"],[34,2,"たいない"],[37,1,"よろこ"]],"text":"ごらんなさい。あなたのあいさつの声がわたしの耳にはいったとき、子供が胎内で喜びおどりました。"},{"ref":"Luke.1.45","start":42001045,"end":42001045,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かた"],[12,1,"かなら"],[14,2,"じょうじゅ"],[19,1,"しん"],[22,1,"おんな"]],"text":"主のお語りになったことが必ず成就すると信じた女は、なんとさいわいなことでしょう」。"},{"ref":"Luke.1.46","start":42001046,"end":42001046,"break":"none","breaks":[[11,"stanza"]],"ruby":[[7,1,"い"],[16,1,"たましい"],[18,1,"しゅ"]],"text":"するとマリヤは言った、「わたしの魂は主をあがめ、"},{"ref":"Luke.1.47","start":42001047,"end":42001047,"break":"line","ruby":[[4,1,"れい"],[6,2,"すくいぬし"],[10,1,"かみ"]],"text":"わたしの霊は救主なる神をたたえます。"},{"ref":"Luke.1.48","start":42001048,"end":42001048,"break":"line","breaks":[[23,"line"]],"ruby":[[2,1,"いや"],[5,1,"おんな"],[10,1,"こころ"],[23,1,"いま"],[28,2,"よよ"],[31,2,"ひとびと"],[44,1,"おんな"],[46,1,"い"]],"text":"この卑しい女をさえ、心にかけてくださいました。今からのち代々の人々は、わたしをさいわいな女と言うでしょう、"},{"ref":"Luke.1.49","start":42001049,"end":42001049,"break":"line","breaks":[[28,"line"]],"ruby":[[0,1,"ちから"],[11,1,"おお"],[14,1,"こと"],[31,1,"な"]],"text":"力あるかたが、わたしに大きな事をしてくださったからです。そのみ名はきよく、"},{"ref":"Luke.1.50","start":42001050,"end":42001050,"break":"line","breaks":[[14,"line"]],"ruby":[[8,2,"よよ"],[10,1,"かぎ"],[14,1,"しゅ"],[20,1,"おそ"],[23,1,"もの"],[25,1,"およ"]],"text":"そのあわれみは、代々限りなく主をかしこみ恐れる者に及びます。"},{"ref":"Luke.1.51","start":42001051,"end":42001051,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"うで"],[8,1,"ちから"],[14,1,"こころ"],[16,1,"おも"],[22,1,"たか"],[25,1,"もの"],[27,1,"お"],[29,1,"ち"]],"text":"主はみ腕をもって力をふるい、心の思いのおごり高ぶる者を追い散らし、"},{"ref":"Luke.1.52","start":42001052,"end":42001052,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"けんりょく"],[4,1,"もの"],[6,2,"おうざ"],[10,1,"ひ"],[16,1,"いや"],[19,1,"もの"],[21,1,"ひ"],[23,1,"あ"]],"text":"権力ある者を王座から引きおろし、卑しい者を引き上げ、"},{"ref":"Luke.1.53","start":42001053,"end":42001053,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"う"],[5,1,"もの"],[7,1,"よ"],[12,1,"あ"],[16,1,"と"],[21,1,"もの"],[23,2,"くうふく"],[28,1,"かえ"]],"text":"飢えている者を良いもので飽かせ、富んでいる者を空腹のまま帰らせなさいます。"},{"ref":"Luke.1.54","start":42001054,"end":42001054,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"わす"],[18,1,"しもべ"],[25,1,"たす"]],"text":"主は、あわれみをお忘れにならず、その僕イスラエルを助けてくださいました、"},{"ref":"Luke.1.55","start":42001055,"end":42001055,"break":"line","breaks":[[20,"line"]],"ruby":[[6,2,"ふそ"],[16,2,"しそん"],[30,2,"やくそく"]],"text":"わたしたちの父祖アブラハムとその子孫とをとこしえにあわれむと約束なさったとおりに」。"},{"ref":"Luke.1.56","start":42001056,"end":42001056,"break":"none","ruby":[[17,1,"げつ"],[20,2,"たいざい"],[27,1,"いえ"],[29,1,"かえ"]],"text":"マリヤは、エリサベツのところに三か月ほど滞在してから、家に帰った。"},{"ref":"Luke.1.57","start":42001057,"end":42001057,"break":"paragraph","ruby":[[8,1,"つき"],[10,1,"み"],[14,1,"おとこ"],[16,1,"こ"],[18,1,"う"]],"text":"さてエリサベツは月が満ちて、男の子を産んだ。"},{"ref":"Luke.1.58","start":42001058,"end":42001058,"break":"none","ruby":[[0,2,"きんじょ"],[3,2,"ひとびと"],[6,2,"しんぞく"],[10,1,"しゅ"],[12,1,"おお"],[20,2,"かのじょ"],[33,1,"き"],[37,1,"とも"],[41,1,"よろこ"]],"text":"近所の人々や親族は、主が大きなあわれみを彼女におかけになったことを聞いて、共どもに喜んだ。"},{"ref":"Luke.1.59","start":42001059,"end":42001059,"break":"none","ruby":[[1,2,"かめ"],[10,1,"おさ"],[12,1,"ご"],[14,2,"かつれい"],[22,2,"ひとびと"],[28,1,"ちち"],[30,1,"な"],[43,1,"な"]],"text":"八日目になったので、幼な子に割礼をするために人々がきて、父の名にちなんでザカリヤという名にしようとした。"},{"ref":"Luke.1.60","start":42001060,"end":42001060,"break":"none","ruby":[[5,2,"ははおや"],[20,1,"な"],[34,1,"い"]],"text":"ところが、母親は、「いいえ、ヨハネという名にしなくてはいけません」と言った。"},{"ref":"Luke.1.61","start":42001061,"end":42001061,"break":"none","ruby":[[0,2,"ひとびと"],[9,2,"しんぞく"],[12,1,"なか"],[20,1,"な"],[25,1,"もの"],[38,2,"かのじょ"],[41,1,"い"]],"text":"人々は、「あなたの親族の中には、そういう名のついた者は、ひとりもいません」と彼女に言った。"},{"ref":"Luke.1.62","start":42001062,"end":42001062,"break":"none","ruby":[[3,2,"ちちおや"],[10,1,"な"],[21,2,"あいず"],[24,1,"たず"]],"text":"そして父親に、どんな名にしたいのですかと、合図で尋ねた。"},{"ref":"Luke.1.63","start":42001063,"end":42001063,"break":"none","ruby":[[5,1,"かき"],[6,1,"いた"],[8,1,"も"],[22,1,"な"],[29,1,"か"],[39,1,"もの"],[41,3,"ふしぎ"],[45,1,"おも"]],"text":"ザカリヤは書板を持ってこさせて、それに「その名はヨハネ」と書いたので、みんなの者は不思議に思った。"},{"ref":"Luke.1.64","start":42001064,"end":42001064,"break":"none","ruby":[[4,1,"た"],[15,1,"くち"],[17,1,"ひら"],[20,1,"した"],[26,1,"かた"],[28,1,"だ"],[31,1,"かみ"]],"text":"すると、立ちどころにザカリヤの口が開けて舌がゆるみ、語り出して神をほめたたえた。"},{"ref":"Luke.1.65","start":42001065,"end":42001065,"break":"none","ruby":[[0,2,"きんじょ"],[3,2,"ひとびと"],[8,1,"おそ"],[21,2,"やまざと"],[24,1,"いた"],[35,1,"こと"],[42,1,"かた"],[44,1,"つた"]],"text":"近所の人々はみな恐れをいだき、またユダヤの山里の至るところに、これらの事がことごとく語り伝えられたので、"},{"ref":"Luke.1.66","start":42001066,"end":42001066,"break":"none","ruby":[[0,1,"き"],[2,1,"もの"],[6,1,"みな"],[10,1,"こころ"],[12,1,"と"],[19,1,"こ"],[30,1,"もの"],[39,1,"かた"],[41,1,"あ"],[45,1,"しゅ"],[48,1,"て"],[50,1,"かれ"],[52,1,"とも"]],"text":"聞く者たちは皆それを心に留めて、「この子は、いったい、どんな者になるだろう」と語り合った。主のみ手が彼と共にあった。"},{"ref":"Luke.1.67","start":42001067,"end":42001067,"break":"stanza","ruby":[[0,1,"ちち"],[6,2,"せいれい"],[9,1,"み"],[14,2,"よげん"],[18,1,"い"]],"text":"父ザカリヤは聖霊に満たされ、預言して言った、"},{"ref":"Luke.1.68","start":42001068,"end":42001068,"break":"line","breaks":[[20,"line"]],"ruby":[[1,1,"しゅ"],[10,1,"かみ"],[20,1,"かみ"],[24,1,"たみ"],[26,1,"かえり"]],"text":"「主なるイスラエルの神は、ほむべきかな。神はその民を顧みてこれをあがない、"},{"ref":"Luke.1.69","start":42001069,"end":42001069,"break":"line","breaks":[[13,"line"]],"ruby":[[9,1,"すくい"],[11,1,"つの"],[13,1,"しもべ"],[18,1,"いえ"],[21,1,"た"]],"text":"わたしたちのために救の角を僕ダビデの家にお立てになった。"},{"ref":"Luke.1.70","start":42001070,"end":42001070,"break":"line","ruby":[[0,1,"ふる"],[5,1,"せい"],[8,3,"よげんしゃ"],[14,1,"くち"],[20,1,"かた"]],"text":"古くから、聖なる預言者たちの口によってお語りになったように、"},{"ref":"Luke.1.71","start":42001071,"end":42001071,"break":"line","ruby":[[6,1,"てき"],[21,1,"にく"],[23,1,"もの"],[25,1,"て"],[29,1,"すく"],[31,1,"だ"]],"text":"わたしたちを敵から、またすべてわたしたちを憎む者の手から、救い出すためである。"},{"ref":"Luke.1.72","start":42001072,"end":42001072,"break":"line","ruby":[[5,1,"かみ"],[13,2,"ふそ"],[28,1,"せい"],[31,2,"けいやく"]],"text":"こうして、神はわたしたちの父祖たちにあわれみをかけ、その聖なる契約、"},{"ref":"Luke.1.73","start":42001073,"end":42001073,"break":"line","ruby":[[5,2,"ふそ"],[14,1,"た"],[20,1,"ちか"]],"text":"すなわち、父祖アブラハムにお立てになった誓いをおぼえて、"},{"ref":"Luke.1.74","start":42001074,"end":42001074,"break":"line","ruby":[[6,1,"てき"],[8,1,"て"],[11,1,"すく"],[13,1,"だ"]],"text":"わたしたちを敵の手から救い出し、"},{"ref":"Luke.1.75","start":42001075,"end":42001075,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"い"],[5,1,"かぎ"],[11,1,"ただ"],[19,1,"おそ"],[23,1,"つか"]],"text":"生きている限り、きよく正しく、みまえに恐れなく仕えさせてくださるのである。"},{"ref":"Luke.1.76","start":42001076,"end":42001076,"break":"line","breaks":[[29,"line"]],"ruby":[[0,1,"おさ"],[2,1,"ご"],[12,1,"たか"],[14,1,"もの"],[16,3,"よげんしゃ"],[20,1,"よ"],[29,1,"しゅ"],[35,2,"さきだ"],[39,1,"い"],[44,1,"みち"],[46,1,"そな"]],"text":"幼な子よ、あなたは、いと高き者の預言者と呼ばれるであろう。主のみまえに先立って行き、その道を備え、"},{"ref":"Luke.1.77","start":42001077,"end":42001077,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"つみ"],[8,1,"すくい"],[12,1,"たみ"],[14,1,"し"]],"text":"罪のゆるしによる救をその民に知らせるのであるから。"},{"ref":"Luke.1.78","start":42001078,"end":42001078,"break":"line","breaks":[[25,"line"]],"ruby":[[9,1,"かみ"],[15,1,"ふか"],[39,1,"ひ"],[41,1,"ひかり"],[43,1,"うえ"],[52,1,"のぞ"]],"text":"これはわたしたちの神のあわれみ深いみこころによる。また、そのあわれみによって、日の光が上からわたしたちに臨み、"},{"ref":"Luke.1.79","start":42001079,"end":42001079,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"あんこく"],[3,1,"し"],[5,1,"かげ"],[8,1,"す"],[10,1,"もの"],[12,1,"てら"],[21,1,"あし"],[23,2,"へいわ"],[26,1,"みち"],[28,1,"みちび"]],"text":"暗黒と死の陰とに住む者を照し、わたしたちの足を平和の道へ導くであろう」。"},{"ref":"Luke.1.80","start":42001080,"end":42001080,"break":"none","ruby":[[0,1,"おさ"],[2,1,"ご"],[4,2,"せいちょう"],[10,1,"れい"],[12,1,"つよ"],[26,1,"あらわ"],[29,1,"ひ"],[33,2,"あらの"]],"text":"幼な子は成長し、その霊も強くなり、そしてイスラエルに現れる日まで、荒野にいた。"}]