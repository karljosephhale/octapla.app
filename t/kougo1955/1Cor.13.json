[{"ref":"1Cor.13.1","start":46013001,"end":46013001,"break":"paragraph","ruby":[[8,2,"ひとびと"],[11,2,"ことば"],[14,2,"みつかい"],[19,2,"ことば"],[22,1,"かた"],[29,1,"あい"],[46,1,"かね"],[48,1,"さわ"],[52,2,"にょうはち"],[55,1,"おな"]],"text":"たといわたしが、人々の言葉や御使たちの言葉を語っても、もし愛がなければ、わたしは、やかましい鐘や騒がしい鐃鉢と同じである。"},{"ref":"1Cor.13.2","start":46013002,"end":46013002,"break":"none","ruby":[[10,2,"よげん"],[15,1,"ちから"],[24,2,"おくぎ"],[31,2,"ちしき"],[35,1,"つう"],[45,1,"やま"],[47,1,"うつ"],[52,1,"つよ"],[54,2,"しんこう"],[64,1,"あい"],[75,1,"む"],[77,1,"ひと"]],"text":"たといまた、わたしに預言をする力があり、あらゆる奥義とあらゆる知識とに通じていても、また、山を移すほどの強い信仰があっても、もし愛がなければ、わたしは無に等しい。"},{"ref":"1Cor.13.3","start":46013003,"end":46013003,"break":"none","ruby":[[10,2,"じぶん"],[13,1,"ぜん"],[14,2,"ざいさん"],[17,1,"ひと"],[19,1,"ほどこ"],[27,2,"じぶん"],[34,1,"や"],[41,1,"わた"],[48,1,"あい"],[60,2,"むえき"]],"text":"たといまた、わたしが自分の全財産を人に施しても、また、自分のからだを焼かれるために渡しても、もし愛がなければ、いっさいは無益である。"},{"ref":"1Cor.13.4","start":46013004,"end":46013004,"break":"paragraph","ruby":[[0,1,"あい"],[2,2,"かんよう"],[8,1,"あい"],[10,2,"なさけぶか"],[27,1,"あい"],[29,1,"たか"],[35,1,"ほこ"]],"text":"愛は寛容であり、愛は情深い。また、ねたむことをしない。愛は高ぶらない、誇らない、"},{"ref":"1Cor.13.5","start":46013005,"end":46013005,"break":"none","ruby":[[0,3,"ぶさほう"],[8,2,"じぶん"],[11,2,"りえき"],[14,1,"もと"],[26,1,"うら"]],"text":"不作法をしない、自分の利益を求めない、いらだたない、恨みをいだかない。"},{"ref":"1Cor.13.6","start":46013006,"end":46013006,"break":"none","ruby":[[0,2,"ふぎ"],[3,1,"よろこ"],[8,2,"しんり"],[11,1,"よろこ"]],"text":"不義を喜ばないで真理を喜ぶ。"},{"ref":"1Cor.13.7","start":46013007,"end":46013007,"break":"none","ruby":[[8,1,"しの"],[15,1,"しん"],[22,1,"のぞ"],[29,1,"た"]],"text":"そして、すべてを忍び、すべてを信じ、すべてを望み、すべてを耐える。"},{"ref":"1Cor.13.8","start":46013008,"end":46013008,"break":"paragraph","ruby":[[0,1,"あい"],[7,1,"た"],[20,2,"よげん"],[27,2,"いげん"],[33,2,"ちしき"]],"text":"愛はいつまでも絶えることがない。しかし、預言はすたれ、異言はやみ、知識はすたれるであろう。"},{"ref":"1Cor.13.9","start":46013009,"end":46013009,"break":"none","ruby":[[11,1,"し"],[18,2,"ぶぶん"],[24,2,"よげん"],[33,2,"ぶぶん"]],"text":"なぜなら、わたしたちの知るところは一部分であり、預言するところも一部分にすぎない。"},{"ref":"1Cor.13.10","start":46013010,"end":46013010,"break":"none","ruby":[[0,1,"まった"],[5,1,"く"],[7,1,"とき"],[11,2,"ぶぶん"],[13,1,"てき"]],"text":"全きものが来る時には、部分的なものはすたれる。"},{"ref":"1Cor.13.11","start":46013011,"end":46013011,"break":"none","ruby":[[6,1,"おさ"],[8,1,"ご"],[13,1,"とき"],[17,1,"おさ"],[19,1,"ご"],[23,1,"かた"],[26,1,"おさ"],[28,1,"ご"],[32,1,"かん"],[38,1,"おさ"],[40,1,"ご"],[44,1,"かんが"],[61,1,"いま"],[64,1,"おさ"],[66,1,"ご"],[73,1,"す"]],"text":"わたしたちが幼な子であった時には、幼な子らしく語り、幼な子らしく感じ、また、幼な子らしく考えていた。しかし、おとなとなった今は、幼な子らしいことを捨ててしまった。"},{"ref":"1Cor.13.12","start":46013012,"end":46013012,"break":"none","ruby":[[7,1,"いま"],[10,1,"かがみ"],[12,1,"うつ"],[15,1,"み"],[25,1,"み"],[35,1,"とき"],[39,1,"かお"],[41,1,"かお"],[44,1,"あ"],[49,1,"み"],[60,1,"し"],[67,1,"いま"],[70,2,"ぶぶん"],[83,1,"とき"],[91,2,"かんぜん"],[94,1,"し"],[104,2,"かんぜん"],[107,1,"し"]],"text":"わたしたちは、今は、鏡に映して見るようにおぼろげに見ている。しかしその時には、顔と顔とを合わせて、見るであろう。わたしの知るところは、今は一部分にすぎない。しかしその時には、わたしが完全に知られているように、完全に知るであろう。"},{"ref":"1Cor.13.13","start":46013013,"end":46013013,"break":"none","ruby":[[11,2,"そんぞく"],[19,2,"しんこう"],[22,2,"きぼう"],[25,1,"あい"],[41,1,"もっと"],[43,1,"おお"],[51,1,"あい"]],"text":"このように、いつまでも存続するものは、信仰と希望と愛と、この三つである。このうちで最も大いなるものは、愛である。"}]