[{"ref":"Ps.45.1","start":19045001,"end":19045001,"break":"paragraph","title":"聖歌隊の指揮者によってゆりの花のしらべにあわせてうたわせたコラの子のマスキールの歌、愛の歌","breaks":[[19,"line"],[40,"line"]],"ruby":[[4,1,"こころ"],[11,2,"ことば"],[23,1,"おう"],[35,1,"し"],[37,1,"かた"],[44,1,"した"],[51,1,"もの"],[52,1,"か"],[54,1,"ひと"],[56,1,"ふで"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[14,1,"はな"],[32,1,"こ"],[40,1,"うた"],[42,1,"あい"],[44,1,"うた"]],"text":"わたしの心はうるわしい言葉であふれる。わたしは王についてよんだわたしの詩を語る。わたしの舌はすみやかに物書く人の筆のようだ。"},{"ref":"Ps.45.2","start":19045002,"end":19045002,"break":"line","breaks":[[17,"line"],[34,"line"]],"ruby":[[4,1,"ひと"],[6,1,"こ"],[13,1,"うるわ"],[17,2,"きひん"],[27,1,"そそ"],[39,1,"かみ"],[50,2,"しゅくふく"]],"text":"あなたは人の子らにまさって麗しく、気品がそのくちびるに注がれている。このゆえに神はとこしえにあなたを祝福された。"},{"ref":"Ps.45.3","start":19045003,"end":19045003,"break":"line","breaks":[[17,"line"]],"ruby":[[6,2,"こうえい"],[9,2,"いげん"],[21,1,"こし"],[23,1,"お"]],"text":"ますらおよ、光栄と威厳とをもって、つるぎを腰に帯びよ。"},{"ref":"Ps.45.4","start":19045004,"end":19045004,"break":"line","breaks":[[16,"line"],[33,"line"],[52,"line"]],"ruby":[[0,2,"しんり"],[8,2,"せいぎ"],[11,1,"まも"],[16,2,"いげん"],[23,2,"しょうり"],[26,1,"え"],[28,1,"の"],[30,1,"すす"],[37,1,"みぎ"],[39,1,"て"],[45,1,"おそ"],[52,1,"おし"]],"text":"真理のため、また正義を守るために威厳をもって、勝利を得て乗り進め。あなたの右の手はあなたに恐るべきわざを教えるであろう。"},{"ref":"Ps.45.5","start":19045005,"end":19045005,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"や"],[6,1,"するど"],[10,1,"おう"],[12,1,"てき"],[14,1,"むね"],[26,1,"たみ"],[35,1,"たお"]],"text":"あなたの矢は鋭くて、王の敵の胸をつらぬき、もろもろの民はあなたのもとに倒れる。"},{"ref":"Ps.45.6","start":19045006,"end":19045006,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かみ"],[3,1,"たま"],[11,1,"くらい"],[13,2,"えいえん"],[21,1,"つづ"],[28,1,"おう"],[33,2,"こうへい"]],"text":"神から賜わったあなたの位は永遠にかぎりなく続き、あなたの王のつえは公平のつえである。"},{"ref":"Ps.45.7","start":19045007,"end":19045007,"break":"line","breaks":[[14,"line"],[32,"line"]],"ruby":[[4,1,"ぎ"],[6,1,"あい"],[9,1,"あく"],[11,1,"にく"],[19,1,"かみ"],[25,1,"かみ"],[27,1,"よろこ"],[30,1,"あぶら"],[50,1,"そそ"]],"text":"あなたは義を愛し、悪を憎む。このゆえに神、あなたの神は喜びの油をあなたのともがらにまさって、あなたに注がれた。"},{"ref":"Ps.45.8","start":19045008,"end":19045008,"break":"line","breaks":[[18,"line"],[30,"line"]],"ruby":[[4,1,"ころも"],[8,2,"もつやく"],[11,2,"ろかい"],[14,2,"にっけい"],[24,1,"はな"],[30,1,"こと"],[32,1,"ね"],[34,2,"ぞうげ"],[37,1,"との"],[40,1,"で"],[47,1,"よろこ"]],"text":"あなたの衣はみな没薬、芦薈、肉桂で、よいかおりを放っている。琴の音は象牙の殿から出て、あなたを喜ばせる。"},{"ref":"Ps.45.9","start":19045009,"end":19045009,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"あい"],[7,1,"おんな"],[15,1,"おう"],[17,1,"むすめ"],[24,2,"おうひ"],[31,1,"きん"],[33,1,"かざ"],[41,1,"みぎ"],[43,1,"た"]],"text":"あなたの愛する女たちのうちには王の娘たちがあり、王妃はオフルの金を飾って、あなたの右に立つ。"},{"ref":"Ps.45.10","start":19045010,"end":19045010,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"むすめ"],[3,1,"き"],[11,1,"みみ"],[13,1,"かたむ"],[21,1,"たみ"],[28,1,"ちち"],[30,1,"いえ"],[33,1,"わす"]],"text":"娘よ、聞け、かえりみて耳を傾けよ。あなたの民と、あなたの父の家とを忘れよ。"},{"ref":"Ps.45.11","start":19045011,"end":19045011,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"おう"],[12,1,"した"],[19,1,"かれ"],[25,1,"しゅ"],[32,1,"かれ"],[34,1,"ふ"]],"text":"王はあなたのうるわしさを慕うであろう。彼はあなたの主であるから、彼を伏しおがめ。"},{"ref":"Ps.45.12","start":19045012,"end":19045012,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"たみ"],[5,1,"おく"],[7,1,"もの"],[15,1,"たみ"],[20,1,"と"],[23,1,"もの"],[29,2,"こうい"],[32,1,"こ"],[34,1,"もと"]],"text":"ツロの民は贈り物をもちきたり、民のうちの富める者もあなたの好意を請い求める。"},{"ref":"Ps.45.13","start":19045013,"end":19045013,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"おう"],[2,1,"むすめ"],[4,1,"との"],[9,1,"さか"],[20,1,"お"],[22,1,"こ"],[25,1,"ころも"],[27,2,"きかざ"]],"text":"王の娘は殿のうちで栄えをきわめ、こがねを織り込んだ衣を着飾っている。"},{"ref":"Ps.45.14","start":19045014,"end":19045014,"break":"line","breaks":[[22,"line"],[34,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"ぬ"],[5,1,"と"],[9,1,"ころも"],[11,1,"き"],[13,1,"おう"],[18,1,"みちび"],[24,1,"とも"],[34,2,"かのじょ"],[37,1,"したが"],[42,2,"ぎょうれつ"]],"text":"彼女は縫い取りした衣を着て王のもとに導かれ、その供びとなるおとめらは彼女に従ってその行列にある。"},{"ref":"Ps.45.15","start":19045015,"end":19045015,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[3,1,"よろこ"],[6,1,"たの"],[14,1,"みちび"],[17,1,"い"],[20,1,"おう"],[22,2,"きゅうでん"]],"text":"彼らは喜びと楽しみとをもって導かれ行き、王の宮殿にはいる。"},{"ref":"Ps.45.16","start":19045016,"end":19045016,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"こ"],[7,2,"ふそ"],[10,1,"かわ"],[13,1,"た"],[20,1,"かれ"],[23,1,"ぜん"],[24,1,"ち"],[26,1,"きみ"]],"text":"あなたの子らは父祖に代って立ち、あなたは彼らを全地に君とするであろう。"},{"ref":"Ps.45.17","start":19045017,"end":19045017,"break":"line","breaks":[[22,"line"],[41,"line"]],"ruby":[[8,1,"な"],[13,1,"よ"],[32,1,"たみ"],[34,2,"よよ"]],"text":"わたしはあなたの名をよろず代におぼえさせる。このゆえにもろもろの民は世々かぎりなくあなたをほめたたえるであろう。"}]