[{"ref":"Ps.114.1","start":19114001,"end":19114001,"break":"paragraph","breaks":[[14,"line"]],"ruby":[[18,1,"いえ"],[20,1,"い"],[21,1,"げん"],[23,1,"たみ"],[25,1,"はな"]],"text":"イスラエルがエジプトをいで、ヤコブの家が異言の民を離れたとき、"},{"ref":"Ps.114.2","start":19114002,"end":19114002,"break":"line","breaks":[[11,"line"]],"ruby":[[3,1,"しゅ"],[5,2,"せいじょ"],[17,1,"しゅ"],[19,2,"しょりょう"]],"text":"ユダは主の聖所となり、イスラエルは主の所領となった。"},{"ref":"Ps.114.3","start":19114003,"end":19114003,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"うみ"],[5,1,"み"],[7,1,"に"],[19,1,"しりぞ"]],"text":"海はこれを見て逃げ、ヨルダンはうしろに退き、"},{"ref":"Ps.114.4","start":19114004,"end":19114004,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"やま"],[2,2,"おひつじ"],[8,1,"おど"],[11,2,"こやま"],[14,2,"こひつじ"],[20,1,"おど"]],"text":"山は雄羊のように踊り、小山は小羊のように踊った。"},{"ref":"Ps.114.5","start":19114005,"end":19114005,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"うみ"],[11,1,"に"],[35,1,"しりぞ"]],"text":"海よ、おまえはどうして逃げるのか、ヨルダンよ、おまえはどうしてうしろに退くのか。"},{"ref":"Ps.114.6","start":19114006,"end":19114006,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"やま"],[13,2,"おひつじ"],[19,1,"おど"],[24,2,"こやま"],[38,2,"こひつじ"],[44,1,"おど"]],"text":"山よ、おまえたちはどうして雄羊のように踊るのか、小山よ、おまえたちはどうして小羊のように踊るのか。"},{"ref":"Ps.114.7","start":19114007,"end":19114007,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ち"],[3,1,"しゅ"],[6,1,"まえ"],[17,1,"かみ"],[20,1,"まえ"]],"text":"地よ、主のみ前におののけ、ヤコブの神のみ前におののけ。"},{"ref":"Ps.114.8","start":19114008,"end":19114008,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"いわ"],[4,1,"いけ"],[6,1,"かわ"],[10,1,"いし"],[12,1,"いずみ"],[14,1,"かわ"]],"text":"主は岩を池に変らせ、石を泉に変らせられた。"}]