[{"ref":"Zech.4.1","start":38004001,"end":38004001,"break":"paragraph","ruby":[[4,1,"かた"],[7,1,"てん"],[9,1,"つかい"],[13,1,"き"],[20,1,"よ"],[31,1,"ねむ"],[35,1,"よ"],[42,1,"ひと"]],"text":"わたしと語った天の使がまた来て、わたしを呼びさました。わたしは眠りから呼びさまされた人のようであった。"},{"ref":"Zech.4.2","start":38004002,"end":38004002,"break":"none","ruby":[[0,1,"かれ"],[6,1,"む"],[11,1,"なに"],[13,1,"み"],[18,1,"い"],[28,1,"い"],[37,1,"み"],[46,1,"きん"],[48,1,"つく"],[52,2,"しょくだい"],[63,1,"うえ"],[65,1,"あぶら"],[67,1,"い"],[70,1,"うつわ"],[77,2,"しょくだい"],[80,1,"うえ"],[89,1,"さら"],[100,1,"さら"],[102,2,"しょくだい"],[105,1,"うえ"],[119,1,"ほん"],[123,1,"かん"]],"text":"彼がわたしに向かって「何を見るか」と言ったので、わたしは言った、「わたしが見ていると、すべて金で造られた燭台が一つあって、その上に油を入れる器があり、また燭台の上に七つのともしび皿があり、そのともしび皿は燭台の上にあって、これにおのおの七本ずつの管があります。"},{"ref":"Zech.4.3","start":38004003,"end":38004003,"break":"none","ruby":[[2,2,"しょくだい"],[15,1,"き"],[18,1,"ほん"],[24,1,"ぽん"],[26,1,"あぶら"],[31,1,"うつわ"],[33,1,"みぎ"],[39,1,"ぽん"],[43,1,"ひだり"]],"text":"また燭台のかたわらに、オリブの木が二本あって、一本は油をいれる器の右にあり、一本はその左にあります」。"},{"ref":"Zech.4.4","start":38004004,"end":38004004,"break":"none","ruby":[[10,1,"かた"],[12,1,"てん"],[14,1,"つかい"],[16,1,"い"],[23,1,"しゅ"]],"text":"わたしはまたわたしと語る天の使に言った、「わが主よ、これらはなんですか」。"},{"ref":"Zech.4.5","start":38004005,"end":38004005,"break":"none","ruby":[[4,1,"かた"],[6,1,"てん"],[8,1,"つかい"],[10,1,"こた"],[28,1,"し"],[38,1,"い"],[51,1,"しゅ"],[54,1,"し"],[61,1,"い"]],"text":"わたしと語る天の使は答えて、「あなたはそれがなんであるか知らないのですか」と言ったので、わたしは「わが主よ、知りません」と言った。"},{"ref":"Zech.4.6","start":38004006,"end":38004006,"break":"none","ruby":[[3,1,"かれ"],[9,1,"い"],[21,1,"しゅ"],[24,1,"つ"],[29,2,"ことば"],[37,2,"ばんぐん"],[40,1,"しゅ"],[42,1,"おお"],[51,2,"けんせい"],[58,2,"のうりょく"],[69,1,"れい"]],"text":"すると彼はわたしに言った、「ゼルバベルに、主がお告げになる言葉はこれです。万軍の主は仰せられる、これは権勢によらず、能力によらず、わたしの霊によるのである。"},{"ref":"Zech.4.7","start":38004007,"end":38004007,"break":"none","ruby":[[0,1,"おお"],[4,1,"やま"],[11,2,"なにもの"],[25,1,"まえ"],[27,2,"へいち"],[33,1,"かれ"],[36,1,"めぐ"],[44,1,"めぐ"],[50,1,"よ"],[61,1,"いし"],[63,1,"ひ"],[65,1,"だ"]],"text":"大いなる山よ、おまえは何者か。おまえはゼルバベルの前に平地となる。彼は『恵みあれ、これに恵みあれ』と呼ばわりながら、かしら石を引き出すであろう」。"},{"ref":"Zech.4.8","start":38004008,"end":38004008,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"],[12,1,"い"]],"text":"主の言葉がわたしに臨んで言うには、"},{"ref":"Zech.4.9","start":38004009,"end":38004009,"break":"none","ruby":[[7,1,"て"],[11,1,"みや"],[13,1,"いしずえ"],[19,1,"かれ"],[21,1,"て"],[26,2,"かんせい"],[33,1,"とき"],[40,2,"ばんぐん"],[43,1,"しゅ"],[65,1,"し"]],"text":"「ゼルバベルの手はこの宮の礎をすえた。彼の手はこれを完成する。その時あなたがたは万軍の主が、わたしをあなたがたにつかわされたことを知る。"},{"ref":"Zech.4.10","start":38004010,"end":38004010,"break":"none","breaks":[[43,"paragraph"]],"ruby":[[4,1,"ちい"],[7,1,"こと"],[9,1,"ひ"],[16,1,"もの"],[25,1,"て"],[28,1,"さ"],[30,1,"ふ"],[37,1,"み"],[40,1,"よろこ"],[58,1,"ぜん"],[59,1,"ち"],[61,1,"い"],[63,1,"き"],[66,1,"しゅ"],[68,1,"め"]],"text":"だれでも小さい事の日をいやしめた者は、ゼルバベルの手に、下げ振りのあるのを見て、喜ぶ。これらの七つのものは、あまねく全地を行き来する主の目である」。"},{"ref":"Zech.4.11","start":38004011,"end":38004011,"break":"none","ruby":[[6,1,"かれ"],[8,1,"たず"],[13,2,"しょくだい"],[16,2,"さゆう"],[25,1,"ほん"],[31,1,"き"],[40,1,"い"]],"text":"わたしはまた彼に尋ねて、「燭台の左右にある、この二本のオリブの木はなんですか」と言い、"},{"ref":"Zech.4.12","start":38004012,"end":38004012,"break":"none","ruby":[[0,1,"かさ"],[9,1,"ほん"],[11,1,"きん"],[13,1,"くだ"],[19,1,"あぶら"],[25,1,"そそ"],[27,1,"だ"],[34,1,"えだ"],[43,1,"い"]],"text":"重ねてまた「この二本の金の管によって、油をそれから注ぎ出すオリブの二枝はなんですか」と言うと、"},{"ref":"Zech.4.13","start":38004013,"end":38004013,"break":"none","ruby":[[0,1,"かれ"],[6,1,"こた"],[24,1,"し"],[34,1,"い"],[43,1,"しゅ"],[46,1,"し"],[53,1,"い"]],"text":"彼はわたしに答えて、「あなたはそれがなんであるか知らないのですか」と言ったので、「わが主よ、知りません」と言った。"},{"ref":"Zech.4.14","start":38004014,"end":38004014,"break":"none","ruby":[[3,1,"かれ"],[5,1,"い"],[18,1,"あぶら"],[24,1,"もの"],[27,1,"ぜん"],[28,1,"ち"],[30,1,"しゅ"],[37,1,"た"],[39,1,"もの"]],"text":"すると彼は言った、「これらはふたりの油そそがれた者で、全地の主のかたわらに立つ者です」。"}]