[{"ref":"Ps.70.1","start":19070001,"end":19070001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの記念の歌","breaks":[[22,"line"]],"ruby":[[0,1,"かみ"],[15,1,"すく"],[22,1,"しゅ"],[35,1,"たす"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,2,"きねん"],[23,1,"うた"]],"text":"神よ、みこころならばわたしをお救いください。主よ、すみやかにわたしをお助けください。"},{"ref":"Ps.70.2","start":19070002,"end":19070002,"break":"line","breaks":[[18,"line"],[31,"line"],[50,"line"]],"ruby":[[11,1,"もと"],[14,1,"もの"],[18,1,"は"],[44,1,"ねが"],[46,1,"もの"],[54,1,"しりぞ"],[58,1,"はじ"],[60,1,"お"]],"text":"わたしのいのちをたずね求める者どもを恥じあわてさせてください。わたしのそこなわれることを願う者どもをうしろに退かせ、恥を負わせてください。"},{"ref":"Ps.70.3","start":19070003,"end":19070003,"break":"line","breaks":[[16,"line"]],"ruby":[[10,1,"い"],[12,1,"もの"],[16,2,"じぶん"],[19,1,"はじ"],[24,1,"おそ"]],"text":"「あはぁ、あはぁ」と言う者どもを自分の恥によって恐れおののかせてください。"},{"ref":"Ps.70.4","start":19070004,"end":19070004,"break":"line","breaks":[[14,"line"],[30,"line"],[41,"line"]],"ruby":[[7,1,"たず"],[9,1,"もと"],[12,1,"もの"],[21,1,"よろこ"],[23,1,"たの"],[34,1,"すくい"],[36,1,"あい"],[39,1,"もの"],[45,1,"かみ"],[47,1,"おお"]],"text":"すべてあなたを尋ね求める者はあなたによって喜び楽しむように。あなたの救を愛する者はつねに「神は大いなるかな」ととなえるように。"},{"ref":"Ps.70.5","start":19070005,"end":19070005,"break":"line","breaks":[[18,"line"],[35,"line"],[51,"line"]],"ruby":[[8,1,"まず"],[14,1,"とぼ"],[18,1,"かみ"],[21,1,"いそ"],[28,1,"き"],[41,1,"たす"],[46,2,"すくいぬし"],[51,1,"しゅ"]],"text":"しかし、わたしは貧しく、かつ乏しい。神よ、急いでわたしに来てください。あなたはわが助け、わが救主です。主よ、ためらわないでください。"}]