[{"ref":"Jonah.3.1","start":32003001,"end":32003001,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,2,"ことば"],[7,1,"ふたた"],[12,1,"のぞ"],[15,1,"い"]],"text":"時に主の言葉は再びヨナに臨んで言った、"},{"ref":"Jonah.3.2","start":32003002,"end":32003002,"break":"none","ruby":[[1,1,"た"],[7,1,"おお"],[10,1,"まち"],[15,1,"い"],[22,1,"めい"],[25,2,"ことば"],[31,1,"つた"]],"text":"「立って、あの大きな町ニネベに行き、あなたに命じる言葉をこれに伝えよ」。"},{"ref":"Jonah.3.3","start":32003003,"end":32003003,"break":"none","ruby":[[6,1,"しゅ"],[8,2,"ことば"],[11,1,"したが"],[14,1,"た"],[22,1,"い"],[30,2,"ひじょう"],[33,1,"おお"],[36,1,"まち"],[45,1,"い"],[54,1,"か"],[56,1,"よう"]],"text":"そこでヨナは主の言葉に従い、立って、ニネベに行った。ニネベは非常に大きな町であって、これを行きめぐるには、三日を要するほどであった。"},{"ref":"Jonah.3.4","start":32003004,"end":32003004,"break":"none","ruby":[[5,1,"まち"],[11,1,"はじ"],[14,1,"にち"],[15,1,"じ"],[17,1,"ゆ"],[23,1,"よ"],[31,1,"にち"],[33,1,"へ"],[40,1,"ほろ"],[45,1,"い"]],"text":"ヨナはその町にはいり、初め一日路を行きめぐって呼ばわり、「四十日を経たらニネベは滅びる」と言った。"},{"ref":"Jonah.3.5","start":32003005,"end":32003005,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"かみ"],[12,1,"しん"],[15,2,"だんじき"],[21,1,"おお"],[24,1,"もの"],[27,1,"ちい"],[30,1,"もの"],[33,2,"あらぬの"],[36,1,"き"]],"text":"そこでニネベの人々は神を信じ、断食をふれ、大きい者から小さい者まで荒布を着た。"},{"ref":"Jonah.3.6","start":32003006,"end":32003006,"break":"paragraph","ruby":[[10,1,"おう"],[12,1,"たっ"],[17,1,"かれ"],[21,2,"おうざ"],[25,1,"た"],[27,1,"あ"],[31,1,"ちょう"],[32,1,"ふく"],[34,1,"ぬ"],[37,2,"あらぬの"],[44,1,"はい"],[46,1,"なか"],[48,1,"ざ"]],"text":"このうわさがニネベの王に達すると、彼はその王座から立ち上がり、朝服を脱ぎ、荒布をまとい、灰の中に座した。"},{"ref":"Jonah.3.7","start":32003007,"end":32003007,"break":"none","ruby":[[2,1,"おう"],[6,2,"だいじん"],[9,2,"ふこく"],[19,1,"なか"],[26,1,"い"],[31,1,"ひと"],[33,1,"けもの"],[35,1,"うし"],[37,1,"ひつじ"],[42,1,"なに"],[45,1,"あじ"],[55,1,"もの"],[57,1,"く"],[60,1,"みず"],[62,1,"の"]],"text":"また王とその大臣の布告をもって、ニネベ中にふれさせて言った、「人も獣も牛も羊もみな、何をも味わってはならない。物を食い、水を飲んではならない。"},{"ref":"Jonah.3.8","start":32003008,"end":32003008,"break":"none","ruby":[[0,1,"ひと"],[2,1,"けもの"],[4,2,"あらぬの"],[15,1,"かみ"],[17,1,"よ"],[28,1,"わる"],[30,1,"みち"],[36,1,"て"],[40,2,"きょうぼう"],[43,1,"はな"]],"text":"人も獣も荒布をまとい、ひたすら神に呼ばわり、おのおのその悪い道およびその手にある強暴を離れよ。"},{"ref":"Jonah.3.9","start":32003009,"end":32003009,"break":"none","ruby":[[4,1,"かみ"],[7,1,"こころ"],[14,1,"はげ"],[17,1,"いか"],[29,1,"ほろ"],[48,1,"し"]],"text":"あるいは神はみ心をかえ、その激しい怒りをやめて、われわれを滅ぼされないかもしれない。だれがそれを知るだろう」。"},{"ref":"Jonah.3.10","start":32003010,"end":32003010,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"かれ"],[13,1,"わる"],[15,1,"みち"],[17,1,"はな"],[22,1,"み"],[26,1,"かれ"],[29,1,"うえ"],[31,1,"くだ"],[35,1,"い"],[39,1,"わざわい"],[41,1,"おも"]],"text":"神は彼らのなすところ、その悪い道を離れたのを見られ、彼らの上に下そうと言われた災を思いかえして、これをおやめになった。"}]