[{"ref":"1Tim.4.1","start":54004001,"end":54004001,"break":"paragraph","ruby":[[4,2,"みたま"],[7,1,"あき"],[11,1,"つ"],[14,1,"い"],[17,1,"のち"],[19,1,"とき"],[27,2,"ひとびと"],[31,1,"まど"],[34,1,"れい"],[36,2,"あくりょう"],[39,1,"おしえ"],[42,1,"き"],[49,2,"しんこう"],[53,1,"はな"],[55,1,"さ"]],"text":"しかし、御霊は明らかに告げて言う。後の時になると、ある人々は、惑わす霊と悪霊の教とに気をとられて、信仰から離れ去るであろう。"},{"ref":"1Tim.4.2","start":54004002,"end":54004002,"break":"none","ruby":[[4,2,"りょうしん"],[7,1,"や"],[9,1,"いん"],[17,1,"いつわ"],[19,1,"もの"],[21,2,"ぎぜん"]],"text":"それは、良心に焼き印をおされている偽り者の偽善のしわざである。"},{"ref":"1Tim.4.3","start":54004003,"end":54004003,"break":"none","ruby":[[4,1,"いつわ"],[6,1,"もの"],[11,2,"けっこん"],[14,1,"きん"],[19,2,"しょくもつ"],[22,1,"た"],[27,1,"めい"],[37,2,"しょくもつ"],[41,2,"しんこう"],[46,2,"しんり"],[49,1,"みと"],[52,1,"もの"],[55,2,"かんしゃ"],[59,1,"う"],[67,1,"かみ"],[69,1,"つく"]],"text":"これらの偽り者どもは、結婚を禁じたり、食物を断つことを命じたりする。しかし食物は、信仰があり真理を認める者が、感謝して受けるようにと、神の造られたものである。"},{"ref":"1Tim.4.4","start":54004004,"end":54004004,"break":"none","ruby":[[0,1,"かみ"],[2,1,"つく"],[12,1,"よ"],[21,2,"かんしゃ"],[25,1,"う"],[31,1,"なに"],[35,1,"す"]],"text":"神の造られたものは、みな良いものであって、感謝して受けるなら、何ひとつ捨てるべきものはない。"},{"ref":"1Tim.4.5","start":54004005,"end":54004005,"break":"none","ruby":[[5,1,"かみ"],[7,1,"ことば"],[9,1,"いのり"]],"text":"それらは、神の言と祈とによって、きよめられるからである。"},{"ref":"1Tim.4.6","start":54004006,"end":54004006,"break":"paragraph","ruby":[[7,2,"きょうだい"],[12,1,"おし"],[23,2,"しんこう"],[26,2,"ことば"],[33,1,"したが"],[38,1,"よ"],[40,1,"おしえ"],[42,2,"ことば"],[46,1,"やしな"],[62,3,"ほうししゃ"]],"text":"これらのことを兄弟たちに教えるなら、あなたは、信仰の言葉とあなたの従ってきた良い教の言葉とに養われて、キリスト・イエスのよい奉仕者になるであろう。"},{"ref":"1Tim.4.7","start":54004007,"end":54004007,"break":"none","ruby":[[4,2,"ぞくあく"],[7,1,"ぐ"],[14,1,"つく"],[16,1,"ばなし"],[18,1,"さ"],[24,2,"しんじん"],[30,2,"じぶん"],[33,2,"くんれん"]],"text":"しかし、俗悪で愚にもつかない作り話は避けなさい。信心のために自分を訓練しなさい。"},{"ref":"1Tim.4.8","start":54004008,"end":54004008,"break":"none","ruby":[[4,2,"くんれん"],[7,1,"すこ"],[10,1,"えき"],[21,2,"しんじん"],[25,1,"いま"],[31,1,"のち"],[33,1,"よ"],[40,2,"やくそく"],[50,2,"ばんじ"],[53,1,"えき"]],"text":"からだの訓練は少しは益するところがあるが、信心は、今のいのちと後の世のいのちとが約束されてあるので、万事に益となる。"},{"ref":"1Tim.4.9","start":54004009,"end":54004009,"break":"none","ruby":[[3,2,"かくじつ"],[11,1,"う"],[17,1,"た"],[19,2,"ことば"]],"text":"これは確実で、そのまま受けいれるに足る言葉である。"},{"ref":"1Tim.4.10","start":54004010,"end":54004010,"break":"none","ruby":[[12,1,"ろう"],[14,1,"くる"],[29,1,"ひと"],[31,2,"すくいぬし"],[34,1,"とく"],[36,1,"しん"],[39,1,"もの"],[43,2,"すくいぬし"],[47,1,"い"],[50,1,"かみ"],[53,1,"のぞ"],[56,1,"お"]],"text":"わたしたちは、このために労し苦しんでいる。それは、すべての人の救主、特に信じる者たちの救主なる生ける神に、望みを置いてきたからである。"},{"ref":"1Tim.4.11","start":54004011,"end":54004011,"break":"paragraph","ruby":[[4,1,"こと"],[6,1,"めい"],[11,1,"おし"]],"text":"これらの事を命じ、また教えなさい。"},{"ref":"1Tim.4.12","start":54004012,"end":54004012,"break":"none","ruby":[[5,1,"とし"],[7,1,"わか"],[12,1,"ひと"],[14,1,"かろ"],[30,2,"ことば"],[35,2,"ぎょうじょう"],[40,1,"あい"],[44,2,"しんこう"],[49,2,"じゅんけつ"],[54,2,"しんじゃ"],[57,2,"もはん"]],"text":"あなたは、年が若いために人に軽んじられてはならない。むしろ、言葉にも、行状にも、愛にも、信仰にも、純潔にも、信者の模範になりなさい。"},{"ref":"1Tim.4.13","start":54004013,"end":54004013,"break":"none","ruby":[[8,1,"ゆ"],[10,1,"とき"],[14,2,"せいしょ"],[17,2,"ろうどく"],[25,1,"すす"],[34,1,"おし"],[41,1,"こころ"],[43,1,"もち"]],"text":"わたしがそちらに行く時まで、聖書を朗読することと、勧めをすることと、教えることとに心を用いなさい。"},{"ref":"1Tim.4.14","start":54004014,"end":54004014,"break":"none","ruby":[[0,2,"ちょうろう"],[3,2,"あんしゅ"],[6,1,"う"],[9,1,"とき"],[11,2,"よげん"],[21,1,"あた"],[26,1,"うち"],[28,1,"も"],[33,1,"めぐ"],[36,2,"たまもの"],[40,2,"けいし"]],"text":"長老の按手を受けた時、預言によってあなたに与えられて内に持っている恵みの賜物を、軽視してはならない。"},{"ref":"1Tim.4.15","start":54004015,"end":54004015,"break":"none","ruby":[[4,1,"こと"],[10,2,"しんぽ"],[25,1,"こと"],[27,2,"じっこう"],[34,1,"はげ"]],"text":"すべての事にあなたの進歩があらわれるため、これらの事を実行し、それを励みなさい。"},{"ref":"1Tim.4.16","start":54004016,"end":54004016,"break":"none","ruby":[[0,2,"じぶん"],[6,1,"おしえ"],[12,1,"き"],[21,1,"つね"],[23,1,"つと"],[40,2,"じぶん"],[42,2,"じしん"],[49,1,"おしえ"],[51,1,"き"],[53,1,"もの"],[59,1,"すく"]],"text":"自分のことと教のこととに気をつけ、それらを常に努めなさい。そうすれば、あなたは、自分自身とあなたの教を聞く者たちとを、救うことになる。"}]