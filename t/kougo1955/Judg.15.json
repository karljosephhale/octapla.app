[{"ref":"Judg.15.1","start":7015001,"end":7015001,"break":"paragraph","ruby":[[0,1,"ひ"],[5,1,"のち"],[7,1,"むぎ"],[8,1,"かり"],[10,1,"とき"],[17,1,"こ"],[21,1,"たずさ"],[24,1,"つま"],[40,1,"つま"],[42,1,"あ"],[50,1,"い"],[55,1,"つま"],[57,1,"ちち"],[65,1,"ゆる"]],"text":"日がたって後、麦刈の時にサムソンは子やぎを携えて妻をおとずれ、「へやにはいって、妻に会いましょう」と言ったが、妻の父ははいることを許さなかった。"},{"ref":"Judg.15.2","start":7015002,"end":7015002,"break":"none","ruby":[[3,1,"ちち"],[5,1,"い"],[14,1,"たし"],[17,2,"かのじょ"],[25,2,"そうい"],[30,1,"おも"],[40,2,"かのじょ"],[47,1,"きゃく"],[52,1,"もの"],[60,2,"かのじょ"],[63,1,"いもうと"],[65,2,"かのじょ"],[86,2,"かのじょ"],[89,1,"かわ"],[92,1,"いもうと"]],"text":"そして父は言った、「あなたが確かに彼女をきらったに相違ないと思ったので、わたしは彼女をあなたの客であった者にやりました。彼女の妹は彼女よりもきれいではありませんか。どうぞ、彼女の代りに妹をめとってください」。"},{"ref":"Judg.15.3","start":7015003,"end":7015003,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[13,2,"こんど"],[27,1,"がい"],[29,1,"くわ"],[34,1,"かれ"],[46,1,"つみ"]],"text":"サムソンは彼らに言った、「今度はわたしがペリシテびとに害を加えても、彼らのことでは、わたしに罪がない」。"},{"ref":"Judg.15.4","start":7015004,"end":7015004,"break":"none","ruby":[[8,1,"い"],[17,1,"ひき"],[19,1,"とら"],[30,1,"お"],[32,1,"お"],[44,1,"お"],[46,1,"あいだ"],[56,1,"むす"]],"text":"そこでサムソンは行って、きつね三百匹を捕え、たいまつをとり、尾と尾をあわせて、その二つの尾の間に一つのたいまつを結びつけ、"},{"ref":"Judg.15.5","start":7015005,"end":7015005,"break":"none","ruby":[[5,1,"ひ"],[26,1,"か"],[30,1,"むぎ"],[32,1,"なか"],[34,1,"はな"],[36,1,"い"],[44,1,"つ"],[53,1,"か"],[61,1,"や"],[67,1,"はたけ"],[70,1,"や"]],"text":"たいまつに火をつけて、そのきつねをペリシテびとのまだ刈らない麦の中に放し入れ、そのたばね積んだものと、まだ刈らないものとを焼き、オリブ畑をも焼いた。"},{"ref":"Judg.15.6","start":7015006,"end":7015006,"break":"none","ruby":[[7,1,"い"],[24,2,"ひとびと"],[27,1,"い"],[38,1,"むこ"],[57,1,"つま"],[59,1,"と"],[61,1,"かえ"],[67,1,"きゃく"],[72,1,"もの"],[74,1,"あた"],[92,1,"のぼ"],[97,2,"かのじょ"],[102,1,"ちち"],[104,1,"いえ"],[106,1,"ひ"],[108,1,"や"],[110,1,"はら"]],"text":"ペリシテびとは言った、「これはだれのしわざか」。人々は言った、「テムナびとの婿サムソンだ。そのしゅうとがサムソンの妻を取り返して、その客であった者に与えたからだ」。そこでペリシテびとは上ってきて彼女とその父の家を火で焼き払った。"},{"ref":"Judg.15.7","start":7015007,"end":7015007,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[41,2,"しかえ"]],"text":"サムソンは彼らに言った、「あなたがたがそんなことをするならば、わたしはあなたがたに仕返しせずにはおかない」。"},{"ref":"Judg.15.8","start":7015008,"end":7015008,"break":"none","ruby":[[8,1,"かれ"],[17,1,"う"],[20,1,"だい"],[23,1,"ころ"],[36,1,"くだ"],[39,1,"い"],[47,1,"いわ"],[49,1,"さ"],[51,1,"め"],[53,1,"す"]],"text":"そしてサムソンは彼らを、さんざんに撃って大ぜい殺した。こうしてサムソンは下って行って、エタムの岩の裂け目に住んでいた。"},{"ref":"Judg.15.9","start":7015009,"end":7015009,"break":"paragraph","ruby":[[10,1,"のぼ"],[19,1,"じん"],[21,1,"と"],[27,1,"せ"]],"text":"そこでペリシテびとは上ってきて、ユダに陣を取り、レヒを攻めたので、"},{"ref":"Judg.15.10","start":7015010,"end":7015010,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"い"],[30,1,"せ"],[44,1,"かれ"],[47,1,"い"],[62,1,"しば"],[65,1,"かれ"],[78,1,"かれ"],[85,1,"のぼ"]],"text":"ユダの人々は言った、「あなたがたはどうしてわれわれのところに攻めのぼってきたのですか」。彼らは言った、「われわれはサムソンを縛り、彼がわれわれにしたように、彼にするために上ってきたのです」。"},{"ref":"Judg.15.11","start":7015011,"end":7015011,"break":"none","ruby":[[6,2,"ひとびと"],[10,1,"にん"],[16,1,"いわ"],[18,1,"さ"],[20,1,"め"],[22,1,"くだ"],[25,1,"い"],[34,1,"い"],[51,3,"しはいしゃ"],[64,1,"し"],[89,1,"こと"],[104,1,"かれ"],[107,1,"い"],[112,1,"かれ"],[129,1,"かれ"]],"text":"そこでユダの人々三千人がエタムの岩の裂け目に下って行って、サムソンに言った、「ペリシテびとはわれわれの支配者であることをあなたは知らないのですか。あなたはどうしてわれわれにこんな事をしたのですか」。サムソンは彼らに言った、「彼らがわたしにしたように、わたしは彼らにしたのです」。"},{"ref":"Judg.15.12","start":7015012,"end":7015012,"break":"none","ruby":[[0,1,"かれ"],[10,1,"い"],[24,1,"しば"],[35,1,"て"],[43,1,"くだ"],[58,1,"かれ"],[61,1,"い"],[71,2,"じしん"],[78,1,"う"],[88,1,"ちか"]],"text":"彼らはまたサムソンに言った、「われわれはあなたを縛って、ペリシテびとの手にわたすために下ってきたのです」。サムソンは彼らに言った、「あなたがた自身はわたしを撃たないということを誓いなさい」。"},{"ref":"Judg.15.13","start":7015013,"end":7015013,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[28,1,"しば"],[39,1,"て"],[49,1,"けっ"],[56,1,"ころ"],[63,1,"かれ"],[67,1,"ほん"],[69,1,"あたら"],[72,1,"つな"],[77,1,"かれ"],[79,1,"しば"],[83,1,"いわ"]],"text":"彼らはサムソンに言った、「いや、われわれはただ、あなたを縛って、ペリシテびとの手にわたすだけです。決してあなたを殺しません」。彼らは二本の新しい綱をもって彼を縛って、岩からひきあげた。"},{"ref":"Judg.15.14","start":7015014,"end":7015014,"break":"paragraph","ruby":[[20,1,"こえ"],[26,1,"かれ"],[28,1,"ちか"],[35,1,"とき"],[37,1,"しゅ"],[39,1,"れい"],[41,1,"はげ"],[44,1,"かれ"],[46,1,"のぞ"],[52,1,"かれ"],[54,1,"うで"],[62,1,"つな"],[64,1,"ひ"],[66,1,"や"],[69,2,"あま"],[85,1,"て"],[88,1,"と"],[91,1,"お"]],"text":"サムソンがレヒにきたとき、ペリシテびとは声をあげて、彼に近づいた。その時、主の霊が激しく彼に臨んだので、彼の腕にかかっていた綱は火に焼けた亜麻のようになって、そのなわめが手から解けて落ちた。"},{"ref":"Judg.15.15","start":7015015,"end":7015015,"break":"none","ruby":[[0,1,"かれ"],[5,1,"あたら"],[10,1,"ほね"],[14,1,"み"],[21,1,"て"],[23,1,"の"],[26,1,"と"],[37,1,"にん"],[39,1,"う"],[41,1,"ころ"]],"text":"彼はろばの新しいあご骨一つを見つけたので、手を伸べて取り、それをもって一千人を打ち殺した。"},{"ref":"Judg.15.16","start":7015016,"end":7015016,"break":"none","breaks":[[12,"stanza"],[31,"line"]],"ruby":[[8,1,"い"],[18,1,"ほね"],[23,1,"やま"],[26,1,"やま"],[28,1,"きず"],[36,1,"ほね"],[43,1,"にん"],[45,1,"う"],[47,1,"ころ"]],"text":"そしてサムソンは言った、「ろばのあご骨をもって山また山を築き、ろばのあご骨をもって一千人を打ち殺した」。"},{"ref":"Judg.15.17","start":7015017,"end":7015017,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[4,1,"おわ"],[10,1,"て"],[15,1,"ほね"],[17,1,"な"],[31,1,"ところ"],[36,1,"ほね"],[38,1,"おか"],[41,1,"よ"]],"text":"彼は言い終ると、その手からあご骨を投げすてた。これがためにその所は「あご骨の丘」と呼ばれた。"},{"ref":"Judg.15.18","start":7015018,"end":7015018,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"かれ"],[11,1,"おぼ"],[17,1,"しゅ"],[19,1,"よ"],[24,1,"い"],[37,1,"て"],[45,1,"おお"],[48,1,"すくい"],[50,1,"ほどこ"],[61,1,"いま"],[67,1,"し"],[70,2,"かつれい"],[80,1,"て"],[82,1,"おちい"]],"text":"時に彼はひどくかわきを覚えたので、主に呼ばわって言った、「あなたはしもべの手をもって、この大きな救を施されたのに、わたしは今、かわいて死に、割礼をうけないものの手に陥ろうとしています」。"},{"ref":"Judg.15.19","start":7015019,"end":7015019,"break":"none","ruby":[[3,1,"かみ"],[14,1,"ところ"],[16,1,"さ"],[27,1,"みず"],[29,1,"なが"],[31,1,"で"],[42,1,"の"],[45,1,"かれ"],[47,1,"れい"],[56,1,"もと"],[57,1,"き"],[67,1,"な"],[70,1,"よ"],[75,1,"もの"],[77,1,"いずみ"],[80,1,"よ"],[87,2,"こんにち"]],"text":"そこで神はレヒにあるくぼんだ所を裂かれたので、そこから水が流れ出た。サムソンがそれを飲むと彼の霊はもとにかえって元気づいた。それでその名を「呼ばわった者の泉」と呼んだ。これは今日までレヒにある。"},{"ref":"Judg.15.20","start":7015020,"end":7015020,"break":"none","ruby":[[12,2,"じだい"],[17,1,"ねん"],[19,1,"あいだ"]],"text":"サムソンはペリシテびとの時代に二十年の間イスラエルをさばいた。"}]