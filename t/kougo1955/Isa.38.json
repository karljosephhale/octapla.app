[{"ref":"Isa.38.1","start":23038001,"end":23038001,"break":"paragraph","ruby":[[9,2,"びょうき"],[15,1,"し"],[28,1,"こ"],[29,3,"よげんしゃ"],[36,1,"かれ"],[42,1,"き"],[44,1,"い"],[49,1,"しゅ"],[53,1,"おお"],[64,1,"いえ"],[66,1,"ととの"],[79,1,"し"],[84,1,"い"]],"text":"そのころヒゼキヤは病気になって死にかかっていた。アモツの子預言者イザヤは彼のところに来て言った、「主はこう仰せられます、あなたの家を整えておきなさい。あなたは死にます、生きながらえることはできません」。"},{"ref":"Isa.38.2","start":23038002,"end":23038002,"break":"none","ruby":[[8,1,"かお"],[10,1,"かべ"],[12,1,"む"],[15,1,"しゅ"],[17,1,"いの"],[20,1,"い"]],"text":"そこでヒゼキヤは顔を壁に向けて主に祈って言った、"},{"ref":"Isa.38.3","start":23038003,"end":23038003,"break":"none","ruby":[[3,1,"しゅ"],[6,1,"ねが"],[15,2,"しんじつ"],[18,2,"まごころ"],[27,1,"まえ"],[29,1,"あゆ"],[36,1,"め"],[41,1,"こと"],[43,1,"おこな"],[48,1,"おぼ"],[68,1,"な"]],"text":"「ああ主よ、願わくは、わたしが真実と真心とをもって、み前に歩み、あなたの目にかなう事を行ったのを覚えてください」。そしてヒゼキヤはひどく泣いた。"},{"ref":"Isa.38.4","start":23038004,"end":23038004,"break":"none","ruby":[[2,1,"とき"],[3,1,"しゅ"],[5,2,"ことば"],[12,1,"のぞ"],[15,1,"い"]],"text":"その時主の言葉がイザヤに臨んで言った、"},{"ref":"Isa.38.5","start":23038005,"end":23038005,"break":"none","ruby":[[1,1,"い"],[10,1,"い"],[21,1,"ちち"],[26,1,"かみ"],[28,1,"しゅ"],[32,1,"おお"],[48,1,"いのり"],[50,1,"き"],[58,1,"なみだ"],[60,1,"み"],[63,1,"み"],[80,1,"ねん"],[81,1,"ま"]],"text":"「行って、ヒゼキヤに言いなさい、『あなたの父ダビデの神、主はこう仰せられます、「わたしはあなたの祈を聞いた。あなたの涙を見た。見よ、わたしはあなたのよわいを十五年増そう。"},{"ref":"Isa.38.6","start":23038006,"end":23038006,"break":"none","ruby":[[11,1,"まち"],[20,1,"おう"],[22,1,"て"],[25,1,"すく"],[30,1,"まち"],[32,1,"まも"]],"text":"わたしはあなたと、この町とをアッスリヤの王の手から救い、この町を守ろう」。"},{"ref":"Isa.38.7","start":23038007,"end":23038007,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"やくそく"],[10,1,"おこな"],[26,1,"しゅ"],[35,1,"え"]],"text":"主が約束されたことを行われることについては、あなたは主からこのしるしを得る。"},{"ref":"Isa.38.8","start":23038008,"end":23038008,"break":"none","ruby":[[0,1,"み"],[11,1,"ひ"],[12,2,"どけい"],[15,1,"うえ"],[17,1,"すす"],[20,2,"ひかげ"],[24,1,"ど"],[25,1,"しりぞ"],[36,3,"ひどけい"],[40,1,"うえ"],[42,1,"すす"],[45,2,"ひかげ"],[49,1,"ど"],[50,1,"しりぞ"]],"text":"見よ、わたしはアハズの日時計の上に進んだ日影を十度退かせよう』」。すると日時計の上に進んだ日影が十度退いた。"},{"ref":"Isa.38.9","start":23038009,"end":23038009,"break":"paragraph","ruby":[[0,1,"つぎ"],[2,2,"ことば"],[8,1,"おう"],[14,2,"びょうき"],[23,2,"びょうき"],[26,1,"なお"],[29,1,"のち"],[31,1,"か"]],"text":"次の言葉はユダの王ヒゼキヤが病気になって、その病気が直った後、書きしるしたものである。"},{"ref":"Isa.38.10","start":23038010,"end":23038010,"break":"stanza","breaks":[[23,"line"],[34,"line"],[49,"line"]],"ruby":[[4,1,"い"],[14,2,"いっしょう"],[19,1,"さか"],[23,1,"さ"],[38,2,"よみ"],[41,1,"もん"],[43,1,"と"],[51,1,"のこ"],[54,1,"とし"],[56,1,"うしな"]],"text":"わたしは言った、わたしはわが一生のまっ盛りに、去らなければならない。わたしは陰府の門に閉ざされて、わが残りの年を失わなければならない。"},{"ref":"Isa.38.11","start":23038011,"end":23038011,"break":"line","breaks":[[20,"line"],[29,"line"]],"ruby":[[4,1,"い"],[12,1,"い"],[15,1,"もの"],[17,1,"ち"],[20,1,"しゅ"],[22,1,"み"],[29,1,"よ"],[33,2,"ひとびと"],[40,1,"ふたた"],[42,1,"ひと"],[44,1,"み"]],"text":"わたしは言った、わたしは生ける者の地で、主を見ることなく、世におる人々のうちに、再び人を見ることがない。"},{"ref":"Isa.38.12","start":23038012,"end":23038012,"break":"line","breaks":[[12,"line"],[29,"line"],[49,"line"],[63,"line"]],"ruby":[[6,1,"ぬ"],[8,1,"さ"],[12,2,"ひつじかい"],[15,2,"てんまく"],[25,1,"はな"],[36,1,"いのち"],[38,1,"はた"],[39,1,"お"],[45,1,"ま"],[49,1,"かれ"],[55,1,"はた"],[58,1,"き"],[60,1,"はな"],[67,1,"あさ"],[70,1,"ゆう"],[74,1,"あいだ"],[81,1,"ほろ"]],"text":"わがすまいは抜き去られて羊飼の天幕のようにわたしを離れる。わたしは、わが命を機織りのように巻いた。彼はわたしを機から切り離す。あなたは朝から夕までの間に、わたしを滅ぼされる。"},{"ref":"Isa.38.13","start":23038013,"end":23038013,"break":"line","breaks":[[11,"line"],[33,"line"]],"ruby":[[4,1,"あさ"],[7,1,"さけ"],[11,1,"しゅ"],[21,1,"ほね"],[28,1,"くだ"],[37,1,"あさ"],[40,1,"ゆう"],[44,1,"あいだ"],[51,1,"ほろ"]],"text":"わたしは朝まで叫んだ。主はししのようにわが骨をことごとく砕かれる。あなたは朝から夕までの間に、わたしを滅ぼされる。"},{"ref":"Isa.38.14","start":23038014,"end":23038014,"break":"line","breaks":[[22,"line"],[32,"line"],[44,"line"],[63,"line"]],"ruby":[[19,1,"な"],[34,1,"め"],[36,1,"うえ"],[38,1,"み"],[40,1,"おとろ"],[44,1,"しゅ"],[71,3,"ほしょうにん"]],"text":"わたしは、つばめのように、つるのように鳴き、はとのようにうめき、わが目は上を見て衰える。主よ、わたしは、しえたげられています。どうか、わたしの保証人となってください。"},{"ref":"Isa.38.15","start":23038015,"end":23038015,"break":"line","breaks":[[22,"line"],[32,"line"],[50,"line"],[62,"line"]],"ruby":[[8,1,"なに"],[10,1,"い"],[22,1,"しゅ"],[28,1,"い"],[35,1,"みずか"],[52,1,"たましい"],[54,1,"くる"],[64,1,"ねむ"],[72,1,"に"],[74,1,"さ"]],"text":"しかし、わたしは何を言うことができましょう。主はわたしに言われ、かつ、自らそれをなされたからである。わが魂の苦しみによって、わが眠りはことごとく逃げ去った。"},{"ref":"Isa.38.16","start":23038016,"end":23038016,"break":"line","breaks":[[18,"line"],[36,"line"],[48,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"こと"],[12,1,"ひと"],[14,1,"い"],[20,1,"れい"],[22,1,"いのち"],[31,1,"こと"],[52,1,"い"]],"text":"主よ、これらの事によって人は生きる。わが霊の命もすべてこれらの事による。どうか、わたしをいやし、わたしを生かしてください。"},{"ref":"Isa.38.17","start":23038017,"end":23038017,"break":"line","breaks":[[21,"line"],[33,"line"],[47,"line"],[62,"line"],[80,"line"]],"ruby":[[0,1,"み"],[7,1,"おお"],[11,1,"くる"],[23,2,"こうふく"],[39,1,"いのち"],[41,1,"ひ"],[47,1,"ほろ"],[50,1,"あな"],[72,1,"つみ"],[84,1,"のち"],[86,1,"す"]],"text":"見よ、わたしが大いなる苦しみにあったのは、わが幸福のためであった。あなたはわが命を引きとめて、滅びの穴をまぬかれさせられた。これは、あなたがわが罪をことごとく、あなたの後に捨てられたからである。"},{"ref":"Isa.38.18","start":23038018,"end":23038018,"break":"line","breaks":[[20,"line"],[39,"line"],[47,"line"]],"ruby":[[0,2,"よみ"],[8,2,"かんしゃ"],[20,1,"し"],[39,1,"はか"],[44,1,"もの"],[55,1,"のぞ"]],"text":"陰府は、あなたに感謝することはできない。死はあなたをさんびすることはできない。墓にくだる者は、あなたのまことを望むことはできない。"},{"ref":"Isa.38.19","start":23038019,"end":23038019,"break":"line","breaks":[[14,"line"],[37,"line"]],"ruby":[[2,1,"い"],[5,1,"もの"],[7,1,"い"],[10,1,"もの"],[32,2,"かんしゃ"],[37,1,"ちち"],[50,1,"こ"],[53,1,"し"]],"text":"ただ生ける者、生ける者のみ、きょう、わたしがするように、あなたに感謝する。父はあなたのまことを、その子らに知らせる。"},{"ref":"Isa.38.20","start":23038020,"end":23038020,"break":"line","breaks":[[11,"line"],[24,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"すく"],[16,1,"よ"],[24,1,"しゅ"],[26,1,"いえ"],[28,1,"こと"],[35,1,"うた"]],"text":"主はわたしを救われる。われわれは世にあるかぎり、主の家で琴にあわせて、歌をうたおう。"},{"ref":"Isa.38.21","start":23038021,"end":23038021,"break":"paragraph","ruby":[[4,1,"い"],[9,1,"ひ"],[22,1,"も"],[32,2,"はれもの"],[46,1,"なお"]],"text":"イザヤは言った、「干いちじくのひとかたまりを持ってこさせ、それを腫物につけなさい。そうすれば直るでしょう」。"},{"ref":"Isa.38.22","start":23038022,"end":23038022,"break":"none","ruby":[[7,1,"い"],[16,1,"しゅ"],[18,1,"いえ"],[20,1,"のぼ"]],"text":"ヒゼキヤはまた言った、「わたしが主の家に上ることについて、どんなしるしがありましょうか」。"}]