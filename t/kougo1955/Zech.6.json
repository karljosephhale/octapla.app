[{"ref":"Zech.6.1","start":38006001,"end":38006001,"break":"paragraph","ruby":[[6,1,"め"],[11,1,"み"],[18,1,"りょう"],[20,2,"せんしゃ"],[26,1,"やま"],[28,1,"あいだ"],[31,1,"で"],[38,1,"やま"],[40,2,"せいどう"],[43,1,"やま"]],"text":"わたしがまた目をあげて見ていると、四両の戦車が二つの山の間から出てきた。その山は青銅の山であった。"},{"ref":"Zech.6.2","start":38006002,"end":38006002,"break":"none","ruby":[[0,1,"だい"],[3,2,"せんしゃ"],[7,1,"あか"],[8,1,"うま"],[10,1,"つ"],[13,1,"だい"],[16,2,"せんしゃ"],[20,1,"くろ"],[21,1,"うま"],[23,1,"つ"]],"text":"第一の戦車には赤馬を着け、第二の戦車には黒馬を着け、"},{"ref":"Zech.6.3","start":38006003,"end":38006003,"break":"none","ruby":[[0,1,"だい"],[3,2,"せんしゃ"],[7,2,"しろうま"],[10,1,"つ"],[13,1,"だい"],[16,2,"せんしゃ"],[28,1,"いろ"],[30,1,"うま"],[32,1,"つ"]],"text":"第三の戦車には白馬を着け、第四の戦車には、まだらのねずみ色の馬を着けていた。"},{"ref":"Zech.6.4","start":38006004,"end":38006004,"break":"none","ruby":[[9,1,"かた"],[12,1,"つかい"],[14,1,"たず"],[21,1,"しゅ"]],"text":"わたしは、わたしと語るみ使に尋ねた、「わが主よ、これらはなんですか」。"},{"ref":"Zech.6.5","start":38006005,"end":38006005,"break":"none","ruby":[[0,1,"てん"],[2,1,"つかい"],[4,1,"こた"],[12,1,"い"],[21,1,"ぜん"],[22,1,"ち"],[24,1,"しゅ"],[26,1,"まえ"],[28,1,"あらわ"],[31,1,"のち"],[33,1,"てん"],[35,2,"しほう"],[38,1,"で"],[40,1,"い"]],"text":"天の使は答えて、わたしに言った、「これらは全地の主の前に現れて後、天の四方に出て行くものです。"},{"ref":"Zech.6.6","start":38006006,"end":38006006,"break":"none","ruby":[[0,1,"くろ"],[1,1,"うま"],[3,1,"つ"],[6,2,"せんしゃ"],[10,1,"きた"],[12,1,"くに"],[17,1,"で"],[19,1,"い"],[22,2,"しろうま"],[25,1,"にし"],[27,1,"くに"],[32,1,"で"],[34,1,"い"],[41,1,"うま"],[43,1,"みなみ"],[45,1,"くに"],[50,1,"で"],[52,1,"い"]],"text":"黒馬を着けた戦車は、北の国をさして出て行き、白馬は西の国をさして出て行き、まだらの馬は南の国をさして出て行くのです」。"},{"ref":"Zech.6.7","start":38006007,"end":38006007,"break":"none","ruby":[[0,1,"うま"],[2,1,"で"],[8,1,"かれ"],[12,1,"ち"],[29,1,"で"],[42,1,"かれ"],[45,1,"い"],[49,1,"ち"],[60,1,"い"],[64,1,"かれ"],[67,1,"ち"],[69,1,"い"]],"text":"馬が出てくると、彼らは、地をあまねくめぐるために、しきりに出たがるのであった。それで彼が「行って、地をあまねくめぐれ」と言うと、彼らは地を行きめぐった。"},{"ref":"Zech.6.8","start":38006008,"end":38006008,"break":"none","ruby":[[3,1,"かれ"],[9,1,"よ"],[14,1,"きた"],[16,1,"くに"],[21,1,"い"],[23,1,"もの"],[28,1,"きた"],[30,1,"くに"],[36,1,"こころ"],[38,1,"しず"],[48,1,"い"]],"text":"すると彼はわたしを呼んで、「北の国をさして行く者どもは、北の国でわたしの心を静まらせてくれた」と言った。"},{"ref":"Zech.6.9","start":38006009,"end":38006009,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"]],"text":"主の言葉がまたわたしに臨んだ、"},{"ref":"Zech.6.10","start":38006010,"end":38006010,"break":"none","ruby":[[7,1,"かえ"],[14,2,"ほしゅう"],[17,1,"なか"],[36,1,"つ"],[42,1,"ひ"],[49,1,"こ"],[54,1,"いえ"],[56,1,"い"]],"text":"「バビロンから帰ってきたかの捕囚の中から、ヘルダイ、トビヤおよびエダヤを連れて、その日にゼパニヤの子ヨシヤの家に行き、"},{"ref":"Zech.6.11","start":38006011,"end":38006011,"break":"none","ruby":[[0,1,"かれ"],[4,2,"きんぎん"],[7,1,"う"],[9,1,"と"],[16,1,"かんむり"],[18,1,"つく"],[29,1,"こ"],[33,1,"だい"],[34,2,"さいし"],[41,1,"あたま"]],"text":"彼らから金銀を受け取って、一つの冠を造り、それをヨザダクの子である大祭司ヨシュアの頭にかぶらせて、"},{"ref":"Zech.6.12","start":38006012,"end":38006012,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[9,2,"ばんぐん"],[12,1,"しゅ"],[17,1,"おお"],[23,1,"み"],[28,1,"な"],[30,1,"えだ"],[34,1,"ひと"],[39,1,"かれ"],[41,2,"じぶん"],[44,2,"ばしょ"],[47,2,"せいちょう"],[52,1,"しゅ"],[54,1,"みや"],[56,1,"た"]],"text":"彼に言いなさい、『万軍の主は、こう仰せられる、見よ、その名を枝という人がある。彼は自分の場所で成長して、主の宮を建てる。"},{"ref":"Zech.6.13","start":38006013,"end":38006013,"break":"none","ruby":[[4,1,"かれ"],[6,1,"しゅ"],[8,1,"みや"],[10,1,"た"],[13,1,"おう"],[18,2,"こうえい"],[21,1,"お"],[26,1,"くらい"],[28,1,"ざ"],[31,1,"おさ"],[37,1,"くらい"],[49,2,"さいし"],[61,1,"あいだ"],[63,2,"へいわ"],[66,2,"いっち"]],"text":"すなわち彼は主の宮を建て、王としての光栄を帯び、その位に座して治める。その位のかたわらに、ひとりの祭司がいて、このふたりの間に平和の一致がある』。"},{"ref":"Zech.6.14","start":38006014,"end":38006014,"break":"none","ruby":[[4,1,"かんむり"],[26,1,"こ"],[31,2,"きねん"],[37,1,"しゅ"],[39,1,"みや"],[41,1,"おさ"]],"text":"またその冠はヘルダイ、トビヤ、エダヤおよびゼパニヤの子ヨシヤの記念として、主の宮に納められる。"},{"ref":"Zech.6.15","start":38006015,"end":38006015,"break":"paragraph","ruby":[[2,1,"とお"],[4,1,"ところ"],[6,1,"もの"],[10,1,"き"],[13,1,"しゅ"],[15,1,"みや"],[17,1,"た"],[23,1,"たす"],[36,2,"ばんぐん"],[39,1,"しゅ"],[55,1,"し"],[71,1,"はげ"],[81,1,"かみ"],[83,1,"しゅ"],[85,1,"こえ"],[87,1,"き"],[89,1,"したが"]],"text":"また遠い所の者どもが来て、主の宮を建てることを助ける。そしてあなたがたは万軍の主が、わたしをつかわされたことを知るようになる。あなたがたがもし励んで、あなたがたの神、主の声に聞き従うならば、このようになる」。"}]