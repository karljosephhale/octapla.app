[{"ref":"Mark.12.1","start":41012001,"end":41012001,"break":"paragraph","ruby":[[7,1,"たとえ"],[9,1,"かれ"],[12,1,"かた"],[14,1,"だ"],[22,1,"ひと"],[27,1,"えん"],[29,1,"つく"],[32,1,"かき"],[41,1,"さか"],[45,1,"あな"],[47,1,"ほ"],[54,1,"た"],[60,2,"のうふ"],[65,1,"か"],[69,1,"たび"],[71,1,"で"]],"text":"そこでイエスは譬で彼らに語り出された、「ある人がぶどう園を造り、垣をめぐらし、また酒ぶねの穴を掘り、やぐらを立て、それを農夫たちに貸して、旅に出かけた。"},{"ref":"Mark.12.2","start":41012002,"end":41012002,"break":"none","ruby":[[0,2,"きせつ"],[9,2,"のうふ"],[23,1,"しもべ"],[25,1,"おく"],[32,1,"えん"],[34,2,"しゅうかく"],[37,1,"わ"],[39,1,"まえ"],[41,1,"と"],[43,1,"た"]],"text":"季節になったので、農夫たちのところへ、ひとりの僕を送って、ぶどう園の収穫の分け前を取り立てさせようとした。"},{"ref":"Mark.12.3","start":41012003,"end":41012003,"break":"none","ruby":[[4,1,"かれ"],[9,1,"しもべ"],[17,1,"ふくろ"],[26,1,"て"],[28,1,"かえ"]],"text":"すると、彼らはその僕をつかまえて、袋だたきにし、から手で帰らせた。"},{"ref":"Mark.12.4","start":41012004,"end":41012004,"break":"none","ruby":[[2,1,"た"],[4,1,"しもべ"],[6,1,"おく"],[13,1,"あたま"],[19,2,"ぶじょく"]],"text":"また他の僕を送ったが、その頭をなぐって侮辱した。"},{"ref":"Mark.12.5","start":41012005,"end":41012005,"break":"none","ruby":[[5,1,"た"],[7,1,"もの"],[9,1,"おく"],[14,2,"こんど"],[20,1,"ころ"],[35,1,"おお"],[39,1,"もの"],[41,1,"おく"],[46,1,"かれ"],[49,1,"う"],[54,1,"ころ"]],"text":"そこでまた他の者を送ったが、今度はそれを殺してしまった。そのほか、なお大ぜいの者を送ったが、彼らを打ったり、殺したりした。"},{"ref":"Mark.12.6","start":41012006,"end":41012006,"break":"none","ruby":[[10,1,"もの"],[18,1,"かれ"],[20,2,"あいし"],[27,2,"じぶん"],[30,1,"こ"],[32,1,"うやま"],[42,1,"おも"],[46,2,"さいご"],[49,1,"かれ"]],"text":"ここに、もうひとりの者がいた。それは彼の愛子であった。自分の子は敬ってくれるだろうと思って、最後に彼をつかわした。"},{"ref":"Mark.12.7","start":41012007,"end":41012007,"break":"none","ruby":[[4,2,"のうふ"],[15,1,"と"],[25,1,"ころ"],[41,2,"ざいさん"],[58,1,"はな"],[60,1,"あ"]],"text":"すると、農夫たちは『あれはあと取りだ。さあ、これを殺してしまおう。そうしたら、その財産はわれわれのものになるのだ』と話し合い、"},{"ref":"Mark.12.8","start":41012008,"end":41012008,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ころ"],[13,1,"えん"],[15,1,"そと"],[17,1,"な"],[19,1,"す"]],"text":"彼をつかまえて殺し、ぶどう園の外に投げ捨てた。"},{"ref":"Mark.12.9","start":41012009,"end":41012009,"break":"none","ruby":[[5,1,"えん"],[7,2,"しゅじん"],[20,1,"かれ"],[22,1,"で"],[27,2,"のうふ"],[32,1,"ころ"],[38,1,"えん"],[40,1,"た"],[42,2,"ひとびと"],[45,1,"あた"]],"text":"このぶどう園の主人は、どうするだろうか。彼は出てきて、農夫たちを殺し、ぶどう園を他の人々に与えるであろう。"},{"ref":"Mark.12.10","start":41012010,"end":41012010,"break":"none","breaks":[[25,"stanza"],[36,"line"]],"ruby":[[9,2,"せいしょ"],[12,1,"く"],[14,1,"よ"],[26,1,"いえ"],[27,1,"つく"],[31,1,"す"],[34,1,"いし"],[36,1,"すみ"],[41,1,"いし"]],"text":"あなたがたは、この聖書の句を読んだことがないのか。『家造りらの捨てた石が隅のかしら石になった。"},{"ref":"Mark.12.11","start":41012011,"end":41012011,"break":"line","breaks":[[13,"line"]],"ruby":[[3,1,"しゅ"],[19,1,"め"],[22,3,"ふしぎ"],[26,1,"み"]],"text":"これは主がなされたことで、わたしたちの目には不思議に見える』」。"},{"ref":"Mark.12.12","start":41012012,"end":41012012,"break":"none","ruby":[[0,1,"かれ"],[6,1,"たとえ"],[9,2,"じぶん"],[14,1,"あ"],[17,1,"かた"],[24,1,"さと"],[34,1,"とら"],[43,2,"ぐんしゅう"],[46,1,"おそ"],[60,1,"のこ"],[63,1,"た"],[65,1,"さ"]],"text":"彼らはいまの譬が、自分たちに当てて語られたことを悟ったので、イエスを捕えようとしたが、群衆を恐れた。そしてイエスをそこに残して立ち去った。"},{"ref":"Mark.12.13","start":41012013,"end":41012013,"break":"paragraph","ruby":[[3,2,"ひとびと"],[10,1,"びと"],[15,1,"とう"],[17,1,"もの"],[19,2,"すうにん"],[37,2,"ことば"],[42,1,"とら"]],"text":"さて、人々はパリサイ人やヘロデ党の者を数人、イエスのもとにつかわして、その言葉じりを捕えようとした。"},{"ref":"Mark.12.14","start":41012014,"end":41012014,"break":"none","ruby":[[0,1,"かれ"],[9,1,"い"],[14,2,"せんせい"],[27,2,"しんじつ"],[49,1,"し"],[60,1,"ひと"],[62,1,"わ"],[64,1,"へだ"],[74,2,"しんり"],[77,1,"もとづ"],[80,1,"かみ"],[82,1,"みち"],[84,1,"おし"],[104,2,"ぜいきん"],[107,1,"おさ"],[128,1,"おさ"],[139,1,"おさ"]],"text":"彼らはきてイエスに言った、「先生、わたしたちはあなたが真実なかたで、だれをも、はばかられないことを知っています。あなたは人に分け隔てをなさらないで、真理に基いて神の道を教えてくださいます。ところで、カイザルに税金を納めてよいでしょうか、いけないでしょうか。納めるべきでしょうか、納めてはならないのでしょうか」。"},{"ref":"Mark.12.15","start":41012015,"end":41012015,"break":"none","ruby":[[4,1,"かれ"],[7,2,"ぎぜん"],[10,2,"みぬ"],[14,1,"い"],[40,1,"も"],[45,1,"み"]],"text":"イエスは彼らの偽善を見抜いて言われた、「なぜわたしをためそうとするのか。デナリを持ってきて見せなさい」。"},{"ref":"Mark.12.16","start":41012016,"end":41012016,"break":"none","ruby":[[0,1,"かれ"],[6,1,"も"],[19,1,"い"],[32,2,"しょうぞう"],[38,2,"きごう"],[43,1,"かれ"],[56,1,"こた"]],"text":"彼らはそれを持ってきた。そこでイエスは言われた、「これは、だれの肖像、だれの記号か」。彼らは「カイザルのです」と答えた。"},{"ref":"Mark.12.17","start":41012017,"end":41012017,"break":"none","ruby":[[7,1,"い"],[27,1,"かみ"],[32,1,"かみ"],[34,1,"かえ"],[41,1,"かれ"],[48,2,"きょうたん"]],"text":"するとイエスは言われた、「カイザルのものはカイザルに、神のものは神に返しなさい」。彼らはイエスに驚嘆した。"},{"ref":"Mark.12.18","start":41012018,"end":41012018,"break":"paragraph","ruby":[[0,2,"ふっかつ"],[11,2,"しゅちょう"],[21,1,"びと"],[35,2,"しつもん"]],"text":"復活ということはないと主張していたサドカイ人たちが、イエスのもとにきて質問した、"},{"ref":"Mark.12.19","start":41012019,"end":41012019,"break":"none","ruby":[[1,2,"せんせい"],[20,1,"か"],[33,1,"ひと"],[35,1,"あに"],[37,1,"し"],[43,1,"のこ"],[47,1,"つま"],[50,1,"こ"],[54,2,"ばあい"],[59,1,"おとうと"],[63,1,"おんな"],[70,1,"あに"],[75,1,"こ"]],"text":"「先生、モーセは、わたしたちのためにこう書いています、『もし、ある人の兄が死んで、その残された妻に、子がない場合には、弟はこの女をめとって、兄のために子をもうけねばならない』。"},{"ref":"Mark.12.20","start":41012020,"end":41012020,"break":"none","ruby":[[5,1,"にん"],[7,2,"きょうだい"],[15,2,"ちょうなん"],[18,1,"つま"],[28,1,"こ"],[33,1,"し"]],"text":"ここに、七人の兄弟がいました。長男は妻をめとりましたが、子がなくて死に、"},{"ref":"Mark.12.21","start":41012021,"end":41012021,"break":"none","ruby":[[0,2,"じなん"],[5,1,"おんな"],[14,1,"こ"],[21,1,"し"],[24,2,"さんなん"],[27,2,"どうよう"]],"text":"次男がその女をめとって、また子をもうけずに死に、三男も同様でした。"},{"ref":"Mark.12.22","start":41012022,"end":41012022,"break":"none","ruby":[[6,1,"にん"],[11,2,"しそん"],[14,1,"のこ"],[23,2,"さいご"],[28,1,"おんな"],[30,1,"し"]],"text":"こうして、七人ともみな子孫を残しませんでした。最後にその女も死にました。"},{"ref":"Mark.12.23","start":41012023,"end":41012023,"break":"none","ruby":[[0,2,"ふっかつ"],[6,1,"かれ"],[9,1,"みな"],[16,2,"ばあい"],[21,1,"おんな"],[26,1,"つま"],[36,1,"にん"],[39,2,"かのじょ"],[42,1,"つま"]],"text":"復活のとき、彼らが皆よみがえった場合、この女はだれの妻なのでしょうか。七人とも彼女を妻にしたのですが」。"},{"ref":"Mark.12.24","start":41012024,"end":41012024,"break":"none","ruby":[[4,1,"い"],[19,1,"おも"],[21,1,"ちが"],[31,2,"せいしょ"],[34,1,"かみ"],[36,1,"ちから"],[38,1,"し"]],"text":"イエスは言われた、「あなたがたがそんな思い違いをしているのは、聖書も神の力も知らないからではないか。"},{"ref":"Mark.12.25","start":41012025,"end":41012025,"break":"none","ruby":[[0,1,"かれ"],[3,2,"しにん"],[6,1,"なか"],[38,1,"かれ"],[41,1,"てん"],[45,2,"みつかい"]],"text":"彼らが死人の中からよみがえるときには、めとったり、とついだりすることはない。彼らは天にいる御使のようなものである。"},{"ref":"Mark.12.26","start":41012026,"end":41012026,"break":"none","ruby":[[0,2,"しにん"],[20,1,"しょ"],[22,1,"しば"],[24,1,"へん"],[27,1,"かみ"],[33,1,"おお"],[38,2,"ことば"],[41,1,"よ"],[63,1,"かみ"],[69,1,"かみ"],[75,1,"かみ"]],"text":"死人がよみがえることについては、モーセの書の柴の篇で、神がモーセに仰せられた言葉を読んだことがないのか。『わたしはアブラハムの神、イサクの神、ヤコブの神である』とあるではないか。"},{"ref":"Mark.12.27","start":41012027,"end":41012027,"break":"none","ruby":[[0,1,"かみ"],[2,1,"し"],[5,1,"もの"],[7,1,"かみ"],[13,1,"い"],[18,1,"もの"],[20,1,"かみ"],[31,2,"ひじょう"],[34,1,"おも"],[36,1,"ちが"]],"text":"神は死んだ者の神ではなく、生きている者の神である。あなたがたは非常な思い違いをしている」。"},{"ref":"Mark.12.28","start":41012028,"end":41012028,"break":"paragraph","ruby":[[4,2,"りっぽう"],[6,2,"がくしゃ"],[12,1,"かれ"],[15,1,"たがい"],[17,1,"ろん"],[19,1,"あ"],[26,1,"き"],[35,1,"たく"],[38,1,"こた"],[45,1,"みと"],[53,2,"しつもん"],[68,1,"なか"],[74,1,"だい"]],"text":"ひとりの律法学者がきて、彼らが互に論じ合っているのを聞き、またイエスが巧みに答えられたのを認めて、イエスに質問した、「すべてのいましめの中で、どれが第一のものですか」。"},{"ref":"Mark.12.29","start":41012029,"end":41012029,"break":"none","ruby":[[4,1,"こた"],[11,1,"だい"],[33,1,"き"],[36,1,"しゅ"],[45,1,"かみ"],[54,1,"しゅ"]],"text":"イエスは答えられた、「第一のいましめはこれである、『イスラエルよ、聞け。主なるわたしたちの神は、ただひとりの主である。"},{"ref":"Mark.12.30","start":41012030,"end":41012030,"break":"none","ruby":[[0,1,"こころ"],[6,2,"せいしん"],[13,1,"おも"],[20,1,"ちから"],[27,1,"しゅ"],[34,1,"かみ"],[36,1,"あい"]],"text":"心をつくし、精神をつくし、思いをつくし、力をつくして、主なるあなたの神を愛せよ』。"},{"ref":"Mark.12.31","start":41012031,"end":41012031,"break":"none","ruby":[[0,1,"だい"],[10,2,"じぶん"],[13,1,"あい"],[23,1,"とな"],[25,1,"ひと"],[27,1,"あい"],[36,2,"だいじ"]],"text":"第二はこれである、『自分を愛するようにあなたの隣り人を愛せよ』。これより大事ないましめは、ほかにない」。"},{"ref":"Mark.12.32","start":41012032,"end":41012032,"break":"none","ruby":[[6,2,"りっぽう"],[8,2,"がくしゃ"],[15,1,"い"],[20,2,"せんせい"],[23,1,"おお"],[33,1,"かみ"],[48,1,"かみ"],[54,1,"い"]],"text":"そこで、この律法学者はイエスに言った、「先生、仰せのとおりです、『神はひとりであって、そのほかに神はない』と言われたのは、ほんとうです。"},{"ref":"Mark.12.33","start":41012033,"end":41012033,"break":"none","ruby":[[3,1,"こころ"],[9,2,"ちえ"],[16,1,"ちから"],[22,1,"かみ"],[24,1,"あい"],[29,2,"じぶん"],[32,1,"あい"],[38,1,"とな"],[40,1,"ひと"],[42,1,"あい"],[57,2,"はんさい"],[60,2,"ぎせい"],[70,2,"だいじ"]],"text":"また『心をつくし、知恵をつくし、力をつくして神を愛し、また自分を愛するように隣り人を愛する』ということは、すべての燔祭や犠牲よりも、はるかに大事なことです」。"},{"ref":"Mark.12.34","start":41012034,"end":41012034,"break":"none","ruby":[[5,1,"かれ"],[7,2,"てきせつ"],[10,1,"こたえ"],[16,1,"み"],[18,1,"い"],[28,1,"かみ"],[30,1,"くに"],[33,1,"とお"],[43,1,"のち"],[53,1,"と"],[55,1,"もの"]],"text":"イエスは、彼が適切な答をしたのを見て言われた、「あなたは神の国から遠くない」。それから後は、イエスにあえて問う者はなかった。"},{"ref":"Mark.12.35","start":41012035,"end":41012035,"break":"paragraph","ruby":[[4,1,"みや"],[6,1,"おし"],[18,1,"い"],[24,2,"りっぽう"],[26,2,"がくしゃ"],[45,1,"こ"],[48,1,"い"]],"text":"イエスが宮で教えておられたとき、こう言われた、「律法学者たちは、どうしてキリストをダビデの子だと言うのか。"},{"ref":"Mark.12.36","start":41012036,"end":41012036,"break":"none","breaks":[[16,"stanza"],[30,"line"],[52,"line"]],"ruby":[[3,2,"じしん"],[6,2,"せいれい"],[9,1,"かん"],[12,1,"い"],[17,1,"しゅ"],[21,1,"しゅ"],[23,1,"おお"],[34,1,"てき"],[40,1,"あし"],[44,1,"お"],[56,1,"みぎ"],[58,1,"ざ"]],"text":"ダビデ自身が聖霊に感じて言った、『主はわが主に仰せになった、あなたの敵をあなたの足もとに置くときまでは、わたしの右に座していなさい』。"},{"ref":"Mark.12.37","start":41012037,"end":41012037,"break":"none","breaks":[[51,"paragraph"]],"ruby":[[9,2,"じしん"],[17,1,"しゅ"],[19,1,"よ"],[43,1,"こ"],[51,1,"おお"],[55,2,"ぐんしゅう"],[59,1,"よろこ"],[66,1,"みみ"],[68,1,"かたむ"]],"text":"このように、ダビデ自身がキリストを主と呼んでいる。それなら、どうしてキリストはダビデの子であろうか」。大ぜいの群衆は、喜んでイエスに耳を傾けていた。"},{"ref":"Mark.12.38","start":41012038,"end":41012038,"break":"none","ruby":[[6,1,"おしえ"],[8,1,"なか"],[10,1,"い"],[16,2,"りっぽう"],[18,2,"がくしゃ"],[21,1,"き"],[29,1,"かれ"],[32,1,"なが"],[34,1,"ころも"],[36,1,"き"],[38,1,"ある"],[44,2,"ひろば"]],"text":"イエスはその教の中で言われた、「律法学者に気をつけなさい。彼らは長い衣を着て歩くことや、広場であいさつされることや、"},{"ref":"Mark.12.39","start":41012039,"end":41012039,"break":"none","ruby":[[2,2,"かいどう"],[5,2,"じょうせき"],[8,2,"えんかい"],[11,2,"かみざ"],[14,1,"この"]],"text":"また会堂の上席、宴会の上座を好んでいる。"},{"ref":"Mark.12.40","start":41012040,"end":41012040,"break":"none","ruby":[[9,1,"いえ"],[11,1,"く"],[13,1,"たお"],[16,1,"み"],[22,1,"なが"],[24,1,"いのり"],[29,1,"かれ"],[43,1,"う"]],"text":"また、やもめたちの家を食い倒し、見えのために長い祈をする。彼らはもっときびしいさばきを受けるであろう」。"},{"ref":"Mark.12.41","start":41012041,"end":41012041,"break":"paragraph","ruby":[[9,1,"はこ"],[19,2,"ぐんしゅう"],[24,1,"はこ"],[26,1,"かね"],[28,1,"な"],[30,1,"い"],[33,2,"ようす"],[36,1,"み"],[43,1,"おお"],[46,2,"かねもち"],[55,1,"かね"],[57,1,"な"],[59,1,"い"]],"text":"イエスは、さいせん箱にむかってすわり、群衆がその箱に金を投げ入れる様子を見ておられた。多くの金持は、たくさんの金を投げ入れていた。"},{"ref":"Mark.12.42","start":41012042,"end":41012042,"break":"none","ruby":[[9,1,"まず"],[25,1,"い"],[39,1,"あた"]],"text":"ところが、ひとりの貧しいやもめがきて、レプタ二つを入れた。それは一コドラントに当る。"},{"ref":"Mark.12.43","start":41012043,"end":41012043,"break":"none","ruby":[[8,2,"でし"],[13,1,"よ"],[15,1,"よ"],[18,1,"い"],[26,1,"き"],[34,1,"まず"],[46,1,"はこ"],[48,1,"な"],[50,1,"い"],[55,1,"ひと"],[59,1,"なか"],[71,1,"い"]],"text":"そこで、イエスは弟子たちを呼び寄せて言われた、「よく聞きなさい。あの貧しいやもめは、さいせん箱に投げ入れている人たちの中で、だれよりもたくさん入れたのだ。"},{"ref":"Mark.12.44","start":41012044,"end":41012044,"break":"none","ruby":[[4,1,"もの"],[11,1,"なか"],[14,1,"な"],[16,1,"い"],[23,2,"ふじん"],[28,1,"とぼ"],[31,1,"なか"],[39,1,"も"],[41,1,"もの"],[45,2,"せいかつ"],[47,1,"ひ"],[48,2,"ぜんぶ"],[51,1,"い"]],"text":"みんなの者はありあまる中から投げ入れたが、あの婦人はその乏しい中から、あらゆる持ち物、その生活費全部を入れたからである」。"}]