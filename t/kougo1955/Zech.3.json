[{"ref":"Zech.3.1","start":38003001,"end":38003001,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,1,"だい"],[5,2,"さいし"],[13,1,"しゅ"],[15,1,"つかい"],[17,1,"まえ"],[19,1,"た"],[28,1,"みぎ"],[30,1,"た"],[37,1,"うった"],[48,1,"しめ"]],"text":"時に主は大祭司ヨシュアが、主の使の前に立ち、サタンがその右に立って、これを訴えているのをわたしに示された。"},{"ref":"Zech.3.2","start":38003002,"end":38003002,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[17,1,"しゅ"],[23,1,"せ"],[39,1,"えら"],[42,1,"しゅ"],[48,1,"せ"],[57,1,"ひ"],[59,1,"なか"],[62,1,"と"],[64,1,"だ"],[67,1,"も"]],"text":"主はサタンに言われた、「サタンよ、主はあなたを責めるのだ。すなわちエルサレムを選んだ主はあなたを責めるのだ。これは火の中から取り出した燃えさしではないか」。"},{"ref":"Zech.3.3","start":38003003,"end":38003003,"break":"none","ruby":[[5,1,"けが"],[8,1,"ころも"],[10,1,"き"],[14,1,"つかい"],[16,1,"まえ"],[18,1,"た"]],"text":"ヨシュアは汚れた衣を着て、み使の前に立っていたが、"},{"ref":"Zech.3.4","start":38003004,"end":38003004,"break":"none","ruby":[[1,1,"つかい"],[3,2,"じぶん"],[6,1,"まえ"],[8,1,"た"],[13,1,"もの"],[17,1,"い"],[22,1,"かれ"],[24,1,"けが"],[27,1,"ころも"],[29,1,"ぬ"],[44,1,"む"],[48,1,"い"],[53,1,"み"],[64,1,"つみ"],[66,1,"と"],[68,1,"のぞ"],[76,2,"さいふく"],[79,1,"き"]],"text":"み使は自分の前に立っている者どもに言った、「彼の汚れた衣を脱がせなさい」。またヨシュアに向かって言った、「見よ、わたしはあなたの罪を取り除いた。あなたに祭服を着せよう」。"},{"ref":"Zech.3.5","start":38003005,"end":38003005,"break":"none","ruby":[[4,1,"い"],[9,1,"きよ"],[11,2,"ぼうし"],[14,1,"あたま"],[28,1,"きよ"],[30,2,"ぼうし"],[33,1,"あたま"],[40,1,"ころも"],[42,1,"かれ"],[44,1,"き"],[48,1,"しゅ"],[50,1,"つかい"],[57,1,"た"]],"text":"わたしは言った、「清い帽子を頭にかぶらせなさい」。そこで清い帽子を頭にかぶらせ、衣を彼に着せた。主の使はかたわらに立っていた。"},{"ref":"Zech.3.6","start":38003006,"end":38003006,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[10,1,"いまし"],[13,1,"い"]],"text":"主の使は、ヨシュアを戒めて言った、"},{"ref":"Zech.3.7","start":38003007,"end":38003007,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[9,1,"おお"],[26,1,"みち"],[28,1,"あゆ"],[35,1,"つとめ"],[37,1,"まも"],[47,1,"いえ"],[59,1,"にわ"],[61,1,"まも"],[80,1,"た"],[85,1,"もの"],[89,1,"なか"],[91,1,"い"],[93,1,"き"],[99,1,"え"]],"text":"「万軍の主は、こう仰せられる、あなたがもし、わたしの道に歩み、わたしの務を守るならば、わたしの家をつかさどり、わたしの庭を守ることができる。わたしはまた、ここに立っている者どもの中に行き来することを得させる。"},{"ref":"Zech.3.8","start":38003008,"end":38003008,"break":"none","ruby":[[0,1,"だい"],[1,2,"さいし"],[18,1,"まえ"],[26,2,"どうりょう"],[31,1,"き"],[37,1,"かれ"],[50,2,"ひとびと"],[59,1,"み"],[75,1,"えだ"],[77,1,"しょう"]],"text":"大祭司ヨシュアよ、あなたも、あなたの前にすわっている同僚たちも聞きなさい。彼らはよいしるしとなるべき人々だからである。見よ、わたしはわたしのしもべなる枝を生じさせよう。"},{"ref":"Zech.3.9","start":38003009,"end":38003009,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[10,1,"み"],[18,1,"まえ"],[24,1,"お"],[27,1,"いし"],[29,1,"うえ"],[39,1,"め"],[51,1,"いし"],[53,1,"うえ"],[64,2,"もじ"],[67,2,"ちょうこく"],[81,1,"ち"],[83,1,"つみ"],[87,1,"にち"],[89,1,"うち"],[91,1,"と"],[93,1,"のぞ"]],"text":"万軍の主は言われる、見よ、ヨシュアの前にわたしが置いた石の上に、すなわち七つの目をもっているこの一つの石の上に、わたしはみずから文字を彫刻する。そしてわたしはこの地の罪を、一日の内に取り除く。"},{"ref":"Zech.3.10","start":38003010,"end":38003010,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[12,1,"ひ"],[28,1,"とな"],[30,1,"びと"],[32,1,"まね"],[40,1,"き"],[42,1,"した"],[49,1,"き"],[51,1,"した"],[53,1,"ざ"]],"text":"万軍の主は言われる、その日には、あなたがたはめいめいその隣り人を招いて、ぶどうの木の下、いちじくの木の下に座すのである」。"}]