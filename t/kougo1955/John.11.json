[{"ref":"John.11.1","start":43011001,"end":43011001,"break":"paragraph","ruby":[[7,2,"びょうにん"],[26,2,"しまい"],[32,1,"むら"],[38,1,"ひと"]],"text":"さて、ひとりの病人がいた。ラザロといい、マリヤとその姉妹マルタの村ベタニヤの人であった。"},{"ref":"John.11.2","start":43011002,"end":43011002,"break":"none","ruby":[[6,1,"しゅ"],[8,2,"こうゆ"],[14,2,"じぶん"],[17,1,"かみ"],[19,1,"け"],[22,1,"しゅ"],[24,1,"あし"],[29,1,"おんな"],[35,2,"びょうき"],[44,2,"かのじょ"],[47,2,"きょうだい"]],"text":"このマリヤは主に香油をぬり、自分の髪の毛で、主の足をふいた女であって、病気であったのは、彼女の兄弟ラザロであった。"},{"ref":"John.11.3","start":43011003,"end":43011003,"break":"none","ruby":[[0,2,"しまい"],[5,1,"ひと"],[21,1,"しゅ"],[26,1,"いま"],[32,1,"あい"],[39,1,"もの"],[41,2,"びょうき"],[51,1,"い"]],"text":"姉妹たちは人をイエスのもとにつかわして、「主よ、ただ今、あなたが愛しておられる者が病気をしています」と言わせた。"},{"ref":"John.11.4","start":43011004,"end":43011004,"break":"none","ruby":[[7,1,"き"],[10,1,"い"],[18,2,"びょうき"],[21,1,"し"],[36,1,"かみ"],[38,2,"えいこう"],[47,1,"かみ"],[49,1,"こ"],[57,2,"えいこう"],[60,1,"う"]],"text":"イエスはそれを聞いて言われた、「この病気は死ぬほどのものではない。それは神の栄光のため、また、神の子がそれによって栄光を受けるためのものである」。"},{"ref":"John.11.5","start":43011005,"end":43011005,"break":"paragraph","ruby":[[11,2,"しまい"],[19,1,"あい"]],"text":"イエスは、マルタとその姉妹とラザロとを愛しておられた。"},{"ref":"John.11.6","start":43011006,"end":43011006,"break":"none","ruby":[[4,2,"びょうき"],[12,1,"き"],[30,1,"ところ"],[32,2,"たいざい"]],"text":"ラザロが病気であることを聞いてから、なおふつか、そのおられた所に滞在された。"},{"ref":"John.11.7","start":43011007,"end":43011007,"break":"none","ruby":[[4,2,"でし"],[14,1,"ど"],[19,1,"い"],[24,1,"い"]],"text":"それから弟子たちに、「もう一度ユダヤに行こう」と言われた。"},{"ref":"John.11.8","start":43011008,"end":43011008,"break":"none","ruby":[[0,2,"でし"],[5,1,"い"],[10,2,"せんせい"],[16,1,"じん"],[29,1,"いし"],[31,1,"ころ"],[49,1,"い"]],"text":"弟子たちは言った、「先生、ユダヤ人らが、さきほどもあなたを石で殺そうとしていましたのに、またそこに行かれるのですか」。"},{"ref":"John.11.9","start":43011009,"end":43011009,"break":"none","ruby":[[4,1,"こた"],[12,1,"にち"],[17,2,"じかん"],[27,2,"ひるま"],[34,1,"ひと"],[48,1,"よ"],[50,1,"ひかり"],[52,1,"み"]],"text":"イエスは答えられた、「一日には十二時間あるではないか。昼間あるけば、人はつまずくことはない。この世の光を見ているからである。"},{"ref":"John.11.10","start":43011010,"end":43011010,"break":"none","ruby":[[4,1,"よる"],[17,1,"ひと"],[23,1,"ひかり"]],"text":"しかし、夜あるけば、つまずく。その人のうちに、光がないからである」。"},{"ref":"John.11.11","start":43011011,"end":43011011,"break":"none","ruby":[[2,1,"い"],[15,1,"かれ"],[18,1,"い"],[30,1,"とも"],[35,1,"ねむ"],[45,1,"かれ"],[47,1,"おこ"],[50,1,"い"]],"text":"そう言われたが、それからまた、彼らに言われた、「わたしたちの友ラザロが眠っている。わたしは彼を起しに行く」。"},{"ref":"John.11.12","start":43011012,"end":43011012,"break":"none","ruby":[[3,2,"でし"],[8,1,"い"],[13,1,"しゅ"],[16,1,"ねむ"],[27,1,"たす"]],"text":"すると弟子たちは言った、「主よ、眠っているのでしたら、助かるでしょう」。"},{"ref":"John.11.13","start":43011013,"end":43011013,"break":"none","ruby":[[8,1,"し"],[14,1,"い"],[24,2,"でし"],[30,1,"ねむ"],[33,1,"やす"],[44,1,"い"],[51,1,"おも"]],"text":"イエスはラザロが死んだことを言われたのであるが、弟子たちは、眠って休んでいることをさして言われたのだと思った。"},{"ref":"John.11.14","start":43011014,"end":43011014,"break":"none","ruby":[[14,1,"かれ"],[17,1,"い"],[27,1,"し"]],"text":"するとイエスは、あからさまに彼らに言われた、「ラザロは死んだのだ。"},{"ref":"John.11.15","start":43011015,"end":43011015,"break":"none","ruby":[[32,1,"よろこ"],[45,1,"しん"],[62,1,"かれ"],[68,1,"い"]],"text":"そして、わたしがそこにいあわせなかったことを、あなたがたのために喜ぶ。それは、あなたがたが信じるようになるためである。では、彼のところに行こう」。"},{"ref":"John.11.16","start":43011016,"end":43011016,"break":"none","ruby":[[7,1,"よ"],[18,2,"なかま"],[21,2,"でし"],[26,1,"い"],[37,1,"い"],[41,2,"せんせい"],[44,2,"いっしょ"],[47,1,"し"]],"text":"するとデドモと呼ばれているトマスが、仲間の弟子たちに言った、「わたしたちも行って、先生と一緒に死のうではないか」。"},{"ref":"John.11.17","start":43011017,"end":43011017,"break":"paragraph","ruby":[[7,1,"い"],[26,2,"かかん"],[29,1,"はか"],[31,1,"なか"],[33,1,"お"]],"text":"さて、イエスが行ってごらんになると、ラザロはすでに四日間も墓の中に置かれていた。"},{"ref":"John.11.18","start":43011018,"end":43011018,"break":"none","ruby":[[11,1,"ちか"],[17,1,"ちょう"],[21,1,"はな"]],"text":"ベタニヤはエルサレムに近く、二十五丁ばかり離れたところにあった。"},{"ref":"John.11.19","start":43011019,"end":43011019,"break":"none","ruby":[[0,1,"おお"],[7,1,"じん"],[12,2,"きょうだい"],[28,1,"なぐさ"]],"text":"大ぜいのユダヤ人が、その兄弟のことで、マルタとマリヤとを慰めようとしてきていた。"},{"ref":"John.11.20","start":43011020,"end":43011020,"break":"none","ruby":[[13,1,"き"],[17,2,"でむか"],[21,1,"い"],[30,1,"いえ"]],"text":"マルタはイエスがこられたと聞いて、出迎えに行ったが、マリヤは家ですわっていた。"},{"ref":"John.11.21","start":43011021,"end":43011021,"break":"none","ruby":[[8,1,"い"],[13,1,"しゅ"],[27,1,"くだ"],[38,2,"きょうだい"],[41,1,"し"]],"text":"マルタはイエスに言った、「主よ、もしあなたがここにいて下さったなら、わたしの兄弟は死ななかったでしょう。"},{"ref":"John.11.22","start":43011022,"end":43011022,"break":"none","ruby":[[15,1,"ねが"],[23,1,"かみ"],[29,1,"くだ"],[40,1,"いま"],[43,1,"ぞん"]],"text":"しかし、あなたがどんなことをお願いになっても、神はかなえて下さることを、わたしは今でも存じています」。"},{"ref":"John.11.23","start":43011023,"end":43011023,"break":"none","ruby":[[8,1,"い"],[18,2,"きょうだい"]],"text":"イエスはマルタに言われた、「あなたの兄弟はよみがえるであろう」。"},{"ref":"John.11.24","start":43011024,"end":43011024,"break":"none","ruby":[[4,1,"い"],[9,1,"おわ"],[12,1,"ひ"],[20,1,"とき"],[30,1,"ぞん"]],"text":"マルタは言った、「終りの日のよみがえりの時よみがえることは、存じています」。"},{"ref":"John.11.25","start":43011025,"end":43011025,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"い"],[26,1,"いのち"],[35,1,"しん"],[38,1,"もの"],[44,1,"し"],[48,1,"い"]],"text":"イエスは彼女に言われた、「わたしはよみがえりであり、命である。わたしを信じる者は、たとい死んでも生きる。"},{"ref":"John.11.26","start":43011026,"end":43011026,"break":"none","ruby":[[3,1,"い"],[13,1,"しん"],[16,1,"もの"],[24,1,"し"],[36,1,"しん"]],"text":"また、生きていて、わたしを信じる者は、いつまでも死なない。あなたはこれを信じるか」。"},{"ref":"John.11.27","start":43011027,"end":43011027,"break":"none","ruby":[[8,1,"い"],[13,1,"しゅ"],[16,1,"しん"],[27,1,"よ"],[39,1,"かみ"],[41,2,"みこ"],[47,1,"しん"]],"text":"マルタはイエスに言った、「主よ、信じます。あなたがこの世にきたるべきキリスト、神の御子であると信じております」。"},{"ref":"John.11.28","start":43011028,"end":43011028,"break":"none","ruby":[[6,1,"い"],[12,1,"かえ"],[15,2,"しまい"],[22,1,"よ"],[26,2,"せんせい"],[41,1,"よ"],[51,2,"こごえ"],[54,1,"い"]],"text":"マルタはこう言ってから、帰って姉妹のマリヤを呼び、「先生がおいでになって、あなたを呼んでおられます」と小声で言った。"},{"ref":"John.11.29","start":43011029,"end":43011029,"break":"none","ruby":[[3,1,"き"],[12,1,"た"],[14,1,"あ"],[26,1,"い"]],"text":"これを聞いたマリヤはすぐ立ち上がって、イエスのもとに行った。"},{"ref":"John.11.30","start":43011030,"end":43011030,"break":"none","ruby":[[6,1,"むら"],[23,1,"むか"],[29,2,"ばしょ"]],"text":"イエスはまだ村に、はいってこられず、マルタがお迎えしたその場所におられた。"},{"ref":"John.11.31","start":43011031,"end":43011031,"break":"none","ruby":[[4,2,"いっしょ"],[7,1,"いえ"],[11,2,"かのじょ"],[14,1,"なぐさ"],[22,1,"じん"],[31,1,"いそ"],[34,1,"た"],[36,1,"あ"],[40,1,"で"],[42,1,"い"],[46,1,"み"],[49,2,"かのじょ"],[52,1,"はか"],[54,1,"な"],[57,1,"い"],[65,1,"おも"],[77,1,"い"]],"text":"マリヤと一緒に家にいて彼女を慰めていたユダヤ人たちは、マリヤが急いで立ち上がって出て行くのを見て、彼女は墓に泣きに行くのであろうと思い、そのあとからついて行った。"},{"ref":"John.11.32","start":43011032,"end":43011032,"break":"none","ruby":[[13,1,"ところ"],[15,1,"い"],[19,1,"め"],[27,1,"あし"],[33,1,"ふ"],[36,1,"い"],[41,1,"しゅ"],[55,1,"くだ"],[66,2,"きょうだい"],[69,1,"し"]],"text":"マリヤは、イエスのおられる所に行ってお目にかかり、その足もとにひれ伏して言った、「主よ、もしあなたがここにいて下さったなら、わたしの兄弟は死ななかったでしょう」。"},{"ref":"John.11.33","start":43011033,"end":43011033,"break":"none","ruby":[[5,2,"かのじょ"],[8,1,"な"],[14,2,"かのじょ"],[17,2,"いっしょ"],[25,1,"じん"],[29,1,"な"],[43,1,"はげ"],[46,2,"かんどう"],[52,1,"こころ"],[54,1,"さわ"],[61,1,"い"]],"text":"イエスは、彼女が泣き、また、彼女と一緒にきたユダヤ人たちも泣いているのをごらんになり、激しく感動し、また心を騒がせ、そして言われた、"},{"ref":"John.11.34","start":43011034,"end":43011034,"break":"none","ruby":[[1,1,"かれ"],[6,1,"お"],[13,1,"かれ"],[20,1,"い"],[25,1,"しゅ"],[34,1,"くだ"]],"text":"「彼をどこに置いたのか」。彼らはイエスに言った、「主よ、きて、ごらん下さい」。"},{"ref":"John.11.35","start":43011035,"end":43011035,"break":"none","ruby":[[4,1,"なみだ"],[6,1,"なが"]],"text":"イエスは涙を流された。"},{"ref":"John.11.36","start":43011036,"end":43011036,"break":"none","ruby":[[6,1,"じん"],[10,1,"い"],[21,1,"かれ"],[23,1,"あい"]],"text":"するとユダヤ人たちは言った、「ああ、なんと彼を愛しておられたことか」。"},{"ref":"John.11.37","start":43011037,"end":43011037,"break":"none","ruby":[[4,1,"かれ"],[9,1,"ひと"],[13,1,"い"],[20,2,"もうじん"],[23,1,"め"],[30,1,"ひと"],[38,1,"し"]],"text":"しかし、彼らのある人たちは言った、「あの盲人の目をあけたこの人でも、ラザロを死なせないようには、できなかったのか」。"},{"ref":"John.11.38","start":43011038,"end":43011038,"break":"none","ruby":[[6,1,"はげ"],[9,2,"かんどう"],[14,1,"はか"],[25,2,"ほらあな"],[35,1,"いし"]],"text":"イエスはまた激しく感動して、墓にはいられた。それは洞穴であって、そこに石がはめてあった。"},{"ref":"John.11.39","start":43011039,"end":43011039,"break":"none","ruby":[[4,1,"い"],[10,1,"いし"],[12,1,"と"],[21,1,"し"],[28,2,"しまい"],[34,1,"い"],[39,1,"しゅ"],[44,1,"くさ"],[55,1,"か"]],"text":"イエスは言われた、「石を取りのけなさい」。死んだラザロの姉妹マルタが言った、「主よ、もう臭くなっております。四日もたっていますから」。"},{"ref":"John.11.40","start":43011040,"end":43011040,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"い"],[15,1,"しん"],[20,1,"かみ"],[22,2,"えいこう"],[25,1,"み"],[37,1,"い"]],"text":"イエスは彼女に言われた、「もし信じるなら神の栄光を見るであろうと、あなたに言ったではないか」。"},{"ref":"John.11.41","start":43011041,"end":43011041,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"いし"],[5,1,"と"],[19,1,"め"],[21,1,"てん"],[26,1,"い"],[32,1,"ちち"],[39,1,"ねが"],[43,1,"き"],[45,1,"くだ"],[52,2,"かんしゃ"]],"text":"人々は石を取りのけた。すると、イエスは目を天にむけて言われた、「父よ、わたしの願いをお聞き下さったことを感謝します。"},{"ref":"John.11.42","start":43011042,"end":43011042,"break":"none","ruby":[[12,1,"ねが"],[15,1,"き"],[20,1,"くだ"],[29,1,"し"],[42,1,"もう"],[52,1,"た"],[57,2,"ひとびと"],[79,1,"しん"]],"text":"あなたがいつでもわたしの願いを聞きいれて下さることを、よく知っています。しかし、こう申しますのは、そばに立っている人々に、あなたがわたしをつかわされたことを、信じさせるためであります」。"},{"ref":"John.11.43","start":43011043,"end":43011043,"break":"none","ruby":[[2,1,"い"],[8,2,"おおごえ"],[17,1,"で"],[25,1,"よ"]],"text":"こう言いながら、大声で「ラザロよ、出てきなさい」と呼ばわれた。"},{"ref":"John.11.44","start":43011044,"end":43011044,"break":"none","ruby":[[4,2,"しにん"],[7,2,"てあし"],[10,1,"ぬの"],[16,1,"かお"],[18,1,"かお"],[23,1,"つつ"],[30,1,"で"],[39,2,"ひとびと"],[42,1,"い"],[48,1,"かれ"],[58,1,"かえ"]],"text":"すると、死人は手足を布でまかれ、顔も顔おおいで包まれたまま、出てきた。イエスは人々に言われた、「彼をほどいてやって、帰らせなさい」。"},{"ref":"John.11.45","start":43011045,"end":43011045,"break":"paragraph","ruby":[[22,1,"み"],[24,1,"おお"],[30,1,"じん"],[39,1,"しん"]],"text":"マリヤのところにきて、イエスのなさったことを見た多くのユダヤ人たちは、イエスを信じた。"},{"ref":"John.11.46","start":43011046,"end":43011046,"break":"none","ruby":[[9,2,"すうにん"],[16,1,"びと"],[24,1,"い"],[38,1,"つ"]],"text":"しかし、そのうちの数人がパリサイ人たちのところに行って、イエスのされたことを告げた。"},{"ref":"John.11.47","start":43011047,"end":43011047,"break":"none","ruby":[[4,3,"さいしちょう"],[14,1,"びと"],[20,2,"ぎかい"],[23,2,"しょうしゅう"],[27,1,"い"],[34,1,"ひと"],[36,1,"おお"],[43,1,"おこな"],[52,1,"たがい"],[54,1,"なに"]],"text":"そこで、祭司長たちとパリサイ人たちとは、議会を召集して言った、「この人が多くのしるしを行っているのに、お互は何をしているのだ。"},{"ref":"John.11.48","start":43011048,"end":43011048,"break":"none","ruby":[[17,1,"かれ"],[19,1,"しん"],[39,1,"じん"],[53,2,"とち"],[56,2,"じんみん"],[59,1,"うば"]],"text":"もしこのままにしておけば、みんなが彼を信じるようになるだろう。そのうえ、ローマ人がやってきて、わたしたちの土地も人民も奪ってしまうであろう」。"},{"ref":"John.11.49","start":43011049,"end":43011049,"break":"none","ruby":[[0,1,"かれ"],[13,1,"とし"],[15,3,"だいさいし"],[27,1,"かれ"],[30,1,"い"],[42,1,"なに"]],"text":"彼らのうちのひとりで、その年の大祭司であったカヤパが、彼らに言った、「あなたがたは、何もわかっていないし、"},{"ref":"John.11.50","start":43011050,"end":43011050,"break":"none","ruby":[[4,1,"ひと"],[6,2,"じんみん"],[9,1,"かわ"],[12,1,"し"],[16,3,"ぜんこくみん"],[20,1,"ほろ"],[40,1,"え"],[49,1,"かんが"]],"text":"ひとりの人が人民に代って死んで、全国民が滅びないようになるのがわたしたちにとって得だということを、考えてもいない」。"},{"ref":"John.11.51","start":43011051,"end":43011051,"break":"none","ruby":[[5,1,"かれ"],[7,2,"じぶん"],[11,1,"い"],[20,1,"かれ"],[24,1,"とし"],[26,3,"だいさいし"],[36,2,"よげん"],[46,2,"こくみん"]],"text":"このことは彼が自分から言ったのではない。彼はこの年の大祭司であったので、預言をして、イエスが国民のために、"},{"ref":"John.11.52","start":43011052,"end":43011052,"break":"none","ruby":[[2,2,"こくみん"],[16,2,"さんざい"],[22,1,"かみ"],[24,1,"こ"],[30,1,"あつ"],[37,1,"し"],[49,1,"い"]],"text":"ただ国民のためだけではなく、また散在している神の子らを一つに集めるために、死ぬことになっていると、言ったのである。"},{"ref":"John.11.53","start":43011053,"end":43011053,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ひ"],[12,1,"ころ"],[16,2,"そうだん"]],"text":"彼らはこの日からイエスを殺そうと相談した。"},{"ref":"John.11.54","start":43011054,"end":43011054,"break":"none","ruby":[[12,2,"こうぜん"],[18,1,"じん"],[20,1,"あいだ"],[22,1,"ある"],[31,1,"で"],[34,2,"あらの"],[37,1,"ちか"],[39,2,"ちほう"],[50,1,"まち"],[52,1,"い"],[59,2,"でし"],[64,2,"いっしょ"],[67,2,"たいざい"]],"text":"そのためイエスは、もはや公然とユダヤ人の間を歩かないで、そこを出て、荒野に近い地方のエフライムという町に行かれ、そこに弟子たちと一緒に滞在しておられた。"},{"ref":"John.11.55","start":43011055,"end":43011055,"break":"paragraph","ruby":[[6,1,"じん"],[8,2,"すぎこし"],[11,1,"まつり"],[13,1,"ちか"],[20,1,"おお"],[23,2,"ひとびと"],[26,1,"み"],[36,1,"まつり"],[38,1,"まえ"],[41,2,"ちほう"],[51,1,"のぼ"]],"text":"さて、ユダヤ人の過越の祭が近づいたので、多くの人々は身をきよめるために、祭の前に、地方からエルサレムへ上った。"},{"ref":"John.11.56","start":43011056,"end":43011056,"break":"none","ruby":[[0,2,"ひとびと"],[7,1,"さが"],[9,1,"もと"],[12,1,"みや"],[14,1,"にわ"],[16,1,"た"],[19,1,"たがい"],[21,1,"い"],[34,1,"おも"],[44,1,"まつり"]],"text":"人々はイエスを捜し求め、宮の庭に立って互に言った、「あなたがたはどう思うか。イエスはこの祭にこないのだろうか」。"},{"ref":"John.11.57","start":43011057,"end":43011057,"break":"none","ruby":[[0,3,"さいしちょう"],[10,1,"びと"],[20,1,"とら"],[35,1,"し"],[40,1,"もの"],[45,1,"もう"],[47,1,"で"],[53,2,"しれい"],[56,1,"だ"]],"text":"祭司長たちとパリサイ人たちとは、イエスを捕えようとして、そのいどころを知っている者があれば申し出よ、という指令を出していた。"}]