[{"ref":"1Chr.14.1","start":13014001,"end":13014001,"break":"paragraph","ruby":[[3,1,"おう"],[12,2,"ししゃ"],[20,1,"かれ"],[25,1,"いえ"],[27,1,"た"],[34,2,"こうはく"],[39,2,"いしく"],[42,2,"もっこう"],[45,1,"おく"]],"text":"ツロの王ヒラムはダビデに使者をつかわし、彼のために家を建てさせようと香柏および石工と木工を送った。"},{"ref":"1Chr.14.2","start":13014002,"end":13014002,"break":"none","ruby":[[4,1,"しゅ"],[6,2,"じぶん"],[9,1,"かた"],[11,1,"た"],[20,1,"おう"],[31,1,"たみ"],[41,1,"かれ"],[43,1,"くに"],[45,1,"おお"],[48,1,"おこ"],[55,1,"さと"]],"text":"ダビデは主が自分を堅く立ててイスラエルの王とされたことと、その民イスラエルのために彼の国を大いに興されたことを悟った。"},{"ref":"1Chr.14.3","start":13014003,"end":13014003,"break":"paragraph","ruby":[[12,1,"つま"],[34,1,"むすめ"],[36,1,"うま"]],"text":"ダビデはエルサレムでまた妻たちをめとった。そしてダビデにまたむすこ、娘が生れた。"},{"ref":"1Chr.14.4","start":13014004,"end":13014004,"break":"none","ruby":[[0,1,"かれ"],[8,1,"え"],[10,1,"こ"],[14,1,"な"],[16,1,"つぎ"]],"text":"彼がエルサレムで得た子たちの名は次のとおりである。すなわちシャンマ、ショバブ、、ナタン、ソロモン、"},{"ref":"1Chr.14.5","start":13014005,"end":13014005,"break":"none","text":"イブハル、エリシュア、エルペレテ、"},{"ref":"1Chr.14.6","start":13014006,"end":13014006,"break":"none","text":"ノガ、ネペグ、ヤピア、"},{"ref":"1Chr.14.7","start":13014007,"end":13014007,"break":"none","text":"エリシャマ、ベエリアダ、エリペレテである。"},{"ref":"1Chr.14.8","start":13014008,"end":13014008,"break":"paragraph","ruby":[[13,1,"あぶら"],[15,1,"そそ"],[19,1,"ぜん"],[26,1,"おう"],[34,1,"き"],[49,1,"のぼ"],[58,1,"さが"],[69,1,"き"],[75,1,"あた"],[79,1,"で"]],"text":"さてペリシテびとはダビデが油を注がれて全イスラエルの王になったことを聞いたので、ペリシテびとはみな上ってきてダビデを捜した。ダビデはこれを聞いてこれに当ろうと出ていったが、"},{"ref":"1Chr.14.9","start":13014009,"end":13014009,"break":"none","ruby":[[10,1,"き"],[18,1,"たに"],[20,1,"おか"]],"text":"ペリシテびとはすでに来て、レパイムの谷を侵した。"},{"ref":"1Chr.14.10","start":13014010,"end":13014010,"break":"none","ruby":[[4,1,"かみ"],[6,1,"と"],[9,1,"い"],[21,1,"む"],[25,1,"のぼ"],[39,1,"かれ"],[46,1,"て"],[60,1,"しゅ"],[66,1,"い"],[72,1,"のぼ"],[82,1,"かれ"],[89,1,"て"]],"text":"ダビデは神に問うて言った、「ペリシテびとに向かって上るべきでしょうか。あなたは彼らをわたしの手にわたされるでしょうか」。主はダビデに言われた、「上りなさい。わたしは彼らをあなたの手にわたそう」。"},{"ref":"1Chr.14.11","start":13014011,"end":13014011,"break":"none","ruby":[[3,1,"かれ"],[14,1,"のぼ"],[23,1,"ところ"],[29,1,"かれ"],[32,1,"う"],[34,1,"はい"],[40,1,"い"],[45,1,"かみ"],[47,1,"やぶ"],[49,1,"で"],[51,1,"みず"],[61,1,"て"],[63,1,"てき"],[65,1,"やぶ"],[78,1,"ところ"],[80,1,"な"],[91,1,"よ"]],"text":"そこで彼はバアル・ペラジムへ上っていった。その所でダビデは彼らを打ち敗り、そして言った、「神は破り出る水のように、わたしの手で敵を破られた」。それゆえ、その所の名はバアル・ペラジムと呼ばれている。"},{"ref":"1Chr.14.12","start":13014012,"end":13014012,"break":"none","ruby":[[0,1,"かれ"],[3,2,"じぶん"],[8,1,"かみ"],[13,1,"のこ"],[16,1,"しりぞ"],[26,1,"めい"],[32,1,"ひ"],[34,1,"や"]],"text":"彼らが自分たちの神をそこに残して退いたので、ダビデは命じてこれを火で焼かせた。"},{"ref":"1Chr.14.13","start":13014013,"end":13014013,"break":"paragraph","ruby":[[7,1,"ふたた"],[9,1,"たに"],[11,1,"おか"]],"text":"ペリシテびとは再び谷を侵した。"},{"ref":"1Chr.14.14","start":13014014,"end":13014014,"break":"none","ruby":[[4,1,"ふたた"],[6,1,"かみ"],[8,1,"と"],[13,1,"かみ"],[15,1,"い"],[25,1,"かれ"],[28,1,"お"],[31,1,"のぼ"],[40,2,"とおまわ"],[50,1,"き"],[52,1,"まえ"],[55,1,"かれ"],[58,1,"おそ"]],"text":"ダビデが再び神に問うたので神は言われた、「あなたは彼らを追って上ってはならない。遠回りしてバルサムの木の前から彼らを襲いなさい。"},{"ref":"1Chr.14.15","start":13014015,"end":13014015,"break":"none","ruby":[[5,1,"き"],[7,1,"うえ"],[9,2,"こうしん"],[12,1,"おと"],[14,1,"きこ"],[25,1,"い"],[28,1,"たたか"],[34,1,"かみ"],[40,1,"まえ"],[42,1,"で"],[51,2,"ぐんぜい"],[54,1,"う"]],"text":"バルサムの木の上に行進の音が聞えたならば、あなたは行って戦いなさい。神があなたの前に出てペリシテびとの軍勢を撃たれるからです」。"},{"ref":"1Chr.14.16","start":13014016,"end":13014016,"break":"none","ruby":[[4,1,"かみ"],[6,1,"めい"],[24,2,"ぐんぜい"],[27,1,"う"],[29,1,"やぶ"],[42,1,"およ"]],"text":"ダビデは神が命じられたようにして、ペリシテびとの軍勢を撃ち破り、ギベオンからゲゼルに及んだ。"},{"ref":"1Chr.14.17","start":13014017,"end":13014017,"break":"none","ruby":[[7,1,"な"],[13,2,"くにぐに"],[16,1,"きこ"],[22,1,"しゅ"],[28,1,"くに"],[32,1,"かれ"],[34,1,"おそ"]],"text":"そこでダビデの名はすべての国々に聞えわたり、主はすべての国びとに彼を恐れさせられた。"}]