[{"ref":"John.8.1","start":43008001,"end":43008001,"break":"paragraph","ruby":[[7,1,"やま"],[9,1,"い"]],"text":"イエスはオリブ山に行かれた。"},{"ref":"John.8.2","start":43008002,"end":43008002,"break":"none","ruby":[[0,1,"あさ"],[1,1,"はや"],[5,1,"みや"],[14,2,"ひとびと"],[17,1,"みな"],[22,1,"あつ"],[39,1,"かれ"],[42,1,"おし"]],"text":"朝早くまた宮にはいられると、人々が皆みもとに集まってきたので、イエスはすわって彼らを教えておられた。"},{"ref":"John.8.3","start":43008003,"end":43008003,"break":"none","ruby":[[4,2,"りっぽう"],[6,2,"がくしゃ"],[15,1,"びと"],[20,2,"かんいん"],[27,1,"とき"],[36,1,"おんな"],[46,1,"なか"],[48,1,"た"],[52,1,"うえ"],[58,1,"い"]],"text":"すると、律法学者たちやパリサイ人たちが、姦淫をしている時につかまえられた女をひっぱってきて、中に立たせた上、イエスに言った、"},{"ref":"John.8.4","start":43008004,"end":43008004,"break":"none","ruby":[[1,2,"せんせい"],[6,1,"おんな"],[8,2,"かんいん"],[11,1,"ば"]],"text":"「先生、この女は姦淫の場でつかまえられました。"},{"ref":"John.8.5","start":43008005,"end":43008005,"break":"none","ruby":[[4,2,"りっぽう"],[7,1,"なか"],[14,1,"おんな"],[16,1,"いし"],[18,1,"う"],[20,1,"ころ"],[23,1,"めい"],[36,1,"おも"]],"text":"モーセは律法の中で、こういう女を石で打ち殺せと命じましたが、あなたはどう思いますか」。"},{"ref":"John.8.6","start":43008006,"end":43008006,"break":"none","ruby":[[0,1,"かれ"],[5,1,"い"],[20,1,"うった"],[23,2,"こうじつ"],[26,1,"え"],[43,1,"み"],[50,1,"ゆび"],[52,2,"じめん"],[55,1,"なに"],[57,1,"か"]],"text":"彼らがそう言ったのは、イエスをためして、訴える口実を得るためであった。しかし、イエスは身をかがめて、指で地面に何か書いておられた。"},{"ref":"John.8.7","start":43008007,"end":43008007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"と"],[5,1,"つづ"],[15,1,"み"],[17,1,"おこ"],[20,1,"かれ"],[23,1,"い"],[35,1,"なか"],[37,1,"つみ"],[41,1,"もの"],[48,1,"おんな"],[50,1,"いし"],[52,1,"な"]],"text":"彼らが問い続けるので、イエスは身を起して彼らに言われた、「あなたがたの中で罪のない者が、まずこの女に石を投げつけるがよい」。"},{"ref":"John.8.8","start":43008008,"end":43008008,"break":"none","ruby":[[5,1,"み"],[12,2,"じめん"],[15,1,"もの"],[17,1,"か"]],"text":"そしてまた身をかがめて、地面に物を書きつづけられた。"},{"ref":"John.8.9","start":43008009,"end":43008009,"break":"none","ruby":[[3,1,"き"],[7,1,"かれ"],[10,2,"としより"],[14,1,"はじ"],[24,1,"で"],[26,1,"い"],[42,1,"おんな"],[44,1,"なか"],[50,1,"のこ"]],"text":"これを聞くと、彼らは年寄から始めて、ひとりびとり出て行き、ついに、イエスだけになり、女は中にいたまま残された。"},{"ref":"John.8.10","start":43008010,"end":43008010,"break":"none","ruby":[[7,1,"み"],[9,1,"おこ"],[12,1,"おんな"],[14,1,"い"],[20,1,"おんな"],[38,1,"ばっ"],[41,1,"もの"]],"text":"そこでイエスは身を起して女に言われた、「女よ、みんなはどこにいるか。あなたを罰する者はなかったのか」。"},{"ref":"John.8.11","start":43008011,"end":43008011,"break":"none","ruby":[[0,1,"おんな"],[2,1,"い"],[7,1,"しゅ"],[25,1,"い"],[39,1,"ばっ"],[45,1,"かえ"],[51,2,"こんご"],[56,1,"つみ"],[58,1,"おか"]],"text":"女は言った、「主よ、だれもございません」。イエスは言われた、「わたしもあなたを罰しない。お帰りなさい。今後はもう罪を犯さないように」。〕"},{"ref":"John.8.12","start":43008012,"end":43008012,"break":"paragraph","ruby":[[7,2,"ひとびと"],[10,1,"かた"],[15,1,"い"],[25,1,"よ"],[27,1,"ひかり"],[36,1,"したが"],[39,1,"く"],[41,1,"もの"],[50,1,"ある"],[58,1,"いのち"],[60,1,"ひかり"]],"text":"イエスは、また人々に語ってこう言われた、「わたしは世の光である。わたしに従って来る者は、やみのうちを歩くことがなく、命の光をもつであろう」。"},{"ref":"John.8.13","start":43008013,"end":43008013,"break":"none","ruby":[[7,1,"びと"],[15,1,"い"],[25,2,"じぶん"],[47,2,"しんじつ"]],"text":"するとパリサイ人たちがイエスに言った、「あなたは、自分のことをあかししている。あなたのあかしは真実ではない」。"},{"ref":"John.8.14","start":43008014,"end":43008014,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[10,1,"い"],[24,2,"じぶん"],[45,2,"しんじつ"],[74,1,"い"],[79,1,"し"],[115,1,"い"],[120,1,"し"]],"text":"イエスは彼らに答えて言われた、「たとい、わたしが自分のことをあかししても、わたしのあかしは真実である。それは、わたしがどこからきたのか、また、どこへ行くのかを知っているからである。しかし、あなたがたは、わたしがどこからきて、どこへ行くのかを知らない。"},{"ref":"John.8.15","start":43008015,"end":43008015,"break":"none","ruby":[[6,1,"にく"],[11,1,"ひと"]],"text":"あなたがたは肉によって人をさばくが、わたしはだれもさばかない。"},{"ref":"John.8.16","start":43008016,"end":43008016,"break":"none","ruby":[[26,1,"ただ"],[65,2,"いっしょ"]],"text":"しかし、もしわたしがさばくとすれば、わたしのさばきは正しい。なぜなら、わたしはひとりではなく、わたしをつかわされたかたが、わたしと一緒だからである。"},{"ref":"John.8.17","start":43008017,"end":43008017,"break":"none","ruby":[[6,2,"りっぽう"],[17,2,"しょうげん"],[20,2,"しんじつ"],[25,1,"か"]],"text":"あなたがたの律法には、ふたりによる証言は真実だと、書いてある。"},{"ref":"John.8.18","start":43008018,"end":43008018,"break":"none","ruby":[[3,2,"じしん"],[35,1,"ちち"],[50,1,"くだ"]],"text":"わたし自身のことをあかしするのは、わたしであるし、わたしをつかわされた父も、わたしのことをあかしして下さるのである」。"},{"ref":"John.8.19","start":43008019,"end":43008019,"break":"none","ruby":[[4,1,"かれ"],[11,1,"い"],[20,1,"ちち"],[35,1,"こた"],[58,1,"ちち"],[61,1,"し"],[81,1,"し"],[93,1,"ちち"],[96,1,"し"]],"text":"すると、彼らはイエスに言った、「あなたの父はどこにいるのか」。イエスは答えられた、「あなたがたは、わたしをもわたしの父をも知っていない。もし、あなたがたがわたしを知っていたなら、わたしの父をも知っていたであろう」。"},{"ref":"John.8.20","start":43008020,"end":43008020,"break":"none","ruby":[[4,1,"みや"],[6,1,"うち"],[8,1,"おし"],[13,1,"とき"],[19,2,"ことば"],[26,1,"はこ"],[31,1,"かた"],[45,1,"とき"],[62,1,"とら"],[65,1,"もの"]],"text":"イエスが宮の内で教えていた時、これらの言葉をさいせん箱のそばで語られたのであるが、イエスの時がまだきていなかったので、だれも捕える者がなかった。"},{"ref":"John.8.21","start":43008021,"end":43008021,"break":"paragraph","ruby":[[5,1,"かれ"],[8,1,"い"],[18,1,"さ"],[21,1,"い"],[34,1,"さが"],[36,1,"もと"],[47,2,"じぶん"],[50,1,"つみ"],[55,1,"し"],[66,1,"い"],[68,1,"ところ"],[78,1,"く"]],"text":"さて、また彼らに言われた、「わたしは去って行く。あなたがたはわたしを捜し求めるであろう。そして自分の罪のうちに死ぬであろう。わたしの行く所には、あなたがたは来ることができない」。"},{"ref":"John.8.22","start":43008022,"end":43008022,"break":"none","ruby":[[6,1,"じん"],[10,1,"い"],[19,1,"い"],[21,1,"ところ"],[30,1,"く"],[41,1,"い"],[51,2,"じさつ"]],"text":"そこでユダヤ人たちは言った、「わたしの行く所に、あなたがたは来ることができないと、言ったのは、あるいは自殺でもしようとするつもりか」。"},{"ref":"John.8.23","start":43008023,"end":43008023,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[19,1,"した"],[22,1,"で"],[24,1,"もの"],[32,1,"うえ"],[37,1,"もの"],[50,1,"よ"],[52,1,"もの"],[64,1,"よ"],[66,1,"もの"]],"text":"イエスは彼らに言われた、「あなたがたは下から出た者だが、わたしは上からきた者である。あなたがたはこの世の者であるが、わたしはこの世の者ではない。"},{"ref":"John.8.24","start":43008024,"end":43008024,"break":"none","ruby":[[14,2,"じぶん"],[17,1,"つみ"],[22,1,"し"],[30,1,"い"],[48,1,"もの"],[61,1,"しん"],[68,1,"つみ"],[73,1,"し"]],"text":"だからわたしは、あなたがたは自分の罪のうちに死ぬであろうと、言ったのである。もしわたしがそういう者であることをあなたがたが信じなければ、罪のうちに死ぬことになるからである」。"},{"ref":"John.8.25","start":43008025,"end":43008025,"break":"none","ruby":[[3,1,"かれ"],[10,1,"い"],[40,1,"かれ"],[43,1,"い"],[57,1,"もの"],[64,1,"はじ"],[74,1,"い"]],"text":"そこで彼らはイエスに言った、「あなたは、いったい、どういうかたですか」。イエスは彼らに言われた、「わたしがどういう者であるかは、初めからあなたがたに言っているではないか。"},{"ref":"John.8.26","start":43008026,"end":43008026,"break":"none","ruby":[[14,1,"い"],[54,2,"しんじつ"],[74,1,"き"],[80,1,"よ"],[86,1,"かた"]],"text":"あなたがたについて、わたしの言うべきこと、さばくべきことが、たくさんある。しかし、わたしをつかわされたかたは真実なかたである。わたしは、そのかたから聞いたままを世にむかって語るのである」。"},{"ref":"John.8.27","start":43008027,"end":43008027,"break":"none","ruby":[[0,1,"かれ"],[8,1,"ちち"],[13,1,"はな"],[23,1,"さと"]],"text":"彼らは、イエスが父について話しておられたことを悟らなかった。"},{"ref":"John.8.28","start":43008028,"end":43008028,"break":"none","ruby":[[7,1,"い"],[19,1,"ひと"],[21,1,"こ"],[23,1,"あ"],[30,1,"のち"],[44,1,"もの"],[58,2,"じぶん"],[63,1,"なに"],[70,1,"ちち"],[72,1,"おし"],[75,1,"くだ"],[82,1,"はな"]],"text":"そこでイエスは言われた、「あなたがたが人の子を上げてしまった後はじめて、わたしがそういう者であること、また、わたしは自分からは何もせず、ただ父が教えて下さったままを話していたことが、わかってくるであろう。"},{"ref":"John.8.29","start":43008029,"end":43008029,"break":"none","ruby":[[18,2,"いっしょ"],[34,1,"かみ"],[61,1,"お"]],"text":"わたしをつかわされたかたは、わたしと一緒におられる。わたしは、いつも神のみこころにかなうことをしているから、わたしをひとり置きざりになさることはない」。"},{"ref":"John.8.30","start":43008030,"end":43008030,"break":"none","ruby":[[7,1,"かた"],[15,1,"おお"],[18,2,"ひとびと"],[25,1,"しん"]],"text":"これらのことを語られたところ、多くの人々がイエスを信じた。"},{"ref":"John.8.31","start":43008031,"end":43008031,"break":"paragraph","ruby":[[4,2,"じぶん"],[7,1,"しん"],[13,1,"じん"],[17,1,"い"],[29,2,"ことば"],[61,2,"でし"]],"text":"イエスは自分を信じたユダヤ人たちに言われた、「もしわたしの言葉のうちにとどまっておるなら、あなたがたは、ほんとうにわたしの弟子なのである。"},{"ref":"John.8.32","start":43008032,"end":43008032,"break":"none","ruby":[[2,2,"しんり"],[5,1,"し"],[15,2,"しんり"],[25,2,"じゆう"],[28,1,"え"]],"text":"また真理を知るであろう。そして真理は、あなたがたに自由を得させるであろう」。"},{"ref":"John.8.33","start":43008033,"end":43008033,"break":"none","ruby":[[4,1,"かれ"],[11,1,"い"],[28,2,"しそん"],[35,1,"ひと"],[37,2,"どれい"],[49,2,"いちど"],[66,2,"じゆう"],[69,1,"え"],[79,1,"い"]],"text":"そこで、彼らはイエスに言った、「わたしたちはアブラハムの子孫であって、人の奴隷になったことなどは、一度もない。どうして、あなたがたに自由を得させるであろうと、言われるのか」。"},{"ref":"John.8.34","start":43008034,"end":43008034,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[24,1,"い"],[33,1,"つみ"],[35,1,"おか"],[37,1,"もの"],[39,1,"つみ"],[41,2,"どれい"]],"text":"イエスは彼らに答えられた、「よくよくあなたがたに言っておく。すべて罪を犯す者は罪の奴隷である。"},{"ref":"John.8.35","start":43008035,"end":43008035,"break":"none","ruby":[[4,2,"どれい"],[12,1,"いえ"],[16,1,"もの"],[26,1,"こ"]],"text":"そして、奴隷はいつまでも家にいる者ではない。しかし、子はいつまでもいる。"},{"ref":"John.8.36","start":43008036,"end":43008036,"break":"none","ruby":[[6,1,"こ"],[14,2,"じゆう"],[17,1,"え"],[37,2,"じゆう"],[40,1,"もの"]],"text":"だから、もし子があなたがたに自由を得させるならば、あなたがたは、ほんとうに自由な者となるのである。"},{"ref":"John.8.37","start":43008037,"end":43008037,"break":"none","ruby":[[17,2,"しそん"],[25,1,"し"],[47,1,"ころ"],[60,2,"ことば"],[73,1,"ね"]],"text":"わたしは、あなたがたがアブラハムの子孫であることを知っている。それだのに、あなたがたはわたしを殺そうとしている。わたしの言葉が、あなたがたのうちに根をおろしていないからである。"},{"ref":"John.8.38","start":43008038,"end":43008038,"break":"none","ruby":[[8,1,"ちち"],[13,1,"み"],[18,1,"かた"],[31,2,"じぶん"],[34,1,"ちち"],[37,1,"き"],[43,1,"おこな"]],"text":"わたしはわたしの父のもとで見たことを語っているが、あなたがたは自分の父から聞いたことを行っている」。"},{"ref":"John.8.39","start":43008039,"end":43008039,"break":"none","ruby":[[0,1,"かれ"],[7,1,"こた"],[10,1,"い"],[21,1,"ちち"],[37,1,"かれ"],[40,1,"い"],[54,1,"こ"]],"text":"彼らはイエスに答えて言った、「わたしたちの父はアブラハムである」。イエスは彼らに言われた、「もしアブラハムの子であるなら、アブラハムのわざをするがよい。"},{"ref":"John.8.40","start":43008040,"end":43008040,"break":"none","ruby":[[4,1,"いま"],[6,1,"かみ"],[9,1,"き"],[12,2,"しんり"],[21,1,"かた"],[33,1,"ころ"]],"text":"ところが今、神から聞いた真理をあなたがたに語ってきたこのわたしを、殺そうとしている。そんなことをアブラハムはしなかった。"},{"ref":"John.8.41","start":43008041,"end":43008041,"break":"none","ruby":[[13,1,"ちち"],[18,1,"おこな"],[29,1,"かれ"],[32,1,"い"],[44,3,"ふひんこう"],[48,2,"けっか"],[54,1,"もの"],[71,1,"ちち"],[79,1,"かみ"]],"text":"あなたがたは、あなたがたの父のわざを行っているのである」。彼らは言った、「わたしたちは、不品行の結果うまれた者ではない。わたしたちにはひとりの父がある。それは神である」。"},{"ref":"John.8.42","start":43008042,"end":43008042,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[13,1,"かみ"],[21,1,"ちち"],[39,1,"あい"],[52,1,"かみ"],[55,1,"で"],[57,1,"もの"],[61,1,"かみ"],[68,1,"もの"],[80,2,"じぶん"],[92,1,"かみ"]],"text":"イエスは彼らに言われた、「神があなたがたの父であるならば、あなたがたはわたしを愛するはずである。わたしは神から出た者、また神からきている者であるからだ。わたしは自分からきたのではなく、神からつかわされたのである。"},{"ref":"John.8.43","start":43008043,"end":43008043,"break":"none","ruby":[[15,1,"はな"],[39,2,"ことば"],[42,1,"さと"]],"text":"どうしてあなたがたは、わたしの話すことがわからないのか。あなたがたが、わたしの言葉を悟ることができないからである。"},{"ref":"John.8.44","start":43008044,"end":43008044,"break":"none","ruby":[[6,2,"じぶん"],[9,1,"ちち"],[16,2,"あくま"],[20,1,"で"],[24,1,"もの"],[32,1,"ちち"],[34,2,"よくぼう"],[40,1,"おこな"],[44,1,"おも"],[50,1,"かれ"],[52,1,"はじ"],[57,2,"ひとごろ"],[65,2,"しんり"],[68,1,"た"],[70,1,"もの"],[76,1,"かれ"],[82,2,"しんり"],[93,1,"かれ"],[95,1,"いつわ"],[98,1,"い"],[106,2,"じぶん"],[109,2,"ほんね"],[122,1,"かれ"],[124,1,"いつわ"],[126,1,"もの"],[131,1,"いつわ"],[134,1,"ちち"]],"text":"あなたがたは自分の父、すなわち、悪魔から出てきた者であって、その父の欲望どおりを行おうと思っている。彼は初めから、人殺しであって、真理に立つ者ではない。彼のうちには真理がないからである。彼が偽りを言うとき、いつも自分の本音をはいているのである。彼は偽り者であり、偽りの父であるからだ。"},{"ref":"John.8.45","start":43008045,"end":43008045,"break":"none","ruby":[[8,2,"しんり"],[11,1,"かた"],[29,1,"しん"]],"text":"しかし、わたしが真理を語っているので、あなたがたはわたしを信じようとしない。"},{"ref":"John.8.46","start":43008046,"end":43008046,"break":"none","ruby":[[16,1,"つみ"],[21,1,"せ"],[32,2,"しんり"],[35,1,"かた"],[56,1,"しん"]],"text":"あなたがたのうち、だれがわたしに罪があると責めうるのか。わたしは真理を語っているのに、なぜあなたがたは、わたしを信じないのか。"},{"ref":"John.8.47","start":43008047,"end":43008047,"break":"none","ruby":[[0,1,"かみ"],[5,1,"もの"],[7,1,"かみ"],[9,2,"ことば"],[12,1,"き"],[14,1,"したが"],[24,1,"き"],[26,1,"したが"],[33,1,"かみ"],[38,1,"もの"]],"text":"神からきた者は神の言葉に聞き従うが、あなたがたが聞き従わないのは、神からきた者でないからである」。"},{"ref":"John.8.48","start":43008048,"end":43008048,"break":"paragraph","ruby":[[3,1,"じん"],[11,1,"こた"],[14,1,"い"],[27,1,"びと"],[30,2,"あくれい"],[33,1,"と"],[49,1,"い"],[54,2,"とうぜん"]],"text":"ユダヤ人たちはイエスに答えて言った、「あなたはサマリヤ人で、悪霊に取りつかれていると、わたしたちが言うのは、当然ではないか」。"},{"ref":"John.8.49","start":43008049,"end":43008049,"break":"none","ruby":[[4,1,"こた"],[16,2,"あくれい"],[19,1,"と"],[38,1,"ちち"],[40,1,"おも"],[60,1,"かろ"]],"text":"イエスは答えられた、「わたしは、悪霊に取りつかれているのではなくて、わたしの父を重んじているのだが、あなたがたはわたしを軽んじている。"},{"ref":"John.8.50","start":43008050,"end":43008050,"break":"none","ruby":[[4,2,"じぶん"],[7,2,"えいこう"],[10,1,"もと"],[21,1,"もと"],[27,1,"べつ"]],"text":"わたしは自分の栄光を求めてはいない。それを求めるかたが別にある。そのかたは、またさばくかたである。"},{"ref":"John.8.51","start":43008051,"end":43008051,"break":"none","ruby":[[4,1,"い"],[12,1,"ひと"],[18,2,"ことば"],[21,1,"まも"],[29,1,"ひと"],[36,1,"し"],[38,1,"み"]],"text":"よくよく言っておく。もし人がわたしの言葉を守るならば、その人はいつまでも死を見ることがないであろう」。"},{"ref":"John.8.52","start":43008052,"end":43008052,"break":"none","ruby":[[3,1,"じん"],[7,1,"い"],[16,2,"あくれい"],[19,1,"と"],[31,1,"いま"],[43,1,"し"],[46,3,"よげんしゃ"],[52,1,"し"],[73,2,"ことば"],[76,1,"まも"],[78,1,"もの"],[85,1,"し"],[87,1,"あじ"],[101,1,"い"]],"text":"ユダヤ人たちが言った、「あなたが悪霊に取りつかれていることが、今わかった。アブラハムは死に、預言者たちも死んでいる。それだのに、あなたは、わたしの言葉を守る者はいつまでも死を味わうことがないであろうと、言われる。"},{"ref":"John.8.53","start":43008053,"end":43008053,"break":"none","ruby":[[11,1,"ちち"],[19,1,"えら"],[27,1,"かれ"],[29,1,"し"],[32,3,"よげんしゃ"],[38,1,"し"],[57,2,"じぶん"],[63,1,"おも"]],"text":"あなたは、わたしたちの父アブラハムより偉いのだろうか。彼も死に、預言者たちも死んだではないか。あなたは、いったい、自分をだれと思っているのか」。"},{"ref":"John.8.54","start":43008054,"end":43008054,"break":"none","ruby":[[4,1,"こた"],[17,2,"じぶん"],[20,2,"えいこう"],[23,1,"き"],[33,2,"えいこう"],[51,2,"えいこう"],[54,1,"あた"],[65,1,"ちち"],[77,2,"じぶん"],[80,1,"かみ"],[83,1,"い"]],"text":"イエスは答えられた、「わたしがもし自分に栄光を帰するなら、わたしの栄光は、むなしいものである。わたしに栄光を与えるかたは、わたしの父であって、あなたがたが自分の神だと言っているのは、そのかたのことである。"},{"ref":"John.8.55","start":43008055,"end":43008055,"break":"none","ruby":[[8,1,"かみ"],[10,1,"し"],[22,1,"し"],[34,1,"かみ"],[36,1,"し"],[41,1,"い"],[53,1,"おな"],[58,1,"いつわ"],[60,1,"もの"],[79,1,"し"],[84,2,"みことば"],[87,1,"まも"]],"text":"あなたがたはその神を知っていないが、わたしは知っている。もしわたしが神を知らないと言うならば、あなたがたと同じような偽り者であろう。しかし、わたしはそのかたを知り、その御言を守っている。"},{"ref":"John.8.56","start":43008056,"end":43008056,"break":"none","ruby":[[6,1,"ちち"],[20,1,"ひ"],[22,1,"み"],[28,1,"たの"],[41,1,"み"],[43,1,"よろこ"]],"text":"あなたがたの父アブラハムは、わたしのこの日を見ようとして楽しんでいた。そしてそれを見て喜んだ」。"},{"ref":"John.8.57","start":43008057,"end":43008057,"break":"none","ruby":[[6,1,"じん"],[14,1,"い"],[42,1,"み"]],"text":"そこでユダヤ人たちはイエスに言った、「あなたはまだ五十にもならないのに、アブラハムを見たのか」。"},{"ref":"John.8.58","start":43008058,"end":43008058,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[23,1,"い"],[35,1,"うま"],[38,1,"まえ"]],"text":"イエスは彼らに言われた、「よくよくあなたがたに言っておく。アブラハムの生れる前からわたしは、いるのである」。"},{"ref":"John.8.59","start":43008059,"end":43008059,"break":"none","ruby":[[3,1,"かれ"],[6,1,"いし"],[16,1,"な"],[34,1,"み"],[36,1,"かく"],[40,1,"みや"],[43,1,"で"],[45,1,"い"]],"text":"そこで彼らは石をとって、イエスに投げつけようとした。しかし、イエスは身を隠して、宮から出て行かれた。"}]