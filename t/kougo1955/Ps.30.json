[{"ref":"Ps.30.1","start":19030001,"end":19030001,"break":"paragraph","title":"宮をささげるときにうたったダビデの歌","breaks":[[17,"line"],[30,"line"],[46,"line"]],"ruby":[[0,1,"しゅ"],[25,1,"ひ"],[30,1,"てき"],[36,1,"こと"],[41,1,"よろこ"]],"titleRuby":[[0,1,"みや"],[17,1,"うた"]],"text":"主よ、わたしはあなたをあがめます。あなたはわたしを引きあげ、敵がわたしの事によって喜ぶのを、ゆるされなかったからです。"},{"ref":"Ps.30.2","start":19030002,"end":19030002,"break":"line","breaks":[[7,"line"],[29,"line"]],"ruby":[[2,1,"かみ"],[4,1,"しゅ"],[19,1,"たす"],[22,1,"さけ"],[24,1,"もと"]],"text":"わが神、主よ、わたしがあなたにむかって助けを叫び求めると、あなたはわたしをいやしてくださいました。"},{"ref":"Ps.30.3","start":19030003,"end":19030003,"break":"line","breaks":[[22,"line"],[33,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"たましい"],[13,2,"よみ"],[22,1,"はか"],[24,1,"くだ"],[26,1,"もの"],[37,1,"い"],[39,1,"かえ"]],"text":"主よ、あなたはわたしの魂を陰府からひきあげ、墓に下る者のうちから、わたしを生き返らせてくださいました。"},{"ref":"Ps.30.4","start":19030004,"end":19030004,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"せいと"],[6,1,"しゅ"],[16,1,"せい"],[20,1,"な"],[22,2,"かんしゃ"]],"text":"主の聖徒よ、主をほめうたい、その聖なるみ名に感謝せよ。"},{"ref":"Ps.30.5","start":19030005,"end":19030005,"break":"line","breaks":[[13,"line"],[33,"line"],[49,"line"]],"ruby":[[2,1,"いか"],[15,1,"めぐ"],[25,1,"なが"],[33,1,"よる"],[40,1,"な"],[49,1,"あさ"],[51,1,"とも"],[53,1,"よろこ"],[56,1,"く"]],"text":"その怒りはただつかのまで、その恵みはいのちのかぎり長いからである。夜はよもすがら泣きかなしんでも、朝と共に喜びが来る。"},{"ref":"Ps.30.6","start":19030006,"end":19030006,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"やす"],[8,1,"とき"],[10,1,"い"],[19,1,"けっ"],[22,1,"うご"]],"text":"わたしは安らかな時に言った、「わたしは決して動かされることはない」と。"},{"ref":"Ps.30.7","start":19030007,"end":19030007,"break":"line","breaks":[[13,"line"],[35,"line"],[50,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"めぐ"],[22,1,"やま"],[27,1,"かた"],[40,1,"かお"],[56,1,"まど"]],"text":"主よ、あなた恵みをもって、わたしをゆるがない山のように堅くされました。あなたがみ顔をかくされたので、わたしはおじ惑いました。"},{"ref":"Ps.30.8","start":19030008,"end":19030008,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"よ"],[23,1,"しゅ"],[25,1,"こ"],[27,1,"ねが"]],"text":"主よ、わたしはあなたに呼ばわりました。ひたすら主に請い願いました、"},{"ref":"Ps.30.9","start":19030009,"end":19030009,"break":"line","breaks":[[13,"line"],[32,"line"],[51,"line"]],"ruby":[[5,1,"はか"],[7,1,"くだ"],[17,1,"し"],[22,1,"えき"],[61,1,"つた"]],"text":"「わたしが墓に下るならば、わたしの死になんの益があるでしょうか。ちりはあなたをほめたたえるでしょうか。あなたのまことをのべ伝えるでしょうか。"},{"ref":"Ps.30.10","start":19030010,"end":19030010,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"き"],[25,1,"しゅ"],[32,1,"たす"]],"text":"主よ、聞いてください、わたしをあわれんでください。主よ、わたしの助けとなってください」と。"},{"ref":"Ps.30.11","start":19030011,"end":19030011,"break":"line","breaks":[[21,"line"]],"ruby":[[12,1,"なげ"],[15,1,"おど"],[21,2,"あらぬの"],[24,1,"と"],[27,1,"よろこ"],[34,1,"おび"]],"text":"あなたはわたしのために、嘆きを踊りにかえ、荒布を解き、喜びをわたしの帯とされました。"},{"ref":"Ps.30.12","start":19030012,"end":19030012,"break":"line","breaks":[[20,"line"],[35,"line"],[42,"line"]],"ruby":[[7,1,"たましい"],[20,1,"くち"],[37,1,"かみ"],[39,1,"しゅ"],[55,2,"かんしゃ"]],"text":"これはわたしの魂があなたをほめたたえて、口をつぐむことのないためです。わが神、主よ、わたしはとこしえにあなたに感謝します。"}]