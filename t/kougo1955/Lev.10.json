[{"ref":"Lev.10.1","start":3010001,"end":3010001,"break":"paragraph","ruby":[[6,1,"こ"],[23,2,"こうろ"],[26,1,"と"],[29,1,"ひ"],[34,1,"い"],[37,2,"くんこう"],[42,1,"うえ"],[44,1,"も"],[48,2,"ことび"],[51,1,"しゅ"],[53,1,"まえ"],[63,1,"しゅ"],[65,2,"めいれい"],[68,1,"はん"]],"text":"さてアロンの子ナダブとアビフとは、おのおのその香炉を取って火をこれに入れ、薫香をその上に盛って、異火を主の前にささげた。これは主の命令に反することであったので、"},{"ref":"Lev.10.2","start":3010002,"end":3010002,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"まえ"],[5,1,"ひ"],[7,1,"で"],[9,1,"かれ"],[12,1,"や"],[14,1,"ほろ"],[18,1,"かれ"],[21,1,"しゅ"],[23,1,"まえ"],[25,1,"し"]],"text":"主の前から火が出て彼らを焼き滅ぼし、彼らは主の前に死んだ。"},{"ref":"Lev.10.3","start":3010003,"end":3010003,"break":"none","ruby":[[2,1,"とき"],[11,1,"い"],[16,1,"しゅ"],[21,1,"おお"],[41,1,"ちか"],[44,1,"もの"],[54,1,"せい"],[60,1,"しめ"],[67,1,"たみ"],[69,1,"まえ"],[71,2,"えいこう"],[74,1,"あらわ"],[87,1,"もく"]],"text":"その時モーセはアロンに言った、「主は、こう仰せられた。すなわち『わたしは、わたしに近づく者のうちに、わたしの聖なることを示し、すべての民の前に栄光を現すであろう』」。アロンは黙していた。"},{"ref":"Lev.10.4","start":3010004,"end":3010004,"break":"paragraph","ruby":[[8,2,"おじ"],[15,1,"こ"],[29,1,"よ"],[31,1,"よ"],[34,1,"かれ"],[37,1,"い"],[42,2,"ちかよ"],[53,2,"きょうだい"],[58,2,"せいじょ"],[61,1,"まえ"],[65,2,"しゅくえい"],[68,1,"そと"],[70,1,"はこ"],[72,1,"だ"]],"text":"モーセはアロンの叔父ウジエルの子ミシヤエルとエルザパンとを呼び寄せて彼らに言った、「近寄って、あなたがたの兄弟たちを聖所の前から、宿営の外に運び出しなさい」。"},{"ref":"Lev.10.5","start":3010005,"end":3010005,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ちかよ"],[8,1,"かれ"],[13,1,"ふく"],[17,2,"しゅくえい"],[20,1,"そと"],[22,1,"はこ"],[24,1,"だ"],[31,1,"い"]],"text":"彼らは近寄って、彼らをその服のまま宿営の外に運び出し、モーセの言ったようにした。"},{"ref":"Lev.10.6","start":3010006,"end":3010006,"break":"none","ruby":[[14,1,"こ"],[27,1,"い"],[38,1,"かみ"],[40,1,"け"],[42,1,"みだ"],[47,2,"いふく"],[50,1,"さ"],[65,1,"し"],[77,1,"しゅ"],[79,1,"いか"],[87,2,"かいしゅう"],[90,1,"およ"],[113,2,"きょうだい"],[121,2,"ぜんか"],[125,1,"しゅ"],[127,1,"ひ"],[132,1,"や"],[134,1,"ほろ"],[144,1,"なげ"]],"text":"モーセはまたアロンおよびその子エレアザルとイタマルとに言った、「あなたがたは髪の毛を乱し、また衣服を裂いてはならない。あなたがたが死ぬことのないため、また主の怒りが、すべての会衆に及ぶことのないためである。ただし、あなたがたの兄弟イスラエルの全家は、主が火をもって焼き滅ぼしたもうたことを嘆いてもよい。"},{"ref":"Lev.10.7","start":3010007,"end":3010007,"break":"none","ruby":[[9,1,"し"],[20,2,"かいけん"],[23,2,"まくや"],[26,2,"いりぐち"],[30,1,"そと"],[32,1,"で"],[46,1,"うえ"],[48,1,"しゅ"],[50,1,"そそ"],[52,1,"あぶら"],[63,1,"かれ"],[70,2,"ことば"]],"text":"また、あなたがたは死ぬことのないように、会見の幕屋の入口から外へ出てはならない。あなたがたの上に主の注ぎ油があるからである」。彼らはモーセの言葉のとおりにした。"},{"ref":"Lev.10.8","start":3010008,"end":3010008,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はアロンに言われた、"},{"ref":"Lev.10.9","start":3010009,"end":3010009,"break":"none","ruby":[[10,1,"こ"],[14,2,"かいけん"],[17,2,"まくや"],[23,1,"とき"],[27,1,"し"],[41,1,"しゅ"],[43,1,"こ"],[45,1,"さけ"],[47,1,"の"],[65,2,"よよ"],[67,1,"なが"],[69,1,"まも"],[73,1,"さだ"]],"text":"「あなたも、あなたの子たちも会見の幕屋にはいる時には、死ぬことのないように、ぶどう酒と濃い酒を飲んではならない。これはあなたがたが代々永く守るべき定めとしなければならない。"},{"ref":"Lev.10.10","start":3010010,"end":3010010,"break":"none","ruby":[[9,1,"せい"],[15,1,"ぞく"],[21,1,"けが"],[27,1,"きよ"],[33,2,"くべつ"]],"text":"これはあなたがたが聖なるものと俗なるもの、汚れたものと清いものとの区別をすることができるため、"},{"ref":"Lev.10.11","start":3010011,"end":3010011,"break":"none","ruby":[[2,1,"しゅ"],[11,1,"かた"],[19,1,"さだ"],[29,2,"ひとびと"],[32,1,"おし"]],"text":"また主がモーセによって語られたすべての定めを、イスラエルの人々に教えることができるためである」。"},{"ref":"Lev.10.12","start":3010012,"end":3010012,"break":"paragraph","ruby":[[14,1,"のこ"],[19,1,"こ"],[32,1,"い"],[43,1,"しゅ"],[45,2,"かさい"],[52,2,"そさい"],[55,1,"のこ"],[58,1,"と"],[63,1,"だね"],[65,1,"い"],[73,2,"さいだん"],[81,1,"た"],[92,1,"せい"],[95,1,"もの"]],"text":"モーセはまたアロンおよびその残っている子エレアザルとイタマルとに言った、「あなたがたは主の火祭のうちから素祭の残りを取り、パン種を入れずに、これを祭壇のかたわらで食べなさい。これはいと聖なる物である。"},{"ref":"Lev.10.13","start":3010013,"end":3010013,"break":"none","ruby":[[3,1,"しゅ"],[5,2,"かさい"],[16,1,"う"],[19,1,"ぶん"],[27,1,"こ"],[31,1,"う"],[34,1,"ぶん"],[50,1,"せい"],[53,1,"ところ"],[55,1,"た"],[75,1,"めい"]],"text":"これは主の火祭のうちからあなたの受ける分、またあなたの子たちの受ける分であるから、あなたがたはこれを聖なる所で食べなければならない。わたしはこのように命じられたのである。"},{"ref":"Lev.10.14","start":3010014,"end":3010014,"break":"none","ruby":[[2,1,"ゆ"],[4,1,"うご"],[8,1,"むね"],[31,1,"むすめ"],[38,1,"きよ"],[40,1,"ところ"],[42,1,"た"],[62,2,"ひとびと"],[65,3,"しゅうおんさい"],[69,2,"ぎせい"],[72,1,"なか"],[79,1,"ぶん"],[85,1,"こ"],[89,1,"ぶん"],[93,1,"あた"]],"text":"また揺り動かした胸とささげたももとは、あなたとあなたのむすこ、娘たちがこれを清い所で食べなければならない。これはイスラエルの人々の酬恩祭の犠牲の中からあなたの分、あなたの子たちの分として与えられるものだからである。"},{"ref":"Lev.10.15","start":3010015,"end":3010015,"break":"none","ruby":[[0,1,"かれ"],[12,1,"ゆ"],[14,1,"うご"],[18,1,"むね"],[22,2,"かさい"],[25,2,"しぼう"],[28,1,"とも"],[30,1,"たずさ"],[39,1,"しゅ"],[41,1,"まえ"],[43,1,"ゆ"],[45,1,"うご"],[49,2,"ようさい"],[65,1,"しゅ"],[68,1,"めい"],[78,1,"なが"],[80,1,"う"],[84,1,"ぶん"],[97,1,"こ"],[102,1,"き"]],"text":"彼らはそのささげたももと揺り動かした胸とを、火祭の脂肪と共に携えてきて、これを主の前に揺り動かして揺祭としなければならない。これは主がお命じになったように、長く受くべき分としてあなたと、あなたの子たちとに帰するであろう」。"},{"ref":"Lev.10.16","start":3010016,"end":3010016,"break":"paragraph","ruby":[[6,2,"ざいさい"],[18,1,"さが"],[23,1,"み"],[32,1,"や"],[41,1,"かれ"],[43,1,"のこ"],[52,1,"こ"],[69,1,"いか"],[72,1,"い"]],"text":"さてモーセは罪祭のやぎを、ていねいに捜したが、見よ、それがすでに焼かれていたので、彼は残っているアロンの子エレアザルとイタマルとにむかい、怒って言った、"},{"ref":"Lev.10.17","start":3010017,"end":3010017,"break":"none","ruby":[[10,2,"ざいさい"],[16,1,"せい"],[19,1,"ところ"],[21,1,"た"],[35,1,"せい"],[38,1,"もの"],[50,2,"かいしゅう"],[53,1,"つみ"],[55,1,"お"],[59,1,"かれ"],[65,1,"しゅ"],[67,1,"まえ"],[85,1,"たま"],[89,1,"もの"]],"text":"「あなたがたは、なぜ罪祭のものを聖なる所で食べなかったのか。これはいと聖なる物であって、あなたがたが会衆の罪を負って、彼らのために主の前にあがないをするため、あなたがたに賜わった物である。"},{"ref":"Lev.10.18","start":3010018,"end":3010018,"break":"none","ruby":[[0,1,"み"],[5,1,"ち"],[7,2,"せいじょ"],[10,1,"なか"],[12,1,"たずさ"],[14,1,"い"],[23,1,"にく"],[29,1,"めい"],[42,1,"かなら"],[47,1,"せい"],[50,1,"ところ"],[52,1,"た"]],"text":"見よ、その血は聖所の中に携え入れなかった。その肉はわたしが命じたように、あなたがたは必ずそれを聖なる所で食べるべきであった」。"},{"ref":"Lev.10.19","start":3010019,"end":3010019,"break":"none","ruby":[[8,1,"い"],[13,1,"み"],[20,1,"かれ"],[25,2,"ざいさい"],[28,2,"はんさい"],[32,1,"しゅ"],[34,1,"まえ"],[47,1,"こと"],[53,1,"のぞ"],[67,2,"ざいさい"],[73,1,"た"],[81,1,"しゅ"],[86,1,"よ"]],"text":"アロンはモーセに言った、「見よ、きょう、彼らはその罪祭と燔祭とを主の前にささげたが、このような事がわたしに臨んだ。もしわたしが、きょう罪祭のものを食べたとしたら、主はこれを良しとせられたであろうか」。"},{"ref":"Lev.10.20","start":3010020,"end":3010020,"break":"none","ruby":[[7,1,"き"],[10,1,"よ"]],"text":"モーセはこれを聞いて良しとした。"}]