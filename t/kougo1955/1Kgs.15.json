[{"ref":"1Kgs.15.1","start":11015001,"end":11015001,"break":"paragraph","ruby":[[4,1,"こ"],[10,1,"おう"],[12,1,"だい"],[15,1,"ねん"],[25,1,"おう"]],"text":"ネバテの子ヤラベアム王の第十八年にアビヤムがユダの王となり、"},{"ref":"1Kgs.15.2","start":11015002,"end":11015002,"break":"none","ruby":[[7,1,"ねん"],[8,1,"よ"],[10,1,"おさ"],[16,1,"はは"],[18,1,"な"],[34,1,"むすめ"]],"text":"エルサレムで三年世を治めた。その母の名はマアカといって、アブサロムの娘であった。"},{"ref":"1Kgs.15.3","start":11015003,"end":11015003,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ちち"],[6,1,"さき"],[8,1,"おこな"],[16,1,"つみ"],[25,1,"こころ"],[27,1,"ちち"],[32,1,"こころ"],[39,1,"かみ"],[41,1,"しゅ"],[43,1,"たい"],[46,1,"まった"],[48,2,"しんじつ"]],"text":"彼はその父が先に行ったもろもろの罪をおこない、その心は父ダビデの心のようにその神、主に対して全く真実ではなかった。"},{"ref":"1Kgs.15.4","start":11015004,"end":11015004,"break":"none","ruby":[[12,1,"かみ"],[14,1,"しゅ"],[33,1,"かれ"],[43,1,"あた"],[48,1,"こ"],[50,1,"かれ"],[55,1,"た"],[65,1,"かた"]],"text":"それにもかかわらず、その神、主はダビデのために、エルサレムにおいて彼に一つのともしびを与え、その子を彼のあとに立てて、エルサレムを固められた。"},{"ref":"1Kgs.15.5","start":11015005,"end":11015005,"break":"none","ruby":[[15,1,"こと"],[20,2,"いっしょう"],[23,1,"あいだ"],[25,1,"しゅ"],[27,1,"め"],[32,1,"こと"],[34,1,"おこな"],[37,1,"しゅ"],[39,1,"めい"],[48,1,"こと"]],"text":"それはダビデがヘテびとウリヤの事のほか、一生の間、主の目にかなう事を行い、主が命じられたすべての事に、そむかなかったからである。"},{"ref":"1Kgs.15.6","start":11015006,"end":11015006,"break":"none","ruby":[[12,1,"あいだ"],[15,2,"いっしょう"],[18,1,"あいだ"],[20,2,"せんそう"]],"text":"レハベアムとヤラベアムの間には一生の間、戦争があった。"},{"ref":"1Kgs.15.7","start":11015007,"end":11015007,"break":"none","ruby":[[7,1,"た"],[9,2,"こうい"],[13,1,"かれ"],[21,1,"こと"],[27,1,"おう"],[29,3,"れきだいし"],[33,1,"しょ"],[59,1,"あいだ"],[62,2,"せんそう"]],"text":"アビヤムのその他の行為と、彼がしたすべての事は、ユダの王の歴代志の書にしるされているではないか。アビヤムとヤラベアムの間にも戦争があった。"},{"ref":"1Kgs.15.8","start":11015008,"end":11015008,"break":"none","ruby":[[7,2,"せんぞ"],[10,1,"とも"],[12,1,"ねむ"],[20,1,"まち"],[22,1,"ほうむ"],[28,1,"こ"],[32,1,"かわ"],[35,1,"おう"]],"text":"アビヤムはその先祖と共に眠って、ダビデの町に葬られ、その子アサが代って王となった。"},{"ref":"1Kgs.15.9","start":11015009,"end":11015009,"break":"paragraph","ruby":[[6,1,"おう"],[13,1,"だい"],[16,1,"ねん"],[24,1,"おう"]],"text":"イスラエルの王ヤラベアムの第二十年にアサはユダの王となり、"},{"ref":"1Kgs.15.10","start":11015010,"end":11015010,"break":"none","ruby":[[9,1,"ねん"],[10,1,"よ"],[12,1,"おさ"],[18,1,"はは"],[20,1,"な"],[35,1,"むすめ"]],"text":"エルサレムで四十一年世を治めた。その母の名はマアカといってアブサロムの娘であった。"},{"ref":"1Kgs.15.11","start":11015011,"end":11015011,"break":"none","ruby":[[5,1,"ちち"],[15,1,"しゅ"],[17,1,"め"],[22,1,"こと"]],"text":"アサはその父ダビデがしたように主の目にかなう事をし、"},{"ref":"1Kgs.15.12","start":11015012,"end":11015012,"break":"none","ruby":[[0,2,"しんでん"],[2,2,"だんしょう"],[5,1,"くに"],[8,1,"お"],[10,1,"だ"],[13,2,"せんぞ"],[18,1,"つく"],[26,2,"ぐうぞう"],[29,1,"のぞ"]],"text":"神殿男娼を国から追い出し、先祖たちの造ったもろもろの偶像を除いた。"},{"ref":"1Kgs.15.13","start":11015013,"end":11015013,"break":"none","ruby":[[0,1,"かれ"],[6,1,"はは"],[19,1,"にく"],[23,1,"ぞう"],[25,1,"つく"],[32,2,"かのじょ"],[35,2,"たいこう"],[38,1,"くらい"],[41,1,"しりぞ"],[53,1,"にく"],[57,1,"ぞう"],[59,1,"き"],[61,1,"たお"],[69,1,"たに"],[71,1,"や"],[73,1,"す"]],"text":"彼はまたその母マアカが、アシラのために憎むべき像を造らせたので、彼女を太后の位から退けた。そしてアサはその憎むべき像を切り倒してキデロンの谷で焼き捨てた。"},{"ref":"1Kgs.15.14","start":11015014,"end":11015014,"break":"none","ruby":[[3,1,"たか"],[5,1,"ところ"],[7,1,"のぞ"],[21,1,"こころ"],[23,2,"いっしょう"],[26,1,"あいだ"],[28,1,"しゅ"],[30,1,"たい"],[33,1,"まった"],[35,2,"しんじつ"]],"text":"ただし高き所は除かなかった。けれどもアサの心は一生の間、主に対して全く真実であった。"},{"ref":"1Kgs.15.15","start":11015015,"end":11015015,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ちち"],[4,2,"けんのう"],[8,1,"もの"],[10,2,"じぶん"],[13,2,"けんのう"],[17,1,"もの"],[19,2,"きんぎん"],[24,2,"うつわもの"],[27,1,"しゅ"],[29,1,"みや"],[31,1,"たずさ"],[33,1,"い"]],"text":"彼は父の献納した物と自分の献納した物、金銀および器物を主の宮に携え入れた。"},{"ref":"1Kgs.15.16","start":11015016,"end":11015016,"break":"paragraph","ruby":[[9,1,"おう"],[15,1,"あいだ"],[18,2,"いっしょう"],[21,1,"あいだ"],[23,2,"せんそう"]],"text":"アサとイスラエルの王バアシャの間には一生の間、戦争があった。"},{"ref":"1Kgs.15.17","start":11015017,"end":11015017,"break":"none","ruby":[[6,1,"おう"],[15,1,"せ"],[17,1,"のぼ"],[23,1,"おう"],[27,1,"ところ"],[34,2,"でい"],[47,1,"きず"]],"text":"イスラエルの王バアシャはユダに攻め上り、ユダの王アサの所に、だれをも出入りさせないためにラマを築いた。"},{"ref":"1Kgs.15.18","start":11015018,"end":11015018,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"みや"],[10,2,"ほうぞう"],[14,1,"おう"],[16,2,"きゅうでん"],[19,2,"ほうぞう"],[22,1,"のこ"],[27,2,"きんぎん"],[35,1,"と"],[42,2,"けらい"],[47,1,"て"],[58,1,"おう"],[60,1,"かれ"],[68,1,"す"],[77,1,"おう"],[84,1,"こ"],[91,1,"こ"],[106,1,"い"]],"text":"そこでアサは主の宮の宝蔵と、王の宮殿の宝蔵に残っている金銀をことごとく取って、これを家来たちの手にわたし、そしてアサ王は彼らをダマスコに住んでいるスリヤの王、ヘジョンの子タブリモンの子であるベネハダデにつかわして言わせた、"},{"ref":"1Kgs.15.19","start":11015019,"end":11015019,"break":"none","ruby":[[5,1,"ちち"],[11,1,"ちち"],[14,1,"あいだ"],[16,1,"むす"],[34,1,"あいだ"],[36,2,"どうめい"],[39,1,"むす"],[54,2,"きんぎん"],[57,1,"おく"],[59,1,"もの"],[68,1,"い"],[82,1,"おう"],[89,2,"どうめい"],[92,2,"はき"],[96,1,"かれ"],[102,1,"ところ"],[105,2,"てったい"]],"text":"「わたしの父とあなたの父との間に結ばれていたように、わたしとあなたの間に同盟を結びましょう。わたしはあなたに金銀の贈り物をさしあげます。行って、あなたとイスラエルの王バアシャとの同盟を破棄し、彼をわたしの所から撤退させてください」。"},{"ref":"1Kgs.15.20","start":11015020,"end":11015020,"break":"none","ruby":[[8,1,"おう"],[10,1,"い"],[15,1,"き"],[18,2,"じぶん"],[21,2,"ぐんぜい"],[24,1,"ちょう"],[39,2,"まちまち"],[42,1,"せ"],[71,1,"ぜん"],[72,1,"ち"],[80,1,"ぜん"],[81,1,"ち"],[83,1,"う"]],"text":"ベネハダデはアサ王の言うことを聞き、自分の軍勢の長たちをつかわしてイスラエルの町々を攻め、イヨンとダンとアベル・ベテ・マアカおよびキンネレテの全地と、ナフタリの全地を撃った。"},{"ref":"1Kgs.15.21","start":11015021,"end":11015021,"break":"none","ruby":[[8,1,"き"],[14,1,"きず"]],"text":"バアシャはこれを聞き、ラマを築くことをやめて、テルザにとどまった。"},{"ref":"1Kgs.15.22","start":11015022,"end":11015022,"break":"none","ruby":[[5,1,"おう"],[9,2,"ぜんこく"],[12,2,"ふこく"],[15,1,"はっ"],[23,1,"まぬか"],[26,1,"もの"],[45,1,"きず"],[50,1,"もち"],[53,1,"いし"],[55,2,"ざいもく"],[58,1,"はこ"],[66,1,"おう"],[71,1,"もち"],[88,1,"きず"]],"text":"そこでアサ王はユダ全国に布告を発した。ひとりも免れる者はなかった。すなわちバアシャがラマを築くために用いた石と材木を運びこさせ、アサ王はそれを用いて、ベニヤミンのゲバとミヅパを築いた。"},{"ref":"1Kgs.15.23","start":11015023,"end":11015023,"break":"none","ruby":[[5,1,"た"],[7,2,"じせき"],[16,2,"くんこう"],[20,1,"かれ"],[28,1,"こと"],[32,1,"かれ"],[34,1,"た"],[37,2,"まちまち"],[44,1,"おう"],[46,3,"れきだいし"],[50,1,"しょ"],[65,1,"かれ"],[67,2,"ろうねん"],[73,1,"あし"],[75,1,"や"]],"text":"アサのその他の事績とそのすべての勲功と、彼がしたすべての事および彼が建てた町々は、ユダの王の歴代志の書にしるされているではないか。彼は老年になって足を病んだ。"},{"ref":"1Kgs.15.24","start":11015024,"end":11015024,"break":"none","ruby":[[5,2,"せんぞ"],[8,1,"とも"],[10,1,"ねむ"],[14,1,"ちち"],[19,1,"まち"],[21,2,"せんぞ"],[24,1,"とも"],[26,1,"ほうむ"],[32,1,"こ"],[39,1,"かわ"],[42,1,"おう"]],"text":"アサはその先祖と共に眠って、父ダビデの町に先祖と共に葬られ、その子ヨシャパテが代って王となった。"},{"ref":"1Kgs.15.25","start":11015025,"end":11015025,"break":"paragraph","ruby":[[3,1,"おう"],[7,1,"だい"],[9,1,"ねん"],[17,1,"こ"],[28,1,"おう"],[35,1,"ねん"],[42,1,"おさ"]],"text":"ユダの王アサの第二年にヤラベアムの子ナダブがイスラエルの王となって、二年イスラエルを治めた。"},{"ref":"1Kgs.15.26","start":11015026,"end":11015026,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[10,1,"おこな"],[15,1,"ちち"],[17,1,"みち"],[19,1,"あゆ"],[22,1,"ちち"],[30,1,"おか"],[34,1,"つみ"]],"text":"彼は主の目の前に悪を行い、その父の道に歩み、父がイスラエルに犯させた罪をおこなった。"},{"ref":"1Kgs.15.27","start":11015027,"end":11015027,"break":"paragraph","ruby":[[6,1,"いえ"],[12,1,"こ"],[18,1,"かれ"],[20,1,"たい"],[27,1,"くわだ"],[37,1,"ぞく"],[45,1,"かれ"],[47,1,"う"],[64,1,"みな"],[70,1,"かこ"]],"text":"イッサカルの家のアヒヤの子バアシャは彼に対してむほんを企て、ペリシテびとに属するギベトンで彼を撃った。これはナダブとイスラエルが皆ギベトンを囲んでいたからである。"},{"ref":"1Kgs.15.28","start":11015028,"end":11015028,"break":"none","ruby":[[7,1,"おう"],[11,1,"だい"],[13,1,"ねん"],[20,1,"かれ"],[22,1,"ころ"],[25,1,"かれ"],[27,1,"かわ"],[30,1,"おう"]],"text":"こうしてユダの王アサの第三年にバアシャは彼を殺し、彼に代って王となった。"},{"ref":"1Kgs.15.29","start":11015029,"end":11015029,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おう"],[15,2,"ぜんか"],[18,1,"う"],[21,1,"いき"],[25,1,"もの"],[37,1,"いえ"],[39,1,"のこ"],[48,1,"ほろ"],[53,1,"しゅ"],[71,1,"い"],[75,2,"ことば"]],"text":"彼は王となるとすぐヤラベアムの全家を撃ち、息のある者をひとりもヤラベアムの家に残さず、ことごとく滅ぼした。主がそのしもべシロびとアヒヤによって言われた言葉のとおりであって、"},{"ref":"1Kgs.15.30","start":11015030,"end":11015030,"break":"none","ruby":[[13,1,"おか"],[24,1,"おか"],[28,1,"つみ"],[35,1,"かれ"],[43,1,"かみ"],[45,1,"しゅ"],[47,1,"いか"],[53,1,"いか"]],"text":"これはヤラベアムがみずから犯し、またイスラエルに犯させた罪のため、また彼がイスラエルの神、主を怒らせたその怒りによるのであった。"},{"ref":"1Kgs.15.31","start":11015031,"end":11015031,"break":"paragraph","ruby":[[6,1,"た"],[8,2,"じせき"],[12,1,"かれ"],[20,1,"こと"],[29,1,"おう"],[31,3,"れきだいし"],[35,1,"しょ"]],"text":"ナダブのその他の事績と、彼がしたすべての事は、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"1Kgs.15.32","start":11015032,"end":11015032,"break":"none","ruby":[[9,1,"おう"],[15,1,"あいだ"],[18,2,"いっしょう"],[21,1,"あいだ"],[22,2,"せんそう"]],"text":"アサとイスラエルの王バアシャの間には一生の間戦争があった。"},{"ref":"1Kgs.15.33","start":11015033,"end":11015033,"break":"paragraph","ruby":[[3,1,"おう"],[7,1,"だい"],[9,1,"ねん"],[15,1,"こ"],[31,1,"ぜん"],[32,1,"ち"],[34,1,"おう"],[43,1,"ねん"],[44,1,"よ"],[46,1,"おさ"]],"text":"ユダの王アサの第三年にアヒヤの子バアシャはテルザでイスラエルの全地の王となって、二十四年世を治めた。"},{"ref":"1Kgs.15.34","start":11015034,"end":11015034,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[10,1,"おこな"],[19,1,"みち"],[21,1,"あゆ"],[36,1,"おか"],[40,1,"つみ"]],"text":"彼は主の目の前に悪を行い、ヤラベアムの道に歩み、ヤラベアムがイスラエルに犯させた罪をおこなった。"}]