[{"ref":"Jer.10.1","start":24010001,"end":24010001,"break":"paragraph","ruby":[[6,1,"いえ"],[9,1,"しゅ"],[17,1,"かた"],[21,2,"ことば"],[24,1,"き"]],"text":"イスラエルの家よ、主のあなたがたに語られる言葉を聞け。"},{"ref":"Jer.10.2","start":24010002,"end":24010002,"break":"none","breaks":[[9,"stanza"],[26,"line"],[47,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[10,2,"いほう"],[13,1,"ひと"],[15,1,"みち"],[17,1,"なら"],[28,2,"いほう"],[31,1,"ひと"],[33,1,"てん"],[35,1,"あらわ"],[42,1,"おそ"],[56,1,"おそ"]],"text":"主はこう言われる、「異邦の人の道に習ってはならない。また異邦の人が天に現れるしるしを恐れても、あなたがたはそれを恐れてはならない。"},{"ref":"Jer.10.3","start":24010003,"end":24010003,"break":"line","breaks":[[18,"line"],[40,"line"]],"ruby":[[0,2,"いほう"],[3,1,"たみ"],[18,1,"かれ"],[21,2,"すうはい"],[29,1,"はやし"],[32,1,"き"],[37,1,"き"],[40,2,"もっこう"],[43,1,"て"],[52,1,"つく"]],"text":"異邦の民のならわしはむなしいからだ。彼らの崇拝するものは、林から切りだした木で、木工の手で、おのをもって造ったものだ。"},{"ref":"Jer.10.4","start":24010004,"end":24010004,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ひとびと"],[3,1,"ぎん"],[5,1,"きん"],[14,1,"かざ"],[20,1,"つち"],[25,1,"うご"]],"text":"人々は銀や金をもって、それを飾り、くぎと鎚をもって動かないようにそれをとめる。"},{"ref":"Jer.10.5","start":24010005,"end":24010005,"break":"line","breaks":[[20,"line"],[33,"line"],[45,"line"],[62,"line"],[74,"line"],[89,"line"]],"ruby":[[2,2,"ぐうぞう"],[10,1,"はたけ"],[23,1,"い"],[33,1,"ある"],[45,1,"ひと"],[47,1,"はこ"],[65,1,"おそ"],[69,1,"およ"],[77,1,"わざわい"],[91,1,"さいわい"],[96,1,"ちから"]],"text":"その偶像は、きゅうり畑のかかしのようで、ものを言うことができない。歩くこともできないから、人に運んでもらわなければならない。それを恐れるに及ばない。それは災をくだすことができず、また幸をくだす力もないからだ」。"},{"ref":"Jer.10.6","start":24010006,"end":24010006,"break":"stanza","breaks":[[19,"line"],[38,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"なら"],[11,1,"もの"],[23,1,"おお"],[27,1,"もの"],[36,1,"な"],[40,1,"ちから"],[45,1,"おお"]],"text":"主よ、あなたに並びうる者はありません。あなたは大いなる者であり、あなたの名もその力のために大いなるものであります。"},{"ref":"Jer.10.7","start":24010007,"end":24010007,"break":"line","breaks":[[12,"line"],[26,"line"],[46,"line"],[64,"line"],[74,"line"]],"ruby":[[0,2,"ばんこく"],[3,1,"おう"],[12,1,"おそ"],[16,1,"もの"],[30,1,"おそ"],[35,2,"とうぜん"],[46,2,"ばんこく"],[53,2,"ちえ"],[57,1,"もの"],[66,2,"くにぐに"],[78,1,"なら"],[82,1,"もの"]],"text":"万国の王であるあなたを、恐れない者がありましょうか。あなたを恐れるのは当然のことであります。万国のすべての知恵ある者のうちにも、その国々のうちにも、あなたに並びうる者はありません。"},{"ref":"Jer.10.8","start":24010008,"end":24010008,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[3,1,"みな"],[5,1,"おろ"],[8,1,"にぶ"],[11,2,"ぐうぞう"],[14,1,"おしえ"],[19,1,"き"]],"text":"彼らは皆、愚かで鈍く、偶像の教は、ただ木にすぎない。"},{"ref":"Jer.10.9","start":24010009,"end":24010009,"break":"line","breaks":[[14,"line"],[27,"line"],[45,"line"],[62,"line"]],"ruby":[[0,1,"ぎん"],[10,2,"とらい"],[14,1,"きん"],[21,1,"たずさ"],[31,2,"こうじん"],[34,1,"きん"],[35,3,"ざいくにん"],[39,2,"こうさく"],[45,1,"かれ"],[48,2,"きもの"],[54,1,"いろ"],[56,2,"むらさきいろ"],[68,1,"たく"],[71,3,"さいくにん"],[75,1,"つく"],[78,1,"もの"]],"text":"銀ぱくはタルシシから渡来し、金はウパズから携えてくる。これらは工人と金細工人の工作である。彼らの着物はすみれ色と紫色である。これらはみな巧みな細工人の作った物である。"},{"ref":"Jer.10.10","start":24010010,"end":24010010,"break":"line","breaks":[[14,"line"],[30,"line"],[46,"line"]],"ruby":[[3,1,"しゅ"],[9,1,"かみ"],[14,1,"い"],[17,1,"かみ"],[22,2,"えいえん"],[25,1,"おう"],[32,1,"いか"],[38,1,"ち"],[40,1,"ふる"],[46,2,"ばんこく"],[51,1,"いきどお"],[54,1,"あた"]],"text":"しかし主はまことの神である。生きた神であり、永遠の王である。その怒りによって地は震いうごき、万国はその憤りに当ることができない。"},{"ref":"Jer.10.11","start":24010011,"end":24010011,"break":"paragraph","ruby":[[6,1,"かれ"],[12,1,"い"],[24,2,"てんち"],[27,1,"つく"],[33,2,"かみがみ"],[36,1,"ち"],[38,1,"うえ"],[40,1,"てん"],[42,1,"した"],[45,1,"ほろ"],[47,1,"さ"]],"text":"あなたがたは彼らに、こう言わなければならない、「天地を造らなかった神々は地の上、天の下から滅び去る」と。"},{"ref":"Jer.10.12","start":24010012,"end":24010012,"break":"stanza","breaks":[[14,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"ちから"],[9,1,"ち"],[11,1,"つく"],[16,2,"ちえ"],[22,2,"せかい"],[25,1,"た"],[30,1,"さと"],[36,1,"てん"]],"text":"主はその力をもって地を造り、その知恵をもって世界を建て、その悟りをもって天をのべられた。"},{"ref":"Jer.10.13","start":24010013,"end":24010013,"break":"line","breaks":[[10,"line"],[25,"line"],[44,"line"],[62,"line"]],"ruby":[[0,1,"かれ"],[2,1,"こえ"],[4,1,"だ"],[10,1,"てん"],[12,1,"おお"],[15,1,"みず"],[27,1,"ち"],[29,1,"はて"],[32,1,"きり"],[34,1,"た"],[44,1,"かれ"],[46,1,"あめ"],[64,1,"くら"],[67,1,"かぜ"],[69,1,"と"],[71,1,"だ"]],"text":"彼が声を出されると、天に多くの水のざわめきがあり、また地の果から霧を立ちあがらせられる。彼は雨のために、いなびかりをおこし、その倉から風を取り出される。"},{"ref":"Jer.10.14","start":24010014,"end":24010014,"break":"line","breaks":[[15,"line"],[24,"line"],[42,"line"],[52,"line"]],"ruby":[[4,1,"ひと"],[6,1,"おろ"],[9,2,"ちえ"],[19,1,"きん"],[20,3,"ざいくにん"],[26,1,"つく"],[29,2,"ぐうぞう"],[35,1,"はじ"],[44,2,"ぐうぞう"],[47,1,"いつわ"],[49,1,"もの"],[57,1,"いき"]],"text":"すべての人は愚かで知恵がなく、すべての金細工人はその造った偶像のために恥をこうむる。その偶像は偽り物で、そのうちに息がないからだ。"},{"ref":"Jer.10.15","start":24010015,"end":24010015,"break":"line","breaks":[[22,"line"]],"ruby":[[13,1,"まよ"],[22,1,"ばっ"],[27,1,"とき"],[29,1,"ほろ"]],"text":"これらは、むなしいもので、迷いのわざである。罰せられる時に滅びるものである。"},{"ref":"Jer.10.16","start":24010016,"end":24010016,"break":"line","breaks":[[22,"line"],[37,"line"],[57,"line"]],"ruby":[[4,1,"ぶん"],[8,1,"かれ"],[22,1,"かれ"],[24,2,"ばんぶつ"],[27,1,"つく"],[29,1,"ぬし"],[43,1,"かれ"],[45,1,"し"],[46,1,"ぎょう"],[51,2,"ぶぞく"],[57,1,"かれ"],[59,1,"な"],[61,2,"ばんぐん"],[64,1,"しゅ"]],"text":"ヤコブの分である彼はこのようなものではない。彼は万物の造り主だからである。イスラエルは彼の嗣業としての部族である。彼の名を万軍の主という。"},{"ref":"Jer.10.17","start":24010017,"end":24010017,"break":"stanza","breaks":[[10,"line"]],"ruby":[[0,1,"かこ"],[3,1,"なか"],[7,1,"もの"],[14,1,"つつみ"],[16,1,"ち"],[19,1,"と"],[21,1,"あ"]],"text":"囲みの中におる者よ、あなたの包を地から取り上げよ。"},{"ref":"Jer.10.18","start":24010018,"end":24010018,"break":"line","breaks":[[12,"line"],[25,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[13,1,"み"],[27,1,"ち"],[29,1,"す"],[31,1,"もの"],[33,1,"な"],[35,1,"す"],[41,1,"かれ"],[52,1,"おも"],[54,1,"し"]],"text":"主がこう言われるからだ、「見よ、わたしはこのたび、この地に住む者を投げ捨てる。かつ彼らをせめなやまして、思い知らせる」。"},{"ref":"Jer.10.19","start":24010019,"end":24010019,"break":"stanza","breaks":[[24,"line"],[33,"line"],[44,"line"],[59,"line"]],"ruby":[[28,1,"きず"],[30,1,"おも"],[40,1,"い"],[53,1,"なや"],[66,1,"しの"]],"text":"わたしはいたでをうけた、ああ、わざわいなるかな、わたしの傷は重い。しかしわたしは言った、「まことに、これは悩みである。わたしはこれを忍ばなければならない」と。"},{"ref":"Jer.10.20","start":24010020,"end":24010020,"break":"line","breaks":[[20,"line"],[44,"line"],[61,"line"]],"ruby":[[4,2,"てんまく"],[7,1,"やぶ"],[10,1,"つな"],[17,1,"き"],[20,1,"こ"],[30,1,"す"],[33,1,"い"],[51,2,"てんまく"],[54,1,"は"],[56,1,"もの"],[61,1,"まく"],[63,1,"か"],[66,1,"もの"]],"text":"わたしの天幕は破れ、綱はことごとく切れ、子どもたちはわたしを捨てて行って、いなくなった。もはやわたしの天幕を張る者はなく、幕を掛ける者もない。"},{"ref":"Jer.10.21","start":24010021,"end":24010021,"break":"line","breaks":[[10,"line"],[26,"line"],[42,"line"]],"ruby":[[0,2,"ぼくしゃ"],[3,1,"おろ"],[10,1,"しゅ"],[12,1,"と"],[30,1,"かれ"],[33,1,"さか"],[44,1,"む"],[49,1,"ち"],[51,1,"さ"]],"text":"牧者は愚かであって、主に問うことをしないからである。それゆえ彼らは栄えることもなく、その群れはみな散り去っている。"},{"ref":"Jer.10.22","start":24010022,"end":24010022,"break":"stanza","breaks":[[13,"line"],[31,"line"]],"ruby":[[0,1,"き"],[13,1,"み"],[16,1,"きた"],[18,1,"くに"],[21,1,"おお"],[25,1,"さわ"],[28,1,"く"],[37,2,"まちまち"],[40,1,"あら"],[43,2,"やまいぬ"],[46,1,"す"]],"text":"聞けよ、うわさのあるのを。見よ、北の国から大いなる騒ぎが来る。これはユダの町々を荒して山犬の巣とする。"},{"ref":"Jer.10.23","start":24010023,"end":24010023,"break":"stanza","breaks":[[14,"line"],[29,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"し"],[14,1,"ひと"],[16,1,"みち"],[18,2,"じしん"],[29,1,"あゆ"],[31,1,"ひと"],[36,1,"あゆ"],[39,2,"じぶん"],[42,1,"き"]],"text":"主よ、わたしは知っています、人の道は自身によるのではなく、歩む人が、その歩みを自分で決めることのできないことを。"},{"ref":"Jer.10.24","start":24010024,"end":24010024,"break":"line","breaks":[[16,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"こ"],[16,1,"ただ"],[19,1,"みち"],[27,1,"いか"],[31,1,"こ"],[50,1,"む"],[52,1,"き"]],"text":"主よ、わたしを懲らしてください。正しい道にしたがって、怒らずに懲らしてください。さもないと、わたしは無に帰してしまうでしょう。"},{"ref":"Jer.10.25","start":24010025,"end":24010025,"break":"stanza","breaks":[[12,"line"],[26,"line"],[41,"line"],[52,"line"],[64,"line"]],"ruby":[[4,1,"し"],[8,2,"くにたみ"],[16,1,"な"],[23,2,"ひとびと"],[30,1,"いか"],[33,1,"そそ"],[41,1,"かれ"],[48,1,"く"],[50,1,"つく"],[55,1,"く"],[57,1,"つく"],[60,1,"ほろ"],[70,1,"あら"]],"text":"あなたを知らない国民と、あなたの名をとなえない人々にあなたの怒りを注いでください。彼らはヤコブを食い尽しこれを食い尽して滅ぼし、そのすみかを荒したからです。"}]