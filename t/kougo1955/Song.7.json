[{"ref":"Song.7.1","start":22007001,"end":22007001,"break":"paragraph","breaks":[[9,"line"],[25,"line"],[38,"line"],[58,"line"]],"ruby":[[0,2,"じょおう"],[6,1,"むすめ"],[13,1,"あし"],[19,1,"なか"],[28,1,"うるわ"],[52,1,"たま"],[58,2,"めいじん"],[61,1,"て"]],"text":"女王のような娘よ、あなたの足は、くつの中にあって、なんと麗しいことであろう。あなたのももは、まろやかで、玉のごとく、名人の手のわざのようだ。"},{"ref":"Song.7.2","start":22007002,"end":22007002,"break":"line","breaks":[[8,"line"],[31,"line"],[38,"line"]],"ruby":[[8,1,"ま"],[14,1,"しゅ"],[16,1,"か"],[23,1,"まる"],[25,1,"さかずき"],[35,1,"はら"],[41,1,"はな"],[43,1,"かこ"],[47,2,"やまも"],[51,1,"むぎ"]],"text":"あなたのほぞは、混ぜたぶどう酒を欠くことのない丸い杯のごとく、あなたの腹は、ゆりの花で囲まれた山盛りの麦のようだ。"},{"ref":"Song.7.3","start":22007003,"end":22007003,"break":"line","breaks":[[10,"line"]],"ruby":[[4,1,"りょう"],[5,1,"ち"],[15,2,"ふたご"],[21,1,"ひき"],[23,1,"こ"]],"text":"あなたの両乳ぶさは、かもしかの二子である二匹の子じかのようだ。"},{"ref":"Song.7.4","start":22007004,"end":22007004,"break":"line","breaks":[[17,"line"],[38,"line"],[49,"line"],[65,"line"]],"ruby":[[4,1,"くび"],[6,2,"ぞうげ"],[21,1,"め"],[30,1,"もん"],[43,1,"いけ"],[53,1,"はな"],[61,1,"み"]],"text":"あなたの首は象牙のやぐらのごとく、あなたの目は、バテラビムの門のほとりにあるヘシボンの池のごとく、あなたの鼻は、ダマスコを見おろすレバノンのやぐらのようだ。"},{"ref":"Song.7.5","start":22007005,"end":22007005,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"あたま"],[19,1,"かざ"],[22,1,"かみ"],[24,1,"け"],[26,2,"むらさきいろ"],[33,1,"おう"],[39,1,"かみ"],[41,1,"とら"]],"text":"あなたの頭は、カルメルのようにあなたを飾り、髪の毛は紫色のようで、王はそのたれ髪に捕われた。"},{"ref":"Song.7.6","start":22007006,"end":22007006,"break":"stanza","breaks":[[14,"line"]],"ruby":[[0,1,"あい"],[3,1,"もの"],[6,2,"かいかつ"],[21,1,"うつく"],[24,1,"あい"],[28,1,"もの"]],"text":"愛する者よ、快活なおとめよ、あなたはなんと美しく愛すべき者であろう。"},{"ref":"Song.7.7","start":22007007,"end":22007007,"break":"line","breaks":[[21,"line"]],"ruby":[[10,1,"き"],[15,2,"いげん"],[25,1,"ち"]],"text":"あなたはなつめやしの木のように威厳があり、あなたの乳ぶさはそのふさのようだ。"},{"ref":"Song.7.8","start":22007008,"end":22007008,"break":"line","breaks":[[22,"line"],[32,"line"],[56,"line"]],"ruby":[[4,1,"い"],[16,1,"き"],[24,1,"えだ"],[26,1,"と"],[40,1,"ち"],[60,1,"いき"]],"text":"わたしは言う、「このなつめやしの木にのぼり、その枝に取りつこう。どうか、あなたの乳ぶさが、ぶどうのふさのごとく、あなたの息のにおいがりんごのごとく、"},{"ref":"Song.7.9","start":22007009,"end":22007009,"break":"line","breaks":[[9,"line"],[29,"line"]],"ruby":[[4,1,"くち"],[14,1,"なが"],[16,1,"くだ"],[18,1,"よ"],[23,1,"しゅ"],[34,1,"は"],[36,1,"うえ"]],"text":"あなたの口づけが、なめらかに流れ下る良きぶどう酒のごとく、くちびると歯の上をすべるように」と。"},{"ref":"Song.7.10","start":22007010,"end":22007010,"break":"stanza","ruby":[[6,1,"あい"],[9,1,"ひと"],[14,1,"かれ"],[20,1,"こい"],[22,1,"した"]],"text":"わたしはわが愛する人のもの、彼はわたしを恋い慕う。"},{"ref":"Song.7.11","start":22007011,"end":22007011,"break":"line","breaks":[[8,"line"],[27,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[21,1,"で"],[27,2,"むらざと"],[30,1,"やど"]],"text":"わが愛する者よ、さあ、わたしたちはいなかへ出ていって、村里に宿りましょう。"},{"ref":"Song.7.12","start":22007012,"end":22007012,"break":"line","breaks":[[20,"line"],[43,"line"],[59,"line"]],"ruby":[[6,1,"はや"],[8,1,"お"],[14,1,"えん"],[16,1,"い"],[24,1,"き"],[26,1,"め"],[36,1,"はな"],[38,1,"さ"],[47,1,"はな"],[48,1,"さ"],[53,1,"み"],[61,1,"ところ"],[70,1,"あい"],[76,1,"あた"]],"text":"わたしたちは早く起き、ぶどう園へ行って、ぶどうの木が芽ざしたか、ぶどうの花が咲いたか、ざくろが花咲いたかを見ましょう。その所で、わたしはわが愛をあなたに与えます。"},{"ref":"Song.7.13","start":22007013,"end":22007013,"break":"line","breaks":[[12,"line"],[25,"line"],[34,"line"],[49,"line"],[57,"line"]],"ruby":[[0,1,"こい"],[9,1,"はな"],[17,1,"よ"],[25,1,"あたら"],[30,1,"ふる"],[34,1,"とも"],[42,1,"と"],[44,1,"うえ"],[51,1,"あい"],[54,1,"もの"]],"text":"恋なすは、かおりを放ち、もろもろの良きくだものは、新しいのも古いのも共にわたしたちの戸の上にある。わが愛する者よ、わたしはこれをあなたのためにたくわえました。"}]