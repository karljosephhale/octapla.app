[{"ref":"Ps.49.1","start":19049001,"end":19049001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたコラの子の歌","breaks":[[14,"line"]],"ruby":[[5,1,"たみ"],[11,1,"き"],[17,1,"よ"],[19,1,"す"],[21,1,"もの"],[24,1,"みみ"],[26,1,"かたむ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[19,1,"こ"],[21,1,"うた"]],"text":"もろもろの民よ、これを聞け、すべて世に住む者よ、耳を傾けよ。"},{"ref":"Ps.49.2","start":19049002,"end":19049002,"break":"line","ruby":[[0,1,"てい"],[3,1,"たか"],[7,1,"と"],[11,1,"まず"],[16,1,"とも"],[18,1,"みみ"],[20,1,"かたむ"]],"text":"低きも高きも、富めるも貧しきも、共に耳を傾けよ。"},{"ref":"Ps.49.3","start":19049003,"end":19049003,"break":"line","ruby":[[2,1,"くち"],[4,2,"ちえ"],[7,1,"かた"],[12,1,"こころ"],[14,2,"ちしき"],[17,1,"おも"]],"text":"わが口は知恵を語り、わが心は知識を思う。"},{"ref":"Ps.49.4","start":19049004,"end":19049004,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"みみ"],[10,1,"かたむ"],[13,1,"こと"],[15,1,"な"],[27,1,"と"],[29,1,"あ"]],"text":"わたしは耳をたとえに傾け、琴を鳴らして、わたしのなぞを解き明かそう。"},{"ref":"Ps.49.5","start":19049005,"end":19049005,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[9,1,"もの"],[11,2,"ふぎ"],[18,1,"と"],[20,1,"かこ"],[22,1,"なや"],[25,1,"ひ"],[32,1,"おそ"]],"text":"わたしをしえたげる者の不義がわたしを取り囲む悩みの日に、どうして恐れなければならないのか。"},{"ref":"Ps.49.6","start":19049006,"end":19049006,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[6,1,"とみ"],[18,1,"おお"],[22,1,"ほこ"],[24,2,"ひとびと"]],"text":"彼らはおのが富をたのみ、そのたからの多いのを誇る人々である。"},{"ref":"Ps.49.7","start":19049007,"end":19049007,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"ひと"],[9,2,"じぶん"],[30,1,"あたい"],[32,1,"かみ"],[34,1,"はら"]],"text":"まことに人はだれも自分をあがなうことはできない。そのいのちの価を神に払うことはできない。"},{"ref":"Ps.49.8","start":19049008,"end":19049009,"break":"line","breaks":[[21,"line"],[43,"line"]],"ruby":[[5,1,"い"],[13,1,"はか"],[15,1,"み"],[38,1,"あたい"],[39,1,"たか"],[46,2,"まんぞく"],[49,1,"はら"]],"text":"とこしえに生きながらえて、墓を見ないためにそのいのちをあがなうには、あまりに価高くて、それを満足に払うことができないからである。"},{"ref":"Ps.49.10","start":19049010,"end":19049010,"break":"line","breaks":[[11,"line"],[33,"line"]],"ruby":[[4,1,"かしこ"],[6,1,"ひと"],[8,1,"し"],[11,1,"おろ"],[14,1,"もの"],[17,1,"けもの"],[22,1,"もの"],[29,1,"ほろ"],[35,1,"とみ"],[37,2,"たにん"],[40,1,"のこ"],[45,1,"ひと"],[47,1,"み"]],"text":"まことに賢い人も死に、愚かな者も、獣のような者も、ひとしく滅んで、その富を他人に残すことは人の見るところである。"},{"ref":"Ps.49.11","start":19049011,"end":19049011,"break":"line","breaks":[[23,"line"],[38,"line"]],"ruby":[[3,1,"かれ"],[8,1,"ち"],[10,2,"じぶん"],[13,1,"な"],[18,1,"よ"],[23,1,"はか"],[26,1,"かれ"],[38,2,"よよ"],[40,1,"かれ"]],"text":"たとい彼らはその地を自分の名をもって呼んでも、墓こそ彼らのとこしえのすまい、世々彼らのすみかである。"},{"ref":"Ps.49.12","start":19049012,"end":19049012,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ひと"],[2,2,"えいが"],[8,1,"なが"],[22,1,"ほろ"],[27,1,"けもの"]],"text":"人は栄華のうちに長くとどまることはできない、滅びうせる獣にひとしい。"},{"ref":"Ps.49.13","start":19049013,"end":19049013,"break":"line","breaks":[[21,"line"]],"ruby":[[3,2,"じぶん"],[9,1,"おろ"],[12,1,"もの"],[16,1,"な"],[21,2,"じぶん"],[24,1,"わ"],[26,1,"まえ"],[28,1,"よろこ"],[30,1,"もの"],[34,1,"はて"]],"text":"これぞ自分をたのむ愚かな者どもの成りゆき、自分の分け前を喜ぶ者どもの果である。〔セラ"},{"ref":"Ps.49.14","start":19049014,"end":19049014,"break":"line","breaks":[[16,"line"],[29,"line"],[53,"line"]],"ruby":[[0,1,"かれ"],[3,2,"よみ"],[6,1,"さだ"],[11,1,"ひつじ"],[16,1,"し"],[18,1,"かれ"],[21,1,"ぼく"],[29,1,"かれ"],[37,1,"はか"],[39,1,"くだ"],[48,1,"き"],[53,2,"よみ"],[56,1,"かれ"]],"text":"彼らは陰府に定められた羊のように死が彼らを牧するであろう。彼らはまっすぐに墓に下り、そのかたちは消えうせ、陰府が彼らのすまいとなるであろう。"},{"ref":"Ps.49.15","start":19049015,"end":19049015,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"かみ"],[9,1,"う"],[21,1,"たましい"],[23,2,"よみ"],[26,1,"ちから"]],"text":"しかし神はわたしを受けられるゆえ、わたしの魂を陰府の力からあがなわれる。〔セラ"},{"ref":"Ps.49.16","start":19049016,"end":19049016,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"ひと"],[2,1,"とみ"],[4,1,"え"],[12,1,"いえ"],[14,1,"さか"],[17,1,"ま"],[19,1,"くわ"],[26,1,"おそ"]],"text":"人が富を得るときも、その家の栄えが増し加わるときも、恐れてはならない。"},{"ref":"Ps.49.17","start":19049017,"end":19049017,"break":"line","breaks":[[22,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[2,1,"し"],[7,1,"なに"],[11,1,"たずさ"],[13,1,"い"],[24,1,"さか"],[27,1,"かれ"],[29,1,"したが"],[32,1,"くだ"],[35,1,"い"]],"text":"彼が死ぬときは何ひとつ携え行くことができず、その栄えも彼に従って下って行くことはないからである。"},{"ref":"Ps.49.18","start":19049018,"end":19049018,"break":"line","breaks":[[25,"line"]],"ruby":[[3,1,"かれ"],[5,1,"い"],[12,1,"あいだ"],[14,2,"じぶん"],[17,2,"こうふく"],[20,1,"おも"],[31,1,"さいわい"],[33,1,"とき"],[36,2,"ひとびと"],[40,2,"しょうさん"]],"text":"たとい彼が生きながらえる間、自分を幸福と思っても、またみずから幸な時に、人々から称賛されても、"},{"ref":"Ps.49.19","start":19049019,"end":19049019,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[9,2,"せんぞ"],[12,2,"なかま"],[15,1,"つら"],[19,1,"かれ"],[22,1,"た"],[25,1,"ひかり"],[27,1,"み"]],"text":"彼はついにおのれの先祖の仲間に連なる。彼らは絶えて光を見ることがない。"},{"ref":"Ps.49.20","start":19049020,"end":19049020,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ひと"],[2,2,"えいが"],[8,1,"なが"],[22,1,"ほろ"],[27,1,"けもの"]],"text":"人は栄華のうちに長くとどまることはできない。滅びうせる獣にひとしい。"}]