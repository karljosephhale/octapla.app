[{"ref":"Jer.3.1","start":24003001,"end":24003001,"break":"paragraph","breaks":[[12,"line"],[33,"line"],[52,"line"],[69,"line"],[86,"line"]],"ruby":[[2,1,"ひと"],[6,1,"つま"],[8,2,"りこん"],[12,1,"おんな"],[14,1,"かれ"],[19,1,"さ"],[23,2,"たにん"],[26,1,"つま"],[35,1,"ひと"],[41,2,"かのじょ"],[44,1,"かえ"],[54,1,"ち"],[56,1,"おお"],[59,1,"けが"],[73,1,"おお"],[76,2,"こいびと"],[79,2,"かんいん"],[82,1,"おこな"],[93,1,"かえ"],[103,1,"しゅ"],[105,1,"い"]],"text":"もし人がその妻を離婚し、女が彼のもとを去って、他人の妻となるなら、その人はふたたび彼女に帰るであろうか。その地は大いに汚れないであろうか。あなたは多くの恋人と姦淫を行った。しかもわたしに帰ろうというのか」と主は言われる。"},{"ref":"Jer.3.2","start":24003002,"end":24003002,"break":"line","breaks":[[18,"line"],[36,"line"],[54,"line"],[75,"line"]],"ruby":[[1,1,"め"],[11,1,"はだか"],[13,1,"やま"],[15,1,"み"],[18,2,"かんいん"],[21,1,"おこな"],[27,1,"ところ"],[36,2,"あらの"],[58,1,"みち"],[65,1,"ざ"],[68,2,"こいびと"],[71,1,"ま"],[79,2,"かんいん"],[82,2,"あくじ"],[91,1,"ち"],[93,1,"けが"]],"text":"「目をあげてもろもろの裸の山を見よ、姦淫を行わなかった所がどこにあるか。荒野にいるアラビヤびとがするように、あなたは道のかたわらに座して恋人を待った。あなたは姦淫の悪事をもって、この地を汚した。"},{"ref":"Jer.3.3","start":24003003,"end":24003003,"break":"line","breaks":[[23,"line"],[39,"line"]],"ruby":[[4,1,"あめ"],[12,1,"はる"],[14,1,"あめ"],[16,1,"ふ"],[31,2,"ゆうじょ"],[34,1,"ひたい"],[39,1,"すこ"],[42,1,"は"]],"text":"それゆえ雨はとどめられ、春の雨は降らなかった。しかもあなたには遊女の額があり、少しも恥じようとはしない。"},{"ref":"Jer.3.4","start":24003004,"end":24003004,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"いま"],[10,1,"よ"],[13,1,"い"],[25,1,"ちち"],[36,1,"わか"],[38,1,"とき"],[40,1,"とも"]],"text":"今あなたは、わたしを呼んで言ったではないか、『わが父よ、あなたはわたしの若い時の友です。"},{"ref":"Jer.3.5","start":24003005,"end":24003005,"break":"line","breaks":[[12,"line"],[27,"line"],[44,"line"]],"ruby":[[0,2,"えいきゅう"],[3,1,"いか"],[12,1,"おわ"],[16,1,"いきどお"],[27,1,"み"],[36,1,"い"],[57,1,"あく"],[59,1,"おこな"]],"text":"永久に怒られるのですか、終りまで憤られるのですか』と。見よ、あなたはこう言ったけれども、なしうるかぎりのもろもろの悪を行った」。"},{"ref":"Jer.3.6","start":24003006,"end":24003006,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"とき"],[7,1,"しゅ"],[15,1,"い"],[28,2,"はいしん"],[42,1,"み"],[46,2,"かのじょ"],[53,1,"たか"],[55,1,"おか"],[65,1,"あお"],[66,1,"き"],[68,1,"した"],[70,1,"い"],[77,2,"かんいん"],[80,1,"おこな"]],"text":"ヨシヤ王の時、主はまたわたしに言われた、「あなたは、かの背信のイスラエルがしたことを見たか。彼女はすべての高い丘にのぼり、すべての青木の下に行って、そこで姦淫を行った。"},{"ref":"Jer.3.7","start":24003007,"end":24003007,"break":"none","ruby":[[5,2,"かのじょ"],[14,1,"おこな"],[17,1,"のち"],[23,1,"ところ"],[25,1,"かえ"],[32,1,"おも"],[37,1,"かえ"],[48,2,"ふしん"],[51,2,"しまい"],[59,1,"み"]],"text":"わたしは、彼女がこのすべてを行った後、わたしの所に帰るであろうと思ったが、帰ってこなかった。その不信の姉妹ユダはこれを見た。"},{"ref":"Jer.3.8","start":24003008,"end":24003008,"break":"none","ruby":[[4,2,"はいしん"],[20,2,"かんいん"],[27,2,"りえん"],[29,1,"じょう"],[31,1,"あた"],[34,1,"だ"],[42,1,"み"],[50,2,"ふしん"],[53,2,"しまい"],[58,1,"おそ"],[62,2,"じぶん"],[65,1,"い"],[68,2,"かんいん"],[71,1,"おこな"]],"text":"わたしが背信のイスラエルを、そのすべての姦淫のゆえに、離縁状を与えて出したのをユダは見た。しかもその不信の姉妹ユダは恐れず、自分も行って姦淫を行った。"},{"ref":"Jer.3.9","start":24003009,"end":24003009,"break":"none","ruby":[[0,2,"かのじょ"],[6,2,"かんいん"],[9,1,"かる"],[20,1,"いし"],[22,1,"き"],[25,2,"かんいん"],[28,1,"い"],[34,1,"ち"],[36,1,"けが"]],"text":"彼女にとって姦淫は軽いことであったので、石と木とに姦淫を行って、この地を汚した。"},{"ref":"Jer.3.10","start":24003010,"end":24003010,"break":"none","ruby":[[6,1,"こと"],[17,2,"ふしん"],[20,2,"しまい"],[25,2,"まごころ"],[35,1,"かえ"],[42,1,"いつわ"],[52,1,"しゅ"],[54,1,"い"]],"text":"このすべての事があっても、なおその不信の姉妹ユダは真心をもってわたしに帰らない、ただ偽っているだけだ」と主は言われる。"},{"ref":"Jer.3.11","start":24003011,"end":24003011,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[14,2,"はいしん"],[23,2,"ふしん"],[31,2,"じぶん"],[34,1,"つみ"],[36,1,"すく"],[42,1,"しめ"]],"text":"主はまたわたしに言われた、「背信のイスラエルは不信のユダよりも自分の罪の少ないことを示した。"},{"ref":"Jer.3.12","start":24003012,"end":24003012,"break":"none","breaks":[[27,"stanza"],[48,"line"],[68,"line"],[84,"line"]],"ruby":[[4,1,"い"],[7,1,"きた"],[15,2,"ことば"],[21,1,"い"],[28,1,"しゅ"],[30,1,"い"],[35,2,"はいしん"],[45,1,"かえ"],[52,1,"いか"],[55,1,"かお"],[63,1,"む"],[77,1,"ふか"],[79,1,"もの"],[89,1,"いか"],[99,1,"しゅ"],[101,1,"い"]],"text":"あなたは行って北にむかい、この言葉をのべて言うがよい、『主は言われる、背信のイスラエルよ、帰れ。わたしは怒りの顔をあなたがたに向けない、わたしはいつくしみ深い者である。いつまでも怒ることはしないと、主は言われる。"},{"ref":"Jer.3.13","start":24003013,"end":24003013,"break":"line","breaks":[[14,"line"],[26,"line"],[41,"line"],[57,"line"],[74,"line"]],"ruby":[[6,2,"じぶん"],[9,1,"つみ"],[11,1,"みと"],[18,1,"かみ"],[20,1,"しゅ"],[30,1,"あお"],[31,1,"き"],[33,1,"した"],[35,1,"こと"],[38,2,"かみがみ"],[45,1,"あい"],[47,1,"お"],[51,1,"あた"],[61,1,"こえ"],[63,1,"き"],[65,1,"したが"],[74,1,"い"],[82,1,"しゅ"],[84,1,"い"]],"text":"ただあなたは自分の罪を認め、あなたの神、主にそむいてすべての青木の下で異なる神々にあなたの愛を惜しまず与えたこと、わたしの声に聞き従わなかったことを言いあらわせと、主は言われる。"},{"ref":"Jer.3.14","start":24003014,"end":24003014,"break":"line","breaks":[[17,"line"],[35,"line"],[54,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[7,2,"はいしん"],[10,1,"こ"],[14,1,"かえ"],[27,1,"おっと"],[35,1,"まち"],[42,2,"しぞく"],[50,1,"と"],[64,1,"つ"],[67,1,"い"]],"text":"主は言われる、背信の子らよ、帰れ。わたしはあなたがたの夫だからである。町からひとり、氏族からふたりを取って、あなたがたをシオンへ連れて行こう。"},{"ref":"Jer.3.15","start":24003015,"end":24003015,"break":"paragraph","ruby":[[4,2,"じぶん"],[7,1,"こころ"],[12,2,"ぼくしゃ"],[23,1,"あた"],[27,1,"かれ"],[30,2,"ちしき"],[33,1,"さと"],[46,1,"やしな"]],"text":"わたしは自分の心にかなう牧者たちをあなたがたに与える。彼らは知識と悟りとをもってあなたがたを養う。"},{"ref":"Jer.3.16","start":24003016,"end":24003016,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[13,1,"ち"],[15,1,"ま"],[18,1,"おお"],[27,1,"ひ"],[31,2,"ひとびと"],[39,1,"しゅ"],[41,2,"けいやく"],[44,1,"はこ"],[47,1,"い"],[54,1,"おも"],[56,1,"だ"],[63,1,"おぼ"],[70,1,"たず"],[77,1,"つく"]],"text":"主は言われる、あなたがたが地に増して多くなるとき、その日には、人々はかさねて「主の契約の箱」と言わず、これを思い出さず、これを覚えず、これを尋ねず、これを作らない。"},{"ref":"Jer.3.17","start":24003017,"end":24003017,"break":"none","ruby":[[10,1,"しゅ"],[13,1,"くらい"],[21,2,"ばんこく"],[24,1,"たみ"],[29,1,"あつ"],[37,1,"しゅ"],[39,1,"な"],[50,1,"あつ"],[64,2,"じぶん"],[67,1,"わる"],[69,1,"こころ"],[71,1,"したが"]],"text":"そのときエルサレムは主のみ位ととなえられ、万国の民はここに集まる。すなわち主の名のもとにエルサレムに集まり、かさねて、かたくなに自分の悪い心に従うことはしない。"},{"ref":"Jer.3.18","start":24003018,"end":24003018,"break":"none","ruby":[[2,1,"ひ"],[9,1,"いえ"],[17,1,"いえ"],[19,2,"いっしょ"],[25,1,"きた"],[27,1,"ち"],[30,1,"で"],[43,2,"せんぞ"],[48,1,"し"],[49,1,"ぎょう"],[53,1,"あた"],[56,1,"ち"],[58,1,"とも"],[60,1,"く"]],"text":"その日には、ユダの家はイスラエルの家と一緒になり、北の地から出て、わたしがあなたがたの先祖たちに嗣業として与えた地に共に来る。"},{"ref":"Jer.3.19","start":24003019,"end":24003019,"break":"stanza","breaks":[[8,"line"],[28,"line"],[48,"line"],[69,"line"],[93,"line"]],"ruby":[[16,1,"こ"],[25,1,"お"],[28,2,"ばんこく"],[34,1,"もっと"],[36,1,"うつく"],[39,1,"し"],[40,1,"ぎょう"],[44,1,"よ"],[46,1,"ち"],[52,1,"あた"],[63,1,"おも"],[87,1,"ちち"],[90,1,"よ"],[97,1,"したが"],[100,1,"はな"],[109,1,"おも"]],"text":"どのようにして、あなたをわたしの子どもたちのうちに置き、万国のうちで最も美しい嗣業である良い地をあなたに与えようかと、わたしは思っていた。わたしはまた、あなたがわたしを「わが父」と呼び、わたしに従って離れることはないと思っていた。"},{"ref":"Jer.3.20","start":24003020,"end":24003020,"break":"line","breaks":[[9,"line"],[25,"line"],[46,"line"]],"ruby":[[6,1,"いえ"],[9,2,"はいしん"],[12,1,"つま"],[14,1,"おっと"],[19,1,"さ"],[46,1,"しゅ"],[48,1,"い"]],"text":"イスラエルの家よ、背信の妻が夫のもとを去るように、たしかに、あなたがたはわたしにそむいた』と主は言われる」。"},{"ref":"Jer.3.21","start":24003021,"end":24003021,"break":"stanza","breaks":[[12,"line"],[30,"line"]],"ruby":[[0,1,"はだか"],[2,1,"やま"],[4,1,"うえ"],[6,1,"こえ"],[8,1,"きこ"],[18,1,"たみ"],[20,1,"かな"],[23,1,"いの"],[30,1,"かれ"],[33,1,"まが"],[36,1,"みち"],[38,1,"あゆ"],[43,1,"かみ"],[45,1,"しゅ"],[47,1,"わす"]],"text":"裸の山の上に声が聞える、イスラエルの民が悲しみ祈るのである。彼らが曲った道に歩み、その神、主を忘れたからだ。"},{"ref":"Jer.3.22","start":24003022,"end":24003022,"break":"line","breaks":[[14,"line"],[32,"stanza"],[53,"line"]],"ruby":[[1,2,"はいしん"],[4,1,"こ"],[11,1,"かえ"],[24,2,"はいしん"],[33,1,"み"],[48,1,"かえ"],[62,1,"かみ"],[64,1,"しゅ"]],"text":"「背信の子どもたちよ、帰れ。わたしはあなたがたの背信をいやす」。「見よ、われわれはあなたのもとに帰ります。あなたはわれわれの神、主であらせられます。"},{"ref":"Jer.3.23","start":24003023,"end":24003023,"break":"line","breaks":[[18,"line"],[30,"line"],[43,"line"]],"ruby":[[10,1,"おか"],[12,1,"まよ"],[18,1,"やま"],[20,1,"うえ"],[22,1,"さわ"],[25,1,"おな"],[41,1,"すくい"],[48,1,"かみ"],[50,1,"しゅ"]],"text":"まことに、もろもろの丘は迷いであり、山の上の騒ぎも同じです。まことに、イスラエルの救はわれわれの神、主にあるのです。"},{"ref":"Jer.3.24","start":24003024,"end":24003024,"break":"paragraph","ruby":[[9,2,"ようしょう"],[12,1,"とき"],[16,1,"は"],[29,2,"せんぞ"],[37,1,"え"],[48,1,"ひつじ"],[52,1,"うし"],[63,1,"むすめ"],[74,1,"つく"]],"text":"しかし、われわれの幼少の時から、恥ずべきことが、われわれの先祖のほねおって得たもの、すなわちその羊、その牛、およびそのむすこ、娘たちをことごとくのみ尽しました。"},{"ref":"Jer.3.25","start":24003025,"end":24003025,"break":"none","ruby":[[5,1,"はじ"],[7,1,"なか"],[9,1,"ふ"],[35,2,"せんぞ"],[45,2,"ようしょう"],[48,1,"とき"],[51,2,"こんにち"],[61,1,"かみ"],[63,1,"しゅ"],[65,1,"つみ"],[67,1,"おか"],[75,1,"かみ"],[77,1,"しゅ"],[79,1,"こえ"],[81,1,"したが"]],"text":"われわれは恥の中に伏し、はずかしめにおおわれています。それはわれわれと先祖とが、われわれの幼少の時から今日まで、われわれの神、主に罪を犯し、われわれの神、主の声に従わなかったからです」。"}]