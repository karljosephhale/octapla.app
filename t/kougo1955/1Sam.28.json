[{"ref":"1Sam.28.1","start":9028001,"end":9028001,"break":"paragraph","ruby":[[18,1,"たたか"],[32,2,"ぐんぜい"],[35,1,"あつ"],[49,1,"い"],[62,2,"しょうち"],[79,2,"じゅうしゃ"],[90,1,"とも"],[92,1,"で"],[95,2,"ぐんぜい"],[98,1,"くわ"]],"text":"そのころ、ペリシテびとがイスラエルと戦おうとして、いくさのために軍勢を集めたので、アキシはダビデに言った、「あなたは、しかと承知してください。あなたとあなたの従者たちとは、わたしと共に出て、軍勢に加わらなければなりません」。"},{"ref":"1Sam.28.2","start":9028002,"end":9028002,"break":"none","ruby":[[8,1,"い"],[26,1,"なに"],[32,1,"し"],[50,1,"い"],[64,2,"しゅうしん"],[70,2,"ごえい"],[73,1,"ちょう"]],"text":"ダビデはアキシに言った、「よろしい、あなたはしもべが何をするかを知られるでしょう」。アキシはダビデに言った、「よろしい、あなたを終身わたしの護衛の長としよう」。"},{"ref":"1Sam.28.3","start":9028003,"end":9028003,"break":"paragraph","ruby":[[10,1,"し"],[24,1,"ひと"],[26,1,"かれ"],[31,1,"かな"],[37,1,"まち"],[41,1,"ほうむ"],[47,1,"さき"],[53,2,"くちよ"],[57,1,"うらな"],[59,1,"し"],[63,1,"ち"],[66,2,"ついほう"]],"text":"さてサムエルはすでに死んで、イスラエルのすべての人は彼のために悲しみ、その町ラマに葬った。また先にサウルは口寄せや占い師をその地から追放した。"},{"ref":"1Sam.28.4","start":9028004,"end":9028004,"break":"none","ruby":[[7,1,"あつ"],[18,1,"じん"],[20,1,"と"],[40,1,"ひと"],[42,1,"あつ"],[51,1,"じん"],[53,1,"と"]],"text":"ペリシテびとが集まってきてシュネムに陣を取ったので、サウルはイスラエルのすべての人を集めて、ギルボアに陣を取った。"},{"ref":"1Sam.28.5","start":9028005,"end":9028005,"break":"none","ruby":[[11,2,"ぐんぜい"],[14,1,"み"],[16,1,"おそ"],[21,1,"こころ"]],"text":"サウルはペリシテびとの軍勢を見て恐れ、その心はいたくおののいた。"},{"ref":"1Sam.28.6","start":9028006,"end":9028006,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"うかが"],[17,1,"しゅ"],[19,1,"ゆめ"],[35,3,"よげんしゃ"],[43,1,"かれ"],[45,1,"こた"]],"text":"そこでサウルは主に伺いをたてたが、主は夢によっても、ウリムによっても、預言者によっても彼に答えられなかった。"},{"ref":"1Sam.28.7","start":9028007,"end":9028007,"break":"none","ruby":[[10,1,"い"],[23,2,"くちよ"],[27,1,"おんな"],[29,1,"さが"],[31,1,"だ"],[41,1,"い"],[46,1,"おんな"],[48,1,"たず"],[60,1,"かれ"],[62,1,"い"],[67,1,"み"],[79,2,"くちよ"]],"text":"サウルはしもべたちに言った、「わたしのために、口寄せの女を捜し出しなさい。わたしは行ってその女に尋ねよう」。しもべたちは彼に言った、「見よ、エンドルにひとりの口寄せがいます」。"},{"ref":"1Sam.28.8","start":9028008,"end":9028008,"break":"paragraph","ruby":[[4,1,"すがた"],[6,1,"か"],[12,2,"きもの"],[23,2,"じゅうしゃ"],[26,1,"ともな"],[29,1,"い"],[32,1,"よる"],[34,1,"あいだ"],[39,1,"おんな"],[41,1,"ところ"],[53,1,"い"],[65,2,"くちよ"],[69,1,"じゅつ"],[71,1,"い"],[83,1,"つ"],[86,1,"ひと"],[88,1,"よ"],[90,1,"おこ"]],"text":"サウルは姿を変えてほかの着物をまとい、ふたりの従者を伴って行き、夜の間に、その女の所にきた。そしてサウルは言った、「わたしのために口寄せの術を行って、わたしがあなたに告げる人を呼び起してください」。"},{"ref":"1Sam.28.9","start":9028009,"end":9028009,"break":"none","ruby":[[0,1,"おんな"],[2,1,"かれ"],[4,1,"い"],[31,1,"かれ"],[33,2,"くちよ"],[37,1,"うらな"],[39,1,"し"],[43,1,"くに"],[46,1,"た"],[48,1,"ほろ"],[68,1,"いのち"],[81,1,"し"]],"text":"女は彼に言った、「あなたはサウルがしたことをごぞんじでしょう。彼は口寄せや占い師をその国から断ち滅ぼしました。どうしてあなたは、わたしの命にわなをかけて、わたしを死なせようとするのですか」。"},{"ref":"1Sam.28.10","start":9028010,"end":9028010,"break":"none","ruby":[[4,1,"しゅ"],[9,2,"かのじょ"],[12,1,"ちか"],[15,1,"い"],[20,1,"しゅ"],[22,1,"い"],[32,1,"こと"],[41,1,"ばつ"],[43,1,"う"]],"text":"サウルは主をさして彼女に誓って言った、「主は生きておられる。この事のためにあなたが罰を受けることはないでしょう」。"},{"ref":"1Sam.28.11","start":9028011,"end":9028011,"break":"none","ruby":[[0,1,"おんな"],[2,1,"い"],[17,1,"よ"],[19,1,"おこ"],[32,1,"い"],[42,1,"よ"],[44,1,"おこ"]],"text":"女は言った、「あなたのためにだれを呼び起しましょうか」。サウルは言った、「サムエルを呼び起してください」。"},{"ref":"1Sam.28.12","start":9028012,"end":9028012,"break":"none","ruby":[[0,1,"おんな"],[7,1,"み"],[9,1,"とき"],[11,2,"おおごえ"],[14,1,"さけ"],[23,1,"おんな"],[29,1,"い"],[46,1,"あざむ"]],"text":"女はサムエルを見た時、大声で叫んだ。そしてその女はサウルに言った、「どうしてあなたはわたしを欺かれたのですか。あなたはサウルです」。"},{"ref":"1Sam.28.13","start":9028013,"end":9028013,"break":"none","ruby":[[0,1,"おう"],[2,2,"かのじょ"],[5,1,"い"],[10,1,"おそ"],[24,1,"なに"],[26,1,"み"],[35,1,"おんな"],[41,1,"い"],[46,1,"かみ"],[54,1,"ち"],[64,1,"み"]],"text":"王は彼女に言った、「恐れることはない。あなたには何が見えるのですか」。女はサウルに言った、「神のようなかたが地からのぼられるのが見えます」。"},{"ref":"1Sam.28.14","start":9028014,"end":9028014,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"い"],[14,1,"ひと"],[19,2,"ようす"],[30,2,"かのじょ"],[33,1,"い"],[42,2,"ろうじん"],[57,1,"ひと"],[59,2,"うわぎ"],[79,1,"ひと"],[90,1,"し"],[93,1,"ち"],[97,1,"ふ"],[100,1,"はい"]],"text":"サウルは彼女に言った、「その人はどんな様子をしていますか」。彼女は言った、「ひとりの老人がのぼってこられます。その人は上着をまとっておられます」。サウルはその人がサムエルであるのを知り、地にひれ伏して拝した。"},{"ref":"1Sam.28.15","start":9028015,"end":9028015,"break":"paragraph","ruby":[[9,1,"い"],[21,1,"よ"],[23,1,"おこ"],[31,1,"わずら"],[42,1,"い"],[57,1,"なや"],[75,1,"む"],[83,1,"おこ"],[86,1,"かみ"],[92,1,"はな"],[96,3,"よげんしゃ"],[105,1,"ゆめ"],[119,1,"こた"],[143,1,"し"],[153,1,"よ"]],"text":"サムエルはサウルに言った、「なぜ、わたしを呼び起して、わたしを煩わすのか」。サウルは言った、「わたしは、ひじょうに悩んでいます。ペリシテびとがわたしに向かっていくさを起し、神はわたしを離れて、預言者によっても、夢によっても、もはやわたしに答えられないのです。それで、わたしのすべきことを知るために、あなたを呼びました」。"},{"ref":"1Sam.28.16","start":9028016,"end":9028016,"break":"none","ruby":[[5,1,"い"],[10,1,"しゅ"],[16,1,"はな"],[24,1,"てき"],[45,1,"と"]],"text":"サムエルは言った、「主があなたを離れて、あなたの敵となられたのに、どうしてあなたはわたしに問うのですか。"},{"ref":"1Sam.28.17","start":9028017,"end":9028017,"break":"none","ruby":[[0,1,"しゅ"],[10,1,"かた"],[22,1,"おこな"],[27,1,"しゅ"],[29,2,"おうこく"],[37,1,"て"],[40,1,"さ"],[51,2,"りんじん"],[60,1,"あた"]],"text":"主は、わたしによって語られたとおりにあなたに行われた。主は王国を、あなたの手から裂きはなして、あなたの隣人であるダビデに与えられた。"},{"ref":"1Sam.28.18","start":9028018,"end":9028018,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"こえ"],[8,1,"き"],[10,1,"したが"],[14,1,"しゅ"],[16,1,"はげ"],[19,1,"いか"],[22,1,"したが"],[33,1,"う"],[35,1,"ほろ"],[46,1,"しゅ"],[50,1,"こと"],[55,1,"ひ"],[61,1,"おこな"]],"text":"あなたは主の声に聞き従わず、主の激しい怒りに従って、アマレクびとを撃ち滅ぼさなかったゆえに、主はこの事を、この日、あなたに行われたのである。"},{"ref":"1Sam.28.19","start":9028019,"end":9028019,"break":"none","ruby":[[0,1,"しゅ"],[16,1,"とも"],[26,1,"て"],[28,1,"わた"],[49,1,"こ"],[56,2,"いっしょ"],[68,1,"しゅ"],[76,2,"ぐんぜい"],[87,1,"て"],[89,1,"わた"]],"text":"主はまたイスラエルをも、あなたと共に、ペリシテびとの手に渡されるであろう。あすは、あなたもあなたの子らもわたしと一緒になるであろう。また主はイスラエルの軍勢をもペリシテびとの手に渡される」。"},{"ref":"1Sam.28.20","start":9028020,"end":9028020,"break":"paragraph","ruby":[[14,1,"ち"],[16,1,"の"],[19,1,"たお"],[27,2,"ことば"],[39,1,"おそ"],[46,1,"ちから"],[59,1,"にち"],[61,1,"や"],[63,2,"しょくもつ"]],"text":"そのときサウルは、ただちに、地に伸び、倒れ、サムエルの言葉のために、ひじょうに恐れ、またその力はうせてしまった。その一日一夜、食物をとっていなかったからである。"},{"ref":"1Sam.28.21","start":9028021,"end":9028021,"break":"none","ruby":[[0,1,"おんな"],[12,1,"かれ"],[23,1,"み"],[25,1,"い"],[44,1,"こえ"],[46,1,"き"],[48,1,"したが"],[55,1,"いのち"],[65,1,"い"],[69,2,"ことば"],[72,1,"したが"]],"text":"女はサウルのもとにきて、彼のおののいているのを見て言った、「あなたのつかえめは、あなたの声に聞き従い、わたしの命をかけて、あなたの言われた言葉に従いました。"},{"ref":"1Sam.28.22","start":9028022,"end":9028022,"break":"none","ruby":[[4,1,"いま"],[15,1,"こえ"],[17,1,"き"],[19,1,"したが"],[22,2,"ひとくち"],[32,1,"まえ"],[58,1,"ちから"],[63,1,"みち"],[65,1,"い"]],"text":"それゆえ今あなたも、つかえめの声に聞き従い、一口のパンをあなたの前にそなえさせてください。あなたはそれをめしあがって力をつけ、道を行ってください」。"},{"ref":"1Sam.28.23","start":9028023,"end":9028023,"break":"none","ruby":[[8,1,"ことわ"],[11,1,"い"],[20,1,"た"],[30,1,"かれ"],[41,1,"おんな"],[59,2,"ことば"],[62,1,"き"],[67,1,"ち"],[70,1,"お"],[76,1,"とこ"],[78,1,"うえ"]],"text":"ところがサウルは断って言った、「わたしは食べません」。しかし彼のしもべたちも、その女もしいてすすめたので、サウルはその言葉を聞きいれ、地から起きあがり、床の上にすわった。"},{"ref":"1Sam.28.24","start":9028024,"end":9028024,"break":"none","ruby":[[2,1,"おんな"],[4,1,"いえ"],[6,1,"こ"],[9,1,"こ"],[10,1,"うし"],[18,1,"いそ"],[30,2,"むぎこ"],[40,1,"たね"],[41,1,"い"],[47,1,"や"]],"text":"その女は家に肥えた子牛があったので、急いでそれをほふり、また麦粉をとり、こねて、種入れぬパンを焼き、"},{"ref":"1Sam.28.25","start":9028025,"end":9028025,"break":"none","ruby":[[12,1,"まえ"],[14,1,"も"],[22,1,"かれ"],[25,1,"た"],[32,1,"かれ"],[35,1,"た"],[37,1,"あ"],[44,1,"よる"],[49,1,"さ"]],"text":"サウルとそのしもべたちの前に持ってきたので、彼らは食べた。そして彼らは立ち上がって、その夜のうちに去った。"}]