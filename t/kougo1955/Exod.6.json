[{"ref":"Exod.6.1","start":2006001,"end":2006001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"いま"],[26,1,"なに"],[38,1,"み"],[52,1,"つよ"],[54,1,"て"],[62,1,"かれ"],[65,1,"さ"],[74,1,"いな"],[76,1,"かれ"],[78,1,"つよ"],[80,1,"て"],[88,1,"かれ"],[91,1,"くに"],[94,1,"お"],[96,1,"だ"]],"text":"主はモーセに言われた、「今、あなたは、わたしがパロに何をしようとしているかを見るであろう。すなわちパロは強い手にしいられて、彼らを去らせるであろう。否、彼は強い手にしいられて、彼らを国から追い出すであろう」。"},{"ref":"Exod.6.2","start":2006002,"end":2006002,"break":"paragraph","ruby":[[0,1,"かみ"],[6,1,"い"],[16,1,"しゅ"]],"text":"神はモーセに言われた、「わたしは主である。"},{"ref":"Exod.6.3","start":2006003,"end":2006003,"break":"none","ruby":[[19,2,"ぜんのう"],[22,1,"かみ"],[26,1,"あらわ"],[31,1,"しゅ"],[35,1,"な"],[39,2,"じぶん"],[42,1,"かれ"],[45,1,"し"]],"text":"わたしはアブラハム、イサク、ヤコブには全能の神として現れたが、主という名では、自分を彼らに知らせなかった。"},{"ref":"Exod.6.4","start":2006004,"end":2006004,"break":"none","ruby":[[10,1,"ち"],[16,1,"かれ"],[19,2,"きりゅう"],[25,2,"きりゅう"],[28,1,"ち"],[31,1,"かれ"],[34,1,"あた"],[40,2,"けいやく"],[43,1,"かれ"],[46,1,"た"]],"text":"わたしはまたカナンの地、すなわち彼らが寄留したその寄留の地を、彼らに与えるという契約を彼らと立てた。"},{"ref":"Exod.6.5","start":2006005,"end":2006005,"break":"none","ruby":[[14,2,"どれい"],[27,2,"ひとびと"],[34,1,"き"],[42,2,"けいやく"],[45,1,"おも"],[47,1,"だ"]],"text":"わたしはまた、エジプトびとが奴隷としているイスラエルの人々のうめきを聞いて、わたしの契約を思い出した。"},{"ref":"Exod.6.6","start":2006006,"end":2006006,"break":"none","ruby":[[11,2,"ひとびと"],[14,1,"い"],[25,1,"しゅ"],[47,2,"ろうえき"],[50,1,"した"],[53,1,"みちび"],[55,1,"だ"],[58,2,"どれい"],[61,1,"つとめ"],[64,1,"すく"],[69,1,"の"],[72,1,"うで"],[74,1,"おお"]],"text":"それゆえ、イスラエルの人々に言いなさい、『わたしは主である。わたしはあなたがたをエジプトびとの労役の下から導き出し、奴隷の務から救い、また伸べた腕と大いなるさばきをもって、あなたがたをあがなうであろう。"},{"ref":"Exod.6.7","start":2006007,"end":2006007,"break":"none","ruby":[[10,1,"と"],[17,1,"たみ"],[31,1,"かみ"],[47,2,"ろうえき"],[50,1,"した"],[59,1,"みちび"],[61,1,"だ"],[69,1,"かみ"],[71,1,"しゅ"],[85,1,"し"]],"text":"わたしはあなたがたを取ってわたしの民とし、わたしはあなたがたの神となる。わたしがエジプトびとの労役の下からあなたがたを導き出すあなたがたの神、主であることを、あなたがたは知るであろう。"},{"ref":"Exod.6.8","start":2006008,"end":2006008,"break":"none","ruby":[[18,1,"あた"],[22,1,"て"],[24,1,"あ"],[27,1,"ちか"],[32,1,"ち"],[48,2,"しょゆう"],[54,1,"あた"],[66,1,"しゅ"]],"text":"わたしはアブラハム、イサク、ヤコブに与えると手を挙げて誓ったその地にあなたがたをはいらせ、それを所有として、与えるであろう。わたしは主である』と」。"},{"ref":"Exod.6.9","start":2006009,"end":2006009,"break":"none","ruby":[[15,2,"ひとびと"],[18,1,"かた"],[23,1,"かれ"],[26,1,"こころ"],[28,1,"いた"],[36,2,"どれい"],[39,1,"つとめ"],[49,1,"き"],[51,1,"したが"]],"text":"モーセはこのようにイスラエルの人々に語ったが、彼らは心の痛みと、きびしい奴隷の務のゆえに、モーセに聞き従わなかった。"},{"ref":"Exod.6.10","start":2006010,"end":2006010,"break":"paragraph","ruby":[[2,1,"しゅ"],[8,1,"い"]],"text":"さて主はモーセに言われた、"},{"ref":"Exod.6.11","start":2006011,"end":2006011,"break":"none","ruby":[[6,1,"おう"],[14,1,"い"],[18,1,"かれ"],[26,2,"ひとびと"],[31,1,"くに"],[34,1,"さ"],[41,1,"はな"]],"text":"「エジプトの王パロのところに行って、彼がイスラエルの人々をその国から去らせるように話しなさい」。"},{"ref":"Exod.6.12","start":2006012,"end":2006012,"break":"none","ruby":[[4,1,"しゅ"],[10,1,"い"],[21,2,"ひとびと"],[31,1,"い"],[36,1,"き"],[55,2,"かつれい"],[64,1,"い"],[73,1,"き"],[75,1,"い"]],"text":"モーセは主にむかって言った、「イスラエルの人々でさえ、わたしの言うことを聞かなかったのに、どうして、くちびるに割礼のないわたしの言うことを、パロが聞き入れましょうか」。"},{"ref":"Exod.6.13","start":2006013,"end":2006013,"break":"none","ruby":[[4,1,"しゅ"],[14,1,"かた"],[24,2,"ひとびと"],[33,1,"おう"],[40,1,"い"],[50,2,"ひとびと"],[58,1,"ち"],[61,1,"みちび"],[63,1,"だ"],[66,1,"めい"]],"text":"しかし、主はモーセとアロンに語って、イスラエルの人々と、エジプトの王パロのもとに行かせ、イスラエルの人々をエジプトの地から導き出せと命じられた。"},{"ref":"Exod.6.14","start":2006014,"end":2006014,"break":"paragraph","ruby":[[0,1,"かれ"],[3,2,"せんぞ"],[6,1,"いえ"],[8,2,"しゅちょう"],[13,1,"つぎ"],[32,2,"ちょうし"],[38,1,"こ"],[66,2,"いちぞく"]],"text":"彼らの先祖の家の首長たちは次のとおりである。すなわちイスラエルの長子ルベンの子らはハノク、パル、ヘヅロン、カルミで、これらはルベンの一族である。"},{"ref":"Exod.6.15","start":2006015,"end":2006015,"break":"none","ruby":[[5,1,"こ"],[36,1,"おんな"],[39,1,"うま"],[57,2,"いちぞく"]],"text":"シメオンの子らはエムエル、ヤミン、オハデ、ヤキン、ゾハル、およびカナンの女から生れたシャウルで、これらはシメオンの一族である。"},{"ref":"Exod.6.16","start":2006016,"end":2006016,"break":"none","ruby":[[3,1,"こ"],[6,1,"な"],[11,2,"せだい"],[14,1,"したが"],[36,2,"いっしょう"],[43,1,"ねん"]],"text":"レビの子らの名は、その世代に従えば、ゲルション、コハテ、メラリで、レビの一生は百三十七年であった。"},{"ref":"Exod.6.17","start":2006017,"end":2006017,"break":"none","ruby":[[6,1,"こ"],[9,2,"いちぞく"]],"text":"ゲルションの子らの一族はリブニとシメイである。"},{"ref":"Exod.6.18","start":2006018,"end":2006018,"break":"none","ruby":[[4,1,"こ"],[32,2,"いっしょう"],[39,1,"ねん"]],"text":"コハテの子らはアムラム、イヅハル、ヘブロン、ウジエルで、コハテの一生は百三十三年であった。"},{"ref":"Exod.6.19","start":2006019,"end":2006019,"break":"none","ruby":[[4,1,"こ"],[23,2,"せだい"],[31,2,"いちぞく"]],"text":"メラリの子らはマヘリとムシである。これらはその世代によるレビの一族である。"},{"ref":"Exod.6.20","start":2006020,"end":2006020,"break":"none","ruby":[[5,1,"ちち"],[7,1,"いもうと"],[13,1,"つま"],[19,2,"かのじょ"],[30,1,"かれ"],[32,1,"う"],[41,2,"いっしょう"],[48,1,"ねん"]],"text":"アムラムは父の妹ヨケベデを妻としたが、彼女はアロンとモーセを彼に産んだ。アムラムの一生は百三十七年であった。"},{"ref":"Exod.6.21","start":2006021,"end":2006021,"break":"none","ruby":[[5,1,"こ"]],"text":"イヅハルの子らはコラ、ネペグ、ジクリである。"},{"ref":"Exod.6.22","start":2006022,"end":2006022,"break":"none","ruby":[[5,1,"こ"]],"text":"ウジエルの子らはミサエル、エルザパン、シテリである。"},{"ref":"Exod.6.23","start":2006023,"end":2006023,"break":"none","ruby":[[9,2,"しまい"],[18,1,"むすめ"],[24,1,"つま"],[34,1,"かれ"],[55,1,"う"]],"text":"アロンはナションの姉妹、アミナダブの娘エリセバを妻とした。エリセバは彼にナダブ、アビウ、エレアザル、イタマルを産んだ。"},{"ref":"Exod.6.24","start":2006024,"end":2006024,"break":"none","ruby":[[3,1,"こ"],[32,2,"いちぞく"]],"text":"コラの子らはアッシル、エルカナ、アビアサフで、これらはコラびとの一族である。"},{"ref":"Exod.6.25","start":2006025,"end":2006025,"break":"none","ruby":[[4,1,"こ"],[16,1,"むすめ"],[22,1,"つま"],[27,2,"かのじょ"],[35,1,"かれ"],[37,1,"う"],[48,2,"いちぞく"],[58,2,"せんぞ"],[61,1,"いえ"],[63,2,"しゅちょう"]],"text":"アロンの子エレアザルはプテエルの娘のひとりを妻とした。彼女はピネハスを彼に産んだ。これらは、その一族によるレビびとの先祖の家の首長たちである。"},{"ref":"Exod.6.26","start":2006026,"end":2006026,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,2,"ひとびと"],[15,2,"ぐんだん"],[18,1,"したが"],[27,1,"ち"],[30,1,"みちび"],[32,1,"だ"],[39,1,"い"]],"text":"主が、「イスラエルの人々をその軍団に従って、エジプトの地から導き出しなさい」と言われたのは、このアロンとモーセである。"},{"ref":"Exod.6.27","start":2006027,"end":2006027,"break":"none","ruby":[[0,1,"かれ"],[9,2,"ひとびと"],[18,1,"みちび"],[20,1,"だ"],[34,1,"おう"],[38,1,"かた"]],"text":"彼らはイスラエルの人々をエジプトから導き出すことについて、エジプトの王パロに語ったもので、すなわちこのモーセとアロンである。"},{"ref":"Exod.6.28","start":2006028,"end":2006028,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"ち"],[13,1,"かた"],[17,1,"ひ"]],"text":"主がエジプトの地でモーセに語られた日に、"},{"ref":"Exod.6.29","start":2006029,"end":2006029,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"しゅ"],[29,1,"かた"],[42,1,"おう"],[46,1,"かた"]],"text":"主はモーセに言われた、「わたしは主である。わたしがあなたに語ることは、みなエジプトの王パロに語りなさい」。"},{"ref":"Exod.6.30","start":2006030,"end":2006030,"break":"none","ruby":[[7,1,"しゅ"],[13,1,"い"],[36,2,"かつれい"],[41,1,"もの"],[56,1,"い"],[61,1,"き"]],"text":"しかしモーセは主にむかって言った、「ごらんのとおり、わたしは、くちびるに割礼のない者です。パロがどうしてわたしの言うことを聞きいれましょうか」。"}]