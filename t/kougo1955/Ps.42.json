[{"ref":"Ps.42.1","start":19042001,"end":19042001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたコラの子のマスキールの歌","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[6,2,"たにがわ"],[9,1,"した"],[20,1,"たましい"],[26,1,"した"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[19,1,"こ"],[27,1,"うた"]],"text":"神よ、しかが谷川を慕いあえぐように、わが魂もあなたを慕いあえぐ。"},{"ref":"Ps.42.2","start":19042002,"end":19042002,"break":"line","breaks":[[18,"line"],[26,"line"],[41,"line"]],"ruby":[[2,1,"たましい"],[13,1,"かみ"],[15,1,"した"],[21,1,"かみ"],[23,1,"した"],[33,1,"い"],[36,1,"かみ"],[39,1,"かお"],[41,1,"み"]],"text":"わが魂はかわいているように神を慕い、いける神を慕う。いつ、わたしは行って神のみ顔を見ることができるだろうか。"},{"ref":"Ps.42.3","start":19042003,"end":19042003,"break":"line","breaks":[[15,"line"],[39,"line"]],"ruby":[[0,2,"ひとびと"],[20,1,"かみ"],[31,1,"い"],[37,1,"あいだ"],[43,1,"なみだ"],[45,1,"ひる"],[47,1,"よる"],[53,2,"しょくもつ"]],"text":"人々がひねもすわたしにむかって「おまえの神はどこにいるのか」と言いつづける間はわたしの涙は昼も夜もわたしの食物であった。"},{"ref":"Ps.42.4","start":19042004,"end":19042004,"break":"line","breaks":[[18,"line"],[27,"line"],[49,"line"],[62,"line"]],"ruby":[[7,1,"まつり"],[9,1,"まも"],[11,1,"おお"],[14,1,"ひと"],[16,1,"とも"],[18,1,"む"],[24,1,"い"],[27,1,"よろこ"],[30,2,"かんしゃ"],[33,1,"うた"],[38,1,"かれ"],[41,1,"かみ"],[43,1,"いえ"],[45,1,"みちび"],[49,1,"いま"],[54,1,"こと"],[56,1,"おも"],[58,1,"おこ"],[64,1,"たましい"],[69,1,"だ"]],"text":"わたしはかつて祭を守る多くの人と共に群れをなして行き、喜びと感謝の歌をもって彼らを神の家に導いた。今これらの事を思い起して、わが魂をそそぎ出すのである。"},{"ref":"Ps.42.5","start":19042005,"end":19042005,"break":"line","breaks":[[16,"line"],[35,"line"],[42,"line"],[53,"line"]],"ruby":[[2,1,"たましい"],[5,1,"なに"],[16,1,"なに"],[26,1,"おも"],[35,1,"かみ"],[37,1,"ま"],[39,1,"のぞ"],[50,1,"たす"],[55,1,"かみ"],[58,1,"しゅ"]],"text":"わが魂よ、何ゆえうなだれるのか。何ゆえわたしのうちに思いみだれるのか。神を待ち望め。わたしはなおわが助け、わが神なる主をほめたたえるであろう。"},{"ref":"Ps.42.6","start":19042006,"end":19042006,"break":"line","breaks":[[17,"line"],[43,"line"]],"ruby":[[2,1,"たましい"],[30,1,"ち"],[47,1,"やま"],[54,1,"おも"],[56,1,"おこ"]],"text":"わが魂はわたしのうちにうなだれる。それで、わたしはヨルダンの地から、またヘルモンから、ミザルの山からあなたを思い起す。"},{"ref":"Ps.42.7","start":19042007,"end":19042007,"break":"line","breaks":[[21,"line"],[34,"line"]],"ruby":[[4,2,"おおたき"],[7,1,"ひび"],[13,2,"ふちぶち"],[15,1,"よ"],[25,1,"なみ"],[31,2,"おおなみ"],[43,1,"うえ"],[45,1,"こ"]],"text":"あなたの大滝の響きによって淵々呼びこたえ、あなたの波、あなたの大波はことごとくわたしの上を越えていった。"},{"ref":"Ps.42.8","start":19042008,"end":19042008,"break":"line","breaks":[[19,"line"],[42,"line"]],"ruby":[[0,1,"ひる"],[4,1,"しゅ"],[19,1,"よる"],[25,1,"うた"],[36,1,"かみ"],[42,1,"いのり"],[48,1,"とも"]],"text":"昼には、主はそのいつくしみをほどこし、夜には、その歌すなわちわがいのちの神にささげる祈がわたしと共にある。"},{"ref":"Ps.42.9","start":19042009,"end":19042009,"break":"line","breaks":[[14,"line"],[33,"line"],[50,"line"]],"ruby":[[6,1,"いわ"],[9,1,"かみ"],[11,1,"い"],[15,1,"なに"],[23,1,"わす"],[33,1,"なに"],[40,1,"てき"],[50,1,"かな"],[53,1,"ある"]],"text":"わたしはわが岩なる神に言う、「何ゆえわたしをお忘れになりましたか。何ゆえわたしは敵のしえたげによって悲しみ歩くのですか」と。"},{"ref":"Ps.42.10","start":19042010,"end":19042010,"break":"line","breaks":[[16,"line"],[25,"line"],[37,"line"]],"ruby":[[7,1,"ほね"],[9,1,"くだ"],[42,1,"かみ"],[53,1,"い"]],"text":"わたしのあだは骨も砕けるばかりにわたしをののしり、ひねもすわたしにむかって「おまえの神はどこにいるのか」と言う。"},{"ref":"Ps.42.11","start":19042011,"end":19042011,"break":"line","breaks":[[16,"line"],[35,"line"],[42,"line"],[53,"line"]],"ruby":[[2,1,"たましい"],[5,1,"なに"],[16,1,"なに"],[26,1,"おも"],[35,1,"かみ"],[37,1,"ま"],[39,1,"のぞ"],[50,1,"たす"],[55,1,"かみ"],[58,1,"しゅ"]],"text":"わが魂よ、何ゆえうなだれるのか。何ゆえわたしのうちに思いみだれるのか。神を待ち望め。わたしはなおわが助け、わが神なる主をほめたたえるであろう。"}]