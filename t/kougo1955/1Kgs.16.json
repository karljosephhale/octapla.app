[{"ref":"1Kgs.16.1","start":11016001,"end":11016001,"break":"paragraph","ruby":[[3,1,"しゅ"],[5,2,"ことば"],[12,1,"こ"],[17,1,"のぞ"],[25,1,"せ"],[28,1,"い"]],"text":"そこで主の言葉がハナニの子エヒウに臨み、バアシャを責めて言った、"},{"ref":"1Kgs.16.2","start":11016002,"end":11016002,"break":"none","ruby":[[12,1,"なか"],[23,1,"たみ"],[30,1,"うえ"],[32,1,"きみ"],[48,1,"みち"],[50,1,"あゆ"],[57,1,"たみ"],[64,1,"つみ"],[66,1,"おか"],[72,1,"つみ"],[81,1,"いか"]],"text":"「わたしはあなたをちりの中からあげて、わたしの民イスラエルの上に君としたが、あなたはヤラベアムの道に歩み、わたしの民イスラエルに罪を犯させ、その罪をもってわたしを怒らせた。"},{"ref":"1Kgs.16.3","start":11016003,"end":11016003,"break":"none","ruby":[[15,1,"いえ"],[17,1,"まった"],[19,1,"ほろ"],[22,1,"さ"],[29,1,"いえ"],[35,1,"こ"],[42,1,"いえ"]],"text":"それでわたしは、バアシャとその家を全く滅ぼし去り、あなたの家をネバテの子ヤラベアムの家のようにする。"},{"ref":"1Kgs.16.4","start":11016004,"end":11016004,"break":"none","ruby":[[5,1,"ぞく"],[8,1,"もの"],[11,1,"まち"],[13,1,"し"],[15,1,"もの"],[17,1,"いぬ"],[19,1,"た"],[22,1,"かれ"],[24,1,"ぞく"],[27,1,"もの"],[30,1,"の"],[32,1,"し"],[34,1,"もの"],[36,1,"そら"],[38,1,"とり"],[40,1,"た"]],"text":"バアシャに属する者で、町で死ぬ者は犬が食べ、彼に属する者で、野で死ぬ者は空の鳥が食べるであろう」。"},{"ref":"1Kgs.16.5","start":11016005,"end":11016005,"break":"paragraph","ruby":[[7,1,"た"],[9,2,"じせき"],[13,1,"かれ"],[17,1,"こと"],[22,2,"くんこう"],[33,1,"おう"],[35,3,"れきだいし"],[39,1,"しょ"]],"text":"バアシャのその他の事績と、彼がした事と、その勲功とは、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"1Kgs.16.6","start":11016006,"end":11016006,"break":"none","ruby":[[7,2,"せんぞ"],[10,1,"とも"],[12,1,"ねむ"],[20,1,"ほうむ"],[26,1,"こ"],[30,1,"かわ"],[33,1,"おう"]],"text":"バアシャはその先祖と共に眠って、テルザに葬られ、その子エラが代って王となった。"},{"ref":"1Kgs.16.7","start":11016007,"end":11016007,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"こ"],[12,3,"よげんしゃ"],[22,1,"のぞ"],[32,1,"いえ"],[34,1,"せ"],[41,1,"かれ"],[43,1,"しゅ"],[45,1,"め"],[47,1,"まえ"],[55,1,"あく"],[57,1,"おこな"],[62,1,"て"],[70,1,"しゅ"],[72,1,"いか"],[82,1,"いえ"],[96,1,"かれ"],[104,1,"いえ"],[106,1,"ほろ"]],"text":"主の言葉はまたハナニの子預言者エヒウによって臨み、バアシャとその家を責めた。これは彼が主の目の前に、もろもろの悪を行い、その手のわざをもって主を怒らせ、ヤラベアムの家にならったためであり、また彼がヤラベアムの家を滅ぼしたためであった。"},{"ref":"1Kgs.16.8","start":11016008,"end":11016008,"break":"paragraph","ruby":[[3,1,"おう"],[7,1,"だい"],[11,1,"ねん"],[18,1,"こ"],[32,1,"おう"],[38,1,"ねん"],[39,1,"よ"],[41,1,"おさ"]],"text":"ユダの王アサの第二十六年にバアシャの子エラはテルザでイスラエルの王となり、二年世を治めた。"},{"ref":"1Kgs.16.9","start":11016009,"end":11016009,"break":"none","ruby":[[0,1,"かれ"],[13,2,"きゅうでん"],[23,1,"いえ"],[25,1,"さけ"],[27,1,"の"],[30,1,"よ"],[33,1,"とき"],[37,2,"けらい"],[40,2,"せんしゃ"],[42,1,"たい"],[44,1,"なか"],[47,2,"しき"],[58,1,"かれ"]],"text":"彼がテルザにいて、テルザの宮殿のつかさアルザの家で酒を飲んで酔った時、その家来で戦車隊の半ばを指揮していたジムリが、彼にそむいた。"},{"ref":"1Kgs.16.10","start":11016010,"end":11016010,"break":"none","ruby":[[6,1,"おう"],[10,1,"だい"],[14,1,"ねん"],[27,1,"かれ"],[29,1,"う"],[31,1,"ころ"],[34,1,"かれ"],[36,1,"かわ"],[39,1,"おう"]],"text":"そしてユダの王アサの第二十七年にジムリは、はいってきて彼を撃ち殺し、彼に代って王となった。"},{"ref":"1Kgs.16.11","start":11016011,"end":11016011,"break":"paragraph","ruby":[[4,1,"おう"],[10,1,"くらい"],[15,1,"とき"],[22,2,"ぜんか"],[25,1,"ころ"],[30,2,"しんぞく"],[35,1,"とも"],[39,2,"だんし"],[47,1,"のこ"]],"text":"ジムリは王となって、位についた時、バアシャの全家を殺し、その親族または友だちの男子は、ひとりも残さなかった。"},{"ref":"1Kgs.16.12","start":11016012,"end":11016012,"break":"none","ruby":[[13,2,"ぜんか"],[16,1,"ほろ"],[21,1,"しゅ"],[23,3,"よげんしゃ"],[38,1,"せ"],[41,1,"い"],[45,2,"ことば"]],"text":"こうしてジムリはバアシャの全家を滅ぼした。主が預言者エヒウによってバアシャを責めて言われた言葉のとおりである。"},{"ref":"1Kgs.16.13","start":11016013,"end":11016013,"break":"none","ruby":[[13,1,"つみ"],[18,1,"こ"],[22,1,"つみ"],[31,1,"かれ"],[34,1,"つみ"],[36,1,"おか"],[47,1,"つみ"],[49,1,"おか"],[53,1,"かれ"],[56,2,"ぐうぞう"],[68,1,"かみ"],[70,1,"しゅ"],[72,1,"いか"]],"text":"これはバアシャのもろもろの罪と、その子エラの罪のためであって、彼らが罪を犯し、またイスラエルに罪を犯させ、彼らの偶像をもってイスラエルの神、主を怒らせたからである。"},{"ref":"1Kgs.16.14","start":11016014,"end":11016014,"break":"none","ruby":[[5,1,"た"],[7,2,"じせき"],[11,1,"かれ"],[19,1,"こと"],[28,1,"おう"],[30,3,"れきだいし"],[34,1,"しょ"]],"text":"エラのその他の事績と、彼がしたすべての事は、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"1Kgs.16.15","start":11016015,"end":11016015,"break":"paragraph","ruby":[[3,1,"おう"],[7,1,"だい"],[11,1,"ねん"],[21,2,"なぬか"],[24,1,"あいだ"],[26,1,"よ"],[28,1,"おさ"],[32,1,"たみ"],[41,1,"ぞく"],[53,2,"じんど"]],"text":"ユダの王アサの第二十七年にジムリはテルザで七日の間、世を治めた。民はペリシテびとに属するギベトンにむかって陣取っていたが、"},{"ref":"1Kgs.16.16","start":11016016,"end":11016016,"break":"none","ruby":[[2,2,"じんど"],[8,1,"たみ"],[19,1,"おこ"],[22,1,"おう"],[24,1,"ころ"],[29,1,"ひと"],[35,1,"き"],[47,1,"みな"],[50,1,"ひ"],[51,2,"じんえい"],[55,1,"ぐん"],[57,1,"ちょう"],[68,1,"おう"]],"text":"その陣取っていた民が「ジムリはむほんを起して王を殺した」と人のいうのを聞いたので、イスラエルは皆その日陣営で、軍の長オムリをイスラエルの王とした。"},{"ref":"1Kgs.16.17","start":11016017,"end":11016017,"break":"none","ruby":[[13,2,"ひとびと"],[16,1,"とも"],[24,1,"のぼ"],[31,1,"かこ"]],"text":"そこでオムリはイスラエルの人々と共にギベトンから上ってテルザを囲んだ。"},{"ref":"1Kgs.16.18","start":11016018,"end":11016018,"break":"none","ruby":[[6,1,"まち"],[8,1,"おちい"],[12,1,"み"],[15,1,"おう"],[17,2,"きゅうでん"],[20,2,"てんしゅ"],[27,1,"おう"],[29,2,"きゅうでん"],[32,1,"ひ"],[39,1,"なか"],[41,1,"し"]],"text":"ジムリはその町の陥るのを見て、王の宮殿の天守にはいり、王の宮殿に火をかけてその中で死んだ。"},{"ref":"1Kgs.16.19","start":11016019,"end":11016019,"break":"none","ruby":[[3,1,"かれ"],[5,1,"おか"],[8,1,"つみ"],[17,1,"かれ"],[19,1,"しゅ"],[21,1,"め"],[23,1,"まえ"],[25,1,"あく"],[27,1,"おこな"],[36,1,"みち"],[38,1,"あゆ"],[53,1,"おか"],[59,1,"つみ"],[61,1,"おこな"]],"text":"これは彼が犯した罪のためであって、彼が主の目の前に悪を行い、ヤラベアムの道に歩み、ヤラベアムがイスラエルに犯させたその罪を行ったからである。"},{"ref":"1Kgs.16.20","start":11016020,"end":11016020,"break":"none","ruby":[[6,1,"た"],[8,2,"じせき"],[12,1,"かれ"],[14,1,"くわだ"],[17,2,"いんぼう"],[27,1,"おう"],[29,3,"れきだいし"],[33,1,"しょ"]],"text":"ジムリのその他の事績と、彼が企てた陰謀は、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"1Kgs.16.21","start":11016021,"end":11016021,"break":"paragraph","ruby":[[2,1,"とき"],[9,1,"たみ"],[14,1,"わか"],[17,1,"たみ"],[19,1,"なか"],[26,1,"こ"],[31,1,"したが"],[38,1,"おう"],[46,1,"なか"],[53,1,"したが"]],"text":"その時イスラエルの民は二つに分れ、民の半ばはギナテの子テブニに従って、これを王としようとし、半ばはオムリに従った。"},{"ref":"1Kgs.16.22","start":11016022,"end":11016022,"break":"none","ruby":[[7,1,"したが"],[10,1,"たみ"],[16,1,"こ"],[21,1,"したが"],[24,1,"たみ"],[26,1,"か"],[34,1,"し"],[41,1,"おう"]],"text":"しかしオムリに従った民はギナテの子テブニに従った民に勝って、テブニは死に、オムリが王となった。"},{"ref":"1Kgs.16.23","start":11016023,"end":11016023,"break":"none","ruby":[[3,1,"おう"],[7,1,"だい"],[11,1,"ねん"],[23,1,"おう"],[30,1,"ねん"],[31,1,"よ"],[33,1,"おさ"],[37,1,"かれ"],[44,1,"ねん"],[45,1,"おう"]],"text":"ユダの王アサの第三十一年にオムリはイスラエルの王となって十二年世を治めた。彼はテルザで六年王であった。"},{"ref":"1Kgs.16.24","start":11016024,"end":11016024,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ぎん"],[19,1,"やま"],[21,1,"か"],[26,1,"うえ"],[28,1,"まち"],[30,1,"た"],[35,1,"た"],[38,1,"まち"],[40,1,"な"],[44,1,"やま"],[46,1,"も"],[48,1,"ぬし"],[57,1,"な"],[59,1,"したが"],[67,1,"よ"]],"text":"彼は銀二タラントでセメルからサマリヤの山を買い、その上に町を建て、その建てた町の名をその山の持ち主であったセメルの名に従ってサマリヤと呼んだ。"},{"ref":"1Kgs.16.25","start":11016025,"end":11016025,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"め"],[8,1,"まえ"],[10,1,"あく"],[12,1,"おこな"],[15,1,"かれ"],[19,1,"さき"],[27,1,"もの"],[33,1,"わる"],[35,1,"こと"]],"text":"オムリは主の目の前に悪を行い、彼よりも先にいたすべての者にまさって悪い事をした。"},{"ref":"1Kgs.16.26","start":11016026,"end":11016026,"break":"none","ruby":[[0,1,"かれ"],[6,1,"こ"],[17,1,"みち"],[19,1,"あゆ"],[34,1,"つみ"],[36,1,"おか"],[40,1,"かれ"],[43,2,"ぐうぞう"],[55,1,"かみ"],[57,1,"しゅ"],[59,1,"いか"],[65,1,"つみ"],[67,1,"おこな"]],"text":"彼はネバテの子ヤラベアムのすべての道に歩み、ヤラベアムがイスラエルに罪を犯させ、彼らの偶像をもってイスラエルの神、主を怒らせたその罪を行った。"},{"ref":"1Kgs.16.27","start":11016027,"end":11016027,"break":"none","ruby":[[4,1,"い"],[9,1,"た"],[11,2,"じせき"],[15,1,"かれ"],[22,2,"くんこう"],[33,1,"おう"],[35,3,"れきだいし"],[39,1,"しょ"]],"text":"オムリが行ったその他の事績と、彼があらわした勲功とは、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"1Kgs.16.28","start":11016028,"end":11016028,"break":"none","ruby":[[6,2,"せんぞ"],[9,1,"とも"],[11,1,"ねむ"],[20,1,"ほうむ"],[26,1,"こ"],[31,1,"かわ"],[34,1,"おう"]],"text":"オムリはその先祖と共に眠って、サマリヤに葬られ、その子アハブが代って王となった。"},{"ref":"1Kgs.16.29","start":11016029,"end":11016029,"break":"paragraph","ruby":[[3,1,"おう"],[7,1,"だい"],[11,1,"ねん"],[17,1,"こ"],[28,1,"おう"],[38,1,"こ"],[51,1,"ねん"],[58,1,"おさ"]],"text":"ユダの王アサの第三十八年にオムリの子アハブがイスラエルの王となった。オムリの子アハブはサマリヤで二十二年イスラエルを治めた。"},{"ref":"1Kgs.16.30","start":11016030,"end":11016030,"break":"none","ruby":[[4,1,"こ"],[9,1,"かれ"],[13,1,"さき"],[21,1,"もの"],[28,1,"しゅ"],[30,1,"め"],[32,1,"まえ"],[34,1,"あく"],[36,1,"おこな"]],"text":"オムリの子アハブは彼よりも先にいたすべての者にまさって、主の目の前に悪を行った。"},{"ref":"1Kgs.16.31","start":11016031,"end":11016031,"break":"none","ruby":[[0,1,"かれ"],[6,1,"こ"],[13,1,"つみ"],[15,1,"おこな"],[21,1,"かる"],[23,1,"こと"],[33,1,"おう"],[40,1,"むすめ"],[46,1,"つま"],[52,1,"い"],[59,1,"つか"],[65,1,"おが"]],"text":"彼はネバテの子ヤラベアムの罪を行うことを、軽い事とし、シドンびとの王エテバアルの娘イゼベルを妻にめとり、行ってバアルに仕え、これを拝んだ。"},{"ref":"1Kgs.16.32","start":11016032,"end":11016032,"break":"none","ruby":[[0,1,"かれ"],[7,1,"た"],[14,1,"みや"],[24,2,"さいだん"],[27,1,"きず"]],"text":"彼はサマリヤに建てたバアルの宮に、バアルのために祭壇を築いた。"},{"ref":"1Kgs.16.33","start":11016033,"end":11016033,"break":"none","ruby":[[9,1,"ぞう"],[11,1,"つく"],[19,1,"かれ"],[23,1,"さき"],[37,1,"おう"],[49,1,"かみ"],[51,1,"しゅ"],[53,1,"いか"],[60,1,"おこな"]],"text":"アハブはまたアシラ像を造った。アハブは彼よりも先にいたイスラエルのすべての王にまさってイスラエルの神、主を怒らせることを行った。"},{"ref":"1Kgs.16.34","start":11016034,"end":11016034,"break":"none","ruby":[[0,1,"かれ"],[2,1,"よ"],[17,1,"た"],[21,1,"かれ"],[25,1,"もとい"],[30,1,"とき"],[32,2,"ちょうし"],[39,1,"うしな"],[44,1,"もん"],[46,1,"た"],[49,1,"とき"],[51,1,"すえ"],[53,1,"こ"],[58,1,"うしな"],[62,1,"しゅ"],[67,1,"こ"],[76,1,"い"],[80,2,"ことば"]],"text":"彼の代にベテルびとヒエルはエリコを建てた。彼はその基をすえる時に長子アビラムを失い、その門を立てる時に末の子セグブを失った。主がヌンの子ヨシュアによって言われた言葉のとおりである。"}]