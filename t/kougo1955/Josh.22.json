[{"ref":"Josh.22.1","start":6022001,"end":6022001,"break":"paragraph","ruby":[[0,1,"とき"],[26,2,"ぶぞく"],[29,1,"なか"],[32,1,"よ"],[34,1,"あつ"]],"text":"時にヨシュアは、ルベンびと、ガドびと、およびマナセの部族の半ばを呼び集めて、"},{"ref":"Josh.22.2","start":6022002,"end":6022002,"break":"none","ruby":[[0,1,"い"],[11,1,"しゅ"],[20,1,"めい"],[32,1,"まも"],[41,1,"めい"],[48,1,"こと"],[56,2,"ことば"],[59,1,"き"]],"text":"言った、「あなたがたは主のしもべモーセが命じたことを、ことごとく守り、またわたしの命じたすべての事にも、わたしの言葉に聞きしたがいました。"},{"ref":"Josh.22.3","start":6022003,"end":6022003,"break":"none","ruby":[[0,2,"こんにち"],[4,1,"なが"],[6,2,"としつき"],[9,1,"あいだ"],[17,2,"きょうだい"],[22,1,"す"],[32,1,"かみ"],[34,1,"しゅ"],[36,2,"めいれい"],[42,1,"まも"]],"text":"今日まで長い年月の間、あなたがたの兄弟たちを捨てず、あなたがたの神、主の命令を、よく守ってきました。"},{"ref":"Josh.22.4","start":6022004,"end":6022004,"break":"none","ruby":[[0,1,"いま"],[12,1,"かみ"],[14,1,"しゅ"],[23,2,"きょうだい"],[29,1,"さき"],[31,2,"やくそく"],[40,2,"あんそく"],[43,1,"たま"],[65,1,"み"],[67,1,"かえ"],[71,1,"しゅ"],[87,1,"あた"],[95,1,"む"],[98,1,"がわ"],[100,2,"しょゆう"],[103,1,"ち"],[105,1,"い"],[108,2,"じぶん"],[113,2,"てんまく"],[116,1,"かえ"]],"text":"今はすでに、あなたがたの神、主が、あなたがたの兄弟たちに、先に約束されたとおり、安息を賜わるようになりました。それで、あなたがたは身を返して、主のしもべモーセが、あなたがたに与えたヨルダンの向こう側の所有の地に行き、自分たちの天幕に帰りなさい。"},{"ref":"Josh.22.5","start":6022005,"end":6022005,"break":"none","ruby":[[2,1,"しゅ"],[18,1,"めい"],[21,1,"いまし"],[25,2,"りっぽう"],[29,1,"つつし"],[32,1,"おこな"],[41,1,"かみ"],[43,1,"しゅ"],[45,1,"あい"],[54,1,"みち"],[56,1,"あゆ"],[61,2,"めいれい"],[64,1,"まも"],[68,1,"しゅ"],[72,1,"したが"],[75,1,"こころ"],[81,2,"せいしん"],[89,1,"しゅ"],[91,1,"つか"]],"text":"ただ主のしもべモーセが、あなたがたに命じた戒めと、律法とを慎んで行い、あなたがたの神、主を愛し、そのすべての道に歩み、その命令を守って、主につき従い、心をつくし、精神をつくして、主に仕えなさい」。"},{"ref":"Josh.22.6","start":6022006,"end":6022006,"break":"none","ruby":[[8,1,"かれ"],[11,2,"しゅくふく"],[15,1,"さ"],[22,1,"かれ"],[27,2,"てんまく"],[30,1,"かえ"]],"text":"そしてヨシュアが彼らを祝福して去らせたので、彼らはその天幕に帰った。"},{"ref":"Josh.22.7","start":6022007,"end":6022007,"break":"paragraph","ruby":[[4,2,"ぶぞく"],[7,1,"なか"],[24,2,"しょゆう"],[26,1,"ち"],[28,1,"あた"],[33,1,"た"],[35,1,"なか"],[53,1,"がわ"],[55,1,"にし"],[57,1,"ほう"],[62,2,"きょうだい"],[71,2,"しょゆう"],[73,1,"ち"],[75,1,"あた"],[85,1,"かれ"],[90,2,"てんまく"],[93,1,"おく"],[98,1,"とき"],[100,1,"かれ"],[103,2,"しゅくふく"]],"text":"マナセの部族の半ばには、すでにモーセがバシャンで所有地を与えたが、他の半ばには、ヨシュアがヨルダンのこちら側、西の方で、その兄弟たちのうちに、所有地を与えた。ヨシュアは、彼らをその天幕に送りかえす時、彼らを祝福して、"},{"ref":"Josh.22.8","start":6022008,"end":6022008,"break":"none","ruby":[[0,1,"い"],[11,1,"おお"],[14,1,"か"],[15,1,"ざい"],[24,1,"かず"],[26,2,"かちく"],[30,1,"きん"],[32,1,"ぎん"],[34,2,"せいどう"],[37,1,"てつ"],[42,1,"おお"],[45,2,"いふく"],[48,1,"も"],[51,2,"てんまく"],[54,1,"かえ"],[57,1,"てき"],[60,1,"え"],[66,1,"もの"],[68,2,"きょうだい"],[73,1,"わ"]],"text":"言った、「あなたがたは多くの貨財と、おびただしい数の家畜と、金、銀、青銅、鉄、および多くの衣服を持って天幕に帰り、敵から獲たぶんどり物を兄弟たちに分けなさい」。"},{"ref":"Josh.22.9","start":6022009,"end":6022009,"break":"none","ruby":[[8,2,"しそん"],[14,2,"しそん"],[24,2,"ぶぞく"],[27,1,"なか"],[31,1,"しゅ"],[40,1,"めい"],[52,2,"じぶん"],[55,2,"しょゆう"],[57,1,"ち"],[69,1,"ち"],[71,1,"い"],[80,1,"ち"],[92,2,"ひとびと"],[95,1,"わか"],[98,1,"かえ"],[101,1,"い"]],"text":"こうしてルベンの子孫、ガドの子孫、およびマナセの部族の半ばは、主がモーセによって命じられたように、すでに自分の所有地となっているギレアデの地に行こうと、カナンの地のシロで、イスラエルの人々と別れて帰って行った。"},{"ref":"Josh.22.10","start":6022010,"end":6022010,"break":"paragraph","ruby":[[4,2,"しそん"],[10,2,"しそん"],[20,2,"ぶぞく"],[23,1,"なか"],[31,1,"ち"],[44,1,"とき"],[48,1,"ところ"],[56,1,"きし"],[62,2,"さいだん"],[65,1,"きず"],[72,1,"おお"],[76,1,"とお"],[80,1,"み"],[83,2,"さいだん"]],"text":"ルベンの子孫、ガドの子孫、およびマナセの部族の半ばが、カナンの地のヨルダンのほとりにきた時、その所で、ヨルダンの岸べに一つの祭壇を築いた。それは大きくて遠くから見える祭壇であった。"},{"ref":"Josh.22.11","start":6022011,"end":6022011,"break":"none","ruby":[[6,2,"ひとびと"],[15,2,"しそん"],[21,2,"しそん"],[31,2,"ぶぞく"],[34,1,"なか"],[42,1,"ち"],[44,2,"こっきょう"],[62,2,"ひとびと"],[65,1,"ぞく"],[68,1,"ほう"],[74,2,"さいだん"],[77,1,"きず"],[88,1,"き"]],"text":"イスラエルの人々は、「ルベンの子孫、ガドの子孫、およびマナセの部族の半ばが、カナンの地の国境、ヨルダンのほとりのイスラエルの人々に属する方で、一つの祭壇を築いた」といううわさを聞いた。"},{"ref":"Josh.22.12","start":6022012,"end":6022012,"break":"none","ruby":[[6,2,"ひとびと"],[13,1,"き"],[27,2,"ひとびと"],[30,1,"ぜん"],[31,2,"かいしゅう"],[37,1,"あつ"],[42,1,"かれ"],[45,1,"ところ"],[47,1,"せ"],[49,1,"のぼ"]],"text":"イスラエルの人々が、それを聞くとひとしく、イスラエルの人々の全会衆はシロに集まって、彼らの所に攻め上ろうとした。"},{"ref":"Josh.22.13","start":6022013,"end":6022013,"break":"paragraph","ruby":[[9,2,"ひとびと"],[13,2,"さいし"],[21,1,"こ"],[32,1,"ち"],[38,2,"しそん"],[44,2,"しそん"],[54,1,"はん"],[55,2,"ぶぞく"],[58,1,"ところ"]],"text":"そしてイスラエルの人々は、祭司エレアザルの子ピネハスをギレアデの地のルベンの子孫、ガドの子孫、およびマナセの半部族の所につかわし、"},{"ref":"Josh.22.14","start":6022014,"end":6022014,"break":"none","ruby":[[6,1,"かく"],[7,2,"ぶぞく"],[15,2,"ふそ"],[18,1,"いえ"],[34,1,"あ"],[39,1,"にん"],[48,1,"かれ"],[50,1,"とも"],[52,1,"い"],[69,2,"しぞく"],[76,2,"ふそ"],[79,1,"いえ"],[86,2,"ひとびと"]],"text":"イスラエルの各部族のうちから、父祖の家のつかさ、ひとりずつをあげて、合わせて十人のつかさたちを、彼と共に行かせた。これらはみなイスラエルの氏族のうちで、父祖の家のかしらたる人々であった。"},{"ref":"Josh.22.15","start":6022015,"end":6022015,"break":"none","ruby":[[0,1,"かれ"],[8,1,"ち"],[10,1,"い"],[17,2,"しそん"],[23,2,"しそん"],[33,1,"はん"],[34,2,"ぶぞく"],[37,1,"かた"],[40,1,"い"]],"text":"彼らはギレアデの地に行き、ルベンの子孫、ガドの子孫、およびマナセの半部族に語って言った、"},{"ref":"Josh.22.16","start":6022016,"end":6022016,"break":"none","ruby":[[1,1,"しゅ"],[3,1,"ぜん"],[4,2,"かいしゅう"],[9,1,"い"],[27,1,"かみ"],[37,1,"おか"],[40,2,"こんにち"],[49,1,"しゅ"],[51,1,"したが"],[59,2,"じぶん"],[68,2,"さいだん"],[71,1,"きず"],[75,2,"こんにち"],[78,1,"しゅ"],[89,2,"なにごと"]],"text":"「主の全会衆はこう言います、『あなたがたがイスラエルの神にむかって、とがを犯し、今日、ひるがえって主に従うことをやめ、自分のために一つの祭壇を築いて、今日、主にそむこうとするのは何事か。"},{"ref":"Josh.22.17","start":6022017,"end":6022017,"break":"none","ruby":[[4,1,"おか"],[7,1,"つみ"],[12,1,"た"],[28,1,"しゅ"],[30,2,"かいしゅう"],[33,1,"わざわい"],[35,1,"くだ"],[45,2,"こんにち"],[53,1,"つみ"],[56,1,"きよ"]],"text":"ペオルで犯した罪で、なお足りないとするのか。それがために主の会衆に災が下ったが、われわれは今日もなお、その罪から清められていない。"},{"ref":"Josh.22.18","start":6022018,"end":6022018,"break":"none","ruby":[[10,2,"こんにち"],[19,1,"しゅ"],[21,1,"したが"],[47,1,"しゅ"],[59,1,"しゅ"],[67,1,"ぜん"],[68,2,"かいしゅう"],[75,1,"いか"]],"text":"しかもあなたがたは、今日、ひるがえって主に従うことをやめようとするのか。あなたがたが、きょう、主にそむくならば、あす、主はイスラエルの全会衆にむかって怒られるであろう。"},{"ref":"Josh.22.19","start":6022019,"end":6022019,"break":"none","ruby":[[8,2,"しょゆう"],[11,1,"ち"],[13,1,"きよ"],[23,1,"しゅ"],[25,2,"まくや"],[28,1,"た"],[33,1,"しゅ"],[35,2,"しょゆう"],[38,1,"ち"],[40,1,"わた"],[55,2,"しょゆう"],[58,1,"ち"],[60,1,"え"],[73,1,"かみ"],[75,1,"しゅ"],[77,2,"さいだん"],[84,2,"じぶん"],[90,2,"さいだん"],[93,1,"きず"],[97,1,"しゅ"],[113,1,"もの"]],"text":"もしあなたがたの所有の地が清くないのであれば、主の幕屋の立っている主の所有の地に渡ってきて、われわれのうちに、所有の地を獲なさい。ただ、われわれの神、主の祭壇のほかに、自分のために祭壇を築いて、主にそむき、またわれわれをそむく者とならせないでください。"},{"ref":"Josh.22.20","start":6022020,"end":6022020,"break":"none","ruby":[[3,1,"こ"],[14,1,"もの"],[23,1,"おか"],[37,1,"ぜん"],[38,2,"かいしゅう"],[42,1,"いか"],[45,1,"のぞ"],[58,1,"つみ"],[63,1,"ほろ"],[66,1,"もの"],[69,1,"かれ"]],"text":"ゼラの子アカンは、のろわれた物について、とがを犯し、それがためイスラエルの全会衆に、怒りが臨んだではないか。またその罪によって滅びた者は、彼ひとりではなかった』」。"},{"ref":"Josh.22.21","start":6022021,"end":6022021,"break":"paragraph","ruby":[[2,1,"とき"],[8,2,"しそん"],[14,2,"しそん"],[24,1,"はん"],[25,2,"ぶぞく"],[35,2,"しぞく"],[44,1,"こた"],[47,1,"い"]],"text":"その時、ルベンの子孫、ガドの子孫、およびマナセの半部族は、イスラエルの氏族のかしらたちに答えて言った、"},{"ref":"Josh.22.22","start":6022022,"end":6022022,"break":"none","ruby":[[1,1,"ちから"],[4,1,"もの"],[6,1,"かみ"],[8,1,"しゅ"],[10,1,"ちから"],[13,1,"もの"],[15,1,"かみ"],[17,1,"しゅ"],[19,1,"しゅ"],[21,1,"し"],[35,1,"し"],[64,1,"しゅ"],[66,1,"つみ"],[68,1,"おか"]],"text":"「力ある者、神、主。力ある者、神、主。主は知ろしめす。イスラエルもまた知らなければならない。もしそれがそむくことであり、あるいは主に罪を犯すことであるならば、きょう、われわれをゆるさないでください。"},{"ref":"Josh.22.23","start":6022023,"end":6022023,"break":"none","ruby":[[5,2,"さいだん"],[8,1,"きず"],[17,1,"しゅ"],[19,1,"したが"],[37,1,"うえ"],[40,2,"はんさい"],[43,2,"そさい"],[64,1,"うえ"],[67,3,"しゅうおんさい"],[71,2,"ぎせい"],[88,1,"しゅ"],[96,1,"つみ"],[98,1,"と"]],"text":"われわれが祭壇を築いたことが、もし主に従うことをやめるためであり、またその上に、燔祭、素祭をささげるためであり、あるいはまたその上に、酬恩祭の犠牲をささげるためであったならば、主みずから、その罪を問いただしてください。"},{"ref":"Josh.22.24","start":6022024,"end":6022024,"break":"none","ruby":[[9,1,"つぎ"],[14,1,"かんが"],[31,1,"ひ"],[43,2,"しそん"],[52,2,"しそん"],[59,1,"い"],[68,1,"し"],[88,1,"かみ"],[90,1,"しゅ"],[96,2,"かんけい"]],"text":"しかし、われわれは次のことを考えてしたのです。すなわち、のちの日になって、あなたがたの子孫が、われわれの子孫にむかって言うことがあるかも知れません、『あなたがたは、イスラエルの神、主と、なんの関係があるのですか。"},{"ref":"Josh.22.25","start":6022025,"end":6022025,"break":"none","ruby":[[4,2,"しそん"],[11,2,"しそん"],[15,1,"しゅ"],[31,1,"あいだ"],[39,1,"さかい"],[53,1,"しゅ"],[55,1,"たみ"],[57,2,"とっけん"],[69,1,"い"],[79,2,"しそん"],[88,2,"しそん"],[92,1,"しゅ"],[94,1,"おが"],[106,1,"し"]],"text":"ルベンの子孫と、ガドの子孫よ、主は、あなたがたと、われわれとの間に、ヨルダンを境とされました。あなたがたは主の民の特権がありません』。こう言って、あなたがたの子孫が、われわれの子孫に、主を拝むことをやめさせるかも知れないので、"},{"ref":"Josh.22.26","start":6022026,"end":6022026,"break":"none","ruby":[[5,1,"い"],[23,2,"さいだん"],[26,1,"きず"],[30,2,"はんさい"],[42,2,"ぎせい"]],"text":"われわれは言いました、『さあ、われわれは一つの祭壇を築こう。燔祭のためではなく、また犠牲のためでもなく、"},{"ref":"Josh.22.27","start":6022027,"end":6022027,"break":"none","ruby":[[15,1,"あいだ"],[25,1,"のち"],[27,2,"しそん"],[30,1,"あいだ"],[33,2,"しょうこ"],[47,2,"はんさい"],[50,2,"ぎせい"],[56,3,"しゅうおんさい"],[64,1,"しゅ"],[66,1,"まえ"],[69,1,"しゅ"],[92,1,"ひ"],[104,2,"しそん"],[113,2,"しそん"],[124,1,"しゅ"],[126,1,"たみ"],[128,2,"とっけん"],[139,1,"い"]],"text":"ただあなたがたと、われわれとの間、およびわれわれの後の子孫の間に、証拠とならせて、われわれが、燔祭と犠牲、および酬恩祭をもって、主の前で、主につとめをするためである。こうすれば、のちの日になって、あなたがたの子孫が、われわれの子孫に、「あなたがたは主の民の特権がありません」とは言わないであろう』。"},{"ref":"Josh.22.28","start":6022028,"end":6022028,"break":"none","ruby":[[7,1,"い"],[17,1,"ひ"],[32,2,"しそん"],[46,1,"い"],[56,1,"とき"],[63,1,"い"],[73,2,"せんぞ"],[76,1,"つく"],[79,1,"しゅ"],[81,2,"さいだん"],[84,1,"かた"],[96,2,"はんさい"],[108,2,"ぎせい"],[131,1,"あいだ"],[133,2,"しょうこ"]],"text":"またわれわれは言いました、『のちの日に、われわれ、またわれわれの子孫が、もしそのようなことを言われるならば、その時、われわれは言おう、「われわれの先祖が造った主の祭壇の型をごらんなさい。これは燔祭のためではなく、また犠牲のためでもなく、あなたがたと、われわれとの間の証拠である」。"},{"ref":"Josh.22.29","start":6022029,"end":6022029,"break":"none","ruby":[[0,1,"しゅ"],[12,2,"こんにち"],[15,1,"しゅ"],[17,1,"したが"],[31,1,"かみ"],[33,1,"しゅ"],[35,2,"まくや"],[38,1,"まえ"],[42,2,"さいだん"],[49,2,"はんさい"],[52,2,"そさい"],[58,2,"ぎせい"],[68,2,"さいだん"],[71,1,"きず"],[80,1,"けっ"]],"text":"主にそむき、ひるがえって今日、主に従うことをやめて、われわれの神、主の幕屋の前にある祭壇のほかに、燔祭、素祭、または犠牲をささげるための祭壇を築くようなことは、決していたしません』」。"},{"ref":"Josh.22.30","start":6022030,"end":6022030,"break":"paragraph","ruby":[[0,2,"さいし"],[10,2,"かいしゅう"],[23,1,"かれ"],[25,1,"とも"],[27,1,"い"],[36,2,"しぞく"],[50,2,"しそん"],[56,2,"しそん"],[66,2,"しそん"],[69,1,"かた"],[72,2,"ことば"],[75,1,"き"],[82,1,"よ"]],"text":"祭司ピネハス、および会衆のつかさたち、すなわち彼と共に行ったイスラエルの氏族のかしらたちは、ルベンの子孫、ガドの子孫、およびマナセの子孫が語った言葉を聞いて、それを良しとした。"},{"ref":"Josh.22.31","start":6022031,"end":6022031,"break":"none","ruby":[[3,2,"さいし"],[11,1,"こ"],[22,2,"しそん"],[28,2,"しそん"],[38,2,"しそん"],[41,1,"い"],[46,2,"こんにち"],[55,1,"しゅ"],[71,1,"し"],[82,1,"しゅ"],[94,1,"おか"],[112,1,"いま"],[120,2,"ひとびと"],[124,1,"しゅ"],[126,1,"て"],[129,1,"すく"],[131,1,"だ"]],"text":"そして祭司エレアザルの子ピネハスは、ルベンの子孫、ガドの子孫、およびマナセの子孫に言った、「今日、われわれは、主がわれわれのうちにいますことを知った。あなたがたが、主にむかって、このとがを犯さなかったからである。あなたがたは今、イスラエルの人々を、主の手から救い出したのです」。"},{"ref":"Josh.22.32","start":6022032,"end":6022032,"break":"paragraph","ruby":[[4,2,"さいし"],[12,1,"こ"],[30,2,"しそん"],[39,2,"しそん"],[42,1,"わか"],[51,1,"ち"],[58,1,"ち"],[60,1,"かえ"],[69,2,"ひとびと"],[76,1,"い"],[79,2,"ふくめい"]],"text":"こうして祭司エレアザルの子ピネハスと、つかさたちは、ルベンの子孫、およびガドの子孫に別れて、ギレアデの地からカナンの地に帰り、イスラエルの人々のところに行って復命したので、"},{"ref":"Josh.22.33","start":6022033,"end":6022033,"break":"none","ruby":[[6,2,"ひとびと"],[12,1,"よ"],[27,2,"ひとびと"],[30,1,"かみ"],[42,2,"しそん"],[51,2,"しそん"],[54,1,"す"],[59,1,"くに"],[61,1,"ほろ"],[67,1,"せ"],[69,1,"のぼ"],[78,1,"い"]],"text":"イスラエルの人々はそれを良しとした。そしてイスラエルの人々は神をほめたたえ、ルベンの子孫、およびガドの子孫の住んでいる国を滅ぼすために攻め上ろうとは、もはや言わなかった。"},{"ref":"Josh.22.34","start":6022034,"end":6022034,"break":"none","ruby":[[4,2,"しそん"],[10,2,"しそん"],[16,2,"さいだん"],[25,1,"な"],[29,1,"い"],[43,1,"あいだ"],[49,1,"しゅ"],[51,1,"かみ"]],"text":"ルベンの子孫とガドの子孫は、その祭壇を「あかし」と名づけて言った、「これは、われわれの間にあって、主が神にいますというあかしをするものである」。"}]