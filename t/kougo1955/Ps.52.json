[{"ref":"Ps.52.1","start":19052001,"end":19052001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデのマスキールの歌。これはエドムびとドエグがサウルにきて、「ダビデはアヒメレクの家にきた」と告げたときにダビデがよんだもの","breaks":[[13,"line"],[32,"line"]],"ruby":[[0,1,"ちから"],[3,1,"もの"],[6,1,"なに"],[13,1,"かみ"],[15,1,"うやま"],[17,1,"ひと"],[19,1,"あた"],[22,1,"わざわい"],[27,1,"ほこ"],[40,1,"ひと"],[42,1,"ほろ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[26,1,"うた"],[58,1,"いえ"],[64,1,"つ"]],"text":"力ある者よ、何ゆえあなたは神を敬う人に与えた災について誇るのか。あなたはひねもす人を滅ぼすことをたくらむ。"},{"ref":"Ps.52.2","start":19052002,"end":19052002,"break":"line","ruby":[[0,2,"きょぎ"],[3,1,"おこな"],[5,1,"もの"],[12,1,"した"],[14,1,"するど"]],"text":"虚偽を行う者よ、あなたの舌は鋭いかみそりのようだ。"},{"ref":"Ps.52.3","start":19052003,"end":19052003,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"ぜん"],[8,1,"あく"],[10,1,"この"],[17,1,"かた"],[22,1,"いつわ"],[25,1,"かた"],[30,1,"この"]],"text":"あなたは善よりも悪を好み、まことを語るよりも偽りを語ることを好む。〔セラ"},{"ref":"Ps.52.4","start":19052004,"end":19052004,"break":"line","ruby":[[0,1,"あざむ"],[3,1,"した"],[14,1,"ほろ"],[17,2,"ことば"],[20,1,"この"]],"text":"欺きの舌よ、あなたはすべての滅ぼす言葉を好む。"},{"ref":"Ps.52.5","start":19052005,"end":19052005,"break":"line","breaks":[[17,"line"],[36,"line"]],"ruby":[[3,1,"かみ"],[14,1,"くだ"],[21,1,"とら"],[27,2,"てんまく"],[31,1,"ひ"],[33,1,"はな"],[36,1,"い"],[39,1,"もの"],[41,1,"ち"],[49,1,"ね"],[51,1,"た"]],"text":"しかし神はとこしえにあなたを砕き、あなたを捕えて、その天幕から引き離し、生ける者の地から、あなたの根を絶やされる。〔セラ"},{"ref":"Ps.52.6","start":19052006,"end":19052006,"break":"line","ruby":[[0,1,"ただ"],[3,1,"もの"],[8,1,"み"],[10,1,"おそ"],[13,1,"かれ"],[15,1,"わら"],[18,1,"い"]],"text":"正しい者はこれを見て恐れ、彼を笑って言うであろう、"},{"ref":"Ps.52.7","start":19052007,"end":19052007,"break":"line","breaks":[[25,"line"]],"ruby":[[1,1,"かみ"],[6,1,"さ"],[8,1,"どころ"],[15,1,"とみ"],[17,1,"ゆた"],[22,1,"たの"],[27,1,"たから"],[29,1,"よ"],[31,1,"たの"],[33,1,"ひと"],[35,1,"み"]],"text":"「神をおのが避け所とせず、その富の豊かなるを頼み、その宝に寄り頼む人を見よ」と。"},{"ref":"Ps.52.8","start":19052008,"end":19052008,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[8,1,"かみ"],[10,1,"いえ"],[14,1,"みどり"],[20,1,"き"],[30,2,"よよ"],[37,1,"かみ"],[45,1,"たの"]],"text":"しかし、わたしは神の家にある緑のオリブの木のようだ。わたしは世々かぎりなく神のいつくしみを頼む。"},{"ref":"Ps.52.9","start":19052009,"end":19052009,"break":"line","breaks":[[15,"line"],[33,"line"],[51,"line"]],"ruby":[[6,1,"こと"],[29,2,"かんしゃ"],[33,2,"せいと"],[36,1,"まえ"],[43,1,"な"],[47,1,"しめ"]],"text":"あなたがこの事をなされたので、わたしはとこしえに、あなたに感謝し、聖徒の前であなたのみ名をふれ示そう。これはよいことだからである。"}]