[{"ref":"Gen.33.1","start":1033001,"end":1033001,"break":"paragraph","ruby":[[6,1,"め"],[17,1,"にん"],[19,1,"ひき"],[22,1,"く"],[26,1,"み"],[32,1,"かれ"],[34,2,"こども"],[39,1,"わ"]],"text":"さてヤコブは目をあげ、エサウが四百人を率いて来るのを見た。そこで彼は子供たちを分けてレアとラケルとふたりのつかえめとにわたし、"},{"ref":"Gen.33.2","start":1033002,"end":1033002,"break":"none","ruby":[[7,1,"こ"],[8,1,"とも"],[14,1,"さき"],[16,1,"お"],[24,1,"こ"],[25,1,"とも"],[29,1,"つぎ"],[31,1,"お"],[42,2,"さいご"],[45,1,"お"]],"text":"つかえめとその子供たちをまっ先に置き、レアとその子供たちを次に置き、ラケルとヨセフを最後に置いて、"},{"ref":"Gen.33.3","start":1033003,"end":1033003,"break":"none","ruby":[[4,1,"かれ"],[7,1,"まえ"],[9,1,"すす"],[15,1,"み"],[17,1,"ち"],[24,1,"あに"],[26,1,"ちか"]],"text":"みずから彼らの前に進み、七たび身を地にかがめて、兄に近づいた。"},{"ref":"Gen.33.4","start":1033004,"end":1033004,"break":"paragraph","ruby":[[7,1,"はし"],[12,1,"むか"],[15,1,"かれ"],[17,1,"だ"],[29,1,"くち"],[34,1,"とも"],[36,1,"な"]],"text":"するとエサウは走ってきて迎え、彼を抱き、そのくびをかかえて口づけし、共に泣いた。"},{"ref":"Gen.33.5","start":1033005,"end":1033005,"break":"none","ruby":[[4,1,"め"],[9,1,"おんな"],[11,2,"こども"],[16,1,"み"],[18,1,"い"],[27,2,"いっしょ"],[36,1,"もの"],[49,1,"い"],[54,1,"かみ"],[60,1,"さづ"],[65,2,"こども"]],"text":"エサウは目をあげて女と子供たちを見て言った、「あなたと一緒にいるこれらの者はだれですか」。ヤコブは言った、「神がしもべに授けられた子供たちです」。"},{"ref":"Gen.33.6","start":1033006,"end":1033006,"break":"none","ruby":[[12,1,"こ"],[13,1,"とも"],[17,1,"とも"],[19,2,"ちかよ"],[24,2,"じぎ"]],"text":"そこでつかえめたちはその子供たちと共に近寄ってお辞儀した。"},{"ref":"Gen.33.7","start":1033007,"end":1033007,"break":"none","ruby":[[7,1,"こ"],[8,1,"とも"],[12,1,"とも"],[14,2,"ちかよ"],[19,2,"じぎ"],[35,2,"ちかよ"],[40,2,"じぎ"]],"text":"レアもまたその子供たちと共に近寄ってお辞儀し、それからヨセフとラケルが近寄ってお辞儀した。"},{"ref":"Gen.33.8","start":1033008,"end":1033008,"break":"none","ruby":[[7,1,"い"],[16,2,"であ"],[26,1,"む"],[43,1,"い"],[50,1,"しゅ"],[52,1,"まえ"],[54,1,"めぐ"],[57,1,"え"]],"text":"するとエサウは言った、「わたしが出会ったあのすべての群れはどうしたのですか」。ヤコブは言った、「わが主の前に恵みを得るためです」。"},{"ref":"Gen.33.9","start":1033009,"end":1033009,"break":"none","ruby":[[4,1,"い"],[9,1,"おとうと"],[31,1,"もの"]],"text":"エサウは言った、「弟よ、わたしはじゅうぶんもっている。あなたの物はあなたのものにしなさい」。"},{"ref":"Gen.33.10","start":1033010,"end":1033010,"break":"none","ruby":[[4,1,"い"],[23,1,"まえ"],[25,1,"めぐ"],[28,1,"え"],[41,1,"て"],[44,1,"おく"],[46,1,"もの"],[48,1,"う"],[60,1,"よろこ"],[67,1,"むか"],[81,1,"かお"],[83,1,"み"],[86,1,"かみ"],[88,1,"かお"],[90,1,"み"],[95,1,"おも"]],"text":"ヤコブは言った、「いいえ、もしわたしがあなたの前に恵みを得るなら、どうか、わたしの手から贈り物を受けてください。あなたが喜んでわたしを迎えてくださるので、あなたの顔を見て、神の顔を見るように思います。"},{"ref":"Gen.33.11","start":1033011,"end":1033011,"break":"none","ruby":[[7,1,"も"],[12,1,"おく"],[14,1,"もの"],[16,1,"う"],[24,1,"かみ"],[30,1,"めぐ"],[60,1,"かれ"],[68,1,"かれ"],[70,1,"う"],[72,1,"と"]],"text":"どうかわたしが持ってきた贈り物を受けてください。神がわたしを恵まれたので、わたしはじゅうぶんもっていますから」。こうして彼がしいたので、彼は受け取った。"},{"ref":"Gen.33.12","start":1033012,"end":1033012,"break":"paragraph","ruby":[[7,1,"い"],[15,1,"た"],[18,1,"い"],[26,1,"さき"],[28,1,"い"]],"text":"そしてエサウは言った、「さあ、立って行こう。わたしが先に行く」。"},{"ref":"Gen.33.13","start":1033013,"end":1033013,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[20,2,"こども"],[33,1,"ちち"],[35,1,"の"],[41,1,"ひつじ"],[43,1,"うし"],[49,2,"せわ"],[61,1,"にち"],[64,1,"ある"],[67,1,"す"],[71,1,"む"],[76,1,"し"]],"text":"ヤコブは彼に言った、「ごぞんじのように、子供たちは、かよわく、また乳を飲ませている羊や牛をわたしが世話をしています。もし一日でも歩かせ過ぎたら群れはみな死んでしまいます。"},{"ref":"Gen.33.14","start":1033014,"end":1033014,"break":"none","ruby":[[2,1,"しゅ"],[13,1,"さき"],[31,1,"まえ"],[35,2,"かちく"],[38,2,"こども"],[43,1,"あゆ"],[46,1,"あ"],[55,1,"ある"],[58,1,"い"],[67,1,"しゅ"],[69,2,"いっしょ"]],"text":"わが主よ、どうか、しもべの先においでください。わたしはわたしの前にいる家畜と子供たちの歩みに合わせて、ゆっくり歩いて行き、セイルでわが主と一緒になりましょう」。"},{"ref":"Gen.33.15","start":1033015,"end":1033015,"break":"paragraph","ruby":[[4,1,"い"],[17,1,"つ"],[22,1,"もの"],[28,1,"いく"],[29,1,"ひと"],[39,1,"のこ"],[51,1,"い"],[64,1,"およ"],[72,1,"しゅ"],[74,1,"まえ"],[76,1,"めぐ"],[79,1,"え"]],"text":"エサウは言った、「それならわたしが連れている者どものうち幾人かをあなたのもとに残しましょう」。ヤコブは言った、「いいえ、それには及びません。わが主の前に恵みを得させてください」。"},{"ref":"Gen.33.16","start":1033016,"end":1033016,"break":"none","ruby":[[2,1,"ひ"],[12,2,"きと"]],"text":"その日エサウはセイルへの帰途についた。"},{"ref":"Gen.33.17","start":1033017,"end":1033017,"break":"none","ruby":[[4,1,"た"],[11,1,"い"],[14,2,"じぶん"],[20,1,"いえ"],[22,1,"た"],[27,2,"かちく"],[33,2,"こや"],[36,1,"つく"],[48,1,"ところ"],[50,1,"な"],[56,1,"よ"]],"text":"ヤコブは立ってスコテに行き、自分のために家を建て、また家畜のために小屋を造った。これによってその所の名はスコテと呼ばれている。"},{"ref":"Gen.33.18","start":1033018,"end":1033018,"break":"paragraph","ruby":[[19,2,"ぶじ"],[25,1,"ち"],[31,1,"まち"],[33,1,"つ"],[36,1,"まち"],[38,1,"まえ"],[40,2,"しゅくえい"]],"text":"こうしてヤコブはパダンアラムからきて、無事カナンの地のシケムの町に着き、町の前に宿営した。"},{"ref":"Gen.33.19","start":1033019,"end":1033019,"break":"none","ruby":[[0,1,"かれ"],[2,2,"てんまく"],[5,1,"は"],[8,1,"の"],[10,2,"いちぶ"],[17,1,"ちち"],[22,1,"こ"],[25,1,"て"],[33,1,"か"],[35,1,"と"]],"text":"彼は天幕を張った野の一部をシケムの父ハモルの子らの手から百ケシタで買い取り、"},{"ref":"Gen.33.20","start":1033020,"end":1033020,"break":"none","ruby":[[3,2,"さいだん"],[6,1,"た"],[26,1,"な"]],"text":"そこに祭壇を建てて、これをエル・エロヘ・イスラエルと名づけた。"}]