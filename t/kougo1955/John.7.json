[{"ref":"John.7.1","start":43007001,"end":43007001,"break":"paragraph","ruby":[[14,2,"じゅんかい"],[26,1,"じん"],[30,2,"じぶん"],[33,1,"ころ"],[48,2,"じゅんかい"]],"text":"そののち、イエスはガリラヤを巡回しておられた。ユダヤ人たちが自分を殺そうとしていたので、ユダヤを巡回しようとはされなかった。"},{"ref":"John.7.2","start":43007002,"end":43007002,"break":"none","ruby":[[0,1,"とき"],[6,1,"じん"],[8,2,"かりいお"],[11,1,"まつり"],[13,1,"ちか"]],"text":"時に、ユダヤ人の仮庵の祭が近づいていた。"},{"ref":"John.7.3","start":43007003,"end":43007003,"break":"none","ruby":[[8,2,"きょうだい"],[17,1,"い"],[35,2,"でし"],[41,1,"み"],[51,1,"さ"],[57,1,"い"]],"text":"そこで、イエスの兄弟たちがイエスに言った、「あなたがしておられるわざを弟子たちにも見せるために、ここを去りユダヤに行ってはいかがです。"},{"ref":"John.7.4","start":43007004,"end":43007004,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"おおやけ"],[12,1,"おも"],[17,1,"ひと"],[20,1,"かく"],[23,2,"しごと"],[55,2,"じぶん"],[63,1,"よ"]],"text":"自分を公けにあらわそうと思っている人で、隠れて仕事をするものはありません。あなたがこれらのことをするからには、自分をはっきりと世にあらわしなさい」。"},{"ref":"John.7.5","start":43007005,"end":43007005,"break":"none","ruby":[[2,1,"い"],[8,2,"きょうだい"],[17,1,"しん"]],"text":"こう言ったのは、兄弟たちもイエスを信じていなかったからである。"},{"ref":"John.7.6","start":43007006,"end":43007006,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[20,1,"とき"],[40,1,"とき"],[45,1,"そな"]],"text":"そこでイエスは彼らに言われた、「わたしの時はまだきていない。しかし、あなたがたの時はいつも備わっている。"},{"ref":"John.7.7","start":43007007,"end":43007007,"break":"none","ruby":[[0,1,"よ"],[8,1,"にく"],[10,1,"え"],[19,1,"にく"],[29,1,"よ"],[36,1,"わる"]],"text":"世はあなたがたを憎み得ないが、わたしを憎んでいる。わたしが世のおこないの悪いことを、あかししているからである。"},{"ref":"John.7.8","start":43007008,"end":43007008,"break":"none","ruby":[[7,1,"まつり"],[9,1,"い"],[21,1,"まつり"],[24,1,"い"],[33,1,"とき"],[37,1,"み"]],"text":"あなたがたこそ祭に行きなさい。わたしはこの祭には行かない。わたしの時はまだ満ちていないから」。"},{"ref":"John.7.9","start":43007009,"end":43007009,"break":"none","ruby":[[0,1,"かれ"],[5,1,"い"]],"text":"彼らにこう言って、イエスはガリラヤにとどまっておられた。"},{"ref":"John.7.10","start":43007010,"end":43007010,"break":"paragraph","ruby":[[4,2,"きょうだい"],[9,1,"まつり"],[11,1,"い"],[22,2,"ひとめ"],[36,1,"い"]],"text":"しかし、兄弟たちが祭に行ったあとで、イエスも人目にたたぬように、ひそかに行かれた。"},{"ref":"John.7.11","start":43007011,"end":43007011,"break":"none","ruby":[[3,1,"じん"],[6,1,"まつり"],[8,1,"とき"],[14,1,"ひと"],[25,1,"い"],[33,1,"さが"]],"text":"ユダヤ人らは祭の時に、「あの人はどこにいるのか」と言って、イエスを捜していた。"},{"ref":"John.7.12","start":43007012,"end":43007012,"break":"none","ruby":[[0,2,"ぐんしゅう"],[3,1,"なか"],[22,1,"た"],[28,2,"ひとびと"],[38,1,"ひと"],[42,1,"い"],[45,1,"た"],[47,2,"ひとびと"],[58,2,"ぐんしゅう"],[61,1,"まど"],[69,1,"い"]],"text":"群衆の中に、イエスについていろいろとうわさが立った。ある人々は、「あれはよい人だ」と言い、他の人々は、「いや、あれは群衆を惑わしている」と言った。"},{"ref":"John.7.13","start":43007013,"end":43007013,"break":"none","ruby":[[7,1,"じん"],[10,1,"おそ"],[21,2,"こうぜん"],[24,1,"くち"],[28,1,"もの"]],"text":"しかし、ユダヤ人らを恐れて、イエスのことを公然と口にする者はいなかった。"},{"ref":"John.7.14","start":43007014,"end":43007014,"break":"paragraph","ruby":[[0,1,"まつり"],[2,1,"なか"],[15,1,"みや"],[17,1,"のぼ"],[20,1,"おし"],[22,1,"はじ"]],"text":"祭も半ばになってから、イエスは宮に上って教え始められた。"},{"ref":"John.7.15","start":43007015,"end":43007015,"break":"none","ruby":[[7,1,"じん"],[11,1,"おどろ"],[14,1,"い"],[21,1,"ひと"],[23,2,"がくもん"],[40,2,"りっぽう"],[43,2,"ちしき"]],"text":"すると、ユダヤ人たちは驚いて言った、「この人は学問をしたこともないのに、どうして律法の知識をもっているのだろう」。"},{"ref":"John.7.16","start":43007016,"end":43007016,"break":"none","ruby":[[7,1,"かれ"],[10,1,"こた"],[13,1,"い"],[23,1,"おしえ"],[28,2,"じしん"],[31,1,"おしえ"],[50,1,"おしえ"]],"text":"そこでイエスは彼らに答えて言われた、「わたしの教はわたし自身の教ではなく、わたしをつかわされたかたの教である。"},{"ref":"John.7.17","start":43007017,"end":43007017,"break":"none","ruby":[[0,1,"かみ"],[7,1,"おこな"],[11,1,"おも"],[13,1,"もの"],[28,1,"かた"],[35,1,"おしえ"],[37,1,"かみ"],[53,2,"じしん"],[57,1,"で"]],"text":"神のみこころを行おうと思う者であれば、だれでも、わたしの語っているこの教が神からのものか、それとも、わたし自身から出たものか、わかるであろう。"},{"ref":"John.7.18","start":43007018,"end":43007018,"break":"none","ruby":[[0,2,"じぶん"],[4,1,"で"],[9,1,"かた"],[11,1,"もの"],[14,2,"じぶん"],[17,2,"えいこう"],[20,1,"もと"],[25,2,"じぶん"],[37,2,"えいこう"],[40,1,"もと"],[43,1,"もの"],[45,2,"しんじつ"],[54,1,"ひと"],[56,1,"うち"],[59,1,"いつわ"]],"text":"自分から出たことを語る者は、自分の栄光を求めるが、自分をつかわされたかたの栄光を求める者は真実であって、その人の内には偽りがない。"},{"ref":"John.7.19","start":43007019,"end":43007019,"break":"none","ruby":[[10,2,"りっぽう"],[13,1,"あた"],[41,2,"りっぽう"],[44,1,"おこな"],[46,1,"もの"],[68,1,"ころ"],[72,1,"おも"]],"text":"モーセはあなたがたに律法を与えたではないか。それだのに、あなたがたのうちには、その律法を行う者がひとりもない。あなたがたは、なぜわたしを殺そうと思っているのか」。"},{"ref":"John.7.20","start":43007020,"end":43007020,"break":"none","ruby":[[0,2,"ぐんしゅう"],[3,1,"こた"],[12,2,"あくれい"],[15,1,"と"],[31,1,"ころ"],[35,1,"おも"]],"text":"群衆は答えた、「あなたは悪霊に取りつかれている。だれがあなたを殺そうと思っているものか」。"},{"ref":"John.7.21","start":43007021,"end":43007021,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[10,1,"い"],[38,1,"みな"],[42,1,"み"],[44,1,"おどろ"]],"text":"イエスは彼らに答えて言われた、「わたしが一つのわざをしたところ、あなたがたは皆それを見て驚いている。"},{"ref":"John.7.22","start":43007022,"end":43007022,"break":"none","ruby":[[10,2,"かつれい"],[13,1,"めい"],[24,1,"じつ"],[32,1,"はじ"],[42,2,"せんぞ"],[48,1,"はじ"],[64,3,"あんそくにち"],[69,1,"ひと"],[71,2,"かつれい"],[74,1,"ほどこ"]],"text":"モーセはあなたがたに割礼を命じたので、（これは、実は、モーセから始まったのではなく、先祖たちから始まったものである）あなたがたは安息日にも人に割礼を施している。"},{"ref":"John.7.23","start":43007023,"end":43007023,"break":"none","ruby":[[7,2,"りっぽう"],[10,1,"やぶ"],[19,3,"あんそくにち"],[27,2,"かつれい"],[30,1,"う"],[37,3,"あんそくにち"],[41,1,"ひと"],[43,2,"ぜんしん"],[46,2,"じょうぶ"]],"text":"もし、モーセの律法が破られないように、安息日であっても割礼を受けるのなら、安息日に人の全身を丈夫にしてやったからといって、どうして、そんなにおこるのか。"},{"ref":"John.7.24","start":43007024,"end":43007024,"break":"none","ruby":[[4,1,"ひと"],[13,1,"ただ"]],"text":"うわべで人をさばかないで、正しいさばきをするがよい」。"},{"ref":"John.7.25","start":43007025,"end":43007025,"break":"paragraph","ruby":[[11,1,"ひと"],[15,1,"い"],[22,1,"ひと"],[24,2,"ひとびと"],[27,1,"ころ"],[31,1,"おも"],[36,1,"もの"]],"text":"さて、エルサレムのある人たちが言った、「この人は人々が殺そうと思っている者ではないか。"},{"ref":"John.7.26","start":43007026,"end":43007026,"break":"none","ruby":[[0,1,"み"],[3,1,"かれ"],[5,2,"こうぜん"],[8,1,"かた"],[16,2,"ひとびと"],[22,1,"たい"],[25,1,"なに"],[27,1,"い"],[32,2,"やくにん"],[40,1,"ひと"],[58,1,"し"]],"text":"見よ、彼は公然と語っているのに、人々はこれに対して何も言わない。役人たちは、この人がキリストであることを、ほんとうに知っているのではなかろうか。"},{"ref":"John.7.27","start":43007027,"end":43007027,"break":"none","ruby":[[8,1,"ひと"],[18,1,"し"],[33,1,"あらわ"],[36,1,"とき"],[44,1,"く"],[48,1,"し"],[53,1,"もの"]],"text":"わたしたちはこの人がどこからきたのか知っている。しかし、キリストが現れる時には、どこから来るのか知っている者は、ひとりもいない」。"},{"ref":"John.7.28","start":43007028,"end":43007028,"break":"none","ruby":[[4,1,"みや"],[6,1,"うち"],[8,1,"おし"],[14,1,"さけ"],[17,1,"い"],[34,1,"し"],[55,1,"し"],[69,2,"じぶん"],[94,2,"しんじつ"],[113,1,"し"]],"text":"イエスは宮の内で教えながら、叫んで言われた、「あなたがたは、わたしを知っており、また、わたしがどこからきたかも知っている。しかし、わたしは自分からきたのではない。わたしをつかわされたかたは真実であるが、あなたがたは、そのかたを知らない。"},{"ref":"John.7.29","start":43007029,"end":43007029,"break":"none","ruby":[[10,1,"し"],[31,1,"もの"]],"text":"わたしは、そのかたを知っている。わたしはそのかたのもとからきた者で、そのかたがわたしをつかわされたのである」。"},{"ref":"John.7.30","start":43007030,"end":43007030,"break":"none","ruby":[[3,2,"ひとびと"],[10,1,"とら"],[15,1,"はか"],[25,1,"て"],[30,1,"もの"],[41,1,"とき"]],"text":"そこで人々はイエスを捕えようと計ったが、だれひとり手をかける者はなかった。イエスの時が、まだきていなかったからである。"},{"ref":"John.7.31","start":43007031,"end":43007031,"break":"none","ruby":[[4,2,"ぐんしゅう"],[7,1,"なか"],[9,1,"おお"],[12,1,"もの"],[19,1,"しん"],[22,1,"い"],[38,1,"ひと"],[40,1,"おこな"],[46,1,"おお"],[53,1,"おこな"]],"text":"しかし、群衆の中の多くの者が、イエスを信じて言った、「キリストがきても、この人が行ったよりも多くのしるしを行うだろうか」。"},{"ref":"John.7.32","start":43007032,"end":43007032,"break":"paragraph","ruby":[[0,2,"ぐんしゅう"],[30,1,"びと"],[34,1,"みみ"],[43,3,"さいしちょう"],[53,1,"びと"],[62,1,"とら"],[70,2,"したやく"]],"text":"群衆がイエスについてこのようなうわさをしているのを、パリサイ人たちは耳にした。そこで、祭司長たちやパリサイ人たちは、イエスを捕えようとして、下役どもをつかわした。"},{"ref":"John.7.33","start":43007033,"end":43007033,"break":"none","ruby":[[4,1,"い"],[10,1,"いま"],[16,1,"あいだ"],[28,2,"いっしょ"],[59,1,"い"]],"text":"イエスは言われた、「今しばらくの間、わたしはあなたがたと一緒にいて、それから、わたしをおつかわしになったかたのみもとに行く。"},{"ref":"John.7.34","start":43007034,"end":43007034,"break":"none","ruby":[[10,1,"さが"],[18,1,"み"],[39,1,"ところ"],[48,1,"く"]],"text":"あなたがたはわたしを捜すであろうが、見つけることはできない。そしてわたしのいる所に、あなたがたは来ることができない」。"},{"ref":"John.7.35","start":43007035,"end":43007035,"break":"none","ruby":[[6,1,"じん"],[10,1,"たがい"],[12,1,"い"],[23,1,"み"],[43,1,"い"],[60,1,"じん"],[62,1,"なか"],[64,2,"りさん"],[70,1,"ひと"],[80,1,"い"],[88,1,"じん"],[90,1,"おし"]],"text":"そこでユダヤ人たちは互に言った、「わたしたちが見つけることができないというのは、どこへ行こうとしているのだろう。ギリシヤ人の中に離散している人たちのところにでも行って、ギリシヤ人を教えようというのだろうか。"},{"ref":"John.7.36","start":43007036,"end":43007036,"break":"none","ruby":[[8,1,"さが"],[12,1,"み"],[33,1,"ところ"],[36,1,"く"],[50,1,"い"],[55,2,"ことば"],[63,2,"いみ"]],"text":"また、『わたしを捜すが、見つけることはできない。そしてわたしのいる所には来ることができないだろう』と言ったその言葉は、どういう意味だろう」。"},{"ref":"John.7.37","start":43007037,"end":43007037,"break":"paragraph","ruby":[[0,1,"まつり"],[2,1,"おわ"],[5,2,"だいじ"],[8,1,"ひ"],[15,1,"た"],[19,1,"さけ"],[22,1,"い"],[35,1,"もの"],[48,1,"の"]],"text":"祭の終りの大事な日に、イエスは立って、叫んで言われた、「だれでもかわく者は、わたしのところにきて飲むがよい。"},{"ref":"John.7.38","start":43007038,"end":43007038,"break":"none","ruby":[[4,1,"しん"],[7,1,"もの"],[10,2,"せいしょ"],[13,1,"か"],[24,1,"はら"],[27,1,"い"],[30,1,"みず"],[32,1,"かわ"],[37,1,"な"],[39,1,"で"]],"text":"わたしを信じる者は、聖書に書いてあるとおり、その腹から生ける水が川となって流れ出るであろう」。"},{"ref":"John.7.39","start":43007039,"end":43007039,"break":"none","ruby":[[8,1,"しん"],[11,2,"ひとびと"],[14,1,"う"],[23,2,"みたま"],[29,1,"い"],[49,2,"えいこう"],[52,1,"う"],[65,2,"みたま"],[70,1,"くだ"]],"text":"これは、イエスを信じる人々が受けようとしている御霊をさして言われたのである。すなわち、イエスはまだ栄光を受けておられなかったので、御霊がまだ下っていなかったのである。"},{"ref":"John.7.40","start":43007040,"end":43007040,"break":"none","ruby":[[0,2,"ぐんしゅう"],[5,1,"もの"],[11,2,"ことば"],[14,1,"き"],[33,3,"よげんしゃ"],[41,1,"い"]],"text":"群衆のある者がこれらの言葉を聞いて、「このかたは、ほんとうに、あの預言者である」と言い、"},{"ref":"John.7.41","start":43007041,"end":43007041,"break":"none","ruby":[[3,1,"ひと"],[22,1,"い"],[30,2,"ひとびと"],[51,1,"で"]],"text":"ほかの人たちは「このかたはキリストである」と言い、また、ある人々は、「キリストはまさか、ガリラヤからは出てこないだろう。"},{"ref":"John.7.42","start":43007042,"end":43007042,"break":"none","ruby":[[10,2,"しそん"],[29,1,"むら"],[32,1,"で"],[36,2,"せいしょ"],[39,1,"か"],[51,1,"い"]],"text":"キリストは、ダビデの子孫から、またダビデのいたベツレヘムの村から出ると、聖書に書いてあるではないか」と言った。"},{"ref":"John.7.43","start":43007043,"end":43007043,"break":"none","ruby":[[5,2,"ぐんしゅう"],[8,1,"あいだ"],[17,2,"ぶんそう"],[20,1,"しょう"]],"text":"こうして、群衆の間にイエスのことで分争が生じた。"},{"ref":"John.7.44","start":43007044,"end":43007044,"break":"none","ruby":[[0,1,"かれ"],[8,2,"ひとびと"],[16,1,"とら"],[21,1,"おも"],[31,1,"て"],[36,1,"もの"]],"text":"彼らのうちのある人々は、イエスを捕えようと思ったが、だれひとり手をかける者はなかった。"},{"ref":"John.7.45","start":43007045,"end":43007045,"break":"paragraph","ruby":[[3,2,"したやく"],[8,3,"さいしちょう"],[18,1,"びと"],[26,1,"かえ"],[34,1,"かれ"],[39,2,"したやく"],[44,1,"い"],[54,1,"ひと"],[56,1,"つ"]],"text":"さて、下役どもが祭司長たちやパリサイ人たちのところに帰ってきたので、彼らはその下役どもに言った、「なぜ、あの人を連れてこなかったのか」。"},{"ref":"John.7.46","start":43007046,"end":43007046,"break":"none","ruby":[[0,2,"したやく"],[5,1,"こた"],[12,1,"ひと"],[14,1,"かた"],[19,1,"かた"],[22,1,"もの"]],"text":"下役どもは答えた、「この人の語るように語った者は、これまでにありませんでした」。"},{"ref":"John.7.47","start":43007047,"end":43007047,"break":"none","ruby":[[4,1,"びと"],[8,1,"かれ"],[11,1,"こた"]],"text":"パリサイ人たちが彼らに答えた、「あなたがたまでが、だまされているのではないか。"},{"ref":"John.7.48","start":43007048,"end":43007048,"break":"none","ruby":[[0,2,"やくにん"],[9,1,"びと"],[13,1,"なか"],[21,1,"かれ"],[23,1,"しん"],[26,1,"もの"]],"text":"役人たちやパリサイ人たちの中で、ひとりでも彼を信じた者があっただろうか。"},{"ref":"John.7.49","start":43007049,"end":43007049,"break":"none","ruby":[[0,2,"りっぽう"],[11,2,"ぐんしゅう"]],"text":"律法をわきまえないこの群衆は、のろわれている」。"},{"ref":"John.7.50","start":43007050,"end":43007050,"break":"none","ruby":[[0,1,"かれ"],[3,1,"なか"],[10,2,"いぜん"],[17,1,"あ"],[33,1,"かれ"],[36,1,"い"]],"text":"彼らの中のひとりで、以前にイエスに会いにきたことのあるニコデモが、彼らに言った、"},{"ref":"John.7.51","start":43007051,"end":43007051,"break":"none","ruby":[[7,2,"りっぽう"],[18,1,"ひと"],[20,1,"い"],[22,1,"ぶん"],[24,1,"き"],[29,1,"ひと"],[36,1,"し"],[39,1,"うえ"]],"text":"「わたしたちの律法によれば、まずその人の言い分を聞き、その人のしたことを知った上でなければ、さばくことをしないのではないか」。"},{"ref":"John.7.52","start":43007052,"end":43007052,"break":"none","breaks":[[65,"paragraph"]],"ruby":[[0,1,"かれ"],[3,1,"こた"],[6,1,"い"],[19,1,"で"],[26,1,"しら"],[41,3,"よげんしゃ"],[45,1,"で"]],"text":"彼らは答えて言った、「あなたもガリラヤ出なのか。よく調べてみなさい、ガリラヤからは預言者が出るものではないことが、わかるだろう」。〔"},{"ref":"John.7.53","start":43007053,"end":43007053,"break":"none","ruby":[[4,2,"ひとびと"],[11,1,"いえ"],[13,1,"かえ"],[16,1,"い"]],"text":"そして、人々はおのおの家に帰って行った。"}]