[{"ref":"Exod.36.1","start":2036001,"end":2036001,"break":"paragraph","ruby":[[16,1,"こころ"],[18,2,"ちえ"],[22,1,"もの"],[28,1,"しゅ"],[30,2,"ちえ"],[33,1,"さと"],[37,1,"さづ"],[41,2,"せいじょ"],[44,2,"くみた"],[48,2,"しょしゅ"],[51,2,"こうじ"],[62,1,"し"],[68,1,"もの"],[74,1,"しゅ"],[76,1,"めい"]],"text":"ベザレルとアホリアブおよびすべて心に知恵ある者、すなわち主が知恵と悟りとを授けて、聖所の組立ての諸種の工事を、いかになすかを知らせられた者は、すべて主が命じられたようにしなければならない」。"},{"ref":"Exod.36.2","start":2036002,"end":2036002,"break":"paragraph","ruby":[[24,1,"こころ"],[26,2,"ちえ"],[30,1,"もの"],[39,1,"こころ"],[41,1,"しゅ"],[43,2,"ちえ"],[46,1,"さづ"],[51,1,"もの"],[60,2,"こうじ"],[67,1,"こころ"],[69,1,"のぞ"],[75,1,"もの"],[77,1,"め"],[79,1,"よ"]],"text":"そこで、モーセはベザレルとアホリアブおよびすべて心に知恵ある者、すなわち、その心に主が知恵を授けられた者、またきて、その工事をなそうと心に望むすべての者を召し寄せた。"},{"ref":"Exod.36.3","start":2036003,"end":2036003,"break":"none","ruby":[[0,1,"かれ"],[3,2,"せいじょ"],[6,2,"くみた"],[10,2,"こうじ"],[25,2,"ひとびと"],[28,1,"たずさ"],[41,1,"もの"],[49,1,"う"],[51,1,"と"],[56,1,"たみ"],[61,1,"あさ"],[66,2,"じはつ"],[72,1,"もの"],[74,1,"かれ"],[79,1,"たずさ"]],"text":"彼らは聖所の組立ての工事をするために、イスラエルの人々が携えてきたもろもろのささげ物を、モーセから受け取ったが、民はなおも朝ごとに、自発のささげ物を彼のもとに携えてきた。"},{"ref":"Exod.36.4","start":2036004,"end":2036004,"break":"none","ruby":[[3,2,"せいじょ"],[11,2,"こうじ"],[16,1,"かしこ"],[18,2,"ひとびと"],[32,2,"こうじ"]],"text":"そこで聖所のもろもろの工事をする賢い人々はみな、おのおのしていた工事をやめて、"},{"ref":"Exod.36.5","start":2036005,"end":2036005,"break":"none","ruby":[[4,1,"い"],[8,1,"たみ"],[14,1,"おお"],[16,1,"たずさ"],[19,1,"く"],[24,1,"しゅ"],[29,1,"めい"],[34,2,"くみた"],[38,2,"こうじ"],[42,1,"あま"]],"text":"モーセに言った「民があまりに多く携えて来るので、主がせよと命じられた組立ての工事には余ります」。"},{"ref":"Exod.36.6","start":2036006,"end":2036006,"break":"none","ruby":[[4,2,"めいれい"],[7,1,"はっ"],[10,2,"しゅくえい"],[12,1,"ちゅう"],[19,1,"い"],[24,1,"おとこ"],[26,1,"おんな"],[32,2,"せいじょ"],[42,1,"もの"],[47,1,"およ"],[56,1,"たみ"],[58,1,"たずさ"],[61,1,"く"]],"text":"モーセは命令を発し、宿営中にふれさせて言った、「男も女も、もはや聖所のために、ささげ物をするに及ばない」。それで民は携えて来ることをやめた。"},{"ref":"Exod.36.7","start":2036007,"end":2036007,"break":"none","ruby":[[0,2,"ざいりょう"],[7,2,"こうじ"],[23,1,"あま"]],"text":"材料はすべての工事をするのにじゅうぶんで、かつ余るからである。"},{"ref":"Exod.36.8","start":2036008,"end":2036008,"break":"paragraph","ruby":[[3,2,"こうさく"],[8,1,"もの"],[13,1,"こころ"],[15,2,"ちえ"],[19,1,"もの"],[23,1,"まい"],[25,1,"まく"],[27,2,"まくや"],[30,1,"つく"],[38,2,"あま"],[41,2,"ねんし"],[44,1,"あお"],[45,1,"いと"],[47,1,"むらさき"],[48,1,"いと"],[50,1,"ひ"],[51,1,"いと"],[53,1,"つく"],[56,1,"たく"],[74,1,"お"],[76,1,"だ"]],"text":"すべて工作をする者のうちの心に知恵ある者は、十枚の幕で幕屋を造った。すなわち亜麻の撚糸、青糸、紫糸、緋糸で造り、巧みなわざをもって、それにケルビムを織り出した。"},{"ref":"Exod.36.9","start":2036009,"end":2036009,"break":"none","ruby":[[0,1,"まく"],[2,1,"なが"],[18,1,"まく"],[20,1,"はば"],[34,1,"まく"],[38,1,"おな"],[40,2,"すんぽう"]],"text":"幕の長さは、おのおの二十八キュビト、幕の幅は、おのおの四キュビトで、幕はみな同じ寸法である。"},{"ref":"Exod.36.10","start":2036010,"end":2036010,"break":"paragraph","ruby":[[2,1,"まく"],[4,1,"まい"],[6,1,"たがい"],[8,1,"つら"],[10,1,"あ"],[16,1,"た"],[19,1,"まい"],[21,1,"まく"],[24,1,"たがい"],[26,1,"つら"],[28,1,"あ"]],"text":"その幕五枚を互に連ね合わせ、また他の五枚の幕をも互に連ね合わせ、"},{"ref":"Exod.36.11","start":2036011,"end":2036011,"break":"none","ruby":[[2,2,"いちれん"],[5,1,"はし"],[9,1,"まく"],[11,1,"ふち"],[13,2,"あおいろ"],[16,1,"ち"],[21,1,"た"],[23,2,"いちれん"],[26,1,"はし"],[30,1,"まく"],[32,1,"ふち"]],"text":"その一連の端にある幕の縁に青色の乳をつけ、他の一連の端にある幕の縁にも、そのようにした。"},{"ref":"Exod.36.12","start":2036012,"end":2036012,"break":"none","ruby":[[3,1,"まい"],[5,1,"まく"],[7,1,"ち"],[14,1,"た"],[16,2,"いちれん"],[19,1,"まく"],[21,1,"はし"],[25,1,"ち"],[35,1,"ち"],[37,1,"たがい"],[39,1,"あい"],[40,1,"む"]],"text":"その一枚の幕に乳五十をつけ、他の一連の幕の端にも、乳五十をつけた。その乳を互に相向かわせた。"},{"ref":"Exod.36.13","start":2036013,"end":2036013,"break":"none","ruby":[[3,1,"きん"],[5,1,"わ"],[9,1,"つく"],[14,1,"わ"],[17,1,"まく"],[19,1,"たがい"],[21,1,"つら"],[23,1,"あ"],[33,2,"まくや"]],"text":"そして金の輪五十を作り、その輪で、幕を互に連ね合わせたので、一つの幕屋になった。"},{"ref":"Exod.36.14","start":2036014,"end":2036014,"break":"paragraph","ruby":[[6,2,"けいと"],[9,1,"まく"],[11,1,"つく"],[14,2,"まくや"],[20,2,"てんまく"],[30,1,"まく"],[33,1,"まい"],[35,1,"つく"]],"text":"また、やぎの毛糸で幕を作り、幕屋をおおう天幕にした。すなわち幕十一枚を作った。"},{"ref":"Exod.36.15","start":2036015,"end":2036015,"break":"none","ruby":[[5,1,"まく"],[7,1,"なが"],[22,1,"まく"],[24,1,"はば"],[37,1,"まい"],[39,1,"まく"],[41,1,"おな"],[43,2,"すんぽう"]],"text":"おのおのの幕の長さは三十キュビト、おのおのの幕の幅は四キュビトで、その十一枚の幕は同じ寸法である。"},{"ref":"Exod.36.16","start":2036016,"end":2036016,"break":"none","ruby":[[6,1,"まく"],[8,1,"まい"],[13,1,"つら"],[15,1,"あ"],[24,1,"まく"],[26,1,"まい"],[31,1,"つら"],[33,1,"あ"]],"text":"そして、その幕五枚を一つに連ね合わせ、また、その幕六枚を一つに連ね合わせ、"},{"ref":"Exod.36.17","start":2036017,"end":2036017,"break":"none","ruby":[[2,2,"いちれん"],[5,1,"はし"],[9,1,"まく"],[11,1,"ふち"],[14,1,"ち"],[21,1,"た"],[23,2,"いちれん"],[26,1,"まく"],[28,1,"ふち"],[32,1,"ち"]],"text":"その一連の端にある幕の縁に、乳五十をつけ、他の一連の幕の縁にも、乳五十をつけた。"},{"ref":"Exod.36.18","start":2036018,"end":2036018,"break":"none","ruby":[[4,2,"せいどう"],[7,1,"わ"],[11,1,"つく"],[16,2,"てんまく"],[19,1,"つら"],[21,1,"あ"]],"text":"そして、青銅の輪五十を作り、その天幕を連ね合わせて一つにした。"},{"ref":"Exod.36.19","start":2036019,"end":2036019,"break":"none","ruby":[[6,1,"ぞ"],[9,2,"おひつじ"],[12,1,"かわ"],[15,2,"てんまく"],[28,1,"かわ"],[33,1,"うえ"],[43,1,"つく"]],"text":"また、あかね染めの雄羊の皮で、天幕のおおいと、じゅごんの皮で、その上にかけるおおいとを作った。"},{"ref":"Exod.36.20","start":2036020,"end":2036020,"break":"paragraph","ruby":[[2,2,"まくや"],[12,1,"ざい"],[18,1,"たて"],[19,1,"わく"],[21,1,"つく"]],"text":"また幕屋のためにアカシヤ材をもって、立枠を造った。"},{"ref":"Exod.36.21","start":2036021,"end":2036021,"break":"none","ruby":[[0,1,"わく"],[2,1,"なが"],[11,1,"わく"],[13,1,"はば"],[25,1,"はん"]],"text":"枠の長さは十キュビト、枠の幅は、おのおの一キュビト半とし、"},{"ref":"Exod.36.22","start":2036022,"end":2036022,"break":"none","ruby":[[0,1,"わく"],[7,1,"ほぞ"],[9,1,"つく"],[22,1,"あ"],[26,2,"まくや"],[33,1,"わく"]],"text":"枠ごとに二つの柄を造って、かれとこれとをくい合わせ、幕屋のすべての枠にこのようにした。"},{"ref":"Exod.36.23","start":2036023,"end":2036023,"break":"none","ruby":[[0,2,"まくや"],[6,1,"わく"],[8,1,"つく"],[16,2,"みなみがわ"],[22,1,"わく"],[26,1,"つく"]],"text":"幕屋のために枠を造った。すなわち南側のために枠二十を造った。"},{"ref":"Exod.36.24","start":2036024,"end":2036024,"break":"none","ruby":[[5,1,"わく"],[7,1,"した"],[9,1,"ぎん"],[11,1,"ざ"],[15,1,"つく"],[21,1,"わく"],[23,1,"した"],[31,1,"ほぞ"],[39,1,"ざ"],[41,1,"お"],[46,1,"わく"],[48,1,"した"],[57,1,"ほぞ"],[65,1,"ざ"],[67,1,"お"]],"text":"その二十の枠の下に銀の座四十を造って、この枠の下に、その二つの柄のために二つの座を置き、かの枠の下にも、その二つの柄のために二つの座を置いた。"},{"ref":"Exod.36.25","start":2036025,"end":2036025,"break":"none","ruby":[[2,2,"まくや"],[5,1,"た"],[7,1,"がわ"],[13,2,"きたがわ"],[20,1,"わく"],[24,1,"つく"]],"text":"また幕屋の他の側、すなわち北側のためにも枠二十を造った。"},{"ref":"Exod.36.26","start":2036026,"end":2036026,"break":"none","ruby":[[2,1,"ぎん"],[4,1,"ざ"],[8,1,"つく"],[14,1,"わく"],[16,1,"した"],[22,1,"ざ"],[24,1,"お"],[29,1,"わく"],[31,1,"した"],[37,1,"ざ"],[39,1,"お"]],"text":"その銀の座四十を造って、この枠の下にも二つの座を置き、かの枠の下にも二つの座を置いた。"},{"ref":"Exod.36.27","start":2036027,"end":2036027,"break":"none","ruby":[[2,2,"まくや"],[9,2,"にしがわ"],[15,1,"わく"],[19,1,"つく"]],"text":"また幕屋のうしろ、西側のために枠六つを造り、"},{"ref":"Exod.36.28","start":2036028,"end":2036028,"break":"none","ruby":[[0,2,"まくや"],[16,1,"わく"],[20,1,"つく"]],"text":"幕屋のうしろの二つのすみのために枠二つを造った。"},{"ref":"Exod.36.29","start":2036029,"end":2036029,"break":"none","ruby":[[5,1,"した"],[7,1,"かさ"],[10,1,"あ"],[13,1,"おな"],[18,1,"いただき"],[21,1,"だい"],[24,1,"かん"],[27,1,"かさ"],[30,1,"あ"],[58,1,"つく"]],"text":"これらは、下で重なり合い、同じくその頂でも第一の環まで重なり合うようにし、その二つとも二つのすみのために、そのように造った。"},{"ref":"Exod.36.30","start":2036030,"end":2036030,"break":"none","ruby":[[7,1,"わく"],[14,1,"ぎん"],[16,1,"ざ"],[26,1,"わく"],[28,1,"した"],[35,1,"ざ"]],"text":"こうして、その枠は八つ、その銀の座は十六、おのおのの枠の下に、二つずつ座があった。"},{"ref":"Exod.36.31","start":2036031,"end":2036031,"break":"paragraph","ruby":[[6,1,"ざい"],[8,2,"よこぎ"],[11,1,"つく"],[19,2,"まくや"],[24,1,"がわ"],[26,1,"わく"]],"text":"またアカシヤ材の横木を造った。すなわち幕屋のこの側の枠のために五つ、"},{"ref":"Exod.36.32","start":2036032,"end":2036032,"break":"none","ruby":[[2,2,"まくや"],[7,1,"がわ"],[9,1,"わく"],[14,2,"よこぎ"],[19,2,"まくや"],[26,2,"にしがわ"],[29,1,"わく"],[34,2,"よこぎ"],[39,1,"つく"]],"text":"また幕屋のかの側の枠のために横木五つ、幕屋のうしろの西側の枠のために横木五つを造った。"},{"ref":"Exod.36.33","start":2036033,"end":2036033,"break":"none","ruby":[[0,1,"わく"],[4,1,"なか"],[8,2,"ちゅうおう"],[11,2,"よこぎ"],[15,1,"はし"],[18,1,"はし"],[21,1,"とお"]],"text":"枠のまん中にある中央の横木は、端から端まで通るようにした。"},{"ref":"Exod.36.34","start":2036034,"end":2036034,"break":"none","ruby":[[6,1,"わく"],[8,1,"きん"],[16,2,"よこぎ"],[19,1,"とお"],[23,1,"かん"],[25,1,"きん"],[27,1,"つく"],[34,2,"よこぎ"],[37,1,"きん"]],"text":"そして、その枠を金でおおい、また横木を通すその環を金で造り、またその横木を金でおおった。"},{"ref":"Exod.36.35","start":2036035,"end":2036035,"break":"paragraph","ruby":[[2,1,"あお"],[3,1,"いと"],[5,1,"むらさき"],[6,1,"いと"],[8,1,"ひ"],[9,1,"いと"],[11,2,"あま"],[14,2,"ねんし"],[18,2,"たれまく"],[21,1,"つく"],[24,1,"たく"],[42,1,"お"],[44,1,"だ"]],"text":"また青糸、紫糸、緋糸、亜麻の撚糸で、垂幕を作り、巧みなわざをもって、それにケルビムを織り出した。"},{"ref":"Exod.36.36","start":2036036,"end":2036036,"break":"none","ruby":[[13,1,"ざい"],[15,1,"はしら"],[17,1,"ほん"],[19,1,"つく"],[22,1,"きん"],[33,1,"こま"],[35,1,"きん"],[41,1,"はしら"],[46,1,"ぎん"],[48,1,"ざ"],[52,1,"い"]],"text":"また、これがためにアカシヤ材の柱四本を作り、金でこれをおおい、その鉤を金にし、その柱のために銀の座四つを鋳た。"},{"ref":"Exod.36.37","start":2036037,"end":2036037,"break":"none","ruby":[[2,2,"まくや"],[5,2,"いりぐち"],[11,1,"あお"],[12,1,"いと"],[14,1,"むらさき"],[15,1,"いと"],[17,1,"ひ"],[18,1,"いと"],[20,2,"あま"],[23,2,"ねんし"],[27,1,"いろ"],[33,1,"お"],[40,1,"つく"]],"text":"また幕屋の入口のために青糸、紫糸、緋糸、亜麻の撚糸で、色とりどりに織ったとばりを作った。"},{"ref":"Exod.36.38","start":2036038,"end":2036038,"break":"none","ruby":[[2,1,"はしら"],[4,1,"ほん"],[9,1,"こま"],[12,1,"つく"],[17,1,"はしら"],[19,1,"あたま"],[21,1,"けた"],[24,1,"きん"],[40,1,"ざ"],[42,2,"せいどう"]],"text":"その柱五本と、その鉤とを造り、その柱の頭と桁とを金でおおった。ただし、その五つの座は青銅であった。"}]