[{"ref":"Song.5.1","start":22005001,"end":22005001,"break":"paragraph","breaks":[[10,"line"],[35,"line"],[49,"line"],[62,"stanza"],[73,"line"]],"ruby":[[2,1,"いもうと"],[6,2,"はなよめ"],[16,1,"その"],[25,2,"もつやく"],[28,2,"こうりょう"],[32,1,"あつ"],[37,2,"みつばち"],[40,1,"す"],[43,1,"みつ"],[46,1,"た"],[54,1,"しゅ"],[56,1,"ちち"],[59,1,"の"],[62,1,"とも"],[66,1,"く"],[70,1,"の"],[73,1,"あい"],[76,2,"ひとびと"],[80,1,"おお"],[83,1,"の"]],"text":"わが妹、わが花嫁よ、わたしはわが園にはいって、わが没薬と香料とを集め、わが蜜蜂の巣と、蜜とを食べ、わがぶどう酒と乳とを飲む。友らよ、食らえ、飲め、愛する人々よ、大いに飲め。"},{"ref":"Song.5.2","start":22005002,"end":22005002,"break":"stanza","breaks":[[19,"line"],[41,"line"],[53,"line"],[73,"line"],[84,"line"]],"ruby":[[4,1,"ねむ"],[11,1,"こころ"],[19,1,"き"],[27,1,"あい"],[30,1,"もの"],[32,1,"と"],[44,1,"いもうと"],[48,1,"あい"],[51,1,"もの"],[60,1,"まった"],[62,1,"もの"],[77,1,"あたま"],[79,1,"つゆ"],[88,1,"かみ"],[90,1,"け"],[92,2,"よつゆ"],[102,1,"い"]],"text":"わたしは眠っていたが、心はさめていた。聞きなさい、わが愛する者が戸をたたいている。「わが妹、わが愛する者、わがはと、わが全き者よ、あけてください。わたしの頭は露でぬれ、わたしの髪の毛は夜露でぬれている」と言う。"},{"ref":"Song.5.3","start":22005003,"end":22005003,"break":"line","breaks":[[14,"line"],[27,"line"],[36,"line"]],"ruby":[[7,2,"きもの"],[10,1,"ぬ"],[20,1,"き"],[30,1,"あし"],[32,1,"あら"]],"text":"わたしはすでに着物を脱いだ、どうしてまた着られようか。すでに足を洗った、どうしてまた、よごせようか。"},{"ref":"Song.5.4","start":22005004,"end":22005004,"break":"line","breaks":[[20,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[7,1,"か"],[12,1,"て"],[22,1,"こころ"],[24,1,"うち"]],"text":"わが愛する者が掛けがねに手をかけたので、わが心は内におどった。"},{"ref":"Song.5.5","start":22005005,"end":22005005,"break":"line","breaks":[[8,"line"],[28,"line"],[43,"line"],[59,"line"]],"ruby":[[4,1,"お"],[10,1,"あい"],[13,1,"もの"],[32,1,"て"],[35,2,"もつやく"],[47,1,"ゆび"],[50,2,"もつやく"],[53,1,"えき"],[55,1,"なが"],[59,1,"かん"],[61,1,"き"],[63,2,"とって"],[66,1,"うえ"],[68,1,"お"]],"text":"わたしが起きて、わが愛する者のためにあけようとしたとき、わたしの手から没薬がしたたり、わたしの指から没薬の液が流れて、貫の木の取手の上に落ちた。"},{"ref":"Song.5.6","start":22005006,"end":22005006,"break":"line","breaks":[[19,"line"],[35,"line"],[55,"line"],[72,"line"]],"ruby":[[6,1,"あい"],[9,1,"もの"],[14,1,"ひら"],[21,1,"あい"],[24,1,"もの"],[29,1,"かえ"],[31,1,"さ"],[35,1,"かれ"],[37,1,"かえ"],[39,1,"さ"],[47,1,"こころ"],[49,1,"ちから"],[51,1,"うしな"],[59,1,"たず"],[66,1,"み"],[72,1,"よ"],[79,1,"こたえ"]],"text":"わたしはわが愛する者のために開いたが、わが愛する者はすでに帰り去った。彼が帰り去ったとき、わが心は力を失った。わたしは尋ねたけれども見つからず、呼んだけれども答がなかった。"},{"ref":"Song.5.7","start":22005007,"end":22005007,"break":"line","breaks":[[12,"line"],[27,"line"]],"ruby":[[0,1,"まち"],[5,1,"ある"],[7,2,"よまわ"],[16,1,"み"],[20,1,"う"],[23,1,"きず"],[27,2,"じょうへき"],[30,1,"まも"],[32,1,"もの"],[40,2,"うわぎ"],[45,1,"と"]],"text":"町をまわり歩く夜回りらはわたしを見ると、撃って傷つけ、城壁を守る者らは、わたしの上着をはぎ取った。"},{"ref":"Song.5.8","start":22005008,"end":22005008,"break":"line","breaks":[[11,"line"],[31,"line"],[45,"line"],[65,"line"]],"ruby":[[6,1,"むすめ"],[21,1,"ちか"],[26,1,"ねが"],[35,1,"あい"],[38,1,"もの"],[40,1,"み"],[49,1,"あい"],[54,1,"や"],[65,1,"かれ"],[67,1,"つ"]],"text":"エルサレムの娘たちよ、わたしはあなたがたに誓って、お願いする。もしわが愛する者を見たなら、わたしが愛のために病みわずらっていると、彼に告げてください。"},{"ref":"Song.5.9","start":22005009,"end":22005009,"break":"stanza","breaks":[[13,"line"],[34,"line"],[48,"line"],[69,"line"],[83,"line"]],"ruby":[[0,1,"おんな"],[5,1,"もっと"],[7,1,"うつく"],[10,1,"もの"],[17,1,"あい"],[20,1,"もの"],[26,1,"ひと"],[28,1,"あい"],[31,1,"もの"],[52,1,"あい"],[55,1,"もの"],[61,1,"ひと"],[63,1,"あい"],[66,1,"もの"],[95,1,"ちか"],[98,1,"ねが"]],"text":"女のうちの最も美しい者よ、あなたの愛する者は、ほかの人の愛する者に、なんのまさるところがあるか。あなたの愛する者は、ほかの人の愛する者に、なんのまさるところがあって、そのように、わたしたちに誓い、願うのか。"},{"ref":"Song.5.10","start":22005010,"end":22005010,"break":"stanza","breaks":[[17,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[7,1,"しろ"],[9,1,"かがや"],[14,1,"あか"],[17,1,"ばん"],[18,1,"にん"]],"text":"わが愛する者は白く輝き、かつ赤く、万人にぬきんで、"},{"ref":"Song.5.11","start":22005011,"end":22005011,"break":"line","breaks":[[11,"line"]],"ruby":[[2,1,"あたま"],[4,2,"じゅんきん"],[13,1,"かみ"],[15,1,"け"],[31,1,"くろ"]],"text":"その頭は純金のように、その髪の毛はうねっていて、からすのように黒い。"},{"ref":"Song.5.12","start":22005012,"end":22005012,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"め"],[4,1,"いずみ"],[17,1,"ちち"],[19,1,"あら"],[24,1,"よ"],[26,1,"お"],[28,1,"つ"]],"text":"その目は泉のほとりのはとのように、乳で洗われて、良く落ち着いている。"},{"ref":"Song.5.13","start":22005013,"end":22005013,"break":"line","breaks":[[19,"line"],[26,"line"]],"ruby":[[11,1,"はな"],[13,1,"とこ"],[23,1,"はな"],[37,1,"はな"],[43,2,"もつやく"],[46,1,"えき"]],"text":"そのほおは、かんばしい花の床のように、かおりを放ち、そのくちびるは、ゆりの花のようで、没薬の液をしたたらす。"},{"ref":"Song.5.14","start":22005014,"end":22005014,"break":"line","breaks":[[19,"line"],[38,"line"]],"ruby":[[2,1,"て"],[4,2,"ほうせき"],[10,1,"きん"],[12,2,"えんとう"],[38,2,"ぞうげ"],[41,2,"さいく"]],"text":"その手は宝石をはめた金の円筒のごとく、そのからだはサファイヤをもっておおった象牙の細工のごとく、"},{"ref":"Song.5.15","start":22005015,"end":22005015,"break":"line","breaks":[[16,"line"],[26,"line"]],"ruby":[[2,1,"あし"],[7,1,"きん"],[9,1,"だい"],[11,1,"うえ"],[16,3,"だいりせき"],[20,1,"はしら"],[28,1,"すがた"],[39,2,"こうはく"],[46,1,"うつく"]],"text":"その足のすねは金の台の上にすえた大理石の柱のごとく、その姿はレバノンのごとく、香柏のようで、美しい。"},{"ref":"Song.5.16","start":22005016,"end":22005016,"break":"line","breaks":[[14,"line"],[25,"line"],[36,"line"]],"ruby":[[2,2,"ことば"],[10,1,"うつく"],[14,1,"かれ"],[21,1,"うるわ"],[31,1,"むすめ"],[41,1,"あい"],[44,1,"もの"],[51,1,"とも"]],"text":"その言葉は、はなはだ美しく、彼はことごとく麗しい。エルサレムの娘たちよ、これがわが愛する者、これがわが友なのです。"}]