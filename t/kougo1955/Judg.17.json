[{"ref":"Judg.17.1","start":7017001,"end":7017001,"break":"paragraph","ruby":[[9,2,"さんち"],[12,1,"ひと"],[15,1,"な"],[20,1,"よ"]],"text":"ここにエフライムの山地の人で、名をミカと呼ぶものがあった。"},{"ref":"Judg.17.2","start":7017002,"end":7017002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"はは"],[4,1,"い"],[16,1,"ぎん"],[19,1,"まい"],[21,1,"と"],[40,1,"はな"],[50,1,"ぎん"],[56,1,"も"],[70,1,"と"],[78,1,"はは"],[80,1,"い"],[88,1,"しゅ"],[92,1,"こ"],[94,2,"しゅくふく"]],"text":"彼は母に言った、「あなたはかつて銀千百枚を取られたので、それをのろい、わたしにも話されましたが、その銀はわたしが持っています。わたしがそれを取ったのです」。母は言った、「どうぞ主がわが子を祝福されますように」。"},{"ref":"Judg.17.3","start":7017003,"end":7017003,"break":"none","ruby":[[3,1,"かれ"],[5,1,"ぎん"],[8,1,"まい"],[10,1,"はは"],[12,1,"かえ"],[18,1,"はは"],[20,1,"い"],[33,1,"こ"],[41,1,"きざ"],[44,1,"ぞう"],[50,1,"い"],[52,1,"ぞう"],[54,1,"つく"],[61,1,"ぎん"],[67,1,"て"],[70,1,"しゅ"],[72,2,"けんのう"],[81,1,"いま"],[89,1,"かえ"]],"text":"そして彼が銀千百枚を母に返したので、母は言った、「わたしはわたしの子のために一つの刻んだ像と、一つの鋳た像を造るためにその銀をわたしの手から主に献納します。それで今それをあなたに返しましょう」。"},{"ref":"Judg.17.4","start":7017004,"end":7017004,"break":"none","ruby":[[5,1,"ぎん"],[7,1,"はは"],[9,1,"かえ"],[15,1,"はは"],[19,1,"ぎん"],[22,1,"まい"],[31,1,"ぎん"],[32,3,"ざいくにん"],[36,1,"あた"],[42,1,"きざ"],[45,1,"ぞう"],[51,1,"い"],[53,1,"ぞう"],[55,1,"つく"],[62,1,"ぞう"],[67,1,"いえ"]],"text":"ミカがその銀を母に返したので、母はその銀二百枚をとって、それを銀細工人に与え、一つの刻んだ像と、一つの鋳た像を造らせた。その像はミカの家にあった。"},{"ref":"Judg.17.5","start":7017005,"end":7017005,"break":"none","ruby":[[7,1,"ひと"],[9,1,"かみ"],[11,1,"みや"],[25,1,"つく"],[30,1,"こ"],[36,1,"た"],[40,2,"じぶん"],[43,2,"さいし"]],"text":"このミカという人は神の宮をもち、エポデとテラピムを造り、その子のひとりを立てて、自分の祭司とした。"},{"ref":"Judg.17.6","start":7017006,"end":7017006,"break":"none","ruby":[[11,1,"おう"],[20,2,"ひとびと"],[27,2,"じぶん"],[32,1,"め"],[34,1,"ただ"],[38,1,"おも"],[43,1,"おこな"]],"text":"そのころイスラエルには王がなかったので、人々はおのおの自分たちの目に正しいと思うことを行った。"},{"ref":"Judg.17.7","start":7017007,"end":7017007,"break":"paragraph","ruby":[[8,2,"しぞく"],[31,2,"わかもの"],[38,1,"かれ"],[52,2,"きりゅう"]],"text":"さてここにユダの氏族のもので、ユダのベツレヘムからきたひとりの若者があった。彼はレビびとであって、そこに寄留していたのである。"},{"ref":"Judg.17.8","start":7017008,"end":7017008,"break":"none","ruby":[[2,1,"ひと"],[4,2,"じぶん"],[7,1,"す"],[15,1,"たず"],[28,1,"まち"],[30,1,"さ"],[33,1,"たび"],[42,2,"さんち"],[48,1,"いえ"]],"text":"この人は自分の住むべきところを尋ねて、ユダのベツレヘムの町を去り、旅してエフライムの山地のミカの家にきた。"},{"ref":"Judg.17.9","start":7017009,"end":7017009,"break":"none","ruby":[[3,1,"かれ"],[5,1,"い"],[30,1,"かれ"],[32,1,"い"],[58,1,"す"],[66,1,"たず"],[69,1,"たび"]],"text":"ミカは彼に言った、「あなたはどこからおいでになりましたか」。彼は言った、「わたしはユダのベツレヘムのレビびとですが、住むべきところを尋ねて旅をしているのです」。"},{"ref":"Judg.17.10","start":7017010,"end":7017010,"break":"none","ruby":[[3,1,"い"],[12,2,"いっしょ"],[25,1,"ちち"],[28,2,"さいし"],[45,1,"ねん"],[47,1,"ぎん"],[49,1,"まい"],[51,2,"いふく"],[59,2,"しょくもつ"]],"text":"ミカは言った、「わたしと一緒にいて、わたしのために父とも祭司ともなってください。そうすれば年に銀十枚と衣服ひとそろいと食物とをさしあげましょう」。"},{"ref":"Judg.17.11","start":7017011,"end":7017011,"break":"none","ruby":[[10,1,"ひと"],[12,2,"いっしょ"],[15,1,"す"],[20,2,"しょうだく"],[30,2,"わかもの"],[33,1,"かれ"],[35,1,"こ"]],"text":"レビびとはついにその人と一緒に住むことを承諾した。そしてその若者は彼の子のひとりのようになった。"},{"ref":"Judg.17.12","start":7017012,"end":7017012,"break":"none","ruby":[[12,2,"わかもの"],[15,1,"た"],[18,2,"じぶん"],[21,2,"さいし"],[29,1,"かれ"],[34,1,"いえ"]],"text":"ミカはレビびとであるこの若者を立てて自分の祭司としたので、彼はミカの家にいた。"},{"ref":"Judg.17.13","start":7017013,"end":7017013,"break":"none","ruby":[[6,1,"い"],[11,1,"いま"],[21,2,"さいし"],[24,1,"も"],[35,1,"しゅ"],[42,1,"めぐ"]],"text":"それでミカは言った、「今わたしはレビびとを祭司に持つようになったので、主がわたしをお恵みくださることがわかりました」。"}]