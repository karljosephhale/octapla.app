[{"ref":"Num.26.1","start":4026001,"end":4026001,"break":"paragraph","ruby":[[0,2,"えきびょう"],[3,1,"のち"],[5,1,"しゅ"],[11,2,"さいし"],[17,1,"こ"],[25,1,"い"]],"text":"疫病の後、主はモーセと祭司アロンの子エレアザルとに言われた、"},{"ref":"Num.26.2","start":4026002,"end":4026002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"ぜん"],[11,2,"かいしゅう"],[14,2,"そうすう"],[19,2,"ふそ"],[22,1,"いえ"],[29,1,"しら"],[45,2,"せんそう"],[48,1,"で"],[58,1,"さい"],[59,2,"いじょう"],[62,1,"もの"],[64,1,"かぞ"]],"text":"「イスラエルの人々の全会衆の総数をその父祖の家にしたがって調べ、イスラエルにおいて、すべて戦争に出ることのできる二十歳以上の者を数えなさい」。"},{"ref":"Num.26.3","start":4026003,"end":4026003,"break":"none","ruby":[[7,2,"さいし"],[21,1,"ちか"],[38,2,"へいや"],[41,1,"かれ"],[44,1,"い"]],"text":"そこでモーセと祭司エレアザルとは、エリコに近いヨルダンのほとりにあるモアブの平野で彼らに言った、"},{"ref":"Num.26.4","start":4026004,"end":4026004,"break":"none","ruby":[[1,1,"しゅ"],[7,1,"めい"],[27,1,"さい"],[28,2,"いじょう"],[31,1,"もの"],[33,1,"かぞ"],[45,1,"ち"],[48,1,"で"],[58,2,"ひとびと"],[61,1,"つぎ"]],"text":"「主がモーセに命じられたように、あなたがたのうちの二十歳以上の者を数えなさい」。エジプトの地から出てきたイスラエルの人々は次のとおりである。"},{"ref":"Num.26.5","start":4026005,"end":4026005,"break":"paragraph","ruby":[[10,2,"ちょうし"],[20,2,"しそん"],[35,2,"しぞく"],[38,1,"で"],[49,2,"しぞく"],[52,1,"で"]],"text":"ルベンはイスラエルの長子である。ルベンの子孫は、ヘノクからヘノクびとの氏族が出、パルからパルびとの氏族が出、"},{"ref":"Num.26.6","start":4026006,"end":4026006,"break":"none","ruby":[[13,2,"しぞく"],[16,1,"で"],[29,2,"しぞく"],[32,1,"で"]],"text":"ヘヅロンからヘヅロンびとの氏族が出、カルミからカルミびとの氏族が出た。"},{"ref":"Num.26.7","start":4026007,"end":4026007,"break":"none","ruby":[[10,2,"しぞく"],[17,1,"かぞ"],[22,1,"もの"],[32,1,"にん"]],"text":"これらはルベンびとの氏族であって、数えられた者は四万三千七百三十人であった。"},{"ref":"Num.26.8","start":4026008,"end":4026008,"break":"none","ruby":[[5,1,"こ"]],"text":"またパルの子はエリアブ。"},{"ref":"Num.26.9","start":4026009,"end":4026009,"break":"none","ruby":[[5,1,"こ"],[36,2,"かいしゅう"],[43,1,"えら"],[45,1,"だ"],[49,1,"もの"],[60,1,"とも"],[71,1,"さか"],[75,1,"しゅ"],[77,1,"あらそ"],[80,1,"とき"]],"text":"エリアブの子はネムエル、ダタン、アビラムである。このダタンとアビラムとは会衆のうちから選び出された者で、コラのともがらと共にモーセとアロンとに逆らって主と争った時、"},{"ref":"Num.26.10","start":4026010,"end":4026010,"break":"none","ruby":[[0,1,"ち"],[2,1,"くち"],[4,1,"ひら"],[7,1,"かれ"],[19,2,"なかま"],[22,1,"し"],[28,1,"とき"],[33,1,"にん"],[35,1,"ひ"],[37,1,"や"],[39,1,"ほろ"],[45,1,"いまし"],[48,1,"かがみ"]],"text":"地は口を開いて彼らとコラとをのみ、その仲間は死んだ。その時二百五十人が火に焼き滅ぼされて、戒めの鏡となった。"},{"ref":"Num.26.11","start":4026011,"end":4026011,"break":"none","ruby":[[7,1,"こ"],[11,1,"し"]],"text":"ただし、コラの子たちは死ななかった。"},{"ref":"Num.26.12","start":4026012,"end":4026012,"break":"paragraph","ruby":[[5,2,"しそん"],[11,2,"しぞく"],[31,2,"しぞく"],[34,1,"で"],[47,2,"しぞく"],[50,1,"で"],[63,2,"しぞく"],[66,1,"で"]],"text":"シメオンの子孫は、その氏族によれば、ネムエルからネムエルびとの氏族が出、ヤミンからヤミンびとの氏族が出、ヤキンからヤキンびとの氏族が出、"},{"ref":"Num.26.13","start":4026013,"end":4026013,"break":"none","ruby":[[9,2,"しぞく"],[12,1,"で"],[27,2,"しぞく"],[30,1,"で"]],"text":"ゼラからゼラびとの氏族が出、シャウルからシャウルびとの氏族が出た。"},{"ref":"Num.26.14","start":4026014,"end":4026014,"break":"none","ruby":[[11,2,"しぞく"],[18,1,"かぞ"],[23,1,"もの"],[31,1,"にん"]],"text":"これらはシメオンびとの氏族であって、数えられた者は二万二千二百人であった。"},{"ref":"Num.26.15","start":4026015,"end":4026015,"break":"paragraph","ruby":[[3,2,"しそん"],[9,2,"しぞく"],[27,2,"しぞく"],[30,1,"で"],[41,2,"しぞく"],[44,1,"で"],[57,2,"しぞく"],[60,1,"で"]],"text":"ガドの子孫は、その氏族によれば、ゼポンからゼポンびとの氏族が出、ハギからハギびとの氏族が出、シュニからシュニびとの氏族が出、"},{"ref":"Num.26.16","start":4026016,"end":4026016,"break":"none","ruby":[[11,2,"しぞく"],[14,1,"で"],[25,2,"しぞく"],[28,1,"で"]],"text":"オズニからオズニびとの氏族が出、エリからエリびとの氏族が出、"},{"ref":"Num.26.17","start":4026017,"end":4026017,"break":"none","ruby":[[11,2,"しぞく"],[14,1,"で"],[27,2,"しぞく"],[30,1,"で"]],"text":"アロドからアロドびとの氏族が出、アレリからアレリびとの氏族が出た。"},{"ref":"Num.26.18","start":4026018,"end":4026018,"break":"none","ruby":[[7,2,"しそん"],[10,2,"しぞく"],[17,1,"かぞ"],[22,1,"もの"],[28,1,"にん"]],"text":"これらはガドの子孫の氏族であって、数えられた者は四万五百人であった。"},{"ref":"Num.26.19","start":4026019,"end":4026019,"break":"paragraph","ruby":[[3,1,"こ"],[30,1,"ち"],[32,1,"し"]],"text":"ユダの子らはエルとオナンとであって、エルとオナンとはカナンの地で死んだ。"},{"ref":"Num.26.20","start":4026020,"end":4026020,"break":"none","ruby":[[3,2,"しそん"],[9,2,"しぞく"],[25,2,"しぞく"],[28,1,"で"],[41,2,"しぞく"],[44,1,"で"],[55,2,"しぞく"],[58,1,"で"]],"text":"ユダの子孫は、その氏族によれば、シラからシラびとの氏族が出、ペレヅからペレヅびとの氏族が出、ゼラからゼラびとの氏族が出た。"},{"ref":"Num.26.21","start":4026021,"end":4026021,"break":"none","ruby":[[4,2,"しそん"],[21,2,"しぞく"],[24,1,"で"],[37,2,"しぞく"],[40,1,"で"]],"text":"ペレヅの子孫は、ヘヅロンからヘヅロンびとの氏族が出、ハムルからハムルびとの氏族が出た。"},{"ref":"Num.26.22","start":4026022,"end":4026022,"break":"none","ruby":[[7,2,"しぞく"],[14,1,"かぞ"],[19,1,"もの"],[27,1,"にん"]],"text":"これらはユダの氏族であって、数えられた者は七万六千五百人であった。"},{"ref":"Num.26.23","start":4026023,"end":4026023,"break":"paragraph","ruby":[[6,2,"しそん"],[12,2,"しぞく"],[28,2,"しぞく"],[31,1,"で"],[42,2,"しぞく"],[45,1,"で"]],"text":"イッサカルの子孫は、その氏族によれば、トラからトラびとの氏族が出、プワからプワびとの氏族が出、"},{"ref":"Num.26.24","start":4026024,"end":4026024,"break":"none","ruby":[[13,2,"しぞく"],[16,1,"で"],[31,2,"しぞく"],[34,1,"で"]],"text":"ヤシュブからヤシュブびとの氏族が出、シムロンからシムロンびとの氏族が出た。"},{"ref":"Num.26.25","start":4026025,"end":4026025,"break":"none","ruby":[[10,2,"しぞく"],[17,1,"かぞ"],[22,1,"もの"],[30,1,"にん"]],"text":"これらはイッサカルの氏族であって、数えられた者は六万四千三百人であった。"},{"ref":"Num.26.26","start":4026026,"end":4026026,"break":"none","ruby":[[5,2,"しそん"],[11,2,"しぞく"],[29,2,"しぞく"],[32,1,"で"],[45,2,"しぞく"],[48,1,"で"],[63,2,"しぞく"],[66,1,"で"]],"text":"ゼブルンの子孫は、その氏族によれば、セレデからセレデびとの氏族が出、エロンからエロンびとの氏族が出、ヤリエルからヤリエルびとの氏族が出た。"},{"ref":"Num.26.27","start":4026027,"end":4026027,"break":"none","ruby":[[11,2,"しぞく"],[18,1,"かぞ"],[23,1,"もの"],[29,1,"にん"]],"text":"これらはゼブルンびとの氏族であって、数えられた者は六万五百人であった。"},{"ref":"Num.26.28","start":4026028,"end":4026028,"break":"paragraph","ruby":[[4,1,"こ"],[10,2,"しぞく"]],"text":"ヨセフの子らは、その氏族によれば、マナセとエフライムとであって、"},{"ref":"Num.26.29","start":4026029,"end":4026029,"break":"none","ruby":[[4,2,"しそん"],[19,2,"しぞく"],[22,1,"で"],[35,1,"うま"],[51,2,"しぞく"],[54,1,"で"]],"text":"マナセの子孫は、マキルからマキルびとの氏族が出た。マキルからギレアデが生れ、ギレアデからギレアデびとの氏族が出た。"},{"ref":"Num.26.30","start":4026030,"end":4026030,"break":"none","ruby":[[5,2,"しそん"],[8,1,"つぎ"],[30,2,"しぞく"],[33,1,"で"],[46,2,"しぞく"],[49,1,"で"]],"text":"ギレアデの子孫は次のとおりである。イエゼルからイエゼルびとの氏族が出、ヘレクからヘレクびとの氏族が出、"},{"ref":"Num.26.31","start":4026031,"end":4026031,"break":"none","ruby":[[15,2,"しぞく"],[18,1,"で"],[31,2,"しぞく"],[34,1,"で"]],"text":"アスリエルからアスリエルびとの氏族が出、シケムからシケムびとの氏族が出、"},{"ref":"Num.26.32","start":4026032,"end":4026032,"break":"none","ruby":[[11,2,"しぞく"],[14,1,"で"],[27,2,"しぞく"],[30,1,"で"]],"text":"セミダからセミダびとの氏族が出、ヘペルからヘペルびとの氏族が出た。"},{"ref":"Num.26.33","start":4026033,"end":4026033,"break":"none","ruby":[[4,1,"こ"],[12,1,"おとこ"],[14,1,"こ"],[21,1,"おんな"],[23,1,"こ"],[34,1,"おんな"],[36,1,"こ"],[38,1,"な"]],"text":"ヘペルの子ゼロペハデには男の子がなく、ただ女の子のみで、ゼロペハデの女の子の名はマアラ、ノア、ホグラ、ミルカ、テルザといった。"},{"ref":"Num.26.34","start":4026034,"end":4026034,"break":"none","ruby":[[8,2,"しぞく"],[15,1,"かぞ"],[20,1,"もの"],[28,1,"にん"]],"text":"これらはマナセの氏族であって、数えられた者は五万二千七百人であった。"},{"ref":"Num.26.35","start":4026035,"end":4026035,"break":"paragraph","ruby":[[6,2,"しそん"],[12,2,"しぞく"],[19,1,"つぎ"],[42,2,"しぞく"],[45,1,"で"],[58,2,"しぞく"],[61,1,"で"],[74,2,"しぞく"],[77,1,"で"]],"text":"エフライムの子孫は、その氏族によれば、次のとおりである。シュテラからはシュテラびとの氏族が出、ベケルからベケルびとの氏族が出、タハンからタハンびとの氏族が出た。"},{"ref":"Num.26.36","start":4026036,"end":4026036,"break":"none","ruby":[[7,2,"しそん"],[10,1,"つぎ"],[34,2,"しぞく"],[37,1,"で"]],"text":"またシュテラの子孫は次のとおりである。すなわちエランからエランびとの氏族が出た。"},{"ref":"Num.26.37","start":4026037,"end":4026037,"break":"none","ruby":[[10,2,"しそん"],[13,2,"しぞく"],[20,1,"かぞ"],[25,1,"もの"],[33,1,"にん"],[39,2,"いじょう"],[46,2,"しそん"],[52,2,"しぞく"]],"text":"これらはエフライムの子孫の氏族であって、数えられた者は三万二千五百人であった。以上はヨセフの子孫で、その氏族によるものである。"},{"ref":"Num.26.38","start":4026038,"end":4026038,"break":"paragraph","ruby":[[6,2,"しそん"],[12,2,"しぞく"],[28,2,"しぞく"],[31,1,"で"],[46,2,"しぞく"],[49,1,"で"],[64,2,"しぞく"],[67,1,"で"]],"text":"ベニヤミンの子孫は、その氏族によれば、ベラからベラびとの氏族が出、アシベルからアシベルびとの氏族が出、アヒラムからアヒラムびとの氏族が出、"},{"ref":"Num.26.39","start":4026039,"end":4026039,"break":"none","ruby":[[13,2,"しぞく"],[16,1,"で"],[29,2,"しぞく"],[32,1,"で"]],"text":"シュパムからシュパムびとの氏族が出、ホパムからホパムびとの氏族が出た。"},{"ref":"Num.26.40","start":4026040,"end":4026040,"break":"none","ruby":[[3,1,"こ"],[30,2,"しぞく"],[33,1,"で"],[48,2,"しぞく"],[51,1,"で"]],"text":"ベラの子はアルデとナアマンとであって、アルデからアルデびとの氏族が出、ナアマンからナアマンびとの氏族が出た。"},{"ref":"Num.26.41","start":4026041,"end":4026041,"break":"none","ruby":[[10,2,"しそん"],[19,2,"しぞく"],[25,1,"かぞ"],[30,1,"もの"],[38,1,"にん"]],"text":"これらはベニヤミンの子孫であって、その氏族によれば数えられた者は四万五千六百人であった。"},{"ref":"Num.26.42","start":4026042,"end":4026042,"break":"paragraph","ruby":[[3,2,"しそん"],[9,2,"しぞく"],[16,1,"つぎ"],[38,2,"しぞく"],[41,1,"で"],[51,2,"しぞく"],[60,2,"しぞく"]],"text":"ダンの子孫は、その氏族によれば、次のとおりである。シュハムからシュハムびとの氏族が出た。これらはダンの氏族であって、その氏族によるものである。"},{"ref":"Num.26.43","start":4026043,"end":4026043,"break":"none","ruby":[[11,2,"しぞく"],[17,1,"かぞ"],[22,1,"もの"],[30,1,"にん"]],"text":"シュハムびとのすべての氏族のうち、数えられた者は六万四千四百人であった。"},{"ref":"Num.26.44","start":4026044,"end":4026044,"break":"paragraph","ruby":[[4,2,"しそん"],[10,2,"しぞく"],[28,2,"しぞく"],[31,1,"で"],[44,2,"しぞく"],[47,1,"で"],[60,2,"しぞく"],[63,1,"で"]],"text":"アセルの子孫は、その氏族によれば、エムナからエムナびとの氏族が出、エスイからエスイびとの氏族が出、ベリアからベリアびとの氏族が出た。"},{"ref":"Num.26.45","start":4026045,"end":4026045,"break":"none","ruby":[[4,2,"しそん"],[20,2,"しぞく"],[23,1,"で"],[40,2,"しぞく"],[43,1,"で"]],"text":"ベリアの子孫のうちヘベルからヘベルびとの氏族が出、マルキエルからマルキエルびとの氏族が出た。"},{"ref":"Num.26.46","start":4026046,"end":4026046,"break":"none","ruby":[[4,1,"むすめ"],[6,1,"な"]],"text":"アセルの娘の名はサラといった。"},{"ref":"Num.26.47","start":4026047,"end":4026047,"break":"none","ruby":[[8,2,"しそん"],[11,2,"しぞく"],[18,1,"かぞ"],[23,1,"もの"],[31,1,"にん"]],"text":"これらはアセルの子孫の氏族であって、数えられた者は五万三千四百人であった。"},{"ref":"Num.26.48","start":4026048,"end":4026048,"break":"paragraph","ruby":[[5,2,"しそん"],[11,2,"しぞく"],[31,2,"しぞく"],[34,1,"で"],[45,2,"しぞく"],[48,1,"で"]],"text":"ナフタリの子孫は、その氏族によれば、ヤジエルからヤジエルびとの氏族が出、グニからグニびとの氏族が出、"},{"ref":"Num.26.49","start":4026049,"end":4026049,"break":"none","ruby":[[11,2,"しぞく"],[14,1,"で"],[27,2,"しぞく"],[30,1,"で"]],"text":"エゼルからエゼルびとの氏族が出、シレムからシレムびとの氏族が出た。"},{"ref":"Num.26.50","start":4026050,"end":4026050,"break":"none","ruby":[[9,2,"しぞく"],[18,2,"しぞく"],[24,1,"かぞ"],[29,1,"もの"],[37,1,"にん"]],"text":"これらはナフタリの氏族であって、その氏族により、数えられた者は四万五千四百人であった。"},{"ref":"Num.26.51","start":4026051,"end":4026051,"break":"paragraph","ruby":[[10,2,"しそん"],[13,1,"かぞ"],[18,1,"もの"],[32,1,"にん"]],"text":"これらはイスラエルの子孫の数えられた者であって、六十万一千百三十人であった。"},{"ref":"Num.26.52","start":4026052,"end":4026052,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.26.53","start":4026053,"end":4026053,"break":"none","ruby":[[5,2,"ひとびと"],[11,1,"な"],[13,1,"かず"],[20,1,"ち"],[22,1,"わ"],[24,1,"あた"],[27,1,"し"],[28,1,"ぎょう"]],"text":"「これらの人々に、その名の数にしたがって地を分け与え、嗣業とさせなさい。"},{"ref":"Num.26.54","start":4026054,"end":4026054,"break":"none","ruby":[[0,1,"おお"],[3,2,"ぶぞく"],[7,1,"おお"],[10,1,"し"],[11,1,"ぎょう"],[13,1,"あた"],[16,1,"ちい"],[19,2,"ぶぞく"],[23,1,"すこ"],[26,1,"し"],[27,1,"ぎょう"],[29,1,"あた"],[39,1,"かぞ"],[44,1,"かず"],[57,2,"ぶぞく"],[62,1,"し"],[63,1,"ぎょう"],[65,1,"あた"]],"text":"大きい部族には多くの嗣業を与え、小さい部族には少しの嗣業を与えなさい。すなわち数えられた数にしたがって、おのおのの部族にその嗣業を与えなければならない。"},{"ref":"Num.26.55","start":4026055,"end":4026055,"break":"none","ruby":[[3,1,"ち"],[12,1,"わ"],[17,2,"ふそ"],[20,2,"ぶぞく"],[23,1,"な"],[34,1,"つ"]],"text":"ただし地は、くじをもって分け、その父祖の部族の名にしたがって、それを継がなければならない。"},{"ref":"Num.26.56","start":4026056,"end":4026056,"break":"none","ruby":[[13,1,"し"],[14,1,"ぎょう"],[16,1,"おお"],[23,1,"ちい"],[30,1,"わ"]],"text":"すなわち、くじをもってその嗣業を大きいものと、小さいものとに分けなければならない」。"},{"ref":"Num.26.57","start":4026057,"end":4026057,"break":"paragraph","ruby":[[7,2,"しぞく"],[15,1,"かぞ"],[20,1,"もの"],[22,1,"つぎ"],[46,2,"しぞく"],[49,1,"で"],[62,2,"しぞく"],[65,1,"で"],[78,2,"しぞく"],[81,1,"で"]],"text":"レビびとのその氏族にしたがって数えられた者は次のとおりである。ゲルションからゲルションびとの氏族が出、コハテからコハテびとの氏族が出、メラリからメラリびとの氏族が出た。"},{"ref":"Num.26.58","start":4026058,"end":4026058,"break":"none","ruby":[[3,2,"しぞく"],[6,1,"つぎ"],[25,2,"しぞく"],[35,2,"しぞく"],[44,2,"しぞく"],[52,2,"しぞく"],[60,2,"しぞく"],[77,1,"うま"]],"text":"レビの氏族は次のとおりである。すなわちリブニびとの氏族、ヘブロンびとの氏族、マヘリびとの氏族、ムシびとの氏族、コラびとの氏族であって、コハテからアムラムが生れた。"},{"ref":"Num.26.59","start":4026059,"end":4026059,"break":"none","ruby":[[5,1,"つま"],[7,1,"な"],[21,1,"むすめ"],[26,2,"かのじょ"],[37,1,"うま"],[40,1,"もの"],[68,2,"しまい"],[75,1,"う"]],"text":"アムラムの妻の名はヨケベデといって、レビの娘である。彼女はエジプトでレビに生れた者であるが、アムラムにとついで、アロンとモーセおよびその姉妹ミリアムを産んだ。"},{"ref":"Num.26.60","start":4026060,"end":4026060,"break":"none","ruby":[[26,1,"うま"]],"text":"アロンにはナダブ、アビウ、エレアザルおよびイタマルが生れた。"},{"ref":"Num.26.61","start":4026061,"end":4026061,"break":"none","ruby":[[8,2,"ことび"],[11,1,"しゅ"],[13,1,"まえ"],[19,1,"とき"],[21,1,"し"]],"text":"ナダブとアビウは異火を主の前にささげた時に死んだ。"},{"ref":"Num.26.62","start":4026062,"end":4026062,"break":"none","ruby":[[2,1,"かぞ"],[9,1,"げつ"],[10,2,"いじょう"],[17,2,"だんし"],[24,1,"にん"],[30,1,"かれ"],[39,2,"ひとびと"],[45,1,"し"],[46,1,"ぎょう"],[48,1,"あた"],[65,2,"ひとびと"],[71,1,"かぞ"],[79,1,"もの"]],"text":"その数えられた一か月以上のすべての男子は二万三千人であった。彼らはイスラエルの人々のうちに嗣業を与えられなかったため、イスラエルの人々のうちに数えられなかった者である。"},{"ref":"Num.26.63","start":4026063,"end":4026063,"break":"paragraph","ruby":[[8,2,"さいし"],[21,1,"ちか"],[38,2,"へいや"],[41,1,"かぞ"],[50,2,"ひとびと"],[53,1,"かず"]],"text":"これらはモーセと祭司エレアザルが、エリコに近いヨルダンのほとりにあるモアブの平野で数えたイスラエルの人々の数である。"},{"ref":"Num.26.64","start":4026064,"end":4026064,"break":"none","ruby":[[14,2,"さいし"],[24,2,"あらの"],[33,2,"ひとびと"],[36,1,"かぞ"],[39,1,"とき"],[41,1,"かぞ"],[46,1,"もの"]],"text":"ただしそのうちには、モーセと祭司アロンがシナイの荒野でイスラエルの人々を数えた時に数えられた者はひとりもなかった。"},{"ref":"Num.26.65","start":4026065,"end":4026065,"break":"none","ruby":[[3,1,"しゅ"],[8,1,"かれ"],[15,1,"かれ"],[18,1,"かなら"],[20,2,"あらの"],[23,1,"し"],[31,1,"い"],[44,1,"かれ"],[54,1,"こ"],[62,1,"こ"],[75,1,"のこ"],[78,1,"もの"]],"text":"それは主がかつて彼らについて「彼らは必ず荒野で死ぬであろう」と言われたからである。それで彼らのうちエフンネの子カレブとヌンの子ヨシュアのほか、ひとりも残った者はなかった。"}]