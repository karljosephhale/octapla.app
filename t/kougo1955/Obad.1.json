[{"ref":"Obad.1.1","start":31001001,"end":31001001,"break":"paragraph","breaks":[[7,"line"],[26,"line"],[45,"line"],[68,"line"]],"ruby":[[5,1,"まぼろし"],[7,1,"しゅ"],[10,1,"かみ"],[21,1,"い"],[31,1,"しゅ"],[34,1,"で"],[41,1,"き"],[49,2,"ししゃ"],[52,1,"しょ"],[53,2,"こくみん"],[65,1,"い"],[69,1,"た"],[78,1,"た"],[85,1,"たたか"]],"text":"オバデヤの幻。主なる神はエドムについてこう言われる、われわれは主から出たおとずれを聞いた。ひとりの使者が諸国民のうちにつかわされて言う、「立てよ、われわれは立ってエドムと戦おう」。"},{"ref":"Obad.1.2","start":31001002,"end":31001002,"break":"line","breaks":[[17,"line"],[25,"line"]],"ruby":[[0,1,"み"],[11,2,"くにぐに"],[17,1,"ちい"],[20,1,"もの"],[32,1,"いや"]],"text":"見よ、わたしはあなたを国々のうちで小さい者とする。あなたはひどく卑しめられる。"},{"ref":"Obad.1.3","start":31001003,"end":31001003,"break":"line","breaks":[[18,"line"],[37,"line"],[49,"line"]],"ruby":[[0,1,"いわ"],[9,1,"たか"],[11,1,"ところ"],[13,1,"す"],[15,1,"もの"],[22,1,"こころ"],[24,1,"たか"],[33,1,"あざむ"],[41,1,"こころ"],[46,1,"い"],[57,1,"ち"],[59,1,"ひ"],[61,1,"くだ"],[65,1,"こと"]],"text":"岩のはざまにおり、高い所に住む者よ、あなたの心の高ぶりは、あなたを欺いた。あなたは心のうちに言う、「だれがわたしを地に引き下らせる事ができるか」。"},{"ref":"Obad.1.4","start":31001004,"end":31001004,"break":"line","breaks":[[20,"line"],[31,"line"],[49,"line"]],"ruby":[[14,1,"たか"],[20,1,"ほし"],[22,1,"あいだ"],[24,1,"す"],[26,1,"もう"],[43,1,"ひ"],[49,1,"しゅ"],[51,1,"い"]],"text":"たといあなたは、わしのように高くあがり、星の間に巣を設けても、わたしはそこからあなたを引きおろすと主は言われる。"},{"ref":"Obad.1.5","start":31001005,"end":31001005,"break":"line","breaks":[[22,"line"],[39,"line"],[57,"line"],[79,"line"]],"ruby":[[2,1,"ぬす"],[10,1,"ところ"],[12,1,"き"],[14,2,"ごうとう"],[17,1,"よる"],[22,1,"かれ"],[31,1,"ぬす"],[46,1,"まった"],[48,1,"ほろ"],[63,1,"あつ"],[66,1,"もの"],[72,1,"ところ"],[74,1,"き"],[79,1,"かれ"],[84,1,"あま"],[87,1,"み"],[89,1,"のこ"]],"text":"もし盗びとがあなたの所に来、強盗が夜きても、彼らは、ほしいだけ盗むではないか。ああ、あなたは全く滅ぼされてしまう。もしぶどうを集める者があなたの所に来たなら、彼らはなお余りの実を残さないであろうか。"},{"ref":"Obad.1.6","start":31001006,"end":31001006,"break":"line","breaks":[[13,"line"]],"ruby":[[15,1,"かく"],[21,1,"たから"],[23,1,"さぐ"],[25,1,"だ"]],"text":"ああ、エサウはかすめられ、その隠しておいた宝は探り出される。"},{"ref":"Obad.1.7","start":31001007,"end":31001007,"break":"line","breaks":[[16,"line"],[36,"line"],[57,"line"],[80,"line"]],"ruby":[[4,2,"けいやく"],[7,1,"むす"],[10,2,"ひとびと"],[20,1,"あざむ"],[27,2,"こっきょう"],[30,1,"お"],[40,2,"どうめい"],[43,1,"むす"],[46,2,"ひとびと"],[53,1,"か"],[61,2,"しんらい"],[65,1,"とも"],[71,1,"した"],[76,1,"もう"],[85,1,"こと"],[87,1,"さと"]],"text":"あなたと契約を結んだ人々はみな、あなたを欺き、あなたを国境に追いやった。あなたと同盟を結んだ人々はあなたに勝った。あなたの信頼する友はあなたの下にわなを設けた、しかしその事を悟らない。"},{"ref":"Obad.1.8","start":31001008,"end":31001008,"break":"line","breaks":[[7,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"ひ"],[22,2,"ちしゃ"],[25,1,"ほろ"],[33,1,"やま"],[36,1,"さと"],[39,1,"た"],[41,1,"のぞ"]],"text":"主は言われる、その日には、わたしはエドムから知者を滅ぼし、エサウの山から悟りを断ち除かないだろうか。"},{"ref":"Obad.1.9","start":31001009,"end":31001009,"break":"line","breaks":[[18,"line"]],"ruby":[[9,2,"ゆうし"],[12,1,"おどろ"],[14,1,"おそ"],[18,1,"ひと"],[22,1,"ころ"],[30,1,"やま"],[33,1,"た"],[35,1,"のぞ"]],"text":"テマンよ、あなたの勇士は驚き恐れる。人はみな殺されてエサウの山から断ち除かれる。"},{"ref":"Obad.1.10","start":31001010,"end":31001010,"break":"line","breaks":[[21,"line"]],"ruby":[[6,2,"きょうだい"],[12,2,"ぼうぎゃく"],[15,1,"おこな"],[21,1,"はじ"],[35,2,"えいえん"],[38,1,"た"]],"text":"あなたはその兄弟ヤコブに暴虐を行ったので、恥はあなたをおおい、あなたは永遠に断たれる。"},{"ref":"Obad.1.11","start":31001011,"end":31001011,"break":"line","breaks":[[14,"line"],[32,"line"],[45,"line"],[60,"line"]],"ruby":[[4,1,"はな"],[7,1,"た"],[12,1,"ひ"],[18,3,"いほうじん"],[24,2,"ざいほう"],[27,1,"も"],[29,1,"さ"],[32,2,"がいこく"],[34,1,"じん"],[38,1,"もん"],[42,1,"い"],[53,1,"び"],[58,1,"ひ"],[64,1,"かれ"]],"text":"あなたが離れて立っていた日、すなわち異邦人がその財宝を持ち去り、外国人がその門におし入り、エルサレムをくじ引きにした日、あなたも彼らのひとりのようであった。"},{"ref":"Obad.1.12","start":31001012,"end":31001012,"break":"line","breaks":[[15,"line"],[39,"line"],[55,"line"],[66,"line"]],"ruby":[[7,2,"じぶん"],[10,2,"きょうだい"],[13,1,"ひ"],[21,1,"わざわい"],[23,1,"ひ"],[46,2,"ひとびと"],[49,1,"ほろ"],[52,1,"ひ"],[58,1,"よろこ"],[68,1,"なや"],[71,1,"ひ"],[73,1,"ほこ"]],"text":"しかしあなたは自分の兄弟の日、すなわちその災の日をながめていてはならなかった。あなたはユダの人々の滅びの日に、これを喜んではならず、その悩みの日に誇ってはならなかった。"},{"ref":"Obad.1.13","start":31001013,"end":31001013,"break":"line","breaks":[[13,"line"],[26,"line"],[50,"line"],[59,"line"]],"ruby":[[6,1,"たみ"],[8,1,"わざわい"],[10,1,"ひ"],[15,1,"もん"],[28,1,"わざわい"],[30,1,"ひ"],[34,1,"くる"],[54,1,"わざわい"],[56,1,"ひ"],[61,2,"ざいほう"],[64,1,"て"]],"text":"あなたはわが民の災の日に、その門にはいってはならず、その災の日にその苦しみをながめてはならなかった。またその災の日に、その財宝に手をかけてはならなかった。"},{"ref":"Obad.1.14","start":31001014,"end":31001014,"break":"line","breaks":[[12,"line"],[31,"line"],[47,"line"]],"ruby":[[4,1,"わか"],[6,1,"みち"],[8,1,"た"],[18,1,"もの"],[20,1,"き"],[35,1,"なや"],[38,1,"ひ"],[42,1,"のこ"],[45,1,"もの"],[47,1,"てき"]],"text":"あなたは分れ道に立って、そののがれる者を切ってはならなかった。あなたは悩みの日にその残った者を敵にわたしてはならなかった。"},{"ref":"Obad.1.15","start":31001015,"end":31001015,"break":"line","breaks":[[16,"line"],[33,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ひ"],[4,2,"ばんこく"],[7,1,"たみ"],[9,1,"のぞ"],[13,1,"ちか"],[37,1,"むく"],[48,1,"き"]],"text":"主の日が万国の民に臨むのは近い。あなたがしたようにあなたもされる。あなたの報いはあなたのこうべに帰する。"},{"ref":"Obad.1.16","start":31001016,"end":31001016,"break":"line","breaks":[[20,"line"],[33,"line"],[48,"line"]],"ruby":[[8,1,"せい"],[11,1,"やま"],[13,1,"の"],[20,2,"しゅうい"],[28,1,"たみ"],[30,1,"の"],[37,1,"かれ"],[40,1,"の"]],"text":"あなたがたがわが聖なる山で飲んだように、周囲のもろもろの民も飲む。すなわち彼らは飲んでよろめき、かつてなかったようになる。"},{"ref":"Obad.1.17","start":31001017,"end":31001017,"break":"line","breaks":[[20,"line"],[28,"line"]],"ruby":[[7,1,"やま"],[15,1,"もの"],[20,1,"せい"],[23,1,"ところ"],[34,1,"いえ"],[38,2,"りょうち"],[41,1,"え"]],"text":"しかしシオンの山には、のがれる者がいて、聖なる所となる。またヤコブの家はその領地を獲る。"},{"ref":"Obad.1.18","start":31001018,"end":31001018,"break":"line","breaks":[[11,"line"],[22,"line"],[34,"line"],[51,"line"],[70,"line"]],"ruby":[[4,1,"いえ"],[6,1,"ひ"],[15,1,"いえ"],[17,1,"ほのお"],[26,1,"いえ"],[34,1,"かれ"],[39,1,"なか"],[41,1,"も"],[48,1,"や"],[55,1,"いえ"],[58,1,"のこ"],[60,1,"もの"],[70,1,"しゅ"],[72,1,"い"]],"text":"ヤコブの家は火となり、ヨセフの家は炎となり、エサウの家はわらとなる。彼らはその中に燃えて、これを焼く。エサウの家には残る者がないようになると主は言われた。"},{"ref":"Obad.1.19","start":31001019,"end":31001019,"break":"line","breaks":[[15,"line"],[33,"line"],[46,"line"],[58,"line"]],"ruby":[[4,2,"ひとびと"],[11,1,"やま"],[13,1,"え"],[20,2,"ひとびと"],[30,1,"え"],[35,1,"かれ"],[44,1,"ち"],[54,1,"ち"],[56,1,"え"],[69,1,"え"]],"text":"ネゲブの人々はエサウの山を獲、セフェラの人々はペリシテびとを獲る。また彼らはエフライムの地、およびサマリヤの地を獲、ベニヤミンはギレアデを獲る。"},{"ref":"Obad.1.20","start":31001020,"end":31001020,"break":"line","breaks":[[20,"line"],[35,"line"],[54,"line"]],"ruby":[[11,2,"ひとびと"],[14,1,"とら"],[17,1,"びと"],[32,1,"と"],[48,1,"とら"],[51,1,"びと"],[58,2,"まちまち"],[61,1,"え"]],"text":"ハラにいるイスラエルの人々の捕われ人は、フェニキヤをザレパテまで取り、セパラデにいるエルサレムの捕われ人は、ネゲブの町々を獲る。"},{"ref":"Obad.1.21","start":31001021,"end":31001021,"break":"line","breaks":[[18,"line"],[28,"line"]],"ruby":[[4,1,"すく"],[6,1,"もの"],[12,1,"やま"],[14,1,"のぼ"],[22,1,"やま"],[24,1,"おさ"],[31,2,"おうこく"],[34,1,"しゅ"]],"text":"こうして救う者はシオンの山に上って、エサウの山を治める。そして王国は主のものとなる。"}]