[{"ref":"Eccl.11.1","start":21011001,"end":21011001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[7,1,"みず"],[9,1,"うえ"],[11,1,"な"],[15,1,"おお"],[18,1,"ひ"],[20,1,"のち"],[29,1,"え"]],"text":"あなたのパンを水の上に投げよ、多くの日の後、あなたはそれを得るからである。"},{"ref":"Eccl.11.2","start":21011002,"end":21011002,"break":"line","breaks":[[20,"line"]],"ruby":[[7,1,"ぶん"],[16,1,"わ"],[28,1,"わざわい"],[30,1,"ち"],[32,1,"おこ"],[36,1,"し"]],"text":"あなたは一つの分を七つまた八つに分けよ、あなたは、どんな災が地に起るかを知らないからだ。"},{"ref":"Eccl.11.3","start":21011003,"end":21011003,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[0,1,"くも"],[4,1,"あめ"],[6,1,"み"],[13,1,"ち"],[18,1,"そそ"],[23,1,"き"],[27,1,"みなみ"],[29,1,"きた"],[31,1,"たお"],[40,1,"き"],[42,1,"たお"],[45,1,"ところ"],[47,1,"よこ"]],"text":"雲がもし雨で満ちるならば、地にそれを注ぐ、また木がもし南か北に倒れるならば、その木は倒れた所に横たわる。"},{"ref":"Eccl.11.4","start":21011004,"end":21011004,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かぜ"],[2,2,"けいかい"],[6,1,"もの"],[8,1,"たね"],[15,1,"くも"],[17,2,"かんそく"],[21,1,"もの"],[23,1,"か"]],"text":"風を警戒する者は種をまかない、雲を観測する者は刈ることをしない。"},{"ref":"Eccl.11.5","start":21011005,"end":21011005,"break":"paragraph","ruby":[[5,1,"み"],[10,1,"おんな"],[12,1,"たい"],[14,1,"なか"],[21,1,"れい"],[23,1,"ほね"],[30,1,"し"],[49,1,"こと"],[55,1,"かみ"],[60,1,"し"]],"text":"あなたは、身ごもった女の胎の中で、どうして霊が骨にはいるかを知らない。そのようにあなたは、すべての事をなされる神のわざを知らない。"},{"ref":"Eccl.11.6","start":21011006,"end":21011006,"break":"paragraph","ruby":[[0,1,"あさ"],[5,1,"たね"],[10,1,"ゆう"],[13,1,"て"],[15,1,"やす"],[24,1,"みの"],[52,1,"よ"],[64,1,"し"]],"text":"朝のうちに種をまけ、夕まで手を休めてはならない。実るのは、これであるか、あれであるか、あるいは二つともに良いのであるか、あなたは知らないからである。"},{"ref":"Eccl.11.7","start":21011007,"end":21011007,"break":"paragraph","ruby":[[0,1,"ひかり"],[2,1,"こころよ"],[10,1,"め"],[12,2,"たいよう"],[15,1,"み"],[19,1,"たの"]],"text":"光は快いものである。目に太陽を見るのは楽しいことである。"},{"ref":"Eccl.11.8","start":21011008,"end":21011008,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"おお"],[5,1,"ねん"],[7,1,"い"],[23,2,"じぶん"],[26,1,"たの"],[33,1,"くら"],[35,1,"ひ"],[37,1,"おお"],[46,1,"わす"],[66,1,"こと"],[68,1,"みな"],[69,1,"くう"]],"text":"人が多くの年、生きながらえ、そのすべてにおいて自分を楽しませても、暗い日の多くあるべきことを忘れてはならない。すべて、きたらんとする事は皆空である。"},{"ref":"Eccl.11.9","start":21011009,"end":21011009,"break":"paragraph","ruby":[[0,1,"わか"],[2,1,"もの"],[9,1,"わか"],[11,1,"とき"],[13,1,"たの"],[21,1,"わか"],[23,1,"ひ"],[29,1,"こころ"],[31,1,"よろこ"],[40,1,"こころ"],[42,1,"みち"],[44,1,"あゆ"],[51,1,"め"],[53,1,"み"],[59,1,"あゆ"],[72,1,"こと"],[78,1,"かみ"],[92,1,"し"]],"text":"若い者よ、あなたの若い時に楽しめ。あなたの若い日にあなたの心を喜ばせよ。あなたの心の道に歩み、あなたの目の見るところに歩め。ただし、そのすべての事のために、神はあなたをさばかれることを知れ。"},{"ref":"Eccl.11.10","start":21011010,"end":21011010,"break":"paragraph","ruby":[[4,1,"こころ"],[7,1,"なや"],[10,1,"さ"],[22,1,"いた"],[25,1,"のぞ"],[28,1,"わか"],[30,1,"とき"],[32,1,"さか"],[35,1,"とき"],[40,1,"くう"]],"text":"あなたの心から悩みを去り、あなたのからだから痛みを除け。若い時と盛んな時はともに空だからである。"}]