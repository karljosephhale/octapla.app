[{"ref":"Gen.45.1","start":1045001,"end":1045001,"break":"paragraph","ruby":[[10,1,"た"],[19,1,"ひと"],[21,1,"まえ"],[24,2,"じぶん"],[27,1,"せい"],[40,1,"ひと"],[42,1,"みな"],[47,1,"で"],[55,1,"よ"],[69,2,"きょうだい"],[74,2,"じぶん"],[80,1,"あ"],[84,1,"とき"],[90,1,"かれ"],[95,1,"た"],[100,1,"もの"]],"text":"そこでヨセフはそばに立っているすべての人の前で、自分を制しきれなくなったので、「人は皆ここから出てください」と呼ばわった。それゆえヨセフが兄弟たちに自分のことを明かした時、ひとりも彼のそばに立っている者はなかった。"},{"ref":"Gen.45.2","start":1045002,"end":1045002,"break":"none","ruby":[[4,1,"こえ"],[9,1,"な"],[23,1,"き"],[29,1,"いえ"],[34,1,"き"]],"text":"ヨセフは声をあげて泣いた。エジプトびとはこれを聞き、パロの家もこれを聞いた。"},{"ref":"Gen.45.3","start":1045003,"end":1045003,"break":"none","ruby":[[4,2,"きょうだい"],[9,1,"い"],[24,1,"ちち"],[28,1,"い"],[41,2,"きょうだい"],[46,1,"こた"],[59,1,"かれ"],[62,1,"おどろ"],[64,1,"おそ"]],"text":"ヨセフは兄弟たちに言った、「わたしはヨセフです。父はまだ生きながらえていますか」。兄弟たちは答えることができなかった。彼らは驚き恐れたからである。"},{"ref":"Gen.45.4","start":1045004,"end":1045004,"break":"paragraph","ruby":[[4,2,"きょうだい"],[9,1,"い"],[18,2,"ちかよ"],[28,1,"かれ"],[31,2,"ちかよ"],[37,1,"かれ"],[39,1,"い"],[54,1,"おとうと"],[72,1,"う"],[75,1,"もの"]],"text":"ヨセフは兄弟たちに言った、「わたしに近寄ってください」。彼らが近寄ったので彼は言った、「わたしはあなたがたの弟ヨセフです。あなたがたがエジプトに売った者です。"},{"ref":"Gen.45.5","start":1045005,"end":1045005,"break":"none","ruby":[[10,1,"う"],[15,1,"なげ"],[21,1,"くや"],[32,1,"かみ"],[34,1,"いのち"],[36,1,"すく"]],"text":"しかしわたしをここに売ったのを嘆くことも、悔むこともいりません。神は命を救うために、あなたがたよりさきにわたしをつかわされたのです。"},{"ref":"Gen.45.6","start":1045006,"end":1045006,"break":"none","ruby":[[3,1,"ねん"],[5,1,"あいだ"],[7,2,"くにぢゅう"],[22,1,"ねん"],[24,1,"あいだ"],[26,1,"たがや"],[31,1,"か"],[33,1,"い"]],"text":"この二年の間、国中にききんがあったが、なお五年の間は耕すことも刈り入れることもないでしょう。"},{"ref":"Gen.45.7","start":1045007,"end":1045007,"break":"none","ruby":[[0,1,"かみ"],[12,1,"ち"],[14,1,"のこ"],[21,1,"おお"],[25,1,"すくい"],[36,1,"いのち"],[38,1,"たす"]],"text":"神は、あなたがたのすえを地に残すため、また大いなる救をもってあなたがたの命を助けるために、わたしをあなたがたよりさきにつかわされたのです。"},{"ref":"Gen.45.8","start":1045008,"end":1045008,"break":"none","ruby":[[28,1,"かみ"],[32,1,"かみ"],[41,1,"ちち"],[47,2,"ぜんか"],[50,1,"しゅ"],[60,2,"ぜんこく"]],"text":"それゆえわたしをここにつかわしたのはあなたがたではなく、神です。神はわたしをパロの父とし、その全家の主とし、またエジプト全国のつかさとされました。"},{"ref":"Gen.45.9","start":1045009,"end":1045009,"break":"none","ruby":[[6,1,"ちち"],[11,1,"いそ"],[13,1,"のぼ"],[16,1,"い"],[27,1,"こ"],[35,1,"い"],[41,1,"かみ"],[51,2,"ぜんこく"],[54,1,"しゅ"],[72,1,"ところ"],[74,1,"くだ"]],"text":"あなたがたは父のもとに急ぎ上って言いなさい、『あなたの子ヨセフが、こう言いました。神がわたしをエジプト全国の主とされたから、ためらわずにわたしの所へ下ってきなさい。"},{"ref":"Gen.45.10","start":1045010,"end":1045010,"break":"none","ruby":[[8,1,"ち"],[10,1,"す"],[22,1,"こ"],[26,1,"まご"],[31,1,"ひつじ"],[33,1,"うし"],[38,1,"た"],[50,1,"ちか"]],"text":"あなたはゴセンの地に住み、あなたも、あなたの子らも、孫たちも、羊も牛も、その他のものもみな、わたしの近くにおらせます。"},{"ref":"Gen.45.11","start":1045011,"end":1045011,"break":"none","ruby":[[7,1,"ねん"],[21,2,"かぞく"],[27,1,"た"],[35,1,"こま"],[50,1,"やしな"]],"text":"ききんはなお五年つづきますから、あなたも、家族も、その他のものも、みな困らないように、わたしはそこで養いましょう』。"},{"ref":"Gen.45.12","start":1045012,"end":1045012,"break":"none","ruby":[[6,1,"おとうと"],[13,1,"め"],[15,1,"み"],[27,1,"くちずか"],[29,1,"かた"]],"text":"あなたがたと弟ベニヤミンが目に見るとおり、あなたがたに口ら語っているのはこのわたしです。"},{"ref":"Gen.45.13","start":1045013,"end":1045013,"break":"none","ruby":[[22,1,"さか"],[32,1,"み"],[39,1,"こと"],[45,1,"ちち"],[47,1,"つ"],[50,1,"いそ"],[57,1,"ちち"],[62,1,"つ"],[64,1,"くだ"]],"text":"あなたがたはエジプトでの、わたしのいっさいの栄えと、あなたがたが見るいっさいの事をわたしの父に告げ、急いでわたしの父をここへ連れ下りなさい」。"},{"ref":"Gen.45.14","start":1045014,"end":1045014,"break":"none","ruby":[[7,1,"おとうと"],[17,1,"だ"],[20,1,"な"],[29,1,"かれ"],[34,1,"だ"],[37,1,"な"]],"text":"そしてヨセフは弟ベニヤミンのくびを抱いて泣き、ベニヤミンも彼のくびを抱いて泣いた。"},{"ref":"Gen.45.15","start":1045015,"end":1045015,"break":"none","ruby":[[10,2,"きょうだい"],[15,1,"くち"],[20,1,"かれ"],[23,1,"だ"],[26,1,"な"],[33,1,"のち"],[35,2,"きょうだい"],[40,1,"かれ"],[42,1,"かた"]],"text":"またヨセフはすべての兄弟たちに口づけし、彼らを抱いて泣いた。そして後、兄弟たちは彼と語った。"},{"ref":"Gen.45.16","start":1045016,"end":1045016,"break":"paragraph","ruby":[[0,1,"とき"],[8,2,"きょうだい"],[17,1,"い"],[26,1,"いえ"],[28,1,"きこ"],[39,2,"けらい"],[45,1,"よろこ"]],"text":"時に、「ヨセフの兄弟たちがきた」と言ううわさがパロの家に聞えたので、パロとその家来たちとは喜んだ。"},{"ref":"Gen.45.17","start":1045017,"end":1045017,"break":"none","ruby":[[7,1,"い"],[12,2,"きょうだい"],[17,1,"い"],[38,1,"けもの"],[40,1,"に"],[42,1,"お"],[50,1,"ち"],[52,1,"い"]],"text":"パロはヨセフに言った、「兄弟たちに言いなさい、『あなたがたは、こうしなさい。獣に荷を負わせてカナンの地へ行き、"},{"ref":"Gen.45.18","start":1045018,"end":1045018,"break":"none","ruby":[[0,1,"ちち"],[2,2,"かぞく"],[6,1,"つ"],[37,1,"ち"],[39,1,"よ"],[41,1,"もの"],[43,1,"あた"],[57,1,"くに"],[59,1,"もっと"],[61,1,"よ"],[66,1,"た"]],"text":"父と家族とを連れてわたしのもとへきなさい。わたしはあなたがたに、エジプトの地の良い物を与えます。あなたがたは、この国の最も良いものを食べるでしょう』。"},{"ref":"Gen.45.19","start":1045019,"end":1045019,"break":"none","ruby":[[2,1,"かれ"],[5,1,"めい"],[26,1,"おさ"],[28,1,"ご"],[32,1,"つま"],[44,1,"ち"],[47,1,"くるま"],[52,1,"い"],[55,1,"ちち"],[57,1,"つ"]],"text":"また彼らに命じなさい、『あなたがたは、こうしなさい。幼な子たちと妻たちのためにエジプトの地から車をもって行き、父を連れてきなさい。"},{"ref":"Gen.45.20","start":1045020,"end":1045020,"break":"none","ruby":[[0,2,"かざい"],[3,1,"こころ"],[5,1,"ひ"],[20,2,"ぜんこく"],[23,1,"よ"],[25,1,"もの"]],"text":"家財に心を引かれてはなりません。エジプト全国の良い物は、あなたがたのものだからです』」。"},{"ref":"Gen.45.21","start":1045021,"end":1045021,"break":"paragraph","ruby":[[6,1,"こ"],[24,1,"いのち"],[26,1,"したが"],[29,1,"かれ"],[32,1,"くるま"],[34,1,"あた"],[39,2,"とちゅう"],[42,2,"しょくりょう"],[46,1,"あた"]],"text":"イスラエルの子らはそのようにした。ヨセフはパロの命に従って彼らに車を与え、また途中の食料をも与えた。"},{"ref":"Gen.45.22","start":1045022,"end":1045022,"break":"none","ruby":[[7,2,"はれぎ"],[10,1,"あた"],[22,1,"ぎん"],[29,2,"はれぎ"],[32,1,"ちゃく"],[35,1,"あた"]],"text":"まためいめいに晴着を与えたが、ベニヤミンには銀三百シケルと晴着五着とを与えた。"},{"ref":"Gen.45.23","start":1045023,"end":1045023,"break":"none","ruby":[[2,1,"かれ"],[4,1,"ちち"],[6,1,"つぎ"],[14,1,"おく"],[27,1,"よ"],[29,1,"もの"],[31,1,"お"],[38,1,"とう"],[41,2,"こくもつ"],[46,1,"およ"],[48,1,"ちち"],[50,2,"どうちゅう"],[53,2,"しょくりょう"],[56,1,"お"],[60,1,"め"],[64,1,"とう"]],"text":"また彼は父に次のようなものを贈った。すなわちエジプトの良い物を負わせたろば十頭と、穀物、パン及び父の道中の食料を負わせた雌ろば十頭。"},{"ref":"Gen.45.24","start":1045024,"end":1045024,"break":"none","ruby":[[8,2,"きょうだい"],[13,1,"おく"],[15,1,"さ"],[19,1,"かれ"],[22,1,"い"],[27,2,"とちゅう"],[30,1,"あらそ"]],"text":"こうしてヨセフは兄弟たちを送り去らせ、彼らに言った、「途中で争ってはなりません」。"},{"ref":"Gen.45.25","start":1045025,"end":1045025,"break":"none","ruby":[[0,1,"かれ"],[9,1,"のぼ"],[16,1,"ち"],[18,1,"い"],[21,1,"ちち"],[29,1,"い"]],"text":"彼らはエジプトから上ってカナンの地に入り、父ヤコブのもとへ行って、"},{"ref":"Gen.45.26","start":1045026,"end":1045026,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[13,1,"い"],[22,2,"ぜんこく"],[36,1,"き"],[38,1,"とお"],[44,1,"かれ"],[47,1,"い"],[52,1,"しん"]],"text":"彼に言った、「ヨセフはなお生きていてエジプト全国のつかさです」。ヤコブは気が遠くなった。彼らの言うことが信じられなかったからである。"},{"ref":"Gen.45.27","start":1045027,"end":1045027,"break":"none","ruby":[[3,1,"かれ"],[10,1,"かた"],[13,2,"ことば"],[16,1,"のこ"],[19,1,"かれ"],[21,1,"つ"],[25,1,"ちち"],[34,2,"じぶん"],[37,1,"の"],[43,1,"おく"],[46,1,"くるま"],[48,1,"み"],[50,1,"もと"],[51,1,"き"]],"text":"そこで彼らはヨセフが語った言葉を残らず彼に告げた。父ヤコブはヨセフが自分を乗せるために送った車を見て元気づいた。"},{"ref":"Gen.45.28","start":1045028,"end":1045028,"break":"none","ruby":[[9,1,"い"],[14,2,"まんぞく"],[20,1,"こ"],[27,1,"い"],[37,1,"し"],[39,1,"まえ"],[41,1,"い"],[44,1,"かれ"],[46,1,"み"]],"text":"そしてイスラエルは言った、「満足だ。わが子ヨセフがまだ生きている。わたしは死ぬ前に行って彼を見よう」。"}]