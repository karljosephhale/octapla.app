[{"ref":"Deut.30.1","start":5030001,"end":5030001,"break":"paragraph","ruby":[[10,1,"まえ"],[12,1,"の"],[22,2,"しゅくふく"],[30,1,"こと"],[36,1,"のぞ"],[47,1,"かみ"],[49,1,"しゅ"],[51,1,"お"],[62,2,"こくみん"],[70,1,"こと"],[72,1,"こころ"],[74,1,"かんが"]],"text":"わたしがあなたがたの前に述べたこのもろもろの祝福と、のろいの事があなたに臨み、あなたがあなたの神、主に追いやられたもろもろの国民のなかでこの事を心に考えて、"},{"ref":"Deut.30.2","start":5030002,"end":5030002,"break":"none","ruby":[[8,2,"こども"],[11,1,"とも"],[17,1,"かみ"],[19,1,"しゅ"],[21,1,"た"],[23,1,"かえ"],[35,1,"めい"],[49,1,"こころ"],[55,2,"せいしん"],[63,1,"しゅ"],[65,1,"こえ"],[67,1,"き"],[69,1,"したが"]],"text":"あなたもあなたの子供も共にあなたの神、主に立ち帰り、わたしが、きょう、命じるすべてのことにおいて、心をつくし、精神をつくして、主の声に聞き従うならば、"},{"ref":"Deut.30.3","start":5030003,"end":5030003,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[12,1,"ふたた"],[14,1,"さか"],[32,1,"かみ"],[34,1,"しゅ"],[40,1,"ち"],[45,2,"くにぐに"],[49,1,"ふたた"],[51,1,"あつ"]],"text":"あなたの神、主はあなたを再び栄えさせ、あなたをあわれみ、あなたの神、主はあなたを散らされた国々から再び集められるであろう。"},{"ref":"Deut.30.4","start":5030004,"end":5030004,"break":"none","ruby":[[7,1,"てん"],[12,1,"お"],[24,1,"かみ"],[26,1,"しゅ"],[36,1,"あつ"],[47,1,"つ"],[49,1,"かえ"]],"text":"たといあなたが天のはてに追いやられても、あなたの神、主はそこからあなたを集め、そこからあなたを連れ帰られるであろう。"},{"ref":"Deut.30.5","start":5030005,"end":5030005,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[12,2,"せんぞ"],[15,2,"しょゆう"],[19,1,"ち"],[25,1,"かえ"],[36,2,"しょゆう"],[41,1,"いた"],[48,1,"しゅ"],[56,1,"さか"],[61,1,"かず"],[63,1,"ま"],[66,2,"せんぞ"],[73,1,"おお"]],"text":"あなたの神、主はあなたの先祖が所有した地にあなたを帰らせ、あなたはそれを所有するに至るであろう。主はまたあなたを栄えさせ、数を増して先祖たちよりも多くされるであろう。"},{"ref":"Deut.30.6","start":5030006,"end":5030006,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[15,1,"こころ"],[21,2,"しそん"],[24,1,"こころ"],[26,2,"かつれい"],[29,1,"ほどこ"],[39,1,"こころ"],[45,2,"せいしん"],[56,1,"かみ"],[58,1,"しゅ"],[60,1,"あい"],[72,1,"いのち"],[74,1,"え"]],"text":"そしてあなたの神、主はあなたの心とあなたの子孫の心に割礼を施し、あなたをして、心をつくし、精神をつくしてあなたの神、主を愛させ、こうしてあなたに命を得させられるであろう。"},{"ref":"Deut.30.7","start":5030007,"end":5030007,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[15,2,"はくがい"],[19,1,"てき"],[26,1,"にく"],[28,1,"もの"]],"text":"あなたの神、主はまた、あなたを迫害する敵と、あなたを憎む者とに、このもろもろののろいをこうむらせられるであろう。"},{"ref":"Deut.30.8","start":5030008,"end":5030008,"break":"none","ruby":[[8,1,"ふたた"],[10,1,"しゅ"],[12,1,"こえ"],[14,1,"き"],[16,1,"したが"],[32,1,"めい"],[39,1,"いまし"],[42,1,"まも"]],"text":"しかし、あなたは再び主の声に聞き従い、わたしが、きょう、あなたに命じるすべての戒めを守るであろう。"},{"ref":"Deut.30.9","start":5030009,"end":5030009,"break":"none","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[31,1,"み"],[34,1,"うま"],[37,1,"もの"],[40,2,"かちく"],[43,1,"う"],[49,1,"ち"],[51,1,"さん"],[54,1,"もの"],[56,1,"ゆた"],[59,1,"あた"],[67,1,"さか"],[83,1,"しゅ"],[89,2,"せんぞ"],[94,1,"よろこ"],[101,1,"ふたた"],[107,1,"よろこ"],[115,1,"さか"]],"text":"そうすればあなたの神、主はあなたのするすべてのことと、あなたの身から生れる者と、家畜の産むものと、地に産する物を豊かに与えて、あなたを栄えさせられるであろう。すなわち主はあなたの先祖たちを喜ばれたように再びあなたを喜んで、あなたを栄えさせられるであろう。"},{"ref":"Deut.30.10","start":5030010,"end":5030010,"break":"none","ruby":[[12,1,"かみ"],[14,1,"しゅ"],[16,1,"こえ"],[18,1,"き"],[27,2,"りっぽう"],[30,1,"しょ"],[37,1,"いまし"],[40,1,"さだ"],[44,1,"まも"],[47,1,"こころ"],[53,2,"せいしん"],[64,1,"かみ"],[66,1,"しゅ"],[68,1,"き"]],"text":"これはあなたが、あなたの神、主の声に聞きしたがい、この律法の書にしるされた戒めと定めとを守り、心をつくし、精神をつくしてあなたの神、主に帰するからである。"},{"ref":"Deut.30.11","start":5030011,"end":5030011,"break":"paragraph","ruby":[[13,1,"めい"],[18,1,"いまし"],[36,1,"とお"]],"text":"わたしが、きょう、あなたに命じるこの戒めは、むずかしいものではなく、また遠いものでもない。"},{"ref":"Deut.30.12","start":5030012,"end":5030012,"break":"none","ruby":[[3,1,"てん"],[27,1,"てん"],[29,1,"のぼ"],[44,1,"も"],[55,1,"き"],[59,1,"おこな"],[70,1,"い"],[73,1,"およ"]],"text":"これは天にあるのではないから、『だれがわれわれのために天に上り、それをわれわれのところへ持ってきて、われわれに聞かせ、行わせるであろうか』と言うに及ばない。"},{"ref":"Deut.30.13","start":5030013,"end":5030013,"break":"none","ruby":[[5,1,"うみ"],[33,1,"うみ"],[35,1,"わた"],[38,1,"い"],[53,1,"たずさ"],[64,1,"き"],[68,1,"おこな"],[79,1,"い"],[82,1,"およ"]],"text":"またこれは海のかなたにあるのではないから、『だれがわれわれのために海を渡って行き、それをわれわれのところへ携えてきて、われわれに聞かせ、行わせるであろうか』と言うに及ばない。"},{"ref":"Deut.30.14","start":5030014,"end":5030014,"break":"none","ruby":[[2,2,"ことば"],[14,1,"ちか"],[23,1,"くち"],[34,1,"こころ"],[48,1,"おこな"]],"text":"この言葉はあなたに、はなはだ近くあってあなたの口にあり、またあなたの心にあるから、あなたはこれを行うことができる。"},{"ref":"Deut.30.15","start":5030015,"end":5030015,"break":"paragraph","ruby":[[0,1,"み"],[12,1,"いのち"],[22,1,"し"],[24,1,"わざわい"],[30,1,"まえ"],[32,1,"お"]],"text":"見よ、わたしは、きょう、命とさいわい、および死と災をあなたの前に置いた。"},{"ref":"Deut.30.16","start":5030016,"end":5030016,"break":"none","ruby":[[21,1,"かみ"],[23,1,"しゅ"],[25,1,"あい"],[30,1,"みち"],[32,1,"あゆ"],[37,1,"いまし"],[40,1,"さだ"],[49,1,"まも"],[54,1,"めい"],[61,1,"したが"],[71,1,"い"],[80,1,"かず"],[82,1,"おお"],[97,1,"かみ"],[99,1,"しゅ"],[105,1,"い"],[108,1,"と"],[110,1,"ち"],[116,2,"しゅくふく"]],"text":"すなわちわたしは、きょう、あなたにあなたの神、主を愛し、その道に歩み、その戒めと定めと、おきてとを守ることを命じる。それに従うならば、あなたは生きながらえ、その数は多くなるであろう。またあなたの神、主はあなたが行って取る地であなたを祝福されるであろう。"},{"ref":"Deut.30.17","start":5030017,"end":5030017,"break":"none","ruby":[[10,1,"こころ"],[16,1,"き"],[18,1,"したが"],[22,1,"さそ"],[26,1,"た"],[28,2,"かみがみ"],[31,1,"おが"],[37,1,"つか"]],"text":"しかし、もしあなたが心をそむけて聞き従わず、誘われて他の神々を拝み、それに仕えるならば、"},{"ref":"Deut.30.18","start":5030018,"end":5030018,"break":"none","ruby":[[15,1,"つ"],[25,1,"かなら"],[27,1,"ほろ"],[46,1,"わた"],[53,1,"い"],[56,1,"と"],[58,1,"ち"],[63,1,"いのち"],[65,1,"たも"]],"text":"わたしは、きょう、あなたがたに告げる。あなたがたは必ず滅びるであろう。あなたがたはヨルダンを渡り、はいって行って取る地でながく命を保つことができないであろう。"},{"ref":"Deut.30.19","start":5030019,"end":5030019,"break":"none","ruby":[[9,1,"てん"],[11,1,"ち"],[13,1,"よ"],[22,1,"たい"],[25,2,"しょうにん"],[35,1,"いのち"],[37,1,"し"],[41,2,"しゅくふく"],[52,1,"まえ"],[54,1,"お"],[62,1,"いのち"],[64,1,"えら"],[88,2,"しそん"],[91,1,"い"]],"text":"わたしは、きょう、天と地を呼んであなたがたに対する証人とする。わたしは命と死および祝福とのろいをあなたの前に置いた。あなたは命を選ばなければならない。そうすればあなたとあなたの子孫は生きながらえることができるであろう。"},{"ref":"Deut.30.20","start":5030020,"end":5030020,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"あい"],[18,1,"こえ"],[20,1,"き"],[23,1,"しゅ"],[27,1,"したが"],[47,1,"いのち"],[49,1,"え"],[53,1,"なが"],[55,1,"いのち"],[57,1,"たも"],[65,1,"しゅ"],[67,2,"せんぞ"],[83,1,"あた"],[87,1,"ちか"],[91,1,"ち"],[93,1,"す"]],"text":"すなわちあなたの神、主を愛して、その声を聞き、主につき従わなければならない。そうすればあなたは命を得、かつ長く命を保つことができ、主が先祖アブラハム、イサク、ヤコブに与えると誓われた地に住むことができるであろう」。"}]