[{"ref":"Rev.21.1","start":66021001,"end":66021001,"break":"paragraph","ruby":[[7,1,"あたら"],[10,1,"てん"],[12,1,"あたら"],[15,1,"ち"],[18,1,"み"],[21,1,"さき"],[23,1,"てん"],[25,1,"ち"],[28,1,"き"],[30,1,"さ"],[33,1,"うみ"]],"text":"わたしはまた、新しい天と新しい地とを見た。先の天と地とは消え去り、海もなくなってしまった。"},{"ref":"Rev.21.2","start":66021002,"end":66021002,"break":"none","ruby":[[3,1,"せい"],[6,1,"みやこ"],[8,1,"あたら"],[18,1,"おっと"],[23,2,"きかざ"],[27,2,"はなよめ"],[33,2,"ようい"],[42,1,"かみ"],[47,1,"で"],[50,1,"てん"],[53,1,"くだ"],[56,1,"く"],[60,1,"み"]],"text":"また、聖なる都、新しいエルサレムが、夫のために着飾った花嫁のように用意をととのえて、神のもとを出て、天から下って来るのを見た。"},{"ref":"Rev.21.3","start":66021003,"end":66021003,"break":"none","ruby":[[3,2,"みざ"],[7,1,"おお"],[10,1,"こえ"],[12,1,"さけ"],[16,1,"き"],[21,1,"み"],[24,1,"かみ"],[26,2,"まくや"],[29,1,"ひと"],[31,1,"とも"],[36,1,"かみ"],[38,1,"ひと"],[40,1,"とも"],[42,1,"す"],[45,1,"ひと"],[47,1,"かみ"],[49,1,"たみ"],[54,1,"かみ"],[55,1,"みずか"],[57,1,"ひと"],[59,1,"とも"]],"text":"また、御座から大きな声が叫ぶのを聞いた、「見よ、神の幕屋が人と共にあり、神が人と共に住み、人は神の民となり、神自ら人と共にいまして、"},{"ref":"Rev.21.4","start":66021004,"end":66021004,"break":"none","ruby":[[0,1,"ひと"],[2,1,"め"],[5,1,"なみだ"],[7,1,"まった"],[15,1,"くだ"],[23,1,"し"],[28,1,"かな"],[33,1,"さけ"],[37,1,"いた"],[43,1,"さき"],[52,1,"す"],[54,1,"さ"]],"text":"人の目から涙を全くぬぐいとって下さる。もはや、死もなく、悲しみも、叫びも、痛みもない。先のものが、すでに過ぎ去ったからである」。"},{"ref":"Rev.21.5","start":66021005,"end":66021005,"break":"paragraph","ruby":[[4,2,"みざ"],[13,1,"い"],[19,1,"み"],[33,1,"あら"],[42,1,"い"],[48,1,"か"],[58,2,"ことば"],[62,1,"しん"]],"text":"すると、御座にいますかたが言われた、「見よ、わたしはすべてのものを新たにする」。また言われた、「書きしるせ。これらの言葉は、信ずべきであり、まことである」。"},{"ref":"Rev.21.6","start":66021006,"end":66021006,"break":"none","ruby":[[8,1,"おお"],[15,1,"こと"],[20,1,"な"],[42,1,"はじ"],[47,1,"おわ"],[59,1,"もの"],[67,1,"みず"],[69,1,"いずみ"],[72,1,"あたい"],[76,1,"の"]],"text":"そして、わたしに仰せられた、「事はすでに成った。わたしは、アルパでありオメガである。初めであり終りである。かわいている者には、いのちの水の泉から価なしに飲ませよう。"},{"ref":"Rev.21.7","start":66021007,"end":66021007,"break":"none","ruby":[[0,2,"しょうり"],[3,1,"え"],[5,1,"もの"],[15,1,"う"],[17,1,"つ"],[28,1,"かれ"],[30,1,"かみ"],[35,1,"かれ"],[41,1,"こ"]],"text":"勝利を得る者は、これらのものを受け継ぐであろう。わたしは彼の神となり、彼はわたしの子となる。"},{"ref":"Rev.21.8","start":66021008,"end":66021008,"break":"none","ruby":[[10,1,"もの"],[12,1,"しん"],[16,1,"もの"],[18,1,"い"],[22,1,"もの"],[24,2,"ひとごろ"],[28,2,"かんいん"],[31,1,"おこな"],[33,1,"もの"],[42,1,"もの"],[44,2,"ぐうぞう"],[47,1,"おが"],[49,1,"もの"],[54,1,"いつわ"],[57,1,"い"],[59,1,"もの"],[63,1,"ひ"],[65,2,"いおう"],[68,1,"も"],[73,1,"いけ"],[76,1,"かれ"],[79,1,"う"],[83,1,"むく"],[92,1,"だい"],[95,1,"し"]],"text":"しかし、おくびょうな者、信じない者、忌むべき者、人殺し、姦淫を行う者、まじないをする者、偶像を拝む者、すべて偽りを言う者には、火と硫黄の燃えている池が、彼らの受くべき報いである。これが第二の死である」。"},{"ref":"Rev.21.9","start":66021009,"end":66021009,"break":"paragraph","ruby":[[0,2,"さいご"],[6,2,"さいがい"],[9,1,"み"],[17,1,"はち"],[19,1,"も"],[25,1,"にん"],[27,2,"みつかい"],[41,1,"かた"],[44,1,"い"],[57,2,"こひつじ"],[60,1,"つま"],[63,2,"はなよめ"],[66,1,"み"]],"text":"最後の七つの災害が満ちている七つの鉢を持っていた七人の御使のひとりがきて、わたしに語って言った、「さあ、きなさい。小羊の妻なる花嫁を見せよう」。"},{"ref":"Rev.21.10","start":66021010,"end":66021010,"break":"none","ruby":[[2,2,"みつかい"],[10,2,"みたま"],[13,1,"かん"],[19,1,"おお"],[22,1,"たか"],[24,1,"やま"],[26,1,"つ"],[29,1,"い"],[32,1,"せい"],[33,1,"みやこ"],[41,1,"かみ"],[43,2,"えいこう"],[50,1,"かみ"],[56,1,"で"],[58,1,"てん"],[61,1,"くだ"],[64,1,"く"],[68,1,"み"]],"text":"この御使は、わたしを御霊に感じたまま、大きな高い山に連れて行き、聖都エルサレムが、神の栄光のうちに、神のみもとを出て天から下って来るのを見せてくれた。"},{"ref":"Rev.21.11","start":66021011,"end":66021011,"break":"none","ruby":[[2,1,"みやこ"],[4,1,"かがや"],[8,2,"こうか"],[11,2,"ほうせき"],[20,2,"とうめい"],[23,2,"へきぎょく"]],"text":"その都の輝きは、高価な宝石のようであり、透明な碧玉のようであった。"},{"ref":"Rev.21.12","start":66021012,"end":66021012,"break":"none","ruby":[[4,1,"おお"],[8,1,"たか"],[10,2,"じょうへき"],[20,1,"もん"],[29,1,"もん"],[36,2,"みつかい"],[48,1,"こ"],[53,2,"ぶぞく"],[56,1,"な"],[62,1,"か"]],"text":"それには大きな、高い城壁があって、十二の門があり、それらの門には、十二の御使がおり、イスラエルの子らの十二部族の名が、それに書いてあった。"},{"ref":"Rev.21.13","start":66021013,"end":66021013,"break":"none","ruby":[[0,1,"ひがし"],[5,1,"もん"],[7,1,"きた"],[12,1,"もん"],[14,1,"みなみ"],[19,1,"もん"],[21,1,"にし"],[26,1,"もん"]],"text":"東に三つの門、北に三つの門、南に三つの門、西に三つの門があった。"},{"ref":"Rev.21.14","start":66021014,"end":66021014,"break":"none","ruby":[[2,1,"みやこ"],[4,2,"じょうへき"],[11,2,"どだい"],[21,2,"こひつじ"],[26,2,"しと"],[32,1,"な"],[34,1,"か"]],"text":"また都の城壁には十二の土台があり、それには小羊の十二使徒の十二の名が書いてあった。"},{"ref":"Rev.21.15","start":66021015,"end":66021015,"break":"paragraph","ruby":[[4,1,"かた"],[9,1,"もの"],[12,1,"みやこ"],[16,1,"もん"],[18,2,"じょうへき"],[22,1,"はか"],[28,1,"きん"],[30,1,"はか"],[35,1,"も"]],"text":"わたしに語っていた者は、都とその門と城壁とを測るために、金の測りざおを持っていた。"},{"ref":"Rev.21.16","start":66021016,"end":66021016,"break":"none","ruby":[[0,1,"みやこ"],[2,2,"ほうけい"],[11,1,"なが"],[14,1,"はば"],[17,1,"おな"],[23,1,"かれ"],[27,1,"はか"],[32,1,"みやこ"],[34,1,"はか"],[42,1,"ちょう"],[48,1,"なが"],[51,1,"はば"],[53,1,"たか"],[62,1,"おな"]],"text":"都は方形であって、その長さと幅とは同じである。彼がその測りざおで都を測ると、一万二千丁であった。長さと幅と高さとは、いずれも同じである。"},{"ref":"Rev.21.17","start":66021017,"end":66021017,"break":"none","ruby":[[2,2,"じょうへき"],[5,1,"はか"],[25,2,"にんげん"],[34,2,"みつかい"],[37,2,"しゃくど"]],"text":"また城壁を測ると、百四十四キュビトであった。これは人間の、すなわち、御使の尺度によるのである。"},{"ref":"Rev.21.18","start":66021018,"end":66021018,"break":"none","ruby":[[0,2,"じょうへき"],[3,2,"へきぎょく"],[6,1,"きず"],[10,1,"みやこ"],[25,2,"じゅんきん"],[28,1,"つく"]],"text":"城壁は碧玉で築かれ、都はすきとおったガラスのような純金で造られていた。"},{"ref":"Rev.21.19","start":66021019,"end":66021019,"break":"none","ruby":[[0,1,"みやこ"],[2,2,"じょうへき"],[5,2,"どだい"],[14,2,"ほうせき"],[17,1,"かざ"],[24,1,"だい"],[27,2,"どだい"],[30,2,"へきぎょく"],[33,1,"だい"],[42,1,"だい"],[49,1,"だい"],[52,2,"りょくぎょく"]],"text":"都の城壁の土台は、さまざまな宝石で飾られていた。第一の土台は碧玉、第二はサファイヤ、第三はめのう、第四は緑玉、"},{"ref":"Rev.21.20","start":66021020,"end":66021020,"break":"none","ruby":[[0,1,"だい"],[3,1,"しま"],[8,1,"だい"],[11,1,"あか"],[16,1,"だい"],[23,1,"せき"],[25,1,"だい"],[28,3,"りょくちゅうせき"],[32,1,"だい"],[35,3,"おうぎょくせき"],[39,1,"だい"],[46,1,"だい"],[50,2,"せいぎょく"],[53,1,"だい"],[57,3,"むらさきずいしょう"]],"text":"第五は縞めのう、第六は赤めのう、第七はかんらん石、第八は緑柱石、第九は黄玉石、第十はひすい、第十一は青玉、第十二は紫水晶であった。"},{"ref":"Rev.21.21","start":66021021,"end":66021021,"break":"none","ruby":[[3,1,"もん"],[8,2,"しんじゅ"],[14,1,"もん"],[23,2,"しんじゅ"],[26,1,"つく"],[30,1,"みやこ"],[32,2,"おおどお"],[50,2,"じゅんきん"]],"text":"十二の門は十二の真珠であり、門はそれぞれ一つの真珠で造られ、都の大通りは、すきとおったガラスのような純金であった。"},{"ref":"Rev.21.22","start":66021022,"end":66021022,"break":"paragraph","ruby":[[7,1,"みやこ"],[9,1,"なか"],[12,2,"せいじょ"],[15,1,"み"],[21,3,"ぜんのうしゃ"],[27,1,"しゅ"],[30,1,"かみ"],[32,2,"こひつじ"],[39,2,"せいじょ"]],"text":"わたしは、この都の中には聖所を見なかった。全能者にして主なる神と小羊とが、その聖所なのである。"},{"ref":"Rev.21.23","start":66021023,"end":66021023,"break":"none","ruby":[[0,1,"みやこ"],[3,1,"ひ"],[5,1,"つき"],[10,1,"てら"],[12,2,"ひつよう"],[18,1,"かみ"],[20,2,"えいこう"],[23,1,"みやこ"],[25,1,"あか"],[30,2,"こひつじ"],[33,1,"みやこ"]],"text":"都は、日や月がそれを照す必要がない。神の栄光が都を明るくし、小羊が都のあかりだからである。"},{"ref":"Rev.21.24","start":66021024,"end":66021024,"break":"none","ruby":[[0,1,"しょ"],[1,2,"こくみん"],[4,1,"みやこ"],[6,1,"ひかり"],[8,1,"なか"],[10,1,"ある"],[13,1,"ち"],[15,1,"おう"],[20,2,"じぶん"],[25,2,"こうえい"],[31,1,"たずさ"],[34,1,"く"]],"text":"諸国民は都の光の中を歩き、地の王たちは、自分たちの光栄をそこに携えて来る。"},{"ref":"Rev.21.25","start":66021025,"end":66021025,"break":"none","ruby":[[0,1,"みやこ"],[2,1,"もん"],[5,2,"しゅうじつ"],[8,1,"と"],[23,1,"よる"]],"text":"都の門は、終日、閉ざされることはない。そこには夜がないからである。"},{"ref":"Rev.21.26","start":66021026,"end":66021026,"break":"none","ruby":[[0,2,"ひとびと"],[4,1,"しょ"],[5,2,"こくみん"],[8,2,"こうえい"],[19,1,"たずさ"],[22,1,"く"]],"text":"人々は、諸国民の光栄とほまれとをそこに携えて来る。"},{"ref":"Rev.21.27","start":66021027,"end":66021027,"break":"none","ruby":[[4,1,"けが"],[7,1,"もの"],[10,1,"い"],[16,1,"およ"],[18,1,"いつわ"],[21,1,"おこな"],[23,1,"もの"],[28,1,"なか"],[30,1,"けっ"],[43,1,"もの"],[46,2,"こひつじ"],[53,1,"しょ"],[55,1,"な"],[64,1,"もの"]],"text":"しかし、汚れた者や、忌むべきこと及び偽りを行う者は、その中に決してはいれない。はいれる者は、小羊のいのちの書に名をしるされている者だけである。"}]