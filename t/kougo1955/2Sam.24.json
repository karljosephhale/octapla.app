[{"ref":"2Sam.24.1","start":10024001,"end":10024001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"ふたた"],[10,1,"む"],[14,1,"いか"],[17,1,"はっ"],[24,2,"かんどう"],[28,1,"かれ"],[31,1,"さか"],[37,1,"い"],[50,1,"かぞ"],[55,1,"い"]],"text":"主は再びイスラエルに向かって怒りを発し、ダビデを感動して彼らに逆らわせ、「行ってイスラエルとユダとを数えよ」と言われた。"},{"ref":"2Sam.24.2","start":10024002,"end":10024002,"break":"none","ruby":[[3,1,"おう"],[15,1,"とも"],[19,1,"ぐん"],[21,1,"ちょう"],[25,1,"い"],[40,2,"ぶぞく"],[58,1,"い"],[60,1,"めぐ"],[63,1,"たみ"],[65,1,"かぞ"],[72,1,"たみ"],[74,1,"かず"],[76,1,"し"]],"text":"そこで王はヨアブおよびヨアブと共にいる軍の長たちに言った、「イスラエルのすべての部族のうちを、ダンからベエルシバまで行き巡って民を数え、わたしに民の数を知らせなさい」。"},{"ref":"2Sam.24.3","start":10024003,"end":10024003,"break":"none","ruby":[[4,1,"おう"],[6,1,"い"],[18,1,"かみ"],[20,1,"しゅ"],[23,1,"たみ"],[25,1,"いま"],[30,1,"ばい"],[32,1,"ま"],[48,1,"おう"],[52,1,"しゅ"],[63,1,"み"],[75,1,"おう"],[79,1,"しゅ"],[81,1,"なに"],[87,1,"こと"],[89,1,"よろこ"]],"text":"ヨアブは王に言った、「どうぞあなたの神、主が、民を今よりも百倍に増してくださいますように。そして王、わが主がまのあたり、それを見られますように。しかし王、わが主は何ゆえにこの事を喜ばれるのですか」。"},{"ref":"2Sam.24.4","start":10024004,"end":10024004,"break":"none","ruby":[[3,1,"おう"],[5,2,"ことば"],[12,1,"ぐん"],[14,1,"ちょう"],[19,1,"か"],[29,1,"ぐん"],[31,1,"ちょう"],[36,1,"おう"],[38,1,"まえ"],[40,1,"しりぞ"],[49,1,"たみ"],[51,1,"かぞ"],[57,1,"で"],[59,1,"い"]],"text":"しかし王の言葉がヨアブと軍の長たちとに勝ったので、ヨアブと軍の長たちとは王の前を退き、イスラエルの民を数えるために出て行った。"},{"ref":"2Sam.24.5","start":10024005,"end":10024005,"break":"none","ruby":[[0,1,"かれ"],[8,1,"わた"],[22,1,"たに"],[24,1,"なか"],[28,1,"まち"],[31,1,"はじ"],[38,1,"む"],[46,1,"すす"]],"text":"彼らはヨルダンを渡り、アロエルから、すなわち谷の中にある町から始めて、ガドに向かい、ヤゼルに進んだ。"},{"ref":"2Sam.24.6","start":10024006,"end":10024006,"break":"none","ruby":[[9,1,"い"],[19,1,"ち"],[27,1,"い"],[37,1,"いた"]],"text":"それからギレアデに行き、またヘテびとの地にあるカデシに行き、それからダンに至り、ダンからシドンにまわり、"},{"ref":"2Sam.24.7","start":10024007,"end":10024007,"break":"none","ruby":[[5,2,"ようがい"],[8,1,"い"],[29,1,"まち"],[31,1,"い"],[41,1,"で"],[49,1,"い"]],"text":"またツロの要害に行き、ヒビびと、およびカナンびとのすべての町に行き、ユダのネゲブに出てベエルシバへ行った。"},{"ref":"2Sam.24.8","start":10024008,"end":10024008,"break":"none","ruby":[[4,1,"かれ"],[7,1,"くに"],[13,1,"い"],[15,1,"めぐ"],[21,1,"げつ"],[25,1,"にち"],[27,1,"へ"]],"text":"こうして彼らは国をあまねく行き巡って、九か月と二十日を経てエルサレムにきた。"},{"ref":"2Sam.24.9","start":10024009,"end":10024009,"break":"none","ruby":[[7,1,"たみ"],[9,2,"そうすう"],[12,1,"おう"],[14,1,"つ"],[34,1,"ぬ"],[36,2,"ゆうし"],[54,2,"ひとびと"]],"text":"そしてヨアブは民の総数を王に告げた。すなわちイスラエルには、つるぎを抜く勇士たちが八十万あった。ただしユダの人々は五十万であった。"},{"ref":"2Sam.24.10","start":10024010,"end":10024010,"break":"paragraph","ruby":[[7,1,"たみ"],[9,1,"かぞ"],[12,1,"のち"],[14,1,"こころ"],[16,1,"せ"],[29,1,"しゅ"],[31,1,"い"],[48,1,"おお"],[51,1,"つみ"],[53,1,"おか"],[62,1,"しゅ"],[65,1,"いま"],[73,1,"つみ"],[75,1,"と"],[77,1,"さ"],[94,1,"おろ"]],"text":"しかしダビデは民を数えた後、心に責められた。そこでダビデは主に言った、「わたしはこれをおこなって大きな罪を犯しました。しかし主よ、今どうぞしもべの罪を取り去ってください。わたしはひじょうに愚かなことをいたしました」。"},{"ref":"2Sam.24.11","start":10024011,"end":10024011,"break":"none","ruby":[[4,1,"あさ"],[5,1,"お"],[11,1,"しゅ"],[13,2,"ことば"],[20,3,"せんけんしゃ"],[26,3,"よげんしゃ"],[32,1,"のぞ"],[35,1,"い"]],"text":"ダビデが朝起きたとき、主の言葉はダビデの先見者である預言者ガデに臨んで言った、"},{"ref":"2Sam.24.12","start":10024012,"end":10024012,"break":"none","ruby":[[1,1,"い"],[8,1,"い"],[15,1,"しゅ"],[19,1,"おお"],[36,1,"しめ"],[48,1,"えら"],[65,1,"おこな"]],"text":"「行ってダビデに言いなさい、『主はこう仰せられる、「わたしは三つのことを示す。あなたはその一つを選ぶがよい。わたしはそれをあなたに行うであろう」と』」。"},{"ref":"2Sam.24.13","start":10024013,"end":10024013,"break":"none","ruby":[[13,1,"かれ"],[15,1,"い"],[24,1,"くに"],[27,1,"ねん"],[44,1,"てき"],[46,1,"お"],[52,1,"げつ"],[53,1,"てき"],[55,1,"まえ"],[57,1,"に"],[77,1,"くに"],[80,1,"か"],[82,2,"えきびょう"],[95,1,"かんが"],[105,1,"こたえ"],[118,1,"かた"],[126,1,"き"]],"text":"ガデはダビデのもとにきて、彼に言った、「あなたの国に三年のききんをこさせようか。あなたが敵に追われて三か月敵の前に逃げるようにしようか。それとも、あなたの国に三日の疫病をおくろうか。あなたは考えて、わたしがどの答を、わたしをつかわされた方になすべきかを決めなさい」。"},{"ref":"2Sam.24.14","start":10024014,"end":10024014,"break":"none","ruby":[[7,1,"い"],[21,1,"なや"],[29,1,"しゅ"],[36,1,"おお"],[47,1,"しゅ"],[49,1,"て"],[51,1,"おちい"],[64,1,"ひと"],[66,1,"て"],[69,1,"おちい"]],"text":"ダビデはガデに言った、「わたしはひじょうに悩んでいますが、主のあわれみは大きいゆえ、われわれを主の手に陥らせてください。わたしを人の手には陥らせないでください」。"},{"ref":"2Sam.24.15","start":10024015,"end":10024015,"break":"paragraph","ruby":[[3,1,"しゅ"],[5,1,"あさ"],[8,1,"さだ"],[11,1,"とき"],[14,2,"えきびょう"],[23,1,"くだ"],[40,1,"たみ"],[42,1,"し"],[45,1,"もの"],[49,1,"にん"]],"text":"そこで主は朝から定めの時まで疫病をイスラエルに下された。ダンからベエルシバまでに民の死んだ者は七万人あった。"},{"ref":"2Sam.24.16","start":10024016,"end":10024016,"break":"none","ruby":[[0,1,"てん"],[2,1,"つかい"],[4,1,"て"],[12,1,"の"],[18,1,"ほろ"],[27,1,"しゅ"],[31,2,"がいあく"],[34,1,"く"],[37,1,"たみ"],[39,1,"ほろ"],[45,1,"てん"],[47,1,"つかい"],[49,1,"い"],[68,1,"いま"],[73,1,"て"],[86,1,"とき"],[88,1,"しゅ"],[90,1,"つかい"],[102,1,"う"],[104,1,"ば"]],"text":"天の使が手をエルサレムに伸べてこれを滅ぼそうとしたが、主はこの害悪を悔い、民を滅ぼしている天の使に言われた、「もはや、じゅうぶんである。今あなたの手をとどめるがよい」。その時、主の使はエブスびとアラウナの打ち場のかたわらにいた。"},{"ref":"2Sam.24.17","start":10024017,"end":10024017,"break":"none","ruby":[[4,1,"たみ"],[6,1,"う"],[11,1,"てん"],[13,1,"つかい"],[15,1,"み"],[17,1,"とき"],[19,1,"しゅ"],[21,1,"い"],[30,1,"つみ"],[32,1,"おか"],[42,1,"あく"],[44,1,"おこな"],[57,1,"ひつじ"],[61,1,"なに"],[77,1,"て"],[87,1,"ちち"],[89,1,"いえ"],[91,1,"む"]],"text":"ダビデは民を撃っている天の使を見た時、主に言った、「わたしは罪を犯しました。わたしは悪を行いました。しかしこれらの羊たちは何をしたのですか。どうぞあなたの手をわたしとわたしの父の家に向けてください」。"},{"ref":"2Sam.24.18","start":10024018,"end":10024018,"break":"paragraph","ruby":[[2,1,"ひ"],[16,1,"かれ"],[18,1,"い"],[23,1,"のぼ"],[26,1,"い"],[39,1,"う"],[41,1,"ば"],[43,1,"しゅ"],[45,2,"さいだん"],[48,1,"た"]],"text":"その日ガデはダビデのところにきて彼に言った、「上って行ってエブスびとアラウナの打ち場で主に祭壇を建てなさい」。"},{"ref":"2Sam.24.19","start":10024019,"end":10024019,"break":"none","ruby":[[7,2,"ことば"],[10,1,"したが"],[13,1,"しゅ"],[15,1,"めい"],[23,1,"のぼ"],[26,1,"い"]],"text":"ダビデはガデの言葉に従い、主の命じられたように上って行った。"},{"ref":"2Sam.24.20","start":10024020,"end":10024020,"break":"none","ruby":[[5,1,"み"],[11,1,"おう"],[21,2,"じぶん"],[24,1,"ほう"],[26,1,"すす"],[33,1,"み"],[43,1,"で"],[47,1,"おう"],[49,1,"まえ"],[51,1,"ち"],[55,1,"ふ"],[58,1,"はい"]],"text":"アラウナは見おろして、王とそのしもべたちが自分の方に進んでくるのを見たので、アラウナは出てきて王の前に地にひれ伏して拝した。"},{"ref":"2Sam.24.21","start":10024021,"end":10024021,"break":"none","ruby":[[8,1,"い"],[17,1,"おう"],[20,1,"しゅ"],[27,1,"ところ"],[42,1,"い"],[52,1,"う"],[54,1,"ば"],[56,1,"か"],[58,1,"と"],[61,1,"しゅ"],[63,2,"さいだん"],[66,1,"きず"],[69,1,"たみ"],[71,1,"くだ"],[73,1,"わざわい"]],"text":"そしてアラウナは言った、「どうして王わが主は、しもべの所にこられましたか」。ダビデは言った、「あなたから打ち場を買い取り、主に祭壇を築いて民に下る災をとどめるためです」。"},{"ref":"2Sam.24.22","start":10024022,"end":10024022,"break":"none","ruby":[[9,1,"い"],[17,1,"おう"],[21,1,"しゅ"],[26,1,"おも"],[30,1,"もの"],[32,1,"と"],[44,2,"はんさい"],[49,1,"うし"],[62,1,"だ"],[63,1,"こく"],[64,1,"き"],[66,1,"うし"]],"text":"アラウナはダビデに言った、「どうぞ王、わが主のよいと思われる物を取ってささげてください。燔祭にする牛もあります。たきぎにする打穀機も牛のくびきもあります。"},{"ref":"2Sam.24.23","start":10024023,"end":10024023,"break":"none","ruby":[[0,1,"おう"],[16,1,"おう"],[32,1,"おう"],[40,1,"かみ"],[42,1,"しゅ"],[48,1,"う"],[61,1,"い"]],"text":"王よ、アラウナはこれをことごとく王にささげます」。アラウナはまた王に、「あなたの神、主があなたを受けいれられますように」と言った。"},{"ref":"2Sam.24.24","start":10024024,"end":10024024,"break":"none","ruby":[[3,1,"おう"],[10,1,"い"],[19,2,"だいか"],[22,2,"しはら"],[34,1,"か"],[36,1,"と"],[45,2,"ひよう"],[52,2,"はんさい"],[59,1,"かみ"],[61,1,"しゅ"],[84,1,"ぎん"],[91,1,"う"],[93,1,"ば"],[95,1,"うし"],[98,1,"か"],[100,1,"と"]],"text":"しかし王はアラウナに言った、「いいえ、代価を支払ってそれをあなたから買い取ります。わたしは費用をかけずに燔祭をわたしの神、主にささげることはしません」。こうしてダビデは銀五十シケルで打ち場と牛とを買い取った。"},{"ref":"2Sam.24.25","start":10024025,"end":10024025,"break":"none","ruby":[[6,1,"ところ"],[8,1,"しゅ"],[10,2,"さいだん"],[13,1,"きず"],[16,2,"はんさい"],[19,3,"しゅうおんさい"],[31,1,"しゅ"],[35,1,"ち"],[40,1,"いのり"],[42,1,"き"],[49,1,"わざわい"],[57,1,"くだ"]],"text":"ダビデはその所で主に祭壇を築き、燔祭と酬恩祭をささげた。そこで主はその地のために祈を聞かれたので、災がイスラエルに下ることはとどまった。"}]