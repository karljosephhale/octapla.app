[{"ref":"1Pet.2.1","start":60002001,"end":60002001,"break":"paragraph","ruby":[[8,2,"あくい"],[15,1,"いつわ"],[18,2,"ぎぜん"],[30,2,"あっこう"],[33,1,"す"]],"text":"だから、あらゆる悪意、あらゆる偽り、偽善、そねみ、いっさいの悪口を捨てて、"},{"ref":"1Pet.2.2","start":60002002,"end":60002002,"break":"none","ruby":[[0,1,"いま"],[1,1,"うま"],[8,2,"ちの"],[11,1,"ご"],[17,1,"ま"],[24,1,"れい"],[26,1,"ちち"],[28,1,"した"],[30,1,"もと"],[44,1,"そだ"],[47,1,"すくい"],[49,1,"はい"]],"text":"今生れたばかりの乳飲み子のように、混じりけのない霊の乳を慕い求めなさい。それによっておい育ち、救に入るようになるためである。"},{"ref":"1Pet.2.3","start":60002003,"end":60002003,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"めぐ"],[11,1,"ぶか"],[25,1,"あじ"],[28,1,"し"]],"text":"あなたがたは、主が恵み深いかたであることを、すでに味わい知ったはずである。"},{"ref":"1Pet.2.4","start":60002004,"end":60002004,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"ひと"],[6,1,"す"],[13,1,"かみ"],[19,1,"えら"],[23,1,"たっと"],[25,1,"い"],[28,1,"いし"]],"text":"主は、人には捨てられたが、神にとっては選ばれた尊い生ける石である。"},{"ref":"1Pet.2.5","start":60002005,"end":60002005,"break":"none","ruby":[[2,1,"しゅ"],[22,1,"い"],[25,1,"いし"],[31,1,"れい"],[33,1,"いえ"],[35,1,"きず"],[37,1,"あ"],[42,1,"せい"],[45,2,"さいし"],[64,1,"かみ"],[72,1,"れい"]],"text":"この主のみもとにきて、あなたがたも、それぞれ生ける石となって、霊の家に築き上げられ、聖なる祭司となって、イエス・キリストにより、神によろこばれる霊のいけにえを、ささげなさい。"},{"ref":"1Pet.2.6","start":60002006,"end":60002006,"break":"none","breaks":[[11,"stanza"],[24,"line"],[42,"line"],[52,"line"]],"ruby":[[0,2,"せいしょ"],[5,1,"か"],[12,1,"み"],[24,1,"えら"],[28,1,"たっと"],[30,1,"いし"],[32,1,"すみ"],[37,1,"いし"],[39,1,"お"],[47,1,"たの"],[49,1,"もの"],[52,1,"けっ"],[56,2,"しつぼう"],[59,1,"おわ"]],"text":"聖書にこう書いてある、「見よ、わたしはシオンに、選ばれた尊い石、隅のかしら石を置く。それにより頼む者は、決して、失望に終ることがない」。"},{"ref":"1Pet.2.7","start":60002007,"end":60002007,"break":"none","ruby":[[2,1,"いし"],[7,1,"たの"],[19,1,"たっと"],[28,1,"ふ"],[29,2,"しんこう"],[32,2,"ひとびと"],[37,1,"いえ"],[38,1,"つく"],[42,1,"す"],[45,1,"いし"],[48,1,"すみ"],[53,1,"いし"]],"text":"この石は、より頼んでいるあなたがたには尊いものであるが、不信仰な人々には「家造りらの捨てた石で、隅のかしら石となったもの」、"},{"ref":"1Pet.2.8","start":60002008,"end":60002008,"break":"none","ruby":[[8,1,"いし"],[10,1,"さまた"],[13,1,"いわ"],[23,1,"かれ"],[33,2,"みことば"],[36,1,"したが"],[47,1,"かれ"],[51,1,"じつ"],[61,1,"さだ"]],"text":"また「つまずきの石、妨げの岩」である。しかし、彼らがつまずくのは、御言に従わないからであって、彼らは、実は、そうなるように定められていたのである。"},{"ref":"1Pet.2.9","start":60002009,"end":60002009,"break":"none","ruby":[[11,1,"えら"],[15,2,"しゅぞく"],[18,2,"さいし"],[21,1,"くに"],[23,1,"せい"],[26,2,"こくみん"],[29,1,"かみ"],[34,1,"たみ"],[46,1,"くら"],[51,1,"おどろ"],[56,1,"ひかり"],[58,1,"まね"],[60,1,"い"],[63,1,"くだ"],[81,1,"かた"],[83,1,"つた"]],"text":"しかし、あなたがたは、選ばれた種族、祭司の国、聖なる国民、神につける民である。それによって、暗やみから驚くべきみ光に招き入れて下さったかたのみわざを、あなたがたが語り伝えるためである。"},{"ref":"1Pet.2.10","start":60002010,"end":60002010,"break":"none","ruby":[[7,2,"いぜん"],[10,1,"かみ"],[12,1,"たみ"],[23,1,"かみ"],[25,1,"たみ"],[30,2,"いぜん"],[39,1,"う"],[47,1,"もの"],[63,1,"う"],[66,1,"もの"]],"text":"あなたがたは、以前は神の民でなかったが、いまは神の民であり、以前は、あわれみを受けたことのない者であったが、いまは、あわれみを受けた者となっている。"},{"ref":"1Pet.2.11","start":60002011,"end":60002011,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[14,1,"すす"],[27,1,"よ"],[29,2,"たびびと"],[34,3,"きりゅうしゃ"],[48,1,"たたか"],[54,1,"にく"],[56,1,"よく"],[58,1,"さ"]],"text":"愛する者たちよ。あなたがたに勧める。あなたがたは、この世の旅人であり寄留者であるから、たましいに戦いをいどむ肉の欲を避けなさい。"},{"ref":"1Pet.2.12","start":60002012,"end":60002012,"break":"none","ruby":[[0,3,"いほうじん"],[4,1,"なか"],[14,1,"おこな"],[28,1,"かれ"],[38,2,"あくにん"],[40,1,"よ"],[63,1,"み"],[76,1,"ひ"],[78,1,"かみ"]],"text":"異邦人の中にあって、りっぱな行いをしなさい。そうすれば、彼らは、あなたがたを悪人呼ばわりしていても、あなたがたのりっぱなわざを見て、かえって、おとずれの日に神をあがめるようになろう。"},{"ref":"1Pet.2.13","start":60002013,"end":60002013,"break":"paragraph","ruby":[[10,1,"ひと"],[12,1,"た"],[15,1,"せい"],[16,1,"ど"],[19,1,"しゅ"],[24,1,"したが"],[30,3,"しゅけんしゃ"],[37,1,"おう"]],"text":"あなたがたは、すべて人の立てた制度に、主のゆえに従いなさい。主権者としての王であろうと、"},{"ref":"1Pet.2.14","start":60002014,"end":60002014,"break":"none","ruby":[[5,1,"あく"],[7,1,"おこな"],[9,1,"もの"],[11,1,"ばっ"],[13,1,"ぜん"],[15,1,"おこな"],[17,1,"もの"],[19,1,"しょう"],[26,1,"おう"],[35,2,"ちょうかん"],[46,1,"したが"]],"text":"あるいは、悪を行う者を罰し善を行う者を賞するために、王からつかわされた長官であろうと、これに従いなさい。"},{"ref":"1Pet.2.15","start":60002015,"end":60002015,"break":"none","ruby":[[0,1,"ぜん"],[2,1,"おこな"],[11,1,"おろ"],[14,2,"ひとびと"],[17,2,"むち"],[20,2,"はつげん"],[23,1,"ふう"],[29,1,"かみ"],[31,2,"みむね"]],"text":"善を行うことによって、愚かな人々の無知な発言を封じるのは、神の御旨なのである。"},{"ref":"1Pet.2.16","start":60002016,"end":60002016,"break":"none","ruby":[[0,3,"じゆうじん"],[9,2,"こうどう"],[20,2,"じゆう"],[24,1,"あく"],[26,1,"おこな"],[28,2,"こうじつ"],[33,1,"もち"],[37,1,"かみ"],[39,1,"しもべ"],[46,2,"こうどう"]],"text":"自由人にふさわしく行動しなさい。ただし、自由をば悪を行う口実として用いず、神の僕にふさわしく行動しなさい。"},{"ref":"1Pet.2.17","start":60002017,"end":60002017,"break":"none","ruby":[[4,1,"ひと"],[11,2,"きょうだい"],[16,1,"あい"],[19,1,"かみ"],[25,1,"おう"],[27,1,"たっと"]],"text":"すべての人をうやまい、兄弟たちを愛し、神をおそれ、王を尊びなさい。"},{"ref":"1Pet.2.18","start":60002018,"end":60002018,"break":"paragraph","ruby":[[0,1,"しもべ"],[3,1,"もの"],[6,1,"こころ"],[18,2,"しゅじん"],[21,1,"つか"],[27,2,"ぜんりょう"],[30,2,"かんよう"],[33,2,"しゅじん"],[42,1,"き"],[48,2,"しゅじん"]],"text":"僕たる者よ。心からのおそれをもって、主人に仕えなさい。善良で寛容な主人だけにでなく、気むずかしい主人にも、そうしなさい。"},{"ref":"1Pet.2.19","start":60002019,"end":60002019,"break":"none","ruby":[[7,2,"ふとう"],[10,1,"くる"],[14,1,"う"],[19,1,"かみ"],[21,1,"あお"],[26,2,"くつう"],[29,1,"た"],[31,1,"しの"]],"text":"もしだれかが、不当な苦しみを受けても、神を仰いでその苦痛を耐え忍ぶなら、それはよみせられることである。"},{"ref":"1Pet.2.20","start":60002020,"end":60002020,"break":"none","ruby":[[0,1,"わる"],[7,1,"う"],[17,1,"しの"],[28,2,"てがら"],[39,1,"ぜん"],[41,1,"おこな"],[44,1,"くる"],[48,1,"う"],[57,1,"た"],[59,1,"しの"],[73,1,"かみ"]],"text":"悪いことをして打ちたたかれ、それを忍んだとしても、なんの手柄になるのか。しかし善を行って苦しみを受け、しかもそれを耐え忍んでいるとすれば、これこそ神によみせられることである。"},{"ref":"1Pet.2.21","start":60002021,"end":60002021,"break":"none","ruby":[[7,1,"じつ"],[18,1,"め"],[42,1,"くる"],[46,1,"う"],[49,2,"みあし"],[52,1,"あと"],[54,1,"ふ"],[56,1,"したが"],[63,2,"もはん"],[66,1,"のこ"]],"text":"あなたがたは、実に、そうするようにと召されたのである。キリストも、あなたがたのために苦しみを受け、御足の跡を踏み従うようにと、模範を残されたのである。"},{"ref":"1Pet.2.22","start":60002022,"end":60002022,"break":"none","ruby":[[5,1,"つみ"],[7,1,"おか"],[13,1,"くち"],[16,1,"いつわ"]],"text":"キリストは罪を犯さず、その口には偽りがなかった。"},{"ref":"1Pet.2.23","start":60002023,"end":60002023,"break":"none","ruby":[[17,1,"くる"],[36,1,"ただ"]],"text":"ののしられても、ののしりかえさず、苦しめられても、おびやかすことをせず、正しいさばきをするかたに、いっさいをゆだねておられた。"},{"ref":"1Pet.2.24","start":60002024,"end":60002024,"break":"none","ruby":[[10,1,"つみ"],[12,1,"し"],[15,1,"ぎ"],[17,1,"い"],[24,3,"じゅうじか"],[39,1,"つみ"],[42,2,"じぶん"],[45,1,"み"],[47,1,"お"],[54,1,"きず"]],"text":"さらに、わたしたちが罪に死に、義に生きるために、十字架にかかって、わたしたちの罪をご自分の身に負われた。その傷によって、あなたがたは、いやされたのである。"},{"ref":"1Pet.2.25","start":60002025,"end":60002025,"break":"none","ruby":[[7,1,"ひつじ"],[13,1,"まよ"],[20,1,"いま"],[28,2,"ぼくしゃ"],[33,2,"かんとく"],[47,1,"かえ"]],"text":"あなたがたは、羊のようにさ迷っていたが、今は、たましいの牧者であり監督であるかたのもとに、たち帰ったのである。"}]