[{"ref":"Exod.31.1","start":2031001,"end":2031001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Exod.31.2","start":2031002,"end":2031002,"break":"none","ruby":[[1,1,"み"],[11,2,"ぶぞく"],[14,1,"ぞく"],[20,1,"こ"],[26,1,"こ"],[32,1,"な"],[36,1,"め"]],"text":"「見よ、わたしはユダの部族に属するホルの子なるウリの子ベザレルを名ざして召し、"},{"ref":"Exod.31.3","start":2031003,"end":2031003,"break":"none","ruby":[[3,1,"かみ"],[5,1,"れい"],[7,1,"み"],[12,2,"ちえ"],[15,1,"さと"],[18,2,"ちしき"],[21,2,"しょしゅ"],[24,2,"こうさく"],[27,1,"ちょう"]],"text":"これに神の霊を満たして、知恵と悟りと知識と諸種の工作に長ぜしめ、"},{"ref":"Exod.31.4","start":2031004,"end":2031004,"break":"none","ruby":[[0,2,"くふう"],[3,1,"こ"],[7,1,"きん"],[9,1,"ぎん"],[11,2,"せいどう"],[14,2,"さいく"]],"text":"工夫を凝らして金、銀、青銅の細工をさせ、"},{"ref":"Exod.31.5","start":2031005,"end":2031005,"break":"none","ruby":[[2,2,"ほうせき"],[5,1,"き"],[10,1,"き"],[12,2,"ちょうこく"],[19,2,"しょしゅ"],[22,2,"こうさく"]],"text":"また宝石を切りはめ、木を彫刻するなど、諸種の工作をさせるであろう。"},{"ref":"Exod.31.6","start":2031006,"end":2031006,"break":"none","ruby":[[0,1,"み"],[12,2,"ぶぞく"],[15,1,"ぞく"],[24,1,"こ"],[31,1,"かれ"],[33,1,"とも"],[44,1,"かしこ"],[46,1,"もの"],[48,1,"こころ"],[50,2,"ちえ"],[53,1,"さづ"],[64,1,"めい"],[76,1,"かれ"],[79,1,"つく"]],"text":"見よ、わたしはまたダンの部族に属するアヒサマクの子アホリアブを彼と共ならせ、そしてすべて賢い者の心に知恵を授け、わたしがあなたに命じたものを、ことごとく彼らに造らせるであろう。"},{"ref":"Exod.31.7","start":2031007,"end":2031007,"break":"none","ruby":[[4,2,"かいけん"],[7,2,"まくや"],[14,1,"はこ"],[18,1,"うえ"],[22,3,"しょくざいしょ"],[26,2,"まくや"],[34,1,"うつわ"]],"text":"すなわち会見の幕屋、あかしの箱、その上にある贖罪所、幕屋のもろもろの器、"},{"ref":"Exod.31.8","start":2031008,"end":2031008,"break":"none","ruby":[[0,1,"つくえ"],[4,1,"うつわ"],[6,2,"じゅんきん"],[9,2,"しょくだい"],[20,1,"うつわ"],[22,1,"こう"],[24,2,"さいだん"]],"text":"机とその器、純金の燭台と、そのもろもろの器、香の祭壇、"},{"ref":"Exod.31.9","start":2031009,"end":2031009,"break":"none","ruby":[[0,2,"はんさい"],[3,2,"さいだん"],[13,1,"うつわ"],[15,2,"せんばん"],[20,1,"だい"]],"text":"燔祭の祭壇とそのもろもろの器、洗盤とその台、"},{"ref":"Exod.31.10","start":2031010,"end":2031010,"break":"none","ruby":[[0,2,"あみもの"],[3,1,"ふく"],[9,2,"さいし"],[12,1,"つとめ"],[19,2,"さいし"],[25,1,"せい"],[28,1,"ふく"],[35,1,"こ"],[39,1,"ふく"]],"text":"編物の服、すなわち祭司の務をするための祭司アロンの聖なる服、およびその子たちの服、"},{"ref":"Exod.31.11","start":2031011,"end":2031011,"break":"none","ruby":[[0,1,"そそ"],[2,1,"あぶら"],[4,2,"せいじょ"],[10,1,"こう"],[14,1,"こう"],[30,1,"めい"],[36,1,"つく"]],"text":"注ぎ油、聖所のための香ばしい香などを、すべてわたしがあなたに命じたように造らせるであろう」。"},{"ref":"Exod.31.12","start":2031012,"end":2031012,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Exod.31.13","start":2031013,"end":2031013,"break":"none","ruby":[[11,2,"ひとびと"],[14,1,"い"],[27,1,"かなら"],[33,3,"あんそくにち"],[37,1,"まも"],[62,1,"あいだ"],[65,2,"よよ"],[89,2,"せいべつ"],[93,1,"しゅ"],[101,1,"し"]],"text":"「あなたはイスラエルの人々に言いなさい、『あなたがたは必ずわたしの安息日を守らなければならない。これはわたしとあなたがたとの間の、代々にわたるしるしであって、わたしがあなたがたを聖別する主であることを、知らせるためのものである。"},{"ref":"Exod.31.14","start":2031014,"end":2031014,"break":"none","ruby":[[11,3,"あんそくにち"],[15,1,"まも"],[35,1,"せい"],[38,1,"ひ"],[49,1,"けが"],[51,1,"もの"],[53,1,"かなら"],[55,1,"ころ"],[64,1,"ひ"],[66,2,"しごと"],[71,1,"もの"],[74,1,"たみ"],[80,1,"た"]],"text":"それゆえ、あなたがたは安息日を守らなければならない。これはあなたがたに聖なる日である。すべてこれを汚す者は必ず殺され、すべてこの日に仕事をする者は、民のうちから断たれるであろう。"},{"ref":"Exod.31.15","start":2031015,"end":2031015,"break":"none","ruby":[[1,1,"か"],[7,2,"しごと"],[15,2,"なぬか"],[17,1,"め"],[19,1,"まった"],[21,1,"やす"],[24,3,"あんそくにち"],[29,1,"しゅ"],[34,1,"せい"],[42,3,"あんそくにち"],[46,2,"しごと"],[51,1,"もの"],[53,1,"かなら"],[55,1,"ころ"]],"text":"六日のあいだは仕事をしなさい。七日目は全き休みの安息日で、主のために聖である。すべて安息日に仕事をする者は必ず殺されるであろう。"},{"ref":"Exod.31.16","start":2031016,"end":2031016,"break":"none","ruby":[[10,2,"ひとびと"],[13,3,"あんそくにち"],[17,1,"おぼ"],[20,2,"えいえん"],[23,2,"けいやく"],[29,2,"よよ"],[31,3,"あんそくにち"],[35,1,"まも"]],"text":"ゆえに、イスラエルの人々は安息日を覚え、永遠の契約として、代々安息日を守らなければならない。"},{"ref":"Exod.31.17","start":2031017,"end":2031017,"break":"none","ruby":[[3,2,"えいえん"],[16,2,"ひとびと"],[20,1,"あいだ"],[32,1,"しゅ"],[35,1,"か"],[41,2,"てんち"],[44,1,"つく"],[47,2,"なぬか"],[49,1,"め"],[51,1,"やす"]],"text":"これは永遠にわたしとイスラエルの人々との間のしるしである。それは主が六日のあいだに天地を造り、七日目に休み、かつ、いこわれたからである』」。"},{"ref":"Exod.31.18","start":2031018,"end":2031018,"break":"paragraph","ruby":[[0,1,"しゅ"],[5,1,"さん"],[11,1,"かた"],[13,1,"お"],[25,1,"いた"],[27,1,"まい"],[33,1,"かみ"],[35,1,"ゆび"],[40,1,"か"],[44,1,"いし"],[46,1,"いた"],[52,1,"さづ"]],"text":"主はシナイ山でモーセに語り終えられたとき、あかしの板二枚、すなわち神が指をもって書かれた石の板をモーセに授けられた。"}]