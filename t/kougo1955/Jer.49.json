[{"ref":"Jer.49.1","start":24049001,"end":24049001,"break":"paragraph","breaks":[[11,"line"],[20,"line"],[44,"line"],[62,"line"]],"ruby":[[11,1,"しゅ"],[15,1,"い"],[28,1,"こ"],[35,2,"よつ"],[56,1,"お"],[58,1,"だ"],[64,1,"たみ"],[68,2,"まちまち"],[71,1,"す"]],"text":"アンモンびとについて、主はこう言われる、「イスラエルには子がないのか、世継ぎがないのか。どうしてミルコムがガドを追い出して、その民がその町々に住んでいるのか。"},{"ref":"Jer.49.2","start":24049002,"end":24049002,"break":"line","breaks":[[7,"line"],[28,"line"],[49,"line"],[70,"line"],[92,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"み"],[25,1,"せ"],[28,1,"たたか"],[31,1,"さけ"],[39,1,"きこ"],[44,1,"ひ"],[46,1,"く"],[52,2,"あれづか"],[60,2,"むらむら"],[63,1,"ひ"],[65,1,"や"],[80,2,"じぶん"],[83,1,"お"],[85,1,"だ"],[88,1,"もの"],[92,1,"お"],[94,1,"だ"],[97,1,"しゅ"],[99,1,"い"]],"text":"主は言われる、それゆえ、見よ、アンモンびとのラバを攻める戦いの叫びを、わたしが聞えさせる日が来る。ラバは荒塚となり、その村々は火で焼かれる。そのときイスラエルは自分を追い出した者どもを追い出すと主は言われる。"},{"ref":"Jer.49.3","start":24049003,"end":24049003,"break":"stanza","breaks":[[17,"line"],[29,"line"],[43,"line"],[56,"line"],[72,"line"]],"ruby":[[5,1,"なげ"],[11,1,"ほろ"],[20,1,"むすめ"],[24,1,"よ"],[29,2,"あらぬの"],[32,1,"み"],[38,1,"かな"],[50,1,"はし"],[63,2,"さいし"],[72,1,"とも"],[74,1,"とら"],[76,1,"うつ"]],"text":"ヘシボンよ嘆け、アイは滅ぼされた。ラバの娘たちよ呼ばわれ。荒布を身にまとい、悲しんで、まがきのうちを走りまわれ。ミルコムとその祭司およびつかさが共に捕え移されるからだ。"},{"ref":"Jer.49.4","start":24049004,"end":24049004,"break":"line","breaks":[[6,"line"],[24,"line"],[39,"line"]],"ruby":[[0,2,"ふしん"],[3,1,"むすめ"],[12,2,"じぶん"],[15,1,"たに"],[17,1,"こと"],[19,1,"ほこ"],[28,2,"じぶん"],[31,1,"とみ"],[33,1,"よ"],[35,1,"たよ"],[47,1,"せ"],[57,1,"い"]],"text":"不信の娘よ、あなたはなぜ自分の谷の事を誇るのか。あなたは自分の富に寄り頼んで、『だれがわたしに攻めてくるものか』と言う。"},{"ref":"Jer.49.5","start":24049005,"end":24049005,"break":"line","breaks":[[13,"line"],[34,"line"],[50,"line"],[72,"line"]],"ruby":[[0,1,"しゅ"],[3,2,"ばんぐん"],[6,1,"かみ"],[8,1,"い"],[13,1,"み"],[24,1,"うえ"],[26,1,"おそ"],[29,1,"のぞ"],[41,2,"しゅうい"],[44,1,"もの"],[47,1,"く"],[54,1,"お"],[63,1,"ただ"],[66,2,"たにん"],[69,1,"つづ"],[72,1,"に"],[75,1,"もの"],[77,1,"あつ"],[80,1,"ひと"]],"text":"主なる万軍の神は言われる、見よ、わたしはあなたの上に恐れを臨ませる、それはあなたの周囲の者から来る。あなたは追われて、おのおの直ちに他人に続き、逃げる者を集める人もない。"},{"ref":"Jer.49.6","start":24049006,"end":24049006,"break":"none","ruby":[[22,1,"ふたた"],[24,1,"さか"],[31,1,"しゅ"],[33,1,"い"]],"text":"しかし、のちになって、わたしはアンモンびとを再び栄えさせると、主は言われる」。"},{"ref":"Jer.49.7","start":24049007,"end":24049007,"break":"paragraph","breaks":[[22,"line"],[40,"line"],[59,"line"]],"ruby":[[4,1,"こと"],[10,2,"ばんぐん"],[13,1,"しゅ"],[17,1,"い"],[32,2,"ちえ"],[43,1,"もの"],[46,1,"はか"],[61,2,"ちえ"],[64,1,"き"]],"text":"エドムの事について、万軍の主はこう言われる、「テマンには、もはや知恵がないのか。さとい者には計りごとがなくなったのか。その知恵は消えうせたのか。"},{"ref":"Jer.49.8","start":24049008,"end":24049008,"break":"line","breaks":[[9,"line"],[26,"line"],[45,"line"]],"ruby":[[4,1,"す"],[6,1,"もの"],[9,1,"に"],[18,1,"ふか"],[20,1,"ところ"],[22,1,"かく"],[34,2,"さいなん"],[37,1,"かれ"],[39,1,"うえ"],[41,1,"のぞ"],[45,1,"かれ"],[47,1,"ばっ"],[50,1,"とき"]],"text":"デダンに住む者よ、逃げよ、のがれよ、深い所に隠れよ。わたしがエサウの災難を彼の上に臨ませ、彼を罰する時をこさせるからだ。"},{"ref":"Jer.49.9","start":24049009,"end":24049009,"break":"line","breaks":[[21,"line"],[38,"line"],[50,"line"]],"ruby":[[4,1,"あつ"],[7,1,"もの"],[13,1,"ところ"],[15,1,"き"],[25,1,"み"],[28,1,"のこ"],[38,1,"よる"],[40,1,"ぬす"],[44,1,"き"],[50,2,"じぶん"],[55,2,"まんぞく"],[61,1,"ほろ"]],"text":"ぶどうを集める者があなたの所に来たならば、すこしの実をも残さないであろうか。夜、盗びとが来たならば、自分たちの満足するだけ滅ぼさないであろうか。"},{"ref":"Jer.49.10","start":24049010,"end":24049010,"break":"line","breaks":[[15,"line"],[28,"line"],[44,"line"],[67,"line"]],"ruby":[[11,1,"はだか"],[17,1,"かく"],[20,1,"ところ"],[22,1,"あらわ"],[28,1,"かれ"],[32,1,"み"],[34,1,"かく"],[46,1,"こ"],[53,2,"きょうだい"],[57,1,"とな"],[59,1,"びと"],[61,1,"ほろ"],[70,1,"かれ"]],"text":"しかしわたしはエサウを裸にし、その隠れる所を現したので、彼はその身を隠すことができない。その子どもたちも、兄弟も、隣り人も滅ぼされる。そして彼は、いなくなる。"},{"ref":"Jer.49.11","start":24049011,"end":24049011,"break":"line","breaks":[[12,"line"],[29,"line"]],"ruby":[[9,1,"のこ"],[19,1,"い"],[43,1,"よ"],[45,1,"たの"]],"text":"あなたのみなしごを残せ、わたしがそれを生きながらえさせる。あなたのやもめには、わたしに寄り頼ませよ」。"},{"ref":"Jer.49.12","start":24049012,"end":24049012,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"い"],[13,1,"さかずき"],[15,1,"の"],[22,1,"もの"],[27,1,"の"],[48,1,"ばつ"],[50,1,"まぬか"],[66,1,"ばつ"],[68,1,"まぬか"],[76,1,"の"]],"text":"主はこう言われる、「もし、杯を飲むべきでない者もそれを飲まなければならなかったとすれば、あなたは罰を免れることができようか。あなたは罰を免れない。それを飲まなければならない。"},{"ref":"Jer.49.13","start":24049013,"end":24049013,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[11,2,"じぶん"],[17,1,"ちか"],[25,1,"おどろ"],[39,1,"あ"],[41,1,"ち"],[55,2,"まちまち"],[58,1,"なが"],[60,1,"あ"],[62,1,"ち"]],"text":"主は言われる、わたしは自分をさして誓った、ボズラは驚きとなり、ののしりとなり、荒れ地となり、のろいとなる。その町々は長く荒れ地となる」。"},{"ref":"Jer.49.14","start":24049014,"end":24049014,"break":"stanza","breaks":[[17,"line"],[36,"line"],[43,"line"]],"ruby":[[4,1,"しゅ"],[13,1,"き"],[21,2,"ししゃ"],[30,2,"ばんこく"],[33,1,"い"],[39,1,"い"],[50,1,"あつ"],[54,1,"い"],[57,1,"かれ"],[59,1,"せ"],[62,1,"た"],[65,1,"たたか"]],"text":"わたしは主からのおとずれを聞いた。ひとりの使者がつかわされて万国に行き、そして言った、「あなたがたは集まり、行って彼を攻め、立って戦え。"},{"ref":"Jer.49.15","start":24049015,"end":24049015,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"み"],[11,2,"ばんこく"],[17,1,"ちい"],[20,1,"もの"],[24,2,"ひとびと"],[30,1,"いや"],[36,1,"もの"]],"text":"見よ、わたしはあなたを万国のうちに小さい者とし、人々のうちに卑しめられる者とする。"},{"ref":"Jer.49.16","start":24049016,"end":24049016,"break":"line","breaks":[[20,"line"],[42,"line"],[50,"line"],[75,"line"],[94,"line"]],"ruby":[[0,1,"いわ"],[2,1,"わ"],[4,1,"め"],[6,1,"す"],[9,1,"やま"],[11,1,"たか"],[14,1,"し"],[17,1,"もの"],[24,1,"おそ"],[28,1,"こと"],[35,1,"こころ"],[37,1,"たか"],[46,1,"あざむ"],[62,1,"す"],[64,1,"たか"],[66,1,"ところ"],[68,1,"つく"],[81,1,"ところ"],[88,1,"と"],[94,1,"しゅ"],[96,1,"い"]],"text":"岩の割れ目に住み、山の高みを占める者よ、あなたの恐ろしい事と、あなたの心の高ぶりが、あなたを欺いた。あなたは、わたしのように巣を高い所に作っているが、わたしはその所からあなたを取りおろすと主は言われる。"},{"ref":"Jer.49.17","start":24049017,"end":24049017,"break":"paragraph","ruby":[[4,1,"おそ"],[17,1,"とお"],[19,1,"す"],[22,1,"もの"],[26,1,"おそ"],[31,1,"わざわい"],[37,2,"したう"]],"text":"エドムは恐れとなる。そのかたわらを通り過ぎる者はみな恐れ、その災のために、舌打ちする。"},{"ref":"Jer.49.18","start":24049018,"end":24049018,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[17,1,"となり"],[19,2,"まちまち"],[29,1,"とき"],[38,1,"す"],[40,1,"ひと"],[48,1,"やど"],[50,1,"ひと"]],"text":"主は言われる、ソドムとゴモラとその隣の町々がくつがえされた時のように、そこに住む人はなく、そこに宿る人もなくなる。"},{"ref":"Jer.49.19","start":24049019,"end":24049019,"break":"none","ruby":[[0,1,"み"],[11,2,"みつりん"],[15,1,"のぼ"],[26,1,"ひつじ"],[31,1,"おそ"],[46,1,"かれ"],[53,1,"に"],[55,1,"はし"],[63,1,"えら"],[65,1,"もの"],[69,1,"うえ"],[71,1,"た"],[85,1,"もの"],[102,1,"よ"],[118,2,"ぼくしゃ"],[125,1,"まえ"],[127,1,"た"]],"text":"見よ、ししがヨルダンの密林から上ってきて、じょうぶな羊のおりを襲うように、わたしは、たちまち彼らをそこから逃げ走らせ、わたしの選ぶ者をその上に立てる。だれかわたしのような者があるであろうか。だれがわたしを呼びつけることができようか。どの牧者がわたしの前に立つことができようか。"},{"ref":"Jer.49.20","start":24049020,"end":24049020,"break":"none","ruby":[[9,1,"たい"],[12,1,"しゅ"],[14,1,"た"],[17,1,"はか"],[27,1,"す"],[29,1,"もの"],[31,1,"たい"],[40,1,"こと"],[42,1,"き"],[48,1,"かれ"],[51,1,"む"],[57,1,"ちい"],[65,1,"みな"],[67,1,"ひ"],[71,1,"い"],[74,1,"かれ"],[85,1,"おわ"],[88,1,"み"],[90,1,"おそ"]],"text":"それゆえ、エドムに対して主が立てた計りごとと、テマンに住む者に対してしようとする事を聞くがよい。彼らの群れのうちの小さいものまでも皆、引かれて行く。彼らのおりのものもその終りを見て恐れる。"},{"ref":"Jer.49.21","start":24049021,"end":24049021,"break":"none","ruby":[[2,1,"たお"],[5,1,"おと"],[7,1,"き"],[11,1,"ち"],[13,1,"ふる"],[16,1,"かれ"],[19,1,"さけ"],[21,1,"ごえ"],[23,2,"こうかい"],[27,1,"きこ"]],"text":"その倒れる音を聞いて、地は震い、彼らの叫び声は紅海にも聞える。"},{"ref":"Jer.49.22","start":24049022,"end":24049022,"break":"none","ruby":[[0,1,"み"],[3,1,"てき"],[11,1,"のぼ"],[19,1,"と"],[27,1,"つばさ"],[33,1,"うえ"],[35,1,"は"],[37,1,"ひろ"],[43,1,"ひ"],[48,2,"ゆうし"],[51,1,"こころ"],[53,1,"こ"],[55,1,"う"],[57,1,"おんな"],[59,1,"こころ"]],"text":"見よ、敵はわしのように上り、すみやかに飛びかけり、その翼をボズラの上に張り広げる。その日エドムの勇士の心は子を産む女の心のようになる」。"},{"ref":"Jer.49.23","start":24049023,"end":24049023,"break":"paragraph","breaks":[[11,"line"],[30,"line"],[47,"line"],[56,"line"]],"ruby":[[5,1,"こと"],[30,1,"かれ"],[33,1,"わる"],[40,1,"き"],[47,1,"かれ"],[50,2,"ゆうき"],[53,1,"うしな"],[56,1,"おだ"],[69,1,"うみ"],[74,1,"なや"]],"text":"ダマスコの事について、「ハマテとアルパデは、うろたえている、彼らは悪いおとずれを聞いたからだ。彼らは勇気を失い、穏やかになることのできない海のように悩む。"},{"ref":"Jer.49.24","start":24049024,"end":24049024,"break":"line","breaks":[[19,"line"],[29,"line"]],"ruby":[[5,1,"よわ"],[8,1,"み"],[15,1,"に"],[19,2,"きょうふ"],[22,1,"おそ"],[29,1,"こ"],[31,1,"う"],[33,1,"おんな"],[35,1,"のぞ"],[40,1,"いた"],[43,1,"かな"],[47,1,"かれ"],[49,1,"のぞ"]],"text":"ダマスコは弱り、身をめぐらして逃げた、恐怖に襲われている。子を産む女に臨むように痛みと悲しみと彼に臨む。"},{"ref":"Jer.49.25","start":24049025,"end":24049025,"break":"line","ruby":[[3,1,"な"],[6,1,"まち"],[8,1,"たの"],[11,1,"まち"],[13,1,"す"]],"text":"ああ、名ある町、楽しい町は捨てられる。"},{"ref":"Jer.49.26","start":24049026,"end":24049026,"break":"line","breaks":[[21,"line"],[35,"line"]],"ruby":[[7,1,"ひ"],[10,1,"わか"],[12,1,"もの"],[15,2,"ひろば"],[18,1,"たお"],[21,2,"へいし"],[29,1,"ほろ"],[35,2,"ばんぐん"],[38,1,"しゅ"],[40,1,"い"]],"text":"それゆえ、その日に、若い者は、広場に倒れ、兵士はことごとく滅ぼされると万軍の主は言われる。"},{"ref":"Jer.49.27","start":24049027,"end":24049027,"break":"line","breaks":[[20,"line"]],"ruby":[[9,2,"じょうへき"],[12,1,"うえ"],[14,1,"ひ"],[16,1,"も"],[26,2,"きゅうでん"],[29,1,"や"],[31,1,"つく"]],"text":"わたしはダマスコの城壁の上に火を燃やし、ベネハダデの宮殿を焼き尽す」。"},{"ref":"Jer.49.28","start":24049028,"end":24049028,"break":"paragraph","breaks":[[36,"stanza"],[61,"line"]],"ruby":[[5,1,"おう"],[14,1,"せ"],[16,1,"う"],[27,2,"しょこく"],[30,1,"こと"],[36,1,"しゅ"],[40,1,"い"],[46,1,"た"],[54,1,"む"],[58,1,"すす"],[61,1,"ひがし"],[63,2,"ひとびと"],[66,1,"ほろ"]],"text":"バビロンの王ネブカデレザルが攻め撃ったケダルとハゾルの諸国の事について、主はこう言われる、「立って、ケダルに向かって進み、東の人々を滅ぼせ。"},{"ref":"Jer.49.29","start":24049029,"end":24049029,"break":"line","breaks":[[19,"line"],[34,"line"],[51,"line"],[64,"line"]],"ruby":[[0,1,"かれ"],[3,2,"てんまく"],[9,1,"ひつじ"],[11,1,"む"],[15,1,"と"],[21,2,"たれまく"],[31,1,"うつわ"],[39,1,"かれ"],[42,1,"ところ"],[45,1,"はこ"],[47,1,"さ"],[51,2,"ひとびと"],[54,1,"かれ"],[57,1,"む"],[61,1,"さけ"],[65,1,"おそ"],[72,2,"しほう"]],"text":"彼らの天幕と、その羊の群れとは取られ、その垂幕とそのもろもろの器と、らくだとは彼らの所から運び去られ、人々は彼らに向かって叫ぶ、『恐ろしいことが四方にある』と。"},{"ref":"Jer.49.30","start":24049030,"end":24049030,"break":"line","breaks":[[16,"line"],[37,"line"],[51,"line"],[70,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"す"],[13,1,"もの"],[16,1,"に"],[20,1,"とお"],[26,1,"い"],[29,1,"ふか"],[31,1,"ところ"],[33,1,"かく"],[42,1,"おう"],[57,1,"せ"],[60,1,"はか"],[76,1,"せ"],[84,1,"もう"]],"text":"主は言われる、ハゾルに住む者よ、逃げよ、遠くさまよい行き、深い所に隠れよ。バビロンの王ネブカデレザルがあなたがたを攻める計りごとをめぐらし、あなたがたを攻める、てだてを設けたからだ。"},{"ref":"Jer.49.31","start":24049031,"end":24049031,"break":"stanza","breaks":[[7,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"た"],[10,1,"すす"],[13,2,"あんぜん"],[16,1,"ところ"],[18,1,"す"],[24,1,"たみ"],[26,1,"せ"],[30,1,"かれ"],[33,1,"もん"],[38,1,"かん"],[40,1,"き"],[48,1,"はな"],[51,1,"す"]],"text":"主は言われる、立って進み、安全な所に住むきらくな民を攻めよ、彼らは門もなく、貫の木もなく、ひとり離れて住む。"},{"ref":"Jer.49.32","start":24049032,"end":24049032,"break":"line","breaks":[[17,"line"],[28,"line"],[48,"line"],[55,"line"]],"ruby":[[0,1,"かれ"],[12,1,"もの"],[17,2,"かちく"],[20,1,"む"],[23,1,"うば"],[35,1,"かみ"],[37,1,"け"],[44,1,"き"],[46,1,"もの"],[48,2,"しほう"],[51,1,"ち"],[57,2,"さいなん"],[60,2,"はっぽう"],[69,1,"しゅ"],[71,1,"い"]],"text":"彼らのらくだは、ぶんどり物となり、家畜の群れは奪われる。わたしは、かの髪の毛のすみずみを切る者を四方に散らし、その災難を八方からこさせると主は言われる。"},{"ref":"Jer.49.33","start":24049033,"end":24049033,"break":"line","breaks":[[14,"line"],[29,"line"],[42,"line"]],"ruby":[[4,2,"やまいぬ"],[19,1,"あ"],[21,1,"ち"],[35,1,"す"],[37,1,"ひと"],[45,1,"やど"],[47,1,"ひと"]],"text":"ハゾルは山犬のすまいとなり、いつまでも荒れ地となっている。だれもそこに住む人はなく、そこに宿る人もない」。"},{"ref":"Jer.49.34","start":24049034,"end":24049034,"break":"paragraph","ruby":[[3,1,"おう"],[9,2,"ちせい"],[12,1,"はじ"],[23,1,"こと"],[28,3,"よげんしゃ"],[36,1,"のぞ"],[39,1,"しゅ"],[41,2,"ことば"]],"text":"ユダの王ゼデキヤの治世の初めのころに、エラムの事について預言者エレミヤに臨んだ主の言葉。"},{"ref":"Jer.49.35","start":24049035,"end":24049035,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"い"],[13,1,"み"],[24,1,"ちから"],[28,1,"たよ"],[33,1,"ゆみ"],[35,1,"お"]],"text":"万軍の主はこう言われる、「見よ、わたしはエラムが力として頼んでいる弓を折る。"},{"ref":"Jer.49.36","start":24049036,"end":24049036,"break":"none","ruby":[[4,1,"てん"],[6,2,"しほう"],[11,2,"しほう"],[14,1,"かぜ"],[24,1,"かれ"],[27,2,"しほう"],[30,1,"かぜ"],[32,1,"ち"],[41,1,"お"],[43,1,"だ"],[47,1,"もの"],[49,1,"い"],[53,1,"くに"]],"text":"わたしは天の四方から、四方の風をエラムにこさせ、彼らを四方の風に散らす。エラムから追い出される者の行かない国はない。"},{"ref":"Jer.49.37","start":24049037,"end":24049037,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[19,1,"てき"],[21,1,"まえ"],[27,1,"いのち"],[29,1,"もと"],[32,1,"もの"],[34,1,"まえ"],[36,1,"おそ"],[46,1,"わざわい"],[52,1,"はげ"],[55,1,"いか"],[60,1,"うえ"],[66,1,"かれ"],[78,1,"おく"],[81,1,"ほろ"],[84,1,"つく"]],"text":"主は言われる、わたしはエラムをしてその敵の前、またその命を求める者の前に恐れさせる。わたしは災をくだし、激しい怒りをその上にくだす。彼らのうしろに、つるぎを送って滅ぼし尽す。"},{"ref":"Jer.49.38","start":24049038,"end":24049038,"break":"none","ruby":[[7,1,"くらい"],[16,1,"おう"],[25,1,"ほろ"],[29,1,"しゅ"],[31,1,"い"]],"text":"そしてわたしの位をエラムにすえ、王とつかさたちとを滅ぼすと主は言われる。"},{"ref":"Jer.49.39","start":24049039,"end":24049039,"break":"paragraph","ruby":[[3,1,"すえ"],[5,1,"ひ"],[16,1,"ふたた"],[18,1,"さか"],[25,1,"しゅ"],[27,1,"い"]],"text":"しかし末の日に、わたしはエラムを再び栄えさせると、主は言われる」。"}]