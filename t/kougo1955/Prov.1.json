[{"ref":"Prov.1.1","start":20001001,"end":20001001,"break":"paragraph","ruby":[[4,1,"こ"],[12,1,"おう"],[18,2,"しんげん"]],"text":"ダビデの子、イスラエルの王ソロモンの箴言。"},{"ref":"Prov.1.2","start":20001002,"end":20001002,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"ひと"],[5,2,"ちえ"],[8,2,"きょうくん"],[12,1,"し"],[16,1,"さと"],[19,2,"ことば"]],"text":"これは人に知恵と教訓とを知らせ、悟りの言葉をさとらせ、"},{"ref":"Prov.1.3","start":20001003,"end":20001003,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かしこ"],[2,1,"おこな"],[6,2,"せいぎ"],[9,2,"こうせい"],[12,2,"こうへい"],[15,2,"きょうくん"]],"text":"賢い行いと、正義と公正と公平の教訓をうけさせ、"},{"ref":"Prov.1.4","start":20001004,"end":20001004,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"しりょ"],[5,1,"もの"],[7,1,"さと"],[10,1,"あた"],[13,1,"わか"],[15,1,"もの"],[17,2,"ちしき"],[20,1,"つつし"],[23,1,"え"]],"text":"思慮のない者に悟りを与え、若い者に知識と慎みを得させるためである。"},{"ref":"Prov.1.5","start":20001005,"end":20001005,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かしこ"],[2,1,"もの"],[7,1,"き"],[10,1,"がく"],[12,1,"すす"],[18,1,"もの"],[20,2,"しどう"],[23,1,"え"]],"text":"賢い者はこれを聞いて学に進み、さとい者は指導を得る。"},{"ref":"Prov.1.6","start":20001006,"end":20001006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ひと"],[8,2,"しんげん"],[17,1,"かしこ"],[19,1,"もの"],[21,2,"ことば"],[31,1,"さと"]],"text":"人はこれによって箴言と、たとえと、賢い者の言葉と、そのなぞとを悟る。"},{"ref":"Prov.1.7","start":20001007,"end":20001007,"break":"stanza","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[8,2,"ちしき"],[18,1,"おろ"],[21,1,"もの"],[23,2,"ちえ"],[26,2,"きょうくん"],[29,1,"かろ"]],"text":"主を恐れることは知識のはじめである、愚かな者は知恵と教訓を軽んじる。"},{"ref":"Prov.1.8","start":20001008,"end":20001008,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"こ"],[9,1,"ちち"],[11,2,"きょうくん"],[14,1,"き"],[17,1,"はは"],[19,1,"おしえ"],[21,1,"す"]],"text":"わが子よ、あなたは父の教訓を聞き、母の教を捨ててはならない。"},{"ref":"Prov.1.9","start":20001009,"end":20001009,"break":"line","breaks":[[19,"line"]],"ruby":[[9,1,"あたま"],[11,1,"うるわ"],[14,1,"かんむり"],[23,1,"くび"],[25,1,"かざ"]],"text":"それらは、あなたの頭の麗しい冠となり、あなたの首の飾りとなるからである。"},{"ref":"Prov.1.10","start":20001010,"end":20001010,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"こ"],[5,2,"わるもの"],[12,1,"さそ"],[20,1,"したが"]],"text":"わが子よ、悪者があなたを誘っても、それに従ってはならない。"},{"ref":"Prov.1.11","start":20001011,"end":20001011,"break":"line","breaks":[[21,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[7,1,"む"],[13,2,"いっしょ"],[16,1,"き"],[26,1,"ま"],[28,1,"ぶ"],[33,1,"ひと"],[35,1,"ち"],[37,1,"なが"],[40,1,"つみ"],[44,1,"もの"],[51,1,"ふ"]],"text":"彼らがあなたに向かって、「一緒に来なさい。われわれは待ち伏せして、人の血を流し、罪のない者を、ゆえなく伏してねらい、"},{"ref":"Prov.1.12","start":20001012,"end":20001012,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"よみ"],[7,1,"かれ"],[10,1,"い"],[19,1,"つく"],[22,1,"すこ"],[26,1,"もの"],[29,1,"はか"],[31,1,"くだ"],[33,1,"もの"]],"text":"陰府のように、彼らを生きたままで、のみ尽し、健やかな者を、墓に下る者のようにしよう。"},{"ref":"Prov.1.13","start":20001013,"end":20001013,"break":"line","breaks":[[18,"line"]],"ruby":[[11,1,"たっと"],[13,1,"か"],[14,1,"ざい"],[16,1,"え"],[18,1,"うば"],[20,1,"と"],[23,1,"もの"],[31,1,"いえ"],[33,1,"み"]],"text":"われわれは、さまざまの尊い貨財を得、奪い取った物で、われわれの家を満たそう。"},{"ref":"Prov.1.14","start":20001014,"end":20001014,"break":"line","breaks":[[19,"line"]],"ruby":[[9,2,"なかま"],[12,1,"くわ"],[24,1,"とも"],[29,1,"かね"],[30,1,"ぶくろ"],[32,1,"も"],[37,1,"い"]],"text":"あなたもわれわれの仲間に加わりなさい、われわれは共に一つの金袋を持とう」と言っても、"},{"ref":"Prov.1.15","start":20001015,"end":20001015,"break":"line","breaks":[[20,"line"]],"ruby":[[2,1,"こ"],[5,1,"かれ"],[8,2,"なかま"],[24,1,"あし"],[31,1,"かれ"],[34,1,"みち"],[36,1,"い"]],"text":"わが子よ、彼らの仲間になってはならない、あなたの足をとどめて、彼らの道に行ってはならない。"},{"ref":"Prov.1.16","start":20001016,"end":20001016,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あし"],[5,1,"あく"],[7,1,"はし"],[10,1,"ち"],[12,1,"なが"],[17,1,"はや"]],"text":"彼らの足は悪に走り、血を流すことに速いからだ。"},{"ref":"Prov.1.17","start":20001017,"end":20001017,"break":"line","breaks":[[9,"line"]],"ruby":[[3,1,"とり"],[5,1,"め"],[7,1,"まえ"],[9,1,"あみ"],[11,1,"は"]],"text":"すべて鳥の目の前で網を張るのは、むだである。"},{"ref":"Prov.1.18","start":20001018,"end":20001018,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[3,2,"じぶん"],[6,1,"ち"],[8,1,"ま"],[10,1,"ぶ"],[14,2,"じぶん"],[17,1,"いのち"],[19,1,"ふ"]],"text":"彼らは自分の血を待ち伏せし、自分の命を伏してねらうのだ。"},{"ref":"Prov.1.19","start":20001019,"end":20001019,"break":"line","breaks":[[24,"line"]],"ruby":[[3,1,"り"],[9,1,"もの"],[11,1,"みち"],[29,1,"も"],[31,1,"ぬし"],[33,1,"いのち"],[35,1,"と"],[37,1,"さ"]],"text":"すべて利をむさぼる者の道はこのようなものである。これはその持ち主の命を取り去るのだ。"},{"ref":"Prov.1.20","start":20001020,"end":20001020,"break":"stanza","breaks":[[13,"line"]],"ruby":[[0,2,"ちえ"],[8,1,"よ"],[13,2,"しじょう"],[18,1,"こえ"]],"text":"知恵は、ちまたに呼ばわり、市場にその声をあげ、"},{"ref":"Prov.1.21","start":20001021,"end":20001021,"break":"line","ruby":[[0,2,"じょうへき"],[3,1,"いただき"],[5,1,"さけ"],[8,1,"まち"],[10,1,"もん"],[12,2,"いりぐち"],[15,1,"かた"]],"text":"城壁の頂で叫び、町の門の入口で語る。"},{"ref":"Prov.1.22","start":20001022,"end":20001022,"break":"line","breaks":[[35,"line"],[55,"line"]],"ruby":[[1,2,"しりょ"],[6,1,"もの"],[22,2,"しりょ"],[30,1,"この"],[39,1,"もの"],[51,1,"たの"],[55,1,"おろ"],[58,1,"もの"],[66,2,"ちしき"],[69,1,"にく"]],"text":"「思慮のない者たちよ、あなたがたは、いつまで思慮のないことを好むのか。あざける者は、いつまで、あざけり楽しみ、愚かな者は、いつまで、知識を憎むのか。"},{"ref":"Prov.1.23","start":20001023,"end":20001023,"break":"line","breaks":[[13,"line"],[36,"line"]],"ruby":[[4,1,"いまし"],[7,1,"こころ"],[13,1,"み"],[20,2,"じぶん"],[23,1,"おも"],[33,1,"つ"],[40,2,"ことば"],[50,1,"し"]],"text":"わたしの戒めに心をとめよ、見よ、わたしは自分の思いを、あなたがたに告げ、わたしの言葉を、あなたがたに知らせる。"},{"ref":"Prov.1.24","start":20001024,"end":20001024,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"よ"],[15,1,"き"],[20,1,"こば"],[23,1,"て"],[25,1,"の"],[30,1,"かえり"],[33,1,"もの"]],"text":"わたしは呼んだが、あなたがたは聞くことを拒み、手を伸べたが、顧みる者はなく、"},{"ref":"Prov.1.25","start":20001025,"end":20001025,"break":"line","breaks":[[25,"line"]],"ruby":[[19,1,"すす"],[22,1,"す"],[29,1,"いまし"],[32,1,"う"]],"text":"かえって、あなたがたはわたしのすべての勧めを捨て、わたしの戒めを受けなかったので、"},{"ref":"Prov.1.26","start":20001026,"end":20001026,"break":"line","breaks":[[23,"line"]],"ruby":[[13,1,"わざわい"],[17,1,"とき"],[20,1,"わら"],[29,2,"きょうこう"],[34,1,"とき"]],"text":"わたしもまた、あなたがたが災にあう時に、笑い、あなたがたが恐慌にあう時、あざけるであろう。"},{"ref":"Prov.1.27","start":20001027,"end":20001027,"break":"line","breaks":[[23,"line"],[37,"line"]],"ruby":[[3,2,"きょうこう"],[20,1,"のぞ"],[23,1,"わざわい"],[29,1,"かぜ"],[34,1,"のぞ"],[37,1,"なや"],[40,1,"かな"],[52,1,"のぞ"],[54,1,"とき"]],"text":"これは恐慌が、あらしのようにあなたがたに臨み、災が、つむじ風のように臨み、悩みと悲しみとが、あなたがたに臨む時である。"},{"ref":"Prov.1.28","start":20001028,"end":20001028,"break":"line","breaks":[[18,"line"],[31,"line"],[48,"line"]],"ruby":[[2,1,"とき"],[4,1,"かれ"],[11,1,"よ"],[26,1,"こた"],[40,1,"もと"],[56,1,"あ"]],"text":"その時、彼らはわたしを呼ぶであろう、しかし、わたしは答えない。ひたすら、わたしを求めるであろう、しかし、わたしに会えない。"},{"ref":"Prov.1.29","start":20001029,"end":20001029,"break":"line","ruby":[[0,1,"かれ"],[3,2,"ちしき"],[6,1,"にく"],[9,1,"しゅ"],[11,1,"おそ"],[17,1,"えら"]],"text":"彼らは知識を憎み、主を恐れることを選ばず、"},{"ref":"Prov.1.30","start":20001030,"end":20001030,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"すす"],[7,1,"したが"],[15,1,"いまし"],[18,1,"かろ"]],"text":"わたしの勧めに従わず、すべての戒めを軽んじたゆえ、"},{"ref":"Prov.1.31","start":20001031,"end":20001031,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"じぶん"],[3,1,"おこな"],[6,1,"み"],[8,1,"く"],[12,2,"じぶん"],[15,1,"はか"],[20,1,"あ"]],"text":"自分の行いの実を食らい、自分の計りごとに飽きる。"},{"ref":"Prov.1.32","start":20001032,"end":20001032,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"しりょ"],[5,1,"もの"],[7,1,"ふ"],[8,2,"じゅうじゅん"],[15,1,"ころ"],[18,1,"おろ"],[21,1,"もの"],[23,2,"あんらく"],[30,1,"ほろ"]],"text":"思慮のない者の不従順はおのれを殺し、愚かな者の安楽はおのれを滅ぼす。"},{"ref":"Prov.1.33","start":20001033,"end":20001033,"break":"line","breaks":[[22,"line"]],"ruby":[[8,1,"き"],[10,1,"したが"],[12,1,"もの"],[14,1,"やす"],[18,1,"す"],[22,1,"わざわい"],[24,1,"あ"],[26,1,"おそ"],[32,2,"あんぜん"]],"text":"しかし、わたしに聞き従う者は安らかに住まい、災に会う恐れもなく、安全である」。"}]