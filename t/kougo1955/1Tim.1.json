[{"ref":"1Tim.1.1","start":54001001,"end":54001001,"break":"paragraph","ruby":[[6,2,"すくいぬし"],[10,1,"かみ"],[19,1,"のぞ"],[34,2,"にんめい"],[48,2,"しと"]],"text":"わたしたちの救主なる神と、わたしたちの望みであるキリスト・イエスとの任命によるキリスト・イエスの使徒パウロから、"},{"ref":"1Tim.1.2","start":54001002,"end":54001002,"break":"none","breaks":[[18,"paragraph"]],"ruby":[[0,2,"しんこう"],[9,2,"しんじつ"],[12,1,"こ"],[18,1,"ちち"],[21,1,"かみ"],[29,1,"しゅ"],[41,1,"めぐ"],[49,2,"へいあん"]],"text":"信仰によるわたしの真実な子テモテへ。父なる神とわたしたちの主キリスト・イエスから、恵みとあわれみと平安とが、あなたにあるように。"},{"ref":"1Tim.1.3","start":54001003,"end":54001003,"break":"paragraph","ruby":[[10,1,"む"],[14,2,"しゅっぱつ"],[18,1,"さい"],[20,1,"たの"],[48,2,"ひとびと"],[52,1,"ちが"],[55,1,"おしえ"],[57,1,"と"]],"text":"わたしがマケドニヤに向かって出発する際、頼んでおいたように、あなたはエペソにとどまっていて、ある人々に、違った教を説くことをせず、"},{"ref":"1Tim.1.4","start":54001004,"end":54001004,"break":"none","ruby":[[0,1,"つく"],[2,1,"ばなし"],[10,2,"けいず"],[15,1,"き"],[30,1,"めい"],[44,2,"しんこう"],[49,1,"かみ"],[51,1,"つとめ"],[53,1,"はた"],[65,2,"ろんぎ"],[68,1,"ひ"],[70,1,"おこ"]],"text":"作り話やはてしのない系図などに気をとられることもないように、命じなさい。そのようなことは信仰による神の務を果すものではなく、むしろ論議を引き起させるだけのものである。"},{"ref":"1Tim.1.5","start":54001005,"end":54001005,"break":"none","ruby":[[6,2,"めいれい"],[10,1,"きよ"],[12,1,"こころ"],[14,1,"ただ"],[17,2,"りょうしん"],[20,1,"いつわ"],[25,2,"しんこう"],[30,1,"で"],[34,1,"あい"],[36,2,"もくひょう"]],"text":"わたしのこの命令は、清い心と正しい良心と偽りのない信仰とから出てくる愛を目標としている。"},{"ref":"1Tim.1.6","start":54001006,"end":54001006,"break":"none","ruby":[[2,2,"ひとびと"],[16,2,"くうろん"],[19,1,"はし"]],"text":"ある人々はこれらのものからそれて空論に走り、"},{"ref":"1Tim.1.7","start":54001007,"end":54001007,"break":"none","ruby":[[0,2,"りっぽう"],[3,2,"きょうし"],[10,1,"こころざ"],[18,2,"じぶん"],[21,1,"い"],[29,2,"しゅちょう"]],"text":"律法の教師たることを志していながら、自分の言っていることも主張していることも、わからないでいる。"},{"ref":"1Tim.1.8","start":54001008,"end":54001008,"break":"none","ruby":[[6,1,"し"],[15,2,"りっぽう"],[23,1,"ほう"],[25,1,"したが"],[28,1,"もち"],[34,1,"よ"]],"text":"わたしたちが知っているとおり、律法なるものは、法に従って用いるなら、良いものである。"},{"ref":"1Tim.1.9","start":54001009,"end":54001009,"break":"none","ruby":[[5,2,"りっぽう"],[8,1,"ただ"],[11,1,"ひと"],[16,1,"さだ"],[27,2,"ふほう"],[30,1,"もの"],[32,1,"ほう"],[34,1,"ふく"],[38,1,"もの"],[40,3,"ふしんじん"],[44,1,"もの"],[46,1,"つみ"],[49,1,"もの"],[51,2,"しんせい"],[54,1,"けが"],[56,1,"もの"],[58,2,"ぞくあく"],[61,1,"もの"],[63,1,"ちち"],[65,1,"ころ"],[67,1,"もの"],[69,1,"はは"],[71,1,"ころ"],[73,1,"もの"],[75,1,"ひと"],[77,1,"ころ"],[79,1,"もの"]],"text":"すなわち、律法は正しい人のために定められたのではなく、不法な者と法に服さない者、不信心な者と罪ある者、神聖を汚す者と俗悪な者、父を殺す者と母を殺す者、人を殺す者、"},{"ref":"1Tim.1.10","start":54001010,"end":54001010,"break":"none","ruby":[[0,3,"ふひんこう"],[4,1,"もの"],[6,2,"なんしょく"],[11,1,"もの"],[13,1,"ゆう"],[18,1,"もの"],[20,1,"いつわ"],[22,1,"もの"],[24,1,"いつわ"],[26,1,"ちか"],[28,1,"もの"],[34,2,"けんぜん"],[37,1,"おしえ"],[54,1,"さだ"],[64,1,"みと"]],"text":"不品行な者、男色をする者、誘かいする者、偽る者、偽り誓う者、そのほか健全な教にもとることがあれば、そのために定められていることを認むべきである。"},{"ref":"1Tim.1.11","start":54001011,"end":54001011,"break":"none","ruby":[[4,2,"しゅくふく"],[7,1,"み"],[10,1,"かみ"],[12,2,"えいこう"],[15,2,"ふくいん"],[18,1,"しめ"],[34,2,"ふくいん"]],"text":"これは、祝福に満ちた神の栄光の福音が示すところであって、わたしはこの福音をゆだねられているのである。"},{"ref":"1Tim.1.12","start":54001012,"end":54001012,"break":"paragraph","ruby":[[5,2,"じぶん"],[8,1,"つよ"],[12,1,"くだ"],[22,1,"しゅ"],[32,2,"かんしゃ"],[37,1,"しゅ"],[43,2,"ちゅうじつ"],[46,1,"もの"],[48,1,"み"],[53,1,"つとめ"],[55,1,"にん"],[58,1,"くだ"]],"text":"わたしは、自分を強くして下さったわたしたちの主キリスト・イエスに感謝する。主はわたしを忠実な者と見て、この務に任じて下さったのである。"},{"ref":"1Tim.1.13","start":54001013,"end":54001013,"break":"none","ruby":[[4,2,"いぜん"],[9,1,"かみ"],[14,1,"もの"],[16,2,"はくがい"],[20,1,"もの"],[22,2,"ふそん"],[25,1,"もの"],[43,1,"こと"],[46,2,"しんこう"],[56,2,"むち"]],"text":"わたしは以前には、神をそしる者、迫害する者、不遜な者であった。しかしわたしは、これらの事を、信仰がなかったとき、無知なためにしたのだから、あわれみをこうむったのである。"},{"ref":"1Tim.1.14","start":54001014,"end":54001014,"break":"none","ruby":[[2,1,"うえ"],[10,1,"しゅ"],[12,1,"めぐ"],[27,2,"しんこう"],[30,1,"あい"],[33,1,"ともな"],[40,1,"ま"],[42,1,"くわ"]],"text":"その上、わたしたちの主の恵みが、キリスト・イエスにある信仰と愛とに伴い、ますます増し加わってきた。"},{"ref":"1Tim.1.15","start":54001015,"end":54001015,"break":"none","ruby":[[11,2,"つみびと"],[14,1,"すく"],[21,1,"よ"],[25,1,"くだ"],[33,2,"ことば"],[37,2,"かくじつ"],[45,1,"う"],[51,1,"た"],[66,2,"つみびと"]],"text":"「キリスト・イエスは、罪人を救うためにこの世にきて下さった」という言葉は、確実で、そのまま受けいれるに足るものである。わたしは、その罪人のかしらなのである。"},{"ref":"1Tim.1.16","start":54001016,"end":54001016,"break":"none","ruby":[[37,1,"たい"],[40,1,"かぎ"],[44,2,"かんよう"],[47,1,"しめ"],[58,2,"こんご"],[61,1,"かれ"],[63,1,"しん"],[66,2,"えいえん"],[73,1,"う"],[76,1,"もの"],[78,2,"もはん"]],"text":"しかし、わたしがあわれみをこうむったのは、キリスト・イエスが、まずわたしに対して限りない寛容を示し、そして、わたしが今後、彼を信じて永遠のいのちを受ける者の模範となるためである。"},{"ref":"1Tim.1.17","start":54001017,"end":54001017,"break":"none","ruby":[[0,2,"よよ"],[3,3,"しはいしゃ"],[7,2,"ふきゅう"],[12,1,"み"],[16,2,"ゆいいつ"],[19,1,"かみ"],[22,2,"よよ"],[24,1,"かぎ"],[33,2,"えいこう"]],"text":"世々の支配者、不朽にして見えざる唯一の神に、世々限りなく、ほまれと栄光とがあるように、アァメン。"},{"ref":"1Tim.1.18","start":54001018,"end":54001018,"break":"paragraph","ruby":[[4,1,"こ"],[10,2,"いぜん"],[16,1,"たい"],[23,2,"かずかず"],[26,2,"よげん"],[29,2,"ことば"],[32,1,"したが"],[38,2,"めいれい"],[41,1,"あた"],[54,2,"ことば"],[57,1,"はげ"],[63,2,"しんこう"],[66,1,"ただ"],[69,2,"りょうしん"],[73,1,"たも"],[83,1,"たたか"]],"text":"わたしの子テモテよ。以前あなたに対してなされた数々の預言の言葉に従って、この命令を与える。あなたは、これらの言葉に励まされて、信仰と正しい良心とを保ちながら、りっぱに戦いぬきなさい。"},{"ref":"1Tim.1.19","start":54001019,"end":54001019,"break":"none","ruby":[[2,2,"ひとびと"],[6,1,"ただ"],[9,2,"りょうしん"],[12,1,"す"],[18,2,"しんこう"],[21,2,"はせん"],[24,1,"あ"]],"text":"ある人々は、正しい良心を捨てたため、信仰の破船に会った。"},{"ref":"1Tim.1.20","start":54001020,"end":54001020,"break":"none","ruby":[[2,1,"なか"],[27,1,"かみ"],[29,1,"けが"],[36,1,"まな"],[53,1,"て"],[55,1,"わた"]],"text":"その中に、ヒメナオとアレキサンデルとがいる。わたしは、神を汚さないことを学ばせるため、このふたりをサタンの手に渡したのである。"}]