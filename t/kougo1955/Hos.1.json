[{"ref":"Hos.1.1","start":28001001,"end":28001001,"break":"paragraph","ruby":[[4,1,"おう"],[22,1,"よ"],[30,1,"おう"],[35,1,"こ"],[42,1,"よ"],[49,1,"こ"],[54,1,"のぞ"],[57,1,"しゅ"],[59,2,"ことば"]],"text":"ユダヤの王ウジヤ、ヨタム、アハズ、ヒゼキヤの世、イスラエルの王ヨアシの子ヤラベアムの世に、ベエリの子ホセアに臨んだ主の言葉。"},{"ref":"Hos.1.2","start":28001002,"end":28001002,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"さいしょ"],[11,1,"かた"],[15,1,"とき"],[17,1,"しゅ"],[23,1,"い"],[29,1,"い"],[33,2,"いんこう"],[36,1,"つま"],[39,2,"いんこう"],[45,1,"うま"],[48,1,"こ"],[51,1,"う"],[59,1,"くに"],[61,1,"しゅ"],[74,2,"いんこう"]],"text":"主が最初ホセアによって語られた時、主はホセアに言われた、「行って、淫行の妻と、淫行によって生れた子らを受けいれよ。この国は主にそむいて、はなはだしい淫行をなしているからである」。"},{"ref":"Hos.1.3","start":28001003,"end":28001003,"break":"none","ruby":[[3,1,"かれ"],[5,1,"い"],[14,1,"むすめ"],[24,2,"かのじょ"],[32,1,"おとこ"],[34,1,"こ"],[36,1,"う"]],"text":"そこで彼は行ってデブライムの娘ゴメルをめとった。彼女はみごもって男の子を産んだ。"},{"ref":"Hos.1.4","start":28001004,"end":28001004,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"かれ"],[6,1,"い"],[18,1,"こ"],[20,1,"な"],[27,1,"な"],[47,1,"ち"],[56,1,"いえ"],[58,1,"ばっ"],[67,1,"いえ"],[69,1,"くに"],[71,1,"ほろ"]],"text":"主はまた彼に言われた、「あなたはその子の名をエズレルと名づけよ。しばらくしてわたしはエズレルの血のためにエヒウの家を罰し、イスラエルの家の国を滅ぼすからである。"},{"ref":"Hos.1.5","start":28001005,"end":28001005,"break":"none","ruby":[[2,1,"ひ"],[13,1,"たに"],[21,1,"ゆみ"],[23,1,"お"]],"text":"その日、わたしはエズレルの谷でイスラエルの弓を折る」と。"},{"ref":"Hos.1.6","start":28001006,"end":28001006,"break":"paragraph","ruby":[[11,1,"おんな"],[13,1,"こ"],[15,1,"う"],[19,1,"しゅ"],[25,1,"い"],[37,1,"な"],[44,1,"な"],[62,1,"いえ"],[70,1,"けっ"]],"text":"ゴメルはまたみごもって女の子を産んだ。主はホセアに言われた、「あなたはその名をロルハマと名づけよ。わたしはもはやイスラエルの家をあわれまず、決してこれをゆるさないからである。"},{"ref":"Hos.1.7","start":28001007,"end":28001007,"break":"none","ruby":[[11,1,"いえ"],[20,1,"かみ"],[22,1,"しゅ"],[30,1,"すく"],[37,1,"ゆみ"],[43,2,"せんそう"],[46,1,"うま"],[50,2,"きへい"],[56,1,"すく"]],"text":"しかし、わたしはユダの家をあわれみ、その神、主によってこれを救う。わたしは弓、つるぎ、戦争、馬および騎兵によって救うのではない」と。"},{"ref":"Hos.1.8","start":28001008,"end":28001008,"break":"paragraph","ruby":[[9,2,"ちばな"],[25,1,"おとこ"],[27,1,"こ"],[29,1,"う"]],"text":"ゴメルはロルハマを乳離れさせたとき、またみごもって男の子を産んだ。"},{"ref":"Hos.1.9","start":28001009,"end":28001009,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[10,1,"こ"],[12,1,"な"],[19,1,"な"],[35,1,"たみ"],[52,1,"かみ"]],"text":"主は言われた、「その子の名をロアンミと名づけよ。あなたがたは、わたしの民ではなく、わたしは、あなたがたの神ではないからである」。"},{"ref":"Hos.1.10","start":28001010,"end":28001010,"break":"paragraph","ruby":[[9,2,"ひとびと"],[12,1,"かず"],[14,1,"うみ"],[16,1,"すな"],[21,1,"はか"],[27,1,"かぞ"],[47,1,"かれ"],[62,1,"たみ"],[69,1,"い"],[75,1,"ところ"],[85,1,"い"],[88,1,"かみ"],[90,1,"こ"],[96,1,"い"]],"text":"しかしイスラエルの人々の数は海の砂のように量ることも、数えることもできないほどになって、さきに彼らが「あなたがたは、わたしの民ではない」と言われたその所で、「あなたがたは生ける神の子である」と言われるようになる。"},{"ref":"Hos.1.11","start":28001011,"end":28001011,"break":"none","ruby":[[6,2,"ひとびと"],[15,2,"ひとびと"],[18,1,"とも"],[20,1,"あつ"],[28,1,"ちょう"],[30,1,"た"],[36,1,"ち"],[43,1,"く"],[51,1,"ひ"],[53,1,"おお"]],"text":"そしてユダの人々とイスラエルの人々は共に集まり、ひとりの長を立てて、その地からのぼって来る。エズレルの日は大いなるものとなる。"}]