[{"ref":"Rev.15.1","start":66015001,"end":66015001,"break":"paragraph","ruby":[[7,1,"てん"],[9,1,"おお"],[13,1,"おどろ"],[24,1,"み"],[28,1,"にん"],[30,2,"みつかい"],[34,2,"さいご"],[40,2,"さいがい"],[43,1,"たずさ"],[53,2,"さいがい"],[56,1,"かみ"],[58,1,"はげ"],[61,1,"いか"],[66,2,"ちょうてん"],[69,1,"たっ"]],"text":"またわたしは、天に大いなる驚くべきほかのしるしを見た。七人の御使が、最後の七つの災害を携えていた。これらの災害で神の激しい怒りがその頂点に達するのである。"},{"ref":"Rev.15.2","start":66015002,"end":66015002,"break":"none","ruby":[[7,1,"ひ"],[17,1,"うみ"],[25,1,"み"],[38,1,"うみ"],[44,1,"けもの"],[48,1,"ぞう"],[52,1,"な"],[54,2,"すうじ"],[60,1,"か"],[63,2,"ひとびと"],[67,1,"かみ"],[69,2,"たてごと"],[72,1,"て"],[76,1,"た"],[83,1,"み"]],"text":"またわたしは、火のまじったガラスの海のようなものを見た。そして、このガラスの海のそばに、獣とその像とその名の数字とにうち勝った人々が、神の立琴を手にして立っているのを見た。"},{"ref":"Rev.15.3","start":66015003,"end":66015003,"break":"none","breaks":[[26,"stanza"],[39,"line"],[48,"line"],[67,"line"],[73,"line"]],"ruby":[[0,1,"かれ"],[4,1,"かみ"],[6,1,"しもべ"],[11,1,"うた"],[13,2,"こひつじ"],[16,1,"うた"],[19,1,"うた"],[22,1,"い"],[27,3,"ぜんのうしゃ"],[33,1,"しゅ"],[36,1,"かみ"],[48,1,"おお"],[55,1,"おどろ"],[67,2,"ばんみん"],[70,1,"おう"],[77,1,"みち"],[79,1,"ただ"],[85,2,"しんじつ"]],"text":"彼らは、神の僕モーセの歌と小羊の歌とを歌って言った、「全能者にして主なる神よ。あなたのみわざは、大いなる、また驚くべきものであります。万民の王よ、あなたの道は正しく、かつ真実であります。"},{"ref":"Rev.15.4","start":66015004,"end":66015004,"break":"line","breaks":[[12,"line"],[33,"line"],[48,"line"],[71,"line"],[83,"line"]],"ruby":[[0,1,"しゅ"],[12,2,"みな"],[22,1,"もの"],[39,1,"せい"],[52,2,"こくみん"],[62,1,"ふ"],[64,1,"おが"],[75,1,"ただ"],[89,1,"いた"]],"text":"主よ、あなたをおそれず、御名をほめたたえない者が、ありましょうか。あなただけが聖なるかたであり、あらゆる国民はきて、あなたを伏し拝むでしょう。あなたの正しいさばきが、あらわれるに至ったからであります」。"},{"ref":"Rev.15.5","start":66015005,"end":66015005,"break":"paragraph","ruby":[[2,1,"のち"],[8,1,"み"],[14,1,"てん"],[23,2,"まくや"],[26,2,"せいじょ"],[29,1,"ひら"]],"text":"その後、わたしが見ていると、天にある、あかしの幕屋の聖所が開かれ、"},{"ref":"Rev.15.6","start":66015006,"end":66015006,"break":"none","ruby":[[2,2,"せいじょ"],[10,2,"さいがい"],[13,1,"たずさ"],[19,1,"にん"],[21,2,"みつかい"],[25,1,"けが"],[31,1,"ひか"],[33,1,"かがや"],[35,3,"あまぬの"],[39,1,"み"],[45,1,"きん"],[47,1,"おび"],[49,1,"むね"],[55,1,"で"]],"text":"その聖所から、七つの災害を携えている七人の御使が、汚れのない、光り輝く亜麻布を身にまとい、金の帯を胸にしめて、出てきた。"},{"ref":"Rev.15.7","start":66015007,"end":66015007,"break":"none","ruby":[[7,1,"い"],[9,1,"もの"],[15,2,"よよ"],[17,1,"かぎ"],[21,1,"い"],[28,1,"かみ"],[30,1,"はげ"],[33,1,"いか"],[36,1,"み"],[42,1,"きん"],[44,1,"はち"],[48,1,"にん"],[50,2,"みつかい"],[53,1,"わた"]],"text":"そして、四つの生き物の一つが、世々限りなく生きておられる神の激しい怒りの満ちた七つの金の鉢を、七人の御使に渡した。"},{"ref":"Rev.15.8","start":66015008,"end":66015008,"break":"none","ruby":[[4,2,"せいじょ"],[7,1,"かみ"],[9,2,"えいこう"],[14,1,"ちから"],[18,1,"た"],[23,1,"けむり"],[25,1,"み"],[31,1,"にん"],[33,2,"みつかい"],[39,2,"さいがい"],[42,1,"おわ"],[55,2,"せいじょ"]],"text":"すると、聖所は神の栄光とその力とから立ちのぼる煙で満たされ、七人の御使の七つの災害が終ってしまうまでは、だれも聖所にはいることができなかった。"}]