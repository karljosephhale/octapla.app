[{"ref":"Ps.79.1","start":19079001,"end":19079001,"break":"paragraph","title":"アサフの歌","breaks":[[24,"line"],[37,"line"]],"ruby":[[0,1,"かみ"],[8,3,"いほうじん"],[16,1,"し"],[17,1,"ぎょう"],[19,1,"ち"],[21,1,"おか"],[28,1,"せい"],[31,1,"みや"],[43,2,"あらつか"]],"titleRuby":[[4,1,"うた"]],"text":"神よ、もろもろの異邦人はあなたの嗣業の地を侵し、あなたの聖なる宮をけがし、エルサレムを荒塚としました。"},{"ref":"Ps.79.2","start":19079002,"end":19079002,"break":"line","breaks":[[16,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[16,1,"そら"],[18,1,"とり"],[20,1,"あた"],[32,2,"せいと"],[35,1,"にく"],[37,1,"ち"],[39,1,"けもの"],[41,1,"あた"]],"text":"彼らはあなたのしもべのしかばねを空の鳥に与えてえさとし、あなたの聖徒の肉を地の獣に与え、"},{"ref":"Ps.79.3","start":19079003,"end":19079003,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"ち"],[14,1,"みず"],[19,1,"なが"],[25,1,"ほうむ"],[27,1,"ひと"]],"text":"その血をエルサレムのまわりに水のように流し、これを葬る人がありませんでした。"},{"ref":"Ps.79.4","start":19079004,"end":19079004,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"とな"],[6,1,"びと"],[17,2,"ひとびと"],[20,1,"あなど"],[30,1,"もの"]],"text":"われらは隣り人にそしられ、まわりの人々に侮られ、あざけられる者となりました。"},{"ref":"Ps.79.5","start":19079005,"end":19079005,"break":"line","breaks":[[13,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[19,1,"いか"],[39,1,"ひ"],[44,1,"も"]],"text":"主よ、いつまでなのですか。とこしえにお怒りになられるのですか。あなたのねたみは火のように燃えるのですか。"},{"ref":"Ps.79.6","start":19079006,"end":19079006,"break":"line","breaks":[[17,"line"],[32,"line"]],"ruby":[[8,1,"し"],[12,3,"いほうじん"],[21,1,"な"],[23,1,"よ"],[27,2,"くにぐに"],[30,1,"うえ"],[36,1,"いか"],[39,1,"そそ"]],"text":"どうか、あなたを知らない異邦人と、あなたの名を呼ばない国々の上にあなたの怒りを注いでください。"},{"ref":"Ps.79.7","start":19079007,"end":19079007,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[7,1,"ほろ"],[17,1,"あら"]],"text":"彼らはヤコブを滅ぼし、そのすみかを荒したからです。"},{"ref":"Ps.79.8","start":19079008,"end":19079008,"break":"line","breaks":[[23,"line"],[41,"line"],[49,"line"]],"ruby":[[4,2,"せんぞ"],[9,2,"ふぎ"],[41,1,"むか"],[60,1,"ひく"]],"text":"われらの先祖たちの不義をみこころにとめられず、あわれみをもって、すみやかにわれらを迎えてください。われらは、はなはだしく低くされたからです。"},{"ref":"Ps.79.9","start":19079009,"end":19079009,"break":"line","breaks":[[9,"line"],[25,"line"],[38,"line"]],"ruby":[[4,1,"すくい"],[6,1,"かみ"],[10,1,"な"],[12,2,"えいこう"],[22,1,"たす"],[26,1,"な"],[35,1,"すく"],[42,1,"つみ"]],"text":"われらの救の神よ、み名の栄光のためにわれらを助け、み名のためにわれらを救い、われらの罪をおゆるしください。"},{"ref":"Ps.79.10","start":19079010,"end":19079010,"break":"line","breaks":[[16,"line"],[32,"line"],[50,"line"],[64,"line"]],"ruby":[[4,3,"いほうじん"],[8,1,"い"],[17,1,"かれ"],[20,1,"かみ"],[41,1,"なが"],[45,1,"ち"],[47,1,"むく"],[64,3,"いほうじん"],[68,1,"し"]],"text":"どうして異邦人は言うのでしょう、「彼らの神はどこにいるのか」と。あなたのしもべらの流された血の報いをわれらのまのあたりになして、異邦人に知らせてください。"},{"ref":"Ps.79.11","start":19079011,"end":19079011,"break":"line","breaks":[[8,"line"],[20,"line"],[33,"line"]],"ruby":[[0,1,"とら"],[3,1,"びと"],[5,1,"なげ"],[13,1,"まえ"],[24,1,"おお"],[28,1,"ちから"],[33,1,"し"],[35,1,"さだ"],[40,1,"もの"],[42,1,"まも"]],"text":"捕われ人の嘆きをあなたのみ前にいたらせ、あなたの大いなる力により、死に定められた者を守りながらえさせてください。"},{"ref":"Ps.79.12","start":19079012,"end":19079012,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"とな"],[9,1,"びと"],[24,1,"ばい"],[28,1,"かれ"],[36,1,"むく"],[38,1,"かえ"]],"text":"主よ、われらの隣り人があなたをそしったそしりを七倍にして彼らのふところに報い返してください。"},{"ref":"Ps.79.13","start":19079013,"end":19079013,"break":"line","breaks":[[21,"line"],[34,"line"]],"ruby":[[10,1,"たみ"],[16,1,"まき"],[18,1,"ひつじ"],[30,2,"かんしゃ"],[34,2,"よよ"]],"text":"そうすれば、あなたの民、あなたの牧の羊は、とこしえにあなたに感謝し、世々あなたをほめたたえるでしょう。"}]