[{"ref":"Rom.6.1","start":45006001,"end":45006001,"break":"paragraph","ruby":[[13,1,"い"],[18,1,"めぐ"],[21,1,"ま"],[23,1,"くわ"],[30,1,"つみ"]],"text":"では、わたしたちは、なんと言おうか。恵みが増し加わるために、罪にとどまるべきであろうか。"},{"ref":"Rom.6.2","start":45006002,"end":45006002,"break":"none","ruby":[[0,1,"だん"],[10,1,"つみ"],[12,1,"たい"],[15,1,"し"],[35,1,"なか"],[37,1,"い"]],"text":"断じてそうではない。罪に対して死んだわたしたちが、どうして、なお、その中に生きておれるだろうか。"},{"ref":"Rom.6.3","start":45006003,"end":45006003,"break":"none","ruby":[[11,1,"し"],[37,1,"う"],[47,1,"かれ"],[49,1,"し"],[61,1,"う"]],"text":"それとも、あなたがたは知らないのか。キリスト・イエスにあずかるバプテスマを受けたわたしたちは、彼の死にあずかるバプテスマを受けたのである。"},{"ref":"Rom.6.4","start":45006004,"end":45006004,"break":"none","ruby":[[14,1,"し"],[30,1,"かれ"],[32,1,"とも"],[34,1,"ほうむ"],[52,1,"ちち"],[54,2,"えいこう"],[61,2,"しにん"],[64,1,"なか"],[88,1,"あたら"],[95,1,"い"]],"text":"すなわち、わたしたちは、その死にあずかるバプテスマによって、彼と共に葬られたのである。それは、キリストが父の栄光によって、死人の中からよみがえらされたように、わたしたちもまた、新しいいのちに生きるためである。"},{"ref":"Rom.6.5","start":45006005,"end":45006005,"break":"none","ruby":[[9,1,"かれ"],[11,1,"むす"],[18,1,"し"],[20,1,"さま"],[35,1,"かれ"],[37,2,"ふっかつ"],[40,1,"さま"]],"text":"もしわたしたちが、彼に結びついてその死の様にひとしくなるなら、さらに、彼の復活の様にもひとしくなるであろう。"},{"ref":"Rom.6.6","start":45006006,"end":45006006,"break":"none","ruby":[[9,1,"こと"],[11,1,"し"],[23,1,"うち"],[25,1,"ふる"],[27,1,"ひと"],[34,1,"とも"],[36,3,"じゅうじか"],[52,1,"つみ"],[58,1,"ほろ"],[71,1,"つみ"],[73,2,"どれい"]],"text":"わたしたちは、この事を知っている。わたしたちの内の古き人はキリストと共に十字架につけられた。それは、この罪のからだが滅び、わたしたちがもはや、罪の奴隷となることがないためである。"},{"ref":"Rom.6.7","start":45006007,"end":45006007,"break":"none","ruby":[[7,1,"し"],[10,1,"もの"],[13,1,"つみ"],[16,2,"かいほう"]],"text":"それは、すでに死んだ者は、罪から解放されているからである。"},{"ref":"Rom.6.8","start":45006008,"end":45006008,"break":"none","ruby":[[14,1,"とも"],[16,1,"し"],[24,1,"かれ"],[26,1,"とも"],[28,1,"い"],[34,1,"しん"]],"text":"もしわたしたちが、キリストと共に死んだなら、また彼と共に生きることを信じる。"},{"ref":"Rom.6.9","start":45006009,"end":45006009,"break":"none","ruby":[[5,2,"しにん"],[8,1,"なか"],[23,1,"し"],[31,1,"し"],[36,1,"かれ"],[38,2,"しはい"],[47,1,"し"]],"text":"キリストは死人の中からよみがえらされて、もはや死ぬことがなく、死はもはや彼を支配しないことを、知っているからである。"},{"ref":"Rom.6.10","start":45006010,"end":45006010,"break":"none","ruby":[[10,1,"し"],[19,1,"ど"],[20,1,"つみ"],[22,1,"たい"],[25,1,"し"],[38,1,"い"],[44,1,"かみ"],[46,1,"い"]],"text":"なぜなら、キリストが死んだのは、ただ一度罪に対して死んだのであり、キリストが生きるのは、神に生きるのだからである。"},{"ref":"Rom.6.11","start":45006011,"end":45006011,"break":"none","ruby":[[11,2,"じしん"],[15,1,"つみ"],[17,1,"たい"],[20,1,"し"],[23,1,"もの"],[40,1,"かみ"],[42,1,"い"],[47,1,"もの"],[55,1,"みと"]],"text":"このように、あなたがた自身も、罪に対して死んだ者であり、キリスト・イエスにあって神に生きている者であることを、認むべきである。"},{"ref":"Rom.6.12","start":45006012,"end":45006012,"break":"none","ruby":[[10,1,"し"],[18,1,"つみ"],[20,2,"しはい"],[30,2,"じょうよく"],[33,1,"したが"]],"text":"だから、あなたがたの死ぬべきからだを罪の支配にゆだねて、その情欲に従わせることをせず、"},{"ref":"Rom.6.13","start":45006013,"end":45006013,"break":"none","ruby":[[9,2,"したい"],[12,2,"ふぎ"],[15,2,"ぶき"],[20,1,"つみ"],[36,2,"しにん"],[39,1,"なか"],[42,1,"い"],[47,1,"もの"],[52,2,"じぶん"],[54,2,"じしん"],[57,1,"かみ"],[63,2,"じぶん"],[66,2,"したい"],[69,1,"ぎ"],[71,2,"ぶき"],[76,1,"かみ"]],"text":"また、あなたがたの肢体を不義の武器として罪にささげてはならない。むしろ、死人の中から生かされた者として、自分自身を神にささげ、自分の肢体を義の武器として神にささげるがよい。"},{"ref":"Rom.6.14","start":45006014,"end":45006014,"break":"none","ruby":[[11,2,"りっぽう"],[14,1,"もと"],[24,1,"めぐ"],[27,1,"もと"],[34,1,"つみ"],[36,2,"しはい"]],"text":"なぜなら、あなたがたは律法の下にあるのではなく、恵みの下にあるので、罪に支配されることはないからである。"},{"ref":"Rom.6.15","start":45006015,"end":45006015,"break":"paragraph","ruby":[[11,2,"りっぽう"],[14,1,"もと"],[21,1,"めぐ"],[24,1,"もと"],[41,1,"つみ"],[43,1,"おか"],[53,1,"だん"]],"text":"それでは、どうなのか。律法の下にではなく、恵みの下にあるからといって、わたしたちは罪を犯すべきであろうか。断じてそうではない。"},{"ref":"Rom.6.16","start":45006016,"end":45006016,"break":"none","ruby":[[6,1,"し"],[18,2,"じしん"],[26,1,"しもべ"],[31,2,"ふくじゅう"],[44,2,"じぶん"],[47,2,"ふくじゅう"],[53,1,"もの"],[55,1,"しもべ"],[61,1,"し"],[63,1,"いた"],[65,1,"つみ"],[67,1,"しもべ"],[78,1,"ぎ"],[83,2,"じゅうじゅん"],[86,1,"しもべ"]],"text":"あなたがたは知らないのか。あなたがた自身が、だれかの僕になって服従するなら、あなたがたは自分の服従するその者の僕であって、死に至る罪の僕ともなり、あるいは、義にいたる従順の僕ともなるのである。"},{"ref":"Rom.6.17","start":45006017,"end":45006017,"break":"none","ruby":[[4,1,"かみ"],[6,2,"かんしゃ"],[20,1,"つみ"],[22,1,"しもべ"],[29,1,"つた"],[34,1,"おしえ"],[36,2,"きじゅん"],[39,1,"こころ"],[42,2,"ふくじゅう"]],"text":"しかし、神は感謝すべきかな。あなたがたは罪の僕であったが、伝えられた教の基準に心から服従して、"},{"ref":"Rom.6.18","start":45006018,"end":45006018,"break":"none","ruby":[[0,1,"つみ"],[3,2,"かいほう"],[8,1,"ぎ"],[10,1,"しもべ"]],"text":"罪から解放され、義の僕となった。"},{"ref":"Rom.6.19","start":45006019,"end":45006019,"break":"none","ruby":[[4,2,"にんげん"],[6,1,"てき"],[8,1,"い"],[10,1,"かた"],[26,1,"にく"],[28,1,"よわ"],[47,2,"じぶん"],[50,2,"したい"],[53,1,"けが"],[56,2,"ふほう"],[60,1,"しもべ"],[68,2,"ふほう"],[71,1,"おちい"],[78,1,"いま"],[80,2,"じぶん"],[83,2,"したい"],[86,1,"ぎ"],[88,1,"しもべ"]],"text":"わたしは人間的な言い方をするが、それは、あなたがたの肉の弱さのゆえである。あなたがたは、かつて自分の肢体を汚れと不法との僕としてささげて不法に陥ったように、今や自分の肢体を義の僕としてささげて、きよくならねばならない。"},{"ref":"Rom.6.20","start":45006020,"end":45006020,"break":"none","ruby":[[6,1,"つみ"],[8,1,"しもべ"],[13,1,"とき"],[16,1,"ぎ"],[19,1,"えん"],[23,1,"もの"]],"text":"あなたがたが罪の僕であった時は、義とは縁のない者であった。"},{"ref":"Rom.6.21","start":45006021,"end":45006021,"break":"none","ruby":[[2,1,"とき"],[13,1,"み"],[15,1,"むす"],[25,1,"いま"],[28,1,"はじ"],[49,2,"しゅうきょく"],[53,1,"し"]],"text":"その時あなたがたは、どんな実を結んだのか。それは、今では恥とするようなものであった。それらのものの終極は、死である。"},{"ref":"Rom.6.22","start":45006022,"end":45006022,"break":"none","ruby":[[3,1,"いま"],[12,1,"つみ"],[15,2,"かいほう"],[20,1,"かみ"],[22,1,"つか"],[29,1,"いた"],[31,1,"み"],[33,1,"むす"],[41,2,"しゅうきょく"],[44,2,"えいえん"]],"text":"しかし今や、あなたがたは罪から解放されて神に仕え、きよきに至る実を結んでいる。その終極は永遠のいのちである。"},{"ref":"Rom.6.23","start":45006023,"end":45006023,"break":"none","ruby":[[0,1,"つみ"],[2,2,"しはら"],[5,2,"ほうしゅう"],[8,1,"し"],[16,1,"かみ"],[18,2,"たまもの"],[28,1,"しゅ"],[41,2,"えいえん"]],"text":"罪の支払う報酬は死である。しかし神の賜物は、わたしたちの主キリスト・イエスにおける永遠のいのちである。"}]