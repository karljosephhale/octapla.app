[{"ref":"Gal.5.1","start":48005001,"end":48005001,"break":"paragraph","ruby":[[0,2,"じゆう"],[3,1,"え"],[22,2,"かいほう"],[26,1,"くだ"],[39,1,"かた"],[41,1,"た"],[46,1,"ど"],[48,2,"どれい"]],"text":"自由を得させるために、キリストはわたしたちを解放して下さったのである。だから、堅く立って、二度と奴隷のくびきにつながれてはならない。"},{"ref":"Gal.5.2","start":48005002,"end":48005002,"break":"paragraph","ruby":[[0,1,"み"],[15,1,"い"],[20,2,"かつれい"],[23,1,"う"],[40,1,"よう"]],"text":"見よ、このパウロがあなたがたに言う。もし割礼を受けるなら、キリストはあなたがたに用のないものになろう。"},{"ref":"Gal.5.3","start":48005003,"end":48005003,"break":"none","ruby":[[0,2,"かつれい"],[3,1,"う"],[14,1,"ひと"],[22,1,"ど"],[23,1,"い"],[33,1,"ひと"],[38,2,"りっぽう"],[41,2,"ぜんぶ"],[44,1,"おこな"],[46,2,"ぎむ"]],"text":"割礼を受けようとするすべての人たちに、もう一度言っておく。そういう人たちは、律法の全部を行う義務がある。"},{"ref":"Gal.5.4","start":48005004,"end":48005004,"break":"none","ruby":[[0,2,"りっぽう"],[6,1,"ぎ"],[28,1,"はな"],[38,1,"めぐ"],[42,1,"お"]],"text":"律法によって義とされようとするあなたがたは、キリストから離れてしまっている。恵みから落ちている。"},{"ref":"Gal.5.5","start":48005005,"end":48005005,"break":"none","ruby":[[7,2,"みたま"],[10,1,"たす"],[16,2,"しんこう"],[22,1,"ぎ"],[27,1,"のぞ"],[30,1,"つよ"]],"text":"わたしたちは、御霊の助けにより、信仰によって義とされる望みを強くいだいている。"},{"ref":"Gal.5.6","start":48005006,"end":48005006,"break":"none","ruby":[[14,2,"かつれい"],[26,2,"もんだい"],[33,1,"たっと"],[38,1,"あい"],[43,1,"はたら"],[45,2,"しんこう"]],"text":"キリスト・イエスにあっては、割礼があってもなくても、問題ではない。尊いのは、愛によって働く信仰だけである。"},{"ref":"Gal.5.7","start":48005007,"end":48005007,"break":"paragraph","ruby":[[8,1,"はし"],[10,1,"つづ"],[21,2,"じゃま"],[27,2,"しんり"]],"text":"あなたがたはよく走り続けてきたのに、だれが邪魔をして、真理にそむかせたのか。"},{"ref":"Gal.5.8","start":48005008,"end":48005008,"break":"none","ruby":[[5,2,"かんゆう"],[15,1,"め"],[23,1,"で"]],"text":"そのような勧誘は、あなたがたを召されたかたから出たものではない。"},{"ref":"Gal.5.9","start":48005009,"end":48005009,"break":"none","ruby":[[0,1,"すこ"],[5,1,"たね"],[9,1,"こな"],[15,2,"ぜんたい"]],"text":"少しのパン種でも、粉のかたまり全体をふくらませる。"},{"ref":"Gal.5.10","start":48005010,"end":48005010,"break":"none","ruby":[[15,1,"ちが"],[18,1,"おも"],[31,1,"しゅ"],[36,2,"しんらい"],[53,2,"どうよう"],[60,1,"もの"],[78,1,"う"]],"text":"あなたがたはいささかもわたしと違った思いをいだくことはないと、主にあって信頼している。しかし、あなたがたを動揺させている者は、それがだれであろうと、さばきを受けるであろう。"},{"ref":"Gal.5.11","start":48005011,"end":48005011,"break":"none","ruby":[[0,2,"きょうだい"],[12,1,"いま"],[15,2,"かつれい"],[18,1,"の"],[20,1,"つた"],[36,2,"はくがい"],[57,3,"じゅうじか"]],"text":"兄弟たちよ。わたしがもし今でも割礼を宣べ伝えていたら、どうして、いまなお迫害されるはずがあろうか。そうしていたら、十字架のつまずきは、なくなっているであろう。"},{"ref":"Gal.5.12","start":48005012,"end":48005012,"break":"none","ruby":[[6,2,"せんどう"],[8,1,"しゃ"],[13,1,"みずか"],[15,2,"ふぐ"]],"text":"あなたがたの煽動者どもは、自ら不具になるがよかろう。"},{"ref":"Gal.5.13","start":48005013,"end":48005013,"break":"paragraph","ruby":[[0,2,"きょうだい"],[12,1,"め"],[19,1,"じつ"],[22,2,"じゆう"],[25,1,"え"],[38,2,"じゆう"],[42,1,"にく"],[44,1,"はたら"],[46,2,"きかい"],[54,1,"あい"],[59,1,"たがい"],[61,1,"つか"]],"text":"兄弟たちよ。あなたがたが召されたのは、実に、自由を得るためである。ただ、その自由を、肉の働く機会としないで、愛をもって互に仕えなさい。"},{"ref":"Gal.5.14","start":48005014,"end":48005014,"break":"none","ruby":[[0,2,"りっぽう"],[3,2,"ぜんたい"],[8,2,"じぶん"],[11,1,"あい"],[22,1,"とな"],[24,1,"ひと"],[26,1,"あい"],[35,2,"いっく"],[38,1,"つ"]],"text":"律法の全体は、「自分を愛するように、あなたの隣り人を愛せよ」というこの一句に尽きるからである。"},{"ref":"Gal.5.15","start":48005015,"end":48005015,"break":"none","ruby":[[0,1,"き"],[11,1,"たがい"],[15,1,"あ"],[18,1,"く"],[20,1,"あ"],[34,1,"たがい"],[36,1,"ほろ"]],"text":"気をつけるがよい。もし互にかみ合い、食い合っているなら、あなたがたは互に滅ぼされてしまうだろう。"},{"ref":"Gal.5.16","start":48005016,"end":48005016,"break":"paragraph","ruby":[[4,1,"めい"],[8,2,"みたま"],[14,1,"ある"],[26,1,"けっ"],[29,1,"にく"],[31,1,"よく"],[33,1,"み"]],"text":"わたしは命じる、御霊によって歩きなさい。そうすれば、決して肉の欲を満たすことはない。"},{"ref":"Gal.5.17","start":48005017,"end":48005017,"break":"none","ruby":[[5,1,"にく"],[7,1,"ほっ"],[14,2,"みたま"],[17,1,"はん"],[22,2,"みたま"],[25,1,"ほっ"],[32,1,"にく"],[34,1,"はん"],[54,1,"たがい"],[56,1,"あい"],[64,2,"けっか"],[73,2,"じぶん"],[80,1,"おも"]],"text":"なぜなら、肉の欲するところは御霊に反し、また御霊の欲するところは肉に反するからである。こうして、二つのものは互に相さからい、その結果、あなたがたは自分でしようと思うことを、することができないようになる。"},{"ref":"Gal.5.18","start":48005018,"end":48005018,"break":"none","ruby":[[8,2,"みたま"],[11,1,"みちび"],[18,2,"りっぽう"],[21,1,"もと"]],"text":"もしあなたがたが御霊に導かれるなら、律法の下にはいない。"},{"ref":"Gal.5.19","start":48005019,"end":48005019,"break":"none","ruby":[[0,1,"にく"],[2,1,"はたら"],[5,2,"めいはく"],[16,3,"ふひんこう"],[20,1,"けが"],[23,2,"こうしょく"]],"text":"肉の働きは明白である。すなわち、不品行、汚れ、好色、"},{"ref":"Gal.5.20","start":48005020,"end":48005020,"break":"none","ruby":[[0,2,"ぐうぞう"],[2,2,"れいはい"],[10,2,"てきい"],[13,1,"あらそ"],[20,1,"いか"],[23,3,"とうはしん"],[27,2,"ぶんれつ"],[30,2,"ぶんぱ"]],"text":"偶像礼拝、まじない、敵意、争い、そねみ、怒り、党派心、分裂、分派、"},{"ref":"Gal.5.21","start":48005021,"end":48005021,"break":"none","ruby":[[4,2,"でいすい"],[7,2,"えんらく"],[27,2,"いぜん"],[30,1,"い"],[37,1,"いま"],[39,1,"まえ"],[43,1,"い"],[57,1,"おこな"],[59,1,"もの"],[62,1,"かみ"],[64,1,"くに"]],"text":"ねたみ、泥酔、宴楽、および、そのたぐいである。わたしは以前も言ったように、今も前もって言っておく。このようなことを行う者は、神の国をつぐことがない。"},{"ref":"Gal.5.22","start":48005022,"end":48005022,"break":"none","ruby":[[4,2,"みたま"],[7,1,"み"],[10,1,"あい"],[12,1,"よろこ"],[15,2,"へいわ"],[18,2,"かんよう"],[21,2,"じあい"],[24,2,"ぜんい"],[27,2,"ちゅうじつ"]],"text":"しかし、御霊の実は、愛、喜び、平和、寛容、慈愛、善意、忠実、"},{"ref":"Gal.5.23","start":48005023,"end":48005023,"break":"none","ruby":[[0,2,"にゅうわ"],[3,2,"じせい"],[14,2,"ひてい"],[18,2,"りっぽう"]],"text":"柔和、自制であって、これらを否定する律法はない。"},{"ref":"Gal.5.24","start":48005024,"end":48005024,"break":"none","ruby":[[9,1,"ぞく"],[12,1,"もの"],[15,2,"じぶん"],[18,1,"にく"],[23,1,"じょう"],[25,1,"よく"],[27,1,"とも"],[29,3,"じゅうじか"]],"text":"キリスト・イエスに属する者は、自分の肉を、その情と欲と共に十字架につけてしまったのである。"},{"ref":"Gal.5.25","start":48005025,"end":48005025,"break":"paragraph","ruby":[[8,2,"みたま"],[14,1,"い"],[23,2,"みたま"],[29,1,"すすむ"]],"text":"もしわたしたちが御霊によって生きるのなら、また御霊によって進もうではないか。"},{"ref":"Gal.5.26","start":48005026,"end":48005026,"break":"none","ruby":[[0,1,"たがい"],[5,1,"あ"],[8,1,"たがい"],[13,1,"あ"],[17,2,"きょえい"],[20,1,"い"]],"text":"互にいどみ合い、互にねたみ合って、虚栄に生きてはならない。"}]