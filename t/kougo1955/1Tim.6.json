[{"ref":"1Tim.6.1","start":54006001,"end":54006001,"break":"paragraph","ruby":[[4,1,"した"],[8,2,"どれい"],[15,2,"じぶん"],[18,2,"しゅじん"],[22,1,"しん"],[24,2,"そんけい"],[29,1,"もの"],[33,1,"あお"],[45,1,"かみ"],[47,2,"みな"],[50,1,"おしえ"],[58,1,"う"]],"text":"くびきの下にある奴隷はすべて、自分の主人を、真に尊敬すべき者として仰ぐべきである。それは、神の御名と教とが、そしりを受けないためである。"},{"ref":"1Tim.6.2","start":54006002,"end":54006002,"break":"none","breaks":[[93,"paragraph"]],"ruby":[[0,2,"しんじゃ"],[5,2,"しゅじん"],[8,1,"も"],[13,1,"もの"],[20,2,"しゅじん"],[23,2,"きょうだい"],[33,2,"けいし"],[51,1,"はげ"],[54,1,"つか"],[65,1,"えき"],[67,1,"う"],[70,2,"しゅじん"],[74,2,"しんじゃ"],[79,1,"あい"],[85,1,"ひと"],[102,1,"こと"],[104,1,"おし"],[108,1,"すす"]],"text":"信者である主人を持っている者たちは、その主人が兄弟であるというので軽視してはならない。むしろ、ますます励んで仕えるべきである。その益を受ける主人は、信者であり愛されている人だからである。あなたは、これらの事を教えかつ勧めなさい。"},{"ref":"1Tim.6.3","start":54006003,"end":54006003,"break":"none","ruby":[[2,1,"ちが"],[8,1,"おし"],[18,1,"しゅ"],[28,2,"けんぜん"],[31,2,"ことば"],[38,2,"しんじん"],[44,1,"おしえ"],[46,2,"どうい"],[54,1,"もの"]],"text":"もし違ったことを教えて、わたしたちの主イエス・キリストの健全な言葉、ならびに信心にかなう教に同意しないような者があれば、"},{"ref":"1Tim.6.4","start":54006004,"end":54006004,"break":"none","ruby":[[0,1,"かれ"],[2,2,"こうまん"],[9,1,"なに"],[11,1,"し"],[17,2,"ろんぎ"],[20,2,"ことば"],[23,1,"あらそ"],[27,1,"やまい"],[34,1,"もの"],[48,1,"あらそ"],[59,1,"こころ"],[61,1,"しょう"]],"text":"彼は高慢であって、何も知らず、ただ論議と言葉の争いとに病みついている者である。そこから、ねたみ、争い、そしり、さいぎの心が生じ、"},{"ref":"1Tim.6.5","start":54006005,"end":54006005,"break":"none","ruby":[[2,2,"ちせい"],[5,1,"くさ"],[9,2,"しんり"],[16,2,"しんじん"],[19,2,"りとく"],[22,1,"こころ"],[23,1,"え"],[25,1,"もの"],[29,1,"あいだ"],[41,1,"あ"],[44,1,"おこ"]],"text":"また知性が腐って、真理にそむき、信心を利得と心得る者どもの間に、はてしのないいがみ合いが起るのである。"},{"ref":"1Tim.6.6","start":54006006,"end":54006006,"break":"none","ruby":[[4,2,"しんじん"],[10,1,"た"],[15,1,"し"],[20,1,"おお"],[23,2,"りとく"]],"text":"しかし、信心があって足ることを知るのは、大きな利得である。"},{"ref":"1Tim.6.7","start":54006007,"end":54006007,"break":"none","ruby":[[7,1,"なに"],[11,1,"も"],[18,1,"よ"],[26,1,"なに"],[30,1,"も"],[37,1,"よ"],[39,1,"さ"],[42,1,"い"]],"text":"わたしたちは、何ひとつ持たないでこの世にきた。また、何ひとつ持たないでこの世を去って行く。"},{"ref":"1Tim.6.8","start":54006008,"end":54006008,"break":"none","ruby":[[2,2,"いしょく"],[12,1,"た"]],"text":"ただ衣食があれば、それで足れりとすべきである。"},{"ref":"1Tim.6.9","start":54006009,"end":54006009,"break":"none","ruby":[[0,1,"と"],[5,1,"ねが"],[7,1,"もと"],[10,1,"もの"],[13,2,"ゆうわく"],[21,1,"おちい"],[27,1,"ひと"],[29,1,"ほろ"],[32,2,"はかい"],[36,1,"しず"],[41,3,"むふんべつ"],[45,1,"おそ"],[54,2,"じょうよく"],[57,1,"おちい"]],"text":"富むことを願い求める者は、誘惑と、わなとに陥り、また、人を滅びと破壊とに沈ませる、無分別な恐ろしいさまざまの情欲に陥るのである。"},{"ref":"1Tim.6.10","start":54006010,"end":54006010,"break":"none","ruby":[[0,2,"きんせん"],[3,1,"あい"],[14,1,"あく"],[16,1,"ね"],[23,2,"ひとびと"],[26,1,"よく"],[30,2,"きんせん"],[33,1,"もと"],[39,2,"しんこう"],[43,1,"まよ"],[45,1,"で"],[48,1,"おお"],[51,2,"くつう"],[57,2,"じぶん"],[59,2,"じしん"],[62,1,"さ"]],"text":"金銭を愛することは、すべての悪の根である。ある人々は欲ばって金銭を求めたため、信仰から迷い出て、多くの苦痛をもって自分自身を刺しとおした。"},{"ref":"1Tim.6.11","start":54006011,"end":54006011,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"ひと"],[17,1,"こと"],[19,1,"さ"],[29,1,"ぎ"],[31,2,"しんじん"],[34,2,"しんこう"],[37,1,"あい"],[39,2,"にんたい"],[42,2,"にゅうわ"],[46,1,"お"],[48,1,"もと"]],"text":"しかし、神の人よ。あなたはこれらの事を避けなさい。そして、義と信心と信仰と愛と忍耐と柔和とを追い求めなさい。"},{"ref":"1Tim.6.12","start":54006012,"end":54006012,"break":"none","ruby":[[0,2,"しんこう"],[3,1,"たたか"],[10,1,"たたか"],[16,2,"えいえん"],[23,2,"かくとく"],[40,1,"め"],[44,1,"おお"],[47,2,"しょうにん"],[50,1,"まえ"]],"text":"信仰の戦いをりっぱに戦いぬいて、永遠のいのちを獲得しなさい。あなたは、そのために召され、多くの証人の前で、りっぱなあかしをしたのである。"},{"ref":"1Tim.6.13","start":54006013,"end":54006013,"break":"none","ruby":[[11,1,"い"],[15,1,"くだ"],[18,1,"かみ"],[36,2,"めんぜん"],[69,1,"めい"]],"text":"わたしはすべてのものを生かして下さる神のみまえと、またポンテオ・ピラトの面前でりっぱなあかしをなさったキリスト・イエスのみまえで、あなたに命じる。"},{"ref":"1Tim.6.14","start":54006014,"end":54006014,"break":"none","ruby":[[6,1,"しゅ"],[16,2,"しゅつげん"],[23,1,"いまし"],[26,1,"けが"],[40,2,"ひなん"],[48,1,"まも"]],"text":"わたしたちの主イエス・キリストの出現まで、その戒めを汚すことがなく、また、それを非難のないように守りなさい。"},{"ref":"1Tim.6.15","start":54006015,"end":54006015,"break":"none","ruby":[[0,1,"とき"],[6,2,"しゅくふく"],[9,1,"み"],[19,1,"ちから"],[30,1,"おう"],[32,1,"おう"],[39,1,"しゅ"],[41,1,"しゅ"],[49,2,"しゅつげん"],[54,1,"くだ"]],"text":"時がくれば、祝福に満ちた、ただひとりの力あるかた、もろもろの王の王、もろもろの主の主が、キリストを出現させて下さるであろう。"},{"ref":"1Tim.6.16","start":54006016,"end":54006016,"break":"none","ruby":[[0,1,"かみ"],[7,1,"ふ"],[8,1,"し"],[10,1,"たも"],[13,1,"ちか"],[19,1,"ひかり"],[21,1,"なか"],[23,1,"す"],[26,2,"にんげん"],[29,1,"なか"],[34,1,"み"],[36,1,"もの"],[41,1,"み"],[60,2,"えいえん"],[63,2,"しはい"],[68,1,"かみ"]],"text":"神はただひとり不死を保ち、近づきがたい光の中に住み、人間の中でだれも見た者がなく、見ることもできないかたである。ほまれと永遠の支配とが、神にあるように、アァメン。"},{"ref":"1Tim.6.17","start":54006017,"end":54006017,"break":"paragraph","ruby":[[2,1,"よ"],[4,1,"と"],[9,1,"もの"],[14,1,"めい"],[20,2,"こうまん"],[35,1,"とみ"],[37,1,"のぞ"],[58,1,"もの"],[60,1,"ゆた"],[63,1,"そな"],[66,1,"たの"],[71,1,"くだ"],[74,1,"かみ"]],"text":"この世で富んでいる者たちに、命じなさい。高慢にならず、たよりにならない富に望みをおかず、むしろ、わたしたちにすべての物を豊かに備えて楽しませて下さる神に、のぞみをおくように、"},{"ref":"1Tim.6.18","start":54006018,"end":54006018,"break":"none","ruby":[[3,1,"よ"],[5,1,"おこな"],[10,1,"よ"],[15,1,"とみ"],[18,1,"お"],[23,1,"ほどこ"],[26,1,"ひと"],[28,1,"わ"],[30,1,"あた"],[36,1,"よろこ"]],"text":"また、良い行いをし、良いわざに富み、惜しみなく施し、人に分け与えることを喜び、"},{"ref":"1Tim.6.19","start":54006019,"end":54006019,"break":"none","ruby":[[5,1,"しん"],[11,1,"え"],[17,2,"みらい"],[20,1,"そな"],[25,2,"どだい"],[28,2,"じぶん"],[34,1,"きず"],[36,1,"あ"],[43,1,"めい"]],"text":"こうして、真のいのちを得るために、未来に備えてよい土台を自分のために築き上げるように、命じなさい。"},{"ref":"1Tim.6.20","start":54006020,"end":54006020,"break":"paragraph","ruby":[[20,1,"まも"],[30,2,"ぞくあく"],[35,1,"はなし"],[38,1,"いつわ"],[42,2,"ちしき"],[48,2,"はんたい"],[50,1,"ろん"],[53,1,"さ"]],"text":"テモテよ。あなたにゆだねられていることを守りなさい。そして、俗悪なむだ話と、偽りの「知識」による反対論とを避けなさい。"},{"ref":"1Tim.6.21","start":54006021,"end":54006021,"break":"none","breaks":[[29,"paragraph"]],"ruby":[[2,2,"ひとびと"],[8,2,"ねっちゅう"],[13,2,"しんこう"],[29,1,"めぐ"],[39,1,"とも"]],"text":"ある人々はそれに熱中して、信仰からそれてしまったのである。恵みが、あなたがたと共にあるように。"}]