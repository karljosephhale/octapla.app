[{"ref":"1Kgs.9.1","start":11009001,"end":11009001,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,1,"みや"],[9,1,"おう"],[11,2,"きゅうでん"],[21,1,"た"],[26,1,"のぞ"],[36,1,"た"],[38,1,"おわ"],[41,1,"とき"]],"text":"ソロモンが主の宮と王の宮殿およびソロモンが建てようと望んだすべてのものを建て終った時、"},{"ref":"1Kgs.9.2","start":11009002,"end":11009002,"break":"none","ruby":[[0,1,"しゅ"],[15,1,"あらわ"],[23,1,"ふたた"],[25,1,"あらわ"]],"text":"主はかつてギベオンでソロモンに現れられたように再び現れて、"},{"ref":"1Kgs.9.3","start":11009003,"end":11009003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[17,1,"まえ"],[19,1,"ねが"],[22,1,"いのり"],[24,1,"ねが"],[28,1,"き"],[40,1,"た"],[45,1,"みや"],[47,2,"せいべつ"],[56,1,"な"],[58,2,"えいきゅう"],[64,1,"お"],[71,1,"め"],[78,1,"こころ"],[80,1,"つね"]],"text":"彼に言われた、「あなたが、わたしの前に願った祈と願いとを聞いた。わたしはあなたが建てたこの宮を聖別して、わたしの名を永久にそこに置く。わたしの目と、わたしの心は常にそこにあるであろう。"},{"ref":"1Kgs.9.4","start":11009004,"end":11009004,"break":"none","ruby":[[11,1,"ちち"],[16,1,"あゆ"],[22,1,"まった"],[24,1,"こころ"],[29,1,"ただ"],[36,1,"まえ"],[38,1,"あゆ"],[48,1,"めい"],[64,1,"さだ"],[73,1,"まも"]],"text":"あなたがもし、あなたの父ダビデが歩んだように全き心をもって正しくわたしの前に歩み、すべてわたしが命じたようにおこなって、わたしの定めと、おきてとを守るならば、"},{"ref":"1Kgs.9.5","start":11009005,"end":11009005,"break":"none","ruby":[[9,1,"ちち"],[14,2,"やくそく"],[25,2,"おうい"],[31,1,"ひと"],[37,1,"か"],[51,1,"い"],[68,1,"おう"],[71,1,"くらい"],[76,2,"かくほ"]],"text":"わたしは、あなたの父ダビデに約束して『イスラエルの王位にのぼる人があなたに欠けることはないであろう』と言ったように、あなたのイスラエルに王たる位をながく確保するであろう。"},{"ref":"1Kgs.9.6","start":11009006,"end":11009006,"break":"none","ruby":[[19,2,"しそん"],[30,1,"したが"],[44,1,"まえ"],[46,1,"お"],[49,1,"いまし"],[52,1,"さだ"],[56,1,"まも"],[60,1,"た"],[62,2,"かみがみ"],[65,1,"い"],[72,1,"つか"],[78,1,"おが"]],"text":"しかし、あなたがた、またはあなたがたの子孫がそむいてわたしに従わず、わたしがあなたがたの前に置いた戒めと定めとを守らず、他の神々に行って、それに仕え、それを拝むならば、"},{"ref":"1Kgs.9.7","start":11009007,"end":11009007,"break":"none","ruby":[[15,1,"あた"],[18,1,"ち"],[25,1,"た"],[38,1,"な"],[43,2,"せいべつ"],[47,1,"みや"],[53,1,"まえ"],[56,1,"な"],[80,1,"たみ"],[93,1,"わら"],[95,1,"ぐさ"]],"text":"わたしはイスラエルを、わたしが与えた地のおもてから断つであろう。またわたしの名のために聖別した宮をわたしの前から投げすてるであろう。そしてイスラエルはもろもろの民のうちにことわざとなり、笑い草となるであろう。"},{"ref":"1Kgs.9.8","start":11009008,"end":11009008,"break":"none","ruby":[[5,1,"みや"],[7,2,"あらつか"],[20,1,"す"],[23,1,"もの"],[25,1,"みな"],[26,1,"おどろ"],[40,1,"しゅ"],[44,1,"ち"],[49,1,"みや"],[64,1,"い"]],"text":"かつ、この宮は荒塚となり、そのかたわらを過ぎる者は皆驚き、うそぶいて『なにゆえ、主はこの地と、この宮とにこのようにされたのか』と言うであろう。"},{"ref":"1Kgs.9.9","start":11009009,"end":11009009,"break":"none","ruby":[[2,1,"とき"],[3,2,"ひとびと"],[6,1,"こた"],[10,1,"かれ"],[13,2,"じぶん"],[16,2,"せんぞ"],[24,1,"ち"],[27,1,"みちび"],[29,1,"だ"],[32,1,"かれ"],[35,1,"かみ"],[37,1,"しゅ"],[39,1,"す"],[43,1,"た"],[45,2,"かみがみ"],[50,1,"したが"],[56,1,"おが"],[62,1,"つか"],[69,1,"しゅ"],[77,1,"わざわい"],[79,1,"かれ"],[82,1,"うえ"],[84,1,"くだ"],[93,1,"い"]],"text":"その時人々は答えて『彼らは自分の先祖をエジプトの地から導き出した彼らの神、主を捨てて、他の神々につき従い、それを拝み、それに仕えたために、主はこのすべての災を彼らの上に下したのである』と言うであろう」。"},{"ref":"1Kgs.9.10","start":11009010,"end":11009010,"break":"paragraph","ruby":[[7,1,"ねん"],[9,1,"へ"],[14,1,"いえ"],[19,1,"しゅ"],[21,1,"みや"],[23,1,"おう"],[25,2,"きゅうでん"],[29,1,"た"],[31,1,"おわ"],[34,1,"とき"]],"text":"ソロモンは二十年を経て二つの家すなわち主の宮と王の宮殿とを建て終った時、"},{"ref":"1Kgs.9.11","start":11009011,"end":11009011,"break":"none","ruby":[[3,1,"おう"],[13,1,"のぞ"],[16,1,"まか"],[19,2,"こうはく"],[29,1,"きん"],[32,2,"きょうきゅう"],[43,1,"おう"],[50,1,"ち"],[52,1,"まち"],[60,1,"あた"]],"text":"ツロの王ヒラムがソロモンの望みに任せて香柏と、いとすぎと、金とを供給したので、ソロモン王はガリラヤの地の町二十をヒラムに与えた。"},{"ref":"1Kgs.9.12","start":11009012,"end":11009012,"break":"none","ruby":[[11,1,"き"],[19,1,"かれ"],[21,1,"あた"],[24,2,"まちまち"],[27,1,"み"],[36,1,"かれ"],[38,1,"き"]],"text":"しかしヒラムがツロから来て、ソロモンが彼に与えた町々を見たとき、それらは彼の気にいらなかったので、"},{"ref":"1Kgs.9.13","start":11009013,"end":11009013,"break":"none","ruby":[[0,1,"かれ"],[4,2,"きょうだい"],[21,2,"まちまち"],[36,1,"い"],[47,2,"こんにち"],[55,1,"ち"],[57,1,"よ"]],"text":"彼は、「兄弟よ、あなたがくださったこれらの町々は、いったいなんですか」と言った。それで、そこは今日までカブルの地と呼ばれている。"},{"ref":"1Kgs.9.14","start":11009014,"end":11009014,"break":"none","ruby":[[7,1,"きん"],[16,1,"おう"],[18,1,"おく"]],"text":"ヒラムはかつて金百二十タラントを王に贈った。"},{"ref":"1Kgs.9.15","start":11009015,"end":11009015,"break":"paragraph","ruby":[[4,1,"おう"],[6,3,"きょうせいてき"],[10,3,"ろうどうしゃ"],[14,2,"ちょうぼ"],[30,1,"しゅ"],[32,1,"みや"],[34,2,"じぶん"],[37,2,"きゅうでん"],[50,2,"じょうへき"],[66,1,"た"]],"text":"ソロモン王が強制的に労働者を徴募したのはこうである。すなわち主の宮と自分の宮殿と、ミロとエルサレムの城壁と、ハゾルとメギドとゲゼルを建てるためであった。"},{"ref":"1Kgs.9.16","start":11009016,"end":11009016,"break":"none","ruby":[[6,1,"おう"],[13,1,"のぼ"],[23,1,"と"],[26,1,"ひ"],[31,1,"や"],[36,1,"まち"],[38,1,"す"],[49,1,"ころ"],[60,1,"つま"],[64,2,"じぶん"],[67,1,"むすめ"],[69,1,"あた"],[72,2,"こんいん"],[75,1,"おく"],[77,1,"もの"]],"text":"（エジプトの王パロはかつて上ってきて、ゲゼルを取り、火でこれを焼き、その町に住んでいたカナンびとを殺し、これをソロモンの妻である自分の娘に与えて婚姻の贈り物としたので、"},{"ref":"1Kgs.9.17","start":11009017,"end":11009017,"break":"none","ruby":[[11,1,"た"],[13,1,"なお"],[18,2,"また"],[20,1,"した"]],"text":"ソロモンはそのゲゼルを建て直した）。また下ベテホロンと、"},{"ref":"1Kgs.9.18","start":11009018,"end":11009018,"break":"none","ruby":[[8,1,"くに"],[10,2,"あらの"]],"text":"バアラテとユダの国の荒野にあるタマル、"},{"ref":"1Kgs.9.19","start":11009019,"end":11009019,"break":"none","ruby":[[8,1,"も"],[13,2,"そうこ"],[16,2,"まちまち"],[19,2,"せんしゃ"],[22,2,"まちまち"],[25,2,"きへい"],[28,2,"まちまち"],[58,2,"りょうち"],[64,1,"た"],[69,1,"のぞ"],[80,1,"た"]],"text":"およびソロモンが持っていた倉庫の町々、戦車の町々、騎兵の町々ならびにソロモンがエルサレム、レバノンおよびそのすべての領地において建てようと望んだものをことごとく建てるためであった。"},{"ref":"1Kgs.9.20","start":11009020,"end":11009020,"break":"none","ruby":[[9,2,"しそん"],[42,1,"のこ"],[45,1,"もの"]],"text":"すべてイスラエルの子孫でないアモリびと、ヘテびと、ペリジびと、ヒビびと、エブスびとの残った者、"},{"ref":"1Kgs.9.21","start":11009021,"end":11009021,"break":"none","ruby":[[2,1,"ち"],[7,1,"かれ"],[13,1,"のこ"],[16,2,"しそん"],[28,2,"ひとびと"],[31,1,"ほろ"],[46,1,"もの"],[54,3,"きょうせいてき"],[58,2,"どれい"],[63,2,"ちょうぼ"],[71,2,"こんにち"],[74,1,"いた"]],"text":"その地にあって彼らのあとに残った子孫すなわちイスラエルの人々の滅ぼしつくすことのできなかった者を、ソロモンは強制的に奴隷として徴募をおこない、今日に至っている。"},{"ref":"1Kgs.9.22","start":11009022,"end":11009022,"break":"none","ruby":[[9,2,"ひとびと"],[21,2,"どれい"],[30,1,"かれ"],[33,2,"ぐんじん"],[38,1,"かれ"],[40,2,"やくにん"],[43,2,"しれい"],[45,1,"かん"],[47,2,"しき"],[49,1,"かん"],[51,2,"せんしゃ"],[53,2,"たいちょう"],[56,3,"きへいたい"],[59,1,"ちょう"]],"text":"しかしイスラエルの人々をソロモンはひとりも奴隷としなかった。彼らは軍人、また彼の役人、司令官、指揮官、戦車隊長、騎兵隊長であったからである。"},{"ref":"1Kgs.9.23","start":11009023,"end":11009023,"break":"paragraph","ruby":[[5,2,"こうじ"],[8,2,"かんとく"],[12,2,"うわやく"],[15,2,"かんり"],[22,1,"にん"],[28,2,"こうじ"],[31,1,"はたら"],[33,1,"たみ"],[35,1,"おさ"]],"text":"ソロモンの工事を監督する上役の官吏は五百五十人であって、工事に働く民を治めた。"},{"ref":"1Kgs.9.24","start":11009024,"end":11009024,"break":"paragraph","ruby":[[3,1,"むすめ"],[9,1,"まち"],[12,1,"のぼ"],[21,2,"かのじょ"],[27,1,"た"],[30,1,"いえ"],[32,1,"す"],[38,1,"とき"],[47,1,"た"]],"text":"パロの娘はダビデの町から上って、ソロモンが彼女のために建てた家に住んだ。その時ソロモンはミロを建てた。"},{"ref":"1Kgs.9.25","start":11009025,"end":11009025,"break":"paragraph","ruby":[[5,1,"しゅ"],[10,1,"きず"],[13,2,"さいだん"],[16,1,"うえ"],[18,1,"ねん"],[21,1,"ど"],[22,2,"はんさい"],[25,3,"しゅうおんさい"],[35,1,"しゅ"],[37,1,"まえ"],[39,1,"こう"],[54,1,"みや"],[56,2,"かんせい"]],"text":"ソロモンは主のために築いた祭壇の上に年に三度燔祭と酬恩祭をささげ、また主の前に香をたいた。こうしてソロモンは宮を完成した。"},{"ref":"1Kgs.9.26","start":11009026,"end":11009026,"break":"paragraph","ruby":[[4,1,"おう"],[10,1,"ち"],[12,2,"こうかい"],[15,1,"きし"],[21,1,"ちか"],[32,2,"すうせき"],[35,1,"ふね"],[37,1,"つく"]],"text":"ソロモン王はエドムの地、紅海の岸のエラテに近いエジオン・ゲベルで数隻の船を造った。"},{"ref":"1Kgs.9.27","start":11009027,"end":11009027,"break":"none","ruby":[[4,1,"うみ"],[6,1,"こと"],[8,1,"し"],[13,2,"せんいん"],[33,1,"とも"],[37,1,"ふね"]],"text":"ヒラムは海の事を知っている船員であるそのしもべをソロモンのしもべと共にその船でつかわした。"},{"ref":"1Kgs.9.28","start":11009028,"end":11009028,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[15,1,"きん"],[25,1,"と"],[33,1,"おう"],[35,1,"ところ"]],"text":"彼らはオフルへ行って、そこから金四百二十タラントを取って、ソロモン王の所にもってきた。"}]