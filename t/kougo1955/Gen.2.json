[{"ref":"Gen.2.1","start":1002001,"end":1002001,"break":"paragraph","ruby":[[4,1,"てん"],[6,1,"ち"],[11,2,"ばんしょう"],[15,2,"かんせい"]],"text":"こうして天と地と、その万象とが完成した。"},{"ref":"Gen.2.2","start":1002002,"end":1002002,"break":"none","ruby":[[0,1,"かみ"],[2,1,"だい"],[4,1,"にち"],[8,2,"さぎょう"],[11,1,"お"],[28,2,"さぎょう"],[31,1,"おわ"],[34,1,"だい"],[36,1,"にち"],[38,1,"やす"]],"text":"神は第七日にその作業を終えられた。すなわち、そのすべての作業を終って第七日に休まれた。"},{"ref":"Gen.2.3","start":1002003,"end":1002003,"break":"none","ruby":[[0,1,"かみ"],[4,1,"だい"],[6,1,"にち"],[8,2,"しゅくふく"],[16,2,"せいべつ"],[22,1,"かみ"],[26,1,"ひ"],[35,2,"そうぞう"],[41,1,"おわ"],[44,1,"やす"]],"text":"神はその第七日を祝福して、これを聖別された。神がこの日に、そのすべての創造のわざを終って休まれたからである。"},{"ref":"Gen.2.4","start":1002004,"end":1002004,"break":"paragraph","breaks":[[14,"paragraph"]],"ruby":[[3,2,"てんち"],[5,2,"そうぞう"],[8,2,"ゆらい"],[14,1,"しゅ"],[17,1,"かみ"],[19,1,"ち"],[21,1,"てん"],[24,1,"つく"],[28,1,"とき"]],"text":"これが天地創造の由来である。主なる神が地と天とを造られた時、"},{"ref":"Gen.2.5","start":1002005,"end":1002005,"break":"none","ruby":[[0,1,"ち"],[5,1,"の"],[7,1,"き"],[14,1,"の"],[16,1,"くさ"],[27,1,"しゅ"],[30,1,"かみ"],[32,1,"ち"],[34,1,"あめ"],[36,1,"ふ"],[43,1,"つち"],[45,1,"たがや"],[47,1,"ひと"]],"text":"地にはまだ野の木もなく、また野の草もはえていなかった。主なる神が地に雨を降らせず、また土を耕す人もなかったからである。"},{"ref":"Gen.2.6","start":1002006,"end":1002006,"break":"none","ruby":[[3,1,"ち"],[6,1,"いずみ"],[14,1,"つち"],[16,2,"ぜんめん"],[19,1,"うるお"]],"text":"しかし地から泉がわきあがって土の全面を潤していた。"},{"ref":"Gen.2.7","start":1002007,"end":1002007,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"つち"],[10,1,"ひと"],[12,1,"つく"],[15,1,"いのち"],[17,1,"いき"],[21,1,"はな"],[23,1,"ふ"],[34,1,"ひと"],[36,1,"い"],[39,1,"もの"]],"text":"主なる神は土のちりで人を造り、命の息をその鼻に吹きいれられた。そこで人は生きた者となった。"},{"ref":"Gen.2.8","start":1002008,"end":1002008,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"ひがし"],[17,1,"その"],[19,1,"もう"],[25,1,"つく"],[28,1,"ひと"],[33,1,"お"]],"text":"主なる神は東のかた、エデンに一つの園を設けて、その造った人をそこに置かれた。"},{"ref":"Gen.2.9","start":1002009,"end":1002009,"break":"none","ruby":[[2,1,"しゅ"],[5,1,"かみ"],[8,1,"み"],[10,1,"うつく"],[14,1,"た"],[18,1,"よ"],[24,1,"き"],[26,1,"つち"],[34,1,"さら"],[36,1,"その"],[38,2,"ちゅうおう"],[41,1,"いのち"],[43,1,"き"],[46,2,"ぜんあく"],[49,1,"し"],[51,1,"き"]],"text":"また主なる神は、見て美しく、食べるに良いすべての木を土からはえさせ、更に園の中央に命の木と、善悪を知る木とをはえさせられた。"},{"ref":"Gen.2.10","start":1002010,"end":1002010,"break":"none","ruby":[[5,1,"かわ"],[12,1,"なが"],[14,1,"で"],[16,1,"その"],[18,1,"うるお"],[25,1,"わか"],[31,1,"かわ"]],"text":"また一つの川がエデンから流れ出て園を潤し、そこから分れて四つの川となった。"},{"ref":"Gen.2.11","start":1002011,"end":1002011,"break":"none","ruby":[[2,1,"だい"],[5,1,"な"],[14,1,"きん"],[22,1,"ぜん"],[23,1,"ち"]],"text":"その第一の名はピソンといい、金のあるハビラの全地をめぐるもので、"},{"ref":"Gen.2.12","start":1002012,"end":1002012,"break":"none","ruby":[[2,1,"ち"],[4,1,"きん"],[6,1,"よ"],[27,1,"さん"]],"text":"その地の金は良く、またそこはブドラクと、しまめのうとを産した。"},{"ref":"Gen.2.13","start":1002013,"end":1002013,"break":"none","ruby":[[0,1,"だい"],[3,1,"かわ"],[5,1,"な"],[17,1,"ぜん"],[18,1,"ち"]],"text":"第二の川の名はギホンといい、クシの全地をめぐるもの。"},{"ref":"Gen.2.14","start":1002014,"end":1002014,"break":"none","ruby":[[0,1,"だい"],[3,1,"かわ"],[5,1,"な"],[21,1,"ひがし"],[23,1,"なが"],[29,1,"だい"],[32,1,"かわ"]],"text":"第三の川の名はヒデケルといい、アッスリヤの東を流れるもの。第四の川はユフラテである。"},{"ref":"Gen.2.15","start":1002015,"end":1002015,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"ひと"],[7,1,"つ"],[10,1,"い"],[17,1,"その"],[19,1,"お"],[25,1,"たがや"],[32,1,"まも"]],"text":"主なる神は人を連れて行ってエデンの園に置き、これを耕させ、これを守らせられた。"},{"ref":"Gen.2.16","start":1002016,"end":1002016,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"ひと"],[9,1,"めい"],[12,1,"い"],[22,1,"その"],[26,1,"き"],[31,1,"こころ"],[36,1,"と"],[39,1,"た"]],"text":"主なる神はその人に命じて言われた、「あなたは園のどの木からでも心のままに取って食べてよろしい。"},{"ref":"Gen.2.17","start":1002017,"end":1002017,"break":"none","ruby":[[3,2,"ぜんあく"],[6,1,"し"],[8,1,"き"],[12,1,"と"],[15,1,"た"],[27,1,"と"],[30,1,"た"],[38,1,"し"]],"text":"しかし善悪を知る木からは取って食べてはならない。それを取って食べると、きっと死ぬであろう」。"},{"ref":"Gen.2.18","start":1002018,"end":1002018,"break":"paragraph","ruby":[[2,1,"しゅ"],[5,1,"かみ"],[7,1,"い"],[13,1,"ひと"],[23,1,"よ"],[28,1,"かれ"],[39,1,"たす"],[41,1,"て"],[43,1,"つく"]],"text":"また主なる神は言われた、「人がひとりでいるのは良くない。彼のために、ふさわしい助け手を造ろう」。"},{"ref":"Gen.2.19","start":1002019,"end":1002019,"break":"none","ruby":[[3,1,"しゅ"],[6,1,"かみ"],[8,1,"の"],[14,1,"けもの"],[17,1,"そら"],[23,1,"とり"],[26,1,"つち"],[28,1,"つく"],[31,1,"ひと"],[37,1,"つ"],[43,1,"かれ"],[51,1,"な"],[58,1,"み"],[63,1,"ひと"],[68,1,"い"],[70,1,"もの"],[72,1,"あた"],[75,1,"な"],[80,1,"な"]],"text":"そして主なる神は野のすべての獣と、空のすべての鳥とを土で造り、人のところへ連れてきて、彼がそれにどんな名をつけるかを見られた。人がすべて生き物に与える名は、その名となるのであった。"},{"ref":"Gen.2.20","start":1002020,"end":1002020,"break":"none","ruby":[[3,1,"ひと"],[10,2,"かちく"],[14,1,"そら"],[16,1,"とり"],[19,1,"の"],[25,1,"けもの"],[28,1,"な"],[35,1,"ひと"],[43,1,"たす"],[45,1,"て"],[47,1,"み"]],"text":"それで人は、すべての家畜と、空の鳥と、野のすべての獣とに名をつけたが、人にはふさわしい助け手が見つからなかった。"},{"ref":"Gen.2.21","start":1002021,"end":1002021,"break":"none","ruby":[[3,1,"しゅ"],[6,1,"かみ"],[8,1,"ひと"],[10,1,"ふか"],[12,1,"ねむ"],[16,1,"ねむ"],[19,1,"とき"],[27,1,"ぼね"],[32,1,"と"],[38,1,"ところ"],[40,1,"にく"]],"text":"そこで主なる神は人を深く眠らせ、眠った時に、そのあばら骨の一つを取って、その所を肉でふさがれた。"},{"ref":"Gen.2.22","start":1002022,"end":1002022,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"ひと"],[8,1,"と"],[14,1,"ぼね"],[20,1,"おんな"],[22,1,"つく"],[25,1,"ひと"],[31,1,"つ"]],"text":"主なる神は人から取ったあばら骨でひとりの女を造り、人のところへ連れてこられた。"},{"ref":"Gen.2.23","start":1002023,"end":1002023,"break":"none","breaks":[[11,"stanza"],[28,"line"],[36,"line"],[48,"line"]],"ruby":[[5,1,"ひと"],[7,1,"い"],[24,1,"ほね"],[26,1,"ほね"],[32,1,"にく"],[34,1,"にく"],[36,1,"おとこ"],[39,1,"と"],[51,1,"おんな"],[53,1,"な"]],"text":"そのとき、人は言った。「これこそ、ついにわたしの骨の骨、わたしの肉の肉。男から取ったものだから、これを女と名づけよう」。"},{"ref":"Gen.2.24","start":1002024,"end":1002024,"break":"none","ruby":[[3,1,"ひと"],[7,1,"ちち"],[9,1,"はは"],[11,1,"はな"],[15,1,"つま"],[17,1,"むす"],[19,1,"あ"],[22,2,"いったい"]],"text":"それで人はその父と母を離れて、妻と結び合い、一体となるのである。"},{"ref":"Gen.2.25","start":1002025,"end":1002025,"break":"none","ruby":[[0,1,"ひと"],[4,1,"つま"],[13,1,"はだか"],[20,1,"は"],[27,1,"おも"]],"text":"人とその妻とは、ふたりとも裸であったが、恥ずかしいとは思わなかった。"}]