[{"ref":"Prov.25.1","start":20025001,"end":20025001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[11,2,"しんげん"],[20,1,"おう"],[26,1,"ぞく"],[29,2,"ひとびと"],[35,1,"か"],[37,1,"うつ"]],"text":"これらもまたソロモンの箴言であり、ユダの王ヒゼキヤに属する人々がこれを書き写した。"},{"ref":"Prov.25.2","start":20025002,"end":20025002,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"こと"],[2,1,"かく"],[6,1,"かみ"],[8,1,"ほまれ"],[13,1,"こと"],[15,1,"きわ"],[20,1,"おう"],[22,1,"ほまれ"]],"text":"事を隠すのは神の誉であり、事を窮めるのは王の誉である。"},{"ref":"Prov.25.3","start":20025003,"end":20025003,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"てん"],[2,1,"たか"],[5,1,"ち"],[7,1,"ふか"],[11,1,"おう"],[14,1,"もの"],[16,1,"こころ"],[19,1,"はか"]],"text":"天の高さと地の深さと、王たる者の心とは測ることができない。"},{"ref":"Prov.25.4","start":20025004,"end":20025004,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ぎん"],[9,1,"のぞ"],[18,1,"ぎん"],[19,3,"ざいくにん"],[23,1,"うつわ"],[25,1,"つく"],[27,2,"ざいりょう"]],"text":"銀から、かなくそを除け、そうすれば、銀細工人が器を造る材料となる。"},{"ref":"Prov.25.5","start":20025005,"end":20025005,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"おう"],[2,1,"まえ"],[5,1,"あ"],[8,1,"もの"],[10,1,"のぞ"],[21,1,"くらい"],[23,2,"せいぎ"],[29,1,"かた"],[31,1,"た"]],"text":"王の前から悪しき者を除け、そうすれば、その位は正義によって堅く立つ。"},{"ref":"Prov.25.6","start":20025006,"end":20025006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"おう"],[2,1,"まえ"],[4,1,"みずか"],[6,1,"たか"],[16,1,"えら"],[18,1,"ひと"],[20,1,"ば"],[22,1,"た"]],"text":"王の前で自ら高ぶってはならない、偉い人の場に立ってはならない。"},{"ref":"Prov.25.7","start":20025007,"end":20025007,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"たっと"],[2,1,"ひと"],[4,1,"まえ"],[6,1,"した"],[21,1,"あ"]],"text":"尊い人の前で下にさげられるよりは、「ここに上がれ」といわれるほうがましだ。"},{"ref":"Prov.25.8","start":20025008,"end":20025008,"break":"line","breaks":[[12,"line"],[28,"line"],[53,"line"]],"ruby":[[4,1,"め"],[6,1,"み"],[12,2,"かるがる"],[16,2,"ほうてい"],[19,1,"だ"],[38,1,"とな"],[40,1,"びと"]],"text":"あなたが目に見たことを、軽々しく法廷に出してはならない。あとになり、あなたが隣り人にはずかしめられるとき、あなたはどうしようとするのか。"},{"ref":"Prov.25.9","start":20025009,"end":20025009,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"とな"],[2,1,"びと"],[4,1,"あらそ"],[19,1,"ひと"],[21,1,"あらそ"],[24,2,"たにん"],[27,2,"ひみつ"]],"text":"隣り人と争うことがあるならば、ただその人と争え、他人の秘密をもらしてはならない。"},{"ref":"Prov.25.10","start":20025010,"end":20025010,"break":"line","breaks":[[20,"line"]],"ruby":[[7,1,"き"],[9,1,"もの"]],"text":"そうでないと、聞く者があなたをいやしめ、あなたは、いつまでもそしられる。"},{"ref":"Prov.25.11","start":20025011,"end":20025011,"break":"stanza","breaks":[[13,"line"]],"ruby":[[7,1,"かた"],[9,2,"ことば"],[13,1,"ぎん"],[15,1,"ほ"],[17,1,"もの"],[19,1,"きん"]],"text":"おりにかなって語る言葉は、銀の彫り物に金のりんごをはめたようだ。"},{"ref":"Prov.25.12","start":20025012,"end":20025012,"break":"line","breaks":[[25,"line"]],"ruby":[[0,2,"ちえ"],[6,1,"いまし"],[9,1,"もの"],[17,1,"もの"],[19,1,"みみ"],[25,1,"きん"],[27,2,"みみわ"],[30,1,"せい"],[31,1,"きん"],[33,1,"かざ"]],"text":"知恵をもって戒める者は、これをきく者の耳にとって、金の耳輪、精金の飾りのようだ。"},{"ref":"Prov.25.13","start":20025013,"end":20025013,"break":"line","breaks":[[19,"line"],[37,"line"]],"ruby":[[0,2,"ちゅうじつ"],[3,2,"ししゃ"],[13,1,"もの"],[19,2,"かりい"],[23,1,"ひ"],[25,1,"ひや"],[29,1,"ゆき"],[41,2,"しゅじん"],[44,1,"こころ"],[46,1,"よろこ"]],"text":"忠実な使者はこれをつかわす者にとって、刈入れの日に冷やかな雪があるようだ、よくその主人の心を喜ばせる。"},{"ref":"Prov.25.14","start":20025014,"end":20025014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おく"],[2,1,"もの"],[7,1,"いつわ"],[10,1,"ほこ"],[12,1,"ひと"],[15,1,"あめ"],[19,1,"くも"],[21,1,"かぜ"]],"text":"贈り物をすると偽って誇る人は、雨のない雲と風のようだ。"},{"ref":"Prov.25.15","start":20025015,"end":20025015,"break":"stanza","breaks":[[18,"line"]],"ruby":[[0,2,"にんたい"],[6,1,"と"],[9,1,"きみ"],[11,2,"ことば"],[18,1,"やわ"],[22,1,"した"],[24,1,"ほね"],[26,1,"くだ"]],"text":"忍耐をもって説けば君も言葉をいれる、柔らかな舌は骨を砕く。"},{"ref":"Prov.25.16","start":20025016,"end":20025016,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"みつ"],[2,1,"え"],[10,1,"た"],[18,1,"た"],[27,1,"た"],[37,1,"は"],[39,1,"だ"]],"text":"蜜を得たならば、ただ足るほどにこれを食べよ、おそらくは食べすごして、それを吐き出すであろう。"},{"ref":"Prov.25.17","start":20025017,"end":20025017,"break":"line","breaks":[[19,"line"],[34,"line"]],"ruby":[[0,1,"とな"],[2,1,"びと"],[4,1,"いえ"],[6,1,"あし"],[24,1,"かれ"],[26,1,"わずら"],[38,1,"にく"]],"text":"隣り人の家に足をしげくしてはならない、おそらくは彼は煩わしくなって、あなたを憎むようになろう。"},{"ref":"Prov.25.18","start":20025018,"end":20025018,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"とな"],[2,1,"びと"],[4,1,"てき"],[7,1,"いつわ"],[14,1,"た"],[17,1,"ひと"],[22,1,"ぼう"],[31,1,"するど"],[33,1,"や"]],"text":"隣り人に敵して偽りのあかしを立てる人は、こん棒、つるぎ、または鋭い矢のようだ。"},{"ref":"Prov.25.19","start":20025019,"end":20025019,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"なや"],[3,1,"あ"],[7,3,"ふしんじつ"],[11,1,"もの"],[13,1,"たの"],[21,1,"わる"],[23,1,"は"],[31,1,"あし"],[33,1,"たの"]],"text":"悩みに会うとき不信実な者を頼みにするのは、悪い歯、またはなえた足を頼みとするようなものだ。"},{"ref":"Prov.25.20","start":20025020,"end":20025020,"break":"line","breaks":[[17,"line"],[32,"line"]],"ruby":[[0,1,"こころ"],[2,1,"いた"],[5,1,"ひと"],[7,1,"まえ"],[9,1,"うた"],[17,1,"さむ"],[19,1,"ひ"],[21,2,"きもの"],[24,1,"ぬ"],[34,1,"きず"],[36,1,"うえ"],[38,1,"す"]],"text":"心の痛める人の前で歌をうたうのは、寒い日に着物を脱ぐようであり、また傷の上に酢をそそぐようだ。"},{"ref":"Prov.25.21","start":20025021,"end":20025021,"break":"line","breaks":[[18,"line"],[29,"line"]],"ruby":[[9,1,"う"],[21,1,"あた"],[24,1,"た"],[40,1,"みず"],[42,1,"あた"],[45,1,"の"]],"text":"もしあなたのあだが飢えているならば、パンを与えて食べさせ、もしかわいているならば水を与えて飲ませよ。"},{"ref":"Prov.25.22","start":20025022,"end":20025022,"break":"line","breaks":[[22,"line"]],"ruby":[[7,1,"ひ"],[9,1,"かれ"],[15,1,"つ"],[22,1,"しゅ"],[28,1,"むく"]],"text":"こうするのは、火を彼のこうべに積むのである、主はあなたに報いられる。"},{"ref":"Prov.25.23","start":20025023,"end":20025023,"break":"line","breaks":[[8,"line"]],"ruby":[[0,2,"きたかぜ"],[3,1,"あめ"],[5,1,"おこ"],[8,2,"かげごと"],[13,1,"した"],[15,1,"ひと"],[17,1,"かお"],[19,1,"いか"]],"text":"北風は雨を起し、陰言をいう舌は人の顔を怒らす。"},{"ref":"Prov.25.24","start":20025024,"end":20025024,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あらそ"],[3,1,"この"],[5,1,"おんな"],[7,2,"いっしょ"],[10,1,"いえ"],[18,2,"やね"]],"text":"争いを好む女と一緒に家におるよりは、屋根のすみにおるほうがよい。"},{"ref":"Prov.25.25","start":20025025,"end":20025025,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"とお"],[2,1,"くに"],[5,1,"く"],[9,2,"しょうそく"],[19,1,"ひと"],[21,1,"の"],[23,1,"ひや"],[27,1,"みず"]],"text":"遠い国から来るよい消息は、かわいている人が飲む冷やかな水のようだ。"},{"ref":"Prov.25.26","start":20025026,"end":20025026,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"わる"],[7,1,"もの"],[9,1,"まえ"],[11,2,"くっぷく"],[18,2,"いど"],[21,1,"にご"],[29,1,"いずみ"]],"text":"正しい者が悪い者の前に屈服するのは、井戸が濁ったよう、また泉がよごれたようなものだ。"},{"ref":"Prov.25.27","start":20025027,"end":20025027,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"みつ"],[2,1,"おお"],[4,1,"た"],[17,2,"ことば"],[20,1,"ひか"],[22,1,"め"]],"text":"蜜を多く食べるのはよくない、ほめる言葉は控え目にするがよい。"},{"ref":"Prov.25.28","start":20025028,"end":20025028,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"じぶん"],[3,1,"こころ"],[5,1,"せい"],[9,1,"ひと"],[12,2,"じょうへき"],[17,1,"やぶ"],[20,1,"しろ"]],"text":"自分の心を制しない人は、城壁のない破れた城のようだ。"}]