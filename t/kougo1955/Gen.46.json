[{"ref":"Gen.46.1","start":1046001,"end":1046001,"break":"paragraph","ruby":[[8,1,"も"],[10,1,"もの"],[17,1,"たずさ"],[20,2,"たびだ"],[30,1,"い"],[34,1,"ちち"],[39,1,"かみ"],[41,2,"ぎせい"]],"text":"イスラエルはその持ち物をことごとく携えて旅立ち、ベエルシバに行って、父イサクの神に犠牲をささげた。"},{"ref":"Gen.46.2","start":1046002,"end":1046002,"break":"none","ruby":[[2,1,"とき"],[4,1,"かみ"],[6,1,"よ"],[8,1,"まぼろし"],[19,1,"かた"],[22,1,"い"],[39,1,"かれ"],[41,1,"い"]],"text":"この時、神は夜の幻のうちにイスラエルに語って言われた、「ヤコブよ、ヤコブよ」。彼は言った、「ここにいます」。"},{"ref":"Gen.46.3","start":1046003,"end":1046003,"break":"none","ruby":[[0,1,"かみ"],[2,1,"い"],[12,1,"かみ"],[18,1,"ちち"],[20,1,"かみ"],[30,1,"くだ"],[34,1,"おそ"],[55,1,"おお"],[59,2,"こくみん"]],"text":"神は言われた、「わたしは神、あなたの父の神である。エジプトに下るのを恐れてはならない。わたしはあそこであなたを大いなる国民にする。"},{"ref":"Gen.46.4","start":1046004,"end":1046004,"break":"none","ruby":[[8,2,"いっしょ"],[16,1,"くだ"],[21,1,"かなら"],[27,1,"みちび"],[29,1,"のぼ"],[40,1,"て"],[48,1,"め"],[50,1,"と"]],"text":"わたしはあなたと一緒にエジプトに下り、また必ずあなたを導き上るであろう。ヨセフが手ずからあなたの目を閉じるであろう」。"},{"ref":"Gen.46.5","start":1046005,"end":1046005,"break":"none","ruby":[[13,1,"た"],[23,1,"こ"],[30,1,"の"],[39,1,"おく"],[42,1,"くるま"],[45,1,"ちち"],[50,1,"おさ"],[52,1,"こ"],[56,1,"つま"],[60,1,"の"]],"text":"そしてヤコブはベエルシバを立った。イスラエルの子らはヤコブを乗せるためにパロの送った車に、父ヤコブと幼な子たちと妻たちを乗せ、"},{"ref":"Gen.46.6","start":1046006,"end":1046006,"break":"none","ruby":[[4,2,"かちく"],[11,1,"ち"],[13,1,"え"],[15,2,"ざいさん"],[18,1,"たずさ"],[27,2,"しそん"],[30,1,"みな"],[39,1,"い"]],"text":"またその家畜とカナンの地で得た財産を携え、ヤコブとその子孫は皆ともにエジプトへ行った。"},{"ref":"Gen.46.7","start":1046007,"end":1046007,"break":"none","ruby":[[10,1,"こ"],[13,1,"まご"],[17,1,"むすめ"],[19,2,"まごむすめ"],[25,2,"しそん"],[30,1,"つ"],[39,1,"い"]],"text":"こうしてヤコブはその子と、孫および娘と孫娘などその子孫をみな連れて、エジプトへ行った。"},{"ref":"Gen.46.8","start":1046008,"end":1046008,"break":"paragraph","ruby":[[6,1,"こ"],[14,1,"い"],[17,1,"もの"],[19,1,"な"],[21,1,"つぎ"],[40,1,"こ"],[51,2,"ちょうし"]],"text":"イスラエルの子らでエジプトへ行った者の名は次のとおりである。すなわちヤコブとその子らであるが、ヤコブの長子はルベン。"},{"ref":"Gen.46.9","start":1046009,"end":1046009,"break":"none","ruby":[[4,1,"こ"]],"text":"ルベンの子らはハノク、パル、ヘヅロン、カルミ。"},{"ref":"Gen.46.10","start":1046010,"end":1046010,"break":"none","ruby":[[5,1,"こ"],[28,1,"およ"],[34,1,"おんな"],[36,1,"う"],[39,1,"こ"]],"text":"シメオンの子らはエムエル、ヤミン、オハデ、ヤキン、ゾハル及びカナンの女の産んだ子シャウル。"},{"ref":"Gen.46.11","start":1046011,"end":1046011,"break":"none","ruby":[[3,1,"こ"]],"text":"レビの子らはゲルション、コハテ、メラリ。"},{"ref":"Gen.46.12","start":1046012,"end":1046012,"break":"none","ruby":[[3,1,"こ"],[34,1,"ち"],[36,1,"し"],[44,1,"こ"]],"text":"ユダの子らはエル、オナン、シラ、ペレヅ、ゼラ。エルとオナンはカナンの地で死んだ。ペレヅの子らはヘヅロンとハムル。"},{"ref":"Gen.46.13","start":1046013,"end":1046013,"break":"none","ruby":[[6,1,"こ"]],"text":"イッサカルの子らはトラ、プワ、ヨブ、シムロン。"},{"ref":"Gen.46.14","start":1046014,"end":1046014,"break":"none","ruby":[[5,1,"こ"]],"text":"ゼブルンの子らはセレデ、エロン、ヤリエル。"},{"ref":"Gen.46.15","start":1046015,"end":1046015,"break":"none","ruby":[[4,1,"むすめ"],[23,1,"う"],[26,1,"こ"],[34,1,"こ"],[37,1,"むすめ"],[40,1,"あ"],[47,1,"にん"]],"text":"これらと娘デナとはレアがパダンアラムでヤコブに産んだ子らである。その子らと娘らは合わせて三十三人。"},{"ref":"Gen.46.16","start":1046016,"end":1046016,"break":"none","ruby":[[3,1,"こ"]],"text":"ガドの子らはゼポン、ハギ、シュニ、エヅボン、エリ、アロデ、アレリ。"},{"ref":"Gen.46.17","start":1046017,"end":1046017,"break":"none","ruby":[[4,1,"こ"],[25,1,"いもうと"],[33,1,"こ"]],"text":"アセルの子らはエムナ、イシワ、イスイ、ベリアおよび妹サラ。ベリアの子らはヘベルとマルキエル。"},{"ref":"Gen.46.18","start":1046018,"end":1046018,"break":"none","ruby":[[8,1,"むすめ"],[12,1,"あた"],[19,1,"こ"],[25,2,"かのじょ"],[36,1,"う"],[40,1,"あ"],[46,1,"にん"]],"text":"これらはラバンが娘レアに与えたジルパの子らである。彼女はこれらをヤコブに産んだ。合わせて十六人。"},{"ref":"Gen.46.19","start":1046019,"end":1046019,"break":"none","ruby":[[4,1,"つま"],[9,1,"こ"]],"text":"ヤコブの妻ラケルの子らはヨセフとベニヤミンとである。"},{"ref":"Gen.46.20","start":1046020,"end":1046020,"break":"none","ruby":[[5,1,"くに"],[22,1,"うま"],[32,2,"さいし"],[39,1,"むすめ"],[45,1,"かれ"],[47,1,"う"],[50,1,"もの"]],"text":"エジプトの国でヨセフにマナセとエフライムとが生れた。これはオンの祭司ポテペラの娘アセナテが彼に産んだ者である。"},{"ref":"Gen.46.21","start":1046021,"end":1046021,"break":"none","ruby":[[6,1,"こ"]],"text":"ベニヤミンの子らはベラ、ベケル、アシベル、ゲラ、ナアマン、エヒ、ロシ、ムッピム、ホパム、アルデ。"},{"ref":"Gen.46.22","start":1046022,"end":1046022,"break":"none","ruby":[[12,1,"う"],[15,1,"こ"],[21,1,"あ"],[27,1,"にん"]],"text":"これらはラケルがヤコブに産んだ子らである。合わせて十四人。"},{"ref":"Gen.46.23","start":1046023,"end":1046023,"break":"none","ruby":[[3,1,"こ"]],"text":"ダンの子はホシム。"},{"ref":"Gen.46.24","start":1046024,"end":1046024,"break":"none","ruby":[[5,1,"こ"]],"text":"ナフタリの子らはヤジエル、グニ、エゼル、シレム。"},{"ref":"Gen.46.25","start":1046025,"end":1046025,"break":"none","ruby":[[8,1,"むすめ"],[13,1,"あた"],[20,1,"こ"],[26,2,"かのじょ"],[37,1,"う"],[41,1,"あ"],[46,1,"にん"]],"text":"これらはラバンが娘ラケルに与えたビルハの子らである。彼女はこれらをヤコブに産んだ。合わせて七人。"},{"ref":"Gen.46.26","start":1046026,"end":1046026,"break":"none","ruby":[[4,1,"とも"],[11,1,"い"],[18,1,"もの"],[24,1,"かれ"],[26,1,"み"],[29,1,"で"],[31,1,"もの"],[37,1,"こ"],[40,1,"つま"],[47,1,"あ"],[54,1,"にん"]],"text":"ヤコブと共にエジプトへ行ったすべての者、すなわち彼の身から出た者はヤコブの子らの妻をのぞいて、合わせて六十六人であった。"},{"ref":"Gen.46.27","start":1046027,"end":1046027,"break":"none","ruby":[[9,1,"うま"],[12,1,"こ"],[26,1,"い"],[33,1,"いえ"],[35,1,"もの"],[37,1,"あ"],[43,1,"にん"]],"text":"エジプトでヨセフに生れた子がふたりあった。エジプトへ行ったヤコブの家の者は合わせて七十人であった。"},{"ref":"Gen.46.28","start":1046028,"end":1046028,"break":"paragraph","ruby":[[26,1,"あ"],[30,1,"い"],[38,1,"かれ"],[45,1,"ち"],[47,1,"い"]],"text":"さてヤコブはユダをさきにヨセフにつかわして、ゴセンで会おうと言わせた。そして彼らはゴセンの地へ行った。"},{"ref":"Gen.46.29","start":1046029,"end":1046029,"break":"none","ruby":[[4,1,"くるま"],[6,1,"ととの"],[10,1,"ちち"],[17,1,"むか"],[27,1,"のぼ"],[30,1,"ちち"],[32,1,"あ"],[40,1,"だ"],[50,1,"ひさ"],[53,1,"な"]],"text":"ヨセフは車を整えて、父イスラエルを迎えるためにゴセンに上り、父に会い、そのくびを抱き、くびをかかえて久しく泣いた。"},{"ref":"Gen.46.30","start":1046030,"end":1046030,"break":"none","ruby":[[0,1,"とき"],[13,1,"い"],[24,1,"い"],[38,1,"かお"],[40,1,"み"],[44,1,"いま"],[46,1,"し"]],"text":"時に、イスラエルはヨセフに言った、「あなたがなお生きていて、わたしはあなたの顔を見たので今は死んでもよい」。"},{"ref":"Gen.46.31","start":1046031,"end":1046031,"break":"none","ruby":[[4,2,"きょうだい"],[9,1,"ちち"],[11,2,"かぞく"],[15,1,"い"],[24,1,"のぼ"],[30,1,"い"],[39,1,"ち"],[47,2,"きょうだい"],[52,1,"ちち"],[54,2,"かぞく"],[62,1,"ところ"]],"text":"ヨセフは兄弟たちと父の家族とに言った、「わたしは上ってパロに言おう、『カナンの地にいたわたしの兄弟たちと父の家族とがわたしの所へきました。"},{"ref":"Gen.46.32","start":1046032,"end":1046032,"break":"none","ruby":[[2,1,"もの"],[5,1,"ひつじ"],[7,1,"か"],[9,1,"もの"],[11,2,"かちく"],[14,2,"ぼくしゃ"],[20,1,"ひつじ"],[22,1,"うし"],[26,1,"も"],[28,1,"もの"],[32,1,"たずさ"]],"text":"この者らは羊を飼う者、家畜の牧者で、その羊、牛および持ち物をみな携えてきました』。"},{"ref":"Gen.46.33","start":1046033,"end":1046033,"break":"none","ruby":[[11,1,"め"],[22,2,"しょくぎょう"],[25,1,"なに"],[29,1,"い"]],"text":"もしパロがあなたがたを召して、『あなたがたの職業は何か』と言われたら、"},{"ref":"Gen.46.34","start":1046034,"end":1046034,"break":"none","ruby":[[6,1,"おさな"],[8,1,"とき"],[15,2,"かちく"],[18,2,"ぼくしゃ"],[34,2,"せんぞ"],[43,1,"い"],[64,1,"ち"],[66,1,"す"],[78,2,"ひつじかい"],[92,1,"い"],[94,1,"もの"]],"text":"『しもべらは幼い時から、ずっと家畜の牧者です。われわれも、われわれの先祖もそうです』と言いなさい。そうすればあなたがたはゴセンの地に住むことができましょう。羊飼はすべて、エジプトびとの忌む者だからです」。"}]