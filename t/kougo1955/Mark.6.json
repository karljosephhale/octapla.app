[{"ref":"Mark.6.1","start":41006001,"end":41006001,"break":"paragraph","ruby":[[7,1,"さ"],[11,2,"きょうり"],[14,1,"い"],[20,2,"でし"],[25,1,"したが"],[28,1,"い"]],"text":"イエスはそこを去って、郷里に行かれたが、弟子たちも従って行った。"},{"ref":"Mark.6.2","start":41006002,"end":41006002,"break":"none","ruby":[[4,3,"あんそくにち"],[14,2,"かいどう"],[17,1,"おし"],[29,1,"き"],[32,1,"おお"],[35,2,"ひとびと"],[39,1,"おどろ"],[42,1,"い"],[49,1,"ひと"],[62,1,"なら"],[75,1,"ひと"],[77,1,"さず"],[81,2,"ちえ"],[95,1,"ちから"],[103,1,"て"],[105,1,"おこな"]],"text":"そして、安息日になったので、会堂で教えはじめられた。それを聞いた多くの人々は、驚いて言った、「この人は、これらのことをどこで習ってきたのか。また、この人の授かった知恵はどうだろう。このような力あるわざがその手で行われているのは、どうしてか。"},{"ref":"Mark.6.3","start":41006003,"end":41006003,"break":"none","ruby":[[2,1,"ひと"],[4,2,"だいく"],[35,2,"きょうだい"],[47,2,"しまい"],[62,2,"いっしょ"],[78,1,"かれ"]],"text":"この人は大工ではないか。マリヤのむすこで、ヤコブ、ヨセ、ユダ、シモンの兄弟ではないか。またその姉妹たちも、ここにわたしたちと一緒にいるではないか」。こうして彼らはイエスにつまずいた。"},{"ref":"Mark.6.4","start":41006004,"end":41006004,"break":"none","ruby":[[4,1,"い"],[10,3,"よげんしゃ"],[15,2,"じぶん"],[18,2,"きょうり"],[21,2,"しんぞく"],[24,1,"いえ"],[25,2,"いがい"],[35,1,"うやま"]],"text":"イエスは言われた、「預言者は、自分の郷里、親族、家以外では、どこででも敬われないことはない」。"},{"ref":"Mark.6.5","start":41006005,"end":41006005,"break":"none","ruby":[[8,1,"ちから"],[28,2,"しょうすう"],[31,2,"びょうにん"],[34,1,"て"]],"text":"そして、そこでは力あるわざを一つもすることができず、ただ少数の病人に手をおいていやされただけであった。"},{"ref":"Mark.6.6","start":41006006,"end":41006006,"break":"none","breaks":[[19,"paragraph"]],"ruby":[[4,1,"かれ"],[7,1,"ふ"],[8,2,"しんこう"],[11,1,"おどろ"],[13,1,"あや"],[28,2,"ふきん"],[31,2,"むらむら"],[34,1,"めぐ"],[40,1,"おし"]],"text":"そして、彼らの不信仰を驚き怪しまれた。それからイエスは、附近の村々を巡りあるいて教えられた。"},{"ref":"Mark.6.7","start":41006007,"end":41006007,"break":"none","ruby":[[4,2,"でし"],[7,1,"よ"],[9,1,"よ"],[27,1,"かれ"],[34,1,"れい"],[36,1,"せい"],[39,2,"けんい"],[42,1,"あた"]],"text":"また十二弟子を呼び寄せ、ふたりずつつかわすことにして、彼らにけがれた霊を制する権威を与え、"},{"ref":"Mark.6.8","start":41006008,"end":41006008,"break":"none","ruby":[[2,1,"たび"],[11,1,"ぽん"],[17,1,"なに"],[19,1,"も"],[31,1,"ぶくろ"],[34,1,"おび"],[36,1,"なか"],[38,1,"ぜに"],[40,1,"も"]],"text":"また旅のために、つえ一本のほかには何も持たないように、パンも、袋も、帯の中に銭も持たず、"},{"ref":"Mark.6.9","start":41006009,"end":41006009,"break":"none","ruby":[[12,2,"したぎ"],[16,1,"まい"],[18,1,"き"],[24,1,"めい"]],"text":"ただわらじをはくだけで、下着も二枚は着ないように命じられた。"},{"ref":"Mark.6.10","start":41006010,"end":41006010,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[15,1,"い"],[20,1,"いえ"],[31,2,"とち"],[34,1,"さ"]],"text":"そして彼らに言われた、「どこへ行っても、家にはいったなら、その土地を去るまでは、そこにとどまっていなさい。"},{"ref":"Mark.6.11","start":41006011,"end":41006011,"break":"none","ruby":[[9,1,"むか"],[19,1,"はなし"],[21,1,"き"],[27,1,"ところ"],[39,1,"で"],[41,1,"い"],[46,1,"かれ"],[49,1,"たい"],[52,2,"こうぎ"],[60,1,"あし"],[62,1,"うら"],[67,1,"はら"],[69,1,"おと"]],"text":"また、あなたがたを迎えず、あなたがたの話を聞きもしない所があったなら、そこから出て行くとき、彼らに対する抗議のしるしに、足の裏のちりを払い落しなさい」。"},{"ref":"Mark.6.12","start":41006012,"end":41006012,"break":"none","ruby":[[4,1,"かれ"],[7,1,"で"],[9,1,"い"],[13,2,"くいあらた"],[17,1,"の"],[19,1,"つた"]],"text":"そこで、彼らは出て行って、悔改めを宣べ伝え、"},{"ref":"Mark.6.13","start":41006013,"end":41006013,"break":"none","ruby":[[0,1,"おお"],[3,2,"あくれい"],[6,1,"お"],[8,1,"だ"],[11,1,"おお"],[15,2,"びょうにん"],[18,1,"あぶら"]],"text":"多くの悪霊を追い出し、大ぜいの病人に油をぬっていやした。"},{"ref":"Mark.6.14","start":41006014,"end":41006014,"break":"paragraph","ruby":[[7,1,"な"],[9,1,"し"],[19,1,"おう"],[21,1,"みみ"],[30,2,"ひとびと"],[45,2,"しにん"],[48,1,"なか"],[71,1,"ちから"],[73,1,"かれ"],[78,1,"はたら"],[87,1,"い"]],"text":"さて、イエスの名が知れわたって、ヘロデ王の耳にはいった。ある人々は「バプテスマのヨハネが、死人の中からよみがえってきたのだ。それで、あのような力が彼のうちに働いているのだ」と言い、"},{"ref":"Mark.6.15","start":41006015,"end":41006015,"break":"none","ruby":[[0,1,"た"],[2,2,"ひとびと"],[6,1,"かれ"],[14,1,"い"],[19,1,"た"],[21,2,"ひとびと"],[25,1,"むかし"],[27,3,"よげんしゃ"],[34,3,"よげんしゃ"],[40,1,"い"]],"text":"他の人々は「彼はエリヤだ」と言い、また他の人々は「昔の預言者のような預言者だ」と言った。"},{"ref":"Mark.6.16","start":41006016,"end":41006016,"break":"none","ruby":[[12,1,"き"],[21,1,"くび"],[23,1,"き"],[42,1,"い"]],"text":"ところが、ヘロデはこれを聞いて、「わたしが首を切ったあのヨハネがよみがえったのだ」と言った。"},{"ref":"Mark.6.17","start":41006017,"end":41006017,"break":"none","ruby":[[7,2,"じぶん"],[10,2,"きょうだい"],[16,1,"つま"],[34,1,"ひと"],[45,1,"とら"],[48,1,"ごく"]],"text":"このヘロデは、自分の兄弟ピリポの妻ヘロデヤをめとったが、そのことで、人をつかわし、ヨハネを捕えて獄につないだ。"},{"ref":"Mark.6.18","start":41006018,"end":41006018,"break":"none","ruby":[[14,2,"きょうだい"],[17,1,"つま"],[33,1,"い"]],"text":"それは、ヨハネがヘロデに、「兄弟の妻をめとるのは、よろしくない」と言ったからである。"},{"ref":"Mark.6.19","start":41006019,"end":41006019,"break":"none","ruby":[[13,1,"うら"],[16,1,"かれ"],[18,1,"ころ"],[22,1,"おも"]],"text":"そこで、ヘロデヤはヨハネを恨み、彼を殺そうと思っていたが、できないでいた。"},{"ref":"Mark.6.20","start":41006020,"end":41006020,"break":"none","ruby":[[12,1,"ただ"],[16,1,"せい"],[19,1,"ひと"],[26,1,"し"],[30,1,"かれ"],[32,1,"おそ"],[35,1,"かれ"],[37,2,"ほご"],[40,1,"くわ"],[47,1,"おしえ"],[49,1,"き"],[52,2,"ひじょう"],[55,1,"なや"],[64,1,"よろこ"],[67,1,"き"]],"text":"それはヘロデが、ヨハネは正しくて聖なる人であることを知って、彼を恐れ、彼に保護を加え、またその教を聞いて非常に悩みながらも、なお喜んで聞いていたからである。"},{"ref":"Mark.6.21","start":41006021,"end":41006021,"break":"none","ruby":[[7,2,"きかい"],[17,2,"じぶん"],[20,2,"たんじょう"],[22,1,"ひ"],[24,1,"いわい"],[27,2,"こうかん"],[30,2,"しょうこう"],[38,2,"おもだ"],[42,1,"ひと"],[46,1,"まね"],[49,2,"えんかい"],[52,1,"もよお"]],"text":"ところが、よい機会がきた。ヘロデは自分の誕生日の祝に、高官や将校やガリラヤの重立った人たちを招いて宴会を催したが、"},{"ref":"Mark.6.22","start":41006022,"end":41006022,"break":"none","ruby":[[11,1,"むすめ"],[19,1,"まい"],[31,2,"れつざ"],[34,1,"ひと"],[38,1,"よろこ"],[46,1,"おう"],[50,2,"しょうじょ"],[64,1,"い"],[81,1,"い"]],"text":"そこへ、このヘロデヤの娘がはいってきて舞をまい、ヘロデをはじめ列座の人たちを喜ばせた。そこで王はこの少女に「ほしいものはなんでも言いなさい。あなたにあげるから」と言い、"},{"ref":"Mark.6.23","start":41006023,"end":41006023,"break":"none","ruby":[[12,1,"くに"],[14,2,"はんぶん"],[24,1,"ちか"],[27,1,"い"]],"text":"さらに「ほしければ、この国の半分でもあげよう」と誓って言った。"},{"ref":"Mark.6.24","start":41006024,"end":41006024,"break":"none","ruby":[[3,2,"しょうじょ"],[6,1,"ざ"],[13,1,"はは"],[16,1,"なに"],[19,1,"ねが"],[29,1,"たず"],[34,1,"はは"],[47,1,"くび"],[51,1,"こた"]],"text":"そこで少女は座をはずして、母に「何をお願いしましょうか」と尋ねると、母は「バプテスマのヨハネの首を」と答えた。"},{"ref":"Mark.6.25","start":41006025,"end":41006025,"break":"none","ruby":[[6,2,"しょうじょ"],[9,1,"いそ"],[12,1,"おう"],[18,1,"い"],[21,1,"ねが"],[26,1,"いま"],[41,1,"くび"],[43,1,"ぼん"]],"text":"するとすぐ、少女は急いで王のところに行って願った、「今すぐに、バプテスマのヨハネの首を盆にのせて、それをいただきとうございます」。"},{"ref":"Mark.6.26","start":41006026,"end":41006026,"break":"none","ruby":[[0,1,"おう"],[2,2,"ひじょう"],[5,1,"こま"],[14,1,"ちか"],[22,2,"れつざ"],[25,1,"ひと"],[29,2,"てまえ"],[32,2,"しょうじょ"],[35,1,"ねが"],[38,1,"しりぞ"],[44,1,"この"]],"text":"王は非常に困ったが、いったん誓ったのと、また列座の人たちの手前、少女の願いを退けることを好まなかった。"},{"ref":"Mark.6.27","start":41006027,"end":41006027,"break":"none","ruby":[[4,1,"おう"],[9,2,"えいへい"],[21,1,"くび"],[23,1,"も"],[26,1,"く"],[31,1,"めい"],[35,2,"えいへい"],[38,1,"で"],[40,1,"い"],[43,2,"ごくちゅう"],[50,1,"くび"],[52,1,"き"]],"text":"そこで、王はすぐに衛兵をつかわし、ヨハネの首を持って来るように命じた。衛兵は出て行き、獄中でヨハネの首を切り、"},{"ref":"Mark.6.28","start":41006028,"end":41006028,"break":"none","ruby":[[0,1,"ぼん"],[5,1,"も"],[10,2,"しょうじょ"],[13,1,"あた"],[16,2,"しょうじょ"],[22,1,"はは"]],"text":"盆にのせて持ってきて少女に与え、少女はそれを母にわたした。"},{"ref":"Mark.6.29","start":41006029,"end":41006029,"break":"none","ruby":[[4,2,"でし"],[14,1,"き"],[19,2,"したい"],[22,1,"ひ"],[24,1,"と"],[30,1,"はか"],[32,1,"おさ"]],"text":"ヨハネの弟子たちはこのことを聞き、その死体を引き取りにきて、墓に納めた。"},{"ref":"Mark.6.30","start":41006030,"end":41006030,"break":"paragraph","ruby":[[3,2,"しと"],[15,1,"あつ"],[22,2,"じぶん"],[32,1,"おし"],[41,2,"ほうこく"]],"text":"さて、使徒たちはイエスのもとに集まってきて、自分たちがしたことや教えたことを、みな報告した。"},{"ref":"Mark.6.31","start":41006031,"end":41006031,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[26,1,"ひと"],[28,1,"さ"],[31,1,"さび"],[34,1,"ところ"],[36,1,"い"],[44,1,"やす"],[55,2,"でい"],[60,1,"ひと"],[62,1,"おお"],[66,2,"しょくじ"],[71,1,"ひま"]],"text":"するとイエスは彼らに言われた、「さあ、あなたがたは、人を避けて寂しい所へ行って、しばらく休むがよい」。それは、出入りする人が多くて、食事をする暇もなかったからである。"},{"ref":"Mark.6.32","start":41006032,"end":41006032,"break":"none","ruby":[[3,1,"かれ"],[6,1,"ひと"],[8,1,"さ"],[11,1,"ふね"],[13,1,"の"],[16,1,"さび"],[19,1,"ところ"],[21,1,"い"]],"text":"そこで彼らは人を避け、舟に乗って寂しい所へ行った。"},{"ref":"Mark.6.33","start":41006033,"end":41006033,"break":"none","ruby":[[5,1,"おお"],[8,2,"ひとびと"],[11,1,"かれ"],[14,1,"で"],[18,1,"い"],[22,1,"み"],[27,1,"き"],[32,2,"ほうぼう"],[35,2,"まちまち"],[47,1,"か"],[52,1,"かれ"],[56,1,"さき"],[58,1,"つ"]],"text":"ところが、多くの人々は彼らが出かけて行くのを見、それと気づいて、方々の町々からそこへ、一せいに駆けつけ、彼らより先に着いた。"},{"ref":"Mark.6.34","start":41006034,"end":41006034,"break":"none","ruby":[[4,1,"ふね"],[7,1,"あ"],[11,1,"おお"],[15,2,"ぐんしゅう"],[25,1,"か"],[27,1,"もの"],[31,1,"ひつじ"],[38,2,"ありさま"],[41,1,"ふか"],[54,1,"おし"]],"text":"イエスは舟から上がって大ぜいの群衆をごらんになり、飼う者のない羊のようなその有様を深くあわれんで、いろいろと教えはじめられた。"},{"ref":"Mark.6.35","start":41006035,"end":41006035,"break":"none","ruby":[[7,1,"とき"],[18,2,"でし"],[32,1,"い"],[40,1,"さび"],[43,1,"ところ"],[51,1,"とき"]],"text":"ところが、はや時もおそくなったので、弟子たちはイエスのもとにきて言った、「ここは寂しい所でもあり、もう時もおそくなりました。"},{"ref":"Mark.6.36","start":41006036,"end":41006036,"break":"none","ruby":[[4,2,"かいさん"],[14,1,"なに"],[16,1,"た"],[19,1,"もの"],[21,1,"か"],[29,2,"ぶらく"],[32,2,"むらむら"],[35,1,"い"]],"text":"みんなを解散させ、めいめいで何か食べる物を買いに、まわりの部落や村々へ行かせてください」。"},{"ref":"Mark.6.37","start":41006037,"end":41006037,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[19,1,"て"],[21,2,"しょくもつ"],[31,2,"でし"],[36,1,"い"],[57,1,"か"],[67,1,"た"]],"text":"イエスは答えて言われた、「あなたがたの手で食物をやりなさい」。弟子たちは言った、「わたしたちが二百デナリものパンを買ってきて、みんなに食べさせるのですか」。"},{"ref":"Mark.6.38","start":41006038,"end":41006038,"break":"none","ruby":[[7,1,"い"],[16,1,"いく"],[22,1,"み"],[30,1,"かれ"],[33,1,"たし"],[51,1,"うお"],[58,1,"い"]],"text":"するとイエスは言われた、「パンは幾つあるか。見てきなさい」。彼らは確かめてきて、「五つあります。それに魚が二ひき」と言った。"},{"ref":"Mark.6.39","start":41006039,"end":41006039,"break":"none","ruby":[[12,2,"くみぐみ"],[15,1,"わ"],[19,2,"あおくさ"],[22,1,"うえ"],[32,1,"めい"]],"text":"そこでイエスは、みんなを組々に分けて、青草の上にすわらせるように命じられた。"},{"ref":"Mark.6.40","start":41006040,"end":41006040,"break":"none","ruby":[[0,2,"ひとびと"],[9,1,"にん"],[19,1,"にん"],[23,1,"れつ"]],"text":"人々は、あるいは百人ずつ、あるいは五十人ずつ、列をつくってすわった。"},{"ref":"Mark.6.41","start":41006041,"end":41006041,"break":"none","ruby":[[19,1,"うお"],[22,1,"て"],[24,1,"と"],[27,1,"てん"],[29,1,"あお"],[35,2,"しゅくふく"],[45,2,"でし"],[54,1,"くば"],[65,1,"うお"],[72,1,"わ"]],"text":"それから、イエスは五つのパンと二ひきの魚とを手に取り、天を仰いでそれを祝福し、パンをさき、弟子たちにわたして配らせ、また、二ひきの魚もみんなにお分けになった。"},{"ref":"Mark.6.42","start":41006042,"end":41006042,"break":"none","ruby":[[4,1,"もの"],[6,1,"た"],[9,2,"まんぷく"]],"text":"みんなの者は食べて満腹した。"},{"ref":"Mark.6.43","start":41006043,"end":41006043,"break":"none","ruby":[[9,1,"うお"],[11,1,"のこ"],[14,1,"あつ"]],"text":"そこで、パンくずや魚の残りを集めると、十二のかごにいっぱいになった。"},{"ref":"Mark.6.44","start":41006044,"end":41006044,"break":"none","ruby":[[3,1,"た"],[6,1,"もの"],[8,1,"おとこ"],[11,1,"にん"]],"text":"パンを食べた者は男五千人であった。"},{"ref":"Mark.6.45","start":41006045,"end":41006045,"break":"paragraph","ruby":[[11,2,"じぶん"],[14,2,"ぐんしゅう"],[17,2,"かいさん"],[26,1,"あいだ"],[32,2,"でし"],[37,1,"ふね"],[39,1,"の"],[41,1,"こ"],[45,1,"む"],[48,1,"ぎし"],[56,1,"さき"]],"text":"それからすぐ、イエスは自分で群衆を解散させておられる間に、しいて弟子たちを舟に乗り込ませ、向こう岸のベツサイダへ先におやりになった。"},{"ref":"Mark.6.46","start":41006046,"end":41006046,"break":"none","ruby":[[3,2,"ぐんしゅう"],[6,1,"わか"],[12,1,"いの"],[17,1,"やま"],[19,1,"しりぞ"]],"text":"そして群衆に別れてから、祈るために山へ退かれた。"},{"ref":"Mark.6.47","start":41006047,"end":41006047,"break":"none","ruby":[[0,2,"ゆうがた"],[9,1,"ふね"],[11,1,"うみ"],[15,1,"なか"],[17,1,"で"],[28,2,"りくち"]],"text":"夕方になったとき、舟は海のまん中に出ており、イエスだけが陸地におられた。"},{"ref":"Mark.6.48","start":41006048,"end":41006048,"break":"none","ruby":[[4,2,"ぎゃくふう"],[7,1,"ふ"],[16,2,"でし"],[23,1,"なや"],[38,2,"よあ"],[43,1,"じ"],[47,1,"うみ"],[49,1,"うえ"],[51,1,"ある"],[54,1,"かれ"],[57,1,"ちか"],[66,1,"とお"],[68,1,"す"]],"text":"ところが逆風が吹いていたために、弟子たちがこぎ悩んでいるのをごらんになって、夜明けの四時ごろ、海の上を歩いて彼らに近づき、そのそばを通り過ぎようとされた。"},{"ref":"Mark.6.49","start":41006049,"end":41006049,"break":"none","ruby":[[0,1,"かれ"],[7,1,"うみ"],[9,1,"うえ"],[11,1,"ある"],[20,1,"み"],[23,2,"ゆうれい"],[27,1,"おも"],[30,2,"おおごえ"],[33,1,"さけ"]],"text":"彼らはイエスが海の上を歩いておられるのを見て、幽霊だと思い、大声で叫んだ。"},{"ref":"Mark.6.50","start":41006050,"end":41006050,"break":"none","ruby":[[4,1,"もの"],[9,1,"み"],[14,1,"おそ"],[33,1,"かれ"],[36,1,"こえ"],[58,1,"おそ"],[68,1,"い"]],"text":"みんなの者がそれを見て、おじ恐れたからである。しかし、イエスはすぐ彼らに声をかけ、「しっかりするのだ。わたしである。恐れることはない」と言われた。"},{"ref":"Mark.6.51","start":41006051,"end":41006051,"break":"none","ruby":[[4,1,"かれ"],[7,1,"ふね"],[9,1,"の"],[11,1,"こ"],[17,1,"かぜ"],[23,1,"かれ"],[26,1,"こころ"],[28,1,"なか"],[31,2,"ひじょう"],[34,1,"おどろ"]],"text":"そして、彼らの舟に乗り込まれると、風はやんだ。彼らは心の中で、非常に驚いた。"},{"ref":"Mark.6.52","start":41006052,"end":41006052,"break":"none","ruby":[[0,1,"さき"],[8,1,"さと"],[14,1,"こころ"],[16,1,"にぶ"]],"text":"先のパンのことを悟らず、その心が鈍くなっていたからである。"},{"ref":"Mark.6.53","start":41006053,"end":41006053,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"うみ"],[5,1,"わた"],[13,1,"ち"],[15,1,"つ"],[18,1,"ふね"]],"text":"彼らは海を渡り、ゲネサレの地に着いて舟をつないだ。"},{"ref":"Mark.6.54","start":41006054,"end":41006054,"break":"none","ruby":[[3,1,"ふね"],[11,2,"ひとびと"],[20,1,"し"]],"text":"そして舟からあがると、人々はすぐイエスと知って、"},{"ref":"Mark.6.55","start":41006055,"end":41006055,"break":"none","ruby":[[2,2,"ちほう"],[9,1,"か"],[24,1,"き"],[33,2,"びょうにん"],[36,1,"とこ"],[41,1,"はこ"]],"text":"その地方をあまねく駆けめぐり、イエスがおられると聞けば、どこへでも病人を床にのせて運びはじめた。"},{"ref":"Mark.6.56","start":41006056,"end":41006056,"break":"none","ruby":[[4,1,"むら"],[7,1,"まち"],[10,2,"ぶらく"],[23,1,"い"],[27,1,"ところ"],[31,2,"びょうにん"],[38,2,"ひろば"],[49,2,"うわぎ"],[75,1,"ねが"],[87,1,"もの"],[89,1,"みな"]],"text":"そして、村でも町でも部落でも、イエスがはいって行かれる所では、病人たちをその広場におき、せめてその上着のふさにでも、さわらせてやっていただきたいと、お願いした。そしてさわった者は皆いやされた。"}]