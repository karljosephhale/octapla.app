[{"ref":"Ezek.45.1","start":26045001,"end":26045001,"break":"paragraph","ruby":[[10,1,"ひ"],[13,1,"ち"],[15,1,"わ"],[22,2,"しょゆう"],[31,1,"ち"],[33,2,"いちぶ"],[36,1,"せい"],[39,2,"じしょ"],[44,1,"しゅ"],[53,1,"なが"],[65,1,"はば"],[77,2,"くいき"],[83,1,"せい"],[86,1,"ち"]],"text":"あなたがたは、くじを引き、地を分けて、それを所有するときには、地の一部を聖なる地所として主にささげよ。その長さは二万五千キュビト、幅は二万キュビトで、その区域はすべて聖なる地である。"},{"ref":"Ezek.45.2","start":26045002,"end":26045002,"break":"none","ruby":[[4,2,"せいじょ"],[7,1,"ぞく"],[13,2,"たてよこ"],[32,1,"かく"],[46,2,"くうち"],[51,2,"しゅうい"]],"text":"そのうち聖所に属するものは縦横五百キュビトずつであって、それは四角である。また五十キュビトの空地をその周囲につくれ。"},{"ref":"Ezek.45.3","start":26045003,"end":26045003,"break":"none","ruby":[[6,1,"せい"],[9,2,"じしょ"],[13,1,"なが"],[24,1,"はば"],[32,1,"はか"],[34,1,"と"],[39,1,"なか"],[41,2,"せいじょ"],[44,3,"しせいじょ"],[49,1,"もう"]],"text":"あなたはこの聖なる地所から長さ二万五千キュビト、幅一万キュビトを測り取り、その中に聖所と至聖所とを設けよ。"},{"ref":"Ezek.45.4","start":26045004,"end":26045004,"break":"none","ruby":[[3,1,"くに"],[5,1,"なか"],[7,1,"せい"],[10,1,"ところ"],[16,1,"しゅ"],[18,1,"ちか"],[20,1,"つか"],[23,2,"せいじょ"],[26,1,"つか"],[28,1,"びと"],[32,2,"さいし"],[35,1,"き"],[36,1,"ぞく"],[43,1,"かれ"],[50,1,"いえ"],[52,1,"た"],[55,1,"ところ"],[57,2,"せいじょ"],[64,2,"せいち"]],"text":"これは国の中で聖なる所であって、主に近く仕える聖所の仕え人である祭司に帰属する。これは彼らのためには家を建てる所、聖所のためには聖地となる。"},{"ref":"Ezek.45.5","start":26045005,"end":26045005,"break":"none","ruby":[[2,1,"なが"],[13,1,"はば"],[21,1,"べつ"],[23,2,"じしょ"],[27,1,"みや"],[29,1,"つか"],[37,2,"きぞく"],[41,1,"かれ"],[44,1,"す"],[46,1,"まち"],[51,2,"しょゆう"]],"text":"また長さ二万五千キュビト、幅一万キュビトの別の地所は、宮に仕えるレビびとに帰属し、彼らの住む町のための所有とする。"},{"ref":"Ezek.45.6","start":26045006,"end":26045006,"break":"paragraph","ruby":[[0,2,"せいち"],[5,2,"くべつ"],[9,2,"ぶぶん"],[12,1,"そ"],[15,1,"はば"],[23,1,"なが"],[35,1,"まち"],[37,2,"しょゆう"],[51,2,"ぜんか"]],"text":"聖地として区別した部分に沿い、幅五千キュビト、長さ二万五千キュビトは、町の所有とせよ。これはイスラエル全家のものとなる。"},{"ref":"Ezek.45.7","start":26045007,"end":26045007,"break":"paragraph","ruby":[[2,1,"きみ"],[5,1,"もの"],[7,1,"ぶん"],[12,2,"せいち"],[15,1,"まち"],[17,2,"しょゆう"],[19,1,"ち"],[37,2,"せいち"],[40,1,"まち"],[42,2,"しょゆう"],[44,1,"ち"],[46,1,"そ"],[49,1,"にし"],[51,1,"ひがし"],[53,1,"む"],[57,2,"ぶぞく"],[60,1,"ぶん"],[65,1,"おう"],[69,2,"じしょ"],[72,1,"にし"],[75,1,"ひがし"],[77,1,"さかい"],[79,1,"いた"]],"text":"また君たる者の分は、かの聖地と町の所有地との、こなたかなたにある。すなわち聖地と町の所有地に沿い、西と東に向かい、部族の分の一つに応じて、地所の西から東の境に至り、"},{"ref":"Ezek.45.8","start":26045008,"end":26045008,"break":"none","ruby":[[2,2,"しょゆう"],[5,2,"じしょ"],[14,1,"なか"],[23,1,"きみ"],[28,1,"かさ"],[35,1,"たみ"],[43,2,"ぶぞく"],[57,1,"いえ"],[59,2,"とち"],[62,1,"あた"]],"text":"その所有の地所はイスラエルの中にある。わたしの君たちは、重ねてわたしの民をしえたげず、部族にしたがってイスラエルの家に土地を与える。"},{"ref":"Ezek.45.9","start":26045009,"end":26045009,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[8,1,"い"],[19,1,"きみ"],[24,2,"ぼうぎゃく"],[27,2,"りゃくだつ"],[34,2,"こうどう"],[37,2,"せいぎ"],[40,1,"おこな"],[45,1,"たみ"],[47,1,"お"],[60,1,"しゅ"],[63,1,"かみ"],[65,1,"い"]],"text":"主なる神は、こう言われる、イスラエルの君たちよ、暴虐と略奪とをやめ、公道と正義を行え。わが民を追いたてることをやめよと、主なる神は言われる。"},{"ref":"Ezek.45.10","start":26045010,"end":26045010,"break":"paragraph","ruby":[[6,1,"ただ"],[13,1,"ただ"],[19,1,"ただ"],[25,1,"もち"]],"text":"あなたがたは正しいはかり、正しいエパ、正しいバテを用いよ。"},{"ref":"Ezek.45.11","start":26045011,"end":26045011,"break":"none","ruby":[[7,1,"どう"],[8,1,"りょう"],[25,1,"ぶん"],[39,1,"ぶん"],[55,1,"りょう"],[57,1,"さだ"]],"text":"エパとバテとは同量にせよ。すなわちバテをホメルの十分の一とし、エパもホメルの十分の一とし、すべてホメルによって量を定めよ。"},{"ref":"Ezek.45.12","start":26045012,"end":26045012,"break":"none","text":"一シケルは二十ゲラである。五シケルは五シケル、十シケルは十シケルとせよ。一ミナは五十シケルとせよ。"},{"ref":"Ezek.45.13","start":26045013,"end":26045013,"break":"paragraph","ruby":[[13,1,"もの"],[31,2,"こむぎ"],[39,1,"ぶん"],[49,2,"おおむぎ"],[61,1,"ぶん"]],"text":"あなたがたがささげるささげ物はこれである。すなわち、一ホメルの小麦のうちから六分の一エパをささげ、大麦一ホメルのうちから六分の一エパをささげよ。"},{"ref":"Ezek.45.14","start":26045014,"end":26045014,"break":"none","ruby":[[0,1,"あぶら"],[11,1,"ぶん"],[29,1,"おな"],[36,1,"あた"]],"text":"油は一コルのうちから十分の一バテをささげよ。コルはホメルと同じく十バテに当る。"},{"ref":"Ezek.45.15","start":26045015,"end":26045015,"break":"none","ruby":[[8,2,"しぞく"],[13,2,"かちく"],[16,1,"む"],[24,1,"とう"],[26,1,"ひつじ"],[28,1,"だ"],[32,2,"そさい"],[35,2,"はんさい"],[38,3,"しゅうおんさい"],[44,1,"かれ"],[59,1,"しゅ"],[62,1,"かみ"],[64,1,"い"]],"text":"またイスラエルの氏族から、家畜の群れ二百につき一頭の羊を出して、素祭、燔祭、酬恩祭とし、彼らのために、あがないをなせと主なる神は言われる。"},{"ref":"Ezek.45.16","start":26045016,"end":26045016,"break":"none","ruby":[[0,1,"くに"],[2,1,"たみ"],[4,1,"みな"],[14,1,"きみ"],[19,1,"もの"]],"text":"国の民は皆これをイスラエルの君にささげ物とせよ。"},{"ref":"Ezek.45.17","start":26045017,"end":26045017,"break":"none","ruby":[[2,2,"さいじつ"],[10,3,"あんそくにち"],[24,1,"いえ"],[30,1,"いわ"],[32,1,"び"],[35,2,"はんさい"],[38,2,"そさい"],[41,2,"かんさい"],[44,1,"そな"],[50,1,"きみ"],[53,1,"もの"],[55,1,"つとめ"],[64,1,"かれ"],[72,1,"いえ"],[83,2,"ざいさい"],[86,2,"そさい"],[89,2,"はんさい"],[92,3,"しゅうおんさい"]],"text":"また祭日、ついたち、安息日、すなわちイスラエルの家のすべての祝い日に、燔祭、素祭、灌祭を供えるのは、君たる者の務である。すなわち彼はイスラエルの家のあがないのために、罪祭、素祭、燔祭、酬恩祭をささげなければならない。"},{"ref":"Ezek.45.18","start":26045018,"end":26045018,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[8,1,"い"],[13,2,"しょうがつ"],[16,2,"がんじつ"],[24,2,"むきず"],[27,2,"おうし"],[30,1,"こ"],[32,1,"と"],[35,2,"せいじょ"],[38,1,"きよ"]],"text":"主なる神は、こう言われる、正月の元日に、あなたは無傷の雄牛の子を取って聖所を清めよ。"},{"ref":"Ezek.45.19","start":26045019,"end":26045019,"break":"none","ruby":[[0,2,"さいし"],[3,2,"ざいさい"],[6,1,"けもの"],[8,1,"ち"],[10,1,"と"],[14,1,"みや"],[16,1,"はしら"],[18,2,"さいだん"],[32,2,"うちにわ"],[35,1,"もん"],[37,1,"はしら"],[39,1,"ぬ"]],"text":"祭司は罪祭の獣の血を取って、宮の柱と祭壇のかさねの四すみ、および内庭の門の柱に塗れ。"},{"ref":"Ezek.45.20","start":26045020,"end":26045020,"break":"none","ruby":[[0,1,"つき"],[2,2,"なぬか"],[13,2,"かしつ"],[16,2,"むち"],[22,1,"つみ"],[24,1,"おか"],[27,1,"もの"],[38,1,"い"],[41,1,"みや"]],"text":"月の七日に、あなたがたは、過失や無知のために罪を犯した者のために、このように行って宮のためにあがないをなせ。"},{"ref":"Ezek.45.21","start":26045021,"end":26045021,"break":"paragraph","ruby":[[0,2,"しょうがつ"],[5,1,"か"],[14,2,"すぎこし"],[17,1,"まつり"],[19,1,"いわ"],[22,2,"なぬか"],[25,1,"あいだ"],[27,1,"たね"],[29,1,"い"],[35,1,"た"]],"text":"正月の十四日に、あなたがたは過越の祭を祝え。七日の間、種を入れぬパンを食べよ。"},{"ref":"Ezek.45.22","start":26045022,"end":26045022,"break":"none","ruby":[[2,1,"ひ"],[4,1,"きみ"],[7,1,"もの"],[10,2,"じしん"],[18,1,"くに"],[24,1,"たみ"],[29,2,"おうし"],[36,2,"ざいさい"]],"text":"その日に君たる者は、自身のため、また国のすべての民のため、雄牛をささげて罪祭とし、"},{"ref":"Ezek.45.23","start":26045023,"end":26045023,"break":"none","ruby":[[0,1,"いわ"],[2,1,"び"],[6,2,"なぬか"],[9,1,"あいだ"],[13,1,"とう"],[15,2,"おうし"],[20,1,"とう"],[22,2,"おひつじ"],[25,2,"むきず"],[32,2,"なぬか"],[35,1,"あいだ"],[36,2,"まいにち"],[39,2,"はんさい"],[44,1,"しゅ"],[46,1,"そな"],[53,1,"お"],[57,2,"ざいさい"],[62,2,"ひび"]],"text":"祝い日である七日の間は、七頭の雄牛と、七頭の雄羊の無傷のものを、七日の間毎日、燔祭として主に供えよ。また、雄やぎを罪祭として日々ささげよ。"},{"ref":"Ezek.45.24","start":26045024,"end":26045024,"break":"none","ruby":[[2,2,"そさい"],[7,2,"むぎこ"],[13,1,"かく"],[14,2,"おうし"],[24,1,"かく"],[25,2,"おひつじ"],[36,1,"あぶら"],[41,1,"かく"],[45,1,"くわ"]],"text":"また素祭として麦粉一エパを各雄牛のため、一エパを各雄羊のためにととのえ、油一ヒンを各エパに加えよ。"},{"ref":"Ezek.45.25","start":26045025,"end":26045025,"break":"none","ruby":[[1,1,"がつ"],[4,1,"にち"],[6,1,"いわ"],[8,1,"び"],[11,1,"かれ"],[13,2,"なぬか"],[16,1,"あいだ"],[18,2,"ざいさい"],[21,2,"はんさい"],[24,2,"そさい"],[29,1,"あぶら"],[37,1,"そな"]],"text":"七月十五日の祝い日に、彼は七日の間、罪祭、燔祭、素祭および油を、このように供えなければならない。"}]