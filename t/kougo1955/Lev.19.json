[{"ref":"Lev.19.1","start":3019001,"end":3019001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Lev.19.2","start":3019002,"end":3019002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"ぜん"],[11,2,"かいしゅう"],[14,1,"い"],[27,1,"かみ"],[29,1,"しゅ"],[37,1,"せい"],[50,1,"せい"]],"text":"「イスラエルの人々の全会衆に言いなさい、『あなたがたの神、主なるわたしは、聖であるから、あなたがたも聖でなければならない。"},{"ref":"Lev.19.3","start":3019003,"end":3019003,"break":"none","ruby":[[13,1,"はは"],[17,1,"ちち"],[38,3,"あんそくにち"],[42,1,"まも"],[63,1,"かみ"],[65,1,"しゅ"]],"text":"あなたがたは、おのおのその母とその父とをおそれなければならない。またわたしの安息日を守らなければならない。わたしはあなたがたの神、主である。"},{"ref":"Lev.19.4","start":3019004,"end":3019004,"break":"none","ruby":[[4,2,"かみがみ"],[7,1,"こころ"],[9,1,"よ"],[20,2,"じぶん"],[26,2,"かみがみ"],[29,1,"い"],[31,1,"つく"],[50,1,"かみ"],[52,1,"しゅ"]],"text":"むなしい神々に心を寄せてはならない。また自分のために神々を鋳て造ってはならない。わたしはあなたがたの神、主である。"},{"ref":"Lev.19.5","start":3019005,"end":3019005,"break":"paragraph","ruby":[[0,3,"しゅうおんさい"],[4,2,"ぎせい"],[7,1,"しゅ"],[23,1,"う"],[25,1,"い"]],"text":"酬恩祭の犠牲を主にささげるときは、あなたがたが受け入れられるように、それをささげなければならない。"},{"ref":"Lev.19.6","start":3019006,"end":3019006,"break":"none","ruby":[[8,1,"ひ"],[13,2,"よくじつ"],[17,1,"た"],[21,1,"か"],[22,1,"め"],[25,1,"のこ"],[35,1,"ひ"],[37,1,"や"]],"text":"それは、ささげた日と、その翌日とに食べ、三日目まで残ったものは、それを火で焼かなければならない。"},{"ref":"Lev.19.7","start":3019007,"end":3019007,"break":"none","ruby":[[3,1,"か"],[4,1,"め"],[7,1,"すこ"],[11,1,"た"],[21,1,"い"],[36,1,"う"],[38,1,"い"]],"text":"もし三日目に、少しでも食べるならば、それは忌むべきものとなって、あなたは受け入れられないであろう。"},{"ref":"Lev.19.8","start":3019008,"end":3019008,"break":"none","ruby":[[3,1,"た"],[6,1,"もの"],[9,1,"しゅ"],[11,1,"せい"],[14,1,"もの"],[16,1,"けが"],[26,1,"お"],[39,1,"ひと"],[41,1,"たみ"],[47,1,"た"]],"text":"それを食べる者は、主の聖なる物を汚すので、そのとがを負わなければならない。その人は民のうちから断たれるであろう。"},{"ref":"Lev.19.9","start":3019009,"end":3019009,"break":"paragraph","ruby":[[6,1,"ち"],[8,1,"み"],[12,1,"か"],[14,1,"い"],[21,1,"はたけ"],[29,1,"か"],[47,2,"かりい"],[51,1,"お"],[53,1,"ぼ"],[55,1,"ひろ"]],"text":"あなたがたの地の実のりを刈り入れるときは、畑のすみずみまで刈りつくしてはならない。またあなたの刈入れの落ち穂を拾ってはならない。"},{"ref":"Lev.19.10","start":3019010,"end":3019010,"break":"none","ruby":[[7,1,"はたけ"],[9,1,"み"],[11,1,"と"],[32,1,"はたけ"],[34,1,"お"],[37,1,"み"],[39,1,"ひろ"],[48,1,"まず"],[51,1,"もの"],[53,3,"きりゅうしゃ"],[65,1,"のこ"],[89,1,"かみ"],[91,1,"しゅ"]],"text":"あなたのぶどう畑の実を取りつくしてはならない。またあなたのぶどう畑に落ちた実を拾ってはならない。貧しい者と寄留者とのために、これを残しておかなければならない。わたしはあなたがたの神、主である。"},{"ref":"Lev.19.11","start":3019011,"end":3019011,"break":"paragraph","ruby":[[6,1,"ぬす"],[15,1,"あざむ"],[24,1,"たがい"],[26,1,"いつわ"]],"text":"あなたがたは盗んではならない。欺いてはならない。互に偽ってはならない。"},{"ref":"Lev.19.12","start":3019012,"end":3019012,"break":"none","ruby":[[4,1,"な"],[8,1,"いつわ"],[10,1,"ちか"],[20,1,"かみ"],[22,1,"な"],[24,1,"けが"],[37,1,"しゅ"]],"text":"わたしの名により偽り誓って、あなたがたの神の名を汚してはならない。わたしは主である。"},{"ref":"Lev.19.13","start":3019013,"end":3019013,"break":"paragraph","ruby":[[4,2,"りんじん"],[31,1,"ひ"],[32,2,"やといにん"],[35,2,"ちんぎん"],[38,1,"あ"],[41,1,"あさ"]],"text":"あなたの隣人をしえたげてはならない。また、かすめてはならない。日雇人の賃銀を明くる朝まで、あなたのもとにとどめておいてはならない。"},{"ref":"Lev.19.14","start":3019014,"end":3019014,"break":"none","ruby":[[0,1,"みみ"],[15,1,"め"],[19,1,"まえ"],[25,1,"もの"],[27,1,"お"],[40,1,"かみ"],[42,1,"おそ"],[57,1,"しゅ"]],"text":"耳しいを、のろってはならない。目しいの前につまずく物を置いてはならない。あなたの神を恐れなければならない。わたしは主である。"},{"ref":"Lev.19.15","start":3019015,"end":3019015,"break":"paragraph","ruby":[[9,2,"ふせい"],[12,1,"おこな"],[21,1,"まず"],[24,1,"もの"],[26,1,"かた"],[34,1,"ちから"],[37,1,"もの"],[39,1,"ま"],[42,1,"たす"],[53,2,"せいぎ"],[59,2,"りんじん"]],"text":"さばきをするとき、不正を行ってはならない。貧しい者を片よってかばい、力ある者を曲げて助けてはならない。ただ正義をもって隣人をさばかなければならない。"},{"ref":"Lev.19.16","start":3019016,"end":3019016,"break":"none","ruby":[[0,1,"たみ"],[5,1,"い"],[7,1,"めぐ"],[11,1,"ひと"],[13,2,"わるぐち"],[16,1,"い"],[32,2,"りんじん"],[35,1,"ち"],[41,2,"ぎしょう"],[56,1,"しゅ"]],"text":"民のうちを行き巡って、人の悪口を言いふらしてはならない。あなたの隣人の血にかかわる偽証をしてはならない。わたしは主である。"},{"ref":"Lev.19.17","start":3019017,"end":3019017,"break":"paragraph","ruby":[[4,1,"こころ"],[6,2,"きょうだい"],[9,1,"にく"],[22,2,"りんじん"],[35,1,"かれ"],[40,1,"つみ"],[42,1,"み"],[44,1,"お"]],"text":"あなたは心に兄弟を憎んではならない。あなたの隣人をねんごろにいさめて、彼のゆえに罪を身に負ってはならない。"},{"ref":"Lev.19.18","start":3019018,"end":3019018,"break":"none","ruby":[[7,1,"かえ"],[20,1,"たみ"],[22,2,"ひとびと"],[25,1,"うら"],[41,2,"じしん"],[51,2,"りんじん"],[54,1,"あい"],[69,1,"しゅ"]],"text":"あなたはあだを返してはならない。あなたの民の人々に恨みをいだいてはならない。あなた自身のようにあなたの隣人を愛さなければならない。わたしは主である。"},{"ref":"Lev.19.19","start":3019019,"end":3019019,"break":"paragraph","ruby":[[10,1,"さだ"],[13,1,"まも"],[28,2,"かちく"],[31,1,"こと"],[35,1,"たね"],[50,1,"はたけ"],[53,1,"しゅ"],[55,1,"たね"],[67,1,"しゅ"],[69,1,"いと"],[71,1,"ま"],[73,1,"お"],[76,2,"いふく"],[79,1,"み"]],"text":"あなたがたはわたしの定めを守らなければならない。あなたの家畜に異なった種をかけてはならない。あなたの畑に二種の種をまいてはならない。二種の糸の混ぜ織りの衣服を身につけてはならない。"},{"ref":"Lev.19.20","start":3019020,"end":3019020,"break":"paragraph","ruby":[[5,1,"ひと"],[7,2,"こんやく"],[12,1,"おんな"],[13,2,"どれい"],[26,2,"じゆう"],[29,1,"あた"],[37,1,"もの"],[39,1,"ね"],[41,1,"まじ"],[49,1,"かれ"],[55,1,"ばつ"],[57,1,"う"],[65,1,"ころ"],[75,2,"かのじょ"],[78,2,"じゆう"],[81,1,"おんな"]],"text":"だれでも、人と婚約のある女奴隷で、まだあがなわれず、自由を与えられていない者と寝て交わったならば、彼らふたりは罰を受ける。しかし、殺されることはない。彼女は自由の女ではないからである。"},{"ref":"Lev.19.21","start":3019021,"end":3019021,"break":"none","ruby":[[6,1,"おとこ"],[8,2,"けんさい"],[11,1,"しゅ"],[13,1,"たずさ"],[31,2,"けんさい"],[34,2,"おひつじ"],[38,2,"かいけん"],[41,2,"まくや"],[44,2,"いりぐち"],[47,1,"つ"]],"text":"しかし、その男は愆祭を主に携えてこなければならない。すなわち、愆祭の雄羊を、会見の幕屋の入口に連れてこなければならない。"},{"ref":"Lev.19.22","start":3019022,"end":3019022,"break":"none","ruby":[[4,2,"さいし"],[7,1,"かれ"],[9,1,"おか"],[12,1,"つみ"],[19,2,"けんさい"],[22,2,"おひつじ"],[29,1,"しゅ"],[31,1,"まえ"],[33,1,"かれ"],[55,1,"かれ"],[57,1,"おか"],[60,1,"つみ"]],"text":"そして、祭司は彼の犯した罪のためにその愆祭の雄羊をもって、主の前に彼のために、あがないをするであろう。こうして彼の犯した罪はゆるされるであろう。"},{"ref":"Lev.19.23","start":3019023,"end":3019023,"break":"paragraph","ruby":[[9,1,"ち"],[26,1,"き"],[28,1,"う"],[37,1,"み"],[41,2,"かつれい"],[52,1,"み"],[73,1,"ねん"],[75,1,"あいだ"],[84,2,"かつれい"],[96,1,"た"]],"text":"あなたがたが、かの地にはいって、もろもろのくだものの木を植えるときは、その実はまだ割礼をうけないものと、見なさなければならない。すなわち、それは三年の間あなたがたには、割礼のないものであって、食べてはならない。"},{"ref":"Lev.19.24","start":3019024,"end":3019024,"break":"none","ruby":[[1,1,"ねん"],[2,1,"め"],[12,1,"み"],[14,1,"せい"],[17,1,"もの"],[28,1,"そな"],[30,1,"もの"],[34,1,"しゅ"]],"text":"四年目には、そのすべての実を聖なる物とし、それをさんびの供え物として主にささげなければならない。"},{"ref":"Lev.19.25","start":3019025,"end":3019025,"break":"none","ruby":[[4,1,"ねん"],[5,1,"め"],[17,1,"み"],[19,1,"た"],[54,1,"おお"],[57,1,"み"],[59,1,"むす"],[76,1,"かみ"],[78,1,"しゅ"]],"text":"しかし五年目には、あなたがたはその実を食べることができるであろう。こうするならば、それはあなたがたのために、多くの実を結ぶであろう。わたしはあなたがたの神、主である。"},{"ref":"Lev.19.26","start":3019026,"end":3019026,"break":"paragraph","ruby":[[6,1,"なに"],[9,1,"ち"],[14,1,"た"],[25,1,"うらな"],[36,2,"まほう"],[39,1,"おこな"]],"text":"あなたがたは何をも血のままで食べてはならない。また占いをしてはならない。魔法を行ってはならない。"},{"ref":"Lev.19.27","start":3019027,"end":3019027,"break":"none","ruby":[[9,1,"け"],[11,1,"き"],[23,2,"りょうたん"]],"text":"あなたがたのびんの毛を切ってはならない。ひげの両端をそこなってはならない。"},{"ref":"Lev.19.28","start":3019028,"end":3019028,"break":"none","ruby":[[0,2,"しにん"],[6,1,"み"],[8,1,"きず"],[20,1,"み"],[22,2,"いれずみ"],[37,1,"しゅ"]],"text":"死人のために身を傷つけてはならない。また身に入墨をしてはならない。わたしは主である。"},{"ref":"Lev.19.29","start":3019029,"end":3019029,"break":"paragraph","ruby":[[4,1,"むすめ"],[6,2,"ゆうじょ"],[19,1,"けが"],[35,1,"こと"],[37,1,"くに"],[39,1,"おこな"],[43,2,"あくじ"],[46,1,"ち"],[48,1,"み"]],"text":"あなたの娘に遊女のわざをさせて、これを汚してはならない。これはみだらな事が国に行われ、悪事が地に満ちないためである。"},{"ref":"Lev.19.30","start":3019030,"end":3019030,"break":"none","ruby":[[10,3,"あんそくにち"],[14,1,"まも"],[21,2,"せいじょ"],[24,1,"うやま"],[39,1,"しゅ"]],"text":"あなたがたはわたしの安息日を守り、わたしの聖所を敬わなければならない。わたしは主である。"},{"ref":"Lev.19.31","start":3019031,"end":3019031,"break":"paragraph","ruby":[[6,2,"くちよ"],[13,1,"うらな"],[15,1,"し"],[31,1,"かれ"],[34,1,"と"],[37,1,"けが"],[57,1,"かみ"],[59,1,"しゅ"]],"text":"あなたがたは口寄せ、または占い師のもとにおもむいてはならない。彼らに問うて汚されてはならない。わたしはあなたがたの神、主である。"},{"ref":"Lev.19.32","start":3019032,"end":3019032,"break":"paragraph","ruby":[[4,2,"はくはつ"],[7,1,"ひと"],[9,1,"まえ"],[13,2,"きりつ"],[27,2,"ろうじん"],[30,1,"うやま"],[37,1,"かみ"],[39,1,"おそ"],[54,1,"しゅ"]],"text":"あなたは白髪の人の前では、起立しなければならない。また老人を敬い、あなたの神を恐れなければならない。わたしは主である。"},{"ref":"Lev.19.33","start":3019033,"end":3019033,"break":"paragraph","ruby":[[2,2,"たこく"],[4,1,"じん"],[12,1,"くに"],[14,2,"きりゅう"],[18,1,"とも"]],"text":"もし他国人があなたがたの国に寄留して共にいるならば、これをしえたげてはならない。"},{"ref":"Lev.19.34","start":3019034,"end":3019034,"break":"none","ruby":[[6,1,"とも"],[10,2,"きりゅう"],[13,2,"たこく"],[15,1,"じん"],[24,1,"おな"],[26,1,"くに"],[28,1,"うま"],[31,1,"もの"],[41,2,"じしん"],[50,1,"あい"],[75,1,"くに"],[77,2,"たこく"],[79,1,"じん"],[100,1,"かみ"],[102,1,"しゅ"]],"text":"あなたがたと共にいる寄留の他国人を、あなたがたと同じ国に生れた者のようにし、あなた自身のようにこれを愛さなければならない。あなたがたもかつてエジプトの国で他国人であったからである。わたしはあなたがたの神、主である。"},{"ref":"Lev.19.35","start":3019035,"end":3019035,"break":"paragraph","ruby":[[16,2,"ものさ"],[42,2,"ふせい"],[45,1,"おこな"]],"text":"あなたがたは、さばきにおいても、物差しにおいても、はかりにおいても、ますにおいても、不正を行ってはならない。"},{"ref":"Lev.19.36","start":3019036,"end":3019036,"break":"none","ruby":[[6,1,"ただ"],[14,1,"ただ"],[20,1,"いし"],[22,1,"ただ"],[28,1,"ただ"],[34,1,"つか"],[61,1,"くに"],[64,1,"みちび"],[66,1,"だ"],[75,1,"かみ"],[77,1,"しゅ"]],"text":"あなたがたは正しいてんびん、正しいおもり石、正しいエパ、正しいヒンを使わなければならない。わたしは、あなたがたをエジプトの国から導き出したあなたがたの神、主である。"},{"ref":"Lev.19.37","start":3019037,"end":3019037,"break":"none","ruby":[[14,1,"さだ"],[30,1,"まも"],[37,1,"おこな"],[52,1,"しゅ"]],"text":"あなたがたはわたしのすべての定めと、わたしのすべてのおきてを守って、これを行わなければならない。わたしは主である』」。"}]