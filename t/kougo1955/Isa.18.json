[{"ref":"Isa.18.1","start":23018001,"end":23018001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[9,2,"かわがわ"],[22,2,"はおと"],[27,1,"くに"]],"text":"ああ、エチオピヤの川々のかなたなるぶんぶんと羽音のする国、"},{"ref":"Isa.18.2","start":23018002,"end":23018002,"break":"line","breaks":[[14,"line"],[30,"line"],[41,"line"],[64,"line"],[74,"line"]],"ruby":[[2,1,"くに"],[4,1,"あし"],[6,1,"ふね"],[8,1,"みず"],[17,1,"かわ"],[22,2,"ししゃ"],[32,1,"はし"],[34,2,"ししゃ"],[38,1,"い"],[41,2,"かわがわ"],[44,1,"わか"],[47,1,"くに"],[52,1,"たか"],[55,1,"はだ"],[62,1,"たみ"],[64,2,"えんきん"],[67,1,"おそ"],[72,1,"たみ"],[74,2,"ちからづよ"],[78,1,"たたか"],[81,1,"か"],[83,1,"たみ"],[85,1,"い"]],"text":"この国は葦の船を水にうかべ、ナイル川によって使者をつかわす。とく走る使者よ、行け。川々の分れる国の、たけ高く、膚のなめらかな民、遠近に恐れられる民、力強く、戦いに勝つ民へ行け。"},{"ref":"Isa.18.3","start":23018003,"end":23018003,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[3,1,"よ"],[10,1,"ち"],[12,1,"す"],[18,1,"やま"],[20,1,"うえ"],[22,1,"はた"],[24,1,"た"],[29,1,"み"],[36,1,"な"],[44,1,"き"]],"text":"すべて世におるもの、地に住むものよ、山の上に旗の立つときは見よ、ラッパの鳴りひびくときは聞け。"},{"ref":"Isa.18.4","start":23018004,"end":23018004,"break":"line","breaks":[[13,"line"],[29,"line"],[47,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"い"],[14,1,"は"],[20,2,"にっこう"],[23,1,"ねつ"],[29,2,"かりい"],[33,1,"ねつ"],[37,1,"つゆ"],[39,1,"おお"],[41,1,"くも"],[51,1,"しず"]],"text":"主はわたしにこう言われた、「晴れわたった日光の熱のように、刈入れの熱むして露の多い雲のように、わたしは静かにわたしのすまいから、ながめよう」。"},{"ref":"Isa.18.5","start":23018005,"end":23018005,"break":"line","breaks":[[11,"line"],[27,"line"]],"ruby":[[0,2,"かりい"],[4,1,"まえ"],[6,1,"はな"],[8,1,"す"],[13,1,"はな"],[22,1,"じゅく"],[27,1,"かれ"],[39,1,"か"],[42,1,"えだ"],[44,1,"き"],[46,1,"さ"]],"text":"刈入れの前、花は過ぎてその花がぶどうとなって熟すとき、彼はかまをもって、つるを刈り、枝を切り去る。"},{"ref":"Isa.18.6","start":23018006,"end":23018006,"break":"line","breaks":[[11,"line"],[23,"line"],[36,"line"]],"ruby":[[0,1,"かれ"],[5,1,"やま"],[7,2,"もうきん"],[11,1,"ち"],[13,1,"けもの"],[16,1,"す"],[18,1,"お"],[23,2,"もうきん"],[28,1,"うえ"],[30,1,"なつ"],[32,1,"す"],[36,1,"ち"],[38,1,"けもの"],[44,1,"うえ"],[46,1,"ふゆ"],[48,1,"す"]],"text":"彼らはみな山の猛禽と、地の獣とに捨て置かれる。猛禽はその上で夏を過ごし、地の獣はみなその上で冬を過ごす。"},{"ref":"Isa.18.7","start":23018007,"end":23018007,"break":"line","breaks":[[12,"line"],[26,"line"],[45,"line"],[57,"line"],[74,"line"]],"ruby":[[2,1,"とき"],[4,2,"かわがわ"],[7,1,"わか"],[10,1,"くに"],[14,1,"たか"],[17,1,"はだ"],[24,1,"たみ"],[26,1,"とお"],[29,1,"もの"],[32,1,"ちか"],[35,1,"もの"],[38,1,"おそ"],[43,1,"たみ"],[45,2,"ちからづよ"],[49,1,"たたか"],[52,1,"か"],[54,1,"たみ"],[57,2,"ばんぐん"],[60,1,"しゅ"],[66,1,"おく"],[68,1,"もの"],[70,1,"たずさ"],[74,2,"ばんぐん"],[77,1,"しゅ"],[80,1,"な"],[84,1,"ところ"],[90,1,"やま"],[92,1,"く"]],"text":"その時、川々の分れる国のたけ高く、膚のなめらかな民、遠くの者にも近くの者にも恐れられる民、力強く、戦いに勝つ民から万軍の主にささげる贈り物を携えて、万軍の主のみ名のある所、シオンの山に来る。"}]