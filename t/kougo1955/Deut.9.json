[{"ref":"Deut.9.1","start":5009001,"end":5009001,"break":"paragraph","ruby":[[7,1,"き"],[27,1,"わた"],[30,1,"い"],[40,1,"おお"],[46,1,"つよ"],[48,2,"くにぐに"],[51,1,"と"],[62,2,"まちまち"],[65,1,"おお"],[69,1,"いし"],[73,1,"てん"],[75,1,"たっ"]],"text":"イスラエルよ、聞きなさい。あなたは、きょう、ヨルダンを渡って行って、あなたよりも大きく、かつ強い国々を取ろうとしている。その町々は大きく、石がきは天に達している。"},{"ref":"Deut.9.2","start":5009002,"end":5009002,"break":"none","ruby":[[2,1,"たみ"],[9,1,"し"],[20,2,"しそん"],[27,1,"おお"],[33,1,"せ"],[35,1,"たか"],[49,2,"しそん"],[52,1,"まえ"],[58,1,"た"],[70,1,"ひと"],[72,1,"い"],[76,1,"き"]],"text":"その民は、あなたの知っているアナクびとの子孫であって、大きく、また背が高い。あなたはまた『アナクの子孫の前に、だれが立つことができようか』と人の言うのを聞いた。"},{"ref":"Deut.9.3","start":5009003,"end":5009003,"break":"none","ruby":[[18,1,"かみ"],[20,1,"しゅ"],[22,1,"や"],[27,1,"ひ"],[37,1,"まえ"],[39,1,"すす"],[46,1,"し"],[57,1,"しゅ"],[59,1,"かれ"],[62,1,"ほろ"],[66,1,"かれ"],[73,1,"まえ"],[75,2,"くっぷく"],[87,1,"しゅ"],[93,1,"い"],[101,1,"かれ"],[104,1,"お"],[106,1,"はら"],[114,1,"ほろ"]],"text":"それゆえ、あなたは、きょう、あなたの神、主は焼きつくす火であって、あなたの前に進まれることを知らなければならない。主は彼らを滅ぼし、彼らをあなたの前に屈伏させられるであろう。主があなたに言われたように、彼らを追い払い、すみやかに滅ぼさなければならない。"},{"ref":"Deut.9.4","start":5009004,"end":5009004,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[12,1,"まえ"],[15,1,"かれ"],[18,1,"お"],[20,1,"はら"],[24,1,"のち"],[31,1,"こころ"],[41,1,"ただ"],[46,1,"しゅ"],[54,1,"ち"],[56,1,"みちび"],[58,1,"い"],[64,1,"え"],[72,1,"い"],[83,2,"くにぐに"],[86,1,"たみ"],[88,1,"わる"],[93,1,"しゅ"],[102,1,"まえ"],[105,1,"お"],[107,1,"はら"]],"text":"あなたの神、主があなたの前から彼らを追い払われた後に、あなたは心のなかで『わたしが正しいから主はわたしをこの地に導き入れてこれを獲させられた』と言ってはならない。この国々の民が悪いから、主はこれをあなたの前から追い払われるのである。"},{"ref":"Deut.9.5","start":5009005,"end":5009005,"break":"none","ruby":[[4,1,"い"],[9,1,"ち"],[11,1,"え"],[20,1,"ただ"],[36,1,"こころ"],[52,2,"くにぐに"],[55,1,"たみ"],[57,1,"わる"],[66,1,"かみ"],[68,1,"しゅ"],[70,1,"かれ"],[77,1,"まえ"],[80,1,"お"],[82,1,"はら"],[94,1,"しゅ"],[100,2,"せんぞ"],[116,1,"ちか"],[120,2,"ことば"],[123,1,"おこな"]],"text":"あなたが行ってその地を獲るのは、あなたが正しいからではなく、またあなたの心がまっすぐだからでもない。この国々の民が悪いから、あなたの神、主は彼らをあなたの前から追い払われるのである。これは主があなたの先祖アブラハム、イサク、ヤコブに誓われた言葉を行われるためである。"},{"ref":"Deut.9.6","start":5009006,"end":5009006,"break":"paragraph","ruby":[[12,1,"かみ"],[14,1,"しゅ"],[22,1,"よ"],[24,1,"ち"],[26,1,"あた"],[32,1,"え"],[45,1,"ただ"],[57,1,"し"],[72,2,"ごうじょう"],[75,1,"たみ"]],"text":"それであなたは、あなたの神、主があなたにこの良い地を与えてこれを得させられるのは、あなたが正しいからではないことを知らなければならない。あなたは強情な民である。"},{"ref":"Deut.9.7","start":5009007,"end":5009007,"break":"none","ruby":[[4,2,"あらの"],[11,1,"かみ"],[13,1,"しゅ"],[15,1,"いか"],[22,1,"おぼ"],[28,1,"わす"],[48,1,"ち"],[50,1,"で"],[52,1,"ひ"],[57,1,"ところ"],[59,1,"く"],[67,1,"しゅ"]],"text":"あなたは荒野であなたの神、主を怒らせたことを覚え、それを忘れてはならない。あなたがたはエジプトの地を出た日からこの所に来るまで、いつも主にそむいた。"},{"ref":"Deut.9.8","start":5009008,"end":5009008,"break":"none","ruby":[[18,1,"しゅ"],[20,1,"いか"],[27,1,"しゅ"],[29,1,"いか"],[38,1,"ほろ"]],"text":"またホレブにおいてさえ、あなたがたが主を怒らせたので、主は怒ってあなたがたを滅ぼそうとされた。"},{"ref":"Deut.9.9","start":5009009,"end":5009009,"break":"none","ruby":[[4,1,"いし"],[6,1,"いた"],[11,1,"しゅ"],[19,1,"むす"],[23,2,"けいやく"],[26,1,"いた"],[28,1,"う"],[34,1,"やま"],[36,1,"のぼ"],[39,1,"とき"],[47,1,"にち"],[50,1,"や"],[52,1,"やま"],[60,1,"た"],[63,1,"みず"],[65,1,"の"]],"text":"わたしが石の板すなわち主があなたがたと結ばれた契約の板を受けるために山に登った時、わたしは四十日四十夜、山にいて、パンも食べず水も飲まなかった。"},{"ref":"Deut.9.10","start":5009010,"end":5009010,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かみ"],[4,1,"ゆび"],[9,1,"か"],[15,1,"いし"],[17,1,"いた"],[19,1,"まい"],[25,1,"さづ"],[33,1,"うえ"],[37,2,"しゅうかい"],[40,1,"ひ"],[42,1,"しゅ"],[44,1,"やま"],[46,1,"ひ"],[48,1,"なか"],[58,1,"つ"],[63,2,"ことば"],[72,1,"か"]],"text":"主は神の指をもって書きしるした石の板二枚をわたしに授けられた。その上には、集会の日に主が山で火の中から、あなたがたに告げられた言葉が、ことごとく書いてあった。"},{"ref":"Deut.9.11","start":5009011,"end":5009011,"break":"none","ruby":[[6,1,"にち"],[9,1,"や"],[11,1,"おわ"],[14,1,"とき"],[16,1,"しゅ"],[24,2,"けいやく"],[27,1,"いた"],[31,1,"いし"],[33,1,"いた"],[35,1,"まい"],[37,1,"さづ"]],"text":"すなわち四十日四十夜が終った時、主はわたしにその契約の板である石の板二枚を授け、"},{"ref":"Deut.9.12","start":5009012,"end":5009012,"break":"none","ruby":[[3,1,"しゅ"],[9,1,"い"],[19,1,"た"],[30,1,"ところ"],[33,1,"ふ"],[49,1,"みちび"],[51,1,"だ"],[54,1,"たみ"],[56,1,"あく"],[58,1,"おこな"],[67,1,"かれ"],[74,1,"めい"],[77,1,"みち"],[79,1,"はや"],[82,1,"はな"],[86,1,"い"],[88,1,"ぞう"],[90,2,"じぶん"],[98,1,"つく"]],"text":"そして主はわたしに言われた、『おまえは立って、すみやかにこの所から降りなさい。おまえがエジプトから導き出した民は悪を行ったからである。彼らはわたしが命じた道を早くも離れて、鋳た像を自分たちのために造った』。"},{"ref":"Deut.9.13","start":5009013,"end":5009013,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[16,1,"たみ"],[18,1,"み"],[26,2,"ごうじょう"],[29,1,"たみ"]],"text":"主はまたわたしに言われた、『この民を見るのに、これは強情な民である。"},{"ref":"Deut.9.14","start":5009014,"end":5009014,"break":"none","ruby":[[4,1,"と"],[13,1,"かれ"],[16,1,"ほろ"],[20,1,"かれ"],[23,1,"な"],[25,1,"てん"],[27,1,"した"],[30,1,"け"],[32,1,"さ"],[39,1,"かれ"],[44,1,"つよ"],[49,1,"おお"],[53,2,"こくみん"]],"text":"わたしを止めるな。わたしは彼らを滅ぼし、彼らの名を天の下から消し去り、おまえを彼らよりも強く、かつ大いなる国民としよう』。"},{"ref":"Deut.9.15","start":5009015,"end":5009015,"break":"none","ruby":[[7,1,"み"],[14,1,"やま"],[16,1,"お"],[21,1,"やま"],[23,1,"ひ"],[25,1,"や"],[31,2,"けいやく"],[34,1,"いた"],[36,1,"まい"],[42,2,"りょうて"]],"text":"そこでわたしは身をめぐらして山を降りたが、山は火で焼けていた。契約の板二枚はわたしの両手にあった。"},{"ref":"Deut.9.16","start":5009016,"end":5009016,"break":"none","ruby":[[7,1,"み"],[24,1,"かみ"],[26,1,"しゅ"],[32,1,"つみ"],[34,1,"おか"],[37,2,"じぶん"],[45,2,"いもの"],[48,1,"こ"],[49,1,"うし"],[51,1,"つく"],[55,1,"しゅ"],[57,1,"めい"],[62,1,"みち"],[64,1,"はや"],[67,1,"はな"]],"text":"そしてわたしが見ると、あなたがたは、あなたがたの神、主にむかって罪を犯し、自分たちのために鋳物の子牛を造って、主が命じられた道を早くも離れたので、"},{"ref":"Deut.9.17","start":5009017,"end":5009017,"break":"none","ruby":[[7,1,"まい"],[9,1,"いた"],[16,2,"りょうて"],[20,1,"な"],[22,1,"だ"],[31,1,"め"],[33,1,"まえ"],[38,1,"くだ"]],"text":"わたしはその二枚の板をつかんで、両手から投げ出し、あなたがたの目の前でこれを砕いた。"},{"ref":"Deut.9.18","start":5009018,"end":5009018,"break":"none","ruby":[[7,1,"まえ"],[14,1,"にち"],[17,1,"や"],[19,1,"しゅ"],[21,1,"まえ"],[25,1,"ふ"],[31,1,"た"],[35,1,"みず"],[37,1,"の"],[53,1,"しゅ"],[55,1,"め"],[57,1,"まえ"],[59,1,"あく"],[66,1,"つみ"],[68,1,"おか"],[71,1,"しゅ"],[73,1,"いか"],[81,1,"つみ"]],"text":"そしてわたしは前のように四十日四十夜、主の前にひれ伏し、パンも食べず、水も飲まなかった。これはあなたがたが主の目の前に悪をおこない、罪を犯して主を怒らせたすべての罪によるのである。"},{"ref":"Deut.9.19","start":5009019,"end":5009019,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"いか"],[5,1,"はっ"],[8,1,"いきどお"],[11,1,"おこ"],[20,1,"いか"],[23,1,"ほろ"],[38,1,"おそ"],[45,1,"とき"],[49,1,"しゅ"],[55,1,"ねが"],[58,1,"き"]],"text":"主は怒りを発し、憤りを起し、あなたがたを怒って滅ぼそうとされたので、わたしは恐れたが、その時もまた主はわたしの願いを聞かれた。"},{"ref":"Deut.9.20","start":5009020,"end":5009020,"break":"none","ruby":[[0,1,"しゅ"],[15,1,"いか"],[19,1,"かれ"],[21,1,"ほろ"],[37,1,"とき"],[48,1,"いの"]],"text":"主はまた、はなはだしくアロンを怒って、彼を滅ぼそうとされたが、わたしはその時もまたアロンのために祈った。"},{"ref":"Deut.9.21","start":5009021,"end":5009021,"break":"none","ruby":[[10,1,"つく"],[13,1,"つみ"],[15,1,"え"],[17,1,"こ"],[18,1,"うし"],[20,1,"と"],[26,1,"ひ"],[28,1,"や"],[34,1,"う"],[36,1,"くだ"],[44,1,"こま"],[57,1,"やま"],[60,1,"なが"],[62,1,"くだ"],[64,2,"たにがわ"],[67,1,"な"],[69,1,"す"]],"text":"わたしはあなたがたが造って罪を得た子牛を取り、それを火で焼き、それを撃ち砕き、よくひいて細かいちりとし、そのちりを山から流れ下る谷川に投げ捨てた。"},{"ref":"Deut.9.22","start":5009022,"end":5009022,"break":"paragraph","ruby":[[32,1,"しゅ"],[34,1,"いか"]],"text":"あなたがたはタベラ、マッサおよびキブロテ・ハッタワにおいてもまた主を怒らせた。"},{"ref":"Deut.9.23","start":5009023,"end":5009023,"break":"none","ruby":[[2,1,"しゅ"],[30,1,"とき"],[33,1,"のぼ"],[36,1,"い"],[44,1,"あた"],[47,1,"ち"],[49,2,"せんりょう"],[55,1,"い"],[77,1,"かみ"],[79,1,"しゅ"],[81,2,"めいれい"],[88,1,"かれ"],[90,1,"しん"],[96,1,"かれ"],[98,1,"こえ"],[100,1,"き"],[102,1,"したが"]],"text":"また主はカデシ・バルネアから、あなたがたをつかわそうとされた時、『上って行って、わたしが与える地を占領せよ』と言われた。ところが、あなたがたはあなたがたの神、主の命令にそむき、彼を信ぜず、また彼の声に聞き従わなかった。"},{"ref":"Deut.9.24","start":5009024,"end":5009024,"break":"none","ruby":[[10,1,"し"],[15,1,"ひ"],[32,1,"しゅ"]],"text":"わたしがあなたがたを知ったその日からこのかた、あなたがたはいつも主にそむいた。"},{"ref":"Deut.9.25","start":5009025,"end":5009025,"break":"paragraph","ruby":[[13,1,"ふ"],[22,1,"にち"],[25,1,"や"],[27,1,"しゅ"],[29,1,"まえ"],[33,1,"ふ"],[37,1,"しゅ"],[45,1,"ほろ"],[49,1,"い"]],"text":"そしてわたしは、さきにひれ伏したように、四十日四十夜、主の前にひれ伏した。主があなたがたを滅ぼすと言われたからである。"},{"ref":"Deut.9.26","start":5009026,"end":5009026,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"いの"],[9,1,"い"],[14,1,"しゅ"],[17,1,"かみ"],[24,1,"おお"],[28,1,"ちから"],[38,1,"つよ"],[40,1,"て"],[51,1,"みちび"],[53,1,"だ"],[61,1,"たみ"],[67,1,"し"],[68,1,"ぎょう"],[70,1,"ほろ"]],"text":"わたしは主に祈って言った、『主なる神よ、あなたが大いなる力をもってあがない、強い手をもってエジプトから導き出されたあなたの民、あなたの嗣業を滅ぼさないでください。"},{"ref":"Deut.9.27","start":5009027,"end":5009027,"break":"none","ruby":[[21,1,"おぼ"],[31,1,"たみ"],[33,2,"ごうじょう"],[36,1,"あく"],[38,1,"つみ"],[41,1,"め"]],"text":"あなたのしもべアブラハム、イサク、ヤコブを覚えてください。この民の強情と悪と罪とに目をとめないでください。"},{"ref":"Deut.9.28","start":5009028,"end":5009028,"break":"none","ruby":[[9,1,"みちび"],[11,1,"だ"],[15,1,"くに"],[17,1,"ひと"],[25,1,"しゅ"],[28,2,"やくそく"],[32,1,"ち"],[34,1,"かれ"],[37,1,"みちび"],[39,1,"い"],[51,1,"かれ"],[54,1,"にく"],[60,1,"かれ"],[63,1,"みちび"],[65,1,"だ"],[68,2,"あらの"],[71,1,"ころ"],[78,1,"い"]],"text":"あなたがわれわれを導き出された国の人はおそらく、「主は、約束した地に彼らを導き入れることができず、また彼らを憎んだので、彼らを導き出して荒野で殺したのだ」と言うでしょう。"},{"ref":"Deut.9.29","start":5009029,"end":5009029,"break":"none","ruby":[[3,1,"かれ"],[11,1,"たみ"],[17,1,"し"],[18,1,"ぎょう"],[28,1,"おお"],[32,1,"ちから"],[34,1,"の"],[38,1,"うで"],[44,1,"みちび"],[46,1,"だ"]],"text":"しかし彼らは、あなたの民、あなたの嗣業であって、あなたが大いなる力と伸ばした腕とをもって導き出されたのです』。"}]