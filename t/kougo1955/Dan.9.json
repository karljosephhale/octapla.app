[{"ref":"Dan.9.1","start":27009001,"end":27009001,"break":"paragraph","ruby":[[13,1,"こ"],[27,1,"おう"],[34,2,"がんねん"]],"text":"メデアびとアハシュエロスの子ダリヨスが、カルデヤびとの王となったその元年、"},{"ref":"Dan.9.2","start":27009002,"end":27009002,"break":"none","ruby":[[6,2,"ちせい"],[9,1,"だい"],[11,1,"ねん"],[21,1,"しゅ"],[23,3,"よげんしゃ"],[31,1,"のぞ"],[34,1,"つ"],[41,2,"ことば"],[53,2,"こうはい"],[56,1,"おわ"],[61,1,"へ"],[67,1,"ねん"],[69,1,"かず"],[73,1,"ねん"],[81,2,"ぶんしょ"],[87,1,"さと"]],"text":"すなわちその治世の第一年に、われダニエルは主が預言者エレミヤに臨んで告げられたその言葉により、エルサレムの荒廃の終るまでに経ねばならぬ年の数は七十年であることを、文書によって悟った。"},{"ref":"Dan.9.3","start":27009003,"end":27009003,"break":"paragraph","ruby":[[10,1,"かお"],[12,1,"しゅ"],[15,1,"かみ"],[17,1,"む"],[20,2,"だんじき"],[26,2,"あらぬの"],[29,1,"き"],[31,1,"はい"],[37,1,"いの"],[42,1,"ねが"],[44,1,"もと"]],"text":"それでわたしは、わが顔を主なる神に向け、断食をなし、荒布を着、灰をかぶって祈り、かつ願い求めた。"},{"ref":"Dan.9.4","start":27009004,"end":27009004,"break":"none","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[15,1,"いの"],[23,1,"い"],[31,1,"おお"],[35,1,"おそ"],[39,1,"かみ"],[41,1,"しゅ"],[47,1,"あい"],[54,1,"いまし"],[57,1,"まも"],[59,1,"もの"],[64,2,"けいやく"],[67,1,"たも"],[76,1,"ほどこ"],[80,1,"もの"]],"text":"すなわちわたしは、わが神、主に祈り、ざんげして言った、「ああ、大いなる恐るべき神、主、おのれを愛し、おのれの戒めを守る者のために契約を保ち、いつくしみを施される者よ、"},{"ref":"Dan.9.5","start":27009005,"end":27009005,"break":"none","ruby":[[5,1,"つみ"],[7,1,"おか"],[10,1,"あく"],[39,1,"いまし"],[47,1,"はな"]],"text":"われわれは罪を犯し、悪をおこない、よこしまなふるまいをなし、そむいて、あなたの戒めと、おきてを離れました。"},{"ref":"Dan.9.6","start":27009006,"end":27009006,"break":"none","ruby":[[17,3,"よげんしゃ"],[28,1,"な"],[39,1,"おう"],[43,1,"きみ"],[47,2,"せんぞ"],[55,1,"くに"],[61,1,"たみ"],[63,1,"つ"],[66,2,"ことば"],[69,1,"き"],[71,1,"したが"]],"text":"われわれはまた、あなたのしもべなる預言者たちが、あなたの名をもって、われわれの王たち、君たち、先祖たち、および国のすべての民に告げた言葉に聞き従いませんでした。"},{"ref":"Dan.9.7","start":27009007,"end":27009007,"break":"none","ruby":[[0,1,"しゅ"],[3,2,"せいぎ"],[16,1,"はじ"],[23,1,"くわ"],[29,2,"こんにち"],[35,2,"ありさま"],[47,2,"ひとびと"],[56,2,"じゅうみん"],[61,1,"ぜん"],[68,1,"もの"],[71,1,"ちか"],[73,1,"もの"],[76,1,"とお"],[78,1,"もの"],[87,1,"お"],[97,2,"くにぐに"],[100,1,"はじ"],[113,1,"かれ"],[124,1,"おか"],[127,1,"つみ"]],"text":"主よ、正義はあなたのものですが、恥はわれわれに加えられて、今日のような有様です。すなわちユダの人々、エルサレムの住民および全イスラエルの者は、近き者も、遠き者もみな、あなたが追いやられたすべての国々で恥をこうむりました。これは彼らがあなたにそむいて犯した罪によるのです。"},{"ref":"Dan.9.8","start":27009008,"end":27009008,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"はじ"],[18,1,"おう"],[22,1,"きみ"],[28,2,"せんぞ"],[54,1,"つみ"],[56,1,"おか"]],"text":"主よ、恥はわれわれのもの、われわれの王たち、君たちおよび先祖たちのものです。これはわれわれがあなたにむかって罪を犯したからです。"},{"ref":"Dan.9.9","start":27009009,"end":27009009,"break":"none","ruby":[[15,1,"かみ"],[17,1,"しゅ"],[32,1,"かれ"]],"text":"あわれみと、ゆるしはわれわれの神、主のものです。これはわれわれが彼にそむいたからです。"},{"ref":"Dan.9.10","start":27009010,"end":27009010,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[12,1,"こえ"],[14,1,"き"],[16,1,"したが"],[20,1,"しゅ"],[27,3,"よげんしゃ"],[42,1,"まえ"],[44,1,"たま"],[48,2,"りっぽう"],[51,1,"おこな"]],"text":"またわれわれの神、主のみ声に聞き従わず、主がそのしもべ預言者たちによって、われわれの前に賜わった律法を行わなかったからです。"},{"ref":"Dan.9.11","start":27009011,"end":27009011,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"みな"],[18,2,"りっぽう"],[21,1,"おか"],[24,1,"はな"],[26,1,"さ"],[35,1,"こえ"],[37,1,"き"],[39,1,"したが"],[48,1,"かみ"],[57,2,"りっぽう"],[69,1,"ちか"],[78,1,"うえ"],[80,1,"そそ"],[97,1,"かみ"],[103,1,"つみ"],[105,1,"おか"]],"text":"まことにイスラエルの人々は皆あなたの律法を犯し、離れ去って、あなたのみ声に聞き従わなかったので、神のしもべモーセの律法にしるされたのろいと誓いが、われわれの上に注ぎかかりました。これはわれわれが神にむかって罪を犯したからです。"},{"ref":"Dan.9.12","start":27009012,"end":27009012,"break":"none","ruby":[[4,1,"かみ"],[6,1,"おお"],[10,1,"わざわい"],[17,1,"うえ"],[38,1,"おさ"],[51,1,"つ"],[56,2,"ことば"],[59,2,"じっこう"],[76,1,"のぞ"],[82,1,"こと"],[85,1,"ぜん"],[86,2,"てんか"],[99,1,"こと"]],"text":"すなわち神は大いなる災をわれわれの上にくだして、さきにわれわれと、われわれを治めたつかさたちにむかって告げられた言葉を実行されたのです。あのエルサレムに臨んだような事は、全天下にいまだかつてなかった事です。"},{"ref":"Dan.9.13","start":27009013,"end":27009013,"break":"none","ruby":[[4,2,"りっぽう"],[18,1,"わざわい"],[28,1,"のぞ"],[42,1,"かみ"],[44,1,"しゅ"],[46,1,"めぐ"],[49,1,"こ"],[51,1,"もと"],[62,2,"ふぎ"],[65,1,"はな"],[73,2,"しんり"],[76,1,"さと"]],"text":"モーセの律法にしるされたように、この災はすべてわれわれに臨みましたが、なおわれわれの神、主の恵みを請い求めることをせず、その不義を離れて、あなたの真理を悟ることをもしませんでした。"},{"ref":"Dan.9.14","start":27009014,"end":27009014,"break":"none","ruby":[[5,1,"しゅ"],[10,1,"こころ"],[12,1,"と"],[16,1,"わざわい"],[23,1,"くだ"],[36,1,"かみ"],[38,1,"しゅ"],[41,2,"なにごと"],[50,1,"ただ"],[74,1,"こえ"],[76,1,"き"],[78,1,"したが"]],"text":"それゆえ、主はこれを心に留めて、災をわれわれに下されたのです。われわれの神、主は、何事をされるにも、正しくあらせられます。ところが、われわれはそのみ声に聞き従わなかったのです。"},{"ref":"Dan.9.15","start":27009015,"end":27009015,"break":"none","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[14,1,"つよ"],[17,1,"て"],[27,1,"たみ"],[34,1,"ち"],[37,1,"みちび"],[39,1,"だ"],[43,2,"こんにち"],[51,1,"な"],[66,1,"つみ"],[68,1,"おか"]],"text":"われわれの神、主よ、あなたは強きみ手をもって、あなたの民をエジプトの地から導き出して、今日のように、み名をあげられました。われわれは罪を犯し、よこしまなふるまいをしました。"},{"ref":"Dan.9.16","start":27009016,"end":27009016,"break":"none","ruby":[[0,1,"しゅ"],[15,1,"ただ"],[34,1,"まち"],[45,1,"せい"],[48,1,"やま"],[56,1,"いか"],[59,1,"いきどお"],[63,1,"と"],[65,1,"さ"],[81,1,"つみ"],[89,2,"せんぞ"],[92,2,"ふぎ"],[110,1,"たみ"],[118,2,"しゅうい"],[121,1,"もの"],[123,2,"ものわら"]],"text":"主よ、どうぞあなたが、これまで正しいみわざをなされたように、あなたの町エルサレム、あなたの聖なる山から、あなたの怒りと憤りとを取り去ってください。これはわれわれの罪と、われわれの先祖の不義のために、エルサレムと、あなたの民が、われわれの周囲の者の物笑いとなったからです。"},{"ref":"Dan.9.17","start":27009017,"end":27009017,"break":"none","ruby":[[10,1,"かみ"],[17,1,"いのり"],[19,1,"ねが"],[22,1,"き"],[30,1,"しゅ"],[37,2,"じしん"],[46,1,"あ"],[53,2,"せいじょ"],[62,1,"かお"],[64,1,"かがや"]],"text":"それゆえ、われわれの神よ、しもべの祈と願いを聞いてください。主よ、あなたご自身のために、あの荒れたあなたの聖所に、あなたのみ顔を輝かせてください。"},{"ref":"Dan.9.18","start":27009018,"end":27009018,"break":"none","ruby":[[2,1,"かみ"],[5,1,"みみ"],[7,1,"かたむ"],[10,1,"き"],[18,1,"め"],[20,1,"ひら"],[29,1,"あ"],[35,1,"み"],[38,1,"な"],[49,1,"まち"],[68,1,"まえ"],[70,1,"いのり"],[84,1,"ぎ"],[100,1,"おお"]],"text":"わが神よ、耳を傾けて聞いてください。目を開いて、われわれの荒れたさまを見、み名をもってとなえられる町をごらんください。われわれがあなたの前に祈をささげるのは、われわれの義によるのではなく、ただあなたの大いなるあわれみによるのです。"},{"ref":"Dan.9.19","start":27009019,"end":27009019,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"き"],[11,1,"しゅ"],[23,1,"しゅ"],[27,1,"こころ"],[29,1,"と"],[45,1,"かみ"],[52,2,"じしん"],[62,1,"の"],[77,1,"まち"],[84,1,"たみ"],[88,1,"な"]],"text":"主よ、聞いてください。主よ、ゆるしてください。主よ、み心に留めて、おこなってください。わが神よ、あなたご自身のために、これを延ばさないでください。あなたの町と、あなたの民は、み名をもってとなえられているからです」。"},{"ref":"Dan.9.20","start":27009020,"end":27009020,"break":"paragraph","ruby":[[6,1,"い"],[9,1,"いの"],[16,1,"つみ"],[20,1,"たみ"],[27,1,"つみ"],[36,1,"かみ"],[38,1,"せい"],[41,1,"やま"],[49,1,"かみ"],[51,1,"しゅ"],[53,1,"まえ"],[55,1,"ねが"]],"text":"わたしがこう言って祈り、かつわが罪とわが民イスラエルの罪をざんげし、わが神の聖なる山のために、わが神、主の前に願いをしていたとき、"},{"ref":"Dan.9.21","start":27009021,"end":27009021,"break":"none","ruby":[[8,1,"いのり"],[10,2,"ことば"],[13,1,"の"],[25,1,"はじ"],[28,1,"まぼろし"],[33,1,"み"],[38,1,"ひと"],[51,1,"と"],[57,1,"ゆう"],[59,1,"そな"],[61,1,"もの"],[74,1,"ちか"]],"text":"すなわちわたしが祈の言葉を述べていたとき、わたしが初めに幻のうちに見た、かの人ガブリエルは、すみやかに飛んできて、夕の供え物をささげるころ、わたしに近づき、"},{"ref":"Dan.9.22","start":27009022,"end":27009022,"break":"none","ruby":[[4,1,"つ"],[7,1,"い"],[22,1,"いま"],[28,2,"ちえ"],[31,1,"さと"],[34,1,"あた"]],"text":"わたしに告げて言った、「ダニエルよ、わたしは今あなたに、知恵と悟りを与えるためにきました。"},{"ref":"Dan.9.23","start":27009023,"end":27009023,"break":"none","ruby":[[4,1,"いのり"],[6,1,"はじ"],[13,2,"ことば"],[16,1,"で"],[28,1,"つ"],[44,1,"おお"],[47,1,"あい"],[54,1,"もの"],[65,2,"ことば"],[68,1,"かんが"],[74,1,"まぼろし"],[76,1,"さと"]],"text":"あなたが祈を始めたとき、み言葉が出たので、それをあなたに告げるためにきたのです。あなたは大いに愛せられている者です。ゆえに、このみ言葉を考えて、この幻を悟りなさい。"},{"ref":"Dan.9.24","start":27009024,"end":27009024,"break":"paragraph","ruby":[[4,1,"たみ"],[11,1,"せい"],[14,1,"まち"],[23,1,"しゅう"],[25,1,"さだ"],[40,1,"おわ"],[44,1,"つみ"],[46,1,"おわ"],[49,1,"つ"],[52,2,"ふぎ"],[60,2,"えいえん"],[63,1,"ぎ"],[70,1,"まぼろし"],[72,3,"よげんしゃ"],[76,1,"ふう"],[81,1,"せい"],[84,1,"もの"],[86,1,"あぶら"],[88,1,"そそ"]],"text":"あなたの民と、あなたの聖なる町については、七十週が定められています。これはとがを終らせ、罪に終りを告げ、不義をあがない、永遠の義をもたらし、幻と預言者を封じ、いと聖なる者に油を注ぐためです。"},{"ref":"Dan.9.25","start":27009025,"end":27009025,"break":"none","ruby":[[11,1,"た"],[13,1,"なお"],[18,2,"めいれい"],[21,1,"で"],[35,1,"きみ"],[37,1,"く"],[43,1,"しゅう"],[48,1,"しゅう"],[54,1,"し"],[59,1,"さと"],[67,1,"あいだ"],[73,2,"ふあん"],[76,2,"じだい"],[86,2,"ひろば"],[89,2,"がいろ"],[97,1,"た"],[99,1,"なお"]],"text":"それゆえ、エルサレムを建て直せという命令が出てから、メシヤなるひとりの君が来るまで、七週と六十二週あることを知り、かつ悟りなさい。その間に、しかも不安な時代に、エルサレムは広場と街路とをもって、建て直されるでしょう。"},{"ref":"Dan.9.26","start":27009026,"end":27009026,"break":"none","ruby":[[5,1,"しゅう"],[7,1,"のち"],[13,1,"た"],[25,2,"じぶん"],[46,1,"きみ"],[48,1,"たみ"],[51,1,"まち"],[53,2,"せいじょ"],[57,1,"ほろ"],[67,1,"おわ"],[70,2,"こうずい"],[76,1,"のぞ"],[88,1,"おわ"],[92,2,"せんそう"],[95,1,"つづ"],[98,2,"こうはい"],[101,1,"さだ"]],"text":"その六十二週の後にメシヤは断たれるでしょう。ただし自分のためにではありません。またきたるべき君の民は、町と聖所とを滅ぼすでしょう。その終りは洪水のように臨むでしょう。そしてその終りまで戦争が続き、荒廃は定められています。"},{"ref":"Dan.9.27","start":27009027,"end":27009027,"break":"none","ruby":[[0,1,"かれ"],[2,2,"いっしゅう"],[5,1,"あいだ"],[6,1,"おお"],[9,1,"もの"],[12,1,"かた"],[14,2,"けいやく"],[17,1,"むす"],[27,1,"かれ"],[31,1,"しゅう"],[33,1,"なか"],[37,2,"ぎせい"],[40,1,"そな"],[42,1,"もの"],[45,1,"はい"],[55,1,"あら"],[57,1,"もの"],[59,1,"にく"],[63,1,"もの"],[65,1,"つばさ"],[67,1,"の"],[70,1,"く"],[86,1,"さだ"],[90,1,"おわ"],[96,1,"あら"],[98,1,"もの"],[100,1,"うえ"],[102,1,"そそ"]],"text":"彼は一週の間多くの者と、堅く契約を結ぶでしょう。そして彼はその週の半ばに、犠牲と供え物とを廃するでしょう。また荒す者が憎むべき者の翼に乗って来るでしょう。こうしてついにその定まった終りが、その荒す者の上に注がれるのです」。"}]