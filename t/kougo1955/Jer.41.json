[{"ref":"Jer.41.1","start":24041001,"end":24041001,"break":"paragraph","ruby":[[1,1,"がつ"],[6,1,"おう"],[7,1,"いえ"],[19,1,"こ"],[25,1,"こ"],[32,1,"おう"],[34,2,"こうかん"],[50,1,"おう"],[53,1,"にん"],[61,1,"とも"],[74,1,"こ"],[90,1,"しょく"],[92,1,"とも"]],"text":"七月のころ、王家のもので、エリシャマの子ネタニヤの子であり、また王の高官のひとりであるイシマエルは、王の十人のつかさたちと共にミヅパにいたアヒカムの子ゲダリヤのもとにきて、ミヅパで食を共にしたが、"},{"ref":"Jer.41.2","start":24041002,"end":24041002,"break":"none","ruby":[[5,1,"こ"],[14,1,"とも"],[19,1,"にん"],[21,1,"もの"],[23,1,"た"],[25,1,"あ"],[35,1,"おう"],[39,1,"ち"],[41,2,"そうとく"],[51,1,"こ"],[57,1,"こ"],[66,1,"かたな"],[68,1,"ころ"]],"text":"ネタニヤの子イシマエルおよび共にいた十人の者は立ち上がって、バビロンの王がこの地の総督としたシャパンの子アヒカムの子であるゲダリヤを刀で殺し、"},{"ref":"Jer.41.3","start":24041003,"end":24041003,"break":"none","ruby":[[17,1,"とも"],[28,1,"ひと"],[47,2,"へいし"],[52,1,"ころ"]],"text":"イシマエルはまたミヅパでゲダリヤと共にいたすべてのユダヤ人と、たまたまそこにいたカルデヤびとの兵士たちを殺した。"},{"ref":"Jer.41.4","start":24041004,"end":24041004,"break":"paragraph","ruby":[[5,1,"ころ"],[9,1,"つぎ"],[11,1,"ひ"],[20,1,"こと"],[22,1,"し"]],"text":"ゲダリヤが殺された次の日、まだだれもその事を知らないうちに、"},{"ref":"Jer.41.5","start":24041005,"end":24041005,"break":"none","ruby":[[2,1,"にん"],[4,2,"ひとびと"],[15,2,"いふく"],[21,1,"み"],[23,1,"きず"],[28,1,"て"],[31,2,"そさい"],[37,1,"もの"],[39,1,"こう"],[41,1,"たずさ"],[60,1,"しゅ"],[62,1,"みや"]],"text":"八十人の人々がそのひげをそり、衣服をさき、身に傷をつけ、手には素祭のささげ物と香を携え、シケム、シロ、サマリヤからきて、主の宮にささげようとした。"},{"ref":"Jer.41.6","start":24041006,"end":24041006,"break":"none","ruby":[[5,1,"こ"],[17,1,"な"],[22,1,"で"],[26,1,"かれ"],[29,1,"むか"],[32,1,"かれ"],[35,1,"あ"],[45,1,"こ"],[62,1,"い"]],"text":"ネタニヤの子イシマエルはミヅパから泣きながら出てきて彼らを迎え、彼らに会って、「アヒカムの子ゲダリヤのもとにおいでなさい」と言った。"},{"ref":"Jer.41.7","start":24041007,"end":24041007,"break":"none","ruby":[[3,1,"かれ"],[6,1,"まち"],[8,1,"なか"],[22,1,"こ"],[29,2,"じぶん"],[32,2,"いっしょ"],[37,2,"ひとびと"],[40,1,"とも"],[42,1,"かれ"],[45,1,"ころ"],[51,2,"したい"],[54,1,"あな"],[56,1,"な"],[58,1,"い"]],"text":"そして彼らが町の中にはいったとき、ネタニヤの子イシマエルは自分と一緒にいた人々と共に彼らを殺して、その死体を穴に投げ入れた。"},{"ref":"Jer.41.8","start":24041008,"end":24041008,"break":"none","ruby":[[9,1,"にん"],[17,1,"む"],[28,1,"はたけ"],[30,2,"こむぎ"],[33,2,"おおむぎ"],[36,1,"あぶら"],[41,1,"みつ"],[43,1,"かく"],[56,1,"ころ"],[67,1,"い"],[73,1,"かれ"],[78,2,"なかま"],[81,1,"とも"],[83,1,"ころ"]],"text":"しかしそのうちの十人はイシマエルに向かい、「わたしたちは畑に小麦、大麦、油、および蜜を隠しています、わたしたちを殺さないでください」と言ったので、彼らをその仲間と共に殺さないでしまった。"},{"ref":"Jer.41.9","start":24041009,"end":24041009,"break":"paragraph","ruby":[[6,2,"じぶん"],[9,1,"ころ"],[12,2,"ひとびと"],[15,2,"したい"],[18,1,"な"],[20,1,"い"],[23,1,"あな"],[28,1,"おう"],[36,1,"おう"],[42,1,"おそ"],[45,1,"ほ"],[48,1,"あな"],[59,1,"こ"],[66,1,"ころ"],[69,2,"ひとびと"],[75,1,"み"]],"text":"イシマエルが自分の殺した人々の死体を投げ入れた穴は、アサ王がイスラエルの王バアシャを恐れて掘った穴であった。ネタニヤの子イシマエルは殺した人々をこれに満たした。"},{"ref":"Jer.41.10","start":24041010,"end":24041010,"break":"none","ruby":[[0,1,"つ"],[13,1,"のこ"],[22,1,"たみ"],[28,1,"おう"],[30,1,"むすめ"],[34,2,"じえい"],[37,1,"ちょう"],[50,1,"こ"],[56,1,"たく"],[63,1,"のこ"],[72,1,"たみ"],[75,2,"ほりょ"],[86,1,"こ"],[93,1,"かれ"],[96,2,"ほりょ"],[111,1,"わた"],[113,1,"い"],[119,1,"た"],[121,1,"さ"]],"text":"次いでイシマエルはミヅパに残っているすべての民、すなわち王の娘たちと侍衛の長ネブザラダンがアヒカムの子ゲダリヤに託したミヅパに残っているすべての民とを捕虜とした。ネタニヤの子イシマエルは彼らを捕虜とし、アンモンびとのもとに渡り行こうとして立ち去った。"},{"ref":"Jer.41.11","start":24041011,"end":24041011,"break":"paragraph","ruby":[[4,1,"こ"],[12,1,"かれ"],[14,1,"とも"],[18,2,"ぐんぜい"],[21,1,"ちょう"],[30,1,"こ"],[37,1,"い"],[40,2,"あくじ"],[45,1,"き"]],"text":"カレヤの子ヨハナンおよび彼と共にいる軍勢の長たちはネタニヤの子イシマエルの行った悪事をみな聞き、"},{"ref":"Jer.41.12","start":24041012,"end":24041012,"break":"none","ruby":[[2,2,"へいし"],[7,1,"ひき"],[16,1,"こ"],[23,1,"たたか"],[28,1,"で"],[30,1,"い"],[38,2,"おおいけ"],[45,1,"かれ"],[47,1,"あ"]],"text":"その兵士たちを率いて、ネタニヤの子イシマエルと戦うために出て行き、ギベオンの大池のほとりで彼に会った。"},{"ref":"Jer.41.13","start":24041013,"end":24041013,"break":"none","ruby":[[6,1,"とも"],[10,2,"ひとびと"],[18,1,"こ"],[26,1,"かれ"],[28,1,"とも"],[32,2,"ぐんぜい"],[35,1,"ちょう"],[39,1,"み"],[41,1,"よろこ"]],"text":"イシマエルと共にいる人々は、カレヤの子ヨハナンおよび彼と共にいる軍勢の長たちを見て喜んだ。"},{"ref":"Jer.41.14","start":24041014,"end":24041014,"break":"none","ruby":[[14,2,"ほりょ"],[21,2,"ひとびと"],[24,1,"み"],[35,1,"こ"],[44,1,"い"]],"text":"そしてイシマエルがミヅパから捕虜にしてきた人々は身をめぐらしてカレヤの子ヨハナンのもとへ行った。"},{"ref":"Jer.41.15","start":24041015,"end":24041015,"break":"none","ruby":[[5,1,"こ"],[13,1,"にん"],[15,1,"もの"],[17,1,"とも"],[24,1,"さ"],[27,1,"に"],[37,1,"ところ"],[39,1,"い"]],"text":"ネタニヤの子イシマエルは八人の者と共にヨハナンを避けて逃げ、アンモンびとの所へ行った。"},{"ref":"Jer.41.16","start":24041016,"end":24041016,"break":"none","ruby":[[7,1,"こ"],[15,1,"かれ"],[17,1,"とも"],[21,2,"ぐんぜい"],[24,1,"ちょう"],[33,1,"こ"],[45,1,"こ"],[51,1,"ころ"],[60,2,"ほりょ"],[65,1,"つ"],[73,1,"のこ"],[78,1,"たみ"],[84,2,"へいし"],[87,1,"おんな"],[89,2,"こども"],[92,2,"かんがん"],[101,1,"つ"],[103,1,"かえ"]],"text":"そこでカレヤの子ヨハナンおよび彼と共にいる軍勢の長たちはネタニヤの子イシマエルがアヒカムの子ゲダリヤを殺して、ミヅパから捕虜として連れてきた、あの残っていた民、すなわち兵士や女、子供、宦官をギベオンから連れ帰ったが、"},{"ref":"Jer.41.17","start":24041017,"end":24041017,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[20,1,"ちか"],[34,1,"い"]],"text":"彼らはエジプトへ行こうとしてベツレヘムの近くにあるゲルテ・キムハムへ行って、そこにとどまった。"},{"ref":"Jer.41.18","start":24041018,"end":24041018,"break":"none","ruby":[[9,1,"こ"],[22,1,"おう"],[29,1,"ち"],[31,2,"そうとく"],[34,1,"にん"],[44,1,"こ"],[50,1,"ころ"],[66,1,"おそ"]],"text":"これは、ネタニヤの子イシマエルが、バビロンの王によってこの地の総督に任じられたアヒカムの子ゲダリヤを殺したことにより、カルデヤびとを恐れたからである。"}]