[{"ref":"Isa.60.1","start":23060001,"end":23060001,"break":"paragraph","breaks":[[9,"line"],[18,"line"]],"ruby":[[0,1,"お"],[4,1,"ひかり"],[6,1,"はな"],[13,1,"ひかり"],[15,1,"のぞ"],[18,1,"しゅ"],[20,2,"えいこう"],[27,1,"うえ"]],"text":"起きよ、光を放て。あなたの光が臨み、主の栄光があなたの上にのぼったから。"},{"ref":"Isa.60.2","start":23060002,"end":23060002,"break":"line","breaks":[[12,"line"],[26,"line"],[50,"line"]],"ruby":[[0,1,"み"],[3,1,"くら"],[6,1,"ち"],[20,1,"たみ"],[34,1,"うえ"],[37,1,"しゅ"],[39,2,"あさひ"],[50,1,"しゅ"],[52,2,"えいこう"],[59,1,"うえ"]],"text":"見よ、暗きは地をおおい、やみはもろもろの民をおおう。しかし、あなたの上には主が朝日のごとくのぼられ、主の栄光があなたの上にあらわれる。"},{"ref":"Isa.60.3","start":23060003,"end":23060003,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"くに"],[12,1,"ひかり"],[14,1,"き"],[21,1,"おう"],[31,1,"かがや"],[34,1,"く"]],"text":"もろもろの国は、あなたの光に来、もろもろの王は、のぼるあなたの輝きに来る。"},{"ref":"Isa.60.4","start":23060004,"end":23060004,"break":"paragraph","breaks":[[14,"line"],[30,"line"],[43,"line"]],"ruby":[[4,1,"め"],[9,1,"み"],[14,1,"かれ"],[19,1,"あつ"],[27,1,"く"],[34,1,"こ"],[37,1,"とお"],[41,1,"き"],[47,1,"むすめ"],[60,1,"く"]],"text":"あなたの目をあげて見まわせ、彼らはみな集まってあなたに来る。あなたの子らは遠くから来、あなたの娘らは、かいなにいだかれて来る。"},{"ref":"Isa.60.5","start":23060005,"end":23060005,"break":"line","breaks":[[16,"line"],[32,"line"],[45,"line"]],"ruby":[[2,1,"とき"],[7,1,"み"],[10,1,"よろこ"],[13,1,"かがや"],[20,1,"こころ"],[29,1,"よろこ"],[32,1,"うみ"],[34,1,"とみ"],[36,1,"うつ"],[43,1,"き"],[50,1,"くに"],[52,1,"たから"],[59,1,"く"]],"text":"その時あなたは見て、喜びに輝き、あなたの心はどよめき、かつ喜ぶ。海の富が移ってあなたに来、もろもろの国の宝が、あなたに来るからである。"},{"ref":"Isa.60.6","start":23060006,"end":23060006,"break":"line","breaks":[[23,"line"],[31,"line"],[51,"line"]],"ruby":[[0,1,"おお"],[17,1,"わか"],[34,2,"ひとびと"],[39,2,"おうごん"],[42,2,"にゅうこう"],[45,1,"たずさ"],[51,1,"しゅ"],[53,1,"ほまれ"],[55,1,"の"],[57,1,"つた"]],"text":"多くのらくだ、ミデアンおよびエパの若きらくだはあなたをおおい、シバの人々はみな黄金、乳香を携えてきて、主の誉を宣べ伝える。"},{"ref":"Isa.60.7","start":23060007,"end":23060007,"break":"line","breaks":[[21,"line"],[36,"line"],[55,"line"]],"ruby":[[4,1,"ひつじ"],[6,1,"む"],[15,1,"あつ"],[19,1,"き"],[26,2,"おひつじ"],[33,1,"つか"],[38,2,"さいだん"],[41,1,"うえ"],[47,1,"う"],[66,2,"えいこう"],[69,1,"いえ"],[71,1,"かがや"]],"text":"ケダルの羊の群れはみなあなたに集まって来、ネバヨテの雄羊はあなたに仕え、わが祭壇の上にのぼって受けいれられる。こうして、わたしはわが栄光の家を輝かす。"},{"ref":"Isa.60.8","start":23060008,"end":23060008,"break":"paragraph","breaks":[[8,"line"],[16,"line"]],"ruby":[[0,1,"くも"],[5,1,"と"],[13,2,"こや"],[16,1,"と"],[18,1,"かえ"],[25,1,"く"],[27,1,"もの"]],"text":"雲のように飛び、はとがその小屋に飛び帰るようにして来る者はだれか。"},{"ref":"Isa.60.9","start":23060009,"end":23060009,"break":"line","breaks":[[16,"line"],[27,"line"],[43,"line"],[59,"line"],[73,"line"],[87,"line"]],"ruby":[[0,2,"うみぞ"],[4,2,"くにぐに"],[11,1,"ま"],[13,1,"のぞ"],[21,1,"ふね"],[25,1,"さき"],[31,1,"こ"],[34,1,"とお"],[38,1,"の"],[41,1,"き"],[45,1,"かれ"],[48,2,"きんぎん"],[51,1,"とも"],[53,1,"の"],[56,1,"き"],[63,1,"かみ"],[65,1,"しゅ"],[67,1,"な"],[79,2,"せいじゃ"],[87,1,"しゅ"],[93,1,"かがや"]],"text":"海沿いの国々はわたしを待ち望み、タルシシの船はいや先にあなたの子らを遠くから載せて来、また彼らの金銀を共に載せて来て、あなたの神、主の名にささげ、イスラエルの聖者にささげる。主があなたを輝かされたからである。"},{"ref":"Isa.60.10","start":23060010,"end":23060010,"break":"paragraph","breaks":[[14,"line"],[29,"line"],[51,"line"]],"ruby":[[0,3,"いほうじん"],[8,2,"じょうへき"],[11,1,"きず"],[14,1,"かれ"],[17,1,"おう"],[25,1,"つか"],[33,1,"いか"],[43,1,"う"],[53,1,"めぐ"]],"text":"異邦人はあなたの城壁を築き、彼らの王たちはあなたに仕える。わたしは怒りをもってあなたを打ったけれども、また恵みをもってあなたをあわれんだからである。"},{"ref":"Isa.60.11","start":23060011,"end":23060011,"break":"line","breaks":[[12,"line"],[25,"line"],[45,"line"]],"ruby":[[4,1,"もん"],[6,1,"つね"],[8,1,"ひら"],[12,1,"ひる"],[14,1,"よる"],[16,1,"と"],[28,2,"ひとびと"],[31,2,"くにぐに"],[34,1,"たから"],[40,1,"たずさ"],[43,1,"き"],[47,1,"おう"],[51,1,"ひき"],[54,1,"く"]],"text":"あなたの門は常に開いて、昼も夜も閉ざすことはない。これは人々が国々の宝をあなたに携えて来、その王たちを率いて来るためである。"},{"ref":"Isa.60.12","start":23060012,"end":23060012,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"つか"],[8,1,"くに"],[10,1,"たみ"],[13,1,"ほろ"],[18,2,"くにぐに"],[21,1,"まった"],[23,1,"あ"]],"text":"あなたに仕えない国と民とは滅び、その国々は全く荒れすたれる。"},{"ref":"Isa.60.13","start":23060013,"end":23060013,"break":"line","breaks":[[14,"line"],[33,"line"],[42,"line"]],"ruby":[[5,1,"さか"],[12,1,"き"],[27,1,"みな"],[28,1,"とも"],[30,1,"き"],[35,2,"せいじょ"],[50,1,"あし"],[54,1,"ところ"],[56,1,"たっと"]],"text":"レバノンの栄えはあなたに来、いとすぎ、すずかけ、まつは皆共に来て、わが聖所をかざる。またわたしはわが足をおく所を尊くする。"},{"ref":"Isa.60.14","start":23060014,"end":23060014,"break":"line","breaks":[[14,"line"],[28,"line"],[40,"line"],[56,"line"],[64,"line"]],"ruby":[[4,1,"くる"],[8,1,"もの"],[10,1,"こ"],[26,1,"き"],[37,1,"もの"],[49,1,"あし"],[53,1,"ふ"],[60,1,"しゅ"],[62,1,"みやこ"],[70,2,"せいじゃ"]],"text":"あなたを苦しめた者の子らは、かがんで、あなたのもとに来、あなたをさげすんだ者は、ことごとくあなたの足もとに伏し、あなたを主の都、イスラエルの聖者のシオンととなえる。"},{"ref":"Isa.60.15","start":23060015,"end":23060015,"break":"paragraph","breaks":[[14,"line"],[29,"line"],[45,"line"]],"ruby":[[4,1,"す"],[9,1,"にく"],[16,1,"なか"],[18,1,"す"],[21,1,"もの"],[43,1,"ほこり"],[45,2,"よよ"],[48,1,"よろこ"]],"text":"あなたは捨てられ、憎まれて、その中を過ぎる者もなかったが、わたしはあなたを、とこしえの誇、世々の喜びとする。"},{"ref":"Isa.60.16","start":23060016,"end":23060016,"break":"line","breaks":[[19,"line"],[30,"line"],[48,"line"],[61,"line"]],"ruby":[[12,1,"くに"],[14,1,"ちち"],[16,1,"す"],[19,1,"おう"],[23,1,"ち"],[27,1,"す"],[33,1,"しゅ"],[45,2,"すくいぬし"],[59,1,"ぬし"],[65,3,"ぜんのうしゃ"],[74,1,"し"]],"text":"あなたはまた、もろもろの国の乳を吸い、王たちの乳ぶさを吸い、そして主なるわたしが、あなたの救主、また、あなたのあがない主、ヤコブの全能者であることを知るにいたる。"},{"ref":"Isa.60.17","start":23060017,"end":23060017,"break":"paragraph","breaks":[[16,"line"],[32,"line"],[54,"line"],[69,"line"]],"ruby":[[4,2,"せいどう"],[7,1,"かわ"],[10,2,"おうごん"],[13,1,"たずさ"],[21,1,"かわ"],[29,1,"たずさ"],[32,1,"き"],[34,1,"かわ"],[37,2,"せいどう"],[41,1,"いし"],[43,1,"かわ"],[46,1,"てつ"],[48,1,"たずさ"],[64,2,"へいわ"],[79,1,"ただ"]],"text":"わたしは青銅の代りに黄金を携え、くろがねの代りにしろがねを携え、木の代りに青銅を、石の代りに鉄を携えてきて、あなたのまつりごとを平和にし、あなたのつかさびとを正しくする。"},{"ref":"Isa.60.18","start":23060018,"end":23060018,"break":"line","breaks":[[18,"line"],[42,"line"],[59,"line"]],"ruby":[[0,2,"ぼうぎゃく"],[11,1,"ち"],[13,1,"き"],[18,2,"こうはい"],[21,2,"めつぼう"],[32,1,"さかい"],[37,1,"き"],[48,2,"じょうへき"],[52,1,"すくい"],[61,1,"もん"],[64,1,"ほまれ"]],"text":"暴虐は、もはやあなたの地に聞かれず、荒廃と滅亡は、もはやあなたの境のうちに聞かれず、あなたはその城壁を「救」ととなえ、その門を「誉」ととなえる。"},{"ref":"Isa.60.19","start":23060019,"end":23060019,"break":"paragraph","breaks":[[19,"line"],[34,"line"],[50,"line"]],"ruby":[[0,1,"ひる"],[6,2,"たいよう"],[13,1,"ひかり"],[19,1,"よる"],[21,1,"つき"],[23,1,"かがや"],[30,1,"てら"],[34,1,"しゅ"],[45,1,"ひかり"],[54,1,"かみ"],[60,1,"さか"]],"text":"昼は、もはや太陽があなたの光とならず、夜も月が輝いてあなたを照さず、主はとこしえにあなたの光となり、あなたの神はあなたの栄えとなられる。"},{"ref":"Isa.60.20","start":23060020,"end":23060020,"break":"line","breaks":[[13,"line"],[28,"line"],[44,"line"]],"ruby":[[4,2,"たいよう"],[7,1,"ふたた"],[9,1,"ぼっ"],[17,1,"つき"],[28,1,"しゅ"],[39,1,"ひかり"],[48,1,"かな"],[52,1,"ひ"],[54,1,"おわ"]],"text":"あなたの太陽は再び没せず、あなたの月はかけることがない。主がとこしえにあなたの光となり、あなたの悲しみの日が終るからである。"},{"ref":"Isa.60.21","start":23060021,"end":23060021,"break":"line","breaks":[[20,"line"],[32,"line"],[52,"line"]],"ruby":[[4,1,"たみ"],[11,1,"ただ"],[14,1,"もの"],[25,1,"ち"],[27,2,"しょゆう"],[32,1,"かれ"],[39,1,"う"],[42,1,"わか"],[43,1,"えだ"],[47,1,"て"],[54,2,"えいこう"]],"text":"あなたの民はことごとく正しい者となって、とこしえに地を所有する。彼らはわたしの植えた若枝、わが手のわざ、わが栄光をあらわすものとなる。"},{"ref":"Isa.60.22","start":23060022,"end":23060022,"break":"line","breaks":[[15,"line"],[30,"line"],[39,"line"]],"ruby":[[2,1,"もっと"],[4,1,"ちい"],[7,1,"もの"],[9,2,"しぞく"],[17,1,"もっと"],[19,1,"よわ"],[21,1,"もの"],[23,1,"つよ"],[25,1,"くに"],[34,1,"しゅ"],[41,1,"とき"],[56,1,"こと"]],"text":"その最も小さい者は氏族となり、その最も弱い者は強い国となる。わたしは主である。その時がくるならば、すみやかにこの事をなす。"}]