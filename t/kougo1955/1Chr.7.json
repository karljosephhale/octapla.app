[{"ref":"1Chr.7.1","start":13007001,"end":13007001,"break":"paragraph","ruby":[[6,1,"こ"],[26,1,"にん"]],"text":"イッサカルの子らはトラ、プワ、ヤシュブ、シムロムの四人。"},{"ref":"1Chr.7.2","start":13007002,"end":13007002,"break":"none","ruby":[[3,1,"こ"],[35,1,"みな"],[39,1,"こ"],[44,2,"しぞく"],[47,1,"ちょう"],[54,2,"しそん"],[57,1,"だい"],[58,2,"ゆうし"],[62,1,"もの"],[68,1,"よ"],[73,1,"かず"],[80,1,"にん"]],"text":"トラの子らはウジ、レパヤ、エリエル、ヤマイ、エブサム、サムエル。これは皆トラの子で、その氏族の長である。その子孫の大勇士たる者はダビデの世にはその数二万二千六百人であった。"},{"ref":"1Chr.7.3","start":13007003,"end":13007003,"break":"none","ruby":[[3,1,"こ"],[17,1,"こ"],[39,1,"にん"],[44,1,"ちょう"],[47,1,"もの"]],"text":"ウジの子はイズラヒヤ、イズラヒヤの子らはミカエル、オバデヤ、ヨエル、イシアの五人で、みな長たる者であった。"},{"ref":"1Chr.7.4","start":13007004,"end":13007004,"break":"none","ruby":[[2,2,"しそん"],[11,2,"しぞく"],[14,1,"したが"],[17,2,"ぐんぜい"],[20,2,"しそつ"],[26,1,"にん"],[34,1,"かれ"],[37,2,"さいし"],[40,1,"おお"]],"text":"その子孫のうちに、その氏族に従えば軍勢の士卒三万六千人あった。これは彼らが妻子を多くもっていたからである。"},{"ref":"1Chr.7.5","start":13007005,"end":13007005,"break":"none","ruby":[[10,2,"しぞく"],[16,2,"きょうだい"],[21,2,"けいず"],[27,1,"かぞ"],[32,1,"だい"],[33,2,"ゆうし"],[36,1,"あ"],[44,1,"にん"]],"text":"イッサカルのすべての氏族のうちの兄弟たちで系図によって数えられた大勇士は合わせて八万七千人あった。"},{"ref":"1Chr.7.6","start":13007006,"end":13007006,"break":"paragraph","ruby":[[6,1,"こ"],[23,1,"にん"]],"text":"ベニヤミンの子らはベラ、ベケル、エデアエルの三人。"},{"ref":"1Chr.7.7","start":13007007,"end":13007007,"break":"none","ruby":[[3,1,"こ"],[28,1,"にん"],[31,1,"みな"],[34,2,"しぞく"],[37,1,"ちょう"],[44,2,"けいず"],[50,1,"かぞ"],[55,1,"だい"],[56,2,"ゆうし"],[66,1,"にん"]],"text":"ベラの子らはエヅボン、ウジ、ウジエル、エレモテ、イリの五人で、皆その氏族の長である。その系図によって数えられた大勇士は二万二千三十四人あった。"},{"ref":"1Chr.7.8","start":13007008,"end":13007008,"break":"none","ruby":[[4,1,"こ"],[51,1,"みな"],[56,1,"こ"]],"text":"ベケルの子らはゼミラ、ヨアシ、エリエゼル、エリオエナイ、オムリ、エレモテ、アビヤ、アナトテ、アラメテで皆ベケルの子らである。"},{"ref":"1Chr.7.9","start":13007009,"end":13007009,"break":"none","ruby":[[2,2,"しそん"],[10,2,"しぞく"],[13,1,"ちょう"],[17,2,"けいず"],[23,1,"かぞ"],[28,1,"だい"],[29,2,"ゆうし"],[36,1,"にん"]],"text":"その子孫のうち、その氏族の長として系図によって数えられた大勇士は二万二百人あった。"},{"ref":"1Chr.7.10","start":13007010,"end":13007010,"break":"none","ruby":[[6,1,"こ"],[18,1,"こ"]],"text":"エデアエルの子はビルハン。ビルハンの子らはエウシ、ベニヤミン、エホデ、ケナアナ、ゼタン、タルシシ、アヒシャハル。"},{"ref":"1Chr.7.11","start":13007011,"end":13007011,"break":"none","ruby":[[0,1,"みな"],[7,1,"こ"],[10,2,"しぞく"],[13,1,"ちょう"],[21,2,"しそん"],[33,1,"で"],[37,1,"たたか"],[39,1,"だい"],[40,2,"ゆうし"],[49,1,"にん"]],"text":"皆エデアエルの子らで氏族の長であった。その子孫のうちには、いくさに出てよく戦う大勇士が一万七千二百人あった。"},{"ref":"1Chr.7.12","start":13007012,"end":13007012,"break":"none","ruby":[[5,1,"こ"],[21,1,"こ"]],"text":"またイルの子らはシュパムとホパム。アヘルの子はホシムである。"},{"ref":"1Chr.7.13","start":13007013,"end":13007013,"break":"paragraph","ruby":[[5,1,"こ"],[26,1,"みな"],[31,1,"う"],[34,1,"こ"]],"text":"ナフタリの子らはヤハジエル、グニ、エゼル、シャルムで皆ビルハの産んだ子である。"},{"ref":"1Chr.7.14","start":13007014,"end":13007014,"break":"none","ruby":[[4,1,"こ"],[19,1,"おんな"],[21,1,"う"],[30,2,"かのじょ"],[40,1,"ちち"],[45,1,"う"]],"text":"マナセの子らはそのそばめであるスリヤの女の産んだアスリエル。彼女はまたギレアデの父マキルを産んだ。"},{"ref":"1Chr.7.15","start":13007015,"end":13007015,"break":"none","ruby":[[13,1,"いもうと"],[20,1,"もの"],[22,1,"つま"],[30,2,"ばんめ"],[33,1,"こ"],[51,1,"おんな"],[53,1,"こ"]],"text":"マキルはホパムとシュパムの妹マアカという者を妻にめとった。二番目の子はゼロペハデという。ゼロペハデには女の子だけがあった。"},{"ref":"1Chr.7.16","start":13007016,"end":13007016,"break":"none","ruby":[[4,1,"つま"],[9,1,"おとこ"],[11,1,"こ"],[13,1,"う"],[16,1,"な"],[22,1,"な"],[29,1,"おとうと"],[31,1,"な"],[43,1,"こ"]],"text":"マキルの妻マアカは男の子を産んで名をペレシと名づけた。その弟の名はシャレシ。シャレシの子らはウラムとラケムである。"},{"ref":"1Chr.7.17","start":13007017,"end":13007017,"break":"none","ruby":[[4,1,"こ"],[18,1,"こ"],[23,1,"こ"],[32,1,"こ"]],"text":"ウラムの子はベダン。これらはマナセの子マキルの子であるギレアデの子らである。"},{"ref":"1Chr.7.18","start":13007018,"end":13007018,"break":"none","ruby":[[2,1,"いもうと"],[25,1,"う"]],"text":"その妹ハンモレケテはイシホデ、アビエゼル、マヘラを産んだ。"},{"ref":"1Chr.7.19","start":13007019,"end":13007019,"break":"none","ruby":[[4,1,"こ"]],"text":"セミダの子らはアヒアン、シケム、リキ、アニアムである。"},{"ref":"1Chr.7.20","start":13007020,"end":13007020,"break":"paragraph","ruby":[[6,1,"こ"],[15,1,"こ"],[23,1,"こ"],[31,1,"こ"],[39,1,"こ"]],"text":"エフライムの子はシュテラ、その子はベレデ、その子はタハテ、その子はエラダ、その子はタハテ、"},{"ref":"1Chr.7.21","start":13007021,"end":13007021,"break":"none","ruby":[[2,1,"こ"],[10,1,"こ"],[32,2,"どじん"],[36,1,"ころ"],[44,1,"かれ"],[47,1,"くだ"],[50,1,"い"],[55,2,"かちく"],[58,1,"うば"]],"text":"その子はザバデ、その子はシュテラである。エゼルとエレアデはガテの土人らに殺された。これは彼らが下って行ってその家畜を奪おうとしたからである。"},{"ref":"1Chr.7.22","start":13007022,"end":13007022,"break":"none","ruby":[[0,1,"ちち"],[7,1,"ひ"],[8,1,"ひさ"],[16,1,"かな"],[25,2,"きょうだい"],[30,1,"き"],[32,1,"かれ"],[34,1,"なぐさ"]],"text":"父エフライムが日久しくこのために悲しんだので、その兄弟たちが来て彼を慰めた。"},{"ref":"1Chr.7.23","start":13007023,"end":13007023,"break":"none","ruby":[[11,1,"つま"],[22,1,"つま"],[28,1,"おとこ"],[30,1,"こ"],[32,1,"う"],[37,1,"な"],[43,1,"な"],[50,1,"いえ"],[52,1,"わざわい"]],"text":"そののち、エフライムは妻のところにはいった。妻ははらんで男の子を産み、その名をベリアと名づけた。その家に災があったからである。"},{"ref":"1Chr.7.24","start":13007024,"end":13007024,"break":"none","ruby":[[6,1,"むすめ"],[10,1,"うえ"],[12,1,"した"],[29,1,"た"]],"text":"エフライムの娘セラは上と下のベテホロンおよびウゼン・セラを建てた。"},{"ref":"1Chr.7.25","start":13007025,"end":13007025,"break":"none","ruby":[[4,1,"こ"],[11,1,"こ"],[19,1,"こ"],[26,1,"こ"]],"text":"ベリアの子はレパ、その子はレセフ、その子はテラ、その子はタハン、"},{"ref":"1Chr.7.26","start":13007026,"end":13007026,"break":"none","ruby":[[2,1,"こ"],[10,1,"こ"],[19,1,"こ"]],"text":"その子はラダン、その子はアミホデ、その子はエリシャマ、"},{"ref":"1Chr.7.27","start":13007027,"end":13007027,"break":"none","ruby":[[2,1,"こ"],[9,1,"こ"]],"text":"その子はヌン、その子はヨシュア。"},{"ref":"1Chr.7.28","start":13007028,"end":13007028,"break":"none","ruby":[[6,2,"しそん"],[9,2,"りょうち"],[12,2,"じゅうしょ"],[21,2,"むらむら"],[26,1,"ひがし"],[28,1,"ほう"],[36,1,"にし"],[38,1,"ほう"],[47,2,"むらむら"],[58,2,"むらむら"],[66,2,"むらむら"]],"text":"エフライムの子孫の領地と住所はベテルとその村々、また東の方ではナアラン、西の方ではゲゼルとその村々、またシケムとその村々、アワとその村々。"},{"ref":"1Chr.7.29","start":13007029,"end":13007029,"break":"none","ruby":[[6,2,"しそん"],[9,2,"こっきょう"],[12,1,"そ"],[24,2,"むらむら"],[34,2,"むらむら"],[44,2,"むらむら"],[52,2,"むらむら"],[62,1,"こ"],[67,2,"しそん"],[74,1,"ところ"],[76,1,"す"]],"text":"またマナセの子孫の国境に沿って、ベテシャンとその村々、タアナクとその村々、メギドンとその村々、ドルとその村々で、イスラエルの子ヨセフの子孫はこれらの所に住んだ。"},{"ref":"1Chr.7.30","start":13007030,"end":13007030,"break":"paragraph","ruby":[[4,1,"こ"],[27,2,"しまい"]],"text":"アセルの子らはイムナ、イシワ、エスイ、ベリアおよびその姉妹セラ。"},{"ref":"1Chr.7.31","start":13007031,"end":13007031,"break":"none","ruby":[[4,1,"こ"],[29,1,"ちち"]],"text":"ベリアの子らはヘベルとマルキエル。マルキエルはビルザヒテの父である。"},{"ref":"1Chr.7.32","start":13007032,"end":13007032,"break":"none","ruby":[[22,2,"しまい"],[28,1,"う"]],"text":"ヘベルはヤフレテ、ショメル、ホタムおよびその姉妹シュアを生んだ。"},{"ref":"1Chr.7.33","start":13007033,"end":13007033,"break":"none","ruby":[[5,1,"こ"],[31,1,"こ"]],"text":"ヤフレテの子らはパサク、ビムハル、アシワテ。これらはヤレフテの子らである。"},{"ref":"1Chr.7.34","start":13007034,"end":13007034,"break":"none","ruby":[[0,1,"かれ"],[2,2,"きょうだい"],[9,1,"こ"]],"text":"彼の兄弟ショメルの子らはロガ、ホバおよびアラム。"},{"ref":"1Chr.7.35","start":13007035,"end":13007035,"break":"none","ruby":[[5,2,"きょうだい"],[11,1,"こ"]],"text":"ショメルの兄弟ヘレムの子らはゾパ、イムナ、シレシ、アマル。"},{"ref":"1Chr.7.36","start":13007036,"end":13007036,"break":"none","ruby":[[3,1,"こ"]],"text":"ゾパの子らはスア、ハルネペル、シュアル、ベリ、イムラ、"},{"ref":"1Chr.7.37","start":13007037,"end":13007037,"break":"none","text":"ベゼル、ホド、シャンマ、シルシャ、イテラン、ベエラ。"},{"ref":"1Chr.7.38","start":13007038,"end":13007038,"break":"none","ruby":[[4,1,"こ"]],"text":"エテルの子らはエフンネ、ピスパおよびアラ。"},{"ref":"1Chr.7.39","start":13007039,"end":13007039,"break":"none","ruby":[[3,1,"こ"]],"text":"ウラの子らはアラ、ハニエル、およびリヂア。"},{"ref":"1Chr.7.40","start":13007040,"end":13007040,"break":"none","ruby":[[4,1,"みな"],[9,2,"しそん"],[18,2,"しぞく"],[21,1,"ちょう"],[28,1,"だい"],[29,2,"ゆうし"],[48,2,"けいず"],[54,1,"かぞ"],[59,1,"もの"],[66,1,"で"],[70,1,"たたか"],[72,1,"もの"],[74,1,"かず"],[80,1,"にん"]],"text":"これらは皆アセルの子孫であって、その氏族の長、えりぬきの大勇士、つかさたちのかしらであった。その系図によって数えられた者で、いくさに出てよく戦う者の数は二万六千人であった。"}]