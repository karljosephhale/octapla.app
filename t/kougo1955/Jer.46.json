[{"ref":"Jer.46.1","start":24046001,"end":24046001,"break":"paragraph","ruby":[[5,1,"くに"],[7,1,"こと"],[12,3,"よげんしゃ"],[20,1,"のぞ"],[23,1,"しゅ"],[25,2,"ことば"]],"text":"もろもろの国の事について預言者エレミヤに臨んだ主の言葉。"},{"ref":"Jer.46.2","start":24046002,"end":24046002,"break":"paragraph","ruby":[[5,1,"こと"],[15,1,"かわ"],[29,1,"ちか"],[39,1,"おう"],[46,2,"ぐんぜい"],[49,1,"こと"],[61,1,"おう"],[66,1,"こ"],[74,1,"ねん"],[82,1,"おう"],[91,1,"う"],[93,1,"やぶ"],[104,2,"ことば"],[107,1,"つぎ"]],"text":"エジプトの事、すなわちユフラテ川のほとりにあるカルケミシの近くにいるエジプトの王パロ・ネコの軍勢の事について。これはユダの王ヨシヤの子エホヤキムの四年に、バビロンの王ネブカデレザルが撃ち破ったものである。その言葉は次のとおりである、"},{"ref":"Jer.46.3","start":24046003,"end":24046003,"break":"stanza","ruby":[[1,2,"おおだて"],[4,2,"こだて"],[8,1,"そな"],[11,1,"すす"],[14,1,"たたか"]],"text":"「大盾と小盾とを備え、進んで戦え。"},{"ref":"Jer.46.4","start":24046004,"end":24046004,"break":"line","breaks":[[18,"line"],[29,"line"]],"ruby":[[0,2,"きへい"],[4,1,"うま"],[6,2,"せんしゃ"],[13,1,"うま"],[15,1,"の"],[26,1,"た"],[40,1,"き"]],"text":"騎兵よ、馬を戦車につなぎ、馬に乗れ。かぶとをかぶって立て。ほこをみがき、よろいを着よ。"},{"ref":"Jer.46.5","start":24046005,"end":24046005,"break":"line","breaks":[[21,"line"],[42,"line"],[59,"line"]],"ruby":[[4,1,"み"],[8,1,"なに"],[12,1,"かれ"],[15,1,"おそ"],[18,1,"しりぞ"],[23,2,"ゆうし"],[28,1,"う"],[30,1,"やぶ"],[38,1,"に"],[48,1,"む"],[59,1,"おそ"],[62,1,"かれ"],[65,2,"しゅうい"],[71,1,"しゅ"],[73,1,"い"]],"text":"わたしは見たが、何ゆえか彼らは恐れて退き、その勇士たちは打ち敗られ、あわてて逃げて、うしろをふり向くこともしない、――恐れが彼らの周囲にあると主は言われる。"},{"ref":"Jer.46.6","start":24046006,"end":24046006,"break":"line","breaks":[[15,"line"],[30,"line"],[44,"line"]],"ruby":[[0,2,"あしばや"],[3,1,"もの"],[5,1,"に"],[15,2,"ゆうし"],[30,1,"きた"],[32,1,"ほう"],[38,1,"かわ"],[44,1,"かれ"],[51,1,"たお"]],"text":"足早き者も逃げることができず、勇士ものがれることができない。北の方、ユフラテ川のほとりで彼らはつまずき倒れた。"},{"ref":"Jer.46.7","start":24046007,"end":24046007,"break":"stanza","breaks":[[16,"line"]],"ruby":[[5,1,"かわ"],[16,2,"かわがわ"],[25,1,"みず"],[31,1,"もの"]],"text":"あのナイル川のようにわきあがり、川々のように、その水のさかまく者はだれか。"},{"ref":"Jer.46.8","start":24046008,"end":24046008,"break":"line","breaks":[[19,"line"],[34,"line"],[57,"line"]],"ruby":[[8,1,"かわ"],[21,1,"みず"],[23,2,"かわがわ"],[40,1,"い"],[47,1,"のぼ"],[51,1,"ち"],[57,2,"まちまち"],[65,1,"す"],[67,1,"もの"],[69,1,"ほろ"]],"text":"エジプトはナイル川のようにわきあがり、その水は川々のようにさかまく。そしてこれは言う、わたしは上って、地をおおい、町々とそのうちに住む者を滅ぼそう。"},{"ref":"Jer.46.9","start":24046009,"end":24046009,"break":"line","breaks":[[15,"line"],[38,"line"]],"ruby":[[0,1,"うま"],[3,1,"すす"],[6,1,"くるま"],[9,1,"はげ"],[12,1,"はし"],[15,2,"ゆうし"],[19,1,"たて"],[21,1,"と"],[38,1,"ゆみ"],[40,1,"たく"],[43,1,"ひ"],[51,1,"すす"],[53,1,"で"]],"text":"馬よ、進め、車よ、激しく走れ。勇士よ、盾を取るエチオピヤびとと、プテびとよ、弓を巧みに引くルデびとよ、進み出よ。"},{"ref":"Jer.46.10","start":24046010,"end":24046010,"break":"line","breaks":[[17,"line"],[29,"line"],[44,"line"],[54,"line"],[62,"line"],[86,"line"]],"ruby":[[2,1,"ひ"],[4,2,"ばんぐん"],[7,1,"かみ"],[9,1,"しゅ"],[11,1,"ひ"],[17,1,"しゅ"],[22,1,"むく"],[27,1,"ひ"],[31,1,"てき"],[41,1,"ひ"],[48,1,"た"],[51,1,"あ"],[54,1,"かれ"],[57,1,"ち"],[59,1,"よ"],[62,2,"ばんぐん"],[65,1,"かみ"],[67,1,"しゅ"],[70,1,"きた"],[72,1,"ち"],[79,1,"かわ"]],"text":"その日は万軍の神、主の日であって、主があだを報いられる日、その敵にあだをかえされる日だ。つるぎは食べて飽き、彼らの血に酔う。万軍の神、主が、北の地で、ユフラテ川のほとりで、ほふることをなされるからだ。"},{"ref":"Jer.46.11","start":24046011,"end":24046011,"break":"line","breaks":[[13,"line"],[27,"line"],[45,"line"]],"ruby":[[10,1,"むすめ"],[18,1,"のぼ"],[21,2,"にゅうこう"],[24,1,"と"],[31,1,"おお"],[34,1,"くすり"],[36,1,"もち"]],"text":"おとめなるエジプトの娘よ、ギレアデに上って乳香を取れ。あなたは多くの薬を用いても、むだだ。あなたは、いやされることはない。"},{"ref":"Jer.46.12","start":24046012,"end":24046012,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[4,1,"はじ"],[6,2,"くにぐに"],[9,1,"きこ"],[19,1,"さけ"],[22,1,"ち"],[24,1,"み"],[30,2,"ゆうし"],[33,2,"ゆうし"],[42,1,"とも"],[44,1,"たお"]],"text":"あなたの恥は国々に聞えている、あなたの叫びは地に満ちている。勇士が勇士につまずいて、共に倒れたからである」。"},{"ref":"Jer.46.13","start":24046013,"end":24046013,"break":"paragraph","ruby":[[5,1,"おう"],[14,1,"き"],[22,1,"ち"],[24,1,"う"],[30,1,"こと"],[36,1,"しゅ"],[38,3,"よげんしゃ"],[47,1,"つ"],[53,2,"ことば"]],"text":"バビロンの王ネブカデレザルが来て、エジプトの地を撃とうとする事について、主が預言者エレミヤにお告げになった言葉、"},{"ref":"Jer.46.14","start":24046014,"end":24046014,"break":"stanza","breaks":[[19,"line"],[39,"line"],[51,"line"]],"ruby":[[6,1,"の"],[14,1,"つ"],[16,1,"しめ"],[31,1,"つ"],[33,1,"しめ"],[36,1,"い"],[40,1,"かた"],[42,1,"た"],[46,1,"そな"],[59,2,"しゅうい"],[63,1,"ほろ"],[66,1,"つく"]],"text":"「エジプトで宣べ、ミグドルで告げ示し、またメンピスとタパネスに告げ示して言え、『堅く立って、備えせよ、つるぎがあなたの周囲を、滅ぼし尽すからだ』。"},{"ref":"Jer.46.15","start":24046015,"end":24046015,"break":"line","breaks":[[14,"line"],[33,"line"]],"ruby":[[18,2,"おうし"],[24,1,"た"],[36,1,"しゅ"],[41,1,"たお"]],"text":"なぜ、アピスはのがれたのか。あなたの雄牛は、なぜ立たなかったのか。それは主がこれを倒されたからだ。"},{"ref":"Jer.46.16","start":24046016,"end":24046016,"break":"line","breaks":[[22,"line"],[36,"line"],[57,"line"]],"ruby":[[4,1,"ぞく"],[7,1,"おお"],[10,1,"へい"],[18,1,"たお"],[25,1,"たがい"],[27,1,"い"],[32,1,"た"],[47,1,"もの"],[53,1,"さ"],[62,1,"たみ"],[64,1,"かえ"],[67,2,"こきょう"],[70,1,"ち"],[72,1,"い"]],"text":"あなたに属する多くの兵は、つまずいて倒れた。そして互に言った、『立てよ、われわれは、しえたげる者のつるぎを避けて、われわれの民に帰り、故郷の地へ行こう』と。"},{"ref":"Jer.46.17","start":24046017,"end":24046017,"break":"line","breaks":[[12,"line"]],"ruby":[[5,1,"おう"],[9,1,"な"],[13,2,"こうき"],[16,1,"いっ"],[19,1,"さわ"],[23,1,"もの"],[26,1,"よ"]],"text":"エジプトの王パロの名を、『好機を逸する騒がしい者』と呼べ。"},{"ref":"Jer.46.18","start":24046018,"end":24046018,"break":"stanza","breaks":[[16,"line"],[26,"line"],[42,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"な"],[9,1,"おう"],[11,1,"い"],[20,1,"い"],[26,1,"かれ"],[28,2,"やまやま"],[42,1,"うみ"],[56,1,"きた"],[58,1,"のぞ"]],"text":"万軍の主という名の王は言われる、わたしは生きている、彼は山々のうちのタボルのように、海のほとりのカルメルのように来り臨む。"},{"ref":"Jer.46.19","start":24046019,"end":24046019,"break":"line","breaks":[[10,"line"],[24,"line"],[36,"line"]],"ruby":[[5,1,"す"],[7,1,"たみ"],[10,1,"とら"],[17,2,"にもつ"],[20,1,"そな"],[29,1,"あ"],[31,1,"ち"],[36,2,"はいきょ"],[42,1,"す"],[44,1,"ひと"]],"text":"エジプトに住む民よ、捕われのために荷物を備えよ。メンピスは荒れ地となり、廃虚となって住む人もなくなる。"},{"ref":"Jer.46.20","start":24046020,"end":24046020,"break":"line","breaks":[[14,"line"]],"ruby":[[5,1,"うつく"],[8,1,"めす"],[10,1,"こ"],[11,1,"うし"],[17,1,"きた"],[21,1,"うし"],[25,1,"き"]],"text":"エジプトは美しい雌の子牛だ、しかし北から、牛ばえが来て、それにとまった。"},{"ref":"Jer.46.21","start":24046021,"end":24046021,"break":"line","breaks":[[23,"line"],[47,"line"]],"ruby":[[7,1,"やとい"],[8,1,"へい"],[13,1,"こ"],[16,1,"こ"],[17,1,"うし"],[23,1,"かれ"],[28,1,"かえ"],[31,1,"とも"],[33,1,"に"],[36,1,"た"],[47,1,"かれ"],[50,2,"さいなん"],[53,1,"ひ"],[57,1,"ばっ"],[62,1,"とき"],[64,1,"き"]],"text":"そのうちにいる雇兵でさえ、肥えた子牛のようだ。彼らはふり返って共に逃げ、立つことをしなかった。彼らの災難の日、その罰せられる時が来たからだ。"},{"ref":"Jer.46.22","start":24046022,"end":24046022,"break":"line","breaks":[[18,"line"],[33,"line"]],"ruby":[[0,1,"かれ"],[2,1,"に"],[4,1,"さ"],[12,1,"おと"],[20,1,"てき"],[22,2,"ぐんぜい"],[25,1,"ひき"],[28,1,"かれ"],[30,1,"のぞ"],[47,1,"く"]],"text":"彼は逃げ去るへびのような音をたてる。その敵が軍勢を率いて彼に臨み、きこりのように、おのをもって来るからだ。"},{"ref":"Jer.46.23","start":24046023,"end":24046023,"break":"line","breaks":[[20,"line"],[28,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かれ"],[5,1,"はやし"],[10,1,"い"],[12,1,"こ"],[23,1,"き"],[25,1,"たお"],[28,1,"かれ"],[37,1,"おお"],[40,1,"かぞ"],[52,1,"しゅ"],[54,1,"い"]],"text":"彼らは彼の林がいかに入り込みがたくとも、それを切り倒す。彼らはいなごよりも多く、数えがたいからであると、主は言われる。"},{"ref":"Jer.46.24","start":24046024,"end":24046024,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"むすめ"],[13,1,"う"],[16,1,"きた"],[21,1,"たみ"],[23,1,"て"],[25,1,"わた"]],"text":"エジプトの娘ははずかしめを受け、北からくる民の手に渡される」。"},{"ref":"Jer.46.25","start":24046025,"end":24046025,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[13,1,"い"],[19,1,"み"],[46,2,"かみがみ"],[51,1,"おう"],[62,1,"かれ"],[64,1,"たの"],[66,1,"もの"],[69,1,"ばっ"]],"text":"万軍の主、イスラエルの神は言われた、「見よ、わたしはテーベのアモンと、パロと、エジプトとその神々とその王たち、すなわちパロと彼を頼む者とを罰する。"},{"ref":"Jer.46.26","start":24046026,"end":24046026,"break":"none","ruby":[[4,1,"かれ"],[10,1,"いのち"],[12,1,"もと"],[15,1,"もの"],[17,1,"て"],[25,1,"おう"],[34,1,"て"],[39,2,"けらい"],[44,1,"て"],[46,1,"わた"],[51,1,"のち"],[58,1,"むかし"],[63,1,"ひと"],[65,1,"す"],[67,1,"ところ"],[73,1,"しゅ"],[75,1,"い"]],"text":"わたしは彼らを、その命を求める者の手と、バビロンの王ネブカデレザルの手と、その家来たちの手に渡す。その後、エジプトは昔のように人の住む所となると、主は言われる。"},{"ref":"Jer.46.27","start":24046027,"end":24046027,"break":"stanza","breaks":[[21,"line"],[36,"line"],[54,"line"],[72,"line"],[78,"line"],[101,"line"]],"ruby":[[12,1,"おそ"],[28,1,"おどろ"],[36,1,"み"],[47,1,"とお"],[51,1,"すく"],[58,2,"しそん"],[63,1,"とら"],[65,1,"うつ"],[69,1,"ち"],[72,1,"すく"],[82,1,"かえ"],[94,1,"やす"],[101,1,"かれ"],[103,1,"おそ"],[108,1,"もの"]],"text":"わたしのしもべヤコブよ、恐れることはない、イスラエルよ、驚くことはない。見よ、わたしがあなたを遠くから救い、あなたの子孫をその捕え移された地から救うからだ。ヤコブは帰ってきて、おだやかに、安らかになり、彼を恐れさせる者はない。"},{"ref":"Jer.46.28","start":24046028,"end":24046028,"break":"line","breaks":[[19,"line"],[40,"line"],[56,"line"],[67,"line"],[86,"line"],[109,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[19,1,"おそ"],[32,1,"とも"],[48,1,"お"],[53,2,"くにぐに"],[61,1,"ほろ"],[64,1,"つく"],[74,1,"ほろ"],[77,1,"つく"],[90,1,"ただ"],[93,1,"みち"],[95,1,"したが"],[103,1,"こ"],[109,1,"けっ"],[112,1,"ばっ"]],"text":"主は言われる、わたしのしもべヤコブよ、恐れることはない、わたしが共にいるからだ。わたしはあなたを追いやった国々をことごとく滅ぼし尽す。しかしあなたを滅ぼし尽すことはしない。わたしは正しい道に従って、あなたを懲らしめる、決して罰しないではおかない」。"}]