[{"ref":"Jer.15.1","start":24015001,"end":24015001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[29,1,"まえ"],[31,1,"た"],[40,1,"こころ"],[44,1,"たみ"],[46,1,"かえり"],[51,1,"かれ"],[58,1,"まえ"],[61,1,"お"],[63,1,"だ"],[69,1,"さ"]],"text":"主はわたしに言われた、「たといモーセとサムエルとがわたしの前に立っても、わたしの心はこの民を顧みない。彼らをわたしの前から追い出し、ここを去らせよ。"},{"ref":"Jer.15.2","start":24015002,"end":24015002,"break":"none","breaks":[[44,"stanza"],[55,"line"],[69,"line"],[85,"line"],[101,"line"]],"ruby":[[2,1,"かれ"],[15,1,"い"],[28,1,"たず"],[35,1,"かれ"],[38,1,"い"],[45,1,"しゅ"],[49,1,"おお"],[55,2,"えきびょう"],[58,1,"さだ"],[63,1,"もの"],[65,2,"えきびょう"],[73,1,"さだ"],[78,1,"もの"],[89,1,"さだ"],[94,1,"もの"],[105,1,"さだ"],[110,1,"もの"],[116,1,"い"]],"text":"もし彼らが、『われわれはどこに行けばよいのか』とあなたに尋ねるならば、彼らに言いなさい、『主はこう仰せられる、疫病に定められた者は疫病に、つるぎに定められた者はつるぎに、ききんに定められた者はききんに、とりこに定められた者はとりこに行く』。"},{"ref":"Jer.15.3","start":24015003,"end":24015003,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"おお"],[15,1,"もの"],[20,1,"かれ"],[23,1,"ばっ"],[39,1,"ころ"],[42,1,"いぬ"],[51,1,"そら"],[53,1,"とり"],[55,1,"ち"],[57,1,"けもの"],[62,1,"く"],[64,1,"ほろ"]],"text":"主は仰せられる、わたしは四つの物をもって彼らを罰する。すなわち、つるぎをもって殺し、犬をもってかませ、空の鳥と地の獣をもって食い滅ぼさせる。"},{"ref":"Jer.15.4","start":24015004,"end":24015004,"break":"none","ruby":[[5,1,"おう"],[11,1,"こ"],[25,1,"おこな"],[36,1,"かれ"],[39,1,"ち"],[45,1,"くに"],[47,1,"み"],[49,1,"おそ"]],"text":"またユダの王ヒゼキヤの子マナセが、エルサレムでした行いのゆえに、わたしは彼らを地のすべての国が見て恐れおののくものとする。"},{"ref":"Jer.15.5","start":24015005,"end":24015005,"break":"paragraph","breaks":[[24,"line"],[42,"line"]],"ruby":[[34,1,"なげ"],[47,1,"かえ"],[55,2,"あんぴ"],[58,1,"と"]],"text":"エルサレムよ、だれがあなたをあわれむであろうか。だれがあなたのために嘆くであろうか。だれがふり返って、あなたの安否を問うであろうか。"},{"ref":"Jer.15.6","start":24015006,"end":24015006,"break":"line","breaks":[[19,"line"],[32,"line"],[55,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[15,1,"す"],[26,1,"しりぞ"],[29,1,"い"],[41,1,"て"],[43,1,"の"],[50,1,"ほろ"],[67,1,"あ"]],"text":"主は言われる、あなたはわたしを捨てた。そしてますます退いて行く。それゆえ、わたしは手を伸べてあなたを滅ぼした。わたしはあわれむことには飽きた。"},{"ref":"Jer.15.7","start":24015007,"end":24015007,"break":"line","breaks":[[11,"line"],[23,"line"],[39,"line"],[51,"line"]],"ruby":[[6,1,"ち"],[8,1,"もん"],[11,1,"みの"],[13,1,"かれ"],[19,1,"わ"],[23,1,"かれ"],[28,1,"みち"],[30,1,"はな"],[43,1,"かれ"],[46,1,"こ"],[48,1,"うば"],[53,1,"たみ"],[55,1,"ほろ"]],"text":"わたしはこの地の門で、箕で彼らをあおぎ分けた。彼らがその道を離れなかったので、わたしは彼らの子を奪い、わが民を滅ぼした。"},{"ref":"Jer.15.8","start":24015008,"end":24015008,"break":"line","breaks":[[12,"line"],[24,"line"],[43,"line"],[54,"line"]],"ruby":[[4,1,"かれ"],[7,2,"かふ"],[10,1,"かず"],[12,1,"はま"],[15,1,"すな"],[19,1,"おお"],[28,2,"まひる"],[32,1,"ほろ"],[35,1,"もの"],[37,1,"つ"],[43,2,"わかもの"],[47,1,"はは"],[54,1,"おどろ"],[57,1,"おそ"],[65,1,"はは"]],"text":"わたしは彼らの寡婦の数を浜べの砂よりも多くした。わたしは真昼に、滅ぼす者を連れてきて、若者らの母たちをせめ、驚きと恐れを、にわかに母たちにおこした。"},{"ref":"Jer.15.9","start":24015009,"end":24015009,"break":"line","breaks":[[21,"line"],[39,"line"],[51,"line"],[71,"line"]],"ruby":[[1,1,"にん"],[3,1,"こ"],[5,1,"う"],[8,1,"おんな"],[11,1,"よわ"],[13,1,"おとろ"],[17,1,"いき"],[18,1,"た"],[23,1,"ひる"],[30,2,"かのじょ"],[33,1,"ひ"],[35,1,"ぼっ"],[39,2,"かのじょ"],[42,1,"は"],[53,1,"のこ"],[56,1,"もの"],[62,1,"てき"],[68,1,"わた"],[71,1,"しゅ"],[73,1,"い"]],"text":"七人の子を産んだ女は、弱り衰えて、息絶え、まだ昼であったが、彼女の日は没した。彼女は恥じ、うろたえた。その残りの者は、これを敵のつるぎに渡すと主は言われる」。"},{"ref":"Jer.15.10","start":24015010,"end":24015010,"break":"paragraph","ruby":[[15,1,"はは"],[30,1,"う"],[36,2,"ぜんこく"],[39,1,"ひと"],[45,1,"あらそ"],[52,1,"せ"],[60,1,"ひと"],[62,1,"か"],[71,1,"ひと"],[73,1,"か"],[84,1,"みな"]],"text":"ああ、わたしはわざわいだ。わが母よ、あなたは、なぜ、わたしを産んだのか。全国の人はわたしと争い、わたしを攻める。わたしは人に貸したこともなく、人に借りたこともないのに、皆わたしをのろう。"},{"ref":"Jer.15.11","start":24015011,"end":24015011,"break":"none","ruby":[[0,1,"しゅ"],[9,1,"かれ"],[12,2,"こうふく"],[19,1,"いの"],[21,1,"もと"],[27,1,"てき"],[34,1,"なや"],[41,1,"わざわい"],[71,1,"かれ"]],"text":"主よ、もしわたしが彼らの幸福をあなたに祈り求めず、また敵のため、その悩みのときと、災のときに、わたしがあなたにとりなしをしなかったのであれば、彼らののろいも、やむをえないでしょう。"},{"ref":"Jer.15.12","start":24015012,"end":24015012,"break":"none","ruby":[[0,1,"ひと"],[2,1,"てつ"],[5,1,"きた"],[10,1,"てつ"],[12,2,"せいどう"],[15,1,"くだ"]],"text":"人は鉄を、北からくる鉄や青銅を砕くことができましょうか。"},{"ref":"Jer.15.13","start":24015013,"end":24015013,"break":"paragraph","ruby":[[9,1,"とみ"],[11,1,"たから"],[18,1,"もの"],[22,1,"ほか"],[24,1,"あた"],[28,2,"だいか"],[31,1,"う"],[53,1,"つみ"],[60,2,"りょういき"],[62,1,"ない"],[67,1,"ところ"],[74,1,"おこ"]],"text":"「わたしはあなたの富と宝を、ぶんどり物として他に与える。代価を受けることはできない。それはあなたのすべての罪によるので、領域内のいたる所にこのことが起る。"},{"ref":"Jer.15.14","start":24015014,"end":24015014,"break":"none","ruby":[[8,1,"し"],[12,1,"ち"],[19,1,"てき"],[21,1,"つか"],[31,1,"いか"],[37,1,"ひ"],[39,1,"てん"],[49,1,"も"],[51,1,"つづ"]],"text":"わたしはあなたの知らない地で、あなたの敵に仕えさせる。わたしの怒りによって火は点じられ、いつまでも燃え続けるからである」。"},{"ref":"Jer.15.15","start":24015015,"end":24015015,"break":"paragraph","breaks":[[16,"line"],[35,"line"],[52,"line"],[63,"line"],[79,"line"],[91,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"し"],[20,1,"おぼ"],[27,1,"かえり"],[39,2,"はくがい"],[43,1,"もの"],[49,1,"かえ"],[56,2,"かんよう"],[67,1,"と"],[69,1,"さ"],[97,1,"う"],[102,1,"し"]],"text":"主よ、あなたは知っておられます。わたしを覚え、わたしを顧みてください。わたしを迫害する者に、あだを返し、あなたの寛容によって、わたしを取り去らないでください。わたしがあなたのために、はずかしめを受けるのを知ってください。"},{"ref":"Jer.15.16","start":24015016,"end":24015016,"break":"line","breaks":[[23,"line"],[38,"line"],[50,"line"],[72,"line"]],"ruby":[[5,2,"ことば"],[8,1,"あた"],[17,1,"た"],[24,2,"ことば"],[32,1,"よろこ"],[38,1,"こころ"],[40,1,"たの"],[50,2,"ばんぐん"],[53,1,"かみ"],[55,1,"しゅ"],[67,1,"な"],[80,1,"もの"]],"text":"わたしはみ言葉を与えられて、それを食べました。み言葉は、わたしに喜びとなり、心の楽しみとなりました。万軍の神、主よ、わたしは、あなたの名をもってとなえられている者です。"},{"ref":"Jer.15.17","start":24015017,"end":24015017,"break":"line","breaks":[[16,"line"],[34,"line"],[49,"line"],[64,"line"],[74,"line"]],"ruby":[[4,1,"わら"],[10,1,"ひと"],[26,1,"よろこ"],[53,1,"て"],[59,1,"うえ"],[68,1,"いきどお"],[78,1,"み"]],"text":"わたしは笑いさざめく人のつどいにすわることなく、また喜ぶことをせず、ただひとりですわっていました。あなたの手がわたしの上にあり、あなたが憤りをもってわたしを満たされたからです。"},{"ref":"Jer.15.18","start":24015018,"end":24015018,"break":"line","breaks":[[16,"line"],[32,"line"],[53,"line"]],"ruby":[[8,1,"いた"],[11,1,"と"],[16,1,"きず"],[18,1,"おも"],[44,1,"みず"],[49,1,"ひと"],[51,1,"あざむ"],[53,2,"たにがわ"]],"text":"どうしてわたしの痛みは止まらず、傷は重くて、なおらないのですか。あなたはわたしにとって、水がなくて人を欺く谷川のようになられるのですか。"},{"ref":"Jer.15.19","start":24015019,"end":24015019,"break":"paragraph","breaks":[[14,"stanza"],[30,"line"],[51,"line"],[74,"line"],[86,"line"],[98,"line"],[113,"line"]],"ruby":[[4,1,"しゅ"],[8,1,"おお"],[21,1,"かえ"],[43,1,"まえ"],[45,1,"た"],[66,1,"い"],[74,2,"きちょう"],[80,1,"い"],[90,1,"くち"],[98,1,"かれ"],[105,1,"ところ"],[107,1,"かえ"],[120,1,"かれ"],[123,1,"ところ"],[125,1,"かえ"]],"text":"それゆえ主はこう仰せられる、「もしあなたが帰ってくるならば、もとのようにして、わたしの前に立たせよう。もしあなたが、つまらないことを言うのをやめて、貴重なことを言うならば、わたしの口のようになる。彼らはあなたの所に帰ってくる。しかしあなたが彼らの所に帰るのではない。"},{"ref":"Jer.15.20","start":24015020,"end":24015020,"break":"line","breaks":[[15,"line"],[27,"line"],[39,"line"],[53,"line"],[73,"line"]],"ruby":[[10,1,"たみ"],[12,1,"まえ"],[15,2,"けんご"],[18,2,"せいどう"],[21,2,"じょうへき"],[27,1,"かれ"],[34,1,"せ"],[43,1,"か"],[61,1,"とも"],[70,1,"たす"],[77,1,"すく"],[86,1,"しゅ"],[88,1,"い"]],"text":"わたしはあなたをこの民の前に、堅固な青銅の城壁にする。彼らがあなたを攻めても、あなたに勝つことはできない。わたしがあなたと共にいて、あなたを助け、あなたを救うからであると、主は言われる。"},{"ref":"Jer.15.21","start":24015021,"end":24015021,"break":"line","breaks":[[17,"line"]],"ruby":[[8,2,"あくにん"],[11,1,"て"],[14,1,"すく"],[17,3,"むじひ"],[21,1,"ひと"],[23,1,"て"]],"text":"わたしはあなたを悪人の手から救い、無慈悲な人の手からあがなう」。"}]