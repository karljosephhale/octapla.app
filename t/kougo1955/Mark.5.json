[{"ref":"Mark.5.1","start":41005001,"end":41005001,"break":"paragraph","ruby":[[4,1,"かれ"],[7,1,"うみ"],[9,1,"む"],[12,1,"ぎし"],[17,1,"びと"],[19,1,"ち"],[21,1,"つ"]],"text":"こうして彼らは海の向こう岸、ゲラサ人の地に着いた。"},{"ref":"Mark.5.2","start":41005002,"end":41005002,"break":"none","ruby":[[9,1,"ふね"],[26,1,"れい"],[32,1,"ひと"],[34,2,"はかば"],[38,1,"で"],[47,2,"であ"]],"text":"それから、イエスが舟からあがられるとすぐに、けがれた霊につかれた人が墓場から出てきて、イエスに出会った。"},{"ref":"Mark.5.3","start":41005003,"end":41005003,"break":"none","ruby":[[2,1,"ひと"],[4,2,"はかば"],[23,1,"くさり"],[28,1,"かれ"],[36,1,"お"]],"text":"この人は墓場をすみかとしており、もはやだれも、鎖でさえも彼をつなぎとめて置けなかった。"},{"ref":"Mark.5.4","start":41005004,"end":41005004,"break":"none","ruby":[[0,1,"かれ"],[6,1,"あし"],[10,1,"くさり"],[19,1,"くさり"],[21,1,"ひ"],[27,1,"あし"],[31,1,"くだ"],[39,1,"かれ"],[41,1,"おさ"]],"text":"彼はたびたび足かせや鎖でつながれたが、鎖を引きちぎり、足かせを砕くので、だれも彼を押えつけることができなかったからである。"},{"ref":"Mark.5.5","start":41005005,"end":41005005,"break":"none","ruby":[[4,2,"よるひる"],[11,2,"はかば"],[14,1,"やま"],[16,1,"さけ"],[23,1,"いし"],[25,2,"じぶん"],[32,1,"きず"]],"text":"そして、夜昼たえまなく墓場や山で叫びつづけて、石で自分のからだを傷つけていた。"},{"ref":"Mark.5.6","start":41005006,"end":41005006,"break":"none","ruby":[[7,1,"ひと"],[13,1,"とお"],[17,1,"み"],[20,1,"はし"],[22,1,"よ"],[25,1,"はい"]],"text":"ところが、この人がイエスを遠くから見て、走り寄って拝し、"},{"ref":"Mark.5.7","start":41005007,"end":41005007,"break":"none","ruby":[[0,2,"おおごえ"],[3,1,"さけ"],[6,1,"い"],[13,1,"たか"],[15,1,"かみ"],[17,1,"こ"],[34,1,"かか"],[44,1,"かみ"],[46,1,"ちか"],[50,1,"ねが"],[64,1,"くる"]],"text":"大声で叫んで言った、「いと高き神の子イエスよ、あなたはわたしとなんの係わりがあるのです。神に誓ってお願いします。どうぞ、わたしを苦しめないでください」。"},{"ref":"Mark.5.8","start":41005008,"end":41005008,"break":"none","ruby":[[14,1,"れい"],[19,1,"ひと"],[22,1,"で"],[24,1,"い"],[28,1,"い"]],"text":"それは、イエスが、「けがれた霊よ、この人から出て行け」と言われたからである。"},{"ref":"Mark.5.9","start":41005009,"end":41005009,"break":"none","ruby":[[2,1,"かれ"],[11,2,"なまえ"],[16,1,"たず"],[29,1,"い"],[34,1,"おお"],[45,1,"こた"]],"text":"また彼に、「なんという名前か」と尋ねられると、「レギオンと言います。大ぜいなのですから」と答えた。"},{"ref":"Mark.5.10","start":41005010,"end":41005010,"break":"none","ruby":[[4,2,"じぶん"],[11,2,"とち"],[15,1,"お"],[17,1,"だ"],[30,1,"ねが"]],"text":"そして、自分たちをこの土地から追い出さないようにと、しきりに願いつづけた。"},{"ref":"Mark.5.11","start":41005011,"end":41005011,"break":"none","ruby":[[6,1,"やま"],[8,2,"ちゅうふく"],[12,1,"ぶた"],[14,2,"たいぐん"],[17,1,"か"]],"text":"さて、そこの山の中腹に、豚の大群が飼ってあった。"},{"ref":"Mark.5.12","start":41005012,"end":41005012,"break":"none","ruby":[[0,1,"れい"],[6,1,"ねが"],[9,1,"い"],[21,1,"ぶた"],[35,1,"なか"],[37,1,"おく"]],"text":"霊はイエスに願って言った、「わたしどもを、豚にはいらせてください。その中へ送ってください」。"},{"ref":"Mark.5.13","start":41005013,"end":41005013,"break":"none","ruby":[[5,1,"ゆる"],[18,1,"れい"],[22,1,"で"],[24,1,"い"],[28,1,"ぶた"],[30,1,"なか"],[35,1,"こ"],[45,1,"む"],[50,1,"ひき"],[64,1,"うみ"],[70,1,"う"],[73,1,"か"],[75,1,"くだ"],[78,1,"うみ"],[80,1,"なか"],[85,1,"し"]],"text":"イエスがお許しになったので、けがれた霊どもは出て行って、豚の中へはいり込んだ。すると、その群れは二千匹ばかりであったが、がけから海へなだれを打って駆け下り、海の中でおぼれ死んでしまった。"},{"ref":"Mark.5.14","start":41005014,"end":41005014,"break":"none","ruby":[[0,1,"ぶた"],[2,1,"か"],[4,1,"もの"],[8,1,"に"],[10,1,"だ"],[14,1,"まち"],[16,1,"むら"],[27,2,"ひとびと"],[30,2,"なにごと"],[33,1,"おこ"],[39,1,"み"]],"text":"豚を飼う者たちが逃げ出して、町や村にふれまわったので、人々は何事が起ったのかと見にきた。"},{"ref":"Mark.5.15","start":41005015,"end":41005015,"break":"none","ruby":[[15,2,"あくれい"],[22,1,"ひと"],[24,2,"きもの"],[27,1,"き"],[30,2,"しょうき"],[51,1,"やど"],[56,1,"もの"],[62,1,"み"],[65,1,"おそ"]],"text":"そして、イエスのところにきて、悪霊につかれた人が着物を着て、正気になってすわっており、それがレギオンを宿していた者であるのを見て、恐れた。"},{"ref":"Mark.5.16","start":41005016,"end":41005016,"break":"none","ruby":[[6,1,"み"],[8,1,"ひと"],[13,2,"あくれい"],[20,1,"ひと"],[22,1,"み"],[24,1,"おこ"],[27,1,"こと"],[29,1,"ぶた"],[36,1,"かれ"],[39,1,"はな"],[42,1,"き"]],"text":"また、それを見た人たちは、悪霊につかれた人の身に起った事と豚のこととを、彼らに話して聞かせた。"},{"ref":"Mark.5.17","start":41005017,"end":41005017,"break":"none","ruby":[[4,2,"ひとびと"],[14,2,"ちほう"],[18,1,"で"],[20,1,"い"],[31,1,"たの"]],"text":"そこで、人々はイエスに、この地方から出て行っていただきたいと、頼みはじめた。"},{"ref":"Mark.5.18","start":41005018,"end":41005018,"break":"none","ruby":[[4,1,"ふね"],[6,1,"の"],[15,2,"あくれい"],[24,1,"ひと"],[27,1,"とも"],[33,1,"ねが"],[35,1,"で"]],"text":"イエスが舟に乗ろうとされると、悪霊につかれていた人がお供をしたいと願い出た。"},{"ref":"Mark.5.19","start":41005019,"end":41005019,"break":"none","ruby":[[9,1,"ゆる"],[18,1,"かれ"],[20,1,"い"],[30,2,"かぞく"],[36,1,"かえ"],[40,1,"しゅ"],[46,1,"おお"],[82,1,"し"]],"text":"しかし、イエスはお許しにならないで、彼に言われた、「あなたの家族のもとに帰って、主がどんなに大きなことをしてくださったか、またどんなにあわれんでくださったか、それを知らせなさい」。"},{"ref":"Mark.5.20","start":41005020,"end":41005020,"break":"none","ruby":[[4,1,"かれ"],[6,1,"た"],[8,1,"さ"],[14,2,"じぶん"],[43,2,"ちほう"],[46,1,"い"],[51,1,"だ"],[57,2,"ひとびと"],[62,1,"おどろ"],[64,1,"あや"]],"text":"そこで、彼は立ち去り、そして自分にイエスがしてくださったことを、ことごとくデカポリスの地方に言いひろめ出したので、人々はみな驚き怪しんだ。"},{"ref":"Mark.5.21","start":41005021,"end":41005021,"break":"paragraph","ruby":[[6,1,"ふね"],[8,1,"む"],[11,1,"ぎし"],[13,1,"わた"],[19,1,"おお"],[23,2,"ぐんしゅう"],[30,1,"あつ"],[41,1,"うみ"]],"text":"イエスがまた舟で向こう岸へ渡られると、大ぜいの群衆がみもとに集まってきた。イエスは海べにおられた。"},{"ref":"Mark.5.22","start":41005022,"end":41005022,"break":"none","ruby":[[4,3,"かいどうづかさ"],[20,1,"もの"],[29,1,"み"],[36,1,"あし"],[42,1,"ふ"]],"text":"そこへ、会堂司のひとりであるヤイロという者がきて、イエスを見かけるとその足もとにひれ伏し、"},{"ref":"Mark.5.23","start":41005023,"end":41005023,"break":"none","ruby":[[4,1,"ねが"],[7,1,"い"],[16,1,"おさな"],[18,1,"むすめ"],[20,1,"し"],[36,1,"こ"],[42,1,"たす"],[59,1,"て"]],"text":"しきりに願って言った、「わたしの幼い娘が死にかかっています。どうぞ、その子がなおって助かりますように、おいでになって、手をおいてやってください」。"},{"ref":"Mark.5.24","start":41005024,"end":41005024,"break":"none","ruby":[[8,1,"かれ"],[10,2,"いっしょ"],[13,1,"で"],[20,1,"おお"],[24,2,"ぐんしゅう"],[31,1,"お"],[33,1,"せま"],[42,1,"い"]],"text":"そこで、イエスは彼と一緒に出かけられた。大ぜいの群衆もイエスに押し迫りながら、ついて行った。"},{"ref":"Mark.5.25","start":41005025,"end":41005025,"break":"paragraph","ruby":[[8,2,"ねんかん"],[11,1,"なが"],[12,1,"ち"],[21,1,"おんな"]],"text":"さてここに、十二年間も長血をわずらっている女がいた。"},{"ref":"Mark.5.26","start":41005026,"end":41005026,"break":"none","ruby":[[0,1,"おお"],[3,2,"いしゃ"],[15,1,"くる"],[23,1,"も"],[25,1,"もの"],[29,1,"ついや"],[59,1,"わる"],[63,2,"いっぽう"]],"text":"多くの医者にかかって、さんざん苦しめられ、その持ち物をみな費してしまったが、なんのかいもないばかりか、かえってますます悪くなる一方であった。"},{"ref":"Mark.5.27","start":41005027,"end":41005027,"break":"none","ruby":[[2,1,"おんな"],[11,1,"き"],[15,2,"ぐんしゅう"],[18,1,"なか"],[23,1,"こ"],[33,1,"ころも"]],"text":"この女がイエスのことを聞いて、群衆の中にまぎれ込み、うしろから、み衣にさわった。"},{"ref":"Mark.5.28","start":41005028,"end":41005028,"break":"none","ruby":[[9,1,"ころも"],[32,1,"おも"]],"text":"それは、せめて、み衣にでもさわれば、なおしていただけるだろうと、思っていたからである。"},{"ref":"Mark.5.29","start":41005029,"end":41005029,"break":"none","ruby":[[4,1,"ち"],[6,1,"もと"],[15,1,"おんな"],[17,2,"びょうき"],[30,1,"み"],[32,1,"かん"]],"text":"すると、血の元がすぐにかわき、女は病気がなおったことを、その身に感じた。"},{"ref":"Mark.5.30","start":41005030,"end":41005030,"break":"none","ruby":[[7,2,"じぶん"],[10,1,"うち"],[13,1,"ちから"],[15,1,"で"],[17,1,"い"],[23,1,"き"],[29,2,"ぐんしゅう"],[32,1,"なか"],[34,1,"ふ"],[36,1,"む"],[44,2,"きもの"],[58,1,"い"]],"text":"イエスはすぐ、自分の内から力が出て行ったことに気づかれて、群衆の中で振り向き、「わたしの着物にさわったのはだれか」と言われた。"},{"ref":"Mark.5.31","start":41005031,"end":41005031,"break":"none","ruby":[[3,2,"でし"],[8,1,"い"],[21,2,"ぐんしゅう"],[28,1,"お"],[30,1,"せま"]],"text":"そこで弟子たちが言った、「ごらんのとおり、群衆があなたに押し迫っていますのに、だれがさわったかと、おっしゃるのですか」。"},{"ref":"Mark.5.32","start":41005032,"end":41005032,"break":"none","ruby":[[12,1,"もの"],[14,1,"み"],[23,1,"み"]],"text":"しかし、イエスはさわった者を見つけようとして、見まわしておられた。"},{"ref":"Mark.5.33","start":41005033,"end":41005033,"break":"none","ruby":[[2,1,"おんな"],[4,2,"じぶん"],[7,1,"み"],[9,1,"おこ"],[15,1,"し"],[19,1,"おそ"],[28,1,"すす"],[30,1,"で"],[39,1,"ふ"],[52,1,"もう"],[54,1,"あ"]],"text":"その女は自分の身に起ったことを知って、恐れおののきながら進み出て、みまえにひれ伏して、すべてありのままを申し上げた。"},{"ref":"Mark.5.34","start":41005034,"end":41005034,"break":"none","ruby":[[6,1,"おんな"],[8,1,"い"],[14,1,"むすめ"],[21,2,"しんこう"],[28,1,"すく"],[35,2,"あんしん"],[39,1,"い"],[54,2,"たっしゃ"]],"text":"イエスはその女に言われた、「娘よ、あなたの信仰があなたを救ったのです。安心して行きなさい。すっかりなおって、達者でいなさい」。"},{"ref":"Mark.5.35","start":41005035,"end":41005035,"break":"paragraph","ruby":[[7,1,"はな"],[18,3,"かいどうづかさ"],[22,1,"いえ"],[25,2,"ひとびと"],[30,1,"い"],[39,1,"むすめ"],[54,2,"せんせい"],[57,1,"わずら"],[62,1,"およ"]],"text":"イエスが、まだ話しておられるうちに、会堂司の家から人々がきて言った、「あなたの娘はなくなりました。このうえ、先生を煩わすには及びますまい」。"},{"ref":"Mark.5.36","start":41005036,"end":41005036,"break":"none","ruby":[[6,1,"はな"],[11,2,"ことば"],[14,1,"き"],[16,1,"なが"],[20,3,"かいどうづかさ"],[24,1,"い"],[30,1,"おそ"],[41,1,"しん"]],"text":"イエスはその話している言葉を聞き流して、会堂司に言われた、「恐れることはない。ただ信じなさい」。"},{"ref":"Mark.5.37","start":41005037,"end":41005037,"break":"none","ruby":[[15,2,"きょうだい"],[28,1,"く"],[39,1,"ゆる"]],"text":"そしてペテロ、ヤコブ、ヤコブの兄弟ヨハネのほかは、ついて来ることを、だれにもお許しにならなかった。"},{"ref":"Mark.5.38","start":41005038,"end":41005038,"break":"none","ruby":[[0,1,"かれ"],[3,3,"かいどうづかさ"],[7,1,"いえ"],[9,1,"つ"],[17,2,"ひとびと"],[20,2,"おおごえ"],[23,1,"な"],[28,1,"さけ"],[35,1,"さわ"]],"text":"彼らが会堂司の家に着くと、イエスは人々が大声で泣いたり、叫んだりして、騒いでいるのをごらんになり、"},{"ref":"Mark.5.39","start":41005039,"end":41005039,"break":"none","ruby":[[0,1,"うち"],[7,1,"かれ"],[10,1,"い"],[18,1,"な"],[20,1,"さわ"],[28,2,"こども"],[31,1,"し"],[40,1,"ねむ"]],"text":"内にはいって、彼らに言われた、「なぜ泣き騒いでいるのか。子供は死んだのではない。眠っているだけである」。"},{"ref":"Mark.5.40","start":41005040,"end":41005040,"break":"none","ruby":[[0,2,"ひとびと"],[9,1,"わら"],[25,1,"もの"],[27,1,"そと"],[29,1,"だ"],[32,2,"こども"],[35,2,"ふぼ"],[38,1,"とも"],[40,1,"もの"],[46,1,"つ"],[50,2,"こども"],[55,1,"ところ"],[61,1,"い"]],"text":"人々はイエスをあざ笑った。しかし、イエスはみんなの者を外に出し、子供の父母と供の者たちだけを連れて、子供のいる所にはいって行かれた。"},{"ref":"Mark.5.41","start":41005041,"end":41005041,"break":"none","ruby":[[3,2,"こども"],[6,1,"て"],[8,1,"と"],[21,1,"い"],[31,2,"しょうじょ"],[38,1,"お"],[47,2,"いみ"]],"text":"そして子供の手を取って、「タリタ、クミ」と言われた。それは、「少女よ、さあ、起きなさい」という意味である。"},{"ref":"Mark.5.42","start":41005042,"end":41005042,"break":"none","ruby":[[4,2,"しょうじょ"],[10,1,"お"],[12,1,"あ"],[17,1,"ある"],[19,1,"だ"],[25,1,"さい"],[39,1,"かれ"],[46,2,"ひじょう"],[49,1,"おどろ"],[52,1,"う"]],"text":"すると、少女はすぐに起き上がって、歩き出した。十二歳にもなっていたからである。彼らはたちまち非常な驚きに打たれた。"},{"ref":"Mark.5.43","start":41005043,"end":41005043,"break":"none","ruby":[[11,1,"こと"],[13,1,"し"],[23,1,"かれ"],[26,1,"めい"],[32,2,"しょうじょ"],[35,2,"しょくもつ"],[38,1,"あた"],[45,1,"い"]],"text":"イエスは、だれにもこの事を知らすなと、きびしく彼らに命じ、また、少女に食物を与えるようにと言われた。"}]