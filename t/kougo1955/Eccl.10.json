[{"ref":"Eccl.10.1","start":21010001,"end":21010001,"break":"paragraph","breaks":[[14,"line"],[22,"line"]],"ruby":[[0,1,"し"],[7,2,"こうりょう"],[10,1,"つく"],[12,1,"もの"],[18,1,"くさ"],[22,1,"すこ"],[25,2,"ぐち"],[28,2,"ちえ"],[31,1,"ほまれ"],[35,1,"おも"]],"text":"死んだはえは、香料を造る者のあぶらを臭くし、少しの愚痴は知恵と誉よりも重い。"},{"ref":"Eccl.10.2","start":21010002,"end":21010002,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"ちしゃ"],[3,1,"こころ"],[5,1,"かれ"],[7,1,"みぎ"],[9,1,"む"],[14,2,"ぐしゃ"],[17,1,"こころ"],[19,1,"ひだり"],[21,1,"む"]],"text":"知者の心は彼を右に向けさせ、愚者の心は左に向けさせる。"},{"ref":"Eccl.10.3","start":21010003,"end":21010003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ぐしゃ"],[3,1,"みち"],[5,1,"い"],[7,1,"とき"],[9,2,"しりょ"],[12,1,"た"],[17,2,"じぶん"],[20,1,"おろ"],[30,1,"ひと"],[32,1,"つ"]],"text":"愚者は道を行く時、思慮が足りない、自分の愚かなことをすべての人に告げる。"},{"ref":"Eccl.10.4","start":21010004,"end":21010004,"break":"line","breaks":[[21,"line"],[36,"line"]],"ruby":[[5,1,"もの"],[11,1,"む"],[15,2,"りっぷく"],[25,1,"ところ"],[27,1,"はな"],[36,2,"おんじゅん"],[39,1,"おお"],[46,1,"やわ"]],"text":"つかさたる者があなたに向かって立腹しても、あなたの所を離れてはならない。温順は大いなるとがを和らげるからである。"},{"ref":"Eccl.10.5","start":21010005,"end":21010005,"break":"paragraph","ruby":[[4,1,"ひ"],[6,1,"した"],[11,1,"あく"],[17,1,"み"],[28,1,"もの"],[31,1,"で"],[38,1,"に"]],"text":"わたしは日の下に一つの悪のあるのを見た。それはつかさたる者から出るあやまちに似ている。"},{"ref":"Eccl.10.6","start":21010006,"end":21010006,"break":"none","ruby":[[4,1,"おろ"],[8,1,"もの"],[10,1,"たか"],[12,2,"ちい"],[15,1,"お"],[19,1,"と"],[22,1,"もの"],[24,1,"いや"],[27,1,"ところ"],[29,1,"ざ"]],"text":"すなわち愚かなる者が高い地位に置かれ、富める者が卑しい所に座している。"},{"ref":"Eccl.10.7","start":21010007,"end":21010007,"break":"none","ruby":[[9,1,"もの"],[11,1,"うま"],[13,1,"の"],[16,1,"くん"],[19,1,"もの"],[21,2,"どれい"],[27,2,"とほ"],[35,1,"み"]],"text":"わたしはしもべたる者が馬に乗り、君たる者が奴隷のように徒歩であるくのを見た。"},{"ref":"Eccl.10.8","start":21010008,"end":21010008,"break":"stanza","breaks":[[16,"line"]],"ruby":[[0,1,"あな"],[2,1,"ほ"],[4,1,"もの"],[13,1,"おちい"],[16,1,"いし"],[23,1,"もの"]],"text":"穴を掘る者はみずからこれに陥り、石がきをこわす者は、へびにかまれる。"},{"ref":"Eccl.10.9","start":21010009,"end":21010009,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"いし"],[2,1,"き"],[4,1,"だ"],[6,1,"もの"],[14,1,"きず"],[19,1,"き"],[21,1,"わ"],[23,1,"もの"],[31,2,"きけん"]],"text":"石を切り出す者はそれがために傷をうけ、木を割る者はそれがために危険にさらされる。"},{"ref":"Eccl.10.10","start":21010010,"end":21010010,"break":"line","breaks":[[24,"line"],[40,"line"]],"ruby":[[0,1,"てつ"],[2,1,"にぶ"],[10,1,"ひと"],[14,1,"は"],[24,1,"ちから"],[26,1,"おお"],[31,1,"もち"],[44,2,"ちえ"],[47,1,"ひと"],[49,1,"たす"],[54,1,"と"]],"text":"鉄が鈍くなったとき、人がその刃をみがかなければ、力を多くこれに用いねばならない。しかし、知恵は人を助けてなし遂げさせる。"},{"ref":"Eccl.10.11","start":21010011,"end":21010011,"break":"line","breaks":[[22,"line"]],"ruby":[[5,2,"じゅもん"],[13,1,"まえ"],[24,1,"つかい"],[26,1,"えき"]],"text":"へびがもし呪文をかけられる前に、かみつけば、へび使は益がない。"},{"ref":"Eccl.10.12","start":21010012,"end":21010012,"break":"stanza","breaks":[[14,"line"]],"ruby":[[0,2,"ちしゃ"],[3,1,"くち"],[5,2,"ことば"],[8,1,"めぐ"],[17,2,"ぐしゃ"],[27,1,"み"],[29,1,"ほろ"]],"text":"知者の口の言葉は恵みがある、しかし愚者のくちびるはその身を滅ぼす。"},{"ref":"Eccl.10.13","start":21010013,"end":21010013,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ぐしゃ"],[3,1,"くち"],[5,2,"ことば"],[8,1,"はじ"],[11,2,"ぐち"],[21,2,"ことば"],[24,1,"おわ"],[27,1,"わる"],[29,2,"きょうき"]],"text":"愚者の口の言葉の初めは愚痴である、またその言葉の終りは悪い狂気である。"},{"ref":"Eccl.10.14","start":21010014,"end":21010014,"break":"line","breaks":[[11,"line"],[31,"line"],[44,"line"]],"ruby":[[0,2,"ぐしゃ"],[3,2,"ことば"],[6,1,"おお"],[14,1,"ひと"],[19,1,"のち"],[21,1,"おこ"],[26,1,"し"],[36,1,"み"],[38,1,"のち"],[40,1,"おこ"],[42,1,"こと"],[44,1,"つ"]],"text":"愚者は言葉を多くする、しかし人はだれも後に起ることを知らない。だれがその身の後に起る事を告げることができようか。"},{"ref":"Eccl.10.15","start":21010015,"end":21010015,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ぐしゃ"],[3,2,"ろうく"],[8,1,"み"],[10,1,"つか"],[16,1,"かれ"],[18,1,"まち"],[23,1,"みち"],[27,1,"し"]],"text":"愚者の労苦はその身を疲れさせる、彼は町にはいる道をさえ知らない。"},{"ref":"Eccl.10.16","start":21010016,"end":21010016,"break":"stanza","breaks":[[14,"line"],[35,"line"]],"ruby":[[4,1,"おう"],[16,1,"きみ"],[20,1,"あさ"],[29,1,"た"],[32,1,"くに"]],"text":"あなたの王はわらべであって、その君たちが朝から、ごちそうを食べる国よ、あなたはわざわいだ。"},{"ref":"Eccl.10.17","start":21010017,"end":21010017,"break":"line","breaks":[[15,"line"],[37,"line"],[53,"line"]],"ruby":[[4,1,"おう"],[6,2,"じしゅ"],[9,1,"こ"],[17,1,"きみ"],[21,1,"よ"],[29,1,"ちから"],[31,1,"え"],[37,2,"てきとう"],[40,1,"とき"],[47,1,"た"],[50,1,"くに"]],"text":"あなたの王は自主の子であって、その君たちが酔うためでなく、力を得るために、適当な時にごちそうを食べる国よ、あなたはさいわいだ。"},{"ref":"Eccl.10.18","start":21010018,"end":21010018,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"たいだ"],[6,2,"やね"],[9,1,"お"],[12,2,"ぶしょう"],[18,1,"いえ"],[20,1,"も"]],"text":"怠惰によって屋根は落ち、無精によって家は漏る。"},{"ref":"Eccl.10.19","start":21010019,"end":21010019,"break":"line","breaks":[[13,"line"],[23,"line"]],"ruby":[[0,2,"しょくじ"],[3,1,"わら"],[13,1,"さけ"],[15,1,"いのち"],[17,1,"たの"],[23,2,"きんせん"],[30,1,"こと"],[32,1,"おう"]],"text":"食事は笑いのためになされ、酒は命を楽しませる。金銭はすべての事に応じる。"},{"ref":"Eccl.10.20","start":21010020,"end":21010020,"break":"line","breaks":[[22,"line"],[43,"line"],[56,"line"]],"ruby":[[4,1,"こころ"],[10,1,"おう"],[24,2,"しんしつ"],[28,1,"と"],[31,1,"もの"],[43,1,"そら"],[45,1,"とり"],[51,1,"こえ"],[53,1,"つた"],[56,1,"つばさ"],[63,1,"こと"],[65,1,"つ"]],"text":"あなたは心のうちでも王をのろってはならない、また寝室でも富める者をのろってはならない。空の鳥はあなたの声を伝え、翼のあるものは事を告げるからである。"}]