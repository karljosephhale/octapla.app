[{"ref":"Lev.1.1","start":3001001,"end":3001001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"よ"],[9,2,"かいけん"],[12,2,"まくや"],[19,1,"つ"],[22,1,"い"]],"text":"主はモーセを呼び、会見の幕屋からこれに告げて言われた、"},{"ref":"Lev.1.2","start":3001002,"end":3001002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[29,2,"かちく"],[32,1,"そな"],[34,1,"もの"],[36,1,"しゅ"],[46,1,"うし"],[50,1,"ひつじ"],[52,1,"そな"],[54,1,"もの"]],"text":"「イスラエルの人々に言いなさい、『あなたがたのうちだれでも家畜の供え物を主にささげるときは、牛または羊を供え物としてささげなければならない。"},{"ref":"Lev.1.3","start":3001003,"end":3001003,"break":"paragraph","ruby":[[4,1,"そな"],[6,1,"もの"],[8,1,"うし"],[10,2,"はんさい"],[19,2,"おうし"],[22,1,"まった"],[39,2,"かいけん"],[42,2,"まくや"],[45,2,"いりぐち"],[49,1,"しゅ"],[51,1,"まえ"],[53,1,"う"],[55,1,"い"]],"text":"もしその供え物が牛の燔祭であるならば、雄牛の全きものをささげなければならない。会見の幕屋の入口で、主の前に受け入れられるように、これをささげなければならない。"},{"ref":"Lev.1.4","start":3001004,"end":3001004,"break":"none","ruby":[[0,1,"かれ"],[4,2,"はんさい"],[7,1,"けもの"],[9,1,"あたま"],[11,1,"て"],[13,1,"お"],[29,1,"う"],[31,1,"い"],[37,1,"かれ"]],"text":"彼はその燔祭の獣の頭に手を置かなければならない。そうすれば受け入れられて、彼のためにあがないとなるであろう。"},{"ref":"Lev.1.5","start":3001005,"end":3001005,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"まえ"],[8,1,"こ"],[9,1,"うし"],[19,1,"こ"],[22,2,"さいし"],[30,1,"ち"],[32,1,"たずさ"],[38,2,"かいけん"],[41,2,"まくや"],[44,2,"いりぐち"],[49,2,"さいだん"],[52,2,"しゅうい"],[58,1,"ち"],[60,1,"そそ"]],"text":"彼は主の前でその子牛をほふり、アロンの子なる祭司たちは、その血を携えてきて、会見の幕屋の入口にある祭壇の周囲に、その血を注ぎかけなければならない。"},{"ref":"Lev.1.6","start":3001006,"end":3001006,"break":"none","ruby":[[0,1,"かれ"],[6,2,"はんさい"],[9,1,"けもの"],[11,1,"かわ"],[16,2,"ふしぶし"],[19,1,"き"],[21,1,"わ"]],"text":"彼はまたその燔祭の獣の皮をはぎ、節々に切り分かたなければならない。"},{"ref":"Lev.1.7","start":3001007,"end":3001007,"break":"none","ruby":[[0,2,"さいし"],[6,1,"こ"],[10,2,"さいだん"],[13,1,"うえ"],[15,1,"ひ"],[17,1,"お"],[22,1,"ひ"],[24,1,"うえ"],[30,1,"なら"]],"text":"祭司アロンの子たちは祭壇の上に火を置き、その火の上にたきぎを並べ、"},{"ref":"Lev.1.8","start":3001008,"end":3001008,"break":"none","ruby":[[4,1,"こ"],[7,2,"さいし"],[14,1,"き"],[16,1,"わ"],[23,1,"あたま"],[27,2,"しぼう"],[30,1,"とも"],[33,2,"さいだん"],[36,1,"うえ"],[40,1,"ひ"],[42,1,"うえ"],[48,1,"うえ"],[50,1,"なら"]],"text":"アロンの子なる祭司たちはその切り分けたものを、頭および脂肪と共に、祭壇の上にある火の上のたきぎの上に並べなければならない。"},{"ref":"Lev.1.9","start":3001009,"end":3001009,"break":"none","ruby":[[2,2,"ないぞう"],[5,1,"あし"],[8,1,"みず"],[10,1,"あら"],[25,2,"さいし"],[34,2,"さいだん"],[37,1,"うえ"],[39,1,"や"],[42,2,"はんさい"],[58,2,"かさい"],[65,1,"しゅ"],[71,1,"こう"]],"text":"その内臓と足とは水で洗わなければならない。こうして祭司はそのすべてを祭壇の上で焼いて燔祭としなければならない。これは火祭であって、主にささげる香ばしいかおりである。"},{"ref":"Lev.1.10","start":3001010,"end":3001010,"break":"paragraph","ruby":[[4,2,"はんさい"],[7,1,"そな"],[9,1,"もの"],[11,1,"む"],[14,1,"ひつじ"],[28,1,"おす"],[30,1,"まった"]],"text":"もしその燔祭の供え物が群れの羊または、やぎであるならば、雄の全きものをささげなければならない。"},{"ref":"Lev.1.11","start":3001011,"end":3001011,"break":"none","ruby":[[0,1,"かれ"],[2,2,"さいだん"],[5,2,"きたがわ"],[9,1,"しゅ"],[11,1,"まえ"],[24,1,"こ"],[27,2,"さいし"],[35,1,"ち"],[37,2,"さいだん"],[40,2,"しゅうい"],[43,1,"そそ"]],"text":"彼は祭壇の北側で、主の前にこれをほふり、アロンの子なる祭司たちは、その血を祭壇の周囲に注ぎかけなければならない。"},{"ref":"Lev.1.12","start":3001012,"end":3001012,"break":"none","ruby":[[0,1,"かれ"],[7,2,"ふしぶし"],[10,1,"き"],[12,1,"わ"],[16,2,"さいし"],[22,1,"あたま"],[26,2,"しぼう"],[29,1,"とも"],[32,2,"さいだん"],[35,1,"うえ"],[39,1,"ひ"],[41,1,"うえ"],[47,1,"うえ"],[49,1,"なら"]],"text":"彼はまたこれを節々に切り分かち、祭司はこれを頭および脂肪と共に、祭壇の上にある火の上のたきぎの上に並べなければならない。"},{"ref":"Lev.1.13","start":3001013,"end":3001013,"break":"none","ruby":[[2,2,"ないぞう"],[5,1,"あし"],[8,1,"みず"],[10,1,"あら"],[25,2,"さいし"],[34,2,"さいだん"],[37,1,"うえ"],[39,1,"や"],[42,2,"はんさい"],[58,2,"かさい"],[65,1,"しゅ"],[71,1,"こう"]],"text":"その内臓と足とは水で洗わなければならない。こうして祭司はそのすべてを祭壇の上で焼いて燔祭としなければならない。これは火祭であって、主にささげる香ばしいかおりである。"},{"ref":"Lev.1.14","start":3001014,"end":3001014,"break":"paragraph","ruby":[[2,1,"しゅ"],[8,1,"そな"],[10,1,"もの"],[13,1,"とり"],[15,2,"はんさい"],[24,1,"やま"],[31,1,"いえ"],[41,1,"そな"],[43,1,"もの"]],"text":"もし主にささげる供え物が、鳥の燔祭であるならば、山ばと、または家ばとのひなを、その供え物としてささげなければならない。"},{"ref":"Lev.1.15","start":3001015,"end":3001015,"break":"none","ruby":[[0,2,"さいし"],[6,2,"さいだん"],[9,1,"たずさ"],[12,1,"い"],[17,1,"くび"],[19,1,"つ"],[21,1,"やぶ"],[24,2,"さいだん"],[27,1,"うえ"],[29,1,"や"],[42,1,"ち"],[44,1,"しぼ"],[46,1,"だ"],[49,2,"さいだん"],[52,2,"そくめん"],[55,1,"ぬ"]],"text":"祭司はこれを祭壇に携えて行き、その首を摘み破り、祭壇の上で焼かなければならない。その血は絞り出して祭壇の側面に塗らなければならない。"},{"ref":"Lev.1.16","start":3001016,"end":3001016,"break":"none","ruby":[[4,1,"え"],[5,1,"ぶくろ"],[7,1,"はね"],[9,1,"とも"],[11,1,"のぞ"],[15,2,"さいだん"],[18,1,"ひがし"],[20,1,"ほう"],[24,1,"はい"],[25,1,"すて"],[26,1,"ば"],[28,1,"す"]],"text":"またその餌袋は羽と共に除いて、祭壇の東の方にある灰捨場に捨てなければならない。"},{"ref":"Lev.1.17","start":3001017,"end":3001017,"break":"none","ruby":[[6,1,"つばさ"],[8,1,"にぎ"],[11,1,"さ"],[25,1,"ひ"],[27,1,"はな"],[36,2,"さいし"],[42,2,"さいだん"],[45,1,"うえ"],[48,1,"ひ"],[50,1,"うえ"],[56,1,"うえ"],[58,2,"はんさい"],[63,1,"や"],[77,2,"かさい"],[84,1,"しゅ"],[90,1,"こう"]],"text":"これは、その翼を握って裂かなければならない。ただし引き離してはならない。祭司はこれを祭壇の上で、火の上のたきぎの上で燔祭として焼かなければならない。これは火祭であって、主にささげる香ばしいかおりである。"}]