[{"ref":"1Kgs.21.1","start":11021001,"end":11021001,"break":"paragraph","ruby":[[20,1,"はたけ"],[34,1,"おう"],[39,2,"きゅうでん"]],"text":"さてエズレルびとナボテはエズレルにぶどう畑をもっていたが、サマリヤの王アハブの宮殿のかたわらにあったので、"},{"ref":"1Kgs.21.2","start":11021002,"end":11021002,"break":"none","ruby":[[8,1,"い"],[20,1,"はたけ"],[26,1,"いえ"],[28,1,"ちか"],[40,1,"ゆず"],[43,2,"あおもの"],[45,1,"はたけ"],[57,1,"かわ"],[69,1,"よ"],[74,1,"はたけ"],[90,1,"のぞ"],[98,1,"あたい"],[100,1,"きん"]],"text":"アハブはナボテに言った、「あなたのぶどう畑はわたしの家の近くにあるので、わたしに譲って青物畑にさせてください。その代り、わたしはそれよりも良いぶどう畑をあなたにあげましょう。もしお望みならば、その価を金でさしあげましょう」。"},{"ref":"1Kgs.21.3","start":11021003,"end":11021003,"break":"none","ruby":[[8,1,"い"],[17,2,"せんぞ"],[20,1,"し"],[21,1,"ぎょう"],[27,1,"ゆず"],[32,1,"だん"]],"text":"ナボテはアハブに言った、「わたしは先祖の嗣業をあなたに譲ることを断じていたしません」。"},{"ref":"1Kgs.21.4","start":11021004,"end":11021004,"break":"none","ruby":[[14,1,"い"],[17,2,"ことば"],[20,1,"き"],[24,1,"かな"],[30,1,"いか"],[33,1,"いえ"],[49,2,"せんぞ"],[52,1,"し"],[53,1,"ぎょう"],[59,1,"ゆず"],[66,1,"い"],[79,1,"とこ"],[81,1,"ふ"],[84,1,"かお"],[90,2,"しょくじ"]],"text":"アハブはエズレルびとナボテが言った言葉を聞いて、悲しみ、かつ怒って家にはいった。ナボテが「わたしは先祖の嗣業をあなたに譲りません」と言ったからである。アハブは床に伏し、顔をそむけて食事をしなかった。"},{"ref":"1Kgs.21.5","start":11021005,"end":11021005,"break":"paragraph","ruby":[[0,1,"つま"],[6,1,"かれ"],[8,1,"ところ"],[13,1,"い"],[22,1,"なに"],[28,1,"かな"],[33,2,"しょくじ"]],"text":"妻イゼベルは彼の所にきて、言った、「あなたは何をそんなに悲しんで、食事をなさらないのですか」。"},{"ref":"1Kgs.21.6","start":11021006,"end":11021006,"break":"none","ruby":[[0,1,"かれ"],[2,2,"かのじょ"],[5,1,"い"],[32,1,"はたけ"],[34,1,"かね"],[36,1,"ゆず"],[46,1,"のぞ"],[54,1,"かわ"],[64,1,"はたけ"],[72,1,"い"],[77,1,"かれ"],[79,1,"こた"],[90,1,"はたけ"],[92,1,"ゆず"],[99,1,"い"]],"text":"彼は彼女に言った、「わたしはエズレルびとナボテに『あなたのぶどう畑を金で譲ってください。もし望むならば、その代りに、ほかのぶどう畑をあげよう』と言ったが、彼は答えて『わたしはぶどう畑を譲りません』と言ったからだ」。"},{"ref":"1Kgs.21.7","start":11021007,"end":11021007,"break":"none","ruby":[[0,1,"つま"],[6,1,"かれ"],[8,1,"い"],[17,1,"いま"],[24,1,"おさ"],[34,1,"お"],[37,2,"しょくじ"],[42,2,"げんき"],[45,1,"だ"],[70,1,"はたけ"]],"text":"妻イゼベルは彼に言った、「あなたが今イスラエルを治めているのですか。起きて食事をし、元気を出してください。わたしがエズレルびとナボテのぶどう畑をあなたにあげます」。"},{"ref":"1Kgs.21.8","start":11021008,"end":11021008,"break":"paragraph","ruby":[[0,2,"かのじょ"],[7,1,"な"],[9,2,"てがみ"],[12,1,"か"],[15,1,"かれ"],[17,1,"しるし"],[27,1,"おな"],[35,1,"まち"],[37,1,"す"],[42,2,"ちょうろう"],[47,2,"みぶん"],[50,1,"たっと"],[52,2,"ひとびと"],[58,2,"てがみ"],[61,1,"おく"]],"text":"彼女はアハブの名で手紙を書き、彼の印をおして、ナボテと同じように、その町に住んでいる長老たちと身分の尊い人々に、その手紙を送った。"},{"ref":"1Kgs.21.9","start":11021009,"end":11021009,"break":"none","ruby":[[0,2,"かのじょ"],[5,2,"てがみ"],[8,1,"か"],[16,2,"だんじき"],[19,2,"ふこく"],[28,1,"たみ"],[33,1,"たか"],[35,1,"ところ"]],"text":"彼女はその手紙に書きしるした、「断食を布告して、ナボテを民のうちの高い所にすわらせ、"},{"ref":"1Kgs.21.10","start":11021010,"end":11021010,"break":"none","ruby":[[11,1,"もの"],[13,1,"かれ"],[15,1,"まえ"],[25,1,"かれ"],[27,1,"うった"],[36,1,"かみ"],[38,1,"おう"],[47,1,"い"],[58,1,"かれ"],[60,1,"ひ"],[62,1,"だ"],[65,1,"いし"],[67,1,"う"],[69,1,"ころ"]],"text":"またふたりのよこしまな者を彼の前にすわらせ、そして彼を訴えて、『あなたは神と王とをのろった』と言わせなさい。こうして彼を引き出し、石で撃ち殺しなさい」。"},{"ref":"1Kgs.21.11","start":11021011,"end":11021011,"break":"none","ruby":[[2,1,"まち"],[4,2,"ひとびと"],[14,1,"まち"],[16,1,"す"],[21,2,"ちょうろう"],[28,2,"みぶん"],[31,1,"たっと"],[33,2,"ひとびと"],[42,1,"い"],[55,2,"かのじょ"],[58,1,"かれ"],[61,1,"おく"],[64,2,"てがみ"],[67,1,"か"]],"text":"その町の人々、すなわち、その町に住んでいる長老たちおよび身分の尊い人々は、イゼベルが言いつかわしたようにした。彼女が彼らに送った手紙に書きしるされていたように、"},{"ref":"1Kgs.21.12","start":11021012,"end":11021012,"break":"none","ruby":[[0,1,"かれ"],[3,2,"だんじき"],[6,2,"ふこく"],[15,1,"たみ"],[20,1,"たか"],[22,1,"ところ"]],"text":"彼らは断食を布告して、ナボテを民のうちの高い所にすわらせた。"},{"ref":"1Kgs.21.13","start":11021013,"end":11021013,"break":"none","ruby":[[12,1,"もの"],[23,1,"まえ"],[36,1,"もの"],[40,1,"たみ"],[42,1,"まえ"],[48,1,"うった"],[57,1,"かみ"],[59,1,"おう"],[68,1,"い"],[75,2,"ひとびと"],[78,1,"かれ"],[80,1,"まち"],[82,1,"そと"],[84,1,"ひ"],[86,1,"だ"],[89,1,"いし"],[91,1,"う"],[93,1,"ころ"]],"text":"そしてふたりのよこしまな者がはいってきて、その前にすわり、そのよこしまな者たちが民の前でナボテを訴えて、「ナボテは神と王とをのろった」と言った。そこで人々は彼を町の外に引き出し、石で撃ち殺した。"},{"ref":"1Kgs.21.14","start":11021014,"end":11021014,"break":"none","ruby":[[3,2,"ひとびと"],[16,1,"いし"],[18,1,"う"],[20,1,"ころ"],[26,1,"い"],[28,1,"おく"]],"text":"そして人々はイゼベルに「ナボテは石で撃ち殺された」と言い送った。"},{"ref":"1Kgs.21.15","start":11021015,"end":11021015,"break":"paragraph","ruby":[[9,1,"いし"],[11,1,"う"],[13,1,"ころ"],[19,1,"き"],[29,1,"い"],[34,1,"た"],[55,1,"かね"],[57,1,"ゆず"],[62,1,"こば"],[68,1,"はたけ"],[70,1,"と"],[80,1,"い"],[88,1,"し"]],"text":"イゼベルはナボテが石で撃ち殺されたのを聞くとすぐ、アハブに言った、「立って、あのエズレルびとナボテが、あなたに金で譲ることを拒んだぶどう畑を取りなさい。ナボテは生きていません。死んだのです」。"},{"ref":"1Kgs.21.16","start":11021016,"end":11021016,"break":"none","ruby":[[8,1,"し"],[13,1,"き"],[19,1,"た"],[36,1,"はたけ"],[38,1,"と"],[47,1,"くだ"]],"text":"アハブはナボテの死んだのを聞くとすぐ、立って、エズレルびとナボテのぶどう畑を取るために、そこへ下っていった。"},{"ref":"1Kgs.21.17","start":11021017,"end":11021017,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,2,"ことば"],[19,1,"のぞ"]],"text":"そのとき、主の言葉がテシベびとエリヤに臨んだ、"},{"ref":"1Kgs.21.18","start":11021018,"end":11021018,"break":"none","ruby":[[1,1,"た"],[5,1,"くだ"],[8,1,"い"],[24,1,"おう"],[29,1,"あ"],[35,1,"かれ"],[44,1,"はたけ"],[46,1,"と"],[55,1,"くだ"]],"text":"「立って、下って行き、サマリヤにいるイスラエルの王アハブに会いなさい。彼はナボテのぶどう畑を取ろうとしてそこへ下っている。"},{"ref":"1Kgs.21.19","start":11021019,"end":11021019,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[18,1,"しゅ"],[22,1,"おお"],[32,1,"ころ"],[40,1,"と"],[50,1,"かれ"],[52,1,"い"],[59,1,"しゅ"],[63,1,"おお"],[69,1,"いぬ"],[75,1,"ち"],[80,2,"ばしょ"],[84,1,"いぬ"],[90,1,"ち"]],"text":"あなたは彼に言わなければならない、『主はこう仰せられる、あなたは殺したのか、また取ったのか』と。また彼に言いなさい、『主はこう仰せられる、犬がナボテの血をなめた場所で、犬があなたの血をなめるであろう』」。"},{"ref":"1Kgs.21.20","start":11021020,"end":11021020,"break":"paragraph","ruby":[[8,1,"い"],[15,1,"てき"],[26,1,"み"],[34,1,"かれ"],[36,1,"い"],[41,1,"み"],[52,1,"しゅ"],[54,1,"め"],[56,1,"まえ"],[58,1,"あく"],[60,1,"おこな"],[65,1,"み"]],"text":"アハブはエリヤに言った、「わが敵よ、ついに、わたしを見つけたのか」。彼は言った、「見つけました。あなたが主の目の前に悪を行うことに身をゆだねたゆえ、"},{"ref":"1Kgs.21.21","start":11021021,"end":11021021,"break":"none","ruby":[[8,1,"わざわい"],[10,1,"くだ"],[17,1,"まった"],[19,1,"ほろ"],[27,1,"ぞく"],[30,1,"おとこ"],[46,1,"もの"],[49,2,"じゆう"],[52,1,"もの"],[59,1,"た"]],"text":"わたしはあなたに災を下し、あなたを全く滅ぼし、アハブに属する男は、イスラエルにいてつながれた者も、自由な者もことごとく断ち、"},{"ref":"1Kgs.21.22","start":11021022,"end":11021022,"break":"none","ruby":[[6,1,"いえ"],[12,1,"こ"],[19,1,"いえ"],[30,1,"こ"],[36,1,"いえ"],[59,1,"いか"],[63,1,"いか"],[77,1,"つみ"],[79,1,"おか"]],"text":"またあなたの家をネバテの子ヤラベアムの家のようにし、アヒヤの子バアシャの家のようにするでしょう。これはあなたがわたしを怒らせた怒りのゆえ、またイスラエルに罪を犯させたゆえです。"},{"ref":"1Kgs.21.23","start":11021023,"end":11021023,"break":"none","ruby":[[9,1,"しゅ"],[13,1,"い"],[21,1,"いぬ"],[28,2,"ちいき"],[36,1,"く"]],"text":"イゼベルについて、主はまた言われました、『犬がエズレルの地域でイゼベルを食うであろう』と。"},{"ref":"1Kgs.21.24","start":11021024,"end":11021024,"break":"none","ruby":[[4,1,"ぞく"],[7,1,"もの"],[10,1,"まち"],[12,1,"し"],[14,1,"もの"],[16,1,"いぬ"],[18,1,"く"],[21,1,"の"],[23,1,"し"],[25,1,"もの"],[27,1,"そら"],[29,1,"とり"],[31,1,"く"]],"text":"アハブに属する者は、町で死ぬ者を犬が食い、野で死ぬ者を空の鳥が食うでしょう」。"},{"ref":"1Kgs.21.25","start":11021025,"end":11021025,"break":"paragraph","ruby":[[7,1,"しゅ"],[9,1,"め"],[11,1,"まえ"],[13,1,"あく"],[15,1,"おこな"],[20,1,"み"],[26,1,"もの"],[35,1,"つま"],[41,1,"かれ"]],"text":"アハブのように主の目の前に悪を行うことに身をゆだねた者はなかった。その妻イゼベルが彼をそそのかしたのである。"},{"ref":"1Kgs.21.26","start":11021026,"end":11021026,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[10,2,"ひとびと"],[13,1,"まえ"],[16,1,"お"],[18,1,"はら"],[33,2,"ぐうぞう"],[36,1,"したが"],[44,1,"にく"],[48,1,"こと"],[50,1,"おこな"]],"text":"彼は主がイスラエルの人々の前から追い払われたアモリびとがしたように偶像に従って、はなはだ憎むべき事を行った。"},{"ref":"1Kgs.21.27","start":11021027,"end":11021027,"break":"paragraph","ruby":[[8,2,"ことば"],[11,1,"き"],[14,1,"とき"],[16,1,"ころも"],[18,1,"さ"],[21,2,"あらぬの"],[24,1,"み"],[30,1,"しょく"],[32,1,"た"],[35,2,"あらぬの"],[38,1,"ふ"],[41,1,"う"],[47,1,"ある"]],"text":"アハブはこれらの言葉を聞いた時、衣を裂き、荒布を身にまとい、食を断ち、荒布に伏し、打ちしおれて歩いた。"},{"ref":"1Kgs.21.28","start":11021028,"end":11021028,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,2,"ことば"],[18,1,"のぞ"]],"text":"この時、主の言葉がテシベびとエリヤに臨んだ、"},{"ref":"1Kgs.21.29","start":11021029,"end":11021029,"break":"none","ruby":[[9,1,"まえ"],[21,1,"み"],[25,1,"かれ"],[31,1,"まえ"],[48,1,"あ"],[50,1,"よ"],[53,1,"わざわい"],[55,1,"くだ"],[62,1,"こ"],[64,1,"よ"],[66,1,"わざわい"],[70,1,"いえ"],[72,1,"くだ"]],"text":"「アハブがわたしの前にへりくだっているのを見たか。彼がわたしの前にへりくだっているゆえ、わたしは彼の世には災を下さない。その子の世に災をその家に下すであろう」。"}]