[{"ref":"Josh.16.1","start":6016001,"end":6016001,"break":"paragraph","ruby":[[4,2,"しそん"],[14,1,"え"],[16,1,"ち"],[18,1,"さかい"],[42,1,"みず"],[44,1,"ひがし"],[47,1,"た"],[51,2,"あらの"],[54,1,"の"],[62,2,"さんち"],[65,1,"のぼ"],[70,2,"あらの"],[73,1,"へ"],[80,1,"いた"]],"text":"ヨセフの子孫が、くじによって獲た地の境は、エリコのほとりのヨルダン、すなわちエリコの水の東から起って、荒野に延び、エリコから山地に上っている荒野を経て、ベテルに至り、"},{"ref":"Josh.16.2","start":6016002,"end":6016002,"break":"none","ruby":[[19,2,"りょうち"],[29,1,"すす"]],"text":"ベテルからルズにおもむき、アルキびとの領地であるアタロテに進み、"},{"ref":"Josh.16.3","start":6016003,"end":6016003,"break":"none","ruby":[[0,1,"にし"],[2,1,"くだ"],[12,2,"りょうち"],[15,1,"たっ"],[18,1,"した"],[25,2,"ちいき"],[28,1,"およ"],[35,1,"たっ"],[38,1,"うみ"],[40,1,"いた"],[43,1,"つ"]],"text":"西に下ってヤフレテびとの領地に達し、下ベテホロンの地域に及び、ゲゼルに達し、海に至って尽きる。"},{"ref":"Josh.16.4","start":6016004,"end":6016004,"break":"paragraph","ruby":[[8,2,"しそん"],[26,1,"し"],[27,1,"ぎょう"],[29,1,"う"]],"text":"こうしてヨセフの子孫のマナセと、エフライムとは、その嗣業を受けた。"},{"ref":"Josh.16.5","start":6016005,"end":6016005,"break":"paragraph","ruby":[[6,2,"しそん"],[12,2,"かぞく"],[20,1,"え"],[22,1,"ち"],[24,1,"さかい"],[27,1,"つぎ"],[36,1,"かれ"],[39,1,"し"],[40,1,"ぎょう"],[42,1,"ひがし"],[44,1,"さかい"],[60,1,"うえ"],[67,1,"たっ"]],"text":"エフライムの子孫が、その家族にしたがって獲た地の境は、次のとおりである。彼らの嗣業の東の境は、アタロテ・アダルであって、上ベテホロンに達し、"},{"ref":"Josh.16.6","start":6016006,"end":6016006,"break":"none","ruby":[[2,1,"さかい"],[7,1,"ところ"],[10,1,"うみ"],[12,1,"およ"],[15,1,"きた"],[27,1,"ひがし"],[32,1,"さかい"],[41,1,"まが"],[44,1,"すす"],[51,1,"ひがし"],[53,1,"いた"]],"text":"その境は、その所から海に及ぶ。北にはミクメタテがあり、東ではその境はタアナテシロで曲り、進んでヤノアの東に至り、"},{"ref":"Josh.16.7","start":6016007,"end":6016007,"break":"none","ruby":[[14,1,"くだ"],[21,1,"たっ"],[29,1,"いた"],[32,1,"つ"]],"text":"ヤノアからアタロテとナアラに下り、エリコに達し、ヨルダンに至って尽きる。"},{"ref":"Josh.16.8","start":6016008,"end":6016008,"break":"none","ruby":[[8,1,"さかい"],[10,1,"にし"],[12,1,"すす"],[19,1,"かわ"],[21,1,"たっ"],[24,1,"うみ"],[26,1,"いた"],[29,1,"つ"],[42,2,"しそん"],[45,2,"ぶぞく"],[51,2,"かぞく"],[59,1,"え"],[61,1,"し"],[62,1,"ぎょう"]],"text":"タップアからその境は西に進んで、カナの川に達し、海に至って尽きる。これはエフライムの子孫の部族が、その家族にしたがって獲た嗣業である。"},{"ref":"Josh.16.9","start":6016009,"end":6016009,"break":"none","ruby":[[9,2,"しそん"],[12,1,"し"],[13,1,"ぎょう"],[26,2,"しそん"],[32,1,"わ"],[34,1,"あた"],[39,2,"まちまち"],[52,2,"まちまち"],[59,1,"ぞく"],[62,2,"むらむら"],[65,1,"え"]],"text":"このほかにマナセの子孫の嗣業のうちにも、エフライムの子孫のために分け与えられた町々があって、そのすべての町々と、それに属する村々を獲た。"},{"ref":"Josh.16.10","start":6016010,"end":6016010,"break":"none","ruby":[[8,1,"す"],[17,1,"お"],[19,1,"はら"],[34,2,"こんにち"],[44,1,"なか"],[46,1,"す"],[49,2,"どれい"],[55,1,"お"],[57,1,"つか"]],"text":"ただし、ゲゼルに住むカナンびとを、追い払わなかったので、カナンびとは今日までエフライムの中に住み、奴隷となって追い使われている。"}]