[{"ref":"Rom.11.1","start":45011001,"end":45011001,"break":"paragraph","ruby":[[8,1,"と"],[12,1,"かみ"],[16,1,"たみ"],[18,1,"す"],[29,1,"だん"],[48,1,"ひと"],[59,2,"しそん"],[67,1,"ぞく"],[69,1,"もの"]],"text":"そこで、わたしは問う、「神はその民を捨てたのであろうか」。断じてそうではない。わたしもイスラエル人であり、アブラハムの子孫、ベニヤミン族の者である。"},{"ref":"Rom.11.2","start":45011002,"end":45011002,"break":"none","ruby":[[0,1,"かみ"],[8,1,"し"],[17,1,"たみ"],[20,1,"す"],[33,2,"せいしょ"],[46,1,"い"],[59,1,"し"],[71,1,"かれ"],[79,1,"かみ"],[81,1,"うった"],[86,1,"い"]],"text":"神は、あらかじめ知っておられたその民を、捨てることはされなかった。聖書がエリヤについてなんと言っているか、あなたがたは知らないのか。すなわち、彼はイスラエルを神に訴えてこう言った。"},{"ref":"Rom.11.3","start":45011003,"end":45011003,"break":"none","ruby":[[1,1,"しゅ"],[4,1,"かれ"],[11,3,"よげんしゃ"],[17,1,"ころ"],[24,2,"さいだん"],[42,1,"と"],[44,1,"のこ"],[51,1,"かれ"],[63,1,"もと"]],"text":"「主よ、彼らはあなたの預言者たちを殺し、あなたの祭壇をこぼち、そして、わたしひとりが取り残されたのに、彼らはわたしのいのちをも求めています」。"},{"ref":"Rom.11.4","start":45011004,"end":45011004,"break":"none","ruby":[[4,1,"かれ"],[6,1,"たい"],[9,1,"み"],[10,1,"つ"],[38,1,"にん"],[48,1,"のこ"]],"text":"しかし、彼に対する御告げはなんであったか、「バアルにひざをかがめなかった七千人を、わたしのために残しておいた」。"},{"ref":"Rom.11.5","start":45011005,"end":45011005,"break":"none","ruby":[[3,1,"おな"],[9,1,"いま"],[11,1,"とき"],[15,1,"めぐ"],[18,1,"えら"],[24,1,"のこ"],[28,1,"もの"]],"text":"それと同じように、今の時にも、恵みの選びによって残された者がいる。"},{"ref":"Rom.11.6","start":45011006,"end":45011006,"break":"none","ruby":[[4,1,"めぐ"],[18,1,"おこな"],[36,1,"めぐ"],[42,1,"めぐ"]],"text":"しかし、恵みによるのであれば、もはや行いによるのではない。そうでないと、恵みはもはや恵みでなくなるからである。"},{"ref":"Rom.11.7","start":45011007,"end":45011007,"break":"none","ruby":[[18,1,"お"],[20,1,"もと"],[28,1,"え"],[35,1,"えら"],[39,1,"もの"],[45,1,"え"],[52,1,"た"],[54,1,"もの"]],"text":"では、どうなるのか。イスラエルはその追い求めているものを得ないで、ただ選ばれた者が、それを得た。そして、他の者たちはかたくなになった。"},{"ref":"Rom.11.8","start":45011008,"end":45011008,"break":"stanza","breaks":[[12,"line"],[30,"line"]],"ruby":[[1,1,"かみ"],[4,1,"かれ"],[7,1,"にぶ"],[9,1,"こころ"],[12,1,"み"],[16,1,"め"],[19,1,"きこ"],[23,1,"みみ"],[26,1,"あた"],[36,1,"ひ"],[38,1,"およ"],[45,1,"か"]],"text":"「神は、彼らに鈍い心と、見えない目と、聞えない耳とを与えて、きょう、この日に及んでいる」と書いてあるとおりである。"},{"ref":"Rom.11.9","start":45011009,"end":45011009,"break":"none","breaks":[[12,"stanza"],[34,"line"]],"ruby":[[6,1,"い"],[13,1,"かれ"],[16,2,"しょくたく"],[20,1,"かれ"],[29,1,"あみ"],[42,2,"ほうふく"]],"text":"ダビデもまた言っている、「彼らの食卓は、彼らのわなとなれ、網となれ、つまずきとなれ、報復となれ。"},{"ref":"Rom.11.10","start":45011010,"end":45011010,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"め"],[10,1,"み"],[17,1,"かれ"],[20,1,"せ"],[28,1,"まが"]],"text":"彼らの目は、くらんで見えなくなれ、彼らの背は、いつまでも曲っておれ」。"},{"ref":"Rom.11.11","start":45011011,"end":45011011,"break":"paragraph","ruby":[[8,1,"と"],[12,1,"かれ"],[23,1,"たお"],[36,1,"だん"],[51,1,"かれ"],[54,2,"ざいか"],[61,1,"すくい"],[63,3,"いほうじん"],[67,1,"およ"],[82,2,"ふんき"]],"text":"そこで、わたしは問う、「彼らがつまずいたのは、倒れるためであったのか」。断じてそうではない。かえって、彼らの罪過によって、救が異邦人に及び、それによってイスラエルを奮起させるためである。"},{"ref":"Rom.11.12","start":45011012,"end":45011012,"break":"none","ruby":[[7,1,"かれ"],[10,2,"ざいか"],[13,1,"よ"],[15,1,"とみ"],[20,1,"かれ"],[23,2,"しっぱい"],[26,3,"いほうじん"],[30,1,"とみ"],[43,1,"かれ"],[46,2,"ぜんぶ"],[48,1,"すく"]],"text":"しかし、もし、彼らの罪過が世の富となり、彼らの失敗が異邦人の富となったとすれば、まして彼らが全部救われたなら、どんなにかすばらしいことであろう。"},{"ref":"Rom.11.13","start":45011013,"end":45011013,"break":"paragraph","ruby":[[13,3,"いほうじん"],[17,1,"い"],[23,2,"じしん"],[26,3,"いほうじん"],[30,2,"しと"],[44,1,"つとめ"],[46,2,"こうえい"]],"text":"そこでわたしは、あなたがた異邦人に言う。わたし自身は異邦人の使徒なのであるから、わたしの務を光栄とし、"},{"ref":"Rom.11.14","start":45011014,"end":45011014,"break":"none","ruby":[[10,2,"こつにく"],[13,2,"ふんき"],[18,1,"かれ"],[21,2,"いくにん"],[25,1,"すく"],[29,1,"ねが"]],"text":"どうにかしてわたしの骨肉を奮起させ、彼らの幾人かを救おうと願っている。"},{"ref":"Rom.11.15","start":45011015,"end":45011015,"break":"none","ruby":[[2,1,"かれ"],[5,1,"す"],[13,1,"よ"],[15,2,"わかい"],[26,1,"かれ"],[29,1,"う"],[40,2,"しにん"],[43,1,"なか"],[46,1,"い"],[48,1,"かえ"]],"text":"もし彼らの捨てられたことが世の和解となったとすれば、彼らの受けいれられることは、死人の中から生き返ることではないか。"},{"ref":"Rom.11.16","start":45011016,"end":45011016,"break":"none","ruby":[[3,2,"むぎこ"],[6,2,"はつほ"],[28,1,"ね"],[38,1,"えだ"]],"text":"もし、麦粉の初穂がきよければ、そのかたまりもきよい。もし根がきよければ、その枝もきよい。"},{"ref":"Rom.11.17","start":45011017,"end":45011017,"break":"none","ruby":[[8,1,"えだ"],[10,1,"き"],[12,1,"さ"],[17,2,"やせい"],[41,1,"ね"],[43,1,"ゆた"],[46,2,"ようぶん"]],"text":"しかし、もしある枝が切り去られて、野生のオリブであるあなたがそれにつがれ、オリブの根の豊かな養分にあずかっているとすれば、"},{"ref":"Rom.11.18","start":45011018,"end":45011018,"break":"none","ruby":[[6,1,"えだ"],[8,1,"たい"],[11,1,"ほこ"],[23,1,"ほこ"],[34,1,"ね"],[48,1,"ね"]],"text":"あなたはその枝に対して誇ってはならない。たとえ誇るとしても、あなたが根をささえているのではなく、根があなたをささえているのである。"},{"ref":"Rom.11.19","start":45011019,"end":45011019,"break":"none","ruby":[[10,1,"えだ"],[12,1,"き"],[14,1,"さ"],[37,1,"い"]],"text":"すると、あなたは、「枝が切り去られたのは、わたしがつがれるためであった」と言うであろう。"},{"ref":"Rom.11.20","start":45011020,"end":45011020,"break":"none","ruby":[[13,1,"かれ"],[16,1,"ふ"],[17,2,"しんこう"],[23,1,"き"],[25,1,"さ"],[33,2,"しんこう"],[39,1,"た"],[49,1,"たか"],[53,1,"おも"],[66,1,"おそ"]],"text":"まさに、そのとおりである。彼らは不信仰のゆえに切り去られ、あなたは信仰のゆえに立っているのである。高ぶった思いをいだかないで、むしろ恐れなさい。"},{"ref":"Rom.11.21","start":45011021,"end":45011021,"break":"none","ruby":[[2,1,"かみ"],[4,2,"もとき"],[7,1,"えだ"],[9,1,"お"],[25,1,"お"]],"text":"もし神が元木の枝を惜しまなかったとすれば、あなたを惜しむようなことはないであろう。"},{"ref":"Rom.11.22","start":45011022,"end":45011022,"break":"none","ruby":[[0,1,"かみ"],[2,2,"じあい"],[5,2,"しゅんげん"],[9,1,"み"],[12,1,"かみ"],[14,2,"しゅんげん"],[17,1,"たお"],[20,1,"もの"],[24,1,"む"],[29,1,"かみ"],[31,2,"じあい"],[43,2,"じあい"],[60,1,"む"],[77,1,"き"],[79,1,"と"]],"text":"神の慈愛と峻厳とを見よ。神の峻厳は倒れた者たちに向けられ、神の慈愛は、もしあなたがその慈愛にとどまっているなら、あなたに向けられる。そうでないと、あなたも切り取られるであろう。"},{"ref":"Rom.11.23","start":45011023,"end":45011023,"break":"none","ruby":[[3,1,"かれ"],[7,1,"ふ"],[8,2,"しんこう"],[11,1,"つづ"],[27,1,"かみ"],[30,1,"かれ"],[33,1,"ふたた"],[37,1,"ちから"]],"text":"しかし彼らも、不信仰を続けなければ、つがれるであろう。神には彼らを再びつぐ力がある。"},{"ref":"Rom.11.24","start":45011024,"end":45011024,"break":"none","ruby":[[11,2,"しぜん"],[17,2,"やせい"],[25,1,"き"],[27,1,"と"],[31,2,"しぜん"],[34,2,"せいしつ"],[37,1,"はん"],[40,1,"よ"],[62,2,"しぜん"],[68,1,"よ"],[70,1,"えだ"],[81,1,"もと"]],"text":"なぜなら、もしあなたが自然のままの野生のオリブから切り取られ、自然の性質に反して良いオリブにつがれたとすれば、まして、これら自然のままの良い枝は、もっとたやすく、元のオリブにつがれないであろうか。"},{"ref":"Rom.11.25","start":45011025,"end":45011025,"break":"paragraph","ruby":[[0,2,"きょうだい"],[12,2,"ちしゃ"],[16,2,"じふ"],[31,2,"おくぎ"],[34,1,"し"],[49,2,"いちぶ"],[57,1,"びと"],[70,3,"いほうじん"],[74,2,"ぜんぶ"],[76,1,"すく"],[81,1,"いた"],[83,1,"とき"]],"text":"兄弟たちよ。あなたがたが知者だと自負することのないために、この奥義を知らないでいてもらいたくない。一部のイスラエル人がかたくなになったのは、異邦人が全部救われるに至る時までのことであって、"},{"ref":"Rom.11.26","start":45011026,"end":45011026,"break":"none","breaks":[[41,"stanza"],[54,"line"]],"ruby":[[10,1,"びと"],[16,1,"すく"],[30,1,"つぎ"],[35,1,"か"],[42,1,"すく"],[44,1,"もの"],[59,3,"ふしんじん"],[63,1,"お"],[65,1,"はら"]],"text":"こうして、イスラエル人は、すべて救われるであろう。すなわち、次のように書いてある、「救う者がシオンからきて、ヤコブから不信心を追い払うであろう。"},{"ref":"Rom.11.27","start":45011027,"end":45011027,"break":"line","breaks":[[20,"line"]],"ruby":[[8,1,"かれ"],[11,1,"つみ"],[13,1,"のぞ"],[15,1,"さ"],[17,1,"とき"],[20,1,"かれ"],[23,1,"たい"],[26,1,"た"],[33,2,"けいやく"]],"text":"そして、これが、彼らの罪を除き去る時に、彼らに対して立てるわたしの契約である」。"},{"ref":"Rom.11.28","start":45011028,"end":45011028,"break":"none","ruby":[[0,2,"ふくいん"],[6,1,"い"],[10,1,"かれ"],[24,1,"かみ"],[26,1,"てき"],[35,1,"えら"],[41,1,"い"],[45,2,"ふそ"],[54,1,"かみ"],[56,1,"あい"],[61,1,"もの"]],"text":"福音について言えば、彼らは、あなたがたのゆえに、神の敵とされているが、選びについて言えば、父祖たちのゆえに、神に愛せられる者である。"},{"ref":"Rom.11.29","start":45011029,"end":45011029,"break":"none","ruby":[[0,1,"かみ"],[2,2,"たまもの"],[5,1,"め"],[10,1,"か"]],"text":"神の賜物と召しとは、変えられることがない。"},{"ref":"Rom.11.30","start":45011030,"end":45011030,"break":"none","ruby":[[11,1,"かみ"],[13,1,"ふ"],[14,2,"じゅうじゅん"],[22,1,"いま"],[24,1,"かれ"],[27,1,"ふ"],[28,2,"じゅうじゅん"],[39,1,"う"]],"text":"あなたがたが、かつては神に不従順であったが、今は彼らの不従順によってあわれみを受けたように、"},{"ref":"Rom.11.31","start":45011031,"end":45011031,"break":"none","ruby":[[0,1,"かれ"],[3,1,"いま"],[5,1,"ふ"],[6,2,"じゅうじゅん"],[26,1,"う"],[38,1,"かれ"],[40,2,"じしん"],[43,1,"いま"],[49,1,"う"]],"text":"彼らも今は不従順になっているが、それは、あなたがたの受けたあわれみによって、彼ら自身も今あわれみを受けるためなのである。"},{"ref":"Rom.11.32","start":45011032,"end":45011032,"break":"none","ruby":[[5,1,"かみ"],[11,1,"ひと"],[25,1,"ひと"],[27,1,"ふ"],[28,2,"じゅうじゅん"],[34,1,"と"],[36,1,"こ"]],"text":"すなわち、神はすべての人をあわれむために、すべての人を不従順のなかに閉じ込めたのである。"},{"ref":"Rom.11.33","start":45011033,"end":45011033,"break":"paragraph","ruby":[[2,1,"ふか"],[7,1,"かみ"],[9,2,"ちえ"],[12,2,"ちしき"],[16,1,"とみ"],[25,1,"きわ"],[33,1,"みち"],[35,1,"はか"]],"text":"ああ深いかな、神の知恵と知識との富は。そのさばきは窮めがたく、その道は測りがたい。"},{"ref":"Rom.11.34","start":45011034,"end":45011034,"break":"stanza","breaks":[[16,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"こころ"],[9,1,"し"],[20,1,"しゅ"],[22,2,"けいかく"]],"text":"「だれが、主の心を知っていたか。だれが、主の計画にあずかったか。"},{"ref":"Rom.11.35","start":45011035,"end":45011035,"break":"line","breaks":[[15,"line"]],"ruby":[[9,1,"しゅ"],[11,1,"あた"],[17,1,"むく"],[20,1,"う"]],"text":"また、だれが、まず主に与えて、その報いを受けるであろうか」。"},{"ref":"Rom.11.36","start":45011036,"end":45011036,"break":"none","ruby":[[0,2,"ばんぶつ"],[4,1,"かみ"],[10,1,"かみ"],[15,1,"な"],[18,1,"かみ"],[20,1,"き"],[28,2,"えいこう"],[36,1,"かみ"]],"text":"万物は、神からいで、神によって成り、神に帰するのである。栄光がとこしえに神にあるように、アァメン。"}]