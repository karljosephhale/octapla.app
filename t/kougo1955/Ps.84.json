[{"ref":"Ps.84.1","start":19084001,"end":19084001,"break":"paragraph","title":"聖歌隊の指揮者によってギテトのしらべにあわせてうたわせたコラの子の歌","breaks":[[6,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[17,1,"うるわ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[31,1,"こ"],[33,1,"うた"]],"text":"万軍の主よ、あなたのすまいはいかに麗しいことでしょう。"},{"ref":"Ps.84.2","start":19084002,"end":19084002,"break":"line","breaks":[[20,"line"]],"ruby":[[2,1,"たましい"],[4,1,"た"],[12,1,"しゅ"],[14,2,"おおにわ"],[17,1,"した"],[22,1,"こころ"],[26,1,"み"],[28,1,"い"],[31,1,"かみ"],[37,1,"よろこ"],[39,1,"うた"]],"text":"わが魂は絶えいるばかりに主の大庭を慕い、わが心とわが身は生ける神にむかって喜び歌います。"},{"ref":"Ps.84.3","start":19084003,"end":19084003,"break":"line","breaks":[[10,"line"],[30,"line"],[44,"line"],[56,"line"]],"ruby":[[8,1,"え"],[22,1,"す"],[24,1,"え"],[30,2,"ばんぐん"],[33,1,"しゅ"],[37,1,"おう"],[41,1,"かみ"],[48,2,"さいだん"],[62,1,"え"]],"text":"すずめがすみかを得、つばめがそのひなをいれる巣を得るように、万軍の主、わが王、わが神よ、あなたの祭壇のかたわらにわがすまいを得させてください。"},{"ref":"Ps.84.4","start":19084004,"end":19084004,"break":"line","breaks":[[9,"line"]],"ruby":[[4,1,"いえ"],[6,1,"す"],[9,1,"つね"],[21,1,"ひと"]],"text":"あなたの家に住み、常にあなたをほめたたえる人はさいわいです。〔セラ"},{"ref":"Ps.84.5","start":19084005,"end":19084005,"break":"line","breaks":[[11,"line"]],"ruby":[[2,1,"ちから"],[13,1,"こころ"],[19,2,"おおじ"],[24,1,"ひと"]],"text":"その力があなたにあり、その心がシオンの大路にある人はさいわいです。"},{"ref":"Ps.84.6","start":19084006,"end":19084006,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[0,1,"かれ"],[6,1,"たに"],[8,1,"とお"],[16,1,"いずみ"],[20,1,"ところ"],[28,1,"まえ"],[30,1,"あめ"],[32,1,"いけ"]],"text":"彼らはバカの谷を通っても、そこを泉のある所とします。また前の雨は池をもってそこをおおいます。"},{"ref":"Ps.84.7","start":19084007,"end":19084007,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ちから"],[6,1,"ちから"],[8,1,"すす"],[18,2,"かみがみ"],[21,1,"かみ"]],"text":"彼らは力から力に進み、シオンにおいて神々の神にまみえるでしょう。"},{"ref":"Ps.84.8","start":19084008,"end":19084008,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[5,1,"しゅ"],[10,1,"いのり"],[24,1,"かみ"],[27,1,"みみ"],[29,1,"かたむ"]],"text":"万軍の神、主よ、わが祈をおききください。ヤコブの神よ、耳を傾けてください。〔セラ"},{"ref":"Ps.84.9","start":19084009,"end":19084009,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かみ"],[7,1,"たて"],[19,1,"あぶら"],[25,1,"もの"],[27,1,"かお"]],"text":"神よ、われらの盾をみそなわし、あなたの油そそがれた者の顔をかえりみてください。"},{"ref":"Ps.84.10","start":19084010,"end":19084010,"break":"line","breaks":[[13,"line"],[29,"line"],[44,"line"]],"ruby":[[4,2,"おおにわ"],[10,1,"にち"],[19,1,"にち"],[33,1,"あく"],[35,2,"てんまく"],[50,1,"かみ"],[52,1,"いえ"],[54,2,"かどもり"],[62,1,"ねが"]],"text":"あなたの大庭にいる一日は、よそにいる千日にもまさるのです。わたしは悪の天幕にいるよりは、むしろ、わが神の家の門守となることを願います。"},{"ref":"Ps.84.11","start":19084011,"end":19084011,"break":"line","breaks":[[13,"line"],[24,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"ひ"],[9,1,"たて"],[13,1,"しゅ"],[15,1,"めぐ"],[18,1,"ほまれ"],[21,1,"あた"],[24,1,"なお"],[26,1,"あゆ"],[28,1,"もの"],[30,1,"よ"],[32,1,"もの"],[34,1,"こば"]],"text":"主なる神は日です、盾です。主は恵みと誉とを与え、直く歩む者に良い物を拒まれることはありません。"},{"ref":"Ps.84.12","start":19084012,"end":19084012,"break":"line","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[10,2,"しんらい"],[14,1,"ひと"]],"text":"万軍の主よ、あなたに信頼する人はさいわいです。"}]