[{"ref":"Isa.6.1","start":23006001,"end":23006001,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"し"],[8,1,"とし"],[14,1,"しゅ"],[16,1,"たか"],[27,1,"ざ"],[32,1,"ころも"],[37,2,"しんでん"],[40,1,"み"],[47,1,"み"]],"text":"ウジヤ王の死んだ年、わたしは主が高くあげられたみくらに座し、その衣のすそが神殿に満ちているのを見た。"},{"ref":"Isa.6.2","start":23006002,"end":23006002,"break":"none","ruby":[[2,1,"うえ"],[9,1,"た"],[19,1,"つばさ"],[35,1,"かお"],[47,1,"あし"],[59,1,"と"]],"text":"その上にセラピムが立ち、おのおの六つの翼をもっていた。その二つをもって顔をおおい、二つをもって足をおおい、二つをもって飛びかけり、"},{"ref":"Isa.6.3","start":23006003,"end":23006003,"break":"none","breaks":[[12,"stanza"]],"ruby":[[0,1,"たがい"],[2,1,"よ"],[8,1,"い"],[13,1,"せい"],[19,1,"せい"],[25,1,"せい"],[31,2,"ばんぐん"],[34,1,"しゅ"],[38,2,"えいこう"],[41,1,"ぜん"],[42,1,"ち"],[44,1,"み"]],"text":"互に呼びかわして言った。「聖なるかな、聖なるかな、聖なるかな、万軍の主、その栄光は全地に満つ」。"},{"ref":"Isa.6.4","start":23006004,"end":23006004,"break":"none","ruby":[[2,1,"よ"],[9,1,"もの"],[11,1,"こえ"],[16,2,"しきい"],[19,1,"もとい"],[21,1,"ふる"],[23,1,"うご"],[26,2,"しんでん"],[29,1,"なか"],[31,1,"けむり"],[33,1,"み"]],"text":"その呼ばわっている者の声によって敷居の基が震い動き、神殿の中に煙が満ちた。"},{"ref":"Isa.6.5","start":23006005,"end":23006005,"break":"none","ruby":[[2,1,"とき"],[7,1,"い"],[25,1,"ほろ"],[37,1,"けが"],[45,1,"もの"],[48,1,"けが"],[56,1,"たみ"],[58,1,"なか"],[60,1,"す"],[62,1,"もの"],[73,1,"め"],[75,2,"ばんぐん"],[78,1,"しゅ"],[81,1,"おう"],[83,1,"み"]],"text":"その時わたしは言った、「わざわいなるかな、わたしは滅びるばかりだ。わたしは汚れたくちびるの者で、汚れたくちびるの民の中に住む者であるのに、わたしの目が万軍の主なる王を見たのだから」。"},{"ref":"Isa.6.6","start":23006006,"end":23006006,"break":"paragraph","ruby":[[2,1,"とき"],[12,1,"ひ"],[20,2,"さいだん"],[23,1,"うえ"],[26,1,"と"],[29,1,"も"],[34,1,"すみ"],[36,1,"て"],[38,1,"たずさ"],[49,1,"と"]],"text":"この時セラピムのひとりが火ばしをもって、祭壇の上から取った燃えている炭を手に携え、わたしのところに飛んできて、"},{"ref":"Isa.6.7","start":23006007,"end":23006007,"break":"none","ruby":[[4,1,"くち"],[6,1,"ふ"],[9,1,"い"],[14,1,"み"],[29,1,"ふ"],[39,1,"あく"],[41,1,"のぞ"],[49,1,"つみ"]],"text":"わたしの口に触れて言った、「見よ、これがあなたのくちびるに触れたので、あなたの悪は除かれ、あなたの罪はゆるされた」。"},{"ref":"Isa.6.8","start":23006008,"end":23006008,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"い"],[12,1,"こえ"],[14,1,"き"],[44,1,"い"],[54,1,"とき"],[59,1,"い"]],"text":"わたしはまた主の言われる声を聞いた、「わたしはだれをつかわそうか。だれがわれわれのために行くだろうか」。その時わたしは言った、「ここにわたしがおります。わたしをおつかわしください」。"},{"ref":"Isa.6.9","start":23006009,"end":23006009,"break":"none","breaks":[[28,"stanza"],[46,"line"],[58,"line"],[75,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"い"],[18,1,"たみ"],[22,1,"い"],[40,1,"き"],[49,1,"さと"],[69,1,"み"]],"text":"主は言われた、「あなたは行って、この民にこう言いなさい、『あなたがたはくりかえし聞くがよい、しかし悟ってはならない。あなたがたはくりかえし見るがよい、しかしわかってはならない』と。"},{"ref":"Isa.6.10","start":23006010,"end":23006010,"break":"line","breaks":[[14,"line"],[36,"line"],[55,"line"],[62,"line"]],"ruby":[[6,1,"たみ"],[8,1,"こころ"],[10,1,"にぶ"],[16,1,"みみ"],[18,1,"きこ"],[27,1,"め"],[29,1,"と"],[39,1,"かれ"],[44,1,"め"],[46,1,"み"],[50,1,"みみ"],[52,1,"き"],[57,1,"こころ"],[59,1,"さと"],[62,1,"く"],[64,1,"あらた"]],"text":"あなたはこの民の心を鈍くし、その耳を聞えにくくし、その目を閉ざしなさい。これは彼らがその目で見、その耳で聞き、その心で悟り、悔い改めていやされることのないためである」。"},{"ref":"Isa.6.11","start":23006011,"end":23006011,"break":"line","breaks":[[25,"line"],[32,"line"],[50,"line"]],"ruby":[[8,1,"い"],[13,1,"しゅ"],[25,1,"しゅ"],[27,1,"い"],[33,2,"まちまち"],[36,1,"あ"],[43,1,"す"],[45,1,"もの"],[50,1,"いえ"],[53,1,"ひと"],[60,1,"くに"],[62,1,"まった"],[64,1,"あ"],[66,1,"ち"]],"text":"そこで、わたしは言った、「主よ、いつまでですか」。主は言われた、「町々は荒れすたれて、住む者もなく、家には人かげもなく、国は全く荒れ地となり、"},{"ref":"Isa.6.12","start":23006012,"end":23006012,"break":"line","breaks":[[15,"line"],[34,"line"]],"ruby":[[0,2,"ひとびと"],[3,1,"しゅ"],[8,1,"とお"],[11,1,"うつ"],[15,1,"あ"],[20,1,"ところ"],[22,1,"くに"],[24,1,"なか"],[26,1,"おお"],[30,1,"とき"]],"text":"人々は主によって遠くへ移され、荒れはてた所が国の中に多くなる時まで、こうなっている。"},{"ref":"Isa.6.13","start":23006013,"end":23006013,"break":"line","breaks":[[18,"line"],[31,"line"],[54,"line"],[67,"line"]],"ruby":[[2,1,"なか"],[5,1,"ぶん"],[9,1,"のこ"],[11,1,"もの"],[23,1,"や"],[25,1,"ほろ"],[36,1,"き"],[43,1,"き"],[45,1,"き"],[47,1,"たお"],[56,1,"き"],[58,1,"かぶ"],[60,1,"のこ"],[67,1,"せい"],[70,2,"しゅぞく"],[75,1,"き"],[77,1,"かぶ"]],"text":"その中に十分の一の残る者があっても、これもまた焼き滅ぼされる。テレビンの木またはかしの木が切り倒されるとき、その切り株が残るように」。聖なる種族はその切り株である。"}]