[{"ref":"Jer.42.1","start":24042001,"end":24042001,"break":"paragraph","ruby":[[4,2,"ぐんぜい"],[7,1,"ちょう"],[18,1,"こ"],[30,1,"こ"],[40,1,"たみ"],[42,1,"もっと"],[44,1,"ちい"],[47,1,"もの"],[50,1,"もっと"],[52,1,"おお"],[56,1,"もの"]],"text":"そのとき軍勢の長たち、およびカレヤの子ヨハナンと、ホシャヤの子アザリヤ、ならびに民の最も小さい者から最も大いなる者にいたるまで、"},{"ref":"Jer.42.2","start":24042002,"end":24042002,"break":"none","ruby":[[2,3,"よげんしゃ"],[10,1,"ところ"],[12,1,"き"],[14,1,"い"],[26,1,"まえ"],[33,1,"もと"],[36,1,"う"],[58,1,"のこ"],[63,1,"もの"],[76,1,"かみ"],[78,1,"しゅ"],[80,1,"いの"],[89,1,"いま"],[103,1,"おお"],[113,1,"のこ"],[118,1,"もの"]],"text":"みな預言者エレミヤの所に来て言った、「どうかあなたの前にわれわれの求めが受けいれられますように。われわれのため、この残っている者すべてのために、あなたの神、主に祈ってください、（今ごらんのとおり、われわれは多くのうち、わずかに残っている者です）"},{"ref":"Jer.42.3","start":24042003,"end":24042003,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[20,1,"い"],[24,1,"みち"],[31,1,"こと"],[34,1,"しめ"]],"text":"そうすれば、あなたの神、主は、われわれの行くべき道と、なすべき事をお示しになるでしょう」。"},{"ref":"Jer.42.4","start":24042004,"end":24042004,"break":"none","ruby":[[0,3,"よげんしゃ"],[8,1,"かれ"],[11,1,"い"],[31,1,"もと"],[46,1,"かみ"],[48,1,"しゅ"],[50,1,"いの"],[57,1,"しゅ"],[65,1,"こた"],[74,2,"なにごと"],[77,1,"かく"],[88,1,"い"]],"text":"預言者エレミヤは彼らに言った、「よくわかりました。あなたがたの求めにしたがって、あなたがたの神、主に祈りましょう。主があなたがたに答えられることを、何事も隠さないであなたがたに言いましょう」。"},{"ref":"Jer.42.5","start":24042005,"end":24042005,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[20,1,"かみ"],[22,1,"しゅ"],[34,1,"つ"],[43,2,"ことば"],[52,1,"おこな"],[63,1,"しゅ"],[70,1,"たい"],[77,2,"しんじつ"],[80,2,"しょうにん"]],"text":"彼らはエレミヤに言った、「もし、あなたの神、主があなたをつかわしてお告げになるすべての言葉を、われわれが行わないときは、どうか主がわれわれに対してまことの真実な証人となられるように。"},{"ref":"Jer.42.6","start":24042006,"end":24042006,"break":"none","ruby":[[5,1,"よ"],[9,1,"わる"],[36,1,"かみ"],[38,1,"しゅ"],[40,1,"こえ"],[42,1,"したが"],[52,1,"かみ"],[54,1,"しゅ"],[56,1,"こえ"],[58,1,"したが"],[68,1,"さいわい"],[70,1,"え"]],"text":"われわれは良くても悪くても、われわれがあなたをつかわそうとするわれわれの神、主の声に従います。われわれの神、主の声に従うとき、われわれは幸を得るでしょう」。"},{"ref":"Jer.42.7","start":24042007,"end":24042007,"break":"paragraph","ruby":[[1,1,"か"],[3,1,"のち"],[5,1,"しゅ"],[7,2,"ことば"],[15,1,"のぞ"]],"text":"十日の後、主の言葉がエレミヤに臨んだ。"},{"ref":"Jer.42.8","start":24042008,"end":24042008,"break":"none","ruby":[[9,1,"こ"],[17,1,"かれ"],[19,1,"とも"],[23,2,"ぐんぜい"],[26,1,"ちょう"],[34,1,"たみ"],[36,1,"もっと"],[38,1,"ちい"],[41,1,"もの"],[44,1,"もっと"],[46,1,"おお"],[50,1,"もの"],[58,1,"まね"]],"text":"エレミヤはカレヤの子ヨハナンおよび彼と共にいる軍勢の長たち、ならびに民の最も小さい者から最も大いなる者までことごとく招いて、"},{"ref":"Jer.42.9","start":24042009,"end":24042009,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[28,2,"きがん"],[33,1,"まえ"],[46,1,"かみ"],[48,1,"しゅ"],[52,1,"い"]],"text":"彼らに言った、「あなたがたがわたしをつかわして、あなたの祈願をその前にのべさせたイスラエルの神、主はこう言われます、"},{"ref":"Jer.42.10","start":24042010,"end":24042010,"break":"none","ruby":[[10,1,"ち"],[30,1,"た"],[33,1,"たお"],[46,1,"う"],[49,1,"ぬ"],[68,1,"わざわい"],[70,1,"くだ"],[76,1,"く"]],"text":"もしあなたがたがこの地にとどまるならば、わたしはあなたがたを建てて倒すことなく、あなたがたを植えて抜くことはしない。わたしはあなたがたに災を下したことを悔いているからである。"},{"ref":"Jer.42.11","start":24042011,"end":24042011,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"おそ"],[21,1,"おう"],[23,1,"おそ"],[32,1,"かれ"],[34,1,"おそ"],[47,1,"とも"],[58,1,"すく"],[61,1,"かれ"],[63,1,"て"],[66,1,"たす"],[68,1,"だ"]],"text":"主は言われる、あなたが恐れているバビロンの王を恐れてはならない。彼を恐れてはならない、わたしが共にいて、あなたがたを救い、彼の手から助け出すからである。"},{"ref":"Jer.42.12","start":24042012,"end":24042012,"break":"none","ruby":[[17,1,"かれ"],[37,2,"じぶん"],[40,1,"ち"]],"text":"わたしはあなたがたをあわれみ、また彼にあなたがたをあわれませ、あなたがたを自分の地にとどまらせる。"},{"ref":"Jer.42.13","start":24042013,"end":24042013,"break":"none","ruby":[[21,1,"ち"],[41,1,"かみ"],[43,1,"しゅ"],[45,1,"こえ"]],"text":"しかし、もしあなたがたが、『われわれはこの地にとどまらない』といって、あなたがたの神、主の声にしたがわず、"},{"ref":"Jer.42.14","start":24042014,"end":24042014,"break":"none","ruby":[[15,2,"せんそう"],[18,1,"み"],[25,1,"こえ"],[27,1,"き"],[31,2,"しょくもつ"],[34,1,"とぼ"],[44,1,"ち"],[46,1,"い"],[54,1,"す"],[60,1,"い"]],"text":"また、『いいえ、われわれはあの戦争を見ず、ラッパの声を聞かず、食物も乏しくないエジプトの地へ行って、あそこに住まおう』と言うならば、"},{"ref":"Jer.42.15","start":24042015,"end":24042015,"break":"none","ruby":[[9,1,"のこ"],[14,1,"もの"],[19,1,"しゅ"],[21,2,"ことば"],[24,1,"き"],[30,2,"ばんぐん"],[33,1,"しゅ"],[41,1,"かみ"],[45,1,"い"],[66,1,"い"],[72,1,"す"]],"text":"あなたがた、ユダの残っている者たちよ、主の言葉を聞きなさい。万軍の主、イスラエルの神はこう言われる、もしあなたがたがむりにエジプトへ行ってそこに住むならば、"},{"ref":"Jer.42.16","start":24042016,"end":24042016,"break":"none","ruby":[[6,1,"おそ"],[20,1,"ち"],[28,1,"お"],[39,1,"おそ"],[54,1,"お"],[63,1,"い"],[68,1,"ところ"],[76,1,"し"]],"text":"あなたがたの恐れているつるぎはエジプトの地であなたがたに追いつき、あなたがたの恐れているききんは、すぐあとを追ってエジプトまで行き、その所であなたがたは死ぬ。"},{"ref":"Jer.42.17","start":24042017,"end":24042017,"break":"none","ruby":[[11,1,"い"],[17,1,"す"],[19,1,"もの"],[32,2,"えきびょう"],[35,1,"し"],[42,1,"かれ"],[45,1,"くだ"],[53,1,"わざわい"],[59,1,"のこ"],[61,1,"もの"]],"text":"すべてむりにエジプトへ行ってそこに住む者は、つるぎと、ききんと、疫病で死ぬ。わたしが彼らに下そうとしている災をのがれて残る者はそのうちにない。"},{"ref":"Jer.42.18","start":24042018,"end":24042018,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[15,1,"い"],[24,1,"いか"],[27,1,"いきどお"],[37,2,"じゅうみん"],[40,1,"うえ"],[42,1,"そそ"],[53,1,"いきどお"],[68,1,"い"],[79,1,"うえ"],[81,1,"そそ"],[98,2,"きょうふ"],[127,1,"ふたた"],[131,1,"ところ"],[133,1,"み"]],"text":"万軍の主、イスラエルの神はこう言われる、わたしの怒りと憤りとをエルサレムの住民の上に注いだように、わたしの憤りは、あなたがたがエジプトへ行くとき、あなたがたの上に注ぐ。あなたがたは、のろいとなり、恐怖となり、ののしりとなり、はずかしめとなる。あなたがたは再びこの所を見ることができない。"},{"ref":"Jer.42.19","start":24042019,"end":24042019,"break":"none","ruby":[[3,1,"のこ"],[8,1,"もの"],[19,1,"い"],[29,1,"しゅ"],[37,1,"い"],[49,2,"けいこく"],[63,1,"たし"],[66,1,"し"]],"text":"ユダの残っている者たちよ、『エジプトへ行ってはならない』と主はあなたがたに言われた。わたしがきょう警告したことを、あなたがたは確かに知らなければならない。"},{"ref":"Jer.42.20","start":24042020,"end":24042020,"break":"none","ruby":[[13,1,"さ"],[17,1,"いのち"],[19,1,"うしな"],[44,1,"かみ"],[46,1,"しゅ"],[59,1,"かみ"],[61,1,"しゅ"],[63,1,"いの"],[71,1,"かみ"],[73,1,"しゅ"],[75,1,"い"],[87,1,"しめ"],[103,1,"おこな"],[109,1,"い"]],"text":"あなたがたはみずからそむき去って、命を失った。なぜなら、あなたがたがわたしをあなたがたの神、主につかわし、『われわれの神、主に祈り、われわれの神、主の言われることをことごとく示してください。われわれはそれを行います』と言ったので、"},{"ref":"Jer.42.21","start":24042021,"end":24042021,"break":"none","ruby":[[10,1,"しめ"],[27,1,"かみ"],[29,1,"しゅ"],[31,1,"こえ"],[33,1,"き"],[37,1,"しゅ"],[48,1,"めい"],[55,1,"こと"],[63,1,"したが"]],"text":"わたしはきょうそれを示したが、あなたがたはあなたがたの神、主の声を聞かず、主がわたしをつかわして命じさせられた事には、すこしも従わなかったからである。"},{"ref":"Jer.42.22","start":24042022,"end":24042022,"break":"none","ruby":[[11,1,"い"],[14,1,"す"],[20,1,"ねが"],[27,1,"ところ"],[46,2,"えきびょう"],[49,1,"し"],[54,1,"たし"],[57,1,"し"]],"text":"それゆえ、あなたがたが行って住まうことを願っているその所で、あなたがたはつるぎと、ききんと、疫病で死ぬことを確かに知らなければならない」。"}]