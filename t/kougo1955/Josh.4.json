[{"ref":"Josh.4.1","start":6004001,"end":6004001,"break":"paragraph","ruby":[[0,1,"たみ"],[2,1,"みな"],[9,1,"わた"],[11,1,"おわ"],[14,1,"とき"],[16,1,"しゅ"],[23,1,"い"]],"text":"民が皆、ヨルダンを渡り終った時、主はヨシュアに言われた、"},{"ref":"Josh.4.2","start":6004002,"end":6004002,"break":"none","ruby":[[1,1,"たみ"],[8,2,"ぶぞく"],[19,1,"あ"],[25,1,"にん"],[27,1,"えら"]],"text":"「民のうちから、部族ごとにひとりずつ、合わせて十二人を選び、"},{"ref":"Josh.4.3","start":6004003,"end":6004003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"めい"],[6,1,"い"],[18,1,"なか"],[20,2,"さいし"],[25,1,"あし"],[27,1,"ふ"],[35,1,"ところ"],[39,1,"いし"],[43,1,"と"],[49,1,"たずさ"],[52,1,"わた"],[55,2,"こんや"],[63,1,"やど"],[65,2,"ばしょ"]],"text":"彼らに命じて言いなさい、『ヨルダンの中で祭司たちが足を踏みとどめたその所から、石十二を取り、それを携えて渡り、今夜あなたがたが宿る場所にすえなさい』」。"},{"ref":"Josh.4.4","start":6004004,"end":6004004,"break":"none","ruby":[[14,2,"ひとびと"],[22,2,"ぶぞく"],[37,1,"さだ"],[45,1,"にん"],[47,1,"もの"],[49,1,"め"],[51,1,"よ"]],"text":"そこでヨシュアはイスラエルの人々のうちから、部族ごとに、ひとりずつ、かねて定めておいた十二人の者を召し寄せ、"},{"ref":"Josh.4.5","start":6004005,"end":6004005,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[19,1,"かみ"],[21,1,"しゅ"],[23,2,"けいやく"],[26,1,"はこ"],[28,1,"まえ"],[30,1,"た"],[33,1,"い"],[41,1,"なか"],[43,1,"すす"],[45,1,"はい"],[54,2,"ひとびと"],[57,2,"ぶぞく"],[60,1,"かず"],[72,1,"いし"],[76,1,"と"],[78,1,"あ"],[81,1,"かた"],[86,1,"はこ"]],"text":"ヨシュアは彼らに言った、「あなたがたの神、主の契約の箱の前に立って行き、ヨルダンの中に進み入り、イスラエルの人々の部族の数にしたがって、おのおの石一つを取り上げ、肩にのせて運びなさい。"},{"ref":"Josh.4.6","start":6004006,"end":6004006,"break":"none","ruby":[[24,1,"のち"],[26,1,"ひ"],[38,1,"こ"],[50,1,"いし"],[64,1,"と"]],"text":"これはあなたがたのうちに、しるしとなるであろう。後の日になって、あなたがたの子どもたちが、『これらの石は、どうしたわけですか』と問うならば、"},{"ref":"Josh.4.7","start":6004007,"end":6004007,"break":"none","ruby":[[2,1,"とき"],[9,1,"かれ"],[21,1,"みず"],[24,1,"しゅ"],[26,2,"けいやく"],[29,1,"はこ"],[31,1,"まえ"],[50,1,"はこ"],[57,1,"わた"],[60,1,"とき"],[67,1,"みず"],[80,1,"つ"],[100,1,"いし"],[102,2,"えいきゅう"],[111,2,"ひとびと"],[114,2,"きねん"]],"text":"その時あなたがたは彼らに、むかしヨルダンの水が、主の契約の箱の前で、せきとめられたこと、すなわちその箱がヨルダンを渡った時、ヨルダンの水が、せきとめられたことを告げなければならない。こうして、それらの石は永久にイスラエルの人々の記念となるであろう」。"},{"ref":"Josh.4.8","start":6004008,"end":6004008,"break":"paragraph","ruby":[[6,2,"ひとびと"],[14,1,"めい"],[22,1,"しゅ"],[29,1,"い"],[43,2,"ひとびと"],[46,2,"ぶぞく"],[49,1,"かず"],[62,1,"なか"],[68,1,"いし"],[70,1,"と"],[76,1,"たずさ"],[79,1,"わた"],[82,1,"かれ"],[85,1,"やど"],[87,2,"ばしょ"],[90,1,"い"]],"text":"イスラエルの人々はヨシュアが命じたようにし、主がヨシュアに言われたように、イスラエルの人々の部族の数にしたがって、ヨルダンの中から十二の石を取り、それを携えて渡り、彼らの宿る場所へ行って、そこにすえた。"},{"ref":"Josh.4.9","start":6004009,"end":6004009,"break":"none","ruby":[[12,1,"なか"],[15,2,"けいやく"],[18,1,"はこ"],[22,2,"さいし"],[28,1,"あし"],[30,1,"ふ"],[36,1,"ところ"],[42,1,"いし"],[44,1,"た"],[49,2,"こんにち"],[57,1,"のこ"]],"text":"ヨシュアはまたヨルダンの中で、契約の箱をかく祭司たちが、足を踏みとどめた所に、十二の石を立てたが、今日まで、そこに残っている。"},{"ref":"Josh.4.10","start":6004010,"end":6004010,"break":"none","ruby":[[0,1,"はこ"],[4,2,"さいし"],[10,1,"しゅ"],[17,1,"めい"],[21,1,"たみ"],[23,1,"つ"],[30,1,"こと"],[36,1,"おこな"],[51,1,"なか"],[53,1,"た"],[71,1,"めい"],[81,1,"たみ"],[83,1,"いそ"],[86,1,"わた"]],"text":"箱をかく祭司たちは、主がヨシュアに命じて、民に告げさせられた事が、すべて行われてしまうまで、ヨルダンの中に立っていた。すべてモーセがヨシュアに命じたとおりである。民は急いで渡った。"},{"ref":"Josh.4.11","start":6004011,"end":6004011,"break":"none","ruby":[[0,1,"たみ"],[4,1,"わた"],[6,1,"おわ"],[9,1,"とき"],[11,1,"しゅ"],[13,1,"はこ"],[15,2,"さいし"],[22,1,"たみ"],[24,1,"み"],[26,1,"まえ"],[28,1,"わた"]],"text":"民がみな渡り終った時、主の箱と祭司たちとは、民の見る前で渡った。"},{"ref":"Josh.4.12","start":6004012,"end":6004012,"break":"none","ruby":[[4,2,"しそん"],[10,2,"しそん"],[20,2,"ぶぞく"],[23,1,"なか"],[31,1,"かれ"],[34,1,"めい"],[42,2,"ぶそう"],[53,2,"ひとびと"],[56,2,"さきだ"],[60,1,"わた"]],"text":"ルベンの子孫とガドの子孫、およびマナセの部族の半ばは、モーセが彼らに命じていたように武装して、イスラエルの人々に先立って渡り、"},{"ref":"Josh.4.13","start":6004013,"end":6004013,"break":"none","ruby":[[0,1,"たたか"],[6,2,"ぶそう"],[17,1,"もの"],[19,1,"たたか"],[24,1,"しゅ"],[26,1,"まえ"],[28,1,"わた"],[36,2,"へいや"],[39,1,"つ"]],"text":"戦いのために武装したおおよそ四万の者が戦うため、主の前に渡って、エリコの平野に着いた。"},{"ref":"Josh.4.14","start":6004014,"end":6004014,"break":"none","ruby":[[2,1,"ひ"],[4,1,"しゅ"],[16,1,"ひと"],[18,1,"まえ"],[25,1,"たっと"],[27,1,"もの"],[35,1,"かれ"],[44,1,"うやま"],[56,2,"いっしょう"],[62,1,"うやま"]],"text":"この日、主はイスラエルのすべての人の前にヨシュアを尊い者とされたので、彼らはみなモーセを敬ったように、ヨシュアを一生のあいだ敬った。"},{"ref":"Josh.4.15","start":6004015,"end":6004015,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"い"]],"text":"主はヨシュアに言われた、"},{"ref":"Josh.4.16","start":6004016,"end":6004016,"break":"none","ruby":[[5,1,"はこ"],[9,2,"さいし"],[14,1,"めい"],[24,1,"あ"]],"text":"「あかしの箱をかく祭司たちに命じて、ヨルダンから上がってこさせなさい」。"},{"ref":"Josh.4.17","start":6004017,"end":6004017,"break":"none","ruby":[[5,2,"さいし"],[10,1,"めい"],[13,1,"い"],[24,1,"あ"]],"text":"ヨシュアは祭司たちに命じて言った、「ヨルダンから上がってきなさい」。"},{"ref":"Josh.4.18","start":6004018,"end":6004018,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"けいやく"],[5,1,"はこ"],[9,2,"さいし"],[19,1,"なか"],[22,1,"あ"],[30,2,"さいし"],[35,1,"あし"],[37,1,"うら"],[43,1,"ち"],[49,2,"どうじ"],[58,1,"みず"],[63,1,"ところ"],[65,1,"なが"],[72,2,"いぜん"],[81,1,"きし"]],"text":"主の契約の箱をかく祭司たちはヨルダンの中から上がってきたが、祭司たちの足の裏がかわいた地にあがると同時に、ヨルダンの水はもとの所に流れかえって、以前のように、その岸にことごとくあふれた。"},{"ref":"Josh.4.19","start":6004019,"end":6004019,"break":"paragraph","ruby":[[0,1,"たみ"],[2,2,"しょうがつ"],[6,1,"か"],[15,1,"あ"],[26,1,"ひがし"],[28,1,"さかい"],[37,2,"しゅくえい"]],"text":"民は正月の十日に、ヨルダンから上がってきて、エリコの東の境にあるギルガルに宿営した。"},{"ref":"Josh.4.20","start":6004020,"end":6004020,"break":"none","ruby":[[9,2,"ひとびと"],[18,1,"と"],[26,1,"いし"],[33,1,"た"]],"text":"そしてヨシュアは、人々がヨルダンから取ってきた十二の石をギルガルに立て、"},{"ref":"Josh.4.21","start":6004021,"end":6004021,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"い"],[14,1,"のち"],[16,1,"ひ"],[24,1,"こ"],[33,1,"ちち"],[40,1,"いし"]],"text":"イスラエルの人々に言った、「後の日にあなたがたの子どもたちが、その父に『これらの石は、どうしたわけですか』とたずねたならば、"},{"ref":"Josh.4.22","start":6004022,"end":6004022,"break":"none","ruby":[[22,1,"ち"],[27,1,"わた"],[34,1,"い"],[40,1,"こ"],[46,1,"し"]],"text":"『むかしイスラエルがこのヨルダンを、かわいた地にされて渡ったのだ』と言って、その子どもたちに知らせなければならない。"},{"ref":"Josh.4.23","start":6004023,"end":6004023,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[19,1,"みず"],[31,1,"ほ"],[44,1,"わた"],[68,1,"かみ"],[70,1,"しゅ"],[81,2,"こうかい"],[84,1,"ほ"],[96,1,"わた"],[107,1,"おな"]],"text":"すなわちあなたがたの神、主はヨルダンの水を、あなたがたのために干しからして、あなたがたを渡らせてくださった。それはあたかも、あなたがたの神、主が、われわれのために紅海を干しからして、われわれを渡らせてくださったのと同じである。"},{"ref":"Josh.4.24","start":6004024,"end":6004024,"break":"none","ruby":[[11,1,"ち"],[17,1,"たみ"],[20,1,"しゅ"],[22,1,"て"],[24,1,"ちから"],[31,1,"し"],[41,1,"かみ"],[43,1,"しゅ"],[48,1,"おそ"]],"text":"このようにされたのは、地のすべての民に、主の手に力のあることを知らせ、あなたがたの神、主をつねに恐れさせるためである」。"}]