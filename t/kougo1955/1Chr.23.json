[{"ref":"1Chr.23.1","start":13023001,"end":13023001,"break":"paragraph","ruby":[[4,1,"お"],[9,1,"ひ"],[11,1,"み"],[19,1,"こ"],[31,1,"おう"]],"text":"ダビデは老い、その日が満ちたので、その子ソロモンをイスラエルの王とした。"},{"ref":"1Chr.23.2","start":13023002,"end":13023002,"break":"paragraph","ruby":[[20,2,"さいし"],[28,1,"あつ"]],"text":"ダビデはイスラエルのすべてのつかさおよび祭司とレビびとを集めた。"},{"ref":"1Chr.23.3","start":13023003,"end":13023003,"break":"none","ruby":[[7,1,"さい"],[8,2,"いじょう"],[14,1,"かぞ"],[21,1,"おとこ"],[23,1,"かず"],[29,1,"にん"]],"text":"レビびとの三十歳以上のものを数えると、その男の数が三万八千人あった。"},{"ref":"1Chr.23.4","start":13023004,"end":13023004,"break":"none","ruby":[[4,1,"い"],[17,1,"にん"],[19,1,"しゅ"],[21,1,"いえ"],[23,2,"しごと"],[34,1,"にん"]],"text":"ダビデは言った、「そのうち二万四千人は主の家の仕事をつかさどり、六千人はつかさびと、およびさばきびととなり、"},{"ref":"1Chr.23.5","start":13023005,"end":13023005,"break":"none","ruby":[[2,1,"にん"],[4,1,"もん"],[6,1,"まも"],[8,1,"もの"],[17,1,"にん"],[30,1,"つく"],[33,2,"がっき"],[36,1,"しゅ"]],"text":"四千人は門を守る者となり、また四千人はさんびのためにわたしの造った楽器で主をたたえよ」。"},{"ref":"1Chr.23.6","start":13023006,"end":13023006,"break":"none","ruby":[[7,1,"かれ"],[13,1,"こ"],[35,1,"くみ"],[37,1,"わ"]],"text":"そしてダビデは彼らをレビの子らにしたがってゲルション、コハテ、メラリの組に分けた。"},{"ref":"1Chr.23.7","start":13023007,"end":13023007,"break":"paragraph","ruby":[[6,1,"こ"]],"text":"ゲルションの子らはラダンとシメイ。"},{"ref":"1Chr.23.8","start":13023008,"end":13023008,"break":"none","ruby":[[4,1,"こ"],[26,1,"にん"]],"text":"ラダンの子らは、かしらのエヒエルとゼタムとヨエルの三人。"},{"ref":"1Chr.23.9","start":13023009,"end":13023009,"break":"none","ruby":[[4,1,"こ"],[22,1,"にん"],[32,2,"しぞく"],[35,1,"ちょう"]],"text":"シメイの子らはシロミテ、ハジエル、ハランの三人。これらはラダンの氏族の長であった。"},{"ref":"1Chr.23.10","start":13023010,"end":13023010,"break":"none","ruby":[[4,1,"こ"],[23,1,"にん"],[25,1,"みな"],[30,1,"こ"]],"text":"シメイの子らはヤハテ、ジナ、エウシ、ベリアの四人。皆シメイの子で、"},{"ref":"1Chr.23.11","start":13023011,"end":13023011,"break":"none","ruby":[[13,1,"つぎ"],[23,1,"こ"],[25,1,"おお"],[37,1,"かぞ"],[45,2,"しぞく"]],"text":"ヤハテはかしら、ジザはその次、エウシとベリアは子が多くなかったので、ともに数えられて一つの氏族となった。"},{"ref":"1Chr.23.12","start":13023012,"end":13023012,"break":"paragraph","ruby":[[4,1,"こ"],[28,1,"にん"]],"text":"コハテの子らはアムラム、イヅハル、ヘブロン、ウジエルの四人。"},{"ref":"1Chr.23.13","start":13023013,"end":13023013,"break":"none","ruby":[[5,1,"こ"],[25,1,"こ"],[37,1,"せい"],[43,2,"せいべつ"],[50,1,"わ"],[56,1,"しゅ"],[58,1,"まえ"],[60,1,"こう"],[65,1,"しゅ"],[67,1,"つか"],[70,1,"つね"],[72,1,"しゅ"],[74,1,"な"],[79,2,"しゅくふく"]],"text":"アムラムの子らはアロンとモーセである。アロンはその子らとともに、ながくいと聖なるものを聖別するために分かたれて、主の前に香をたき、主に仕え、常に主の名をもって祝福することをなした。"},{"ref":"1Chr.23.14","start":13023014,"end":13023014,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ひと"],[7,1,"こ"],[13,2,"ぶぞく"],[19,1,"かぞ"]],"text":"神の人モーセの子らはレビの部族のうちに数えられた。"},{"ref":"1Chr.23.15","start":13023015,"end":13023015,"break":"none","ruby":[[4,1,"こ"]],"text":"モーセの子らはゲルションとエリエゼル。"},{"ref":"1Chr.23.16","start":13023016,"end":13023016,"break":"none","ruby":[[6,1,"こ"]],"text":"ゲルションの子らは、かしらはシブエル。"},{"ref":"1Chr.23.17","start":13023017,"end":13023017,"break":"none","ruby":[[6,1,"こ"],[31,1,"こ"],[46,1,"こ"],[49,2,"ひじょう"],[52,1,"おお"]],"text":"エリエゼルの子らは、かしらはレハビヤ。エリエゼルにはこのほかに子がなかった。しかしレハビヤの子らは非常に多かった。"},{"ref":"1Chr.23.18","start":13023018,"end":13023018,"break":"none","ruby":[[5,1,"こ"]],"text":"イヅハルの子らは、かしらはシロミテ。"},{"ref":"1Chr.23.19","start":13023019,"end":13023019,"break":"none","ruby":[[5,1,"こ"],[8,2,"ちょうし"],[15,1,"つぎ"],[22,1,"だい"],[31,1,"だい"]],"text":"ヘブロンの子らは長子はエリヤ、次はアマリヤ、第三はヤハジエル、第四はエカメアム。"},{"ref":"1Chr.23.20","start":13023020,"end":13023020,"break":"none","ruby":[[5,1,"こ"],[16,1,"つぎ"]],"text":"ウジエルの子らは、かしらはミカ、次はイシアである。"},{"ref":"1Chr.23.21","start":13023021,"end":13023021,"break":"paragraph","ruby":[[4,1,"こ"],[18,1,"こ"]],"text":"メラリの子らはマヘリとムシ。マヘリの子らはエレアザルとキシ。"},{"ref":"1Chr.23.22","start":13023022,"end":13023022,"break":"none","ruby":[[6,1,"おとこ"],[8,1,"こ"],[13,1,"し"],[18,1,"むすめ"],[32,1,"こ"],[38,2,"みうち"],[41,1,"おとこ"],[45,2,"かのじょ"]],"text":"エレアザルは男の子がなくて死に、ただ娘たちだけであったが、キシの子であるその身内の男たちが彼女たちをめとった。"},{"ref":"1Chr.23.23","start":13023023,"end":13023023,"break":"none","ruby":[[3,1,"こ"],[20,1,"にん"]],"text":"ムシの子らはマヘリ、エデル、エレモテの三人である。"},{"ref":"1Chr.23.24","start":13023024,"end":13023024,"break":"paragraph","ruby":[[6,2,"しぞく"],[14,2,"しそん"],[23,2,"にんずう"],[26,1,"かぞ"],[33,1,"な"],[41,1,"しゅ"],[43,1,"いえ"],[45,1,"つとめ"],[52,1,"さい"],[53,2,"いじょう"],[56,1,"もの"],[59,2,"しぞく"],[62,1,"ちょう"]],"text":"これらはその氏族によるレビの子孫であって、その人数が数えられ、その名がしるされて、主の家の務をなした二十歳以上の者で、氏族の長であった。"},{"ref":"1Chr.23.25","start":13023025,"end":13023025,"break":"none","ruby":[[4,1,"い"],[15,1,"かみ"],[17,1,"しゅ"],[21,1,"たみ"],[23,2,"へいあん"],[26,1,"あた"],[38,1,"す"]],"text":"ダビデは言った、「イスラエルの神、主はその民に平安を与え、ながくエルサレムに住まわれる。"},{"ref":"1Chr.23.26","start":13023026,"end":13023026,"break":"none","ruby":[[5,1,"かさ"],[8,2,"まくや"],[15,1,"つと"],[18,2,"うつわもの"]],"text":"レビびとは重ねて幕屋およびその勤めの器物をかつぐことはない。"},{"ref":"1Chr.23.27","start":13023027,"end":13023027,"break":"none","ruby":[[6,2,"さいご"],[9,2,"ことば"],[23,1,"さい"],[24,2,"いじょう"],[27,1,"もの"],[29,1,"かぞ"]],"text":"――ダビデの最後の言葉によって、レビびとは二十歳以上の者が数えられた――"},{"ref":"1Chr.23.28","start":13023028,"end":13023028,"break":"none","ruby":[[0,1,"かれ"],[3,1,"つとめ"],[9,2,"しそん"],[12,1,"たす"],[15,1,"しゅ"],[17,1,"いえ"],[19,1,"はたら"],[24,1,"にわ"],[29,2,"しごと"],[38,1,"せい"],[44,1,"きよ"],[58,1,"かみ"],[60,1,"いえ"],[62,1,"はたら"]],"text":"彼らの務はアロンの子孫を助けて主の家の働きをし、庭とへやの仕事およびすべての聖なるものを清めること、そのほか、すべて神の家の働きをすることである。"},{"ref":"1Chr.23.29","start":13023029,"end":13023029,"break":"none","ruby":[[2,1,"そな"],[8,2,"そさい"],[11,2,"むぎこ"],[14,1,"たね"],[15,1,"い"],[18,2,"かし"],[21,1,"や"],[24,1,"そな"],[26,1,"もの"],[28,1,"あぶら"],[33,1,"そな"],[35,1,"もの"],[48,2,"ぶんりょう"],[53,1,"おお"],[57,1,"はか"]],"text":"また供えのパン、素祭の麦粉、種入れぬ菓子、焼いた供え物、油をまぜた供え物をつかさどり、またすべて分量および大きさを量ることをつかさどり、"},{"ref":"1Chr.23.30","start":13023030,"end":13023030,"break":"none","ruby":[[2,1,"あさ"],[6,1,"た"],[9,1,"しゅ"],[11,2,"かんしゃ"],[20,1,"ゆう"]],"text":"また朝ごとに立って主に感謝し、さんびし、夕にもまたそのようにし、"},{"ref":"1Chr.23.31","start":13023031,"end":13023031,"break":"none","ruby":[[2,3,"あんそくにち"],[6,2,"しんげつ"],[9,2,"さいじつ"],[13,1,"しゅ"],[20,2,"はんさい"],[31,1,"た"],[34,1,"しゅ"],[36,1,"まえ"],[40,1,"めい"],[45,1,"かず"]],"text":"また安息日と新月と祭日に、主にもろもろの燔祭をささげるときは、絶えず主の前にその命じられた数にしたがってささげなければならない。"},{"ref":"1Chr.23.32","start":13023032,"end":13023032,"break":"none","ruby":[[7,1,"かれ"],[10,2,"かいけん"],[13,2,"まくや"],[16,2,"せいじょ"],[19,1,"つとめ"],[21,1,"まも"],[24,1,"しゅ"],[26,1,"いえ"],[28,1,"はたら"],[36,2,"きょうだい"],[45,1,"こ"],[48,1,"つか"]],"text":"このようにして彼らは会見の幕屋と聖所の務を守り、主の家の働きのためにその兄弟であるアロンの子らに仕えなければならない」。"}]