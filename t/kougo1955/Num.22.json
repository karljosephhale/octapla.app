[{"ref":"Num.22.1","start":4022001,"end":4022001,"break":"paragraph","ruby":[[9,2,"ひとびと"],[14,1,"みち"],[16,1,"すす"],[24,1,"ちか"],[39,2,"へいや"],[42,2,"しゅくえい"]],"text":"さて、イスラエルの人々はまた道を進んで、エリコに近いヨルダンのかなたのモアブの平野に宿営した。"},{"ref":"Num.22.2","start":4022002,"end":4022002,"break":"none","ruby":[[5,1,"こ"],[28,1,"こと"],[30,1,"み"]],"text":"チッポルの子バラクはイスラエルがアモリびとにしたすべての事を見たので、"},{"ref":"Num.22.3","start":4022003,"end":4022003,"break":"none","ruby":[[4,1,"おお"],[13,1,"たみ"],[15,1,"おそ"],[21,1,"かず"],[23,1,"おお"],[43,2,"ひとびと"],[51,1,"おそ"]],"text":"モアブは大いにイスラエルの民を恐れた。その数が多かったためである。モアブはイスラエルの人々をひじょうに恐れたので、"},{"ref":"Num.22.4","start":4022004,"end":4022004,"break":"none","ruby":[[5,2,"ちょうろう"],[10,1,"い"],[17,2,"ぐんしゅう"],[20,1,"うし"],[22,1,"の"],[24,1,"くさ"],[40,2,"しゅうい"],[43,1,"もの"],[66,1,"こ"],[73,1,"とき"],[78,1,"おう"]],"text":"ミデアンの長老たちに言った、「この群衆は牛が野の草をなめつくすように、われわれの周囲の物をみな、なめつくそうとしている」。チッポルの子バラクはこの時モアブの王であった。"},{"ref":"Num.22.5","start":4022005,"end":4022005,"break":"none","ruby":[[0,1,"かれ"],[9,1,"くに"],[15,1,"かわ"],[27,2,"ししゃ"],[39,1,"こ"],[44,1,"まね"],[50,1,"い"],[62,1,"で"],[66,1,"たみ"],[71,1,"ち"],[85,1,"まえ"]],"text":"彼はアンモンびとの国のユフラテ川のほとりにあるペトルに使者をつかわし、ベオルの子バラムを招こうとして言わせた、「エジプトから出てきた民があり、地のおもてをおおってわたしの前にいます。"},{"ref":"Num.22.6","start":4022006,"end":4022006,"break":"none","ruby":[[3,1,"いま"],[15,1,"たみ"],[26,1,"かれ"],[35,1,"つよ"],[56,1,"かれ"],[59,1,"う"],[65,1,"くに"],[68,1,"お"],[70,1,"はら"],[90,2,"しゅくふく"],[94,1,"もの"],[96,2,"しゅくふく"],[108,1,"もの"],[122,1,"し"]],"text":"どうぞ今きてわたしのためにこの民をのろってください。彼らはわたしよりも強いのです。そうしてくだされば、われわれは彼らを撃って、この国から追い払うことができるかもしれません。あなたが祝福する者は祝福され、あなたがのろう者はのろわれることをわたしは知っています」。"},{"ref":"Num.22.7","start":4022007,"end":4022007,"break":"paragraph","ruby":[[4,2,"ちょうろう"],[14,2,"ちょうろう"],[19,1,"うらな"],[22,2,"れいもつ"],[25,1,"て"],[29,2,"しゅっぱつ"],[40,1,"い"],[48,2,"ことば"],[51,1,"つ"]],"text":"モアブの長老たちとミデアンの長老たちは占いの礼物を手にして出発し、バラムのもとへ行って、バラクの言葉を告げた。"},{"ref":"Num.22.8","start":4022008,"end":4022008,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[12,2,"こんや"],[17,1,"と"],[24,1,"しゅ"],[30,1,"つ"],[46,2,"へんとう"]],"text":"バラムは彼らに言った、「今夜ここに泊まりなさい。主がわたしに告げられるとおりに、あなたがたに返答しましょう」。それでモアブのつかさたちはバラムのもとにとどまった。"},{"ref":"Num.22.9","start":4022009,"end":4022009,"break":"none","ruby":[[3,1,"かみ"],[9,1,"のぞ"],[12,1,"い"],[30,2,"ひとびと"]],"text":"ときに神はバラムに臨んで言われた、「あなたのところにいるこの人々はだれですか」。"},{"ref":"Num.22.10","start":4022010,"end":4022010,"break":"none","ruby":[[4,1,"かみ"],[6,1,"い"],[15,1,"おう"],[21,1,"こ"],[31,1,"ひと"],[37,1,"い"]],"text":"バラムは神に言った、「モアブの王チッポルの子バラクが、わたしに人をよこして言いました。"},{"ref":"Num.22.11","start":4022011,"end":4022011,"break":"none","ruby":[[7,1,"で"],[11,1,"たみ"],[16,1,"ち"],[33,1,"いま"],[43,1,"かれ"],[64,1,"たたか"],[68,1,"かれ"],[71,1,"お"],[73,1,"はら"]],"text":"『エジプトから出てきた民があり、地のおもてをおおっています。どうぞ今きてわたしのために彼らをのろってください。そうすればわたしは戦って、彼らを追い払うことができるかもしれません』」。"},{"ref":"Num.22.12","start":4022012,"end":4022012,"break":"none","ruby":[[0,1,"かみ"],[6,1,"い"],[16,1,"かれ"],[19,2,"いっしょ"],[22,1,"い"],[35,1,"たみ"],[47,1,"かれ"],[50,2,"しゅくふく"],[55,1,"もの"]],"text":"神はバラムに言われた、「あなたは彼らと一緒に行ってはならない。またその民をのろってはならない。彼らは祝福された者だからである」。"},{"ref":"Num.22.13","start":4022013,"end":4022013,"break":"none","ruby":[[0,1,"あ"],[3,1,"あさ"],[4,1,"お"],[22,1,"い"],[33,1,"くに"],[36,1,"かえ"],[42,1,"しゅ"],[54,2,"いっしょ"],[57,1,"い"],[64,1,"ゆる"]],"text":"明くる朝起きて、バラムはバラクのつかさたちに言った、「あなたがたは国にお帰りなさい。主はわたしがあなたがたと一緒に行くことを、お許しになりません」。"},{"ref":"Num.22.14","start":4022014,"end":4022014,"break":"none","ruby":[[10,1,"た"],[20,1,"い"],[23,1,"い"],[38,2,"いっしょ"],[41,1,"く"],[46,2,"しょうち"]],"text":"モアブのつかさたちは立ってバラクのもとに行って言った、「バラムはわたしたちと一緒に来ることを承知しません」。"},{"ref":"Num.22.15","start":4022015,"end":4022015,"break":"paragraph","ruby":[[6,1,"まえ"],[8,1,"もの"],[12,2,"みぶん"],[15,1,"たか"],[23,1,"まえ"],[27,1,"おお"]],"text":"バラクはまた前の者よりも身分の高いつかさたちを前よりも多くつかわした。"},{"ref":"Num.22.16","start":4022016,"end":4022016,"break":"none","ruby":[[0,1,"かれ"],[11,1,"い"],[14,1,"い"],[24,1,"こ"],[31,1,"もう"],[40,1,"さまた"],[44,1,"かえり"]],"text":"彼らはバラムのところへ行って言った、「チッポルの子バラクはこう申します、『どんな妨げをも顧みず、どうぞわたしのところへおいでください。"},{"ref":"Num.22.17","start":4022017,"end":4022017,"break":"none","ruby":[[8,1,"おお"],[11,2,"ゆうぐう"],[28,1,"い"],[32,1,"こと"],[58,1,"たみ"]],"text":"わたしはあなたを大いに優遇します。そしてあなたがわたしに言われる事はなんでもいたします。どうぞきてわたしのためにこの民をのろってください』」。"},{"ref":"Num.22.18","start":4022018,"end":4022018,"break":"none","ruby":[[12,2,"けらい"],[17,1,"こた"],[31,1,"いえ"],[33,1,"み"],[39,2,"きんぎん"],[46,1,"あた"],[53,1,"こと"],[55,2,"だいしょう"],[58,1,"と"],[66,1,"かみ"],[68,1,"しゅ"],[70,2,"ことば"],[73,1,"こ"],[77,1,"なに"]],"text":"しかし、バラムはバラクの家来たちに答えた、「たといバラクがその家に満ちるほどの金銀をわたしに与えようとも、事の大小を問わず、わたしの神、主の言葉を越えては何もすることができません。"},{"ref":"Num.22.19","start":4022019,"end":4022019,"break":"none","ruby":[[14,2,"こんや"],[25,1,"しゅ"],[29,1,"うえ"],[38,1,"おお"],[45,1,"たし"]],"text":"それで、どうぞ、あなたがたも今夜ここにとどまって、主がこの上、わたしになんと仰せられるかを確かめさせてください」。"},{"ref":"Num.22.20","start":4022020,"end":4022020,"break":"none","ruby":[[0,1,"よる"],[5,1,"かみ"],[11,1,"のぞ"],[14,1,"い"],[22,2,"ひとびと"],[29,1,"まね"],[39,1,"た"],[44,2,"ひとびと"],[47,2,"いっしょ"],[50,1,"い"],[63,1,"つ"],[71,1,"おこな"]],"text":"夜になり、神はバラムに臨んで言われた、「この人々はあなたを招きにきたのだから、立ってこの人々と一緒に行きなさい。ただしわたしが告げることだけを行わなければならない」。"},{"ref":"Num.22.21","start":4022021,"end":4022021,"break":"paragraph","ruby":[[0,1,"あ"],[3,1,"あさ"],[4,1,"お"],[31,2,"いっしょ"],[34,1,"い"]],"text":"明くる朝起きてバラムは、ろばにくらをおき、モアブのつかさたちと一緒に行った。"},{"ref":"Num.22.22","start":4022022,"end":4022022,"break":"none","ruby":[[4,1,"かみ"],[6,1,"かれ"],[8,1,"い"],[14,1,"いか"],[17,1,"はっ"],[22,1,"しゅ"],[24,1,"つかい"],[26,1,"かれ"],[28,1,"さまた"],[36,1,"みち"],[38,1,"た"],[56,1,"の"],[68,1,"かれ"],[70,1,"とも"]],"text":"しかるに神は彼が行ったために怒りを発せられ、主の使は彼を妨げようとして、道に立ちふさがっていた。バラムは、ろばに乗り、そのしもべふたりも彼と共にいたが、"},{"ref":"Num.22.23","start":4022023,"end":4022023,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"つかい"],[8,1,"て"],[10,1,"ぬ"],[12,1,"み"],[22,1,"みち"],[24,1,"た"],[35,1,"み"],[37,1,"みち"],[42,1,"はたけ"],[59,1,"う"],[62,1,"みち"],[64,1,"かえ"]],"text":"ろばは主の使が、手に抜き身のつるぎをもって、道に立ちふさがっているのを見、道をそれて畑にはいったので、バラムは、ろばを打って道に返そうとした。"},{"ref":"Num.22.24","start":4022024,"end":4022024,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"つかい"],[13,1,"はたけ"],[15,1,"あいだ"],[17,1,"せま"],[19,1,"みち"],[21,1,"た"],[31,1,"みち"],[33,2,"りょうがわ"],[37,1,"いし"]],"text":"しかるに主の使はまたぶどう畑の間の狭い道に立ちふさがっていた。道の両側には石がきがあった。"},{"ref":"Num.22.25","start":4022025,"end":4022025,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"つかい"],[7,1,"み"],[10,1,"いし"],[16,1,"よ"],[23,1,"あし"],[25,1,"いし"],[29,1,"お"],[48,1,"う"]],"text":"ろばは主の使を見て、石がきにすり寄り、バラムの足を石がきに押しつけたので、バラムは、また、ろばを打った。"},{"ref":"Num.22.26","start":4022026,"end":4022026,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[6,1,"さき"],[8,1,"すす"],[12,1,"せま"],[14,1,"ところ"],[16,1,"た"],[29,1,"みぎ"],[32,1,"ひだり"],[36,1,"まが"],[38,1,"みち"]],"text":"主の使はまた先に進んで、狭い所に立ちふさがっていた。そこは右にも左にも、曲る道がなかったので、"},{"ref":"Num.22.27","start":4022027,"end":4022027,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"つかい"],[7,1,"み"],[13,1,"した"],[15,1,"ふ"],[26,1,"いか"],[29,1,"はっ"],[38,1,"う"]],"text":"ろばは主の使を見てバラムの下に伏した。そこでバラムは怒りを発し、つえでろばを打った。"},{"ref":"Num.22.28","start":4022028,"end":4022028,"break":"none","ruby":[[4,1,"しゅ"],[10,1,"くち"],[12,1,"ひら"],[30,1,"い"],[43,1,"なに"],[60,1,"ど"],[66,1,"う"]],"text":"すると、主が、ろばの口を開かれたので、ろばはバラムにむかって言った、「わたしがあなたに何をしたというのですか。あなたは三度もわたしを打ったのです」。"},{"ref":"Num.22.29","start":4022029,"end":4022029,"break":"none","ruby":[[8,1,"い"],[14,1,"まえ"],[20,1,"あなど"],[31,1,"て"],[45,1,"まえ"],[47,1,"ころ"]],"text":"バラムは、ろばに言った、「お前がわたしを侮ったからだ。わたしの手につるぎがあれば、いま、お前を殺してしまうのだが」。"},{"ref":"Num.22.30","start":4022030,"end":4022030,"break":"none","ruby":[[9,1,"い"],[28,1,"なが"],[33,1,"の"],[79,1,"い"]],"text":"ろばはまたバラムに言った、「わたしはあなたが、きょうまで長いあいだ乗られたろばではありませんか。わたしはいつでも、あなたにこのようにしたでしょうか」。バラムは言った、「いや、しなかった」。"},{"ref":"Num.22.31","start":4022031,"end":4022031,"break":"paragraph","ruby":[[4,1,"しゅ"],[10,1,"め"],[12,1,"ひら"],[19,1,"かれ"],[21,1,"しゅ"],[23,1,"つかい"],[25,1,"て"],[27,1,"ぬ"],[29,1,"み"],[39,1,"みち"],[41,1,"た"],[52,1,"み"],[55,1,"とう"],[57,1,"た"],[62,1,"ふ"]],"text":"このとき主がバラムの目を開かれたので、彼は主の使が手に抜き身のつるぎをもって、道に立ちふさがっているのを見て、頭を垂れてひれ伏した。"},{"ref":"Num.22.32","start":4022032,"end":4022032,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,1,"かれ"],[6,1,"い"],[18,1,"ど"],[23,1,"う"],[33,1,"あやま"],[36,1,"みち"],[38,1,"い"],[51,1,"さまた"],[58,1,"で"]],"text":"主の使は彼に言った、「なぜあなたは三度もろばを打ったのか。あなたが誤って道を行くので、わたしはあなたを妨げようとして出てきたのだ。"},{"ref":"Num.22.33","start":4022033,"end":4022033,"break":"none","ruby":[[7,1,"み"],[10,1,"ど"],[12,1,"み"],[14,1,"めぐ"],[22,1,"さ"],[32,1,"み"],[34,1,"めぐ"],[42,1,"さ"],[58,1,"いま"],[63,1,"ころ"],[70,1,"い"]],"text":"ろばはわたしを見て三度も身を巡らしてわたしを避けた。もし、ろばが身を巡らしてわたしを避けなかったなら、わたしはきっと今あなたを殺して、ろばを生かしておいたであろう」。"},{"ref":"Num.22.34","start":4022034,"end":4022034,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"つかい"],[8,1,"い"],[17,1,"つみ"],[19,1,"おか"],[42,1,"みち"],[44,1,"た"],[62,1,"し"],[74,1,"いま"],[79,2,"おき"],[82,1,"め"],[96,1,"かえ"]],"text":"バラムは主の使に言った、「わたしは罪を犯しました。あなたがわたしをとどめようとして、道に立ちふさがっておられるのを、わたしは知りませんでした。それで今、もし、お気に召さないのであれば、わたしは帰りましょう」。"},{"ref":"Num.22.35","start":4022035,"end":4022035,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[8,1,"い"],[15,2,"ひとびと"],[18,2,"いっしょ"],[21,1,"い"],[35,1,"つ"],[43,1,"の"],[73,2,"いっしょ"],[76,1,"い"]],"text":"主の使はバラムに言った、「この人々と一緒に行きなさい。ただし、わたしが告げることのみを述べなければならない」。こうしてバラムはバラクのつかさたちと一緒に行った。"},{"ref":"Num.22.36","start":4022036,"end":4022036,"break":"paragraph","ruby":[[14,1,"き"],[18,2,"こっきょう"],[25,1,"かわ"],[31,2,"こっきょう"],[34,2,"いったん"],[43,1,"まち"],[46,1,"で"],[48,1,"い"],[51,1,"むか"]],"text":"さて、バラクはバラムがきたと聞いて、国境のアルノン川のほとり、国境の一端にあるモアブの町まで出て行って迎えた。"},{"ref":"Num.22.37","start":4022037,"end":4022037,"break":"none","ruby":[[11,1,"い"],[20,1,"ひと"],[31,1,"まね"],[70,2,"じっさい"],[76,2,"ゆうぐう"]],"text":"そしてバラクはバラムに言った、「わたしは人をつかわしてあなたを招いたではありませんか。あなたはなぜわたしのところへきませんでしたか。わたしは実際あなたを優遇することができないでしょうか」。"},{"ref":"Num.22.38","start":4022038,"end":4022038,"break":"none","ruby":[[8,1,"い"],[42,1,"いま"],[44,2,"なにごと"],[52,1,"い"],[71,1,"かみ"],[77,1,"くち"],[79,1,"さづ"],[87,1,"の"]],"text":"バラムはバラクに言った、「ごらんなさい。わたしはあなたのところにきています。しかし、今、何事かをみずから言うことができましょうか。わたしはただ神がわたしの口に授けられることを述べなければなりません」。"},{"ref":"Num.22.39","start":4022039,"end":4022039,"break":"none","ruby":[[12,2,"いっしょ"],[15,1,"い"]],"text":"こうしてバラムはバラクと一緒に行き、キリアテ・ホゾテにきたとき、"},{"ref":"Num.22.40","start":4022040,"end":4022040,"break":"none","ruby":[[4,1,"うし"],[6,1,"ひつじ"],[20,1,"かれ"],[22,1,"とも"],[30,1,"つ"],[41,1,"おく"]],"text":"バラクは牛と羊とをほふって、バラムおよび彼と共にいたバラムを連れてきたつかさたちに贈った。"},{"ref":"Num.22.41","start":4022041,"end":4022041,"break":"paragraph","ruby":[[0,1,"あ"],[3,1,"あさ"],[12,1,"ともな"],[36,1,"たみ"],[38,2,"しゅくえい"],[41,2,"いったん"]],"text":"明くる朝バラクはバラムを伴ってバモテバアルにのぼり、そこからイスラエルの民の宿営の一端をながめさせた。"}]