[{"ref":"Deut.19.1","start":5019001,"end":5019001,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,2,"くにぐに"],[11,1,"たみ"],[13,1,"ほろ"],[25,1,"かみ"],[27,1,"しゅ"],[31,1,"ち"],[33,1,"たま"],[44,1,"え"],[49,2,"まちまち"],[55,2,"いえいえ"],[58,1,"す"],[65,1,"とき"]],"text":"あなたの神、主が国々の民を滅ぼしつくして、あなたの神、主がその地を賜わり、あなたがそれを獲て、その町々と、その家々に住むようになる時は、"},{"ref":"Deut.19.2","start":5019002,"end":5019002,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"あた"],[11,1,"え"],[17,1,"ち"],[26,1,"まち"],[35,2,"してい"]],"text":"あなたの神、主が与えて獲させられる地のうちに、三つの町をあなたのために指定しなければならない。"},{"ref":"Deut.19.3","start":5019003,"end":5019003,"break":"none","ruby":[[6,1,"い"],[8,1,"みち"],[10,1,"そな"],[19,1,"かみ"],[21,1,"しゅ"],[27,1,"つ"],[33,1,"ち"],[35,2,"りょういき"],[39,1,"く"],[41,1,"わ"],[47,1,"ひと"],[49,1,"ころ"],[52,1,"もの"]],"text":"そしてそこに行く道を備え、またあなたの神、主があなたに継がせられる地の領域を三区に分け、すべて人を殺した者をそこにのがれさせなければならない。"},{"ref":"Deut.19.4","start":5019004,"end":5019004,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"ころ"],[5,1,"もの"],[15,1,"いのち"],[17,1,"まっと"],[22,2,"ばあい"],[25,1,"つぎ"],[38,2,"いぜん"],[42,1,"にく"],[52,1,"し"],[59,2,"りんじん"],[62,1,"ころ"],[65,2,"ばあい"]],"text":"人を殺した者がそこにのがれて、命を全うすべき場合は次のとおりである。すなわち以前から憎むこともないのに、知らないでその隣人を殺した場合、"},{"ref":"Deut.19.5","start":5019005,"end":5019005,"break":"none","ruby":[[4,1,"ひと"],[6,1,"き"],[8,1,"き"],[15,2,"りんじん"],[18,2,"いっしょ"],[21,1,"はやし"],[23,1,"い"],[26,1,"て"],[31,1,"と"],[35,1,"き"],[37,1,"き"],[39,1,"たお"],[43,1,"う"],[53,1,"あたま"],[55,1,"え"],[58,1,"ぬ"],[61,2,"りんじん"],[69,1,"し"],[76,2,"ばあい"],[89,1,"ひと"],[95,1,"まち"],[105,1,"いのち"],[107,1,"まっと"]],"text":"たとえば人が木を切ろうとして、隣人と一緒に林に入り、手におのを取って、木を切り倒そうと撃ちおろすとき、その頭が柄から抜け、隣人にあたって、死なせたような場合がそれである。そういう人はこれらの町の一つにのがれて、命を全うすることができる。"},{"ref":"Deut.19.6","start":5019006,"end":5019006,"break":"none","ruby":[[8,2,"ふくしゅう"],[12,1,"もの"],[14,1,"いか"],[20,1,"ころ"],[23,1,"もの"],[25,1,"お"],[30,1,"みち"],[32,1,"なが"],[41,1,"お"],[46,1,"ころ"],[59,1,"ひと"],[61,2,"いぜん"],[65,1,"かれ"],[67,1,"にく"],[72,1,"もの"],[79,1,"ころ"],[83,2,"りゆう"]],"text":"そうしなければ、復讐する者が怒って、その殺した者を追いかけ、道が長いために、ついに追いついて殺すであろう。しかし、その人は以前から彼を憎んでいた者でないから、殺される理由はない。"},{"ref":"Deut.19.7","start":5019007,"end":5019007,"break":"none","ruby":[[11,1,"めい"],[18,1,"まち"],[27,2,"してい"],[40,1,"い"]],"text":"それでわたしはあなたに命じて『三つの町をあなたのために指定しなければならない』と言ったのである。"},{"ref":"Deut.19.8","start":5019008,"end":5019008,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,2,"せんぞ"],[13,1,"ちか"],[25,2,"りょういき"],[28,1,"ひろ"],[31,2,"せんぞ"],[36,1,"あた"],[40,1,"い"],[44,1,"ち"],[52,1,"たま"],[55,1,"とき"]],"text":"あなたの神、主が先祖たちに誓われたように、あなたの領域を広め、先祖たちに与えると言われた地を、ことごとく賜わる時、――"},{"ref":"Deut.19.9","start":5019009,"end":5019009,"break":"none","ruby":[[9,1,"めい"],[18,1,"いまし"],[21,1,"まも"],[37,1,"かみ"],[39,1,"しゅ"],[41,1,"あい"],[45,1,"つね"],[49,1,"みち"],[51,1,"あゆ"],[53,1,"とき"],[66,1,"まち"],[77,1,"まち"],[86,1,"ま"],[88,1,"くわ"]],"text":"わたしが、きょう、命じるこのすべての戒めを守って、それをおこない、あなたの神、主を愛して、常にその道に歩む時――あなたはこれら三つの町のほかに、また三つの町をあなたのために増し加えなければならない。"},{"ref":"Deut.19.10","start":5019010,"end":5019010,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[11,1,"あた"],[14,1,"し"],[15,1,"ぎょう"],[20,1,"ち"],[26,1,"つみ"],[30,1,"もの"],[32,1,"ち"],[34,1,"なが"],[60,1,"ち"],[62,1,"なが"],[73,1,"き"]],"text":"これはあなたの神、主が与えて嗣業とされる地のうちで、罪のない者の血が流されないようにするためである。そうしなければ、その血を流したとがは、あなたに帰するであろう。"},{"ref":"Deut.19.11","start":5019011,"end":5019011,"break":"paragraph","ruby":[[6,1,"ひと"],[8,2,"りんじん"],[11,1,"にく"],[23,1,"た"],[31,1,"ひと"],[33,1,"う"],[35,1,"ころ"],[45,1,"まち"]],"text":"しかし、もし人が隣人を憎んでそれをつけねらい、立ちかかってその人を撃ち殺し、そしてこれらの町の一つにのがれるならば、"},{"ref":"Deut.19.12","start":5019012,"end":5019012,"break":"none","ruby":[[2,1,"まち"],[4,2,"ちょうろう"],[9,1,"ひと"],[16,1,"かれ"],[22,1,"ひ"],[29,2,"ふくしゅう"],[33,1,"もの"],[39,1,"ころ"]],"text":"その町の長老たちは人をつかわして彼をそこから引いてこさせ、復讐する者にわたして殺させなければならない。"},{"ref":"Deut.19.13","start":5019013,"end":5019013,"break":"none","ruby":[[0,1,"かれ"],[13,1,"つみ"],[17,1,"もの"],[19,1,"ち"],[21,1,"なが"],[35,1,"のぞ"]],"text":"彼をあわれんではならない。罪のない者の血を流したとがを、イスラエルから除かなければならない。そうすればあなたにさいわいがあるであろう。"},{"ref":"Deut.19.14","start":5019014,"end":5019014,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"あた"],[11,1,"え"],[17,1,"ち"],[24,1,"つ"],[26,1,"し"],[27,1,"ぎょう"],[33,2,"せんぞ"],[36,1,"さだ"],[43,2,"りんじん"],[46,2,"とち"],[49,1,"さかい"],[51,1,"うつ"]],"text":"あなたの神、主が与えて獲させられる地で、あなたが継ぐ嗣業において、先祖の定めたあなたの隣人の土地の境を移してはならない。"},{"ref":"Deut.19.15","start":5019015,"end":5019015,"break":"paragraph","ruby":[[3,2,"ふせい"],[21,1,"ひと"],[23,1,"おか"],[25,1,"つみ"],[34,2,"しょうにん"],[40,1,"さだ"],[53,2,"しょうにん"],[56,2,"しょうげん"],[66,1,"にん"],[68,2,"しょうにん"],[71,2,"しょうげん"],[80,1,"こと"],[82,1,"さだ"]],"text":"どんな不正であれ、どんなとがであれ、すべて人の犯す罪は、ただひとりの証人によって定めてはならない。ふたりの証人の証言により、または三人の証人の証言によって、その事を定めなければならない。"},{"ref":"Deut.19.16","start":5019016,"end":5019016,"break":"none","ruby":[[2,2,"あくい"],[7,2,"しょうにん"],[10,1,"た"],[14,1,"ひと"],[16,1,"たい"],[19,1,"わる"],[21,2,"しょうげん"]],"text":"もし悪意のある証人が起って、人に対して悪い証言をすることがあれば、"},{"ref":"Deut.19.17","start":5019017,"end":5019017,"break":"none","ruby":[[2,1,"あい"],[3,1,"あらそ"],[9,1,"もの"],[11,1,"しゅ"],[13,1,"まえ"],[15,1,"い"],[21,1,"とき"],[23,2,"さいし"],[26,3,"さいばんにん"],[30,1,"まえ"],[32,1,"た"]],"text":"その相争うふたりの者は主の前に行って、その時の祭司と裁判人の前に立たなければならない。"},{"ref":"Deut.19.18","start":5019018,"end":5019018,"break":"none","ruby":[[2,1,"とき"],[4,3,"さいばんにん"],[8,2,"しょうさい"],[14,1,"しら"],[30,2,"しょうにん"],[35,1,"いつわ"],[38,2,"しょうにん"],[45,2,"きょうだい"],[52,1,"いつわ"],[55,2,"しょうげん"],[60,1,"もの"]],"text":"その時、裁判人は詳細にそれを調べなければならない。そしてその証人がもし偽りの証人であって、兄弟にむかって偽りの証言をした者であるならば、"},{"ref":"Deut.19.19","start":5019019,"end":5019019,"break":"none","ruby":[[6,1,"かれ"],[8,2,"きょうだい"],[20,1,"かれ"],[22,1,"おこな"],[39,1,"あく"],[41,1,"のぞ"],[43,1,"さ"]],"text":"あなたがたは彼が兄弟にしようとしたことを彼に行い、こうしてあなたがたのうちから悪を除き去らなければならない。"},{"ref":"Deut.19.20","start":5019020,"end":5019020,"break":"none","ruby":[[5,1,"た"],[7,1,"ひと"],[11,1,"き"],[14,1,"おそ"],[19,1,"のち"],[29,1,"あく"],[40,1,"おこな"]],"text":"そうすれば他の人たちは聞いて恐れ、その後ふたたびそのような悪をあなたがたのうちに行わないであろう。"},{"ref":"Deut.19.21","start":5019021,"end":5019021,"break":"none","ruby":[[11,1,"いのち"],[14,1,"いのち"],[16,1,"め"],[19,1,"め"],[21,1,"は"],[24,1,"は"],[26,1,"て"],[29,1,"て"],[31,1,"あし"],[34,1,"あし"],[39,1,"つぐな"]],"text":"あわれんではならない。命には命、目には目、歯には歯、手には手、足には足をもって償わせなければならない。"}]