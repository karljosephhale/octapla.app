[{"ref":"Neh.1.1","start":16001001,"end":16001001,"break":"paragraph","breaks":[[14,"paragraph"]],"ruby":[[5,1,"こ"],[11,2,"ことば"],[14,1,"だい"],[17,1,"ねん"],[24,1,"つき"],[31,2,"しゅと"],[38,1,"とき"]],"text":"ハカリヤの子ネヘミヤの言葉。第二十年のキスレウの月に、わたしが首都スサにいた時、"},{"ref":"Neh.1.2","start":16001002,"end":16001002,"break":"none","ruby":[[4,2,"きょうだい"],[14,2,"すうにん"],[17,1,"もの"],[19,1,"とも"],[25,1,"き"],[34,2,"ほしゅう"],[37,1,"まぬか"],[40,1,"い"],[42,1,"のこ"],[48,1,"ひと"],[50,1,"こと"],[60,1,"こと"],[62,1,"たず"]],"text":"わたしの兄弟のひとりハナニが数人の者と共にユダから来たので、わたしは捕囚を免れて生き残ったユダヤ人の事およびエルサレムの事を尋ねた。"},{"ref":"Neh.1.3","start":16001003,"end":16001003,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[14,1,"しゅう"],[16,2,"ほしゅう"],[19,1,"まぬか"],[22,1,"い"],[24,1,"のこ"],[27,1,"もの"],[29,1,"おお"],[33,1,"なや"],[55,2,"じょうへき"],[65,1,"もん"],[67,1,"ひ"],[69,1,"や"]],"text":"彼らはわたしに言った、「かの州で捕囚を免れて生き残った者は大いなる悩みと、はずかしめのうちにあり、エルサレムの城壁はくずされ、その門は火で焼かれたままであります」と。"},{"ref":"Neh.1.4","start":16001004,"end":16001004,"break":"paragraph","ruby":[[8,2,"ことば"],[11,1,"き"],[14,1,"とき"],[20,1,"な"],[23,2,"すうじつ"],[29,1,"なげ"],[31,1,"かな"],[35,2,"だんじき"],[39,1,"てん"],[41,1,"かみ"],[43,1,"まえ"],[45,1,"いの"]],"text":"わたしはこれらの言葉を聞いた時、すわって泣き、数日のあいだ嘆き悲しみ、断食して天の神の前に祈って、"},{"ref":"Neh.1.5","start":16001005,"end":16001005,"break":"none","ruby":[[0,1,"い"],[5,1,"てん"],[7,1,"かみ"],[9,1,"しゅ"],[15,1,"あい"],[20,1,"いまし"],[23,1,"まも"],[25,1,"もの"],[28,2,"けいやく"],[31,1,"まも"],[40,1,"ほどこ"],[44,1,"おお"],[48,1,"おそ"],[52,1,"かみ"]],"text":"言った、「天の神、主、おのれを愛し、その戒めを守る者には契約を守り、いつくしみを施される大いなる恐るべき神よ、"},{"ref":"Neh.1.6","start":16001006,"end":16001006,"break":"none","ruby":[[3,1,"みみ"],[5,1,"かたむ"],[8,1,"め"],[10,1,"ひら"],[17,1,"いのり"],[19,1,"き"],[31,1,"いま"],[49,2,"しそん"],[56,1,"ひる"],[58,1,"よる"],[61,1,"まえ"],[63,1,"いの"],[76,2,"しそん"],[84,1,"たい"],[87,1,"おか"],[90,1,"つみ"],[114,1,"ちち"],[116,1,"いえ"],[118,1,"つみ"],[120,1,"おか"]],"text":"どうぞ耳を傾け、目を開いてしもべの祈を聞いてください。わたしは今、あなたのしもべであるイスラエルの子孫のために、昼も夜もみ前に祈り、われわれイスラエルの子孫が、あなたに対して犯した罪をざんげいたします。まことにわたしも、わたしの父の家も罪を犯しました。"},{"ref":"Neh.1.7","start":16001007,"end":16001007,"break":"none","ruby":[[9,1,"たい"],[12,1,"おお"],[15,1,"わる"],[17,1,"こと"],[19,1,"おこな"],[33,1,"めい"],[38,1,"いまし"],[43,1,"さだ"],[53,1,"まも"]],"text":"われわれはあなたに対して大いに悪い事を行い、あなたのしもべモーセに命じられた戒めをも、定めをも、おきてをも守りませんでした。"},{"ref":"Neh.1.8","start":16001008,"end":16001008,"break":"none","ruby":[[15,1,"めい"],[20,2,"ことば"],[24,1,"おも"],[26,1,"おこ"],[42,1,"い"],[58,1,"つみ"],[60,1,"おか"],[82,1,"たみ"],[84,1,"あいだ"],[86,1,"ち"]],"text":"どうぞ、あなたのしもべモーセに命じられた言葉を、思い起してください。すなわちあなたは言われました、『もしあなたがたが罪を犯すならば、わたしはあなたがたを、もろもろの民の間に散らす。"},{"ref":"Neh.1.9","start":16001009,"end":16001009,"break":"none","ruby":[[14,1,"た"],[16,1,"かえ"],[23,1,"いまし"],[26,1,"まも"],[33,1,"おこな"],[51,1,"ち"],[56,1,"もの"],[59,1,"てん"],[61,1,"はて"],[75,1,"かれ"],[78,1,"あつ"],[85,1,"な"],[87,1,"す"],[95,1,"えら"],[98,1,"ところ"],[100,1,"つ"],[103,1,"く"]],"text":"しかし、あなたがたがわたしに立ち返り、わたしの戒めを守って、これを行うならば、たといあなたがたのうちの散らされた者が、天の果にいても、わたしはそこから彼らを集め、わたしの名を住まわせるために選んだ所に連れて来る』と。"},{"ref":"Neh.1.10","start":16001010,"end":16001010,"break":"none","ruby":[[0,1,"かれ"],[8,1,"おお"],[12,1,"ちから"],[14,1,"つよ"],[16,1,"て"],[40,1,"たみ"]],"text":"彼らは、あなたが大いなる力と強い手をもって、あがなわれたあなたのしもべ、あなたの民です。"},{"ref":"Neh.1.11","start":16001011,"end":16001011,"break":"none","ruby":[[0,1,"しゅ"],[10,1,"いのり"],[17,1,"な"],[19,1,"おそ"],[25,1,"よろこ"],[36,1,"いのり"],[38,1,"みみ"],[40,1,"かたむ"],[60,1,"めぐ"],[65,1,"ひと"],[67,1,"め"],[69,1,"まえ"],[76,1,"え"],[88,1,"とき"],[94,1,"おう"],[96,2,"きゅうじ"],[98,1,"やく"]],"text":"主よ、どうぞしもべの祈と、あなたの名を恐れることを喜ぶあなたのしもべらの祈に耳を傾けてください。どうぞ、きょう、しもべを恵み、この人の目の前であわれみを得させてください」。この時、わたしは王の給仕役であった。"}]