[{"ref":"Deut.15.1","start":5015001,"end":5015001,"break":"paragraph","ruby":[[5,1,"ねん"],[7,1,"おわ"],[17,1,"おこな"]],"text":"あなたは七年の終りごとに、ゆるしを行わなければならない。"},{"ref":"Deut.15.2","start":5015002,"end":5015002,"break":"none","ruby":[[10,1,"つぎ"],[24,2,"りんじん"],[27,1,"か"],[30,2,"かしぬし"],[50,2,"りんじん"],[55,2,"きょうだい"],[61,2,"とくそく"],[71,1,"しゅ"],[80,1,"しめ"]],"text":"そのゆるしのしかたは次のとおりである。すべてその隣人に貸した貸主はそれをゆるさなければならない。その隣人または兄弟にそれを督促してはならない。主のゆるしが、ふれ示されたからである。"},{"ref":"Deut.15.3","start":5015003,"end":5015003,"break":"none","ruby":[[0,2,"がいこく"],[2,1,"じん"],[8,2,"とくそく"],[24,2,"きょうだい"],[27,1,"か"],[30,1,"もの"]],"text":"外国人にはそれを督促することができるが、あなたの兄弟に貸した物はゆるさなければならない。"},{"ref":"Deut.15.4","start":5015004,"end":5015004,"break":"none","ruby":[[12,1,"まず"],[15,1,"もの"],[31,1,"かみ"],[33,1,"しゅ"],[35,1,"し"],[36,1,"ぎょう"],[40,1,"あた"],[45,1,"ち"],[52,2,"しゅくふく"]],"text":"しかしあなたがたのうちに貧しい者はなくなるであろう。（あなたの神、主が嗣業として与えられる地で、あなたを祝福されるからである。）"},{"ref":"Deut.15.5","start":5015005,"end":5015005,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[11,2,"ことば"],[14,1,"き"],[16,1,"したが"],[33,1,"めい"],[39,1,"いまし"],[48,1,"まも"],[50,1,"おこな"]],"text":"ただ、あなたの神、主の言葉に聞き従って、わたしが、きょう、あなたに命じることの戒めを、ことごとく守り行うとき、そのようになるであろう。"},{"ref":"Deut.15.6","start":5015006,"end":5015006,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,2,"やくそく"],[20,2,"しゅくふく"],[32,1,"おお"],[35,1,"くに"],[39,1,"か"],[47,1,"か"],[66,1,"おお"],[69,1,"くに"],[73,1,"おさ"],[82,1,"かれ"],[89,1,"おさ"]],"text":"あなたの神、主が約束されたようにあなたを祝福されるから、あなたは多くの国びとに貸すようになり、借りることはないであろう。またあなたは多くの国びとを治めるようになり、彼らがあなたを治めることはないであろう。"},{"ref":"Deut.15.7","start":5015007,"end":5015007,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"たま"],[11,1,"ち"],[20,2,"きょうだい"],[23,1,"まず"],[26,1,"もの"],[34,1,"まち"],[36,1,"うち"],[46,1,"まず"],[49,2,"きょうだい"],[57,1,"こころ"],[74,1,"て"],[76,1,"と"]],"text":"あなたの神、主が賜わる地で、もしあなたの兄弟で貧しい者がひとりでも、町の内におるならば、その貧しい兄弟にむかって、心をかたくなにしてはならない。また手を閉じてはならない。"},{"ref":"Deut.15.8","start":5015008,"end":5015008,"break":"none","ruby":[[0,1,"かなら"],[2,1,"かれ"],[4,1,"て"],[6,1,"ひら"],[12,2,"ひつよう"],[17,1,"もの"],[19,1,"か"],[21,1,"あた"],[24,1,"とぼ"],[29,1,"おぎな"]],"text":"必ず彼に手を開いて、その必要とする物を貸し与え、乏しいのを補わなければならない。"},{"ref":"Deut.15.9","start":5015009,"end":5015009,"break":"none","ruby":[[4,1,"こころ"],[6,2,"じゃねん"],[9,1,"おこ"],[13,1,"だい"],[15,1,"ねん"],[21,1,"とし"],[23,1,"ちか"],[29,1,"い"],[33,1,"まず"],[36,2,"きょうだい"],[39,1,"たい"],[42,1,"もの"],[44,1,"お"],[49,1,"なに"],[51,1,"あた"],[63,1,"つつし"],[76,1,"ひと"],[82,1,"しゅ"],[84,1,"うった"],[95,1,"つみ"],[97,1,"え"]],"text":"あなたは心に邪念を起し、『第七年のゆるしの年が近づいた』と言って、貧しい兄弟に対し、物を惜しんで、何も与えないことのないように慎まなければならない。その人があなたを主に訴えるならば、あなたは罪を得るであろう。"},{"ref":"Deut.15.10","start":5015010,"end":5015010,"break":"none","ruby":[[4,1,"こころ"],[7,1,"かれ"],[9,1,"あた"],[20,1,"かれ"],[22,1,"あた"],[25,1,"とき"],[27,1,"お"],[41,1,"かみ"],[43,1,"しゅ"],[47,1,"こと"],[61,2,"じぎょう"],[65,1,"て"],[71,1,"はたら"],[77,2,"しゅくふく"]],"text":"あなたは心から彼に与えなければならない。彼に与える時は惜しんではならない。あなたの神、主はこの事のために、あなたをすべての事業と、手のすべての働きにおいて祝福されるからである。"},{"ref":"Deut.15.11","start":5015011,"end":5015011,"break":"none","ruby":[[0,1,"まず"],[3,1,"もの"],[10,1,"くに"],[15,1,"た"],[30,1,"めい"],[33,1,"い"],[41,1,"かなら"],[43,1,"くに"],[54,2,"きょうだい"],[57,1,"とぼ"],[60,1,"もの"],[63,1,"まず"],[66,1,"もの"],[70,1,"て"],[72,1,"ひら"]],"text":"貧しい者はいつまでも国のうちに絶えることがないから、わたしは命じて言う、『あなたは必ず国のうちにいるあなたの兄弟の乏しい者と、貧しい者とに、手を開かなければならない』。"},{"ref":"Deut.15.12","start":5015012,"end":5015012,"break":"paragraph","ruby":[[6,2,"きょうだい"],[15,1,"おとこ"],[24,1,"おんな"],[35,1,"う"],[43,1,"ねん"],[44,1,"つか"],[51,1,"だい"],[53,1,"ねん"],[56,1,"かれ"],[58,2,"じゆう"],[61,1,"あた"],[64,1,"さ"]],"text":"もしあなたの兄弟であるヘブルの男、またはヘブルの女が、あなたのところに売られてきて、六年仕えたならば、第七年には彼に自由を与えて去らせなければならない。"},{"ref":"Deut.15.13","start":5015013,"end":5015013,"break":"none","ruby":[[0,1,"かれ"],[2,2,"じゆう"],[5,1,"あた"],[8,1,"さ"],[12,1,"とき"],[17,1,"て"],[19,1,"さ"]],"text":"彼に自由を与えて去らせる時は、から手で去らせてはならない。"},{"ref":"Deut.15.14","start":5015014,"end":5015014,"break":"none","ruby":[[0,1,"む"],[4,1,"う"],[6,1,"ば"],[9,1,"さか"],[17,1,"と"],[21,1,"お"],[26,1,"かれ"],[28,1,"あた"],[47,1,"かみ"],[49,1,"しゅ"],[55,1,"めぐ"],[63,1,"かれ"],[65,1,"あた"]],"text":"群れと、打ち場と、酒ぶねのうちから取って、惜しみなく彼に与えなければならない。すなわちあなたの神、主があなたを恵まれたように、彼に与えなければならない。"},{"ref":"Deut.15.15","start":5015015,"end":5015015,"break":"none","ruby":[[12,1,"くに"],[14,2,"どれい"],[26,1,"かみ"],[28,1,"しゅ"],[38,1,"だ"],[42,1,"こと"],[44,2,"きおく"],[72,1,"こと"],[74,1,"めい"]],"text":"あなたはかつてエジプトの国で奴隷であったが、あなたの神、主があなたをあがない出された事を記憶しなければならない。このゆえにわたしは、きょう、この事を命じる。"},{"ref":"Deut.15.16","start":5015016,"end":5015016,"break":"none","ruby":[[5,1,"ひと"],[16,2,"かぞく"],[19,1,"あい"],[26,2,"いっしょ"],[34,1,"のぞ"],[46,1,"はな"],[49,1,"さ"],[60,1,"い"]],"text":"しかしその人があなたと、あなたの家族を愛し、あなたと一緒にいることを望み、『わたしはあなたを離れて去りたくありません』と言うならば、"},{"ref":"Deut.15.17","start":5015017,"end":5015017,"break":"none","ruby":[[8,1,"と"],[11,1,"かれ"],[13,1,"みみ"],[15,1,"と"],[17,1,"さ"],[34,1,"かれ"],[45,2,"どれい"],[55,1,"おんな"],[56,2,"どれい"]],"text":"あなたは、きりを取って彼の耳を戸に刺さなければならない。そうすれば、彼はいつまでもあなたの奴隷となるであろう。女奴隷にもそうしなければならない。"},{"ref":"Deut.15.18","start":5015018,"end":5015018,"break":"none","ruby":[[0,1,"かれ"],[2,2,"じゆう"],[5,1,"あた"],[8,1,"さ"],[12,1,"とき"],[16,1,"こころよ"],[18,1,"さ"],[30,1,"かれ"],[33,2,"ねんかん"],[36,2,"ちんぎん"],[39,1,"と"],[41,2,"やといにん"],[45,1,"ばい"],[50,1,"つか"],[53,1,"はたら"],[78,1,"かみ"],[80,1,"しゅ"],[86,1,"おこな"],[92,1,"こと"],[98,2,"しゅくふく"]],"text":"彼に自由を与えて去らせる時には、快く去らせなければならない。彼が六年間、賃銀を取る雇人の二倍あなたに仕えて働いたからである。あなたがそうするならば、あなたの神、主はあなたが行うすべての事にあなたを祝福されるであろう。"},{"ref":"Deut.15.19","start":5015019,"end":5015019,"break":"paragraph","ruby":[[0,1,"うし"],[2,1,"ひつじ"],[4,1,"う"],[6,1,"おす"],[12,1,"みな"],[17,1,"かみ"],[19,1,"しゅ"],[21,2,"せいべつ"],[33,1,"うし"],[39,1,"もち"],[45,2,"しごと"],[59,1,"ひつじ"],[65,1,"け"],[67,1,"き"]],"text":"牛、羊の産む雄のういごは皆あなたの神、主に聖別しなければならない。牛のういごを用いてなんの仕事をもしてはならない。また羊のういごの毛を切ってはならない。"},{"ref":"Deut.15.20","start":5015020,"end":5015020,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"えら"],[12,1,"ところ"],[15,1,"しゅ"],[17,1,"まえ"],[23,2,"かぞく"],[26,1,"とも"],[28,1,"とし"],[35,1,"た"]],"text":"あなたの神、主が選ばれる所で、主の前にあなたは家族と共に年ごとにそれを食べなければならない。"},{"ref":"Deut.15.21","start":5015021,"end":5015021,"break":"none","ruby":[[6,1,"けもの"],[10,1,"きず"],[21,1,"あし"],[37,1,"わる"],[39,1,"きず"],[48,1,"とき"],[55,1,"かみ"],[57,1,"しゅ"],[62,2,"ぎせい"]],"text":"しかし、その獣がもし傷のあるもの、すなわち足なえまたは、めくらなど、すべて悪い傷のあるものである時は、あなたの神、主にそれを犠牲としてささげてはならない。"},{"ref":"Deut.15.22","start":5015022,"end":5015022,"break":"none","ruby":[[0,1,"まち"],[2,1,"うち"],[7,1,"た"],[18,1,"けが"],[21,1,"ひと"],[24,1,"きよ"],[26,1,"ひと"],[35,1,"お"],[39,2,"どうよう"],[45,1,"た"]],"text":"町の内でそれを食べなければならない。汚れた人も、清い人も、かもしかや、雄じかと同様にそれを食べることができる。"},{"ref":"Deut.15.23","start":5015023,"end":5015023,"break":"none","ruby":[[6,1,"ち"],[8,1,"た"],[17,1,"みず"],[25,1,"ち"]],"text":"ただし、その血は食べてはならない。水のようにそれを地にそそがなければならない。"}]