[{"ref":"Mark.13.1","start":41013001,"end":41013001,"break":"paragraph","ruby":[[4,1,"みや"],[7,1,"で"],[9,1,"い"],[16,2,"でし"],[23,1,"い"],[28,2,"せんせい"],[43,2,"みごと"],[46,1,"いし"],[53,2,"りっぱ"],[56,2,"たてもの"]],"text":"イエスが宮から出て行かれるとき、弟子のひとりが言った、「先生、ごらんなさい。なんという見事な石、なんという立派な建物でしょう」。"},{"ref":"Mark.13.2","start":41013002,"end":41013002,"break":"none","ruby":[[4,1,"い"],[19,1,"おお"],[22,2,"たてもの"],[36,1,"いし"],[51,1,"た"],[53,1,"いし"],[55,1,"うえ"],[57,1,"のこ"]],"text":"イエスは言われた、「あなたは、これらの大きな建物をながめているのか。その石一つでもくずされないままで、他の石の上に残ることもなくなるであろう」。"},{"ref":"Mark.13.3","start":41013003,"end":41013003,"break":"paragraph","ruby":[[5,1,"やま"],[8,1,"みや"],[47,1,"たず"]],"text":"またオリブ山で、宮にむかってすわっておられると、ペテロ、ヤコブ、ヨハネ、アンデレが、ひそかにお尋ねした。"},{"ref":"Mark.13.4","start":41013004,"end":41013004,"break":"none","ruby":[[8,1,"はな"],[24,1,"おこ"],[46,2,"じょうじゅ"],[53,2,"ばあい"],[61,2,"ぜんちょう"]],"text":"「わたしたちにお話しください。いつ、そんなことが起るのでしょうか。またそんなことがことごとく成就するような場合には、どんな前兆がありますか」。"},{"ref":"Mark.13.5","start":41013005,"end":41013005,"break":"none","ruby":[[8,1,"はな"],[18,1,"ひと"],[20,1,"まど"],[29,1,"き"]],"text":"そこで、イエスは話しはじめられた、「人に惑わされないように気をつけなさい。"},{"ref":"Mark.13.6","start":41013006,"end":41013006,"break":"none","ruby":[[0,1,"おお"],[3,1,"もの"],[9,1,"な"],[11,1,"な"],[15,1,"あらわ"],[18,2,"じぶん"],[25,1,"い"],[29,1,"おお"],[32,1,"ひと"],[34,1,"まど"]],"text":"多くの者がわたしの名を名のって現れ、自分がそれだと言って、多くの人を惑わすであろう。"},{"ref":"Mark.13.7","start":41013007,"end":41013007,"break":"none","ruby":[[3,2,"せんそう"],[6,2,"せんそう"],[14,1,"き"],[30,1,"おこ"],[42,1,"おわ"]],"text":"また、戦争と戦争のうわさとを聞くときにも、あわてるな。それは起らねばならないが、まだ終りではない。"},{"ref":"Mark.13.8","start":41013008,"end":41013008,"break":"none","ruby":[[0,1,"たみ"],[2,1,"たみ"],[5,1,"くに"],[7,1,"くに"],[9,2,"てきたい"],[13,1,"た"],[15,1,"あ"],[30,2,"じしん"],[42,1,"おこ"],[53,1,"う"],[56,1,"くる"],[60,1,"はじ"]],"text":"民は民に、国は国に敵対して立ち上がるであろう。またあちこちに地震があり、またききんが起るであろう。これらは産みの苦しみの初めである。"},{"ref":"Mark.13.9","start":41013009,"end":41013009,"break":"paragraph","ruby":[[6,2,"じぶん"],[9,1,"き"],[34,3,"しゅうぎしょ"],[38,1,"ひ"],[45,2,"かいどう"],[48,1,"う"],[52,2,"ちょうかん"],[57,1,"おう"],[61,1,"まえ"],[63,1,"た"],[68,1,"かれ"],[71,1,"たい"]],"text":"あなたがたは自分で気をつけていなさい。あなたがたは、わたしのために、衆議所に引きわたされ、会堂で打たれ、長官たちや王たちの前に立たされ、彼らに対してあかしをさせられるであろう。"},{"ref":"Mark.13.10","start":41013010,"end":41013010,"break":"none","ruby":[[5,2,"ふくいん"],[14,1,"たみ"],[16,1,"の"],[18,1,"つた"]],"text":"こうして、福音はまずすべての民に宣べ伝えられねばならない。"},{"ref":"Mark.13.11","start":41013011,"end":41013011,"break":"none","ruby":[[4,2,"ひとびと"],[13,1,"つ"],[16,1,"い"],[19,1,"ひ"],[27,1,"なに"],[29,1,"い"],[35,1,"まえ"],[39,2,"しんぱい"],[47,2,"ばあい"],[50,2,"じぶん"],[53,1,"しめ"],[60,1,"かた"],[66,1,"かた"],[68,1,"もの"],[75,2,"じしん"],[83,2,"せいれい"]],"text":"そして、人々があなたがたを連れて行って引きわたすとき、何を言おうかと、前もって心配するな。その場合、自分に示されることを語るがよい。語る者はあなたがた自身ではなくて、聖霊である。"},{"ref":"Mark.13.12","start":41013012,"end":41013012,"break":"none","ruby":[[2,2,"きょうだい"],[5,2,"きょうだい"],[9,1,"ちち"],[11,1,"こ"],[13,1,"ころ"],[18,1,"わた"],[21,1,"こ"],[23,2,"りょうしん"],[26,1,"さか"],[30,1,"た"],[33,1,"かれ"],[36,1,"ころ"]],"text":"また兄弟は兄弟を、父は子を殺すために渡し、子は両親に逆らって立ち、彼らを殺させるであろう。"},{"ref":"Mark.13.13","start":41013013,"end":41013013,"break":"none","ruby":[[13,1,"な"],[23,1,"ひと"],[25,1,"にく"],[38,2,"さいご"],[42,1,"た"],[44,1,"しの"],[46,1,"もの"],[48,1,"すく"]],"text":"また、あなたがたはわたしの名のゆえに、すべての人に憎まれるであろう。しかし、最後まで耐え忍ぶ者は救われる。"},{"ref":"Mark.13.14","start":41013014,"end":41013014,"break":"paragraph","ruby":[[0,1,"あ"],[3,1,"にく"],[11,1,"た"],[18,1,"ところ"],[20,1,"た"],[24,1,"み"],[30,2,"どくしゃ"],[34,1,"さと"],[49,2,"ひとびと"],[52,1,"やま"],[54,1,"に"]],"text":"荒らす憎むべきものが、立ってはならぬ所に立つのを見たならば（読者よ、悟れ）、そのとき、ユダヤにいる人々は山へ逃げよ。"},{"ref":"Mark.13.15","start":41013015,"end":41013015,"break":"none","ruby":[[0,2,"おくじょう"],[5,1,"もの"],[8,1,"した"],[17,1,"いえ"],[20,1,"もの"],[22,1,"と"],[24,1,"だ"],[30,1,"うち"]],"text":"屋上にいる者は、下におりるな。また家から物を取り出そうとして内にはいるな。"},{"ref":"Mark.13.16","start":41013016,"end":41013016,"break":"none","ruby":[[0,1,"はたけ"],[4,1,"もの"],[7,2,"うわぎ"],[10,1,"と"]],"text":"畑にいる者は、上着を取りにあとへもどるな。"},{"ref":"Mark.13.17","start":41013017,"end":41013017,"break":"none","ruby":[[2,1,"ひ"],[6,2,"みおも"],[9,1,"おんな"],[11,2,"ちの"],[14,1,"ご"],[18,1,"おんな"],[22,2,"ふこう"]],"text":"その日には、身重の女と乳飲み子をもつ女とは、不幸である。"},{"ref":"Mark.13.18","start":41013018,"end":41013018,"break":"none","ruby":[[2,1,"こと"],[4,1,"ふゆ"],[12,1,"いの"]],"text":"この事が冬おこらぬように祈れ。"},{"ref":"Mark.13.19","start":41013019,"end":41013019,"break":"none","ruby":[[2,1,"ひ"],[6,1,"かみ"],[8,2,"ばんぶつ"],[11,1,"つく"],[15,2,"そうぞう"],[18,1,"はじ"],[22,2,"げんざい"],[25,1,"いた"],[35,2,"こんご"],[43,2,"かんなん"],[46,1,"おこ"]],"text":"その日には、神が万物を造られた創造の初めから現在に至るまで、かつてなく今後もないような患難が起るからである。"},{"ref":"Mark.13.20","start":41013020,"end":41013020,"break":"none","ruby":[[2,1,"しゅ"],[6,2,"きかん"],[9,1,"ちぢ"],[21,1,"すく"],[25,1,"もの"],[42,1,"えら"],[46,2,"せんみん"],[55,2,"きかん"],[58,1,"ちぢ"]],"text":"もし主がその期間を縮めてくださらないなら、救われる者はひとりもないであろう。しかし、選ばれた選民のために、その期間を縮めてくださったのである。"},{"ref":"Mark.13.21","start":41013021,"end":41013021,"break":"none","ruby":[[16,1,"み"],[32,1,"み"],[43,1,"い"],[51,1,"しん"]],"text":"そのとき、だれかがあなたがたに『見よ、ここにキリストがいる』、『見よ、あそこにいる』と言っても、それを信じるな。"},{"ref":"Mark.13.22","start":41013022,"end":41013022,"break":"none","ruby":[[12,3,"よげんしゃ"],[18,1,"おこ"],[26,2,"きせき"],[30,1,"おこな"],[38,2,"せんみん"],[42,1,"まど"]],"text":"にせキリストたちや、にせ預言者たちが起って、しるしと奇跡とを行い、できれば、選民をも惑わそうとするであろう。"},{"ref":"Mark.13.23","start":41013023,"end":41013023,"break":"none","ruby":[[4,1,"き"],[19,1,"こと"],[28,1,"まえ"],[32,1,"い"]],"text":"だから、気をつけていなさい。いっさいの事を、あなたがたに前もって言っておく。"},{"ref":"Mark.13.24","start":41013024,"end":41013024,"break":"paragraph","ruby":[[2,1,"ひ"],[8,2,"かんなん"],[11,1,"のち"],[13,1,"ひ"],[15,1,"くら"],[20,1,"つき"],[24,1,"ひかり"],[26,1,"はな"]],"text":"その日には、この患難の後、日は暗くなり、月はその光を放つことをやめ、"},{"ref":"Mark.13.25","start":41013025,"end":41013025,"break":"none","ruby":[[0,1,"ほし"],[2,1,"そら"],[5,1,"お"],[8,2,"てんたい"],[11,1,"ゆ"],[13,1,"うご"]],"text":"星は空から落ち、天体は揺り動かされるであろう。"},{"ref":"Mark.13.26","start":41013026,"end":41013026,"break":"none","ruby":[[5,1,"おお"],[9,1,"ちから"],[11,2,"えいこう"],[19,1,"ひと"],[21,1,"こ"],[23,1,"くも"],[25,1,"の"],[28,1,"く"],[33,2,"ひとびと"],[36,1,"み"]],"text":"そのとき、大いなる力と栄光とをもって、人の子が雲に乗って来るのを、人々は見るであろう。"},{"ref":"Mark.13.27","start":41013027,"end":41013027,"break":"none","ruby":[[5,1,"かれ"],[7,2,"みつかい"],[18,1,"ち"],[24,1,"てん"],[31,2,"しほう"],[37,2,"せんみん"],[40,1,"よ"],[42,1,"あつ"]],"text":"そのとき、彼は御使たちをつかわして、地のはてから天のはてまで、四方からその選民を呼び集めるであろう。"},{"ref":"Mark.13.28","start":41013028,"end":41013028,"break":"paragraph","ruby":[[5,1,"き"],[10,1,"たとえ"],[12,1,"まな"],[20,1,"えだ"],[22,1,"やわ"],[29,1,"は"],[31,1,"で"],[40,1,"なつ"],[42,1,"ちか"]],"text":"いちじくの木からこの譬を学びなさい。その枝が柔らかになり、葉が出るようになると、夏の近いことがわかる。"},{"ref":"Mark.13.29","start":41013029,"end":41013029,"break":"none","ruby":[[10,1,"こと"],[12,1,"おこ"],[16,1,"み"],[22,1,"ひと"],[24,1,"こ"],[26,2,"とぐち"],[30,1,"ちか"],[37,1,"し"]],"text":"そのように、これらの事が起るのを見たならば、人の子が戸口まで近づいていると知りなさい。"},{"ref":"Mark.13.30","start":41013030,"end":41013030,"break":"none","ruby":[[2,1,"き"],[15,1,"こと"],[23,1,"おこ"],[31,2,"じだい"],[34,1,"ほろ"]],"text":"よく聞いておきなさい。これらの事が、ことごとく起るまでは、この時代は滅びることがない。"},{"ref":"Mark.13.31","start":41013031,"end":41013031,"break":"none","ruby":[[0,2,"てんち"],[3,1,"ほろ"],[18,2,"ことば"],[21,1,"ほろ"]],"text":"天地は滅びるであろう。しかしわたしの言葉は滅びることがない。"},{"ref":"Mark.13.32","start":41013032,"end":41013032,"break":"none","ruby":[[2,1,"ひ"],[6,1,"とき"],[12,1,"し"],[17,1,"てん"],[21,2,"みつかい"],[29,1,"こ"],[31,1,"し"],[38,1,"ちち"],[42,1,"し"]],"text":"その日、その時は、だれも知らない。天にいる御使たちも、また子も知らない、ただ父だけが知っておられる。"},{"ref":"Mark.13.33","start":41013033,"end":41013033,"break":"none","ruby":[[0,1,"き"],[6,1,"め"],[19,1,"とき"]],"text":"気をつけて、目をさましていなさい。その時がいつであるか、あなたがたにはわからないからである。"},{"ref":"Mark.13.34","start":41013034,"end":41013034,"break":"none","ruby":[[8,1,"たび"],[10,1,"た"],[12,1,"ひと"],[14,1,"いえ"],[16,1,"で"],[19,1,"あた"],[24,1,"しもべ"],[33,2,"しごと"],[36,1,"わ"],[38,1,"あ"],[41,2,"せきにん"],[48,2,"もんばん"],[52,1,"め"],[62,1,"めい"]],"text":"それはちょうど、旅に立つ人が家を出るに当り、その僕たちに、それぞれ仕事を割り当てて責任をもたせ、門番には目をさましておれと、命じるようなものである。"},{"ref":"Mark.13.35","start":41013035,"end":41013035,"break":"none","ruby":[[4,1,"め"],[18,1,"いえ"],[20,2,"しゅじん"],[23,1,"かえ"],[26,1,"く"],[31,2,"ゆうがた"],[35,2,"よなか"],[44,1,"な"],[50,1,"あ"],[52,1,"がた"]],"text":"だから、目をさましていなさい。いつ、家の主人が帰って来るのか、夕方か、夜中か、にわとりの鳴くころか、明け方か、わからないからである。"},{"ref":"Mark.13.36","start":41013036,"end":41013036,"break":"none","ruby":[[4,1,"きゅう"],[6,1,"かえ"],[18,1,"ねむ"],[27,1,"み"],[33,1,"し"]],"text":"あるいは急に帰ってきて、あなたがたの眠っているところを見つけるかも知れない。"},{"ref":"Mark.13.37","start":41013037,"end":41013037,"break":"none","ruby":[[0,1,"め"],[21,1,"い"],[25,2,"ことば"],[33,2,"ひとびと"],[36,1,"い"]],"text":"目をさましていなさい。わたしがあなたがたに言うこの言葉は、すべての人々に言うのである」。"}]