[{"ref":"Isa.1.1","start":23001001,"end":23001001,"break":"paragraph","ruby":[[4,1,"こ"],[12,1,"おう"],[30,1,"よ"],[44,1,"み"],[46,1,"まぼろし"]],"text":"アモツの子イザヤがユダの王ウジヤ、ヨタム、アハズ、ヒゼキヤの世にユダとエルサレムについて見た幻。"},{"ref":"Isa.1.2","start":23001002,"end":23001002,"break":"stanza","breaks":[[15,"line"],[29,"line"],[42,"line"]],"ruby":[[0,1,"てん"],[3,1,"き"],[6,1,"ち"],[9,1,"みみ"],[11,1,"かたむ"],[15,1,"しゅ"],[17,1,"つぎ"],[22,1,"かた"],[34,1,"こ"],[36,1,"やしな"],[38,1,"そだ"],[45,1,"かれ"]],"text":"天よ、聞け、地よ、耳を傾けよ、主が次のように語られたから、「わたしは子を養い育てた、しかし彼らはわたしにそむいた。"},{"ref":"Isa.1.3","start":23001003,"end":23001003,"break":"line","breaks":[[10,"line"],[27,"line"],[40,"line"]],"ruby":[[0,1,"うし"],[4,2,"かいぬし"],[7,1,"し"],[15,2,"しゅじん"],[24,1,"し"],[36,1,"し"],[42,1,"たみ"],[44,1,"さと"]],"text":"牛はその飼主を知り、ろばはその主人のまぐさおけを知る。しかしイスラエルは知らず、わが民は悟らない」。"},{"ref":"Isa.1.4","start":23001004,"end":23001004,"break":"line","breaks":[[17,"line"],[34,"line"],[42,"line"],[56,"line"]],"ruby":[[3,2,"つみぶか"],[6,1,"くに"],[10,2,"ふぎ"],[13,1,"お"],[15,1,"たみ"],[17,1,"あく"],[21,1,"もの"],[26,2,"だらく"],[30,1,"こ"],[34,1,"かれ"],[37,1,"しゅ"],[39,1,"す"],[48,2,"せいじゃ"],[63,1,"とお"]],"text":"ああ、罪深い国びと、不義を負う民、悪をなす者のすえ、堕落せる子らよ。彼らは主を捨て、イスラエルの聖者をあなどり、これをうとんじ遠ざかった。"},{"ref":"Isa.1.5","start":23001005,"end":23001005,"break":"line","breaks":[[20,"line"],[34,"line"],[46,"line"]],"ruby":[[11,1,"かさ"],[13,1,"がさ"],[23,1,"う"],[36,1,"あたま"],[43,1,"や"],[48,1,"こころ"],[50,1,"まった"],[52,1,"よわ"]],"text":"あなたがたは、どうして重ね重ねそむいて、なおも打たれようとするのか。その頭はことごとく病み、その心は全く弱りはてている。"},{"ref":"Isa.1.6","start":23001006,"end":23001006,"break":"line","breaks":[[10,"line"],[20,"line"],[33,"line"],[52,"line"]],"ruby":[[0,1,"あし"],[6,1,"あたま"],[10,2,"かんぜん"],[20,1,"きず"],[22,1,"う"],[24,1,"きず"],[26,2,"なまきず"],[36,1,"しぼ"],[38,1,"だ"],[45,1,"つつ"],[52,1,"あぶら"]],"text":"足のうらから頭まで、完全なところがなく、傷と打ち傷と生傷ばかりだ。これを絞り出すものなく、包むものなく、油をもってやわらげるものもない。"},{"ref":"Isa.1.7","start":23001007,"end":23001007,"break":"line","breaks":[[14,"line"],[23,"line"],[45,"line"]],"ruby":[[6,1,"くに"],[8,1,"あ"],[14,2,"まちまち"],[17,1,"ひ"],[19,1,"や"],[23,2,"たはた"],[35,1,"まえ"],[37,2,"がいこく"],[39,1,"じん"],[41,1,"く"],[45,1,"ほろ"],[57,1,"あ"]],"text":"あなたがたの国は荒れすたれ、町々は火で焼かれ、田畑のものはあなたがたの前で外国人に食われ、滅ぼされたソドムのように荒れすたれた。"},{"ref":"Isa.1.8","start":23001008,"end":23001008,"break":"line","breaks":[[19,"line"],[33,"line"]],"ruby":[[4,1,"むすめ"],[9,1,"はたけ"],[11,1,"かり"],[12,2,"こや"],[23,1,"はたけ"],[25,3,"ばんごや"],[33,2,"ほうい"],[38,1,"まち"],[49,1,"のこ"]],"text":"シオンの娘はぶどう畑の仮小屋のように、きゅうり畑の番小屋のように、包囲された町のように、ただひとり残った。"},{"ref":"Isa.1.9","start":23001009,"end":23001009,"break":"line","breaks":[[8,"line"],[30,"line"],[45,"line"]],"ruby":[[2,2,"ばんぐん"],[5,1,"しゅ"],[13,1,"すこ"],[16,3,"せいぞんしゃ"],[20,1,"のこ"],[51,1,"おな"]],"text":"もし万軍の主が、われわれに少しの生存者を残されなかったなら、われわれはソドムのようになり、またゴモラと同じようになったであろう。"},{"ref":"Isa.1.10","start":23001010,"end":23001010,"break":"paragraph","breaks":[[16,"line"],[24,"line"],[36,"line"]],"ruby":[[16,1,"しゅ"],[18,2,"ことば"],[21,1,"き"],[33,1,"たみ"],[41,1,"かみ"],[43,1,"おしえ"],[45,1,"みみ"],[47,1,"かたむ"]],"text":"あなたがたソドムのつかさたちよ、主の言葉を聞け。あなたがたゴモラの民よ、われわれの神の教に耳を傾けよ。"},{"ref":"Isa.1.11","start":23001011,"end":23001011,"break":"line","breaks":[[7,"line"],[25,"line"],[38,"line"],[49,"line"],[64,"line"],[77,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[18,1,"おお"],[21,2,"ぎせい"],[32,1,"えき"],[42,2,"おひつじ"],[45,2,"はんさい"],[49,1,"こ"],[52,1,"けもの"],[54,2,"しぼう"],[58,1,"あ"],[68,2,"おうし"],[74,2,"こひつじ"],[81,1,"お"],[85,1,"ち"],[87,1,"よろこ"]],"text":"主は言われる、「あなたがたがささげる多くの犠牲は、わたしになんの益があるか。わたしは雄羊の燔祭と、肥えた獣の脂肪とに飽いている。わたしは雄牛あるいは小羊、あるいは雄やぎの血を喜ばない。"},{"ref":"Isa.1.12","start":23001012,"end":23001012,"break":"line","breaks":[[23,"line"]],"ruby":[[19,1,"く"],[31,1,"にわ"],[33,1,"ふ"],[35,1,"あら"],[40,1,"もと"]],"text":"あなたがたは、わたしにまみえようとして来るが、だれが、わたしの庭を踏み荒すことを求めたか。"},{"ref":"Isa.1.13","start":23001013,"end":23001013,"break":"line","breaks":[[11,"line"],[30,"line"],[47,"line"],[68,"line"]],"ruby":[[15,1,"そな"],[17,1,"もの"],[19,1,"たずさ"],[30,2,"くんこう"],[38,1,"い"],[47,2,"しんげつ"],[50,3,"あんそくにち"],[56,2,"かいしゅう"],[59,1,"よ"],[61,1,"あつ"],[72,2,"ふぎ"],[75,1,"せい"],[76,1,"かい"],[79,1,"た"]],"text":"あなたがたは、もはや、むなしい供え物を携えてきてはならない。薫香は、わたしの忌みきらうものだ。新月、安息日、また会衆を呼び集めること――わたしは不義と聖会とに耐えられない。"},{"ref":"Isa.1.14","start":23001014,"end":23001014,"break":"line","breaks":[[16,"line"],[25,"line"],[38,"line"]],"ruby":[[6,2,"しんげつ"],[9,1,"さだ"],[12,1,"まつり"],[18,1,"たましい"],[20,1,"にく"],[32,2,"おもに"],[46,1,"お"],[50,1,"つか"]],"text":"あなたがたの新月と定めの祭とは、わが魂の憎むもの、それはわたしの重荷となり、わたしは、それを負うのに疲れた。"},{"ref":"Isa.1.15","start":23001015,"end":23001015,"break":"line","breaks":[[14,"line"],[35,"line"],[58,"line"]],"ruby":[[6,1,"て"],[8,1,"の"],[18,1,"め"],[31,1,"み"],[38,1,"おお"],[41,1,"いのり"],[53,1,"き"],[64,1,"て"],[66,1,"ち"]],"text":"あなたがたが手を伸べるとき、わたしは目をおおって、あなたがたを見ない。たとい多くの祈をささげても、わたしは聞かない。あなたがたの手は血まみれである。"},{"ref":"Isa.1.16","start":23001016,"end":23001016,"break":"line","breaks":[[17,"line"],[40,"line"]],"ruby":[[6,1,"み"],[8,1,"あら"],[12,1,"きよ"],[21,1,"め"],[23,1,"まえ"],[32,1,"わる"],[34,1,"おこな"],[37,1,"のぞ"],[40,1,"あく"],[42,1,"おこな"]],"text":"あなたがたは身を洗って、清くなり、わたしの目の前からあなたがたの悪い行いを除き、悪を行うことをやめ、"},{"ref":"Isa.1.17","start":23001017,"end":23001017,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[0,1,"ぜん"],[2,1,"おこな"],[11,2,"こうへい"],[14,1,"もと"],[22,1,"もの"],[24,1,"いまし"],[32,1,"ただ"],[35,1,"まも"],[38,2,"かふ"],[41,1,"うった"],[44,2,"べんご"]],"text":"善を行うことをならい、公平を求め、しえたげる者を戒め、みなしごを正しく守り、寡婦の訴えを弁護せよ。"},{"ref":"Isa.1.18","start":23001018,"end":23001018,"break":"paragraph","breaks":[[7,"line"],[22,"line"],[43,"line"],[55,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[15,1,"たがい"],[17,1,"ろん"],[31,1,"つみ"],[33,1,"ひ"],[43,1,"ゆき"],[48,1,"しろ"],[55,1,"くれない"],[60,1,"あか"],[65,1,"ひつじ"],[67,1,"け"]],"text":"主は言われる、さあ、われわれは互に論じよう。たといあなたがたの罪は緋のようであっても、雪のように白くなるのだ。紅のように赤くても、羊の毛のようになるのだ。"},{"ref":"Isa.1.19","start":23001019,"end":23001019,"break":"line","breaks":[[16,"line"]],"ruby":[[9,1,"こころよ"],[11,1,"したが"],[16,1,"ち"],[18,1,"よ"],[20,1,"もの"],[22,1,"た"]],"text":"もし、あなたがたが快く従うなら、地の良き物を食べることができる。"},{"ref":"Isa.1.20","start":23001020,"end":23001020,"break":"line","breaks":[[19,"line"],[30,"line"]],"ruby":[[10,1,"こば"],[23,1,"ほろ"],[33,1,"しゅ"],[37,1,"くち"],[39,1,"かた"]],"text":"しかし、あなたがたが拒みそむくならば、つるぎで滅ぼされる」。これは主がその口で語られたことである。"},{"ref":"Isa.1.21","start":23001021,"end":23001021,"break":"paragraph","breaks":[[12,"line"],[25,"line"],[33,"line"],[50,"line"]],"ruby":[[4,2,"ちゅうしん"],[10,1,"まち"],[16,2,"ゆうじょ"],[25,1,"むかし"],[27,2,"こうへい"],[30,1,"み"],[33,2,"せいぎ"],[50,1,"いま"],[52,1,"ひと"],[54,1,"ころ"],[56,1,"もの"]],"text":"かつては忠信であった町、どうして遊女となったのか。昔は公平で満ち、正義がそのうちにやどっていたのに、今は人を殺す者ばかりとなってしまった。"},{"ref":"Isa.1.22","start":23001022,"end":23001022,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"ぎん"],[19,1,"しゅ"],[21,1,"みず"]],"text":"あなたの銀はかすとなり、あなたのぶどう酒は水をまじえ、"},{"ref":"Isa.1.23","start":23001023,"end":23001023,"break":"line","breaks":[[15,"line"],[25,"line"],[45,"line"],[57,"line"]],"ruby":[[15,1,"ぬす"],[19,2,"なかま"],[33,1,"この"],[36,1,"おく"],[38,1,"もの"],[40,1,"お"],[42,1,"もと"],[50,1,"ただ"],[53,1,"まも"],[57,2,"かふ"],[60,1,"うった"],[63,1,"かれ"],[66,1,"とど"]],"text":"あなたのつかさたちはそむいて、盗びとの仲間となり、みな、まいないを好み、贈り物を追い求め、みなしごを正しく守らず、寡婦の訴えは彼らに届かない。"},{"ref":"Isa.1.24","start":23001024,"end":23001024,"break":"paragraph","breaks":[[13,"line"],[28,"line"],[51,"line"]],"ruby":[[6,1,"しゅ"],[8,2,"ばんぐん"],[11,1,"しゅ"],[19,3,"ぜんのうしゃ"],[23,1,"い"],[38,1,"てき"],[44,1,"いきどお"],[60,1,"うら"]],"text":"このゆえに、主、万軍の主、イスラエルの全能者は言われる、「ああ、わたしはわが敵にむかって憤りをもらし、わがあだにむかって恨みをはらす。"},{"ref":"Isa.1.25","start":23001025,"end":23001025,"break":"line","breaks":[[18,"line"],[40,"line"]],"ruby":[[9,1,"て"],[15,1,"む"],[25,2,"あく"],[28,1,"と"],[34,1,"と"],[37,1,"さ"],[44,1,"ま"],[47,1,"もの"],[52,1,"と"],[54,1,"のぞ"]],"text":"わたしはまた、わが手をあなたに向け、あなたのかすを灰汁で溶かすように溶かし去り、あなたの混ざり物をすべて取り除く。"},{"ref":"Isa.1.26","start":23001026,"end":23001026,"break":"line","breaks":[[23,"line"],[42,"line"],[54,"line"]],"ruby":[[27,1,"ぎ"],[28,1,"かん"],[30,1,"はじ"],[37,2,"かいふく"],[44,1,"のち"],[49,2,"せいぎ"],[52,1,"みやこ"],[54,2,"ちゅうしん"],[57,1,"まち"]],"text":"こうして、あなたのさばきびとをもとのとおりに、あなたの議官を初めのとおりに回復する。その後あなたは正義の都、忠信の町ととなえられる」。"},{"ref":"Isa.1.27","start":23001027,"end":23001027,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[4,2,"こうへい"],[21,1,"く"],[23,1,"あらた"],[26,1,"もの"],[29,2,"せいぎ"]],"text":"シオンは公平をもってあがなわれ、そのうちの悔い改める者は、正義をもってあがなわれる。"},{"ref":"Isa.1.28","start":23001028,"end":23001028,"break":"line","breaks":[[21,"line"]],"ruby":[[7,1,"もの"],[9,1,"つみ"],[14,1,"とも"],[16,1,"ほろ"],[21,1,"しゅ"],[23,1,"す"],[26,1,"もの"],[28,1,"ほろ"]],"text":"しかし、そむく者と罪びととは共に滅ぼされ、主を捨てる者は滅びうせる。"},{"ref":"Isa.1.29","start":23001029,"end":23001029,"break":"line","breaks":[[23,"line"],[32,"line"]],"ruby":[[11,1,"よろこ"],[17,1,"き"],[29,1,"う"],[36,1,"えら"],[39,1,"その"],[45,1,"は"],[47,1,"あか"]],"text":"あなたがたは、みずから喜んだかしの木によって、はずかしめを受け、みずから選んだ園によって、恥じ赤らむ。"},{"ref":"Isa.1.30","start":23001030,"end":23001030,"break":"line","breaks":[[20,"line"]],"ruby":[[6,1,"は"],[8,1,"か"],[14,1,"き"],[20,1,"みず"],[24,1,"その"]],"text":"あなたがたは葉の枯れるかしの木のように、水のない園のようになり、"},{"ref":"Isa.1.31","start":23001031,"end":23001031,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"つよ"],[2,1,"もの"],[4,1,"あさ"],[17,2,"ひばな"],[34,1,"とも"],[36,1,"も"],[43,1,"け"],[45,1,"もの"]],"text":"強い者も麻くずのように、そのわざは火花のようになり、その二つのものは共に燃えて、それを消す者はない。"}]