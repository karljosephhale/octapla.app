[{"ref":"1Sam.31.1","start":9031001,"end":9031001,"break":"paragraph","ruby":[[15,1,"たたか"],[25,2,"ひとびと"],[35,1,"まえ"],[38,1,"に"],[41,1,"おお"],[44,1,"もの"],[46,1,"きず"],[54,1,"やま"]],"text":"さてペリシテびとはイスラエルと戦った。イスラエルの人々はペリシテびとの前から逃げ、多くの者は傷ついてギルボア山にたおれた。"},{"ref":"1Sam.31.2","start":9031002,"end":9031002,"break":"none","ruby":[[13,1,"こ"],[16,1,"せ"],[18,1,"よ"],[35,1,"こ"],[57,1,"ころ"]],"text":"ペリシテびとはサウルとその子らに攻め寄り、そしてペリシテびとはサウルの子ヨナタン、アビナダブ、およびマルキシュアを殺した。"},{"ref":"1Sam.31.3","start":9031003,"end":9031003,"break":"none","ruby":[[0,1,"たたか"],[3,1,"はげ"],[10,1,"せま"],[13,1,"ゆみ"],[15,1,"い"],[17,1,"もの"],[25,1,"み"],[30,1,"かれ"],[32,1,"い"],[41,1,"い"],[43,1,"もの"],[50,1,"きず"],[52,1,"お"]],"text":"戦いは激しくサウルに迫り、弓を射る者どもがサウルを見つけて、彼を射たので、サウルは射る者たちにひどい傷を負わされた。"},{"ref":"1Sam.31.4","start":9031004,"end":9031004,"break":"none","ruby":[[9,2,"ぶき"],[12,1,"と"],[14,1,"もの"],[16,1,"い"],[25,1,"ぬ"],[38,1,"さ"],[51,1,"む"],[52,2,"かつれい"],[55,1,"もの"],[66,1,"さ"],[76,1,"ごろ"],[92,2,"ぶき"],[95,1,"と"],[97,1,"もの"],[105,1,"おそ"],[112,1,"おう"],[130,1,"と"],[136,1,"うえ"],[138,1,"ふ"]],"text":"そこでサウルはその武器を執る者に言った、「つるぎを抜き、それをもってわたしを刺せ。さもないと、これらの無割礼の者どもがきて、わたしを刺し、わたしをなぶり殺しにするであろう」。しかしその武器を執る者は、ひじょうに恐れて、それに応じなかったので、サウルは、つるぎを執って、その上に伏した。"},{"ref":"1Sam.31.5","start":9031005,"end":9031005,"break":"none","ruby":[[0,2,"ぶき"],[3,1,"と"],[5,1,"もの"],[11,1,"し"],[16,1,"み"],[19,2,"じぶん"],[28,1,"うえ"],[30,1,"ふ"],[34,1,"かれ"],[36,1,"とも"],[38,1,"し"]],"text":"武器を執る者はサウルが死んだのを見て、自分もまたつるぎの上に伏して、彼と共に死んだ。"},{"ref":"1Sam.31.6","start":9031006,"end":9031006,"break":"none","ruby":[[11,1,"にん"],[13,1,"こ"],[24,2,"ぶき"],[27,1,"と"],[29,1,"もの"],[37,2,"じゅうしゃ"],[42,1,"みな"],[46,1,"ひ"],[47,1,"とも"],[49,1,"し"]],"text":"こうしてサウルとその三人の子たち、およびサウルの武器を執る者、ならびにその従者たちは皆、この日共に死んだ。"},{"ref":"1Sam.31.7","start":9031007,"end":9031007,"break":"none","ruby":[[6,2,"ひとびと"],[10,1,"たに"],[12,1,"む"],[15,1,"がわ"],[25,1,"む"],[28,1,"がわ"],[32,1,"もの"],[41,2,"ひとびと"],[44,1,"に"],[49,1,"み"],[59,1,"こ"],[63,1,"し"],[68,1,"み"],[70,2,"まちまち"],[73,1,"す"],[76,1,"に"],[93,1,"なか"],[95,1,"す"]],"text":"イスラエルの人々で、谷の向こう側、およびヨルダンの向こう側にいる者が、イスラエルの人々の逃げるのを見、またサウルとその子たちの死んだのを見て町々を捨てて逃げたので、ペリシテびとはきてその中に住んだ。"},{"ref":"1Sam.31.8","start":9031008,"end":9031008,"break":"paragraph","ruby":[[3,1,"ひ"],[12,1,"ころ"],[16,1,"もの"],[22,1,"と"],[38,1,"にん"],[40,1,"こ"],[48,1,"やま"],[58,1,"み"]],"text":"あくる日、ペリシテびとは殺された者から、はぎ取るためにきたが、サウルとその三人の子たちがギルボア山にたおれているのを見つけた。"},{"ref":"1Sam.31.9","start":9031009,"end":9031009,"break":"none","ruby":[[0,1,"かれ"],[7,1,"くび"],[9,1,"き"],[20,1,"と"],[30,1,"ぜん"],[31,1,"ち"],[33,1,"ひと"],[43,1,"よ"],[45,1,"し"],[52,2,"ぐうぞう"],[55,1,"たみ"],[58,1,"つた"]],"text":"彼らはサウルの首を切り、そのよろいをはぎ取り、ペリシテびとの全地に人をつかわして、この良い知らせを、その偶像と民とに伝えさせた。"},{"ref":"1Sam.31.10","start":9031010,"end":9031010,"break":"none","ruby":[[2,1,"かれ"],[18,2,"しんでん"],[21,1,"お"],[24,1,"かれ"],[36,2,"じょうへき"]],"text":"また彼らは、そのよろいをアシタロテの神殿に置き、彼のからだをベテシャンの城壁にくぎづけにした。"},{"ref":"1Sam.31.11","start":9031011,"end":9031011,"break":"none","ruby":[[9,2,"じゅうみん"],[28,1,"こと"],[30,1,"き"]],"text":"ヤベシ・ギレアデの住民たちは、ペリシテびとがサウルにした事を聞いて、"},{"ref":"1Sam.31.12","start":9031012,"end":9031012,"break":"none","ruby":[[0,2,"ゆうし"],[7,1,"た"],[10,1,"よ"],[15,1,"い"],[30,1,"こ"],[44,2,"じょうへき"],[48,1,"と"],[67,1,"や"]],"text":"勇士たちはみな立ち、夜もすがら行って、サウルのからだと、その子たちのからだをベテシャンの城壁から取りおろし、ヤベシにきて、これをそこで焼き、"},{"ref":"1Sam.31.13","start":9031013,"end":9031013,"break":"none","ruby":[[2,1,"ほね"],[4,1,"と"],[18,1,"き"],[20,1,"した"],[22,1,"ほうむ"],[25,2,"なぬか"],[28,1,"あいだ"],[30,2,"だんじき"]],"text":"その骨を取って、ヤベシのぎょりゅうの木の下に葬り、七日の間、断食した。"}]