[{"ref":"Hag.2.1","start":37002001,"end":37002001,"break":"paragraph","ruby":[[4,1,"おう"],[7,1,"ねん"],[10,1,"がつ"],[14,1,"にち"],[17,1,"しゅ"],[19,2,"ことば"],[22,3,"よげんしゃ"],[29,1,"のぞ"]],"text":"ダリヨス王の二年の七月二十一日に、主の言葉が預言者ハガイに臨んだ、"},{"ref":"Hag.2.2","start":37002002,"end":37002002,"break":"none","ruby":[[7,1,"こ"],[12,2,"そうとく"],[26,1,"こ"],[28,1,"だい"],[29,2,"さいし"],[39,1,"のこ"],[46,1,"たみ"],[48,1,"つ"],[51,1,"い"]],"text":"「シャルテルの子、ユダの総督ゼルバベルと、ヨザダクの子、大祭司ヨシュア、および残りのすべての民に告げて言え、"},{"ref":"Hag.2.3","start":37002003,"end":37002003,"break":"none","ruby":[[6,1,"のこ"],[9,1,"もの"],[14,2,"いぜん"],[17,2,"えいこう"],[20,1,"かがや"],[22,1,"しゅ"],[24,1,"いえ"],[26,1,"み"],[28,1,"もの"],[40,1,"いま"],[44,2,"じょうたい"],[49,1,"おも"],[62,1,"め"],[66,1,"む"]],"text":"『あなたがた残りの者のうち、以前の栄光に輝く主の家を見た者はだれか。あなたがたは今、この状態をどう思うか。これはあなたがたの目には、無にひとしいではないか。"},{"ref":"Hag.2.4","start":37002004,"end":37002004,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[14,2,"ゆうき"],[17,1,"だ"],[25,1,"こ"],[27,1,"だい"],[28,2,"さいし"],[36,2,"ゆうき"],[39,1,"だ"],[42,1,"しゅ"],[44,1,"い"],[51,1,"ち"],[57,1,"たみ"],[60,2,"ゆうき"],[63,1,"だ"],[66,1,"はたら"],[79,1,"とも"],[85,2,"ばんぐん"],[88,1,"しゅ"],[90,1,"い"]],"text":"主は言われる、ゼルバベルよ、勇気を出せ。ヨザダクの子、大祭司ヨシュアよ、勇気を出せ。主は言われる。この地のすべての民よ、勇気を出せ。働け。わたしはあなたがたと共にいると、万軍の主は言われる。"},{"ref":"Hag.2.5","start":37002005,"end":37002005,"break":"none","ruby":[[15,1,"で"],[17,1,"とき"],[30,2,"やくそく"],[34,2,"ことば"],[44,1,"れい"],[56,1,"やど"],[62,1,"おそ"]],"text":"これはあなたがたがエジプトから出た時、わたしがあなたがたに、約束した言葉である。わたしの霊が、あなたがたのうちに宿っている。恐れるな。"},{"ref":"Hag.2.6","start":37002006,"end":37002006,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"い"],[21,2,"いちど"],[28,1,"てん"],[31,1,"ち"],[34,1,"うみ"],[41,1,"ち"],[44,1,"ふる"]],"text":"万軍の主はこう言われる、しばらくして、いま一度、わたしは天と、地と、海と、かわいた地とを震う。"},{"ref":"Hag.2.7","start":37002007,"end":37002007,"break":"none","ruby":[[6,3,"ばんこくみん"],[10,1,"ふる"],[13,3,"ばんこくみん"],[17,2,"ざいほう"],[25,1,"き"],[32,2,"えいこう"],[37,1,"いえ"],[39,1,"み"],[44,2,"ばんぐん"],[47,1,"しゅ"],[49,1,"い"]],"text":"わたしはまた万国民を震う。万国民の財宝は、はいって来て、わたしは栄光をこの家に満たすと、万軍の主は言われる。"},{"ref":"Hag.2.8","start":37002008,"end":37002008,"break":"none","ruby":[[0,1,"ぎん"],[9,1,"きん"],[22,2,"ばんぐん"],[25,1,"しゅ"],[27,1,"い"]],"text":"銀はわたしのもの、金もわたしのものであると、万軍の主は言われる。"},{"ref":"Hag.2.9","start":37002009,"end":37002009,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"いえ"],[4,1,"のち"],[6,2,"えいこう"],[10,1,"まえ"],[12,2,"えいこう"],[17,1,"おお"],[22,2,"ばんぐん"],[25,1,"しゅ"],[27,1,"い"],[38,1,"ところ"],[40,2,"はんえい"],[43,1,"あた"],[48,2,"ばんぐん"],[51,1,"しゅ"],[53,1,"い"]],"text":"主の家の後の栄光は、前の栄光よりも大きいと、万軍の主は言われる。わたしはこの所に繁栄を与えると、万軍の主は言われる』」。"},{"ref":"Hag.2.10","start":37002010,"end":37002010,"break":"paragraph","ruby":[[6,1,"ねん"],[9,1,"がつ"],[13,1,"か"],[16,1,"しゅ"],[18,2,"ことば"],[21,3,"よげんしゃ"],[28,1,"のぞ"]],"text":"ダリヨスの二年の九月二十四日に、主の言葉が預言者ハガイに臨んだ、"},{"ref":"Hag.2.11","start":37002011,"end":37002011,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[8,1,"い"],[13,2,"りっぽう"],[19,2,"さいし"],[24,1,"たず"],[27,1,"い"]],"text":"「万軍の主はこう言われる、律法について祭司たちに尋ねて言え、"},{"ref":"Hag.2.12","start":37002012,"end":37002012,"break":"none","ruby":[[1,1,"ひと"],[5,2,"いふく"],[11,1,"せい"],[14,1,"にく"],[16,1,"はこ"],[19,1,"い"],[43,1,"さけ"],[48,1,"あぶら"],[56,2,"しょくもつ"],[72,1,"せい"],[85,2,"さいし"],[97,1,"こた"]],"text":"『人がその衣服のすそで聖なる肉を運んで行き、そのすそがもし、パンまたはあつもの、または酒、または油、またはどんな食物にでもさわったなら、それらは聖なるものとなるか』と」。祭司たちは「ならない」と答えた。"},{"ref":"Hag.2.13","start":37002013,"end":37002013,"break":"none","ruby":[[6,1,"い"],[14,2,"したい"],[20,1,"けが"],[23,1,"ひと"],[30,1,"ひと"],[43,1,"けが"],[49,2,"さいし"],[55,1,"けが"],[60,1,"こた"]],"text":"ハガイはまた言った、「もし、死体によって汚れた人が、これらの一つにさわったなら、それは汚れるか」。祭司たちは「汚れる」と答えた。"},{"ref":"Hag.2.14","start":37002014,"end":37002014,"break":"none","ruby":[[8,1,"い"],[13,1,"しゅ"],[15,1,"い"],[22,1,"たみ"],[27,1,"くに"],[34,1,"まえ"],[50,1,"て"],[65,1,"ところ"],[67,1,"かれ"],[78,1,"けが"]],"text":"そこで、ハガイは言った、「主は言われる、この民も、この国も、わたしの前では、そのようである。またその手のわざもそのようである。その所で彼らのささげるものは、汚れたものである。"},{"ref":"Hag.2.15","start":37002015,"end":37002015,"break":"none","ruby":[[0,1,"いま"],[10,1,"ひ"],[14,1,"のち"],[16,1,"こと"],[18,1,"おも"],[24,1,"しゅ"],[26,1,"みや"],[28,1,"いし"],[30,1,"うえ"],[32,1,"いし"],[34,1,"つ"],[41,1,"まえ"]],"text":"今、あなたがたはこの日から、後の事を思うがよい。主の宮で石の上に石が積まれなかった前、あなたがたは、どんなであったか。"},{"ref":"Hag.2.16","start":37002016,"end":37002016,"break":"none","ruby":[[2,1,"とき"],[8,1,"ます"],[10,1,"むぎ"],[12,1,"つ"],[16,1,"ところ"],[18,1,"い"],[28,1,"ます"],[30,1,"え"],[36,1,"おけ"],[45,1,"さか"],[49,1,"い"],[56,1,"おけ"],[58,1,"え"]],"text":"あの時には、二十枡の麦の積まれる所に行ったが、わずかに十枡を得、また五十桶をくもうとして、酒ぶねに行ったが、二十桶を得たのみであった。"},{"ref":"Hag.2.17","start":37002017,"end":37002017,"break":"none","ruby":[[4,1,"た"],[6,1,"が"],[10,1,"くさ"],[12,1,"ほ"],[39,1,"て"],[44,1,"う"],[63,1,"かえ"],[70,1,"しゅ"],[72,1,"い"]],"text":"わたしは立ち枯れと、腐り穂と、ひょうをもってあなたがたと、あなたがたのすべての手のわざを撃った。しかし、あなたがたは、わたしに帰らなかったと主は言われる。"},{"ref":"Hag.2.18","start":37002018,"end":37002018,"break":"none","ruby":[[8,1,"ひ"],[11,1,"のち"],[19,1,"がつ"],[23,1,"か"],[27,1,"こと"],[29,1,"おも"],[37,1,"しゅ"],[39,1,"みや"],[41,1,"もとい"],[46,1,"ひ"],[49,1,"のち"],[51,1,"こと"],[53,1,"こころ"]],"text":"あなたがたはこの日より後、すなわち、九月二十四日よりの事を思うがよい。また主の宮の基をすえた日から後の事を心にとめるがよい。"},{"ref":"Hag.2.19","start":37002019,"end":37002019,"break":"none","ruby":[[0,1,"たね"],[5,2,"なや"],[16,1,"き"],[23,1,"き"],[29,1,"き"],[35,1,"き"],[39,1,"み"],[41,1,"むす"],[56,1,"ひ"],[66,1,"めぐ"],[69,1,"あた"]],"text":"種はなお、納屋にあるか。ぶどうの木、いちじくの木、ざくろの木、オリブの木もまだ実を結ばない。しかし、わたしはこの日から、あなたがたに恵みを与える」。"},{"ref":"Hag.2.20","start":37002020,"end":37002020,"break":"paragraph","ruby":[[2,1,"つき"],[7,1,"か"],[10,1,"しゅ"],[12,2,"ことば"],[23,1,"のぞ"]],"text":"この月の二十四日に、主の言葉がふたたびハガイに臨んだ、"},{"ref":"Hag.2.21","start":37002021,"end":37002021,"break":"none","ruby":[[4,2,"そうとく"],[12,1,"つ"],[15,1,"い"],[22,1,"てん"],[24,1,"ち"],[26,1,"ふる"]],"text":"「ユダの総督ゼルバベルに告げて言え、わたしは天と地を震う。"},{"ref":"Hag.2.22","start":37002022,"end":37002022,"break":"none","ruby":[[4,2,"くにぐに"],[7,2,"おうい"],[10,1,"たお"],[13,2,"いほう"],[16,2,"くにぐに"],[19,1,"ちから"],[21,1,"ほろ"],[27,2,"せんしゃ"],[36,1,"の"],[38,1,"もの"],[40,1,"たお"],[43,1,"うま"],[50,1,"の"],[52,1,"もの"],[61,2,"なかま"],[71,1,"たお"]],"text":"わたしは国々の王位を倒し、異邦の国々の力を滅ぼし、また戦車、およびこれに乗る者を倒す。馬およびこれに乗る者は、たがいにその仲間のつるぎによって倒れる。"},{"ref":"Hag.2.23","start":37002023,"end":37002023,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[16,1,"こ"],[30,1,"しゅ"],[32,1,"い"],[39,1,"ひ"],[49,1,"た"],[56,2,"いんしょう"],[73,1,"えら"],[83,2,"ばんぐん"],[86,1,"しゅ"],[88,1,"い"]],"text":"万軍の主は言われる、シャルテルの子、わがしもべゼルバベルよ、主は言われる、その日、わたしはあなたを立て、あなたを印章のようにする。わたしはあなたを選んだからであると、万軍の主は言われる」。"}]