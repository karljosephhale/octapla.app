[{"ref":"1Kgs.13.1","start":11013001,"end":11013001,"break":"paragraph","ruby":[[0,1,"み"],[3,1,"かみ"],[5,1,"ひと"],[7,1,"しゅ"],[9,1,"いのち"],[27,1,"とき"],[34,2,"さいだん"],[37,1,"うえ"],[39,1,"た"],[42,1,"こう"]],"text":"見よ、神の人が主の命によってユダからベテルにきた。その時ヤラベアムは祭壇の上に立って香をたいていた。"},{"ref":"1Kgs.13.2","start":11013002,"end":11013002,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ひと"],[4,2,"さいだん"],[10,1,"しゅ"],[12,1,"いのち"],[17,1,"よ"],[22,1,"い"],[27,2,"さいだん"],[31,2,"さいだん"],[35,1,"しゅ"],[39,1,"おお"],[46,1,"み"],[53,1,"いえ"],[59,1,"こ"],[61,1,"うま"],[67,1,"な"],[76,1,"かれ"],[82,1,"うえ"],[84,1,"こう"],[88,1,"たか"],[90,1,"ところ"],[92,2,"さいし"],[101,1,"うえ"],[110,1,"ひと"],[112,1,"ほね"],[118,1,"うえ"],[120,1,"や"]],"text":"神の人は祭壇にむかい主の命によって呼ばわって言った、「祭壇よ、祭壇よ、主はこう仰せられる、『見よ、ダビデの家にひとりの子が生れる。その名をヨシヤという。彼はおまえの上で香をたく高き所の祭司らを、おまえの上にささげる。また人の骨がおまえの上で焼かれる』」。"},{"ref":"1Kgs.13.3","start":11013003,"end":11013003,"break":"none","ruby":[[2,1,"ひ"],[4,1,"かれ"],[15,1,"しめ"],[18,1,"い"],[23,1,"しゅ"],[25,1,"い"],[40,1,"み"],[43,2,"さいだん"],[46,1,"さ"],[51,1,"うえ"],[55,1,"はい"],[60,1,"で"]],"text":"その日、彼はまた一つのしるしを示して言った、「主の言われたしるしはこれである、『見よ、祭壇は裂け、その上にある灰はこぼれ出るであろう』」。"},{"ref":"1Kgs.13.4","start":11013004,"end":11013004,"break":"none","ruby":[[5,1,"おう"],[8,1,"かみ"],[10,1,"ひと"],[18,2,"さいだん"],[25,1,"よ"],[29,2,"ことば"],[32,1,"き"],[35,1,"とき"],[37,2,"さいだん"],[41,1,"て"],[43,1,"の"],[49,1,"かれ"],[51,1,"とら"],[56,1,"い"],[61,1,"かれ"],[67,1,"の"],[71,1,"て"],[73,1,"か"],[79,1,"こ"]],"text":"ヤラベアム王は、神の人がベテルにある祭壇にむかって呼ばわる言葉を聞いた時、祭壇から手を伸ばして、「彼を捕えよ」と言ったが、彼にむかって伸ばした手が枯れて、ひっ込めることができなかった。"},{"ref":"1Kgs.13.5","start":11013005,"end":11013005,"break":"none","ruby":[[3,1,"かみ"],[5,1,"ひと"],[7,1,"しゅ"],[9,2,"ことば"],[15,1,"しめ"],[25,2,"さいだん"],[28,1,"さ"],[31,1,"はい"],[33,2,"さいだん"],[40,1,"で"]],"text":"そして神の人が主の言葉をもって示したしるしのように祭壇は裂け、灰は祭壇からこぼれ出た。"},{"ref":"1Kgs.13.6","start":11013006,"end":11013006,"break":"none","ruby":[[0,1,"おう"],[2,1,"かみ"],[4,1,"ひと"],[6,1,"い"],[15,1,"かみ"],[17,1,"しゅ"],[19,1,"ねが"],[29,1,"いの"],[37,1,"て"],[42,1,"かえ"],[52,1,"かみ"],[54,1,"ひと"],[56,1,"しゅ"],[58,1,"ねが"],[64,1,"おう"],[66,1,"て"],[71,1,"かえ"],[75,1,"まえ"]],"text":"王は神の人に言った、「あなたの神、主に願い、わたしのために祈って、わたしの手をもとに返らせてください」。神の人が主に願ったので、王の手はもとに返って、前のようになった。"},{"ref":"1Kgs.13.7","start":11013007,"end":11013007,"break":"none","ruby":[[3,1,"おう"],[5,1,"かみ"],[7,1,"ひと"],[9,1,"い"],[18,2,"いっしょ"],[21,1,"いえ"],[26,1,"み"],[28,1,"やす"],[38,2,"しゃれい"]],"text":"そこで王は神の人に言った、「わたしと一緒に家にきて、身を休めなさい。あなたに謝礼をさしあげましょう」。"},{"ref":"1Kgs.13.8","start":11013008,"end":11013008,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ひと"],[4,1,"おう"],[6,1,"い"],[19,1,"いえ"],[21,1,"なか"],[39,2,"いっしょ"],[53,1,"ところ"],[60,1,"た"],[63,1,"みず"],[65,1,"の"]],"text":"神の人は王に言った、「たとい、あなたの家の半ばをくださっても、わたしはあなたと一緒にまいりません。またこの所では、パンも食べず水も飲みません。"},{"ref":"1Kgs.13.9","start":11013009,"end":11013009,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[17,1,"た"],[26,1,"みず"],[28,1,"の"],[39,1,"き"],[41,1,"みち"],[44,1,"かえ"],[54,1,"めい"]],"text":"主の言葉によってわたしは、『パンを食べてはならない、水を飲んではならない。また来た道から帰ってはならない』と命じられているからです」。"},{"ref":"1Kgs.13.10","start":11013010,"end":11013010,"break":"none","ruby":[[4,1,"かれ"],[9,1,"みち"],[11,1,"い"],[18,1,"き"],[20,1,"みち"],[24,1,"かえ"]],"text":"こうして彼はほかの道を行き、ベテルに来た道からは帰らなかった。"},{"ref":"1Kgs.13.11","start":11013011,"end":11013011,"break":"paragraph","ruby":[[10,2,"としお"],[14,3,"よげんしゃ"],[18,1,"す"],[38,1,"ひ"],[39,1,"かみ"],[41,1,"ひと"],[49,1,"こと"],[53,1,"かれ"],[55,1,"はな"],[61,1,"かみ"],[63,1,"ひと"],[65,1,"おう"],[67,1,"い"],[70,2,"ことば"],[76,1,"ちち"],[78,1,"はな"]],"text":"さてベテルにひとりの年老いた預言者が住んでいたが、そのむすこたちがきて、その日神の人がベテルでした事どもを彼に話した。また神の人が王に言った言葉をもその父に話した。"},{"ref":"1Kgs.13.12","start":11013012,"end":11013012,"break":"none","ruby":[[0,1,"ちち"],[2,1,"かれ"],[8,1,"ひと"],[12,1,"みち"],[14,1,"い"],[20,1,"き"],[38,1,"かみ"],[40,1,"ひと"],[42,1,"い"],[45,1,"みち"],[47,1,"ちち"],[49,1,"しめ"]],"text":"父が彼らに「その人はどの道を行ったか」と聞いたので、むすこたちはユダからきた神の人の行った道を父に示した。"},{"ref":"1Kgs.13.13","start":11013013,"end":11013013,"break":"none","ruby":[[0,1,"ちち"],[8,1,"い"],[26,1,"お"],[33,1,"かれ"],[42,1,"お"],[48,1,"かれ"],[53,1,"の"]],"text":"父はむすこたちに言った、「わたしのためにろばにくらを置きなさい」。彼らがろばにくらを置いたので、彼はそれに乗り、"},{"ref":"1Kgs.13.14","start":11013014,"end":11013014,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ひと"],[7,1,"お"],[10,1,"い"],[16,1,"き"],[18,1,"した"],[28,1,"み"],[33,1,"ひと"],[35,1,"い"],[52,1,"かみ"],[54,1,"ひと"],[62,1,"ひと"],[64,1,"い"]],"text":"神の人のあとを追って行き、かしの木の下にすわっているのを見て、その人に言った、「あなたはユダからこられた神の人ですか」。その人は言った、「そうです」。"},{"ref":"1Kgs.13.15","start":11013015,"end":11013015,"break":"none","ruby":[[3,1,"かれ"],[7,1,"ひと"],[9,1,"い"],[18,2,"いっしょ"],[21,1,"いえ"],[28,1,"た"]],"text":"そこで彼はその人に言った、「わたしと一緒に家にきてパンを食べてください」。"},{"ref":"1Kgs.13.16","start":11013016,"end":11013016,"break":"none","ruby":[[2,1,"ひと"],[4,1,"い"],[17,2,"いっしょ"],[20,1,"ひ"],[22,1,"かえ"],[37,2,"いっしょ"],[40,1,"い"],[59,1,"ところ"],[65,2,"いっしょ"],[71,1,"た"],[74,1,"みず"],[76,1,"の"]],"text":"その人は言った、「わたしはあなたと一緒に引き返すことはできません。あなたと一緒に行くことはできません。またわたしはこの所であなたと一緒にパンも食べず水も飲みません。"},{"ref":"1Kgs.13.17","start":11013017,"end":11013017,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[16,1,"ところ"],[21,1,"た"],[30,1,"みず"],[32,1,"の"],[43,1,"き"],[45,1,"みち"],[48,1,"かえ"],[58,1,"い"]],"text":"主の言葉によってわたしは、『その所でパンを食べてはならない、水を飲んではならない。また来た道から帰ってはならない』と言われているからです」。"},{"ref":"1Kgs.13.18","start":11013018,"end":11013018,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ひと"],[6,1,"い"],[19,1,"おな"],[21,3,"よげんしゃ"],[28,1,"てん"],[30,1,"つかい"],[32,1,"しゅ"],[34,1,"いのち"],[43,1,"つ"],[50,1,"ひと"],[52,2,"いっしょ"],[55,1,"いえ"],[59,1,"かえ"],[65,1,"た"],[70,1,"みず"],[72,1,"の"],[78,1,"い"],[88,1,"かれ"],[92,1,"ひと"],[94,1,"あざむ"]],"text":"彼はその人に言った、「わたしもあなたと同じ預言者ですが、天の使が主の命によってわたしに告げて、『その人を一緒に家につれ帰り、パンを食べさせ、水を飲ませよ』と言いました」。これは彼がその人を欺いたのである。"},{"ref":"1Kgs.13.19","start":11013019,"end":11013019,"break":"none","ruby":[[5,1,"ひと"],[7,1,"かれ"],[9,2,"いっしょ"],[12,1,"ひ"],[14,1,"かえ"],[19,1,"いえ"],[24,1,"た"],[27,1,"みず"],[29,1,"の"]],"text":"そこでその人は彼と一緒に引き返し、その家でパンを食べ、水を飲んだ。"},{"ref":"1Kgs.13.20","start":11013020,"end":11013020,"break":"paragraph","ruby":[[0,1,"かれ"],[3,2,"しょくたく"],[14,1,"しゅ"],[16,2,"ことば"],[22,1,"ひと"],[27,1,"かえ"],[30,3,"よげんしゃ"],[34,1,"のぞ"]],"text":"彼らが食卓についていたとき、主の言葉が、その人をつれて帰った預言者に臨んだので、"},{"ref":"1Kgs.13.21","start":11013021,"end":11013021,"break":"none","ruby":[[0,1,"かれ"],[8,1,"かみ"],[10,1,"ひと"],[15,1,"よ"],[20,1,"い"],[25,1,"しゅ"],[29,1,"おお"],[41,1,"しゅ"],[43,2,"ことば"],[54,1,"かみ"],[56,1,"しゅ"],[59,1,"めい"],[65,2,"めいれい"],[68,1,"まも"]],"text":"彼はユダからきた神の人にむかい呼ばわって言った、「主はこう仰せられます、『あなたが主の言葉にそむき、あなたの神、主がお命じになった命令を守らず、"},{"ref":"1Kgs.13.22","start":11013022,"end":11013022,"break":"none","ruby":[[0,1,"ひ"],[2,1,"かえ"],[6,1,"しゅ"],[16,1,"た"],[25,1,"みず"],[27,1,"の"],[37,1,"い"],[41,2,"ばしょ"],[47,1,"た"],[50,1,"みず"],[52,1,"の"],[62,2,"したい"],[69,2,"せんぞ"],[72,1,"はか"],[74,1,"い"]],"text":"引き返して、主があなたに、パンを食べてはならない、水を飲んではならない、と言われた場所でパンを食べ、水を飲んだゆえ、あなたの死体はあなたの先祖の墓に行かないであろう』」。"},{"ref":"1Kgs.13.23","start":11013023,"end":11013023,"break":"none","ruby":[[5,1,"ひと"],[10,1,"た"],[13,1,"みず"],[15,1,"の"],[18,1,"のち"],[20,1,"かれ"],[24,1,"ひと"],[35,1,"かえ"],[38,3,"よげんしゃ"],[51,1,"お"]],"text":"そしてその人がパンを食べ、水を飲んだ後、彼はその人のため、すなわちつれ帰った預言者のためにろばにくらを置いた。"},{"ref":"1Kgs.13.24","start":11013024,"end":11013024,"break":"none","ruby":[[6,1,"ひと"],[8,1,"た"],[10,1,"さ"],[15,1,"みち"],[20,1,"かれ"],[22,1,"あ"],[25,1,"かれ"],[27,1,"ころ"],[36,2,"したい"],[39,1,"みち"],[41,1,"す"],[56,1,"た"],[64,2,"したい"],[72,1,"た"]],"text":"こうしてその人は立ち去ったが、道でししが彼に会って彼を殺した。そしてその死体は道に捨てられ、ろばはそのかたわらに立ち、ししもまた死体のかたわらに立っていた。"},{"ref":"1Kgs.13.25","start":11013025,"end":11013025,"break":"none","ruby":[[0,2,"ひとびと"],[11,1,"みち"],[13,1,"す"],[20,2,"したい"],[24,2,"したい"],[32,1,"た"],[40,1,"み"],[45,1,"ろう"],[46,3,"よげんしゃ"],[50,1,"す"],[55,1,"まち"],[62,1,"はな"]],"text":"人々はそこをとおって、道に捨てられている死体と、死体のかたわらに立っているししを見て、かの老預言者の住んでいる町にきてそれを話した。"},{"ref":"1Kgs.13.26","start":11013026,"end":11013026,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"みち"],[10,1,"かえ"],[13,3,"よげんしゃ"],[20,1,"き"],[23,1,"い"],[31,1,"しゅ"],[33,2,"ことば"],[40,1,"かみ"],[42,1,"ひと"],[45,1,"しゅ"],[47,1,"かれ"],[49,1,"い"],[53,2,"ことば"],[60,1,"しゅ"],[62,1,"かれ"],[75,1,"かれ"],[77,1,"さ"],[79,1,"ころ"]],"text":"その人を道からつれて帰った預言者はそれを聞いて言った、「それは主の言葉にそむいた神の人だ。主が彼に言われた言葉のように、主は彼をししにわたされ、ししが彼を裂き殺したのだ」。"},{"ref":"1Kgs.13.27","start":11013027,"end":11013027,"break":"none","ruby":[[9,1,"い"],[27,1,"お"],[34,1,"かれ"],[40,1,"お"]],"text":"そしてむすこたちに言った、「わたしのためにろばにくらを置きなさい」。彼らがくらを置いたので、"},{"ref":"1Kgs.13.28","start":11013028,"end":11013028,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[6,2,"したい"],[9,1,"みち"],[11,1,"す"],[22,2,"したい"],[30,1,"た"],[37,1,"み"],[45,2,"したい"],[48,1,"た"],[55,1,"さ"]],"text":"彼は行って、死体が道に捨てられ、ろばとししが死体のかたわらに立っているのを見た。ししはその死体を食べず、ろばも裂いていなかった。"},{"ref":"1Kgs.13.29","start":11013029,"end":11013029,"break":"none","ruby":[[3,3,"よげんしゃ"],[7,1,"かみ"],[9,1,"ひと"],[11,2,"したい"],[14,1,"と"],[25,1,"の"],[28,1,"まち"],[30,1,"も"],[32,1,"かえ"],[35,1,"かな"],[42,1,"ほうむ"]],"text":"そこで預言者は神の人の死体を取りあげ、それをろばに載せて町に持ち帰り、悲しんでそれを葬った。"},{"ref":"1Kgs.13.30","start":11013030,"end":11013030,"break":"none","ruby":[[6,2,"したい"],[9,2,"じぶん"],[12,1,"はか"],[14,1,"おさ"],[17,1,"みな"],[30,2,"きょうだい"],[35,1,"い"],[38,1,"かな"]],"text":"すなわちその死体を自分の墓に納め、皆これがために「ああ、わが兄弟よ」と言って悲しんだ。"},{"ref":"1Kgs.13.31","start":11013031,"end":11013031,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ほうむ"],[8,1,"のち"],[16,1,"い"],[25,1,"し"],[28,1,"とき"],[31,1,"かみ"],[33,1,"ひと"],[35,1,"ほうむ"],[38,1,"はか"],[40,1,"ほうむ"],[47,1,"ほね"],[49,1,"かれ"],[51,1,"ほね"],[58,1,"おさ"]],"text":"彼はそれを葬って後、むすこたちに言った、「わたしが死んだ時は、神の人を葬った墓に葬り、わたしの骨を彼の骨のかたわらに納めなさい。"},{"ref":"1Kgs.13.32","start":11013032,"end":11013032,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"いのち"],[16,2,"さいだん"],[30,2,"まちまち"],[35,1,"たか"],[37,1,"ところ"],[43,1,"いえ"],[49,1,"よ"],[54,2,"ことば"],[57,1,"かなら"],[59,2,"じょうじゅ"]],"text":"彼が主の命によって、ベテルにある祭壇にむかい、またサマリヤの町々にある高き所のすべての家にむかって呼ばわった言葉は必ず成就するのです」。"},{"ref":"1Kgs.13.33","start":11013033,"end":11013033,"break":"paragraph","ruby":[[2,1,"こと"],[4,1,"のち"],[15,1,"わる"],[17,1,"みち"],[19,1,"はな"],[22,1,"た"],[24,1,"かえ"],[34,2,"いっぱん"],[37,1,"たみ"],[40,1,"たか"],[42,1,"ところ"],[44,2,"さいし"],[47,2,"にんめい"],[61,1,"この"],[63,1,"もの"],[69,1,"た"],[72,1,"たか"],[74,1,"ところ"],[76,2,"さいし"]],"text":"この事の後も、ヤラベアムはその悪い道を離れて立ち返ることをせず、また一般の民を、高き所の祭司に任命した。すなわち、だれでも好む者は、それを立てて高き所の祭司とした。"},{"ref":"1Kgs.13.34","start":11013034,"end":11013034,"break":"none","ruby":[[2,1,"こと"],[10,1,"いえ"],[12,1,"つみ"],[24,1,"ち"],[31,1,"た"],[33,1,"ほろ"]],"text":"この事はヤラベアムの家の罪となって、ついにこれを地のおもてから断ち滅ぼすようになった。"}]