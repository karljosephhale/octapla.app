[{"ref":"Isa.64.1","start":23064001,"end":23064001,"break":"paragraph","breaks":[[16,"line"]],"ruby":[[8,1,"てん"],[10,1,"さ"],[13,1,"くだ"],[20,1,"まえ"],[22,2,"やまやま"],[25,1,"ふる"],[27,1,"うご"]],"text":"どうか、あなたが天を裂いて下り、あなたの前に山々が震い動くように。"},{"ref":"Isa.64.2","start":23064002,"end":23064002,"break":"line","breaks":[[9,"line"],[30,"line"],[49,"line"],[62,"line"]],"ruby":[[0,1,"ひ"],[2,2,"しばき"],[5,1,"も"],[9,1,"ひ"],[11,1,"みず"],[13,1,"わ"],[22,1,"くだ"],[35,1,"な"],[54,1,"くに"],[60,1,"まえ"],[62,1,"ふる"]],"text":"火が柴木を燃やし、火が水を沸かすときのごとく下られるように。そして、み名をあなたのあだにあらわし、もろもろの国をあなたの前に震えおののかせられるように。"},{"ref":"Isa.64.3","start":23064003,"end":23064003,"break":"line","breaks":[[23,"line"]],"ruby":[[10,2,"きたい"],[17,1,"おそ"],[21,1,"こと"],[27,1,"とき"],[29,1,"くだ"],[36,2,"やまやま"],[39,1,"ふる"],[41,1,"うご"]],"text":"あなたは、われわれが期待しなかった恐るべき事をなされた時に下られたので、山々は震い動いた。"},{"ref":"Isa.64.4","start":23064004,"end":23064004,"break":"line","breaks":[[11,"line"],[26,"line"],[48,"line"]],"ruby":[[17,1,"かみ"],[19,1,"ま"],[21,1,"のぞ"],[23,1,"もの"],[31,1,"こと"],[33,1,"おこな"],[37,1,"かみ"],[39,1,"き"],[48,1,"みみ"],[50,1,"い"],[59,1,"め"],[61,1,"み"]],"text":"いにしえからこのかた、あなたのほか神を待ち望む者に、このような事を行われた神を聞いたことはなく、耳に入れたこともなく、目に見たこともない。"},{"ref":"Isa.64.5","start":23064005,"end":23064005,"break":"line","breaks":[[12,"line"],[22,"line"],[38,"line"],[61,"line"],[78,"line"]],"ruby":[[4,1,"よろこ"],[7,1,"ぎ"],[9,1,"おこな"],[16,1,"みち"],[26,2,"きねん"],[30,1,"もの"],[32,1,"むか"],[38,1,"み"],[45,1,"いか"],[55,1,"つみ"],[57,1,"おか"],[66,1,"ひさ"],[69,1,"つみ"],[83,1,"すく"]],"text":"あなたは喜んで義を行い、あなたの道にあって、あなたを記念する者を迎えられる。見よ、あなたは怒られた、われわれは罪を犯した。われわれは久しく罪のうちにあった。われわれは救われるであろうか。"},{"ref":"Isa.64.6","start":23064006,"end":23064006,"break":"line","breaks":[[18,"line"],[30,"line"],[46,"line"],[63,"line"]],"ruby":[[7,1,"けが"],[10,1,"ひと"],[23,1,"ただ"],[26,1,"おこな"],[35,1,"けが"],[38,1,"ころも"],[53,1,"こ"],[55,1,"は"],[60,1,"か"],[68,2,"ふぎ"],[71,1,"かぜ"],[81,1,"ふ"],[83,1,"さ"]],"text":"われわれはみな汚れた人のようになり、われわれの正しい行いは、ことごとく汚れた衣のようである。われわれはみな木の葉のように枯れ、われわれの不義は風のようにわれわれを吹き去る。"},{"ref":"Isa.64.7","start":23064007,"end":23064007,"break":"line","breaks":[[13,"line"],[35,"line"],[57,"line"]],"ruby":[[4,1,"な"],[6,1,"よ"],[8,1,"もの"],[17,1,"はげ"],[30,1,"もの"],[40,1,"かお"],[42,1,"かく"],[51,1,"かえり"],[66,2,"ふぎ"],[69,1,"て"],[71,1,"わた"]],"text":"あなたの名を呼ぶ者はなく、みずから励んで、あなたによりすがる者はない。あなたはみ顔を隠して、われわれを顧みられず、われわれをおのれの不義の手に渡された。"},{"ref":"Isa.64.8","start":23064008,"end":23064008,"break":"paragraph","breaks":[[19,"line"],[41,"line"]],"ruby":[[3,1,"しゅ"],[15,1,"ちち"],[24,2,"ねんど"],[35,2,"とうき"],[37,1,"し"],[50,1,"て"]],"text":"されど主よ、あなたはわれわれの父です。われわれは粘土であって、あなたは陶器師です。われわれはみな、み手のわざです。"},{"ref":"Isa.64.9","start":23064009,"end":23064009,"break":"line","breaks":[[17,"line"],[39,"line"],[56,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"いか"],[22,2,"ふぎ"],[48,1,"かえり"],[68,1,"たみ"]],"text":"主よ、ひどくお怒りにならぬように、いつまでも不義をみこころにとめられぬように。どうぞ、われわれを顧みてください。われわれはみな、あなたの民です。"},{"ref":"Isa.64.10","start":23064010,"end":23064010,"break":"line","breaks":[[16,"line"],[26,"line"]],"ruby":[[4,1,"せい"],[7,2,"まちまち"],[10,2,"あらの"],[20,2,"あらの"],[32,1,"あ"]],"text":"あなたの聖なる町々は荒野となり、シオンは荒野となり、エルサレムは荒れすたれた。"},{"ref":"Isa.64.11","start":23064011,"end":23064011,"break":"line","breaks":[[18,"line"],[37,"line"]],"ruby":[[5,2,"せんぞ"],[18,1,"せい"],[21,1,"うるわ"],[29,1,"みや"],[31,1,"ひ"],[33,1,"や"],[42,1,"した"],[45,1,"ところ"],[52,1,"あ"]],"text":"われわれの先祖があなたをほめたたえた聖なる麗しいわれわれの宮は火で焼かれ、われわれが慕った所はことごとく荒れはてた。"},{"ref":"Isa.64.12","start":23064012,"end":23064012,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"こと"],[29,1,"もく"],[41,1,"くる"]],"text":"主よ、これらの事があってもなお、あなたはみずからをおさえ、黙して、われわれをいたく苦しめられるのですか。"}]