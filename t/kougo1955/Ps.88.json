[{"ref":"Ps.88.1","start":19088001,"end":19088001,"break":"paragraph","title":"聖歌隊の指揮者によってマハラテ・レアノテのしらべにあわせてうたわせたコラの子の歌、さんび。エズラびとヘマンのマスキールの歌","breaks":[[21,"line"]],"ruby":[[2,1,"かみ"],[4,1,"しゅ"],[11,1,"ひる"],[13,1,"たす"],[16,1,"よ"],[18,1,"もと"],[21,1,"よる"],[24,1,"まえ"],[26,1,"さけ"],[28,1,"もと"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[37,1,"こ"],[39,1,"うた"],[60,1,"うた"]],"text":"わが神、主よ、わたしは昼、助けを呼び求め、夜、み前に叫び求めます。"},{"ref":"Ps.88.2","start":19088002,"end":19088002,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"いのり"],[7,1,"まえ"],[18,1,"さけ"],[21,1,"みみ"],[23,1,"かたむ"]],"text":"わたしの祈をみ前にいたらせ、わたしの叫びに耳を傾けてください。"},{"ref":"Ps.88.3","start":19088003,"end":19088003,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"たましい"],[6,1,"なや"],[9,1,"み"],[20,2,"よみ"],[23,1,"ちか"]],"text":"わたしの魂は悩みに満ち、わたしのいのちは陰府に近づきます。"},{"ref":"Ps.88.4","start":19088004,"end":19088004,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"あな"],[6,1,"くだ"],[8,1,"もの"],[13,1,"かぞ"],[18,1,"ちから"],[22,1,"ひと"]],"text":"わたしは穴に下る者のうちに数えられ、力のない人のようになりました。"},{"ref":"Ps.88.5","start":19088005,"end":19088005,"break":"line","breaks":[[21,"line"],[37,"line"],[56,"line"],[62,"line"]],"ruby":[[4,2,"しにん"],[10,1,"す"],[15,1,"もの"],[21,1,"はか"],[23,1,"よこ"],[27,1,"ころ"],[31,1,"もの"],[41,1,"ふたた"],[43,1,"こころ"],[51,1,"もの"],[62,1,"かれ"],[70,1,"て"],[73,1,"た"],[75,1,"ほろ"],[80,1,"もの"]],"text":"すなわち死人のうちに捨てられた者のように、墓に横たわる殺された者のように、あなたが再び心にとめられない者のようになりました。彼らはあなたのみ手から断ち滅ぼされた者です。"},{"ref":"Ps.88.6","start":19088006,"end":19088006,"break":"line","breaks":[[12,"line"]],"ruby":[[8,1,"ふか"],[10,1,"あな"],[12,1,"くら"],[14,1,"ところ"],[16,1,"ふか"],[18,1,"ふち"],[20,1,"お"]],"text":"あなたはわたしを深い穴、暗い所、深い淵に置かれました。"},{"ref":"Ps.88.7","start":19088007,"end":19088007,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[4,1,"いか"],[11,1,"うえ"],[13,1,"おも"],[25,1,"なみ"],[34,1,"くる"]],"text":"あなたの怒りはわたしの上に重く、あなたはもろもろの波をもってわたしを苦しめられました。〔セラ"},{"ref":"Ps.88.8","start":19088008,"end":19088008,"break":"line","breaks":[[19,"line"],[39,"line"]],"ruby":[[6,1,"し"],[8,1,"ひと"],[15,1,"とお"],[23,1,"かれ"],[26,1,"い"],[31,1,"もの"],[43,1,"と"]],"text":"あなたはわが知り人をわたしから遠ざけ、わたしを彼らの忌みきらう者とされました。わたしは閉じこめられて、のがれることはできません。"},{"ref":"Ps.88.9","start":19088009,"end":19088009,"break":"line","breaks":[[19,"line"],[37,"line"]],"ruby":[[4,1,"め"],[6,1,"かな"],[13,1,"おとろ"],[19,1,"しゅ"],[26,1,"ひ"],[34,1,"よ"],[47,2,"りょうて"],[50,1,"の"]],"text":"わたしの目は悲しみによって衰えました。主よ、わたしは日ごとにあなたを呼び、あなたにむかってわが両手を伸べました。"},{"ref":"Ps.88.10","start":19088010,"end":19088010,"break":"line","breaks":[[12,"line"],[25,"line"],[40,"line"]],"ruby":[[4,1,"し"],[7,1,"もの"],[12,2,"きせき"],[15,1,"おこな"],[27,1,"ひと"],[34,1,"お"]],"text":"あなたは死んだ者のために奇跡を行われるでしょうか。なき人のたましいは起きあがってあなたをほめたたえるでしょうか。〔セラ"},{"ref":"Ps.88.11","start":19088011,"end":19088011,"break":"line","breaks":[[16,"line"],[31,"line"]],"ruby":[[10,1,"はか"],[24,1,"ほろ"],[31,1,"の"],[33,1,"つた"]],"text":"あなたのいつくしみは墓のなかに、あなたのまことは滅びのなかに、宣べ伝えられるでしょうか。"},{"ref":"Ps.88.12","start":19088012,"end":19088012,"break":"line","breaks":[[12,"line"]],"ruby":[[4,2,"きせき"],[7,1,"くら"],[16,1,"ぎ"],[18,1,"わす"],[21,1,"くに"],[23,1,"し"]],"text":"あなたの奇跡は暗やみに、あなたの義は忘れの国に知られるでしょうか。"},{"ref":"Ps.88.13","start":19088013,"end":19088013,"break":"line","breaks":[[21,"line"]],"ruby":[[3,1,"しゅ"],[14,1,"よ"],[28,1,"いのり"],[35,1,"まえ"]],"text":"しかし主よ、わたしはあなたに呼ばわります。あしたに、わが祈をあなたのみ前にささげます。"},{"ref":"Ps.88.14","start":19088014,"end":19088014,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[14,1,"す"],[32,1,"かお"],[34,1,"かく"]],"text":"主よ、なぜ、あなたはわたしを捨てられるのですか。なぜ、わたしにみ顔を隠されるのですか。"},{"ref":"Ps.88.15","start":19088015,"end":19088015,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"わか"],[6,1,"とき"],[9,1,"くる"],[13,1,"し"],[25,1,"おびやか"],[31,1,"おとろ"]],"text":"わたしは若い時から苦しんで死ぬばかりです。あなたの脅しにあって衰えはてました。"},{"ref":"Ps.88.16","start":19088016,"end":19088016,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"はげ"],[7,1,"いか"],[14,1,"おそ"],[21,1,"おそ"],[25,1,"おびやか"],[32,1,"ほろ"]],"text":"あなたの激しい怒りがわたしを襲い、あなたの恐ろしい脅しがわたしを滅ぼしました。"},{"ref":"Ps.88.17","start":19088017,"end":19088017,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"こと"],[10,2,"おおみず"],[28,1,"まった"],[30,1,"と"],[32,1,"ま"]],"text":"これらの事がひねもす大水のようにわたしをめぐり、わたしを全く取り巻きました。"},{"ref":"Ps.88.18","start":19088018,"end":19088018,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"あい"],[7,1,"もの"],[9,1,"とも"],[17,1,"とお"],[25,1,"し"],[27,1,"びと"],[29,1,"くら"]],"text":"あなたは愛する者と友とをわたしから遠ざけ、わたしの知り人を暗やみにおかれました。"}]