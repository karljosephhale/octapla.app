[{"ref":"Ps.134.1","start":19134001,"end":19134001,"break":"paragraph","title":"都もうでの歌","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"み"],[3,1,"よる"],[5,1,"しゅ"],[7,1,"いえ"],[9,1,"た"],[12,1,"しゅ"],[14,1,"つか"],[26,1,"しゅ"]],"titleRuby":[[0,1,"みやこ"],[5,1,"うた"]],"text":"見よ、夜、主の家に立って主に仕えるすべてのしもべよ、主をほめよ。"},{"ref":"Ps.134.2","start":19134002,"end":19134002,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"せいじょ"],[13,1,"て"],[18,1,"しゅ"]],"text":"聖所にむかってあなたがたの手をあげ、主をほめよ。"},{"ref":"Ps.134.3","start":19134003,"end":19134003,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"てん"],[7,1,"ち"],[9,1,"つく"],[13,1,"もの"],[24,2,"しゅくふく"]],"text":"どうぞ主、天と地を造られた者、シオンからあなたを祝福されるように。"}]