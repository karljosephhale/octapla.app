[{"ref":"Job.13.1","start":18013001,"end":18013001,"break":"paragraph","breaks":[[10,"line"],[21,"line"]],"ruby":[[0,1,"み"],[7,1,"め"],[18,1,"み"],[25,1,"みみ"],[30,1,"き"],[33,1,"さと"]],"text":"見よ、わたしの目は、これをことごとく見た。わたしの耳はこれを聞いて悟った。"},{"ref":"Job.13.2","start":18013002,"end":18013002,"break":"line","breaks":[[24,"line"]],"ruby":[[6,1,"し"],[11,1,"こと"],[18,1,"し"],[34,1,"おと"]],"text":"あなたがたの知っている事は、わたしも知っている。わたしはあなたがたに劣らない。"},{"ref":"Job.13.3","start":18013003,"end":18013003,"break":"line","breaks":[[17,"line"]],"ruby":[[7,3,"ぜんのうしゃ"],[11,1,"もの"],[13,1,"い"],[21,1,"かみ"],[23,1,"ろん"],[29,1,"のぞ"]],"text":"しかしわたしは全能者に物を言おう、わたしは神と論ずることを望む。"},{"ref":"Job.13.4","start":18013004,"end":18013004,"break":"line","breaks":[[20,"line"]],"ruby":[[6,1,"いつわ"],[16,1,"つくろ"],[18,1,"もの"],[20,1,"みな"],[22,2,"むよう"],[25,2,"いし"]],"text":"あなたがたは偽りをもってうわべを繕う者、皆、無用の医師だ。"},{"ref":"Job.13.5","start":18013005,"end":18013005,"break":"line","breaks":[[20,"line"]],"ruby":[[10,1,"まった"],[12,2,"ちんもく"],[29,2,"ちえ"]],"text":"どうか、あなたがたは全く沈黙するように。これがあなたがたの知恵であろう。"},{"ref":"Job.13.6","start":18013006,"end":18013006,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"いま"],[6,1,"ろん"],[12,1,"き"],[22,1,"くち"],[24,1,"い"],[26,1,"あらそ"],[31,1,"みみ"],[33,1,"かたむ"]],"text":"今、わたしの論ずることを聞くがよい。わたしの口で言い争うことに耳を傾けるがよい。"},{"ref":"Job.13.7","start":18013007,"end":18013007,"break":"line","breaks":[[23,"line"]],"ruby":[[6,1,"かみ"],[11,2,"ふぎ"],[14,1,"い"],[25,1,"かれ"],[30,1,"いつわ"],[33,1,"の"]],"text":"あなたがたは神のために不義を言おうとするのか。また彼のために偽りを述べるのか。"},{"ref":"Job.13.8","start":18013008,"end":18013008,"break":"line","breaks":[[20,"line"]],"ruby":[[6,1,"かれ"],[20,1,"かみ"],[25,1,"あらそ"]],"text":"あなたがたは彼にひいきしようとするのか。神のために争おうとするのか。"},{"ref":"Job.13.9","start":18013009,"end":18013009,"break":"line","breaks":[[16,"line"],[29,"line"],[42,"line"]],"ruby":[[0,1,"かみ"],[8,1,"しら"],[22,2,"ぶじ"],[35,1,"ひと"],[37,1,"あざむ"],[42,1,"かれ"],[44,1,"あざむ"]],"text":"神があなたがたを調べられるとき、あなたがたは無事だろうか。あなたがたは人を欺くように彼を欺くことができるか。"},{"ref":"Job.13.10","start":18013010,"end":18013010,"break":"line","breaks":[[22,"line"]],"ruby":[[22,1,"かれ"],[24,1,"かなら"],[32,1,"せ"]],"text":"あなたがたがもし、ひそかにひいきするならば、彼は必ずあなたがたを責められる。"},{"ref":"Job.13.11","start":18013011,"end":18013011,"break":"line","breaks":[[23,"line"],[32,"line"]],"ruby":[[2,2,"いげん"],[11,1,"おそ"],[23,1,"かれ"],[29,1,"おそ"],[38,1,"のぞ"]],"text":"その威厳はあなたがたを恐れさせないであろうか。彼をおそれる恐れがあなたがたに臨まないであろうか。"},{"ref":"Job.13.12","start":18013012,"end":18013012,"break":"line","breaks":[[17,"line"]],"ruby":[[6,2,"かくげん"],[9,1,"はい"],[23,1,"たて"],[25,1,"つち"],[27,1,"たて"]],"text":"あなたがたの格言は灰のことわざだ。あなたがたの盾は土の盾だ。"},{"ref":"Job.13.13","start":18013013,"end":18013013,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"もく"],[18,1,"はな"],[22,2,"なにごと"],[30,1,"く"],[35,1,"く"]],"text":"黙して、わたしにかかわるな、わたしは話そう。何事でもわたしに来るなら、来るがよい。"},{"ref":"Job.13.14","start":18013014,"end":18013014,"break":"line","breaks":[[15,"line"]],"ruby":[[6,1,"にく"],[10,1,"は"],[12,1,"と"],[17,1,"いのち"],[21,1,"て"],[26,1,"お"]],"text":"わたしはわが肉をわが歯に取り、わが命をわが手のうちに置く。"},{"ref":"Job.13.15","start":18013015,"end":18013015,"break":"line","breaks":[[16,"line"],[24,"line"],[39,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[9,1,"ころ"],[20,2,"ぜつぼう"],[37,1,"みち"],[39,1,"かれ"],[41,1,"まえ"],[43,1,"まも"],[45,1,"ぬ"]],"text":"見よ、彼はわたしを殺すであろう。わたしは絶望だ。しかしなおわたしはわたしの道を彼の前に守り抜こう。"},{"ref":"Job.13.16","start":18013016,"end":18013016,"break":"line","breaks":[[22,"line"]],"ruby":[[8,1,"すくい"],[13,1,"かみ"],[15,1,"しん"],[19,1,"もの"],[22,1,"かみ"],[24,1,"まえ"],[26,1,"で"]],"text":"これこそわたしの救となる。神を信じない者は、神の前に出ることができないからだ。"},{"ref":"Job.13.17","start":18013017,"end":18013017,"break":"line","breaks":[[18,"line"]],"ruby":[[12,2,"ことば"],[15,1,"き"],[22,1,"の"],[25,1,"ところ"],[27,1,"みみ"],[29,1,"い"]],"text":"あなたがたはよくわたしの言葉を聞き、わたしの述べる所を耳に入れよ。"},{"ref":"Job.13.18","start":18013018,"end":18013018,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"み"],[14,1,"た"],[16,1,"ば"],[18,1,"い"],[20,1,"なら"],[28,1,"ぎ"],[40,1,"し"]],"text":"見よ、わたしはすでにわたしの立ち場を言い並べた。わたしは義とされることをみずから知っている。"},{"ref":"Job.13.19","start":18013019,"end":18013019,"break":"line","breaks":[[23,"line"]],"ruby":[[7,1,"い"],[9,1,"あらそ"],[11,1,"こと"],[16,1,"もの"],[35,1,"もく"],[38,1,"し"]],"text":"だれかわたしと言い争う事のできる者があろうか。もしあるならば、わたしは黙して死ぬであろう。"},{"ref":"Job.13.20","start":18013020,"end":18013020,"break":"line","breaks":[[19,"line"],[38,"line"]],"ruby":[[9,1,"こと"],[11,1,"ゆる"],[33,1,"かお"],[38,1,"かく"]],"text":"ただわたしに二つの事を許してください。そうすれば、わたしはあなたの顔をさけて隠れることはないでしょう。"},{"ref":"Job.13.21","start":18013021,"end":18013021,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[4,1,"て"],[11,1,"はな"],[23,1,"おそ"],[27,1,"こと"],[36,1,"おそ"]],"text":"あなたの手をわたしから離してください。あなたの恐るべき事をもってわたしを恐れさせないでください。"},{"ref":"Job.13.22","start":18013022,"end":18013022,"break":"line","breaks":[[20,"line"],[31,"line"]],"ruby":[[4,1,"およ"],[15,1,"こた"],[24,1,"もの"],[26,1,"い"],[35,2,"じしん"],[43,1,"こた"]],"text":"そしてお呼びください、わたしは答えます。わたしに物を言わせて、あなたご自身、わたしにお答えください。"},{"ref":"Job.13.23","start":18013023,"end":18013023,"break":"line","breaks":[[24,"line"]],"ruby":[[14,1,"つみ"],[31,1,"つみ"],[38,1,"し"]],"text":"わたしのよこしまと、わたしの罪がどれほどあるか。わたしのとがと罪とをわたしに知らせてください。"},{"ref":"Job.13.24","start":18013024,"end":18013024,"break":"line","breaks":[[16,"line"]],"ruby":[[10,1,"かお"],[24,1,"てき"]],"text":"なにゆえ、あなたはみ顔をかくし、わたしをあなたの敵とされるのか。"},{"ref":"Job.13.25","start":18013025,"end":18013025,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"ふ"],[6,1,"まわ"],[10,1,"こ"],[12,1,"は"],[18,1,"ひ"],[28,1,"お"]],"text":"あなたは吹き回される木の葉をおどし、干あがったもみがらを追われるのか。"},{"ref":"Job.13.26","start":18013026,"end":18013026,"break":"line","breaks":[[23,"line"]],"ruby":[[11,1,"にが"],[13,1,"こと"],[17,1,"か"],[27,1,"わか"],[29,1,"とき"],[31,1,"つみ"],[33,1,"つ"]],"text":"あなたはわたしについて苦き事どもを書きしるし、わたしに若い時の罪を継がせ、"},{"ref":"Job.13.27","start":18013027,"end":18013027,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[4,1,"あし"],[6,1,"あし"],[21,1,"みち"],[32,1,"あし"],[34,2,"しゅうい"],[37,1,"かぎ"]],"text":"わたしの足を足かせにはめ、わたしのすべての道をうかがい、わたしの足の周囲に限りをつけられる。"},{"ref":"Job.13.28","start":18013028,"end":18013028,"break":"line","breaks":[[20,"line"]],"ruby":[[5,1,"ひと"],[7,1,"くさ"],[10,1,"もの"],[15,1,"く"],[17,1,"は"],[20,1,"むし"],[22,1,"く"],[26,2,"いふく"]],"text":"このような人は腐れた物のように朽ち果て、虫に食われた衣服のようにすたれる。"}]