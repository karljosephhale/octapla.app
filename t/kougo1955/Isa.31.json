[{"ref":"Isa.31.1","start":23031001,"end":23031001,"break":"paragraph","breaks":[[16,"line"],[29,"line"],[47,"line"],[67,"line"],[83,"line"]],"ruby":[[0,1,"たす"],[3,1,"え"],[13,1,"くだ"],[16,1,"うま"],[21,1,"もの"],[29,1,"かれ"],[32,2,"せんしゃ"],[35,1,"おお"],[43,2,"しんらい"],[47,2,"きへい"],[54,1,"つよ"],[62,2,"しんらい"],[76,2,"せいじゃ"],[79,1,"あお"],[85,1,"しゅ"]],"text":"助けを得るためにエジプトに下り、馬にたよる者はわざわいだ。彼らは戦車が多いので、これに信頼し、騎兵がはなはだ強いので、これに信頼する。しかしイスラエルの聖者を仰がず、また主にはかることをしない。"},{"ref":"Isa.31.2","start":23031002,"end":23031002,"break":"line","breaks":[[22,"line"],[44,"line"],[58,"line"]],"ruby":[[10,1,"しゅ"],[14,1,"かしこ"],[22,1,"かなら"],[24,1,"わざわい"],[32,2,"ことば"],[35,1,"と"],[37,1,"け"],[44,1,"た"],[47,1,"あく"],[51,1,"もの"],[53,1,"いえ"],[55,1,"せ"],[60,2,"ふぎ"],[63,1,"おこな"],[65,1,"もの"],[67,1,"たす"],[70,1,"もの"],[72,1,"せ"]],"text":"それにもかかわらず、主もまた賢くいらせられ、必ず災をくだし、その言葉を取り消すことなく、立って悪をなす者の家を攻め、また不義を行う者を助ける者を攻められる。"},{"ref":"Isa.31.3","start":23031003,"end":23031003,"break":"line","breaks":[[21,"line"],[37,"line"],[50,"line"],[60,"line"]],"ruby":[[9,1,"ひと"],[15,1,"かみ"],[23,1,"うま"],[25,1,"にく"],[31,1,"れい"],[37,1,"しゅ"],[40,1,"て"],[42,1,"の"],[50,1,"たす"],[53,1,"もの"],[60,1,"たす"],[65,1,"もの"],[67,1,"たお"],[71,1,"みな"],[75,1,"ほろ"]],"text":"かのエジプトびとは人であって、神ではない。その馬は肉であって、霊ではない。主がみ手を伸ばされるとき、助ける者はつまずき、助けられる者も倒れて、皆ともに滅びる。"},{"ref":"Isa.31.4","start":23031004,"end":23031004,"break":"paragraph","breaks":[[13,"line"],[32,"line"],[40,"line"],[63,"line"],[74,"line"],[90,"line"],[101,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"い"],[19,1,"わか"],[24,2,"えもの"],[44,2,"ひつじかい"],[47,1,"よ"],[49,1,"だ"],[65,1,"こえ"],[70,1,"おどろ"],[76,1,"さけ"],[82,1,"おそ"],[90,2,"ばんぐん"],[93,1,"しゅ"],[95,1,"くだ"],[105,1,"やま"],[111,1,"おか"],[113,1,"たたか"]],"text":"主はわたしにこう言われた、「ししまたは若いししが獲物をつかんで、ほえたけるとき、あまたの羊飼が呼び出されて、これにむかっても、その声によって驚かず、その叫びによって恐れないように、万軍の主は下ってきて、シオンの山およびその丘で戦われる。"},{"ref":"Isa.31.5","start":23031005,"end":23031005,"break":"line","breaks":[[11,"line"],[25,"line"]],"ruby":[[0,1,"とり"],[5,1,"まも"],[11,2,"ばんぐん"],[14,1,"しゅ"],[22,1,"まも"],[28,1,"まも"],[31,1,"すく"],[37,1,"お"],[41,1,"たす"]],"text":"鳥がひなを守るように、万軍の主はエルサレムを守り、これを守って救い、これを惜しんで助けられる」。"},{"ref":"Isa.31.6","start":23031006,"end":23031006,"break":"paragraph","ruby":[[6,2,"ひとびと"],[10,1,"しゅ"],[12,1,"かえ"],[28,1,"しゅ"]],"text":"イスラエルの人々よ、主に帰れ。あなたがたは、はなはだしく主にそむいた。"},{"ref":"Isa.31.7","start":23031007,"end":23031007,"break":"none","ruby":[[2,1,"ひ"],[10,2,"じぶん"],[13,1,"て"],[15,1,"つく"],[18,1,"つみ"],[20,1,"おか"],[28,2,"ぐうぞう"],[36,2,"ぐうぞう"],[43,1,"な"]],"text":"その日、あなたがたは自分の手で造って罪を犯したしろがねの偶像と、こがねの偶像をめいめい投げすてる。"},{"ref":"Isa.31.8","start":23031008,"end":23031008,"break":"stanza","breaks":[[20,"line"],[30,"line"],[41,"line"],[51,"line"],[66,"line"]],"ruby":[[16,1,"たお"],[20,1,"ひと"],[34,1,"かれ"],[37,1,"ほろ"],[41,1,"ひと"],[51,1,"かれ"],[58,1,"まえ"],[61,1,"に"],[63,1,"さ"],[68,1,"わか"],[70,1,"もの"],[72,2,"どれい"],[75,1,"はたら"]],"text":"「アッスリヤびとはつるぎによって倒れる、人のつるぎではない。つるぎが彼らを滅ぼす、人のつるぎではない。彼らはつるぎの前から逃げ去り、その若い者は奴隷の働きをしいられる。"},{"ref":"Isa.31.9","start":23031009,"end":23031009,"break":"line","breaks":[[16,"line"],[37,"line"],[48,"line"]],"ruby":[[0,1,"かれ"],[3,1,"いわ"],[5,1,"おそ"],[11,1,"す"],[13,1,"さ"],[18,1,"きみ"],[26,1,"はた"],[31,1,"に"],[33,1,"さ"],[40,1,"しゅ"],[42,2,"ことば"],[48,1,"しゅ"],[50,1,"ひ"],[61,1,"ろ"]],"text":"彼らの岩は恐れによって過ぎ去り、その君たちはあわて、旗をすてて逃げ去る」。これは主の言葉である。主の火はシオンにあり、その炉はエルサレムにある。"}]