[{"ref":"Ezek.41.1","start":26041001,"end":26041001,"break":"paragraph","ruby":[[0,1,"かれ"],[6,2,"はいでん"],[9,1,"つ"],[12,1,"い"],[16,1,"わき"],[17,1,"ばしら"],[19,1,"はか"],[27,1,"はば"],[39,1,"はば"]],"text":"彼がわたしを拝殿に連れて行って、脇柱を測ると、こなたの幅も六キュビト、かなたの幅も六キュビトあった。"},{"ref":"Ezek.41.2","start":26041002,"end":26041002,"break":"none","ruby":[[2,1,"と"],[4,1,"はば"],[12,1,"と"],[17,1,"かべ"],[43,1,"かれ"],[47,2,"はいでん"],[50,1,"なが"],[53,1,"はか"],[65,1,"はば"]],"text":"その戸の幅は十キュビト、戸のわきの壁は、こなたも五キュビト、かなたも五キュビトあった。彼はまた拝殿の長さを測ると四十キュビト、その幅は二十キュビトあった。"},{"ref":"Ezek.41.3","start":26041003,"end":26041003,"break":"none","ruby":[[0,1,"かれ"],[4,1,"うち"],[11,1,"と"],[13,1,"わき"],[14,1,"ばしら"],[16,1,"はか"],[31,1,"と"],[33,1,"はば"],[41,1,"と"],[46,1,"かべ"]],"text":"彼がまた内にはいって、戸の脇柱を測ると、それは二キュビトあり、戸の幅は六キュビト、戸のわきの壁は七キュビトあった。"},{"ref":"Ezek.41.4","start":26041004,"end":26041004,"break":"none","ruby":[[0,1,"かれ"],[4,2,"はいでん"],[7,1,"おく"],[9,1,"しつ"],[11,1,"なが"],[14,1,"はか"],[24,1,"はば"],[39,1,"かれ"],[49,3,"しせいじょ"],[56,1,"い"]],"text":"彼はまた拝殿の奥の室の長さを測ると二十キュビト、幅も二十キュビトあった。そして彼はわたしに、これは至聖所であると言った。"},{"ref":"Ezek.41.5","start":26041005,"end":26041005,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"みや"],[4,1,"かべ"],[6,1,"はか"],[12,1,"あつ"],[23,1,"みや"],[25,2,"しゅうい"],[28,2,"わきま"],[31,1,"ひろ"],[35,2,"しほう"]],"text":"彼が宮の壁を測ると、その厚さは六キュビトあり、宮の周囲の脇間の広さは、四方おのおの四キュビトあり、"},{"ref":"Ezek.41.6","start":26041006,"end":26041006,"break":"none","ruby":[[0,2,"わきま"],[4,1,"しつ"],[6,1,"うえ"],[8,1,"しつ"],[14,1,"かい"],[19,2,"かくかい"],[25,1,"しつ"],[30,1,"みや"],[32,2,"しゅうい"],[35,1,"かべ"],[39,2,"わきま"],[46,2,"とっき"],[56,2,"わきま"],[60,1,"みや"],[62,1,"かべ"]],"text":"脇間は、室の上に室があって三階になり、各階に三十の室がある。宮の周囲の壁には、脇間をささえる突起があった。これは脇間が、宮の壁そのものによってささえられないためである。"},{"ref":"Ezek.41.7","start":26041007,"end":26041007,"break":"none","ruby":[[0,2,"わきま"],[4,1,"みや"],[6,2,"しゅうい"],[9,2,"かくかい"],[14,2,"とっき"],[21,1,"かい"],[23,1,"かさ"],[26,1,"うえ"],[36,1,"ひろ"],[41,1,"みや"],[43,2,"がいぶ"],[46,2,"かいだん"],[49,1,"うえ"],[51,1,"つう"],[55,1,"かい"],[59,1,"かい"],[64,1,"かい"],[70,1,"のぼ"]],"text":"脇間は、宮の周囲の各階にある突起につれて、階を重ねて上にいくにしたがって広くなり、宮の外部の階段が上に通じ、一階から三階へは、二階をとおって上るのである。"},{"ref":"Ezek.41.8","start":26041008,"end":26041008,"break":"none","ruby":[[6,1,"みや"],[8,2,"しゅうい"],[11,1,"たか"],[13,1,"ところ"],[19,1,"み"],[22,2,"わきま"],[25,1,"もとい"],[27,1,"はか"]],"text":"わたしはまた宮の周囲に高い所のあるのを見た。脇間の基を測ると、六キュビトの一さおあった。"},{"ref":"Ezek.41.9","start":26041009,"end":26041009,"break":"none","ruby":[[0,2,"わきま"],[3,1,"そと"],[5,1,"かべ"],[7,1,"あつ"],[18,1,"ち"],[25,1,"たか"],[27,1,"ところ"],[38,1,"みや"],[40,1,"たか"],[42,1,"ところ"]],"text":"脇間の外の壁の厚さは五キュビト、あき地になっている高い所は五キュビトあった。宮の高い所と、"},{"ref":"Ezek.41.10","start":26041010,"end":26041010,"break":"none","ruby":[[0,1,"にわ"],[2,1,"しつ"],[4,1,"あいだ"],[8,1,"みや"],[10,2,"しゅうい"],[14,1,"ひろ"],[23,1,"ところ"]],"text":"庭の室の間には、宮の周囲に、広さ二十キュビトの所があった。"},{"ref":"Ezek.41.11","start":26041011,"end":26041011,"break":"none","ruby":[[0,2,"わきま"],[3,1,"と"],[8,1,"ち"],[15,1,"たか"],[17,1,"ところ"],[19,1,"む"],[23,1,"ひら"],[29,1,"と"],[31,1,"きた"],[33,1,"む"],[40,1,"と"],[42,1,"みなみ"],[44,1,"む"],[55,1,"ち"],[62,1,"ところ"],[64,1,"はば"],[67,2,"しゅうい"]],"text":"脇間の戸は、あき地になっている高い所に向かって開け、一つの戸は北に向かい、一つの戸は南に向かっていた。そのあき地になっている所の幅は、周囲五キュビトであった。"},{"ref":"Ezek.41.12","start":26041012,"end":26041012,"break":"paragraph","ruby":[[0,1,"にし"],[2,1,"ほう"],[4,1,"みや"],[6,1,"にわ"],[8,1,"めん"],[11,2,"たてもの"],[15,1,"はば"],[25,2,"たてもの"],[28,2,"しゅうい"],[31,1,"かべ"],[33,1,"あつ"],[42,1,"なが"]],"text":"西の方の宮の庭に面した建物は、幅七十キュビト、その建物の周囲の壁の厚さは五キュビト、長さは九十キュビトであった。"},{"ref":"Ezek.41.13","start":26041013,"end":26041013,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"みや"],[4,1,"はか"],[10,1,"なが"],[23,1,"にわ"],[25,2,"たてもの"],[31,1,"かべ"],[33,1,"なが"]],"text":"彼が宮を測ると、その長さは百キュビトあり、その庭と建物と、その壁は長さ百キュビト、"},{"ref":"Ezek.41.14","start":26041014,"end":26041014,"break":"none","ruby":[[2,1,"みや"],[4,1,"ひがし"],[6,1,"めん"],[9,1,"ところ"],[11,1,"にわ"],[14,1,"はば"]],"text":"また宮の東に面した所と庭との幅は百キュビトであった。"},{"ref":"Ezek.41.15","start":26041015,"end":26041015,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"にし"],[4,1,"ほう"],[6,1,"にわ"],[8,1,"めん"],[11,2,"たてもの"],[17,1,"かべ"],[19,1,"なが"],[22,1,"はか"],[46,1,"みや"],[48,2,"はいでん"],[52,2,"ないぶ"],[55,1,"しつ"],[58,1,"そと"],[60,1,"ろう"],[65,3,"はめいた"]],"text":"彼が西の方の庭に面した建物と、その壁の長さを測ると、かなた、こなたともに百キュビトであった。宮の拝殿と、内部の室と、外の廊とには、羽目板があった。"},{"ref":"Ezek.41.16","start":26041016,"end":26041016,"break":"none","ruby":[[10,2,"しゅうい"],[18,2,"ひっこ"],[21,1,"わく"],[23,1,"まど"],[28,1,"みや"],[30,2,"しきい"],[33,1,"めん"],[37,1,"みや"],[39,2,"しゅうい"],[43,1,"ゆか"],[46,1,"まど"],[50,3,"はめいた"],[58,1,"まど"]],"text":"これらの三つのものの周囲には、すべて引込み枠の窓があり、宮の敷居に面して、宮の周囲は、床から窓まで、羽目板であって、窓には、おおいがあった。"},{"ref":"Ezek.41.17","start":26041017,"end":26041017,"break":"none","ruby":[[0,1,"と"],[2,1,"うわ"],[4,1,"そら"],[5,1,"ところ"],[7,2,"ないしつ"],[10,1,"そと"],[11,1,"しつ"],[16,3,"はめいた"],[24,2,"ないしつ"],[29,2,"はいでん"],[32,2,"しゅうい"],[39,1,"かべ"],[43,1,"おな"],[48,2,"ちょうこく"]],"text":"戸の上の空所、内室、外室ともに、羽目板であった。内室および拝殿の周囲のすべての壁には、同じように彫刻してあった。"},{"ref":"Ezek.41.18","start":26041018,"end":26041018,"break":"none","ruby":[[15,2,"ちょうこく"],[32,1,"あいだ"],[56,1,"かお"]],"text":"すなわちケルビムと、しゅろとが彫刻してあった。ケルブとケルブとの間に、しゅろがあり、おのおののケルブには、二つの顔があり、"},{"ref":"Ezek.41.19","start":26041019,"end":26041019,"break":"none","ruby":[[10,1,"む"],[15,1,"ひと"],[17,1,"かお"],[32,1,"む"],[37,1,"わか"],[41,1,"かお"],[46,1,"みや"],[48,2,"しゅうい"],[60,2,"ちょうこく"]],"text":"こなたには、しゅろに向かって、人の顔があり、かなたには、しゅろに向かって、若じしの顔があり、宮の周囲は、すべてこのように彫刻してあった。"},{"ref":"Ezek.41.20","start":26041020,"end":26041020,"break":"none","ruby":[[0,1,"ゆか"],[3,1,"と"],[5,1,"うえ"],[21,1,"かべ"],[23,2,"ちょうこく"]],"text":"床から戸の上まで、ケルビムと、しゅろとが、壁に彫刻してあった。"},{"ref":"Ezek.41.21","start":26041021,"end":26041021,"break":"paragraph","ruby":[[0,2,"はいでん"],[3,1,"ばしら"],[6,1,"かく"],[12,2,"せいじょ"],[15,1,"まえ"],[19,1,"き"],[21,2,"さいだん"],[24,1,"に"]],"text":"拝殿の柱は四角であった。聖所の前には、木の祭壇に似たものがあった。"},{"ref":"Ezek.41.22","start":26041022,"end":26041022,"break":"none","ruby":[[2,1,"たか"],[11,1,"なが"],[20,1,"はば"],[33,1,"だい"],[36,1,"かべ"],[43,1,"き"],[48,1,"かれ"],[54,1,"い"],[62,1,"しゅ"],[64,1,"まえ"],[68,1,"つくえ"]],"text":"その高さは三キュビト、長さは二キュビト、幅は二キュビトで、すみと、台と、壁とは、ともに木である。彼はわたしに言った、「これは主の前にある机である」"},{"ref":"Ezek.41.23","start":26041023,"end":26041023,"break":"none","ruby":[[0,2,"はいでん"],[3,2,"せいじょ"],[12,1,"と"]],"text":"拝殿と聖所とには、二つの戸があり、"},{"ref":"Ezek.41.24","start":26041024,"end":26041024,"break":"none","ruby":[[2,1,"と"],[24,1,"ひら"],[26,1,"ど"]],"text":"その戸には、二つのとびらがあった。すなわち二つの開き戸である。"},{"ref":"Ezek.41.25","start":26041025,"end":26041025,"break":"none","ruby":[[0,2,"はいでん"],[3,1,"と"],[24,2,"ちょうこく"],[35,1,"かべ"],[37,2,"ちょうこく"],[44,1,"おな"],[52,1,"そと"],[54,1,"ろう"],[56,1,"めん"],[60,1,"き"],[62,2,"てんがい"]],"text":"拝殿の戸には、おのおのにケルビムと、しゅろとが、彫刻してあって、それは壁に彫刻したものと同じである。また外の廊に面して、木の天蓋があり、"},{"ref":"Ezek.41.26","start":26041026,"end":26041026,"break":"none","ruby":[[0,1,"ろう"],[2,1,"かべ"],[13,2,"ひっこ"],[16,1,"まど"]],"text":"廊の壁には、こなたかなたに引込み窓と、しゅろとがあった。"}]