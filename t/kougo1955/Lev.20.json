[{"ref":"Lev.20.1","start":3020001,"end":3020001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.20.2","start":3020002,"end":3020002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[23,2,"ひとびと"],[40,2,"きりゅう"],[44,2,"たこく"],[46,1,"じん"],[57,1,"こ"],[58,1,"とも"],[68,1,"もの"],[71,1,"かなら"],[73,1,"ころ"],[90,1,"くに"],[92,1,"たみ"],[94,1,"かれ"],[96,1,"いし"],[98,1,"う"]],"text":"「イスラエルの人々に言いなさい、『イスラエルの人々のうち、またイスラエルのうちに寄留する他国人のうち、だれでもその子供をモレクにささげる者は、必ず殺されなければならない。すなわち、国の民は彼を石で撃たなければならない。"},{"ref":"Lev.20.3","start":3020003,"end":3020003,"break":"none","ruby":[[4,1,"かお"],[8,1,"ひと"],[10,1,"む"],[13,1,"かれ"],[15,1,"たみ"],[21,1,"た"],[28,1,"かれ"],[32,1,"こ"],[33,1,"とも"],[47,2,"せいじょ"],[50,1,"けが"],[59,1,"せい"],[62,1,"な"],[64,1,"けが"]],"text":"わたしは顔をその人に向け、彼を民のうちから断つであろう。彼がその子供をモレクにささげてわたしの聖所を汚し、またわたしの聖なる名を汚したからである。"},{"ref":"Lev.20.4","start":3020004,"end":3020004,"break":"none","ruby":[[2,1,"ひと"],[4,2,"こども"],[18,1,"くに"],[20,1,"たみ"],[32,1,"こと"],[34,1,"め"],[43,1,"ころ"]],"text":"その人が子供をモレクにささげるとき、国の民がもしことさらに、この事に目をおおい、これを殺さないならば、"},{"ref":"Lev.20.5","start":3020005,"end":3020005,"break":"none","ruby":[[3,2,"じしん"],[6,1,"かお"],[10,1,"ひと"],[14,2,"かぞく"],[18,1,"む"],[21,1,"かれ"],[25,1,"かれ"],[27,1,"み"],[36,1,"した"],[42,2,"かんいん"],[46,1,"もの"],[52,1,"たみ"],[58,1,"た"]],"text":"わたし自身、顔をその人とその家族とに向け、彼および彼に見ならってモレクを慕い、これと姦淫する者を、すべて民のうちから断つであろう。"},{"ref":"Lev.20.6","start":3020006,"end":3020006,"break":"paragraph","ruby":[[2,2,"くちよ"],[9,1,"うらな"],[11,1,"し"],[21,1,"かれ"],[24,1,"した"],[27,2,"かんいん"],[31,1,"もの"],[41,1,"かお"],[45,1,"ひと"],[47,1,"む"],[53,1,"たみ"],[59,1,"た"]],"text":"もし口寄せ、または占い師のもとにおもむき、彼らを慕って姦淫する者があれば、わたしは顔をその人に向け、これを民のうちから断つであろう。"},{"ref":"Lev.20.7","start":3020007,"end":3020007,"break":"none","ruby":[[15,2,"せいべつ"],[19,1,"せい"],[22,1,"もの"],[45,1,"かみ"],[47,1,"しゅ"]],"text":"ゆえにあなたがたは、みずからを聖別し、聖なる者とならなければならない。わたしはあなたがたの神、主である。"},{"ref":"Lev.20.8","start":3020008,"end":3020008,"break":"none","ruby":[[10,1,"さだ"],[13,1,"まも"],[20,1,"おこな"],[41,2,"せいべつ"],[45,1,"しゅ"]],"text":"あなたがたはわたしの定めを守って、これを行わなければならない。わたしはあなたがたを聖別する主である。"},{"ref":"Lev.20.9","start":3020009,"end":3020009,"break":"none","ruby":[[4,1,"ちち"],[8,1,"はは"],[13,1,"もの"],[16,1,"かなら"],[18,1,"ころ"],[30,1,"かれ"],[32,1,"ちち"],[36,1,"はは"],[47,1,"ち"],[49,1,"かれ"],[51,1,"き"]],"text":"だれでも父または母をのろう者は、必ず殺されなければならない。彼が父または母をのろったので、その血は彼に帰するであろう。"},{"ref":"Lev.20.10","start":3020010,"end":3020010,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"つま"],[4,2,"かんいん"],[8,1,"もの"],[14,2,"りんじん"],[17,1,"つま"],[19,2,"かんいん"],[23,1,"もの"],[31,2,"かんぷ"],[34,2,"かんぷ"],[37,1,"とも"],[39,1,"かなら"],[41,1,"ころ"]],"text":"人の妻と姦淫する者、すなわち隣人の妻と姦淫する者があれば、その姦夫、姦婦は共に必ず殺されなければならない。"},{"ref":"Lev.20.11","start":3020011,"end":3020011,"break":"none","ruby":[[2,1,"ちち"],[4,1,"つま"],[6,1,"ね"],[8,1,"もの"],[13,1,"ちち"],[21,1,"もの"],[26,1,"かれ"],[34,1,"かなら"],[36,1,"ころ"],[50,1,"ち"],[52,1,"かれ"],[55,1,"き"]],"text":"その父の妻と寝る者は、その父をはずかしめる者である。彼らはふたりとも必ず殺されなければならない。その血は彼らに帰するであろう。"},{"ref":"Lev.20.12","start":3020012,"end":3020012,"break":"none","ruby":[[0,1,"こ"],[2,1,"つま"],[4,1,"ね"],[6,1,"もの"],[12,1,"とも"],[14,1,"かなら"],[16,1,"ころ"],[28,1,"かれ"],[31,1,"みち"],[45,1,"ち"],[47,1,"かれ"],[50,1,"き"]],"text":"子の妻と寝る者は、ふたり共に必ず殺されなければならない。彼らは道ならぬことをしたので、その血は彼らに帰するであろう。"},{"ref":"Lev.20.13","start":3020013,"end":3020013,"break":"none","ruby":[[0,1,"おんな"],[2,1,"ね"],[7,1,"おとこ"],[9,1,"ね"],[11,1,"もの"],[19,1,"にく"],[23,1,"こと"],[30,1,"かなら"],[32,1,"ころ"],[46,1,"ち"],[48,1,"かれ"],[51,1,"き"]],"text":"女と寝るように男と寝る者は、ふたりとも憎むべき事をしたので、必ず殺されなければならない。その血は彼らに帰するであろう。"},{"ref":"Lev.20.14","start":3020014,"end":3020014,"break":"none","ruby":[[0,1,"おんな"],[4,1,"はは"],[6,2,"いっしょ"],[19,2,"あくじ"],[26,1,"かれ"],[29,1,"おんな"],[33,1,"ひ"],[35,1,"や"],[52,2,"あくじ"]],"text":"女をその母と一緒にめとるならば、これは悪事であって、彼も、女たちも火に焼かれなければならない。このような悪事をあなたがたのうちになくするためである。"},{"ref":"Lev.20.15","start":3020015,"end":3020015,"break":"none","ruby":[[0,1,"おとこ"],[5,1,"けもの"],[7,1,"ね"],[12,1,"かれ"],[14,1,"かなら"],[16,1,"ころ"],[39,1,"けもの"],[41,1,"ころ"]],"text":"男がもし、獣と寝るならば彼は必ず殺されなければならない。あなたがたはまた、その獣を殺さなければならない。"},{"ref":"Lev.20.16","start":3020016,"end":3020016,"break":"none","ruby":[[0,1,"おんな"],[5,1,"けもの"],[7,1,"ちか"],[15,1,"ね"],[28,1,"おんな"],[30,1,"けもの"],[33,1,"ころ"],[44,1,"かれ"],[47,1,"かなら"],[49,1,"ころ"],[60,1,"ち"],[62,1,"かれ"],[65,1,"き"]],"text":"女がもし、獣に近づいて、これと寝るならば、あなたは、その女と獣とを殺さなければならない。彼らは必ず殺さるべきである。その血は彼らに帰するであろう。"},{"ref":"Lev.20.17","start":3020017,"end":3020017,"break":"paragraph","ruby":[[0,1,"ひと"],[7,2,"しまい"],[14,1,"ちち"],[16,1,"むすめ"],[22,1,"はは"],[24,1,"むすめ"],[26,1,"ちか"],[33,2,"しまい"],[39,1,"み"],[41,1,"おんな"],[45,2,"きょうだい"],[51,1,"み"],[60,1,"は"],[64,1,"こと"],[69,1,"かれ"],[75,1,"たみ"],[77,2,"ひとびと"],[80,1,"め"],[82,1,"まえ"],[85,1,"た"],[97,1,"かれ"],[102,2,"しまい"],[105,1,"おか"],[117,1,"つみ"],[119,1,"お"]],"text":"人がもし、その姉妹、すなわち父の娘、あるいは母の娘に近づいて、その姉妹のはだを見、女はその兄弟のはだを見るならば、これは恥ずべき事である。彼らは、その民の人々の目の前で、断たれなければならない。彼は、その姉妹を犯したのであるから、その罪を負わなければならない。"},{"ref":"Lev.20.18","start":3020018,"end":3020018,"break":"none","ruby":[[0,1,"ひと"],[5,1,"つき"],[13,1,"おんな"],[15,1,"ね"],[23,1,"あらわ"],[29,1,"おとこ"],[31,1,"おんな"],[33,1,"みなもと"],[35,1,"あらわ"],[38,1,"おんな"],[40,2,"じぶん"],[43,1,"ち"],[45,1,"みなもと"],[47,1,"あらわ"],[60,1,"とも"],[64,1,"たみ"],[70,1,"た"]],"text":"人がもし、月のさわりのある女と寝て、そのはだを現すならば、男は女の源を現し、女は自分の血の源を現したのであるから、ふたり共にその民のうちから断たれなければならない。"},{"ref":"Lev.20.19","start":3020019,"end":3020019,"break":"none","ruby":[[4,1,"はは"],[6,2,"しまい"],[16,1,"ちち"],[18,2,"しまい"],[21,1,"おか"],[34,2,"じぶん"],[37,2,"にくしん"],[40,1,"もの"],[42,1,"おか"],[52,1,"かれ"],[57,1,"つみ"],[59,1,"お"]],"text":"あなたの母の姉妹、またはあなたの父の姉妹を犯してはならない。これは、自分の肉親の者を犯すことであるから、彼らはその罪を負わなければならない。"},{"ref":"Lev.20.20","start":3020020,"end":3020020,"break":"none","ruby":[[0,1,"ひと"],[10,1,"ね"],[36,1,"かれ"],[41,1,"つみ"],[43,1,"お"],[46,1,"こ"],[51,1,"し"]],"text":"人がもし、そのおばと寝るならば、これはおじをはずかしめることであるから、彼らはその罪を負い、子なくして死ぬであろう。"},{"ref":"Lev.20.21","start":3020021,"end":3020021,"break":"none","ruby":[[0,1,"ひと"],[7,2,"きょうだい"],[10,1,"つま"],[12,1,"と"],[21,1,"けが"],[32,1,"かれ"],[36,2,"きょうだい"],[52,1,"かれ"],[55,1,"こ"],[58,1,"もの"]],"text":"人がもし、その兄弟の妻を取るならば、これは汚らわしいことである。彼はその兄弟をはずかしめたのであるから、彼らは子なき者となるであろう。"},{"ref":"Lev.20.22","start":3020022,"end":3020022,"break":"paragraph","ruby":[[10,1,"さだ"],[23,1,"まも"],[30,1,"おこな"],[57,1,"す"],[64,1,"みちび"],[67,1,"い"],[69,1,"ち"],[78,1,"は"],[80,1,"だ"]],"text":"あなたがたはわたしの定めとおきてとをことごとく守って、これを行わなければならない。そうすれば、わたしがあなたがたを住まわせようと導いて行く地は、あなたがたを吐き出さぬであろう。"},{"ref":"Lev.20.23","start":3020023,"end":3020023,"break":"none","ruby":[[6,1,"まえ"],[13,1,"お"],[15,1,"はら"],[17,1,"くに"],[21,2,"ふうしゅう"],[31,1,"あゆ"],[40,1,"かれ"],[63,1,"かれ"],[66,1,"にく"]],"text":"あなたがたの前からわたしが追い払う国びとの風習に、あなたがたは歩んではならない。彼らは、このもろもろのことをしたから、わたしは彼らを憎むのである。"},{"ref":"Lev.20.24","start":3020024,"end":3020024,"break":"none","ruby":[[10,1,"い"],[22,1,"かれ"],[25,1,"ち"],[27,1,"え"],[47,1,"あた"],[54,1,"え"],[66,1,"ちち"],[68,1,"みつ"],[71,1,"なが"],[74,1,"ち"],[90,1,"た"],[92,1,"たみ"],[95,2,"くべつ"],[105,1,"かみ"],[107,1,"しゅ"]],"text":"わたしはあなたがたに言った、「あなたがたは、彼らの地を獲るであろう。わたしはこれをあなたがたに与えて、これを獲させるであろう。これは乳と蜜との流れる地である」。わたしはあなたがたを他の民から区別したあなたがたの神、主である。"},{"ref":"Lev.20.25","start":3020025,"end":3020025,"break":"none","ruby":[[6,1,"きよ"],[8,1,"けもの"],[10,1,"けが"],[13,1,"けもの"],[15,1,"けが"],[18,1,"とり"],[20,1,"きよ"],[22,1,"とり"],[24,2,"くべつ"],[49,1,"けが"],[57,2,"くべつ"],[61,1,"けもの"],[66,1,"とり"],[73,1,"ち"],[75,1,"は"],[90,1,"み"],[92,1,"い"]],"text":"あなたがたは清い獣と汚れた獣、汚れた鳥と清い鳥を区別しなければならない。わたしがあなたがたのために汚れたものとして区別した獣、または鳥またはすべて地を這うものによって、あなたがたの身を忌むべきものとしてはならない。"},{"ref":"Lev.20.26","start":3020026,"end":3020026,"break":"none","ruby":[[10,1,"たい"],[13,1,"せい"],[16,1,"もの"],[27,1,"しゅ"],[34,1,"せい"],[37,1,"もの"],[58,1,"た"],[60,1,"たみ"],[63,2,"くべつ"]],"text":"あなたがたはわたしに対して聖なる者でなければならない。主なるわたしは聖なる者で、あなたがたをわたしのものにしようと、他の民から区別したからである。"},{"ref":"Lev.20.27","start":3020027,"end":3020027,"break":"paragraph","ruby":[[0,1,"おとこ"],[4,1,"おんな"],[7,2,"くちよ"],[14,1,"うらな"],[19,1,"もの"],[22,1,"かなら"],[24,1,"ころ"],[41,1,"いし"],[43,1,"う"],[45,1,"ころ"],[58,1,"ち"],[60,1,"かれ"],[63,1,"き"]],"text":"男または女で、口寄せ、または占いをする者は、必ず殺されなければならない。すなわち、石で撃ち殺さなければならない。その血は彼らに帰するであろう』」。"}]