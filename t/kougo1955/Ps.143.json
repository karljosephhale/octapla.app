[{"ref":"Ps.143.1","start":19143001,"end":19143001,"break":"paragraph","title":"ダビデの歌","breaks":[[10,"line"],[25,"line"],[45,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"いのり"],[7,1,"き"],[12,1,"ねが"],[15,1,"みみ"],[17,1,"かたむ"],[29,2,"しんじつ"],[37,2,"せいぎ"],[50,1,"こた"]],"titleRuby":[[4,1,"うた"]],"text":"主よ、わが祈を聞き、わが願いに耳を傾けてください。あなたの真実と、あなたの正義とをもって、わたしにお答えください。"},{"ref":"Ps.143.2","start":19143002,"end":19143002,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[25,1,"い"],[28,1,"もの"],[35,1,"まえ"],[37,1,"ぎ"]],"text":"あなたのしもべのさばきにたずさわらないでください。生ける者はひとりもみ前に義とされないからです。"},{"ref":"Ps.143.3","start":19143003,"end":19143003,"break":"line","breaks":[[9,"line"],[23,"line"],[38,"line"]],"ruby":[[0,1,"てき"],[15,1,"ち"],[17,1,"ふ"],[23,1,"し"],[26,1,"ひさ"],[29,1,"とき"],[31,1,"へ"],[33,1,"もの"],[42,1,"くら"],[44,1,"ところ"],[46,1,"す"]],"text":"敵はわたしをせめ、わがいのちを地に踏みにじり、死んで久しく時を経た者のようにわたしを暗い所に住まわせました。"},{"ref":"Ps.143.4","start":19143004,"end":19143004,"break":"line","breaks":[[23,"line"]],"ruby":[[7,1,"れい"],[14,1,"き"],[25,1,"こころ"],[32,1,"あ"]],"text":"それゆえ、わが霊はわがうちに消えうせようとし、わが心はわがうちに荒れさびれています。"},{"ref":"Ps.143.5","start":19143005,"end":19143005,"break":"line","breaks":[[16,"line"],[33,"line"]],"ruby":[[9,1,"ひ"],[11,1,"おも"],[13,1,"だ"],[20,1,"おこな"],[28,1,"こと"],[30,1,"かんが"],[38,1,"て"],[43,1,"おも"]],"text":"わたしはいにしえの日を思い出し、あなたが行われたすべての事を考え、あなたのみ手のわざを思います。"},{"ref":"Ps.143.6","start":19143006,"end":19143006,"break":"line","breaks":[[17,"line"],[33,"line"]],"ruby":[[12,1,"て"],[14,1,"の"],[19,1,"たましい"],[28,1,"ち"],[37,1,"した"]],"text":"わたしはあなたにむかって手を伸べ、わが魂は、かわききった地のようにあなたを慕います。〔セラ"},{"ref":"Ps.143.7","start":19143007,"end":19143007,"break":"line","breaks":[[20,"line"],[29,"line"],[46,"line"],[66,"line"]],"ruby":[[0,1,"しゅ"],[13,1,"こた"],[22,1,"れい"],[24,1,"おとろ"],[34,1,"かお"],[36,1,"かく"],[56,1,"あな"],[61,1,"もの"]],"text":"主よ、すみやかにわたしにお答えください。わが霊は衰えます。わたしにみ顔を隠さないでください。さもないと、わたしは穴にくだる者のようになるでしょう。"},{"ref":"Ps.143.8","start":19143008,"end":19143008,"break":"line","breaks":[[24,"line"],[38,"line"],[54,"line"]],"ruby":[[15,1,"き"],[32,2,"しんらい"],[40,1,"あゆ"],[44,1,"みち"],[46,1,"おし"],[56,1,"たましい"],[62,1,"あお"],[64,1,"のぞ"]],"text":"あしたに、あなたのいつくしみを聞かせてください。わたしはあなたに信頼します。わが歩むべき道を教えてください。わが魂はあなたを仰ぎ望みます。"},{"ref":"Ps.143.9","start":19143009,"end":19143009,"break":"line","breaks":[[22,"line"],[35,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"てき"],[12,1,"たす"],[14,1,"だ"],[26,1,"さ"],[28,1,"どころ"],[30,1,"え"]],"text":"主よ、わたしをわが敵から助け出してください。わたしは避け所を得るためにあなたのもとにのがれました。"},{"ref":"Ps.143.10","start":19143010,"end":19143010,"break":"line","breaks":[[21,"line"],[31,"line"],[44,"line"]],"ruby":[[8,1,"おこな"],[13,1,"おし"],[27,1,"かみ"],[31,1,"めぐ"],[48,1,"たい"],[52,1,"みち"],[54,1,"みちび"]],"text":"あなたのみむねを行うことを教えてください。あなたはわが神です。恵みふかい、みたまをもってわたしを平らかな道に導いてください。"},{"ref":"Ps.143.11","start":19143011,"end":19143011,"break":"line","breaks":[[18,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"な"],[14,1,"い"],[22,1,"ぎ"],[32,1,"なや"],[36,1,"すく"],[38,1,"だ"]],"text":"主よ、み名のために、わたしを生かし、あなたの義によって、わたしを悩みから救い出してください。"},{"ref":"Ps.143.12","start":19143012,"end":19143012,"break":"line","breaks":[[24,"line"],[43,"line"]],"ruby":[[19,1,"てき"],[21,1,"た"],[34,1,"ほろ"]],"text":"また、あなたのいつくしみによって、わが敵を断ち、わがあだをことごとく滅ぼしてください。わたしはあなたのしもべです。"}]