[{"ref":"Job.30.1","start":18030001,"end":18030001,"break":"paragraph","breaks":[[17,"line"],[30,"line"],[44,"line"]],"ruby":[[3,1,"いま"],[11,1,"とし"],[12,1,"わか"],[14,1,"もの"],[27,1,"わら"],[30,1,"かれ"],[33,1,"ちち"],[39,1,"いや"],[44,1,"む"],[47,1,"いぬ"],[49,2,"いっしょ"],[59,1,"もの"]],"text":"しかし今はわたしよりも年若い者が、かえってわたしをあざ笑う。彼らの父はわたしが卑しめて、群れの犬と一緒にさえしなかった者だ。"},{"ref":"Job.30.2","start":18030002,"end":18030002,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[3,1,"て"],[5,1,"ちから"],[12,1,"なに"],[14,1,"え"],[22,1,"かれ"],[27,2,"きりょく"],[33,1,"おとろ"],[36,2,"ひとびと"]],"text":"彼らの手の力からわたしは何を得るであろうか、彼らはその気力がすでに衰えた人々だ。"},{"ref":"Job.30.3","start":18030003,"end":18030003,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"とぼ"],[7,1,"はげ"],[10,1,"う"],[22,1,"あ"],[24,1,"ち"]],"text":"彼らは乏しさと激しい飢えとによって、かわいた荒れ地をかむ。"},{"ref":"Job.30.4","start":18030004,"end":18030004,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[12,2,"かんぼく"],[15,1,"は"],[17,1,"つ"],[24,1,"ね"],[29,1,"み"],[31,1,"あたた"]],"text":"彼らは、ぜにあおいおよび灌木の葉を摘み、れだまの根をもって身を暖める。"},{"ref":"Job.30.5","start":18030005,"end":18030005,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,2,"ひとびと"],[6,1,"なか"],[9,1,"お"],[15,1,"ぬす"],[19,1,"お"],[25,2,"ひとびと"],[28,1,"かれ"],[31,1,"お"],[33,1,"よ"]],"text":"彼らは人々の中から追いだされ、盗びとを追うように、人々は彼らを追い呼ばわる。"},{"ref":"Job.30.6","start":18030006,"end":18030006,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[3,2,"きゅうりゅう"],[6,2,"たにま"],[9,1,"す"],[12,1,"つち"],[14,1,"あな"],[18,1,"いわ"],[20,1,"あな"]],"text":"彼らは急流の谷間に住み、土の穴または岩の穴におり、"},{"ref":"Job.30.7","start":18030007,"end":18030007,"break":"line","ruby":[[0,2,"かんぼく"],[3,1,"なか"],[15,1,"した"],[17,1,"お"],[19,1,"あ"]],"text":"灌木の中にいななき、いらくさの下に押し合う。"},{"ref":"Job.30.8","start":18030008,"end":18030008,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おろ"],[6,1,"もの"],[8,1,"こ"],[12,1,"いや"],[15,1,"もの"],[17,1,"こ"],[23,1,"くに"],[26,1,"お"],[32,1,"もの"]],"text":"彼らは愚かな者の子、また卑しい者の子であって、国から追いだされた者だ。"},{"ref":"Job.30.9","start":18030009,"end":18030009,"break":"stanza","breaks":[[19,"line"]],"ruby":[[10,1,"いま"],[11,1,"かれ"],[14,1,"うた"],[19,1,"かれ"],[22,1,"わら"],[24,1,"ぐさ"]],"text":"それなのに、わたしは今彼らの歌となり、彼らの笑い草となった。"},{"ref":"Job.30.10","start":18030010,"end":18030010,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[11,1,"とお"],[25,1,"かお"]],"text":"彼らはわたしをいとい、遠くわたしをはなれ、わたしの顔につばきすることも、ためらわない。"},{"ref":"Job.30.11","start":18030011,"end":18030011,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[0,1,"かみ"],[6,1,"つな"],[8,1,"と"],[16,1,"いや"],[25,1,"かれ"],[32,1,"まえ"],[34,1,"つつし"],[37,1,"す"]],"text":"神がわたしの綱を解いて、わたしを卑しめられたので、彼らもわたしの前に慎みを捨てた。"},{"ref":"Job.30.12","start":18030012,"end":18030012,"break":"line","breaks":[[19,"line"],[28,"line"]],"ruby":[[11,1,"みぎ"],[13,1,"た"],[15,1,"あ"],[23,1,"お"],[36,1,"ほろ"],[39,1,"みち"],[41,1,"きず"]],"text":"このともがらはわたしの右に立ち上がり、わたしを追いのけ、わたしにむかって滅びの道を築く。"},{"ref":"Job.30.13","start":18030013,"end":18030013,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[7,1,"みち"],[17,1,"わざわい"],[19,1,"うなが"],[27,1,"と"],[30,1,"もの"]],"text":"彼らはわたしの道をこわし、わたしの災を促す。これをさし止める者はない。"},{"ref":"Job.30.14","start":18030014,"end":18030014,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ひろ"],[5,1,"やぶ"],[7,1,"くち"],[16,1,"すす"],[22,2,"はかい"],[25,1,"なか"],[29,1,"よ"]],"text":"彼らは広い破れ口からはいるように進みきたり、破壊の中をおし寄せる。"},{"ref":"Job.30.15","start":18030015,"end":18030015,"break":"line","breaks":[[13,"line"],[30,"line"]],"ruby":[[0,1,"おそ"],[4,1,"こと"],[10,1,"のぞ"],[17,1,"ほまれ"],[19,1,"かぜ"],[24,1,"ふ"],[26,1,"はら"],[34,2,"はんえい"],[37,1,"くも"],[42,1,"き"]],"text":"恐ろしい事はわたしに臨み、わたしの誉は風のように吹き払われ、わたしの繁栄は雲のように消えうせた。"},{"ref":"Job.30.16","start":18030016,"end":18030016,"break":"stanza","breaks":[[21,"line"]],"ruby":[[0,1,"いま"],[7,1,"たましい"],[13,1,"うち"],[18,1,"なが"],[21,1,"なや"],[24,1,"ひ"],[30,1,"とら"]],"text":"今は、わたしの魂はわたしの内にとけて流れ、悩みの日はわたしを捕えた。"},{"ref":"Job.30.17","start":18030017,"end":18030017,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"よる"],[6,1,"ほね"],[8,1,"はげ"],[11,1,"なや"],[21,1,"くる"]],"text":"夜はわたしの骨を激しく悩まし、わたしをかむ苦しみは、やむことがない。"},{"ref":"Job.30.18","start":18030018,"end":18030018,"break":"line","breaks":[[20,"line"]],"ruby":[[3,2,"ぼうりょく"],[14,2,"きもの"],[17,1,"とら"],[22,1,"ぎ"]],"text":"それは暴力をもって、わたしの着物を捕え、はだ着のえりのように、わたしをしめつける。"},{"ref":"Job.30.19","start":18030019,"end":18030019,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かみ"],[6,1,"どろ"],[8,1,"なか"],[10,1,"な"],[12,1,"い"],[26,1,"はい"]],"text":"神がわたしを泥の中に投げ入れられたので、わたしはちり灰のようになった。"},{"ref":"Job.30.20","start":18030020,"end":18030020,"break":"line","breaks":[[19,"line"],[30,"line"]],"ruby":[[12,1,"よ"],[23,1,"こた"],[34,1,"た"],[45,1,"かえり"]],"text":"わたしがあなたにむかって呼ばわっても、あなたは答えられない。わたしが立っていても、あなたは顧みられない。"},{"ref":"Job.30.21","start":18030021,"end":18030021,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"かわ"],[12,2,"むじょう"],[15,1,"もの"],[21,1,"て"],[23,1,"ちから"],[32,1,"せ"],[34,1,"なや"]],"text":"あなたは変って、わたしに無情な者となり、み手の力をもってわたしを攻め悩まされる。"},{"ref":"Job.30.22","start":18030022,"end":18030022,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"あ"],[11,1,"かぜ"],[13,1,"うえ"],[15,1,"の"],[18,2,"おおかぜ"],[24,1,"こえ"],[26,1,"なか"]],"text":"あなたはわたしを揚げて風の上に乗せ、大風のうなり声の中に、もませられる。"},{"ref":"Job.30.23","start":18030023,"end":18030023,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"し"],[18,1,"し"],[20,1,"かえ"],[28,1,"い"],[30,1,"もの"],[32,1,"あつ"],[35,1,"いえ"],[37,1,"かえ"]],"text":"わたしは知っている、あなたはわたしを死に帰らせ、すべての生き物の集まる家に帰らせられることを。"},{"ref":"Job.30.24","start":18030024,"end":18030024,"break":"stanza","breaks":[[15,"line"],[27,"line"]],"ruby":[[5,2,"あらつか"],[8,1,"なか"],[12,1,"もの"],[15,1,"て"],[17,1,"の"],[27,1,"わざわい"],[29,1,"なか"],[33,1,"もの"],[35,1,"たす"],[38,1,"よ"],[40,1,"もと"]],"text":"さりながら荒塚の中にある者は、手を伸べないであろうか、災の中にある者は助けを呼び求めないであろうか。"},{"ref":"Job.30.25","start":18030025,"end":18030025,"break":"line","breaks":[[16,"line"],[24,"line"],[38,"line"]],"ruby":[[4,1,"くる"],[7,1,"ひ"],[9,1,"おく"],[11,1,"もの"],[16,1,"な"],[28,1,"たましい"],[30,1,"まず"],[33,1,"ひと"],[38,1,"かな"]],"text":"わたしは苦しい日を送る者のために泣かなかったか。わたしの魂は貧しい人のために悲しまなかったか。"},{"ref":"Job.30.26","start":18030026,"end":18030026,"break":"line","breaks":[[19,"line"]],"ruby":[[7,1,"さいわい"],[9,1,"のぞ"],[14,1,"わざわい"],[16,1,"き"],[19,1,"ひかり"],[21,1,"ま"],[23,1,"のぞ"],[31,1,"き"]],"text":"しかしわたしが幸を望んだのに災が来た。光を待ち望んだのにやみが来た。"},{"ref":"Job.30.27","start":18030027,"end":18030027,"break":"line","breaks":[[22,"line"]],"ruby":[[9,1,"わ"],[16,1,"しず"],[22,1,"なや"],[25,1,"ひ"],[31,1,"ちか"]],"text":"わたしのはらわたは沸きかえって、静まらない。悩みの日がわたしに近づいた。"},{"ref":"Job.30.28","start":18030028,"end":18030028,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"ひ"],[6,1,"ひかり"],[12,1,"くろ"],[17,1,"ある"],[20,2,"こうかい"],[23,1,"なか"],[25,1,"た"],[28,1,"たす"],[31,1,"よ"],[33,1,"もと"]],"text":"わたしは日の光によらずに黒くなって歩き、公会の中に立って助けを呼び求める。"},{"ref":"Job.30.29","start":18030029,"end":18030029,"break":"line","breaks":[[13,"line"]],"ruby":[[4,2,"やまいぬ"],[7,2,"きょうだい"],[18,1,"とも"]],"text":"わたしは山犬の兄弟となり、だちょうの友となった。"},{"ref":"Job.30.30","start":18030030,"end":18030030,"break":"line","breaks":[[18,"line"]],"ruby":[[4,2,"ひふ"],[7,1,"くろ"],[15,1,"お"],[22,1,"ほね"],[24,1,"あつ"],[30,1,"も"]],"text":"わたしの皮膚は黒くなって、はげ落ち、わたしの骨は熱さによって燃え、"},{"ref":"Job.30.31","start":18030031,"end":18030031,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"こと"],[6,1,"かな"],[10,1,"ね"],[19,1,"ふえ"],[21,1,"な"],[23,1,"もの"],[25,1,"こえ"]],"text":"わたしの琴は悲しみの音となり、わたしの笛は泣く者の声となった。"}]