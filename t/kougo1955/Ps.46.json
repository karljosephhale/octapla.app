[{"ref":"Ps.46.1","start":19046001,"end":19046001,"break":"paragraph","title":"聖歌隊の指揮者によって女の声のしらべにあわせてうたわせたコラの子の歌","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[6,1,"さ"],[8,1,"どころ"],[11,1,"ちから"],[16,1,"なや"],[19,1,"とき"],[23,1,"ちか"],[25,1,"たす"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[11,1,"おんな"],[13,1,"こえ"],[31,1,"こ"],[33,1,"うた"]],"text":"神はわれらの避け所また力である。悩める時のいと近き助けである。"},{"ref":"Ps.46.2","start":19046002,"end":19046002,"break":"line","breaks":[[14,"line"]],"ruby":[[9,1,"ち"],[11,1,"かわ"],[14,1,"やま"],[16,1,"うみ"],[18,2,"まなか"],[21,1,"うつ"],[30,1,"おそ"]],"text":"このゆえに、たとい地は変り、山は海の真中に移るとも、われらは恐れない。"},{"ref":"Ps.46.3","start":19046003,"end":19046003,"break":"line","breaks":[[21,"line"],[39,"line"]],"ruby":[[5,1,"みず"],[7,1,"な"],[30,1,"やま"],[32,1,"ふる"],[34,1,"うご"],[43,1,"おそ"]],"text":"たといその水は鳴りとどろき、あわだつとも、そのさわぎによって山は震え動くとも、われらは恐れない。〔セラ"},{"ref":"Ps.46.4","start":19046004,"end":19046004,"break":"line","breaks":[[8,"line"],[21,"line"]],"ruby":[[3,1,"かわ"],[10,1,"なが"],[13,1,"かみ"],[15,1,"みやこ"],[17,1,"よろこ"],[23,1,"たか"],[25,1,"もの"],[27,1,"せい"],[34,1,"よろこ"]],"text":"一つの川がある。その流れは神の都を喜ばせ、いと高き者の聖なるすまいを喜ばせる。"},{"ref":"Ps.46.5","start":19046005,"end":19046005,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かみ"],[4,1,"なか"],[13,1,"みやこ"],[21,1,"かみ"],[23,1,"あさ"],[31,1,"たす"]],"text":"神がその中におられるので、都はゆるがない。神は朝はやく、これを助けられる。"},{"ref":"Ps.46.6","start":19046006,"end":19046006,"break":"line","breaks":[[24,"line"]],"ruby":[[5,1,"たみ"],[7,1,"さわ"],[17,1,"くに"],[19,1,"ゆ"],[21,1,"うご"],[24,1,"かみ"],[28,1,"こえ"],[30,1,"だ"],[35,1,"ち"],[37,1,"と"]],"text":"もろもろの民は騒ぎたち、もろもろの国は揺れ動く、神がその声を出されると地は溶ける。"},{"ref":"Ps.46.7","start":19046007,"end":19046007,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[9,1,"とも"],[20,1,"かみ"],[26,1,"さ"],[28,1,"どころ"]],"text":"万軍の主はわれらと共におられる、ヤコブの神はわれらの避け所である。〔セラ"},{"ref":"Ps.46.8","start":19046008,"end":19046008,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"き"],[3,1,"しゅ"],[9,1,"み"],[12,1,"しゅ"],[14,1,"おどろ"],[21,1,"ち"],[23,1,"おこな"]],"text":"来て、主のみわざを見よ、主は驚くべきことを地に行われた。"},{"ref":"Ps.46.9","start":19046009,"end":19046009,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ち"],[9,1,"たたか"],[17,1,"ゆみ"],[19,1,"お"],[25,1,"た"],[28,2,"せんしゃ"],[31,1,"ひ"],[33,1,"や"]],"text":"主は地のはてまでも戦いをやめさせ、弓を折り、やりを断ち、戦車を火で焼かれる。"},{"ref":"Ps.46.10","start":19046010,"end":19046010,"break":"line","breaks":[[21,"line"],[42,"line"]],"ruby":[[1,1,"しず"],[11,1,"かみ"],[18,1,"し"],[30,2,"くにたみ"],[42,1,"ぜん"],[43,1,"ち"]],"text":"「静まって、わたしこそ神であることを知れ。わたしはもろもろの国民のうちにあがめられ、全地にあがめられる」。"},{"ref":"Ps.46.11","start":19046011,"end":19046011,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[9,1,"とも"],[20,1,"かみ"],[26,1,"さ"],[28,1,"どころ"]],"text":"万軍の主はわれらと共におられる、ヤコブの神はわれらの避け所である。〔セラ"}]