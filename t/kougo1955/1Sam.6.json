[{"ref":"1Sam.6.1","start":9006001,"end":9006001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"はこ"],[6,1,"げつ"],[8,1,"あいだ"],[16,1,"ち"]],"text":"主の箱は七か月の間ペリシテびとの地にあった。"},{"ref":"1Sam.6.2","start":9006002,"end":9006002,"break":"none","ruby":[[8,2,"さいし"],[11,1,"うらな"],[13,1,"し"],[15,1,"よ"],[18,1,"い"],[29,1,"かみ"],[31,1,"はこ"],[56,1,"ところ"],[58,1,"おく"],[60,1,"かえ"],[66,1,"つ"]],"text":"ペリシテびとは、祭司や占い師を呼んで言った、「イスラエルの神の箱をどうしましょうか。どのようにして、それをもとの所へ送り返せばよいか告げてください」。"},{"ref":"1Sam.6.3","start":9006003,"end":9006003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[14,1,"かみ"],[16,1,"はこ"],[18,1,"おく"],[20,1,"かえ"],[22,1,"とき"],[33,1,"かえ"],[42,1,"かなら"],[44,1,"かれ"],[49,1,"そな"],[51,1,"もの"],[56,1,"つぐな"],[88,1,"かれ"],[90,1,"て"],[100,1,"はな"],[106,1,"し"]],"text":"彼らは言った、「イスラエルの神の箱を送り返す時には、それをむなしく返してはならない。必ず彼にとがの供え物をもって償いをしなければならない。そうすれば、あなたがたはいやされ、また彼の手がなぜあなたがたを離れないかを知ることができるであろう」。"},{"ref":"1Sam.6.4","start":9006004,"end":9006004,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"い"],[13,1,"つぐな"],[18,1,"そな"],[20,1,"もの"],[23,1,"なに"],[33,1,"かれ"],[36,1,"こた"],[48,1,"きみ"],[52,1,"かず"],[60,1,"きん"],[62,2,"はれもの"],[67,1,"きん"],[88,1,"きみ"],[92,1,"のぞ"],[95,1,"わざわい"]],"text":"人々は言った、「われわれが償うとがの供え物には何をしましょうか」。彼らは答えた、「ペリシテびとの君たちの数にしたがって、金の腫物五つと金のねずみ五つである。あなたがたすべてと、君たちに臨んだ災は一つだからである。"},{"ref":"1Sam.6.5","start":9006005,"end":9006005,"break":"none","ruby":[[11,2,"はれもの"],[14,1,"ぞう"],[17,1,"ち"],[19,1,"あら"],[25,1,"ぞう"],[27,1,"つく"],[36,1,"かみ"],[38,2,"えいこう"],[41,1,"き"],[51,1,"かれ"],[69,2,"かみがみ"],[79,1,"ち"],[84,1,"て"],[86,1,"くわ"],[92,1,"かる"]],"text":"それゆえ、あなたがたの腫物の像と、地を荒すねずみの像を造り、イスラエルの神に栄光を帰するならば、たぶん彼は、あなたがた、およびあなたがたの神々と、あなたがたの地に、その手を加えることを軽くされるであろう。"},{"ref":"1Sam.6.6","start":9006006,"end":9006006,"break":"none","ruby":[[23,1,"こころ"],[36,2,"じぶん"],[39,1,"こころ"],[51,1,"かみ"],[53,1,"かれ"],[56,1,"なや"],[63,1,"かれ"],[66,1,"たみ"],[68,1,"い"],[72,1,"たみ"],[74,1,"さ"]],"text":"なにゆえ、あなたがたはエジプトびととパロがその心をかたくなにしたように、自分の心をかたくなにするのか。神が彼らを悩ましたので、彼らは民を行かせ、民は去ったではないか。"},{"ref":"1Sam.6.7","start":9006007,"end":9006007,"break":"none","ruby":[[4,1,"いま"],[6,1,"あたら"],[9,1,"くるま"],[11,1,"りょう"],[13,1,"つく"],[22,1,"つ"],[30,2,"にゅうぎゅう"],[33,1,"とう"],[40,1,"うし"],[42,1,"くるま"],[55,1,"こ"],[56,1,"うし"],[58,2,"にゅうぎゅう"],[62,1,"はな"],[65,1,"いえ"],[67,1,"つ"],[69,1,"かえ"]],"text":"それゆえ今、新しい車一両を造り、まだくびきを付けたことのない乳牛二頭をとり、その牛を車につなぎ、そのおのおのの子牛を乳牛から離して家に連れ帰り、"},{"ref":"1Sam.6.8","start":9006008,"end":9006008,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"はこ"],[13,1,"くるま"],[15,1,"の"],[27,1,"そな"],[29,1,"もの"],[33,1,"かれ"],[35,1,"つぐな"],[37,1,"きん"],[39,1,"つく"],[41,1,"もの"],[46,1,"はこ"],[59,1,"お"],[65,1,"おく"],[68,1,"さ"]],"text":"主の箱をとって、それをその車に載せ、あなたがたがとがの供え物として彼に償う金の作り物を一つの箱におさめてそのかたわらに置き、それを送って去らせなさい。"},{"ref":"1Sam.6.9","start":9006009,"end":9006009,"break":"none","ruby":[[3,1,"み"],[11,2,"じぶん"],[14,2,"りょうち"],[17,1,"い"],[19,1,"みち"],[28,1,"のぼ"],[36,1,"おお"],[40,1,"わざわい"],[48,1,"くだ"],[53,1,"かれ"],[67,1,"とき"],[75,1,"う"],[80,1,"かれ"],[82,1,"て"],[90,1,"こと"],[92,2,"ぐうぜん"],[101,1,"し"]],"text":"そして見ていて、それが自分の領地へ行く道を、ベテシメシへ上るならば、この大いなる災を、われわれに下したのは彼である。しかし、そうしない時は、われわれを撃ったのは彼の手ではなく、その事の偶然であったことを知るであろう」。"},{"ref":"1Sam.6.10","start":9006010,"end":9006010,"break":"paragraph","ruby":[[0,2,"ひとびと"],[16,1,"かれ"],[20,1,"とう"],[22,2,"にゅうぎゅう"],[32,1,"くるま"],[45,1,"こ"],[46,1,"うし"],[48,1,"いえ"],[50,1,"と"]],"text":"人々はそのようにした。すなわち、彼らは二頭の乳牛をとって、これを車につなぎ、そのおのおのの子牛を家に閉じこめ、"},{"ref":"1Sam.6.11","start":9006011,"end":9006011,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"はこ"],[7,1,"きん"],[14,2,"はれもの"],[17,1,"ぞう"],[23,1,"はこ"],[26,1,"くるま"],[28,1,"の"]],"text":"主の箱、および金のねずみと、腫物の像をおさめた箱とを車に載せた。"},{"ref":"1Sam.6.12","start":9006012,"end":9006012,"break":"none","ruby":[[3,2,"めうし"],[17,2,"ほうこう"],[26,2,"おおじ"],[29,1,"あゆ"],[32,1,"な"],[37,1,"すす"],[44,1,"みぎ"],[47,1,"ひだり"],[50,1,"まが"],[64,1,"きみ"],[75,1,"さかい"]],"text":"すると雌牛はまっすぐにベテシメシの方向へ、ひとすじに大路を歩み、鳴きながら進んでいって、右にも左にも曲らなかった。ペリシテびとの君たちは、ベテシメシの境までそのあとについていった。"},{"ref":"1Sam.6.13","start":9006013,"end":9006013,"break":"none","ruby":[[0,1,"とき"],[8,2,"ひとびと"],[11,1,"たに"],[13,2,"こむぎ"],[16,1,"か"],[18,1,"い"],[25,1,"め"],[33,1,"はこ"],[35,1,"み"],[40,1,"むか"],[43,1,"よろこ"]],"text":"時にベテシメシの人々は谷で小麦を刈り入れていたが、目をあげて、その箱を見、それを迎えて喜んだ。"},{"ref":"1Sam.6.14","start":9006014,"end":9006014,"break":"none","ruby":[[0,1,"くるま"],[14,1,"はたけ"],[32,1,"ところ"],[34,1,"おお"],[37,1,"いし"],[43,2,"ひとびと"],[46,1,"くるま"],[48,1,"き"],[50,1,"わ"],[55,2,"めうし"],[58,2,"はんさい"],[63,1,"しゅ"]],"text":"車はベテシメシびとヨシュアの畑にはいって、そこにとどまった。その所に大きな石があった。人々は車の木を割り、その雌牛を燔祭として主にささげた。"},{"ref":"1Sam.6.15","start":9006015,"end":9006015,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"はこ"],[18,1,"きん"],[20,1,"つく"],[22,1,"もの"],[28,1,"はこ"],[30,1,"と"],[39,2,"おおいし"],[42,1,"うえ"],[44,1,"お"],[57,2,"ひとびと"],[63,1,"ひ"],[65,1,"しゅ"],[67,2,"はんさい"],[70,1,"そな"],[73,2,"ぎせい"]],"text":"レビびとは主の箱と、そのかたわらの、金の作り物をおさめた箱を取りおろし、それを大石の上に置いた。そしてベテシメシの人々は、その日、主に燔祭を供え、犠牲をささげた。"},{"ref":"1Sam.6.16","start":9006016,"end":9006016,"break":"none","ruby":[[8,1,"にん"],[10,1,"きみ"],[17,1,"み"],[22,1,"ひ"],[29,1,"かえ"]],"text":"ペリシテびとの五人の君たちはこれを見て、その日、エクロンに帰った。"},{"ref":"1Sam.6.17","start":9006017,"end":9006017,"break":"paragraph","ruby":[[11,1,"そな"],[13,1,"もの"],[18,1,"しゅ"],[20,1,"つぐな"],[25,1,"きん"],[27,2,"はれもの"],[31,1,"つぎ"]],"text":"ペリシテびとが、とがの供え物として、主に償いをした金の腫物は、次のとおりである。すなわちアシドドのために一つ、ガザのために一つ、アシケロンのために一つ、ガテのために一つ、エクロンのために一つであった。"},{"ref":"1Sam.6.18","start":9006018,"end":9006018,"break":"none","ruby":[[2,1,"きん"],[9,2,"じょうへき"],[17,1,"まち"],[20,2,"じょうへき"],[25,2,"むらざと"],[38,1,"にん"],[40,1,"きみ"],[44,1,"ぞく"],[54,1,"まち"],[56,1,"かず"],[63,1,"つく"],[67,1,"しゅ"],[69,1,"はこ"],[75,1,"ところ"],[85,2,"おおいし"],[89,2,"こんにち"],[110,1,"はたけ"]],"text":"また金のねずみは、城壁をめぐらした町から城壁のない村里にいたるまで、すべて五人の君たちに属するペリシテびとの町の数にしたがって造った。主の箱をおろした所のかたわらにあった大石は、今日にいたるまで、ベテシメシびとヨシュアの畑にあって、あかしとなっている。"},{"ref":"1Sam.6.19","start":9006019,"end":9006019,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"しゅ"],[11,1,"はこ"],[13,1,"なか"],[15,1,"み"],[26,1,"しゅ"],[31,1,"う"],[40,1,"たみ"],[46,1,"にん"],[48,1,"う"],[53,1,"しゅ"],[55,1,"たみ"],[57,1,"う"],[60,1,"おお"],[63,1,"もの"],[65,1,"ころ"],[72,1,"たみ"],[77,1,"かな"]],"text":"ベテシメシの人々で主の箱の中を見たものがあったので、主はこれを撃たれた。すなわち民のうち七十人を撃たれた。主が民を撃って多くの者を殺されたので、民はなげき悲しんだ。"},{"ref":"1Sam.6.20","start":9006020,"end":9006020,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"い"],[20,1,"せい"],[23,1,"かみ"],[25,1,"しゅ"],[27,1,"まえ"],[29,1,"た"],[40,1,"しゅ"],[47,1,"はな"],[53,1,"ところ"],[55,1,"のぼ"],[58,1,"い"]],"text":"ベテシメシの人々は言った、「だれが、この聖なる神、主の前に立つことができようか。主はわれわれを離れてだれの所へ上って行かれたらよいのか」。"},{"ref":"1Sam.6.21","start":9006021,"end":9006021,"break":"none","ruby":[[3,1,"かれ"],[7,2,"ししゃ"],[19,2,"ひとびと"],[27,1,"い"],[39,1,"しゅ"],[41,1,"はこ"],[43,1,"かえ"],[49,1,"くだ"],[64,1,"ところ"],[66,1,"たずさ"],[68,1,"のぼ"]],"text":"そして彼らは、使者をキリアテ・ヤリムの人々につかわして言った、「ペリシテびとが主の箱を返したから、下ってきて、それをあなたがたの所へ携え上ってください」。"}]