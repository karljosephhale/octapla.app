[{"ref":"2Sam.3.1","start":10003001,"end":10003001,"break":"paragraph","ruby":[[4,1,"いえ"],[10,1,"いえ"],[13,1,"あいだ"],[15,2,"せんそう"],[18,1,"ひさ"],[21,1,"つづ"],[32,1,"つよ"],[41,1,"いえ"],[47,1,"よわ"]],"text":"サウルの家とダビデの家との間の戦争は久しく続き、ダビデはますます強くなり、サウルの家はますます弱くなった。"},{"ref":"2Sam.3.2","start":10003002,"end":10003002,"break":"paragraph","ruby":[[9,1,"おとこ"],[11,1,"こ"],[13,1,"うま"],[17,1,"かれ"],[19,2,"ちょうし"],[27,1,"おんな"],[34,1,"う"]],"text":"ヘブロンでダビデに男の子が生れた。彼の長子はエズレルの女アヒノアムの産んだアムノン、"},{"ref":"2Sam.3.3","start":10003003,"end":10003003,"break":"none","ruby":[[2,1,"つぎ"],[14,1,"つま"],[25,1,"う"],[33,1,"だい"],[41,1,"おう"],[47,1,"むすめ"],[52,1,"こ"]],"text":"その次はカルメルびとナバルの妻であったアビガイルの産んだキレアブ、第三はゲシュルの王タルマイの娘マアカの子アブサロム、"},{"ref":"2Sam.3.4","start":10003004,"end":10003004,"break":"none","ruby":[[0,1,"だい"],[7,1,"こ"],[13,1,"だい"],[21,1,"こ"]],"text":"第四はハギテの子アドニヤ、第五はアビタルの子シパテヤ、"},{"ref":"2Sam.3.5","start":10003005,"end":10003005,"break":"none","ruby":[[0,1,"だい"],[7,1,"つま"],[12,1,"う"],[25,1,"こ"],[36,1,"うま"]],"text":"第六はダビデの妻エグラの産んだイテレアム。これらの子がヘブロンでダビデに生れた。"},{"ref":"2Sam.3.6","start":10003006,"end":10003006,"break":"paragraph","ruby":[[4,1,"いえ"],[10,1,"いえ"],[13,1,"たたか"],[16,1,"つづ"],[21,1,"あいだ"],[33,1,"いえ"],[36,1,"つよ"]],"text":"サウルの家とダビデの家とが戦いを続けている間に、アブネルはサウルの家で、強くなってきた。"},{"ref":"2Sam.3.7","start":10003007,"end":10003007,"break":"none","ruby":[[22,1,"な"],[34,1,"むすめ"],[52,1,"い"],[67,1,"ちち"]],"text":"さてサウルには、ひとりのそばめがあった。その名をリヅパといい、アヤの娘であったが、イシボセテはアブネルに言った、「あなたはなぜわたしの父のそばめのところにはいったのですか」。"},{"ref":"2Sam.3.8","start":10003008,"end":10003008,"break":"none","ruby":[[11,2,"ことば"],[14,1,"き"],[17,2,"ひじょう"],[20,1,"いか"],[23,1,"い"],[35,1,"いぬ"],[56,1,"ちち"],[61,1,"いえ"],[66,2,"きょうだい"],[72,2,"ゆうじん"],[76,2,"ちゅうせい"],[93,1,"て"],[95,1,"わた"],[116,1,"おんな"],[118,1,"こと"],[125,1,"あ"],[132,1,"せ"]],"text":"アブネルはイシボセテの言葉を聞き、非常に怒って言った、「わたしはユダの犬のかしらですか。わたしはきょう、あなたの父サウルの家と、その兄弟と、その友人とに忠誠をあらわして、あなたをダビデの手に渡すことをしなかったのに、あなたはきょう、女の事のあやまちを挙げてわたしを責められる。"},{"ref":"2Sam.3.9","start":10003009,"end":10003009,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"ちか"],[18,1,"かれ"],[25,1,"と"],[33,1,"かみ"],[45,1,"ばっ"]],"text":"主がダビデに誓われたことを、わたしが彼のためになし遂げないならば、神がアブネルをいくえにも罰しられるように。"},{"ref":"2Sam.3.10","start":10003010,"end":10003010,"break":"none","ruby":[[4,2,"おうこく"],[11,1,"いえ"],[14,1,"うつ"],[21,1,"くらい"],[33,1,"いた"],[47,1,"うえ"],[49,1,"た"]],"text":"すなわち王国をサウルの家から移し、ダビデの位をダンからベエルシバに至るまで、イスラエルとユダの上に立たせられるであろう」。"},{"ref":"2Sam.3.11","start":10003011,"end":10003011,"break":"none","ruby":[[11,1,"おそ"],[19,1,"こと"],[21,1,"かれ"],[23,1,"こた"]],"text":"イシボセテはアブネルを恐れたので、ひと言も彼に答えることができなかった。"},{"ref":"2Sam.3.12","start":10003012,"end":10003012,"break":"paragraph","ruby":[[19,2,"ししゃ"],[27,1,"い"],[32,1,"くに"],[47,2,"けいやく"],[50,1,"むす"],[64,2,"ちからぞ"]],"text":"アブネルはヘブロンにいるダビデのもとに使者をつかわして言った、「国はだれのものですか。わたしと契約を結びなさい。わたしはあなたに力添えして、イスラエルをことごとくあなたのものにしましょう」。"},{"ref":"2Sam.3.13","start":10003013,"end":10003013,"break":"none","ruby":[[4,1,"い"],[23,2,"けいやく"],[26,1,"むす"],[39,1,"こと"],[45,1,"もと"],[60,1,"かお"],[62,1,"み"],[73,1,"むすめ"],[78,1,"つ"],[81,1,"く"],[94,1,"かお"],[96,1,"み"]],"text":"ダビデは言った、「よろしい。わたしは、あなたと契約を結びましょう。ただし一つの事をあなたに求めます。あなたがきてわたしの顔を見るとき、まずサウルの娘ミカルを連れて来るのでなければ、わたしの顔を見ることはできません」。"},{"ref":"2Sam.3.14","start":10003014,"end":10003014,"break":"none","ruby":[[8,2,"ししゃ"],[15,1,"こ"],[27,1,"い"],[39,1,"よう"],[41,1,"かわ"],[56,1,"つま"],[61,1,"ひ"],[63,1,"わた"]],"text":"それからダビデは使者をサウルの子イシボセテにつかわして言った、「ペリシテびとの陽の皮一百をもってめとったわたしの妻ミカルを引き渡しなさい」。"},{"ref":"2Sam.3.15","start":10003015,"end":10003015,"break":"none","ruby":[[9,1,"ひと"],[14,2,"かのじょ"],[19,1,"おっと"],[25,1,"こ"],[33,1,"と"]],"text":"そこでイシボセテは人をやって彼女をその夫、ライシの子パルテエルから取ったので、"},{"ref":"2Sam.3.16","start":10003016,"end":10003016,"break":"none","ruby":[[2,1,"おっと"],[4,2,"かのじょ"],[7,1,"とも"],[9,1,"い"],[12,1,"な"],[17,2,"かのじょ"],[33,1,"い"],[43,1,"かれ"],[46,1,"かえ"],[49,1,"い"],[53,1,"い"],[58,1,"かれ"],[60,1,"かえ"]],"text":"その夫は彼女と共に行き、泣きながら彼女のあとについて、バホリムまで行ったが、アブネルが彼に「帰って行け」と言ったので彼は帰った。"},{"ref":"2Sam.3.17","start":10003017,"end":10003017,"break":"paragraph","ruby":[[11,2,"ちょうろう"],[16,2,"きょうぎ"],[20,1,"い"],[31,2,"いぜん"],[45,1,"おう"],[52,1,"もと"]],"text":"アブネルはイスラエルの長老たちと協議して言った、「あなたがたは以前からダビデをあなたがたの王とすることを求めていましたが、"},{"ref":"2Sam.3.18","start":10003018,"end":10003018,"break":"none","ruby":[[0,1,"いま"],[9,1,"しゅ"],[31,1,"て"],[41,1,"たみ"],[55,1,"て"],[65,1,"てき"],[67,1,"て"],[70,1,"すく"],[72,1,"だ"],[80,1,"い"]],"text":"今それをしなさい。主がダビデについて、『わたしのしもべダビデの手によって、わたしの民イスラエルをペリシテびとの手、およびもろもろの敵の手から救い出すであろう』と言われたからです」。"},{"ref":"2Sam.3.19","start":10003019,"end":10003019,"break":"none","ruby":[[14,1,"かた"],[39,2,"ぜんか"],[42,1,"よ"],[45,1,"おも"],[62,1,"つ"],[69,2,"しゅっぱつ"]],"text":"アブネルはまたベニヤミンにも語った。そしてアブネルは、イスラエルとベニヤミンの全家が良いと思うことをみな、ヘブロンでダビデに告げようとして出発した。"},{"ref":"2Sam.3.20","start":10003020,"end":10003020,"break":"paragraph","ruby":[[7,1,"にん"],[9,1,"したが"],[26,1,"い"],[29,1,"とき"],[40,1,"かれ"],[42,1,"したが"],[47,2,"じゅうしゃ"],[55,2,"しゅえん"],[58,1,"もう"]],"text":"アブネルが二十人を従えてヘブロンにいるダビデのもとに行った時、ダビデはアブネルと彼に従っている従者たちのために酒宴を設けた。"},{"ref":"2Sam.3.21","start":10003021,"end":10003021,"break":"none","ruby":[[9,1,"い"],[18,1,"た"],[21,1,"い"],[38,1,"しゅ"],[40,1,"おう"],[45,1,"あつ"],[53,2,"けいやく"],[56,1,"むす"],[64,1,"のぞ"],[74,1,"おさ"],[104,1,"おく"],[106,1,"かえ"],[112,1,"かれ"],[114,2,"あんぜん"],[117,1,"さ"],[120,1,"い"]],"text":"アブネルはダビデに言った、「わたしは立って行き、イスラエルをことごとく、わが主、王のもとに集めて、あなたと契約を結ばせ、あなたの望むものをことごとく治められるようにいたしましょう」。こうしてダビデはアブネルを送り帰らせたので彼は安全に去って行った。"},{"ref":"2Sam.3.22","start":10003022,"end":10003022,"break":"paragraph","ruby":[[6,1,"とき"],[12,2,"けらい"],[21,1,"とも"],[23,1,"おお"],[30,1,"もの"],[32,1,"たずさ"],[35,2,"りゃくだつ"],[39,1,"かえ"],[76,1,"かれ"],[78,1,"かえ"],[82,1,"かれ"],[84,2,"あんぜん"],[87,1,"さ"]],"text":"ちょうどその時、ダビデの家来たちはヨアブと共に多くのぶんどり物を携えて略奪から帰ってきた。しかしアブネルはヘブロンのダビデのもとにはいなかった。ダビデが彼を帰らせて彼が安全に去ったからである。"},{"ref":"2Sam.3.23","start":10003023,"end":10003023,"break":"none","ruby":[[6,1,"かれ"],[8,1,"とも"],[12,2,"ぐんぜい"],[17,1,"かえ"],[25,2,"ひとびと"],[32,1,"い"],[40,1,"こ"],[46,1,"おう"],[55,1,"おう"],[57,1,"かれ"],[59,1,"かえ"],[65,1,"かれ"],[67,2,"あんぜん"],[70,1,"さ"]],"text":"ヨアブおよび彼と共にいた軍勢がみな帰ってきたとき、人々はヨアブに言った、「ネルの子アブネルが王のもとにきたが、王が彼を帰らせたので彼は安全に去った」。"},{"ref":"2Sam.3.24","start":10003024,"end":10003024,"break":"none","ruby":[[7,1,"おう"],[12,1,"い"],[15,1,"い"],[24,1,"なに"],[44,1,"ところ"],[60,1,"かれ"],[62,1,"かえ"],[64,1,"さ"]],"text":"そこでヨアブは王のもとに行って言った、「あなたは何をなさったのですか。アブネルがあなたの所にきたのに、あなたはどうして、彼を返し去らせられたのですか。"},{"ref":"2Sam.3.25","start":10003025,"end":10003025,"break":"none","ruby":[[3,1,"こ"],[13,1,"あざむ"],[30,2,"でい"],[34,1,"し"],[58,1,"し"]],"text":"ネルの子アブネルがあなたを欺くためにきたこと、そしてあなたの出入りを知り、またあなたのなさっていることを、ことごとく知るためにきたことをあなたはごぞんじです」。"},{"ref":"2Sam.3.26","start":10003026,"end":10003026,"break":"paragraph","ruby":[[8,1,"ところ"],[11,1,"で"],[16,2,"ししゃ"],[29,1,"お"],[36,1,"かれ"],[42,2,"いど"],[46,1,"かれ"],[48,1,"つ"],[51,1,"かえ"],[64,1,"こと"],[66,1,"し"]],"text":"ヨアブはダビデの所から出てきて、使者をつかわし、アブネルを追わせたので、彼らはシラの井戸から彼を連れて帰った。しかしダビデはその事を知らなかった。"},{"ref":"2Sam.3.27","start":10003027,"end":10003027,"break":"none","ruby":[[10,1,"かえ"],[26,1,"かた"],[33,1,"かれ"],[35,1,"もん"],[40,1,"つ"],[43,1,"い"],[48,1,"ところ"],[50,1,"かれ"],[52,1,"はら"],[54,1,"さ"],[57,1,"し"],[61,2,"じぶん"],[64,2,"きょうだい"],[71,1,"ち"],[73,1,"むく"]],"text":"アブネルがヘブロンに帰ってきたとき、ヨアブはひそかに語ろうといって彼を門のうちに連れて行き、その所で彼の腹を刺して死なせ、自分の兄弟アサヘルの血を報いた。"},{"ref":"2Sam.3.28","start":10003028,"end":10003028,"break":"none","ruby":[[2,1,"のち"],[9,1,"こと"],[11,1,"き"],[14,1,"い"],[27,2,"おうこく"],[35,1,"こ"],[41,1,"ち"],[43,1,"かん"],[47,1,"しゅ"],[49,1,"まえ"],[51,2,"えいきゅう"],[54,1,"つみ"]],"text":"その後ダビデはこの事を聞いて言った、「わたしとわたしの王国とは、ネルの子アブネルの血に関して、主の前に永久に罪はない。"},{"ref":"2Sam.3.29","start":10003029,"end":10003029,"break":"none","ruby":[[6,1,"つみ"],[12,1,"あたま"],[17,1,"ちち"],[19,2,"ぜんか"],[22,1,"き"],[35,1,"いえ"],[38,2,"りゅうしゅつ"],[41,1,"や"],[43,1,"もの"],[47,2,"びょうにん"],[56,1,"もの"],[62,1,"たお"],[65,1,"もの"],[70,2,"しょくもつ"],[73,1,"とぼ"],[76,1,"もの"],[78,1,"た"]],"text":"どうぞ、その罪がヨアブの頭と、その父の全家に帰するように。またヨアブの家には流出を病む者、らい病人、つえにたよる者、つるぎに倒れる者、または食物の乏しい者が絶えないように」。"},{"ref":"2Sam.3.30","start":10003030,"end":10003030,"break":"none","ruby":[[10,1,"おとうと"],[23,1,"ころ"],[31,1,"かれ"],[38,1,"たたか"],[41,1,"かれ"],[44,2,"きょうだい"],[51,1,"ころ"]],"text":"こうしてヨアブとその弟アビシャイとはアブネルを殺したが、それは彼がギベオンの戦いで彼らの兄弟アサヘルを殺したためであった。"},{"ref":"2Sam.3.31","start":10003031,"end":10003031,"break":"paragraph","ruby":[[10,2,"じぶん"],[13,1,"とも"],[21,1,"たみ"],[23,1,"い"],[34,2,"きもの"],[37,1,"さ"],[40,2,"あらぬの"],[52,1,"まえ"],[54,1,"なげ"],[59,1,"い"],[72,1,"おう"],[76,1,"かん"],[81,1,"したが"]],"text":"ダビデはヨアブおよび自分と共にいるすべての民に言った、「あなたがたは着物を裂き、荒布をまとい、アブネルの前に嘆きながら行きなさい」。そしてダビデ王はその棺のあとに従った。"},{"ref":"2Sam.3.32","start":10003032,"end":10003032,"break":"none","ruby":[[0,2,"ひとびと"],[13,1,"ほうむ"],[17,1,"おう"],[24,1,"はか"],[26,1,"こえ"],[31,1,"な"],[34,1,"たみ"],[38,1,"な"]],"text":"人々はアブネルをヘブロンに葬った。王はアブネルの墓で声をあげて泣き、民もみな泣いた。"},{"ref":"2Sam.3.33","start":10003033,"end":10003033,"break":"none","breaks":[[23,"stanza"],[35,"line"]],"ruby":[[0,1,"おう"],[10,1,"かな"],[14,1,"うた"],[16,1,"つく"],[19,1,"い"],[24,1,"おろ"],[27,1,"ひと"],[29,1,"し"],[44,1,"し"]],"text":"王はアブネルのために悲しみの歌を作って言った、「愚かな人の死ぬように、アブネルがどうして死んだのか。"},{"ref":"2Sam.3.34","start":10003034,"end":10003034,"break":"line","breaks":[[11,"line"],[27,"line"],[41,"line"]],"ruby":[[4,1,"て"],[6,1,"しば"],[11,1,"あし"],[14,1,"あし"],[27,2,"あくにん"],[30,1,"まえ"],[32,1,"たお"],[35,1,"ひと"],[45,1,"たお"],[53,1,"たみ"],[55,1,"みな"],[61,1,"かれ"],[66,1,"な"]],"text":"あなたの手は縛られず、足には足かせもかけられないのに、悪人の前に倒れる人のように、あなたは倒れた」。そして民は皆、ふたたび彼のために泣いた。"},{"ref":"2Sam.3.35","start":10003035,"end":10003035,"break":"none","ruby":[[0,1,"たみ"],[7,1,"ひ"],[22,1,"た"],[37,1,"ちか"],[40,1,"い"],[51,1,"ひ"],[53,1,"い"],[55,1,"まえ"],[70,1,"あじ"],[77,1,"かみ"],[88,1,"ばっ"]],"text":"民はみなきて、日のあるうちに、ダビデにパンを食べさせようとしたが、ダビデは誓って言った、「もしわたしが日の入る前に、パンでも、ほかのものでも味わうならば、神がわたしをいくえにも罰しられるように」。"},{"ref":"2Sam.3.36","start":10003036,"end":10003036,"break":"none","ruby":[[0,1,"たみ"],[7,1,"み"],[9,2,"まんぞく"],[17,1,"おう"],[24,1,"たみ"],[26,2,"まんぞく"]],"text":"民はみなそれを見て満足した。すべて王のすることは民を満足させた。"},{"ref":"2Sam.3.37","start":10003037,"end":10003037,"break":"none","ruby":[[2,1,"ひ"],[7,1,"たみ"],[17,1,"みな"],[22,1,"こ"],[28,1,"ころ"],[34,1,"おう"],[36,2,"いし"],[49,1,"し"]],"text":"その日すべての民およびイスラエルは皆、ネルの子アブネルを殺したのは、王の意思によるものでないことを知った。"},{"ref":"2Sam.3.38","start":10003038,"end":10003038,"break":"none","ruby":[[0,1,"おう"],[4,2,"けらい"],[9,1,"い"],[16,1,"ひ"],[28,2,"いだい"],[32,2,"しょうぐん"],[35,1,"たお"],[46,1,"し"]],"text":"王はその家来たちに言った、「この日イスラエルで、ひとりの偉大なる将軍が倒れたのをあなたがたは知らないのか。"},{"ref":"2Sam.3.39","start":10003039,"end":10003039,"break":"none","ruby":[[4,1,"あぶら"],[6,1,"そそ"],[10,1,"おう"],[19,2,"こんにち"],[23,1,"よわ"],[30,1,"こ"],[38,2,"ひとびと"],[45,1,"て"],[55,1,"しゅ"],[57,1,"あく"],[59,1,"おこな"],[61,1,"もの"],[66,1,"あく"],[73,1,"むく"]],"text":"わたしは油を注がれた王であるけれども、今日なお弱い。ゼルヤの子であるこれらの人々はわたしの手におえない。どうぞ主が悪を行う者に、その悪にしたがって報いられるように」。"}]