[{"ref":"John.21.1","start":43021001,"end":43021001,"break":"paragraph","ruby":[[14,1,"うみ"],[19,2,"じしん"],[24,2,"でし"],[44,2,"しだい"]],"text":"そののち、イエスはテベリヤの海べで、ご自身をまた弟子たちにあらわされた。そのあらわされた次第は、こうである。"},{"ref":"John.21.2","start":43021002,"end":43021002,"break":"none","ruby":[[13,1,"よ"],[42,1,"こ"],[53,2,"でし"],[58,2,"いっしょ"],[63,1,"とき"]],"text":"シモン・ペテロが、デドモと呼ばれているトマス、ガリラヤのカナのナタナエル、ゼベダイの子らや、ほかのふたりの弟子たちと一緒にいた時のことである。"},{"ref":"John.21.3","start":43021003,"end":43021003,"break":"none","ruby":[[8,1,"かれ"],[16,1,"りょう"],[18,1,"い"],[24,1,"い"],[28,1,"かれ"],[38,2,"いっしょ"],[41,1,"い"],[46,1,"い"],[50,1,"かれ"],[53,1,"で"],[55,1,"い"],[58,1,"ふね"],[60,1,"の"],[70,1,"よ"],[75,2,"えもの"]],"text":"シモン・ペテロは彼らに「わたしは漁に行くのだ」と言うと、彼らは「わたしたちも一緒に行こう」と言った。彼らは出て行って舟に乗った。しかし、その夜はなんの獲物もなかった。"},{"ref":"John.21.4","start":43021004,"end":43021004,"break":"none","ruby":[[0,1,"よ"],[2,1,"あ"],[12,1,"きし"],[14,1,"た"],[25,2,"でし"],[39,1,"し"]],"text":"夜が明けたころ、イエスが岸に立っておられた。しかし弟子たちはそれがイエスだとは知らなかった。"},{"ref":"John.21.5","start":43021005,"end":43021005,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[13,1,"こ"],[18,1,"なに"],[20,1,"た"],[31,1,"かれ"],[42,1,"こた"]],"text":"イエスは彼らに言われた、「子たちよ、何か食べるものがあるか」。彼らは「ありません」と答えた。"},{"ref":"John.21.6","start":43021006,"end":43021006,"break":"none","ruby":[[8,1,"かれ"],[11,1,"い"],[17,1,"ふね"],[19,1,"みぎ"],[21,1,"ほう"],[23,1,"あみ"],[29,1,"み"],[40,1,"なに"],[50,1,"かれ"],[53,1,"あみ"],[60,1,"うお"],[62,1,"おお"],[73,1,"ひ"],[75,1,"あ"]],"text":"すると、イエスは彼らに言われた、「舟の右の方に網をおろして見なさい。そうすれば、何かとれるだろう」。彼らは網をおろすと、魚が多くとれたので、それを引き上げることができなかった。"},{"ref":"John.21.7","start":43021007,"end":43021007,"break":"none","ruby":[[4,1,"あい"],[11,2,"でし"],[23,1,"しゅ"],[27,1,"い"],[39,1,"しゅ"],[44,1,"き"],[48,1,"はだか"],[58,2,"うわぎ"],[65,1,"うみ"]],"text":"イエスの愛しておられた弟子が、ペテロに「あれは主だ」と言った。シモン・ペテロは主であると聞いて、裸になっていたため、上着をまとって海にとびこんだ。"},{"ref":"John.21.8","start":43021008,"end":43021008,"break":"none","ruby":[[7,2,"でし"],[12,1,"ふね"],[14,1,"の"],[20,1,"うお"],[28,1,"あみ"],[30,1,"ひ"],[35,1,"かえ"],[38,1,"い"],[42,1,"りく"],[49,1,"とお"],[55,1,"けん"],[59,1,"ところ"]],"text":"しかし、ほかの弟子たちは舟に乗ったまま、魚のはいっている網を引きながら帰って行った。陸からはあまり遠くない五十間ほどの所にいたからである。"},{"ref":"John.21.9","start":43021009,"end":43021009,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"りく"],[5,1,"のぼ"],[8,1,"み"],[12,2,"すみび"],[25,1,"うえ"],[27,1,"うお"]],"text":"彼らが陸に上って見ると、炭火がおこしてあって、その上に魚がのせてあり、またそこにパンがあった。"},{"ref":"John.21.10","start":43021010,"end":43021010,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[13,1,"いま"],[17,1,"うお"],[19,1,"すこ"],[21,1,"も"]],"text":"イエスは彼らに言われた、「今とった魚を少し持ってきなさい」。"},{"ref":"John.21.11","start":43021011,"end":43021011,"break":"none","ruby":[[8,1,"い"],[12,1,"あみ"],[14,1,"りく"],[16,1,"ひ"],[18,1,"あ"],[30,1,"おお"],[33,1,"うお"],[50,1,"おお"],[56,1,"あみ"]],"text":"シモン・ペテロが行って、網を陸へ引き上げると、百五十三びきの大きな魚でいっぱいになっていた。そんなに多かったが、網はさけないでいた。"},{"ref":"John.21.12","start":43021012,"end":43021012,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[16,1,"あさ"],[18,2,"しょくじ"],[27,2,"でし"],[33,1,"しゅ"],[65,1,"すす"],[68,1,"たず"],[71,1,"もの"]],"text":"イエスは彼らに言われた、「さあ、朝の食事をしなさい」。弟子たちは、主であることがわかっていたので、だれも「あなたはどなたですか」と進んで尋ねる者がなかった。"},{"ref":"John.21.13","start":43021013,"end":43021013,"break":"none","ruby":[[15,1,"かれ"],[18,1,"あた"],[23,1,"うお"],[25,1,"おな"]],"text":"イエスはそこにきて、パンをとり彼らに与え、また魚も同じようにされた。"},{"ref":"John.21.14","start":43021014,"end":43021014,"break":"none","ruby":[[4,2,"しにん"],[7,1,"なか"],[19,2,"でし"],[35,1,"すで"],[38,2,"どめ"]],"text":"イエスが死人の中からよみがえったのち、弟子たちにあらわれたのは、これで既に三度目である。"},{"ref":"John.21.15","start":43021015,"end":43021015,"break":"paragraph","ruby":[[0,1,"かれ"],[3,2,"しょくじ"],[24,1,"い"],[34,1,"こ"],[46,1,"ひと"],[50,1,"あい"],[53,2,"いじょう"],[61,1,"あい"],[71,1,"い"],[76,1,"しゅ"],[92,1,"あい"],[104,1,"ぞん"],[114,1,"かれ"],[121,2,"こひつじ"],[124,1,"やしな"],[131,1,"い"]],"text":"彼らが食事をすませると、イエスはシモン・ペテロに言われた、「ヨハネの子シモンよ、あなたはこの人たちが愛する以上に、わたしを愛するか」。ペテロは言った、「主よ、そうです。わたしがあなたを愛することは、あなたがご存じです」。イエスは彼に「わたしの小羊を養いなさい」と言われた。"},{"ref":"John.21.16","start":43021016,"end":43021016,"break":"none","ruby":[[4,2,"いちど"],[6,1,"かれ"],[8,1,"い"],[18,1,"こ"],[28,1,"あい"],[34,1,"かれ"],[40,1,"い"],[45,1,"しゅ"],[61,1,"あい"],[73,1,"ぞん"],[83,1,"かれ"],[85,1,"い"],[95,1,"ひつじ"],[97,1,"か"]],"text":"またもう一度彼に言われた、「ヨハネの子シモンよ、わたしを愛するか」。彼はイエスに言った、「主よ、そうです。わたしがあなたを愛することは、あなたがご存じです」。イエスは彼に言われた、「わたしの羊を飼いなさい」。"},{"ref":"John.21.17","start":43021017,"end":43021017,"break":"none","ruby":[[5,2,"どめ"],[8,1,"い"],[18,1,"こ"],[28,1,"あい"],[43,1,"あい"],[54,1,"ど"],[56,1,"い"],[63,1,"こころ"],[73,1,"い"],[78,1,"しゅ"],[90,1,"ぞん"],[103,1,"あい"],[129,1,"かれ"],[131,1,"い"],[141,1,"ひつじ"],[143,1,"やしな"]],"text":"イエスは三度目に言われた、「ヨハネの子シモンよ、わたしを愛するか」。ペテロは「わたしを愛するか」とイエスが三度も言われたので、心をいためてイエスに言った、「主よ、あなたはすべてをご存じです。わたしがあなたを愛していることは、おわかりになっています」。イエスは彼に言われた、「わたしの羊を養いなさい。"},{"ref":"John.21.18","start":43021018,"end":43021018,"break":"none","ruby":[[8,1,"い"],[18,1,"わか"],[22,1,"とき"],[26,2,"じぶん"],[29,1,"おび"],[35,1,"おも"],[41,1,"ある"],[53,1,"とし"],[62,2,"じぶん"],[65,1,"て"],[84,1,"ひと"],[90,1,"おび"],[92,1,"むす"],[97,1,"い"],[103,1,"ところ"],[105,1,"つ"],[108,1,"い"]],"text":"よくよくあなたに言っておく。あなたが若かった時には、自分で帯をしめて、思いのままに歩きまわっていた。しかし年をとってからは、自分の手をのばすことになろう。そして、ほかの人があなたに帯を結びつけ、行きたくない所へ連れて行くであろう」。"},{"ref":"John.21.19","start":43021019,"end":43021019,"break":"none","ruby":[[11,1,"し"],[13,1,"かた"],[16,1,"かみ"],[18,2,"えいこう"],[27,1,"しめ"],[34,1,"はな"],[47,1,"はな"],[58,1,"したが"],[67,1,"い"]],"text":"これは、ペテロがどんな死に方で、神の栄光をあらわすかを示すために、お話しになったのである。こう話してから、「わたしに従ってきなさい」と言われた。"},{"ref":"John.21.20","start":43021020,"end":43021020,"break":"none","ruby":[[6,1,"かえ"],[14,1,"あい"],[21,2,"でし"],[27,1,"く"],[31,1,"み"],[36,2,"でし"],[42,2,"ゆうしょく"],[51,1,"むね"],[52,1,"ちか"],[55,1,"よ"],[63,1,"しゅ"],[70,2,"うらぎ"],[73,1,"もの"],[85,1,"たず"],[88,1,"ひと"]],"text":"ペテロはふり返ると、イエスの愛しておられた弟子がついて来るのを見た。この弟子は、あの夕食のときイエスの胸近くに寄りかかって、「主よ、あなたを裏切る者は、だれなのですか」と尋ねた人である。"},{"ref":"John.21.21","start":43021021,"end":43021021,"break":"none","ruby":[[6,2,"でし"],[9,1,"み"],[16,1,"い"],[21,1,"しゅ"],[26,1,"ひと"]],"text":"ペテロはこの弟子を見て、イエスに言った、「主よ、この人はどうなのですか」。"},{"ref":"John.21.22","start":43021022,"end":43021022,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[20,1,"く"],[22,1,"とき"],[25,1,"かれ"],[27,1,"い"],[29,1,"のこ"],[42,1,"のぞ"],[58,1,"かか"],[75,1,"したが"]],"text":"イエスは彼に言われた、「たとい、わたしの来る時まで彼が生き残っていることを、わたしが望んだとしても、あなたにはなんの係わりがあるか。あなたは、わたしに従ってきなさい」。"},{"ref":"John.21.23","start":43021023,"end":43021023,"break":"none","ruby":[[10,2,"でし"],[13,1,"し"],[28,2,"きょうだい"],[33,1,"あいだ"],[49,1,"かれ"],[51,1,"し"],[59,1,"い"],[80,1,"く"],[82,1,"とき"],[85,1,"かれ"],[87,1,"い"],[89,1,"のこ"],[102,1,"のぞ"],[118,1,"かか"],[127,1,"い"]],"text":"こういうわけで、この弟子は死ぬことがないといううわさが、兄弟たちの間にひろまった。しかし、イエスは彼が死ぬことはないと言われたのではなく、ただ「たとい、わたしの来る時まで彼が生き残っていることを、わたしが望んだとしても、あなたにはなんの係わりがあるか」と言われただけである。"},{"ref":"John.21.24","start":43021024,"end":43021024,"break":"paragraph","ruby":[[4,1,"こと"],[21,1,"こと"],[23,1,"か"],[31,2,"でし"],[40,1,"かれ"],[46,2,"しんじつ"],[61,1,"し"]],"text":"これらの事についてあかしをし、またこれらの事を書いたのは、この弟子である。そして彼のあかしが真実であることを、わたしたちは知っている。"},{"ref":"John.21.25","start":43021025,"end":43021025,"break":"none","ruby":[[19,2,"かずおお"],[31,1,"か"],[40,2,"せかい"],[45,1,"か"],[49,2,"ぶんしょ"],[52,1,"おさ"],[63,1,"おも"]],"text":"イエスのなさったことは、このほかにまだ数多くある。もしいちいち書きつけるならば、世界もその書かれた文書を収めきれないであろうと思う。"}]