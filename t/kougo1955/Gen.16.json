[{"ref":"Gen.16.1","start":1016001,"end":1016001,"break":"paragraph","ruby":[[5,1,"つま"],[10,1,"こ"],[12,1,"う"],[19,2,"かのじょ"],[40,1,"おんな"],[42,1,"な"]],"text":"アブラムの妻サライは子を産まなかった。彼女にひとりのつかえめがあった。エジプトの女で名をハガルといった。"},{"ref":"Gen.16.2","start":1016002,"end":1016002,"break":"none","ruby":[[9,1,"い"],[14,1,"しゅ"],[20,1,"こ"],[23,1,"さづ"],[45,1,"ところ"],[56,2,"かのじょ"],[66,1,"こ"],[90,2,"ことば"],[93,1,"き"]],"text":"サライはアブラムに言った、「主はわたしに子をお授けになりません。どうぞ、わたしのつかえめの所におはいりください。彼女によってわたしは子をもつことになるでしょう」。アブラムはサライの言葉を聞きいれた。"},{"ref":"Gen.16.3","start":1016003,"end":1016003,"break":"none","ruby":[[5,1,"つま"],[21,1,"おんな"],[30,1,"おっと"],[36,1,"つま"],[40,1,"あた"],[56,1,"ち"],[59,1,"ねん"],[60,1,"す"],[63,1,"のち"]],"text":"アブラムの妻サライはそのつかえめエジプトの女ハガルをとって、夫アブラムに妻として与えた。これはアブラムがカナンの地に十年住んだ後であった。"},{"ref":"Gen.16.4","start":1016004,"end":1016004,"break":"none","ruby":[[0,1,"かれ"],[6,1,"ところ"],[16,1,"こ"],[23,2,"かのじょ"],[26,2,"じぶん"],[35,1,"み"],[38,1,"おんな"],[39,2,"しゅじん"],[42,2,"みさ"]],"text":"彼はハガルの所にはいり、ハガルは子をはらんだ。彼女は自分のはらんだのを見て、女主人を見下げるようになった。"},{"ref":"Gen.16.5","start":1016005,"end":1016005,"break":"none","ruby":[[12,1,"い"],[21,1,"う"],[24,1,"がい"],[30,2,"せきにん"],[53,1,"あた"],[59,2,"かのじょ"],[62,2,"じぶん"],[71,1,"み"],[78,2,"み"],[89,1,"しゅ"],[99,1,"あいだ"]],"text":"そこでサライはアブラムに言った、「わたしが受けた害はあなたの責任です。わたしのつかえめをあなたのふところに与えたのに、彼女は自分のはらんだのを見て、わたしを見下さげます。どうか、主があなたとわたしの間をおさばきになるように」。"},{"ref":"Gen.16.6","start":1016006,"end":1016006,"break":"none","ruby":[[9,1,"い"],[27,1,"て"],[39,1,"す"],[45,2,"かのじょ"],[61,2,"かのじょ"],[64,1,"くる"],[71,2,"かのじょ"],[78,1,"かお"],[80,1,"さ"],[83,1,"に"]],"text":"アブラムはサライに言った、「あなたのつかえめはあなたの手のうちにある。あなたの好きなように彼女にしなさい」。そしてサライが彼女を苦しめたので、彼女はサライの顔を避けて逃げた。"},{"ref":"Gen.16.7","start":1016007,"end":1016007,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,2,"あらの"],[9,1,"いずみ"],[23,1,"みち"],[27,1,"いずみ"],[34,2,"かのじょ"],[37,1,"あ"]],"text":"主の使は荒野にある泉のほとり、すなわちシュルの道にある泉のほとりで、彼女に会い、"},{"ref":"Gen.16.8","start":1016008,"end":1016008,"break":"none","ruby":[[3,1,"い"],[41,1,"い"],[49,2,"かのじょ"],[52,1,"い"],[61,1,"おんな"],[62,2,"しゅじん"],[68,1,"かお"],[70,1,"さ"],[73,1,"に"]],"text":"そして言った、「サライのつかえめハガルよ、あなたはどこからきたのですか、またどこへ行くのですか」。彼女は言った、「わたしは女主人サライの顔を避けて逃げているのです」。"},{"ref":"Gen.16.9","start":1016009,"end":1016009,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,2,"かのじょ"],[7,1,"い"],[16,1,"おんな"],[17,2,"しゅじん"],[23,1,"かえ"],[29,1,"て"],[31,1,"み"],[33,1,"まか"]],"text":"主の使は彼女に言った、「あなたは女主人のもとに帰って、その手に身を任せなさい」。"},{"ref":"Gen.16.10","start":1016010,"end":1016010,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[6,2,"かのじょ"],[9,1,"い"],[18,1,"おお"],[25,2,"しそん"],[28,1,"ま"],[32,1,"かぞ"],[41,1,"おお"]],"text":"主の使はまた彼女に言った、「わたしは大いにあなたの子孫を増して、数えきれないほどに多くしましょう」。"},{"ref":"Gen.16.11","start":1016011,"end":1016011,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[6,2,"かのじょ"],[9,1,"い"],[32,1,"おとこ"],[34,1,"こ"],[36,1,"う"],[43,1,"な"],[51,1,"な"],[58,1,"しゅ"],[64,1,"くる"],[68,1,"き"]],"text":"主の使はまた彼女に言った、「あなたは、みごもっています。あなたは男の子を産むでしょう。名をイシマエルと名づけなさい。主があなたの苦しみを聞かれたのです。"},{"ref":"Gen.16.12","start":1016012,"end":1016012,"break":"none","ruby":[[0,1,"かれ"],[2,1,"の"],[9,1,"ひと"],[16,1,"て"],[22,1,"ひと"],[24,1,"さか"],[32,1,"ひと"],[34,1,"て"],[36,1,"かれ"],[38,1,"さか"],[42,1,"かれ"],[48,2,"きょうだい"],[51,1,"てき"],[54,1,"す"]],"text":"彼は野ろばのような人となり、その手はすべての人に逆らい、すべての人の手は彼に逆らい、彼はすべての兄弟に敵して住むでしょう」。"},{"ref":"Gen.16.13","start":1016013,"end":1016013,"break":"none","ruby":[[8,2,"じぶん"],[11,1,"かた"],[15,1,"しゅ"],[17,1,"な"],[19,1,"よ"],[37,1,"い"],[41,2,"かのじょ"],[54,1,"み"],[67,1,"おが"],[74,1,"い"]],"text":"そこで、ハガルは自分に語られた主の名を呼んで、「あなたはエル・ロイです」と言った。彼女が「ここでも、わたしを見ていられるかたのうしろを拝めたのか」と言ったことによる。"},{"ref":"Gen.16.14","start":1016014,"end":1016014,"break":"none","ruby":[[5,2,"いど"],[21,1,"よ"],[37,1,"あいだ"]],"text":"それでその井戸は「ベエル・ラハイ・ロイ」と呼ばれた。これはカデシとベレデの間にある。"},{"ref":"Gen.16.15","start":1016015,"end":1016015,"break":"paragraph","ruby":[[9,1,"おとこ"],[11,1,"こ"],[13,1,"う"],[26,1,"う"],[29,1,"こ"],[31,1,"な"],[39,1,"な"]],"text":"ハガルはアブラムに男の子を産んだ。アブラムはハガルが産んだ子の名をイシマエルと名づけた。"},{"ref":"Gen.16.16","start":1016016,"end":1016016,"break":"none","ruby":[[15,1,"う"],[18,1,"とき"],[28,1,"さい"]],"text":"ハガルがイシマエルをアブラムに産んだ時、アブラムは八十六歳であった。"}]