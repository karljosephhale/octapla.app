[{"ref":"Ps.96.1","start":19096001,"end":19096001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[0,1,"あたら"],[3,1,"うた"],[5,1,"しゅ"],[15,1,"ぜん"],[16,1,"ち"],[19,1,"しゅ"]],"text":"新しい歌を主にむかってうたえ。全地よ、主にむかってうたえ。"},{"ref":"Ps.96.2","start":19096002,"end":19096002,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"うた"],[12,1,"な"],[18,1,"ひ"],[24,1,"すくい"],[26,1,"の"],[28,1,"つた"]],"text":"主にむかって歌い、そのみ名をほめよ。日ごとにその救を宣べ伝えよ。"},{"ref":"Ps.96.3","start":19096003,"end":19096003,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"くに"],[7,1,"なか"],[11,2,"えいこう"],[24,1,"たみ"],[26,1,"なか"]],"text":"もろもろの国の中にその栄光をあらわし、もろもろの民の中にそのくすしきみわざをあらわせ。"},{"ref":"Ps.96.4","start":19096004,"end":19096004,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おお"],[6,1,"かみ"],[30,1,"かみ"],[36,1,"おそ"],[40,1,"もの"]],"text":"主は大いなる神であって、いともほめたたうべきもの、もろもろの神にまさって恐るべき者である。"},{"ref":"Ps.96.5","start":19096005,"end":19096005,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"たみ"],[11,1,"かみ"],[21,1,"しゅ"],[28,1,"てん"],[30,1,"つく"]],"text":"もろもろの民のすべての神はむなしい。しかし主はもろもろの天を造られた。"},{"ref":"Ps.96.6","start":19096006,"end":19096006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ほまれ"],[3,2,"いげん"],[10,1,"まえ"],[15,1,"ちから"],[27,2,"せいじょ"]],"text":"誉と、威厳とはそのみ前にあり、力と、うるわしさとはその聖所にある。"},{"ref":"Ps.96.7","start":19096007,"end":19096007,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"たみ"],[12,1,"しゅ"],[14,1,"き"],[18,2,"えいこう"],[21,1,"ちから"],[24,1,"しゅ"],[26,1,"き"]],"text":"もろもろの民のやからよ、主に帰せよ、栄光と力とを主に帰せよ。"},{"ref":"Ps.96.8","start":19096008,"end":19096008,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"な"],[10,2,"えいこう"],[13,1,"しゅ"],[15,1,"き"],[19,1,"そな"],[21,1,"もの"],[23,1,"たずさ"],[28,2,"おおにわ"]],"text":"そのみ名にふさわしい栄光を主に帰せよ。供え物を携えてその大庭にきたれ。"},{"ref":"Ps.96.9","start":19096009,"end":19096009,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"せい"],[3,1,"よそお"],[8,1,"しゅ"],[10,1,"おが"],[13,1,"ぜん"],[14,1,"ち"],[20,1,"まえ"]],"text":"聖なる装いをして主を拝め、全地よ、そのみ前におののけ。"},{"ref":"Ps.96.10","start":19096010,"end":19096010,"break":"line","breaks":[[13,"line"],[23,"line"],[43,"line"]],"ruby":[[5,2,"くにたみ"],[8,1,"なか"],[10,1,"い"],[14,1,"しゅ"],[16,1,"おう"],[23,2,"せかい"],[26,1,"かた"],[28,1,"た"],[32,1,"うご"],[43,1,"しゅ"],[45,2,"こうへい"],[56,1,"たみ"]],"text":"もろもろの国民の中に言え、「主は王となられた。世界は堅く立って、動かされることはない。主は公平をもってもろもろの民をさばかれる」と。"},{"ref":"Ps.96.11","start":19096011,"end":19096011,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"てん"],[2,1,"よろこ"],[5,1,"ち"],[7,1,"たの"],[11,1,"うみ"],[15,1,"なか"],[17,1,"み"],[24,1,"な"]],"text":"天は喜び、地は楽しみ、海とその中に満ちるものとは鳴りどよめき、"},{"ref":"Ps.96.12","start":19096012,"end":19096012,"break":"line","breaks":[[19,"line"],[33,"line"]],"ruby":[[0,2,"たはた"],[5,1,"なか"],[11,1,"もの"],[13,1,"おお"],[16,1,"よろこ"],[24,1,"はやし"],[31,1,"き"],[33,1,"しゅ"],[36,1,"まえ"],[38,1,"よろこ"],[40,1,"うた"]],"text":"田畑とその中のすべての物は大いに喜べ。そのとき、林のもろもろの木も主のみ前に喜び歌うであろう。"},{"ref":"Ps.96.13","start":19096013,"end":19096013,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"こ"],[7,1,"ち"],[15,1,"こ"],[20,1,"しゅ"],[22,1,"ぎ"],[27,2,"せかい"],[46,1,"たみ"]],"text":"主は来られる、地をさばくために来られる。主は義をもって世界をさばき、まことをもってもろもろの民をさばかれる。"}]