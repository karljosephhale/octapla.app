[{"ref":"Exod.12.1","start":2012001,"end":2012001,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"くに"],[18,1,"つ"],[21,1,"い"]],"text":"主はエジプトの国で、モーセとアロンに告げて言われた、"},{"ref":"Exod.12.2","start":2012002,"end":2012002,"break":"none","ruby":[[3,1,"つき"],[11,1,"はじ"],[14,1,"つき"],[21,1,"とし"],[23,2,"しょうがつ"]],"text":"「この月をあなたがたの初めの月とし、これを年の正月としなさい。"},{"ref":"Exod.12.3","start":2012003,"end":2012003,"break":"none","ruby":[[12,1,"ぜん"],[13,2,"かいしゅう"],[16,1,"い"],[25,1,"つき"],[28,1,"か"],[37,1,"ちち"],[39,1,"いえ"],[43,2,"こひつじ"],[46,1,"と"],[63,2,"かぞく"],[66,2,"こひつじ"],[69,1,"とう"],[71,1,"と"]],"text":"あなたがたはイスラエルの全会衆に言いなさい、『この月の十日におのおの、その父の家ごとに小羊を取らなければならない。すなわち、一家族に小羊一頭を取らなければならない。"},{"ref":"Exod.12.4","start":2012004,"end":2012004,"break":"none","ruby":[[2,2,"かぞく"],[5,1,"すく"],[10,1,"とう"],[12,2,"こひつじ"],[15,1,"た"],[25,1,"いえ"],[29,1,"となり"],[31,1,"ひと"],[33,1,"とも"],[36,2,"にんずう"],[39,1,"したが"],[43,1,"とう"],[45,1,"と"],[52,1,"た"],[59,1,"おう"],[63,2,"こひつじ"],[66,2,"みはか"]],"text":"もし家族が少なくて一頭の小羊を食べきれないときは、家のすぐ隣の人と共に、人数に従って一頭を取り、おのおの食べるところに応じて、小羊を見計らわなければならない。"},{"ref":"Exod.12.5","start":2012005,"end":2012005,"break":"none","ruby":[[0,2,"こひつじ"],[3,1,"きず"],[12,1,"さい"],[14,1,"おす"],[25,1,"ひつじ"],[40,1,"と"]],"text":"小羊は傷のないもので、一歳の雄でなければならない。羊またはやぎのうちから、これを取らなければならない。"},{"ref":"Exod.12.6","start":2012006,"end":2012006,"break":"none","ruby":[[5,1,"つき"],[9,1,"か"],[16,1,"まも"],[19,1,"お"],[28,2,"かいしゅう"],[34,2,"ゆうぐれ"]],"text":"そしてこの月の十四日まで、これを守って置き、イスラエルの会衆はみな、夕暮にこれをほふり、"},{"ref":"Exod.12.7","start":2012007,"end":2012007,"break":"none","ruby":[[2,1,"ち"],[4,1,"と"],[7,2,"こひつじ"],[10,1,"しょく"],[13,1,"いえ"],[15,2,"いりぐち"],[21,1,"はしら"],[31,1,"ぬ"]],"text":"その血を取り、小羊を食する家の入口の二つの柱と、かもいにそれを塗らなければならない。"},{"ref":"Exod.12.8","start":2012008,"end":2012008,"break":"none","ruby":[[5,1,"よる"],[9,1,"にく"],[11,1,"ひ"],[13,1,"や"],[16,1,"た"],[19,1,"たね"],[20,1,"い"],[26,1,"にが"],[27,1,"な"],[29,1,"そ"],[32,1,"た"]],"text":"そしてその夜、その肉を火に焼いて食べ、種入れぬパンと苦菜を添えて食べなければならない。"},{"ref":"Exod.12.9","start":2012009,"end":2012009,"break":"none","ruby":[[0,1,"なま"],[4,1,"みず"],[6,1,"に"],[10,1,"た"],[19,1,"ひ"],[21,1,"や"],[27,1,"あたま"],[29,1,"あし"],[31,2,"ないぞう"],[34,1,"とも"],[36,1,"た"]],"text":"生でも、水で煮ても、食べてはならない。火に焼いて、その頭を足と内臓と共に食べなければならない。"},{"ref":"Exod.12.10","start":2012010,"end":2012010,"break":"none","ruby":[[0,1,"あさ"],[6,1,"のこ"],[18,1,"あさ"],[21,1,"のこ"],[26,1,"ひ"],[28,1,"や"]],"text":"朝までそれを残しておいてはならない。朝まで残るものは火で焼きつくさなければならない。"},{"ref":"Exod.12.11","start":2012011,"end":2012011,"break":"none","ruby":[[15,1,"た"],[30,1,"こし"],[32,1,"ひ"],[38,1,"あし"],[46,1,"て"],[51,1,"と"],[55,1,"いそ"],[61,1,"た"],[75,1,"しゅ"],[77,2,"すぎこし"]],"text":"あなたがたは、こうして、それを食べなければならない。すなわち腰を引きからげ、足にくつをはき、手につえを取って、急いでそれを食べなければならない。これは主の過越である。"},{"ref":"Exod.12.12","start":2012012,"end":2012012,"break":"none","ruby":[[2,1,"よる"],[12,1,"くに"],[14,1,"めぐ"],[23,1,"くに"],[27,1,"ひと"],[29,1,"けもの"],[41,1,"う"],[55,2,"かみがみ"],[58,2,"しんぱん"],[61,1,"おこな"],[72,1,"しゅ"]],"text":"その夜わたしはエジプトの国を巡って、エジプトの国におる人と獣との、すべてのういごを打ち、またエジプトのすべての神々に審判を行うであろう。わたしは主である。"},{"ref":"Exod.12.13","start":2012013,"end":2012013,"break":"none","ruby":[[2,1,"ち"],[12,2,"いえいえ"],[39,1,"ち"],[41,1,"み"],[50,1,"ところ"],[52,1,"す"],[54,1,"こ"],[70,1,"くに"],[72,1,"う"],[74,1,"とき"],[76,1,"わざわい"],[78,1,"のぞ"],[88,1,"ほろ"]],"text":"その血はあなたがたのおる家々で、あなたがたのために、しるしとなり、わたしはその血を見て、あなたがたの所を過ぎ越すであろう。わたしがエジプトの国を撃つ時、災が臨んで、あなたがたを滅ぼすことはないであろう。"},{"ref":"Exod.12.14","start":2012014,"end":2012014,"break":"paragraph","ruby":[[2,1,"ひ"],[10,2,"きねん"],[22,1,"しゅ"],[24,1,"まつり"],[31,1,"まも"],[34,2,"よよ"],[37,2,"えいきゅう"],[40,1,"さだ"],[48,1,"まも"]],"text":"この日はあなたがたに記念となり、あなたがたは主の祭としてこれを守り、代々、永久の定めとしてこれを守らなければならない。"},{"ref":"Exod.12.15","start":2012015,"end":2012015,"break":"none","ruby":[[0,2,"なぬか"],[3,1,"あいだ"],[10,1,"たね"],[11,1,"い"],[17,1,"た"],[30,1,"はじ"],[33,1,"ひ"],[35,1,"いえ"],[40,1,"だね"],[42,1,"す"],[44,1,"のぞ"],[55,1,"だい"],[57,1,"にち"],[60,1,"だい"],[62,1,"にち"],[67,1,"たね"],[69,1,"い"],[75,1,"た"],[78,1,"ひと"],[89,1,"た"]],"text":"七日の間あなたがたは種入れぬパンを食べなければならない。その初めの日に家からパン種を取り除かなければならない。第一日から第七日までに、種を入れたパンを食べる人はみなイスラエルから断たれるであろう。"},{"ref":"Exod.12.16","start":2012016,"end":2012016,"break":"none","ruby":[[9,1,"だい"],[11,1,"にち"],[13,1,"せい"],[14,1,"かい"],[19,1,"だい"],[21,1,"にち"],[23,1,"せい"],[24,1,"かい"],[26,1,"ひら"],[41,1,"ひ"],[48,2,"しごと"],[67,1,"た"],[74,1,"つく"]],"text":"かつ、あなたがたは第一日に聖会を、また第七日に聖会を開かなければならない。これらの日には、なんの仕事もしてはならない。ただ、おのおのの食べものだけは作ることができる。"},{"ref":"Exod.12.17","start":2012017,"end":2012017,"break":"none","ruby":[[7,1,"たね"],[8,1,"い"],[14,1,"まつり"],[16,1,"まも"],[34,1,"ひ"],[46,2,"ぐんぜい"],[54,1,"くに"],[57,1,"みちび"],[59,1,"だ"],[79,2,"よよ"],[82,2,"えいきゅう"],[85,1,"さだ"],[93,1,"ひ"],[95,1,"まも"]],"text":"あなたがたは、種入れぬパンの祭を守らなければならない。ちょうど、この日、わたしがあなたがたの軍勢をエジプトの国から導き出したからである。それゆえ、あなたがたは代々、永久の定めとして、その日を守らなければならない。"},{"ref":"Exod.12.18","start":2012018,"end":2012018,"break":"none","ruby":[[0,2,"しょうがつ"],[6,1,"つき"],[10,1,"か"],[12,2,"ゆうがた"],[22,1,"たね"],[23,1,"い"],[29,1,"た"],[34,1,"つき"],[39,1,"にち"],[41,2,"ゆうがた"],[45,1,"つづ"]],"text":"正月に、その月の十四日の夕方に、あなたがたは種入れぬパンを食べ、その月の二十一日の夕方まで続けなければならない。"},{"ref":"Exod.12.19","start":2012019,"end":2012019,"break":"none","ruby":[[0,2,"なぬか"],[3,1,"あいだ"],[5,1,"いえ"],[9,1,"だね"],[11,1,"お"],[20,1,"たね"],[22,1,"い"],[28,1,"た"],[31,1,"もの"],[34,2,"きりゅう"],[37,2,"たこく"],[39,1,"じん"],[44,1,"くに"],[46,1,"うま"],[49,1,"もの"],[64,2,"かいしゅう"],[68,1,"た"]],"text":"七日の間、家にパン種を置いてはならない。種を入れたものを食べる者は、寄留の他国人であれ、国に生れた者であれ、すべて、イスラエルの会衆から断たれるであろう。"},{"ref":"Exod.12.20","start":2012020,"end":2012020,"break":"none","ruby":[[6,1,"たね"],[8,1,"い"],[14,1,"なに"],[16,1,"た"],[41,1,"たね"],[42,1,"い"],[48,1,"た"]],"text":"あなたがたは種を入れたものは何も食べてはならない。すべてあなたがたのすまいにおいて種入れぬパンを食べなければならない』」。"},{"ref":"Exod.12.21","start":2012021,"end":2012021,"break":"paragraph","ruby":[[13,2,"ちょうろう"],[18,1,"よ"],[20,1,"よ"],[23,1,"い"],[34,1,"いそ"],[37,2,"かぞく"],[45,2,"こひつじ"],[48,1,"と"],[53,2,"すぎこし"],[56,1,"けもの"]],"text":"そこでモーセはイスラエルの長老をみな呼び寄せて言った、「あなたがたは急いで家族ごとに一つの小羊を取り、その過越の獣をほふらなければならない。"},{"ref":"Exod.12.22","start":2012022,"end":2012022,"break":"none","ruby":[[3,1,"たば"],[9,1,"と"],[12,1,"はち"],[14,1,"ち"],[16,1,"ひた"],[19,1,"はち"],[21,1,"ち"],[28,2,"いりぐち"],[34,1,"はしら"],[47,1,"あさ"],[61,1,"いえ"],[63,1,"と"],[65,1,"そと"],[67,1,"で"]],"text":"また一束のヒソプを取って鉢の血に浸し、鉢の血を、かもいと入口の二つの柱につけなければならない。朝まであなたがたは、ひとりも家の戸の外に出てはならない。"},{"ref":"Exod.12.23","start":2012023,"end":2012023,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[4,1,"めぐ"],[14,1,"う"],[25,2,"いりぐち"],[31,1,"はしら"],[35,1,"ち"],[37,1,"み"],[40,1,"しゅ"],[44,2,"いりぐち"],[47,1,"す"],[49,1,"こ"],[52,1,"ほろ"],[55,1,"もの"],[64,1,"いえ"],[71,1,"う"],[75,1,"ゆる"]],"text":"主が行き巡ってエジプトびとを撃たれるとき、かもいと入口の二つの柱にある血を見て、主はその入口を過ぎ越し、滅ぼす者が、あなたがたの家にはいって、撃つのを許されないであろう。"},{"ref":"Exod.12.24","start":2012024,"end":2012024,"break":"none","ruby":[[8,1,"こと"],[15,2,"しそん"],[21,1,"さだ"],[27,2,"えいきゅう"],[30,1,"まも"]],"text":"あなたがたはこの事を、あなたと子孫のための定めとして、永久に守らなければならない。"},{"ref":"Exod.12.25","start":2012025,"end":2012025,"break":"none","ruby":[[7,1,"しゅ"],[9,2,"やくそく"],[24,1,"たまわ"],[26,1,"ち"],[28,1,"いた"],[35,2,"ぎしき"],[38,1,"まも"]],"text":"あなたがたは、主が約束されたように、あなたがたに賜る地に至るとき、この儀式を守らなければならない。"},{"ref":"Exod.12.26","start":2012026,"end":2012026,"break":"none","ruby":[[9,2,"こども"],[17,2,"ぎしき"],[23,2,"いみ"],[30,1,"と"]],"text":"もし、あなたがたの子供たちが『この儀式はどんな意味ですか』と問うならば、"},{"ref":"Exod.12.27","start":2012027,"end":2012027,"break":"none","ruby":[[6,1,"い"],[16,1,"しゅ"],[18,2,"すぎこし"],[21,2,"ぎせい"],[34,1,"う"],[54,2,"ひとびと"],[57,1,"いえ"],[59,1,"す"],[61,1,"こ"],[70,1,"いえ"],[72,1,"すく"],[83,1,"たみ"],[90,1,"ふ"],[93,2,"れいはい"]],"text":"あなたがたは言いなさい、『これは主の過越の犠牲である。エジプトびとを撃たれたとき、エジプトにいたイスラエルの人々の家を過ぎ越して、われわれの家を救われたのである』」。民はこのとき、伏して礼拝した。"},{"ref":"Exod.12.28","start":2012028,"end":2012028,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"い"],[24,1,"しゅ"],[34,1,"めい"]],"text":"イスラエルの人々は行ってそのようにした。すなわち主がモーセとアロンに命じられたようにした。"},{"ref":"Exod.12.29","start":2012029,"end":2012029,"break":"paragraph","ruby":[[0,2,"よなか"],[6,1,"しゅ"],[13,1,"くに"],[28,1,"くらい"],[30,1,"ざ"],[42,2,"ちか"],[51,2,"ほりょ"],[71,2,"かちく"],[78,1,"う"]],"text":"夜中になって主はエジプトの国の、すべてのういご、すなわち位に座するパロのういごから、地下のひとやにおる捕虜のういごにいたるまで、また、すべての家畜のういごを撃たれた。"},{"ref":"Exod.12.30","start":2012030,"end":2012030,"break":"none","ruby":[[8,2,"けらい"],[22,1,"よる"],[27,1,"お"],[38,1,"おお"],[42,1,"さけ"],[49,2,"しにん"],[54,1,"いえ"]],"text":"それでパロとその家来およびエジプトびとはみな夜のうちに起きあがり、エジプトに大いなる叫びがあった。死人のない家がなかったからである。"},{"ref":"Exod.12.31","start":2012031,"end":2012031,"break":"none","ruby":[[6,1,"よる"],[19,1,"よ"],[21,1,"よ"],[24,1,"い"],[41,2,"ひとびと"],[44,1,"た"],[52,1,"たみ"],[54,1,"なか"],[57,1,"で"],[59,1,"い"],[74,1,"い"],[80,1,"い"],[83,1,"しゅ"],[85,1,"つか"]],"text":"そこでパロは夜のうちにモーセとアロンを呼び寄せて言った、「あなたがたとイスラエルの人々は立って、わたしの民の中から出て行くがよい。そしてあなたがたの言うように、行って主に仕えなさい。"},{"ref":"Exod.12.32","start":2012032,"end":2012032,"break":"none","ruby":[[6,1,"い"],[11,1,"ひつじ"],[13,1,"うし"],[16,1,"と"],[19,1,"い"],[32,2,"しゅくふく"]],"text":"あなたがたの言うように羊と牛とを取って行きなさい。また、わたしを祝福しなさい」。"},{"ref":"Exod.12.33","start":2012033,"end":2012033,"break":"paragraph","ruby":[[11,1,"たみ"],[15,1,"た"],[24,1,"くに"],[26,1,"さ"],[35,1,"かれ"],[46,1,"し"],[50,1,"おも"]],"text":"こうしてエジプトびとは民をせき立てて、すみやかに国を去らせようとした。彼らは「われわれはみな死ぬ」と思ったからである。"},{"ref":"Exod.12.34","start":2012034,"end":2012034,"break":"none","ruby":[[0,1,"たみ"],[6,1,"だね"],[8,1,"い"],[12,1,"ね"],[14,1,"こ"],[23,2,"きもの"],[26,1,"つつ"],[29,1,"かた"],[31,1,"お"]],"text":"民はまだパン種を入れない練り粉を、こばちのまま着物に包んで肩に負った。"},{"ref":"Exod.12.35","start":2012035,"end":2012035,"break":"none","ruby":[[9,2,"ひとびと"],[16,2,"ことば"],[33,1,"ぎん"],[35,1,"かざ"],[38,1,"きん"],[40,1,"かざ"],[45,2,"いふく"],[48,1,"こ"],[50,1,"もと"]],"text":"そしてイスラエルの人々はモーセの言葉のようにして、エジプトびとから銀の飾り、金の飾り、また衣服を請い求めた。"},{"ref":"Exod.12.36","start":2012036,"end":2012036,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"たみ"],[11,1,"じょう"],[13,1,"え"],[17,1,"かれ"],[20,1,"こ"],[22,1,"もと"],[28,1,"あた"],[40,1,"かれ"],[53,1,"うば"],[55,1,"と"]],"text":"主は民にエジプトびとの情を得させ、彼らの請い求めたものを与えさせられた。こうして彼らはエジプトびとのものを奪い取った。"},{"ref":"Exod.12.37","start":2012037,"end":2012037,"break":"paragraph","ruby":[[9,2,"ひとびと"],[17,2,"しゅったつ"],[25,1,"む"],[30,1,"おんな"],[32,2,"こども"],[35,1,"のぞ"],[38,2,"とほ"],[41,2,"だんし"],[44,1,"やく"],[48,1,"にん"]],"text":"さて、イスラエルの人々はラメセスを出立してスコテに向かった。女と子供を除いて徒歩の男子は約六十万人であった。"},{"ref":"Exod.12.38","start":2012038,"end":2012038,"break":"none","ruby":[[2,1,"おお"],[5,1,"い"],[7,1,"ま"],[11,2,"ぐんしゅう"],[16,1,"ひつじ"],[18,1,"うし"],[21,2,"ひじょう"],[24,1,"おお"],[27,2,"かちく"],[30,1,"かれ"],[33,1,"とも"],[35,1,"のぼ"]],"text":"また多くの入り混じった群衆および羊、牛など非常に多くの家畜も彼らと共に上った。"},{"ref":"Exod.12.39","start":2012039,"end":2012039,"break":"none","ruby":[[3,1,"かれ"],[12,1,"たずさ"],[15,1,"で"],[17,1,"ね"],[19,1,"こ"],[25,1,"たね"],[26,1,"い"],[32,2,"かし"],[35,1,"や"],[43,1,"だね"],[45,1,"い"],[62,1,"かれ"],[71,1,"お"],[73,1,"だ"],[77,1,"とどこお"],[89,1,"なに"],[91,2,"しょくりょう"],[95,1,"ととの"]],"text":"そして彼らはエジプトから携えて出た練り粉をもって、種入れぬパンの菓子を焼いた。まだパン種を入れていなかったからである。それは彼らがエジプトから追い出されて滞ることができず、また、何の食料をも整えていなかったからである。"},{"ref":"Exod.12.40","start":2012040,"end":2012040,"break":"paragraph","ruby":[[6,2,"ひとびと"],[14,1,"す"],[19,1,"あいだ"],[26,1,"ねん"]],"text":"イスラエルの人々がエジプトに住んでいた間は、四百三十年であった。"},{"ref":"Exod.12.41","start":2012041,"end":2012041,"break":"none","ruby":[[4,1,"ねん"],[6,1,"おわ"],[19,1,"ひ"],[22,1,"しゅ"],[24,1,"ぜん"],[25,1,"ぐん"],[32,1,"くに"],[34,1,"で"]],"text":"四百三十年の終りとなって、ちょうどその日に、主の全軍はエジプトの国を出た。"},{"ref":"Exod.12.42","start":2012042,"end":2012042,"break":"none","ruby":[[3,1,"かれ"],[11,1,"くに"],[14,1,"みちび"],[16,1,"だ"],[21,1,"しゅ"],[23,1,"ね"],[26,1,"ばん"],[31,1,"よる"],[42,1,"よる"],[54,2,"ひとびと"],[57,2,"よよ"],[60,1,"しゅ"],[65,1,"ね"],[68,1,"ばん"]],"text":"これは彼らをエジプトの国から導き出すために主が寝ずの番をされた夜であった。ゆえにこの夜、すべてのイスラエルの人々は代々、主のために寝ずの番をしなければならない。"},{"ref":"Exod.12.43","start":2012043,"end":2012043,"break":"paragraph","ruby":[[0,1,"しゅ"],[11,1,"い"],[17,2,"すぎこし"],[20,1,"まつり"],[22,1,"さだ"],[25,1,"つぎ"],[39,3,"いほうじん"],[49,1,"た"]],"text":"主はモーセとアロンとに言われた、「過越の祭の定めは次のとおりである。すなわち、異邦人はだれもこれを食べてはならない。"},{"ref":"Exod.12.44","start":2012044,"end":2012044,"break":"none","ruby":[[9,1,"かね"],[11,1,"か"],[22,2,"かつれい"],[25,1,"い"],[34,1,"た"]],"text":"しかし、おのおのが金で買ったしもべは、これに割礼を行ってのち、これを食べさせることができる。"},{"ref":"Exod.12.45","start":2012045,"end":2012045,"break":"none","ruby":[[0,1,"かり"],[5,1,"もの"],[8,2,"やといにん"],[16,1,"た"]],"text":"仮ずまいの者と、雇人とは、これを食べてはならない。"},{"ref":"Exod.12.46","start":2012046,"end":2012046,"break":"none","ruby":[[4,1,"いえ"],[9,1,"た"],[22,1,"にく"],[24,1,"すこ"],[27,1,"いえ"],[29,1,"そと"],[31,1,"も"],[33,1,"だ"],[47,1,"ほね"],[49,1,"お"]],"text":"ひとつの家でこれを食べなければならない。その肉を少しも家の外に持ち出してはならない。また、その骨を折ってはならない。"},{"ref":"Exod.12.47","start":2012047,"end":2012047,"break":"none","ruby":[[6,1,"ぜん"],[7,2,"かいしゅう"],[13,1,"まも"]],"text":"イスラエルの全会衆はこれを守らなければならない。"},{"ref":"Exod.12.48","start":2012048,"end":2012048,"break":"none","ruby":[[0,2,"きりゅう"],[3,2,"がいこく"],[5,1,"じん"],[22,1,"しゅ"],[24,2,"すぎこし"],[27,1,"まつり"],[29,1,"まも"],[41,2,"だんし"],[46,2,"かつれい"],[49,1,"う"],[55,1,"ちか"],[62,1,"まも"],[76,1,"かれ"],[78,1,"くに"],[80,1,"うま"],[83,1,"もの"],[99,1,"む"],[100,2,"かつれい"],[103,1,"もの"],[111,1,"た"]],"text":"寄留の外国人があなたのもとにとどまっていて、主に過越の祭を守ろうとするときは、その男子はみな割礼を受けてのち、近づいてこれを守ることができる。そうすれば彼は国に生れた者のようになるであろう。しかし、無割礼の者はだれもこれを食べてはならない。"},{"ref":"Exod.12.49","start":2012049,"end":2012049,"break":"none","ruby":[[2,2,"りっぽう"],[5,1,"くに"],[7,1,"うま"],[24,2,"きりゅう"],[30,2,"がいこく"],[32,1,"じん"],[35,2,"どういつ"]],"text":"この律法は国に生れたものにも、あなたがたのうちに寄留している外国人にも同一である」。"},{"ref":"Exod.12.50","start":2012050,"end":2012050,"break":"paragraph","ruby":[[6,2,"ひとびと"],[19,1,"しゅ"],[29,1,"めい"]],"text":"イスラエルの人々は、みなこのようにし、主がモーセとアロンに命じられたようにした。"},{"ref":"Exod.12.51","start":2012051,"end":2012051,"break":"none","ruby":[[6,1,"ひ"],[9,1,"しゅ"],[17,2,"ひとびと"],[23,2,"ぐんだん"],[26,1,"したが"],[34,1,"くに"],[37,1,"みちび"],[39,1,"だ"]],"text":"ちょうどその日に、主はイスラエルの人々を、その軍団に従ってエジプトの国から導き出された。"}]