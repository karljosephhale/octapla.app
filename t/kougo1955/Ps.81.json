[{"ref":"Ps.81.1","start":19081001,"end":19081001,"break":"paragraph","title":"聖歌隊の指揮者によってギテトのしらべにあわせてうたわせたアサフの歌","breaks":[[20,"line"]],"ruby":[[4,1,"ちから"],[7,1,"かみ"],[13,1,"たか"],[17,1,"うた"],[24,1,"かみ"],[30,1,"よろこ"],[33,1,"こえ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[32,1,"うた"]],"text":"われらの力なる神にむかって高らかに歌え。ヤコブの神にむかって喜びの声をあげよ。"},{"ref":"Ps.81.2","start":19081002,"end":19081002,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"うた"],[6,1,"つづみ"],[8,1,"う"],[11,1,"よ"],[13,1,"ね"],[15,1,"こと"],[17,2,"たてごと"]],"text":"歌をうたい、鼓を打て。良い音の琴と立琴とをかきならせ。"},{"ref":"Ps.81.3","start":19081003,"end":19081003,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"しんげつ"],[3,2,"まんげつ"],[10,1,"まつり"],[12,1,"ひ"],[19,1,"ふ"]],"text":"新月と満月とわれらの祭の日とにラッパを吹きならせ。"},{"ref":"Ps.81.4","start":19081004,"end":19081004,"break":"line","breaks":[[12,"line"]],"ruby":[[9,1,"さだ"],[16,1,"かみ"]],"text":"これはイスラエルの定め、ヤコブの神のおきてである。"},{"ref":"Ps.81.5","start":19081005,"end":19081005,"break":"line","breaks":[[19,"line"],[41,"line"]],"ruby":[[0,1,"かみ"],[2,1,"で"],[9,1,"くに"],[11,1,"せ"],[29,1,"た"],[51,1,"し"],[57,2,"ことば"],[60,1,"き"]],"text":"神が出てエジプトの国を攻められたとき、ヨセフのなかにこれを立てて、あかしとされた。わたしはかしこでまだ知らなかった言葉を聞いた、"},{"ref":"Ps.81.6","start":19081006,"end":19081006,"break":"line","breaks":[[19,"line"]],"ruby":[[9,1,"かた"],[12,2,"おもに"],[23,1,"て"],[29,1,"まぬか"]],"text":"「わたしはあなたの肩から重荷をのぞき、あなたの手をかごから免れさせた。"},{"ref":"Ps.81.7","start":19081007,"end":19081007,"break":"line","breaks":[[17,"line"],[29,"line"],[48,"line"]],"ruby":[[4,1,"なや"],[10,1,"よ"],[25,1,"すく"],[33,1,"かみなり"],[35,1,"かく"],[38,1,"ところ"],[45,1,"こた"],[52,1,"みず"],[63,1,"こころ"]],"text":"あなたが悩んだとき、呼ばわったのでわたしはあなたを救った。わたしは雷の隠れた所で、あなたに答え、メリバの水のほとりで、あなたを試みた。〔セラ"},{"ref":"Ps.81.8","start":19081008,"end":19081008,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"たみ"],[5,1,"き"],[16,2,"かんこく"],[36,1,"き"],[38,1,"したが"],[43,1,"のぞ"]],"text":"わが民よ、聞け、わたしはあなたに勧告する。イスラエルよ、あなたがわたしに聞き従うことを望む。"},{"ref":"Ps.81.9","start":19081009,"end":19081009,"break":"line","breaks":[[20,"line"]],"ruby":[[7,1,"た"],[9,1,"かみ"],[24,2,"がいこく"],[27,1,"かみ"],[29,1,"おが"]],"text":"あなたのうちに他の神があってはならない。あなたは外国の神を拝んではならない。"},{"ref":"Ps.81.10","start":19081010,"end":19081010,"break":"line","breaks":[[13,"line"],[33,"line"]],"ruby":[[9,1,"くに"],[19,1,"だ"],[26,1,"かみ"],[28,1,"しゅ"],[37,1,"くち"],[39,1,"ひろ"],[52,1,"み"]],"text":"わたしはエジプトの国から、あなたをつれ出したあなたの神、主である。あなたの口を広くあけよ、わたしはそれを満たそう。"},{"ref":"Ps.81.11","start":19081011,"end":19081011,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"たみ"],[11,1,"こえ"],[13,1,"き"],[15,1,"したが"],[29,1,"この"]],"text":"しかしわが民はわたしの声に聞き従わず、イスラエルはわたしを好まなかった。"},{"ref":"Ps.81.12","start":19081012,"end":19081012,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[9,1,"かれ"],[19,1,"こころ"],[27,1,"おも"],[33,1,"い"]],"text":"それゆえ、わたしは彼らをそのかたくなな心にまかせ、その思いのままに行くにまかせた。"},{"ref":"Ps.81.13","start":19081013,"end":19081013,"break":"line","breaks":[[17,"line"]],"ruby":[[6,1,"たみ"],[12,1,"き"],[14,1,"したが"],[25,1,"みち"],[27,1,"あゆ"],[32,1,"ほっ"]],"text":"わたしはわが民のわたしに聞き従い、イスラエルのわが道に歩むことを欲する。"},{"ref":"Ps.81.14","start":19081014,"end":19081014,"break":"line","breaks":[[17,"line"]],"ruby":[[9,1,"かれ"],[12,1,"てき"],[14,1,"したが"],[19,1,"て"],[21,1,"かれ"],[27,1,"む"]],"text":"わたしはすみやかに彼らの敵を従え、わが手を彼らのあだに向けよう。"},{"ref":"Ps.81.15","start":19081015,"end":19081015,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"にく"],[4,1,"もの"],[6,1,"かれ"],[9,1,"おそ"],[11,1,"したが"],[14,1,"かれ"],[17,1,"とき"],[24,1,"つづ"]],"text":"主を憎む者も彼らに恐れ従い、彼らの時はとこしえに続くであろう。"},{"ref":"Ps.81.16","start":19081016,"end":19081016,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"むぎ"],[6,1,"もっと"],[8,1,"よ"],[20,1,"やしな"],[23,1,"いわ"],[26,1,"で"],[28,1,"みつ"],[37,1,"あ"]],"text":"わたしは麦の最も良いものをもってあなたを養い、岩から出た蜜をもってあなたを飽かせるであろう」。"}]