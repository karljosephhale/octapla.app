[{"ref":"Neh.4.1","start":16004001,"end":16004001,"break":"paragraph","ruby":[[11,2,"じょうへき"],[14,1,"きず"],[18,1,"き"],[21,1,"いか"],[24,1,"おお"],[27,1,"いきどお"],[33,1,"ひと"]],"text":"サンバラテはわれわれが城壁を築くのを聞いて怒り、大いに憤ってユダヤ人をあざけった。"},{"ref":"Neh.4.2","start":16004002,"end":16004002,"break":"none","ruby":[[0,1,"かれ"],[4,2,"きょうだい"],[16,2,"へいたい"],[19,1,"まえ"],[21,1,"かた"],[24,1,"い"],[31,2,"よわよわ"],[38,1,"ひと"],[40,1,"なに"],[49,2,"じぶん"],[52,2,"さいこう"],[63,2,"ぎせい"],[78,1,"にち"],[80,1,"こと"],[82,1,"お"],[92,2,"ちりづか"],[95,1,"なか"],[97,1,"いし"],[102,1,"や"],[113,1,"と"],[118,1,"い"]],"text":"彼はその兄弟たちおよびサマリヤの兵隊の前で語って言った、「この弱々しいユダヤ人は何をしているのか。自分で再興しようとするのか。犠牲をささげようとするのか。一日で事を終えようとするのか。塵塚の中の石はすでに焼けているのに、これを取りだして生かそうとするのか」。"},{"ref":"Neh.4.3","start":16004003,"end":16004003,"break":"none","ruby":[[13,1,"かれ"],[22,1,"い"],[31,1,"かれ"],[34,1,"きず"],[39,2,"じょうへき"],[47,1,"ぴき"],[49,1,"のぼ"]],"text":"またアンモンびとトビヤは、彼のかたわらにいて言った、「そうだ、彼らの築いている城壁は、きつね一匹が上ってもくずれるであろう」と。"},{"ref":"Neh.4.4","start":16004004,"end":16004004,"break":"none","ruby":[[6,1,"かみ"],[9,1,"き"],[22,1,"あなど"],[30,1,"かれ"],[39,1,"かれ"],[46,1,"かえ"],[49,1,"かれ"],[52,2,"ほしゅう"],[55,1,"ち"],[61,1,"もの"]],"text":"「われわれの神よ、聞いてください。われわれは侮られています。彼らのはずかしめを彼らのこうべに返し、彼らを捕囚の地でぶんどり物にしてください。"},{"ref":"Neh.4.5","start":16004005,"end":16004005,"break":"none","ruby":[[0,1,"かれ"],[11,1,"かれ"],[14,1,"つみ"],[17,1,"まえ"],[20,1,"け"],[22,1,"さ"],[32,1,"かれ"],[35,1,"きず"],[37,1,"た"],[40,1,"もの"],[42,1,"まえ"],[48,1,"いか"]],"text":"彼らのとがをおおわず、彼らの罪をみ前から消し去らないでください。彼らは築き建てる者の前であなたを怒らせたからです」。"},{"ref":"Neh.4.6","start":16004006,"end":16004006,"break":"paragraph","ruby":[[9,2,"じょうへき"],[12,1,"きず"],[17,1,"いし"],[23,1,"あい"],[24,1,"つら"],[31,1,"たか"],[34,1,"なか"],[39,1,"たっ"],[43,1,"たみ"],[45,1,"こころ"],[50,1,"はたら"]],"text":"こうしてわれわれは城壁を築いたが、石がきはみな相連なって、その高さの半ばにまで達した。民が心をこめて働いたからである。"},{"ref":"Neh.4.7","start":16004007,"end":16004007,"break":"paragraph","ruby":[[43,2,"じょうへき"],[46,2,"しゅうり"],[49,2,"しんてん"],[55,1,"わ"],[57,1,"め"],[63,1,"はじ"],[67,1,"き"],[70,1,"おお"],[73,1,"いか"]],"text":"ところがサンバラテ、トビヤ、アラビヤびと、アンモンびと、アシドドびとらは、エルサレムの城壁の修理が進展し、その破れ目もふさがり始めたと聞いて大いに怒り、"},{"ref":"Neh.4.8","start":16004008,"end":16004008,"break":"none","ruby":[[0,1,"みな"],[1,1,"とも"],[3,1,"あい"],[14,1,"せ"],[20,1,"なか"],[22,2,"こんらん"],[25,1,"おこ"]],"text":"皆共に相はかり、エルサレムを攻めて、その中に混乱を起そうとした。"},{"ref":"Neh.4.9","start":16004009,"end":16004009,"break":"none","ruby":[[8,1,"かみ"],[10,1,"いの"],[15,2,"にちや"],[17,2,"みは"],[21,1,"お"],[24,1,"かれ"],[27,1,"そな"]],"text":"そこでわれわれは神に祈り、また日夜見張りを置いて彼らに備えた。"},{"ref":"Neh.4.10","start":16004010,"end":16004010,"break":"paragraph","ruby":[[2,1,"とき"],[9,1,"い"],[14,1,"に"],[16,1,"お"],[18,1,"もの"],[20,1,"ちから"],[22,1,"おとろ"],[30,1,"はい"],[31,1,"つち"],[47,2,"じょうへき"],[50,1,"きず"]],"text":"その時、ユダびとは言った、「荷を負う者の力は衰え、そのうえ、灰土がおびただしいので、われわれは城壁を築くことができない」。"},{"ref":"Neh.4.11","start":16004011,"end":16004011,"break":"none","ruby":[[7,1,"てき"],[9,1,"い"],[14,1,"かれ"],[17,1,"し"],[27,1,"み"],[34,1,"かれ"],[37,1,"なか"],[45,1,"かれ"],[48,1,"ころ"],[53,2,"こうじ"]],"text":"またわれわれの敵は言った、「彼らの知らないうちに、また見ないうちに、彼らの中にはいりこんで彼らを殺し、その工事をやめさせよう」。"},{"ref":"Neh.4.12","start":16004012,"end":16004012,"break":"none","ruby":[[2,1,"かれ"],[5,1,"ちか"],[8,1,"す"],[16,1,"ひと"],[24,1,"たび"],[31,1,"い"],[36,1,"かれ"],[41,1,"す"],[50,1,"ところ"],[58,1,"せ"],[60,1,"のぼ"]],"text":"また彼らの近くに住んでいるユダヤ人たちはきて、十度もわれわれに言った、「彼らはその住んでいるすべての所からわれわれに攻め上るでしょう」と。"},{"ref":"Neh.4.13","start":16004013,"end":16004013,"break":"none","ruby":[[7,1,"たみ"],[18,1,"ゆみ"],[20,1,"も"],[24,2,"じょうへき"],[27,1,"のち"],[29,1,"ひく"],[31,1,"ところ"],[37,2,"くうち"],[42,2,"かぞく"],[50,1,"た"]],"text":"そこでわたしは民につるぎ、やりおよび弓を持たせ、城壁の後の低い所、すなわち空地にその家族にしたがって立たせた。"},{"ref":"Neh.4.14","start":16004014,"end":16004014,"break":"none","ruby":[[4,1,"み"],[9,1,"た"],[12,1,"たっと"],[14,2,"ひとびと"],[28,1,"た"],[30,1,"たみ"],[33,1,"い"],[44,1,"かれ"],[47,1,"おそ"],[56,1,"おお"],[60,1,"おそ"],[64,1,"しゅ"],[66,1,"おぼ"],[75,2,"きょうだい"],[82,1,"むすめ"],[84,1,"つま"],[88,1,"いえ"],[93,1,"たたか"]],"text":"わたしは見めぐり、立って尊い人々、つかさたち、およびその他の民らに言った、「あなたがたは彼らを恐れてはならない。大いなる恐るべき主を覚え、あなたがたの兄弟、むすこ、娘、妻および家のために戦いなさい」。"},{"ref":"Neh.4.15","start":16004015,"end":16004015,"break":"paragraph","ruby":[[5,1,"てき"],[7,2,"じぶん"],[12,1,"こと"],[20,1,"さと"],[27,1,"き"],[32,1,"かみ"],[34,1,"かれ"],[37,1,"はか"],[42,1,"やぶ"],[49,1,"き"],[62,2,"じょうへき"],[65,1,"かえ"],[74,2,"こうじ"],[77,1,"つづ"]],"text":"われわれの敵は自分たちの事が、われわれに悟られたことを聞き、また神が彼らの計りごとを破られたことを聞いたので、われわれはみな城壁に帰り、おのおのその工事を続けた。"},{"ref":"Neh.4.16","start":16004016,"end":16004016,"break":"none","ruby":[[2,1,"ひ"],[5,1,"のち"],[16,2,"はんすう"],[19,2,"こうじ"],[22,1,"はたら"],[25,2,"はんすう"],[31,1,"たて"],[33,1,"ゆみ"],[42,2,"ぶそう"],[56,2,"じょうへき"],[59,1,"きず"],[67,2,"ぜんか"],[70,1,"うしろ"],[72,1,"た"]],"text":"その日から後は、わたしのしもべの半数は工事に働き、半数はやり、盾、弓、よろいをもって武装した。そしてつかさたちは城壁を築いているユダの全家の後に立った。"},{"ref":"Neh.4.17","start":16004017,"end":16004017,"break":"none","ruby":[[0,1,"に"],[2,1,"お"],[4,1,"はこ"],[6,1,"もの"],[12,2,"かたて"],[15,2,"こうじ"],[21,2,"かたて"],[24,2,"ぶき"],[27,1,"と"]],"text":"荷を負い運ぶ者はおのおの片手で工事をなし、片手に武器を執った。"},{"ref":"Neh.4.18","start":16004018,"end":16004018,"break":"none","ruby":[[0,1,"きず"],[2,1,"た"],[5,1,"もの"],[13,1,"こし"],[19,1,"お"],[22,1,"きず"],[24,1,"た"],[31,1,"ふ"],[33,1,"もの"]],"text":"築き建てる者はおのおのその腰につるぎを帯びて築き建て、ラッパを吹く者はわたしのかたわらにいた。"},{"ref":"Neh.4.19","start":16004019,"end":16004019,"break":"none","ruby":[[4,1,"たっと"],[6,2,"ひとびと"],[20,1,"た"],[22,1,"たみ"],[24,1,"い"],[29,2,"こうじ"],[32,1,"おお"],[37,1,"ひろ"],[51,2,"じょうへき"],[54,1,"うえ"],[56,1,"たがい"],[58,1,"とお"],[60,1,"はな"]],"text":"わたしは尊い人々、つかさたち、およびその他の民に言った、「工事は大きくかつ広がっているので、われわれは城壁の上で互に遠く離れている。"},{"ref":"Neh.4.20","start":16004020,"end":16004020,"break":"none","ruby":[[9,1,"おと"],[11,1,"き"],[27,1,"ところ"],[29,1,"あつ"],[42,1,"かみ"],[52,1,"たたか"]],"text":"どこででもラッパの音を聞いたなら、そこにいるわれわれの所に集まってほしい。われわれの神はわれわれのために戦われます」。"},{"ref":"Neh.4.21","start":16004021,"end":16004021,"break":"paragraph","ruby":[[13,2,"こうじ"],[16,1,"すす"],[21,2,"はんすう"],[24,1,"もの"],[26,2,"よあ"],[31,1,"ほし"],[33,1,"で"],[35,1,"とき"],[42,1,"と"]],"text":"このようにして、われわれは工事を進めたが、半数の者は夜明けから星の出る時まで、やりを執っていた。"},{"ref":"Neh.4.22","start":16004022,"end":16004022,"break":"none","ruby":[[2,1,"とき"],[9,1,"たみ"],[11,1,"つ"],[26,1,"とも"],[34,1,"うち"],[36,1,"やど"],[39,1,"よる"],[46,3,"ごえいしゃ"],[53,1,"ひる"],[55,2,"こうじ"],[65,1,"い"]],"text":"その時わたしはまた民に告げて、「おのおのそのしもべと共にエルサレムの内に宿り、夜はわれわれの護衛者となり、昼は工事をするように」と言った。"},{"ref":"Neh.4.23","start":16004023,"end":16004023,"break":"none","ruby":[[13,2,"きょうだい"],[34,2,"ごえい"],[38,2,"ひとびと"],[56,1,"ころも"],[58,1,"ぬ"],[66,1,"て"],[68,2,"ぶき"],[71,1,"と"]],"text":"そして、わたしも、わたしの兄弟たちも、わたしのしもべたちも、わたしを護衛する人々も、われわれのうちひとりも、その衣を脱がず、おのおの手に武器を執っていた。"}]