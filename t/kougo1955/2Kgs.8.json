[{"ref":"2Kgs.8.1","start":12008001,"end":12008001,"break":"paragraph","ruby":[[11,1,"こ"],[13,1,"い"],[23,1,"おんな"],[25,1,"い"],[43,1,"た"],[51,2,"かぞく"],[54,1,"とも"],[56,1,"い"],[59,2,"きりゅう"],[65,1,"おも"],[67,1,"ところ"],[69,2,"きりゅう"],[76,1,"しゅ"],[82,1,"よ"],[84,1,"くだ"],[92,1,"ねん"],[94,1,"あいだ"],[100,1,"ち"],[102,1,"のぞ"]],"text":"エリシャはかつて、その子を生きかえらせてやった女に言ったことがある。「あなたは、ここを立って、あなたの家族と共に行き、寄留しようと思う所に寄留しなさい。主がききんを呼び下されたので、七年の間それがこの地に臨むから」。"},{"ref":"2Kgs.8.2","start":12008002,"end":12008002,"break":"none","ruby":[[3,1,"おんな"],[5,1,"た"],[8,1,"かみ"],[10,1,"ひと"],[12,2,"ことば"],[22,2,"かぞく"],[25,1,"とも"],[27,1,"い"],[37,1,"ち"],[40,1,"ねん"],[41,2,"きりゅう"]],"text":"そこで女は立って神の人の言葉のようにし、その家族と共に行ってペリシテびとの地に七年寄留した。"},{"ref":"2Kgs.8.3","start":12008003,"end":12008003,"break":"none","ruby":[[1,1,"ねん"],[5,1,"のち"],[7,1,"おんな"],[16,1,"ち"],[19,1,"かえ"],[25,2,"じぶん"],[28,1,"いえ"],[30,1,"はたけ"],[35,1,"おう"],[37,1,"うった"],[42,1,"で"]],"text":"七年たって後、女はペリシテびとの地から帰ってきて、自分の家と畑のために王に訴えようと出ていった。"},{"ref":"2Kgs.8.4","start":12008004,"end":12008004,"break":"none","ruby":[[0,1,"とき"],[2,1,"おう"],[4,1,"かみ"],[6,1,"ひと"],[32,1,"おお"],[35,1,"こと"],[41,1,"はな"],[50,1,"い"],[54,1,"かれ"],[56,2,"ものがた"]],"text":"時に王は神の人のしもべゲハジにむかって「エリシャがしたもろもろの大きな事をわたしに話してください」と言って、彼と物語っていた。"},{"ref":"2Kgs.8.5","start":12008005,"end":12008005,"break":"none","ruby":[[9,2,"しにん"],[12,1,"い"],[19,1,"こと"],[26,1,"おう"],[28,2,"ものがた"],[39,1,"こ"],[41,1,"い"],[52,1,"おんな"],[55,2,"じぶん"],[58,1,"いえ"],[60,1,"はたけ"],[65,1,"おう"],[67,1,"うった"],[79,1,"い"],[86,1,"しゅ"],[88,1,"おう"],[96,1,"おんな"],[107,1,"こ"],[115,1,"い"]],"text":"すなわちエリシャが死人を生きかえらせた事を、ゲハジが王と物語っていたとき、その子を生きかえらせてもらった女が、自分の家と畑のために王に訴えてきたので、ゲハジは言った、「わが主、王よ、これがその女です。またこれがその子で、エリシャが生きかえらせたのです」。"},{"ref":"2Kgs.8.6","start":12008006,"end":12008006,"break":"none","ruby":[[0,1,"おう"],[4,1,"おんな"],[6,1,"たず"],[11,2,"かのじょ"],[14,1,"おう"],[16,1,"はな"],[22,1,"おう"],[24,2,"かのじょ"],[34,2,"やくにん"],[37,1,"めい"],[40,1,"い"],[48,2,"かのじょ"],[51,1,"ぞく"],[54,1,"もの"],[60,2,"かのじょ"],[65,1,"ち"],[67,1,"さ"],[70,1,"ひ"],[73,1,"いま"],[79,1,"はたけ"],[81,2,"さんぶつ"],[89,2,"かのじょ"],[92,1,"かえ"]],"text":"王がその女に尋ねると、彼女は王に話したので、王は彼女のためにひとりの役人に命じて言った、「すべて彼女に属する物、ならびに彼女がこの地を去った日から今までのその畑の産物をことごとく彼女に返しなさい」。"},{"ref":"2Kgs.8.7","start":12008007,"end":12008007,"break":"paragraph","ruby":[[12,1,"き"],[15,1,"とき"],[21,1,"おう"],[28,2,"びょうき"],[37,1,"かみ"],[39,1,"ひと"],[44,1,"き"],[48,1,"つ"],[51,1,"もの"]],"text":"さてエリシャはダマスコに来た。時にスリヤの王ベネハダデは病気であったが、「神の人がここに来た」と告げる者があったので、"},{"ref":"2Kgs.8.8","start":12008008,"end":12008008,"break":"none","ruby":[[0,1,"おう"],[7,1,"い"],[12,1,"おく"],[14,1,"もの"],[16,1,"たずさ"],[19,1,"い"],[22,1,"かみ"],[24,1,"ひと"],[26,1,"むか"],[29,1,"かれ"],[34,1,"しゅ"],[43,2,"びょうき"],[56,1,"い"],[59,1,"たず"]],"text":"王はハザエルに言った、「贈り物を携えて行って神の人を迎え、彼によって主に『わたしのこの病気はなおりましょうか』と言って尋ねなさい」。"},{"ref":"2Kgs.8.9","start":12008009,"end":12008009,"break":"none","ruby":[[8,1,"かれ"],[10,1,"むか"],[26,1,"よ"],[28,1,"もの"],[35,1,"とう"],[37,1,"の"],[40,1,"おく"],[42,1,"もの"],[46,1,"たずさ"],[48,1,"い"],[56,1,"まえ"],[58,1,"た"],[61,1,"い"],[70,1,"こ"],[76,1,"おう"],[104,2,"びょうき"],[117,1,"い"]],"text":"そこでハザエルは彼を迎えようと、ダマスコのもろもろの良い物をらくだ四十頭に載せ、贈り物として携え行き、エリシャの前に立って言った、「あなたの子、スリヤの王ベネハダデがわたしをあなたにつかわして、『わたしのこの病気はなおりましょうか』と言わせています」。"},{"ref":"2Kgs.8.10","start":12008010,"end":12008010,"break":"none","ruby":[[5,1,"かれ"],[7,1,"い"],[12,1,"い"],[15,1,"かれ"],[22,1,"かなら"],[31,1,"つ"],[40,1,"しゅ"],[47,1,"かれ"],[49,1,"かなら"],[51,1,"し"],[56,1,"しめ"]],"text":"エリシャは彼に言った、「行って彼に『あなたは必ずなおります』と告げなさい。ただし主はわたしに、彼が必ず死ぬことを示されました」。"},{"ref":"2Kgs.8.11","start":12008011,"end":12008011,"break":"none","ruby":[[3,1,"かみ"],[5,1,"ひと"],[11,1,"さだ"],[14,1,"かれ"],[16,1,"は"],[22,1,"み"],[29,1,"な"],[31,1,"だ"]],"text":"そして神の人がひとみを定めて彼の恥じるまでに見つめ、やがて泣き出したので、"},{"ref":"2Kgs.8.12","start":12008012,"end":12008012,"break":"none","ruby":[[5,1,"い"],[12,1,"しゅ"],[19,1,"な"],[34,1,"こた"],[53,2,"ひとびと"],[62,2,"がいあく"],[65,1,"し"],[84,1,"かれ"],[87,1,"しろ"],[89,1,"ひ"],[101,2,"わかもの"],[104,1,"ころ"],[107,1,"おさ"],[109,1,"ご"],[111,1,"な"],[116,2,"にんしん"],[119,1,"おんな"],[121,1,"ひ"],[123,1,"さ"]],"text":"ハザエルは言った、「わが主よ、どうして泣かれるのですか」。エリシャは答えた、「わたしはあなたがイスラエルの人々にしようとする害悪を知っているからです。すなわち、あなたは彼らの城に火をかけ、つるぎをもって若者を殺し、幼な子を投げうち、妊娠の女を引き裂くでしょう」。"},{"ref":"2Kgs.8.13","start":12008013,"end":12008013,"break":"none","ruby":[[5,1,"い"],[15,1,"ぴき"],[17,1,"いぬ"],[33,1,"おお"],[36,1,"こと"],[56,1,"い"],[61,1,"しゅ"],[67,1,"しめ"],[82,1,"おう"]],"text":"ハザエルは言った、「しもべは一匹の犬にすぎないのに、どうしてそんな大きな事をすることができましょう」。エリシャは言った、「主がわたしに示されました。あなたはスリヤの王となるでしょう」。"},{"ref":"2Kgs.8.14","start":12008014,"end":12008014,"break":"none","ruby":[[0,1,"かれ"],[10,1,"さ"],[14,2,"しゅくん"],[21,1,"い"],[38,1,"い"],[44,1,"たず"],[57,1,"かなら"],[68,1,"かれ"],[74,1,"つ"],[81,1,"こた"]],"text":"彼がエリシャのもとを去って、主君のところへ行くと、「エリシャはあなたになんと言ったか」と尋ねられたので、「あなたが必ずなおるでしょうと、彼はわたしに告げました」と答えた。"},{"ref":"2Kgs.8.15","start":12008015,"end":12008015,"break":"none","ruby":[[3,2,"よくじつ"],[14,1,"ぬの"],[16,1,"と"],[19,1,"みず"],[21,1,"ひた"],[30,1,"おう"],[32,1,"かお"],[41,1,"おう"],[43,1,"し"],[52,1,"かれ"],[54,1,"かわ"],[57,1,"おう"]],"text":"しかし翌日になってハザエルは布を取って水に浸し、それをもって王の顔をおおったので、王は死んだ。ハザエルは彼に代って王となった。"},{"ref":"2Kgs.8.16","start":12008016,"end":12008016,"break":"paragraph","ruby":[[6,1,"おう"],[11,1,"こ"],[16,1,"だい"],[18,1,"ねん"],[24,1,"おう"],[31,1,"こ"],[36,1,"くらい"]],"text":"イスラエルの王アハブの子ヨラムの第五年に、ユダの王ヨシャパテの子ヨラムが位についた。"},{"ref":"2Kgs.8.17","start":12008017,"end":12008017,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おう"],[12,1,"さい"],[16,1,"ねん"],[18,1,"あいだ"],[25,1,"よ"],[27,1,"おさ"]],"text":"彼は王となったとき三十二歳で、八年の間エルサレムで世を治めた。"},{"ref":"2Kgs.8.18","start":12008018,"end":12008018,"break":"none","ruby":[[0,1,"かれ"],[6,1,"いえ"],[19,1,"おう"],[23,1,"みち"],[25,1,"あゆ"],[33,1,"むすめ"],[35,1,"かれ"],[37,1,"つま"],[48,1,"かれ"],[50,1,"しゅ"],[52,1,"め"],[54,1,"まえ"],[56,1,"あく"]],"text":"彼はアハブの家がしたようにイスラエルの王たちの道に歩んだ。アハブの娘が彼の妻であったからである。彼は主の目の前に悪をおこなったが、"},{"ref":"2Kgs.8.19","start":12008019,"end":12008019,"break":"none","ruby":[[0,1,"しゅ"],[15,1,"ほろ"],[21,1,"この"],[33,1,"しゅ"],[35,1,"かれ"],[39,2,"しそん"],[42,1,"つね"],[49,1,"あた"],[54,1,"かれ"],[56,2,"やくそく"]],"text":"主はしもべダビデのためにユダを滅ぼすことを好まれなかった。すなわち主は彼とその子孫に常にともしびを与えると、彼に約束されたからである。"},{"ref":"2Kgs.8.20","start":12008020,"end":12008020,"break":"paragraph","ruby":[[4,1,"よ"],[17,2,"しはい"],[20,1,"だっ"],[27,1,"おう"],[29,1,"た"]],"text":"ヨラムの世にエドムがそむいてユダの支配を脱し、みずから王を立てたので、"},{"ref":"2Kgs.8.21","start":12008021,"end":12008021,"break":"none","ruby":[[8,2,"せんしゃ"],[11,1,"したが"],[22,1,"い"],[27,2,"せんしゃ"],[30,2,"しき"],[32,1,"かん"],[36,1,"とも"],[39,1,"よ"],[44,1,"た"],[51,1,"かれ"],[53,2,"ほうい"],[65,1,"う"],[76,2,"ぐんたい"],[79,2,"てんまく"],[82,1,"に"],[84,1,"かえ"]],"text":"ヨラムはすべての戦車を従えてザイルにわたって行き、その戦車の指揮官たちと共に、夜のうちに立ちあがって、彼を包囲しているエドムびとを撃った。しかしヨラムの軍隊は天幕に逃げ帰った。"},{"ref":"2Kgs.8.22","start":12008022,"end":12008022,"break":"none","ruby":[[16,2,"しはい"],[19,1,"だっ"],[22,2,"こんにち"],[25,1,"いた"],[37,2,"どうじ"]],"text":"エドムはこのようにそむいてユダの支配を脱し、今日に至っている。リブナもまた同時にそむいた。"},{"ref":"2Kgs.8.23","start":12008023,"end":12008023,"break":"none","ruby":[[6,1,"た"],[8,2,"じせき"],[13,1,"かれ"],[21,1,"こと"],[27,3,"れきだいし"],[31,1,"しょ"]],"text":"ヨラムのその他の事績および彼がしたすべての事は、ユダの歴代志の書にしるされているではないか。"},{"ref":"2Kgs.8.24","start":12008024,"end":12008024,"break":"none","ruby":[[6,2,"せんぞ"],[11,1,"とも"],[13,1,"ねむ"],[21,1,"まち"],[25,2,"せんぞ"],[30,1,"とも"],[32,1,"ほうむ"],[38,1,"こ"],[44,1,"かわ"],[47,1,"おう"]],"text":"ヨラムはその先祖たちと共に眠って、ダビデの町にその先祖たちと共に葬られ、その子アハジヤが代って王となった。"},{"ref":"2Kgs.8.25","start":12008025,"end":12008025,"break":"paragraph","ruby":[[6,1,"おう"],[11,1,"こ"],[16,1,"だい"],[19,1,"ねん"],[24,1,"おう"],[29,1,"こ"],[35,1,"くらい"]],"text":"イスラエルの王アハブの子ヨラムの第十二年にユダの王ヨラムの子アハジヤが位についた。"},{"ref":"2Kgs.8.26","start":12008026,"end":12008026,"break":"none","ruby":[[5,1,"おう"],[15,1,"さい"],[25,1,"ねん"],[26,1,"よ"],[28,1,"おさ"],[34,1,"はは"],[36,1,"な"],[43,1,"い"],[53,1,"おう"],[58,2,"まごむすめ"]],"text":"アハジヤは王となったとき二十二歳で、エルサレムで一年世を治めた。その母は名をアタリヤと言って、イスラエルの王オムリの孫娘であった。"},{"ref":"2Kgs.8.27","start":12008027,"end":12008027,"break":"none","ruby":[[11,1,"いえ"],[13,1,"みち"],[15,1,"あゆ"],[22,1,"いえ"],[29,1,"しゅ"],[31,1,"め"],[33,1,"まえ"],[35,1,"あく"],[43,1,"かれ"],[49,1,"いえ"],[51,1,"むこ"]],"text":"アハジヤはまたアハブの家の道に歩み、アハブの家がしたように主の目の前に悪をおこなった。彼はアハブの家の婿であったからである。"},{"ref":"2Kgs.8.28","start":12008028,"end":12008028,"break":"paragraph","ruby":[[0,1,"かれ"],[6,1,"こ"],[11,1,"とも"],[13,1,"い"],[21,1,"おう"],[36,1,"たたか"],[52,1,"きず"],[54,1,"お"]],"text":"彼はアハブの子ヨラムと共に行って、スリヤの王ハザエルとラモテ・ギレアデで戦ったが、スリヤびとらはヨラムに傷を負わせた。"},{"ref":"2Kgs.8.29","start":12008029,"end":12008029,"break":"none","ruby":[[3,1,"おう"],[11,1,"おう"],[17,1,"たたか"],[31,1,"お"],[36,1,"きず"],[49,1,"かえ"],[57,1,"おう"],[62,1,"こ"],[72,1,"こ"],[77,1,"や"],[90,1,"くだ"],[93,1,"かれ"]],"text":"ヨラム王はそのスリヤの王ハザエルと戦うときにラマでスリヤびとに負わされた傷をいやすため、エズレルに帰ったが、ユダの王ヨラムの子アハジヤはアハブの子ヨラムが病んでいたので、エズレルに下って彼をおとずれた。"}]