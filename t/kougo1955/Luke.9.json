[{"ref":"Luke.9.1","start":42009001,"end":42009001,"break":"paragraph","ruby":[[10,2,"でし"],[13,1,"よ"],[15,1,"あつ"],[19,1,"かれ"],[26,2,"あくれい"],[29,1,"せい"],[32,2,"びょうき"],[38,1,"ちから"],[40,2,"けんい"],[45,1,"さづ"]],"text":"それからイエスは十二弟子を呼び集めて、彼らにすべての悪霊を制し、病気をいやす力と権威とをお授けになった。"},{"ref":"Luke.9.2","start":42009002,"end":42009002,"break":"none","ruby":[[2,1,"かみ"],[4,1,"くに"],[6,1,"の"],[8,1,"つた"],[13,2,"びょうき"]],"text":"また神の国を宣べ伝え、かつ病気をなおすためにつかわして"},{"ref":"Luke.9.3","start":42009003,"end":42009003,"break":"none","ruby":[[0,1,"い"],[6,1,"たび"],[11,1,"なに"],[13,1,"たずさ"],[21,1,"ふくろ"],[26,1,"ぜに"],[28,1,"も"],[34,2,"したぎ"],[38,1,"まい"],[40,1,"も"]],"text":"言われた、「旅のために何も携えるな。つえも袋もパンも銭も持たず、また下着も二枚は持つな。"},{"ref":"Luke.9.4","start":42009004,"end":42009004,"break":"none","ruby":[[7,1,"いえ"],[18,1,"とど"],[32,1,"で"]],"text":"また、どこかの家にはいったら、そこに留まっておれ。そしてそこから出かけることにしなさい。"},{"ref":"Luke.9.5","start":42009005,"end":42009005,"break":"none","ruby":[[9,1,"むか"],[24,1,"まち"],[26,1,"で"],[28,1,"い"],[33,1,"かれ"],[36,1,"たい"],[39,2,"こうぎ"],[47,1,"あし"],[53,1,"はら"],[55,1,"おと"]],"text":"だれもあなたがたを迎えるものがいなかったら、その町を出て行くとき、彼らに対する抗議のしるしに、足からちりを払い落しなさい」。"},{"ref":"Luke.9.6","start":42009006,"end":42009006,"break":"none","ruby":[[0,2,"でし"],[5,1,"で"],[7,1,"い"],[11,2,"むらむら"],[14,1,"めぐ"],[16,1,"ある"],[22,1,"ところ"],[24,2,"ふくいん"],[27,1,"の"],[29,1,"つた"],[34,2,"びょうき"]],"text":"弟子たちは出て行って、村々を巡り歩き、いたる所で福音を宣べ伝え、また病気をいやした。"},{"ref":"Luke.9.7","start":42009007,"end":42009007,"break":"paragraph","ruby":[[3,2,"りょうしゅ"],[14,3,"できごと"],[18,1,"みみ"],[26,1,"まど"],[38,1,"ひと"],[47,2,"しにん"],[50,1,"なか"],[60,1,"い"]],"text":"さて、領主ヘロデはいろいろな出来事を耳にして、あわて惑っていた。それは、ある人たちは、ヨハネが死人の中からよみがえったと言い、"},{"ref":"Luke.9.8","start":42009008,"end":42009008,"break":"none","ruby":[[4,1,"ひと"],[13,1,"あらわ"],[17,1,"い"],[25,1,"ひと"],[30,1,"むかし"],[32,3,"よげんしゃ"],[40,2,"ふっかつ"],[47,1,"い"]],"text":"またある人たちは、エリヤが現れたと言い、またほかの人たちは、昔の預言者のひとりが復活したのだと言っていたからである。"},{"ref":"Luke.9.9","start":42009009,"end":42009009,"break":"none","ruby":[[7,1,"い"],[23,1,"くび"],[25,1,"き"],[46,1,"ひと"],[70,1,"あ"],[77,1,"おも"]],"text":"そこでヘロデが言った、「ヨハネはわたしがすでに首を切ったのだが、こうしてうわさされているこの人は、いったい、だれなのだろう」。そしてイエスに会ってみようと思っていた。"},{"ref":"Luke.9.10","start":42009010,"end":42009010,"break":"paragraph","ruby":[[0,2,"しと"],[5,1,"かえ"],[11,2,"じぶん"],[28,1,"はな"],[40,1,"かれ"],[43,1,"つ"],[55,1,"まち"],[61,1,"しりぞ"]],"text":"使徒たちは帰ってきて、自分たちのしたことをすべてイエスに話した。それからイエスは彼らを連れて、ベツサイダという町へひそかに退かれた。"},{"ref":"Luke.9.11","start":42009011,"end":42009011,"break":"none","ruby":[[4,2,"ぐんしゅう"],[10,1,"し"],[25,1,"むか"],[28,1,"かみ"],[30,1,"くに"],[35,1,"かた"],[37,1,"き"],[43,2,"ちりょう"],[46,1,"よう"],[49,1,"ひと"]],"text":"ところが群衆がそれと知って、ついてきたので、これを迎えて神の国のことを語り聞かせ、また治療を要する人たちをいやされた。"},{"ref":"Luke.9.12","start":42009012,"end":42009012,"break":"none","ruby":[[4,1,"ひ"],[6,1,"かたむ"],[16,2,"でし"],[28,1,"い"],[33,2,"ぐんしゅう"],[36,2,"かいさん"],[45,2,"むらむら"],[48,2,"ぶらく"],[51,1,"い"],[54,1,"やど"],[56,1,"と"],[59,2,"しょくもつ"],[62,1,"て"],[87,1,"さび"],[90,1,"ところ"]],"text":"それから日が傾きかけたので、十二弟子がイエスのもとにきて言った、「群衆を解散して、まわりの村々や部落へ行って宿を取り、食物を手にいれるようにさせてください。わたしたちはこんな寂しい所にきているのですから」。"},{"ref":"Luke.9.13","start":42009013,"end":42009013,"break":"none","ruby":[[7,1,"い"],[19,1,"て"],[21,2,"しょくもつ"],[31,1,"かれ"],[34,1,"い"],[51,1,"うお"],[65,1,"おお"],[69,1,"ひと"],[74,2,"しょくもつ"],[77,1,"か"],[80,1,"い"]],"text":"しかしイエスは言われた、「あなたがたの手で食物をやりなさい」。彼らは言った、「わたしたちにはパン五つと魚二ひきしかありません、この大ぜいの人のために食物を買いに行くかしなければ」。"},{"ref":"Luke.9.14","start":42009014,"end":42009014,"break":"none","ruby":[[6,1,"おとこ"],[10,1,"にん"],[30,2,"でし"],[35,1,"い"],[41,2,"ひとびと"],[50,1,"にん"],[54,1,"くみ"]],"text":"というのは、男が五千人ばかりもいたからである。しかしイエスは弟子たちに言われた、「人々をおおよそ五十人ずつの組にして、すわらせなさい」。"},{"ref":"Luke.9.15","start":42009015,"end":42009015,"break":"none","ruby":[[0,1,"かれ"]],"text":"彼らはそのとおりにして、みんなをすわらせた。"},{"ref":"Luke.9.16","start":42009016,"end":42009016,"break":"none","ruby":[[14,1,"うお"],[17,1,"て"],[19,1,"と"],[22,1,"てん"],[24,1,"あお"],[30,2,"しゅくふく"],[37,2,"でし"],[46,2,"ぐんしゅう"],[49,1,"くば"]],"text":"イエスは五つのパンと二ひきの魚とを手に取り、天を仰いでそれを祝福してさき、弟子たちにわたして群衆に配らせた。"},{"ref":"Luke.9.17","start":42009017,"end":42009017,"break":"none","ruby":[[4,1,"もの"],[6,1,"た"],[9,2,"まんぷく"],[20,1,"あま"],[25,1,"あつ"]],"text":"みんなの者は食べて満腹した。そして、その余りくずを集めたら、十二かごあった。"},{"ref":"Luke.9.18","start":42009018,"end":42009018,"break":"paragraph","ruby":[[8,1,"いの"],[18,2,"でし"],[23,1,"ちか"],[31,1,"かれ"],[34,1,"たず"],[37,1,"い"],[43,2,"ぐんしゅう"],[53,1,"い"]],"text":"イエスがひとりで祈っておられたとき、弟子たちが近くにいたので、彼らに尋ねて言われた、「群衆はわたしをだれと言っているか」。"},{"ref":"Luke.9.19","start":42009019,"end":42009019,"break":"none","ruby":[[0,1,"かれ"],[3,1,"こた"],[6,1,"い"],[23,1,"い"],[36,1,"ひと"],[46,1,"い"],[51,1,"むかし"],[53,3,"よげんしゃ"],[61,2,"ふっかつ"],[69,1,"い"],[74,1,"もの"]],"text":"彼らは答えて言った、「バプテスマのヨハネだと、言っています。しかしほかの人たちは、エリヤだと言い、また昔の預言者のひとりが復活したのだと、言っている者もあります」。"},{"ref":"Luke.9.20","start":42009020,"end":42009020,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[27,1,"い"],[36,1,"こた"],[39,1,"い"],[44,1,"かみ"]],"text":"彼らに言われた、「それでは、あなたがたはわたしをだれと言うか」。ペテロが答えて言った、「神のキリストです」。"},{"ref":"Luke.9.21","start":42009021,"end":42009021,"break":"none","ruby":[[4,1,"かれ"],[7,1,"いまし"],[12,1,"こと"],[18,1,"い"],[22,1,"めい"],[28,1,"い"]],"text":"イエスは彼らを戒め、この事をだれにも言うなと命じ、そして言われた、"},{"ref":"Luke.9.22","start":42009022,"end":42009022,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[5,1,"かなら"],[7,1,"おお"],[10,1,"くる"],[14,1,"う"],[17,2,"ちょうろう"],[20,3,"さいしちょう"],[24,2,"りっぽう"],[26,2,"がくしゃ"],[31,1,"す"],[38,1,"ころ"],[46,1,"か"],[47,1,"め"]],"text":"「人の子は必ず多くの苦しみを受け、長老、祭司長、律法学者たちに捨てられ、また殺され、そして三日目によみがえる」。"},{"ref":"Luke.9.23","start":42009023,"end":42009023,"break":"none","ruby":[[9,1,"もの"],[11,1,"い"],[32,1,"おも"],[37,2,"じぶん"],[40,1,"す"],[43,2,"ひび"],[45,2,"じぶん"],[48,3,"じゅうじか"],[52,1,"お"],[60,1,"したが"]],"text":"それから、みんなの者に言われた、「だれでもわたしについてきたいと思うなら、自分を捨て、日々自分の十字架を負うて、わたしに従ってきなさい。"},{"ref":"Luke.9.24","start":42009024,"end":42009024,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"いのち"],[5,1,"すく"],[9,1,"おも"],[11,1,"もの"],[16,1,"うしな"],[26,2,"じぶん"],[29,1,"いのち"],[31,1,"うしな"],[33,1,"もの"],[39,1,"すく"]],"text":"自分の命を救おうと思う者はそれを失い、わたしのために自分の命を失う者は、それを救うであろう。"},{"ref":"Luke.9.25","start":42009025,"end":42009025,"break":"none","ruby":[[0,1,"ひと"],[2,1,"ぜん"],[3,2,"せかい"],[12,2,"じぶん"],[14,2,"じしん"],[17,1,"うしな"],[22,1,"そん"],[30,1,"え"]],"text":"人が全世界をもうけても、自分自身を失いまたは損したら、なんの得になろうか。"},{"ref":"Luke.9.26","start":42009026,"end":42009026,"break":"none","ruby":[[8,2,"ことば"],[12,1,"は"],[15,1,"もの"],[17,1,"たい"],[22,1,"ひと"],[24,1,"こ"],[29,2,"じぶん"],[32,2,"えいこう"],[36,1,"ちち"],[38,1,"せい"],[41,2,"みつかい"],[45,2,"えいこう"],[51,1,"あらわ"],[54,1,"く"],[61,1,"もの"],[63,1,"は"]],"text":"わたしとわたしの言葉とを恥じる者に対しては、人の子もまた、自分の栄光と、父と聖なる御使との栄光のうちに現れて来るとき、その者を恥じるであろう。"},{"ref":"Luke.9.27","start":42009027,"end":42009027,"break":"none","ruby":[[2,1,"き"],[11,1,"かみ"],[13,1,"くに"],[15,1,"み"],[21,1,"し"],[23,1,"あじ"],[28,1,"もの"],[34,1,"た"],[39,1,"もの"],[41,1,"なか"]],"text":"よく聞いておくがよい、神の国を見るまでは、死を味わわない者が、ここに立っている者の中にいる」。"},{"ref":"Luke.9.28","start":42009028,"end":42009028,"break":"paragraph","ruby":[[7,1,"はな"],[11,1,"のち"],[14,1,"か"],[39,1,"つ"],[43,1,"いの"],[48,1,"やま"],[50,1,"のぼ"]],"text":"これらのことを話された後、八日ほどたってから、イエスはペテロ、ヨハネ、ヤコブを連れて、祈るために山に登られた。"},{"ref":"Luke.9.29","start":42009029,"end":42009029,"break":"none","ruby":[[0,1,"いの"],[7,1,"あいだ"],[11,1,"かお"],[13,1,"さま"],[15,1,"かわ"],[19,1,"ころも"],[28,1,"しろ"],[30,1,"かがや"]],"text":"祈っておられる間に、み顔の様が変り、み衣がまばゆいほどに白く輝いた。"},{"ref":"Luke.9.30","start":42009030,"end":42009030,"break":"none","ruby":[[3,1,"み"],[10,1,"ひと"],[16,1,"かた"],[18,1,"あ"]],"text":"すると見よ、ふたりの人がイエスと語り合っていた。それはモーセとエリヤであったが、"},{"ref":"Luke.9.31","start":42009031,"end":42009031,"break":"none","ruby":[[0,2,"えいこう"],[3,1,"なか"],[5,1,"あらわ"],[19,1,"と"],[26,2,"さいご"],[35,1,"はな"]],"text":"栄光の中に現れて、イエスがエルサレムで遂げようとする最後のことについて話していたのである。"},{"ref":"Luke.9.32","start":42009032,"end":42009032,"break":"none","ruby":[[6,2,"なかま"],[9,1,"もの"],[14,2,"じゅくすい"],[22,1,"め"],[33,2,"えいこう"],[36,1,"すがた"],[39,1,"とも"],[41,1,"た"],[50,1,"ひと"],[53,1,"み"]],"text":"ペテロとその仲間の者たちとは熟睡していたが、目をさますと、イエスの栄光の姿と、共に立っているふたりの人とを見た。"},{"ref":"Luke.9.33","start":42009033,"end":42009033,"break":"none","ruby":[[10,1,"はな"],[12,1,"さ"],[25,2,"じぶん"],[28,1,"なに"],[30,1,"い"],[48,1,"い"],[53,2,"せんせい"],[90,2,"こや"],[95,1,"た"]],"text":"このふたりがイエスを離れ去ろうとしたとき、ペテロは自分が何を言っているのかわからないで、イエスに言った、「先生、わたしたちがここにいるのは、すばらしいことです。それで、わたしたちは小屋を三つ建てましょう。一つはあなたのために、一つはモーセのために、一つはエリヤのために」。"},{"ref":"Luke.9.34","start":42009034,"end":42009034,"break":"none","ruby":[[0,1,"かれ"],[4,1,"い"],[9,1,"あいだ"],[12,1,"くも"],[16,1,"おこ"],[19,1,"かれ"],[35,1,"くも"],[37,1,"かこ"],[44,1,"かれ"],[47,1,"おそ"]],"text":"彼がこう言っている間に、雲がわき起って彼らをおおいはじめた。そしてその雲に囲まれたとき、彼らは恐れた。"},{"ref":"Luke.9.35","start":42009035,"end":42009035,"break":"none","ruby":[[3,1,"くも"],[5,1,"なか"],[8,1,"こえ"],[22,1,"こ"],[28,1,"えら"],[31,1,"もの"],[39,1,"き"]],"text":"すると雲の中から声があった、「これはわたしの子、わたしの選んだ者である。これに聞け」。"},{"ref":"Luke.9.36","start":42009036,"end":42009036,"break":"none","ruby":[[3,1,"こえ"],[5,1,"や"],[29,2,"でし"],[34,2,"ちんもく"],[37,1,"まも"],[41,2,"じぶん"],[46,1,"み"],[64,1,"はな"]],"text":"そして声が止んだとき、イエスがひとりだけになっておられた。弟子たちは沈黙を守って、自分たちが見たことについては、そのころだれにも話さなかった。"},{"ref":"Luke.9.37","start":42009037,"end":42009037,"break":"paragraph","ruby":[[0,2,"よくじつ"],[3,2,"いちどう"],[6,1,"やま"],[8,1,"お"],[11,1,"く"],[15,1,"おお"],[19,2,"ぐんしゅう"],[26,2,"でむか"]],"text":"翌日、一同が山を降りて来ると、大ぜいの群衆がイエスを出迎えた。"},{"ref":"Luke.9.38","start":42009038,"end":42009038,"break":"none","ruby":[[3,2,"とつぜん"],[8,1,"ひと"],[10,2,"ぐんしゅう"],[13,1,"なか"],[16,2,"おおごえ"],[22,1,"い"],[27,2,"せんせい"],[31,1,"ねが"],[44,1,"み"],[56,1,"こ"]],"text":"すると突然、ある人が群衆の中から大声をあげて言った、「先生、お願いです。わたしのむすこを見てやってください。この子はわたしのひとりむすこですが、"},{"ref":"Luke.9.39","start":42009039,"end":42009039,"break":"none","ruby":[[0,1,"れい"],[2,1,"と"],[10,1,"かれ"],[12,1,"きゅう"],[14,1,"さけ"],[16,1,"だ"],[27,1,"れい"],[29,1,"かれ"],[42,1,"ふ"],[46,1,"かれ"],[48,1,"よわ"],[50,1,"は"],[60,1,"で"],[62,1,"い"]],"text":"霊が取りつきますと、彼は急に叫び出すのです。それから、霊は彼をひきつけさせて、あわを吹かせ、彼を弱り果てさせて、なかなか出て行かないのです。"},{"ref":"Luke.9.40","start":42009040,"end":42009040,"break":"none","ruby":[[5,2,"でし"],[13,1,"れい"],[15,1,"お"],[17,1,"だ"],[27,1,"ねが"]],"text":"それで、お弟子たちに、この霊を追い出してくださるように願いましたが、できませんでした」。"},{"ref":"Luke.9.41","start":42009041,"end":42009041,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[21,1,"ふ"],[22,2,"しんこう"],[26,1,"まが"],[29,2,"じだい"],[51,2,"いっしょ"],[69,2,"がまん"],[82,1,"こ"],[87,1,"つ"]],"text":"イエスは答えて言われた、「ああ、なんという不信仰な、曲った時代であろう。いつまで、わたしはあなたがたと一緒におられようか、またあなたがたに我慢ができようか。あなたの子をここに連れてきなさい」。"},{"ref":"Luke.9.42","start":42009042,"end":42009042,"break":"none","ruby":[[7,1,"こ"],[17,1,"く"],[19,1,"とき"],[23,2,"あくれい"],[26,1,"かれ"],[28,1,"ひ"],[30,1,"たお"],[34,1,"ひ"],[48,1,"けが"],[51,1,"れい"],[61,2,"こども"],[69,2,"ちちおや"],[73,1,"わた"]],"text":"ところが、その子がイエスのところに来る時にも、悪霊が彼を引き倒して、引きつけさせた。イエスはこの汚れた霊をしかりつけ、その子供をいやして、父親にお渡しになった。"},{"ref":"Luke.9.43","start":42009043,"end":42009043,"break":"none","breaks":[[20,"paragraph"]],"ruby":[[0,2,"ひとびと"],[6,1,"かみ"],[8,2,"いだい"],[11,1,"ちから"],[13,2,"ひじょう"],[16,1,"おどろ"],[24,1,"もの"],[36,2,"かずかず"],[39,1,"こと"],[41,3,"ふしぎ"],[45,1,"おも"],[52,2,"でし"],[57,1,"い"]],"text":"人々はみな、神の偉大な力に非常に驚いた。みんなの者がイエスのしておられた数々の事を不思議に思っていると、弟子たちに言われた、"},{"ref":"Luke.9.44","start":42009044,"end":42009044,"break":"none","ruby":[[9,2,"ことば"],[12,1,"みみ"],[18,1,"お"],[24,1,"ひと"],[26,1,"こ"],[28,2,"ひとびと"],[31,1,"て"],[33,1,"わた"]],"text":"「あなたがたはこの言葉を耳におさめて置きなさい。人の子は人々の手に渡されようとしている」。"},{"ref":"Luke.9.45","start":42009045,"end":42009045,"break":"none","ruby":[[4,1,"かれ"],[24,1,"かれ"],[27,1,"かく"],[34,1,"さと"],[52,1,"かれ"],[63,1,"たず"],[68,1,"おそ"]],"text":"しかし、彼らはなんのことかわからなかった。それが彼らに隠されていて、悟ることができなかったのである。また彼らはそのことについて尋ねるのを恐れていた。"},{"ref":"Luke.9.46","start":42009046,"end":42009046,"break":"paragraph","ruby":[[0,2,"でし"],[5,1,"あいだ"],[8,1,"かれ"],[21,1,"えら"],[34,2,"ぎろん"]],"text":"弟子たちの間に、彼らのうちでだれがいちばん偉いだろうかということで、議論がはじまった。"},{"ref":"Luke.9.47","start":42009047,"end":42009047,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こころ"],[9,1,"おも"],[12,2,"みぬ"],[20,1,"おさ"],[22,1,"ご"],[24,1,"と"],[29,2,"じぶん"],[35,1,"た"],[39,1,"かれ"],[42,1,"い"]],"text":"イエスは彼らの心の思いを見抜き、ひとりの幼な子を取りあげて自分のそばに立たせ、彼らに言われた、"},{"ref":"Luke.9.48","start":42009048,"end":42009048,"break":"none","ruby":[[7,1,"おさ"],[9,1,"ご"],[15,1,"な"],[20,1,"う"],[25,1,"もの"],[32,1,"う"],[49,1,"う"],[54,1,"もの"],[73,1,"う"],[92,1,"なか"],[98,1,"ちい"],[101,1,"もの"],[105,1,"おお"]],"text":"「だれでもこの幼な子をわたしの名のゆえに受けいれる者は、わたしを受けいれるのである。そしてわたしを受けいれる者は、わたしをおつかわしになったかたを受けいれるのである。あなたがたみんなの中でいちばん小さい者こそ、大きいのである」。"},{"ref":"Luke.9.49","start":42009049,"end":42009049,"break":"paragraph","ruby":[[7,1,"こた"],[10,1,"い"],[15,2,"せんせい"],[26,1,"ひと"],[32,1,"な"],[34,1,"つか"],[37,2,"あくれい"],[40,1,"お"],[42,1,"だ"],[49,1,"み"],[57,1,"ひと"],[65,2,"なかま"]],"text":"するとヨハネが答えて言った、「先生、わたしたちはある人があなたの名を使って悪霊を追い出しているのを見ましたが、その人はわたしたちの仲間でないので、やめさせました」。"},{"ref":"Luke.9.50","start":42009050,"end":42009050,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[28,2,"はんたい"],[33,1,"もの"],[42,2,"みかた"]],"text":"イエスは彼に言われた、「やめさせないがよい。あなたがたに反対しない者は、あなたがたの味方なのである」。"},{"ref":"Luke.9.51","start":42009051,"end":42009051,"break":"paragraph","ruby":[[7,1,"てん"],[9,1,"あ"],[14,1,"ひ"],[16,1,"ちか"],[29,1,"い"],[33,2,"けつい"],[40,1,"ほう"],[42,1,"かお"]],"text":"さて、イエスが天に上げられる日が近づいたので、エルサレムへ行こうと決意して、その方へ顔をむけられ、"},{"ref":"Luke.9.52","start":42009052,"end":42009052,"break":"none","ruby":[[0,2,"じぶん"],[3,2,"さきだ"],[7,2,"ししゃ"],[25,1,"かれ"],[32,1,"びと"],[34,1,"むら"],[40,1,"い"],[50,2,"じゅんび"]],"text":"自分に先立って使者たちをおつかわしになった。そして彼らがサマリヤ人の村へはいって行き、イエスのために準備をしようとしたところ、"},{"ref":"Luke.9.53","start":42009053,"end":42009053,"break":"none","ruby":[[0,2,"むらびと"],[14,1,"すす"],[17,1,"い"],[31,2,"かんげい"]],"text":"村人は、エルサレムへむかって進んで行かれるというので、イエスを歓迎しようとはしなかった。"},{"ref":"Luke.9.54","start":42009054,"end":42009054,"break":"none","ruby":[[0,2,"でし"],[15,1,"み"],[17,1,"い"],[22,1,"しゅ"],[33,1,"かれ"],[36,1,"や"],[38,1,"はら"],[48,1,"てん"],[51,1,"ひ"],[55,1,"もと"]],"text":"弟子のヤコブとヨハネとはそれを見て言った、「主よ、いかがでしょう。彼らを焼き払ってしまうように、天から火をよび求めましょうか」。"},{"ref":"Luke.9.55","start":42009055,"end":42009055,"break":"none","ruby":[[4,1,"ふ"],[11,1,"かれ"]],"text":"イエスは振りかえって、彼らをおしかりになった。"},{"ref":"Luke.9.56","start":42009056,"end":42009056,"break":"none","ruby":[[3,2,"いちどう"],[9,1,"むら"],[11,1,"い"]],"text":"そして一同はほかの村へ行った。"},{"ref":"Luke.9.57","start":42009057,"end":42009057,"break":"paragraph","ruby":[[0,1,"みち"],[2,1,"すす"],[5,1,"い"],[11,1,"ひと"],[17,1,"い"],[32,1,"ところ"],[40,1,"したが"]],"text":"道を進んで行くと、ある人がイエスに言った、「あなたがおいでになる所ならどこへでも従ってまいります」。"},{"ref":"Luke.9.58","start":42009058,"end":42009058,"break":"none","ruby":[[6,1,"ひと"],[8,1,"い"],[19,1,"あな"],[24,1,"そら"],[26,1,"とり"],[29,1,"す"],[38,1,"ひと"],[40,1,"こ"],[48,1,"ところ"]],"text":"イエスはその人に言われた、「きつねには穴があり、空の鳥には巣がある。しかし、人の子にはまくらする所がない」。"},{"ref":"Luke.9.59","start":42009059,"end":42009059,"break":"none","ruby":[[5,1,"ひと"],[13,1,"したが"],[22,1,"い"],[32,1,"ひと"],[34,1,"い"],[42,1,"ちち"],[44,1,"ほうむ"],[47,1,"い"]],"text":"またほかの人に、「わたしに従ってきなさい」と言われた。するとその人が言った、「まず、父を葬りに行かせてください」。"},{"ref":"Luke.9.60","start":42009060,"end":42009060,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[10,2,"しにん"],[13,1,"ほうむ"],[19,2,"しにん"],[22,1,"まか"],[36,1,"で"],[38,1,"い"],[41,1,"かみ"],[43,1,"くに"],[45,1,"つ"]],"text":"彼に言われた、「その死人を葬ることは、死人に任せておくがよい。あなたは、出て行って神の国を告げひろめなさい」。"},{"ref":"Luke.9.61","start":42009061,"end":42009061,"break":"none","ruby":[[5,1,"ひと"],[7,1,"い"],[12,1,"しゅ"],[15,1,"したが"],[27,1,"いえ"],[29,1,"もの"],[31,1,"わか"],[34,1,"い"],[37,1,"い"]],"text":"またほかの人が言った、「主よ、従ってまいりますが、まず家の者に別れを言いに行かせてください」。"},{"ref":"Luke.9.62","start":42009062,"end":42009062,"break":"none","ruby":[[4,1,"い"],[10,1,"て"],[25,1,"み"],[27,1,"もの"],[30,1,"かみ"],[32,1,"くに"]],"text":"イエスは言われた、「手をすきにかけてから、うしろを見る者は、神の国にふさわしくないものである」。"}]