[{"ref":"Gen.39.1","start":1039001,"end":1039001,"break":"paragraph","ruby":[[6,1,"つ"],[16,1,"くだ"],[24,2,"やくにん"],[27,2,"じえい"],[29,1,"ちょう"],[46,1,"かれ"],[51,1,"つ"],[53,1,"くだ"],[65,1,"て"],[68,1,"か"],[70,1,"と"]],"text":"さてヨセフは連れられてエジプトに下ったが、パロの役人で侍衛長であったエジプトびとポテパルは、彼をそこに連れ下ったイシマエルびとらの手から買い取った。"},{"ref":"Gen.39.2","start":1039002,"end":1039002,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"とも"],[15,1,"かれ"],[17,2,"こううん"],[20,1,"もの"],[27,2,"しゅじん"],[36,1,"いえ"]],"text":"主がヨセフと共におられたので、彼は幸運な者となり、その主人エジプトびとの家におった。"},{"ref":"Gen.39.3","start":1039003,"end":1039003,"break":"none","ruby":[[2,2,"しゅじん"],[5,1,"しゅ"],[7,1,"かれ"],[20,1,"しゅ"],[22,1,"かれ"],[24,1,"て"],[34,1,"さか"],[43,1,"み"]],"text":"その主人は主が彼とともにおられることと、主が彼の手のすることをすべて栄えさせられるのを見た。"},{"ref":"Gen.39.4","start":1039004,"end":1039004,"break":"none","ruby":[[8,1,"かれ"],[10,1,"まえ"],[12,1,"めぐ"],[15,1,"え"],[21,1,"ちか"],[23,1,"つか"],[27,1,"かれ"],[33,1,"いえ"],[42,1,"も"],[44,1,"もの"],[48,1,"かれ"],[50,1,"て"]],"text":"そこで、ヨセフは彼の前に恵みを得、そのそば近く仕えた。彼はヨセフに家をつかさどらせ、持ち物をみな彼の手にゆだねた。"},{"ref":"Gen.39.5","start":1039005,"end":1039005,"break":"none","ruby":[[0,1,"かれ"],[6,1,"いえ"],[12,1,"も"],[14,1,"もの"],[23,1,"とき"],[27,1,"しゅ"],[45,1,"いえ"],[47,1,"めぐ"],[54,1,"しゅ"],[56,1,"めぐ"],[59,1,"かれ"],[61,1,"いえ"],[63,1,"はたけ"],[72,1,"も"],[74,1,"もの"],[76,1,"およ"]],"text":"彼がヨセフに家とすべての持ち物をつかさどらせた時から、主はヨセフのゆえにそのエジプトびとの家を恵まれたので、主の恵みは彼の家と畑とにあるすべての持ち物に及んだ。"},{"ref":"Gen.39.6","start":1039006,"end":1039006,"break":"none","breaks":[[44,"paragraph"]],"ruby":[[3,1,"かれ"],[5,1,"も"],[7,1,"もの"],[15,1,"て"],[22,2,"じぶん"],[25,1,"た"],[28,1,"もの"],[34,1,"なに"],[37,1,"かえり"],[50,1,"すがた"],[55,1,"かお"],[57,1,"うつく"]],"text":"そこで彼は持ち物をみなヨセフの手にゆだねて、自分が食べる物のほかは、何をも顧みなかった。さてヨセフは姿がよく、顔が美しかった。"},{"ref":"Gen.39.7","start":1039007,"end":1039007,"break":"none","ruby":[[4,1,"こと"],[6,1,"のち"],[8,2,"しゅじん"],[11,1,"つま"],[17,1,"め"],[22,1,"い"],[31,1,"ね"]],"text":"これらの事の後、主人の妻はヨセフに目をつけて言った、「わたしと寝なさい」。"},{"ref":"Gen.39.8","start":1039008,"end":1039008,"break":"none","ruby":[[4,1,"こば"],[8,2,"しゅじん"],[11,1,"つま"],[13,1,"い"],[18,1,"ご"],[19,2,"しゅじん"],[30,1,"いえ"],[32,1,"なか"],[34,1,"なに"],[37,1,"かえり"],[43,1,"も"],[45,1,"もの"],[53,1,"て"]],"text":"ヨセフは拒んで、主人の妻に言った、「御主人はわたしがいるので家の中の何をも顧みず、その持ち物をみなわたしの手にゆだねられました。"},{"ref":"Gen.39.9","start":1039009,"end":1039009,"break":"none","ruby":[[2,1,"いえ"],[11,1,"おお"],[15,1,"もの"],[25,1,"ご"],[26,2,"しゅじん"],[33,1,"のぞ"],[38,1,"なに"],[45,1,"きん"],[60,1,"ご"],[61,2,"しゅじん"],[64,1,"つま"],[83,1,"おお"],[86,1,"あく"],[94,1,"かみ"],[96,1,"つみ"],[98,1,"おか"]],"text":"この家にはわたしよりも大いなる者はありません。また御主人はあなたを除いては、何をもわたしに禁じられませんでした。あなたが御主人の妻であるからです。どうしてわたしはこの大きな悪をおこなって、神に罪を犯すことができましょう」。"},{"ref":"Gen.39.10","start":1039010,"end":1039010,"break":"none","ruby":[[0,2,"かのじょ"],[3,2,"まいにち"],[9,1,"い"],[11,1,"よ"],[23,1,"き"],[29,2,"かのじょ"],[32,1,"ね"],[40,1,"とも"]],"text":"彼女は毎日ヨセフに言い寄ったけれども、ヨセフは聞きいれず、彼女と寝なかった。また共にいなかった。"},{"ref":"Gen.39.11","start":1039011,"end":1039011,"break":"none","ruby":[[2,1,"ひ"],[7,1,"つとめ"],[14,1,"いえ"],[20,1,"とき"],[22,1,"いえ"],[24,1,"もの"]],"text":"ある日ヨセフが務をするために家にはいった時、家の者がひとりもそこにいなかったので、"},{"ref":"Gen.39.12","start":1039012,"end":1039012,"break":"none","ruby":[[0,2,"かのじょ"],[7,2,"きもの"],[10,1,"とら"],[19,1,"ね"],[25,1,"い"],[33,2,"きもの"],[36,2,"かのじょ"],[39,1,"て"],[41,1,"のこ"],[44,1,"そと"],[49,1,"で"]],"text":"彼女はヨセフの着物を捕えて、「わたしと寝なさい」と言った。ヨセフは着物を彼女の手に残して外にのがれ出た。"},{"ref":"Gen.39.13","start":1039013,"end":1039013,"break":"none","ruby":[[0,2,"かのじょ"],[7,2,"きもの"],[10,2,"じぶん"],[13,1,"て"],[15,1,"のこ"],[18,1,"そと"],[26,1,"み"]],"text":"彼女はヨセフが着物を自分の手に残して外にのがれたのを見て、"},{"ref":"Gen.39.14","start":1039014,"end":1039014,"break":"none","ruby":[[2,1,"いえ"],[4,1,"もの"],[8,1,"よ"],[11,1,"かれ"],[14,1,"つ"],[17,1,"い"],[22,2,"しゅじん"],[31,1,"ところ"],[33,1,"つ"],[51,1,"たわむ"],[56,1,"かれ"],[62,1,"ね"],[73,1,"ところ"],[86,2,"おおごえ"],[89,1,"さけ"]],"text":"その家の者どもを呼び、彼らに告げて言った、「主人がわたしたちの所に連れてきたヘブルびとは、わたしたちに戯れます。彼はわたしと寝ようとして、わたしの所にはいったので、わたしは大声で叫びました。"},{"ref":"Gen.39.15","start":1039015,"end":1039015,"break":"none","ruby":[[0,1,"かれ"],[6,1,"こえ"],[11,1,"さけ"],[15,1,"き"],[19,2,"きもの"],[26,1,"ところ"],[28,1,"のこ"],[31,1,"そと"],[36,1,"で"]],"text":"彼はわたしが声をあげて叫ぶのを聞くと、着物をわたしの所に残して外にのがれ出ました」。"},{"ref":"Gen.39.16","start":1039016,"end":1039016,"break":"none","ruby":[[0,2,"かのじょ"],[5,2,"きもの"],[13,1,"お"],[17,2,"しゅじん"],[20,1,"かえ"],[23,1,"く"],[27,1,"ま"]],"text":"彼女はその着物をかたわらに置いて、主人の帰って来るのを待った。"},{"ref":"Gen.39.17","start":1039017,"end":1039017,"break":"none","ruby":[[3,2,"かのじょ"],[6,1,"つぎ"],[11,2,"しゅじん"],[14,1,"つ"],[29,1,"つ"],[48,1,"たわむ"],[60,1,"ところ"]],"text":"そして彼女は次のように主人に告げた、「あなたがわたしたちに連れてこられたヘブルのしもべはわたしに戯れようとして、わたしの所にはいってきました。"},{"ref":"Gen.39.18","start":1039018,"end":1039018,"break":"none","ruby":[[4,1,"こえ"],[9,1,"さけ"],[15,1,"かれ"],[17,2,"きもの"],[24,1,"ところ"],[26,1,"のこ"],[29,1,"そと"]],"text":"わたしが声をあげて叫んだので、彼は着物をわたしの所に残して外にのがれました」。"},{"ref":"Gen.39.19","start":1039019,"end":1039019,"break":"paragraph","ruby":[[0,2,"しゅじん"],[5,1,"つま"],[24,1,"こと"],[30,1,"つ"],[33,2,"ことば"],[36,1,"き"],[40,1,"はげ"],[43,1,"いか"]],"text":"主人はその妻が「あなたのしもべは、わたしにこんな事をした」と告げる言葉を聞いて、激しく怒った。"},{"ref":"Gen.39.20","start":1039020,"end":1039020,"break":"none","ruby":[[7,2,"しゅじん"],[10,1,"かれ"],[12,1,"とら"],[16,1,"おう"],[18,2,"しゅうじん"],[24,2,"ごくや"],[27,1,"な"],[29,1,"い"],[41,2,"ごくや"],[44,1,"なか"]],"text":"そしてヨセフの主人は彼を捕えて、王の囚人をつなぐ獄屋に投げ入れた。こうしてヨセフは獄屋の中におったが、"},{"ref":"Gen.39.21","start":1039021,"end":1039021,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"とも"],[12,1,"かれ"],[20,1,"た"],[23,2,"ごくや"],[25,1,"ばん"],[27,1,"めぐ"]],"text":"主はヨセフと共におられて彼にいつくしみを垂れ、獄屋番の恵みをうけさせられた。"},{"ref":"Gen.39.22","start":1039022,"end":1039022,"break":"none","ruby":[[0,2,"ごくや"],[2,1,"ばん"],[4,2,"ごくや"],[13,2,"しゅうじん"],[20,1,"て"],[29,1,"かれ"],[40,1,"こと"]],"text":"獄屋番は獄屋におるすべての囚人をヨセフの手にゆだねたので、彼はそこでするすべての事をおこなった。"},{"ref":"Gen.39.23","start":1039023,"end":1039023,"break":"none","ruby":[[0,2,"ごくや"],[2,1,"ばん"],[4,1,"かれ"],[6,1,"て"],[12,1,"こと"],[18,1,"かえり"],[25,1,"しゅ"],[31,1,"とも"],[43,1,"しゅ"],[45,1,"かれ"],[49,1,"こと"],[51,1,"さか"]],"text":"獄屋番は彼の手にゆだねた事はいっさい顧みなかった。主がヨセフと共におられたからである。主は彼のなす事を栄えさせられた。"}]