[{"ref":"Acts.27.1","start":44027001,"end":44027001,"break":"paragraph","ruby":[[10,1,"ふね"],[17,1,"い"],[22,1,"き"],[26,1,"とき"],[36,2,"すうにん"],[39,2,"しゅうじん"],[44,2,"このえ"],[46,1,"たい"],[48,3,"ひゃくそつちょう"],[56,1,"たく"]],"text":"さて、わたしたちが、舟でイタリヤに行くことが決まった時、パウロとそのほか数人の囚人とは、近衛隊の百卒長ユリアスに託された。"},{"ref":"Acts.27.2","start":44027002,"end":44027002,"break":"none","ruby":[[13,2,"えんがん"],[16,2,"かくしょ"],[19,2,"きこう"],[38,1,"ふね"],[40,1,"の"],[42,1,"こ"],[46,2,"しゅっぱん"],[62,1,"びと"],[70,2,"どうこう"]],"text":"そしてわたしたちは、アジヤ沿岸の各所に寄港することになっているアドラミテオの舟に乗り込んで、出帆した。テサロニケのマケドニヤ人アリスタルコも同行した。"},{"ref":"Acts.27.3","start":44027003,"end":44027003,"break":"none","ruby":[[0,1,"つぎ"],[2,1,"ひ"],[8,2,"にゅうこう"],[24,2,"しんせつ"],[27,1,"と"],[29,1,"あつか"],[32,2,"ゆうじん"],[45,1,"う"],[52,1,"ゆる"]],"text":"次の日、シドンに入港したが、ユリアスは、パウロを親切に取り扱い、友人をおとずれてかんたいを受けることを、許した。"},{"ref":"Acts.27.4","start":44027004,"end":44027004,"break":"none","ruby":[[15,2,"ふなで"],[21,2,"ぎゃくふう"],[34,1,"しま"],[38,2,"こうこう"]],"text":"それからわたしたちは、ここから船出したが、逆風にあったので、クプロの島かげを航行し、"},{"ref":"Acts.27.5","start":44027005,"end":44027005,"break":"none","ruby":[[11,1,"おき"],[13,1,"す"],[24,2,"にゅうこう"]],"text":"キリキヤとパンフリヤの沖を過ぎて、ルキヤのミラに入港した。"},{"ref":"Acts.27.6","start":44027006,"end":44027006,"break":"none","ruby":[[8,1,"い"],[20,1,"ふね"],[28,3,"ひゃくそつちょう"],[41,1,"ふね"],[43,1,"の"],[45,1,"こ"]],"text":"そこに、イタリヤ行きのアレキサンドリヤの舟があったので、百卒長は、わたしたちをその舟に乗り込ませた。"},{"ref":"Acts.27.7","start":44027007,"end":44027007,"break":"none","ruby":[[0,2,"いくにち"],[8,1,"ふね"],[10,1,"すす"],[34,2,"おきあい"],[41,1,"かぜ"],[49,1,"ゆ"],[51,1,"て"],[64,1,"おき"],[70,1,"しま"],[74,2,"こうこう"]],"text":"幾日ものあいだ、舟の進みがおそくて、わたしたちは、かろうじてクニドの沖合にきたが、風がわたしたちの行く手をはばむので、サルモネの沖、クレテの島かげを航行し、"},{"ref":"Acts.27.8","start":44027008,"end":44027008,"break":"none","ruby":[[2,1,"きし"],[4,1,"そ"],[7,1,"すす"],[16,1,"よ"],[18,1,"みなと"],[21,1,"よ"],[25,1,"ところ"],[27,1,"つ"],[33,1,"ちか"],[40,1,"まち"]],"text":"その岸に沿って進み、かろうじて「良き港」と呼ばれる所に着いた。その近くにラサヤの町があった。"},{"ref":"Acts.27.9","start":44027009,"end":44027009,"break":"paragraph","ruby":[[0,1,"なが"],[2,1,"とき"],[4,2,"けいか"],[8,2,"だんじき"],[10,1,"き"],[12,1,"す"],[22,2,"こうかい"],[25,2,"きけん"],[28,2,"きせつ"],[41,2,"ひとびと"],[44,2,"けいこく"],[48,1,"い"]],"text":"長い時が経過し、断食期も過ぎてしまい、すでに航海が危険な季節になったので、パウロは人々に警告して言った、"},{"ref":"Acts.27.10","start":44027010,"end":44027010,"break":"none","ruby":[[1,1,"みな"],[9,1,"み"],[19,2,"こうかい"],[24,2,"つみに"],[27,2,"せんたい"],[41,2,"せいめい"],[46,2,"きがい"],[49,1,"おお"],[52,2,"そんしつ"],[55,1,"およ"]],"text":"「皆さん、わたしの見るところでは、この航海では、積荷や船体ばかりでなく、われわれの生命にも、危害と大きな損失が及ぶであろう」。"},{"ref":"Acts.27.11","start":44027011,"end":44027011,"break":"none","ruby":[[3,3,"ひゃくそつちょう"],[12,1,"い"],[13,1,"み"],[18,2,"せんちょう"],[21,2,"せんしゅ"],[24,1,"ほう"],[26,2,"しんらい"]],"text":"しかし百卒長は、パウロの意見よりも、船長や船主の方を信頼した。"},{"ref":"Acts.27.12","start":44027012,"end":44027012,"break":"none","ruby":[[5,1,"みなと"],[7,1,"ふゆ"],[9,1,"す"],[14,1,"てき"],[21,3,"だいたすう"],[25,1,"もの"],[32,1,"で"],[46,2,"なんせい"],[49,2,"ほくせい"],[53,1,"めん"],[66,1,"こう"],[68,1,"い"],[75,1,"ふゆ"],[77,1,"す"],[83,2,"しゅちょう"]],"text":"なお、この港は冬を過ごすのに適しないので、大多数の者は、ここから出て、できればなんとかして、南西と北西とに面しているクレテのピニクス港に行って、そこで冬を過ごしたいと主張した。"},{"ref":"Acts.27.13","start":44027013,"end":44027013,"break":"paragraph","ruby":[[0,1,"とき"],[3,2,"なんぷう"],[6,1,"しず"],[9,1,"ふ"],[17,1,"かれ"],[23,1,"とき"],[33,1,"あ"],[41,1,"きし"],[43,1,"そ"],[46,2,"こうこう"]],"text":"時に、南風が静かに吹いてきたので、彼らは、この時とばかりにいかりを上げて、クレテの岸に沿って航行した。"},{"ref":"Acts.27.14","start":44027014,"end":44027014,"break":"none","ruby":[[3,1,"ま"],[15,1,"よ"],[19,2,"ぼうふう"],[23,1,"しま"],[26,1,"ふ"]],"text":"すると間もなく、ユーラクロンと呼ばれる暴風が、島から吹きおろしてきた。"},{"ref":"Acts.27.15","start":44027015,"end":44027015,"break":"none","ruby":[[6,1,"ふね"],[8,1,"なが"],[12,1,"かぜ"],[14,1,"さか"],[33,1,"ふ"],[35,1,"なが"],[42,1,"まか"]],"text":"そのために、舟が流されて風に逆らうことができないので、わたしたちは吹き流されるままに任せた。"},{"ref":"Acts.27.16","start":44027016,"end":44027016,"break":"none","ruby":[[12,2,"こじま"],[15,1,"かげ"],[21,1,"こ"],[41,2,"こぶね"],[44,2,"しょち"]],"text":"それから、クラウダという小島の陰に、はいり込んだので、わたしたちは、やっとのことで小舟を処置することができ、"},{"ref":"Acts.27.17","start":44027017,"end":44027017,"break":"none","ruby":[[3,1,"ふね"],[5,1,"ひ"],[7,1,"あ"],[13,1,"つな"],[15,2,"せんたい"],[18,1,"ま"],[32,1,"す"],[34,1,"の"],[36,1,"あ"],[41,1,"おそ"],[44,1,"ほ"],[50,1,"なが"]],"text":"それを舟に引き上げてから、綱で船体を巻きつけた。また、スルテスの洲に乗り上げるのを恐れ、帆をおろして流れるままにした。"},{"ref":"Acts.27.18","start":44027018,"end":44027018,"break":"none","ruby":[[7,2,"ぼうふう"],[13,1,"なや"],[24,1,"つぎ"],[26,1,"ひ"],[29,2,"ひとびと"],[32,2,"つみに"],[35,1,"す"]],"text":"わたしたちは、暴風にひどく悩まされつづけたので、次の日に、人々は積荷を捨てはじめ、"},{"ref":"Acts.27.19","start":44027019,"end":44027019,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[6,2,"ふなぐ"],[16,1,"な"]],"text":"三日目には、船具までも、てずから投げすてた。"},{"ref":"Acts.27.20","start":44027020,"end":44027020,"break":"none","ruby":[[0,2,"いくにち"],[8,2,"たいよう"],[11,1,"ほし"],[13,1,"み"],[17,2,"ぼうふう"],[20,1,"はげ"],[23,1,"ふ"],[37,1,"たす"],[40,2,"さいご"],[43,1,"のぞ"]],"text":"幾日ものあいだ、太陽も星も見えず、暴風は激しく吹きすさぶので、わたしたちの助かる最後の望みもなくなった。"},{"ref":"Acts.27.21","start":44027021,"end":44027021,"break":"paragraph","ruby":[[4,1,"もの"],[7,1,"なが"],[12,2,"しょくじ"],[25,1,"とき"],[31,1,"かれ"],[34,1,"なか"],[36,1,"た"],[39,1,"い"],[44,1,"みな"],[59,2,"ちゅうこく"],[62,1,"き"],[73,1,"で"],[85,2,"きがい"],[88,2,"そんしつ"],[91,1,"こうむ"]],"text":"みんなの者は、長いあいだ食事もしないでいたが、その時、パウロが彼らの中に立って言った、「皆さん、あなたがたが、わたしの忠告を聞きいれて、クレテから出なかったら、このような危害や損失を被らなくてすんだはずであった。"},{"ref":"Acts.27.22","start":44027022,"end":44027022,"break":"none","ruby":[[5,1,"さい"],[8,1,"すす"],[13,2,"げんき"],[16,1,"だ"],[22,1,"ふね"],[24,1,"うしな"],[38,1,"なか"],[40,2,"せいめい"],[43,1,"うしな"]],"text":"だが、この際、お勧めする。元気を出しなさい。舟が失われるだけで、あなたがたの中で生命を失うものは、ひとりもいないであろう。"},{"ref":"Acts.27.23","start":44027023,"end":44027023,"break":"none","ruby":[[0,2,"さくや"],[7,1,"つか"],[12,1,"おが"],[17,1,"かみ"],[21,2,"みつかい"],[32,1,"た"],[35,1,"い"]],"text":"昨夜、わたしが仕え、また拝んでいる神からの御使が、わたしのそばに立って言った、"},{"ref":"Acts.27.24","start":44027024,"end":44027024,"break":"none","ruby":[[6,1,"おそ"],[15,1,"かなら"],[22,1,"まえ"],[24,1,"た"],[39,1,"かみ"],[46,2,"どうせん"],[49,1,"もの"],[61,1,"たま"]],"text":"『パウロよ、恐れるな。あなたは必ずカイザルの前に立たなければならない。たしかに神は、あなたと同船の者を、ことごとくあなたに賜わっている』。"},{"ref":"Acts.27.25","start":44027025,"end":44027025,"break":"none","ruby":[[4,1,"みな"],[8,2,"げんき"],[11,1,"だ"],[17,2,"ばんじ"],[24,1,"つ"],[33,1,"な"],[36,1,"い"],[45,1,"かみ"],[49,1,"しん"]],"text":"だから、皆さん、元気を出しなさい。万事はわたしに告げられたとおりに成って行くと、わたしは、神かけて信じている。"},{"ref":"Acts.27.26","start":44027026,"end":44027026,"break":"none","ruby":[[10,1,"しま"],[12,1,"う"],[20,2,"そうい"]],"text":"われわれは、どこかの島に打ちあげられるに相違ない」。"},{"ref":"Acts.27.27","start":44027027,"end":44027027,"break":"paragraph","ruby":[[10,1,"うみ"],[12,1,"ただよ"],[19,1,"か"],[20,1,"め"],[22,1,"よる"],[27,1,"とき"],[29,3,"まよなか"],[35,2,"すいふ"],[43,2,"りくち"],[46,1,"ちか"],[53,1,"かん"]],"text":"わたしたちがアドリヤ海に漂ってから十四日目の夜になった時、真夜中ごろ、水夫らはどこかの陸地に近づいたように感じた。"},{"ref":"Acts.27.28","start":44027028,"end":44027028,"break":"none","ruby":[[4,1,"みず"],[6,1,"ふか"],[9,1,"はか"],[37,1,"すこ"],[39,1,"すす"],[45,2,"いちど"],[47,1,"はか"]],"text":"そこで、水の深さを測ってみたところ、二十ひろであることがわかった。それから少し進んで、もう一度測ってみたら、十五ひろであった。"},{"ref":"Acts.27.29","start":44027029,"end":44027029,"break":"none","ruby":[[7,2,"まんいち"],[9,2,"あんしょう"],[12,1,"の"],[14,1,"あ"],[18,2,"たいへん"],[23,2,"ひとびと"],[26,1,"き"],[43,1,"な"],[49,1,"よ"],[51,1,"あ"],[56,1,"ま"]],"text":"わたしたちが、万一暗礁に乗り上げては大変だと、人々は気づかって、ともから四つのいかりを投げおろし、夜の明けるのを待ちわびていた。"},{"ref":"Acts.27.30","start":44027030,"end":44027030,"break":"none","ruby":[[2,1,"とき"],[4,2,"すいふ"],[8,1,"ふね"],[11,1,"に"],[13,1,"だ"],[17,1,"おも"],[30,1,"な"],[36,1,"み"],[41,2,"こぶね"],[44,1,"うみ"]],"text":"その時、水夫らが舟から逃げ出そうと思って、へさきからいかりを投げおろすと見せかけ、小舟を海におろしていたので、"},{"ref":"Acts.27.31","start":44027031,"end":44027031,"break":"none","ruby":[[5,3,"ひゃくそつちょう"],[9,2,"へいそつ"],[14,1,"い"],[21,1,"ひと"],[26,1,"ふね"],[28,1,"のこ"],[43,1,"たす"]],"text":"パウロは、百卒長や兵卒たちに言った、「あの人たちが、舟に残っていなければ、あなたがたは助からない」。"},{"ref":"Acts.27.32","start":44027032,"end":44027032,"break":"none","ruby":[[3,2,"へいそつ"],[9,2,"こぶね"],[12,1,"つな"],[14,1,"た"],[16,1,"き"],[22,1,"なが"],[25,1,"い"],[30,1,"まか"]],"text":"そこで兵卒たちは、小舟の綱を断ち切って、その流れて行くままに任せた。"},{"ref":"Acts.27.33","start":44027033,"end":44027033,"break":"paragraph","ruby":[[0,1,"よ"],[2,1,"あ"],[14,2,"いちどう"],[17,1,"もの"],[20,2,"しょくじ"],[28,1,"すす"],[31,1,"い"],[42,2,"しょくじ"],[49,2,"みは"],[53,1,"つづ"],[59,1,"なに"],[61,1,"た"],[73,1,"か"],[74,1,"め"],[76,1,"あた"]],"text":"夜が明けかけたころ、パウロは一同の者に、食事をするように勧めて言った、「あなたがたが食事もせずに、見張りを続けてから、何も食べないで、きょうが十四日目に当る。"},{"ref":"Acts.27.34","start":44027034,"end":44027034,"break":"none","ruby":[[6,2,"しょくじ"],[9,1,"と"],[15,1,"すす"],[30,1,"すく"],[46,1,"かみ"],[48,1,"け"],[62,1,"あたま"],[65,1,"うしな"]],"text":"だから、いま食事を取ることをお勧めする。それが、あなたがたを救うことになるのだから。たしかに髪の毛ひとすじでも、あなたがたの頭から失われることはないであろう」。"},{"ref":"Acts.27.35","start":44027035,"end":44027035,"break":"none","ruby":[[0,1,"かれ"],[4,1,"い"],[11,1,"と"],[18,1,"まえ"],[20,1,"かみ"],[22,2,"かんしゃ"],[32,1,"た"]],"text":"彼はこう言って、パンを取り、みんなの前で神に感謝し、それをさいて食べはじめた。"},{"ref":"Acts.27.36","start":44027036,"end":44027036,"break":"none","ruby":[[8,1,"もの"],[10,1,"もと"],[11,1,"き"],[15,2,"しょくじ"]],"text":"そこで、みんなの者も元気づいて食事をした。"},{"ref":"Acts.27.37","start":44027037,"end":44027037,"break":"none","ruby":[[0,1,"ふね"],[11,1,"あ"],[20,1,"にん"]],"text":"舟にいたわたしたちは、合わせて二百七十六人であった。"},{"ref":"Acts.27.38","start":44027038,"end":44027038,"break":"none","ruby":[[4,1,"もの"],[13,2,"しょくじ"],[18,1,"のち"],[20,2,"こくもつ"],[23,1,"うみ"],[25,1,"な"],[30,1,"ふね"],[32,1,"かろ"]],"text":"みんなの者は、じゅうぶんに食事をした後、穀物を海に投げすてて舟を軽くした。"},{"ref":"Acts.27.39","start":44027039,"end":44027039,"break":"paragraph","ruby":[[0,1,"よ"],[2,1,"あ"],[9,2,"とち"],[23,2,"すなはま"],[28,2,"いりえ"],[31,1,"み"],[45,1,"ふね"],[47,1,"の"],[49,1,"い"]],"text":"夜が明けて、どこの土地かよくわからなかったが、砂浜のある入江が見えたので、できれば、それに舟を乗り入れようということになった。"},{"ref":"Acts.27.40","start":44027040,"end":44027040,"break":"none","ruby":[[8,1,"き"],[10,1,"はな"],[13,1,"うみ"],[15,1,"す"],[18,2,"どうじ"],[24,1,"つな"],[30,1,"かぜ"],[32,1,"まえ"],[34,1,"ほ"],[40,2,"すなはま"],[47,1,"すす"]],"text":"そこで、いかりを切り離して海に捨て、同時にかじの綱をゆるめ、風に前の帆をあげて、砂浜にむかって進んだ。"},{"ref":"Acts.27.41","start":44027041,"end":44027041,"break":"none","ruby":[[5,2,"ちょうりゅう"],[8,1,"なが"],[10,1,"あ"],[12,1,"ところ"],[14,1,"つ"],[16,1,"すす"],[22,1,"ふね"],[24,2,"あさせ"],[27,1,"の"],[43,1,"こ"],[46,1,"うご"],[56,1,"ほう"],[58,2,"げきろう"]],"text":"ところが、潮流の流れ合う所に突き進んだため、舟を浅瀬に乗りあげてしまって、へさきがめり込んで動かなくなり、ともの方は激浪のためにこわされた。"},{"ref":"Acts.27.42","start":44027042,"end":44027042,"break":"none","ruby":[[0,2,"へいそつ"],[6,2,"しゅうじん"],[10,1,"およ"],[13,1,"に"],[25,1,"ころ"],[33,1,"はか"]],"text":"兵卒たちは、囚人らが泳いで逃げるおそれがあるので、殺してしまおうと図ったが、"},{"ref":"Acts.27.43","start":44027043,"end":44027043,"break":"none","ruby":[[0,3,"ひゃくそつちょう"],[9,1,"すく"],[14,1,"おも"],[24,2,"いと"],[32,1,"およ"],[35,1,"もの"],[39,1,"うみ"],[41,1,"と"],[43,1,"こ"],[46,1,"りく"],[48,1,"い"]],"text":"百卒長は、パウロを救いたいと思うところから、その意図をしりぞけ、泳げる者はまず海に飛び込んで陸に行き、"},{"ref":"Acts.27.44","start":44027044,"end":44027044,"break":"none","ruby":[[2,1,"た"],[4,1,"もの"],[7,1,"いた"],[9,1,"ふね"],[11,2,"はへん"],[14,1,"の"],[17,1,"い"],[22,1,"めい"],[31,2,"ぜんぶ"],[34,1,"もの"],[36,2,"じょうりく"],[40,1,"すく"]],"text":"その他の者は、板や舟の破片に乗って行くように命じた。こうして、全部の者が上陸して救われたのであった。"}]