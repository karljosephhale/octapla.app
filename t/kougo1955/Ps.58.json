[{"ref":"Ps.58.1","start":19058001,"end":19058001,"break":"paragraph","title":"聖歌隊の指揮者によって、「滅ぼすな」というしらべにあわせてうたわせたダビデのミクタムの歌","breaks":[[11,"line"],[29,"line"]],"ruby":[[5,1,"ちから"],[8,1,"もの"],[21,1,"ただ"],[24,1,"こと"],[26,1,"かた"],[29,2,"こうへい"],[35,1,"ひと"],[37,1,"こ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[13,1,"ほろ"],[43,1,"うた"]],"text":"あなたがた力ある者よ、まことにあなたがたは正しい事を語り、公平をもって人の子らをさばくのか。"},{"ref":"Ps.58.2","start":19058002,"end":19058002,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"いな"],[8,1,"こころ"],[13,1,"わる"],[15,1,"こと"],[24,1,"て"],[26,1,"ち"],[28,2,"ぼうぎゃく"],[31,1,"おこな"]],"text":"否、あなたがたは心のうちに悪い事をたくらみ、その手は地に暴虐を行う。"},{"ref":"Ps.58.3","start":19058003,"end":19058003,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"たい"],[7,1,"で"],[9,1,"とき"],[16,1,"さ"],[19,1,"うま"],[21,1,"で"],[23,1,"とき"],[32,1,"おか"],[35,1,"いつわ"],[38,1,"かた"]],"text":"悪しき者は胎を出た時から、そむき去り、生れ出た時から、あやまちを犯し、偽りを語る。"},{"ref":"Ps.58.4","start":19058004,"end":19058005,"break":"line","breaks":[[16,"line"],[39,"line"]],"ruby":[[0,1,"かれ"],[6,1,"どく"],[11,1,"どく"],[16,3,"まほうつかい"],[22,1,"たく"],[25,2,"じゅもん"],[28,1,"とな"],[31,1,"もの"],[33,1,"こえ"],[35,1,"き"],[39,1,"みみ"],[44,1,"みみ"]],"text":"彼らはへびの毒のような毒をもち、魔法使または巧みに呪文を唱える者の声を聞かない耳をふさぐ耳しいのまむしのようである。"},{"ref":"Ps.58.6","start":19058006,"end":19058006,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[3,1,"かれ"],[6,1,"くち"],[8,1,"は"],[10,1,"お"],[18,1,"しゅ"],[21,1,"わか"],[29,1,"ぬ"],[31,1,"くだ"]],"text":"神よ、彼らの口の歯を折ってください。主よ、若いししのきばを抜き砕いてください。"},{"ref":"Ps.58.7","start":19058007,"end":19058007,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"なが"],[7,1,"みず"],[12,1,"き"],[14,1,"さ"],[18,1,"ふ"],[20,1,"たお"],[24,2,"わかくさ"],[30,1,"おとろ"]],"text":"彼らを流れゆく水のように消え去らせ、踏み倒される若草のように衰えさせてください。"},{"ref":"Ps.58.8","start":19058008,"end":19058008,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"と"],[22,1,"とき"],[26,1,"うま"],[29,1,"ひ"],[31,1,"み"],[33,1,"こ"]],"text":"また溶けてどろどろになるかたつむりのように、時ならず生れた日を見ぬ子のようにしてください。"},{"ref":"Ps.58.9","start":19058009,"end":19058009,"break":"line","breaks":[[22,"line"],[41,"line"]],"ruby":[[6,1,"かま"],[14,1,"ねつ"],[16,1,"かん"],[20,1,"まえ"],[22,1,"あお"],[27,1,"も"],[34,1,"とも"],[39,1,"かぜ"],[41,1,"ふ"],[43,1,"はら"],[50,1,"かれ"],[53,1,"ふ"],[55,1,"はら"]],"text":"あなたがたの釜がまだいばらの熱を感じない前に青いのも、燃えているのも共につむじ風に吹き払われるように彼らを吹き払ってください。"},{"ref":"Ps.58.10","start":19058010,"end":19058010,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,2,"ふくしゅう"],[8,1,"み"],[10,1,"よろこ"],[15,1,"あし"],[17,1,"あ"],[20,1,"もの"],[22,1,"ち"],[24,1,"あら"]],"text":"正しい者は復讐を見て喜び、その足を悪しき者の血で洗うであろう。"},{"ref":"Ps.58.11","start":19058011,"end":19058011,"break":"line","breaks":[[13,"line"],[30,"line"]],"ruby":[[3,2,"ひとびと"],[6,1,"い"],[18,1,"ただ"],[21,1,"もの"],[24,1,"むく"],[34,1,"ち"],[40,1,"おこな"],[44,1,"かみ"]],"text":"そして人々は言うであろう、「まことに正しい者には報いがある。まことに地にさばきを行われる神がある」と。"}]