[{"ref":"1Chr.25.1","start":13025001,"end":13025001,"break":"paragraph","ruby":[[4,1,"ぐん"],[6,1,"ちょう"],[27,1,"こ"],[30,1,"つと"],[36,1,"わ"],[40,1,"こと"],[43,2,"たてごと"],[55,2,"よげん"],[59,1,"もの"],[66,1,"つと"],[72,2,"ひとびと"],[75,1,"かず"],[77,1,"つぎ"]],"text":"ダビデと軍の長たちはまたアサフ、ヘマンおよびエドトンの子らを勤めのために分かち、琴と、立琴と、シンバルをもって預言する者にした。その勤めをなした人々の数は次のとおりである。"},{"ref":"1Chr.25.2","start":13025002,"end":13025002,"break":"none","ruby":[[4,1,"こ"],[35,2,"しき"],[41,1,"おう"],[43,1,"いのち"],[48,2,"よげん"],[52,1,"もの"]],"text":"アサフの子たちはザックル、ヨセフ、ネタニヤ、アサレラであって、アサフの指揮のもとに王の命によって預言した者である。"},{"ref":"1Chr.25.3","start":13025003,"end":13025003,"break":"none","ruby":[[15,1,"こ"],[44,1,"にん"],[47,1,"こと"],[52,1,"しゅ"],[54,2,"かんしゃ"],[66,2,"よげん"],[72,1,"ちち"],[78,2,"しき"],[81,1,"した"]],"text":"エドトンについては、エドトンの子たちはゲダリヤ、ゼリ、エサヤ、ハシャビヤ、マッタテヤの六人で、琴をもって主に感謝し、かつほめたたえて預言したその父エドトンの指揮の下にあった。"},{"ref":"1Chr.25.4","start":13025004,"end":13025004,"break":"none","ruby":[[13,1,"こ"]],"text":"ヘマンについては、ヘマンの子たちはブッキヤ、マッタニヤ、ウジエル、シブエル、エレモテ、ハナニヤ、ハナニ、エリアタ、ギダルテ、ロマムテ・エゼル、ヨシベカシャ、マロテ、ホテル、マハジオテである。"},{"ref":"1Chr.25.5","start":13025005,"end":13025005,"break":"none","ruby":[[4,1,"みな"],[6,1,"かみ"],[9,2,"じしん"],[12,2,"やくそく"],[20,1,"たか"],[25,1,"おう"],[27,3,"せんけんしゃ"],[34,1,"こ"],[42,1,"かみ"],[48,1,"おとこ"],[50,1,"こ"],[53,1,"にん"],[55,1,"おんな"],[57,1,"こ"],[59,1,"にん"],[61,1,"あた"]],"text":"これらは皆、神がご自身の約束にしたがって高くされた王の先見者ヘマンの子たちであった。神はヘマンに男の子十四人、女の子三人を与えられた。"},{"ref":"1Chr.25.6","start":13025006,"end":13025006,"break":"none","ruby":[[4,1,"もの"],[6,1,"みな"],[9,1,"ちち"],[11,2,"しき"],[14,1,"した"],[20,1,"しゅ"],[22,1,"みや"],[24,1,"うた"],[35,2,"たてごと"],[38,1,"こと"],[43,1,"かみ"],[45,1,"みや"],[47,1,"つとめ"],[67,1,"おう"],[69,1,"いのち"],[71,1,"した"]],"text":"これらの者は皆その父の指揮の下にあって、主の宮で歌をうたい、シンバルと立琴と琴をもって神の宮の務をした。アサフ、エドトンおよびヘマンは王の命の下にあった。"},{"ref":"1Chr.25.7","start":13025007,"end":13025007,"break":"none","ruby":[[0,1,"かれ"],[5,1,"しゅ"],[7,1,"うた"],[18,2,"くんれん"],[26,2,"じゅくれん"],[30,2,"きょうだい"],[35,1,"かず"],[42,1,"にん"]],"text":"彼らおよび主に歌をうたうことのために訓練され、すべて熟練した兄弟たちの数は二百八十八人であった。"},{"ref":"1Chr.25.8","start":13025008,"end":13025008,"break":"none","ruby":[[0,1,"かれ"],[3,1,"しょう"],[6,1,"もの"],[9,1,"だい"],[12,1,"もの"],[15,2,"きょうし"],[18,2,"せいと"],[21,1,"みな"],[28,1,"つとめ"],[36,1,"ひ"]],"text":"彼らは小なる者も、大なる者も、教師も生徒も皆ひとしくその務のためにくじを引いた。"},{"ref":"1Chr.25.9","start":13025009,"end":13025009,"break":"paragraph","ruby":[[0,1,"だい"],[17,1,"あた"],[20,1,"だい"],[28,1,"あた"],[32,1,"かれ"],[36,2,"きょうだい"],[45,1,"こ"],[49,1,"あ"],[55,1,"にん"]],"text":"第一のくじはアサフのためにヨセフに当り、第二はゲダリヤに当った。彼とその兄弟たちおよびその子たち、合わせて十二人。"},{"ref":"1Chr.25.10","start":13025010,"end":13025010,"break":"none","ruby":[[0,1,"だい"],[8,1,"あた"],[14,1,"こ"],[22,2,"きょうだい"],[27,1,"あ"],[33,1,"にん"]],"text":"第三はザックルに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.11","start":13025011,"end":13025011,"break":"none","ruby":[[0,1,"だい"],[7,1,"あた"],[13,1,"こ"],[21,2,"きょうだい"],[26,1,"あ"],[32,1,"にん"]],"text":"第四はイヅリに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.12","start":13025012,"end":13025012,"break":"none","ruby":[[0,1,"だい"],[8,1,"あた"],[14,1,"こ"],[22,2,"きょうだい"],[27,1,"あ"],[33,1,"にん"]],"text":"第五はネタニヤに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.13","start":13025013,"end":13025013,"break":"none","ruby":[[0,1,"だい"],[8,1,"あた"],[14,1,"こ"],[22,2,"きょうだい"],[27,1,"あ"],[33,1,"にん"]],"text":"第六はブッキヤに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.14","start":13025014,"end":13025014,"break":"none","ruby":[[0,1,"だい"],[8,1,"あた"],[14,1,"こ"],[22,2,"きょうだい"],[27,1,"あ"],[33,1,"にん"]],"text":"第七はアサレラに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.15","start":13025015,"end":13025015,"break":"none","ruby":[[0,1,"だい"],[7,1,"あた"],[13,1,"こ"],[21,2,"きょうだい"],[26,1,"あ"],[32,1,"にん"]],"text":"第八はエサヤに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.16","start":13025016,"end":13025016,"break":"none","ruby":[[0,1,"だい"],[9,1,"あた"],[15,1,"こ"],[23,2,"きょうだい"],[28,1,"あ"],[34,1,"にん"]],"text":"第九はマッタニヤに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.17","start":13025017,"end":13025017,"break":"none","ruby":[[0,1,"だい"],[7,1,"あた"],[13,1,"こ"],[21,2,"きょうだい"],[26,1,"あ"],[32,1,"にん"]],"text":"第十はシメイに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.18","start":13025018,"end":13025018,"break":"none","ruby":[[0,1,"だい"],[10,1,"あた"],[16,1,"こ"],[24,2,"きょうだい"],[29,1,"あ"],[35,1,"にん"]],"text":"第十一はアザリエルに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.19","start":13025019,"end":13025019,"break":"none","ruby":[[0,1,"だい"],[10,1,"あた"],[16,1,"こ"],[24,2,"きょうだい"],[29,1,"あ"],[35,1,"にん"]],"text":"第十二はハシャビヤに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.20","start":13025020,"end":13025020,"break":"none","ruby":[[0,1,"だい"],[10,1,"あた"],[16,1,"こ"],[24,2,"きょうだい"],[29,1,"あ"],[35,1,"にん"]],"text":"第十三はシュバエルに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.21","start":13025021,"end":13025021,"break":"none","ruby":[[0,1,"だい"],[10,1,"あた"],[16,1,"こ"],[24,2,"きょうだい"],[29,1,"あ"],[35,1,"にん"]],"text":"第十四はマッタテヤに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.22","start":13025022,"end":13025022,"break":"none","ruby":[[0,1,"だい"],[9,1,"あた"],[15,1,"こ"],[23,2,"きょうだい"],[28,1,"あ"],[34,1,"にん"]],"text":"第十五はエレモテに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.23","start":13025023,"end":13025023,"break":"none","ruby":[[0,1,"だい"],[9,1,"あた"],[15,1,"こ"],[23,2,"きょうだい"],[28,1,"あ"],[34,1,"にん"]],"text":"第十六はハナニヤに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.24","start":13025024,"end":13025024,"break":"none","ruby":[[0,1,"だい"],[11,1,"あた"],[17,1,"こ"],[25,2,"きょうだい"],[30,1,"あ"],[36,1,"にん"]],"text":"第十七はヨシベカシャに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.25","start":13025025,"end":13025025,"break":"none","ruby":[[0,1,"だい"],[8,1,"あた"],[14,1,"こ"],[22,2,"きょうだい"],[27,1,"あ"],[33,1,"にん"]],"text":"第十八はハナニに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.26","start":13025026,"end":13025026,"break":"none","ruby":[[0,1,"だい"],[8,1,"あた"],[14,1,"こ"],[22,2,"きょうだい"],[27,1,"あ"],[33,1,"にん"]],"text":"第十九はマロテに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.27","start":13025027,"end":13025027,"break":"none","ruby":[[0,1,"だい"],[9,1,"あた"],[15,1,"こ"],[23,2,"きょうだい"],[28,1,"あ"],[34,1,"にん"]],"text":"第二十はエリアタに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.28","start":13025028,"end":13025028,"break":"none","ruby":[[0,1,"だい"],[9,1,"あた"],[15,1,"こ"],[23,2,"きょうだい"],[28,1,"あ"],[34,1,"にん"]],"text":"第二十一はホテルに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.29","start":13025029,"end":13025029,"break":"none","ruby":[[0,1,"だい"],[10,1,"あた"],[16,1,"こ"],[24,2,"きょうだい"],[29,1,"あ"],[35,1,"にん"]],"text":"第二十二はギダルテに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.30","start":13025030,"end":13025030,"break":"none","ruby":[[0,1,"だい"],[11,1,"あた"],[17,1,"こ"],[25,2,"きょうだい"],[30,1,"あ"],[36,1,"にん"]],"text":"第二十三はマハジオテに当った。その子たちおよびその兄弟たち、合わせて十二人。"},{"ref":"1Chr.25.31","start":13025031,"end":13025031,"break":"none","ruby":[[0,1,"だい"],[14,1,"あた"],[20,1,"こ"],[28,2,"きょうだい"],[33,1,"あ"],[39,1,"にん"]],"text":"第二十四はロマムテ・エゼルに当った。その子たちおよびその兄弟たち、合わせて十二人であった。"}]