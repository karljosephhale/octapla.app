[{"ref":"Ezek.47.1","start":26047001,"end":26047001,"break":"paragraph","ruby":[[3,1,"かれ"],[9,1,"みや"],[11,2,"とぐち"],[14,1,"かえ"],[19,1,"み"],[22,1,"みず"],[24,1,"みや"],[26,2,"しきい"],[29,1,"した"],[33,1,"ひがし"],[35,1,"ほう"],[37,1,"なが"],[43,1,"みや"],[45,1,"ひがし"],[47,1,"めん"],[52,1,"みず"],[55,1,"した"],[58,1,"で"],[61,2,"さいだん"],[64,1,"みなみ"],[68,1,"みや"],[70,2,"しきい"],[73,1,"みなみ"],[75,1,"たん"],[79,1,"なが"],[81,1,"くだ"]],"text":"そして彼はわたしを宮の戸口に帰らせた。見よ、水の宮の敷居の下から、東の方へ流れていた。宮は東に面し、その水は、下から出て、祭壇の南にある宮の敷居の南の端から、流れ下っていた。"},{"ref":"Ezek.47.2","start":26047002,"end":26047002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"きた"],[4,1,"もん"],[6,1,"みち"],[14,1,"つ"],[16,1,"だ"],[19,1,"そと"],[26,1,"ひがし"],[28,1,"む"],[31,1,"そと"],[33,1,"もん"],[35,1,"い"],[40,1,"み"],[43,1,"みず"],[45,1,"みなみ"],[47,1,"ほう"],[50,1,"なが"],[52,1,"で"]],"text":"彼は北の門の道から、わたしを連れ出し、外をまわって、東に向かう外の門に行かせた。見よ、水は南の方から流れ出ていた。"},{"ref":"Ezek.47.3","start":26047003,"end":26047003,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"ひがし"],[6,1,"すす"],[9,1,"て"],[11,1,"はか"],[26,1,"はか"],[33,1,"わた"],[41,1,"みず"],[48,1,"たっ"]],"text":"その人は東に進み、手に測りなわをもって一千キュビトを測り、わたしを渡らせた。すると水はくるぶしに達した。"},{"ref":"Ezek.47.4","start":26047004,"end":26047004,"break":"none","ruby":[[0,1,"かれ"],[11,1,"はか"],[19,1,"わた"],[25,1,"みず"],[30,1,"たっ"],[34,1,"かれ"],[45,1,"はか"],[53,1,"わた"],[59,1,"みず"],[61,1,"こし"],[63,1,"たっ"]],"text":"彼がまた一千キュビトを測って、わたしを渡らせると、水はひざに達した。彼がまた一千キュビトを測って、わたしを渡らせると、水は腰に達した。"},{"ref":"Ezek.47.5","start":26047005,"end":26047005,"break":"none","ruby":[[0,1,"かれ"],[11,1,"はか"],[15,1,"わた"],[17,1,"え"],[23,1,"かわ"],[28,1,"みず"],[30,1,"ふか"],[36,1,"およ"],[42,1,"みず"],[44,1,"こ"],[46,1,"え"],[52,1,"かわ"]],"text":"彼がまた一千キュビトを測ると、渡り得ないほどの川になり、水は深くなって、泳げるほどの水、越え得ないほどの川になった。"},{"ref":"Ezek.47.6","start":26047006,"end":26047006,"break":"none","breaks":[[28,"paragraph"]],"ruby":[[0,1,"かれ"],[7,1,"ひと"],[9,1,"こ"],[19,1,"み"],[24,1,"い"],[33,1,"かれ"],[39,1,"かわ"],[41,1,"きし"],[43,1,"そ"],[46,1,"つ"],[48,1,"かえ"]],"text":"彼はわたしに「人の子よ、あなたはこれを見るか」と言った。それから、彼はわたしを川の岸に沿って連れ帰った。"},{"ref":"Ezek.47.7","start":26047007,"end":26047007,"break":"none","ruby":[[4,1,"かえ"],[11,1,"み"],[14,1,"かわ"],[16,1,"きし"],[30,1,"おお"],[33,1,"き"]],"text":"わたしが帰ってくると、見よ、川の岸のこなたかなたに、はなはだ多くの木があった。"},{"ref":"Ezek.47.8","start":26047008,"end":26047008,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[13,1,"みず"],[15,1,"ひがし"],[17,1,"さかい"],[19,1,"なが"],[22,1,"い"],[29,1,"お"],[31,1,"くだ"],[36,1,"みず"],[43,1,"うみ"],[53,1,"きよ"]],"text":"彼はわたしに言った、「この水は東の境に流れて行き、アラバに落ち下り、その水が、よどんだ海にはいると、それは清くなる。"},{"ref":"Ezek.47.9","start":26047009,"end":26047009,"break":"none","ruby":[[6,1,"かわ"],[8,1,"なが"],[11,1,"ところ"],[20,1,"うご"],[22,1,"い"],[24,1,"もの"],[26,1,"みな"],[27,1,"い"],[37,1,"おお"],[40,1,"うお"],[50,1,"みず"],[57,1,"うみ"],[59,1,"みず"],[61,1,"きよ"],[73,1,"かわ"],[75,1,"なが"],[78,1,"ところ"],[89,1,"い"]],"text":"おおよそこの川の流れる所では、もろもろの動く生き物が皆生き、また、はなはだ多くの魚がいる。これはその水がはいると、海の水を清くするためである。この川の流れる所では、すべてのものが生きている。"},{"ref":"Ezek.47.10","start":26047010,"end":26047010,"break":"none","ruby":[[4,1,"もの"],[7,1,"うみ"],[14,1,"た"],[34,1,"あみ"],[36,1,"は"],[38,1,"ところ"],[45,1,"うお"],[48,2,"たいかい"],[51,1,"うお"],[59,2,"しゅるい"],[66,1,"おお"]],"text":"すなどる者が、海のかたわらに立ち、エンゲデからエン・エグライムまで、網を張る所となる。その魚は、大海の魚のように、その種類がはなはだ多い。"},{"ref":"Ezek.47.11","start":26047011,"end":26047011,"break":"none","ruby":[[6,1,"さわ"],[8,1,"ぬま"],[11,1,"きよ"],[19,1,"しお"],[20,1,"ち"],[25,1,"のこ"]],"text":"ただし、その沢と沼とは清められないで、塩地のままで残る。"},{"ref":"Ezek.47.12","start":26047012,"end":26047012,"break":"none","ruby":[[0,1,"かわ"],[9,1,"きし"],[19,2,"しょくもつ"],[24,2,"かくしゅ"],[27,1,"き"],[29,1,"そだ"],[34,1,"は"],[36,1,"か"],[42,1,"み"],[44,1,"た"],[48,1,"つき"],[52,1,"あたら"],[55,1,"み"],[65,1,"みず"],[67,2,"せいじょ"],[71,1,"なが"],[73,1,"で"],[83,1,"み"],[85,2,"しょくよう"],[88,1,"きょう"],[95,1,"は"],[97,1,"くすり"]],"text":"川のかたわら、その岸のこなたかなたに、食物となる各種の木が育つ。その葉は枯れず、その実は絶えず、月ごとに新しい実がなる。これはその水が聖所から流れ出るからである。その実は食用に供せられ、その葉は薬となる」。"},{"ref":"Ezek.47.13","start":26047013,"end":26047013,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[8,1,"い"],[29,2,"ぶぞく"],[33,1,"し"],[34,1,"ぎょう"],[38,2,"とち"],[41,1,"わ"],[43,1,"あた"],[51,1,"さかい"],[53,1,"つぎ"],[58,1,"さだ"],[77,1,"ぶん"],[79,1,"あた"]],"text":"主なる神は、こう言われる、「あなたがたがイスラエルの十二の部族に、嗣業として土地を分け与えるには、その境を次のように定めなければならない。ヨセフには二つの分を与えよ。"},{"ref":"Ezek.47.14","start":26047014,"end":26047014,"break":"none","ruby":[[10,2,"こうへい"],[13,1,"わ"],[31,2,"せんぞ"],[34,1,"あた"],[38,1,"ちか"],[48,1,"し"],[49,1,"ぎょう"],[60,1,"ぞく"]],"text":"あなたがたは、これを公平に分けよ。これはわたしが、あなたがたの先祖に与えると誓ったもので、これは嗣業として、あなたがたに属するものである。"},{"ref":"Ezek.47.15","start":26047015,"end":26047015,"break":"paragraph","ruby":[[2,1,"ち"],[4,1,"さかい"],[15,1,"きた"],[17,2,"たいかい"],[26,1,"みち"],[28,1,"へ"],[35,2,"いりぐち"],[44,1,"いた"]],"text":"その地の境はこのとおりである。北は大海からヘテロンの道を経て、ハマテの入口およびゼダデに至り、"},{"ref":"Ezek.47.16","start":26047016,"end":26047016,"break":"none","ruby":[[17,1,"さかい"],[27,1,"いた"],[35,1,"さかい"],[48,1,"およ"]],"text":"またベロテおよびダマスコとハマテの境にあるシブライムに至り、ハウランの境にあるハザル・ハテコンに及ぶ。"},{"ref":"Ezek.47.17","start":26047017,"end":26047017,"break":"none","ruby":[[2,1,"さかい"],[4,1,"うみ"],[12,1,"きた"],[14,1,"さかい"],[30,1,"きた"],[32,1,"ほう"],[40,1,"さかい"],[48,1,"きた"],[50,1,"ほう"]],"text":"その境は海からダマスコの北の境にあるハザル・エノンにおよび、北の方はハマテがその境である。これが北の方である。"},{"ref":"Ezek.47.18","start":26047018,"end":26047018,"break":"paragraph","ruby":[[0,1,"ひがし"],[2,1,"ほう"],[15,1,"あいだ"],[38,1,"ち"],[41,1,"あいだ"],[49,1,"そ"],[52,1,"ひがし"],[54,1,"うみ"],[56,1,"いた"],[63,1,"およ"],[69,1,"ひがし"],[71,1,"ほう"]],"text":"東の方は、ハウランとダマスコの間のハザル・エノンから、ギレアデとイスラエルの地との間の、ヨルダンに沿い、東の海に至り、タマルに及ぶ。これが東の方である。"},{"ref":"Ezek.47.19","start":26047019,"end":26047019,"break":"paragraph","ruby":[[0,1,"みなみ"],[2,1,"ほう"],[18,1,"かわ"],[20,1,"およ"],[32,1,"かわ"],[34,1,"そ"],[37,2,"たいかい"],[40,1,"いた"],[46,1,"みなみ"],[48,1,"ほう"]],"text":"南の方はタマルからメリボテ・カデシの川に及び、そこからエジプトの川に沿って大海に至る。これが南の方である。"},{"ref":"Ezek.47.20","start":26047020,"end":26047020,"break":"paragraph","ruby":[[0,1,"にし"],[2,1,"ほう"],[8,2,"いりぐち"],[11,1,"いた"],[13,2,"たいかい"],[16,1,"さかい"],[24,1,"にし"],[26,1,"ほう"]],"text":"西の方はハマテの入口に至る大海を境とする。これが西の方である。"},{"ref":"Ezek.47.21","start":26047021,"end":26047021,"break":"paragraph","ruby":[[18,2,"ぶぞく"],[21,1,"したが"],[27,1,"ち"],[35,1,"あいだ"],[37,2,"ぶんかつ"]],"text":"あなたがたはこのように、イスラエルの部族に従って、この地をあなたがたの間に分割せよ。"},{"ref":"Ezek.47.22","start":26047022,"end":26047022,"break":"none","ruby":[[26,1,"わ"],[53,1,"こ"],[55,1,"う"],[58,2,"きりゅう"],[61,2,"たこく"],[63,1,"じん"],[68,1,"わ"],[72,1,"し"],[73,1,"ぎょう"],[78,1,"かれ"],[96,2,"ひとびと"],[102,2,"ほんごく"],[104,1,"じん"],[106,2,"どうよう"],[112,1,"かれ"],[121,2,"いっしょ"],[127,1,"ひ"],[137,2,"ぶぞく"],[143,1,"し"],[144,1,"ぎょう"],[146,1,"え"]],"text":"あなたがたは、くじをもって、これをあなたがたのうちに分け、またあなたがたのうちにいて、あなたがたのうちに、子を生んだ寄留の他国人のうちに分けて、嗣業とせよ。彼らは、あなたがたには、イスラエルの人々のうちの本国人と同様である。彼らもあなたがたと一緒にくじを引いて、イスラエルの部族のうちに嗣業を得るべきである。"},{"ref":"Ezek.47.23","start":26047023,"end":26047023,"break":"none","ruby":[[0,2,"たこく"],[2,1,"じん"],[8,1,"す"],[13,2,"ぶぞく"],[22,1,"し"],[23,1,"ぎょう"],[28,1,"あた"],[40,1,"しゅ"],[43,1,"かみ"],[45,1,"い"]],"text":"他国人には、その住んでいる部族のうちで、その嗣業をこれに与えなければならないと、主なる神は言われる。"}]