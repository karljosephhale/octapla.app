[{"ref":"Ps.64.1","start":19064001,"end":19064001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[15,"line"],[29,"line"]],"ruby":[[0,1,"かみ"],[7,1,"なげ"],[9,1,"うった"],[19,1,"こえ"],[22,1,"き"],[29,1,"てき"],[31,1,"おそ"],[39,1,"いのち"],[42,1,"まも"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"神よ、わたしが嘆き訴えるとき、わたしの声をお聞きください。敵の恐れからわたしの命をお守りください。"},{"ref":"Ps.64.2","start":19064002,"end":19064002,"break":"line","breaks":[[14,"line"],[30,"line"]],"ruby":[[4,1,"かく"],[8,1,"あく"],[10,1,"おこな"],[12,1,"もの"],[25,1,"まぬか"],[30,2,"ふぎ"],[33,1,"おこな"],[35,1,"もの"],[44,1,"まぬか"]],"text":"わたしを隠して、悪を行う者のひそかなはかりごとから免れさせ、不義を行う者のはかりごとから免れさせてください。"},{"ref":"Ps.64.3","start":19064003,"end":19064003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[5,1,"した"],[17,1,"にが"],[19,2,"ことば"],[22,1,"や"],[27,1,"はな"]],"text":"彼らはその舌をつるぎのようにとぎ、苦い言葉を矢のように放ち、"},{"ref":"Ps.64.4","start":19064004,"end":19064004,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かく"],[3,1,"ところ"],[6,1,"つみ"],[9,1,"もの"],[11,1,"い"],[22,1,"かれ"],[24,1,"い"],[26,1,"おそ"]],"text":"隠れた所から罪なき者を射ようとする。にわかに彼を射て恐れることがない。"},{"ref":"Ps.64.5","start":19064005,"end":19064005,"break":"line","breaks":[[14,"line"],[33,"line"]],"ruby":[[0,1,"かれ"],[3,1,"わる"],[5,1,"くわだ"],[8,1,"かた"],[14,1,"とも"],[30,1,"い"],[41,2,"みやぶ"]],"text":"彼らは悪い企てを固くたもち、共にはかり、ひそかにわなをかけて言う、「だれがわれらを見破ることができるか。"},{"ref":"Ps.64.6","start":19064006,"end":19064006,"break":"line","breaks":[[22,"line"],[30,"line"],[48,"line"]],"ruby":[[7,1,"つみ"],[12,1,"だ"],[26,1,"たく"],[36,1,"かんが"],[48,1,"ひと"],[50,1,"うち"],[53,1,"おも"],[56,1,"こころ"],[59,1,"ふか"]],"text":"だれがわれらの罪をたずね出すことができるか。われらは巧みに、はかりごとを考えめぐらしたのだ」と。人の内なる思いと心とは深い。"},{"ref":"Ps.64.7","start":19064007,"end":19064007,"break":"line","breaks":[[18,"line"]],"ruby":[[3,1,"かみ"],[5,1,"や"],[10,1,"かれ"],[13,1,"い"],[18,1,"かれ"],[25,1,"きず"]],"text":"しかし神は矢をもって彼らを射られる。彼らはにわかに傷をうけるであろう。"},{"ref":"Ps.64.8","start":19064008,"end":19064008,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[5,1,"した"],[10,1,"かれ"],[13,1,"ほろ"],[19,1,"かれ"],[22,1,"み"],[24,1,"もの"],[26,1,"みな"],[33,1,"ふ"]],"text":"神は彼らの舌のゆえに彼らを滅ぼされる。彼らを見る者は皆そのこうべを振るであろう。"},{"ref":"Ps.64.9","start":19064009,"end":19064009,"break":"line","breaks":[[23,"line"]],"ruby":[[2,1,"とき"],[7,1,"ひと"],[9,1,"おそ"],[12,1,"かみ"],[18,1,"の"],[20,1,"つた"],[29,1,"こと"],[31,1,"かんが"]],"text":"その時すべての人は恐れ、神のみわざを宣べ伝え、そのなされた事を考えるであろう。"},{"ref":"Ps.64.10","start":19064010,"end":19064010,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"しゅ"],[10,1,"よろこ"],[15,1,"しゅ"],[17,1,"よ"],[19,1,"たの"],[25,1,"こころ"],[27,1,"なお"],[29,1,"もの"],[31,1,"ほこ"]],"text":"正しい人は主にあって喜び、かつ主に寄り頼む。すべて心の直き者は誇ることができる。"}]