[{"ref":"Rev.12.18","start":66013001,"end":66013001,"break":"none","ruby":[[4,1,"うみ"],[6,1,"すな"],[8,1,"うえ"],[10,1,"た"]],"text":"そして、海の砂の上に立った。"},{"ref":"Rev.13.1","start":66013001,"end":66013001,"break":"paragraph","ruby":[[8,1,"ぴき"],[10,1,"けもの"],[12,1,"うみ"],[15,1,"のぼ"],[18,1,"く"],[22,1,"み"],[29,1,"つの"],[32,1,"ぽん"],[34,1,"あたま"],[45,1,"つの"],[50,1,"かんむり"],[56,1,"あたま"],[59,1,"かみ"],[61,1,"けが"],[63,1,"な"]],"text":"わたしはまた、一匹の獣が海から上って来るのを見た。それには角が十本、頭が七つあり、それらの角には十の冠があって、頭には神を汚す名がついていた。"},{"ref":"Rev.13.2","start":66013002,"end":66013002,"break":"none","ruby":[[4,1,"み"],[8,1,"けもの"],[14,1,"に"],[21,1,"あし"],[26,1,"あし"],[34,1,"くち"],[39,1,"くち"],[48,1,"りゅう"],[50,2,"じぶん"],[53,1,"ちから"],[55,1,"くらい"],[57,1,"おお"],[61,2,"けんい"],[68,1,"けもの"],[70,1,"あた"]],"text":"わたしの見たこの獣はひょうに似ており、その足はくまの足のようで、その口はししの口のようであった。龍は自分の力と位と大いなる権威とを、この獣に与えた。"},{"ref":"Rev.13.3","start":66013003,"end":66013003,"break":"none","ruby":[[2,1,"あたま"],[8,1,"し"],[13,1,"きず"],[15,1,"う"],[22,2,"ちめい"],[24,1,"てき"],[26,1,"きず"],[41,1,"ぜん"],[42,1,"ち"],[44,2,"ひとびと"],[47,1,"おどろ"],[56,1,"けもの"],[58,1,"したが"]],"text":"その頭の一つが、死ぬほどの傷を受けたが、その致命的な傷もなおってしまった。そこで、全地の人々は驚きおそれて、その獣に従い、"},{"ref":"Rev.13.4","start":66013004,"end":66013004,"break":"none","ruby":[[3,1,"りゅう"],[7,2,"けんい"],[10,1,"けもの"],[12,1,"あた"],[18,2,"ひとびと"],[21,1,"りゅう"],[23,1,"おが"],[32,1,"けもの"],[34,1,"おが"],[37,1,"い"],[48,1,"けもの"],[50,2,"ひってき"],[53,1,"え"],[65,1,"たたか"]],"text":"また、龍がその権威を獣に与えたので、人々は龍を拝み、さらに、その獣を拝んで言った、「だれが、この獣に匹敵し得ようか。だれが、これと戦うことができようか」。"},{"ref":"Rev.13.5","start":66013005,"end":66013005,"break":"none","ruby":[[2,1,"けもの"],[9,2,"たいげん"],[12,1,"は"],[14,1,"けが"],[19,1,"かた"],[21,1,"くち"],[23,1,"あた"],[32,1,"げつ"],[37,2,"かつどう"],[41,2,"けんい"],[44,1,"あた"]],"text":"この獣には、また、大言を吐き汚しごとを語る口が与えられ、四十二か月のあいだ活動する権威が与えられた。"},{"ref":"Rev.13.6","start":66013006,"end":66013006,"break":"none","ruby":[[4,1,"かれ"],[6,1,"くち"],[8,1,"ひら"],[11,1,"かみ"],[13,1,"けが"],[16,1,"かみ"],[18,2,"みな"],[24,2,"まくや"],[32,1,"てん"],[34,1,"す"],[36,1,"もの"],[41,1,"けが"]],"text":"そこで、彼は口を開いて神を汚し、神の御名と、その幕屋、すなわち、天に住む者たちとを汚した。"},{"ref":"Rev.13.7","start":66013007,"end":66013007,"break":"none","ruby":[[3,1,"かれ"],[6,2,"せいと"],[9,1,"たたか"],[19,1,"か"],[24,1,"ゆる"],[36,2,"ぶぞく"],[39,2,"みんぞく"],[42,2,"こくご"],[45,2,"こくみん"],[48,2,"しはい"],[52,2,"けんい"],[55,1,"あた"]],"text":"そして彼は、聖徒に戦いをいどんでこれに勝つことを許され、さらに、すべての部族、民族、国語、国民を支配する権威を与えられた。"},{"ref":"Rev.13.8","start":66013008,"end":66013008,"break":"none","ruby":[[0,1,"ち"],[2,1,"す"],[4,1,"もの"],[12,2,"こひつじ"],[19,1,"しょ"],[24,1,"な"],[26,1,"よ"],[28,1,"はじ"],[40,1,"もの"],[47,1,"けもの"],[49,1,"おが"]],"text":"地に住む者で、ほふられた小羊のいのちの書に、その名を世の初めからしるされていない者はみな、この獣を拝むであろう。"},{"ref":"Rev.13.9","start":66013009,"end":66013009,"break":"none","ruby":[[0,1,"みみ"],[4,1,"もの"],[7,1,"き"]],"text":"耳のある者は、聞くがよい。"},{"ref":"Rev.13.10","start":66013010,"end":66013010,"break":"none","ruby":[[8,1,"もの"],[25,1,"ころ"],[27,1,"もの"],[30,1,"みずか"],[37,1,"ころ"],[51,2,"せいと"],[56,2,"にんたい"],[59,2,"しんこう"]],"text":"とりこになるべき者は、とりこになっていく。つるぎで殺す者は、自らもつるぎで殺されねばならない。ここに、聖徒たちの忍耐と信仰とがある。"},{"ref":"Rev.13.11","start":66013011,"end":66013011,"break":"paragraph","ruby":[[10,1,"けもの"],[12,1,"ち"],[15,1,"のぼ"],[18,1,"く"],[22,1,"み"],[29,2,"こひつじ"],[35,1,"つの"],[43,1,"りゅう"],[48,1,"もの"],[50,1,"い"]],"text":"わたしはまた、ほかの獣が地から上って来るのを見た。それには小羊のような角が二つあって、龍のように物を言った。"},{"ref":"Rev.13.12","start":66013012,"end":66013012,"break":"none","ruby":[[4,1,"さき"],[6,1,"けもの"],[8,1,"も"],[14,2,"けんりょく"],[19,1,"まえ"],[21,1,"はたら"],[29,1,"ち"],[31,1,"ち"],[33,1,"す"],[35,2,"ひとびと"],[39,2,"ちめい"],[41,1,"てき"],[43,1,"きず"],[50,1,"さき"],[52,1,"けもの"],[54,1,"おが"]],"text":"そして、先の獣の持つすべての権力をその前で働かせた。また、地と地に住む人々に、致命的な傷がいやされた先の獣を拝ませた。"},{"ref":"Rev.13.13","start":66013013,"end":66013013,"break":"none","ruby":[[3,1,"おお"],[11,1,"おこな"],[15,2,"ひとびと"],[18,1,"まえ"],[20,1,"ひ"],[22,1,"てん"],[25,1,"ち"],[27,1,"ふ"]],"text":"また、大いなるしるしを行って、人々の前で火を天から地に降らせることさえした。"},{"ref":"Rev.13.14","start":66013014,"end":66013014,"break":"none","ruby":[[4,1,"さき"],[6,1,"けもの"],[8,1,"まえ"],[10,1,"おこな"],[14,1,"ゆる"],[23,1,"ち"],[25,1,"す"],[27,2,"ひとびと"],[30,1,"まど"],[41,1,"きず"],[43,1,"う"],[49,1,"い"],[54,1,"さき"],[56,1,"けもの"],[58,1,"ぞう"],[60,1,"つく"],[66,1,"ち"],[68,1,"す"],[70,2,"ひとびと"],[73,1,"めい"]],"text":"さらに、先の獣の前で行うのを許されたしるしで、地に住む人々を惑わし、かつ、つるぎの傷を受けてもなお生きている先の獣の像を造ることを、地に住む人々に命じた。"},{"ref":"Rev.13.15","start":66013015,"end":66013015,"break":"none","ruby":[[7,1,"けもの"],[9,1,"ぞう"],[11,1,"いき"],[13,1,"ふ"],[15,1,"こ"],[21,1,"けもの"],[23,1,"ぞう"],[25,1,"もの"],[27,1,"い"],[46,1,"けもの"],[48,1,"ぞう"],[50,1,"おが"],[54,1,"もの"],[58,1,"ころ"]],"text":"それから、その獣の像に息を吹き込んで、その獣の像が物を言うことさえできるようにし、また、その獣の像を拝まない者をみな殺させた。"},{"ref":"Rev.13.16","start":66013016,"end":66013016,"break":"none","ruby":[[3,1,"ちい"],[6,1,"もの"],[10,1,"おお"],[14,1,"もの"],[18,1,"と"],[21,1,"もの"],[25,1,"まず"],[28,1,"もの"],[32,3,"じゆうじん"],[38,2,"どれい"],[47,2,"ひとびと"],[53,1,"みぎ"],[55,1,"て"],[60,1,"ひたい"],[62,2,"こくいん"],[65,1,"お"]],"text":"また、小さき者にも、大いなる者にも、富める者にも、貧しき者にも、自由人にも、奴隷にも、すべての人々に、その右の手あるいは額に刻印を押させ、"},{"ref":"Rev.13.17","start":66013017,"end":66013017,"break":"none","ruby":[[2,2,"こくいん"],[7,1,"もの"],[12,1,"もの"],[14,1,"か"],[19,1,"う"],[36,2,"こくいん"],[42,1,"けもの"],[44,1,"な"],[52,1,"な"],[54,2,"すうじ"]],"text":"この刻印のない者はみな、物を買うことも売ることもできないようにした。この刻印は、その獣の名、または、その名の数字のことである。"},{"ref":"Rev.13.18","start":66013018,"end":66013018,"break":"none","ruby":[[4,2,"ちえ"],[7,2,"ひつよう"],[13,2,"しりょ"],[18,1,"もの"],[21,1,"けもの"],[23,2,"すうじ"],[26,1,"と"],[34,2,"すうじ"],[39,2,"にんげん"],[56,2,"すうじ"]],"text":"ここに、知恵が必要である。思慮のある者は、獣の数字を解くがよい。その数字とは、人間をさすものである。そして、その数字は六百六十六である。"}]