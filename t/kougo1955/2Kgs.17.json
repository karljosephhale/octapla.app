[{"ref":"2Kgs.17.1","start":12017001,"end":12017001,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"だい"],[11,1,"ねん"],[16,1,"こ"],[21,1,"おう"],[32,1,"ねん"],[34,1,"あいだ"],[42,1,"おさ"]],"text":"ユダの王アハズの第十二年にエラの子ホセアが王となり、サマリヤで九年の間、イスラエルを治めた。"},{"ref":"2Kgs.17.2","start":12017002,"end":12017002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[10,1,"おこな"],[15,1,"かれ"],[16,2,"いぜん"],[25,1,"おう"]],"text":"彼は主の目の前に悪を行ったが、彼以前のイスラエルの王たちのようではなかった。"},{"ref":"2Kgs.17.3","start":12017003,"end":12017003,"break":"none","ruby":[[6,1,"おう"],[15,1,"せ"],[17,1,"のぼ"],[27,1,"かれ"],[29,2,"れいぞく"],[38,1,"おさ"]],"text":"アッスリヤの王シャルマネセルが攻め上ったので、ホセアは彼に隷属して、みつぎを納めたが、"},{"ref":"2Kgs.17.4","start":12017004,"end":12017004,"break":"none","ruby":[[6,1,"おう"],[15,2,"じぶん"],[24,1,"し"],[35,2,"ししゃ"],[43,1,"おう"],[53,2,"ねんねん"],[55,1,"おさ"],[71,1,"おう"],[73,1,"おさ"],[94,1,"おう"],[96,1,"かれ"],[98,2,"かんきん"],[102,2,"ごくや"]],"text":"アッスリヤの王はホセアがついに自分にそむいたのを知った。それはホセアが使者をエジプトの王ソにつかわし、また年々納めていたみつぎを、アッスリヤの王に納めなかったからである。そこでアッスリヤの王は彼を監禁し、獄屋につないだ。"},{"ref":"2Kgs.17.5","start":12017005,"end":12017005,"break":"none","ruby":[[9,1,"おう"],[11,1,"せ"],[13,1,"のぼ"],[16,2,"くにぢゅう"],[19,1,"おか"],[27,1,"のぼ"],[33,1,"ねん"],[35,1,"あいだ"],[40,1,"せ"],[42,1,"かこ"]],"text":"そしてアッスリヤの王は攻め上って国中を侵し、サマリヤに上ってきて三年の間、これを攻め囲んだ。"},{"ref":"2Kgs.17.6","start":12017006,"end":12017006,"break":"none","ruby":[[4,1,"だい"],[6,1,"ねん"],[18,1,"おう"],[28,1,"と"],[37,2,"ひとびと"],[46,1,"とら"],[61,1,"かわ"],[75,2,"まちまち"]],"text":"ホセアの第九年になって、アッスリヤの王はついにサマリヤを取り、イスラエルの人々をアッスリヤに捕えていって、ハラと、ゴザンの川ハボルのほとりと、メデアの町々においた。"},{"ref":"2Kgs.17.7","start":12017007,"end":12017007,"break":"paragraph","ruby":[[2,1,"こと"],[4,1,"た"],[16,2,"ひとびと"],[20,2,"じぶん"],[30,1,"ち"],[33,1,"みちび"],[35,1,"のぼ"],[44,1,"おう"],[48,1,"て"],[60,1,"かみ"],[62,1,"しゅ"],[68,1,"つみ"],[70,1,"おか"],[73,1,"た"],[75,2,"かみがみ"],[78,1,"うやま"]],"text":"この事が起ったのは、イスラエルの人々が、自分たちをエジプトの地から導き上って、エジプトの王パロの手をのがれさせられたその神、主にむかって罪を犯し、他の神々を敬い、"},{"ref":"2Kgs.17.8","start":12017008,"end":12017008,"break":"none","ruby":[[0,1,"しゅ"],[8,2,"ひとびと"],[11,1,"まえ"],[14,1,"お"],[16,1,"はら"],[20,3,"いほうじん"],[29,1,"したが"],[32,1,"あゆ"],[43,1,"おう"],[47,1,"さだ"],[55,1,"したが"],[58,1,"あゆ"]],"text":"主がイスラエルの人々の前から追い払われた異邦人のならわしに従って歩み、またイスラエルの王たちが定めたならわしに従って歩んだからである。"},{"ref":"2Kgs.17.9","start":12017009,"end":12017009,"break":"none","ruby":[[6,2,"ひとびと"],[11,1,"かみ"],[13,1,"しゅ"],[19,1,"ただしか"],[22,1,"こと"],[28,1,"おこな"],[31,2,"みはり"],[33,1,"だい"],[36,2,"けんご"],[39,1,"まち"],[41,1,"いた"],[50,2,"まちまち"],[53,1,"たか"],[55,1,"ところ"],[57,1,"た"]],"text":"イスラエルの人々はその神、主にむかって正らぬ事をひそかに行い、見張台から堅固な町に至るまで、すべての町々に高き所を建て、"},{"ref":"2Kgs.17.10","start":12017010,"end":12017010,"break":"none","ruby":[[6,1,"たか"],[8,1,"おか"],[10,1,"うえ"],[16,1,"あお"],[17,1,"き"],[19,1,"した"],[21,1,"いし"],[23,1,"はしら"],[28,1,"ぞう"],[30,1,"た"]],"text":"またすべての高い丘の上、すべての青木の下に石の柱とアシラ像を立て、"},{"ref":"2Kgs.17.11","start":12017011,"end":12017011,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"まえ"],[8,1,"とら"],[10,1,"うつ"],[14,3,"いほうじん"],[28,1,"たか"],[30,1,"ところ"],[32,1,"こう"],[37,2,"あくじ"],[40,1,"い"],[44,1,"しゅ"],[46,1,"いか"]],"text":"主が彼らの前から捕え移された異邦人がしたように、すべての高き所で香をたき、悪事を行って、主を怒らせた。"},{"ref":"2Kgs.17.12","start":12017012,"end":12017012,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"かれ"],[16,1,"こと"],[27,1,"い"],[33,2,"ぐうぞう"],[36,1,"つか"]],"text":"また主が彼らに「あなたがたはこの事をしてはならない」と言われたのに偶像に仕えた。"},{"ref":"2Kgs.17.13","start":12017013,"end":12017013,"break":"none","ruby":[[0,1,"しゅ"],[6,3,"よげんしゃ"],[14,3,"せんけんしゃ"],[30,1,"いまし"],[34,1,"ひるがえ"],[44,1,"わる"],[46,1,"みち"],[48,1,"はな"],[61,2,"せんぞ"],[66,1,"めい"],[81,3,"よげんしゃ"],[96,1,"つた"],[103,2,"りっぽう"],[115,1,"いまし"],[118,1,"さだ"],[122,1,"まも"],[126,1,"おお"]],"text":"主はすべての預言者、すべての先見者によってイスラエルとユダを戒め、「翻って、あなたがたの悪い道を離れ、わたしがあなたがたの先祖たちに命じ、またわたしのしもべである預言者たちによってあなたがたに伝えたすべての律法のとおりに、わたしの戒めと定めとを守れ」と仰せられたが、"},{"ref":"2Kgs.17.14","start":12017014,"end":12017014,"break":"none","ruby":[[0,1,"かれ"],[3,1,"き"],[9,1,"かれ"],[12,2,"せんぞ"],[19,1,"かみ"],[21,1,"しゅ"],[23,1,"しん"],[29,2,"ごうじょう"],[39,1,"かれ"],[42,2,"ごうじょう"]],"text":"彼らは聞きいれず、彼らの先祖たちがその神、主を信じないで、強情であったように、彼らは強情であった。"},{"ref":"2Kgs.17.15","start":12017015,"end":12017015,"break":"none","ruby":[[3,1,"かれ"],[6,1,"しゅ"],[8,1,"さだ"],[11,1,"す"],[14,1,"しゅ"],[16,1,"かれ"],[19,2,"せんぞ"],[24,1,"むす"],[28,2,"けいやく"],[31,1,"やぶ"],[36,1,"かれ"],[39,1,"あた"],[44,2,"けいこく"],[47,1,"かる"],[57,2,"ぐうぞう"],[60,1,"したが"],[72,2,"しゅうい"],[75,3,"いほうじん"],[79,1,"したが"],[86,1,"しゅ"],[89,1,"かれ"],[106,1,"かれ"],[109,1,"めい"]],"text":"そして彼らは主の定めを捨て、主が彼らの先祖たちと結ばれた契約を破り、また彼らに与えられた警告を軽んじ、かつむなしい偶像に従ってむなしくなり、また周囲の異邦人に従った。これは主が、彼らのようにおこなってはならないと彼らに命じられたものである。"},{"ref":"2Kgs.17.16","start":12017016,"end":12017016,"break":"none","ruby":[[0,1,"かれ"],[5,1,"かみ"],[7,1,"しゅ"],[13,1,"いまし"],[16,1,"す"],[19,2,"じぶん"],[28,1,"こ"],[29,1,"うし"],[31,1,"ぞう"],[33,1,"い"],[35,1,"つく"],[43,1,"ぞう"],[45,1,"つく"],[48,1,"てん"],[50,2,"ばんしょう"],[53,1,"おが"],[62,1,"つか"]],"text":"彼らはその神、主のすべての戒めを捨て、自分のために二つの子牛の像を鋳て造り、またアシラ像を造り、天の万象を拝み、かつバアルに仕え、"},{"ref":"2Kgs.17.17","start":12017017,"end":12017017,"break":"none","ruby":[[8,1,"むすめ"],[10,1,"ひ"],[12,1,"や"],[18,1,"もの"],[22,1,"うらな"],[35,1,"しゅ"],[37,1,"め"],[39,1,"まえ"],[41,1,"あく"],[50,1,"み"],[57,1,"しゅ"],[59,1,"いか"]],"text":"またそのむすこ、娘を火に焼いてささげ物とし、占いおよびまじないをなし、主の目の前に悪をおこなうことに身をゆだねて、主を怒らせた。"},{"ref":"2Kgs.17.18","start":12017018,"end":12017018,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"おお"],[16,1,"いか"],[19,1,"かれ"],[23,1,"まえ"],[26,1,"のぞ"],[36,2,"ぶぞく"],[41,1,"のこ"],[44,1,"もの"]],"text":"それゆえ、主は大いにイスラエルを怒り、彼らをみ前から除かれたので、ユダの部族のほか残った者はなかった。"},{"ref":"2Kgs.17.19","start":12017019,"end":12017019,"break":"paragraph","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[15,1,"いまし"],[18,1,"まも"],[28,1,"さだ"],[36,1,"あゆ"]],"text":"ところがユダもまたその神、主の戒めを守らず、イスラエルが定めたならわしに歩んだので、"},{"ref":"2Kgs.17.20","start":12017020,"end":12017020,"break":"none","ruby":[[0,1,"しゅ"],[8,2,"しそん"],[16,1,"す"],[19,1,"かれ"],[22,1,"くる"],[26,1,"かれ"],[29,3,"りゃくだつしゃ"],[33,1,"て"],[43,1,"かれ"],[47,1,"まえ"],[50,1,"う"]],"text":"主はイスラエルの子孫をことごとく捨て、彼らを苦しめ、彼らを略奪者の手にわたして、ついに彼らをみ前から打ちすてられた。"},{"ref":"2Kgs.17.21","start":12017021,"end":12017021,"break":"paragraph","ruby":[[0,1,"しゅ"],[12,1,"いえ"],[15,1,"さ"],[17,1,"はな"],[34,1,"こ"],[41,1,"おう"],[60,1,"しゅ"],[62,1,"したが"],[72,1,"おお"],[75,1,"つみ"],[77,1,"おか"]],"text":"主はイスラエルをダビデの家から裂き離されたので、イスラエルはネバテの子ヤラベアムを王としたが、ヤラベアムはイスラエルに、主に従うことをやめさせ、大きな罪を犯させた。"},{"ref":"2Kgs.17.22","start":12017022,"end":12017022,"break":"none","ruby":[[6,2,"ひとびと"],[24,1,"つみ"],[30,1,"つづ"],[37,1,"はな"]],"text":"イスラエルの人々がヤラベアムのおこなったすべての罪をおこない続けて、それを離れなかったので、"},{"ref":"2Kgs.17.23","start":12017023,"end":12017023,"break":"none","ruby":[[3,1,"しゅ"],[13,3,"よげんしゃ"],[22,1,"い"],[37,1,"まえ"],[40,1,"のぞ"],[42,1,"さ"],[57,2,"じぶん"],[60,1,"くに"],[69,1,"うつ"],[73,2,"こんにち"],[76,1,"いた"]],"text":"ついに主はそのしもべである預言者たちによって言われたように、イスラエルをみ前から除き去られた。こうしてイスラエルは自分の国からアッスリヤに移されて今日に至っている。"},{"ref":"2Kgs.17.24","start":12017024,"end":12017024,"break":"paragraph","ruby":[[9,1,"おう"],[36,2,"ひとびと"],[54,2,"ひとびと"],[57,1,"かわ"],[65,2,"まちまち"],[77,2,"ひとびと"],[85,2,"りょうゆう"],[92,2,"まちまち"],[95,1,"す"]],"text":"かくてアッスリヤの王はバビロン、クタ、アワ、ハマテおよびセパルワイムから人々をつれてきて、これをイスラエルの人々の代りにサマリヤの町々におらせたので、その人々はサマリヤを領有して、その町々に住んだ。"},{"ref":"2Kgs.17.25","start":12017025,"end":12017025,"break":"none","ruby":[[0,1,"かれ"],[6,1,"す"],[8,1,"はじ"],[11,1,"とき"],[13,1,"しゅ"],[15,1,"うやま"],[28,1,"しゅ"],[30,1,"かれ"],[39,1,"おく"],[45,1,"かれ"],[51,2,"すうにん"],[54,1,"ころ"]],"text":"彼らがそこに住み始めた時、主を敬うことをしなかったので、主は彼らのうちにししを送り、ししは彼らのうちの数人を殺した。"},{"ref":"2Kgs.17.26","start":12017026,"end":12017026,"break":"none","ruby":[[3,2,"ひとびと"],[12,1,"おう"],[14,1,"つ"],[17,1,"い"],[26,1,"うつ"],[34,2,"まちまち"],[45,2,"くにぐに"],[48,1,"たみ"],[53,1,"ち"],[55,1,"かみ"],[61,1,"し"],[71,1,"かみ"],[73,1,"かれ"],[82,1,"おく"],[88,1,"かれ"],[91,1,"ころ"],[98,1,"かれ"],[104,1,"ち"],[106,1,"かみ"],[112,1,"し"]],"text":"そこで人々はアッスリヤの王に告げて言った、「あなたが移してサマリヤの町々におらせられたあの国々の民は、その地の神のおきてを知らないゆえに、その神は彼らのうちにししを送り、ししは彼らを殺した。これは彼らが、その地の神のおきてを知らないためです」。"},{"ref":"2Kgs.17.27","start":12017027,"end":12017027,"break":"none","ruby":[[6,1,"おう"],[8,1,"めい"],[11,1,"い"],[27,1,"うつ"],[30,2,"さいし"],[41,1,"つ"],[44,1,"い"],[50,1,"かれ"],[59,1,"す"],[66,1,"くに"],[68,1,"かみ"],[76,2,"ひとびと"],[79,1,"おし"]],"text":"アッスリヤの王は命じて言った、「あなたがたがあそこから移した祭司のひとりをあそこへ連れて行きなさい。彼をあそこへやって住まわせ、その国の神のおきてをその人々に教えさせなさい」。"},{"ref":"2Kgs.17.28","start":12017028,"end":12017028,"break":"paragraph","ruby":[[9,1,"うつ"],[13,2,"さいし"],[20,1,"き"],[26,1,"す"],[34,1,"しゅ"],[36,1,"うやま"],[42,1,"かれ"],[45,1,"おし"]],"text":"そこでサマリヤから移された祭司のひとりが来てベテルに住み、どのように主を敬うべきかを彼らに教えた。"},{"ref":"2Kgs.17.29","start":12017029,"end":12017029,"break":"none","ruby":[[5,1,"たみ"],[11,2,"じぶん"],[14,2,"かみがみ"],[17,1,"つく"],[31,1,"つく"],[34,1,"たか"],[36,1,"ところ"],[38,1,"いえ"],[40,2,"あんち"],[45,1,"たみ"],[47,1,"みな"],[48,1,"す"],[53,2,"まちまち"]],"text":"しかしその民はおのおの自分の神々を造って、それをサマリヤびとが造った高き所の家に安置した。民は皆住んでいる町々でそのようにおこなった。"},{"ref":"2Kgs.17.30","start":12017030,"end":12017030,"break":"none","ruby":[[9,2,"ひとびと"],[20,1,"つく"],[26,2,"ひとびと"],[34,1,"つく"],[41,2,"ひとびと"],[48,1,"つく"]],"text":"すなわちバビロンの人々はスコテ・ベノテを造り、クタの人々はネルガルを造り、ハマテの人々はアシマを造り、"},{"ref":"2Kgs.17.31","start":12017031,"end":12017031,"break":"none","ruby":[[3,2,"ひとびと"],[16,1,"つく"],[30,1,"こ"],[32,1,"ひ"],[34,1,"や"],[45,1,"かみ"]],"text":"アワの人々はニブハズとタルタクを造り、セパルワイムびとはその子を火に焼いて、セパルワイムの神アデランメレクおよびアナンメレクにささげた。"},{"ref":"2Kgs.17.32","start":12017032,"end":12017032,"break":"none","ruby":[[0,1,"かれ"],[4,1,"しゅ"],[6,1,"うやま"],[9,2,"じぶん"],[18,2,"いっぱん"],[21,1,"たみ"],[23,1,"た"],[26,1,"たか"],[28,1,"ところ"],[30,2,"さいし"],[40,2,"ひとびと"],[43,1,"たか"],[45,1,"ところ"],[47,1,"いえ"],[49,1,"つと"]],"text":"彼はまた主を敬い、自分たちのうちから一般の民を立てて高き所の祭司としたので、その人々は高き所の家で勤めをした。"},{"ref":"2Kgs.17.33","start":12017033,"end":12017033,"break":"none","ruby":[[5,1,"かれ"],[8,1,"しゅ"],[10,1,"うやま"],[17,1,"かれ"],[20,1,"で"],[24,2,"くにぐに"],[38,2,"じぶん"],[43,2,"かみがみ"],[47,1,"つか"]],"text":"このように彼らは主を敬ったが、また彼らが出てきた国々のならわしにしたがって、自分たちの神々にも仕えた。"},{"ref":"2Kgs.17.34","start":12017034,"end":12017034,"break":"none","breaks":[[30,"paragraph"]],"ruby":[[0,2,"こんにち"],[3,1,"いた"],[7,1,"かれ"],[10,1,"さき"],[30,1,"かれ"],[33,1,"しゅ"],[35,1,"うやま"],[41,1,"しゅ"],[49,1,"な"],[59,2,"しそん"],[62,1,"めい"],[67,1,"さだ"],[78,2,"りっぽう"],[83,1,"いまし"],[87,1,"したが"]],"text":"今日に至るまで彼らは先のならわしにしたがっておこなっている。彼らは主を敬わず、また主がイスラエルと名づけられたヤコブの子孫に命じられた定めにも、おきてにも、律法にも、戒めにも従わない。"},{"ref":"2Kgs.17.35","start":12017035,"end":12017035,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"かれ"],[8,2,"けいやく"],[11,1,"むす"],[14,1,"かれ"],[17,1,"めい"],[20,1,"い"],[32,1,"た"],[34,2,"かみがみ"],[37,1,"うやま"],[48,1,"かれ"],[51,1,"おが"],[54,1,"かれ"],[57,1,"つか"],[60,1,"かれ"],[63,2,"ぎせい"]],"text":"主はかつて彼らと契約を結び、彼らに命じて言われた、「あなたがたは他の神々を敬ってはならない。また彼らを拝み、彼らに仕え、彼らに犠牲をささげてはならない。"},{"ref":"2Kgs.17.36","start":12017036,"end":12017036,"break":"none","ruby":[[2,1,"おお"],[5,1,"ちから"],[7,1,"の"],[10,1,"うで"],[28,1,"ち"],[31,1,"みちび"],[33,1,"のぼ"],[36,1,"しゅ"],[40,1,"うやま"],[46,1,"おが"],[52,2,"ぎせい"]],"text":"ただ大きな力と伸べた腕とをもって、あなたがたをエジプトの地から導き上った主をのみ敬い、これを拝み、これに犠牲をささげなければならない。"},{"ref":"2Kgs.17.37","start":12017037,"end":12017037,"break":"none","ruby":[[11,1,"か"],[18,1,"さだ"],[27,2,"りっぽう"],[31,1,"いまし"],[36,1,"つつし"],[39,1,"つね"],[41,1,"まも"],[52,1,"た"],[54,2,"かみがみ"],[57,1,"うやま"]],"text":"またあなたがたのために書きしるされた定めと、おきてと、律法と、戒めとを、慎んで常に守らなければならない。他の神々を敬ってはならない。"},{"ref":"2Kgs.17.38","start":12017038,"end":12017038,"break":"none","ruby":[[10,1,"むす"],[13,2,"けいやく"],[16,1,"わす"],[27,1,"た"],[29,2,"かみがみ"],[32,1,"うやま"]],"text":"わたしがあなたがたと結んだ契約を忘れてはならない。また他の神々を敬ってはならない。"},{"ref":"2Kgs.17.39","start":12017039,"end":12017039,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"うやま"],[23,1,"しゅ"],[37,1,"てき"],[39,1,"て"],[42,1,"すく"],[44,1,"だ"]],"text":"ただあなたがたの神、主を敬わなければならない。主はあなたがたをそのすべての敵の手から救い出されるであろう」。"},{"ref":"2Kgs.17.40","start":12017040,"end":12017040,"break":"none","ruby":[[3,1,"かれ"],[6,1,"き"],[16,1,"さき"]],"text":"しかし彼らは聞きいれず、かえって先のならわしにしたがっておこなった。"},{"ref":"2Kgs.17.41","start":12017041,"end":12017041,"break":"paragraph","ruby":[[10,1,"たみ"],[12,1,"しゅ"],[14,1,"うやま"],[21,1,"きざ"],[24,1,"ぞう"],[27,1,"つか"],[34,1,"こ"],[39,1,"まご"],[43,2,"どうよう"],[50,1,"かれ"],[55,2,"せんぞ"],[66,2,"こんにち"]],"text":"このように、これらの民は主を敬い、またその刻んだ像にも仕えたが、その子たちも、孫たちも同様であって、彼らはその先祖がおこなったように今日までおこなっている。"}]