[{"ref":"Eccl.4.1","start":21004001,"end":21004001,"break":"paragraph","ruby":[[7,1,"ひ"],[9,1,"した"],[11,1,"おこな"],[24,1,"み"],[27,1,"み"],[37,1,"もの"],[39,1,"なみだ"],[42,1,"かれ"],[45,1,"なぐさ"],[48,1,"もの"],[58,1,"もの"],[60,1,"て"],[63,2,"けんりょく"],[72,1,"かれ"],[75,1,"なぐさ"],[78,1,"もの"]],"text":"わたしはまた、日の下に行われるすべてのしえたげを見た。見よ、しえたげられる者の涙を。彼らを慰める者はない。しえたげる者の手には権力がある。しかし彼らを慰める者はいない。"},{"ref":"Eccl.4.2","start":21004002,"end":21004002,"break":"none","ruby":[[10,1,"い"],[15,3,"せいぞんしゃ"],[25,1,"し"],[28,2,"ししゃ"],[37,1,"もの"],[39,1,"おも"]],"text":"それで、わたしはなお生きている生存者よりも、すでに死んだ死者を、さいわいな者と思った。"},{"ref":"Eccl.4.3","start":21004003,"end":21004003,"break":"none","ruby":[[6,2,"りょうしゃ"],[21,1,"うま"],[25,1,"もの"],[28,1,"ひ"],[30,1,"した"],[32,1,"おこな"],[36,1,"あ"],[42,1,"み"],[45,1,"もの"]],"text":"しかし、この両者よりもさいわいなのは、まだ生れない者で、日の下に行われる悪しきわざを見ない者である。"},{"ref":"Eccl.4.4","start":21004004,"end":21004004,"break":"paragraph","ruby":[[11,2,"ろうく"],[19,1,"たく"],[25,1,"み"],[32,1,"ひと"],[34,1,"たがい"],[55,1,"くう"],[61,1,"かぜ"],[63,1,"とら"]],"text":"また、わたしはすべての労苦と、すべての巧みなわざを見たが、これは人が互にねたみあってなすものである。これもまた空であって、風を捕えるようである。"},{"ref":"Eccl.4.5","start":21004005,"end":21004005,"break":"paragraph","ruby":[[0,1,"おろ"],[4,1,"もの"],[6,1,"て"],[13,2,"じぶん"],[16,1,"にく"],[18,1,"く"]],"text":"愚かなる者は手をつかねて、自分の肉を食う。"},{"ref":"Eccl.4.6","start":21004006,"end":21004006,"break":"paragraph","ruby":[[0,2,"かたて"],[3,1,"もの"],[5,1,"み"],[9,2,"へいおん"],[17,2,"りょうて"],[20,1,"もの"],[22,1,"み"],[26,2,"ろうく"],[30,1,"かぜ"],[32,1,"とら"]],"text":"片手に物を満たして平穏であるのは、両手に物を満たして労苦し、風を捕えるのにまさる。"},{"ref":"Eccl.4.7","start":21004007,"end":21004007,"break":"paragraph","ruby":[[7,1,"ひ"],[9,1,"した"],[11,1,"くう"],[14,1,"こと"],[20,1,"み"]],"text":"わたしはまた、日の下に空なる事のあるのを見た。"},{"ref":"Eccl.4.8","start":21004008,"end":21004008,"break":"none","ruby":[[3,1,"ひと"],[16,1,"なか"],[17,1,"ま"],[22,1,"こ"],[27,2,"きょうだい"],[37,1,"かれ"],[39,2,"ろうく"],[42,1,"きわ"],[50,1,"め"],[52,1,"とみ"],[54,1,"あ"],[64,1,"かれ"],[66,1,"い"],[82,1,"ろう"],[92,2,"じぶん"],[95,1,"たの"],[111,1,"くう"],[117,1,"くる"]],"text":"ここに人がある。ひとりであって、仲間もなく、子もなく、兄弟もない。それでも彼の労苦は窮まりなく、その目は富に飽くことがない。また彼は言わない、「わたしはだれのために労するのか、どうして自分を楽しませないのか」と。これもまた空であって、苦しいわざである。"},{"ref":"Eccl.4.9","start":21004009,"end":21004009,"break":"paragraph","ruby":[[12,1,"かれ"],[17,2,"ろうく"],[23,1,"よ"],[25,1,"むく"],[28,1,"え"]],"text":"ふたりはひとりにまさる。彼らはその労苦によって良い報いを得るからである。"},{"ref":"Eccl.4.10","start":21004010,"end":21004010,"break":"none","ruby":[[4,1,"かれ"],[7,1,"たお"],[10,1,"とき"],[22,1,"とも"],[24,1,"たす"],[26,1,"おこ"],[42,1,"たお"],[45,1,"とき"],[50,1,"たす"],[52,1,"おこ"],[54,1,"もの"],[58,1,"もの"]],"text":"すなわち彼らが倒れる時には、そのひとりがその友を助け起す。しかしひとりであって、その倒れる時、これを助け起す者のない者はわざわいである。"},{"ref":"Eccl.4.11","start":21004011,"end":21004011,"break":"none","ruby":[[6,2,"いっしょ"],[9,1,"ね"],[12,1,"あたた"],[29,1,"あたた"],[34,1,"え"]],"text":"またふたりが一緒に寝れば暖かである。ひとりだけで、どうして暖かになり得ようか。"},{"ref":"Eccl.4.12","start":21004012,"end":21004012,"break":"none","ruby":[[0,1,"ひと"],[11,1,"せ"],[13,1,"う"],[27,1,"あた"],[39,1,"つな"],[46,1,"き"]],"text":"人がもし、そのひとりを攻め撃ったなら、ふたりで、それに当るであろう。三つよりの綱はたやすくは切れない。"},{"ref":"Eccl.4.13","start":21004013,"end":21004013,"break":"paragraph","ruby":[[0,1,"まず"],[4,1,"かしこ"],[11,1,"お"],[14,1,"おろ"],[32,1,"し"],[36,1,"おう"]],"text":"貧しくて賢いわらべは、老いて愚かで、もはや、いさめをいれることを知らない王にまさる。"},{"ref":"Eccl.4.14","start":21004014,"end":21004014,"break":"none","ruby":[[6,1,"おう"],[8,2,"ごくや"],[12,1,"で"],[15,2,"おうい"],[21,1,"もの"],[30,2,"じぶん"],[33,1,"くに"],[35,1,"まず"],[38,1,"うま"],[41,2,"おうい"],[47,1,"もの"]],"text":"たとい、その王が獄屋から出て、王位についた者であっても、また自分の国に貧しく生れて王位についた者であっても、そうである。"},{"ref":"Eccl.4.15","start":21004015,"end":21004015,"break":"none","ruby":[[4,1,"ひ"],[6,1,"した"],[8,1,"あゆ"],[14,1,"たみ"],[26,1,"おう"],[28,1,"かわ"],[31,1,"た"],[35,1,"み"]],"text":"わたしは日の下に歩むすべての民が、かのわらべのように王に代って立つのを見た。"},{"ref":"Eccl.4.16","start":21004016,"end":21004016,"break":"none","ruby":[[4,1,"たみ"],[6,1,"は"],[13,1,"かれ"],[21,1,"たみ"],[23,1,"みちび"],[30,1,"のち"],[32,1,"く"],[34,1,"もの"],[36,1,"かれ"],[38,1,"よろこ"],[53,1,"くう"],[59,1,"かぜ"],[61,1,"とら"]],"text":"すべての民は果てしがない。彼はそのすべての民を導いた。しかし後に来る者は彼を喜ばない。たしかに、これもまた空であって、風を捕えるようである。"}]