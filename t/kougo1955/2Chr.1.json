[{"ref":"2Chr.1.1","start":14001001,"end":14001001,"break":"paragraph","ruby":[[4,1,"こ"],[12,1,"くに"],[14,2,"じぶん"],[17,2,"ちい"],[20,2,"かくりつ"],[27,1,"かみ"],[29,1,"しゅ"],[31,1,"とも"],[37,1,"かれ"],[39,2,"ひじょう"],[42,1,"おお"],[46,1,"もの"]],"text":"ダビデの子ソロモンはその国に自分の地位を確立した。その神、主が共にいまして彼を非常に大いなる者にされた。"},{"ref":"2Chr.1.2","start":14001002,"end":14001002,"break":"paragraph","ruby":[[22,1,"にん"],[24,1,"ちょう"],[27,1,"にん"],[29,1,"ちょう"],[45,1,"ぜん"],[46,1,"ち"],[56,2,"しぞく"],[65,1,"つ"]],"text":"ソロモンはすべてのイスラエルびと、すなわち千人の長、百人の長、さばきびとおよびイスラエルの全地のすべてのつかさ、氏族のかしらたちに告げた。"},{"ref":"2Chr.1.3","start":14001003,"end":14001003,"break":"none","ruby":[[14,1,"ぜん"],[15,2,"かいしゅう"],[28,1,"たか"],[30,1,"ところ"],[32,1,"い"],[36,1,"しゅ"],[45,2,"あらの"],[48,1,"つく"],[51,1,"かみ"],[53,2,"かいけん"],[56,2,"まくや"]],"text":"そしてソロモンとイスラエルの全会衆はともにギベオンにある高き所へ行った。主のしもべモーセが荒野で造った神の会見の幕屋がそこにあったからである。"},{"ref":"2Chr.1.4","start":14001004,"end":14001004,"break":"none","ruby":[[4,1,"かみ"],[6,1,"はこ"],[32,1,"そな"],[35,1,"ところ"],[37,1,"はこ"],[39,1,"のぼ"],[67,2,"てんまく"],[70,1,"は"],[73,1,"お"]],"text":"（しかし神の箱はダビデがすでにキリアテ・ヤリムから、これのために備えた所に運び上らせてあった。ダビデはさきに、エルサレムでこれのために天幕を張って置いたからである。）"},{"ref":"2Chr.1.5","start":14001005,"end":14001005,"break":"none","ruby":[[5,1,"こ"],[12,1,"こ"],[18,1,"つく"],[21,2,"せいどう"],[24,2,"さいだん"],[29,1,"ところ"],[31,1,"しゅ"],[33,2,"まくや"],[36,1,"まえ"],[48,2,"かいしゅう"],[51,1,"しゅ"],[53,1,"もと"]],"text":"またホルの子であるウリの子ベザレルが造った青銅の祭壇がその所の主の幕屋の前にあり、ソロモンおよび会衆は主に求めた。"},{"ref":"2Chr.1.6","start":14001006,"end":14001006,"break":"none","ruby":[[8,1,"のぼ"],[11,1,"い"],[15,2,"かいけん"],[18,2,"まくや"],[26,1,"しゅ"],[28,1,"まえ"],[30,2,"せいどう"],[33,2,"さいだん"],[36,2,"はんさい"]],"text":"ソロモンはそこに上って行って、会見の幕屋のうちにある主の前の青銅の祭壇に燔祭一千をささげた。"},{"ref":"2Chr.1.7","start":14001007,"end":14001007,"break":"paragraph","ruby":[[2,1,"よる"],[4,1,"かみ"],[11,1,"あらわ"],[14,1,"い"],[24,1,"なに"],[26,1,"あた"],[32,1,"もと"]],"text":"その夜、神はソロモンに現れて言われた、「あなたに何を与えようか、求めなさい」。"},{"ref":"2Chr.1.8","start":14001008,"end":14001008,"break":"none","ruby":[[5,1,"かみ"],[7,1,"い"],[20,1,"ちち"],[25,1,"おお"],[35,1,"しめ"],[44,1,"かれ"],[46,1,"かわ"],[49,1,"おう"]],"text":"ソロモンは神に言った、「あなたはわたしの父ダビデに大いなるいつくしみを示し、またわたしを彼に代って王とされました。"},{"ref":"2Chr.1.9","start":14001009,"end":14001009,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[11,1,"ちち"],[16,2,"やくそく"],[21,1,"こと"],[23,1,"はた"],[35,1,"ち"],[43,1,"おお"],[46,1,"たみ"],[48,1,"うえ"],[54,1,"た"],[57,1,"おう"]],"text":"主なる神よ、どうぞわが父ダビデに約束された事を果してください。あなたは地のちりのような多くの民の上にわたしを立てて王とされたからです。"},{"ref":"2Chr.1.10","start":14001010,"end":14001010,"break":"none","ruby":[[2,1,"たみ"],[4,1,"まえ"],[6,2,"でい"],[20,1,"いま"],[25,2,"ちえ"],[28,2,"ちしき"],[32,1,"あた"],[48,1,"おお"],[56,1,"たみ"]],"text":"この民の前に出入りすることのできるように今わたしに知恵と知識とを与えてください。だれがこのような大いなるあなたの民をさばくことができましょうか」。"},{"ref":"2Chr.1.11","start":14001011,"end":14001011,"break":"none","ruby":[[0,1,"かみ"],[7,1,"い"],[15,1,"こと"],[21,1,"こころ"],[27,1,"とみ"],[31,1,"たから"],[35,1,"ほまれ"],[45,1,"にく"],[47,1,"もの"],[49,1,"いのち"],[52,1,"もと"],[58,2,"ちょうめい"],[62,1,"もと"],[76,1,"た"],[79,1,"おう"],[87,1,"たみ"],[95,2,"ちえ"],[98,2,"ちしき"],[102,2,"じぶん"],[108,1,"もと"]],"text":"神はソロモンに言われた、「この事があなたの心にあって、富をも、宝をも、誉をも、またあなたを憎む者の命をも求めず、また長命をも求めず、ただわたしがあなたを立てて王としたわたしの民をさばくために知恵と知識とを自分のために求めたので、"},{"ref":"2Chr.1.12","start":14001012,"end":14001012,"break":"none","ruby":[[0,2,"ちえ"],[3,2,"ちしき"],[11,1,"あた"],[29,1,"まえ"],[31,1,"おう"],[38,1,"え"],[48,1,"とみ"],[50,1,"たから"],[52,1,"ほまれ"],[59,1,"あた"],[68,1,"のち"],[70,1,"もの"],[81,1,"え"]],"text":"知恵と知識とはあなたに与えられている。わたしはまたあなたの前の王たちの、まだ得たことのないほどの富と宝と誉とをあなたに与えよう。あなたの後の者も、このようなものを得ないでしょう」。"},{"ref":"2Chr.1.13","start":14001013,"end":14001013,"break":"none","ruby":[[14,1,"たか"],[16,1,"ところ"],[18,1,"さ"],[21,2,"かいけん"],[24,2,"まくや"],[27,1,"まえ"],[29,1,"さ"],[39,1,"かえ"],[48,1,"おさ"]],"text":"それからソロモンはギベオンの高き所を去り、会見の幕屋の前を去って、エルサレムに帰り、イスラエルを治めた。"},{"ref":"2Chr.1.14","start":14001014,"end":14001014,"break":"paragraph","ruby":[[5,2,"せんしゃ"],[8,2,"きへい"],[12,1,"あつ"],[17,2,"せんしゃ"],[23,1,"りょう"],[25,2,"きへい"],[31,1,"にん"],[44,2,"せんしゃ"],[47,2,"まちまち"],[57,1,"おう"],[63,1,"お"]],"text":"ソロモンは戦車と騎兵とを集めたが、戦車一千四百両、騎兵一万二千人あった。ソロモンはこれを戦車の町々と、エルサレムの王のもととに置いた。"},{"ref":"2Chr.1.15","start":14001015,"end":14001015,"break":"none","ruby":[[0,1,"おう"],[2,1,"ぎん"],[4,1,"きん"],[6,1,"いし"],[17,1,"おお"],[21,2,"こうはく"],[24,2,"へいや"],[31,1,"くわ"],[36,1,"おお"]],"text":"王は銀と金を石のようにエルサレムに多くし、香柏を平野のいちじく桑のように多くした。"},{"ref":"2Chr.1.16","start":14001016,"end":14001016,"break":"none","ruby":[[5,1,"うま"],[7,2,"ゆにゅう"],[31,1,"おう"],[33,2,"ぼうえき"],[35,2,"しょうにん"],[42,2,"だいか"],[45,1,"はら"],[48,1,"う"],[50,1,"と"],[53,1,"き"]],"text":"ソロモンが馬を輸入したのはエジプトとクエからであった。すなわち王の貿易商人がクエから代価を払って受け取って来た。"},{"ref":"2Chr.1.17","start":14001017,"end":14001017,"break":"none","ruby":[[0,1,"かれ"],[9,2,"せんしゃ"],[12,1,"りょう"],[14,1,"ぎん"],[21,2,"ゆにゅう"],[25,1,"うま"],[27,1,"とう"],[29,1,"ぎん"],[34,2,"ゆにゅう"],[39,1,"おな"],[51,1,"かれ"],[66,1,"おう"],[77,1,"おう"],[82,2,"ゆしゅつ"]],"text":"彼らはエジプトから戦車一両を銀六百シケルで輸入し、馬一頭を銀百五十で輸入した。同じようにこれらのものが彼らによってヘテびとのすべての王たち、およびスリヤの王たちにも輸出された。"}]