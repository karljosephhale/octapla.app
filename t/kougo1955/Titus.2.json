[{"ref":"Titus.2.1","start":56002001,"end":56002001,"break":"paragraph","ruby":[[9,2,"けんぜん"],[12,1,"おしえ"],[20,1,"かた"]],"text":"しかし、あなたは、健全な教にかなうことを語りなさい。"},{"ref":"Titus.2.2","start":56002002,"end":56002002,"break":"none","ruby":[[0,2,"ろうじん"],[6,1,"みずか"],[9,1,"せい"],[12,2,"きんげん"],[16,1,"つつし"],[18,1,"ふか"],[25,2,"しんこう"],[28,1,"あい"],[30,2,"にんたい"],[37,2,"けんぜん"],[45,1,"すす"]],"text":"老人たちには自らを制し、謹厳で、慎み深くし、また、信仰と愛と忍耐とにおいて健全であるように勧め、"},{"ref":"Titus.2.3","start":56002003,"end":56002003,"break":"none","ruby":[[0,2,"としお"],[4,1,"おんな"],[10,1,"おな"],[18,1,"い"],[32,1,"ひと"],[39,2,"たいしゅ"],[42,2,"どれい"],[52,1,"よ"],[57,1,"おし"],[60,1,"もの"],[68,1,"すす"]],"text":"年老いた女たちにも、同じように、たち居ふるまいをうやうやしくし、人をそしったり大酒の奴隷になったりせず、良いことを教える者となるように、勧めなさい。"},{"ref":"Titus.2.4","start":56002004,"end":56002004,"break":"none","ruby":[[6,2,"かのじょ"],[12,1,"わか"],[14,1,"おんな"],[19,1,"おっと"],[21,1,"あい"],[24,2,"こども"],[27,1,"あい"]],"text":"そうすれば、彼女たちは、若い女たちに、夫を愛し、子供を愛し、"},{"ref":"Titus.2.5","start":56002005,"end":56002005,"break":"none","ruby":[[0,1,"つつし"],[2,1,"ふか"],[5,2,"じゅんけつ"],[9,2,"かじ"],[12,1,"つと"],[15,2,"ぜんりょう"],[19,2,"じぶん"],[22,1,"おっと"],[24,2,"じゅうじゅん"],[32,1,"おし"],[47,1,"かみ"],[49,1,"ことば"],[55,1,"う"]],"text":"慎み深く、純潔で、家事に努め、善良で、自分の夫に従順であるように教えることになり、したがって、神の言がそしりを受けないようになるであろう。"},{"ref":"Titus.2.6","start":56002006,"end":56002006,"break":"none","ruby":[[0,1,"わか"],[2,1,"おとこ"],[6,1,"おな"],[10,2,"ばんじ"],[15,1,"つつし"],[17,1,"ぶか"],[25,1,"すす"]],"text":"若い男にも、同じく、万事につけ慎み深くあるように、勧めなさい。"},{"ref":"Titus.2.7","start":56002007,"end":56002007,"break":"none","ruby":[[3,2,"じしん"],[6,1,"よ"],[11,2,"もはん"],[16,1,"しめ"],[19,1,"ひと"],[21,1,"おし"],[24,2,"ばあい"],[29,2,"せいれん"],[32,2,"きんげん"]],"text":"あなた自身を良いわざの模範として示し、人を教える場合には、清廉と謹厳とをもってし、"},{"ref":"Titus.2.8","start":56002008,"end":56002008,"break":"none","ruby":[[0,2,"ひなん"],[5,2,"けんぜん"],[8,2,"ことば"],[11,1,"もち"],[23,3,"はんたいしゃ"],[40,2,"あっこう"],[43,1,"い"],[50,1,"みずか"],[52,1,"は"]],"text":"非難のない健全な言葉を用いなさい。そうすれば、反対者も、わたしたちについてなんの悪口も言えなくなり、自ら恥じいるであろう。"},{"ref":"Titus.2.9","start":56002009,"end":56002009,"break":"paragraph","ruby":[[0,2,"どれい"],[5,2,"ばんじ"],[12,2,"しゅじん"],[15,2,"ふくじゅう"],[20,1,"よろこ"],[30,2,"はんこう"]],"text":"奴隷には、万事につけその主人に服従して、喜ばれるようになり、反抗をせず、"},{"ref":"Titus.2.10","start":56002010,"end":56002010,"break":"none","ruby":[[0,1,"ぬす"],[11,1,"こころ"],[16,2,"しんじつ"],[19,1,"しめ"],[26,1,"すす"],[38,1,"かれ"],[41,2,"ばんじ"],[53,2,"すくいぬし"],[57,1,"かみ"],[59,1,"おしえ"],[61,1,"かざ"]],"text":"盗みをせず、どこまでも心をこめた真実を示すようにと、勧めなさい。そうすれば、彼らは万事につけ、わたしたちの救主なる神の教を飾ることになろう。"},{"ref":"Titus.2.11","start":56002011,"end":56002011,"break":"paragraph","ruby":[[4,1,"ひと"],[6,1,"すく"],[8,1,"かみ"],[10,1,"めぐ"],[13,1,"あらわ"]],"text":"すべての人を救う神の恵みが現れた。"},{"ref":"Titus.2.12","start":56002012,"end":56002012,"break":"none","ruby":[[10,1,"みちび"],[13,3,"ふしんじん"],[19,1,"よ"],[21,2,"じょうよく"],[25,1,"す"],[29,1,"つつし"],[31,1,"ぶか"],[34,1,"ただ"],[38,2,"しんじん"],[40,1,"ぶか"],[44,1,"よ"],[46,2,"せいかつ"]],"text":"そして、わたしたちを導き、不信心とこの世の情欲とを捨てて、慎み深く、正しく、信心深くこの世で生活し、"},{"ref":"Titus.2.13","start":56002013,"end":56002013,"break":"none","ruby":[[0,2,"しゅくふく"],[3,1,"み"],[6,1,"のぞ"],[14,1,"おお"],[18,1,"かみ"],[26,2,"すくいぬし"],[37,2,"えいこう"],[40,2,"しゅつげん"],[43,1,"ま"],[45,1,"のぞ"],[52,1,"おし"]],"text":"祝福に満ちた望み、すなわち、大いなる神、わたしたちの救主キリスト・イエスの栄光の出現を待ち望むようにと、教えている。"},{"ref":"Titus.2.14","start":56002014,"end":56002014,"break":"none","ruby":[[18,2,"じしん"],[40,2,"ふほう"],[48,1,"だ"],[52,1,"よ"],[57,2,"ねっしん"],[60,1,"えら"],[63,1,"たみ"],[67,2,"じしん"],[75,1,"せい"],[76,1,"べつ"]],"text":"このキリストが、わたしたちのためにご自身をささげられたのは、わたしたちをすべての不法からあがない出して、良いわざに熱心な選びの民を、ご自身のものとして聖別するためにほかならない。"},{"ref":"Titus.2.15","start":56002015,"end":56002015,"break":"paragraph","ruby":[[5,2,"けんい"],[18,1,"かた"],[21,1,"すす"],[26,1,"せ"],[36,1,"かろ"]],"text":"あなたは、権威をもってこれらのことを語り、勧め、また責めなさい。だれにも軽んじられてはならない。"}]