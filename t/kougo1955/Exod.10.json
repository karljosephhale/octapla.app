[{"ref":"Exod.10.1","start":2010001,"end":2010001,"break":"paragraph","ruby":[[4,1,"しゅ"],[10,1,"い"],[22,1,"い"],[32,1,"かれ"],[34,1,"こころ"],[38,2,"けらい"],[43,1,"こころ"],[70,1,"かれ"],[73,1,"なか"],[75,1,"おこな"]],"text":"そこで、主はモーセに言われた、「パロのもとに行きなさい。わたしは彼の心とその家来たちの心をかたくなにした。これは、わたしがこれらのしるしを、彼らの中に行うためである。"},{"ref":"Exod.10.2","start":2010002,"end":2010002,"break":"none","ruby":[[24,1,"かれ"],[27,1,"なか"],[33,1,"おこな"],[48,1,"こ"],[50,1,"まご"],[52,1,"みみ"],[54,1,"かた"],[56,1,"つた"],[79,1,"しゅ"],[86,1,"し"]],"text":"また、わたしがエジプトびとをあしらったこと、また彼らの中にわたしが行ったしるしを、あなたがたが、子や孫の耳に語り伝えるためである。そしてあなたがたは、わたしが主であることを知るであろう」。"},{"ref":"Exod.10.3","start":2010003,"end":2010003,"break":"paragraph","ruby":[[14,1,"い"],[17,1,"かれ"],[19,1,"い"],[30,1,"かみ"],[32,1,"しゅ"],[36,1,"おお"],[57,2,"くっぷく"],[64,1,"こば"],[71,1,"たみ"],[73,1,"さ"],[82,1,"つか"]],"text":"モーセとアロンはパロのもとに行って彼に言った、「ヘブルびとの神、主はこう仰せられる、『いつまで、あなたは、わたしに屈伏することを拒むのですか。民を去らせて、わたしに仕えさせなさい。"},{"ref":"Exod.10.4","start":2010004,"end":2010004,"break":"none","ruby":[[7,1,"たみ"],[9,1,"さ"],[16,1,"こば"],[22,1,"み"],[41,2,"りょうど"]],"text":"もし、わたしの民を去らせることを拒むならば、見よ、あす、わたしはいなごを、あなたの領土にはいらせるであろう。"},{"ref":"Exod.10.5","start":2010005,"end":2010005,"break":"none","ruby":[[3,1,"ち"],[13,1,"ひと"],[15,1,"ち"],[17,1,"み"],[39,1,"ひょう"],[41,1,"まぬか"],[45,1,"のこ"],[54,1,"く"],[56,1,"つく"],[59,1,"の"],[72,1,"き"],[76,1,"く"],[78,1,"つく"]],"text":"それは地のおもてをおおい、人が地を見ることもできないほどになるであろう。そして雹を免れて、残されているものを食い尽し、野にはえているあなたがたの木をみな食い尽すであろう。"},{"ref":"Exod.10.6","start":2010006,"end":2010006,"break":"none","ruby":[[9,1,"いえ"],[19,2,"けらい"],[22,1,"いえ"],[39,1,"いえ"],[41,1,"み"],[62,1,"ちち"],[70,2,"そふ"],[76,1,"かれ"],[79,2,"ちじょう"],[85,1,"ひ"],[88,2,"こんにち"],[91,1,"いた"],[99,1,"み"],[118,1,"かれ"],[120,1,"み"],[134,1,"で"],[136,1,"い"]],"text":"またそれはあなたの家とあなたのすべての家来の家、および、すべてのエジプトびとの家に満ちるであろう。このようなことは、あなたの父たちも、また、祖父たちも、彼らが地上にあった日から今日に至るまで、かつて見たことのないものである』と」。そして彼は身をめぐらして、パロのもとを出て行った。"},{"ref":"Exod.10.7","start":2010007,"end":2010007,"break":"paragraph","ruby":[[3,2,"けらい"],[8,1,"おう"],[10,1,"い"],[22,1,"ひと"],[42,2,"ひとびと"],[45,1,"さ"],[49,1,"かれ"],[52,1,"かみ"],[55,1,"しゅ"],[57,1,"つか"],[76,1,"ほろ"],[88,1,"き"]],"text":"パロの家来たちは王に言った、「いつまで、この人はわれわれのわなとなるのでしょう。この人々を去らせ、彼らの神なる主に仕えさせては、どうでしょう。エジプトが滅びてしまうことに、まだ気づかれないのですか」。"},{"ref":"Exod.10.8","start":2010008,"end":2010008,"break":"none","ruby":[[22,1,"め"],[24,1,"だ"],[32,1,"かれ"],[35,1,"い"],[40,1,"い"],[50,1,"かみ"],[52,1,"しゅ"],[54,1,"つか"],[64,1,"い"]],"text":"そこで、モーセとアロンは、また、パロのもとに召し出された。パロは彼らに言った、「行って、あなたがたの神、主に仕えなさい。しかし、行くものはだれだれか」。"},{"ref":"Exod.10.9","start":2010009,"end":2010009,"break":"none","ruby":[[4,1,"い"],[15,1,"おさな"],[17,1,"もの"],[20,1,"お"],[23,1,"もの"],[25,1,"い"],[34,1,"むすめ"],[36,1,"たずさ"],[39,1,"ひつじ"],[41,1,"うし"],[43,1,"つ"],[46,1,"い"],[57,1,"しゅ"],[59,1,"まつり"],[61,1,"と"],[63,1,"おこな"]],"text":"モーセは言った、「わたしたちは幼い者も、老いた者も行きます。むすこも娘も携え、羊も牛も連れて行きます。わたしたちは主の祭を執り行わなければならないのですから」。"},{"ref":"Exod.10.10","start":2010010,"end":2010010,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[11,2,"まんいち"],[25,2,"こども"],[28,1,"つ"],[33,1,"さ"],[47,1,"しゅ"],[55,1,"とも"],[70,1,"わる"]],"text":"パロは彼らに言った、「万一、わたしが、あなたがたに子供を連れてまで去らせるようなことがあれば、主があなたがたと共にいますがよい。あなたがたは悪いたくらみをしている。"},{"ref":"Exod.10.11","start":2010011,"end":2010011,"break":"none","ruby":[[14,1,"おとこ"],[17,1,"い"],[20,1,"しゅ"],[22,1,"つか"],[39,2,"ようきゅう"],[47,1,"かれ"],[57,1,"まえ"],[60,1,"お"],[62,1,"だ"]],"text":"それはいけない。あなたがたは男だけ行って主に仕えるがよい。それが、あなたがたの要求であった」。彼らは、ついにパロの前から追い出された。"},{"ref":"Exod.10.12","start":2010012,"end":2010012,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"て"],[23,1,"ち"],[25,1,"うえ"],[29,1,"の"],[38,1,"ち"],[49,1,"ち"],[55,2,"あおもの"],[63,1,"ひょう"],[65,1,"う"],[67,1,"のこ"],[79,1,"た"]],"text":"主はモーセに言われた、「あなたの手をエジプトの地の上にさし伸べて、エジプトの地にいなごをのぼらせ、地のすべての青物、すなわち、雹が打ち残したものを、ことごとく食べさせなさい」。"},{"ref":"Exod.10.13","start":2010013,"end":2010013,"break":"none","ruby":[[12,1,"ち"],[14,1,"うえ"],[22,1,"の"],[28,1,"しゅ"],[30,2,"しゅうじつ"],[33,2,"しゅうや"],[36,2,"ひがしかぜ"],[39,1,"ち"],[41,1,"ふ"],[48,1,"あさ"],[54,2,"ひがしかぜ"],[62,1,"はこ"]],"text":"そこでモーセはエジプトの地の上に、つえをさし伸べたので、主は終日、終夜、東風を地に吹かせられた。朝となって、東風は、いなごを運んできた。"},{"ref":"Exod.10.14","start":2010014,"end":2010014,"break":"none","ruby":[[8,2,"ぜんこく"],[20,1,"ぜん"],[21,2,"りょうど"],[31,1,"かず"],[37,1,"おお"],[49,1,"まえ"],[57,1,"のち"]],"text":"いなごはエジプト全国にのぞみ、エジプトの全領土にとどまり、その数がはなはだ多く、このようないなごは前にもなく、また後にもないであろう。"},{"ref":"Exod.10.15","start":2010015,"end":2010015,"break":"none","ruby":[[4,1,"ち"],[6,2,"ぜんめん"],[16,1,"ち"],[18,1,"くら"],[27,1,"ち"],[33,2,"あおもの"],[37,1,"ひょう"],[39,1,"う"],[41,1,"のこ"],[44,1,"き"],[46,1,"み"],[54,1,"た"],[64,2,"ぜんこく"],[72,1,"き"],[75,1,"はたけ"],[77,2,"あおもの"],[82,1,"みどり"],[84,1,"もの"],[88,1,"なに"],[90,1,"のこ"]],"text":"いなごは地の全面をおおったので、地は暗くなった。そして地のすべての青物と、雹の打ち残した木の実を、ことごとく食べたので、エジプト全国にわたって、木にも畑の青物にも、緑の物とては何も残らなかった。"},{"ref":"Exod.10.16","start":2010016,"end":2010016,"break":"none","ruby":[[8,1,"いそ"],[19,1,"め"],[22,1,"い"],[38,1,"かみ"],[40,1,"しゅ"],[42,1,"たい"],[54,1,"たい"],[57,1,"つみ"],[59,1,"おか"]],"text":"そこで、パロは、急いでモーセとアロンを召して言った、「わたしは、あなたがたの神、主に対し、また、あなたがたに対して罪を犯しました。"},{"ref":"Exod.10.17","start":2010017,"end":2010017,"break":"none","ruby":[[11,1,"ど"],[19,1,"つみ"],[39,1,"かみ"],[41,1,"しゅ"],[43,2,"きがん"],[53,1,"し"],[60,1,"はな"]],"text":"それで、どうか、もう一度だけ、わたしの罪をゆるしてください。そしてあなたがたの神、主に祈願して、ただ、この死をわたしから離れさせてください」。"},{"ref":"Exod.10.18","start":2010018,"end":2010018,"break":"none","ruby":[[3,1,"かれ"],[13,1,"で"],[16,1,"しゅ"],[18,2,"きがん"]],"text":"そこで彼はパロのところから出て、主に祈願したので、"},{"ref":"Exod.10.19","start":2010019,"end":2010019,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"つよ"],[9,2,"にしかぜ"],[12,1,"かわ"],[20,1,"ふ"],[22,1,"あ"],[29,2,"こうかい"],[32,1,"お"],[45,2,"ぜんど"],[56,1,"のこ"]],"text":"主は、はなはだ強い西風に変らせ、いなごを吹き上げて、これを紅海に追いやられたので、エジプト全土には一つのいなごも残らなかった。"},{"ref":"Exod.10.20","start":2010020,"end":2010020,"break":"none","ruby":[[4,1,"しゅ"],[9,1,"こころ"],[22,1,"かれ"],[30,2,"ひとびと"],[33,1,"さ"]],"text":"しかし、主がパロの心をかたくなにされたので、彼はイスラエルの人々を去らせなかった。"},{"ref":"Exod.10.21","start":2010021,"end":2010021,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[14,1,"てん"],[24,1,"て"],[28,1,"の"],[36,1,"くに"]],"text":"主はまたモーセに言われた、「天にむかってあなたの手をさし伸べ、エジプトの国に、くらやみをこさせなさい。そのくらやみは、さわれるほどである」。"},{"ref":"Exod.10.22","start":2010022,"end":2010022,"break":"none","ruby":[[4,1,"てん"],[10,1,"て"],[14,1,"の"],[20,1,"こ"],[32,2,"ぜんこく"],[35,1,"のぞ"],[38,1,"か"],[40,1,"およ"]],"text":"モーセが天にむかって手をさし伸べたので、濃いくらやみは、エジプト全国に臨み三日に及んだ。"},{"ref":"Exod.10.23","start":2010023,"end":2010023,"break":"none","ruby":[[1,1,"か"],[3,1,"あいだ"],[5,2,"ひとびと"],[8,1,"たがい"],[10,1,"み"],[26,1,"ところ"],[29,1,"た"],[31,1,"もの"],[48,2,"ひとびと"],[58,1,"す"],[60,1,"ところ"],[62,1,"ひかり"]],"text":"三日の間、人々は互に見ることもできず、まただれもその所から立つ者もなかった。しかし、イスラエルの人々には、みな、その住む所に光があった。"},{"ref":"Exod.10.24","start":2010024,"end":2010024,"break":"none","ruby":[[10,1,"め"],[13,1,"い"],[24,1,"い"],[27,1,"しゅ"],[29,1,"つか"],[41,2,"こども"],[44,1,"つ"],[47,1,"い"],[65,1,"ひつじ"],[67,1,"うし"],[69,1,"のこ"],[72,1,"お"]],"text":"そこでパロはモーセを召して言った、「あなたがたは行って主に仕えなさい。あなたがたの子供も連れて行ってもよろしい。ただ、あなたがたの羊と牛は残して置きなさい」。"},{"ref":"Exod.10.25","start":2010025,"end":2010025,"break":"none","ruby":[[8,1,"い"],[27,1,"かみ"],[29,1,"しゅ"],[35,2,"ぎせい"],[38,2,"はんさい"],[41,1,"もの"]],"text":"しかし、モーセは言った、「あなたは、また、わたしたちの神、主にささげる犠牲と燔祭の物をも、わたしたちにくださらなければなりません。"},{"ref":"Exod.10.26","start":2010026,"end":2010026,"break":"none","ruby":[[6,2,"かちく"],[9,1,"つ"],[12,1,"い"],[23,1,"のこ"],[42,1,"と"],[52,1,"かみ"],[54,1,"しゅ"],[56,1,"つか"],[77,2,"ばしょ"],[80,1,"い"],[86,1,"なに"],[92,1,"しゅ"],[94,1,"つか"],[101,1,"し"]],"text":"わたしたちは家畜も連れて行きます。ひずめ一つも残しません。わたしたちは、そのうちから取って、わたしたちの神、主に仕えねばなりません。またわたしたちは、その場所に行くまでは、何をもって、主に仕えるべきかを知らないからです」。"},{"ref":"Exod.10.27","start":2010027,"end":2010027,"break":"none","ruby":[[5,1,"しゅ"],[10,1,"こころ"],[26,1,"かれ"],[29,1,"さ"]],"text":"けれども、主がパロの心をかたくなにされたので、パロは彼らを去らせようとしなかった。"},{"ref":"Exod.10.28","start":2010028,"end":2010028,"break":"none","ruby":[[10,1,"い"],[19,1,"ところ"],[22,1,"さ"],[28,1,"こころ"],[36,1,"かお"],[39,1,"ど"],[41,1,"み"],[53,1,"かお"],[55,1,"み"],[57,1,"ひ"],[65,1,"いのち"]],"text":"それでパロはモーセに言った、「わたしの所から去りなさい。心して、わたしの顔は二度と見てはならない。わたしの顔を見る日には、あなたの命はないであろう」。"},{"ref":"Exod.10.29","start":2010029,"end":2010029,"break":"none","ruby":[[4,1,"い"],[12,1,"おお"],[26,1,"ど"],[33,1,"かお"],[35,1,"み"]],"text":"モーセは言った、「よくぞ仰せられました。わたしは、二度と、あなたの顔を見ないでしょう」。"}]