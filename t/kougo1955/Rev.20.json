[{"ref":"Rev.20.1","start":66020001,"end":66020001,"break":"paragraph","ruby":[[6,1,"み"],[16,2,"みつかい"],[20,1,"そこ"],[21,1,"し"],[24,1,"ところ"],[29,1,"おお"],[32,1,"くさり"],[35,1,"て"],[37,1,"も"],[41,1,"てん"],[44,1,"お"]],"text":"またわたしが見ていると、ひとりの御使が、底知れぬ所のかぎと大きな鎖とを手に持って、天から降りてきた。"},{"ref":"Rev.20.2","start":66020002,"end":66020002,"break":"none","ruby":[[0,1,"かれ"],[3,2,"あくま"],[14,1,"りゅう"],[23,1,"とし"],[25,1,"へ"],[30,1,"とら"],[34,1,"ねん"],[36,1,"あいだ"]],"text":"彼は、悪魔でありサタンである龍、すなわち、かの年を経たへびを捕えて千年の間つなぎおき、"},{"ref":"Rev.20.3","start":66020003,"end":66020003,"break":"none","ruby":[[4,1,"そこ"],[5,1,"し"],[8,1,"ところ"],[10,1,"な"],[12,1,"こ"],[15,2,"いりぐち"],[18,1,"と"],[23,1,"うえ"],[25,2,"ふういん"],[30,1,"ねん"],[32,2,"きかん"],[35,1,"おわ"],[40,1,"しょ"],[41,2,"こくみん"],[44,1,"まど"],[63,1,"のち"],[70,1,"あいだ"],[73,2,"かいほう"]],"text":"そして、底知れぬ所に投げ込み、入口を閉じてその上に封印し、千年の期間が終るまで、諸国民を惑わすことがないようにしておいた。その後、しばらくの間だけ解放されることになっていた。"},{"ref":"Rev.20.4","start":66020004,"end":66020004,"break":"paragraph","ruby":[[2,1,"み"],[10,1,"おお"],[13,1,"ざ"],[20,1,"うえ"],[22,2,"ひとびと"],[36,1,"かれ"],[43,1,"けん"],[45,1,"あた"],[65,1,"かみ"],[67,1,"ことば"],[69,1,"つた"],[75,1,"くび"],[77,1,"き"],[81,2,"ひとびと"],[84,1,"れい"],[95,1,"けもの"],[100,1,"ぞう"],[103,1,"おが"],[109,2,"こくいん"],[112,1,"ひたい"],[114,1,"て"],[116,1,"う"],[127,2,"ひとびと"],[133,1,"かれ"],[136,1,"い"],[148,1,"とも"],[151,1,"ねん"],[153,1,"あいだ"],[155,2,"しはい"]],"text":"また見ていると、かず多くの座があり、その上に人々がすわっていた。そして、彼らにさばきの権が与えられていた。また、イエスのあかしをし神の言を伝えたために首を切られた人々の霊がそこにおり、また、獣をもその像をも拝まず、その刻印を額や手に受けることをしなかった人々がいた。彼らは生きかえって、キリストと共に千年の間、支配した。"},{"ref":"Rev.20.5","start":66020005,"end":66020005,"break":"none","ruby":[[3,2,"いがい"],[6,2,"しにん"],[11,1,"ねん"],[13,2,"きかん"],[16,1,"おわ"],[20,1,"い"],[34,1,"だい"],[37,2,"ふっかつ"]],"text":"（それ以外の死人は、千年の期間が終るまで生きかえらなかった。）これが第一の復活である。"},{"ref":"Rev.20.6","start":66020006,"end":66020006,"break":"none","ruby":[[2,1,"だい"],[5,2,"ふっかつ"],[12,1,"もの"],[20,1,"もの"],[27,1,"せい"],[30,1,"もの"],[37,1,"ひと"],[41,1,"たい"],[46,1,"だい"],[49,1,"し"],[54,1,"ちから"],[59,1,"かれ"],[62,1,"かみ"],[70,2,"さいし"],[81,1,"とも"],[84,1,"ねん"],[86,1,"あいだ"],[88,2,"しはい"]],"text":"この第一の復活にあずかる者は、さいわいな者であり、また聖なる者である。この人たちに対しては、第二の死はなんの力もない。彼らは神とキリストとの祭司となり、キリストと共に千年の間、支配する。"},{"ref":"Rev.20.7","start":66020007,"end":66020007,"break":"paragraph","ruby":[[1,1,"ねん"],[3,2,"きかん"],[6,1,"おわ"],[16,1,"ごく"],[19,2,"かいほう"]],"text":"千年の期間が終ると、サタンはその獄から解放される。"},{"ref":"Rev.20.8","start":66020008,"end":66020008,"break":"none","ruby":[[4,1,"で"],[6,1,"い"],[9,1,"ち"],[11,2,"しほう"],[16,1,"しょ"],[17,2,"こくみん"],[31,1,"まど"],[35,1,"かれ"],[38,1,"たたか"],[44,2,"しょうしゅう"],[51,1,"かず"],[54,1,"うみ"],[56,1,"すな"],[61,1,"おお"]],"text":"そして、出て行き、地の四方にいる諸国民、すなわちゴグ、マゴグを惑わし、彼らを戦いのために召集する。その数は、海の砂のように多い。"},{"ref":"Rev.20.9","start":66020009,"end":66020009,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ちじょう"],[6,1,"ひろ"],[8,1,"ところ"],[10,1,"のぼ"],[16,2,"せいと"],[21,2,"じんえい"],[24,1,"あい"],[30,1,"みやこ"],[33,2,"ほうい"],[42,1,"てん"],[45,1,"ひ"],[47,1,"くだ"],[53,1,"かれ"],[56,1,"や"],[58,1,"つく"]],"text":"彼らは地上の広い所に上ってきて、聖徒たちの陣営と愛されていた都とを包囲した。すると、天から火が下ってきて、彼らを焼き尽した。"},{"ref":"Rev.20.10","start":66020010,"end":66020010,"break":"none","ruby":[[4,1,"かれ"],[7,1,"まど"],[11,2,"あくま"],[15,1,"ひ"],[17,2,"いおう"],[21,1,"いけ"],[23,1,"な"],[25,1,"こ"],[35,1,"けもの"],[39,3,"よげんしゃ"],[46,1,"かれ"],[49,2,"よよ"],[51,1,"かぎ"],[55,2,"にちや"],[58,1,"くる"]],"text":"そして、彼らを惑わした悪魔は、火と硫黄との池に投げ込まれた。そこには、獣もにせ預言者もいて、彼らは世々限りなく日夜、苦しめられるのである。"},{"ref":"Rev.20.11","start":66020011,"end":66020011,"break":"paragraph","ruby":[[2,1,"み"],[8,1,"おお"],[11,1,"しろ"],[13,2,"みざ"],[32,1,"てん"],[34,1,"ち"],[36,2,"みかお"],[39,1,"まえ"],[42,1,"に"],[44,1,"さ"]],"text":"また見ていると、大きな白い御座があり、そこにいますかたがあった。天も地も御顔の前から逃げ去って、あとかたもなくなった。"},{"ref":"Rev.20.12","start":66020012,"end":66020012,"break":"none","ruby":[[3,1,"し"],[8,1,"もの"],[11,1,"おお"],[15,1,"もの"],[17,1,"ちい"],[20,1,"もの"],[22,1,"とも"],[25,2,"みざ"],[28,1,"まえ"],[30,1,"た"],[37,1,"み"],[46,2,"しょもつ"],[49,1,"ひら"],[60,2,"しょもつ"],[63,1,"ひら"],[75,1,"しょ"],[81,2,"しにん"],[90,1,"おう"],[95,2,"しょもつ"],[98,1,"か"]],"text":"また、死んでいた者が、大いなる者も小さき者も共に、御座の前に立っているのが見えた。かずかずの書物が開かれたが、もう一つの書物が開かれた。これはいのちの書であった。死人はそのしわざに応じ、この書物に書かれていることにしたがって、さばかれた。"},{"ref":"Rev.20.13","start":66020013,"end":66020013,"break":"none","ruby":[[0,1,"うみ"],[4,1,"なか"],[8,2,"しにん"],[11,1,"だ"],[14,1,"し"],[16,2,"よみ"],[21,1,"なか"],[25,2,"しにん"],[28,1,"だ"],[45,1,"おう"],[53,1,"う"]],"text":"海はその中にいる死人を出し、死も黄泉もその中にいる死人を出し、そして、おのおのそのしわざに応じて、さばきを受けた。"},{"ref":"Rev.20.14","start":66020014,"end":66020014,"break":"none","ruby":[[5,1,"し"],[7,2,"よみ"],[10,1,"ひ"],[12,1,"いけ"],[14,1,"な"],[16,1,"こ"],[23,1,"ひ"],[25,1,"いけ"],[27,1,"だい"],[30,1,"し"]],"text":"それから、死も黄泉も火の池に投げ込まれた。この火の池が第二の死である。"},{"ref":"Rev.20.15","start":66020015,"end":66020015,"break":"none","ruby":[[6,1,"しょ"],[8,1,"な"],[18,1,"もの"],[23,1,"ひ"],[25,1,"いけ"],[27,1,"な"],[29,1,"こ"]],"text":"このいのちの書に名がしるされていない者はみな、火の池に投げ込まれた。"}]