[{"ref":"Rev.7.1","start":66007001,"end":66007001,"break":"paragraph","ruby":[[2,1,"のち"],[9,1,"にん"],[11,2,"みつかい"],[14,1,"ち"],[20,1,"た"],[27,1,"み"],[30,1,"かれ"],[33,1,"ち"],[35,2,"しほう"],[38,1,"かぜ"],[42,1,"と"],[46,1,"ち"],[49,1,"うみ"],[56,1,"き"],[60,1,"ふ"]],"text":"この後、わたしは四人の御使が地の四すみに立っているのを見た。彼らは地の四方の風をひき止めて、地にも海にもすべての木にも、吹きつけないようにしていた。"},{"ref":"Rev.7.2","start":66007002,"end":66007002,"break":"none","ruby":[[9,2,"みつかい"],[13,1,"い"],[16,1,"かみ"],[18,1,"いん"],[20,1,"も"],[24,1,"ひ"],[26,1,"で"],[28,1,"ほう"],[31,1,"のぼ"],[34,1,"く"],[38,1,"み"],[41,1,"かれ"],[43,1,"ち"],[45,1,"うみ"],[52,2,"けんい"],[55,1,"さず"],[62,1,"にん"],[64,2,"みつかい"],[72,2,"おおごえ"],[75,1,"さけ"],[78,1,"い"]],"text":"また、もうひとりの御使が、生ける神の印を持って、日の出る方から上って来るのを見た。彼は地と海とをそこなう権威を授かっている四人の御使にむかって、大声で叫んで言った、"},{"ref":"Rev.7.3","start":66007003,"end":66007003,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しもべ"],[12,1,"ひたい"],[21,1,"いん"],[33,1,"ち"],[35,1,"うみ"],[37,1,"き"]],"text":"「わたしたちの神の僕らの額に、わたしたちが印をおしてしまうまでは、地と海と木とをそこなってはならない」。"},{"ref":"Rev.7.4","start":66007004,"end":66007004,"break":"none","ruby":[[4,1,"いん"],[10,1,"もの"],[12,1,"かず"],[14,1,"き"],[25,1,"こ"],[32,2,"ぶぞく"],[38,1,"いん"],[44,1,"もの"],[51,1,"にん"]],"text":"わたしは印をおされた者の数を聞いたが、イスラエルの子らのすべての部族のうち、印をおされた者は十四万四千人であった。"},{"ref":"Rev.7.5","start":66007005,"end":66007005,"break":"stanza","breaks":[[21,"line"],[37,"line"]],"ruby":[[3,2,"ぶぞく"],[13,1,"にん"],[15,1,"いん"],[25,2,"ぶぞく"],[35,1,"にん"],[40,2,"ぶぞく"],[50,1,"にん"]],"text":"ユダの部族のうち、一万二千人が印をおされ、ルベンの部族のうち、一万二千人、ガドの部族のうち、一万二千人、"},{"ref":"Rev.7.6","start":66007006,"end":66007006,"break":"line","breaks":[[16,"line"],[33,"line"]],"ruby":[[4,2,"ぶぞく"],[14,1,"にん"],[21,2,"ぶぞく"],[31,1,"にん"],[37,2,"ぶぞく"],[47,1,"にん"]],"text":"アセルの部族のうち、一万二千人、ナフタリの部族のうち、一万二千人、マナセの部族のうち、一万二千人、"},{"ref":"Rev.7.7","start":66007007,"end":66007007,"break":"line","breaks":[[17,"line"],[32,"line"]],"ruby":[[5,2,"ぶぞく"],[15,1,"にん"],[20,2,"ぶぞく"],[30,1,"にん"],[37,2,"ぶぞく"],[47,1,"にん"]],"text":"シメオンの部族のうち、一万二千人、レビの部族のうち、一万二千人、イサカルの部族のうち、一万二千人、"},{"ref":"Rev.7.8","start":66007008,"end":66007008,"break":"line","breaks":[[17,"line"],[33,"line"],[45,"line"]],"ruby":[[5,2,"ぶぞく"],[15,1,"にん"],[21,2,"ぶぞく"],[31,1,"にん"],[39,2,"ぶぞく"],[49,1,"にん"],[51,1,"いん"]],"text":"ゼブルンの部族のうち、一万二千人、ヨセフの部族のうち、一万二千人、ベニヤミンの部族のうち、一万二千人が印をおされた。"},{"ref":"Rev.7.9","start":66007009,"end":66007009,"break":"paragraph","ruby":[[2,1,"のち"],[8,1,"み"],[14,1,"み"],[21,2,"こくみん"],[24,2,"ぶぞく"],[27,2,"みんぞく"],[30,2,"こくご"],[38,1,"かぞ"],[47,1,"おお"],[51,2,"ぐんしゅう"],[55,1,"しろ"],[57,1,"ころも"],[59,1,"み"],[69,1,"えだ"],[71,1,"て"],[73,1,"も"],[77,2,"みざ"],[80,2,"こひつじ"],[84,1,"まえ"],[86,1,"た"]],"text":"その後、わたしが見ていると、見よ、あらゆる国民、部族、民族、国語のうちから、数えきれないほどの大ぜいの群衆が、白い衣を身にまとい、しゅろの枝を手に持って、御座と小羊との前に立ち、"},{"ref":"Rev.7.10","start":66007010,"end":66007010,"break":"none","breaks":[[10,"stanza"],[26,"line"]],"ruby":[[0,2,"おおごえ"],[3,1,"さけ"],[6,1,"い"],[11,1,"すくい"],[14,2,"みざ"],[24,1,"かみ"],[26,2,"こひつじ"]],"text":"大声で叫んで言った、「救は、御座にいますわれらの神と小羊からきたる」。"},{"ref":"Rev.7.11","start":66007011,"end":66007011,"break":"none","ruby":[[0,2,"みつかい"],[8,2,"みざ"],[11,2,"ちょうろう"],[19,1,"い"],[21,1,"もの"],[28,1,"た"],[35,2,"みざ"],[38,1,"まえ"],[42,1,"ふ"],[45,1,"かみ"],[47,1,"はい"],[50,1,"い"]],"text":"御使たちはみな、御座と長老たちと四つの生き物とのまわりに立っていたが、御座の前にひれ伏し、神を拝して言った、"},{"ref":"Rev.7.12","start":66007012,"end":66007012,"break":"stanza","breaks":[[19,"line"],[36,"line"]],"ruby":[[10,2,"えいこう"],[13,2,"ちえ"],[16,2,"かんしゃ"],[23,1,"ちから"],[25,1,"いきお"],[29,2,"よよ"],[31,1,"かぎ"],[40,1,"かみ"]],"text":"「アァメン、さんび、栄光、知恵、感謝、ほまれ、力、勢いが、世々限りなく、われらの神にあるように、アァメン」。"},{"ref":"Rev.7.13","start":66007013,"end":66007013,"break":"paragraph","ruby":[[0,2,"ちょうろう"],[18,1,"い"],[25,1,"しろ"],[27,1,"ころも"],[29,1,"み"],[37,2,"ひとびと"]],"text":"長老たちのひとりが、わたしにむかって言った、「この白い衣を身にまとっている人々は、だれか。また、どこからきたのか」。"},{"ref":"Rev.7.14","start":66007014,"end":66007014,"break":"none","ruby":[[4,1,"かれ"],[6,1,"こた"],[15,1,"しゅ"],[26,1,"ぞん"],[36,1,"かれ"],[42,1,"い"],[47,1,"かれ"],[50,1,"おお"],[53,2,"かんなん"],[62,1,"ひと"],[72,1,"ころも"],[74,2,"こひつじ"],[77,1,"ち"],[79,1,"あら"],[85,1,"しろ"]],"text":"わたしは彼に答えた、「わたしの主よ、それはあなたがご存じです」。すると、彼はわたしに言った、「彼らは大きな患難をとおってきた人たちであって、その衣を小羊の血で洗い、それを白くしたのである。"},{"ref":"Rev.7.15","start":66007015,"end":66007015,"break":"none","ruby":[[5,1,"かれ"],[9,1,"かみ"],[11,2,"みざ"],[14,1,"まえ"],[19,1,"ひる"],[21,1,"よる"],[25,2,"せいじょ"],[28,1,"かみ"],[30,1,"つか"],[40,2,"みざ"],[50,1,"かれ"],[53,1,"うえ"],[55,2,"まくや"],[58,1,"は"],[61,1,"とも"],[63,1,"す"]],"text":"それだから彼らは、神の御座の前におり、昼も夜もその聖所で神に仕えているのである。御座にいますかたは、彼らの上に幕屋を張って共に住まわれるであろう。"},{"ref":"Rev.7.16","start":66007016,"end":66007016,"break":"none","ruby":[[0,1,"かれ"],[7,1,"う"],[25,2,"たいよう"],[28,2,"えんしょ"],[32,1,"かれ"],[35,1,"おか"]],"text":"彼らは、もはや飢えることがなく、かわくこともない。太陽も炎暑も、彼らを侵すことはない。"},{"ref":"Rev.7.17","start":66007017,"end":66007017,"break":"none","ruby":[[0,2,"みざ"],[3,2,"しょうめん"],[9,2,"こひつじ"],[12,1,"かれ"],[15,2,"ぼくしゃ"],[26,1,"みず"],[28,1,"いずみ"],[30,1,"みちび"],[33,1,"くだ"],[43,1,"かみ"],[46,1,"かれ"],[49,1,"め"],[52,1,"なみだ"],[65,1,"くだ"]],"text":"御座の正面にいます小羊は彼らの牧者となって、いのちの水の泉に導いて下さるであろう。また神は、彼らの目から涙をことごとくぬぐいとって下さるであろう」。"}]