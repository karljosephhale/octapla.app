[{"ref":"Exod.19.1","start":2019001,"end":2019001,"break":"paragraph","ruby":[[6,2,"ひとびと"],[15,1,"ち"],[17,1,"で"],[19,1,"のち"],[21,1,"つき"],[22,1,"め"],[26,1,"ひ"],[33,2,"あらの"]],"text":"イスラエルの人々は、エジプトの地を出て後三月目のその日に、シナイの荒野にはいった。"},{"ref":"Exod.19.2","start":2019002,"end":2019002,"break":"none","ruby":[[4,1,"かれ"],[12,2,"しゅったつ"],[20,2,"あらの"],[23,1,"い"],[26,2,"あらの"],[29,2,"しゅくえい"],[42,1,"ところ"],[44,1,"やま"],[46,1,"まえ"],[48,2,"しゅくえい"]],"text":"すなわち彼らはレピデムを出立してシナイの荒野に入り、荒野に宿営した。イスラエルはその所で山の前に宿営した。"},{"ref":"Exod.19.3","start":2019003,"end":2019003,"break":"none","ruby":[[7,1,"かみ"],[12,1,"のぼ"],[16,1,"しゅ"],[18,1,"やま"],[21,1,"かれ"],[23,1,"よ"],[26,1,"い"],[42,1,"いえ"],[44,1,"い"],[53,2,"ひとびと"],[56,1,"つ"]],"text":"さて、モーセが神のもとに登ると、主は山から彼を呼んで言われた、「このように、ヤコブの家に言い、イスラエルの人々に告げなさい、"},{"ref":"Exod.19.4","start":2019004,"end":2019004,"break":"none","ruby":[[21,1,"こと"],[30,1,"わし"],[32,1,"つばさ"],[34,1,"の"],[41,1,"ところ"],[50,1,"み"]],"text":"『あなたがたは、わたしがエジプトびとにした事と、あなたがたを鷲の翼に載せてわたしの所にこさせたことを見た。"},{"ref":"Exod.19.5","start":2019005,"end":2019005,"break":"none","ruby":[[21,1,"こえ"],[23,1,"き"],[25,1,"したが"],[32,2,"けいやく"],[35,1,"まも"],[51,1,"たみ"],[62,1,"たから"],[71,1,"ぜん"],[72,1,"ち"],[78,2,"しょゆう"]],"text":"それで、もしあなたがたが、まことにわたしの声に聞き従い、わたしの契約を守るならば、あなたがたはすべての民にまさって、わたしの宝となるであろう。全地はわたしの所有だからである。"},{"ref":"Exod.19.6","start":2019006,"end":2019006,"break":"none","ruby":[[10,1,"たい"],[13,2,"さいし"],[16,1,"くに"],[23,1,"せい"],[26,1,"たみ"],[49,2,"ひとびと"],[52,1,"かた"],[56,2,"ことば"]],"text":"あなたがたはわたしに対して祭司の国となり、また聖なる民となるであろう』。これがあなたのイスラエルの人々に語るべき言葉である」。"},{"ref":"Exod.19.7","start":2019007,"end":2019007,"break":"paragraph","ruby":[[7,1,"い"],[10,1,"たみ"],[12,2,"ちょうろう"],[17,1,"よ"],[20,1,"しゅ"],[22,1,"めい"],[31,2,"ことば"],[40,1,"まえ"],[42,1,"の"]],"text":"それでモーセは行って民の長老たちを呼び、主が命じられたこれらの言葉を、すべてその前に述べたので、"},{"ref":"Exod.19.8","start":2019008,"end":2019008,"break":"none","ruby":[[0,1,"たみ"],[4,1,"とも"],[6,1,"こた"],[9,1,"い"],[19,1,"しゅ"],[21,1,"い"],[31,1,"おこな"],[41,1,"たみ"],[43,2,"ことば"],[46,1,"しゅ"],[48,1,"つ"]],"text":"民はみな共に答えて言った、「われわれは主が言われたことを、みな行います」。モーセは民の言葉を主に告げた。"},{"ref":"Exod.19.9","start":2019009,"end":2019009,"break":"none","breaks":[[84,"paragraph"]],"ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"み"],[19,1,"こ"],[21,1,"くも"],[34,1,"のぞ"],[52,1,"かた"],[56,1,"たみ"],[58,1,"き"],[63,1,"かれ"],[66,1,"なが"],[72,1,"しん"],[88,1,"たみ"],[90,2,"ことば"],[93,1,"しゅ"],[95,1,"つ"]],"text":"主はモーセに言われた、「見よ、わたしは濃い雲のうちにあって、あなたに臨むであろう。それはわたしがあなたと語るのを民に聞かせて、彼らに長くあなたを信じさせるためである」。モーセは民の言葉を主に告げた。"},{"ref":"Exod.19.10","start":2019010,"end":2019010,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"たみ"],[22,1,"い"],[33,1,"かれ"],[40,1,"かれ"],[45,2,"いふく"],[48,1,"あら"]],"text":"主はモーセに言われた、「あなたは民のところに行って、きょうとあす、彼らをきよめ、彼らにその衣服を洗わせ、"},{"ref":"Exod.19.11","start":2019011,"end":2019011,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[6,1,"そな"],[15,1,"か"],[16,1,"め"],[18,1,"しゅ"],[25,1,"たみ"],[27,1,"め"],[29,1,"まえ"],[35,1,"さん"],[37,1,"くだ"]],"text":"三日目までに備えさせなさい。三日目に主が、すべての民の目の前で、シナイ山に下るからである。"},{"ref":"Exod.19.12","start":2019012,"end":2019012,"break":"none","ruby":[[4,1,"たみ"],[10,2,"しゅうい"],[13,1,"さかい"],[15,1,"もう"],[18,1,"い"],[31,2,"ちゅうい"],[36,1,"やま"],[38,1,"のぼ"],[47,2,"きょうかい"],[50,1,"ふ"],[62,1,"やま"],[64,1,"ふ"],[67,1,"もの"],[69,1,"かなら"],[71,1,"ころ"]],"text":"あなたは民のために、周囲に境を設けて言いなさい、『あなたがたは注意して、山に上らず、また、その境界に触れないようにしなさい。山に触れる者は必ず殺されるであろう。"},{"ref":"Exod.19.13","start":2019013,"end":2019013,"break":"none","ruby":[[0,1,"て"],[5,1,"ふ"],[14,1,"ふ"],[17,1,"もの"],[19,1,"かなら"],[21,1,"いし"],[23,1,"う"],[25,1,"ころ"],[31,2,"しゃさつ"],[41,1,"けもの"],[44,1,"ひと"],[47,1,"い"],[63,1,"なが"],[65,1,"ひび"],[68,1,"とき"],[70,1,"かれ"],[73,1,"やま"],[75,1,"のぼ"]],"text":"手をそれに触れてはならない。触れる者は必ず石で打ち殺されるか、射殺されるであろう。獣でも人でも生きることはできない』。ラッパが長く響いた時、彼らは山に登ることができる」と。"},{"ref":"Exod.19.14","start":2019014,"end":2019014,"break":"none","ruby":[[7,1,"やま"],[10,1,"たみ"],[16,1,"くだ"],[19,1,"たみ"],[26,1,"かれ"],[31,2,"いふく"],[34,1,"あら"]],"text":"そこでモーセは山から民のところに下り、民をきよめた。彼らはその衣服を洗った。"},{"ref":"Exod.19.15","start":2019015,"end":2019015,"break":"none","ruby":[[4,1,"たみ"],[6,1,"い"],[12,1,"か"],[13,1,"め"],[17,1,"そな"],[25,1,"おんな"],[27,1,"ちか"]],"text":"モーセは民に言った、「三日目までに備えをしなさい。女に近づいてはならない」。"},{"ref":"Exod.19.16","start":2019016,"end":2019016,"break":"paragraph","ruby":[[1,1,"か"],[2,1,"め"],[4,1,"あさ"],[21,1,"あつ"],[23,1,"くも"],[27,1,"やま"],[29,1,"うえ"],[38,1,"おと"],[45,1,"たか"],[47,1,"ひび"],[53,2,"しゅくえい"],[58,1,"たみ"],[62,1,"ふる"]],"text":"三日目の朝となって、かみなりと、いなずまと厚い雲とが、山の上にあり、ラッパの音が、はなはだ高く響いたので、宿営におる民はみな震えた。"},{"ref":"Exod.19.17","start":2019017,"end":2019017,"break":"none","ruby":[[4,1,"たみ"],[6,1,"かみ"],[8,1,"あ"],[16,2,"しゅくえい"],[20,1,"みちび"],[22,1,"だ"],[28,1,"かれ"],[31,1,"やま"],[37,1,"た"]],"text":"モーセが民を神に会わせるために、宿営から導き出したので、彼らは山のふもとに立った。"},{"ref":"Exod.19.18","start":2019018,"end":2019018,"break":"none","ruby":[[3,1,"さん"],[5,1,"ぜん"],[6,1,"ざん"],[7,1,"けむ"],[11,1,"しゅ"],[13,1,"ひ"],[24,1,"うえ"],[26,1,"くだ"],[38,1,"けむり"],[45,1,"けむり"],[50,1,"た"],[52,1,"のぼ"],[55,1,"ぜん"],[56,1,"ざん"],[61,1,"ふる"]],"text":"シナイ山は全山煙った。主が火のなかにあって、その上に下られたからである。その煙は、かまどの煙のように立ち上り、全山はげしく震えた。"},{"ref":"Exod.19.19","start":2019019,"end":2019019,"break":"none","ruby":[[4,1,"おと"],[11,1,"たか"],[23,1,"かた"],[26,1,"かみ"],[38,1,"かれ"],[40,1,"こた"]],"text":"ラッパの音が、いよいよ高くなったとき、モーセは語り、神は、かみなりをもって、彼に答えられた。"},{"ref":"Exod.19.20","start":2019020,"end":2019020,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"さん"],[7,1,"いただき"],[9,1,"くだ"],[17,1,"しゅ"],[23,1,"やま"],[25,1,"いただき"],[27,1,"め"],[38,1,"のぼ"]],"text":"主はシナイ山の頂に下られた。そして主がモーセを山の頂に召されたので、モーセは登った。"},{"ref":"Exod.19.21","start":2019021,"end":2019021,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"くだ"],[15,1,"い"],[18,1,"たみ"],[20,1,"いまし"],[26,1,"たみ"],[28,1,"お"],[30,1,"やぶ"],[34,1,"しゅ"],[43,1,"み"],[49,1,"おお"],[55,1,"し"]],"text":"主はモーセに言われた、「下って行って民を戒めなさい。民が押し破って、主のところにきて、見ようとし、多くのものが死ぬことのないようにするためである。"},{"ref":"Exod.19.22","start":2019022,"end":2019022,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"ちか"],[5,2,"さいし"],[16,1,"み"],[27,1,"しゅ"],[29,1,"かれ"],[32,1,"う"]],"text":"主に近づく祭司たちにもまた、その身をきよめさせなさい。主が彼らを打つことのないようにするためである」。"},{"ref":"Exod.19.23","start":2019023,"end":2019023,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"い"],[11,1,"たみ"],[16,1,"さん"],[18,1,"のぼ"],[42,1,"いまし"],[46,1,"やま"],[52,1,"さかい"],[54,1,"もう"],[66,1,"い"]],"text":"モーセは主に言った、「民はシナイ山に登ることはできないでしょう。あなたがわたしたちを戒めて『山のまわりに境を設け、それをきよめよ』と言われたからです」。"},{"ref":"Exod.19.24","start":2019024,"end":2019024,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"い"],[10,1,"い"],[13,1,"くだ"],[27,1,"とも"],[29,1,"のぼ"],[41,2,"さいし"],[46,1,"たみ"],[50,1,"お"],[52,1,"やぶ"],[55,1,"しゅ"],[61,1,"のぼ"],[76,1,"しゅ"],[78,1,"かれ"],[81,1,"う"]],"text":"主は彼に言われた、「行け、下れ。そしてあなたはアロンと共に登ってきなさい。ただし、祭司たちと民とが、押し破って主のところに登ることのないようにしなさい。主が彼らを打つことのないようにするためである」。"},{"ref":"Exod.19.25","start":2019025,"end":2019025,"break":"none","ruby":[[4,1,"たみ"],[6,1,"ところ"],[8,1,"くだ"],[11,1,"い"],[14,1,"かれ"],[17,1,"つ"]],"text":"モーセは民の所に下って行って彼らに告げた。"}]