[{"ref":"Ps.26.1","start":19026001,"end":19026001,"break":"paragraph","title":"ダビデの歌","breaks":[[16,"line"],[26,"line"]],"ruby":[[0,1,"しゅ"],[20,2,"せいじつ"],[23,1,"あゆ"],[26,1,"まよ"],[32,1,"しゅ"],[34,2,"しんらい"]],"titleRuby":[[4,1,"うた"]],"text":"主よ、わたしをさばいてください。わたしは誠実に歩み、迷うことなく主に信頼しています。"},{"ref":"Ps.26.2","start":19026002,"end":19026002,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[15,1,"こころ"],[22,1,"こころ"],[24,1,"おも"],[28,1,"ね"]],"text":"主よ、わたしをためし、わたしを試み、わたしの心と思いとを練りきよめてください。"},{"ref":"Ps.26.3","start":19026003,"end":19026003,"break":"line","breaks":[[21,"line"]],"ruby":[[14,1,"め"],[16,1,"まえ"],[36,1,"あゆ"]],"text":"あなたのいつくしみはわたしの目の前にあり、わたしはあなたのまことによって歩みました。"},{"ref":"Ps.26.4","start":19026004,"end":19026004,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"いつわ"],[6,2,"ひとびと"],[9,1,"とも"],[16,3,"ぎぜんしゃ"],[20,1,"まじ"]],"text":"わたしは偽る人々と共にすわらず、偽善者と交わらず、"},{"ref":"Ps.26.5","start":19026005,"end":19026005,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"あく"],[2,1,"おこな"],[4,1,"もの"],[10,1,"にく"],[13,1,"あ"],[16,1,"もの"],[18,1,"とも"]],"text":"悪を行う者のつどいを憎み、悪しき者と共にすわることをしません。"},{"ref":"Ps.26.6","start":19026006,"end":19026006,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"て"],[9,1,"あら"],[13,1,"つみ"],[20,1,"しめ"],[27,2,"さいだん"]],"text":"主よ、わたしは手を洗って、罪のないことを示し、あなたの祭壇をめぐって、"},{"ref":"Ps.26.7","start":19026007,"end":19026007,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"かんしゃ"],[3,1,"うた"],[5,1,"こえ"],[6,1,"たか"],[31,1,"つた"]],"text":"感謝の歌を声高くうたい、あなたのくすしきみわざをことごとくのべ伝えます。"},{"ref":"Ps.26.8","start":19026008,"end":19026008,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"す"],[16,1,"いえ"],[23,2,"えいこう"],[30,1,"ところ"],[33,1,"あい"]],"text":"主よ、わたしはあなたの住まわれる家と、あなたの栄光のとどまる所とを愛します。"},{"ref":"Ps.26.9","start":19026009,"end":19026009,"break":"line","breaks":[[15,"line"],[34,"line"]],"ruby":[[8,1,"つみ"],[12,1,"とも"],[24,1,"ち"],[26,1,"なが"],[28,2,"ひとびと"],[31,1,"とも"],[34,1,"と"],[36,1,"さ"]],"text":"どうか、わたしを罪びとと共に、わたしのいのちを、血を流す人々と共に、取り去らないでください。"},{"ref":"Ps.26.10","start":19026010,"end":19026010,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[3,1,"て"],[6,1,"わる"],[8,1,"くわだ"],[14,1,"かれ"],[17,1,"みぎ"],[19,1,"て"],[27,1,"み"]],"text":"彼らの手には悪い企てがあり、彼らの右の手は、まいないで満ちています。"},{"ref":"Ps.26.11","start":19026011,"end":19026011,"break":"line","breaks":[[15,"line"]],"ruby":[[7,2,"せいじつ"],[10,1,"あゆ"]],"text":"しかしわたしは誠実に歩みます。わたしをあがない、わたしをあわれんでください。"},{"ref":"Ps.26.12","start":19026012,"end":19026012,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"あし"],[6,1,"たい"],[10,1,"ところ"],[12,1,"た"],[23,2,"かいしゅう"],[29,1,"しゅ"]],"text":"わたしの足は平らかな所に立っています。わたしは会衆のなかで主をたたえましょう。"}]