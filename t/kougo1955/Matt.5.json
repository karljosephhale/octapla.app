[{"ref":"Matt.5.1","start":40005001,"end":40005001,"break":"paragraph","ruby":[[6,2,"ぐんしゅう"],[9,1,"み"],[12,1,"やま"],[14,1,"のぼ"],[17,1,"ざ"],[25,2,"でし"],[34,2,"ちかよ"]],"text":"イエスはこの群衆を見て、山に登り、座につかれると、弟子たちがみもとに近寄ってきた。"},{"ref":"Matt.5.2","start":40005002,"end":40005002,"break":"none","ruby":[[8,1,"くち"],[10,1,"ひら"],[13,1,"かれ"],[16,1,"おし"],[19,1,"い"]],"text":"そこで、イエスは口を開き、彼らに教えて言われた。"},{"ref":"Matt.5.3","start":40005003,"end":40005003,"break":"stanza","breaks":[[21,"line"]],"ruby":[[5,1,"まず"],[8,1,"ひと"],[21,2,"てんごく"],[24,1,"かれ"]],"text":"「こころの貧しい人たちは、さいわいである、天国は彼らのものである。"},{"ref":"Matt.5.4","start":40005004,"end":40005004,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かな"],[6,1,"ひと"],[19,1,"かれ"],[22,1,"なぐさ"]],"text":"悲しんでいる人たちは、さいわいである、彼らは慰められるであろう。"},{"ref":"Matt.5.5","start":40005005,"end":40005005,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"にゅうわ"],[3,1,"ひと"],[16,1,"かれ"],[19,1,"ち"],[21,1,"う"]],"text":"柔和な人たちは、さいわいである、彼らは地を受けつぐであろう。"},{"ref":"Matt.5.6","start":40005006,"end":40005006,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"ぎ"],[2,1,"う"],[10,1,"ひと"],[23,1,"かれ"],[26,1,"あ"],[28,1,"た"]],"text":"義に飢えかわいている人たちは、さいわいである、彼らは飽き足りるようになるであろう。"},{"ref":"Matt.5.7","start":40005007,"end":40005007,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"ぶか"],[6,1,"ひと"],[19,1,"かれ"],[27,1,"う"]],"text":"あわれみ深い人たちは、さいわいである、彼らはあわれみを受けるであろう。"},{"ref":"Matt.5.8","start":40005008,"end":40005008,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"こころ"],[2,1,"きよ"],[4,1,"ひと"],[17,1,"かれ"],[20,1,"かみ"],[22,1,"み"]],"text":"心の清い人たちは、さいわいである、彼らは神を見るであろう。"},{"ref":"Matt.5.9","start":40005009,"end":40005009,"break":"line","breaks":[[21,"line"]],"ruby":[[0,2,"へいわ"],[6,1,"だ"],[8,1,"ひと"],[21,1,"かれ"],[24,1,"かみ"],[26,1,"こ"],[28,1,"よ"]],"text":"平和をつくり出す人たちは、さいわいである、彼らは神の子と呼ばれるであろう。"},{"ref":"Matt.5.10","start":40005010,"end":40005010,"break":"line","breaks":[[17,"line"],[25,"line"]],"ruby":[[0,1,"ぎ"],[5,2,"はくがい"],[12,1,"ひと"],[25,2,"てんごく"],[28,1,"かれ"]],"text":"義のために迫害されてきた人たちは、さいわいである、天国は彼らのものである。"},{"ref":"Matt.5.11","start":40005011,"end":40005011,"break":"none","ruby":[[7,2,"ひとびと"],[23,2,"はくがい"],[33,1,"たい"],[35,1,"いつわ"],[38,2,"さまざま"],[41,2,"あっこう"],[44,1,"い"],[46,1,"とき"]],"text":"わたしのために人々があなたがたをののしり、また迫害し、あなたがたに対し偽って様々の悪口を言う時には、あなたがたは、さいわいである。"},{"ref":"Matt.5.12","start":40005012,"end":40005012,"break":"none","ruby":[[0,1,"よろこ"],[8,1,"てん"],[19,1,"う"],[22,1,"むく"],[25,1,"おお"],[36,1,"まえ"],[38,3,"よげんしゃ"],[45,1,"おな"],[50,2,"はくがい"]],"text":"喜び、よろこべ、天においてあなたがたの受ける報いは大きい。あなたがたより前の預言者たちも、同じように迫害されたのである。"},{"ref":"Matt.5.13","start":40005013,"end":40005013,"break":"paragraph","ruby":[[7,1,"ち"],[9,1,"しお"],[16,1,"しお"],[29,1,"なに"],[36,1,"あじ"],[38,1,"と"],[55,1,"やく"],[58,1,"た"],[64,1,"そと"],[66,1,"す"],[72,2,"ひとびと"]],"text":"あなたがたは、地の塩である。もし塩のききめがなくなったら、何によってその味が取りもどされようか。もはや、なんの役にも立たず、ただ外に捨てられて、人々にふみつけられるだけである。"},{"ref":"Matt.5.14","start":40005014,"end":40005014,"break":"none","ruby":[[7,1,"よ"],[9,1,"ひかり"],[14,1,"やま"],[16,1,"うえ"],[20,1,"まち"],[22,1,"かく"]],"text":"あなたがたは、世の光である。山の上にある町は隠れることができない。"},{"ref":"Matt.5.15","start":40005015,"end":40005015,"break":"none","ruby":[[14,1,"ます"],[16,1,"した"],[20,1,"もの"],[29,2,"しょくだい"],[32,1,"うえ"],[38,1,"いえ"],[40,1,"なか"],[49,1,"てら"]],"text":"また、あかりをつけて、それを枡の下におく者はいない。むしろ燭台の上において、家の中のすべてのものを照させるのである。"},{"ref":"Matt.5.16","start":40005016,"end":40005016,"break":"none","ruby":[[12,1,"ひかり"],[14,2,"ひとびと"],[17,1,"まえ"],[19,1,"かがや"],[27,2,"ひとびと"],[43,1,"み"],[46,1,"てん"],[57,1,"ちち"]],"text":"そのように、あなたがたの光を人々の前に輝かし、そして、人々があなたがたのよいおこないを見て、天にいますあなたがたの父をあがめるようにしなさい。"},{"ref":"Matt.5.17","start":40005017,"end":40005017,"break":"paragraph","ruby":[[4,2,"りっぽう"],[7,3,"よげんしゃ"],[11,1,"はい"],[21,1,"おも"],[30,1,"はい"],[40,2,"じょうじゅ"]],"text":"わたしが律法や預言者を廃するためにきた、と思ってはならない。廃するためではなく、成就するためにきたのである。"},{"ref":"Matt.5.18","start":40005018,"end":40005018,"break":"none","ruby":[[2,1,"い"],[8,2,"てんち"],[11,1,"ほろ"],[13,1,"ゆ"],[19,2,"りっぽう"],[23,1,"てん"],[25,2,"いっかく"],[42,1,"まっと"]],"text":"よく言っておく。天地が滅び行くまでは、律法の一点、一画もすたることはなく、ことごとく全うされるのである。"},{"ref":"Matt.5.19","start":40005019,"end":40005019,"break":"none","ruby":[[10,1,"もっと"],[12,1,"ちい"],[24,1,"やぶ"],[36,1,"ひと"],[38,1,"おし"],[44,1,"もの"],[47,2,"てんごく"],[50,1,"もっと"],[52,1,"ちい"],[55,1,"もの"],[57,1,"よ"],[81,1,"おし"],[84,1,"もの"],[87,2,"てんごく"],[90,1,"おお"],[94,1,"もの"],[96,1,"よ"]],"text":"それだから、これらの最も小さいいましめの一つでも破り、またそうするように人に教えたりする者は、天国で最も小さい者と呼ばれるであろう。しかし、これをおこないまたそう教える者は、天国で大いなる者と呼ばれるであろう。"},{"ref":"Matt.5.20","start":40005020,"end":40005020,"break":"none","ruby":[[4,1,"い"],[16,1,"ぎ"],[18,2,"りっぽう"],[20,2,"がくしゃ"],[27,1,"びと"],[29,1,"ぎ"],[41,1,"けっ"],[44,2,"てんごく"]],"text":"わたしは言っておく。あなたがたの義が律法学者やパリサイ人の義にまさっていなければ、決して天国に、はいることはできない。"},{"ref":"Matt.5.21","start":40005021,"end":40005021,"break":"paragraph","ruby":[[0,1,"むかし"],[2,2,"ひとびと"],[6,1,"ころ"],[10,1,"ころ"],[12,1,"もの"],[14,2,"さいばん"],[17,1,"う"],[27,1,"い"],[43,1,"き"]],"text":"昔の人々に『殺すな。殺す者は裁判を受けねばならない』と言われていたことは、あなたがたの聞いているところである。"},{"ref":"Matt.5.22","start":40005022,"end":40005022,"break":"none","ruby":[[14,1,"い"],[17,2,"きょうだい"],[20,1,"たい"],[23,1,"いか"],[25,1,"もの"],[32,2,"さいばん"],[35,1,"う"],[44,2,"きょうだい"],[51,1,"おろ"],[53,1,"もの"],[55,1,"い"],[57,1,"もの"],[60,2,"ぎかい"],[63,1,"ひ"],[80,1,"もの"],[82,1,"い"],[84,1,"もの"],[87,2,"じごく"],[90,1,"ひ"],[92,1,"な"],[94,1,"こ"]],"text":"しかし、わたしはあなたがたに言う。兄弟に対して怒る者は、だれでも裁判を受けねばならない。兄弟にむかって愚か者と言う者は、議会に引きわたされるであろう。また、ばか者と言う者は、地獄の火に投げ込まれるであろう。"},{"ref":"Matt.5.23","start":40005023,"end":40005023,"break":"none","ruby":[[4,2,"さいだん"],[7,1,"そな"],[9,1,"もの"],[19,2,"ばあい"],[22,2,"きょうだい"],[25,2,"じぶん"],[28,1,"たい"],[31,1,"なに"],[50,1,"おも"],[52,1,"だ"]],"text":"だから、祭壇に供え物をささげようとする場合、兄弟が自分に対して何かうらみをいだいていることを、そこで思い出したなら、"},{"ref":"Matt.5.24","start":40005024,"end":40005024,"break":"none","ruby":[[2,1,"そな"],[4,1,"もの"],[6,2,"さいだん"],[9,1,"まえ"],[11,1,"のこ"],[19,1,"い"],[24,2,"きょうだい"],[27,2,"わかい"],[35,1,"かえ"],[41,1,"そな"],[43,1,"もの"]],"text":"その供え物を祭壇の前に残しておき、まず行ってその兄弟と和解し、それから帰ってきて、供え物をささげることにしなさい。"},{"ref":"Matt.5.25","start":40005025,"end":40005025,"break":"none","ruby":[[4,1,"うった"],[7,1,"もの"],[9,2,"いっしょ"],[12,1,"みち"],[14,1,"い"],[16,1,"とき"],[22,2,"とちゅう"],[25,1,"はや"],[27,2,"なかなお"],[45,1,"うった"],[48,1,"もの"],[54,3,"さいばんかん"],[62,3,"さいばんかん"],[66,2,"したやく"],[81,1,"ごく"],[83,1,"い"]],"text":"あなたを訴える者と一緒に道を行く時には、その途中で早く仲直りをしなさい。そうしないと、その訴える者はあなたを裁判官にわたし、裁判官は下役にわたし、そして、あなたは獄に入れられるであろう。"},{"ref":"Matt.5.26","start":40005026,"end":40005026,"break":"none","ruby":[[6,1,"い"],[12,2,"さいご"],[22,2,"しはら"],[33,1,"けっ"],[40,1,"で"]],"text":"よくあなたに言っておく。最後の一コドラントを支払ってしまうまでは、決してそこから出てくることはできない。"},{"ref":"Matt.5.27","start":40005027,"end":40005027,"break":"paragraph","ruby":[[1,2,"かんいん"],[8,1,"い"],[24,1,"き"]],"text":"『姦淫するな』と言われていたことは、あなたがたの聞いているところである。"},{"ref":"Matt.5.28","start":40005028,"end":40005028,"break":"none","ruby":[[14,1,"い"],[22,2,"じょうよく"],[29,1,"おんな"],[31,1,"み"],[33,1,"もの"],[36,1,"こころ"],[38,1,"なか"],[43,2,"かんいん"]],"text":"しかし、わたしはあなたがたに言う。だれでも、情欲をいだいて女を見る者は、心の中ですでに姦淫をしたのである。"},{"ref":"Matt.5.29","start":40005029,"end":40005029,"break":"none","ruby":[[6,1,"みぎ"],[8,1,"め"],[10,1,"つみ"],[12,1,"おか"],[22,1,"ぬ"],[24,1,"だ"],[27,1,"す"],[33,2,"ごたい"],[36,2,"いちぶ"],[39,1,"うしな"],[44,2,"ぜんしん"],[47,2,"じごく"],[50,1,"な"],[52,1,"い"],[58,1,"ほう"],[68,1,"えき"]],"text":"もしあなたの右の目が罪を犯させるなら、それを抜き出して捨てなさい。五体の一部を失っても、全身が地獄に投げ入れられない方が、あなたにとって益である。"},{"ref":"Matt.5.30","start":40005030,"end":40005030,"break":"none","ruby":[[6,1,"みぎ"],[8,1,"て"],[10,1,"つみ"],[12,1,"おか"],[22,1,"き"],[25,1,"す"],[31,2,"ごたい"],[34,2,"いちぶ"],[37,1,"うしな"],[42,2,"ぜんしん"],[45,2,"じごく"],[48,1,"お"],[50,1,"こ"],[54,1,"ほう"],[64,1,"えき"]],"text":"もしあなたの右の手が罪を犯させるなら、それを切って捨てなさい。五体の一部を失っても、全身が地獄に落ち込まない方が、あなたにとって益である。"},{"ref":"Matt.5.31","start":40005031,"end":40005031,"break":"none","ruby":[[3,1,"つま"],[5,1,"だ"],[7,1,"もの"],[9,2,"りえん"],[11,1,"じょう"],[13,1,"わた"],[17,1,"い"]],"text":"また『妻を出す者は離縁状を渡せ』と言われている。"},{"ref":"Matt.5.32","start":40005032,"end":40005032,"break":"none","ruby":[[14,1,"い"],[22,3,"ふひんこう"],[25,2,"いがい"],[28,2,"りゆう"],[31,2,"じぶん"],[34,1,"つま"],[36,1,"だ"],[38,1,"もの"],[41,2,"かんいん"],[44,1,"おこな"],[55,1,"だ"],[59,1,"おんな"],[64,1,"もの"],[67,2,"かんいん"],[70,1,"おこな"]],"text":"しかし、わたしはあなたがたに言う。だれでも、不品行以外の理由で自分の妻を出す者は、姦淫を行わせるのである。また出された女をめとる者も、姦淫を行うのである。"},{"ref":"Matt.5.33","start":40005033,"end":40005033,"break":"paragraph","ruby":[[2,1,"むかし"],[4,2,"ひとびと"],[12,1,"ちか"],[16,1,"ちか"],[26,1,"しゅ"],[28,1,"たい"],[31,1,"はた"],[35,1,"い"],[51,1,"き"]],"text":"また昔の人々に『いつわり誓うな、誓ったことは、すべて主に対して果せ』と言われていたことは、あなたがたの聞いているところである。"},{"ref":"Matt.5.34","start":40005034,"end":40005034,"break":"none","ruby":[[14,1,"い"],[21,1,"ちか"],[30,1,"てん"],[35,1,"ちか"],[42,1,"かみ"],[44,2,"みざ"]],"text":"しかし、わたしはあなたがたに言う。いっさい誓ってはならない。天をさして誓うな。そこは神の御座であるから。"},{"ref":"Matt.5.35","start":40005035,"end":40005035,"break":"none","ruby":[[2,1,"ち"],[7,1,"ちか"],[14,1,"かみ"],[16,1,"あし"],[17,1,"だい"],[35,1,"ちか"],[43,2,"だいおう"],[46,1,"みやこ"]],"text":"また地をさして誓うな。そこは神の足台であるから。またエルサレムをさして誓うな。それは『大王の都』であるから。"},{"ref":"Matt.5.36","start":40005036,"end":40005036,"break":"none","ruby":[[3,2,"じぶん"],[6,1,"あたま"],[11,1,"ちか"],[19,1,"かみ"],[21,1,"け"],[22,1,"ひと"],[28,1,"しろ"],[31,1,"くろ"]],"text":"また、自分の頭をさして誓うな。あなたは髪の毛一すじさえ、白くも黒くもすることができない。"},{"ref":"Matt.5.37","start":40005037,"end":40005037,"break":"none","ruby":[[6,2,"ことば"],[21,1,"いな"],[23,1,"いな"],[34,2,"いじょう"],[37,1,"で"],[43,1,"あく"],[46,1,"く"]],"text":"あなたがたの言葉は、ただ、しかり、しかり、否、否、であるべきだ。それ以上に出ることは、悪から来るのである。"},{"ref":"Matt.5.38","start":40005038,"end":40005038,"break":"paragraph","ruby":[[1,1,"め"],[4,1,"め"],[7,1,"は"],[10,1,"は"],[14,1,"い"],[30,1,"き"]],"text":"『目には目を、歯には歯を』と言われていたことは、あなたがたの聞いているところである。"},{"ref":"Matt.5.39","start":40005039,"end":40005039,"break":"none","ruby":[[14,1,"い"],[17,2,"あくにん"],[20,2,"てむ"],[37,1,"みぎ"],[39,1,"ほお"],[41,1,"う"],[49,1,"ほお"],[52,1,"む"]],"text":"しかし、わたしはあなたがたに言う。悪人に手向かうな。もし、だれかがあなたの右の頬を打つなら、ほかの頬をも向けてやりなさい。"},{"ref":"Matt.5.40","start":40005040,"end":40005040,"break":"none","ruby":[[4,1,"うった"],[8,2,"したぎ"],[11,1,"と"],[17,1,"もの"],[21,2,"うわぎ"],[25,1,"あた"]],"text":"あなたを訴えて、下着を取ろうとする者には、上着をも与えなさい。"},{"ref":"Matt.5.41","start":40005041,"end":40005041,"break":"none","ruby":[[19,1,"い"],[32,1,"ひと"],[34,1,"とも"],[40,1,"い"]],"text":"もし、だれかが、あなたをしいて一マイル行かせようとするなら、その人と共に二マイル行きなさい。"},{"ref":"Matt.5.42","start":40005042,"end":40005042,"break":"none","ruby":[[0,1,"もと"],[3,1,"もの"],[6,1,"あた"],[9,1,"か"],[16,1,"もの"],[18,1,"ことわ"]],"text":"求める者には与え、借りようとする者を断るな。"},{"ref":"Matt.5.43","start":40005043,"end":40005043,"break":"paragraph","ruby":[[1,1,"とな"],[3,1,"びと"],[5,1,"あい"],[8,1,"てき"],[10,1,"にく"],[14,1,"い"],[30,1,"き"]],"text":"『隣り人を愛し、敵を憎め』と言われていたことは、あなたがたの聞いているところである。"},{"ref":"Matt.5.44","start":40005044,"end":40005044,"break":"none","ruby":[[14,1,"い"],[17,1,"てき"],[19,1,"あい"],[22,2,"はくがい"],[26,1,"もの"],[31,1,"いの"]],"text":"しかし、わたしはあなたがたに言う。敵を愛し、迫害する者のために祈れ。"},{"ref":"Matt.5.45","start":40005045,"end":40005045,"break":"none","ruby":[[5,1,"てん"],[16,1,"ちち"],[18,1,"こ"],[28,1,"てん"],[30,1,"ちち"],[33,1,"わる"],[35,1,"もの"],[37,1,"うえ"],[40,1,"よ"],[42,1,"もの"],[44,1,"うえ"],[48,2,"たいよう"],[56,1,"ただ"],[59,1,"もの"],[62,1,"ただ"],[67,1,"もの"],[71,1,"あめ"],[73,1,"ふ"],[77,1,"くだ"]],"text":"こうして、天にいますあなたがたの父の子となるためである。天の父は、悪い者の上にも良い者の上にも、太陽をのぼらせ、正しい者にも正しくない者にも、雨を降らして下さるからである。"},{"ref":"Matt.5.46","start":40005046,"end":40005046,"break":"none","ruby":[[6,2,"じぶん"],[9,1,"あい"],[12,1,"もの"],[14,1,"あい"],[25,1,"むく"],[41,3,"しゅぜいにん"]],"text":"あなたがたが自分を愛する者を愛したからとて、なんの報いがあろうか。そのようなことは取税人でもするではないか。"},{"ref":"Matt.5.47","start":40005047,"end":40005047,"break":"none","ruby":[[0,2,"きょうだい"],[24,1,"こと"],[43,3,"いほうじん"]],"text":"兄弟だけにあいさつをしたからとて、なんのすぐれた事をしているだろうか。そのようなことは異邦人でもしているではないか。"},{"ref":"Matt.5.48","start":40005048,"end":40005048,"break":"none","ruby":[[12,1,"てん"],[14,1,"ちち"],[16,2,"かんぜん"],[33,2,"かんぜん"],[36,1,"もの"]],"text":"それだから、あなたがたの天の父が完全であられるように、あなたがたも完全な者となりなさい。"}]