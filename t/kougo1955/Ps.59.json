[{"ref":"Ps.59.1","start":19059001,"end":19059001,"break":"paragraph","title":"聖歌隊の指揮者によって、「滅ぼすな」というしらべにあわせてうたわせたダビデのミクタムの歌。これはサウルがダビデを殺そうとして人をつかわし、その家をうかがわせたときダビデのよんだもの","breaks":[[22,"line"]],"ruby":[[2,1,"かみ"],[14,1,"てき"],[17,1,"たす"],[19,1,"だ"],[26,1,"さか"],[30,1,"おこ"],[34,1,"もの"],[38,1,"まも"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[13,1,"ほろ"],[43,1,"うた"],[56,1,"ころ"],[62,1,"ひと"],[71,1,"いえ"]],"text":"わが神よ、どうかわたしをわが敵から助け出し、わたしに逆らって起りたつ者からお守りください。"},{"ref":"Ps.59.2","start":19059002,"end":19059002,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"あく"],[2,1,"おこな"],[4,1,"もの"],[11,1,"たす"],[13,1,"だ"],[16,1,"ち"],[18,1,"なが"],[20,1,"ひと"],[28,1,"すく"]],"text":"悪を行う者からわたしを助け出し、血を流す人からわたしをお救いください。"},{"ref":"Ps.59.3","start":19059003,"end":19059003,"break":"line","breaks":[[25,"line"],[46,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[18,1,"いのち"],[25,1,"ちから"],[28,2,"ひとびと"],[31,1,"とも"],[33,1,"あつ"],[41,1,"せ"],[46,1,"しゅ"],[56,1,"つみ"]],"text":"見よ、彼らはひそみかくれて、わたしの命をうかがい、力ある人々が共に集まってわたしを攻めます。主よ、わたしにとがも罪もなく、"},{"ref":"Ps.59.4","start":19059004,"end":19059004,"break":"line","breaks":[[14,"line"],[30,"line"]],"ruby":[[14,1,"かれ"],[17,1,"はし"],[23,1,"そな"],[34,1,"たす"],[40,1,"め"]],"text":"わたしにあやまちもないのに、彼らは走りまわって備えをします。わたしを助けるために目をさまして、ごらんください。"},{"ref":"Ps.59.5","start":19059005,"end":19059005,"break":"line","breaks":[[22,"line"],[40,"line"],[51,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[5,1,"しゅ"],[18,1,"かみ"],[22,1,"め"],[34,2,"くにたみ"],[37,1,"ばっ"],[40,1,"あく"],[46,1,"もの"],[56,1,"ほどこ"]],"text":"万軍の神、主よ、あなたはイスラエルの神です。目をさまして、もろもろの国民を罰し、悪をたくらむ者どもに、あわれみを施さないでください。〔セラ"},{"ref":"Ps.59.6","start":19059006,"end":19059006,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ゆう"],[7,1,"かえ"],[13,1,"いぬ"],[21,1,"まち"]],"text":"彼らは夕ごとに帰ってきて、犬のようにほえて町をあさりまわる。"},{"ref":"Ps.59.7","start":19059007,"end":19059007,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[8,1,"くち"],[15,1,"さけ"],[36,1,"き"],[43,1,"い"]],"text":"見よ、彼らはその口をもってほえ叫び、そのくちびるをもってうなり、「だれが聞くものか」と言う。"},{"ref":"Ps.59.8","start":19059008,"end":19059008,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"しゅ"],[11,1,"かれ"],[14,1,"わら"],[22,2,"くにたみ"],[29,1,"わら"]],"text":"しかし、主よ、あなたは彼らを笑い、もろもろの国民をあざけり笑われる。"},{"ref":"Ps.59.9","start":19059009,"end":19059009,"break":"line","breaks":[[24,"line"]],"ruby":[[2,1,"ちから"],[19,1,"うた"],[24,1,"かみ"],[35,1,"たか"]],"text":"わが力よ、わたしはあなたにむかってほめ歌います。神よ、あなたはわたしの高きやぐらです。"},{"ref":"Ps.59.10","start":19059010,"end":19059010,"break":"line","breaks":[[15,"line"],[25,"line"]],"ruby":[[2,1,"かみ"],[19,1,"むか"],[27,1,"かみ"],[33,1,"てき"],[35,2,"はいぼく"],[38,1,"み"]],"text":"わが神はそのいつくしみをもってわたしを迎えられる。わが神はわたしに敵の敗北を見させられる。"},{"ref":"Ps.59.11","start":19059011,"end":19059011,"break":"line","breaks":[[20,"line"],[33,"line"],[57,"line"]],"ruby":[[6,1,"たみ"],[8,1,"わす"],[20,1,"かれ"],[23,1,"ころ"],[33,1,"しゅ"],[39,1,"たて"],[43,1,"ちから"],[48,1,"かれ"],[57,1,"かれ"],[60,1,"たお"]],"text":"どうぞ、わが民の忘れることのないために、彼らを殺さないでください。主、われらの盾よ、み力をもって彼らをよろめかせ、彼らを倒れさせないでください。"},{"ref":"Ps.59.12","start":19059012,"end":19059012,"break":"line","breaks":[[20,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[3,1,"くち"],[5,1,"つみ"],[14,2,"ことば"],[20,1,"かれ"],[25,1,"たか"],[29,1,"とら"],[40,1,"かれ"],[43,1,"かた"],[49,1,"いつわ"]],"text":"彼らの口の罪、そのくちびるの言葉のために彼らをその高ぶりに捕われさせてください。彼らが語るのろいと偽りのために"},{"ref":"Ps.59.13","start":19059013,"end":19059013,"break":"line","breaks":[[13,"line"],[30,"line"],[42,"line"],[54,"line"],[71,"line"]],"ruby":[[0,1,"いきどお"],[6,1,"かれ"],[9,1,"ほろ"],[30,1,"かれ"],[33,1,"ほろ"],[47,1,"ち"],[54,2,"ひとびと"],[57,1,"かみ"],[63,1,"おさ"],[71,1,"し"],[74,1,"いた"]],"text":"憤りをもって彼らを滅ぼし、もはやながらえることのないまでに、彼らを滅ぼしてください。そうすれば地のはてまで、人々は神がヤコブを治められることを知るに至るでしょう。〔セラ"},{"ref":"Ps.59.14","start":19059014,"end":19059014,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ゆう"],[7,1,"かえ"],[13,1,"いぬ"],[21,1,"まち"]],"text":"彼らは夕ごとに帰ってきて、犬のようにほえて町をあさりまわる。"},{"ref":"Ps.59.15","start":19059015,"end":19059015,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"く"],[5,1,"もの"],[17,1,"あ"],[22,1,"え"],[27,1,"いか"]],"text":"彼らは食い物のためにあるきまわり、飽くことを得なければ怒りうなる。"},{"ref":"Ps.59.16","start":19059016,"end":19059016,"break":"line","breaks":[[19,"line"],[39,"line"],[63,"line"]],"ruby":[[13,1,"ちから"],[19,1,"あさ"],[22,1,"こえ"],[34,1,"うた"],[47,1,"なや"],[50,1,"ひ"],[54,1,"たか"],[67,1,"さ"],[69,1,"どころ"]],"text":"しかし、わたしはあなたのみ力をうたい、朝には声をあげてみいつくしみを歌います。あなたはわたしの悩みの日にわが高きやぐらとなり、わたしの避け所となられたからです。"},{"ref":"Ps.59.17","start":19059017,"end":19059017,"break":"line","breaks":[[25,"line"],[40,"line"]],"ruby":[[2,1,"ちから"],[25,1,"かみ"],[34,1,"たか"],[50,1,"たま"],[53,1,"かみ"]],"text":"わが力よ、わたしはあなたにむかってほめうたいます。神よ、あなたはわが高きやぐら、わたしにいつくしみを賜わる神であられるからです。"}]