[{"ref":"Isa.47.1","start":23047001,"end":23047001,"break":"paragraph","breaks":[[12,"line"],[25,"line"],[35,"line"],[46,"line"],[66,"line"]],"ruby":[[0,2,"しょじょ"],[9,1,"むすめ"],[12,1,"くだ"],[19,1,"なか"],[32,1,"むすめ"],[35,2,"おうざ"],[40,1,"ち"],[64,1,"おんな"]],"text":"処女なるバビロンの娘よ、下って、ちりの中にすわれ。カルデヤびとの娘よ、王座のない地にすわれ。あなたはもはや、やさしく、たおやかな女ととなえられることはない。"},{"ref":"Isa.47.2","start":23047002,"end":23047002,"break":"line","breaks":[[12,"line"],[29,"line"]],"ruby":[[0,1,"いし"],[7,1,"こな"],[12,1,"かお"],[17,1,"と"],[19,1,"さ"],[26,1,"ぬ"],[37,1,"かわ"],[39,1,"わた"]],"text":"石うすをとって粉をひけ、顔おおいを取り去り、うちぎを脱ぎ、すねをあらわして川を渡れ。"},{"ref":"Isa.47.3","start":23047003,"end":23047003,"break":"line","breaks":[[11,"line"],[22,"line"]],"ruby":[[4,1,"はだか"],[15,1,"はじ"],[17,1,"み"],[29,1,"むく"],[33,2,"なにび"],[38,1,"たす"]],"text":"あなたの裸はあらわれ、あなたの恥は見られる。わたしはあだを報いて、何人とをも助けない。"},{"ref":"Isa.47.4","start":23047004,"end":23047004,"break":"line","breaks":[[11,"line"],[23,"line"]],"ruby":[[9,1,"もの"],[13,1,"な"],[15,2,"ばんぐん"],[18,1,"しゅ"],[29,2,"せいじゃ"]],"text":"われわれをあがなう者はその名を万軍の主といい、イスラエルの聖者である。"},{"ref":"Isa.47.5","start":23047005,"end":23047005,"break":"line","breaks":[[10,"line"],[27,"line"],[45,"line"]],"ruby":[[7,1,"むすめ"],[10,1,"もく"],[19,1,"くら"],[21,1,"ところ"],[40,1,"くに"],[42,2,"じょおう"]],"text":"カルデヤびとの娘よ、黙してすわれ、また暗い所にはいれ。あなたはもはや、もろもろの国の女王ととなえられることはない。"},{"ref":"Isa.47.6","start":23047006,"end":23047006,"break":"line","breaks":[[11,"line"],[33,"line"],[50,"line"]],"ruby":[[6,1,"たみ"],[8,1,"いきどお"],[13,1,"し"],[14,1,"ぎょう"],[16,1,"けが"],[27,1,"て"],[29,1,"わた"],[46,1,"ほどこ"],[50,2,"としお"],[54,1,"もの"],[56,1,"うえ"],[63,1,"おも"],[69,1,"お"]],"text":"わたしはわが民を憤り、わが嗣業を汚して、これをあなたの手に渡した。あなたはこれに、あわれみを施さず、年老いた者の上に、はなはだ重いくびきを負わせた。"},{"ref":"Isa.47.7","start":23047007,"end":23047007,"break":"line","breaks":[[8,"line"],[27,"line"],[47,"line"]],"ruby":[[4,1,"い"],[19,2,"じょおう"],[39,1,"こと"],[41,1,"こころ"],[51,1,"おわ"],[54,1,"おも"]],"text":"あなたは言った、「わたしは、とこしえに女王となる」と。そして、あなたはこれらの事を心にとめず、またその終りを思わなかった。"},{"ref":"Isa.47.8","start":23047008,"end":23047008,"break":"paragraph","breaks":[[15,"line"],[30,"line"],[43,"line"],[58,"line"],[76,"line"]],"ruby":[[0,1,"たの"],[8,1,"やす"],[15,1,"こころ"],[47,2,"かふ"],[60,1,"こ"],[62,1,"うしな"],[71,1,"い"],[73,1,"もの"],[76,1,"いま"],[79,1,"こと"],[81,1,"き"]],"text":"楽しみにふけり、安らかにおり、心のうちに「ただわたしだけで、わたしのほかにだれもなく、わたしは寡婦となることはない、また子を失うことはない」と言う者よ、今この事を聞け。"},{"ref":"Isa.47.9","start":23047009,"end":23047009,"break":"line","breaks":[[16,"line"],[29,"line"],[45,"line"],[61,"line"],[76,"line"]],"ruby":[[7,1,"こと"],[10,1,"にち"],[26,1,"のぞ"],[33,1,"こ"],[35,1,"うしな"],[38,2,"かふ"],[43,1,"こと"],[52,1,"おお"],[55,2,"まじゅつ"],[58,1,"おこな"],[61,2,"まほう"],[64,1,"おお"],[68,1,"ちから"],[85,1,"のぞ"]],"text":"これらの二つの事は一日のうちに、またたくまにあなたに臨む。すなわち子を失い、寡婦となる事はたといあなたが多くの魔術を行い、魔法の大いなる力をもってしてもことごとくあなたに臨む。"},{"ref":"Isa.47.10","start":23047010,"end":23047010,"break":"line","breaks":[[17,"line"],[31,"line"],[47,"line"],[56,"line"],[69,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"あく"],[9,1,"よ"],[11,1,"たよ"],[14,1,"い"],[22,1,"み"],[24,1,"もの"],[35,2,"ちえ"],[43,2,"ちしき"],[51,1,"まど"],[60,1,"こころ"],[65,1,"い"]],"text":"あなたは自分の悪に寄り頼んで言う、「わたしを見る者はない」と。あなたの知恵と、あなたの知識とはあなたを惑わした。あなたは心のうちに言った、「ただわたしだけで、わたしのほかにだれもない」と。"},{"ref":"Isa.47.11","start":23047011,"end":23047011,"break":"line","breaks":[[17,"line"],[37,"line"],[49,"line"],[69,"line"],[84,"line"]],"ruby":[[14,1,"のぞ"],[46,1,"おそ"],[69,1,"ほろ"],[81,1,"のぞ"],[95,1,"なに"],[97,1,"し"]],"text":"しかし、わざわいが、あなたに臨む、あなたは、それをあがなうことができない。なやみが、あなたを襲う、あなたは、それをつぐなうことができない。滅びが、にわかにあなたに臨む、あなたは、それについて何も知らない。"},{"ref":"Isa.47.12","start":23047012,"end":23047012,"break":"line","breaks":[[22,"line"],[41,"line"],[56,"line"]],"ruby":[[4,1,"わか"],[6,1,"とき"],[9,1,"つと"],[11,1,"い"],[18,2,"まほう"],[22,1,"おお"],[25,2,"まじゅつ"],[32,1,"た"],[45,2,"せいこう"],[60,1,"てき"],[62,1,"おそ"]],"text":"あなたが若い時から勤め行ったあなたの魔法と、多くの魔術とをもって立ちむかってみよ、あるいは成功するかもしれない、あるいは敵を恐れさせるかもしれない。"},{"ref":"Isa.47.13","start":23047013,"end":23047013,"break":"line","breaks":[[21,"line"],[36,"line"],[56,"line"]],"ruby":[[4,1,"おお"],[7,1,"はか"],[17,1,"つか"],[23,1,"てん"],[25,1,"わ"],[28,1,"もの"],[30,1,"ほし"],[32,1,"み"],[34,1,"もの"],[36,2,"しんげつ"],[47,1,"のぞ"],[49,1,"こと"],[51,1,"つ"],[54,1,"もの"],[56,1,"た"],[68,1,"すく"]],"text":"あなたは多くの計りごとによってうみ疲れた。かの天を分かつ者、星を見る者、新月によって、あなたに臨む事を告げる者を立ちあがらせて、あなたを救わせてみよ。"},{"ref":"Isa.47.14","start":23047014,"end":23047014,"break":"line","breaks":[[16,"line"],[25,"line"],[49,"line"],[65,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[16,1,"ひ"],[18,1,"や"],[20,1,"ほろ"],[25,2,"じぶん"],[28,1,"み"],[30,1,"ほのお"],[32,1,"いきお"],[37,1,"すく"],[39,1,"だ"],[51,1,"ひ"],[53,1,"み"],[55,1,"あたた"],[58,2,"すみび"],[69,1,"まえ"],[76,1,"ひ"]],"text":"見よ、彼らはわらのようになって、火に焼き滅ぼされ、自分の身を炎の勢いから、救い出すことができない。その火は身を暖める炭火ではない、またその前にすわるべき火でもない。"},{"ref":"Isa.47.15","start":23047015,"end":23047015,"break":"line","breaks":[[14,"line"],[37,"line"],[48,"line"],[68,"line"]],"ruby":[[4,1,"つと"],[7,1,"おこな"],[18,1,"わか"],[20,1,"とき"],[27,1,"う"],[29,1,"か"],[33,1,"もの"],[48,1,"かれ"],[55,2,"じぶん"],[58,2,"ほうこう"],[76,1,"すく"],[78,1,"もの"]],"text":"あなたが勤めて行ったものと、あなたの若い時からあなたと売り買いした者とは、ついにこのようになる。彼らはめいめい自分の方向にさすらいゆき、ひとりもあなたを救う者はない。"}]