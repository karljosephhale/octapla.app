[{"ref":"Luke.6.1","start":42006001,"end":42006001,"break":"paragraph","ruby":[[2,3,"あんそくにち"],[10,2,"むぎばたけ"],[13,1,"なか"],[19,1,"い"],[26,2,"でし"],[31,1,"ほ"],[36,1,"て"],[43,1,"た"]],"text":"ある安息日にイエスが麦畑の中をとおって行かれたとき、弟子たちが穂をつみ、手でもみながら食べていた。"},{"ref":"Luke.6.2","start":42006002,"end":42006002,"break":"none","ruby":[[10,1,"びと"],[14,1,"い"],[28,3,"あんそくにち"]],"text":"すると、あるパリサイ人たちが言った、「あなたがたはなぜ、安息日にしてはならぬことをするのか」。"},{"ref":"Luke.6.3","start":42006003,"end":42006003,"break":"none","ruby":[[7,1,"こた"],[10,1,"い"],[29,1,"とも"],[31,1,"もの"],[36,1,"う"],[57,1,"よ"]],"text":"そこでイエスが答えて言われた、「あなたがたは、ダビデとその供の者たちとが飢えていたとき、ダビデのしたことについて、読んだことがないのか。"},{"ref":"Luke.6.4","start":42006004,"end":42006004,"break":"none","ruby":[[5,1,"かみ"],[7,1,"いえ"],[14,2,"さいし"],[24,1,"た"],[31,1,"そな"],[37,1,"と"],[40,1,"た"],[45,1,"とも"],[47,1,"もの"],[52,1,"あた"]],"text":"すなわち、神の家にはいって、祭司たちのほかだれも食べてはならぬ供えのパンを取って食べ、また供の者たちにも与えたではないか」。"},{"ref":"Luke.6.5","start":42006005,"end":42006005,"break":"none","ruby":[[2,1,"かれ"],[5,1,"い"],[11,1,"ひと"],[13,1,"こ"],[15,3,"あんそくにち"],[19,1,"しゅ"]],"text":"また彼らに言われた、「人の子は安息日の主である」。"},{"ref":"Luke.6.6","start":42006006,"end":42006006,"break":"paragraph","ruby":[[6,3,"あんそくにち"],[10,2,"かいどう"],[17,1,"おし"],[31,2,"みぎて"],[37,1,"ひと"]],"text":"また、ほかの安息日に会堂にはいって教えておられたところ、そこに右手のなえた人がいた。"},{"ref":"Luke.6.7","start":42006007,"end":42006007,"break":"none","ruby":[[0,2,"りっぽう"],[2,2,"がくしゃ"],[9,1,"びと"],[18,1,"うった"],[21,2,"こうじつ"],[24,2,"みつ"],[30,1,"おも"],[34,3,"あんそくにち"]],"text":"律法学者やパリサイ人たちは、イエスを訴える口実を見付けようと思って、安息日にいやされるかどうかをうかがっていた。"},{"ref":"Luke.6.8","start":42006008,"end":42006008,"break":"none","ruby":[[4,1,"かれ"],[7,1,"おも"],[15,1,"し"],[21,1,"て"],[26,1,"ひと"],[30,1,"お"],[36,1,"なか"],[38,1,"た"],[45,1,"い"],[51,1,"お"],[53,1,"あ"],[57,1,"た"]],"text":"イエスは彼らの思っていることを知って、その手のなえた人に、「起きて、まん中に立ちなさい」と言われると、起き上がって立った。"},{"ref":"Luke.6.9","start":42006009,"end":42006009,"break":"none","ruby":[[7,1,"かれ"],[14,1,"い"],[26,1,"き"],[30,3,"あんそくにち"],[34,1,"ぜん"],[36,1,"おこな"],[40,1,"あく"],[42,1,"おこな"],[47,1,"いのち"],[49,1,"すく"],[53,1,"ころ"]],"text":"そこでイエスは彼らにむかって言われた、「あなたがたに聞くが、安息日に善を行うのと悪を行うのと、命を救うのと殺すのと、どちらがよいか」。"},{"ref":"Luke.6.10","start":42006010,"end":42006010,"break":"none","ruby":[[3,1,"かれ"],[5,2,"いちどう"],[8,1,"み"],[16,1,"ひと"],[19,1,"て"],[21,1,"の"],[29,1,"い"],[46,1,"て"],[48,1,"もと"]],"text":"そして彼ら一同を見まわして、その人に「手を伸ばしなさい」と言われた。そのとおりにすると、その手は元どおりになった。"},{"ref":"Luke.6.11","start":42006011,"end":42006011,"break":"none","ruby":[[3,1,"かれ"],[6,1,"はげ"],[9,1,"いか"],[27,1,"たがい"],[29,2,"はなしあ"]],"text":"そこで彼らは激しく怒って、イエスをどうかしてやろうと、互に話合いをはじめた。"},{"ref":"Luke.6.12","start":42006012,"end":42006012,"break":"paragraph","ruby":[[9,1,"いの"],[14,1,"やま"],[16,1,"い"],[19,1,"よ"],[21,1,"てっ"],[24,1,"かみ"],[26,1,"いの"]],"text":"このころ、イエスは祈るために山へ行き、夜を徹して神に祈られた。"},{"ref":"Luke.6.13","start":42006013,"end":42006013,"break":"none","ruby":[[0,1,"よ"],[2,1,"あ"],[7,2,"でし"],[12,1,"よ"],[14,1,"よ"],[19,1,"なか"],[24,1,"にん"],[26,1,"えら"],[28,1,"だ"],[34,2,"しと"],[39,1,"な"],[42,1,"あた"]],"text":"夜が明けると、弟子たちを呼び寄せ、その中から十二人を選び出し、これに使徒という名をお与えになった。"},{"ref":"Luke.6.14","start":42006014,"end":42006014,"break":"none","ruby":[[10,1,"よ"],[20,2,"きょうだい"]],"text":"すなわち、ペテロとも呼ばれたシモンとその兄弟アンデレ、ヤコブとヨハネ、ピリポとバルトロマイ、"},{"ref":"Luke.6.15","start":42006015,"end":42006015,"break":"none","ruby":[[13,1,"こ"],[19,2,"ねっしん"],[21,1,"とう"],[23,1,"よ"]],"text":"マタイとトマス、アルパヨの子ヤコブと、熱心党と呼ばれたシモン、"},{"ref":"Luke.6.16","start":42006016,"end":42006016,"break":"none","ruby":[[4,1,"こ"],[27,3,"うらぎりもの"]],"text":"ヤコブの子ユダ、それからイスカリオテのユダ。このユダが裏切者となったのである。"},{"ref":"Luke.6.17","start":42006017,"end":42006017,"break":"none","ruby":[[8,1,"かれ"],[11,2,"いっしょ"],[14,1,"やま"],[16,1,"くだ"],[19,2,"ひらち"],[22,1,"た"],[28,1,"おお"],[32,2,"でし"],[41,2,"ぜんど"],[57,2,"かいがん"],[59,2,"ちほう"],[66,1,"だい"],[67,2,"ぐんしゅう"]],"text":"そして、イエスは彼らと一緒に山を下って平地に立たれたが、大ぜいの弟子たちや、ユダヤ全土、エルサレム、ツロとシドンの海岸地方などからの大群衆が、"},{"ref":"Luke.6.18","start":42006018,"end":42006018,"break":"none","ruby":[[0,1,"おしえ"],[2,1,"き"],[10,2,"びょうき"],[36,1,"けが"],[39,1,"れい"],[41,1,"なや"],[48,1,"もの"]],"text":"教を聞こうとし、また病気をなおしてもらおうとして、そこにきていた。そして汚れた霊に悩まされている者たちも、いやされた。"},{"ref":"Luke.6.19","start":42006019,"end":42006019,"break":"none","ruby":[[2,2,"ぐんしゅう"],[14,1,"つと"],[21,1,"ちから"],[27,1,"うち"],[30,1,"で"],[37,1,"もの"],[39,2,"つぎつぎ"]],"text":"また群衆はイエスにさわろうと努めた。それは力がイエスの内から出て、みんなの者を次々にいやしたからである。"},{"ref":"Luke.6.20","start":42006020,"end":42006020,"break":"none","breaks":[[26,"stanza"],[46,"line"]],"ruby":[[9,1,"め"],[14,2,"でし"],[19,1,"み"],[21,1,"い"],[32,1,"まず"],[35,1,"ひと"],[46,1,"かみ"],[48,1,"くに"]],"text":"そのとき、イエスは目をあげ、弟子たちを見て言われた、「あなたがた貧しい人たちは、さいわいだ。神の国はあなたがたのものである。"},{"ref":"Luke.6.21","start":42006021,"end":42006021,"break":"line","breaks":[[23,"line"],[39,"line"],[62,"line"]],"ruby":[[7,1,"う"],[12,1,"ひと"],[23,1,"あ"],[25,1,"た"],[46,1,"な"],[51,1,"ひと"],[62,1,"わら"]],"text":"あなたがたいま飢えている人たちは、さいわいだ。飽き足りるようになるからである。あなたがたいま泣いている人たちは、さいわいだ。笑うようになるからである。"},{"ref":"Luke.6.22","start":42006022,"end":42006022,"break":"line","ruby":[[0,2,"ひとびと"],[9,1,"にく"],[16,1,"ひと"],[18,1,"こ"],[29,2,"はいせき"],[38,2,"おめい"],[41,1,"き"]],"text":"人々があなたがたを憎むとき、また人の子のためにあなたがたを排斥し、ののしり、汚名を着せるときは、あなたがたはさいわいだ。"},{"ref":"Luke.6.23","start":42006023,"end":42006023,"break":"line","ruby":[[2,1,"ひ"],[5,1,"よろこ"],[11,1,"み"],[14,1,"てん"],[25,1,"う"],[28,1,"むく"],[31,1,"おお"],[39,1,"かれ"],[42,2,"そせん"],[46,3,"よげんしゃ"],[52,1,"たい"],[55,1,"おな"]],"text":"その日には喜びおどれ。見よ、天においてあなたがたの受ける報いは大きいのだから。彼らの祖先も、預言者たちに対して同じことをしたのである。"},{"ref":"Luke.6.24","start":42006024,"end":42006024,"break":"line","breaks":[[24,"line"]],"ruby":[[8,1,"と"],[13,1,"ひと"],[24,1,"なぐさ"],[27,1,"う"]],"text":"しかしあなたがた富んでいる人たちは、わざわいだ。慰めを受けてしまっているからである。"},{"ref":"Luke.6.25","start":42006025,"end":42006025,"break":"line","breaks":[[23,"line"],[37,"line"]],"ruby":[[5,1,"いま"],[6,2,"まんぷく"],[12,1,"ひと"],[23,1,"う"],[42,1,"いま"],[43,1,"わら"],[48,1,"ひと"],[59,1,"かな"],[62,1,"な"]],"text":"あなたがた今満腹している人たちは、わざわいだ。飢えるようになるからである。あなたがた今笑っている人たちは、わざわいだ。悲しみ泣くようになるからである。"},{"ref":"Luke.6.26","start":42006026,"end":42006026,"break":"line","ruby":[[0,1,"ひと"],[2,1,"みな"],[28,1,"かれ"],[31,2,"そせん"],[37,3,"よげんしゃ"],[43,1,"たい"],[46,1,"おな"]],"text":"人が皆あなたがたをほめるときは、あなたがたはわざわいだ。彼らの祖先も、にせ預言者たちに対して同じことをしたのである。"},{"ref":"Luke.6.27","start":42006027,"end":42006027,"break":"none","ruby":[[4,1,"き"],[15,1,"い"],[18,1,"てき"],[20,1,"あい"],[23,1,"にく"],[25,1,"もの"],[27,2,"しんせつ"]],"text":"しかし、聞いているあなたがたに言う。敵を愛し、憎む者に親切にせよ。"},{"ref":"Luke.6.28","start":42006028,"end":42006028,"break":"none","ruby":[[3,1,"もの"],[5,2,"しゅくふく"],[15,1,"もの"],[20,1,"いの"]],"text":"のろう者を祝福し、はずかしめる者のために祈れ。"},{"ref":"Luke.6.29","start":42006029,"end":42006029,"break":"none","ruby":[[4,1,"ほお"],[6,1,"う"],[8,1,"もの"],[14,1,"ほお"],[17,1,"む"],[27,2,"うわぎ"],[30,1,"うば"],[32,1,"と"],[34,1,"もの"],[37,2,"したぎ"],[41,1,"こば"]],"text":"あなたの頬を打つ者にはほかの頬をも向けてやり、あなたの上着を奪い取る者には下着をも拒むな。"},{"ref":"Luke.6.30","start":42006030,"end":42006030,"break":"none","ruby":[[4,1,"もと"],[7,1,"もの"],[10,1,"あた"],[20,1,"も"],[22,1,"もの"],[24,1,"うば"],[26,1,"もの"],[30,1,"と"]],"text":"あなたに求める者には与えてやり、あなたの持ち物を奪う者からは取りもどそうとするな。"},{"ref":"Luke.6.31","start":42006031,"end":42006031,"break":"none","ruby":[[0,2,"ひとびと"],[16,1,"のぞ"],[22,2,"ひとびと"]],"text":"人々にしてほしいと、あなたがたの望むことを、人々にもそのとおりにせよ。"},{"ref":"Luke.6.32","start":42006032,"end":42006032,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"あい"],[9,1,"もの"],[11,1,"あい"],[24,2,"てがら"],[32,2,"つみびと"],[38,2,"じぶん"],[41,1,"あい"],[47,1,"もの"],[49,1,"あい"]],"text":"自分を愛してくれる者を愛したからとて、どれほどの手柄になろうか。罪人でさえ、自分を愛してくれる者を愛している。"},{"ref":"Luke.6.33","start":42006033,"end":42006033,"break":"none","ruby":[[0,2,"じぶん"],[10,1,"もの"],[24,2,"てがら"],[32,2,"つみびと"],[44,1,"こと"]],"text":"自分によくしてくれる者によくしたとて、どれほどの手柄になろうか。罪人でさえ、それくらいの事はしている。"},{"ref":"Luke.6.34","start":42006034,"end":42006034,"break":"none","ruby":[[2,1,"かえ"],[12,1,"か"],[23,2,"てがら"],[31,2,"つみびと"],[36,1,"おな"],[44,1,"かえ"],[55,2,"なかま"],[58,1,"か"]],"text":"また返してもらうつもりで貸したとて、どれほどの手柄になろうか。罪人でも、同じだけのものを返してもらおうとして、仲間に貸すのである。"},{"ref":"Luke.6.35","start":42006035,"end":42006035,"break":"none","ruby":[[11,1,"てき"],[13,1,"あい"],[16,1,"ひと"],[27,1,"なに"],[29,1,"あ"],[36,1,"か"],[47,1,"う"],[50,1,"むく"],[53,1,"おお"],[65,1,"たか"],[67,1,"もの"],[69,1,"こ"],[80,1,"たか"],[82,1,"もの"],[85,1,"おん"],[87,1,"し"],[90,1,"もの"],[93,2,"あくにん"],[101,1,"ぶか"]],"text":"しかし、あなたがたは、敵を愛し、人によくしてやり、また何も当てにしないで貸してやれ。そうすれば受ける報いは大きく、あなたがたはいと高き者の子となるであろう。いと高き者は、恩を知らぬ者にも悪人にも、なさけ深いからである。"},{"ref":"Luke.6.36","start":42006036,"end":42006036,"break":"none","ruby":[[6,1,"ちち"],[9,1,"かみ"],[11,2,"じひ"],[13,1,"ぶか"],[25,2,"じひ"],[27,1,"ぶか"],[29,1,"もの"]],"text":"あなたがたの父なる神が慈悲深いように、あなたがたも慈悲深い者となれ。"},{"ref":"Luke.6.37","start":42006037,"end":42006037,"break":"none","ruby":[[0,1,"ひと"],[13,2,"じぶん"],[33,1,"ひと"],[35,1,"つみ"],[37,1,"さだ"],[48,2,"じぶん"],[51,1,"つみ"],[53,1,"さだ"],[81,2,"じぶん"]],"text":"人をさばくな。そうすれば、自分もさばかれることがないであろう。また人を罪に定めるな。そうすれば、自分も罪に定められることがないであろう。ゆるしてやれ。そうすれば、自分もゆるされるであろう。"},{"ref":"Luke.6.38","start":42006038,"end":42006038,"break":"none","ruby":[[0,1,"あた"],[10,2,"じぶん"],[14,1,"あた"],[24,2,"ひとびと"],[29,1,"い"],[35,1,"い"],[41,1,"で"],[46,1,"りょう"],[64,1,"い"],[81,1,"はか"],[85,1,"はか"],[89,2,"じぶん"],[93,1,"はか"]],"text":"与えよ。そうすれば、自分にも与えられるであろう。人々はおし入れ、ゆすり入れ、あふれ出るまでに量をよくして、あなたがたのふところに入れてくれるであろう。あなたがたの量るその量りで、自分にも量りかえされるであろうから」。"},{"ref":"Luke.6.39","start":42006039,"end":42006039,"break":"paragraph","ruby":[[9,1,"たとえ"],[11,1,"かた"],[17,2,"もうじん"],[20,2,"もうじん"],[23,2,"てびき"],[37,1,"あな"],[39,1,"お"],[41,1,"こ"]],"text":"イエスはまた一つの譬を語られた、「盲人は盲人の手引ができようか。ふたりとも穴に落ち込まないだろうか。"},{"ref":"Luke.6.40","start":42006040,"end":42006040,"break":"none","ruby":[[0,2,"でし"],[5,1,"し"],[6,2,"いじょう"],[17,2,"しゅうぎょう"],[28,1,"し"]],"text":"弟子はその師以上のものではないが、修業をつめば、みなその師のようになろう。"},{"ref":"Luke.6.41","start":42006041,"end":42006041,"break":"none","ruby":[[3,2,"きょうだい"],[6,1,"め"],[13,1,"み"],[18,2,"じぶん"],[21,1,"め"],[25,1,"はり"],[27,1,"みと"]],"text":"なぜ、兄弟の目にあるちりを見ながら、自分の目にある梁を認めないのか。"},{"ref":"Luke.6.42","start":42006042,"end":42006042,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"め"],[7,1,"はり"],[9,1,"み"],[20,2,"きょうだい"],[28,2,"きょうだい"],[36,1,"め"],[43,1,"と"],[53,1,"い"],[59,3,"ぎぜんしゃ"],[66,2,"じぶん"],[69,1,"め"],[72,1,"はり"],[74,1,"と"],[93,1,"み"],[103,2,"きょうだい"],[106,1,"め"],[113,1,"と"]],"text":"自分の目にある梁は見ないでいて、どうして兄弟にむかって、兄弟よ、あなたの目にあるちりを取らせてください、と言えようか。偽善者よ、まず自分の目から梁を取りのけるがよい、そうすれば、はっきり見えるようになって、兄弟の目にあるちりを取りのけることができるだろう。"},{"ref":"Luke.6.43","start":42006043,"end":42006043,"break":"none","ruby":[[0,1,"わる"],[2,1,"み"],[6,1,"よ"],[8,1,"き"],[16,1,"よ"],[18,1,"み"],[22,1,"わる"],[24,1,"き"]],"text":"悪い実のなる良い木はないし、また良い実のなる悪い木もない。"},{"ref":"Luke.6.44","start":42006044,"end":42006044,"break":"none","ruby":[[0,1,"き"],[9,1,"み"],[25,1,"と"],[34,1,"の"],[43,1,"つ"]],"text":"木はそれぞれ、その実でわかる。いばらからいちじくを取ることはないし、野ばらからぶどうを摘むこともない。"},{"ref":"Luke.6.45","start":42006045,"end":42006045,"break":"none","ruby":[[0,2,"ぜんにん"],[3,1,"よ"],[5,1,"こころ"],[7,1,"くら"],[10,1,"よ"],[12,1,"もの"],[14,1,"と"],[16,1,"だ"],[19,2,"あくにん"],[22,1,"わる"],[24,1,"くら"],[27,1,"わる"],[29,1,"もの"],[31,1,"と"],[33,1,"だ"],[36,1,"こころ"],[42,1,"で"],[48,1,"くち"],[50,1,"かた"]],"text":"善人は良い心の倉から良い物を取り出し、悪人は悪い倉から悪い物を取り出す。心からあふれ出ることを、口が語るものである。"},{"ref":"Luke.6.46","start":42006046,"end":42006046,"break":"paragraph","ruby":[[4,1,"しゅ"],[7,1,"しゅ"],[11,1,"よ"],[23,1,"い"],[28,1,"おこな"]],"text":"わたしを主よ、主よ、と呼びながら、なぜわたしの言うことを行わないのか。"},{"ref":"Luke.6.47","start":42006047,"end":42006047,"break":"none","ruby":[[14,2,"ことば"],[17,1,"き"],[20,1,"おこな"],[22,1,"もの"],[25,1,"なに"],[27,1,"に"],[39,1,"おし"]],"text":"わたしのもとにきて、わたしの言葉を聞いて行う者が、何に似ているか、あなたがたに教えよう。"},{"ref":"Luke.6.48","start":42006048,"end":42006048,"break":"none","ruby":[[4,1,"ち"],[6,1,"ふか"],[8,1,"ほ"],[11,1,"いわ"],[13,1,"うえ"],[15,2,"どだい"],[21,1,"いえ"],[23,1,"た"],[26,1,"ひと"],[28,1,"に"],[33,2,"こうずい"],[36,1,"で"],[38,2,"げきりゅう"],[43,1,"いえ"],[45,1,"お"],[47,1,"よ"],[57,1,"ゆ"],[59,1,"うご"],[72,1,"た"]],"text":"それは、地を深く掘り、岩の上に土台をすえて家を建てる人に似ている。洪水が出て激流がその家に押し寄せてきても、それを揺り動かすことはできない。よく建ててあるからである。"},{"ref":"Luke.6.49","start":42006049,"end":42006049,"break":"none","ruby":[[3,1,"き"],[7,1,"おこな"],[11,1,"ひと"],[14,2,"どだい"],[20,1,"つち"],[22,1,"うえ"],[24,1,"いえ"],[26,1,"た"],[29,1,"ひと"],[31,1,"に"],[36,2,"げきりゅう"],[41,1,"いえ"],[43,1,"お"],[45,1,"よ"],[56,1,"たお"],[65,2,"ひがい"],[68,1,"おお"]],"text":"しかし聞いても行わない人は、土台なしで、土の上に家を建てた人に似ている。激流がその家に押し寄せてきたら、たちまち倒れてしまい、その被害は大きいのである」。"}]