[{"ref":"1Sam.20.1","start":9020001,"end":9020001,"break":"paragraph","ruby":[[12,1,"に"],[23,1,"い"],[32,1,"なに"],[41,1,"わる"],[53,1,"ちち"],[55,1,"まえ"],[60,1,"つみ"],[62,1,"おか"],[72,1,"ころ"]],"text":"ダビデはラマのナヨテから逃げてきて、ヨナタンに言った、「わたしが何をし、どのような悪いことがあり、あなたの父の前にどんな罪を犯したので、わたしを殺そうとされるのでしょうか」。"},{"ref":"1Sam.20.2","start":9020002,"end":9020002,"break":"none","ruby":[[5,1,"かれ"],[7,1,"い"],[12,1,"けっ"],[15,1,"ころ"],[28,1,"ちち"],[30,1,"こと"],[32,2,"だいしょう"],[35,1,"と"],[43,1,"つ"],[63,1,"ちち"],[71,1,"こと"],[73,1,"かく"]],"text":"ヨナタンは彼に言った、「決して殺されることはありません。父は事の大小を問わず、わたしに告げないですることはありません。どうして父がわたしにその事を隠しましょう。そのようなことはありません」。"},{"ref":"1Sam.20.3","start":9020003,"end":9020003,"break":"none","ruby":[[7,1,"こた"],[16,1,"ちち"],[27,2,"こうい"],[39,1,"し"],[57,1,"かな"],[72,1,"し"],[83,1,"おも"],[98,1,"しゅ"],[100,1,"い"],[111,1,"たましい"],[113,1,"い"],[124,1,"し"],[127,1,"あいだ"],[133,1,"ぽ"]],"text":"しかしダビデは答えた、「あなたの父は、わたしがあなたの好意をえていることをよく知っておられます。それで『ヨナタンが悲しむことのないように、これを知らせないでおこう』と思っておられるのです。しかし、主は生きておられ、あなたの魂は生きています。わたしと死との間は、ただ一歩です」。"},{"ref":"1Sam.20.4","start":9020004,"end":9020004,"break":"none","ruby":[[9,1,"い"],[18,1,"い"]],"text":"ヨナタンはダビデに言った、「あなたが言われることはなんでもします」。"},{"ref":"1Sam.20.5","start":9020005,"end":9020005,"break":"none","ruby":[[9,1,"い"],[31,1,"おう"],[33,2,"いっしょ"],[36,2,"しょくじ"],[57,1,"い"],[62,1,"か"],[63,1,"め"],[65,2,"ゆうがた"],[70,2,"のはら"],[73,1,"かく"],[79,1,"ゆる"]],"text":"ダビデはヨナタンに言った、「あすは、ついたちですから、わたしは王と一緒に食事をしなければなりません。しかしわたしを行かせて三日目の夕方まで、野原に隠れることを許してください。"},{"ref":"1Sam.20.6","start":9020006,"end":9020006,"break":"none","ruby":[[6,1,"ちち"],[15,1,"たず"],[26,1,"とき"],[28,1,"い"],[46,1,"まち"],[53,1,"いそ"],[56,1,"い"],[61,1,"ゆる"],[78,1,"もと"],[87,2,"ぜんか"],[90,1,"とし"],[91,1,"まつり"]],"text":"もしあなたの父がわたしのことを尋ねられるならば、その時、言ってください、『ダビデはふるさとの町ベツレヘムへ急いで行くことを許してくださいと、しきりにわたしに求めました。そこで全家の年祭があるからです』。"},{"ref":"1Sam.20.7","start":9020007,"end":9020007,"break":"none","ruby":[[2,1,"かれ"],[5,1,"よ"],[9,1,"い"],[20,2,"あんぜん"],[26,1,"いか"],[37,1,"がい"],[39,1,"くわ"],[42,2,"けっしん"],[51,1,"し"]],"text":"もし彼が「良し」と言われるなら、しもべは安全ですが、怒られるなら、わたしに害を加える決心でおられるのを知ってください。"},{"ref":"1Sam.20.8","start":9020008,"end":9020008,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"まえ"],[14,2,"けいやく"],[17,1,"むす"],[44,1,"ほどこ"],[62,1,"わる"],[76,1,"みずか"],[82,1,"ころ"],[98,1,"ちち"],[107,1,"ひ"]],"text":"あなたは、主の前で、しもべと契約を結んでくださいました。それでどうぞしもべにいつくしみを施してください。しかし、もしわたしに悪いことがあるならば、あなた自らわたしを殺してください。どうしてあなたの父のもとへわたしを引いていかなければならないでしょう」。"},{"ref":"1Sam.20.9","start":9020009,"end":9020009,"break":"none","ruby":[[5,1,"い"],[18,1,"けっ"],[27,1,"ちち"],[33,1,"がい"],[35,1,"くわ"],[38,2,"けっしん"],[73,1,"つ"]],"text":"ヨナタンは言った、「そのようなことは決してありません。父があなたに害を加える決心をしていることがわたしにわかっているならば、わたしはそれをあなたに告げないでおきましょうか」。"},{"ref":"1Sam.20.10","start":9020010,"end":9020010,"break":"none","ruby":[[9,1,"い"],[18,1,"ちち"],[20,2,"あらあら"],[28,1,"こた"],[33,1,"とき"],[42,1,"つ"]],"text":"ダビデはヨナタンに言った、「あなたの父が荒々しくあなたに答えられる時、だれがわたしに告げるでしょうか」。"},{"ref":"1Sam.20.11","start":9020011,"end":9020011,"break":"none","ruby":[[9,1,"い"],[17,2,"のはら"],[20,1,"で"],[35,2,"のはら"],[38,1,"で"],[40,1,"い"]],"text":"ヨナタンはダビデに言った、「さあ、野原へ出ていこう」。こうしてふたりは野原へ出て行った。"},{"ref":"1Sam.20.12","start":9020012,"end":9020012,"break":"paragraph","ruby":[[12,1,"い"],[23,1,"かみ"],[25,1,"しゅ"],[28,2,"しょうにん"],[33,2,"みょうにち"],[36,3,"みょうごにち"],[40,1,"いま"],[48,1,"ちち"],[50,1,"こころ"],[52,1,"さぐ"],[56,1,"ちち"],[62,1,"たい"],[65,1,"よ"],[69,1,"み"],[74,1,"ひと"],[85,1,"し"]],"text":"そしてヨナタンはダビデに言った、「イスラエルの神、主が、証人です。明日か明後日の今ごろ、わたしが父の心を探って、父がダビデに対して良いのを見ながら、人をつかわしてあなたに知らせないようなことをするでしょうか。"},{"ref":"1Sam.20.13","start":9020013,"end":9020013,"break":"none","ruby":[[6,1,"ちち"],[12,1,"がい"],[14,1,"くわ"],[19,1,"おも"],[34,1,"し"],[43,1,"に"],[48,2,"あんぜん"],[51,1,"さ"],[60,1,"しゅ"],[66,2,"いくえ"],[78,1,"ばっ"],[89,1,"しゅ"],[91,1,"ちち"],[93,1,"とも"],[107,1,"とも"]],"text":"しかし、もし父があなたに害を加えようと思っているのに、それをあなたに知らせず、あなたを逃がして、安全に去らせないならば、主よ、どうぞ幾重にも、このヨナタンを罰してください。どうぞ主が父と共におられたように、あなたと共におられますように。"},{"ref":"1Sam.20.14","start":9020014,"end":9020014,"break":"none","ruby":[[8,1,"い"],[21,1,"しゅ"],[33,1,"ほどこ"],[36,1,"し"],[38,1,"まぬか"]],"text":"もしわたしがなお生きながらえているならば、主のいつくしみをわたしに施し、死を免れさせてください。"},{"ref":"1Sam.20.15","start":9020015,"end":9020015,"break":"none","ruby":[[6,1,"いえ"],[10,1,"なが"],[33,1,"しゅ"],[39,1,"てき"],[46,1,"ち"],[53,1,"た"],[55,1,"ほろ"],[60,1,"とき"]],"text":"またわたしの家をも、長くあなたのいつくしみにあずからせてください。主がダビデの敵をことごとく地のおもてから断ち滅ぼされる時、"},{"ref":"1Sam.20.16","start":9020016,"end":9020016,"break":"none","ruby":[[5,1,"な"],[11,1,"いえ"],[14,1,"た"],[28,1,"しゅ"],[34,1,"てき"],[40,1,"かえ"]],"text":"ヨナタンの名をダビデの家から絶やさないでください。どうぞ主がダビデの敵に、あだを返されるように」。"},{"ref":"1Sam.20.17","start":9020017,"end":9020017,"break":"none","ruby":[[8,1,"かさ"],[15,1,"ちか"],[20,1,"かれ"],[22,1,"あい"],[36,2,"じぶん"],[39,1,"いのち"],[44,1,"かれ"],[46,1,"あい"]],"text":"そしてヨナタンは重ねてダビデに誓わせた。彼を愛したからである。ヨナタンは自分の命のように彼を愛していた。"},{"ref":"1Sam.20.18","start":9020018,"end":9020018,"break":"paragraph","ruby":[[9,1,"い"],[28,1,"せき"],[45,1,"たず"]],"text":"ヨナタンはダビデに言った、「あすはついたちです。あなたの席があいているので、どうしたのかと尋ねられるでしょう。"},{"ref":"1Sam.20.19","start":9020019,"end":9020019,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[10,1,"たず"],[22,1,"さき"],[28,1,"かく"],[31,2,"ばしょ"],[34,1,"い"],[38,1,"む"],[42,2,"いしづか"]],"text":"三日目には、きびしく尋ねられるでしょうから、先にあなたが隠れた場所へ行って、向こうの石塚のかたわらにいてください。"},{"ref":"1Sam.20.20","start":9020020,"end":9020020,"break":"none","ruby":[[4,1,"まと"],[6,1,"い"],[14,1,"や"],[17,1,"ほん"],[24,1,"はな"]],"text":"わたしは的を射るようにして、矢を三本、そのそばに放ちます。"},{"ref":"1Sam.20.21","start":9020021,"end":9020021,"break":"none","ruby":[[5,1,"い"],[8,1,"や"],[10,1,"さが"],[19,1,"い"],[22,2,"こども"],[38,2,"こども"],[43,1,"や"],[45,2,"てまえ"],[54,1,"と"],[63,1,"い"],[71,1,"とき"],[83,1,"しゅ"],[85,1,"い"],[100,2,"あんぜん"],[104,1,"なに"],[106,2,"きけん"]],"text":"そして、『行って矢を捜してきなさい』と言って子供をつかわしましょう。わたしが子供に、『矢は手前にある。それを取ってきなさい』と言うならば、その時あなたはきてください。主が生きておられるように、あなたは安全で、何も危険がないからです。"},{"ref":"1Sam.20.22","start":9020022,"end":9020022,"break":"none","ruby":[[9,1,"こ"],[10,1,"とも"],[14,1,"や"],[16,1,"む"],[24,1,"い"],[32,1,"とき"],[38,1,"さ"],[41,1,"い"],[47,1,"しゅ"],[53,1,"さ"]],"text":"しかしわたしがその子供に、『矢は向こうにある』と言うならば、その時、あなたは去って行きなさい。主があなたを去らせられるのです。"},{"ref":"1Sam.20.23","start":9020023,"end":9020023,"break":"none","ruby":[[9,1,"はな"],[14,1,"こと"],[21,1,"しゅ"],[23,1,"つね"],[34,1,"あいだ"]],"text":"あなたとわたしとで話しあった事については、主が常にあなたとわたしとの間におられます」。"},{"ref":"1Sam.20.24","start":9020024,"end":9020024,"break":"paragraph","ruby":[[7,2,"のはら"],[10,1,"み"],[12,1,"かく"],[30,1,"おう"],[32,2,"しょくじ"],[39,1,"せき"],[41,1,"つ"]],"text":"そこでダビデは野原に身を隠した。さて、ついたちになったので、王は食事をするため席に着いた。"},{"ref":"1Sam.20.25","start":9020025,"end":9020025,"break":"none","ruby":[[0,1,"おう"],[9,1,"かべ"],[10,1,"よ"],[13,1,"せき"],[15,1,"つ"],[25,1,"む"],[28,1,"がわ"],[30,1,"せき"],[32,1,"つ"],[44,1,"よこ"],[46,1,"せき"],[48,1,"つ"],[57,2,"ばしょ"]],"text":"王はいつものように壁寄りに席に着き、ヨナタンはその向かい側の席に着き、アブネルはサウルの横の席に着いたが、ダビデの場所にはだれもいなかった。"},{"ref":"1Sam.20.26","start":9020026,"end":9020026,"break":"paragraph","ruby":[[6,1,"ひ"],[11,1,"なに"],[13,1,"い"],[21,1,"かれ"],[23,1,"なに"],[25,1,"た"],[28,1,"けが"],[39,1,"けが"],[51,1,"おも"]],"text":"ところがその日サウルは何も言わなかった、「彼に何か起って汚れたのだろう。きっと汚れたのにちがいない」と思ったからである。"},{"ref":"1Sam.20.27","start":9020027,"end":9020027,"break":"none","ruby":[[7,1,"め"],[18,1,"あ"],[21,1,"ひ"],[28,2,"ばしょ"],[46,1,"こ"],[52,1,"い"],[66,1,"こ"],[77,2,"しょくじ"]],"text":"しかし、ふつか目すなわち、ついたちの明くる日も、ダビデの場所はあいていたので、サウルは、その子ヨナタンに言った、「どうしてエッサイの子は、きのうもきょうも食事にこないのか」。"},{"ref":"1Sam.20.28","start":9020028,"end":9020028,"break":"none","ruby":[[9,1,"こた"],[25,1,"い"],[30,1,"ゆる"],[47,1,"もと"]],"text":"ヨナタンはサウルに答えた、「ダビデは、ベツレヘムへ行くことを許してくださいと、しきりにわたしに求めました。"},{"ref":"1Sam.20.29","start":9020029,"end":9020029,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[13,1,"い"],[27,2,"いちぞく"],[30,1,"まち"],[32,1,"まつり"],[39,1,"あに"],[45,1,"く"],[51,1,"めい"],[67,1,"まえ"],[69,1,"めぐ"],[72,1,"え"],[87,1,"い"],[92,1,"ゆる"],[95,2,"きょうだい"],[100,1,"あ"],[113,1,"かれ"],[115,1,"おう"],[117,2,"しょくたく"]],"text":"彼は言いました、『わたしに行かせてください。われわれの一族が町で祭をするので、兄がわたしに来るようにと命じました。それでもし、あなたの前に恵みを得ますならば、どうぞ、わたしに行くことを許し、兄弟たちに会わせてください』。それで彼は王の食卓にこなかったのです」。"},{"ref":"1Sam.20.30","start":9020030,"end":9020030,"break":"paragraph","ruby":[[2,1,"とき"],[16,1,"いか"],[19,1,"はっ"],[22,1,"かれ"],[24,1,"い"],[33,1,"こころ"],[35,1,"まが"],[42,1,"おんな"],[44,1,"う"],[47,1,"こ"],[59,1,"こ"],[61,1,"えら"],[65,2,"じぶん"],[68,1,"み"],[78,1,"はは"],[80,1,"み"],[97,1,"し"],[102,1,"おも"]],"text":"その時サウルはヨナタンにむかって怒りを発し、彼に言った、「あなたは心の曲った、そむく女の産んだ子だ。あなたがエッサイの子を選んで、自分の身をはずかしめ、また母の身をはずかしめていることをわたしが知らないと思うのか。"},{"ref":"1Sam.20.31","start":9020031,"end":9020031,"break":"none","ruby":[[5,1,"こ"],[9,1,"よ"],[11,1,"い"],[20,1,"あいだ"],[32,2,"おうこく"],[35,1,"かた"],[37,1,"た"],[54,1,"いま"],[56,1,"ひと"],[64,1,"かれ"],[73,1,"つ"],[83,1,"かれ"],[85,1,"かなら"],[87,1,"し"]],"text":"エッサイの子がこの世に生きながらえている間は、あなたも、あなたの王国も堅く立っていくことはできない。それゆえ今、人をつかわして、彼をわたしのもとに連れてこさせなさい。彼は必ず死ななければならない」。"},{"ref":"1Sam.20.32","start":9020032,"end":9020032,"break":"none","ruby":[[5,1,"ちち"],[10,1,"こた"],[19,1,"かれ"],[21,1,"ころ"],[37,1,"かれ"],[39,1,"なに"]],"text":"ヨナタンは父サウルに答えた、「どうして彼は殺されなければならないのですか。彼は何をしたのですか」。"},{"ref":"1Sam.20.33","start":9020033,"end":9020033,"break":"none","ruby":[[13,1,"う"],[23,1,"かれ"],[25,1,"む"],[29,1,"ふ"],[31,1,"あ"],[42,1,"ちち"],[48,1,"ころ"],[53,1,"こころ"],[55,1,"き"],[62,1,"し"]],"text":"ところがサウルはヨナタンを撃とうとして、やりを彼に向かって振り上げたので、ヨナタンは父がダビデを殺そうと、心に決めているのを知った。"},{"ref":"1Sam.20.34","start":9020034,"end":9020034,"break":"none","ruby":[[5,1,"はげ"],[8,1,"いか"],[11,1,"せき"],[13,1,"た"],[18,1,"つき"],[25,2,"しょくじ"],[34,1,"ちち"],[56,1,"うれ"]],"text":"ヨナタンは激しく怒って席を立ち、その月のふつかには食事をしなかった。父がダビデをはずかしめたので、ダビデのために憂えたからである。"},{"ref":"1Sam.20.35","start":9020035,"end":9020035,"break":"paragraph","ruby":[[3,1,"あさ"],[15,1,"ちい"],[18,2,"こども"],[21,1,"つ"],[29,1,"う"],[31,1,"あ"],[38,2,"のはら"],[41,1,"で"],[43,1,"い"]],"text":"あくる朝、ヨナタンは、ひとりの小さい子供を連れて、ダビデと打ち合わせたように野原に出て行った。"},{"ref":"1Sam.20.36","start":9020036,"end":9020036,"break":"none","ruby":[[5,1,"こ"],[6,1,"とも"],[8,1,"い"],[13,1,"はし"],[16,1,"い"],[24,1,"い"],[26,1,"や"],[28,1,"さが"],[35,2,"こども"],[38,1,"はし"],[41,1,"い"],[43,1,"あいだ"],[51,1,"や"],[53,1,"かれ"],[55,1,"まえ"],[57,1,"ほう"],[59,1,"はな"]],"text":"そしてその子供に言った、「走って行って、わたしの射る矢を捜しなさい」。子供が走って行く間に、ヨナタンは矢を彼の前の方に放った。"},{"ref":"1Sam.20.37","start":9020037,"end":9020037,"break":"none","ruby":[[3,2,"こども"],[12,1,"はな"],[15,1,"や"],[21,1,"い"],[24,1,"とき"],[31,2,"こども"],[39,1,"よ"],[46,1,"や"],[48,1,"む"],[61,1,"い"]],"text":"そして子供が、ヨナタンの放った矢のところへ行った時、ヨナタンは子供のうしろから呼ばわって、「矢は向こうにあるではないか」と言った。"},{"ref":"1Sam.20.38","start":9020038,"end":9020038,"break":"none","ruby":[[10,1,"こ"],[11,1,"とも"],[18,1,"よ"],[23,1,"い"],[28,1,"はや"],[33,1,"いそ"],[45,1,"こ"],[46,1,"とも"],[48,1,"や"],[50,1,"ひろ"],[52,1,"あつ"],[55,2,"しゅじん"]],"text":"ヨナタンはまた、その子供のうしろから呼ばわって言った、「早くせよ、急げ。とどまるな」。その子供は矢を拾い集めて主人ヨナタンのもとにきた。"},{"ref":"1Sam.20.39","start":9020039,"end":9020039,"break":"none","ruby":[[3,2,"こども"],[6,1,"なに"],[8,1,"し"],[28,1,"し"]],"text":"しかし子供は何も知らず、ヨナタンとダビデだけがそのことを知っていた。"},{"ref":"1Sam.20.40","start":9020040,"end":9020040,"break":"none","ruby":[[5,2,"じぶん"],[8,2,"ぶき"],[13,1,"こ"],[14,1,"とも"],[16,1,"わた"],[19,1,"い"],[31,1,"まち"],[33,1,"はこ"],[36,1,"い"]],"text":"ヨナタンは自分の武器をその子供に渡して言った、「あなたはこれを町へ運んで行きなさい」。"},{"ref":"1Sam.20.41","start":9020041,"end":9020041,"break":"none","ruby":[[0,2,"こども"],[3,1,"い"],[14,2,"いしづか"],[26,1,"た"],[31,1,"ち"],[35,1,"ふ"],[39,1,"ど"],[40,2,"けいれい"],[53,1,"たがい"],[55,1,"くち"],[60,1,"たがい"],[62,1,"な"],[73,1,"こころ"],[75,1,"お"],[77,1,"つ"]],"text":"子供が行ってしまうとダビデは石塚のかたわらをはなれて立ちいで、地にひれ伏して三度敬礼した。そして、ふたりは互に口づけし、互に泣いた。やがてダビデは心が落ち着いた。"},{"ref":"1Sam.20.42","start":9020042,"end":9020042,"break":"none","ruby":[[2,1,"とき"],[12,1,"い"],[17,2,"ぶじ"],[20,1,"い"],[36,1,"しゅ"],[38,1,"つね"],[48,1,"あいだ"],[61,2,"しそん"],[68,2,"しそん"],[71,1,"あいだ"],[79,1,"い"],[83,1,"しゅ"],[85,1,"な"],[90,1,"ちか"],[106,1,"た"],[108,1,"さ"],[116,1,"まち"]],"text":"その時ヨナタンはダビデに言った、「無事に行きなさい。われわれふたりは、『主が常にわたしとあなたの間におられ、また、わたしの子孫とあなたの子孫の間におられる』と言って、主の名をさして誓ったのです」。こうしてダビデは立ち去り、ヨナタンは町にはいった。"}]