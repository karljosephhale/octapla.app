[{"ref":"Ps.67.1","start":19067001,"end":19067001,"break":"paragraph","title":"聖歌隊の指揮者によって琴にあわせてうたわせた歌、さんび","breaks":[[23,"line"]],"ruby":[[4,1,"かみ"],[19,2,"しゅくふく"],[26,1,"かお"],[32,1,"うえ"],[34,1,"てら"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[11,1,"こと"],[22,1,"うた"]],"text":"どうか、神がわれらをあわれみ、われらを祝福し、そのみ顔をわれらの上に照されるように。〔セラ"},{"ref":"Ps.67.2","start":19067002,"end":19067002,"break":"line","breaks":[[19,"line"],[38,"line"]],"ruby":[[7,1,"みち"],[13,1,"ち"],[15,1,"し"],[23,1,"すくい"],[25,1,"ちから"],[32,2,"くにたみ"],[38,1,"し"]],"text":"これはあなたの道があまねく地に知られ、あなたの救の力がもろもろの国民のうちに知られるためです。"},{"ref":"Ps.67.3","start":19067003,"end":19067003,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[3,1,"たみ"],[23,1,"たみ"]],"text":"神よ、民らにあなたをほめたたえさせ、もろもろの民にあなたをほめたたえさせてください。"},{"ref":"Ps.67.4","start":19067004,"end":19067004,"break":"line","breaks":[[13,"line"],[26,"line"],[47,"line"]],"ruby":[[5,2,"くにたみ"],[8,1,"たの"],[15,1,"よろこ"],[17,1,"うた"],[30,2,"こうへい"],[41,1,"たみ"],[47,1,"ち"],[49,1,"うえ"],[57,2,"くにたみ"],[60,1,"みちび"]],"text":"もろもろの国民を楽しませ、また喜び歌わせてください。あなたは公平をもってもろもろの民をさばき、地の上なるもろもろの国民を導かれるからです。〔セラ"},{"ref":"Ps.67.5","start":19067005,"end":19067005,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[3,1,"たみ"],[23,1,"たみ"]],"text":"神よ、民らにあなたをほめたたえさせ、もろもろの民にあなたをほめたたえさせてください。"},{"ref":"Ps.67.6","start":19067006,"end":19067006,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ち"],[4,2,"さんぶつ"],[7,1,"だ"],[13,1,"かみ"],[19,1,"かみ"],[25,2,"しゅくふく"]],"text":"地はその産物を出しました。神、われらの神はわれらを祝福されました。"},{"ref":"Ps.67.7","start":19067007,"end":19067007,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[0,1,"かみ"],[6,2,"しゅくふく"],[14,1,"ち"],[29,1,"かみ"],[31,1,"おそ"]],"text":"神はわれらを祝福されました。地のもろもろのはてにことごとく神を恐れさせてください。"}]