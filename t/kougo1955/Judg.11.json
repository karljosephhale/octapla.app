[{"ref":"Judg.11.1","start":7011001,"end":7011001,"break":"paragraph","ruby":[[12,1,"つよ"],[14,2,"ゆうし"],[21,2,"ゆうじょ"],[24,1,"こ"],[31,1,"ちち"]],"text":"さてギレアデびとエフタは強い勇士であったが遊女の子で、エフタの父はギレアデであった。"},{"ref":"Judg.11.2","start":7011002,"end":7011002,"break":"none","ruby":[[5,1,"つま"],[7,2,"こども"],[10,1,"う"],[17,1,"つま"],[19,2,"こども"],[24,2,"せいちょう"],[31,1,"かれ"],[38,1,"お"],[40,1,"だ"],[43,1,"かれ"],[45,1,"い"],[57,1,"おんな"],[59,1,"う"],[62,1,"こ"],[73,1,"ちち"],[75,1,"いえ"],[77,1,"つ"]],"text":"ギレアデの妻も子供を産んだが、その妻の子供たちが成長したとき、彼らはエフタを追い出して彼に言った、「あなたはほかの女の産んだ子だから、わたしたちの父の家を継ぐことはできません」。"},{"ref":"Judg.11.3","start":7011003,"end":7011003,"break":"none","ruby":[[9,2,"きょうだい"],[18,1,"に"],[20,1,"さ"],[27,1,"ち"],[29,1,"す"],[39,1,"もの"],[48,1,"あつ"],[55,1,"かれ"],[57,2,"いっしょ"],[60,1,"で"],[64,2,"りゃくだつ"],[67,1,"こと"]],"text":"それでエフタはその兄弟たちのもとから逃げ去って、トブの地に住んでいると、やくざ者がエフタのもとに集まってきて、彼と一緒に出かけて略奪を事としていた。"},{"ref":"Judg.11.4","start":7011004,"end":7011004,"break":"paragraph","ruby":[[0,1,"ひ"],[5,1,"のち"],[12,2,"ひとびと"],[21,1,"たたか"]],"text":"日がたって後、アンモンの人々はイスラエルと戦うことになり、"},{"ref":"Judg.11.5","start":7011005,"end":7011005,"break":"none","ruby":[[5,2,"ひとびと"],[14,1,"たたか"],[25,2,"ちょうろう"],[30,1,"い"],[40,1,"ち"],[43,1,"つ"]],"text":"アンモンの人々がイスラエルと戦ったとき、ギレアデの長老たちは行ってエフタをトブの地から連れてこようとして、"},{"ref":"Judg.11.6","start":7011006,"end":7011006,"break":"none","ruby":[[4,1,"い"],[18,2,"たいしょう"],[45,2,"ひとびと"],[48,1,"たたか"]],"text":"エフタに言った、「きて、わたしたちの大将になってください。そうすればわたしたちはアンモンの人々と戦うことができます」。"},{"ref":"Judg.11.7","start":7011007,"end":7011007,"break":"none","ruby":[[9,2,"ちょうろう"],[14,1,"い"],[29,1,"にく"],[37,1,"ちち"],[39,1,"いえ"],[42,1,"お"],[44,1,"だ"],[60,1,"いま"],[67,1,"こま"],[72,1,"とき"],[86,1,"く"]],"text":"エフタはギレアデの長老たちに言った、「あなたがたはわたしを憎んで、わたしの父の家から追い出したではありませんか。しかるに今あなたがたが困っている時とはいえ、わたしのところに来るとはどういうわけですか」。"},{"ref":"Judg.11.8","start":7011008,"end":7011008,"break":"none","ruby":[[5,2,"ちょうろう"],[14,1,"い"],[28,1,"いま"],[34,1,"かえ"],[51,2,"いっしょ"],[54,1,"い"],[63,2,"ひとびと"],[66,1,"たたか"],[88,1,"す"]],"text":"ギレアデの長老たちはエフタに言った、「それでわたしたちは今、あなたに帰ったのです。どうぞ、わたしたちと一緒に行って、アンモンの人々と戦ってください。そしてわたしたちとギレアデに住んでいるすべてのものとのかしらになってください」。"},{"ref":"Judg.11.9","start":7011009,"end":7011009,"break":"none","ruby":[[9,2,"ちょうろう"],[14,1,"い"],[35,1,"かえ"],[44,2,"ひとびと"],[47,1,"たたか"],[54,1,"しゅ"],[56,1,"かれ"]],"text":"エフタはギレアデの長老たちに言った、「もしあなたがたが、わたしをつれて帰って、アンモンの人々と戦わせるとき、主が彼らをわたしにわたされるならば、わたしはあなたがたのかしらとなりましょう」。"},{"ref":"Judg.11.10","start":7011010,"end":7011010,"break":"none","ruby":[[5,2,"ちょうろう"],[14,1,"い"],[19,1,"しゅ"],[31,1,"あいだ"],[33,2,"しょうにん"],[44,1,"かなら"],[50,1,"い"]],"text":"ギレアデの長老たちはエフタに言った、「主はあなたとわたしたちの間の証人です。わたしたちは必ずあなたの言われるとおりにしましょう」。"},{"ref":"Judg.11.11","start":7011011,"end":7011011,"break":"none","ruby":[[12,2,"ちょうろう"],[17,2,"いっしょ"],[20,1,"い"],[24,1,"たみ"],[26,1,"かれ"],[28,1,"た"],[31,2,"じぶん"],[42,2,"たいしょう"],[60,2,"じぶん"],[63,2,"ことば"],[71,1,"しゅ"],[73,1,"まえ"],[75,1,"の"]],"text":"そこでエフタはギレアデの長老たちと一緒に行った。民は彼を立てて自分たちのかしらとし、大将とした。それでエフタはミヅパで、自分の言葉をことごとく主の前に述べた。"},{"ref":"Judg.11.12","start":7011012,"end":7011012,"break":"paragraph","ruby":[[12,2,"ひとびと"],[15,1,"おう"],[17,2,"ししゃ"],[25,1,"い"],[58,1,"せ"],[68,1,"くに"],[70,1,"たたか"]],"text":"かくてエフタはアンモンの人々の王に使者をつかわして言った、「あなたはわたしとなんのかかわりがあって、わたしのところへ攻めてきて、わたしの国と戦おうとするのですか」。"},{"ref":"Judg.11.13","start":7011013,"end":7011013,"break":"none","ruby":[[5,2,"ひとびと"],[8,1,"おう"],[14,2,"ししゃ"],[17,1,"こた"],[22,1,"むかし"],[36,1,"のぼ"],[54,1,"およ"],[64,1,"およ"],[70,1,"くに"],[72,1,"うば"],[74,1,"と"],[86,1,"いま"],[88,1,"おだ"],[95,1,"かえ"]],"text":"アンモンの人々の王はエフタの使者に答えた、「昔、イスラエルがエジプトから上ってきたとき、アルノンからヤボクに及び、またヨルダンに及ぶわたしの国を奪い取ったからです。それゆえ今、穏やかにそれを返しなさい」。"},{"ref":"Judg.11.14","start":7011014,"end":7011014,"break":"none","ruby":[[6,2,"ししゃ"],[14,2,"ひとびと"],[17,1,"おう"]],"text":"エフタはまた使者をアンモンの人々の王につかわして、"},{"ref":"Judg.11.15","start":7011015,"end":7011015,"break":"none","ruby":[[0,1,"い"],[12,1,"もう"],[28,1,"ち"],[38,2,"ひとびと"],[41,1,"ち"],[43,1,"と"]],"text":"言わせた、「エフタはこう申します、『イスラエルはモアブの地も、またアンモンの人々の地も取りませんでした。"},{"ref":"Judg.11.16","start":7011016,"end":7011016,"break":"none","ruby":[[12,1,"のぼ"],[20,2,"あらの"],[27,2,"こうかい"]],"text":"イスラエルはエジプトから上ってきたとき、荒野をとおって紅海にいたり、カデシにきました。"},{"ref":"Judg.11.17","start":7011017,"end":7011017,"break":"none","ruby":[[9,2,"ししゃ"],[16,1,"おう"],[37,1,"くに"],[39,1,"とお"],[49,1,"い"],[61,1,"おう"],[63,1,"き"],[76,1,"おな"],[81,1,"ひと"],[87,1,"おう"],[96,1,"かれ"],[98,2,"しょうだく"]],"text":"そしてイスラエルは使者をエドムの王につかわして「どうぞ、われわれにあなたの国を通らせてください」と言わせましたが、エドムの王は聞きいれませんでした。また同じように人をモアブの王につかわしたが、彼も承諾しなかったので、イスラエルはカデシにとどまりました。"},{"ref":"Judg.11.18","start":7011018,"end":7011018,"break":"none","ruby":[[4,2,"あらの"],[16,1,"ち"],[22,1,"ち"],[24,1,"まわ"],[31,1,"ち"],[33,2,"とうぶ"],[36,1,"たっ"],[44,1,"む"],[48,2,"しゅくえい"],[59,2,"りょういき"],[83,1,"さかい"]],"text":"それから荒野をとおって、エドムの地とモアブの地を回り、モアブの地の東部に達し、アルノンの向こうに宿営しましたがモアブの領域には、はいりませんでした。アルノンはモアブの境だからです。"},{"ref":"Judg.11.19","start":7011019,"end":7011019,"break":"none","ruby":[[0,1,"つぎ"],[13,1,"おう"],[24,1,"おう"],[29,2,"ししゃ"],[41,1,"む"],[59,1,"くに"],[71,2,"もくてき"],[73,1,"ち"],[75,1,"い"],[85,1,"い"]],"text":"次にイスラエルはヘシボンの王すなわちアモリびとの王シホンに使者をつかわし、シホンに向かって「どうぞ、われわれにあなたの国をとおって、われわれの目的地へ行かせてください」と言わせました。"},{"ref":"Judg.11.20","start":7011020,"end":7011020,"break":"none","ruby":[[14,1,"しん"],[20,2,"りょういき"],[23,1,"とお"],[41,1,"たみ"],[43,1,"あつ"],[50,1,"じん"],[52,1,"と"],[61,1,"たたか"]],"text":"ところがシホンはイスラエルを信ぜず、その領域を通らせないばかりか、かえってすべての民を集めてヤハヅに陣を取り、イスラエルと戦いましたが、"},{"ref":"Judg.11.21","start":7011021,"end":7011021,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[20,1,"たみ"],[28,1,"て"],[44,1,"かれ"],[47,1,"う"],[49,1,"やぶ"],[55,2,"とち"],[58,1,"す"],[69,1,"ち"],[76,2,"せんりょう"]],"text":"イスラエルの神、主はシホンとそのすべての民をイスラエルの手にわたされたので、イスラエルは彼らを撃ち破って、その土地に住んでいたアモリびとの地をことごとく占領し、"},{"ref":"Judg.11.22","start":7011022,"end":7011022,"break":"none","ruby":[[13,2,"あらの"],[30,2,"りょういき"],[38,2,"せんりょう"]],"text":"アルノンからヤボクまでと、荒野からヨルダンまで、アモリびとの領域をことごとく占領しました。"},{"ref":"Judg.11.23","start":7011023,"end":7011023,"break":"none","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[17,1,"たみ"],[24,1,"まえ"],[33,1,"お"],[35,1,"はら"],[49,1,"と"]],"text":"このようにイスラエルの神、主はその民イスラエルの前からアモリびとを追い払われたのに、あなたはそれを取ろうとするのですか。"},{"ref":"Judg.11.24","start":7011024,"end":7011024,"break":"none","ruby":[[9,1,"かみ"],[18,1,"と"],[25,1,"と"],[44,1,"かみ"],[46,1,"しゅ"],[53,1,"まえ"],[56,1,"お"],[58,1,"はら"],[65,2,"とち"],[68,1,"と"]],"text":"あなたは、あなたの神ケモシがあなたに取らせるものを取らないのですか。われわれはわれわれの神、主がわれわれの前から追い払われたものの土地を取るのです。"},{"ref":"Judg.11.25","start":7011025,"end":7011025,"break":"none","ruby":[[8,1,"おう"],[14,1,"こ"],[22,1,"もの"],[40,1,"あらそ"],[55,1,"かれ"],[58,1,"たたか"]],"text":"あなたはモアブの王チッポルの子バラクにまさる者ですか。バラクはかつてイスラエルと争ったことがありますか。かつて彼らと戦ったことがありますか。"},{"ref":"Judg.11.26","start":7011026,"end":7011026,"break":"none","ruby":[[13,2,"むらざと"],[16,1,"す"],[28,2,"むらざと"],[38,1,"きし"],[40,1,"そ"],[46,2,"まちまち"],[49,1,"す"],[55,1,"ねん"],[75,1,"かん"],[80,1,"と"]],"text":"イスラエルはヘシボンとその村里に住み、またアロエルとその村里およびアルノンの岸に沿うすべての町々に住むこと三百年になりますが、あなたがたはどうしてその間にそれを取りもどさなかったのですか。"},{"ref":"Judg.11.27","start":7011027,"end":7011027,"break":"none","ruby":[[8,1,"なに"],[10,1,"わる"],[12,1,"こと"],[32,1,"たたか"],[40,1,"がい"],[42,1,"くわ"],[51,3,"しんぱんしゃ"],[59,1,"しゅ"],[76,2,"ひとびと"],[84,2,"ひとびと"],[88,1,"あいだ"]],"text":"わたしはあなたに何も悪い事をしたこともないのに、あなたはわたしと戦って、わたしに害を加えようとします。審判者であられる主よ、どうぞ、きょう、イスラエルの人々とアンモンの人々との間をおさばきください』」。"},{"ref":"Judg.11.28","start":7011028,"end":7011028,"break":"none","ruby":[[8,2,"ひとびと"],[11,1,"おう"],[17,1,"い"],[24,2,"ことば"]],"text":"しかしアンモンの人々の王はエフタが言いつかわした言葉をききいれなかった。"},{"ref":"Judg.11.29","start":7011029,"end":7011029,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,1,"れい"],[10,1,"のぞ"],[42,1,"い"],[55,1,"すす"],[63,2,"ひとびと"],[70,1,"い"]],"text":"時に主の霊がエフタに臨み、エフタはギレアデおよびマナセをとおって、ギレアデのミヅパに行き、ギレアデのミヅパから進んでアンモンの人々のところに行った。"},{"ref":"Judg.11.30","start":7011030,"end":7011030,"break":"none","ruby":[[4,1,"しゅ"],[6,2,"せいがん"],[9,1,"た"],[12,1,"い"],[28,2,"ひとびと"],[35,1,"て"]],"text":"エフタは主に誓願を立てて言った、「もしあなたがアンモンの人々をわたしの手にわたされるならば、"},{"ref":"Judg.11.31","start":7011031,"end":7011031,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"か"],[15,1,"かえ"],[25,1,"いえ"],[27,2,"とぐち"],[31,1,"で"],[40,1,"むか"],[50,1,"しゅ"],[59,1,"もの"],[61,2,"はんさい"]],"text":"わたしがアンモンの人々に勝って帰るときに、わたしの家の戸口から出てきて、わたしを迎えるものはだれでも主のものとし、その者を燔祭としてささげましょう」。"},{"ref":"Judg.11.32","start":7011032,"end":7011032,"break":"none","ruby":[[9,2,"ひとびと"],[16,1,"すす"],[19,1,"い"],[23,1,"かれ"],[26,1,"たたか"],[31,1,"しゅ"],[33,1,"かれ"],[40,1,"て"]],"text":"エフタはアンモンの人々のところに進んで行って、彼らと戦ったが、主は彼らをエフタの手にわたされたので、"},{"ref":"Judg.11.33","start":7011033,"end":7011033,"break":"none","ruby":[[11,2,"ふきん"],[19,1,"まち"],[21,1,"う"],[23,1,"はい"],[35,1,"いた"],[40,2,"ひじょう"],[43,1,"おお"],[46,1,"ひと"],[48,1,"ころ"],[61,2,"ひとびと"],[70,2,"ひとびと"],[73,1,"まえ"],[75,1,"せ"],[77,1,"ふ"]],"text":"アロエルからミンニテの附近まで、二十の町を撃ち敗り、アベル・ケラミムに至るまで、非常に多くの人を殺した。こうしてアンモンの人々はイスラエルの人々の前に攻め伏せられた。"},{"ref":"Judg.11.34","start":7011034,"end":7011034,"break":"paragraph","ruby":[[11,1,"かえ"],[14,2,"じぶん"],[17,1,"いえ"],[19,1,"く"],[23,1,"かれ"],[25,1,"むすめ"],[27,1,"つづみ"],[32,1,"ま"],[34,1,"おど"],[37,1,"かれ"],[39,2,"でむか"],[44,2,"かのじょ"],[54,1,"こ"],[60,2,"だんし"],[63,2,"じょし"]],"text":"やがてエフタはミヅパに帰り、自分の家に来ると、彼の娘が鼓をもち、舞い踊って彼を出迎えた。彼女はエフタのひとり子で、ほかに男子も女子もなかった。"},{"ref":"Judg.11.35","start":7011035,"end":7011035,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"み"],[11,1,"ころも"],[13,1,"さ"],[16,1,"い"],[24,1,"むすめ"],[31,1,"まった"],[37,1,"う"],[48,1,"なや"],[62,1,"しゅ"],[64,1,"ちか"],[71,1,"あらた"]],"text":"エフタは彼女を見ると、衣を裂いて言った、「ああ、娘よ、あなたは全くわたしを打ちのめした。わたしを悩ますものとなった。わたしが主に誓ったのだから改めることはできないのだ」。"},{"ref":"Judg.11.36","start":7011036,"end":7011036,"break":"none","ruby":[[0,1,"むすめ"],[2,1,"い"],[7,1,"ちち"],[14,1,"しゅ"],[16,1,"ちか"],[26,1,"しゅ"],[40,1,"てき"],[46,2,"ひとびと"],[49,2,"ほうふく"],[54,1,"いま"],[60,1,"い"]],"text":"娘は言った、「父よ、あなたは主に誓われたのですから、主があなたのために、あなたの敵アンモンの人々に報復された今、あなたが言われたとおりにわたしにしてください」。"},{"ref":"Judg.11.37","start":7011037,"end":7011037,"break":"none","ruby":[[0,1,"むすめ"],[4,1,"ちち"],[6,1,"い"],[17,1,"こと"],[37,1,"げつ"],[39,1,"あいだ"],[48,1,"とも"],[52,2,"いっしょ"],[55,1,"い"],[59,2,"やまやま"],[72,2,"しょじょ"],[80,1,"なげ"]],"text":"娘はまた父に言った、「どうぞ、この事をわたしにさせてください。すなわち二か月の間わたしをゆるし、友だちと一緒に行って、山々をゆきめぐり、わたしの処女であることを嘆かせてください」。"},{"ref":"Judg.11.38","start":7011038,"end":7011038,"break":"none","ruby":[[5,1,"い"],[12,1,"い"],[16,2,"かのじょ"],[21,1,"げつ"],[23,1,"あいだ"],[25,1,"だ"],[32,2,"かのじょ"],[35,1,"とも"],[39,2,"いっしょ"],[42,1,"い"],[46,1,"やま"],[48,1,"うえ"],[50,2,"じぶん"],[53,2,"しょじょ"],[61,1,"なげ"]],"text":"エフタは「行きなさい」と言って、彼女を二か月の間、出してやった。彼女は友だちと一緒に行って、山の上で自分の処女であることを嘆いたが、"},{"ref":"Judg.11.39","start":7011039,"end":7011039,"break":"none","ruby":[[2,1,"げつ"],[4,1,"のち"],[6,1,"ちち"],[11,1,"かえ"],[19,1,"ちち"],[21,1,"ちか"],[24,2,"せいがん"],[31,2,"かのじょ"],[40,2,"かのじょ"],[46,1,"おとこ"],[48,1,"し"]],"text":"二か月の後、父のもとに帰ってきたので、父は誓った誓願のとおりに彼女におこなった。彼女はついに男を知らなかった。"},{"ref":"Judg.11.40","start":7011040,"end":7011040,"break":"none","ruby":[[6,2,"ねんねん"],[14,1,"むすめ"],[18,1,"い"],[22,1,"ねん"],[25,1,"か"],[38,1,"むすめ"],[43,1,"なげ"]],"text":"これによって年々イスラエルの娘たちは行って、年に四日ほどギレアデびとエフタの娘のために嘆くことがイスラエルのならわしとなった。"}]