[{"ref":"Ps.108.1","start":19108001,"end":19108001,"break":"paragraph","title":"ダビデの歌、さんび","breaks":[[14,"line"],[25,"line"],[42,"line"]],"ruby":[[0,1,"かみ"],[5,1,"こころ"],[7,1,"さだ"],[16,1,"こころ"],[18,1,"さだ"],[29,1,"うた"],[44,1,"たましい"]],"titleRuby":[[4,1,"うた"]],"text":"神よ、わが心は定まりました。わが心は定まりました。わたしは歌い、かつほめたたえます。わが魂よ、さめよ。"},{"ref":"Ps.108.2","start":19108002,"end":19108002,"break":"line","breaks":[[11,"line"]],"ruby":[[0,2,"たてごと"],[4,1,"こと"],[20,1,"よ"]],"text":"立琴よ、琴よ、さめよ。わたしはしののめを呼びさまします。"},{"ref":"Ps.108.3","start":19108003,"end":19108003,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[12,1,"たみ"],[14,1,"なか"],[20,2,"かんしゃ"],[29,1,"くに"],[31,1,"なか"]],"text":"主よ、わたしはもろもろの民の中であなたに感謝し、もろもろの国の中であなたをほめたたえます。"},{"ref":"Ps.108.4","start":19108004,"end":19108004,"break":"line","breaks":[[21,"line"]],"ruby":[[10,1,"おお"],[14,1,"てん"],[29,1,"くも"],[33,1,"およ"]],"text":"あなたのいつくしみは大きく、天にまでおよびあなたのまことは雲にまで及ぶ。"},{"ref":"Ps.108.5","start":19108005,"end":19108005,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[8,1,"てん"],[12,1,"たか"],[21,1,"ぜん"],[22,1,"ち"],[24,1,"うえ"]],"text":"神よ、みずからを天よりも高くし、みさかえを全地の上にあげてください。"},{"ref":"Ps.108.6","start":19108006,"end":19108006,"break":"line","breaks":[[19,"line"],[34,"line"]],"ruby":[[4,1,"あい"],[8,1,"もの"],[10,1,"たす"],[13,1,"え"],[19,1,"みぎ"],[22,1,"て"],[27,1,"すくい"],[38,1,"こた"]],"text":"あなたの愛される者が助けを得るために、右のみ手をもって救をほどこし、わたしに答えてください。"},{"ref":"Ps.108.7","start":19108007,"end":19108007,"break":"line","breaks":[[12,"line"],[35,"line"]],"ruby":[[0,1,"かみ"],[4,2,"せいじょ"],[7,1,"い"],[17,1,"おお"],[21,1,"よろこ"],[31,1,"わ"],[39,1,"たに"],[41,1,"わ"],[44,1,"あた"]],"text":"神はその聖所で言われた、「わたしは大いなる喜びをもってシケムを分かち、スコテの谷を分かち与えよう。"},{"ref":"Ps.108.8","start":19108008,"end":19108008,"break":"line","breaks":[[12,"line"],[26,"line"],[40,"line"]],"text":"ギレアデはわたしのもの、マナセもわたしのものである。エフライムはわたしのかぶと、ユダはわたしのつえである。"},{"ref":"Ps.108.9","start":19108009,"end":19108009,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[8,1,"あし"],[25,1,"な"]],"text":"モアブはわたしの足だらい、エドムにはわたしのくつを投げる。ペリシテについては、かちどきをあげる」。"},{"ref":"Ps.108.10","start":19108010,"end":19108010,"break":"line","breaks":[[22,"line"]],"ruby":[[7,2,"けんご"],[10,1,"まち"],[12,1,"いた"],[33,1,"みちび"]],"text":"だれがわたしを堅固な町に至らせるであろうか。だれがわたしをエドムに導くであろうか。"},{"ref":"Ps.108.11","start":19108011,"end":19108011,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"かみ"],[11,1,"す"],[25,1,"かみ"],[36,2,"ぐんぜい"],[39,1,"とも"],[41,1,"で"],[43,1,"い"]],"text":"神よ、あなたはわれらを捨てられたではありませんか。神よ、あなたはわれらの軍勢と共に出て行かれません。"},{"ref":"Ps.108.12","start":19108012,"end":19108012,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"たす"],[7,1,"あた"],[24,1,"ひと"],[26,1,"たす"]],"text":"われらに助けを与えて、あだにむかわせてください。人の助けはむなしいからです。"},{"ref":"Ps.108.13","start":19108013,"end":19108013,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"かみ"],[9,1,"いさ"],[13,1,"はたら"],[25,1,"ふ"],[30,1,"もの"],[32,1,"かみ"]],"text":"われらは神によって勇ましく働きます。われらのあだを踏みにじる者は神だからです。"}]