[{"ref":"Isa.9.1","start":23009001,"end":23009001,"break":"paragraph","ruby":[[4,1,"くる"],[11,1,"ち"],[32,1,"ち"],[39,1,"ち"],[47,1,"あた"],[54,1,"のち"],[57,1,"うみ"],[59,1,"いた"],[61,1,"みち"],[68,1,"む"],[72,1,"ち"],[74,3,"いほうじん"],[83,2,"こうえい"],[86,1,"あた"]],"text":"しかし、苦しみにあった地にも、やみがなくなる。さきにはゼブルンの地、ナフタリの地にはずかしめを与えられたが、後には海に至る道、ヨルダンの向こうの地、異邦人のガリラヤに光栄を与えられる。"},{"ref":"Isa.9.2","start":23009002,"end":23009002,"break":"stanza","breaks":[[22,"line"]],"ruby":[[0,1,"くら"],[4,1,"なか"],[6,1,"あゆ"],[11,1,"たみ"],[13,1,"おお"],[17,1,"ひかり"],[19,1,"み"],[22,2,"あんこく"],[25,1,"ち"],[27,1,"す"],[32,2,"ひとびと"],[35,1,"うえ"],[37,1,"ひかり"],[39,1,"て"]],"text":"暗やみの中に歩んでいた民は大いなる光を見た。暗黒の地に住んでいた人々の上に光が照った。"},{"ref":"Isa.9.3","start":23009003,"end":23009003,"break":"line","breaks":[[24,"line"],[38,"line"],[53,"line"]],"ruby":[[4,2,"こくみん"],[7,1,"ま"],[12,1,"よろこ"],[15,1,"おお"],[24,1,"かれ"],[27,2,"かりい"],[30,1,"とき"],[32,1,"よろこ"],[38,2,"えもの"],[41,1,"わ"],[44,1,"とき"],[46,1,"たの"],[57,1,"まえ"],[59,1,"よろこ"]],"text":"あなたが国民を増し、その喜びを大きくされたので、彼らは刈入れ時に喜ぶように、獲物を分かつ時に楽しむように、あなたの前に喜んだ。"},{"ref":"Isa.9.4","start":23009004,"end":23009004,"break":"line","breaks":[[20,"line"],[40,"line"]],"ruby":[[7,1,"かれ"],[10,1,"お"],[22,1,"かた"],[33,1,"もの"],[45,1,"ひ"],[54,1,"お"]],"text":"これはあなたが彼らの負っているくびきと、その肩のつえと、しえたげる者のむちとを、ミデアンの日になされたように折られたからだ。"},{"ref":"Isa.9.5","start":23009005,"end":23009005,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[3,2,"せんじょう"],[7,2,"ほへい"],[17,1,"ち"],[23,1,"ころも"],[27,1,"ひ"],[29,1,"も"],[37,1,"や"]],"text":"すべて戦場で、歩兵のはいたくつと、血にまみれた衣とは、火の燃えくさとなって焼かれる。"},{"ref":"Isa.9.6","start":23009006,"end":23009006,"break":"line","breaks":[[21,"line"],[40,"line"],[53,"line"],[71,"line"]],"ruby":[[17,1,"うま"],[25,1,"おとこ"],[27,1,"こ"],[34,1,"あた"],[48,1,"かた"],[55,1,"な"],[59,2,"れいみょう"],[63,1,"ぎ"],[64,1,"し"],[66,2,"たいのう"],[69,1,"かみ"],[76,1,"ちち"],[78,2,"へいわ"],[81,1,"きみ"]],"text":"ひとりのみどりごがわれわれのために生れた、ひとりの男の子がわれわれに与えられた。まつりごとはその肩にあり、その名は、「霊妙なる議士、大能の神、とこしえの父、平和の君」ととなえられる。"},{"ref":"Isa.9.7","start":23009007,"end":23009007,"break":"line","breaks":[[24,"line"],[41,"line"],[61,"line"],[75,"line"]],"ruby":[[8,2,"へいわ"],[13,1,"ま"],[15,1,"くわ"],[19,1,"かぎ"],[28,1,"くらい"],[30,1,"ざ"],[36,1,"くに"],[38,1,"おさ"],[41,1,"いま"],[44,1,"のち"],[51,2,"こうへい"],[54,2,"せいぎ"],[64,1,"た"],[70,1,"たも"],[75,2,"ばんぐん"],[78,1,"しゅ"],[80,2,"ねっしん"]],"text":"そのまつりごとと平和とは、増し加わって限りなく、ダビデの位に座して、その国を治め、今より後、とこしえに公平と正義とをもってこれを立て、これを保たれる。万軍の主の熱心がこれをなされるのである。"},{"ref":"Isa.9.8","start":23009008,"end":23009008,"break":"paragraph","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"こと"],[23,1,"うえ"]],"text":"主はひと言をヤコブにおくり、これをイスラエルの上にくだされる。"},{"ref":"Isa.9.9","start":23009009,"end":23009009,"break":"line","breaks":[[7,"line"],[30,"line"]],"ruby":[[5,1,"たみ"],[18,1,"す"],[20,1,"もの"],[23,1,"し"],[30,1,"かれ"],[33,1,"たか"],[37,1,"こころ"],[42,1,"い"]],"text":"すべてこの民、エフライムとサマリヤに住む者とは知るであろう。彼らは高ぶり、心おごって言う、"},{"ref":"Isa.9.10","start":23009010,"end":23009010,"break":"line","breaks":[[11,"line"],[28,"line"],[41,"line"]],"ruby":[[16,1,"き"],[18,1,"いし"],[23,1,"た"],[31,1,"き"],[33,1,"き"],[35,1,"たお"],[46,2,"こうはく"]],"text":"「かわらがくずれても、われわれは切り石をもって建てよう。くわの木が切り倒されても、われわれは香柏をもってこれにかえよう」と。"},{"ref":"Isa.9.11","start":23009011,"end":23009011,"break":"line","breaks":[[20,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"てき"],[9,1,"おこ"],[12,1,"かれ"],[15,1,"せ"],[25,1,"ふる"],[27,1,"た"]],"text":"それゆえ、主は敵を起して彼らを攻めさせ、そのあだを奮い立たせられる。"},{"ref":"Isa.9.12","start":23009012,"end":23009012,"break":"line","breaks":[[21,"line"],[41,"line"],[54,"line"]],"ruby":[[0,1,"ひがし"],[10,1,"にし"],[21,1,"かれ"],[24,2,"おおぐち"],[36,1,"く"],[38,1,"つく"],[45,1,"しゅ"],[47,1,"いか"],[61,1,"て"],[63,1,"の"]],"text":"東にスリヤびとあり、西にペリシテびとあり、彼らは大口をあけてイスラエルを食い尽す。それでも主の怒りはやまず、なおも、そのみ手を伸ばされる。"},{"ref":"Isa.9.13","start":23009013,"end":23009013,"break":"paragraph","breaks":[[24,"line"]],"ruby":[[8,1,"たみ"],[10,2,"じぶん"],[15,1,"う"],[18,1,"もの"],[20,1,"かえ"],[24,2,"ばんぐん"],[27,1,"しゅ"],[29,1,"もと"]],"text":"しかもなお、この民は自分たちを撃った者に帰らず、万軍の主を求めない。"},{"ref":"Isa.9.14","start":23009014,"end":23009014,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"しゅ"],[14,1,"あたま"],[16,1,"お"],[23,1,"えだ"],[25,1,"あし"],[29,1,"にち"],[34,1,"た"],[36,1,"き"]],"text":"それゆえ、主はイスラエルから頭と尾と、しゅろの枝と葦とを一日のうちに断ち切られる。"},{"ref":"Isa.9.15","start":23009015,"end":23009015,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"あたま"],[6,2,"ちょうろう"],[9,1,"たっと"],[11,1,"ひと"],[15,1,"お"],[19,1,"いつわ"],[22,1,"おし"],[25,3,"よげんしゃ"]],"text":"その頭とは、長老と尊き人、その尾とは、偽りを教える預言者である。"},{"ref":"Isa.9.16","start":23009016,"end":23009016,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"たみ"],[4,1,"みちび"],[6,1,"もの"],[12,1,"まよ"],[16,1,"かれ"],[19,1,"みちび"],[23,1,"もの"],[28,1,"つく"]],"text":"この民を導く者は、これを迷わせ、彼らに導かれる者は、のみ尽される。"},{"ref":"Isa.9.17","start":23009017,"end":23009017,"break":"line","breaks":[[19,"line"],[38,"line"],[58,"line"],[77,"line"],[90,"line"]],"ruby":[[5,1,"しゅ"],[9,1,"わか"],[11,2,"ひとびと"],[14,1,"よろこ"],[26,2,"かふ"],[38,1,"かれ"],[44,3,"ふしんこう"],[52,1,"あく"],[54,1,"おこな"],[56,1,"もの"],[62,1,"くち"],[64,1,"おろ"],[67,1,"こと"],[69,1,"かた"],[81,1,"しゅ"],[83,1,"いか"],[97,1,"て"],[99,1,"の"]],"text":"それゆえ、主はその若き人々を喜ばれず、そのみなしごと寡婦とをあわれまれない。彼らはみな、不信仰であって、悪を行う者、すべての口は愚かな事を語るからである。それでも主の怒りはやまず、なおも、そのみ手を伸ばされる。"},{"ref":"Isa.9.18","start":23009018,"end":23009018,"break":"paragraph","breaks":[[10,"line"],[25,"line"]],"ruby":[[0,1,"あく"],[2,1,"ひ"],[7,1,"も"],[20,1,"く"],[22,1,"つく"],[25,1,"しげ"],[29,1,"はやし"],[31,1,"や"],[34,1,"けむり"],[36,1,"はしら"],[41,1,"ま"]],"text":"悪は火のように燃え、いばらと、おどろとを食い尽し、茂りあう林を焼き、煙の柱となって巻きあがる。"},{"ref":"Isa.9.19","start":23009019,"end":23009019,"break":"line","breaks":[[16,"line"],[33,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"いか"],[11,1,"ち"],[13,1,"や"],[18,1,"たみ"],[20,1,"ひ"],[22,1,"も"],[38,2,"きょうだい"],[45,1,"もの"]],"text":"万軍の主の怒りによって地は焼け、その民は火の燃えくさのようになり、だれもその兄弟をあわれむ者がない。"},{"ref":"Isa.9.20","start":23009020,"end":23009020,"break":"line","breaks":[[17,"line"],[32,"line"]],"ruby":[[0,1,"かれ"],[3,2,"みぎて"],[14,1,"う"],[17,2,"ひだりて"],[20,1,"た"],[24,1,"あ"],[38,1,"とな"],[40,1,"びと"],[42,1,"にく"],[44,1,"く"]],"text":"彼らは右手につかんでも、なお飢え、左手で食べても飽くことがない。おのおのその隣り人の肉を食う。"},{"ref":"Isa.9.21","start":23009021,"end":23009021,"break":"line","breaks":[[11,"line"],[24,"line"],[36,"line"],[49,"line"]],"ruby":[[21,1,"く"],[24,1,"かれ"],[27,1,"とも"],[32,1,"せ"],[40,1,"しゅ"],[42,1,"いか"],[56,1,"て"],[58,1,"の"]],"text":"マナセはエフライムを、エフライムはマナセを食い、彼らは共にユダを攻める。それでも主の怒りはやまず、なおも、そのみ手を伸ばされる。"}]