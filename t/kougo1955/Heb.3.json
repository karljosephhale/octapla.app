[{"ref":"Heb.3.1","start":58003001,"end":58003001,"break":"paragraph","ruby":[[4,1,"てん"],[6,1,"め"],[16,1,"せい"],[19,2,"きょうだい"],[38,2,"こくはく"],[42,2,"しんこう"],[45,2,"ししゃ"],[49,3,"だいさいし"],[59,1,"おも"]],"text":"そこで、天の召しにあずかっている聖なる兄弟たちよ。あなたがたは、わたしたちが告白する信仰の使者また大祭司なるイエスを、思いみるべきである。"},{"ref":"Heb.3.2","start":58003002,"end":58003002,"break":"none","ruby":[[0,1,"かれ"],[7,1,"かみ"],[9,1,"いえ"],[11,2,"ぜんたい"],[14,1,"たい"],[17,2,"ちゅうじつ"],[27,2,"じぶん"],[30,1,"た"],[36,1,"たい"],[39,2,"ちゅうじつ"]],"text":"彼は、モーセが神の家の全体に対して忠実であったように、自分を立てたかたに対して忠実であられた。"},{"ref":"Heb.3.3","start":58003003,"end":58003003,"break":"none","ruby":[[5,1,"いえ"],[7,1,"つく"],[9,1,"もの"],[11,1,"いえ"],[22,1,"たっと"],[30,1,"かれ"],[36,2,"いじょう"],[40,1,"おお"],[44,2,"こうえい"],[47,1,"う"],[56,1,"もの"]],"text":"おおよそ、家を造る者が家そのものよりもさらに尊ばれるように、彼は、モーセ以上に、大いなる光栄を受けるにふさわしい者とされたのである。"},{"ref":"Heb.3.4","start":58003004,"end":58003004,"break":"none","ruby":[[0,1,"いえ"],[13,1,"つく"],[31,1,"つく"],[39,1,"かみ"]],"text":"家はすべて、だれかによって造られるものであるが、すべてのものを造られたかたは、神である。"},{"ref":"Heb.3.5","start":58003005,"end":58003005,"break":"none","ruby":[[8,1,"のち"],[10,1,"かた"],[15,1,"こと"],[32,1,"つか"],[35,1,"もの"],[40,1,"かみ"],[42,1,"いえ"],[44,2,"ぜんたい"],[47,1,"たい"],[50,2,"ちゅうじつ"]],"text":"さて、モーセは、後に語らるべき事がらについてあかしをするために、仕える者として、神の家の全体に対して忠実であったが、"},{"ref":"Heb.3.6","start":58003006,"end":58003006,"break":"none","ruby":[[5,2,"みこ"],[11,1,"かみ"],[13,1,"いえ"],[15,1,"おさ"],[20,2,"ちゅうじつ"],[41,1,"のぞ"],[44,2,"かくしん"],[47,1,"ほこり"],[50,2,"さいご"],[59,1,"も"],[61,1,"つづ"],[73,1,"かみ"],[75,1,"いえ"]],"text":"キリストは御子として、神の家を治めるのに忠実であられたのである。もしわたしたちが、望みの確信と誇とを最後までしっかりと持ち続けるなら、わたしたちは神の家なのである。"},{"ref":"Heb.3.7","start":58003007,"end":58003007,"break":"none","breaks":[[16,"stanza"]],"ruby":[[4,2,"せいれい"],[7,1,"い"],[28,1,"こえ"],[30,1,"き"]],"text":"だから、聖霊が言っているように、「きょう、あなたがたがみ声を聞いたなら、"},{"ref":"Heb.3.8","start":58003008,"end":58003008,"break":"line","breaks":[[12,"line"],[24,"line"]],"ruby":[[0,2,"あらの"],[6,2,"しれん"],[9,1,"ひ"],[12,1,"かみ"],[18,1,"とき"],[30,1,"こころ"]],"text":"荒野における試錬の日に、神にそむいた時のように、あなたがたの心を、かたくなにしてはいけない。"},{"ref":"Heb.3.9","start":58003009,"end":58003009,"break":"line","breaks":[[12,"line"]],"ruby":[[6,2,"せんぞ"],[19,1,"こころ"]],"text":"あなたがたの先祖たちは、そこでわたしを試みためし、"},{"ref":"Heb.3.10","start":58003010,"end":58003010,"break":"line","breaks":[[23,"line"],[43,"line"],[53,"line"],[68,"line"]],"ruby":[[6,1,"ねん"],[8,1,"あいだ"],[16,1,"み"],[33,2,"じだい"],[36,2,"ひとびと"],[39,1,"たい"],[49,1,"い"],[53,1,"かれ"],[56,1,"こころ"],[62,1,"まよ"],[68,1,"かれ"],[76,1,"みち"],[78,1,"みと"]],"text":"しかも、四十年の間わたしのわざを見たのである。だから、わたしはその時代の人々に対して、いきどおって言った、彼らの心は、いつも迷っており、彼らは、わたしの道を認めなかった。"},{"ref":"Heb.3.11","start":58003011,"end":58003011,"break":"line","ruby":[[8,1,"いか"],[12,1,"かれ"],[19,2,"あんそく"],[35,1,"ちか"]],"text":"そこで、わたしは怒って、彼らをわたしの安息にはいらせることはしない、と誓った」。"},{"ref":"Heb.3.12","start":58003012,"end":58003012,"break":"none","ruby":[[0,2,"きょうだい"],[6,1,"き"],[20,1,"なか"],[29,1,"ふ"],[30,2,"しんこう"],[33,1,"わる"],[35,1,"こころ"],[42,1,"い"],[45,1,"かみ"],[48,1,"はな"],[50,1,"さ"],[52,1,"もの"],[58,1,"し"]],"text":"兄弟たちよ。気をつけなさい。あなたがたの中には、あるいは、不信仰な悪い心をいだいて、生ける神から離れ去る者があるかも知れない。"},{"ref":"Heb.3.13","start":58003013,"end":58003013,"break":"none","ruby":[[6,1,"なか"],[9,1,"つみ"],[11,1,"まど"],[15,1,"おちい"],[19,1,"こころ"],[28,1,"もの"],[48,2,"ひび"],[51,1,"たがい"],[53,1,"はげ"],[56,1,"あ"]],"text":"あなたがたの中に、罪の惑わしに陥って、心をかたくなにする者がないように、「きょう」といううちに、日々、互に励まし合いなさい。"},{"ref":"Heb.3.14","start":58003014,"end":58003014,"break":"none","ruby":[[2,2,"さいしょ"],[5,2,"かくしん"],[9,2,"さいご"],[18,1,"も"],[20,1,"つづ"],[42,1,"もの"]],"text":"もし最初の確信を、最後までしっかりと持ち続けるならば、わたしたちはキリストにあずかる者となるのである。"},{"ref":"Heb.3.15","start":58003015,"end":58003015,"break":"none","breaks":[[16,"stanza"],[30,"line"],[42,"line"]],"ruby":[[9,1,"い"],[22,1,"こえ"],[24,1,"き"],[30,1,"かみ"],[36,1,"とき"],[48,1,"こころ"]],"text":"それについて、こう言われている、「きょう、み声を聞いたなら、神にそむいた時のように、あなたがたの心を、かたくなにしてはいけない」。"},{"ref":"Heb.3.16","start":58003016,"end":58003016,"break":"none","ruby":[[4,1,"き"],[29,1,"ひき"],[41,1,"で"],[43,1,"い"],[50,2,"ひとびと"]],"text":"すると、聞いたのにそむいたのは、だれであったのか。モーセに率いられて、エジプトから出て行ったすべての人々ではなかったか。"},{"ref":"Heb.3.17","start":58003017,"end":58003017,"break":"none","ruby":[[5,1,"ねん"],[7,1,"あいだ"],[9,1,"かみ"],[23,1,"たい"],[32,1,"つみ"],[34,1,"おか"],[40,1,"し"],[45,2,"あらの"],[52,1,"もの"],[56,1,"たい"]],"text":"また、四十年の間、神がいきどおられたのはだれに対してであったか。罪を犯して、その死かばねを荒野にさらした者たちに対してではなかったか。"},{"ref":"Heb.3.18","start":58003018,"end":58003018,"break":"none","ruby":[[3,1,"かみ"],[10,2,"あんそく"],[27,1,"ちか"],[37,1,"む"],[47,1,"ふ"],[48,2,"じゅうじゅん"],[51,1,"もの"],[53,1,"む"]],"text":"また、神が、わたしの安息に、はいらせることはしない、と誓われたのは、だれに向かってであったか。不従順な者に向かってではなかったか。"},{"ref":"Heb.3.19","start":58003019,"end":58003019,"break":"none","ruby":[[5,1,"かれ"],[23,1,"ふ"],[24,2,"しんこう"]],"text":"こうして、彼らがはいることのできなかったのは、不信仰のゆえであることがわかる。"}]