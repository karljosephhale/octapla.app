[{"ref":"Jer.22.1","start":24022001,"end":24022001,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"い"],[13,1,"おう"],[15,1,"いえ"],[17,1,"くだ"],[22,1,"ところ"],[26,2,"ことば"]],"text":"主はこう言われる、「ユダの王の家に下り、その所にこの言葉をのべて、"},{"ref":"Jer.22.2","start":24022002,"end":24022002,"break":"none","ruby":[[0,1,"い"],[11,1,"くらい"],[19,1,"おう"],[31,2,"かしん"],[40,1,"もん"],[50,1,"たみ"],[52,1,"しゅ"],[54,2,"ことば"],[57,1,"き"]],"text":"言いなさい、『ダビデの位にすわるユダの王よ、あなたと、あなたの家臣、および、この門からはいるあなたの民は主の言葉を聞きなさい。"},{"ref":"Jer.22.3","start":24022003,"end":24022003,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"い"],[9,2,"こうへい"],[12,2,"せいぎ"],[15,1,"おこな"],[18,1,"もの"],[20,1,"うば"],[24,1,"ひと"],[32,1,"もの"],[34,1,"て"],[37,1,"すく"],[40,2,"いほう"],[43,1,"ひと"],[45,2,"こじ"],[48,2,"かふ"],[51,1,"なや"],[70,1,"ところ"],[73,1,"つみ"],[76,1,"もの"],[78,1,"ち"],[80,1,"なが"]],"text":"主はこう言われる、公平と正義を行い、物を奪われた人を、しえたげる者の手から救い、異邦の人、孤児、寡婦を悩まし、しえたげてはならない。またこの所に、罪なき者の血を流してはならない。"},{"ref":"Jer.22.4","start":24022004,"end":24022004,"break":"none","ruby":[[10,2,"ことば"],[13,2,"しんじつ"],[16,1,"おこな"],[26,1,"くらい"],[31,1,"おう"],[35,2,"かしん"],[43,1,"たみ"],[46,1,"くるま"],[48,1,"うま"],[50,1,"の"],[56,1,"いえ"],[58,1,"もん"]],"text":"もしあなたがたがこの言葉を真実に行うならば、ダビデの位にすわる王とその家臣、およびその民は、車と馬に乗って、この家の門にはいることができる。"},{"ref":"Jer.22.5","start":24022005,"end":24022005,"break":"none","ruby":[[11,2,"ことば"],[14,1,"き"],[26,2,"じしん"],[32,1,"ちか"],[38,1,"いえ"],[40,1,"あ"],[42,1,"ち"],[48,1,"しゅ"],[50,1,"い"]],"text":"しかしあなたがたがこの言葉を聞かないならば、わたしは自身をさして誓うが、この家は荒れ地となると、主は言われる。"},{"ref":"Jer.22.6","start":24022006,"end":24022006,"break":"none","breaks":[[19,"stanza"],[41,"line"],[54,"line"],[74,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"おう"],[7,1,"いえ"],[14,1,"い"],[27,1,"たい"],[46,1,"いただき"],[62,1,"かなら"],[68,1,"あ"],[70,1,"ち"],[74,1,"ひと"],[76,1,"す"],[80,1,"まち"]],"text":"主はユダの王の家についてこう言われる、あなたはわたしに対してギレアデのようであり、レバノンの頂のようである。しかし、わたしは必ずあなたを荒れ地にし、人の住まない町にする。"},{"ref":"Jer.22.7","start":24022007,"end":24022007,"break":"line","breaks":[[23,"line"],[38,"line"],[53,"line"]],"ruby":[[4,1,"ほろ"],[7,1,"もの"],[9,1,"もう"],[17,1,"せ"],[23,1,"かれ"],[32,2,"ぶき"],[42,1,"うるわ"],[45,2,"こうはく"],[48,1,"き"],[50,1,"たお"],[53,1,"ひ"],[55,1,"な"],[57,1,"い"]],"text":"わたしは滅ぼす者を設けて、あなたを攻めさせる、彼らはおのおのその武器をとり、あなたの麗しい香柏を切り倒し、火に投げ入れる。"},{"ref":"Jer.22.8","start":24022008,"end":24022008,"break":"paragraph","ruby":[[0,1,"おお"],[3,1,"くに"],[5,1,"ひと"],[9,1,"まち"],[11,1,"す"],[14,1,"たがい"],[16,1,"かた"],[23,1,"しゅ"],[27,1,"おお"],[31,1,"まち"],[45,1,"い"]],"text":"多くの国の人はこの町を過ぎ、互に語って、「なぜ主はこの大いなる町をこのようにされたのか」と言うとき、"},{"ref":"Jer.22.9","start":24022009,"end":24022009,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こた"],[10,1,"かれ"],[15,1,"かみ"],[17,1,"しゅ"],[19,2,"けいやく"],[22,1,"す"],[25,1,"た"],[27,2,"かみがみ"],[30,1,"はい"],[36,1,"つか"],[46,1,"い"]],"text":"人は答えて、「これは彼らがその神、主の契約を捨てて他の神々を拝し、これに仕えたからである」と言うであろう』」。"},{"ref":"Jer.22.10","start":24022010,"end":24022010,"break":"paragraph","breaks":[[15,"line"],[31,"line"],[51,"line"],[63,"line"]],"ruby":[[0,1,"し"],[3,1,"もの"],[8,1,"な"],[22,1,"なげ"],[31,1,"とら"],[33,1,"うつ"],[39,1,"もの"],[45,1,"はげ"],[48,1,"な"],[51,1,"かれ"],[57,1,"かえ"],[65,2,"こきょう"],[68,1,"み"]],"text":"死んだ者のために泣くことなく、またそのために嘆いてはならない。捕え移されてゆく者のために、激しく泣け。彼はふたたび帰ってきて、その故郷を見ることがないからである。"},{"ref":"Jer.22.11","start":24022011,"end":24022011,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"こ"],[14,1,"ちち"],[22,1,"おう"],[34,1,"ところ"],[37,1,"で"],[39,1,"い"],[43,1,"しゅ"],[45,1,"かれ"],[52,1,"い"],[58,1,"かれ"],[60,1,"ふたた"],[65,1,"かえ"]],"text":"ユダの王ヨシヤの子シャルムは父ヨシヤについで王となったが、ついにこの所から出て行った。主は彼についてこう言われる、「彼は再びここに帰らない。"},{"ref":"Jer.22.12","start":24022012,"end":24022012,"break":"none","ruby":[[0,1,"かれ"],[4,1,"とら"],[6,1,"い"],[10,1,"ところ"],[12,1,"し"],[15,1,"ふたた"],[19,1,"ち"],[21,1,"み"]],"text":"彼はその捕え行かれた所で死に、再びこの地を見ない」。"},{"ref":"Jer.22.13","start":24022013,"end":24022013,"break":"paragraph","breaks":[[14,"line"],[28,"line"],[42,"line"]],"ruby":[[1,2,"ふぎ"],[9,1,"いえ"],[11,1,"た"],[14,2,"ふほう"],[22,2,"たかどの"],[25,1,"つく"],[28,1,"とな"],[30,1,"びと"],[32,1,"やと"],[35,1,"なに"],[38,1,"あた"],[44,2,"ちんぎん"],[47,1,"はら"],[51,1,"もの"]],"text":"「不義をもってその家を建て、不法をもってその高殿を造り、隣り人を雇って何をも与えず、その賃金を払わない者はわざわいである。"},{"ref":"Jer.22.14","start":24022014,"end":24022014,"break":"line","breaks":[[24,"line"],[35,"line"],[49,"line"]],"ruby":[[0,1,"かれ"],[2,1,"い"],[10,2,"じぶん"],[16,1,"おお"],[19,1,"いえ"],[21,1,"た"],[24,1,"ひろ"],[26,2,"たかどの"],[29,1,"つく"],[44,1,"まど"],[46,1,"つく"],[49,2,"こうはく"],[52,2,"かがみいた"],[62,1,"しゅ"],[64,1,"ぬ"]],"text":"彼は言う、『わたしは自分のために大きな家を建て、広い高殿を造ろう』と。そしてこれがために窓を造り、香柏の鏡板でおおい、それを朱で塗る。"},{"ref":"Jer.22.15","start":24022015,"end":24022015,"break":"line","breaks":[[20,"line"],[30,"line"],[42,"line"]],"ruby":[[4,1,"きそ"],[7,2,"こうはく"],[10,1,"もち"],[20,1,"おう"],[25,1,"おも"],[34,1,"ちち"],[36,1,"く"],[38,1,"の"],[42,2,"こうへい"],[45,2,"せいぎ"],[48,1,"おこな"],[52,1,"さいわい"],[54,1,"え"]],"text":"あなたは競って香柏を用いることによって、王であると思うのか。あなたの父は食い飲みし、公平と正義を行って、幸を得たのではないか。"},{"ref":"Jer.22.16","start":24022016,"end":24022016,"break":"line","breaks":[[20,"line"],[28,"line"],[49,"line"]],"ruby":[[0,1,"かれ"],[2,1,"まず"],[5,1,"ひと"],[7,1,"とぼ"],[10,1,"ひと"],[12,1,"うった"],[25,1,"え"],[39,1,"し"],[49,1,"しゅ"],[51,1,"い"]],"text":"彼は貧しい人と乏しい人の訴えをただして、さいわいを得た。こうすることがわたしを知ることではないかと主は言われる。"},{"ref":"Jer.22.17","start":24022017,"end":24022017,"break":"line","breaks":[[13,"line"],[27,"line"],[40,"line"]],"ruby":[[8,1,"め"],[10,1,"こころ"],[13,2,"ふせい"],[16,2,"りえき"],[24,1,"もち"],[27,1,"つみ"],[30,1,"もの"],[32,1,"ち"],[34,1,"なが"],[40,2,"あっせい"],[43,2,"ぼうぎゃく"],[46,1,"おこな"]],"text":"しかし、あなたは目も心も、不正な利益のためにのみ用い、罪なき者の血を流そうとし、圧制と暴虐を行おうとする」。"},{"ref":"Jer.22.18","start":24022018,"end":24022018,"break":"paragraph","breaks":[[32,"stanza"],[48,"line"],[64,"line"],[74,"line"],[88,"line"]],"ruby":[[5,1,"しゅ"],[10,1,"おう"],[15,1,"こ"],[27,1,"い"],[33,2,"ひとびと"],[37,1,"かな"],[45,1,"あに"],[49,1,"かな"],[57,1,"あね"],[60,1,"い"],[64,1,"かれ"],[69,1,"なげ"],[77,1,"かな"],[83,2,"しゅくん"],[89,1,"かな"],[95,2,"へいか"],[100,1,"い"],[103,1,"なげ"]],"text":"それゆえ、主はユダの王ヨシヤの子エホヤキムについてこう言われる、「人々は『悲しいかな、わが兄』、『悲しいかな、わが姉』と言って、彼のために嘆かない。また『悲しいかな、主君よ』、『悲しいかな、陛下よ』と言って嘆かない。"},{"ref":"Jer.22.19","start":24022019,"end":24022019,"break":"line","breaks":[[19,"line"],[27,"line"]],"ruby":[[3,1,"う"],[12,1,"かれ"],[14,1,"ほうむ"],[19,1,"ひ"],[23,1,"い"],[33,1,"もん"],[35,1,"そと"],[37,1,"な"],[39,1,"す"]],"text":"ろばが埋められるように、彼は葬られる。引かれて行って、エルサレムの門の外に投げ捨てられる」。"},{"ref":"Jer.22.20","start":24022020,"end":24022020,"break":"stanza","breaks":[[14,"line"],[28,"line"],[39,"line"]],"ruby":[[6,1,"のぼ"],[9,1,"よ"],[23,1,"こえ"],[34,1,"よ"],[43,1,"あい"],[46,1,"もの"],[50,1,"ほろ"]],"text":"「レバノンに登って呼ばわり、バシャンにあなたの声をあげ、アバリムから呼ばわれ。あなたの愛する者がみな滅ぼされるからだ。"},{"ref":"Jer.22.21","start":24022021,"end":24022021,"break":"line","breaks":[[23,"line"],[37,"line"],[57,"line"]],"ruby":[[4,1,"さか"],[9,1,"とき"],[19,1,"かた"],[24,1,"き"],[33,1,"い"],[45,1,"こえ"],[47,1,"き"],[49,1,"したが"],[61,1,"おさな"],[63,1,"とき"]],"text":"あなたの栄えていた時、わたしはあなたに語ったが『聞きたくはない』と言った。あなたがわたしの声に聞き従わないことは、あなたの幼い時からの、ならわしであった。"},{"ref":"Jer.22.22","start":24022022,"end":24022022,"break":"line","breaks":[[19,"line"],[35,"line"],[57,"line"]],"ruby":[[4,2,"ぼくしゃ"],[10,1,"かぜ"],[12,1,"お"],[14,1,"た"],[23,1,"あい"],[26,1,"もの"],[28,1,"とら"],[30,1,"うつ"],[37,1,"とき"],[43,2,"じぶん"],[51,1,"あく"],[57,1,"は"]],"text":"あなたの牧者はみな、風に追い立てられ、あなたの愛する者は捕え移される。その時、あなたは自分のもろもろの悪のために、恥じ、うろたえる。"},{"ref":"Jer.22.23","start":24022023,"end":24022023,"break":"line","breaks":[[8,"line"],[24,"line"],[42,"line"],[51,"line"]],"ruby":[[5,1,"す"],[8,2,"こうはく"],[11,1,"なか"],[13,1,"す"],[21,1,"もの"],[24,1,"こ"],[26,1,"う"],[28,1,"おんな"],[30,1,"のぞ"],[32,1,"くる"],[39,2,"くつう"],[46,1,"のぞ"],[59,1,"なげ"]],"text":"レバノンに住み、香柏の中に巣をつくっている者よ、子を産む女に臨む苦しみのような苦痛があなたに臨むとき、あなたはどんなに嘆くことであろうか」。"},{"ref":"Jer.22.24","start":24022024,"end":24022024,"break":"paragraph","ruby":[[1,1,"しゅ"],[3,1,"い"],[12,1,"い"],[21,1,"おう"],[28,1,"こ"],[38,2,"みぎて"],[41,2,"ゆびわ"],[57,1,"ぬ"],[59,1,"と"]],"text":"「主は言われる、わたしは生きている。ユダの王エホヤキムの子コニヤが、わたしの右手の指輪であっても、わたしはあなたを抜き取る。"},{"ref":"Jer.22.25","start":24022025,"end":24022025,"break":"none","ruby":[[4,1,"いのち"],[6,1,"もと"],[9,1,"もの"],[11,1,"て"],[19,1,"かお"],[21,1,"おそ"],[24,1,"もの"],[26,1,"て"],[37,1,"おう"],[46,1,"て"],[56,1,"て"],[62,1,"わた"]],"text":"あなたの命を求める者の手、あなたがその顔を恐れる者の手、すなわちバビロンの王ネブカデレザルの手と、カルデヤびとの手にあなたを渡す。"},{"ref":"Jer.22.26","start":24022026,"end":24022026,"break":"none","ruby":[[14,1,"う"],[17,1,"はは"],[26,1,"うま"],[29,1,"くに"],[33,1,"た"],[35,1,"くに"],[37,1,"お"],[51,1,"し"]],"text":"わたしは、あなたと、あなたを産んだ母を、あなたがたの生れた国でない他の国に追いやる。あなたがたはそこで死ぬ。"},{"ref":"Jer.22.27","start":24022027,"end":24022027,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かえ"],[11,1,"ねが"],[13,1,"くに"],[16,1,"かれ"],[19,1,"ふたた"],[21,1,"かえ"]],"text":"彼らが帰りたいとせつに願う国に、彼らは再び帰ることができない」。"},{"ref":"Jer.22.28","start":24022028,"end":24022028,"break":"stanza","breaks":[[7,"line"],[25,"line"],[41,"line"],[57,"line"]],"ruby":[[2,1,"ひと"],[7,1,"いや"],[28,1,"こころ"],[30,1,"と"],[34,1,"うつわ"],[43,1,"かれ"],[47,2,"しそん"],[50,1,"お"],[57,1,"し"],[61,1,"ち"],[63,1,"な"]],"text":"この人コニヤは卑しむべき、こわれたつぼであろうか、だれも心に留めない器であろうか。なぜ彼とその子孫は追いやられて、知らない地に投げやられるのか。"},{"ref":"Jer.22.29","start":24022029,"end":24022029,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"ち"],[6,1,"ち"],[9,1,"ち"],[12,1,"しゅ"],[14,2,"ことば"],[17,1,"き"]],"text":"ああ、地よ、地よ、地よ、主の言葉を聞けよ。"},{"ref":"Jer.22.30","start":24022030,"end":24022030,"break":"line","breaks":[[9,"line"],[23,"line"],[33,"line"],[50,"line"],[66,"line"],[76,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[12,1,"ひと"],[15,1,"こ"],[18,1,"ひと"],[27,2,"いっしょう"],[33,1,"さか"],[41,1,"ひと"],[45,2,"きろく"],[52,2,"しそん"],[62,1,"さか"],[70,1,"くらい"],[79,1,"おさ"],[85,1,"ふたた"],[87,1,"おこ"]],"text":"主はこう言われる、「この人を、子なき人として、またその一生のうち、栄えることのない人として記録せよ。その子孫のうち、ひとりも栄えて、ダビデの位にすわり、ユダを治めるものが再び起らないからである」。"}]