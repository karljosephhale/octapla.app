[{"ref":"Isa.46.1","start":23046001,"end":23046001,"break":"paragraph","breaks":[[13,"line"],[29,"line"],[48,"line"]],"ruby":[[3,1,"ふ"],[13,1,"かれ"],[16,1,"ぞう"],[18,1,"けもの"],[20,2,"かちく"],[24,1,"うえ"],[35,1,"も"],[37,1,"ある"],[43,1,"に"],[48,1,"つか"],[51,1,"けもの"],[53,2,"おもに"]],"text":"ベルは伏し、ネボはかがみ、彼らの像は獣と家畜との上にある。あなたがたが持ち歩いたものは荷となり、疲れた獣の重荷となった。"},{"ref":"Isa.46.2","start":23046002,"end":23046002,"break":"line","breaks":[[15,"line"],[31,"line"]],"ruby":[[0,1,"かれ"],[7,1,"かれ"],[10,1,"とも"],[12,1,"ふ"],[15,2,"おもに"],[21,1,"もの"],[23,1,"すく"],[36,2,"じぶん"],[39,1,"とら"],[43,1,"い"]],"text":"彼らはかがみ、彼らは共に伏し、重荷となった者を救うことができずかえって、自分は捕われて行く。"},{"ref":"Isa.46.3","start":23046003,"end":23046003,"break":"paragraph","breaks":[[8,"line"],[26,"line"],[42,"line"],[63,"line"]],"ruby":[[5,1,"いえ"],[14,1,"いえ"],[16,1,"のこ"],[23,1,"もの"],[26,1,"うま"],[28,1,"で"],[30,1,"とき"],[38,1,"お"],[42,1,"たい"],[44,1,"で"],[46,1,"とき"],[54,1,"も"],[56,1,"はこ"],[60,1,"もの"],[67,1,"き"]],"text":"「ヤコブの家よ、イスラエルの家の残ったすべての者よ、生れ出た時から、わたしに負われ、胎を出た時から、わたしに持ち運ばれた者よ、わたしに聞け。"},{"ref":"Isa.46.4","start":23046004,"end":23046004,"break":"line","breaks":[[20,"line"],[39,"line"],[54,"line"]],"ruby":[[10,2,"としお"],[16,1,"かわ"],[20,2,"はくはつ"],[34,1,"も"],[36,1,"はこ"],[43,1,"つく"],[49,1,"かなら"],[51,1,"お"],[54,1,"も"],[56,1,"はこ"],[61,1,"すく"]],"text":"わたしはあなたがたの年老いるまで変らず、白髪となるまで、あなたがたを持ち運ぶ。わたしは造ったゆえ、必ず負い、持ち運び、かつ救う。"},{"ref":"Isa.46.5","start":23046005,"end":23046005,"break":"paragraph","breaks":[[18,"line"],[33,"line"]],"ruby":[[21,1,"ひと"]],"text":"あなたがたは、わたしをだれにたぐい、だれと等しくし、だれにくらべ、かつなぞらえようとするのか。"},{"ref":"Isa.46.6","start":23046006,"end":23046006,"break":"line","breaks":[[15,"line"],[32,"line"],[50,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ふくろ"],[10,1,"そそ"],[12,1,"だ"],[32,1,"きん"],[33,3,"ざいくにん"],[37,1,"やと"],[44,1,"かみ"],[46,1,"つく"],[55,1,"ふ"],[58,1,"おが"]],"text":"彼らは袋からこがねを注ぎ出し、はかりをもって、しろがねをはかり、金細工人を雇って、それを神に造らせ、これにひれ伏して拝む。"},{"ref":"Isa.46.7","start":23046007,"end":23046007,"break":"line","breaks":[[15,"line"],[37,"line"],[55,"line"],[77,"line"]],"ruby":[[0,1,"かれ"],[10,1,"かた"],[12,1,"の"],[15,1,"も"],[18,1,"い"],[24,1,"ところ"],[26,1,"お"],[32,1,"た"],[42,1,"ところ"],[45,1,"うご"],[55,1,"ひと"],[60,1,"よ"],[66,1,"こた"],[79,1,"かれ"],[83,1,"なや"],[87,1,"すく"]],"text":"彼らはこれをもたげて肩に載せ、持って行って、その所に置き、そこに立たせる。これはその所から動くことができない。人がこれに呼ばわっても答えることができない。また彼をその悩みから救うことができない。"},{"ref":"Isa.46.8","start":23046008,"end":23046008,"break":"paragraph","breaks":[[20,"line"]],"ruby":[[8,1,"こと"],[16,1,"かんが"],[24,1,"もの"],[29,1,"こと"],[31,1,"こころ"]],"text":"あなたがたはこの事をおぼえ、よく考えよ。そむける者よ、この事を心にとめよ、"},{"ref":"Isa.46.9","start":23046009,"end":23046009,"break":"line","breaks":[[18,"line"],[39,"line"]],"ruby":[[11,1,"こと"],[22,1,"かみ"],[34,1,"かみ"],[43,1,"かみ"],[52,1,"ひと"],[55,1,"もの"]],"text":"いにしえよりこのかたの事をおぼえよ。わたしは神である、わたしのほかに神はない。わたしは神である、わたしと等しい者はない。"},{"ref":"Isa.46.10","start":23046010,"end":23046010,"break":"line","breaks":[[16,"line"],[34,"line"],[49,"line"]],"ruby":[[4,1,"おわ"],[7,1,"こと"],[9,1,"はじ"],[13,1,"つ"],[23,1,"こと"],[25,1,"むかし"],[28,1,"つ"],[31,1,"い"],[39,1,"はか"],[44,1,"かなら"],[46,1,"な"],[51,2,"もくてき"],[61,1,"と"]],"text":"わたしは終りの事を初めから告げ、まだなされない事を昔から告げて言う、『わたしの計りごとは必ず成り、わが目的をことごとくなし遂げる』と。"},{"ref":"Isa.46.11","start":23046011,"end":23046011,"break":"line","breaks":[[13,"line"],[32,"line"],[53,"line"]],"ruby":[[4,1,"ひがし"],[7,2,"もうきん"],[10,1,"まね"],[13,1,"とお"],[15,1,"くに"],[20,1,"はか"],[25,1,"おこな"],[27,1,"ひと"],[29,1,"まね"],[38,1,"こと"],[40,1,"かた"],[46,1,"かなら"],[59,1,"こと"],[68,1,"かなら"],[70,1,"おこな"]],"text":"わたしは東から猛禽を招き、遠い国からわが計りごとを行う人を招く。わたしはこの事を語ったゆえ、必ずこさせる。わたしはこの事をはかったゆえ、必ず行う。"},{"ref":"Isa.46.12","start":23046012,"end":23046012,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[0,1,"こころ"],[10,1,"すくい"],[12,1,"とお"],[14,1,"もの"],[21,1,"き"]],"text":"心をかたくなにして、救に遠い者よ、わたしに聞け。"},{"ref":"Isa.46.13","start":23046013,"end":23046013,"break":"line","breaks":[[16,"line"],[28,"line"],[38,"line"],[51,"line"]],"ruby":[[6,1,"すくい"],[8,1,"ちか"],[18,1,"く"],[23,1,"とお"],[30,1,"すくい"],[42,1,"すくい"],[48,1,"あた"],[53,2,"えいこう"],[62,1,"あた"]],"text":"わたしはわが救を近づかせるゆえ、その来ることは遠くない。わが救はおそくない。わたしは救をシオンに与え、わが栄光をイスラエルに与える」。"}]