[{"ref":"Ps.27.1","start":19027001,"end":19027001,"break":"paragraph","title":"ダビデの歌","breaks":[[15,"line"],[27,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ひかり"],[12,1,"すくい"],[22,1,"おそ"],[27,1,"しゅ"],[33,1,"いのち"],[49,1,"おそ"]],"titleRuby":[[4,1,"うた"]],"text":"主はわたしの光、わたしの救だ、わたしはだれを恐れよう。主はわたしの命のとりでだ。わたしはだれをおじ恐れよう。"},{"ref":"Ps.27.2","start":19027002,"end":19027002,"break":"line","breaks":[[24,"line"],[48,"line"]],"ruby":[[11,1,"てき"],[15,1,"あく"],[17,1,"おこな"],[19,1,"もの"],[24,1,"おそ"],[42,1,"せ"],[48,1,"かれ"],[55,1,"たお"]],"text":"わたしのあだ、わたしの敵である悪を行う者どもが、襲ってきて、わたしをそしり、わたしを攻めるとき、彼らはつまずき倒れるであろう。"},{"ref":"Ps.27.3","start":19027003,"end":19027003,"break":"line","breaks":[[22,"line"],[33,"line"],[53,"line"]],"ruby":[[3,2,"ぐんぜい"],[6,2,"じんえい"],[9,1,"は"],[17,1,"せ"],[26,1,"こころ"],[28,1,"おそ"],[40,1,"た"],[48,1,"せ"],[63,1,"たの"]],"text":"たとい軍勢が陣営を張って、わたしを攻めても、わたしの心は恐れない。たといいくさが起って、わたしを攻めても、なおわたしはみずから頼むところがある。"},{"ref":"Ps.27.4","start":19027004,"end":19027004,"break":"line","breaks":[[15,"line"],[26,"line"],[45,"line"]],"ruby":[[7,1,"こと"],[9,1,"しゅ"],[11,1,"ねが"],[22,1,"もと"],[30,1,"い"],[37,1,"しゅ"],[39,1,"いえ"],[41,1,"す"],[45,1,"しゅ"],[53,1,"み"],[57,1,"みや"],[59,1,"たず"]],"text":"わたしは一つの事を主に願った、わたしはそれを求める。わたしの生きるかぎり、主の家に住んで、主のうるわしきを見、その宮で尋ねきわめることを。"},{"ref":"Ps.27.5","start":19027005,"end":19027005,"break":"line","breaks":[[11,"line"],[27,"line"],[41,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"なや"],[8,1,"ひ"],[13,2,"かりや"],[23,1,"ひそ"],[29,2,"まくや"],[32,1,"おく"],[38,1,"かく"],[41,1,"いわ"],[43,1,"うえ"],[49,1,"たか"],[51,1,"お"]],"text":"それは主が悩みの日に、その仮屋のうちにわたしを潜ませ、その幕屋の奥にわたしを隠し、岩の上にわたしを高く置かれるからである。"},{"ref":"Ps.27.6","start":19027006,"end":19027006,"break":"line","breaks":[[20,"line"],[28,"line"],[42,"line"],[60,"line"]],"ruby":[[0,1,"いま"],[16,1,"てき"],[18,1,"うえ"],[20,1,"たか"],[37,1,"しゅ"],[39,2,"まくや"],[42,1,"よろこ"],[45,1,"こえ"],[60,1,"うた"],[64,1,"しゅ"]],"text":"今わたしのこうべはわたしをめぐる敵の上に高くあげられる。それゆえ、わたしは主の幕屋で喜びの声をあげて、いけにえをささげ、歌って、主をほめたたえるであろう。"},{"ref":"Ps.27.7","start":19027007,"end":19027007,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"こえ"],[12,1,"よ"],[19,1,"き"],[36,1,"こた"]],"text":"主よ、わたしが声をあげて呼ばわるとき、聞いて、わたしをあわれみ、わたしに答えてください。"},{"ref":"Ps.27.8","start":19027008,"end":19027008,"break":"line","breaks":[[12,"line"],[26,"line"],[46,"line"]],"ruby":[[4,1,"おお"],[15,1,"かお"],[20,1,"もと"],[39,1,"こころ"],[41,1,"い"],[47,1,"しゅ"],[55,1,"かお"],[60,1,"もと"]],"text":"あなたは仰せられました、「わが顔をたずね求めよ」と。あなたにむかって、わたしの心は言います、「主よ、わたしはみ顔をたずね求めます」と。"},{"ref":"Ps.27.9","start":19027009,"end":19027009,"break":"line","breaks":[[17,"line"],[38,"line"],[51,"line"],[67,"line"]],"ruby":[[1,1,"かお"],[7,1,"かく"],[17,1,"いか"],[28,1,"しりぞ"],[46,1,"たす"],[53,1,"すくい"],[55,1,"かみ"],[62,1,"お"],[64,1,"だ"],[71,1,"す"]],"text":"み顔をわたしに隠さないでください。怒ってあなたのしもべを退けないでください。あなたはわたしの助けです。わが救の神よ、わたしを追い出し、わたしを捨てないでください。"},{"ref":"Ps.27.10","start":19027010,"end":19027010,"break":"line","breaks":[[15,"line"]],"ruby":[[3,2,"ふぼ"],[10,1,"す"],[15,1,"しゅ"],[21,1,"むか"]],"text":"たとい父母がわたしを捨てても、主がわたしを迎えられるでしょう。"},{"ref":"Ps.27.11","start":19027011,"end":19027011,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"みち"],[13,1,"おし"],[31,1,"たい"],[35,1,"みち"],[37,1,"みちび"]],"text":"主よ、あなたの道をわたしに教え、わたしのあだのゆえに、わたしを平らかな道に導いてください。"},{"ref":"Ps.27.12","start":19027012,"end":19027012,"break":"line","breaks":[[14,"line"],[30,"line"],[52,"line"]],"ruby":[[7,1,"のぞ"],[18,1,"ひ"],[20,1,"わた"],[30,1,"いつわ"],[39,1,"もの"],[45,1,"さか"],[49,1,"おこ"],[52,2,"ぼうげん"],[55,1,"は"]],"text":"わたしのあだの望むがままに、わたしを引き渡さないでください。偽りのあかしをする者がわたしに逆らって起り、暴言を吐くからです。"},{"ref":"Ps.27.13","start":19027013,"end":19027013,"break":"line","breaks":[[9,"line"]],"ruby":[[4,1,"しん"],[9,1,"い"],[12,1,"もの"],[14,1,"ち"],[20,1,"しゅ"],[22,1,"めぐ"],[25,1,"み"]],"text":"わたしは信じます、生ける者の地でわたしは主の恵みを見ることを。"},{"ref":"Ps.27.14","start":19027014,"end":19027014,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ま"],[4,1,"のぞ"],[7,1,"つよ"],[12,2,"おお"],[19,1,"しゅ"],[21,1,"ま"],[23,1,"のぞ"]],"text":"主を待ち望め、強く、かつ雄々しくあれ。主を待ち望め。"}]