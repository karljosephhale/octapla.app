[{"ref":"Matt.9.1","start":40009001,"end":40009001,"break":"paragraph","ruby":[[7,1,"ふね"],[9,1,"の"],[12,1,"うみ"],[14,1,"わた"],[17,2,"じぶん"],[20,1,"まち"],[22,1,"かえ"]],"text":"さて、イエスは舟に乗って海を渡り、自分の町に帰られた。"},{"ref":"Matt.9.2","start":40009002,"end":40009002,"break":"none","ruby":[[4,2,"ひとびと"],[7,2,"ちゅうぶ"],[10,1,"もの"],[12,1,"とこ"],[14,1,"うえ"],[16,1,"ね"],[27,1,"はこ"],[37,1,"かれ"],[40,2,"しんこう"],[43,1,"み"],[46,2,"ちゅうぶ"],[49,1,"もの"],[53,1,"こ"],[69,1,"つみ"],[80,1,"い"]],"text":"すると、人々が中風の者を床の上に寝かせたままでみもとに運んできた。イエスは彼らの信仰を見て、中風の者に、「子よ、しっかりしなさい。あなたの罪はゆるされたのだ」と言われた。"},{"ref":"Matt.9.3","start":40009003,"end":40009003,"break":"none","ruby":[[6,2,"りっぽう"],[8,2,"がくしゃ"],[13,1,"こころ"],[15,1,"なか"],[17,1,"い"],[24,1,"ひと"],[26,1,"かみ"],[28,1,"けが"]],"text":"すると、ある律法学者たちが心の中で言った、「この人は神を汚している」。"},{"ref":"Matt.9.4","start":40009004,"end":40009004,"break":"none","ruby":[[4,1,"かれ"],[7,1,"かんが"],[10,2,"みぬ"],[25,1,"こころ"],[27,1,"なか"],[29,1,"わる"],[34,1,"かんが"]],"text":"イエスは彼らの考えを見抜いて、「なぜ、あなたがたは心の中で悪いことを考えているのか。"},{"ref":"Matt.9.5","start":40009005,"end":40009005,"break":"none","ruby":[[4,1,"つみ"],[13,1,"い"],[18,1,"お"],[21,1,"ある"],[25,1,"い"]],"text":"あなたの罪はゆるされた、と言うのと、起きて歩け、と言うのと、どちらがたやすいか。"},{"ref":"Matt.9.6","start":40009006,"end":40009006,"break":"none","ruby":[[4,1,"ひと"],[6,1,"こ"],[8,2,"ちじょう"],[11,1,"つみ"],[16,2,"けんい"],[42,1,"い"],[45,2,"ちゅうぶ"],[48,1,"もの"],[56,1,"お"],[60,1,"とこ"],[62,1,"と"],[67,1,"いえ"],[69,1,"かえ"],[73,1,"い"]],"text":"しかし、人の子は地上で罪をゆるす権威をもっていることが、あなたがたにわかるために」と言い、中風の者にむかって、「起きよ、床を取りあげて家に帰れ」と言われた。"},{"ref":"Matt.9.7","start":40009007,"end":40009007,"break":"none","ruby":[[3,1,"かれ"],[5,1,"お"],[11,1,"いえ"],[13,1,"かえ"],[16,1,"い"]],"text":"すると彼は起きあがり、家に帰って行った。"},{"ref":"Matt.9.8","start":40009008,"end":40009008,"break":"none","ruby":[[0,2,"ぐんしゅう"],[6,1,"み"],[8,1,"おそ"],[14,1,"おお"],[17,2,"けんい"],[20,1,"ひと"],[23,1,"あた"],[29,1,"かみ"]],"text":"群衆はそれを見て恐れ、こんな大きな権威を人にお与えになった神をあがめた。"},{"ref":"Matt.9.9","start":40009009,"end":40009009,"break":"paragraph","ruby":[[10,1,"すす"],[13,1,"い"],[23,1,"ひと"],[25,3,"しゅうぜいしょ"],[37,1,"み"],[45,1,"したが"],[54,1,"い"],[62,1,"かれ"],[64,1,"た"],[75,1,"したが"]],"text":"さてイエスはそこから進んで行かれ、マタイという人が収税所にすわっているのを見て、「わたしに従ってきなさい」と言われた。すると彼は立ちあがって、イエスに従った。"},{"ref":"Matt.9.10","start":40009010,"end":40009010,"break":"none","ruby":[[9,1,"いえ"],[11,2,"しょくじ"],[14,1,"せき"],[23,1,"とき"],[31,1,"おお"],[34,3,"しゅぜいにん"],[38,2,"つみびと"],[50,2,"でし"],[55,1,"とも"],[59,1,"せき"],[61,1,"つ"]],"text":"それから、イエスが家で食事の席についておられた時のことである。多くの取税人や罪人たちがきて、イエスや弟子たちと共にその席に着いていた。"},{"ref":"Matt.9.11","start":40009011,"end":40009011,"break":"none","ruby":[[4,1,"びと"],[11,1,"み"],[14,2,"でし"],[19,1,"い"],[33,2,"せんせい"],[37,3,"しゅぜいにん"],[41,2,"つみびと"],[46,2,"しょくじ"],[49,1,"とも"]],"text":"パリサイ人たちはこれを見て、弟子たちに言った、「なぜ、あなたがたの先生は、取税人や罪人などと食事を共にするのか」。"},{"ref":"Matt.9.12","start":40009012,"end":40009012,"break":"none","ruby":[[7,1,"き"],[10,1,"い"],[16,2,"じょうぶ"],[19,1,"ひと"],[22,2,"いしゃ"],[34,2,"びょうにん"]],"text":"イエスはこれを聞いて言われた、「丈夫な人には医者はいらない。いるのは病人である。"},{"ref":"Matt.9.13","start":40009013,"end":40009013,"break":"none","ruby":[[5,1,"この"],[34,2,"いみ"],[38,1,"まな"],[55,2,"ぎじん"],[58,1,"まね"],[67,2,"つみびと"],[70,1,"まね"]],"text":"『わたしが好むのは、あわれみであって、いけにえではない』とはどういう意味か、学んできなさい。わたしがきたのは、義人を招くためではなく、罪人を招くためである」。"},{"ref":"Matt.9.14","start":40009014,"end":40009014,"break":"paragraph","ruby":[[9,2,"でし"],[24,1,"い"],[39,1,"びと"],[44,2,"だんじき"],[58,2,"でし"],[66,2,"だんじき"]],"text":"そのとき、ヨハネの弟子たちがイエスのところにきて言った、「わたしたちとパリサイ人たちとが断食をしているのに、あなたの弟子たちは、なぜ断食をしないのですか」。"},{"ref":"Matt.9.15","start":40009015,"end":40009015,"break":"none","ruby":[[7,1,"い"],[13,2,"こんれい"],[16,1,"きゃく"],[19,2,"はなむこ"],[22,2,"いっしょ"],[27,1,"あいだ"],[30,1,"かな"],[45,2,"はなむこ"],[48,1,"うば"],[50,1,"さ"],[54,1,"ひ"],[56,1,"く"],[61,1,"とき"],[64,2,"だんじき"]],"text":"するとイエスは言われた、「婚礼の客は、花婿が一緒にいる間は、悲しんでおられようか。しかし、花婿が奪い去られる日が来る。その時には断食をするであろう。"},{"ref":"Matt.9.16","start":40009016,"end":40009016,"break":"none","ruby":[[4,2,"まあたら"],[8,1,"ぬの"],[13,1,"ふる"],[15,2,"きもの"],[21,1,"あ"],[35,2,"きもの"],[38,1,"ひ"],[40,1,"やぶ"],[47,1,"やぶ"]],"text":"だれも、真新しい布ぎれで、古い着物につぎを当てはしない。そのつぎきれは着物を引き破り、そして、破れがもっとひどくなるから。"},{"ref":"Matt.9.17","start":40009017,"end":40009017,"break":"none","ruby":[[4,1,"あたら"],[10,1,"しゅ"],[12,1,"ふる"],[14,1,"かわ"],[15,1,"ぶくろ"],[17,1,"い"],[38,1,"かわ"],[39,1,"ぶくろ"],[41,1,"は"],[43,1,"さ"],[46,1,"さけ"],[48,1,"なが"],[50,1,"で"],[54,1,"かわ"],[55,1,"ぶくろ"],[67,1,"あたら"],[73,1,"しゅ"],[75,1,"あたら"],[78,1,"かわ"],[79,1,"ぶくろ"],[81,1,"い"],[95,2,"りょうほう"],[99,1,"なが"]],"text":"だれも、新しいぶどう酒を古い皮袋に入れはしない。もしそんなことをしたら、その皮袋は張り裂け、酒は流れ出るし、皮袋もむだになる。だから、新しいぶどう酒は新しい皮袋に入れるべきである。そうすれば両方とも長もちがするであろう」。"},{"ref":"Matt.9.18","start":40009018,"end":40009018,"break":"paragraph","ruby":[[7,1,"かれ"],[10,1,"はな"],[26,3,"かいどうづかさ"],[37,1,"はい"],[40,1,"い"],[49,1,"むすめ"],[53,1,"いま"],[54,1,"し"],[70,1,"て"],[74,1,"うえ"],[82,1,"くだ"],[92,1,"むすめ"],[94,1,"い"],[96,1,"かえ"]],"text":"これらのことを彼らに話しておられると、そこにひとりの会堂司がきて、イエスを拝して言った、「わたしの娘がただ今死にました。しかしおいでになって手をその上においてやって下さい。そうしたら、娘は生き返るでしょう」。"},{"ref":"Matt.9.19","start":40009019,"end":40009019,"break":"none","ruby":[[8,1,"た"],[11,1,"かれ"],[16,1,"い"],[22,2,"でし"],[27,2,"いっしょ"],[30,1,"い"]],"text":"そこで、イエスが立って彼について行かれると、弟子たちも一緒に行った。"},{"ref":"Matt.9.20","start":40009020,"end":40009020,"break":"none","ruby":[[10,2,"ねんかん"],[13,1,"なが"],[14,1,"ち"],[23,1,"おんな"],[25,2,"ちかよ"],[42,1,"ころも"]],"text":"するとそのとき、十二年間も長血をわずらっている女が近寄ってきて、イエスのうしろからみ衣のふさにさわった。"},{"ref":"Matt.9.21","start":40009021,"end":40009021,"break":"none","ruby":[[1,1,"ころも"],[26,1,"こころ"],[28,1,"なか"],[30,1,"おも"]],"text":"み衣にさわりさえすれば、なおしていただけるだろう、と心の中で思っていたからである。"},{"ref":"Matt.9.22","start":40009022,"end":40009022,"break":"none","ruby":[[4,1,"ふ"],[6,1,"む"],[12,1,"おんな"],[14,1,"み"],[16,1,"い"],[22,1,"むすめ"],[38,2,"しんこう"],[45,1,"すく"],[58,1,"おんな"],[62,1,"とき"]],"text":"イエスは振り向いて、この女を見て言われた、「娘よ、しっかりしなさい。あなたの信仰があなたを救ったのです」。するとこの女はその時に、いやされた。"},{"ref":"Matt.9.23","start":40009023,"end":40009023,"break":"none","ruby":[[8,1,"つかさ"],[10,1,"いえ"],[12,1,"つ"],[15,1,"ふえ"],[16,1,"ふ"],[21,1,"さわ"],[26,2,"ぐんしゅう"],[29,1,"み"],[31,1,"い"]],"text":"それからイエスは司の家に着き、笛吹きどもや騒いでいる群衆を見て言われた。"},{"ref":"Matt.9.24","start":40009024,"end":40009024,"break":"none","ruby":[[5,1,"い"],[13,2,"しょうじょ"],[16,1,"し"],[25,1,"ねむ"],[40,2,"ひとびと"],[49,1,"わら"]],"text":"「あちらへ行っていなさい。少女は死んだのではない。眠っているだけである」。すると人々はイエスをあざ笑った。"},{"ref":"Matt.9.25","start":40009025,"end":40009025,"break":"none","ruby":[[4,2,"ぐんしゅう"],[7,1,"そと"],[9,1,"だ"],[19,1,"うち"],[26,2,"しょうじょ"],[29,1,"て"],[32,1,"と"],[39,2,"しょうじょ"],[42,1,"お"]],"text":"しかし、群衆を外へ出したのち、イエスは内へはいって、少女の手をお取りになると、少女は起きあがった。"},{"ref":"Matt.9.26","start":40009026,"end":40009026,"break":"none","ruby":[[12,2,"ちほう"],[14,2,"ぜんたい"]],"text":"そして、そのうわさがこの地方全体にひろまった。"},{"ref":"Matt.9.27","start":40009027,"end":40009027,"break":"paragraph","ruby":[[4,1,"すす"],[7,1,"い"],[17,2,"もうじん"],[26,1,"こ"],[40,1,"くだ"],[45,1,"さけ"]],"text":"そこから進んで行かれると、ふたりの盲人が、「ダビデの子よ、わたしたちをあわれんで下さい」と叫びながら、イエスについてきた。"},{"ref":"Matt.9.28","start":40009028,"end":40009028,"break":"none","ruby":[[7,1,"いえ"],[16,2,"もうじん"],[30,1,"かれ"],[45,1,"しん"],[51,1,"い"],[56,1,"かれ"],[59,1,"い"],[64,1,"しゅ"],[67,1,"しん"]],"text":"そしてイエスが家にはいられると、盲人たちがみもとにきたので、彼らに「わたしにそれができると信じるか」と言われた。彼らは言った、「主よ、信じます」。"},{"ref":"Matt.9.29","start":40009029,"end":40009029,"break":"none","ruby":[[8,1,"かれ"],[11,1,"め"],[17,1,"い"],[29,2,"しんこう"],[41,1,"み"]],"text":"そこで、イエスは彼らの目にさわって言われた、「あなたがたの信仰どおり、あなたがたの身になるように」。"},{"ref":"Matt.9.30","start":40009030,"end":40009030,"break":"none","ruby":[[3,1,"かれ"],[6,1,"め"],[8,1,"ひら"],[17,1,"かれ"],[24,1,"いまし"],[27,1,"い"],[37,1,"し"],[44,1,"き"]],"text":"すると彼らの目が開かれた。イエスは彼らをきびしく戒めて言われた、「だれにも知れないように気をつけなさい」。"},{"ref":"Matt.9.31","start":40009031,"end":40009031,"break":"none","ruby":[[4,1,"かれ"],[7,1,"で"],[9,1,"い"],[15,2,"ちほう"],[17,2,"ぜんたい"],[27,1,"い"]],"text":"しかし、彼らは出て行って、その地方全体にイエスのことを言いひろめた。"},{"ref":"Matt.9.32","start":40009032,"end":40009032,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"で"],[5,1,"い"],[9,2,"ひとびと"],[12,2,"あくれい"],[30,1,"つ"]],"text":"彼らが出て行くと、人々は悪霊につかれたおしをイエスのところに連れてきた。"},{"ref":"Matt.9.33","start":40009033,"end":40009033,"break":"none","ruby":[[4,2,"あくれい"],[7,1,"お"],[9,1,"だ"],[17,1,"もの"],[19,1,"い"],[28,2,"ぐんしゅう"],[31,1,"おどろ"],[50,1,"なか"],[52,1,"み"],[64,2,"いちど"],[73,1,"い"]],"text":"すると、悪霊は追い出されて、おしが物を言うようになった。群衆は驚いて、「このようなことがイスラエルの中で見られたことは、これまで一度もなかった」と言った。"},{"ref":"Matt.9.34","start":40009034,"end":40009034,"break":"none","ruby":[[8,1,"びと"],[12,1,"い"],[17,1,"かれ"],[20,2,"あくれい"],[32,2,"あくれい"],[37,1,"お"],[39,1,"だ"]],"text":"しかし、パリサイ人たちは言った、「彼は、悪霊どものかしらによって悪霊どもを追い出しているのだ」。"},{"ref":"Matt.9.35","start":40009035,"end":40009035,"break":"paragraph","ruby":[[9,2,"まちまち"],[11,2,"むらむら"],[14,1,"めぐ"],[16,1,"ある"],[20,1,"しょ"],[21,2,"かいどう"],[24,1,"おし"],[27,2,"みくに"],[30,2,"ふくいん"],[33,1,"の"],[35,1,"つた"],[42,2,"びょうき"]],"text":"イエスは、すべての町々村々を巡り歩いて、諸会堂で教え、御国の福音を宣べ伝え、あらゆる病気、あらゆるわずらいをおいやしになった。"},{"ref":"Matt.9.36","start":40009036,"end":40009036,"break":"none","ruby":[[2,2,"ぐんしゅう"],[5,1,"か"],[7,1,"もの"],[11,1,"ひつじ"],[16,1,"よわ"],[18,1,"は"],[22,1,"たお"],[37,1,"かれ"],[40,1,"ふか"]],"text":"また群衆が飼う者のない羊のように弱り果てて、倒れているのをごらんになって、彼らを深くあわれまれた。"},{"ref":"Matt.9.37","start":40009037,"end":40009037,"break":"none","ruby":[[3,2,"でし"],[8,1,"い"],[14,2,"しゅうかく"],[17,1,"おお"],[21,1,"はたら"],[23,1,"びと"],[25,1,"すく"]],"text":"そして弟子たちに言われた、「収穫は多いが、働き人が少ない。"},{"ref":"Matt.9.38","start":40009038,"end":40009038,"break":"none","ruby":[[4,2,"しゅうかく"],[7,1,"しゅ"],[9,1,"ねが"],[15,2,"しゅうかく"],[21,1,"はたら"],[23,1,"びと"],[25,1,"おく"],[27,1,"だ"]],"text":"だから、収穫の主に願って、その収穫のために働き人を送り出すようにしてもらいなさい」。"}]