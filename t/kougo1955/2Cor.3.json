[{"ref":"2Cor.3.1","start":47003001,"end":47003001,"break":"paragraph","ruby":[[12,2,"じこ"],[14,2,"すいせん"],[18,1,"はじ"],[36,2,"ひとびと"],[66,2,"すいせん"],[68,1,"じょう"],[70,2,"ひつよう"]],"text":"わたしたちは、またもや、自己推薦をし始めているのだろうか。それとも、ある人々のように、あなたがたにあてた、あるいは、あなたがたからの推薦状が必要なのだろうか。"},{"ref":"2Cor.3.2","start":47003002,"end":47003002,"break":"none","ruby":[[6,2,"すいせん"],[8,1,"じょう"],[32,1,"こころ"],[46,1,"ひと"],[48,1,"し"],[54,1,"よ"]],"text":"わたしたちの推薦状は、あなたがたなのである。それは、わたしたちの心にしるされていて、すべての人に知られ、かつ読まれている。"},{"ref":"2Cor.3.3","start":47003003,"end":47003003,"break":"none","ruby":[[10,2,"じぶん"],[12,2,"じしん"],[23,1,"おく"],[32,2,"てがみ"],[39,1,"すみ"],[44,1,"い"],[47,1,"かみ"],[49,1,"れい"],[54,1,"か"],[58,1,"いし"],[60,1,"いた"],[66,1,"ひと"],[68,1,"こころ"],[70,1,"いた"],[72,1,"か"]],"text":"そして、あなたがたは自分自身が、わたしたちから送られたキリストの手紙であって、墨によらず生ける神の霊によって書かれ、石の板にではなく人の心の板に書かれたものであることを、はっきりとあらわしている。"},{"ref":"2Cor.3.4","start":47003004,"end":47003004,"break":"paragraph","ruby":[[4,2,"かくしん"],[21,1,"かみ"],[23,1,"たい"]],"text":"こうした確信を、わたしたちはキリストにより神に対していだいている。"},{"ref":"2Cor.3.5","start":47003005,"end":47003005,"break":"none","ruby":[[5,2,"じぶん"],[7,2,"じしん"],[10,1,"こと"],[12,1,"さだ"],[15,1,"ちから"],[17,2,"じぶん"],[24,1,"い"],[42,1,"ちから"],[45,1,"かみ"]],"text":"もちろん、自分自身で事を定める力が自分にある、と言うのではない。わたしたちのこうした力は、神からきている。"},{"ref":"2Cor.3.6","start":47003006,"end":47003006,"break":"none","ruby":[[0,1,"かみ"],[8,1,"ちから"],[10,1,"あた"],[14,1,"あたら"],[17,2,"けいやく"],[20,1,"つか"],[23,1,"もの"],[37,2,"もんじ"],[40,1,"つか"],[43,1,"もの"],[49,1,"れい"],[51,1,"つか"],[54,1,"もの"],[59,2,"もんじ"],[62,1,"ひと"],[64,1,"ころ"],[67,1,"れい"],[69,1,"ひと"],[71,1,"い"]],"text":"神はわたしたちに力を与えて、新しい契約に仕える者とされたのである。それは、文字に仕える者ではなく、霊に仕える者である。文字は人を殺し、霊は人を生かす。"},{"ref":"2Cor.3.7","start":47003007,"end":47003007,"break":"none","ruby":[[2,1,"いし"],[4,1,"ほ"],[9,2,"もんじ"],[14,1,"し"],[16,1,"つとめ"],[18,2,"えいこう"],[24,1,"おこな"],[38,1,"こ"],[46,1,"かお"],[48,1,"き"],[50,1,"さ"],[54,2,"えいこう"],[63,1,"かお"],[65,1,"み"]],"text":"もし石に彫りつけた文字による死の務が栄光のうちに行われ、そのためイスラエルの子らは、モーセの顔の消え去るべき栄光のゆえに、その顔を見つめることができなかったとすれば、"},{"ref":"2Cor.3.8","start":47003008,"end":47003008,"break":"none","ruby":[[3,1,"れい"],[5,1,"つとめ"],[12,2,"えいこう"]],"text":"まして霊の務は、はるかに栄光あるものではなかろうか。"},{"ref":"2Cor.3.9","start":47003009,"end":47003009,"break":"none","ruby":[[2,1,"つみ"],[4,2,"せんこく"],[8,1,"つとめ"],[10,2,"えいこう"],[22,1,"ぎ"],[24,2,"せんこく"],[28,1,"つとめ"],[35,2,"えいこう"],[38,1,"み"]],"text":"もし罪を宣告する務が栄光あるものだとすれば、義を宣告する務は、はるかに栄光に満ちたものである。"},{"ref":"2Cor.3.10","start":47003010,"end":47003010,"break":"none","ruby":[[7,2,"えいこう"],[10,1,"う"],[19,2,"ばあい"],[30,2,"えいこう"],[39,2,"えいこう"],[42,1,"うしな"]],"text":"そして、すでに栄光を受けたものも、この場合、はるかにまさった栄光のまえに、その栄光を失ったのである。"},{"ref":"2Cor.3.11","start":47003011,"end":47003011,"break":"none","ruby":[[2,1,"き"],[4,1,"さ"],[11,2,"えいこう"],[17,1,"あらわ"],[27,2,"えいぞん"],[39,2,"えいこう"]],"text":"もし消え去るべきものが栄光をもって現れたのなら、まして永存すべきものは、もっと栄光のあるべきものである。"},{"ref":"2Cor.3.12","start":47003012,"end":47003012,"break":"paragraph","ruby":[[4,1,"のぞ"],[22,1,"おも"],[27,2,"だいたん"],[30,1,"かた"]],"text":"こうした望みをいだいているので、わたしたちは思いきって大胆に語り、"},{"ref":"2Cor.3.13","start":47003013,"end":47003013,"break":"none","ruby":[[8,1,"き"],[10,1,"さ"],[18,2,"さいご"],[27,1,"こ"],[30,1,"み"],[39,1,"かお"]],"text":"そしてモーセが、消え去っていくものの最後をイスラエルの子らに見られまいとして、顔におおいをかけたようなことはしない。"},{"ref":"2Cor.3.14","start":47003014,"end":47003014,"break":"none","ruby":[[0,2,"じっさい"],[3,1,"かれ"],[6,1,"おも"],[9,1,"にぶ"],[17,2,"こんにち"],[20,1,"いた"],[25,1,"かれ"],[28,1,"ふる"],[30,2,"けいやく"],[33,2,"ろうどく"],[37,2,"ばあい"],[42,1,"おな"],[48,1,"と"],[50,1,"さ"],[58,1,"のこ"],[80,1,"と"],[82,1,"のぞ"]],"text":"実際、彼らの思いは鈍くなっていた。今日に至るまで、彼らが古い契約を朗読する場合、その同じおおいが取り去られないままで残っている。それは、キリストにあってはじめて取り除かれるのである。"},{"ref":"2Cor.3.15","start":47003015,"end":47003015,"break":"none","ruby":[[0,2,"こんにち"],[3,1,"いた"],[13,1,"しょ"],[15,2,"ろうどく"],[28,1,"かれ"],[31,1,"こころ"]],"text":"今日に至るもなお、モーセの書が朗読されるたびに、おおいが彼らの心にかかっている。"},{"ref":"2Cor.3.16","start":47003016,"end":47003016,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"む"],[7,1,"とき"],[17,1,"と"],[19,1,"のぞ"]],"text":"しかし主に向く時には、そのおおいは取り除かれる。"},{"ref":"2Cor.3.17","start":47003017,"end":47003017,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"れい"],[11,1,"しゅ"],[13,1,"れい"],[23,2,"じゆう"]],"text":"主は霊である。そして、主の霊のあるところには、自由がある。"},{"ref":"2Cor.3.18","start":47003018,"end":47003018,"break":"none","ruby":[[9,1,"かお"],[17,1,"しゅ"],[19,2,"えいこう"],[22,1,"かがみ"],[24,1,"うつ"],[29,1,"み"],[33,2,"えいこう"],[37,2,"えいこう"],[42,1,"しゅ"],[44,1,"おな"],[46,1,"すがた"],[48,1,"か"],[59,1,"れい"],[62,1,"しゅ"],[64,1,"はたら"]],"text":"わたしたちはみな、顔おおいなしに、主の栄光を鏡に映すように見つつ、栄光から栄光へと、主と同じ姿に変えられていく。これは霊なる主の働きによるのである。"}]