[{"ref":"Jas.1.1","start":59001001,"end":59001001,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"しゅ"],[13,1,"しもべ"],[20,2,"りさん"],[28,2,"ぶぞく"],[31,2,"ひとびと"]],"text":"神と主イエス・キリストとの僕ヤコブから、離散している十二部族の人々へ、あいさつをおくる。"},{"ref":"Jas.1.2","start":59001002,"end":59001002,"break":"paragraph","ruby":[[4,2,"きょうだい"],[22,2,"しれん"],[25,1,"あ"],[28,2,"ばあい"],[37,2,"ひじょう"],[40,1,"よろこ"],[47,1,"おも"]],"text":"わたしの兄弟たちよ。あなたがたが、いろいろな試錬に会った場合、それをむしろ非常に喜ばしいことと思いなさい。"},{"ref":"Jas.1.3","start":59001003,"end":59001003,"break":"none","ruby":[[6,1,"し"],[15,2,"しんこう"],[30,2,"にんたい"],[33,1,"う"],[35,1,"だ"]],"text":"あなたがたの知っているとおり、信仰がためされることによって、忍耐が生み出されるからである。"},{"ref":"Jas.1.4","start":59001004,"end":59001004,"break":"none","ruby":[[7,2,"けってん"],[13,2,"かんぜん"],[19,1,"あ"],[23,1,"ひと"],[33,3,"にんたいりょく"],[37,2,"じゅうぶん"],[40,1,"はたら"]],"text":"だから、なんら欠点のない、完全な、でき上がった人となるように、その忍耐力を十分に働かせるがよい。"},{"ref":"Jas.1.5","start":59001005,"end":59001005,"break":"paragraph","ruby":[[9,2,"ちえ"],[12,2,"ふそく"],[18,1,"もの"],[26,1,"ひと"],[36,1,"お"],[45,1,"ひと"],[47,1,"あた"],[50,1,"かみ"],[53,1,"ねが"],[55,1,"もと"],[68,1,"あた"]],"text":"あなたがたのうち、知恵に不足している者があれば、その人は、とがめもせずに惜しみなくすべての人に与える神に、願い求めるがよい。そうすれば、与えられるであろう。"},{"ref":"Jas.1.6","start":59001006,"end":59001006,"break":"none","ruby":[[3,1,"うたが"],[9,2,"しんこう"],[15,1,"ねが"],[17,1,"もと"],[23,1,"うたが"],[25,1,"ひと"],[28,1,"かぜ"],[30,1,"ふ"],[35,1,"ゆ"],[37,1,"うご"],[39,1,"うみ"],[41,1,"なみ"],[43,1,"に"]],"text":"ただ、疑わないで、信仰をもって願い求めなさい。疑う人は、風の吹くままに揺れ動く海の波に似ている。"},{"ref":"Jas.1.7","start":59001007,"end":59001007,"break":"none","ruby":[[4,1,"ひと"],[7,1,"しゅ"],[10,1,"なに"],[24,1,"おも"]],"text":"そういう人は、主から何かをいただけるもののように思うべきではない。"},{"ref":"Jas.1.8","start":59001008,"end":59001008,"break":"none","ruby":[[3,2,"にんげん"],[7,2,"ふたごころ"],[10,1,"もの"],[22,2,"こうどう"],[25,2,"あんてい"]],"text":"そんな人間は、二心の者であって、そのすべての行動に安定がない。"},{"ref":"Jas.1.9","start":59001009,"end":59001009,"break":"paragraph","ruby":[[0,1,"ひく"],[2,2,"みぶん"],[5,2,"きょうだい"],[9,2,"じぶん"],[12,1,"たか"],[20,1,"よろこ"]],"text":"低い身分の兄弟は、自分が高くされたことを喜びなさい。"},{"ref":"Jas.1.10","start":59001010,"end":59001010,"break":"none","ruby":[[3,1,"と"],[8,1,"もの"],[11,2,"じぶん"],[14,1,"ひく"],[22,1,"よろこ"],[28,1,"と"],[33,1,"もの"],[36,2,"くさばな"],[42,1,"す"],[44,1,"さ"]],"text":"また、富んでいる者は、自分が低くされたことを喜ぶがよい。富んでいる者は、草花のように過ぎ去るからである。"},{"ref":"Jas.1.11","start":59001011,"end":59001011,"break":"none","ruby":[[5,2,"たいよう"],[8,1,"のぼ"],[11,2,"ねっぷう"],[19,1,"くさ"],[21,1,"か"],[30,1,"はな"],[32,1,"お"],[37,1,"うつく"],[40,1,"すがた"],[42,1,"き"],[54,1,"おな"],[60,1,"と"],[65,1,"もの"],[70,2,"いっしょう"],[73,1,"たび"],[78,2,"ぼつらく"]],"text":"たとえば、太陽が上って熱風をおくると、草を枯らす。そしてその花は落ち、その美しい姿は消えうせてしまう。それと同じように、富んでいる者も、その一生の旅なかばで没落するであろう。"},{"ref":"Jas.1.12","start":59001012,"end":59001012,"break":"paragraph","ruby":[[0,2,"しれん"],[3,1,"た"],[5,1,"しの"],[7,1,"ひと"],[21,1,"しの"],[30,1,"かみ"],[32,1,"あい"],[35,1,"もの"],[39,2,"やくそく"],[48,1,"かんむり"],[50,1,"う"]],"text":"試錬を耐え忍ぶ人は、さいわいである。それを忍びとおしたなら、神を愛する者たちに約束されたいのちの冠を受けるであろう。"},{"ref":"Jas.1.13","start":59001013,"end":59001013,"break":"none","ruby":[[4,2,"ゆうわく"],[7,1,"あ"],[9,2,"ばあい"],[15,2,"ゆうわく"],[19,1,"かみ"],[29,1,"い"],[38,1,"かみ"],[40,1,"あく"],[42,2,"ゆうわく"],[45,1,"おちい"],[59,1,"みずか"],[61,1,"すす"],[64,1,"ひと"],[66,2,"ゆうわく"]],"text":"だれでも誘惑に会う場合、「この誘惑は、神からきたものだ」と言ってはならない。神は悪の誘惑に陥るようなかたではなく、また自ら進んで人を誘惑することもなさらない。"},{"ref":"Jas.1.14","start":59001014,"end":59001014,"break":"none","ruby":[[0,1,"ひと"],[2,2,"ゆうわく"],[5,1,"おちい"],[15,1,"よく"],[17,1,"ひ"]],"text":"人が誘惑に陥るのは、それぞれ、欲に引かれ、さそわれるからである。"},{"ref":"Jas.1.15","start":59001015,"end":59001015,"break":"none","ruby":[[0,1,"よく"],[6,1,"つみ"],[8,1,"う"],[11,1,"つみ"],[13,1,"じゅく"],[16,1,"し"],[18,1,"う"],[20,1,"だ"]],"text":"欲がはらんで罪を生み、罪が熟して死を生み出す。"},{"ref":"Jas.1.16","start":59001016,"end":59001016,"break":"none","ruby":[[0,1,"あい"],[3,2,"きょうだい"],[9,1,"おも"],[11,1,"ちが"]],"text":"愛する兄弟たちよ。思い違いをしてはいけない。"},{"ref":"Jas.1.17","start":59001017,"end":59001017,"break":"paragraph","ruby":[[4,1,"よ"],[6,1,"おく"],[8,1,"もの"],[14,2,"かんぜん"],[17,2,"たまもの"],[21,1,"うえ"],[25,1,"ひかり"],[27,1,"ちち"],[30,1,"くだ"],[33,1,"く"],[36,1,"ちち"],[40,2,"へんか"],[44,2,"かいてん"],[47,1,"かげ"]],"text":"あらゆる良い贈り物、あらゆる完全な賜物は、上から、光の父から下って来る。父には、変化とか回転の影とかいうものはない。"},{"ref":"Jas.1.18","start":59001018,"end":59001018,"break":"none","ruby":[[0,1,"ちち"],[13,1,"ひ"],[14,2,"ぞうぶつ"],[17,2,"はつほ"],[26,2,"しんり"],[29,2,"ことば"],[35,2,"みむね"],[42,1,"う"],[44,1,"だ"],[47,1,"くだ"]],"text":"父は、わたしたちを、いわば被造物の初穂とするために、真理の言葉によって御旨のままに、生み出して下さったのである。"},{"ref":"Jas.1.19","start":59001019,"end":59001019,"break":"paragraph","ruby":[[0,1,"あい"],[3,2,"きょうだい"],[14,1,"し"],[23,1,"ひと"],[29,1,"き"],[32,1,"はや"],[35,1,"かた"],[42,1,"いか"]],"text":"愛する兄弟たちよ。このことを知っておきなさい。人はすべて、聞くに早く、語るにおそく、怒るにおそくあるべきである。"},{"ref":"Jas.1.20","start":59001020,"end":59001020,"break":"none","ruby":[[0,1,"ひと"],[2,1,"いか"],[6,1,"かみ"],[8,1,"ぎ"],[10,1,"まっと"]],"text":"人の怒りは、神の義を全うするものではないからである。"},{"ref":"Jas.1.21","start":59001021,"end":59001021,"break":"none","ruby":[[8,1,"けが"],[18,1,"あく"],[20,1,"す"],[22,1,"さ"],[26,1,"こころ"],[28,1,"う"],[37,2,"みことば"],[45,1,"う"],[47,1,"い"],[53,2,"みことば"],[69,1,"すく"],[71,1,"ちから"]],"text":"だから、すべての汚れや、はなはだしい悪を捨て去って、心に植えつけられている御言を、すなおに受け入れなさい。御言には、あなたがたのたましいを救う力がある。"},{"ref":"Jas.1.22","start":59001022,"end":59001022,"break":"none","ruby":[[4,2,"みことば"],[7,1,"おこな"],[9,1,"ひと"],[21,1,"あざむ"],[27,1,"き"],[32,1,"もの"]],"text":"そして、御言を行う人になりなさい。おのれを欺いて、ただ聞くだけの者となってはいけない。"},{"ref":"Jas.1.23","start":59001023,"end":59001023,"break":"none","ruby":[[4,2,"みことば"],[7,1,"き"],[12,1,"おこな"],[16,1,"ひと"],[24,2,"じぶん"],[27,1,"うま"],[32,1,"かお"],[34,1,"かがみ"],[36,1,"うつ"],[39,1,"み"],[41,1,"ひと"]],"text":"おおよそ御言を聞くだけで行わない人は、ちょうど、自分の生れつきの顔を鏡に映して見る人のようである。"},{"ref":"Jas.1.24","start":59001024,"end":59001024,"break":"none","ruby":[[0,1,"かれ"],[2,2,"じぶん"],[5,1,"うつ"],[8,1,"み"],[14,1,"た"],[16,1,"さ"],[27,2,"じぶん"],[30,1,"すがた"],[41,1,"わす"]],"text":"彼は自分を映して見てそこから立ち去ると、そのとたんに、自分の姿がどんなであったかを忘れてしまう。"},{"ref":"Jas.1.25","start":59001025,"end":59001025,"break":"none","ruby":[[3,1,"はん"],[7,2,"かんぜん"],[10,2,"じゆう"],[13,2,"りっぽう"],[16,2,"いっしん"],[19,1,"み"],[28,1,"ひと"],[31,1,"き"],[34,1,"わす"],[40,1,"ひと"],[47,2,"じっさい"],[50,1,"おこな"],[52,1,"ひと"],[61,1,"ひと"],[66,1,"おこな"],[72,2,"しゅくふく"]],"text":"これに反して、完全な自由の律法を一心に見つめてたゆまない人は、聞いて忘れてしまう人ではなくて、実際に行う人である。こういう人は、その行いによって祝福される。"},{"ref":"Jas.1.26","start":59001026,"end":59001026,"break":"paragraph","ruby":[[2,1,"ひと"],[4,2,"しんじん"],[6,1,"ぶか"],[8,1,"もの"],[11,2,"じにん"],[18,1,"した"],[20,1,"せい"],[29,2,"じぶん"],[32,1,"こころ"],[34,1,"あざむ"],[45,1,"ひと"],[47,2,"しんじん"]],"text":"もし人が信心深い者だと自任しながら、舌を制することをせず、自分の心を欺いているならば、その人の信心はむなしいものである。"},{"ref":"Jas.1.27","start":59001027,"end":59001027,"break":"none","ruby":[[0,1,"ちち"],[3,1,"かみ"],[9,1,"きよ"],[11,1,"けが"],[16,2,"しんじん"],[21,1,"こま"],[26,2,"こじ"],[34,2,"みま"],[38,1,"みずか"],[41,1,"よ"],[43,1,"けが"],[46,1,"そ"],[51,1,"み"],[53,1,"きよ"],[55,1,"たも"]],"text":"父なる神のみまえに清く汚れのない信心とは、困っている孤児や、やもめを見舞い、自らは世の汚れに染まずに、身を清く保つことにほかならない。"}]