[{"ref":"Hos.11.1","start":28011001,"end":28011001,"break":"paragraph","breaks":[[14,"line"],[21,"line"]],"ruby":[[10,1,"おさな"],[12,1,"とき"],[17,1,"あい"],[27,1,"こ"],[35,1,"よ"],[37,1,"だ"]],"text":"わたしはイスラエルの幼い時、これを愛した。わたしはわが子をエジプトから呼び出した。"},{"ref":"Hos.11.2","start":28011002,"end":28011002,"break":"line","breaks":[[15,"line"],[32,"line"],[48,"line"]],"ruby":[[4,1,"よ"],[15,1,"かれ"],[27,1,"とお"],[41,2,"ぎせい"],[48,1,"きざ"],[51,1,"ぞう"],[53,1,"こう"]],"text":"わたしが呼ばわるにしたがって、彼らはいよいよわたしから遠ざかり、もろもろのバアルに犠牲をささげ、刻んだ像に香をたいた。"},{"ref":"Hos.11.3","start":28011003,"end":28011003,"break":"stanza","breaks":[[18,"line"],[32,"line"],[49,"line"]],"ruby":[[10,1,"あゆ"],[15,1,"おし"],[18,1,"かれ"],[25,1,"うで"],[35,1,"かれ"],[47,1,"こと"],[49,1,"し"]],"text":"わたしはエフライムに歩むことを教え、彼らをわたしの腕にいだいた。しかし彼らはわたしにいやされた事を知らなかった。"},{"ref":"Hos.11.4","start":28011004,"end":28011004,"break":"line","breaks":[[11,"line"],[27,"line"],[39,"line"],[59,"line"]],"ruby":[[9,1,"つな"],[15,1,"あい"],[20,1,"かれ"],[23,1,"みちび"],[31,1,"かれ"],[34,1,"たい"],[51,1,"もの"],[63,1,"かれ"],[66,2,"しょくもつ"],[69,1,"あた"]],"text":"わたしはあわれみの綱、すなわち愛のひもで彼らを導いた。わたしは彼らに対しては、あごから、くびきをはずす者のようになり、かがんで彼らに食物を与えた。"},{"ref":"Hos.11.5","start":28011005,"end":28011005,"break":"stanza","breaks":[[13,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[8,1,"ち"],[10,1,"かえ"],[21,1,"かれ"],[24,1,"おう"],[29,1,"かれ"],[36,1,"かえ"],[41,1,"こば"]],"text":"彼らはエジプトの地に帰り、アッスリヤびとが彼らの王となる。彼らがわたしに帰ることを拒んだからである。"},{"ref":"Hos.11.6","start":28011006,"end":28011006,"break":"line","breaks":[[19,"line"]],"ruby":[[12,1,"まち"],[16,1,"くる"],[21,1,"もん"],[23,1,"かん"],[25,1,"き"],[27,1,"くだ"],[32,1,"しろ"],[34,1,"なか"],[36,1,"かれ"],[39,1,"ほろ"]],"text":"つるぎは、そのもろもろの町にあれ狂い、その門の貫の木を砕き、その城の中に彼らを滅ぼす。"},{"ref":"Hos.11.7","start":28011007,"end":28011007,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[2,1,"たみ"],[12,1,"さ"],[26,1,"かれ"],[41,1,"のぞ"],[45,1,"もの"]],"text":"わが民はわたしからそむき去ろうとしている。それゆえ、彼らはくびきをかけられ、これを除きうる者はひとりもいない。"},{"ref":"Hos.11.8","start":28011008,"end":28011008,"break":"stanza","breaks":[[7,"line"],[28,"line"],[35,"line"],[54,"line"],[69,"line"],[80,"line"],[96,"line"],[107,"line"],[124,"line"]],"ruby":[[16,1,"す"],[43,1,"わた"],[96,1,"あつか"],[111,1,"こころ"],[121,1,"かわ"],[141,1,"た"]],"text":"エフライムよ、どうして、あなたを捨てることができようか。イスラエルよ、どうしてあなたを渡すことができようか。どうしてあなたをアデマのようにすることができようか。どうしてあなたをゼボイムのように扱うことができようか。わたしの心は、わたしのうちに変り、わたしのあわれみは、ことごとくもえ起っている。"},{"ref":"Hos.11.9","start":28011009,"end":28011009,"break":"line","breaks":[[21,"line"],[39,"line"],[55,"line"],[75,"line"]],"ruby":[[8,1,"はげ"],[11,1,"いか"],[25,1,"ふたた"],[33,1,"ほろ"],[43,1,"かみ"],[49,1,"ひと"],[64,1,"せい"],[67,1,"もの"],[79,1,"ほろ"],[85,1,"のぞ"]],"text":"わたしはわたしの激しい怒りをあらわさない。わたしは再びエフライムを滅ぼさない。わたしは神であって、人ではなく、あなたのうちにいる聖なる者だからである。わたしは滅ぼすために臨むことをしない。"},{"ref":"Hos.11.10","start":28011010,"end":28011010,"break":"stanza","breaks":[[11,"line"],[29,"line"],[39,"line"]],"ruby":[[0,1,"かれ"],[3,1,"しゅ"],[5,1,"したが"],[8,1,"あゆ"],[11,1,"しゅ"],[22,1,"こえ"],[24,1,"だ"],[29,1,"しゅ"],[31,1,"こえ"],[33,1,"だ"],[39,1,"こ"],[48,1,"にし"],[51,1,"く"]],"text":"彼らは主に従って歩む。主はししのほえるように声を出される。主が声を出されると、子らはおののきつつ西から来る。"},{"ref":"Hos.11.11","start":28011011,"end":28011011,"break":"line","breaks":[[15,"line"],[37,"line"],[53,"line"]],"ruby":[[0,1,"かれ"],[9,1,"とり"],[21,1,"ち"],[31,1,"いそ"],[34,1,"く"],[41,1,"かれ"],[46,1,"いえ"],[48,1,"かえ"],[53,1,"しゅ"],[55,1,"い"]],"text":"彼らはエジプトから鳥のように、アッスリヤの地から、はとのように急いで来る。わたしは彼らをその家に帰らせると主は言われる。"},{"ref":"Hos.11.12","start":28011012,"end":28011012,"break":"line","breaks":[[20,"line"],[43,"line"],[57,"line"]],"ruby":[[6,1,"いつわ"],[17,1,"かこ"],[26,1,"いえ"],[28,1,"あざむ"],[39,1,"かこ"],[51,1,"かみ"],[53,1,"し"],[57,1,"せい"],[60,1,"もの"],[62,1,"む"],[66,2,"しんじつ"]],"text":"エフライムは偽りをもって、わたしを囲み、イスラエルの家は欺きをもって、わたしを囲んだ。しかしユダはなお神に知られ、聖なる者に向かって真実である。"}]