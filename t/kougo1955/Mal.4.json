[{"ref":"Mal.4.1","start":39004001,"end":39004001,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[10,1,"み"],[13,1,"ろ"],[18,1,"も"],[21,1,"ひ"],[23,1,"く"],[28,1,"とき"],[32,1,"たか"],[35,1,"もの"],[38,1,"あく"],[40,1,"おこな"],[42,1,"もの"],[57,1,"く"],[59,1,"ひ"],[62,1,"かれ"],[65,1,"や"],[67,1,"つく"],[71,1,"ね"],[73,1,"えだ"],[75,1,"のこ"]],"text":"万軍の主は言われる、見よ、炉のように燃える日が来る。その時すべて高ぶる者と、悪を行う者とは、わらのようになる。その来る日は、彼らを焼き尽して、根も枝も残さない。"},{"ref":"Mal.4.2","start":39004002,"end":39004002,"break":"none","ruby":[[5,1,"な"],[7,1,"おそ"],[18,1,"ぎ"],[20,2,"たいよう"],[29,1,"つばさ"],[36,1,"ちから"],[38,1,"そな"],[50,2,"ぎゅうしゃ"],[54,1,"で"],[56,1,"こ"],[57,1,"うし"],[62,1,"そと"],[64,1,"で"]],"text":"しかしわが名を恐れるあなたがたには、義の太陽がのぼり、その翼には、いやす力を備えている。あなたがたは牛舎から出る子牛のように外に出て、とびはねる。"},{"ref":"Mal.4.3","start":39004003,"end":39004003,"break":"none","ruby":[[9,2,"あくにん"],[12,1,"ふ"],[21,1,"こと"],[23,1,"おこな"],[25,1,"ひ"],[28,1,"かれ"],[37,1,"あし"],[39,1,"うら"],[41,1,"した"],[47,1,"はい"],[56,2,"ばんぐん"],[59,1,"しゅ"],[61,1,"い"]],"text":"また、あなたがたは悪人を踏みつけ、わたしが事を行う日に、彼らはあなたがたの足の裏の下にあって、灰のようになると、万軍の主は言われる。"},{"ref":"Mal.4.4","start":39004004,"end":39004004,"break":"paragraph","ruby":[[16,2,"りっぽう"],[37,2,"ぜんたい"],[44,1,"かれ"],[46,1,"めい"],[49,1,"さだ"],[57,1,"おぼ"]],"text":"あなたがたは、わがしもべモーセの律法、すなわちわたしがホレブで、イスラエル全体のために、彼に命じた定めとおきてとを覚えよ。"},{"ref":"Mal.4.5","start":39004005,"end":39004005,"break":"paragraph","ruby":[[0,1,"み"],[3,1,"しゅ"],[5,1,"おお"],[9,1,"おそ"],[13,1,"ひ"],[15,1,"く"],[17,1,"まえ"],[24,3,"よげんしゃ"]],"text":"見よ、主の大いなる恐るべき日が来る前に、わたしは預言者エリヤをあなたがたにつかわす。"},{"ref":"Mal.4.6","start":39004006,"end":39004006,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ちち"],[4,1,"こころ"],[8,1,"こ"],[9,1,"とも"],[13,1,"む"],[18,2,"こども"],[23,1,"こころ"],[27,1,"ちち"],[29,1,"む"],[42,1,"き"],[54,1,"くに"],[56,1,"う"]],"text":"彼は父の心をその子供たちに向けさせ、子供たちの心をその父に向けさせる。これはわたしが来て、のろいをもってこの国を撃つことのないようにするためである」。"}]