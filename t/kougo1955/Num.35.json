[{"ref":"Num.35.1","start":4035001,"end":4035001,"break":"paragraph","ruby":[[4,1,"ちか"],[19,2,"へいや"],[23,1,"しゅ"],[29,1,"い"]],"text":"エリコに近いヨルダンのほとりのモアブの平野で、主はモーセに言われた、"},{"ref":"Num.35.2","start":4035002,"end":4035002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"めい"],[16,1,"え"],[18,1,"し"],[19,1,"ぎょう"],[31,1,"す"],[35,2,"まちまち"],[38,1,"あた"],[58,2,"まちまち"],[61,2,"しゅうい"],[64,2,"ほうぼく"],[66,1,"ち"],[73,1,"あた"]],"text":"「イスラエルの人々に命じて、その獲た嗣業のうちから、レビびとに住むべき町々を与えさせなさい。また、あなたがたは、その町々の周囲の放牧地をレビびとに与えなければならない。"},{"ref":"Num.35.3","start":4035003,"end":4035003,"break":"none","ruby":[[2,2,"まちまち"],[5,1,"かれ"],[8,1,"す"],[10,1,"ところ"],[14,2,"ほうぼく"],[16,1,"ち"],[18,1,"かれ"],[21,2,"かちく"],[24,1,"む"],[34,1,"けもの"]],"text":"その町々は彼らの住む所、その放牧地は彼らの家畜と群れ、およびすべての獣のためである。"},{"ref":"Num.35.4","start":4035004,"end":4035004,"break":"none","ruby":[[11,1,"あた"],[14,2,"まちまち"],[17,2,"ほうぼく"],[19,1,"ち"],[22,1,"まち"],[24,1,"いし"],[36,2,"しゅうい"]],"text":"あなたがたがレビびとに与える町々の放牧地は、町の石がきから一千キュビトの周囲としなければならない。"},{"ref":"Num.35.5","start":4035005,"end":4035005,"break":"none","ruby":[[6,1,"まち"],[8,1,"そと"],[10,2,"ひがしがわ"],[20,2,"みなみがわ"],[30,2,"にしがわ"],[40,2,"きたがわ"],[50,1,"はか"],[53,1,"まち"],[57,2,"ちゅうおう"],[70,1,"かれ"],[73,1,"まち"],[75,2,"ほうぼく"],[77,1,"ち"]],"text":"あなたがたは町の外で東側に二千キュビト、南側に二千キュビト、西側に二千キュビト、北側に二千キュビトを計り、町はその中央にしなければならない。彼らの町の放牧地はこのようにしなければならない。"},{"ref":"Num.35.6","start":4035006,"end":4035006,"break":"none","ruby":[[11,1,"あた"],[14,2,"まちまち"],[25,1,"まち"],[29,1,"ひと"],[31,1,"ころ"],[34,1,"もの"],[40,1,"ところ"],[63,1,"まち"],[65,1,"あた"]],"text":"あなたがたがレビびとに与える町々は六つで、のがれの町とし、人を殺した者がのがれる所としなければならない。なおこのほかに四十二の町を与えなければならない。"},{"ref":"Num.35.7","start":4035007,"end":4035007,"break":"none","ruby":[[15,1,"あた"],[18,1,"まち"],[20,1,"あ"],[34,2,"ほうぼく"],[36,1,"ち"],[38,1,"とも"],[40,1,"あた"]],"text":"すなわちあなたがたがレビびとに与える町は合わせて四十八で、これをその放牧地と共に与えなければならない。"},{"ref":"Num.35.8","start":4035008,"end":4035008,"break":"none","ruby":[[12,2,"ひとびと"],[15,2,"しょゆう"],[27,2,"まちまち"],[30,1,"あた"],[36,1,"おお"],[39,2,"ぶぞく"],[44,1,"おお"],[46,1,"と"],[49,1,"ちい"],[52,2,"ぶぞく"],[57,1,"すく"],[60,1,"と"],[67,1,"う"],[70,1,"し"],[71,1,"ぎょう"],[81,2,"まちまち"],[89,1,"あた"]],"text":"あなたがたがイスラエルの人々の所有のうちからレビびとに町々を与えるには、大きい部族からは多く取り、小さい部族からは少なく取り、おのおの受ける嗣業にしたがって、その町々をレビびとに与えなければならない」。"},{"ref":"Num.35.9","start":4035009,"end":4035009,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.35.10","start":4035010,"end":4035010,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[27,1,"わた"],[34,1,"ち"]],"text":"「イスラエルの人々に言いなさい。あなたがたがヨルダンを渡ってカナンの地にはいるときは、"},{"ref":"Num.35.11","start":4035011,"end":4035011,"break":"none","ruby":[[9,1,"まち"],[11,1,"えら"],[19,1,"まち"],[28,1,"ひと"],[30,1,"ころ"],[33,1,"もの"]],"text":"あなたがたのために町を選んで、のがれの町とし、あやまって人を殺した者を、そこにのがれさせなければならない。"},{"ref":"Num.35.12","start":4035012,"end":4035012,"break":"none","ruby":[[9,2,"ふくしゅう"],[13,1,"もの"],[15,1,"さ"],[22,1,"まち"],[28,1,"ひと"],[30,1,"ころ"],[33,1,"もの"],[35,2,"かいしゅう"],[38,1,"まえ"],[40,1,"た"],[48,1,"う"],[56,1,"ころ"]],"text":"これはあなたがたが復讐する者を避けてのがれる町であって、人を殺した者が会衆の前に立って、さばきを受けないうちに、殺されることのないためである。"},{"ref":"Num.35.13","start":4035013,"end":4035013,"break":"none","ruby":[[6,1,"あた"],[9,2,"まちまち"],[22,1,"まち"]],"text":"あなたがたが与える町々のうち、六つをのがれの町としなければならない。"},{"ref":"Num.35.14","start":4035014,"end":4035014,"break":"none","ruby":[[16,1,"まち"],[18,1,"あた"],[25,1,"ち"],[30,1,"まち"],[32,1,"あた"],[40,1,"まち"]],"text":"すなわちヨルダンのかなたで三つの町を与え、カナンの地で三つの町を与えて、のがれの町としなければならない。"},{"ref":"Num.35.15","start":4035015,"end":4035015,"break":"none","ruby":[[7,1,"まち"],[16,2,"ひとびと"],[20,2,"たこく"],[23,1,"ひと"],[27,3,"きりゅうしゃ"],[39,2,"ばしょ"],[60,1,"ひと"],[62,1,"ころ"],[65,1,"もの"]],"text":"これらの六つの町は、イスラエルの人々と、他国の人および寄留者のために、のがれの場所としなければならない。すべてあやまって人を殺した者が、そこにのがれるためである。"},{"ref":"Num.35.16","start":4035016,"end":4035016,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"てつ"],[6,1,"うつわ"],[9,1,"ひと"],[11,1,"う"],[14,1,"し"],[24,1,"ひと"],[26,1,"こ"],[27,2,"さつじん"],[33,1,"こ"],[34,2,"さつじん"],[37,1,"かなら"],[39,1,"ころ"]],"text":"もし人が鉄の器で、人を打って死なせたならば、その人は故殺人である。故殺人は必ず殺されなければならない。"},{"ref":"Num.35.17","start":4035017,"end":4035017,"break":"none","ruby":[[4,1,"ひと"],[6,1,"ころ"],[12,1,"いし"],[14,1,"と"],[18,1,"ひと"],[20,1,"う"],[23,1,"し"],[33,1,"ひと"],[35,1,"こ"],[36,2,"さつじん"],[42,1,"こ"],[43,2,"さつじん"],[46,1,"かなら"],[48,1,"ころ"]],"text":"またもし人を殺せるほどの石を取って、人を打って死なせたならば、その人は故殺人である。故殺人は必ず殺されなければならない。"},{"ref":"Num.35.18","start":4035018,"end":4035018,"break":"none","ruby":[[4,1,"ひと"],[6,1,"ころ"],[12,1,"き"],[14,1,"うつわ"],[16,1,"と"],[20,1,"ひと"],[22,1,"う"],[25,1,"し"],[35,1,"ひと"],[37,1,"こ"],[38,2,"さつじん"],[44,1,"こ"],[45,2,"さつじん"],[48,1,"かなら"],[50,1,"ころ"]],"text":"あるいは人を殺せるほどの木の器を取って、人を打って死なせたならば、その人は故殺人である。故殺人は必ず殺されなければならない。"},{"ref":"Num.35.19","start":4035019,"end":4035019,"break":"none","ruby":[[0,1,"ち"],[2,2,"ふくしゅう"],[7,1,"もの"],[10,2,"じぶん"],[15,1,"こ"],[16,2,"さつじん"],[19,1,"ころ"],[32,1,"かれ"],[34,2,"であ"],[40,1,"かれ"],[42,1,"ころ"]],"text":"血の復讐をする者は、自分でその故殺人を殺すことができる。すなわち彼に出会うとき、彼を殺すことができる。"},{"ref":"Num.35.20","start":4035020,"end":4035020,"break":"none","ruby":[[4,1,"うら"],[10,1,"ひと"],[12,1,"つ"],[19,2,"こい"],[22,1,"ひと"],[24,1,"もの"],[26,1,"な"],[31,1,"し"]],"text":"またもし恨みのために人を突き、あるいは故意に人に物を投げつけて死なせ、"},{"ref":"Num.35.21","start":4035021,"end":4035021,"break":"none","ruby":[[4,1,"うら"],[10,1,"て"],[12,1,"ひと"],[14,1,"う"],[17,1,"し"],[27,1,"う"],[30,1,"もの"],[32,1,"かなら"],[34,1,"ころ"],[46,1,"かれ"],[48,1,"こ"],[49,2,"さつじん"],[58,1,"ち"],[60,2,"ふくしゅう"],[65,1,"もの"],[70,1,"こ"],[71,2,"さつじん"],[74,2,"であ"],[79,1,"ころ"]],"text":"あるいは恨みによって手で人を打って死なせたならば、その打った者は必ず殺されなければならない。彼は故殺人だからである。血の復讐をする者は、その故殺人に出会うとき殺すことができる。"},{"ref":"Num.35.22","start":4035022,"end":4035022,"break":"paragraph","ruby":[[6,1,"うら"],[13,1,"おも"],[16,1,"ひと"],[18,1,"つ"],[32,1,"ひと"],[34,1,"もの"],[36,1,"な"]],"text":"しかし、もし恨みもないのに思わず人を突き、または、なにごころなく人に物を投げつけ、"},{"ref":"Num.35.23","start":4035023,"end":4035023,"break":"none","ruby":[[4,1,"ひと"],[10,1,"み"],[14,1,"ひと"],[16,1,"ころ"],[22,1,"いし"],[24,1,"な"],[29,1,"し"],[33,2,"ばあい"],[38,1,"ひと"],[42,1,"てき"],[50,1,"がい"],[52,1,"くわ"],[64,1,"とき"]],"text":"あるいは人のいるのも見ずに、人を殺せるほどの石を投げつけて死なせた場合、その人がその敵でもなく、また害を加えようとしたのでもない時は、"},{"ref":"Num.35.24","start":4035024,"end":4035024,"break":"none","ruby":[[0,2,"かいしゅう"],[17,1,"ひと"],[19,1,"ころ"],[22,1,"もの"],[25,1,"ち"],[27,2,"ふくしゅう"],[32,1,"もの"],[35,1,"あいだ"]],"text":"会衆はこれらのおきてによって、その人を殺した者と、血の復讐をする者との間をさばかなければならない。"},{"ref":"Num.35.25","start":4035025,"end":4035025,"break":"none","ruby":[[4,2,"かいしゅう"],[9,1,"ひと"],[11,1,"ころ"],[14,1,"もの"],[16,1,"ち"],[18,2,"ふくしゅう"],[23,1,"もの"],[25,1,"て"],[28,1,"すく"],[30,1,"だ"],[34,1,"に"],[37,1,"い"],[44,1,"まち"],[46,1,"かえ"],[59,1,"もの"],[61,1,"せい"],[64,1,"あぶら"],[66,1,"そそ"],[70,1,"だい"],[71,2,"さいし"],[74,1,"し"]],"text":"すなわち会衆はその人を殺した者を血の復讐をする者の手から救い出して、逃げて行ったのがれの町に返さなければならない。その者は聖なる油を注がれた大祭司の死ぬまで、そこにいなければならない。"},{"ref":"Num.35.26","start":4035026,"end":4035026,"break":"none","ruby":[[6,1,"ひと"],[8,1,"ころ"],[11,1,"もの"],[16,1,"に"],[19,1,"い"],[26,1,"まち"],[28,1,"さかい"],[30,1,"で"],[32,2,"ばあい"]],"text":"しかし、もし人を殺した者が、その逃げて行ったのがれの町の境を出た場合、"},{"ref":"Num.35.27","start":4035027,"end":4035027,"break":"none","ruby":[[0,1,"ち"],[2,2,"ふくしゅう"],[7,1,"もの"],[14,1,"まち"],[16,1,"さかい"],[18,1,"そと"],[24,2,"であ"],[28,1,"ち"],[30,2,"ふくしゅう"],[35,1,"もの"],[40,1,"ひと"],[42,1,"ころ"],[45,1,"もの"],[47,1,"ころ"],[52,1,"かれ"],[55,1,"ち"],[57,1,"なが"],[60,1,"つみ"]],"text":"血の復讐をする者は、のがれの町の境の外で、これに出会い、血の復讐をする者が、その人を殺した者を殺しても、彼には血を流した罪はない。"},{"ref":"Num.35.28","start":4035028,"end":4035028,"break":"none","ruby":[[0,1,"かれ"],[2,1,"だい"],[3,2,"さいし"],[6,1,"し"],[17,1,"まち"],[32,1,"だい"],[33,2,"さいし"],[36,1,"し"],[39,1,"のち"],[42,1,"ひと"],[44,1,"ころ"],[47,1,"もの"],[49,2,"じぶん"],[52,2,"しょゆう"],[55,1,"ち"]],"text":"彼は大祭司の死ぬまで、そののがれの町におるべきものだからである。大祭司の死んだ後は、人を殺した者は自分の所有の地にかえることができる。"},{"ref":"Num.35.29","start":4035029,"end":4035029,"break":"paragraph","ruby":[[16,1,"す"],[18,1,"ところ"],[21,2,"よよ"],[36,1,"さだ"]],"text":"これらのことはすべてあなたがたの住む所で、代々あなたがたのためのおきての定めとしなければならない。"},{"ref":"Num.35.30","start":4035030,"end":4035030,"break":"none","ruby":[[0,1,"ひと"],[2,1,"ころ"],[5,1,"もの"],[11,1,"こ"],[12,2,"さつじん"],[18,2,"しょうにん"],[21,2,"しょうげん"],[29,1,"ころ"],[54,2,"しょうげん"],[60,1,"ころ"]],"text":"人を殺した者、すなわち故殺人はすべて証人の証言にしたがって殺されなければならない。しかし、だれもただひとりの証言によって殺されることはない。"},{"ref":"Num.35.31","start":4035031,"end":4035031,"break":"none","ruby":[[6,1,"し"],[8,1,"あた"],[10,1,"つみ"],[12,1,"おか"],[15,1,"こ"],[16,2,"さつじん"],[19,1,"いのち"],[28,1,"と"],[37,1,"かれ"],[39,1,"かなら"],[41,1,"ころ"]],"text":"あなたがたは死に当る罪を犯した故殺人の命のあがないしろを取ってはならない。彼は必ず殺されなければならない。"},{"ref":"Num.35.32","start":4035032,"end":4035032,"break":"none","ruby":[[7,1,"まち"],[13,1,"もの"],[26,1,"と"],[29,1,"だい"],[30,2,"さいし"],[33,1,"し"],[35,1,"まえ"],[37,1,"かれ"],[39,2,"じぶん"],[42,1,"ち"],[44,1,"かえ"],[46,1,"す"]],"text":"また、のがれの町にのがれた者のために、あがないしろを取って大祭司の死ぬ前に彼を自分の地に帰り住まわせてはならない。"},{"ref":"Num.35.33","start":4035033,"end":4035033,"break":"none","ruby":[[10,1,"ところ"],[12,1,"ち"],[14,1,"けが"],[23,2,"りゅうけつ"],[26,1,"ち"],[28,1,"けが"],[36,1,"ち"],[38,1,"うえ"],[40,1,"なが"],[44,1,"ち"],[50,1,"なが"],[53,1,"もの"],[55,1,"ち"]],"text":"あなたがたはそのおる所の地を汚してはならない。流血は地を汚すからである。地の上に流された血は、それを流した者の血によらなければあがなうことができない。"},{"ref":"Num.35.34","start":4035034,"end":4035034,"break":"none","ruby":[[9,1,"す"],[11,1,"ところ"],[13,1,"ち"],[25,1,"ち"],[27,1,"けが"],[36,1,"しゅ"],[49,2,"ひとびと"],[55,1,"す"]],"text":"あなたがたは、その住む所の地、すなわちわたしのおる地を汚してはならない。主なるわたしがイスラエルの人々のうちに住んでいるからである」。"}]