[{"ref":"Ezek.46.1","start":26046001,"end":26046001,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[8,1,"い"],[13,2,"うちにわ"],[18,1,"ひがし"],[19,1,"む"],[22,1,"もん"],[25,1,"はたら"],[31,1,"か"],[33,1,"あいだ"],[35,1,"と"],[38,3,"あんそくにち"],[46,1,"ひら"],[60,1,"ひら"]],"text":"主なる神は、こう言われる、内庭にある東向きの門は、働きをする六日の間は閉じ、安息日にはこれを開き、またついたちにはこれを開け。"},{"ref":"Ezek.46.2","start":26046002,"end":26046002,"break":"none","ruby":[[0,1,"きみ"],[3,1,"もの"],[6,1,"そと"],[9,1,"もん"],[11,1,"ろう"],[21,1,"もん"],[23,1,"はしら"],[30,1,"た"],[37,2,"さいし"],[43,2,"はんさい"],[46,3,"しゅうおんさい"],[55,1,"かれ"],[57,1,"もん"],[59,2,"しきい"],[63,2,"れいはい"],[67,1,"で"],[69,1,"い"],[79,1,"もん"],[81,2,"ゆうぐれ"],[85,1,"と"]],"text":"君たる者は、外から門の廊をとおってはいり、門の柱のかたわらに立て。そのとき祭司たちは、燔祭と酬恩祭とをささげ、彼は門の敷居で、礼拝して出て行くのである。しかし門は夕暮まで閉じてはならない。"},{"ref":"Ezek.46.3","start":26046003,"end":26046003,"break":"none","ruby":[[0,1,"くに"],[2,1,"たみ"],[4,3,"あんそくにち"],[18,1,"もん"],[20,2,"いりぐち"],[23,1,"しゅ"],[25,1,"まえ"],[27,2,"れいはい"]],"text":"国の民は安息日と、ついたちとに、その門の入口で主の前に礼拝をせよ。"},{"ref":"Ezek.46.4","start":26046004,"end":26046004,"break":"none","ruby":[[0,1,"きみ"],[3,1,"もの"],[6,3,"あんそくにち"],[10,1,"しゅ"],[16,2,"はんさい"],[21,1,"とう"],[23,2,"むきず"],[26,2,"こひつじ"],[31,1,"とう"],[33,2,"むきず"],[36,2,"おひつじ"]],"text":"君たる者が、安息日に主にささげる燔祭は、六頭の無傷の小羊と、一頭の無傷の雄羊とである。"},{"ref":"Ezek.46.5","start":26046005,"end":26046005,"break":"none","ruby":[[2,2,"そさい"],[5,2,"おひつじ"],[11,2,"むぎこ"],[17,2,"こひつじ"],[23,2,"そさい"],[29,1,"ひと"],[36,2,"ていど"],[41,2,"むぎこ"],[47,1,"あぶら"],[52,1,"くわ"]],"text":"また素祭は雄羊のために麦粉一エパ、小羊のための素祭は、その人のささげうる程度とし、麦粉一エパに油一ヒンを加えよ。"},{"ref":"Ezek.46.6","start":26046006,"end":26046006,"break":"none","ruby":[[6,2,"むきず"],[9,2,"おうし"],[12,1,"こ"],[14,1,"とう"],[17,1,"とう"],[19,2,"こひつじ"],[25,1,"とう"],[27,2,"おひつじ"],[42,2,"むきず"]],"text":"ついたちには無傷の雄牛の子一頭、六頭の小羊および一頭の雄羊をささげよ。これらはすべて無傷のものでなければならない。"},{"ref":"Ezek.46.7","start":26046007,"end":26046007,"break":"none","ruby":[[0,2,"そさい"],[3,2,"おうし"],[9,2,"むぎこ"],[15,2,"おひつじ"],[21,2,"むぎこ"],[27,2,"こひつじ"],[37,1,"ひと"],[44,2,"ていど"],[50,1,"そな"],[56,2,"むぎこ"],[62,1,"あぶら"],[67,1,"くわ"]],"text":"素祭は雄牛のために麦粉一エパ、雄羊のために麦粉一エパ、小羊のためには、その人のささげうる程度のものを供えよ。また麦粉一エパに油一ヒンを加えよ。"},{"ref":"Ezek.46.8","start":26046008,"end":26046008,"break":"none","ruby":[[0,1,"きみ"],[3,1,"もの"],[8,1,"とき"],[10,1,"もん"],[12,1,"ろう"],[14,1,"みち"],[25,1,"みち"],[28,1,"で"]],"text":"君たる者がはいる時は門の廊の道からはいり、またその道から出よ。"},{"ref":"Ezek.46.9","start":26046009,"end":26046009,"break":"paragraph","ruby":[[0,1,"くに"],[2,1,"たみ"],[5,1,"いわ"],[7,1,"び"],[9,1,"しゅ"],[11,1,"まえ"],[13,1,"で"],[15,1,"とき"],[17,2,"れいはい"],[23,1,"きた"],[25,1,"もん"],[27,1,"みち"],[33,1,"もの"],[36,1,"みなみ"],[38,1,"もん"],[40,1,"みち"],[43,1,"で"],[45,1,"い"],[48,1,"みなみ"],[50,1,"もん"],[52,1,"みち"],[58,1,"もの"],[61,1,"きた"],[63,1,"もん"],[65,1,"みち"],[68,1,"で"],[70,1,"い"],[79,1,"もん"],[81,1,"みち"],[86,1,"かえ"],[100,1,"すす"],[104,1,"で"],[106,1,"い"]],"text":"国の民が、祝い日に主の前に出る時、礼拝のため、北の門の道からはいる者は、南の門の道から出て行き、南の門の道からはいる者は、北の門の道から出て行け。そのはいった門の道からは、帰ってはならない。まっすぐに進んで、出て行かなければならない。"},{"ref":"Ezek.46.10","start":26046010,"end":26046010,"break":"none","ruby":[[0,1,"かれ"],[6,1,"とき"],[8,1,"きみ"],[11,1,"もの"],[14,1,"かれ"],[17,1,"とも"],[23,1,"かれ"],[26,1,"で"],[28,1,"とき"],[30,1,"かれ"],[32,1,"で"]],"text":"彼らがはいる時、君たる者は、彼らと共にはいり、彼らが出る時、彼も出なければならない。"},{"ref":"Ezek.46.11","start":26046011,"end":26046011,"break":"paragraph","ruby":[[0,2,"さいじつ"],[3,1,"いわ"],[5,1,"び"],[9,2,"そさい"],[15,1,"わか"],[17,2,"おうし"],[23,2,"むぎこ"],[29,2,"おひつじ"],[35,2,"むぎこ"],[41,2,"こひつじ"],[51,1,"ひと"],[58,2,"ていど"],[64,1,"そな"],[67,2,"むぎこ"],[74,1,"あぶら"],[79,1,"くわ"]],"text":"祭日と祝い日には、素祭として、若い雄牛のために麦粉一エパ、雄羊のために麦粉一エパ、小羊のためには、その人のささげうる程度のものを供え、麦粉一エパには油一ヒンを加えよ。"},{"ref":"Ezek.46.12","start":26046012,"end":26046012,"break":"none","ruby":[[2,1,"きみ"],[5,1,"もの"],[8,1,"こころ"],[12,1,"そな"],[14,1,"もの"],[19,2,"はんさい"],[24,3,"しゅうおんさい"],[28,1,"しゅ"],[34,1,"とき"],[37,1,"かれ"],[42,1,"ひがし"],[44,1,"めん"],[47,1,"もん"],[49,1,"ひら"],[52,1,"かれ"],[54,3,"あんそくにち"],[58,1,"おこな"],[66,2,"はんさい"],[69,3,"しゅうおんさい"],[73,1,"そな"],[79,2,"たいしゅつ"],[86,2,"たいしゅつ"],[89,1,"のち"],[91,1,"もん"],[93,1,"と"]],"text":"また君たる者が、心からの供え物として、燔祭または酬恩祭を主にささげる時は、彼のために東に面した門を開け。彼は安息日に行うように、その燔祭と酬恩祭を供え、そして退出する。その退出の後、門は閉ざされる。"},{"ref":"Ezek.46.13","start":26046013,"end":26046013,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"ひ"],[7,1,"さい"],[9,2,"むきず"],[12,2,"こひつじ"],[15,2,"はんさい"],[21,1,"しゅ"],[39,1,"あさ"]],"text":"彼は日ごとに一歳の無傷の小羊を燔祭として、主にささげなければならない。すなわち朝ごとに、これをささげなければならない。"},{"ref":"Ezek.46.14","start":26046014,"end":26046014,"break":"none","ruby":[[0,1,"かれ"],[2,1,"あさ"],[7,2,"そさい"],[13,1,"そ"],[32,2,"むぎこ"],[39,1,"ぶん"],[47,1,"うるお"],[49,1,"あぶら"],[55,1,"ぶん"],[60,2,"そさい"],[65,1,"しゅ"],[82,3,"じょうはんさい"]],"text":"彼は朝ごとに、素祭をこれに添えてささげなければならない。すなわち麦粉一エパの六分の一に、これを潤す油一ヒンの三分の一を、素祭として主にささげなければならない。これは常燔祭のおきてである。"},{"ref":"Ezek.46.15","start":26046015,"end":26046015,"break":"none","ruby":[[4,1,"あさ"],[8,3,"じょうはんさい"],[15,2,"こひつじ"],[18,2,"そさい"],[21,1,"あぶら"]],"text":"すなわち朝ごとに常燔祭として、小羊と素祭と油とをささげなければならない。"},{"ref":"Ezek.46.16","start":26046016,"end":26046016,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[8,1,"い"],[13,1,"きみ"],[16,1,"もの"],[23,1,"し"],[24,1,"ぎょう"],[30,1,"こ"],[36,2,"ざいさん"],[39,1,"あた"],[42,1,"とき"],[50,1,"こ"],[53,1,"し"],[54,1,"ぎょう"],[56,2,"しょゆう"]],"text":"主なる神は、こう言われる、君たる者が、もしその嗣業から、その子のひとりに財産を与える時は、それはその子らの嗣業の所有となる。"},{"ref":"Ezek.46.17","start":26046017,"end":26046017,"break":"none","ruby":[[3,1,"かれ"],[7,2,"どれい"],[15,1,"し"],[16,1,"ぎょう"],[18,3,"いちぶぶん"],[22,1,"あた"],[25,1,"とき"],[31,1,"かれ"],[33,2,"かいほう"],[36,1,"ねん"],[42,1,"ひと"],[44,1,"ぞく"],[52,1,"のち"],[54,1,"きみ"],[57,1,"ひと"],[59,1,"かえ"],[62,1,"かれ"],[64,1,"し"],[65,1,"ぎょう"],[72,1,"こ"],[77,1,"つた"]],"text":"しかし彼がその奴隷のひとりに、嗣業の一部分を与える時は、それは彼の解放の年まで、その人に属していて、その後は君たる人に帰る。彼の嗣業は、ただその子らにだけ伝わるべきである。"},{"ref":"Ezek.46.18","start":26046018,"end":26046018,"break":"none","ruby":[[0,1,"きみ"],[3,1,"もの"],[7,1,"たみ"],[9,1,"し"],[10,1,"ぎょう"],[12,1,"と"],[18,2,"ざいさん"],[21,1,"つ"],[37,1,"かれ"],[42,2,"じぶん"],[45,2,"ざいさん"],[55,1,"こ"],[60,1,"し"],[61,1,"ぎょう"],[64,1,"あた"],[80,1,"たみ"],[90,2,"ざいさん"],[93,1,"うしな"]],"text":"君たる者はその民の嗣業を取って、その財産を継がせないようにしてはならない。彼はただ、自分の財産のうちから、その子らにその嗣業を、与えなければならない。これはわが民のひとりでも、その財産を失わないためである」。"},{"ref":"Ezek.46.19","start":26046019,"end":26046019,"break":"paragraph","ruby":[[4,1,"かれ"],[10,1,"つ"],[14,1,"もん"],[21,2,"いりぐち"],[26,1,"きた"],[27,1,"む"],[30,2,"さいし"],[33,1,"せい"],[36,1,"しつ"],[45,1,"み"],[49,1,"にし"],[51,1,"おく"],[53,1,"ほう"],[58,2,"ばしょ"]],"text":"こうして彼はわたしを連れて、門のかたわらの入口から、北向きの祭司の聖なる室に、はいらせた。見ると、西の奥の方に一つの場所があった。"},{"ref":"Ezek.46.20","start":26046020,"end":26046020,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[14,2,"さいし"],[19,2,"けんさい"],[24,2,"ざいさい"],[30,1,"に"],[32,2,"そさい"],[38,1,"や"],[40,1,"ところ"],[48,1,"そと"],[49,1,"にわ"],[55,1,"たずさ"],[57,1,"で"],[60,1,"せい"],[69,1,"たみ"]],"text":"彼はわたしに言った、「これは祭司たちが愆祭および罪祭のものを煮、素祭のものを焼く所である。これは外庭にそれらを携え出て、聖なるべきことを、民にうつさないためである」。"},{"ref":"Ezek.46.21","start":26046021,"end":26046021,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"そと"],[9,1,"にわ"],[11,1,"つ"],[13,1,"だ"],[16,1,"にわ"],[22,1,"とお"],[27,1,"み"],[30,1,"にわ"],[38,1,"にわ"],[45,1,"にわ"],[53,1,"にわ"]],"text":"彼はまたわたしを外庭に連れ出し、庭の四すみを通らせた。見よ、庭のこのすみにも庭があり、また庭のかのすみにも庭があった。"},{"ref":"Ezek.46.22","start":26046022,"end":26046022,"break":"none","ruby":[[4,1,"にわ"],[10,1,"ちい"],[13,1,"にわ"],[18,1,"なが"],[27,1,"はば"],[40,1,"おな"],[42,1,"おお"]],"text":"すなわち庭の四すみに小さい庭があり、長さ四十キュビト、幅三十キュビトで、四つとも同じ大きさである。"},{"ref":"Ezek.46.23","start":26046023,"end":26046023,"break":"none","ruby":[[5,1,"ちい"],[8,1,"にわ"],[10,2,"ないぶ"],[13,2,"しほう"],[18,1,"いし"],[20,1,"かべ"],[25,2,"しゅうい"],[28,1,"かべ"],[30,1,"した"],[33,1,"もの"],[35,1,"に"],[37,1,"ところ"],[39,1,"もう"]],"text":"その四つの小さい庭の内部の四方には、石の壁があり、周囲の壁の下に、物を煮る所が設けてあった。"},{"ref":"Ezek.46.24","start":26046024,"end":26046024,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[15,1,"みや"],[17,1,"つか"],[19,1,"びと"],[24,1,"たみ"],[30,2,"ぎせい"],[36,1,"に"],[38,2,"だいどころ"]],"text":"彼はわたしに言った、「これらは宮の仕え人たちが、民のささげる犠牲のものを煮る台所である」。"}]