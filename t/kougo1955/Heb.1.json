[{"ref":"Heb.1.1","start":58001001,"end":58001001,"break":"paragraph","ruby":[[0,1,"かみ"],[8,3,"よげんしゃ"],[22,1,"とき"],[30,2,"ほうほう"],[34,2,"せんぞ"],[39,1,"かた"]],"text":"神は、むかしは、預言者たちにより、いろいろな時に、いろいろな方法で、先祖たちに語られたが、"},{"ref":"Heb.1.2","start":58001002,"end":58001002,"break":"none","ruby":[[2,1,"おわ"],[5,1,"とき"],[9,2,"みこ"],[22,1,"かた"],[31,1,"かみ"],[33,2,"みこ"],[36,2,"ばんぶつ"],[39,3,"そうぞくしゃ"],[43,1,"さだ"],[49,2,"みこ"],[61,2,"せかい"],[64,1,"つく"]],"text":"この終りの時には、御子によって、わたしたちに語られたのである。神は御子を万物の相続者と定め、また、御子によって、もろもろの世界を造られた。"},{"ref":"Heb.1.3","start":58001003,"end":58001003,"break":"none","ruby":[[0,2,"みこ"],[3,1,"かみ"],[5,2,"えいこう"],[8,1,"かがや"],[14,1,"かみ"],[16,2,"ほんしつ"],[19,1,"しん"],[21,1,"すがた"],[29,1,"ちから"],[32,2,"ことば"],[38,2,"ばんぶつ"],[41,1,"たも"],[52,1,"つみ"],[63,1,"お"],[71,1,"たか"],[73,1,"ところ"],[78,3,"たいのうしゃ"],[82,1,"みぎ"],[85,1,"ざ"]],"text":"御子は神の栄光の輝きであり、神の本質の真の姿であって、その力ある言葉をもって万物を保っておられる。そして罪のきよめのわざをなし終えてから、いと高き所にいます大能者の右に、座につかれたのである。"},{"ref":"Heb.1.4","start":58001004,"end":58001004,"break":"none","ruby":[[0,2,"みこ"],[6,1,"う"],[8,1,"つ"],[12,1,"な"],[14,2,"みつかい"],[19,1,"な"],[30,1,"かれ"],[39,1,"もの"]],"text":"御子は、その受け継がれた名が御使たちの名にまさっているので、彼らよりもすぐれた者となられた。"},{"ref":"Heb.1.5","start":58001005,"end":58001005,"break":"none","breaks":[[19,"stanza"],[33,"line"],[59,"stanza"],[71,"line"]],"ruby":[[5,1,"かみ"],[7,2,"みつかい"],[15,1,"たい"],[31,1,"こ"],[45,1,"う"],[50,1,"い"],[64,1,"かれ"],[66,1,"ちち"],[71,1,"かれ"],[77,1,"こ"],[87,1,"い"]],"text":"いったい、神は御使たちのだれに対して、「あなたこそは、わたしの子。きょう、わたしはあなたを生んだ」と言い、さらにまた、「わたしは彼の父となり、彼はわたしの子となるであろう」と言われたことがあるか。"},{"ref":"Heb.1.6","start":58001006,"end":58001006,"break":"none","breaks":[[27,"stanza"]],"ruby":[[6,1,"かみ"],[11,2,"ちょうし"],[14,2,"せかい"],[17,1,"みちび"],[19,1,"い"],[23,1,"あた"],[28,1,"かみ"],[30,2,"みつかい"],[41,1,"かれ"],[43,1,"はい"],[52,1,"い"]],"text":"さらにまた、神は、その長子を世界に導き入れるに当って、「神の御使たちはことごとく、彼を拝すべきである」と言われた。"},{"ref":"Heb.1.7","start":58001007,"end":58001007,"break":"none","breaks":[[13,"stanza"],[26,"line"]],"ruby":[[3,2,"みつかい"],[14,1,"かみ"],[17,2,"みつかい"],[22,1,"かぜ"],[27,2,"じぶん"],[30,1,"つか"],[33,1,"もの"],[37,1,"ほのお"],[44,1,"い"]],"text":"また、御使たちについては、「神は、御使たちを風とし、ご自分に仕える者たちを炎とされる」と言われているが、"},{"ref":"Heb.1.8","start":58001008,"end":58001008,"break":"none","breaks":[[8,"stanza"],[29,"line"]],"ruby":[[0,2,"みこ"],[9,1,"かみ"],[16,2,"みざ"],[20,2,"よよ"],[22,1,"かぎ"],[26,1,"つづ"],[33,2,"しはい"],[40,2,"こうへい"]],"text":"御子については、「神よ、あなたの御座は、世々限りなく続き、あなたの支配のつえは、公平のつえである。"},{"ref":"Heb.1.9","start":58001009,"end":58001009,"break":"line","breaks":[[17,"line"],[40,"line"]],"ruby":[[4,1,"ぎ"],[6,1,"あい"],[9,2,"ふほう"],[12,1,"にく"],[23,1,"かみ"],[29,1,"かみ"],[32,1,"よろこ"],[44,1,"とも"],[46,1,"そそ"],[51,1,"おお"],[58,1,"そそ"],[64,1,"い"]],"text":"あなたは義を愛し、不法を憎まれた。それゆえに、神、あなたの神は、喜びのあぶらを、あなたの友に注ぐよりも多く、あなたに注がれた」と言い、"},{"ref":"Heb.1.10","start":58001010,"end":58001010,"break":"none","breaks":[[4,"stanza"],[28,"line"]],"ruby":[[5,1,"しゅ"],[12,1,"はじ"],[16,1,"ち"],[18,1,"もとい"],[33,1,"てん"],[37,1,"て"]],"text":"さらに、「主よ、あなたは初めに、地の基をおすえになった。もろもろの天も、み手のわざである。"},{"ref":"Heb.1.11","start":58001011,"end":58001011,"break":"line","breaks":[[15,"line"],[34,"line"]],"ruby":[[7,1,"ほろ"],[41,1,"ころも"],[46,1,"ふる"]],"text":"これらのものは滅びてしまうが、あなたは、いつまでもいますかたである。すべてのものは衣のように古び、"},{"ref":"Heb.1.12","start":58001012,"end":58001012,"break":"line","breaks":[[20,"line"],[37,"line"],[53,"line"]],"ruby":[[9,2,"がいとう"],[15,1,"ま"],[28,1,"ころも"],[33,1,"かわ"],[45,1,"かわ"],[62,1,"つ"],[73,1,"い"]],"text":"それらをあなたは、外套のように巻かれる。これらのものは、衣のように変るが、あなたは、いつも変ることがなく、あなたのよわいは、尽きることがない」とも言われている。"},{"ref":"Heb.1.13","start":58001013,"end":58001013,"break":"none","breaks":[[15,"stanza"],[38,"line"]],"ruby":[[0,1,"かみ"],[3,2,"みつかい"],[11,1,"たい"],[20,1,"てき"],[27,1,"あし"],[28,1,"だい"],[42,1,"みぎ"],[44,1,"ざ"],[53,1,"い"]],"text":"神は、御使たちのだれに対して、「あなたの敵を、あなたの足台とするときまでは、わたしの右に座していなさい」と言われたことがあるか。"},{"ref":"Heb.1.14","start":58001014,"end":58001014,"break":"none","ruby":[[0,2,"みつかい"],[8,1,"つか"],[11,1,"れい"],[17,1,"すくい"],[19,1,"う"],[21,1,"つ"],[25,2,"ひとびと"],[28,2,"ほうし"]],"text":"御使たちはすべて仕える霊であって、救を受け継ぐべき人々に奉仕するため、つかわされたものではないか。"}]