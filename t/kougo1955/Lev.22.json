[{"ref":"Lev.22.1","start":3022001,"end":3022001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.22.2","start":3022002,"end":3022002,"break":"none","ruby":[[7,1,"こ"],[11,1,"つ"],[21,2,"ひとびと"],[24,1,"せい"],[27,1,"もの"],[34,1,"かれ"],[45,1,"もの"],[51,1,"もち"],[59,1,"せい"],[62,1,"な"],[64,1,"けが"],[81,1,"しゅ"]],"text":"「アロンとその子たちに告げて、イスラエルの人々の聖なる物、すなわち、彼らがわたしにささげる物をみだりに用いて、わたしの聖なる名を汚さないようにさせなさい。わたしは主である。"},{"ref":"Lev.22.3","start":3022003,"end":3022003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[16,2,"よよ"],[19,2,"しそん"],[36,2,"ひとびと"],[39,1,"しゅ"],[45,1,"せい"],[48,1,"もの"],[51,1,"けが"],[54,1,"み"],[59,1,"ちか"],[62,1,"もの"],[70,1,"ひと"],[76,1,"まえ"],[79,1,"た"],[92,1,"しゅ"]],"text":"彼らに言いなさい、『あなたがたの代々の子孫のうち、だれでも、イスラエルの人々が主にささげる聖なる物に、汚れた身をもって近づく者があれば、その人はわたしの前から断たれるであろう。わたしは主である。"},{"ref":"Lev.22.4","start":3022004,"end":3022004,"break":"none","ruby":[[4,2,"しそん"],[17,1,"びょう"],[19,1,"もの"],[23,2,"りゅうしゅつ"],[27,1,"もの"],[29,1,"きよ"],[36,1,"せい"],[39,1,"もの"],[41,1,"た"],[56,2,"したい"],[62,1,"けが"],[65,1,"もの"],[67,1,"ふ"],[70,1,"もの"],[72,1,"せい"],[74,1,"も"],[78,1,"もの"]],"text":"アロンの子孫のうち、だれでも、らい病の者、また流出ある者は清くなるまで、聖なる物を食べてはならない。また、すべて死体によって汚れた物に触れた者、精を漏らした者、"},{"ref":"Lev.22.5","start":3022005,"end":3022005,"break":"none","ruby":[[7,1,"ひと"],[9,1,"けが"],[11,1,"は"],[16,1,"ふ"],[19,1,"もの"],[30,1,"けが"],[36,1,"ひと"],[38,1,"けが"],[43,1,"ひと"],[45,1,"ふ"],[48,1,"もの"]],"text":"または、すべて人を汚す這うものに触れた者、または、どのような汚れにせよ、人を汚れさせる人に触れた者、"},{"ref":"Lev.22.6","start":3022006,"end":3022006,"break":"none","ruby":[[8,1,"ふ"],[11,1,"ひと"],[13,1,"ゆう"],[16,1,"けが"],[24,1,"かれ"],[28,1,"み"],[30,1,"みず"],[41,1,"せい"],[44,1,"もの"],[46,1,"た"]],"text":"このようなものに触れた人は夕まで汚れるであろう。彼はその身を水にすすがないならば、聖なる物を食べてはならない。"},{"ref":"Lev.22.7","start":3022007,"end":3022007,"break":"none","ruby":[[0,1,"ひ"],[2,1,"い"],[6,1,"かれ"],[8,1,"きよ"],[22,1,"せい"],[25,1,"もの"],[27,1,"た"],[40,1,"かれ"],[42,2,"しょくもつ"]],"text":"日が入れば、彼は清くなるであろう。そののち、聖なる物を食べることができる。それは彼の食物だからである。"},{"ref":"Lev.22.8","start":3022008,"end":3022008,"break":"none","ruby":[[0,2,"しぜん"],[3,1,"し"],[12,1,"さ"],[14,1,"ころ"],[21,1,"た"],[30,1,"み"],[32,1,"けが"],[45,1,"しゅ"]],"text":"自然に死んだもの、または裂き殺されたものを食べ、それによって身を汚してはならない。わたしは主である。"},{"ref":"Lev.22.9","start":3022009,"end":3022009,"break":"none","ruby":[[6,1,"かれ"],[13,1,"い"],[18,1,"まも"],[29,1,"かれ"],[35,1,"けが"],[45,1,"つみ"],[47,1,"え"],[49,1,"し"],[66,1,"かれ"],[69,2,"せいべつ"],[73,1,"しゅ"]],"text":"それゆえに、彼らはわたしの言いつけを守らなければならない。彼らがこれを汚し、これがために、罪を獲て死ぬことのないためである。わたしは彼らを聖別する主である。"},{"ref":"Lev.22.10","start":3022010,"end":3022010,"break":"paragraph","ruby":[[3,2,"いっぱん"],[6,1,"ひと"],[8,1,"せい"],[11,1,"もの"],[13,1,"た"],[22,2,"さいし"],[25,2,"どうきょ"],[27,1,"ひと"],[29,2,"やといにん"],[32,1,"せい"],[35,1,"もの"],[37,1,"た"]],"text":"すべて一般の人は聖なる物を食べてはならない。祭司の同居人や雇人も聖なる物を食べてはならない。"},{"ref":"Lev.22.11","start":3022011,"end":3022011,"break":"none","ruby":[[4,2,"さいし"],[7,1,"かね"],[12,1,"ひと"],[14,1,"か"],[17,1,"とき"],[22,1,"もの"],[27,1,"た"],[41,1,"いえ"],[43,1,"うま"],[46,1,"もの"],[48,2,"さいし"],[51,2,"しょくもつ"],[54,1,"た"]],"text":"しかし、祭司が金をもって人を買った時は、その者はこれを食べることができる。またその家に生れた者も祭司の食物を食べることができる。"},{"ref":"Lev.22.12","start":3022012,"end":3022012,"break":"none","ruby":[[2,2,"さいし"],[5,1,"むすめ"],[7,2,"いっぱん"],[10,1,"ひと"],[20,2,"かのじょ"],[23,1,"せい"],[26,1,"そな"],[28,1,"もの"],[30,1,"た"]],"text":"もし祭司の娘が一般の人にとついだならば、彼女は聖なる供え物を食べてはならない。"},{"ref":"Lev.22.13","start":3022013,"end":3022013,"break":"none","ruby":[[2,2,"さいし"],[5,1,"むすめ"],[8,2,"かふ"],[17,1,"だ"],[22,2,"こども"],[30,1,"ちち"],[32,1,"いえ"],[34,1,"かえ"],[37,1,"むすめ"],[39,1,"とき"],[50,1,"ちち"],[52,2,"しょくもつ"],[55,1,"た"],[69,2,"いっぱん"],[72,1,"ひと"],[81,1,"た"]],"text":"もし祭司の娘が、寡婦となり、または出されて、子供もなく、その父の家に帰り、娘の時のようであれば、その父の食物を食べることができる。ただし、一般の人は、すべてこれを食べてはならない。"},{"ref":"Lev.22.14","start":3022014,"end":3022014,"break":"none","ruby":[[2,1,"ひと"],[9,1,"せい"],[12,1,"もの"],[14,1,"た"],[27,1,"ぶん"],[31,1,"くわ"],[34,1,"せい"],[37,1,"もの"],[44,2,"さいし"],[47,1,"わた"]],"text":"もし人があやまって聖なる物を食べるならば、それにその五分の一を加え、聖なる物としてこれを祭司に渡さなければならない。"},{"ref":"Lev.22.15","start":3022015,"end":3022015,"break":"none","ruby":[[0,2,"さいし"],[9,2,"ひとびと"],[13,1,"しゅ"],[19,1,"せい"],[22,1,"もの"],[24,1,"けが"]],"text":"祭司はイスラエルの人々が、主にささげる聖なる物を汚してはならない。"},{"ref":"Lev.22.16","start":3022016,"end":3022016,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"せい"],[6,1,"もの"],[8,1,"た"],[14,1,"つみ"],[19,1,"お"],[41,1,"かれ"],[44,2,"せいべつ"],[48,1,"しゅ"]],"text":"人々が聖なる物を食べて、その罪のとがを負わないようにさせなければならない。わたしは彼らを聖別する主である』」。"},{"ref":"Lev.22.17","start":3022017,"end":3022017,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.22.18","start":3022018,"end":3022018,"break":"none","ruby":[[7,1,"こ"],[24,2,"ひとびと"],[27,1,"い"],[40,1,"いえ"],[42,1,"もの"],[55,2,"たこく"],[57,1,"じん"],[67,2,"せいがん"],[70,1,"そな"],[72,1,"もの"],[77,2,"じはつ"],[80,1,"そな"],[82,1,"もの"],[84,2,"はんさい"],[89,1,"しゅ"]],"text":"「アロンとその子たち、およびイスラエルのすべての人々に言いなさい、『イスラエルの家の者、またはイスラエルにおる他国人のうちのだれでも、誓願の供え物、または自発の供え物を燔祭として主にささげようとするならば、"},{"ref":"Lev.22.19","start":3022019,"end":3022019,"break":"none","ruby":[[6,1,"う"],[8,1,"い"],[16,1,"うし"],[18,1,"ひつじ"],[27,1,"おす"],[29,1,"まった"]],"text":"あなたがたの受け入れられるように牛、羊、あるいはやぎの雄の全きものをささげなければならない。"},{"ref":"Lev.22.20","start":3022020,"end":3022020,"break":"none","ruby":[[34,1,"う"],[36,1,"い"]],"text":"すべてきずのあるものはささげてはならない。それはあなたがたのために、受け入れられないからである。"},{"ref":"Lev.22.21","start":3022021,"end":3022021,"break":"none","ruby":[[2,1,"ひと"],[4,2,"とくべつ"],[7,2,"せいがん"],[18,2,"じはつ"],[21,1,"そな"],[23,1,"もの"],[29,1,"うし"],[33,1,"ひつじ"],[35,3,"しゅうおんさい"],[39,2,"ぎせい"],[45,1,"しゅ"],[61,1,"う"],[63,1,"い"],[75,1,"まった"]],"text":"もし人が特別の誓願をなすため、または自発の供え物のために、牛または羊を酬恩祭の犠牲として、主にささげようとするならば、その受け入れられるために、それは全きものでなければならない。それには、どんなきずもあってはならない。"},{"ref":"Lev.22.22","start":3022022,"end":3022022,"break":"none","ruby":[[4,1,"けもの"],[17,1,"お"],[20,1,"ところ"],[27,1,"き"],[29,1,"と"],[32,1,"ところ"],[42,1,"で"],[44,1,"もの"],[51,1,"もの"],[60,1,"もの"],[79,1,"しゅ"],[93,2,"さいだん"],[96,1,"うえ"],[103,2,"かさい"],[109,1,"しゅ"]],"text":"すなわち獣のうちで、めくらのもの、折れた所のあるもの、切り取った所のあるもの、うみの出る者、かいせんの者、かさぶたのある者など、あなたがたは、このようなものを主にささげてはならない。また祭壇の上に、これらを火祭として、主にささげてはならない。"},{"ref":"Lev.22.23","start":3022023,"end":3022023,"break":"none","ruby":[[0,1,"うし"],[5,1,"ひつじ"],[8,1,"あし"],[10,1,"なが"],[14,1,"もの"],[19,1,"みじか"],[23,1,"もの"],[32,2,"じはつ"],[35,1,"そな"],[37,1,"もの"],[49,2,"せいがん"],[52,1,"そな"],[54,1,"もの"],[59,1,"う"],[61,1,"い"]],"text":"牛あるいは羊で、足の長すぎる者、または短すぎる者は、あなたがたが自発の供え物とすることはできるが、誓願の供え物としては受け入れられないであろう。"},{"ref":"Lev.22.24","start":3022024,"end":3022024,"break":"none","ruby":[[12,1,"やぶ"],[25,1,"さ"],[34,1,"き"],[36,1,"と"],[44,1,"しゅ"],[64,1,"くに"],[79,1,"おこな"]],"text":"あなたがたは、こうがんの破れたもの、つぶれたもの、裂けたもの、または切り取られたものを、主にささげてはならない。またあなたがたの国のうちで、このようなことを、行ってはならない。"},{"ref":"Lev.22.25","start":3022025,"end":3022025,"break":"none","ruby":[[9,3,"いほうじん"],[13,1,"て"],[23,1,"う"],[33,1,"かみ"],[35,2,"しょくもつ"],[58,2,"けってん"],[80,1,"う"],[82,1,"い"]],"text":"また、あなたがたは異邦人の手からこれらのものを受けて、あなたがたの神の食物としてささげてはならない。これらのものには欠点があり、きずがあって、あなたがたのために受け入れられないからである』」。"},{"ref":"Lev.22.26","start":3022026,"end":3022026,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.22.27","start":3022027,"end":3022027,"break":"none","ruby":[[1,1,"うし"],[6,1,"ひつじ"],[14,1,"うま"],[24,2,"なぬか"],[27,1,"あいだ"],[30,2,"ははおや"],[36,1,"お"],[48,1,"か"],[49,1,"め"],[53,1,"しゅ"],[59,2,"かさい"],[64,1,"う"],[66,1,"い"]],"text":"「牛、または羊、またはやぎが生れたならば、これを七日の間その母親のもとに置かなければならない。八日目からは主にささげる火祭として受け入れられるであろう。"},{"ref":"Lev.22.28","start":3022028,"end":3022028,"break":"none","ruby":[[6,2,"めうし"],[11,1,"め"],[12,1,"ひつじ"],[16,1,"こ"],[18,1,"おな"],[20,1,"ひ"]],"text":"あなたがたは雌牛または雌羊をその子と同じ日にほふってはならない。"},{"ref":"Lev.22.29","start":3022029,"end":3022029,"break":"none","ruby":[[6,2,"かんしゃ"],[9,2,"ぎせい"],[12,1,"しゅ"],[28,1,"う"],[30,1,"い"]],"text":"あなたがたが感謝の犠牲を主にささげるときは、あなたがたの受け入れられるようにささげなければならない。"},{"ref":"Lev.22.30","start":3022030,"end":3022030,"break":"none","ruby":[[5,1,"ひ"],[10,1,"た"],[21,1,"あ"],[24,1,"ひ"],[27,1,"のこ"],[43,1,"しゅ"]],"text":"これはその日のうちに食べなければならない。明くる日まで残しておいてはならない。わたしは主である。"},{"ref":"Lev.22.31","start":3022031,"end":3022031,"break":"paragraph","ruby":[[10,1,"いまし"],[13,1,"まも"],[19,1,"おこな"],[34,1,"しゅ"]],"text":"あなたがたはわたしの戒めを守り、これを行わなければならない。わたしは主である。"},{"ref":"Lev.22.32","start":3022032,"end":3022032,"break":"none","ruby":[[10,1,"せい"],[13,1,"な"],[15,1,"けが"],[39,2,"ひとびと"],[45,1,"せい"],[68,2,"せいべつ"],[72,1,"しゅ"]],"text":"あなたがたはわたしの聖なる名を汚してはならない。かえって、わたしはイスラエルの人々のうちに聖とされなければならない。わたしはあなたがたを聖別する主である。"},{"ref":"Lev.22.33","start":3022033,"end":3022033,"break":"none","ruby":[[6,1,"かみ"],[25,1,"くに"],[28,1,"みちび"],[30,1,"だ"],[33,1,"もの"],[42,1,"しゅ"]],"text":"あなたがたの神となるために、あなたがたをエジプトの国から導き出した者である。わたしは主である」。"}]