[{"ref":"Num.8.1","start":4008001,"end":4008001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.8.2","start":4008002,"end":4008002,"break":"none","ruby":[[5,1,"い"],[19,1,"ひ"],[24,1,"とき"],[33,1,"ひ"],[35,2,"しょくだい"],[38,2,"ぜんぽう"],[41,1,"てら"]],"text":"「アロンに言いなさい、『あなたがともし火をともす時は、七つのともし火で燭台の前方を照すようにしなさい』」。"},{"ref":"Num.8.3","start":4008003,"end":4008003,"break":"none","ruby":[[17,1,"しゅ"],[23,1,"めい"],[32,2,"しょくだい"],[35,2,"ぜんぽう"],[38,1,"てら"],[47,1,"ひ"]],"text":"アロンはそのようにした。すなわち、主がモーセに命じられたように、燭台の前方を照すように、ともし火をともした。"},{"ref":"Num.8.4","start":4008004,"end":4008004,"break":"none","ruby":[[0,2,"しょくだい"],[3,1,"つく"],[6,1,"つぎ"],[18,1,"きん"],[20,1,"う"],[22,1,"もの"],[27,1,"だい"],[31,1,"はな"],[33,1,"とも"],[35,2,"うちもの"],[37,1,"つく"],[48,1,"しゅ"],[50,1,"しめ"],[54,1,"かた"],[69,2,"しょくだい"],[72,1,"つく"]],"text":"燭台の造りは次のとおりである。それは金の打ち物で、その台もその花も共に打物造りであった。モーセは主に示された型にしたがって、そのようにその燭台を造った。"},{"ref":"Num.8.5","start":4008005,"end":4008005,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.8.6","start":4008006,"end":4008006,"break":"none","ruby":[[12,2,"ひとびと"],[19,1,"と"],[23,1,"かれ"],[26,1,"きよ"]],"text":"「レビびとをイスラエルの人々のうちから取って、彼らを清めなさい。"},{"ref":"Num.8.7","start":4008007,"end":4008007,"break":"none","ruby":[[11,1,"かれ"],[14,1,"きよ"],[30,1,"つみ"],[32,1,"きよ"],[35,1,"みず"],[37,1,"かれ"],[40,1,"そそ"],[45,1,"かれ"],[48,2,"ぜんしん"],[55,2,"いふく"],[58,1,"あら"],[63,1,"み"],[65,1,"きよ"]],"text":"あなたはこのようにして彼らを清めなければならない。すなわち、罪を清める水を彼らに注ぎかけ、彼らに全身をそらせ、衣服を洗わせて、身を清めさせ、"},{"ref":"Num.8.8","start":4008008,"end":4008008,"break":"none","ruby":[[3,1,"かれ"],[6,1,"わか"],[8,2,"おうし"],[11,1,"とう"],[14,1,"あぶら"],[16,1,"ま"],[19,2,"むぎこ"],[22,2,"そさい"],[26,1,"と"],[43,1,"わか"],[45,2,"おうし"],[48,2,"ざいさい"],[54,1,"と"]],"text":"そして彼らに若い雄牛一頭と、油を混ぜた麦粉の素祭とを取らせなさい。あなたはまた、ほかに若い雄牛を罪祭のために取らなければならない。"},{"ref":"Num.8.9","start":4008009,"end":4008009,"break":"none","ruby":[[13,2,"かいけん"],[16,2,"まくや"],[19,1,"まえ"],[21,1,"つ"],[33,2,"ひとびと"],[36,1,"ぜん"],[37,2,"かいしゅう"],[40,1,"あつ"]],"text":"そして、あなたはレビびとを会見の幕屋の前に連れてきて、イスラエルの人々の全会衆を集め、"},{"ref":"Num.8.10","start":4008010,"end":4008010,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"まえ"],[9,1,"すす"],[19,2,"ひとびと"],[25,1,"て"],[32,1,"うえ"],[34,1,"お"]],"text":"レビびとを主の前に進ませ、イスラエルの人々をして、手をレビびとの上に置かせなければならない。"},{"ref":"Num.8.11","start":4008011,"end":4008011,"break":"none","ruby":[[19,2,"ひとびと"],[26,2,"ようさい"],[32,1,"しゅ"],[34,1,"まえ"],[51,1,"かれ"],[54,1,"しゅ"],[56,1,"つとめ"]],"text":"そしてアロンは、レビびとをイスラエルの人々のささげる揺祭として、主の前にささげなければならない。これは彼らに主の務をさせるためである。"},{"ref":"Num.8.12","start":4008012,"end":4008012,"break":"none","ruby":[[16,1,"て"],[20,2,"おうし"],[23,1,"あたま"],[25,1,"うえ"],[27,1,"お"],[36,2,"ざいさい"],[44,2,"はんさい"],[49,1,"しゅ"],[63,1,"つみ"]],"text":"それからあなたはレビびとをして、手をかの雄牛の頭の上に置かせ、その一つを罪祭とし、一つを燔祭として主にささげ、レビびとのために罪のあがないをしなければならない。"},{"ref":"Num.8.13","start":4008013,"end":4008013,"break":"none","ruby":[[16,1,"こ"],[20,1,"まえ"],[22,1,"た"],[29,2,"ようさい"],[34,1,"しゅ"]],"text":"あなたはレビびとを、アロンとその子たちの前に立たせ、これを揺祭として主にささげなければならない。"},{"ref":"Num.8.14","start":4008014,"end":4008014,"break":"paragraph","ruby":[[20,2,"ひとびと"],[27,1,"わ"]],"text":"こうして、あなたはレビびとをイスラエルの人々のうちから分かち、レビびとをわたしのものとしなければならない。"},{"ref":"Num.8.15","start":4008015,"end":4008015,"break":"none","ruby":[[4,1,"のち"],[10,2,"かいけん"],[13,2,"まくや"],[20,1,"つとめ"],[35,1,"かれ"],[38,1,"きよ"],[41,1,"かれ"],[48,2,"ようさい"]],"text":"こうして後レビびとは会見の幕屋にはいって務につくことができる。あなたは彼らを清め、彼らをささげて揺祭としなければならない。"},{"ref":"Num.8.16","start":4008016,"end":4008016,"break":"none","ruby":[[0,1,"かれ"],[9,2,"ひとびと"],[17,1,"まった"],[44,2,"ひとびと"],[50,1,"はじ"],[53,1,"うま"],[56,1,"もの"],[71,1,"かわ"],[79,1,"かれ"],[82,1,"と"]],"text":"彼らはイスラエルの人々のうちから、全くわたしにささげられたものだからである。イスラエルの人々のうちの初めに生れた者、すなわち、すべてのういごの代りに、わたしは彼らを取ってわたしのものとした。"},{"ref":"Num.8.17","start":4008017,"end":4008017,"break":"none","ruby":[[6,2,"ひとびと"],[17,1,"ひと"],[19,1,"けもの"],[46,1,"ち"],[57,1,"う"],[59,1,"ころ"],[62,1,"ひ"],[65,1,"かれ"],[68,2,"せいべつ"]],"text":"イスラエルの人々のうちのういごは、人も獣も、みなわたしのものだからである。わたしはエジプトの地で、すべてのういごを撃ち殺した日に、彼らを聖別してわたしのものとした。"},{"ref":"Num.8.18","start":4008018,"end":4008018,"break":"none","ruby":[[13,2,"ひとびと"],[28,1,"かわ"],[36,1,"と"]],"text":"それでわたしはイスラエルの人々のうちの、すべてのういごの代りにレビびとを取った。"},{"ref":"Num.8.19","start":4008019,"end":4008019,"break":"none","ruby":[[10,2,"ひとびと"],[22,1,"と"],[32,1,"こ"],[36,1,"あた"],[39,1,"かれ"],[42,2,"かいけん"],[45,2,"まくや"],[55,2,"ひとびと"],[58,1,"かわ"],[61,1,"つとめ"],[74,2,"ひとびと"],[80,1,"つみ"],[104,2,"ひとびと"],[108,2,"せいじょ"],[111,1,"ちか"],[122,2,"ひとびと"],[128,1,"わざわい"],[130,1,"おこ"]],"text":"わたしはイスラエルの人々のうちからレビびとを取って、アロンとその子たちに与え、彼らに会見の幕屋で、イスラエルの人々に代って務をさせ、またイスラエルの人々のために罪のあがないをさせるであろう。これはイスラエルの人々が、聖所に近づいて、イスラエルの人々のうちに災の起ることのないようにするためである」。"},{"ref":"Num.8.20","start":4008020,"end":4008020,"break":"paragraph","ruby":[[17,2,"ひとびと"],[20,1,"ぜん"],[21,2,"かいしゅう"],[28,1,"しゅ"],[35,1,"こと"],[44,1,"めい"],[49,1,"ところ"],[62,1,"い"],[77,2,"ひとびと"],[86,1,"かれ"],[89,1,"い"]],"text":"モーセとアロン、およびイスラエルの人々の全会衆は、すべて主がレビびとの事につき、モーセに命じられた所にしたがって、レビびとに行った、すなわち、イスラエルの人々は、そのように彼らに行った。"},{"ref":"Num.8.21","start":4008021,"end":4008021,"break":"none","ruby":[[8,1,"み"],[10,1,"きよ"],[15,2,"いふく"],[18,1,"あら"],[26,1,"かれ"],[29,1,"しゅ"],[31,1,"まえ"],[37,2,"ようさい"],[49,1,"かれ"],[56,1,"つみ"],[65,1,"かれ"],[68,1,"きよ"]],"text":"そこでレビびとは身を清め、その衣服を洗った。アロンは彼らを主の前にささげて揺祭とした。アロンはまた彼らのために、罪のあがないをして彼らを清めた。"},{"ref":"Num.8.22","start":4008022,"end":4008022,"break":"none","ruby":[[4,1,"のち"],[11,2,"かいけん"],[14,2,"まくや"],[28,1,"こ"],[32,1,"つか"],[35,1,"つとめ"],[45,1,"かれ"],[53,1,"こと"],[59,1,"しゅ"],[65,1,"めい"],[70,1,"ところ"],[83,1,"かれ"],[86,1,"い"]],"text":"こうして後、レビびとは会見の幕屋にはいって、アロンとその子たちに仕えて務をした。すなわち、彼らはレビびとの事について、主がモーセに命じられた所にしたがって、そのように彼らに行った。"},{"ref":"Num.8.23","start":4008023,"end":4008023,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.8.24","start":4008024,"end":4008024,"break":"none","ruby":[[6,1,"つぎ"],[29,1,"さい"],[30,2,"いじょう"],[33,1,"もの"],[35,1,"つとめ"],[40,2,"かいけん"],[43,2,"まくや"],[46,1,"はたら"]],"text":"「レビびとは次のようにしなければならない。すなわち、二十五歳以上の者は務につき、会見の幕屋の働きをしなければならない。"},{"ref":"Num.8.25","start":4008025,"end":4008025,"break":"none","ruby":[[6,1,"さい"],[10,1,"つとめ"],[12,1,"はたら"],[15,1,"しりぞ"],[18,1,"かさ"],[21,1,"つとめ"]],"text":"しかし、五十歳からは務の働きを退き、重ねて務をしてはならない。"},{"ref":"Num.8.26","start":4008026,"end":4008026,"break":"none","ruby":[[3,2,"かいけん"],[6,2,"まくや"],[11,2,"きょうだい"],[16,1,"つとめ"],[18,1,"たす"],[34,1,"つとめ"],[55,1,"つとめ"]],"text":"ただ、会見の幕屋でその兄弟たちの務の助けをすることができる。しかし、務をしてはならない。あなたがレビびとにその務をさせるには、このようにしなければならない」。"}]