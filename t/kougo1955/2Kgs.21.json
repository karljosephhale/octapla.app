[{"ref":"2Kgs.21.1","start":12021001,"end":12021001,"break":"paragraph","ruby":[[6,1,"さい"],[8,1,"おう"],[16,1,"ねん"],[18,1,"あいだ"],[26,1,"よ"],[28,1,"おさ"],[32,1,"はは"],[34,1,"な"]],"text":"マナセは十二歳で王となり、五十五年の間、エルサレムで世を治めた。母の名はヘフジバといった。"},{"ref":"2Kgs.21.2","start":12021002,"end":12021002,"break":"none","ruby":[[4,1,"しゅ"],[12,2,"ひとびと"],[15,1,"まえ"],[18,1,"お"],[20,1,"はら"],[24,2,"くにぐに"],[27,1,"たみ"],[29,1,"にく"],[43,1,"しゅ"],[45,1,"め"],[47,1,"まえ"],[49,1,"あく"]],"text":"マナセは主がイスラエルの人々の前から追い払われた国々の民の憎むべきおこないにならって、主の目の前に悪をおこなった。"},{"ref":"2Kgs.21.3","start":12021003,"end":12021003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ちち"],[12,1,"たか"],[14,1,"ところ"],[16,1,"た"],[18,1,"なお"],[29,1,"おう"],[46,2,"さいだん"],[49,1,"きず"],[55,1,"ぞう"],[57,1,"つく"],[62,1,"てん"],[64,2,"ばんしょう"],[67,1,"おが"],[74,1,"つか"]],"text":"彼は父ヒゼキヤがこわした高き所を建て直し、またイスラエルの王アハブがしたようにバアルのために祭壇を築き、アシラ像を造り、かつ天の万象を拝んで、これに仕えた。"},{"ref":"2Kgs.21.4","start":12021004,"end":12021004,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"みや"],[9,2,"すうこ"],[12,2,"さいだん"],[15,1,"きず"],[22,1,"しゅ"],[29,1,"な"],[37,1,"お"],[42,1,"い"],[48,1,"みや"]],"text":"また主の宮のうちに数個の祭壇を築いた。これは主が「わたしの名をエルサレムに置こう」と言われたその宮である。"},{"ref":"2Kgs.21.5","start":12021005,"end":12021005,"break":"none","ruby":[[0,1,"かれ"],[4,1,"しゅ"],[6,1,"みや"],[11,1,"にわ"],[13,1,"てん"],[15,2,"ばんしょう"],[21,2,"さいだん"],[24,1,"きず"]],"text":"彼はまた主の宮の二つの庭に天の万象のために祭壇を築いた。"},{"ref":"2Kgs.21.6","start":12021006,"end":12021006,"break":"none","ruby":[[4,1,"こ"],[6,1,"ひ"],[8,1,"や"],[14,1,"もの"],[18,1,"うらな"],[23,2,"まじゅつ"],[26,1,"おこな"],[29,2,"くちよ"],[33,3,"まほうつかい"],[37,1,"もち"],[40,1,"しゅ"],[42,1,"め"],[44,1,"まえ"],[46,1,"おお"],[49,1,"あく"],[51,1,"い"],[55,1,"しゅ"],[57,1,"いか"],[60,1,"ひ"],[62,1,"おこ"]],"text":"またその子を火に焼いてささげ物とし、占いをし、魔術を行い、口寄せと魔法使を用い、主の目の前に多くの悪を行って、主の怒りを引き起した。"},{"ref":"2Kgs.21.7","start":12021007,"end":12021007,"break":"none","ruby":[[0,1,"かれ"],[8,2,"ちょうぞう"],[11,1,"つく"],[14,1,"しゅ"],[16,1,"みや"],[18,1,"お"],[22,1,"しゅ"],[26,1,"みや"],[37,1,"こ"],[43,1,"い"],[60,1,"みや"],[77,2,"ぶぞく"],[84,1,"えら"],[99,1,"な"],[101,2,"えいえん"],[104,1,"お"]],"text":"彼はまたアシラの彫像を作って主の宮に置いた。主はこの宮についてダビデとその子ソロモンに言われたことがある、「わたしはこの宮と、わたしがイスラエルのすべての部族のうちから選んだエルサレムとに、わたしの名を永遠に置く。"},{"ref":"2Kgs.21.8","start":12021008,"end":12021008,"break":"none","ruby":[[3,1,"かれ"],[10,1,"めい"],[17,1,"こと"],[33,1,"めい"],[40,2,"りっぽう"],[43,1,"まも"],[45,1,"おこな"],[57,1,"あし"],[64,1,"かれ"],[67,2,"せんぞ"],[72,1,"あた"],[75,1,"ち"],[79,1,"かさ"],[82,1,"まよ"],[84,1,"だ"]],"text":"もし、彼らがわたしが命じたすべての事、およびわたしのしもべモーセが命じたすべての律法を守り行うならば、イスラエルの足を、わたしが彼らの先祖たちに与えた地から、重ねて迷い出させないであろう」。"},{"ref":"2Kgs.21.9","start":12021009,"end":12021009,"break":"none","ruby":[[3,1,"かれ"],[6,1,"き"],[19,2,"ひとびと"],[27,1,"あく"],[29,1,"おこな"],[36,1,"しゅ"],[44,2,"ひとびと"],[47,1,"まえ"],[49,1,"ほろ"],[54,2,"くにぐに"],[57,1,"たみ"]],"text":"しかし彼らは聞きいれなかった。マナセが人々をいざなって悪を行ったことは、主がイスラエルの人々の前に滅ぼされた国々の民よりもはなはだしかった。"},{"ref":"2Kgs.21.10","start":12021010,"end":12021010,"break":"paragraph","ruby":[[3,1,"しゅ"],[13,3,"よげんしゃ"],[22,1,"い"]],"text":"そこで主はそのしもべである預言者たちによって言われた、"},{"ref":"2Kgs.21.11","start":12021011,"end":12021011,"break":"none","ruby":[[4,1,"おう"],[13,1,"にく"],[17,1,"こと"],[19,1,"おこな"],[22,1,"かれ"],[24,1,"さき"],[35,1,"い"],[42,1,"こと"],[46,1,"わる"],[48,1,"こと"],[50,1,"おこな"],[57,2,"ぐうぞう"],[66,1,"つみ"],[68,1,"おか"]],"text":"「ユダの王マナセがこれらの憎むべき事を行い、彼の先にあったアモリびとの行ったすべての事よりも悪い事を行い、またその偶像をもってユダに罪を犯させたので、"},{"ref":"2Kgs.21.12","start":12021012,"end":12021012,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[12,1,"おお"],[18,1,"み"],[34,1,"わざわい"],[49,1,"き"],[51,1,"もの"],[56,1,"みみ"],[63,1,"な"]],"text":"イスラエルの神、主はこう仰せられる、見よ、わたしはエルサレムとユダに災をくだそうとしている。これを聞く者は、その耳が二つながら鳴るであろう。"},{"ref":"2Kgs.21.13","start":12021013,"end":12021013,"break":"none","ruby":[[13,1,"はか"],[23,1,"いえ"],[25,1,"もち"],[28,1,"さ"],[30,1,"ふ"],[44,1,"ひと"],[46,1,"さら"],[59,1,"ふ"],[75,1,"さ"]],"text":"わたしはサマリヤをはかった測りなわと、アハブの家に用いた下げ振りをエルサレムにほどこし、人が皿をぬぐい、これをぬぐって伏せるように、エルサレムをぬぐい去る。"},{"ref":"2Kgs.21.14","start":12021014,"end":12021014,"break":"none","ruby":[[9,1,"し"],[10,1,"ぎょう"],[12,1,"たみ"],[14,1,"のこ"],[17,1,"す"],[20,1,"かれ"],[23,1,"てき"],[25,1,"て"],[27,1,"わた"],[30,1,"かれ"],[38,1,"てき"],[47,2,"りゃくだつ"]],"text":"わたしは、わたしの嗣業の民の残りを捨て、彼らを敵の手に渡す。彼らはもろもろの敵のえじきとなり、略奪にあうであろう。"},{"ref":"2Kgs.21.15","start":12021015,"end":12021015,"break":"none","ruby":[[3,1,"かれ"],[6,2,"せんぞ"],[16,1,"で"],[18,1,"ひ"],[21,2,"こんにち"],[24,1,"いた"],[29,1,"かれ"],[36,1,"め"],[38,1,"まえ"],[40,1,"あく"],[42,1,"い"],[50,1,"いか"]],"text":"これは彼らの先祖たちがエジプトを出た日から今日に至るまで、彼らがわたしの目の前に悪を行って、わたしを怒らせたためである」。"},{"ref":"2Kgs.21.16","start":12021016,"end":12021016,"break":"paragraph","ruby":[[6,1,"しゅ"],[8,1,"め"],[10,1,"まえ"],[12,1,"あく"],[14,1,"い"],[21,1,"つみ"],[23,1,"おか"],[29,1,"つみ"],[35,1,"つみ"],[38,1,"もの"],[40,1,"ち"],[42,1,"おお"],[44,1,"なが"],[56,1,"はて"],[62,1,"はて"],[66,1,"み"]],"text":"マナセはまた主の目の前に悪を行って、ユダに罪を犯させたその罪のほかに、罪なき者の血を多く流して、エルサレムのこの果から、かの果にまで満たした。"},{"ref":"2Kgs.21.17","start":12021017,"end":12021017,"break":"paragraph","ruby":[[6,1,"た"],[8,2,"じせき"],[12,1,"かれ"],[23,1,"こと"],[29,1,"おか"],[32,1,"つみ"],[38,1,"おう"],[40,3,"れきだいし"],[44,1,"しょ"]],"text":"マナセのその他の事績と、彼がおこなったすべての事およびその犯した罪は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.21.18","start":12021018,"end":12021018,"break":"none","ruby":[[4,2,"せんぞ"],[9,1,"とも"],[11,1,"ねむ"],[17,1,"いえ"],[19,1,"その"],[27,1,"その"],[29,1,"ほうむ"],[35,1,"こ"],[40,1,"かわ"],[43,1,"おう"]],"text":"マナセは先祖たちと共に眠って、その家の園すなわちウザの園に葬られ、その子アモンが代って王となった。"},{"ref":"2Kgs.21.19","start":12021019,"end":12021019,"break":"paragraph","ruby":[[4,1,"おう"],[9,1,"とき"],[13,1,"さい"],[26,1,"ねん"],[28,1,"あいだ"],[30,1,"よ"],[32,1,"おさ"],[36,1,"はは"],[46,1,"むすめ"],[49,1,"な"]],"text":"アモンは王となった時二十二歳であって、エルサレムで二年の間、世を治めた。母はヨテバのハルツの娘で、名をメシュレメテといった。"},{"ref":"2Kgs.21.20","start":12021020,"end":12021020,"break":"none","ruby":[[6,1,"ちち"],[20,1,"しゅ"],[22,1,"め"],[24,1,"まえ"],[26,1,"あく"],[28,1,"おこな"]],"text":"アモンはその父マナセのおこなったように、主の目の前に悪を行った。"},{"ref":"2Kgs.21.21","start":12021021,"end":12021021,"break":"none","ruby":[[4,1,"かれ"],[11,1,"ちち"],[13,1,"あゆ"],[16,1,"みち"],[18,1,"あゆ"],[21,1,"ちち"],[23,1,"つか"],[26,2,"ぐうぞう"],[29,1,"つか"],[36,1,"おが"]],"text":"すなわち彼はすべてその父の歩んだ道に歩み、父の仕えた偶像に仕えて、これを拝み、"},{"ref":"2Kgs.21.22","start":12021022,"end":12021022,"break":"none","ruby":[[0,2,"せんぞ"],[5,1,"かみ"],[7,1,"しゅ"],[9,1,"す"],[13,1,"しゅ"],[15,1,"みち"],[17,1,"あゆ"]],"text":"先祖たちの神、主を捨てて、主の道に歩まなかった。"},{"ref":"2Kgs.21.23","start":12021023,"end":12021023,"break":"none","ruby":[[4,2,"けらい"],[12,1,"かれ"],[14,1,"てき"],[17,2,"ととう"],[20,1,"むす"],[23,1,"おう"],[27,1,"いえ"],[29,1,"ころ"]],"text":"アモンの家来たちはついに彼に敵して徒党を結び、王をその家で殺したが、"},{"ref":"2Kgs.21.24","start":12021024,"end":12021024,"break":"none","ruby":[[0,1,"くに"],[2,1,"たみ"],[8,1,"おう"],[10,1,"てき"],[13,2,"ととう"],[16,1,"むす"],[19,1,"もの"],[26,1,"う"],[28,1,"ころ"],[35,1,"くに"],[37,1,"たみ"],[43,1,"こ"],[48,1,"おう"],[56,1,"かわ"]],"text":"国の民は、アモン王に敵して徒党を結んだ者をことごとく撃ち殺した。そして国の民はアモンの子ヨシヤを王としてアモンに代らせた。"},{"ref":"2Kgs.21.25","start":12021025,"end":12021025,"break":"none","ruby":[[6,1,"た"],[8,2,"じせき"],[15,1,"おう"],[17,3,"れきだいし"],[21,1,"しょ"]],"text":"アモンのその他の事績は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.21.26","start":12021026,"end":12021026,"break":"none","ruby":[[7,1,"その"],[11,1,"はか"],[13,1,"ほうむ"],[19,1,"こ"],[24,1,"かわ"],[27,1,"おう"]],"text":"アモンはウザの園にある墓に葬られ、その子ヨシヤが代って王となった。"}]