[{"ref":"Jer.31.1","start":24031001,"end":24031001,"break":"paragraph","ruby":[[1,1,"しゅ"],[3,1,"い"],[10,1,"とき"],[21,2,"ぜんぶ"],[23,1,"ぞく"],[25,1,"かみ"],[30,1,"かれ"],[37,1,"たみ"]],"text":"「主は言われる、その時わたしはイスラエルの全部族の神となり、彼らはわたしの民となる」。"},{"ref":"Jer.31.2","start":24031002,"end":24031002,"break":"stanza","breaks":[[9,"line"],[26,"line"],[35,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[18,1,"い"],[20,1,"のこ"],[23,1,"たみ"],[26,2,"あらの"],[29,1,"めぐ"],[32,1,"え"],[41,2,"あんそく"],[44,1,"もと"],[47,1,"とき"]],"text":"主はこう言われる、「つるぎをのがれて生き残った民は、荒野で恵みを得た。イスラエルが安息を求めた時、"},{"ref":"Jer.31.3","start":24031003,"end":24031003,"break":"line","breaks":[[12,"line"],[35,"line"],[51,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"とお"],[6,1,"かれ"],[8,1,"あらわ"],[16,1,"かぎ"],[20,1,"あい"],[29,1,"あい"],[44,1,"た"],[51,2,"しんじつ"]],"text":"主は遠くから彼に現れた。わたしは限りなき愛をもってあなたを愛している。それゆえ、わたしは絶えずあなたに真実をつくしてきた。"},{"ref":"Jer.31.4","start":24031004,"end":24031004,"break":"line","breaks":[[11,"line"],[35,"line"],[51,"line"]],"ruby":[[11,1,"ふたた"],[21,1,"た"],[29,1,"た"],[39,1,"ふたた"],[41,1,"つづみ"],[46,1,"み"],[48,1,"かざ"],[51,1,"で"],[53,1,"い"],[57,1,"よろこ"],[59,1,"たの"],[62,1,"もの"],[64,1,"とも"],[66,1,"おど"]],"text":"イスラエルのおとめよ、再びわたしはあなたを建てる、あなたは建てられる。あなたは再び鼓をもって身を飾り、出て行って、喜び楽しむ者と共に踊る。"},{"ref":"Jer.31.5","start":24031005,"end":24031005,"break":"line","breaks":[[23,"line"]],"ruby":[[10,1,"き"],[17,1,"やま"],[19,1,"う"],[23,1,"う"],[26,1,"もの"],[29,1,"う"],[34,1,"み"],[36,1,"た"]],"text":"またあなたはぶどうの木をサマリヤの山に植える。植える者は、植えてその実を食べることができる。"},{"ref":"Jer.31.6","start":24031006,"end":24031006,"break":"line","breaks":[[18,"line"],[27,"line"],[39,"line"]],"ruby":[[0,2,"みまも"],[3,1,"もの"],[11,1,"やま"],[13,1,"うえ"],[15,1,"た"],[18,1,"よ"],[22,1,"ひ"],[24,1,"く"],[28,1,"た"],[36,1,"のぼ"],[44,1,"かみ"],[46,1,"しゅ"]],"text":"見守る者がエフライムの山の上に立って呼ばわる日が来る。『立って、シオンに上り、われわれの神、主に、もうでよう』と」。"},{"ref":"Jer.31.7","start":24031007,"end":24031007,"break":"stanza","breaks":[[10,"line"],[27,"line"],[45,"line"],[59,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"おお"],[18,1,"よろこ"],[21,1,"こえ"],[22,1,"たか"],[24,1,"うた"],[27,2,"ばんこく"],[37,1,"さけ"],[39,1,"ごえ"],[45,1,"つ"],[47,1,"しめ"],[56,1,"い"],[60,1,"しゅ"],[64,1,"たみ"],[71,1,"のこ"],[74,1,"もの"],[76,1,"すく"]],"text":"主はこう仰せられる、「ヤコブのために喜んで声高く歌い、万国のかしらのために叫び声をあげよ。告げ示し、ほめたたえて言え、『主はその民イスラエルの残りの者を救われた』と。"},{"ref":"Jer.31.8","start":24031008,"end":24031008,"break":"line","breaks":[[20,"line"],[32,"line"],[48,"line"],[59,"line"]],"ruby":[[0,1,"み"],[7,1,"かれ"],[10,1,"きた"],[12,1,"くに"],[15,1,"つ"],[17,1,"かえ"],[20,1,"かれ"],[23,1,"ち"],[25,1,"はて"],[28,1,"あつ"],[32,1,"かれ"],[40,2,"もうじん"],[48,2,"にんぷ"],[51,2,"さんぷ"],[54,1,"とも"],[59,1,"かれ"],[62,1,"おお"],[65,1,"む"],[75,1,"かえ"]],"text":"見よ、わたしは彼らを北の国から連れ帰り、彼らを地の果から集める。彼らのうちには、盲人やあしなえ、妊婦、産婦も共にいる。彼らは大きな群れとなって、ここに帰ってくる。"},{"ref":"Jer.31.9","start":24031009,"end":24031009,"break":"line","breaks":[[15,"line"],[32,"line"],[55,"line"],[68,"line"],[87,"line"]],"ruby":[[0,1,"かれ"],[3,1,"な"],[5,1,"かな"],[9,1,"かえ"],[19,1,"なぐさ"],[24,1,"かれ"],[27,1,"みちび"],[29,1,"かえ"],[32,1,"かれ"],[50,1,"みち"],[55,1,"みず"],[57,1,"なが"],[63,1,"とお"],[82,1,"ちち"],[97,2,"ちょうし"]],"text":"彼らは泣き悲しんで帰ってくる。わたしは慰めながら彼らを導き帰る。彼らがつまずかないように、まっすぐな道により、水の流れのそばを通らせる。それは、わたしがイスラエルの父であり、エフライムはわたしの長子だからである。"},{"ref":"Jer.31.10","start":24031010,"end":24031010,"break":"stanza","breaks":[[20,"line"],[41,"line"],[63,"line"]],"ruby":[[0,2,"ばんこく"],[3,1,"たみ"],[12,1,"しゅ"],[14,2,"ことば"],[17,1,"き"],[23,1,"とお"],[26,2,"うみぞ"],[30,1,"ち"],[32,1,"しめ"],[35,1,"い"],[48,1,"ち"],[52,1,"もの"],[57,1,"あつ"],[63,2,"ぼくしゃ"],[68,1,"む"],[71,1,"まも"],[79,1,"まも"]],"text":"万国の民よ、あなたがたは主の言葉を聞き、これを遠い、海沿いの地に示して言いなさい、『イスラエルを散らした者がこれを集められる。牧者がその群れを守るようにこれを守られる』と。"},{"ref":"Jer.31.11","start":24031011,"end":24031011,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"しゅ"],[15,1,"かれ"],[20,1,"つよ"],[22,1,"もの"],[24,1,"て"],[27,1,"かれ"],[29,1,"すく"]],"text":"すなわち主はヤコブをあがない、彼らよりも強い者の手から彼を救いだされた。"},{"ref":"Jer.31.12","start":24031012,"end":24031012,"break":"line","breaks":[[17,"line"],[32,"line"],[51,"line"],[57,"line"],[71,"line"]],"ruby":[[0,1,"かれ"],[3,1,"き"],[9,1,"やま"],[11,1,"こえ"],[12,1,"たか"],[14,1,"うた"],[17,1,"しゅ"],[20,1,"たま"],[24,1,"よ"],[26,1,"もの"],[32,2,"こくもつ"],[35,1,"さけ"],[37,1,"あぶら"],[41,1,"わか"],[43,1,"ひつじ"],[45,1,"うし"],[51,1,"よろこ"],[54,1,"かがや"],[59,1,"たましい"],[61,1,"うるお"],[63,1,"その"],[71,1,"かれ"],[74,1,"かさ"],[77,1,"うれ"]],"text":"彼らは来てシオンの山で声高く歌い、主から賜わった良い物のために、穀物と酒と油および若き羊と牛のために、喜びに輝く。その魂は潤う園のようになり、彼らは重ねて憂えることがない。"},{"ref":"Jer.31.13","start":24031013,"end":24031013,"break":"line","breaks":[[16,"line"],[31,"line"],[48,"line"]],"ruby":[[2,1,"とき"],[9,1,"ま"],[12,1,"たの"],[16,1,"わか"],[18,1,"もの"],[20,1,"お"],[23,1,"もの"],[25,1,"とも"],[27,1,"たの"],[35,1,"かれ"],[38,1,"かな"],[42,1,"よろこ"],[48,1,"かれ"],[51,1,"なぐさ"],[54,1,"うれ"],[57,1,"かわ"],[60,1,"よろこ"],[63,1,"あた"]],"text":"その時おとめたちは舞って楽しみ、若い者も老いた者も共に楽しむ。わたしは彼らの悲しみを喜びにかえ、彼らを慰め、憂いの代りに喜びを与える。"},{"ref":"Jer.31.14","start":24031014,"end":24031014,"break":"line","breaks":[[22,"line"],[44,"line"]],"ruby":[[4,1,"おお"],[10,1,"もの"],[13,2,"さいし"],[16,1,"こころ"],[18,1,"あ"],[26,1,"よ"],[28,1,"もの"],[35,1,"たみ"],[37,1,"み"],[39,1,"た"],[44,1,"しゅ"],[46,1,"い"]],"text":"わたしは多くのささげ物で、祭司の心を飽かせ、わたしの良き物で、わたしの民を満ち足らせると主は言われる」。"},{"ref":"Jer.31.15","start":24031015,"end":24031015,"break":"stanza","breaks":[[10,"line"],[31,"line"],[50,"line"],[62,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"おお"],[11,1,"なげ"],[13,1,"かな"],[20,1,"な"],[22,1,"こえ"],[27,1,"きこ"],[37,1,"こ"],[43,1,"なげ"],[50,1,"こ"],[62,2,"かのじょ"],[67,1,"こ"],[73,1,"なぐさ"],[80,1,"ねが"]],"text":"主はこう仰せられる、「嘆き悲しみ、いたく泣く声がラマで聞える。ラケルがその子らのために嘆くのである。子らがもはやいないので、彼女はその子らのことで慰められるのを願わない」。"},{"ref":"Jer.31.16","start":24031016,"end":24031016,"break":"line","breaks":[[10,"line"],[23,"line"],[38,"line"],[51,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"おお"],[15,1,"な"],[17,1,"こえ"],[23,1,"め"],[26,1,"なみだ"],[45,1,"むく"],[51,1,"かれ"],[54,1,"てき"],[56,1,"ち"],[59,1,"かえ"],[65,1,"しゅ"],[67,1,"い"]],"text":"主はこう仰せられる、「あなたは泣く声をとどめ、目から涙をながすことをやめよ。あなたのわざに報いがある。彼らは敵の地から帰ってくると主は言われる。"},{"ref":"Jer.31.17","start":24031017,"end":24031017,"break":"line","breaks":[[14,"line"],[34,"line"]],"ruby":[[4,2,"しょうらい"],[8,2,"きぼう"],[18,2,"こども"],[23,2,"じぶん"],[26,1,"くに"],[28,1,"かえ"],[34,1,"しゅ"],[36,1,"い"]],"text":"あなたの将来には希望があり、あなたの子供たちは自分の国に帰ってくると主は言われる。"},{"ref":"Jer.31.18","start":24031018,"end":24031018,"break":"line","breaks":[[14,"line"],[26,"line"],[42,"line"],[60,"line"],[68,"line"],[90,"line"]],"ruby":[[4,1,"たし"],[16,1,"い"],[19,1,"なげ"],[22,1,"き"],[35,1,"こら"],[50,1,"な"],[54,1,"こ"],[55,1,"うし"],[60,1,"こら"],[68,1,"しゅ"],[79,1,"かみ"],[81,1,"しゅ"],[94,1,"つ"],[96,1,"かえ"]],"text":"わたしは確かに、エフライムがこう言って嘆くの聞いた、『あなたはわたしを懲しめられた、わたしはくびきに慣れない子牛のように懲しめをうけた。主よ、あなたはわたしの神、主でいらせられる、わたしを連れ帰って、もとにかえしてください。"},{"ref":"Jer.31.19","start":24031019,"end":24031019,"break":"line","breaks":[[15,"line"],[29,"line"],[46,"line"]],"ruby":[[7,1,"さ"],[10,1,"のち"],[12,1,"く"],[15,1,"おしえ"],[20,1,"のち"],[25,1,"う"],[29,1,"わか"],[31,1,"とき"],[39,1,"み"],[50,1,"は"]],"text":"わたしはそむき去った後、悔い、教をうけた後、ももを打った。若い時のはずかしめが身にあるので、わたしは恥じ、うろたえた』。"},{"ref":"Jer.31.20","start":24031020,"end":24031020,"break":"line","breaks":[[7,"line"],[22,"line"],[35,"line"],[50,"line"],[65,"line"],[85,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[17,1,"あい"],[20,1,"こ"],[26,1,"よろこ"],[28,1,"こ"],[39,1,"かれ"],[44,1,"かた"],[52,1,"かれ"],[54,1,"わす"],[74,1,"こころ"],[76,1,"かれ"],[89,1,"かなら"],[91,1,"かれ"]],"text":"主は言われる、エフライムはわたしの愛する子、わたしの喜ぶ子であろうか。わたしは彼について語るごとに、なお彼を忘れることができない。それゆえ、わたしの心は彼をしたっている。わたしは必ず彼をあわれむ。"},{"ref":"Jer.31.21","start":24031021,"end":24031021,"break":"line","breaks":[[16,"line"],[31,"line"],[53,"line"],[67,"line"]],"ruby":[[8,1,"みち"],[13,1,"お"],[24,2,"ひょうちゅう"],[27,1,"た"],[31,2,"おおじ"],[39,1,"とお"],[42,1,"い"],[45,1,"みち"],[47,1,"こころ"],[49,1,"と"],[64,1,"かえ"],[76,2,"まちまち"],[79,1,"かえ"]],"text":"みずからのために道しるべを置き、みずからのために標柱を立てよ。大路に、あなたの通って行った道に心を留めよ。イスラエルのおとめよ、帰れ、これらの、あなたの町々に帰れ。"},{"ref":"Jer.31.22","start":24031022,"end":24031022,"break":"line","breaks":[[17,"line"],[36,"line"]],"ruby":[[0,2,"ふしん"],[3,1,"むすめ"],[17,1,"しゅ"],[19,1,"ち"],[21,1,"うえ"],[23,1,"あたら"],[26,1,"こと"],[28,2,"そうぞう"],[36,1,"おんな"],[38,1,"おとこ"],[40,2,"ほご"],[44,1,"こと"]],"text":"不信の娘よ、いつまでさまようのか。主は地の上に新しい事を創造されたのだ、女が男を保護する事である」。"},{"ref":"Jer.31.23","start":24031023,"end":24031023,"break":"paragraph","breaks":[[60,"stanza"],[75,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[15,1,"い"],[25,1,"かれ"],[28,1,"ふたた"],[30,1,"さか"],[35,1,"とき"],[37,2,"ひとびと"],[45,1,"ち"],[49,2,"まちまち"],[54,2,"ことば"],[57,1,"い"],[61,2,"せいぎ"],[69,1,"せい"],[72,1,"やま"],[78,1,"しゅ"],[84,2,"しゅくふく"]],"text":"万軍の主、イスラエルの神はこう言われる、「わたしが彼らを再び栄えさせる時、人々はまたユダの地とその町々でこの言葉を言う、『正義のすみかよ、聖なる山よ、どうか主がおまえを祝福してくださるように』。"},{"ref":"Jer.31.24","start":24031024,"end":24031024,"break":"none","ruby":[[9,1,"まち"],[11,1,"ひと"],[16,2,"のうふ"],[19,1,"む"],[22,1,"か"],[25,1,"ある"],[27,1,"まわ"],[29,1,"もの"],[31,1,"とも"],[36,1,"す"]],"text":"ユダとそのすべての町の人、および農夫と群れを飼って歩き回る者は共にそこに住む。"},{"ref":"Jer.31.25","start":24031025,"end":24031025,"break":"none","ruby":[[4,1,"つか"],[7,1,"たましい"],[9,1,"あ"],[11,1,"た"],[18,1,"なや"],[23,1,"たましい"],[25,1,"なぐさ"]],"text":"わたしが疲れた魂を飽き足らせ、すべて悩んでいる魂を慰めるからである」。"},{"ref":"Jer.31.26","start":24031026,"end":24031026,"break":"paragraph","ruby":[[7,1,"め"],[19,1,"ねむ"]],"text":"ここでわたしは目をさましたが、わたしの眠りは、ここちよかった。"},{"ref":"Jer.31.27","start":24031027,"end":24031027,"break":"paragraph","ruby":[[1,1,"しゅ"],[3,1,"い"],[8,1,"み"],[15,1,"ひと"],[17,1,"たね"],[19,1,"けもの"],[21,1,"たね"],[30,1,"いえ"],[35,1,"いえ"],[40,1,"ひ"],[42,1,"く"]],"text":"「主は言われる、見よ、わたしが人の種と獣の種とをイスラエルの家とユダの家とにまく日が来る。"},{"ref":"Jer.31.28","start":24031028,"end":24031028,"break":"none","ruby":[[4,1,"かれ"],[7,1,"ぬ"],[10,1,"くだ"],[13,1,"たお"],[16,1,"ほろ"],[20,1,"なや"],[25,1,"ま"],[39,1,"かれ"],[42,1,"た"],[45,1,"う"],[50,1,"ま"],[59,1,"しゅ"],[61,1,"い"]],"text":"わたしは彼らを抜き、砕き、倒し、滅ぼし、悩まそうと待ちかまえていたように、また彼らを建て、植えようと待ちかまえていると主は言われる。"},{"ref":"Jer.31.29","start":24031029,"end":24031029,"break":"none","breaks":[[11,"stanza"],[28,"line"]],"ruby":[[2,1,"とき"],[4,1,"かれ"],[12,1,"ちち"],[22,1,"た"],[28,1,"こ"],[32,1,"は"],[39,1,"い"]],"text":"その時、彼らはもはや、『父がすっぱいぶどうを食べたので、子どもの歯がうく』とは言わない。"},{"ref":"Jer.31.30","start":24031030,"end":24031030,"break":"none","ruby":[[0,1,"ひと"],[6,2,"じぶん"],[9,1,"つみ"],[14,1,"し"],[25,1,"た"],[28,1,"ひと"],[35,1,"は"]],"text":"人はめいめい自分の罪によって死ぬ。すっぱいぶどうを食べる人はみな、その歯がうく。"},{"ref":"Jer.31.31","start":24031031,"end":24031031,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"み"],[20,1,"いえ"],[25,1,"いえ"],[28,1,"あたら"],[31,2,"けいやく"],[34,1,"た"],[37,1,"ひ"],[39,1,"く"]],"text":"主は言われる、見よ、わたしがイスラエルの家とユダの家とに新しい契約を立てる日が来る。"},{"ref":"Jer.31.32","start":24031032,"end":24031032,"break":"none","ruby":[[2,2,"けいやく"],[9,1,"かれ"],[12,2,"せんぞ"],[17,1,"て"],[27,1,"ち"],[30,1,"みちび"],[32,1,"だ"],[35,1,"ひ"],[37,1,"た"],[54,1,"かれ"],[57,1,"おっと"],[66,1,"かれ"],[75,2,"けいやく"],[78,1,"やぶ"],[82,1,"しゅ"],[84,1,"い"]],"text":"この契約はわたしが彼らの先祖をその手をとってエジプトの地から導き出した日に立てたようなものではない。わたしは彼らの夫であったのだが、彼らはそのわたしの契約を破ったと主は言われる。"},{"ref":"Jer.31.33","start":24031033,"end":24031033,"break":"none","ruby":[[8,1,"ひ"],[10,1,"のち"],[22,1,"いえ"],[24,1,"た"],[27,2,"けいやく"],[49,2,"りっぽう"],[52,1,"かれ"],[58,1,"お"],[63,1,"こころ"],[73,1,"かれ"],[76,1,"かみ"],[81,1,"かれ"],[88,1,"たみ"],[93,1,"しゅ"],[95,1,"い"]],"text":"しかし、それらの日の後にわたしがイスラエルの家に立てる契約はこれである。すなわちわたしは、わたしの律法を彼らのうちに置き、その心にしるす。わたしは彼らの神となり、彼らはわたしの民となると主は言われる。"},{"ref":"Jer.31.34","start":24031034,"end":24031034,"break":"none","ruby":[[0,1,"ひと"],[12,1,"となり"],[16,2,"きょうだい"],[19,1,"おし"],[28,1,"しゅ"],[30,1,"し"],[38,1,"い"],[47,1,"かれ"],[50,1,"しょう"],[53,1,"だい"],[55,1,"いた"],[59,1,"みな"],[65,1,"し"],[78,1,"しゅ"],[80,1,"い"],[89,1,"かれ"],[92,2,"ふぎ"],[104,1,"つみ"],[106,1,"おも"]],"text":"人はもはや、おのおのその隣とその兄弟に教えて、『あなたは主を知りなさい』とは言わない。それは、彼らが小より大に至るまで皆、わたしを知るようになるからであると主は言われる。わたしは彼らの不義をゆるし、もはやその罪を思わない」。"},{"ref":"Jer.31.35","start":24031035,"end":24031035,"break":"stanza","breaks":[[13,"line"],[25,"line"],[39,"line"],[62,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[13,2,"たいよう"],[16,1,"あた"],[19,1,"ひる"],[21,1,"ひかり"],[25,1,"つき"],[27,1,"ほし"],[30,1,"さだ"],[33,1,"よる"],[35,1,"ひかり"],[39,1,"うみ"],[43,1,"た"],[49,1,"なみ"],[51,1,"な"],[59,1,"もの"],[64,1,"な"],[66,2,"ばんぐん"],[69,1,"しゅ"]],"text":"主はこう言われる、すなわち太陽を与えて昼の光とし、月と星とを定めて夜の光とし、海をかき立てて、その波を鳴りとどろかせる者――その名は万軍の主という。"},{"ref":"Jer.31.36","start":24031036,"end":24031036,"break":"line","breaks":[[7,"line"],[31,"line"],[45,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"さだ"],[19,1,"まえ"],[37,2,"しそん"],[45,2,"えいきゅう"],[52,1,"まえ"],[54,1,"たみ"]],"text":"主は言われる、「もしこの定めがわたしの前ですたれてしまうなら、イスラエルの子孫もすたって、永久にわたしの前で民であることはできない」。"},{"ref":"Jer.31.37","start":24031037,"end":24031037,"break":"line","breaks":[[9,"line"],[24,"line"],[41,"line"],[63,"line"],[81,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[12,1,"うえ"],[14,1,"てん"],[16,1,"はか"],[24,1,"した"],[26,1,"ち"],[28,1,"もとい"],[30,1,"さぐ"],[60,2,"しそん"],[70,1,"おこな"],[76,1,"す"],[78,1,"さ"],[81,1,"しゅ"],[83,1,"い"]],"text":"主はこう言われる、「もし上の天を量ることができ、下の地の基を探ることができるなら、そのとき、わたしはイスラエルのすべての子孫をそのもろもろの行いのために捨て去ると主は言われる」。"},{"ref":"Jer.31.38","start":24031038,"end":24031038,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"み"],[13,1,"まち"],[21,1,"とう"],[24,1,"すみ"],[26,1,"もん"],[30,1,"しゅ"],[35,2,"さいけん"],[40,1,"とき"],[42,1,"く"]],"text":"主は言われる、「見よ、この町が、ハナネルの塔から隅の門まで、主のために再建される時が来る。"},{"ref":"Jer.31.39","start":24031039,"end":24031039,"break":"none","ruby":[[0,1,"はか"],[10,1,"とお"],[17,1,"の"],[25,1,"おか"],[27,1,"たっ"],[36,1,"む"]],"text":"測りなわはそれよりも遠くまっすぐに延びて、ガレブの丘に達し、ゴアのほうに向かう。"},{"ref":"Jer.31.40","start":24031040,"end":24031040,"break":"none","ruby":[[0,2,"したい"],[3,1,"はい"],[6,1,"たに"],[8,2,"ぜんぶ"],[18,1,"たに"],[20,1,"い"],[26,1,"ひがし"],[31,1,"うま"],[33,1,"もん"],[38,1,"い"],[48,1,"はたけ"],[52,1,"しゅ"],[54,1,"せい"],[57,1,"ところ"],[62,2,"えいえん"],[74,1,"ぬ"],[80,1,"たお"]],"text":"死体と灰との谷の全部、またキデロンの谷に行くまでと、東のほうの馬の門のすみに行くまでとのすべての畑はみな主の聖なる所となり、永遠にわたって、ふたたび抜かれ、また倒されることはない」。"}]