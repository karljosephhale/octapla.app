[{"ref":"Dan.12.1","start":27012001,"end":27012001,"break":"paragraph","ruby":[[2,1,"とき"],[7,1,"たみ"],[9,1,"まも"],[14,1,"おお"],[18,1,"きみ"],[24,1,"た"],[34,1,"くに"],[36,1,"はじ"],[45,1,"とき"],[63,1,"なや"],[66,1,"とき"],[81,1,"とき"],[86,1,"たみ"],[88,1,"すく"],[100,1,"しょ"],[102,1,"な"],[109,1,"もの"],[111,1,"みな"],[112,1,"すく"]],"text":"その時あなたの民を守っている大いなる君ミカエルが立ちあがります。また国が始まってから、その時にいたるまで、かつてなかったほどの悩みの時があるでしょう。しかし、その時あなたの民は救われます。すなわちあの書に名をしるされた者は皆救われます。"},{"ref":"Dan.12.2","start":27012002,"end":27012002,"break":"none","ruby":[[2,1,"ち"],[7,1,"なか"],[9,1,"ねむ"],[14,1,"もの"],[19,1,"おお"],[22,1,"もの"],[24,1,"め"],[38,2,"えいえん"],[41,2,"せいめい"],[47,1,"もの"],[54,1,"はじ"],[57,1,"かぎ"],[61,2,"ちじょく"],[67,1,"もの"]],"text":"また地のちりの中に眠っている者のうち、多くの者は目をさますでしょう。そのうち永遠の生命にいたる者もあり、また恥と、限りなき恥辱をうける者もあるでしょう。"},{"ref":"Dan.12.3","start":27012003,"end":27012003,"break":"none","ruby":[[0,1,"かしこ"],[2,1,"もの"],[5,2,"おおぞら"],[8,1,"かがや"],[14,1,"かがや"],[19,1,"おお"],[22,1,"ひと"],[24,1,"ぎ"],[26,1,"みちび"],[28,1,"もの"],[31,1,"ほし"],[39,2,"えいえん"]],"text":"賢い者は、大空の輝きのように輝き、また多くの人を義に導く者は、星のようになって永遠にいたるでしょう。"},{"ref":"Dan.12.4","start":27012004,"end":27012004,"break":"none","ruby":[[10,1,"おわ"],[13,1,"とき"],[18,2,"ことば"],[21,1,"ひ"],[26,1,"しょ"],[28,1,"ふう"],[37,1,"おお"],[40,1,"もの"],[48,1,"さぐ"],[50,1,"しら"],[56,2,"ちしき"],[59,1,"ま"]],"text":"ダニエルよ、あなたは終りの時までこの言葉を秘し、この書を封じておきなさい。多くの者は、あちこちと探り調べ、そして知識が増すでしょう」。"},{"ref":"Dan.12.5","start":27012005,"end":27012005,"break":"paragraph","ruby":[[11,1,"み"],[26,1,"もの"],[36,1,"かわ"],[42,1,"きし"],[49,1,"かわ"],[55,1,"きし"],[57,1,"た"]],"text":"そこで、われダニエルが見ていると、ほかにまたふたりの者があって、ひとりは川のこなたの岸に、ひとりは川のかなたの岸に立っていた。"},{"ref":"Dan.12.6","start":27012006,"end":27012006,"break":"none","ruby":[[7,2,"あま"],[9,1,"ぬの"],[11,1,"き"],[13,1,"かわ"],[15,1,"みず"],[17,1,"うえ"],[21,1,"ひと"],[27,1,"い"],[34,2,"いじょう"],[49,1,"おわ"]],"text":"わたしは、かの亜麻布を着て川の水の上にいる人にむかって言った、「この異常なできごとは、いつになって終るでしょうか」と。"},{"ref":"Dan.12.7","start":27012007,"end":27012007,"break":"none","ruby":[[2,2,"あま"],[4,1,"ぬの"],[6,1,"き"],[9,1,"かわ"],[11,1,"みず"],[13,1,"うえ"],[17,1,"ひと"],[20,1,"てん"],[22,1,"む"],[29,1,"みぎ"],[31,1,"て"],[33,1,"ひだり"],[35,1,"て"],[40,2,"えいえん"],[43,1,"い"],[46,1,"もの"],[51,1,"ちか"],[60,1,"とき"],[64,1,"とき"],[66,2,"はんとき"],[72,1,"せい"],[75,1,"たみ"],[77,1,"う"],[79,1,"くだ"],[81,1,"ちから"],[83,1,"き"],[85,1,"さ"],[87,1,"とき"],[94,1,"こと"],[98,2,"じょうじゅ"],[106,1,"い"],[115,1,"き"]],"text":"かの亜麻布を着て、川の水の上にいた人が、天に向かって、その右の手と左の手をあげ、永遠に生ける者をさして誓い、それは、ひと時とふた時と半時である。聖なる民を打ち砕く力が消え去る時に、これらの事はみな成就するだろうと言うのを、わたしは聞いた。"},{"ref":"Dan.12.8","start":27012008,"end":27012008,"break":"none","ruby":[[7,1,"き"],[14,1,"さと"],[25,1,"い"],[32,1,"しゅ"],[39,1,"こと"],[41,2,"けつまつ"]],"text":"わたしはこれを聞いたけれども悟れなかった。わたしは言った、「わが主よ、これらの事の結末はどんなでしょうか」。"},{"ref":"Dan.12.9","start":27012009,"end":27012009,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[17,1,"みち"],[19,1,"い"],[27,2,"ことば"],[30,1,"おわ"],[33,1,"とき"],[36,1,"ひ"],[41,1,"ふう"]],"text":"彼は言った、「ダニエルよ、あなたの道を行きなさい。この言葉は終りの時まで秘し、かつ封じておかれます。"},{"ref":"Dan.12.10","start":27012010,"end":27012010,"break":"none","ruby":[[0,1,"おお"],[3,1,"もの"],[6,2,"じぶん"],[9,1,"きよ"],[12,2,"じぶん"],[15,1,"しろ"],[21,1,"ね"],[34,1,"わる"],[36,1,"もの"],[38,1,"わる"],[40,1,"こと"],[51,1,"さと"],[60,1,"かしこ"],[62,1,"もの"],[64,1,"さと"]],"text":"多くの者は、自分を清め、自分を白くし、かつ練られるでしょう。しかし、悪い者は悪い事をおこない、ひとりも悟ることはないが、賢い者は悟るでしょう。"},{"ref":"Dan.12.11","start":27012011,"end":27012011,"break":"none","ruby":[[0,2,"じょうく"],[3,2,"はんさい"],[6,1,"す"],[8,1,"のぞ"],[12,1,"あら"],[14,1,"にく"],[21,1,"た"],[26,1,"とき"],[35,1,"にち"],[37,1,"さだ"]],"text":"常供の燔祭が取り除かれ、荒す憎むべきものが立てられる時から、千二百九十日が定められている。"},{"ref":"Dan.12.12","start":27012012,"end":27012012,"break":"none","ruby":[[0,1,"ま"],[11,1,"にち"],[13,1,"いた"],[15,1,"もの"]],"text":"待っていて千三百三十五日に至る者はさいわいです。"},{"ref":"Dan.12.13","start":27012013,"end":27012013,"break":"none","ruby":[[4,1,"おわ"],[12,1,"みち"],[14,1,"い"],[24,1,"やす"],[27,1,"はい"],[30,1,"さだ"],[35,1,"ひ"],[37,1,"おわ"],[40,1,"た"],[48,1,"ぶん"],[50,1,"う"]],"text":"しかし、終りまであなたの道を行きなさい。あなたは休みに入り、定められた日の終りに立って、あなたの分を受けるでしょう」。"}]