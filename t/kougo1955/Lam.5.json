[{"ref":"Lam.5.1","start":25005001,"end":25005001,"break":"paragraph","breaks":[[13,"line"],[21,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"のぞ"],[11,1,"こと"],[13,1,"おぼ"],[32,1,"かえり"]],"text":"主よ、われわれに臨んだ事を覚えてください。われわれのはずかしめを顧みてください。"},{"ref":"Lam.5.2","start":25005002,"end":25005002,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"し"],[6,1,"ぎょう"],[8,2,"たこく"],[11,1,"ひと"],[13,1,"うつ"],[16,1,"いえ"],[18,3,"いほうじん"]],"text":"われわれの嗣業は他国の人に移り、家は異邦人のものとなった。"},{"ref":"Lam.5.3","start":25005003,"end":25005003,"break":"line","breaks":[[18,"line"]],"ruby":[[13,1,"ちち"],[18,1,"はは"]],"text":"われわれはみなしごとなって父はなく、母はやもめにひとしい。"},{"ref":"Lam.5.4","start":25005004,"end":25005004,"break":"line","breaks":[[15,"line"]],"ruby":[[5,1,"かね"],[7,1,"だ"],[10,1,"みず"],[12,1,"の"],[15,1,"あたい"],[17,1,"はら"],[25,1,"え"]],"text":"われわれは金を出して水を飲み、価を払って、たきぎを獲なければならない。"},{"ref":"Lam.5.5","start":25005005,"end":25005005,"break":"line","breaks":[[22,"line"]],"ruby":[[5,1,"くび"],[16,1,"お"],[18,1,"つか"],[22,1,"つか"],[26,1,"やす"]],"text":"われわれは首にくびきをかけられて追い使われ、疲れても休むことができない。"},{"ref":"Lam.5.6","start":25005006,"end":25005006,"break":"line","breaks":[[20,"line"]],"ruby":[[5,1,"た"],[11,2,"しょくもつ"],[14,1,"え"],[33,1,"て"],[37,1,"の"]],"text":"われわれは足りるだけの食物を獲るために、エジプトおよびアッスリヤに手をさし伸べた。"},{"ref":"Lam.5.7","start":25005007,"end":25005007,"break":"line","breaks":[[22,"line"]],"ruby":[[5,2,"せんぞ"],[8,1,"つみ"],[10,1,"おか"],[17,1,"よ"],[29,2,"ふぎ"],[32,1,"せ"],[35,1,"お"]],"text":"われわれの先祖は罪を犯して、すでに世になく、われわれはその不義の責めを負っている。"},{"ref":"Lam.5.8","start":25005008,"end":25005008,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"どれい"],[6,1,"もの"],[13,1,"おさ"],[25,1,"て"],[28,1,"すく"],[30,1,"だ"],[32,1,"もの"]],"text":"奴隷であった者がわれわれを治めるが、われわれをその手から救い出す者がない。"},{"ref":"Lam.5.9","start":25005009,"end":25005009,"break":"line","breaks":[[16,"line"]],"ruby":[[5,2,"あらの"],[19,1,"いのち"],[24,2,"しょくもつ"],[27,1,"え"]],"text":"われわれは荒野のつるぎのゆえに、おのが命をかけて食物を獲る。"},{"ref":"Lam.5.10","start":25005010,"end":25005010,"break":"line","breaks":[[20,"line"]],"ruby":[[5,2,"ひふ"],[8,2,"きが"],[11,1,"はげ"],[14,1,"ねつ"],[20,1,"ろ"],[25,1,"あつ"]],"text":"われわれの皮膚は飢餓の激しい熱のために、炉のように熱い。"},{"ref":"Lam.5.11","start":25005011,"end":25005011,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"おんな"],[8,1,"おか"],[21,2,"まちまち"],[24,1,"けが"]],"text":"女たちはシオンで犯され、おとめたちはユダの町々で汚された。"},{"ref":"Lam.5.12","start":25005012,"end":25005012,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"きみ"],[3,1,"もの"],[5,1,"かれ"],[8,1,"て"],[15,2,"ちょうろう"],[20,1,"たっと"]],"text":"君たる者も彼らの手でつるされ、長老たちも尊ばれず、"},{"ref":"Lam.5.13","start":25005013,"end":25005013,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"わかもの"],[29,1,"お"]],"text":"若者たちは、ひきうすをになわせられ、わらべたちは、たきぎを負って、よろめき、"},{"ref":"Lam.5.14","start":25005014,"end":25005014,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ちょうろう"],[5,1,"もん"],[7,1,"あつ"],[16,2,"わかもの"],[23,2,"おんがく"],[26,1,"はい"]],"text":"長老たちは門に集まることをやめ、若者たちはその音楽を廃した。"},{"ref":"Lam.5.15","start":25005015,"end":25005015,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"こころ"],[7,1,"よろこ"],[13,1,"おど"],[16,1,"かな"],[20,1,"かわ"]],"text":"われわれの心の喜びはやみ、踊りは悲しみに変り、"},{"ref":"Lam.5.16","start":25005016,"end":25005016,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"かんむり"],[12,1,"お"],[30,1,"つみ"],[32,1,"おか"]],"text":"われわれの冠はこうべから落ちた。わざわいなるかな、われわれは罪を犯したからである。"},{"ref":"Lam.5.17","start":25005017,"end":25005017,"break":"line","breaks":[[16,"line"]],"ruby":[[11,1,"こころ"],[13,1,"おとろ"],[20,1,"こと"],[31,1,"め"]],"text":"このために、われわれの心は衰え、これらの事のために、われわれの目はくらくなった。"},{"ref":"Lam.5.18","start":25005018,"end":25005018,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"やま"],[6,1,"あ"],[11,2,"やまいぬ"],[16,1,"うえ"],[18,1,"ある"]],"text":"シオンの山は荒れはて、山犬がその上を歩いているからである。"},{"ref":"Lam.5.19","start":25005019,"end":25005019,"break":"line","breaks":[[23,"line"]],"ruby":[[3,1,"しゅ"],[15,1,"す"],[17,1,"おさ"],[29,1,"くらい"],[31,2,"よよ"],[33,1,"た"]],"text":"しかし主よ、あなたはとこしえに統べ治められる。あなたの、み位は世々絶えることがない。"},{"ref":"Lam.5.20","start":25005020,"end":25005020,"break":"line","breaks":[[18,"line"]],"ruby":[[15,1,"わす"],[23,1,"ひさ"],[26,1,"す"]],"text":"なぜ、あなたはわれわれをながく忘れ、われわれを久しく捨ておかれるのですか。"},{"ref":"Lam.5.21","start":25005021,"end":25005021,"break":"line","breaks":[[16,"line"],[26,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"かえ"],[21,1,"かえ"],[31,1,"ひ"],[33,1,"あら"],[44,1,"ひ"]],"text":"主よ、あなたに帰らせてください、われわれは帰ります。われわれの日を新たにして、いにしえの日のようにしてください。"},{"ref":"Lam.5.22","start":25005022,"end":25005022,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"まった"],[11,1,"す"],[27,1,"いか"]],"text":"あなたは全くわれわれを捨てられたのですか、はなはだしく怒っていられるのですか。"}]