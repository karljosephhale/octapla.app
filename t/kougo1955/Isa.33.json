[{"ref":"Isa.33.1","start":23033001,"end":23033001,"break":"paragraph","breaks":[[9,"line"],[29,"line"],[45,"line"],[61,"line"],[70,"line"],[85,"line"]],"ruby":[[12,1,"みずか"],[14,1,"ほろ"],[23,1,"ひと"],[25,1,"ほろ"],[32,1,"あざむ"],[38,1,"ひと"],[40,1,"あざむ"],[42,1,"もの"],[49,1,"ほろ"],[65,1,"ほろ"],[74,1,"あざむ"],[79,1,"お"],[89,1,"あざむ"]],"text":"わざわいなるかな、おのれ自ら滅ぼされないのに、人を滅ぼし、だれも欺かないのに人を欺く者よ。あなたが滅ぼすことをやめたとき、あなたは滅ぼされ、あなたが欺くことを終えたとき、あなたは欺かれる。"},{"ref":"Isa.33.2","start":23033002,"end":23033002,"break":"paragraph","breaks":[[16,"line"],[30,"line"],[45,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"めぐ"],[25,1,"ま"],[27,1,"のぞ"],[30,1,"あさ"],[40,1,"うで"],[45,1,"なや"],[48,1,"とき"],[51,1,"すくい"]],"text":"主よ、われわれをお恵みください、われわれはあなたを待ち望む。朝ごとに、われわれの腕となり、悩みの時に、救となってください。"},{"ref":"Isa.33.3","start":23033003,"end":23033003,"break":"line","breaks":[[24,"line"],[37,"line"]],"ruby":[[0,1,"な"],[6,1,"こえ"],[17,1,"たみ"],[19,1,"に"],[21,1,"さ"],[28,1,"た"],[42,1,"くに"],[44,1,"ち"]],"text":"鳴りとどろく声によって、もろもろの民は逃げ去り、あなたが立ちあがられると、もろもろの国は散らされる。"},{"ref":"Isa.33.4","start":23033004,"end":23033004,"break":"line","breaks":[[22,"line"],[35,"line"]],"ruby":[[0,2,"あおむし"],[3,1,"もの"],[5,1,"あつ"],[15,1,"ひん"],[17,1,"あつ"],[35,2,"ひとびと"],[40,1,"うえ"]],"text":"青虫が物を集めるようにぶんどり品は集められ、いなごのとびつどうように、人々はその上にとびつどう。"},{"ref":"Isa.33.5","start":23033005,"end":23033005,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"たか"],[10,1,"たか"],[12,1,"ところ"],[14,1,"す"],[20,1,"しゅ"],[26,2,"こうへい"],[29,2,"せいぎ"],[33,1,"み"]],"text":"主は高くいらせられ、高い所に住まわれる。主はシオンに公平と正義とを満たされる。"},{"ref":"Isa.33.6","start":23033006,"end":23033006,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[2,1,"しゅ"],[4,1,"すくい"],[6,2,"ちえ"],[9,2,"ちしき"],[12,1,"ゆた"],[22,1,"よ"],[24,1,"かた"],[26,1,"た"],[32,1,"しゅ"],[34,1,"おそ"],[42,1,"たから"]],"text":"また主は救と知恵と知識を豊かにして、あなたの代を堅く立てられる。主を恐れることはその宝である。"},{"ref":"Isa.33.7","start":23033007,"end":23033007,"break":"paragraph","breaks":[[16,"line"]],"ruby":[[0,1,"み"],[3,2,"ゆうし"],[8,1,"そと"],[13,1,"さけ"],[16,2,"へいわ"],[19,2,"ししゃ"],[25,1,"なげ"]],"text":"見よ、勇士たちは外にあって叫び、平和の使者はいたく嘆く。"},{"ref":"Isa.33.8","start":23033008,"end":23033008,"break":"line","breaks":[[17,"line"],[33,"line"]],"ruby":[[0,2,"おおじ"],[3,1,"あ"],[10,1,"たび"],[14,1,"た"],[17,2,"けいやく"],[20,1,"やぶ"],[24,2,"しょうにん"],[27,1,"かろ"],[33,1,"ひと"],[35,1,"かえり"]],"text":"大路は荒れすたれて、旅びとは絶え、契約は破られ、証人は軽んぜられ、人を顧みることがない。"},{"ref":"Isa.33.9","start":23033009,"end":23033009,"break":"line","breaks":[[7,"line"],[18,"line"],[32,"line"]],"ruby":[[0,1,"ち"],[2,1,"なげ"],[4,1,"おとろ"],[12,1,"は"],[15,1,"か"],[23,2,"あらの"],[44,1,"は"],[46,1,"おと"]],"text":"地は嘆き衰え、レバノンは恥じて枯れ、シャロンは荒野のようになり、バシャンとカルメルはその葉を落す。"},{"ref":"Isa.33.10","start":23033010,"end":23033010,"break":"paragraph","breaks":[[7,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"いま"],[13,1,"お"],[20,1,"た"],[29,1,"みずか"],[32,1,"たか"]],"text":"主は言われる、「今わたしは起きよう、いま立ちあがろう、いま自らを高くしよう。"},{"ref":"Isa.33.11","start":23033011,"end":23033011,"break":"line","breaks":[[22,"line"],[36,"line"]],"ruby":[[19,1,"う"],[28,1,"いき"],[30,1,"ひ"],[42,1,"く"]],"text":"あなたがたは、もみがらをはらみ、わらを産む。あなたがたの息は火となって、あなたがたを食いつくす。"},{"ref":"Isa.33.12","start":23033012,"end":23033012,"break":"line","ruby":[[5,1,"たみ"],[7,1,"や"],[11,2,"いしばい"],[24,1,"き"],[28,1,"ひ"],[30,1,"も"]],"text":"もろもろの民は焼かれて石灰のようになり、いばらが切られて火に燃やされたようになる」。"},{"ref":"Isa.33.13","start":23033013,"end":23033013,"break":"paragraph","breaks":[[13,"line"],[28,"line"],[41,"line"]],"ruby":[[5,1,"とお"],[10,1,"もの"],[25,1,"き"],[33,1,"ちか"],[38,1,"もの"],[43,2,"たいのう"],[46,1,"し"]],"text":"あなたがた遠くにいる者よ、わたしがおこなったことを聞け。あなたがた近くにいる者よ、わが大能を知れ。"},{"ref":"Isa.33.14","start":23033014,"end":23033014,"break":"line","breaks":[[16,"line"],[33,"line"],[45,"line"],[64,"line"],[75,"line"]],"ruby":[[4,1,"つみ"],[8,1,"おそ"],[11,1,"み"],[21,1,"かみ"],[23,1,"おそ"],[27,1,"もの"],[29,1,"とら"],[45,1,"や"],[50,1,"ひ"],[52,1,"なか"],[80,1,"も"],[83,1,"ひ"],[85,1,"なか"]],"text":"シオンの罪びとは恐れに満たされ、おののきは神を恐れない者を捕えた。「われわれのうち、だれが焼きつくす火の中におることができよう。われわれのうち、だれがとこしえの燃える火の中におることができよう」。"},{"ref":"Isa.33.15","start":23033015,"end":23033015,"break":"line","breaks":[[14,"line"],[30,"line"],[47,"line"],[66,"line"]],"ruby":[[0,1,"ただ"],[3,1,"あゆ"],[5,1,"もの"],[7,2,"しょうじき"],[10,1,"かた"],[12,1,"もの"],[19,1,"え"],[21,1,"り"],[28,1,"もの"],[30,1,"て"],[32,1,"ふ"],[41,1,"と"],[45,1,"もの"],[47,1,"みみ"],[53,1,"ち"],[55,1,"なが"],[57,2,"ぼうりゃく"],[60,1,"き"],[64,1,"もの"],[66,1,"め"],[68,1,"と"],[71,1,"あく"],[73,1,"み"],[76,1,"もの"]],"text":"正しく歩む者、正直に語る者、しえたげて得た利をいやしめる者、手を振って、まいないを取らない者、耳をふさいで血を流す謀略を聞かない者、目を閉じて悪を見ない者、"},{"ref":"Isa.33.16","start":23033016,"end":23033016,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[5,1,"ひと"],[7,1,"たか"],[9,1,"ところ"],[11,1,"す"],[14,1,"かた"],[16,1,"いわ"],[32,1,"あた"],[39,1,"みず"],[41,1,"た"]],"text":"このような人は高い所に住み、堅い岩はそのとりでとなり、そのパンは与えられ、その水は絶えることがない。"},{"ref":"Isa.33.17","start":23033017,"end":23033017,"break":"paragraph","breaks":[[16,"line"]],"ruby":[[4,1,"め"],[6,1,"うるわ"],[9,1,"かざ"],[12,1,"おう"],[14,1,"み"],[16,1,"とお"],[18,1,"ひろ"],[20,1,"くに"],[22,1,"み"]],"text":"あなたの目は麗しく飾った王を見、遠く広い国を見る。"},{"ref":"Isa.33.18","start":23033018,"end":23033018,"break":"line","breaks":[[21,"line"],[36,"line"],[52,"line"]],"ruby":[[4,1,"こころ"],[8,1,"おそ"],[14,1,"こと"],[16,1,"おも"],[18,1,"だ"],[22,1,"かず"],[24,1,"しら"],[27,1,"もの"],[40,1,"はか"],[43,1,"もの"],[56,1,"かぞ"],[59,1,"もの"]],"text":"あなたの心はかの恐ろしかった事を思い出す。「数を調べた者はどこにいるか。みつぎを量った者はどこにいるか。やぐらを数えた者はどこにいるか」。"},{"ref":"Isa.33.19","start":23033019,"end":23033019,"break":"line","breaks":[[16,"line"],[37,"line"]],"ruby":[[7,2,"こうまん"],[10,1,"たみ"],[12,1,"み"],[18,1,"たみ"],[20,2,"ことば"],[29,1,"き"],[39,1,"した"],[46,1,"さと"]],"text":"あなたはもはや高慢な民を見ない。かの民の言葉はあいまいで、聞きとりがたく、その舌はどもって、悟りがたい。"},{"ref":"Isa.33.20","start":23033020,"end":23033020,"break":"line","breaks":[[13,"line"],[26,"line"],[46,"line"],[60,"line"]],"ruby":[[0,1,"さだ"],[3,1,"まつり"],[5,1,"まち"],[10,1,"み"],[17,1,"め"],[19,2,"へいわ"],[26,1,"うつ"],[35,2,"まくや"],[43,1,"み"],[48,1,"くい"],[55,1,"ぬ"],[62,1,"つな"],[70,1,"た"]],"text":"定めの祭の町シオンを見よ。あなたの目は平和なすまい、移されることのない幕屋エルサレムを見る。その杭はとこしえに抜かれず、その綱は、ひとすじも断たれることはない。"},{"ref":"Isa.33.21","start":23033021,"end":23033021,"break":"line","breaks":[[16,"line"],[38,"line"],[52,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"いげん"],[24,1,"ひろ"],[26,1,"かわ"],[28,1,"なが"],[33,1,"ところ"],[40,1,"なか"],[46,1,"ふね"],[48,1,"い"],[52,1,"おお"],[55,1,"ふね"],[57,1,"す"]],"text":"主は威厳をもってかしこにいまし、われわれのために広い川と流れのある所となり、その中には、こぐ舟も入らず、大きな船も過ぎることはない。"},{"ref":"Isa.33.22","start":23033022,"end":23033022,"break":"line","breaks":[[12,"line"],[23,"line"]],"ruby":[[0,1,"しゅ"],[10,1,"ぬし"],[12,1,"しゅ"],[23,1,"しゅ"],[30,1,"おう"],[41,1,"すく"]],"text":"主はわれわれのさばき主、主はわれわれのつかさ、主はわれわれの王であって、われわれを救われる。"},{"ref":"Isa.33.23","start":23033023,"end":23033023,"break":"paragraph","breaks":[[11,"line"],[30,"line"],[42,"line"],[62,"line"]],"ruby":[[4,1,"ふな"],[5,1,"づな"],[7,1,"と"],[11,2,"ほばしら"],[17,1,"むす"],[30,1,"ほ"],[32,1,"は"],[44,1,"とき"],[45,1,"おお"],[48,2,"えもの"],[55,1,"ひん"],[57,1,"わ"],[62,1,"あし"],[68,2,"えもの"],[71,1,"と"]],"text":"あなたの船綱は解けて、帆柱のもとを結びかためることができず、帆を張ることもできない。その時多くの獲物とぶんどり品は分けられ、足なえまでも獲物を取る。"},{"ref":"Isa.33.24","start":23033024,"end":23033024,"break":"line","breaks":[[12,"line"],[29,"line"]],"ruby":[[3,1,"す"],[5,1,"もの"],[17,2,"びょうき"],[22,1,"い"],[24,1,"もの"],[32,1,"す"],[34,1,"たみ"],[38,1,"つみ"]],"text":"そこに住む者のうちには、「わたしは病気だ」と言う者はなく、そこに住む民はその罪がゆるされる。"}]