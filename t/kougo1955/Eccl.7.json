[{"ref":"Eccl.7.1","start":21007001,"end":21007001,"break":"paragraph","breaks":[[12,"line"]],"ruby":[[0,1,"よ"],[2,1,"な"],[4,1,"よ"],[6,1,"あぶら"],[12,1,"し"],[15,1,"ひ"],[17,1,"うま"],[20,1,"ひ"]],"text":"良き名は良き油にまさり、死ぬる日は生るる日にまさる。"},{"ref":"Eccl.7.2","start":21007002,"end":21007002,"break":"line","breaks":[[12,"line"],[26,"line"],[43,"line"]],"ruby":[[0,1,"かな"],[4,1,"いえ"],[12,2,"えんかい"],[15,1,"いえ"],[26,1,"し"],[32,1,"ひと"],[34,1,"おわ"],[43,1,"い"],[48,1,"もの"],[54,1,"こころ"]],"text":"悲しみの家にはいるのは、宴会の家にはいるのにまさる。死はすべての人の終りだからである。生きている者は、これを心にとめる。"},{"ref":"Eccl.7.3","start":21007003,"end":21007003,"break":"line","breaks":[[11,"line"],[25,"line"]],"ruby":[[0,1,"かな"],[4,1,"わら"],[11,1,"かお"],[13,1,"うれ"],[25,1,"こころ"],[27,1,"よ"]],"text":"悲しみは笑いにまさる。顔に憂いをもつことによって、心は良くなるからである。"},{"ref":"Eccl.7.4","start":21007004,"end":21007004,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かしこ"],[2,1,"もの"],[4,1,"こころ"],[6,1,"かな"],[10,1,"いえ"],[15,1,"おろ"],[18,1,"もの"],[20,1,"こころ"],[22,1,"たの"],[26,1,"いえ"]],"text":"賢い者の心は悲しみの家にあり、愚かな者の心は楽しみの家にある。"},{"ref":"Eccl.7.5","start":21007005,"end":21007005,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かしこ"],[2,1,"もの"],[4,1,"いまし"],[7,1,"き"],[12,1,"おろ"],[15,1,"もの"],[17,1,"うた"],[19,1,"き"]],"text":"賢い者の戒めを聞くのは、愚かな者の歌を聞くのにまさる。"},{"ref":"Eccl.7.6","start":21007006,"end":21007006,"break":"line","breaks":[[8,"line"],[28,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"わら"],[11,1,"した"],[13,1,"も"],[20,1,"おと"],[33,1,"くう"]],"text":"愚かな者の笑いはかまの下に燃えるいばらの音のようである。これもまた空である。"},{"ref":"Eccl.7.7","start":21007007,"end":21007007,"break":"line","breaks":[[19,"line"]],"ruby":[[10,1,"かしこ"],[12,1,"ひと"],[14,1,"おろ"],[24,1,"ひと"],[26,1,"こころ"]],"text":"たしかに、しえたげは賢い人を愚かにし、まいないは人の心をそこなう。"},{"ref":"Eccl.7.8","start":21007008,"end":21007008,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"こと"],[2,1,"おわ"],[7,1,"はじ"],[12,1,"よ"],[15,1,"た"],[17,1,"しの"],[19,1,"こころ"],[25,1,"たか"],[28,1,"こころ"]],"text":"事の終りはその初めよりも良い。耐え忍ぶ心は、おごり高ぶる心にまさる。"},{"ref":"Eccl.7.9","start":21007009,"end":21007009,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"き"],[7,1,"いか"],[11,1,"いか"],[14,1,"おろ"],[17,1,"もの"],[19,1,"むね"],[21,1,"やど"]],"text":"気をせきたてて怒るな。怒りは愚かな者の胸に宿るからである。"},{"ref":"Eccl.7.10","start":21007010,"end":21007010,"break":"line","breaks":[[22,"line"]],"ruby":[[1,1,"むかし"],[3,1,"いま"],[18,1,"い"],[29,1,"と"],[33,2,"ちえ"],[37,1,"で"]],"text":"「昔が今よりもよかったのはなぜか」と言うな。あなたがこれを問うのは知恵から出るのではない。"},{"ref":"Eccl.7.11","start":21007011,"end":21007011,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"ちえ"],[3,2,"ざいさん"],[6,1,"ともな"],[10,1,"よ"],[16,1,"ひ"],[18,1,"み"],[20,1,"もの"],[24,1,"えき"]],"text":"知恵に財産が伴うのは良い。それは日を見る者どもに益がある。"},{"ref":"Eccl.7.12","start":21007012,"end":21007012,"break":"line","breaks":[[23,"line"],[45,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"み"],[5,1,"まも"],[10,2,"きんせん"],[13,1,"み"],[15,1,"まも"],[27,2,"ちえ"],[33,1,"も"],[35,1,"もの"],[37,2,"せいめい"],[40,1,"たも"],[48,2,"ちしき"],[55,1,"ところ"]],"text":"知恵が身を守るのは、金銭が身を守るようである。しかし、知恵はこれを持つ者に生命を保たせる。これが知識のすぐれた所である。"},{"ref":"Eccl.7.13","start":21007013,"end":21007013,"break":"line","breaks":[[11,"line"],[22,"line"]],"ruby":[[0,1,"かみ"],[6,1,"かんが"],[11,1,"かみ"],[13,1,"ま"]],"text":"神のみわざを考えみよ。神の曲げられたものを、だれがまっすぐにすることができるか。"},{"ref":"Eccl.7.14","start":21007014,"end":21007014,"break":"paragraph","ruby":[[0,2,"じゅんきょう"],[3,1,"ひ"],[6,1,"たの"],[10,2,"ぎゃっきょう"],[13,1,"ひ"],[16,1,"かんが"],[20,1,"かみ"],[22,1,"ひと"],[24,2,"しょうらい"],[30,1,"こと"],[37,1,"し"],[46,1,"かれ"],[52,1,"ひと"],[55,1,"つく"]],"text":"順境の日には楽しめ、逆境の日には考えよ。神は人に将来どういう事があるかを、知らせないために、彼とこれとを等しく造られたのである。"},{"ref":"Eccl.7.15","start":21007015,"end":21007015,"break":"paragraph","ruby":[[10,2,"じんせい"],[22,1,"こと"],[24,1,"み"],[31,2,"ぎじん"],[36,1,"ぎ"],[41,1,"ほろ"],[50,2,"あくにん"],[55,1,"あく"],[60,2,"ながい"]],"text":"わたしはこのむなしい人生において、もろもろの事を見た。そこには義人がその義によって滅びることがあり、悪人がその悪によって長生きすることがある。"},{"ref":"Eccl.7.16","start":21007016,"end":21007016,"break":"none","ruby":[[4,1,"ぎ"],[6,1,"す"],[17,1,"かしこ"],[20,1,"す"],[37,2,"じぶん"],[40,1,"ほろ"]],"text":"あなたは義に過ぎてはならない。また賢きに過ぎてはならない。あなたはどうして自分を滅ぼしてよかろうか。"},{"ref":"Eccl.7.17","start":21007017,"end":21007017,"break":"none","ruby":[[0,1,"あく"],[2,1,"す"],[13,1,"おろ"],[34,2,"じぶん"],[37,1,"とき"],[45,1,"し"]],"text":"悪に過ぎてはならない。また愚かであってはならない。あなたはどうして、自分の時のこないのに、死んでよかろうか。"},{"ref":"Eccl.7.18","start":21007018,"end":21007018,"break":"none","ruby":[[7,1,"と"],[16,1,"かれ"],[19,1,"て"],[21,1,"ひ"],[30,1,"かみ"],[36,1,"もの"],[49,1,"で"]],"text":"あなたがこれを執るのはよい、また彼から手を引いてはならない。神をかしこむ者は、このすべてからのがれ出るのである。"},{"ref":"Eccl.7.19","start":21007019,"end":21007019,"break":"paragraph","ruby":[[0,2,"ちえ"],[3,2,"ちしゃ"],[6,1,"つよ"],[14,1,"にん"],[20,1,"まち"]],"text":"知恵が知者を強くするのは、十人のつかさが町におるのにまさる。"},{"ref":"Eccl.7.20","start":21007020,"end":21007020,"break":"paragraph","ruby":[[0,1,"ぜん"],[2,1,"おこな"],[5,1,"つみ"],[7,1,"おか"],[11,1,"ただ"],[14,1,"ひと"],[16,1,"よ"]],"text":"善を行い、罪を犯さない正しい人は世にいない。"},{"ref":"Eccl.7.21","start":21007021,"end":21007021,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"かた"],[8,1,"こと"],[10,1,"こころ"],[29,2,"じぶん"],[43,2,"ことば"],[46,1,"き"]],"text":"人の語るすべての事に心をとめてはならない。これはあなたが、自分のしもべのあなたをのろう言葉を聞かないためである。"},{"ref":"Eccl.7.22","start":21007022,"end":21007022,"break":"none","ruby":[[11,2,"たにん"],[20,2,"じぶん"],[23,1,"こころ"],[25,1,"し"]],"text":"あなたもまた、しばしば他人をのろったのを自分の心に知っているからである。"},{"ref":"Eccl.7.23","start":21007023,"end":21007023,"break":"paragraph","ruby":[[4,2,"ちえ"],[16,1,"こと"],[18,1,"こころ"],[27,2,"ちしゃ"],[35,1,"い"],[40,1,"とお"],[42,1,"およ"]],"text":"わたしは知恵をもってこのすべての事を試みて、「わたしは知者となろう」と言ったが、遠く及ばなかった。"},{"ref":"Eccl.7.24","start":21007024,"end":21007024,"break":"none","ruby":[[0,2,"ものごと"],[3,1,"り"],[5,1,"とお"],[15,1,"ふか"],[24,1,"み"]],"text":"物事の理は遠く、また、はなはだ深い。だれがこれを見いだすことができよう。"},{"ref":"Eccl.7.25","start":21007025,"end":21007025,"break":"none","ruby":[[5,1,"こころ"],[7,1,"てん"],[11,1,"もの"],[13,1,"し"],[16,1,"こと"],[18,1,"さぐ"],[21,2,"ちえ"],[24,2,"どうり"],[27,1,"もと"],[36,1,"あく"],[38,1,"おろ"],[44,2,"ぐち"],[47,2,"きょうき"],[55,1,"し"]],"text":"わたしは、心を転じて、物を知り、事を探り、知恵と道理を求めようとし、また悪の愚かなこと、愚痴の狂気であることを知ろうとした。"},{"ref":"Eccl.7.26","start":21007026,"end":21007026,"break":"none","ruby":[[7,1,"こころ"],[13,1,"あみ"],[18,1,"おんな"],[22,1,"て"],[31,1,"おんな"],[34,1,"し"],[38,1,"にが"],[40,1,"もの"],[47,1,"み"],[53,1,"かみ"],[55,1,"よろこ"],[58,1,"もの"],[60,2,"かのじょ"],[72,1,"つみ"],[76,2,"かのじょ"],[79,1,"とら"]],"text":"わたしは、その心が、わなと網のような女、その手が、かせのような女は、死よりも苦い者であることを見いだした。神を喜ばす者は彼女からのがれる。しかし罪びとは彼女に捕えられる。"},{"ref":"Eccl.7.27","start":21007027,"end":21007027,"break":"none","ruby":[[0,3,"でんどうしゃ"],[4,1,"い"],[7,1,"み"],[12,1,"かず"],[14,1,"し"],[25,1,"かぞ"],[33,1,"え"]],"text":"伝道者は言う、見よ、その数を知ろうとして、いちいち数えて、わたしが得たものはこれである。"},{"ref":"Eccl.7.28","start":21007028,"end":21007028,"break":"none","ruby":[[9,1,"もと"],[17,1,"え"],[28,1,"にん"],[37,2,"だんし"],[40,1,"え"],[61,2,"じょし"],[65,1,"え"]],"text":"わたしはなおこれを求めたけれども、得なかった。わたしは千人のうちにひとりの男子を得たけれども、そのすべてのうちに、ひとりの女子をも得なかった。"},{"ref":"Eccl.7.29","start":21007029,"end":21007029,"break":"none","ruby":[[0,1,"み"],[7,1,"え"],[9,1,"こと"],[27,1,"かみ"],[29,1,"ひと"],[31,1,"ただ"],[34,1,"もの"],[36,1,"つく"],[45,1,"ひと"],[47,1,"おお"],[50,2,"けいりゃく"],[53,1,"かんが"],[55,1,"だ"],[58,1,"こと"]],"text":"見よ、わたしが得た事は、ただこれだけである。すなわち、神は人を正しい者に造られたけれども、人は多くの計略を考え出した事である。"}]