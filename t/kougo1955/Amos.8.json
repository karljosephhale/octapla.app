[{"ref":"Amos.8.1","start":30008001,"end":30008001,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[15,1,"しめ"],[20,1,"み"],[28,1,"なつ"]],"text":"主なる神は、このようにわたしに示された。見よ、ひとかごの夏のくだものがある。"},{"ref":"Amos.8.2","start":30008002,"end":30008002,"break":"none","breaks":[[60,"stanza"],[76,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[17,1,"なに"],[19,1,"み"],[34,1,"なつ"],[42,1,"こた"],[49,1,"しゅ"],[55,1,"い"],[63,1,"たみ"],[70,1,"おわ"],[80,1,"ふたた"],[82,1,"かれ"],[85,2,"みすご"]],"text":"主は言われた、「アモスよ、あなたは何を見るか」。わたしは「ひとかごの夏のくだもの」と答えた。すると主はわたしに言われた、「わが民イスラエルの終りがきた。わたしは再び彼らを見過しにしない。"},{"ref":"Amos.8.3","start":30008003,"end":30008003,"break":"line","breaks":[[15,"line"],[27,"line"],[47,"line"]],"ruby":[[2,1,"ひ"],[5,1,"みや"],[7,1,"うた"],[9,1,"なげ"],[12,1,"かわ"],[27,2,"ひとびと"],[30,2,"むごん"],[36,1,"いた"],[38,1,"ところ"],[40,1,"な"],[42,1,"す"],[47,1,"しゅ"],[50,1,"かみ"],[52,1,"い"]],"text":"その日には宮の歌は嘆きに変り、しかばねがおびただしく、人々は無言でこれを至る所に投げ捨てる」と主なる神は言われる。"},{"ref":"Amos.8.4","start":30008004,"end":30008004,"break":"stanza","breaks":[[16,"line"],[31,"line"]],"ruby":[[6,1,"まず"],[9,1,"もの"],[11,1,"ふ"],[18,1,"くに"],[20,1,"とぼ"],[23,1,"もの"],[25,1,"ほろ"],[28,1,"もの"],[34,1,"き"]],"text":"あなたがた、貧しい者を踏みつけ、また国の乏しい者を滅ぼす者よ、これを聞け。"},{"ref":"Amos.8.5","start":30008005,"end":30008005,"break":"line","breaks":[[9,"line"],[23,"line"],[41,"line"],[55,"line"],[74,"line"],[96,"line"]],"ruby":[[6,1,"い"],[10,2,"しんげつ"],[15,1,"す"],[17,1,"さ"],[34,2,"こくもつ"],[37,1,"う"],[41,3,"あんそくにち"],[47,1,"す"],[49,1,"さ"],[66,1,"むぎ"],[68,1,"う"],[70,1,"だ"],[82,1,"ちい"],[91,1,"おお"],[96,1,"いつわ"],[106,1,"あざむ"]],"text":"あなたがたは言う、「新月はいつ過ぎ去るだろう、そうしたら、われわれは穀物を売ろう。安息日はいつ過ぎ去るだろう、そうしたら、われわれは麦を売り出そう。われわれはエパを小さくし、シケルを大きくし、偽りのはかりをもって欺き、"},{"ref":"Amos.8.6","start":30008006,"end":30008006,"break":"line","breaks":[[10,"line"],[25,"line"]],"ruby":[[0,1,"とぼ"],[3,1,"もの"],[5,1,"かね"],[7,1,"か"],[10,1,"まず"],[13,1,"もの"],[18,1,"そく"],[20,1,"か"],[30,1,"むぎ"],[32,1,"う"]],"text":"乏しい者を金で買い、貧しい者をくつ一足で買いとり、また、くず麦を売ろう」。"},{"ref":"Amos.8.7","start":30008007,"end":30008007,"break":"stanza","breaks":[[16,"line"],[33,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ほこり"],[11,1,"ちか"],[21,1,"かなら"],[23,1,"かれ"],[38,1,"わす"]],"text":"主はヤコブの誇をさして誓われた、「わたしは必ず彼らのすべてのわざをいつまでも忘れない。"},{"ref":"Amos.8.8","start":30008008,"end":30008008,"break":"line","breaks":[[18,"line"],[36,"line"],[54,"line"]],"ruby":[[6,1,"ち"],[8,1,"ふる"],[18,1,"ち"],[20,1,"す"],[22,1,"もの"],[26,1,"なげ"],[36,1,"ち"],[43,1,"かわ"],[62,1,"かわ"],[75,1,"しず"]],"text":"これがために地は震わないであろうか。地に住む者はみな嘆かないであろうか。地はみなナイル川のようにわきあがり、エジプトのナイル川のようにみなぎって、また沈まないであろうか」。"},{"ref":"Amos.8.9","start":30008009,"end":30008009,"break":"stanza","breaks":[[10,"line"],[17,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[13,1,"ひ"],[21,2,"まひる"],[24,2,"たいよう"],[27,1,"しず"],[31,2,"はくちゅう"],[34,1,"ち"],[36,1,"くら"]],"text":"主なる神は言われる、「その日には、わたしは真昼に太陽を沈ませ、白昼に地を暗くし、"},{"ref":"Amos.8.10","start":30008010,"end":30008010,"break":"line","breaks":[[15,"line"],[38,"line"],[54,"line"],[68,"line"],[89,"line"]],"ruby":[[6,1,"まつり"],[8,1,"なげ"],[11,1,"かわ"],[21,1,"うた"],[28,1,"かな"],[32,1,"うた"],[34,1,"かわ"],[42,1,"ひと"],[44,2,"あらぬの"],[47,1,"こし"],[58,1,"ひと"],[60,1,"かみ"],[64,1,"おと"],[70,1,"ひ"],[76,1,"こ"],[78,1,"うしな"],[81,2,"もちゅう"],[91,1,"おわ"],[95,1,"にが"],[97,1,"ひ"]],"text":"あなたがたの祭を嘆きに変らせ、あなたがたの歌をことごとく悲しみの歌に変らせ、すべての人に荒布を腰にまとわせ、すべての人に髪をそり落させ、その日を、ひとり子を失った喪中のようにし、その終りを、苦い日のようにする」。"},{"ref":"Amos.8.11","start":30008011,"end":30008011,"break":"stanza","breaks":[[10,"line"],[33,"line"],[47,"line"],[58,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[11,1,"み"],[24,1,"くに"],[26,1,"おく"],[28,1,"ひ"],[30,1,"く"],[47,1,"みず"],[58,1,"しゅ"],[60,2,"ことば"],[63,1,"き"]],"text":"主なる神は言われる、「見よ、わたしがききんをこの国に送る日が来る、それはパンのききんではない、水にかわくのでもない、主の言葉を聞くことのききんである。"},{"ref":"Amos.8.12","start":30008012,"end":30008012,"break":"line","breaks":[[15,"line"],[37,"line"]],"ruby":[[0,1,"かれ"],[3,1,"うみ"],[6,1,"うみ"],[12,1,"ある"],[15,1,"しゅ"],[17,2,"ことば"],[20,1,"もと"],[43,1,"え"]],"text":"彼らは海から海へさまよい歩き、主の言葉を求めて、こなたかなたへはせまわる、しかしこれを得ないであろう。"},{"ref":"Amos.8.13","start":30008013,"end":30008013,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"ひ"],[5,1,"うつく"],[13,1,"わか"],[15,1,"おとこ"],[24,1,"き"],[26,1,"うしな"]],"text":"その日には美しいおとめも、若い男もかわきのために気を失う。"},{"ref":"Amos.8.14","start":30008014,"end":30008014,"break":"line","breaks":[[17,"line"],[40,"line"],[62,"line"]],"ruby":[[14,1,"ちか"],[26,1,"かみ"],[28,1,"い"],[35,1,"い"],[47,1,"みち"],[49,1,"い"],[56,1,"い"],[58,1,"もの"],[62,1,"かなら"],[64,1,"たお"],[68,1,"ふたた"],[70,1,"お"]],"text":"かのサマリヤのアシマをさして誓い、『ダンよ、あなたの神は生きている』と言い、また『ベエルシバの道は生きている』と言う者どもは必ず倒れる。再び起きあがることはない」。"}]