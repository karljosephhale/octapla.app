[{"ref":"1Sam.4.1","start":9004001,"end":9004001,"break":"paragraph","ruby":[[8,1,"で"],[17,1,"たたか"],[34,1,"じん"],[50,1,"じん"]],"text":"イスラエルびとは出てペリシテびとと戦おうとして、エベネゼルのほとりに陣をしき、ペリシテびとはアペクに陣をしいた。"},{"ref":"1Sam.4.2","start":9004002,"end":9004002,"break":"none","ruby":[[19,1,"じん"],[20,1,"そな"],[27,1,"たたか"],[30,1,"およ"],[49,1,"まえ"],[51,1,"やぶ"],[61,2,"せんじょう"],[74,1,"にん"],[76,1,"ころ"]],"text":"ペリシテびとはイスラエルびとにむかって陣備えをしたが、戦うに及んで、イスラエルびとはペリシテびとの前に敗れ、ペリシテびとは戦場において、おおよそ四千人を殺した。"},{"ref":"1Sam.4.3","start":9004003,"end":9004003,"break":"none","ruby":[[0,1,"たみ"],[2,2,"じんえい"],[5,1,"しりぞ"],[8,1,"とき"],[16,2,"ちょうろう"],[21,1,"い"],[31,1,"しゅ"],[44,1,"まえ"],[51,1,"やぶ"],[61,1,"い"],[64,1,"しゅ"],[66,2,"けいやく"],[69,1,"はこ"],[74,1,"たずさ"],[89,1,"しゅ"],[99,1,"むか"],[103,1,"てき"],[105,1,"て"],[108,1,"すく"]],"text":"民が陣営に退いた時、イスラエルの長老たちは言った、「なにゆえ、主はきょう、ペリシテびとの前にわれわれを敗られたのか。シロへ行って主の契約の箱をここへ携えてくることにしよう。そして主をわれわれのうちに迎えて、敵の手から救っていただこう」。"},{"ref":"1Sam.4.4","start":9004004,"end":9004004,"break":"none","ruby":[[3,1,"たみ"],[5,1,"ひと"],[20,1,"うえ"],[22,1,"ざ"],[29,2,"ばんぐん"],[32,1,"しゅ"],[34,2,"けいやく"],[37,1,"はこ"],[44,1,"たずさ"],[54,1,"とき"],[62,1,"こ"],[73,1,"かみ"],[75,2,"けいやく"],[78,1,"はこ"],[80,1,"とも"],[85,1,"ところ"]],"text":"そこで民は人をシロにつかわし、ケルビムの上に座しておられる万軍の主の契約の箱を、そこから携えてこさせた。その時エリのふたりの子、ホフニとピネハスは神の契約の箱と共に、その所にいた。"},{"ref":"1Sam.4.5","start":9004005,"end":9004005,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"けいやく"],[5,1,"はこ"],[7,2,"じんえい"],[13,1,"とき"],[25,2,"おおごえ"],[28,1,"さけ"],[34,1,"ち"],[36,1,"な"],[38,1,"ひび"]],"text":"主の契約の箱が陣営についた時、イスラエルびとはみな大声で叫んだので、地は鳴り響いた。"},{"ref":"1Sam.4.6","start":9004006,"end":9004006,"break":"none","ruby":[[10,1,"さけ"],[12,1,"ごえ"],[14,1,"き"],[17,1,"い"],[28,2,"じんえい"],[34,1,"おお"],[37,1,"さけ"],[39,1,"ごえ"],[41,2,"なにごと"],[49,1,"しゅ"],[51,1,"はこ"],[54,2,"じんえい"],[57,1,"つ"],[63,1,"し"],[66,1,"とき"]],"text":"ペリシテびとは、その叫び声を聞いて言った、「ヘブルびとの陣営の、この大きな叫び声は何事か」。そして主の箱が、陣営に着いたことを知った時、"},{"ref":"1Sam.4.7","start":9004007,"end":9004007,"break":"none","ruby":[[7,1,"おそ"],[10,1,"い"],[15,2,"かみがみ"],[18,2,"じんえい"],[27,1,"かれ"],[32,1,"い"],[61,1,"いま"]],"text":"ペリシテびとは恐れて言った、「神々が陣営にきたのだ」。彼らはまた言った、「ああ、われわれはわざわいである。このようなことは今までなかった。"},{"ref":"1Sam.4.8","start":9004008,"end":9004008,"break":"none","ruby":[[28,1,"つよ"],[30,2,"かみがみ"],[33,1,"て"],[36,1,"すく"],[38,1,"だ"],[53,2,"かみがみ"],[62,1,"わざわい"],[74,2,"あらの"],[77,1,"う"]],"text":"ああ、われわれはわざわいである。だれがわれわれをこれらの強い神々の手から救い出すことができようか。これらの神々は、もろもろの災をもってエジプトびとを荒野で撃ったのだ。"},{"ref":"1Sam.4.9","start":9004009,"end":9004009,"break":"none","ruby":[[8,2,"ゆうき"],[11,1,"だ"],[14,1,"おとこ"],[33,1,"つか"],[46,1,"かれ"],[49,1,"つか"],[61,1,"おとこ"],[65,1,"たたか"]],"text":"ペリシテびとよ、勇気を出して男らしくせよ。ヘブルびとがあなたがたに仕えたように、あなたがたが彼らに仕えることのないために、男らしく戦え」。"},{"ref":"1Sam.4.10","start":9004010,"end":9004010,"break":"paragraph","ruby":[[11,1,"たたか"],[25,1,"やぶ"],[35,1,"いえ"],[37,1,"に"],[40,1,"かえ"],[44,3,"せんししゃ"],[53,1,"おお"],[62,2,"ほへい"],[65,1,"たお"]],"text":"こうしてペリシテびとが戦ったので、イスラエルびとは敗れて、おのおのその家に逃げて帰った。戦死者はひじょうに多く、イスラエルの歩兵で倒れたものは三万であった。"},{"ref":"1Sam.4.11","start":9004011,"end":9004011,"break":"none","ruby":[[2,1,"かみ"],[4,1,"はこ"],[6,1,"うば"],[17,1,"こ"],[28,1,"ころ"]],"text":"また神の箱は奪われ、エリのふたりの子、ホフニとピネハスは殺された。"},{"ref":"1Sam.4.12","start":9004012,"end":9004012,"break":"paragraph","ruby":[[2,1,"ひ"],[16,2,"いふく"],[19,1,"さ"],[22,1,"あたま"],[24,1,"つち"],[31,2,"せんじょう"],[35,1,"はし"]],"text":"その日ひとりのベニヤミンびとが、衣服を裂き、頭に土をかぶって、戦場から走ってシロにきた。"},{"ref":"1Sam.4.13","start":9004013,"end":9004013,"break":"none","ruby":[[0,1,"かれ"],[2,1,"つ"],[11,1,"みち"],[20,2,"じぶん"],[23,1,"ざ"],[29,1,"ま"],[40,1,"こころ"],[42,1,"かみ"],[44,1,"はこ"],[46,1,"こと"],[48,1,"き"],[63,1,"ひと"],[65,1,"まち"],[72,2,"じょうほう"],[82,1,"まち"],[88,1,"さけ"]],"text":"彼が着いたとき、エリは道のかたわらにある自分の座にすわって待ちかまえていた。その心に神の箱の事を気づかっていたからである。その人が町にはいって、情報をつたえたので、町はこぞって叫んだ。"},{"ref":"1Sam.4.14","start":9004014,"end":9004014,"break":"none","ruby":[[5,1,"さけ"],[7,1,"ごえ"],[9,1,"き"],[12,1,"い"],[19,1,"さわ"],[21,1,"こえ"],[23,1,"なに"],[29,1,"ひと"],[31,1,"いそ"],[37,1,"ところ"],[44,1,"つ"]],"text":"エリはその叫び声を聞いて言った、「この騒ぎ声は何か」。その人は急いでエリの所へきてエリに告げた。"},{"ref":"1Sam.4.15","start":9004015,"end":9004015,"break":"none","ruby":[[2,1,"とき"],[9,1,"さい"],[14,1,"め"],[16,1,"かた"],[20,1,"み"]],"text":"その時エリは九十八歳で、その目は固まって見ることができなかった。"},{"ref":"1Sam.4.16","start":9004016,"end":9004016,"break":"none","ruby":[[2,1,"ひと"],[7,1,"い"],[16,2,"せんじょう"],[30,2,"せんじょう"],[46,1,"い"],[53,1,"こ"],[56,2,"ようす"]],"text":"その人はエリに言った、「わたしは戦場からきたものです。きょう戦場からのがれたのです」。エリは言った、「わが子よ、様子はどうであったか」。"},{"ref":"1Sam.4.17","start":9004017,"end":9004017,"break":"none","ruby":[[11,1,"ひと"],[13,1,"こた"],[16,1,"い"],[37,1,"まえ"],[40,1,"に"],[43,1,"たみ"],[51,1,"おお"],[54,3,"せんししゃ"],[69,1,"こ"],[80,1,"し"],[83,1,"かみ"],[85,1,"はこ"],[87,1,"うば"]],"text":"しらせをもたらしたその人は答えて言った、「イスラエルびとは、ペリシテびとの前から逃げ、民のうちにはまた多くの戦死者があり、あなたのふたりの子、ホフニとピネハスも死に、神の箱は奪われました」。"},{"ref":"1Sam.4.18","start":9004018,"end":9004018,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かみ"],[4,1,"はこ"],[9,1,"い"],[20,1,"ざ"],[29,1,"もん"],[36,1,"お"],[39,1,"くび"],[41,1,"お"],[44,1,"し"],[48,1,"お"],[51,1,"み"],[53,1,"おも"],[63,1,"かれ"],[79,1,"ねん"]],"text":"彼が神の箱のことを言ったとき、エリはその座から、あおむけに門のかたわらに落ち、首を折って死んだ。老いて身が重かったからである。彼のイスラエルをさばいたのは四十年であった。"},{"ref":"1Sam.4.19","start":9004019,"end":9004019,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"よめ"],[9,1,"つま"],[16,2,"しゅっさん"],[19,1,"とき"],[21,1,"ちか"],[29,1,"かみ"],[31,1,"はこ"],[33,1,"うば"],[45,1,"おっと"],[47,1,"し"],[57,1,"き"],[63,2,"じんつう"],[66,1,"おこ"],[68,1,"み"],[74,1,"こ"],[76,1,"う"]],"text":"彼の嫁、ピネハスの妻はみごもって出産の時が近づいていたが、神の箱が奪われたこと、しゅうとと夫が死んだというしらせを聞いたとき、陣痛が起り身をかがめて子を産んだ。"},{"ref":"1Sam.4.20","start":9004020,"end":9004020,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"し"],[11,1,"とき"],[13,2,"せわ"],[20,1,"おんな"],[22,2,"かのじょ"],[25,1,"い"],[30,1,"おそ"],[42,1,"おとこ"],[44,1,"こ"],[46,1,"うま"],[56,2,"かのじょ"],[59,1,"こた"],[67,1,"かえり"]],"text":"彼女が死にかかっている時、世話をしていた女が彼女に言った、「恐れることはありません。男の子が生れました」。しかし彼女は答えもせず、また顧みもしなかった。"},{"ref":"1Sam.4.21","start":9004021,"end":9004021,"break":"none","ruby":[[2,2,"かのじょ"],[6,2,"えいこう"],[15,1,"さ"],[20,1,"い"],[26,1,"こ"],[33,1,"な"],[41,1,"かみ"],[43,1,"はこ"],[45,1,"うば"],[54,2,"かのじょ"],[62,1,"おっと"]],"text":"ただ彼女は「栄光はイスラエルを去った」と言って、その子をイカボデと名づけた。これは神の箱の奪われたこと、また彼女のしゅうとと夫のことによるのである。"},{"ref":"1Sam.4.22","start":9004022,"end":9004022,"break":"none","ruby":[[0,2,"かのじょ"],[7,2,"えいこう"],[16,1,"さ"],[20,1,"かみ"],[22,1,"はこ"],[24,1,"うば"],[34,1,"い"]],"text":"彼女はまた、「栄光はイスラエルを去った。神の箱が奪われたからです」と言った。"}]