[{"ref":"Ps.85.1","start":19085001,"end":19085001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたコラの子の歌","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"くに"],[14,1,"しめ"],[21,2,"はんえい"],[24,2,"かいふく"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[19,1,"こ"],[21,1,"うた"]],"text":"主よ、あなたはみ国にめぐみを示し、ヤコブの繁栄を回復されました。"},{"ref":"Ps.85.2","start":19085002,"end":19085002,"break":"line","breaks":[[15,"line"]],"ruby":[[6,1,"たみ"],[8,2,"ふぎ"],[15,1,"かれ"],[18,1,"つみ"]],"text":"あなたはその民の不義をゆるし、彼らの罪をことごとくおおわれました。〔セラ"},{"ref":"Ps.85.3","start":19085003,"end":19085003,"break":"line","breaks":[[14,"line"]],"ruby":[[8,1,"いか"],[11,1,"す"],[14,1,"はげ"],[17,1,"いきどお"],[20,1,"とお"]],"text":"あなたはすべての怒りを捨て、激しい憤りを遠ざけられました。"},{"ref":"Ps.85.4","start":19085004,"end":19085004,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"すくい"],[6,1,"かみ"],[13,2,"かいふく"],[21,1,"たい"],[28,1,"いきどお"]],"text":"われらの救の神よ、われらを回復し、われらに対するあなたの憤りをおやめください。"},{"ref":"Ps.85.5","start":19085005,"end":19085005,"break":"line","breaks":[[16,"line"]],"ruby":[[13,1,"いか"],[27,1,"いか"],[30,1,"の"]],"text":"あなたはとこしえにわれらを怒り、よろずよまで、あなたの怒りを延ばされるのですか。"},{"ref":"Ps.85.6","start":19085006,"end":19085006,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"たみ"],[14,1,"よろこ"],[17,1,"え"],[26,1,"ふたた"],[28,1,"い"]],"text":"あなたの民が、あなたによって喜びを得るため、われらを再び生かされないのですか。"},{"ref":"Ps.85.7","start":19085007,"end":19085007,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[17,1,"しめ"],[24,1,"すくい"],[30,1,"あた"]],"text":"主よ、あなたのいつくしみをわれらに示し、あなたの救をわれらに与えてください。"},{"ref":"Ps.85.8","start":19085008,"end":19085008,"break":"line","breaks":[[23,"line"],[34,"line"],[50,"line"]],"ruby":[[4,1,"しゅ"],[7,1,"かみ"],[9,1,"かた"],[16,1,"き"],[23,1,"しゅ"],[27,1,"たみ"],[31,2,"せいと"],[40,1,"こころ"],[42,1,"しゅ"],[44,1,"む"],[47,1,"もの"],[50,2,"へいわ"],[53,1,"かた"]],"text":"わたしは主なる神の語られることを聞きましょう。主はその民、その聖徒、ならびにその心を主に向ける者に、平和を語られるからです。"},{"ref":"Ps.85.9","start":19085009,"end":19085009,"break":"line","breaks":[[19,"line"]],"ruby":[[7,1,"すくい"],[9,1,"かみ"],[11,1,"おそ"],[14,1,"もの"],[16,1,"ちか"],[21,2,"えいこう"],[28,1,"くに"]],"text":"まことに、その救は神を恐れる者に近く、その栄光はわれらの国にとどまるでしょう。"},{"ref":"Ps.85.10","start":19085010,"end":19085010,"break":"line","breaks":[[17,"line"]],"ruby":[[12,1,"とも"],[14,1,"あ"],[17,1,"ぎ"],[19,2,"へいわ"],[23,1,"たがい"],[25,1,"くち"]],"text":"いつくしみと、まこととは共に会い、義と平和とは互に口づけし、"},{"ref":"Ps.85.11","start":19085011,"end":19085011,"break":"line","breaks":[[10,"line"]],"ruby":[[4,1,"ち"],[10,1,"ぎ"],[12,1,"てん"],[15,1,"み"]],"text":"まことは地からはえ、義は天から見おろすでしょう。"},{"ref":"Ps.85.12","start":19085012,"end":19085012,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"よ"],[4,1,"もの"],[6,1,"あた"],[18,1,"くに"],[22,2,"さんぶつ"],[25,1,"だ"]],"text":"主が良い物を与えられるので、われらの国はその産物を出し、"},{"ref":"Ps.85.13","start":19085013,"end":19085013,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"ぎ"],[2,1,"しゅ"],[5,1,"まえ"],[7,1,"い"],[12,2,"あしあと"],[15,1,"みち"]],"text":"義は主のみ前に行き、その足跡を道とするでしょう。"}]