[{"ref":"Jer.51.1","start":24051001,"end":24051001,"break":"paragraph","breaks":[[9,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[10,1,"み"],[18,1,"ほろ"],[21,1,"もの"],[23,1,"こころ"],[25,1,"ふる"],[27,1,"おこ"],[36,1,"せ"],[44,1,"す"],[46,1,"もの"],[48,1,"せ"]],"text":"主はこう言われる、「見よ、わたしは、滅ぼす者の心を奮い起して、バビロンを攻め、カルデヤに住む者を攻めさせる。"},{"ref":"Jer.51.2","start":24051002,"end":24051002,"break":"line","breaks":[[23,"line"],[44,"line"]],"ruby":[[13,1,"わ"],[16,1,"もの"],[23,1,"かれ"],[29,1,"わざわい"],[31,1,"ひ"],[34,2,"しほう"],[41,1,"せ"],[50,1,"わ"],[56,1,"ち"]],"text":"わたしはバビロンに、あおぎ分ける者をつかわす。彼らは、その災の日に、四方からこれを攻め、それをあおぎ分けて、その地をむなしくする。"},{"ref":"Jer.51.3","start":24051003,"end":24051003,"break":"line","breaks":[[17,"line"],[32,"line"]],"ruby":[[0,2,"いて"],[6,1,"ゆみ"],[8,1,"は"],[21,1,"き"],[23,1,"た"],[25,1,"あ"],[34,1,"わか"],[36,1,"もの"],[49,2,"ぐんぜい"],[57,1,"ほろ"]],"text":"射手にはその弓を張らせることなく、よろいを着て立ち上がらせるな。その若き者をあわれむことなく、その軍勢をことごとく滅ぼせ。"},{"ref":"Jer.51.4","start":24051004,"end":24051004,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[10,1,"ち"],[12,1,"ころ"],[16,1,"たお"],[25,1,"きず"],[29,1,"たお"]],"text":"彼らはカルデヤびとの地に殺されて倒れ、そのちまたに傷ついて倒れる。"},{"ref":"Jer.51.5","start":24051005,"end":24051005,"break":"line","breaks":[[9,"line"],[29,"line"],[42,"line"],[60,"line"]],"ruby":[[11,1,"かみ"],[13,2,"ばんぐん"],[16,1,"しゅ"],[18,1,"す"],[39,1,"ち"],[48,2,"せいじゃ"],[51,1,"む"],[55,1,"おか"],[58,1,"つみ"],[60,1,"み"]],"text":"イスラエルとユダはその神、万軍の主に捨てられてはいないが、しかしカルデヤびとの地にはイスラエルの聖者に向かって犯した罪が満ちている。"},{"ref":"Jer.51.6","start":24051006,"end":24051006,"break":"stanza","breaks":[[15,"line"],[26,"line"],[49,"line"],[65,"line"]],"ruby":[[12,1,"で"],[21,1,"いのち"],[23,1,"すく"],[28,1,"ばつ"],[36,1,"た"],[38,1,"ほろ"],[49,1,"いま"],[51,1,"しゅ"],[56,1,"かえ"],[60,1,"とき"],[68,2,"ほうふく"]],"text":"バビロンのうちからのがれ出て、おのおのその命を救え。その罰にまきこまれて断ち滅ぼされてはならない。今は主があだを返される時だから、それに報復をされるのである。"},{"ref":"Jer.51.7","start":24051007,"end":24051007,"break":"line","breaks":[[22,"line"],[33,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"て"],[14,1,"きん"],[16,1,"さかずき"],[26,1,"ち"],[28,1,"よ"],[33,2,"くにぐに"],[38,1,"さけ"],[40,1,"の"],[46,2,"くにぐに"],[49,1,"くる"]],"text":"バビロンは主の手のうちにある金の杯であって、すべての地を酔わせた。国々はその酒を飲んだので、国々は狂った。"},{"ref":"Jer.51.8","start":24051008,"end":24051008,"break":"line","breaks":[[16,"line"],[25,"line"],[38,"line"]],"ruby":[[9,1,"たお"],[12,1,"やぶ"],[22,1,"なげ"],[27,1,"きず"],[32,2,"にゅうこう"],[35,1,"と"],[48,1,"し"]],"text":"バビロンはたちまち倒れて破れた。これがために嘆け。その傷のために乳香を取れ。あるいは、いえるかも知れない。"},{"ref":"Jer.51.9","start":24051009,"end":24051009,"break":"line","breaks":[[19,"line"],[29,"line"],[41,"line"],[54,"line"],[63,"line"]],"ruby":[[37,1,"す"],[45,2,"じぶん"],[48,1,"くに"],[50,1,"かえ"],[56,1,"ばつ"],[58,1,"てん"],[60,1,"たっ"],[63,1,"くも"],[67,1,"およ"]],"text":"われわれはバビロンをいやそうとしたが、これはいえなかった。われわれはこれを捨てて、おのおの自分の国に帰ろう。その罰が天に達し、雲にまで及んでいるからだ。"},{"ref":"Jer.51.10","start":24051010,"end":24051010,"break":"line","breaks":[[21,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"ただ"],[13,1,"あき"],[39,1,"かみ"],[41,1,"しゅ"],[47,1,"つ"],[49,1,"しめ"]],"text":"主はわれわれの正しいことを明らかにされた。さあ、われわれはシオンで、われわれの神、主のみわざを告げ示そう。"},{"ref":"Jer.51.11","start":24051011,"end":24051011,"break":"paragraph","breaks":[[5,"paragraph"]],"ruby":[[0,1,"や"],[5,1,"たて"],[7,1,"と"],[10,1,"しゅ"],[18,1,"おう"],[22,1,"こころ"],[24,1,"ひ"],[26,1,"た"],[32,1,"しゅ"],[39,1,"おも"],[41,1,"はか"],[50,1,"ほろ"],[59,1,"しゅ"],[64,1,"かえ"],[69,1,"みや"],[74,1,"かえ"]],"text":"矢をとぎ、盾を取れ。主はメデアびとの王たちの心を引き立てられる。主のバビロンに思い図ることは、これを滅ぼすことであり、主があだを返し、その宮のあだを返されるのである。"},{"ref":"Jer.51.12","start":24051012,"end":24051012,"break":"stanza","breaks":[[17,"line"],[39,"line"],[58,"line"]],"ruby":[[5,2,"じょうへき"],[8,1,"む"],[12,1,"はた"],[14,1,"た"],[17,2,"みは"],[21,2,"きょうこ"],[26,2,"ばんぺい"],[29,1,"お"],[32,2,"ふくへい"],[35,1,"そな"],[39,1,"しゅ"],[46,1,"す"],[48,1,"もの"],[50,1,"せ"],[55,1,"はか"],[60,1,"い"],[70,1,"おこな"]],"text":"バビロンの城壁に向かって旗を立て、見張りを強固にし、番兵を置き、伏兵を備えよ。主がバビロンに住む者を攻めようと図り、その言われたことを、いま行われるからだ。"},{"ref":"Jer.51.13","start":24051013,"end":24051013,"break":"line","breaks":[[12,"line"],[23,"line"]],"ruby":[[0,1,"おお"],[3,1,"みず"],[9,1,"す"],[12,1,"おお"],[15,2,"ざいほう"],[18,1,"も"],[20,1,"もの"],[27,1,"おわ"],[30,1,"き"],[35,1,"いのち"],[37,1,"いと"],[39,1,"た"]],"text":"多くの水のほとりに住み、多くの財宝を持つ者よ、あなたの終りが来て、その命の糸は断たれる。"},{"ref":"Jer.51.14","start":24051014,"end":24051014,"break":"line","breaks":[[21,"line"],[35,"line"],[48,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[13,1,"ちか"],[16,1,"い"],[25,1,"かなら"],[35,1,"ひと"],[44,1,"み"],[48,1,"かれ"],[55,1,"む"],[65,1,"こえ"]],"text":"万軍の主はみずからをさして誓い、言われる、わたしは必ずあなたのうちに、人をいなごのように満たす。彼らはあなたに向かって、かちどきの声をあげる。"},{"ref":"Jer.51.15","start":24051015,"end":24051015,"break":"stanza","breaks":[[14,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"ちから"],[9,1,"ち"],[11,1,"つく"],[16,2,"ちえ"],[22,2,"せかい"],[25,1,"た"],[30,1,"さと"],[36,1,"てん"]],"text":"主はその力をもって地を造り、その知恵をもって世界を建て、その悟りをもって天をのべられた。"},{"ref":"Jer.51.16","start":24051016,"end":24051016,"break":"line","breaks":[[10,"line"],[25,"line"],[44,"line"],[61,"line"]],"ruby":[[0,1,"かれ"],[2,1,"こえ"],[4,1,"だ"],[10,1,"てん"],[12,1,"おお"],[15,1,"みず"],[27,1,"ち"],[29,1,"はて"],[32,1,"きり"],[34,1,"た"],[44,1,"かれ"],[46,1,"あめ"],[63,1,"くら"],[66,1,"かぜ"],[68,1,"と"],[70,1,"だ"]],"text":"彼が声を出されると、天に多くの水のざわめきがあり、また地の果から霧を立ちあがらせられる。彼は雨のためにいなびかりをおこし、その倉から風を取り出される。"},{"ref":"Jer.51.17","start":24051017,"end":24051017,"break":"line","breaks":[[15,"line"],[24,"line"],[42,"line"],[52,"line"]],"ruby":[[4,1,"ひと"],[6,1,"おろ"],[9,2,"ちえ"],[19,1,"きん"],[20,3,"ざいくにん"],[26,1,"つく"],[29,2,"ぐうぞう"],[35,1,"はじ"],[44,2,"ぐうぞう"],[47,1,"いつわ"],[49,1,"もの"],[57,1,"いき"]],"text":"すべての人は愚かで知恵がなく、すべての金細工人はその造った偶像のために恥をこうむる。その偶像は偽り物で、そのうちに息がないからだ。"},{"ref":"Jer.51.18","start":24051018,"end":24051018,"break":"line","breaks":[[21,"line"]],"ruby":[[12,1,"まよ"],[21,1,"ばっ"],[26,1,"とき"],[31,1,"ほろ"]],"text":"それらは、むなしいもの、迷いのわざである。罰せられる時になれば滅びるものである。"},{"ref":"Jer.51.19","start":24051019,"end":24051019,"break":"line","breaks":[[22,"line"],[37,"line"],[57,"line"]],"ruby":[[4,1,"ぶん"],[8,1,"かれ"],[22,1,"かれ"],[24,2,"ばんぶつ"],[27,1,"つく"],[29,1,"ぬし"],[43,1,"かれ"],[45,1,"し"],[46,1,"ぎょう"],[51,2,"ぶぞく"],[57,1,"かれ"],[59,1,"な"],[61,2,"ばんぐん"],[64,1,"しゅ"]],"text":"ヤコブの分である彼はこのようなものではない、彼は万物の造り主だからである。イスラエルは彼の嗣業としての部族である。彼の名は万軍の主という。"},{"ref":"Jer.51.20","start":24051020,"end":24051020,"break":"stanza","breaks":[[22,"line"],[42,"line"]],"ruby":[[8,1,"つち"],[13,1,"たたか"],[16,2,"ぶき"],[37,1,"くに"],[39,1,"くだ"],[49,2,"ばんこく"],[52,1,"ほろ"]],"text":"おまえはわたしの鎚であり、戦いの武器である。わたしはおまえをもってすべての国を砕き、おまえをもって万国を滅ぼす。"},{"ref":"Jer.51.21","start":24051021,"end":24051021,"break":"line","breaks":[[23,"line"]],"ruby":[[11,1,"うま"],[16,2,"きしゅ"],[20,1,"くだ"],[30,2,"せんしゃ"],[36,1,"の"],[38,1,"もの"],[41,1,"くだ"]],"text":"おまえをもってわたしは馬と、その騎手とを砕き、おまえをもって戦車とそれに乗る者とを砕く。"},{"ref":"Jer.51.22","start":24051022,"end":24051022,"break":"line","breaks":[[19,"line"],[39,"line"]],"ruby":[[11,1,"おとこ"],[13,1,"おんな"],[16,1,"くだ"],[26,1,"お"],[29,1,"もの"],[31,1,"おさな"],[33,1,"もの"],[36,1,"くだ"],[46,1,"わか"],[48,1,"もの"],[56,1,"くだ"]],"text":"わたしはおまえをもって男と女とを砕き、おまえをもって老いた者と幼い者とを砕き、おまえをもって若い者と、おとめとを砕く。"},{"ref":"Jer.51.23","start":24051023,"end":24051023,"break":"line","breaks":[[12,"line"],[25,"line"],[49,"line"]],"ruby":[[12,2,"ひつじかい"],[18,1,"む"],[22,1,"くだ"],[32,2,"のうふ"],[40,1,"お"],[42,2,"かちく"],[46,1,"くだ"],[69,1,"くだ"]],"text":"わたしはおまえをもって、羊飼と、その群れとを砕き、おまえをもって農夫と、くびきを負う家畜とを砕き、おまえをもっておさたちと、つかさたちとを砕く。"},{"ref":"Jer.51.24","start":24051024,"end":24051024,"break":"paragraph","ruby":[[14,1,"す"],[20,1,"もの"],[24,1,"かれ"],[31,1,"い"],[39,1,"あ"],[42,1,"こと"],[54,1,"め"],[56,1,"まえ"],[58,1,"むく"],[65,1,"しゅ"],[67,1,"い"]],"text":"わたしはバビロンとカルデヤに住むすべての者とに、彼らがシオンで行ったもろもろの悪しき事のために、あなたがたの目の前で報いをすると、主は言われる。"},{"ref":"Jer.51.25","start":24051025,"end":24051025,"break":"paragraph","breaks":[[7,"line"],[22,"line"],[38,"line"],[54,"line"],[66,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"ぜん"],[8,1,"ち"],[10,1,"ほろ"],[13,1,"つく"],[15,1,"ほろ"],[19,1,"やま"],[22,1,"み"],[33,1,"てき"],[42,1,"て"],[48,1,"うえ"],[50,1,"の"],[58,1,"いわ"],[70,1,"や"],[72,1,"やま"]],"text":"主は言われる、全地を滅ぼし尽す滅ぼしの山よ、見よ、わたしはおまえの敵となる、わたしは手をおまえの上に伸べて、おまえを岩からころばし、おまえを焼け山にする。"},{"ref":"Jer.51.26","start":24051026,"end":24051026,"break":"line","breaks":[[7,"line"],[31,"line"],[43,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"ひと"],[14,1,"いし"],[16,1,"と"],[20,1,"すみ"],[22,1,"いし"],[33,1,"いしずえ"],[52,1,"あ"],[54,1,"ち"]],"text":"主は言われる、人がおまえから石を取って、隅の石とすることなく、また礎とすることもない。おまえはいつまでも荒れ地となっている。"},{"ref":"Jer.51.27","start":24051027,"end":24051027,"break":"line","breaks":[[20,"line"],[34,"line"],[56,"line"],[62,"line"],[75,"line"]],"ruby":[[0,1,"ち"],[2,1,"はた"],[4,1,"た"],[7,2,"くにぐに"],[17,1,"ふ"],[20,2,"くにぐに"],[23,1,"たみ"],[25,1,"あつ"],[31,1,"せ"],[49,2,"くにぐに"],[59,1,"せ"],[62,1,"ぐん"],[64,1,"ちょう"],[66,1,"た"],[72,1,"せ"],[75,1,"むら"],[85,1,"うま"],[87,1,"のぼ"],[89,1,"い"]],"text":"地に旗を立て、国々のうちにラッパを吹き、国々の民を集めてそれを攻め、アララテ、ミンニ、アシケナズの国々をまねいてそれを攻め、軍の長を立ててそれを攻め、群がるいなごのように馬を上り行かせよ。"},{"ref":"Jer.51.28","start":24051028,"end":24051028,"break":"line","breaks":[[14,"line"],[25,"line"],[38,"line"]],"ruby":[[0,2,"くにぐに"],[3,1,"たみ"],[5,1,"あつ"],[11,1,"せ"],[20,1,"おう"],[45,2,"りょうち"],[48,2,"ひとびと"],[51,1,"あつ"],[57,1,"せ"]],"text":"国々の民を集めてそれを攻め、メデアびとの王たちと、そのおさたち、つかさたち、およびすべての領地の人々を集めてこれを攻めよ。"},{"ref":"Jer.51.29","start":24051029,"end":24051029,"break":"line","breaks":[[16,"line"],[37,"line"]],"ruby":[[2,1,"ち"],[4,1,"ふる"],[12,1,"くる"],[16,1,"しゅ"],[20,1,"おも"],[22,1,"はか"],[42,1,"ち"],[45,1,"す"],[47,1,"ひと"],[50,1,"あ"],[52,1,"ち"]],"text":"その地は震い、かつもだえ苦しむ、主がその思い図ることをバビロンにおこない、バビロンの地を、住む人なき荒れ地とされるからだ。"},{"ref":"Jer.51.30","start":24051030,"end":24051030,"break":"line","breaks":[[17,"line"],[39,"line"]],"ruby":[[5,2,"ゆうし"],[10,1,"たたか"],[19,1,"しろ"],[25,1,"ちから"],[31,1,"おんな"],[41,1,"いえ"],[43,1,"や"],[48,1,"かん"],[50,1,"き"],[52,1,"くだ"]],"text":"バビロンの勇士たちは戦いをやめて、その城にこもり、力はうせて、女のようになる。その家は焼け、その貫の木は砕かれる。"},{"ref":"Jer.51.31","start":24051031,"end":24051031,"break":"line","breaks":[[24,"line"]],"ruby":[[0,2,"ひきゃく"],[3,1,"はし"],[6,2,"ひきゃく"],[9,1,"あ"],[12,2,"ししゃ"],[15,1,"はし"],[18,2,"ししゃ"],[21,1,"あ"],[29,1,"おう"],[31,1,"つ"],[35,1,"まち"],[42,1,"と"]],"text":"飛脚は走って飛脚に会い、使者は走って使者に会い、バビロンの王に告げて、町はことごとく取られ、"},{"ref":"Jer.51.32","start":24051032,"end":24051032,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"わた"],[2,1,"ば"],[4,1,"うば"],[12,1,"ひ"],[14,1,"や"],[18,2,"へいし"],[28,1,"い"]],"text":"渡し場は奪われ、とりでは火で焼かれ、兵士はおびえていると言う。"},{"ref":"Jer.51.33","start":24051033,"end":24051033,"break":"line","breaks":[[20,"line"],[36,"line"],[49,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[15,1,"い"],[25,1,"むすめ"],[28,1,"う"],[30,1,"ば"],[38,1,"ふ"],[42,1,"とき"],[44,1,"き"],[57,1,"か"],[59,1,"と"],[63,1,"とき"],[65,1,"く"]],"text":"万軍の主、イスラエルの神はこう言われる、バビロンの娘は、打ち場のようだ、その踏まれる時が来たのだ。しばらくしてその刈り取られる時が来る」。"},{"ref":"Jer.51.34","start":24051034,"end":24051034,"break":"stanza","breaks":[[24,"line"],[47,"line"],[59,"line"],[76,"line"]],"ruby":[[6,1,"おう"],[19,1,"く"],[21,1,"つく"],[28,1,"ほろ"],[40,1,"うつわ"],[47,1,"りゅう"],[56,1,"の"],[66,1,"もの"],[70,1,"はら"],[72,1,"み"],[80,1,"あら"]],"text":"「バビロンの王ネブカデレザルはわたしを食い尽し、わたしを滅ぼし、わたしを、からの器のようにし、龍のようにわたしを飲み、わたしのうまい物でその腹を満たし、わたしを洗いざらいにした。"},{"ref":"Jer.51.35","start":24051035,"end":24051035,"break":"line","breaks":[[20,"line"],[32,"line"],[51,"line"],[74,"line"]],"ruby":[[8,2,"にくしん"],[16,2,"ぼうぎゃく"],[36,1,"す"],[38,1,"もの"],[40,1,"い"],[56,1,"ち"],[63,1,"す"],[65,1,"もの"],[80,1,"い"]],"text":"わたしとわたしの肉親におこなった暴虐は、バビロンにふりかかる」とシオンに住む者は言わなければならない。「わたしの血はカルデヤに住む者にふりかかる」とエルサレムは言わなければならない。"},{"ref":"Jer.51.36","start":24051036,"end":24051036,"break":"line","breaks":[[13,"line"],[32,"line"],[45,"line"],[61,"line"]],"ruby":[[4,1,"しゅ"],[8,1,"い"],[14,1,"み"],[25,1,"うった"],[42,1,"かえ"],[54,1,"うみ"],[63,1,"いずみ"]],"text":"それゆえ主はこう言われる、「見よ、わたしはあなたの訴えをただし、あなたのためにあだを返す。わたしはバビロンの海をかわかし、その泉をかわかす。"},{"ref":"Jer.51.37","start":24051037,"end":24051037,"break":"line","breaks":[[21,"line"],[33,"line"]],"ruby":[[5,2,"あれづか"],[11,2,"やまいぬ"],[21,1,"おどろ"],[27,1,"わら"],[33,1,"す"],[35,1,"ひと"],[39,1,"ところ"]],"text":"バビロンは荒塚となり、山犬のすまいとなり、驚きとなり、笑いとなり、住む人のない所となる。"},{"ref":"Jer.51.38","start":24051038,"end":24051038,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[9,1,"とも"],[14,1,"わか"]],"text":"彼らはししのように共にほえ、若いししのようにほえる。"},{"ref":"Jer.51.39","start":24051039,"end":24051039,"break":"line","breaks":[[12,"line"],[28,"line"],[49,"line"],[69,"line"]],"ruby":[[0,1,"かれ"],[3,1,"よく"],[5,1,"も"],[10,1,"とき"],[16,1,"うたげ"],[18,1,"もう"],[21,1,"かれ"],[24,1,"よ"],[28,1,"かれ"],[34,1,"き"],[36,1,"うしな"],[43,1,"ねむ"],[52,1,"め"],[69,1,"しゅ"],[71,1,"い"]],"text":"彼らの欲の燃えている時、わたしは宴を設けて彼らを酔わせ、彼らがついに気を失って、ながい眠りにいり、もはや目をさますことのないようにしようと主は言われる。"},{"ref":"Jer.51.40","start":24051040,"end":24051040,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"かれ"],[7,2,"こひつじ"],[16,2,"おひつじ"],[19,1,"お"],[30,1,"ば"],[32,1,"くだ"]],"text":"わたしは彼らを小羊のように、また雄羊や雄やぎのように、ほふり場に下らせよう。"},{"ref":"Jer.51.41","start":24051041,"end":24051041,"break":"stanza","breaks":[[16,"line"],[36,"line"]],"ruby":[[11,1,"と"],[16,1,"ぜん"],[17,1,"ち"],[19,1,"ひと"],[28,1,"もの"],[30,1,"とら"],[47,2,"くにぐに"],[53,1,"おどろ"]],"text":"ああ、バビロンはついに取られた、全地の人の、ほめたたえた者は捕えられた。ああ、バビロンはついに国々のうちに驚きとなった。"},{"ref":"Jer.51.42","start":24051042,"end":24051042,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"うみ"],[18,1,"なみ"]],"text":"海はバビロンにあふれかかり、どよめく波におおわれた。"},{"ref":"Jer.51.43","start":24051043,"end":24051043,"break":"line","breaks":[[9,"line"],[24,"line"],[35,"line"]],"ruby":[[2,2,"まちまち"],[5,1,"あ"],[13,1,"ち"],[18,2,"すなはら"],[24,1,"す"],[26,1,"ひと"],[30,1,"ち"],[35,1,"ひと"],[37,1,"こ"],[48,1,"す"]],"text":"その町々は荒れて、かわいた地となり、砂原となり、住む人のない地となる。人の子はひとりとしてそこを過ぎることはない。"},{"ref":"Jer.51.44","start":24051044,"end":24051044,"break":"line","breaks":[[15,"line"],[33,"line"],[55,"line"]],"ruby":[[12,1,"ばっ"],[25,1,"くち"],[28,1,"と"],[30,1,"だ"],[33,2,"くにぐに"],[36,1,"かわ"],[41,1,"かれ"],[43,1,"なが"],[45,1,"い"],[60,2,"じょうへき"],[63,1,"たお"]],"text":"わたしはバビロンでベルを罰し、そののみこんだものを口から取り出す。国々が川のように彼に流れ入ることはなくなる。バビロンの城壁は倒れた。"},{"ref":"Jer.51.45","start":24051045,"end":24051045,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"たみ"],[13,1,"なか"],[16,1,"で"],[23,1,"しゅ"],[25,1,"はげ"],[28,1,"いか"],[31,1,"まぬか"],[36,1,"いのち"],[38,1,"すく"]],"text":"わが民よ、あなたがたはその中から出て、おのおの主の激しい怒りを免れ、その命を救え。"},{"ref":"Jer.51.46","start":24051046,"end":24051046,"break":"line","breaks":[[12,"line"],[31,"line"],[54,"line"],[64,"line"]],"ruby":[[0,1,"こころ"],[2,1,"よわ"],[14,1,"ち"],[16,1,"き"],[22,1,"おそ"],[37,1,"とし"],[46,1,"つぎ"],[48,1,"とし"],[56,1,"ち"],[58,2,"ぼうぎゃく"],[73,1,"せ"]],"text":"心を弱くしてはならない、この地で聞くうわさを恐れてはならない。うわさはこの年にもくれば、また次の年にもくる。この地に暴虐があり、つかさとつかさとが攻めあうことがある。"},{"ref":"Jer.51.47","start":24051047,"end":24051047,"break":"line","breaks":[[7,"line"],[27,"line"],[40,"line"]],"ruby":[[4,1,"み"],[16,2,"ぐうぞう"],[19,1,"ばっ"],[22,1,"ひ"],[24,1,"く"],[29,1,"ぜん"],[30,1,"ち"],[42,1,"ころ"],[46,1,"もの"],[52,1,"なか"],[54,1,"たお"]],"text":"それゆえ見よ、わたしがバビロンの偶像を罰する日が来る。その全地ははずかしめられ、その殺される者はみなその中に倒れる。"},{"ref":"Jer.51.48","start":24051048,"end":24051048,"break":"line","breaks":[[18,"line"],[30,"line"],[51,"line"]],"ruby":[[0,1,"てん"],[2,1,"ち"],[23,1,"こと"],[25,1,"よろこ"],[27,1,"うた"],[30,1,"ほろ"],[33,1,"もの"],[35,1,"きた"],[37,1,"ほう"],[43,1,"く"],[51,1,"しゅ"],[53,1,"い"]],"text":"天と地とそのうちにあるすべてのものはバビロンの事で喜び歌う。滅ぼす者が北の方からここに来るからであると主は言われる。"},{"ref":"Jer.51.49","start":24051049,"end":24051049,"break":"line","breaks":[[18,"line"],[34,"line"]],"ruby":[[6,1,"ころ"],[10,1,"もの"],[23,1,"たお"],[42,1,"ぜん"],[43,1,"ち"],[45,1,"ころ"],[49,1,"もの"],[51,1,"たお"]],"text":"イスラエルの殺された者たちのために、バビロンは倒れなければならない、バビロンのために全地の殺された者は倒れたのだ。"},{"ref":"Jer.51.50","start":24051050,"end":24051050,"break":"stanza","breaks":[[17,"line"],[33,"line"],[42,"line"]],"ruby":[[17,1,"い"],[20,1,"た"],[33,1,"とお"],[37,1,"しゅ"],[39,1,"おぼ"],[48,1,"こころ"]],"text":"つるぎをのがれてきたあなたがたは、行け、立ちとどまってはならない。遠くから主を覚え、エルサレムを心にとめよ。"},{"ref":"Jer.51.51","start":24051051,"end":24051051,"break":"line","breaks":[[23,"line"],[41,"line"]],"ruby":[[11,1,"き"],[17,1,"は"],[23,3,"いほうじん"],[27,1,"しゅ"],[29,1,"みや"],[31,2,"せいじょ"],[41,1,"はじ"],[48,1,"かお"]],"text":"『われわれはののしりを聞いたので、恥じている。異邦人が主の宮の聖所にはいったので、恥がわれわれの顔をおおった』。"},{"ref":"Jer.51.52","start":24051052,"end":24051052,"break":"stanza","breaks":[[7,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"み"],[20,2,"ぐうぞう"],[23,1,"ばっ"],[26,1,"ひ"],[28,1,"く"],[31,1,"きず"],[37,1,"もの"],[42,2,"ぜんこく"]],"text":"主は言われる、それゆえ見よ、わたしがその偶像を罰する日が来る、傷つけられた者が、その全国にうめくようになる。"},{"ref":"Jer.51.53","start":24051053,"end":24051053,"break":"line","breaks":[[15,"line"],[28,"line"],[41,"line"]],"ruby":[[8,1,"てん"],[10,1,"のぼ"],[17,1,"しろ"],[19,1,"たか"],[23,1,"かた"],[28,1,"ほろ"],[31,1,"もの"],[38,1,"で"],[44,1,"のぞ"],[47,1,"しゅ"],[49,1,"い"]],"text":"たといバビロンが天に上っても、その城を高くして固めても、滅ぼす者はわたしから出て、これに臨むと主は言われる。"},{"ref":"Jer.51.54","start":24051054,"end":24051054,"break":"stanza","breaks":[[12,"line"]],"ruby":[[0,1,"き"],[8,1,"さけ"],[19,1,"ち"],[21,1,"おこ"],[23,1,"おお"],[27,1,"ほろ"],[30,1,"さわ"],[32,1,"こえ"]],"text":"聞け、バビロンの叫びを、カルデヤびとの地に起る大いなる滅びの騒ぎ声を。"},{"ref":"Jer.51.55","start":24051055,"end":24051055,"break":"line","breaks":[[11,"line"],[27,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"ほろ"],[13,1,"おお"],[17,1,"こえ"],[19,1,"た"],[29,1,"なみ"],[31,2,"おおみず"],[37,1,"な"],[46,1,"こえ"],[51,1,"わた"]],"text":"主がバビロンを滅ぼし、その大いなる声を絶やされるのだ。その波は大水のように鳴りとどろき、その声はひびき渡る。"},{"ref":"Jer.51.56","start":24051056,"end":24051056,"break":"line","breaks":[[19,"line"],[40,"line"]],"ruby":[[0,1,"ほろ"],[3,1,"もの"],[8,1,"のぞ"],[16,1,"き"],[21,2,"ゆうし"],[26,1,"とら"],[33,1,"ゆみ"],[35,1,"お"],[40,1,"しゅ"],[42,1,"むく"],[47,1,"かみ"],[53,1,"かなら"],[55,1,"むく"]],"text":"滅ぼす者がこれに臨み、バビロンに来た。その勇士たちは捕えられ、その弓は折られる。主は報いをする神であるから必ず報いられるのだ。"},{"ref":"Jer.51.57","start":24051057,"end":24051057,"break":"line","breaks":[[15,"line"],[39,"line"],[63,"line"]],"ruby":[[6,1,"きみ"],[10,2,"ちしゃ"],[29,2,"ゆうし"],[34,1,"よ"],[39,1,"かれ"],[46,1,"ねむ"],[52,1,"め"],[63,2,"ばんぐん"],[66,1,"しゅ"],[68,1,"よ"],[72,1,"おう"],[77,1,"い"]],"text":"わたしはその君たちと知者たち、おさたち、つかさたち、および勇士たちを酔わせる。彼らは、ながい眠りにいり、目をさますことはない。万軍の主と呼ばれる王がこれを言わせる。"},{"ref":"Jer.51.58","start":24051058,"end":24051058,"break":"line","breaks":[[12,"line"],[29,"line"],[42,"line"],[58,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"い"],[17,1,"ひろ"],[19,2,"じょうへき"],[22,1,"ち"],[31,1,"たか"],[33,1,"もん"],[35,1,"ひ"],[37,1,"や"],[46,1,"たみ"],[48,2,"ろうく"],[58,2,"こくみん"],[63,1,"ひ"],[68,1,"つか"]],"text":"万軍の主はこう言われる、バビロンの広い城壁は地にくずされ、その高い門は火に焼かれる。こうして民の労苦はむなしくなり、国民はただ火のために疲れる」。"},{"ref":"Jer.51.59","start":24051059,"end":24051059,"break":"paragraph","ruby":[[5,1,"こ"],[13,1,"こ"],[22,1,"おう"],[28,1,"とも"],[33,2,"ちせい"],[37,1,"ねん"],[44,1,"い"],[49,3,"よげんしゃ"],[61,1,"めい"],[64,2,"ことば"],[71,2,"しゅくえい"],[74,1,"ちょう"]],"text":"マアセヤの子であるネリヤの子セラヤが、ユダの王ゼデキヤと共に、その治世の四年にバビロンへ行くとき、預言者エレミヤがセラヤに命じた言葉。セラヤは宿営の長であった。"},{"ref":"Jer.51.60","start":24051060,"end":24051060,"break":"none","ruby":[[10,1,"のぞ"],[20,1,"わざわい"],[22,2,"まきもの"],[42,1,"こと"],[55,2,"ことば"]],"text":"エレミヤはバビロンに臨もうとするすべての災を巻物にしるした。これはすなわちバビロンの事についてしるしたすべての言葉である。"},{"ref":"Jer.51.61","start":24051061,"end":24051061,"break":"none","ruby":[[9,1,"い"],[23,1,"い"],[30,1,"わす"],[43,2,"ことば"],[46,1,"よ"]],"text":"エレミヤはセラヤに言った、「あなたはバビロンへ行ったならば、忘れることなくこのすべての言葉を読み、"},{"ref":"Jer.51.62","start":24051062,"end":24051062,"break":"none","ruby":[[3,1,"い"],[10,1,"しゅ"],[19,1,"ところ"],[21,1,"ほろ"],[25,1,"ひと"],[27,1,"けもの"],[30,1,"と"],[40,1,"す"],[42,1,"もの"],[51,2,"えいきゅう"],[57,1,"あ"],[59,1,"ち"],[68,1,"ところ"],[73,1,"かた"]],"text":"そして言いなさい、『主よ、あなたはこの所を滅ぼし、人と獣とを問わず、すべてここに住む者のないようにし、永久にここを荒れ地としようと、この所について語られました』と。"},{"ref":"Jer.51.63","start":24051063,"end":24051063,"break":"none","ruby":[[6,2,"まきもの"],[9,1,"よ"],[11,1,"おわ"],[21,1,"いし"],[33,1,"かわ"],[35,1,"なか"],[37,1,"な"]],"text":"あなたがこの巻物を読み終ったならば、これに石をむすびつけてユフラテ川の中に投げこみ、"},{"ref":"Jer.51.64","start":24051064,"end":24051064,"break":"none","ruby":[[3,1,"い"],[20,1,"しず"],[25,1,"ど"],[27,1,"あ"],[42,1,"わざわい"],[44,1,"くだ"],[65,2,"ことば"]],"text":"そして言いなさい、『バビロンはこのように沈んで、二度と上がってこない。わたしがこれに災を下すからである』と」。ここまではエレミヤの言葉である。"}]