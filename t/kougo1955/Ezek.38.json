[{"ref":"Ezek.38.1","start":26038001,"end":26038001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.38.2","start":26038002,"end":26038002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[14,2,"おおぎみ"],[23,1,"ち"],[33,1,"かお"],[35,1,"む"],[41,1,"たい"],[44,2,"よげん"]],"text":"「人の子よ、メセクとトバルの大君であるマゴグの地のゴグに、あなたの顔を向け、これに対して預言して、"},{"ref":"Ezek.38.3","start":26038003,"end":26038003,"break":"none","ruby":[[0,1,"い"],[3,1,"しゅ"],[6,1,"かみ"],[10,1,"い"],[23,2,"おおぎみ"],[32,1,"み"],[43,1,"てき"]],"text":"言え。主なる神はこう言われる、メセクとトバルの大君であるゴグよ、見よ、わたしはあなたの敵となる。"},{"ref":"Ezek.38.4","start":26038004,"end":26038004,"break":"none","ruby":[[8,1,"ひ"],[41,2,"ぐんぜい"],[45,1,"うま"],[48,2,"きへい"],[52,1,"ひ"],[54,1,"だ"],[57,1,"かれ"],[62,2,"ぶぐ"],[68,2,"おおだて"],[71,2,"こだて"],[74,1,"も"],[86,1,"もの"],[88,2,"たいぐん"]],"text":"わたしはあなたを引きもどし、あなたのあごにかぎをかけて、あなたと、あなたのすべての軍勢と、馬と、騎兵とを引き出す。彼らはみな武具をつけ、大盾、小盾を持ち、すべてつるぎをとる者で大軍である。"},{"ref":"Ezek.38.5","start":26038005,"end":26038005,"break":"none","ruby":[[14,1,"かれ"],[17,1,"とも"],[24,1,"たて"],[30,1,"も"]],"text":"ペルシャ、エチオピヤ、プテは彼らと共におり、みな盾とかぶとを持つ。"},{"ref":"Ezek.38.6","start":26038006,"end":26038006,"break":"none","ruby":[[10,2,"ぐんたい"],[13,1,"きた"],[15,1,"はて"],[32,2,"ぐんたい"],[37,1,"おお"],[40,1,"たみ"],[46,1,"とも"]],"text":"ゴメルとそのすべての軍隊、北の果のベテ・トガルマと、そのすべての軍隊など、多くの民もあなたと共におる。"},{"ref":"Ezek.38.7","start":26038007,"end":26038007,"break":"paragraph","ruby":[[4,1,"そな"],[18,1,"ところ"],[20,1,"あつ"],[24,2,"ぐんたい"],[30,1,"そな"],[43,1,"かれ"],[46,2,"ほご"],[48,1,"しゃ"]],"text":"あなたは備えをなせ。あなたとあなたの所に集まった軍隊は、みな備えをなせ。そしてあなたは彼らの保護者となれ。"},{"ref":"Ezek.38.8","start":26038008,"end":26038008,"break":"none","ruby":[[0,1,"おお"],[3,1,"ひ"],[5,1,"のち"],[11,1,"あつ"],[16,1,"おわ"],[19,1,"ねん"],[25,1,"たたか"],[29,2,"かいふく"],[34,1,"ち"],[40,1,"おお"],[43,1,"たみ"],[45,1,"なか"],[49,2,"ひとびと"],[52,1,"あつ"],[57,1,"ち"],[59,1,"む"],[63,1,"ひさ"],[66,1,"あ"],[78,2,"やまやま"],[81,1,"む"],[85,1,"すす"],[90,2,"ひとびと"],[93,2,"くにぐに"],[97,1,"みちび"],[99,1,"だ"],[106,1,"やす"],[110,1,"す"]],"text":"多くの日の後、あなたは集められ、終りの年にあなたは戦いから回復された地、すなわち多くの民の中から、人々が集められた地に向かい、久しく荒れすたれたイスラエルの山々に向かって進む。その人々は国々から導き出されて、みな安らかに住んでいる。"},{"ref":"Ezek.38.9","start":26038009,"end":26038009,"break":"none","ruby":[[10,2,"ぐんたい"],[15,1,"おお"],[18,1,"たみ"],[20,1,"ひき"],[23,1,"のぼ"],[26,2,"ぼうふう"],[32,1,"すす"],[35,1,"くも"],[40,1,"ち"]],"text":"あなたはそのすべての軍隊および多くの民を率いて上り、暴風のように進み、雲のように地をおおう。"},{"ref":"Ezek.38.10","start":26038010,"end":26038010,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[14,1,"ひ"],[21,1,"こころ"],[23,1,"おも"],[26,1,"おこ"],[29,1,"わる"],[31,1,"はか"],[36,1,"くわだ"]],"text":"主なる神はこう言われる、その日に、あなたの心に思いが起り、悪い計りごとを企てて、"},{"ref":"Ezek.38.11","start":26038011,"end":26038011,"break":"none","ruby":[[0,1,"い"],[8,3,"むぼうび"],[12,2,"むらむら"],[15,1,"ち"],[17,1,"のぼ"],[20,1,"おだ"],[26,1,"やす"],[30,1,"す"],[32,1,"たみ"],[37,1,"いし"],[44,1,"かん"],[46,1,"き"],[48,1,"もん"],[52,1,"ち"],[54,1,"す"],[56,1,"もの"],[60,1,"せ"]],"text":"言う、『わたしは無防備の村々の地に上り、穏やかにして安らかに住む民、すべて石がきもなく、貫の木も門もない地に住む者どもを攻めよう』と。"},{"ref":"Ezek.38.12","start":26038012,"end":26038012,"break":"none","ruby":[[7,1,"もの"],[9,1,"うば"],[12,1,"もの"],[20,1,"ひと"],[22,1,"す"],[32,1,"あ"],[34,1,"あと"],[36,1,"せ"],[41,2,"くにぐに"],[45,1,"あつ"],[52,1,"ち"],[54,2,"ちゅうおう"],[57,1,"す"],[60,2,"かちく"],[63,1,"か"],[64,1,"ざい"],[67,1,"も"],[69,1,"たみ"],[71,1,"せ"]],"text":"そしてあなたは物を奪い、物をかすめ、いま人の住むようになっている荒れ跡を攻め、また国々から集まってきて、地の中央に住み、家畜と貨財とを持つ民を攻めようとする。"},{"ref":"Ezek.38.13","start":26038013,"end":26038013,"break":"none","ruby":[[12,2,"しょうにん"],[25,2,"むらむら"],[32,1,"い"],[40,1,"もの"],[42,1,"うば"],[47,1,"き"],[52,1,"もの"],[61,2,"ぐんたい"],[64,1,"あつ"],[74,2,"きんぎん"],[77,1,"も"],[79,1,"さ"],[82,2,"かちく"],[85,1,"か"],[86,1,"ざい"],[89,1,"と"],[94,1,"おお"],[97,1,"もの"],[99,1,"うば"]],"text":"シバ、デダン、タルシシの商人、およびそのもろもろの村々はあなたに言う、『あなたは物を奪うために来たのか。物をかすめるために軍隊を集めたのか。あなたは金銀を持ち去り、家畜と貨財とを取りあげ、大いに物を奪おうとするのか』と。"},{"ref":"Ezek.38.14","start":26038014,"end":26038014,"break":"paragraph","ruby":[[5,1,"ひと"],[7,1,"こ"],[13,2,"よげん"],[17,1,"い"],[20,1,"しゅ"],[23,1,"かみ"],[27,1,"い"],[34,1,"たみ"],[41,1,"やす"],[45,1,"す"],[49,1,"ひ"],[56,1,"た"]],"text":"それゆえ、人の子よ、ゴグに預言して言え。主なる神はこう言われる、わが民イスラエルの安らかに住むその日に、あなたは立ちあがり、"},{"ref":"Ezek.38.15","start":26038015,"end":26038015,"break":"none","ruby":[[0,1,"きた"],[2,1,"はて"],[8,1,"ところ"],[11,1,"く"],[14,1,"おお"],[17,1,"たみ"],[23,1,"とも"],[30,1,"うま"],[32,1,"の"],[37,2,"ぐんたい"],[40,1,"おお"],[46,2,"へいし"],[49,1,"つよ"]],"text":"北の果のあなたの所から来る。多くの民はあなたと共におり、みな馬に乗り、その軍隊は大きく、その兵士は強い。"},{"ref":"Ezek.38.16","start":26038016,"end":26038016,"break":"none","ruby":[[6,1,"たみ"],[13,1,"せ"],[19,1,"くも"],[24,1,"ち"],[34,1,"おわ"],[37,1,"ひ"],[50,1,"くに"],[52,1,"せ"],[72,1,"せい"],[78,1,"しょ"],[79,2,"こくみん"],[82,1,"め"],[84,1,"まえ"],[92,1,"かれ"],[99,1,"し"]],"text":"あなたはわが民イスラエルに攻めのぼり、雲のように地をおおう。ゴグよ、終りの日にわたしはあなたを、わが国に攻めきたらせ、あなたをとおして、わたしの聖なることを諸国民の目の前にあらわして、彼らにわたしを知らせる。"},{"ref":"Ezek.38.17","start":26038017,"end":26038017,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[16,1,"むかし"],[29,3,"よげんしゃ"],[38,1,"かた"],[60,1,"かれ"],[68,1,"とし"],[69,1,"ひさ"],[72,2,"よげん"],[85,1,"おく"],[89,1,"かれ"],[92,1,"せ"],[98,1,"い"]],"text":"主なる神はこう言われる、わたしが昔、わがしもべイスラエルの預言者たちによって語ったのは、あなたのことではないか。すなわち彼らは、そのころ年久しく預言して、わたしはあなたを送って、彼らを攻めさせると言ったではないか。"},{"ref":"Ezek.38.18","start":26038018,"end":26038018,"break":"none","ruby":[[3,1,"しゅ"],[6,1,"かみ"],[8,1,"い"],[15,1,"ひ"],[30,1,"ち"],[32,1,"せ"],[34,1,"い"],[36,1,"ひ"],[41,1,"いか"],[44,1,"あらわ"]],"text":"しかし主なる神は言われる、その日、すなわちゴグがイスラエルの地に攻め入る日に、わが怒りは現れる。"},{"ref":"Ezek.38.19","start":26038019,"end":26038019,"break":"none","ruby":[[12,1,"も"],[16,1,"いか"],[23,1,"い"],[28,1,"ひ"],[31,1,"かなら"],[39,1,"ち"],[42,1,"おお"],[46,2,"しんどう"]],"text":"わたしは、わがねたみと、燃えたつ怒りとをもって言う。その日には必ずイスラエルの地に、大いなる震動があり、"},{"ref":"Ezek.38.20","start":26038020,"end":26038020,"break":"none","ruby":[[0,1,"うみ"],[2,1,"うお"],[4,1,"そら"],[6,1,"とり"],[8,1,"の"],[10,1,"けもの"],[16,1,"ち"],[18,1,"は"],[23,1,"ち"],[35,1,"ひと"],[40,1,"まえ"],[42,1,"う"],[44,1,"ふる"],[50,2,"やまやま"],[60,1,"お"],[67,1,"いし"],[71,1,"ち"],[73,1,"たお"]],"text":"海の魚、空の鳥、野の獣、すべての地に這うもの、地のおもてにあるすべての人は、わが前に打ち震える。また山々はくずれ、がけは落ち、すべての石がきは地に倒れる。"},{"ref":"Ezek.38.21","start":26038021,"end":26038021,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[17,1,"たい"],[24,1,"おそ"],[27,1,"よ"],[37,1,"ひと"],[46,2,"きょうだい"],[49,1,"む"]],"text":"主なる神は言われる、わたしはゴグに対し、すべての恐れを呼びよせる。すべての人のつるぎは、その兄弟に向けられる。"},{"ref":"Ezek.38.22","start":26038022,"end":26038022,"break":"none","ruby":[[4,2,"えきびょう"],[7,2,"りゅうけつ"],[14,1,"かれ"],[28,1,"あめ"],[36,1,"ひ"],[39,2,"いおう"],[44,1,"かれ"],[48,2,"ぐんたい"],[53,1,"かれ"],[55,1,"とも"],[59,1,"おお"],[62,1,"たみ"],[64,1,"うえ"],[66,1,"ふ"]],"text":"わたしは疫病と流血とをもって彼をさばく。わたしはみなぎる雨と、ひょうと、火と、硫黄とを、彼とその軍隊および彼と共におる多くの民の上に降らせる。"},{"ref":"Ezek.38.23","start":26038023,"end":26038023,"break":"none","ruby":[[11,1,"おお"],[23,1,"せい"],[31,1,"おお"],[34,2,"こくみん"],[37,1,"め"],[39,1,"しめ"],[45,1,"かれ"],[52,1,"しゅ"],[59,1,"さと"]],"text":"そしてわたしはわたしの大いなることと、わたしの聖なることとを、多くの国民の目に示す。そして彼らはわたしが主であることを悟る。"}]