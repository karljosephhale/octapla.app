[{"ref":"Esth.8.1","start":17008001,"end":17008001,"break":"paragraph","ruby":[[2,1,"ひ"],[10,1,"おう"],[16,1,"じん"],[18,1,"てき"],[23,1,"いえ"],[25,2,"おうひ"],[32,1,"あた"],[42,1,"おう"],[44,1,"まえ"],[57,2,"じぶん"],[69,2,"かんけい"],[72,1,"もの"],[78,1,"つ"]],"text":"その日アハシュエロス王は、ユダヤ人の敵ハマンの家を王妃エステルに与えた。モルデカイは王の前にきた。これはエステルが自分とモルデカイがどんな関係の者であるかを告げたからである。"},{"ref":"Esth.8.2","start":17008002,"end":17008002,"break":"none","ruby":[[0,1,"おう"],[7,1,"と"],[9,1,"かえ"],[12,2,"じぶん"],[15,2,"ゆびわ"],[29,1,"あた"],[48,1,"いえ"],[50,2,"かんり"]],"text":"王はハマンから取り返した自分の指輪をはずして、モルデカイに与えた。エステルはモルデカイにハマンの家を管理させた。"},{"ref":"Esth.8.3","start":17008003,"end":17008003,"break":"paragraph","ruby":[[5,1,"ふたた"],[7,1,"おう"],[9,1,"まえ"],[11,1,"そう"],[16,1,"あし"],[22,1,"ふ"],[35,2,"いんぼう"],[41,1,"かれ"],[46,1,"じん"],[48,1,"たい"],[51,1,"くわだ"],[56,2,"けいかく"],[59,1,"のぞ"],[64,1,"なみだ"],[69,1,"こ"],[71,1,"もと"]],"text":"エステルは再び王の前に奏し、その足もとにひれ伏して、アガグびとハマンの陰謀すなわち彼がユダヤ人に対して企てたその計画を除くことを涙ながらに請い求めた。"},{"ref":"Esth.8.4","start":17008004,"end":17008004,"break":"none","ruby":[[0,1,"おう"],[11,1,"きん"],[13,1,"しゃく"],[15,1,"の"],[26,1,"み"],[28,1,"おこ"],[31,1,"おう"],[33,1,"まえ"],[35,1,"た"]],"text":"王はエステルにむかって金の笏を伸べたので、エステルは身を起して王の前に立ち、"},{"ref":"Esth.8.5","start":17008005,"end":17008005,"break":"none","ruby":[[3,1,"い"],[10,1,"おう"],[22,1,"おう"],[24,1,"まえ"],[26,1,"めぐ"],[29,1,"え"],[35,1,"こと"],[37,1,"おう"],[39,1,"まえ"],[41,1,"ただ"],[45,1,"み"],[54,1,"おう"],[56,1,"め"],[76,1,"こ"],[81,1,"おう"],[83,1,"しょ"],[84,1,"しゅう"],[91,1,"じん"],[93,1,"ほろ"],[102,1,"か"],[104,1,"おく"],[107,1,"しょ"],[109,1,"と"],[111,1,"け"],[113,1,"むね"],[115,1,"か"]],"text":"そして言った、「もし王がよしとされ、わたしが王の前に恵みを得、またこの事が王の前に正しいと見え、かつわたしが王の目にかなうならば、アガグびとハンメダタの子ハマンが王の諸州にいるユダヤ人を滅ぼそうとはかって書き送った書を取り消す旨を書かせてください。"},{"ref":"Esth.8.6","start":17008006,"end":17008006,"break":"none","ruby":[[13,1,"たみ"],[15,1,"のぞ"],[21,1,"わざわい"],[28,1,"み"],[51,2,"どうぞく"],[54,1,"ほろ"],[64,1,"み"]],"text":"どうしてわたしは、わたしの民に臨もうとする災を、だまって見ていることができましょうか。どうしてわたしの同族の滅びるのを、だまって見ていることができましょうか」。"},{"ref":"Esth.8.7","start":17008007,"end":17008007,"break":"none","ruby":[[7,1,"おう"],[9,2,"おうひ"],[19,1,"じん"],[26,1,"い"],[38,1,"じん"],[40,1,"ころ"],[57,1,"いえ"],[64,1,"あた"],[73,1,"き"],[75,1,"か"]],"text":"アハシュエロス王は王妃エステルとユダヤ人モルデカイに言った、「ハマンがユダヤ人を殺そうとしたので、わたしはハマンの家をエステルに与え、またハマンを木に掛けさせた。"},{"ref":"Esth.8.8","start":17008008,"end":17008008,"break":"none","ruby":[[6,2,"じぶん"],[11,1,"おも"],[16,1,"おう"],[18,1,"な"],[26,1,"じん"],[32,1,"しょ"],[38,1,"おう"],[40,2,"ゆびわ"],[49,1,"いん"],[51,1,"お"],[57,1,"おう"],[59,1,"な"],[64,1,"か"],[67,1,"おう"],[69,2,"ゆびわ"],[75,1,"いん"],[77,1,"お"],[80,1,"しょ"],[85,1,"と"],[87,1,"け"]],"text":"あなたがたは自分たちの思うままに王の名をもってユダヤ人についての書をつくり、王の指輪をもってそれに印を押すがよい。王の名をもって書き、王の指輪をもって印を押した書はだれも取り消すことができない」。"},{"ref":"Esth.8.9","start":17008009,"end":17008009,"break":"paragraph","ruby":[[2,1,"とき"],[3,1,"おう"],[5,3,"しょきかん"],[9,1,"め"],[11,1,"あつ"],[21,1,"がつ"],[30,1,"つき"],[35,1,"にち"],[61,1,"しゅう"],[65,2,"そうとく"],[68,1,"しょ"],[69,1,"しゅう"],[71,2,"ちじ"],[76,2,"だいじん"],[91,1,"じん"],[96,1,"めい"],[103,1,"か"],[105,1,"おく"],[113,2,"かくしゅう"],[119,2,"もじ"],[122,1,"もち"],[125,1,"かく"],[126,2,"みんぞく"],[132,2,"げんご"],[135,1,"もち"],[138,1,"か"],[140,1,"おく"],[146,1,"じん"],[148,1,"おく"],[156,2,"もじ"],[159,2,"げんご"],[163,1,"もち"]],"text":"その時王の書記官が召し集められた。それは三月すなわちシワンの月の二十三日であった。そしてインドからエチオピヤまでの百二十七州にいる総督、諸州の知事および大臣たちに、モルデカイがユダヤ人について命じたとおりに書き送った。すなわち各州にはその文字を用い、各民族にはその言語を用いて書き送り、ユダヤ人に送るものにはその文字と言語とを用いた。"},{"ref":"Esth.8.10","start":17008010,"end":17008010,"break":"none","ruby":[[2,1,"しょ"],[11,1,"おう"],[13,1,"な"],[18,1,"か"],[22,1,"おう"],[24,2,"ゆびわ"],[30,1,"いん"],[32,1,"お"],[35,1,"おう"],[37,2,"ごよう"],[39,1,"うま"],[50,1,"そだ"],[53,2,"はやうま"],[56,1,"の"],[58,2,"きゅうし"],[64,1,"おく"]],"text":"その書はアハシュエロス王の名をもって書かれ、王の指輪をもって印を押し、王の御用馬として、そのうまやに育った早馬に乗る急使によって送られた。"},{"ref":"Esth.8.11","start":17008011,"end":17008011,"break":"none","ruby":[[2,1,"なか"],[5,1,"おう"],[11,1,"まち"],[18,1,"じん"],[21,1,"かれ"],[24,1,"あい"],[25,1,"あつ"],[29,2,"じぶん"],[34,2,"せいめい"],[37,2,"ほご"],[41,2,"じぶん"],[46,1,"おそ"],[52,2,"しょこく"],[55,1,"しょ"],[56,1,"しゅう"],[62,2,"ぶそう"],[66,1,"たみ"],[71,2,"さいし"],[78,1,"ほろ"],[82,1,"ころ"],[85,1,"た"],[93,1,"か"],[94,1,"ざい"],[96,1,"うば"],[98,1,"と"],[103,1,"ゆる"]],"text":"その中で、王はすべての町にいるユダヤ人に、彼らが相集まって自分たちの生命を保護し、自分たちを襲おうとする諸国、諸州のすべての武装した民を、その妻子もろともに滅ぼし、殺し、絶やし、かつその貨財を奪い取ることを許した。"},{"ref":"Esth.8.12","start":17008012,"end":17008012,"break":"none","ruby":[[5,1,"こと"],[14,1,"おう"],[16,1,"しょ"],[17,1,"しゅう"],[25,1,"がつ"],[34,1,"つき"],[38,1,"にち"],[42,1,"にち"],[47,1,"おこな"],[52,1,"めい"]],"text":"ただしこの事をアハシュエロス王の諸州において、十二月すなわちアダルの月の十三日に、一日のうちに行うことを命じた。"},{"ref":"Esth.8.13","start":17008013,"end":17008013,"break":"none","ruby":[[2,1,"か"],[5,1,"もの"],[7,1,"うつ"],[10,1,"みことのり"],[14,2,"かくしゅう"],[17,1,"つた"],[24,1,"たみ"],[26,2,"こうじ"],[34,1,"じん"],[39,1,"ひ"],[44,1,"そな"],[51,1,"てき"]],"text":"この書いた物の写しを詔として各州に伝え、すべての民に公示して、ユダヤ人に、その日のために備えして、その敵にあだをかえさせようとした。"},{"ref":"Esth.8.14","start":17008014,"end":17008014,"break":"none","ruby":[[0,1,"おう"],[2,2,"ごよう"],[4,1,"うま"],[8,2,"はやうま"],[11,1,"の"],[14,2,"きゅうし"],[18,1,"おう"],[20,1,"めい"],[25,1,"いそ"],[37,1,"で"],[39,1,"い"],[45,1,"みことのり"],[47,2,"しゅと"],[52,1,"だ"]],"text":"王の御用馬である早馬に乗った急使は、王の命によって急がされ、せきたてられて出て行った。この詔は首都スサで出された。"},{"ref":"Esth.8.15","start":17008015,"end":17008015,"break":"paragraph","ruby":[[6,1,"あお"],[8,1,"しろ"],[10,1,"ちょう"],[11,1,"ふく"],[13,1,"き"],[15,1,"おお"],[18,1,"きん"],[20,1,"かんむり"],[27,2,"むらさきいろ"],[30,1,"ほそ"],[31,1,"ぬの"],[33,2,"うわぎ"],[40,1,"おう"],[42,1,"まえ"],[45,1,"で"],[47,1,"い"],[54,2,"まちぢゅう"],[57,1,"こえ"],[62,1,"よろこ"]],"text":"モルデカイは青と白の朝服を着、大きな金の冠をいただき、紫色の細布の上着をまとって王の前から出て行った。スサの町中、声をあげて喜んだ。"},{"ref":"Esth.8.16","start":17008016,"end":17008016,"break":"none","ruby":[[3,1,"じん"],[6,1,"ひかり"],[8,1,"よろこ"],[11,1,"たの"],[15,1,"ほまれ"]],"text":"ユダヤ人には光と喜びと楽しみと誉があった。"},{"ref":"Esth.8.17","start":17008017,"end":17008017,"break":"none","ruby":[[4,1,"しゅう"],[12,1,"まち"],[19,1,"おう"],[21,2,"めいれい"],[24,1,"みことのり"],[26,2,"でんたつ"],[31,1,"ところ"],[38,1,"じん"],[40,1,"よろこ"],[42,1,"たの"],[46,2,"しゅえん"],[49,1,"ひら"],[54,1,"ひ"],[56,2,"しゅくじつ"],[67,1,"くに"],[69,1,"たみ"],[73,1,"おお"],[76,1,"もの"],[81,1,"じん"],[93,1,"じん"],[95,1,"おそ"],[98,1,"こころ"],[100,1,"かれ"],[106,1,"た"]],"text":"いずれの州でも、いずれの町でも、すべて王の命令と詔の伝達された所では、ユダヤ人は喜び楽しみ、酒宴を開いてこの日を祝日とした。そしてこの国の民のうち多くの者がユダヤ人となった。これはユダヤ人を恐れる心が彼らのうちに起ったからである。"}]