[{"ref":"Acts.16.1","start":44016001,"end":44016001,"break":"paragraph","ruby":[[5,1,"かれ"],[11,1,"い"],[14,1,"つぎ"],[21,1,"い"],[34,1,"な"],[36,2,"でし"],[42,2,"しんじゃ"],[48,2,"ふじん"],[51,1,"はは"],[59,1,"じん"],[61,1,"ちち"]],"text":"それから、彼はデルベに行き、次にルステラに行った。そこにテモテという名の弟子がいた。信者のユダヤ婦人を母とし、ギリシヤ人を父としており、"},{"ref":"Acts.16.2","start":44016002,"end":44016002,"break":"none","ruby":[[11,2,"きょうだい"],[16,1,"あいだ"],[19,2,"ひょうばん"],[24,2,"じんぶつ"]],"text":"ルステラとイコニオムの兄弟たちの間で、評判のよい人物であった。"},{"ref":"Acts.16.3","start":44016003,"end":44016003,"break":"none","ruby":[[10,1,"つ"],[13,1,"い"],[24,2,"ちほう"],[32,1,"じん"],[34,2,"てまえ"],[39,1,"かれ"],[41,2,"かつれい"],[44,1,"う"],[50,1,"かれ"],[52,1,"ちち"],[58,1,"じん"],[69,1,"し"]],"text":"パウロはこのテモテを連れて行きたかったので、その地方にいるユダヤ人の手前、まず彼に割礼を受けさせた。彼の父がギリシヤ人であることは、みんな知っていたからである。"},{"ref":"Acts.16.4","start":44016004,"end":44016004,"break":"none","ruby":[[4,1,"かれ"],[7,1,"とお"],[9,2,"まちまち"],[19,2,"しと"],[24,2,"ちょうろう"],[29,1,"と"],[31,1,"き"],[34,2,"じこう"],[37,1,"まも"],[44,2,"ひとびと"],[50,1,"わた"]],"text":"それから彼らは通る町々で、エルサレムの使徒たちや長老たちの取り決めた事項を守るようにと、人々にそれを渡した。"},{"ref":"Acts.16.5","start":44016005,"end":44016005,"break":"none","ruby":[[5,1,"しょ"],[6,2,"きょうかい"],[11,2,"しんこう"],[14,1,"つよ"],[19,1,"ひ"],[23,1,"かず"],[25,1,"ま"]],"text":"こうして、諸教会はその信仰を強められ、日ごとに数を増していった。"},{"ref":"Acts.16.6","start":44016006,"end":44016006,"break":"paragraph","ruby":[[4,1,"かれ"],[12,2,"みことば"],[15,1,"かた"],[20,2,"せいれい"],[23,1,"きん"],[40,2,"ちほう"],[47,1,"い"]],"text":"それから彼らは、アジヤで御言を語ることを聖霊に禁じられたので、フルギヤ・ガラテヤ地方をとおって行った。"},{"ref":"Acts.16.7","start":44016007,"end":44016007,"break":"none","ruby":[[22,1,"すす"],[25,1,"い"],[39,2,"みたま"],[45,1,"ゆる"]],"text":"そして、ムシヤのあたりにきてから、ビテニヤに進んで行こうとしたところ、イエスの御霊がこれを許さなかった。"},{"ref":"Acts.16.8","start":44016008,"end":44016008,"break":"none","ruby":[[8,2,"つうか"],[18,1,"くだ"],[21,1,"い"]],"text":"それで、ムシヤを通過して、トロアスに下って行った。"},{"ref":"Acts.16.9","start":44016009,"end":44016009,"break":"none","ruby":[[3,1,"よる"],[12,1,"まぼろし"],[14,1,"み"],[26,1,"びと"],[28,1,"た"],[39,1,"わた"],[51,1,"たす"],[54,1,"くだ"],[60,1,"かれ"],[62,2,"こんがん"]],"text":"ここで夜、パウロは一つの幻を見た。ひとりのマケドニヤ人が立って、「マケドニヤに渡ってきて、わたしたちを助けて下さい」と、彼に懇願するのであった。"},{"ref":"Acts.16.10","start":44016010,"end":44016010,"break":"none","ruby":[[6,1,"まぼろし"],[8,1,"み"],[10,1,"とき"],[15,1,"かれ"],[18,2,"ふくいん"],[21,1,"つた"],[28,1,"かみ"],[37,1,"まね"],[46,2,"かくしん"],[68,1,"わた"],[71,1,"い"]],"text":"パウロがこの幻を見た時、これは彼らに福音を伝えるために、神がわたしたちをお招きになったのだと確信して、わたしたちは、ただちにマケドニヤに渡って行くことにした。"},{"ref":"Acts.16.11","start":44016011,"end":44016011,"break":"paragraph","ruby":[[16,2,"ふなで"],[27,2,"ちょっこう"],[31,2,"よくじつ"],[39,1,"つ"]],"text":"そこで、わたしたちはトロアスから船出して、サモトラケに直航し、翌日ネアポリスに着いた。"},{"ref":"Acts.16.12","start":44016012,"end":44016012,"break":"none","ruby":[[8,1,"い"],[23,2,"ちほう"],[25,1,"だい"],[28,1,"まち"],[31,2,"しょくみん"],[33,2,"とし"],[49,1,"まち"],[51,3,"すうじつかん"],[54,2,"たいざい"]],"text":"そこからピリピへ行った。これはマケドニヤのこの地方第一の町で、植民都市であった。わたしたちは、この町に数日間滞在した。"},{"ref":"Acts.16.13","start":44016013,"end":44016013,"break":"none","ruby":[[2,3,"あんそくにち"],[13,1,"まち"],[15,1,"もん"],[17,1,"で"],[20,1,"いの"],[22,1,"ば"],[27,1,"おも"],[31,1,"かわ"],[37,1,"い"],[52,1,"あつ"],[58,2,"ふじん"],[63,1,"はなし"]],"text":"ある安息日に、わたしたちは町の門を出て、祈り場があると思って、川のほとりに行った。そして、そこにすわり、集まってきた婦人たちに話をした。"},{"ref":"Acts.16.14","start":44016014,"end":44016014,"break":"none","ruby":[[9,1,"し"],[11,1,"むらさき"],[12,1,"ぬの"],[14,2,"しょうにん"],[18,1,"かみ"],[20,1,"うやま"],[28,2,"ふじん"],[31,1,"き"],[37,1,"しゅ"],[39,2,"かのじょ"],[42,1,"こころ"],[44,1,"ひら"],[52,1,"かた"],[57,1,"みみ"],[59,1,"かたむ"]],"text":"ところが、テアテラ市の紫布の商人で、神を敬うルデヤという婦人が聞いていた。主は彼女の心を開いて、パウロの語ることに耳を傾けさせた。"},{"ref":"Acts.16.15","start":44016015,"end":44016015,"break":"none","ruby":[[6,2,"ふじん"],[11,2,"かぞく"],[15,1,"とも"],[23,1,"う"],[30,1,"とき"],[32,2,"かのじょ"],[43,1,"しゅ"],[45,1,"しん"],[48,1,"もの"],[51,1,"おも"],[66,1,"いえ"],[70,1,"と"],[74,1,"くだ"],[79,2,"こんもう"],[95,1,"い"]],"text":"そして、この婦人もその家族も、共にバプテスマを受けたが、その時、彼女は「もし、わたしを主を信じる者とお思いでしたら、どうぞ、わたしの家にきて泊まって下さい」と懇望し、しいてわたしたちをつれて行った。"},{"ref":"Acts.16.16","start":44016016,"end":44016016,"break":"paragraph","ruby":[[2,1,"とき"],[11,1,"いの"],[13,1,"ば"],[15,1,"い"],[17,2,"とちゅう"],[20,1,"うらな"],[23,1,"れい"],[29,1,"おんな"],[30,2,"どれい"],[33,2,"であ"],[38,2,"かのじょ"],[41,1,"うらな"],[49,2,"しゅじん"],[54,1,"おお"],[57,2,"りえき"],[60,1,"え"],[66,1,"もの"]],"text":"ある時、わたしたちが、祈り場に行く途中、占いの霊につかれた女奴隷に出会った。彼女は占いをして、その主人たちに多くの利益を得させていた者である。"},{"ref":"Acts.16.17","start":44016017,"end":44016017,"break":"none","ruby":[[2,1,"おんな"],[18,1,"お"],[28,1,"ひと"],[35,1,"たか"],[37,1,"かみ"],[39,1,"しもべ"],[50,1,"すくい"],[52,1,"みち"],[54,1,"つた"],[63,1,"さけ"],[65,1,"だ"]],"text":"この女が、パウロやわたしたちのあとを追ってきては、「この人たちは、いと高き神の僕たちで、あなたがたに救の道を伝えるかただ」と、叫び出すのであった。"},{"ref":"Acts.16.18","start":44016018,"end":44016018,"break":"none","ruby":[[10,1,"いく"],[11,2,"にちかん"],[25,1,"こま"],[33,1,"れい"],[48,1,"な"],[53,1,"めい"],[59,1,"おんな"],[62,1,"で"],[64,1,"い"],[68,1,"い"],[78,2,"しゅんかん"],[81,1,"れい"],[83,1,"おんな"],[86,1,"で"],[88,1,"い"]],"text":"そして、そんなことを幾日間もつづけていた。パウロは困りはてて、その霊にむかい「イエス・キリストの名によって命じる。その女から出て行け」と言った。すると、その瞬間に霊が女から出て行った。"},{"ref":"Acts.16.19","start":44016019,"end":44016019,"break":"paragraph","ruby":[[0,2,"かのじょ"],[3,2,"しゅじん"],[9,2,"じぶん"],[13,2,"りえき"],[16,1,"え"],[18,1,"のぞ"],[21,1,"た"],[26,1,"み"],[38,1,"とら"],[41,2,"やくにん"],[44,1,"ひ"],[46,1,"わた"],[50,2,"ひろば"],[53,1,"ひ"],[58,1,"い"]],"text":"彼女の主人たちは、自分らの利益を得る望みが絶えたのを見て、パウロとシラスとを捕え、役人に引き渡すため広場に引きずって行った。"},{"ref":"Acts.16.20","start":44016020,"end":44016020,"break":"none","ruby":[[9,2,"ちょうかん"],[14,1,"まえ"],[16,1,"ひ"],[18,1,"だ"],[21,1,"うった"],[28,1,"ひと"],[35,1,"じん"],[49,1,"まち"],[53,1,"みだ"]],"text":"それから、ふたりを長官たちの前に引き出して訴えた、「この人たちはユダヤ人でありまして、わたしたちの町をかき乱し、"},{"ref":"Acts.16.21","start":44016021,"end":44016021,"break":"none","ruby":[[8,1,"じん"],[11,2,"さいよう"],[14,2,"じっこう"],[24,2,"ふうしゅう"],[27,2,"せんでん"]],"text":"わたしたちローマ人が、採用も実行もしてはならない風習を宣伝しているのです」。"},{"ref":"Acts.16.22","start":44016022,"end":44016022,"break":"none","ruby":[[0,2,"ぐんしゅう"],[8,1,"た"],[16,1,"せ"],[24,2,"ちょうかん"],[33,2,"うわぎ"],[38,1,"と"],[44,1,"う"],[49,1,"めい"]],"text":"群衆もいっせいに立って、ふたりを責めたてたので、長官たちはふたりの上着をはぎ取り、むちで打つことを命じた。"},{"ref":"Acts.16.23","start":44016023,"end":44016023,"break":"none","ruby":[[8,1,"なに"],[9,1,"ど"],[14,1,"くわ"],[22,1,"ごく"],[24,1,"い"],[27,2,"ごくり"],[34,1,"ばん"],[42,1,"めい"]],"text":"それで、ふたりに何度もむちを加えさせたのち、獄に入れ、獄吏にしっかり番をするようにと命じた。"},{"ref":"Acts.16.24","start":44016024,"end":44016024,"break":"none","ruby":[[0,2,"ごくり"],[5,2,"げんめい"],[8,1,"う"],[18,1,"おく"],[20,2,"ごくや"],[23,1,"い"],[28,1,"あし"],[30,1,"あし"]],"text":"獄吏はこの厳命を受けたので、ふたりを奥の獄屋に入れ、その足に足かせをしっかとかけておいた。"},{"ref":"Acts.16.25","start":44016025,"end":44016025,"break":"paragraph","ruby":[[0,3,"まよなか"],[16,1,"かみ"],[18,1,"いの"],[25,1,"うた"],[33,2,"しゅうじん"],[38,1,"みみ"],[44,1,"き"]],"text":"真夜中ごろ、パウロとシラスとは、神に祈り、さんびを歌いつづけたが、囚人たちは耳をすまして聞きいっていた。"},{"ref":"Acts.16.26","start":44016026,"end":44016026,"break":"none","ruby":[[4,2,"とつぜん"],[7,1,"おお"],[8,2,"じしん"],[11,1,"おこ"],[15,1,"ごく"],[17,2,"どだい"],[20,1,"ゆ"],[22,1,"うご"],[25,1,"と"],[27,2,"ぜんぶ"],[33,1,"ひら"],[41,1,"もの"],[43,1,"くさり"],[45,1,"と"]],"text":"ところが突然、大地震が起って、獄の土台が揺れ動き、戸は全部たちまち開いて、みんなの者の鎖が解けてしまった。"},{"ref":"Acts.16.27","start":44016027,"end":44016027,"break":"none","ruby":[[0,2,"ごくり"],[3,1,"め"],[9,1,"ごく"],[11,1,"と"],[13,1,"ひら"],[24,1,"み"],[27,2,"しゅうじん"],[32,1,"に"],[34,1,"だ"],[40,1,"おも"],[47,1,"ぬ"],[50,2,"じさつ"]],"text":"獄吏は目をさまし、獄の戸が開いてしまっているのを見て、囚人たちが逃げ出したものと思い、つるぎを抜いて自殺しかけた。"},{"ref":"Acts.16.28","start":44016028,"end":44016028,"break":"none","ruby":[[7,2,"おおごえ"],[13,1,"い"],[18,2,"じがい"],[33,1,"みな"],[37,1,"のこ"]],"text":"そこでパウロは大声をあげて言った、「自害してはいけない。われわれは皆ひとり残らず、ここにいる」。"},{"ref":"Acts.16.29","start":44016029,"end":44016029,"break":"none","ruby":[[4,2,"ごくり"],[12,1,"て"],[14,1,"い"],[17,1,"うえ"],[19,1,"ごく"],[21,1,"か"],[23,1,"こ"],[44,1,"まえ"],[48,1,"ふ"]],"text":"すると、獄吏は、あかりを手に入れた上、獄に駆け込んできて、おののきながらパウロとシラスの前にひれ伏した。"},{"ref":"Acts.16.30","start":44016030,"end":44016030,"break":"none","ruby":[[9,1,"そと"],[11,1,"つ"],[13,1,"だ"],[16,1,"い"],[21,2,"せんせい"],[30,1,"すく"],[38,1,"なに"]],"text":"それから、ふたりを外に連れ出して言った、「先生がた、わたしは救われるために、何をすべきでしょうか」。"},{"ref":"Acts.16.31","start":44016031,"end":44016031,"break":"none","ruby":[[4,1,"い"],[9,1,"しゅ"],[14,1,"しん"],[34,2,"かぞく"],[37,1,"すく"]],"text":"ふたりが言った、「主イエスを信じなさい。そうしたら、あなたもあなたの家族も救われます」。"},{"ref":"Acts.16.32","start":44016032,"end":44016032,"break":"none","ruby":[[5,1,"かれ"],[9,2,"かぞく"],[11,2,"いちどう"],[16,1,"かみ"],[18,1,"ことば"],[20,1,"かた"],[23,1,"き"]],"text":"それから、彼とその家族一同とに、神の言を語って聞かせた。"},{"ref":"Acts.16.33","start":44016033,"end":44016033,"break":"none","ruby":[[0,1,"かれ"],[2,3,"まよなか"],[17,1,"ひ"],[19,1,"と"],[25,1,"う"],[27,1,"きず"],[29,1,"あら"],[42,1,"ば"],[44,2,"じぶん"],[47,2,"かぞく"],[54,1,"のこ"],[63,1,"う"]],"text":"彼は真夜中にもかかわらず、ふたりを引き取って、その打ち傷を洗ってやった。そして、その場で自分も家族も、ひとり残らずバプテスマを受け、"},{"ref":"Acts.16.34","start":44016034,"end":44016034,"break":"none","ruby":[[8,2,"じぶん"],[11,1,"いえ"],[13,2,"あんない"],[17,2,"しょくじ"],[27,1,"かみ"],[29,1,"しん"],[32,1,"もの"],[41,1,"ぜん"],[42,2,"かぞく"],[45,1,"とも"],[47,1,"こころ"],[50,1,"よろこ"]],"text":"さらに、ふたりを自分の家に案内して食事のもてなしをし、神を信じる者となったことを、全家族と共に心から喜んだ。"},{"ref":"Acts.16.35","start":44016035,"end":44016035,"break":"paragraph","ruby":[[0,1,"よ"],[2,1,"あ"],[7,2,"ちょうかん"],[12,1,"けい"],[13,1,"り"],[25,1,"ひと"],[29,2,"しゃくほう"],[35,1,"い"]],"text":"夜が明けると、長官たちは警吏らをつかわして、「あの人たちを釈放せよ」と言わせた。"},{"ref":"Acts.16.36","start":44016036,"end":44016036,"break":"none","ruby":[[4,2,"ごくり"],[9,2,"ことば"],[16,1,"つた"],[19,1,"い"],[24,2,"ちょうかん"],[36,2,"しゃくほう"],[46,1,"つかい"],[58,1,"で"],[63,2,"ぶじ"],[67,1,"かえ"]],"text":"そこで、獄吏はこの言葉をパウロに伝えて言った、「長官たちが、あなたがたを釈放させるようにと、使をよこしました。さあ、出てきて、無事にお帰りなさい」。"},{"ref":"Acts.16.37","start":44016037,"end":44016037,"break":"none","ruby":[[9,1,"けい"],[10,1,"り"],[13,1,"い"],[18,1,"かれ"],[25,1,"じん"],[35,2,"さいばん"],[45,2,"こうしゅう"],[48,1,"まえ"],[52,1,"う"],[59,1,"ごく"],[61,1,"い"],[73,1,"いま"],[89,1,"だ"],[107,1,"かれ"],[109,2,"じしん"],[123,1,"つ"],[125,1,"だ"]],"text":"ところが、パウロは警吏らに言った、「彼らは、ローマ人であるわれわれを、裁判にかけもせずに、公衆の前でむち打ったあげく、獄に入れてしまった。しかるに今になって、ひそかに、われわれを出そうとするのか。それは、いけない。彼ら自身がここにきて、われわれを連れ出すべきである」。"},{"ref":"Acts.16.38","start":44016038,"end":44016038,"break":"none","ruby":[[0,1,"けい"],[1,1,"り"],[6,2,"ことば"],[9,2,"ちょうかん"],[14,2,"ほうこく"],[22,2,"ちょうかん"],[35,1,"じん"],[38,1,"き"],[41,1,"おそ"]],"text":"警吏らはこの言葉を長官たちに報告した。すると長官たちは、ふたりがローマ人だと聞いて恐れ、"},{"ref":"Acts.16.39","start":44016039,"end":44016039,"break":"none","ruby":[[0,2,"じぶん"],[11,1,"うえ"],[17,1,"ごく"],[20,1,"つ"],[22,1,"だ"],[25,1,"まち"],[28,1,"た"],[30,1,"さ"],[36,1,"たの"]],"text":"自分でやってきてわびた上、ふたりを獄から連れ出し、町から立ち去るようにと頼んだ。"},{"ref":"Acts.16.40","start":44016040,"end":44016040,"break":"none","ruby":[[4,1,"ごく"],[6,1,"で"],[13,1,"いえ"],[15,1,"い"],[23,2,"きょうだい"],[28,1,"あ"],[31,1,"すす"],[41,1,"で"]],"text":"ふたりは獄を出て、ルデヤの家に行った。そして、兄弟たちに会って勧めをなし、それから出かけた。"}]