[{"ref":"Jer.16.1","start":24016001,"end":24016001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"]],"text":"主の言葉はまたわたしに臨んだ、"},{"ref":"Jer.16.2","start":24016002,"end":24016002,"break":"none","ruby":[[7,1,"ところ"],[9,1,"つま"],[26,1,"むすめ"],[28,1,"も"]],"text":"「あなたはこの所で妻をめとってはならない。またむすこ娘を持ってはならない。"},{"ref":"Jer.16.3","start":24016003,"end":24016003,"break":"none","ruby":[[2,1,"ところ"],[4,1,"うま"],[10,1,"むすめ"],[15,1,"ち"],[20,1,"う"],[22,1,"はは"],[30,1,"う"],[32,1,"ちち"],[40,1,"しゅ"],[44,1,"い"]],"text":"この所で生れるむすこ娘と、この地でこれを産む母たちと、これを生む父たちとについて主はこう言われる、"},{"ref":"Jer.16.4","start":24016004,"end":24016004,"break":"none","ruby":[[0,1,"かれ"],[3,1,"し"],[5,1,"やまい"],[11,1,"し"],[14,2,"あいとう"],[18,1,"もの"],[23,2,"まいそう"],[27,1,"もの"],[32,1,"ち"],[39,2,"ふんど"],[59,1,"ほろ"],[67,2,"したい"],[70,1,"そら"],[72,1,"とり"],[74,1,"ち"],[76,1,"けもの"],[78,1,"く"],[80,1,"もの"]],"text":"彼らは死の病にかかって死に、哀悼する者もなく、埋葬する者もなく、地のおもてに、糞土のようになる。またつるぎと、ききんに滅ぼされて、その死体は空の鳥と地の獣の食い物となる。"},{"ref":"Jer.16.5","start":24016005,"end":24016005,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"い"],[9,1,"も"],[13,1,"いえ"],[28,1,"い"],[35,1,"かな"],[38,1,"なげ"],[53,1,"たみ"],[60,2,"へいあん"],[77,1,"と"],[79,1,"さ"],[89,1,"しゅ"],[91,1,"い"]],"text":"主はこう言われる、喪のある家に、はいってはならない。また行って、それを悲しみ嘆いてはならない。わたしがこの民からわたしの平安と、いつくしみと、あわれみとを取り去ったからであると、主は言われる。"},{"ref":"Jer.16.6","start":24016006,"end":24016006,"break":"none","ruby":[[0,1,"おお"],[4,1,"もの"],[6,1,"ちい"],[9,1,"もの"],[14,1,"ち"],[16,1,"し"],[19,1,"かれ"],[22,1,"ほうむ"],[29,1,"かれ"],[35,1,"かな"],[38,1,"もの"],[43,2,"じぶん"],[46,1,"み"],[48,1,"きず"],[52,1,"もの"],[57,1,"かみ"],[61,1,"もの"]],"text":"大いなる者も小さき者も、この地に死ぬ。彼らは葬られず、また彼らのために悲しむ者もなく、自分の身を傷つける者もなく、髪をそる者もない。"},{"ref":"Jer.16.7","start":24016007,"end":24016007,"break":"none","ruby":[[0,1,"かな"],[3,1,"もの"],[15,2,"ししゃ"],[24,1,"なぐさ"],[27,1,"もの"],[34,1,"ちち"],[39,1,"はは"],[44,1,"なぐさ"],[47,1,"さかずき"],[52,1,"あた"],[55,1,"の"],[59,1,"もの"]],"text":"悲しむ者のためにパンをさいて、死者のためにこれを慰める者はなく、また父あるいは母のために慰めの杯をこれに与えて飲ませる者もない。"},{"ref":"Jer.16.8","start":24016008,"end":24016008,"break":"none","ruby":[[6,2,"えんかい"],[11,1,"いえ"],[18,2,"ひとびと"],[21,1,"とも"],[27,1,"く"],[29,1,"の"]],"text":"またあなたは宴会をする家にはいって、人々と共にすわって食い飲みしてはならない。"},{"ref":"Jer.16.9","start":24016009,"end":24016009,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[15,1,"い"],[20,1,"み"],[27,1,"め"],[29,1,"まえ"],[40,1,"よ"],[44,1,"あいだ"],[51,1,"よろこ"],[54,1,"こえ"],[56,1,"たの"],[60,1,"こえ"],[62,2,"はなむこ"],[65,1,"こえ"],[67,2,"はなよめ"],[70,1,"こえ"],[75,1,"ところ"],[77,1,"た"]],"text":"万軍の主、イスラエルの神はこう言われる、見よ、あなたの目の前で、あなたのなおこの世にいる間に、わたしは喜びの声と楽しみの声、花婿の声と花嫁の声とをこの所に絶やしてしまう。"},{"ref":"Jer.16.10","start":24016010,"end":24016010,"break":"paragraph","ruby":[[10,2,"ことば"],[15,1,"たみ"],[17,1,"つ"],[23,1,"かれ"],[30,1,"たず"],[35,1,"しゅ"],[44,1,"おお"],[47,1,"わざわい"],[49,2,"せんこく"],[72,1,"わる"],[74,1,"ところ"],[88,1,"かみ"],[90,1,"しゅ"],[102,1,"おか"],[105,1,"つみ"],[115,1,"い"]],"text":"あなたがこのすべての言葉をこの民に告げるとき、彼らがあなたに尋ねて、『主がわれわれにこの大きな災を宣告されるのはどうしてですか。われわれにどんな悪い所があるのですか。われわれの神、主にそむいて、われわれが犯した罪とはなんですか』と言うならば、"},{"ref":"Jer.16.11","start":24016011,"end":24016011,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[19,1,"しゅ"],[21,1,"おお"],[36,2,"せんぞ"],[43,1,"す"],[46,1,"た"],[48,2,"かみがみ"],[51,1,"したが"],[57,1,"つか"],[63,1,"はい"],[72,1,"す"],[79,2,"りっぽう"],[82,1,"まも"]],"text":"あなたは彼らに答えなければならない、『主は仰せられる、それはあなたがたの先祖がわたしを捨てて他の神々に従い、これに仕え、これを拝し、またわたしを捨て、わたしの律法を守らなかったからである。"},{"ref":"Jer.16.12","start":24016012,"end":24016012,"break":"none","ruby":[[13,2,"せんぞ"],[23,1,"わる"],[31,1,"み"],[44,2,"じぶん"],[47,1,"わる"],[49,2,"ごうじょう"],[52,1,"こころ"],[54,1,"したが"],[61,1,"き"],[63,1,"したが"]],"text":"あなたがたは、あなたがたの先祖よりも、いっそう悪いことをした。見よ、あなたがたはおのおの自分の悪い強情な心に従い、わたしに聞き従うことはしない。"},{"ref":"Jer.16.13","start":24016013,"end":24016013,"break":"none","ruby":[[17,1,"ち"],[20,1,"お"],[22,1,"だ"],[38,2,"せんぞ"],[41,1,"し"],[45,1,"ち"],[47,1,"い"],[54,1,"ところ"],[62,2,"ちゅうや"],[68,2,"かみがみ"],[71,1,"つか"],[98,1,"しめ"]],"text":"それゆえ、わたしはあなたがたをこの地より追い出し、あなたがたも、あなたがたの先祖も知らない地に行かせる。その所であなたがたは昼夜、ほかの神々に仕えるようになる。これはわたしがあなたがたにあわれみを示さないからである』と。"},{"ref":"Jer.16.14","start":24016014,"end":24016014,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"み"],[26,1,"たみ"],[33,1,"ち"],[36,1,"みちび"],[38,1,"だ"],[41,1,"しゅ"],[43,1,"い"],[53,1,"い"]],"text":"主は言われる、それゆえ、見よ、こののち『イスラエルの民をエジプトの地から導き出した主は生きておられる』とは言わないで、"},{"ref":"Jer.16.15","start":24016015,"end":24016015,"break":"none","ruby":[[7,1,"たみ"],[9,1,"きた"],[11,1,"くに"],[19,1,"お"],[25,2,"くにぐに"],[29,1,"みちび"],[31,1,"だ"],[34,1,"しゅ"],[36,1,"い"],[47,1,"ひ"],[56,1,"かれ"],[62,2,"せんぞ"],[65,1,"あた"],[68,1,"かれ"],[71,1,"ち"],[73,1,"みちび"]],"text":"『イスラエルの民を北の国と、そのすべて追いやられた国々から導き出した主は生きておられる』という日がくる。わたしが彼らを、その先祖に与えた彼らの地に導きかえすからである。"},{"ref":"Jer.16.16","start":24016016,"end":24016016,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"み"],[14,1,"おお"],[17,2,"ぎょふ"],[20,1,"よ"],[26,1,"かれ"],[42,1,"おお"],[45,2,"りょうし"],[48,1,"よ"],[59,1,"やま"],[66,1,"おか"],[71,1,"いわ"],[73,1,"さ"],[75,1,"め"],[78,1,"かれ"],[83,1,"だ"]],"text":"主は言われる、見よ、わたしは多くの漁夫を呼んできて、彼らをすなどらせ、また、そののち多くの猟師を呼んできて、もろもろの山、もろもろの丘、および岩の裂け目から彼らをかり出させる。"},{"ref":"Jer.16.17","start":24016017,"end":24016017,"break":"none","ruby":[[4,1,"め"],[6,1,"かれ"],[13,1,"みち"],[15,1,"み"],[31,1,"かく"],[43,1,"あく"],[49,1,"め"],[51,1,"かく"]],"text":"わたしの目は彼らのすべての道を見ているからである。みなわたしに隠れてはいない。またその悪はわたしの目に隠れることはない。"},{"ref":"Jer.16.18","start":24016018,"end":24016018,"break":"none","ruby":[[6,1,"あく"],[10,1,"つみ"],[12,1,"むく"],[16,1,"ばい"],[21,1,"かれ"],[26,1,"い"],[30,2,"ぐうぞう"],[33,2,"したい"],[44,1,"ち"],[46,1,"けが"],[51,1,"にく"],[66,1,"し"],[67,1,"ぎょう"],[69,1,"み"]],"text":"わたしはその悪とその罪の報いを二倍にする。彼らがその忌むべき偶像の死体をもって、わたしの地を汚し、その憎むべきものをもって、わたしの嗣業を満たしたからである」。"},{"ref":"Jer.16.19","start":24016019,"end":24016019,"break":"stanza","breaks":[[10,"line"],[22,"line"],[32,"line"],[46,"line"],[63,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"ちから"],[8,1,"しろ"],[10,1,"なや"],[13,1,"とき"],[19,1,"ば"],[22,2,"ばんこく"],[25,1,"たみ"],[27,1,"ち"],[29,1,"はて"],[41,1,"もう"],[52,2,"せんぞ"],[55,1,"う"],[57,1,"つ"],[65,1,"いつわ"],[69,1,"やく"],[71,1,"た"],[80,1,"こと"]],"text":"主、わが力、わが城、悩みの時の、のがれ場よ、万国の民は地の果からあなたのもとにきて申します、「われわれの先祖が受け嗣いだのは、ただ偽りと、役に立たないつまらない事ばかりです。"},{"ref":"Jer.16.20","start":24016020,"end":24016020,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ひと"],[2,2,"じぶん"],[5,2,"かみがみ"],[8,1,"つく"],[28,1,"かみ"]],"text":"人が自分で神々を造ることができましょうか。そういうものは神ではありません」。"},{"ref":"Jer.16.21","start":24016021,"end":24016021,"break":"paragraph","ruby":[[6,1,"み"],[13,1,"かれ"],[16,1,"し"],[29,1,"さい"],[34,1,"ちから"],[41,1,"いきお"],[45,1,"し"],[51,1,"かれ"],[58,1,"な"],[61,1,"しゅ"],[68,1,"し"]],"text":"「それゆえ、見よ、わたしは彼らに知らせよう。すなわち、この際わたしの力と、わたしの勢いとを知らせよう。彼らはわたしの名が、主であることを知るようになる」。"}]