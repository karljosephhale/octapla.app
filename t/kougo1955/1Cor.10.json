[{"ref":"1Cor.10.1","start":46010001,"end":46010001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[11,1,"し"],[31,2,"せんぞ"],[36,1,"くも"],[38,1,"した"],[45,1,"うみ"],[47,1,"とお"]],"text":"兄弟たちよ。このことを知らずにいてもらいたくない。わたしたちの先祖はみな雲の下におり、みな海を通り、"},{"ref":"1Cor.10.2","start":46010002,"end":46010002,"break":"none","ruby":[[2,1,"くも"],[4,1,"なか"],[6,1,"うみ"],[8,1,"なか"],[23,1,"う"]],"text":"みな雲の中、海の中で、モーセにつくバプテスマを受けた。"},{"ref":"1Cor.10.3","start":46010003,"end":46010003,"break":"none","ruby":[[5,1,"おな"],[7,1,"れい"],[9,2,"しょくもつ"],[12,1,"た"]],"text":"また、みな同じ霊の食物を食べ、"},{"ref":"1Cor.10.4","start":46010004,"end":46010004,"break":"none","ruby":[[2,1,"おな"],[4,1,"れい"],[6,1,"の"],[8,1,"もの"],[10,1,"の"],[19,1,"かれ"],[27,1,"れい"],[29,1,"いわ"],[32,1,"の"],[43,1,"いわ"]],"text":"みな同じ霊の飲み物を飲んだ。すなわち、彼らについてきた霊の岩から飲んだのであるが、この岩はキリストにほかならない。"},{"ref":"1Cor.10.5","start":46010005,"end":46010005,"break":"none","ruby":[[4,1,"かれ"],[7,1,"なか"],[9,3,"だいたすう"],[14,1,"かみ"],[31,2,"あらの"],[34,1,"ほろ"]],"text":"しかし、彼らの中の大多数は、神のみこころにかなわなかったので、荒野で滅ぼされてしまった。"},{"ref":"1Cor.10.6","start":46010006,"end":46010006,"break":"paragraph","ruby":[[4,3,"できごと"],[15,1,"たい"],[18,2,"けいこく"],[25,1,"かれ"],[28,1,"あく"],[45,1,"あく"]],"text":"これらの出来事は、わたしたちに対する警告であって、彼らが悪をむさぼったように、わたしたちも悪をむさぼることのないためなのである。"},{"ref":"1Cor.10.7","start":46010007,"end":46010007,"break":"none","ruby":[[4,1,"かれ"],[7,1,"なか"],[11,1,"もの"],[19,2,"ぐうぞう"],[21,3,"れいはいしゃ"],[40,1,"たみ"],[42,1,"ざ"],[45,1,"の"],[47,1,"く"],[54,1,"た"],[57,1,"おど"],[59,1,"たわむ"],[64,1,"か"]],"text":"だから、彼らの中のある者たちのように、偶像礼拝者になってはならない。すなわち、「民は座して飲み食いをし、また立って踊り戯れた」と書いてある。"},{"ref":"1Cor.10.8","start":46010008,"end":46010008,"break":"none","ruby":[[5,1,"もの"],[21,3,"ふひんこう"],[33,3,"ふひんこう"],[41,1,"たお"],[45,1,"もの"],[49,1,"にち"],[55,1,"にん"]],"text":"また、ある者たちがしたように、わたしたちは不品行をしてはならない。不品行をしたため倒された者が、一日に二万三千人もあった。"},{"ref":"1Cor.10.9","start":46010009,"end":46010009,"break":"none","ruby":[[5,1,"もの"],[21,1,"しゅ"],[23,1,"こころ"],[32,1,"しゅ"],[34,1,"こころ"],[37,1,"もの"],[43,1,"ころ"]],"text":"また、ある者たちがしたように、わたしたちは主を試みてはならない。主を試みた者は、へびに殺された。"},{"ref":"1Cor.10.10","start":46010010,"end":46010010,"break":"none","ruby":[[5,1,"もの"],[34,1,"もの"],[38,1,"し"],[40,1,"つかい"],[43,1,"ほろ"]],"text":"また、ある者たちがつぶやいたように、つぶやいてはならない。つぶやいた者は、「死の使」に滅ぼされた。"},{"ref":"1Cor.10.11","start":46010011,"end":46010011,"break":"none","ruby":[[4,1,"こと"],[6,1,"かれ"],[9,1,"おこ"],[15,1,"ほか"],[17,1,"たい"],[20,2,"けいこく"],[33,1,"か"],[40,1,"よ"],[42,1,"おわ"],[45,1,"のぞ"],[56,1,"たい"],[59,2,"くんかい"]],"text":"これらの事が彼らに起ったのは、他に対する警告としてであって、それが書かれたのは、世の終りに臨んでいるわたしたちに対する訓戒のためである。"},{"ref":"1Cor.10.12","start":46010012,"end":46010012,"break":"none","ruby":[[4,1,"た"],[10,1,"おも"],[12,1,"もの"],[15,1,"たお"],[22,1,"き"]],"text":"だから、立っていると思う者は、倒れないように気をつけるがよい。"},{"ref":"1Cor.10.13","start":46010013,"end":46010013,"break":"none","ruby":[[6,1,"あ"],[9,2,"しれん"],[13,1,"よ"],[15,1,"つね"],[25,1,"かみ"],[27,2,"しんじつ"],[39,1,"た"],[48,2,"しれん"],[51,1,"あ"],[65,2,"しれん"],[68,2,"どうじ"],[75,1,"た"],[88,1,"みち"],[90,1,"そな"],[93,1,"くだ"]],"text":"あなたがたの会った試錬で、世の常でないものはない。神は真実である。あなたがたを耐えられないような試錬に会わせることはないばかりか、試錬と同時に、それに耐えられるように、のがれる道も備えて下さるのである。"},{"ref":"1Cor.10.14","start":46010014,"end":46010014,"break":"paragraph","ruby":[[6,1,"あい"],[9,1,"もの"],[14,2,"ぐうぞう"],[16,2,"れいはい"],[19,1,"さ"]],"text":"それだから、愛する者たちよ。偶像礼拝を避けなさい。"},{"ref":"1Cor.10.15","start":46010015,"end":46010015,"break":"none","ruby":[[0,2,"けんめい"],[9,1,"うった"],[17,1,"い"],[23,1,"みずか"],[25,2,"はんだん"]],"text":"賢明なあなたがたに訴える。わたしの言うことを、自ら判断してみるがよい。"},{"ref":"1Cor.10.16","start":46010016,"end":46010016,"break":"none","ruby":[[6,2,"しゅくふく"],[10,2,"しゅくふく"],[13,1,"さかずき"],[23,1,"ち"]],"text":"わたしたちが祝福する祝福の杯、それはキリストの血にあずかることではないか。わたしたちがさくパン、それはキリストのからだにあずかることではないか。"},{"ref":"1Cor.10.17","start":46010017,"end":46010017,"break":"none","ruby":[[17,1,"おお"],[39,1,"もの"],[47,1,"とも"]],"text":"パンが一つであるから、わたしたちは多くいても、一つのからだなのである。みんなの者が一つのパンを共にいただくからである。"},{"ref":"1Cor.10.18","start":46010018,"end":46010018,"break":"none","ruby":[[0,1,"にく"],[10,1,"み"],[16,1,"そな"],[18,1,"もの"],[20,1,"た"],[23,1,"ひと"],[28,2,"さいだん"]],"text":"肉によるイスラエルを見るがよい。供え物を食べる人たちは、祭壇にあずかるのではないか。"},{"ref":"1Cor.10.19","start":46010019,"end":46010019,"break":"none","ruby":[[7,1,"い"],[15,2,"ぐうぞう"],[22,1,"そな"],[24,1,"もの"],[27,1,"なに"],[29,2,"いみ"],[40,2,"ぐうぞう"],[43,1,"なに"]],"text":"すると、なんと言ったらよいか。偶像にささげる供え物は、何か意味があるのか。また、偶像は何かほんとうにあるものか。"},{"ref":"1Cor.10.20","start":46010020,"end":46010020,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"そな"],[13,1,"もの"],[16,2,"あくれい"],[26,1,"かみ"],[30,1,"もの"],[32,1,"そな"],[51,2,"あくれい"],[54,2,"なかま"],[62,1,"のぞ"]],"text":"そうではない。人々が供える物は、悪霊ども、すなわち、神ならぬ者に供えるのである。わたしは、あなたがたが悪霊の仲間になることを望まない。"},{"ref":"1Cor.10.21","start":46010021,"end":46010021,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"さかずき"],[4,2,"あくれい"],[9,1,"さかずき"],[13,2,"どうじ"],[16,1,"の"],[26,1,"しゅ"],[28,2,"しょくたく"],[31,2,"あくれい"],[36,2,"しょくたく"],[41,2,"どうじ"]],"text":"主の杯と悪霊どもの杯とを、同時に飲むことはできない。主の食卓と悪霊どもの食卓とに、同時にあずかることはできない。"},{"ref":"1Cor.10.22","start":46010022,"end":46010022,"break":"none","ruby":[[11,1,"しゅ"],[17,1,"おこし"],[33,1,"しゅ"],[37,1,"つよ"]],"text":"それとも、わたしたちは主のねたみを起そうとするのか。わたしたちは、主よりも強いのだろうか。"},{"ref":"1Cor.10.23","start":46010023,"end":46010023,"break":"paragraph","ruby":[[7,1,"ゆる"],[25,1,"えき"],[43,1,"ゆる"],[61,1,"ひと"],[63,1,"とく"],[65,1,"たか"]],"text":"すべてのことは許されている。しかし、すべてのことが益になるわけではない。すべてのことは許されている。しかし、すべてのことが人の徳を高めるのではない。"},{"ref":"1Cor.10.24","start":46010024,"end":46010024,"break":"none","ruby":[[5,2,"じぶん"],[8,1,"えき"],[10,1,"もと"],[19,1,"ひと"],[21,1,"えき"],[23,1,"もと"]],"text":"だれでも、自分の益を求めないで、ほかの人の益を求めるべきである。"},{"ref":"1Cor.10.25","start":46010025,"end":46010025,"break":"none","ruby":[[3,2,"いちば"],[6,1,"う"],[12,1,"もの"],[19,2,"りょうしん"],[22,1,"と"],[32,1,"た"]],"text":"すべて市場で売られている物は、いちいち良心に問うことをしないで、食べるがよい。"},{"ref":"1Cor.10.26","start":46010026,"end":46010026,"break":"none","ruby":[[0,1,"ち"],[5,1,"み"],[10,1,"もの"],[14,1,"しゅ"]],"text":"地とそれに満ちている物とは、主のものだからである。"},{"ref":"1Cor.10.27","start":46010027,"end":46010027,"break":"none","ruby":[[9,3,"ふしんじゃ"],[17,1,"まね"],[25,1,"い"],[29,1,"おも"],[31,2,"ばあい"],[34,2,"じぶん"],[37,1,"まえ"],[39,1,"だ"],[43,1,"もの"],[54,2,"りょうしん"],[57,1,"と"],[67,1,"た"]],"text":"もしあなたがたが、不信者のだれかに招かれて、そこに行こうと思う場合、自分の前に出される物はなんでも、いちいち良心に問うことをしないで、食べるがよい。"},{"ref":"1Cor.10.28","start":46010028,"end":46010028,"break":"none","ruby":[[21,1,"もの"],[23,1,"にく"],[26,1,"い"],[35,1,"し"],[42,1,"ひと"],[50,2,"りょうしん"],[57,1,"た"]],"text":"しかし、だれかがあなたがたに、これはささげ物の肉だと言ったなら、それを知らせてくれた人のために、また良心のために、食べないがよい。"},{"ref":"1Cor.10.29","start":46010029,"end":46010029,"break":"none","ruby":[[0,2,"りょうしん"],[3,1,"い"],[9,2,"じぶん"],[12,2,"りょうしん"],[19,2,"たにん"],[22,2,"りょうしん"],[40,2,"じゆう"],[48,2,"たにん"],[51,2,"りょうしん"],[57,2,"さゆう"]],"text":"良心と言ったのは、自分の良心ではなく、他人の良心のことである。なぜなら、わたしの自由が、どうして他人の良心によって左右されることがあろうか。"},{"ref":"1Cor.10.30","start":46010030,"end":46010030,"break":"none","ruby":[[6,2,"かんしゃ"],[10,1,"た"],[13,2,"ばあい"],[18,2,"かんしゃ"],[22,1,"もの"],[32,1,"ひと"],[38,1,"う"]],"text":"もしわたしが感謝して食べる場合、その感謝する物について、どうして人のそしりを受けるわけがあろうか。"},{"ref":"1Cor.10.31","start":46010031,"end":46010031,"break":"none","ruby":[[4,1,"の"],[8,1,"た"],[16,2,"なにごと"],[27,1,"かみ"],[29,2,"えいこう"]],"text":"だから、飲むにも食べるにも、また何事をするにも、すべて神の栄光のためにすべきである。"},{"ref":"1Cor.10.32","start":46010032,"end":46010032,"break":"none","ruby":[[3,1,"じん"],[10,1,"じん"],[13,1,"かみ"],[15,2,"きょうかい"]],"text":"ユダヤ人にもギリシヤ人にも神の教会にも、つまずきになってはいけない。"},{"ref":"1Cor.10.33","start":46010033,"end":46010033,"break":"none","ruby":[[7,2,"なにごと"],[15,1,"ひと"],[17,1,"よろこ"],[24,1,"つと"],[27,1,"おお"],[30,1,"ひと"],[32,1,"すく"],[40,2,"じぶん"],[43,1,"えき"],[48,1,"かれ"],[51,1,"えき"],[53,1,"もと"]],"text":"わたしもまた、何事にもすべての人に喜ばれるように努め、多くの人が救われるために、自分の益ではなく彼らの益を求めている。"}]