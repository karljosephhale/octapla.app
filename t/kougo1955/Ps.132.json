[{"ref":"Ps.132.1","start":19132001,"end":19132001,"break":"paragraph","title":"都もうでの歌","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[18,2,"しんく"]],"titleRuby":[[0,1,"みやこ"],[5,1,"うた"]],"text":"主よ、ダビデのために、そのもろもろの辛苦をみこころにとめてください。"},{"ref":"Ps.132.2","start":19132002,"end":19132002,"break":"line","breaks":[[9,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"ちか"],[13,3,"ぜんのうしゃ"],[17,1,"ちか"],[20,1,"た"],[23,1,"い"]],"text":"ダビデは主に誓い、ヤコブの全能者に誓いを立てて言いました、"},{"ref":"Ps.132.3","start":19132003,"end":19132005,"break":"line","breaks":[[17,"line"],[40,"line"],[57,"line"],[68,"line"]],"ruby":[[5,1,"しゅ"],[10,1,"ところ"],[12,1,"さが"],[14,1,"だ"],[21,3,"ぜんのうしゃ"],[32,1,"もと"],[34,1,"え"],[42,1,"いえ"],[44,1,"い"],[50,2,"しんだい"],[53,1,"のぼ"],[59,1,"め"],[61,1,"ねむ"],[64,1,"あた"],[79,1,"あた"]],"text":"「わたしは主のために所を捜し出し、ヤコブの全能者のためにすまいを求め得るまでは、わが家に入らず、わが寝台に上らず、わが目に眠りを与えず、わがまぶたにまどろみを与えません」。"},{"ref":"Ps.132.6","start":19132006,"end":19132006,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"み"],[15,1,"き"],[22,1,"の"],[27,1,"み"]],"text":"見よ、われらはエフラタでそれを聞き、ヤアルの野でそれを見とめた。"},{"ref":"Ps.132.7","start":19132007,"end":19132007,"break":"line","breaks":[[15,"line"]],"ruby":[[11,1,"い"],[17,1,"あし"],[18,1,"だい"],[25,1,"ふ"]],"text":"「われらはそのすまいへ行って、その足台のもとにひれ伏そう」。"},{"ref":"Ps.132.8","start":19132008,"end":19132008,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"お"],[11,1,"ちから"],[16,1,"とも"],[23,3,"あんそくじょ"]],"text":"主よ、起きて、あなたの力のはこと共に、あなたの安息所におはいりください。"},{"ref":"Ps.132.9","start":19132009,"end":19132009,"break":"line","breaks":[[16,"line"]],"ruby":[[4,2,"さいし"],[9,1,"ぎ"],[20,2,"せいと"],[25,1,"よろこ"],[27,1,"よ"]],"text":"あなたの祭司たちに義をまとわせ、あなたの聖徒たちに喜び呼ばわらせてください。"},{"ref":"Ps.132.10","start":19132010,"end":19132010,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[19,1,"あぶら"],[25,1,"もの"],[27,1,"かお"]],"text":"あなたのしもべダビデのために、あなたの油そそがれた者の顔を、しりぞけないでください。"},{"ref":"Ps.132.11","start":19132011,"end":19132011,"break":"line","breaks":[[20,"line"],[41,"line"],[62,"line"]],"ruby":[[0,1,"しゅ"],[13,1,"ちか"],[36,1,"い"],[50,1,"み"],[53,1,"で"],[55,1,"こ"],[66,1,"くらい"]],"text":"主はまことをもってダビデに誓われたので、それにそむくことはない。すなわち言われた、「わたしはあなたの身から出た子のひとりを、あなたの位につかせる。"},{"ref":"Ps.132.12","start":19132012,"end":19132012,"break":"line","breaks":[[16,"line"],[31,"line"],[44,"line"]],"ruby":[[6,1,"こ"],[13,1,"おし"],[16,2,"けいやく"],[25,1,"まも"],[33,1,"こ"],[48,1,"くらい"],[50,1,"ざ"]],"text":"もしあなたの子らがわたしの教える契約と、あかしとを守るならば、その子らもまた、とこしえにあなたの位に座するであろう」。"},{"ref":"Ps.132.13","start":19132013,"end":19132013,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"えら"],[13,2,"じぶん"],[24,1,"のぞ"],[27,1,"い"]],"text":"主はシオンを選び、それをご自分のすみかにしようと望んで言われた、"},{"ref":"Ps.132.14","start":19132014,"end":19132014,"break":"line","breaks":[[18,"line"]],"ruby":[[11,3,"あんそくじょ"],[25,1,"のぞ"],[34,1,"す"]],"text":"「これはとこしえにわが安息所である。わたしはこれを望んだゆえ、ここに住む。"},{"ref":"Ps.132.15","start":19132015,"end":19132015,"break":"line","breaks":[[18,"line"]],"ruby":[[8,2,"りょうしょく"],[11,1,"ゆた"],[14,2,"しゅくふく"],[18,2,"しょくもつ"],[26,1,"まず"],[29,1,"もの"],[31,1,"あ"]],"text":"わたしはシオンの糧食を豊かに祝福し、食物をもってその貧しい者を飽かせる。"},{"ref":"Ps.132.16","start":19132016,"end":19132016,"break":"line","breaks":[[19,"line"]],"ruby":[[8,2,"さいし"],[13,1,"すくい"],[15,1,"き"],[21,2,"せいと"],[26,1,"こえ"],[27,1,"たか"],[31,1,"よろこ"],[33,1,"よ"]],"text":"またわたしはその祭司たちに救を着せる。その聖徒たちは声高らかに喜び呼ばわるであろう。"},{"ref":"Ps.132.17","start":19132017,"end":19132017,"break":"line","breaks":[[11,"line"],[25,"line"],[42,"line"]],"ruby":[[17,1,"つの"],[31,1,"あぶら"],[37,1,"もの"],[50,1,"そな"]],"text":"わたしはダビデのためにそこに一つの角をはえさせる。わたしはわが油そそがれた者のために一つのともしびを備えた。"},{"ref":"Ps.132.18","start":19132018,"end":19132018,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"かれ"],[6,1,"てき"],[8,1,"はじ"],[10,1,"き"],[17,1,"かれ"],[19,1,"うえ"],[24,1,"かんむり"],[26,1,"かがや"]],"text":"わたしは彼の敵に恥を着せる。しかし彼の上にはその冠が輝くであろう」。"}]