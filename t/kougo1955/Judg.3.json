[{"ref":"Judg.3.1","start":7003001,"end":7003001,"break":"paragraph","ruby":[[12,2,"せんそう"],[15,1,"し"],[25,2,"ひとびと"],[28,1,"こころ"],[35,1,"しゅ"],[37,1,"のこ"],[44,2,"こくみん"],[47,1,"つぎ"]],"text":"すべてカナンのもろもろの戦争を知らないイスラエルの人々を試みるために、主が残しておかれた国民は次のとおりである。"},{"ref":"Judg.3.2","start":7003002,"end":7003002,"break":"none","ruby":[[11,2,"よよ"],[14,2,"しそん"],[17,1,"とく"],[21,2,"せんそう"],[24,1,"し"],[35,1,"おし"],[37,1,"し"]],"text":"これはただイスラエルの代々の子孫、特にまだ戦争を知らないものに、それを教え知らせるためである。"},{"ref":"Judg.3.3","start":7003003,"end":7003003,"break":"none","ruby":[[12,1,"にん"],[14,1,"きみ"],[42,1,"やま"],[44,1,"す"],[56,1,"やま"],[63,2,"いりぐち"],[68,1,"し"]],"text":"すなわちペリシテびとの五人の君たちと、すべてのカナンびとと、シドンびとおよびレバノン山に住んで、バアル・ヘルモン山からハマテの入口までを占めていたヒビびとなどであって、"},{"ref":"Judg.3.4","start":7003004,"end":7003004,"break":"none","ruby":[[13,1,"こころ"],[16,1,"しゅ"],[25,2,"せんぞ"],[30,1,"めい"],[35,2,"めいれい"],[39,1,"かれ"],[42,1,"したが"],[49,1,"し"]],"text":"これらをもってイスラエルを試み、主がモーセによって先祖たちに命じられた命令に、彼らが従うかどうかを知ろうとされたのである。"},{"ref":"Judg.3.5","start":7003005,"end":7003005,"break":"none","ruby":[[10,2,"ひとびと"],[50,1,"す"]],"text":"しかるにイスラエルの人々はカナンびと、ヘテびと、アモリびと、ペリジびと、ヒビびと、エブスびとのうちに住んで、"},{"ref":"Judg.3.6","start":7003006,"end":7003006,"break":"none","ruby":[[0,1,"かれ"],[3,1,"むすめ"],[5,1,"つま"],[13,2,"じぶん"],[18,1,"むすめ"],[20,1,"かれ"],[27,1,"あた"],[31,1,"かれ"],[34,2,"かみがみ"],[37,1,"つか"]],"text":"彼らの娘を妻にめとり、また自分たちの娘を彼らのむすこに与えて、彼らの神々に仕えた。"},{"ref":"Judg.3.7","start":7003007,"end":7003007,"break":"paragraph","ruby":[[10,2,"ひとびと"],[13,1,"しゅ"],[15,1,"まえ"],[17,1,"あく"],[19,1,"おこな"],[22,2,"じぶん"],[27,1,"かみ"],[29,1,"しゅ"],[31,1,"わす"],[45,1,"つか"]],"text":"こうしてイスラエルの人々は主の前に悪を行い、自分たちの神、主を忘れて、バアルおよびアシラに仕えた。"},{"ref":"Judg.3.8","start":7003008,"end":7003008,"break":"none","ruby":[[3,1,"しゅ"],[11,1,"たい"],[14,1,"はげ"],[17,1,"いか"],[20,1,"かれ"],[30,1,"おう"],[43,1,"て"],[45,1,"う"],[61,2,"ひとびと"],[65,1,"ねん"],[67,1,"あいだ"],[81,1,"つか"]],"text":"そこで主はイスラエルに対して激しく怒り、彼らをメソポタミヤの王クシャン・リシャタイムの手に売りわたされたので、イスラエルの人々は八年の間、クシャン・リシャタイムに仕えた。"},{"ref":"Judg.3.9","start":7003009,"end":7003009,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"しゅ"],[15,1,"よ"],[23,1,"しゅ"],[31,2,"ひとびと"],[42,3,"きゅうじょしゃ"],[46,1,"おこ"],[49,1,"かれ"],[52,1,"すく"],[65,1,"おとうと"],[71,1,"こ"]],"text":"しかし、イスラエルの人々が主に呼ばわったとき、主はイスラエルの人々のために、ひとりの救助者を起して彼らを救われた。すなわちカレブの弟、ケナズの子オテニエルである。"},{"ref":"Judg.3.10","start":7003010,"end":7003010,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"れい"],[10,1,"のぞ"],[16,1,"かれ"],[29,1,"かれ"],[31,1,"たたか"],[34,1,"で"],[38,1,"しゅ"],[47,1,"おう"],[62,1,"て"],[78,1,"て"],[92,1,"か"]],"text":"主の霊がオテニエルに臨んだので、彼はイスラエルをさばいた。彼が戦いに出ると、主はメソポタミヤの王クシャン・リシャタイムをその手にわたされたので、オテニエルの手はクシャン・リシャタイムに勝ち、"},{"ref":"Judg.3.11","start":7003011,"end":7003011,"break":"none","ruby":[[0,1,"くに"],[4,1,"ねん"],[9,2,"たいへい"],[20,1,"こ"],[30,1,"し"]],"text":"国は四十年のあいだ太平であった。ケナズの子オテニエルはついに死んだ。"},{"ref":"Judg.3.12","start":7003012,"end":7003012,"break":"paragraph","ruby":[[6,2,"ひとびと"],[11,1,"しゅ"],[13,1,"まえ"],[15,1,"あく"],[27,1,"かれ"],[30,1,"しゅ"],[32,1,"まえ"],[34,1,"あく"],[44,1,"しゅ"],[50,1,"おう"],[56,1,"つよ"],[66,2,"てきたい"]],"text":"イスラエルの人々はまた主の前に悪をおこなった。すなわち彼らが主の前に悪をおこなったので、主はモアブの王エグロンを強めて、イスラエルに敵対させられた。"},{"ref":"Judg.3.13","start":7003013,"end":7003013,"break":"none","ruby":[[17,2,"ひとびと"],[20,1,"あつ"],[31,1,"う"],[38,1,"まち"],[40,2,"せんりょう"]],"text":"エグロンはアンモンおよびアマレクの人々を集め、きてイスラエルを撃ち、しゅろの町を占領した。"},{"ref":"Judg.3.14","start":7003014,"end":7003014,"break":"none","ruby":[[10,2,"ひとびと"],[15,1,"ねん"],[17,1,"あいだ"],[22,1,"おう"],[28,1,"つか"]],"text":"こうしてイスラエルの人々は十八年の間モアブの王エグロンに仕えた。"},{"ref":"Judg.3.15","start":7003015,"end":7003015,"break":"paragraph","ruby":[[9,2,"ひとびと"],[12,1,"しゅ"],[14,1,"よ"],[22,1,"しゅ"],[24,1,"かれ"],[35,3,"きゅうじょしゃ"],[39,1,"おこ"],[59,1,"こ"],[61,1,"ひだり"],[78,2,"ひとびと"],[81,1,"かれ"],[90,1,"おう"],[100,1,"もの"],[102,1,"おく"]],"text":"しかしイスラエルの人々が主に呼ばわったとき、主は彼らのために、ひとりの救助者を起された。すなわちベニヤミンびと、ゲラの子、左ききのエホデである。イスラエルの人々は彼によってモアブの王エグロンに、みつぎ物を送った。"},{"ref":"Judg.3.16","start":7003016,"end":7003016,"break":"none","ruby":[[4,1,"なが"],[14,1,"は"],[20,1,"つく"],[27,1,"ころも"],[29,1,"した"],[31,1,"みぎ"],[36,1,"うえ"],[38,1,"お"]],"text":"エホデは長さ一キュビトのもろ刃のつるぎを作らせ、それを衣の下、右のももの上に帯びて、"},{"ref":"Judg.3.17","start":7003017,"end":7003017,"break":"none","ruby":[[4,1,"おう"],[13,1,"もの"],[26,2,"ひじょう"],[29,1,"こ"],[32,1,"ひと"]],"text":"モアブの王エグロンにみつぎ物をもってきた。エグロンは非常に肥えた人であった。"},{"ref":"Judg.3.18","start":7003018,"end":7003018,"break":"none","ruby":[[7,1,"もの"],[12,1,"おわ"],[18,1,"かれ"],[23,1,"もの"],[31,1,"たみ"],[33,1,"かえ"]],"text":"エホデがみつぎ物をささげ終ったとき、彼はみつぎ物をになってきた民を帰らせ、"},{"ref":"Judg.3.19","start":7003019,"end":7003019,"break":"none","ruby":[[2,2,"じしん"],[10,1,"ちか"],[12,2,"せきぞう"],[17,1,"ところ"],[20,1,"ひ"],[26,1,"い"],[31,1,"おう"],[42,1,"もう"],[47,2,"きみつ"],[61,1,"おう"],[72,1,"い"],[83,1,"た"],[88,1,"もの"],[90,1,"みな"],[91,1,"で"],[93,1,"い"]],"text":"かれ自身はギルガルに近い石像のある所から引きかえして言った、「王よ、わたしはあなたに申しあげる機密をもっています」。そこで王は「さがっておれ」と言ったので、かたわらに立っている者は皆出て行った。"},{"ref":"Judg.3.20","start":7003020,"end":7003020,"break":"none","ruby":[[4,1,"おう"],[14,1,"く"],[18,1,"おう"],[24,1,"すず"],[27,2,"たかどの"],[30,1,"ざ"],[47,1,"かみ"],[49,1,"いのち"],[58,1,"もう"],[72,1,"い"],[76,1,"おう"],[78,1,"ざ"],[81,1,"た"]],"text":"エホデが王のところにはいって来ると、王はひとりで涼みの高殿に座していたので、エホデが「わたしは神の命によってあなたに申しあげることがあります」と言うと、王は座から立ちあがった。"},{"ref":"Judg.3.21","start":7003021,"end":7003021,"break":"none","ruby":[[8,1,"ひだり"],[10,1,"て"],[12,1,"の"],[16,1,"みぎ"],[29,1,"おう"],[31,1,"はら"],[33,1,"さ"]],"text":"そのときエホデは左の手を伸ばし、右のももからつるぎをとって王の腹を刺した。"},{"ref":"Judg.3.22","start":7003022,"end":7003022,"break":"none","ruby":[[7,1,"は"],[9,1,"とも"],[21,1,"はら"],[24,1,"ぬ"],[26,1,"だ"],[35,2,"しぼう"],[38,1,"は"],[48,2,"おぶつ"],[51,1,"で"]],"text":"つるぎのつかも刃と共にはいったが、つるぎを腹から抜き出さなかったので、脂肪が刃をふさいだ。そして汚物が出た。"},{"ref":"Judg.3.23","start":7003023,"end":7003023,"break":"none","ruby":[[4,2,"ろうか"],[7,1,"で"],[10,1,"おう"],[14,2,"たかどの"],[17,1,"と"],[19,1,"と"],[22,1,"じょう"]],"text":"エホデは廊下に出て、王のおる高殿の戸を閉じ、錠をおろした。"},{"ref":"Judg.3.24","start":7003024,"end":7003024,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"で"],[4,1,"のち"],[6,1,"おう"],[17,2,"たかどの"],[20,1,"と"],[22,1,"じょう"],[33,1,"み"],[37,1,"おう"],[42,1,"すず"],[44,1,"どの"],[49,1,"あし"],[63,1,"おも"]],"text":"彼が出た後、王のしもべどもがきて、高殿の戸に錠のおろされてあるのを見て、「王はきっと涼み殿のへやで足をおおっておられるのだ」と思った。"},{"ref":"Judg.3.25","start":7003025,"end":7003025,"break":"none","ruby":[[6,1,"なが"],[11,1,"ま"],[18,1,"おう"],[22,2,"たかどの"],[25,1,"と"],[27,1,"ひら"],[34,2,"しんぱい"],[44,1,"ひら"],[47,1,"み"],[51,1,"おう"],[53,1,"ゆか"],[59,1,"し"]],"text":"しもべどもは長いあいだ待っていたが、王がなお高殿の戸を開かないので、心配してかぎをとって開いて見ると、王は床にたおれて死んでいた。"},{"ref":"Judg.3.26","start":7003026,"end":7003026,"break":"paragraph","ruby":[[4,1,"かれ"],[18,2,"せきぞう"],[23,1,"ところ"],[25,1,"す"],[32,1,"に"]],"text":"エホデは彼らのためらうまに、のがれて石像のある所を過ぎ、セイラに逃げていった。"},{"ref":"Judg.3.27","start":7003027,"end":7003027,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[11,2,"さんち"],[18,1,"ふ"],[20,1,"な"],[33,2,"ひとびと"],[36,1,"かれ"],[38,1,"とも"],[40,2,"さんち"],[44,1,"くだ"],[51,1,"したが"]],"text":"彼が行ってエフライムの山地にラッパを吹き鳴らしたので、イスラエルの人々は彼と共に山地から下ってエホデに従った。"},{"ref":"Judg.3.28","start":7003028,"end":7003028,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[24,1,"しゅ"],[32,1,"てき"],[45,1,"て"],[58,1,"かれ"],[65,1,"したが"],[68,1,"くだ"],[76,1,"わた"],[78,1,"ば"],[94,1,"わた"]],"text":"エホデは彼らに言った、「わたしについてきなさい。主はあなたがたの敵モアブびとをあなたがたの手にわたされます」。そこで彼らはエホデに従って下り、ヨルダンの渡し場をおさえ、モアブびとをひとりも渡らせなかった。"},{"ref":"Judg.3.29","start":7003029,"end":7003029,"break":"none","ruby":[[4,1,"かれ"],[18,1,"にん"],[20,1,"ころ"],[31,1,"こ"],[33,1,"ふと"],[36,2,"ゆうし"],[52,1,"もの"]],"text":"そのとき彼らはモアブびとおおよそ一万人を殺した。これはいずれも肥え太った勇士であって、ひとりも、のがれた者がなかった。"},{"ref":"Judg.3.30","start":7003030,"end":7003030,"break":"none","ruby":[[10,1,"ひ"],[17,1,"て"],[19,1,"ふく"],[22,1,"くに"],[26,1,"ねん"],[31,2,"たいへい"]],"text":"こうしてモアブはその日イスラエルの手に服し、国は八十年のあいだ太平であった。"},{"ref":"Judg.3.31","start":7003031,"end":7003031,"break":"paragraph","ruby":[[4,1,"のち"],[10,1,"こ"],[17,1,"おこ"],[20,1,"うし"],[36,1,"にん"],[38,1,"ころ"],[44,1,"ひと"],[54,1,"すく"]],"text":"エホデの後、アナテの子シャムガルが起り、牛のむちをもってペリシテびと六百人を殺した。この人もまたイスラエルを救った。"}]