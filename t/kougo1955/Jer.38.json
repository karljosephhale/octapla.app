[{"ref":"Jer.38.1","start":24038001,"end":24038001,"break":"paragraph","ruby":[[5,1,"こ"],[16,1,"こ"],[27,1,"こ"],[37,1,"こ"],[52,1,"たみ"],[54,1,"つ"],[61,2,"ことば"],[64,1,"き"]],"text":"マッタンの子シパテヤ、パシュルの子ゲダリヤ、セレミヤの子ユカル、マルキヤの子パシュルはエレミヤがすべての民に告げていたその言葉を聞いた。"},{"ref":"Jer.38.2","start":24038002,"end":24038002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,1,"しゅ"],[11,1,"い"],[18,1,"まち"],[24,1,"もの"],[37,2,"えきびょう"],[40,1,"し"],[46,1,"で"],[58,1,"もの"],[60,1,"し"],[62,1,"まぬか"],[72,1,"いのち"],[74,2,"じぶん"],[81,1,"もの"],[85,1,"い"]],"text":"彼は言った、「主はこう言われる、この町にとどまる者は、つるぎや、ききんや、疫病で死ぬ。しかし出てカルデヤびとにくだる者は死を免れる。すなわちその命を自分のぶんどり物として生きることができる。"},{"ref":"Jer.38.3","start":24038003,"end":24038003,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"い"],[11,1,"まち"],[13,1,"かなら"],[20,1,"おう"],[22,2,"ぐんぜい"],[25,1,"て"],[27,1,"わた"],[32,1,"かれ"],[37,1,"と"]],"text":"主はこう言われる、この町は必ずバビロンの王の軍勢の手に渡される。彼はこれを取る」。"},{"ref":"Jer.38.4","start":24038004,"end":24038004,"break":"none","ruby":[[10,1,"おう"],[12,1,"い"],[19,1,"ひと"],[21,1,"ころ"],[34,2,"ことば"],[43,1,"まち"],[45,1,"のこ"],[50,2,"へいし"],[53,1,"て"],[60,1,"たみ"],[62,1,"て"],[64,1,"よわ"],[77,1,"ひと"],[79,1,"たみ"],[81,2,"あんたい"],[84,1,"もと"],[92,1,"わざわい"],[94,1,"もと"]],"text":"すると、つかさたちは王に言った、「この人を殺してください。このような言葉をのべて、この町に残っている兵士の手と、すべての民の手を弱くしているからです。この人は民の安泰を求めないで、その災を求めているのです」。"},{"ref":"Jer.38.5","start":24038005,"end":24038005,"break":"none","ruby":[[4,1,"おう"],[6,1,"い"],[11,1,"み"],[14,1,"かれ"],[22,1,"て"],[27,1,"おう"],[35,1,"さか"],[39,2,"なにごと"],[45,1,"え"]],"text":"ゼデキヤ王は言った、「見よ、彼はあなたがたの手にある。王はあなたがたに逆らって何事をもなし得ない」。"},{"ref":"Jer.38.6","start":24038006,"end":24038006,"break":"none","ruby":[[3,1,"かれ"],[11,1,"とら"],[14,2,"かんし"],[17,1,"にわ"],[21,2,"おうじ"],[28,1,"あな"],[30,1,"な"],[32,1,"い"],[41,1,"つな"],[53,1,"お"],[61,1,"あな"],[64,1,"みず"],[69,1,"どろ"],[84,1,"どろ"],[86,1,"なか"],[88,1,"しず"]],"text":"そこで彼らはエレミヤを捕え、監視の庭にある王子マルキヤの穴に投げ入れた。すなわち、綱をもってエレミヤをつり降ろしたが、その穴には水がなく、泥だけであったので、エレミヤは泥の中に沈んだ。"},{"ref":"Jer.38.7","start":24038007,"end":24038007,"break":"paragraph","ruby":[[0,1,"おう"],[2,1,"いえ"],[4,2,"かんがん"],[21,1,"かれ"],[29,1,"あな"],[31,1,"な"],[33,1,"い"],[39,1,"き"],[45,1,"とき"],[47,1,"おう"],[55,1,"もん"],[57,1,"ざ"]],"text":"王の家の宦官エチオピヤびとエベデメレクは、彼らがエレミヤを穴に投げ入れたことを聞いた。その時、王はベニヤミンの門に座していたので、"},{"ref":"Jer.38.8","start":24038008,"end":24038008,"break":"none","ruby":[[7,1,"おう"],[9,1,"いえ"],[12,1,"で"],[14,1,"い"],[17,1,"おう"],[19,1,"い"]],"text":"エベデメレクは王の家から出て行って王に言った、"},{"ref":"Jer.38.9","start":24038009,"end":24038009,"break":"none","ruby":[[1,1,"おう"],[6,1,"きみ"],[11,2,"ひとびと"],[14,3,"よげんしゃ"],[29,1,"よ"],[41,1,"かれ"],[43,1,"あな"],[45,1,"な"],[47,1,"い"],[53,1,"まち"],[55,2,"しょくもつ"],[68,1,"かれ"],[73,2,"がし"]],"text":"「王なるわが君よ、この人々が預言者エレミヤにしたことはみな良いことではありません。彼を穴に投げ入れました。町に食物がなくなりましたから、彼はそこで餓死するでしょう」。"},{"ref":"Jer.38.10","start":24038010,"end":24038010,"break":"none","ruby":[[0,1,"おう"],[16,1,"めい"],[19,1,"い"],[29,1,"にん"],[34,1,"つ"],[37,1,"い"],[41,3,"よげんしゃ"],[50,1,"し"],[57,1,"あな"],[60,1,"ひ"],[62,1,"あ"]],"text":"王はエチオピヤびとエベデメレクに命じて言った、「ここから三人のひとを連れて行って、預言者エレミヤを、死なないうちに穴から引き上げなさい」。"},{"ref":"Jer.38.11","start":24038011,"end":24038011,"break":"none","ruby":[[12,2,"ひとびと"],[15,1,"つ"],[18,1,"おう"],[20,1,"いえ"],[22,1,"くら"],[24,2,"いふく"],[26,1,"しつ"],[28,1,"い"],[35,1,"ふる"],[37,1,"ぬの"],[38,1,"き"],[42,1,"き"],[47,2,"きもの"],[50,1,"と"],[56,1,"あな"],[58,1,"なか"],[72,1,"つな"],[79,1,"お"]],"text":"そこでエベデメレクはその人々を連れて王の家の倉の衣服室に行き、そこから古い布切れや、着ふるした着物を取り、これを穴の中にいるエレミヤのところへ、綱をもってつり降ろした。"},{"ref":"Jer.38.12","start":24038012,"end":24038012,"break":"none","ruby":[[21,1,"ぬの"],[22,1,"き"],[25,2,"きもの"],[36,1,"した"],[43,1,"つな"],[45,1,"あ"],[57,1,"い"]],"text":"そしてエチオピヤびとエベデメレクは、「この布切れや着物を、あなたのわきの下にはさんで、綱に当てなさい」とエレミヤに言った。エレミヤはそのようにした。"},{"ref":"Jer.38.13","start":24038013,"end":24038013,"break":"none","ruby":[[3,1,"かれ"],[6,1,"つな"],[16,1,"あな"],[19,1,"ひ"],[21,1,"あ"],[33,2,"かんし"],[36,1,"にわ"]],"text":"すると彼らは綱をもってエレミヤを穴から引き上げた。そしてエレミヤは監視の庭にとどまった。"},{"ref":"Jer.38.14","start":24038014,"end":24038014,"break":"paragraph","ruby":[[4,1,"おう"],[6,1,"ひと"],[13,3,"よげんしゃ"],[21,1,"しゅ"],[23,1,"みや"],[25,1,"だい"],[28,1,"もん"],[30,1,"つ"],[37,1,"おう"],[44,1,"い"],[53,1,"たず"],[63,2,"なにごと"],[70,1,"かく"]],"text":"ゼデキヤ王は人をつかわして預言者エレミヤを主の宮の第三の門に連れてこさせ、王はエレミヤに言った、「あなたに尋ねたいことがある。何事もわたしに隠してはならない」。"},{"ref":"Jer.38.15","start":24038015,"end":24038015,"break":"none","ruby":[[10,1,"い"],[22,1,"はな"],[32,1,"かなら"],[38,1,"ころ"],[58,2,"ちゅうこく"],[70,1,"き"]],"text":"エレミヤはゼデキヤに言った、「もしわたしがお話するなら、あなたは必ずわたしを殺されるではありませんか。たといわたしが忠告をしても、あなたはお聞きにならないでしょう」。"},{"ref":"Jer.38.16","start":24038016,"end":24038016,"break":"none","ruby":[[2,1,"とき"],[7,1,"おう"],[19,1,"ちか"],[22,1,"い"],[32,1,"たましい"],[34,1,"つく"],[38,1,"しゅ"],[40,1,"い"],[56,1,"ころ"],[67,1,"いのち"],[69,1,"もと"],[72,1,"もの"],[74,1,"て"],[81,1,"わた"]],"text":"その時ゼデキヤ王は、ひそかにエレミヤに誓って言った、「われわれの魂を造られた主は生きておられる。わたしはあなたを殺さない、またあなたの命を求める者の手に、あなたを渡すこともしない」。"},{"ref":"Jer.38.17","start":24038017,"end":24038017,"break":"paragraph","ruby":[[13,1,"い"],[18,2,"ばんぐん"],[21,1,"かみ"],[29,1,"かみ"],[31,1,"しゅ"],[35,1,"おお"],[52,1,"おう"],[60,2,"こうふく"],[72,1,"いのち"],[74,1,"たす"],[82,1,"まち"],[84,1,"ひ"],[86,1,"や"],[104,1,"いえ"],[106,1,"もの"],[108,1,"い"]],"text":"そこでエレミヤはゼデキヤに言った、「万軍の神、イスラエルの神、主はこう仰せられる、もしあなたがバビロンの王のつかさたちに降伏するならば、あなたの命は助かり、またこの町は火で焼かれることなく、あなたも、あなたの家の者も生きながらえることができる。"},{"ref":"Jer.38.18","start":24038018,"end":24038018,"break":"none","ruby":[[10,1,"で"],[17,1,"おう"],[25,2,"こうふく"],[36,1,"まち"],[45,1,"て"],[47,1,"わた"],[52,1,"かれ"],[55,1,"ひ"],[60,1,"や"],[69,1,"て"]],"text":"しかし、もしあなたが出てバビロンの王のつかさたちに降伏しないならば、この町はカルデヤびとの手に渡される。彼らは火でこれを焼く。あなたはその手をのがれることができない」。"},{"ref":"Jer.38.19","start":24038019,"end":24038019,"break":"none","ruby":[[4,1,"おう"],[11,1,"い"],[27,2,"だっそう"],[34,1,"ひと"],[36,1,"おそ"],[53,1,"かれ"],[56,1,"て"],[58,1,"わた"],[61,1,"かれ"]],"text":"ゼデキヤ王はエレミヤに言った、「わたしはカルデヤびとに脱走したユダヤ人を恐れている。カルデヤびとはわたしを彼らの手に渡し、彼らはわたしをはずかしめる」。"},{"ref":"Jer.38.20","start":24038020,"end":24038020,"break":"none","ruby":[[5,1,"い"],[10,1,"かれ"],[17,1,"わた"],[38,1,"つ"],[41,1,"しゅ"],[43,1,"こえ"],[45,1,"き"],[47,1,"したが"],[60,1,"さいわい"],[62,1,"え"],[66,1,"いのち"],[68,1,"たす"]],"text":"エレミヤは言った、「彼らはあなたを渡さないでしょう。どうか、わたしがあなたに告げた主の声に聞き従ってください。そうすれば幸を得、また命が助かります。"},{"ref":"Jer.38.21","start":24038021,"end":24038021,"break":"none","ruby":[[3,2,"こうふく"],[10,1,"こば"],[16,1,"しゅ"],[22,1,"しめ"],[26,1,"まぼろし"],[28,1,"もう"]],"text":"しかし降伏することを拒むならば、主がわたしに示された幻を申しましょう。"},{"ref":"Jer.38.22","start":24038022,"end":24038022,"break":"none","breaks":[[60,"stanza"],[80,"line"],[91,"line"],[108,"line"]],"ruby":[[8,1,"おう"],[10,1,"いえ"],[12,1,"のこ"],[17,1,"おんな"],[29,1,"おう"],[37,1,"ところ"],[39,1,"ひ"],[42,1,"い"],[50,1,"おんな"],[54,1,"い"],[65,1,"した"],[68,1,"とも"],[76,1,"あざむ"],[87,1,"か"],[91,1,"いま"],[96,1,"あし"],[98,1,"どろ"],[100,1,"しず"],[108,1,"かれ"],[115,1,"す"],[118,1,"さ"]],"text":"すなわち、ユダの王の家に残っている女たちは、みなバビロンの王のつかさたちの所へ引いて行かれます。その女たちは言うのです、『あなたの親しい友だちがあなたを欺いた、そしてあなたに勝った。今あなたの足は泥に沈んでいるので、彼らはあなたを捨てて去る』。"},{"ref":"Jer.38.23","start":24038023,"end":24038023,"break":"none","ruby":[[4,1,"つま"],[8,2,"こども"],[13,1,"みな"],[21,1,"ところ"],[25,1,"だ"],[33,2,"じしん"],[38,1,"て"],[56,1,"おう"],[58,1,"とら"],[69,1,"まち"],[71,1,"ひ"],[73,1,"や"]],"text":"あなたの妻たちと子供たちは皆カルデヤびとの所へひき出される。あなた自身もその手をのがれることができず、バビロンの王に捕えられる。そしてこの町は火で焼かれるでしょう」。"},{"ref":"Jer.38.24","start":24038024,"end":24038024,"break":"paragraph","ruby":[[10,1,"い"],[19,2,"ことば"],[22,1,"ひと"],[24,1,"し"],[43,1,"ころ"]],"text":"ゼデキヤはエレミヤに言った、「これらの言葉を人に知らせてはならない。そうすればあなたは殺されることはない。"},{"ref":"Jer.38.25","start":24038025,"end":24038025,"break":"none","ruby":[[8,1,"はなし"],[22,1,"き"],[26,1,"かれ"],[33,1,"ところ"],[35,1,"き"],[43,1,"おう"],[45,1,"はな"],[51,1,"おう"],[57,1,"はな"],[68,1,"つ"],[74,2,"なにごと"],[77,1,"かく"],[95,1,"ころ"],[103,1,"い"]],"text":"わたしがあなたと話をしたことを、つかさたちが聞いて、彼らがあなたの所に来て、『あなたが王に話したこと、王があなたに話したことをわれわれに告げなさい。何事も隠してはならない。われわれはあなたを殺しはしない』と言うならば、"},{"ref":"Jer.38.26","start":24038026,"end":24038026,"break":"none","ruby":[[4,1,"かれ"],[13,1,"おう"],[15,1,"ねが"],[28,1,"いえ"],[30,1,"おく"],[32,1,"かえ"],[39,1,"し"],[56,1,"い"],[61,1,"こた"]],"text":"あなたは彼らに、『わたしは王に願って、わたしをヨナタンの家に送り返さず、そこで死ぬことのないようにしてくださいと言った』と答えなさい」。"},{"ref":"Jer.38.27","start":24038027,"end":24038027,"break":"none","ruby":[[9,1,"みな"],[19,1,"き"],[21,1,"たず"],[26,1,"おう"],[28,1,"かれ"],[30,1,"おし"],[36,1,"かれ"],[39,1,"こた"],[45,1,"かれ"],[48,1,"かれ"],[50,1,"はな"],[61,2,"かいわ"],[64,1,"き"],[67,1,"もの"]],"text":"さて、つかさたちは皆エレミヤのところへ来て尋ねたが、王が彼に教えたように彼らに答えたので、彼らは彼と話すことをやめた。その会話を聞いた者がなかったからである。"},{"ref":"Jer.38.28","start":24038028,"end":24038028,"break":"none","ruby":[[11,1,"と"],[15,1,"ひ"],[18,2,"かんし"],[21,1,"にわ"]],"text":"エレミヤはエルサレムの取られる日まで監視の庭にとどまっていた。"}]