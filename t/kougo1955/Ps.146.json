[{"ref":"Ps.146.1","start":19146001,"end":19146001,"break":"paragraph","breaks":[[9,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"たましい"],[14,1,"しゅ"]],"text":"主をほめたたえよ。わが魂よ、主をほめたたえよ。"},{"ref":"Ps.146.2","start":19146002,"end":19146002,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"い"],[11,1,"しゅ"],[24,1,"あいだ"],[29,1,"かみ"]],"text":"わたしは生けるかぎりは主をほめたたえ、ながらえる間は、わが神をほめうたおう。"},{"ref":"Ps.146.3","start":19146003,"end":19146003,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[5,1,"きみ"],[7,2,"しんらい"],[17,1,"ひと"],[19,1,"こ"],[21,2,"しんらい"],[31,1,"かれ"],[35,1,"たす"]],"text":"もろもろの君に信頼してはならない。人の子に信頼してはならない。彼らには助けがない。"},{"ref":"Ps.146.4","start":19146004,"end":19146004,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"いき"],[4,1,"で"],[9,1,"かれ"],[11,1,"つち"],[13,1,"かえ"],[18,1,"ひ"],[21,1,"かれ"],[28,2,"けいかく"],[31,1,"ほろ"]],"text":"その息が出ていけば彼は土に帰る。その日には彼のもろもろの計画は滅びる。"},{"ref":"Ps.146.5","start":19146005,"end":19146005,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"かみ"],[9,1,"たす"],[16,1,"のぞ"],[22,1,"かみ"],[24,1,"しゅ"],[28,1,"ひと"]],"text":"ヤコブの神をおのが助けとし、その望みをおのが神、主におく人はさいわいである。"},{"ref":"Ps.146.6","start":19146006,"end":19146006,"break":"line","breaks":[[10,"line"],[26,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"てん"],[4,1,"ち"],[7,1,"うみ"],[12,1,"なか"],[23,1,"つく"],[31,2,"しんじつ"],[34,1,"まも"]],"text":"主は天と地と、海と、その中にあるあらゆるものを造り、とこしえに真実を守り、"},{"ref":"Ps.146.7","start":19146007,"end":19146007,"break":"line","breaks":[[21,"line"],[35,"line"]],"ruby":[[7,1,"もの"],[21,1,"う"],[24,1,"もの"],[26,2,"しょくもつ"],[29,1,"あた"],[35,1,"しゅ"],[37,1,"とら"],[40,1,"びと"],[42,1,"と"],[44,1,"はな"]],"text":"しえたげられる者のためにさばきをおこない、飢えた者に食物を与えられる。主は捕われ人を解き放たれる。"},{"ref":"Ps.146.8","start":19146008,"end":19146008,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"もうじん"],[5,1,"め"],[7,1,"ひら"],[12,1,"しゅ"],[17,1,"もの"],[19,1,"た"],[26,1,"しゅ"],[28,1,"ただ"],[31,1,"もの"],[33,1,"あい"]],"text":"主は盲人の目を開かれる。主はかがむ者を立たせられる。主は正しい者を愛される。"},{"ref":"Ps.146.9","start":19146009,"end":19146009,"break":"line","breaks":[[12,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"きりゅう"],[5,2,"たこく"],[7,1,"じん"],[9,1,"まも"],[34,1,"あ"],[37,1,"もの"],[39,1,"みち"],[41,1,"ほろ"],[44,1,"いた"]],"text":"主は寄留の他国人を守り、みなしごと、やもめとをささえられる。しかし、悪しき者の道を滅びに至らせられる。"},{"ref":"Ps.146.10","start":19146010,"end":19146010,"break":"line","breaks":[[15,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"す"],[9,1,"おさ"],[24,1,"かみ"],[29,1,"よ"],[32,1,"す"],[34,1,"おさ"],[40,1,"しゅ"]],"text":"主はとこしえに統べ治められる。シオンよ、あなたの神はよろず代まで統べ治められる。主をほめたたえよ。"}]