[{"ref":"Gen.20.1","start":1020001,"end":1020001,"break":"paragraph","ruby":[[14,1,"ち"],[16,1,"うつ"],[28,1,"あいだ"],[30,1,"す"],[34,1,"かれ"],[47,1,"とき"]],"text":"アブラハムはそこからネゲブの地に移って、カデシとシュルの間に住んだ。彼がゲラルにとどまっていた時、"},{"ref":"Gen.20.2","start":1020002,"end":1020002,"break":"none","ruby":[[6,1,"つま"],[22,1,"いもうと"],[27,1,"い"],[37,1,"おう"],[45,1,"ひと"],[55,1,"め"],[57,1,"い"]],"text":"アブラハムは妻サラのことを、「これはわたしの妹です」と言ったので、ゲラルの王アビメレクは、人をつかわしてサラを召し入れた。"},{"ref":"Gen.20.3","start":1020003,"end":1020003,"break":"none","ruby":[[4,1,"かみ"],[6,1,"よ"],[8,1,"ゆめ"],[16,1,"のぞ"],[19,1,"い"],[29,1,"め"],[31,1,"い"],[36,1,"おんな"],[41,1,"し"],[50,2,"かのじょ"],[53,1,"おっと"],[57,1,"み"]],"text":"ところが神は夜の夢にアビメレクに臨んで言われた、「あなたは召し入れたあの女のゆえに死なねばならない。彼女は夫のある身である」。"},{"ref":"Gen.20.4","start":1020004,"end":1020004,"break":"none","ruby":[[8,2,"かのじょ"],[11,1,"ちか"],[22,1,"い"],[27,1,"しゅ"],[34,1,"ただ"],[37,1,"たみ"],[40,1,"ころ"]],"text":"アビメレクはまだ彼女に近づいていなかったので言った、「主よ、あなたは正しい民でも殺されるのですか。"},{"ref":"Gen.20.5","start":1020005,"end":1020005,"break":"none","ruby":[[0,1,"かれ"],[14,1,"いもうと"],[18,1,"い"],[32,2,"かのじょ"],[35,2,"じぶん"],[39,1,"かれ"],[45,1,"あに"],[49,1,"い"],[59,1,"こころ"],[61,1,"きよ"],[64,1,"て"]],"text":"彼はわたしに、これはわたしの妹ですと言ったではありませんか。また彼女も自分で、彼はわたしの兄ですと言いました。わたしは心も清く、手もいさぎよく、このことをしました」。"},{"ref":"Gen.20.6","start":1020006,"end":1020006,"break":"none","ruby":[[0,1,"かみ"],[4,1,"ゆめ"],[6,1,"かれ"],[8,1,"い"],[23,1,"きよ"],[25,1,"こころ"],[39,1,"し"],[55,1,"まも"],[63,1,"たい"],[66,1,"つみ"],[68,1,"おか"],[73,2,"かのじょ"],[82,1,"ゆる"]],"text":"神はまた夢で彼に言われた、「そうです、あなたが清い心をもってこのことをしたのを知っていたから、わたしもあなたを守って、わたしに対して罪を犯させず、彼女にふれることを許さなかったのです。"},{"ref":"Gen.20.7","start":1020007,"end":1020007,"break":"none","ruby":[[2,1,"かれ"],[4,1,"つま"],[6,1,"かえ"],[12,1,"かれ"],[14,3,"よげんしゃ"],[29,1,"いの"],[33,1,"いのち"],[35,1,"たも"],[46,1,"かえ"],[57,2,"みうち"],[60,1,"もの"],[64,1,"かなら"],[66,1,"し"],[69,1,"し"]],"text":"いま彼の妻を返しなさい。彼は預言者ですから、あなたのために祈って、命を保たせるでしょう。もし返さないなら、あなたも身内の者もみな必ず死ぬと知らなければなりません」。"},{"ref":"Gen.20.8","start":1020008,"end":1020008,"break":"paragraph","ruby":[[9,1,"あさ"],[10,1,"はや"],[12,1,"お"],[26,1,"め"],[28,1,"あつ"],[36,1,"こと"],[40,1,"かた"],[42,1,"き"],[49,2,"ひとびと"],[52,2,"ひじょう"],[55,1,"おそ"]],"text":"そこでアビメレクは朝早く起き、しもべたちをことごとく召し集めて、これらの事をみな語り聞かせたので、人々は非常に恐れた。"},{"ref":"Gen.20.9","start":1020009,"end":1020009,"break":"none","ruby":[[15,1,"め"],[18,1,"い"],[32,1,"なに"],[45,1,"たい"],[55,1,"つみ"],[57,1,"おか"],[76,1,"くに"],[80,1,"おお"],[83,1,"つみ"],[85,1,"お"]],"text":"そしてアビメレクはアブラハムを召して言った、「あなたはわれわれに何をするのですか。あなたに対してわたしがどんな罪を犯したために、あなたはわたしとわたしの国とに、大きな罪を負わせるのですか。あなたはしてはならぬことをわたしにしたのです」。"},{"ref":"Gen.20.10","start":1020010,"end":1020010,"break":"none","ruby":[[14,1,"い"],[26,1,"おも"],[32,1,"こと"]],"text":"アビメレクはまたアブラハムに言った、「あなたはなんと思って、この事をしたのですか」。"},{"ref":"Gen.20.11","start":1020011,"end":1020011,"break":"none","ruby":[[6,1,"い"],[13,1,"ところ"],[16,1,"かみ"],[18,1,"おそ"],[41,1,"つま"],[46,2,"ひとびと"],[53,1,"ころ"],[56,1,"おも"]],"text":"アブラハムは言った、「この所には神を恐れるということが、まったくないので、わたしの妻のゆえに人々がわたしを殺すと思ったからです。"},{"ref":"Gen.20.12","start":1020012,"end":1020012,"break":"none","ruby":[[2,2,"かのじょ"],[14,1,"いもうと"],[24,1,"ちち"],[26,1,"むすめ"],[31,1,"はは"],[33,1,"むすめ"],[50,1,"つま"]],"text":"また彼女はほんとうにわたしの妹なのです。わたしの父の娘ですが、母の娘ではありません。そして、わたしの妻になったのです。"},{"ref":"Gen.20.13","start":1020013,"end":1020013,"break":"none","ruby":[[0,1,"かみ"],[6,1,"ちち"],[8,1,"いえ"],[10,1,"はな"],[14,1,"い"],[16,1,"めぐ"],[20,1,"とき"],[26,2,"かのじょ"],[40,1,"い"],[51,1,"あに"],[56,1,"い"],[75,1,"ほどこ"],[77,1,"めぐ"],[83,1,"い"]],"text":"神がわたしに父の家を離れて、行き巡らせた時、わたしは彼女に、あなたはわたしたちの行くさきざきでわたしを兄であると言ってください。これはあなたがわたしに施す恵みであると言いました」。"},{"ref":"Gen.20.14","start":1020014,"end":1020014,"break":"none","ruby":[[9,1,"ひつじ"],[11,1,"うし"],[15,2,"だんじょ"],[18,2,"どれい"],[21,1,"と"],[30,1,"あた"],[35,1,"つま"],[39,1,"かれ"],[41,1,"かえ"]],"text":"そこでアビメレクは羊、牛および男女の奴隷を取ってアブラハムに与え、その妻サラを彼に返した。"},{"ref":"Gen.20.15","start":1020015,"end":1020015,"break":"none","ruby":[[9,1,"い"],[18,1,"ち"],[24,1,"まえ"],[35,1,"す"],[38,1,"ところ"],[40,1,"す"]],"text":"そしてアビメレクは言った、「わたしの地はあなたの前にあります。あなたの好きな所に住みなさい」。"},{"ref":"Gen.20.16","start":1020016,"end":1020016,"break":"none","ruby":[[5,1,"い"],[18,1,"あに"],[20,1,"ぎん"],[21,1,"せん"],[26,1,"あた"],[39,1,"み"],[41,1,"た"],[48,1,"こと"],[58,1,"つぐな"],[76,1,"ひと"],[82,1,"ただ"],[86,1,"みと"]],"text":"またサラに言った、「わたしはあなたの兄に銀千シケルを与えました。これはあなたの身に起ったすべての事について、あなたに償いをするものです。こうしてすべての人にあなたは正しいと認められます」。"},{"ref":"Gen.20.17","start":1020017,"end":1020017,"break":"none","ruby":[[9,1,"かみ"],[11,1,"いの"],[15,1,"かみ"],[25,1,"つま"],[45,1,"かれ"],[48,1,"こ"],[50,1,"う"]],"text":"そこでアブラハムは神に祈った。神はアビメレクとその妻および、はしためたちをいやされたので、彼らは子を産むようになった。"},{"ref":"Gen.20.18","start":1020018,"end":1020018,"break":"none","ruby":[[3,1,"しゅ"],[14,1,"つま"],[28,1,"いえ"],[34,1,"もの"],[36,1,"たい"],[42,1,"と"]],"text":"これは主がさきにアブラハムの妻サラのゆえに、アビメレクの家のすべての者の胎を、かたく閉ざされたからである。"}]