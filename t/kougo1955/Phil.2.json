[{"ref":"Phil.2.1","start":50002001,"end":50002001,"break":"paragraph","ruby":[[18,1,"すす"],[21,1,"あい"],[23,1,"はげ"],[27,2,"みたま"],[30,1,"まじ"],[34,2,"ねつあい"]],"text":"そこで、あなたがたに、キリストによる勧め、愛の励まし、御霊の交わり、熱愛とあわれみとが、いくらかでもあるなら、"},{"ref":"Phil.2.2","start":50002002,"end":50002002,"break":"none","ruby":[[3,1,"おな"],[5,1,"おも"],[11,1,"おな"],[13,1,"あい"],[15,1,"こころ"],[17,1,"も"],[20,1,"こころ"],[22,1,"あ"],[28,1,"おも"],[39,1,"よろこ"],[42,1,"み"]],"text":"どうか同じ思いとなり、同じ愛の心を持ち、心を合わせ、一つ思いになって、わたしの喜びを満たしてほしい。"},{"ref":"Phil.2.3","start":50002003,"end":50002003,"break":"none","ruby":[[0,2,"なにごと"],[3,3,"とうはしん"],[7,2,"きょえい"],[24,1,"こころ"],[29,1,"たがい"],[31,1,"ひと"],[33,2,"じぶん"],[41,1,"もの"]],"text":"何事も党派心や虚栄からするのでなく、へりくだった心をもって互に人を自分よりすぐれた者としなさい。"},{"ref":"Phil.2.4","start":50002004,"end":50002004,"break":"none","ruby":[[5,2,"じぶん"],[17,2,"たにん"],[23,1,"かんが"]],"text":"おのおの、自分のことばかりでなく、他人のことも考えなさい。"},{"ref":"Phil.2.5","start":50002005,"end":50002005,"break":"none","ruby":[[20,1,"おな"],[22,1,"おも"],[32,1,"あいだ"],[35,1,"たがい"],[37,1,"い"]],"text":"キリスト・イエスにあっていだいているのと同じ思いを、あなたがたの間でも互に生かしなさい。"},{"ref":"Phil.2.6","start":50002006,"end":50002006,"break":"none","ruby":[[6,1,"かみ"],[18,1,"かみ"],[20,1,"ひと"],[28,2,"こしゅ"],[33,1,"こと"],[36,1,"おも"]],"text":"キリストは、神のかたちであられたが、神と等しくあることを固守すべき事とは思わず、"},{"ref":"Phil.2.7","start":50002007,"end":50002007,"break":"none","ruby":[[15,1,"しもべ"],[24,2,"にんげん"],[27,1,"すがた"],[36,2,"ありさま"],[39,1,"ひと"],[41,1,"こと"]],"text":"かえって、おのれをむなしうして僕のかたちをとり、人間の姿になられた。その有様は人と異ならず、"},{"ref":"Phil.2.8","start":50002008,"end":50002008,"break":"none","ruby":[[4,1,"ひく"],[9,1,"し"],[11,1,"いた"],[19,3,"じゅうじか"],[23,1,"し"],[25,1,"いた"],[29,2,"じゅうじゅん"]],"text":"おのれを低くして、死に至るまで、しかも十字架の死に至るまで従順であられた。"},{"ref":"Phil.2.9","start":50002009,"end":50002009,"break":"none","ruby":[[6,1,"かみ"],[8,1,"かれ"],[10,1,"たか"],[12,1,"ひ"],[14,1,"あ"],[21,1,"な"],[26,1,"な"],[28,1,"かれ"],[30,1,"たま"]],"text":"それゆえに、神は彼を高く引き上げ、すべての名にまさる名を彼に賜わった。"},{"ref":"Phil.2.10","start":50002010,"end":50002010,"break":"none","ruby":[[8,2,"みな"],[15,2,"てんじょう"],[21,2,"ちじょう"],[27,2,"ちか"]],"text":"それは、イエスの御名によって、天上のもの、地上のもの、地下のものなど、あらゆるものがひざをかがめ、"},{"ref":"Phil.2.11","start":50002011,"end":50002011,"break":"none","ruby":[[7,1,"した"],[20,1,"しゅ"],[26,2,"こくはく"],[31,2,"えいこう"],[34,1,"ちち"],[37,1,"かみ"],[39,1,"き"]],"text":"また、あらゆる舌が、「イエス・キリストは主である」と告白して、栄光を父なる神に帰するためである。"},{"ref":"Phil.2.12","start":50002012,"end":50002012,"break":"paragraph","ruby":[[4,1,"あい"],[7,1,"もの"],[31,2,"じゅうじゅん"],[45,2,"いっしょ"],[50,1,"とき"],[60,1,"いま"],[67,2,"じゅうじゅん"],[73,1,"おそ"],[80,2,"じぶん"],[83,1,"すくい"],[85,2,"たっせい"],[88,1,"つと"]],"text":"わたしの愛する者たちよ。そういうわけだから、あなたがたがいつも従順であったように、わたしが一緒にいる時だけでなく、いない今は、いっそう従順でいて、恐れおののいて自分の救の達成に努めなさい。"},{"ref":"Phil.2.13","start":50002013,"end":50002013,"break":"none","ruby":[[9,1,"はたら"],[17,1,"ねが"],[20,1,"おこ"],[26,2,"じつげん"],[29,1,"いた"],[35,1,"かみ"],[44,1,"かみ"]],"text":"あなたがたのうちに働きかけて、その願いを起させ、かつ実現に至らせるのは神であって、それは神のよしとされるところだからである。"},{"ref":"Phil.2.14","start":50002014,"end":50002014,"break":"none","ruby":[[13,1,"うたが"]],"text":"すべてのことを、つぶやかず疑わないでしなさい。"},{"ref":"Phil.2.15","start":50002015,"end":50002015,"break":"none","ruby":[[10,1,"せ"],[21,2,"じゅんしん"],[24,1,"もの"],[29,1,"まが"],[32,2,"じゃあく"],[35,2,"じだい"],[40,1,"なか"],[46,1,"きず"],[50,1,"かみ"],[52,1,"こ"],[73,2,"ことば"],[76,1,"かた"],[78,1,"も"],[82,1,"かれ"],[85,1,"あいだ"],[87,1,"ほし"],[94,1,"よ"],[96,1,"かがや"]],"text":"それは、あなたがたが責められるところのない純真な者となり、曲った邪悪な時代のただ中にあって、傷のない神の子となるためである。あなたがたは、いのちの言葉を堅く持って、彼らの間で星のようにこの世に輝いている。"},{"ref":"Phil.2.16","start":50002016,"end":50002016,"break":"none","ruby":[[13,1,"ひ"],[20,2,"じぶん"],[23,1,"はし"],[35,1,"ろう"],[50,1,"ほこ"]],"text":"このようにして、キリストの日に、わたしは自分の走ったことがむだでなく、労したこともむだではなかったと誇ることができる。"},{"ref":"Phil.2.17","start":50002017,"end":50002017,"break":"none","ruby":[[14,2,"しんこう"],[17,1,"そな"],[19,1,"もの"],[25,2,"さいだん"],[33,1,"ち"],[50,1,"よろこ"],[59,2,"いちどう"],[62,1,"とも"],[64,1,"よろこ"]],"text":"そして、たとい、あなたがたの信仰の供え物をささげる祭壇に、わたしの血をそそぐことがあっても、わたしは喜ぼう。あなたがた一同と共に喜ぼう。"},{"ref":"Phil.2.18","start":50002018,"end":50002018,"break":"none","ruby":[[0,1,"おな"],[12,1,"よろこ"],[22,1,"とも"],[24,1,"よろこ"]],"text":"同じように、あなたがたも喜びなさい。わたしと共に喜びなさい。"},{"ref":"Phil.2.19","start":50002019,"end":50002019,"break":"paragraph","ruby":[[26,1,"おく"],[32,1,"しゅ"],[40,1,"ねが"],[56,2,"ようす"],[59,1,"し"],[67,1,"ちから"]],"text":"さて、わたしは、まもなくテモテをあなたがたのところに送りたいと、主イエスにあって願っている。それは、あなたがたの様子を知って、わたしも力づけられたいからである。"},{"ref":"Phil.2.20","start":50002020,"end":50002020,"break":"none","ruby":[[7,1,"こころ"],[10,2,"しんみ"],[25,2,"しんぱい"],[31,1,"もの"]],"text":"テモテのような心で、親身になってあなたがたのことを心配している者は、ほかにひとりもない。"},{"ref":"Phil.2.21","start":50002021,"end":50002021,"break":"none","ruby":[[0,1,"ひと"],[5,2,"じぶん"],[11,1,"もと"],[30,1,"もと"]],"text":"人はみな、自分のことを求めるだけで、キリスト・イエスのことは求めていない。"},{"ref":"Phil.2.22","start":50002022,"end":50002022,"break":"none","ruby":[[8,2,"れんたつ"],[20,1,"し"],[37,1,"こ"],[39,1,"ちち"],[41,1,"たい"],[54,2,"いっしょ"],[57,2,"ふくいん"],[60,1,"つか"]],"text":"しかし、テモテの錬達ぶりは、あなたがたの知っているとおりである。すなわち、子が父に対するようにして、わたしと一緒に福音に仕えてきたのである。"},{"ref":"Phil.2.23","start":50002023,"end":50002023,"break":"none","ruby":[[6,1,"ひと"],[13,2,"なりゆ"],[34,1,"おく"],[39,1,"ねが"]],"text":"そこで、この人を、わたしの成行きがわかりしだい、すぐにでも、そちらへ送りたいと願っている。"},{"ref":"Phil.2.24","start":50002024,"end":50002024,"break":"none","ruby":[[3,2,"じしん"],[10,1,"い"],[17,1,"しゅ"],[22,2,"かくしん"]],"text":"わたし自身もまもなく行けるものと、主にあって確信している。"},{"ref":"Phil.2.25","start":50002025,"end":50002025,"break":"none","ruby":[[14,3,"どうろうしゃ"],[18,2,"せんゆう"],[23,2,"きょうだい"],[35,2,"ししゃ"],[44,2,"きゅうぼう"],[47,1,"おぎな"],[70,1,"おく"],[72,1,"かえ"],[77,2,"ひつよう"],[81,1,"おも"]],"text":"しかし、さしあたり、わたしの同労者で戦友である兄弟、また、あなたがたの使者としてわたしの窮乏を補ってくれたエパフロデトを、あなたがたのもとに送り返すことが必要だと思っている。"},{"ref":"Phil.2.26","start":50002026,"end":50002026,"break":"none","ruby":[[0,1,"かれ"],[8,2,"いちどう"],[15,1,"あ"],[31,1,"うえ"],[33,2,"じぶん"],[36,2,"びょうき"],[48,1,"きこ"],[54,1,"かれ"],[56,2,"こころぐる"],[60,1,"おも"]],"text":"彼は、あなたがた一同にしきりに会いたがっているからである。その上、自分の病気のことがあなたがたに聞えたので、彼は心苦しく思っている。"},{"ref":"Phil.2.27","start":50002027,"end":50002027,"break":"none","ruby":[[0,1,"かれ"],[2,1,"じつ"],[7,1,"し"],[9,2,"びょうき"],[18,1,"かみ"],[20,1,"かれ"],[27,1,"くだ"],[32,1,"かれ"],[51,1,"くだ"],[62,1,"かな"],[66,1,"かな"],[70,1,"かさ"]],"text":"彼は実に、ひん死の病気にかかったが、神は彼をあわれんで下さった。彼ばかりではなく、わたしをもあわれんで下さったので、わたしは悲しみに悲しみを重ねないですんだのである。"},{"ref":"Phil.2.28","start":50002028,"end":50002028,"break":"none","ruby":[[4,2,"おおいそ"],[8,1,"かれ"],[10,1,"おく"],[12,1,"かえ"],[25,1,"かれ"],[27,1,"ふたた"],[29,1,"あ"],[32,1,"よろこ"],[42,2,"しんぱい"],[45,1,"やわ"]],"text":"そこで、大急ぎで彼を送り返す。これで、あなたがたは彼と再び会って喜び、わたしもまた、心配を和らげることができよう。"},{"ref":"Phil.2.29","start":50002029,"end":50002029,"break":"none","ruby":[[10,1,"おお"],[13,1,"よろこ"],[17,1,"しゅ"],[22,1,"かれ"],[24,1,"むか"],[38,2,"ひとびと"],[41,2,"そんちょう"]],"text":"こういうわけだから、大いに喜んで、主にあって彼を迎えてほしい。また、こうした人々は尊重せねばならない。"},{"ref":"Phil.2.30","start":50002030,"end":50002030,"break":"none","ruby":[[0,1,"かれ"],[7,1,"たい"],[16,2,"ほうし"],[25,1,"ぶん"],[27,1,"おぎな"],[45,1,"いのち"],[50,1,"し"]],"text":"彼は、わたしに対してあなたがたが奉仕のできなかった分を補おうとして、キリストのわざのために命をかけ、死ぬばかりになったのである。"}]