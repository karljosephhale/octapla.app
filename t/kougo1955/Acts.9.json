[{"ref":"Acts.9.1","start":44009001,"end":44009001,"break":"paragraph","ruby":[[10,1,"しゅ"],[12,2,"でし"],[17,1,"たい"],[20,2,"きょうはく"],[23,2,"さつがい"],[26,1,"いき"],[36,3,"だいさいし"],[44,1,"い"]],"text":"さてサウロは、なおも主の弟子たちに対する脅迫、殺害の息をはずませながら、大祭司のところに行って、"},{"ref":"Acts.9.2","start":44009002,"end":44009002,"break":"none","ruby":[[5,1,"しょ"],[6,2,"かいどう"],[11,2,"てんしょ"],[14,1,"もと"],[24,1,"みち"],[26,1,"もの"],[28,1,"み"],[31,2,"しだい"],[34,2,"だんじょ"],[37,1,"べつ"],[40,1,"しば"],[57,1,"く"]],"text":"ダマスコの諸会堂あての添書を求めた。それは、この道の者を見つけ次第、男女の別なく縛りあげて、エルサレムにひっぱって来るためであった。"},{"ref":"Acts.9.3","start":44009003,"end":44009003,"break":"none","ruby":[[5,1,"みち"],[7,1,"いそ"],[15,1,"ちか"],[23,2,"とつぜん"],[26,1,"てん"],[29,1,"ひかり"],[35,1,"かれ"],[40,1,"てら"]],"text":"ところが、道を急いでダマスコの近くにきたとき、突然、天から光がさして、彼をめぐり照した。"},{"ref":"Acts.9.4","start":44009004,"end":44009004,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ち"],[4,1,"たお"],[11,1,"とき"],[27,2,"はくがい"],[35,1,"よ"],[40,1,"こえ"],[42,1,"き"]],"text":"彼は地に倒れたが、その時「サウロ、サウロ、なぜわたしを迫害するのか」と呼びかける声を聞いた。"},{"ref":"Acts.9.5","start":44009005,"end":44009005,"break":"none","ruby":[[3,1,"かれ"],[6,1,"しゅ"],[22,1,"たず"],[29,1,"こたえ"],[45,2,"はくがい"]],"text":"そこで彼は「主よ、あなたは、どなたですか」と尋ねた。すると答があった、「わたしは、あなたが迫害しているイエスである。"},{"ref":"Acts.9.6","start":44009006,"end":44009006,"break":"none","ruby":[[2,1,"た"],[6,1,"まち"],[12,1,"い"],[35,1,"こと"],[37,1,"つ"]],"text":"さあ立って、町にはいって行きなさい。そうすれば、そこであなたのなすべき事が告げられるであろう」。"},{"ref":"Acts.9.7","start":44009007,"end":44009007,"break":"none","ruby":[[4,3,"どうこうしゃ"],[10,1,"もの"],[12,1,"い"],[16,1,"た"],[22,1,"こえ"],[26,1,"きこ"],[34,1,"み"]],"text":"サウロの同行者たちは物も言えずに立っていて、声だけは聞えたが、だれも見えなかった。"},{"ref":"Acts.9.8","start":44009008,"end":44009008,"break":"none","ruby":[[4,1,"ち"],[7,1,"お"],[9,1,"あ"],[13,1,"め"],[15,1,"ひら"],[22,1,"なに"],[24,1,"み"],[34,2,"ひとびと"],[38,1,"かれ"],[40,1,"て"],[42,1,"ひ"],[50,1,"つ"],[53,1,"い"]],"text":"サウロは地から起き上がって目を開いてみたが、何も見えなかった。そこで人々は、彼の手を引いてダマスコへ連れて行った。"},{"ref":"Acts.9.9","start":44009009,"end":44009009,"break":"none","ruby":[[0,1,"かれ"],[3,2,"かかん"],[6,1,"め"],[8,1,"み"],[14,1,"た"],[20,1,"の"]],"text":"彼は三日間、目が見えず、また食べることも飲むこともしなかった。"},{"ref":"Acts.9.10","start":44009010,"end":44009010,"break":"paragraph","ruby":[[19,2,"でし"],[27,1,"ひと"],[29,1,"しゅ"],[31,1,"まぼろし"],[33,1,"なか"],[35,1,"あらわ"],[48,1,"よ"],[55,1,"かれ"],[58,1,"しゅ"],[72,1,"こた"]],"text":"さて、ダマスコにアナニヤというひとりの弟子がいた。この人に主が幻の中に現れて、「アナニヤよ」とお呼びになった。彼は「主よ、わたしでございます」と答えた。"},{"ref":"Acts.9.11","start":44009011,"end":44009011,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"かれ"],[7,1,"い"],[13,1,"た"],[18,1,"ま"],[25,1,"な"],[27,2,"ろじ"],[30,1,"い"],[36,1,"いえ"],[47,1,"びと"],[49,1,"たず"],[55,1,"かれ"],[59,1,"いの"]],"text":"そこで主が彼に言われた、「立って、『真すぐ』という名の路地に行き、ユダの家でサウロというタルソ人を尋ねなさい。彼はいま祈っている。"},{"ref":"Acts.9.12","start":44009012,"end":44009012,"break":"none","ruby":[[0,1,"かれ"],[9,1,"ひと"],[18,1,"て"],[20,2,"じぶん"],[23,1,"うえ"],[28,1,"ふたた"],[30,1,"み"],[44,1,"まぼろし"],[46,1,"み"]],"text":"彼はアナニヤという人がはいってきて、手を自分の上において再び見えるようにしてくれるのを、幻で見たのである」。"},{"ref":"Acts.9.13","start":44009013,"end":44009013,"break":"none","ruby":[[5,1,"こた"],[10,1,"しゅ"],[15,1,"ひと"],[31,1,"こと"],[37,2,"せいと"],[51,1,"おお"],[54,1,"ひと"],[59,1,"き"]],"text":"アナニヤは答えた、「主よ、あの人がエルサレムで、どんなにひどい事をあなたの聖徒たちにしたかについては、多くの人たちから聞いています。"},{"ref":"Acts.9.14","start":44009014,"end":44009014,"break":"none","ruby":[[3,1,"かれ"],[10,2,"みな"],[17,1,"もの"],[23,2,"ほばく"],[27,1,"けん"],[30,3,"さいしちょう"],[37,1,"え"]],"text":"そして彼はここでも、御名をとなえる者たちをみな捕縛する権を、祭司長たちから得てきているのです」。"},{"ref":"Acts.9.15","start":44009015,"end":44009015,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"おお"],[17,1,"い"],[25,1,"ひと"],[28,3,"いほうじん"],[34,1,"おう"],[46,1,"こ"],[55,1,"な"],[57,1,"つた"],[60,1,"うつわ"],[69,1,"えら"],[72,1,"もの"]],"text":"しかし、主は仰せになった、「さあ、行きなさい。あの人は、異邦人たち、王たち、またイスラエルの子らにも、わたしの名を伝える器として、わたしが選んだ者である。"},{"ref":"Acts.9.16","start":44009016,"end":44009016,"break":"none","ruby":[[4,1,"な"],[9,1,"かれ"],[15,1,"くる"],[29,1,"かれ"],[31,1,"し"]],"text":"わたしの名のために彼がどんなに苦しまなければならないかを、彼に知らせよう」。"},{"ref":"Acts.9.17","start":44009017,"end":44009017,"break":"none","ruby":[[9,1,"で"],[13,1,"い"],[18,1,"いえ"],[24,1,"て"],[30,1,"うえ"],[35,1,"い"],[40,2,"きょうだい"],[51,1,"く"],[53,2,"とちゅう"],[56,1,"あらわ"],[59,1,"しゅ"],[69,1,"ふたた"],[71,1,"み"],[85,2,"せいれい"],[88,1,"み"]],"text":"そこでアナニヤは、出かけて行ってその家にはいり、手をサウロの上において言った、「兄弟サウロよ、あなたが来る途中で現れた主イエスは、あなたが再び見えるようになるため、そして聖霊に満たされるために、わたしをここにおつかわしになったのです」。"},{"ref":"Acts.9.18","start":44009018,"end":44009018,"break":"none","ruby":[[14,1,"め"],[28,1,"お"],[32,1,"もと"],[36,1,"み"],[49,1,"かれ"],[51,1,"た"],[60,1,"う"]],"text":"するとたちどころに、サウロの目から、うろこのようなものが落ちて、元どおり見えるようになった。そこで彼は立ってバプテスマを受け、"},{"ref":"Acts.9.19","start":44009019,"end":44009019,"break":"none","breaks":[[18,"paragraph"]],"ruby":[[2,2,"しょくじ"],[8,2,"げんき"],[11,1,"と"],[30,2,"でし"],[35,1,"とも"],[37,3,"すうじつかん"],[41,1,"す"]],"text":"また食事をとって元気を取りもどした。サウロは、ダマスコにいる弟子たちと共に数日間を過ごしてから、"},{"ref":"Acts.9.20","start":44009020,"end":44009020,"break":"none","ruby":[[4,1,"しょ"],[5,2,"かいどう"],[15,1,"の"],[17,1,"つた"],[27,1,"かみ"],[29,1,"こ"],[34,1,"と"]],"text":"ただちに諸会堂でイエスのことを宣べ伝え、このイエスこそ神の子であると説きはじめた。"},{"ref":"Acts.9.21","start":44009021,"end":44009021,"break":"none","ruby":[[3,1,"き"],[6,1,"ひと"],[12,2,"ひじょう"],[15,1,"おどろ"],[18,1,"い"],[35,1,"な"],[41,1,"もの"],[45,1,"くる"],[49,1,"おとこ"],[58,1,"うえ"],[70,1,"かれ"],[73,1,"しば"],[79,3,"さいしちょう"],[94,1,"い"]],"text":"これを聞いた人たちはみな非常に驚いて言った、「あれは、エルサレムでこの名をとなえる者たちを苦しめた男ではないか。その上ここにやってきたのも、彼らを縛りあげて、祭司長たちのところへひっぱって行くためではなかったか」。"},{"ref":"Acts.9.22","start":44009022,"end":44009022,"break":"none","ruby":[[12,1,"ちから"],[14,1,"くわ"],[34,2,"ろんしょう"],[44,1,"す"],[49,1,"じん"],[53,1,"い"],[55,1,"ふ"]],"text":"しかし、サウロはますます力が加わり、このイエスがキリストであることを論証して、ダマスコに住むユダヤ人たちを言い伏せた。"},{"ref":"Acts.9.23","start":44009023,"end":44009023,"break":"paragraph","ruby":[[0,2,"そうとう"],[3,2,"にっすう"],[15,1,"じん"],[23,1,"ころ"],[25,2,"そうだん"]],"text":"相当の日数がたったころ、ユダヤ人たちはサウロを殺す相談をした。"},{"ref":"Acts.9.24","start":44009024,"end":44009024,"break":"none","ruby":[[7,2,"いんぼう"],[10,1,"かれ"],[12,1,"し"],[22,1,"かれ"],[29,1,"ころ"],[36,2,"よるひる"],[39,1,"まち"],[41,1,"もん"],[43,2,"みまも"]],"text":"ところが、その陰謀が彼の知るところとなった。彼らはサウロを殺そうとして、夜昼、町の門を見守っていたのである。"},{"ref":"Acts.9.25","start":44009025,"end":44009025,"break":"none","ruby":[[3,1,"かれ"],[5,2,"でし"],[11,1,"よる"],[13,1,"あいだ"],[15,1,"かれ"],[20,1,"の"],[24,1,"まち"],[26,2,"じょうへき"]],"text":"そこで彼の弟子たちが、夜の間に彼をかごに乗せて、町の城壁づたいにつりおろした。"},{"ref":"Acts.9.26","start":44009026,"end":44009026,"break":"paragraph","ruby":[[10,1,"つ"],[14,2,"でし"],[19,2,"なかま"],[22,1,"くわ"],[27,1,"つと"],[36,1,"もの"],[38,1,"かれ"],[40,2,"でし"],[45,1,"しん"],[51,1,"おそ"]],"text":"サウロはエルサレムに着いて、弟子たちの仲間に加わろうと努めたが、みんなの者は彼を弟子だとは信じないで、恐れていた。"},{"ref":"Acts.9.27","start":44009027,"end":44009027,"break":"none","ruby":[[10,1,"かれ"],[12,2,"せわ"],[17,2,"しと"],[26,1,"つ"],[29,1,"い"],[32,2,"とちゅう"],[35,1,"しゅ"],[37,1,"かれ"],[39,1,"あらわ"],[42,1,"かた"],[51,1,"かれ"],[62,1,"な"],[64,2,"だいたん"],[67,1,"の"],[69,1,"つた"],[72,2,"しだい"],[76,1,"かれ"],[79,2,"せつめい"],[83,1,"き"]],"text":"ところが、バルナバは彼の世話をして使徒たちのところへ連れて行き、途中で主が彼に現れて語りかけたことや、彼がダマスコでイエスの名で大胆に宣べ伝えた次第を、彼らに説明して聞かせた。"},{"ref":"Acts.9.28","start":44009028,"end":44009028,"break":"none","ruby":[[2,2,"いらい"],[5,1,"かれ"],[7,2,"しと"],[12,2,"なかま"],[15,1,"くわ"],[25,2,"でい"],[30,1,"しゅ"],[32,1,"な"],[37,2,"だいたん"],[40,1,"かた"]],"text":"それ以来、彼は使徒たちの仲間に加わり、エルサレムに出入りし、主の名によって大胆に語り、"},{"ref":"Acts.9.29","start":44009029,"end":44009029,"break":"none","ruby":[[4,1,"ご"],[6,1,"つか"],[11,1,"じん"],[19,1,"かた"],[21,1,"あ"],[26,1,"ろん"],[28,1,"あ"],[36,1,"かれ"],[39,1,"かれ"],[41,1,"ころ"]],"text":"ギリシヤ語を使うユダヤ人たちとしばしば語り合い、また論じ合った。しかし、彼らは彼を殺そうとねらっていた。"},{"ref":"Acts.9.30","start":44009030,"end":44009030,"break":"none","ruby":[[0,2,"きょうだい"],[8,1,"し"],[12,1,"かれ"],[20,1,"つ"],[31,1,"おく"],[33,1,"だ"]],"text":"兄弟たちはそれと知って、彼をカイザリヤに連れてくだり、タルソへ送り出した。"},{"ref":"Acts.9.31","start":44009031,"end":44009031,"break":"paragraph","ruby":[[4,2,"きょうかい"],[21,1,"ぜん"],[22,2,"ちほう"],[29,2,"へいあん"],[32,1,"たも"],[35,2,"きそ"],[43,1,"しゅ"],[48,2,"せいれい"],[57,1,"あゆ"],[60,2,"しだい"],[63,2,"しんと"],[66,1,"かず"],[68,1,"ま"],[71,1,"い"]],"text":"こうして教会は、ユダヤ、ガリラヤ、サマリヤ全地方にわたって平安を保ち、基礎がかたまり、主をおそれ聖霊にはげまされて歩み、次第に信徒の数を増して行った。"},{"ref":"Acts.9.32","start":44009032,"end":44009032,"break":"paragraph","ruby":[[4,2,"ほうぼう"],[10,1,"ある"],[18,1,"す"],[20,2,"せいと"],[30,1,"くだ"],[33,1,"い"]],"text":"ペテロは方々をめぐり歩いたが、ルダに住む聖徒たちのところへも下って行った。"},{"ref":"Acts.9.33","start":44009033,"end":44009033,"break":"none","ruby":[[9,2,"ねんかん"],[12,1,"とこ"],[26,1,"ひと"],[28,1,"あ"],[34,1,"ひと"],[36,2,"ちゅうぶ"]],"text":"そして、そこで、八年間も床についているアイネヤという人に会った。この人は中風であった。"},{"ref":"Acts.9.34","start":44009034,"end":44009034,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[34,1,"くだ"],[40,1,"お"],[49,1,"とこ"],[51,1,"と"],[64,1,"かれ"],[70,1,"お"]],"text":"ペテロが彼に言った、「アイネヤよ、イエス・キリストがあなたをいやして下さるのだ。起きなさい。そして床を取りあげなさい」。すると、彼はただちに起きあがった。"},{"ref":"Acts.9.35","start":44009035,"end":44009035,"break":"none","ruby":[[7,1,"す"],[9,1,"ひと"],[19,1,"み"],[22,1,"しゅ"],[24,2,"きえ"]],"text":"ルダとサロンに住む人たちは、みなそれを見て、主に帰依した。"},{"ref":"Acts.9.36","start":44009036,"end":44009036,"break":"paragraph","ruby":[[11,1,"やく"],[33,1,"おんな"],[34,2,"でし"],[40,2,"かずかず"],[45,1,"はたら"],[48,1,"ほどこ"],[55,2,"ふじん"]],"text":"ヨッパにタビタ（これを訳すと、ドルカス、すなわち、かもしか）という女弟子がいた。数々のよい働きや施しをしていた婦人であった。"},{"ref":"Acts.9.37","start":44009037,"end":44009037,"break":"none","ruby":[[9,2,"びょうき"],[15,1,"し"],[21,2,"ひとびと"],[30,1,"あら"],[34,2,"おくじょう"],[37,1,"ま"],[39,2,"あんち"]],"text":"ところが、そのころ病気になって死んだので、人々はそのからだを洗って、屋上の間に安置した。"},{"ref":"Acts.9.38","start":44009038,"end":44009038,"break":"none","ruby":[[7,1,"ちか"],[14,2,"でし"],[31,1,"き"],[38,1,"もの"],[40,1,"かれ"],[54,1,"はや"],[63,1,"くだ"],[68,1,"たの"]],"text":"ルダはヨッパに近かったので、弟子たちはペテロがルダにきていると聞き、ふたりの者を彼のもとにやって、「どうぞ、早くこちらにおいで下さい」と頼んだ。"},{"ref":"Acts.9.39","start":44009039,"end":44009039,"break":"none","ruby":[[7,1,"た"],[15,1,"もの"],[17,1,"つ"],[25,1,"かれ"],[27,1,"つ"],[33,2,"おくじょう"],[36,1,"ま"],[38,2,"あんない"],[57,1,"かれ"],[62,1,"よ"],[73,2,"せいぜん"],[79,2,"したぎ"],[82,2,"うわぎ"],[85,2,"かずかず"],[89,1,"な"],[94,1,"み"]],"text":"そこでペテロは立って、ふたりの者に連れられてきた。彼が着くとすぐ、屋上の間に案内された。すると、やもめたちがみんな彼のそばに寄ってきて、ドルカスが生前つくった下着や上着の数々を、泣きながら見せるのであった。"},{"ref":"Acts.9.40","start":44009040,"end":44009040,"break":"none","ruby":[[8,1,"もの"],[10,1,"そと"],[12,1,"だ"],[21,1,"いの"],[29,2,"したい"],[32,1,"ほう"],[34,1,"む"],[44,1,"お"],[51,1,"い"],[58,2,"かのじょ"],[61,1,"め"],[70,1,"み"],[72,1,"お"]],"text":"ペテロはみんなの者を外に出し、ひざまずいて祈った。それから死体の方に向いて、「タビタよ、起きなさい」と言った。すると彼女は目をあけ、ペテロを見て起きなおった。"},{"ref":"Acts.9.41","start":44009041,"end":44009041,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"て"],[12,1,"た"],[22,2,"せいと"],[34,1,"よ"],[36,1,"い"],[40,2,"かのじょ"],[43,1,"い"],[53,1,"み"]],"text":"ペテロは彼女に手をかして立たせた。それから、聖徒たちや、やもめたちを呼び入れて、彼女が生きかえっているのを見せた。"},{"ref":"Acts.9.42","start":44009042,"end":44009042,"break":"none","ruby":[[8,1,"ちゅう"],[10,1,"し"],[16,1,"おお"],[19,2,"ひとびと"],[22,1,"しゅ"],[24,1,"しん"]],"text":"このことがヨッパ中に知れわたり、多くの人々が主を信じた。"},{"ref":"Acts.9.43","start":44009043,"end":44009043,"break":"none","ruby":[[5,1,"かわ"],[15,1,"ひと"],[17,1,"いえ"],[19,1,"と"],[28,1,"あいだ"],[33,2,"たいざい"]],"text":"ペテロは、皮なめしシモンという人の家に泊まり、しばらくの間ヨッパに滞在した。"}]