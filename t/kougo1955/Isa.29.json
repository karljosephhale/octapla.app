[{"ref":"Isa.29.1","start":23029001,"end":23029001,"break":"paragraph","breaks":[[15,"line"],[28,"line"]],"ruby":[[19,1,"えい"],[25,1,"まち"],[28,1,"とし"],[30,1,"とし"],[32,1,"くわ"],[35,1,"まつり"]],"text":"ああ、アリエルよ、アリエルよ、ダビデが営をかまえた町よ、年に年を加え、祭をめぐりこさせよ。"},{"ref":"Isa.29.2","start":23029002,"end":23029002,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[2,1,"とき"],[12,1,"なや"],[20,1,"かな"],[24,1,"なげ"]],"text":"その時わたしはアリエルを悩ます。そこには悲しみと嘆きとがあって、アリエルのようなものとなる。"},{"ref":"Isa.29.3","start":23029003,"end":23029003,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[12,1,"えい"],[14,1,"かま"],[28,1,"かこ"],[31,1,"るい"],[33,1,"きず"],[40,1,"せ"]],"text":"わたしはあなたのまわりに営を構え、やぐらをもってあなたを囲み、塁を築いてあなたを攻める。"},{"ref":"Isa.29.4","start":23029004,"end":23029004,"break":"line","breaks":[[18,"line"],[32,"line"],[51,"line"]],"ruby":[[2,1,"とき"],[7,1,"ふか"],[9,1,"ち"],[11,1,"なか"],[14,2,"ものい"],[18,1,"ひく"],[23,1,"なか"],[26,2,"ことば"],[29,1,"だ"],[36,1,"こえ"],[38,2,"ぼうれい"],[41,1,"こえ"],[46,1,"ち"],[49,1,"で"],[55,2,"ことば"],[61,1,"なか"]],"text":"その時あなたは深い地の中から物言い、低いちりの中から言葉を出す。あなたの声は亡霊の声のように地から出、あなたの言葉はちりの中から、さえずるようである。"},{"ref":"Isa.29.5","start":23029005,"end":23029005,"break":"line","breaks":[[13,"line"],[25,"line"],[34,"line"],[51,"line"]],"ruby":[[10,1,"む"],[13,1,"こま"],[29,1,"もの"],[31,1,"む"],[34,1,"ふ"],[36,1,"さ"],[68,1,"こと"]],"text":"しかしあなたのあだの群れは細かなちりのようになり、あらぶる者の群れは吹き去られるもみがらのようになる。また、にわかに、またたくまに、この事がある。"},{"ref":"Isa.29.6","start":23029006,"end":23029006,"break":"line","breaks":[[21,"line"],[43,"line"]],"ruby":[[4,2,"ばんぐん"],[7,1,"しゅ"],[9,1,"かみなり"],[11,2,"じしん"],[14,1,"おお"],[18,1,"さけ"],[24,1,"かぜ"],[26,2,"ぼうふう"],[31,1,"や"],[36,1,"ひ"],[38,1,"ほのお"],[43,1,"のぞ"]],"text":"すなわち万軍の主は雷、地震、大いなる叫び、つむじ風、暴風および焼きつくす火の炎をもって臨まれる。"},{"ref":"Isa.29.7","start":23029007,"end":23029007,"break":"line","breaks":[[19,"line"],[38,"line"],[48,"line"]],"ruby":[[8,1,"せ"],[11,1,"たたか"],[13,2,"くにぐに"],[16,1,"む"],[30,1,"しろ"],[32,1,"せ"],[35,1,"たたか"],[41,1,"なや"],[44,1,"もの"],[48,1,"ゆめ"],[54,1,"よる"],[56,1,"まぼろし"]],"text":"そしてアリエルを攻めて戦う国々の群れ、すなわちアリエルとその城を攻めて戦い、これを悩ます者はみな夢のように、夜の幻のようになる。"},{"ref":"Isa.29.8","start":23029008,"end":23029008,"break":"line","breaks":[[16,"line"],[34,"line"],[55,"line"],[78,"line"],[95,"line"]],"ruby":[[0,1,"う"],[3,1,"もの"],[5,1,"た"],[11,1,"ゆめ"],[23,1,"う"],[43,1,"もの"],[45,1,"の"],[50,1,"ゆめ"],[60,1,"つか"],[82,1,"やま"],[84,1,"せ"],[87,1,"たたか"],[89,2,"くにぐに"],[92,1,"む"]],"text":"飢えた者が食べることを夢みても、さめると、その飢えがいえないように、あるいは、かわいた者が飲むことを夢みても、さめると、疲れてそのかわきがとまらないように、シオンの山を攻めて戦う国々の群れもそのようになる。"},{"ref":"Isa.29.9","start":23029009,"end":23029009,"break":"paragraph","breaks":[[19,"line"],[30,"line"],[54,"line"]],"ruby":[[6,2,"ちかく"],[9,1,"うしな"],[12,1,"き"],[14,1,"とお"],[19,1,"め"],[25,1,"めくら"],[36,1,"よ"],[45,1,"さけ"],[62,1,"こ"],[64,1,"さけ"]],"text":"あなたがたは知覚を失って気が遠くなれ、目がくらんで盲となれ。あなたがたは酔っていよ、しかし酒のゆえではない、よろめけ、しかし濃き酒のゆえではない。"},{"ref":"Isa.29.10","start":23029010,"end":23029010,"break":"line","breaks":[[21,"line"],[40,"line"],[54,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ふか"],[4,1,"ねむ"],[7,1,"れい"],[15,1,"うえ"],[27,1,"め"],[31,3,"よげんしゃ"],[35,1,"と"],[46,1,"あたま"],[50,3,"せんけんしゃ"]],"text":"主が深い眠りの霊をあなたがたの上にそそぎ、あなたがたの目である預言者を閉じこめ、あなたがたの頭である先見者をおおわれたからである。"},{"ref":"Isa.29.11","start":23029011,"end":23029011,"break":"paragraph","ruby":[[11,1,"まぼろし"],[21,1,"ふう"],[24,2,"しょもつ"],[27,2,"ことば"],[36,2,"ひとびと"],[42,1,"よ"],[50,1,"もの"],[61,1,"よ"],[70,1,"い"],[78,1,"ふう"],[85,1,"よ"],[96,1,"かれ"],[98,1,"い"]],"text":"それゆえ、このすべての幻は、あなたがたには封じた書物の言葉のようになり、人々はこれを読むことのできる者にわたして、「これを読んでください」と言えば、「これは封じてあるから読むことができない」と彼は言う。"},{"ref":"Isa.29.12","start":23029012,"end":23029012,"break":"none","ruby":[[4,2,"しょもつ"],[7,1,"よ"],[16,1,"もの"],[27,1,"よ"],[36,1,"い"],[41,1,"よ"],[52,1,"かれ"],[54,1,"い"]],"text":"またその書物を読むことのできない者にわたして、「これを読んでください」と言えば、「読むことはできない」と彼は言う。"},{"ref":"Isa.29.13","start":23029013,"end":23029013,"break":"paragraph","breaks":[[7,"line"],[25,"line"],[44,"line"],[58,"line"],[75,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[10,1,"たみ"],[12,1,"くち"],[21,1,"ちか"],[37,1,"うやま"],[46,1,"こころ"],[53,1,"とお"],[55,1,"はな"],[58,1,"かれ"],[69,1,"おそ"],[78,1,"おぼ"],[81,1,"ひと"],[83,1,"いまし"]],"text":"主は言われた、「この民は口をもってわたしに近づき、くちびるをもってわたしを敬うけれども、その心はわたしから遠く離れ、彼らのわたしをかしこみ恐れるのは、そらで覚えた人の戒めによるのである。"},{"ref":"Isa.29.14","start":23029014,"end":23029014,"break":"line","breaks":[[17,"line"],[29,"line"],[46,"line"],[62,"line"]],"ruby":[[5,1,"み"],[14,1,"たみ"],[17,1,"ふたた"],[19,1,"おどろ"],[26,1,"おこな"],[32,3,"ふしぎ"],[36,1,"おどろ"],[46,1,"かれ"],[52,1,"かしこ"],[54,1,"ひと"],[56,2,"ちえ"],[59,1,"ほろ"],[65,1,"ひと"],[67,2,"ちしき"],[70,1,"かく"]],"text":"それゆえ、見よ、わたしはこの民に、再び驚くべきわざを行う、それは不思議な驚くべきわざである。彼らのうちの賢い人の知恵は滅び、さとい人の知識は隠される」。"},{"ref":"Isa.29.15","start":23029015,"end":23029015,"break":"paragraph","breaks":[[9,"line"],[25,"line"],[38,"line"],[51,"line"]],"ruby":[[12,1,"はか"],[17,1,"しゅ"],[19,1,"ふか"],[21,1,"かく"],[23,1,"もの"],[25,1,"かれ"],[28,1,"くら"],[30,1,"なか"],[35,1,"おこな"],[47,1,"み"],[62,1,"し"],[67,1,"い"]],"text":"わざわいなるかな、おのが計りごとを主に深く隠す者。彼らは暗い中でわざを行い、「だれがわれわれを見るか、だれがわれわれのことを知るか」と言う。"},{"ref":"Isa.29.16","start":23029016,"end":23029016,"break":"line","breaks":[[16,"line"],[37,"line"],[55,"line"],[73,"line"],[90,"line"]],"ruby":[[6,2,"てんとう"],[10,1,"かんが"],[16,2,"とうき"],[18,1,"し"],[20,2,"ねんど"],[23,1,"おな"],[28,1,"おも"],[37,1,"つく"],[41,1,"もの"],[46,1,"つく"],[49,1,"もの"],[56,1,"かれ"],[62,1,"つく"],[70,1,"い"],[73,1,"かたち"],[74,1,"つく"],[78,1,"もの"],[80,1,"かたち"],[81,1,"つく"],[84,1,"もの"],[91,1,"かれ"],[93,2,"ちえ"],[100,1,"い"]],"text":"あなたがたは転倒して考えている。陶器師は粘土と同じものに思われるだろうか。造られた物はそれを造った者について、「彼はわたしを造らなかった」と言い、形造られた物は形造った者について、「彼は知恵がない」と言うことができようか。"},{"ref":"Isa.29.17","start":23029017,"end":23029017,"break":"paragraph","breaks":[[22,"line"],[32,"line"]],"ruby":[[11,1,"かわ"],[14,1,"こ"],[17,1,"はたけ"],[22,1,"こ"],[25,1,"はたけ"],[27,1,"はやし"],[32,1,"おも"],[36,1,"とき"],[38,1,"く"]],"text":"しばらくしてレバノンは変って肥えた畑となり、肥えた畑は林のように思われる時が来るではないか。"},{"ref":"Isa.29.18","start":23029018,"end":23029018,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"ひ"],[4,1,"みみ"],[8,2,"しょもつ"],[11,2,"ことば"],[14,1,"き"],[17,1,"め"],[21,1,"め"],[25,1,"くら"],[31,1,"み"]],"text":"その日、耳しいは書物の言葉を聞き、目しいの目はその暗やみから、見ることができる。"},{"ref":"Isa.29.19","start":23029019,"end":23029019,"break":"line","breaks":[[19,"line"],[29,"line"]],"ruby":[[0,2,"にゅうわ"],[3,1,"もの"],[5,1,"しゅ"],[10,1,"あら"],[14,1,"よろこ"],[17,1,"え"],[19,1,"ひと"],[24,1,"まず"],[27,1,"もの"],[35,2,"せいじゃ"],[41,1,"たの"],[45,1,"え"]],"text":"柔和な者は主によって新たなる喜びを得、人のなかの貧しい者はイスラエルの聖者によって楽しみを得る。"},{"ref":"Isa.29.20","start":23029020,"end":23029020,"break":"line","breaks":[[9,"line"],[18,"line"],[35,"line"]],"ruby":[[4,1,"もの"],[6,1,"た"],[13,1,"もの"],[18,1,"あく"],[20,1,"おこな"],[32,1,"もの"],[40,1,"た"],[42,1,"ほろ"]],"text":"あらぶる者は絶え、あざける者はうせ、悪を行おうと、おりをうかがう者は、ことごとく断ち滅ぼされるからである。"},{"ref":"Isa.29.21","start":23029021,"end":23029021,"break":"line","breaks":[[16,"line"],[35,"line"]],"ruby":[[0,1,"かれ"],[3,2,"ことば"],[9,1,"ひと"],[11,1,"つみ"],[13,1,"さだ"],[16,1,"まち"],[18,1,"もん"],[24,1,"もの"],[39,2,"ことば"],[46,1,"ただ"],[49,1,"もの"]],"text":"彼らは言葉によって人を罪に定め、町の門でいさめる者をわなにおとしいれ、むなしい言葉をかまえて正しい者をしりぞける。"},{"ref":"Isa.29.22","start":23029022,"end":23029022,"break":"paragraph","breaks":[[37,"stanza"],[56,"line"]],"ruby":[[5,1,"むかし"],[18,1,"しゅ"],[25,1,"いえ"],[32,1,"い"],[52,1,"う"],[58,1,"かお"],[64,1,"いろ"],[66,1,"うしな"]],"text":"それゆえ、昔アブラハムをあがなわれた主は、ヤコブの家についてこう言われる、「ヤコブは、もはやはずかしめを受けず、その顔は、もはや色を失うことはない。"},{"ref":"Isa.29.23","start":23029023,"end":23029023,"break":"line","breaks":[[22,"line"],[33,"line"],[45,"line"]],"ruby":[[0,1,"かれ"],[2,2,"しそん"],[8,1,"なか"],[12,1,"て"],[17,1,"み"],[22,1,"かれ"],[27,1,"な"],[29,1,"せい"],[37,2,"せいじゃ"],[40,1,"せい"],[51,1,"かみ"],[53,1,"おそ"]],"text":"彼の子孫が、その中にわが手のわざを見るとき、彼らはわが名を聖とし、ヤコブの聖者を聖として、イスラエルの神を恐れる。"},{"ref":"Isa.29.24","start":23029024,"end":23029024,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"こころ"],[7,1,"もの"],[10,1,"さと"],[13,1,"え"],[19,1,"もの"],[21,1,"おしえ"]],"text":"心のあやまれる者も、悟りを得、つぶやく者も教をうける」。"}]