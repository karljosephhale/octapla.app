[{"ref":"Hos.8.1","start":28008001,"end":28008001,"break":"paragraph","breaks":[[14,"line"],[26,"line"],[39,"line"]],"ruby":[[8,1,"くち"],[19,1,"しゅ"],[21,1,"いえ"],[23,1,"のぞ"],[26,1,"かれ"],[33,2,"けいやく"],[36,1,"やぶ"],[43,2,"りっぽう"],[46,1,"おか"]],"text":"ラッパをあなたの口にあてよ、はげたかは主の家に臨む。彼らがわたしの契約を破り、わたしの律法を犯したからだ。"},{"ref":"Hos.8.2","start":28008002,"end":28008002,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[7,1,"む"],[11,1,"さけ"],[17,1,"かみ"],[34,1,"し"]],"text":"彼らはわたしに向かって叫ぶ、「わが神よ、われわれイスラエルはあなたを知る」と。"},{"ref":"Hos.8.3","start":28008003,"end":28008003,"break":"line","breaks":[[14,"line"]],"ruby":[[6,1,"ぜん"],[14,1,"てき"],[19,1,"お"]],"text":"イスラエルは善はしりぞけた。敵はこれを追うであろう。"},{"ref":"Hos.8.4","start":28008004,"end":28008004,"break":"stanza","breaks":[[9,"line"],[29,"line"],[38,"line"],[54,"line"],[65,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おう"],[5,1,"た"],[20,1,"た"],[29,1,"かれ"],[32,1,"きみ"],[34,1,"た"],[49,1,"し"],[54,1,"かれ"],[57,1,"ぎん"],[59,1,"きん"],[65,2,"じぶん"],[70,1,"ほろ"],[76,2,"ぐうぞう"],[79,1,"つく"]],"text":"彼らは王を立てた、しかし、わたしによって立てたのではない。彼らは君を立てた、しかし、わたしはこれを知らない。彼らは銀と金をもって、自分たちの滅びのために偶像を造った。"},{"ref":"Hos.8.5","start":28008005,"end":28008005,"break":"line","breaks":[[23,"line"],[41,"line"],[56,"line"]],"ruby":[[14,1,"こ"],[15,1,"うし"],[17,1,"い"],[27,1,"いか"],[30,1,"かれ"],[33,1,"む"],[37,1,"も"],[41,1,"かれ"],[56,1,"つみ"],[59,1,"もの"]],"text":"サマリヤよ、わたしはあなたの子牛を忌みきらう。わたしの怒りは彼らに向かって燃える。彼らはいつになればイスラエルで罪なき者となるであろうか。"},{"ref":"Hos.8.6","start":28008006,"end":28008006,"break":"line","breaks":[[19,"line"]],"ruby":[[3,2,"こうじん"],[6,1,"つく"],[13,1,"かみ"],[24,1,"こ"],[25,1,"うし"],[27,1,"くだ"],[30,1,"こな"]],"text":"これは工人の作ったもので、神ではない。サマリヤの子牛は砕けて粉となる。"},{"ref":"Hos.8.7","start":28008007,"end":28008007,"break":"stanza","breaks":[[19,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かぜ"],[12,1,"かぜ"],[14,1,"か"],[16,1,"と"],[19,1,"た"],[24,2,"こくもつ"],[27,1,"ほ"],[29,1,"も"],[35,1,"みの"],[43,1,"みの"],[48,2,"たこく"],[50,1,"じん"],[55,1,"く"],[57,1,"つく"]],"text":"彼らは風をまいて、つむじ風を刈り取る。立っている穀物は穂を持たず、また実らない。たとい実っても、他国人がこれを食い尽す。"},{"ref":"Hos.8.8","start":28008008,"end":28008008,"break":"line","breaks":[[11,"line"],[24,"line"]],"ruby":[[11,1,"かれ"],[14,1,"しょ"],[15,2,"こくみん"],[18,1,"あいだ"],[27,2,"むよう"],[30,1,"うつわ"]],"text":"イスラエルはのまれた。彼らは諸国民の間にあって、すでに無用な器のようになった。"},{"ref":"Hos.8.9","start":28008009,"end":28008009,"break":"line","breaks":[[19,"line"],[33,"line"]],"ruby":[[0,1,"かれ"],[10,1,"の"],[29,1,"い"],[39,1,"もの"],[41,1,"おく"],[44,2,"こいびと"],[47,1,"え"]],"text":"彼らはひとりさまよう野のろばのように、アッスリヤにのぼって行った。エフライムは物を贈って恋人を得た。"},{"ref":"Hos.8.10","start":28008010,"end":28008010,"break":"line","breaks":[[22,"line"],[37,"line"],[48,"line"]],"ruby":[[3,1,"かれ"],[6,2,"くにぐに"],[9,1,"もの"],[11,1,"おく"],[14,3,"どうめいしゃ"],[18,1,"え"],[30,1,"かれ"],[33,1,"あつ"],[37,1,"かれ"],[48,1,"おう"],[50,1,"きみ"],[54,1,"あぶら"]],"text":"たとい彼らが国々に物を贈って同盟者を得ても、わたしはまもなく彼らを集める。彼らはしばらくにして、王や君たちに油をそそぐことをやめる。"},{"ref":"Hos.8.11","start":28008011,"end":28008011,"break":"stanza","breaks":[[23,"line"]],"ruby":[[6,1,"おお"],[9,2,"さいだん"],[12,1,"つく"],[15,1,"つみ"],[17,1,"おか"],[26,1,"かれ"],[29,1,"つみ"],[31,1,"おか"],[36,2,"さいだん"]],"text":"エフライムは多くの祭壇を造って罪を犯したゆえ、これは彼には罪を犯すための祭壇となった。"},{"ref":"Hos.8.12","start":28008012,"end":28008012,"break":"line","breaks":[[10,"line"],[25,"line"]],"ruby":[[4,1,"かれ"],[14,2,"りっぽう"],[17,1,"か"],[32,1,"あや"],[35,1,"もの"],[40,1,"おも"]],"text":"わたしは彼のために、あまたの律法を書きしるしたが、これはかえって怪しい物のように思われた。"},{"ref":"Hos.8.13","start":28008013,"end":28008013,"break":"line","breaks":[[22,"line"],[36,"line"],[58,"line"]],"ruby":[[0,1,"かれ"],[3,2,"ぎせい"],[6,1,"この"],[9,1,"にく"],[18,1,"た"],[25,1,"しゅ"],[30,1,"よろこ"],[36,1,"いま"],[38,1,"かれ"],[41,2,"ふぎ"],[44,1,"おぼ"],[47,1,"かれ"],[50,1,"つみ"],[52,1,"ばっ"],[58,1,"かれ"],[66,1,"かえ"]],"text":"彼らは犠牲を好み、肉をささげてこれを食べる。しかし主はこれを喜ばれない。今、彼らの不義を覚え、彼らの罪を罰せられる。彼らはエジプトに帰る。"},{"ref":"Hos.8.14","start":28008014,"end":28008014,"break":"line","breaks":[[17,"line"],[29,"line"],[46,"line"],[64,"line"]],"ruby":[[6,2,"じぶん"],[9,1,"つく"],[11,1,"ぬし"],[13,1,"わす"],[22,2,"きゅうでん"],[25,1,"た"],[32,2,"けんご"],[35,2,"まちまち"],[38,1,"おお"],[40,1,"ま"],[42,1,"くわ"],[53,1,"ひ"],[57,2,"まちまち"],[60,1,"おく"],[69,1,"しろ"],[71,1,"や"],[73,1,"ほろ"]],"text":"イスラエルは自分の造り主を忘れて、もろもろの宮殿を建てた。ユダは堅固な町々を多く増し加えた。しかしわたしは火をその町々に送って、もろもろの城を焼き滅ぼす。"}]