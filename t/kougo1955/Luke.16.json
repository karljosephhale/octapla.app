[{"ref":"Luke.16.1","start":42016001,"end":42016001,"break":"paragraph","ruby":[[7,2,"でし"],[12,1,"い"],[20,2,"かねもち"],[31,2,"かれい"],[38,1,"かれ"],[40,2,"しゅじん"],[43,2,"ざいさん"],[46,2,"ろうひ"],[54,1,"つ"],[56,1,"ぐち"],[60,1,"もの"]],"text":"イエスはまた、弟子たちに言われた、「ある金持のところにひとりの家令がいたが、彼は主人の財産を浪費していると、告げ口をする者があった。"},{"ref":"Luke.16.2","start":42016002,"end":42016002,"break":"none","ruby":[[3,2,"しゅじん"],[6,1,"かれ"],[8,1,"よ"],[11,1,"い"],[23,1,"き"],[48,2,"かいけい"],[50,2,"ほうこく"],[53,1,"だ"],[61,2,"かれい"],[67,1,"お"]],"text":"そこで主人は彼を呼んで言った、『あなたについて聞いていることがあるが、あれはどうなのか。あなたの会計報告を出しなさい。もう家令をさせて置くわけにはいかないから』。"},{"ref":"Luke.16.3","start":42016003,"end":42016003,"break":"none","ruby":[[2,2,"かれい"],[5,1,"こころ"],[7,1,"なか"],[9,1,"おも"],[21,2,"しゅじん"],[28,1,"しょく"],[30,1,"と"],[32,1,"あ"],[42,1,"つち"],[44,1,"ほ"],[48,1,"ちから"],[54,1,"もの"],[61,1,"は"]],"text":"この家令は心の中で思った、『どうしようか。主人がわたしの職を取り上げようとしている。土を掘るには力がないし、物ごいするのは恥ずかしい。"},{"ref":"Luke.16.4","start":42016004,"end":42016004,"break":"none","ruby":[[17,1,"しょく"],[26,2,"ばあい"],[29,2,"ひとびと"],[38,1,"いえ"],[40,1,"むか"]],"text":"そうだ、わかった。こうしておけば、職をやめさせられる場合、人々がわたしをその家に迎えてくれるだろう』。"},{"ref":"Luke.16.5","start":42016005,"end":42016005,"break":"none","ruby":[[4,1,"かれ"],[7,2,"しゅじん"],[10,2,"ふさい"],[12,1,"しゃ"],[20,1,"よ"],[22,1,"だ"],[26,1,"はじ"],[29,1,"ひと"],[42,2,"しゅじん"],[49,2,"ふさい"],[59,1,"たず"]],"text":"それから彼は、主人の負債者をひとりびとり呼び出して、初めの人に、『あなたは、わたしの主人にどれだけ負債がありますか』と尋ねた。"},{"ref":"Luke.16.6","start":42016006,"end":42016006,"break":"none","ruby":[[1,1,"あぶら"],[3,1,"たる"],[8,1,"こた"],[15,2,"かれい"],[18,1,"い"],[30,2,"しょうしょ"],[48,1,"たる"],[50,1,"か"],[52,1,"か"]],"text":"『油百樽です』と答えた。そこで家令が言った、『ここにあなたの証書がある。すぐそこにすわって、五十樽と書き変えなさい』。"},{"ref":"Luke.16.7","start":42016007,"end":42016007,"break":"none","ruby":[[0,1,"つぎ"],[15,2,"ふさい"],[27,1,"たず"],[33,1,"むぎ"],[35,1,"こく"],[40,1,"こた"],[47,1,"たい"],[60,2,"しょうしょ"],[69,1,"こく"],[71,1,"か"],[73,1,"か"],[80,1,"い"]],"text":"次に、もうひとりに、『あなたの負債はどれだけですか』と尋ねると、『麦百石です』と答えた。これに対して、『ここに、あなたの証書があるが、八十石と書き変えなさい』と言った。"},{"ref":"Luke.16.8","start":42016008,"end":42016008,"break":"none","ruby":[[4,2,"しゅじん"],[10,2,"ふせい"],[13,2,"かれい"],[16,2,"りこう"],[21,1,"ほう"],[29,1,"よ"],[31,1,"こ"],[36,2,"じだい"],[39,1,"たい"],[44,1,"ひかり"],[46,1,"こ"],[51,2,"りこう"]],"text":"ところが主人は、この不正な家令の利口なやり方をほめた。この世の子らはその時代に対しては、光の子らよりも利口である。"},{"ref":"Luke.16.9","start":42016009,"end":42016009,"break":"none","ruby":[[8,1,"い"],[12,2,"ふせい"],[15,1,"とみ"],[17,1,"もち"],[23,2,"じぶん"],[29,1,"とも"],[46,1,"とみ"],[48,1,"な"],[53,2,"ばあい"],[62,2,"えいえん"],[69,1,"むか"]],"text":"またあなたがたに言うが、不正の富を用いてでも、自分のために友だちをつくるがよい。そうすれば、富が無くなった場合、あなたがたを永遠のすまいに迎えてくれるであろう。"},{"ref":"Luke.16.10","start":42016010,"end":42016010,"break":"none","ruby":[[0,2,"しょうじ"],[3,2,"ちゅうじつ"],[6,1,"ひと"],[9,2,"だいじ"],[13,2,"ちゅうじつ"],[23,2,"しょうじ"],[26,1,"ふ"],[27,2,"ちゅうじつ"],[30,1,"ひと"],[32,2,"だいじ"],[36,1,"ふ"],[37,2,"ちゅうじつ"]],"text":"小事に忠実な人は、大事にも忠実である。そして、小事に不忠実な人は大事にも不忠実である。"},{"ref":"Luke.16.11","start":42016011,"end":42016011,"break":"none","ruby":[[12,2,"ふせい"],[15,1,"とみ"],[20,2,"ちゅうじつ"],[32,1,"しん"],[34,1,"とみ"],[36,1,"まか"]],"text":"だから、もしあなたがたが不正の富について忠実でなかったら、だれが真の富を任せるだろうか。"},{"ref":"Luke.16.12","start":42016012,"end":42016012,"break":"none","ruby":[[8,1,"ひと"],[16,2,"ちゅうじつ"],[37,1,"あた"]],"text":"また、もしほかの人のものについて忠実でなかったら、だれがあなたがたのものを与えてくれようか。"},{"ref":"Luke.16.13","start":42016013,"end":42016013,"break":"none","ruby":[[2,1,"しもべ"],[10,2,"しゅじん"],[13,1,"か"],[15,1,"つか"],[26,2,"いっぽう"],[29,1,"にく"],[32,2,"たほう"],[35,1,"あい"],[43,2,"いっぽう"],[46,1,"した"],[50,2,"たほう"],[71,1,"かみ"],[73,1,"とみ"],[76,1,"か"],[78,1,"つか"]],"text":"どの僕でも、ふたりの主人に兼ね仕えることはできない。一方を憎んで他方を愛し、あるいは、一方に親しんで他方をうとんじるからである。あなたがたは、神と富とに兼ね仕えることはできない」。"},{"ref":"Luke.16.14","start":42016014,"end":42016014,"break":"paragraph","ruby":[[0,1,"よく"],[2,1,"ふか"],[8,1,"びと"],[20,2,"ことば"],[23,1,"き"],[33,1,"わら"]],"text":"欲の深いパリサイ人たちが、すべてこれらの言葉を聞いて、イエスをあざ笑った。"},{"ref":"Luke.16.15","start":42016015,"end":42016015,"break":"none","ruby":[[3,1,"かれ"],[10,1,"い"],[23,2,"ひとびと"],[26,1,"まえ"],[28,2,"じぶん"],[31,1,"ただ"],[37,1,"ひと"],[48,1,"かみ"],[56,1,"こころ"],[59,1,"ぞん"],[65,2,"ひとびと"],[68,1,"あいだ"],[70,1,"たっと"],[78,1,"かみ"],[85,1,"い"]],"text":"そこで彼らにむかって言われた、「あなたがたは、人々の前で自分を正しいとする人たちである。しかし、神はあなたがたの心をご存じである。人々の間で尊ばれるものは、神のみまえでは忌みきらわれる。"},{"ref":"Luke.16.16","start":42016016,"end":42016016,"break":"none","ruby":[[0,2,"りっぽう"],[3,3,"よげんしゃ"],[12,1,"とき"],[24,2,"いらい"],[27,1,"かみ"],[29,1,"くに"],[31,1,"の"],[33,1,"つた"],[38,2,"ひとびと"],[41,1,"みな"],[45,2,"とつにゅう"]],"text":"律法と預言者とはヨハネの時までのものである。それ以来、神の国が宣べ伝えられ、人々は皆これに突入している。"},{"ref":"Luke.16.17","start":42016017,"end":42016017,"break":"none","ruby":[[4,2,"りっぽう"],[7,2,"いっかく"],[10,1,"お"],[17,2,"てんち"],[20,1,"ほろ"],[23,1,"ほう"]],"text":"しかし、律法の一画が落ちるよりは、天地の滅びる方が、もっとたやすい。"},{"ref":"Luke.16.18","start":42016018,"end":42016018,"break":"none","ruby":[[3,2,"じぶん"],[6,1,"つま"],[8,1,"だ"],[11,1,"た"],[13,1,"おんな"],[18,1,"もの"],[21,2,"かんいん"],[24,1,"おこな"],[35,1,"おっと"],[38,1,"だ"],[42,1,"おんな"],[47,1,"もの"],[50,2,"かんいん"],[53,1,"おこな"]],"text":"すべて自分の妻を出して他の女をめとる者は、姦淫を行うものであり、また、夫から出された女をめとる者も、姦淫を行うものである。"},{"ref":"Luke.16.19","start":42016019,"end":42016019,"break":"paragraph","ruby":[[2,2,"かねもち"],[8,1,"かれ"],[10,1,"むらさき"],[12,1,"ころも"],[14,1,"ほそ"],[15,1,"ぬの"],[17,1,"き"],[20,2,"まいにち"],[27,1,"あそ"],[29,1,"くら"]],"text":"ある金持がいた。彼は紫の衣や細布を着て、毎日ぜいたくに遊び暮していた。"},{"ref":"Luke.16.20","start":42016020,"end":42016020,"break":"none","ruby":[[11,3,"びんぼうにん"],[15,2,"ぜんしん"],[19,1,"もの"],[29,2,"かねもち"],[32,2,"げんかん"],[35,1,"まえ"]],"text":"ところが、ラザロという貧乏人が全身でき物でおおわれて、この金持の玄関の前にすわり、"},{"ref":"Luke.16.21","start":42016021,"end":42016021,"break":"none","ruby":[[2,2,"しょくたく"],[6,1,"お"],[12,1,"う"],[20,1,"のぞ"],[28,1,"うえ"],[30,1,"いぬ"],[34,1,"かれ"],[38,1,"もの"]],"text":"その食卓から落ちるもので飢えをしのごうと望んでいた。その上、犬がきて彼のでき物をなめていた。"},{"ref":"Luke.16.22","start":42016022,"end":42016022,"break":"none","ruby":[[2,3,"びんぼうにん"],[9,1,"し"],[12,2,"みつかい"],[17,1,"つ"],[33,1,"おく"],[38,2,"かねもち"],[41,1,"し"],[44,1,"ほうむ"]],"text":"この貧乏人がついに死に、御使たちに連れられてアブラハムのふところに送られた。金持も死んで葬られた。"},{"ref":"Luke.16.23","start":42016023,"end":42016023,"break":"none","ruby":[[3,2,"よみ"],[8,1,"くる"],[15,1,"め"],[47,1,"み"]],"text":"そして黄泉にいて苦しみながら、目をあげると、アブラハムとそのふところにいるラザロとが、はるかに見えた。"},{"ref":"Luke.16.24","start":42016024,"end":42016024,"break":"none","ruby":[[3,1,"こえ"],[8,1,"い"],[13,1,"ちち"],[52,2,"ゆびさき"],[55,1,"みず"],[65,1,"した"],[67,1,"ひ"],[83,2,"かえん"],[86,1,"なか"],[88,1,"くる"]],"text":"そこで声をあげて言った、『父、アブラハムよ、わたしをあわれんでください。ラザロをおつかわしになって、その指先を水でぬらし、わたしの舌を冷やさせてください。わたしはこの火炎の中で苦しみもだえています』。"},{"ref":"Luke.16.25","start":42016025,"end":42016025,"break":"none","ruby":[[6,1,"い"],[11,1,"こ"],[14,1,"おも"],[16,1,"だ"],[26,2,"せいぜん"],[33,1,"う"],[40,1,"ほう"],[42,1,"わる"],[47,1,"う"],[54,1,"いま"],[60,1,"かれ"],[62,1,"なぐさ"],[71,1,"くる"]],"text":"アブラハムが言った、『子よ、思い出すがよい。あなたは生前よいものを受け、ラザロの方は悪いものを受けた。しかし今ここでは、彼は慰められ、あなたは苦しみもだえている。"},{"ref":"Luke.16.26","start":42016026,"end":42016026,"break":"none","ruby":[[20,1,"あいだ"],[23,1,"おお"],[26,1,"ふち"],[46,1,"ほう"],[48,1,"わた"],[52,1,"おも"],[73,1,"ほう"],[75,1,"こ"],[78,1,"く"]],"text":"そればかりか、わたしたちとあなたがたとの間には大きな淵がおいてあって、こちらからあなたがたの方へ渡ろうと思ってもできないし、そちらからわたしたちの方へ越えて来ることもできない』。"},{"ref":"Luke.16.27","start":42016027,"end":42016027,"break":"none","ruby":[[3,2,"かねもち"],[6,1,"い"],[11,1,"ちち"],[17,1,"ねが"],[27,1,"ちち"],[29,1,"いえ"]],"text":"そこで金持が言った、『父よ、ではお願いします。わたしの父の家へラザロをつかわしてください。"},{"ref":"Luke.16.28","start":42016028,"end":42016028,"break":"none","ruby":[[5,1,"にん"],[7,2,"きょうだい"],[19,1,"くる"],[22,1,"ところ"],[24,1,"く"],[35,1,"かれ"],[38,2,"けいこく"]],"text":"わたしに五人の兄弟がいますので、こんな苦しい所へ来ることがないように、彼らに警告していただきたいのです』。"},{"ref":"Luke.16.29","start":42016029,"end":42016029,"break":"none","ruby":[[6,1,"い"],[11,1,"かれ"],[19,3,"よげんしゃ"],[30,1,"き"]],"text":"アブラハムは言った、『彼らにはモーセと預言者とがある。それに聞くがよかろう』。"},{"ref":"Luke.16.30","start":42016030,"end":42016030,"break":"none","ruby":[[0,2,"かねもち"],[3,1,"い"],[13,1,"ちち"],[23,2,"しにん"],[26,1,"なか"],[33,2,"きょうだい"],[42,1,"い"],[52,1,"かれ"],[55,1,"く"],[57,1,"あらた"]],"text":"金持が言った、『いえいえ、父アブラハムよ、もし死人の中からだれかが兄弟たちのところへ行ってくれましたら、彼らは悔い改めるでしょう』。"},{"ref":"Luke.16.31","start":42016031,"end":42016031,"break":"none","ruby":[[6,1,"い"],[13,1,"かれ"],[20,3,"よげんしゃ"],[25,1,"みみ"],[27,1,"かたむ"],[34,2,"しにん"],[37,1,"なか"],[48,1,"もの"],[55,1,"かれ"],[60,1,"すす"],[63,1,"き"],[65,1,"い"]],"text":"アブラハムは言った、『もし彼らがモーセと預言者とに耳を傾けないなら、死人の中からよみがえってくる者があっても、彼らはその勧めを聞き入れはしないであろう』」。"}]