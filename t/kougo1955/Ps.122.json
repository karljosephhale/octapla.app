[{"ref":"Ps.122.1","start":19122001,"end":19122001,"break":"paragraph","title":"ダビデがよんだ都もうでの歌","breaks":[[24,"line"]],"ruby":[[0,2,"ひとびと"],[16,1,"しゅ"],[18,1,"いえ"],[20,1,"い"],[25,1,"い"],[35,1,"よろこ"]],"titleRuby":[[7,1,"みやこ"],[12,1,"うた"]],"text":"人々がわたしにむかって「われらは主の家に行こう」と言ったとき、わたしは喜んだ。"},{"ref":"Ps.122.2","start":19122002,"end":19122002,"break":"line","breaks":[[13,"line"]],"ruby":[[11,1,"あし"],[17,1,"もん"],[22,1,"た"]],"text":"エルサレムよ、われらの足はあなたの門のうちに立っている。"},{"ref":"Ps.122.3","start":19122003,"end":19122003,"break":"line","breaks":[[13,"line"]],"ruby":[[8,1,"まち"],[13,1,"た"]],"text":"しげくつらなった町のように建てられているエルサレムよ、"},{"ref":"Ps.122.4","start":19122004,"end":19122004,"break":"line","breaks":[[17,"line"],[38,"line"]],"ruby":[[5,2,"ぶぞく"],[11,1,"しゅ"],[13,2,"ぶぞく"],[20,1,"のぼ"],[23,1,"き"],[25,1,"しゅ"],[28,1,"な"],[30,2,"かんしゃ"]],"text":"もろもろの部族すなわち主の部族が、そこに上って来て主のみ名に感謝することは、イスラエルのおきてである。"},{"ref":"Ps.122.5","start":19122005,"end":19122005,"break":"line","breaks":[[9,"line"]],"ruby":[[7,1,"ざ"],[13,1,"いえ"],[15,2,"おうざ"],[18,1,"もう"]],"text":"そこにさばきの座、ダビデの家の王座が設けられてあった。"},{"ref":"Ps.122.6","start":19122006,"end":19122006,"break":"line","breaks":[[15,"line"]],"ruby":[[9,2,"へいあん"],[12,1,"いの"],[22,1,"あい"],[25,1,"もの"],[27,1,"さか"]],"text":"エルサレムのために平安を祈れ、「エルサレムを愛する者は栄え、"},{"ref":"Ps.122.7","start":19122007,"end":19122007,"break":"line","breaks":[[14,"line"]],"ruby":[[2,2,"じょうへき"],[8,2,"へいあん"],[19,1,"との"],[24,2,"あんぜん"]],"text":"その城壁のうちに平安があり、もろもろの殿のうちに安全があるように」と。"},{"ref":"Ps.122.8","start":19122008,"end":19122008,"break":"line","breaks":[[17,"line"]],"ruby":[[2,2,"きょうだい"],[7,1,"とも"],[27,2,"へいあん"],[37,1,"い"]],"text":"わが兄弟および友のために、わたしは「エルサレムのうちに平安があるように」と言い、"},{"ref":"Ps.122.9","start":19122009,"end":19122009,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"いえ"],[29,1,"もと"]],"text":"われらの神、主の家のために、わたしはエルサレムのさいわいを求めるであろう。"}]