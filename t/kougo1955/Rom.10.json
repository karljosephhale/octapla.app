[{"ref":"Rom.10.1","start":45010001,"end":45010001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[10,1,"こころ"],[12,1,"ねが"],[15,1,"かれ"],[21,1,"かみ"],[27,1,"いのり"],[30,1,"かれ"],[33,1,"すく"]],"text":"兄弟たちよ。わたしの心の願い、彼らのために神にささげる祈は、彼らが救われることである。"},{"ref":"Rom.10.2","start":45010002,"end":45010002,"break":"none","ruby":[[5,1,"かれ"],[8,1,"かみ"],[10,1,"たい"],[13,2,"ねっしん"],[30,2,"ねっしん"],[33,1,"ふか"],[35,2,"ちしき"]],"text":"わたしは、彼らが神に対して熱心であることはあかしするが、その熱心は深い知識によるものではない。"},{"ref":"Rom.10.3","start":45010003,"end":45010003,"break":"none","ruby":[[5,1,"かれ"],[8,1,"かみ"],[10,1,"ぎ"],[12,1,"し"],[18,2,"じぶん"],[21,1,"ぎ"],[23,1,"た"],[28,1,"つと"],[31,1,"かみ"],[33,1,"ぎ"],[35,1,"したが"]],"text":"なぜなら、彼らは神の義を知らないで、自分の義を立てようと努め、神の義に従わなかったからである。"},{"ref":"Rom.10.4","start":45010004,"end":45010004,"break":"none","ruby":[[9,1,"しん"],[12,1,"もの"],[14,1,"ぎ"],[16,1,"え"],[24,2,"りっぽう"],[27,1,"おわ"]],"text":"キリストは、すべて信じる者に義を得させるために、律法の終りとなられたのである。"},{"ref":"Rom.10.5","start":45010005,"end":45010005,"break":"paragraph","ruby":[[5,2,"りっぽう"],[10,1,"ぎ"],[12,1,"おこな"],[14,1,"ひと"],[19,1,"ぎ"],[24,1,"い"],[29,1,"か"]],"text":"モーセは、律法による義を行う人は、その義によって生きる、と書いている。"},{"ref":"Rom.10.6","start":45010006,"end":45010006,"break":"none","ruby":[[4,2,"しんこう"],[9,1,"ぎ"],[14,1,"い"],[25,1,"こころ"],[34,1,"てん"],[36,1,"のぼ"],[44,1,"い"],[58,1,"ひ"],[60,1,"お"]],"text":"しかし、信仰による義は、こう言っている、「あなたは心のうちで、だれが天に上るであろうかと言うな」。それは、キリストを引き降ろすことである。"},{"ref":"Rom.10.7","start":45010007,"end":45010007,"break":"none","ruby":[[7,1,"そこ"],[8,1,"し"],[11,1,"ところ"],[13,1,"くだ"],[21,1,"い"],[35,2,"しにん"],[38,1,"なか"],[41,1,"ひ"],[43,1,"あ"]],"text":"また、「だれが底知れぬ所に下るであろうかと言うな」。それは、キリストを死人の中から引き上げることである。"},{"ref":"Rom.10.8","start":45010008,"end":45010008,"break":"none","ruby":[[6,1,"い"],[14,2,"ことば"],[21,1,"ちか"],[31,1,"くち"],[36,1,"こころ"],[44,2,"ことば"],[55,1,"の"],[57,1,"つた"],[62,2,"しんこう"],[65,2,"ことば"]],"text":"では、なんと言っているか。「言葉はあなたの近くにある。あなたの口にあり、心にある」。この言葉とは、わたしたちが宣べ伝えている信仰の言葉である。"},{"ref":"Rom.10.9","start":45010009,"end":45010009,"break":"none","ruby":[[5,2,"じぶん"],[8,1,"くち"],[15,1,"しゅ"],[20,2,"こくはく"],[24,2,"じぶん"],[27,1,"こころ"],[30,1,"かみ"],[32,2,"しにん"],[35,1,"なか"],[50,1,"しん"],[60,1,"すく"]],"text":"すなわち、自分の口で、イエスは主であると告白し、自分の心で、神が死人の中からイエスをよみがえらせたと信じるなら、あなたは救われる。"},{"ref":"Rom.10.10","start":45010010,"end":45010010,"break":"none","ruby":[[5,1,"ひと"],[7,1,"こころ"],[9,1,"しん"],[12,1,"ぎ"],[17,1,"くち"],[19,2,"こくはく"],[23,1,"すく"]],"text":"なぜなら、人は心に信じて義とされ、口で告白して救われるからである。"},{"ref":"Rom.10.11","start":45010011,"end":45010011,"break":"none","ruby":[[0,2,"せいしょ"],[8,1,"かれ"],[10,1,"しん"],[13,1,"もの"],[16,2,"しつぼう"],[19,1,"おわ"],[28,1,"い"]],"text":"聖書は、「すべて彼を信じる者は、失望に終ることがない」と言っている。"},{"ref":"Rom.10.12","start":45010012,"end":45010012,"break":"none","ruby":[[3,1,"じん"],[9,1,"じん"],[12,2,"さべつ"],[18,2,"どういつ"],[21,1,"しゅ"],[23,2,"ばんみん"],[26,1,"しゅ"],[32,1,"かれ"],[34,1,"よ"],[36,1,"もと"],[43,1,"ひと"],[45,1,"ゆた"],[48,1,"めぐ"],[51,1,"くだ"]],"text":"ユダヤ人とギリシヤ人との差別はない。同一の主が万民の主であって、彼を呼び求めるすべての人を豊かに恵んで下さるからである。"},{"ref":"Rom.10.13","start":45010013,"end":45010013,"break":"none","ruby":[[6,1,"しゅ"],[8,2,"みな"],[11,1,"よ"],[13,1,"もと"],[16,1,"もの"],[22,1,"すく"]],"text":"なぜなら、「主の御名を呼び求める者は、すべて救われる」とあるからである。"},{"ref":"Rom.10.14","start":45010014,"end":45010014,"break":"paragraph","ruby":[[4,1,"しん"],[12,1,"もの"],[19,1,"よ"],[21,1,"もと"],[32,1,"き"],[40,1,"もの"],[47,1,"しん"],[58,1,"の"],[60,1,"つた"],[63,1,"もの"],[75,1,"き"]],"text":"しかし、信じたことのない者を、どうして呼び求めることがあろうか。聞いたことのない者を、どうして信じることがあろうか。宣べ伝える者がいなくては、どうして聞くことがあろうか。"},{"ref":"Rom.10.15","start":45010015,"end":45010015,"break":"none","ruby":[[14,1,"の"],[16,1,"つた"],[31,1,"うるわ"],[37,1,"よ"],[44,1,"つ"],[47,1,"もの"],[49,1,"あし"],[53,1,"か"]],"text":"つかわされなくては、どうして宣べ伝えることがあろうか。「ああ、麗しいかな、良きおとずれを告げる者の足は」と書いてあるとおりである。"},{"ref":"Rom.10.16","start":45010016,"end":45010016,"break":"none","ruby":[[8,1,"ひと"],[10,2,"ふくいん"],[13,1,"き"],[15,1,"したが"],[30,1,"しゅ"],[43,1,"き"],[49,1,"しん"],[57,1,"い"]],"text":"しかし、すべての人が福音に聞き従ったのではない。イザヤは、「主よ、だれがわたしたちから聞いたことを信じましたか」と言っている。"},{"ref":"Rom.10.17","start":45010017,"end":45010017,"break":"none","ruby":[[6,2,"しんこう"],[9,1,"き"],[21,1,"き"],[31,2,"ことば"],[35,1,"く"]],"text":"したがって、信仰は聞くことによるのであり、聞くことはキリストの言葉から来るのである。"},{"ref":"Rom.10.18","start":45010018,"end":45010018,"break":"none","breaks":[[32,"stanza"],[47,"line"]],"ruby":[[7,1,"い"],[10,1,"かれ"],[14,1,"きこ"],[27,1,"いな"],[35,1,"こえ"],[37,1,"ぜん"],[38,1,"ち"],[49,2,"ことば"],[52,2,"せかい"],[60,1,"およ"]],"text":"しかしわたしは言う、彼らには聞えなかったのであろうか。否、むしろ「その声は全地にひびきわたり、その言葉は世界のはてにまで及んだ」。"},{"ref":"Rom.10.19","start":45010019,"end":45010019,"break":"none","breaks":[[41,"stanza"],[53,"line"],[71,"line"],[81,"line"]],"ruby":[[7,1,"い"],[16,1,"し"],[35,1,"い"],[53,2,"こくみん"],[58,1,"もの"],[60,1,"たい"],[67,1,"おこ"],[71,2,"むち"],[74,2,"こくみん"],[77,1,"たい"],[81,1,"いか"]],"text":"なお、わたしは言う、イスラエルは知らなかったのであろうか。まずモーセは言っている、「わたしはあなたがたに、国民でない者に対してねたみを起させ、無知な国民に対して、怒りをいだかせるであろう」。"},{"ref":"Rom.10.20","start":45010020,"end":45010020,"break":"none","breaks":[[13,"stanza"],[37,"line"]],"ruby":[[4,2,"だいたん"],[7,1,"い"],[23,1,"もと"],[27,1,"もの"],[31,1,"み"],[41,1,"たず"],[45,1,"もの"],[48,2,"じぶん"],[51,1,"あらわ"]],"text":"イザヤも大胆に言っている、「わたしは、わたしを求めない者たちに見いだされ、わたしを尋ねない者に、自分を現した」。"},{"ref":"Rom.10.21","start":45010021,"end":45010021,"break":"none","breaks":[[15,"stanza"],[32,"line"]],"ruby":[[20,2,"ふくじゅう"],[25,2,"はんこう"],[29,1,"たみ"],[32,2,"しゅうじつ"],[38,1,"て"],[42,1,"の"],[49,1,"い"]],"text":"そして、イスラエルについては、「わたしは服従せずに反抗する民に、終日わたしの手をさし伸べていた」と言っている。"}]