[{"ref":"Rom.5.1","start":45005001,"end":45005001,"break":"paragraph","ruby":[[13,2,"しんこう"],[19,1,"ぎ"],[35,1,"しゅ"],[48,1,"かみ"],[50,1,"たい"],[53,2,"へいわ"],[56,1,"え"]],"text":"このように、わたしたちは、信仰によって義とされたのだから、わたしたちの主イエス・キリストにより、神に対して平和を得ている。"},{"ref":"Rom.5.2","start":45005002,"end":45005002,"break":"none","ruby":[[10,1,"かれ"],[17,1,"た"],[24,1,"めぐ"],[27,2,"しんこう"],[33,1,"みちび"],[35,1,"い"],[44,1,"かみ"],[46,2,"えいこう"],[53,2,"きぼう"],[59,1,"よろこ"]],"text":"わたしたちは、さらに彼により、いま立っているこの恵みに信仰によって導き入れられ、そして、神の栄光にあずかる希望をもって喜んでいる。"},{"ref":"Rom.5.3","start":45005003,"end":45005003,"break":"none","ruby":[[9,2,"かんなん"],[13,1,"よろこ"],[24,2,"かんなん"],[27,2,"にんたい"],[30,1,"う"],[32,1,"だ"]],"text":"それだけではなく、患難をも喜んでいる。なぜなら、患難は忍耐を生み出し、"},{"ref":"Rom.5.4","start":45005004,"end":45005004,"break":"none","ruby":[[0,2,"にんたい"],[3,2,"れんたつ"],[6,1,"う"],[8,1,"だ"],[11,2,"れんたつ"],[14,2,"きぼう"],[17,1,"う"],[19,1,"だ"],[25,1,"し"]],"text":"忍耐は錬達を生み出し、錬達は希望を生み出すことを、知っているからである。"},{"ref":"Rom.5.5","start":45005005,"end":45005005,"break":"none","ruby":[[4,2,"きぼう"],[7,2,"しつぼう"],[10,1,"おわ"],[29,1,"たま"],[35,2,"せいれい"],[42,1,"かみ"],[44,1,"あい"],[52,1,"こころ"],[54,1,"そそ"]],"text":"そして、希望は失望に終ることはない。なぜなら、わたしたちに賜わっている聖霊によって、神の愛がわたしたちの心に注がれているからである。"},{"ref":"Rom.5.6","start":45005006,"end":45005006,"break":"none","ruby":[[8,1,"よわ"],[21,1,"とき"],[27,3,"ふしんじん"],[31,1,"もの"],[38,1,"し"],[41,1,"くだ"]],"text":"わたしたちがまだ弱かったころ、キリストは、時いたって、不信心な者たちのために死んで下さったのである。"},{"ref":"Rom.5.7","start":45005007,"end":45005007,"break":"none","ruby":[[0,1,"ただ"],[3,1,"ひと"],[8,1,"し"],[10,1,"もの"],[25,2,"ぜんにん"],[33,1,"すす"],[36,1,"し"],[38,1,"もの"]],"text":"正しい人のために死ぬ者は、ほとんどいないであろう。善人のためには、進んで死ぬ者もあるいはいるであろう。"},{"ref":"Rom.5.8","start":45005008,"end":45005008,"break":"none","ruby":[[6,2,"つみびと"],[12,1,"とき"],[28,1,"し"],[31,1,"くだ"],[42,1,"かみ"],[50,1,"たい"],[53,1,"あい"],[55,1,"しめ"]],"text":"しかし、まだ罪人であった時、わたしたちのためにキリストが死んで下さったことによって、神はわたしたちに対する愛を示されたのである。"},{"ref":"Rom.5.9","start":45005009,"end":45005009,"break":"none","ruby":[[12,1,"ち"],[17,1,"いま"],[19,1,"ぎ"],[36,1,"かれ"],[41,1,"かみ"],[43,1,"いか"],[47,1,"すく"]],"text":"わたしたちは、キリストの血によって今は義とされているのだから、なおさら、彼によって神の怒りから救われるであろう。"},{"ref":"Rom.5.10","start":45005010,"end":45005010,"break":"none","ruby":[[9,1,"てき"],[14,1,"とき"],[19,2,"みこ"],[22,1,"し"],[27,1,"かみ"],[30,2,"わかい"],[33,1,"う"],[41,2,"わかい"],[44,1,"う"],[49,1,"いま"],[57,1,"かれ"],[66,1,"すく"]],"text":"もし、わたしたちが敵であった時でさえ、御子の死によって神との和解を受けたとすれば、和解を受けている今は、なおさら、彼のいのちによって救われるであろう。"},{"ref":"Rom.5.11","start":45005011,"end":45005011,"break":"none","ruby":[[17,1,"いま"],[19,2,"わかい"],[22,1,"え"],[26,1,"くだ"],[36,1,"しゅ"],[50,1,"かみ"],[52,1,"よろこ"]],"text":"そればかりではなく、わたしたちは、今や和解を得させて下さったわたしたちの主イエス・キリストによって、神を喜ぶのである。"},{"ref":"Rom.5.12","start":45005012,"end":45005012,"break":"paragraph","ruby":[[13,1,"ひと"],[19,1,"つみ"],[23,1,"よ"],[31,1,"つみ"],[36,1,"し"],[57,1,"ひと"],[59,1,"つみ"],[61,1,"おか"],[67,1,"し"],[69,1,"ぜん"],[70,2,"じんるい"],[76,1,"こ"]],"text":"このようなわけで、ひとりの人によって、罪がこの世にはいり、また罪によって死がはいってきたように、こうして、すべての人が罪を犯したので、死が全人類にはいり込んだのである。"},{"ref":"Rom.5.13","start":45005013,"end":45005013,"break":"none","ruby":[[6,2,"りっぽう"],[8,2,"いぜん"],[12,1,"つみ"],[14,1,"よ"],[21,2,"りっぽう"],[29,1,"つみ"],[31,1,"つみ"],[35,1,"みと"]],"text":"というのは、律法以前にも罪は世にあったが、律法がなければ、罪は罪として認められないのである。"},{"ref":"Rom.5.14","start":45005014,"end":45005014,"break":"none","ruby":[[15,1,"あいだ"],[26,2,"いはん"],[29,1,"おな"],[34,1,"つみ"],[36,1,"おか"],[42,1,"もの"],[45,1,"し"],[47,2,"しはい"],[50,1,"まぬが"],[69,1,"もの"],[71,1,"かた"]],"text":"しかし、アダムからモーセまでの間においても、アダムの違反と同じような罪を犯さなかった者も、死の支配を免れなかった。このアダムは、きたるべき者の型である。"},{"ref":"Rom.5.15","start":45005015,"end":45005015,"break":"none","ruby":[[4,1,"めぐ"],[7,2,"たまもの"],[10,2,"ざいか"],[13,2,"ばあい"],[17,1,"こと"],[35,2,"ざいか"],[41,1,"おお"],[44,1,"ひと"],[46,1,"し"],[58,1,"かみ"],[60,1,"めぐ"],[68,1,"ひと"],[78,1,"めぐ"],[83,2,"たまもの"],[91,1,"ゆた"],[94,1,"おお"],[97,2,"ひとびと"],[100,1,"み"]],"text":"しかし、恵みの賜物は罪過の場合とは異なっている。すなわち、もしひとりの罪過のために多くの人が死んだとすれば、まして、神の恵みと、ひとりの人イエス・キリストの恵みによる賜物とは、さらに豊かに多くの人々に満ちあふれたはずではないか。"},{"ref":"Rom.5.16","start":45005016,"end":45005016,"break":"none","ruby":[[5,2,"たまもの"],[13,1,"おか"],[16,1,"つみ"],[18,2,"けっか"],[22,1,"こと"],[38,2,"ばあい"],[46,2,"ざいか"],[51,1,"つみ"],[53,1,"さだ"],[64,1,"めぐ"],[67,2,"ばあい"],[72,1,"おお"],[75,1,"ひと"],[77,2,"ざいか"],[82,1,"ぎ"],[86,2,"けっか"]],"text":"かつ、この賜物は、ひとりの犯した罪の結果とは異なっている。なぜなら、さばきの場合は、ひとりの罪過から、罪に定めることになったが、恵みの場合には、多くの人の罪過から、義とする結果になるからである。"},{"ref":"Rom.5.17","start":45005017,"end":45005017,"break":"none","ruby":[[7,2,"ざいか"],[24,1,"し"],[26,2,"しはい"],[31,1,"いた"],[51,1,"めぐ"],[54,1,"ぎ"],[56,2,"たまもの"],[60,1,"う"],[65,1,"もの"],[98,2,"ちからづよ"],[101,2,"しはい"]],"text":"もし、ひとりの罪過によって、そのひとりをとおして死が支配するに至ったとすれば、まして、あふれるばかりの恵みと義の賜物とを受けている者たちは、ひとりのイエス・キリストをとおし、いのちにあって、さらに力強く支配するはずではないか。"},{"ref":"Rom.5.18","start":45005018,"end":45005018,"break":"none","ruby":[[13,2,"ざいか"],[23,1,"ひと"],[25,1,"つみ"],[27,1,"さだ"],[40,1,"ぎ"],[43,2,"こうい"],[54,1,"え"],[58,1,"ぎ"],[64,1,"ひと"],[66,1,"およ"]],"text":"このようなわけで、ひとりの罪過によってすべての人が罪に定められたように、ひとりの義なる行為によって、いのちを得させる義がすべての人に及ぶのである。"},{"ref":"Rom.5.19","start":45005019,"end":45005019,"break":"none","ruby":[[9,1,"ひと"],[11,1,"ふ"],[12,2,"じゅうじゅん"],[19,1,"おお"],[22,1,"ひと"],[24,2,"つみびと"],[31,1,"おな"],[41,2,"じゅうじゅん"],[48,1,"おお"],[51,1,"ひと"],[53,2,"ぎじん"]],"text":"すなわち、ひとりの人の不従順によって、多くの人が罪人とされたと同じように、ひとりの従順によって、多くの人が義人とされるのである。"},{"ref":"Rom.5.20","start":45005020,"end":45005020,"break":"none","ruby":[[0,2,"りっぽう"],[6,1,"こ"],[14,2,"ざいか"],[17,1,"ま"],[19,1,"くわ"],[32,1,"つみ"],[34,1,"ま"],[36,1,"くわ"],[46,1,"めぐ"],[53,1,"み"]],"text":"律法がはいり込んできたのは、罪過の増し加わるためである。しかし、罪の増し加わったところには、恵みもますます満ちあふれた。"},{"ref":"Rom.5.21","start":45005021,"end":45005021,"break":"none","ruby":[[4,1,"つみ"],[6,1,"し"],[11,2,"しはい"],[16,1,"いた"],[23,1,"めぐ"],[28,1,"ぎ"],[33,2,"しはい"],[43,1,"しゅ"],[56,2,"えいえん"],[63,1,"え"]],"text":"それは、罪が死によって支配するに至ったように、恵みもまた義によって支配し、わたしたちの主イエス・キリストにより、永遠のいのちを得させるためである。"}]