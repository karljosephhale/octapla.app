[{"ref":"1Chr.15.1","start":13015001,"end":13015001,"break":"paragraph","ruby":[[8,1,"まち"],[13,2,"じぶん"],[19,1,"いえ"],[21,1,"た"],[26,1,"かみ"],[28,1,"はこ"],[33,1,"ところ"],[35,1,"そな"],[44,2,"まくや"],[47,1,"は"]],"text":"ダビデはダビデの町のうちに自分のために家を建て、また神の箱のために所を備え、これがために幕屋を張った。"},{"ref":"1Chr.15.2","start":13015002,"end":13015002,"break":"none","ruby":[[4,1,"い"],[9,1,"かみ"],[11,1,"はこ"],[17,1,"もの"],[31,1,"しゅ"],[33,1,"しゅ"],[35,1,"はこ"],[43,1,"しゅ"],[45,1,"なが"],[47,1,"つか"],[55,1,"かれ"],[58,1,"えら"]],"text":"ダビデは言った、「神の箱をかくべき者はただレビびとのみである。主が主の箱をかかせ、また主に長く仕えさせるために彼らを選ばれたからである」。"},{"ref":"1Chr.15.3","start":13015003,"end":13015003,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"はこ"],[14,1,"そな"],[17,1,"ところ"],[21,1,"のぼ"],[43,1,"あつ"]],"text":"ダビデは主の箱をこれがために備えた所にかき上るため、イスラエルをことごとくエルサレムに集めた。"},{"ref":"1Chr.15.4","start":13015004,"end":13015004,"break":"none","ruby":[[10,2,"しそん"],[18,1,"あつ"]],"text":"ダビデはまたアロンの子孫とレビびとを集めた。"},{"ref":"1Chr.15.5","start":13015005,"end":13015005,"break":"none","ruby":[[9,2,"しそん"],[22,1,"ちょう"],[28,2,"きょうだい"],[33,1,"にん"]],"text":"すなわち、コハテの子孫のうちからはウリエルを長としてその兄弟百二十人、"},{"ref":"1Chr.15.6","start":13015006,"end":13015006,"break":"none","ruby":[[4,2,"しそん"],[16,1,"ちょう"],[22,2,"きょうだい"],[28,1,"にん"]],"text":"メラリの子孫のうちからはアサヤを長としてその兄弟二百二十人、"},{"ref":"1Chr.15.7","start":13015007,"end":13015007,"break":"none","ruby":[[6,2,"しそん"],[18,1,"ちょう"],[24,2,"きょうだい"],[29,1,"にん"]],"text":"ゲルショムの子孫のうちからはヨエルを長としてその兄弟百三十人、"},{"ref":"1Chr.15.8","start":13015008,"end":13015008,"break":"none","ruby":[[6,2,"しそん"],[18,1,"ちょう"],[24,2,"きょうだい"],[28,1,"にん"]],"text":"エリザパンの子孫のうちからはシマヤを長としてその兄弟二百人、"},{"ref":"1Chr.15.9","start":13015009,"end":13015009,"break":"none","ruby":[[5,2,"しそん"],[18,1,"ちょう"],[24,2,"きょうだい"],[28,1,"にん"]],"text":"ヘブロンの子孫のうちからはエリエルを長としてその兄弟八十人、"},{"ref":"1Chr.15.10","start":13015010,"end":13015010,"break":"none","ruby":[[5,2,"しそん"],[19,1,"ちょう"],[25,2,"きょうだい"],[30,1,"にん"]],"text":"ウジエルの子孫のうちからはアミナダブを長としてその兄弟百十二人である。"},{"ref":"1Chr.15.11","start":13015011,"end":13015011,"break":"none","ruby":[[4,2,"さいし"],[51,1,"め"]],"text":"ダビデは祭司ザドクとアビヤタル、およびレビびとウリエル、アサヤ、ヨエル、シマヤ、エリエル、アミナダブを召し、"},{"ref":"1Chr.15.12","start":13015012,"end":13015012,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[19,2,"しぞく"],[22,1,"ちょう"],[39,2,"きょうだい"],[45,1,"み"],[47,1,"きよ"],[56,1,"かみ"],[58,1,"しゅ"],[60,1,"はこ"],[71,1,"そな"],[74,1,"ところ"],[78,1,"のぼ"]],"text":"彼らに言った、「あなたがたはレビびとの氏族の長である。あなたがたとあなたがたの兄弟はともに身を清め、イスラエルの神、主の箱をわたしがそのために備えた所にかき上りなさい。"},{"ref":"1Chr.15.13","start":13015013,"end":13015013,"break":"none","ruby":[[9,1,"もの"],[29,1,"かみ"],[31,1,"しゅ"],[38,1,"う"],[55,1,"さだ"],[66,1,"あつか"]],"text":"さきにこれをかいた者があなたがたでなかったので、われわれの神、主はわれわれを撃たれました。これはわれわれがその定めにしたがってそれを扱わなかったからです」。"},{"ref":"1Chr.15.14","start":13015014,"end":13015014,"break":"none","ruby":[[3,2,"さいし"],[21,1,"かみ"],[23,1,"しゅ"],[25,1,"はこ"],[29,1,"のぼ"],[34,1,"み"],[36,1,"きよ"]],"text":"そこで祭司たちとレビびとたちはイスラエルの神、主の箱をかき上るために身を清め、"},{"ref":"1Chr.15.15","start":13015015,"end":13015015,"break":"none","ruby":[[11,1,"しゅ"],[13,2,"ことば"],[21,1,"めい"],[28,1,"かみ"],[30,1,"はこ"],[38,1,"かた"]],"text":"レビびとたちはモーセが主の言葉にしたがって命じたように、神の箱をさおをもって肩にになった。"},{"ref":"1Chr.15.16","start":13015016,"end":13015016,"break":"paragraph","ruby":[[11,1,"ちょう"],[18,2,"きょうだい"],[23,1,"えら"],[26,1,"うた"],[30,1,"もの"],[35,2,"たてごと"],[38,1,"こと"],[47,2,"がっき"],[50,1,"う"],[56,1,"よろこ"],[59,1,"こえ"],[67,1,"めい"]],"text":"ダビデはまたレビびとの長たちに、その兄弟たちを選んで歌うたう者となし、立琴と琴とシンバルなどの楽器を打ちはやし、喜びの声をあげることを命じた。"},{"ref":"1Chr.15.17","start":13015017,"end":13015017,"break":"none","ruby":[[12,1,"こ"],[20,2,"きょうだい"],[27,1,"こ"],[38,2,"しそん"],[43,1,"かれ"],[46,2,"きょうだい"],[53,1,"こ"],[58,1,"えら"]],"text":"そこでレビびとはヨエルの子ヘマンと、その兄弟ベレキヤの子アサフおよびメラリの子孫である彼らの兄弟クシャヤの子エタンを選んだ。"},{"ref":"1Chr.15.18","start":13015018,"end":13015018,"break":"none","ruby":[[5,1,"つ"],[9,2,"きょうだい"],[17,1,"とも"],[84,1,"もん"],[86,1,"まも"],[88,1,"もの"]],"text":"またこれに次ぐその兄弟たちがこれと共にいた。すなわちゼカリヤ、ヤジエル、セミラモテ、エイエル、ウンニ、エリアブ、ベナヤ、マアセヤ、マッタテヤ、エリペレホ、ミクネヤおよび門を守る者オベデ・エドムとエイエル。"},{"ref":"1Chr.15.19","start":13015019,"end":13015019,"break":"none","ruby":[[0,1,"うた"],[4,1,"もの"],[19,2,"せいどう"],[27,1,"う"],[32,1,"もの"]],"text":"歌うたう者ヘマン、アサフおよびエタンは青銅のシンバルを打ちはやす者であった。"},{"ref":"1Chr.15.20","start":13015020,"end":13015020,"break":"none","ruby":[[49,2,"たてごと"],[52,1,"そう"],[55,1,"もの"]],"text":"ゼカリヤ、アジエル、セミラモテ、エイエル、ウンニ、エリアブ、マアセヤ、ベナヤはアラモテにしたがって立琴を奏する者であった。"},{"ref":"1Chr.15.21","start":13015021,"end":13015021,"break":"none","ruby":[[48,1,"こと"],[53,2,"しき"],[57,1,"もの"]],"text":"しかしマッタテヤ、エリペレホ、ミクネヤ、オベデ・エドム、エイエル、アザジヤはセミニテにしたがって琴をもって指揮する者であった。"},{"ref":"1Chr.15.22","start":13015022,"end":13015022,"break":"none","ruby":[[10,2,"がくちょう"],[14,2,"おんがく"],[17,1,"つう"],[28,2,"しき"]],"text":"ケナニヤはレビびとの楽長で、音楽に通じていたので、これを指揮した。"},{"ref":"1Chr.15.23","start":13015023,"end":13015023,"break":"none","ruby":[[10,1,"はこ"],[15,1,"もん"],[17,1,"まも"],[19,1,"もの"]],"text":"ベレキヤとエルカナは箱のために門を守る者であった。"},{"ref":"1Chr.15.24","start":13015024,"end":13015024,"break":"none","ruby":[[0,2,"さいし"],[39,1,"かみ"],[41,1,"はこ"],[43,1,"まえ"],[49,1,"ふ"],[64,1,"はこ"],[69,1,"もん"],[71,1,"まも"],[73,1,"もの"]],"text":"祭司シバニヤ、ヨシャパテ、ネタネル、アマサイ、ゼカリヤ、ベナヤ、エリエゼルらは神の箱の前でラッパを吹き、オベデ・エドムとエヒアは箱のために門を守る者であった。"},{"ref":"1Chr.15.25","start":13015025,"end":13015025,"break":"paragraph","ruby":[[10,2,"ちょうろう"],[18,1,"にん"],[20,1,"ちょう"],[24,1,"い"],[36,1,"いえ"],[39,1,"しゅ"],[41,2,"けいやく"],[44,1,"はこ"],[46,1,"よろこ"],[48,1,"いさ"],[53,1,"のぼ"]],"text":"ダビデとイスラエルの長老たちおよび千人の長たちは行って、オベデ・エドムの家から主の契約の箱を喜び勇んでかき上った。"},{"ref":"1Chr.15.26","start":13015026,"end":13015026,"break":"none","ruby":[[0,1,"かみ"],[2,1,"しゅ"],[4,2,"けいやく"],[7,1,"はこ"],[16,1,"たす"],[24,1,"かれ"],[27,2,"おうし"],[30,1,"とう"],[32,2,"おひつじ"],[35,1,"とう"]],"text":"神が主の契約の箱をかくレビびとを助けられたので、彼らは雄牛七頭、雄羊七頭をささげた。"},{"ref":"1Chr.15.27","start":13015027,"end":13015027,"break":"none","ruby":[[4,2,"あま"],[6,1,"ぬの"],[8,2,"いふく"],[11,1,"き"],[16,1,"はこ"],[30,1,"うた"],[34,1,"もの"],[36,2,"おんがく"],[49,2,"どうよう"],[61,2,"あま"],[63,1,"ぬの"],[69,1,"き"]],"text":"ダビデは亜麻布の衣服を着ていた。箱をかくすべてのレビびとは、歌うたう者、音楽をつかさどるケナニヤも同様である。ダビデはまた亜麻布のエポデを着ていた。"},{"ref":"1Chr.15.28","start":13015028,"end":13015028,"break":"none","ruby":[[10,1,"みな"],[12,1,"こえ"],[17,2,"つのぶえ"],[20,1,"ふ"],[37,2,"たてごと"],[40,1,"こと"],[45,1,"う"],[51,1,"しゅ"],[53,2,"けいやく"],[56,1,"はこ"],[60,1,"のぼ"]],"text":"こうしてイスラエルは皆、声をあげ、角笛を吹きならし、ラッパと、シンバルと、立琴と琴をもって打ちはやして主の契約の箱をかき上った。"},{"ref":"1Chr.15.29","start":13015029,"end":13015029,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"けいやく"],[5,1,"はこ"],[11,1,"まち"],[24,1,"むすめ"],[29,1,"まど"],[39,1,"おう"],[41,1,"ま"],[43,1,"おど"],[47,1,"み"],[50,1,"こころ"],[55,1,"かれ"]],"text":"主の契約の箱がダビデの町にはいったとき、サウルの娘ミカルが窓からながめ、ダビデ王の舞い踊るのを見て、心のうちに彼をいやしめた。"}]