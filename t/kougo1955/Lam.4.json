[{"ref":"Lam.4.1","start":25004001,"end":25004001,"break":"paragraph","breaks":[[11,"line"],[19,"line"],[24,"line"]],"ruby":[[3,2,"おうごん"],[6,1,"ひかり"],[8,1,"うしな"],[11,2,"じゅんきん"],[14,1,"いろ"],[16,1,"へん"],[19,2,"せいじょ"],[22,1,"いし"],[35,1,"な"],[37,1,"す"]],"text":"ああ、黄金は光を失い、純金は色を変じ、聖所の石はすべてのちまたのかどに投げ捨てられた。"},{"ref":"Lam.4.2","start":25004002,"end":25004002,"break":"line","breaks":[[22,"line"]],"ruby":[[3,1,"せい"],[4,1,"きん"],[7,1,"ひ"],[18,1,"ご"],[22,2,"とうき"],[24,1,"し"],[26,1,"て"],[33,1,"つち"],[35,1,"うつわ"]],"text":"ああ、精金にも比すべきシオンのいとし子らは、陶器師の手のわざである土の器のようにみなされる。"},{"ref":"Lam.4.3","start":25004003,"end":25004003,"break":"line","breaks":[[24,"line"],[36,"line"]],"ruby":[[0,2,"やまいぬ"],[5,1,"ち"],[15,1,"こ"],[17,1,"ちち"],[19,1,"の"],[31,1,"たみ"],[33,1,"むすめ"],[36,2,"あらの"],[47,3,"むじひ"]],"text":"山犬さえも乳ぶさをたれて、その子に乳を飲ませる。ところが、わが民の娘は、荒野のだちょうのように無慈悲になった。"},{"ref":"Lam.4.4","start":25004004,"end":25004004,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"ち"],[3,1,"ご"],[5,1,"した"],[12,1,"うえ"],[23,1,"おさ"],[25,1,"ご"],[31,1,"もと"],[39,1,"あた"],[42,1,"もの"]],"text":"乳のみ子の舌はかわいて、上あごに、ひたとつき、幼な子らはパンを求めても、これに与える者がない。"},{"ref":"Lam.4.5","start":25004005,"end":25004005,"break":"line","breaks":[[13,"line"],[26,"line"],[39,"line"]],"ruby":[[3,1,"もの"],[5,1,"た"],[10,1,"もの"],[13,1,"お"],[26,1,"むらさき"],[28,2,"きもの"],[31,1,"そだ"],[36,1,"もの"],[39,1,"いま"],[41,1,"はい"],[46,1,"うえ"],[48,1,"ふ"]],"text":"うまい物を食べていた者は、落ちぶれて、ちまたにおり、紫の着物で育てられた者も、今は灰だまりの上に伏している。"},{"ref":"Lam.4.6","start":25004006,"end":25004006,"break":"line","breaks":[[14,"line"],[28,"line"],[44,"line"]],"ruby":[[2,1,"たみ"],[4,1,"むすめ"],[9,1,"こら"],[18,1,"ばつ"],[22,1,"おお"],[32,1,"むかし"],[34,1,"ひと"],[36,1,"て"],[50,1,"ほろ"]],"text":"わが民の娘のうけた懲しめは、ソドムの罰よりも大きかった。ソドムは昔、人の手によらないで、またたくまに滅ぼされたのだ。"},{"ref":"Lam.4.7","start":25004007,"end":25004007,"break":"line","breaks":[[17,"line"],[24,"line"],[40,"line"]],"ruby":[[2,1,"たみ"],[4,1,"きみ"],[8,1,"ゆき"],[12,1,"きよ"],[17,1,"ちち"],[21,1,"しろ"],[37,1,"あか"],[42,1,"すがた"],[44,1,"うつく"]],"text":"わが民の君たちは雪よりも清らかに、乳よりも白く、そのからだは、さんごよりも赤く、その姿の美しさはサファイヤのようであった。"},{"ref":"Lam.4.8","start":25004008,"end":25004008,"break":"line","breaks":[[14,"line"],[28,"line"],[41,"line"]],"ruby":[[0,1,"いま"],[4,1,"かお"],[11,1,"くろ"],[14,1,"まち"],[16,1,"なか"],[21,1,"ひと"],[23,1,"し"],[30,2,"ひふ"],[33,1,"ちぢ"],[36,1,"ほね"],[45,1,"か"],[47,1,"き"]],"text":"今はその顔はすすよりも黒く、町の中にいても人に知られず、その皮膚は縮んで骨につき、かわいて枯れ木のようになった。"},{"ref":"Lam.4.9","start":25004009,"end":25004009,"break":"line","breaks":[[11,"line"],[28,"line"],[44,"line"]],"ruby":[[4,1,"ころ"],[8,1,"もの"],[11,1,"う"],[14,1,"し"],[16,1,"もの"],[28,1,"かれ"],[31,2,"たはた"],[34,2,"さんぶつ"],[37,2,"けつぼう"],[44,1,"さ"],[48,1,"もの"],[53,1,"おとろ"],[55,1,"い"]],"text":"つるぎで殺される者は、飢えて死ぬ者よりもさいわいである。彼らは田畑の産物の欠乏によって、刺された者のように衰え行くからである。"},{"ref":"Lam.4.10","start":25004010,"end":25004010,"break":"line","breaks":[[12,"line"],[22,"line"]],"ruby":[[2,1,"たみ"],[4,1,"むすめ"],[6,1,"ほろ"],[9,1,"とき"],[12,2,"なさけぶか"],[15,1,"おんな"],[22,1,"て"],[26,2,"じぶん"],[29,1,"こ"],[33,1,"に"],[39,2,"しょくもつ"]],"text":"わが民の娘の滅びる時には情深い女たちさえも、手ずから自分の子どもを煮て、それを食物とした。"},{"ref":"Lam.4.11","start":25004011,"end":25004011,"break":"line","breaks":[[16,"line"],[26,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"いきどお"],[12,1,"も"],[16,1,"はげ"],[19,1,"いか"],[30,1,"ひ"],[32,1,"も"],[39,1,"いしずえ"],[43,1,"や"],[45,1,"はら"]],"text":"主はその憤りをことごとく漏らし、激しい怒りをそそぎ、シオンに火を燃やして、その礎までも焼き払われた。"},{"ref":"Lam.4.12","start":25004012,"end":25004012,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[0,1,"ち"],[2,1,"おう"],[7,1,"よ"],[9,1,"たみ"],[21,1,"もん"],[27,1,"てき"],[30,1,"う"],[32,1,"はい"],[37,1,"しん"]],"text":"地の王たちも、世の民らもみな、エルサレムの門に、あだや敵が、討ち入ろうとは信じなかった。"},{"ref":"Lam.4.13","start":25004013,"end":25004013,"break":"line","breaks":[[16,"line"],[33,"line"]],"ruby":[[5,3,"よげんしゃ"],[11,1,"つみ"],[18,2,"さいし"],[23,2,"ふぎ"],[33,1,"かれ"],[36,2,"ぎじん"],[39,1,"ち"],[43,1,"まち"],[45,1,"なか"],[47,1,"なが"],[50,1,"もの"]],"text":"これはその預言者たちの罪のため、その祭司たちの不義のためであった。彼らは義人の血をその町の中に流した者である。"},{"ref":"Lam.4.14","start":25004014,"end":25004014,"break":"line","breaks":[[19,"line"],[27,"line"]],"ruby":[[0,1,"かれ"],[3,2,"もうじん"],[19,1,"ち"],[21,1,"けが"],[32,1,"ころも"]],"text":"彼らは盲人のように、ちまたにさまよい、血で汚れている。だれもその衣にさわることができない。"},{"ref":"Lam.4.15","start":25004015,"end":25004015,"break":"line","breaks":[[24,"line"],[45,"line"],[62,"line"],[83,"line"]],"ruby":[[0,2,"ひとびと"],[3,1,"かれ"],[12,1,"さ"],[25,1,"さ"],[29,1,"さ"],[39,1,"さけ"],[45,1,"かれ"],[48,1,"に"],[50,1,"さ"],[53,3,"ほうろうしゃ"],[62,3,"いほうじん"],[66,1,"なか"],[69,2,"ひとびと"],[83,1,"やど"],[93,1,"い"]],"text":"人々は彼らにむかって、「去れよ、けがらわしい」、「去れよ、去れよ、さわるな」と叫んだので、彼らは逃げ去って放浪者となったが、異邦人の中でも人々は「もうわれわれのうちに宿ってはならない」と言った。"},{"ref":"Lam.4.16","start":25004016,"end":25004016,"break":"line","breaks":[[14,"line"],[23,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"かれ"],[9,1,"ち"],[14,1,"ふたた"],[16,1,"かれ"],[19,1,"かえり"],[23,2,"さいし"],[26,1,"たっと"],[30,2,"ちょうろう"]],"text":"主はみずから彼らを散らして、再び彼らを顧みず、祭司を尊ばず、長老をいたわられなかった。"},{"ref":"Lam.4.17","start":25004017,"end":25004017,"break":"line","breaks":[[20,"line"],[26,"line"],[38,"line"]],"ruby":[[5,1,"め"],[12,1,"たす"],[15,1,"ま"],[17,1,"のぞ"],[20,1,"つか"],[22,1,"おとろ"],[31,1,"ま"],[33,1,"のぞ"],[38,1,"すくい"],[40,1,"あた"],[42,1,"え"],[45,1,"くに"],[49,1,"ま"],[51,1,"のぞ"]],"text":"われわれの目は、むなしく助けを待ち望んで疲れ衰えた。われわれは待ち望んだが、救を与え得ない国びとを待ち望んだ。"},{"ref":"Lam.4.18","start":25004018,"end":25004018,"break":"line","breaks":[[18,"line"],[32,"line"],[44,"line"],[63,"line"]],"ruby":[[0,2,"ひとびと"],[8,1,"あゆ"],[23,2,"じぶん"],[26,1,"まち"],[28,1,"なか"],[32,1,"ある"],[49,1,"おわ"],[52,1,"ちか"],[57,1,"ひ"],[59,1,"つ"],[68,1,"おわ"],[71,1,"き"]],"text":"人々がわれわれの歩みをうかがうので、われわれは自分の町の中をも、歩くことができなかった。われわれの終りは近づいた、日は尽きた。われわれの終りが来たからである。"},{"ref":"Lam.4.19","start":25004019,"end":25004019,"break":"line","breaks":[[21,"line"],[36,"line"]],"ruby":[[5,1,"お"],[7,1,"もの"],[9,1,"そら"],[18,1,"はや"],[21,1,"かれ"],[24,1,"やま"],[31,1,"お"],[33,1,"た"],[36,1,"の"],[43,1,"ま"],[45,1,"ぶ"]],"text":"われわれを追う者は空のはげたかよりも速く、彼らは山でわれわれを追い立て、野でわれわれを待ち伏せる。"},{"ref":"Lam.4.20","start":25004020,"end":25004020,"break":"line","breaks":[[15,"line"],[39,"line"],[54,"line"]],"ruby":[[5,1,"はな"],[7,1,"いき"],[13,1,"もの"],[15,1,"しゅ"],[17,1,"あぶら"],[23,1,"もの"],[26,1,"かれ"],[29,1,"おと"],[31,1,"あな"],[33,1,"とら"],[39,1,"かれ"],[47,3,"いほうじん"],[51,1,"なか"],[56,1,"かげ"],[58,1,"い"],[67,1,"おも"],[70,1,"もの"]],"text":"われわれが鼻の息とたのんだ者、主に油そそがれた者は、彼らの落し穴で捕えられた。彼はわれわれが「異邦人の中でもその陰に生きるであろう」と思った者である。"},{"ref":"Lam.4.21","start":25004021,"end":25004021,"break":"line","breaks":[[14,"line"],[20,"line"],[36,"line"]],"ruby":[[3,1,"ち"],[5,1,"す"],[11,1,"むすめ"],[14,1,"よろこ"],[16,1,"たの"],[27,1,"さかずき"],[33,1,"い"],[40,1,"よ"],[43,1,"はだか"]],"text":"ウズの地に住むエドムの娘よ、喜び楽しめ、あなたにもまた杯がめぐって行く、あなたも酔って裸になる。"},{"ref":"Lam.4.22","start":25004022,"end":25004022,"break":"line","breaks":[[20,"line"],[37,"line"],[56,"line"]],"ruby":[[4,1,"むすめ"],[11,2,"ふぎ"],[14,1,"ばつ"],[16,1,"おわ"],[20,1,"しゅ"],[22,1,"かさ"],[29,1,"とら"],[31,1,"うつ"],[41,1,"むすめ"],[44,1,"しゅ"],[50,2,"ふぎ"],[53,1,"ばっ"],[60,1,"つみ"]],"text":"シオンの娘よ、あなたの不義の罰は終った。主は重ねてあなたを捕え移されない。エドムの娘よ、主はあなたの不義を罰し、あなたの罪をあらわされる。"}]