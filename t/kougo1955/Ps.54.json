[{"ref":"Ps.54.1","start":19054001,"end":19054001,"break":"paragraph","title":"聖歌隊の指揮者によって琴をもってうたわせたダビデのマスキールの歌。これはジフびとがサウルにきて、「ダビデはわれらのうちに隠れている」と言った時によんだもの","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[4,1,"な"],[13,1,"すく"],[17,1,"ちから"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[11,1,"こと"],[31,1,"うた"],[60,1,"かく"],[67,1,"い"],[70,1,"とき"]],"text":"神よ、み名によってわたしを救い、み力によってわたしをさばいてください。"},{"ref":"Ps.54.2","start":19054002,"end":19054002,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かみ"],[7,1,"いのり"],[14,1,"くち"],[16,2,"ことば"],[19,1,"みみ"],[21,1,"かたむ"]],"text":"神よ、わたしの祈をきき、わが口の言葉に耳を傾けてください。"},{"ref":"Ps.54.3","start":19054003,"end":19054003,"break":"line","breaks":[[16,"line"],[37,"line"]],"ruby":[[0,1,"たか"],[3,1,"もの"],[9,1,"さか"],[13,1,"おこ"],[20,1,"もの"],[30,1,"もと"],[37,1,"かれ"],[40,1,"かみ"],[45,1,"まえ"],[47,1,"お"]],"text":"高ぶる者がわたしに逆らって起り、あらぶる者がわたしのいのちを求めています。彼らは神をおのが前に置くことをしません。〔セラ"},{"ref":"Ps.54.4","start":19054004,"end":19054004,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[7,1,"たす"],[12,1,"しゅ"],[20,1,"まも"]],"text":"見よ、神はわが助けぬし、主はわがいのちを守られるかたです。"},{"ref":"Ps.54.5","start":19054005,"end":19054005,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かみ"],[9,1,"わざわい"],[14,1,"むく"],[35,1,"かれ"],[38,1,"ほろ"]],"text":"神はわたしのあだに災をもって報いられるでしょう。あなたのまことをもって彼らを滅ぼしてください。"},{"ref":"Ps.54.6","start":19054006,"end":19054006,"break":"line","breaks":[[22,"line"],[38,"line"]],"ruby":[[4,1,"よろこ"],[22,1,"しゅ"],[30,1,"な"],[32,2,"かんしゃ"],[43,1,"こと"]],"text":"わたしは喜んであなたにいけにえをささげます。主よ、わたしはみ名に感謝します。これはよい事だからです。"},{"ref":"Ps.54.7","start":19054007,"end":19054007,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"なや"],[16,1,"すく"],[23,1,"め"],[25,1,"てき"],[27,2,"はいぼく"],[30,1,"み"]],"text":"あなたはすべての悩みからわたしを救い、わたしの目に敵の敗北を見させられたからです。"}]