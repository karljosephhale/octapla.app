[{"ref":"Ps.112.1","start":19112001,"end":19112001,"break":"paragraph","breaks":[[9,"line"],[26,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"しゅ"],[23,1,"いまし"],[26,1,"おお"],[29,1,"よろこ"],[31,1,"ひと"]],"text":"主をほめたたえよ。主をおそれて、そのもろもろの戒めを大いに喜ぶ人はさいわいである。"},{"ref":"Ps.112.2","start":19112002,"end":19112002,"break":"line","breaks":[[15,"line"]],"ruby":[[2,2,"しそん"],[5,1,"ち"],[10,1,"つよ"],[15,1,"ただ"],[18,1,"もの"],[24,2,"しゅくふく"],[27,1,"え"]],"text":"その子孫は地において強くなり、正しい者のやからは祝福を得る。"},{"ref":"Ps.112.3","start":19112003,"end":19112003,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"はんえい"],[3,1,"とみ"],[8,1,"いえ"],[15,1,"ぎ"]],"text":"繁栄と富とはその家にあり、その義はとこしえに、うせることはない。"},{"ref":"Ps.112.4","start":19112004,"end":19112004,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ひかり"],[2,1,"ただ"],[5,1,"もの"],[10,2,"あんこく"],[13,1,"なか"],[22,1,"しゅ"],[24,1,"めぐ"],[26,1,"ふか"],[34,1,"み"],[37,1,"ただ"]],"text":"光は正しい者のために暗黒の中にもあらわれる。主は恵み深く、あわれみに満ち、正しくいらせられる。"},{"ref":"Ps.112.5","start":19112005,"end":19112005,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"めぐ"],[3,1,"ほどこ"],[6,1,"か"],[16,1,"こと"],[18,1,"ただ"],[21,1,"おこな"],[23,1,"ひと"]],"text":"恵みを施し、貸すことをなし、その事を正しく行う人はさいわいである。"},{"ref":"Ps.112.6","start":19112006,"end":19112006,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"けっ"],[8,1,"うご"],[23,1,"おぼ"]],"text":"正しい人は決して動かされることなく、とこしえに覚えられる。"},{"ref":"Ps.112.7","start":19112007,"end":19112007,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[2,1,"わる"],[9,1,"おそ"],[15,1,"こころ"],[17,1,"しゅ"],[19,2,"しんらい"]],"text":"彼は悪いおとずれを恐れず、その心は主に信頼してゆるがない。"},{"ref":"Ps.112.8","start":19112008,"end":19112008,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"こころ"],[4,1,"お"],[6,1,"つ"],[9,1,"おそ"],[29,1,"ねが"],[32,1,"み"]],"text":"その心は落ち着いて恐れることなく、ついにそのあだについての願いを見る。"},{"ref":"Ps.112.9","start":19112009,"end":19112009,"break":"line","breaks":[[19,"line"],[38,"line"]],"ruby":[[0,1,"かれ"],[2,1,"お"],[7,1,"ほどこ"],[10,1,"まず"],[13,1,"もの"],[15,1,"あた"],[21,1,"ぎ"],[40,1,"つの"],[42,1,"ほまれ"],[44,1,"え"]],"text":"彼は惜しげなく施し、貧しい者に与えた。その義はとこしえに、うせることはない。その角は誉を得てあげられる。"},{"ref":"Ps.112.10","start":19112010,"end":19112010,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[8,1,"み"],[10,1,"いか"],[13,1,"は"],[21,1,"と"],[23,1,"さ"],[26,1,"あ"],[29,1,"もの"],[31,1,"ねが"],[34,1,"ほろ"]],"text":"悪しき者はこれを見て怒り、歯をかみならして溶け去る。悪しき者の願いは滅びる。"}]