[{"ref":"John.15.1","start":43015001,"end":43015001,"break":"paragraph","ruby":[[12,1,"き"],[18,1,"ちち"],[20,2,"のうふ"]],"text":"わたしはまことのぶどうの木、わたしの父は農夫である。"},{"ref":"John.15.2","start":43015002,"end":43015002,"break":"none","ruby":[[11,1,"えだ"],[13,1,"み"],[15,1,"むす"],[23,1,"ちち"],[37,1,"み"],[39,1,"むす"],[48,1,"ゆた"],[51,1,"みの"],[59,2,"てい"]],"text":"わたしにつながっている枝で実を結ばないものは、父がすべてこれをとりのぞき、実を結ぶものは、もっと豊かに実らせるために、手入れしてこれをきれいになさるのである。"},{"ref":"John.15.3","start":43015003,"end":43015003,"break":"none","ruby":[[11,1,"かた"],[14,2,"ことば"],[20,1,"すで"]],"text":"あなたがたは、わたしが語った言葉によって既にきよくされている。"},{"ref":"John.15.4","start":43015004,"end":43015004,"break":"none","ruby":[[39,1,"えだ"],[45,1,"き"],[58,2,"じぶん"],[64,1,"み"],[66,1,"むす"],[99,1,"み"],[101,1,"むす"]],"text":"わたしにつながっていなさい。そうすれば、わたしはあなたがたとつながっていよう。枝がぶどうの木につながっていなければ、自分だけでは実を結ぶことができないように、あなたがたもわたしにつながっていなければ実を結ぶことができない。"},{"ref":"John.15.5","start":43015005,"end":43015005,"break":"none","ruby":[[8,1,"き"],[18,1,"えだ"],[25,1,"ひと"],[47,1,"ひと"],[60,1,"ひと"],[62,1,"み"],[64,1,"ゆた"],[67,1,"むす"],[80,1,"はな"],[91,2,"なにひと"]],"text":"わたしはぶどうの木、あなたがたはその枝である。もし人がわたしにつながっており、またわたしがその人とつながっておれば、その人は実を豊かに結ぶようになる。わたしから離れては、あなたがたは何一つできないからである。"},{"ref":"John.15.6","start":43015006,"end":43015006,"break":"none","ruby":[[0,1,"ひと"],[18,1,"えだ"],[23,1,"そと"],[25,1,"な"],[32,1,"か"],[36,2,"ひとびと"],[44,1,"あつ"],[47,1,"ひ"],[49,1,"な"],[51,1,"い"],[55,1,"や"]],"text":"人がわたしにつながっていないならば、枝のように外に投げすてられて枯れる。人々はそれをかき集め、火に投げ入れて、焼いてしまうのである。"},{"ref":"John.15.7","start":43015007,"end":43015007,"break":"none","ruby":[[22,2,"ことば"],[46,1,"のぞ"],[51,1,"もと"],[64,1,"あた"]],"text":"あなたがたがわたしにつながっており、わたしの言葉があなたがたにとどまっているならば、なんでも望むものを求めるがよい。そうすれば、与えられるであろう。"},{"ref":"John.15.8","start":43015008,"end":43015008,"break":"none","ruby":[[6,1,"み"],[8,1,"ゆた"],[11,1,"むす"],[21,2,"でし"],[41,1,"ちち"],[43,2,"えいこう"],[47,1,"う"]],"text":"あなたがたが実を豊かに結び、そしてわたしの弟子となるならば、それによって、わたしの父は栄光をお受けになるであろう。"},{"ref":"John.15.9","start":43015009,"end":43015009,"break":"none","ruby":[[0,1,"ちち"],[6,1,"あい"],[24,1,"あい"],[36,1,"あい"]],"text":"父がわたしを愛されたように、わたしもあなたがたを愛したのである。わたしの愛のうちにいなさい。"},{"ref":"John.15.10","start":43015010,"end":43015010,"break":"none","ruby":[[11,1,"まも"],[27,1,"あい"],[50,1,"ちち"],[57,1,"まも"],[65,1,"あい"],[74,1,"おな"]],"text":"もしわたしのいましめを守るならば、あなたがたはわたしの愛のうちにおるのである。それはわたしがわたしの父のいましめを守ったので、その愛のうちにおるのと同じである。"},{"ref":"John.15.11","start":43015011,"end":43015011,"break":"none","ruby":[[11,1,"はな"],[21,1,"よろこ"],[34,1,"やど"],[48,1,"よろこ"],[51,1,"み"]],"text":"わたしがこれらのことを話したのは、わたしの喜びがあなたがたのうちにも宿るため、また、あなたがたの喜びが満ちあふれるためである。"},{"ref":"John.15.12","start":43015012,"end":43015012,"break":"paragraph","ruby":[[26,1,"あい"],[39,1,"たがい"],[41,1,"あい"],[43,1,"あ"]],"text":"わたしのいましめは、これである。わたしがあなたがたを愛したように、あなたがたも互に愛し合いなさい。"},{"ref":"John.15.13","start":43015013,"end":43015013,"break":"none","ruby":[[0,1,"ひと"],[4,1,"とも"],[9,2,"じぶん"],[12,1,"いのち"],[14,1,"す"],[25,1,"おお"],[28,1,"あい"]],"text":"人がその友のために自分の命を捨てること、これよりも大きな愛はない。"},{"ref":"John.15.14","start":43015014,"end":43015014,"break":"none","ruby":[[10,1,"めい"],[16,1,"おこな"],[32,1,"とも"]],"text":"あなたがたにわたしが命じることを行うならば、あなたがたはわたしの友である。"},{"ref":"John.15.15","start":43015015,"end":43015015,"break":"none","ruby":[[13,1,"しもべ"],[16,1,"よ"],[21,1,"しもべ"],[23,2,"しゅじん"],[33,1,"し"],[53,1,"とも"],[55,1,"よ"],[63,1,"ちち"],[66,1,"き"],[72,1,"みな"],[80,1,"し"]],"text":"わたしはもう、あなたがたを僕とは呼ばない。僕は主人のしていることを知らないからである。わたしはあなたがたを友と呼んだ。わたしの父から聞いたことを皆、あなたがたに知らせたからである。"},{"ref":"John.15.16","start":43015016,"end":43015016,"break":"none","ruby":[[10,1,"えら"],[29,1,"えら"],[47,1,"た"],[61,1,"い"],[64,1,"み"],[72,1,"み"],[79,1,"のこ"],[100,1,"な"],[105,1,"ちち"],[107,1,"もと"],[118,1,"ちち"],[120,1,"あた"],[123,1,"くだ"]],"text":"あなたがたがわたしを選んだのではない。わたしがあなたがたを選んだのである。そして、あなたがたを立てた。それは、あなたがたが行って実をむすび、その実がいつまでも残るためであり、また、あなたがたがわたしの名によって父に求めるものはなんでも、父が与えて下さるためである。"},{"ref":"John.15.17","start":43015017,"end":43015017,"break":"none","ruby":[[7,1,"めい"],[19,1,"たがい"],[21,1,"あい"],[23,1,"あ"]],"text":"これらのことを命じるのは、あなたがたが互に愛し合うためである。"},{"ref":"John.15.18","start":43015018,"end":43015018,"break":"paragraph","ruby":[[4,1,"よ"],[12,1,"にく"],[26,1,"さき"],[32,1,"にく"],[39,1,"し"]],"text":"もしこの世があなたがたを憎むならば、あなたがたよりも先にわたしを憎んだことを、知っておくがよい。"},{"ref":"John.15.19","start":43015019,"end":43015019,"break":"none","ruby":[[10,1,"よ"],[13,1,"で"],[26,1,"よ"],[35,2,"じぶん"],[43,1,"あい"],[63,1,"よ"],[89,1,"よ"],[92,1,"えら"],[94,1,"だ"],[108,1,"よ"],[116,1,"にく"]],"text":"もしあなたがたがこの世から出たものであったなら、この世は、あなたがたを自分のものとして愛したであろう。しかし、あなたがたはこの世のものではない。かえって、わたしがあなたがたをこの世から選び出したのである。だから、この世はあなたがたを憎むのである。"},{"ref":"John.15.20","start":43015020,"end":43015020,"break":"none","ruby":[[11,1,"しもべ"],[15,2,"しゅじん"],[29,1,"い"],[47,2,"ひとびと"],[54,2,"はくがい"],[68,2,"はくがい"],[82,1,"かれ"],[89,2,"ことば"],[92,1,"まも"],[106,2,"ことば"],[110,1,"まも"]],"text":"わたしがあなたがたに『僕はその主人にまさるものではない』と言ったことを、おぼえていなさい。もし人々がわたしを迫害したなら、あなたがたをも迫害するであろう。また、もし彼らがわたしの言葉を守っていたなら、あなたがたの言葉をも守るであろう。"},{"ref":"John.15.21","start":43015021,"end":43015021,"break":"none","ruby":[[0,1,"かれ"],[7,1,"な"],[19,1,"たい"],[56,1,"かれ"],[59,1,"し"]],"text":"彼らはわたしの名のゆえに、あなたがたに対してすべてそれらのことをするであろう。それは、わたしをつかわされたかたを彼らが知らないからである。"},{"ref":"John.15.22","start":43015022,"end":43015022,"break":"none","ruby":[[8,1,"かれ"],[11,1,"かた"],[21,1,"かれ"],[24,1,"つみ"],[26,1,"おか"],[42,1,"いま"],[49,1,"かれ"],[56,1,"つみ"],[61,1,"い"],[67,1,"みち"]],"text":"もしわたしがきて彼らに語らなかったならば、彼らは罪を犯さないですんだであろう。しかし今となっては、彼らには、その罪について言いのがれる道がない。"},{"ref":"John.15.23","start":43015023,"end":43015023,"break":"none","ruby":[[4,1,"にく"],[6,1,"もの"],[13,1,"ちち"],[16,1,"にく"]],"text":"わたしを憎む者は、わたしの父をも憎む。"},{"ref":"John.15.24","start":43015024,"end":43015024,"break":"none","ruby":[[26,1,"かれ"],[29,1,"あいだ"],[40,1,"かれ"],[43,1,"つみ"],[45,1,"おか"],[61,2,"じじつ"],[64,1,"かれ"],[75,1,"ちち"],[78,1,"み"],[81,1,"にく"]],"text":"もし、ほかのだれもがしなかったようなわざを、わたしが彼らの間でしなかったならば、彼らは罪を犯さないですんだであろう。しかし事実、彼らはわたしとわたしの父とを見て、憎んだのである。"},{"ref":"John.15.25","start":43015025,"end":43015025,"break":"none","ruby":[[5,1,"かれ"],[8,2,"りゆう"],[17,1,"にく"],[22,1,"か"],[27,1,"かれ"],[30,2,"りっぽう"],[33,2,"ことば"],[36,2,"じょうじゅ"]],"text":"それは、『彼らは理由なしにわたしを憎んだ』と書いてある彼らの律法の言葉が成就するためである。"},{"ref":"John.15.26","start":43015026,"end":43015026,"break":"none","ruby":[[4,1,"ちち"],[27,1,"たす"],[29,1,"ぬし"],[36,1,"ちち"],[43,1,"く"],[45,2,"しんり"],[48,2,"みたま"],[51,1,"くだ"],[53,1,"とき"]],"text":"わたしが父のみもとからあなたがたにつかわそうとしている助け主、すなわち、父のみもとから来る真理の御霊が下る時、それはわたしについてあかしをするであろう。"},{"ref":"John.15.27","start":43015027,"end":43015027,"break":"none","ruby":[[7,1,"はじ"],[15,2,"いっしょ"]],"text":"あなたがたも、初めからわたしと一緒にいたのであるから、あかしをするのである。"}]