[{"ref":"John.6.1","start":43006001,"end":43006001,"break":"paragraph","ruby":[[14,1,"うみ"],[25,1,"みずうみ"],[27,1,"む"],[30,1,"ぎし"],[32,1,"わた"]],"text":"そののち、イエスはガリラヤの海、すなわち、テベリヤ湖の向こう岸へ渡られた。"},{"ref":"John.6.2","start":43006002,"end":43006002,"break":"none","ruby":[[4,1,"おお"],[8,2,"ぐんしゅう"],[21,2,"びょうにん"],[36,1,"み"]],"text":"すると、大ぜいの群衆がイエスについてきた。病人たちになさっていたしるしを見たからである。"},{"ref":"John.6.3","start":43006003,"end":43006003,"break":"none","ruby":[[4,1,"やま"],[6,1,"のぼ"],[10,2,"でし"],[15,2,"いっしょ"],[21,1,"ざ"]],"text":"イエスは山に登って、弟子たちと一緒にそこで座につかれた。"},{"ref":"John.6.4","start":43006004,"end":43006004,"break":"none","ruby":[[0,1,"とき"],[6,1,"じん"],[8,1,"まつり"],[12,2,"すぎこし"],[15,2,"まぢか"]],"text":"時に、ユダヤ人の祭である過越が間近になっていた。"},{"ref":"John.6.5","start":43006005,"end":43006005,"break":"none","ruby":[[4,1,"め"],[9,1,"おお"],[13,2,"ぐんしゅう"],[16,2,"じぶん"],[19,1,"ほう"],[21,1,"あつ"],[25,1,"く"],[29,1,"み"],[36,1,"い"],[49,1,"か"],[57,2,"ひとびと"],[60,1,"た"]],"text":"イエスは目をあげ、大ぜいの群衆が自分の方に集まって来るのを見て、ピリポに言われた、「どこからパンを買ってきて、この人々に食べさせようか」。"},{"ref":"John.6.6","start":43006006,"end":43006006,"break":"none","ruby":[[14,1,"い"],[25,2,"じぶん"],[42,2,"しょうち"]],"text":"これはピリポをためそうとして言われたのであって、ご自分ではしようとすることを、よくご承知であった。"},{"ref":"John.6.7","start":43006007,"end":43006007,"break":"none","ruby":[[12,1,"こた"],[36,1,"すこ"],[46,1,"た"]],"text":"すると、ピリポはイエスに答えた、「二百デナリのパンがあっても、めいめいが少しずついただくにも足りますまい」。"},{"ref":"John.6.8","start":43006008,"end":43006008,"break":"none","ruby":[[0,2,"でし"],[15,2,"きょうだい"],[26,1,"い"]],"text":"弟子のひとり、シモン・ペテロの兄弟アンデレがイエスに言った、"},{"ref":"John.6.9","start":43006009,"end":43006009,"break":"none","ruby":[[5,2,"おおむぎ"],[22,1,"も"],[27,2,"こども"],[42,1,"おお"],[46,1,"ひと"],[53,1,"なに"]],"text":"「ここに、大麦のパン五つと、さかな二ひきとを持っている子供がいます。しかし、こんなに大ぜいの人では、それが何になりましょう」。"},{"ref":"John.6.10","start":43006010,"end":43006010,"break":"none","ruby":[[5,2,"ひとびと"],[17,1,"い"],[24,2,"ばしょ"],[28,1,"くさ"],[30,1,"おお"],[42,1,"おとこ"],[44,1,"かず"],[48,1,"にん"]],"text":"イエスは「人々をすわらせなさい」と言われた。その場所には草が多かった。そこにすわった男の数は五千人ほどであった。"},{"ref":"John.6.11","start":43006011,"end":43006011,"break":"none","ruby":[[11,1,"と"],[14,2,"かんしゃ"],[27,2,"ひとびと"],[30,1,"わ"],[32,1,"あた"],[43,2,"どうよう"],[49,1,"かれ"],[52,1,"のぞ"],[56,1,"わ"],[58,1,"あた"]],"text":"そこで、イエスはパンを取り、感謝してから、すわっている人々に分け与え、また、さかなをも同様にして、彼らの望むだけ分け与えられた。"},{"ref":"John.6.12","start":43006012,"end":43006012,"break":"none","ruby":[[0,2,"ひとびと"],[9,1,"た"],[19,2,"でし"],[24,1,"い"],[30,1,"すこ"],[54,1,"あつ"]],"text":"人々がじゅうぶんに食べたのち、イエスは弟子たちに言われた、「少しでもむだにならないように、パンくずのあまりを集めなさい」。"},{"ref":"John.6.13","start":43006013,"end":43006013,"break":"none","ruby":[[3,1,"かれ"],[6,1,"あつ"],[14,2,"おおむぎ"],[20,1,"た"],[23,1,"のこ"]],"text":"そこで彼らが集めると、五つの大麦のパンを食べて残ったパンくずは、十二のかごにいっぱいになった。"},{"ref":"John.6.14","start":43006014,"end":43006014,"break":"none","ruby":[[0,2,"ひとびと"],[17,1,"み"],[29,1,"ひと"],[32,1,"よ"],[39,3,"よげんしゃ"],[47,1,"い"]],"text":"人々はイエスのなさったこのしるしを見て、「ほんとうに、この人こそ世にきたるべき預言者である」と言った。"},{"ref":"John.6.15","start":43006015,"end":43006015,"break":"paragraph","ruby":[[4,2,"ひとびと"],[10,2,"じぶん"],[17,1,"おう"],[28,1,"し"],[40,1,"やま"],[42,1,"しりぞ"]],"text":"イエスは人々がきて、自分をとらえて王にしようとしていると知って、ただひとり、また山に退かれた。"},{"ref":"John.6.16","start":43006016,"end":43006016,"break":"paragraph","ruby":[[0,2,"ゆうがた"],[9,2,"でし"],[14,1,"うみ"],[17,1,"くだ"]],"text":"夕方になったとき、弟子たちは海べに下り、"},{"ref":"John.6.17","start":43006017,"end":43006017,"break":"none","ruby":[[0,1,"ふね"],[2,1,"の"],[5,1,"うみ"],[7,1,"わた"],[10,1,"む"],[13,1,"ぎし"],[21,1,"い"],[30,1,"くら"],[46,1,"かれ"]],"text":"舟に乗って海を渡り、向こう岸のカペナウムに行きかけた。すでに暗くなっていたのに、イエスはまだ彼らのところにおいでにならなかった。"},{"ref":"John.6.18","start":43006018,"end":43006018,"break":"none","ruby":[[2,1,"うえ"],[4,1,"つよ"],[6,1,"かぜ"],[8,1,"ふ"],[14,1,"うみ"],[16,1,"あ"],[18,1,"だ"]],"text":"その上、強い風が吹いてきて、海は荒れ出した。"},{"ref":"John.6.19","start":43006019,"end":43006019,"break":"none","ruby":[[4,1,"ちょう"],[7,1,"だ"],[17,1,"うみ"],[19,1,"うえ"],[21,1,"ある"],[24,1,"ふね"],[26,1,"ちか"],[36,1,"み"],[39,1,"かれ"],[42,1,"おそ"]],"text":"四、五十丁こぎ出したとき、イエスが海の上を歩いて舟に近づいてこられるのを見て、彼らは恐れた。"},{"ref":"John.6.20","start":43006020,"end":43006020,"break":"none","ruby":[[8,1,"かれ"],[11,1,"い"],[22,1,"おそ"]],"text":"すると、イエスは彼らに言われた、「わたしだ、恐れることはない」。"},{"ref":"John.6.21","start":43006021,"end":43006021,"break":"none","ruby":[[4,1,"かれ"],[7,1,"よろこ"],[14,1,"ふね"],[16,1,"むか"],[27,1,"ふね"],[33,1,"かれ"],[36,1,"い"],[44,1,"ち"],[46,1,"つ"]],"text":"そこで、彼らは喜んでイエスを舟に迎えようとした。すると舟は、すぐ、彼らが行こうとしていた地に着いた。"},{"ref":"John.6.22","start":43006022,"end":43006022,"break":"paragraph","ruby":[[2,2,"よくじつ"],[5,1,"うみ"],[7,1,"む"],[10,1,"ぎし"],[12,1,"た"],[17,2,"ぐんしゅう"],[24,2,"こぶね"],[41,2,"でし"],[46,2,"いっしょ"],[49,2,"こぶね"],[53,1,"の"],[62,2,"でし"],[69,2,"ふなで"],[75,1,"み"]],"text":"その翌日、海の向こう岸に立っていた群衆は、そこに小舟が一そうしかなく、またイエスは弟子たちと一緒に小舟にお乗りにならず、ただ弟子たちだけが船出したのを見た。"},{"ref":"John.6.23","start":43006023,"end":43006023,"break":"none","ruby":[[4,1,"すう"],[8,2,"こぶね"],[20,1,"しゅ"],[22,2,"かんしゃ"],[32,2,"ひとびと"],[35,1,"た"],[40,2,"ばしょ"],[43,1,"ちか"]],"text":"しかし、数そうの小舟がテベリヤからきて、主が感謝されたのちパンを人々に食べさせた場所に近づいた。"},{"ref":"John.6.24","start":43006024,"end":43006024,"break":"none","ruby":[[0,2,"ぐんしゅう"],[8,2,"でし"],[20,1,"し"],[28,2,"こぶね"],[31,1,"の"],[48,1,"い"]],"text":"群衆は、イエスも弟子たちもそこにいないと知って、それらの小舟に乗り、イエスをたずねてカペナウムに行った。"},{"ref":"John.6.25","start":43006025,"end":43006025,"break":"none","ruby":[[4,1,"うみ"],[6,1,"む"],[9,1,"ぎし"],[15,2,"であ"],[21,1,"い"],[26,2,"せんせい"]],"text":"そして、海の向こう岸でイエスに出会ったので言った、「先生、いつ、ここにおいでになったのですか」。"},{"ref":"John.6.26","start":43006026,"end":43006026,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[23,1,"い"],[39,1,"たず"],[53,1,"み"],[65,1,"た"],[68,2,"まんぷく"]],"text":"イエスは答えて言われた、「よくよくあなたがたに言っておく。あなたがたがわたしを尋ねてきているのは、しるしを見たためではなく、パンを食べて満腹したからである。"},{"ref":"John.6.27","start":43006027,"end":43006027,"break":"none","ruby":[[0,1,"く"],[3,2,"しょくもつ"],[13,2,"えいえん"],[16,1,"いのち"],[18,1,"いた"],[20,1,"く"],[24,2,"しょくもつ"],[30,1,"はたら"],[39,1,"ひと"],[41,1,"こ"],[49,1,"あた"],[58,1,"ちち"],[61,1,"かみ"],[64,1,"ひと"],[66,1,"こ"]],"text":"朽ちる食物のためではなく、永遠の命に至る朽ちない食物のために働くがよい。これは人の子があなたがたに与えるものである。父なる神は、人の子にそれをゆだねられたのである」。"},{"ref":"John.6.28","start":43006028,"end":43006028,"break":"none","ruby":[[4,1,"かれ"],[11,1,"い"],[16,1,"かみ"],[21,1,"おこな"],[33,1,"なに"]],"text":"そこで、彼らはイエスに言った、「神のわざを行うために、わたしたちは何をしたらよいでしょうか」。"},{"ref":"John.6.29","start":43006029,"end":43006029,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[10,1,"い"],[16,1,"かみ"],[24,1,"もの"],[26,1,"しん"],[33,1,"かみ"]],"text":"イエスは彼らに答えて言われた、「神がつかわされた者を信じることが、神のわざである」。"},{"ref":"John.6.30","start":43006030,"end":43006030,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[18,1,"み"],[24,1,"しん"],[38,1,"おこな"],[41,1,"くだ"],[56,1,"くだ"]],"text":"彼らはイエスに言った、「わたしたちが見てあなたを信じるために、どんなしるしを行って下さいますか。どんなことをして下さいますか。"},{"ref":"John.6.31","start":43006031,"end":43006031,"break":"none","ruby":[[6,2,"せんぞ"],[9,2,"あらの"],[15,1,"た"],[25,1,"てん"],[32,1,"かれ"],[35,1,"あた"],[38,1,"た"],[45,1,"か"]],"text":"わたしたちの先祖は荒野でマナを食べました。それは『天よりのパンを彼らに与えて食べさせた』と書いてあるとおりです」。"},{"ref":"John.6.32","start":43006032,"end":43006032,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[20,1,"い"],[26,1,"てん"],[39,1,"あた"],[53,1,"てん"],[70,1,"あた"],[80,1,"ちち"]],"text":"そこでイエスは彼らに言われた、「よくよく言っておく。天からのパンをあなたがたに与えたのは、モーセではない。天からのまことのパンをあなたがたに与えるのは、わたしの父なのである。"},{"ref":"John.6.33","start":43006033,"end":43006033,"break":"none","ruby":[[0,1,"かみ"],[6,1,"てん"],[9,1,"くだ"],[17,1,"よ"],[19,1,"いのち"],[21,1,"あた"]],"text":"神のパンは、天から下ってきて、この世に命を与えるものである」。"},{"ref":"John.6.34","start":43006034,"end":43006034,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[12,1,"しゅ"],[29,1,"くだ"]],"text":"彼らはイエスに言った、「主よ、そのパンをいつもわたしたちに下さい」。"},{"ref":"John.6.35","start":43006035,"end":43006035,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[17,1,"いのち"],[29,1,"く"],[31,1,"もの"],[33,1,"けっ"],[36,1,"う"],[49,1,"しん"],[52,1,"もの"],[54,1,"けっ"]],"text":"イエスは彼らに言われた、「わたしが命のパンである。わたしに来る者は決して飢えることがなく、わたしを信じる者は決してかわくことがない。"},{"ref":"John.6.36","start":43006036,"end":43006036,"break":"none","ruby":[[10,1,"い"],[25,1,"み"],[29,1,"しん"]],"text":"しかし、あなたがたに言ったが、あなたがたはわたしを見たのに信じようとはしない。"},{"ref":"John.6.37","start":43006037,"end":43006037,"break":"none","ruby":[[0,1,"ちち"],[6,1,"あた"],[9,1,"くだ"],[12,1,"もの"],[14,1,"みな"],[20,1,"く"],[35,1,"く"],[37,1,"もの"],[39,1,"けっ"],[42,1,"こば"]],"text":"父がわたしに与えて下さる者は皆、わたしに来るであろう。そして、わたしに来る者を決して拒みはしない。"},{"ref":"John.6.38","start":43006038,"end":43006038,"break":"none","ruby":[[4,1,"てん"],[7,1,"くだ"],[15,2,"じぶん"],[25,1,"おこな"],[52,1,"おこな"]],"text":"わたしが天から下ってきたのは、自分のこころのままを行うためではなく、わたしをつかわされたかたのみこころを行うためである。"},{"ref":"John.6.39","start":43006039,"end":43006039,"break":"none","ruby":[[23,1,"あた"],[26,1,"くだ"],[30,1,"もの"],[41,1,"うしな"],[46,1,"おわ"],[49,1,"ひ"]],"text":"わたしをつかわされたかたのみこころは、わたしに与えて下さった者を、わたしがひとりも失わずに、終りの日によみがえらせることである。"},{"ref":"John.6.40","start":43006040,"end":43006040,"break":"none","ruby":[[4,1,"ちち"],[12,1,"こ"],[14,1,"み"],[16,1,"しん"],[19,1,"もの"],[27,2,"えいえん"],[30,1,"いのち"],[32,1,"え"],[52,2,"ひとびと"],[55,1,"おわ"],[58,1,"ひ"]],"text":"わたしの父のみこころは、子を見て信じる者が、ことごとく永遠の命を得ることなのである。そして、わたしはその人々を終りの日によみがえらせるであろう」。"},{"ref":"John.6.41","start":43006041,"end":43006041,"break":"paragraph","ruby":[[3,1,"じん"],[16,1,"てん"],[19,1,"くだ"],[31,1,"い"],[49,1,"はじ"]],"text":"ユダヤ人らは、イエスが「わたしは天から下ってきたパンである」と言われたので、イエスについてつぶやき始めた。"},{"ref":"John.6.42","start":43006042,"end":43006042,"break":"none","ruby":[[3,1,"い"],[15,1,"こ"],[33,2,"ふぼ"],[36,1,"し"],[51,1,"てん"],[54,1,"くだ"],[65,1,"いま"]],"text":"そして言った、「これはヨセフの子イエスではないか。わたしたちはその父母を知っているではないか。わたしは天から下ってきたと、どうして今いうのか」。"},{"ref":"John.6.43","start":43006043,"end":43006043,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[10,1,"い"],[16,1,"たがい"]],"text":"イエスは彼らに答えて言われた、「互につぶやいてはいけない。"},{"ref":"John.6.44","start":43006044,"end":43006044,"break":"none","ruby":[[10,1,"ちち"],[12,1,"ひ"],[17,1,"くだ"],[32,1,"く"],[49,2,"ひとびと"],[52,1,"おわ"],[55,1,"ひ"]],"text":"わたしをつかわされた父が引きよせて下さらなければ、だれもわたしに来ることはできない。わたしは、その人々を終りの日によみがえらせるであろう。"},{"ref":"John.6.45","start":43006045,"end":43006045,"break":"none","ruby":[[0,3,"よげんしゃ"],[4,1,"しょ"],[8,1,"かれ"],[13,1,"かみ"],[15,1,"おし"],[26,1,"か"],[32,1,"ちち"],[35,1,"き"],[38,1,"まな"],[41,1,"もの"],[50,1,"く"]],"text":"預言者の書に、『彼らはみな神に教えられるであろう』と書いてある。父から聞いて学んだ者は、みなわたしに来るのである。"},{"ref":"John.6.46","start":43006046,"end":43006046,"break":"none","ruby":[[0,1,"かみ"],[3,1,"で"],[5,1,"もの"],[15,1,"ちち"],[17,1,"み"],[27,1,"もの"],[31,1,"ちち"],[33,1,"み"]],"text":"神から出た者のほかに、だれかが父を見たのではない。その者だけが父を見たのである。"},{"ref":"John.6.47","start":43006047,"end":43006047,"break":"none","ruby":[[10,1,"い"],[16,1,"しん"],[19,1,"もの"],[22,2,"えいえん"],[25,1,"いのち"]],"text":"よくよくあなたがたに言っておく。信じる者には永遠の命がある。"},{"ref":"John.6.48","start":43006048,"end":43006048,"break":"none","ruby":[[4,1,"いのち"]],"text":"わたしは命のパンである。"},{"ref":"John.6.49","start":43006049,"end":43006049,"break":"none","ruby":[[6,2,"せんぞ"],[9,2,"あらの"],[15,1,"た"],[20,1,"し"]],"text":"あなたがたの先祖は荒野でマナを食べたが、死んでしまった。"},{"ref":"John.6.50","start":43006050,"end":43006050,"break":"none","ruby":[[4,1,"てん"],[7,1,"くだ"],[15,1,"た"],[18,1,"ひと"],[21,1,"けっ"],[24,1,"し"]],"text":"しかし、天から下ってきたパンを食べる人は、決して死ぬことはない。"},{"ref":"John.6.51","start":43006051,"end":43006051,"break":"none","ruby":[[4,1,"てん"],[7,1,"くだ"],[12,1,"い"],[24,1,"た"],[27,1,"もの"],[35,1,"い"],[47,1,"あた"],[54,1,"よ"],[56,1,"いのち"],[61,1,"あた"],[68,1,"にく"]],"text":"わたしは天から下ってきた生きたパンである。それを食べる者は、いつまでも生きるであろう。わたしが与えるパンは、世の命のために与えるわたしの肉である」。"},{"ref":"John.6.52","start":43006052,"end":43006052,"break":"paragraph","ruby":[[7,1,"じん"],[10,1,"たがい"],[12,1,"ろん"],[15,1,"い"],[22,1,"ひと"],[29,2,"じぶん"],[32,1,"にく"],[40,1,"あた"],[43,1,"た"]],"text":"そこで、ユダヤ人らが互に論じて言った、「この人はどうして、自分の肉をわたしたちに与えて食べさせることができようか」。"},{"ref":"John.6.53","start":43006053,"end":43006053,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[17,1,"い"],[23,1,"ひと"],[25,1,"こ"],[27,1,"にく"],[29,1,"た"],[38,1,"ち"],[40,1,"の"],[53,1,"うち"],[55,1,"いのち"]],"text":"イエスは彼らに言われた、「よくよく言っておく。人の子の肉を食べず、また、その血を飲まなければ、あなたがたの内に命はない。"},{"ref":"John.6.54","start":43006054,"end":43006054,"break":"none","ruby":[[4,1,"にく"],[6,1,"た"],[13,1,"ち"],[15,1,"の"],[17,1,"もの"],[21,2,"えいえん"],[24,1,"いのち"],[35,1,"ひと"],[37,1,"おわ"],[40,1,"ひ"]],"text":"わたしの肉を食べ、わたしの血を飲む者には、永遠の命があり、わたしはその人を終りの日によみがえらせるであろう。"},{"ref":"John.6.55","start":43006055,"end":43006055,"break":"none","ruby":[[4,1,"にく"],[10,2,"しょくもつ"],[17,1,"ち"],[23,1,"の"],[25,1,"もの"]],"text":"わたしの肉はまことの食物、わたしの血はまことの飲み物である。"},{"ref":"John.6.56","start":43006056,"end":43006056,"break":"none","ruby":[[4,1,"にく"],[6,1,"た"],[13,1,"ち"],[15,1,"の"],[17,1,"もの"],[34,1,"ひと"]],"text":"わたしの肉を食べ、わたしの血を飲む者はわたしにおり、わたしもまたその人におる。"},{"ref":"John.6.57","start":43006057,"end":43006057,"break":"none","ruby":[[0,1,"い"],[3,1,"ちち"],[22,1,"ちち"],[27,1,"い"],[40,1,"た"],[43,1,"もの"],[52,1,"い"]],"text":"生ける父がわたしをつかわされ、また、わたしが父によって生きているように、わたしを食べる者もわたしによって生きるであろう。"},{"ref":"John.6.58","start":43006058,"end":43006058,"break":"none","ruby":[[0,1,"てん"],[3,1,"くだ"],[12,2,"せんぞ"],[17,1,"た"],[21,1,"し"],[43,1,"た"],[46,1,"もの"],[54,1,"い"]],"text":"天から下ってきたパンは、先祖たちが食べたが死んでしまったようなものではない。このパンを食べる者は、いつまでも生きるであろう」。"},{"ref":"John.6.59","start":43006059,"end":43006059,"break":"none","ruby":[[18,2,"かいどう"],[21,1,"おし"],[31,1,"い"]],"text":"これらのことは、イエスがカペナウムの会堂で教えておられたときに言われたものである。"},{"ref":"John.6.60","start":43006060,"end":43006060,"break":"paragraph","ruby":[[0,2,"でし"],[8,1,"おお"],[11,1,"もの"],[17,1,"き"],[20,1,"い"],[32,2,"ことば"],[45,1,"き"]],"text":"弟子たちのうちの多くの者は、これを聞いて言った、「これは、ひどい言葉だ。だれがそんなことを聞いておられようか」。"},{"ref":"John.6.61","start":43006061,"end":43006061,"break":"none","ruby":[[8,2,"でし"],[27,2,"みやぶ"],[32,1,"かれ"],[35,1,"い"]],"text":"しかしイエスは、弟子たちがそのことでつぶやいているのを見破って、彼らに言われた、「このことがあなたがたのつまずきになるのか。"},{"ref":"John.6.62","start":43006062,"end":43006062,"break":"none","ruby":[[7,1,"ひと"],[9,1,"こ"],[11,1,"まえ"],[15,1,"ところ"],[17,1,"のぼ"],[21,1,"み"]],"text":"それでは、もし人の子が前にいた所に上るのを見たら、どうなるのか。"},{"ref":"John.6.63","start":43006063,"end":43006063,"break":"none","ruby":[[0,1,"ひと"],[2,1,"い"],[8,1,"れい"],[14,1,"にく"],[19,1,"やく"],[22,1,"た"],[37,1,"はな"],[40,2,"ことば"],[43,1,"れい"],[50,1,"いのち"]],"text":"人を生かすものは霊であって、肉はなんの役にも立たない。わたしがあなたがたに話した言葉は霊であり、また命である。"},{"ref":"John.6.64","start":43006064,"end":43006064,"break":"none","ruby":[[10,1,"なか"],[13,1,"しん"],[17,1,"もの"],[28,1,"はじ"],[36,1,"しん"],[48,1,"かれ"],[50,2,"うらぎ"],[55,1,"し"]],"text":"しかし、あなたがたの中には信じない者がいる」。イエスは、初めから、だれが信じないか、また、だれが彼を裏切るかを知っておられたのである。"},{"ref":"John.6.65","start":43006065,"end":43006065,"break":"none","ruby":[[7,1,"い"],[19,1,"ちち"],[21,1,"あた"],[24,1,"くだ"],[28,1,"もの"],[39,1,"く"],[50,1,"い"]],"text":"そしてイエスは言われた、「それだから、父が与えて下さった者でなければ、わたしに来ることはできないと、言ったのである」。"},{"ref":"John.6.66","start":43006066,"end":43006066,"break":"paragraph","ruby":[[2,2,"いらい"],[5,1,"おお"],[8,2,"でし"],[13,1,"さ"],[27,2,"こうどう"],[30,1,"とも"]],"text":"それ以来、多くの弟子たちは去っていって、もはやイエスと行動を共にしなかった。"},{"ref":"John.6.67","start":43006067,"end":43006067,"break":"none","ruby":[[9,2,"でし"],[12,1,"い"],[24,1,"さ"]],"text":"そこでイエスは十二弟子に言われた、「あなたがたも去ろうとするのか」。"},{"ref":"John.6.68","start":43006068,"end":43006068,"break":"none","ruby":[[8,1,"こた"],[13,1,"しゅ"],[30,1,"い"],[37,2,"えいえん"],[40,1,"いのち"],[42,1,"ことば"]],"text":"シモン・ペテロが答えた、「主よ、わたしたちは、だれのところに行きましょう。永遠の命の言をもっているのはあなたです。"},{"ref":"John.6.69","start":43006069,"end":43006069,"break":"none","ruby":[[11,1,"かみ"],[13,2,"せいじゃ"],[21,1,"しん"],[26,1,"し"]],"text":"わたしたちは、あなたが神の聖者であることを信じ、また知っています」。"},{"ref":"John.6.70","start":43006070,"end":43006070,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[21,1,"にん"],[23,1,"えら"],[59,2,"あくま"]],"text":"イエスは彼らに答えられた、「あなたがた十二人を選んだのは、わたしではなかったか。それだのに、あなたがたのうちのひとりは悪魔である」。"},{"ref":"John.6.71","start":43006071,"end":43006071,"break":"none","ruby":[[15,1,"こ"],[22,1,"い"],[39,2,"でし"],[56,2,"うらぎ"]],"text":"これは、イスカリオテのシモンの子ユダをさして言われたのである。このユダは、十二弟子のひとりでありながら、イエスを裏切ろうとしていた。"}]