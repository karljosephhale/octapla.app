[{"ref":"Matt.25.1","start":40025001,"end":40025001,"break":"paragraph","ruby":[[3,2,"てんごく"],[8,1,"にん"],[22,1,"て"],[27,2,"はなむこ"],[30,1,"むか"],[33,1,"で"],[35,1,"い"],[39,1,"に"]],"text":"そこで天国は、十人のおとめがそれぞれあかりを手にして、花婿を迎えに出て行くのに似ている。"},{"ref":"Matt.25.2","start":40025002,"end":40025002,"break":"none","ruby":[[2,1,"なか"],[5,1,"にん"],[7,2,"しりょ"],[10,1,"あさ"],[14,1,"にん"],[16,2,"しりょ"],[18,1,"ぶか"],[20,1,"もの"]],"text":"その中の五人は思慮が浅く、五人は思慮深い者であった。"},{"ref":"Matt.25.3","start":40025003,"end":40025003,"break":"none","ruby":[[0,2,"しりょ"],[3,1,"あさ"],[5,1,"もの"],[14,1,"も"],[21,1,"あぶら"],[23,2,"ようい"]],"text":"思慮の浅い者たちは、あかりは持っていたが、油を用意していなかった。"},{"ref":"Matt.25.4","start":40025004,"end":40025004,"break":"none","ruby":[[4,2,"しりょ"],[6,1,"ぶか"],[8,1,"もの"],[13,2,"じぶん"],[22,2,"いっしょ"],[26,1,"い"],[31,1,"なか"],[33,1,"あぶら"],[35,2,"ようい"]],"text":"しかし、思慮深い者たちは、自分たちのあかりと一緒に、入れものの中に油を用意していた。"},{"ref":"Matt.25.5","start":40025005,"end":40025005,"break":"none","ruby":[[0,2,"はなむこ"],[3,1,"く"],[14,1,"かれ"],[19,2,"いねむ"],[26,1,"ね"]],"text":"花婿の来るのがおくれたので、彼らはみな居眠りをして、寝てしまった。"},{"ref":"Matt.25.6","start":40025006,"end":40025006,"break":"none","ruby":[[0,2,"よなか"],[8,2,"はなむこ"],[12,1,"むか"],[15,1,"で"],[21,1,"よ"],[23,1,"こえ"]],"text":"夜中に、『さあ、花婿だ、迎えに出なさい』と呼ぶ声がした。"},{"ref":"Matt.25.7","start":40025007,"end":40025007,"break":"none","ruby":[[13,1,"お"],[25,1,"ととの"]],"text":"そのとき、おとめたちはみな起きて、それぞれあかりを整えた。"},{"ref":"Matt.25.8","start":40025008,"end":40025008,"break":"none","ruby":[[5,2,"しりょ"],[8,1,"あさ"],[10,1,"おんな"],[15,2,"しりょ"],[17,1,"ぶか"],[19,1,"おんな"],[23,1,"い"],[34,1,"あぶら"],[60,1,"き"]],"text":"ところが、思慮の浅い女たちが、思慮深い女たちに言った、『あなたがたの油をわたしたちにわけてください。わたしたちのあかりが消えかかっていますから』。"},{"ref":"Matt.25.9","start":40025009,"end":40025009,"break":"none","ruby":[[4,2,"しりょ"],[6,1,"ぶか"],[8,1,"おんな"],[12,1,"こた"],[15,1,"い"],[33,1,"た"],[40,2,"たぶん"],[49,1,"みせ"],[51,1,"い"],[61,1,"ふん"],[64,1,"か"],[69,1,"ほう"]],"text":"すると、思慮深い女たちは答えて言った、『わたしたちとあなたがたとに足りるだけは、多分ないでしょう。店に行って、あなたがたの分をお買いになる方がよいでしょう』。"},{"ref":"Matt.25.10","start":40025010,"end":40025010,"break":"none","ruby":[[0,1,"かれ"],[3,1,"か"],[6,1,"で"],[14,2,"はなむこ"],[17,1,"つ"],[25,2,"ようい"],[33,1,"おんな"],[38,2,"はなむこ"],[41,2,"いっしょ"],[44,1,"こん"],[45,1,"えん"],[57,1,"と"]],"text":"彼らが買いに出ているうちに、花婿が着いた。そこで、用意のできていた女たちは、花婿と一緒に婚宴のへやにはいり、そして戸がしめられた。"},{"ref":"Matt.25.11","start":40025011,"end":40025011,"break":"none","ruby":[[20,3,"しゅじんさま"],[25,3,"しゅじんさま"],[42,1,"い"]],"text":"そのあとで、ほかのおとめたちもきて、『ご主人様、ご主人様、どうぞ、あけてください』と言った。"},{"ref":"Matt.25.12","start":40025012,"end":40025012,"break":"none","ruby":[[3,1,"かれ"],[5,1,"こた"],[14,1,"い"],[28,1,"し"],[34,1,"い"]],"text":"しかし彼は答えて、『はっきり言うが、わたしはあなたがたを知らない』と言った。"},{"ref":"Matt.25.13","start":40025013,"end":40025013,"break":"none","ruby":[[4,1,"め"],[17,1,"ひ"],[20,1,"とき"]],"text":"だから、目をさましていなさい。その日その時が、あなたがたにはわからないからである。"},{"ref":"Matt.25.14","start":40025014,"end":40025014,"break":"paragraph","ruby":[[2,2,"てんごく"],[8,1,"ひと"],[10,1,"たび"],[12,1,"で"],[19,1,"しもべ"],[23,1,"よ"],[27,2,"じぶん"],[30,2,"ざいさん"],[33,1,"あづ"]],"text":"また天国は、ある人が旅に出るとき、その僕どもを呼んで、自分の財産を預けるようなものである。"},{"ref":"Matt.25.15","start":40025015,"end":40025015,"break":"none","ruby":[[10,2,"のうりょく"],[13,1,"おう"],[19,1,"もの"],[30,1,"もの"],[41,1,"もの"],[50,1,"あた"],[54,1,"たび"],[56,1,"で"]],"text":"すなわち、それぞれの能力に応じて、ある者には五タラント、ある者には二タラント、ある者には一タラントを与えて、旅に出た。"},{"ref":"Matt.25.16","start":40025016,"end":40025016,"break":"none","ruby":[[6,1,"わた"],[10,1,"もの"],[16,1,"い"],[23,2,"しょうばい"]],"text":"五タラントを渡された者は、すぐに行って、それで商売をして、ほかに五タラントをもうけた。"},{"ref":"Matt.25.17","start":40025017,"end":40025017,"break":"none","ruby":[[6,1,"もの"],[8,2,"どうよう"]],"text":"二タラントの者も同様にして、ほかに二タラントをもうけた。"},{"ref":"Matt.25.18","start":40025018,"end":40025018,"break":"none","ruby":[[10,1,"わた"],[14,1,"もの"],[17,1,"い"],[20,1,"ち"],[22,1,"ほ"],[25,2,"しゅじん"],[28,1,"かね"],[30,1,"かく"]],"text":"しかし、一タラントを渡された者は、行って地を掘り、主人の金を隠しておいた。"},{"ref":"Matt.25.19","start":40025019,"end":40025019,"break":"none","ruby":[[3,1,"とき"],[15,1,"しもべ"],[17,2,"しゅじん"],[20,1,"かえ"],[26,1,"かれ"],[29,2,"けいさん"]],"text":"だいぶ時がたってから、これらの僕の主人が帰ってきて、彼らと計算をしはじめた。"},{"ref":"Matt.25.20","start":40025020,"end":40025020,"break":"none","ruby":[[9,1,"わた"],[13,1,"もの"],[15,1,"すす"],[17,1,"で"],[31,1,"だ"],[34,1,"い"],[40,3,"しゅじんさま"],[59,1,"あづ"]],"text":"すると五タラントを渡された者が進み出て、ほかの五タラントをさし出して言った、『ご主人様、あなたはわたしに五タラントをお預けになりましたが、ごらんのとおり、ほかに五タラントをもうけました』。"},{"ref":"Matt.25.21","start":40025021,"end":40025021,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"かれ"],[5,1,"い"],[10,1,"よ"],[12,2,"ちゅうじつ"],[15,1,"しもべ"],[35,2,"ちゅうじつ"],[44,1,"おお"],[50,2,"かんり"],[57,2,"しゅじん"],[60,2,"いっしょ"],[63,1,"よろこ"]],"text":"主人は彼に言った、『良い忠実な僕よ、よくやった。あなたはわずかなものに忠実であったから、多くのものを管理させよう。主人と一緒に喜んでくれ』。"},{"ref":"Matt.25.22","start":40025022,"end":40025022,"break":"none","ruby":[[6,1,"もの"],[8,1,"すす"],[10,1,"で"],[12,1,"い"],[18,3,"しゅじんさま"],[37,1,"あづ"]],"text":"二タラントの者も進み出て言った、『ご主人様、あなたはわたしに二タラントをお預けになりましたが、ごらんのとおり、ほかに二タラントをもうけました』。"},{"ref":"Matt.25.23","start":40025023,"end":40025023,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"かれ"],[5,1,"い"],[10,1,"よ"],[12,2,"ちゅうじつ"],[15,1,"しもべ"],[35,2,"ちゅうじつ"],[44,1,"おお"],[50,2,"かんり"],[57,2,"しゅじん"],[60,2,"いっしょ"],[63,1,"よろこ"]],"text":"主人は彼に言った、『良い忠実な僕よ、よくやった。あなたはわずかなものに忠実であったから、多くのものを管理させよう。主人と一緒に喜んでくれ』。"},{"ref":"Matt.25.24","start":40025024,"end":40025024,"break":"none","ruby":[[6,1,"わた"],[10,1,"もの"],[12,1,"すす"],[14,1,"で"],[16,1,"い"],[22,3,"しゅじんさま"],[39,1,"ところ"],[42,1,"か"],[45,1,"ち"],[50,1,"ところ"],[53,1,"あつ"],[56,1,"こく"],[58,1,"ひと"],[65,2,"しょうち"]],"text":"一タラントを渡された者も進み出て言った、『ご主人様、わたしはあなたが、まかない所から刈り、散らさない所から集める酷な人であることを承知していました。"},{"ref":"Matt.25.25","start":40025025,"end":40025025,"break":"none","ruby":[[3,1,"おそ"],[12,1,"い"],[25,1,"ち"],[27,1,"なか"],[29,1,"かく"],[54,1,"かね"]],"text":"そこで恐ろしさのあまり、行って、あなたのタラントを地の中に隠しておきました。ごらんください。ここにあなたのお金がございます』。"},{"ref":"Matt.25.26","start":40025026,"end":40025026,"break":"none","ruby":[[4,2,"しゅじん"],[7,1,"かれ"],[9,1,"こた"],[12,1,"い"],[17,1,"わる"],[19,2,"たいだ"],[22,1,"しもべ"],[38,1,"ところ"],[41,1,"か"],[44,1,"ち"],[49,1,"ところ"],[52,1,"あつ"],[58,1,"し"]],"text":"すると、主人は彼に答えて言った、『悪い怠惰な僕よ、あなたはわたしが、まかない所から刈り、散らさない所から集めることを知っているのか。"},{"ref":"Matt.25.27","start":40025027,"end":40025027,"break":"none","ruby":[[9,1,"かね"],[11,2,"ぎんこう"],[14,1,"あづ"],[36,1,"かえ"],[42,2,"りし"],[45,2,"いっしょ"],[52,1,"かね"],[54,1,"かえ"]],"text":"それなら、わたしの金を銀行に預けておくべきであった。そうしたら、わたしは帰ってきて、利子と一緒にわたしの金を返してもらえたであろうに。"},{"ref":"Matt.25.28","start":40025028,"end":40025028,"break":"none","ruby":[[12,1,"もの"],[15,1,"と"],[27,1,"も"],[32,1,"もの"]],"text":"さあ、そのタラントをこの者から取りあげて、十タラントを持っている者にやりなさい。"},{"ref":"Matt.25.29","start":40025029,"end":40025029,"break":"none","ruby":[[5,1,"も"],[10,1,"ひと"],[12,1,"あた"],[22,1,"ゆた"],[29,1,"も"],[35,1,"ひと"],[38,1,"も"],[48,1,"と"],[50,1,"あ"]],"text":"おおよそ、持っている人は与えられて、いよいよ豊かになるが、持っていない人は、持っているものまでも取り上げられるであろう。"},{"ref":"Matt.25.30","start":40025030,"end":40025030,"break":"none","ruby":[[2,1,"やく"],[4,1,"た"],[8,1,"しもべ"],[10,1,"そと"],[12,1,"くら"],[14,1,"ところ"],[16,1,"お"],[18,1,"だ"],[24,1,"かれ"],[30,1,"な"],[32,1,"さけ"],[37,1,"は"]],"text":"この役に立たない僕を外の暗い所に追い出すがよい。彼は、そこで泣き叫んだり、歯がみをしたりするであろう』。"},{"ref":"Matt.25.31","start":40025031,"end":40025031,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[4,2,"えいこう"],[7,1,"なか"],[13,2,"みつかい"],[18,1,"したが"],[21,1,"く"],[26,1,"かれ"],[30,2,"えいこう"],[33,1,"ざ"]],"text":"人の子が栄光の中にすべての御使たちを従えて来るとき、彼はその栄光の座につくであろう。"},{"ref":"Matt.25.32","start":40025032,"end":40025032,"break":"none","ruby":[[8,2,"こくみん"],[13,1,"まえ"],[15,1,"あつ"],[19,2,"ひつじかい"],[22,1,"ひつじ"],[28,1,"わ"],[35,1,"かれ"],[40,1,"わ"]],"text":"そして、すべての国民をその前に集めて、羊飼が羊とやぎとを分けるように、彼らをより分け、"},{"ref":"Matt.25.33","start":40025033,"end":40025033,"break":"none","ruby":[[0,1,"ひつじ"],[2,1,"みぎ"],[8,1,"ひだり"]],"text":"羊を右に、やぎを左におくであろう。"},{"ref":"Matt.25.34","start":40025034,"end":40025034,"break":"none","ruby":[[5,1,"おう"],[7,1,"みぎ"],[11,2,"ひとびと"],[14,1,"い"],[26,1,"ちち"],[28,2,"しゅくふく"],[33,1,"ひと"],[41,1,"よ"],[43,1,"はじ"],[56,2,"ようい"],[63,2,"みくに"],[66,1,"う"]],"text":"そのとき、王は右にいる人々に言うであろう、『わたしの父に祝福された人たちよ、さあ、世の初めからあなたがたのために用意されている御国を受けつぎなさい。"},{"ref":"Matt.25.35","start":40025035,"end":40025035,"break":"none","ruby":[[11,2,"くうふく"],[17,1,"た"],[31,1,"の"],[35,2,"たびびと"],[44,1,"やど"],[46,1,"か"]],"text":"あなたがたは、わたしが空腹のときに食べさせ、かわいていたときに飲ませ、旅人であったときに宿を貸し、"},{"ref":"Matt.25.36","start":40025036,"end":40025036,"break":"none","ruby":[[0,1,"はだか"],[8,1,"き"],[11,2,"びょうき"],[17,2,"みま"],[21,1,"ごく"],[28,1,"たず"]],"text":"裸であったときに着せ、病気のときに見舞い、獄にいたときに尋ねてくれたからである』。"},{"ref":"Matt.25.37","start":40025037,"end":40025037,"break":"none","ruby":[[5,1,"ただ"],[8,1,"もの"],[12,1,"こた"],[15,1,"い"],[23,1,"しゅ"],[40,2,"くうふく"],[47,1,"み"],[49,2,"しょくもつ"],[64,1,"み"],[66,1,"の"]],"text":"そのとき、正しい者たちは答えて言うであろう、『主よ、いつ、わたしたちは、あなたが空腹であるのを見て食物をめぐみ、かわいているのを見て飲ませましたか。"},{"ref":"Matt.25.38","start":40025038,"end":40025038,"break":"none","ruby":[[6,2,"たびびと"],[13,1,"み"],[15,1,"やど"],[17,1,"か"],[20,1,"はだか"],[24,1,"み"],[26,1,"き"]],"text":"いつあなたが旅人であるのを見て宿を貸し、裸なのを見て着せましたか。"},{"ref":"Matt.25.39","start":40025039,"end":40025039,"break":"none","ruby":[[9,2,"びょうき"],[14,1,"ごく"],[20,1,"み"],[27,1,"ところ"],[29,1,"まい"]],"text":"また、いつあなたが病気をし、獄にいるのを見て、あなたの所に参りましたか』。"},{"ref":"Matt.25.40","start":40025040,"end":40025040,"break":"none","ruby":[[4,1,"おう"],[6,1,"こた"],[9,1,"い"],[25,1,"い"],[35,2,"きょうだい"],[44,1,"もっと"],[46,1,"ちい"],[49,1,"もの"]],"text":"すると、王は答えて言うであろう、『あなたがたによく言っておく。わたしの兄弟であるこれらの最も小さい者のひとりにしたのは、すなわち、わたしにしたのである』。"},{"ref":"Matt.25.41","start":40025041,"end":40025041,"break":"none","ruby":[[5,1,"ひだり"],[9,2,"ひとびと"],[13,1,"い"],[26,1,"もの"],[35,1,"はな"],[39,2,"あくま"],[44,1,"つかい"],[52,2,"ようい"],[59,2,"えいえん"],[62,1,"ひ"]],"text":"それから、左にいる人々にも言うであろう、『のろわれた者どもよ、わたしを離れて、悪魔とその使たちとのために用意されている永遠の火にはいってしまえ。"},{"ref":"Matt.25.42","start":40025042,"end":40025042,"break":"none","ruby":[[11,2,"くうふく"],[17,1,"た"],[32,1,"の"]],"text":"あなたがたは、わたしが空腹のときに食べさせず、かわいていたときに飲ませず、"},{"ref":"Matt.25.43","start":40025043,"end":40025043,"break":"none","ruby":[[0,2,"たびびと"],[9,1,"やど"],[11,1,"か"],[15,1,"はだか"],[23,1,"き"],[29,2,"びょうき"],[36,1,"ごく"],[48,1,"たず"]],"text":"旅人であったときに宿を貸さず、裸であったときに着せず、また病気のときや、獄にいたときに、わたしを尋ねてくれなかったからである』。"},{"ref":"Matt.25.44","start":40025044,"end":40025044,"break":"none","ruby":[[5,1,"かれ"],[10,1,"こた"],[13,1,"い"],[21,1,"しゅ"],[31,2,"くうふく"],[45,2,"たびびと"],[51,1,"はだか"],[56,2,"びょうき"],[62,1,"ごく"],[70,1,"み"],[80,2,"せわ"]],"text":"そのとき、彼らもまた答えて言うであろう、『主よ、いつ、あなたが空腹であり、かわいておられ、旅人であり、裸であり、病気であり、獄におられたのを見て、わたしたちはお世話をしませんでしたか』。"},{"ref":"Matt.25.45","start":40025045,"end":40025045,"break":"none","ruby":[[5,1,"かれ"],[7,1,"こた"],[10,1,"い"],[26,1,"い"],[36,1,"もっと"],[38,1,"ちい"],[41,1,"もの"]],"text":"そのとき、彼は答えて言うであろう、『あなたがたによく言っておく。これらの最も小さい者のひとりにしなかったのは、すなわち、わたしにしなかったのである』。"},{"ref":"Matt.25.46","start":40025046,"end":40025046,"break":"none","ruby":[[3,1,"かれ"],[6,2,"えいえん"],[9,2,"けいばつ"],[12,1,"う"],[15,1,"ただ"],[18,1,"もの"],[20,2,"えいえん"],[23,2,"せいめい"],[26,1,"い"]],"text":"そして彼らは永遠の刑罰を受け、正しい者は永遠の生命に入るであろう」。"}]