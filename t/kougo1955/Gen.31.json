[{"ref":"Gen.31.1","start":1031001,"end":1031001,"break":"paragraph","ruby":[[10,1,"こ"],[24,1,"ちち"],[26,1,"もの"],[33,1,"うば"],[36,1,"ちち"],[38,1,"もの"],[49,1,"とみ"],[51,1,"え"],[57,1,"い"],[64,1,"き"]],"text":"さてヤコブはラバンの子らが、「ヤコブはわれわれの父の物をことごとく奪い、父の物によってあのすべての富を獲たのだ」と言っているのを聞いた。"},{"ref":"Gen.31.2","start":1031002,"end":1031002,"break":"none","ruby":[[10,1,"かお"],[12,1,"み"],[20,2,"じぶん"],[23,1,"たい"],[26,2,"いぜん"]],"text":"またヤコブがラバンの顔を見るのに、それは自分に対して以前のようではなかった。"},{"ref":"Gen.31.3","start":1031003,"end":1031003,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,2,"せんぞ"],[19,1,"くに"],[21,1,"かえ"],[24,2,"しんぞく"],[30,1,"い"],[44,1,"とも"]],"text":"主はヤコブに言われた、「あなたの先祖の国へ帰り、親族のもとに行きなさい。わたしはあなたと共にいるであろう」。"},{"ref":"Gen.31.4","start":1031004,"end":1031004,"break":"none","ruby":[[7,1,"ひと"],[22,1,"の"],[26,2,"じぶん"],[29,1,"む"],[36,1,"まね"]],"text":"そこでヤコブは人をやって、ラケルとレアとを、野にいる自分の群れのところに招き、"},{"ref":"Gen.31.5","start":1031005,"end":1031005,"break":"none","ruby":[[0,2,"かのじょ"],[4,1,"い"],[19,1,"ちち"],[21,1,"かお"],[23,1,"み"],[32,1,"たい"],[35,2,"いぜん"],[53,1,"ちち"],[55,1,"かみ"],[61,1,"とも"]],"text":"彼女らに言った、「わたしがあなたがたの父の顔を見るのに、わたしに対して以前のようではない。しかし、わたしの父の神はわたしと共におられる。"},{"ref":"Gen.31.6","start":1031006,"end":1031006,"break":"none","ruby":[[6,1,"し"],[19,1,"ちから"],[31,1,"ちち"],[33,1,"つか"]],"text":"あなたがたが知っているように、わたしは力のかぎり、あなたがたの父に仕えてきた。"},{"ref":"Gen.31.7","start":1031007,"end":1031007,"break":"none","ruby":[[10,1,"ちち"],[16,1,"あざむ"],[21,1,"ど"],[27,2,"ほうしゅう"],[30,1,"か"],[38,1,"かみ"],[40,1,"かれ"],[46,1,"がい"],[48,1,"くわ"],[55,1,"ゆる"]],"text":"しかし、あなたがたの父はわたしを欺いて、十度もわたしの報酬を変えた。けれども神は彼がわたしに害を加えることをお許しにならなかった。"},{"ref":"Gen.31.8","start":1031008,"end":1031008,"break":"none","ruby":[[2,1,"かれ"],[16,2,"ほうしゅう"],[21,1,"い"],[25,1,"む"],[28,1,"みな"],[35,1,"う"],[41,1,"かれ"],[57,2,"ほうしゅう"],[62,1,"い"],[66,1,"む"],[69,1,"みな"],[78,1,"う"]],"text":"もし彼が、『ぶちのものはあなたの報酬だ』と言えば、群れは皆ぶちのものを産んだ。もし彼が、『しまのあるものはあなたの報酬だ』と言えば、群れは皆しまのあるものを産んだ。"},{"ref":"Gen.31.9","start":1031009,"end":1031009,"break":"none","ruby":[[4,1,"かみ"],[12,1,"ちち"],[14,2,"かちく"],[24,1,"あた"]],"text":"こうして神はあなたがたの父の家畜をとってわたしに与えられた。"},{"ref":"Gen.31.10","start":1031010,"end":1031010,"break":"none","ruby":[[2,1,"む"],[5,2,"はつじょう"],[9,1,"とき"],[15,1,"ゆめ"],[17,1,"め"],[22,1,"み"],[26,1,"む"],[29,1,"うえ"],[31,1,"の"],[36,1,"お"],[40,1,"みな"],[55,1,"しも"]],"text":"また群れが発情した時、わたしが夢に目をあげて見ると、群れの上に乗っている雄やぎは皆しまのあるもの、ぶちのもの、霜ふりのものであった。"},{"ref":"Gen.31.11","start":1031011,"end":1031011,"break":"none","ruby":[[2,1,"とき"],[4,1,"かみ"],[6,1,"つかい"],[8,1,"ゆめ"],[10,1,"なか"],[16,1,"い"],[31,1,"こた"]],"text":"その時、神の使が夢の中でわたしに言った、『ヤコブよ』。わたしは答えた、『ここにおります』。"},{"ref":"Gen.31.12","start":1031012,"end":1031012,"break":"none","ruby":[[0,1,"かみ"],[2,1,"つかい"],[4,1,"い"],[9,1,"め"],[11,1,"あ"],[14,1,"み"],[20,1,"む"],[23,1,"うえ"],[25,1,"の"],[30,1,"お"],[34,1,"みな"],[49,1,"しも"],[77,1,"み"]],"text":"神の使は言った、『目を上げて見てごらん。群れの上に乗っている雄やぎは皆しまのあるもの、ぶちのもの、霜ふりのものです。わたしはラバンがあなたにしたことをみな見ています。"},{"ref":"Gen.31.13","start":1031013,"end":1031013,"break":"none","ruby":[[8,1,"かみ"],[23,1,"はしら"],[25,1,"あぶら"],[27,1,"そそ"],[35,1,"ちか"],[38,1,"た"],[47,1,"た"],[52,1,"ち"],[54,1,"で"],[61,1,"うま"],[64,1,"くに"],[66,1,"かえ"]],"text":"わたしはベテルの神です。かつてあなたはあそこで柱に油を注いで、わたしに誓いを立てましたが、いま立ってこの地を出て、あなたの生れた国へ帰りなさい』」。"},{"ref":"Gen.31.14","start":1031014,"end":1031014,"break":"none","ruby":[[7,1,"こた"],[10,1,"い"],[21,1,"ちち"],[23,1,"いえ"],[34,1,"う"],[38,1,"ぶん"],[42,1,"し"],[43,1,"ぎょう"]],"text":"ラケルとレアは答えて言った、「わたしたちの父の家に、なおわたしたちの受くべき分、また嗣業がありましょうか。"},{"ref":"Gen.31.15","start":1031015,"end":1031015,"break":"none","ruby":[[6,1,"ちち"],[8,2,"たにん"],[14,1,"おも"],[29,1,"かれ"],[37,1,"う"],[55,1,"かね"],[59,1,"つか"],[61,1,"は"]],"text":"わたしたちは父に他人のように思われているではありませんか。彼はわたしたちを売ったばかりでなく、わたしたちのその金をさえ使い果たしたのです。"},{"ref":"Gen.31.16","start":1031016,"end":1031016,"break":"none","ruby":[[0,1,"かみ"],[8,1,"ちち"],[11,1,"と"],[18,1,"とみ"],[35,1,"こ"],[47,2,"なにごと"],[51,1,"かみ"],[58,1,"つ"],[64,1,"こと"]],"text":"神がわたしたちの父から取りあげられた富は、みなわたしたちとわたしたちの子どものものです。だから何事でも神があなたにお告げになった事をしてください」。"},{"ref":"Gen.31.17","start":1031017,"end":1031017,"break":"paragraph","ruby":[[7,1,"た"],[11,1,"こ"],[14,1,"つま"],[22,1,"の"]],"text":"そこでヤコブは立って、子らと妻たちをらくだに乗せ、"},{"ref":"Gen.31.18","start":1031018,"end":1031018,"break":"none","ruby":[[6,2,"かちく"],[13,1,"かれ"],[22,1,"え"],[24,2,"かちく"],[32,2,"ざいさん"],[35,1,"たずさ"],[43,1,"ち"],[47,1,"ちち"],[55,1,"おもむ"]],"text":"またすべての家畜、すなわち彼がパダンアラムで獲た家畜と、すべての財産を携えて、カナンの地におる父イサクのもとへ赴いた。"},{"ref":"Gen.31.19","start":1031019,"end":1031019,"break":"none","ruby":[[2,1,"とき"],[7,1,"ひつじ"],[9,1,"け"],[11,1,"き"],[16,1,"で"],[27,1,"ちち"],[29,2,"しょゆう"],[37,1,"ぬす"],[39,1,"だ"]],"text":"その時ラバンは羊の毛を切るために出ていたので、ラケルは父の所有のテラピムを盗み出した。"},{"ref":"Gen.31.20","start":1031020,"end":1031020,"break":"none","ruby":[[15,1,"あざむ"],[18,2,"じぶん"],[21,1,"に"],[23,1,"さ"],[27,1,"かれ"],[29,1,"つ"]],"text":"またヤコブはアラムびとラバンを欺き、自分の逃げ去るのを彼に告げなかった。"},{"ref":"Gen.31.21","start":1031021,"end":1031021,"break":"none","ruby":[[4,1,"かれ"],[10,1,"も"],[12,1,"もの"],[14,1,"たずさ"],[17,1,"に"],[20,1,"た"],[23,1,"かわ"],[25,1,"わた"],[33,2,"さんち"],[36,1,"む"]],"text":"こうして彼はすべての持ち物を携えて逃げ、立って川を渡り、ギレアデの山地へ向かった。"},{"ref":"Gen.31.22","start":1031022,"end":1031022,"break":"paragraph","ruby":[[1,1,"か"],[2,1,"め"],[12,1,"に"],[14,1,"さ"],[25,1,"きこ"]],"text":"三日目になって、ヤコブの逃げ去ったことが、ラバンに聞えたので、"},{"ref":"Gen.31.23","start":1031023,"end":1031023,"break":"none","ruby":[[0,1,"かれ"],[2,2,"いちぞく"],[5,1,"ひき"],[9,2,"なぬか"],[12,1,"あいだ"],[18,1,"お"],[26,2,"さんち"],[29,1,"お"]],"text":"彼は一族を率いて、七日の間そのあとを追い、ギレアデの山地で追いついた。"},{"ref":"Gen.31.24","start":1031024,"end":1031024,"break":"none","ruby":[[4,1,"かみ"],[6,1,"よ"],[8,1,"ゆめ"],[19,1,"あらわ"],[22,1,"い"],[32,1,"こころ"],[45,1,"い"]],"text":"しかし、神は夜の夢にアラムびとラバンに現れて言われた、「あなたは心してヤコブに、よしあしを言ってはなりません」。"},{"ref":"Gen.31.25","start":1031025,"end":1031025,"break":"paragraph","ruby":[[11,1,"お"],[22,1,"やま"],[24,2,"てんまく"],[27,1,"は"],[39,2,"いちぞく"],[42,1,"とも"],[49,1,"やま"],[51,2,"てんまく"],[54,1,"は"]],"text":"ラバンはついにヤコブに追いついたが、ヤコブが山に天幕を張っていたので、ラバンも一族と共にギレアデの山に天幕を張った。"},{"ref":"Gen.31.26","start":1031026,"end":1031026,"break":"none","ruby":[[8,1,"い"],[22,1,"こと"],[39,1,"あざむ"],[46,1,"むすめ"],[61,1,"ひ"],[64,1,"い"]],"text":"ラバンはヤコブに言った、「あなたはなんという事をしたのですか。あなたはわたしを欺いてわたしの娘たちをいくさのとりこのように引いて行きました。"},{"ref":"Gen.31.27","start":1031027,"end":1031027,"break":"none","ruby":[[10,1,"つ"],[19,1,"に"],[21,1,"さ"],[28,1,"あざむ"],[40,1,"て"],[41,1,"つづみ"],[43,1,"こと"],[45,1,"よろこ"],[47,1,"うた"],[54,1,"おく"]],"text":"なぜあなたはわたしに告げずに、ひそかに逃げ去ってわたしを欺いたのですか。わたしは手鼓や琴で喜び歌ってあなたを送りだそうとしていたのに。"},{"ref":"Gen.31.28","start":1031028,"end":1031028,"break":"none","ruby":[[6,1,"まご"],[8,1,"むすめ"],[14,1,"くち"],[21,1,"ゆる"],[36,1,"おろ"],[39,1,"こと"]],"text":"なぜわたしの孫や娘にわたしが口づけするのを許さなかったのですか。あなたは愚かな事をしました。"},{"ref":"Gen.31.29","start":1031029,"end":1031029,"break":"none","ruby":[[10,1,"がい"],[12,1,"くわ"],[15,1,"ちから"],[30,1,"ちち"],[32,1,"かみ"],[34,2,"さくや"],[40,1,"つ"],[49,1,"こころ"],[62,1,"い"],[67,1,"い"]],"text":"わたしはあなたがたに害を加える力をもっているが、あなたがたの父の神が昨夜わたしに告げて、『おまえは心して、ヤコブによしあしを言うな』と言われました。"},{"ref":"Gen.31.30","start":1031030,"end":1031030,"break":"none","ruby":[[0,1,"いま"],[5,1,"に"],[7,1,"だ"],[12,1,"ちち"],[14,1,"いえ"],[16,2,"ひじょう"],[19,1,"こい"],[43,1,"かみ"],[45,1,"ぬす"]],"text":"今あなたが逃げ出したのは父の家が非常に恋しくなったからでしょうが、なぜあなたはわたしの神を盗んだのですか」。"},{"ref":"Gen.31.31","start":1031031,"end":1031031,"break":"none","ruby":[[8,1,"こた"],[20,1,"むすめ"],[29,1,"うば"],[37,1,"おも"],[44,1,"おそ"]],"text":"ヤコブはラバンに答えた、「たぶんあなたが娘たちをわたしから奪いとるだろうと思ってわたしは恐れたからです。"},{"ref":"Gen.31.32","start":1031032,"end":1031032,"break":"none","ruby":[[3,1,"ところ"],[11,1,"かみ"],[13,1,"み"],[22,1,"もの"],[24,1,"い"],[35,1,"なに"],[41,1,"もの"],[60,2,"いちぞく"],[63,1,"まえ"],[66,1,"しら"],[76,1,"と"],[88,1,"かみ"],[90,1,"ぬす"],[100,1,"し"]],"text":"だれの所にでもあなたの神が見つかったら、その者を生かしてはおきません。何かあなたの物がわたしのところにあるか、われわれの一族の前で、調べてみて、それをお取りください」。ラケルが神を盗んだことをヤコブは知らなかったからである。"},{"ref":"Gen.31.33","start":1031033,"end":1031033,"break":"paragraph","ruby":[[11,2,"てんまく"],[23,2,"てんまく"],[30,1,"さら"],[41,2,"てんまく"],[52,1,"み"],[66,2,"てんまく"],[69,1,"で"],[75,2,"てんまく"]],"text":"そこでラバンはヤコブの天幕にはいり、またレアの天幕にはいり、更にふたりのはしための天幕にはいってみたが、見つからなかったので、レアの天幕を出てラケルの天幕にはいった。"},{"ref":"Gen.31.34","start":1031034,"end":1031034,"break":"none","ruby":[[16,1,"と"],[27,1,"した"],[29,1,"い"],[34,1,"うえ"],[54,2,"てんまく"],[57,1,"なか"],[59,1,"さが"],[64,1,"み"]],"text":"しかし、ラケルはすでにテラピムを取って、らくだのくらの下に入れ、その上にすわっていたので、ラバンは、くまなく天幕の中を捜したが、見つからなかった。"},{"ref":"Gen.31.35","start":1031035,"end":1031035,"break":"none","ruby":[[2,1,"とき"],[7,1,"ちち"],[9,1,"い"],[18,1,"おんな"],[20,1,"つね"],[33,1,"まえ"],[35,1,"た"],[37,1,"あ"],[51,1,"しゅ"],[58,1,"いか"],[68,1,"かれ"],[70,1,"さが"],[79,1,"み"]],"text":"その時ラケルは父に言った、「わたしは女の常のことがあって、あなたの前に立ち上がることができません。わが主よ、どうかお怒りにならぬよう」。彼は捜したがテラピムは見つからなかった。"},{"ref":"Gen.31.36","start":1031036,"end":1031036,"break":"paragraph","ruby":[[7,1,"いか"],[14,1,"せ"],[29,1,"い"],[52,1,"つみ"],[69,1,"はげ"],[72,1,"お"]],"text":"そこでヤコブは怒ってラバンを責めた。そしてヤコブはラバンに言った、「わたしにどんなあやまちがあり、どんな罪があって、あなたはわたしのあとを激しく追ったのですか。"},{"ref":"Gen.31.37","start":1031037,"end":1031037,"break":"none","ruby":[[8,1,"もの"],[15,1,"さぐ"],[21,1,"なに"],[27,1,"いえ"],[29,1,"もの"],[31,1,"み"],[52,2,"いちぞく"],[60,2,"いちぞく"],[63,1,"まえ"],[65,1,"お"],[77,1,"あいだ"]],"text":"あなたはわたしの物をことごとく探られたが、何かあなたの家の物が見つかりましたか。それを、ここに、わたしの一族と、あなたの一族の前に置いて、われわれふたりの間をさばかせましょう。"},{"ref":"Gen.31.38","start":1031038,"end":1031038,"break":"none","ruby":[[8,1,"ねん"],[14,2,"いっしょ"],[25,1,"かん"],[30,1,"め"],[31,1,"ひつじ"],[33,1,"め"],[37,1,"こ"],[39,1,"う"],[61,1,"む"],[64,2,"おひつじ"],[67,1,"た"]],"text":"わたしはこの二十年、あなたと一緒にいましたが、その間あなたの雌羊も雌やぎも子を産みそこねたことはなく、またわたしはあなたの群れの雄羊を食べたこともありませんでした。"},{"ref":"Gen.31.39","start":1031039,"end":1031039,"break":"none","ruby":[[2,2,"やじゅう"],[8,1,"さ"],[22,1,"も"],[30,2,"じぶん"],[36,1,"つぐな"],[44,1,"ひる"],[45,1,"ぬす"],[53,1,"よる"],[54,1,"ぬす"],[72,1,"つぐな"],[75,1,"もと"]],"text":"また野獣が、かみ裂いたものは、あなたのもとに持ってこないで、自分でそれを償いました。また昼盗まれたものも、夜盗まれたものも、あなたはわたしにその償いを求められました。"},{"ref":"Gen.31.40","start":1031040,"end":1031040,"break":"none","ruby":[[7,1,"い"],[11,1,"ひる"],[13,1,"あつ"],[17,1,"よる"],[19,1,"さむ"],[22,1,"なや"],[28,1,"ねむ"]],"text":"わたしのことを言えば、昼は暑さに、夜は寒さに悩まされて、眠ることもできませんでした。"},{"ref":"Gen.31.41","start":1031041,"end":1031041,"break":"none","ruby":[[8,1,"ねん"],[13,2,"かぞく"],[38,1,"むすめ"],[45,1,"ねん"],[53,1,"む"],[60,1,"ねん"],[66,1,"つか"],[77,1,"じゅう"],[78,1,"ど"],[84,2,"ほうしゅう"],[87,1,"か"]],"text":"わたしはこの二十年あなたの家族のひとりでありました。わたしはあなたのふたりの娘のために十四年、またあなたの群れのために六年、あなたに仕えましたが、あなたは十度もわたしの報酬を変えられました。"},{"ref":"Gen.31.42","start":1031042,"end":1031042,"break":"none","ruby":[[7,1,"ちち"],[9,1,"かみ"],[17,1,"かみ"],[27,1,"もの"],[33,1,"とも"],[59,1,"て"],[61,1,"さ"],[70,1,"かみ"],[76,1,"なや"],[84,2,"ろうく"],[88,1,"かえり"],[93,2,"さくや"],[99,1,"いまし"]],"text":"もし、わたしの父の神、アブラハムの神、イサクのかしこむ者がわたしと共におられなかったなら、あなたはきっとわたしを、から手で去らせたでしょう。神はわたしの悩みと、わたしの労苦とを顧みられて昨夜あなたを戒められたのです」。"},{"ref":"Gen.31.43","start":1031043,"end":1031043,"break":"paragraph","ruby":[[4,1,"こた"],[11,1,"い"],[16,1,"むすめ"],[24,1,"むすめ"],[26,1,"こ"],[36,1,"まご"],[42,1,"む"],[49,1,"む"],[56,1,"み"],[80,1,"むすめ"],[89,1,"かれ"],[92,1,"う"],[95,1,"こ"],[111,1,"なに"]],"text":"ラバンは答えてヤコブに言った、「娘たちはわたしの娘、子どもたちはわたしの孫です。また群れはわたしの群れ、あなたの見るものはみなわたしのものです。これらのわたしの娘たちのため、また彼らが産んだ子どもたちのため、きょうわたしは何をすることができましょうか。"},{"ref":"Gen.31.44","start":1031044,"end":1031044,"break":"none","ruby":[[15,2,"けいやく"],[18,1,"むす"],[34,1,"あいだ"],[36,2,"しょうこ"]],"text":"さあ、それではわたしとあなたと契約を結んで、これをわたしとあなたとの間の証拠としましょう」。"},{"ref":"Gen.31.45","start":1031045,"end":1031045,"break":"none","ruby":[[7,1,"いし"],[9,1,"と"],[15,1,"た"],[18,1,"はしら"]],"text":"そこでヤコブは石を取り、それを立てて柱とした。"},{"ref":"Gen.31.46","start":1031046,"end":1031046,"break":"none","ruby":[[6,2,"いちぞく"],[9,1,"もの"],[11,1,"い"],[16,1,"いし"],[18,1,"あつ"],[27,1,"かれ"],[30,1,"いし"],[32,1,"と"],[39,2,"いしづか"],[42,1,"つく"],[50,1,"かれ"],[55,2,"いしづか"],[63,2,"しょくじ"]],"text":"ヤコブはまた一族の者に言った、「石を集めてください」。彼らは石を取って、一つの石塚を造った。こうして彼らはその石塚のかたわらで食事をした。"},{"ref":"Gen.31.47","start":1031047,"end":1031047,"break":"none","ruby":[[16,1,"な"],[32,1,"な"]],"text":"ラバンはこれをエガル・サハドタと名づけ、ヤコブはこれをガルエドと名づけた。"},{"ref":"Gen.31.48","start":1031048,"end":1031048,"break":"none","ruby":[[7,1,"い"],[14,2,"いしづか"],[29,1,"あいだ"],[31,2,"しょうこ"],[45,1,"な"],[52,1,"よ"]],"text":"そしてラバンは言った、「この石塚はきょうわたしとあなたとの間の証拠となります」。それでその名はガルエドと呼ばれた。"},{"ref":"Gen.31.49","start":1031049,"end":1031049,"break":"none","ruby":[[7,1,"よ"],[12,1,"かれ"],[16,1,"い"],[31,1,"たがい"],[33,1,"わか"],[43,1,"しゅ"],[54,1,"あいだ"],[56,2,"みまも"]],"text":"またミズパとも呼ばれた。彼がこう言ったからである、「われわれが互に別れたのちも、どうか主がわたしとあなたとの間を見守られるように。"},{"ref":"Gen.31.50","start":1031050,"end":1031050,"break":"none","ruby":[[10,1,"むすめ"],[12,2,"ぎゃくたい"],[22,1,"むすめ"],[27,1,"つま"],[56,1,"かみ"],[67,1,"あいだ"],[69,2,"しょうにん"]],"text":"もしあなたがわたしの娘を虐待したり、わたしの娘のほかに妻をめとることがあれば、たといそこにだれひとりいなくても、神はわたしとあなたとの間の証人でいらせられる」。"},{"ref":"Gen.31.51","start":1031051,"end":1031051,"break":"paragraph","ruby":[[0,1,"さら"],[10,1,"い"],[24,1,"あいだ"],[30,1,"た"],[35,2,"いしづか"],[47,1,"はしら"]],"text":"更にラバンはヤコブに言った、「あなたとわたしとの間にわたしが建てたこの石塚をごらんなさい、この柱をごらんなさい。"},{"ref":"Gen.31.52","start":1031052,"end":1031052,"break":"none","ruby":[[2,2,"いしづか"],[5,1,"こ"],[16,1,"がい"],[18,1,"くわ"],[26,2,"いしづか"],[31,1,"はしら"],[33,1,"こ"],[44,1,"がい"],[46,1,"くわ"],[59,2,"いしづか"],[71,1,"はしら"]],"text":"この石塚を越えてわたしがあなたに害を加えず、またこの石塚とこの柱を越えてあなたがわたしに害を加えないように、どうかこの石塚があかしとなり、この柱があかしとなるように。"},{"ref":"Gen.31.53","start":1031053,"end":1031053,"break":"none","ruby":[[9,1,"かみ"],[15,1,"かみ"],[17,1,"かれ"],[20,1,"ちち"],[22,1,"かみ"],[29,1,"あいだ"],[45,1,"ちち"],[54,1,"もの"],[59,1,"ちか"]],"text":"どうかアブラハムの神、ナホルの神、彼らの父の神がわれわれの間をさばかれるように」。ヤコブは父イサクのかしこむ者によって誓った。"},{"ref":"Gen.31.54","start":1031054,"end":1031054,"break":"none","ruby":[[7,1,"やま"],[9,2,"ぎせい"],[16,2,"いちぞく"],[19,1,"まね"],[23,2,"しょくじ"],[29,1,"かれ"],[32,2,"しょくじ"],[37,1,"やま"],[39,1,"やど"]],"text":"そしてヤコブは山で犠牲をささげ、一族を招いて、食事をした。彼らは食事をして山に宿った。"},{"ref":"Gen.31.55","start":1031055,"end":1031055,"break":"paragraph","ruby":[[3,1,"あさ"],[8,1,"はや"],[10,1,"お"],[13,1,"まご"],[15,1,"むすめ"],[19,1,"くち"],[24,1,"かれ"],[27,2,"しゅくふく"],[31,1,"さ"],[34,1,"いえ"],[36,1,"かえ"]],"text":"あくる朝ラバンは早く起き、孫と娘たちに口づけして彼らを祝福し、去って家に帰った。"}]