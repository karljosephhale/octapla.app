[{"ref":"Deut.2.1","start":5002001,"end":5002001,"break":"paragraph","ruby":[[10,1,"み"],[17,1,"しゅ"],[23,1,"つ"],[32,2,"こうかい"],[35,1,"ほう"],[37,1,"む"],[41,2,"あらの"],[44,1,"すす"],[46,1,"い"],[49,1,"ひ"],[50,1,"ひさ"],[56,1,"やま"],[58,1,"い"]],"text":"それから、われわれは身をめぐらし、主がわたしに告げられたように、紅海の方に向かって荒野に進み入り、日久しくセイル山を行きめぐっていたが、"},{"ref":"Deut.2.2","start":5002002,"end":5002002,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はわたしに言われた、"},{"ref":"Deut.2.3","start":5002003,"end":5002003,"break":"none","ruby":[[7,1,"すで"],[9,1,"ひさ"],[14,1,"やま"],[16,1,"い"],[26,1,"み"],[33,1,"きた"],[35,1,"すす"]],"text":"『あなたがたは既に久しくこの山を行きめぐっているが、身をめぐらして北に進みなさい。"},{"ref":"Deut.2.4","start":5002004,"end":5002004,"break":"none","ruby":[[6,1,"たみ"],[8,1,"めい"],[11,1,"い"],[26,2,"しそん"],[37,1,"す"],[48,2,"きょうだい"],[51,2,"りょうない"],[54,1,"とお"],[63,1,"かれ"],[72,1,"おそ"],[95,1,"ふか"],[97,1,"つつし"]],"text":"おまえはまた民に命じて言え、「あなたがたは、エサウの子孫、すなわちセイルに住んでいるあなたがたの兄弟の領内を通ろうとしている。彼らはあなたがたを恐れるであろう。それゆえ、あなたがたはみずから深く慎み、"},{"ref":"Deut.2.5","start":5002005,"end":5002005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"あらそ"],[12,1,"かれ"],[15,1,"ち"],[18,1,"あし"],[20,1,"うら"],[22,1,"ふ"],[35,1,"あた"],[51,1,"やま"],[57,1,"あた"],[61,2,"りょうち"]],"text":"彼らと争ってはならない。彼らの地は、足の裏で踏むほどでも、あなたがたに与えないであろう。わたしがセイル山をエサウに与えて、領地とさせたからである。"},{"ref":"Deut.2.6","start":5002006,"end":5002006,"break":"none","ruby":[[6,1,"かれ"],[10,1,"かね"],[12,2,"しょくもつ"],[15,1,"か"],[18,1,"た"],[23,1,"かね"],[25,1,"みず"],[27,1,"か"],[30,1,"の"]],"text":"あなたがたは彼らから金で食物を買って食べ、また金で水を買って飲まなければならない。"},{"ref":"Deut.2.7","start":5002007,"end":5002007,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[19,1,"こと"],[29,1,"めぐ"],[38,1,"おお"],[42,2,"あらの"],[45,1,"とお"],[50,2,"みまも"],[65,1,"かみ"],[67,1,"しゅ"],[73,1,"ねん"],[75,1,"あいだ"],[81,1,"とも"],[94,1,"なに"],[96,1,"とぼ"]],"text":"あなたの神、主が、あなたのするすべての事において、あなたを恵み、あなたがこの大いなる荒野を通るのを、見守られたからである。あなたの神、主がこの四十年の間、あなたと共におられたので、あなたは何も乏しいことがなかった」』。"},{"ref":"Deut.2.8","start":5002008,"end":5002008,"break":"none","breaks":[[61,"paragraph"]],"ruby":[[14,2,"しそん"],[21,1,"す"],[26,2,"きょうだい"],[29,1,"はな"],[36,1,"みち"],[38,1,"さ"],[54,1,"はな"],[57,1,"すす"],[66,1,"てん"],[74,2,"あらの"],[77,1,"ほう"],[79,1,"む"],[83,1,"すす"]],"text":"こうしてわれわれは、エサウの子孫でセイルに住んでいる兄弟を離れ、アラバの道を避け、エラテとエジオン・ゲベルを離れて進んだ。われわれは転じて、モアブの荒野の方に向かって進んだ。"},{"ref":"Deut.2.9","start":5002009,"end":5002009,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[10,1,"い"],[20,2,"てきし"],[35,1,"あらそ"],[37,1,"たたか"],[46,1,"かれ"],[49,1,"ち"],[52,2,"りょうち"],[61,1,"あた"],[69,2,"しそん"],[75,1,"あた"],[79,2,"りょうち"]],"text":"その時、主はわたしに言われた、『モアブを敵視してはならない。またそれと争い戦ってはならない。彼らの地は、領地としてあなたに与えない。ロトの子孫にアルを与えて、領地とさせたからである。"},{"ref":"Deut.2.10","start":5002010,"end":5002010,"break":"none","ruby":[[12,1,"ところ"],[14,1,"す"],[22,1,"たみ"],[24,1,"おお"],[28,1,"たみ"],[34,1,"かず"],[36,1,"おお"],[48,1,"せ"],[50,1,"たか"]],"text":"（むかし、エミびとがこの所に住んでいた。この民は大いなる民であって、数も多く、アナクびとのように背も高く、"},{"ref":"Deut.2.11","start":5002011,"end":5002011,"break":"none","ruby":[[8,1,"おな"],[44,1,"よ"]],"text":"またアナクびとと同じくレパイムであると、みなされていたが、モアブびとは、これをエミびとと呼んでいた。"},{"ref":"Deut.2.12","start":5002012,"end":5002012,"break":"none","ruby":[[14,1,"す"],[25,2,"しそん"],[31,1,"お"],[33,1,"はら"],[39,1,"ほろ"],[43,1,"かれ"],[46,1,"かわ"],[52,1,"す"],[56,1,"しゅ"],[58,1,"たま"],[62,2,"しょゆう"],[65,1,"ち"],[81,1,"おな"]],"text":"ホリびとも、むかしはセイルに住んでいたが、エサウの子孫がこれを追い払い、これを滅ぼし、彼らに代ってそこに住んだ。主が賜わった所有の地に、イスラエルがおこなったのと同じである。）"},{"ref":"Deut.2.13","start":5002013,"end":5002013,"break":"none","ruby":[[10,1,"た"],[19,1,"がわ"],[21,1,"わた"],[39,1,"がわ"],[41,1,"わた"]],"text":"あなたがたは、いま、立ちあがってゼレデ川を渡りなさい』。そこでわれわれはゼレデ川を渡った。"},{"ref":"Deut.2.14","start":5002014,"end":5002014,"break":"none","ruby":[[9,1,"で"],[19,1,"がわ"],[21,1,"わた"],[26,1,"あいだ"],[28,1,"ひ"],[33,1,"ねん"],[41,2,"せだい"],[52,1,"し"],[54,1,"た"],[58,2,"しゅくえい"],[71,1,"しゅ"],[73,1,"かれ"],[76,1,"ちか"]],"text":"カデシ・バルネアを出てこのかた、ゼレデ川を渡るまでの間の日は三十八年であって、その世代のいくさびとはみな死に絶えて、宿営のうちにいなくなった。主が彼らに誓われたとおりである。"},{"ref":"Deut.2.15","start":5002015,"end":5002015,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"て"],[8,1,"かれ"],[11,1,"せ"],[14,2,"しゅくえい"],[21,1,"ほろ"],[24,1,"さ"],[31,1,"かれ"],[37,1,"し"],[39,1,"た"]],"text":"まことに主の手が彼らを攻め、宿営のうちから滅ぼし去られたので、彼らはついに死に絶えた。"},{"ref":"Deut.2.16","start":5002016,"end":5002016,"break":"paragraph","ruby":[[8,1,"たみ"],[14,1,"し"],[16,1,"た"]],"text":"いくさびとがみな民のうちから死に絶えたとき、"},{"ref":"Deut.2.17","start":5002017,"end":5002017,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はわたしに言われた、"},{"ref":"Deut.2.18","start":5002018,"end":5002018,"break":"none","ruby":[[14,2,"りょうち"],[19,1,"とお"]],"text":"『おまえは、きょう、モアブの領地アルを通ろうとしている。"},{"ref":"Deut.2.19","start":5002019,"end":5002019,"break":"none","ruby":[[5,2,"しそん"],[8,1,"ちか"],[11,1,"とき"],[17,1,"かれ"],[20,2,"てきし"],[32,1,"あらそ"],[50,2,"しそん"],[53,1,"ち"],[55,2,"りょうち"],[65,1,"あた"],[76,2,"しそん"],[79,2,"りょうち"],[84,1,"あた"]],"text":"アンモンの子孫に近づく時、おまえは彼らを敵視してはならない。また争ってはならない。わたしはアンモンの子孫の地を領地として、おまえに与えない。それをロトの子孫に領地として与えたからである。"},{"ref":"Deut.2.20","start":5002020,"end":5002020,"break":"none","ruby":[[11,1,"くに"],[31,1,"す"],[53,1,"かれ"],[63,1,"よ"]],"text":"（これもまたレパイムの国とみなされた。むかし、レパイムがここに住んでいたからである。しかし、アンモンびとは彼らをザムズミびとと呼んだ。"},{"ref":"Deut.2.21","start":5002021,"end":5002021,"break":"none","ruby":[[2,1,"たみ"],[4,1,"おお"],[8,1,"たみ"],[13,1,"かず"],[15,1,"おお"],[27,1,"せ"],[29,1,"たか"],[35,1,"しゅ"],[44,1,"まえ"],[51,1,"ほろ"],[66,1,"お"],[68,1,"はら"],[72,1,"かれ"],[75,1,"かわ"],[81,1,"す"]],"text":"この民は大いなる民であって数も多く、アナクびとのように背も高かったが、主はアンモンびとの前から、これを滅ぼされ、アンモンびとがこれを追い払って、彼らに代ってそこに住んだ。"},{"ref":"Deut.2.22","start":5002022,"end":5002022,"break":"none","ruby":[[2,1,"こと"],[9,1,"す"],[18,2,"しそん"],[26,1,"まえ"],[35,1,"ほろ"],[42,1,"おな"],[48,1,"かれ"],[56,1,"お"],[58,1,"はら"],[64,1,"かわ"],[67,2,"こんにち"],[74,1,"す"]],"text":"この事は、セイルに住んでいるエサウの子孫のためにその前から、ホリびとを滅ぼされたのと同じである。彼らはホリびとを追い払い、これに代って今日までそこに住んでいる。"},{"ref":"Deut.2.23","start":5002023,"end":5002023,"break":"none","ruby":[[8,1,"で"],[23,1,"およ"],[25,2,"むらむら"],[28,1,"す"],[38,1,"ほろ"],[46,1,"かわ"],[52,1,"す"]],"text":"またカフトルから出たカフトルびとは、ガザにまで及ぶ村々に住んでいたアビびとを滅ぼして、これに代ってそこに住んでいる。）"},{"ref":"Deut.2.24","start":5002024,"end":5002024,"break":"none","ruby":[[6,1,"た"],[12,1,"すす"],[19,1,"がわ"],[21,1,"わた"],[36,1,"おう"],[48,1,"くに"],[56,1,"て"],[58,1,"わた"],[65,2,"せいふく"],[68,1,"はじ"],[72,1,"かれ"],[74,1,"あらそ"],[77,1,"たたか"]],"text":"あなたがたは立ちあがり、進んでアルノン川を渡りなさい。わたしはヘシボンの王アモリびとシホンとその国とを、おまえの手に渡した。それを征服し始めよ。彼と争って戦え。"},{"ref":"Deut.2.25","start":5002025,"end":5002025,"break":"none","ruby":[[10,1,"ぜん"],[11,2,"てんか"],[14,1,"たみ"],[24,1,"おそ"],[34,1,"かれ"],[45,1,"き"],[48,1,"ふる"],[58,1,"くる"]],"text":"きょうから、わたしは全天下の民に、おまえをおびえ恐れさせるであろう。彼らはおまえのうわさを聞いて震え、おまえのために苦しむであろう』。"},{"ref":"Deut.2.26","start":5002026,"end":5002026,"break":"none","ruby":[[13,2,"あらの"],[23,1,"おう"],[28,2,"ししゃ"],[36,2,"へいわ"],[39,2,"ことば"],[42,1,"の"]],"text":"そこでわたしは、ケデモテの荒野から、ヘシボンの王シホンに使者をつかわし、平和の言葉を述べさせた。"},{"ref":"Deut.2.27","start":5002027,"end":5002027,"break":"none","ruby":[[5,1,"くに"],[7,1,"とお"],[20,2,"おおじ"],[32,1,"みぎ"],[35,1,"ひだり"],[38,1,"まが"]],"text":"『あなたの国を通らせてください。わたしは大路をとおっていきます、右にも左にも曲りません。"},{"ref":"Deut.2.28","start":5002028,"end":5002028,"break":"none","ruby":[[0,1,"かね"],[2,2,"しょくもつ"],[5,1,"う"],[12,1,"た"],[17,1,"かね"],[22,1,"みず"],[24,1,"あた"],[31,1,"の"],[40,2,"とほ"],[43,1,"とお"]],"text":"金で食物を売ってわたしに食べさせ、金をとって水を与えてわたしに飲ませてください。徒歩で通らせてくださるだけでよいのです。"},{"ref":"Deut.2.29","start":5002029,"end":5002029,"break":"none","ruby":[[4,1,"す"],[10,2,"しそん"],[17,1,"す"],[57,1,"わた"],[66,1,"かみ"],[68,1,"しゅ"],[70,1,"たま"],[73,1,"ち"],[75,1,"い"]],"text":"セイルに住むエサウの子孫と、アルに住むモアブびとが、わたしにしたようにしてください。そうすれば、わたしはヨルダンを渡って、われわれの神、主が賜わる地に行きます』。"},{"ref":"Deut.2.30","start":5002030,"end":5002030,"break":"none","ruby":[[9,1,"おう"],[20,1,"とお"],[26,1,"この"],[37,1,"かみ"],[39,1,"しゅ"],[41,1,"かれ"],[47,1,"て"],[49,1,"わた"],[56,1,"き"],[58,1,"つよ"],[64,1,"こころ"],[80,2,"こんにち"],[82,1,"み"]],"text":"しかし、ヘシボンの王シホンは、われわれを通らせるのを好まなかった。あなたの神、主が彼をあなたの手に渡すため、その気を強くし、その心をかたくなにされたからである。今日見るとおりである。"},{"ref":"Deut.2.31","start":5002031,"end":5002031,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[8,1,"い"],[25,1,"ち"],[33,1,"わた"],[35,1,"はじ"],[46,2,"せいふく"],[55,1,"ち"],[57,2,"じぶん"]],"text":"時に主はわたしに言われた、『わたしはシホンと、その地とを、おまえに渡し始めた。おまえはそれを征服しはじめ、その地を自分のものとせよ』。"},{"ref":"Deut.2.32","start":5002032,"end":5002032,"break":"none","ruby":[[13,1,"せ"],[23,1,"たみ"],[30,1,"ひき"],[33,1,"で"],[41,1,"たたか"]],"text":"そこでシホンは、われわれを攻めようとして、その民をことごとく率い、出てきてヤハズで戦ったが、"},{"ref":"Deut.2.33","start":5002033,"end":5002033,"break":"none","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[9,1,"かれ"],[11,1,"わた"],[23,1,"かれ"],[27,1,"こ"],[37,1,"たみ"],[40,1,"う"],[42,1,"ころ"]],"text":"われわれの神、主が彼を渡されたので、われわれは彼とその子らと、そのすべての民とを撃ち殺した。"},{"ref":"Deut.2.34","start":5002034,"end":5002034,"break":"none","ruby":[[2,1,"とき"],[9,1,"かれ"],[15,1,"まち"],[17,1,"と"],[26,1,"まち"],[28,1,"おとこ"],[30,1,"おんな"],[34,2,"こども"],[37,1,"まった"],[39,1,"ほろ"],[49,1,"のこ"]],"text":"その時、われわれは彼のすべての町を取り、そのすべての町の男、女および子供を全く滅ぼして、ひとりをも残さなかった。"},{"ref":"Deut.2.35","start":5002035,"end":5002035,"break":"none","ruby":[[4,2,"かちく"],[13,1,"と"],[16,2,"まちまち"],[23,1,"もの"],[25,1,"とも"],[33,1,"え"],[35,2,"じぶん"],[38,1,"もの"]],"text":"ただその家畜は、われわれが取った町々のぶんどり物と共に、われわれが獲て自分の物とした。"},{"ref":"Deut.2.36","start":5002036,"end":5002036,"break":"none","ruby":[[5,1,"たに"],[20,1,"たに"],[22,1,"なか"],[26,1,"まち"],[34,1,"いた"],[44,1,"せ"],[47,1,"と"],[53,1,"まち"],[68,1,"かみ"],[70,1,"しゅ"],[82,1,"わた"]],"text":"アルノンの谷のほとりにあるアロエルおよび谷の中にある町からギレアデに至るまで、われわれが攻めて取れなかった町は一つもなかった。われわれの神、主がことごとくわれわれに渡されたのである。"},{"ref":"Deut.2.37","start":5002037,"end":5002037,"break":"none","ruby":[[7,2,"しそん"],[10,1,"ち"],[19,1,"がわ"],[21,1,"ぜん"],[22,1,"きし"],[27,2,"さんち"],[30,2,"まちまち"],[43,1,"かみ"],[45,1,"しゅ"],[47,1,"きん"],[52,1,"ところ"],[55,2,"ちかよ"]],"text":"ただアンモンの子孫の地、すなわちヤボク川の全岸、および山地の町々、またすべてわれわれの神、主が禁じられた所には近寄らなかった。"}]