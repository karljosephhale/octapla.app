[{"ref":"Acts.5.1","start":44005001,"end":44005001,"break":"paragraph","ruby":[[12,1,"ひと"],[16,1,"つま"],[23,1,"とも"],[25,2,"しさん"],[28,1,"う"]],"text":"ところが、アナニヤという人とその妻サッピラとは共に資産を売ったが、"},{"ref":"Acts.5.2","start":44005002,"end":44005002,"break":"none","ruby":[[0,2,"きょうぼう"],[7,2,"だいきん"],[15,2,"いちぶ"],[20,1,"も"],[26,2,"しと"],[31,1,"あし"],[35,1,"お"]],"text":"共謀して、その代金をごまかし、一部だけを持ってきて、使徒たちの足もとに置いた。"},{"ref":"Acts.5.3","start":44005003,"end":44005003,"break":"none","ruby":[[8,1,"い"],[28,2,"じぶん"],[31,1,"こころ"],[37,1,"うば"],[42,2,"せいれい"],[45,1,"あざむ"],[48,2,"じしょ"],[51,2,"だいきん"]],"text":"そこで、ペテロが言った、「アナニヤよ、どうしてあなたは、自分の心をサタンに奪われて、聖霊を欺き、地所の代金をごまかしたのか。"},{"ref":"Acts.5.4","start":44005004,"end":44005004,"break":"none","ruby":[[0,1,"う"],[4,1,"のこ"],[21,1,"う"],[34,2,"じゆう"],[61,1,"き"],[73,1,"ひと"],[75,1,"あざむ"],[85,1,"かみ"],[87,1,"あざむ"]],"text":"売らずに残しておけば、あなたのものであり、売ってしまっても、あなたの自由になったはずではないか。どうして、こんなことをする気になったのか。あなたは人を欺いたのではなくて、神を欺いたのだ」。"},{"ref":"Acts.5.5","start":44005005,"end":44005005,"break":"none","ruby":[[7,2,"ことば"],[10,1,"き"],[19,1,"たお"],[22,1,"いき"],[24,1,"た"],[33,1,"つた"],[35,1,"き"],[38,2,"ひとびと"],[44,2,"ひじょう"],[51,1,"かん"]],"text":"アナニヤはこの言葉を聞いているうちに、倒れて息が絶えた。このことを伝え聞いた人々は、みな非常なおそれを感じた。"},{"ref":"Acts.5.6","start":44005006,"end":44005006,"break":"none","ruby":[[5,2,"わかもの"],[10,1,"た"],[16,2,"したい"],[19,1,"つつ"],[22,1,"はこ"],[24,1,"だ"],[27,1,"ほうむ"]],"text":"それから、若者たちが立って、その死体を包み、運び出して葬った。"},{"ref":"Acts.5.7","start":44005007,"end":44005007,"break":"paragraph","ruby":[[1,2,"じかん"],[16,1,"かれ"],[18,1,"つま"],[23,3,"できごと"],[27,1,"し"]],"text":"三時間ばかりたってから、たまたま彼の妻が、この出来事を知らずに、はいってきた。"},{"ref":"Acts.5.8","start":44005008,"end":44005008,"break":"none","ruby":[[8,2,"かのじょ"],[15,1,"い"],[22,2,"じしょ"],[31,2,"ねだん"],[34,1,"う"],[48,2,"かのじょ"],[59,2,"ねだん"],[65,1,"こた"]],"text":"そこで、ペテロが彼女にむかって言った、「あの地所は、これこれの値段で売ったのか。そのとおりか」。彼女は「そうです、その値段です」と答えた。"},{"ref":"Acts.5.9","start":44005009,"end":44005009,"break":"none","ruby":[[4,1,"い"],[19,1,"こころ"],[21,1,"あ"],[25,1,"しゅ"],[27,2,"みたま"],[30,1,"こころ"],[36,2,"なにごと"],[43,1,"み"],[50,1,"おっと"],[52,1,"ほうむ"],[55,1,"ひと"],[59,1,"あし"],[65,2,"かどぐち"],[77,1,"はこ"],[79,1,"だ"]],"text":"ペテロは言った、「あなたがたふたりが、心を合わせて主の御霊を試みるとは、何事であるか。見よ、あなたの夫を葬った人たちの足が、そこの門口にきている。あなたも運び出されるであろう」。"},{"ref":"Acts.5.10","start":44005010,"end":44005010,"break":"none","ruby":[[3,1,"おんな"],[10,1,"かれ"],[12,1,"あし"],[16,1,"たお"],[20,1,"いき"],[22,1,"た"],[29,2,"わかもの"],[41,1,"おんな"],[43,1,"し"],[54,1,"み"],[59,1,"はこ"],[61,1,"だ"],[66,1,"おっと"],[71,1,"ほうむ"]],"text":"すると女は、たちまち彼の足もとに倒れて、息が絶えた。そこに若者たちがはいってきて、女が死んでしまっているのを見、それを運び出してその夫のそばに葬った。"},{"ref":"Acts.5.11","start":44005011,"end":44005011,"break":"none","ruby":[[0,2,"きょうかい"],[2,2,"ぜんたい"],[11,1,"つた"],[13,1,"き"],[16,1,"ひと"],[23,2,"ひじょう"],[30,1,"かん"]],"text":"教会全体ならびにこれを伝え聞いた人たちは、みな非常なおそれを感じた。"},{"ref":"Acts.5.12","start":44005012,"end":44005012,"break":"paragraph","ruby":[[5,1,"おお"],[12,2,"きせき"],[17,2,"つぎつぎ"],[20,2,"しと"],[25,1,"て"],[29,2,"ひとびと"],[32,1,"なか"],[34,1,"おこな"],[43,2,"いちどう"],[46,1,"こころ"],[59,1,"ろう"],[61,1,"あつ"]],"text":"そのころ、多くのしるしと奇跡とが、次々に使徒たちの手により人々の中で行われた。そして、一同は心を一つにして、ソロモンの廊に集まっていた。"},{"ref":"Acts.5.13","start":44005013,"end":44005013,"break":"none","ruby":[[3,1,"もの"],[16,1,"まじ"],[20,1,"い"],[32,2,"みんしゅう"],[35,1,"かれ"],[38,2,"そんけい"]],"text":"ほかの者たちは、だれひとり、その交わりに入ろうとはしなかったが、民衆は彼らを尊敬していた。"},{"ref":"Acts.5.14","start":44005014,"end":44005014,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"しん"],[9,2,"なかま"],[12,1,"くわ"],[15,1,"もの"],[18,2,"だんじょ"],[27,1,"おお"]],"text":"しかし、主を信じて仲間に加わる者が、男女とも、ますます多くなってきた。"},{"ref":"Acts.5.15","start":44005015,"end":44005015,"break":"none","ruby":[[5,2,"びょうにん"],[8,2,"おおどお"],[12,1,"はこ"],[14,1,"だ"],[17,2,"しんだい"],[20,2,"ねどこ"],[23,1,"うえ"],[25,1,"お"],[33,1,"とお"],[38,1,"かれ"],[40,1,"かげ"]],"text":"ついには、病人を大通りに運び出し、寝台や寝床の上に置いて、ペテロが通るとき、彼の影なりと、そのうちのだれかにかかるようにしたほどであった。"},{"ref":"Acts.5.16","start":44005016,"end":44005016,"break":"none","ruby":[[7,2,"ふきん"],[10,2,"まちまち"],[16,1,"おお"],[20,1,"ひと"],[23,2,"びょうにん"],[26,1,"けが"],[29,1,"れい"],[31,1,"くる"],[39,1,"ひと"],[43,1,"ひ"],[45,1,"つ"],[49,1,"あつ"],[59,2,"ぜんぶ"],[62,1,"もの"],[68,1,"のこ"]],"text":"またエルサレム附近の町々からも、大ぜいの人が、病人や汚れた霊に苦しめられている人たちを引き連れて、集まってきたが、その全部の者が、ひとり残らずいやされた。"},{"ref":"Acts.5.17","start":44005017,"end":44005017,"break":"paragraph","ruby":[[4,3,"だいさいし"],[10,2,"なかま"],[13,1,"もの"],[24,1,"は"],[26,1,"ひと"],[33,2,"しっと"],[36,1,"ねん"],[38,1,"み"],[43,1,"た"]],"text":"そこで、大祭司とその仲間の者、すなわち、サドカイ派の人たちが、みな嫉妬の念に満たされて立ちあがり、"},{"ref":"Acts.5.18","start":44005018,"end":44005018,"break":"none","ruby":[[0,2,"しと"],[5,1,"て"],[10,1,"とら"],[13,2,"こうきょう"],[16,3,"りゅうちじょう"],[20,1,"い"]],"text":"使徒たちに手をかけて捕え、公共の留置場に入れた。"},{"ref":"Acts.5.19","start":44005019,"end":44005019,"break":"none","ruby":[[4,1,"よる"],[6,1,"しゅ"],[8,1,"つかい"],[10,1,"ごく"],[12,1,"と"],[14,1,"ひら"],[17,1,"かれ"],[20,1,"つ"],[22,1,"だ"],[25,1,"い"]],"text":"ところが夜、主の使が獄の戸を開き、彼らを連れ出して言った、"},{"ref":"Acts.5.20","start":44005020,"end":44005020,"break":"none","ruby":[[3,1,"い"],[13,1,"みや"],[15,1,"にわ"],[17,1,"た"],[22,1,"いのち"],[24,2,"ことば"],[27,1,"も"],[32,2,"ひとびと"],[35,1,"かた"]],"text":"「さあ行きなさい。そして、宮の庭に立ち、この命の言葉を漏れなく、人々に語りなさい」。"},{"ref":"Acts.5.21","start":44005021,"end":44005021,"break":"none","breaks":[[27,"paragraph"]],"ruby":[[0,1,"かれ"],[6,1,"き"],[9,2,"よあ"],[14,1,"みや"],[20,1,"おし"],[27,2,"いっぽう"],[32,3,"だいさいし"],[38,2,"なかま"],[41,1,"もの"],[45,1,"あつ"],[52,2,"ぎかい"],[60,1,"びと"],[62,2,"ちょうろう"],[64,2,"いちどう"],[68,2,"しょうしゅう"],[72,2,"しと"],[77,1,"ひ"],[79,1,"だ"],[90,1,"ひと"],[92,1,"ごく"]],"text":"彼らはこれを聞き、夜明けごろ宮にはいって教えはじめた。一方では、大祭司とその仲間の者とが、集まってきて、議会とイスラエル人の長老一同とを召集し、使徒たちを引き出してこさせるために、人を獄につかわした。"},{"ref":"Acts.5.22","start":44005022,"end":44005022,"break":"none","ruby":[[4,2,"したやく"],[9,1,"い"],[12,1,"み"],[16,2,"しと"],[21,1,"ごく"],[29,1,"ひ"],[31,1,"かえ"],[34,2,"ほうこく"]],"text":"そこで、下役どもが行って見ると、使徒たちが獄にいないので、引き返して報告した、"},{"ref":"Acts.5.23","start":44005023,"end":44005023,"break":"none","ruby":[[1,1,"ごく"],[10,1,"じょう"],[18,2,"とぐち"],[23,2,"ばんにん"],[26,1,"た"],[42,1,"み"],[46,1,"なか"]],"text":"「獄には、しっかりと錠がかけてあり、戸口には、番人が立っていました。ところが、あけて見たら、中にはだれもいませんでした」。"},{"ref":"Acts.5.24","start":44005024,"end":44005024,"break":"none","ruby":[[0,2,"みやもり"],[6,3,"さいしちょう"],[16,2,"ほうこく"],[19,1,"き"],[35,1,"こと"],[48,1,"まど"]],"text":"宮守がしらと祭司長たちとは、この報告を聞いて、これは、いったい、どんな事になるのだろうと、あわて惑っていた。"},{"ref":"Acts.5.25","start":44005025,"end":44005025,"break":"none","ruby":[[6,1,"ひと"],[10,1,"し"],[16,1,"い"],[32,1,"ごく"],[34,1,"い"],[39,1,"ひと"],[44,1,"みや"],[46,1,"にわ"],[48,1,"た"],[52,2,"みんしゅう"],[55,1,"おし"]],"text":"そこへ、ある人がきて知らせた、「行ってごらんなさい。あなたがたが獄に入れたあの人たちが、宮の庭に立って、民衆を教えています」。"},{"ref":"Acts.5.26","start":44005026,"end":44005026,"break":"none","ruby":[[3,2,"みやもり"],[10,2,"したやく"],[15,2,"いっしょ"],[18,1,"で"],[22,1,"い"],[26,2,"しと"],[31,1,"つ"],[41,2,"ひとびと"],[44,1,"いし"],[46,1,"う"],[48,1,"ころ"],[54,1,"おそ"],[58,2,"てあら"]],"text":"そこで宮守がしらが、下役どもと一緒に出かけて行って、使徒たちを連れてきた。しかし、人々に石で打ち殺されるのを恐れて、手荒なことはせず、"},{"ref":"Acts.5.27","start":44005027,"end":44005027,"break":"none","ruby":[[0,1,"かれ"],[3,1,"つ"],[9,2,"ぎかい"],[12,1,"なか"],[14,1,"た"],[23,3,"だいさいし"],[27,1,"と"]],"text":"彼らを連れてきて、議会の中に立たせた。すると、大祭司が問うて"},{"ref":"Acts.5.28","start":44005028,"end":44005028,"break":"none","ruby":[[0,1,"い"],[7,1,"な"],[9,1,"つか"],[12,1,"おし"],[26,1,"めい"],[49,1,"こと"],[57,1,"なか"],[65,1,"おしえ"],[84,1,"たし"],[90,1,"ひと"],[92,1,"ち"],[94,2,"せきにん"],[103,1,"お"]],"text":"言った、「あの名を使って教えてはならないと、きびしく命じておいたではないか。それだのに、なんという事だ。エルサレム中にあなたがたの教を、はんらんさせている。あなたがたは確かに、あの人の血の責任をわたしたちに負わせようと、たくらんでいるのだ」。"},{"ref":"Acts.5.29","start":44005029,"end":44005029,"break":"none","ruby":[[3,1,"たい"],[14,2,"しと"],[19,1,"い"],[24,2,"にんげん"],[27,1,"したが"],[33,1,"かみ"],[35,1,"したが"]],"text":"これに対して、ペテロをはじめ使徒たちは言った、「人間に従うよりは、神に従うべきである。"},{"ref":"Acts.5.30","start":44005030,"end":44005030,"break":"none","ruby":[[6,2,"せんぞ"],[9,1,"かみ"],[18,1,"き"],[23,1,"ころ"]],"text":"わたしたちの先祖の神は、あなたがたが木にかけて殺したイエスをよみがえらせ、"},{"ref":"Acts.5.31","start":44005031,"end":44005031,"break":"none","ruby":[[10,1,"く"],[12,1,"あらた"],[20,1,"つみ"],[26,1,"あた"],[39,1,"みちび"],[41,1,"て"],[44,2,"すくいぬし"],[51,2,"じしん"],[54,1,"みぎ"],[56,1,"あ"]],"text":"そして、イスラエルを悔い改めさせてこれに罪のゆるしを与えるために、このイエスを導き手とし救主として、ご自身の右に上げられたのである。"},{"ref":"Acts.5.32","start":44005032,"end":44005032,"break":"none","ruby":[[10,1,"こと"],[12,2,"しょうにん"],[18,1,"かみ"],[21,2,"じしん"],[24,1,"したが"],[26,1,"もの"],[28,1,"たま"],[32,2,"せいれい"],[40,2,"しょうにん"]],"text":"わたしたちはこれらの事の証人である。神がご自身に従う者に賜わった聖霊もまた、その証人である」。"},{"ref":"Acts.5.33","start":44005033,"end":44005033,"break":"paragraph","ruby":[[3,1,"き"],[6,1,"もの"],[11,1,"はげ"],[14,1,"いか"],[21,2,"しと"],[26,1,"ころ"],[30,1,"おも"]],"text":"これを聞いた者たちは、激しい怒りのあまり、使徒たちを殺そうと思った。"},{"ref":"Acts.5.34","start":44005034,"end":44005034,"break":"none","ruby":[[5,2,"こくみん"],[7,2,"ぜんたい"],[10,2,"そんけい"],[17,2,"りっぽう"],[19,2,"がくしゃ"],[33,1,"びと"],[36,2,"ぎかい"],[39,1,"た"],[43,2,"しと"],[56,1,"そと"],[58,1,"だ"],[63,2,"ようきゅう"]],"text":"ところが、国民全体に尊敬されていた律法学者ガマリエルというパリサイ人が、議会で立って、使徒たちをしばらくのあいだ外に出すように要求してから、"},{"ref":"Acts.5.35","start":44005035,"end":44005035,"break":"none","ruby":[[0,2,"いちどう"],[7,1,"い"],[18,2,"しょくん"],[23,1,"ひと"],[29,1,"あつか"],[35,1,"き"]],"text":"一同にむかって言った、「イスラエルの諸君、あの人たちをどう扱うか、よく気をつけるがよい。"},{"ref":"Acts.5.36","start":44005036,"end":44005036,"break":"none","ruby":[[0,1,"さき"],[8,1,"おこ"],[12,2,"じぶん"],[15,1,"なに"],[17,1,"えら"],[19,1,"もの"],[24,1,"い"],[33,1,"かれ"],[35,1,"したが"],[38,1,"おとこ"],[40,1,"かず"],[45,1,"にん"],[54,2,"けっきょく"],[57,1,"かれ"],[59,1,"ころ"],[67,1,"したが"],[70,1,"もの"],[74,2,"しさん"],[79,1,"まった"],[81,1,"あと"],[82,1,"ほう"]],"text":"先ごろ、チゥダが起って、自分を何か偉い者のように言いふらしたため、彼に従った男の数が、四百人ほどもあったが、結局、彼は殺されてしまい、従った者もみな四散して、全く跡方もなくなっている。"},{"ref":"Acts.5.37","start":44005037,"end":44005037,"break":"none","ruby":[[5,2,"じんこう"],[7,2,"ちょうさ"],[10,1,"とき"],[17,1,"ひと"],[21,2,"みんしゅう"],[24,1,"ひき"],[27,2,"はんらん"],[30,1,"おこ"],[37,1,"ひと"],[39,1,"ほろ"],[42,1,"したが"],[45,1,"もの"],[49,1,"ち"]],"text":"そののち、人口調査の時に、ガリラヤ人ユダが民衆を率いて反乱を起したが、この人も滅び、従った者もみな散らされてしまった。"},{"ref":"Acts.5.38","start":44005038,"end":44005038,"break":"none","ruby":[[6,1,"さい"],[8,2,"しょくん"],[11,1,"もう"],[13,1,"あ"],[19,1,"ひと"],[24,1,"て"],[26,1,"ひ"],[47,1,"くわだ"],[56,2,"にんげん"],[60,1,"で"],[67,2,"じめつ"]],"text":"そこで、この際、諸君に申し上げる。あの人たちから手を引いて、そのなすままにしておきなさい。その企てや、しわざが、人間から出たものなら、自滅するだろう。"},{"ref":"Acts.5.39","start":44005039,"end":44005039,"break":"none","ruby":[[6,1,"かみ"],[9,1,"で"],[18,1,"ひと"],[22,1,"ほろ"],[36,1,"ちが"],[40,2,"しょくん"],[43,1,"かみ"],[45,1,"てき"],[57,1,"し"],[66,1,"かれ"],[71,2,"かんこく"]],"text":"しかし、もし神から出たものなら、あの人たちを滅ぼすことはできまい。まかり違えば、諸君は神を敵にまわすことになるかも知れない」。そこで彼らはその勧告にしたがい、"},{"ref":"Acts.5.40","start":44005040,"end":44005040,"break":"none","ruby":[[0,2,"しと"],[5,1,"よ"],[7,1,"い"],[13,1,"う"],[19,2,"こんご"],[25,1,"な"],[30,1,"かた"],[35,2,"あいな"],[40,1,"い"]],"text":"使徒たちを呼び入れて、むち打ったのち、今後イエスの名によって語ることは相成らぬと言いわたして、ゆるしてやった。"},{"ref":"Acts.5.41","start":44005041,"end":44005041,"break":"none","ruby":[[0,2,"しと"],[6,2,"みな"],[12,1,"はじ"],[14,1,"くわ"],[20,1,"た"],[22,1,"もの"],[30,1,"よろこ"],[36,2,"ぎかい"],[40,1,"で"]],"text":"使徒たちは、御名のために恥を加えられるに足る者とされたことを喜びながら、議会から出てきた。"},{"ref":"Acts.5.42","start":44005042,"end":44005042,"break":"none","ruby":[[4,2,"まいにち"],[7,1,"みや"],[9,1,"いえ"],[27,1,"ひ"],[32,1,"おし"],[36,1,"の"],[38,1,"つた"]],"text":"そして、毎日、宮や家で、イエスがキリストであることを、引きつづき教えたり宣べ伝えたりした。"}]