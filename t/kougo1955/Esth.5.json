[{"ref":"Esth.5.1","start":17005001,"end":17005001,"break":"paragraph","ruby":[[1,1,"か"],[2,1,"め"],[9,2,"おうひ"],[12,1,"ふく"],[14,1,"き"],[16,2,"おうきゅう"],[19,2,"うちにわ"],[22,1,"はい"],[25,1,"おう"],[27,2,"ひろま"],[34,1,"た"],[38,1,"おう"],[40,2,"おうきゅう"],[43,2,"ぎょくざ"],[46,1,"ざ"],[49,2,"おうきゅう"],[52,2,"いりぐち"]],"text":"三日目にエステルは王妃の服を着、王宮の内庭に入り、王の広間にむかって立った。王は王宮の玉座に座して王宮の入口にむかっていたが、"},{"ref":"Esth.5.2","start":17005002,"end":17005002,"break":"none","ruby":[[0,2,"おうひ"],[7,1,"にわ"],[9,1,"た"],[16,1,"み"],[18,2,"かのじょ"],[21,1,"めぐ"],[24,1,"しめ"],[29,1,"て"],[33,1,"きん"],[35,1,"しゃく"],[42,1,"ほう"],[44,1,"の"],[56,1,"すす"],[63,1,"しゃく"],[65,1,"あたま"]],"text":"王妃エステルが庭に立っているのを見て彼女に恵みを示し、その手にある金の笏をエステルの方に伸ばしたので、エステルは進みよってその笏の頭にさわった。"},{"ref":"Esth.5.3","start":17005003,"end":17005003,"break":"none","ruby":[[0,1,"おう"],[2,2,"かのじょ"],[5,1,"い"],[10,2,"おうひ"],[18,1,"なに"],[20,1,"もと"],[30,1,"ねが"],[33,1,"なに"],[36,1,"くに"],[38,1,"なか"],[46,1,"あた"]],"text":"王は彼女に言った、「王妃エステルよ、何を求めるのか。あなたの願いは何か。国の半ばでもあなたに与えよう」。"},{"ref":"Esth.5.4","start":17005004,"end":17005004,"break":"none","ruby":[[5,1,"い"],[12,1,"おう"],[31,1,"おう"],[36,1,"もう"],[39,2,"しゅえん"],[48,2,"いっしょ"],[52,1,"のぞ"]],"text":"エステルは言った、「もし王がよしとされるならば、きょうわたしが王のために設けた酒宴に、ハマンとご一緒にお臨みください」。"},{"ref":"Esth.5.5","start":17005005,"end":17005005,"break":"none","ruby":[[3,1,"おう"],[10,1,"はや"],[12,1,"つ"],[23,1,"い"],[32,1,"い"],[38,1,"おう"],[49,1,"もう"],[52,2,"しゅえん"],[55,1,"のぞ"]],"text":"そこで王は「ハマンを速く連れてきて、エステルの言うようにせよ」と言い、やがて王とハマンはエステルの設けた酒宴に臨んだ。"},{"ref":"Esth.5.6","start":17005006,"end":17005006,"break":"none","ruby":[[0,2,"しゅえん"],[3,1,"とき"],[5,1,"おう"],[12,1,"い"],[21,1,"もと"],[27,1,"なに"],[30,1,"かなら"],[32,1,"き"],[41,1,"ねが"],[44,1,"なに"],[47,1,"くに"],[49,1,"なか"],[53,1,"き"]],"text":"酒宴の時、王はエステルに言った、「あなたの求めることは何か。必ず聞かれる。あなたの願いは何か。国の半ばでも聞きとどけられる」。"},{"ref":"Esth.5.7","start":17005007,"end":17005007,"break":"none","ruby":[[5,1,"こた"],[8,1,"い"],[17,1,"もと"],[24,1,"ねが"]],"text":"エステルは答えて言った、「わたしの求め、わたしの願いはこれです。"},{"ref":"Esth.5.8","start":17005008,"end":17005008,"break":"none","ruby":[[6,1,"おう"],[8,1,"め"],[10,1,"まえ"],[12,1,"めぐ"],[15,1,"え"],[19,1,"おう"],[27,1,"もと"],[30,1,"ゆる"],[37,1,"ねが"],[40,1,"き"],[63,2,"いっしょ"],[76,1,"もう"],[83,2,"しゅえん"],[88,1,"のぞ"],[101,1,"おう"],[104,2,"ことば"]],"text":"もしわたしが王の目の前に恵みを得、また王がもしわたしの求めを許し、わたしの願いを聞きとどけるのをよしとされるならば、ハマンとご一緒に、あすまた、わたしが設けようとする酒宴に、お臨みください。わたしはあす王のお言葉どおりにいたしましょう」。"},{"ref":"Esth.5.9","start":17005009,"end":17005009,"break":"paragraph","ruby":[[10,1,"ひ"],[12,1,"こころ"],[14,1,"よろこ"],[16,1,"たの"],[20,1,"で"],[36,1,"おう"],[38,1,"もん"],[43,2,"じぶん"],[50,1,"た"],[61,2,"みうご"],[70,1,"み"],[81,1,"たい"],[83,1,"いか"],[86,1,"み"]],"text":"こうしてハマンはその日、心に喜び楽しんで出てきたが、ハマンはモルデカイが王の門にいて、自分にむかって立ちあがりもせず、また身動きもしないのを見たので、モルデカイに対し怒りに満たされた。"},{"ref":"Esth.5.10","start":17005010,"end":17005010,"break":"none","ruby":[[7,1,"た"],[9,1,"しの"],[12,1,"いえ"],[14,1,"かえ"],[17,1,"ひと"],[24,1,"とも"],[30,1,"つま"],[35,1,"よ"]],"text":"しかしハマンは耐え忍んで家に帰り、人をやってその友だちおよび妻ゼレシを呼んでこさせ、"},{"ref":"Esth.5.11","start":17005011,"end":17005011,"break":"none","ruby":[[9,1,"とみ"],[11,2,"えいが"],[23,1,"おお"],[32,1,"おう"],[34,2,"じぶん"],[37,1,"おも"],[48,1,"おう"],[50,2,"だいじん"],[55,2,"じしん"],[64,2,"じぶん"],[67,2,"しょうしん"],[77,1,"かれ"],[80,1,"かた"]],"text":"そしてハマンはその富の栄華と、そのむすこたちの多いことと、すべて王が自分を重んじられたこと、また王の大臣および侍臣たちにまさって自分を昇進させられたことを彼らに語った。"},{"ref":"Esth.5.12","start":17005012,"end":17005012,"break":"none","ruby":[[6,1,"い"],[11,2,"おうひ"],[18,2,"しゅえん"],[21,1,"もう"],[36,1,"おう"],[38,1,"とも"],[43,1,"のぞ"],[60,1,"おう"],[62,1,"とも"],[64,2,"おうひ"],[67,1,"まね"]],"text":"ハマンはまた言った、「王妃エステルは酒宴を設けたが、わたしのほかはだれも王と共にこれに臨ませなかった。あすもまたわたしは王と共に王妃に招かれている。"},{"ref":"Esth.5.13","start":17005013,"end":17005013,"break":"none","ruby":[[6,1,"ひと"],[13,1,"おう"],[15,1,"もん"],[17,1,"ざ"],[24,1,"み"],[26,1,"あいだ"],[33,1,"こと"],[40,1,"たの"]],"text":"しかしユダヤ人モルデカイが王の門に座しているのを見る間は、これらの事もわたしには楽しくない」。"},{"ref":"Esth.5.14","start":17005014,"end":17005014,"break":"none","ruby":[[2,1,"とき"],[4,1,"つま"],[13,1,"とも"],[15,1,"かれ"],[17,1,"い"],[22,1,"たか"],[31,1,"き"],[33,1,"た"],[41,1,"あさ"],[51,1,"うえ"],[53,1,"か"],[59,1,"おう"],[61,1,"もう"],[63,1,"あ"],[72,1,"おう"],[74,2,"いっしょ"],[77,1,"たの"],[83,2,"しゅえん"],[100,1,"こと"],[110,1,"き"],[112,1,"た"]],"text":"その時、妻ゼレシとすべての友は彼に言った、「高さ五十キュビトの木を立てさせ、あすの朝、モルデカイをその上に掛けるように王に申し上げなさい。そして王と一緒に楽しんでその酒宴においでなさい」。ハマンはこの事をよしとして、その木を立てさせた。"}]