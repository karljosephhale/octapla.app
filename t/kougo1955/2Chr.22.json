[{"ref":"2Chr.22.1","start":14022001,"end":14022001,"break":"paragraph","ruby":[[6,1,"たみ"],[12,1,"すえ"],[14,1,"こ"],[20,1,"かれ"],[22,1,"かわ"],[25,1,"おう"],[40,2,"いっしょ"],[43,2,"じんえい"],[46,1,"せ"],[52,1,"たい"],[54,1,"もの"],[56,1,"うえ"],[58,1,"こ"],[67,1,"ころ"],[76,1,"おう"],[81,1,"こ"],[87,1,"おう"]],"text":"エルサレムの民はヨラムの末の子アハジヤを彼の代りに王とした。かつてアラビヤびとと一緒に陣営に攻めてきた一隊の者が上の子たちをことごとく殺したので、ユダの王ヨラムの子アハジヤが王となったのである。"},{"ref":"2Chr.22.2","start":14022002,"end":14022002,"break":"none","ruby":[[5,1,"おう"],[10,1,"とき"],[14,1,"さい"],[24,1,"ねん"],[26,1,"あいだ"],[27,1,"よ"],[29,1,"おさ"],[35,1,"はは"],[41,1,"むすめ"],[43,1,"な"]],"text":"アハジヤは王となった時四十二歳で、エルサレムで一年の間世を治めた。その母はオムリの娘で名をアタリヤといった。"},{"ref":"2Chr.22.3","start":14022003,"end":14022003,"break":"none","ruby":[[11,1,"いえ"],[13,1,"みち"],[15,1,"あゆ"],[21,1,"はは"],[23,1,"かれ"],[25,2,"そうだん"],[27,2,"あいて"],[33,1,"あく"],[35,1,"おこな"]],"text":"アハジヤもまたアハブの家の道に歩んだ。その母が彼の相談相手となって悪を行わせたからである。"},{"ref":"2Chr.22.4","start":14022004,"end":14022004,"break":"none","ruby":[[0,1,"かれ"],[8,1,"いえ"],[15,1,"しゅ"],[17,1,"め"],[19,1,"まえ"],[21,1,"あく"],[23,1,"おこな"],[33,1,"ちち"],[35,1,"し"],[38,1,"のち"],[44,1,"いえ"],[46,1,"もの"],[50,3,"そうだんやく"],[60,1,"かれ"],[65,2,"じぶん"],[68,1,"ほろ"],[72,1,"いた"]],"text":"彼はまたアハブの家がしたように主の目の前に悪を行った。すなわちその父が死んだ後、アハブの家の者がその相談役となったので、彼はついに自分を滅ぼすに至った。"},{"ref":"2Chr.22.5","start":14022005,"end":14022005,"break":"none","ruby":[[7,1,"かれ"],[10,1,"すす"],[13,1,"したが"],[23,1,"おう"],[28,1,"こ"],[33,1,"とも"],[44,1,"い"],[51,1,"おう"],[57,1,"たたか"],[72,1,"きず"],[74,1,"お"]],"text":"アハジヤはまた彼らの勧めに従って、イスラエルの王アハブの子ヨラムと共にラモテ・ギレアデへ行き、スリヤの王ハザエルと戦ったが、スリヤびとはヨラムに傷を負わせた。"},{"ref":"2Chr.22.6","start":14022006,"end":14022006,"break":"none","ruby":[[11,1,"おう"],[17,1,"たたか"],[20,1,"とき"],[25,1,"お"],[30,1,"きず"],[43,1,"かえ"],[50,1,"おう"],[55,1,"こ"],[65,1,"こ"],[70,2,"びょうき"],[80,1,"くだ"],[86,2,"みま"]],"text":"そこでヨラムはスリヤの王ハザエルと戦った時、ラマで負ったその傷をいやすためにエズレルに帰った。ユダの王ヨラムの子アハジヤはアハブの子ヨラムが病気なのでエズレルに下ってこれを見舞った。"},{"ref":"2Chr.22.7","start":14022007,"end":14022007,"break":"paragraph","ruby":[[9,2,"みまい"],[12,1,"い"],[21,1,"ほろ"],[24,1,"いた"],[29,1,"かみ"],[34,1,"さだ"],[49,1,"かれ"],[54,1,"つ"],[57,1,"とき"],[63,2,"いっしょ"],[66,1,"で"],[73,1,"こ"],[78,1,"むか"],[86,1,"しゅ"],[92,1,"いえ"],[94,1,"た"],[96,1,"ほろ"],[102,1,"あぶら"],[104,1,"そそ"],[108,1,"もの"]],"text":"アハジヤがヨラムを見舞に行ったことによって滅びに至ったのは神によって定められたことである。すなわち彼がそこに着いた時、ヨラムと一緒に出て、ニムシの子エヒウを迎えた。エヒウは主がアハブの家を断ち滅ぼすために油を注がれた者である。"},{"ref":"2Chr.22.8","start":14022008,"end":14022008,"break":"none","ruby":[[8,1,"いえ"],[10,1,"ばっ"],[36,2,"きょうだい"],[41,1,"こ"],[49,1,"つか"],[56,1,"み"],[61,1,"かれ"],[65,1,"ころ"]],"text":"エヒウはアハブの家を罰するにあたって、ユダのつかさたち、およびアハジヤの兄弟たちの子らがアハジヤに仕えているのを見たので、彼らをも殺した。"},{"ref":"2Chr.22.9","start":14022009,"end":14022009,"break":"none","ruby":[[10,1,"かく"],[21,1,"かれ"],[23,1,"さが"],[25,1,"もと"],[31,2,"ひとびと"],[34,1,"かれ"],[36,1,"とら"],[46,1,"ひ"],[52,1,"かれ"],[54,1,"ころ"],[62,1,"かれ"],[64,1,"こころ"],[70,1,"しゅ"],[72,1,"もと"],[81,1,"こ"],[87,2,"ひとびと"],[90,1,"い"],[98,1,"ほうむ"],[111,1,"いえ"],[114,1,"くに"],[116,1,"す"],[118,1,"おさ"],[122,1,"もの"]],"text":"アハジヤはサマリヤに隠れていたが、エヒウが彼を捜し求めたので、人々は彼を捕え、エヒウのもとに引いてきて、彼を殺した。ただし「彼は心をつくして主を求めたヨシャパテの子である」と人々は言ったのでこれを葬った。こうしてアハジヤの家には国を統べ治めうる者がなくなった。"},{"ref":"2Chr.22.10","start":14022010,"end":14022010,"break":"paragraph","ruby":[[5,1,"はは"],[11,2,"じぶん"],[14,1,"こ"],[16,1,"し"],[21,1,"み"],[24,1,"た"],[30,1,"いえ"],[32,2,"おうじ"],[40,1,"ほろ"]],"text":"アハジヤの母アタリヤは自分の子の死んだのを見て、立ってユダの家の王子をことごとく滅ぼしたが、"},{"ref":"2Chr.22.11","start":14022011,"end":14022011,"break":"none","ruby":[[0,1,"おう"],[2,1,"むすめ"],[13,1,"こ"],[18,1,"おう"],[20,1,"こ"],[24,1,"ころ"],[28,1,"もの"],[34,1,"ぬす"],[36,1,"と"],[39,1,"かれ"],[46,2,"しんしつ"],[72,1,"かく"],[87,1,"ころ"],[102,1,"おう"],[104,1,"むすめ"],[113,1,"いもうと"],[116,2,"さいし"],[123,1,"つま"]],"text":"王の娘エホシバはアハジヤの子ヨアシを王の子たちの殺される者のうちから盗み取り、彼とそのうばを寝室においた。こうしてエホシバがヨアシをアタリヤから隠したので、アタリヤはヨアシを殺さなかった。エホシバはヨラム王の娘、またアハジヤの妹で、祭司エホヤダの妻である。"},{"ref":"2Chr.22.12","start":14022012,"end":14022012,"break":"none","ruby":[[8,1,"かみ"],[10,1,"みや"],[12,1,"かく"],[15,1,"かれ"],[18,1,"とも"],[25,1,"ねん"],[29,1,"かん"],[35,1,"くに"],[37,1,"おさ"]],"text":"こうしてヨアシは神の宮に隠れて彼らと共におること六年、その間アタリヤが国を治めた。"}]