[{"ref":"Num.15.1","start":4015001,"end":4015001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.15.2","start":4015002,"end":4015002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[28,1,"あた"],[31,1,"す"],[35,1,"ち"],[37,1,"い"]],"text":"「イスラエルの人々に言いなさい、『あなたがたが、わたしの与えて住ませる地に行って、"},{"ref":"Num.15.3","start":4015003,"end":4015003,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"かさい"],[9,1,"とき"],[15,2,"とくべつ"],[18,2,"せいがん"],[21,1,"そな"],[23,1,"もの"],[29,2,"じはつ"],[32,1,"そな"],[34,1,"もの"],[40,1,"しゅく"],[45,1,"そな"],[47,1,"もの"],[52,1,"うし"],[56,1,"ひつじ"],[58,2,"はんさい"],[63,2,"ぎせい"],[72,1,"しゅ"],[74,1,"こう"]],"text":"主に火祭をささげる時、すなわち特別の誓願の供え物、あるいは自発の供え物、あるいは祝のときの供え物として、牛または羊を燔祭または犠牲としてささげ、主に香ばしいかおりとするとき、"},{"ref":"Num.15.4","start":4015004,"end":4015005,"break":"none","ruby":[[2,1,"そな"],[4,1,"もの"],[6,1,"しゅ"],[12,1,"もの"],[15,2,"はんさい"],[20,2,"ぎせい"],[23,1,"とも"],[26,2,"こひつじ"],[29,1,"とう"],[34,2,"むぎこ"],[41,1,"ぶん"],[46,1,"あぶら"],[52,1,"ぶん"],[56,1,"ま"],[63,2,"そさい"],[75,1,"しゅ"],[81,1,"ぶん"],[86,2,"かんさい"]],"text":"その供え物を主にささげる者は、燔祭または犠牲と共に、小羊一頭ごとに、麦粉一エパの十分の一に、油一ヒンの四分の一を混ぜたものを、素祭としてささげ、ぶどう酒一ヒンの四分の一を、灌祭としてささげなければならない。"},{"ref":"Num.15.6","start":4015006,"end":4015006,"break":"none","ruby":[[5,2,"おひつじ"],[8,1,"もち"],[15,2,"むぎこ"],[22,1,"ぶん"],[27,1,"あぶら"],[33,1,"ぶん"],[37,1,"ま"],[44,2,"そさい"]],"text":"もし、また雄羊を用いるときは、麦粉一エパの十分の二に、油一ヒンの三分の一を混ぜたものを、素祭としてささげ、"},{"ref":"Num.15.7","start":4015007,"end":4015007,"break":"none","ruby":[[6,1,"しゅ"],[12,1,"ぶん"],[17,2,"かんさい"],[27,1,"しゅ"],[29,1,"こう"]],"text":"また、ぶどう酒一ヒンの三分の一を、灌祭としてささげて、主に香ばしいかおりとしなければならない。"},{"ref":"Num.15.8","start":4015008,"end":4015008,"break":"none","ruby":[[6,2,"とくべつ"],[9,2,"せいがん"],[12,1,"そな"],[14,1,"もの"],[20,3,"しゅうおんさい"],[25,1,"しゅ"],[31,1,"とき"],[33,1,"わか"],[35,2,"おうし"],[39,2,"はんさい"],[44,2,"ぎせい"]],"text":"またあなたが特別の誓願の供え物、あるいは酬恩祭を、主にささげる時、若い雄牛を、燔祭または犠牲とするならば、"},{"ref":"Num.15.9","start":4015009,"end":4015009,"break":"none","ruby":[[0,2,"むぎこ"],[7,1,"ぶん"],[12,1,"あぶら"],[18,1,"ぶん"],[22,1,"ま"],[29,2,"そさい"],[35,1,"わか"],[37,2,"おうし"],[40,1,"とも"]],"text":"麦粉一エパの十分の三に、油一ヒンの二分の一を混ぜたものを、素祭として、若い雄牛と共にささげ、"},{"ref":"Num.15.10","start":4015010,"end":4015010,"break":"none","ruby":[[6,1,"しゅ"],[12,1,"ぶん"],[17,2,"かんさい"],[37,2,"かさい"],[44,1,"しゅ"],[46,1,"こう"]],"text":"また、ぶどう酒一ヒンの二分の一を、灌祭としてささげなければならない。これは火祭であって、主に香ばしいかおりとするものである。"},{"ref":"Num.15.11","start":4015011,"end":4015011,"break":"paragraph","ruby":[[0,2,"おうし"],[7,2,"おひつじ"],[14,2,"こひつじ"],[21,1,"こ"],[27,1,"とう"]],"text":"雄牛、あるいは雄羊、あるいは小羊、あるいは子やぎは、一頭ごとに、このようにしなければならない。"},{"ref":"Num.15.12","start":4015012,"end":4015012,"break":"none","ruby":[[15,1,"かず"],[23,1,"かず"],[32,1,"とう"]],"text":"すなわち、あなたがたのささげる数にてらし、その数にしたがって、一頭ごとに、このようにしなければならない。"},{"ref":"Num.15.13","start":4015013,"end":4015013,"break":"none","ruby":[[3,1,"くに"],[5,1,"うま"],[8,1,"もの"],[11,2,"かさい"],[19,1,"しゅ"],[21,1,"こう"],[48,1,"おこな"]],"text":"すべて国に生れた者が、火祭をささげて、主に香ばしいかおりとするときは、このように、これらのことを行わなければならない。"},{"ref":"Num.15.14","start":4015014,"end":4015014,"break":"none","ruby":[[11,2,"きりゅう"],[17,2,"たこく"],[19,1,"じん"],[34,2,"よよ"],[39,1,"す"],[41,1,"もの"],[44,2,"かさい"],[52,1,"しゅ"],[54,1,"こう"],[68,1,"とき"],[85,1,"ひと"]],"text":"またあなたがたのうちに寄留している他国人、またはあなたがたのうちに、代々ながく住む者が、火祭をささげて、主に香ばしいかおりとしようとする時は、あなたがたがするように、その人もしなければならない。"},{"ref":"Num.15.15","start":4015015,"end":4015015,"break":"none","ruby":[[0,2,"かいしゅう"],[4,1,"もの"],[23,2,"きりゅう"],[29,2,"たこく"],[31,1,"じん"],[34,2,"どういつ"],[37,1,"さだ"],[40,1,"したが"],[61,2,"よよ"],[66,1,"まも"],[70,1,"さだ"],[76,2,"たこく"],[79,1,"ひと"],[82,1,"しゅ"],[84,1,"まえ"],[94,1,"ひと"]],"text":"会衆たる者は、あなたがたも、あなたがたのうちに寄留している他国人も、同一の定めに従わなければならない。これは、あなたがたが代々ながく守るべき定めである。他国の人も、主の前には、あなたがたと等しくなければならない。"},{"ref":"Num.15.16","start":4015016,"end":4015016,"break":"none","ruby":[[21,2,"きりゅう"],[27,2,"たこく"],[29,1,"じん"],[32,2,"どういつ"],[35,2,"りっぽう"],[38,2,"どういつ"],[45,1,"したが"]],"text":"すなわち、あなたがたも、あなたがたのうちに寄留している他国人も、同一の律法、同一のおきてに従わなければならない』」。"},{"ref":"Num.15.17","start":4015017,"end":4015017,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.15.18","start":4015018,"end":4015018,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[21,1,"みちび"],[24,1,"い"],[26,1,"ち"]],"text":"「イスラエルの人々に言いなさい、『わたしが導いて行く地に、あなたがたがはいって、"},{"ref":"Num.15.19","start":4015019,"end":4015019,"break":"none","ruby":[[2,1,"ち"],[4,2,"しょくもつ"],[7,1,"た"],[23,1,"もの"],[25,1,"しゅ"]],"text":"その地の食物を食べるとき、あなたがたは、ささげ物を主にささげなければならない。"},{"ref":"Num.15.20","start":4015020,"end":4015020,"break":"none","ruby":[[5,2,"むぎこ"],[8,2,"はつもの"],[11,1,"つく"],[14,2,"かし"],[21,1,"もの"],[37,1,"う"],[39,1,"ば"],[46,1,"もの"]],"text":"すなわち、麦粉の初物で作った菓子を、ささげ物としなければならない。これを、打ち場からのささげ物のように、ささげなければならない。"},{"ref":"Num.15.21","start":4015021,"end":4015021,"break":"none","ruby":[[6,2,"よよ"],[10,2,"むぎこ"],[13,2,"はつもの"],[17,1,"しゅ"],[22,1,"もの"]],"text":"あなたがたは代々その麦粉の初物で、主にささげ物をしなければならない。"},{"ref":"Num.15.22","start":4015022,"end":4015022,"break":"paragraph","ruby":[[15,1,"しゅ"],[21,1,"つ"],[32,1,"いまし"],[35,1,"おこな"]],"text":"あなたがたが、もしあやまって、主がモーセに告げられたこのすべての戒めを行わず、"},{"ref":"Num.15.23","start":4015023,"end":4015023,"break":"none","ruby":[[0,1,"しゅ"],[9,1,"いまし"],[12,1,"あた"],[17,1,"ひ"],[25,2,"よよ"],[38,1,"めい"],[47,1,"こと"],[49,1,"おこな"]],"text":"主がモーセによって戒めを与えられた日からこのかた、代々にわたり、あなたがたに命じられたすべての事を行わないとき、"},{"ref":"Num.15.24","start":4015024,"end":4015024,"break":"none","ruby":[[5,2,"かいしゅう"],[8,1,"し"],[18,1,"おか"],[21,1,"とき"],[24,1,"ぜん"],[25,2,"かいしゅう"],[28,1,"わか"],[30,2,"おうし"],[33,1,"とう"],[36,2,"はんさい"],[45,1,"しゅ"],[47,1,"こう"],[60,2,"そさい"],[63,2,"かんさい"],[67,1,"さだ"],[73,1,"くわ"],[78,1,"お"],[82,1,"とう"],[85,2,"ざいさい"]],"text":"すなわち、会衆が知らずに、あやまって犯した時は、全会衆は若い雄牛一頭を、燔祭としてささげ、主に香ばしいかおりとし、これに素祭と灌祭とを定めのように加え、また雄やぎ一頭を、罪祭としてささげなければならない。"},{"ref":"Num.15.25","start":4015025,"end":4015025,"break":"none","ruby":[[3,2,"さいし"],[13,2,"ひとびと"],[16,1,"ぜん"],[17,2,"かいしゅう"],[24,1,"つみ"],[47,1,"かれ"],[63,2,"かしつ"],[72,1,"かれ"],[77,2,"かしつ"],[86,1,"そな"],[88,1,"もの"],[93,2,"かさい"],[96,1,"しゅ"],[104,2,"ざいさい"],[107,1,"しゅ"],[109,1,"まえ"]],"text":"そして祭司は、イスラエルの人々の全会衆のために、罪のあがないをしなければならない。そうすれば、彼らはゆるされるであろう。それは過失だからである。彼らはその過失のために、その供え物として、火祭を主にささげ、また罪祭を主の前にささげなければならない。"},{"ref":"Num.15.26","start":4015026,"end":4015026,"break":"none","ruby":[[12,2,"ひとびと"],[15,1,"ぜん"],[16,2,"かいしゅう"],[26,1,"かれ"],[32,2,"きりゅう"],[38,2,"たこく"],[40,1,"じん"],[53,1,"たみ"],[57,2,"かしつ"],[60,1,"おか"]],"text":"そうすれば、イスラエルの人々の全会衆はゆるされ、また彼らのうちに寄留している他国人も、ゆるされるであろう。民はみな過失を犯したからである。"},{"ref":"Num.15.27","start":4015027,"end":4015027,"break":"paragraph","ruby":[[2,1,"ひと"],[9,1,"つみ"],[11,1,"おか"],[13,1,"とき"],[17,1,"さい"],[19,1,"め"],[23,1,"とう"],[25,2,"ざいさい"]],"text":"もし人があやまって罪を犯す時は、一歳の雌やぎ一頭を罪祭としてささげなければならない。"},{"ref":"Num.15.28","start":4015028,"end":4015028,"break":"none","ruby":[[3,2,"さいし"],[7,1,"ひと"],[14,1,"つみ"],[16,1,"おか"],[19,1,"とき"],[28,1,"つみ"],[30,1,"おか"],[33,1,"ひと"],[39,1,"しゅ"],[41,1,"まえ"],[43,1,"つみ"],[55,1,"つみ"],[76,1,"かれ"]],"text":"そして祭司は、人があやまって罪を犯した時、そのあやまって罪を犯した人のために、主の前に罪のあがないをして、その罪をあがなわなければならない。そうすれば、彼はゆるされるであろう。"},{"ref":"Num.15.29","start":4015029,"end":4015029,"break":"none","ruby":[[6,2,"ひとびと"],[13,1,"くに"],[15,1,"うま"],[18,1,"もの"],[27,2,"きりゅう"],[33,2,"たこく"],[35,1,"じん"],[44,1,"つみ"],[46,1,"おか"],[48,1,"もの"],[58,2,"どういつ"],[61,2,"りっぽう"],[64,1,"もち"]],"text":"イスラエルの人々のうちの、国に生れた者でも、そのうちに寄留している他国人でも、あやまって罪を犯す者には、あなたがたは同一の律法を用いなければならない。"},{"ref":"Num.15.30","start":4015030,"end":4015030,"break":"none","ruby":[[4,1,"くに"],[6,1,"うま"],[9,1,"もの"],[13,2,"たこく"],[16,1,"ひと"],[20,2,"こい"],[23,1,"つみ"],[25,1,"おか"],[27,1,"もの"],[29,1,"しゅ"],[31,1,"けが"],[39,1,"ひと"],[41,1,"たみ"],[47,1,"た"]],"text":"しかし、国に生れた者でも、他国の人でも、故意に罪を犯す者は主を汚すもので、その人は民のうちから断たれなければならない。"},{"ref":"Num.15.31","start":4015031,"end":4015031,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,2,"ことば"],[7,1,"あなど"],[12,1,"いまし"],[15,1,"やぶ"],[25,1,"かなら"],[27,1,"た"],[33,1,"つみ"],[35,1,"お"]],"text":"彼は主の言葉を侮り、その戒めを破ったのであるから、必ず断たれ、その罪を負わなければならない』」。"},{"ref":"Num.15.32","start":4015032,"end":4015032,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,2,"あらの"],[17,3,"あんそくにち"],[25,1,"ひと"],[32,1,"あつ"],[37,1,"み"]],"text":"イスラエルの人々が荒野におるとき、安息日にひとりの人が、たきぎを集めるのを見た。"},{"ref":"Num.15.33","start":4015033,"end":4015033,"break":"none","ruby":[[6,1,"あつ"],[11,1,"み"],[13,2,"ひとびと"],[19,1,"ひと"],[32,1,"ぜん"],[33,2,"かいしゅう"],[39,1,"つ"]],"text":"そのたきぎを集めるのを見た人々は、その人をモーセとアロン、および全会衆のもとに連れてきたが、"},{"ref":"Num.15.34","start":4015034,"end":4015034,"break":"none","ruby":[[2,1,"と"],[4,1,"あつか"],[12,1,"しめ"],[15,1,"う"],[26,1,"かれ"],[28,1,"と"],[30,1,"こ"]],"text":"どう取り扱うべきか、まだ示しを受けていなかったので、彼を閉じ込めておいた。"},{"ref":"Num.15.35","start":4015035,"end":4015035,"break":"none","ruby":[[5,1,"しゅ"],[11,1,"い"],[19,1,"ひと"],[21,1,"かなら"],[23,1,"ころ"],[35,1,"ぜん"],[36,2,"かいしゅう"],[39,2,"しゅくえい"],[42,1,"そと"],[45,1,"かれ"],[47,1,"いし"],[49,1,"う"],[51,1,"ころ"]],"text":"そのとき、主はモーセに言われた、「その人は必ず殺されなければならない。全会衆は宿営の外で、彼を石で撃ち殺さなければならない」。"},{"ref":"Num.15.36","start":4015036,"end":4015036,"break":"none","ruby":[[4,1,"ぜん"],[5,2,"かいしゅう"],[8,1,"かれ"],[10,2,"しゅくえい"],[13,1,"そと"],[15,1,"つ"],[17,1,"だ"],[20,1,"かれ"],[22,1,"いし"],[24,1,"う"],[26,1,"ころ"],[29,1,"しゅ"],[35,1,"めい"]],"text":"そこで、全会衆は彼を宿営の外に連れ出し、彼を石で撃ち殺し、主がモーセに命じられたようにした。"},{"ref":"Num.15.37","start":4015037,"end":4015037,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.15.38","start":4015038,"end":4015038,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"めい"],[14,2,"よよ"],[18,2,"いふく"],[39,1,"あお"]],"text":"「イスラエルの人々に命じて、代々その衣服のすその四すみにふさをつけ、そのふさを青ひもで、すその四すみにつけさせなさい。"},{"ref":"Num.15.39","start":4015039,"end":4015039,"break":"none","ruby":[[12,1,"み"],[15,1,"しゅ"],[22,1,"いまし"],[25,1,"おも"],[27,1,"おこ"],[34,1,"おこな"],[43,2,"じぶん"],[46,1,"こころ"],[49,1,"め"],[51,1,"よく"],[53,1,"したが"],[61,1,"おこな"]],"text":"あなたがたが、そのふさを見て、主のもろもろの戒めを思い起して、それを行い、あなたがたが自分の心と、目の欲に従って、みだらな行いをしないためである。"},{"ref":"Num.15.40","start":4015040,"end":4015040,"break":"none","ruby":[[21,1,"いまし"],[24,1,"おも"],[26,1,"おこ"],[33,1,"おこな"],[42,1,"かみ"],[44,1,"せい"],[47,1,"もの"]],"text":"こうして、あなたがたは、わたしのもろもろの戒めを思い起して、それを行い、あなたがたの神に聖なる者とならなければならない。"},{"ref":"Num.15.41","start":4015041,"end":4015041,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[24,1,"かみ"],[43,1,"くに"],[46,1,"みちび"],[48,1,"だ"],[51,1,"もの"],[66,1,"かみ"],[68,1,"しゅ"]],"text":"わたしはあなたがたの神、主であって、あなたがたの神となるために、あなたがたをエジプトの国から導き出した者である。わたしはあなたがたの神、主である」。"}]