[{"ref":"Luke.20.1","start":42020001,"end":42020001,"break":"paragraph","ruby":[[2,1,"ひ"],[8,1,"みや"],[10,2,"ひとびと"],[13,1,"おし"],[16,2,"ふくいん"],[19,1,"の"],[28,3,"さいしちょう"],[32,2,"りっぽう"],[34,2,"がくしゃ"],[40,2,"ちょうろう"],[45,1,"とも"],[47,2,"ちかよ"]],"text":"ある日、イエスが宮で人々に教え、福音を宣べておられると、祭司長や律法学者たちが、長老たちと共に近寄ってきて、"},{"ref":"Luke.20.2","start":42020002,"end":42020002,"break":"none","ruby":[[4,1,"い"],[9,1,"なに"],[11,2,"けんい"],[21,1,"こと"],[34,2,"けんい"],[41,1,"あた"],[58,1,"い"]],"text":"イエスに言った、「何の権威によってこれらの事をするのですか。そうする権威をあなたに与えたのはだれですか、わたしたちに言ってください」。"},{"ref":"Luke.20.3","start":42020003,"end":42020003,"break":"none","ruby":[[8,1,"こた"],[11,1,"い"],[24,1,"こと"],[34,1,"こた"]],"text":"そこで、イエスは答えて言われた、「わたしも、ひと言たずねよう。それに答えてほしい。"},{"ref":"Luke.20.4","start":42020004,"end":42020004,"break":"none","ruby":[[11,1,"てん"],[20,1,"ひと"]],"text":"ヨハネのバプテスマは、天からであったか、人からであったか」。"},{"ref":"Luke.20.5","start":42020005,"end":42020005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"たがい"],[5,1,"ろん"],[8,1,"い"],[15,1,"てん"],[20,1,"い"],[29,1,"かれ"],[31,1,"しん"],[45,1,"い"]],"text":"彼らは互に論じて言った、「もし天からだと言えば、では、なぜ彼を信じなかったのか、とイエスは言うだろう。"},{"ref":"Luke.20.6","start":42020006,"end":42020006,"break":"none","ruby":[[6,1,"ひと"],[11,1,"い"],[15,2,"みんしゅう"],[25,3,"よげんしゃ"],[30,1,"しん"],[44,1,"いし"],[46,1,"う"]],"text":"しかし、もし人からだと言えば、民衆はみな、ヨハネを預言者だと信じているから、わたしたちを石で打つだろう」。"},{"ref":"Luke.20.7","start":42020007,"end":42020007,"break":"none","ruby":[[3,1,"かれ"],[13,1,"し"],[20,1,"こた"]],"text":"それで彼らは「どこからか、知りません」と答えた。"},{"ref":"Luke.20.8","start":42020008,"end":42020008,"break":"none","ruby":[[7,1,"たい"],[10,1,"い"],[20,1,"なに"],[22,2,"けんい"],[32,1,"こと"],[45,1,"い"]],"text":"イエスはこれに対して言われた、「わたしも何の権威によってこれらの事をするのか、あなたがたに言うまい」。"},{"ref":"Luke.20.9","start":42020009,"end":42020009,"break":"paragraph","ruby":[[7,1,"つぎ"],[9,1,"たとえ"],[11,2,"みんしゅう"],[14,1,"かた"],[16,1,"だ"],[24,1,"ひと"],[29,1,"えん"],[31,1,"つく"],[34,2,"のうふ"],[39,1,"か"],[42,1,"なが"],[44,1,"たび"],[46,1,"で"]],"text":"そこでイエスは次の譬を民衆に語り出された、「ある人がぶどう園を造って農夫たちに貸し、長い旅に出た。"},{"ref":"Luke.20.10","start":42020010,"end":42020010,"break":"none","ruby":[[0,2,"きせつ"],[9,2,"のうふ"],[23,1,"しもべ"],[25,1,"おく"],[32,1,"えん"],[34,2,"しゅうかく"],[37,1,"わ"],[39,1,"まえ"],[41,1,"だ"],[55,2,"のうふ"],[63,1,"しもべ"],[65,1,"ふくろ"],[74,1,"て"],[76,1,"かえ"]],"text":"季節になったので、農夫たちのところへ、ひとりの僕を送って、ぶどう園の収穫の分け前を出させようとした。ところが、農夫たちは、その僕を袋だたきにし、から手で帰らせた。"},{"ref":"Luke.20.11","start":42020011,"end":42020011,"break":"none","ruby":[[3,1,"かれ"],[11,1,"しもべ"],[13,1,"おく"],[17,1,"かれ"],[22,1,"しもべ"],[24,1,"ふくろ"],[31,2,"ぶじょく"],[34,1,"くわ"],[40,1,"て"],[42,1,"かえ"]],"text":"そこで彼はもうひとりの僕を送った。彼らはその僕も袋だたきにし、侮辱を加えて、から手で帰らせた。"},{"ref":"Luke.20.12","start":42020012,"end":42020012,"break":"none","ruby":[[3,1,"さら"],[6,1,"にん"],[7,1,"め"],[9,1,"もの"],[11,1,"おく"],[16,1,"かれ"],[21,1,"もの"],[24,1,"きず"],[26,1,"お"],[30,1,"お"],[32,1,"だ"]],"text":"そこで更に三人目の者を送ったが、彼らはこの者も、傷を負わせて追い出した。"},{"ref":"Luke.20.13","start":42020013,"end":42020013,"break":"none","ruby":[[3,1,"えん"],[5,2,"しゅじん"],[8,1,"い"],[28,2,"あいし"],[45,1,"うやま"]],"text":"ぶどう園の主人は言った、『どうしようか。そうだ、わたしの愛子をつかわそう。これなら、たぶん敬ってくれるだろう』。"},{"ref":"Luke.20.14","start":42020014,"end":42020014,"break":"none","ruby":[[5,2,"のうふ"],[10,1,"かれ"],[12,1,"み"],[22,1,"と"],[29,1,"ころ"],[45,2,"ざいさん"],[62,1,"たがい"],[64,1,"はな"],[66,1,"あ"]],"text":"ところが、農夫たちは彼を見ると、『あれはあと取りだ。あれを殺してしまおう。そうしたら、その財産はわれわれのものになるのだ』と互に話し合い、"},{"ref":"Luke.20.15","start":42020015,"end":42020015,"break":"none","ruby":[[0,1,"かれ"],[5,1,"えん"],[7,1,"そと"],[9,1,"お"],[11,1,"だ"],[14,1,"ころ"],[26,1,"えん"],[28,2,"しゅじん"],[32,1,"かれ"]],"text":"彼をぶどう園の外に追い出して殺した。そのさい、ぶどう園の主人は、彼らをどうするだろうか。"},{"ref":"Luke.20.16","start":42020016,"end":42020016,"break":"none","ruby":[[0,1,"かれ"],[2,1,"で"],[9,2,"のうふ"],[14,1,"ころ"],[20,1,"えん"],[22,1,"た"],[24,2,"ひとびと"],[27,1,"あた"],[36,2,"ひとびと"],[42,1,"き"],[64,1,"い"]],"text":"彼は出てきて、この農夫たちを殺し、ぶどう園を他の人々に与えるであろう」。人々はこれを聞いて、「そんなことがあってはなりません」と言った。"},{"ref":"Luke.20.17","start":42020017,"end":42020017,"break":"none","breaks":[[26,"stanza"],[37,"line"]],"ruby":[[8,1,"かれ"],[11,1,"み"],[15,1,"い"],[27,1,"いえ"],[28,1,"つく"],[32,1,"す"],[35,1,"いし"],[37,1,"すみ"],[42,1,"いし"],[49,1,"か"]],"text":"そこで、イエスは彼らを見つめて言われた、「それでは、『家造りらの捨てた石が隅のかしら石になった』と書いてあるのは、どういうことか。"},{"ref":"Luke.20.18","start":42020018,"end":42020018,"break":"none","ruby":[[5,1,"いし"],[7,1,"うえ"],[9,1,"お"],[12,1,"もの"],[14,1,"う"],[16,1,"くだ"],[27,1,"うえ"],[29,1,"お"],[39,1,"ひと"]],"text":"すべてその石の上に落ちる者は打ち砕かれ、それがだれかの上に落ちかかるなら、その人はこなみじんにされるであろう」。"},{"ref":"Luke.20.19","start":42020019,"end":42020019,"break":"paragraph","ruby":[[5,2,"りっぽう"],[7,2,"がくしゃ"],[12,3,"さいしちょう"],[22,1,"て"],[29,1,"おも"],[34,2,"みんしゅう"],[37,1,"おそ"],[44,1,"たとえ"],[46,2,"じぶん"],[51,1,"あ"],[54,1,"かた"],[62,1,"さと"]],"text":"このとき、律法学者たちや祭司長たちはイエスに手をかけようと思ったが、民衆を恐れた。いまの譬が自分たちに当てて語られたのだと、悟ったからである。"},{"ref":"Luke.20.20","start":42020020,"end":42020020,"break":"none","ruby":[[4,1,"かれ"],[7,2,"きかい"],[15,2,"ぎじん"],[18,1,"よそお"],[23,1,"もの"],[27,1,"おく"],[35,2,"そうとく"],[38,2,"しはい"],[41,2,"けんい"],[45,1,"ひ"],[47,1,"わた"],[54,2,"ことば"],[59,1,"とら"]],"text":"そこで、彼らは機会をうかがい、義人を装うまわし者どもを送って、イエスを総督の支配と権威とに引き渡すため、その言葉じりを捕えさせようとした。"},{"ref":"Luke.20.21","start":42020021,"end":42020021,"break":"none","ruby":[[0,1,"かれ"],[3,1,"たず"],[6,1,"い"],[11,2,"せんせい"],[25,1,"かた"],[27,1,"おし"],[35,1,"ただ"],[46,1,"わ"],[48,1,"へだ"],[56,2,"しんり"],[59,1,"もとづ"],[62,1,"かみ"],[64,1,"みち"],[66,1,"おし"],[77,2,"しょうち"]],"text":"彼らは尋ねて言った、「先生、わたしたちは、あなたの語り教えられることが正しく、また、あなたは分け隔てをなさらず、真理に基いて神の道を教えておられることを、承知しています。"},{"ref":"Luke.20.22","start":42020022,"end":42020022,"break":"none","ruby":[[10,1,"みつぎ"],[12,1,"おさ"]],"text":"ところで、カイザルに貢を納めてよいでしょうか、いけないでしょうか」。"},{"ref":"Luke.20.23","start":42020023,"end":42020023,"break":"none","ruby":[[4,1,"かれ"],[7,2,"わるだく"],[11,2,"みやぶ"],[15,1,"い"]],"text":"イエスは彼らの悪巧みを見破って言われた、"},{"ref":"Luke.20.24","start":42020024,"end":42020024,"break":"none","ruby":[[5,1,"み"],[22,2,"しょうぞう"],[28,2,"きごう"],[46,1,"かれ"],[49,1,"こた"]],"text":"「デナリを見せなさい。それにあるのは、だれの肖像、だれの記号なのか」。「カイザルのです」と、彼らが答えた。"},{"ref":"Luke.20.25","start":42020025,"end":42020025,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[35,1,"かみ"],[40,1,"かみ"],[42,1,"かえ"]],"text":"するとイエスは彼らに言われた、「それなら、カイザルのものはカイザルに、神のものは神に返しなさい」。"},{"ref":"Luke.20.26","start":42020026,"end":42020026,"break":"none","ruby":[[3,1,"かれ"],[7,2,"みんしゅう"],[10,1,"まえ"],[16,2,"ことば"],[21,1,"とら"],[33,1,"こたえ"],[35,2,"きょうたん"],[40,1,"だま"]],"text":"そこで彼らは、民衆の前でイエスの言葉じりを捕えることができず、その答に驚嘆して、黙ってしまった。"},{"ref":"Luke.20.27","start":42020027,"end":42020027,"break":"paragraph","ruby":[[0,2,"ふっかつ"],[11,1,"い"],[13,1,"は"],[22,1,"びと"],[26,1,"もの"],[35,2,"ちかよ"],[41,2,"しつもん"]],"text":"復活ということはないと言い張っていたサドカイ人のある者たちが、イエスに近寄ってきて質問した、"},{"ref":"Luke.20.28","start":42020028,"end":42020028,"break":"none","ruby":[[1,2,"せんせい"],[20,1,"か"],[32,1,"ひと"],[34,1,"あに"],[36,1,"つま"],[42,1,"こ"],[47,1,"し"],[53,1,"おとうと"],[57,1,"おんな"],[64,1,"あに"],[69,1,"こ"]],"text":"「先生、モーセは、わたしたちのためにこう書いています、『もしある人の兄が妻をめとり、子がなくて死んだなら、弟はこの女をめとって、兄のために子をもうけねばならない』。"},{"ref":"Luke.20.29","start":42020029,"end":42020029,"break":"none","ruby":[[9,1,"にん"],[11,2,"きょうだい"],[19,2,"ちょうなん"],[22,1,"つま"],[32,1,"こ"],[37,1,"し"]],"text":"ところで、ここに七人の兄弟がいました。長男は妻をめとりましたが、子がなくて死に、"},{"ref":"Luke.20.30","start":42020030,"end":42020030,"break":"none","ruby":[[3,2,"じなん"],[6,2,"さんなん"],[10,2,"つぎつぎ"],[16,1,"おんな"]],"text":"そして次男、三男と、次々に、その女をめとり、"},{"ref":"Luke.20.31","start":42020031,"end":42020031,"break":"none","ruby":[[1,1,"にん"],[4,2,"どうよう"],[8,1,"こ"],[15,1,"し"]],"text":"七人とも同様に、子をもうけずに死にました。"},{"ref":"Luke.20.32","start":42020032,"end":42020032,"break":"none","ruby":[[6,1,"おんな"],[8,1,"し"]],"text":"のちに、その女も死にました。"},{"ref":"Luke.20.33","start":42020033,"end":42020033,"break":"none","ruby":[[3,2,"ふっかつ"],[6,1,"とき"],[12,1,"おんな"],[15,1,"にん"],[23,1,"つま"],[33,1,"にん"],[36,2,"かのじょ"],[39,1,"つま"]],"text":"さて、復活の時には、この女は七人のうち、だれの妻になるのですか。七人とも彼女を妻にしたのですが」。"},{"ref":"Luke.20.34","start":42020034,"end":42020034,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[15,1,"よ"],[17,1,"こ"]],"text":"イエスは彼らに言われた、「この世の子らは、めとったり、とついだりするが、"},{"ref":"Luke.20.35","start":42020035,"end":42020035,"break":"none","ruby":[[2,1,"よ"],[8,2,"しにん"],[13,2,"ふっかつ"],[26,1,"もの"]],"text":"かの世にはいって死人からの復活にあずかるにふさわしい者たちは、めとったり、とついだりすることはない。"},{"ref":"Luke.20.36","start":42020036,"end":42020036,"break":"none","ruby":[[0,1,"かれ"],[3,2,"てんし"],[6,1,"ひと"],[17,2,"ふっかつ"],[28,1,"かみ"],[30,1,"こ"],[40,1,"し"],[47,1,"え"]],"text":"彼らは天使に等しいものであり、また復活にあずかるゆえに、神の子でもあるので、もう死ぬことはあり得ないからである。"},{"ref":"Luke.20.37","start":42020037,"end":42020037,"break":"none","ruby":[[0,2,"しにん"],[16,1,"しば"],[18,1,"へん"],[21,1,"しゅ"],[30,1,"かみ"],[36,1,"かみ"],[42,1,"かみ"],[45,1,"よ"],[52,1,"しめ"]],"text":"死人がよみがえることは、モーセも柴の篇で、主を『アブラハムの神、イサクの神、ヤコブの神』と呼んで、これを示した。"},{"ref":"Luke.20.38","start":42020038,"end":42020038,"break":"none","ruby":[[0,1,"かみ"],[2,1,"し"],[5,1,"もの"],[7,1,"かみ"],[13,1,"い"],[18,1,"もの"],[20,1,"かみ"],[25,1,"ひと"],[29,1,"かみ"],[31,1,"い"]],"text":"神は死んだ者の神ではなく、生きている者の神である。人はみな神に生きるものだからである」。"},{"ref":"Luke.20.39","start":42020039,"end":42020039,"break":"none","ruby":[[0,2,"りっぽう"],[2,2,"がくしゃ"],[10,2,"ひとびと"],[13,1,"こた"],[16,1,"い"],[21,2,"せんせい"],[24,1,"おお"]],"text":"律法学者のうちのある人々が答えて言った、「先生、仰せのとおりです」。"},{"ref":"Luke.20.40","start":42020040,"end":42020040,"break":"none","ruby":[[0,1,"かれ"],[5,2,"いじょう"],[7,1,"なに"],[12,1,"と"]],"text":"彼らはそれ以上何もあえて問いかけようとしなかった。"},{"ref":"Luke.20.41","start":42020041,"end":42020041,"break":"paragraph","ruby":[[4,1,"かれ"],[7,1,"い"],[17,2,"ひとびと"],[29,1,"こ"],[32,1,"い"]],"text":"イエスは彼らに言われた、「どうして人々はキリストをダビデの子だと言うのか。"},{"ref":"Luke.20.42","start":42020042,"end":42020042,"break":"none","breaks":[[17,"stanza"]],"ruby":[[3,2,"じしん"],[6,2,"しへん"],[9,1,"なか"],[11,1,"い"],[18,1,"しゅ"],[22,1,"しゅ"],[24,1,"おお"]],"text":"ダビデ自身が詩篇の中で言っている、『主はわが主に仰せになった、"},{"ref":"Luke.20.43","start":42020043,"end":42020043,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"てき"],[10,1,"あし"],[11,1,"だい"],[15,1,"とき"],[24,1,"みぎ"],[26,1,"ざ"]],"text":"あなたの敵をあなたの足台とする時までは、わたしの右に座していなさい』。"},{"ref":"Luke.20.44","start":42020044,"end":42020044,"break":"none","ruby":[[15,1,"しゅ"],[17,1,"よ"],[41,1,"こ"]],"text":"このように、ダビデはキリストを主と呼んでいる。それなら、どうしてキリストはダビデの子であろうか」。"},{"ref":"Luke.20.45","start":42020045,"end":42020045,"break":"paragraph","ruby":[[0,2,"みんしゅう"],[5,1,"き"],[17,2,"でし"],[22,1,"い"]],"text":"民衆がみな聞いているとき、イエスは弟子たちに言われた、"},{"ref":"Luke.20.46","start":42020046,"end":42020046,"break":"none","ruby":[[1,2,"りっぽう"],[3,2,"がくしゃ"],[6,1,"き"],[14,1,"かれ"],[17,1,"なが"],[19,1,"ころも"],[21,1,"き"],[23,1,"ある"],[27,1,"この"],[30,2,"ひろば"],[34,2,"けいれい"],[37,2,"かいどう"],[40,2,"じょうせき"],[43,2,"えんかい"],[46,2,"じょうざ"]],"text":"「律法学者に気をつけなさい。彼らは長い衣を着て歩くのを好み、広場での敬礼や会堂の上席や宴会の上座をよろこび、"},{"ref":"Luke.20.47","start":42020047,"end":42020047,"break":"none","ruby":[[6,1,"いえ"],[8,1,"く"],[10,1,"たお"],[13,1,"み"],[19,1,"なが"],[21,1,"いのり"],[26,1,"かれ"],[40,1,"う"]],"text":"やもめたちの家を食い倒し、見えのために長い祈をする。彼らはもっときびしいさばきを受けるであろう」。"}]