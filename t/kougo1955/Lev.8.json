[{"ref":"Lev.8.1","start":3008001,"end":3008001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.8.2","start":3008002,"end":3008002,"break":"none","ruby":[[11,1,"こ"],[20,2,"いふく"],[23,1,"そそ"],[25,1,"あぶら"],[27,2,"ざいさい"],[30,2,"おうし"],[33,2,"おひつじ"],[36,1,"とう"],[38,1,"たね"],[39,1,"い"],[48,1,"と"]],"text":"「あなたはアロンとその子たち、およびその衣服、注ぎ油、罪祭の雄牛、雄羊二頭、種入れぬパン一かごを取り、"},{"ref":"Lev.8.3","start":3008003,"end":3008003,"break":"none","ruby":[[2,1,"ぜん"],[3,2,"かいしゅう"],[6,2,"かいけん"],[9,2,"まくや"],[12,2,"いりぐち"],[15,1,"あつ"]],"text":"また全会衆を会見の幕屋の入口に集めなさい」。"},{"ref":"Lev.8.4","start":3008004,"end":3008004,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"めい"],[20,2,"かいしゅう"],[23,2,"かいけん"],[26,2,"まくや"],[29,2,"いりぐち"],[32,1,"あつ"]],"text":"モーセは主が命じられたようにした。そして会衆は会見の幕屋の入口に集まった。"},{"ref":"Lev.8.5","start":3008005,"end":3008005,"break":"paragraph","ruby":[[7,2,"かいしゅう"],[14,1,"い"],[22,1,"しゅ"],[33,1,"めい"]],"text":"そこでモーセは会衆にむかって言った、「これは主があなたがたにせよと命じられたことである」。"},{"ref":"Lev.8.6","start":3008006,"end":3008006,"break":"none","ruby":[[13,1,"こ"],[17,1,"つ"],[23,1,"みず"],[25,1,"かれ"],[28,1,"あら"],[30,1,"きよ"]],"text":"そしてモーセはアロンとその子たちを連れてきて、水で彼らを洗い清め、"},{"ref":"Lev.8.7","start":3008007,"end":3008007,"break":"none","ruby":[[4,1,"ふく"],[6,1,"き"],[10,1,"おび"],[17,1,"ころも"],[28,1,"つ"],[37,1,"おび"],[54,1,"み"],[56,1,"ゆ"]],"text":"アロンに服を着させ、帯をしめさせ、衣をまとわせ、エポデを着けさせ、エポデの帯をしめさせ、それをもってエポデを身に結いつけ、"},{"ref":"Lev.8.8","start":3008008,"end":3008008,"break":"none","ruby":[[2,2,"むねあて"],[5,1,"つ"],[12,2,"むねあて"],[24,1,"い"]],"text":"また胸当を着けさせ、その胸当にウリムとトンミムを入れ、"},{"ref":"Lev.8.9","start":3008009,"end":3008009,"break":"none","ruby":[[2,1,"あたま"],[4,2,"ぼうし"],[14,2,"ぼうし"],[17,1,"まえ"],[19,1,"きん"],[21,1,"いた"],[27,1,"せい"],[30,1,"かんむり"],[38,1,"しゅ"],[44,1,"めい"]],"text":"その頭に帽子をかぶらせ、その帽子の前に金の板、すなわち聖なる冠をつけさせた。主がモーセに命じられたとおりである。"},{"ref":"Lev.8.10","start":3008010,"end":3008010,"break":"paragraph","ruby":[[6,1,"そそ"],[8,1,"あぶら"],[10,1,"と"],[13,2,"まくや"],[25,1,"もの"],[27,1,"あぶら"],[29,1,"そそ"],[35,2,"せいべつ"]],"text":"モーセはまた注ぎ油を取り、幕屋とそのうちのすべての物に油を注いでこれを聖別し、"},{"ref":"Lev.8.11","start":3008011,"end":3008011,"break":"none","ruby":[[9,2,"さいだん"],[12,1,"そそ"],[15,2,"さいだん"],[25,1,"うつわ"],[27,2,"せんばん"],[32,1,"だい"],[34,1,"あぶら"],[36,1,"そそ"],[42,2,"せいべつ"]],"text":"かつ、それを七たび祭壇に注ぎ、祭壇とそのもろもろの器、洗盤とその台に油を注いでこれを聖別し、"},{"ref":"Lev.8.12","start":3008012,"end":3008012,"break":"none","ruby":[[2,1,"そそ"],[4,1,"あぶら"],[10,1,"あたま"],[12,1,"そそ"],[15,1,"かれ"],[17,1,"あぶら"],[19,1,"そそ"],[25,2,"せいべつ"]],"text":"また注ぎ油をアロンの頭に注ぎ、彼に油を注いでこれを聖別した。"},{"ref":"Lev.8.13","start":3008013,"end":3008013,"break":"none","ruby":[[10,1,"こ"],[14,1,"つ"],[20,1,"ふく"],[22,1,"かれ"],[25,1,"き"],[29,1,"おび"],[31,1,"かれ"],[39,2,"ずきん"],[42,1,"あたま"],[44,1,"ま"],[49,1,"しゅ"],[55,1,"めい"]],"text":"モーセはまたアロンの子たちを連れてきて、服を彼らに着させ、帯を彼らにしめさせ、頭巾を頭に巻かせた。主がモーセに命じられたとおりである。"},{"ref":"Lev.8.14","start":3008014,"end":3008014,"break":"paragraph","ruby":[[0,1,"かれ"],[4,2,"ざいさい"],[7,2,"おうし"],[10,1,"つ"],[23,1,"こ"],[30,2,"ざいさい"],[33,2,"おうし"],[36,1,"あたま"],[38,1,"て"],[40,1,"お"]],"text":"彼はまた罪祭の雄牛を連れてこさせ、アロンとその子たちは、その罪祭の雄牛の頭に手を置いた。"},{"ref":"Lev.8.15","start":3008015,"end":3008015,"break":"none","ruby":[[13,1,"ち"],[15,1,"と"],[18,1,"ゆび"],[25,1,"ち"],[27,2,"さいだん"],[34,1,"つの"],[39,2,"さいだん"],[42,1,"きよ"],[47,1,"のこ"],[50,1,"ち"],[52,2,"さいだん"],[58,1,"そそ"],[65,2,"せいべつ"]],"text":"モーセはこれをほふり、その血を取り、指をもってその血を祭壇の四すみの角につけて祭壇を清め、また残りの血を祭壇のもとに注いで、これを聖別し、これがためにあがないをした。"},{"ref":"Lev.8.16","start":3008016,"end":3008016,"break":"none","ruby":[[8,2,"ないぞう"],[11,1,"うえ"],[17,2,"しぼう"],[20,2,"かんぞう"],[23,2,"しょうよう"],[29,2,"じんぞう"],[34,2,"しぼう"],[38,1,"と"],[44,2,"さいだん"],[47,1,"うえ"],[49,1,"や"]],"text":"モーセはまたその内臓の上のすべての脂肪、肝臓の小葉、二つの腎臓とその脂肪とを取り、これを祭壇の上で焼いた。"},{"ref":"Lev.8.17","start":3008017,"end":3008017,"break":"none","ruby":[[6,2,"おうし"],[9,1,"かわ"],[11,1,"にく"],[13,2,"おぶつ"],[16,2,"しゅくえい"],[19,1,"そと"],[22,1,"ひ"],[27,1,"や"],[29,1,"す"],[33,1,"しゅ"],[39,1,"めい"]],"text":"ただし、その雄牛の皮と肉と汚物は宿営の外で、火をもって焼き捨てた。主がモーセに命じられたとおりである。"},{"ref":"Lev.8.18","start":3008018,"end":3008018,"break":"paragraph","ruby":[[0,1,"かれ"],[4,2,"はんさい"],[7,2,"おひつじ"],[10,1,"つ"],[23,1,"こ"],[30,2,"おひつじ"],[33,1,"あたま"],[35,1,"て"],[37,1,"お"]],"text":"彼はまた燔祭の雄羊を連れてこさせ、アロンとその子たちは、その雄羊の頭に手を置いた。"},{"ref":"Lev.8.19","start":3008019,"end":3008019,"break":"none","ruby":[[14,1,"ち"],[16,2,"さいだん"],[19,2,"しゅうい"],[22,1,"そそ"]],"text":"モーセはこれをほふって、その血を祭壇の周囲に注ぎかけた。"},{"ref":"Lev.8.20","start":3008020,"end":3008020,"break":"none","ruby":[[10,2,"おひつじ"],[13,2,"ふしぶし"],[16,1,"き"],[18,1,"わ"],[24,1,"あたま"],[26,1,"き"],[28,1,"わ"],[34,2,"しぼう"],[38,1,"や"]],"text":"そして、モーセはその雄羊を節々に切り分かち、その頭と切り分けたものと脂肪とを焼いた。"},{"ref":"Lev.8.21","start":3008021,"end":3008021,"break":"none","ruby":[[6,1,"みず"],[10,2,"ないぞう"],[13,1,"あし"],[16,1,"あら"],[21,2,"おひつじ"],[29,2,"さいだん"],[32,1,"うえ"],[34,1,"や"],[41,1,"こう"],[52,2,"はんさい"],[59,1,"しゅ"],[65,2,"かさい"],[71,1,"しゅ"],[77,1,"めい"]],"text":"またモーセは水でその内臓と足とを洗い、その雄羊をことごとく祭壇の上で焼いた。これは香ばしいかおりのための燔祭であって、主にささげる火祭である。主がモーセに命じられたとおりである。"},{"ref":"Lev.8.22","start":3008022,"end":3008022,"break":"paragraph","ruby":[[0,1,"かれ"],[7,2,"おひつじ"],[14,1,"にん"],[15,1,"しょく"],[17,2,"おひつじ"],[20,1,"つ"],[33,1,"こ"],[40,2,"おひつじ"],[43,1,"あたま"],[45,1,"て"],[47,1,"お"]],"text":"彼はまたほかの雄羊、すなわち任職の雄羊を連れてこさせ、アロンとその子たちは、その雄羊の頭に手を置いた。"},{"ref":"Lev.8.23","start":3008023,"end":3008023,"break":"none","ruby":[[13,1,"ち"],[15,1,"と"],[23,1,"みぎ"],[25,1,"みみ"],[30,2,"みぎて"],[33,2,"おやゆび"],[37,2,"みぎあし"],[40,2,"おやゆび"]],"text":"モーセはこれをほふり、その血を取って、アロンの右の耳たぶと、右手の親指と、右足の親指とにつけた。"},{"ref":"Lev.8.24","start":3008024,"end":3008024,"break":"none","ruby":[[10,1,"こ"],[14,1,"つ"],[22,1,"ち"],[24,1,"かれ"],[27,1,"みぎ"],[29,1,"みみ"],[34,2,"みぎて"],[37,2,"おやゆび"],[41,2,"みぎあし"],[44,2,"おやゆび"],[61,1,"のこ"],[64,1,"ち"],[67,2,"さいだん"],[70,2,"しゅうい"],[73,1,"そそ"]],"text":"またモーセはアロンの子たちを連れてきて、その血を彼らの右の耳たぶと、右手の親指と、右足の親指とにつけた。そしてモーセはその残りの血を、祭壇の周囲に注ぎかけた。"},{"ref":"Lev.8.25","start":3008025,"end":3008025,"break":"none","ruby":[[0,1,"かれ"],[6,2,"しぼう"],[13,1,"あぶら"],[14,1,"お"],[16,2,"ないぞう"],[19,1,"うえ"],[25,2,"しぼう"],[28,2,"かんぞう"],[31,2,"しょうよう"],[37,2,"じんぞう"],[42,2,"しぼう"],[51,1,"みぎ"],[56,1,"と"]],"text":"彼はまたその脂肪、すなわち脂尾、内臓の上のすべての脂肪、肝臓の小葉、二つの腎臓とその脂肪、ならびにその右のももを取り、"},{"ref":"Lev.8.26","start":3008026,"end":3008026,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"まえ"],[8,1,"たね"],[9,1,"い"],[19,1,"たね"],[20,1,"い"],[23,2,"かし"],[29,1,"あぶら"],[31,1,"い"],[37,2,"かし"],[43,2,"せんべい"],[49,1,"と"],[55,2,"しぼう"],[58,1,"みぎ"],[64,1,"うえ"],[66,1,"の"]],"text":"また主の前にある種入れぬパンのかごから種入れぬ菓子一つと、油を入れたパンの菓子一つと、煎餅一つとを取って、かの脂肪と右のももとの上に載せ、"},{"ref":"Lev.8.27","start":3008027,"end":3008027,"break":"none","ruby":[[10,1,"て"],[15,1,"こ"],[19,1,"て"],[21,1,"わた"],[24,1,"しゅ"],[26,1,"まえ"],[28,1,"ゆ"],[30,1,"うご"],[35,2,"ようさい"]],"text":"これをすべてアロンの手と、その子たちの手に渡し、主の前に揺り動かさせて揺祭とした。"},{"ref":"Lev.8.28","start":3008028,"end":3008028,"break":"none","ruby":[[10,1,"かれ"],[13,1,"て"],[16,1,"と"],[19,2,"さいだん"],[22,1,"うえ"],[24,2,"はんさい"],[27,1,"とも"],[29,1,"や"],[36,1,"こう"],[46,1,"にん"],[47,1,"しょく"],[49,1,"そな"],[51,1,"もの"],[57,1,"しゅ"],[63,2,"かさい"]],"text":"そしてモーセはこれを彼らの手から取り、祭壇の上で燔祭と共に焼いた。これは香ばしいかおりとする任職の供え物であって、主にささげる火祭である。"},{"ref":"Lev.8.29","start":3008029,"end":3008029,"break":"none","ruby":[[9,1,"むね"],[11,1,"と"],[14,1,"しゅ"],[16,1,"まえ"],[21,1,"ゆ"],[23,1,"うご"],[27,2,"ようさい"],[36,1,"にん"],[37,1,"しょく"],[39,2,"おひつじ"],[48,1,"き"],[52,1,"ぶん"],[58,1,"しゅ"],[64,1,"めい"]],"text":"そしてモーセはその胸を取り、主の前にこれを揺り動かして揺祭とした。これは任職の雄羊のうちモーセに帰すべき分であった。主がモーセに命じられたとおりである。"},{"ref":"Lev.8.30","start":3008030,"end":3008030,"break":"paragraph","ruby":[[6,1,"そそ"],[8,1,"あぶら"],[10,2,"さいだん"],[13,1,"うえ"],[15,1,"ち"],[18,1,"と"],[30,1,"ふく"],[36,1,"こ"],[42,1,"ふく"],[45,1,"そそ"],[55,1,"ふく"],[62,1,"こ"],[69,1,"ふく"],[72,2,"せいべつ"]],"text":"モーセはまた注ぎ油と祭壇の上の血とを取り、これをアロンとその服、またその子たちとその服とに注いで、アロンとその服、およびその子たちと、その服とを聖別した。"},{"ref":"Lev.8.31","start":3008031,"end":3008031,"break":"paragraph","ruby":[[12,1,"こ"],[16,1,"い"],[21,2,"かいけん"],[24,2,"まくや"],[27,2,"いりぐち"],[32,1,"にく"],[34,1,"に"],[42,3,"にんしょくさい"],[49,1,"なか"],[54,1,"とも"],[62,1,"ところ"],[64,1,"た"],[80,1,"こ"],[84,1,"た"],[96,1,"い"],[104,1,"めい"]],"text":"モーセはまたアロンとその子たちに言った、「会見の幕屋の入口でその肉を煮なさい。そして任職祭のかごの中のパンと共に、それをその所で食べなさい。これは『アロンとその子たちが食べなければならない、と言え』とわたしが命じられたとおりである。"},{"ref":"Lev.8.32","start":3008032,"end":3008032,"break":"none","ruby":[[8,1,"にく"],[14,1,"のこ"],[20,1,"ひ"],[22,1,"や"],[24,1,"す"]],"text":"あなたがたはその肉とパンとの残ったものを火で焼き捨てなければならない。"},{"ref":"Lev.8.33","start":3008033,"end":3008033,"break":"none","ruby":[[8,3,"にんしょくさい"],[12,1,"おわ"],[14,1,"ひ"],[17,2,"なぬか"],[20,1,"あいだ"],[22,2,"かいけん"],[25,2,"まくや"],[28,2,"いりぐち"],[32,1,"で"],[46,1,"にん"],[47,1,"しょく"],[49,2,"なぬか"],[52,1,"よう"]],"text":"あなたがたはその任職祭の終る日まで七日の間、会見の幕屋の入口から出てはならない。あなたがたの任職は七日を要するからである。"},{"ref":"Lev.8.34","start":3008034,"end":3008034,"break":"none","ruby":[[3,1,"おこな"],[29,1,"しゅ"],[32,1,"めい"]],"text":"きょう行ったように、あなたがたのために、あがないをせよ、と主はお命じになった。"},{"ref":"Lev.8.35","start":3008035,"end":3008035,"break":"none","ruby":[[6,2,"かいけん"],[9,2,"まくや"],[12,2,"いりぐち"],[15,2,"なぬか"],[18,1,"あいだ"],[20,2,"にちや"],[27,1,"しゅ"],[29,1,"おお"],[32,1,"まも"],[36,1,"し"],[65,1,"めい"]],"text":"あなたがたは会見の幕屋の入口に七日の間、日夜とどまり、主の仰せを守って、死ぬことのないようにしなければならない。わたしはそのように命じられたからである」。"},{"ref":"Lev.8.36","start":3008036,"end":3008036,"break":"none","ruby":[[6,1,"こ"],[10,1,"しゅ"],[20,1,"めい"],[35,1,"おこな"]],"text":"アロンとその子たちは主がモーセによってお命じになったことを、ことごとく行った。"}]