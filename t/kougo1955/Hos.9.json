[{"ref":"Hos.9.1","start":28009001,"end":28009001,"break":"paragraph","breaks":[[7,"line"],[24,"line"],[44,"line"]],"ruby":[[12,1,"たみ"],[17,1,"よろこ"],[28,2,"いんこう"],[39,1,"かみ"],[41,1,"はな"],[48,2,"こくもつ"],[51,1,"う"],[53,1,"ば"],[55,1,"う"],[58,2,"いんこう"],[61,1,"あたい"],[63,1,"あい"]],"text":"イスラエルよ、もろもろの民のように喜びおどるな。あなたは淫行をなして、あなたの神を離れ、すべての穀物の打ち場で受ける淫行の価を愛した。"},{"ref":"Hos.9.2","start":28009002,"end":28009002,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"う"],[2,1,"ば"],[4,1,"さか"],[9,1,"かれ"],[12,1,"やしな"],[19,1,"あたら"],[22,1,"さけ"]],"text":"打ち場と酒ぶねとは彼らを養わない。また新しい酒もむなしくなる。"},{"ref":"Hos.9.3","start":28009003,"end":28009003,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[3,1,"しゅ"],[5,1,"ち"],[7,1,"す"],[25,1,"かえ"],[34,1,"けが"],[37,1,"もの"],[39,1,"た"]],"text":"彼らは主の地に住むことなく、エフライムはエジプトに帰り、アッスリヤで汚れた物を食べる。"},{"ref":"Hos.9.4","start":28009004,"end":28009004,"break":"stanza","breaks":[[15,"line"],[30,"line"],[49,"line"],[65,"line"],[86,"line"]],"ruby":[[0,1,"かれ"],[3,1,"しゅ"],[5,1,"む"],[9,1,"さけ"],[11,1,"そそ"],[17,2,"ぎせい"],[23,1,"しゅ"],[25,1,"よろこ"],[30,1,"かれ"],[36,1,"も"],[40,1,"もの"],[55,1,"た"],[58,1,"もの"],[60,1,"けが"],[65,1,"かれ"],[73,2,"じぶん"],[76,1,"う"],[79,1,"み"],[86,1,"しゅ"],[88,1,"いえ"]],"text":"彼らは主に向かって酒を注がず、また犠牲をもって主を喜ばせず、彼らのパンは喪におる者のパンのようで、すべてこれを食べる者は汚される。彼らのパンはただ自分の飢えを満たすためで、主の家に、はいることはできない。"},{"ref":"Hos.9.5","start":28009005,"end":28009005,"break":"stanza","breaks":[[18,"line"]],"ruby":[[6,1,"いわい"],[8,1,"ひ"],[11,1,"しゅ"],[13,1,"まつり"],[15,1,"ひ"],[18,1,"なに"]],"text":"あなたがたは祝の日と、主の祭の日に、何をしようとするのか。"},{"ref":"Hos.9.6","start":28009006,"end":28009006,"break":"line","breaks":[[15,"line"],[26,"line"],[37,"line"],[53,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[12,1,"い"],[20,1,"かれ"],[23,1,"あつ"],[31,1,"かれ"],[34,1,"ほうむ"],[41,1,"かれ"],[44,1,"ぎん"],[46,2,"たからもの"],[49,2,"しょゆう"],[57,1,"かれ"],[60,2,"てんまく"]],"text":"見よ、彼らはアッスリヤへ行く。エジプトは彼らを集め、メンピスは彼らを葬る。あざみは彼らの銀の宝物を所有し、いばらは彼らの天幕にはびこる。"},{"ref":"Hos.9.7","start":28009007,"end":28009007,"break":"stanza","breaks":[[8,"line"],[16,"line"],[28,"line"],[37,"line"],[50,"line"],[65,"line"]],"ruby":[[0,2,"けいばつ"],[3,1,"ひ"],[5,1,"き"],[8,1,"むく"],[11,1,"ひ"],[13,1,"き"],[25,1,"し"],[28,3,"よげんしゃ"],[32,1,"おろ"],[35,1,"もの"],[37,1,"れい"],[39,1,"かん"],[42,1,"ひと"],[44,1,"くる"],[47,1,"もの"],[59,2,"ふぎ"],[62,1,"おお"],[65,1,"うら"],[68,1,"おお"]],"text":"刑罰の日は来た。報いの日は来た。イスラエルはこれを知る。預言者は愚かな者、霊に感じた人は狂った者だ。これはあなたがたの不義が多く、恨みが大きいためである。"},{"ref":"Hos.9.8","start":28009008,"end":28009008,"break":"line","breaks":[[22,"line"],[36,"line"],[48,"line"]],"ruby":[[0,3,"よげんしゃ"],[6,1,"かみ"],[8,1,"たみ"],[15,2,"みはり"],[17,1,"にん"],[25,3,"よげんしゃ"],[33,1,"みち"],[36,1,"とり"],[40,1,"もの"],[48,1,"うら"],[53,1,"かみ"],[55,1,"いえ"]],"text":"預言者はわが神の民エフライムの見張人である。しかし預言者のすべての道には鳥をとる者のわながあり、恨みはその神の家にある。"},{"ref":"Hos.9.9","start":28009009,"end":28009009,"break":"line","breaks":[[13,"line"],[24,"line"]],"ruby":[[0,1,"かれ"],[7,1,"ひ"],[13,1,"ふか"],[19,1,"くさ"],[24,1,"しゅ"],[28,2,"ふぎ"],[31,1,"おぼ"],[36,1,"つみ"],[38,1,"ばっ"]],"text":"彼らはギベアの日のように、深くおのれを腐らせた。主はその不義を覚え、その罪を罰せられる。"},{"ref":"Hos.9.10","start":28009010,"end":28009010,"break":"stanza","breaks":[[22,"line"],[34,"line"],[57,"line"],[75,"line"],[85,"line"]],"ruby":[[10,2,"あらの"],[20,1,"み"],[28,2,"せんぞ"],[39,1,"き"],[41,1,"はじ"],[44,1,"むす"],[47,1,"はつ"],[54,1,"み"],[61,1,"かれ"],[72,1,"い"],[75,1,"み"],[85,1,"かれ"],[88,1,"あい"],[91,1,"もの"],[93,1,"おな"],[98,1,"にく"],[102,1,"もの"]],"text":"わたしはイスラエルを荒野のぶどうのように見、あなたがたの先祖たちを、いちじくの木の初めに結んだ初なりのように見た。ところが彼らはバアル・ペオルへ行き、身をバアルにゆだね、彼らが愛した物と同じように憎むべき者となった。"},{"ref":"Hos.9.11","start":28009011,"end":28009011,"break":"line","breaks":[[20,"line"],[37,"line"]],"ruby":[[6,2,"えいこう"],[10,1,"とり"],[17,1,"さ"],[24,1,"う"]],"text":"エフライムの栄光は、鳥のようにとび去る。すなわち産むことも、はらむことも、みごもることもなくなる。"},{"ref":"Hos.9.12","start":28009012,"end":28009012,"break":"line","breaks":[[13,"line"],[37,"line"]],"ruby":[[3,1,"かれ"],[6,1,"こ"],[8,1,"そだ"],[19,1,"こ"],[21,1,"うば"],[25,1,"のこ"],[27,1,"もの"],[41,1,"かれ"],[44,1,"はな"],[50,1,"かれ"]],"text":"たとい彼らが子を育てても、わたしはその子を奪って、残る者のないようにする。わたしが彼らを離れるとき、彼らはわざわいだ。"},{"ref":"Hos.9.13","start":28009013,"end":28009013,"break":"line","breaks":[[10,"line"],[29,"line"],[41,"line"]],"ruby":[[4,1,"み"],[16,1,"こ"],[23,1,"さだ"],[37,1,"こ"],[41,1,"ひと"],[43,1,"ころ"],[45,1,"もの"],[47,1,"わた"]],"text":"わたしが見たように、エフライムの子らはえじきに定められた。エフライムはその子らを、人を殺す者に渡さなければならない。"},{"ref":"Hos.9.14","start":28009014,"end":28009014,"break":"line","breaks":[[14,"line"],[28,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かれ"],[6,1,"あた"],[18,1,"なに"],[20,1,"あた"],[28,2,"りゅうざん"],[31,1,"たい"],[38,1,"ち"],[42,1,"かれ"],[45,1,"あた"]],"text":"主よ、彼らに与えてください。あなたは何を与えられますか。流産の胎と、かわいた乳ぶさを彼らに与えてください。"},{"ref":"Hos.9.15","start":28009015,"end":28009015,"break":"stanza","breaks":[[17,"line"],[32,"line"],[48,"line"],[61,"line"],[74,"line"]],"ruby":[[0,1,"かれ"],[7,1,"あく"],[25,1,"かれ"],[28,1,"にく"],[32,1,"かれ"],[40,1,"あ"],[48,1,"かれ"],[53,1,"や"],[56,1,"お"],[61,1,"かさ"],[64,1,"あい"],[76,1,"きみ"],[83,3,"はんぎゃくしゃ"]],"text":"彼らのすべての悪はギルガルにある。わたしはかしこで彼らを憎んだ。彼らのおこないの悪しきがゆえに、彼らをわが家から追いだし、重ねて愛することをしない。その君たちはみな、反逆者である。"},{"ref":"Hos.9.16","start":28009016,"end":28009016,"break":"stanza","breaks":[[10,"line"],[25,"line"],[38,"line"]],"ruby":[[6,1,"う"],[12,1,"ね"],[14,1,"か"],[18,1,"み"],[20,1,"むす"],[28,1,"かれ"],[31,1,"こ"],[33,1,"う"],[49,1,"こ"],[52,1,"ころ"]],"text":"エフライムは撃たれ、その根は枯れて、実を結ばない。たとい彼らが子を産んでも、わたしはそのいつくしむ子らを殺す。"},{"ref":"Hos.9.17","start":28009017,"end":28009017,"break":"line","breaks":[[12,"line"],[25,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[3,1,"き"],[5,1,"したが"],[14,1,"かみ"],[19,1,"す"],[25,1,"かれ"],[33,2,"くにたみ"],[44,1,"ひと"]],"text":"彼らは聞き従わないので、わが神はこれを捨てられる。彼らはもろもろの国民のうちに、さすらい人となる。"}]