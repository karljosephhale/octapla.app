[{"ref":"Acts.1.1","start":44001001,"end":44001001,"break":"paragraph","ruby":[[10,1,"さき"],[12,1,"だい"],[14,1,"かん"],[16,1,"あら"],[25,1,"おこな"],[30,1,"おし"]],"text":"テオピロよ、わたしは先に第一巻を著わして、イエスが行い、また教えはじめてから、"},{"ref":"Acts.1.2","start":44001002,"end":44001002,"break":"none","ruby":[[1,1,"えら"],[7,2,"しと"],[13,2,"せいれい"],[19,1,"めい"],[25,1,"てん"],[27,1,"あ"],[32,1,"ひ"]],"text":"お選びになった使徒たちに、聖霊によって命じたのち、天に上げられた日までのことを、ことごとくしるした。"},{"ref":"Acts.1.3","start":44001003,"end":44001003,"break":"none","ruby":[[4,2,"くなん"],[7,1,"う"],[13,2,"じぶん"],[16,1,"い"],[24,2,"かずかず"],[27,1,"たし"],[30,2,"しょうこ"],[36,1,"しめ"],[41,1,"にち"],[51,1,"かれ"],[54,1,"あらわ"],[58,1,"かみ"],[60,1,"くに"],[65,1,"かた"]],"text":"イエスは苦難を受けたのち、自分の生きていることを数々の確かな証拠によって示し、四十日にわたってたびたび彼らに現れて、神の国のことを語られた。"},{"ref":"Acts.1.4","start":44001004,"end":44001004,"break":"none","ruby":[[3,2,"しょくじ"],[6,1,"とも"],[15,1,"かれ"],[19,1,"めい"],[34,1,"はな"],[48,1,"き"],[53,1,"ちち"],[55,2,"やくそく"],[58,1,"ま"]],"text":"そして食事を共にしているとき、彼らにお命じになった、「エルサレムから離れないで、かねてわたしから聞いていた父の約束を待っているがよい。"},{"ref":"Acts.1.5","start":44001005,"end":44001005,"break":"none","ruby":[[9,1,"みず"],[17,1,"さづ"],[28,1,"ま"],[32,2,"せいれい"],[45,1,"さづ"]],"text":"すなわち、ヨハネは水でバプテスマを授けたが、あなたがたは間もなく聖霊によって、バプテスマを授けられるであろう」。"},{"ref":"Acts.1.6","start":44001006,"end":44001006,"break":"paragraph","ruby":[[3,2,"でし"],[8,2,"いっしょ"],[11,1,"あつ"],[22,1,"と"],[25,1,"い"],[30,1,"しゅ"],[42,1,"くに"],[44,2,"ふっこう"],[54,1,"とき"]],"text":"さて、弟子たちが一緒に集まったとき、イエスに問うて言った、「主よ、イスラエルのために国を復興なさるのは、この時なのですか」。"},{"ref":"Acts.1.7","start":44001007,"end":44001007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[9,2,"じき"],[12,2,"ばあい"],[16,1,"ちち"],[19,2,"じぶん"],[22,2,"けんい"],[28,1,"さだ"],[47,1,"し"],[49,1,"かぎ"]],"text":"彼らに言われた、「時期や場合は、父がご自分の権威によって定めておられるのであって、あなたがたの知る限りではない。"},{"ref":"Acts.1.8","start":44001008,"end":44001008,"break":"none","ruby":[[3,2,"せいれい"],[15,1,"とき"],[23,1,"ちから"],[25,1,"う"],[44,2,"ぜんど"],[50,1,"ち"],[61,2,"しょうにん"]],"text":"ただ、聖霊があなたがたにくだる時、あなたがたは力を受けて、エルサレム、ユダヤとサマリヤの全土、さらに地のはてまで、わたしの証人となるであろう」。"},{"ref":"Acts.1.9","start":44001009,"end":44001009,"break":"none","ruby":[[2,1,"い"],[4,1,"おわ"],[12,1,"かれ"],[15,1,"み"],[19,1,"まえ"],[21,1,"てん"],[23,1,"あ"],[28,1,"くも"],[30,1,"むか"],[38,1,"すがた"],[40,1,"み"]],"text":"こう言い終ると、イエスは彼らの見ている前で天に上げられ、雲に迎えられて、その姿が見えなくなった。"},{"ref":"Acts.1.10","start":44001010,"end":44001010,"break":"none","ruby":[[4,1,"のぼ"],[7,1,"い"],[14,1,"かれ"],[17,1,"てん"],[19,1,"み"],[27,1,"み"],[30,1,"しろ"],[32,1,"ころも"],[34,1,"き"],[40,1,"ひと"],[43,1,"かれ"],[49,1,"た"]],"text":"イエスの上って行かれるとき、彼らが天を見つめていると、見よ、白い衣を着たふたりの人が、彼らのそばに立っていて"},{"ref":"Acts.1.11","start":44001011,"end":44001011,"break":"none","ruby":[[0,1,"い"],[10,1,"ひと"],[17,1,"てん"],[19,1,"あお"],[22,1,"た"],[36,1,"はな"],[39,1,"てん"],[41,1,"あ"],[53,1,"てん"],[55,1,"のぼ"],[58,1,"い"],[70,1,"み"],[74,1,"おな"],[76,2,"ありさま"]],"text":"言った、「ガリラヤの人たちよ、なぜ天を仰いで立っているのか。あなたがたを離れて天に上げられたこのイエスは、天に上って行かれるのをあなたがたが見たのと同じ有様で、またおいでになるであろう」。"},{"ref":"Acts.1.12","start":44001012,"end":44001012,"break":"paragraph","ruby":[[4,1,"かれ"],[14,1,"やま"],[16,1,"くだ"],[25,1,"かえ"],[31,1,"やま"],[39,1,"ちか"],[42,3,"あんそくにち"],[46,1,"ゆる"],[52,2,"きょり"]],"text":"それから彼らは、オリブという山を下ってエルサレムに帰った。この山はエルサレムに近く、安息日に許されている距離のところにある。"},{"ref":"Acts.1.13","start":44001013,"end":44001013,"break":"none","ruby":[[0,1,"かれ"],[4,2,"しない"],[7,1,"い"],[13,1,"と"],[19,2,"おくじょう"],[22,1,"ま"],[31,1,"ひと"],[77,1,"こ"],[82,2,"ねっしん"],[84,1,"とう"],[94,1,"こ"]],"text":"彼らは、市内に行って、その泊まっていた屋上の間にあがった。その人たちは、ペテロ、ヨハネ、ヤコブ、アンデレ、ピリポとトマス、バルトロマイとマタイ、アルパヨの子ヤコブと熱心党のシモンとヤコブの子ユダとであった。"},{"ref":"Acts.1.14","start":44001014,"end":44001014,"break":"none","ruby":[[0,1,"かれ"],[6,2,"ふじん"],[11,1,"とく"],[17,1,"はは"],[29,2,"きょうだい"],[34,1,"とも"],[37,1,"こころ"],[39,1,"あ"],[48,1,"いのり"]],"text":"彼らはみな、婦人たち、特にイエスの母マリヤ、およびイエスの兄弟たちと共に、心を合わせて、ひたすら祈をしていた。"},{"ref":"Acts.1.15","start":44001015,"end":44001015,"break":"paragraph","ruby":[[8,1,"めい"],[13,2,"ひとびと"],[17,2,"いちだん"],[23,1,"あつ"],[39,2,"きょうだい"],[44,1,"なか"],[46,1,"た"],[49,1,"い"]],"text":"そのころ、百二十名ばかりの人々が、一団となって集まっていたが、ペテロはこれらの兄弟たちの中に立って言った、"},{"ref":"Acts.1.16","start":44001016,"end":44001016,"break":"none","ruby":[[1,2,"きょうだい"],[11,1,"とら"],[14,1,"もの"],[18,1,"て"],[33,2,"せいれい"],[40,1,"くち"],[46,2,"よげん"],[52,2,"ことば"],[56,2,"じょうじゅ"]],"text":"「兄弟たちよ、イエスを捕えた者たちの手びきになったユダについては、聖霊がダビデの口をとおして預言したその言葉は、成就しなければならなかった。"},{"ref":"Acts.1.17","start":44001017,"end":44001017,"break":"none","ruby":[[0,1,"かれ"],[8,2,"なかま"],[11,1,"くわ"],[18,1,"つとめ"],[20,1,"さず"],[26,1,"もの"]],"text":"彼はわたしたちの仲間に加えられ、この務を授かっていた者であった。（"},{"ref":"Acts.1.18","start":44001018,"end":44001018,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ふぎ"],[5,2,"ほうしゅう"],[11,2,"じしょ"],[14,1,"て"],[16,1,"い"],[31,1,"お"],[35,1,"はら"],[39,1,"なか"],[42,1,"ひ"],[44,1,"さ"],[54,1,"なが"],[56,1,"で"]],"text":"彼は不義の報酬で、ある地所を手に入れたが、そこへまっさかさまに落ちて、腹がまん中から引き裂け、はらわたがみな流れ出てしまった。"},{"ref":"Acts.1.19","start":44001019,"end":44001019,"break":"none","ruby":[[6,1,"こと"],[14,1,"ぜん"],[15,2,"じゅうみん"],[18,1,"し"],[30,2,"じしょ"],[33,1,"かれ"],[36,2,"こくご"],[45,1,"よ"],[57,1,"ち"],[59,2,"じしょ"],[64,1,"い"]],"text":"そして、この事はエルサレムの全住民に知れわたり、そこで、この地所が彼らの国語でアケルダマと呼ばれるようになった。「血の地所」との意である。）"},{"ref":"Acts.1.20","start":44001020,"end":44001020,"break":"none","breaks":[[4,"stanza"],[16,"line"],[43,"stanza"]],"ruby":[[0,2,"しへん"],[7,2,"やしき"],[10,1,"あ"],[12,1,"は"],[24,1,"す"],[26,1,"もの"],[35,1,"か"],[46,1,"しょく"],[52,1,"もの"],[54,1,"と"]],"text":"詩篇に、『その屋敷は荒れ果てよ、そこにはひとりも住む者がいなくなれ』と書いてあり、また『その職は、ほかの者に取らせよ』とあるとおりである。"},{"ref":"Acts.1.21","start":44001021,"end":44001021,"break":"none","ruby":[[8,1,"しゅ"],[19,1,"あいだ"],[27,3,"きかんちゅう"]],"text":"そういうわけで、主イエスがわたしたちの間にゆききされた期間中、"},{"ref":"Acts.1.22","start":44001022,"end":44001022,"break":"none","ruby":[[15,1,"とき"],[18,1,"はじ"],[29,1,"はな"],[32,1,"てん"],[34,1,"あ"],[39,1,"ひ"],[41,1,"いた"],[46,2,"しじゅう"],[54,2,"こうどう"],[57,1,"とも"],[61,1,"ひと"],[82,1,"くわ"],[86,1,"しゅ"],[88,2,"ふっかつ"],[91,2,"しょうにん"]],"text":"すなわち、ヨハネのバプテスマの時から始まって、わたしたちを離れて天に上げられた日に至るまで、始終わたしたちと行動を共にした人たちのうち、だれかひとりが、わたしたちに加わって主の復活の証人にならねばならない」。"},{"ref":"Acts.1.23","start":44001023,"end":44001023,"break":"none","ruby":[[3,2,"いちどう"],[12,1,"よ"],[19,1,"な"],[42,1,"た"]],"text":"そこで一同は、バルサバと呼ばれ、またの名をユストというヨセフと、マッテヤとのふたりを立て、"},{"ref":"Acts.1.24","start":44001024,"end":44001024,"break":"none","ruby":[[0,1,"いの"],[3,1,"い"],[12,1,"ひと"],[14,1,"こころ"],[17,1,"ぞん"],[22,1,"しゅ"],[38,1,"えら"]],"text":"祈って言った、「すべての人の心をご存じである主よ。このふたりのうちのどちらを選んで、"},{"ref":"Acts.1.25","start":44001025,"end":44001025,"break":"none","ruby":[[5,2,"しと"],[8,2,"しょくむ"],[12,1,"お"],[16,2,"じぶん"],[19,1,"い"],[27,1,"い"],[35,1,"つ"],[46,1,"しめ"],[48,1,"くだ"]],"text":"ユダがこの使徒の職務から落ちて、自分の行くべきところへ行ったそのあとを継がせなさいますか、お示し下さい」。"},{"ref":"Acts.1.26","start":44001026,"end":44001026,"break":"none","ruby":[[15,1,"ひ"],[27,1,"あた"],[35,1,"ひと"],[39,1,"にん"],[41,2,"しと"],[46,1,"くわ"]],"text":"それから、ふたりのためにくじを引いたところ、マッテヤに当ったので、この人が十一人の使徒たちに加えられることになった。"}]