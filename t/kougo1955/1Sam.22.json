[{"ref":"1Sam.22.1","start":9022001,"end":9022001,"break":"paragraph","ruby":[[10,1,"ところ"],[12,1,"さ"],[22,1,"あな"],[29,1,"かれ"],[31,2,"きょうだい"],[36,1,"ちち"],[38,1,"いえ"],[40,1,"もの"],[42,1,"みな"],[47,1,"き"],[52,1,"ところ"],[54,1,"くだ"],[57,1,"かれ"]],"text":"こうしてダビデはその所を去り、アドラムのほら穴へのがれた。彼の兄弟たちと父の家の者は皆、これを聞き、その所に下って彼のもとにきた。"},{"ref":"1Sam.22.2","start":9022002,"end":9022002,"break":"none","ruby":[[12,2,"ひとびと"],[15,2,"ふさい"],[20,2,"ひとびと"],[23,1,"こころ"],[25,2,"ふまん"],[30,2,"ひとびと"],[33,1,"みな"],[35,1,"かれ"],[40,1,"あつ"],[47,1,"かれ"],[51,1,"ちょう"],[63,1,"にん"],[65,2,"ひとびと"],[68,1,"かれ"],[70,1,"とも"]],"text":"また、しえたげられている人々、負債のある人々、心に不満のある人々も皆、彼のもとに集まってきて、彼はその長となった。おおよそ四百人の人々が彼と共にあった。"},{"ref":"1Sam.22.3","start":9022003,"end":9022003,"break":"paragraph","ruby":[[16,1,"い"],[23,1,"おう"],[25,1,"い"],[30,1,"かみ"],[62,2,"ふぼ"],[69,1,"ところ"]],"text":"ダビデはそこからモアブのミヅパへ行き、モアブの王に言った、「神がわたしのためにどんなことをされるかわかるまで、どうぞわたしの父母をあなたの所におらせてください」。"},{"ref":"1Sam.22.4","start":9022004,"end":9022004,"break":"none","ruby":[[3,1,"かれ"],[9,1,"おう"],[11,1,"かれ"],[14,1,"たく"],[20,1,"かれ"],[27,2,"ようがい"],[32,1,"あいだ"],[34,1,"おう"],[36,1,"ところ"]],"text":"そして彼はモアブの王に彼らを託したので、彼らはダビデが要害におる間、王の所におった。"},{"ref":"1Sam.22.5","start":9022005,"end":9022005,"break":"none","ruby":[[3,3,"よげんしゃ"],[13,1,"い"],[18,2,"ようがい"],[31,1,"さ"],[37,1,"ち"],[39,1,"い"],[53,1,"さ"],[61,1,"もり"],[63,1,"い"]],"text":"さて、預言者ガドはダビデに言った、「要害にとどまっていないで、去ってユダの地へ行きなさい」。そこでダビデは去って、ハレテの森へ行った。"},{"ref":"1Sam.22.6","start":9022006,"end":9022006,"break":"paragraph","ruby":[[11,1,"かれ"],[13,1,"とも"],[17,2,"ひとびと"],[20,1,"み"],[31,1,"き"],[47,1,"て"],[53,1,"おか"],[61,1,"き"],[63,1,"した"],[72,2,"けらい"],[85,1,"た"]],"text":"サウルは、ダビデおよび彼と共にいる人々が見つかったということを聞いた。サウルはギベアで、やりを手にもって、丘のぎょりゅうの木の下にすわっており、家来たちはみなそのまわりに立っていた。"},{"ref":"1Sam.22.7","start":9022007,"end":9022007,"break":"none","ruby":[[8,1,"た"],[13,2,"けらい"],[18,1,"い"],[36,1,"き"],[47,1,"こ"],[62,1,"はたけ"],[67,1,"はたけ"],[69,1,"あた"],[78,1,"にん"],[80,1,"ちょう"],[83,1,"にん"],[85,1,"ちょう"]],"text":"サウルはまわりに立っている家来たちに言った、「あなたがたベニヤミンびとは聞きなさい。エッサイの子もまた、あなたがたおのおのに畑やぶどう畑を与え、おのおのを千人の長、百人の長にするであろうか。"},{"ref":"1Sam.22.8","start":9022008,"end":9022008,"break":"none","ruby":[[6,1,"みな"],[7,1,"とも"],[17,1,"てき"],[25,1,"こ"],[32,1,"こ"],[34,2,"けいやく"],[37,1,"むす"],[49,1,"つ"],[80,1,"うれ"],[96,1,"こ"],[116,1,"さか"],[121,1,"みち"],[123,1,"かれ"],[129,1,"ま"],[131,1,"ぶ"],[147,1,"つ"],[150,1,"もの"]],"text":"あなたがたは皆共にはかってわたしに敵した。わたしの子がエッサイの子と契約を結んでも、それをわたしに告げるものはなく、またあなたがたのうち、ひとりもわたしのために憂えず、きょうのように、わたしの子がわたしのしもべをそそのかしてわたしに逆らわせ、道で彼がわたしを待ち伏せするようになっても、わたしに告げる者はない」。"},{"ref":"1Sam.22.9","start":9022009,"end":9022009,"break":"none","ruby":[[2,1,"とき"],[17,2,"けらい"],[25,1,"た"],[32,1,"こた"],[35,1,"い"],[49,1,"こ"],[61,1,"こ"],[68,1,"ところ"],[74,1,"み"]],"text":"その時エドムびとドエグは、サウルの家来たちのそばに立っていたが、答えて言った、「わたしはエッサイの子がノブにいるアヒトブの子アヒメレクの所にきたのを見ました。"},{"ref":"1Sam.22.10","start":9022010,"end":9022010,"break":"none","ruby":[[6,1,"かれ"],[11,1,"しゅ"],[13,1,"と"],[18,1,"かれ"],[20,2,"しょくもつ"],[23,1,"あた"],[41,1,"あた"]],"text":"アヒメレクは彼のために主に問い、また彼に食物を与え、ペリシテびとゴリアテのつるぎを与えました」。"},{"ref":"1Sam.22.11","start":9022011,"end":9022011,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"ひと"],[18,1,"こ"],[19,2,"さいし"],[29,1,"ちち"],[31,1,"いえ"],[37,1,"もの"],[46,2,"さいし"],[51,1,"め"],[59,1,"おう"],[61,1,"ところ"]],"text":"そこで王は人をつかわして、アヒトブの子祭司アヒメレクとその父の家のすべての者、すなわちノブの祭司たちを召したので、みな王の所にきた。"},{"ref":"1Sam.22.12","start":9022012,"end":9022012,"break":"none","ruby":[[4,1,"い"],[14,1,"こ"],[17,1,"き"],[24,1,"かれ"],[26,1,"こた"],[33,1,"しゅ"]],"text":"サウルは言った、「アヒトブの子よ、聞きなさい」。彼は答えた、「わが主よ、わたしはここにおります」。"},{"ref":"1Sam.22.13","start":9022013,"end":9022013,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[24,1,"こ"],[26,1,"とも"],[36,1,"てき"],[39,1,"かれ"],[48,1,"あた"],[51,1,"かれ"],[56,1,"かみ"],[58,1,"と"],[68,1,"かれ"],[74,1,"さか"],[78,1,"た"],[82,1,"みち"],[84,1,"ま"],[86,1,"ぶ"]],"text":"サウルは彼に言った、「どうしてあなたはエッサイの子と共にはかってわたしに敵し、彼にパンとつるぎを与え、彼のために神に問い、きょうのように彼をわたしに逆らって立たせ、道で待ち伏せさせるのか」。"},{"ref":"1Sam.22.14","start":9022014,"end":9022014,"break":"none","ruby":[[6,1,"おう"],[8,1,"こた"],[11,1,"い"],[20,2,"けらい"],[33,2,"ちゅうぎ"],[36,1,"もの"],[47,1,"かれ"],[49,1,"おう"],[51,1,"むすめ"],[52,1,"むこ"],[57,2,"このえ"],[59,1,"へい"],[61,1,"ちょう"],[71,1,"いえ"],[73,1,"たっと"],[77,1,"ひと"]],"text":"アヒメレクは王に答えて言った、「あなたの家来のうち、ダビデのように忠義な者がほかにありますか。彼は王の娘婿であり、近衛兵の長であって、あなたの家で尊ばれる人ではありませんか。"},{"ref":"1Sam.22.15","start":9022015,"end":9022015,"break":"none","ruby":[[0,1,"かれ"],[5,1,"かみ"],[7,1,"と"],[16,1,"はじ"],[29,1,"けっ"],[42,1,"おう"],[53,1,"ちち"],[55,2,"ぜんか"],[58,1,"つみ"],[60,1,"お"],[84,1,"こと"],[86,2,"だいしょう"],[89,1,"と"],[93,1,"なに"],[96,1,"し"]],"text":"彼のために神に問うたのは、きょう初めてでしょうか。いいえ、決してそうではありません。王よ、どうぞ、しもべと父の全家に罪を負わせないでください。しもべは、これについては、事の大小を問わず、何をも知らなかったのです」。"},{"ref":"1Sam.22.16","start":9022016,"end":9022016,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[18,1,"かなら"],[20,1,"ころ"],[36,1,"ちち"],[38,2,"ぜんか"],[41,1,"おな"]],"text":"王は言った、「アヒメレクよ、あなたは必ず殺されなければならない。あなたの父の全家も同じである」。"},{"ref":"1Sam.22.17","start":9022017,"end":9022017,"break":"none","ruby":[[3,1,"おう"],[9,1,"た"],[14,2,"このえ"],[17,1,"へい"],[19,1,"い"],[24,1,"み"],[33,1,"しゅ"],[35,2,"さいし"],[40,1,"ころ"],[46,1,"かれ"],[53,2,"きょうりょく"],[64,1,"に"],[69,1,"し"],[82,1,"つ"],[98,1,"おう"],[100,2,"けらい"],[105,1,"しゅ"],[107,2,"さいし"],[112,1,"ころ"],[117,1,"て"],[119,1,"くだ"]],"text":"そして王はまわりに立っている近衛の兵に言った、「身をひるがえして、主の祭司たちを殺しなさい。彼らもダビデと協力していて、ダビデの逃げたのを知りながら、それをわたしに告げなかったからです」。ところが王の家来たちは主の祭司たちを殺すために手を下そうとはしなかった。"},{"ref":"1Sam.22.18","start":9022018,"end":9022018,"break":"none","ruby":[[3,1,"おう"],[9,1,"い"],[18,1,"み"],[27,2,"さいし"],[32,1,"ころ"],[48,1,"み"],[56,2,"さいし"],[61,1,"う"],[66,1,"ひ"],[67,2,"あま"],[69,1,"ぬの"],[75,1,"み"],[82,1,"もの"],[86,1,"にん"],[88,1,"ころ"]],"text":"そこで王はドエグに言った、「あなたが身をひるがえして、祭司たちを殺しなさい」。エドムびとドエグは身をひるがえして祭司たちを撃ち、その日亜麻布のエポデを身につけている者八十五人を殺した。"},{"ref":"1Sam.22.19","start":9022019,"end":9022019,"break":"none","ruby":[[0,1,"かれ"],[12,2,"さいし"],[15,1,"まち"],[19,1,"う"],[29,1,"おとこ"],[31,1,"おんな"],[33,1,"おさ"],[35,1,"こ"],[37,2,"ちの"],[40,1,"ご"],[42,1,"うし"],[47,1,"ひつじ"],[49,1,"ころ"]],"text":"彼はまた、つるぎをもって祭司の町ノブを撃ち、つるぎをもって男、女、幼な子、乳飲み子、牛、ろば、羊を殺した。"},{"ref":"1Sam.22.20","start":9022020,"end":9022020,"break":"paragraph","ruby":[[8,1,"こ"],[15,1,"こ"],[24,1,"な"],[34,1,"ひと"],[45,1,"ところ"],[47,1,"はし"]],"text":"しかしアヒトブの子アヒメレクの子たちのひとりで、名をアビヤタルという人は、のがれてダビデの所に走った。"},{"ref":"1Sam.22.21","start":9022021,"end":9022021,"break":"none","ruby":[[14,1,"しゅ"],[16,2,"さいし"],[21,1,"ころ"],[31,1,"つ"]],"text":"そしてアビヤタルは、サウルが主の祭司たちを殺したことをダビデに告げたので、"},{"ref":"1Sam.22.22","start":9022022,"end":9022022,"break":"none","ruby":[[10,1,"い"],[17,1,"ひ"],[41,1,"かれ"],[50,1,"つ"],[58,1,"おも"],[70,1,"ちち"],[72,1,"いえ"],[74,2,"ひとびと"],[77,1,"いのち"],[79,1,"うしな"]],"text":"ダビデはアビヤタルに言った、「あの日、エドムびとドエグがあそこにいたので、わたしは彼がきっとサウルに告げるであろうと思った。わたしがあなたの父の家の人々の命を失わせるもととなったのです。"},{"ref":"1Sam.22.23","start":9022023,"end":9022023,"break":"none","ruby":[[8,1,"ところ"],[20,1,"おそ"],[36,1,"いのち"],[38,1,"もと"],[41,1,"もの"],[48,1,"いのち"],[51,1,"もと"],[64,1,"ところ"],[78,2,"あんぜん"]],"text":"あなたはわたしの所にとどまってください。恐れることはありません。あなたの命を求める者は、わたしの命をも求めているのです。わたしの所におられるならば、あなたは安全でしょう」。"}]