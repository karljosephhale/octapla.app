[{"ref":"Ps.89.1","start":19089001,"end":19089001,"break":"paragraph","title":"エズラびとエタンのマスキールの歌","breaks":[[25,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[22,1,"うた"],[29,1,"くち"],[47,1,"つ"],[49,1,"し"]],"titleRuby":[[15,1,"うた"]],"text":"主よ、わたしはとこしえにあなたのいつくしみを歌い、わたしの口をもってあなたのまことをよろずよに告げ知らせます。"},{"ref":"Ps.89.2","start":19089002,"end":19089002,"break":"line","breaks":[[20,"line"],[33,"line"]],"ruby":[[15,1,"かた"],[17,1,"た"],[28,1,"てん"]],"text":"あなたのいつくしみはとこしえに堅く立ち、あなたのまことは天のようにゆるぐことはありません。"},{"ref":"Ps.89.3","start":19089003,"end":19089003,"break":"line","breaks":[[11,"line"],[31,"line"]],"ruby":[[4,1,"い"],[20,1,"えら"],[23,1,"もの"],[25,2,"けいやく"],[28,1,"むす"],[42,1,"ちか"]],"text":"あなたは言われました、「わたしはわたしの選んだ者と契約を結び、わたしのしもべダビデに誓った、"},{"ref":"Ps.89.4","start":19089004,"end":19089004,"break":"line","breaks":[[21,"line"]],"ruby":[[9,2,"しそん"],[17,1,"かた"],[25,2,"おうざ"],[28,1,"た"],[37,1,"いた"]],"text":"『わたしはあなたの子孫をとこしえに堅くし、あなたの王座を建てて、よろずよに至らせる』」。〔セラ"},{"ref":"Ps.89.5","start":19089005,"end":19089005,"break":"line","breaks":[[10,"line"],[30,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"てん"],[30,1,"せい"],[33,1,"もの"]],"text":"主よ、もろもろの天にあなたのくすしきみわざをほめたたえさせ、聖なる者のつどいで、あなたのまことをほめたたえさせてください。"},{"ref":"Ps.89.6","start":19089006,"end":19089006,"break":"line","breaks":[[7,"line"],[25,"line"],[34,"line"]],"ruby":[[0,2,"おおぞら"],[10,1,"しゅ"],[12,1,"なら"],[25,1,"かみ"],[27,1,"こ"],[37,1,"しゅ"],[42,1,"もの"]],"text":"大空のうちに、だれか主と並ぶものがあるでしょうか。神の子らのうちに、だれか主のような者があるでしょうか。"},{"ref":"Ps.89.7","start":19089007,"end":19089007,"break":"line","breaks":[[19,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"せい"],[5,1,"もの"],[7,2,"かいぎ"],[13,1,"おそ"],[17,1,"かみ"],[31,1,"もの"],[37,1,"おお"],[41,1,"おそ"],[45,1,"もの"]],"text":"主は聖なる者の会議において恐るべき神、そのまわりにあるすべての者にまさって大いなる恐るべき者です。"},{"ref":"Ps.89.8","start":19089008,"end":19089008,"break":"line","breaks":[[8,"line"],[21,"line"],[36,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[5,1,"しゅ"],[8,1,"しゅ"],[21,2,"たいのう"],[26,1,"もの"]],"text":"万軍の神、主よ、主よ、だれかあなたのように大能のある者があるでしょうか。あなたのまことは、あなたをめぐっています。"},{"ref":"Ps.89.9","start":19089009,"end":19089009,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"うみ"],[6,1,"あ"],[11,1,"おさ"],[16,1,"なみ"],[18,1,"おこ"],[26,1,"しず"]],"text":"あなたは海の荒れるのを治め、その波の起るとき、これを静められます。"},{"ref":"Ps.89.10","start":19089010,"end":19089010,"break":"line","breaks":[[23,"line"]],"ruby":[[9,1,"ころ"],[13,1,"もの"],[18,1,"う"],[20,1,"くだ"],[27,1,"てき"],[29,1,"ちから"],[32,1,"うで"],[37,1,"ち"]],"text":"あなたはラハブを、殺された者のように打ち砕き、あなたの敵を力ある腕をもって散らされました。"},{"ref":"Ps.89.11","start":19089011,"end":19089011,"break":"line","breaks":[[14,"line"],[25,"line"],[38,"line"]],"ruby":[[5,1,"てん"],[14,1,"ち"],[25,2,"せかい"],[30,1,"なか"],[44,1,"もとい"]],"text":"もろもろの天はあなたのもの、地もまたあなたのもの、世界とその中にあるものとはあなたがその基をおかれたものです。"},{"ref":"Ps.89.12","start":19089012,"end":19089012,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"きた"],[2,1,"みなみ"],[11,1,"つく"],[29,1,"な"],[31,1,"よろこ"],[33,1,"うた"]],"text":"北と南はあなたがこれを造られました。タボルとヘルモンは、み名を喜び歌います。"},{"ref":"Ps.89.13","start":19089013,"end":19089013,"break":"line","breaks":[[15,"line"]],"ruby":[[4,2,"たいのう"],[7,1,"うで"],[19,1,"て"],[21,1,"つよ"],[28,1,"みぎ"],[30,1,"て"],[32,1,"たか"]],"text":"あなたは大能の腕をもたれます。あなたの手は強く、あなたの右の手は高く、"},{"ref":"Ps.89.14","start":19089014,"end":19089014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ぎ"],[2,2,"こうへい"],[13,1,"もとい"],[30,1,"まえ"],[32,1,"い"]],"text":"義と公平はあなたのみくらの基、いつくしみと、まことはあなたの前に行きます。"},{"ref":"Ps.89.15","start":19089015,"end":19089015,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"まつり"],[2,1,"ひ"],[4,1,"よろこ"],[7,1,"こえ"],[9,1,"し"],[11,1,"たみ"],[20,1,"しゅ"],[23,1,"かれ"],[27,1,"かお"],[29,1,"ひかり"],[34,1,"あゆ"]],"text":"祭の日の喜びの声を知る民はさいわいです。主よ、彼らはみ顔の光のなかを歩み、"},{"ref":"Ps.89.16","start":19089016,"end":19089016,"break":"line","breaks":[[14,"line"]],"ruby":[[6,1,"な"],[11,1,"よろこ"],[18,1,"ぎ"]],"text":"ひねもす、み名によって喜び、あなたの義をほめたたえます。"},{"ref":"Ps.89.17","start":19089017,"end":19089017,"break":"line","breaks":[[17,"line"],[33,"line"]],"ruby":[[4,1,"かれ"],[7,1,"ちから"],[9,2,"えいこう"],[21,1,"つの"],[27,1,"めぐ"],[33,1,"たか"]],"text":"あなたは彼らの力の栄光だからです。われらの角はあなたの恵みによって高くあげられるでしょう。"},{"ref":"Ps.89.18","start":19089018,"end":19089018,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"たて"],[6,1,"しゅ"],[8,1,"ぞく"],[15,1,"おう"],[23,2,"せいじゃ"],[26,1,"ぞく"]],"text":"われらの盾は主に属し、われらの王はイスラエルの聖者に属します。"},{"ref":"Ps.89.19","start":19089019,"end":19089019,"break":"line","breaks":[[20,"line"],[27,"line"],[41,"line"]],"ruby":[[0,1,"むかし"],[5,1,"まぼろし"],[14,2,"せいと"],[17,1,"つ"],[20,1,"い"],[32,2,"ゆうし"],[35,2,"えいかん"],[38,1,"さづ"],[41,1,"たみ"],[43,1,"なか"],[46,1,"えら"],[50,1,"もの"],[52,1,"たか"]],"text":"昔あなたは幻をもってあなたの聖徒に告げて言われました、「わたしは勇士に栄冠を授け、民の中から選ばれた者を高くあげた。"},{"ref":"Ps.89.20","start":19089020,"end":19089020,"break":"line","breaks":[[16,"line"]],"ruby":[[13,1,"え"],[21,1,"せい"],[24,1,"あぶら"]],"text":"わたしはわがしもべダビデを得て、これにわが聖なる油をそそいだ。"},{"ref":"Ps.89.21","start":19089021,"end":19089021,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"て"],[4,1,"つね"],[6,1,"かれ"],[8,1,"とも"],[15,1,"うで"],[19,1,"かれ"],[21,1,"つよ"]],"text":"わが手は常に彼と共にあり、わが腕はまた彼を強くする。"},{"ref":"Ps.89.22","start":19089022,"end":19089022,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"てき"],[2,1,"かれ"],[12,1,"あ"],[15,1,"もの"],[17,1,"かれ"],[19,1,"いや"]],"text":"敵は彼をだますことなく、悪しき者は彼を卑しめることはない。"},{"ref":"Ps.89.23","start":19089023,"end":19089023,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"かれ"],[6,1,"まえ"],[16,1,"う"],[18,1,"ほろ"],[22,1,"かれ"],[24,1,"にく"],[26,1,"もの"],[30,1,"う"],[32,1,"たお"]],"text":"わたしは彼の前にもろもろのあだを打ち滅ぼし、彼を憎む者どもを打ち倒す。"},{"ref":"Ps.89.24","start":19089024,"end":19089024,"break":"line","breaks":[[22,"line"]],"ruby":[[15,1,"かれ"],[17,1,"とも"],[24,1,"な"],[29,1,"かれ"],[31,1,"つの"],[33,1,"たか"]],"text":"わがまことと、わがいつくしみは彼と共にあり、わが名によって彼の角は高くあげられる。"},{"ref":"Ps.89.25","start":19089025,"end":19089025,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"かれ"],[6,1,"て"],[8,1,"うみ"],[10,1,"うえ"],[15,1,"かれ"],[17,1,"みぎ"],[19,1,"て"],[21,1,"かわ"],[23,1,"うえ"]],"text":"わたしは彼の手を海の上におき、彼の右の手を川の上におく。"},{"ref":"Ps.89.26","start":19089026,"end":19089026,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[16,1,"ちち"],[20,1,"かみ"],[24,1,"すくい"],[26,1,"いわ"],[29,1,"よ"]],"text":"彼はわたしにむかい『あなたはわが父、わが神、わが救の岩』と呼ぶであろう。"},{"ref":"Ps.89.27","start":19089027,"end":19089027,"break":"line","breaks":[[16,"line"]],"ruby":[[6,1,"かれ"],[16,1,"ち"],[18,1,"おう"],[25,1,"もっと"],[27,1,"たか"],[29,1,"もの"]],"text":"わたしはまた彼をわがういごとし、地の王たちのうちの最も高い者とする。"},{"ref":"Ps.89.28","start":19089028,"end":19089028,"break":"line","breaks":[[10,"line"],[26,"line"]],"ruby":[[18,1,"かれ"],[23,1,"たも"],[28,2,"けいやく"],[31,1,"かれ"],[36,1,"かた"],[38,1,"た"]],"text":"わたしはとこしえに、わがいつくしみを彼のために保ち、わが契約は彼のために堅く立つ。"},{"ref":"Ps.89.29","start":19089029,"end":19089029,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かれ"],[6,2,"かけい"],[14,1,"かた"],[16,1,"さだ"],[21,1,"くらい"],[23,1,"てん"],[25,1,"ひ"],[26,1,"かず"]],"text":"わたしは彼の家系をとこしえに堅く定め、その位を天の日数のようにながらえさせる。"},{"ref":"Ps.89.30","start":19089030,"end":19089030,"break":"line","breaks":[[16,"line"]],"ruby":[[4,2,"しそん"],[13,1,"す"],[22,1,"したが"],[25,1,"あゆ"]],"text":"もしその子孫がわがおきてを捨て、わがさばきに従って歩まないならば、"},{"ref":"Ps.89.31","start":19089031,"end":19089031,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"かれ"],[7,1,"さだ"],[10,1,"おか"],[15,1,"いまし"],[18,1,"まも"]],"text":"もし彼らがわが定めを犯し、わが戒めを守らないならば、"},{"ref":"Ps.89.32","start":19089032,"end":19089032,"break":"line","breaks":[[19,"line"]],"ruby":[[10,1,"かれ"],[16,1,"ばっ"],[25,1,"かれ"],[28,2,"ふぎ"],[31,1,"ばっ"]],"text":"わたしはつえをもって彼らのとがを罰し、むちをもって彼らの不義を罰する。"},{"ref":"Ps.89.33","start":19089033,"end":19089033,"break":"line","breaks":[[16,"line"],[28,"line"]],"ruby":[[16,1,"かれ"],[19,1,"と"],[21,1,"さ"]],"text":"しかし、わたしはわがいつくしみを彼から取り去ることなく、わがまことにそむくことはない。"},{"ref":"Ps.89.34","start":19089034,"end":19089034,"break":"line","breaks":[[16,"line"]],"ruby":[[6,2,"けいやく"],[9,1,"やぶ"],[24,1,"で"],[26,2,"ことば"],[29,1,"か"]],"text":"わたしはわが契約を破ることなく、わがくちびるから出た言葉を変えることはない。"},{"ref":"Ps.89.35","start":19089035,"end":19089035,"break":"line","breaks":[[19,"line"]],"ruby":[[10,1,"せい"],[15,1,"ちか"],[27,1,"いつわ"],[30,1,"い"]],"text":"わたしはひとたびわが聖によって誓った。わたしはダビデに偽りを言わない。"},{"ref":"Ps.89.36","start":19089036,"end":19089036,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[2,2,"かけい"],[10,1,"つづ"],[13,1,"かれ"],[15,1,"くらい"],[17,2,"たいよう"],[23,1,"つね"],[29,1,"まえ"]],"text":"彼の家系はとこしえに続き、彼の位は太陽のように常にわたしの前にある。"},{"ref":"Ps.89.37","start":19089037,"end":19089037,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"つき"],[12,1,"かた"],[14,1,"さだ"],[19,2,"おおぞら"],[22,1,"つづ"],[27,1,"かた"],[29,1,"た"]],"text":"また月のようにとこしえに堅く定められ、大空の続くかぎり堅く立つ」。〔セラ"},{"ref":"Ps.89.38","start":19089038,"end":19089038,"break":"line","breaks":[[20,"line"],[28,"line"]],"ruby":[[12,1,"あぶら"],[18,1,"もの"],[20,1,"す"],[28,1,"かれ"],[30,1,"たい"],[33,1,"はげ"],[36,1,"いか"]],"text":"しかしあなたは、あなたの油そそがれた者を捨ててしりぞけ、彼に対して激しく怒られました。"},{"ref":"Ps.89.39","start":19089039,"end":19089039,"break":"line","breaks":[[18,"line"]],"ruby":[[11,2,"けいやく"],[14,2,"はいき"],[18,1,"かれ"],[20,1,"かんむり"],[22,1,"ち"]],"text":"あなたはそのしもべとの契約を廃棄し、彼の冠を地になげうって、けがされました。"},{"ref":"Ps.89.40","start":19089040,"end":19089040,"break":"line","breaks":[[18,"line"]],"ruby":[[6,2,"じょうへき"],[24,1,"あ"]],"text":"あなたはその城壁をことごとくこわし、そのとりでを荒れすたれさせられました。"},{"ref":"Ps.89.41","start":19089041,"end":19089041,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"とお"],[5,1,"す"],[8,1,"もの"],[10,1,"みな"],[11,1,"かれ"],[17,1,"かれ"],[21,1,"とな"],[23,1,"びと"]],"text":"そこを通り過ぎる者は皆彼をかすめ、彼はその隣り人のあざけりとなりました。"},{"ref":"Ps.89.42","start":19089042,"end":19089042,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"かれ"],[9,1,"みぎ"],[11,1,"て"],[13,1,"たか"],[25,1,"てき"],[27,1,"よろこ"]],"text":"あなたは彼のあだの右の手を高くあげ、そのもろもろの敵を喜ばせられました。"},{"ref":"Ps.89.43","start":19089043,"end":19089043,"break":"line","breaks":[[22,"line"]],"ruby":[[9,1,"かれ"],[15,1,"は"],[22,1,"かれ"],[24,1,"たたか"],[27,1,"た"]],"text":"まことに、あなたは彼のつるぎの刃をかえして、彼を戦いに立たせられなかったのです。"},{"ref":"Ps.89.44","start":19089044,"end":19089044,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かれ"],[6,1,"て"],[9,1,"おう"],[14,1,"と"],[16,1,"さ"],[21,2,"おうざ"],[24,1,"ち"],[26,1,"な"]],"text":"あなたは彼の手から王のつえを取り去り、その王座を地に投げすてられました。"},{"ref":"Ps.89.45","start":19089045,"end":19089045,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"かれ"],[6,1,"わか"],[8,1,"ひ"],[14,1,"はじ"],[19,1,"かれ"]],"text":"あなたは彼の若き日をちぢめ、恥をもって彼をおおわれました。〔セラ"},{"ref":"Ps.89.46","start":19089046,"end":19089046,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[19,1,"おかく"],[33,1,"いか"],[40,1,"ひ"],[45,1,"も"]],"text":"主よ、いつまでなのですか。とこしえにお隠れになるのですか。あなたの怒りはいつまで火のように燃えるのですか。"},{"ref":"Ps.89.47","start":19089047,"end":19089047,"break":"line","breaks":[[16,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"ひと"],[13,1,"みじか"],[20,1,"ひと"],[22,1,"こ"],[32,1,"つく"]],"text":"主よ、人のいのちの、いかに短く、すべての人の子を、いかにはかなく造られたかを、みこころにとめてください。"},{"ref":"Ps.89.48","start":19089048,"end":19089048,"break":"line","breaks":[[11,"line"],[21,"line"]],"ruby":[[3,1,"い"],[6,1,"し"],[8,1,"み"],[13,1,"たましい"],[15,2,"よみ"],[18,1,"ちから"],[21,1,"すく"]],"text":"だれか生きて死を見ず、その魂を陰府の力から救いうるものがあるでしょうか。〔セラ"},{"ref":"Ps.89.49","start":19089049,"end":19089049,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[18,1,"ちか"],[22,1,"むかし"]],"text":"主よ、あなたがまことをもってダビデに誓われた昔のいつくしみはどこにありますか。"},{"ref":"Ps.89.50","start":19089050,"end":19089051,"break":"line","breaks":[[20,"line"],[33,"line"],[55,"line"],[76,"line"],[91,"line"]],"ruby":[[0,1,"しゅ"],[33,1,"しゅ"],[45,1,"てき"],[59,1,"あぶら"],[65,1,"もの"],[67,2,"あしあと"],[85,1,"たみ"]],"text":"主よ、あなたのしもべがうけるはずかしめをみこころにとめてください。主よ、あなたのもろもろの敵はわたしをそしり、あなたの油そそがれた者の足跡をそしります。わたしはもろもろの民のそしりをわたしのふところにいだいているのです。"},{"ref":"Ps.89.52","start":19089052,"end":19089052,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"]],"text":"主はとこしえにほむべきかな。アァメン、アァメン。"}]