[{"ref":"Job.21.1","start":18021001,"end":18021001,"break":"paragraph","ruby":[[6,1,"こた"],[9,1,"い"]],"text":"そこでヨブは答えて言った、"},{"ref":"Job.21.2","start":18021002,"end":18021002,"break":"stanza","breaks":[[21,"line"]],"ruby":[[15,2,"ことば"],[18,1,"き"],[34,1,"なぐさ"]],"text":"「あなたがたはとくと、わたしの言葉を聞き、これをもって、あなたがたの慰めとするがよい。"},{"ref":"Job.21.3","start":18021003,"end":18021003,"break":"line","breaks":[[17,"line"]],"ruby":[[10,1,"かた"],[21,1,"かた"]],"text":"まずわたしをゆるして語らせなさい。わたしが語ったのち、あざけるのもよかろう。"},{"ref":"Job.21.4","start":18021004,"end":18021004,"break":"line","breaks":[[20,"line"]],"ruby":[[9,1,"ひと"],[11,1,"たい"]],"text":"わたしのつぶやきは人に対してであろうか。わたしはどうして、いらだたないでいられようか。"},{"ref":"Job.21.5","start":18021005,"end":18021005,"break":"line","breaks":[[16,"line"]],"ruby":[[10,1,"み"],[13,1,"おどろ"],[16,1,"て"],[18,1,"くち"]],"text":"あなたがたはわたしを見て、驚き、手を口にあてるがよい。"},{"ref":"Job.21.6","start":18021006,"end":18021006,"break":"line","breaks":[[18,"line"]],"ruby":[[7,1,"おも"],[10,1,"おそ"],[26,1,"ふる"]],"text":"わたしはこれを思うと恐ろしくなって、からだがしきりに震えわななく。"},{"ref":"Job.21.7","start":18021007,"end":18021007,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"あ"],[7,1,"ひと"],[9,1,"い"],[16,2,"ろうれい"],[19,1,"たっ"],[24,2,"ちからづよ"]],"text":"なにゆえ悪しき人が生きながらえ、老齢に達し、かつ力強くなるのか。"},{"ref":"Job.21.8","start":18021008,"end":18021008,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"こ"],[5,1,"かれ"],[8,1,"まえ"],[10,1,"かた"],[12,1,"た"],[17,2,"しそん"],[22,1,"め"],[24,1,"まえ"],[26,1,"かた"],[28,1,"た"]],"text":"その子らは彼らの前に堅く立ち、その子孫もその目の前に堅く立つ。"},{"ref":"Job.21.9","start":18021009,"end":18021009,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"いえ"],[4,1,"やす"],[9,1,"おそ"],[15,1,"かみ"],[20,1,"かれ"],[23,1,"うえ"],[25,1,"のぞ"]],"text":"その家は安らかで、恐れがなく、神のつえは彼らの上に臨むことがない。"},{"ref":"Job.21.10","start":18021010,"end":18021010,"break":"line","breaks":[[18,"line"]],"ruby":[[2,2,"おうし"],[5,1,"たね"],[7,1,"あた"],[11,1,"あやま"],[20,2,"めうし"],[23,1,"こ"],[25,1,"う"]],"text":"その雄牛は種を与えて、誤ることなく、その雌牛は子を産んで、そこなうことがない。"},{"ref":"Job.21.11","start":18021011,"end":18021011,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かれ"],[5,1,"ちい"],[8,1,"もの"],[12,1,"む"],[18,1,"つ"],[20,1,"だ"],[25,1,"こ"],[28,1,"ま"],[30,1,"おど"]],"text":"彼らはその小さい者どもを群れのように連れ出し、その子らは舞い踊る。"},{"ref":"Job.21.12","start":18021012,"end":18021012,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"て"],[4,1,"つづみ"],[6,1,"こと"],[8,1,"あ"],[12,1,"うた"],[15,1,"ふえ"],[17,1,"ね"],[22,1,"たの"]],"text":"彼らは手鼓と琴に合わせて歌い、笛の音によって楽しみ、"},{"ref":"Job.21.13","start":18021013,"end":18021013,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"ひ"],[9,1,"す"],[13,1,"やす"],[17,2,"よみ"]],"text":"その日をさいわいに過ごし、安らかに陰府にくだる。"},{"ref":"Job.21.14","start":18021014,"end":18021014,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,1,"い"],[14,1,"はな"],[27,1,"みち"],[29,1,"し"],[34,1,"この"]],"text":"彼らは神に言う、『われわれを離れよ、われわれはあなたの道を知ることを好まない。"},{"ref":"Job.21.15","start":18021015,"end":18021015,"break":"line","breaks":[[10,"line"],[29,"line"]],"ruby":[[0,3,"ぜんのうしゃ"],[4,2,"なにもの"],[18,1,"つか"],[37,1,"いの"],[45,1,"えき"]],"text":"全能者は何者なので、われわれはこれに仕えねばならないのか。われわれはこれに祈っても、なんの益があるか』と。"},{"ref":"Job.21.16","start":18021016,"end":18021016,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[6,2,"はんえい"],[9,1,"かれ"],[12,1,"て"],[22,2,"あくにん"],[25,1,"はか"],[35,1,"とお"],[37,1,"およ"],[39,1,"ところ"]],"text":"見よ、彼らの繁栄は彼らの手にあるではないか。悪人の計りごとは、わたしの遠く及ぶ所でない。"},{"ref":"Job.21.17","start":18021017,"end":18021017,"break":"line","breaks":[[15,"line"],[22,"line"],[36,"line"],[58,"line"]],"ruby":[[0,2,"あくにん"],[8,1,"け"],[15,1,"いく"],[24,1,"わざわい"],[26,1,"かれ"],[29,1,"うえ"],[31,1,"のぞ"],[36,1,"かみ"],[40,1,"いか"],[46,1,"くる"],[50,1,"あた"],[58,1,"いく"]],"text":"悪人のともしびの消されること、幾たびあるか。その災の彼らの上に臨むこと、神がその怒りをもって苦しみを与えられること、幾たびあるか。"},{"ref":"Job.21.18","start":18021018,"end":18021018,"break":"line","breaks":[[18,"line"],[41,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かぜ"],[5,1,"まえ"],[22,1,"ふ"],[24,1,"さ"],[41,1,"いく"]],"text":"彼らが風の前のわらのようになること、あらしに吹き去られるもみがらのようになること、幾たびあるか。"},{"ref":"Job.21.19","start":18021019,"end":18021019,"break":"line","breaks":[[9,"line"],[25,"line"],[40,"line"],[55,"line"]],"ruby":[[6,1,"い"],[10,1,"かみ"],[12,1,"かれ"],[15,1,"つみ"],[17,1,"つ"],[27,1,"こ"],[30,1,"むく"],[46,1,"かれ"],[48,2,"じしん"],[51,1,"むく"],[55,1,"かれ"],[60,1,"つみ"],[62,1,"し"]],"text":"あなたがたは言う、『神は彼らの罪を積みたくわえて、その子らに報いられるのだ』と。どうかそれを彼ら自身に報いて、彼らにその罪を知らせられるように。"},{"ref":"Job.21.20","start":18021020,"end":18021020,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"かれ"],[6,2,"じしん"],[9,1,"め"],[13,1,"ほろ"],[16,1,"み"],[20,3,"ぜんのうしゃ"],[24,1,"いか"],[27,1,"かれ"],[30,1,"の"]],"text":"すなわち彼ら自身の目にその滅びを見させ、全能者の怒りを彼らに飲ませられるように。"},{"ref":"Job.21.21","start":18021021,"end":18021021,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"つき"],[4,1,"かず"],[12,1,"かれ"],[17,1,"のち"],[19,1,"いえ"],[28,1,"ところ"]],"text":"その月の数のつきるとき、彼らはその後の家になんのかかわる所があろうか。"},{"ref":"Job.21.22","start":18021022,"end":18021022,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かみ"],[2,1,"てん"],[6,1,"もの"],[24,1,"かみ"],[26,2,"ちしき"],[29,1,"おし"]],"text":"神は天にある者たちをさえ、さばかれるのに、だれが神に知識を教えることができようか。"},{"ref":"Job.21.23","start":18021023,"end":18021023,"break":"line","breaks":[[11,"line"]],"ruby":[[2,1,"もの"],[4,2,"はんえい"],[11,1,"まった"],[13,1,"やす"],[25,1,"し"]],"text":"ある者は繁栄をきわめ、全く安らかに、かつおだやかに死に、"},{"ref":"Job.21.24","start":18021024,"end":18021024,"break":"line","breaks":[[13,"line"]],"ruby":[[7,2,"しぼう"],[10,1,"み"],[15,1,"ほね"],[17,1,"ずい"],[19,1,"うるお"]],"text":"そのからだには脂肪が満ち、その骨の髄は潤っている。"},{"ref":"Job.21.25","start":18021025,"end":18021025,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"もの"],[4,1,"こころ"],[6,1,"くる"],[10,1,"し"],[16,1,"さいわい"],[19,1,"あじ"]],"text":"ある者は心を苦しめて死に、なんの幸をも味わうことがない。"},{"ref":"Job.21.26","start":18021026,"end":18021026,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[10,1,"ふ"]],"text":"彼らはひとしくちりに伏し、うじにおおわれる。"},{"ref":"Job.21.27","start":18021027,"end":18021027,"break":"stanza","breaks":[[19,"line"]],"ruby":[[0,1,"み"],[13,1,"おも"],[16,1,"し"],[23,1,"がい"],[35,1,"し"]],"text":"見よ、わたしはあなたがたの思いを知り、わたしを害しようとするたくらみを知る。"},{"ref":"Job.21.28","start":18021028,"end":18021028,"break":"line","breaks":[[22,"line"]],"ruby":[[6,1,"い"],[10,2,"おうこう"],[13,1,"いえ"],[22,2,"あくにん"],[25,1,"す"],[27,2,"てんまく"]],"text":"あなたがたは言う、『王侯の家はどこにあるか、悪人の住む天幕はどこにあるか』と。"},{"ref":"Job.21.29","start":18021029,"end":18021029,"break":"line","breaks":[[20,"line"]],"ruby":[[6,2,"みちゆ"],[9,2,"ひとびと"],[12,1,"と"],[20,1,"かれ"],[23,2,"しょうげん"],[26,1,"う"],[28,1,"い"]],"text":"あなたがたは道行く人々に問わなかったか、彼らの証言を受け入れないのか。"},{"ref":"Job.21.30","start":18021030,"end":18021030,"break":"line","breaks":[[15,"line"]],"ruby":[[5,1,"わざわい"],[7,1,"ひ"],[9,2,"あくにん"],[12,1,"まぬか"],[15,1,"はげ"],[18,1,"いか"],[21,1,"ひ"],[23,1,"かれ"],[25,1,"すく"],[27,1,"だ"]],"text":"すなわち、災の日に悪人は免れ、激しい怒りの日に彼は救い出される。"},{"ref":"Job.21.31","start":18021031,"end":18021031,"break":"line","breaks":[[10,"line"],[26,"line"]],"ruby":[[3,1,"かれ"],[5,1,"む"],[12,1,"みち"],[14,1,"つ"],[16,1,"し"],[20,1,"もの"],[29,1,"かれ"],[33,1,"こと"],[35,1,"かれ"],[37,1,"むく"],[40,1,"もの"]],"text":"だれが彼に向かって、その道を告げ知らせる者があるか、だれが彼のした事を彼に報いる者があるか。"},{"ref":"Job.21.32","start":18021032,"end":18021032,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[6,1,"はか"],[8,1,"い"],[11,1,"つか"],[13,1,"うえ"],[15,2,"みは"]],"text":"彼はかかれて墓に行き、塚の上で見張りされ、"},{"ref":"Job.21.33","start":18021033,"end":18021033,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"たに"],[2,1,"つち"],[6,1,"かれ"],[9,1,"こころよ"],[16,1,"ひと"],[23,1,"したが"],[26,1,"かれ"],[28,1,"まえ"],[30,1,"い"],[33,1,"もの"],[35,1,"かぞ"]],"text":"谷の土くれも彼には快く、すべての人はそのあとに従う。彼の前に行った者も数えきれない。"},{"ref":"Job.21.34","start":18021034,"end":18021034,"break":"line","breaks":[[24,"line"],[38,"line"]],"ruby":[[18,1,"こと"],[28,1,"なぐさ"],[44,1,"こたえ"],[46,1,"いつわ"],[48,2,"いがい"],[51,1,"なに"]],"text":"それで、あなたがたはどうしてむなしい事をもって、わたしを慰めようとするのか。あなたがたの答は偽り以外の何ものでもない」。"}]