[{"ref":"Prov.31.1","start":20031001,"end":20031001,"break":"paragraph","ruby":[[4,1,"おう"],[10,2,"ことば"],[19,1,"はは"],[21,1,"かれ"],[23,1,"おし"]],"text":"マッサの王レムエルの言葉、すなわちその母が彼に教えたものである。"},{"ref":"Prov.31.2","start":20031002,"end":20031002,"break":"line","breaks":[[12,"line"],[26,"line"],[40,"line"]],"ruby":[[2,1,"こ"],[5,1,"なに"],[7,1,"い"],[14,1,"たい"],[16,1,"こ"],[19,1,"なに"],[21,1,"い"],[30,1,"がん"],[35,1,"え"],[37,1,"こ"],[40,1,"なに"]],"text":"わが子よ、何を言おうか。わが胎の子よ、何を言おうか。わたしが願をかけて得た子よ、何をいおうか。"},{"ref":"Prov.31.3","start":20031003,"end":20031003,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"ちから"],[6,1,"おんな"],[14,1,"おう"],[17,1,"ほろ"],[28,1,"みち"],[30,1,"まか"]],"text":"あなたの力を女についやすな、王をも滅ぼすものに、あなたの道を任せるな。"},{"ref":"Prov.31.4","start":20031004,"end":20031004,"break":"line","breaks":[[24,"line"],[35,"line"]],"ruby":[[6,1,"さけ"],[8,1,"の"],[13,1,"おう"],[24,1,"おう"],[35,1,"こ"],[37,1,"さけ"],[39,1,"もと"],[44,1,"きみ"],[47,1,"もの"]],"text":"レムエルよ、酒を飲むのは、王のすることではない、王のすることではない、濃い酒を求めるのは君たる者のすることではない。"},{"ref":"Prov.31.5","start":20031005,"end":20031005,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[3,1,"さけ"],[5,1,"の"],[13,1,"わす"],[19,1,"なや"],[21,1,"もの"],[27,1,"ま"]],"text":"彼らは酒を飲んで、おきてを忘れ、すべて悩む者のさばきを曲げる。"},{"ref":"Prov.31.6","start":20031006,"end":20031006,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"こ"],[2,1,"さけ"],[4,1,"ほろ"],[13,1,"もの"],[15,1,"あた"],[18,1,"さけ"],[20,1,"こころ"],[22,1,"くる"],[25,1,"ひと"],[27,1,"あた"]],"text":"濃い酒を滅びようとしている者に与え、酒を心の苦しむ人に与えよ。"},{"ref":"Prov.31.7","start":20031007,"end":20031007,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"の"],[6,2,"じぶん"],[9,2,"びんぼう"],[12,1,"わす"],[17,1,"なや"],[23,1,"おも"],[25,1,"だ"]],"text":"彼らは飲んで自分の貧乏を忘れ、その悩みをもはや思い出さない。"},{"ref":"Prov.31.8","start":20031008,"end":20031008,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"だま"],[9,1,"ひと"],[24,1,"うった"],[31,1,"くち"],[33,1,"ひら"]],"text":"あなたは黙っている人のために、すべてのみなしごの訴えのために、口を開くがよい。"},{"ref":"Prov.31.9","start":20031009,"end":20031009,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"くち"],[2,1,"ひら"],[6,1,"ただ"],[13,1,"おこな"],[16,1,"まず"],[19,1,"もの"],[21,1,"とぼ"],[24,1,"もの"],[26,1,"うった"]],"text":"口を開いて、正しいさばきを行い、貧しい者と乏しい者の訴えをただせ。"},{"ref":"Prov.31.10","start":20031010,"end":20031010,"break":"stanza","breaks":[[19,"line"]],"ruby":[[3,1,"かしこ"],[5,1,"つま"],[7,1,"み"],[19,2,"かのじょ"],[22,2,"ほうせき"],[31,1,"たっと"]],"text":"だれが賢い妻を見つけることができるか、彼女は宝石よりもすぐれて尊い。"},{"ref":"Prov.31.11","start":20031011,"end":20031011,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"おっと"],[4,1,"こころ"],[6,2,"かのじょ"],[9,2,"しんらい"],[14,2,"しゅうえき"],[17,1,"か"]],"text":"その夫の心は彼女を信頼して、収益に欠けることはない。"},{"ref":"Prov.31.12","start":20031012,"end":20031012,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"い"],[12,1,"あいだ"],[16,1,"おっと"],[21,1,"よ"],[29,1,"わる"]],"text":"彼女は生きながらえている間、その夫のために良いことをして、悪いことをしない。"},{"ref":"Prov.31.13","start":20031013,"end":20031013,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"ひつじ"],[5,1,"け"],[7,2,"あま"],[10,1,"もと"],[14,1,"て"],[18,1,"のぞ"],[28,2,"しあ"]],"text":"彼女は羊の毛や亜麻を求めて、手ずから望みのように、それを仕上げる。"},{"ref":"Prov.31.14","start":20031014,"end":20031014,"break":"line","breaks":[[11,"line"]],"ruby":[[2,2,"しょうにん"],[5,1,"ふね"],[11,1,"とお"],[13,1,"くに"],[16,2,"しょくりょう"],[19,1,"はこ"]],"text":"また商人の舟のように、遠い国から食糧を運んでくる。"},{"ref":"Prov.31.15","start":20031015,"end":20031015,"break":"line","breaks":[[17,"line"],[30,"line"]],"ruby":[[0,2,"かのじょ"],[5,1,"よる"],[13,1,"お"],[19,1,"いえ"],[21,1,"もの"],[23,1,"た"],[25,1,"もの"],[27,1,"そな"],[32,1,"おんな"],[36,2,"にちよう"],[39,1,"ぶん"],[41,1,"あた"]],"text":"彼女はまだ夜のあけぬうちに起きて、その家の者の食べ物を備え、その女たちに日用の分を与える。"},{"ref":"Prov.31.16","start":20031016,"end":20031016,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"はたけ"],[7,1,"かんが"],[13,1,"か"],[18,1,"て"],[20,1,"はたら"],[23,1,"み"],[32,1,"ばたけ"]],"text":"彼女は畑をよく考えてそれを買い、その手の働きの実をもって、ぶどう畑をつくり、"},{"ref":"Prov.31.17","start":20031017,"end":20031017,"break":"line","ruby":[[0,1,"ちから"],[5,1,"こし"],[7,1,"おび"],[12,1,"うで"],[14,1,"つよ"]],"text":"力をもって腰に帯し、その腕を強くする。"},{"ref":"Prov.31.18","start":20031018,"end":20031018,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"かのじょ"],[5,2,"しょうひん"],[16,1,"し"],[29,2,"しゅうや"],[31,1,"き"]],"text":"彼女はその商品のもうけのあるのを知っている、そのともしびは終夜消えることがない。"},{"ref":"Prov.31.19","start":20031019,"end":20031019,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"て"],[5,2,"いとと"],[8,1,"ぼう"],[15,1,"て"],[21,1,"も"]],"text":"彼女は手を糸取り棒にのべ、その手に、つむを持ち、"},{"ref":"Prov.31.20","start":20031020,"end":20031020,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"て"],[2,1,"まず"],[5,1,"もの"],[7,1,"ひら"],[10,1,"とぼ"],[13,1,"ひと"],[15,1,"て"]],"text":"手を貧しい者に開き、乏しい人に手をさしのべる。"},{"ref":"Prov.31.21","start":20031021,"end":20031021,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"かのじょ"],[5,1,"いえ"],[7,1,"もの"],[12,1,"ゆき"],[14,1,"おそ"],[21,1,"いえ"],[23,1,"もの"],[27,1,"くれない"],[29,2,"きもの"],[32,1,"き"]],"text":"彼女はその家の者のために雪を恐れない、その家の者はみな紅の着物を着ているからである。"},{"ref":"Prov.31.22","start":20031022,"end":20031022,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"かのじょ"],[3,2,"じぶん"],[9,1,"うつく"],[16,1,"つく"],[19,2,"あま"],[21,1,"ぬの"],[23,1,"むらさき"],[24,1,"ぬの"],[32,2,"きもの"]],"text":"彼女は自分のために美しいしとねを作り、亜麻布と紫布とをもってその着物とする。"},{"ref":"Prov.31.23","start":20031023,"end":20031023,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"おっと"],[6,1,"ち"],[8,2,"ちょうろう"],[13,1,"とも"],[16,1,"まち"],[18,1,"もん"],[20,1,"ざ"],[26,1,"ひと"],[28,1,"し"]],"text":"その夫はその地の長老たちと共に、町の門に座するので、人に知られている。"},{"ref":"Prov.31.24","start":20031024,"end":20031024,"break":"line","breaks":[[21,"line"]],"ruby":[[0,2,"かのじょ"],[3,2,"あま"],[5,1,"ぬの"],[7,2,"きもの"],[18,1,"う"],[21,1,"おび"],[27,2,"しょうにん"],[30,1,"わた"]],"text":"彼女は亜麻布の着物をつくって、それを売り、帯をつくって商人に渡す。"},{"ref":"Prov.31.25","start":20031025,"end":20031025,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ちから"],[2,2,"きひん"],[6,2,"かのじょ"],[9,2,"きもの"],[18,1,"のち"],[20,1,"ひ"],[22,1,"わら"]],"text":"力と気品とは彼女の着物である、そして後の日を笑っている。"},{"ref":"Prov.31.26","start":20031026,"end":20031026,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"くち"],[5,1,"ひら"],[8,2,"ちえ"],[11,1,"かた"],[16,1,"した"],[25,1,"おしえ"]],"text":"彼女は口を開いて知恵を語る、その舌にはいつくしみの教がある。"},{"ref":"Prov.31.27","start":20031027,"end":20031027,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"いえ"],[5,1,"こと"],[14,1,"おこた"],[20,1,"た"]],"text":"彼女は家の事をよくかえりみ、怠りのかてを食べることをしない。"},{"ref":"Prov.31.28","start":20031028,"end":20031028,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"こ"],[5,1,"た"],[7,1,"あ"],[11,2,"かのじょ"],[14,1,"しゅく"],[19,1,"おっと"],[23,2,"かのじょ"],[32,1,"い"]],"text":"その子らは立ち上がって彼女を祝し、その夫もまた彼女をほめたたえて言う、"},{"ref":"Prov.31.29","start":20031029,"end":20031029,"break":"line","breaks":[[21,"line"]],"ruby":[[5,1,"こと"],[9,1,"と"],[12,1,"おんな"],[14,1,"おお"]],"text":"「りっぱに事をなし遂げる女は多いけれども、あなたはそのすべてにまさっている」と。"},{"ref":"Prov.31.30","start":20031030,"end":20031030,"break":"line","breaks":[[24,"line"]],"ruby":[[6,1,"いつわ"],[12,1,"うつく"],[27,1,"しゅ"],[29,1,"おそ"],[32,1,"おんな"]],"text":"あでやかさは偽りであり、美しさはつかのまである、しかし主を恐れる女はほめたたえられる。"},{"ref":"Prov.31.31","start":20031031,"end":20031031,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"て"],[4,1,"はたら"],[7,1,"み"],[9,2,"かのじょ"],[12,1,"あた"],[17,1,"おこな"],[23,2,"かのじょ"],[26,1,"まち"],[28,1,"もん"]],"text":"その手の働きの実を彼女に与え、その行いのために彼女を町の門でほめたたえよ。"}]