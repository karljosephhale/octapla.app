[{"ref":"Zech.11.1","start":38011001,"end":38011001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[10,1,"もん"],[12,1,"ひら"],[19,2,"こうはく"],[22,1,"ひ"],[24,1,"や"],[26,1,"ほろ"]],"text":"レバノンよ、おまえの門を開き、おまえの香柏を火に焼き滅ぼさせよ。"},{"ref":"Zech.11.2","start":38011002,"end":38011002,"break":"line","breaks":[[11,"line"],[17,"line"],[36,"line"],[50,"line"]],"ruby":[[6,1,"な"],[8,1,"さけ"],[11,2,"こうはく"],[14,1,"たお"],[21,1,"き"],[45,1,"な"],[47,1,"さけ"],[50,1,"しげ"],[53,1,"はやし"],[55,1,"たお"]],"text":"いとすぎよ、泣き叫べ。香柏は倒れ、みごとな木は、そこなわれたからである。バシャンのかしよ、泣き叫べ。茂った林は倒れたからである。"},{"ref":"Zech.11.3","start":38011003,"end":38011003,"break":"line","breaks":[[13,"line"],[30,"line"],[42,"line"]],"ruby":[[0,1,"き"],[3,2,"ぼくしゃ"],[6,1,"な"],[8,1,"さけ"],[10,1,"こえ"],[13,1,"かれ"],[16,1,"さか"],[19,1,"き"],[21,1,"さ"],[30,1,"き"],[39,1,"こえ"],[47,1,"くさ"],[51,1,"あ"],[53,1,"は"]],"text":"聞け、牧者の泣き叫ぶ声を。彼らの栄えが消え去ったからである。聞け、ししのほえる声を。ヨルダンの草むらが荒れ果てたからである。"},{"ref":"Zech.11.4","start":38011004,"end":38011004,"break":"paragraph","ruby":[[2,1,"かみ"],[4,1,"しゅ"],[8,1,"おお"],[21,1,"ひつじ"],[23,1,"む"],[26,2,"ぼくしゃ"]],"text":"わが神、主はこう仰せられた、「ほふらるべき羊の群れの牧者となれ。"},{"ref":"Zech.11.5","start":38011005,"end":38011005,"break":"none","ruby":[[3,1,"か"],[5,1,"もの"],[16,1,"ばっ"],[26,1,"う"],[28,1,"もの"],[30,1,"い"],[34,1,"しゅ"],[47,1,"と"],[58,2,"ぼくしゃ"]],"text":"これを買う者は、これをほふっても罰せられない。これを売る者は言う、『主はほむべきかな、わたしは富んだ』と。そしてその牧者は、これをあわれまない。"},{"ref":"Zech.11.6","start":38011006,"end":38011006,"break":"none","ruby":[[10,1,"ち"],[12,2,"じゅうみん"],[23,1,"しゅ"],[25,1,"い"],[30,1,"み"],[37,1,"ひと"],[45,2,"ぼくしゃ"],[48,1,"て"],[50,1,"わた"],[59,1,"おう"],[61,1,"て"],[63,1,"わた"],[66,1,"かれ"],[69,1,"ち"],[71,1,"あら"],[78,1,"かれ"],[81,1,"て"],[87,1,"すく"],[89,1,"だ"]],"text":"わたしは、もはやこの地の住民をあわれまないと、主は言われる。見よ、わたしは人をおのおのその牧者の手に渡し、おのおのその王の手に渡す。彼らは地を荒す。わたしは彼らの手からこれを救い出さない」。"},{"ref":"Zech.11.7","start":38011007,"end":38011007,"break":"paragraph","ruby":[[4,1,"ひつじ"],[6,2,"しょうにん"],[19,1,"ひつじ"],[21,1,"む"],[24,2,"ぼくしゃ"],[36,1,"ほん"],[41,1,"と"],[47,1,"ぽん"],[49,1,"めぐ"],[52,1,"な"],[57,1,"ぽん"],[59,1,"むす"],[62,1,"な"],[69,1,"ひつじ"],[71,1,"ぼく"]],"text":"わたしは羊の商人のために、ほふらるべき羊の群れの牧者となった。わたしは二本のつえを取り、その一本を恵みと名づけ、一本を結びと名づけて、その羊を牧した。"},{"ref":"Zech.11.8","start":38011008,"end":38011008,"break":"none","ruby":[[6,1,"げつ"],[8,2,"ぼくしゃ"],[11,1,"にん"],[13,1,"ほろ"],[22,1,"かれ"],[39,1,"かれ"],[49,1,"い"]],"text":"わたしは一か月に牧者三人を滅ぼした。わたしは彼らに、がまんしきれなくなったが、彼らもまた、わたしを忌みきらった。"},{"ref":"Zech.11.9","start":38011009,"end":38011009,"break":"none","ruby":[[7,1,"い"],[22,2,"ぼくしゃ"],[30,1,"し"],[32,1,"もの"],[34,1,"し"],[37,1,"ほろ"],[40,1,"もの"],[42,1,"ほろ"],[45,1,"のこ"],[48,1,"もの"],[56,1,"にく"],[58,1,"く"]],"text":"それでわたしは言った、「わたしはあなたがたの牧者とならない。死ぬ者は死に、滅びる者は滅び、残った者はたがいにその肉を食いあうがよい」。"},{"ref":"Zech.11.10","start":38011010,"end":38011010,"break":"none","ruby":[[4,1,"めぐ"],[12,1,"と"],[19,1,"お"],[35,1,"たみ"],[37,1,"むす"],[40,2,"けいやく"],[44,1,"はい"]],"text":"わたしは恵みというつえを取って、これを折った。これはわたしがもろもろの民と結んだ契約を、廃するためであった。"},{"ref":"Zech.11.11","start":38011011,"end":38011011,"break":"none","ruby":[[9,1,"ひ"],[11,1,"はい"],[24,1,"め"],[26,1,"そそ"],[31,1,"ひつじ"],[33,2,"しょうにん"],[41,1,"しゅ"],[43,2,"ことば"],[52,1,"し"]],"text":"そしてこれは、その日に廃された。そこで、わたしに目を注いでいた羊の商人らは、これが主の言葉であったことを知った。"},{"ref":"Zech.11.12","start":38011012,"end":38011012,"break":"none","ruby":[[4,1,"かれ"],[7,1,"む"],[25,1,"おも"],[35,2,"ちんぎん"],[38,1,"はら"],[60,1,"い"],[66,1,"かれ"],[73,2,"ちんぎん"],[79,1,"ぎん"],[86,1,"はか"]],"text":"わたしは彼らに向かって、「あなたがたがもし、よいと思うならば、わたしに賃銀を払いなさい。もし、いけなければやめなさい」と言ったので、彼らはわたしの賃銀として、銀三十シケルを量った。"},{"ref":"Zech.11.13","start":38011013,"end":38011013,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"かれ"],[23,1,"ね"],[24,1,"つ"],[30,1,"たっと"],[32,1,"あたい"],[35,1,"みや"],[41,1,"はこ"],[43,1,"な"],[45,1,"い"],[54,1,"ぎん"],[61,1,"と"],[68,1,"しゅ"],[70,1,"みや"],[76,1,"はこ"],[78,1,"な"],[80,1,"い"]],"text":"主はわたしに言われた、「彼らによって、わたしが値積られたその尊い価を、宮のさいせん箱に投げ入れよ」。わたしは銀三十シケルを取って、これを主の宮のさいせん箱に投げ入れた。"},{"ref":"Zech.11.14","start":38011014,"end":38011014,"break":"none","ruby":[[7,1,"むす"],[12,1,"だい"],[18,1,"お"],[34,1,"あいだ"],[37,2,"きょうだい"],[39,2,"かんけい"],[42,1,"はい"]],"text":"そしてわたしは結びという第二のつえを折った。これはユダとイスラエルの間の、兄弟関係を廃するためであった。"},{"ref":"Zech.11.15","start":38011015,"end":38011015,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[18,1,"おろ"],[21,2,"ぼくしゃ"],[24,1,"うつわ"],[26,1,"と"]],"text":"主はわたしに言われた、「おまえはまた愚かな牧者の器を取れ。"},{"ref":"Zech.11.16","start":38011016,"end":38011016,"break":"none","ruby":[[0,1,"み"],[7,1,"ち"],[13,2,"ぼくしゃ"],[16,1,"おこ"],[19,1,"かれ"],[21,1,"ほろ"],[26,1,"もの"],[28,1,"かえり"],[32,1,"まよ"],[35,1,"もの"],[37,1,"たず"],[41,1,"きず"],[45,1,"もの"],[52,1,"すこ"],[56,1,"もの"],[58,1,"やしな"],[62,1,"こ"],[65,1,"もの"],[67,1,"にく"],[69,1,"く"],[81,1,"さ"],[83,1,"もの"]],"text":"見よ、わたしは地にひとりの牧者を起す。彼は滅ぼされる者を顧みず、迷える者を尋ねず、傷ついた者をいやさず、健やかな者を養わず、肥えた者の肉を食らい、そのひずめをさえ裂く者である。"},{"ref":"Zech.11.17","start":38011017,"end":38011017,"break":"stanza","breaks":[[22,"line"],[37,"line"],[49,"line"],[58,"line"]],"ruby":[[2,1,"ひつじ"],[4,1,"む"],[7,1,"す"],[10,1,"おろ"],[13,2,"ぼくしゃ"],[32,1,"うで"],[34,1,"う"],[39,1,"みぎ"],[41,1,"め"],[43,1,"う"],[51,1,"うで"],[53,1,"まった"],[55,1,"おとろ"],[60,1,"みぎ"],[62,1,"め"],[64,1,"まった"],[66,1,"み"]],"text":"その羊の群れを捨てる愚かな牧者はわざわいだ。どうか、つるぎがその腕を撃ち、その右の目を撃つように。その腕は全く衰え、その右の目は全く見えなくなるように」。"}]