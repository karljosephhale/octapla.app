[{"ref":"Jer.5.1","start":24005001,"end":24005001,"break":"paragraph","breaks":[[16,"line"],[25,"line"],[40,"line"],[63,"line"]],"ruby":[[10,1,"い"],[16,1,"み"],[19,1,"し"],[27,2,"ひろば"],[30,1,"たず"],[34,2,"こうへい"],[37,1,"おこな"],[40,2,"しんじつ"],[43,1,"もと"],[46,1,"もの"],[57,1,"さが"]],"text":"エルサレムのちまたを行きめぐり、見て、知るがよい。その広場を尋ねて、公平を行い、真実を求める者が、ひとりでもあるか捜してみよ。あれば、わたしはエルサレムをゆるす。"},{"ref":"Jer.5.2","start":24005002,"end":24005002,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かれ"],[5,1,"しゅ"],[7,1,"い"],[16,1,"い"],[23,1,"じつ"],[26,1,"いつわ"],[29,1,"ちか"]],"text":"彼らは、「主は生きておられる」と言うけれども、実は、偽って誓うのだ。"},{"ref":"Jer.5.3","start":24005003,"end":24005003,"break":"line","breaks":[[10,"line"],[27,"line"],[47,"line"],[70,"line"],[83,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"め"],[10,2,"しんじつ"],[13,1,"かえり"],[31,1,"かれ"],[34,1,"う"],[40,1,"いた"],[43,1,"おぼ"],[47,1,"かれ"],[50,1,"ほろ"],[57,1,"こら"],[61,1,"う"],[67,1,"こば"],[72,1,"かお"],[74,1,"いわ"],[78,1,"かた"],[83,1,"く"],[85,1,"あらた"],[91,1,"こば"]],"text":"主よ、あなたの目は、真実を顧みられるではありませんか。あなたが彼らを打たれても、痛みを覚えず、彼らを滅ぼされても、懲しめを受けることを拒み、その顔を岩よりも堅くして、悔い改めることを拒みました。"},{"ref":"Jer.5.4","start":24005004,"end":24005004,"break":"stanza","breaks":[[12,"line"],[29,"line"]],"ruby":[[8,1,"い"],[19,1,"まず"],[22,1,"おろ"],[25,2,"ひとびと"],[29,1,"しゅ"],[31,1,"みち"],[34,1,"かみ"],[40,1,"し"]],"text":"それで、わたしは言った、「これらはただ貧しい愚かな人々で、主の道と、神のおきてを知りません。"},{"ref":"Jer.5.5","start":24005005,"end":24005005,"break":"line","breaks":[[24,"line"],[48,"line"],[71,"line"]],"ruby":[[4,1,"えら"],[6,1,"ひと"],[10,1,"ところ"],[12,1,"い"],[16,1,"かれ"],[19,1,"かた"],[24,1,"かれ"],[27,1,"しゅ"],[29,1,"みち"],[31,1,"し"],[34,1,"かみ"],[40,1,"し"],[53,1,"かれ"],[56,1,"みな"],[68,1,"お"],[75,1,"た"]],"text":"わたしは偉い人たちの所へ行って、彼らに語ります。彼らは主の道を知り、神のおきてを知っています」。ところが、彼らも皆おなじように、くびきを折り、なわめを断っていた。"},{"ref":"Jer.5.6","start":24005006,"end":24005006,"break":"stanza","breaks":[[21,"line"],[42,"line"],[59,"line"],[74,"line"],[82,"line"]],"ruby":[[4,1,"はやし"],[11,1,"で"],[15,1,"かれ"],[18,1,"ころ"],[21,2,"あらの"],[31,1,"で"],[35,1,"かれ"],[38,1,"ほろ"],[46,1,"かれ"],[49,2,"まちまち"],[63,1,"で"],[65,1,"もの"],[69,1,"さ"],[74,1,"かれ"],[77,1,"つみ"],[79,1,"おお"],[84,2,"はいしん"]],"text":"それゆえ林から、ししが出てきて彼らを殺し、荒野から、おおかみが出てきて彼らを滅ぼす。ひょうは彼らの町々をねらっている。そこから出る者はみな裂かれる。彼らの罪が多く、その背信がはなはだしいからである。"},{"ref":"Jer.5.7","start":24005007,"end":24005007,"break":"stanza","breaks":[[14,"line"],[26,"line"],[45,"line"],[60,"line"],[75,"line"]],"ruby":[[30,1,"こ"],[40,1,"す"],[45,1,"かみ"],[56,1,"ちか"],[64,1,"かれ"],[67,1,"み"],[69,1,"た"],[73,1,"とき"],[75,1,"かれ"],[78,2,"かんいん"],[81,1,"おこな"],[84,2,"ゆうじょ"],[87,1,"いえ"],[89,1,"む"],[91,1,"あつ"]],"text":"「わたしはどうしてあなたを、ゆるすことができようか。あなたの子どもらは、わたしを捨てさり、神でもないものをさして誓った。わたしが彼らを満ち足らせた時、彼らは姦淫を行い、遊女の家に群れ集まった。"},{"ref":"Jer.5.8","start":24005008,"end":24005008,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こ"],[5,1,"ふと"],[8,2,"じょうぶ"],[11,1,"お"],[12,1,"うま"],[28,1,"となり"],[30,1,"つま"],[32,1,"した"]],"text":"彼らは肥え太った丈夫な雄馬のように、おのおの、いなないて隣の妻を慕う。"},{"ref":"Jer.5.9","start":24005009,"end":24005009,"break":"line","breaks":[[13,"line"],[28,"line"],[50,"line"]],"ruby":[[8,1,"こと"],[13,1,"かれ"],[16,1,"ばっ"],[33,2,"こくみん"],[39,1,"かえ"],[50,1,"しゅ"],[52,1,"い"]],"text":"わたしはこれらの事のために彼らを罰しないでいられようか。このような国民にあだを返さないであろうか」と主は言われる。"},{"ref":"Jer.5.10","start":24005010,"end":24005010,"break":"stanza","breaks":[[21,"line"],[33,"line"],[51,"line"],[60,"line"]],"ruby":[[14,1,"な"],[16,1,"き"],[18,1,"あいだ"],[25,1,"い"],[29,1,"ほろ"],[41,1,"ほろ"],[53,1,"えだ"],[55,1,"き"],[57,1,"のぞ"],[60,1,"しゅ"]],"text":"「あなたがたはユダのぶどうの並み木の間を、のぼって行って、滅ぼせ、ただ、ことごとく滅ぼしてはならない。その枝を切り除け、主のものではないからである。"},{"ref":"Jer.5.11","start":24005011,"end":24005011,"break":"line","breaks":[[14,"line"]],"ruby":[[6,1,"いえ"],[11,1,"いえ"],[22,2,"ふしん"],[30,1,"しゅ"],[32,1,"い"]],"text":"イスラエルの家とユダの家とはわたしにまったく不信であった」と主は言われる。"},{"ref":"Jer.5.12","start":24005012,"end":24005012,"break":"line","breaks":[[18,"line"],[30,"line"],[41,"line"]],"ruby":[[1,1,"かれ"],[4,1,"しゅ"],[9,1,"いつわ"],[11,1,"かた"],[14,1,"い"],[19,1,"しゅ"],[21,2,"なにごと"],[30,1,"わざわい"],[37,1,"こ"],[52,1,"み"]],"text":"「彼らは主について偽り語って言った、『主は何事もなされない、災はわれわれに来ない、またつるぎや、ききんを見ることはない。"},{"ref":"Jer.5.13","start":24005013,"end":24005013,"break":"line","breaks":[[22,"line"]],"ruby":[[0,3,"よげんしゃ"],[5,1,"かぜ"],[10,1,"かれ"],[16,2,"ことば"],[22,1,"かれ"]],"text":"預言者らは風となり、彼らのうちに言葉はない。彼らはこのようになる』と」。"},{"ref":"Jer.5.14","start":24005014,"end":24005014,"break":"stanza","breaks":[[18,"line"],[33,"line"],[48,"line"],[70,"line"]],"ruby":[[4,2,"ばんぐん"],[7,1,"かみ"],[9,1,"しゅ"],[13,1,"い"],[19,1,"かれ"],[24,2,"ことば"],[27,1,"かた"],[33,1,"み"],[44,1,"くち"],[52,2,"ことば"],[55,1,"ひ"],[61,1,"たみ"],[70,1,"ひ"],[72,1,"かれ"],[75,1,"や"],[77,1,"つく"]],"text":"それゆえ万軍の神、主はこう言われる、「彼らがこの言葉を語ったので、見よ、わたしはあなたの口にあるわたしの言葉を火とし、この民をたきぎとする。火は彼らを焼き尽す」。"},{"ref":"Jer.5.15","start":24005015,"end":24005015,"break":"line","breaks":[[17,"line"],[30,"line"],[47,"line"],[62,"line"],[79,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[14,1,"いえ"],[17,1,"み"],[24,1,"とお"],[26,1,"くに"],[28,1,"たみ"],[40,1,"せ"],[49,1,"くに"],[51,1,"なが"],[53,1,"つづ"],[55,1,"くに"],[57,1,"ふる"],[59,1,"くに"],[70,1,"くに"],[72,2,"ことば"],[75,1,"し"],[79,2,"ひとびと"],[82,1,"かた"],[86,1,"さと"]],"text":"主は言われる、「イスラエルの家よ、見よ、わたしは遠い国の民をあなたがたのところに攻めこさせる。その国は長く続く国、古い国で、あなたがたはその国の言葉を知らず、人々の語るのを悟ることもできない。"},{"ref":"Jer.5.16","start":24005016,"end":24005016,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"えびら"],[4,1,"ひら"],[7,1,"はか"],[15,1,"かれ"],[20,2,"ゆうし"]],"text":"その箙は開いた墓のようであり、彼らはみな勇士である。"},{"ref":"Jer.5.17","start":24005017,"end":24005017,"break":"line","breaks":[[15,"line"],[28,"line"],[42,"line"],[55,"line"],[77,"line"],[96,"line"]],"ruby":[[0,1,"かれ"],[7,1,"か"],[9,1,"い"],[12,1,"もの"],[19,2,"りょうしょく"],[23,1,"く"],[25,1,"つく"],[35,1,"むすめ"],[37,1,"く"],[39,1,"つく"],[46,1,"ひつじ"],[48,1,"うし"],[50,1,"く"],[52,1,"つく"],[63,1,"き"],[70,1,"き"],[72,1,"く"],[74,1,"つく"],[91,1,"たの"],[96,2,"けんご"],[99,2,"まちまち"],[102,1,"ほろ"]],"text":"彼らはあなたが刈り入れた物と、あなたの糧食とを食い尽し、あなたのむすこ娘を食い尽し、あなたの羊と牛を食い尽し、あなたのぶどうの木といちじくの木を食い尽し、またつるぎをもって、あなたが頼みとする堅固な町々を滅ぼす」。"},{"ref":"Jer.5.18","start":24005018,"end":24005018,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[13,1,"とき"],[31,1,"ほろ"]],"text":"主は言われる、「しかしその時でも、わたしはことごとくはあなたを滅ぼさない。"},{"ref":"Jer.5.19","start":24005019,"end":24005019,"break":"none","ruby":[[4,1,"たみ"],[17,1,"かみ"],[19,1,"しゅ"],[29,1,"こと"],[44,1,"い"],[54,1,"かれ"],[57,1,"こた"],[79,1,"す"],[83,2,"じぶん"],[86,1,"ち"],[88,1,"こと"],[91,2,"かみがみ"],[94,1,"つか"],[107,2,"じぶん"],[115,1,"ち"],[117,2,"いほう"],[120,1,"ひと"],[122,1,"つか"]],"text":"あなたの民が、『どうしてわれわれの神、主はこれらのすべての事をわれわれになされたのか』と言うならば、あなたは彼らに答えなければならない、『あなたがたがわたしを捨てて、自分の地で異なる神々に仕えたように、あなたがたは自分のものでない地で異邦の人に仕えるようになる』と」。"},{"ref":"Jer.5.20","start":24005020,"end":24005020,"break":"paragraph","breaks":[[12,"line"]],"ruby":[[7,1,"いえ"],[17,1,"しめ"],[20,1,"い"]],"text":"これをヤコブの家にのべ、またユダに示して言え、"},{"ref":"Jer.5.21","start":24005021,"end":24005021,"break":"line","breaks":[[11,"line"],[21,"line"]],"ruby":[[1,1,"おろ"],[5,1,"さと"],[11,1,"め"],[17,1,"み"],[21,1,"みみ"],[27,1,"きこ"],[31,1,"たみ"],[37,1,"き"]],"text":"「愚かで、悟りもなく、目があっても見えず、耳があっても聞えない民よ、これを聞け。"},{"ref":"Jer.5.22","start":24005022,"end":24005022,"break":"line","breaks":[[24,"line"],[39,"line"],[54,"line"],[66,"line"],[82,"line"],[101,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[17,1,"おそ"],[28,1,"まえ"],[43,1,"すな"],[45,1,"お"],[48,1,"うみ"],[50,1,"さかい"],[57,2,"えいえん"],[60,2,"げんかい"],[66,1,"こ"],[82,1,"なみ"],[91,1,"か"],[101,1,"な"],[112,1,"こ"]],"text":"主は言われる、あなたがたはわたしを恐れないのか、わたしの前におののかないのか。わたしは砂を置いて海の境とし、これを永遠の限界として、越えることができないようにした。波はさかまいても、勝つことはできない、鳴りわたっても、これを越えることはできない。"},{"ref":"Jer.5.23","start":24005023,"end":24005023,"break":"line","breaks":[[22,"line"]],"ruby":[[7,1,"たみ"],[10,2,"ごうじょう"],[17,1,"こころ"],[22,1,"かれ"],[27,1,"みち"],[33,1,"さ"]],"text":"ところが、この民には強情な、そむく心があり、彼らはわき道にそれて、去ってしまった。"},{"ref":"Jer.5.24","start":24005024,"end":24005024,"break":"line","breaks":[[14,"line"],[33,"line"],[52,"line"],[67,"line"]],"ruby":[[0,1,"かれ"],[9,1,"あめ"],[11,1,"あた"],[14,1,"あき"],[16,1,"あめ"],[18,1,"はる"],[20,1,"あめ"],[22,1,"とき"],[29,1,"ふ"],[41,2,"かりい"],[45,1,"とき"],[47,1,"さだ"],[57,1,"かみ"],[59,1,"しゅ"],[61,1,"おそ"],[69,1,"こころ"],[74,1,"い"]],"text":"彼らは『われわれに雨を与え、秋の雨と春の雨を時にしたがって降らせ、われわれのために刈入れの時を定められたわれわれの神、主を恐れよう』とその心のうちに言わないのだ。"},{"ref":"Jer.5.25","start":24005025,"end":24005025,"break":"line","breaks":[[21,"line"],[30,"line"]],"ruby":[[14,1,"こと"],[27,1,"つみ"],[30,1,"よ"],[32,1,"もの"],[40,1,"く"]],"text":"あなたがたのとがは、これらの事をしりぞけ、あなたがたの罪は、良い物があなたがたに来るのをさまたげた。"},{"ref":"Jer.5.26","start":24005026,"end":24005026,"break":"line","breaks":[[16,"line"],[36,"line"]],"ruby":[[2,1,"たみ"],[8,1,"わる"],[10,1,"もの"],[16,1,"とり"],[20,1,"ひと"],[25,1,"み"],[39,1,"お"],[42,1,"ひと"],[44,1,"とら"]],"text":"わが民のうちには悪い者があって、鳥をとる人のように身をかがめてうかがい、わなを置いて人を捕える。"},{"ref":"Jer.5.27","start":24005027,"end":24005027,"break":"line","breaks":[[14,"line"],[30,"line"]],"ruby":[[3,1,"とり"],[5,1,"み"],[14,1,"かれ"],[17,1,"いえ"],[19,2,"ふぎ"],[22,1,"たから"],[24,1,"み"],[35,1,"かれ"],[38,1,"おお"],[42,1,"もの"],[44,2,"ゆうふく"],[47,1,"もの"]],"text":"かごに鳥が満ちているように、彼らの家は不義の宝で満ちている。それゆえ、彼らは大いなる者、裕福な者となり、"},{"ref":"Jer.5.28","start":24005028,"end":24005028,"break":"line","breaks":[[10,"line"],[25,"line"],[45,"line"],[57,"line"]],"ruby":[[0,1,"こ"],[12,1,"あ"],[15,1,"おこな"],[19,2,"さいげん"],[25,1,"かれ"],[28,2,"こうせい"],[37,1,"うった"],[48,1,"たす"],[59,1,"まず"],[62,1,"ひと"],[64,1,"うった"]],"text":"肥えて、つやがあり、その悪しき行いには際限がない。彼らは公正に、みなしごの訴えをさばいて、それを助けようとはせず、また貧しい人の訴えをさばかない。"},{"ref":"Jer.5.29","start":24005029,"end":24005029,"break":"line","breaks":[[22,"line"],[35,"line"],[47,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[16,1,"こと"],[22,1,"かれ"],[25,1,"ばっ"],[44,1,"たみ"],[50,1,"かえ"]],"text":"主は言われる、わたしはこのような事のために、彼らを罰しないであろうか。わたしはこのような民に、あだを返さないであろうか」。"},{"ref":"Jer.5.30","start":24005030,"end":24005030,"break":"stanza","ruby":[[0,1,"おどろ"],[7,1,"おそ"],[16,1,"ち"],[18,1,"おこ"]],"text":"驚くべきこと、恐るべきことがこの地に起っている。"},{"ref":"Jer.5.31","start":24005031,"end":24005031,"break":"line","breaks":[[11,"line"],[25,"line"],[45,"line"],[54,"line"]],"ruby":[[0,3,"よげんしゃ"],[4,1,"いつわ"],[7,2,"よげん"],[11,2,"さいし"],[14,2,"じぶん"],[17,1,"て"],[22,1,"おさ"],[27,1,"たみ"],[39,1,"あい"],[56,1,"おわ"]],"text":"預言者は偽って預言し、祭司は自分の手によって治め、わが民はこのようにすることを愛している。しかしあなたがたはその終りにはどうするつもりか。"}]