[{"ref":"2Chr.2.1","start":14002001,"end":14002001,"break":"paragraph","ruby":[[7,1,"しゅ"],[9,1,"な"],[17,1,"みや"],[19,1,"た"],[24,2,"じぶん"],[33,2,"おうきゅう"],[36,1,"た"],[41,1,"おも"]],"text":"さてソロモンは主の名のために一つの宮を建て、また自分のために一つの王宮を建てようと思った。"},{"ref":"2Chr.2.2","start":14002002,"end":14002002,"break":"none","ruby":[[8,1,"に"],[10,1,"お"],[12,1,"もの"],[15,1,"にん"],[17,1,"やま"],[19,1,"いし"],[21,1,"き"],[23,1,"だ"],[25,1,"もの"],[28,1,"にん"],[34,2,"かんとく"],[38,1,"もの"],[43,1,"にん"],[45,1,"かぞ"],[47,1,"だ"]],"text":"そしてソロモンは荷を負う者七万人、山で石を切り出す者八万人、これらを監督する者三千六百人を数え出した。"},{"ref":"2Chr.2.3","start":14002003,"end":14002003,"break":"none","ruby":[[14,1,"ひと"],[21,1,"い"],[35,1,"ちち"],[43,1,"す"],[47,1,"いえ"],[49,1,"た"],[55,2,"こうはく"],[58,1,"おく"],[68,1,"かれ"],[84,1,"くだ"]],"text":"ソロモンはまずツロのヒラムに人をつかわして言わせた、「あなたはわたしの父ダビデに、その住むべき家を建てるために香柏を送られました。どうぞ彼にされたように、わたしにもして下さい。"},{"ref":"2Chr.2.4","start":14002004,"end":14002004,"break":"none","ruby":[[0,1,"み"],[9,1,"かみ"],[11,1,"しゅ"],[13,1,"な"],[21,1,"いえ"],[23,1,"た"],[29,2,"せいべつ"],[33,1,"かれ"],[39,1,"かれ"],[41,1,"まえ"],[48,1,"こう"],[53,2,"じょうく"],[59,1,"そな"],[64,2,"はんさい"],[67,3,"あんそくにち"],[71,2,"しんげつ"],[81,1,"かみ"],[83,1,"しゅ"],[85,1,"さだ"],[88,1,"まつり"],[90,2,"あさゆう"],[108,1,"まも"],[112,1,"さだ"]],"text":"見よ、わたしはわが神、主の名のために一つの家を建て、これを聖別して彼にささげ、彼の前にこうばしい香をたき、常供のパンを供え、また燔祭を安息日、新月、およびわれらの神、主の定めの祭に朝夕ささげ、これをイスラエルのながく守るべき定めにしようとしています。"},{"ref":"2Chr.2.5","start":14002005,"end":14002005,"break":"none","ruby":[[6,1,"た"],[9,1,"いえ"],[11,1,"おお"],[14,1,"いえ"],[22,1,"かみ"],[28,1,"かみ"],[32,1,"おお"],[36,1,"かみ"]],"text":"またわたしの建てる家は大きな家です。われらの神はすべての神よりも大いなる神だからです。"},{"ref":"2Chr.2.6","start":14002006,"end":14002006,"break":"none","ruby":[[4,1,"てん"],[7,1,"しょ"],[8,1,"てん"],[10,1,"てん"],[12,1,"かれ"],[14,1,"い"],[30,1,"かれ"],[35,1,"いえ"],[37,1,"た"],[55,2,"なにもの"],[61,1,"かれ"],[66,1,"いえ"],[68,1,"た"],[79,1,"かれ"],[81,1,"まえ"],[83,1,"こう"],[87,1,"ところ"]],"text":"しかし、天も、諸天の天も彼を入れることができないのに、だれが彼のために家を建てることができましょうか。わたしは何者ですか、彼のために家を建てるというのも、ただ彼の前に香をたく所に、ほかならないのです。"},{"ref":"2Chr.2.7","start":14002007,"end":14002007,"break":"none","ruby":[[7,1,"きん"],[9,1,"ぎん"],[11,2,"せいどう"],[14,1,"てつ"],[16,2,"さいく"],[21,1,"むらさき"],[22,1,"いと"],[24,1,"ひ"],[25,1,"いと"],[27,1,"あお"],[28,1,"いと"],[30,2,"おりもの"],[40,2,"ちょうこく"],[43,1,"じゅつ"],[45,1,"たく"],[48,2,"こうじん"],[58,1,"おく"],[62,1,"ちち"],[67,1,"そな"],[86,2,"こうじん"],[91,2,"いっしょ"],[94,1,"はたら"]],"text":"それで、どうぞ金、銀、青銅、鉄の細工および紫糸、緋糸、青糸の織物にくわしく、また彫刻の術に巧みな工人ひとりをわたしに送って、父ダビデが備えておいたユダとエルサレムのわたしの工人たちと一緒に働かせてください。"},{"ref":"2Chr.2.8","start":14002008,"end":14002008,"break":"none","ruby":[[11,2,"こうはく"],[25,1,"おく"],[52,1,"き"],[54,1,"き"],[70,1,"し"],[98,2,"いっしょ"],[101,1,"はたら"]],"text":"またどうぞレバノンから香柏、いとすぎ、びゃくだんを送ってください。わたしはあなたのしもべたちがレバノンで木を切ることをよくわきまえているのを知っています。わたしのしもべたちも、あなたのしもべたちと一緒に働かせ、"},{"ref":"2Chr.2.9","start":14002009,"end":14002009,"break":"none","ruby":[[12,2,"ざいもく"],[15,1,"そな"],[29,1,"た"],[32,1,"いえ"],[34,2,"ひじょう"],[37,2,"こうだい"]],"text":"わたしのためにたくさんの材木を備えさせてください。わたしの建てる家は非常に広大なものですから。"},{"ref":"2Chr.2.10","start":14002010,"end":14002010,"break":"none","ruby":[[4,1,"き"],[6,1,"き"],[18,1,"くだ"],[21,2,"こむぎ"],[28,2,"おおむぎ"],[38,1,"しゅ"],[44,1,"あぶら"],[50,1,"あた"]],"text":"わたしは木を切るあなたのしもべたちに砕いた小麦二万コル、大麦二万コル、ぶどう酒二万バテ、油二万バテを与えます」。"},{"ref":"2Chr.2.11","start":14002011,"end":14002011,"break":"paragraph","ruby":[[6,1,"おう"],[11,2,"てがみ"],[19,1,"おく"],[22,1,"こた"],[27,1,"しゅ"],[31,1,"たみ"],[33,1,"あい"],[44,1,"かれ"],[47,1,"おう"]],"text":"そこでツロの王ヒラムは手紙をソロモンに送って答えた、「主はその民を愛するゆえに、あなたを彼らの王とされました」。"},{"ref":"2Chr.2.12","start":14002012,"end":14002012,"break":"none","ruby":[[6,1,"い"],[11,2,"てんち"],[14,1,"つく"],[24,1,"かみ"],[26,1,"しゅ"],[35,1,"かれ"],[40,1,"おう"],[42,1,"かしこ"],[44,1,"こ"],[46,1,"あた"],[52,2,"ふんべつ"],[55,2,"ちえ"],[58,1,"さづ"],[62,1,"しゅ"],[67,1,"みや"],[69,1,"た"],[74,2,"じぶん"],[81,2,"おうきゅう"],[84,1,"た"]],"text":"ヒラムはまた言った、「天地を造られたイスラエルの神、主はほむべきかな。彼はダビデ王に賢い子を与え、これに分別と知恵を授けて、主のために宮を建て、また自分のために、王宮を建てることをさせられた。"},{"ref":"2Chr.2.13","start":14002013,"end":14002013,"break":"paragraph","ruby":[[6,2,"たつじん"],[14,2,"ちえ"],[19,2,"こうじん"]],"text":"いまわたしは達人ヒラムという知恵のある工人をつかわします。"},{"ref":"2Chr.2.14","start":14002014,"end":14002014,"break":"none","ruby":[[0,1,"かれ"],[5,2,"しそん"],[10,1,"おんな"],[12,1,"はは"],[19,1,"ひと"],[21,1,"ちち"],[25,2,"きんぎん"],[28,2,"せいどう"],[31,1,"てつ"],[33,1,"いし"],[35,1,"き"],[37,2,"さいく"],[42,1,"むらさき"],[43,1,"いと"],[45,1,"あお"],[46,1,"いと"],[48,2,"あま"],[50,1,"いと"],[52,1,"ひ"],[53,1,"いと"],[55,2,"おりもの"],[72,2,"ちょうこく"],[77,2,"いしょう"],[80,1,"こ"],[89,2,"こうさく"],[96,1,"かれ"],[98,1,"もち"],[105,2,"こうじん"],[114,1,"ちち"],[118,1,"しゅ"],[123,2,"こうじん"],[126,2,"いっしょ"],[129,1,"はたら"]],"text":"彼はダンの子孫である女を母とし、ツロの人を父とし、金銀、青銅、鉄、石、木の細工および紫糸、青糸、亜麻糸、緋糸の織物にくわしく、またよくもろもろの彫刻をし、意匠を凝らしてもろもろの工作をします。彼を用いてあなたの工人およびあなたの父、わが主ダビデの工人と一緒に働かせなさい。"},{"ref":"2Chr.2.15","start":14002015,"end":14002015,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"い"],[13,2,"こむぎ"],[16,2,"おおむぎ"],[19,1,"あぶら"],[26,1,"しゅ"],[36,1,"おく"]],"text":"それでいまわが主の言われた小麦、大麦、油およびぶどう酒をそのしもべどもに送ってください。"},{"ref":"2Chr.2.16","start":14002016,"end":14002016,"break":"none","ruby":[[4,1,"もと"],[9,2,"ざいもく"],[18,1,"き"],[27,1,"く"],[31,1,"うみ"],[38,1,"おく"],[56,1,"はこ"],[58,1,"あ"]],"text":"あなたの求められる材木はレバノンから切りだし、いかだに組んで、海からヨッパに送ります。あなたはそれをエルサレムに運び上げなさい」。"},{"ref":"2Chr.2.17","start":14002017,"end":14002017,"break":"paragraph","ruby":[[10,1,"ちち"],[15,1,"かぞ"],[27,1,"くに"],[35,2,"たこく"],[37,1,"じん"],[39,1,"かぞ"],[44,1,"あ"],[55,1,"にん"]],"text":"そこでソロモンはその父ダビデが数えたようにイスラエルの国にいるすべての他国人を数えたが、合わせて十五万三千六百人あった。"},{"ref":"2Chr.2.18","start":14002018,"end":14002018,"break":"none","ruby":[[0,1,"かれ"],[6,1,"にん"],[8,1,"に"],[10,1,"お"],[12,1,"もの"],[18,1,"にん"],[20,1,"やま"],[22,1,"き"],[24,1,"いし"],[26,1,"き"],[28,1,"もの"],[36,1,"にん"],[38,1,"たみ"],[40,1,"はたら"],[44,2,"かんとく"],[46,1,"しゃ"]],"text":"彼はその七万人を荷を負う者とし、八万人を山で木や石を切る者とし、三千六百人を民を働かせる監督者とした。"}]