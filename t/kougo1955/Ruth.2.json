[{"ref":"Ruth.2.1","start":8002001,"end":8002001,"break":"paragraph","ruby":[[8,1,"おっと"],[15,2,"いちぞく"],[19,2,"ひじょう"],[22,2,"ゆうふく"],[29,2,"しんせき"],[38,1,"な"]],"text":"さてナオミには、夫エリメレクの一族で、非常に裕福なひとりの親戚があって、その名をボアズといった。"},{"ref":"Ruth.2.2","start":8002002,"end":8002002,"break":"none","ruby":[[4,1,"おんな"],[12,1,"い"],[25,1,"はたけ"],[27,1,"い"],[39,2,"しんせつ"],[42,1,"ひと"],[44,2,"みあた"],[57,1,"かた"],[65,1,"お"],[67,1,"ぼ"],[69,1,"ひろ"],[79,2,"かのじょ"],[83,1,"むすめ"],[86,1,"い"],[93,1,"い"]],"text":"モアブの女ルツはナオミに言った、「どうぞ、わたしを畑に行かせてください。だれか親切な人が見当るならば、わたしはその方のあとについて落ち穂を拾います」。ナオミが彼女に「娘よ、行きなさい」と言ったので、"},{"ref":"Ruth.2.3","start":8002003,"end":8002003,"break":"none","ruby":[[3,1,"い"],[7,1,"か"],[9,1,"ひと"],[16,1,"したが"],[19,1,"はたけ"],[21,1,"お"],[23,1,"ぼ"],[25,1,"ひろ"],[30,2,"かのじょ"],[44,2,"いちぞく"],[53,1,"はたけ"],[55,2,"ぶぶん"]],"text":"ルツは行って、刈る人たちのあとに従い、畑で落ち穂を拾ったが、彼女ははからずもエリメレクの一族であるボアズの畑の部分にきた。"},{"ref":"Ruth.2.4","start":8002004,"end":8002004,"break":"none","ruby":[[2,1,"とき"],[18,1,"か"],[20,1,"もの"],[24,1,"い"],[29,1,"しゅ"],[37,1,"とも"],[49,1,"かれ"],[52,1,"こた"],[57,1,"しゅ"],[63,2,"しゅくふく"]],"text":"その時ボアズは、ベツレヘムからきて、刈る者どもに言った、「主があなたがたと共におられますように」。彼らは答えた、「主があなたを祝福されますように」。"},{"ref":"Ruth.2.5","start":8002005,"end":8002005,"break":"none","ruby":[[4,1,"か"],[6,1,"ひと"],[10,2,"かんとく"],[20,1,"い"],[31,1,"むすめ"]],"text":"ボアズは刈る人たちを監督しているしもべに言った、「これはだれの娘ですか」。"},{"ref":"Ruth.2.6","start":8002006,"end":8002006,"break":"none","ruby":[[0,1,"か"],[2,1,"ひと"],[6,2,"かんとく"],[16,1,"こた"],[28,1,"おんな"],[35,1,"ち"],[42,2,"いっしょ"],[45,1,"かえ"]],"text":"刈る人たちを監督しているしもべは答えた、「あれはモアブの女で、モアブの地からナオミと一緒に帰ってきたのですが、"},{"ref":"Ruth.2.7","start":8002007,"end":8002007,"break":"none","ruby":[[0,2,"かのじょ"],[13,1,"か"],[15,1,"ひと"],[26,1,"たば"],[33,1,"お"],[35,1,"ぼ"],[37,1,"ひろ"],[39,1,"あつ"],[50,1,"い"],[59,2,"かのじょ"],[62,1,"あさ"],[63,1,"はや"],[68,1,"いま"],[71,1,"はたら"],[75,1,"すこ"],[82,1,"やす"]],"text":"彼女は『どうぞ、わたしに、刈る人たちのあとについて、束のあいだで、落ち穂を拾い集めさせてください』と言いました。そして彼女は朝早くきて、今まで働いて、少しのあいだも休みませんでした」。"},{"ref":"Ruth.2.8","start":8002008,"end":8002008,"break":"paragraph","ruby":[[7,1,"い"],[12,1,"むすめ"],[16,1,"き"],[25,1,"はたけ"],[27,1,"ほ"],[29,1,"ひろ"],[32,1,"い"],[47,1,"さ"],[65,1,"はたら"],[67,1,"おんな"],[71,1,"はな"]],"text":"ボアズはルツに言った、「娘よ、お聞きなさい。ほかの畑に穂を拾いに行ってはいけません。またここを去ってはなりません。わたしのところで働く女たちを離れないで、ここにいなさい。"},{"ref":"Ruth.2.9","start":8002009,"end":8002009,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"か"],[10,1,"はたけ"],[12,1,"め"],[26,1,"い"],[36,2,"わかもの"],[41,1,"めい"],[61,1,"い"],[83,1,"とき"],[86,1,"みず"],[94,1,"い"],[98,2,"わかもの"],[108,1,"の"]],"text":"人々が刈りとっている畑に目をとめて、そのあとについて行きなさい。わたしは若者たちに命じて、あなたのじゃまをしないようにと、言っておいたではありませんか。あなたがかわく時には水がめのところへ行って、若者たちのくんだのを飲みなさい」。"},{"ref":"Ruth.2.10","start":8002010,"end":8002010,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"ち"],[5,1,"ふ"],[8,1,"はい"],[11,1,"かれ"],[13,1,"い"],[34,2,"がいこく"],[36,1,"じん"],[38,1,"かえり"],[42,2,"しんせつ"]],"text":"彼女は地に伏して拝し、彼に言った、「どうしてあなたは、わたしのような外国人を顧みて、親切にしてくださるのですか」。"},{"ref":"Ruth.2.11","start":8002011,"end":8002011,"break":"none","ruby":[[4,1,"こた"],[7,2,"かのじょ"],[10,1,"い"],[19,1,"おっと"],[21,1,"し"],[48,2,"じぶん"],[51,2,"ふぼ"],[54,1,"うま"],[57,1,"くに"],[59,1,"はな"],[66,1,"し"],[72,1,"たみ"],[83,1,"みな"],[88,1,"きこ"]],"text":"ボアズは答えて彼女に言った、「あなたの夫が死んでこのかた、あなたがしゅうとめにつくしたこと、また自分の父母と生れた国を離れて、かつて知らなかった民のところにきたことは皆わたしに聞えました。"},{"ref":"Ruth.2.12","start":8002012,"end":8002012,"break":"none","ruby":[[4,1,"しゅ"],[15,1,"むく"],[34,1,"かみ"],[36,1,"しゅ"],[48,1,"つばさ"],[50,1,"した"],[52,1,"み"],[54,1,"よ"],[63,1,"しゅ"],[72,1,"むく"],[75,1,"え"]],"text":"どうぞ、主があなたのしたことに報いられるように。どうぞ、イスラエルの神、主、すなわちあなたがその翼の下に身を寄せようとしてきた主からじゅうぶんの報いを得られるように」。"},{"ref":"Ruth.2.13","start":8002013,"end":8002013,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"い"],[10,1,"しゅ"],[46,1,"およ"],[65,1,"なぐさ"],[78,1,"かた"]],"text":"彼女は言った、「わが主よ、まことにありがとうございます。わたしはあなたのはしためのひとりにも及ばないのに、あなたはこんなにわたしを慰め、はしためにねんごろに語られました」。"},{"ref":"Ruth.2.14","start":8002014,"end":8002014,"break":"paragraph","ruby":[[0,2,"しょくじ"],[3,1,"とき"],[9,2,"かのじょ"],[12,1,"い"],[26,1,"た"],[33,1,"た"],[36,1,"もの"],[38,1,"す"],[40,1,"ひた"],[47,2,"かのじょ"],[50,1,"か"],[52,2,"ひとびと"],[71,2,"やきむぎ"],[74,2,"かのじょ"],[77,1,"あた"],[81,2,"かのじょ"],[84,1,"あ"],[89,1,"た"],[92,1,"のこ"]],"text":"食事の時、ボアズは彼女に言った、「ここへきて、パンを食べ、あなたの食べる物を酢に浸しなさい」。彼女が刈る人々のかたわらにすわったので、ボアズは焼麦を彼女に与えた。彼女は飽きるほど食べて残した。"},{"ref":"Ruth.2.15","start":8002015,"end":8002015,"break":"none","ruby":[[3,2,"かのじょ"],[8,1,"ほ"],[10,1,"ひろ"],[14,1,"た"],[27,2,"わかもの"],[32,1,"めい"],[35,1,"い"],[40,2,"かのじょ"],[44,1,"たば"],[46,1,"あいだ"],[49,1,"ほ"],[51,1,"ひろ"]],"text":"そして彼女がまた穂を拾おうと立ちあがったとき、ボアズは若者たちに命じて言った、「彼女には束の間でも穂を拾わせなさい。とがめてはならない。"},{"ref":"Ruth.2.16","start":8002016,"end":8002016,"break":"none","ruby":[[2,2,"かのじょ"],[8,1,"たば"],[14,1,"ぬ"],[16,1,"おと"],[22,1,"ひろ"]],"text":"また彼女のために束からわざと抜き落しておいて拾わせなさい。しかってはならない」。"},{"ref":"Ruth.2.17","start":8002017,"end":8002017,"break":"none","ruby":[[4,2,"かのじょ"],[7,2,"ゆうぐれ"],[11,1,"はたけ"],[13,1,"お"],[15,1,"ぼ"],[17,1,"ひろ"],[24,1,"ひろ"],[27,1,"ほ"],[29,1,"う"],[33,2,"おおむぎ"]],"text":"こうして彼女は夕暮まで畑で落ち穂を拾った。そして拾った穂を打つと、大麦は一エパほどあった。"},{"ref":"Ruth.2.18","start":8002018,"end":8002018,"break":"none","ruby":[[0,2,"かのじょ"],[6,1,"たずさ"],[9,1,"まち"],[23,1,"ひろ"],[29,1,"み"],[34,1,"た"],[36,1,"あ"],[40,1,"のこ"],[43,1,"も"],[52,1,"と"],[54,1,"だ"],[57,1,"あた"]],"text":"彼女はそれを携えて町にはいり、しゅうとめにその拾ったものを見せ、かつ食べ飽きて、残して持ちかえったものを取り出して与えた。"},{"ref":"Ruth.2.19","start":8002019,"end":8002019,"break":"none","ruby":[[6,2,"かのじょ"],[9,1,"い"],[26,1,"ほ"],[28,1,"ひろ"],[38,1,"はたら"],[54,1,"かえり"],[69,2,"しゅくふく"],[82,2,"かのじょ"],[85,2,"じぶん"],[91,1,"ところ"],[93,1,"はたら"],[105,1,"つ"],[118,1,"はたら"],[129,1,"な"],[131,1,"ひと"],[133,1,"ところ"],[138,1,"い"]],"text":"しゅうとめは彼女に言った、「あなたは、きょう、どこで穂を拾いましたか。どこで働きましたか。あなたをそのように顧みてくださったかたに、どうか祝福があるように」。そこで彼女は自分がだれの所で働いたかを、しゅうとめに告げて、「わたしが、きょう働いたのはボアズという名の人の所です」と言った。"},{"ref":"Ruth.2.20","start":8002020,"end":8002020,"break":"none","ruby":[[4,1,"よめ"],[6,1,"い"],[11,1,"い"],[16,1,"もの"],[20,1,"し"],[23,1,"もの"],[27,1,"かえり"],[37,1,"たま"],[40,1,"しゅ"],[48,1,"ひと"],[50,2,"しゅくふく"],[67,2,"かのじょ"],[70,1,"い"],[77,1,"ひと"],[85,2,"えんじゃ"],[89,1,"もっと"],[91,1,"ちか"],[93,2,"しんせき"]],"text":"ナオミは嫁に言った、「生きている者をも、死んだ者をも、顧みて、いつくしみを賜わる主が、どうぞその人を祝福されますように」。ナオミはまた彼女に言った、「その人はわたしたちの縁者で、最も近い親戚のひとりです」。"},{"ref":"Ruth.2.21","start":8002021,"end":8002021,"break":"none","ruby":[[4,1,"おんな"],[8,1,"い"],[15,1,"ひと"],[36,2,"かりい"],[40,2,"ぜんぶ"],[42,1,"おわ"],[69,1,"い"]],"text":"モアブの女ルツは言った、「その人はまたわたしに『あなたはわたしのところの刈入れが全部終るまで、わたしのしもべたちのそばについていなさい』と言いました」。"},{"ref":"Ruth.2.22","start":8002022,"end":8002022,"break":"none","ruby":[[4,1,"よめ"],[8,1,"い"],[13,1,"むすめ"],[18,1,"ひと"],[24,1,"はたら"],[26,1,"おんな"],[30,2,"いっしょ"],[33,1,"で"],[54,1,"はたけ"],[56,1,"ひと"],[66,1,"まぬか"]],"text":"ナオミは嫁ルツに言った、「娘よ、その人のところで働く女たちと一緒に出かけるのはけっこうです。そうすればほかの畑で人にいじめられるのを免れるでしょう」。"},{"ref":"Ruth.2.23","start":8002023,"end":8002023,"break":"none","ruby":[[3,2,"かのじょ"],[14,1,"はたら"],[16,1,"おんな"],[28,1,"ほ"],[30,1,"ひろ"],[33,2,"おおむぎ"],[35,1,"かり"],[37,2,"こむぎ"],[39,1,"かり"],[41,1,"おわ"],[54,2,"かのじょ"],[63,2,"いっしょ"],[66,1,"くら"]],"text":"それで彼女はボアズのところで働く女たちのそばについていて穂を拾い、大麦刈と小麦刈の終るまでそうした。こうして彼女はしゅうとめと一緒に暮した。"}]