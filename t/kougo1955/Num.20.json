[{"ref":"Num.20.1","start":4020001,"end":4020001,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"ぜん"],[10,2,"かいしゅう"],[13,2,"しょうがつ"],[22,2,"あらの"],[33,1,"たみ"],[54,1,"し"],[60,2,"かのじょ"],[66,1,"ほうむ"]],"text":"イスラエルの人々の全会衆は正月になってチンの荒野にはいった。そして民はカデシにとどまったが、ミリアムがそこで死んだので、彼女をそこに葬った。"},{"ref":"Num.20.2","start":4020002,"end":4020002,"break":"paragraph","ruby":[[4,2,"かいしゅう"],[7,1,"みず"],[9,1,"え"],[19,1,"あい"],[20,1,"あつ"],[32,1,"せま"]],"text":"そのころ会衆は水が得られなかったため、相集まってモーセとアロンに迫った。"},{"ref":"Num.20.3","start":4020003,"end":4020003,"break":"none","ruby":[[4,1,"たみ"],[10,1,"あらそ"],[13,1,"い"],[26,2,"きょうだい"],[31,1,"しゅ"],[33,1,"まえ"],[35,1,"し"],[38,1,"とき"],[45,1,"し"]],"text":"すなわち民はモーセと争って言った、「さきにわれわれの兄弟たちが主の前に死んだ時、われわれも死んでいたらよかったものを。"},{"ref":"Num.20.4","start":4020004,"end":4020004,"break":"none","ruby":[[9,1,"しゅ"],[11,2,"かいしゅう"],[16,2,"あらの"],[19,1,"みちび"],[34,2,"かちく"],[42,1,"し"]],"text":"なぜ、あなたがたは主の会衆をこの荒野に導いて、われわれと、われわれの家畜とを、ここで死なせようとするのですか。"},{"ref":"Num.20.5","start":4020005,"end":4020005,"break":"none","ruby":[[21,1,"のぼ"],[28,1,"わる"],[30,1,"ところ"],[32,1,"みちび"],[34,1,"い"],[46,1,"たね"],[50,1,"ところ"],[79,1,"の"],[81,1,"みず"]],"text":"どうしてあなたがたはわれわれをエジプトから上らせて、この悪い所に導き入れたのですか。ここには種をまく所もなく、いちじくもなく、ぶどうもなく、ざくろもなく、また飲む水もありません」。"},{"ref":"Num.20.6","start":4020006,"end":4020006,"break":"none","ruby":[[11,2,"かいしゅう"],[14,1,"まえ"],[16,1,"さ"],[19,2,"かいけん"],[22,2,"まくや"],[25,2,"いりぐち"],[28,1,"い"],[33,1,"ふ"],[40,1,"しゅ"],[42,2,"えいこう"],[45,1,"かれ"],[48,1,"あらわ"]],"text":"そこでモーセとアロンは会衆の前を去り、会見の幕屋の入口へ行ってひれ伏した。すると主の栄光が彼らに現れ、"},{"ref":"Num.20.7","start":4020007,"end":4020007,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.20.8","start":4020008,"end":4020008,"break":"none","ruby":[[16,2,"きょうだい"],[22,1,"とも"],[24,2,"かいしゅう"],[27,1,"あつ"],[32,1,"め"],[34,1,"まえ"],[36,1,"いわ"],[38,1,"めい"],[41,1,"みず"],[43,1,"だ"],[58,1,"かれ"],[64,1,"いわ"],[67,1,"みず"],[69,1,"だ"],[73,2,"かいしゅう"],[78,2,"かちく"],[81,1,"の"]],"text":"「あなたは、つえをとり、あなたの兄弟アロンと共に会衆を集め、その目の前で岩に命じて水を出させなさい。こうしてあなたは彼らのために岩から水を出して、会衆とその家畜に飲ませなさい」。"},{"ref":"Num.20.9","start":4020009,"end":4020009,"break":"none","ruby":[[4,1,"めい"],[12,1,"しゅ"],[14,1,"まえ"],[21,1,"と"]],"text":"モーセは命じられたように主の前にあるつえを取った。"},{"ref":"Num.20.10","start":4020010,"end":4020010,"break":"none","ruby":[[8,1,"とも"],[10,2,"かいしゅう"],[13,1,"いわ"],[15,1,"まえ"],[17,1,"あつ"],[20,1,"かれ"],[23,1,"い"],[31,1,"ひと"],[36,1,"き"],[58,1,"いわ"],[61,1,"みず"],[63,1,"だ"]],"text":"モーセはアロンと共に会衆を岩の前に集めて彼らに言った、「そむく人たちよ、聞きなさい。われわれがあなたがたのためにこの岩から水を出さなければならないのであろうか」。"},{"ref":"Num.20.11","start":4020011,"end":4020011,"break":"none","ruby":[[4,1,"て"],[12,1,"いわ"],[15,1,"ど"],[16,1,"う"],[20,1,"みず"],[28,1,"で"],[33,2,"かいしゅう"],[38,2,"かちく"],[44,1,"の"]],"text":"モーセは手をあげ、つえで岩を二度打つと、水がたくさんわき出たので、会衆とその家畜はともに飲んだ。"},{"ref":"Num.20.12","start":4020012,"end":4020012,"break":"none","ruby":[[4,1,"しゅ"],[14,1,"い"],[30,1,"しん"],[42,2,"ひとびと"],[45,1,"まえ"],[51,1,"せい"],[57,1,"あらわ"],[68,2,"かいしゅう"],[75,1,"かれ"],[78,1,"あた"],[81,1,"ち"],[83,1,"みちび"],[85,1,"い"]],"text":"そのとき主はモーセとアロンに言われた、「あなたがたはわたしを信じないで、イスラエルの人々の前にわたしの聖なることを現さなかったから、この会衆をわたしが彼らに与えた地に導き入れることができないであろう」。"},{"ref":"Num.20.13","start":4020013,"end":4020013,"break":"none","ruby":[[7,1,"みず"],[19,2,"ひとびと"],[25,1,"しゅ"],[27,1,"あらそ"],[32,1,"しゅ"],[34,2,"じぶん"],[37,1,"せい"],[43,1,"かれ"],[49,1,"あらわ"]],"text":"これがメリバの水であって、イスラエルの人々はここで主と争ったが、主は自分の聖なることを彼らのうちに現された。"},{"ref":"Num.20.14","start":4020014,"end":4020014,"break":"paragraph","ruby":[[16,1,"おう"],[18,2,"ししゃ"],[26,1,"い"],[35,2,"きょうだい"],[46,1,"もう"],[62,2,"そうぐう"],[70,2,"かんなん"],[74,1,"ぞん"]],"text":"さて、モーセはカデシからエドムの王に使者をつかわして言った、「あなたの兄弟、イスラエルはこう申します、『あなたはわたしたちが遭遇したすべての患難をご存じです。"},{"ref":"Num.20.15","start":4020015,"end":4020015,"break":"none","ruby":[[6,2,"せんぞ"],[14,1,"くだ"],[17,1,"い"],[27,1,"とし"],[28,1,"ひさ"],[36,1,"す"],[65,2,"せんぞ"],[68,1,"なや"]],"text":"わたしたちの先祖はエジプトに下って行って、わたしたちは年久しくエジプトに住んでいましたが、エジプトびとがわたしたちと、わたしたちの先祖を悩ましたので、"},{"ref":"Num.20.16","start":4020016,"end":4020016,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"よ"],[16,1,"しゅ"],[24,1,"こえ"],[26,1,"き"],[33,1,"てん"],[35,1,"つかい"],[55,1,"みちび"],[57,1,"だ"],[70,1,"いま"],[75,2,"りょうち"],[78,1,"はし"],[86,1,"まち"]],"text":"わたしたちが主に呼ばわったとき、主はわたしたちの声を聞き、ひとりの天の使をつかわして、わたしたちをエジプトから導き出されました。わたしたちは今あなたの領地の端にあるカデシの町におります。"},{"ref":"Num.20.17","start":4020017,"end":4020017,"break":"none","ruby":[[14,1,"くに"],[16,1,"とお"],[31,1,"はたけ"],[36,1,"はたけ"],[38,1,"とお"],[46,2,"いど"],[49,1,"みず"],[51,1,"の"],[59,1,"おう"],[61,2,"おおじ"],[64,1,"とお"],[71,2,"りょうち"],[74,1,"す"],[80,1,"みぎ"],[83,1,"ひだり"],[86,1,"まが"]],"text":"どうぞ、わたしたちにあなたの国を通らせてください。わたしたちは畑もぶどう畑も通りません。また井戸の水も飲みません。ただ王の大路を通り、あなたの領地を過ぎるまでは右にも左にも曲りません』」。"},{"ref":"Num.20.18","start":4020018,"end":4020018,"break":"none","ruby":[[12,1,"い"],[25,2,"りょうち"],[56,1,"で"],[63,1,"た"]],"text":"しかし、エドムはモーセに言った、「あなたはわたしの領地をとおってはなりません。さもないと、わたしはつるぎをもって出て、あなたに立ちむかうでしょう」。"},{"ref":"Num.20.19","start":4020019,"end":4020019,"break":"none","ruby":[[6,2,"ひとびと"],[13,1,"い"],[24,2,"おおじ"],[27,1,"とお"],[46,2,"かちく"],[55,1,"みず"],[57,1,"の"],[68,1,"あたい"],[70,1,"はら"],[79,2,"とほ"],[82,1,"とお"],[90,2,"なにごと"]],"text":"イスラエルの人々はエドムに言った、「わたしたちは大路を通ります。もしわたしたちとわたしたちの家畜とが、あなたの水を飲むことがあれば、その価を払います。わたしは徒歩で通るだけですから何事もないでしょう」。"},{"ref":"Num.20.20","start":4020020,"end":4020020,"break":"none","ruby":[[13,1,"とお"],[25,1,"い"],[29,1,"おお"],[32,1,"たみ"],[34,1,"つよ"],[36,2,"ぐんぜい"],[40,1,"ひき"],[43,1,"で"],[49,1,"た"]],"text":"しかし、エドムは「あなたは通ることはなりません」と言って、多くの民と強い軍勢とを率い、出て、これに立ちむかってきた。"},{"ref":"Num.20.21","start":4020021,"end":4020021,"break":"none","ruby":[[18,2,"りょうち"],[21,1,"とお"],[26,1,"こば"],[46,1,"む"]],"text":"このようにエドムはイスラエルに、その領地を通ることを拒んだので、イスラエルはエドムからほかに向かった。"},{"ref":"Num.20.22","start":4020022,"end":4020022,"break":"paragraph","ruby":[[10,2,"ひとびと"],[13,1,"ぜん"],[14,2,"かいしゅう"],[22,1,"すす"],[27,1,"やま"],[29,1,"つ"]],"text":"こうしてイスラエルの人々の全会衆はカデシから進んでホル山に着いた。"},{"ref":"Num.20.23","start":4020023,"end":4020023,"break":"none","ruby":[[0,1,"しゅ"],[6,2,"こっきょう"],[9,1,"ちか"],[13,1,"やま"],[24,1,"い"]],"text":"主はエドムの国境に近いホル山で、モーセとアロンに言われた、"},{"ref":"Num.20.24","start":4020024,"end":4020024,"break":"none","ruby":[[7,1,"たみ"],[9,1,"つら"],[21,1,"かれ"],[33,2,"ひとびと"],[36,1,"あた"],[39,1,"ち"],[60,1,"みず"],[73,2,"ことば"]],"text":"「アロンはその民に連ならなければならない。彼はわたしがイスラエルの人々に与えた地に、はいることができない。これはメリバの水で、あなたがたがわたしの言葉にそむいたからである。"},{"ref":"Num.20.25","start":4020025,"end":4020025,"break":"none","ruby":[[10,1,"こ"],[17,1,"つ"],[22,1,"やま"],[24,1,"のぼ"]],"text":"あなたはアロンとその子エレアザルを連れてホル山に登り、"},{"ref":"Num.20.26","start":4020026,"end":4020026,"break":"none","ruby":[[4,2,"いふく"],[7,1,"ぬ"],[17,1,"こ"],[24,1,"き"],[40,1,"し"],[46,1,"たみ"],[48,1,"つら"]],"text":"アロンに衣服を脱がせて、それをその子エレアザルに着せなさい。アロンはそのところで死んで、その民に連なるであろう」。"},{"ref":"Num.20.27","start":4020027,"end":4020027,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"めい"],[17,1,"つ"],[22,1,"ぜん"],[23,2,"かいしゅう"],[26,1,"め"],[28,1,"まえ"],[32,1,"やま"],[34,1,"のぼ"]],"text":"モーセは主が命じられたとおりにし、連れだって全会衆の目の前でホル山に登った。"},{"ref":"Num.20.28","start":4020028,"end":4020028,"break":"none","ruby":[[11,2,"いふく"],[14,1,"ぬ"],[23,1,"こ"],[30,1,"き"],[40,1,"やま"],[42,1,"いただき"],[44,1,"し"],[61,1,"やま"],[64,1,"くだ"]],"text":"そしてモーセはアロンに衣服を脱がせ、それをその子エレアザルに着せた。アロンはその山の頂で死んだ。そしてモーセとエレアザルは山から下ったが、"},{"ref":"Num.20.29","start":4020029,"end":4020029,"break":"none","ruby":[[0,1,"ぜん"],[1,2,"かいしゅう"],[8,1,"し"],[13,1,"み"],[24,2,"ぜんか"],[29,1,"にち"],[31,1,"あいだ"],[39,1,"な"]],"text":"全会衆がアロンの死んだのを見たとき、イスラエルの全家は三十日の間アロンのために泣いた。"}]