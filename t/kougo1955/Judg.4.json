[{"ref":"Judg.4.1","start":7004001,"end":7004001,"break":"paragraph","ruby":[[4,1,"し"],[7,1,"のち"],[15,2,"ひとびと"],[20,1,"しゅ"],[22,1,"まえ"],[24,1,"あく"]],"text":"エホデが死んだ後、イスラエルの人々がまた主の前に悪をおこなったので、"},{"ref":"Judg.4.2","start":7004002,"end":7004002,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"よ"],[9,1,"おさ"],[18,1,"おう"],[23,1,"て"],[25,1,"かれ"],[28,1,"う"],[40,2,"ぐんぜい"],[43,1,"ちょう"],[54,1,"す"]],"text":"主は、ハゾルで世を治めていたカナンの王ヤビンの手に彼らを売りわたされた。ヤビンの軍勢の長はハロセテ・ゴイムに住んでいたシセラであった。"},{"ref":"Judg.4.3","start":7004003,"end":7004003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"てつ"],[4,2,"せんしゃ"],[8,1,"りょう"],[15,1,"ねん"],[17,1,"あいだ"],[24,2,"ひとびと"],[27,1,"はげ"],[44,2,"ひとびと"],[47,1,"しゅ"],[49,1,"む"],[53,1,"よ"]],"text":"彼は鉄の戦車九百両をもち、二十年の間イスラエルの人々を激しくしえたげたので、イスラエルの人々は主に向かって呼ばわった。"},{"ref":"Judg.4.4","start":7004004,"end":7004004,"break":"paragraph","ruby":[[9,1,"つま"],[11,1,"おんな"],[12,3,"よげんしゃ"]],"text":"そのころラピドテの妻、女預言者デボラがイスラエルをさばいていた。"},{"ref":"Judg.4.5","start":7004005,"end":7004005,"break":"none","ruby":[[0,2,"かのじょ"],[9,2,"さんち"],[19,1,"あいだ"],[31,1,"き"],[33,1,"した"],[35,1,"ざ"],[44,2,"ひとびと"],[47,2,"かのじょ"],[53,1,"のぼ"]],"text":"彼女はエフライムの山地のラマとベテルの間にあるデボラのしゅろの木の下に座し、イスラエルの人々は彼女のもとに上ってきて、さばきをうけた。"},{"ref":"Judg.4.6","start":7004006,"end":7004006,"break":"none","ruby":[[4,1,"ひと"],[28,1,"こ"],[33,1,"まね"],[36,1,"い"],[47,1,"かみ"],[49,1,"しゅ"],[58,1,"めい"],[78,2,"ぶぞく"],[86,2,"ぶぞく"],[92,1,"にん"],[94,1,"ひき"],[97,1,"い"],[104,1,"やま"],[106,1,"じん"]],"text":"デボラは人をつかわして、ナフタリのケデシからアビノアムの子バラクを招いて言った、「イスラエルの神、主はあなたに、こう命じられるではありませんか、『ナフタリの部族とゼブルンの部族から一万人を率い、行って、タボル山に陣をしけ。"},{"ref":"Judg.4.7","start":7004007,"end":7004007,"break":"none","ruby":[[8,2,"ぐんぜい"],[11,1,"ちょう"],[18,2,"せんしゃ"],[21,2,"ぐんたい"],[29,1,"かわ"],[31,1,"ひ"],[33,1,"よ"],[41,1,"で"],[46,1,"かれ"],[52,1,"て"]],"text":"わたしはヤビンの軍勢の長シセラとその戦車と軍隊とをキション川に引き寄せて、あなたに出あわせ、彼をあなたの手にわたすであろう』」。"},{"ref":"Judg.4.8","start":7004008,"end":7004008,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"い"],[18,2,"いっしょ"],[21,1,"い"],[34,1,"い"],[43,2,"いっしょ"],[46,1,"い"],[59,1,"い"]],"text":"バラクは彼女に言った、「あなたがもし一緒に行ってくだされば、わたしは行きます。しかし、一緒に行ってくださらないならば、行きません」。"},{"ref":"Judg.4.9","start":7004009,"end":7004009,"break":"none","ruby":[[4,1,"い"],[9,1,"かなら"],[15,2,"いっしょ"],[18,1,"い"],[30,1,"いま"],[31,1,"い"],[33,1,"みち"],[36,1,"ほまれ"],[38,1,"え"],[46,1,"しゅ"],[52,1,"おんな"],[54,1,"て"],[71,1,"た"],[78,2,"いっしょ"],[85,1,"い"]],"text":"デボラは言った、「必ずあなたと一緒に行きます。しかしあなたは今行く道では誉を得ないでしょう。主はシセラを女の手にわたされるからです」。デボラは立ってバラクと一緒にケデシに行った。"},{"ref":"Judg.4.10","start":7004010,"end":7004010,"break":"none","ruby":[[18,1,"よ"],[20,1,"あつ"],[25,1,"にん"],[27,1,"したが"],[30,1,"のぼ"],[38,1,"かれ"],[40,1,"とも"],[42,1,"のぼ"]],"text":"バラクはゼブルンとナフタリをケデシに呼び集め、一万人を従えて上った。デボラも彼と共に上った。"},{"ref":"Judg.4.11","start":7004011,"end":7004011,"break":"paragraph","ruby":[[0,1,"とき"],[22,2,"しそん"],[33,1,"わか"],[41,1,"ちか"],[52,1,"き"],[56,1,"とお"],[58,1,"い"],[61,2,"てんまく"],[64,1,"は"]],"text":"時にケニびとヘベルはモーセのしゅうとホバブの子孫であるケニびとから分れて、ケデシに近いザアナイムのかしの木までも遠く行って天幕を張っていた。"},{"ref":"Judg.4.12","start":7004012,"end":7004012,"break":"paragraph","ruby":[[6,1,"こ"],[14,1,"やま"],[16,1,"のぼ"],[21,2,"ひとびと"],[28,1,"つ"]],"text":"アビノアムの子バラクがタボル山に上ったと、人々がシセラに告げたので、"},{"ref":"Judg.4.13","start":7004013,"end":7004013,"break":"none","ruby":[[4,2,"じぶん"],[7,2,"せんしゃ"],[10,2,"ぜんぶ"],[16,1,"てつ"],[18,2,"せんしゃ"],[22,1,"りょう"],[25,2,"じぶん"],[28,1,"とも"],[36,1,"たみ"],[52,1,"かわ"],[54,1,"よ"],[56,1,"あつ"]],"text":"シセラは自分の戦車の全部すなわち鉄の戦車九百両と、自分と共におるすべての民をハロセテ・ゴイムからキション川に呼び集めた。"},{"ref":"Judg.4.14","start":7004014,"end":7004014,"break":"none","ruby":[[8,1,"い"],[16,1,"た"],[29,1,"しゅ"],[39,1,"て"],[46,1,"ひ"],[50,1,"しゅ"],[56,2,"さきだ"],[60,1,"で"],[83,1,"にん"],[85,1,"したが"],[91,1,"やま"],[94,1,"くだ"]],"text":"デボラはバラクに言った、「さあ、立ちあがりなさい。きょうは主がシセラをあなたの手にわたされる日です。主はあなたに先立って出られるではありませんか」。そこでバラクは一万人を従えてタボル山から下った。"},{"ref":"Judg.4.15","start":7004015,"end":7004015,"break":"none","ruby":[[0,1,"しゅ"],[17,2,"せんしゃ"],[22,2,"ぐんぜい"],[34,1,"まえ"],[36,1,"う"],[38,1,"やぶ"],[49,2,"せんしゃ"],[53,1,"と"],[58,2,"とほ"],[61,1,"に"],[63,1,"さ"]],"text":"主はつるぎをもってシセラとすべての戦車および軍勢をことごとくバラクの前に撃ち敗られたので、シセラは戦車から飛びおり、徒歩で逃げ去った。"},{"ref":"Judg.4.16","start":7004016,"end":7004016,"break":"none","ruby":[[4,2,"せんしゃ"],[7,2,"ぐんぜい"],[11,2,"ついげき"],[25,1,"い"],[33,2,"ぐんぜい"],[50,1,"のこ"]],"text":"バラクは戦車と軍勢とを追撃してハロセテ・ゴイムまで行った。シセラの軍勢はことごとくつるぎにたおれて、残ったものはひとりもなかった。"},{"ref":"Judg.4.17","start":7004017,"end":7004017,"break":"paragraph","ruby":[[7,2,"とほ"],[10,1,"に"],[12,1,"さ"],[24,1,"つま"],[29,2,"てんまく"],[32,1,"い"],[40,1,"おう"],[53,1,"いえ"],[56,1,"たがい"]],"text":"しかしシセラは徒歩で逃げ去って、ケニびとヘベルの妻ヤエルの天幕に行った。ハゾルの王ヤビンとケニびとヘベルの家とは互にむつまじかったからである。"},{"ref":"Judg.4.18","start":7004018,"end":7004018,"break":"none","ruby":[[4,1,"で"],[12,1,"むか"],[15,1,"かれ"],[17,1,"い"],[31,1,"しゅ"],[49,1,"おそ"],[66,2,"てんまく"],[80,2,"もうふ"],[86,1,"かれ"]],"text":"ヤエルは出てきてシセラを迎え、彼に言った、「おはいりください。主よ、どうぞうちへおはいりください。恐れるにはおよびません」。シセラが天幕にはいったので、ヤエルは毛布をもって彼をおおった。"},{"ref":"Judg.4.19","start":7004019,"end":7004019,"break":"none","ruby":[[8,1,"い"],[21,1,"みず"],[23,1,"すこ"],[25,1,"の"],[51,1,"ちち"],[53,1,"かわ"],[54,1,"ぶくろ"],[56,1,"ひら"],[59,1,"かれ"],[61,1,"の"],[67,1,"かれ"]],"text":"シセラはヤエルに言った、「どうぞ、わたしに水を少し飲ませてください。のどがかわきましたから」。ヤエルは乳の皮袋を開いて彼に飲ませ、また彼をおおった。"},{"ref":"Judg.4.20","start":7004020,"end":7004020,"break":"none","ruby":[[10,1,"い"],[15,2,"てんまく"],[18,2,"いりぐち"],[21,1,"た"],[33,1,"ひと"],[57,1,"と"],[70,1,"こた"]],"text":"シセラはまたヤエルに言った、「天幕の入口に立っていてください。もし人がきて、あなたに『だれか、ここにおりますか』と問うならば『おりません』と答えてください」。"},{"ref":"Judg.4.21","start":7004021,"end":7004021,"break":"none","ruby":[[3,1,"かれ"],[5,1,"つか"],[8,2,"じゅくすい"],[19,1,"つま"],[24,2,"てんまく"],[30,1,"と"],[33,1,"て"],[35,1,"つち"],[37,1,"たずさ"],[40,1,"かれ"],[42,1,"しの"],[44,1,"よ"],[55,1,"う"],[57,1,"こ"],[60,1,"ち"],[62,1,"さ"],[64,1,"とお"],[70,1,"かれ"],[72,1,"いき"],[73,1,"た"],[76,1,"し"]],"text":"しかし彼が疲れて熟睡したとき、ヘベルの妻ヤエルは天幕のくぎを取り、手に槌を携えて彼に忍び寄り、こめかみにくぎを打ち込んで地に刺し通したので、彼は息絶えて死んだ。"},{"ref":"Judg.4.22","start":7004022,"end":7004022,"break":"none","ruby":[[8,1,"お"],[20,1,"かれ"],[22,2,"でむか"],[26,1,"い"],[42,1,"もと"],[47,1,"ひと"],[50,1,"み"],[59,1,"かれ"],[65,2,"てんまく"],[72,1,"み"],[88,1,"う"],[92,1,"たお"],[95,1,"し"]],"text":"バラクがシセラを追ってきたとき、ヤエルは彼を出迎えて言った、「おいでなさい。あなたが求めている人をお見せしましょう」。彼がヤエルの天幕にはいって見ると、シセラはこめかみにくぎを打たれて倒れて死んでいた。"},{"ref":"Judg.4.23","start":7004023,"end":7004023,"break":"paragraph","ruby":[[6,1,"ひ"],[8,1,"かみ"],[14,1,"おう"],[25,2,"ひとびと"],[28,1,"まえ"],[30,1,"う"],[32,1,"やぶ"]],"text":"こうしてその日、神はカナンの王ヤビンをイスラエルの人々の前に撃ち敗られた。"},{"ref":"Judg.4.24","start":7004024,"end":7004024,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"て"],[24,1,"おう"],[29,1,"うえ"],[31,1,"おも"],[44,1,"おう"],[49,1,"ほろ"],[53,1,"いた"]],"text":"そしてイスラエルの人々の手はますますカナンびとの王ヤビンの上に重くなって、ついにカナンの王ヤビンを滅ぼすに至った。"}]