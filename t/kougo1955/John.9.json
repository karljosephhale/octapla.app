[{"ref":"John.9.1","start":43009001,"end":43009001,"break":"paragraph","ruby":[[4,1,"みち"],[17,1,"うま"],[22,2,"もうじん"],[25,1,"み"]],"text":"イエスが道をとおっておられるとき、生れつきの盲人を見られた。"},{"ref":"John.9.2","start":43009002,"end":43009002,"break":"none","ruby":[[0,2,"でし"],[9,1,"たず"],[12,1,"い"],[17,2,"せんせい"],[22,1,"ひと"],[24,1,"うま"],[28,2,"もうじん"],[37,1,"つみ"],[39,1,"おか"],[48,2,"ほんにん"],[60,2,"りょうしん"]],"text":"弟子たちはイエスに尋ねて言った、「先生、この人が生れつき盲人なのは、だれが罪を犯したためですか。本人ですか、それともその両親ですか」。"},{"ref":"John.9.3","start":43009003,"end":43009003,"break":"none","ruby":[[4,1,"こた"],[11,2,"ほんにん"],[14,1,"つみ"],[16,1,"おか"],[30,2,"りょうしん"],[33,1,"おか"],[44,1,"かみ"],[51,1,"かれ"],[53,1,"うえ"],[55,1,"あらわ"]],"text":"イエスは答えられた、「本人が罪を犯したのでもなく、また、その両親が犯したのでもない。ただ神のみわざが、彼の上に現れるためである。"},{"ref":"John.9.4","start":43009004,"end":43009004,"break":"none","ruby":[[24,1,"ひる"],[26,1,"あいだ"],[38,1,"よる"],[40,1,"く"],[50,1,"はたら"]],"text":"わたしたちは、わたしをつかわされたかたのわざを、昼の間にしなければならない。夜が来る。すると、だれも働けなくなる。"},{"ref":"John.9.5","start":43009005,"end":43009005,"break":"none","ruby":[[7,1,"よ"],[11,1,"あいだ"],[14,1,"よ"],[16,1,"ひかり"]],"text":"わたしは、この世にいる間は、世の光である」。"},{"ref":"John.9.6","start":43009006,"end":43009006,"break":"none","ruby":[[6,1,"い"],[10,1,"ち"],[37,2,"もうじん"],[40,1,"め"],[42,1,"ぬ"],[45,1,"い"]],"text":"イエスはそう言って、地につばきをし、そのつばきで、どろをつくり、そのどろを盲人の目に塗って言われた、"},{"ref":"John.9.7","start":43009007,"end":43009007,"break":"none","ruby":[[12,1,"もの"],[15,1,"い"],[18,1,"いけ"],[20,1,"い"],[23,1,"あら"],[33,1,"かれ"],[35,1,"い"],[38,1,"あら"],[45,1,"み"],[55,1,"かえ"],[58,1,"い"]],"text":"「シロアム（つかわされた者、の意）の池に行って洗いなさい」。そこで彼は行って洗った。そして見えるようになって、帰って行った。"},{"ref":"John.9.8","start":43009008,"end":43009008,"break":"none","ruby":[[0,2,"きんじょ"],[3,2,"ひとびと"],[7,1,"かれ"],[21,2,"みし"],[27,2,"ひとびと"],[30,1,"い"],[37,1,"ひと"],[52,1,"もの"]],"text":"近所の人々や、彼がもと、こじきであったのを見知っていた人々が言った、「この人は、すわってこじきをしていた者ではないか」。"},{"ref":"John.9.9","start":43009009,"end":43009009,"break":"none","ruby":[[2,2,"ひとびと"],[8,1,"ひと"],[12,1,"い"],[15,1,"た"],[17,2,"ひとびと"],[28,1,"ひと"],[30,1,"に"],[39,1,"い"],[47,2,"ほんにん"],[60,1,"い"]],"text":"ある人々は「その人だ」と言い、他の人々は「いや、ただあの人に似ているだけだ」と言った。しかし、本人は「わたしがそれだ」と言った。"},{"ref":"John.9.10","start":43009010,"end":43009010,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"かれ"],[8,1,"い"],[20,1,"め"]],"text":"そこで人々は彼に言った、「では、おまえの目はどうしてあいたのか」。"},{"ref":"John.9.11","start":43009011,"end":43009011,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こた"],[29,1,"め"],[31,1,"ぬ"],[40,1,"い"],[43,1,"あら"],[47,1,"い"],[58,1,"い"],[61,1,"あら"],[65,1,"み"]],"text":"彼は答えた、「イエスというかたが、どろをつくって、わたしの目に塗り、『シロアムに行って洗え』と言われました。それで、行って洗うと、見えるようになりました」。"},{"ref":"John.9.12","start":43009012,"end":43009012,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"かれ"],[5,1,"い"],[12,1,"ひと"],[23,1,"かれ"],[26,1,"し"],[33,1,"こた"]],"text":"人々は彼に言った、「その人はどこにいるのか」。彼は「知りません」と答えた。"},{"ref":"John.9.13","start":43009013,"end":43009013,"break":"paragraph","ruby":[[0,2,"ひとびと"],[6,2,"もうじん"],[14,1,"ひと"],[21,1,"びと"],[32,1,"い"]],"text":"人々は、もと盲人であったこの人を、パリサイ人たちのところにつれて行った。"},{"ref":"John.9.14","start":43009014,"end":43009014,"break":"none","ruby":[[11,1,"かれ"],[13,1,"め"],[21,3,"あんそくにち"]],"text":"イエスがどろをつくって彼の目をあけたのは、安息日であった。"},{"ref":"John.9.15","start":43009015,"end":43009015,"break":"none","ruby":[[4,1,"びと"],[16,1,"み"],[30,1,"かれ"],[32,1,"たず"],[36,1,"かれ"],[38,1,"こた"],[52,1,"め"],[57,1,"ぬ"],[67,1,"あら"],[73,1,"み"]],"text":"パリサイ人たちもまた、「どうして見えるようになったのか」、と彼に尋ねた。彼は答えた、「あのかたがわたしの目にどろを塗り、わたしがそれを洗い、そして見えるようになりました」。"},{"ref":"John.9.16","start":43009016,"end":43009016,"break":"none","ruby":[[10,1,"びと"],[14,1,"い"],[21,1,"ひと"],[23,1,"かみ"],[28,1,"ひと"],[34,3,"あんそくにち"],[38,1,"まも"],[57,2,"ひとびと"],[60,1,"い"],[65,1,"つみ"],[69,1,"ひと"],[85,1,"おこな"],[100,1,"かれ"],[103,1,"あいだ"],[105,2,"ぶんそう"],[108,1,"しょう"]],"text":"そこで、あるパリサイ人たちが言った、「その人は神からきた人ではない。安息日を守っていないのだから」。しかし、ほかの人々は言った、「罪のある人が、どうしてそのようなしるしを行うことができようか」。そして彼らの間に分争が生じた。"},{"ref":"John.9.17","start":43009017,"end":43009017,"break":"none","ruby":[[3,1,"かれ"],[10,1,"ど"],[13,2,"もうじん"],[16,1,"き"],[25,1,"め"],[35,1,"ひと"],[40,1,"おも"],[46,3,"よげんしゃ"],[51,1,"おも"],[57,1,"かれ"],[59,1,"い"]],"text":"そこで彼らは、もう一度この盲人に聞いた、「おまえの目をあけてくれたその人を、どう思うか」。「預言者だと思います」と彼は言った。"},{"ref":"John.9.18","start":43009018,"end":43009018,"break":"none","ruby":[[3,1,"じん"],[8,1,"かれ"],[12,2,"もうじん"],[19,1,"み"],[34,1,"しん"],[44,1,"かれ"],[48,1,"め"],[50,1,"み"],[61,1,"ひと"],[63,2,"りょうしん"],[66,1,"よ"]],"text":"ユダヤ人たちは、彼がもと盲人であったが見えるようになったことを、まだ信じなかった。ついに彼らは、目が見えるようになったこの人の両親を呼んで、"},{"ref":"John.9.19","start":43009019,"end":43009019,"break":"none","ruby":[[0,1,"たず"],[3,1,"い"],[12,1,"うま"],[16,2,"もうじん"],[30,1,"い"],[51,1,"め"],[53,1,"み"]],"text":"尋ねて言った、「これが、生れつき盲人であったと、おまえたちの言っているむすこか。それではどうして、いま目が見えるのか」。"},{"ref":"John.9.20","start":43009020,"end":43009020,"break":"none","ruby":[[0,2,"りょうしん"],[3,1,"こた"],[6,1,"い"],[31,1,"うま"],[35,2,"もうじん"],[44,1,"ぞん"]],"text":"両親は答えて言った、「これがわたしどものむすこであること、また生れつき盲人であったことは存じています。"},{"ref":"John.9.21","start":43009021,"end":43009021,"break":"none","ruby":[[10,1,"み"],[25,1,"し"],[39,1,"め"],[44,1,"くだ"],[51,1,"し"],[60,1,"き"],[63,1,"くだ"],[80,2,"じぶん"],[86,2,"じぶん"],[89,1,"はな"]],"text":"しかし、どうしていま見えるようになったのか、それは知りません。また、だれがその目をあけて下さったのかも知りません。あれに聞いて下さい。あれはもうおとなですから、自分のことは自分で話せるでしょう」。"},{"ref":"John.9.22","start":43009022,"end":43009022,"break":"none","ruby":[[0,2,"りょうしん"],[6,1,"じん"],[10,1,"おそ"],[20,1,"こた"],[43,2,"こくはく"],[47,1,"もの"],[53,2,"かいどう"],[57,1,"お"],[59,1,"だ"],[68,1,"じん"],[72,1,"すで"],[74,1,"き"]],"text":"両親はユダヤ人たちを恐れていたので、こう答えたのである。それは、もしイエスをキリストと告白する者があれば、会堂から追い出すことに、ユダヤ人たちが既に決めていたからである。"},{"ref":"John.9.23","start":43009023,"end":43009023,"break":"none","ruby":[[0,1,"かれ"],[2,2,"りょうしん"],[17,1,"き"],[20,1,"くだ"],[25,1,"い"]],"text":"彼の両親が「おとなですから、あれに聞いて下さい」と言ったのは、そのためであった。"},{"ref":"John.9.24","start":43009024,"end":43009024,"break":"paragraph","ruby":[[3,1,"かれ"],[7,2,"もうじん"],[13,1,"ひと"],[17,2,"いちど"],[19,1,"よ"],[22,1,"い"],[27,1,"かみ"],[29,2,"えいこう"],[32,1,"き"],[41,1,"ひと"],[43,2,"つみびと"]],"text":"そこで彼らは、盲人であった人をもう一度呼んで言った、「神に栄光を帰するがよい。あの人が罪人であることは、わたしたちにはわかっている」。"},{"ref":"John.9.25","start":43009025,"end":43009025,"break":"none","ruby":[[3,1,"かれ"],[5,1,"い"],[15,2,"つみびと"],[29,1,"し"],[44,1,"し"],[55,1,"めくら"],[62,1,"いま"],[64,1,"み"]],"text":"すると彼は言った、「あのかたが罪人であるかどうか、わたしは知りません。ただ一つのことだけ知っています。わたしは盲であったが、今は見えるということです」。"},{"ref":"John.9.26","start":43009026,"end":43009026,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[13,1,"ひと"],[19,1,"なに"],[36,1,"め"]],"text":"そこで彼らは言った、「その人はおまえに何をしたのか。どんなにしておまえの目をあけたのか」。"},{"ref":"John.9.27","start":43009027,"end":43009027,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こた"],[14,1,"はな"],[23,1,"き"],[39,1,"き"],[59,1,"ひと"],[61,2,"でし"]],"text":"彼は答えた、「そのことはもう話してあげたのに、聞いてくれませんでした。なぜまた聞こうとするのですか。あなたがたも、あの人の弟子になりたいのですか」。"},{"ref":"John.9.28","start":43009028,"end":43009028,"break":"none","ruby":[[3,1,"かれ"],[6,1,"かれ"],[13,1,"い"],[25,2,"でし"],[40,2,"でし"]],"text":"そこで彼らは彼をののしって言った、「おまえはあれの弟子だが、わたしたちはモーセの弟子だ。"},{"ref":"John.9.29","start":43009029,"end":43009029,"break":"none","ruby":[[4,1,"かみ"],[6,1,"かた"],[16,1,"し"],[27,1,"ひと"],[35,1,"もの"],[44,1,"し"]],"text":"モーセに神が語られたということは知っている。だが、あの人がどこからきた者か、わたしたちは知らぬ」。"},{"ref":"John.9.30","start":43009030,"end":43009030,"break":"none","ruby":[[3,1,"かれ"],[5,1,"こた"],[8,1,"い"],[17,1,"め"],[22,1,"くだ"],[43,1,"ぞん"],[50,3,"ふしぎ"],[53,2,"せんばん"]],"text":"そこで彼が答えて言った、「わたしの目をあけて下さったのに、そのかたがどこからきたか、ご存じないとは、不思議千万です。"},{"ref":"John.9.31","start":43009031,"end":43009031,"break":"none","ruby":[[11,1,"し"],[18,1,"かみ"],[20,2,"つみびと"],[23,1,"い"],[29,1,"き"],[41,1,"かみ"],[43,1,"うやま"],[53,1,"おこな"],[55,1,"ひと"],[57,1,"い"],[63,1,"き"],[68,1,"くだ"]],"text":"わたしたちはこのことを知っています。神は罪人の言うことはお聞きいれになりませんが、神を敬い、そのみこころを行う人の言うことは、聞きいれて下さいます。"},{"ref":"John.9.32","start":43009032,"end":43009032,"break":"none","ruby":[[0,1,"うま"],[4,1,"めくら"],[9,1,"もの"],[11,1,"め"],[16,1,"ひと"],[27,2,"せかい"],[30,1,"はじ"],[34,2,"いらい"],[37,1,"き"]],"text":"生れつき盲であった者の目をあけた人があるということは、世界が始まって以来、聞いたことがありません。"},{"ref":"John.9.33","start":43009033,"end":43009033,"break":"none","ruby":[[7,1,"かみ"],[12,1,"ひと"],[20,2,"なにひと"]],"text":"もしあのかたが神からきた人でなかったら、何一つできなかったはずです」。"},{"ref":"John.9.34","start":43009034,"end":43009034,"break":"none","ruby":[[3,1,"き"],[6,1,"かれ"],[9,1,"い"],[18,1,"まった"],[20,1,"つみ"],[22,1,"なか"],[24,1,"うま"],[38,1,"おし"],[52,1,"かれ"],[54,1,"そと"],[56,1,"お"],[58,1,"だ"]],"text":"これを聞いて彼らは言った、「おまえは全く罪の中に生れていながら、わたしたちを教えようとするのか」。そして彼を外へ追い出した。"},{"ref":"John.9.35","start":43009035,"end":43009035,"break":"paragraph","ruby":[[7,1,"ひと"],[9,1,"そと"],[11,1,"お"],[13,1,"だ"],[20,1,"き"],[28,1,"かれ"],[30,1,"あ"],[33,1,"い"],[43,1,"ひと"],[45,1,"こ"],[47,1,"しん"]],"text":"イエスは、その人が外へ追い出されたことを聞かれた。そして彼に会って言われた、「あなたは人の子を信じるか」。"},{"ref":"John.9.36","start":43009036,"end":43009036,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こた"],[5,1,"い"],[10,1,"しゅ"],[28,1,"しん"]],"text":"彼は答えて言った、「主よ、それはどなたですか。そのかたを信じたいのですが」。"},{"ref":"John.9.37","start":43009037,"end":43009037,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[21,1,"ひと"],[23,1,"あ"],[29,1,"いま"],[34,1,"はな"],[44,1,"ひと"]],"text":"イエスは彼に言われた、「あなたは、もうその人に会っている。今あなたと話しているのが、その人である」。"},{"ref":"John.9.38","start":43009038,"end":43009038,"break":"none","ruby":[[3,1,"かれ"],[7,1,"しゅ"],[10,1,"しん"],[16,1,"い"],[24,1,"はい"]],"text":"すると彼は、「主よ、信じます」と言って、イエスを拝した。"},{"ref":"John.9.39","start":43009039,"end":43009039,"break":"none","ruby":[[7,1,"い"],[19,1,"よ"],[40,1,"み"],[44,1,"ひと"],[48,1,"み"],[57,1,"み"],[60,1,"ひと"],[64,1,"み"]],"text":"そこでイエスは言われた、「わたしがこの世にきたのは、さばくためである。すなわち、見えない人たちが見えるようになり、見える人たちが見えないようになるためである」。"},{"ref":"John.9.40","start":43009040,"end":43009040,"break":"none","ruby":[[7,2,"いっしょ"],[18,1,"びと"],[26,1,"き"],[33,1,"い"],[49,1,"めくら"]],"text":"そこにイエスと一緒にいたあるパリサイ人たちが、それを聞いてイエスに言った、「それでは、わたしたちも盲なのでしょうか」。"},{"ref":"John.9.41","start":43009041,"end":43009041,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[21,2,"もうじん"],[30,1,"つみ"],[45,1,"いま"],[53,1,"み"],[58,1,"い"],[60,1,"は"],[73,1,"つみ"]],"text":"イエスは彼らに言われた、「もしあなたがたが盲人であったなら、罪はなかったであろう。しかし、今あなたがたが『見える』と言い張るところに、あなたがたの罪がある。"}]