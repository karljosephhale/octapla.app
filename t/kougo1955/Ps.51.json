[{"ref":"Ps.51.1","start":19051001,"end":19051001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌、これはダビデがバテセバに通った後預言者ナタンがきたときによんだもの","breaks":[[17,"line"],[26,"line"],[42,"line"]],"ruby":[[0,1,"かみ"],[30,1,"ゆた"],[57,1,"さ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"],[34,1,"とお"],[37,1,"のち"],[38,3,"よげんしゃ"]],"text":"神よ、あなたのいつくしみによって、わたしをあわれみ、あなたの豊かなあわれみによって、わたしのもろもろのとがをぬぐい去ってください。"},{"ref":"Ps.51.2","start":19051002,"end":19051002,"break":"line","breaks":[[17,"line"]],"ruby":[[4,2,"ふぎ"],[12,1,"あら"],[14,1,"さ"],[21,1,"つみ"],[28,1,"きよ"]],"text":"わたしの不義をことごとく洗い去り、わたしの罪からわたしを清めてください。"},{"ref":"Ps.51.3","start":19051003,"end":19051003,"break":"line","breaks":[[17,"line"]],"ruby":[[4,2,"じぶん"],[10,1,"し"],[21,1,"つみ"],[30,1,"まえ"]],"text":"わたしは自分のとがを知っています。わたしの罪はいつもわたしの前にあります。"},{"ref":"Ps.51.4","start":19051004,"end":19051004,"break":"line","breaks":[[23,"line"],[39,"line"],[64,"line"]],"ruby":[[18,1,"つみ"],[20,1,"おか"],[27,1,"まえ"],[29,1,"わる"],[31,1,"こと"],[33,1,"おこな"],[48,2,"せんこく"],[52,1,"あた"],[60,1,"ただ"],[68,1,"ひと"],[78,1,"あやま"]],"text":"わたしはあなたにむかい、ただあなたに罪を犯し、あなたの前に悪い事を行いました。それゆえ、あなたが宣告をお与えになるときは正しく、あなたが人をさばかれるときは誤りがありません。"},{"ref":"Ps.51.5","start":19051005,"end":19051005,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"み"],[7,2,"ふぎ"],[13,1,"うま"],[23,1,"はは"],[25,1,"つみ"]],"text":"見よ、わたしは不義のなかに生れました。わたしの母は罪のうちにわたしをみごもりました。"},{"ref":"Ps.51.6","start":19051006,"end":19051006,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"み"],[7,2,"しんじつ"],[10,1,"こころ"],[15,1,"もと"],[31,1,"かく"],[34,1,"こころ"],[36,2,"ちえ"],[39,1,"おし"]],"text":"見よ、あなたは真実を心のうちに求められます。それゆえ、わたしの隠れた心に知恵を教えてください。"},{"ref":"Ps.51.7","start":19051007,"end":19051007,"break":"line","breaks":[[20,"line"],[33,"line"],[45,"line"]],"ruby":[[12,1,"きよ"],[24,1,"きよ"],[37,1,"あら"],[49,1,"ゆき"],[53,1,"しろ"]],"text":"ヒソプをもって、わたしを清めてください、わたしは清くなるでしょう。わたしを洗ってください、わたしは雪よりも白くなるでしょう。"},{"ref":"Ps.51.8","start":19051008,"end":19051008,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"よろこ"],[7,1,"たの"],[12,1,"み"],[20,1,"くだ"],[23,1,"ほね"],[25,1,"よろこ"]],"text":"わたしに喜びと楽しみとを満たし、あなたが砕いた骨を喜ばせてください。"},{"ref":"Ps.51.9","start":19051009,"end":19051009,"break":"line","breaks":[[13,"line"]],"ruby":[[1,1,"かお"],[7,1,"つみ"],[10,1,"かく"],[17,2,"ふぎ"],[28,1,"さ"]],"text":"み顔をわたしの罪から隠し、わたしの不義をことごとくぬぐい去ってください。"},{"ref":"Ps.51.10","start":19051010,"end":19051010,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[10,1,"きよ"],[12,1,"こころ"],[25,1,"あたら"],[29,1,"ただ"],[32,1,"れい"],[34,1,"あた"]],"text":"神よ、わたしのために清い心をつくり、わたしのうちに新しい、正しい霊を与えてください。"},{"ref":"Ps.51.11","start":19051011,"end":19051011,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"まえ"],[8,1,"す"],[22,1,"せい"],[25,1,"れい"],[32,1,"と"]],"text":"わたしをみ前から捨てないでください。あなたの聖なる霊をわたしから取らないでください。"},{"ref":"Ps.51.12","start":19051012,"end":19051012,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"すくい"],[6,1,"よろこ"],[13,1,"かえ"],[16,2,"じゆう"],[19,1,"れい"]],"text":"あなたの救の喜びをわたしに返し、自由の霊をもって、わたしをささえてください。"},{"ref":"Ps.51.13","start":19051013,"end":19051013,"break":"line","breaks":[[18,"line"],[27,"line"]],"ruby":[[13,1,"おか"],[16,1,"もの"],[22,1,"みち"],[24,1,"おし"],[27,1,"つみ"],[35,1,"かえ"]],"text":"そうすればわたしは、とがを犯した者にあなたの道を教え、罪びとはあなたに帰ってくるでしょう。"},{"ref":"Ps.51.14","start":19051014,"end":19051014,"break":"line","breaks":[[10,"line"],[32,"line"]],"ruby":[[0,1,"かみ"],[5,1,"すくい"],[7,1,"かみ"],[10,1,"ち"],[12,1,"なが"],[15,1,"つみ"],[22,1,"たす"],[24,1,"だ"],[36,1,"した"],[38,1,"こえ"],[39,1,"たか"],[47,1,"ぎ"],[49,1,"うた"]],"text":"神よ、わが救の神よ、血を流した罪からわたしを助け出してください。わたしの舌は声高らかにあなたの義を歌うでしょう。"},{"ref":"Ps.51.15","start":19051015,"end":19051015,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[12,1,"ひら"],[24,1,"くち"],[30,1,"ほまれ"]],"text":"主よ、わたしのくちびるを開いてください。わたしの口はあなたの誉をあらわすでしょう。"},{"ref":"Ps.51.16","start":19051016,"end":19051016,"break":"line","breaks":[[16,"line"],[31,"line"]],"ruby":[[9,1,"この"],[23,2,"はんさい"],[35,1,"よろこ"]],"text":"あなたはいけにえを好まれません。たといわたしが燔祭をささげてもあなたは喜ばれないでしょう。"},{"ref":"Ps.51.17","start":19051017,"end":19051017,"break":"line","breaks":[[19,"line"],[34,"line"]],"ruby":[[0,1,"かみ"],[2,1,"う"],[12,1,"くだ"],[15,1,"たましい"],[19,1,"かみ"],[26,1,"くだ"],[29,1,"く"],[32,1,"こころ"]],"text":"神の受けられるいけにえは砕けた魂です。神よ、あなたは砕けた悔いた心をかろしめられません。"},{"ref":"Ps.51.18","start":19051018,"end":19051018,"break":"line","breaks":[[24,"line"]],"ruby":[[18,1,"めぐ"],[21,1,"ほどこ"],[30,2,"じょうへき"],[33,1,"きず"]],"text":"あなたのみこころにしたがってシオンに恵みを施し、エルサレムの城壁を築きなおしてください。"},{"ref":"Ps.51.19","start":19051019,"end":19051019,"break":"line","breaks":[[18,"line"],[33,"line"]],"ruby":[[2,1,"とき"],[7,1,"ぎ"],[14,2,"はんさい"],[18,1,"まった"],[20,2,"はんさい"],[24,1,"よろこ"],[35,1,"とき"],[40,2,"さいだん"],[43,2,"おうし"]],"text":"その時あなたは義のいけにえと燔祭と、全き燔祭とを喜ばれるでしょう。その時あなたの祭壇に雄牛がささげられるでしょう。"}]