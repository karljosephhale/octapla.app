[{"ref":"Zech.7.1","start":38007001,"end":38007001,"break":"paragraph","ruby":[[4,1,"おう"],[6,1,"だい"],[8,1,"ねん"],[11,1,"がつ"],[24,1,"つき"],[27,1,"か"],[30,1,"しゅ"],[32,2,"ことば"],[40,1,"のぞ"]],"text":"ダリヨス王の第四年の九月、すなわちキスリウという月の四日に、主の言葉がゼカリヤに臨んだ。"},{"ref":"Zech.7.2","start":38007002,"end":38007002,"break":"none","ruby":[[2,1,"とき"],[7,2,"ひとびと"],[29,2,"じゅうしゃ"],[38,1,"しゅ"],[40,1,"めぐ"],[43,1,"こ"]],"text":"その時ベテルの人々は、シャレゼル、レゲン・メレクおよびその従者をつかわして、主の恵みを請い、"},{"ref":"Zech.7.3","start":38007003,"end":38007003,"break":"none","ruby":[[2,2,"ばんぐん"],[5,1,"しゅ"],[7,1,"みや"],[11,2,"さいし"],[14,1,"と"],[20,3,"よげんしゃ"],[24,1,"と"],[28,1,"い"],[37,1,"いま"],[41,2,"たねん"],[55,1,"がつ"],[57,1,"な"],[59,1,"かな"],[65,2,"だんじき"]],"text":"かつ万軍の主の宮にいる祭司に問わせ、かつ預言者に問わせて言った、「わたしは今まで、多年おこなってきたように、五月に泣き悲しみ、かつ断食すべきでしょうか」。"},{"ref":"Zech.7.4","start":38007004,"end":38007004,"break":"none","ruby":[[2,1,"とき"],[4,2,"ばんぐん"],[7,1,"しゅ"],[9,2,"ことば"],[16,1,"のぞ"]],"text":"この時、万軍の主の言葉がわたしに臨んだ、"},{"ref":"Zech.7.5","start":38007005,"end":38007005,"break":"none","ruby":[[1,1,"ち"],[7,1,"たみ"],[12,2,"さいし"],[15,1,"つ"],[18,1,"い"],[32,1,"ねん"],[34,1,"あいだ"],[37,1,"がつ"],[40,1,"がつ"],[43,2,"だんじき"],[49,1,"な"],[51,1,"かな"],[55,1,"とき"],[69,2,"だんじき"]],"text":"「地のすべての民、および祭司に告げて言いなさい、あなたがたが七十年の間、五月と七月とに断食し、かつ泣き悲しんだ時、はたして、わたしのために断食したか。"},{"ref":"Zech.7.6","start":38007006,"end":38007006,"break":"none","ruby":[[6,1,"く"],[8,1,"の"],[12,1,"とき"],[17,1,"まった"],[19,2,"じぶん"],[25,1,"く"],[28,2,"じぶん"],[34,1,"の"]],"text":"あなたがたが食い飲みする時、それは全く自分のために食い、自分のために飲むのではないか。"},{"ref":"Zech.7.7","start":38007007,"end":38007007,"break":"none","ruby":[[0,1,"むかし"],[9,2,"しゅうい"],[12,2,"まちまち"],[15,1,"とも"],[18,1,"ひと"],[20,1,"す"],[23,1,"さか"],[28,1,"とき"],[32,1,"みなみ"],[34,1,"ち"],[38,2,"へいや"],[43,1,"ひと"],[45,1,"す"],[50,1,"とき"],[56,3,"よげんしゃ"],[66,1,"しゅ"],[69,1,"つ"],[75,2,"ことば"],[83,1,"こと"]],"text":"昔エルサレムがその周囲の町々と共に、人が住み、栄えていた時、また南の地および平野にも、人が住んでいた時に、さきの預言者たちによって、主がお告げになった言葉は、これらの事ではなかったか」。"},{"ref":"Zech.7.8","start":38007008,"end":38007008,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[13,1,"のぞ"]],"text":"主の言葉が、またゼカリヤに臨んだ、"},{"ref":"Zech.7.9","start":38007009,"end":38007009,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[8,1,"おお"],[14,2,"しんじつ"],[21,1,"おこな"],[24,1,"たがい"],[26,1,"あい"],[33,1,"あい"]],"text":"「万軍の主はこう仰せられる、真実のさばきを行い、互に相いつくしみ、相あわれみ、"},{"ref":"Zech.7.10","start":38007010,"end":38007010,"break":"none","ruby":[[9,2,"きりゅう"],[12,2,"たこく"],[14,1,"じん"],[18,1,"まず"],[21,1,"ひと"],[35,1,"たがい"],[37,1,"ひと"],[39,1,"がい"],[46,1,"こころ"],[48,1,"はか"]],"text":"やもめ、みなしご、寄留の他国人および貧しい人を、しえたげてはならない。互に人を害することを、心に図ってはならない」。"},{"ref":"Zech.7.11","start":38007011,"end":38007011,"break":"none","ruby":[[5,1,"かれ"],[8,1,"き"],[13,1,"こば"],[16,1,"かた"],[24,1,"みみ"],[26,1,"にぶ"],[30,1,"き"]],"text":"ところが、彼らは聞くことを拒み、肩をそびやかし、耳を鈍くして聞きいれず、"},{"ref":"Zech.7.12","start":38007012,"end":38007012,"break":"none","ruby":[[2,1,"こころ"],[4,3,"こんごうせき"],[14,2,"ばんぐん"],[17,1,"しゅ"],[31,3,"よげんしゃ"],[38,1,"つた"],[44,2,"りっぽう"],[47,2,"ことば"],[51,1,"き"],[53,1,"したが"],[65,1,"おお"],[69,1,"いか"],[73,2,"ばんぐん"],[76,1,"しゅ"],[79,1,"で"],[82,1,"かれ"],[85,1,"のぞ"]],"text":"その心を金剛石のようにして、万軍の主がそのみたまにより、さきの預言者によって伝えられた、律法と言葉とに聞き従わなかった。それゆえ、大いなる怒りが、万軍の主から出て、彼らに臨んだのである。"},{"ref":"Zech.7.13","start":38007013,"end":38007013,"break":"none","ruby":[[5,1,"よ"],[15,1,"かれ"],[18,1,"き"],[35,1,"かれ"],[38,1,"よ"],[49,1,"き"],[55,2,"ばんぐん"],[58,1,"しゅ"],[60,1,"おお"]],"text":"「わたしが呼ばわったけれども、彼らは聞こうとしなかった。そのとおりに、彼らが呼ばわっても、わたしは聞かない」と万軍の主は仰せられる。"},{"ref":"Zech.7.14","start":38007014,"end":38007014,"break":"none","ruby":[[9,1,"かぜ"],[15,1,"かれ"],[18,2,"みち"],[26,2,"こくみん"],[29,1,"なか"],[31,1,"ち"],[40,1,"かれ"],[43,1,"さ"],[46,1,"のち"],[50,1,"ち"],[52,1,"あ"],[55,1,"い"],[57,1,"き"],[60,1,"もの"],[67,1,"うるわ"],[70,1,"ち"],[72,1,"あ"],[74,1,"ち"]],"text":"「わたしは、つむじ風をもって、彼らを未知のもろもろの国民の中に散らした。こうして彼らが去った後、この地は荒れて行き来する者もなく、この麗しい地は荒れ地となったのである」。"}]