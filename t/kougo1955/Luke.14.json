[{"ref":"Luke.14.1","start":42014001,"end":42014001,"break":"paragraph","ruby":[[2,3,"あんそくにち"],[9,2,"しょくじ"],[24,1,"は"],[30,1,"いえ"],[36,1,"い"],[42,2,"ひとびと"],[49,2,"ようす"]],"text":"ある安息日のこと、食事をするために、あるパリサイ派のかしらの家にはいって行かれたが、人々はイエスの様子をうかがっていた。"},{"ref":"Luke.14.2","start":42014002,"end":42014002,"break":"none","ruby":[[7,2,"すいしゅ"],[17,1,"ひと"]],"text":"するとそこに、水腫をわずらっている人が、みまえにいた。"},{"ref":"Luke.14.3","start":42014003,"end":42014003,"break":"none","ruby":[[4,2,"りっぽう"],[6,2,"がくしゃ"],[13,1,"びと"],[21,1,"い"],[27,3,"あんそくにち"],[31,1,"ひと"],[39,1,"ただ"]],"text":"イエスは律法学者やパリサイ人たちにむかって言われた、「安息日に人をいやすのは、正しいことかどうか」。"},{"ref":"Luke.14.4","start":42014004,"end":42014004,"break":"none","ruby":[[0,1,"かれ"],[3,1,"だま"],[18,1,"ひと"],[20,1,"て"],[22,1,"お"],[36,1,"かえ"]],"text":"彼らは黙っていた。そこでイエスはその人に手を置いていやしてやり、そしてお帰しになった。"},{"ref":"Luke.14.5","start":42014005,"end":42014005,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[23,2,"じぶん"],[30,1,"うし"],[32,2,"いど"],[35,1,"お"],[37,1,"こ"],[43,3,"あんそくにち"],[57,1,"ひ"],[59,1,"あ"],[66,1,"もの"]],"text":"それから彼らに言われた、「あなたがたのうちで、自分のむすこか牛が井戸に落ち込んだなら、安息日だからといって、すぐに引き上げてやらない者がいるだろうか」。"},{"ref":"Luke.14.6","start":42014006,"end":42014006,"break":"none","ruby":[[0,1,"かれ"],[6,1,"たい"],[9,1,"かえ"],[11,2,"ことば"]],"text":"彼らはこれに対して返す言葉がなかった。"},{"ref":"Luke.14.7","start":42014007,"end":42014007,"break":"paragraph","ruby":[[0,1,"きゃく"],[2,1,"まね"],[6,1,"もの"],[10,2,"じょうざ"],[13,1,"えら"],[18,2,"ようす"],[29,1,"かれ"],[35,1,"たとえ"],[37,1,"かた"]],"text":"客に招かれた者たちが上座を選んでいる様子をごらんになって、彼らに一つの譬を語られた。"},{"ref":"Luke.14.8","start":42014008,"end":42014008,"break":"none","ruby":[[1,1,"こん"],[2,1,"えん"],[4,1,"まね"],[13,2,"じょうざ"],[31,2,"みぶん"],[34,1,"たか"],[36,1,"ひと"],[38,1,"まね"],[46,1,"し"]],"text":"「婚宴に招かれたときには、上座につくな。あるいは、あなたよりも身分の高い人が招かれているかも知れない。"},{"ref":"Luke.14.9","start":42014009,"end":42014009,"break":"none","ruby":[[2,2,"ばあい"],[11,1,"ひと"],[14,1,"まね"],[17,1,"もの"],[28,1,"ざ"],[30,1,"ゆず"],[39,1,"い"],[55,1,"は"],[57,1,"い"],[60,2,"まつざ"]],"text":"その場合、あなたとその人とを招いた者がきて、『このかたに座を譲ってください』と言うであろう。そのとき、あなたは恥じ入って末座につくことになるであろう。"},{"ref":"Luke.14.10","start":42014010,"end":42014010,"break":"none","ruby":[[4,1,"まね"],[8,2,"ばあい"],[13,2,"まつざ"],[16,1,"い"],[32,1,"まね"],[38,1,"ひと"],[44,1,"とも"],[47,2,"じょうざ"],[50,1,"ほう"],[53,1,"すす"],[61,1,"い"],[77,1,"せき"],[79,1,"とも"],[87,1,"まえ"],[90,2,"めんぼく"]],"text":"むしろ、招かれた場合には、末座に行ってすわりなさい。そうすれば、招いてくれた人がきて、『友よ、上座の方へお進みください』と言うであろう。そのとき、あなたは席を共にするみんなの前で、面目をほどこすことになるであろう。"},{"ref":"Luke.14.11","start":42014011,"end":42014011,"break":"none","ruby":[[5,2,"じぶん"],[8,1,"たか"],[12,1,"もの"],[14,1,"ひく"],[19,2,"じぶん"],[22,1,"ひく"],[26,1,"もの"],[28,1,"たか"]],"text":"おおよそ、自分を高くする者は低くされ、自分を低くする者は高くされるであろう」。"},{"ref":"Luke.14.12","start":42014012,"end":42014012,"break":"paragraph","ruby":[[7,2,"じぶん"],[10,1,"まね"],[13,1,"ひと"],[15,1,"い"],[21,2,"ごさん"],[26,2,"ばんさん"],[29,1,"せき"],[31,1,"もう"],[34,2,"ばあい"],[39,2,"ゆうじん"],[42,2,"きょうだい"],[45,2,"しんぞく"],[48,2,"かねもち"],[51,1,"とな"],[53,1,"びと"],[57,1,"よ"],[64,1,"おそ"],[67,1,"かれ"],[74,1,"まね"],[87,2,"へんれい"],[90,1,"う"]],"text":"また、イエスは自分を招いた人に言われた、「午餐または晩餐の席を設ける場合には、友人、兄弟、親族、金持の隣り人などは呼ばぬがよい。恐らく彼らもあなたを招きかえし、それであなたは返礼を受けることになるから。"},{"ref":"Luke.14.13","start":42014013,"end":42014013,"break":"none","ruby":[[4,2,"えんかい"],[7,1,"もよお"],[9,2,"ばあい"],[14,3,"びんぼうにん"],[18,3,"ふぐしゃ"],[22,1,"あし"],[26,2,"もうじん"],[31,1,"まね"]],"text":"むしろ、宴会を催す場合には、貧乏人、不具者、足なえ、盲人などを招くがよい。"},{"ref":"Luke.14.14","start":42014014,"end":42014014,"break":"none","ruby":[[6,1,"かれ"],[9,2,"へんれい"],[35,1,"ただ"],[38,2,"ひとびと"],[41,2,"ふっかつ"],[44,1,"さい"],[52,1,"むく"]],"text":"そうすれば、彼らは返礼ができないから、あなたはさいわいになるであろう。正しい人々の復活の際には、あなたは報いられるであろう」。"},{"ref":"Luke.14.15","start":42014015,"end":42014015,"break":"paragraph","ruby":[[0,3,"れっせきしゃ"],[11,1,"き"],[19,1,"かみ"],[21,1,"くに"],[23,2,"しょくじ"],[28,1,"ひと"],[39,1,"い"]],"text":"列席者のひとりがこれを聞いてイエスに「神の国で食事をする人は、さいわいです」と言った。"},{"ref":"Luke.14.16","start":42014016,"end":42014016,"break":"none","ruby":[[7,1,"い"],[15,1,"ひと"],[17,2,"せいだい"],[20,2,"ばんさん"],[22,1,"かい"],[24,1,"もよお"],[28,1,"おお"],[32,1,"ひと"],[34,1,"まね"]],"text":"そこでイエスが言われた、「ある人が盛大な晩餐会を催して、大ぜいの人を招いた。"},{"ref":"Luke.14.17","start":42014017,"end":42014017,"break":"none","ruby":[[0,2,"ばんさん"],[3,2,"じこく"],[12,1,"まね"],[18,1,"ひと"],[25,1,"しもべ"],[27,1,"おく"],[45,2,"じゅんび"],[57,1,"い"]],"text":"晩餐の時刻になったので、招いておいた人たちのもとに僕を送って、『さあ、おいでください。もう準備ができましたから』と言わせた。"},{"ref":"Luke.14.18","start":42014018,"end":42014018,"break":"none","ruby":[[8,2,"いちよう"],[11,1,"ことわ"],[18,2,"さいしょ"],[21,1,"ひと"],[29,2,"とち"],[32,1,"か"],[40,1,"い"],[43,1,"み"],[68,1,"い"]],"text":"ところが、みんな一様に断りはじめた。最初の人は、『わたしは土地を買いましたので、行って見なければなりません。どうぞ、おゆるしください』と言った。"},{"ref":"Luke.14.19","start":42014019,"end":42014019,"break":"none","ruby":[[3,1,"ひと"],[12,1,"つい"],[14,1,"うし"],[16,1,"か"],[31,1,"い"]],"text":"ほかの人は、『わたしは五対の牛を買いましたので、それをしらべに行くところです。どうぞ、おゆるしください』、"},{"ref":"Luke.14.20","start":42014020,"end":42014020,"break":"none","ruby":[[6,1,"ひと"],[14,1,"つま"],[25,1,"まい"],[37,1,"い"]],"text":"もうひとりの人は、『わたしは妻をめとりましたので、参ることができません』と言った。"},{"ref":"Luke.14.21","start":42014021,"end":42014021,"break":"none","ruby":[[0,1,"しもべ"],[2,1,"かえ"],[8,2,"いじょう"],[11,1,"こと"],[13,2,"しゅじん"],[16,2,"ほうこく"],[24,1,"いえ"],[26,2,"しゅじん"],[33,1,"しもべ"],[35,1,"い"],[46,1,"まち"],[48,2,"おおどお"],[52,2,"こみち"],[55,1,"い"],[59,3,"びんぼうにん"],[63,3,"ふぐしゃ"],[67,2,"もうじん"],[70,1,"あし"],[80,1,"つ"]],"text":"僕は帰ってきて、以上の事を主人に報告した。すると家の主人はおこって僕に言った、『いますぐに、町の大通りや小道へ行って、貧乏人、不具者、盲人、足なえなどを、ここへ連れてきなさい』。"},{"ref":"Luke.14.22","start":42014022,"end":42014022,"break":"none","ruby":[[0,1,"しもべ"],[2,1,"い"],[8,3,"しゅじんさま"],[12,1,"おお"],[29,1,"せき"]],"text":"僕は言った、『ご主人様、仰せのとおりにいたしましたが、まだ席がございます』。"},{"ref":"Luke.14.23","start":42014023,"end":42014023,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"しもべ"],[5,1,"い"],[10,1,"みち"],[20,1,"で"],[22,1,"い"],[28,1,"いえ"],[41,2,"ひとびと"],[44,2,"むり"]],"text":"主人が僕に言った、『道やかきねのあたりに出て行って、この家がいっぱいになるように、人々を無理やりにひっぱってきなさい。"},{"ref":"Luke.14.24","start":42014024,"end":42014024,"break":"none","ruby":[[6,1,"い"],[9,1,"お"],[13,1,"まね"],[17,1,"ひと"],[24,2,"ばんさん"],[31,1,"もの"]],"text":"あなたがたに言って置くが、招かれた人で、わたしの晩餐にあずかる者はひとりもないであろう』」。"},{"ref":"Luke.14.25","start":42014025,"end":42014025,"break":"paragraph","ruby":[[0,1,"おお"],[4,2,"ぐんしゅう"],[19,1,"かれ"],[22,1,"ほう"],[24,1,"む"],[27,1,"い"]],"text":"大ぜいの群衆がついてきたので、イエスは彼らの方に向いて言われた、"},{"ref":"Luke.14.26","start":42014026,"end":42014026,"break":"none","ruby":[[6,1,"ちち"],[8,1,"はは"],[10,1,"つま"],[12,1,"こ"],[14,2,"きょうだい"],[17,2,"しまい"],[23,2,"じぶん"],[26,1,"いのち"],[30,1,"す"],[41,1,"く"],[54,2,"でし"]],"text":"「だれでも、父、母、妻、子、兄弟、姉妹、さらに自分の命までも捨てて、わたしのもとに来るのでなければ、わたしの弟子となることはできない。"},{"ref":"Luke.14.27","start":42014027,"end":42014027,"break":"none","ruby":[[0,2,"じぶん"],[3,3,"じゅうじか"],[7,1,"お"],[17,1,"く"],[31,2,"でし"]],"text":"自分の十字架を負うてわたしについて来るものでなければ、わたしの弟子となることはできない。"},{"ref":"Luke.14.28","start":42014028,"end":42014028,"break":"none","ruby":[[14,2,"ていたく"],[17,1,"た"],[22,1,"おも"],[30,2,"しあ"],[36,1,"た"],[42,1,"かね"],[44,1,"も"],[54,1,"み"],[68,2,"ひよう"],[71,2,"けいさん"]],"text":"あなたがたのうちで、だれかが邸宅を建てようと思うなら、それを仕上げるのに足りるだけの金を持っているかどうかを見るため、まず、すわってその費用を計算しないだろうか。"},{"ref":"Luke.14.29","start":42014029,"end":42014029,"break":"none","ruby":[[7,2,"どだい"],[16,2,"かんせい"],[27,1,"み"],[35,1,"ひと"]],"text":"そうしないと、土台をすえただけで完成することができず、見ているみんなの人が、"},{"ref":"Luke.14.30","start":42014030,"end":42014030,"break":"none","ruby":[[3,1,"ひと"],[5,1,"た"],[12,2,"しあ"],[24,1,"い"],[29,1,"わら"]],"text":"『あの人は建てかけたが、仕上げができなかった』と言ってあざ笑うようになろう。"},{"ref":"Luke.14.31","start":42014031,"end":42014031,"break":"none","ruby":[[6,1,"おう"],[13,1,"おう"],[15,1,"たたか"],[18,1,"まじ"],[24,1,"で"],[26,1,"い"],[28,2,"ばあい"],[35,1,"ざ"],[44,2,"まんにん"],[52,2,"まんにん"],[55,1,"ひき"],[58,1,"む"],[62,1,"く"],[64,1,"てき"],[66,2,"たいこう"],[76,1,"かんが"],[79,1,"み"]],"text":"また、どんな王でも、ほかの王と戦いを交えるために出て行く場合には、まず座して、こちらの一万人をもって、二万人を率いて向かって来る敵に対抗できるかどうか、考えて見ないだろうか。"},{"ref":"Luke.14.32","start":42014032,"end":42014032,"break":"none","ruby":[[2,2,"じぶん"],[5,1,"ちから"],[12,1,"てき"],[16,1,"とお"],[25,2,"ししゃ"],[28,1,"おく"],[32,1,"わ"],[34,1,"もと"]],"text":"もし自分の力にあまれば、敵がまだ遠くにいるうちに、使者を送って、和を求めるであろう。"},{"ref":"Luke.14.33","start":42014033,"end":42014033,"break":"none","ruby":[[3,1,"おな"],[19,2,"じぶん"],[22,2,"ざいさん"],[30,1,"す"],[32,1,"き"],[46,2,"でし"]],"text":"それと同じように、あなたがたのうちで、自分の財産をことごとく捨て切るものでなくては、わたしの弟子となることはできない。"},{"ref":"Luke.14.34","start":42014034,"end":42014034,"break":"none","ruby":[[0,1,"しお"],[2,1,"よ"],[12,1,"しお"],[25,1,"なに"],[30,2,"しおあじ"],[33,1,"と"]],"text":"塩は良いものだ。しかし、塩もききめがなくなったら、何によって塩味が取りもどされようか。"},{"ref":"Luke.14.35","start":42014035,"end":42014035,"break":"none","ruby":[[0,1,"つち"],[3,2,"ひりょう"],[7,1,"やく"],[8,1,"た"],[12,1,"そと"],[14,1,"な"],[16,1,"す"],[25,1,"き"],[27,1,"みみ"],[34,1,"き"]],"text":"土にも肥料にも役立たず、外に投げ捨てられてしまう。聞く耳のあるものは聞くがよい」。"}]