[{"ref":"Acts.14.1","start":44014001,"end":44014001,"break":"paragraph","ruby":[[12,1,"おな"],[20,1,"じん"],[22,2,"かいどう"],[29,1,"かた"],[32,2,"けっか"],[38,1,"じん"],[44,1,"じん"],[46,1,"おお"],[49,1,"しん"]],"text":"ふたりは、イコニオムでも同じようにユダヤ人の会堂にはいって語った結果、ユダヤ人やギリシヤ人が大ぜい信じた。"},{"ref":"Acts.14.2","start":44014002,"end":44014002,"break":"none","ruby":[[5,1,"しん"],[14,1,"じん"],[18,3,"いほうじん"],[31,2,"きょうだい"],[36,1,"たい"],[39,2,"あくい"]],"text":"ところが、信じなかったユダヤ人たちは異邦人たちをそそのかして、兄弟たちに対して悪意をいだかせた。"},{"ref":"Acts.14.3","start":44014003,"end":44014003,"break":"none","ruby":[[14,1,"なが"],[16,2,"きかん"],[22,1,"す"],[27,2,"だいたん"],[30,1,"しゅ"],[35,1,"かた"],[39,1,"しゅ"],[42,1,"かれ"],[45,1,"て"],[54,2,"きせき"],[58,1,"おこな"],[68,2,"ことば"]],"text":"それにもかかわらず、ふたりは長い期間をそこで過ごして、大胆に主のことを語った。主は、彼らの手によってしるしと奇跡とを行わせ、そのめぐみの言葉をあかしされた。"},{"ref":"Acts.14.4","start":44014004,"end":44014004,"break":"none","ruby":[[3,1,"まち"],[5,2,"ひとびと"],[9,1,"は"],[11,1,"わか"],[16,1,"ひと"],[23,1,"じん"],[25,1,"がわ"],[32,1,"ひと"],[36,2,"しと"],[39,1,"がわ"]],"text":"そこで町の人々が二派に分れ、ある人たちはユダヤ人の側につき、ある人たちは使徒の側についた。"},{"ref":"Acts.14.5","start":44014005,"end":44014005,"break":"none","ruby":[[2,1,"とき"],[4,3,"いほうじん"],[11,1,"じん"],[13,2,"やくにん"],[18,2,"いっしょ"],[24,2,"はんたい"],[26,2,"うんどう"],[29,1,"おこ"],[32,2,"しと"],[43,1,"いし"],[45,1,"う"]],"text":"その時、異邦人やユダヤ人が役人たちと一緒になって反対運動を起し、使徒たちをはずかしめ、石で打とうとしたので、"},{"ref":"Acts.14.6","start":44014006,"end":44014006,"break":"none","ruby":[[7,1,"き"],[18,2,"まちまち"],[34,2,"ふきん"],[37,1,"ち"]],"text":"ふたりはそれと気づいて、ルカオニヤの町々、ルステラ、デルベおよびその附近の地へのがれ、"},{"ref":"Acts.14.7","start":44014007,"end":44014007,"break":"none","ruby":[[3,1,"ひ"],[8,2,"ふくいん"],[11,1,"つた"]],"text":"そこで引きつづき福音を伝えた。"},{"ref":"Acts.14.8","start":44014008,"end":44014008,"break":"paragraph","ruby":[[10,1,"あし"],[16,1,"ひと"],[26,1,"かれ"],[28,1,"うま"],[34,1,"あし"],[39,1,"ある"],[42,2,"けいけん"],[45,1,"まった"]],"text":"ところが、ルステラに足のきかない人が、すわっていた。彼は生れながらの足なえで、歩いた経験が全くなかった。"},{"ref":"Acts.14.9","start":44014009,"end":44014009,"break":"none","ruby":[[2,1,"ひと"],[8,1,"かた"],[12,1,"き"],[23,1,"かれ"],[28,1,"み"],[39,2,"しんこう"],[42,1,"かれ"],[48,1,"みと"]],"text":"この人がパウロの語るのを聞いていたが、パウロは彼をじっと見て、いやされるほどの信仰が彼にあるのを認め、"},{"ref":"Acts.14.10","start":44014010,"end":44014010,"break":"none","ruby":[[0,2,"おおごえ"],[4,2,"じぶん"],[7,1,"あし"],[15,1,"た"],[22,1,"い"],[29,1,"かれ"],[31,1,"おど"],[33,1,"あ"],[37,1,"ある"],[39,1,"だ"]],"text":"大声で「自分の足で、まっすぐに立ちなさい」と言った。すると彼は踊り上がって歩き出した。"},{"ref":"Acts.14.11","start":44014011,"end":44014011,"break":"none","ruby":[[0,2,"ぐんしゅう"],[12,1,"み"],[15,1,"こえ"],[17,1,"は"],[28,2,"ちほう"],[30,1,"ご"],[34,2,"かみがみ"],[37,2,"にんげん"],[40,1,"すがた"],[57,1,"くだ"],[67,1,"さけ"]],"text":"群衆はパウロのしたことを見て、声を張りあげ、ルカオニヤの地方語で、「神々が人間の姿をとって、わたしたちのところにお下りになったのだ」と叫んだ。"},{"ref":"Acts.14.12","start":44014012,"end":44014012,"break":"none","ruby":[[0,1,"かれ"],[12,1,"よ"],[22,1,"かた"],[24,1,"ひと"],[29,1,"かれ"],[36,1,"よ"]],"text":"彼らはバルナバをゼウスと呼び、パウロはおもに語る人なので、彼をヘルメスと呼んだ。"},{"ref":"Acts.14.13","start":44014013,"end":44014013,"break":"none","ruby":[[4,2,"こうがい"],[12,2,"しんでん"],[15,2,"さいし"],[19,2,"ぐんしゅう"],[22,1,"とも"],[29,2,"ぎせい"],[38,1,"おも"],[42,1,"お"],[43,1,"うし"],[44,2,"すうとう"],[47,2,"はなわ"],[51,2,"もんぜん"],[54,1,"も"]],"text":"そして、郊外にあるゼウス神殿の祭司が、群衆と共に、ふたりに犠牲をささげようと思って、雄牛数頭と花輪とを門前に持ってきた。"},{"ref":"Acts.14.14","start":44014014,"end":44014014,"break":"none","ruby":[[4,2,"しと"],[20,1,"き"],[23,2,"じぶん"],[26,2,"うわぎ"],[29,1,"ひ"],[31,1,"さ"],[34,2,"ぐんしゅう"],[37,1,"なか"],[39,1,"と"],[41,1,"こ"],[44,1,"い"],[47,1,"さけ"]],"text":"ふたりの使徒バルナバとパウロとは、これを聞いて自分の上着を引き裂き、群衆の中に飛び込んで行き、叫んで"},{"ref":"Acts.14.15","start":44014015,"end":44014015,"break":"none","ruby":[[0,1,"い"],[5,1,"みな"],[14,1,"こと"],[36,1,"おな"],[41,2,"にんげん"],[62,1,"ぐ"],[71,1,"す"],[75,1,"てん"],[77,1,"ち"],[79,1,"うみ"],[84,1,"なか"],[94,1,"つく"],[100,1,"い"],[103,1,"かみ"],[105,1,"た"],[107,1,"かえ"],[114,2,"ふくいん"],[117,1,"と"]],"text":"言った、「皆さん、なぜこんな事をするのか。わたしたちとても、あなたがたと同じような人間である。そして、あなたがたがこのような愚にもつかぬものを捨てて、天と地と海と、その中のすべてのものをお造りになった生ける神に立ち帰るようにと、福音を説いているものである。"},{"ref":"Acts.14.16","start":44014016,"end":44014016,"break":"none","ruby":[[0,1,"かみ"],[2,1,"す"],[4,1,"さ"],[7,2,"じだい"],[16,2,"くにぐに"],[19,1,"ひと"],[27,1,"みち"],[29,1,"い"]],"text":"神は過ぎ去った時代には、すべての国々の人が、それぞれの道を行くままにしておかれたが、"},{"ref":"Acts.14.17","start":44014017,"end":44014017,"break":"none","ruby":[[6,2,"じぶん"],[44,1,"てん"],[47,1,"あめ"],[49,1,"ふ"],[53,1,"みの"],[56,2,"きせつ"],[59,1,"あた"],[62,2,"しょくもつ"],[65,1,"よろこ"],[76,1,"こころ"],[78,1,"み"],[94,1,"あた"]],"text":"それでも、ご自分のことをあかししないでおられたわけではない。すなわち、あなたがたのために天から雨を降らせ、実りの季節を与え、食物と喜びとで、あなたがたの心を満たすなど、いろいろのめぐみをお与えになっているのである」。"},{"ref":"Acts.14.18","start":44014018,"end":44014018,"break":"none","ruby":[[2,1,"い"],[19,2,"ぐんしゅう"],[22,2,"じぶん"],[27,2,"ぎせい"],[37,1,"おも"],[39,1,"とど"]],"text":"こう言って、ふたりは、やっとのことで、群衆が自分たちに犠牲をささげるのを、思い止まらせた。"},{"ref":"Acts.14.19","start":44014019,"end":44014019,"break":"paragraph","ruby":[[10,1,"じん"],[27,1,"お"],[35,2,"ぐんしゅう"],[38,2,"なかま"],[41,1,"ひ"],[43,1,"い"],[53,1,"いし"],[55,1,"う"],[58,1,"し"],[66,1,"おも"],[70,1,"かれ"],[72,1,"まち"],[74,1,"そと"],[76,1,"ひ"],[80,1,"だ"]],"text":"ところが、あるユダヤ人たちはアンテオケやイコニオムから押しかけてきて、群衆を仲間に引き入れたうえ、パウロを石で打ち、死んでしまったと思って、彼を町の外に引きずり出した。"},{"ref":"Acts.14.20","start":44014020,"end":44014020,"break":"none","ruby":[[4,2,"でし"],[13,1,"と"],[15,1,"かこ"],[20,1,"あいだ"],[23,1,"かれ"],[25,1,"お"],[31,1,"まち"],[37,1,"い"],[44,2,"よくじつ"],[54,2,"いっしょ"],[65,1,"で"]],"text":"しかし、弟子たちがパウロを取り囲んでいる間に、彼は起きあがって町にはいって行った。そして翌日には、バルナバと一緒にデルベにむかって出かけた。"},{"ref":"Acts.14.21","start":44014021,"end":44014021,"break":"none","ruby":[[2,1,"まち"],[4,2,"ふくいん"],[7,1,"つた"],[11,1,"おお"],[15,1,"ひと"],[17,2,"でし"],[22,1,"のち"],[41,2,"まちまち"],[44,1,"かえ"],[47,1,"い"]],"text":"その町で福音を伝えて、大ぜいの人を弟子とした後、ルステラ、イコニオム、アンテオケの町々に帰って行き、"},{"ref":"Acts.14.22","start":44014022,"end":44014022,"break":"none","ruby":[[0,2,"でし"],[5,1,"ちから"],[9,2,"しんこう"],[12,1,"も"],[22,2,"しょうれい"],[33,1,"かみ"],[35,1,"くに"],[44,1,"おお"],[47,2,"くなん"],[50,1,"へ"],[61,1,"かた"]],"text":"弟子たちを力づけ、信仰を持ちつづけるようにと奨励し、「わたしたちが神の国にはいるのには、多くの苦難を経なければならない」と語った。"},{"ref":"Acts.14.23","start":44014023,"end":44014023,"break":"none","ruby":[[2,2,"きょうかい"],[7,1,"かれ"],[13,2,"ちょうろう"],[18,2,"にんめい"],[22,2,"だんじき"],[27,1,"いの"],[30,1,"かれ"],[35,1,"しん"],[40,1,"しゅ"]],"text":"また教会ごとに彼らのために長老たちを任命し、断食をして祈り、彼らをその信じている主にゆだねた。"},{"ref":"Acts.14.24","start":44014024,"end":44014024,"break":"paragraph","ruby":[[14,2,"つうか"]],"text":"それから、ふたりはピシデヤを通過してパンフリヤにきたが、"},{"ref":"Acts.14.25","start":44014025,"end":44014025,"break":"none","ruby":[[4,2,"みことば"],[7,1,"かた"],[10,1,"のち"]],"text":"ペルガで御言を語った後、アタリヤにくだり、"},{"ref":"Acts.14.26","start":44014026,"end":44014026,"break":"none","ruby":[[4,1,"ふね"],[12,1,"かえ"],[16,1,"かれ"],[19,1,"いま"],[22,1,"おわ"],[25,1,"はたら"],[32,1,"かみ"],[34,2,"しゅくふく"],[37,1,"う"],[40,1,"おく"],[42,1,"だ"]],"text":"そこから舟でアンテオケに帰った。彼らが今なし終った働きのために、神の祝福を受けて送り出されたのは、このアンテオケからであった。"},{"ref":"Acts.14.27","start":44014027,"end":44014027,"break":"none","ruby":[[0,1,"かれ"],[3,2,"とうちゃく"],[5,2,"そうそう"],[8,2,"きょうかい"],[11,2,"ひとびと"],[14,1,"よ"],[16,1,"あつ"],[20,1,"かみ"],[22,1,"かれ"],[25,1,"とも"],[31,1,"くだ"],[35,2,"かずかず"],[43,2,"しんこう"],[46,1,"もん"],[48,3,"いほうじん"],[52,1,"ひら"],[55,1,"くだ"],[65,2,"ほうこく"]],"text":"彼らは到着早々、教会の人々を呼び集めて、神が彼らと共にいてして下さった数々のこと、また信仰の門を異邦人に開いて下さったことなどを、報告した。"},{"ref":"Acts.14.28","start":44014028,"end":44014028,"break":"none","ruby":[[13,1,"あいだ"],[15,2,"でし"],[20,2,"いっしょ"],[23,1,"す"]],"text":"そして、ふたりはしばらくの間、弟子たちと一緒に過ごした。"}]