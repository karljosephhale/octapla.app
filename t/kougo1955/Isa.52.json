[{"ref":"Isa.52.1","start":23052001,"end":23052001,"break":"paragraph","breaks":[[13,"line"],[18,"line"],[37,"line"],[54,"line"]],"ruby":[[13,1,"ちから"],[15,1,"き"],[18,1,"せい"],[21,1,"みやこ"],[29,1,"うつく"],[32,1,"ころも"],[34,1,"き"],[37,2,"かつれい"],[40,1,"う"],[44,1,"もの"],[48,1,"けが"],[51,1,"もの"]],"text":"シオンよ、さめよ、さめよ、力を着よ。聖なる都エルサレムよ、美しい衣を着よ。割礼を受けない者および汚れた者は、もはやあなたのところに、はいることがないからだ。"},{"ref":"Isa.52.2","start":23052002,"end":23052002,"break":"line","breaks":[[11,"line"],[30,"line"],[41,"line"]],"ruby":[[0,1,"とら"],[15,1,"み"],[21,1,"ふ"],[23,1,"おと"],[26,1,"お"],[30,1,"とら"],[38,1,"むすめ"],[45,1,"くび"],[50,1,"と"]],"text":"捕われたエルサレムよ、あなたの身からちりを振り落せ、起きよ。捕われたシオンの娘よ、あなたの首のなわを解きすてよ。"},{"ref":"Isa.52.3","start":23052003,"end":23052003,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"い"],[20,1,"う"],[25,1,"かね"],[27,1,"だ"]],"text":"主はこう言われる、「あなたがたは、ただで売られた。金を出さずにあがなわれる」。"},{"ref":"Isa.52.4","start":23052004,"end":23052004,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[15,1,"たみ"],[25,1,"くだ"],[28,1,"い"],[36,2,"きりゅう"],[55,1,"かれ"]],"text":"主なる神はこう言われる、「わが民はさきにエジプトへ下って行って、かしこに寄留した。またアッスリヤびとはゆえなく彼らをしえたげた。"},{"ref":"Isa.52.5","start":23052005,"end":23052005,"break":"none","ruby":[[5,1,"いま"],[13,1,"なに"],[22,1,"たみ"],[28,1,"とら"],[34,1,"しゅ"],[36,1,"い"],[41,1,"しゅ"],[43,1,"い"],[49,1,"かれ"],[57,1,"もの"],[65,1,"な"],[67,1,"つね"],[73,1,"あなど"]],"text":"それゆえ、今わたしはここに何をしようか。わが民はゆえなく捕われた」と主は言われる。主は言われる、「彼らをつかさどる者はわめき、わが名は常にひねもす侮られる。"},{"ref":"Isa.52.6","start":23052006,"end":23052006,"break":"none","ruby":[[7,1,"たみ"],[11,1,"な"],[13,1,"し"],[22,1,"ひ"],[25,1,"かれ"],[30,2,"ことば"],[33,1,"かた"],[35,1,"もの"],[46,1,"し"]],"text":"それゆえ、わが民はわが名を知るにいたる。その日には彼らはこの言葉を語る者がわたしであることを知る。わたしはここにおる」。"},{"ref":"Isa.52.7","start":23052007,"end":23052007,"break":"stanza","breaks":[[16,"line"],[31,"line"],[54,"line"],[68,"line"]],"ruby":[[7,1,"つた"],[10,2,"へいわ"],[13,1,"つ"],[23,1,"つた"],[26,1,"すくい"],[28,1,"つ"],[44,1,"かみ"],[46,1,"おう"],[54,1,"い"],[56,1,"もの"],[58,1,"あし"],[60,1,"やま"],[62,1,"うえ"],[71,1,"うるわ"]],"text":"よきおとずれを伝え、平和を告げ、よきおとずれを伝え、救を告げ、シオンにむかって「あなたの神は王となられた」と言う者の足は山の上にあって、なんと麗しいことだろう。"},{"ref":"Isa.52.8","start":23052008,"end":23052008,"break":"line","breaks":[[19,"line"],[29,"line"],[42,"line"]],"ruby":[[0,1,"き"],[8,2,"みはり"],[13,1,"こえ"],[19,1,"とも"],[21,1,"よろこ"],[23,1,"うた"],[29,1,"かれ"],[32,1,"め"],[34,1,"め"],[36,1,"あい"],[37,1,"あ"],[42,1,"しゅ"],[48,1,"かえ"],[54,1,"み"]],"text":"聞けよ、あなたの見張びとは声をあげて、共に喜び歌っている。彼らは目と目と相合わせて、主がシオンに帰られるのを見るからだ。"},{"ref":"Isa.52.9","start":23052009,"end":23052009,"break":"line","breaks":[[15,"line"],[25,"line"],[34,"line"]],"ruby":[[6,1,"あ"],[12,1,"ところ"],[15,1,"こえ"],[17,1,"はな"],[20,1,"とも"],[22,1,"うた"],[25,1,"しゅ"],[29,1,"たみ"],[31,1,"なぐさ"]],"text":"エルサレムの荒れすたれた所よ、声を放って共に歌え。主はその民を慰め、エルサレムをあがなわれたからだ。"},{"ref":"Isa.52.10","start":23052010,"end":23052010,"break":"line","breaks":[[12,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"せい"],[17,1,"くに"],[21,1,"まえ"],[30,1,"ち"],[36,1,"はて"],[44,1,"かみ"],[46,1,"すくい"],[48,1,"み"]],"text":"主はその聖なるかいなを、もろもろの国びとの前にあらわされた。地のすべての果は、われわれの神の救を見る。"},{"ref":"Isa.52.11","start":23052011,"end":23052011,"break":"paragraph","breaks":[[14,"line"],[24,"line"],[41,"line"]],"ruby":[[0,1,"さ"],[4,1,"さ"],[11,1,"で"],[14,1,"けが"],[17,1,"もの"],[26,1,"なか"],[28,1,"で"],[31,1,"しゅ"],[33,1,"うつわ"],[38,1,"もの"],[45,1,"きよ"],[47,1,"たも"]],"text":"去れよ、去れよ、そこを出て、汚れた物にさわるな。その中を出よ、主の器をになう者よ、おのれを清く保て。"},{"ref":"Isa.52.12","start":23052012,"end":23052012,"break":"line","breaks":[[17,"line"],[32,"line"],[45,"line"],[59,"line"]],"ruby":[[6,1,"いそ"],[9,1,"で"],[12,1,"およ"],[23,1,"い"],[27,1,"およ"],[32,1,"しゅ"],[40,1,"まえ"],[42,1,"い"],[51,1,"かみ"]],"text":"あなたがたは急いで出るに及ばない、また、とんで行くにも及ばない。主はあなたがたの前に行き、イスラエルの神はあなたがたのしんがりとなられるからだ。"},{"ref":"Isa.52.13","start":23052013,"end":23052013,"break":"paragraph","breaks":[[13,"line"]],"ruby":[[0,1,"み"],[9,1,"さか"],[13,1,"かれ"],[15,1,"たか"],[30,1,"たか"]],"text":"見よ、わがしもべは栄える。彼は高められ、あげられ、ひじょうに高くなる。"},{"ref":"Isa.52.14","start":23052014,"end":23052014,"break":"line","breaks":[[15,"line"],[34,"line"]],"ruby":[[0,1,"おお"],[3,1,"ひと"],[5,1,"かれ"],[7,1,"おどろ"],[15,1,"かれ"],[17,1,"かお"],[28,1,"ひと"],[30,1,"こと"],[36,1,"すがた"],[38,1,"ひと"],[40,1,"こ"],[42,1,"こと"]],"text":"多くの人が彼に驚いたように――彼の顔だちは、そこなわれて人と異なり、その姿は人の子と異なっていたからである――"},{"ref":"Isa.52.15","start":23052015,"end":23052015,"break":"line","breaks":[[12,"line"],[27,"line"],[48,"line"]],"ruby":[[0,1,"かれ"],[2,1,"おお"],[5,2,"こくみん"],[8,1,"おどろ"],[12,1,"おう"],[16,1,"かれ"],[21,1,"くち"],[30,1,"かれ"],[35,1,"つた"],[46,1,"み"],[50,1,"き"],[59,1,"さと"]],"text":"彼は多くの国民を驚かす。王たちは彼のゆえに口をつむぐ。それは彼らがまだ伝えられなかったことを見、まだ聞かなかったことを悟るからだ。"}]