[{"ref":"Josh.2.1","start":6002001,"end":6002001,"break":"paragraph","ruby":[[3,1,"こ"],[25,2,"せっこう"],[33,1,"かれ"],[36,1,"い"],[41,1,"い"],[47,1,"ち"],[49,1,"とく"],[55,1,"さぐ"],[62,1,"かれ"],[65,1,"い"],[69,1,"な"],[77,2,"ゆうじょ"],[80,1,"いえ"],[89,1,"と"]],"text":"ヌンの子ヨシュアは、シッテムから、ひそかにふたりの斥候をつかわして彼らに言った、「行って、その地、特にエリコを探りなさい」。彼らは行って、名をラハブという遊女の家にはいり、そこに泊まったが、"},{"ref":"Josh.2.2","start":6002002,"end":6002002,"break":"none","ruby":[[4,1,"おう"],[14,2,"ひとびと"],[20,1,"すう"],[21,1,"めい"],[23,1,"もの"],[25,2,"こんや"],[29,1,"ち"],[31,1,"さぐ"],[47,1,"い"],[49,1,"もの"]],"text":"エリコの王に、「イスラエルの人々のうちの数名の者が今夜この地を探るために、はいってきました」と言う者があったので、"},{"ref":"Josh.2.3","start":6002003,"end":6002003,"break":"none","ruby":[[4,1,"おう"],[6,1,"ひと"],[15,1,"い"],[24,1,"ところ"],[33,1,"いえ"],[39,2,"ひとびと"],[45,1,"だ"],[51,1,"かれ"],[56,1,"くに"],[62,1,"さぐ"]],"text":"エリコの王は人をやってラハブに言った、「あなたの所にきて、あなたの家にはいった人々をここへ出しなさい。彼らはこの国のすべてを探るためにきたのです」。"},{"ref":"Josh.2.4","start":6002004,"end":6002004,"break":"none","ruby":[[4,1,"おんな"],[15,1,"ひと"],[17,1,"い"],[20,1,"かれ"],[23,1,"かく"],[32,2,"かのじょ"],[35,1,"い"],[40,1,"たし"],[45,2,"ひとびと"],[52,1,"ところ"],[69,2,"ひとびと"],[80,1,"し"]],"text":"しかし、女はすでにそのふたりの人を入れて彼らを隠していた。そして彼女は言った、「確かにその人々はわたしの所にきました。しかし、わたしはその人々がどこからきたのか知りませんでしたが、"},{"ref":"Josh.2.5","start":6002005,"end":6002005,"break":"none","ruby":[[4,1,"とき"],[6,1,"もん"],[8,1,"と"],[17,2,"ひとびと"],[20,1,"で"],[22,1,"い"],[31,1,"い"],[40,1,"し"],[46,1,"いそ"],[52,1,"お"],[58,1,"お"]],"text":"たそがれ時、門の閉じるころに、その人々は出て行きました。どこへ行ったのかわたしは知りません。急いであとを追いなさい。追いつけるでしょう」。"},{"ref":"Josh.2.6","start":6002006,"end":6002006,"break":"none","ruby":[[2,1,"じつ"],[4,2,"かのじょ"],[10,1,"かれ"],[13,1,"つ"],[16,2,"やね"],[23,2,"おくじょう"],[26,1,"なら"],[32,2,"あま"],[35,1,"くき"],[37,1,"なか"],[39,1,"かれ"],[42,1,"かく"]],"text":"その実、彼女はすでに彼らを連れて屋根にのぼり、屋上に並べてあった亜麻の茎の中に彼らを隠していたのである。"},{"ref":"Josh.2.7","start":6002007,"end":6002007,"break":"none","ruby":[[5,2,"ひとびと"],[8,1,"かれ"],[14,1,"お"],[22,1,"みち"],[24,1,"すす"],[27,1,"わた"],[29,1,"ば"],[31,1,"む"],[39,1,"お"],[41,1,"もの"],[43,1,"で"],[45,1,"い"],[50,1,"もん"],[52,1,"と"]],"text":"そこでその人々は彼らのあとを追ってヨルダンの道を進み、渡し場へ向かった。あとを追う者が出て行くとすぐ門は閉ざされた。"},{"ref":"Josh.2.8","start":6002008,"end":6002008,"break":"paragraph","ruby":[[4,1,"ひと"],[8,1,"ね"],[18,2,"おくじょう"],[25,1,"かれ"],[28,1,"ところ"]],"text":"ふたりの人がまだ寝ないうち、ラハブは屋上にのぼって彼らの所にきた。"},{"ref":"Josh.2.9","start":6002009,"end":6002009,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[11,1,"しゅ"],[15,1,"ち"],[23,1,"たま"],[47,1,"おそ"],[60,1,"ち"],[62,1,"たみ"],[72,1,"まえ"],[74,1,"ふる"],[90,1,"し"]],"text":"そして彼らに言った、「主がこの地をあなたがたに賜わったこと、わたしたちがあなたがたをひじょうに恐れていること、そしてこの地の民がみなあなたがたの前に震えおののいていることをわたしは知っています。"},{"ref":"Josh.2.10","start":6002010,"end":6002010,"break":"none","ruby":[[12,1,"で"],[18,1,"とき"],[20,1,"しゅ"],[28,1,"まえ"],[30,2,"こうかい"],[33,1,"みず"],[35,1,"ほ"],[57,1,"む"],[60,1,"がわ"],[74,1,"おう"],[97,2,"ぜんめつ"],[112,1,"き"]],"text":"あなたがたがエジプトから出てこられた時、主があなたがたの前で紅海の水を干されたこと、およびあなたがたが、ヨルダンの向こう側にいたアモリびとのふたりの王シホンとオグにされたこと、すなわちふたりを、全滅されたことを、わたしたちは聞いたからです。"},{"ref":"Josh.2.11","start":6002011,"end":6002011,"break":"none","ruby":[[9,1,"き"],[13,1,"こころ"],[15,1,"き"],[27,2,"ひとびと"],[30,1,"まった"],[32,2,"ゆうき"],[35,1,"うしな"],[51,1,"かみ"],[53,1,"しゅ"],[55,1,"うえ"],[57,1,"てん"],[61,1,"した"],[63,1,"ち"],[67,1,"かみ"]],"text":"わたしたちはそれを聞くと、心は消え、あなたがたのゆえに人々は全く勇気を失ってしまいました。あなたがたの神、主は上の天にも、下の地にも、神でいらせられるからです。"},{"ref":"Josh.2.12","start":6002012,"end":6002012,"break":"none","ruby":[[18,2,"しんせつ"],[21,1,"あつか"],[39,1,"ちち"],[41,1,"いえ"],[43,2,"しんせつ"],[46,1,"あつか"],[55,1,"しゅ"],[60,1,"ちか"],[63,1,"たし"]],"text":"それで、どうか、わたしがあなたがたを親切に扱ったように、あなたがたも、わたしの父の家を親切に扱われることをいま主をさして誓い、確かなしるしをください。"},{"ref":"Josh.2.13","start":6002013,"end":6002013,"break":"none","ruby":[[7,2,"ふぼ"],[10,2,"きょうだい"],[13,2,"しまい"],[21,1,"かれ"],[24,1,"ぞく"],[30,1,"い"],[45,1,"いのち"],[47,1,"すく"],[51,1,"し"],[53,1,"まぬか"]],"text":"そしてわたしの父母、兄弟、姉妹およびすべて彼らに属するものを生きながらえさせ、わたしたちの命を救って、死を免れさせてください」。"},{"ref":"Josh.2.14","start":6002014,"end":6002014,"break":"none","ruby":[[4,1,"ひと"],[6,2,"かのじょ"],[9,1,"い"],[33,1,"た"],[35,1,"も"],[49,1,"いのち"],[61,1,"すく"],[68,1,"しゅ"],[77,1,"ち"],[79,1,"たま"],[82,1,"とき"],[90,2,"しんせつ"],[93,1,"あつか"],[96,2,"しんじつ"]],"text":"ふたりの人は彼女に言った、「もしあなたがたが、われわれのこのことを他に漏らさないならば、われわれは命にかけて、あなたがたを救います。また主がわれわれにこの地を賜わる時、あなたがたを親切に扱い、真実をつくしましょう」。"},{"ref":"Josh.2.15","start":6002015,"end":6002015,"break":"paragraph","ruby":[[7,1,"つな"],[12,1,"かれ"],[15,1,"まど"],[27,1,"いえ"],[29,1,"まち"],[31,2,"じょうへき"],[34,1,"うえ"],[36,1,"た"],[42,2,"かのじょ"],[47,2,"じょうへき"],[50,1,"うえ"],[52,1,"す"]],"text":"そこでラハブは綱をもって彼らを窓からつりおろした。その家が町の城壁の上に建っていて、彼女はその城壁の上に住んでいたからである。"},{"ref":"Josh.2.16","start":6002016,"end":6002016,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[12,2,"おって"],[15,1,"あ"],[29,1,"やま"],[31,1,"い"],[36,1,"か"],[38,1,"あいだ"],[42,1,"み"],[44,1,"かく"],[47,2,"おって"],[50,1,"かえ"],[53,1,"い"],[57,1,"ま"],[65,1,"さ"],[68,1,"い"]],"text":"ラハブは彼らに言った、「追手に会わないように、あなたがたは山へ行って、三日の間そこに身を隠し、追手の帰って行くのを待って、それから去って行きなさい」。"},{"ref":"Josh.2.17","start":6002017,"end":6002017,"break":"none","ruby":[[4,1,"ひと"],[6,2,"かのじょ"],[9,1,"い"],[23,1,"ちか"],[29,1,"ちか"],[41,1,"つみ"],[43,1,"おか"]],"text":"ふたりの人は彼女に言った、「あなたがわれわれに誓わせたこの誓いについて、われわれは罪を犯しません。"},{"ref":"Josh.2.18","start":6002018,"end":6002018,"break":"none","ruby":[[7,1,"ち"],[9,1,"う"],[11,1,"い"],[13,1,"とき"],[27,1,"まど"],[32,1,"あか"],[34,1,"いと"],[39,1,"むす"],[50,2,"ふぼ"],[53,2,"きょうだい"],[63,1,"ちち"],[65,2,"かぞく"],[74,1,"いえ"],[76,1,"あつ"]],"text":"われわれがこの地に討ち入る時、わたしたちをつりおろした窓に、この赤い糸のひもを結びつけ、またあなたの父母、兄弟、およびあなたの父の家族をみなあなたの家に集めなさい。"},{"ref":"Josh.2.19","start":6002019,"end":6002019,"break":"none","ruby":[[5,1,"いえ"],[7,2,"とぐち"],[11,1,"そと"],[13,1,"で"],[16,1,"ち"],[18,1,"なが"],[31,1,"せ"],[36,1,"ひと"],[37,2,"じしん"],[44,1,"き"],[56,1,"つみ"],[71,1,"いえ"],[73,1,"なか"],[77,1,"ひと"],[79,1,"て"],[84,1,"ち"],[86,1,"なが"],[97,1,"せ"],[109,1,"き"]],"text":"ひとりでも家の戸口から外へ出て、血を流されることがあれば、その責めはその人自身のこうべに帰すでしょう。われわれに罪はありません。しかしあなたの家の中にいる人に手をかけて血を流すことがあれば、その責めはわれわれのこうべに帰すでしょう。"},{"ref":"Josh.2.20","start":6002020,"end":6002020,"break":"none","ruby":[[17,1,"た"],[19,1,"も"],[35,1,"ちか"],[39,1,"ちか"],[52,1,"つみ"]],"text":"またあなたが、われわれのこのことを他に漏らすならば、あなたがわれわれに誓わせた誓いについては、われわれに罪はありません」。"},{"ref":"Josh.2.21","start":6002021,"end":6002021,"break":"none","ruby":[[4,1,"い"],[15,1,"おお"],[35,1,"かれ"],[38,1,"おく"],[40,1,"だ"],[46,1,"かれ"],[49,1,"さ"],[56,2,"かのじょ"],[59,1,"あか"],[64,1,"まど"],[66,1,"むす"]],"text":"ラハブは言った、「あなたがたの仰せのとおりにいたしましょう」。こうして彼らを送り出したので、彼らは去った。そして彼女は赤いひもを窓に結んだ。"},{"ref":"Josh.2.22","start":6002022,"end":6002022,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"た"],[5,1,"さ"],[8,1,"やま"],[14,2,"おって"],[17,1,"かえ"],[21,1,"ま"],[26,1,"か"],[28,1,"あいだ"],[38,2,"おって"],[41,1,"かれ"],[48,1,"みち"],[50,1,"さが"],[58,1,"み"]],"text":"彼らは立ち去って山にはいり、追手が帰るのを待って、三日の間そこにとどまった。追手は彼らをあまねく道に捜したが、ついに見つけることができなかった。"},{"ref":"Josh.2.23","start":6002023,"end":6002023,"break":"none","ruby":[[8,1,"ひと"],[12,1,"やま"],[14,1,"くだ"],[17,1,"かわ"],[19,1,"わた"],[26,1,"こ"],[40,1,"み"],[42,1,"た"],[52,1,"の"]],"text":"こうしてふたりの人はまた山を下り、川を渡って、ヌンの子ヨシュアのもとにきて、その身に起ったことをつぶさに述べた。"},{"ref":"Josh.2.24","start":6002024,"end":6002024,"break":"none","ruby":[[8,1,"い"],[18,1,"しゅ"],[22,1,"くに"],[34,1,"て"],[37,1,"あた"],[48,1,"くに"],[50,2,"じゅうみん"],[60,1,"まえ"],[62,1,"ふる"]],"text":"そしてヨシュアに言った、「ほんとうに主はこの国をことごとくわれわれの手にお与えになりました。この国の住民はみなわれわれの前に震えおののいています」。"}]