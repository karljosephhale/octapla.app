[{"ref":"Ps.109.1","start":19109001,"end":19109001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","ruby":[[10,1,"かみ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"わたしのほめたたえる神よ、もださないでください。"},{"ref":"Ps.109.2","start":19109002,"end":19109002,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あ"],[6,1,"くち"],[8,1,"あざむ"],[11,1,"くち"],[25,1,"いつわ"],[28,1,"した"],[37,1,"かた"]],"text":"彼らは悪しき口と欺きの口をあけて、わたしにむかい、偽りの舌をもってわたしに語り、"},{"ref":"Ps.109.3","start":19109003,"end":19109003,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"うら"],[3,2,"ことば"],[13,1,"かこ"],[24,1,"せ"]],"text":"恨みの言葉をもってわたしを囲み、ゆえなくわたしを攻めるのです。"},{"ref":"Ps.109.4","start":19109004,"end":19109004,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[5,1,"あい"],[16,2,"ひなん"],[29,1,"かれ"],[35,1,"いの"]],"text":"彼らはわが愛にむくいて、わたしを非難します。しかしわたしは彼らのために祈ります。"},{"ref":"Ps.109.5","start":19109005,"end":19109005,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あく"],[10,1,"ぜん"],[12,1,"むく"],[15,1,"うら"],[23,1,"あい"],[25,1,"むく"]],"text":"彼らは悪をもってわが善に報い、恨みをもってわが愛に報いるのです。"},{"ref":"Ps.109.6","start":19109006,"end":19109006,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[2,1,"うえ"],[4,1,"あ"],[7,1,"ひと"],[9,1,"た"],[12,1,"うった"],[15,1,"もの"],[17,1,"かれ"],[19,1,"うった"]],"text":"彼の上に悪しき人を立て、訴える者に彼を訴えさせてください。"},{"ref":"Ps.109.7","start":19109007,"end":19109007,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[10,1,"かれ"],[12,1,"つみ"],[15,1,"もの"],[21,1,"いのり"],[23,1,"つみ"],[25,1,"か"]],"text":"彼がさばかれるとき、彼を罪ある者とし、その祈を罪に変えてください。"},{"ref":"Ps.109.8","start":19109008,"end":19109008,"break":"line","breaks":[[9,"line"]],"ruby":[[2,1,"ひ"],[4,1,"すく"],[11,2,"ざいさん"],[17,1,"ひと"]],"text":"その日を少なくし、その財産をほかの人にとらせ、"},{"ref":"Ps.109.9","start":19109009,"end":19109009,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"こ"],[14,1,"つま"]],"text":"その子らをみなしごにし、その妻をやもめにしてください。"},{"ref":"Ps.109.10","start":19109010,"end":19109010,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"こ"],[5,3,"ほうろうしゃ"],[11,1,"ほどこ"],[20,1,"あ"],[28,1,"お"],[30,1,"だ"]],"text":"その子らを放浪者として施しをこわせ、その荒れたすまいから追い出させてください。"},{"ref":"Ps.109.11","start":19109011,"end":19109011,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[2,1,"も"],[11,1,"もの"],[13,1,"さい"],[14,1,"しゅ"],[16,1,"うば"],[22,2,"きんろう"],[25,1,"み"],[30,1,"ひと"]],"text":"彼が持っているすべての物を債主に奪わせ、その勤労の実をほかの人にかすめさせてください。"},{"ref":"Ps.109.12","start":19109012,"end":19109012,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[8,1,"ほどこ"],[10,1,"もの"],[32,1,"もの"]],"text":"彼にいつくしみを施す者はひとりもなく、またそのみなしごをあわれむ者もなく、"},{"ref":"Ps.109.13","start":19109013,"end":19109013,"break":"line","breaks":[[10,"line"]],"ruby":[[2,2,"しそん"],[5,1,"た"],[12,1,"な"],[14,1,"つぎ"],[16,1,"よ"],[18,1,"け"],[20,1,"さ"]],"text":"その子孫を絶えさせ、その名を次の代に消し去ってください。"},{"ref":"Ps.109.14","start":19109014,"end":19109014,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"ちち"],[6,2,"ふぎ"],[9,1,"しゅ"],[12,1,"まえ"],[14,1,"おぼ"],[21,1,"はは"],[23,1,"つみ"],[25,1,"け"],[27,1,"さ"]],"text":"その父たちの不義は主のみ前に覚えられ、その母の罪を消し去らないでください。"},{"ref":"Ps.109.15","start":19109015,"end":19109015,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"つね"],[6,1,"しゅ"],[9,1,"まえ"],[11,1,"お"],[14,1,"かれ"],[16,2,"きおく"],[19,1,"ち"],[22,1,"た"]],"text":"それらを常に主のみ前に置き、彼の記憶を地から断ってください。"},{"ref":"Ps.109.16","start":19109016,"end":19109016,"break":"line","breaks":[[20,"line"],[37,"line"]],"ruby":[[3,1,"かれ"],[11,1,"ほどこ"],[16,1,"おも"],[24,1,"まず"],[27,1,"もの"],[29,1,"とぼ"],[32,1,"もの"],[34,1,"せ"],[37,1,"こころ"],[39,1,"いた"],[42,1,"もの"],[44,1,"ころ"]],"text":"これは彼がいつくしみを施すことを思わず、かえって貧しい者、乏しい者を責め、心の痛める者を殺そうとしたからです。"},{"ref":"Ps.109.17","start":19109017,"end":19109017,"break":"line","breaks":[[12,"line"],[27,"line"],[41,"line"]],"ruby":[[0,1,"かれ"],[8,1,"この"],[16,1,"かれ"],[18,1,"のぞ"],[27,1,"かれ"],[29,1,"めぐ"],[34,1,"よろこ"],[41,1,"めぐ"],[44,1,"かれ"],[47,1,"とお"]],"text":"彼はのろうことを好んだ。のろいを彼に臨ませてください。彼は恵むことを喜ばなかった。恵みを彼から遠ざけてください。"},{"ref":"Ps.109.18","start":19109018,"end":19109018,"break":"line","breaks":[[14,"line"],[33,"line"]],"ruby":[[0,1,"かれ"],[6,1,"ころも"],[11,1,"き"],[18,1,"みず"],[25,1,"み"],[33,1,"あぶら"],[40,1,"ほね"]],"text":"彼はのろいを衣のように着た。のろいを水のようにその身にしみこませ、油のようにその骨にしみこませてください。"},{"ref":"Ps.109.19","start":19109019,"end":19109019,"break":"line","breaks":[[20,"line"]],"ruby":[[5,2,"じぶん"],[8,1,"き"],[10,2,"きもの"],[20,1,"つね"],[22,1,"し"],[25,1,"おび"]],"text":"またそれを自分の着る着物のようにならせ、常に締める帯のようにならせてください。"},{"ref":"Ps.109.20","start":19109020,"end":19109020,"break":"line","breaks":[[14,"line"],[31,"line"]],"ruby":[[7,2,"ひなん"],[11,1,"もの"],[18,1,"さか"],[22,1,"わる"],[27,1,"い"],[29,1,"もの"],[31,1,"しゅ"],[37,1,"むく"]],"text":"これがわたしを非難する者と、わたしに逆らって悪いことを言う者の主からうける報いとしてください。"},{"ref":"Ps.109.21","start":19109021,"end":19109021,"break":"line","breaks":[[12,"line"],[35,"line"],[51,"line"]],"ruby":[[6,1,"しゅ"],[9,1,"かみ"],[17,1,"な"],[27,1,"かえり"],[45,1,"ふか"],[56,1,"たす"]],"text":"しかし、わが主なる神よ、あなたはみ名のために、わたしを顧みてください。あなたのいつくしみの深きにより、わたしをお助けください。"},{"ref":"Ps.109.22","start":19109022,"end":19109022,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"まず"],[10,1,"とぼ"],[21,1,"こころ"],[28,1,"きず"]],"text":"わたしは貧しく、かつ乏しいのです。わたしの心はわがうちに傷ついています。"},{"ref":"Ps.109.23","start":19109023,"end":19109023,"break":"line","breaks":[[17,"line"]],"ruby":[[4,2,"ゆうひ"],[7,1,"かげ"],[12,1,"さ"],[24,1,"お"],[26,1,"はら"]],"text":"わたしは夕日の影のように去りゆき、いなごのように追い払われます。"},{"ref":"Ps.109.24","start":19109024,"end":19109024,"break":"line","breaks":[[18,"line"]],"ruby":[[7,2,"だんじき"],[22,1,"にく"],[26,1,"おとろ"]],"text":"わたしのひざは断食によってよろめき、わたしの肉はやせ衰え、"},{"ref":"Ps.109.25","start":19109025,"end":19109025,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"かれ"],[12,1,"もの"],[20,1,"かれ"],[27,1,"み"],[31,1,"あたま"],[33,1,"ふ"]],"text":"わたしは彼らにそしられる者となりました。彼らはわたしを見ると、頭を振ります。"},{"ref":"Ps.109.26","start":19109026,"end":19109026,"break":"line","breaks":[[19,"line"],[35,"line"]],"ruby":[[2,1,"かみ"],[4,1,"しゅ"],[12,1,"たす"],[40,1,"すく"]],"text":"わが神、主よ、わたしをお助けください。あなたのいつくしみにしたがって、わたしをお救いください。"},{"ref":"Ps.109.27","start":19109027,"end":19109027,"break":"line","breaks":[[21,"line"],[36,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"て"],[36,1,"かれ"],[39,1,"し"]],"text":"主よ、これがあなたのみ手のわざであること、あなたがそれをなされたことを、彼らに知らせてください。"},{"ref":"Ps.109.28","start":19109028,"end":19109028,"break":"line","breaks":[[22,"line"],[37,"line"]],"ruby":[[0,1,"かれ"],[15,2,"しゅくふく"],[26,1,"せ"],[29,1,"もの"],[45,1,"よろこ"]],"text":"彼らはのろうけれども、あなたは祝福されます。わたしを攻める者をはずかしめ、あなたのしもべを喜ばせてください。"},{"ref":"Ps.109.29","start":19109029,"end":19109029,"break":"line","breaks":[[19,"line"]],"ruby":[[4,2,"ひなん"],[8,1,"もの"],[16,1,"き"],[22,1,"はじ"],[24,2,"うわぎ"]],"text":"わたしを非難する者にはずかしめを着せ、おのが恥を上着のようにまとわせてください。"},{"ref":"Ps.109.30","start":19109030,"end":19109030,"break":"line","breaks":[[20,"line"]],"ruby":[[6,1,"くち"],[11,1,"おお"],[14,1,"しゅ"],[16,2,"かんしゃ"],[20,1,"おお"],[23,1,"ひと"],[28,1,"しゅ"]],"text":"わたしはわが口をもって大いに主に感謝し、多くの人のなかで主をほめたたえます。"},{"ref":"Ps.109.31","start":19109031,"end":19109031,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"まず"],[5,1,"もの"],[7,1,"みぎ"],[9,1,"た"],[13,2,"しざい"],[24,1,"もの"],[27,1,"かれ"],[29,1,"すく"]],"text":"主は貧しい者の右に立って、死罪にさだめようとする者から彼を救われるからです。"}]