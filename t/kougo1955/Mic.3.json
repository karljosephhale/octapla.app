[{"ref":"Mic.3.1","start":33003001,"end":33003001,"break":"paragraph","breaks":[[8,"line"],[19,"line"],[37,"line"]],"ruby":[[4,1,"い"],[25,1,"いえ"],[34,1,"き"],[37,2,"こうぎ"],[46,1,"し"]],"text":"わたしは言った、ヤコブのかしらたちよ、イスラエルの家のつかさたちよ、聞け、公義はあなたがたの知っておるべきことではないか。"},{"ref":"Mic.3.2","start":33003002,"end":33003002,"break":"line","breaks":[[16,"line"]],"ruby":[[6,1,"ぜん"],[8,1,"にく"],[11,1,"あく"],[13,1,"あい"],[18,1,"たみ"],[20,1,"み"],[23,1,"かわ"],[30,1,"ほね"],[33,1,"にく"]],"text":"あなたがたは善を憎み、悪を愛し、わが民の身から皮をはぎ、その骨から肉をそぎ、"},{"ref":"Mic.3.3","start":33003003,"end":33003003,"break":"line","breaks":[[12,"line"],[26,"line"],[50,"line"]],"ruby":[[4,1,"たみ"],[6,1,"にく"],[8,1,"く"],[14,1,"かわ"],[21,1,"ほね"],[23,1,"くだ"],[29,1,"き"],[39,1,"い"],[42,2,"しょくもつ"],[50,1,"おお"],[54,1,"い"],[57,1,"にく"]],"text":"またわが民の肉を食らい、その皮をはぎ、その骨を砕き、これを切りきざんで、なべに入れる食物のようにし、大なべに入れる肉のようにする。"},{"ref":"Mic.3.4","start":33003004,"end":33003004,"break":"line","breaks":[[16,"line"],[27,"line"],[48,"line"]],"ruby":[[4,1,"かれ"],[7,1,"しゅ"],[9,1,"よ"],[16,1,"しゅ"],[19,1,"こた"],[33,1,"とき"],[38,1,"かお"],[40,1,"かれ"],[43,1,"かく"],[48,1,"かれ"],[56,1,"わる"]],"text":"こうして彼らが主に呼ばわっても、主はお答えにならない。かえってその時には、み顔を彼らに隠される。彼らのおこないが悪いからである。"},{"ref":"Mic.3.5","start":33003005,"end":33003005,"break":"stanza","breaks":[[23,"line"],[36,"line"],[48,"line"],[66,"line"]],"ruby":[[2,1,"たみ"],[4,1,"まど"],[7,3,"よげんしゃ"],[14,1,"しゅ"],[18,1,"い"],[23,1,"かれ"],[26,1,"た"],[28,1,"もの"],[32,1,"とき"],[37,2,"へいあん"],[41,1,"さけ"],[50,1,"くち"],[52,1,"なに"],[54,1,"あた"],[58,1,"もの"],[66,2,"せんせん"],[69,2,"ふこく"]],"text":"わが民を惑わす預言者について主はこう言われる、彼らは食べ物のある時には、「平安」を叫ぶけれども、その口に何も与えない者にむかっては、宣戦を布告する。"},{"ref":"Mic.3.6","start":33003006,"end":33003006,"break":"line","breaks":[[23,"line"],[37,"line"],[51,"line"]],"ruby":[[12,1,"よる"],[18,1,"まぼろし"],[23,1,"くら"],[31,1,"うらな"],[37,2,"たいよう"],[42,3,"よげんしゃ"],[48,1,"ぼっ"],[51,1,"ひる"],[53,1,"かれ"],[56,1,"うえ"],[58,1,"くら"]],"text":"それゆえ、あなたがたには夜があっても幻がなく、暗やみがあっても占いがない。太陽はその預言者たちに没し、昼も彼らの上に暗くなる。"},{"ref":"Mic.3.7","start":33003007,"end":33003007,"break":"line","breaks":[[20,"line"],[35,"line"]],"ruby":[[0,3,"せんけんしゃ"],[4,1,"はじ"],[9,1,"うらな"],[11,1,"し"],[13,1,"かお"],[20,1,"かれ"],[23,1,"みな"],[35,1,"かみ"],[37,1,"こたえ"]],"text":"先見者は恥をかき、占い師は顔をあからめ、彼らは皆そのくちびるをおおう。神の答がないからである。"},{"ref":"Mic.3.8","start":33003008,"end":33003008,"break":"line","breaks":[[21,"line"],[33,"line"]],"ruby":[[7,1,"しゅ"],[16,1,"ちから"],[18,1,"み"],[21,2,"こうぎ"],[24,2,"ゆうき"],[28,1,"み"],[42,1,"しめ"],[53,1,"つみ"],[55,1,"しめ"]],"text":"しかしわたしは主のみたまによって力に満ち、公義と勇気とに満たされ、ヤコブにそのとがを示し、イスラエルにその罪を示すことができる。"},{"ref":"Mic.3.9","start":33003009,"end":33003009,"break":"stanza","breaks":[[12,"line"],[27,"line"],[37,"line"]],"ruby":[[4,1,"いえ"],[18,1,"いえ"],[31,2,"こうぎ"],[34,1,"にく"],[41,1,"ただ"],[44,1,"こと"],[46,1,"ま"],[49,1,"もの"],[55,1,"き"]],"text":"ヤコブの家のかしらたち、イスラエルの家のつかさたちよ、すなわち公義を憎み、すべての正しい事を曲げる者よ、これを聞け。"},{"ref":"Mic.3.10","start":33003010,"end":33003010,"break":"line","breaks":[[18,"line"]],"ruby":[[6,1,"ち"],[15,1,"た"],[18,2,"ふぎ"],[30,1,"た"]],"text":"あなたがたは血をもってシオンを建て、不義をもってエルサレムを建てた。"},{"ref":"Mic.3.11","start":33003011,"end":33003011,"break":"line","breaks":[[21,"line"],[36,"line"],[52,"line"],[68,"line"],[88,"line"]],"ruby":[[23,2,"さいし"],[28,1,"あたい"],[33,1,"おし"],[38,3,"よげんしゃ"],[44,1,"きん"],[49,1,"うらな"],[57,1,"かれ"],[60,1,"しゅ"],[62,1,"よ"],[64,1,"たよ"],[69,1,"しゅ"],[76,1,"なか"],[91,1,"わざわい"],[98,1,"のぞ"],[107,1,"い"]],"text":"そのかしらたちは、まいないをとってさばき、その祭司たちは価をとって教え、その預言者たちは金をとって占う。しかもなお彼らは主に寄り頼んで、「主はわれわれの中におられるではないか、だから災はわれわれに臨むことがない」と言う。"},{"ref":"Mic.3.12","start":33003012,"end":33003012,"break":"line","breaks":[[18,"line"],[28,"line"],[40,"line"]],"ruby":[[18,2,"たはた"],[24,1,"たがや"],[34,2,"いしづか"],[40,1,"みや"],[42,1,"やま"],[44,1,"き"],[48,1,"しげ"],[50,1,"たか"],[52,1,"ところ"]],"text":"それゆえ、シオンはあなたがたのゆえに田畑となって耕され、エルサレムは石塚となり、宮の山は木のおい茂る高い所となる。"}]