[{"ref":"Gen.5.1","start":1005001,"end":1005001,"break":"paragraph","ruby":[[4,2,"けいず"],[7,1,"つぎ"],[16,1,"かみ"],[18,1,"ひと"],[20,2,"そうぞう"],[25,1,"とき"],[27,1,"かみ"],[34,1,"つく"]],"text":"アダムの系図は次のとおりである。神が人を創造された時、神をかたどって造り、"},{"ref":"Gen.5.2","start":1005002,"end":1005002,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おとこ"],[5,1,"おんな"],[8,2,"そうぞう"],[14,1,"かれ"],[17,2,"そうぞう"],[22,1,"とき"],[24,1,"かみ"],[26,1,"かれ"],[29,2,"しゅくふく"],[36,1,"な"],[42,1,"な"]],"text":"彼らを男と女とに創造された。彼らが創造された時、神は彼らを祝福して、その名をアダムと名づけられた。"},{"ref":"Gen.5.3","start":1005003,"end":1005003,"break":"none","ruby":[[7,1,"さい"],[13,2,"じぶん"],[21,2,"じぶん"],[31,1,"おとこ"],[33,1,"こ"],[35,1,"う"],[40,1,"な"],[45,1,"な"]],"text":"アダムは百三十歳になって、自分にかたどり、自分のかたちのような男の子を生み、その名をセツと名づけた。"},{"ref":"Gen.5.4","start":1005004,"end":1005004,"break":"none","ruby":[[7,1,"う"],[10,1,"のち"],[12,1,"い"],[15,1,"とし"],[19,1,"ねん"],[28,2,"だんし"],[31,2,"じょし"],[34,1,"う"]],"text":"アダムがセツを生んで後、生きた年は八百年であって、ほかに男子と女子を生んだ。"},{"ref":"Gen.5.5","start":1005005,"end":1005005,"break":"none","ruby":[[4,1,"い"],[7,1,"とし"],[9,1,"あ"],[17,1,"さい"],[26,1,"かれ"],[28,1,"し"]],"text":"アダムの生きた年は合わせて九百三十歳であった。そして彼は死んだ。"},{"ref":"Gen.5.6","start":1005006,"end":1005006,"break":"paragraph","ruby":[[5,1,"さい"],[15,1,"う"]],"text":"セツは百五歳になって、エノスを生んだ。"},{"ref":"Gen.5.7","start":1005007,"end":1005007,"break":"none","ruby":[[7,1,"う"],[10,1,"のち"],[15,1,"ねん"],[16,1,"い"],[20,2,"だんし"],[23,2,"じょし"],[26,1,"う"]],"text":"セツはエノスを生んだ後、八百七年生きて、男子と女子を生んだ。"},{"ref":"Gen.5.8","start":1005008,"end":1005008,"break":"none","ruby":[[3,1,"とし"],[5,1,"あ"],[13,1,"さい"],[22,1,"かれ"],[24,1,"し"]],"text":"セツの年は合わせて九百十二歳であった。そして彼は死んだ。"},{"ref":"Gen.5.9","start":1005009,"end":1005009,"break":"paragraph","ruby":[[6,1,"さい"],[17,1,"う"]],"text":"エノスは九十歳になって、カイナンを生んだ。"},{"ref":"Gen.5.10","start":1005010,"end":1005010,"break":"none","ruby":[[9,1,"う"],[12,1,"のち"],[18,1,"ねん"],[19,1,"い"],[23,2,"だんし"],[26,2,"じょし"],[29,1,"う"]],"text":"エノスはカイナンを生んだ後、八百十五年生きて、男子と女子を生んだ。"},{"ref":"Gen.5.11","start":1005011,"end":1005011,"break":"none","ruby":[[4,1,"とし"],[6,1,"あ"],[13,1,"さい"],[22,1,"かれ"],[24,1,"し"]],"text":"エノスの年は合わせて九百五歳であった。そして彼は死んだ。"},{"ref":"Gen.5.12","start":1005012,"end":1005012,"break":"paragraph","ruby":[[7,1,"さい"],[19,1,"う"]],"text":"カイナンは七十歳になって、マハラレルを生んだ。"},{"ref":"Gen.5.13","start":1005013,"end":1005013,"break":"none","ruby":[[11,1,"う"],[14,1,"のち"],[20,1,"ねん"],[21,1,"い"],[25,2,"だんし"],[28,2,"じょし"],[31,1,"う"]],"text":"カイナンはマハラレルを生んだ後、八百四十年生きて、男子と女子を生んだ。"},{"ref":"Gen.5.14","start":1005014,"end":1005014,"break":"none","ruby":[[5,1,"とし"],[7,1,"あ"],[14,1,"さい"],[23,1,"かれ"],[25,1,"し"]],"text":"カイナンの年は合わせて九百十歳であった。そして彼は死んだ。"},{"ref":"Gen.5.15","start":1005015,"end":1005015,"break":"paragraph","ruby":[[9,1,"さい"],[19,1,"う"]],"text":"マハラレルは六十五歳になって、ヤレドを生んだ。"},{"ref":"Gen.5.16","start":1005016,"end":1005016,"break":"none","ruby":[[10,1,"う"],[13,1,"のち"],[19,1,"ねん"],[20,1,"い"],[24,2,"だんし"],[27,2,"じょし"],[30,1,"う"]],"text":"マハラレルはヤレドを生んだ後、八百三十年生きて、男子と女子を生んだ。"},{"ref":"Gen.5.17","start":1005017,"end":1005017,"break":"none","ruby":[[6,1,"とし"],[8,1,"あ"],[17,1,"さい"],[26,1,"かれ"],[28,1,"し"]],"text":"マハラレルの年は合わせて八百九十五歳であった。そして彼は死んだ。"},{"ref":"Gen.5.18","start":1005018,"end":1005018,"break":"none","ruby":[[8,1,"さい"],[18,1,"う"]],"text":"ヤレドは百六十二歳になって、エノクを生んだ。"},{"ref":"Gen.5.19","start":1005019,"end":1005019,"break":"none","ruby":[[8,1,"う"],[11,1,"のち"],[15,1,"ねん"],[16,1,"い"],[20,2,"だんし"],[23,2,"じょし"],[26,1,"う"]],"text":"ヤレドはエノクを生んだ後、八百年生きて、男子と女子を生んだ。"},{"ref":"Gen.5.20","start":1005020,"end":1005020,"break":"none","ruby":[[4,1,"とし"],[6,1,"あ"],[15,1,"さい"],[24,1,"かれ"],[26,1,"し"]],"text":"ヤレドの年は合わせて九百六十二歳であった。そして彼は死んだ。"},{"ref":"Gen.5.21","start":1005021,"end":1005021,"break":"paragraph","ruby":[[7,1,"さい"],[18,1,"う"]],"text":"エノクは六十五歳になって、メトセラを生んだ。"},{"ref":"Gen.5.22","start":1005022,"end":1005022,"break":"none","ruby":[[9,1,"う"],[12,1,"のち"],[16,1,"ねん"],[18,1,"かみ"],[23,1,"あゆ"],[26,2,"だんし"],[29,2,"じょし"],[32,1,"う"]],"text":"エノクはメトセラを生んだ後、三百年、神とともに歩み、男子と女子を生んだ。"},{"ref":"Gen.5.23","start":1005023,"end":1005023,"break":"none","ruby":[[4,1,"とし"],[6,1,"あ"],[15,1,"さい"]],"text":"エノクの年は合わせて三百六十五歳であった。"},{"ref":"Gen.5.24","start":1005024,"end":1005024,"break":"none","ruby":[[4,1,"かみ"],[9,1,"あゆ"],[12,1,"かみ"],[14,1,"かれ"],[16,1,"と"]],"text":"エノクは神とともに歩み、神が彼を取られたので、いなくなった。"},{"ref":"Gen.5.25","start":1005025,"end":1005025,"break":"paragraph","ruby":[[9,1,"さい"],[19,1,"う"]],"text":"メトセラは百八十七歳になって、レメクを生んだ。"},{"ref":"Gen.5.26","start":1005026,"end":1005026,"break":"none","ruby":[[9,1,"う"],[12,1,"のち"],[19,1,"ねん"],[20,1,"い"],[24,2,"だんし"],[27,2,"じょし"],[30,1,"う"]],"text":"メトセラはレメクを生んだ後、七百八十二年生きて、男子と女子を生んだ。"},{"ref":"Gen.5.27","start":1005027,"end":1005027,"break":"none","ruby":[[5,1,"とし"],[7,1,"あ"],[16,1,"さい"],[25,1,"かれ"],[27,1,"し"]],"text":"メトセラの年は合わせて九百六十九歳であった。そして彼は死んだ。"},{"ref":"Gen.5.28","start":1005028,"end":1005028,"break":"paragraph","ruby":[[8,1,"さい"],[14,1,"おとこ"],[16,1,"こ"],[18,1,"う"]],"text":"レメクは百八十二歳になって、男の子を生み、"},{"ref":"Gen.5.29","start":1005029,"end":1005029,"break":"none","ruby":[[3,1,"こ"],[7,1,"しゅ"],[9,1,"ち"],[19,2,"ほねお"],[22,1,"はたら"],[29,1,"なぐさ"],[36,1,"い"],[42,1,"な"],[47,1,"な"]],"text":"「この子こそ、主が地をのろわれたため、骨折り働くわれわれを慰めるもの」と言って、その名をノアと名づけた。"},{"ref":"Gen.5.30","start":1005030,"end":1005030,"break":"none","ruby":[[7,1,"う"],[10,1,"のち"],[17,1,"ねん"],[18,1,"い"],[22,2,"だんし"],[25,2,"じょし"],[28,1,"う"]],"text":"レメクはノアを生んだ後、五百九十五年生きて、男子と女子を生んだ。"},{"ref":"Gen.5.31","start":1005031,"end":1005031,"break":"none","ruby":[[4,1,"とし"],[6,1,"あ"],[15,1,"さい"],[24,1,"かれ"],[26,1,"し"]],"text":"レメクの年は合わせて七百七十七歳であった。そして彼は死んだ。"},{"ref":"Gen.5.32","start":1005032,"end":1005032,"break":"paragraph","ruby":[[5,1,"さい"],[21,1,"う"]],"text":"ノアは五百歳になって、セム、ハム、ヤペテを生んだ。"}]