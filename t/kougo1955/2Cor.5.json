[{"ref":"2Cor.5.1","start":47005001,"end":47005001,"break":"paragraph","ruby":[[6,1,"す"],[11,2,"ちじょう"],[14,2,"まくや"],[23,1,"かみ"],[30,2,"たてもの"],[37,1,"てん"],[42,1,"ひと"],[44,1,"て"],[50,2,"えいえん"],[53,1,"いえ"],[55,1,"そな"],[70,1,"し"]],"text":"わたしたちの住んでいる地上の幕屋がこわれると、神からいただく建物、すなわち天にある、人の手によらない永遠の家が備えてあることを、わたしたちは知っている。"},{"ref":"2Cor.5.2","start":47005002,"end":47005002,"break":"none","ruby":[[4,1,"てん"],[7,1,"たま"],[17,1,"うえ"],[19,1,"き"],[23,1,"せつ"],[25,1,"のぞ"],[33,2,"まくや"],[36,1,"なか"],[38,1,"くる"]],"text":"そして、天から賜わるそのすみかを、上に着ようと切に望みながら、この幕屋の中で苦しみもだえている。"},{"ref":"2Cor.5.3","start":47005003,"end":47005003,"break":"none","ruby":[[3,1,"き"],[8,1,"はだか"]],"text":"それを着たなら、裸のままではいないことになろう。"},{"ref":"2Cor.5.4","start":47005004,"end":47005004,"break":"none","ruby":[[2,2,"まくや"],[5,1,"なか"],[16,2,"おもに"],[19,1,"お"],[22,1,"くる"],[35,1,"ぬ"],[39,1,"ねが"],[50,1,"うえ"],[52,1,"き"],[56,1,"ねが"],[71,1,"し"]],"text":"この幕屋の中にいるわたしたちは、重荷を負って苦しみもだえている。それを脱ごうと願うからではなく、その上に着ようと願うからであり、それによって、死ぬべきものがいのちにのまれてしまうためである。"},{"ref":"2Cor.5.5","start":47005005,"end":47005005,"break":"none","ruby":[[9,1,"こと"],[14,1,"もの"],[18,1,"くだ"],[25,1,"かみ"],[34,1,"かみ"],[38,2,"ほしょう"],[43,2,"みたま"],[52,1,"たま"]],"text":"わたしたちを、この事にかなう者にして下さったのは、神である。そして、神はその保証として御霊をわたしたちに賜わったのである。"},{"ref":"2Cor.5.6","start":47005006,"end":47005006,"break":"none","ruby":[[13,1,"こころ"],[14,1,"づよ"],[21,2,"にくたい"],[24,1,"やど"],[30,1,"あいだ"],[32,1,"しゅ"],[35,1,"はな"],[46,1,"し"]],"text":"だから、わたしたちはいつも心強い。そして、肉体を宿としている間は主から離れていることを、よく知っている。"},{"ref":"2Cor.5.7","start":47005007,"end":47005007,"break":"none","ruby":[[7,1,"み"],[19,2,"しんこう"],[25,1,"ある"]],"text":"わたしたちは、見えるものによらないで、信仰によって歩いているのである。"},{"ref":"2Cor.5.8","start":47005008,"end":47005008,"break":"none","ruby":[[10,1,"こころ"],[11,1,"づよ"],[21,2,"にくたい"],[25,1,"はな"],[28,1,"しゅ"],[30,1,"とも"],[32,1,"す"],[38,1,"ねが"],[43,1,"おも"]],"text":"それで、わたしたちは心強い。そして、むしろ肉体から離れて主と共に住むことが、願わしいと思っている。"},{"ref":"2Cor.5.9","start":47005009,"end":47005009,"break":"none","ruby":[[10,2,"にくたい"],[13,1,"やど"],[28,1,"はな"],[40,1,"しゅ"],[42,1,"よろこ"],[46,1,"もの"],[53,1,"こころ"],[57,1,"ねが"]],"text":"そういうわけだから、肉体を宿としているにしても、それから離れているにしても、ただ主に喜ばれる者となるのが、心からの願いである。"},{"ref":"2Cor.5.10","start":47005010,"end":47005010,"break":"none","ruby":[[11,1,"みな"],[22,1,"ざ"],[24,1,"まえ"],[31,1,"ぜん"],[35,1,"あく"],[40,2,"じぶん"],[43,1,"おこな"],[49,1,"おう"],[57,1,"むく"],[60,1,"う"]],"text":"なぜなら、わたしたちは皆、キリストのさばきの座の前にあらわれ、善であれ悪であれ、自分の行ったことに応じて、それぞれ報いを受けねばならないからである。"},{"ref":"2Cor.5.11","start":47005011,"end":47005011,"break":"paragraph","ruby":[[12,1,"しゅ"],[14,1,"おそ"],[21,1,"し"],[29,2,"ひとびと"],[32,1,"と"],[34,1,"すす"],[48,1,"かみ"],[55,1,"あき"],[75,2,"りょうしん"],[79,1,"あき"],[89,1,"のぞ"]],"text":"このようにわたしたちは、主の恐るべきことを知っているので、人々に説き勧める。わたしたちのことは、神のみまえには明らかになっている。さらに、あなたがたの良心にも明らかになるようにと望む。"},{"ref":"2Cor.5.12","start":47005012,"end":47005012,"break":"none","ruby":[[13,1,"たい"],[21,2,"じこ"],[23,2,"すいせん"],[46,1,"ほこ"],[48,2,"きかい"],[58,1,"も"],[62,1,"こころ"],[64,1,"ほこ"],[77,1,"ほこ"],[79,2,"ひとびと"],[82,1,"こた"]],"text":"わたしたちは、あなたがたに対して、またもや自己推薦をしようとするのではない。ただわたしたちを誇る機会を、あなたがたに持たせ、心を誇るのではなくうわべだけを誇る人々に答えうるようにさせたいのである。"},{"ref":"2Cor.5.13","start":47005013,"end":47005013,"break":"none","ruby":[[9,1,"き"],[11,1,"くる"],[23,1,"かみ"],[31,1,"き"],[33,1,"たし"]],"text":"もしわたしたちが、気が狂っているのなら、それは神のためであり、気が確かであるのなら、それはあなたがたのためである。"},{"ref":"2Cor.5.14","start":47005014,"end":47005014,"break":"none","ruby":[[10,1,"あい"],[18,1,"つよ"],[20,1,"せま"],[39,1,"かんが"],[49,1,"ひと"],[55,1,"ひと"],[60,1,"し"],[63,2,"いじょう"],[70,1,"ひと"],[72,1,"し"]],"text":"なぜなら、キリストの愛がわたしたちに強く迫っているからである。わたしたちはこう考えている。ひとりの人がすべての人のために死んだ以上、すべての人が死んだのである。"},{"ref":"2Cor.5.15","start":47005015,"end":47005015,"break":"none","ruby":[[4,1,"かれ"],[10,1,"ひと"],[15,1,"し"],[21,1,"い"],[26,1,"もの"],[31,2,"じぶん"],[42,2,"じぶん"],[48,1,"し"],[64,1,"い"]],"text":"そして、彼がすべての人のために死んだのは、生きている者がもはや自分のためにではなく、自分のために死んでよみがえったかたのために、生きるためである。"},{"ref":"2Cor.5.16","start":47005016,"end":47005016,"break":"paragraph","ruby":[[12,2,"こんご"],[19,1,"にく"],[24,1,"し"],[42,1,"にく"],[47,1,"し"],[57,1,"いま"],[66,1,"し"],[68,1,"かた"]],"text":"それだから、わたしたちは今後、だれをも肉によって知ることはすまい。かつてはキリストを肉によって知っていたとしても、今はもうそのような知り方をすまい。"},{"ref":"2Cor.5.17","start":47005017,"end":47005017,"break":"none","ruby":[[17,1,"ひと"],[19,1,"あたら"],[22,1,"つく"],[26,1,"もの"],[31,1,"ふる"],[36,1,"す"],[38,1,"さ"],[42,1,"み"],[49,1,"あたら"]],"text":"だれでもキリストにあるならば、その人は新しく造られた者である。古いものは過ぎ去った、見よ、すべてが新しくなったのである。"},{"ref":"2Cor.5.18","start":47005018,"end":47005018,"break":"none","ruby":[[11,1,"こと"],[14,1,"かみ"],[17,1,"で"],[22,1,"かみ"],[40,2,"じぶん"],[43,2,"わかい"],[50,2,"わかい"],[53,1,"つとめ"],[61,1,"さづ"],[64,1,"くだ"]],"text":"しかし、すべてこれらの事は、神から出ている。神はキリストによって、わたしたちをご自分に和解させ、かつ和解の務をわたしたちに授けて下さった。"},{"ref":"2Cor.5.19","start":47005019,"end":47005019,"break":"none","ruby":[[5,1,"かみ"],[15,1,"よ"],[18,2,"じぶん"],[21,2,"わかい"],[28,2,"ざいか"],[31,2,"せきにん"],[37,1,"お"],[55,2,"わかい"],[58,2,"ふくいん"]],"text":"すなわち、神はキリストにおいて世をご自分に和解させ、その罪過の責任をこれに負わせることをしないで、わたしたちに和解の福音をゆだねられたのである。"},{"ref":"2Cor.5.20","start":47005020,"end":47005020,"break":"paragraph","ruby":[[0,1,"かみ"],[12,1,"すす"],[36,2,"ししゃ"],[53,1,"かわ"],[56,1,"ねが"],[59,1,"かみ"],[61,2,"わかい"],[64,1,"う"]],"text":"神がわたしたちをとおして勧めをなさるのであるから、わたしたちはキリストの使者なのである。そこで、キリストに代って願う、神の和解を受けなさい。"},{"ref":"2Cor.5.21","start":47005021,"end":47005021,"break":"none","ruby":[[0,1,"かみ"],[8,1,"つみ"],[14,1,"つみ"],[16,1,"し"],[23,1,"つみ"],[40,1,"かれ"],[45,1,"かみ"],[47,1,"ぎ"]],"text":"神はわたしたちの罪のために、罪を知らないかたを罪とされた。それは、わたしたちが、彼にあって神の義となるためなのである。"}]