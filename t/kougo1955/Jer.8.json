[{"ref":"Jer.8.1","start":24008001,"end":24008001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"とき"],[13,1,"おう"],[17,1,"ほね"],[28,1,"ほね"],[31,2,"さいし"],[36,1,"ほね"],[39,3,"よげんしゃ"],[45,1,"ほね"],[54,1,"す"],[56,2,"ひとびと"],[59,1,"ほね"],[61,1,"はか"],[64,1,"ほ"],[66,1,"だ"]],"text":"主は言われる、その時ユダの王たちの骨と、そのつかさたちの骨と、祭司たちの骨と、預言者たちの骨と、エルサレムに住む人々の骨は墓より掘り出されて、"},{"ref":"Jer.8.2","start":24008002,"end":24008002,"break":"none","ruby":[[0,1,"かれ"],[3,1,"あい"],[6,1,"つか"],[9,1,"したが"],[12,1,"もと"],[17,1,"おが"],[21,1,"ひ"],[23,1,"つき"],[25,1,"てん"],[27,1,"しゅう"],[28,1,"ぐん"],[30,1,"まえ"],[40,1,"ほね"],[42,1,"あつ"],[45,1,"もの"],[47,1,"ほうむ"],[49,1,"もの"],[54,1,"ち"],[60,2,"ふんど"]],"text":"彼らの愛し、仕え、従い、求め、また拝んだ、日と月と天の衆群の前にさらされる。その骨は集める者も葬る者もなく、地のおもてに糞土のようになる。"},{"ref":"Jer.8.3","start":24008003,"end":24008003,"break":"none","ruby":[[2,1,"あ"],[5,1,"たみ"],[10,1,"のこ"],[15,1,"のこ"],[18,1,"もの"],[27,1,"お"],[32,2,"ばしょ"],[36,1,"い"],[44,1,"し"],[49,1,"ねが"],[58,2,"ばんぐん"],[61,1,"しゅ"],[63,1,"い"]],"text":"この悪しき民のうちの残っている残りの者はみな、わたしが追いやった場所で、生きることよりも死ぬことを願うようになると、万軍の主は言われる。"},{"ref":"Jer.8.4","start":24008004,"end":24008004,"break":"stanza","breaks":[[18,"line"],[28,"line"],[52,"line"]],"ruby":[[4,1,"かれ"],[7,1,"い"],[18,1,"しゅ"],[22,1,"おお"],[28,1,"ひと"],[30,1,"たお"],[39,1,"お"],[52,1,"はな"],[62,1,"かえ"]],"text":"あなたは彼らに言わなければならない。主はこう仰せられる、人は倒れたならば、また起きあがらないであろうか。離れていったならば、帰ってこないであろうか。"},{"ref":"Jer.8.5","start":24008005,"end":24008005,"break":"line","breaks":[[12,"line"],[26,"line"],[39,"line"]],"ruby":[[9,1,"たみ"],[12,1,"つね"],[18,1,"はな"],[26,1,"かれ"],[29,1,"いつわ"],[32,1,"かた"],[39,1,"かえ"],[47,1,"こば"]],"text":"それにどうしてこの民は、常にそむいて離れていくのか。彼らは偽りを固くとらえて、帰ってくることを拒んでいる。"},{"ref":"Jer.8.6","start":24008006,"end":24008006,"break":"line","breaks":[[14,"line"],[28,"line"],[36,"line"],[60,"line"],[79,"line"]],"ruby":[[4,1,"き"],[9,1,"き"],[14,1,"かれ"],[17,1,"ただ"],[21,1,"かた"],[30,1,"あく"],[32,1,"く"],[43,1,"こと"],[45,1,"なに"],[51,1,"もの"],[60,1,"かれ"],[65,2,"せんじょう"],[71,1,"い"],[73,1,"うま"],[79,2,"じぶん"],[85,1,"みち"],[87,1,"む"]],"text":"わたしは気をつけて聞いたが、彼らは正しくは語らなかった。その悪を悔いて、『わたしのした事は何か』という者はひとりもない。彼らはみな戦場に、はせ入る馬のように、自分のすきな道に向かう。"},{"ref":"Jer.8.7","start":24008007,"end":24008007,"break":"line","breaks":[[16,"line"],[38,"line"]],"ruby":[[0,1,"そら"],[11,1,"とき"],[13,1,"し"],[16,1,"やま"],[31,1,"く"],[33,1,"とき"],[35,1,"まも"],[43,1,"たみ"],[45,1,"しゅ"],[51,1,"し"]],"text":"空のこうのとりでもその時を知り、山ばとと、つばめと、つるはその来る時を守る。しかしわが民は主のおきてを知らない。"},{"ref":"Jer.8.8","start":24008008,"end":24008008,"break":"stanza","breaks":[[24,"line"],[45,"line"],[60,"line"]],"ruby":[[18,2,"ちえ"],[24,1,"しゅ"],[34,1,"い"],[45,1,"み"],[52,2,"しょき"],[55,1,"いつわ"],[58,1,"ふで"],[63,1,"いつわ"]],"text":"どうしてあなたがたは、『われわれには知恵がある、主のおきてがある』と言うことができようか。見よ、まことに書記の偽りの筆がこれを偽りにしたのだ。"},{"ref":"Jer.8.9","start":24008009,"end":24008009,"break":"line","breaks":[[15,"line"],[29,"line"],[44,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[23,1,"とら"],[29,1,"み"],[32,1,"かれ"],[35,1,"しゅ"],[37,2,"ことば"],[40,1,"す"],[44,1,"かれ"],[50,2,"ちえ"]],"text":"知恵ある者は、はずかしめられ、あわてふためき、捕えられる。見よ、彼らは主の言葉を捨てた、彼らになんの知恵があろうか。"},{"ref":"Jer.8.10","start":24008010,"end":24008010,"break":"line","breaks":[[20,"line"],[32,"line"],[55,"line"],[67,"line"],[81,"line"]],"ruby":[[9,1,"かれ"],[12,1,"つま"],[14,2,"たにん"],[17,1,"あた"],[22,1,"はたけ"],[24,2,"せいふく"],[26,1,"しゃ"],[28,1,"あた"],[35,1,"かれ"],[38,1,"ちい"],[41,1,"もの"],[44,1,"おお"],[47,1,"もの"],[57,2,"ふせい"],[60,1,"り"],[67,3,"よげんしゃ"],[72,2,"さいし"],[83,1,"いつわ"],[86,1,"い"]],"text":"それゆえ、わたしは彼らの妻を他人に与え、その畑を征服者に与える。それは彼らが小さい者から大きい者にいたるまで、みな不正な利をむさぼり、預言者から祭司にいたるまで、みな偽りを行っているからである。"},{"ref":"Jer.8.11","start":24008011,"end":24008011,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[3,2,"てがる"],[11,1,"たみ"],[13,1,"きず"],[19,2,"へいあん"],[28,2,"へいあん"],[31,2,"へいあん"],[35,1,"い"]],"text":"彼らは手軽に、わたしの民の傷をいやし、平安がないのに、『平安、平安』と言っている。"},{"ref":"Jer.8.12","start":24008012,"end":24008012,"break":"line","breaks":[[22,"line"],[37,"line"],[52,"line"],[70,"line"],[83,"line"]],"ruby":[[0,1,"かれ"],[3,1,"にく"],[13,1,"は"],[26,1,"は"],[33,1,"おも"],[39,1,"は"],[45,1,"し"],[56,1,"かれ"],[59,1,"たお"],[62,1,"もの"],[64,1,"とも"],[66,1,"たお"],[74,1,"かれ"],[77,1,"ばっ"],[83,1,"かれ"],[86,1,"たお"],[91,1,"しゅ"],[93,1,"い"]],"text":"彼らは憎むべきことをして、恥じたであろうか。すこしも恥ずかしいとは思わず、また恥じることを知らなかった。それゆえ彼らは倒れる者と共に倒れる。わたしが彼らを罰するとき、彼らは倒れると、主は言われる。"},{"ref":"Jer.8.13","start":24008013,"end":24008013,"break":"line","breaks":[[21,"line"],[34,"line"],[50,"line"],[61,"line"],[75,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"あつ"],[16,1,"おも"],[25,1,"き"],[39,1,"き"],[50,1,"は"],[65,1,"かれ"],[68,1,"あた"],[75,1,"かれ"],[78,1,"はな"],[84,1,"さ"]],"text":"主は言われる、わたしが集めようと思うとき、ぶどうの木にぶどうはなく、いちじくの木に、いちじくはなく、葉さえ、しぼんでいる。わたしが彼らに与えたものも、彼らを離れて、うせ去った」。"},{"ref":"Jer.8.14","start":24008014,"end":24008014,"break":"stanza","breaks":[[23,"line"],[37,"line"],[50,"line"],[65,"line"],[87,"line"]],"ruby":[[11,1,"こと"],[15,1,"ざ"],[23,1,"あつ"],[28,2,"けんご"],[31,1,"まち"],[45,1,"ほろ"],[55,1,"しゅ"],[57,1,"つみ"],[59,1,"おか"],[70,1,"かみ"],[72,1,"しゅ"],[79,1,"ほろ"],[87,1,"どく"],[89,1,"みず"],[91,1,"の"]],"text":"どうしてわれわれはなす事もなく座しているのか。集まって、堅固な町にはいり、そこでわれわれは滅びよう。われわれが主に罪を犯したので、われわれの神、主がわれわれを滅ぼそうとして、毒の水を飲ませられるのだ。"},{"ref":"Jer.8.15","start":24008015,"end":24008015,"break":"line","breaks":[[23,"line"]],"ruby":[[5,2,"へいあん"],[8,1,"のぞ"],[13,1,"よ"],[15,1,"こと"],[28,1,"とき"],[30,1,"のぞ"],[39,2,"きょうふ"],[42,1,"き"]],"text":"われわれは平安を望んだが、良い事はこなかった。いやされる時を望んだが、かえって恐怖が来た。"},{"ref":"Jer.8.16","start":24008016,"end":24008016,"break":"stanza","breaks":[[21,"line"],[39,"line"],[62,"line"]],"ruby":[[1,1,"かれ"],[4,1,"うま"],[15,1,"きこ"],[21,1,"かれ"],[24,1,"つよ"],[26,1,"うま"],[28,1,"こえ"],[33,1,"ぜん"],[34,1,"ち"],[36,1,"ふる"],[39,1,"かれ"],[42,1,"き"],[47,1,"ち"],[62,1,"まち"],[70,1,"す"],[72,1,"もの"],[75,1,"く"],[77,1,"ほろ"]],"text":"「彼らの馬のいななきはダンから聞えてくる。彼らの強い馬の声によって全地は震う。彼らは来て、この地と、ここにあるすべてのもの、町と、そのうちに住む者とを食い滅ぼす。"},{"ref":"Jer.8.17","start":24008017,"end":24008017,"break":"line","breaks":[[20,"line"],[42,"line"]],"ruby":[[0,1,"み"],[3,2,"まほう"],[55,1,"しゅ"],[57,1,"い"]],"text":"見よ、魔法をもってならすことのできない、へびや、まむしをあなたがたのうちにつかわす。それはあなたがたをかむ」と主は言われる。"},{"ref":"Jer.8.18","start":24008018,"end":24008018,"break":"stanza","breaks":[[12,"line"]],"ruby":[[2,1,"なげ"],[14,1,"こころ"],[19,1,"なや"]],"text":"わが嘆きはいやしがたく、わが心はうちに悩む。"},{"ref":"Jer.8.19","start":24008019,"end":24008019,"break":"line","breaks":[[10,"line"],[24,"line"],[39,"line"],[59,"line"],[71,"line"]],"ruby":[[0,1,"き"],[3,1,"ち"],[5,2,"ぜんめん"],[12,1,"たみ"],[14,1,"むすめ"],[16,1,"こえ"],[25,1,"しゅ"],[43,1,"おう"],[62,1,"かれ"],[67,2,"ちょうぞう"],[71,2,"いほう"],[74,2,"ぐうぞう"],[86,1,"いか"]],"text":"聞け、地の全面から、わが民の娘の声があがるのを。「主はシオンにおられないのか、シオンの王はそのうちにおられないのか」。「なぜ彼らはその彫像と、異邦の偶像とをもって、わたしを怒らせたのか」。"},{"ref":"Jer.8.20","start":24008020,"end":24008020,"break":"line","breaks":[[18,"line"]],"ruby":[[1,2,"かりい"],[5,1,"とき"],[7,1,"す"],[10,1,"なつ"],[14,1,"おわ"],[28,1,"すく"]],"text":"「刈入れの時は過ぎ、夏もはや終った、しかしわれわれはまだ救われない」。"},{"ref":"Jer.8.21","start":24008021,"end":24008021,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"たみ"],[4,1,"むすめ"],[6,1,"きず"],[14,1,"こころ"],[16,1,"いた"],[23,1,"なげ"]],"text":"わが民の娘の傷によって、わが心は痛む。わたしは嘆き、うろたえる。"},{"ref":"Jer.8.22","start":24008022,"end":24008022,"break":"stanza","breaks":[[16,"line"],[31,"line"],[44,"line"]],"ruby":[[5,2,"にゅうこう"],[18,1,"ところ"],[20,2,"いしゃ"],[40,1,"たみ"],[42,1,"むすめ"]],"text":"ギレアデに乳香があるではないか。その所に医者がいるではないか。それにどうしてわが民の娘はいやされることがないのか。"}]