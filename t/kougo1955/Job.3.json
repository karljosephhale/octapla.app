[{"ref":"Job.3.1","start":18003001,"end":18003001,"break":"paragraph","ruby":[[2,1,"のち"],[7,1,"くち"],[9,1,"ひら"],[13,2,"じぶん"],[16,1,"うま"],[19,1,"ひ"]],"text":"この後、ヨブは口を開いて、自分の生れた日をのろった。"},{"ref":"Job.3.2","start":18003002,"end":18003002,"break":"none","ruby":[[7,1,"い"]],"text":"すなわちヨブは言った、"},{"ref":"Job.3.3","start":18003003,"end":18003003,"break":"stanza","breaks":[[16,"line"],[35,"line"]],"ruby":[[5,1,"うま"],[8,1,"ひ"],[10,1,"ほろ"],[17,1,"おとこ"],[19,1,"こ"],[22,1,"たい"],[30,1,"い"],[33,1,"よ"]],"text":"「わたしの生れた日は滅びうせよ。『男の子が、胎にやどった』と言った夜もそのようになれ。"},{"ref":"Job.3.4","start":18003004,"end":18003004,"break":"line","breaks":[[12,"line"],[30,"line"]],"ruby":[[2,1,"ひ"],[4,1,"くら"],[12,1,"かみ"],[14,1,"うえ"],[20,1,"かえり"],[30,1,"ひかり"],[35,1,"てら"]],"text":"その日は暗くなるように。神が上からこれを顧みられないように。光がこれを照さないように。"},{"ref":"Job.3.5","start":18003005,"end":18003005,"break":"line","breaks":[[18,"line"],[33,"line"]],"ruby":[[3,2,"あんこく"],[9,1,"と"],[18,1,"くも"],[23,1,"うえ"],[33,1,"ひ"],[35,1,"くら"],[39,1,"もの"],[45,1,"おびや"]],"text":"やみと暗黒がこれを取りもどすように。雲が、その上にとどまるように。日を暗くする者が、これを脅かすように。"},{"ref":"Job.3.6","start":18003006,"end":18003006,"break":"line","breaks":[[20,"line"],[36,"line"]],"ruby":[[2,1,"よ"],[5,1,"くら"],[13,1,"とら"],[20,1,"とし"],[22,1,"ひ"],[27,1,"くわ"],[36,1,"つき"],[38,1,"かず"]],"text":"その夜は、暗やみが、これを捕えるように。年の日のうちに加わらないように。月の数にもはいらないように。"},{"ref":"Job.3.7","start":18003007,"end":18003007,"break":"line","breaks":[[20,"line"]],"ruby":[[5,1,"よ"],[20,1,"よろこ"],[23,1,"こえ"],[30,1,"き"]],"text":"また、その夜は、はらむことのないように。喜びの声がそのうちに聞かれないように。"},{"ref":"Job.3.8","start":18003008,"end":18003008,"break":"line","breaks":[[18,"line"],[35,"line"]],"ruby":[[0,1,"ひ"],[5,1,"もの"],[24,1,"ふる"],[26,1,"おこ"],[29,1,"たく"],[32,1,"もの"]],"text":"日をのろう者が、これをのろうように。レビヤタンを奮い起すに巧みな者が、これをのろうように。"},{"ref":"Job.3.9","start":18003009,"end":18003009,"break":"line","breaks":[[15,"line"],[31,"line"]],"ruby":[[2,1,"あ"],[5,1,"ほし"],[7,1,"くら"],[15,1,"ひかり"],[17,1,"のぞ"],[22,1,"え"],[43,1,"み"]],"text":"その明けの星は暗くなるように。光を望んでも、得られないように。また、あけぼののまぶたを見ることのないように。"},{"ref":"Job.3.10","start":18003010,"end":18003010,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"はは"],[10,1,"たい"],[12,1,"と"],[14,1,"と"],[20,1,"なや"],[27,1,"め"],[29,1,"かく"]],"text":"これは、わたしの母の胎の戸を閉じず、また悩みをわたしの目に隠さなかったからである。"},{"ref":"Job.3.11","start":18003011,"end":18003011,"break":"stanza","breaks":[[24,"line"]],"ruby":[[9,1,"たい"],[12,1,"で"],[15,1,"し"],[24,1,"はら"],[27,1,"で"],[31,1,"いき"],[33,1,"た"]],"text":"なにゆえ、わたしは胎から出て、死ななかったのか。腹から出たとき息が絶えなかったのか。"},{"ref":"Job.3.12","start":18003012,"end":18003012,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[13,1,"う"],[24,1,"ち"],[39,1,"す"]],"text":"なにゆえ、ひざが、わたしを受けたのか。なにゆえ、乳ぶさがあって、わたしはそれを吸ったのか。"},{"ref":"Job.3.13","start":18003013,"end":18003013,"break":"line","breaks":[[11,"line"],[29,"line"]],"ruby":[[15,1,"ふ"],[18,1,"やす"],[21,1,"ねむ"],[38,1,"やす"]],"text":"そうしなかったならば、わたしは伏して休み、眠ったであろう。そうすればわたしは安んじており、"},{"ref":"Job.3.14","start":18003014,"end":18003014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"じぶん"],[6,1,"あ"],[8,1,"あと"],[10,1,"きず"],[12,1,"なお"],[15,1,"ち"],[17,1,"おう"],[21,2,"さんぎ"]],"text":"自分のために荒れ跡を築き直した地の王たち、参議たち、"},{"ref":"Job.3.15","start":18003015,"end":18003015,"break":"line","breaks":[[12,"line"],[23,"line"]],"ruby":[[9,1,"も"],[17,1,"いえ"],[19,1,"み"],[23,1,"きみ"],[27,2,"いっしょ"]],"text":"あるいは、こがねを持ち、しろがねを家に満たした君たちと一緒にいたであろう。"},{"ref":"Job.3.16","start":18003016,"end":18003016,"break":"line","breaks":[[23,"line"]],"ruby":[[9,2,"ひとし"],[16,2,"たいじ"],[23,1,"ひかり"],[25,1,"み"]],"text":"なにゆえ、わたしは人知れずおりる胎児のごとく、光を見ないみどりごのようでなかったのか。"},{"ref":"Job.3.17","start":18003017,"end":18003017,"break":"line","breaks":[[19,"line"]],"ruby":[[5,2,"あくにん"],[21,1,"つか"],[24,1,"もの"],[27,1,"やす"],[30,1,"え"]],"text":"かしこでは悪人も、あばれることをやめ、うみ疲れた者も、休みを得、"},{"ref":"Job.3.18","start":18003018,"end":18003018,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"とら"],[3,1,"びと"],[5,1,"とも"],[7,1,"やす"],[14,1,"お"],[16,1,"つか"],[18,1,"もの"],[20,1,"こえ"],[22,1,"き"]],"text":"捕われ人も共に安らかにおり、追い使う者の声を聞かない。"},{"ref":"Job.3.19","start":18003019,"end":18003019,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ちい"],[3,1,"もの"],[5,1,"おお"],[8,1,"もの"],[16,2,"どれい"],[22,2,"しゅじん"],[26,1,"と"],[28,1,"はな"]],"text":"小さい者も大きい者もそこにおり、奴隷も、その主人から解き放される。"},{"ref":"Job.3.20","start":18003020,"end":18003020,"break":"stanza","breaks":[[14,"line"]],"ruby":[[5,1,"なや"],[7,1,"もの"],[9,1,"ひかり"],[11,1,"たま"],[14,1,"こころ"],[16,1,"くる"],[19,1,"もの"],[21,1,"いのち"],[23,1,"たま"]],"text":"なにゆえ、悩む者に光を賜い、心の苦しむ者に命を賜わったのか。"},{"ref":"Job.3.21","start":18003021,"end":18003021,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[5,1,"ひと"],[7,1,"し"],[9,1,"のぞ"],[13,1,"こ"],[20,1,"もと"],[26,1,"かく"],[29,1,"たから"],[31,1,"ほ"]],"text":"このような人は死を望んでも来ない、これを求めることは隠れた宝を掘るよりも、はなはだしい。"},{"ref":"Job.3.22","start":18003022,"end":18003022,"break":"line","ruby":[[0,1,"かれ"],[3,1,"はか"],[5,1,"み"],[12,2,"ひじょう"],[15,1,"よろこ"],[17,1,"たの"]],"text":"彼らは墓を見いだすとき、非常に喜び楽しむのだ。"},{"ref":"Job.3.23","start":18003023,"end":18003023,"break":"line","breaks":[[16,"line"]],"ruby":[[7,1,"みち"],[9,1,"かく"],[13,1,"ひと"],[16,1,"かみ"],[29,1,"ひと"],[32,1,"ひかり"],[34,1,"たま"]],"text":"なにゆえ、その道の隠された人に、神が、まがきをめぐらされた人に、光を賜わるのか。"},{"ref":"Job.3.24","start":18003024,"end":18003024,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"なげ"],[9,2,"しょくもつ"],[12,1,"かわ"],[15,1,"きた"],[26,1,"みず"],[31,1,"なが"],[33,1,"で"]],"text":"わたしの嘆きはわが食物に代って来り、わたしのうめきは水のように流れ出る。"},{"ref":"Job.3.25","start":18003025,"end":18003025,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"おそ"],[15,1,"のぞ"],[22,1,"おそ"],[34,1,"み"],[36,1,"およ"]],"text":"わたしの恐れるものが、わたしに臨み、わたしの恐れおののくものが、わが身に及ぶ。"},{"ref":"Job.3.26","start":18003026,"end":18003026,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"やす"],[25,1,"やす"],[28,1,"え"],[34,1,"なや"],[39,1,"く"]],"text":"わたしは安らかでなく、またおだやかでない。わたしは休みを得ない、ただ悩みのみが来る」。"}]