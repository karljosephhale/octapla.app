[{"ref":"2Chr.12.1","start":14012001,"end":14012001,"break":"paragraph","ruby":[[8,1,"くに"],[10,1,"かた"],[12,1,"た"],[15,1,"つよ"],[20,1,"およ"],[24,1,"しゅ"],[30,1,"す"],[40,1,"みな"],[41,1,"かれ"]],"text":"レハベアムはその国が堅く立ち、強くなるに及んで、主のおきてを捨てた。イスラエルも皆彼にならった。"},{"ref":"2Chr.12.2","start":14012002,"end":14012002,"break":"none","ruby":[[0,1,"かれ"],[8,1,"しゅ"],[10,1,"む"],[14,1,"つみ"],[16,1,"おか"],[27,1,"おう"],[30,1,"ねん"],[37,1,"おう"],[49,1,"せ"],[51,1,"のぼ"]],"text":"彼らがこのように主に向かって罪を犯したので、レハベアム王の五年にエジプトの王シシャクがエルサレムに攻め上ってきた。"},{"ref":"2Chr.12.3","start":14012003,"end":14012003,"break":"none","ruby":[[2,2,"せんしゃ"],[10,2,"きへい"],[18,1,"かれ"],[20,1,"したが"],[29,1,"き"],[31,1,"たみ"],[56,2,"むすう"]],"text":"その戦車は一千二百、騎兵は六万、また彼に従ってエジプトから来た民、すなわちリビアびと、スキびと、エチオピヤびとは無数であった。"},{"ref":"2Chr.12.4","start":14012004,"end":14012004,"break":"none","ruby":[[8,2,"ようがい"],[11,2,"まちまち"],[14,1,"と"],[23,1,"せま"],[26,1,"き"]],"text":"シシャクはユダの要害の町々を取り、エルサレムに迫って来た。"},{"ref":"2Chr.12.5","start":14012005,"end":14012005,"break":"none","ruby":[[3,3,"よげんしゃ"],[34,1,"あつ"],[52,1,"い"],[57,1,"しゅ"],[61,1,"おお"],[78,1,"す"],[94,1,"す"]],"text":"そこで預言者シマヤは、レハベアムおよびシシャクのゆえに、エルサレムに集まったユダのつかさたちのもとにきて言った、「主はこう仰せられる、『あなたがたはわたしを捨てたので、わたしもあなたがたを捨ててシシャクにわたした』と」。"},{"ref":"2Chr.12.6","start":14012006,"end":14012006,"break":"none","ruby":[[18,1,"おう"],[28,1,"しゅ"],[30,1,"ただ"],[35,1,"い"]],"text":"そこでイスラエルのつかさたち、および王はへりくだって、「主は正しい」と言った。"},{"ref":"2Chr.12.7","start":14012007,"end":14012007,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[12,1,"み"],[19,1,"しゅ"],[21,2,"ことば"],[32,1,"い"],[37,1,"かれ"],[53,1,"かれ"],[56,1,"ほろ"],[63,1,"ま"],[67,1,"すくい"],[69,1,"ほどこ"],[81,1,"て"],[87,1,"いか"],[96,1,"そそ"]],"text":"主は彼らのへりくだるのを見られたので、主の言葉がシマヤにのぞんで言った、「彼らがへりくだったから、わたしは彼らを滅ぼさないで、間もなく救を施す。わたしはシシャクの手によって、怒りをエルサレムに注ぐことをしない。"},{"ref":"2Chr.12.8","start":14012008,"end":14012008,"break":"none","ruby":[[3,1,"かれ"],[21,1,"かれ"],[28,1,"つか"],[35,2,"くにぐに"],[38,1,"おう"],[42,1,"つか"],[49,2,"そうい"],[52,1,"し"]],"text":"しかし彼らはシシャクのしもべになる。これは彼らがわたしに仕えることと、国々の王たちに仕えることとの相違を知るためである」。"},{"ref":"2Chr.12.9","start":14012009,"end":14012009,"break":"paragraph","ruby":[[5,1,"おう"],[17,1,"せ"],[24,1,"しゅ"],[26,1,"みや"],[28,2,"ほうもつ"],[32,1,"おう"],[34,1,"いえ"],[36,2,"ほうもつ"],[40,1,"うば"],[42,1,"さ"],[59,1,"うば"],[61,1,"さ"],[71,1,"つく"],[74,1,"きん"],[76,1,"たて"],[79,1,"うば"],[81,1,"さ"]],"text":"エジプトの王シシャクはエルサレムに攻めのぼって、主の宮の宝物と、王の家の宝物とを奪い去った。すなわちそれらをことごとく奪い去り、またソロモンの造った金の盾をも奪い去った。"},{"ref":"2Chr.12.10","start":14012010,"end":14012010,"break":"none","ruby":[[8,1,"おう"],[13,1,"かわ"],[16,2,"せいどう"],[19,1,"たて"],[21,1,"つく"],[25,1,"おう"],[27,1,"いえ"],[29,1,"もん"],[31,1,"まも"],[33,2,"じえい"],[35,1,"ちょう"],[39,1,"て"],[41,1,"わた"]],"text":"それでレハベアム王は、その代りに青銅の盾を造って、王の家の門を守る侍衛長たちの手に渡した。"},{"ref":"2Chr.12.11","start":14012011,"end":14012011,"break":"none","ruby":[[0,1,"おう"],[2,1,"しゅ"],[4,1,"みや"],[12,2,"じえい"],[15,1,"き"],[21,1,"お"],[29,2,"じえい"],[35,1,"も"],[38,1,"かえ"]],"text":"王が主の宮にはいるごとに侍衛は来て、これを負い、またこれを侍衛のへやへ持って帰った。"},{"ref":"2Chr.12.12","start":14012012,"end":14012012,"break":"none","ruby":[[14,1,"しゅ"],[16,1,"いか"],[19,1,"かれ"],[21,1,"はな"],[24,1,"かれ"],[31,1,"ほろ"],[49,2,"じじょう"]],"text":"レハベアムがへりくだったので主の怒りは彼を離れ、彼をことごとく滅ぼそうとはされなかった。またユダの事情もよくなった。"},{"ref":"2Chr.12.13","start":14012013,"end":14012013,"break":"paragraph","ruby":[[5,1,"おう"],[13,2,"じぶん"],[16,2,"ちい"],[19,2,"かくりつ"],[23,1,"よ"],[25,1,"おさ"],[42,1,"さい"],[46,1,"くらい"],[53,1,"ねん"],[55,1,"あいだ"],[62,1,"よ"],[64,1,"おさ"],[74,1,"しゅ"],[78,1,"な"],[80,1,"お"],[95,2,"ぶぞく"],[102,1,"えら"],[106,1,"まち"],[111,1,"かれ"],[113,1,"はは"],[120,1,"おんな"],[123,1,"な"]],"text":"レハベアム王はエルサレムで自分の地位を確立し、世を治めた。すなわちレハベアムは四十一歳のとき位につき、十七年の間エルサレムで世を治めた。エルサレムは主がその名を置くためにイスラエルのすべての部族のうちから選ばれた町である。彼の母はアンモンの女で、名をナアマといった。"},{"ref":"2Chr.12.14","start":14012014,"end":14012014,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"もと"],[14,1,"こころ"],[16,1,"かたむ"],[22,1,"わる"],[24,1,"こと"],[26,1,"おこな"]],"text":"レハベアムは主を求めることに心を傾けないで、悪い事を行った。"},{"ref":"2Chr.12.15","start":14012015,"end":14012015,"break":"paragraph","ruby":[[6,2,"しじゅう"],[9,2,"こうい"],[13,3,"よげんしゃ"],[22,3,"せんけんしゃ"],[28,1,"しょ"],[56,1,"あいだ"],[59,1,"た"],[62,2,"せんそう"]],"text":"レハベアムの始終の行為は、預言者シマヤおよび先見者イドの書にしるされているではないか。レハベアムとヤラベアムとの間には絶えず戦争があった。"},{"ref":"2Chr.12.16","start":14012016,"end":14012016,"break":"none","ruby":[[8,2,"せんぞ"],[13,1,"とも"],[15,1,"ねむ"],[23,1,"まち"],[25,1,"ほうむ"],[31,1,"こ"],[36,1,"かれ"],[38,1,"かわ"],[41,1,"おう"]],"text":"レハベアムはその先祖たちと共に眠って、ダビデの町に葬られ、その子アビヤが彼に代って王となった。"}]