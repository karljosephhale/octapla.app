[{"ref":"Ps.77.1","start":19077001,"end":19077001,"break":"paragraph","title":"聖歌隊の指揮者によってエドトンのしらべにしたがってうたわせたアサフの歌","breaks":[[17,"line"],[34,"line"]],"ruby":[[4,1,"かみ"],[9,1,"こえ"],[14,1,"さけ"],[21,1,"かみ"],[27,1,"こえ"],[34,1,"かみ"],[40,1,"き"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[34,1,"うた"]],"text":"わたしは神にむかい声をあげて叫ぶ。わたしが神にむかって声をあげれば、神はわたしに聞かれる。"},{"ref":"Ps.77.2","start":19077002,"end":19077002,"break":"line","breaks":[[17,"line"],[34,"line"]],"ruby":[[4,1,"なや"],[7,1,"ひ"],[9,1,"しゅ"],[14,1,"もと"],[17,1,"よる"],[21,1,"て"],[23,1,"の"],[36,1,"たましい"],[38,1,"なぐさ"],[45,1,"こば"]],"text":"わたしは悩みの日に主をたずね求め、夜はわが手を伸べてたゆむことなく、わが魂は慰められるのを拒む。"},{"ref":"Ps.77.3","start":19077003,"end":19077003,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"かみ"],[6,1,"おも"],[11,1,"なげ"],[13,1,"かな"],[17,1,"ふか"],[19,1,"おも"],[26,1,"たましい"],[28,1,"おとろ"]],"text":"わたしは神を思うとき、嘆き悲しみ、深く思うとき、わが魂は衰える。〔セラ"},{"ref":"Ps.77.4","start":19077004,"end":19077004,"break":"line","breaks":[[22,"line"]],"ruby":[[16,1,"と"],[26,2,"ものい"],[39,1,"なや"]],"text":"あなたはわたしのまぶたをささえて閉じさせず、わたしは物言うこともできないほどに悩む。"},{"ref":"Ps.77.5","start":19077005,"end":19077005,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"むかし"],[6,1,"ひ"],[8,1,"おも"],[16,1,"とし"],[18,1,"おも"]],"text":"わたしは昔の日を思い、いにしえの年を思う。"},{"ref":"Ps.77.6","start":19077006,"end":19077006,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"よる"],[8,1,"こころ"],[10,1,"した"],[13,1,"かた"],[16,1,"ふか"],[18,1,"おも"],[23,1,"たましい"],[25,1,"さぐ"],[28,1,"い"]],"text":"わたしは夜、わが心と親しく語り、深く思うてわが魂を探り、言う、"},{"ref":"Ps.77.7","start":19077007,"end":19077007,"break":"line","breaks":[[23,"line"]],"ruby":[[1,1,"しゅ"],[12,1,"す"],[32,1,"ほどこ"]],"text":"「主はとこしえにわれらを捨てられるであろうか。ふたたび、めぐみを施されないであろうか。"},{"ref":"Ps.77.8","start":19077008,"end":19077008,"break":"line","breaks":[[16,"line"]],"ruby":[[13,1,"た"],[18,2,"やくそく"],[21,2,"よよ"]],"text":"そのいつくしみはとこしえに絶え、その約束は世々ながくすたれるであろうか。"},{"ref":"Ps.77.9","start":19077009,"end":19077009,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かみ"],[2,1,"めぐ"],[5,1,"ほどこ"],[10,1,"わす"],[13,1,"いか"],[26,1,"と"]],"text":"神は恵みを施すことを忘れ、怒りをもってそのあわれみを閉じられたであろうか」と。〔セラ"},{"ref":"Ps.77.10","start":19077010,"end":19077010,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"とき"],[7,1,"い"],[15,1,"かな"],[21,1,"たか"],[23,1,"もの"],[25,1,"みぎ"],[27,1,"て"],[29,1,"かわ"]],"text":"その時わたしは言う、「わたしの悲しみはいと高き者の右の手が変ったことである」と。"},{"ref":"Ps.77.11","start":19077011,"end":19077011,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[4,1,"しゅ"],[10,1,"おも"],[12,1,"おこ"],[39,1,"おも"]],"text":"わたしは主のみわざを思い起す。わたしは、いにしえからのあなたのくすしきみわざを思いいだす。"},{"ref":"Ps.77.12","start":19077012,"end":19077012,"break":"line","breaks":[[20,"line"]],"ruby":[[17,1,"おも"],[24,1,"ちから"],[31,1,"ふか"],[33,1,"おも"]],"text":"わたしは、あなたのすべてのみわざを思い、あなたの力あるみわざを深く思う。"},{"ref":"Ps.77.13","start":19077013,"end":19077013,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[7,1,"みち"],[9,1,"せい"],[18,1,"かみ"],[23,1,"おお"],[27,1,"かみ"]],"text":"神よ、あなたの道は聖である。われらの神のように大いなる神はだれか。"},{"ref":"Ps.77.14","start":19077014,"end":19077014,"break":"line","breaks":[[22,"line"]],"ruby":[[13,1,"おこな"],[17,1,"かみ"],[32,1,"たみ"],[34,1,"あいだ"],[39,2,"たいのう"]],"text":"あなたは、くすしきみわざを行われる神である。あなたは、もろもろの民の間に、その大能をあらわし、"},{"ref":"Ps.77.15","start":19077015,"end":19077015,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"うで"],[11,1,"たみ"],[26,1,"こ"]],"text":"その腕をもっておのれの民をあがない、ヤコブとヨセフの子らをあがなわれた。〔セラ"},{"ref":"Ps.77.16","start":19077016,"end":19077016,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かみ"],[3,2,"おおみず"],[10,1,"み"],[13,2,"おおみず"],[20,1,"み"],[27,1,"ふち"],[31,1,"ふる"]],"text":"神よ、大水はあなたを見た。大水はあなたを見ておののき、淵もまた震えた。"},{"ref":"Ps.77.17","start":19077017,"end":19077017,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"くも"],[2,1,"みず"],[4,1,"そそ"],[10,1,"そら"],[12,1,"かみなり"],[24,1,"や"],[26,2,"しほう"]],"text":"雲は水を注ぎいだし、空は雷をとどろかし、あなたの矢は四方にきらめいた。"},{"ref":"Ps.77.18","start":19077018,"end":19077018,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"かみなり"],[15,1,"かぜ"],[17,1,"なか"],[31,1,"よ"],[33,1,"てら"],[36,1,"ち"],[38,1,"ふる"],[40,1,"うご"]],"text":"あなたの雷のとどろきは、つむじ風の中にあり、あなたのいなずまは世を照し、地は震い動いた。"},{"ref":"Ps.77.19","start":19077019,"end":19077019,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[4,2,"おおじ"],[7,1,"うみ"],[9,1,"なか"],[18,1,"みち"],[20,2,"おおみず"],[23,1,"なか"],[32,2,"あしあと"]],"text":"あなたの大路は海の中にあり、あなたの道は大水の中にあり、あなたの足跡はたずねえなかった。"},{"ref":"Ps.77.20","start":19077020,"end":19077020,"break":"line","breaks":[[22,"line"]],"ruby":[[7,1,"たみ"],[17,1,"て"],[22,1,"ひつじ"],[24,1,"む"],[30,1,"みちび"]],"text":"あなたは、その民をモーセとアロンの手によって羊の群れのように導かれた。"}]