[{"ref":"Ezek.11.1","start":26011001,"end":26011001,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"れい"],[12,1,"ひがし"],[14,1,"む"],[17,1,"しゅ"],[19,1,"みや"],[21,1,"ひがし"],[23,1,"もん"],[25,1,"つ"],[28,1,"い"],[32,1,"み"],[37,1,"もん"],[39,2,"いりぐち"],[45,1,"にん"],[47,1,"もの"],[58,1,"なか"],[64,1,"こ"],[75,1,"こ"],[81,1,"み"],[84,1,"とも"],[86,1,"たみ"]],"text":"時に霊はわたしをあげて、東に向かう主の宮の東の門に連れて行った。見よ、その門の入口に二十五人の者がいた。わたしはその中にアズルの子ヤザニヤと、ベナヤの子ペラテヤを見た。共に民のつかさであった。"},{"ref":"Ezek.11.2","start":26011002,"end":26011002,"break":"none","ruby":[[3,1,"かれ"],[9,1,"い"],[15,1,"ひと"],[17,1,"こ"],[24,1,"もの"],[28,1,"まち"],[30,1,"なか"],[32,1,"わる"],[34,1,"こと"],[36,1,"かんが"],[39,1,"わる"],[41,1,"はか"],[50,2,"ひとびと"]],"text":"すると彼はわたしに言われた、「人の子よ、これらの者はこの町の中で悪い事を考え、悪い計りごとをめぐらす人々である。"},{"ref":"Ezek.11.3","start":26011003,"end":26011003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[7,1,"いえ"],[9,1,"た"],[12,1,"とき"],[14,1,"ちか"],[22,1,"まち"],[35,1,"にく"]],"text":"彼らは言う、『家を建てる時は近くはない。この町はなべであり、われわれは肉である』と。"},{"ref":"Ezek.11.4","start":26011004,"end":26011004,"break":"none","ruby":[[5,1,"かれ"],[8,1,"む"],[12,2,"よげん"],[17,1,"ひと"],[19,1,"こ"],[22,2,"よげん"]],"text":"それゆえ、彼らに向かって預言せよ。人の子よ、預言せよ」。"},{"ref":"Ezek.11.5","start":26011005,"end":26011005,"break":"paragraph","ruby":[[0,1,"とき"],[3,1,"しゅ"],[5,1,"れい"],[11,1,"くだ"],[19,1,"い"],[25,1,"しゅ"],[29,1,"い"],[34,1,"い"],[43,1,"いえ"],[46,1,"かんが"],[62,1,"こころ"],[66,1,"こと"],[70,1,"し"]],"text":"時に、主の霊がわたしに下って、わたしに言われた、「主はこう言われると言え、イスラエルの家よ、考えてみよ。わたしはあなたがたの心にある事どもを知っている。"},{"ref":"Ezek.11.6","start":26011006,"end":26011006,"break":"none","ruby":[[8,1,"まち"],[10,1,"ころ"],[14,1,"もの"],[16,1,"ま"],[19,1,"ころ"],[23,1,"もの"],[32,1,"み"]],"text":"あなたがたはこの町に殺される者を増し、殺された者をもってちまたを満たした。"},{"ref":"Ezek.11.7","start":26011007,"end":26011007,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[17,1,"まち"],[19,1,"なか"],[27,1,"お"],[29,1,"ころ"],[33,1,"もの"],[35,1,"にく"],[42,1,"まち"],[62,1,"なか"],[65,1,"と"],[67,1,"だ"]],"text":"それゆえ、主なる神はこう言われる、町の中にあなたがたが置く殺された者は肉である。この町はなべである。しかし、あなたがたはその中から取り出される。"},{"ref":"Ezek.11.8","start":26011008,"end":26011008,"break":"none","ruby":[[10,1,"おそ"],[28,1,"のぞ"],[34,1,"しゅ"],[36,1,"い"]],"text":"あなたがたはつるぎを恐れた。わたしはあなたがたにつるぎを臨ませると、主は言われる。"},{"ref":"Ezek.11.9","start":26011009,"end":26011009,"break":"none","ruby":[[14,1,"なか"],[17,1,"ひ"],[19,1,"だ"],[23,2,"たこく"],[25,1,"じん"],[27,1,"て"],[29,1,"わた"]],"text":"またわたしはあなたがたをその中から引き出して、他国人の手に渡し、あなたがたをさばく。"},{"ref":"Ezek.11.10","start":26011010,"end":26011010,"break":"none","ruby":[[10,1,"たお"],[30,1,"さかい"],[52,1,"しゅ"],[59,1,"し"]],"text":"あなたがたはつるぎに倒れる。わたしはあなたがたをイスラエルの境でさばく。これによってあなたがたはわたしが主であることを知るようになる。"},{"ref":"Ezek.11.11","start":26011011,"end":26011011,"break":"none","ruby":[[2,1,"まち"],[10,1,"たい"],[29,1,"にく"],[47,1,"さかい"]],"text":"この町はあなたがたに対してなべとはならず、あなたがたはその肉とはならない。わたしはイスラエルの境であなたがたをさばく。"},{"ref":"Ezek.11.12","start":26011012,"end":26011012,"break":"none","ruby":[[17,1,"しゅ"],[24,1,"し"],[42,1,"さだ"],[45,1,"あゆ"],[59,1,"おこな"],[69,2,"しゅうい"],[72,2,"たこく"],[74,1,"じん"],[80,1,"したが"],[83,1,"おこな"]],"text":"これによって、あなたがたはわたしが主であることを知るようになる。あなたがたはわたしの定めに歩まず、またわたしのおきてを行わず、かえってその周囲の他国人のおきてに従って行っているからである」。"},{"ref":"Ezek.11.13","start":26011013,"end":26011013,"break":"paragraph","ruby":[[9,2,"よげん"],[15,1,"とき"],[21,1,"こ"],[27,1,"し"],[37,1,"う"],[39,1,"ふ"],[43,2,"おおごえ"],[46,1,"さけ"],[49,1,"い"],[56,1,"しゅ"],[59,1,"かみ"],[72,1,"のこ"],[75,1,"もの"],[82,1,"ほろ"]],"text":"このようにわたしが預言していた時、ベナヤの子ペラテヤが死んだので、わたしは打ち伏して、大声で叫んで言った、「ああ主なる神よ、あなたはイスラエルの残りの者をことごとく滅ぼそうとされるのですか」。"},{"ref":"Ezek.11.14","start":26011014,"end":26011014,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,2,"ことば"],[11,1,"のぞ"],[14,1,"い"]],"text":"時に主の言葉がわたしに臨んで言った、"},{"ref":"Ezek.11.15","start":26011015,"end":26011015,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,2,"きょうだい"],[17,1,"とも"],[23,2,"きょうだい"],[28,1,"とら"],[31,1,"びと"],[39,2,"ぜんか"],[48,2,"じゅうみん"],[51,1,"い"],[56,1,"かれ"],[59,1,"しゅ"],[62,1,"とお"],[64,1,"はな"],[70,1,"ち"],[77,2,"しょゆう"],[82,1,"あた"]],"text":"「人の子よ、あなたの兄弟、あなたの友、あなたの兄弟である捕われ人、イスラエルの全家、エルサレムの住民は言った、『彼らが主から遠く離れた。この地はわれわれの所有として与えられているのだ』と。"},{"ref":"Ezek.11.16","start":26011016,"end":26011016,"break":"none","ruby":[[5,1,"い"],[9,1,"しゅ"],[12,1,"かみ"],[16,1,"い"],[28,1,"かれ"],[31,1,"とお"],[33,2,"たこく"],[35,1,"じん"],[37,1,"なか"],[39,1,"うつ"],[42,2,"くにぐに"],[45,1,"なか"],[47,1,"ち"],[53,1,"かれ"],[56,1,"い"],[59,2,"くにぐに"],[71,1,"かれ"],[77,2,"せいじょ"]],"text":"それゆえ、言え、『主なる神はこう言われる、たといわたしは彼らを遠く他国人の中に移し、国々の中に散らしても、彼らの行った国々で、わたしはしばらく彼らのために聖所となる』と。"},{"ref":"Ezek.11.17","start":26011017,"end":26011017,"break":"none","ruby":[[5,1,"い"],[9,1,"しゅ"],[13,1,"い"],[33,1,"たみ"],[35,1,"なか"],[38,1,"あつ"],[43,1,"ち"],[48,2,"くにぐに"],[52,1,"あつ"],[62,1,"ち"],[70,1,"あた"]],"text":"それゆえ、言え、『主はこう言われる、わたしはあなたがたをもろもろの民の中から集め、その散らされた国々から集めて、イスラエルの地をあなたがたに与える』と。"},{"ref":"Ezek.11.18","start":26011018,"end":26011018,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ところ"],[7,1,"く"],[9,1,"とき"],[32,1,"にく"],[42,1,"ところ"],[45,1,"と"],[47,1,"のぞ"]],"text":"彼らはその所に来る時、そのもろもろのいとうべきものと、もろもろの憎むべきものとをその所から取り除く。"},{"ref":"Ezek.11.19","start":26011019,"end":26011019,"break":"none","ruby":[[7,1,"かれ"],[13,1,"こころ"],[15,1,"あた"],[18,1,"かれ"],[24,1,"あたら"],[27,1,"れい"],[29,1,"さづ"],[32,1,"かれ"],[35,1,"にく"],[38,1,"いし"],[40,1,"こころ"],[42,1,"と"],[44,1,"さ"],[48,1,"にく"],[50,1,"こころ"],[52,1,"あた"]],"text":"そしてわたしは彼らに一つの心を与え、彼らのうちに新しい霊を授け、彼らの肉から石の心を取り去って、肉の心を与える。"},{"ref":"Ezek.11.20","start":26011020,"end":26011020,"break":"none","ruby":[[3,1,"かれ"],[10,1,"さだ"],[13,1,"あゆ"],[24,1,"まも"],[27,1,"おこな"],[33,1,"かれ"],[40,1,"たみ"],[49,1,"かれ"],[52,1,"かみ"]],"text":"これは彼らがわたしの定めに歩み、わたしのおきてを守って行い、そして彼らがわたしの民となり、わたしが彼らの神となるためである。"},{"ref":"Ezek.11.21","start":26011021,"end":26011021,"break":"none","ruby":[[11,1,"にく"],[20,1,"こころ"],[22,1,"した"],[25,1,"あゆ"],[27,1,"もの"],[31,1,"かれ"],[34,1,"おこな"],[37,1,"したが"],[46,1,"むく"],[51,1,"しゅ"],[54,1,"かみ"],[56,1,"い"]],"text":"しかしいとうべきもの、憎むべきものをその心に慕って歩む者には、彼らの行いに従ってそのこうべに報いると、主なる神は言われる」。"},{"ref":"Ezek.11.22","start":26011022,"end":26011022,"break":"paragraph","ruby":[[0,1,"とき"],[9,1,"つばさ"],[15,1,"わ"],[33,1,"かみ"],[35,2,"えいこう"],[40,1,"うえ"]],"text":"時にケルビムはその翼をあげた。輪がそのかたわらにあり、イスラエルの神の栄光がその上にあった。"},{"ref":"Ezek.11.23","start":26011023,"end":26011023,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"えいこう"],[5,1,"まち"],[7,1,"なか"],[15,1,"まち"],[17,1,"ひがし"],[21,1,"やま"],[23,1,"うえ"],[25,1,"た"]],"text":"主の栄光が町の中からのぼって、町の東にある山の上に立ちどまった。"},{"ref":"Ezek.11.24","start":26011024,"end":26011024,"break":"none","ruby":[[2,1,"とき"],[4,1,"れい"],[13,1,"かみ"],[15,1,"れい"],[21,1,"まぼろし"],[35,1,"とら"],[38,1,"びと"],[40,1,"ところ"],[42,1,"たずさ"],[45,1,"い"],[56,1,"み"],[58,1,"まぼろし"],[64,1,"はな"]],"text":"その時、霊はわたしをあげ、神の霊によって、幻のうちにわたしをカルデヤの捕われ人の所へ携えて行った。そしてわたしが見た幻はわたしを離れてのぼった。"},{"ref":"Ezek.11.25","start":26011025,"end":26011025,"break":"none","ruby":[[7,1,"しゅ"],[13,1,"しめ"],[17,1,"こと"],[26,1,"とら"],[29,1,"びと"],[31,1,"つ"]],"text":"そこでわたしは主がわたしに示された事をことごとくかの捕われ人に告げた。"}]