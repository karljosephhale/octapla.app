[{"ref":"Exod.9.1","start":2009001,"end":2009001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[18,1,"い"],[22,1,"かれ"],[24,1,"い"],[37,1,"かみ"],[39,1,"しゅ"],[43,1,"おお"],[54,1,"たみ"],[56,1,"さ"],[65,1,"つか"]],"text":"主はモーセに言われた、「パロのもとに行って、彼に言いなさい、『ヘブルびとの神、主はこう仰せられる、「わたしの民を去らせて、わたしに仕えさせなさい。"},{"ref":"Exod.9.2","start":2009002,"end":2009002,"break":"none","ruby":[[6,1,"かれ"],[9,1,"さ"],[16,1,"こば"],[22,1,"かれ"],[25,1,"と"]],"text":"あなたがもし彼らを去らせることを拒んで、なお彼らを留めおくならば、"},{"ref":"Exod.9.3","start":2009003,"end":2009003,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"て"],[4,1,"もっと"],[6,1,"はげ"],[9,2,"えきびょう"],[16,1,"の"],[24,2,"かちく"],[31,1,"うま"],[40,1,"うし"],[42,1,"ひつじ"],[44,1,"うえ"],[46,1,"のぞ"]],"text":"主の手は最も激しい疫病をもって、野にいるあなたの家畜、すなわち馬、ろば、らくだ、牛、羊の上に臨むであろう。"},{"ref":"Exod.9.4","start":2009004,"end":2009004,"break":"none","ruby":[[4,1,"しゅ"],[12,2,"かちく"],[21,2,"かちく"],[24,2,"くべつ"],[38,2,"ひとびと"],[41,1,"ぞく"],[49,1,"とう"],[51,1,"し"]],"text":"しかし、主はイスラエルの家畜と、エジプトの家畜を区別され、すべてイスラエルの人々に属するものには一頭も死ぬものがないであろう」と』」。"},{"ref":"Exod.9.5","start":2009005,"end":2009005,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"とき"],[8,1,"さだ"],[11,1,"おお"],[21,1,"しゅ"],[28,1,"くに"],[30,1,"おこな"]],"text":"主は、また、時を定めて仰せられた、「あす、主はこのことを国に行うであろう」。"},{"ref":"Exod.9.6","start":2009006,"end":2009006,"break":"none","ruby":[[3,1,"ひ"],[5,1,"しゅ"],[12,1,"おこな"],[26,2,"かちく"],[31,1,"し"],[45,2,"ひとびと"],[48,2,"かちく"],[52,1,"とう"],[54,1,"し"]],"text":"あくる日、主はこのことを行われたので、エジプトびとの家畜はみな死んだ。しかし、イスラエルの人々の家畜は一頭も死ななかった。"},{"ref":"Exod.9.7","start":2009007,"end":2009007,"break":"none","ruby":[[3,1,"ひと"],[10,1,"み"],[22,2,"かちく"],[26,1,"とう"],[28,1,"し"],[44,1,"こころ"],[52,1,"たみ"],[54,1,"さ"]],"text":"パロは人をつかわして見させたが、イスラエルの家畜は一頭も死んでいなかった。それでもパロの心はかたくなで、民を去らせなかった。"},{"ref":"Exod.9.8","start":2009008,"end":2009008,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"い"],[30,1,"りょう"],[31,1,"て"],[36,1,"と"],[49,1,"め"],[51,1,"まえ"],[53,1,"てん"],[62,1,"ち"]],"text":"主はモーセとアロンに言われた、「あなたがたは、かまどのすすを両手いっぱい取り、それをモーセはパロの目の前で天にむかって、まき散らしなさい。"},{"ref":"Exod.9.9","start":2009009,"end":2009009,"break":"none","ruby":[[8,2,"ぜんこく"],[16,1,"こま"],[29,2,"ぜんこく"],[32,1,"ひと"],[34,1,"けもの"],[36,1,"つ"],[43,1,"で"]],"text":"それはエジプトの全国にわたって、細かいちりとなり、エジプト全国で人と獣に付いて、うみの出るはれものとなるであろう」。"},{"ref":"Exod.9.10","start":2009010,"end":2009010,"break":"none","ruby":[[3,1,"かれ"],[14,1,"と"],[20,1,"まえ"],[22,1,"た"],[29,1,"てん"],[40,1,"ち"],[47,1,"ひと"],[49,1,"けもの"],[51,1,"つ"],[58,1,"で"]],"text":"そこで彼らは、かまどのすすを取ってパロの前に立ち、モーセは天にむかってこれをまき散らしたので、人と獣に付いて、うみの出るはれものとなった。"},{"ref":"Exod.9.11","start":2009011,"end":2009011,"break":"none","ruby":[[0,2,"まじゅつ"],[2,1,"し"],[18,1,"まえ"],[20,1,"た"],[37,2,"まじゅつ"],[39,1,"し"],[54,1,"しょう"]],"text":"魔術師らは、はれもののためにモーセの前に立つことができなかった。はれものが魔術師らと、すべてのエジプトびとに生じたからである。"},{"ref":"Exod.9.12","start":2009012,"end":2009012,"break":"none","ruby":[[4,1,"しゅ"],[9,1,"こころ"],[22,1,"かれ"],[24,1,"しゅ"],[30,1,"かた"],[38,1,"かれ"],[41,1,"い"],[46,1,"き"]],"text":"しかし、主はパロの心をかたくなにされたので、彼は主がモーセに語られたように、彼らの言うことを聞かなかった。"},{"ref":"Exod.9.13","start":2009013,"end":2009013,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[14,1,"あさ"],[15,1,"はや"],[17,1,"お"],[23,1,"まえ"],[25,1,"た"],[29,1,"かれ"],[31,1,"い"],[44,1,"かみ"],[46,1,"しゅ"],[50,1,"おお"],[61,1,"たみ"],[63,1,"さ"],[72,1,"つか"]],"text":"主はまたモーセに言われた、「朝早く起き、パロの前に立って、彼に言いなさい、『ヘブルびとの神、主はこう仰せられる、「わたしの民を去らせて、わたしに仕えさせなさい。"},{"ref":"Exod.9.14","start":2009014,"end":2009014,"break":"none","ruby":[[15,1,"わざわい"],[27,2,"けらい"],[35,1,"たみ"],[45,1,"なら"],[50,1,"ぜん"],[51,1,"ち"],[58,1,"し"]],"text":"わたしは、こんどは、もろもろの災を、あなたと、あなたの家来と、あなたの民にくだし、わたしに並ぶものが全地にないことを知らせるであろう。"},{"ref":"Exod.9.15","start":2009015,"end":2009015,"break":"none","ruby":[[7,1,"て"],[11,1,"の"],[14,2,"えきびょう"],[30,1,"たみ"],[32,1,"う"],[45,1,"ち"],[48,1,"た"],[50,1,"ほろ"]],"text":"わたしがもし、手をさし伸べ、疫病をもって、あなたと、あなたの民を打っていたならば、あなたは地から断ち滅ぼされていたであろう。"},{"ref":"Exod.9.16","start":2009016,"end":2009016,"break":"none","ruby":[[30,1,"ちから"],[32,1,"み"],[47,1,"な"],[49,1,"ぜん"],[50,1,"ち"],[52,1,"の"],[54,1,"つた"]],"text":"しかし、わたしがあなたをながらえさせたのは、あなたにわたしの力を見させるため、そして、わたしの名が全地に宣べ伝えられるためにほかならない。"},{"ref":"Exod.9.17","start":2009017,"end":2009017,"break":"none","ruby":[[15,1,"たみ"],[26,1,"たか"],[30,1,"かれ"],[33,1,"さ"]],"text":"それに、あなたはなお、わたしの民にむかって、おのれを高くし、彼らを去らせようとしない。"},{"ref":"Exod.9.18","start":2009018,"end":2009018,"break":"none","ruby":[[7,1,"いま"],[15,1,"おそ"],[19,1,"おお"],[22,1,"ひょう"],[24,1,"ふ"],[41,1,"くに"],[43,1,"はじ"],[47,1,"ひ"],[50,1,"いま"]],"text":"ゆえに、あすの今ごろ、わたしは恐ろしく大きな雹を降らせるであろう。それはエジプトの国が始まった日から今まで、かつてなかったほどのものである。"},{"ref":"Exod.9.19","start":2009019,"end":2009019,"break":"none","ruby":[[8,1,"ひと"],[18,2,"かちく"],[26,1,"の"],[50,1,"ひと"],[52,1,"けもの"],[58,1,"の"],[63,1,"いえ"],[65,1,"かえ"],[72,1,"ふ"],[74,1,"ひょう"],[76,1,"う"],[80,1,"し"]],"text":"それゆえ、いま、人をやって、あなたの家畜と、あなたが野にもっているすべてのものを、のがれさせなさい。人も獣も、すべて野にあって家に帰らないものは降る雹に打たれて死ぬであろう」と』」。"},{"ref":"Exod.9.20","start":2009020,"end":2009020,"break":"none","ruby":[[3,2,"けらい"],[9,1,"しゅ"],[11,2,"ことば"],[18,1,"もの"],[27,2,"かちく"],[30,1,"いえ"]],"text":"パロの家来のうち、主の言葉をおそれる者は、そのしもべと家畜を家にのがれさせたが、"},{"ref":"Exod.9.21","start":2009021,"end":2009021,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[5,1,"い"],[21,2,"かちく"],[24,1,"の"],[26,1,"のこ"]],"text":"主の言葉を意にとめないものは、そのしもべと家畜を野に残しておいた。"},{"ref":"Exod.9.22","start":2009022,"end":2009022,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"て"],[18,1,"てん"],[26,1,"の"],[34,2,"ぜんこく"],[47,1,"ち"],[51,1,"ひと"],[53,1,"けもの"],[55,1,"はたけ"],[61,2,"あおもの"],[64,1,"うえ"],[66,1,"ひょう"],[68,1,"ふ"]],"text":"主はモーセに言われた、「あなたの手を天にむかってさし伸べ、エジプトの全国にわたって、エジプトの地にいる人と獣と畑のすべての青物の上に雹を降らせなさい」。"},{"ref":"Exod.9.23","start":2009023,"end":2009023,"break":"none","ruby":[[4,1,"てん"],[15,1,"の"],[20,1,"しゅ"],[22,1,"かみなり"],[24,1,"ひょう"],[31,1,"ひ"],[33,1,"ち"],[42,1,"くだ"],[50,1,"しゅ"],[53,1,"ひょう"],[60,1,"ち"],[62,1,"ふ"]],"text":"モーセが天にむかってつえをさし伸べると、主は雷と雹をおくられ、火は地にむかって、はせ下った。こうして主は、雹をエジプトの地に降らされた。"},{"ref":"Exod.9.24","start":2009024,"end":2009024,"break":"none","ruby":[[3,1,"ひょう"],[5,1,"ふ"],[8,1,"ひょう"],[10,1,"あいだ"],[12,1,"ひ"],[18,1,"わた"],[22,1,"ひょう"],[24,1,"おそ"],[28,1,"おお"],[36,2,"ぜんこく"],[41,1,"くに"]],"text":"そして雹が降り、雹の間に火がひらめき渡った。雹は恐ろしく大きく、エジプト全国には、国をなしてこのかた、かつてないものであった。"},{"ref":"Exod.9.25","start":2009025,"end":2009025,"break":"none","ruby":[[0,1,"ひょう"],[6,2,"ぜんこく"],[17,1,"はたけ"],[21,1,"ひと"],[23,1,"けもの"],[25,1,"う"],[29,1,"ひょう"],[33,1,"はたけ"],[39,2,"あおもの"],[42,1,"う"],[45,1,"の"],[52,1,"き"],[54,1,"お"],[56,1,"くだ"]],"text":"雹はエジプト全国にわたって、すべて畑にいる人と獣を打った。雹はまた畑のすべての青物を打ち、野のもろもろの木を折り砕いた。"},{"ref":"Exod.9.26","start":2009026,"end":2009026,"break":"none","ruby":[[8,2,"ひとびと"],[17,1,"ち"],[21,1,"ひょう"],[23,1,"ふ"]],"text":"ただイスラエルの人々のいたゴセンの地には、雹が降らなかった。"},{"ref":"Exod.9.27","start":2009027,"end":2009027,"break":"paragraph","ruby":[[7,1,"ひと"],[22,1,"め"],[25,1,"い"],[38,1,"つみ"],[40,1,"おか"],[44,1,"しゅ"],[46,1,"ただ"],[59,1,"たみ"],[61,1,"わる"]],"text":"そこで、パロは人をつかわし、モーセとアロンを召して言った、「わたしはこんどは罪を犯した。主は正しく、わたしと、わたしの民は悪い。"},{"ref":"Exod.9.28","start":2009028,"end":2009028,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"きがん"],[13,1,"かみなり"],[15,1,"ひょう"],[37,1,"さ"]],"text":"主に祈願してください。この雷と雹はもうじゅうぶんです。わたしはあなたがたを去らせます。もはやとどまらなくてもよろしい」。"},{"ref":"Exod.9.29","start":2009029,"end":2009029,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[15,1,"まち"],[17,1,"で"],[24,1,"しゅ"],[34,1,"て"],[36,1,"の"],[47,1,"かみなり"],[52,1,"ひょう"],[57,1,"ふ"],[69,1,"ち"],[71,1,"しゅ"],[81,1,"し"]],"text":"モーセは彼に言った、「わたしは町を出ると、すぐ、主にむかってわたしの手を伸べひろげます。すると雷はやみ、雹はもはや降らなくなり、あなたは、地が主のものであることを知られましょう。"},{"ref":"Exod.9.30","start":2009030,"end":2009030,"break":"none","ruby":[[12,2,"けらい"],[21,1,"かみ"],[24,1,"しゅ"],[26,1,"おそ"],[38,1,"し"]],"text":"しかし、あなたとあなたの家来たちは、なお、神なる主を恐れないことを、わたしは知っています」。"},{"ref":"Exod.9.31","start":2009031,"end":2009031,"break":"none","ruby":[[2,2,"あま"],[5,2,"おおむぎ"],[8,1,"う"],[10,1,"たお"],[15,2,"おおむぎ"],[18,1,"ほ"],[20,1,"だ"],[23,2,"あま"],[26,1,"はな"],[28,1,"さ"]],"text":"――亜麻と大麦は打ち倒された。大麦は穂を出し、亜麻は花が咲いていたからである。"},{"ref":"Exod.9.32","start":2009032,"end":2009032,"break":"none","ruby":[[0,2,"こむぎ"],[7,1,"むぎ"],[17,1,"う"],[19,1,"たお"]],"text":"小麦とスペルタ麦はおくてであるため打ち倒されなかった。――"},{"ref":"Exod.9.33","start":2009033,"end":2009033,"break":"none","ruby":[[10,1,"さ"],[13,1,"まち"],[15,1,"で"],[18,1,"しゅ"],[24,1,"て"],[26,1,"の"],[35,1,"かみなり"],[37,1,"ひょう"],[42,1,"あめ"],[44,1,"ち"],[46,1,"ふ"]],"text":"モーセはパロのもとを去り、町を出て、主にむかって手を伸べひろげたので、雷と雹はやみ、雨は地に降らなくなった。"},{"ref":"Exod.9.34","start":2009034,"end":2009034,"break":"none","ruby":[[7,1,"あめ"],[9,1,"ひょう"],[11,1,"かみなり"],[18,1,"み"],[24,1,"つみ"],[26,1,"おか"],[29,1,"こころ"],[39,1,"かれ"],[41,2,"けらい"]],"text":"ところがパロは雨と雹と雷がやんだのを見て、またも罪を犯し、心をかたくなにした。彼も家来も、そうであった。"},{"ref":"Exod.9.35","start":2009035,"end":2009035,"break":"none","ruby":[[7,1,"こころ"],[16,1,"しゅ"],[25,1,"かた"],[39,2,"ひとびと"],[42,1,"さ"]],"text":"すなわちパロは心をかたくなにし、主がモーセによって語られたように、イスラエルの人々を去らせなかった。"}]