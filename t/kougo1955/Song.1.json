[{"ref":"Song.1.1","start":22001001,"end":22001001,"break":"paragraph","ruby":[[5,2,"がか"]],"text":"ソロモンの雅歌"},{"ref":"Song.1.2","start":22001002,"end":22001002,"break":"stanza","breaks":[[18,"line"],[32,"line"]],"ruby":[[8,1,"くち"],[10,1,"くち"],[22,1,"くち"],[36,1,"あい"],[41,1,"しゅ"]],"text":"どうか、あなたの口の口づけをもって、わたしに口づけしてください。あなたの愛はぶどう酒にまさり、"},{"ref":"Song.1.3","start":22001003,"end":22001003,"break":"line","breaks":[[15,"line"],[35,"line"]],"ruby":[[7,1,"あぶら"],[19,1,"な"],[21,1,"そそ"],[28,1,"あぶら"],[50,1,"あい"]],"text":"あなたのにおい油はかんばしく、あなたの名は注がれたにおい油のようです。それゆえ、おとめたちはあなたを愛するのです。"},{"ref":"Song.1.4","start":22001004,"end":22001004,"break":"line","breaks":[[20,"line"],[37,"line"],[56,"line"],[76,"line"],[100,"line"]],"ruby":[[11,1,"い"],[26,1,"いそ"],[37,1,"おう"],[48,1,"つ"],[51,1,"い"],[70,1,"よろこ"],[72,1,"たの"],[79,1,"しゅ"],[90,1,"あい"],[106,2,"まごころ"],[116,1,"あい"]],"text":"あなたのあとについて、行かせてください。わたしたちは急いでまいりましょう。王はわたしをそのへやに連れて行かれた。わたしたちは、あなたによって喜び楽しみ、ぶどう酒にまさって、あなたの愛をほめたたえます。おとめたちは真心をもってあなたを愛します。"},{"ref":"Song.1.5","start":22001005,"end":22001005,"break":"stanza","breaks":[[11,"line"],[25,"line"]],"ruby":[[6,1,"むすめ"],[15,1,"くろ"],[21,1,"うつく"],[29,2,"てんまく"]],"text":"エルサレムの娘たちよ、わたしは黒いけれども美しい。ケダルの天幕のように、ソロモンのとばりのように。"},{"ref":"Song.1.6","start":22001006,"end":22001006,"break":"line","breaks":[[16,"line"],[30,"line"],[44,"line"],[69,"line"]],"ruby":[[4,1,"ひ"],[6,1,"や"],[16,1,"ひ"],[22,1,"や"],[34,1,"み"],[46,1,"はは"],[48,1,"こ"],[51,1,"いか"],[62,1,"えん"],[64,1,"まも"],[77,2,"じぶん"],[83,1,"えん"],[85,1,"まも"]],"text":"わたしが日に焼けているがために、日がわたしを焼いたがために、わたしを見つめてはならない。わが母の子らは怒って、わたしにぶどう園を守らせた。しかし、わたしは自分のぶどう園を守らなかった。"},{"ref":"Song.1.7","start":22001007,"end":22001007,"break":"stanza","breaks":[[10,"line"],[28,"line"],[46,"line"],[58,"line"],[77,"line"],[93,"line"]],"ruby":[[2,1,"たましい"],[4,1,"あい"],[7,1,"もの"],[22,1,"む"],[25,1,"やしな"],[28,1,"ひる"],[30,1,"とき"],[39,1,"やす"],[50,1,"つ"],[71,1,"もの"],[81,2,"なかま"],[84,1,"む"]],"text":"わが魂の愛する者よ、あなたはどこで、あなたの群れを養い、昼の時にどこで、それを休ませるのか、わたしに告げてください。どうして、わたしはさまよう者のように、あなたの仲間の群れのかたわらに、いなければならないのですか。"},{"ref":"Song.1.8","start":22001008,"end":22001008,"break":"stanza","breaks":[[13,"line"],[37,"line"],[51,"line"]],"ruby":[[0,1,"おんな"],[5,1,"もっと"],[7,1,"うつく"],[10,1,"もの"],[17,1,"し"],[24,1,"む"],[27,2,"あしあと"],[30,1,"したが"],[37,2,"ひつじかい"],[42,2,"てんまく"],[55,1,"こ"],[59,1,"か"]],"text":"女のうちの最も美しい者よ、あなたが知らないなら、群れの足跡に従っていって、羊飼たちの天幕のかたわらで、あなたの子やぎを飼いなさい。"},{"ref":"Song.1.9","start":22001009,"end":22001009,"break":"stanza","breaks":[[8,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[19,1,"くるま"],[21,1,"め"],[22,1,"うま"]],"text":"わが愛する者よ、わたしはあなたをパロの車の雌馬になぞらえる。"},{"ref":"Song.1.10","start":22001010,"end":22001010,"break":"line","breaks":[[14,"line"]],"ruby":[[7,1,"うつく"],[10,1,"かざ"],[18,1,"くび"],[20,2,"ほうせき"],[27,1,"くび"],[28,1,"かざり"],[30,1,"うつく"]],"text":"あなたのほおは美しく飾られ、あなたの首は宝石をつらねた首飾で美しい。"},{"ref":"Song.1.11","start":22001011,"end":22001011,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"ぎん"],[7,1,"ち"],[11,1,"きん"],[13,1,"かざ"],[15,1,"もの"],[25,1,"つく"]],"text":"われわれは銀を散らした金の飾り物を、あなたのために造ろう。"},{"ref":"Song.1.12","start":22001012,"end":22001012,"break":"stanza","breaks":[[13,"line"]],"ruby":[[0,1,"おう"],[4,1,"せき"],[6,1,"つ"],[27,1,"はな"]],"text":"王がその席に着かれたとき、わたしのナルドはそのかおりを放った。"},{"ref":"Song.1.13","start":22001013,"end":22001013,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[21,1,"ち"],[25,1,"あいだ"],[29,2,"もつやく"],[32,1,"ふくろ"]],"text":"わが愛する者は、わたしにとっては、わたしの乳ぶさの間にある没薬の袋のようです。"},{"ref":"Song.1.14","start":22001014,"end":22001014,"break":"line","breaks":[[17,"line"],[29,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[25,1,"えん"],[32,1,"じゅ"],[34,1,"はな"]],"text":"わが愛する者は、わたしにとっては、エンゲデのぶどう園にあるヘンナ樹の花ぶさのようです。"},{"ref":"Song.1.15","start":22001015,"end":22001015,"break":"stanza","breaks":[[19,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[8,1,"み"],[15,1,"うつく"],[19,1,"み"],[26,1,"うつく"],[34,1,"め"]],"text":"わが愛する者よ、見よ、あなたは美しい、見よ、あなたは美しい、あなたの目ははとのようだ。"},{"ref":"Song.1.16","start":22001016,"end":22001016,"break":"stanza","breaks":[[19,"line"],[29,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[8,1,"み"],[15,1,"うつく"],[35,1,"とこ"],[37,1,"みどり"]],"text":"わが愛する者よ、見よ、あなたは美しく、まことにりっぱです。わたしたちの床は緑、"},{"ref":"Song.1.17","start":22001017,"end":22001017,"break":"line","breaks":[[13,"line"]],"ruby":[[6,1,"いえ"],[8,1,"はり"],[10,2,"こうはく"]],"text":"わたしたちの家の梁は香柏、そのたるきはいとすぎです。"}]