[{"ref":"Ps.61.1","start":19061001,"end":19061001,"break":"paragraph","title":"聖歌隊の指揮者によって琴にあわせてうたわせたダビデの歌","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[7,1,"さけ"],[10,1,"き"],[22,1,"いのり"],[24,1,"みみ"],[26,1,"かたむ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[11,1,"こと"],[26,1,"うた"]],"text":"神よ、わたしの叫びを聞いてください。わたしの祈に耳を傾けてください。"},{"ref":"Ps.61.2","start":19061002,"end":19061002,"break":"line","breaks":[[12,"line"],[33,"line"],[40,"line"],[56,"line"]],"ruby":[[2,1,"こころ"],[16,1,"ち"],[26,1,"よ"],[37,1,"みちび"],[44,1,"およ"],[52,1,"たか"],[54,1,"いわ"]],"text":"わが心のくずおれるとき、わたしは地のはてからあなたに呼ばわります。わたしを導いてわたしの及びがたいほどの高い岩にのぼらせてください。"},{"ref":"Ps.61.3","start":19061003,"end":19061003,"break":"line","breaks":[[12,"line"]],"ruby":[[8,1,"さ"],[10,1,"どころ"],[12,1,"てき"],[14,1,"たい"],[17,2,"けんご"]],"text":"あなたはわたしの避け所、敵に対する堅固なやぐらです。"},{"ref":"Ps.61.4","start":19061004,"end":19061004,"break":"line","breaks":[[21,"line"]],"ruby":[[13,2,"まくや"],[16,1,"す"],[25,1,"つばさ"],[27,1,"かげ"]],"text":"わたしをとこしえにあなたの幕屋に住まわせ、あなたの翼の陰にのがれさせてください。〔セラ"},{"ref":"Ps.61.5","start":19061005,"end":19061005,"break":"line","breaks":[[22,"line"],[36,"line"]],"ruby":[[0,1,"かみ"],[16,1,"ちか"],[19,1,"き"],[23,1,"な"],[25,1,"おそ"],[28,1,"もの"],[30,1,"たま"],[33,1,"し"],[34,1,"ぎょう"],[40,1,"あた"]],"text":"神よ、あなたはわたしのもろもろの誓いを聞き、み名を恐れる者に賜わる嗣業をわたしに与えられました。"},{"ref":"Ps.61.6","start":19061006,"end":19061006,"break":"line","breaks":[[13,"line"]],"ruby":[[3,1,"おう"],[9,1,"の"],[24,1,"いた"]],"text":"どうか王のいのちを延ばし、そのよわいをよろずよに至らせてください。"},{"ref":"Ps.61.7","start":19061007,"end":19061007,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[0,1,"かれ"],[7,1,"かみ"],[9,1,"まえ"],[11,1,"おう"],[28,1,"めい"],[31,1,"かれ"],[33,1,"まも"]],"text":"彼をとこしえに神の前に王たらしめ、いつくしみとまこととに命じて彼を守らせてください。"},{"ref":"Ps.61.8","start":19061008,"end":19061008,"break":"line","breaks":[[23,"line"]],"ruby":[[15,1,"な"],[23,1,"ひ"],[36,1,"ちか"],[39,1,"はた"]],"text":"そうすればわたしはとこしえにみ名をほめうたい、日ごとにわたしのもろもろの誓いを果すでしょう。"}]