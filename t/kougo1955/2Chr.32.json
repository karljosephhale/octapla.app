[{"ref":"2Chr.32.1","start":14032001,"end":14032001,"break":"paragraph","ruby":[[9,1,"こと"],[11,2,"ちゅうじつ"],[14,1,"い"],[17,1,"のち"],[25,1,"おう"],[32,1,"き"],[37,2,"しんにゅう"],[41,2,"けんご"],[44,2,"まちまち"],[47,1,"む"],[51,1,"じん"],[53,1,"は"],[59,1,"せ"],[61,1,"と"]],"text":"ヒゼキヤがこれらの事を忠実に行った後、アッスリヤの王セナケリブが来てユダに侵入し、堅固な町々に向かって陣を張り、これを攻め取ろうとした。"},{"ref":"2Chr.32.2","start":14032002,"end":14032002,"break":"none","ruby":[[11,1,"き"],[20,1,"せ"],[29,1,"み"]],"text":"ヒゼキヤはセナケリブが来て、エルサレムを攻めようとするのを見たので、"},{"ref":"2Chr.32.3","start":14032003,"end":14032003,"break":"none","ruby":[[10,2,"ゆうし"],[15,2,"そうだん"],[20,1,"まち"],[22,1,"そと"],[26,1,"いずみ"],[28,1,"みず"],[39,1,"かれ"],[45,1,"たす"]],"text":"そのつかさたちおよび勇士たちと相談して、町の外にある泉の水を、ふさごうとした。彼らはこれを助けた。"},{"ref":"2Chr.32.4","start":14032004,"end":14032004,"break":"none","ruby":[[0,1,"おお"],[3,1,"たみ"],[5,1,"あつ"],[14,1,"いずみ"],[18,1,"くに"],[20,1,"なか"],[22,1,"なが"],[25,2,"たにがわ"],[32,1,"い"],[43,1,"おう"],[50,1,"おお"],[53,1,"みず"],[55,1,"え"]],"text":"多くの民は集まって、すべての泉および国の中を流れる谷川をふさいで言った、「アッスリヤの王たちがきて、多くの水を得られるようなことをしておいていいだろうか」。"},{"ref":"2Chr.32.5","start":14032005,"end":14032005,"break":"none","ruby":[[7,2,"ゆうき"],[10,1,"だ"],[14,1,"やぶ"],[17,2,"じょうへき"],[25,1,"きず"],[27,1,"なお"],[33,1,"うえ"],[39,1,"た"],[44,1,"そと"],[48,2,"じょうへき"],[51,1,"めぐ"],[59,1,"まち"],[64,2,"けんご"],[69,2,"ぶき"],[74,1,"たて"],[76,1,"おお"],[78,1,"つく"]],"text":"ヒゼキヤはまた勇気を出して、破れた城壁をことごとく築き直して、その上にやぐらを建て、その外にまた城壁を巡らし、ダビデの町のミロを堅固にし、武器および盾を多く造り、"},{"ref":"2Chr.32.6","start":14032006,"end":14032006,"break":"none","ruby":[[0,1,"ぐん"],[1,1,"ちょう"],[3,1,"たみ"],[5,1,"うえ"],[7,1,"お"],[10,1,"まち"],[12,1,"もん"],[14,2,"ひろば"],[17,1,"たみ"],[19,1,"あつ"],[26,1,"はげ"],[30,1,"い"]],"text":"軍長を民の上に置き、町の門の広場に民を集めて、これを励まして言った、"},{"ref":"2Chr.32.7","start":14032007,"end":14032007,"break":"none","ruby":[[1,1,"こころ"],[3,1,"つよ"],[7,1,"いさ"],[21,1,"おう"],[25,1,"かれ"],[27,1,"とも"],[35,2,"ぐんしゅう"],[39,1,"おそ"],[64,1,"とも"],[68,1,"もの"],[70,1,"かれ"],[73,1,"とも"],[77,1,"もの"],[81,1,"おお"],[85,1,"もの"]],"text":"「心を強くし、勇みたちなさい。アッスリヤの王をも、彼と共にいるすべての群衆をも恐れてはならない。おののいてはならない。われわれと共におる者は彼らと共におる者よりも大いなる者だからである。"},{"ref":"2Chr.32.8","start":14032008,"end":14032008,"break":"none","ruby":[[0,1,"かれ"],[2,1,"とも"],[6,1,"もの"],[8,1,"にく"],[10,1,"うで"],[23,1,"とも"],[27,1,"もの"],[34,1,"かみ"],[36,1,"しゅ"],[47,1,"たす"],[55,1,"かわ"],[58,1,"たたか"],[64,1,"たみ"],[69,1,"おう"],[75,2,"ことば"],[78,2,"あんしん"]],"text":"彼と共におる者は肉の腕である。しかしわれわれと共におる者はわれわれの神、主であって、われわれを助け、われわれに代って戦われる」。民はユダの王ヒゼキヤの言葉に安心した。"},{"ref":"2Chr.32.9","start":14032009,"end":14032009,"break":"paragraph","ruby":[[2,1,"のち"],[9,1,"おう"],[18,1,"ぜん"],[19,1,"ぐん"],[28,1,"かこ"],[37,2,"けらい"],[55,1,"おう"],[78,1,"ひと"],[80,1,"つ"],[85,1,"い"]],"text":"この後アッスリヤの王セナケリブはその全軍をもってラキシを囲んでいたが、その家来をエルサレムにつかわして、ユダの王ヒゼキヤおよびエルサレムにいるすべてのユダの人に告げさせて言った、"},{"ref":"2Chr.32.10","start":14032010,"end":14032010,"break":"none","ruby":[[7,1,"おう"],[16,1,"い"],[28,1,"なに"],[30,1,"たの"]],"text":"「アッスリヤの王セナケリブはこう言います、『あなたがたは何を頼んでエルサレムにこもっているのか。"},{"ref":"2Chr.32.11","start":14032011,"end":14032011,"break":"none","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[21,1,"おう"],[23,1,"て"],[32,1,"すく"],[41,1,"い"],[57,1,"う"],[75,1,"し"]],"text":"ヒゼキヤは「われわれの神、主がアッスリヤの王の手から、われわれを救ってくださる」と言って、あなたがたをそそのかし、飢えと、かわきをもって、あなたがたを死なせようとしているのではないか。"},{"ref":"2Chr.32.12","start":14032012,"end":14032012,"break":"none","ruby":[[7,1,"しゅ"],[14,1,"たか"],[16,1,"ところ"],[18,2,"さいだん"],[21,1,"と"],[23,1,"のぞ"],[35,1,"めい"],[51,2,"さいだん"],[54,1,"まえ"],[56,2,"れいはい"],[62,1,"うえ"],[64,2,"ぎせい"],[80,1,"い"],[83,1,"もの"]],"text":"このヒゼキヤは主のもろもろの高き所と祭壇を取り除き、ユダとエルサレムに命じて、「あなたがたはただ一つの祭壇の前で礼拝し、その上に犠牲をささげなければならない」と言った者ではないか。"},{"ref":"2Chr.32.13","start":14032013,"end":14032013,"break":"none","ruby":[[17,2,"せんぞ"],[23,1,"た"],[25,2,"くにぐに"],[32,1,"たみ"],[39,1,"し"],[50,2,"くにぐに"],[53,1,"たみ"],[55,2,"かみがみ"],[59,1,"すこ"],[65,1,"くに"],[72,1,"て"],[75,1,"すく"],[77,1,"だ"]],"text":"あなたがたは、わたしおよびわたしの先祖たちが、他の国々のすべての民にしたことを知らないのか。それらの国々の民の神々は、少しでもその国を、わたしの手から救い出すことができたか。"},{"ref":"2Chr.32.14","start":14032014,"end":14032014,"break":"none","ruby":[[4,2,"せんぞ"],[9,1,"ほろ"],[12,1,"つく"],[19,2,"こくみん"],[27,1,"かみ"],[35,2,"じぶん"],[38,1,"たみ"],[44,1,"て"],[47,1,"すく"],[49,1,"だ"],[78,1,"かみ"],[91,1,"て"],[94,1,"すく"],[96,1,"だ"]],"text":"わたしの先祖たちが滅ぼし尽したそれらの国民のもろもろの神のうち、だれか自分の民をわたしの手から救い出すことのできたものがあるか。それで、どうしてあなたがたの神が、あなたがたをわたしの手から救い出すことができよう。"},{"ref":"2Chr.32.15","start":14032015,"end":14032015,"break":"none","ruby":[[16,1,"あざむ"],[41,1,"かれ"],[43,1,"しん"],[56,1,"たみ"],[62,1,"くに"],[64,1,"かみ"],[68,1,"たみ"],[74,1,"て"],[84,2,"せんぞ"],[87,1,"て"],[90,1,"すく"],[117,1,"かみ"],[128,1,"て"],[137,1,"すく"]],"text":"それゆえ、あなたがたはヒゼキヤに欺かれてはならない。そそのかされてはならない。また彼を信じてはならない。いずれの民、いずれの国の神もその民をわたしの手、または、わたしの先祖の手から救いだすことができなかったのだから、ましてあなたがたの神が、どうしてわたしの手からあなたがたを救いだすことができようか』」。"},{"ref":"2Chr.32.16","start":14032016,"end":14032016,"break":"paragraph","ruby":[[6,2,"けらい"],[16,1,"おお"],[18,1,"しゅ"],[21,1,"かみ"]],"text":"セナケリブの家来は、このほかにも多く主なる神、およびそのしもべヒゼキヤをそしった。"},{"ref":"2Chr.32.17","start":14032017,"end":14032017,"break":"none","ruby":[[8,2,"てがみ"],[11,1,"か"],[13,1,"おく"],[23,1,"かみ"],[25,1,"しゅ"],[38,1,"い"],[43,2,"しょこく"],[46,1,"たみ"],[48,2,"かみがみ"],[54,1,"たみ"],[60,1,"て"],[63,1,"すく"],[65,1,"だ"],[80,1,"かみ"],[85,1,"たみ"],[91,1,"て"],[94,1,"すく"],[96,1,"だ"]],"text":"セナケリブはまた手紙を書き送って、イスラエルの神、主をあざけり、かつそしって言った、「諸国の民の神々が、その民をわたしの手から救い出さなかったように、ヒゼキヤの神も、その民をわたしの手から救い出さないであろう」と。"},{"ref":"2Chr.32.18","start":14032018,"end":14032018,"break":"none","ruby":[[3,1,"かれ"],[6,2,"おおごえ"],[16,2,"ことば"],[23,2,"じょうへき"],[26,1,"うえ"],[36,1,"たみ"],[38,1,"む"],[42,1,"さけ"],[61,1,"かれ"],[64,1,"まち"],[66,1,"と"]],"text":"そして彼らは大声をあげ、ユダヤの言葉をもって、城壁の上にいるエルサレムの民に向かって叫び、これをおどし、かつおびやかした。彼らは町を取るためである。"},{"ref":"2Chr.32.19","start":14032019,"end":14032019,"break":"none","ruby":[[5,1,"かれ"],[14,1,"かみ"],[19,1,"かた"],[24,1,"ひと"],[26,1,"て"],[33,2,"ちじょう"],[36,1,"たみ"],[38,2,"かみがみ"],[44,1,"かた"]],"text":"このように彼らがエルサレムの神について語ること、人の手のわざである地上の民の神々について語るようであった。"},{"ref":"2Chr.32.20","start":14032020,"end":14032020,"break":"paragraph","ruby":[[7,1,"おう"],[15,1,"こ"],[16,3,"よげんしゃ"],[23,1,"とも"],[25,1,"いの"],[29,1,"てん"],[31,1,"よ"]],"text":"そこでヒゼキヤ王およびアモツの子預言者イザヤは共に祈って、天に呼ばわったので、"},{"ref":"2Chr.32.21","start":14032021,"end":14032021,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"つかい"],[20,1,"おう"],[22,2,"じんえい"],[31,1,"だい"],[32,2,"ゆうし"],[35,2,"しょうかん"],[38,1,"ぐん"],[39,1,"ちょう"],[42,1,"ほろ"],[51,1,"おう"],[53,2,"せきめん"],[57,2,"じぶん"],[60,1,"くに"],[62,1,"かえ"],[69,1,"かみ"],[71,1,"いえ"],[77,1,"とき"],[81,1,"こ"],[95,1,"かれ"],[99,1,"ところ"],[101,1,"ころ"]],"text":"主はひとりのみ使をつかわして、アッスリヤ王の陣営にいるすべての大勇士と将官、軍長らを滅ぼされた。それで王は赤面して自分の国に帰ったが、その神の家にはいった時、その子のひとりが、つるぎをもって彼をその所で殺した。"},{"ref":"2Chr.32.22","start":14032022,"end":14032022,"break":"none","ruby":[[5,1,"しゅ"],[19,2,"じゅうみん"],[28,1,"おう"],[35,1,"て"],[43,1,"てき"],[45,1,"て"],[48,1,"すく"],[50,1,"だ"],[56,1,"ところ"],[58,1,"かれ"],[61,1,"まも"]],"text":"このように主は、ヒゼキヤとエルサレムの住民をアッスリヤの王セナケリブの手およびすべての敵の手から救い出し、いたる所で彼らを守られた。"},{"ref":"2Chr.32.23","start":14032023,"end":14032023,"break":"none","ruby":[[3,1,"おお"],[6,2,"ひとびと"],[12,1,"もの"],[20,1,"たずさ"],[25,1,"しゅ"],[33,2,"ほうもつ"],[39,1,"おう"],[45,1,"おく"],[51,1,"のち"],[57,2,"ばんこく"],[60,1,"たみ"],[62,1,"たっと"]],"text":"そこで多くの人々はささげ物をエルサレムに携えてきて主にささげ、また宝物をユダの王ヒゼキヤに贈った。この後ヒゼキヤは万国の民に尊ばれた。"},{"ref":"2Chr.32.24","start":14032024,"end":14032024,"break":"paragraph","ruby":[[10,1,"や"],[13,1,"し"],[24,1,"しゅ"],[26,1,"いの"],[32,1,"しゅ"],[37,1,"こた"],[45,1,"たま"]],"text":"そのころ、ヒゼキヤは病んで死ぬばかりであったが、主に祈ったので、主はこれに答えて、しるしを賜わった。"},{"ref":"2Chr.32.25","start":14032025,"end":14032025,"break":"none","ruby":[[10,1,"う"],[13,1,"めぐ"],[16,1,"むく"],[27,1,"こころ"],[29,1,"たか"],[36,1,"いか"],[39,1,"かれ"],[52,1,"のぞ"]],"text":"しかしヒゼキヤはその受けた恵みに報いることをせず、その心が高ぶったので、怒りが彼とユダおよびエルサレムに臨もうとしたが、"},{"ref":"2Chr.32.26","start":14032026,"end":14032026,"break":"none","ruby":[[7,1,"こころ"],[9,1,"たか"],[13,1,"く"],[30,2,"じゅうみん"],[33,2,"どうよう"],[41,1,"しゅ"],[43,1,"いか"],[52,1,"よ"],[55,1,"かれ"],[58,1,"のぞ"]],"text":"ヒゼキヤはその心の高ぶりを悔いてへりくだり、またエルサレムの住民も同様にしたので、主の怒りは、ヒゼキヤの世には彼らに臨まなかった。"},{"ref":"2Chr.32.27","start":14032027,"end":14032027,"break":"paragraph","ruby":[[5,1,"とみ"],[7,2,"えいよ"],[14,2,"ほうぞう"],[17,1,"つく"],[21,1,"きん"],[23,1,"ぎん"],[25,2,"ほうせき"],[28,2,"こうりょう"],[31,1,"たて"],[35,2,"かくしゅ"],[38,1,"たっと"],[40,2,"うつわもの"]],"text":"ヒゼキヤは富と栄誉をきわめ、宝蔵を造って、金、銀、宝石、香料、盾および各種の尊い器物をおさめ、"},{"ref":"2Chr.32.28","start":14032028,"end":14032028,"break":"none","ruby":[[2,2,"そうこ"],[5,1,"つく"],[8,2,"こくもつ"],[11,1,"さけ"],[13,1,"あぶら"],[17,2,"さんぶつ"],[24,2,"こや"],[27,1,"つく"],[30,2,"しゅじゅ"],[33,2,"かちく"],[36,1,"お"],[42,1,"つく"],[45,1,"ひつじ"],[47,1,"む"],[50,1,"お"]],"text":"また倉庫を造って穀物、酒、油などの産物をおさめ、小屋を造って種々の家畜を置き、おりを造って羊の群れを置き、"},{"ref":"2Chr.32.29","start":14032029,"end":14032029,"break":"none","ruby":[[2,2,"たすう"],[5,1,"まち"],[7,1,"もう"],[12,1,"ひつじ"],[14,1,"うし"],[22,2,"しょゆう"],[27,1,"かみ"],[29,2,"ひじょう"],[32,1,"おお"],[35,1,"か"],[36,1,"ざい"],[38,1,"かれ"],[40,1,"たま"]],"text":"また多数の町を設け、かつ羊と牛をおびただしく所有した。神が非常に多くの貨財を彼に賜わったからである。"},{"ref":"2Chr.32.30","start":14032030,"end":14032030,"break":"none","ruby":[[13,1,"みず"],[15,1,"うえ"],[17,1,"みなもと"],[31,1,"まち"],[33,1,"にし"],[35,1,"ほう"],[42,1,"ひ"],[44,1,"くだ"],[69,1,"と"]],"text":"このヒゼキヤはまたギホンの水の上の源をふさいで、これをダビデの町の西の方にまっすぐに引き下した。このようにヒゼキヤはそのすべてのわざをなし遂げた。"},{"ref":"2Chr.32.31","start":14032031,"end":14032031,"break":"none","ruby":[[8,1,"きみ"],[12,2,"ししゃ"],[23,1,"くに"],[36,1,"たず"],[41,1,"とき"],[45,1,"かみ"],[47,1,"かれ"],[49,1,"こころ"],[53,1,"かれ"],[55,1,"こころ"],[68,1,"し"],[73,1,"かれ"],[75,1,"す"],[77,1,"お"]],"text":"しかしバビロンの君たちが使者をつかわして、この国にあった、しるしについて尋ねさせた時には、神は彼を試みて、彼の心にあることを、ことごとく知るために彼を捨て置かれた。"},{"ref":"2Chr.32.32","start":14032032,"end":14032032,"break":"paragraph","ruby":[[7,1,"た"],[9,2,"こうい"],[16,2,"とっこう"],[24,1,"こ"],[25,3,"よげんしゃ"],[32,2,"もくし"],[44,1,"れつ"],[45,1,"おう"],[47,1,"しょ"]],"text":"ヒゼキヤのその他の行為およびその徳行は、アモツの子預言者イザヤの黙示とユダとイスラエルの列王の書にしるされている。"},{"ref":"2Chr.32.33","start":14032033,"end":14032033,"break":"none","ruby":[[7,2,"せんぞ"],[12,1,"とも"],[14,1,"ねむ"],[24,2,"しそん"],[27,1,"はか"],[32,1,"たか"],[34,1,"ところ"],[36,1,"ほうむ"],[44,2,"ひとびと"],[55,2,"じゅうみん"],[58,1,"みな"],[61,1,"し"],[63,1,"あた"],[66,1,"かれ"],[68,2,"けいい"],[71,1,"あらわ"],[77,1,"こ"],[82,1,"かれ"],[84,1,"かわ"],[87,1,"おう"]],"text":"ヒゼキヤはその先祖たちと共に眠ったので、ダビデの子孫の墓のうちの高い所に葬られた。ユダの人々およびエルサレムの住民は皆その死に当って彼に敬意を表した。その子マナセが彼に代って王となった。"}]