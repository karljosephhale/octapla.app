[{"ref":"John.4.1","start":43004001,"end":43004001,"break":"paragraph","ruby":[[11,1,"おお"],[13,2,"でし"],[28,1,"さづ"],[46,1,"びと"],[50,1,"き"],[56,1,"しゅ"],[58,1,"し"]],"text":"イエスが、ヨハネよりも多く弟子をつくり、またバプテスマを授けておられるということを、パリサイ人たちが聞き、それを主が知られたとき、"},{"ref":"John.4.2","start":43004002,"end":43004002,"break":"none","ruby":[[21,1,"さづ"],[35,2,"でし"]],"text":"（しかし、イエスみずからが、バプテスマをお授けになったのではなく、その弟子たちであった）"},{"ref":"John.4.3","start":43004003,"end":43004003,"break":"none","ruby":[[4,1,"さ"],[15,1,"い"]],"text":"ユダヤを去って、またガリラヤへ行かれた。"},{"ref":"John.4.4","start":43004004,"end":43004004,"break":"none","ruby":[[13,2,"つうか"]],"text":"しかし、イエスはサマリヤを通過しなければならなかった。"},{"ref":"John.4.5","start":43004005,"end":43004005,"break":"none","ruby":[[19,1,"まち"],[31,1,"まち"],[40,1,"こ"],[45,1,"あた"],[48,2,"とち"],[51,1,"ちか"]],"text":"そこで、イエスはサマリヤのスカルという町においでになった。この町は、ヤコブがその子ヨセフに与えた土地の近くにあったが、"},{"ref":"John.4.6","start":43004006,"end":43004006,"break":"none","ruby":[[7,2,"いど"],[18,1,"たび"],[20,1,"つか"],[23,1,"おぼ"],[34,2,"いど"],[49,1,"とき"],[51,1,"ひる"],[55,1,"じ"]],"text":"そこにヤコブの井戸があった。イエスは旅の疲れを覚えて、そのまま、この井戸のそばにすわっておられた。時は昼の十二時ごろであった。"},{"ref":"John.4.7","start":43004007,"end":43004007,"break":"none","ruby":[[9,1,"おんな"],[11,1,"みず"],[27,1,"おんな"],[31,1,"みず"],[33,1,"の"],[37,1,"くだ"],[42,1,"い"]],"text":"ひとりのサマリヤの女が水をくみにきたので、イエスはこの女に、「水を飲ませて下さい」と言われた。"},{"ref":"John.4.8","start":43004008,"end":43004008,"break":"none","ruby":[[0,2,"でし"],[5,2,"しょくもつ"],[8,1,"か"],[11,1,"まち"],[13,1,"い"]],"text":"弟子たちは食物を買いに町に行っていたのである。"},{"ref":"John.4.9","start":43004009,"end":43004009,"break":"none","ruby":[[9,1,"おんな"],[15,1,"い"],[27,1,"じん"],[44,1,"おんな"],[51,1,"の"],[76,1,"じん"],[82,1,"びと"],[84,2,"こうさい"]],"text":"すると、サマリヤの女はイエスに言った、「あなたはユダヤ人でありながら、どうしてサマリヤの女のわたしに、飲ませてくれとおっしゃるのですか」。これは、ユダヤ人はサマリヤ人と交際していなかったからである。"},{"ref":"John.4.10","start":43004010,"end":43004010,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[19,1,"かみ"],[21,2,"たまもの"],[27,1,"し"],[34,1,"みず"],[36,1,"の"],[44,1,"い"],[47,1,"もの"],[56,1,"し"],[69,1,"ほう"],[72,1,"ねが"],[74,1,"で"],[79,1,"ひと"],[82,1,"い"],[85,1,"みず"]],"text":"イエスは答えて言われた、「もしあなたが神の賜物のことを知り、また、『水を飲ませてくれ』と言った者が、だれであるか知っていたならば、あなたの方から願い出て、その人から生ける水をもらったことであろう」。"},{"ref":"John.4.11","start":43004011,"end":43004011,"break":"none","ruby":[[0,1,"おんな"],[6,1,"い"],[11,1,"しゅ"],[21,1,"もの"],[24,1,"も"],[33,1,"うえ"],[35,2,"いど"],[38,1,"ふか"],[46,1,"い"],[49,1,"みず"],[56,1,"て"],[58,1,"い"]],"text":"女はイエスに言った、「主よ、あなたは、くむ物をお持ちにならず、その上、井戸は深いのです。その生ける水を、どこから手に入れるのですか。"},{"ref":"John.4.12","start":43004012,"end":43004012,"break":"none","ruby":[[7,2,"いど"],[10,1,"くだ"],[20,1,"ちち"],[28,1,"えら"],[41,2,"じしん"],[44,1,"の"],[49,1,"こ"],[55,2,"かちく"],[61,2,"いど"],[65,1,"の"]],"text":"あなたは、この井戸を下さったわたしたちの父ヤコブよりも、偉いかたなのですか。ヤコブ自身も飲み、その子らも、その家畜も、この井戸から飲んだのですが」。"},{"ref":"John.4.13","start":43004013,"end":43004013,"break":"none","ruby":[[4,1,"おんな"],[6,1,"こた"],[9,1,"い"],[17,1,"みず"],[19,1,"の"],[21,1,"もの"]],"text":"イエスは女に答えて言われた、「この水を飲む者はだれでも、またかわくであろう。"},{"ref":"John.4.14","start":43004014,"end":43004014,"break":"none","ruby":[[8,1,"あた"],[11,1,"みず"],[13,1,"の"],[15,1,"もの"],[41,1,"あた"],[44,1,"みず"],[49,1,"ひと"],[54,1,"いずみ"],[59,2,"えいえん"],[62,1,"いのち"],[64,1,"いた"],[66,1,"みず"]],"text":"しかし、わたしが与える水を飲む者は、いつまでも、かわくことがないばかりか、わたしが与える水は、その人のうちで泉となり、永遠の命に至る水が、わきあがるであろう」。"},{"ref":"John.4.15","start":43004015,"end":43004015,"break":"none","ruby":[[0,1,"おんな"],[6,1,"い"],[11,1,"しゅ"],[49,1,"みず"],[55,1,"くだ"]],"text":"女はイエスに言った、「主よ、わたしがかわくことがなく、また、ここにくみにこなくてもよいように、その水をわたしに下さい」。"},{"ref":"John.4.16","start":43004016,"end":43004016,"break":"none","ruby":[[4,1,"おんな"],[6,1,"い"],[16,1,"おっと"],[18,1,"よ"],[21,1,"い"],[28,1,"つ"]],"text":"イエスは女に言われた、「あなたの夫を呼びに行って、ここに連れてきなさい」。"},{"ref":"John.4.17","start":43004017,"end":43004017,"break":"none","ruby":[[0,1,"おんな"],[2,1,"こた"],[5,1,"い"],[15,1,"おっと"],[28,1,"おんな"],[30,1,"い"],[36,1,"おっと"],[41,1,"い"]],"text":"女は答えて言った、「わたしには夫はありません」。イエスは女に言われた、「夫がないと言ったのは、もっともだ。"},{"ref":"John.4.18","start":43004018,"end":43004018,"break":"none","ruby":[[6,1,"にん"],[8,1,"おっと"],[15,1,"いま"],[22,1,"おっと"],[32,2,"ことば"]],"text":"あなたには五人の夫があったが、今のはあなたの夫ではない。あなたの言葉のとおりである」。"},{"ref":"John.4.19","start":43004019,"end":43004019,"break":"none","ruby":[[0,1,"おんな"],[6,1,"い"],[11,1,"しゅ"],[22,3,"よげんしゃ"],[26,1,"み"]],"text":"女はイエスに言った、「主よ、わたしはあなたを預言者と見ます。"},{"ref":"John.4.20","start":43004020,"end":43004020,"break":"none","ruby":[[6,2,"せんぞ"],[12,1,"やま"],[14,2,"れいはい"],[30,2,"れいはい"],[35,2,"ばしょ"],[48,1,"い"]],"text":"わたしたちの先祖は、この山で礼拝をしたのですが、あなたがたは礼拝すべき場所は、エルサレムにあると言っています」。"},{"ref":"John.4.21","start":43004021,"end":43004021,"break":"none","ruby":[[4,1,"おんな"],[6,1,"い"],[12,1,"おんな"],[19,1,"い"],[24,1,"しん"],[39,1,"やま"],[54,1,"ところ"],[57,1,"ちち"],[59,2,"れいはい"],[63,1,"とき"],[65,1,"く"]],"text":"イエスは女に言われた、「女よ、わたしの言うことを信じなさい。あなたがたが、この山でも、またエルサレムでもない所で、父を礼拝する時が来る。"},{"ref":"John.4.22","start":43004022,"end":43004022,"break":"none","ruby":[[6,2,"じぶん"],[9,1,"し"],[16,1,"おが"],[29,1,"し"],[37,2,"れいはい"],[44,1,"すくい"],[49,1,"じん"],[52,1,"く"]],"text":"あなたがたは自分の知らないものを拝んでいるが、わたしたちは知っているかたを礼拝している。救はユダヤ人から来るからである。"},{"ref":"John.4.23","start":43004023,"end":43004023,"break":"none","ruby":[[8,2,"れいはい"],[13,1,"もの"],[18,1,"れい"],[28,1,"ちち"],[30,2,"れいはい"],[34,1,"とき"],[36,1,"く"],[43,1,"いま"],[49,1,"ちち"],[57,2,"れいはい"],[62,1,"もの"],[66,1,"もと"]],"text":"しかし、まことの礼拝をする者たちが、霊とまこととをもって父を礼拝する時が来る。そうだ、今きている。父は、このような礼拝をする者たちを求めておられるからである。"},{"ref":"John.4.24","start":43004024,"end":43004024,"break":"none","ruby":[[0,1,"かみ"],[2,1,"れい"],[9,2,"れいはい"],[14,1,"もの"],[17,1,"れい"],[27,2,"れいはい"]],"text":"神は霊であるから、礼拝をする者も、霊とまこととをもって礼拝すべきである」。"},{"ref":"John.4.25","start":43004025,"end":43004025,"break":"none","ruby":[[0,1,"おんな"],[6,1,"い"],[21,1,"よ"],[36,1,"し"],[71,1,"し"],[75,1,"くだ"]],"text":"女はイエスに言った、「わたしは、キリストと呼ばれるメシヤがこられることを知っています。そのかたがこられたならば、わたしたちに、いっさいのことを知らせて下さるでしょう」。"},{"ref":"John.4.26","start":43004026,"end":43004026,"break":"none","ruby":[[4,1,"おんな"],[6,1,"い"],[16,1,"はなし"]],"text":"イエスは女に言われた、「あなたと話をしているこのわたしが、それである」。"},{"ref":"John.4.27","start":43004027,"end":43004027,"break":"paragraph","ruby":[[5,2,"でし"],[10,1,"かえ"],[13,1,"き"],[24,1,"おんな"],[26,1,"はな"],[35,1,"み"],[37,3,"ふしぎ"],[41,1,"おも"],[51,1,"なに"],[53,1,"もと"],[67,1,"なに"],[69,2,"かのじょ"],[72,1,"はな"],[87,1,"たず"],[90,1,"もの"]],"text":"そのとき、弟子たちが帰って来て、イエスがひとりの女と話しておられるのを見て不思議に思ったが、しかし、「何を求めておられますか」とも、「何を彼女と話しておられるのですか」とも、尋ねる者はひとりもなかった。"},{"ref":"John.4.28","start":43004028,"end":43004028,"break":"none","ruby":[[2,1,"おんな"],[4,1,"みず"],[15,1,"お"],[18,1,"まち"],[20,1,"い"],[23,2,"ひとびと"],[26,1,"い"]],"text":"この女は水がめをそのままそこに置いて町に行き、人々に言った、"},{"ref":"John.4.29","start":43004029,"end":43004029,"break":"none","ruby":[[10,1,"なに"],[15,1,"い"],[20,1,"ひと"],[29,1,"み"],[49,1,"ひと"],[57,1,"し"]],"text":"「わたしのしたことを何もかも、言いあてた人がいます。さあ、見にきてごらんなさい。もしかしたら、この人がキリストかも知れません」。"},{"ref":"John.4.30","start":43004030,"end":43004030,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"まち"],[5,1,"で"],[21,1,"い"]],"text":"人々は町を出て、ぞくぞくとイエスのところへ行った。"},{"ref":"John.4.31","start":43004031,"end":43004031,"break":"none","ruby":[[2,1,"あいだ"],[4,2,"でし"],[15,2,"せんせい"],[18,1,"め"]],"text":"その間に弟子たちはイエスに、「先生、召しあがってください」とすすめた。"},{"ref":"John.4.32","start":43004032,"end":43004032,"break":"none","ruby":[[9,1,"い"],[27,1,"し"],[31,2,"しょくもつ"]],"text":"ところが、イエスは言われた、「わたしには、あなたがたの知らない食物がある」。"},{"ref":"John.4.33","start":43004033,"end":43004033,"break":"none","ruby":[[4,2,"でし"],[9,1,"たがい"],[11,1,"い"],[21,1,"なに"],[23,1,"た"],[29,1,"も"]],"text":"そこで、弟子たちが互に言った、「だれかが、何か食べるものを持ってきてさしあげたのであろうか」。"},{"ref":"John.4.34","start":43004034,"end":43004034,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[17,2,"しょくもつ"],[43,1,"おこな"],[54,1,"と"]],"text":"イエスは彼らに言われた、「わたしの食物というのは、わたしをつかわされたかたのみこころを行い、そのみわざをなし遂げることである。"},{"ref":"John.4.35","start":43004035,"end":43004035,"break":"none","ruby":[[7,2,"かりい"],[10,1,"とき"],[12,1,"く"],[23,1,"げつ"],[28,1,"い"],[53,1,"い"],[56,1,"め"],[61,1,"はたけ"],[63,1,"み"],[70,1,"いろ"],[74,2,"かりい"],[78,1,"ま"]],"text":"あなたがたは、刈入れ時が来るまでには、まだ四か月あると、言っているではないか。しかし、わたしはあなたがたに言う。目をあげて畑を見なさい。はや色づいて刈入れを待っている。"},{"ref":"John.4.36","start":43004036,"end":43004036,"break":"none","ruby":[[0,1,"か"],[2,1,"もの"],[4,2,"ほうしゅう"],[7,1,"う"],[11,2,"えいえん"],[14,1,"いのち"],[16,1,"いた"],[18,1,"み"],[20,1,"あつ"],[28,1,"もの"],[30,1,"か"],[32,1,"もの"],[35,2,"ともども"],[38,1,"よろこ"]],"text":"刈る者は報酬を受けて、永遠の命に至る実を集めている。まく者も刈る者も、共々に喜ぶためである。"},{"ref":"John.4.37","start":43004037,"end":43004037,"break":"none","ruby":[[16,1,"か"]],"text":"そこで、『ひとりがまき、ひとりが刈る』ということわざが、ほんとうのこととなる。"},{"ref":"John.4.38","start":43004038,"end":43004038,"break":"none","ruby":[[28,2,"ろうく"],[38,1,"か"],[48,2,"ひとびと"],[51,2,"ろうく"],[62,1,"かれ"],[65,2,"ろうく"],[68,1,"み"]],"text":"わたしは、あなたがたをつかわして、あなたがたがそのために労苦しなかったものを刈りとらせた。ほかの人々が労苦し、あなたがたは、彼らの労苦の実にあずかっているのである」。"},{"ref":"John.4.39","start":43004039,"end":43004039,"break":"paragraph","ruby":[[5,1,"まち"],[10,1,"おお"],[17,1,"ひと"],[23,1,"ひと"],[35,1,"なに"],[39,1,"い"],[51,1,"おんな"],[53,2,"ことば"],[64,1,"しん"]],"text":"さて、この町からきた多くのサマリヤ人は、「この人は、わたしのしたことを何もかも言いあてた」とあかしした女の言葉によって、イエスを信じた。"},{"ref":"John.4.40","start":43004040,"end":43004040,"break":"none","ruby":[[8,1,"ひと"],[22,2,"じぶん"],[31,2,"たいざい"],[42,1,"ねが"],[58,2,"たいざい"]],"text":"そこで、サマリヤ人たちはイエスのもとにきて、自分たちのところに滞在していただきたいと願ったので、イエスはそこにふつか滞在された。"},{"ref":"John.4.41","start":43004041,"end":43004041,"break":"none","ruby":[[5,1,"おお"],[8,2,"ひとびと"],[16,2,"ことば"],[19,1,"き"],[22,1,"しん"]],"text":"そしてなお多くの人々が、イエスの言葉を聞いて信じた。"},{"ref":"John.4.42","start":43004042,"end":43004042,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おんな"],[5,1,"い"],[16,1,"しん"],[28,1,"はな"],[41,2,"じぶん"],[43,2,"じしん"],[46,1,"した"],[49,1,"き"],[55,1,"ひと"],[62,1,"よ"],[64,2,"すくいぬし"]],"text":"彼らは女に言った、「わたしたちが信じるのは、もうあなたが話してくれたからではない。自分自身で親しく聞いて、この人こそまことに世の救主であることが、わかったからである」。"},{"ref":"John.4.43","start":43004043,"end":43004043,"break":"paragraph","ruby":[[4,1,"のち"],[14,1,"さ"],[22,1,"い"]],"text":"ふつかの後に、イエスはここを去ってガリラヤへ行かれた。"},{"ref":"John.4.44","start":43004044,"end":43004044,"break":"none","ruby":[[14,3,"よげんしゃ"],[18,2,"じぶん"],[21,2,"こきょう"],[25,1,"うやま"],[35,1,"い"]],"text":"イエスはみずからはっきり、「預言者は自分の故郷では敬われないものだ」と言われたのである。"},{"ref":"John.4.45","start":43004045,"end":43004045,"break":"none","ruby":[[5,1,"つ"],[16,1,"ひと"],[24,2,"かんげい"],[33,1,"かれ"],[36,1,"まつり"],[38,1,"い"],[48,1,"まつり"],[50,1,"とき"],[74,1,"み"]],"text":"ガリラヤに着かれると、ガリラヤの人たちはイエスを歓迎した。それは、彼らも祭に行っていたので、その祭の時、イエスがエルサレムでなされたことをことごとく見ていたからである。"},{"ref":"John.4.46","start":43004046,"end":43004046,"break":"paragraph","ruby":[[15,1,"い"],[27,1,"みず"],[32,1,"しゅ"],[39,1,"ところ"],[49,2,"びょうき"],[60,1,"も"],[64,2,"やくにん"]],"text":"イエスは、またガリラヤのカナに行かれた。そこは、かつて水をぶどう酒にかえられた所である。ところが、病気をしているむすこを持つある役人がカペナウムにいた。"},{"ref":"John.4.47","start":43004047,"end":43004047,"break":"none","ruby":[[2,1,"ひと"],[28,1,"き"],[44,1,"くだ"],[48,1,"かれ"],[50,1,"こ"],[64,1,"ねが"],[70,1,"こ"],[72,1,"し"]],"text":"この人が、ユダヤからガリラヤにイエスのきておられることを聞き、みもとにきて、カペナウムに下って、彼の子をなおしていただきたいと、願った。その子が死にかかっていたからである。"},{"ref":"John.4.48","start":43004048,"end":43004048,"break":"none","ruby":[[8,1,"かれ"],[10,1,"い"],[27,2,"きせき"],[31,1,"み"],[34,1,"かぎ"],[37,1,"けっ"],[40,1,"しん"]],"text":"そこで、イエスは彼に言われた、「あなたがたは、しるしと奇跡とを見ない限り、決して信じないだろう」。"},{"ref":"John.4.49","start":43004049,"end":43004049,"break":"none","ruby":[[2,2,"やくにん"],[9,1,"い"],[14,1,"しゅ"],[21,2,"こども"],[24,1,"し"],[33,1,"くだ"]],"text":"この役人はイエスに言った、「主よ、どうぞ、子供が死なないうちにきて下さい」。"},{"ref":"John.4.50","start":43004050,"end":43004050,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[13,1,"かえ"],[27,1,"たす"],[34,1,"かれ"],[36,2,"じぶん"],[39,1,"い"],[47,2,"ことば"],[50,1,"しん"],[53,1,"かえ"],[56,1,"い"]],"text":"イエスは彼に言われた、「お帰りなさい。あなたのむすこは助かるのだ」。彼は自分に言われたイエスの言葉を信じて帰って行った。"},{"ref":"John.4.51","start":43004051,"end":43004051,"break":"none","ruby":[[2,1,"くだ"],[5,1,"い"],[7,2,"とちゅう"],[10,1,"しもべ"],[14,1,"かれ"],[16,2,"であ"],[22,1,"こ"],[24,1,"たす"],[31,1,"つ"]],"text":"その下って行く途中、僕たちが彼に出会い、その子が助かったことを告げた。"},{"ref":"John.4.52","start":43004052,"end":43004052,"break":"none","ruby":[[4,1,"かれ"],[6,1,"しもべ"],[20,2,"じこく"],[23,1,"たず"],[35,2,"ごご"],[38,1,"じ"],[40,1,"ねつ"],[42,1,"ひ"],[49,1,"こた"]],"text":"そこで、彼は僕たちに、そのなおりはじめた時刻を尋ねてみたら、「きのうの午後一時に熱が引きました」と答えた。"},{"ref":"John.4.53","start":43004053,"end":43004053,"break":"none","ruby":[[17,1,"たす"],[24,1,"い"],[30,1,"おな"],[32,2,"じこく"],[44,1,"ちち"],[46,1,"し"],[50,1,"かれ"],[51,2,"じしん"],[56,2,"かぞく"],[58,2,"いちどう"],[61,1,"しん"]],"text":"それは、イエスが「あなたのむすこは助かるのだ」と言われたのと同じ時刻であったことを、この父は知って、彼自身もその家族一同も信じた。"},{"ref":"John.4.54","start":43004054,"end":43004054,"break":"none","ruby":[[24,1,"だい"]],"text":"これは、イエスがユダヤからガリラヤにきてなされた第二のしるしである。"}]