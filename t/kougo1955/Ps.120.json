[{"ref":"Ps.120.1","start":19120001,"end":19120001,"break":"paragraph","title":"都もうでの歌","breaks":[[19,"line"]],"ruby":[[4,1,"なや"],[11,1,"しゅ"],[13,1,"よ"],[19,1,"しゅ"],[25,1,"こた"]],"titleRuby":[[0,1,"みやこ"],[5,1,"うた"]],"text":"わたしが悩みのうちに、主に呼ばわると、主はわたしに答えられる。"},{"ref":"Ps.120.2","start":19120002,"end":19120002,"break":"line","breaks":[[14,"line"]],"ruby":[[1,1,"しゅ"],[4,1,"いつわ"],[14,1,"あざむ"],[17,1,"した"],[25,1,"たす"],[27,1,"だ"]],"text":"「主よ、偽りのくちびるから、欺きの舌から、わたしを助け出してください」。"},{"ref":"Ps.120.3","start":19120003,"end":19120003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あざむ"],[3,1,"した"],[10,1,"なに"],[12,1,"あた"],[17,1,"なに"],[19,1,"くわ"]],"text":"欺きの舌よ、おまえに何が与えられ、何が加えられるであろうか。"},{"ref":"Ps.120.4","start":19120004,"end":19120004,"break":"line","breaks":[[10,"line"]],"ruby":[[5,1,"するど"],[7,1,"や"],[15,1,"あつ"],[17,1,"すみ"]],"text":"ますらおの鋭い矢と、えにしだの熱い炭とである。"},{"ref":"Ps.120.5","start":19120005,"end":19120005,"break":"line","breaks":[[21,"line"]],"ruby":[[25,2,"てんまく"],[31,1,"す"]],"text":"わざわいなるかな、わたしはメセクにやどり、ケダルの天幕のなかに住んでいる。"},{"ref":"Ps.120.6","start":19120006,"end":19120006,"break":"line","ruby":[[4,1,"ひさ"],[7,2,"へいあん"],[10,1,"にく"],[12,1,"もの"],[17,1,"す"]],"text":"わたしは久しく平安を憎む者のなかに住んでいた。"},{"ref":"Ps.120.7","start":19120007,"end":19120007,"break":"line","breaks":[[10,"line"]],"ruby":[[4,2,"へいあん"],[7,1,"ねが"],[18,2,"ものい"],[24,1,"かれ"],[27,1,"たたか"],[30,1,"この"]],"text":"わたしは平安を願う、しかし、わたしが物言うとき、彼らは戦いを好む。"}]