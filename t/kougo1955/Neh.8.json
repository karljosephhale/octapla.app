[{"ref":"Neh.8.1","start":16008001,"end":16008001,"break":"paragraph","ruby":[[2,1,"とき"],[3,1,"たみ"],[5,1,"みな"],[16,1,"みず"],[18,1,"もん"],[20,1,"まえ"],[22,2,"ひろば"],[25,1,"あつ"],[29,1,"しゅ"],[37,1,"あた"],[46,2,"りっぽう"],[49,1,"しょ"],[51,1,"も"],[54,1,"く"],[60,2,"がくしゃ"],[66,1,"もと"]],"text":"その時民は皆ひとりのようになって水の門の前の広場に集まり、主がイスラエルに与えられたモーセの律法の書を持って来るように、学者エズラに求めた。"},{"ref":"Neh.8.2","start":16008002,"end":16008002,"break":"none","ruby":[[0,2,"さいし"],[7,1,"がつ"],[10,1,"にち"],[12,2,"りっぽう"],[15,1,"たずさ"],[18,1,"き"],[21,2,"だんじょ"],[24,2,"かいしゅう"],[32,1,"き"],[35,1,"さと"],[43,2,"ひとびと"],[46,1,"まえ"]],"text":"祭司エズラは七月の一日に律法を携えて来て、男女の会衆およびすべて聞いて悟ることのできる人々の前にあらわれ、"},{"ref":"Neh.8.3","start":16008003,"end":16008003,"break":"none","ruby":[[0,1,"みず"],[2,1,"もん"],[4,1,"まえ"],[8,2,"ひろば"],[18,2,"しょうご"],[23,2,"だんじょ"],[28,1,"さと"],[36,2,"ひとびと"],[39,1,"まえ"],[44,1,"よ"],[48,1,"たみ"],[52,2,"りっぽう"],[55,1,"しょ"],[57,1,"みみ"],[59,1,"かたむ"]],"text":"水の門の前にある広場で、あけぼのから正午まで、男女および悟ることのできる人々の前でこれを読んだ。民はみな律法の書に耳を傾けた。"},{"ref":"Neh.8.4","start":16008004,"end":16008004,"break":"none","ruby":[[0,2,"がくしゃ"],[8,1,"こと"],[17,1,"もう"],[20,1,"き"],[22,1,"だい"],[24,1,"うえ"],[26,1,"た"],[31,1,"かれ"],[39,1,"みぎ"],[41,1,"ほう"],[72,1,"た"],[75,1,"ひだり"],[77,1,"ほう"],[118,1,"た"]],"text":"学者エズラはこの事のために、かねて設けた木の台の上に立ったが、彼のかたわらには右の方にマッタテヤ、シマ、アナヤ、ウリヤ、ヒルキヤおよびマアセヤが立ち、左の方にはペダヤ、ミサエル、マルキヤ、ハシュム、ハシバダナ、ゼカリヤおよびメシュラムが立った。"},{"ref":"Neh.8.5","start":16008005,"end":16008005,"break":"none","ruby":[[8,1,"たみ"],[10,1,"まえ"],[14,1,"しょ"],[16,1,"ひら"],[20,1,"かれ"],[26,1,"たみ"],[30,1,"たか"],[32,1,"ところ"],[42,1,"かれ"],[44,1,"しょ"],[46,1,"ひら"],[54,1,"たみ"],[56,2,"きりつ"]],"text":"エズラはすべての民の前にその書を開いた。彼はすべての民よりも高い所にいたからである。彼が書を開くと、すべての民は起立した。"},{"ref":"Neh.8.6","start":16008006,"end":16008006,"break":"none","ruby":[[4,1,"おお"],[8,1,"かみ"],[10,1,"しゅ"],[15,1,"たみ"],[17,1,"みな"],[20,1,"て"],[38,1,"い"],[41,1,"こた"],[51,1,"ち"],[55,1,"ふ"],[58,1,"しゅ"],[60,1,"はい"]],"text":"エズラは大いなる神、主をほめ、民は皆その手をあげて、「アァメン、アァメン」と言って答え、こうべをたれ、地にひれ伏して主を拝した。"},{"ref":"Neh.8.7","start":16008007,"end":16008007,"break":"none","ruby":[[68,1,"たみ"],[70,2,"りっぽう"],[73,1,"さと"],[78,1,"たみ"],[82,1,"ところ"],[84,1,"た"]],"text":"エシュア、バニ、セレビヤ、ヤミン、アックブ、シャベタイ、ホデヤ、マアセヤ、ケリタ、アザリヤ、ヨザバデ、ハナン、ペラヤおよびレビびとたちは民に律法を悟らせた。民はその所に立っていた。"},{"ref":"Neh.8.8","start":16008008,"end":16008008,"break":"none","ruby":[[0,1,"かれ"],[5,1,"しょ"],[11,1,"かみ"],[13,2,"りっぽう"],[22,1,"よ"],[27,2,"いみ"],[30,1,"と"],[32,1,"あ"],[38,1,"よ"],[44,1,"さと"]],"text":"彼らはその書、すなわち神の律法をめいりょうに読み、その意味を解き明かしてその読むところを悟らせた。"},{"ref":"Neh.8.9","start":16008009,"end":16008009,"break":"paragraph","ruby":[[0,2,"そうとく"],[11,2,"さいし"],[17,2,"がくしゃ"],[27,1,"たみ"],[29,1,"おし"],[43,1,"たみ"],[45,1,"む"],[52,1,"ひ"],[60,1,"かみ"],[62,1,"しゅ"],[64,1,"せい"],[67,1,"ひ"],[71,1,"なげ"],[76,1,"な"],[89,1,"い"],[97,1,"たみ"],[99,2,"りっぽう"],[102,2,"ことば"],[105,1,"き"],[108,1,"な"]],"text":"総督であるネヘミヤと、祭司であり、学者であるエズラと、民を教えるレビびとたちはすべての民に向かって「この日はあなたがたの神、主の聖なる日です。嘆いたり、泣いたりしてはならない」と言った。すべての民が律法の言葉を聞いて泣いたからである。"},{"ref":"Neh.8.10","start":16008010,"end":16008010,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[17,1,"さ"],[21,1,"こ"],[27,1,"た"],[30,1,"あま"],[35,1,"の"],[43,1,"そな"],[52,1,"わ"],[63,1,"ひ"],[70,1,"しゅ"],[72,1,"せい"],[75,1,"ひ"],[79,1,"うれ"],[88,1,"しゅ"],[90,1,"よろこ"],[101,1,"ちから"]],"text":"そして彼らに言った、「あなたがたは去って、肥えたものを食べ、甘いものを飲みなさい。その備えのないものには分けてやりなさい。この日はわれわれの主の聖なる日です。憂えてはならない。主を喜ぶことはあなたがたの力です」。"},{"ref":"Neh.8.11","start":16008011,"end":16008011,"break":"none","ruby":[[11,1,"たみ"],[13,1,"しず"],[18,1,"な"],[31,1,"ひ"],[33,1,"せい"],[36,1,"ひ"],[40,1,"うれ"],[50,1,"い"]],"text":"レビびともまたすべての民を静めて、「泣くことをやめなさい。この日は聖なる日です。憂えてはならない」と言った。"},{"ref":"Neh.8.12","start":16008012,"end":16008012,"break":"none","ruby":[[4,1,"たみ"],[6,1,"さ"],[9,1,"く"],[11,1,"の"],[17,1,"わ"],[19,1,"あた"],[23,1,"おお"],[26,1,"よろこ"],[33,1,"かれ"],[36,1,"よ"],[38,1,"き"],[43,2,"ことば"],[46,1,"さと"]],"text":"すべての民は去って食い飲みし、また分け与えて、大いに喜んだ。これは彼らが読み聞かされた言葉を悟ったからである。"},{"ref":"Neh.8.13","start":16008013,"end":16008013,"break":"paragraph","ruby":[[0,1,"つぎ"],[2,1,"ひ"],[8,1,"たみ"],[10,2,"しぞく"],[13,1,"ちょう"],[17,2,"さいし"],[26,2,"りっぽう"],[29,2,"ことば"],[32,1,"まな"],[37,2,"がくしゃ"],[46,1,"あつ"]],"text":"次の日、すべての民の氏族の長たち、祭司、レビびとらは律法の言葉を学ぶために学者エズラのもとに集まってきて、"},{"ref":"Neh.8.14","start":16008014,"end":16008014,"break":"none","ruby":[[0,2,"りっぽう"],[6,1,"しゅ"],[12,1,"めい"],[30,2,"ひとびと"],[34,1,"がつ"],[36,1,"まつり"],[38,1,"あいだ"],[40,2,"かりいお"],[43,1,"なか"],[45,1,"す"],[61,1,"み"]],"text":"律法のうちに主がモーセに命じられたこと、すなわちイスラエルの人々は七月の祭の間、仮庵の中に住むべきことがしるされているのを見いだした。"},{"ref":"Neh.8.15","start":16008015,"end":16008015,"break":"none","ruby":[[6,2,"まちまち"],[19,1,"つた"],[30,1,"やま"],[32,1,"で"],[34,1,"い"],[42,2,"やせい"],[63,1,"しげ"],[66,1,"き"],[68,1,"えだ"],[70,1,"と"],[87,2,"かりいお"],[90,1,"つく"],[94,1,"い"],[101,1,"み"]],"text":"またすべての町々およびエルサレムにのべ伝えて、「あなたがたは山に出て行って、オリブと野生のオリブ、ミルトス、なつめやし、および茂った木の枝を取ってきて、しるされてあるとおり、仮庵を造れ」と言ってあるのを見いだした。"},{"ref":"Neh.8.16","start":16008016,"end":16008016,"break":"none","ruby":[[3,1,"たみ"],[5,1,"で"],[7,1,"い"],[14,1,"も"],[17,1,"かえ"],[26,1,"いえ"],[28,2,"やね"],[31,1,"うえ"],[35,1,"にわ"],[37,1,"かみ"],[39,1,"みや"],[41,1,"にわ"],[43,1,"みず"],[45,1,"もん"],[47,2,"ひろば"],[56,1,"もん"],[58,2,"ひろば"],[63,2,"かりいお"],[66,1,"つく"]],"text":"それで民は出て行って、それを持って帰り、おのおのその家の屋根の上、その庭、神の宮の庭、水の門の広場、エフライムの門の広場などに仮庵を造った。"},{"ref":"Neh.8.17","start":16008017,"end":16008017,"break":"none","ruby":[[0,2,"ほしゅう"],[4,1,"かえ"],[7,1,"き"],[9,2,"かいしゅう"],[12,1,"みな"],[13,2,"かりいお"],[16,1,"つく"],[20,2,"かりいお"],[23,1,"す"],[30,1,"こ"],[36,1,"ひ"],[41,1,"ひ"],[51,2,"ひとびと"],[59,1,"い"],[75,1,"よろこ"],[78,2,"ひじょう"],[81,1,"おお"]],"text":"捕囚から帰って来た会衆は皆仮庵を造って、仮庵に住んだ。ヌンの子ヨシュアの日からこの日まで、イスラエルの人々はこのように行ったことがなかった。それでその喜びは非常に大きかった。"},{"ref":"Neh.8.18","start":16008018,"end":16008018,"break":"none","ruby":[[4,1,"はじ"],[7,1,"ひ"],[10,1,"おわ"],[13,1,"ひ"],[17,2,"まいにち"],[19,1,"かみ"],[21,2,"りっぽう"],[24,1,"しょ"],[26,1,"よ"],[30,2,"ひとびと"],[33,2,"なぬか"],[36,1,"あいだ"],[38,1,"まつり"],[40,1,"おこな"],[43,2,"ようか"],[45,1,"め"],[60,1,"せい"],[61,1,"かい"],[63,1,"ひら"]],"text":"エズラは初めの日から終りの日まで、毎日神の律法の書を読んだ。人々は七日の間、祭を行い、八日目になって、おきてにしたがって聖会を開いた。"}]