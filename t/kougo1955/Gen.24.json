[{"ref":"Gen.24.1","start":1024001,"end":1024001,"break":"paragraph","ruby":[[6,1,"とし"],[8,1,"すす"],[11,2,"ろうじん"],[18,1,"しゅ"],[24,1,"こと"],[32,1,"めぐ"]],"text":"アブラハムは年が進んで老人となった。主はすべての事にアブラハムを恵まれた。"},{"ref":"Gen.24.2","start":1024002,"end":1024002,"break":"none","ruby":[[8,2,"しょゆう"],[15,2,"かんり"],[22,1,"いえ"],[24,2,"ねんちょう"],[31,1,"い"],[40,1,"て"],[49,1,"した"],[51,1,"い"]],"text":"さてアブラハムは所有のすべてを管理させていた家の年長のしもべに言った、「あなたの手をわたしのももの下に入れなさい。"},{"ref":"Gen.24.3","start":1024003,"end":1024003,"break":"none","ruby":[[8,2,"てんち"],[11,1,"かみ"],[13,1,"しゅ"],[18,1,"ちか"],[31,1,"いま"],[32,2,"いっしょ"],[35,1,"す"],[51,1,"むすめ"],[57,1,"こ"],[59,1,"つま"]],"text":"わたしはあなたに天地の神、主をさして誓わせる。あなたはわたしが今一緒に住んでいるカナンびとのうちから、娘をわたしの子の妻にめとってはならない。"},{"ref":"Gen.24.4","start":1024004,"end":1024004,"break":"none","ruby":[[8,1,"くに"],[10,1,"い"],[13,2,"しんぞく"],[16,1,"ところ"],[18,1,"い"],[26,1,"こ"],[34,1,"つま"]],"text":"あなたはわたしの国へ行き、親族の所へ行って、わたしの子イサクのために妻をめとらなければならない」。"},{"ref":"Gen.24.5","start":1024005,"end":1024005,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[15,1,"おんな"],[26,1,"ち"],[28,1,"く"],[33,1,"この"],[37,1,"とき"],[48,1,"こ"],[54,2,"しゅっしん"],[56,1,"ち"],[58,1,"つ"],[60,1,"かえ"]],"text":"しもべは彼に言った、「もしその女がわたしについてこの地に来ることを好まない時は、わたしはあなたの子をあなたの出身地に連れ帰るべきでしょうか」。"},{"ref":"Gen.24.6","start":1024006,"end":1024006,"break":"none","ruby":[[6,1,"かれ"],[8,1,"い"],[17,1,"こ"],[19,1,"けっ"],[22,1,"む"],[26,1,"つ"],[28,1,"かえ"]],"text":"アブラハムは彼に言った、「わたしの子は決して向こうへ連れ帰ってはならない。"},{"ref":"Gen.24.7","start":1024007,"end":1024007,"break":"none","ruby":[[0,1,"てん"],[2,1,"かみ"],[4,1,"しゅ"],[10,1,"ちち"],[12,1,"いえ"],[14,2,"しんぞく"],[17,1,"ち"],[20,1,"みちび"],[22,1,"だ"],[29,1,"かた"],[36,1,"ちか"],[44,2,"しそん"],[49,1,"ち"],[51,1,"あた"],[55,1,"い"],[60,1,"しゅ"],[64,1,"つかい"],[70,1,"まえ"],[96,1,"こ"],[98,1,"つま"]],"text":"天の神、主はわたしを父の家、親族の地から導き出してわたしに語り、わたしに誓って、おまえの子孫にこの地を与えると言われた。主は、み使をあなたの前につかわされるであろう。あなたはあそこからわたしの子に妻をめとらねばならない。"},{"ref":"Gen.24.8","start":1024008,"end":1024008,"break":"none","ruby":[[6,1,"おんな"],[15,1,"く"],[20,1,"この"],[33,1,"ちか"],[36,1,"と"],[47,1,"こ"],[49,1,"む"],[53,1,"つ"],[55,1,"かえ"]],"text":"けれどもその女があなたについて来ることを好まないなら、あなたはこの誓いを解かれる。ただわたしの子を向こうへ連れ帰ってはならない」。"},{"ref":"Gen.24.9","start":1024009,"end":1024009,"break":"none","ruby":[[7,1,"て"],[9,2,"しゅじん"],[20,1,"した"],[22,1,"い"],[27,1,"こと"],[32,1,"かれ"],[34,1,"ちか"]],"text":"そこでしもべは手を主人アブラハムのももの下に入れ、この事について彼に誓った。"},{"ref":"Gen.24.10","start":1024010,"end":1024010,"break":"paragraph","ruby":[[4,2,"しゅじん"],[16,1,"とう"],[22,1,"と"],[25,1,"で"],[34,2,"しゅじん"],[42,1,"よ"],[44,1,"もの"],[46,1,"たずさ"],[49,1,"た"],[70,1,"まち"],[72,1,"い"]],"text":"しもべは主人のらくだのうちから十頭のらくだを取って出かけた。すなわち主人のさまざまの良い物を携え、立ってアラム・ナハライムにむかい、ナホルの町へ行った。"},{"ref":"Gen.24.11","start":1024011,"end":1024011,"break":"none","ruby":[[0,1,"かれ"],[6,1,"まち"],[8,1,"そと"],[11,1,"みず"],[13,2,"いど"],[19,1,"ふ"],[24,1,"とき"],[26,2,"ゆうぐれ"],[30,1,"おんな"],[34,1,"みず"],[39,1,"で"],[41,2,"じこく"]],"text":"彼はらくだを町の外の、水の井戸のそばに伏させた。時は夕暮で、女たちが水をくみに出る時刻であった。"},{"ref":"Gen.24.12","start":1024012,"end":1024012,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,2,"しゅじん"],[15,1,"かみ"],[17,1,"しゅ"],[37,1,"さづ"],[40,2,"しゅじん"],[48,1,"めぐ"],[51,1,"ほどこ"]],"text":"彼は言った、「主人アブラハムの神、主よ、どうか、きょう、わたしにしあわせを授け、主人アブラハムに恵みを施してください。"},{"ref":"Gen.24.13","start":1024013,"end":1024013,"break":"none","ruby":[[4,1,"いずみ"],[9,1,"た"],[16,1,"まち"],[18,2,"ひとびと"],[21,1,"むすめ"],[25,1,"みず"],[30,1,"で"]],"text":"わたしは泉のそばに立っています。町の人々の娘たちが水をくみに出てきたとき、"},{"ref":"Gen.24.14","start":1024014,"end":1024014,"break":"none","ruby":[[0,1,"むすめ"],[2,1,"む"],[8,1,"ねが"],[17,1,"みず"],[21,1,"かたむ"],[28,1,"の"],[38,1,"い"],[41,1,"むすめ"],[43,1,"こた"],[49,1,"の"],[65,1,"の"],[74,1,"い"],[82,1,"もの"],[100,1,"さだ"],[105,1,"もの"],[138,2,"しゅじん"],[141,1,"めぐ"],[144,1,"ほどこ"],[151,1,"し"]],"text":"娘に向かって『お願いです、あなたの水がめを傾けてわたしに飲ませてください』と言い、娘が答えて、『お飲みください。あなたのらくだにも飲ませましょう』と言ったなら、その者こそ、あなたがしもべイサクのために定められた者ということにしてください。わたしはこれによって、あなたがわたしの主人に恵みを施されることを知りましょう」。"},{"ref":"Gen.24.15","start":1024015,"end":1024015,"break":"paragraph","ruby":[[0,1,"かれ"],[4,1,"い"],[6,1,"おわ"],[20,2,"きょうだい"],[26,1,"つま"],[31,1,"こ"],[37,1,"むすめ"],[43,1,"みず"],[47,1,"かた"],[49,1,"の"],[52,1,"で"]],"text":"彼がまだ言い終らないうちに、アブラハムの兄弟ナホルの妻ミルカの子ベトエルの娘リベカが、水がめを肩に載せて出てきた。"},{"ref":"Gen.24.16","start":1024016,"end":1024016,"break":"none","ruby":[[2,1,"むすめ"],[4,2,"ひじょう"],[7,1,"うつく"],[11,1,"おとこ"],[13,1,"し"],[16,2,"しょじょ"],[23,2,"かのじょ"],[26,1,"いずみ"],[28,1,"ふ"],[32,1,"みず"],[36,1,"み"],[40,1,"あ"],[46,1,"とき"]],"text":"その娘は非常に美しく、男を知らぬ処女であった。彼女が泉に降りて、水がめを満たし、上がってきた時、"},{"ref":"Gen.24.17","start":1024017,"end":1024017,"break":"none","ruby":[[4,1,"はし"],[6,1,"よ"],[10,2,"かのじょ"],[13,1,"あ"],[16,1,"い"],[22,1,"ねが"],[31,1,"みず"],[35,1,"みず"],[37,1,"すこ"],[39,1,"の"]],"text":"しもべは走り寄って、彼女に会って言った、「お願いです。あなたの水がめの水を少し飲ませてください」。"},{"ref":"Gen.24.18","start":1024018,"end":1024018,"break":"none","ruby":[[3,2,"かのじょ"],[9,1,"しゅ"],[13,1,"の"],[21,1,"い"],[25,1,"いそ"],[28,1,"みず"],[32,2,"じぶん"],[35,1,"て"],[37,1,"と"],[43,1,"かれ"],[45,1,"の"]],"text":"すると彼女は「わが主よ、お飲みください」と言って、急いで水がめを自分の手に取りおろして彼に飲ませた。"},{"ref":"Gen.24.19","start":1024019,"end":1024019,"break":"none","ruby":[[0,1,"の"],[3,1,"おわ"],[7,2,"かのじょ"],[10,1,"い"],[25,1,"の"],[27,1,"おわ"],[36,1,"みず"]],"text":"飲ませ終って、彼女は言った、「あなたのらくだもみな飲み終るまで、わたしは水をくみましょう」。"},{"ref":"Gen.24.20","start":1024020,"end":1024020,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"いそ"],[9,1,"みず"],[11,1,"みず"],[18,1,"ふたた"],[20,1,"みず"],[25,2,"いど"],[28,1,"はし"],[31,1,"い"],[46,1,"みず"]],"text":"彼女は急いでかめの水を水ぶねにあけ、再び水をくみに井戸に走って行って、すべてのらくだのために水をくんだ。"},{"ref":"Gen.24.21","start":1024021,"end":1024021,"break":"none","ruby":[[2,1,"かん"],[5,1,"ひと"],[7,1,"しゅ"],[9,1,"かれ"],[11,1,"たび"],[13,2,"しゅくふく"],[24,1,"し"],[29,1,"だま"],[32,2,"かのじょ"],[35,1,"み"]],"text":"その間その人は主が彼の旅の祝福されるか、どうかを知ろうと、黙って彼女を見つめていた。"},{"ref":"Gen.24.22","start":1024022,"end":1024022,"break":"paragraph","ruby":[[4,1,"の"],[6,1,"おわ"],[14,1,"ひと"],[16,1,"おも"],[18,1,"はん"],[23,1,"きん"],[25,2,"はなわ"],[31,1,"おも"],[38,1,"きん"],[40,2,"うでわ"],[45,1,"と"]],"text":"らくだが飲み終ったとき、その人は重さ半シケルの金の鼻輪一つと、重さ十シケルの金の腕輪二つを取って、"},{"ref":"Gen.24.23","start":1024023,"end":1024023,"break":"none","ruby":[[0,1,"い"],[12,1,"むすめ"],[19,1,"はな"],[31,1,"ちち"],[33,1,"いえ"],[41,1,"と"],[44,2,"ばしょ"]],"text":"言った、「あなたはだれの娘か、わたしに話してください。あなたの父の家にわたしどもの泊まる場所がありましょうか」。"},{"ref":"Gen.24.24","start":1024024,"end":1024024,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"かれ"],[5,1,"い"],[18,1,"つま"],[23,1,"こ"],[29,1,"むすめ"]],"text":"彼女は彼に言った、「わたしはナホルの妻ミルカの子ベトエルの娘です」。"},{"ref":"Gen.24.25","start":1024025,"end":1024025,"break":"none","ruby":[[2,1,"かれ"],[4,1,"い"],[21,2,"かいば"],[35,1,"と"],[38,2,"ばしょ"]],"text":"また彼に言った、「わたしどもには、わらも、飼葉もたくさんあります。また泊まる場所もあります」。"},{"ref":"Gen.24.26","start":1024026,"end":1024026,"break":"none","ruby":[[2,1,"ひと"],[4,1,"とう"],[6,1,"さ"],[9,1,"しゅ"],[11,1,"はい"]],"text":"その人は頭を下げ、主を拝して、"},{"ref":"Gen.24.27","start":1024027,"end":1024027,"break":"none","ruby":[[0,1,"い"],[5,2,"しゅじん"],[13,1,"かみ"],[15,1,"しゅ"],[24,1,"しゅ"],[30,2,"しゅじん"],[45,1,"お"],[57,1,"しゅ"],[59,1,"たび"],[67,2,"しゅじん"],[70,2,"きょうだい"],[73,1,"いえ"],[75,1,"みちび"]],"text":"言った、「主人アブラハムの神、主はほむべきかな。主はわたしの主人にいつくしみと、まこととを惜しまれなかった。そして主は旅にあるわたしを主人の兄弟の家に導かれた」。"},{"ref":"Gen.24.28","start":1024028,"end":1024028,"break":"paragraph","ruby":[[0,1,"むすめ"],[2,1,"はし"],[5,1,"い"],[9,1,"はは"],[11,1,"いえ"],[20,1,"こと"],[22,1,"つ"]],"text":"娘は走って行って、母の家のものにこれらの事を告げた。"},{"ref":"Gen.24.29","start":1024029,"end":1024029,"break":"none","ruby":[[8,1,"あに"],[14,1,"な"],[28,1,"いずみ"],[37,1,"ひと"],[39,1,"ところ"],[41,1,"はし"],[44,1,"い"]],"text":"リベカにひとりの兄があって、名をラバンといった。ラバンは泉のそばにいるその人の所へ走って行った。"},{"ref":"Gen.24.30","start":1024030,"end":1024030,"break":"none","ruby":[[0,1,"かれ"],[2,2,"はなわ"],[5,1,"いもうと"],[7,1,"て"],[11,2,"うでわ"],[15,1,"み"],[19,1,"いもうと"],[27,1,"ひと"],[35,1,"い"],[44,1,"き"],[50,1,"ひと"],[52,1,"ところ"],[54,1,"い"],[63,1,"ひと"],[65,1,"いずみ"],[79,1,"た"]],"text":"彼は鼻輪と妹の手にある腕輪とを見、また妹リベカが「その人はわたしにこう言った」というのを聞いて、その人の所へ行ってみると、その人は泉のほとりで、らくだのそばに立っていた。"},{"ref":"Gen.24.31","start":1024031,"end":1024031,"break":"none","ruby":[[5,1,"ひと"],[7,1,"い"],[12,1,"しゅ"],[14,2,"しゅくふく"],[19,1,"ひと"],[33,1,"そと"],[35,1,"た"],[49,1,"いえ"],[51,2,"じゅんび"],[63,2,"ばしょ"],[66,2,"じゅんび"]],"text":"そこでその人に言った、「主に祝福された人よ、おはいりください。なぜ外に立っておられますか。わたしは家を準備し、らくだのためにも場所を準備しておきました」。"},{"ref":"Gen.24.32","start":1024032,"end":1024032,"break":"none","ruby":[[2,1,"ひと"],[4,1,"いえ"],[19,1,"に"],[21,1,"と"],[28,2,"かいば"],[35,1,"あた"],[40,1,"みず"],[42,1,"あた"],[47,1,"ひと"],[49,1,"あし"],[54,2,"じゅうしゃ"],[59,1,"あし"],[61,1,"あら"]],"text":"その人は家にはいった。ラバンはらくだの荷を解いて、わらと飼葉をらくだに与え、また水を与えてその人の足と、その従者たちの足を洗わせた。"},{"ref":"Gen.24.33","start":1024033,"end":1024033,"break":"none","ruby":[[3,1,"かれ"],[5,1,"まえ"],[7,2,"しょくもつ"],[10,1,"そな"],[15,1,"かれ"],[17,1,"い"],[26,2,"ようむ"],[30,1,"はな"],[35,1,"た"],[46,1,"い"],[52,1,"はな"]],"text":"そして彼の前に食物を供えたが、彼は言った、「わたしは用向きを話すまでは食べません」。ラバンは言った、「お話しください」。"},{"ref":"Gen.24.34","start":1024034,"end":1024034,"break":"paragraph","ruby":[[3,1,"かれ"],[5,1,"い"]],"text":"そこで彼は言った、「わたしはアブラハムのしもべです。"},{"ref":"Gen.24.35","start":1024035,"end":1024035,"break":"none","ruby":[[0,1,"しゅ"],[6,2,"しゅじん"],[9,1,"おお"],[12,2,"しゅくふく"],[17,1,"おお"],[21,1,"もの"],[29,1,"しゅ"],[33,1,"かれ"],[35,1,"ひつじ"],[37,1,"うし"],[39,1,"ぎん"],[41,1,"きん"],[43,2,"だんじょ"],[46,2,"どれい"],[56,1,"あた"]],"text":"主はわたしの主人を大いに祝福して、大いなる者とされました。主はまた彼に羊、牛、銀、金、男女の奴隷、らくだ、ろばを与えられました。"},{"ref":"Gen.24.36","start":1024036,"end":1024036,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"つま"],[7,2,"としお"],[14,2,"しゅじん"],[17,1,"おとこ"],[19,1,"こ"],[21,1,"う"],[27,2,"しゅじん"],[32,2,"しょゆう"],[35,1,"みな"],[39,1,"あた"]],"text":"主人の妻サラは年老いてから、主人に男の子を産みました。主人はその所有を皆これに与えました。"},{"ref":"Gen.24.37","start":1024037,"end":1024037,"break":"none","ruby":[[4,2,"しゅじん"],[11,1,"ちか"],[15,1,"い"],[26,1,"す"],[31,1,"ち"],[39,1,"むすめ"],[46,1,"こ"],[48,1,"つま"]],"text":"ところで主人はわたしに誓わせて言いました、『わたしの住んでいる地のカナンびとの娘を、わたしの子の妻にめとってはならない。"},{"ref":"Gen.24.38","start":1024038,"end":1024038,"break":"none","ruby":[[8,1,"ちち"],[10,1,"いえ"],[12,2,"しんぞく"],[15,1,"ところ"],[17,1,"い"],[25,1,"こ"],[27,1,"つま"]],"text":"おまえはわたしの父の家、親族の所へ行って、わたしの子に妻をめとらなければならない』。"},{"ref":"Gen.24.39","start":1024039,"end":1024039,"break":"none","ruby":[[4,2,"しゅじん"],[7,1,"い"],[18,1,"おんな"],[30,1,"とき"]],"text":"わたしは主人に言いました、『もしその女がわたしについてこない時はどういたしましょうか』。"},{"ref":"Gen.24.40","start":1024040,"end":1024040,"break":"none","ruby":[[0,2,"しゅじん"],[7,1,"い"],[18,1,"つか"],[23,1,"しゅ"],[27,1,"つかい"],[33,2,"いっしょ"],[46,1,"たび"],[53,1,"あた"],[71,2,"しんぞく"],[78,1,"ちち"],[80,1,"いえ"],[87,1,"こ"],[89,1,"つま"]],"text":"主人はわたしに言いました、『わたしの仕えている主は、み使をおまえと一緒につかわして、おまえの旅にさいわいを与えられるであろう。おまえはわたしの親族、わたしの父の家からわたしの子に妻をめとらなければならない。"},{"ref":"Gen.24.41","start":1024041,"end":1024041,"break":"none","ruby":[[15,1,"ちか"],[19,1,"と"],[38,2,"しんぞく"],[41,1,"い"],[43,1,"とき"],[45,1,"かれ"],[54,1,"むすめ"],[56,1,"あた"],[73,1,"ちか"],[77,1,"と"]],"text":"そのとき、おまえはわたしにした誓いから解かれるであろう。またおまえがわたしの親族に行く時、彼らがおまえにその娘を与えないなら、おまえはわたしにした誓いから解かれるであろう』。"},{"ref":"Gen.24.42","start":1024042,"end":1024042,"break":"paragraph","ruby":[[8,1,"いずみ"],[16,1,"い"],[23,2,"しゅじん"],[31,1,"かみ"],[33,1,"しゅ"],[39,1,"いま"],[46,1,"みち"],[53,1,"あた"]],"text":"わたしはきょう、泉のところにきて言いました、『主人アブラハムの神、主よ、どうか今わたしのゆく道にさいわいを与えてください。"},{"ref":"Gen.24.43","start":1024043,"end":1024043,"break":"none","ruby":[[6,1,"いずみ"],[11,1,"た"],[19,1,"みず"],[24,1,"で"],[28,1,"むすめ"],[30,1,"む"],[37,1,"ねが"],[46,1,"みず"],[50,1,"みず"],[52,1,"すこ"],[54,1,"の"],[64,1,"い"]],"text":"わたしはこの泉のそばに立っていますが、水をくみに出てくる娘に向かって、「お願いです。あなたの水がめの水を少し飲ませてください」と言い、"},{"ref":"Gen.24.44","start":1024044,"end":1024044,"break":"none","ruby":[[2,1,"の"],[34,1,"い"],[41,1,"むすめ"],[45,1,"しゅ"],[51,2,"しゅじん"],[54,1,"こ"],[59,1,"さだ"],[64,1,"おんな"]],"text":"「お飲みください。あなたのらくだのためにも、くみましょう」とわたしに言うなら、その娘こそ、主がわたしの主人の子のために定められた女ということにしてください』。"},{"ref":"Gen.24.45","start":1024045,"end":1024045,"break":"paragraph","ruby":[[4,1,"こころ"],[11,1,"い"],[13,1,"おわ"],[25,1,"みず"],[29,1,"かた"],[31,1,"の"],[34,1,"で"],[39,1,"みず"],[44,1,"いずみ"],[46,1,"ふ"],[58,1,"ねが"],[63,1,"の"],[73,1,"い"]],"text":"わたしが心のうちでそう言い終らないうちに、リベカが水がめを肩に載せて出てきて、水をくみに泉に降りたので、わたしは『お願いです、飲ませてください』と言いますと、"},{"ref":"Gen.24.46","start":1024046,"end":1024046,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"いそ"],[6,1,"みず"],[10,1,"かた"],[19,1,"の"],[39,1,"の"],[48,1,"い"],[61,1,"の"],[68,2,"かのじょ"],[76,1,"の"]],"text":"彼女は急いで水がめを肩からおろし、『お飲みください。わたしはあなたのらくだにも飲ませましょう』と言いました。それでわたしは飲みましたが、彼女はらくだにも飲ませました。"},{"ref":"Gen.24.47","start":1024047,"end":1024047,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"たず"],[19,1,"むすめ"],[25,1,"い"],[38,1,"つま"],[43,1,"こ"],[49,1,"むすめ"],[54,1,"こた"],[67,2,"かのじょ"],[70,1,"はな"],[72,2,"はなわ"],[78,1,"て"],[80,2,"うでわ"]],"text":"わたしは彼女に尋ねて、『あなたはだれの娘ですか』と言いますと、『ナホルとその妻ミルカの子ベトエルの娘です』と答えました。そこでわたしは彼女の鼻に鼻輪をつけ、手に腕輪をつけました。"},{"ref":"Gen.24.48","start":1024048,"end":1024048,"break":"none","ruby":[[7,1,"あたま"],[12,1,"しゅ"],[14,1,"はい"],[17,2,"しゅじん"],[25,1,"かみ"],[27,1,"しゅ"],[38,1,"しゅ"],[40,2,"しゅじん"],[43,2,"きょうだい"],[46,1,"むすめ"],[48,1,"こ"],[62,1,"ただ"],[65,1,"みち"],[67,1,"みちび"]],"text":"そしてわたしは頭をさげて主を拝し、主人アブラハムの神、主をほめたたえました。主は主人の兄弟の娘を子にめとらせようと、わたしを正しい道に導かれたからです。"},{"ref":"Gen.24.49","start":1024049,"end":1024049,"break":"none","ruby":[[13,2,"しゅじん"],[27,1,"つく"],[31,1,"おも"],[46,1,"はな"],[68,1,"はな"],[85,1,"みぎ"],[87,1,"ひだり"],[89,1,"き"]],"text":"あなたがたが、もしわたしの主人にいつくしみと、まことを尽そうと思われるなら、そうとわたしにお話しください。そうでなければ、そうでないとお話しください。それによってわたしは右か左に決めましょう」。"},{"ref":"Gen.24.50","start":1024050,"end":1024050,"break":"paragraph","ruby":[[9,1,"こた"],[12,1,"い"],[19,1,"こと"],[21,1,"しゅ"],[24,1,"で"],[48,1,"い"]],"text":"ラバンとベトエルは答えて言った、「この事は主から出たことですから、わたしどもはあなたによしあしを言うことができません。"},{"ref":"Gen.24.51","start":1024051,"end":1024051,"break":"none","ruby":[[13,1,"つ"],[16,1,"い"],[20,1,"しゅ"],[22,1,"い"],[34,2,"しゅじん"],[37,1,"こ"],[39,1,"つま"]],"text":"リベカがここにおりますから連れて行って、主が言われたように、あなたの主人の子の妻にしてください」。"},{"ref":"Gen.24.52","start":1024052,"end":1024052,"break":"paragraph","ruby":[[10,1,"かれ"],[13,2,"ことば"],[16,1,"き"],[20,1,"ち"],[22,1,"ふ"],[25,1,"しゅ"],[27,1,"はい"]],"text":"アブラハムのしもべは彼らの言葉を聞いて、地に伏し、主を拝した。"},{"ref":"Gen.24.53","start":1024053,"end":1024053,"break":"none","ruby":[[7,1,"ぎん"],[9,1,"かざ"],[13,1,"きん"],[15,1,"かざ"],[21,2,"いふく"],[24,1,"と"],[26,1,"だ"],[33,1,"あた"],[38,1,"あに"],[40,1,"はは"],[44,1,"あたい"],[46,1,"たか"],[48,2,"しなじな"],[51,1,"あた"]],"text":"そしてしもべは銀の飾りと、金の飾り、および衣服を取り出してリベカに与え、その兄と母とにも価の高い品々を与えた。"},{"ref":"Gen.24.54","start":1024054,"end":1024054,"break":"none","ruby":[[0,1,"かれ"],[2,2,"じゅうしゃ"],[7,1,"の"],[9,1,"く"],[13,1,"やど"],[21,1,"あさ"],[22,1,"かれ"],[25,1,"お"],[28,1,"とき"],[34,1,"い"],[43,2,"しゅじん"],[49,1,"かえ"]],"text":"彼と従者たちは飲み食いして宿ったが、あくる朝彼らが起きた時、しもべは言った、「わたしを主人のもとに帰らせてください」。"},{"ref":"Gen.24.55","start":1024055,"end":1024055,"break":"none","ruby":[[4,1,"あに"],[6,1,"はは"],[9,1,"い"],[14,1,"むすめ"],[16,2,"すうじつ"],[19,1,"すく"],[25,1,"か"],[33,1,"とも"],[42,1,"い"]],"text":"リベカの兄と母とは言った、「娘は数日、少なくとも十日、わたしどもと共にいて、それから行かせましょう」。"},{"ref":"Gen.24.56","start":1024056,"end":1024056,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[12,1,"しゅ"],[18,1,"みち"],[25,1,"あた"],[39,1,"ひ"],[46,2,"しゅじん"],[52,1,"かえ"]],"text":"しもべは彼らに言った、「主はわたしの道にさいわいを与えられましたから、わたしを引きとめずに、主人のもとに帰らせてください」。"},{"ref":"Gen.24.57","start":1024057,"end":1024057,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[8,1,"むすめ"],[10,1,"よ"],[13,1,"き"]],"text":"彼らは言った、「娘を呼んで聞いてみましょう」。"},{"ref":"Gen.24.58","start":1024058,"end":1024058,"break":"none","ruby":[[0,1,"かれ"],[7,1,"よ"],[10,1,"い"],[21,1,"ひと"],[23,2,"いっしょ"],[26,1,"い"],[33,2,"かのじょ"],[36,1,"い"],[41,1,"い"]],"text":"彼らはリベカを呼んで言った、「あなたはこの人と一緒に行きますか」。彼女は言った、「行きます」。"},{"ref":"Gen.24.59","start":1024059,"end":1024059,"break":"none","ruby":[[3,1,"かれ"],[6,1,"いもうと"],[31,2,"じゅうしゃ"],[35,1,"おく"],[37,1,"さ"]],"text":"そこで彼らは妹リベカと、そのうばと、アブラハムのしもべと、その従者とを送り去らせた。"},{"ref":"Gen.24.60","start":1024060,"end":1024060,"break":"none","breaks":[[18,"stanza"],[39,"line"]],"ruby":[[0,1,"かれ"],[7,2,"しゅくふく"],[11,2,"かのじょ"],[14,1,"い"],[19,1,"いもうと"],[32,1,"ひと"],[34,1,"はは"],[43,2,"しそん"],[48,1,"てき"],[50,1,"もん"],[52,1,"う"],[54,1,"と"]],"text":"彼らはリベカを祝福して彼女に言った、「妹よ、あなたは、ちよろずの人の母となれ。あなたの子孫はその敵の門を打ち取れ」。"},{"ref":"Gen.24.61","start":1024061,"end":1024061,"break":"none","ruby":[[4,1,"た"],[7,2,"じじょ"],[12,1,"とも"],[18,1,"の"],[23,1,"ひと"],[25,1,"したが"],[28,1,"い"],[40,1,"つ"],[43,1,"た"],[45,1,"さ"]],"text":"リベカは立って侍女たちと共にらくだに乗り、その人に従って行った。しもべはリベカを連れて立ち去った。"},{"ref":"Gen.24.62","start":1024062,"end":1024062,"break":"paragraph","ruby":[[25,1,"ち"],[27,1,"す"]],"text":"さてイサクはベエル・ラハイ・ロイからきて、ネゲブの地に住んでいた。"},{"ref":"Gen.24.63","start":1024063,"end":1024063,"break":"none","ruby":[[4,2,"ゆうぐれ"],[7,1,"の"],[9,1,"で"],[11,1,"ある"],[18,1,"め"],[28,1,"く"],[32,1,"み"]],"text":"イサクは夕暮、野に出て歩いていたが、目をあげて、らくだの来るのを見た。"},{"ref":"Gen.24.64","start":1024064,"end":1024064,"break":"none","ruby":[[4,1,"め"],[13,1,"み"]],"text":"リベカは目をあげてイサクを見、らくだからおりて、"},{"ref":"Gen.24.65","start":1024065,"end":1024065,"break":"none","ruby":[[4,1,"い"],[15,1,"む"],[20,1,"の"],[22,1,"ある"],[25,1,"く"],[29,1,"ひと"],[43,1,"い"],[55,2,"しゅじん"],[69,2,"かずき"],[72,1,"み"]],"text":"しもべに言った、「わたしたちに向かって、野を歩いて来るあの人はだれでしょう」。しもべは言った、「あれはわたしの主人です」。するとリベカは、被衣で身をおおった。"},{"ref":"Gen.24.66","start":1024066,"end":1024066,"break":"none","ruby":[[4,2,"じぶん"],[20,1,"はな"]],"text":"しもべは自分がしたことのすべてをイサクに話した。"},{"ref":"Gen.24.67","start":1024067,"end":1024067,"break":"none","ruby":[[8,2,"てんまく"],[11,1,"つ"],[14,1,"い"],[25,1,"つま"],[29,2,"かのじょ"],[32,1,"あい"],[44,1,"はは"],[46,2,"しご"],[49,1,"なぐさ"],[52,1,"え"]],"text":"イサクはリベカを天幕に連れて行き、リベカをめとって妻とし、彼女を愛した。こうしてイサクは母の死後、慰めを得た。"}]