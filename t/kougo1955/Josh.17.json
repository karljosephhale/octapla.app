[{"ref":"Josh.17.1","start":6017001,"end":6017001,"break":"paragraph","ruby":[[4,2,"ぶぞく"],[14,1,"え"],[16,1,"ち"],[19,1,"つぎ"],[36,2,"ちょうし"],[47,2,"ちょうし"],[56,1,"ちち"],[65,2,"ぐんじん"],[84,1,"え"]],"text":"マナセの部族が、くじによって獲た地は、次のとおりである。マナセはヨセフの長子であった。マナセの長子で、ギレアデの父であるマキルは、軍人であったので、ギレアデとバシャンを獲た。"},{"ref":"Josh.17.2","start":6017002,"end":6017002,"break":"none","ruby":[[4,2,"ぶぞく"],[7,1,"た"],[16,2,"かぞく"],[25,1,"ち"],[27,1,"あた"],[73,1,"こ"],[78,1,"おとこ"],[80,2,"しそん"],[89,2,"かぞく"]],"text":"マナセの部族の他のものにも、その家族にしたがって、地を与えたが、それは、アビエゼル、ヘレク、アスリエル、シケム、ヘペル、セミダで、これらはヨセフの子マナセの男の子孫であって、その家族にしたがって、あげたものである。"},{"ref":"Josh.17.3","start":6017003,"end":6017003,"break":"paragraph","ruby":[[8,1,"こ"],[15,1,"こ"],[23,1,"こ"],[30,1,"こ"],[43,1,"おんな"],[45,1,"こ"],[50,1,"おとこ"],[52,1,"こ"],[59,1,"おんな"],[61,1,"こ"],[65,1,"な"]],"text":"しかし、マナセの子マキル、その子ギレアデ、その子ヘペル、その子であったゼロペハデには、女の子だけで、男の子がなかった。女の子たちの名は、マヘラ、ノア、ホグラ、ミルカ、テルザといった。"},{"ref":"Josh.17.4","start":6017004,"end":6017004,"break":"none","ruby":[[0,2,"かのじょ"],[6,2,"さいし"],[17,1,"こ"],[32,1,"まえ"],[34,1,"すす"],[36,1,"で"],[46,2,"きょうだい"],[49,1,"おな"],[63,1,"し"],[64,1,"ぎょう"],[66,1,"あた"],[71,1,"しゅ"],[77,1,"めい"],[89,1,"い"],[100,1,"しゅ"],[102,1,"いのち"],[110,1,"かれ"],[113,1,"ちち"],[115,2,"きょうだい"],[120,1,"おな"],[126,2,"かのじょ"],[132,1,"し"],[133,1,"ぎょう"],[135,1,"あた"]],"text":"彼女たちは、祭司エレアザル、ヌンの子ヨシュアおよび、つかさたちの前に進み出て、「わたしたちの兄弟と同じように、わたしたちにも、嗣業を与えよと、主はモーセに命じおきになりました」と言ったので、ヨシュアは主の命にしたがって、彼らの父の兄弟たちと同じように、彼女たちにも嗣業を与えた。"},{"ref":"Josh.17.5","start":6017005,"end":6017005,"break":"none","ruby":[[13,1,"む"],[16,1,"がわ"],[29,1,"ち"],[39,2,"ぶぶん"],[42,1,"え"]],"text":"こうしてマナセはヨルダンの向こう側で、ギレアデとバシャンの地のほかに、なお十の部分を獲た。"},{"ref":"Josh.17.6","start":6017006,"end":6017006,"break":"none","ruby":[[4,1,"むすめ"],[9,1,"おとこ"],[11,1,"こ"],[14,1,"とも"],[17,1,"し"],[18,1,"ぎょう"],[20,1,"え"],[33,1,"ち"],[45,2,"しそん"],[48,1,"わ"],[50,1,"あた"]],"text":"マナセの娘たちが、男の子らと共に、嗣業を獲たからである。ギレアデの地は、そのほかのマナセの子孫に分け与えられた。"},{"ref":"Josh.17.7","start":6017007,"end":6017007,"break":"paragraph","ruby":[[4,1,"え"],[6,1,"ち"],[8,1,"さかい"],[20,1,"ひがし"],[28,1,"およ"],[33,1,"さかい"],[35,1,"みなみ"],[37,1,"の"],[48,2,"じゅうみん"],[51,1,"たっ"]],"text":"マナセの獲た地の境は、アセルからシケムの東のミクメタテに及び、その境は南に延びて、エンタップアの住民に達する。"},{"ref":"Josh.17.8","start":6017008,"end":6017008,"break":"none","ruby":[[5,1,"ち"],[11,1,"ぞく"],[22,1,"さかい"],[31,1,"まち"],[40,2,"しそん"],[43,1,"ぞく"]],"text":"タップアの地はマナセに属していたが、マナセの境にあるタップアの町は、エフライムの子孫に属していた。"},{"ref":"Josh.17.9","start":6017009,"end":6017009,"break":"none","ruby":[[4,1,"さかい"],[9,1,"かわ"],[11,1,"くだ"],[15,1,"かわ"],[17,1,"みなみ"],[19,1,"いた"],[25,2,"まちまち"],[32,2,"まちまち"],[35,1,"なか"],[47,1,"ぞく"],[55,1,"さかい"],[58,1,"かわ"],[60,1,"きた"],[62,1,"そ"],[65,1,"すす"],[68,1,"うみ"],[70,1,"たっ"],[73,1,"つ"]],"text":"またその境はカナの川に下って、川の南に至る。そこの町々はマナセの町々の中にあって、エフライムに属した。マナセの境は、川の北に沿って進み、海に達して尽きる。"},{"ref":"Josh.17.10","start":6017010,"end":6017010,"break":"none","ruby":[[2,1,"かわ"],[4,1,"みなみ"],[6,1,"ち"],[15,1,"ぞく"],[18,1,"きた"],[24,1,"ぞく"],[28,1,"うみ"],[32,1,"さかい"],[41,1,"きた"],[47,1,"せっ"],[50,1,"ひがし"],[58,1,"せっ"]],"text":"その川の南の地は、エフライムに属し、北はマナセに属する。海がその境となる。マナセは北はアセルに接し、東はイッサカルに接する。"},{"ref":"Josh.17.11","start":6017011,"end":6017011,"break":"none","ruby":[[16,1,"なか"],[27,2,"むらむら"],[38,2,"むらむら"],[44,2,"じゅうみん"],[49,2,"むらむら"],[57,2,"じゅうみん"],[62,2,"むらむら"],[70,2,"じゅうみん"],[75,2,"むらむら"],[82,2,"じゅうみん"],[87,2,"むらむら"],[90,1,"え"],[97,1,"だい"],[103,2,"こうち"]],"text":"マナセはまたイッサカルとアセルの中に、ベテシャンとその村々、イブレアムとその村々、ドルの住民とその村々、エンドルの住民とその村々、タアナクの住民とその村々、メギドの住民とその村々を獲た。このうち第三のものは高地である。"},{"ref":"Josh.17.12","start":6017012,"end":6017012,"break":"none","ruby":[[8,2,"しそん"],[16,2,"まちまち"],[19,1,"と"],[39,1,"なが"],[43,1,"ち"],[45,1,"す"],[47,1,"つづ"]],"text":"しかし、マナセの子孫は、これらの町々を取ることができなかったので、カナンびとは長くこの地に住み続けようとした。"},{"ref":"Josh.17.13","start":6017013,"end":6017013,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"つよ"],[30,2,"しえき"],[45,1,"お"],[47,1,"はら"]],"text":"しかし、イスラエルの人々が強くなるにしたがって、カナンびとを使役するようになり、ことごとく追い払うことはしなかった。"},{"ref":"Josh.17.14","start":6017014,"end":6017014,"break":"paragraph","ruby":[[4,2,"しそん"],[12,1,"い"],[17,1,"しゅ"],[19,1,"いま"],[27,2,"しゅくふく"],[39,1,"かず"],[41,1,"おお"],[43,1,"たみ"],[62,1,"し"],[63,1,"ぎょう"],[79,1,"ぶん"]],"text":"ヨセフの子孫はヨシュアに言った、「主が今まで、わたしを祝福されたので、わたしは数の多い民となったのに、あなたはなぜ、わたしの嗣業として、ただ一つのくじ、一つの分だけを、くださったのですか」。"},{"ref":"Josh.17.15","start":6017015,"end":6017015,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[19,1,"かず"],[21,1,"おお"],[23,1,"たみ"],[28,1,"はやし"],[30,1,"のぼ"],[54,1,"ち"],[56,2,"じぶん"],[59,1,"き"],[61,1,"ひら"],[73,2,"さんち"],[84,1,"せま"]],"text":"ヨシュアは彼らに言った、「もしあなたが数の多い民ならば、林に上っていって、そこで、ペリジびとやレパイムびとの地を自分で切り開くがよい。エフライムの山地が、あなたがたには狭いのだから」。"},{"ref":"Josh.17.16","start":6017016,"end":6017016,"break":"none","ruby":[[4,2,"しそん"],[7,1,"こた"],[12,2,"さんち"],[21,2,"じゅうぶん"],[35,2,"へいち"],[55,2,"むらむら"],[69,1,"たに"],[79,1,"てつ"],[81,2,"せんしゃ"],[84,1,"も"]],"text":"ヨセフの子孫は答えた、「山地はわたしどもに十分ではありません。かつまた平地におるカナンびとは、ベテシャンとその村々におるものも、エズレルの谷におるものも、みな鉄の戦車を持っています」。"},{"ref":"Josh.17.17","start":6017017,"end":6017017,"break":"none","ruby":[[11,1,"いえ"],[27,1,"い"],[36,1,"かず"],[38,1,"おお"],[40,1,"たみ"],[43,1,"おお"],[46,1,"ちから"],[67,1,"た"]],"text":"ヨシュアはまたヨセフの家、すなわちエフライムとマナセに言った、「あなたは数の多い民で、大きな力をもっています。それでただ一つのくじでは足りません。"},{"ref":"Josh.17.18","start":6017018,"end":6017018,"break":"none","ruby":[[0,2,"さんち"],[25,1,"はやし"],[32,1,"き"],[34,1,"ひら"],[38,1,"む"],[42,1,"はし"],[46,2,"じぶん"],[69,1,"てつ"],[71,2,"せんしゃ"],[78,1,"つよ"],[92,1,"お"],[94,1,"はら"]],"text":"山地をもあなたのものとしなければなりません。それは林ではあるが、切り開いて、向こうの端まで、自分のものとしなければなりません。カナンびとは鉄の戦車があって、強くはあるが、あなたはそれを追い払うことができます」。"}]