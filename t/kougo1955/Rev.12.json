[{"ref":"Rev.12.1","start":66012001,"end":66012001,"break":"paragraph","ruby":[[3,1,"おお"],[11,1,"てん"],[13,1,"あらわ"],[21,1,"おんな"],[23,2,"たいよう"],[26,1,"き"],[29,1,"あし"],[31,1,"した"],[33,1,"つき"],[35,1,"ふ"],[40,1,"あたま"],[45,1,"ほし"],[47,1,"かんむり"]],"text":"また、大いなるしるしが天に現れた。ひとりの女が太陽を着て、足の下に月を踏み、その頭に十二の星の冠をかぶっていた。"},{"ref":"Rev.12.2","start":66012002,"end":66012002,"break":"none","ruby":[[2,1,"おんな"],[4,1,"こ"],[6,1,"やど"],[12,1,"う"],[15,1,"くる"],[19,1,"なや"],[27,1,"な"],[29,1,"さけ"]],"text":"この女は子を宿しており、産みの苦しみと悩みとのために、泣き叫んでいた。"},{"ref":"Rev.12.3","start":66012003,"end":66012003,"break":"none","ruby":[[12,1,"てん"],[14,1,"あらわ"],[18,1,"み"],[21,1,"おお"],[25,1,"あか"],[27,1,"りゅう"],[38,1,"あたま"],[42,1,"つの"],[50,1,"あたま"],[55,1,"かんむり"]],"text":"また、もう一つのしるしが天に現れた。見よ、大きな、赤い龍がいた。それに七つの頭と十の角とがあり、その頭に七つの冠をかぶっていた。"},{"ref":"Rev.12.4","start":66012004,"end":66012004,"break":"none","ruby":[[2,1,"お"],[4,1,"てん"],[6,1,"ほし"],[9,1,"ぶん"],[13,1,"は"],[15,1,"よ"],[22,1,"ち"],[24,1,"な"],[26,1,"おと"],[30,1,"りゅう"],[32,1,"こ"],[34,1,"う"],[42,1,"おんな"],[44,1,"まえ"],[46,1,"た"],[49,1,"うま"],[57,1,"こ"],[59,1,"く"],[61,1,"つく"]],"text":"その尾は天の星の三分の一を掃き寄せ、それらを地に投げ落した。龍は子を産もうとしている女の前に立ち、生れたなら、その子を食い尽そうとかまえていた。"},{"ref":"Rev.12.5","start":66012005,"end":66012005,"break":"none","ruby":[[0,1,"おんな"],[2,1,"おとこ"],[4,1,"こ"],[6,1,"う"],[11,1,"かれ"],[13,1,"てつ"],[25,2,"こくみん"],[28,1,"おさ"],[33,1,"もの"],[40,1,"こ"],[43,1,"かみ"],[52,2,"みざ"],[60,1,"ひ"],[62,1,"あ"]],"text":"女は男の子を産んだが、彼は鉄のつえをもってすべての国民を治めるべき者である。この子は、神のみもとに、その御座のところに、引き上げられた。"},{"ref":"Rev.12.6","start":66012006,"end":66012006,"break":"none","ruby":[[0,1,"おんな"],[2,2,"あらの"],[5,1,"に"],[8,1,"い"],[17,2,"かのじょ"],[25,1,"にち"],[30,1,"やしな"],[38,1,"かみ"],[40,2,"ようい"],[45,2,"ばしょ"]],"text":"女は荒野へ逃げて行った。そこには、彼女が千二百六十日のあいだ養われるように、神の用意された場所があった。"},{"ref":"Rev.12.7","start":66012007,"end":66012007,"break":"paragraph","ruby":[[3,1,"てん"],[6,1,"たたか"],[9,1,"おこ"],[20,2,"みつかい"],[27,1,"りゅう"],[29,1,"たたか"],[37,1,"りゅう"],[41,1,"つかい"],[45,2,"おうせん"]],"text":"さて、天では戦いが起った。ミカエルとその御使たちとが、龍と戦ったのである。龍もその使たちも応戦したが、"},{"ref":"Rev.12.8","start":66012008,"end":66012008,"break":"none","ruby":[[0,1,"か"],[14,1,"てん"],[17,1,"かれ"],[22,1,"ところ"]],"text":"勝てなかった。そして、もはや天には彼らのおる所がなくなった。"},{"ref":"Rev.12.9","start":66012009,"end":66012009,"break":"none","ruby":[[2,2,"きょだい"],[5,1,"りゅう"],[12,2,"あくま"],[22,1,"よ"],[26,1,"ぜん"],[27,2,"せかい"],[30,1,"まど"],[33,1,"とし"],[35,1,"へ"],[41,1,"ち"],[43,1,"な"],[45,1,"おと"],[51,1,"つかい"],[61,1,"な"],[63,1,"おと"]],"text":"この巨大な龍、すなわち、悪魔とか、サタンとか呼ばれ、全世界を惑わす年を経たへびは、地に投げ落され、その使たちも、もろともに投げ落された。"},{"ref":"Rev.12.10","start":66012010,"end":66012010,"break":"none","breaks":[[25,"stanza"],[42,"line"],[58,"line"],[71,"line"],[92,"line"]],"ruby":[[2,1,"とき"],[8,1,"おお"],[11,1,"こえ"],[13,1,"てん"],[17,1,"い"],[21,1,"き"],[26,1,"いま"],[33,1,"かみ"],[35,1,"すくい"],[37,1,"ちから"],[39,1,"くに"],[42,1,"かみ"],[49,2,"けんい"],[54,1,"あらわ"],[62,2,"きょうだい"],[66,1,"うった"],[69,1,"もの"],[71,2,"よるひる"],[77,1,"かみ"],[83,1,"かれ"],[86,1,"うった"],[89,1,"もの"],[92,1,"な"],[94,1,"おと"]],"text":"その時わたしは、大きな声が天でこう言うのを聞いた、「今や、われらの神の救と力と国と、神のキリストの権威とは、現れた。われらの兄弟らを訴える者、夜昼われらの神のみまえで彼らを訴える者は、投げ落された。"},{"ref":"Rev.12.11","start":66012011,"end":66012011,"break":"line","breaks":[[6,"line"],[26,"line"],[33,"line"]],"ruby":[[0,2,"きょうだい"],[6,2,"こひつじ"],[9,1,"ち"],[11,1,"かれ"],[18,2,"ことば"],[26,1,"かれ"],[30,1,"か"],[33,1,"し"],[35,1,"いた"],[46,1,"お"]],"text":"兄弟たちは、小羊の血と彼らのあかしの言葉とによって、彼にうち勝ち、死に至るまでもそのいのちを惜しまなかった。"},{"ref":"Rev.12.12","start":66012012,"end":66012012,"break":"line","breaks":[[19,"line"],[25,"line"],[34,"line"],[48,"line"],[64,"line"],[74,"line"]],"ruby":[[6,1,"てん"],[10,1,"なか"],[12,1,"す"],[14,1,"もの"],[19,1,"おお"],[22,1,"よろこ"],[29,1,"ち"],[31,1,"うみ"],[48,2,"あくま"],[52,2,"じぶん"],[55,1,"とき"],[57,1,"みじか"],[61,1,"し"],[64,1,"はげ"],[67,1,"いか"],[84,1,"くだ"]],"text":"それゆえに、天とその中に住む者たちよ、大いに喜べ。しかし、地と海よ、おまえたちはわざわいである。悪魔が、自分の時が短いのを知り、激しい怒りをもって、おまえたちのところに下ってきたからである」。"},{"ref":"Rev.12.13","start":66012013,"end":66012013,"break":"none","ruby":[[0,1,"りゅう"],[3,2,"じぶん"],[6,2,"ちじょう"],[9,1,"な"],[11,1,"おと"],[16,1,"し"],[20,2,"だんし"],[23,1,"う"],[26,1,"おんな"],[28,1,"お"]],"text":"龍は、自分が地上に投げ落されたと知ると、男子を産んだ女を追いかけた。"},{"ref":"Rev.12.14","start":66012014,"end":66012014,"break":"none","ruby":[[4,1,"おんな"],[6,2,"じぶん"],[9,2,"ばしょ"],[14,2,"あらの"],[17,1,"と"],[20,1,"い"],[26,1,"おお"],[35,1,"つばさ"],[37,1,"あた"],[59,1,"ねん"],[62,1,"ねん"],[67,2,"はんとし"],[70,1,"あいだ"],[72,1,"やしな"]],"text":"しかし、女は自分の場所である荒野に飛んで行くために、大きなわしの二つの翼を与えられた。そしてそこでへびからのがれて、一年、二年、また、半年の間、養われることになっていた。"},{"ref":"Rev.12.15","start":66012015,"end":66012015,"break":"none","ruby":[[3,1,"おんな"],[5,1,"うしろ"],[7,1,"みず"],[9,1,"かわ"],[15,1,"くち"],[18,1,"は"],[20,1,"だ"],[24,1,"おんな"],[28,1,"なが"]],"text":"へびは女の後に水を川のように、口から吐き出して、女をおし流そうとした。"},{"ref":"Rev.12.16","start":66012016,"end":66012016,"break":"none","ruby":[[4,1,"ち"],[6,1,"おんな"],[8,1,"たす"],[17,1,"ち"],[21,1,"くち"],[23,1,"ひら"],[27,1,"りゅう"],[29,1,"くち"],[32,1,"は"],[34,1,"だ"],[37,1,"かわ"],[39,1,"の"]],"text":"しかし、地は女を助けた。すなわち、地はその口を開いて、龍が口から吐き出した川を飲みほした。"},{"ref":"Rev.12.17","start":66012017,"end":66012017,"break":"none","ruby":[[0,1,"りゅう"],[3,1,"おんな"],[5,1,"たい"],[8,1,"いか"],[11,1,"はっ"],[14,1,"おんな"],[16,1,"のこ"],[19,1,"こ"],[27,1,"かみ"],[29,1,"いまし"],[32,1,"まも"],[43,1,"も"],[48,1,"もの"],[52,1,"たい"],[56,1,"たたか"],[66,1,"で"],[68,1,"い"]],"text":"龍は、女に対して怒りを発し、女の残りの子ら、すなわち、神の戒めを守り、イエスのあかしを持っている者たちに対して、戦いをいどむために、出て行った。"}]