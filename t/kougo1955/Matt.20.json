[{"ref":"Matt.20.1","start":40020001,"end":40020001,"break":"paragraph","ruby":[[0,2,"てんごく"],[6,1,"いえ"],[8,2,"しゅじん"],[12,2,"じぶん"],[18,1,"えん"],[20,3,"ろうどうしゃ"],[24,1,"やと"],[30,1,"よ"],[32,1,"あ"],[36,2,"どうじ"],[40,1,"で"],[44,1,"い"]],"text":"天国は、ある家の主人が、自分のぶどう園に労働者を雇うために、夜が明けると同時に、出かけて行くようなものである。"},{"ref":"Matt.20.2","start":40020002,"end":40020002,"break":"none","ruby":[[0,1,"かれ"],[2,3,"ろうどうしゃ"],[10,1,"にち"],[16,2,"やくそく"],[22,1,"かれ"],[28,1,"えん"],[30,1,"おく"]],"text":"彼は労働者たちと、一日一デナリの約束をして、彼らをぶどう園に送った。"},{"ref":"Matt.20.3","start":40020003,"end":40020003,"break":"none","ruby":[[5,1,"じ"],[9,1,"で"],[11,1,"い"],[15,1,"た"],[17,2,"ひとびと"],[20,2,"いちば"],[23,1,"なに"],[28,1,"た"],[35,1,"み"]],"text":"それから九時ごろに出て行って、他の人々が市場で何もせずに立っているのを見た。"},{"ref":"Matt.20.4","start":40020004,"end":40020004,"break":"none","ruby":[[6,1,"ひと"],[10,1,"い"],[25,1,"えん"],[27,1,"い"],[33,2,"そうとう"],[36,2,"ちんぎん"],[39,1,"はら"]],"text":"そして、その人たちに言った、『あなたがたも、ぶどう園に行きなさい。相当な賃銀を払うから』。"},{"ref":"Matt.20.5","start":40020005,"end":40020005,"break":"none","ruby":[[4,1,"かれ"],[7,1,"で"],[11,1,"い"],[15,2,"しゅじん"],[23,1,"じ"],[28,1,"じ"],[33,1,"で"],[35,1,"い"],[39,1,"おな"]],"text":"そこで、彼らは出かけて行った。主人はまた、十二時ごろと三時ごろとに出て行って、同じようにした。"},{"ref":"Matt.20.6","start":40020006,"end":40020006,"break":"none","ruby":[[1,1,"とき"],[6,1,"で"],[8,1,"い"],[14,1,"た"],[19,2,"ひとびと"],[22,1,"み"],[27,1,"かれ"],[30,1,"い"],[38,1,"なに"],[46,1,"にち"],[47,1,"ぢゅう"],[51,1,"た"]],"text":"五時ごろまた出て行くと、まだ立っている人々を見たので、彼らに言った、『なぜ、何もしないで、一日中ここに立っていたのか』。"},{"ref":"Matt.20.7","start":40020007,"end":40020007,"break":"none","ruby":[[0,1,"かれ"],[13,1,"やと"],[25,1,"こた"],[33,2,"ひとびと"],[36,1,"い"],[51,1,"えん"],[53,1,"い"]],"text":"彼らが『だれもわたしたちを雇ってくれませんから』と答えたので、その人々に言った、『あなたがたも、ぶどう園に行きなさい』。"},{"ref":"Matt.20.8","start":40020008,"end":40020008,"break":"none","ruby":[[3,2,"ゆうがた"],[13,1,"えん"],[15,2,"しゅじん"],[18,3,"かんりにん"],[22,1,"い"],[27,3,"ろうどうしゃ"],[33,1,"よ"],[43,2,"さいご"],[48,2,"ひとびと"],[56,2,"じゅんじゅん"],[59,2,"さいしょ"],[64,2,"ひとびと"],[74,2,"ちんぎん"],[77,1,"はら"]],"text":"さて、夕方になって、ぶどう園の主人は管理人に言った、『労働者たちを呼びなさい。そして、最後にきた人々からはじめて順々に最初にきた人々にわたるように、賃銀を払ってやりなさい』。"},{"ref":"Matt.20.9","start":40020009,"end":40020009,"break":"none","ruby":[[5,1,"とき"],[9,1,"やと"],[13,2,"ひとびと"]],"text":"そこで、五時ごろに雇われた人々がきて、それぞれ一デナリずつもらった。"},{"ref":"Matt.20.10","start":40020010,"end":40020010,"break":"none","ruby":[[5,2,"さいしょ"],[8,2,"ひとびと"],[17,1,"おお"],[27,1,"おも"],[35,1,"かれ"]],"text":"ところが、最初の人々がきて、もっと多くもらえるだろうと思っていたのに、彼らも一デナリずつもらっただけであった。"},{"ref":"Matt.20.11","start":40020011,"end":40020011,"break":"none","ruby":[[7,1,"いえ"],[9,2,"しゅじん"],[16,2,"ふへい"]],"text":"もらったとき、家の主人にむかって不平をもらして"},{"ref":"Matt.20.12","start":40020012,"end":40020012,"break":"none","ruby":[[0,1,"い"],[7,2,"さいご"],[10,1,"もの"],[15,2,"じかん"],[19,1,"はたら"],[33,1,"にち"],[38,2,"ろうく"],[41,1,"あつ"],[44,2,"しんぼう"],[54,1,"おな"],[56,1,"あつか"]],"text":"言った、『この最後の者たちは一時間しか働かなかったのに、あなたは一日じゅう、労苦と暑さを辛抱したわたしたちと同じ扱いをなさいました』。"},{"ref":"Matt.20.13","start":40020013,"end":40020013,"break":"none","ruby":[[3,1,"かれ"],[11,1,"こた"],[14,1,"い"],[19,1,"とも"],[30,1,"たい"],[33,2,"ふせい"],[56,2,"やくそく"]],"text":"そこで彼はそのひとりに答えて言った、『友よ、わたしはあなたに対して不正をしてはいない。あなたはわたしと一デナリの約束をしたではないか。"},{"ref":"Matt.20.14","start":40020014,"end":40020014,"break":"none","ruby":[[0,2,"じぶん"],[3,2,"ちんぎん"],[10,1,"い"],[23,2,"さいご"],[26,1,"もの"],[33,2,"どうよう"],[36,1,"はら"]],"text":"自分の賃銀をもらって行きなさい。わたしは、この最後の者にもあなたと同様に払ってやりたいのだ。"},{"ref":"Matt.20.15","start":40020015,"end":40020015,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"もの"],[5,2,"じぶん"],[19,1,"あた"],[37,2,"きまえ"],[53,1,"おも"]],"text":"自分の物を自分がしたいようにするのは、当りまえではないか。それともわたしが気前よくしているので、ねたましく思うのか』。"},{"ref":"Matt.20.16","start":40020016,"end":40020016,"break":"none","ruby":[[9,1,"もの"],[11,1,"さき"],[16,1,"さき"],[18,1,"もの"]],"text":"このように、あとの者は先になり、先の者はあとになるであろう」。"},{"ref":"Matt.20.17","start":40020017,"end":40020017,"break":"paragraph","ruby":[[13,1,"のぼ"],[20,2,"でし"],[27,1,"よ"],[34,2,"とちゅう"],[37,1,"かれ"],[40,1,"い"]],"text":"さて、イエスはエルサレムへ上るとき、十二弟子をひそかに呼びよせ、その途中で彼らに言われた、"},{"ref":"Matt.20.18","start":40020018,"end":40020018,"break":"none","ruby":[[1,1,"み"],[16,1,"のぼ"],[19,1,"い"],[23,1,"ひと"],[25,1,"こ"],[27,3,"さいしちょう"],[31,2,"りっぽう"],[33,2,"がくしゃ"],[38,1,"て"],[40,1,"わた"],[49,1,"かれ"],[52,1,"かれ"],[54,2,"しけい"],[57,2,"せんこく"]],"text":"「見よ、わたしたちはエルサレムへ上って行くが、人の子は祭司長、律法学者たちの手に渡されるであろう。彼らは彼に死刑を宣告し、"},{"ref":"Matt.20.19","start":40020019,"end":40020019,"break":"none","ruby":[[3,1,"かれ"],[12,1,"う"],[15,3,"じゅうじか"],[28,3,"いほうじん"],[32,1,"ひ"],[45,1,"かれ"],[48,1,"か"],[49,1,"め"]],"text":"そして彼をあざけり、むち打ち、十字架につけさせるために、異邦人に引きわたすであろう。そして彼は三日目によみがえるであろう」。"},{"ref":"Matt.20.20","start":40020020,"end":40020020,"break":"paragraph","ruby":[[10,1,"こ"],[13,1,"はは"],[18,1,"こ"],[21,2,"いっしょ"],[39,2,"なにごと"],[44,1,"ねが"]],"text":"そのとき、ゼベダイの子らの母が、その子らと一緒にイエスのもとにきてひざまずき、何事かをお願いした。"},{"ref":"Matt.20.21","start":40020021,"end":40020021,"break":"none","ruby":[[7,2,"かのじょ"],[10,1,"い"],[16,1,"なに"],[27,2,"かのじょ"],[30,1,"い"],[54,2,"みくに"],[66,1,"みぎ"],[73,1,"ひだり"],[84,2,"ことば"]],"text":"そこでイエスは彼女に言われた、「何をしてほしいのか」。彼女は言った、「わたしのこのふたりのむすこが、あなたの御国で、ひとりはあなたの右に、ひとりは左にすわれるように、お言葉をください」。"},{"ref":"Matt.20.22","start":40020022,"end":40020022,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[20,2,"じぶん"],[23,1,"なに"],[25,1,"もと"],[45,1,"の"],[53,1,"さかずき"],[55,1,"の"],[66,1,"かれ"],[76,1,"こた"]],"text":"イエスは答えて言われた、「あなたがたは、自分が何を求めているのか、わかっていない。わたしの飲もうとしている杯を飲むことができるか」。彼らは「できます」と答えた。"},{"ref":"Matt.20.23","start":40020023,"end":40020023,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[13,1,"たし"],[27,1,"さかずき"],[29,1,"の"],[46,1,"みぎ"],[48,1,"ひだり"],[76,1,"ちち"],[81,1,"そな"],[88,2,"ひとびと"],[93,1,"ゆる"]],"text":"イエスは彼らに言われた、「確かに、あなたがたはわたしの杯を飲むことになろう。しかし、わたしの右、左にすわらせることは、わたしのすることではなく、わたしの父によって備えられている人々だけに許されることである」。"},{"ref":"Matt.20.24","start":40020024,"end":40020024,"break":"none","ruby":[[1,1,"にん"],[3,1,"もの"],[8,1,"き"],[18,2,"きょうだい"],[26,2,"ふんがい"]],"text":"十人の者はこれを聞いて、このふたりの兄弟たちのことで憤慨した。"},{"ref":"Matt.20.25","start":40020025,"end":40020025,"break":"none","ruby":[[8,1,"かれ"],[11,1,"よ"],[13,1,"よ"],[16,1,"い"],[28,1,"し"],[37,3,"いほうじん"],[41,3,"しはいしゃ"],[49,1,"たみ"],[51,2,"おさめ"],[56,1,"えら"],[58,1,"ひと"],[65,1,"たみ"],[67,1,"うえ"],[69,2,"けんりょく"]],"text":"そこで、イエスは彼らを呼び寄せて言われた、「あなたがたの知っているとおり、異邦人の支配者たちはその民を治め、また偉い人たちは、その民の上に権力をふるっている。"},{"ref":"Matt.20.26","start":40020026,"end":40020026,"break":"none","ruby":[[6,1,"あいだ"],[32,1,"あいだ"],[34,1,"えら"],[41,1,"おも"],[43,1,"もの"],[46,1,"つか"],[49,1,"ひと"]],"text":"あなたがたの間ではそうであってはならない。かえって、あなたがたの間で偉くなりたいと思う者は、仕える人となり、"},{"ref":"Matt.20.27","start":40020027,"end":40020027,"break":"none","ruby":[[6,1,"あいだ"],[17,1,"おも"],[19,1,"もの"],[22,1,"しもべ"]],"text":"あなたがたの間でかしらになりたいと思う者は、僕とならねばならない。"},{"ref":"Matt.20.28","start":40020028,"end":40020028,"break":"none","ruby":[[4,1,"ひと"],[6,1,"こ"],[13,1,"つか"],[25,1,"つか"],[36,1,"おお"],[39,1,"ひと"],[49,2,"じぶん"],[52,1,"いのち"],[54,1,"あた"],[69,1,"おな"]],"text":"それは、人の子がきたのも、仕えられるためではなく、仕えるためであり、また多くの人のあがないとして、自分の命を与えるためであるのと、ちょうど同じである」。"},{"ref":"Matt.20.29","start":40020029,"end":40020029,"break":"paragraph","ruby":[[5,1,"かれ"],[12,1,"で"],[14,1,"い"],[20,1,"おお"],[24,2,"ぐんしゅう"],[31,1,"したが"]],"text":"それから、彼らがエリコを出て行ったとき、大ぜいの群衆がイエスに従ってきた。"},{"ref":"Matt.20.30","start":40020030,"end":40020030,"break":"none","ruby":[[8,2,"もうじん"],[11,1,"みち"],[31,1,"い"],[36,1,"き"],[40,1,"さけ"],[43,1,"い"],[48,1,"しゅ"],[55,1,"こ"],[69,1,"くだ"]],"text":"すると、ふたりの盲人が道ばたにすわっていたが、イエスがとおって行かれると聞いて、叫んで言った、「主よ、ダビデの子よ、わたしたちをあわれんで下さい」。"},{"ref":"Matt.20.31","start":40020031,"end":40020031,"break":"none","ruby":[[0,2,"ぐんしゅう"],[3,1,"かれ"],[10,1,"だま"],[20,1,"かれ"],[27,1,"さけ"],[33,1,"い"],[38,1,"しゅ"],[45,1,"こ"],[59,1,"くだ"]],"text":"群衆は彼らをしかって黙らせようとしたが、彼らはますます叫びつづけて言った、「主よ、ダビデの子よ、わたしたちをあわれんで下さい」。"},{"ref":"Matt.20.32","start":40020032,"end":40020032,"break":"none","ruby":[[4,1,"た"],[10,1,"かれ"],[13,1,"よ"],[16,1,"い"],[26,1,"なに"]],"text":"イエスは立ちどまり、彼らを呼んで言われた、「わたしに何をしてほしいのか」。"},{"ref":"Matt.20.33","start":40020033,"end":40020033,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[8,1,"しゅ"],[11,1,"め"]],"text":"彼らは言った、「主よ、目をあけていただくことです」。"},{"ref":"Matt.20.34","start":40020034,"end":40020034,"break":"none","ruby":[[4,1,"ふか"],[12,1,"かれ"],[15,1,"め"],[26,1,"かれ"],[34,1,"み"],[47,1,"したが"],[50,1,"い"]],"text":"イエスは深くあわれんで、彼らの目にさわられた。すると彼らは、たちまち見えるようになり、イエスに従って行った。"}]