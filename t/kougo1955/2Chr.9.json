[{"ref":"2Chr.9.1","start":14009001,"end":14009001,"break":"paragraph","ruby":[[3,2,"じょおう"],[11,2,"めいせい"],[14,1,"き"],[20,2,"なんもん"],[31,1,"こころ"],[37,2,"ひじょう"],[40,1,"おお"],[43,2,"じゅうしゃ"],[46,1,"つ"],[49,2,"こうりょう"],[52,2,"ひじょう"],[60,1,"きん"],[62,2,"ほうせき"],[70,1,"お"],[89,1,"き"],[94,1,"こころ"],[106,1,"かれ"],[108,1,"つ"]],"text":"シバの女王はソロモンの名声を聞いたので、難問をもってソロモンを試みようと、非常に多くの従者を連れ、香料と非常にたくさんの金と宝石とをらくだに負わせて、エルサレムのソロモンのもとに来て、その心にあることをことごとく彼に告げた。"},{"ref":"2Chr.9.2","start":14009002,"end":14009002,"break":"none","ruby":[[5,2,"かのじょ"],[12,1,"とい"],[14,1,"こた"],[23,1,"し"],[28,2,"かのじょ"],[31,2,"せつめい"]],"text":"ソロモンは彼女のすべての問に答えた。ソロモンが知らないで彼女に説明のできないことは一つもなかった。"},{"ref":"2Chr.9.3","start":14009003,"end":14009003,"break":"none","ruby":[[3,2,"じょおう"],[11,2,"ちえ"],[15,1,"かれ"],[17,1,"た"],[20,1,"いえ"],[22,1,"み"]],"text":"シバの女王はソロモンの知恵と、彼が建てた家を見、"},{"ref":"2Chr.9.4","start":14009004,"end":14009004,"break":"none","ruby":[[4,2,"しょくたく"],[7,2,"しょくもつ"],[11,2,"れつざ"],[14,2,"けらい"],[22,2,"じしん"],[27,2,"しこう"],[29,1,"ふ"],[32,1,"かれ"],[35,2,"ふくそう"],[41,1,"かれ"],[43,2,"きゅうじ"],[50,2,"ふくそう"],[57,1,"かれ"],[59,1,"しゅ"],[61,1,"みや"],[67,2,"はんさい"],[70,1,"み"],[73,1,"まった"],[75,1,"き"],[77,1,"うば"]],"text":"またその食卓の食物と、列座の家来たちと、その侍臣たちの伺候振りと彼らの服装、および彼の給仕たちとその服装、ならびに彼が主の宮でささげる燔祭を見て、全く気を奪われてしまった。"},{"ref":"2Chr.9.5","start":14009005,"end":14009005,"break":"paragraph","ruby":[[0,2,"かのじょ"],[3,1,"おう"],[5,1,"い"],[14,1,"くに"],[20,1,"こと"],[27,2,"ちえ"],[33,1,"き"],[40,2,"しんじつ"]],"text":"彼女は王に言った、「わたしが国であなたの事と、あなたの知恵について聞いたうわさは真実でした。"},{"ref":"2Chr.9.6","start":14009006,"end":14009006,"break":"none","ruby":[[7,1,"き"],[9,1,"め"],[11,1,"み"],[23,1,"しん"],[33,2,"いまみ"],[42,2,"ちえ"],[45,1,"おお"],[54,2,"はんぶん"],[61,1,"し"],[80,1,"き"]],"text":"しかしわたしは来て目に見るまでは、そのうわさを信じませんでしたが、今見ると、あなたの知恵の大いなることはその半分もわたしに知らされませんでした。あなたはわたしの聞いたうわさにまさっています。"},{"ref":"2Chr.9.7","start":14009007,"end":14009007,"break":"none","ruby":[[4,2,"おくがた"],[16,1,"つね"],[22,1,"まえ"],[24,1,"た"],[32,2,"ちえ"],[35,1,"き"],[43,2,"けらい"]],"text":"あなたの奥方たちはさいわいです。常にあなたの前に立って、あなたの知恵を聞くこのあなたの家来たちはさいわいです。"},{"ref":"2Chr.9.8","start":14009008,"end":14009008,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[15,1,"しゅ"],[21,1,"よろこ"],[30,1,"くらい"],[40,1,"かみ"],[42,1,"しゅ"],[47,1,"おう"],[59,1,"かみ"],[67,1,"あい"],[79,1,"かた"],[93,1,"おう"],[98,2,"こうどう"],[101,2,"せいぎ"],[104,1,"おこな"]],"text":"あなたの神、主はほむべきかな。主はあなたを喜び、あなたをその位につかせ、あなたの神、主のために王とされました。あなたの神はイスラエルを愛して、とこしえにこれを堅くするために、あなたをその王とされ、公道と正義を行われるのです」。"},{"ref":"2Chr.9.9","start":14009009,"end":14009009,"break":"none","ruby":[[3,2,"かのじょ"],[6,1,"きん"],[18,2,"ひじょう"],[21,1,"おお"],[24,2,"こうりょう"],[27,2,"ほうせき"],[31,1,"おう"],[33,1,"おく"],[40,2,"じょおう"],[48,1,"おく"],[54,2,"こうりょう"]],"text":"そして彼女は金百二十タラント、および非常に多くの香料と宝石とを王に贈った。シバの女王がソロモンに贈ったような香料は、いまだかつてなかった。"},{"ref":"2Chr.9.10","start":14009010,"end":14009010,"break":"paragraph","ruby":[[5,1,"きん"],[7,1,"たずさ"],[10,1,"き"],[42,1,"き"],[44,2,"ほうせき"],[48,1,"たずさ"],[51,1,"き"]],"text":"オフルから金を携えて来たヒラムのしもべたちとソロモンのしもべたちはまた、びゃくだんの木と宝石をも携えて来た。"},{"ref":"2Chr.9.11","start":14009011,"end":14009011,"break":"none","ruby":[[0,1,"おう"],[10,1,"き"],[13,1,"しゅ"],[15,1,"みや"],[17,1,"おう"],[19,1,"いえ"],[22,2,"かいだん"],[25,1,"つく"],[30,1,"うた"],[34,1,"もの"],[39,1,"こと"],[41,2,"たてごと"],[44,1,"つく"],[62,1,"ち"],[64,1,"み"]],"text":"王はそのびゃくだんの木で、主の宮と王の家とに階段を造り、また歌うたう者のために琴と立琴を造った。このようなものはかつてユダの地で見たことがなかった。"},{"ref":"2Chr.9.12","start":14009012,"end":14009012,"break":"paragraph","ruby":[[4,1,"おう"],[10,2,"じょおう"],[13,1,"おく"],[16,1,"もの"],[18,1,"むく"],[25,2,"かのじょ"],[28,1,"のぞ"],[41,1,"もと"],[47,1,"おく"],[54,2,"かのじょ"],[59,2,"けらい"],[64,1,"とも"],[66,2,"じぶん"],[69,1,"くに"],[71,1,"かえ"],[74,1,"い"]],"text":"ソロモン王は、シバの女王が贈った物に報いたほかに、彼女の望みにまかせて、すべてその求めるものを贈った。そして彼女はその家来たちと共に自分の国へ帰って行った。"},{"ref":"2Chr.9.13","start":14009013,"end":14009013,"break":"paragraph","ruby":[[3,1,"ねん"],[5,1,"あいだ"],[12,1,"ところ"],[18,1,"き"],[20,1,"きん"],[22,2,"めかた"]],"text":"さて一年の間にソロモンの所にはいって来た金の目方は六百六十六タラントであった。"},{"ref":"2Chr.9.14","start":14009014,"end":14009014,"break":"none","ruby":[[5,2,"ぼうえき"],[7,1,"しょう"],[11,2,"しょうにん"],[14,1,"たずさ"],[17,1,"き"],[37,1,"おう"],[43,1,"くに"],[45,2,"だいかん"],[50,2,"きんぎん"],[58,1,"たずさ"]],"text":"このほかに貿易商および商人の携えて来たものがあった。またアラビヤのすべての王たちおよび国の代官たちも金銀をソロモンに携えてきた。"},{"ref":"2Chr.9.15","start":14009015,"end":14009015,"break":"none","ruby":[[4,1,"おう"],[6,2,"のべきん"],[9,2,"おおだて"],[14,1,"つく"],[20,2,"おおだて"],[34,2,"のべきん"],[37,1,"もち"]],"text":"ソロモン王は延金の大盾二百を造った。その大盾にはおのおの六百シケルの延金を用いた。"},{"ref":"2Chr.9.16","start":14009016,"end":14009016,"break":"none","ruby":[[2,2,"のべきん"],[5,2,"こだて"],[10,1,"つく"],[14,2,"こだて"],[28,1,"きん"],[30,1,"もち"],[34,1,"おう"],[45,1,"もり"],[47,1,"いえ"],[49,1,"お"]],"text":"また延金の小盾三百を造った。小盾にはおのおの三百シケルの金を用いた。王はこれらをレバノンの森の家に置いた。"},{"ref":"2Chr.9.17","start":14009017,"end":14009017,"break":"none","ruby":[[0,1,"おう"],[4,1,"おお"],[7,2,"ぞうげ"],[10,2,"ぎょくざ"],[13,1,"つく"],[16,2,"じゅんきん"]],"text":"王はまた大きな象牙の玉座を造り、純金でこれをおおった。"},{"ref":"2Chr.9.18","start":14009018,"end":14009018,"break":"none","ruby":[[2,2,"ぎょくざ"],[9,1,"だん"],[16,1,"きん"],[18,1,"あし"],[19,1,"だい"],[24,1,"とも"],[26,2,"ぎょくざ"],[36,1,"ざ"],[39,1,"ところ"],[41,2,"りょうほう"],[68,1,"た"]],"text":"その玉座には六つの段があり、また金の足台があって共に玉座につらなり、その座する所の両方に、ひじかけがあって、ひじかけのわきに二つのししが立っていた。"},{"ref":"2Chr.9.19","start":14009019,"end":14009019,"break":"none","ruby":[[11,1,"だん"],[18,2,"りょうがわ"],[21,1,"た"],[32,1,"もの"],[37,1,"くに"],[40,1,"つく"]],"text":"また十二のししが六つの段のおのおのの両側に立っていた。このような物はどこの国でも造られたことがなかった。"},{"ref":"2Chr.9.20","start":14009020,"end":14009020,"break":"none","ruby":[[4,1,"おう"],[6,1,"の"],[11,1,"もち"],[14,1,"うつわ"],[18,1,"きん"],[31,1,"もり"],[33,1,"いえ"],[35,1,"うつわ"],[39,2,"じゅんきん"],[46,1,"ぎん"],[53,1,"よ"],[56,1,"たっと"]],"text":"ソロモン王が飲むときに用いた器はみな金であった。またレバノンの森の家の器もみな純金であって、銀はソロモンの世には尊ばれなかった。"},{"ref":"2Chr.9.21","start":14009021,"end":14009021,"break":"none","ruby":[[3,1,"おう"],[5,1,"ふね"],[17,1,"の"],[25,1,"い"],[29,1,"ねん"],[34,1,"ど"],[43,1,"ふね"],[45,1,"きん"],[47,1,"ぎん"],[49,2,"ぞうげ"],[60,1,"の"],[63,1,"き"]],"text":"これは王の船がヒラムのしもべたちを乗せてタルシシへ行き、三年ごとに一度、そのタルシシの船が金、銀、象牙、さる、くじゃくを載せて来たからである。"},{"ref":"2Chr.9.22","start":14009022,"end":14009022,"break":"paragraph","ruby":[[9,1,"おう"],[11,1,"とみ"],[13,2,"ちえ"],[20,1,"ち"],[26,1,"おう"]],"text":"このようにソロモン王は富と知恵において、地のすべての王にまさっていたので、"},{"ref":"2Chr.9.23","start":14009023,"end":14009023,"break":"none","ruby":[[0,1,"ち"],[6,1,"おう"],[8,1,"かみ"],[15,1,"こころ"],[17,1,"さづ"],[22,2,"ちえ"],[25,1,"き"],[36,2,"えっけん"],[39,1,"もと"]],"text":"地のすべての王は神がソロモンの心に授けられた知恵を聞こうとしてソロモンに謁見を求めた。"},{"ref":"2Chr.9.24","start":14009024,"end":14009024,"break":"none","ruby":[[0,2,"ひとびと"],[7,1,"おく"],[9,1,"もの"],[11,1,"たずさ"],[21,1,"ぎん"],[23,1,"うつわ"],[25,1,"きん"],[27,1,"うつわ"],[29,2,"いふく"],[32,2,"もつやく"],[35,2,"こうりょう"],[38,1,"うま"],[40,2,"らば"],[44,2,"ねんねん"],[46,1,"さだ"]],"text":"人々はおのおの贈り物を携えてきた。すなわち銀の器、金の器、衣服、没薬、香料、馬、騾馬など年々定まっていた。"},{"ref":"2Chr.9.25","start":14009025,"end":14009025,"break":"none","ruby":[[5,1,"うま"],[7,2,"せんしゃ"],[13,2,"うまや"],[18,2,"きへい"],[25,1,"も"],[31,2,"せんしゃ"],[34,1,"まち"],[36,1,"お"],[47,1,"おう"],[52,1,"お"]],"text":"ソロモンは馬と戦車のために馬屋四千と騎兵一万二千を持ち、これを戦車の町に置き、またエルサレムの王のもとに置いた。"},{"ref":"2Chr.9.26","start":14009026,"end":14009026,"break":"none","ruby":[[0,1,"かれ"],[6,1,"かわ"],[16,1,"ち"],[24,1,"さかい"],[26,1,"いた"],[35,1,"おう"],[37,1,"おさ"]],"text":"彼はユフラテ川からペリシテびとの地と、エジプトの境に至るまでのすべての王を治めた。"},{"ref":"2Chr.9.27","start":14009027,"end":14009027,"break":"none","ruby":[[0,1,"おう"],[4,1,"ぎん"],[6,1,"いし"],[17,1,"おお"],[21,2,"こうはく"],[24,2,"へいや"],[31,1,"くわ"],[36,1,"おお"]],"text":"王はまた銀を石のようにエルサレムに多くし、香柏を平野のいちじく桑のように多くした。"},{"ref":"2Chr.9.28","start":14009028,"end":14009028,"break":"none","ruby":[[2,2,"ひとびと"],[12,2,"しょこく"],[16,1,"うま"],[26,2,"ゆにゅう"]],"text":"また人々はエジプトおよび諸国から馬をソロモンのために輸入した。"},{"ref":"2Chr.9.29","start":14009029,"end":14009029,"break":"paragraph","ruby":[[10,2,"しじゅう"],[13,2,"こうい"],[17,3,"よげんしゃ"],[24,1,"しょ"],[35,2,"よげん"],[39,3,"せんけんしゃ"],[49,1,"こ"],[59,1,"の"],[62,2,"もくし"]],"text":"ソロモンのそのほかの始終の行為は、預言者ナタンの書と、シロびとアヒヤの預言と、先見者イドがネバテの子ヤラベアムについて述べた黙示のなかに、しるされているではないか。"},{"ref":"2Chr.9.30","start":14009030,"end":14009030,"break":"none","ruby":[[13,1,"ねん"],[15,1,"あいだ"],[22,1,"ぜん"],[23,1,"ち"],[25,1,"おさ"]],"text":"ソロモンはエルサレムで四十年の間イスラエルの全地を治めた。"},{"ref":"2Chr.9.31","start":14009031,"end":14009031,"break":"none","ruby":[[7,2,"せんぞ"],[12,1,"とも"],[14,1,"ねむ"],[18,1,"ちち"],[23,1,"まち"],[25,1,"ほうむ"],[31,1,"こ"],[38,1,"かわ"],[41,1,"おう"]],"text":"ソロモンはその先祖たちと共に眠って、父ダビデの町に葬られ、その子レハベアムが代って王となった。"}]