[{"ref":"Ps.39.1","start":19039001,"end":19039001,"break":"paragraph","title":"聖歌隊の指揮者エドトンによってうたわせたダビデの歌","breaks":[[24,"line"],[33,"line"],[48,"line"]],"ruby":[[4,1,"い"],[9,1,"した"],[14,1,"つみ"],[16,1,"おか"],[28,1,"みち"],[30,1,"つつし"],[33,1,"あ"],[36,1,"もの"],[42,1,"まえ"],[46,1,"あいだ"],[52,1,"くち"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[24,1,"うた"]],"text":"わたしは言った、「舌をもって罪を犯さないために、わたしの道を慎み、悪しき者のわたしの前にある間はわたしの口にくつわをかけよう」と。"},{"ref":"Ps.39.2","start":19039002,"end":19039002,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"もく"],[7,2,"ものい"],[16,2,"ちんもく"],[19,1,"まも"],[31,1,"なや"]],"text":"わたしは黙して物言わず、むなしく沈黙を守った。しかし、わたしの悩みはさらにひどくなり、"},{"ref":"Ps.39.3","start":19039003,"end":19039003,"break":"line","breaks":[[16,"line"],[33,"line"]],"ruby":[[4,1,"こころ"],[13,1,"ねっ"],[16,1,"おも"],[25,1,"ひ"],[27,1,"も"],[37,1,"した"],[42,1,"かた"]],"text":"わたしの心はわたしのうちに熱し、思いつづけるほどに火が燃えたので、わたしは舌をもって語った。"},{"ref":"Ps.39.4","start":19039004,"end":19039004,"break":"line","breaks":[[10,"line"],[33,"line"]],"ruby":[[1,1,"しゅ"],[6,1,"おわ"],[12,1,"ひ"],[14,1,"かず"],[29,1,"し"],[35,1,"いのち"],[46,1,"し"]],"text":"「主よ、わが終りと、わが日の数のどれほどであるかをわたしに知らせ、わが命のいかにはかないかを知らせてください。"},{"ref":"Ps.39.5","start":19039005,"end":19039005,"break":"line","breaks":[[24,"line"],[48,"line"],[67,"line"]],"ruby":[[0,1,"み"],[11,1,"ひ"],[28,2,"いっしょう"],[35,1,"まえ"],[38,1,"む"],[57,1,"ひと"],[61,1,"さか"],[64,1,"とき"],[67,1,"いき"]],"text":"見よ、あなたはわたしの日をつかのまとされました。わたしの一生はあなたの前では無にひとしいのです。まことに、すべての人はその盛んな時でも息にすぎません。〔セラ"},{"ref":"Ps.39.6","start":19039006,"end":19039006,"break":"line","breaks":[[19,"line"],[35,"line"],[44,"line"],[58,"line"]],"ruby":[[4,1,"ひと"],[6,1,"かげ"],[23,1,"かれ"],[30,1,"こと"],[35,1,"さわ"],[44,1,"かれ"],[46,1,"つ"],[64,1,"おさ"],[69,1,"し"]],"text":"まことに人は影のように、さまよいます。まことに彼らはむなしい事のために騒ぎまわるのです。彼は積みたくわえるけれども、だれがそれを収めるかを知りません。"},{"ref":"Ps.39.7","start":19039007,"end":19039007,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"いま"],[8,1,"なに"],[10,1,"ま"],[12,1,"のぞ"],[23,1,"のぞ"]],"text":"主よ、今わたしは何を待ち望みましょう。わたしの望みはあなたにあります。"},{"ref":"Ps.39.8","start":19039008,"end":19039008,"break":"line","breaks":[[17,"line"]],"ruby":[[12,1,"たす"],[14,1,"だ"],[17,1,"おろ"],[20,1,"もの"]],"text":"わたしをすべてのとがから助け出し、愚かな者にわたしをあざけらせないでください。"},{"ref":"Ps.39.9","start":19039009,"end":19039009,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"もく"],[7,1,"くち"],[9,1,"ひら"]],"text":"わたしは黙して口を開きません。あなたがそれをなされたからです。"},{"ref":"Ps.39.10","start":19039010,"end":19039010,"break":"line","breaks":[[10,"line"],[25,"line"],[48,"line"]],"ruby":[[4,1,"くだ"],[8,1,"わざわい"],[15,1,"と"],[17,1,"さ"],[34,1,"て"],[36,1,"う"],[38,1,"こ"],[48,1,"ほろ"]],"text":"あなたが下された災をわたしから取り去ってください。わたしはあなたのみ手に打ち懲らされることにより滅びるばかりです。"},{"ref":"Ps.39.11","start":19039011,"end":19039011,"break":"line","breaks":[[19,"line"],[38,"line"],[49,"line"]],"ruby":[[4,1,"つみ"],[6,1,"せ"],[9,1,"ひと"],[11,1,"こ"],[21,1,"した"],[23,1,"よろこ"],[32,1,"く"],[38,1,"け"],[40,1,"ほろ"],[57,1,"ひと"],[59,1,"いき"]],"text":"あなたは罪を責めて人を懲らされるとき、その慕い喜ぶものを、しみが食うように、消し滅ぼされるのです。まことにすべての人は息にすぎません。〔セラ"},{"ref":"Ps.39.12","start":19039012,"end":19039012,"break":"line","breaks":[[12,"line"],[24,"line"],[44,"line"],[61,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"いのり"],[9,1,"き"],[16,1,"さけ"],[19,1,"みみ"],[21,1,"かたむ"],[28,1,"なみだ"],[30,1,"み"],[52,1,"み"],[54,1,"よ"],[57,1,"たび"],[67,2,"せんぞ"],[75,3,"きりゅうしゃ"]],"text":"主よ、わたしの祈を聞き、わたしの叫びに耳を傾け、わたしの涙を見て、もださないでください。わたしはあなたに身を寄せる旅びと、わがすべての先祖たちのように寄留者です。"},{"ref":"Ps.39.13","start":19039013,"end":19039013,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"さ"],[12,1,"まえ"],[16,1,"かお"],[27,1,"よろこ"]],"text":"わたしが去って、うせない前に、み顔をそむけて、わたしを喜ばせてください」。"}]