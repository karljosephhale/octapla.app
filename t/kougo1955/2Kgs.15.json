[{"ref":"2Kgs.15.1","start":12015001,"end":12015001,"break":"paragraph","ruby":[[6,1,"おう"],[13,1,"だい"],[17,1,"ねん"],[23,1,"おう"],[29,1,"こ"],[35,1,"おう"]],"text":"イスラエルの王ヤラベアムの第二十七年に、ユダの王アマジヤの子アザリヤが王となった。"},{"ref":"2Kgs.15.2","start":12015002,"end":12015002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おう"],[7,1,"とき"],[11,1,"さい"],[17,1,"ねん"],[19,1,"あいだ"],[26,1,"よ"],[28,1,"おさ"],[34,1,"はは"],[42,2,"しゅっしん"],[46,1,"な"]],"text":"彼が王となった時は十六歳で、五十二年の間エルサレムで世を治めた。その母はエルサレムの出身で、名をエコリアといった。"},{"ref":"2Kgs.15.3","start":12015003,"end":12015003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[9,1,"こと"],[11,1,"おこな"],[18,1,"こと"],[20,1,"ちち"],[26,1,"い"]],"text":"彼は主の目にかなう事を行い、すべての事を父アマジヤが行ったようにおこなった。"},{"ref":"2Kgs.15.4","start":12015004,"end":12015004,"break":"none","ruby":[[3,1,"たか"],[5,1,"ところ"],[7,1,"のぞ"],[16,1,"たみ"],[22,1,"たか"],[24,1,"ところ"],[26,2,"ぎせい"],[33,1,"こう"]],"text":"ただし高き所は除かなかったので、民はなおその高き所で犠牲をささげ、香をたいた。"},{"ref":"2Kgs.15.5","start":12015005,"end":12015005,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"おう"],[4,1,"う"],[13,1,"し"],[15,1,"ひ"],[21,2,"びょうにん"],[28,1,"はな"],[30,1,"や"],[32,1,"す"],[36,1,"おう"],[38,1,"こ"],[43,1,"いえ"],[45,1,"こと"],[47,2,"かんり"],[51,1,"くに"],[53,1,"たみ"]],"text":"主が王を撃たれたので、その死ぬ日まで、らい病人となって、離れ家に住んだ。王の子ヨタムが家の事を管理し、国の民をさばいた。"},{"ref":"2Kgs.15.6","start":12015006,"end":12015006,"break":"none","ruby":[[7,1,"た"],[9,2,"じせき"],[13,1,"かれ"],[21,1,"こと"],[27,1,"おう"],[29,3,"れきだいし"],[33,1,"しょ"]],"text":"アザリヤのその他の事績と、彼がしたすべての事は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.15.7","start":12015007,"end":12015007,"break":"none","ruby":[[7,2,"せんぞ"],[12,1,"とも"],[14,1,"ねむ"],[20,1,"かれ"],[26,1,"まち"],[30,2,"せんぞ"],[35,1,"とも"],[37,1,"ほうむ"],[43,1,"こ"],[48,1,"かわ"],[51,1,"おう"]],"text":"アザリヤはその先祖たちと共に眠ったので、彼をダビデの町にその先祖たちと共に葬った。その子ヨタムが代って王となった。"},{"ref":"2Kgs.15.8","start":12015008,"end":12015008,"break":"paragraph","ruby":[[3,1,"おう"],[9,1,"だい"],[13,1,"ねん"],[21,1,"こ"],[38,1,"おう"],[45,1,"げつ"],[46,1,"よ"],[48,1,"おさ"]],"text":"ユダの王アザリヤの第三十八年にヤラベアムの子ゼカリヤがサマリヤでイスラエルの王となり、六か月世を治めた。"},{"ref":"2Kgs.15.9","start":12015009,"end":12015009,"break":"none","ruby":[[0,1,"かれ"],[4,2,"せんぞ"],[17,1,"しゅ"],[19,1,"め"],[21,1,"まえ"],[23,1,"あく"],[25,1,"おこな"],[34,1,"つみ"],[36,1,"おか"],[44,1,"こ"],[51,1,"つみ"],[53,1,"はな"]],"text":"彼はその先祖たちがおこなったように主の目の前に悪を行い、イスラエルに罪を犯させたネバテの子ヤラベアムの罪を離れなかった。"},{"ref":"2Kgs.15.10","start":12015010,"end":12015010,"break":"none","ruby":[[4,1,"こ"],[10,2,"ととう"],[13,1,"むす"],[16,1,"かれ"],[18,1,"てき"],[27,1,"かれ"],[29,1,"う"],[31,1,"ころ"],[34,1,"かれ"],[36,1,"かわ"],[39,1,"おう"]],"text":"ヤベシの子シャルムが徒党を結んで彼に敵し、イブレアムで彼を撃ち殺し、彼に代って王となった。"},{"ref":"2Kgs.15.11","start":12015011,"end":12015011,"break":"none","ruby":[[7,1,"た"],[9,2,"じせき"],[19,1,"おう"],[21,3,"れきだいし"],[25,1,"しょ"]],"text":"ゼカリヤのその他の事績は、イスラエルの王の歴代志の書にしるされている。"},{"ref":"2Kgs.15.12","start":12015012,"end":12015012,"break":"none","ruby":[[0,1,"しゅ"],[15,2,"しそん"],[19,1,"だい"],[28,1,"くらい"],[30,1,"ざ"],[39,1,"つ"]],"text":"主はかつてエヒウに、「あなたの子孫は四代までイスラエルの位に座するであろう」と告げられたが、はたしてそのとおりになった。"},{"ref":"2Kgs.15.13","start":12015013,"end":12015013,"break":"paragraph","ruby":[[4,1,"こ"],[13,1,"おう"],[18,1,"だい"],[22,1,"ねん"],[24,1,"おう"],[36,1,"げつ"],[37,1,"よ"],[39,1,"おさ"]],"text":"ヤベシの子シャルムはユダの王ウジヤの第三十九年に王となり、サマリヤで一か月世を治めた。"},{"ref":"2Kgs.15.14","start":12015014,"end":12015014,"break":"none","ruby":[[0,1,"とき"],[5,1,"こ"],[21,1,"のぼ"],[31,1,"こ"],[42,1,"う"],[44,1,"ころ"],[47,1,"かれ"],[49,1,"かわ"],[52,1,"おう"]],"text":"時にガデの子メナヘムがテルザからサマリヤに上ってきて、ヤベシの子シャルムをサマリヤで撃ち殺し、彼に代って王となった。"},{"ref":"2Kgs.15.15","start":12015015,"end":12015015,"break":"none","ruby":[[7,1,"た"],[9,2,"じせき"],[13,1,"かれ"],[15,2,"ととう"],[18,1,"むす"],[21,1,"こと"],[30,1,"おう"],[32,3,"れきだいし"],[36,1,"しょ"]],"text":"シャルムのその他の事績と、彼が徒党を結んだ事は、イスラエルの王の歴代志の書にしるされている。"},{"ref":"2Kgs.15.16","start":12015016,"end":12015016,"break":"none","ruby":[[2,1,"とき"],[13,1,"すす"],[37,1,"もの"],[44,2,"りょういき"],[47,1,"う"],[55,1,"かれ"],[58,1,"かれ"],[63,1,"ひら"],[75,1,"う"],[84,2,"にんしん"],[87,1,"おんな"],[94,1,"ひ"],[96,1,"さ"]],"text":"その時メナヘムはテルザから進んでいって、タップアと、そのうちにいるすべての者、およびその領域を撃った。すなわち彼らが彼のために開かなかったので、これを撃って、そのうちの妊娠の女をことごとく引き裂いた。"},{"ref":"2Kgs.15.17","start":12015017,"end":12015017,"break":"paragraph","ruby":[[3,1,"おう"],[9,1,"だい"],[13,1,"ねん"],[19,1,"こ"],[31,1,"おう"],[42,1,"ねん"],[44,1,"あいだ"],[46,1,"よ"],[48,1,"おさ"]],"text":"ユダの王アザリヤの第三十九年に、ガデの子メナヘムはイスラエルの王となり、サマリヤで十年の間、世を治めた。"},{"ref":"2Kgs.15.18","start":12015018,"end":12015018,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[10,1,"おこな"],[19,1,"つみ"],[21,1,"おか"],[29,1,"こ"],[36,1,"つみ"],[38,2,"いっしょう"],[41,1,"あいだ"],[43,1,"はな"]],"text":"彼は主の目の前に悪を行い、イスラエルに罪を犯させたネバテの子ヤラベアムの罪を一生の間、離れなかった。"},{"ref":"2Kgs.15.19","start":12015019,"end":12015019,"break":"none","ruby":[[0,1,"とき"],[8,1,"おう"],[12,1,"くに"],[14,1,"せ"],[27,1,"ぎん"],[38,1,"あた"],[45,1,"かれ"],[50,1,"たす"],[53,1,"え"],[56,1,"くに"],[58,2,"じぶん"],[61,1,"て"],[66,1,"つよ"]],"text":"時にアッスリヤの王プルが国に攻めてきたので、メナヘムは銀一千タラントをプルに与えた。これは彼がプルの助けを得て、国を自分の手のうちに強くするためであった。"},{"ref":"2Kgs.15.20","start":12015020,"end":12015020,"break":"none","ruby":[[11,1,"ぎん"],[23,1,"と"],[26,1,"もの"],[28,1,"か"],[33,2,"ひとびと"],[40,1,"ぎん"],[47,1,"だ"],[57,1,"おう"],[59,1,"あた"],[73,1,"おう"],[75,1,"くに"],[84,1,"かえ"]],"text":"すなわちメナヘムはその銀をイスラエルのすべての富める者に課し、その人々におのおの銀五十シケルを出させてアッスリヤの王に与えた。こうしてアッスリヤの王は国にとどまらないで帰っていった。"},{"ref":"2Kgs.15.21","start":12015021,"end":12015021,"break":"none","ruby":[[7,1,"た"],[9,2,"じせき"],[12,1,"かれ"],[20,1,"こと"],[29,1,"おう"],[31,3,"れきだいし"],[35,1,"しょ"]],"text":"メナヘムのその他の事績と彼がしたすべての事は、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.15.22","start":12015022,"end":12015022,"break":"none","ruby":[[5,2,"せんぞ"],[10,1,"とも"],[12,1,"ねむ"],[17,1,"こ"],[23,1,"かわ"],[26,1,"おう"]],"text":"メナヘムは先祖たちと共に眠り、その子ペカヒヤが代って王となった。"},{"ref":"2Kgs.15.23","start":12015023,"end":12015023,"break":"paragraph","ruby":[[5,1,"こ"],[14,1,"おう"],[20,1,"だい"],[23,1,"ねん"],[37,1,"おう"],[43,1,"ねん"],[45,1,"あいだ"],[47,1,"よ"],[49,1,"おさ"]],"text":"メナヘムの子ペカヒヤはユダの王アザリヤの第五十年に、サマリヤでイスラエルの王となり、二年の間、世を治めた。"},{"ref":"2Kgs.15.24","start":12015024,"end":12015024,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[10,1,"おこな"],[19,1,"つみ"],[21,1,"おか"],[28,1,"こ"],[35,1,"つみ"],[37,1,"はな"]],"text":"彼は主の目の前に悪を行い、イスラエルに罪を犯せたネバテの子ヤラベアムの罪を離れなかった。"},{"ref":"2Kgs.15.25","start":12015025,"end":12015025,"break":"none","ruby":[[0,1,"とき"],[2,1,"かれ"],[4,2,"ふくかん"],[27,1,"にん"],[29,1,"とも"],[31,2,"ととう"],[34,1,"むす"],[37,1,"かれ"],[39,1,"てき"],[48,1,"おう"],[50,2,"きゅうでん"],[53,2,"てんしゅ"],[56,1,"かれ"],[58,1,"う"],[60,1,"ころ"],[71,1,"かれ"],[73,1,"ころ"],[76,1,"かれ"],[78,1,"かわ"],[81,1,"おう"]],"text":"時に彼の副官であったレマリヤのペカが、ギレアデびと五十人と共に徒党を結んで彼に敵し、サマリヤの、王の宮殿の天守で彼を撃ち殺した。すなわちペカは彼を殺し、彼に代って王となった。"},{"ref":"2Kgs.15.26","start":12015026,"end":12015026,"break":"none","ruby":[[7,1,"た"],[9,2,"じせき"],[12,1,"かれ"],[20,1,"こと"],[29,1,"おう"],[31,3,"れきだいし"],[35,1,"しょ"]],"text":"ペカヒヤのその他の事績と彼がしたすべての事は、イスラエルの王の歴代志の書にしるされている。"},{"ref":"2Kgs.15.27","start":12015027,"end":12015027,"break":"paragraph","ruby":[[5,1,"こ"],[12,1,"おう"],[18,1,"だい"],[22,1,"ねん"],[36,1,"おう"],[43,1,"ねん"],[45,1,"あいだ"],[47,1,"よ"],[49,1,"おさ"]],"text":"レマリヤの子ペカはユダの王アザリヤの第五十二年に、サマリヤでイスラエルの王となり、二十年の間、世を治めた。"},{"ref":"2Kgs.15.28","start":12015028,"end":12015028,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[21,1,"つみ"],[23,1,"おか"],[31,1,"こ"],[38,1,"つみ"],[40,1,"はな"]],"text":"彼は主の目の前に悪をおこない、イスラエルに罪を犯させたネバテの子ヤラベアムの罪を離れなかった。"},{"ref":"2Kgs.15.29","start":12015029,"end":12015029,"break":"paragraph","ruby":[[6,1,"おう"],[10,1,"よ"],[19,1,"おう"],[29,1,"き"],[73,1,"ぜん"],[74,1,"ち"],[76,1,"と"],[79,2,"ひとびと"],[88,1,"とら"],[90,1,"うつ"]],"text":"イスラエルの王ペカの世に、アッスリヤの王テグラテピレセルが来て、イヨン、アベル・ベテマアカ、ヤノア、ケデシ、ハゾル、ギレアデ、ガリラヤ、ナフタリの全地を取り、人々をアッスリヤへ捕え移した。"},{"ref":"2Kgs.15.30","start":12015030,"end":12015030,"break":"none","ruby":[[0,1,"とき"],[5,1,"こ"],[10,2,"ととう"],[13,1,"むす"],[22,1,"こ"],[26,1,"てき"],[29,1,"かれ"],[31,1,"う"],[33,1,"ころ"],[36,1,"かれ"],[38,1,"かわ"],[41,1,"おう"],[54,1,"こ"],[59,1,"だい"],[62,1,"ねん"]],"text":"時にエラの子ホセアは徒党を結んで、レマリヤの子ペカに敵し、彼を撃ち殺し、彼に代って王となった。これはウジヤの子ヨタムの第二十年であった。"},{"ref":"2Kgs.15.31","start":12015031,"end":12015031,"break":"none","ruby":[[5,1,"た"],[7,2,"じせき"],[10,1,"かれ"],[18,1,"こと"],[27,1,"おう"],[29,3,"れきだいし"],[33,1,"しょ"]],"text":"ペカのその他の事績と彼がしたすべての事は、イスラエルの王の歴代志の書にしるされている。"},{"ref":"2Kgs.15.32","start":12015032,"end":12015032,"break":"paragraph","ruby":[[5,1,"こ"],[12,1,"おう"],[16,1,"だい"],[18,1,"ねん"],[24,1,"おう"],[29,1,"こ"],[34,1,"おう"]],"text":"レマリヤの子イスラエルの王ペカの第二年に、ユダの王ウジヤの子ヨタムが王となった。"},{"ref":"2Kgs.15.33","start":12015033,"end":12015033,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おう"],[7,1,"とき"],[11,1,"さい"],[26,1,"ねん"],[28,1,"あいだ"],[30,1,"よ"],[32,1,"おさ"],[36,1,"はは"],[42,1,"むすめ"],[45,1,"な"]],"text":"彼は王となった時二十五歳であったが、エルサレムで十六年の間、世を治めた。母はザドクの娘で、名をエルシャといった。"},{"ref":"2Kgs.15.34","start":12015034,"end":12015034,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[9,1,"こと"],[11,1,"おこな"],[17,1,"ちち"],[22,1,"い"]],"text":"彼は主の目にかなう事を行い、すべて父ウジヤの行ったようにおこなった。"},{"ref":"2Kgs.15.35","start":12015035,"end":12015035,"break":"none","ruby":[[3,1,"たか"],[5,1,"ところ"],[7,1,"のぞ"],[16,1,"たみ"],[22,1,"たか"],[24,1,"ところ"],[26,2,"ぎせい"],[33,1,"こう"],[39,1,"かれ"],[41,1,"しゅ"],[43,1,"みや"],[45,1,"うえ"],[47,1,"もん"],[49,1,"た"]],"text":"ただし高き所は除かなかったので、民はなおその高き所で犠牲をささげ、香をたいた。彼は主の宮の上の門を建てた。"},{"ref":"2Kgs.15.36","start":12015036,"end":12015036,"break":"none","ruby":[[6,1,"た"],[8,2,"じせき"],[11,1,"かれ"],[19,1,"こと"],[25,1,"おう"],[27,3,"れきだいし"],[31,1,"しょ"]],"text":"ヨタムのその他の事績と彼がしたすべての事は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.15.37","start":12015037,"end":12015037,"break":"none","ruby":[[5,1,"しゅ"],[11,1,"おう"],[21,1,"こ"],[28,1,"せ"]],"text":"そのころ、主はスリヤの王レヂンとレマリヤの子ペカをユダに攻めこさせられた。"},{"ref":"2Kgs.15.38","start":12015038,"end":12015038,"break":"none","ruby":[[4,2,"せんぞ"],[9,1,"とも"],[11,1,"ねむ"],[17,2,"せんぞ"],[23,1,"まち"],[25,2,"せんぞ"],[30,1,"とも"],[32,1,"ほうむ"],[38,1,"こ"],[43,1,"かわ"],[46,1,"おう"]],"text":"ヨタムは先祖たちと共に眠って、その先祖ダビデの町に先祖たちと共に葬られ、その子アハズが代って王となった。"}]