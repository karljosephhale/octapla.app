[{"ref":"Acts.10.1","start":44010001,"end":44010001,"break":"paragraph","ruby":[[17,1,"な"],[19,1,"ひと"],[28,1,"たい"],[30,1,"よ"],[34,2,"ぶたい"],[37,3,"ひゃくそつちょう"]],"text":"さて、カイザリヤにコルネリオという名の人がいた。イタリヤ隊と呼ばれた部隊の百卒長で、"},{"ref":"Acts.10.2","start":44010002,"end":44010002,"break":"none","ruby":[[0,2,"しんじん"],[2,1,"ぶか"],[5,2,"かぞく"],[7,2,"いちどう"],[10,1,"とも"],[12,1,"かみ"],[14,1,"うやま"],[17,1,"たみ"],[19,2,"かずかず"],[22,1,"ほどこ"],[28,1,"た"],[31,1,"かみ"],[33,1,"いのり"]],"text":"信心深く、家族一同と共に神を敬い、民に数々の施しをなし、絶えず神に祈をしていた。"},{"ref":"Acts.10.3","start":44010003,"end":44010003,"break":"none","ruby":[[2,1,"ひ"],[4,2,"ごご"],[7,1,"じ"],[11,1,"かみ"],[13,1,"つかい"],[15,1,"かれ"],[33,1,"よ"],[38,1,"まぼろし"],[44,1,"み"]],"text":"ある日の午後三時ごろ、神の使が彼のところにきて、「コルネリオよ」と呼ぶのを、幻ではっきり見た。"},{"ref":"Acts.10.4","start":44010004,"end":44010004,"break":"none","ruby":[[0,1,"かれ"],[2,2,"みつかい"],[5,1,"み"],[13,1,"おそ"],[22,1,"しゅ"],[36,1,"い"],[43,2,"みつかい"],[46,1,"い"],[55,1,"いのり"],[57,1,"ほどこ"],[60,1,"かみ"],[63,1,"まえ"]],"text":"彼は御使を見つめていたが、恐ろしくなって、「主よ、なんでございますか」と言った。すると御使が言った、「あなたの祈や施しは神のみ前にとどいて、おぼえられている。"},{"ref":"Acts.10.5","start":44010005,"end":44010005,"break":"none","ruby":[[4,1,"いま"],[10,1,"ひと"],[20,1,"よ"],[30,1,"ひと"],[32,1,"まね"]],"text":"ついては今、ヨッパに人をやって、ペテロと呼ばれるシモンという人を招きなさい。"},{"ref":"Acts.10.6","start":44010006,"end":44010006,"break":"none","ruby":[[2,1,"ひと"],[5,1,"うみ"],[8,1,"いえ"],[12,1,"かわ"],[22,1,"もの"],[24,1,"きゃく"]],"text":"この人は、海べに家をもつ皮なめしシモンという者の客となっている」。"},{"ref":"Acts.10.7","start":44010007,"end":44010007,"break":"none","ruby":[[3,1,"つ"],[8,2,"みつかい"],[11,1,"た"],[13,1,"さ"],[26,1,"しもべ"],[32,2,"ぶか"],[35,1,"なか"],[37,2,"しんじん"],[39,1,"ぶか"],[41,2,"へいそつ"],[48,1,"よ"]],"text":"このお告げをした御使が立ち去ったのち、コルネリオは、僕ふたりと、部下の中で信心深い兵卒ひとりとを呼び、"},{"ref":"Acts.10.8","start":44010008,"end":44010008,"break":"none","ruby":[[5,1,"こと"],[7,2,"せつめい"],[11,1,"き"],[19,1,"おく"],[21,1,"だ"]],"text":"いっさいの事を説明して聞かせ、ヨッパへ送り出した。"},{"ref":"Acts.10.9","start":44010009,"end":44010009,"break":"paragraph","ruby":[[0,2,"よくじつ"],[6,1,"にん"],[8,1,"たび"],[14,1,"まち"],[16,1,"ちか"],[28,1,"いのり"],[34,2,"おくじょう"],[42,1,"とき"],[44,1,"ひる"],[48,1,"じ"]],"text":"翌日、この三人が旅をつづけて町の近くにきたころ、ペテロは祈をするため屋上にのぼった。時は昼の十二時ごろであった。"},{"ref":"Acts.10.10","start":44010010,"end":44010010,"break":"none","ruby":[[0,1,"かれ"],[2,2,"くうふく"],[10,1,"なに"],[12,1,"た"],[17,1,"おも"],[25,2,"ひとびと"],[28,2,"しょくじ"],[31,2,"ようい"],[38,1,"あいだ"],[41,3,"ゆめごこち"]],"text":"彼は空腹をおぼえて、何か食べたいと思った。そして、人々が食事の用意をしている間に、夢心地になった。"},{"ref":"Acts.10.11","start":44010011,"end":44010011,"break":"none","ruby":[[4,1,"てん"],[6,1,"ひら"],[9,1,"おお"],[12,1,"ぬの"],[17,1,"い"],[19,1,"もの"],[22,1,"よ"],[32,2,"ちじょう"],[35,1,"お"],[38,1,"く"],[42,1,"み"]],"text":"すると、天が開け、大きな布のような入れ物が、四すみをつるされて、地上に降りて来るのを見た。"},{"ref":"Acts.10.12","start":44010012,"end":44010012,"break":"none","ruby":[[2,1,"なか"],[6,2,"ちじょう"],[11,1,"あし"],[13,1,"は"],[20,1,"そら"],[22,1,"とり"],[26,2,"かくしゅ"],[29,1,"い"]],"text":"その中には、地上の四つ足や這うもの、また空の鳥など、各種の生きものがはいっていた。"},{"ref":"Acts.10.13","start":44010013,"end":44010013,"break":"none","ruby":[[3,1,"こえ"],[5,1,"かれ"],[7,1,"きこ"],[19,1,"た"],[31,1,"た"]],"text":"そして声が彼に聞えてきた、「ペテロよ。立って、それらをほふって食べなさい」。"},{"ref":"Acts.10.14","start":44010014,"end":44010014,"break":"none","ruby":[[4,1,"い"],[9,1,"しゅ"],[25,1,"いま"],[30,1,"きよ"],[37,1,"けが"],[44,2,"なにひと"],[47,1,"た"]],"text":"ペテロは言った、「主よ、それはできません。わたしは今までに、清くないもの、汚れたものは、何一つ食べたことがありません」。"},{"ref":"Acts.10.15","start":44010015,"end":44010015,"break":"none","ruby":[[4,1,"こえ"],[7,2,"どめ"],[18,1,"かみ"],[28,1,"きよ"],[35,1,"い"]],"text":"すると、声が二度目にかかってきた、「神がきよめたものを、清くないなどと言ってはならない」。"},{"ref":"Acts.10.16","start":44010016,"end":44010016,"break":"none","ruby":[[7,1,"ど"],[17,1,"い"],[19,1,"もの"],[23,1,"てん"],[25,1,"ひ"],[27,1,"あ"]],"text":"こんなことが三度もあってから、その入れ物はすぐ天に引き上げられた。"},{"ref":"Acts.10.17","start":44010017,"end":44010017,"break":"paragraph","ruby":[[7,1,"み"],[9,1,"まぼろし"],[14,1,"こと"],[24,2,"しあん"],[40,1,"とき"],[49,1,"おく"],[53,1,"ひと"],[62,1,"いえ"],[64,1,"たず"],[66,1,"あ"],[72,2,"かどぐち"],[75,1,"た"]],"text":"ペテロが、いま見た幻はなんの事だろうかと、ひとり思案にくれていると、ちょうどその時、コルネリオから送られた人たちが、シモンの家を尋ね当てて、その門口に立っていた。"},{"ref":"Acts.10.18","start":44010018,"end":44010018,"break":"none","ruby":[[3,1,"こえ"],[14,1,"よ"],[33,1,"と"],[47,1,"たず"]],"text":"そして声をかけて、「ペテロと呼ばれるシモンというかたが、こちらにお泊まりではございませんか」と尋ねた。"},{"ref":"Acts.10.19","start":44010019,"end":44010019,"break":"none","ruby":[[7,1,"まぼろし"],[13,1,"おも"],[24,2,"みたま"],[27,1,"い"],[40,1,"にん"],[42,1,"ひと"],[51,1,"たず"]],"text":"ペテロはなおも幻について、思いめぐらしていると、御霊が言った、「ごらんなさい、三人の人たちが、あなたを尋ねてきている。"},{"ref":"Acts.10.20","start":44010020,"end":44010020,"break":"none","ruby":[[3,1,"た"],[6,1,"した"],[8,1,"お"],[19,1,"かれ"],[22,2,"いっしょ"],[25,1,"で"],[37,1,"かれ"]],"text":"さあ、立って下に降り、ためらわないで、彼らと一緒に出かけるがよい。わたしが彼らをよこしたのである」。"},{"ref":"Acts.10.21","start":44010021,"end":44010021,"break":"none","ruby":[[10,1,"ひと"],[18,1,"お"],[21,1,"い"],[24,1,"い"],[34,1,"たず"],[47,1,"よう"]],"text":"そこでペテロは、その人たちのところに降りて行って言った、「わたしがお尋ねのペテロです。どんなご用でおいでになったのですか」。"},{"ref":"Acts.10.22","start":44010022,"end":44010022,"break":"none","ruby":[[0,1,"かれ"],[3,1,"こた"],[8,1,"ただ"],[11,1,"ひと"],[14,1,"かみ"],[16,1,"うやま"],[23,3,"ぜんこくみん"],[27,2,"こうかん"],[30,1,"も"],[36,3,"ひゃくそつちょう"],[50,1,"いえ"],[52,1,"まね"],[56,1,"はなし"],[58,1,"うかが"],[66,1,"つ"],[70,1,"せい"],[73,2,"みつかい"],[77,1,"う"],[85,1,"まい"]],"text":"彼らは答えた、「正しい人で、神を敬い、ユダヤの全国民に好感を持たれている百卒長コルネリオが、あなたを家に招いてお話を伺うようにとのお告げを、聖なる御使から受けましたので、参りました」。"},{"ref":"Acts.10.23","start":44010023,"end":44010023,"break":"none","breaks":[[21,"paragraph"]],"ruby":[[9,1,"かれ"],[12,1,"むか"],[15,1,"と"],[21,2,"よくじつ"],[28,1,"た"],[32,1,"かれ"],[35,1,"つ"],[40,1,"で"],[41,1,"はっ"],[49,2,"きょうだい"],[53,2,"すうにん"],[56,2,"いっしょ"],[59,1,"い"]],"text":"そこで、ペテロは、彼らを迎えて泊まらせた。翌日、ペテロは立って、彼らと連れだって出発した。ヨッパの兄弟たち数人も一緒に行った。"},{"ref":"Acts.10.24","start":44010024,"end":44010024,"break":"none","ruby":[[2,1,"つぎ"],[4,1,"ひ"],[7,2,"いっこう"],[16,1,"つ"],[26,2,"しんぞく"],[29,1,"した"],[32,2,"ゆうじん"],[37,1,"よ"],[39,1,"あつ"],[43,1,"ま"]],"text":"その次の日に、一行はカイザリヤに着いた。コルネリオは親族や親しい友人たちを呼び集めて、待っていた。"},{"ref":"Acts.10.25","start":44010025,"end":44010025,"break":"none","ruby":[[8,2,"とうちゃく"],[20,2,"でむか"],[25,1,"かれ"],[27,1,"あし"],[33,1,"ふ"],[36,1,"はい"]],"text":"ペテロがいよいよ到着すると、コルネリオは出迎えて、彼の足もとにひれ伏して拝した。"},{"ref":"Acts.10.26","start":44010026,"end":44010026,"break":"none","ruby":[[8,1,"かれ"],[10,1,"ひ"],[12,1,"おこ"],[15,1,"い"],[21,1,"た"],[31,1,"おな"],[33,2,"にんげん"]],"text":"するとペテロは、彼を引き起して言った、「お立ちなさい。わたしも同じ人間です」。"},{"ref":"Acts.10.27","start":44010027,"end":44010027,"break":"none","ruby":[[4,1,"とも"],[6,1,"はな"],[19,1,"い"],[31,1,"おお"],[35,1,"ひと"],[37,1,"あつ"]],"text":"それから共に話しながら、へやにはいって行くと、そこには、すでに大ぜいの人が集まっていた。"},{"ref":"Acts.10.28","start":44010028,"end":44010028,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[18,1,"し"],[30,1,"じん"],[32,2,"たこく"],[35,1,"ひと"],[37,2,"こうさい"],[43,2,"でい"],[55,1,"きん"],[69,1,"かみ"],[75,2,"にんげん"],[79,1,"きよ"],[86,1,"けが"],[93,1,"い"],[108,1,"しめ"]],"text":"ペテロは彼らに言った、「あなたがたが知っているとおり、ユダヤ人が他国の人と交際したり、出入りしたりすることは、禁じられています。ところが、神は、どんな人間をも清くないとか、汚れているとか言ってはならないと、わたしにお示しになりました。"},{"ref":"Acts.10.29","start":44010029,"end":44010029,"break":"none","ruby":[[1,1,"まね"],[9,1,"とき"],[11,1,"すこ"],[20,1,"まい"],[38,1,"うかが"],[56,1,"まね"]],"text":"お招きにあずかった時、少しもためらわずに参ったのは、そのためなのです。そこで伺いますが、どういうわけで、わたしを招いてくださったのですか」。"},{"ref":"Acts.10.30","start":44010030,"end":44010030,"break":"none","ruby":[[3,1,"たい"],[12,1,"こた"],[18,1,"か"],[19,1,"まえ"],[27,2,"じこく"],[35,2,"じたく"],[38,2,"ごご"],[41,1,"じ"],[43,1,"いのり"],[52,2,"とつぜん"],[55,1,"かがや"],[58,1,"ころも"],[60,1,"き"],[62,1,"ひと"],[65,1,"まえ"],[67,1,"た"],[70,1,"もう"]],"text":"これに対してコルネリオが答えた、「四日前、ちょうどこの時刻に、わたしが自宅で午後三時の祈をしていますと、突然、輝いた衣を着た人が、前に立って申しました、"},{"ref":"Acts.10.31","start":44010031,"end":44010031,"break":"none","ruby":[[12,1,"いのり"],[14,1,"き"],[25,1,"ほどこ"],[28,1,"かみ"],[31,1,"まえ"]],"text":"『コルネリオよ、あなたの祈は聞きいれられ、あなたの施しは神のみ前におぼえられている。"},{"ref":"Acts.10.32","start":44010032,"end":44010032,"break":"none","ruby":[[7,1,"ひと"],[9,1,"おく"],[16,1,"よ"],[24,1,"まね"],[32,1,"ひと"],[34,1,"かわ"],[42,2,"うみぞ"],[46,1,"いえ"],[48,1,"と"]],"text":"そこでヨッパに人を送ってペテロと呼ばれるシモンを招きなさい。その人は皮なめしシモンの海沿いの家に泊まっている』。"},{"ref":"Acts.10.33","start":44010033,"end":44010033,"break":"none","ruby":[[4,2,"さっそく"],[11,1,"よ"],[26,1,"くだ"],[33,1,"いま"],[41,1,"しゅ"],[48,1,"つ"],[57,1,"のこ"],[60,1,"うかが"],[69,1,"かみ"],[72,1,"まえ"],[77,1,"で"]],"text":"それで、早速あなたをお呼びしたのです。ようこそおいで下さいました。今わたしたちは、主があなたにお告げになったことを残らず伺おうとして、みな神のみ前にまかり出ているのです」。"},{"ref":"Acts.10.34","start":44010034,"end":44010034,"break":"paragraph","ruby":[[7,1,"くち"],[9,1,"ひら"],[12,1,"い"],[17,1,"かみ"],[19,1,"ひと"]],"text":"そこでペテロは口を開いて言った、「神は人をかたよりみないかたで、"},{"ref":"Acts.10.35","start":44010035,"end":44010035,"break":"none","ruby":[[0,1,"かみ"],[2,1,"うやま"],[4,1,"ぎ"],[6,1,"おこな"],[8,1,"もの"],[12,2,"こくみん"],[16,1,"う"],[21,1,"くだ"]],"text":"神を敬い義を行う者はどの国民でも受けいれて下さることが、ほんとうによくわかってきました。"},{"ref":"Acts.10.36","start":44010036,"end":44010036,"break":"none","ruby":[[7,1,"かみ"],[13,1,"もの"],[15,1,"しゅ"],[30,2,"へいわ"],[33,2,"ふくいん"],[36,1,"の"],[38,1,"つた"],[48,1,"こ"],[52,1,"おく"],[54,1,"くだ"],[58,2,"みことば"],[62,1,"ぞん"]],"text":"あなたがたは、神がすべての者の主なるイエス・キリストによって平和の福音を宣べ伝えて、イスラエルの子らにお送り下さった御言をご存じでしょう。"},{"ref":"Acts.10.37","start":44010037,"end":44010037,"break":"none","ruby":[[14,1,"と"],[17,1,"のち"],[25,1,"はじ"],[32,2,"ぜんど"],[40,2,"ふくいん"],[43,1,"の"]],"text":"それは、ヨハネがバプテスマを説いた後、ガリラヤから始まってユダヤ全土にひろまった福音を述べたものです。"},{"ref":"Acts.10.38","start":44010038,"end":44010038,"break":"none","ruby":[[0,1,"かみ"],[10,2,"せいれい"],[13,1,"ちから"],[16,1,"そそ"],[30,1,"かみ"],[32,1,"とも"],[43,1,"はたら"],[53,2,"あくま"],[56,1,"おさ"],[65,2,"ひとびと"],[80,2,"じゅんかい"]],"text":"神はナザレのイエスに聖霊と力とを注がれました。このイエスは、神が共におられるので、よい働きをしながら、また悪魔に押えつけられている人々をことごとくいやしながら、巡回されました。"},{"ref":"Acts.10.39","start":44010039,"end":44010039,"break":"none","ruby":[[18,1,"じん"],[20,1,"ち"],[39,2,"しょうにん"],[47,2,"ひとびと"],[56,1,"き"],[61,1,"ころ"]],"text":"わたしたちは、イエスがこうしてユダヤ人の地やエルサレムでなさったすべてのことの証人であります。人々はこのイエスを木にかけて殺したのです。"},{"ref":"Acts.10.40","start":44010040,"end":44010040,"break":"none","ruby":[[3,1,"かみ"],[10,1,"か"],[11,1,"め"]],"text":"しかし神はイエスを三日目によみがえらせ、"},{"ref":"Acts.10.41","start":44010041,"end":44010041,"break":"none","ruby":[[0,2,"ぜんぶ"],[3,2,"ひとびと"],[19,2,"しょうにん"],[29,1,"えら"],[33,1,"もの"],[37,1,"あらわ"],[45,1,"くだ"],[63,2,"しにん"],[66,1,"なか"],[69,2,"ふっかつ"],[74,1,"のち"],[76,1,"とも"],[78,2,"いんしょく"]],"text":"全部の人々にではなかったが、わたしたち証人としてあらかじめ選ばれた者たちに現れるようにして下さいました。わたしたちは、イエスが死人の中から復活された後、共に飲食しました。"},{"ref":"Acts.10.42","start":44010042,"end":44010042,"break":"none","ruby":[[9,2,"じしん"],[12,2,"せいじゃ"],[15,2,"ししゃ"],[19,3,"しんぱんしゃ"],[25,1,"かみ"],[27,1,"さだ"],[41,2,"ひとびと"],[44,1,"の"],[46,1,"つた"],[61,1,"かみ"],[70,1,"めい"]],"text":"それから、イエスご自身が生者と死者との審判者として神に定められたかたであることを、人々に宣べ伝え、またあかしするようにと、神はわたしたちにお命じになったのです。"},{"ref":"Acts.10.43","start":44010043,"end":44010043,"break":"none","ruby":[[0,3,"よげんしゃ"],[13,1,"しん"],[16,1,"もの"],[26,1,"な"],[31,1,"つみ"],[37,1,"う"]],"text":"預言者たちもみな、イエスを信じる者はことごとく、その名によって罪のゆるしが受けられると、あかしをしています」。"},{"ref":"Acts.10.44","start":44010044,"end":44010044,"break":"paragraph","ruby":[[8,2,"ことば"],[13,1,"かた"],[15,1,"お"],[26,1,"き"],[35,1,"ひと"],[40,2,"せいれい"]],"text":"ペテロがこれらの言葉をまだ語り終えないうちに、それを聞いていたみんなの人たちに、聖霊がくだった。"},{"ref":"Acts.10.45","start":44010045,"end":44010045,"break":"none","ruby":[[0,2,"かつれい"],[3,1,"う"],[8,2,"しんじゃ"],[21,1,"ひと"],[26,3,"いほうじん"],[33,2,"せいれい"],[36,2,"たまもの"],[39,1,"そそ"],[45,1,"み"],[48,1,"おどろ"]],"text":"割礼を受けている信者で、ペテロについてきた人たちは、異邦人たちにも聖霊の賜物が注がれたのを見て、驚いた。"},{"ref":"Acts.10.46","start":44010046,"end":44010046,"break":"none","ruby":[[4,1,"かれ"],[7,2,"いげん"],[10,1,"かた"],[13,1,"かみ"],[24,1,"き"],[41,1,"い"],[43,1,"だ"]],"text":"それは、彼らが異言を語って神をさんびしているのを聞いたからである。そこで、ペテロが言い出した、"},{"ref":"Acts.10.47","start":44010047,"end":44010047,"break":"none","ruby":[[3,1,"ひと"],[13,1,"おな"],[18,2,"せいれい"],[21,1,"う"],[29,1,"かれ"],[32,1,"みず"],[40,1,"さづ"],[52,1,"え"]],"text":"「この人たちがわたしたちと同じように聖霊を受けたからには、彼らに水でバプテスマを授けるのを、だれがこばみ得ようか」。"},{"ref":"Acts.10.48","start":44010048,"end":44010048,"break":"none","ruby":[[2,1,"い"],[12,2,"ひとびと"],[15,1,"めい"],[28,1,"な"],[39,1,"う"],[50,1,"かれ"],[57,1,"ねが"],[63,2,"すうじつ"],[69,2,"たいざい"]],"text":"こう言って、ペテロはその人々に命じて、イエス・キリストの名によってバプテスマを受けさせた。それから、彼らはペテロに願って、なお数日のあいだ滞在してもらった。"}]