[{"ref":"Isa.28.1","start":23028001,"end":23028001,"break":"paragraph","breaks":[[16,"line"],[35,"line"]],"ruby":[[6,1,"よ"],[11,1,"ほこ"],[13,1,"かんむり"],[16,1,"さけ"],[22,1,"もの"],[24,1,"こ"],[27,1,"たに"],[40,1,"はな"],[42,1,"うつく"],[45,1,"かざ"]],"text":"エフライムの酔いどれの誇る冠と、酒におぼれた者の肥えた谷のかしらにあるしぼみゆく花の美しい飾りは、わざわいだ。"},{"ref":"Isa.28.2","start":23028002,"end":23028002,"break":"line","breaks":[[24,"line"],[42,"line"],[57,"line"],[74,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[9,1,"ちから"],[12,1,"つよ"],[14,1,"もの"],[16,1,"も"],[35,2,"ぼうふう"],[42,1,"やぶ"],[49,3,"ぼうふうう"],[57,2,"おおみず"],[67,2,"ぼうふう"],[77,1,"はげ"],[80,1,"ち"],[82,1,"な"]],"text":"見よ、主はひとりの力ある強い者を持っておられる。これはひょうをまじえた暴風のように、破り、そこなう暴風雨のように、大水のあふれみなぎる暴風のように、それを激しく地に投げうつ。"},{"ref":"Isa.28.3","start":23028003,"end":23028003,"break":"line","breaks":[[15,"line"]],"ruby":[[6,1,"よ"],[11,1,"ほこ"],[13,1,"かんむり"],[15,1,"あし"],[17,1,"ふ"]],"text":"エフライムの酔いどれの誇る冠は足で踏みにじられる。"},{"ref":"Isa.28.4","start":23028004,"end":23028004,"break":"line","breaks":[[11,"line"],[25,"line"],[44,"line"]],"ruby":[[0,1,"こ"],[3,1,"たに"],[16,1,"はな"],[18,1,"うつく"],[21,1,"かざ"],[25,1,"なつ"],[26,1,"まえ"],[28,1,"じゅく"],[31,1,"はつ"],[44,1,"ひと"],[49,1,"み"],[53,1,"と"],[60,1,"た"]],"text":"肥えた谷のかしらにあるしぼみゆく花の美しい飾りは、夏前に熟した初なりのいちじくのようだ。人がこれを見ると、取るやいなや、食べてしまう。"},{"ref":"Isa.28.5","start":23028005,"end":23028005,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"ひ"],[4,2,"ばんぐん"],[7,1,"しゅ"],[11,1,"たみ"],[13,1,"のこ"],[16,1,"もの"],[22,1,"さか"],[25,1,"かんむり"],[30,1,"うるわ"],[33,1,"かんむり"]],"text":"その日、万軍の主はその民の残った者のために、栄えの冠となり、麗しい冠となられる。"},{"ref":"Isa.28.6","start":23028006,"end":23028006,"break":"line","breaks":[[24,"line"]],"ruby":[[7,1,"せき"],[9,1,"ざ"],[12,1,"もの"],[19,1,"れい"],[24,1,"たたか"],[27,1,"もん"],[30,1,"お"],[32,1,"かえ"],[34,1,"もの"],[37,1,"ちから"]],"text":"また、さばきの席に座する者にはさばきの霊となり、戦いを門まで追い返す者には力となられる。"},{"ref":"Isa.28.7","start":23028007,"end":23028007,"break":"paragraph","breaks":[[20,"line"],[32,"line"],[52,"line"],[62,"line"],[74,"line"],[87,"line"]],"ruby":[[10,1,"さけ"],[20,1,"こ"],[22,1,"さけ"],[32,2,"さいし"],[35,3,"よげんしゃ"],[40,1,"こ"],[42,1,"さけ"],[52,1,"さけ"],[57,1,"こころ"],[62,1,"こ"],[64,1,"さけ"],[74,1,"かれ"],[77,1,"まぼろし"],[79,1,"み"],[84,1,"あやま"],[91,1,"おこな"]],"text":"しかし、これらもまた酒のゆえによろめき、濃き酒のゆえによろける。祭司と預言者とは濃き酒のゆえによろめき、酒のゆえに心みだれ、濃き酒のゆえによろける。彼らは幻を見るときに誤り、さばきを行うときにつまづく。"},{"ref":"Isa.28.8","start":23028008,"end":23028008,"break":"line","ruby":[[4,2,"しょくたく"],[7,1,"は"],[10,1,"もの"],[12,1,"み"],[15,1,"きよ"],[17,1,"ところ"]],"text":"すべての食卓は吐いた物で満ち、清い所はない。"},{"ref":"Isa.28.9","start":23028009,"end":23028009,"break":"paragraph","breaks":[[19,"line"],[39,"line"]],"ruby":[[1,1,"かれ"],[6,2,"ちしき"],[9,1,"おし"],[27,1,"と"],[39,1,"ちち"],[44,1,"ち"],[48,1,"はな"],[51,1,"もの"]],"text":"「彼はだれに知識を教えようとするのか。だれにおとずれを説きあかそうとするのか。乳をやめ、乳ぶさを離れた者にするのだろうか。"},{"ref":"Isa.28.10","start":23028010,"end":23028010,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[3,2,"きょうくん"],[6,2,"きょうくん"],[9,2,"きょうくん"],[12,2,"きょうくん"],[15,2,"きそく"],[18,2,"きそく"],[21,2,"きそく"],[24,2,"きそく"],[31,1,"すこ"],[38,1,"すこ"],[40,1,"おし"]],"text":"それは教訓に教訓、教訓に教訓、規則に規則、規則に規則。ここにも少し、そこにも少し教えるのだ」。"},{"ref":"Isa.28.11","start":23028011,"end":23028011,"break":"paragraph","breaks":[[16,"line"]],"ruby":[[0,1,"いな"],[5,1,"しゅ"],[7,2,"いこく"],[16,2,"いこく"],[19,1,"した"],[27,1,"たみ"],[29,1,"かた"]],"text":"否、むしろ主は異国のくちびると、異国の舌とをもってこの民に語られる。"},{"ref":"Isa.28.12","start":23028012,"end":23028012,"break":"line","breaks":[[13,"line"],[21,"line"],[33,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"かれ"],[8,1,"い"],[17,2,"あんそく"],[21,1,"つか"],[24,1,"もの"],[26,2,"あんそく"],[29,1,"あた"],[36,2,"きゅうそく"],[45,1,"かれ"],[48,1,"き"]],"text":"主はさきに彼らに言われた、「これが安息だ、疲れた者に安息を与えよ。これが休息だ」と。しかし彼らは聞こうとはしなかった。"},{"ref":"Isa.28.13","start":23028013,"end":23028013,"break":"line","breaks":[[14,"line"],[26,"line"],[38,"line"],[55,"line"],[72,"line"]],"ruby":[[5,1,"しゅ"],[7,2,"ことば"],[10,1,"かれ"],[14,2,"きょうくん"],[17,2,"きょうくん"],[20,2,"きょうくん"],[23,2,"きょうくん"],[26,2,"きそく"],[29,2,"きそく"],[32,2,"きそく"],[35,2,"きそく"],[42,1,"すこ"],[49,1,"すこ"],[58,1,"かれ"],[61,1,"い"],[69,1,"たお"],[72,1,"やぶ"],[84,1,"とら"]],"text":"それゆえ、主の言葉は彼らに、教訓に教訓、教訓に教訓、規則に規則、規則に規則、ここにも少し、そこにも少しとなる。これは彼らが行って、うしろに倒れ、破られ、わなにかけられ、捕えられるためである。"},{"ref":"Isa.28.14","start":23028014,"end":23028014,"break":"paragraph","breaks":[[20,"line"]],"ruby":[[15,1,"たみ"],[17,1,"おさ"],[24,2,"ひとびと"],[28,1,"しゅ"],[30,2,"ことば"],[33,1,"き"]],"text":"それゆえ、エルサレムにあるこの民を治めるあざける人々よ、主の言葉を聞け。"},{"ref":"Isa.28.15","start":23028015,"end":23028015,"break":"line","breaks":[[10,"line"],[24,"line"],[34,"line"],[51,"line"],[63,"line"],[78,"line"]],"ruby":[[6,1,"い"],[16,1,"し"],[18,2,"けいやく"],[24,2,"よみ"],[27,2,"きょうてい"],[30,1,"むす"],[42,1,"わざわい"],[44,1,"す"],[47,1,"とき"],[59,1,"こ"],[71,1,"さ"],[73,1,"どころ"],[78,1,"いつわ"],[84,1,"み"]],"text":"あなたがたは言った、「われわれは死と契約をなし、陰府と協定を結んだ。みなぎりあふれる災の過ぎる時にも、それはわれわれに来ない。われわれはうそを避け所となし、偽りをもって身をかくしたからである」。"},{"ref":"Isa.28.16","start":23028016,"end":23028016,"break":"line","breaks":[[17,"line"],[29,"line"],[42,"line"],[52,"line"],[66,"line"]],"ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[18,1,"み"],[32,1,"いし"],[37,1,"もとい"],[45,1,"こころ"],[48,1,"へ"],[50,1,"いし"],[52,1,"かた"],[57,1,"たっと"],[59,1,"すみ"],[61,1,"いし"],[67,1,"しん"],[70,1,"もの"]],"text":"それゆえ、主なる神はこう言われる、「見よ、わたしはシオンに一つの石をすえて基とした。これは試みを経た石、堅くすえた尊い隅の石である。『信ずる者はあわてることはない』。"},{"ref":"Isa.28.17","start":23028017,"end":23028017,"break":"line","breaks":[[15,"line"],[27,"line"],[42,"line"]],"ruby":[[4,2,"こうへい"],[8,1,"はか"],[15,2,"せいぎ"],[19,1,"さ"],[21,1,"ふ"],[31,1,"いつわ"],[34,1,"さ"],[36,1,"どころ"],[38,1,"ほろ"],[42,1,"みず"],[44,1,"かく"],[46,1,"ば"],[48,1,"お"],[50,1,"たお"]],"text":"わたしは公平を、測りなわとし、正義を、下げ振りとする。ひょうは偽りの避け所を滅ぼし、水は隠れ場を押し倒す」。"},{"ref":"Isa.28.18","start":23028018,"end":23028018,"break":"line","breaks":[[23,"line"],[38,"line"],[54,"line"]],"ruby":[[2,1,"とき"],[9,1,"し"],[14,2,"けいやく"],[17,1,"と"],[19,1,"け"],[23,2,"よみ"],[26,1,"むす"],[29,2,"きょうてい"],[32,1,"おこな"],[46,1,"わざわい"],[48,1,"す"],[66,1,"う"],[68,1,"たお"]],"text":"その時あなたがたが死とたてた契約は取り消され、陰府と結んだ協定は行われない。みなぎりあふれる災の過ぎるとき、あなたがたはこれによって打ち倒される。"},{"ref":"Isa.28.19","start":23028019,"end":23028019,"break":"line","breaks":[[20,"line"],[30,"line"],[41,"line"],[59,"line"]],"ruby":[[3,1,"す"],[16,1,"とら"],[23,1,"あさ"],[25,1,"あさ"],[27,1,"す"],[30,1,"ひる"],[32,1,"よる"],[34,1,"す"],[48,1,"き"],[59,1,"まった"],[62,1,"おそ"]],"text":"それが過ぎるごとに、あなたがたを捕える。それは朝な朝な過ぎ、昼も夜も過ぎるからだ。このおとずれを聞きわきまえることは、全くの恐れである。"},{"ref":"Isa.28.20","start":23028020,"end":23028020,"break":"line","breaks":[[17,"line"],[26,"line"]],"ruby":[[0,1,"とこ"],[2,1,"みじか"],[5,1,"み"],[7,1,"の"],[20,2,"やぐ"],[23,1,"せま"],[26,1,"み"]],"text":"床が短くて身を伸べることができず、かける夜具が狭くて身をおおうことができないからだ。"},{"ref":"Isa.28.21","start":23028021,"end":23028021,"break":"line","breaks":[[21,"line"],[40,"line"],[50,"line"],[65,"line"],[77,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"やま"],[8,1,"た"],[15,1,"た"],[26,1,"たに"],[28,1,"いきどお"],[35,1,"いきどお"],[42,1,"おこな"],[52,1,"おこな"],[55,1,"るい"],[82,1,"こと"]],"text":"主はペラジム山で立たれたように立ちあがり、ギベオンの谷で憤られたように憤られて、その行いをなされる。その行いは類のないものである。またそのわざをなされる。そのわざは異なったものである。"},{"ref":"Isa.28.22","start":23028022,"end":23028022,"break":"line","breaks":[[22,"line"],[46,"line"],[59,"line"]],"ruby":[[50,1,"しゅ"],[53,2,"ばんぐん"],[56,1,"かみ"],[59,1,"ぜん"],[60,1,"ち"],[62,1,"うえ"],[64,1,"のぞ"],[66,1,"ほろ"],[69,2,"せんげん"],[72,1,"き"]],"text":"それゆえ、あなたがたはあざけってはならない。さもないと、あなたがたのなわめは、きびしくなる。わたしは主なる万軍の神から全地の上に臨む滅びの宣言を聞いたからである。"},{"ref":"Isa.28.23","start":23028023,"end":23028023,"break":"paragraph","breaks":[[22,"line"]],"ruby":[[6,1,"みみ"],[8,1,"かたむ"],[14,1,"こえ"],[16,1,"き"],[22,1,"こころ"],[27,2,"ことば"],[30,1,"き"]],"text":"あなたがたは耳を傾けて、わが声を聞くがよい。心してわが言葉を聞くがよい。"},{"ref":"Isa.28.24","start":23028024,"end":23028024,"break":"line","breaks":[[21,"line"],[34,"line"]],"ruby":[[0,1,"たね"],[7,1,"たがや"],[9,1,"もの"],[11,1,"た"],[14,1,"たがや"],[21,1,"かれ"],[23,1,"た"],[28,1,"ち"],[41,1,"つち"]],"text":"種をまくために耕す者は絶えず耕すだろうか。彼は絶えずその地をひらき、まぐわをもって土をならすだろうか。"},{"ref":"Isa.28.25","start":23028025,"end":23028025,"break":"line","breaks":[[15,"line"],[30,"line"],[50,"line"]],"ruby":[[0,1,"ち"],[6,1,"たい"],[30,2,"こむぎ"],[36,1,"う"],[39,2,"おおむぎ"],[42,1,"さだ"],[45,1,"ところ"],[47,1,"う"],[54,1,"むぎ"],[58,1,"さかい"],[60,1,"う"]],"text":"地のおもてを平らにしたならば、いのんどをまき、クミンをまき、小麦をうねに植え、大麦を定めた所に植え、スペルト麦をその境に植えないだろうか。"},{"ref":"Isa.28.26","start":23028026,"end":23028026,"break":"line","breaks":[[11,"line"]],"ruby":[[3,1,"かれ"],[5,1,"かみ"],[7,1,"ただ"],[11,1,"かれ"],[13,1,"みちび"],[15,1,"おし"]],"text":"これは彼の神が正しく、彼を導き教えられるからである。"},{"ref":"Isa.28.27","start":23028027,"end":23028027,"break":"line","breaks":[[15,"line"],[33,"line"],[47,"line"]],"ruby":[[5,1,"むぎ"],[8,1,"いた"],[21,1,"うえ"],[23,2,"しゃりん"],[38,1,"う"],[42,1,"ぼう"],[44,1,"もち"],[51,1,"う"],[58,1,"もち"]],"text":"いのんどは麦こき板でこかない、クミンはその上に車輪をころがさない。いのんどを打つには棒を用い、クミンを打つにはさおを用いる。"},{"ref":"Isa.28.28","start":23028028,"end":23028028,"break":"line","breaks":[[19,"line"],[43,"line"],[62,"line"]],"ruby":[[0,1,"ひと"],[4,1,"よう"],[6,1,"むぎ"],[8,1,"う"],[12,1,"くだ"],[19,1,"いな"],[24,1,"くだ"],[34,1,"う"],[43,1,"うま"],[50,1,"うえ"],[52,2,"しゃりん"],[55,1,"ひ"],[65,1,"くだ"]],"text":"人はパン用の麦を打つとき砕くだろうか、否、それが砕けるまでいつまでも打つことをしない。馬をもってその上に車輪を引かせるとき、それを砕くことをしない。"},{"ref":"Isa.28.29","start":23028029,"end":23028029,"break":"line","breaks":[[19,"line"],[31,"line"]],"ruby":[[5,2,"ばんぐん"],[8,1,"しゅ"],[11,1,"で"],[21,1,"はか"],[26,1,"おどろ"],[33,2,"ちえ"]],"text":"これもまた万軍の主から出ることである。その計りごとは驚くべく、その知恵はすぐれている。"}]