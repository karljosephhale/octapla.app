[{"ref":"Nah.1.1","start":34001001,"end":34001001,"break":"paragraph","ruby":[[8,2,"たくせん"],[21,1,"まぼろし"],[23,1,"しょ"]],"text":"ニネベについての託宣。エルコシびとナホムの幻の書。"},{"ref":"Nah.1.2","start":34001002,"end":34001002,"break":"stanza","breaks":[[16,"line"],[32,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"むく"],[14,1,"かみ"],[16,1,"しゅ"],[21,1,"むく"],[24,1,"もの"],[28,1,"いきどお"],[30,1,"もの"],[32,1,"しゅ"],[40,2,"ほうふく"],[47,1,"てき"],[49,1,"たい"],[52,1,"いきどお"]],"text":"主はねたみ、かつあだを報いる神、主はあだを報いる者、また憤る者、主はおのがあだに報復し、おのが敵に対して憤りをいだく。"},{"ref":"Nah.1.3","start":34001003,"end":34001003,"break":"line","breaks":[[15,"line"],[34,"line"],[51,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"いか"],[10,2,"ちからづよ"],[13,1,"もの"],[15,1,"しゅ"],[17,1,"ばつ"],[21,1,"もの"],[23,1,"けっ"],[32,1,"もの"],[34,1,"しゅ"],[36,1,"みち"],[41,1,"かぜ"],[43,2,"おおかぜ"],[46,1,"なか"],[51,1,"くも"],[55,1,"あし"]],"text":"主は怒ることおそく、力強き者、主は罰すべき者を決してゆるされない者、主の道はつむじ風と大風の中にあり、雲はその足のちりである。"},{"ref":"Nah.1.4","start":34001004,"end":34001004,"break":"line","breaks":[[16,"line"],[28,"line"],[42,"line"]],"ruby":[[0,1,"かれ"],[2,1,"うみ"],[4,1,"いまし"],[20,1,"かわ"],[47,1,"はな"]],"text":"彼は海を戒めて、これをかわかし、すべての川をかれさせる。バシャンとカルメルはしおれ、レバノンの花はしぼむ。"},{"ref":"Nah.1.5","start":34001005,"end":34001005,"break":"line","breaks":[[24,"line"],[37,"line"]],"ruby":[[5,1,"やま"],[7,1,"かれ"],[9,1,"まえ"],[11,1,"ふる"],[19,1,"おか"],[21,1,"と"],[24,1,"ち"],[26,1,"かれ"],[28,1,"まえ"],[37,2,"せかい"],[42,1,"なか"],[44,1,"す"],[46,1,"もの"],[48,1,"みな"]],"text":"もろもろの山は彼の前に震い、もろもろの丘は溶け、地は彼の前にむなしくなり、世界とその中に住む者も皆、むなしくなる。"},{"ref":"Nah.1.6","start":34001006,"end":34001006,"break":"line","breaks":[[20,"line"],[42,"line"],[56,"line"]],"ruby":[[3,1,"かれ"],[5,1,"いきどお"],[8,1,"まえ"],[10,1,"た"],[23,1,"かれ"],[25,1,"も"],[28,1,"いか"],[31,1,"た"],[44,1,"いきどお"],[47,1,"ひ"],[52,1,"そそ"],[56,1,"いわ"],[58,1,"かれ"],[63,1,"さ"]],"text":"だれが彼の憤りの前に立つことができよう。だれが彼の燃える怒りに耐えることができよう。その憤りは火のように注がれ、岩も彼によって裂かれる。"},{"ref":"Nah.1.7","start":34001007,"end":34001007,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"めぐ"],[4,1,"ふか"],[11,1,"ひ"],[13,2,"ようがい"],[19,1,"かれ"],[22,2,"じぶん"],[25,1,"さ"],[27,1,"どころ"],[31,1,"もの"],[33,1,"し"]],"text":"主は恵み深く、なやみの日の要害である。彼はご自分を避け所とする者を知っておられる。"},{"ref":"Nah.1.8","start":34001008,"end":34001008,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"かれ"],[10,2,"こうずい"],[16,1,"まった"],[18,1,"ほろ"],[25,1,"てき"],[27,1,"くら"],[31,1,"お"]],"text":"しかし、彼はみなぎる洪水であだを全く滅ぼし、おのが敵を暗やみに追いやられる。"},{"ref":"Nah.1.9","start":34001009,"end":34001009,"break":"line","breaks":[[17,"line"],[41,"line"]],"ruby":[[6,1,"しゅ"],[8,1,"たい"],[11,1,"なに"],[13,1,"はか"],[17,1,"かれ"],[21,1,"てき"],[24,1,"ど"],[33,2,"ひつよう"],[41,1,"てき"],[43,1,"まった"],[45,1,"ほろ"]],"text":"あなたがたは主に対して何を計るか。彼はその敵に二度としかえしをする必要がないように敵を全く滅ぼされる。"},{"ref":"Nah.1.10","start":34001010,"end":34001010,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"むす"],[22,1,"か"],[24,1,"かぶ"],[30,1,"や"],[32,1,"つく"]],"text":"彼らは結びからまったいばらのように、かわいた刈り株のように、焼き尽される。"},{"ref":"Nah.1.11","start":34001011,"end":34001011,"break":"line","breaks":[[11,"line"],[23,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"たい"],[5,2,"あくじ"],[8,1,"はか"],[16,1,"こと"],[18,1,"すす"],[21,1,"もの"],[31,1,"で"]],"text":"主に対して悪事を計り、よこしまな事を勧める者があなたのうちから出たではないか。"},{"ref":"Nah.1.12","start":34001012,"end":34001012,"break":"stanza","breaks":[[9,"line"],[28,"line"],[40,"line"],[54,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[13,1,"かれ"],[16,1,"つよ"],[21,1,"おお"],[28,1,"き"],[30,1,"たお"],[34,1,"た"],[48,1,"くる"],[54,1,"かさ"],[61,1,"くる"]],"text":"主はこう言われる、「たとい彼らは強く、かつ多くあっても、切り倒されて絶えはてる。わたしはあなたを苦しめたが、重ねてあなたを苦しめない。"},{"ref":"Nah.1.13","start":34001013,"end":34001013,"break":"line","breaks":[[15,"line"],[25,"line"]],"ruby":[[0,1,"いま"],[5,1,"かれ"],[11,1,"くだ"],[22,1,"のぞ"],[33,1,"き"]],"text":"今わたしは彼のくびきを砕いて、あなたからとり除き、あなたのなわめを切りはなす」。"},{"ref":"Nah.1.14","start":34001014,"end":34001014,"break":"stanza","breaks":[[17,"line"],[31,"line"],[46,"line"],[59,"line"],[71,"line"]],"ruby":[[0,1,"しゅ"],[10,1,"めい"],[22,1,"な"],[24,1,"なが"],[26,1,"つづ"],[39,2,"かみがみ"],[42,1,"いえ"],[46,2,"ちょうぞう"],[51,2,"ちゅうぞう"],[54,1,"のぞ"],[56,1,"さ"],[63,2,"つみぶか"],[66,1,"もの"],[79,1,"はか"],[81,1,"もう"]],"text":"主はあなたについてお命じになった、「あなたの名は長く続かない。わたしはあなたの神々の家から、彫像および鋳造を除き去る。あなたは罪深い者だから、わたしはあなたの墓を設ける」。"},{"ref":"Nah.1.15","start":34001015,"end":34001015,"break":"stanza","breaks":[[24,"line"],[35,"line"],[48,"line"],[59,"line"],[70,"line"],[90,"line"]],"ruby":[[0,1,"み"],[3,1,"よ"],[10,1,"つた"],[13,1,"もの"],[15,1,"あし"],[17,1,"やま"],[19,1,"うえ"],[24,1,"かれ"],[26,2,"へいあん"],[29,1,"の"],[43,1,"まつり"],[45,1,"おこな"],[52,2,"せいがん"],[64,1,"もの"],[66,1,"かさ"],[74,1,"む"],[78,1,"せ"],[90,1,"かれ"],[92,1,"まった"],[94,1,"た"]],"text":"見よ、良きおとずれを伝える者の足は山の上にある。彼は平安を宣べている。ユダよ、あなたの祭を行い、あなたの誓願をはたせ。よこしまな者は重ねて、あなたに向かって攻めてこないからである。彼は全く断たれる。"}]