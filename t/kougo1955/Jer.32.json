[{"ref":"Jer.32.1","start":24032001,"end":24032001,"break":"paragraph","ruby":[[3,1,"おう"],[10,1,"ねん"],[26,1,"ねん"],[29,1,"しゅ"],[31,2,"ことば"],[39,1,"のぞ"]],"text":"ユダの王ゼデキヤの十年、すなわちネブカデレザルの十八年に、主の言葉がエレミヤに臨んだ。"},{"ref":"Jer.32.2","start":24032002,"end":24032002,"break":"none","ruby":[[2,1,"とき"],[9,1,"おう"],[11,2,"ぐんぜい"],[20,1,"せ"],[22,1,"かこ"],[28,3,"よげんしゃ"],[39,1,"おう"],[41,2,"きゅうでん"],[46,2,"かんし"],[49,1,"にわ"],[54,2,"かんきん"]],"text":"その時、バビロンの王の軍勢がエルサレムを攻め囲んでいて、預言者エレミヤはユダの王の宮殿にある監視の庭のうちに監禁されていた。"},{"ref":"Jer.32.3","start":24032003,"end":24032003,"break":"none","ruby":[[3,1,"おう"],[9,1,"かれ"],[11,1,"と"],[13,1,"こ"],[22,1,"おう"],[24,1,"い"],[35,2,"よげん"],[39,1,"い"],[45,1,"しゅ"],[49,1,"おお"],[55,1,"み"],[64,1,"まち"],[71,1,"おう"],[73,1,"て"],[75,1,"わた"],[78,1,"かれ"],[83,1,"と"]],"text":"ユダの王ゼデキヤが彼を閉じ込めたのであるが、王は言った、「なぜあなたは預言して言うのか、『主はこう仰せられる、見よ、わたしはこの町をバビロンの王の手に渡し、彼はこれを取る。"},{"ref":"Jer.32.4","start":24032004,"end":24032004,"break":"none","ruby":[[5,1,"おう"],[18,1,"て"],[38,1,"おう"],[40,1,"て"],[42,1,"わた"],[46,1,"かお"],[48,1,"かお"],[50,1,"あ"],[54,1,"かれ"],[56,1,"かた"],[59,1,"め"],[61,1,"め"],[63,1,"あい"]],"text":"またユダの王ゼデキヤはカルデヤびとの手をのがれることなく、かならずバビロンの王の手に渡され、顔と顔を合わせて彼と語り、目と目は相まみえる。"},{"ref":"Jer.32.5","start":24032005,"end":24032005,"break":"none","ruby":[[3,1,"かれ"],[15,1,"ひ"],[31,1,"かれ"],[33,1,"かえり"],[36,1,"とき"],[46,1,"しゅ"],[48,1,"い"],[67,1,"たたか"],[71,1,"か"]],"text":"そして彼はゼデキヤをバビロンに引いていき、ゼデキヤは、わたしが彼を顧みる時まで、そこにいると主は言われる。あなたがたは、カルデヤびとと戦っても勝つことはできない』と」。"},{"ref":"Jer.32.6","start":24032006,"end":24032006,"break":"paragraph","ruby":[[5,1,"い"],[10,1,"しゅ"],[12,2,"ことば"],[19,1,"のぞ"],[22,1,"い"]],"text":"エレミヤは言った、「主の言葉がわたしに臨んで言われる、"},{"ref":"Jer.32.7","start":24032007,"end":24032007,"break":"none","ruby":[[1,1,"み"],[15,1,"こ"],[25,1,"ところ"],[27,1,"き"],[29,1,"い"],[44,1,"はたけ"],[46,1,"か"],[59,1,"か"],[61,1,"と"],[68,2,"けんり"]],"text":"『見よ、あなたのおじシャルムの子ハナメルがあなたの所に来て言う、「アナトテにあるわたしの畑を買いなさい。それは、これを買い取り、あがなう権利があなたにあるから」と』。"},{"ref":"Jer.32.8","start":24032008,"end":24032008,"break":"none","ruby":[[4,1,"しゅ"],[6,2,"ことば"],[28,2,"かんし"],[31,1,"にわ"],[42,1,"ところ"],[44,1,"き"],[46,1,"い"],[57,1,"ち"],[70,1,"はたけ"],[72,1,"か"],[80,2,"しょゆう"],[98,2,"けんり"],[105,1,"か"],[107,1,"と"],[114,1,"もの"],[126,1,"しゅ"],[128,2,"ことば"],[139,1,"し"]],"text":"はたして主の言葉のように、わたしのいとこであるハナメルが監視の庭のうちにいるわたしの所に来て言った、『ベニヤミンの地のアナトテにあるわたしの畑を買ってください。所有するのも、あがなうのも、あなたの権利なのです。買い取ってあなたの物にしてください。これが主の言葉であるのをわたしは知っていました』。"},{"ref":"Jer.32.9","start":24032009,"end":24032009,"break":"paragraph","ruby":[[25,1,"はたけ"],[27,1,"か"],[29,1,"と"],[32,1,"ぎん"],[39,1,"はか"],[42,1,"かれ"],[44,2,"しはら"]],"text":"そこでわたしは、いとこのハナメルからアナトテにある畑を買い取り、銀十七シケルを量って彼に支払った。"},{"ref":"Jer.32.10","start":24032010,"end":24032010,"break":"none","ruby":[[11,2,"しょうしょ"],[22,2,"きめい"],[29,2,"ふういん"],[33,2,"しょうにん"],[36,1,"た"],[46,1,"ぎん"],[48,1,"はか"],[51,1,"あた"]],"text":"すなわち、わたしはその証書をつくって、これに記名し、それを封印し、証人を立て、はかりをもって銀を量って与えた。"},{"ref":"Jer.32.11","start":24032011,"end":24032011,"break":"none","ruby":[[9,2,"やくじょう"],[16,2,"ふういん"],[20,2,"ばいしゅう"],[22,2,"しょうしょ"],[26,2,"ふういん"],[31,1,"うつ"],[35,1,"と"]],"text":"そしてわたしはその約定をしるして封印した買収証書と、封印のない写しとを取り、"},{"ref":"Jer.32.12","start":24032012,"end":24032012,"break":"none","ruby":[[10,2,"ばいしゅう"],[12,2,"しょうしょ"],[15,2,"きめい"],[19,2,"しょうにん"],[27,2,"かんし"],[30,1,"にわ"],[45,1,"ひと"],[47,1,"まえ"],[52,2,"しょうしょ"],[60,1,"こ"],[68,1,"こ"],[73,1,"あた"]],"text":"いとこのハナメルと、買収証書に記名した証人たち、および監視の庭にすわっているすべてのユダヤ人の前で、その証書をマアセヤの子であるネリヤの子バルクに与え、"},{"ref":"Jer.32.13","start":24032013,"end":24032013,"break":"none","ruby":[[0,1,"かれ"],[3,1,"まえ"],[14,1,"めい"],[17,1,"い"]],"text":"彼らの前で、わたしはバルクに命じて言った、"},{"ref":"Jer.32.14","start":24032014,"end":24032014,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[12,1,"かみ"],[16,1,"おお"],[26,2,"しょうしょ"],[35,2,"ばいしゅう"],[37,2,"しょうしょ"],[40,2,"ふういん"],[48,2,"ふういん"],[53,1,"うつ"],[57,1,"と"],[64,1,"つち"],[66,1,"うつわ"],[68,1,"い"],[72,1,"なが"],[74,2,"ほぞん"]],"text":"『万軍の主、イスラエルの神はこう仰せられる、これらの証書すなわち、この買収証書の封印したものと、封印のない写しとを取り、これらを土の器に入れて、長く保存せよ。"},{"ref":"Jer.32.15","start":24032015,"end":24032015,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[15,1,"い"],[28,1,"ち"],[30,2,"ひとびと"],[35,1,"いえ"],[37,1,"はたけ"],[42,1,"はたけ"],[44,1,"か"]],"text":"万軍の主、イスラエルの神がこう言われるからである、「この地で人々はまた家と畑とぶどう畑を買うようになる」と』。"},{"ref":"Jer.32.16","start":24032016,"end":24032016,"break":"paragraph","ruby":[[4,2,"ばいしゅう"],[6,2,"しょうしょ"],[13,1,"こ"],[18,1,"わた"],[24,1,"しゅ"],[26,1,"いの"],[29,1,"い"]],"text":"わたしは買収証書をネリヤの子バルクに渡したあとで主に祈って言った、"},{"ref":"Jer.32.17","start":24032017,"end":24032017,"break":"none","ruby":[[3,1,"しゅ"],[6,1,"かみ"],[13,1,"おお"],[17,1,"ちから"],[20,1,"の"],[23,1,"うで"],[28,1,"てん"],[30,1,"ち"],[33,1,"つく"]],"text":"『ああ主なる神よ、あなたは大いなる力と、伸べた腕をもって天と地をお造りになったのです。あなたのできないことは、ひとつもありません。"},{"ref":"Jer.32.18","start":24032018,"end":24032018,"break":"none","ruby":[[12,1,"にん"],[14,1,"ほどこ"],[19,1,"ちち"],[21,1,"つみ"],[28,2,"しそん"],[31,1,"むく"],[44,1,"おお"],[48,2,"ぜんのう"],[51,1,"かみ"],[61,1,"な"],[63,2,"ばんぐん"],[66,1,"しゅ"],[68,1,"もう"]],"text":"あなたはいつくしみを千万人に施し、また父の罪をそののちの子孫に報いられるのです。あなたは大いなる全能の神でいらせられ、その名は万軍の主と申されます。"},{"ref":"Jer.32.19","start":24032019,"end":24032019,"break":"none","ruby":[[4,1,"はか"],[9,1,"おお"],[16,1,"こと"],[18,1,"おこな"],[22,1,"ちから"],[31,1,"め"],[33,2,"ひとびと"],[36,1,"あゆ"],[42,1,"みち"],[44,1,"み"],[52,1,"みち"],[61,1,"おこな"],[64,1,"み"],[72,1,"むく"]],"text":"あなたの計りごとは大きく、また、事を行うのに力があり、あなたの目は人々の歩むすべての道を見て、おのおのの道にしたがい、その行いの実によってこれに報いられます。"},{"ref":"Jer.32.20","start":24032020,"end":24032020,"break":"none","ruby":[[10,3,"ふしぎ"],[23,1,"ち"],[25,1,"おこな"],[30,2,"こんにち"],[33,1,"いた"],[43,1,"ぜん"],[44,2,"じんるい"],[50,1,"おこな"],[56,2,"こんにち"],[62,1,"な"]],"text":"あなたは、しるしと、不思議なわざとをエジプトの地に行い、また今日に至るまでイスラエルと全人類のうちに行い、そして今日のように名をあげられました。"},{"ref":"Jer.32.21","start":24032021,"end":24032021,"break":"none","ruby":[[10,3,"ふしぎ"],[18,1,"つよ"],[20,1,"て"],[23,1,"の"],[26,1,"うで"],[29,1,"おお"],[33,1,"おそ"],[37,1,"こと"],[47,1,"たみ"],[59,1,"ち"],[62,1,"みちび"],[64,1,"だ"]],"text":"あなたは、しるしと、不思議なわざと、強い手と、伸べた腕と、大いなる恐るべき事をもって、あなたの民イスラエルをエジプトの地から導き出し、"},{"ref":"Jer.32.22","start":24032022,"end":24032022,"break":"none","ruby":[[2,1,"ち"],[4,1,"かれ"],[7,1,"たま"],[21,1,"かれ"],[24,2,"せんぞ"],[29,1,"あた"],[34,1,"ちか"],[38,1,"ちち"],[40,1,"みつ"],[42,1,"なが"],[45,1,"ち"]],"text":"この地を彼らに賜わりました。これはあなたが彼らの先祖たちに与えようと誓われた乳と蜜の流れる地です。"},{"ref":"Jer.32.23","start":24032023,"end":24032023,"break":"none","ruby":[[4,1,"かれ"],[15,1,"え"],[26,1,"こえ"],[28,1,"き"],[30,1,"したが"],[38,2,"りっぽう"],[41,1,"おこな"],[55,1,"めい"],[77,1,"わざわい"],[79,1,"かれ"],[82,1,"うえ"],[85,1,"くだ"]],"text":"こうして彼らは、はいってこれを獲たのですが、あなたの声に聞き従わず、あなたの律法を行わず、すべてあなたがせよと命じられたことをしなかったので、あなたはこの災を彼らの上にお下しになりました。"},{"ref":"Jer.32.24","start":24032024,"end":24032024,"break":"none","ruby":[[0,1,"み"],[3,1,"るい"],[5,1,"きず"],[17,1,"まち"],[19,1,"と"],[36,2,"えきびょう"],[43,1,"まち"],[48,1,"せ"],[60,1,"て"],[62,1,"わた"],[72,1,"い"]],"text":"見よ、塁が築きあげられたのは、この町を取るためです。つるぎと、ききんと、疫病のために、町はこれを攻めているカルデヤびとの手に渡されます。あなたの言われたようになりましたのは、ごらんのとおりであります。"},{"ref":"Jer.32.25","start":24032025,"end":24032025,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[14,1,"い"],[22,1,"ぎん"],[27,1,"はたけ"],[29,1,"か"],[32,2,"しょうにん"],[35,1,"た"],[49,1,"まち"],[58,1,"て"],[60,1,"わた"]],"text":"主なる神よ、あなたはわたしに言われました、「銀をもって畑を買い、証人を立てよ」と。そうであるのに、町はカルデヤびとの手に渡されています』」。"},{"ref":"Jer.32.26","start":24032026,"end":24032026,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[10,1,"のぞ"]],"text":"主の言葉がエレミヤに臨んだ、"},{"ref":"Jer.32.27","start":24032027,"end":24032027,"break":"none","ruby":[[1,1,"み"],[8,1,"しゅ"],[16,1,"いのち"],[19,1,"もの"],[21,1,"かみ"],[34,1,"こと"]],"text":"「見よ、わたしは主である、すべて命ある者の神である。わたしにできない事があろうか。"},{"ref":"Jer.32.28","start":24032028,"end":24032028,"break":"none","ruby":[[5,1,"しゅ"],[9,1,"い"],[14,1,"み"],[23,1,"まち"],[38,1,"おう"],[47,1,"て"],[49,1,"わた"],[52,1,"かれ"],[57,1,"と"]],"text":"それゆえ、主はこう言われる、見よ、わたしはこの町をカルデヤびとと、バビロンの王ネブカデレザルの手に渡す。彼はこれを取る。"},{"ref":"Jer.32.29","start":24032029,"end":24032029,"break":"none","ruby":[[2,1,"まち"],[4,1,"せ"],[21,1,"まち"],[23,1,"ひ"],[28,1,"や"],[30,1,"はら"],[33,2,"やね"],[36,1,"うえ"],[38,2,"ひとびと"],[46,1,"こう"],[54,2,"かみがみ"],[57,1,"さけ"],[68,1,"いか"],[74,1,"いえ"],[77,1,"かれ"],[80,1,"や"]],"text":"この町を攻めているカルデヤびとがきて、この町に火をつけて焼き払う。屋根の上で人々が、バアルに香をたき、ほかの神々に酒をそそいで、わたしを怒らせたその家をも彼らは焼く。"},{"ref":"Jer.32.30","start":24032030,"end":24032030,"break":"none","ruby":[[10,2,"ひとびと"],[16,2,"ひとびと"],[23,1,"わか"],[25,1,"とき"],[33,1,"まえ"],[35,1,"わる"],[42,1,"おこな"],[53,1,"たみ"],[57,1,"て"],[70,1,"いか"],[88,1,"しゅ"],[90,1,"い"]],"text":"それは、イスラエルの人々とユダの人々とは、その若い時から、わたしの前に悪いことのみを行い、またイスラエルの民はその手のわざをもって、わたしを怒らせることばかりをしたからであると主は言われる。"},{"ref":"Jer.32.31","start":24032031,"end":24032031,"break":"none","ruby":[[2,1,"まち"],[7,1,"た"],[10,1,"ひ"],[23,1,"いか"],[26,1,"いきどお"],[32,1,"おこ"],[44,1,"まえ"],[50,1,"のぞ"],[52,1,"さ"]],"text":"この町はそれが建った日からきょうまで、わたしの怒りと憤りとをひき起してきたので、わたしの前からこれを除き去るのである。"},{"ref":"Jer.32.32","start":24032032,"end":24032032,"break":"none","ruby":[[10,1,"たみ"],[15,1,"たみ"],[24,1,"あく"],[26,1,"い"],[34,1,"いか"],[50,1,"かれ"],[53,1,"おう"],[66,2,"さいし"],[71,3,"よげんしゃ"],[82,2,"ひとびと"],[91,2,"じゅうみん"],[96,1,"みな"]],"text":"それは、イスラエルの民とユダの民とが、もろもろの悪を行って、わたしを怒らせたことによるのである。――彼らの王たちと、そのつかさたち、祭司たち、預言者たち、またユダの人々とエルサレムの住民たちが皆そうである。"},{"ref":"Jer.32.33","start":24032033,"end":24032033,"break":"none","ruby":[[0,1,"かれ"],[5,2,"せなか"],[12,1,"む"],[15,1,"かお"],[21,1,"む"],[33,1,"おし"],[44,1,"かれ"],[47,1,"おしえ"],[49,1,"き"]],"text":"彼らはその背中をわたしに向けて顔をわたしに向けず、わたしがたゆまず教えたにもかかわらず、彼らは教を聞かず、またうけないのである。"},{"ref":"Jer.32.34","start":24032034,"end":24032034,"break":"none","ruby":[[0,1,"かれ"],[3,1,"にく"],[7,1,"もの"],[12,1,"な"],[17,1,"よ"],[23,1,"いえ"],[34,1,"けが"]],"text":"彼らは憎むべき物を、わが名をもって呼ばれている家にすえつけて、そこを汚し、"},{"ref":"Jer.32.35","start":24032035,"end":24032035,"break":"none","ruby":[[9,1,"たに"],[15,1,"たか"],[17,1,"ところ"],[19,1,"きず"],[26,1,"むすめ"],[41,1,"かれ"],[52,1,"めい"],[63,1,"かれ"],[68,1,"にく"],[75,1,"い"],[82,1,"つみ"],[84,1,"おか"],[91,1,"かんが"]],"text":"またベンヒンノムの谷にバアルの高き所を築いて、むすこ娘をモレクにささげた。わたしは彼らにこのようなことを命じたことはなく、また彼らがこの憎むべきことを行って、ユダに罪を犯させようとは考えもしなかった。"},{"ref":"Jer.32.36","start":24032036,"end":24032036,"break":"paragraph","ruby":[[4,1,"いま"],[11,1,"かみ"],[13,1,"しゅ"],[18,1,"まち"],[42,2,"えきびょう"],[53,1,"おう"],[55,1,"て"],[57,1,"わた"],[68,1,"まち"],[75,1,"おお"]],"text":"それゆえ今イスラエルの神、主は、この町、すなわちあなたがたが、『つるぎと、ききんと、疫病のためにバビロンの王の手に渡される』といっている町についてこう仰せられる、"},{"ref":"Jer.32.37","start":24032037,"end":24032037,"break":"none","ruby":[[0,1,"み"],[12,1,"いか"],[15,1,"いきどお"],[18,1,"おお"],[22,1,"いか"],[29,1,"かれ"],[32,1,"お"],[42,1,"くに"],[45,1,"かれ"],[48,1,"あつ"],[53,1,"ところ"],[55,1,"みちび"],[62,1,"やす"],[66,1,"す"]],"text":"見よ、わたしは、わたしの怒りと憤りと大いなる怒りをもって、彼らを追いやったもろもろの国から彼らを集め、この所へ導きかえって、安らかに住まわせる。"},{"ref":"Jer.32.38","start":24032038,"end":24032038,"break":"none","ruby":[[3,1,"かれ"],[10,1,"たみ"],[19,1,"かれ"],[22,1,"かみ"]],"text":"そして彼らはわたしの民となり、わたしは彼らの神となる。"},{"ref":"Jer.32.39","start":24032039,"end":24032039,"break":"none","ruby":[[4,1,"かれ"],[10,1,"こころ"],[15,1,"みち"],[17,1,"あた"],[20,1,"つね"],[26,1,"おそ"],[35,1,"かれ"],[38,1,"かれ"],[40,2,"じしん"],[45,1,"のち"],[47,2,"しそん"],[50,1,"さいわい"],[52,1,"え"]],"text":"わたしは彼らに一つの心と一つの道を与えて常にわたしを恐れさせる。これは彼らが彼ら自身とその後の子孫の幸を得るためである。"},{"ref":"Jer.32.40","start":24032040,"end":24032040,"break":"none","ruby":[[4,1,"かれ"],[7,2,"えいえん"],[10,2,"けいやく"],[13,1,"た"],[17,1,"かれ"],[20,2,"みす"],[25,1,"めぐ"],[28,1,"ほどこ"],[33,1,"ちか"],[42,1,"おそ"],[45,1,"おそ"],[48,1,"かれ"],[51,1,"こころ"],[53,1,"お"],[61,1,"はな"]],"text":"わたしは彼らと永遠の契約を立てて、彼らを見捨てずに恵みを施すことを誓い、またわたしを恐れる恐れを彼らの心に置いて、わたしを離れることのないようにしよう。"},{"ref":"Jer.32.41","start":24032041,"end":24032041,"break":"none","ruby":[[4,1,"かれ"],[7,1,"めぐ"],[10,1,"ほどこ"],[15,1,"よろこ"],[20,1,"こころ"],[26,2,"せいしん"],[33,2,"しんじつ"],[39,1,"かれ"],[44,1,"ち"],[46,1,"う"]],"text":"わたしは彼らに恵みを施すことを喜びとし、心をつくし、精神をつくし、真実をもって彼らをこの地に植える。"},{"ref":"Jer.32.42","start":24032042,"end":24032042,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"おお"],[21,1,"おお"],[24,1,"わざわい"],[28,1,"たみ"],[30,1,"くだ"],[41,1,"かれ"],[44,2,"やくそく"],[53,1,"さいわい"],[55,1,"かれ"],[58,1,"うえ"],[60,1,"くだ"]],"text":"主はこう仰せられる、わたしがこのもろもろの大きな災をこの民に下したように、わたしが彼らに約束するもろもろの幸を彼らの上に下す。"},{"ref":"Jer.32.43","start":24032043,"end":24032043,"break":"none","ruby":[[0,2,"ひとびと"],[5,1,"ち"],[7,1,"はたけ"],[9,1,"か"],[28,1,"あ"],[31,1,"ひと"],[33,1,"けもの"],[48,1,"て"],[50,1,"わた"],[64,1,"ち"]],"text":"人々はこの地に畑を買うようになる。あなたがたが、『それは荒れて人も獣もいなくなり、カルデヤびとの手に渡されてしまう』といっている地である。"},{"ref":"Jer.32.44","start":24032044,"end":24032044,"break":"none","ruby":[[0,2,"ひとびと"],[9,1,"ち"],[18,2,"しゅうい"],[25,2,"まちまち"],[29,2,"さんち"],[32,2,"まちまち"],[36,2,"へいち"],[39,2,"まちまち"],[47,2,"まちまち"],[51,1,"ぎん"],[56,1,"はたけ"],[58,1,"か"],[61,2,"しょうしょ"],[72,2,"きめい"],[75,2,"ふういん"],[81,2,"しょうにん"],[84,1,"た"],[96,1,"かれ"],[99,1,"ふたた"],[101,1,"さか"],[112,1,"しゅ"],[114,1,"い"]],"text":"人々はベニヤミンの地と、エルサレムの周囲と、ユダの町々と、山地の町々と、平地の町々と、ネゲブの町々で、銀をもって畑を買い、証書をつくって、これに記名し封印し、また証人を立てる。それは、わたしが彼らを再び栄えさせるからであると主は言われる」。"}]