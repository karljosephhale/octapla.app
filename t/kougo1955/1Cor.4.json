[{"ref":"1Cor.4.1","start":46004001,"end":46004001,"break":"paragraph","ruby":[[11,1,"ひと"],[25,1,"つか"],[28,1,"もの"],[30,1,"かみ"],[32,2,"おくぎ"],[35,2,"かんり"],[41,1,"もの"],[43,1,"み"]],"text":"このようなわけだから、人はわたしたちを、キリストに仕える者、神の奥義を管理している者と見るがよい。"},{"ref":"1Cor.4.2","start":46004002,"end":46004002,"break":"none","ruby":[[2,2,"ばあい"],[5,3,"かんりしゃ"],[9,2,"ようきゅう"],[19,2,"ちゅうじつ"]],"text":"この場合、管理者に要求されているのは、忠実であることである。"},{"ref":"1Cor.4.3","start":46004003,"end":46004003,"break":"none","ruby":[[17,2,"にんげん"],[20,2,"さいばん"],[36,1,"い"],[38,1,"かい"],[50,2,"じぶん"]],"text":"わたしはあなたがたにさばかれたり、人間の裁判にかけられたりしても、なんら意に介しない。いや、わたしは自分をさばくこともしない。"},{"ref":"1Cor.4.4","start":46004004,"end":46004004,"break":"none","ruby":[[4,1,"みずか"],[6,1,"かえり"],[27,1,"ぎ"],[52,1,"しゅ"]],"text":"わたしは自ら省みて、なんらやましいことはないが、それで義とされているわけではない。わたしをさばくかたは、主である。"},{"ref":"1Cor.4.5","start":46004005,"end":46004005,"break":"none","ruby":[[4,1,"しゅ"],[14,2,"なにごと"],[22,1,"さき"],[23,1,"ばし"],[38,1,"しゅ"],[40,1,"くら"],[42,1,"なか"],[44,1,"かく"],[52,1,"あか"],[56,1,"だ"],[59,1,"こころ"],[61,1,"なか"],[63,1,"くわだ"],[88,1,"とき"],[92,1,"かみ"],[103,1,"う"]],"text":"だから、主がこられるまでは、何事についても、先走りをしてさばいてはいけない。主は暗い中に隠れていることを明るみに出し、心の中で企てられていることを、あらわにされるであろう。その時には、神からそれぞれほまれを受けるであろう。"},{"ref":"1Cor.4.6","start":46004006,"end":46004006,"break":"paragraph","ruby":[[0,2,"きょうだい"],[16,2,"じしん"],[24,1,"あ"],[29,1,"い"],[32,1,"き"],[54,1,"れい"],[68,1,"さだ"],[71,1,"こ"],[79,1,"まな"],[86,1,"ひと"],[95,1,"ひと"],[97,1,"み"],[101,1,"たか"]],"text":"兄弟たちよ。これらのことをわたし自身とアポロとに当てはめて言って聞かせたが、それはあなたがたが、わたしたちを例にとって、「しるされている定めを越えない」ことを学び、ひとりの人をあがめ、ほかの人を見さげて高ぶることのないためである。"},{"ref":"1Cor.4.7","start":46004007,"end":46004007,"break":"none","ruby":[[9,1,"えら"],[28,1,"も"],[77,1,"ほこ"]],"text":"いったい、あなたを偉くしているのは、だれなのか。あなたの持っているもので、もらっていないものがあるか。もしもらっているなら、なぜもらっていないもののように誇るのか。"},{"ref":"1Cor.4.8","start":46004008,"end":46004008,"break":"paragraph","ruby":[[10,2,"まんぷく"],[22,1,"と"],[24,1,"さか"],[38,1,"さ"],[44,1,"おう"],[57,1,"おう"],[69,1,"おも"],[94,1,"とも"],[96,1,"おう"]],"text":"あなたがたは、すでに満腹しているのだ。すでに富み栄えているのだ。わたしたちを差しおいて、王になっているのだ。ああ、王になっていてくれたらと思う。そうであったなら、わたしたちも、あなたがたと共に王になれたであろう。"},{"ref":"1Cor.4.9","start":46004009,"end":46004009,"break":"none","ruby":[[6,1,"かんが"],[10,1,"かみ"],[17,2,"しと"],[20,3,"しけいしゅう"],[28,2,"さいご"],[31,2,"しゅつじょう"],[35,1,"もの"],[39,1,"ひ"],[41,1,"だ"],[55,1,"ぜん"],[56,2,"せかい"],[60,2,"てんし"],[64,2,"ひとびと"],[68,1,"み"],[70,1,"もの"]],"text":"わたしはこう考える。神はわたしたち使徒を死刑囚のように、最後に出場する者として引き出し、こうしてわたしたちは、全世界に、天使にも人々にも見せ物にされたのだ。"},{"ref":"1Cor.4.10","start":46004010,"end":46004010,"break":"none","ruby":[[14,1,"おろ"],[17,1,"もの"],[36,1,"かしこ"],[38,1,"もの"],[52,1,"よわ"],[62,1,"つよ"],[71,1,"たっと"],[81,1,"いや"]],"text":"わたしたちはキリストのゆえに愚かな者となり、あなたがたはキリストにあって賢い者となっている。わたしたちは弱いが、あなたがたは強い。あなたがたは尊ばれ、わたしたちは卑しめられている。"},{"ref":"1Cor.4.11","start":46004011,"end":46004011,"break":"none","ruby":[[0,1,"いま"],[2,1,"いま"],[12,1,"う"],[19,1,"はだか"],[24,1,"う"],[28,1,"やど"]],"text":"今の今まで、わたしたちは飢え、かわき、裸にされ、打たれ、宿なしであり、"},{"ref":"1Cor.4.12","start":46004012,"end":46004012,"break":"none","ruby":[[0,2,"くろう"],[4,2,"じぶん"],[7,1,"て"],[9,1,"はたら"],[24,2,"しゅくふく"],[28,2,"はくがい"],[34,1,"た"],[36,1,"しの"]],"text":"苦労して自分の手で働いている。はずかしめられては祝福し、迫害されては耐え忍び、"},{"ref":"1Cor.4.13","start":46004013,"end":46004013,"break":"none","ruby":[[7,1,"やさ"],[10,2,"ことば"],[25,1,"いま"],[27,1,"いた"],[34,1,"よ"],[43,2,"にんげん"]],"text":"ののしられては優しい言葉をかけている。わたしたちは今に至るまで、この世のちりのように、人間のくずのようにされている。"},{"ref":"1Cor.4.14","start":46004014,"end":46004014,"break":"paragraph","ruby":[[12,1,"か"],[44,2,"あいじ"]],"text":"わたしがこのようなことを書くのは、あなたがたをはずかしめるためではなく、むしろ、わたしの愛児としてさとすためである。"},{"ref":"1Cor.4.15","start":46004015,"end":46004015,"break":"none","ruby":[[17,3,"よういくがかり"],[23,1,"にん"],[32,1,"ちち"],[34,1,"おお"],[57,2,"ふくいん"],[68,1,"う"]],"text":"たといあなたがたに、キリストにある養育掛が一万人あったとしても、父が多くあるのではない。キリスト・イエスにあって、福音によりあなたがたを生んだのは、わたしなのである。"},{"ref":"1Cor.4.16","start":46004016,"end":46004016,"break":"none","ruby":[[10,1,"すす"],[21,1,"もの"]],"text":"そこで、あなたがたに勧める。わたしにならう者となりなさい。"},{"ref":"1Cor.4.17","start":46004017,"end":46004017,"break":"none","ruby":[[13,1,"しゅ"],[18,1,"あい"],[21,2,"ちゅうじつ"],[28,1,"こ"],[40,1,"ところ"],[48,1,"かれ"],[67,2,"せいかつ"],[79,1,"いた"],[81,1,"ところ"],[83,2,"きょうかい"],[86,1,"おし"],[102,1,"おも"],[104,1,"おこ"]],"text":"このことのために、わたしは主にあって愛する忠実なわたしの子テモテを、あなたがたの所につかわした。彼は、キリスト・イエスにおけるわたしの生活のしかたを、わたしが至る所の教会で教えているとおりに、あなたがたに思い起させてくれるであろう。"},{"ref":"1Cor.4.18","start":46004018,"end":46004018,"break":"none","ruby":[[5,2,"ひとびと"],[19,1,"ところ"],[21,1,"く"],[34,1,"たか"]],"text":"しかしある人々は、わたしがあなたがたの所に来ることはあるまいとみて、高ぶっているということである。"},{"ref":"1Cor.4.19","start":46004019,"end":46004019,"break":"none","ruby":[[3,1,"しゅ"],[29,1,"ところ"],[31,1,"い"],[35,1,"たか"],[41,1,"もの"],[45,2,"ことば"],[54,1,"ちから"],[56,1,"み"]],"text":"しかし主のみこころであれば、わたしはすぐにでもあなたがたの所に行って、高ぶっている者たちの言葉ではなく、その力を見せてもらおう。"},{"ref":"1Cor.4.20","start":46004020,"end":46004020,"break":"none","ruby":[[0,1,"かみ"],[2,1,"くに"],[4,2,"ことば"],[11,1,"ちから"]],"text":"神の国は言葉ではなく、力である。"},{"ref":"1Cor.4.21","start":46004021,"end":46004021,"break":"none","ruby":[[11,1,"のぞ"],[33,1,"ところ"],[35,1,"ゆ"],[46,1,"あい"],[48,2,"にゅうわ"],[51,1,"こころ"],[57,1,"ゆ"]],"text":"あなたがたは、どちらを望むのか。わたしがむちをもって、あなたがたの所に行くことか、それとも、愛と柔和な心とをもって行くことであるか。"}]