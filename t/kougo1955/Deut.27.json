[{"ref":"Deut.27.1","start":5027001,"end":5027001,"break":"paragraph","ruby":[[10,2,"ちょうろう"],[16,1,"たみ"],[18,1,"めい"],[21,1,"い"],[41,1,"めい"],[48,1,"いまし"],[51,1,"まも"]],"text":"モーセとイスラエルの長老たちとは民に命じて言った、「わたしが、きょう、あなたがたに命じるすべての戒めを守りなさい。"},{"ref":"Deut.27.2","start":5027002,"end":5027002,"break":"none","ruby":[[11,1,"わた"],[18,1,"かみ"],[20,1,"しゅ"],[22,1,"たま"],[25,1,"くに"],[30,1,"とき"],[36,1,"おお"],[39,1,"いし"],[40,2,"すうこ"],[43,1,"た"],[55,1,"ぬ"]],"text":"あなたがたがヨルダンを渡ってあなたの神、主が賜わる国にはいる時、あなたは大きな石数個を立てて、それにしっくいを塗り、"},{"ref":"Deut.27.3","start":5027003,"end":5027003,"break":"none","ruby":[[7,1,"わた"],[15,2,"せんぞ"],[20,1,"かみ"],[22,1,"しゅ"],[24,2,"やくそく"],[36,1,"かみ"],[38,1,"しゅ"],[40,1,"たま"],[43,1,"ち"],[49,1,"ちち"],[51,1,"みつ"],[53,1,"なが"],[56,1,"ち"],[61,1,"とき"],[65,2,"りっぽう"],[72,2,"ことば"],[77,1,"うえ"],[79,1,"か"]],"text":"そしてあなたが渡って、あなたの先祖たちの神、主が約束されたようにあなたの神、主が賜わる地、すなわち乳と蜜の流れる地にはいる時、この律法のすべての言葉をその上に書きしるさなければならない。"},{"ref":"Deut.27.4","start":5027004,"end":5027004,"break":"none","ruby":[[17,1,"わた"],[39,1,"めい"],[46,1,"いし"],[51,1,"やま"],[53,1,"た"],[64,1,"ぬ"]],"text":"すなわち、あなたがたが、ヨルダンを渡ったならば、わたしが、きょう、あなたがたに命じるそれらの石をエバル山に立て、それにしっくいを塗らなければならない。"},{"ref":"Deut.27.5","start":5027005,"end":5027005,"break":"none","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[17,2,"さいだん"],[24,1,"いし"],[26,2,"さいだん"],[29,1,"きず"],[40,1,"てつ"],[42,1,"うつわ"],[44,1,"いし"],[46,1,"あ"]],"text":"またそこにあなたの神、主のために、祭壇、すなわち石の祭壇を築かなければならない。鉄の器を石に当てず、"},{"ref":"Deut.27.6","start":5027006,"end":5027006,"break":"none","ruby":[[0,2,"しぜん"],[6,1,"いし"],[12,1,"かみ"],[14,1,"しゅ"],[19,2,"さいだん"],[22,1,"きず"],[27,1,"うえ"],[33,1,"かみ"],[35,1,"しゅ"],[37,2,"はんさい"]],"text":"自然のままの石であなたの神、主のために祭壇を築き、その上であなたの神、主に燔祭をささげなければならない。"},{"ref":"Deut.27.7","start":5027007,"end":5027007,"break":"none","ruby":[[2,3,"しゅうおんさい"],[6,2,"ぎせい"],[16,1,"ところ"],[18,1,"た"],[25,1,"かみ"],[27,1,"しゅ"],[29,1,"まえ"],[31,1,"よろこ"],[33,1,"たの"]],"text":"また酬恩祭の犠牲をささげて、その所で食べ、あなたの神、主の前で喜び楽しまなければならない。"},{"ref":"Deut.27.8","start":5027008,"end":5027008,"break":"none","ruby":[[6,2,"りっぽう"],[13,2,"ことば"],[18,1,"いし"],[20,1,"うえ"],[22,1,"あき"],[26,1,"か"]],"text":"あなたはこの律法のすべての言葉をその石の上に明らかに書きしるさなければならない」。"},{"ref":"Deut.27.9","start":5027009,"end":5027009,"break":"paragraph","ruby":[[12,2,"さいし"],[29,2,"ひとびと"],[32,1,"い"],[44,1,"しず"],[47,1,"き"],[66,1,"かみ"],[68,1,"しゅ"],[70,1,"たみ"]],"text":"またモーセとレビびとたる祭司たちとは、イスラエルのすべての人々に言った、「イスラエルよ、静かに聞きなさい。あなたは、きょう、あなたの神、主の民となった。"},{"ref":"Deut.27.10","start":5027010,"end":5027010,"break":"none","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[13,1,"こえ"],[15,1,"き"],[17,1,"したが"],[29,1,"めい"],[32,1,"いまし"],[35,1,"さだ"],[39,1,"おこな"]],"text":"それゆえ、あなたの神、主の声に聞き従い、わたしが、きょう、命じる戒めと定めとを行わなければならない」。"},{"ref":"Deut.27.11","start":5027011,"end":5027011,"break":"paragraph","ruby":[[2,1,"ひ"],[9,1,"たみ"],[11,1,"めい"],[14,1,"い"]],"text":"その日またモーセは民に命じて言った、"},{"ref":"Deut.27.12","start":5027012,"end":5027012,"break":"none","ruby":[[12,1,"わた"],[15,1,"とき"],[17,1,"つぎ"],[19,1,"ひと"],[27,1,"やま"],[29,1,"た"],[32,1,"たみ"],[34,2,"しゅくふく"]],"text":"「あなたがたがヨルダンを渡った時、次の人たちはゲリジム山に立って民を祝福しなければならない。すなわちシメオン、レビ、ユダ、イッサカル、ヨセフおよびベニヤミン。"},{"ref":"Deut.27.13","start":5027013,"end":5027013,"break":"none","ruby":[[2,1,"つぎ"],[4,1,"ひと"],[11,1,"やま"],[13,1,"た"]],"text":"また次の人たちはエバル山に立ってのろわなければならない。すなわちルベン、ガド、アセル、ゼブルン、ダンおよびナフタリ。"},{"ref":"Deut.27.14","start":5027014,"end":5027014,"break":"none","ruby":[[8,2,"おおごえ"],[21,2,"ひとびと"],[24,1,"つ"],[27,1,"い"]],"text":"そしてレビびとは大声でイスラエルのすべての人々に告げて言わなければならない。"},{"ref":"Deut.27.15","start":5027015,"end":5027015,"break":"paragraph","ruby":[[1,2,"こうじん"],[4,1,"て"],[6,1,"さく"],[10,1,"きざ"],[13,1,"ぞう"],[18,1,"い"],[20,1,"ぞう"],[23,1,"しゅ"],[25,1,"にく"],[40,1,"つく"],[48,2,"あんち"],[52,1,"もの"],[61,1,"たみ"],[66,1,"こた"],[74,1,"い"]],"text":"『工人の手の作である刻んだ像、または鋳た像は、主が憎まれるものであるから、それを造って、ひそかに安置する者はのろわれる』。民は、みな答えてアァメンと言わなければならない。"},{"ref":"Deut.27.16","start":5027016,"end":5027016,"break":"paragraph","ruby":[[1,1,"ちち"],[3,1,"はは"],[5,1,"かろ"],[9,1,"もの"],[18,1,"たみ"],[27,1,"い"]],"text":"『父や母を軽んずる者はのろわれる』。民はみなアァメンと言わなければならない。"},{"ref":"Deut.27.17","start":5027017,"end":5027017,"break":"paragraph","ruby":[[1,2,"りんじん"],[5,2,"とち"],[8,1,"さかい"],[10,1,"うつ"],[12,1,"もの"],[21,1,"たみ"],[30,1,"い"]],"text":"『隣人との土地の境を移す者はのろわれる』。民はみなアァメンと言わなければならない。"},{"ref":"Deut.27.18","start":5027018,"end":5027018,"break":"paragraph","ruby":[[1,2,"もうじん"],[4,1,"みち"],[6,1,"まよ"],[9,1,"もの"],[18,1,"たみ"],[27,1,"い"]],"text":"『盲人を道に迷わす者はのろわれる』。民はみなアァメンと言わなければならない。"},{"ref":"Deut.27.19","start":5027019,"end":5027019,"break":"paragraph","ruby":[[1,2,"きりゅう"],[4,2,"たこく"],[6,1,"じん"],[8,2,"こじ"],[11,2,"かふ"],[18,1,"ま"],[21,1,"もの"],[30,1,"たみ"],[39,1,"い"]],"text":"『寄留の他国人や孤児、寡婦のさばきを曲げる者はのろわれる』。民はみなアァメンと言わなければならない。"},{"ref":"Deut.27.20","start":5027020,"end":5027020,"break":"paragraph","ruby":[[1,1,"ちち"],[3,1,"つま"],[5,1,"おか"],[7,1,"もの"],[10,1,"ちち"],[12,1,"は"],[31,1,"たみ"],[40,1,"い"]],"text":"『父の妻を犯す者は、父を恥ずかしめるのであるからのろわれる』。民はみなアァメンと言わなければならない。"},{"ref":"Deut.27.21","start":5027021,"end":5027021,"break":"paragraph","ruby":[[4,1,"けもの"],[6,1,"おか"],[8,1,"もの"],[17,1,"たみ"],[26,1,"い"]],"text":"『すべて獣を犯す者はのろわれる』。民はみなアァメンと言わなければならない。"},{"ref":"Deut.27.22","start":5027022,"end":5027022,"break":"paragraph","ruby":[[1,1,"ちち"],[3,1,"むすめ"],[8,1,"はは"],[10,1,"むすめ"],[14,2,"じぶん"],[17,2,"しまい"],[20,1,"おか"],[22,1,"もの"],[31,1,"たみ"],[40,1,"い"]],"text":"『父の娘、または母の娘である自分の姉妹を犯す者はのろわれる』。民はみなアァメンと言わなければならない。"},{"ref":"Deut.27.23","start":5027023,"end":5027023,"break":"paragraph","ruby":[[1,1,"つま"],[3,1,"はは"],[5,1,"おか"],[7,1,"もの"],[16,1,"たみ"],[25,1,"い"]],"text":"『妻の母を犯す者はのろわれる』。民はみなアァメンと言わなければならない。"},{"ref":"Deut.27.24","start":5027024,"end":5027024,"break":"paragraph","ruby":[[5,2,"りんじん"],[8,1,"う"],[10,1,"ころ"],[12,1,"もの"],[21,1,"たみ"],[30,1,"い"]],"text":"『ひそかに隣人を撃ち殺す者はのろわれる』。民はみなアァメンと言わなければならない。"},{"ref":"Deut.27.25","start":5027025,"end":5027025,"break":"paragraph","ruby":[[6,1,"と"],[9,1,"つみ"],[12,1,"もの"],[14,1,"ころ"],[16,1,"もの"],[25,1,"たみ"],[34,1,"い"]],"text":"『まいないを取って罪なき者を殺す者はのろわれる』。民はみなアァメンと言わなければならない。"},{"ref":"Deut.27.26","start":5027026,"end":5027026,"break":"paragraph","ruby":[[3,2,"りっぽう"],[6,2,"ことば"],[9,1,"まも"],[11,1,"おこな"],[15,1,"もの"],[24,1,"たみ"],[33,1,"い"]],"text":"『この律法の言葉を守り行わない者はのろわれる』。民はみなアァメンと言わなければならない。"}]