[{"ref":"Isa.10.1","start":23010001,"end":23010001,"break":"paragraph","breaks":[[9,"line"]],"ruby":[[9,2,"ふぎ"],[12,2,"はんけつ"],[15,1,"くだ"],[17,1,"もの"],[19,2,"ぼうぎゃく"],[22,2,"せんこく"],[25,1,"か"],[30,1,"もの"]],"text":"わざわいなるかな、不義の判決を下す者、暴虐の宣告を書きしるす者。"},{"ref":"Isa.10.2","start":23010002,"end":23010002,"break":"line","breaks":[[17,"line"],[35,"line"]],"ruby":[[0,1,"かれ"],[3,1,"とぼ"],[6,1,"もの"],[8,1,"うった"],[11,1,"ひ"],[13,1,"う"],[19,1,"たみ"],[24,1,"まず"],[27,1,"もの"],[29,2,"けんり"],[35,2,"かふ"],[38,2,"しさん"],[41,1,"うば"]],"text":"彼らは乏しい者の訴えを引き受けず、わが民のうちの貧しい者の権利をはぎ、寡婦の資産を奪い、みなしごのものをかすめる。"},{"ref":"Isa.10.3","start":23010003,"end":23010003,"break":"line","breaks":[[16,"line"],[27,"line"],[39,"line"],[50,"line"],[64,"line"],[80,"line"]],"ruby":[[6,2,"けいばつ"],[9,1,"ひ"],[16,1,"なに"],[27,2,"おおかぜ"],[30,1,"とお"],[34,1,"く"],[39,1,"なに"],[67,1,"たす"],[70,1,"もと"],[92,1,"とみ"],[94,1,"のこ"]],"text":"あなたがたは刑罰の日がきたなら、何をしようとするのか。大風が遠くから来るとき、何をしようとするのか。あなたがたはのがれていって、だれに助けを求めようとするのか。また、どこにあなたがたの富を残そうとするのか。"},{"ref":"Isa.10.4","start":23010004,"end":23010004,"break":"line","breaks":[[14,"line"],[31,"line"],[44,"line"]],"ruby":[[2,1,"とら"],[6,1,"もの"],[8,1,"なか"],[14,1,"ころ"],[18,1,"もの"],[20,1,"なか"],[22,1,"ふ"],[24,1,"たお"],[35,1,"しゅ"],[37,1,"いか"],[51,1,"て"],[53,1,"の"]],"text":"ただ捕われた者の中にかがみ、殺された者の中に伏し倒れるのみだ。それでも主の怒りはやまず、なおも、そのみ手を伸ばされる。"},{"ref":"Isa.10.5","start":23010005,"end":23010005,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[11,1,"いか"],[19,1,"いきどお"]],"text":"ああ、アッスリヤはわが怒りのつえ、わが憤りのむちだ。"},{"ref":"Isa.10.6","start":23010006,"end":23010006,"break":"line","breaks":[[19,"line"],[41,"line"]],"ruby":[[4,1,"かれ"],[11,2,"ふしん"],[14,1,"くに"],[16,1,"せ"],[19,1,"かれ"],[21,1,"めい"],[26,1,"いか"],[29,1,"たみ"],[31,1,"せ"],[37,1,"うば"],[41,1,"かれ"],[48,1,"どろ"],[53,1,"ふ"]],"text":"わたしは彼をつかわして不信の国を攻め、彼に命じてわが怒りの民を攻め、かすめ奪わせ、彼らをちまたの泥のように踏みにじらせる。"},{"ref":"Isa.10.7","start":23010007,"end":23010007,"break":"line","breaks":[[15,"line"],[29,"line"],[46,"line"]],"ruby":[[3,1,"かれ"],[11,1,"おも"],[17,1,"こころ"],[25,1,"かんが"],[35,1,"こころ"],[37,1,"ほろ"],[43,1,"おも"],[50,2,"くにぐに"],[53,1,"たお"]],"text":"しかし彼はそのようには思わず、その心もそのようには考えず、かえってその心は滅ぼすことを思い、あまたの国々を倒そうとする。"},{"ref":"Isa.10.8","start":23010008,"end":23010008,"break":"line","ruby":[[0,1,"かれ"],[2,1,"い"],[8,2,"しょこう"],[13,1,"おう"]],"text":"彼は言う、「わが諸侯はみな王ではないか。"},{"ref":"Isa.10.9","start":23010009,"end":23010009,"break":"line","breaks":[[18,"line"],[35,"line"]],"text":"カルノはカルケミシのようではないか。ハマテはアルパデのようではないか。サマリヤはダマスコのようではないか。"},{"ref":"Isa.10.10","start":23010010,"end":23010010,"break":"line","breaks":[[17,"line"],[32,"line"]],"ruby":[[2,1,"て"],[4,2,"ぐうぞう"],[7,1,"つか"],[10,2,"くにぐに"],[13,1,"の"],[19,1,"ほ"],[22,1,"ぞう"]],"text":"わが手は偶像に仕える国々に伸びた。その彫った像はエルサレムおよびサマリヤのものにまさっていた。"},{"ref":"Isa.10.11","start":23010011,"end":23010011,"break":"line","breaks":[[21,"line"]],"ruby":[[11,2,"ぐうぞう"],[14,1,"おこな"],[29,2,"ぐうぞう"],[32,1,"おこな"]],"text":"わたしはサマリヤとその偶像に行ったように、エルサレムとその偶像に行わぬであろうか」。"},{"ref":"Isa.10.12","start":23010012,"end":23010012,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"やま"],[32,1,"と"],[37,1,"とき"],[39,1,"しゅ"],[46,1,"おう"],[48,2,"ぶれい"],[51,2,"ことば"],[57,1,"たか"],[62,1,"ばっ"]],"text":"主がシオンの山とエルサレムとになそうとすることを、ことごとくなし遂げられた時、主はアッスリヤ王の無礼な言葉と、その高ぶりとを罰せられる。"},{"ref":"Isa.10.13","start":23010013,"end":23010013,"break":"none","breaks":[[5,"stanza"],[26,"line"],[49,"line"],[65,"line"],[74,"line"],[87,"line"]],"ruby":[[0,1,"かれ"],[2,1,"い"],[8,1,"て"],[10,1,"ちから"],[19,2,"ちえ"],[41,1,"かしこ"],[58,1,"たみ"],[60,1,"さかい"],[62,1,"のぞ"],[67,2,"ざいほう"],[70,1,"うば"],[80,2,"おうし"],[87,1,"くらい"],[89,1,"ざ"],[92,1,"もの"],[94,1,"ひ"]],"text":"彼は言う、「わが手の力により、またわが知恵によって、わたしはこれをなした。わたしは賢いからである。わたしはもろもろの民の境を除き、その財宝を奪った。またわたしは雄牛のように、位に座する者を引きおろした。"},{"ref":"Isa.10.14","start":23010014,"end":23010014,"break":"line","breaks":[[12,"line"],[24,"line"],[47,"line"],[56,"line"],[75,"line"]],"ruby":[[2,1,"て"],[4,1,"す"],[6,1,"と"],[17,1,"たみ"],[19,1,"とみ"],[21,1,"え"],[30,2,"ひとびと"],[33,1,"す"],[38,1,"たまご"],[40,1,"あつ"],[47,1,"ぜん"],[48,1,"ち"],[50,1,"と"],[52,1,"あつ"],[60,1,"つばさ"],[62,1,"うご"],[70,1,"くち"],[72,1,"ひら"],[85,1,"い"],[87,1,"もの"]],"text":"わが手は巣を取るように、もろもろの民の富を得た。またわたしは人々が捨てられた卵を集めるように、全地を取り集めた。あるいは翼を動かし、あるいは口を開き、あるいはぺちゃくちゃ言う者もなかった」。"},{"ref":"Isa.10.15","start":23010015,"end":23010015,"break":"paragraph","breaks":[[19,"line"],[33,"line"],[52,"line"],[68,"line"],[91,"line"]],"ruby":[[7,1,"もち"],[10,1,"き"],[12,1,"もの"],[19,2,"じぶん"],[22,1,"ほこ"],[42,1,"うご"],[45,1,"もの"],[56,1,"たか"],[79,2,"じぶん"],[85,1,"もの"],[87,1,"うご"],[94,1,"き"],[98,1,"もの"],[109,1,"ひと"]],"text":"おのは、それを用いて切る者にむかって、自分を誇ることができようか。のこぎりは、それを動かす者にむかって、みずから高ぶることができようか。これはあたかも、むちが自分をあげる者を動かし、つえが木でない者をあげようとするのに等しい。"},{"ref":"Isa.10.16","start":23010016,"end":23010016,"break":"line","breaks":[[13,"line"],[34,"line"]],"ruby":[[5,1,"しゅ"],[7,2,"ばんぐん"],[10,1,"しゅ"],[15,1,"こ"],[18,2,"ゆうし"],[21,1,"なか"],[23,2,"びょうき"],[26,1,"おく"],[29,1,"おとろ"],[36,2,"えいこう"],[39,1,"した"],[41,1,"ひ"],[43,1,"も"],[49,1,"ほのお"],[51,1,"も"]],"text":"それゆえ、主、万軍の主は、その肥えた勇士の中に病気を送って衰えさせ、その栄光の下に火の燃えるような炎を燃やされる。"},{"ref":"Isa.10.17","start":23010017,"end":23010017,"break":"line","breaks":[[13,"line"],[23,"line"]],"ruby":[[6,1,"ひかり"],[8,1,"ひ"],[15,2,"せいじゃ"],[18,1,"ほのお"],[36,1,"にち"],[41,1,"や"],[43,1,"ほろ"]],"text":"イスラエルの光は火となり、その聖者は炎となり、そのいばらと、おどろとを一日のうちに焼き滅ぼす。"},{"ref":"Isa.10.18","start":23010018,"end":23010018,"break":"line","breaks":[[18,"line"],[34,"line"]],"ruby":[[5,1,"はやし"],[7,1,"つち"],[8,1,"こ"],[11,2,"たはた"],[14,1,"さか"],[18,1,"たましい"],[30,1,"ほろ"],[34,1,"や"],[37,1,"もの"],[41,1,"おとろ"],[44,1,"とき"]],"text":"また、その林と土肥えた田畑の栄えを、魂も、からだも二つながら滅ぼし、病める者のやせ衰える時のようにされる。"},{"ref":"Isa.10.19","start":23010019,"end":23010019,"break":"line","breaks":[[20,"line"]],"ruby":[[2,1,"はやし"],[4,1,"き"],[6,1,"のこ"],[27,1,"か"]],"text":"その林の木の残りのものはわずかであって、わらべもそれを書きとめることができる。"},{"ref":"Isa.10.20","start":23010020,"end":23010020,"break":"paragraph","ruby":[[2,1,"ひ"],[11,1,"のこ"],[14,1,"もの"],[21,1,"いえ"],[23,1,"い"],[25,1,"のこ"],[28,1,"もの"],[35,2,"じぶん"],[40,1,"う"],[43,1,"もの"],[50,2,"まごころ"],[62,2,"せいじゃ"],[65,1,"しゅ"]],"text":"その日にはイスラエルの残りの者と、ヤコブの家の生き残った者とは、もはや自分たちを撃った者にたよらず、真心をもってイスラエルの聖者、主にたより、"},{"ref":"Isa.10.21","start":23010021,"end":23010021,"break":"none","ruby":[[0,1,"のこ"],[3,1,"もの"],[13,1,"のこ"],[16,1,"もの"],[18,2,"たいのう"],[21,1,"かみ"],[23,1,"かえ"]],"text":"残りの者、すなわちヤコブの残りの者は大能の神に帰る。"},{"ref":"Isa.10.22","start":23010022,"end":23010022,"break":"none","ruby":[[4,1,"たみ"],[11,1,"うみ"],[13,1,"すな"],[28,1,"のこ"],[31,1,"もの"],[35,1,"かえ"],[38,1,"く"],[41,1,"ほろ"],[47,1,"さだ"],[51,1,"ぎ"]],"text":"あなたの民イスラエルは海の砂のようであっても、そのうちの残りの者だけが帰って来る。滅びはすでに定まり、義であふれている。"},{"ref":"Isa.10.23","start":23010023,"end":23010023,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ばんぐん"],[5,1,"しゅ"],[7,1,"さだ"],[12,1,"ほろ"],[15,1,"ぜん"],[16,1,"ち"],[18,1,"おこな"]],"text":"主、万軍の主は定められた滅びを全地に行われる。"},{"ref":"Isa.10.24","start":23010024,"end":23010024,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,2,"ばんぐん"],[10,1,"しゅ"],[14,1,"い"],[24,1,"す"],[28,1,"たみ"],[63,1,"う"],[81,1,"かれ"],[84,1,"おそ"]],"text":"それゆえ、主、万軍の主はこう言われる、「シオンに住むわが民よ、アッスリヤびとが、エジプトびとがしたように、むちをもってあなたを打ち、つえをあげてあなたをせめても、彼らを恐れてはならない。"},{"ref":"Isa.10.25","start":23010025,"end":23010025,"break":"none","ruby":[[11,1,"いきどお"],[19,1,"いか"],[22,1,"かれ"],[25,1,"ほろ"]],"text":"ただしばらくして、わが憤りはやみ、わが怒りは彼らを滅ぼすからである。"},{"ref":"Isa.10.26","start":23010026,"end":23010026,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[20,1,"いわ"],[22,1,"う"],[26,1,"とき"],[32,1,"かれ"],[56,1,"うみ"],[58,1,"うえ"]],"text":"万軍の主は、むかしミデアンびとをオレブの岩で撃たれた時のように、彼らにむかって、むちをふるわれる。またそのつえを海の上にのばし、エジプトでなされたように、それをあげられる。"},{"ref":"Isa.10.27","start":23010027,"end":23010027,"break":"none","breaks":[[39,"stanza"]],"ruby":[[2,1,"ひ"],[6,1,"かれ"],[8,2,"おもに"],[15,1,"かた"],[21,1,"かれ"],[31,1,"くび"],[34,1,"はな"],[39,1,"かれ"],[47,1,"のぼ"]],"text":"その日には、彼の重荷はあなたの肩からおり、彼のくびきはあなたの首から離れる」。彼はリンモンから上り、"},{"ref":"Isa.10.28","start":23010028,"end":23010028,"break":"line","breaks":[[17,"line"]],"ruby":[[14,1,"す"],[24,2,"こうり"]],"text":"アイアテにきたり、ミグロンを過ぎ、ミクマシでその行李をとどめ、"},{"ref":"Isa.10.29","start":23010029,"end":23010029,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"わた"],[3,1,"す"],[10,1,"やど"],[29,1,"に"],[31,1,"さ"]],"text":"渡しを過ぎて、ゲバに宿る。ラマはおののき、サウルのギベアは逃げ去った。"},{"ref":"Isa.10.30","start":23010030,"end":23010030,"break":"line","breaks":[[15,"line"],[26,"line"]],"ruby":[[4,1,"むすめ"],[7,1,"こえ"],[12,1,"さけ"],[20,1,"みみ"],[22,1,"かたむ"],[32,1,"かれ"],[34,1,"こた"]],"text":"ガリムの娘よ、声をあげて叫べ。ライシよ、耳を傾けよ。アナトテよ、彼に答えよ。"},{"ref":"Isa.10.31","start":23010031,"end":23010031,"break":"line","ruby":[[5,1,"に"],[7,1,"さ"],[14,1,"たみ"],[16,1,"かく"],[18,1,"ば"],[20,1,"もと"]],"text":"マデメナは逃げ去り、ゲビムの民は隠れ場を求めた。"},{"ref":"Isa.10.32","start":23010032,"end":23010032,"break":"line","breaks":[[15,"line"],[36,"line"]],"ruby":[[2,1,"ひ"],[3,1,"かれ"],[8,1,"た"],[19,1,"むすめ"],[21,1,"やま"],[29,1,"おか"],[38,1,"て"],[40,1,"ふ"]],"text":"この日彼はノブに立ちとどまり、シオンの娘の山、エルサレムの丘にむかって、その手を振る。"},{"ref":"Isa.10.33","start":23010033,"end":23010033,"break":"paragraph","breaks":[[11,"line"],[30,"line"],[44,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,2,"ばんぐん"],[8,1,"しゅ"],[11,1,"おそ"],[15,1,"ちから"],[20,1,"えだ"],[22,1,"き"],[33,1,"たか"],[38,1,"き"],[40,1,"おと"],[47,1,"た"],[52,1,"ひく"]],"text":"見よ、主、万軍の主は、恐ろしい力をもって枝を切りおろされる。たけの高いものも切り落され、そびえ立つものは低くされる。"},{"ref":"Isa.10.34","start":23010034,"end":23010034,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"しげ"],[12,1,"はやし"],[14,1,"き"],[23,1,"き"],[25,1,"しげ"],[32,1,"たお"]],"text":"主はおのをもって茂りあう林を切られる。みごとな木の茂るレバノンも倒される。"}]