[{"ref":"Deut.23.1","start":5023001,"end":5023001,"break":"paragraph","ruby":[[3,2,"きょせい"],[7,2,"だんし"],[10,1,"しゅ"],[12,2,"かいしゅう"],[15,1,"くわ"]],"text":"すべて去勢した男子は主の会衆に加わってはならない。"},{"ref":"Deut.23.2","start":5023002,"end":5023002,"break":"paragraph","ruby":[[0,3,"しせいじ"],[4,1,"しゅ"],[6,2,"かいしゅう"],[9,1,"くわ"],[21,2,"しそん"],[25,1,"だい"],[29,1,"しゅ"],[31,2,"かいしゅう"],[34,1,"くわ"]],"text":"私生児は主の会衆に加わってはならない。その子孫は十代までも主の会衆に加わってはならない。"},{"ref":"Deut.23.3","start":5023003,"end":5023003,"break":"paragraph","ruby":[[13,1,"しゅ"],[15,2,"かいしゅう"],[18,1,"くわ"],[28,1,"かれ"],[31,2,"しそん"],[35,1,"だい"],[45,1,"しゅ"],[47,2,"かいしゅう"],[50,1,"くわ"]],"text":"アンモンびととモアブびとは主の会衆に加わってはならない。彼らの子孫は十代までも、いつまでも主の会衆に加わってはならない。"},{"ref":"Deut.23.4","start":5023004,"end":5023004,"break":"none","ruby":[[15,1,"で"],[19,1,"とき"],[22,1,"かれ"],[28,1,"みず"],[30,1,"たずさ"],[39,1,"みち"],[41,1,"むか"],[64,1,"こ"],[69,1,"やと"]],"text":"これはあなたがたがエジプトから出てきた時に、彼らがパンと水を携えてあなたがたを道に迎えず、アラム・ナハライムのペトルからベオルの子バラムを雇って、あなたをのろわせようとしたからである。"},{"ref":"Deut.23.5","start":5023005,"end":5023005,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[16,1,"い"],[21,1,"き"],[33,1,"かみ"],[35,1,"しゅ"],[51,1,"か"],[55,2,"しゅくふく"],[66,1,"かみ"],[68,1,"しゅ"],[74,1,"あい"]],"text":"しかし、あなたの神、主はバラムの言うことを聞こうともせず、あなたの神、主はあなたのために、そののろいを変えて、祝福とされた。あなたの神、主があなたを愛されたからである。"},{"ref":"Deut.23.6","start":5023006,"end":5023006,"break":"none","ruby":[[4,2,"いっしょう"],[11,1,"かれ"],[17,2,"へいあん"],[22,2,"こうふく"],[26,1,"もと"]],"text":"あなたは一生いつまでも彼らのために平安をも、幸福をも求めてはならない。"},{"ref":"Deut.23.7","start":5023007,"end":5023007,"break":"paragraph","ruby":[[10,1,"にく"],[19,1,"かれ"],[25,2,"きょうだい"],[43,1,"にく"],[61,1,"くに"],[63,3,"きりゅうしゃ"]],"text":"あなたはエドムびとを憎んではならない。彼はあなたの兄弟だからである。またエジプトびとを憎んではならない。あなたはかつてその国の寄留者であったからである。"},{"ref":"Deut.23.8","start":5023008,"end":5023008,"break":"none","ruby":[[3,1,"かれ"],[6,1,"う"],[9,1,"こ"],[14,1,"だい"],[15,1,"め"],[19,1,"しゅ"],[21,2,"かいしゅう"],[24,1,"くわ"]],"text":"そして彼らが産んだ子どもは三代目には、主の会衆に加わることができる。"},{"ref":"Deut.23.9","start":5023009,"end":5023009,"break":"paragraph","ruby":[[0,1,"てき"],[2,1,"せ"],[8,1,"で"],[10,2,"じんえい"],[15,1,"とき"],[22,1,"けが"],[25,1,"もの"],[27,1,"さ"]],"text":"敵を攻めるために出て陣営におる時は、すべての汚れた物を避けなければならない。"},{"ref":"Deut.23.10","start":5023010,"end":5023010,"break":"paragraph","ruby":[[10,1,"よる"],[12,1,"おも"],[18,1,"こと"],[23,1,"み"],[25,1,"けが"],[28,1,"ひと"],[36,2,"じんえい"],[39,1,"そと"],[41,1,"で"],[51,2,"じんえい"],[54,1,"うち"]],"text":"あなたがたのうちに、夜の思いがけない事によって身の汚れた人があるならば、陣営の外に出なければならない。陣営の内に、はいってはならない。"},{"ref":"Deut.23.11","start":5023011,"end":5023011,"break":"none","ruby":[[4,2,"ゆうがた"],[11,1,"みず"],[13,1,"み"],[15,1,"あら"],[18,1,"ひ"],[20,1,"ぼっ"],[23,1,"のち"],[25,2,"じんえい"],[28,1,"うち"]],"text":"しかし、夕方になって、水で身を洗い、日が没して後、陣営の内に、はいることができる。"},{"ref":"Deut.23.12","start":5023012,"end":5023012,"break":"paragraph","ruby":[[6,2,"じんえい"],[9,1,"そと"],[14,1,"ところ"],[16,1,"もう"],[23,1,"よう"],[27,1,"とき"],[32,1,"で"],[34,1,"い"]],"text":"あなたはまた陣営の外に一つの所を設けておいて、用をたす時、そこに出て行かなければならない。"},{"ref":"Deut.23.13","start":5023013,"end":5023013,"break":"none","ruby":[[2,2,"ぶき"],[5,1,"とも"],[11,1,"そな"],[14,1,"そと"],[16,1,"で"],[22,1,"とき"],[30,1,"つち"],[32,1,"ほ"],[35,1,"む"],[42,1,"で"],[44,1,"もの"]],"text":"また武器と共に、くわを備え、外に出て、かがむ時、それをもって土を掘り、向きをかえて、出た物をおおわなければならない。"},{"ref":"Deut.23.14","start":5023014,"end":5023014,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[12,1,"すく"],[15,1,"てき"],[27,2,"じんえい"],[30,1,"なか"],[32,1,"あゆ"],[45,2,"じんえい"],[48,1,"せい"],[51,1,"ところ"],[55,1,"たも"],[66,1,"しゅ"],[79,1,"もの"],[85,1,"み"],[88,1,"はな"],[90,1,"さ"]],"text":"あなたの神、主があなたを救い、敵をあなたにわたそうと、陣営の中を歩まれるからである。ゆえに陣営は聖なる所として保たなければならない。主があなたのうちにきたない物のあるのを見て、離れ去られることのないためである。"},{"ref":"Deut.23.15","start":5023015,"end":5023015,"break":"paragraph","ruby":[[0,2,"しゅじん"],[3,1,"さ"],[15,1,"に"],[20,2,"どれい"],[26,2,"しゅじん"]],"text":"主人を避けて、あなたのところに逃げてきた奴隷を、その主人にわたしてはならない。"},{"ref":"Deut.23.16","start":5023016,"end":5023016,"break":"none","ruby":[[2,1,"もの"],[18,1,"とも"],[24,1,"まち"],[32,1,"かれ"],[34,1,"この"],[37,1,"えら"],[39,2,"ばしょ"],[42,1,"す"],[54,1,"かれ"],[56,2,"ぎゃくたい"]],"text":"その者をあなたがたのうちに、あなたと共におらせ、町の一つのうち、彼が好んで選ぶ場所に住ませなければならない。彼を虐待してはならない。"},{"ref":"Deut.23.17","start":5023017,"end":5023017,"break":"paragraph","ruby":[[6,2,"じょし"],[9,2,"しんでん"],[11,2,"しょうふ"],[31,2,"だんし"],[34,2,"しんでん"],[36,2,"だんしょう"]],"text":"イスラエルの女子は神殿娼婦となってはならない。またイスラエルの男子は神殿男娼となってはならない。"},{"ref":"Deut.23.18","start":5023018,"end":5023018,"break":"none","ruby":[[0,2,"しょうふ"],[3,1,"え"],[5,1,"あたい"],[9,2,"だんしょう"],[12,1,"あたい"],[18,1,"かみ"],[20,1,"しゅ"],[22,1,"いえ"],[24,1,"たずさ"],[27,1,"い"],[34,2,"せいがん"],[38,1,"もち"],[57,1,"かみ"],[59,1,"しゅ"],[61,1,"にく"]],"text":"娼婦の得た価または男娼の価をあなたの神、主の家に携えて行って、どんな誓願にも用いてはならない。これはともにあなたの神、主の憎まれるものだからである。"},{"ref":"Deut.23.19","start":5023019,"end":5023019,"break":"paragraph","ruby":[[0,2,"きょうだい"],[3,2,"りそく"],[6,1,"と"],[9,1,"か"],[18,2,"きんせん"],[21,2,"りそく"],[24,2,"しょくもつ"],[27,2,"りそく"],[34,1,"か"],[37,2,"りそく"],[42,1,"もの"],[44,2,"りそく"],[47,1,"と"]],"text":"兄弟に利息を取って貸してはならない。金銭の利息、食物の利息などすべて貸して利息のつく物の利息を取ってはならない。"},{"ref":"Deut.23.20","start":5023020,"end":5023020,"break":"none","ruby":[[0,2,"がいこく"],[2,1,"じん"],[5,2,"りそく"],[8,1,"と"],[11,1,"か"],[20,2,"きょうだい"],[24,2,"りそく"],[27,1,"と"],[30,1,"か"],[51,1,"と"],[53,1,"ち"],[60,1,"かみ"],[62,1,"しゅ"],[73,1,"こと"],[75,2,"しゅくふく"],[78,1,"あた"]],"text":"外国人には利息を取って貸してもよい。ただ兄弟には利息を取って貸してはならない。これはあなたが、はいって取る地で、あなたの神、主がすべてあなたのする事に祝福を与えられるためである。"},{"ref":"Deut.23.21","start":5023021,"end":5023021,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,2,"せいがん"],[14,1,"とき"],[19,1,"はた"],[24,1,"おこた"],[37,1,"かみ"],[39,1,"しゅ"],[41,1,"かなら"],[50,1,"もと"],[64,1,"おこた"],[69,1,"つみ"],[71,1,"え"]],"text":"あなたの神、主に誓願をかける時、それを果すことを怠ってはならない。あなたの神、主は必ずそれをあなたに求められるからである。それを怠るときは罪を得るであろう。"},{"ref":"Deut.23.22","start":5023022,"end":5023022,"break":"none","ruby":[[8,2,"せいがん"],[19,1,"つみ"],[21,1,"え"]],"text":"しかし、あなたが誓願をかけないならば、罪を得ることはない。"},{"ref":"Deut.23.23","start":5023023,"end":5023023,"break":"none","ruby":[[4,1,"くち"],[6,1,"い"],[9,1,"こと"],[11,1,"まも"],[14,1,"おこな"],[29,1,"くち"],[31,2,"やくそく"],[35,1,"こと"],[42,1,"かみ"],[44,1,"しゅ"],[50,2,"じはつ"],[52,1,"まと"],[54,2,"せいがん"]],"text":"あなたが口で言った事は守って行わなければならない。あなたが口で約束した事は、あなたの神、主にあなたが自発的に誓願したのだからである。"},{"ref":"Deut.23.24","start":5023024,"end":5023024,"break":"paragraph","ruby":[[4,2,"りんじん"],[10,1,"はたけ"],[15,1,"とき"],[23,1,"こころ"],[29,1,"あ"],[34,1,"た"],[49,1,"うつわ"],[51,1,"なか"],[53,1,"と"],[55,1,"い"]],"text":"あなたが隣人のぶどう畑にはいる時、そのぶどうを心にまかせて飽きるほど食べてもよい。しかし、あなたの器の中に取り入れてはならない。"},{"ref":"Deut.23.25","start":5023025,"end":5023025,"break":"none","ruby":[[4,2,"りんじん"],[7,2,"むぎばたけ"],[13,1,"とき"],[15,1,"て"],[19,1,"ほ"],[21,1,"つ"],[24,1,"た"],[39,2,"りんじん"],[42,2,"むぎばたけ"],[48,1,"い"]],"text":"あなたが隣人の麦畑にはいる時、手でその穂を摘んで食べてもよい。しかし、あなたの隣人の麦畑にかまを入れてはならない。"}]