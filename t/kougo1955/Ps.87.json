[{"ref":"Ps.87.1","start":19087001,"end":19087001,"break":"paragraph","title":"コラの子の歌、さんび","ruby":[[0,1,"しゅ"],[2,1,"もとい"],[9,1,"みやこ"],[11,1,"せい"],[14,1,"やま"],[16,1,"うえ"],[18,1,"た"]],"titleRuby":[[3,1,"こ"],[5,1,"うた"]],"text":"主が基をすえられた都は聖なる山の上に立つ。"},{"ref":"Ps.87.2","start":19087002,"end":19087002,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[28,1,"もん"],[30,1,"あい"]],"text":"主はヤコブのすべてのすまいにまさって、シオンのもろもろの門を愛される。"},{"ref":"Ps.87.3","start":19087003,"end":19087003,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かみ"],[2,1,"みやこ"],[18,2,"えいこう"],[22,1,"こと"],[24,1,"かた"]],"text":"神の都よ、あなたについて、もろもろの栄光ある事が語られる。〔セラ"},{"ref":"Ps.87.4","start":19087004,"end":19087004,"break":"line","breaks":[[13,"line"],[28,"line"],[47,"line"]],"ruby":[[17,1,"し"],[19,1,"もの"],[24,1,"あ"],[44,1,"み"],[50,1,"もの"],[56,1,"うま"],[61,1,"い"]],"text":"わたしはラハブとバビロンをわたしを知る者のうちに挙げる。ペリシテ、ツロ、またエチオピヤを見よ。「この者はかしこに生れた」と言われる。"},{"ref":"Ps.87.5","start":19087005,"end":19087005,"break":"line","breaks":[[11,"line"],[35,"line"],[48,"line"]],"ruby":[[14,1,"もの"],[19,1,"もの"],[23,1,"なか"],[25,1,"うま"],[30,1,"い"],[37,1,"たか"],[39,1,"もの"],[48,1,"かた"],[50,1,"た"]],"text":"しかしシオンについては「この者も、かの者もその中に生れた」と言われる。いと高き者みずからシオンを堅く立てられるからである。"},{"ref":"Ps.87.6","start":19087006,"end":19087006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"たみ"],[9,2,"とうろく"],[20,1,"もの"],[26,1,"うま"]],"text":"主がもろもろの民を登録されるとき、「この者はかしこに生れた」としるされる。〔セラ"},{"ref":"Ps.87.7","start":19087007,"end":19087007,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"うた"],[2,1,"もの"],[4,1,"おど"],[6,1,"もの"],[10,1,"い"],[21,1,"いずみ"]],"text":"歌う者と踊る者はみな言う、「わがもろもろの泉はあなたのうちにある」と。"}]