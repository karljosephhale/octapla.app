[{"ref":"2Kgs.14.1","start":12014001,"end":12014001,"break":"paragraph","ruby":[[6,1,"おう"],[13,1,"こ"],[18,1,"だい"],[20,1,"ねん"],[26,1,"おう"],[31,1,"こ"],[37,1,"おう"]],"text":"イスラエルの王エホアハズの子ヨアシの第二年に、ユダの王ヨアシの子アマジヤが王となった。"},{"ref":"2Kgs.14.2","start":12014002,"end":12014002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おう"],[7,1,"とき"],[11,1,"さい"],[17,1,"ねん"],[19,1,"あいだ"],[26,1,"よ"],[28,1,"おさ"],[34,1,"はは"],[42,2,"しゅっしん"],[46,1,"な"]],"text":"彼は王となった時二十五歳で、二十九年の間エルサレムで世を治めた。その母はエルサレムの出身で、名をエホアダンといった。"},{"ref":"2Kgs.14.3","start":12014003,"end":12014003,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"め"],[12,1,"こと"],[21,2,"せんぞ"],[36,1,"かれ"],[42,1,"こと"],[44,1,"ちち"]],"text":"アマジヤは主の目にかなう事をおこなったが、先祖ダビデのようではなかった。彼はすべての事を父ヨアシがおこなったようにおこなった。"},{"ref":"2Kgs.14.4","start":12014004,"end":12014004,"break":"none","ruby":[[3,1,"たか"],[5,1,"ところ"],[7,1,"のぞ"],[16,1,"たみ"],[22,1,"たか"],[24,1,"ところ"],[26,2,"ぎせい"],[33,1,"こう"]],"text":"ただし高き所は除かなかったので、民はなおその高き所で犠牲をささげ、香をたいた。"},{"ref":"2Kgs.14.5","start":12014005,"end":12014005,"break":"none","ruby":[[0,1,"かれ"],[2,1,"くに"],[4,1,"かれ"],[6,1,"て"],[11,1,"つよ"],[16,1,"とき"],[18,1,"ちち"],[22,1,"おう"],[24,2,"さつがい"],[28,2,"けらい"],[33,1,"ころ"]],"text":"彼は国が彼の手のうちに強くなった時、父ヨアシ王を殺害した家来たちを殺したが、"},{"ref":"2Kgs.14.6","start":12014006,"end":12014006,"break":"none","ruby":[[2,3,"さつがいしゃ"],[6,2,"こども"],[11,1,"ころ"],[25,2,"りっぽう"],[28,1,"しょ"],[37,1,"ところ"],[39,1,"したが"],[51,1,"しゅ"],[53,1,"めい"],[57,1,"ちち"],[59,1,"こ"],[64,1,"ころ"],[74,1,"こ"],[76,1,"ちち"],[81,1,"ころ"],[95,2,"じぶん"],[98,1,"つみ"],[103,1,"ころ"],[113,1,"い"]],"text":"その殺害者の子供たちは殺さなかった。これはモーセの律法の書にしるされている所に従ったのであって、そこに主は命じて「父は子のゆえに殺さるべきではない。子は父のゆえに殺さるべきではない。おのおの自分の罪のゆえに殺さるべきである」と言われている。"},{"ref":"2Kgs.14.7","start":12014007,"end":12014007,"break":"paragraph","ruby":[[7,1,"しお"],[9,1,"たに"],[18,1,"にん"],[20,1,"ころ"],[29,1,"せ"],[31,1,"と"],[37,1,"な"],[44,1,"な"],[50,2,"こんにち"]],"text":"アマジヤはまた塩の谷でエドムびと一万人を殺した。またセラを攻め取って、その名をヨクテルと名づけたが、今日までそのとおりである。"},{"ref":"2Kgs.14.8","start":12014008,"end":12014008,"break":"paragraph","ruby":[[12,1,"こ"],[19,1,"こ"],[29,1,"おう"],[34,2,"ししゃ"],[52,1,"たがい"],[54,1,"かお"],[56,1,"あ"],[63,1,"い"]],"text":"そこでアマジヤがエヒウの子エホアハズの子であるイスラエルの王ヨアシに使者をつかわして、「さあ、われわれは互に顔を合わせよう」と言わせたので、"},{"ref":"2Kgs.14.9","start":12014009,"end":12014009,"break":"none","ruby":[[6,1,"おう"],[14,1,"おう"],[20,1,"い"],[22,1,"おく"],[44,2,"こうはく"],[53,1,"むすめ"],[63,1,"つま"],[71,1,"い"],[73,1,"おく"],[89,2,"やじゅう"],[103,1,"ふ"],[105,1,"たお"]],"text":"イスラエルの王ヨアシはユダの王アマジヤに言い送った、「かつてレバノンのいばらがレバノンの香柏に、『あなたの娘をわたしのむすこの妻にください』と言い送ったことがあったが、レバノンの野獣がとおって、そのいばらを踏み倒した。"},{"ref":"2Kgs.14.10","start":12014010,"end":12014010,"break":"none","ruby":[[4,1,"おお"],[11,1,"う"],[15,1,"こころ"],[28,2,"えいよ"],[31,2,"まんぞく"],[35,1,"いえ"],[45,1,"なに"],[53,1,"わざわい"],[57,1,"おこ"],[61,2,"じぶん"],[67,1,"とも"],[69,1,"ほろ"],[75,1,"こと"]],"text":"あなたは大いにエドムを撃って、心にたかぶっているが、その栄誉に満足して家にとどまりなさい。何ゆえ、あなたは災をひき起して、自分もユダも共に滅びるような事をするのですか」。"},{"ref":"2Kgs.14.11","start":12014011,"end":12014011,"break":"paragraph","ruby":[[8,1,"き"],[25,1,"おう"],[30,1,"のぼ"],[39,1,"かれ"],[44,1,"おう"],[59,1,"たがい"],[61,1,"かお"]],"text":"しかしアマジヤが聞きいれなかったので、イスラエルの王ヨアシは上ってきた。そこで彼とユダの王アマジヤはユダのベテシメシで互に顔をあわせたが、"},{"ref":"2Kgs.14.12","start":12014012,"end":12014012,"break":"none","ruby":[[9,1,"やぶ"],[20,2,"てんまく"],[23,1,"に"],[25,1,"かえ"]],"text":"ユダはイスラエルに敗られて、おのおのその天幕に逃げ帰った。"},{"ref":"2Kgs.14.13","start":12014013,"end":12014013,"break":"none","ruby":[[6,1,"おう"],[16,1,"こ"],[21,1,"こ"],[28,1,"おう"],[40,1,"とら"],[58,2,"じょうへき"],[67,1,"もん"],[70,1,"すみ"],[72,1,"もん"]],"text":"イスラエルの王ヨアシはアハジヤの子ヨアシの子であるユダの王アマジヤをベテシメシで捕え、エルサレムにきて、エルサレムの城壁をエフライムの門から隅の門まで、おおよそ四百キュビトにわたってこわし、"},{"ref":"2Kgs.14.14","start":12014014,"end":12014014,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"みや"],[6,1,"おう"],[8,1,"いえ"],[10,1,"くら"],[14,2,"きんぎん"],[24,1,"うつわ"],[31,1,"と"],[36,2,"ひとじち"],[47,1,"かえ"]],"text":"また主の宮と王の家の倉にある金銀およびもろもろの器をことごとく取り、かつ人質をとってサマリヤに帰った。"},{"ref":"2Kgs.14.15","start":12014015,"end":12014015,"break":"paragraph","ruby":[[6,1,"た"],[8,2,"じせき"],[14,2,"ぶゆう"],[19,1,"かれ"],[24,1,"おう"],[30,1,"たたか"],[33,1,"こと"],[42,1,"おう"],[44,3,"れきだいし"],[48,1,"しょ"]],"text":"ヨアシのその他の事績と、その武勇および彼がユダの王アマジヤと戦った事は、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.14.16","start":12014016,"end":12014016,"break":"none","ruby":[[6,2,"せんぞ"],[11,1,"とも"],[13,1,"ねむ"],[23,1,"おう"],[27,1,"とも"],[34,1,"ほうむ"],[40,1,"こ"],[47,1,"かわ"],[50,1,"おう"]],"text":"ヨアシはその先祖たちと共に眠って、イスラエルの王たちと共にサマリヤに葬られ、その子ヤラベアムが代って王となった。"},{"ref":"2Kgs.14.17","start":12014017,"end":12014017,"break":"paragraph","ruby":[[4,1,"こ"],[11,1,"おう"],[24,1,"こ"],[34,1,"おう"],[39,1,"し"],[42,1,"のち"],[48,1,"ねん"],[49,1,"い"]],"text":"ヨアシの子であるユダの王アマジヤは、エホアハズの子であるイスラエルの王ヨアシが死んで後、なお十五年生きながらえた。"},{"ref":"2Kgs.14.18","start":12014018,"end":12014018,"break":"none","ruby":[[7,1,"た"],[9,2,"じせき"],[16,1,"おう"],[18,3,"れきだいし"],[22,1,"しょ"]],"text":"アマジヤのその他の事績は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.14.19","start":12014019,"end":12014019,"break":"none","ruby":[[0,1,"とき"],[2,2,"ひとびと"],[11,2,"ととう"],[14,1,"むす"],[17,1,"かれ"],[19,2,"てきたい"],[26,1,"かれ"],[32,1,"に"],[42,2,"ひとびと"],[49,1,"ひと"],[56,1,"かれ"],[61,1,"ころ"]],"text":"時に人々がエルサレムで徒党を結び、彼に敵対したので、彼はラキシに逃げていったが、その人々はラキシに人をつかわして彼をそこで殺させた。"},{"ref":"2Kgs.14.20","start":12014020,"end":12014020,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"かれ"],[5,1,"うま"],[7,1,"の"],[10,1,"はこ"],[22,1,"かれ"],[24,2,"せんぞ"],[29,1,"とも"],[35,1,"まち"],[37,1,"ほうむ"]],"text":"人々は彼を馬に載せて運んできて、エルサレムで彼を先祖たちと共にダビデの町に葬った。"},{"ref":"2Kgs.14.21","start":12014021,"end":12014021,"break":"none","ruby":[[6,1,"たみ"],[8,1,"みな"],[14,1,"ちち"],[20,1,"かわ"],[23,1,"おう"],[28,1,"とき"],[30,1,"ねん"],[33,1,"さい"]],"text":"そしてユダの民は皆アザリヤを父アマジヤの代りに王とした。時に年十六歳であった。"},{"ref":"2Kgs.14.22","start":12014022,"end":12014022,"break":"none","ruby":[[0,1,"かれ"],[6,1,"まち"],[8,1,"た"],[18,2,"ふっき"],[29,1,"おう"],[33,2,"せんぞ"],[38,1,"とも"],[40,1,"ねむ"],[43,1,"のち"]],"text":"彼はエラテの町を建てて、これをユダに復帰させた。これはかの王がその先祖たちと共に眠った後であった。"},{"ref":"2Kgs.14.23","start":12014023,"end":12014023,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"こ"],[14,1,"だい"],[17,1,"ねん"],[26,1,"おう"],[31,1,"こ"],[43,1,"おう"],[51,1,"ねん"],[53,1,"あいだ"],[55,1,"よ"],[57,1,"おさ"]],"text":"ユダの王ヨアシの子アマジヤの第十五年に、イスラエルの王ヨアシの子ヤラべアムがサマリヤで王となって四十一年の間、世を治めた。"},{"ref":"2Kgs.14.24","start":12014024,"end":12014024,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[10,1,"おこな"],[19,1,"つみ"],[21,1,"おか"],[29,1,"こ"],[36,1,"つみ"],[38,1,"はな"]],"text":"彼は主の目の前に悪を行い、イスラエルに罪を犯させたネバテの子ヤラベアムの罪を離れなかった。"},{"ref":"2Kgs.14.25","start":12014025,"end":12014025,"break":"none","ruby":[[0,1,"かれ"],[6,2,"いりぐち"],[14,1,"うみ"],[24,2,"りょういき"],[27,2,"かいふく"],[38,1,"かみ"],[40,1,"しゅ"],[54,1,"こ"],[64,3,"よげんしゃ"],[73,1,"い"],[77,2,"ことば"]],"text":"彼はハマテの入口からアラバの海まで、イスラエルの領域を回復した。イスラエルの神、主がガテヘペルのアミッタイの子である、そのしもべ預言者ヨナによって言われた言葉のとおりである。"},{"ref":"2Kgs.14.26","start":12014026,"end":12014026,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"なや"],[11,2,"ひじょう"],[14,1,"はげ"],[19,1,"み"],[33,1,"もの"],[36,2,"じゆう"],[39,1,"もの"],[55,1,"たす"],[58,1,"もの"]],"text":"主はイスラエルの悩みの非常に激しいのを見られた。そこにはつながれた者も、自由な者もいなくなり、またイスラエルを助ける者もいなかった。"},{"ref":"2Kgs.14.27","start":12014027,"end":12014027,"break":"none","ruby":[[3,1,"しゅ"],[11,1,"な"],[13,1,"あめ"],[15,1,"した"],[18,1,"け"],[20,1,"さ"],[25,1,"い"],[36,1,"かれ"],[43,1,"こ"],[50,1,"て"],[55,1,"すく"]],"text":"しかし主はイスラエルの名を天が下から消し去ろうとは言われなかった。そして彼らをヨアシの子ヤラベアムの手によって救われた。"},{"ref":"2Kgs.14.28","start":12014028,"end":12014028,"break":"paragraph","ruby":[[8,1,"た"],[10,2,"じせき"],[14,1,"かれ"],[22,1,"こと"],[28,2,"ぶゆう"],[35,1,"かれ"],[37,2,"せんそう"],[42,1,"こと"],[53,1,"ぞく"],[74,2,"ふっき"],[79,1,"こと"],[88,1,"おう"],[90,3,"れきだいし"],[94,1,"しょ"]],"text":"ヤラベアムのその他の事績と、彼がしたすべての事およびその武勇、すなわち彼が戦争をした事および、かつてユダに属していたダマスコとハマテを、イスラエルに復帰させた事は、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.14.29","start":12014029,"end":12014029,"break":"none","ruby":[[8,2,"せんぞ"],[19,1,"おう"],[23,1,"とも"],[25,1,"ねむ"],[31,1,"こ"],[37,1,"かわ"],[40,1,"おう"]],"text":"ヤラベアムはその先祖であるイスラエルの王たちと共に眠って、その子ゼカリヤが代って王となった。"}]