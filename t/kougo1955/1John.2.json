[{"ref":"1John.2.1","start":62002001,"end":62002001,"break":"paragraph","ruby":[[4,1,"こ"],[16,1,"か"],[30,1,"つみ"],[32,1,"おか"],[50,1,"つみ"],[52,1,"おか"],[54,1,"もの"],[60,1,"ちち"],[77,1,"たす"],[79,1,"ぬし"],[86,1,"ぎ"]],"text":"わたしの子たちよ。これらのことを書きおくるのは、あなたがたが罪を犯さないようになるためである。もし、罪を犯す者があれば、父のみもとには、わたしたちのために助け主、すなわち、義なるイエス・キリストがおられる。"},{"ref":"1John.2.2","start":62002002,"end":62002002,"break":"none","ruby":[[0,1,"かれ"],[9,1,"つみ"],[20,1,"そな"],[22,1,"もの"],[36,1,"つみ"],[48,1,"ぜん"],[49,2,"せかい"],[52,1,"つみ"]],"text":"彼は、わたしたちの罪のための、あがないの供え物である。ただ、わたしたちの罪のためばかりではなく、全世界の罪のためである。"},{"ref":"1John.2.3","start":62002003,"end":62002003,"break":"none","ruby":[[9,1,"かれ"],[11,1,"いまし"],[14,1,"まも"],[26,1,"かれ"],[28,1,"し"],[36,1,"さと"]],"text":"もし、わたしたちが彼の戒めを守るならば、それによって彼を知っていることを悟るのである。"},{"ref":"1John.2.4","start":62002004,"end":62002004,"break":"none","ruby":[[1,1,"かれ"],[3,1,"し"],[10,1,"い"],[18,1,"いまし"],[21,1,"まも"],[25,1,"もの"],[28,1,"いつわ"],[30,1,"もの"],[36,2,"しんり"],[41,1,"ひと"]],"text":"「彼を知っている」と言いながら、その戒めを守らない者は、偽り者であって、真理はその人のうちにない。"},{"ref":"1John.2.5","start":62002005,"end":62002005,"break":"none","ruby":[[4,1,"かれ"],[6,2,"みことば"],[9,1,"まも"],[11,1,"もの"],[19,1,"ひと"],[25,1,"かみ"],[27,1,"あい"],[29,1,"しん"],[31,1,"まっと"],[54,1,"かれ"],[61,1,"し"]],"text":"しかし、彼の御言を守る者があれば、その人のうちに、神の愛が真に全うされるのである。それによって、わたしたちが彼にあることを知るのである。"},{"ref":"1John.2.6","start":62002006,"end":62002006,"break":"none","ruby":[[1,1,"かれ"],[7,1,"い"],[9,1,"もの"],[12,1,"かれ"],[14,1,"ある"],[24,1,"ひと"],[25,2,"じしん"],[28,1,"ある"]],"text":"「彼におる」と言う者は、彼が歩かれたように、その人自身も歩くべきである。"},{"ref":"1John.2.7","start":62002007,"end":62002007,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[18,1,"か"],[26,1,"あたら"],[29,1,"いまし"],[42,1,"はじ"],[46,1,"う"],[51,1,"ふる"],[53,1,"いまし"],[61,1,"ふる"],[63,1,"いまし"],[77,1,"き"],[80,2,"みことば"]],"text":"愛する者たちよ。わたしがあなたがたに書きおくるのは、新しい戒めではなく、あなたがたが初めから受けていた古い戒めである。その古い戒めとは、あなたがたがすでに聞いた御言である。"},{"ref":"1John.2.8","start":62002008,"end":62002008,"break":"none","ruby":[[4,1,"あたら"],[7,1,"いまし"],[17,1,"か"],[35,1,"かれ"],[52,2,"しんり"],[68,1,"す"],[70,1,"さ"],[77,1,"ひかり"],[82,1,"かがや"]],"text":"しかも、新しい戒めを、あなたがたに書きおくるのである。そして、それは、彼にとってもあなたがたにとっても、真理なのである。なぜなら、やみは過ぎ去り、まことの光がすでに輝いているからである。"},{"ref":"1John.2.9","start":62002009,"end":62002009,"break":"none","ruby":[[1,1,"ひかり"],[3,1,"なか"],[9,1,"い"],[17,2,"きょうだい"],[20,1,"にく"],[22,1,"もの"],[25,1,"いま"],[32,1,"なか"]],"text":"「光の中にいる」と言いながら、その兄弟を憎む者は、今なお、やみの中にいるのである。"},{"ref":"1John.2.10","start":62002010,"end":62002010,"break":"none","ruby":[[0,2,"きょうだい"],[3,1,"あい"],[6,1,"もの"],[9,1,"ひかり"]],"text":"兄弟を愛する者は、光におるのであって、つまずくことはない。"},{"ref":"1John.2.11","start":62002011,"end":62002011,"break":"none","ruby":[[0,2,"きょうだい"],[3,1,"にく"],[5,1,"もの"],[11,1,"なか"],[19,1,"なか"],[21,1,"ある"],[29,2,"じぶん"],[36,1,"い"],[49,1,"かれ"],[51,1,"め"],[53,1,"み"]],"text":"兄弟を憎む者は、やみの中におり、やみの中を歩くのであって、自分ではどこへ行くのかわからない。やみが彼の目を見えなくしたからである。"},{"ref":"1John.2.12","start":62002012,"end":62002012,"break":"paragraph","ruby":[[0,1,"こ"],[14,1,"か"],[22,2,"みな"],[35,1,"おお"],[38,1,"つみ"]],"text":"子たちよ。あなたがたにこれを書きおくるのは、御名のゆえに、あなたがたの多くの罪がゆるされたからである。"},{"ref":"1John.2.13","start":62002013,"end":62002013,"break":"none","ruby":[[0,1,"ちち"],[11,1,"か"],[26,1,"はじ"],[36,1,"し"],[45,2,"わかもの"],[57,1,"か"],[72,1,"あ"],[75,1,"もの"],[79,1,"か"]],"text":"父たちよ。あなたがたに書きおくるのは、あなたがたが、初めからいますかたを知ったからである。若者たちよ。あなたがたに書きおくるのは、あなたがたが、悪しき者にうち勝ったからである。"},{"ref":"1John.2.14","start":62002014,"end":62002014,"break":"none","ruby":[[0,2,"こども"],[12,1,"か"],[27,1,"ちち"],[29,1,"し"],[38,1,"ちち"],[49,1,"か"],[65,1,"はじ"],[75,1,"し"],[84,2,"わかもの"],[96,1,"か"],[111,1,"つよ"],[113,1,"もの"],[118,1,"かみ"],[120,1,"ことば"],[128,1,"やど"],[141,1,"あ"],[144,1,"もの"],[148,1,"か"]],"text":"子供たちよ。あなたがたに書きおくったのは、あなたがたが父を知ったからである。父たちよ。あなたがたに書きおくったのは、あなたがたが、初めからいますかたを知ったからである。若者たちよ。あなたがたに書きおくったのは、あなたがたが強い者であり、神の言があなたがたに宿り、そして、あなたがたが悪しき者にうち勝ったからである。"},{"ref":"1John.2.15","start":62002015,"end":62002015,"break":"none","ruby":[[0,1,"よ"],[2,1,"よ"],[11,1,"あい"],[23,1,"よ"],[25,1,"あい"],[28,1,"もの"],[34,1,"ちち"],[36,1,"あい"],[38,1,"かれ"]],"text":"世と世にあるものとを、愛してはいけない。もし、世を愛する者があれば、父の愛は彼のうちにない。"},{"ref":"1John.2.16","start":62002016,"end":62002016,"break":"none","ruby":[[3,1,"よ"],[15,1,"にく"],[17,1,"よく"],[19,1,"め"],[21,1,"よく"],[23,1,"も"],[25,1,"もの"],[27,1,"ほこり"],[30,1,"ちち"],[33,1,"で"],[42,1,"よ"],[45,1,"で"]],"text":"すべて世にあるもの、すなわち、肉の欲、目の欲、持ち物の誇は、父から出たものではなく、世から出たものである。"},{"ref":"1John.2.17","start":62002017,"end":62002017,"break":"none","ruby":[[0,1,"よ"],[2,1,"よ"],[4,1,"よく"],[7,1,"す"],[9,1,"さ"],[16,1,"かみ"],[18,2,"みむね"],[21,1,"おこな"],[23,1,"もの"],[26,2,"えいえん"]],"text":"世と世の欲とは過ぎ去る。しかし、神の御旨を行う者は、永遠にながらえる。"},{"ref":"1John.2.18","start":62002018,"end":62002018,"break":"paragraph","ruby":[[0,2,"こども"],[6,1,"いま"],[8,1,"おわ"],[11,1,"とき"],[25,1,"はん"],[31,1,"く"],[34,1,"き"],[43,1,"いま"],[45,1,"おお"],[48,1,"はん"],[54,1,"あらわ"],[66,1,"いま"],[68,1,"おわ"],[71,1,"とき"],[78,1,"し"]],"text":"子供たちよ。今は終りの時である。あなたがたがかねて反キリストが来ると聞いていたように、今や多くの反キリストが現れてきた。それによって今が終りの時であることを知る。"},{"ref":"1John.2.19","start":62002019,"end":62002019,"break":"none","ruby":[[0,1,"かれ"],[10,1,"で"],[12,1,"い"],[20,1,"かれ"],[29,1,"ぞく"],[32,1,"もの"],[46,1,"ぞく"],[49,1,"もの"],[63,2,"いっしょ"],[82,1,"で"],[84,1,"い"],[90,2,"がんらい"],[93,1,"かれ"],[104,1,"ぞく"],[108,1,"もの"],[116,1,"あき"]],"text":"彼らはわたしたちから出て行った。しかし、彼らはわたしたちに属する者ではなかったのである。もし属する者であったなら、わたしたちと一緒にとどまっていたであろう。しかし、出て行ったのは、元来、彼らがみなわたしたちに属さない者であることが、明らかにされるためである。"},{"ref":"1John.2.20","start":62002020,"end":62002020,"break":"none","ruby":[[10,1,"せい"],[13,1,"もの"],[15,1,"あぶら"],[17,1,"そそ"],[41,1,"し"]],"text":"しかし、あなたがたは聖なる者に油を注がれているので、あなたがたすべてが、そのことを知っている。"},{"ref":"1John.2.21","start":62002021,"end":62002021,"break":"none","ruby":[[4,1,"か"],[19,2,"しんり"],[22,1,"し"],[36,1,"し"],[54,1,"いつわ"],[57,2,"しんり"],[61,1,"で"],[72,1,"し"]],"text":"わたしが書きおくったのは、あなたがたが真理を知らないからではなく、それを知っているからであり、また、すべての偽りは真理から出るものでないことを、知っているからである。"},{"ref":"1John.2.22","start":62002022,"end":62002022,"break":"none","ruby":[[0,1,"いつわ"],[2,1,"もの"],[27,2,"ひてい"],[31,1,"もの"],[38,1,"ちち"],[40,2,"みこ"],[44,2,"ひてい"],[48,1,"もの"],[51,1,"はん"]],"text":"偽り者とは、だれであるか。イエスのキリストであることを否定する者ではないか。父と御子とを否定する者は、反キリストである。"},{"ref":"1John.2.23","start":62002023,"end":62002023,"break":"none","ruby":[[0,2,"みこ"],[3,2,"ひてい"],[7,1,"もの"],[9,1,"ちち"],[11,1,"も"],[15,2,"みこ"],[18,2,"こくはく"],[22,1,"もの"],[27,1,"ちち"],[30,1,"も"]],"text":"御子を否定する者は父を持たず、御子を告白する者は、また父をも持つのである。"},{"ref":"1John.2.24","start":62002024,"end":62002024,"break":"none","ruby":[[0,1,"はじ"],[4,1,"き"],[33,1,"はじ"],[37,1,"き"],[68,2,"みこ"],[71,1,"ちち"]],"text":"初めから聞いたことが、あなたがたのうちに、とどまるようにしなさい。初めから聞いたことが、あなたがたのうちにとどまっておれば、あなたがたも御子と父とのうちに、とどまることになる。"},{"ref":"1John.2.25","start":62002025,"end":62002025,"break":"none","ruby":[[4,1,"かれ"],[5,1,"みずか"],[13,2,"やくそく"],[18,2,"やくそく"],[30,2,"えいえん"]],"text":"これが、彼自らわたしたちに約束された約束であって、すなわち、永遠のいのちである。"},{"ref":"1John.2.26","start":62002026,"end":62002026,"break":"none","ruby":[[11,1,"まど"],[14,1,"もの"],[29,1,"か"]],"text":"わたしは、あなたがたを惑わす者たちについて、これらのことを書きおくった。"},{"ref":"1John.2.27","start":62002027,"end":62002027,"break":"none","ruby":[[22,1,"あぶら"],[38,1,"おし"],[44,2,"ひつよう"],[52,1,"あぶら"],[68,1,"おし"],[83,1,"いつわ"],[94,1,"あぶら"],[96,1,"おし"],[109,1,"かれ"]],"text":"あなたがたのうちには、キリストからいただいた油がとどまっているので、だれにも教えてもらう必要はない。この油が、すべてのことをあなたがたに教える。それはまことであって、偽りではないから、その油が教えたように、あなたがたは彼のうちにとどまっていなさい。"},{"ref":"1John.2.28","start":62002028,"end":62002028,"break":"paragraph","ruby":[[4,1,"こ"],[31,1,"かれ"],[33,1,"あらわ"],[36,1,"とき"],[39,2,"かくしん"],[42,1,"も"],[47,2,"らいりん"],[50,1,"さい"],[58,1,"は"]],"text":"そこで、子たちよ。キリストのうちにとどまっていなさい。それは、彼が現れる時に、確信を持ち、その来臨に際して、みまえに恥じいることがないためである。"},{"ref":"1John.2.29","start":62002029,"end":62002029,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ぎ"],[18,1,"ぎ"],[20,1,"おこな"],[22,1,"もの"],[26,1,"かれ"],[29,1,"うま"],[41,1,"し"]],"text":"彼の義なるかたであることがわかれば、義を行う者はみな彼から生れたものであることを、知るであろう。"}]