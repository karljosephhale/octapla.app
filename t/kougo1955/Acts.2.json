[{"ref":"Acts.2.1","start":44002001,"end":44002001,"break":"paragraph","ruby":[[0,3,"ごじゅんせつ"],[4,1,"ひ"],[13,1,"もの"],[15,2,"いっしょ"],[18,1,"あつ"]],"text":"五旬節の日がきて、みんなの者が一緒に集まっていると、"},{"ref":"Acts.2.2","start":44002002,"end":44002002,"break":"none","ruby":[[0,2,"とつぜん"],[3,1,"はげ"],[6,1,"かぜ"],[8,1,"ふ"],[16,1,"おと"],[18,1,"てん"],[21,1,"おこ"],[27,2,"いちどう"],[36,1,"いえ"],[42,1,"ひび"]],"text":"突然、激しい風が吹いてきたような音が天から起ってきて、一同がすわっていた家いっぱいに響きわたった。"},{"ref":"Acts.2.3","start":44002003,"end":44002003,"break":"none","ruby":[[3,1,"した"],[12,1,"ほのお"],[17,1,"わか"],[20,1,"あらわ"],[30,1,"うえ"]],"text":"また、舌のようなものが、炎のように分れて現れ、ひとりびとりの上にとどまった。"},{"ref":"Acts.2.4","start":44002004,"end":44002004,"break":"none","ruby":[[4,2,"いちどう"],[7,2,"せいれい"],[10,1,"み"],[15,2,"みたま"],[18,1,"かた"],[31,2,"たこく"],[34,2,"ことば"],[37,1,"かた"],[39,1,"だ"]],"text":"すると、一同は聖霊に満たされ、御霊が語らせるままに、いろいろの他国の言葉で語り出した。"},{"ref":"Acts.2.5","start":44002005,"end":44002005,"break":"paragraph","ruby":[[11,2,"てんか"],[18,2,"くにぐに"],[23,2,"しんこう"],[25,1,"ぶか"],[30,1,"じん"],[36,1,"す"]],"text":"さて、エルサレムには、天下のあらゆる国々から、信仰深いユダヤ人たちがきて住んでいたが、"},{"ref":"Acts.2.6","start":44002006,"end":44002006,"break":"none","ruby":[[2,2,"ものおと"],[5,1,"おお"],[9,1,"ひと"],[11,1,"あつ"],[18,1,"かれ"],[21,1,"うま"],[23,2,"こきょう"],[26,2,"こくご"],[30,2,"しと"],[35,1,"はな"],[49,1,"き"],[56,1,"と"]],"text":"この物音に大ぜいの人が集まってきて、彼らの生れ故郷の国語で、使徒たちが話しているのを、だれもかれも聞いてあっけに取られた。"},{"ref":"Acts.2.7","start":44002007,"end":44002007,"break":"none","ruby":[[3,1,"おどろ"],[5,1,"あや"],[9,1,"い"],[14,1,"み"],[19,1,"はな"],[26,1,"ひと"],[31,1,"みな"],[36,1,"びと"]],"text":"そして驚き怪しんで言った、「見よ、いま話しているこの人たちは、皆ガリラヤ人ではないか。"},{"ref":"Acts.2.8","start":44002008,"end":44002008,"break":"none","ruby":[[17,1,"うま"],[19,2,"こきょう"],[22,2,"こくご"],[25,1,"かれ"],[29,1,"き"]],"text":"それだのに、わたしたちがそれぞれ、生れ故郷の国語を彼らから聞かされるとは、いったい、どうしたことか。"},{"ref":"Acts.2.9","start":44002009,"end":44002009,"break":"none","ruby":[[6,1,"なか"],[14,1,"びと"],[19,1,"びと"],[24,1,"びと"]],"text":"わたしたちの中には、パルテヤ人、メジヤ人、エラム人もおれば、メソポタミヤ、ユダヤ、カパドキヤ、ポントとアジヤ、"},{"ref":"Acts.2.10","start":44002010,"end":44002010,"break":"none","ruby":[[20,1,"ちか"],[25,2,"ちほう"],[30,1,"す"],[32,1,"もの"],[43,1,"じん"],[45,1,"たび"],[51,1,"もの"]],"text":"フルギヤとパンフリヤ、エジプトとクレネに近いリビヤ地方などに住む者もいるし、またローマ人で旅にきている者、"},{"ref":"Acts.2.11","start":44002011,"end":44002011,"break":"none","ruby":[[3,1,"じん"],[5,3,"かいしゅうしゃ"],[12,1,"びと"],[18,1,"じん"],[28,2,"ひとびと"],[37,2,"こくご"],[41,1,"かみ"],[43,1,"おお"],[46,1,"はたら"],[49,1,"の"],[54,1,"き"]],"text":"ユダヤ人と改宗者、クレテ人とアラビヤ人もいるのだが、あの人々がわたしたちの国語で、神の大きな働きを述べるのを聞くとは、どうしたことか」。"},{"ref":"Acts.2.12","start":44002012,"end":44002012,"break":"none","ruby":[[4,1,"もの"],[6,1,"おどろ"],[8,1,"まど"],[12,1,"たがい"],[14,1,"い"],[16,1,"あ"]],"text":"みんなの者は驚き惑って、互に言い合った、「これは、いったい、どういうわけなのだろう」。"},{"ref":"Acts.2.13","start":44002013,"end":44002013,"break":"none","ruby":[[7,1,"ひと"],[13,1,"わら"],[20,1,"ひと"],[24,1,"あたら"],[27,1,"さけ"],[29,1,"よ"],[38,1,"い"]],"text":"しかし、ほかの人たちはあざ笑って、「あの人たちは新しい酒で酔っているのだ」と言った。"},{"ref":"Acts.2.14","start":44002014,"end":44002014,"break":"paragraph","breaks":[[36,"paragraph"]],"ruby":[[10,1,"にん"],[12,1,"もの"],[14,1,"とも"],[16,1,"た"],[22,1,"こえ"],[27,2,"ひとびと"],[30,1,"かた"],[41,1,"ひと"],[55,1,"す"],[72,1,"こと"],[74,1,"し"],[88,1,"い"],[93,1,"みみ"],[95,1,"かたむ"]],"text":"そこで、ペテロが十一人の者と共に立ちあがり、声をあげて人々に語りかけた。「ユダヤの人たち、ならびにエルサレムに住むすべてのかたがた、どうか、この事を知っていただきたい。わたしの言うことに耳を傾けていただきたい。"},{"ref":"Acts.2.15","start":44002015,"end":44002015,"break":"none","ruby":[[0,1,"いま"],[2,1,"あさ"],[5,1,"じ"],[14,1,"ひと"],[25,1,"おも"],[34,1,"さけ"],[36,1,"よ"]],"text":"今は朝の九時であるから、この人たちは、あなたがたが思っているように、酒に酔っているのではない。"},{"ref":"Acts.2.16","start":44002016,"end":44002016,"break":"none","ruby":[[10,3,"よげんしゃ"],[17,2,"よげん"],[26,1,"ほか"]],"text":"そうではなく、これは預言者ヨエルが預言していたことに外ならないのである。すなわち、"},{"ref":"Acts.2.17","start":44002017,"end":44002017,"break":"stanza","breaks":[[11,"line"],[18,"line"],[34,"line"],[54,"line"],[63,"line"]],"ruby":[[1,1,"かみ"],[5,1,"おお"],[11,1,"おわ"],[14,1,"とき"],[22,1,"れい"],[28,1,"ひと"],[30,1,"そそ"],[47,1,"むすめ"],[49,2,"よげん"],[54,2,"わかもの"],[59,1,"まぼろし"],[61,1,"み"],[63,2,"ろうじん"],[68,1,"ゆめ"],[70,1,"み"]],"text":"『神がこう仰せになる。終りの時には、わたしの霊をすべての人に注ごう。そして、あなたがたのむすこ娘は預言をし、若者たちは幻を見、老人たちは夢を見るであろう。"},{"ref":"Acts.2.18","start":44002018,"end":44002018,"break":"line","breaks":[[18,"line"],[28,"line"]],"ruby":[[2,1,"とき"],[10,2,"だんじょ"],[13,1,"しもべ"],[22,1,"れい"],[24,1,"そそ"],[31,1,"かれ"],[34,2,"よげん"]],"text":"その時には、わたしの男女の僕たちにもわたしの霊を注ごう。そして彼らも預言をするであろう。"},{"ref":"Acts.2.19","start":44002019,"end":44002019,"break":"line","breaks":[[15,"line"],[26,"line"],[44,"line"]],"ruby":[[3,1,"うえ"],[7,1,"てん"],[9,2,"きせき"],[12,1,"み"],[15,1,"した"],[19,1,"ち"],[31,1,"ち"],[33,1,"ひ"],[35,1,"た"],[40,1,"けむり"],[44,1,"み"]],"text":"また、上では、天に奇跡を見せ、下では、地にしるしを、すなわち、血と火と立ちこめる煙とを、見せるであろう。"},{"ref":"Acts.2.20","start":44002020,"end":44002020,"break":"line","breaks":[[17,"line"],[22,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おお"],[6,1,"かがや"],[10,1,"ひ"],[12,1,"く"],[14,1,"まえ"],[17,1,"ひ"],[22,1,"つき"],[24,1,"ち"],[26,1,"かわ"]],"text":"主の大いなる輝かしい日が来る前に、日はやみに月は血に変るであろう。"},{"ref":"Acts.2.21","start":44002021,"end":44002021,"break":"line","breaks":[[17,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"な"],[9,1,"よ"],[11,1,"もと"],[14,1,"もの"],[19,1,"すく"]],"text":"そのとき、主の名を呼び求める者は、みな救われるであろう』。"},{"ref":"Acts.2.22","start":44002022,"end":44002022,"break":"none","ruby":[[6,1,"ひと"],[11,1,"いま"],[16,1,"かた"],[21,1,"き"],[35,1,"し"],[47,1,"びと"],[53,1,"かみ"],[55,1,"かれ"],[68,1,"なか"],[70,1,"おこな"],[74,2,"かずかず"],[77,1,"ちから"],[83,2,"きせき"],[94,1,"かみ"],[103,1,"もの"],[117,1,"しめ"]],"text":"イスラエルの人たちよ、今わたしの語ることを聞きなさい。あなたがたがよく知っているとおり、ナザレ人イエスは、神が彼をとおして、あなたがたの中で行われた数々の力あるわざと奇跡としるしとにより、神からつかわされた者であることを、あなたがたに示されたかたであった。"},{"ref":"Acts.2.23","start":44002023,"end":44002023,"break":"none","ruby":[[6,1,"わた"],[12,1,"かみ"],[14,1,"さだ"],[17,2,"けいかく"],[20,2,"よち"],[38,1,"かれ"],[40,2,"ふほう"],[43,2,"ひとびと"],[46,1,"て"],[48,3,"じゅうじか"],[55,1,"ころ"]],"text":"このイエスが渡されたのは神の定めた計画と予知とによるのであるが、あなたがたは彼を不法の人々の手で十字架につけて殺した。"},{"ref":"Acts.2.24","start":44002024,"end":44002024,"break":"none","ruby":[[0,1,"かみ"],[8,1,"し"],[10,1,"くる"],[15,1,"と"],[17,1,"はな"],[37,1,"し"],[39,2,"しはい"]],"text":"神はこのイエスを死の苦しみから解き放って、よみがえらせたのである。イエスが死に支配されているはずはなかったからである。"},{"ref":"Acts.2.25","start":44002025,"end":44002025,"break":"none","breaks":[[19,"stanza"],[35,"line"],[51,"line"]],"ruby":[[13,1,"い"],[24,1,"つね"],[26,1,"め"],[28,1,"まえ"],[30,1,"しゅ"],[32,1,"み"],[35,1,"しゅ"],[42,1,"うご"],[55,1,"みぎ"],[59,1,"くだ"]],"text":"ダビデはイエスについてこう言っている、『わたしは常に目の前に主を見た。主は、わたしが動かされないため、わたしの右にいて下さるからである。"},{"ref":"Acts.2.26","start":44002026,"end":44002026,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[9,1,"こころ"],[11,1,"たの"],[19,1,"した"],[25,1,"うた"],[33,2,"にくたい"],[39,1,"のぞ"],[42,1,"い"]],"text":"それゆえ、わたしの心は楽しみ、わたしの舌はよろこび歌った。わたしの肉体もまた、望みに生きるであろう。"},{"ref":"Acts.2.27","start":44002027,"end":44002027,"break":"line","breaks":[[24,"line"]],"ruby":[[9,1,"たましい"],[11,2,"よみ"],[14,1,"す"],[28,2,"せいじゃ"],[31,1,"く"],[33,1,"は"],[40,1,"ゆる"]],"text":"あなたは、わたしの魂を黄泉に捨ておくことをせず、あなたの聖者が朽ち果てるのを、お許しにならないであろう。"},{"ref":"Acts.2.28","start":44002028,"end":44002028,"break":"line","breaks":[[18,"line"]],"ruby":[[9,1,"みち"],[15,1,"しめ"],[19,1,"まえ"],[29,1,"よろこ"],[32,1,"み"],[36,1,"くだ"]],"text":"あなたは、いのちの道をわたしに示し、み前にあって、わたしを喜びで満たして下さるであろう』。"},{"ref":"Acts.2.29","start":44002029,"end":44002029,"break":"none","ruby":[[0,2,"きょうだい"],[6,2,"ぞくちょう"],[31,2,"だいたん"],[34,1,"い"],[43,1,"かれ"],[45,1,"し"],[48,1,"ほうむ"],[52,1,"げん"],[56,1,"はか"],[58,2,"きょう"],[61,1,"いた"],[72,1,"あいだ"],[74,1,"のこ"]],"text":"兄弟たちよ、族長ダビデについては、わたしはあなたがたにむかって大胆に言うことができる。彼は死んで葬られ、現にその墓が今日に至るまで、わたしたちの間に残っている。"},{"ref":"Acts.2.30","start":44002030,"end":44002030,"break":"none","ruby":[[0,1,"かれ"],[2,3,"よげんしゃ"],[13,2,"しそん"],[20,2,"おうい"],[31,1,"かみ"],[33,1,"かた"],[35,1,"かれ"],[37,1,"ちか"],[44,1,"みと"]],"text":"彼は預言者であって、『その子孫のひとりを王位につかせよう』と、神が堅く彼に誓われたことを認めていたので、"},{"ref":"Acts.2.31","start":44002031,"end":44002031,"break":"none","ruby":[[5,2,"ふっかつ"],[13,1,"し"],[18,1,"かれ"],[20,2,"よみ"],[23,1,"す"],[39,2,"にくたい"],[42,1,"く"],[44,1,"は"],[54,1,"かた"]],"text":"キリストの復活をあらかじめ知って、『彼は黄泉に捨ておかれることがなく、またその肉体が朽ち果てることもない』と語ったのである。"},{"ref":"Acts.2.32","start":44002032,"end":44002032,"break":"none","ruby":[[7,1,"かみ"],[27,1,"みな"],[30,2,"しょうにん"]],"text":"このイエスを、神はよみがえらせた。そして、わたしたちは皆その証人なのである。"},{"ref":"Acts.2.33","start":44002033,"end":44002033,"break":"none","ruby":[[8,1,"かみ"],[10,1,"みぎ"],[12,1,"あ"],[17,1,"ちち"],[20,2,"やくそく"],[23,2,"せいれい"],[26,1,"う"],[39,1,"そそ"],[60,1,"げん"],[62,2,"みき"]],"text":"それで、イエスは神の右に上げられ、父から約束の聖霊を受けて、それをわたしたちに注がれたのである。このことは、あなたがたが現に見聞きしているとおりである。"},{"ref":"Acts.2.34","start":44002034,"end":44002034,"break":"none","breaks":[[26,"stanza"]],"ruby":[[4,1,"てん"],[6,1,"のぼ"],[15,1,"かれ"],[16,2,"じしん"],[20,1,"い"],[27,1,"しゅ"],[31,1,"しゅ"],[33,1,"おお"]],"text":"ダビデが天に上ったのではない。彼自身こう言っている、『主はわが主に仰せになった、"},{"ref":"Acts.2.35","start":44002035,"end":44002035,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"てき"],[10,1,"あし"],[11,1,"だい"],[23,1,"みぎ"],[25,1,"ざ"]],"text":"あなたの敵をあなたの足台にするまでは、わたしの右に座していなさい』。"},{"ref":"Acts.2.36","start":44002036,"end":44002036,"break":"none","ruby":[[10,1,"ぜん"],[11,1,"か"],[16,1,"こと"],[21,1,"し"],[36,3,"じゅうじか"],[50,1,"かみ"],[53,1,"しゅ"],[64,1,"た"]],"text":"だから、イスラエルの全家は、この事をしかと知っておくがよい。あなたがたが十字架につけたこのイエスを、神は、主またキリストとしてお立てになったのである」。"},{"ref":"Acts.2.37","start":44002037,"end":44002037,"break":"paragraph","ruby":[[0,2,"ひとびと"],[6,1,"き"],[10,1,"つよ"],[12,1,"こころ"],[14,1,"さ"],[25,2,"しと"],[32,2,"きょうだい"],[60,1,"い"]],"text":"人々はこれを聞いて、強く心を刺され、ペテロやほかの使徒たちに、「兄弟たちよ、わたしたちは、どうしたらよいのでしょうか」と言った。"},{"ref":"Acts.2.38","start":44002038,"end":44002038,"break":"none","ruby":[[8,1,"こた"],[13,1,"く"],[15,1,"あらた"],[37,1,"つみ"],[43,1,"え"],[58,1,"な"],[70,1,"う"],[88,2,"せいれい"],[91,2,"たまもの"],[94,1,"う"]],"text":"すると、ペテロが答えた、「悔い改めなさい。そして、あなたがたひとりびとりが罪のゆるしを得るために、イエス・キリストの名によって、バプテスマを受けなさい。そうすれば、あなたがたは聖霊の賜物を受けるであろう。"},{"ref":"Acts.2.39","start":44002039,"end":44002039,"break":"none","ruby":[[2,2,"やくそく"],[10,1,"しゅ"],[13,1,"かみ"],[15,1,"め"],[26,1,"もの"],[45,1,"こ"],[49,1,"とお"],[52,1,"もの"],[53,2,"いちどう"],[58,1,"あた"]],"text":"この約束は、われらの主なる神の召しにあずかるすべての者、すなわちあなたがたと、あなたがたの子らと、遠くの者一同とに、与えられているものである」。"},{"ref":"Acts.2.40","start":44002040,"end":44002040,"break":"none","ruby":[[10,1,"おお"],[13,2,"ことば"],[23,2,"ひとびと"],[29,1,"まが"],[32,2,"じだい"],[36,1,"すく"],[42,1,"い"],[45,1,"すす"]],"text":"ペテロは、ほかになお多くの言葉であかしをなし、人々に「この曲った時代から救われよ」と言って勧めた。"},{"ref":"Acts.2.41","start":44002041,"end":44002041,"break":"none","ruby":[[4,1,"かれ"],[6,1,"すす"],[9,2,"ことば"],[12,1,"う"],[17,1,"もの"],[28,1,"う"],[35,1,"ひ"],[37,2,"なかま"],[40,1,"くわ"],[49,1,"にん"]],"text":"そこで、彼の勧めの言葉を受けいれた者たちは、バプテスマを受けたが、その日、仲間に加わったものが三千人ほどあった。"},{"ref":"Acts.2.42","start":44002042,"end":44002042,"break":"none","ruby":[[3,2,"いちどう"],[11,2,"しと"],[16,1,"おしえ"],[18,1,"まも"],[21,2,"しんと"],[24,1,"まじ"],[31,1,"とも"],[39,1,"いのり"]],"text":"そして一同はひたすら、使徒たちの教を守り、信徒の交わりをなし、共にパンをさき、祈をしていた。"},{"ref":"Acts.2.43","start":44002043,"end":44002043,"break":"paragraph","ruby":[[4,1,"もの"],[10,1,"ねん"],[12,1,"しょう"],[15,1,"おお"],[18,2,"きせき"],[27,2,"しと"],[36,2,"つぎつぎ"],[39,1,"おこな"]],"text":"みんなの者におそれの念が生じ、多くの奇跡としるしとが、使徒たちによって、次々に行われた。"},{"ref":"Acts.2.44","start":44002044,"end":44002044,"break":"none","ruby":[[0,2,"しんじゃ"],[7,2,"いっしょ"],[18,1,"もの"],[20,2,"きょうゆう"]],"text":"信者たちはみな一緒にいて、いっさいの物を共有にし、"},{"ref":"Acts.2.45","start":44002045,"end":44002045,"break":"none","ruby":[[0,2,"しさん"],[3,1,"も"],[5,1,"もの"],[7,1,"う"],[12,2,"ひつよう"],[15,1,"おう"],[22,1,"もの"],[24,1,"わ"],[26,1,"あた"]],"text":"資産や持ち物を売っては、必要に応じてみんなの者に分け与えた。"},{"ref":"Acts.2.46","start":44002046,"end":44002046,"break":"none","ruby":[[3,2,"ひび"],[5,1,"こころ"],[13,1,"た"],[16,1,"みや"],[24,1,"いえ"],[49,2,"しょくじ"],[52,1,"とも"]],"text":"そして日々心を一つにして、絶えず宮もうでをなし、家ではパンをさき、よろこびと、まごころとをもって、食事を共にし、"},{"ref":"Acts.2.47","start":44002047,"end":44002047,"break":"none","ruby":[[0,1,"かみ"],[11,1,"ひと"],[13,2,"こうい"],[16,1,"も"],[26,1,"しゅ"],[29,1,"すく"],[33,1,"もの"],[35,2,"ひび"],[37,2,"なかま"],[40,1,"くわ"],[43,1,"くだ"]],"text":"神をさんびし、すべての人に好意を持たれていた。そして主は、救われる者を日々仲間に加えて下さったのである。"}]