[{"ref":"Gen.8.1","start":1008001,"end":1008001,"break":"paragraph","ruby":[[0,1,"かみ"],[6,2,"はこぶね"],[9,1,"なか"],[17,1,"い"],[19,1,"もの"],[26,2,"かちく"],[30,1,"こころ"],[38,1,"かみ"],[40,1,"かぜ"],[42,1,"ち"],[44,1,"うえ"],[46,1,"ふ"],[55,1,"みず"],[57,1,"しりぞ"]],"text":"神はノアと、箱舟の中にいたすべての生き物と、すべての家畜とを心にとめられた。神が風を地の上に吹かせられたので、水は退いた。"},{"ref":"Gen.8.2","start":1008002,"end":1008002,"break":"none","ruby":[[2,1,"ふち"],[4,1,"みなもと"],[7,1,"てん"],[9,1,"まど"],[12,1,"と"],[18,1,"てん"],[21,1,"あめ"],[23,1,"ふ"]],"text":"また淵の源と、天の窓とは閉ざされて、天から雨が降らなくなった。"},{"ref":"Gen.8.3","start":1008003,"end":1008003,"break":"none","ruby":[[3,1,"みず"],[9,1,"ち"],[11,1,"うえ"],[14,1,"ひ"],[21,1,"にち"],[23,1,"のち"],[26,1,"みず"],[28,1,"へ"]],"text":"それで水はしだいに地の上から引いて、百五十日の後には水が減り、"},{"ref":"Gen.8.4","start":1008004,"end":1008004,"break":"none","ruby":[[0,2,"はこぶね"],[4,1,"がつ"],[7,1,"にち"],[14,1,"やま"]],"text":"箱舟は七月十七日にアララテの山にとどまった。"},{"ref":"Gen.8.5","start":1008005,"end":1008005,"break":"none","ruby":[[0,1,"みず"],[6,1,"へ"],[11,1,"がつ"],[17,1,"がつ"],[19,1,"にち"],[21,2,"やまやま"],[24,1,"いただき"],[26,1,"あらわ"]],"text":"水はしだいに減って、十月になり、十月一日に山々の頂が現れた。"},{"ref":"Gen.8.6","start":1008006,"end":1008006,"break":"paragraph","ruby":[[2,1,"にち"],[12,1,"つく"],[15,2,"はこぶね"],[18,1,"まど"],[20,1,"ひら"]],"text":"四十日たって、ノアはその造った箱舟の窓を開いて、"},{"ref":"Gen.8.7","start":1008007,"end":1008007,"break":"none","ruby":[[4,1,"はな"],[15,1,"ち"],[17,1,"うえ"],[20,1,"みず"],[37,1,"と"]],"text":"からすを放ったところ、からすは地の上から水がかわききるまで、あちらこちらへ飛びまわった。"},{"ref":"Gen.8.8","start":1008008,"end":1008008,"break":"none","ruby":[[5,1,"ち"],[13,1,"みず"],[23,1,"み"],[28,1,"かれ"],[30,1,"ところ"],[37,1,"はな"]],"text":"ノアはまた地のおもてから、水がひいたかどうかを見ようと、彼の所から、はとを放ったが、"},{"ref":"Gen.8.9","start":1008009,"end":1008009,"break":"none","ruby":[[3,1,"あし"],[5,1,"うら"],[11,1,"ところ"],[13,1,"み"],[24,2,"はこぶね"],[33,1,"かえ"],[39,1,"みず"],[43,1,"ぜん"],[44,1,"ち"],[59,1,"かれ"],[61,1,"て"],[63,1,"の"],[70,1,"とら"],[73,2,"はこぶね"],[76,1,"なか"],[78,1,"かれ"],[83,1,"ひ"],[85,1,"い"]],"text":"はとは足の裏をとどめる所が見つからなかったので、箱舟のノアのもとに帰ってきた。水がまだ全地のおもてにあったからである。彼は手を伸べて、これを捕え、箱舟の中の彼のもとに引き入れた。"},{"ref":"Gen.8.10","start":1008010,"end":1008010,"break":"none","ruby":[[4,2,"なぬか"],[6,1,"ま"],[9,1,"ふたた"],[14,2,"はこぶね"],[18,1,"はな"]],"text":"それから七日待って再びはとを箱舟から放った。"},{"ref":"Gen.8.11","start":1008011,"end":1008011,"break":"none","ruby":[[3,2,"ゆうがた"],[9,1,"かれ"],[14,1,"かえ"],[20,1,"み"],[37,2,"わかば"],[47,1,"ち"],[50,1,"みず"],[57,1,"し"]],"text":"はとは夕方になって彼のもとに帰ってきた。見ると、そのくちばしには、オリブの若葉があった。ノアは地から水がひいたのを知った。"},{"ref":"Gen.8.12","start":1008012,"end":1008012,"break":"none","ruby":[[3,2,"なぬか"],[5,1,"ま"],[14,1,"はな"],[24,1,"かれ"],[30,1,"かえ"]],"text":"さらに七日待ってまた、はとを放ったところ、もはや彼のもとには帰ってこなかった。"},{"ref":"Gen.8.13","start":1008013,"end":1008013,"break":"paragraph","ruby":[[3,1,"さい"],[6,1,"がつ"],[8,1,"にち"],[14,1,"ち"],[16,1,"うえ"],[18,1,"みず"],[27,2,"はこぶね"],[34,1,"と"],[36,1,"のぞ"],[39,1,"み"],[43,1,"つち"]],"text":"六百一歳の一月一日になって、地の上の水はかれた。ノアが箱舟のおおいを取り除いて見ると、土のおもては、かわいていた。"},{"ref":"Gen.8.14","start":1008014,"end":1008014,"break":"none","ruby":[[1,1,"がつ"],[5,1,"にち"],[11,1,"ち"],[13,1,"まった"]],"text":"二月二十七日になって、地は全くかわいた。"},{"ref":"Gen.8.15","start":1008015,"end":1008015,"break":"none","ruby":[[2,1,"とき"],[4,1,"かみ"],[9,1,"い"]],"text":"この時、神はノアに言われた、"},{"ref":"Gen.8.16","start":1008016,"end":1008016,"break":"none","ruby":[[5,1,"つま"],[8,1,"こ"],[12,1,"こ"],[15,1,"つま"],[19,1,"とも"],[21,2,"はこぶね"],[24,1,"で"]],"text":"「あなたは妻と、子らと、子らの妻たちと共に箱舟を出なさい。"},{"ref":"Gen.8.17","start":1008017,"end":1008017,"break":"none","ruby":[[5,1,"とも"],[9,1,"にく"],[16,1,"い"],[18,1,"もの"],[24,1,"とり"],[26,2,"かちく"],[30,1,"ち"],[36,1,"は"],[42,1,"つ"],[45,1,"で"],[55,1,"ち"],[57,1,"むら"],[61,1,"ち"],[63,1,"うえ"],[67,1,"ひろ"]],"text":"あなたは、共にいる肉なるすべての生き物、すなわち鳥と家畜と、地のすべての這うものとを連れて出て、これらのものが地に群がり、地の上にふえ広がるようにしなさい」。"},{"ref":"Gen.8.18","start":1008018,"end":1008018,"break":"none","ruby":[[3,1,"とも"],[7,1,"こ"],[11,1,"つま"],[14,1,"こ"],[17,1,"つま"],[22,1,"つ"],[25,1,"で"]],"text":"ノアは共にいた子らと、妻と、子らの妻たちとを連れて出た。"},{"ref":"Gen.8.19","start":1008019,"end":1008019,"break":"none","ruby":[[6,1,"けもの"],[12,1,"は"],[21,1,"とり"],[26,1,"ち"],[28,1,"うえ"],[30,1,"うご"],[35,1,"みな"],[37,2,"しゅるい"],[45,2,"はこぶね"],[48,1,"で"]],"text":"またすべての獣、すべての這うもの、すべての鳥、すべて地の上に動くものは皆、種類にしたがって箱舟を出た。"},{"ref":"Gen.8.20","start":1008020,"end":1008020,"break":"paragraph","ruby":[[3,1,"しゅ"],[5,2,"さいだん"],[8,1,"きず"],[16,1,"きよ"],[18,1,"けもの"],[25,1,"きよ"],[27,1,"とり"],[34,1,"と"],[38,2,"はんさい"],[41,2,"さいだん"],[44,1,"うえ"]],"text":"ノアは主に祭壇を築いて、すべての清い獣と、すべての清い鳥とのうちから取って、燔祭を祭壇の上にささげた。"},{"ref":"Gen.8.21","start":1008021,"end":1008021,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"こう"],[16,1,"こころ"],[18,1,"い"],[32,1,"ど"],[34,1,"ひと"],[39,1,"ち"],[47,1,"ひと"],[49,1,"こころ"],[51,1,"おも"],[53,1,"はか"],[59,1,"おさな"],[61,1,"とき"],[64,1,"わる"],[90,1,"ど"],[97,1,"い"],[103,1,"ほろ"]],"text":"主はその香ばしいかおりをかいで、心に言われた、「わたしはもはや二度と人のゆえに地をのろわない。人が心に思い図ることは、幼い時から悪いからである。わたしは、このたびしたように、もう二度と、すべての生きたものを滅ぼさない。"},{"ref":"Gen.8.22","start":1008022,"end":1008022,"break":"none","ruby":[[0,1,"ち"],[4,1,"かぎ"],[7,1,"たね"],[11,1,"とき"],[14,2,"かりい"],[18,1,"とき"],[21,1,"あつ"],[23,1,"さむ"],[27,1,"なつ"],[28,1,"ふゆ"],[31,1,"ひる"],[33,1,"よる"]],"text":"地のある限り、種まきの時も、刈入れの時も、暑さ寒さも、夏冬も、昼も夜もやむことはないであろう」。"}]