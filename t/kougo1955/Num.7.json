[{"ref":"Num.7.1","start":4007001,"end":4007001,"break":"paragraph","ruby":[[4,2,"まくや"],[7,1,"た"],[9,1,"おわ"],[15,1,"あぶら"],[17,1,"そそ"],[20,2,"せいべつ"],[32,1,"うつわ"],[39,2,"さいだん"],[49,1,"うつわ"],[51,1,"あぶら"],[53,1,"そそ"],[60,2,"せいべつ"],[64,1,"ひ"]],"text":"モーセが幕屋を建て終り、これに油を注いで聖別し、またそのすべての器、およびその祭壇と、そのすべての器に油を注いで、これを聖別した日に、"},{"ref":"Num.7.2","start":4007002,"end":4007002,"break":"none","ruby":[[19,2,"ふそ"],[22,1,"いえ"],[24,1,"ちょう"],[32,1,"もの"],[37,1,"かれ"],[40,1,"かく"],[41,2,"ぶぞく"],[56,1,"かぞ"],[61,2,"ひとびと"],[69,1,"もの"]],"text":"イスラエルのつかさたち、すなわち、その父祖の家の長たちは、ささげ物をした。彼らは各部族のつかさたちであって、その数えられた人々をつかさどる者どもであった。"},{"ref":"Num.7.3","start":4007003,"end":4007003,"break":"none","ruby":[[0,1,"かれ"],[5,1,"そな"],[7,1,"もの"],[10,1,"しゅ"],[12,1,"まえ"],[14,1,"たずさ"],[27,1,"くるま"],[29,1,"りょう"],[31,2,"おうし"],[35,1,"とう"],[48,1,"くるま"],[50,1,"りょう"],[56,2,"おうし"],[59,1,"とう"],[64,1,"かれ"],[70,2,"まくや"],[73,1,"まえ"],[75,1,"ひ"]],"text":"彼らはその供え物を、主の前に携えてきたが、おおいのある車六両と雄牛十二頭であった。つかさふたりに車一両、ひとりに雄牛一頭である。彼らはこれを幕屋の前に引いてきた。"},{"ref":"Num.7.4","start":4007004,"end":4007004,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[10,1,"い"]],"text":"その時、主はモーセに言われた、"},{"ref":"Num.7.5","start":4007005,"end":4007005,"break":"none","ruby":[[8,2,"かいけん"],[11,2,"まくや"],[14,1,"つとめ"],[16,1,"もち"],[23,1,"かれ"],[27,1,"う"],[29,1,"と"],[45,1,"つとめ"],[53,1,"わた"]],"text":"「あなたはこれを会見の幕屋の務に用いるために、彼らから受け取って、レビびとに、おのおのその務にしたがって、渡さなければならない」。"},{"ref":"Num.7.6","start":4007006,"end":4007006,"break":"none","ruby":[[9,1,"くるま"],[11,2,"おうし"],[14,1,"う"],[16,1,"と"],[28,1,"わた"]],"text":"そこでモーセはその車と雄牛を受け取って、これをレビびとに渡した。"},{"ref":"Num.7.7","start":4007007,"end":4007007,"break":"none","ruby":[[11,1,"こ"],[19,1,"つとめ"],[27,1,"くるま"],[29,1,"りょう"],[31,2,"おうし"],[34,1,"とう"],[36,1,"わた"]],"text":"すなわち、ゲルションの子たちには、その務にしたがって、車二両と雄牛四頭を渡し、"},{"ref":"Num.7.8","start":4007008,"end":4007008,"break":"none","ruby":[[4,1,"こ"],[12,1,"つとめ"],[19,1,"くるま"],[21,1,"りょう"],[23,2,"おうし"],[26,1,"とう"],[28,1,"わた"],[31,2,"さいし"],[37,1,"こ"],[47,2,"かんとく"]],"text":"メラリの子たちには、その務にしたがって車四両と雄牛八頭を渡し、祭司アロンの子イタマルに、これを監督させた。"},{"ref":"Num.7.9","start":4007009,"end":4007009,"break":"none","ruby":[[8,1,"こ"],[14,1,"なに"],[17,1,"わた"],[24,1,"かれ"],[27,1,"つとめ"],[29,1,"せい"],[32,1,"もの"],[35,1,"かた"],[41,1,"はこ"]],"text":"しかし、コハテの子たちには、何をも渡さなかった。彼らの務は聖なる物を、肩にになって運ぶことであったからである。"},{"ref":"Num.7.10","start":4007010,"end":4007010,"break":"none","ruby":[[9,2,"さいだん"],[12,1,"あぶら"],[14,1,"そそ"],[16,1,"ひ"],[19,2,"さいだん"],[21,2,"ほうのう"],[24,1,"そな"],[26,1,"もの"],[28,1,"たずさ"],[36,1,"そな"],[38,1,"もの"],[40,2,"さいだん"],[43,1,"まえ"]],"text":"つかさたちは、また祭壇に油を注ぐ日に、祭壇奉納の供え物を携えてきて、その供え物を祭壇の前にささげた。"},{"ref":"Num.7.11","start":4007011,"end":4007011,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[19,1,"にち"],[27,2,"さいだん"],[29,2,"ほうのう"],[32,1,"そな"],[34,1,"もの"]],"text":"主はモーセに言われた、「つかさたちは一日にひとりずつ、祭壇奉納の供え物をささげなければならない」。"},{"ref":"Num.7.12","start":4007012,"end":4007012,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"にち"],[4,1,"そな"],[6,1,"もの"],[12,1,"もの"],[18,2,"ぶぞく"],[27,1,"こ"]],"text":"第一日に供え物をささげた者は、ユダの部族のアミナダブの子ナションであった。"},{"ref":"Num.7.13","start":4007013,"end":4007013,"break":"none","ruby":[[2,1,"そな"],[4,1,"もの"],[6,1,"ぎん"],[15,1,"おも"],[25,1,"ぎん"],[27,1,"はち"],[40,1,"とも"],[42,2,"せいじょ"],[58,2,"そさい"],[61,1,"つか"],[63,1,"あぶら"],[65,1,"ま"],[68,2,"むぎこ"],[71,1,"み"]],"text":"その供え物は銀のさら一つ、その重さは百三十シケル、銀の鉢一つ、これは七十シケル、共に聖所のシケルによる。この二つには素祭に使う油を混ぜた麦粉を満たしていた。"},{"ref":"Num.7.14","start":4007014,"end":4007014,"break":"none","ruby":[[7,1,"きん"],[9,1,"さかずき"],[17,2,"くんこう"],[20,1,"み"]],"text":"また十シケルの金の杯一つ。これには薫香を満たしていた。"},{"ref":"Num.7.15","start":4007015,"end":4007015,"break":"none","ruby":[[2,2,"はんさい"],[5,1,"つか"],[7,1,"わか"],[9,2,"おうし"],[12,1,"とう"],[14,2,"おひつじ"],[17,1,"とう"],[20,1,"さい"],[22,1,"おす"],[24,2,"こひつじ"],[27,1,"とう"]],"text":"また燔祭に使う若い雄牛一頭、雄羊一頭、一歳の雄の小羊一頭。"},{"ref":"Num.7.16","start":4007016,"end":4007016,"break":"none","ruby":[[0,2,"ざいさい"],[3,1,"つか"],[5,1,"お"],[9,1,"とう"]],"text":"罪祭に使う雄やぎ一頭。"},{"ref":"Num.7.17","start":4007017,"end":4007017,"break":"none","ruby":[[0,3,"しゅうおんさい"],[4,2,"ぎせい"],[7,1,"つか"],[9,2,"おうし"],[12,1,"とう"],[14,2,"おひつじ"],[17,1,"とう"],[19,1,"お"],[23,1,"とう"],[26,1,"さい"],[28,1,"おす"],[30,2,"こひつじ"],[33,1,"とう"],[48,1,"こ"],[54,1,"そな"],[56,1,"もの"]],"text":"酬恩祭の犠牲に使う雄牛二頭、雄羊五頭、雄やぎ五頭、一歳の雄の小羊五頭であって、これはアミナダブの子ナションの供え物であった。"},{"ref":"Num.7.18","start":4007018,"end":4007018,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"にち"],[19,1,"こ"],[29,1,"もの"]],"text":"第二日にはイッサカルのつかさ、ツアルの子ネタニエルがささげ物をした。"},{"ref":"Num.7.19","start":4007019,"end":4007019,"break":"none","ruby":[[6,1,"そな"],[8,1,"もの"],[10,1,"ぎん"],[19,1,"おも"],[29,1,"ぎん"],[31,1,"はち"],[44,1,"とも"],[46,2,"せいじょ"],[62,2,"そさい"],[65,1,"つか"],[67,1,"あぶら"],[69,1,"ま"],[72,2,"むぎこ"],[75,1,"み"]],"text":"そのささげた供え物は銀のさら一つ、その重さは百三十シケル、銀の鉢一つ、これは七十シケル、共に聖所のシケルによる。この二つには素祭に使う油を混ぜた麦粉を満たしていた。"},{"ref":"Num.7.20","start":4007020,"end":4007020,"break":"none","ruby":[[7,1,"きん"],[9,1,"さかずき"],[17,2,"くんこう"],[20,1,"み"]],"text":"また十シケルの金の杯一つ、これには薫香を満たしていた。"},{"ref":"Num.7.21","start":4007021,"end":4007021,"break":"none","ruby":[[2,2,"はんさい"],[5,1,"つか"],[7,1,"わか"],[9,2,"おうし"],[12,1,"とう"],[14,2,"おひつじ"],[17,1,"とう"],[20,1,"さい"],[22,1,"おす"],[24,2,"こひつじ"],[27,1,"とう"]],"text":"また燔祭に使う若い雄牛一頭、雄羊一頭、一歳の雄の小羊一頭。"},{"ref":"Num.7.22","start":4007022,"end":4007022,"break":"none","ruby":[[0,2,"ざいさい"],[3,1,"つか"],[5,1,"お"],[9,1,"とう"]],"text":"罪祭に使う雄やぎ一頭。"},{"ref":"Num.7.23","start":4007023,"end":4007023,"break":"none","ruby":[[0,3,"しゅうおんさい"],[4,2,"ぎせい"],[7,1,"つか"],[9,2,"おうし"],[12,1,"とう"],[14,2,"おひつじ"],[17,1,"とう"],[19,1,"お"],[23,1,"とう"],[26,1,"さい"],[28,1,"おす"],[30,2,"こひつじ"],[33,1,"とう"],[46,1,"こ"],[53,1,"そな"],[55,1,"もの"]],"text":"酬恩祭の犠牲に使う雄牛二頭、雄羊五頭、雄やぎ五頭、一歳の雄の小羊五頭であって、これはツアルの子ネタニエルの供え物であった。"},{"ref":"Num.7.24","start":4007024,"end":4007024,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"にち"],[10,1,"こ"],[22,1,"こ"]],"text":"第三日にはゼブルンの子たちのつかさ、ヘロンの子エリアブ。"},{"ref":"Num.7.25","start":4007025,"end":4007025,"break":"none","ruby":[[2,1,"そな"],[4,1,"もの"],[6,1,"ぎん"],[15,1,"おも"],[25,1,"ぎん"],[27,1,"はち"],[40,1,"とも"],[42,2,"せいじょ"],[58,2,"そさい"],[61,1,"つか"],[63,1,"あぶら"],[65,1,"ま"],[68,2,"むぎこ"],[71,1,"み"]],"text":"その供え物は銀のさら一つ、その重