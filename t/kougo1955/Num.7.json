"さかずき"],[18,2,"せいじょ"],[40,1,"さかずき"],[42,1,"きん"],[44,1,"あ"]],"text":"また薫香の満ちている十二の金の杯は、聖所のシケルによれば、それぞれ十シケル、その杯の金は合わせて百二十シケルであった。"},{"ref":"Num.7.87","start":4007087,"end":4007087,"break":"none","ruby":[[2,2,"はんさい"],[5,1,"つか"],[7,2,"おうし"],[10,1,"あ"],[17,2,"おひつじ"],[24,1,"さい"],[26,1,"おす"],[28,2,"こひつじ"],[41,2,"そさい"],[53,2,"ざいさい"],[56,1,"つか"],[58,1,"お"]],"text":"また燔祭に使う雄牛は合わせて十二、雄羊は十二、一歳の雄の小羊は十二、このほかにその素祭のものがあった。また罪祭に使う雄やぎは十二。"},{"ref":"Num.7.88","start":4007088,"end":4007088,"break":"none","ruby":[[0,3,"しゅうおんさい"],[4,2,"ぎせい"],[7,1,"つか"],[9,2,"おうし"],[12,1,"あ"],[20,2,"おひつじ"],[26,1,"お"],[34,1,"さい"],[36,1,"おす"],[38,2,"こひつじ"],[51,2,"さいだん"],[54,1,"あぶら"],[56,1,"そそ"],[59,1,"のち"],[62,2,"さいだん"],[64,2,"ほうのう"],[67,1,"そな"],[69,1,"もの"]],"text":"酬恩祭の犠牲に使う雄牛は合わせて二十四、雄羊は六十、雄やぎは六十、一歳の雄の小羊は六十であって、これは祭壇に油を注いだ後に、祭壇奉納の供え物としてささげたものである。"},{"ref":"Num.7.89","start":4007089,"end":4007089,"break":"paragraph","ruby":[[6,1,"しゅ"],[8,1,"かた"],[14,2,"かいけん"],[17,2,"まくや"],[29,1,"はこ"],[31,1,"うえ"],[34,3,"しょくざいしょ"],[38,1,"うえ"],[48,1,"あいだ"],[51,2,"じぶん"],[54,1,"かた"],[58,1,"こえ"],[60,1,"き"],[69,1,"しゅ"],[71,1,"かれ"],[73,1,"かた"]],"text":"さてモーセは主と語るために、会見の幕屋にはいって、あかしの箱の上の、贖罪所の上、二つのケルビムの間から自分に語られる声を聞いた。すなわち、主は彼に語られた。"}]