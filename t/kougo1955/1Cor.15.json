[{"ref":"1Cor.15.1","start":46015001,"end":46015001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[10,2,"いぜん"],[18,1,"つた"],[21,2,"ふくいん"],[30,1,"う"],[41,1,"た"],[48,2,"ふくいん"],[52,1,"おも"],[54,1,"おこ"]],"text":"兄弟たちよ。わたしが以前あなたがたに伝えた福音、あなたがたが受けいれ、それによって立ってきたあの福音を、思い起してもらいたい。"},{"ref":"1Cor.15.2","start":46015002,"end":46015002,"break":"none","ruby":[[14,1,"しん"],[24,1,"の"],[26,1,"つた"],[33,2,"ことば"],[36,1,"かた"],[38,1,"まも"],[47,2,"ふくいん"],[53,1,"すく"]],"text":"もしあなたがたが、いたずらに信じないで、わたしの宣べ伝えたとおりの言葉を固く守っておれば、この福音によって救われるのである。"},{"ref":"1Cor.15.3","start":46015003,"end":46015003,"break":"none","ruby":[[4,1,"もっと"],[6,2,"だいじ"],[20,1,"つた"],[29,2,"じしん"],[32,1,"う"],[52,2,"せいしょ"],[55,1,"か"],[70,1,"つみ"],[75,1,"し"]],"text":"わたしが最も大事なこととしてあなたがたに伝えたのは、わたし自身も受けたことであった。すなわちキリストが、聖書に書いてあるとおり、わたしたちの罪のために死んだこと、"},{"ref":"1Cor.15.4","start":46015004,"end":46015004,"break":"none","ruby":[[3,1,"ほうむ"],[10,2,"せいしょ"],[13,1,"か"],[23,1,"か"],[24,1,"め"]],"text":"そして葬られたこと、聖書に書いてあるとおり、三日目によみがえったこと、"},{"ref":"1Cor.15.5","start":46015005,"end":46015005,"break":"none","ruby":[[3,1,"あらわ"],[6,1,"つぎ"],[11,1,"にん"],[13,1,"あらわ"]],"text":"ケパに現れ、次に、十二人に現れたことである。"},{"ref":"1Cor.15.6","start":46015006,"end":46015006,"break":"none","ruby":[[7,1,"にん"],[8,2,"いじょう"],[11,2,"きょうだい"],[17,2,"どうじ"],[20,1,"あらわ"],[26,1,"なか"],[32,1,"ねむ"],[35,1,"もの"],[43,3,"だいたすう"],[51,2,"せいぞん"]],"text":"そののち、五百人以上の兄弟たちに、同時に現れた。その中にはすでに眠った者たちもいるが、大多数はいまなお生存している。"},{"ref":"1Cor.15.7","start":46015007,"end":46015007,"break":"none","ruby":[[9,1,"あらわ"],[12,1,"つぎ"],[19,2,"しと"],[24,1,"あらわ"]],"text":"そののち、ヤコブに現れ、次に、すべての使徒たちに現れ、"},{"ref":"1Cor.15.8","start":46015008,"end":46015008,"break":"none","ruby":[[3,2,"さいご"],[11,1,"つき"],[12,1,"た"],[16,1,"うま"],[28,1,"あらわ"]],"text":"そして最後に、いわば、月足らずに生れたようなわたしにも、現れたのである。"},{"ref":"1Cor.15.9","start":46015009,"end":46015009,"break":"none","ruby":[[0,2,"じっさい"],[7,1,"かみ"],[9,2,"きょうかい"],[12,2,"はくがい"],[23,2,"しと"],[28,1,"なか"],[34,1,"ちい"],[37,1,"もの"],[43,2,"しと"],[46,1,"よ"],[50,1,"ね"],[56,1,"もの"]],"text":"実際わたしは、神の教会を迫害したのであるから、使徒たちの中でいちばん小さい者であって、使徒と呼ばれる値うちのない者である。"},{"ref":"1Cor.15.10","start":46015010,"end":46015010,"break":"none","ruby":[[4,1,"かみ"],[6,1,"めぐ"],[17,2,"こんにち"],[22,1,"え"],[39,1,"たま"],[43,1,"かみ"],[45,1,"めぐ"],[63,1,"かれ"],[66,1,"なか"],[73,1,"おお"],[75,1,"はたら"],[91,2,"じしん"],[102,1,"とも"],[107,1,"かみ"],[109,1,"めぐ"]],"text":"しかし、神の恵みによって、わたしは今日あるを得ているのである。そして、わたしに賜わった神の恵みはむだにならず、むしろ、わたしは彼らの中のだれよりも多く働いてきた。しかしそれは、わたし自身ではなく、わたしと共にあった神の恵みである。"},{"ref":"1Cor.15.11","start":46015011,"end":46015011,"break":"none","ruby":[[11,1,"かれ"],[29,1,"の"],[31,1,"つた"],[49,1,"しん"]],"text":"とにかく、わたしにせよ彼らにせよ、そのように、わたしたちは宣べ伝えており、そのように、あなたがたは信じたのである。"},{"ref":"1Cor.15.12","start":46015012,"end":46015012,"break":"paragraph","ruby":[[8,2,"しにん"],[11,1,"なか"],[23,1,"の"],[25,1,"つた"],[41,1,"なか"],[45,1,"もの"],[48,2,"しにん"],[51,2,"ふっかつ"],[59,1,"い"]],"text":"さて、キリストは死人の中からよみがえったのだと宣べ伝えられているのに、あなたがたの中のある者が、死人の復活などはないと言っているのは、どうしたことか。"},{"ref":"1Cor.15.13","start":46015013,"end":46015013,"break":"none","ruby":[[2,2,"しにん"],[5,2,"ふっかつ"]],"text":"もし死人の復活がないならば、キリストもよみがえらなかったであろう。"},{"ref":"1Cor.15.14","start":46015014,"end":46015014,"break":"none","ruby":[[27,2,"せんきょう"],[41,2,"しんこう"]],"text":"もしキリストがよみがえらなかったとしたら、わたしたちの宣教はむなしく、あなたがたの信仰もまたむなしい。"},{"ref":"1Cor.15.15","start":46015015,"end":46015015,"break":"none","ruby":[[10,1,"かみ"],[15,3,"ぎしょうにん"],[32,2,"まんいち"],[34,2,"しにん"],[55,1,"かみ"],[57,2,"じっさい"],[86,1,"い"],[90,1,"かみ"],[92,1,"はん"],[99,1,"た"]],"text":"すると、わたしたちは神にそむく偽証人にさえなるわけだ。なぜなら、万一死人がよみがえらないとしたら、わたしたちは神が実際よみがえらせなかったはずのキリストを、よみがえらせたと言って、神に反するあかしを立てたことになるからである。"},{"ref":"1Cor.15.16","start":46015016,"end":46015016,"break":"none","ruby":[[2,2,"しにん"]],"text":"もし死人がよみがえらないなら、キリストもよみがえらなかったであろう。"},{"ref":"1Cor.15.17","start":46015017,"end":46015017,"break":"none","ruby":[[27,2,"しんこう"],[30,2,"くうきょ"],[50,1,"つみ"],[52,1,"なか"]],"text":"もしキリストがよみがえらなかったとすれば、あなたがたの信仰は空虚なものとなり、あなたがたは、いまなお罪の中にいることになろう。"},{"ref":"1Cor.15.18","start":46015018,"end":46015018,"break":"none","ruby":[[16,1,"ねむ"],[19,1,"もの"],[24,1,"ほろ"]],"text":"そうだとすると、キリストにあって眠った者たちは、滅んでしまったのである。"},{"ref":"1Cor.15.19","start":46015019,"end":46015019,"break":"none","ruby":[[11,1,"よ"],[13,2,"せいかつ"],[24,1,"たん"],[27,1,"のぞ"],[55,1,"ひと"],[57,1,"なか"],[59,1,"もっと"],[67,2,"そんざい"]],"text":"もしわたしたちが、この世の生活でキリストにあって単なる望みをいだいているだけだとすれば、わたしたちは、すべての人の中で最もあわれむべき存在となる。"},{"ref":"1Cor.15.20","start":46015020,"end":46015020,"break":"paragraph","ruby":[[3,2,"じじつ"],[11,1,"ねむ"],[16,1,"もの"],[18,2,"はつほ"],[24,2,"しにん"],[27,1,"なか"]],"text":"しかし事実、キリストは眠っている者の初穂として、死人の中からよみがえったのである。"},{"ref":"1Cor.15.21","start":46015021,"end":46015021,"break":"none","ruby":[[4,1,"し"],[10,1,"ひと"],[22,2,"しにん"],[25,2,"ふっかつ"],[35,1,"ひと"]],"text":"それは、死がひとりの人によってきたのだから、死人の復活もまた、ひとりの人によってこなければならない。"},{"ref":"1Cor.15.22","start":46015022,"end":46015022,"break":"none","ruby":[[11,1,"ひと"],[13,1,"し"],[20,1,"おな"],[38,1,"ひと"],[40,1,"い"]],"text":"アダムにあってすべての人が死んでいるのと同じように、キリストにあってすべての人が生かされるのである。"},{"ref":"1Cor.15.23","start":46015023,"end":46015023,"break":"none","ruby":[[3,2,"かくじ"],[11,2,"じゅんじょ"],[14,1,"したが"],[23,2,"さいしょ"],[31,1,"つぎ"],[34,1,"しゅ"],[36,2,"らいりん"],[39,1,"さい"],[47,1,"ぞく"],[50,1,"もの"]],"text":"ただ、各自はそれぞれの順序に従わねばならない。最初はキリスト、次に、主の来臨に際してキリストに属する者たち、"},{"ref":"1Cor.15.24","start":46015024,"end":46015024,"break":"none","ruby":[[4,2,"しゅうまつ"],[13,1,"とき"],[25,1,"きみ"],[33,2,"けんい"],[36,2,"けんりょく"],[40,1,"う"],[42,1,"ほろ"],[47,1,"くに"],[49,1,"ちち"],[52,1,"かみ"],[54,1,"わた"]],"text":"それから終末となって、その時に、キリストはすべての君たち、すべての権威と権力とを打ち滅ぼして、国を父なる神に渡されるのである。"},{"ref":"1Cor.15.25","start":46015025,"end":46015025,"break":"none","ruby":[[14,1,"てき"],[18,1,"あし"],[22,1,"お"],[24,1,"とき"],[29,2,"しはい"],[32,1,"つづ"]],"text":"なぜなら、キリストはあらゆる敵をその足もとに置く時までは、支配を続けることになっているからである。"},{"ref":"1Cor.15.26","start":46015026,"end":46015026,"break":"none","ruby":[[0,2,"さいご"],[3,1,"てき"],[7,1,"ほろ"],[15,1,"し"]],"text":"最後の敵として滅ぼされるのが、死である。"},{"ref":"1Cor.15.27","start":46015027,"end":46015027,"break":"none","ruby":[[1,1,"かみ"],[3,2,"ばんぶつ"],[6,1,"かれ"],[8,1,"あし"],[12,1,"したが"],[28,2,"ばんぶつ"],[31,1,"したが"],[36,1,"い"],[40,1,"とき"],[42,2,"ばんぶつ"],[45,1,"したが"],[55,1,"ふく"],[66,1,"あき"]],"text":"「神は万物を彼の足もとに従わせた」からである。ところが、万物を従わせたと言われる時、万物を従わせたかたがそれに含まれていないことは、明らかである。"},{"ref":"1Cor.15.28","start":46015028,"end":46015028,"break":"none","ruby":[[4,2,"ばんぶつ"],[7,1,"かみ"],[9,1,"したが"],[11,1,"とき"],[15,2,"みこ"],[17,2,"じしん"],[23,2,"ばんぶつ"],[26,1,"したが"],[35,1,"したが"],[46,1,"かみ"],[52,1,"もの"]],"text":"そして、万物が神に従う時には、御子自身もまた、万物を従わせたそのかたに従うであろう。それは、神がすべての者にあって、すべてとなられるためである。"},{"ref":"1Cor.15.29","start":46015029,"end":46015029,"break":"paragraph","ruby":[[10,2,"ししゃ"],[22,1,"う"],[25,2,"ひとびと"],[44,2,"ししゃ"],[47,1,"まった"],[63,2,"ひとびと"],[66,2,"ししゃ"],[78,1,"う"]],"text":"そうでないとすれば、死者のためにバプテスマを受ける人々は、なぜそれをするのだろうか。もし死者が全くよみがえらないとすれば、なぜ人々が死者のためにバプテスマを受けるのか。"},{"ref":"1Cor.15.30","start":46015030,"end":46015030,"break":"none","ruby":[[19,2,"きけん"],[22,1,"おか"]],"text":"また、なんのために、わたしたちはいつも危険を冒しているのか。"},{"ref":"1Cor.15.31","start":46015031,"end":46015031,"break":"none","ruby":[[0,2,"きょうだい"],[12,1,"しゅ"],[38,1,"も"],[43,1,"ほこり"],[48,1,"い"],[56,2,"ひび"],[58,1,"し"]],"text":"兄弟たちよ。わたしたちの主キリスト・イエスにあって、わたしがあなたがたにつき持っている誇にかけて言うが、わたしは日々死んでいるのである。"},{"ref":"1Cor.15.32","start":46015032,"end":46015032,"break":"none","ruby":[[7,2,"にんげん"],[10,1,"かんが"],[20,1,"けもの"],[22,1,"たたか"],[36,1,"やく"],[38,1,"た"],[45,2,"しにん"],[66,1,"の"],[68,1,"く"]],"text":"もし、わたしが人間の考えによってエペソで獣と戦ったとすれば、それはなんの役に立つのか。もし死人がよみがえらないのなら、「わたしたちは飲み食いしようではないか。あすもわからぬいのちなのだ」。"},{"ref":"1Cor.15.33","start":46015033,"end":46015033,"break":"none","breaks":[[11,"stanza"]],"ruby":[[12,1,"わる"],[14,1,"まじ"],[19,1,"よ"]],"text":"まちがってはいけない。「悪い交わりは、良いならわしをそこなう」。"},{"ref":"1Cor.15.34","start":46015034,"end":46015034,"break":"none","ruby":[[0,1,"め"],[4,1,"み"],[6,1,"ただ"],[9,1,"つみ"],[11,1,"おか"],[34,1,"かみ"],[39,2,"むち"],[42,2,"ひとびと"],[70,1,"い"]],"text":"目ざめて身を正し、罪を犯さないようにしなさい。あなたがたのうちには、神について無知な人々がいる。あなたがたをはずかしめるために、わたしはこう言うのだ。"},{"ref":"1Cor.15.35","start":46015035,"end":46015035,"break":"paragraph","ruby":[[6,1,"ひと"],[8,1,"い"],[24,2,"しにん"],[44,1,"く"]],"text":"しかし、ある人は言うだろう。「どんなふうにして、死人がよみがえるのか。どんなからだをして来るのか」。"},{"ref":"1Cor.15.36","start":46015036,"end":46015036,"break":"none","ruby":[[4,1,"ひと"],[19,1,"し"],[26,1,"い"]],"text":"おろかな人である。あなたのまくものは、死ななければ、生かされないではないか。"},{"ref":"1Cor.15.37","start":46015037,"end":46015037,"break":"none","ruby":[[15,1,"な"],[31,1,"むぎ"],[41,1,"たね"],[51,1,"たね"],[52,1,"つぶ"]],"text":"また、あなたのまくのは、やがて成るべきからだをまくのではない。麦であっても、ほかの種であっても、ただの種粒にすぎない。"},{"ref":"1Cor.15.38","start":46015038,"end":46015038,"break":"none","ruby":[[5,1,"かみ"],[23,1,"あた"],[33,1,"たね"],[45,1,"あた"]],"text":"ところが、神はみこころのままに、これにからだを与え、その一つ一つの種にそれぞれのからだをお与えになる。"},{"ref":"1Cor.15.39","start":46015039,"end":46015039,"break":"none","ruby":[[4,1,"にく"],[7,1,"おな"],[9,1,"にく"],[17,1,"ひと"],[19,1,"にく"],[24,1,"けもの"],[26,1,"にく"],[31,1,"とり"],[33,1,"にく"],[38,1,"さかな"],[40,1,"にく"]],"text":"すべての肉が、同じ肉なのではない。人の肉があり、獣の肉があり、鳥の肉があり、魚の肉がある。"},{"ref":"1Cor.15.40","start":46015040,"end":46015040,"break":"none","ruby":[[0,1,"てん"],[2,1,"ぞく"],[13,1,"ち"],[15,1,"ぞく"],[25,1,"てん"],[27,1,"ぞく"],[33,2,"えいこう"],[37,1,"ち"],[39,1,"ぞく"],[45,2,"えいこう"],[48,1,"ちが"]],"text":"天に属するからだもあれば、地に属するからだもある。天に属するものの栄光は、地に属するものの栄光と違っている。"},{"ref":"1Cor.15.41","start":46015041,"end":46015041,"break":"none","ruby":[[0,1,"ひ"],[2,2,"えいこう"],[8,1,"つき"],[10,2,"えいこう"],[16,1,"ほし"],[18,2,"えいこう"],[29,1,"ほし"],[33,1,"ほし"],[36,1,"あいだ"],[39,2,"えいこう"],[42,1,"さ"]],"text":"日の栄光があり、月の栄光があり、星の栄光がある。また、この星とあの星との間に、栄光の差がある。"},{"ref":"1Cor.15.42","start":46015042,"end":46015042,"break":"paragraph","ruby":[[0,2,"しにん"],[3,2,"ふっかつ"],[9,2,"どうよう"],[15,1,"く"],[25,1,"く"]],"text":"死人の復活も、また同様である。朽ちるものでまかれ、朽ちないものによみがえり、"},{"ref":"1Cor.15.43","start":46015043,"end":46015043,"break":"none","ruby":[[0,1,"いや"],[10,2,"えいこう"],[23,1,"よわ"],[32,1,"つよ"]],"text":"卑しいものでまかれ、栄光あるものによみがえり、弱いものでまかれ、強いものによみがえり、"},{"ref":"1Cor.15.44","start":46015044,"end":46015044,"break":"none","ruby":[[0,1,"にく"],[10,1,"れい"],[26,1,"にく"],[39,1,"れい"]],"text":"肉のからだでまかれ、霊のからだによみがえるのである。肉のからだがあるのだから、霊のからだもあるわけである。"},{"ref":"1Cor.15.45","start":46015045,"end":46015045,"break":"none","ruby":[[0,2,"せいしょ"],[4,2,"さいしょ"],[7,1,"ひと"],[12,1,"い"],[23,1,"か"],[38,2,"さいご"],[45,1,"いのち"],[47,1,"あた"],[50,1,"れい"]],"text":"聖書に「最初の人アダムは生きたものとなった」と書いてあるとおりである。しかし最後のアダムは命を与える霊となった。"},{"ref":"1Cor.15.46","start":46015046,"end":46015046,"break":"none","ruby":[[0,2,"さいしょ"],[9,1,"れい"],[17,1,"にく"],[28,1,"のち"],[30,1,"れい"],[35,1,"く"]],"text":"最初にあったのは、霊のものではなく肉のものであって、その後に霊のものが来るのである。"},{"ref":"1Cor.15.47","start":46015047,"end":46015047,"break":"none","ruby":[[0,1,"だい"],[3,1,"ひと"],[5,1,"ち"],[8,1,"で"],[10,1,"つち"],[12,1,"ぞく"],[15,1,"だい"],[18,1,"ひと"],[20,1,"てん"],[23,1,"く"]],"text":"第一の人は地から出て土に属し、第二の人は天から来る。"},{"ref":"1Cor.15.48","start":46015048,"end":46015048,"break":"none","ruby":[[2,1,"つち"],[4,1,"ぞく"],[7,1,"ひと"],[10,1,"つち"],[12,1,"ぞく"],[17,2,"ひとびと"],[20,1,"ひと"],[26,1,"てん"],[28,1,"ぞく"],[31,1,"ひと"],[34,1,"てん"],[36,1,"ぞく"],[41,2,"ひとびと"],[44,1,"ひと"]],"text":"この土に属する人に、土に属している人々は等しく、この天に属する人に、天に属している人々は等しいのである。"},{"ref":"1Cor.15.49","start":46015049,"end":46015049,"break":"none","ruby":[[12,1,"つち"],[14,1,"ぞく"],[19,1,"かたち"],[28,2,"どうよう"],[34,1,"てん"],[36,1,"ぞく"],[41,1,"かたち"]],"text":"すなわち、わたしたちは、土に属している形をとっているのと同様に、また天に属している形をとるであろう。"},{"ref":"1Cor.15.50","start":46015050,"end":46015050,"break":"paragraph","ruby":[[0,2,"きょうだい"],[12,1,"こと"],[14,1,"い"],[20,1,"にく"],[22,1,"ち"],[25,1,"かみ"],[27,1,"くに"],[29,1,"つ"],[40,1,"く"],[46,1,"く"],[53,1,"つ"]],"text":"兄弟たちよ。わたしはこの事を言っておく。肉と血とは神の国を継ぐことができないし、朽ちるものは朽ちないものを継ぐことがない。"},{"ref":"1Cor.15.51","start":46015051,"end":46015051,"break":"none","ruby":[[10,2,"おくぎ"],[13,1,"つ"],[28,1,"ねむ"],[30,1,"つづ"],[39,1,"おわ"],[46,1,"ひび"],[49,1,"とも"],[56,1,"あいだ"],[59,2,"いっしゅん"],[64,1,"か"]],"text":"ここで、あなたがたに奥義を告げよう。わたしたちすべては、眠り続けるのではない。終りのラッパの響きと共に、またたく間に、一瞬にして変えられる。"},{"ref":"1Cor.15.52","start":46015052,"end":46015052,"break":"none","ruby":[[10,1,"ひび"],[14,2,"しにん"],[17,1,"く"],[21,1,"もの"],[37,1,"か"]],"text":"というのは、ラッパが響いて、死人は朽ちない者によみがえらされ、わたしたちは変えられるのである。"},{"ref":"1Cor.15.53","start":46015053,"end":46015053,"break":"none","ruby":[[7,1,"く"],[13,1,"かなら"],[15,1,"く"],[22,1,"き"],[26,1,"し"],[31,1,"かなら"],[33,1,"し"],[40,1,"き"]],"text":"なぜなら、この朽ちるものは必ず朽ちないものを着、この死ぬものは必ず死なないものを着ることになるからである。"},{"ref":"1Cor.15.54","start":46015054,"end":46015054,"break":"none","ruby":[[2,1,"く"],[8,1,"く"],[15,1,"き"],[19,1,"し"],[24,1,"し"],[31,1,"き"],[36,2,"せいしょ"],[39,1,"か"],[44,2,"ことば"],[47,2,"じょうじゅ"]],"text":"この朽ちるものが朽ちないものを着、この死ぬものが死なないものを着るとき、聖書に書いてある言葉が成就するのである。"},{"ref":"1Cor.15.55","start":46015055,"end":46015055,"break":"stanza","breaks":[[15,"line"],[34,"line"]],"ruby":[[1,1,"し"],[3,2,"しょうり"],[15,1,"し"],[22,2,"しょうり"],[34,1,"し"]],"text":"「死は勝利にのまれてしまった。死よ、おまえの勝利は、どこにあるのか。死よ、おまえのとげは、どこにあるのか」。"},{"ref":"1Cor.15.56","start":46015056,"end":46015056,"break":"none","ruby":[[0,1,"し"],[5,1,"つみ"],[10,1,"つみ"],[12,1,"ちから"],[14,2,"りっぽう"]],"text":"死のとげは罪である。罪の力は律法である。"},{"ref":"1Cor.15.57","start":46015057,"end":46015057,"break":"none","ruby":[[3,2,"かんしゃ"],[13,1,"かみ"],[21,1,"しゅ"],[41,2,"しょうり"],[44,1,"たま"]],"text":"しかし感謝すべきことには、神はわたしたちの主イエス・キリストによって、わたしたちに勝利を賜わったのである。"},{"ref":"1Cor.15.58","start":46015058,"end":46015058,"break":"none","ruby":[[4,1,"あい"],[7,2,"きょうだい"],[13,1,"かた"],[15,1,"た"],[18,1,"うご"],[27,1,"ぜん"],[28,1,"りょく"],[30,1,"そそ"],[33,1,"しゅ"],[38,1,"はげ"],[44,1,"しゅ"],[57,2,"ろうく"],[78,1,"し"]],"text":"だから、愛する兄弟たちよ。堅く立って動かされず、いつも全力を注いで主のわざに励みなさい。主にあっては、あなたがたの労苦がむだになることはないと、あなたがたは知っているからである。"}]