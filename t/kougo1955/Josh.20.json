[{"ref":"Josh.20.1","start":6020001,"end":6020001,"break":"paragraph","ruby":[[3,1,"しゅ"],[10,1,"い"]],"text":"そこで主はヨシュアに言われた、"},{"ref":"Josh.20.2","start":6020002,"end":6020002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[17,1,"さき"],[30,1,"い"],[41,1,"まち"],[43,1,"えら"],[45,1,"さだ"]],"text":"「イスラエルの人々に言いなさい、『先にわたしがモーセによって言っておいた、のがれの町を選び定め、"},{"ref":"Josh.20.3","start":6020003,"end":6020003,"break":"none","ruby":[[6,1,"し"],[10,1,"ひと"],[12,1,"ころ"],[15,1,"もの"],[43,1,"う"],[45,1,"もの"],[55,2,"ばしょ"]],"text":"あやまって、知らずに人を殺した者を、そこへのがれさせなさい。これはあなたがたが、あだを討つ者をさけて、のがれる場所となるでしょう。"},{"ref":"Josh.20.4","start":6020004,"end":6020004,"break":"none","ruby":[[2,1,"ひと"],[9,1,"まち"],[18,1,"い"],[22,1,"まち"],[24,1,"もん"],[26,2,"いりぐち"],[29,1,"た"],[34,1,"まち"],[36,2,"ちょうろう"],[47,1,"の"],[64,1,"かれ"],[69,1,"ひと"],[71,1,"まち"],[73,1,"う"],[75,1,"い"],[79,2,"ばしょ"],[82,1,"あた"],[85,1,"とも"],[87,1,"す"]],"text":"その人は、これらの町の一つにのがれて行って、町の門の入口に立ち、その町の長老たちに、そのわけを述べなければならない。そうすれば、彼らはその人を町に受け入れて、場所を与え、共に住ませるであろう。"},{"ref":"Josh.20.5","start":6020005,"end":6020005,"break":"none","ruby":[[7,1,"う"],[9,1,"もの"],[11,1,"お"],[18,1,"ひと"],[20,1,"ころ"],[25,1,"もの"],[30,1,"て"],[32,1,"わた"],[41,1,"かれ"],[48,2,"りんじん"],[51,1,"ころ"],[67,1,"にく"]],"text":"たとい、あだを討つ者が追ってきても、人を殺したその者を、その手に渡してはならない。彼はあやまって隣人を殺したのであって、もとからそれを憎んでいたのではないからである。"},{"ref":"Josh.20.6","start":6020006,"end":6020006,"break":"none","ruby":[[2,1,"ひと"],[5,2,"かいしゅう"],[8,1,"まえ"],[10,1,"た"],[18,1,"う"],[30,1,"とき"],[32,1,"だい"],[33,2,"さいし"],[36,1,"し"],[43,1,"まち"],[45,1,"す"],[59,1,"のち"],[61,1,"かれ"],[63,2,"じぶん"],[66,1,"まち"],[68,2,"じぶん"],[71,1,"いえ"],[73,1,"かえ"],[76,1,"い"],[80,1,"に"],[82,1,"だ"],[89,1,"まち"],[91,1,"す"]],"text":"その人は、会衆の前に立って、さばきを受けるまで、あるいはその時の大祭司が死ぬまで、その町に住まなければならない。そして後、彼は自分の町、自分の家に帰って行って、逃げ出してきたその町に住むことができる』」。"},{"ref":"Josh.20.7","start":6020007,"end":6020007,"break":"paragraph","ruby":[[9,2,"さんち"],[29,2,"さんち"],[44,2,"さんち"],[73,1,"えら"],[75,1,"わ"]],"text":"そこで、ナフタリの山地にあるガリラヤのケデシ、エフライムの山地にあるシケム、およびユダの山地にあるキリアテ・アルバすなわちヘブロンを、これがために選び分かち、"},{"ref":"Josh.20.8","start":6020008,"end":6020008,"break":"none","ruby":[[7,1,"む"],[10,1,"がわ"],[16,1,"ひがし"],[18,1,"ほう"],[26,2,"ぶぞく"],[34,2,"こうげん"],[37,2,"あらの"],[49,2,"ぶぞく"],[70,2,"ぶぞく"],[87,1,"えら"],[89,1,"さだ"]],"text":"またヨルダンの向こう側、エリコの東の方では、ルベンの部族のうちから、高原の荒野にあるベゼル、ガドの部族のうちから、ギレアデのラモテ、マナセの部族のうちから、バシャンのゴランを選び定めた。"},{"ref":"Josh.20.9","start":6020009,"end":6020009,"break":"none","ruby":[[15,2,"ひとびと"],[26,2,"きりゅう"],[30,2,"たこく"],[32,1,"じん"],[37,1,"もう"],[42,2,"まちまち"],[58,1,"ひと"],[60,1,"ころ"],[63,1,"もの"],[75,2,"かいしゅう"],[78,1,"まえ"],[80,1,"た"],[91,1,"う"],[93,1,"もの"],[95,1,"て"],[101,1,"し"]],"text":"これらは、イスラエルのすべての人々、およびそのうちに寄留する他国人のために設けられた町々であって、すべて、あやまって人を殺した者を、そこにのがれさせ、会衆の前に立たないうちに、あだを討つ者の手にかかって死ぬことのないようにするためである。"}]