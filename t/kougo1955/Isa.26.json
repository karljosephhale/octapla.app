[{"ref":"Isa.26.1","start":23026001,"end":23026001,"break":"paragraph","breaks":[[17,"line"],[31,"line"],[43,"line"]],"ruby":[[2,1,"ひ"],[6,1,"くに"],[11,1,"うた"],[23,2,"けんご"],[26,1,"まち"],[31,1,"しゅ"],[33,1,"すくい"],[37,1,"いし"]],"text":"その日ユダの国で、この歌をうたう、「われわれは堅固な町をもつ。主は救をその石がきとし、またとりでとされる。"},{"ref":"Isa.26.2","start":23026002,"end":23026002,"break":"line","ruby":[[0,1,"もん"],[2,1,"ひら"],[6,2,"しんこう"],[9,1,"まも"],[11,1,"ただ"],[14,2,"こくみん"],[17,1,"い"]],"text":"門を開いて、信仰を守る正しい国民を入れよ。"},{"ref":"Isa.26.3","start":23026003,"end":23026003,"break":"line","breaks":[[12,"line"],[29,"line"]],"ruby":[[4,1,"まった"],[6,2,"へいあん"],[18,2,"けんご"],[24,1,"まも"],[29,1,"かれ"],[35,2,"しんらい"]],"text":"あなたは全き平安をもってこころざしの堅固なものを守られる。彼はあなたに信頼しているからである。"},{"ref":"Isa.26.4","start":23026004,"end":23026004,"break":"line","breaks":[[12,"line"]],"ruby":[[5,1,"しゅ"],[7,2,"しんらい"],[12,1,"しゅ"],[15,1,"かみ"],[22,1,"いわ"]],"text":"とこしえに主に信頼せよ、主なる神はとこしえの岩だからである。"},{"ref":"Isa.26.5","start":23026005,"end":23026005,"break":"line","breaks":[[23,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"たか"],[4,1,"ところ"],[11,1,"まち"],[13,1,"す"],[15,1,"もの"],[26,1,"ふ"],[33,1,"ち"],[35,1,"ふ"]],"text":"主は高き所、そびえたつ町に住む者をひきおろし、これを伏させ、これを地に伏させて、ちりにかえされる。"},{"ref":"Isa.26.6","start":23026006,"end":23026006,"break":"line","breaks":[[10,"line"],[21,"line"]],"ruby":[[4,1,"あし"],[6,1,"ふ"],[10,1,"まず"],[13,1,"もの"],[15,1,"あし"],[17,1,"ふ"],[21,1,"とぼ"],[24,1,"もの"],[28,1,"うえ"],[30,1,"あゆ"]],"text":"こうして足で踏まれ、貧しい者の足で踏まれ、乏しい者はその上を歩む」。"},{"ref":"Isa.26.7","start":23026007,"end":23026007,"break":"paragraph","breaks":[[13,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"みち"],[7,1,"たい"],[17,1,"ただ"],[20,1,"もの"],[22,1,"みち"]],"text":"正しい者の道は平らである。あなたは正しい者の道をなめらかにされる。"},{"ref":"Isa.26.8","start":23026008,"end":23026008,"break":"line","breaks":[[17,"line"],[31,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[14,1,"みち"],[26,1,"ま"],[28,1,"のぞ"],[36,1,"たましい"],[38,1,"した"],[48,2,"きねん"],[51,1,"な"]],"text":"主よ、あなたがさばきをなさる道で、われわれはあなたを待ち望む。われわれの魂の慕うものは、あなたの記念の名である。"},{"ref":"Isa.26.9","start":23026009,"end":23026009,"break":"line","breaks":[[12,"line"],[32,"line"],[49,"line"]],"ruby":[[2,1,"たましい"],[4,1,"よる"],[9,1,"した"],[18,1,"れい"],[28,1,"もと"],[40,1,"ち"],[42,1,"おこな"],[49,1,"よ"],[51,1,"す"],[53,1,"もの"],[55,2,"せいぎ"],[58,1,"まな"]],"text":"わが魂は夜あなたを慕い、わがうちなる霊は、せつにあなたを求める。あなたのさばきが地に行われるとき、世に住む者は正義を学ぶからである。"},{"ref":"Isa.26.10","start":23026010,"end":23026010,"break":"line","breaks":[[20,"line"],[35,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"めぐ"],[13,2,"せいぎ"],[16,1,"まな"],[20,1,"ただ"],[23,1,"ち"],[29,2,"ふぎ"],[32,1,"おこな"],[35,1,"しゅ"],[37,2,"いこう"],[40,1,"あお"]],"text":"悪しき者は恵まれても、なお正義を学ばず、正しい地にあっても不義を行い、主の威光を仰ぐことをしない。"},{"ref":"Isa.26.11","start":23026011,"end":23026011,"break":"line","breaks":[[20,"line"],[31,"line"],[52,"line"],[68,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"て"],[10,1,"たか"],[20,1,"かれ"],[26,1,"かえり"],[43,1,"たみ"],[45,1,"すく"],[49,2,"ねっしん"],[52,1,"かれ"],[55,1,"み"],[60,1,"おお"],[63,1,"は"],[68,1,"ひ"],[77,1,"てき"],[79,1,"や"],[81,1,"ほろ"]],"text":"主よ、あなたのみ手が高くあがるけれども、彼らはそれを顧みない。どうか、あなたの、おのが民を救われる熱心を彼らに見させて、大いに恥じさせ、火をもってあなたの敵を焼き滅ぼしてください。"},{"ref":"Isa.26.12","start":23026012,"end":23026012,"break":"line","breaks":[[15,"line"],[24,"line"],[36,"line"]],"ruby":[[0,1,"しゅ"],[15,2,"へいわ"],[18,1,"もう"],[50,1,"と"]],"text":"主よ、あなたはわれわれのために平和を設けられる。あなたはわれわれのためにわれわれのすべてのわざをなし遂げられた。"},{"ref":"Isa.26.13","start":23026013,"end":23026013,"break":"line","breaks":[[10,"line"],[32,"line"],[44,"line"]],"ruby":[[5,1,"かみ"],[7,1,"しゅ"],[13,2,"いがい"],[21,1,"しゅ"],[28,1,"おさ"],[48,1,"な"]],"text":"われわれの神、主よ、あなた以外のもろもろの主がわれわれを治めた。しかし、われわれはただ、あなたの名のみをあがめる。"},{"ref":"Isa.26.14","start":23026014,"end":23026014,"break":"line","breaks":[[12,"line"],[22,"line"],[40,"line"]],"ruby":[[0,1,"し"],[3,1,"もの"],[7,1,"い"],[12,2,"ぼうれい"],[15,1,"い"],[17,1,"かえ"],[30,1,"かれ"],[33,1,"ばっ"],[36,1,"ほろ"],[40,1,"かれ"],[43,1,"おも"],[45,1,"で"],[52,1,"け"],[54,1,"さ"]],"text":"死んだ者はまた生きない。亡霊は生き返らない。それで、あなたは彼らを罰して滅ぼし、彼らの思い出をことごとく消し去られた。"},{"ref":"Isa.26.15","start":23026015,"end":23026015,"break":"line","breaks":[[20,"line"],[37,"line"],[51,"line"]],"ruby":[[0,1,"しゅ"],[9,2,"こくみん"],[12,1,"ま"],[14,1,"くわ"],[26,2,"こくみん"],[29,1,"ま"],[31,1,"くわ"],[41,2,"えいこう"],[55,1,"ち"],[57,1,"さかい"],[59,2,"しほう"],[62,1,"ひろ"]],"text":"主よ、あなたはこの国民を増し加えられた。あなたはこの国民を増し加えられた。あなたは栄光をあらわされた。あなたは地の境を四方に広げられた。"},{"ref":"Isa.26.16","start":23026016,"end":23026016,"break":"paragraph","breaks":[[20,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かれ"],[6,1,"なや"],[16,1,"もと"],[20,1,"かれ"],[27,1,"こら"],[37,1,"いのり"]],"text":"主よ、彼らは悩みのとき、あなたに求めた。彼らがあなたの懲しめにあったとき、祈をささげた。"},{"ref":"Isa.26.17","start":23026017,"end":23026017,"break":"line","breaks":[[22,"line"],[36,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"おんな"],[9,1,"う"],[14,1,"ちか"],[18,1,"くる"],[24,1,"いた"],[30,1,"さけ"]],"text":"主よ、はらめる女の産むときが近づいて苦しみ、その痛みによって叫ぶように、われわれはあなたのゆえに、そのようであった。"},{"ref":"Isa.26.18","start":23026018,"end":23026018,"break":"line","breaks":[[15,"line"],[38,"line"],[55,"line"]],"ruby":[[10,1,"くる"],[23,1,"う"],[29,1,"かぜ"],[43,1,"すくい"],[45,1,"ち"],[47,1,"ほどこ"],[57,1,"よ"],[59,1,"す"],[61,1,"もの"],[63,1,"ほろ"]],"text":"われわれは、はらみ、苦しんだ。しかしわれわれの産んだものは風にすぎなかった。われわれは救を地に施すこともせず、また世に住む者を滅ぼすこともしなかった。"},{"ref":"Isa.26.19","start":23026019,"end":23026019,"break":"line","breaks":[[22,"line"],[39,"line"],[53,"line"]],"ruby":[[4,2,"ししゃ"],[7,1,"い"],[10,1,"かれ"],[18,1,"お"],[25,1,"ふ"],[27,1,"もの"],[33,1,"よろこ"],[43,1,"つゆ"],[45,1,"ひかり"],[47,1,"つゆ"],[56,2,"ぼうれい"],[59,1,"くに"],[61,1,"うえ"],[63,1,"ふ"]],"text":"あなたの死者は生き、彼らのなきがらは起きる。ちりに伏す者よ、さめて喜びうたえ。あなたの露は光の露であって、それを亡霊の国の上に降らされるからである。"},{"ref":"Isa.26.20","start":23026020,"end":23026020,"break":"paragraph","breaks":[[19,"line"],[33,"line"]],"ruby":[[5,1,"たみ"],[27,1,"と"],[29,1,"と"],[33,1,"いきどお"],[36,1,"す"],[38,1,"さ"],[47,1,"かく"]],"text":"さあ、わが民よ、あなたのへやにはいり、あなたのうしろの戸を閉じて、憤りの過ぎ去るまで、しばらく隠れよ。"},{"ref":"Isa.26.21","start":23026021,"end":23026021,"break":"line","breaks":[[16,"line"],[31,"line"],[49,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[11,1,"ところ"],[13,1,"で"],[16,1,"ち"],[18,1,"す"],[20,1,"もの"],[22,2,"ふぎ"],[25,1,"ばっ"],[31,1,"ち"],[35,1,"うえ"],[37,1,"なが"],[41,1,"ち"],[49,1,"ころ"],[53,1,"もの"]],"text":"見よ、主はそのおられる所を出て、地に住む者の不義を罰せられる。地はその上に流された血をあらわして、殺された者を、もはやおおうことがない。"}]