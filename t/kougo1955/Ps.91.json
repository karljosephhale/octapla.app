[{"ref":"Ps.91.1","start":19091001,"end":19091001,"break":"paragraph","breaks":[[11,"line"]],"ruby":[[2,1,"たか"],[4,1,"もの"],[11,1,"かく"],[13,1,"ば"],[15,1,"す"],[17,1,"ひと"],[19,3,"ぜんのうしゃ"],[23,1,"かげ"],[28,1,"ひと"]],"text":"いと高き者のもとにある隠れ場に住む人、全能者の陰にやどる人は"},{"ref":"Ps.91.2","start":19091002,"end":19091002,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"さ"],[14,1,"どころ"],[18,1,"しろ"],[22,2,"しんらい"],[30,1,"かみ"]],"text":"主に言うであろう、「わが避け所、わが城、わが信頼しまつるわが神」と。"},{"ref":"Ps.91.3","start":19091003,"end":19091003,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[16,1,"おそ"],[20,2,"えきびょう"],[24,1,"たす"],[26,1,"だ"]],"text":"主はあなたをかりゅうどのわなと、恐ろしい疫病から助け出されるからである。"},{"ref":"Ps.91.4","start":19091004,"end":19091004,"break":"line","breaks":[[20,"line"],[41,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"はね"],[26,1,"つばさ"],[28,1,"した"],[30,1,"さ"],[32,1,"どころ"],[34,1,"え"],[47,2,"おおだて"],[52,2,"こだて"]],"text":"主はその羽をもって、あなたをおおわれる。あなたはその翼の下に避け所を得るであろう。そのまことは大盾、また小盾である。"},{"ref":"Ps.91.5","start":19091005,"end":19091005,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"よる"],[6,1,"おそ"],[10,1,"もの"],[14,1,"ひる"],[16,1,"と"],[21,1,"や"],[24,1,"おそ"]],"text":"あなたは夜の恐ろしい物をも、昼に飛んでくる矢をも恐れることはない。"},{"ref":"Ps.91.6","start":19091006,"end":19091006,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"くら"],[6,1,"ある"],[11,2,"えきびょう"],[16,2,"まひる"],[19,1,"あら"],[21,1,"ほろ"],[25,1,"おそ"]],"text":"また暗やみに歩きまわる疫病をも、真昼に荒す滅びをも恐れることはない。"},{"ref":"Ps.91.7","start":19091007,"end":19091007,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[4,1,"にん"],[15,1,"たお"],[19,1,"にん"],[25,1,"みぎ"],[27,1,"たお"],[34,1,"わざわい"],[40,1,"ちか"]],"text":"たとい千人はあなたのかたわらに倒れ、万人はあなたの右に倒れても、その災はあなたに近づくことはない。"},{"ref":"Ps.91.8","start":19091008,"end":19091008,"break":"line","breaks":[[16,"line"]],"ruby":[[9,1,"め"],[14,1,"み"],[16,1,"あ"],[19,1,"もの"],[21,1,"むく"],[24,1,"み"]],"text":"あなたはただ、その目をもって見、悪しき者の報いを見るだけである。"},{"ref":"Ps.91.9","start":19091009,"end":19091009,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"さ"],[8,1,"どころ"],[14,1,"たか"],[16,1,"もの"]],"text":"あなたは主を避け所とし、いと高き者をすまいとしたので、"},{"ref":"Ps.91.10","start":19091010,"end":19091010,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"わざわい"],[6,1,"のぞ"],[10,1,"なや"],[17,2,"てんまく"],[20,1,"ちか"]],"text":"災はあなたに臨まず、悩みはあなたの天幕に近づくことはない。"},{"ref":"Ps.91.11","start":19091011,"end":19091011,"break":"line","breaks":[[21,"line"],[33,"line"]],"ruby":[[3,1,"しゅ"],[12,2,"てんし"],[17,1,"めい"],[25,1,"あゆ"],[31,1,"みち"],[37,1,"まも"]],"text":"これは主があなたのために天使たちに命じて、あなたの歩むすべての道であなたを守らせられるからである。"},{"ref":"Ps.91.12","start":19091012,"end":19091012,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[5,1,"て"],[16,1,"いし"],[18,1,"あし"],[20,1,"う"]],"text":"彼らはその手で、あなたをささえ、石に足を打ちつけることのないようにする。"},{"ref":"Ps.91.13","start":19091013,"end":19091013,"break":"line","breaks":[[16,"line"]],"ruby":[[13,1,"ふ"],[16,1,"わか"],[26,1,"あし"],[28,1,"した"],[30,1,"ふ"]],"text":"あなたはししと、まむしとを踏み、若いししと、へびとを足の下に踏みにじるであろう。"},{"ref":"Ps.91.14","start":19091014,"end":19091014,"break":"line","breaks":[[17,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[6,1,"あい"],[9,1,"はな"],[21,1,"かれ"],[23,1,"たす"],[28,1,"かれ"],[32,1,"な"],[34,1,"し"],[44,1,"かれ"],[46,1,"まも"]],"text":"彼はわたしを愛して離れないゆえに、わたしは彼を助けよう。彼はわが名を知るゆえに、わたしは彼を守る。"},{"ref":"Ps.91.15","start":19091015,"end":19091015,"break":"line","breaks":[[21,"line"],[39,"line"]],"ruby":[[0,1,"かれ"],[6,1,"よ"],[15,1,"かれ"],[17,1,"こた"],[25,1,"かれ"],[27,1,"なや"],[34,1,"とも"],[39,1,"かれ"],[41,1,"すく"],[44,1,"かれ"],[46,2,"こうえい"],[49,1,"あた"]],"text":"彼がわたしを呼ぶとき、わたしは彼に答える。わたしは彼の悩みのときに、共にいて、彼を救い、彼に光栄を与えよう。"},{"ref":"Ps.91.16","start":19091016,"end":19091016,"break":"line","breaks":[[18,"line"]],"ruby":[[4,2,"ちょうじゅ"],[10,1,"かれ"],[12,1,"み"],[14,1,"た"],[20,1,"すくい"],[22,1,"かれ"],[24,1,"しめ"]],"text":"わたしは長寿をもって彼を満ち足らせ、わが救を彼に示すであろう。"}]