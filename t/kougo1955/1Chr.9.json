[{"ref":"1Chr.9.1","start":13009001,"end":13009001,"break":"paragraph","ruby":[[17,2,"けいず"],[23,1,"かぞ"],[39,3,"れつおうき"],[56,2,"ふしん"],[67,2,"ほしゅう"]],"text":"このようにすべてのイスラエルびとは系図によって数えられた。これらはイスラエルの列王紀にしるされている。ユダはその不信のゆえにバビロンに捕囚となった。"},{"ref":"1Chr.9.2","start":13009002,"end":13009002,"break":"none","ruby":[[2,2,"りょうち"],[5,2,"まちまち"],[8,2,"さいしょ"],[11,1,"す"],[25,2,"さいし"],[35,1,"みや"],[37,1,"つか"]],"text":"その領地の町々に最初に住んだものはイスラエルびと、祭司、レビびとおよび宮に仕えるしもべたちであった。"},{"ref":"1Chr.9.3","start":13009003,"end":13009003,"break":"none","ruby":[[12,2,"しそん"],[21,2,"しそん"],[36,2,"しそん"],[39,1,"す"]],"text":"またエルサレムにはユダの子孫、ベニヤミンの子孫およびエフライムとマナセの子孫が住んでいた。"},{"ref":"1Chr.9.4","start":13009004,"end":13009004,"break":"none","ruby":[[7,1,"こ"],[12,2,"しそん"],[24,1,"こ"],[38,1,"こ"],[48,1,"こ"],[57,1,"こ"]],"text":"すなわちユダの子ペレヅの子孫のうちではアミホデの子ウタイ。アミホデはオムリの子、オムリはイムリの子、イムリはバニの子である。"},{"ref":"1Chr.9.5","start":13009005,"end":13009005,"break":"none","ruby":[[9,2,"ちょうし"],[20,1,"こ"]],"text":"シロびとのうちでは長子アサヤとそのほかの子たち。"},{"ref":"1Chr.9.6","start":13009006,"end":13009006,"break":"none","ruby":[[3,2,"しそん"],[16,2,"きょうだい"],[22,1,"にん"]],"text":"ゼラの子孫のうちではユエルとその兄弟六百九十人。"},{"ref":"1Chr.9.7","start":13009007,"end":13009007,"break":"none","ruby":[[6,2,"しそん"],[18,1,"こ"],[24,1,"こ"],[34,1,"こ"]],"text":"ベニヤミンの子孫のうちではハセヌアの子ホダビヤの子であるメシュラムの子サル、"},{"ref":"1Chr.9.8","start":13009008,"end":13009008,"break":"none","ruby":[[5,1,"こ"],[15,1,"こ"],[22,1,"こ"],[33,1,"こ"],[39,1,"こ"],[48,1,"こ"]],"text":"エロハムの子イブニヤ、ミクリの子であるウジの子エラおよびイブニヤの子リウエルの子であるシパテヤの子メシュラム、"},{"ref":"1Chr.9.9","start":13009009,"end":13009009,"break":"none","ruby":[[4,1,"かれ"],[7,2,"きょうだい"],[15,2,"けいず"],[21,1,"あ"],[30,1,"にん"],[36,2,"ひとびと"],[39,1,"みな"],[42,2,"しぞく"],[45,1,"ちょう"]],"text":"ならびに彼らの兄弟たちで、その系図によれば合わせて九百五十六人。これらの人々は皆その氏族の長であった。"},{"ref":"1Chr.9.10","start":13009010,"end":13009010,"break":"paragraph","ruby":[[0,2,"さいし"]],"text":"祭司のうちではエダヤ、ヨアリブ、ヤキン、"},{"ref":"1Chr.9.11","start":13009011,"end":13009011,"break":"none","ruby":[[8,1,"こ"],[25,1,"こ"],[37,1,"こ"],[48,1,"こ"],[60,1,"こ"],[70,1,"かみ"],[72,1,"みや"]],"text":"およびヒルキヤの子アザリヤ、ヒルキヤはメシュラムの子、メシュラムはザドクの子、ザドクはメラヨテの子、メラヨテはアヒトブの子である。アザリヤは神の宮のつかさである。"},{"ref":"1Chr.9.12","start":13009012,"end":13009012,"break":"none","ruby":[[7,1,"こ"],[22,1,"こ"],[34,1,"こ"],[46,1,"こ"],[62,1,"こ"],[74,1,"こ"],[88,1,"こ"],[101,1,"こ"]],"text":"またエロハムの子アダヤ、エロハムはパシュルの子、パシュルはマルキヤの子である。またアデエルの子はマアセヤ、アデエルはヤゼラの子、ヤゼラはメシュラムの子、メシュラムはメシレモテの子、メシレモテはインメルの子である。"},{"ref":"1Chr.9.13","start":13009013,"end":13009013,"break":"none","ruby":[[5,1,"かれ"],[8,2,"きょうだい"],[23,2,"しぞく"],[26,1,"ちょう"],[29,1,"あ"],[39,1,"にん"],[43,1,"かみ"],[45,1,"みや"],[47,1,"つとめ"],[58,1,"ちから"],[62,2,"ひとびと"]],"text":"そのほかに彼らの兄弟たちもあった。これらはその氏族の長で、合わせて一千七百六十人、みな神の宮の務をするのに、はなはだ力のある人々であった。"},{"ref":"1Chr.9.14","start":13009014,"end":13009014,"break":"paragraph","ruby":[[14,1,"こ"],[30,1,"こ"],[44,1,"こ"],[55,2,"しそん"]],"text":"レビびとのうちではハシュブの子シマヤ、ハシュブはアズリカムの子、アズリカムはハシャビヤの子で、これらはメラリの子孫である。"},{"ref":"1Chr.9.15","start":13009015,"end":13009015,"break":"none","ruby":[[24,1,"こ"],[29,1,"こ"],[36,1,"こ"]],"text":"またバクバッカル、ヘレシ、ガラル、およびアサフの子ジクリの子であるミカの子マッタニヤ、"},{"ref":"1Chr.9.16","start":13009016,"end":13009016,"break":"none","ruby":[[9,1,"こ"],[14,1,"こ"],[22,1,"こ"],[35,1,"こ"],[42,1,"こ"],[59,2,"むらざと"],[62,1,"す"],[65,1,"もの"]],"text":"ならびにエドトンの子ガラルの子であるシマヤの子オバデヤおよびエルカナの子であるアサの子ベレキヤ、エルカナはネトパびとの村里に住んだ者である。"},{"ref":"1Chr.9.17","start":13009017,"end":13009017,"break":"paragraph","ruby":[[0,1,"もん"],[2,1,"まも"],[31,2,"きょうだい"],[44,1,"ちょう"]],"text":"門を守るものはシャルム、アックブ、タルモン、アヒマンおよびその兄弟たちで、シャルムはその長であった。"},{"ref":"1Chr.9.18","start":13009018,"end":13009018,"break":"none","ruby":[[0,1,"かれ"],[2,2,"こんにち"],[6,1,"ひがし"],[8,1,"ほう"],[12,1,"おう"],[14,1,"もん"],[16,1,"まも"],[29,2,"しそん"],[34,1,"もん"],[36,1,"まも"],[38,1,"もの"]],"text":"彼は今日まで東の方にある王の門を守っている。これらはレビの子孫で営の門を守る者である。"},{"ref":"1Chr.9.19","start":13009019,"end":13009019,"break":"none","ruby":[[3,1,"こ"],[10,1,"こ"],[17,1,"こ"],[27,2,"しぞく"],[30,2,"きょうだい"],[42,2,"まくや"],[50,1,"もん"],[52,1,"まも"],[54,1,"つとめ"],[65,2,"せんぞ"],[70,1,"しゅ"],[72,1,"えい"],[82,2,"いりぐち"],[85,1,"まも"],[87,1,"もの"]],"text":"コラの子エビヤサフの子であるコレの子シャルムおよびその氏族の兄弟たちなどのコラびとは幕屋のもろもろの門を守る務をつかさどった。その先祖たちは主の営をつかさどり、その入口を守る者であった。"},{"ref":"1Chr.9.20","start":13009020,"end":13009020,"break":"none","ruby":[[6,1,"こ"],[16,1,"かれ"],[27,1,"しゅ"],[29,1,"かれ"]],"text":"エレアザルの子ピネハスが、むかし彼らのつかさであった。主は彼とともにおられた。"},{"ref":"1Chr.9.21","start":13009021,"end":13009021,"break":"none","ruby":[[6,1,"こ"],[12,2,"かいけん"],[15,2,"まくや"],[18,1,"もん"],[20,1,"まも"],[22,1,"もの"]],"text":"メシレミヤの子ゼカリヤは会見の幕屋の門を守る者であった。"},{"ref":"1Chr.9.22","start":13009022,"end":13009022,"break":"none","ruby":[[4,1,"みな"],[5,1,"えら"],[9,1,"もん"],[11,1,"まも"],[13,1,"もの"],[16,1,"あ"],[24,1,"にん"],[29,1,"かれ"],[34,2,"むらむら"],[37,2,"けいず"],[43,1,"かぞ"],[48,1,"もの"],[55,3,"せんけんしゃ"],[63,1,"かれ"],[66,1,"しょく"],[68,1,"にん"]],"text":"これらは皆選ばれて門を守る者で、合わせて二百十二人あった。彼らはその村々で系図によって数えられた者で、ダビデと先見者サムエルが彼らを職に任じたのである。"},{"ref":"1Chr.9.23","start":13009023,"end":13009023,"break":"none","ruby":[[4,1,"かれ"],[9,2,"しそん"],[12,2,"かんしゅ"],[14,1,"にん"],[19,1,"しゅ"],[21,1,"いえ"],[25,2,"まくや"],[28,1,"いえ"],[30,1,"もん"]],"text":"こうして彼らとその子孫は監守人として、主の家である幕屋の家の門をつかさどった。"},{"ref":"1Chr.9.24","start":13009024,"end":13009024,"break":"none","ruby":[[0,1,"もん"],[2,1,"まも"],[4,1,"もの"],[6,2,"とうざい"],[8,2,"なんぼく"],[11,2,"しほう"]],"text":"門を守る者は東西南北の四方にいた。"},{"ref":"1Chr.9.25","start":13009025,"end":13009025,"break":"none","ruby":[[4,2,"むらむら"],[9,2,"きょうだい"],[14,2,"なぬか"],[19,1,"かわ"],[22,1,"き"],[24,1,"かれ"],[27,1,"たす"]],"text":"またその村々にいる兄弟たちは七日ごとに代り、来て彼らを助けた。"},{"ref":"1Chr.9.26","start":13009026,"end":13009026,"break":"none","ruby":[[0,1,"もん"],[2,1,"まも"],[4,1,"もの"],[6,1,"ちょう"],[11,1,"にん"],[18,1,"かみ"],[20,1,"いえ"],[27,1,"しつ"],[29,1,"たから"]],"text":"門を守る者の長である四人のレビびとは神の家のもろもろの室と宝とをつかさどった。"},{"ref":"1Chr.9.27","start":13009027,"end":13009027,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,1,"いえ"],[7,1,"まも"],[9,1,"み"],[22,1,"やど"],[29,1,"あさ"],[36,1,"ひら"]],"text":"彼らは神の家を守る身であるから、そのまわりに宿った。そして朝ごとにこれを開くことをした。"},{"ref":"1Chr.9.28","start":13009028,"end":13009028,"break":"paragraph","ruby":[[5,1,"つとめ"],[7,1,"うつわ"],[14,1,"もの"],[20,1,"かれ"],[25,1,"かず"],[27,1,"しら"],[30,1,"たずさ"],[32,1,"はい"],[39,1,"かず"],[41,1,"しら"],[44,1,"たずさ"],[46,1,"だ"]],"text":"そのうちに務の器をつかさどる者があった。彼らはその数を調べて携え入り、またその数を調べて携え出した。"},{"ref":"1Chr.9.29","start":13009029,"end":13009029,"break":"none","ruby":[[7,1,"ひん"],[13,1,"せい"],[16,1,"うつわ"],[20,2,"むぎこ"],[26,1,"しゅ"],[28,1,"あぶら"],[30,2,"にゅうこう"],[33,2,"こうりょう"],[41,1,"もの"]],"text":"またそのほかの品、すべての聖なる器および麦粉、ぶどう酒、油、乳香、香料をつかさどる者があった。"},{"ref":"1Chr.9.30","start":13009030,"end":13009030,"break":"none","ruby":[[2,2,"さいし"],[13,2,"こうりょう"],[16,1,"ま"],[19,1,"もの"]],"text":"また祭司のともがらのうちに香料を混ぜる者があった。"},{"ref":"1Chr.9.31","start":13009031,"end":13009031,"break":"none","ruby":[[9,2,"ちょうし"],[33,1,"つく"],[35,1,"つと"]],"text":"コラびとシャルムの長子でレビびとのひとりであるマタテヤはせんべいを造る勤めをつかさどった。"},{"ref":"1Chr.9.32","start":13009032,"end":13009032,"break":"none","ruby":[[8,2,"しそん"],[15,2,"きょうだい"],[23,1,"そな"],[36,3,"あんそくにち"],[45,1,"ととの"],[48,1,"もの"]],"text":"またコハテびとの子孫であるその兄弟たちのうちに供えのパンをつかさどって、安息日ごとにこれを整える者どもがあった。"},{"ref":"1Chr.9.33","start":13009033,"end":13009033,"break":"paragraph","ruby":[[5,2,"しぞく"],[8,1,"ちょう"],[16,1,"もの"],[18,1,"うた"],[22,1,"もの"],[28,1,"みや"],[35,1,"しつ"],[37,1,"す"],[43,1,"つとめ"],[51,1,"かれ"],[54,2,"にちや"],[56,2,"じぶん"],[59,1,"つとめ"],[61,1,"したが"]],"text":"レビびとの氏族の長であるこれらの者は歌うたう者であって、宮のもろもろの室に住み、ほかの務はしなかった。彼らは日夜自分の務に従ったからである。"},{"ref":"1Chr.9.34","start":13009034,"end":13009034,"break":"none","ruby":[[9,2,"れきだい"],[12,2,"しぞく"],[15,1,"ちょう"],[26,2,"ひとびと"],[33,1,"かれ"],[42,1,"す"]],"text":"これらはレビびとの歴代の氏族の長であって、かしらたる人々であった。彼らはエルサレムに住んだ。"},{"ref":"1Chr.9.35","start":13009035,"end":13009035,"break":"paragraph","ruby":[[5,1,"ちち"],[16,1,"す"],[24,1,"つま"],[26,1,"な"]],"text":"ギベオンの父エヒエルはギベオンに住んでいた。その妻の名はマアカといった。"},{"ref":"1Chr.9.36","start":13009036,"end":13009036,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ちょうし"],[10,1,"つぎ"]],"text":"彼の長子はアブドン、次はツル、キシ、バアル、ネル、ナダブ、"},{"ref":"1Chr.9.37","start":13009037,"end":13009037,"break":"none","text":"ゲドル、アヒオ、ゼカリヤ、ミクロテである。"},{"ref":"1Chr.9.38","start":13009038,"end":13009038,"break":"none","ruby":[[10,1,"う"],[14,1,"かれ"],[19,2,"きょうだい"],[33,1,"す"],[39,2,"きょうだい"],[44,1,"む"]],"text":"ミクロテはシメアムを生んだ。彼らもその兄弟たちとともにエルサレムに住んで、その兄弟たちと向かいあっていた。"},{"ref":"1Chr.9.39","start":13009039,"end":13009039,"break":"none","ruby":[[6,1,"う"],[16,1,"う"],[47,1,"う"]],"text":"ネルはキシを生み、キシはサウルを生み、サウルはヨナタン、マルキシュア、アビナダブ、エシバアルを生んだ。"},{"ref":"1Chr.9.40","start":13009040,"end":13009040,"break":"none","ruby":[[5,1,"こ"],[23,1,"う"]],"text":"ヨナタンの子はメリバアルで、メリバアルはミカを生んだ。"},{"ref":"1Chr.9.41","start":13009041,"end":13009041,"break":"none","ruby":[[3,1,"こ"]],"text":"ミカの子らはピトン、メレク、タレアおよびアハズである。"},{"ref":"1Chr.9.42","start":13009042,"end":13009042,"break":"none","ruby":[[7,1,"う"],[30,1,"う"],[40,1,"う"]],"text":"アハズはヤラを生み、ヤラはアレメテ、アズマウテおよびジムリを生み、ジムリはモザを生み、"},{"ref":"1Chr.9.43","start":13009043,"end":13009043,"break":"none","ruby":[[7,1,"う"],[15,1,"こ"],[23,1,"こ"],[32,1,"こ"]],"text":"モザはビネアを生んだ。ビネアの子はレパヤ、その子はエレアサ、その子はアゼルである。"},{"ref":"1Chr.9.44","start":13009044,"end":13009044,"break":"none","ruby":[[5,1,"にん"],[7,1,"おとこ"],[9,1,"こ"],[17,1,"な"],[59,1,"こ"]],"text":"アゼルに六人の男の子があった。その名はアズリカム、ボケル、イシマエル、シャリヤ、オバデヤ、ハナン。これらはみなアゼルの子らであった。"}]