[{"ref":"Josh.13.1","start":6013001,"end":6013001,"break":"paragraph","ruby":[[7,1,"とし"],[9,1,"すす"],[12,1,"お"],[17,1,"しゅ"],[19,1,"かれ"],[21,1,"い"],[31,1,"とし"],[33,1,"すす"],[36,1,"お"],[41,1,"と"],[45,1,"ち"],[50,1,"おお"],[52,1,"のこ"]],"text":"さてヨシュアは年が進んで老いたが、主は彼に言われた、「あなたは年が進んで老いたが、取るべき地は、なお多く残っている。"},{"ref":"Josh.13.2","start":6013002,"end":6013002,"break":"none","ruby":[[2,1,"のこ"],[7,1,"ち"],[10,1,"つぎ"],[26,1,"ぜん"],[27,2,"ちいき"],[37,2,"ぜんど"]],"text":"その残っている地は、次のとおりである。ペリシテびとの全地域、ゲシュルびとの全土、"},{"ref":"Josh.13.3","start":6013003,"end":6013003,"break":"none","ruby":[[5,1,"ひがし"],[12,1,"きた"],[24,1,"ぞく"],[37,1,"さかい"],[41,1,"ち"],[51,1,"にん"],[53,1,"きみ"],[57,1,"ち"]],"text":"エジプトの東のシホルから北にのびて、カナンびとに属するといわれるエクロンの境までの地、ペリシテびとの五人の君たちの地、すなわち、ガザ、アシドド、アシケロン、ガテ、およびエクロン。"},{"ref":"Josh.13.4","start":6013004,"end":6013004,"break":"none","ruby":[[0,1,"みなみ"],[7,1,"ち"],[15,1,"ぜん"],[16,1,"ち"],[24,1,"ぞく"],[38,1,"さかい"],[48,2,"ぶぶん"]],"text":"南のアビびとの地、カナンびとの全地、シドンびとに属するメアラからアモリびとの境にあるアペクまでの部分。"},{"ref":"Josh.13.5","start":6013005,"end":6013005,"break":"none","ruby":[[6,1,"やま"],[23,2,"いりぐち"],[26,1,"いた"],[34,1,"ち"],[44,1,"ひがし"],[46,2,"ぜんど"]],"text":"またヘルモン山のふもとのバアルガデからハマテの入口に至るゲバルびとの地、およびレバノンの東の全土。"},{"ref":"Josh.13.6","start":6013006,"end":6013006,"break":"none","ruby":[[18,2,"さんち"],[25,1,"たみ"],[37,2,"ぜんど"],[48,1,"かれ"],[57,2,"ひとびと"],[60,1,"まえ"],[63,1,"お"],[65,1,"はら"],[76,1,"めい"],[89,1,"ち"],[97,1,"わ"],[99,1,"あた"],[103,1,"し"],[104,1,"ぎょう"]],"text":"レバノンからミスレポテ・マイムまでの山地のすべての民、すなわちシドンびとの全土。わたしはみずから彼らをイスラエルの人々の前から追い払うであろう。わたしが命じたように、あなたはその地をイスラエルに分け与えて、嗣業とさせなければならない。"},{"ref":"Josh.13.7","start":6013007,"end":6013007,"break":"none","ruby":[[7,1,"ち"],[12,2,"ぶぞく"],[20,1,"はん"],[21,2,"ぶぞく"],[25,1,"わ"],[27,1,"あた"],[31,1,"し"],[32,1,"ぎょう"]],"text":"すなわち、その地を九つの部族と、マナセの半部族とに分け与えて、嗣業とさせなければならない」。"},{"ref":"Josh.13.8","start":6013008,"end":6013008,"break":"paragraph","ruby":[[4,1,"た"],[6,1,"はん"],[7,2,"ぶぞく"],[10,1,"とも"],[32,1,"む"],[35,1,"がわ"],[37,1,"ひがし"],[39,1,"ほう"],[44,1,"し"],[45,1,"ぎょう"],[52,1,"う"],[56,1,"しゅ"],[66,1,"かれ"],[69,1,"あた"]],"text":"マナセの他の半部族と共に、ルベンびとと、ガドびととは、ヨルダンの向こう側、東の方で、その嗣業をモーセから受けた。主のしもべモーセが、彼らに与えたのは、"},{"ref":"Josh.13.9","start":6013009,"end":6013009,"break":"none","ruby":[[5,1,"たに"],[21,1,"たに"],[23,1,"なか"],[27,1,"まち"],[39,1,"あいだ"],[43,2,"こうげん"],[50,1,"ち"]],"text":"アルノンの谷のほとりにあるアロエル、および谷の中にある町から、デボンとメデバの間にある高原のすべての地。"},{"ref":"Josh.13.10","start":6013010,"end":6013010,"break":"none","ruby":[[5,1,"よ"],[7,1,"おさ"],[17,1,"おう"],[26,2,"まちまち"],[29,1,"ふく"],[38,2,"ひとびと"],[41,1,"さかい"],[45,1,"ち"]],"text":"ヘシボンで世を治めた、アモリびとの王シホンのすべての町々を含めて、アンモンの人々の境までの地。"},{"ref":"Josh.13.11","start":6013011,"end":6013011,"break":"none","ruby":[[23,2,"りょうち"],[30,1,"やま"],[32,2,"ぜんど"],[45,2,"ぜんたい"]],"text":"ギレアデと、ゲシュルびと、ならびにマアカびとの領地、ヘルモン山の全土、サルカまでのバシャン全体。"},{"ref":"Josh.13.12","start":6013012,"end":6013012,"break":"none","ruby":[[11,1,"よ"],[13,1,"おさ"],[21,1,"おう"],[25,2,"ぜんこく"],[36,1,"い"],[38,1,"のこ"],[53,1,"う"],[57,1,"お"],[59,1,"はら"]],"text":"アシタロテとエデレイで世を治めたバシャンの王オグの全国。オグはレパイムの生き残りであった。モーセはこれらを撃って、追い払った。"},{"ref":"Josh.13.13","start":6013013,"end":6013013,"break":"none","ruby":[[10,2,"ひとびと"],[28,1,"お"],[30,1,"はら"],[52,2,"こんにち"],[65,1,"す"]],"text":"ただし、イスラエルの人々は、ゲシュルびとと、マアカびとを追い払わなかった。ゲシュルびとと、マアカびとは、今日までイスラエルのうちに住んでいる。"},{"ref":"Josh.13.14","start":6013014,"end":6013014,"break":"paragraph","ruby":[[5,2,"ぶぞく"],[18,1,"し"],[19,1,"ぎょう"],[22,1,"あた"],[35,1,"かみ"],[37,1,"しゅ"],[39,2,"かさい"],[42,1,"かれ"],[45,1,"し"],[46,1,"ぎょう"],[56,1,"しゅ"],[63,1,"い"]],"text":"ただレビの部族には、ヨシュアはなんの嗣業をも与えなかった。イスラエルの神、主の火祭が彼らの嗣業であるからである。主がヨシュアに言われたとおりである。"},{"ref":"Josh.13.15","start":6013015,"end":6013015,"break":"paragraph","ruby":[[10,2,"ぶぞく"],[16,2,"かぞく"],[24,1,"し"],[25,1,"ぎょう"],[27,1,"あた"]],"text":"モーセはルベンびとの部族に、その家族にしたがって嗣業を与えたが、"},{"ref":"Josh.13.16","start":6013016,"end":6013016,"break":"none","ruby":[[2,2,"りょういき"],[10,1,"たに"],[26,1,"たに"],[28,1,"なか"],[32,1,"まち"],[47,2,"こうげん"]],"text":"その領域はアルノンの谷のほとりにあるアロエル、および谷の中にある町からメデバのほとりのすべての高原、"},{"ref":"Josh.13.17","start":6013017,"end":6013017,"break":"none","ruby":[[9,2,"こうげん"],[16,2,"まちまち"]],"text":"ヘシボンおよびその高原のすべての町々、デボン、バモテ・バアル、ベテ・バアル・メオン、"},{"ref":"Josh.13.18","start":6013018,"end":6013018,"break":"none","text":"ヤハヅ、ケデモテ、メパアテ、"},{"ref":"Josh.13.19","start":6013019,"end":6013019,"break":"none","ruby":[[11,1,"たに"],[13,1,"なか"],[15,1,"やま"]],"text":"キリアタイム、シブマ、谷の中の山にあるゼレテ・シャハル、"},{"ref":"Josh.13.20","start":6013020,"end":6013020,"break":"none","ruby":[[10,2,"さんぷく"]],"text":"ベテペオル、ピスガの山腹、ベテエシモテ、"},{"ref":"Josh.13.21","start":6013021,"end":6013021,"break":"none","ruby":[[4,2,"こうげん"],[11,2,"まちまち"],[20,1,"よ"],[22,1,"おさ"],[31,1,"おう"],[36,2,"ぜんこく"],[39,1,"およ"],[80,1,"とも"],[82,1,"う"],[84,1,"ころ"],[98,2,"しょこう"],[107,1,"ち"],[109,1,"す"],[114,1,"もの"]],"text":"すなわち高原のすべての町々と、ヘシボンで世を治めたアモリびとの王シホンの全国に及んだ。モーセはシホンを、ミデアンのつかさたちエビ、レケム、ツル、ホルおよびレバと共に撃ち殺した。これらはみなシホンの諸侯であって、その地に住んでいた者である。"},{"ref":"Josh.13.22","start":6013022,"end":6013022,"break":"none","ruby":[[6,2,"ひとびと"],[15,1,"こ"],[17,1,"うらな"],[19,1,"し"],[38,1,"ころ"],[41,1,"もの"],[45,1,"とも"],[47,1,"ころ"]],"text":"イスラエルの人々はまたベオルの子、占い師バラムをもつるぎにかけて、そのほかに殺した者どもと共に殺した。"},{"ref":"Josh.13.23","start":6013023,"end":6013023,"break":"none","ruby":[[6,2,"りょういき"],[14,1,"さかい"],[31,2,"かぞく"],[39,1,"え"],[41,1,"し"],[42,1,"ぎょう"],[50,2,"まちまち"],[53,2,"むらむら"],[57,1,"ふく"]],"text":"ルベンびとの領域はヨルダンを境とした。これはルベンびとが、その家族にしたがって獲た嗣業であって、その町々と村々とを含む。"},{"ref":"Josh.13.24","start":6013024,"end":6013024,"break":"paragraph","ruby":[[9,2,"ぶぞく"],[15,2,"しそん"],[22,2,"かぞく"],[31,1,"し"],[32,1,"ぎょう"],[34,1,"あた"]],"text":"モーセはまたガドの部族、ガドの子孫にも、その家族にしたがって、嗣業を与えたが、"},{"ref":"Josh.13.25","start":6013025,"end":6013025,"break":"none","ruby":[[2,2,"りょういき"],[18,2,"まちまち"],[28,1,"ち"],[30,1,"なか"],[37,1,"ひがし"],[46,1,"ち"]],"text":"その領域はヤゼル、ギレアデのすべての町々、アンモンびとの地の半ばで、ラバの東のアロエルまでの地。"},{"ref":"Josh.13.26","start":6013026,"end":6013026,"break":"none","ruby":[[16,1,"ち"],[37,1,"さかい"],[41,1,"ち"]],"text":"ヘシボンからラマテ・ミゾパまでの地、およびベトニム、マハナイムからデビルの境までの地。"},{"ref":"Josh.13.27","start":6013027,"end":6013027,"break":"none","ruby":[[0,1,"たに"],[2,1,"なか"],[35,1,"おう"],[40,1,"くに"],[42,1,"のこ"],[45,2,"ぶぶん"],[53,1,"さかい"],[63,2,"ひがしがわ"],[72,1,"みずうみ"],[74,1,"みなみ"],[76,1,"はし"],[80,1,"ち"]],"text":"谷の中ではベテハラム、ベテニムラ、スコテ、およびザポンなど、ヘシボンの王シホンの国の残りの部分。ヨルダンを境として、ヨルダンの東側、キンネレテの湖の南の端までの地。"},{"ref":"Josh.13.28","start":6013028,"end":6013028,"break":"none","ruby":[[11,2,"かぞく"],[19,1,"え"],[21,1,"し"],[22,1,"ぎょう"],[30,2,"まちまち"],[33,2,"むらむら"],[37,1,"ふく"]],"text":"これはガドびとが、その家族にしたがって獲た嗣業であって、その町々と村々とを含む。"},{"ref":"Josh.13.29","start":6013029,"end":6013029,"break":"paragraph","ruby":[[10,1,"はん"],[11,2,"ぶぞく"],[16,1,"し"],[17,1,"ぎょう"],[19,1,"あた"],[31,1,"はん"],[32,2,"ぶぞく"],[38,2,"かぞく"],[46,1,"あた"]],"text":"モーセはまたマナセの半部族にも、嗣業を与えたが、それはマナセの半部族が、その家族にしたがって与えられたものである。"},{"ref":"Josh.13.30","start":6013030,"end":6013030,"break":"none","ruby":[[2,2,"りょういき"],[17,2,"ぜんど"],[20,1,"およ"],[28,1,"おう"],[32,2,"ぜんこく"],[50,2,"まちまち"],[62,1,"まち"]],"text":"その領域はマハナイムからバシャンの全土に及び、バシャンの王オグの全国、バシャンにあるヤイルのすべての町々、すなわちその六十の町。"},{"ref":"Josh.13.31","start":6013031,"end":6013031,"break":"none","ruby":[[7,1,"なか"],[18,1,"くに"],[20,1,"まち"],[43,1,"こ"],[48,2,"しそん"],[51,1,"あた"],[65,2,"しそん"],[68,1,"なか"],[74,2,"かぞく"],[86,1,"え"]],"text":"またギレアデの半ば、バシャンのオグの国の町であるアシタロテとエデレイ。これらはマナセの子マキルの子孫に与えられた。すなわちマキルの子孫の半ばが、その家族にしたがって、それを獲た。"},{"ref":"Josh.13.32","start":6013032,"end":6013032,"break":"paragraph","ruby":[[9,1,"む"],[12,1,"がわ"],[18,1,"ひがし"],[24,2,"へいや"],[32,1,"わ"],[34,1,"あた"],[37,1,"し"],[38,1,"ぎょう"]],"text":"これらはヨルダンの向こう側、エリコの東のモアブの平野で、モーセが分け与えた嗣業である。"},{"ref":"Josh.13.33","start":6013033,"end":6013033,"break":"none","ruby":[[7,2,"ぶぞく"],[19,1,"し"],[20,1,"ぎょう"],[23,1,"あた"],[36,1,"かみ"],[38,1,"しゅ"],[42,1,"し"],[43,1,"ぎょう"],[51,1,"しゅ"],[57,1,"い"]],"text":"ただし、レビの部族には、モーセはなんの嗣業をも与えなかった。イスラエルの神、主がその嗣業だからである。主がモーセに言われたとおりである。"}]