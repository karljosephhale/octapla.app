[{"ref":"Eph.2.1","start":49002001,"end":49002001,"break":"paragraph","ruby":[[9,1,"さき"],[12,2,"じぶん"],[15,2,"ざいか"],[18,1,"つみ"],[24,1,"し"],[29,1,"もの"]],"text":"さてあなたがたは、先には自分の罪過と罪とによって死んでいた者であって、"},{"ref":"Eph.2.2","start":49002002,"end":49002002,"break":"none","ruby":[[8,1,"なか"],[13,1,"よ"],[20,1,"したが"],[23,2,"くうちゅう"],[26,1,"けん"],[30,1,"きみ"],[37,1,"ふ"],[38,2,"じゅうじゅん"],[41,1,"こ"],[44,1,"なか"],[46,1,"いま"],[48,1,"はたら"],[53,1,"れい"],[55,1,"したが"],[59,1,"ある"]],"text":"かつてはそれらの中で、この世のならわしに従い、空中の権をもつ君、すなわち、不従順の子らの中に今も働いている霊に従って、歩いていたのである。"},{"ref":"Eph.2.3","start":49002003,"end":49002003,"break":"none","ruby":[[16,1,"かれ"],[19,1,"なか"],[24,1,"にく"],[26,1,"よく"],[28,1,"したが"],[31,1,"ひ"],[33,1,"す"],[37,1,"にく"],[41,1,"おも"],[45,1,"ほっ"],[51,1,"おこな"],[57,2,"ひとびと"],[60,1,"おな"],[64,1,"うま"],[70,1,"いか"],[73,1,"こ"]],"text":"また、わたしたちもみな、かつては彼らの中にいて、肉の欲に従って日を過ごし、肉とその思いとの欲するままを行い、ほかの人々と同じく、生れながらの怒りの子であった。"},{"ref":"Eph.2.4","start":49002004,"end":49002004,"break":"none","ruby":[[10,1,"と"],[12,1,"かみ"],[21,1,"あい"],[24,1,"くだ"],[30,1,"おお"],[33,1,"あい"]],"text":"しかるに、あわれみに富む神は、わたしたちを愛して下さったその大きな愛をもって、"},{"ref":"Eph.2.5","start":49002005,"end":49002005,"break":"none","ruby":[[0,2,"ざいか"],[6,1,"し"],[23,1,"とも"],[25,1,"い"],[36,1,"すく"],[43,1,"めぐ"]],"text":"罪過によって死んでいたわたしたちを、キリストと共に生かし――あなたがたの救われたのは、恵みによるのである――"},{"ref":"Eph.2.6","start":49002006,"end":49002006,"break":"none","ruby":[[13,1,"とも"],[22,1,"とも"],[24,2,"てんじょう"],[27,1,"ざ"],[33,1,"くだ"]],"text":"キリスト・イエスにあって、共によみがえらせ、共に天上で座につかせて下さったのである。"},{"ref":"Eph.2.7","start":49002007,"end":49002007,"break":"none","ruby":[[22,1,"たま"],[26,2,"じあい"],[31,1,"かみ"],[33,1,"めぐ"],[36,2,"ぜつだい"],[39,1,"とみ"],[47,2,"よよ"],[50,1,"しめ"]],"text":"それは、キリスト・イエスにあってわたしたちに賜わった慈愛による神の恵みの絶大な富を、きたるべき世々に示すためであった。"},{"ref":"Eph.2.8","start":49002008,"end":49002008,"break":"none","ruby":[[6,1,"すく"],[13,1,"じつ"],[16,1,"めぐ"],[22,2,"しんこう"],[41,2,"じしん"],[45,1,"で"],[54,1,"かみ"],[56,2,"たまもの"]],"text":"あなたがたの救われたのは、実に、恵みにより、信仰によるのである。それは、あなたがた自身から出たものではなく、神の賜物である。"},{"ref":"Eph.2.9","start":49002009,"end":49002009,"break":"none","ruby":[[0,1,"けっ"],[3,1,"おこな"],[21,1,"ほこ"]],"text":"決して行いによるのではない。それは、だれも誇ることがないためなのである。"},{"ref":"Eph.2.10","start":49002010,"end":49002010,"break":"none","ruby":[[6,1,"かみ"],[8,2,"さくひん"],[15,1,"よ"],[17,1,"おこな"],[38,1,"つく"],[47,1,"かみ"],[57,1,"よ"],[59,1,"おこな"],[64,1,"ひ"],[66,1,"す"],[79,1,"そな"],[82,1,"くだ"]],"text":"わたしたちは神の作品であって、良い行いをするように、キリスト・イエスにあって造られたのである。神は、わたしたちが、良い行いをして日を過ごすようにと、あらかじめ備えて下さったのである。"},{"ref":"Eph.2.11","start":49002011,"end":49002011,"break":"paragraph","ruby":[[4,2,"きおく"],[20,2,"いぜん"],[25,1,"にく"],[30,3,"いほうじん"],[38,1,"て"],[40,1,"おこな"],[43,1,"にく"],[45,2,"かつれい"],[49,1,"もの"],[51,1,"しょう"],[56,2,"ひとびと"],[62,1,"む"],[63,2,"かつれい"],[66,1,"もの"],[68,1,"よ"]],"text":"だから、記憶しておきなさい。あなたがたは以前には、肉によれば異邦人であって、手で行った肉の割礼ある者と称せられる人々からは、無割礼の者と呼ばれており、"},{"ref":"Eph.2.12","start":49002012,"end":49002012,"break":"none","ruby":[[4,2,"とうじ"],[13,1,"し"],[23,2,"こくせき"],[29,2,"やくそく"],[39,2,"けいやく"],[42,1,"えん"],[49,1,"よ"],[51,1,"なか"],[53,2,"きぼう"],[58,1,"かみ"],[62,1,"もの"]],"text":"またその当時は、キリストを知らず、イスラエルの国籍がなく、約束されたいろいろの契約に縁がなく、この世の中で希望もなく神もない者であった。"},{"ref":"Eph.2.13","start":49002013,"end":49002013,"break":"none","ruby":[[17,2,"いぜん"],[20,1,"とお"],[22,1,"はな"],[29,1,"いま"],[50,1,"ち"],[55,1,"ちか"]],"text":"ところが、あなたがたは、このように以前は遠く離れていたが、今ではキリスト・イエスにあって、キリストの血によって近いものとなったのである。"},{"ref":"Eph.2.14","start":49002014,"end":49002014,"break":"none","ruby":[[11,2,"へいわ"],[29,2,"てきい"],[34,1,"へだ"],[37,2,"なかがき"],[40,1,"と"],[42,1,"のぞ"],[46,2,"じぶん"],[49,1,"にく"]],"text":"キリストはわたしたちの平和であって、二つのものを一つにし、敵意という隔ての中垣を取り除き、ご自分の肉によって、"},{"ref":"Eph.2.15","start":49002015,"end":49002015,"break":"none","ruby":[[0,2,"かずかず"],[3,2,"きてい"],[7,1,"な"],[12,1,"いまし"],[15,2,"りっぽう"],[18,2,"はいき"],[31,1,"かれ"],[47,1,"あたら"],[50,1,"ひと"],[52,1,"つく"],[57,2,"へいわ"]],"text":"数々の規定から成っている戒めの律法を廃棄したのである。それは、彼にあって、二つのものをひとりの新しい人に造りかえて平和をきたらせ、"},{"ref":"Eph.2.16","start":49002016,"end":49002016,"break":"none","ruby":[[0,3,"じゅうじか"],[23,1,"かみ"],[25,2,"わかい"],[30,2,"てきい"],[33,3,"じゅうじか"],[40,1,"ほろ"]],"text":"十字架によって、二つのものを一つのからだとして神と和解させ、敵意を十字架にかけて滅ぼしてしまったのである。"},{"ref":"Eph.2.17","start":49002017,"end":49002017,"break":"none","ruby":[[4,1,"かれ"],[11,1,"うえ"],[14,1,"とお"],[16,1,"はな"],[27,2,"へいわ"],[30,1,"の"],[32,1,"つた"],[37,1,"ちか"],[42,1,"もの"],[47,2,"へいわ"],[50,1,"の"],[52,1,"つた"]],"text":"それから彼は、こられた上で、遠く離れているあなたがたに平和を宣べ伝え、また近くにいる者たちにも平和を宣べ伝えられたのである。"},{"ref":"Eph.2.18","start":49002018,"end":49002018,"break":"none","ruby":[[6,1,"かれ"],[17,2,"りょうほう"],[20,1,"もの"],[25,2,"みたま"],[28,1,"なか"],[34,1,"ちち"],[40,1,"ちか"]],"text":"というのは、彼によって、わたしたち両方の者が一つの御霊の中にあって、父のみもとに近づくことができるからである。"},{"ref":"Eph.2.19","start":49002019,"end":49002019,"break":"none","ruby":[[13,3,"いこくじん"],[18,1,"やど"],[20,1,"びと"],[26,2,"せいと"],[31,1,"おな"],[33,2,"こくせき"],[36,1,"もの"],[41,1,"かみ"],[43,2,"かぞく"]],"text":"そこであなたがたは、もはや異国人でも宿り人でもなく、聖徒たちと同じ国籍の者であり、神の家族なのである。"},{"ref":"Eph.2.20","start":49002020,"end":49002020,"break":"none","ruby":[[9,2,"しと"],[14,3,"よげんしゃ"],[22,2,"どだい"],[25,1,"うえ"],[27,1,"た"],[48,2,"じしん"],[51,1,"すみ"],[56,1,"いし"]],"text":"またあなたがたは、使徒たちや預言者たちという土台の上に建てられたものであって、キリスト・イエスご自身が隅のかしら石である。"},{"ref":"Eph.2.21","start":49002021,"end":49002021,"break":"none","ruby":[[11,2,"たてもの"],[13,2,"ぜんたい"],[16,1,"く"],[18,1,"あ"],[23,1,"しゅ"],[27,1,"せい"],[30,1,"みや"],[32,2,"せいちょう"]],"text":"このキリストにあって、建物全体が組み合わされ、主にある聖なる宮に成長し、"},{"ref":"Eph.2.22","start":49002022,"end":49002022,"break":"none","ruby":[[10,1,"しゅ"],[15,1,"とも"],[17,1,"た"],[23,1,"れい"],[26,1,"かみ"]],"text":"そしてあなたがたも、主にあって共に建てられて、霊なる神のすまいとなるのである。"}]