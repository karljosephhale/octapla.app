[{"ref":"1Sam.15.1","start":9015001,"end":9015001,"break":"paragraph","ruby":[[12,1,"い"],[17,1,"しゅ"],[33,1,"あぶら"],[42,1,"たみ"],[49,1,"おう"],[62,1,"いま"],[64,1,"しゅ"],[66,2,"ことば"],[69,1,"き"]],"text":"さて、サムエルはサウルに言った、「主は、わたしをつかわし、あなたに油をそそいで、その民イスラエルの王とされました。それゆえ、今、主の言葉を聞きなさい。"},{"ref":"1Sam.15.2","start":9015002,"end":9015002,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[8,1,"おお"],[33,1,"こと"],[51,1,"のぼ"],[56,1,"とき"],[60,2,"とちゅう"],[63,2,"てきたい"],[73,1,"かれ"],[76,1,"ばっ"]],"text":"万軍の主は、こう仰せられる、『わたしは、アマレクがイスラエルにした事、すなわちイスラエルがエジプトから上ってきた時、その途中で敵対したことについて彼らを罰するであろう。"},{"ref":"1Sam.15.3","start":9015003,"end":9015003,"break":"none","ruby":[[0,1,"いま"],[2,1,"い"],[10,1,"う"],[19,1,"も"],[21,1,"もの"],[23,1,"ほろ"],[30,1,"かれ"],[38,1,"おとこ"],[40,1,"おんな"],[43,1,"おさ"],[45,1,"こ"],[47,2,"ちの"],[50,1,"ご"],[53,1,"うし"],[55,1,"ひつじ"],[66,1,"みな"],[68,1,"ころ"]],"text":"今、行ってアマレクを撃ち、そのすべての持ち物を滅ぼしつくせ。彼らをゆるすな。男も女も、幼な子も乳飲み子も、牛も羊も、らくだも、ろばも皆、殺せ』」。"},{"ref":"1Sam.15.4","start":9015004,"end":9015004,"break":"paragraph","ruby":[[4,1,"たみ"],[6,1,"よ"],[8,1,"あつ"],[16,2,"にんずう"],[19,1,"しら"],[26,2,"ほへい"],[36,1,"ひと"]],"text":"サウルは民を呼び集め、テライムで人数を調べたところ、歩兵は二十万、ユダの人は一万であった。"},{"ref":"1Sam.15.5","start":9015005,"end":9015005,"break":"none","ruby":[[12,1,"まち"],[14,1,"い"],[18,1,"たに"],[20,1,"へい"],[22,1,"ふ"]],"text":"そしてサウルはアマレクの町へ行って、谷に兵を伏せた。"},{"ref":"1Sam.15.6","start":9015006,"end":9015006,"break":"none","ruby":[[9,1,"い"],[30,1,"はな"],[34,1,"くだ"],[45,1,"かれ"],[48,2,"いっしょ"],[57,1,"ほろ"],[88,2,"ひとびと"],[97,1,"のぼ"],[102,1,"とき"],[104,2,"しんせつ"],[134,1,"はな"],[137,1,"い"]],"text":"サウルはケニびとに言った、「さあ、あなたがたはアマレクびとを離れて、下っていってください。彼らと一緒にあなたがたを滅ぼすようなことがあってはならない。あなたがたは、イスラエルの人々がエジプトから上ってきた時、親切にしてくれたのですから」。そこでケニびとはアマレクびとを離れて行った。"},{"ref":"1Sam.15.7","start":9015007,"end":9015007,"break":"none","ruby":[[11,1,"う"],[25,1,"ひがし"],[35,1,"およ"]],"text":"サウルはアマレクびとを撃って、ハビラからエジプトの東にあるシュルにまで及んだ。"},{"ref":"1Sam.15.8","start":9015008,"end":9015008,"break":"none","ruby":[[10,1,"おう"],[29,1,"たみ"],[36,1,"ほろ"]],"text":"そしてアマレクびとの王アガグをいけどり、つるぎをもってその民をことごとく滅ぼした。"},{"ref":"1Sam.15.9","start":9015009,"end":9015009,"break":"none","ruby":[[7,1,"たみ"],[19,1,"ひつじ"],[21,1,"うし"],[23,1,"もっと"],[25,1,"よ"],[30,1,"こ"],[39,2,"こひつじ"],[47,1,"よ"],[52,1,"のこ"],[59,1,"ほろ"],[62,1,"つく"],[67,1,"この"],[73,1,"ね"],[85,1,"もの"],[87,1,"ほろ"],[90,1,"つく"]],"text":"しかしサウルと民はアガグをゆるし、また羊と牛の最も良いもの、肥えたものならびに小羊と、すべての良いものを残し、それらを滅ぼし尽すことを好まず、ただ値うちのない、つまらない物を滅ぼし尽した。"},{"ref":"1Sam.15.10","start":9015010,"end":9015010,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,2,"ことば"],[14,1,"のぞ"]],"text":"その時、主の言葉がサムエルに臨んだ、"},{"ref":"1Sam.15.11","start":9015011,"end":9015011,"break":"none","ruby":[[9,1,"おう"],[16,1,"く"],[20,1,"かれ"],[31,1,"したが"],[39,2,"ことば"],[42,1,"おこな"],[60,1,"いか"],[64,2,"よどお"],[68,1,"しゅ"],[70,1,"よ"]],"text":"「わたしはサウルを王としたことを悔いる。彼がそむいて、わたしに従わず、わたしの言葉を行わなかったからである」。サムエルは怒って、夜通し、主に呼ばわった。"},{"ref":"1Sam.15.12","start":9015012,"end":9015012,"break":"none","ruby":[[3,1,"あさ"],[8,1,"あ"],[13,1,"はや"],[15,1,"お"],[25,1,"つ"],[28,1,"ひと"],[47,2,"じぶん"],[53,2,"せんしょう"],[55,3,"きねんひ"],[59,1,"た"],[62,1,"み"],[68,1,"すす"],[76,1,"くだ"],[79,1,"い"]],"text":"そして朝サウルに会うため、早く起きたが、サムエルに告げる人があった、「サウルはカルメルにきて、自分のために戦勝記念碑を建て、身をかえして進み、ギルガルへ下って行きました」。"},{"ref":"1Sam.15.13","start":9015013,"end":9015013,"break":"none","ruby":[[12,1,"く"],[20,1,"かれ"],[22,1,"い"],[31,1,"しゅ"],[37,2,"しゅくふく"],[51,1,"しゅ"],[53,2,"ことば"],[56,2,"じっこう"]],"text":"サムエルがサウルのもとへ来ると、サウルは彼に言った、「どうぞ、主があなたを祝福されますように。わたしは主の言葉を実行しました」。"},{"ref":"1Sam.15.14","start":9015014,"end":9015014,"break":"none","ruby":[[5,1,"い"],[20,1,"みみ"],[28,1,"ひつじ"],[30,1,"こえ"],[37,1,"き"],[39,1,"うし"],[41,1,"こえ"]],"text":"サムエルは言った、「それならば、わたしの耳にはいる、この羊の声と、わたしの聞く牛の声は、いったい、なんですか」。"},{"ref":"1Sam.15.15","start":9015015,"end":9015015,"break":"none","ruby":[[4,1,"い"],[9,2,"ひとびと"],[19,1,"ところ"],[22,1,"ひ"],[31,1,"たみ"],[38,1,"かみ"],[40,1,"しゅ"],[50,1,"ひつじ"],[52,1,"うし"],[54,1,"もっと"],[56,1,"よ"],[61,1,"のこ"],[79,1,"ほろ"],[82,1,"つく"]],"text":"サウルは言った、「人々がアマレクびとの所から引いてきたのです。民は、あなたの神、主にささげるために、羊と牛の最も良いものを残したのです。そのほかは、われわれが滅ぼし尽しました」。"},{"ref":"1Sam.15.16","start":9015016,"end":9015016,"break":"none","ruby":[[9,1,"い"],[21,2,"さくや"],[24,1,"しゅ"],[30,1,"い"],[42,1,"つ"],[54,1,"かれ"],[56,1,"い"],[61,1,"い"]],"text":"サムエルはサウルに言った、「おやめなさい。昨夜、主がわたしに言われたことを、あなたに告げましょう」。サウルは彼に言った、「言ってください」。"},{"ref":"1Sam.15.17","start":9015017,"end":9015017,"break":"paragraph","ruby":[[5,1,"い"],[14,2,"じぶん"],[18,1,"ちい"],[22,1,"おも"],[37,3,"しょぶぞく"],[41,1,"ちょう"],[51,1,"しゅ"],[57,1,"あぶら"],[59,1,"そそ"],[68,1,"おう"]],"text":"サムエルは言った、「たとい、自分では小さいと思っても、あなたはイスラエルの諸部族の長ではありませんか。主はあなたに油を注いでイスラエルの王とされた。"},{"ref":"1Sam.15.18","start":9015018,"end":9015018,"break":"none","ruby":[[3,1,"しゅ"],[9,2,"しめい"],[12,1,"さづ"],[20,1,"い"],[26,1,"い"],[30,1,"つみ"],[42,1,"ほろ"],[45,1,"つく"],[48,1,"かれ"],[51,2,"みなごろ"],[59,1,"たたか"]],"text":"そして主はあなたに使命を授け、つかわして言われた、『行って、罪びとなるアマレクびとを滅ぼし尽せ。彼らを皆殺しにするまで戦え』。"},{"ref":"1Sam.15.19","start":9015019,"end":9015019,"break":"none","ruby":[[16,1,"しゅ"],[18,1,"こえ"],[20,1,"き"],[22,1,"したが"],[32,1,"もの"],[40,1,"しゅ"],[42,1,"め"],[44,1,"まえ"],[46,1,"あく"]],"text":"それであるのに、どうしてあなたは主の声に聞き従わないで、ぶんどり物にとびかかり、主の目の前に悪をおこなったのですか」。"},{"ref":"1Sam.15.20","start":9015020,"end":9015020,"break":"none","ruby":[[9,1,"い"],[18,1,"しゅ"],[20,1,"こえ"],[22,1,"き"],[24,1,"したが"],[27,1,"しゅ"],[35,2,"しめい"],[38,1,"お"],[41,1,"い"],[49,1,"おう"],[54,1,"つ"],[67,1,"ほろ"],[70,1,"つく"]],"text":"サウルはサムエルに言った、「わたしは主の声に聞き従い、主がつかわされた使命を帯びて行き、アマレクの王アガグを連れてきて、アマレクびとを滅ぼし尽しました。"},{"ref":"1Sam.15.21","start":9015021,"end":9015021,"break":"none","ruby":[[3,1,"たみ"],[5,1,"ほろ"],[8,1,"つく"],[17,1,"もっと"],[19,1,"よ"],[35,1,"かみ"],[37,1,"しゅ"],[50,1,"もの"],[56,1,"ひつじ"],[58,1,"うし"],[60,1,"と"]],"text":"しかし民は滅ぼし尽すべきもののうち最も良いものを、ギルガルで、あなたの神、主にささげるため、ぶんどり物のうちから羊と牛を取りました」。"},{"ref":"1Sam.15.22","start":9015022,"end":9015022,"break":"none","breaks":[[9,"stanza"],[32,"line"],[48,"line"],[63,"line"]],"ruby":[[5,1,"い"],[10,1,"しゅ"],[15,2,"ことば"],[18,1,"き"],[20,1,"したが"],[22,1,"こと"],[24,1,"よろこ"],[32,2,"はんさい"],[35,2,"ぎせい"],[38,1,"よろこ"],[48,1,"み"],[51,1,"したが"],[56,2,"ぎせい"],[63,1,"き"],[68,2,"おひつじ"],[71,2,"しぼう"]],"text":"サムエルは言った、「主はそのみ言葉に聞き従う事を喜ばれるように、燔祭や犠牲を喜ばれるであろうか。見よ、従うことは犠牲にまさり、聞くことは雄羊の脂肪にまさる。"},{"ref":"1Sam.15.23","start":9015023,"end":9015023,"break":"line","breaks":[[15,"line"],[34,"line"],[50,"line"]],"ruby":[[6,1,"うらな"],[9,1,"つみ"],[11,1,"ひと"],[15,2,"ごうじょう"],[18,2,"ぐうぞう"],[20,2,"れいはい"],[23,1,"つみ"],[25,1,"ひと"],[38,1,"しゅ"],[44,1,"す"],[50,1,"しゅ"],[58,1,"す"],[62,1,"おう"],[64,1,"くらい"],[67,1,"しりぞ"]],"text":"そむくことは占いの罪に等しく、強情は偶像礼拝の罪に等しいからである。あなたが主のことばを捨てたので、主もまたあなたを捨てて、王の位から退けられた」。"},{"ref":"1Sam.15.24","start":9015024,"end":9015024,"break":"paragraph","ruby":[[9,1,"い"],[18,1,"しゅ"],[20,2,"めいれい"],[27,2,"ことば"],[34,1,"つみ"],[36,1,"おか"],[42,1,"たみ"],[44,1,"おそ"],[50,1,"こえ"],[52,1,"き"],[54,1,"したが"]],"text":"サウルはサムエルに言った、「わたしは主の命令とあなたの言葉にそむいて罪を犯しました。民を恐れて、その声に聞き従ったからです。"},{"ref":"1Sam.15.25","start":9015025,"end":9015025,"break":"none","ruby":[[4,1,"いま"],[9,1,"つみ"],[19,2,"いっしょ"],[22,1,"かえ"],[26,1,"しゅ"],[28,1,"おが"]],"text":"どうぞ、今わたしの罪をゆるし、わたしと一緒に帰って、主を拝ませてください」。"},{"ref":"1Sam.15.26","start":9015026,"end":9015026,"break":"none","ruby":[[9,1,"い"],[18,2,"いっしょ"],[21,1,"かえ"],[31,1,"しゅ"],[33,2,"ことば"],[36,1,"す"],[42,1,"しゅ"],[48,1,"す"],[58,2,"おうい"],[62,1,"しりぞ"]],"text":"サムエルはサウルに言った、「あなたと一緒に帰りません。あなたが主の言葉を捨てたので、主もあなたを捨てて、イスラエルの王位から退けられたからです」。"},{"ref":"1Sam.15.27","start":9015027,"end":9015027,"break":"none","ruby":[[9,1,"さ"],[15,1,"み"],[21,1,"とき"],[32,2,"うわぎ"],[38,1,"とら"],[47,1,"さ"]],"text":"こうしてサムエルが去ろうとして身をかえした時、サウルがサムエルの上着のすそを捕えたので、それは裂けた。"},{"ref":"1Sam.15.28","start":9015028,"end":9015028,"break":"none","ruby":[[5,1,"かれ"],[7,1,"い"],[12,1,"しゅ"],[29,2,"おうこく"],[32,1,"さ"],[38,1,"よ"],[44,2,"りんじん"],[47,1,"あた"]],"text":"サムエルは彼に言った、「主はきょう、あなたからイスラエルの王国を裂き、もっと良いあなたの隣人に与えられた。"},{"ref":"1Sam.15.29","start":9015029,"end":9015029,"break":"none","ruby":[[8,2,"えいこう"],[11,1,"いつわ"],[19,1,"く"],[28,1,"かれ"],[30,1,"ひと"],[37,1,"く"]],"text":"またイスラエルの栄光は偽ることもなく、悔いることもない。彼は人ではないから悔いることはない」。"},{"ref":"1Sam.15.30","start":9015030,"end":9015030,"break":"none","ruby":[[4,1,"い"],[13,1,"つみ"],[15,1,"おか"],[26,1,"たみ"],[28,2,"ちょうろう"],[42,1,"まえ"],[49,1,"たっと"],[56,2,"いっしょ"],[59,1,"かえ"],[67,1,"かみ"],[69,1,"しゅ"],[71,1,"おが"]],"text":"サウルは言った、「わたしは罪を犯しましたが、どうぞ、民の長老たち、およびイスラエルの前で、わたしを尊び、わたしと一緒に帰って、あなたの神、主を拝ませてください」。"},{"ref":"1Sam.15.31","start":9015031,"end":9015031,"break":"none","ruby":[[18,1,"かえ"],[29,1,"しゅ"],[31,1,"おが"]],"text":"そこでサムエルはサウルのあとについて帰った。そしてサウルは主を拝んだ。"},{"ref":"1Sam.15.32","start":9015032,"end":9015032,"break":"paragraph","ruby":[[0,1,"とき"],[7,1,"い"],[16,1,"ところ"],[25,1,"おう"],[30,1,"ひ"],[54,1,"ところ"],[64,1,"し"],[66,1,"くる"],[73,1,"す"],[75,1,"さ"],[82,1,"おも"]],"text":"時にサムエルは言った、「わたしの所にアマレクびとの王アガグを引いてきなさい」。アガグはうれしそうにサムエルの所にきた。アガグは「死の苦しみはきっと過ぎ去ったのだ」と思った。"},{"ref":"1Sam.15.33","start":9015033,"end":9015033,"break":"none","ruby":[[5,1,"い"],[18,1,"おお"],[21,1,"おんな"],[23,2,"こども"],[26,1,"うしな"],[40,1,"はは"],[42,1,"おんな"],[47,1,"もっと"],[49,2,"むざん"],[52,2,"こども"],[55,1,"うしな"],[57,1,"もの"],[77,1,"しゅ"],[79,1,"まえ"],[86,2,"すんだん"]],"text":"サムエルは言った、「あなたのつるぎは多くの女に子供を失わせた。そのようにあなたの母も女のうちで最も無惨に子供を失う者となるであろう」。サムエルはギルガルで主の前に、アガグを寸断した。"},{"ref":"1Sam.15.34","start":9015034,"end":9015034,"break":"paragraph","ruby":[[11,1,"い"],[18,2,"こきょう"],[25,1,"のぼ"],[31,1,"いえ"],[33,1,"かえ"]],"text":"そしてサムエルはラマに行き、サウルは故郷のギベアに上って、その家に帰った。"},{"ref":"1Sam.15.35","start":9015035,"end":9015035,"break":"none","ruby":[[5,1,"し"],[7,1,"ひ"],[12,1,"ど"],[18,1,"み"],[39,1,"かな"],[46,1,"しゅ"],[58,1,"おう"],[65,1,"く"]],"text":"サムエルは死ぬ日まで、二度とサウルを見なかった。しかしサムエルはサウルのために悲しんだ。また主はサウルをイスラエルの王としたことを悔いられた。"}]