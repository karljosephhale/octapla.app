[{"ref":"Eph.1.1","start":49001001,"end":49001001,"break":"paragraph","ruby":[[0,1,"かみ"],[2,2,"みむね"],[16,2,"しと"],[43,2,"ちゅうじつ"],[46,2,"せいと"]],"text":"神の御旨によるキリスト・イエスの使徒パウロから、エペソにいる、キリスト・イエスにあって忠実な聖徒たちへ。"},{"ref":"Eph.1.2","start":49001002,"end":49001002,"break":"paragraph","ruby":[[6,1,"ちち"],[9,1,"かみ"],[11,1,"しゅ"],[23,1,"めぐ"],[26,2,"へいあん"]],"text":"わたしたちの父なる神と主イエス・キリストから、恵みと平安とが、あなたがたにあるように。"},{"ref":"Eph.1.3","start":49001003,"end":49001003,"break":"paragraph","ruby":[[13,1,"しゅ"],[23,1,"ちち"],[26,1,"かみ"],[28,1,"かみ"],[39,2,"てんじょう"],[42,1,"れい"],[49,2,"しゅくふく"],[62,2,"しゅくふく"]],"text":"ほむべきかな、わたしたちの主イエス・キリストの父なる神。神はキリストにあって、天上で霊のもろもろの祝福をもって、わたしたちを祝福し、"},{"ref":"Eph.1.4","start":49001004,"end":49001004,"break":"none","ruby":[[7,1,"きず"],[11,1,"もの"],[20,2,"てんち"],[23,1,"つく"],[27,1,"まえ"],[45,1,"えら"]],"text":"みまえにきよく傷のない者となるようにと、天地の造られる前から、キリストにあってわたしたちを選び、"},{"ref":"Eph.1.5","start":49001005,"end":49001005,"break":"none","ruby":[[19,1,"かみ"],[21,1,"こ"],[24,2,"みぶん"],[27,1,"さづ"],[35,2,"みむね"],[47,1,"したが"],[50,1,"あい"],[60,1,"さだ"],[63,1,"くだ"]],"text":"わたしたちに、イエス・キリストによって神の子たる身分を授けるようにと、御旨のよしとするところに従い、愛のうちにあらかじめ定めて下さったのである。"},{"ref":"Eph.1.6","start":49001006,"end":49001006,"break":"none","ruby":[[6,1,"あい"],[9,2,"みこ"],[15,1,"たま"],[19,2,"えいこう"],[23,1,"めぐ"]],"text":"これは、その愛する御子によって賜わった栄光ある恵みを、わたしたちがほめたたえるためである。"},{"ref":"Eph.1.7","start":49001007,"end":49001007,"break":"none","ruby":[[7,2,"みこ"],[14,1,"かみ"],[16,1,"ゆた"],[19,1,"めぐ"],[28,1,"ち"],[42,2,"ざいか"],[49,1,"う"]],"text":"わたしたちは、御子にあって、神の豊かな恵みのゆえに、その血によるあがない、すなわち、罪過のゆるしを受けたのである。"},{"ref":"Eph.1.8","start":49001008,"end":49001008,"break":"none","ruby":[[0,1,"かみ"],[4,1,"めぐ"],[10,1,"ま"],[12,1,"くわ"],[20,2,"ちえ"],[23,1,"さと"],[33,1,"たま"]],"text":"神はその恵みをさらに増し加えて、あらゆる知恵と悟りとをわたしたちに賜わり、"},{"ref":"Eph.1.9","start":49001009,"end":49001009,"break":"none","ruby":[[0,2,"みむね"],[3,2,"おくぎ"],[7,1,"みずか"],[14,1,"さだ"],[19,2,"けいかく"],[22,1,"したが"],[32,1,"しめ"],[35,1,"くだ"]],"text":"御旨の奥義を、自らあらかじめ定められた計画に従って、わたしたちに示して下さったのである。"},{"ref":"Eph.1.10","start":49001010,"end":49001010,"break":"none","ruby":[[4,1,"とき"],[6,1,"み"],[10,1,"およ"],[13,2,"じつげん"],[19,2,"けいかく"],[36,1,"かみ"],[38,1,"てん"],[44,1,"ち"],[69,1,"き"]],"text":"それは、時の満ちるに及んで実現されるご計画にほかならない。それによって、神は天にあるもの地にあるものを、ことごとく、キリストにあって一つに帰せしめようとされたのである。"},{"ref":"Eph.1.11","start":49001011,"end":49001011,"break":"none","ruby":[[7,2,"みむね"],[10,1,"ほっ"],[20,1,"こと"],[28,2,"もくてき"],[31,1,"もと"],[47,1,"さだ"],[52,1,"かみ"],[54,1,"たみ"],[58,1,"えら"]],"text":"わたしたちは、御旨の欲するままにすべての事をなさるかたの目的の下に、キリストにあってあらかじめ定められ、神の民として選ばれたのである。"},{"ref":"Eph.1.12","start":49001012,"end":49001012,"break":"none","ruby":[[4,1,"はや"],[13,1,"のぞ"],[28,1,"かみ"],[30,2,"えいこう"],[39,1,"もの"]],"text":"それは、早くからキリストに望みをおいているわたしたちが、神の栄光をほめたたえる者となるためである。"},{"ref":"Eph.1.13","start":49001013,"end":49001013,"break":"none","ruby":[[18,2,"しんり"],[21,2,"ことば"],[35,1,"すくい"],[37,2,"ふくいん"],[40,1,"き"],[46,1,"かれ"],[48,1,"しん"],[51,2,"けっか"],[54,2,"やくそく"],[59,2,"せいれい"],[62,2,"しょういん"]],"text":"あなたがたもまた、キリストにあって、真理の言葉、すなわち、あなたがたの救の福音を聞き、また、彼を信じた結果、約束された聖霊の証印をおされたのである。"},{"ref":"Eph.1.14","start":49001014,"end":49001014,"break":"none","ruby":[[2,2,"せいれい"],[12,1,"かみ"],[14,1,"くに"],[21,2,"ほしょう"],[31,1,"かみ"],[36,1,"もの"],[38,1,"まった"],[46,1,"かみ"],[48,2,"えいこう"],[58,1,"いた"]],"text":"この聖霊は、わたしたちが神の国をつぐことの保証であって、やがて神につける者が全くあがなわれ、神の栄光をほめたたえるに至るためである。"},{"ref":"Eph.1.15","start":49001015,"end":49001015,"break":"paragraph","ruby":[[13,1,"しゅ"],[18,1,"たい"],[27,2,"しんこう"],[35,2,"せいと"],[38,1,"たい"],[41,1,"あい"],[44,1,"みみ"]],"text":"こういうわけで、わたしも、主イエスに対するあなたがたの信仰と、すべての聖徒に対する愛とを耳にし、"},{"ref":"Eph.1.16","start":49001016,"end":49001016,"break":"none","ruby":[[4,1,"いのり"],[17,1,"おぼ"],[21,1,"た"],[33,2,"かんしゃ"]],"text":"わたしの祈のたびごとにあなたがたを覚えて、絶えずあなたがたのために感謝している。"},{"ref":"Eph.1.17","start":49001017,"end":49001017,"break":"none","ruby":[[10,1,"しゅ"],[20,1,"かみ"],[22,2,"えいこう"],[25,1,"ちち"],[28,2,"ちえ"],[31,2,"けいじ"],[35,1,"れい"],[43,1,"たま"],[47,1,"かみ"],[49,1,"みと"]],"text":"どうか、わたしたちの主イエス・キリストの神、栄光の父が、知恵と啓示との霊をあなたがたに賜わって神を認めさせ、"},{"ref":"Eph.1.18","start":49001018,"end":49001018,"break":"none","ruby":[[6,1,"こころ"],[8,1,"め"],[10,1,"あき"],[16,1,"くだ"],[33,1,"かみ"],[35,1,"め"],[45,1,"のぞ"],[58,2,"せいと"],[67,1,"かみ"],[69,1,"くに"],[74,2,"えいこう"],[77,1,"と"]],"text":"あなたがたの心の目を明らかにして下さるように、そして、あなたがたが神に召されていだいている望みがどんなものであるか、聖徒たちがつぐべき神の国がいかに栄光に富んだものであるか、"},{"ref":"Eph.1.19","start":49001019,"end":49001019,"break":"none","ruby":[[3,1,"かみ"],[5,2,"ちからづよ"],[8,2,"かつどう"],[14,1,"はたら"],[16,1,"ちから"],[24,1,"しん"],[27,1,"もの"],[35,2,"ぜつだい"],[52,1,"し"],[55,1,"いた"],[62,1,"いの"]],"text":"また、神の力強い活動によって働く力が、わたしたち信じる者にとっていかに絶大なものであるかを、あなたがたが知るに至るように、と祈っている。"},{"ref":"Eph.1.20","start":49001020,"end":49001020,"break":"none","ruby":[[0,1,"かみ"],[4,1,"ちから"],[14,1,"はたら"],[19,1,"かれ"],[21,2,"しにん"],[24,1,"なか"],[34,2,"てんじょう"],[41,2,"じぶん"],[44,1,"みぎ"],[46,1,"ざ"]],"text":"神はその力をキリストのうちに働かせて、彼を死人の中からよみがえらせ、天上においてご自分の右に座せしめ、"},{"ref":"Eph.1.21","start":49001021,"end":49001021,"break":"none","ruby":[[0,1,"かれ"],[7,2,"しはい"],[10,2,"けんい"],[13,2,"けんりょく"],[16,2,"けんせい"],[19,1,"うえ"],[29,1,"よ"],[41,1,"よ"],[47,1,"とな"],[57,1,"な"],[59,1,"うえ"]],"text":"彼を、すべての支配、権威、権力、権勢の上におき、また、この世ばかりでなくきたるべき世においても唱えられる、あらゆる名の上におかれたのである。"},{"ref":"Eph.1.22","start":49001022,"end":49001022,"break":"none","ruby":[[4,2,"ばんぶつ"],[12,1,"あし"],[14,1,"した"],[16,1,"したが"],[20,1,"かれ"],[22,2,"ばんぶつ"],[25,1,"うえ"],[33,2,"きょうかい"],[36,1,"あた"]],"text":"そして、万物をキリストの足の下に従わせ、彼を万物の上にかしらとして教会に与えられた。"},{"ref":"Eph.1.23","start":49001023,"end":49001023,"break":"none","ruby":[[2,2,"きょうかい"],[36,1,"み"],[46,1,"み"]],"text":"この教会はキリストのからだであって、すべてのものを、すべてのもののうちに満たしているかたが、満ちみちているものに、ほかならない。"}]