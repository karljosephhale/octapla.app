[{"ref":"2Thess.1.1","start":53001001,"end":53001001,"break":"paragraph","ruby":[[21,1,"ちち"],[24,1,"かみ"],[26,1,"しゅ"],[44,1,"びと"],[48,2,"きょうかい"]],"text":"パウロとシルワノとテモテから、わたしたちの父なる神と主イエス・キリストとにあるテサロニケ人たちの教会へ。"},{"ref":"2Thess.1.2","start":53001002,"end":53001002,"break":"paragraph","ruby":[[0,1,"ちち"],[3,1,"かみ"],[5,1,"しゅ"],[17,1,"めぐ"],[20,2,"へいあん"]],"text":"父なる神と主イエス・キリストから、恵みと平安とが、あなたがたにあるように。"},{"ref":"2Thess.1.3","start":53001003,"end":53001003,"break":"paragraph","ruby":[[0,2,"きょうだい"],[25,1,"かみ"],[27,2,"かんしゃ"],[47,2,"とうぜん"],[63,2,"しんこう"],[66,1,"おお"],[69,2,"せいちょう"],[85,1,"あい"],[89,1,"たがい"],[91,1,"あいだ"],[93,1,"ま"],[95,1,"くわ"]],"text":"兄弟たちよ。わたしたちは、いつもあなたがたのことを神に感謝せずにはおられない。またそうするのが当然である。それは、あなたがたの信仰が大いに成長し、あなたがたひとりびとりの愛が、お互の間に増し加わっているからである。"},{"ref":"2Thess.1.4","start":53001004,"end":53001004,"break":"none","ruby":[[11,2,"じしん"],[23,1,"う"],[32,2,"はくがい"],[35,2,"かんなん"],[41,1,"なか"],[43,1,"しめ"],[48,2,"にんたい"],[51,2,"しんこう"],[58,1,"かみ"],[60,1,"しょ"],[61,2,"きょうかい"],[64,1,"たい"],[73,1,"ほこり"]],"text":"そのために、わたしたち自身は、あなたがたがいま受けているあらゆる迫害と患難とのただ中で示している忍耐と信仰とにつき、神の諸教会に対してあなたがたを誇としている。"},{"ref":"2Thess.1.5","start":53001005,"end":53001005,"break":"none","ruby":[[11,1,"かみ"],[13,1,"くに"],[20,1,"もの"],[28,1,"かみ"],[34,1,"ただ"],[41,2,"しょうこ"],[54,1,"かみ"],[56,1,"くに"],[68,1,"くる"]],"text":"これは、あなたがたを、神の国にふさわしい者にしようとする神のさばきが正しいことを、証拠だてるものである。その神の国のために、あなたがたも苦しんでいるのである。"},{"ref":"2Thess.1.6","start":53001006,"end":53001006,"break":"none","ruby":[[11,1,"なや"],[14,1,"もの"],[17,2,"かんなん"],[23,1,"むく"],[26,1,"なや"],[47,1,"とも"],[50,2,"きゅうそく"],[56,1,"むく"],[59,1,"くだ"],[65,1,"かみ"],[70,1,"ただ"]],"text":"すなわち、あなたがたを悩ます者には患難をもって報い、悩まされているあなたがたには、わたしたちと共に、休息をもって報いて下さるのが、神にとって正しいことだからである。"},{"ref":"2Thess.1.7","start":53001007,"end":53001007,"break":"none","ruby":[[4,1,"しゅ"],[9,1,"ほのお"],[11,1,"なか"],[13,1,"ちから"],[16,2,"てんし"],[21,1,"ひき"],[24,1,"てん"],[27,1,"あらわ"],[30,1,"とき"],[32,2,"じつげん"]],"text":"それは、主イエスが炎の中で力ある天使たちを率いて天から現れる時に実現する。"},{"ref":"2Thess.1.8","start":53001008,"end":53001008,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,1,"かみ"],[8,1,"みと"],[12,1,"もの"],[23,1,"しゅ"],[28,2,"ふくいん"],[31,1,"き"],[33,1,"したが"],[37,1,"もの"],[41,2,"ほうふく"]],"text":"その時、主は神を認めない者たちや、わたしたちの主イエスの福音に聞き従わない者たちに報復し、"},{"ref":"2Thess.1.9","start":53001009,"end":53001009,"break":"none","ruby":[[4,1,"かれ"],[7,1,"しゅ"],[10,1,"かお"],[14,1,"ちから"],[16,2,"えいこう"],[20,1,"しりぞ"],[26,2,"えいえん"],[29,1,"ほろ"],[32,1,"いた"],[34,2,"けいばつ"],[37,1,"う"]],"text":"そして、彼らは主のみ顔とその力の栄光から退けられて、永遠の滅びに至る刑罰を受けるであろう。"},{"ref":"2Thess.1.10","start":53001010,"end":53001010,"break":"none","ruby":[[2,1,"ひ"],[9,1,"くだ"],[16,2,"せいと"],[21,1,"なか"],[32,1,"しん"],[35,1,"もの"],[39,1,"あいだ"],[41,2,"きょうたん"],[74,1,"しん"]],"text":"その日に、イエスは下ってこられ、聖徒たちの中であがめられ、すべて信じる者たちの間で驚嘆されるであろう――わたしたちのこのあかしは、あなたがたによって信じられているのである。"},{"ref":"2Thess.1.11","start":53001011,"end":53001011,"break":"none","ruby":[[21,1,"かみ"],[29,1,"め"],[35,1,"もの"],[40,1,"ぜん"],[42,1,"たい"],[49,1,"ねが"],[52,2,"しんこう"],[55,1,"はたら"],[59,2,"ちからづよ"],[62,1,"み"],[66,1,"くだ"],[83,1,"た"],[86,1,"いの"]],"text":"このためにまた、わたしたちは、わたしたちの神があなたがたを召しにかなう者となし、善に対するあらゆる願いと信仰の働きとを力強く満たして下さるようにと、あなたがたのために絶えず祈っている。"},{"ref":"2Thess.1.12","start":53001012,"end":53001012,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[23,1,"めぐ"],[36,1,"しゅ"],[41,2,"みな"],[50,1,"あいだ"],[64,1,"しゅ"],[69,2,"えいこう"],[72,1,"う"]],"text":"それは、わたしたちの神と主イエス・キリストとの恵みによって、わたしたちの主イエスの御名があなたがたの間であがめられ、あなたがたも主にあって栄光を受けるためである。"}]