[{"ref":"Isa.2.1","start":23002001,"end":23002001,"break":"paragraph","ruby":[[4,1,"こ"],[21,1,"しめ"],[25,2,"ことば"]],"text":"アモツの子イザヤがユダとエルサレムについて示された言葉。"},{"ref":"Isa.2.2","start":23002002,"end":23002002,"break":"stanza","breaks":[[13,"line"],[20,"line"],[38,"line"],[53,"line"]],"ruby":[[0,1,"おわ"],[3,1,"ひ"],[5,1,"つぎ"],[10,1,"おこ"],[13,1,"しゅ"],[15,1,"いえ"],[17,1,"やま"],[25,1,"やま"],[33,1,"かた"],[35,1,"た"],[43,1,"みね"],[47,1,"たか"],[56,1,"くに"],[61,1,"なが"]],"text":"終りの日に次のことが起る。主の家の山は、もろもろの山のかしらとして堅く立ち、もろもろの峰よりも高くそびえ、すべて国はこれに流れてき、"},{"ref":"Isa.2.3","start":23002003,"end":23002003,"break":"line","breaks":[[10,"line"],[26,"line"],[38,"line"],[55,"line"],[70,"line"],[80,"line"]],"ruby":[[0,1,"おお"],[3,1,"たみ"],[5,1,"き"],[7,1,"い"],[19,1,"しゅ"],[21,1,"やま"],[23,1,"のぼ"],[30,1,"かみ"],[32,1,"いえ"],[34,1,"い"],[38,1,"かれ"],[42,1,"みち"],[49,1,"おし"],[62,1,"みち"],[64,1,"あゆ"],[70,2,"りっぽう"],[78,1,"で"],[80,1,"しゅ"],[82,2,"ことば"],[92,1,"で"]],"text":"多くの民は来て言う、「さあ、われわれは主の山に登り、ヤコブの神の家へ行こう。彼はその道をわれわれに教えられる、われわれはその道に歩もう」と。律法はシオンから出、主の言葉はエルサレムから出るからである。"},{"ref":"Isa.2.4","start":23002004,"end":23002004,"break":"line","breaks":[[20,"line"],[36,"line"],[60,"line"],[76,"line"],[93,"line"]],"ruby":[[0,1,"かれ"],[7,1,"くに"],[17,1,"おこな"],[20,1,"おお"],[23,1,"たみ"],[28,2,"ちゅうさい"],[31,1,"た"],[40,1,"かれ"],[49,1,"う"],[65,1,"う"],[76,1,"くに"],[78,1,"くに"],[93,1,"かれ"],[99,1,"たたか"],[105,1,"まな"]],"text":"彼はもろもろの国のあいだにさばきを行い、多くの民のために仲裁に立たれる。こうして彼らはそのつるぎを打ちかえて、すきとし、そのやりを打ちかえて、かまとし、国は国にむかって、つるぎをあげず、彼らはもはや戦いのことを学ばない。"},{"ref":"Isa.2.5","start":23002005,"end":23002005,"break":"paragraph","breaks":[[7,"line"]],"ruby":[[4,1,"いえ"],[15,1,"しゅ"],[17,1,"ひかり"],[19,1,"あゆ"]],"text":"ヤコブの家よ、さあ、われわれは主の光に歩もう。"},{"ref":"Isa.2.6","start":23002006,"end":23002006,"break":"paragraph","breaks":[[21,"line"],[44,"line"],[61,"line"]],"ruby":[[8,1,"たみ"],[13,1,"いえ"],[15,1,"す"],[24,1,"かれ"],[27,1,"ひがし"],[29,1,"くに"],[33,1,"うらな"],[35,1,"し"],[40,1,"み"],[54,1,"うらな"],[56,1,"しゃ"],[61,2,"がいこく"],[63,1,"じん"],[65,2,"どうめい"],[68,1,"むす"]],"text":"あなたはあなたの民ヤコブの家を捨てられた。これは彼らが東の国からの占い師をもって満たし、ペリシテびとのように占い者となり、外国人と同盟を結んだからである。"},{"ref":"Isa.2.7","start":23002007,"end":23002007,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[3,1,"くに"],[6,2,"きんぎん"],[9,1,"み"],[14,2,"ざいほう"],[17,1,"かぎ"],[24,1,"かれ"],[27,1,"くに"],[30,1,"うま"],[32,1,"み"],[37,2,"せんしゃ"],[40,1,"かぎ"]],"text":"彼らの国には金銀が満ち、その財宝は限りない。また彼らの国には馬が満ち、その戦車も限りない。"},{"ref":"Isa.2.8","start":23002008,"end":23002008,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[2,1,"かれ"],[5,1,"くに"],[8,2,"ぐうぞう"],[11,1,"み"],[14,1,"かれ"],[19,1,"て"],[24,1,"おが"],[29,1,"ゆび"],[31,1,"つく"],[37,1,"おが"]],"text":"また彼らの国には偶像が満ち、彼らはその手のわざを拝み、その指で作ったものを拝む。"},{"ref":"Isa.2.9","start":23002009,"end":23002009,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"ひと"],[12,2,"ひとびと"],[15,1,"ひく"],[24,1,"かれ"]],"text":"こうして人はかがめられ、人々は低くされる。どうか彼らをおゆるしにならぬように。"},{"ref":"Isa.2.10","start":23002010,"end":23002010,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"いわ"],[6,1,"あいだ"],[15,1,"なか"],[22,1,"しゅ"],[24,1,"おそ"],[29,1,"まえ"],[34,2,"いこう"],[37,1,"かがや"],[41,1,"さ"]],"text":"あなたは岩の間にはいり、ちりの中にかくれて、主の恐るべきみ前と、その威光の輝きとを避けよ。"},{"ref":"Isa.2.11","start":23002011,"end":23002011,"break":"line","breaks":[[21,"line"],[32,"line"]],"ruby":[[2,1,"ひ"],[5,1,"め"],[10,1,"たか"],[13,1,"もの"],[15,1,"ひく"],[24,1,"ひと"],[32,1,"しゅ"],[35,1,"たか"]],"text":"その日には目をあげて高ぶる者は低くせられ、おごる人はかがめられ、主のみ高くあげられる。"},{"ref":"Isa.2.12","start":23002012,"end":23002012,"break":"paragraph","breaks":[[16,"line"],[28,"line"],[47,"line"]],"ruby":[[4,2,"ばんぐん"],[7,1,"しゅ"],[10,1,"にち"],[19,1,"ほこ"],[21,1,"もの"],[23,1,"たか"],[26,1,"もの"],[35,1,"たか"],[39,1,"もの"],[41,2,"とくい"],[44,1,"もの"],[47,1,"のぞ"]],"text":"これは、万軍の主の一日があって、すべて誇る者と高ぶる者、すべておのれを高くする者と得意な者とに臨むからである。"},{"ref":"Isa.2.13","start":23002013,"end":23002013,"break":"line","breaks":[[20,"line"]],"ruby":[[7,1,"たか"],[17,2,"こうはく"],[32,1,"き"]],"text":"またレバノンの高くそびえるすべての香柏、バシャンのすべてのかしの木、"},{"ref":"Isa.2.14","start":23002014,"end":23002014,"break":"line","breaks":[[11,"line"]],"ruby":[[6,1,"たか"],[8,2,"やまやま"],[18,1,"た"],[20,2,"みねみね"]],"text":"またすべての高い山々、すべてのそびえ立つ峰々、"},{"ref":"Isa.2.15","start":23002015,"end":23002015,"break":"line","breaks":[[10,"line"]],"ruby":[[4,1,"たか"],[14,2,"けんご"],[17,2,"じょうへき"]],"text":"すべての高きやぐら、すべての堅固な城壁、"},{"ref":"Isa.2.16","start":23002016,"end":23002016,"break":"line","breaks":[[11,"line"]],"ruby":[[9,1,"ふね"],[15,1,"うるわ"],[18,2,"せんぱく"],[21,1,"のぞ"]],"text":"タルシシのすべての船、すべての麗しい船舶に臨む。"},{"ref":"Isa.2.17","start":23002017,"end":23002017,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[2,1,"ひ"],[5,1,"たか"],[8,1,"もの"],[19,1,"ひと"],[21,1,"ひく"],[27,1,"しゅ"],[30,1,"たか"]],"text":"その日には高ぶる者はかがめられ、おごる人は低くせられ、主のみ高くあげられる。"},{"ref":"Isa.2.18","start":23002018,"end":23002018,"break":"line","ruby":[[4,2,"ぐうぞう"],[12,1,"ほろ"]],"text":"こうして偶像はことごとく滅びうせる。"},{"ref":"Isa.2.19","start":23002019,"end":23002019,"break":"line","breaks":[[15,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"た"],[5,1,"ち"],[7,1,"おびや"],[15,2,"ひとびと"],[18,1,"いわ"],[22,1,"あな"],[30,1,"ち"],[32,1,"あな"],[39,1,"しゅ"],[41,1,"おそ"],[46,1,"まえ"],[51,2,"いこう"],[54,1,"かがや"],[58,1,"さ"]],"text":"主が立って地を脅かされるとき、人々は岩のほら穴にはいり、また地の穴にはいって、主の恐るべきみ前と、その威光の輝きとを避ける。"},{"ref":"Isa.2.20","start":23002020,"end":23002020,"break":"line","breaks":[[19,"line"],[37,"line"]],"ruby":[[2,1,"ひ"],[4,2,"ひとびと"],[7,1,"おが"],[16,1,"つく"],[24,2,"ぐうぞう"],[32,2,"ぐうぞう"],[49,1,"な"],[51,1,"あた"]],"text":"その日、人々は拝むためにみずから造ったしろがねの偶像と、こがねの偶像とを、もぐらもちと、こうもりに投げ与え、"},{"ref":"Isa.2.21","start":23002021,"end":23002021,"break":"line","breaks":[[18,"line"],[33,"line"]],"ruby":[[0,1,"いわ"],[4,1,"あな"],[10,1,"さ"],[12,1,"め"],[18,1,"しゅ"],[20,1,"た"],[23,1,"ち"],[25,1,"おびや"],[33,1,"しゅ"],[35,1,"おそ"],[40,1,"まえ"],[45,2,"いこう"],[48,1,"かがや"],[52,1,"さ"]],"text":"岩のほら穴や、がけの裂け目にはいり、主が立って地を脅かされるとき、主の恐るべきみ前と、その威光の輝きとを避ける。"},{"ref":"Isa.2.22","start":23002022,"end":23002022,"break":"line","breaks":[[19,"line"],[29,"line"]],"ruby":[[6,1,"はな"],[9,1,"いき"],[11,2,"でい"],[16,1,"ひと"],[34,1,"もの"],[39,2,"かち"]],"text":"あなたがたは鼻から息の出入りする人に、たよることをやめよ、このような者はなんの価値があろうか。"}]