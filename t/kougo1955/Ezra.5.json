[{"ref":"Ezra.5.1","start":15005001,"end":15005001,"break":"paragraph","ruby":[[2,3,"よげんしゃ"],[14,1,"こ"],[24,3,"よげんしゃ"],[43,1,"ひと"],[45,1,"む"],[50,1,"かれ"],[53,1,"うえ"],[64,1,"かみ"],[66,1,"な"],[71,2,"よげん"]],"text":"さて預言者ハガイおよびイドの子ゼカリヤのふたりの預言者は、ユダとエルサレムにいるユダヤ人に向かって、彼らの上にいますイスラエルの神の名によって預言した。"},{"ref":"Ezra.5.2","start":15005002,"end":15005002,"break":"none","ruby":[[9,1,"こ"],[23,1,"こ"],[29,1,"た"],[44,1,"かみ"],[46,1,"みや"],[48,1,"た"],[50,1,"はじ"],[54,1,"かみ"],[56,3,"よげんしゃ"],[63,1,"かれ"],[66,1,"とも"],[70,1,"かれ"],[73,1,"たす"]],"text":"そこでシャルテルの子ゼルバベルおよびヨザダクの子エシュアは立ちあがって、エルサレムにある神の宮を建て始めた。神の預言者たちも、彼らと共にいて彼らを助けた。"},{"ref":"Ezra.5.3","start":15005003,"end":15005003,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"かわ"],[5,1,"む"],[9,1,"しゅう"],[11,2,"ちじ"],[31,2,"どうりょう"],[34,1,"かれ"],[37,1,"ところ"],[39,1,"き"],[43,1,"い"],[59,1,"みや"],[61,1,"た"],[66,2,"じょうへき"],[69,1,"きず"],[77,1,"めい"]],"text":"その時、川向こうの州の知事タテナイおよびセタル・ボズナイとその同僚は彼らの所に来てこう言った、「だれがあなたがたにこの宮を建て、この城壁を築きあげることを命じたのか」。"},{"ref":"Ezra.5.4","start":15005004,"end":15005004,"break":"none","ruby":[[5,2,"たてもの"],[8,1,"た"],[13,2,"ひとびと"],[16,1,"な"],[27,1,"たず"]],"text":"また「この建物を建てている人々の名はなんというのか」と尋ねた。"},{"ref":"Ezra.5.5","start":15005005,"end":15005005,"break":"none","ruby":[[6,1,"ひと"],[8,2,"ちょうろう"],[13,1,"うえ"],[17,1,"かみ"],[19,1,"め"],[21,1,"そそ"],[30,1,"かれ"],[50,1,"こと"],[57,1,"そう"],[63,2,"へんとう"],[66,1,"く"],[70,1,"ま"]],"text":"しかしユダヤ人の長老たちの上には、神の目が注がれていたので、彼らはこれをやめさせることができず、その事をダリヨスに奏して、その返答の来るのを待った。"},{"ref":"Ezra.5.6","start":15005006,"end":15005006,"break":"paragraph","ruby":[[0,1,"かわ"],[1,1,"む"],[5,1,"しゅう"],[7,2,"ちじ"],[27,2,"どうりょう"],[32,1,"かわ"],[33,1,"む"],[37,1,"しゅう"],[39,2,"ちじ"],[49,1,"おう"],[51,1,"おく"],[54,2,"てがみ"],[57,1,"うつ"],[60,1,"つぎ"]],"text":"川向こうの州の知事タテナイおよびセタル・ボズナイとその同僚である川向こうの州の知事たちが、ダリヨス王に送った手紙の写しは次のとおりである。"},{"ref":"Ezra.5.7","start":15005007,"end":15005007,"break":"none","ruby":[[5,1,"かれ"],[8,1,"おう"],[10,1,"おく"],[13,2,"てがみ"],[18,1,"つぎ"],[33,1,"ねが"],[41,1,"おう"],[43,1,"まった"],[45,2,"へいあん"]],"text":"すなわち、彼らが王に送った手紙には、次のようにしるされてあった。「願わくはダリヨス王に全き平安があるように。"},{"ref":"Ezra.5.8","start":15005008,"end":15005008,"break":"none","ruby":[[0,1,"おう"],[2,1,"つぎ"],[8,1,"おし"],[30,1,"しゅう"],[32,1,"い"],[37,1,"おお"],[41,1,"かみ"],[43,1,"みや"],[45,1,"い"],[48,1,"み"],[57,1,"おお"],[60,1,"いし"],[65,1,"た"],[70,2,"ざいもく"],[73,1,"く"],[76,1,"かべ"],[84,2,"こうじ"],[87,2,"きんべん"],[90,1,"おこな"],[94,1,"かれ"],[97,1,"て"],[102,1,"おお"]],"text":"王に次のことをお知らせいたします。すなわち、われわれがユダヤ州へ行き、かの大いなる神の宮へ行って見たところ、それは大きな石をもって建てられ、材木を組んで壁をつくり、その工事は勤勉に行われ、彼らの手によって大いにはかどっています。"},{"ref":"Ezra.5.9","start":15005009,"end":15005009,"break":"none","ruby":[[10,2,"ちょうろう"],[15,1,"たず"],[20,1,"い"],[38,1,"みや"],[40,1,"た"],[45,2,"じょうへき"],[48,1,"きず"],[56,1,"めい"]],"text":"そこでわれわれはその長老たちに尋ねてこう言いました、『だれがあなたがたにこの宮を建て、この城壁を築きあげることを命じたのか』と。"},{"ref":"Ezra.5.10","start":15005010,"end":15005010,"break":"none","ruby":[[7,1,"かれ"],[15,2,"ひとびと"],[18,1,"な"],[20,1,"か"],[32,1,"おし"],[43,1,"な"],[45,1,"たず"]],"text":"われわれはまた彼らのかしらたる人々の名を書きしるして、あなたにお知らせするために、その名を尋ねました。"},{"ref":"Ezra.5.11","start":15005011,"end":15005011,"break":"none","ruby":[[4,1,"かれ"],[12,1,"こた"],[17,1,"い"],[29,2,"てんち"],[32,1,"かみ"],[42,1,"とし"],[43,1,"ひさ"],[46,1,"むかし"],[48,1,"た"],[53,1,"みや"],[56,1,"ふたた"],[58,1,"た"],[77,1,"おお"],[81,1,"おう"],[83,1,"た"]],"text":"すると、彼らはわれわれに答えてこう言いました、『われわれは天地の神のしもべであって、年久しい昔に建てられた宮を、再び建てるのです。これはもと、イスラエルの大いなる王の建てあげたものですが、"},{"ref":"Ezra.5.12","start":15005012,"end":15005012,"break":"none","ruby":[[5,2,"せんぞ"],[11,1,"てん"],[13,1,"かみ"],[15,1,"いか"],[18,1,"ひ"],[20,1,"おこ"],[26,1,"かみ"],[28,1,"かれ"],[43,1,"おう"],[52,1,"て"],[54,1,"わた"],[61,1,"かれ"],[65,1,"みや"],[71,1,"たみ"],[78,1,"とら"],[81,1,"い"]],"text":"われわれの先祖たちが、天の神の怒りを引き起したため、神は彼らを、カルデヤびとバビロンの王ネブカデネザルの手に渡されたので、彼はこの宮をこわし、民をバビロンに捕えて行きました。"},{"ref":"Ezra.5.13","start":15005013,"end":15005013,"break":"none","ruby":[[9,1,"おう"],[14,2,"がんねん"],[21,1,"おう"],[23,1,"かみ"],[27,1,"みや"],[29,1,"ふたた"],[31,1,"た"],[37,2,"めいれい"],[40,1,"くだ"]],"text":"ところがバビロンの王クロスの元年に、クロス王は神のこの宮を再び建てることの命令を下されました。"},{"ref":"Ezra.5.14","start":15005014,"end":15005014,"break":"none","ruby":[[5,1,"おう"],[7,1,"さき"],[24,1,"みや"],[32,2,"しんでん"],[35,1,"うつ"],[38,1,"かみ"],[40,1,"みや"],[42,2,"きんぎん"],[45,1,"うつわ"],[53,2,"しんでん"],[57,1,"と"],[59,1,"だ"],[63,1,"かれ"],[65,2,"そうとく"],[68,1,"にん"],[79,1,"な"],[81,1,"もの"],[83,1,"わた"]],"text":"またクロス王は先にネブカデネザルが、エルサレムの宮からバビロンの神殿に移した神の宮の金銀の器を、バビロンの神殿から取り出して、彼が総督に任じたセシバザルという名の者に渡して、"},{"ref":"Ezra.5.15","start":15005015,"end":15005015,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[14,1,"うつわ"],[16,1,"たずさ"],[19,1,"い"],[31,1,"みや"],[33,1,"おさ"],[36,1,"かみ"],[38,1,"みや"],[43,1,"ところ"],[45,1,"た"]],"text":"彼に言われました、「これらの器を携えて行って、エルサレムにある宮に納め、神の宮をもとの所に建てよ」と。"},{"ref":"Ezra.5.16","start":15005016,"end":15005016,"break":"none","ruby":[[11,1,"き"],[21,1,"かみ"],[23,1,"みや"],[25,2,"きそ"],[36,1,"とき"],[39,1,"いま"],[41,1,"いた"],[46,2,"けんちく"],[49,1,"つづ"],[59,2,"かんせい"]],"text":"そこでこのセシバザルは来てエルサレムにある神の宮の基礎をすえました。その時から今に至るまで、建築を続けていますが、まだ完成しないのです』と。"},{"ref":"Ezra.5.17","start":15005017,"end":15005017,"break":"none","ruby":[[3,1,"いま"],[7,1,"おう"],[12,1,"み"],[27,1,"おう"],[29,2,"ほうこ"],[32,1,"しら"],[42,1,"かみ"],[46,1,"みや"],[48,1,"た"],[54,2,"めいれい"],[65,1,"おう"],[68,1,"で"],[77,1,"たし"],[83,1,"こと"],[89,1,"おう"],[92,1,"かんが"],[100,1,"つた"]],"text":"それで今、もし王がよしと見られるならば、バビロンにある王の宝庫を調べて、エルサレムの神のこの宮を建てることの命令が、はたしてクロス王から出ているかどうかを確かめ、この事についての王のお考えをわれわれに伝えてください」。"}]