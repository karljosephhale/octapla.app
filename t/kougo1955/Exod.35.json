[{"ref":"Exod.35.1","start":2035001,"end":2035001,"break":"paragraph","ruby":[[10,2,"ひとびと"],[13,1,"ぜん"],[14,2,"かいしゅう"],[17,1,"あつ"],[20,1,"い"],[28,1,"しゅ"],[30,1,"おこな"],[33,1,"めい"],[38,2,"ことば"]],"text":"モーセはイスラエルの人々の全会衆を集めて言った、「これは主が行えと命じられた言葉である。"},{"ref":"Exod.35.2","start":2035002,"end":2035002,"break":"none","ruby":[[1,1,"か"],[3,1,"あいだ"],[5,2,"しごと"],[13,2,"なぬか"],[15,1,"め"],[23,2,"せいじつ"],[27,1,"しゅ"],[29,1,"まった"],[31,1,"やす"],[34,3,"あんそくにち"],[45,1,"ひ"],[47,2,"しごと"],[52,1,"もの"],[58,1,"ころ"]],"text":"六日の間は仕事をしなさい。七日目はあなたがたの聖日で、主の全き休みの安息日であるから、この日に仕事をする者はだれでも殺されなければならない。"},{"ref":"Exod.35.3","start":2035003,"end":2035003,"break":"none","ruby":[[0,3,"あんそくにち"],[19,1,"ひ"]],"text":"安息日にはあなたがたのすまいのどこでも火をたいてはならない」。"},{"ref":"Exod.35.4","start":2035004,"end":2035004,"break":"paragraph","ruby":[[10,2,"ひとびと"],[13,1,"ぜん"],[14,2,"かいしゅう"],[17,1,"い"],[25,1,"しゅ"],[27,1,"めい"]],"text":"モーセはイスラエルの人々の全会衆に言った、「これは主が命じられたことである。"},{"ref":"Exod.35.5","start":2035005,"end":2035005,"break":"none","ruby":[[6,1,"も"],[8,1,"もの"],[15,1,"しゅ"],[21,1,"もの"],[23,1,"と"],[33,1,"こころ"],[36,1,"よろこ"],[41,1,"もの"],[44,1,"しゅ"],[50,1,"もの"],[52,1,"も"],[64,1,"きん"],[66,1,"ぎん"],[68,2,"せいどう"]],"text":"あなたがたの持ち物のうちから、主にささげる物を取りなさい。すべて、心から喜んでする者は、主にささげる物を持ってきなさい。すなわち金、銀、青銅。"},{"ref":"Exod.35.6","start":2035006,"end":2035006,"break":"none","ruby":[[0,1,"あお"],[1,1,"いと"],[3,1,"むらさき"],[4,1,"いと"],[6,1,"ひ"],[7,1,"いと"],[9,2,"あま"],[11,1,"いと"],[16,2,"けいと"]],"text":"青糸、紫糸、緋糸、亜麻糸、やぎの毛糸。"},{"ref":"Exod.35.7","start":2035007,"end":2035007,"break":"none","ruby":[[3,1,"ぞ"],[6,2,"おひつじ"],[9,1,"かわ"],[16,1,"かわ"],[22,1,"ざい"]],"text":"あかね染めの雄羊の皮、じゅごんの皮、アカシヤ材、"},{"ref":"Exod.35.8","start":2035008,"end":2035008,"break":"none","ruby":[[3,1,"あぶら"],[5,1,"そそ"],[7,1,"あぶら"],[9,1,"こう"],[13,2,"くんこう"],[20,2,"こうりょう"]],"text":"ともし油、注ぎ油と香ばしい薫香とのための香料、"},{"ref":"Exod.35.9","start":2035009,"end":2035009,"break":"none","ruby":[[0,1,"しま"],[9,2,"むねあて"],[16,2,"ほうせき"]],"text":"縞めのう、エポデと胸当とにはめる宝石。"},{"ref":"Exod.35.10","start":2035010,"end":2035010,"break":"paragraph","ruby":[[12,1,"こころ"],[14,2,"ちえ"],[18,1,"もの"],[23,1,"しゅ"],[25,1,"めい"],[35,1,"つく"]],"text":"すべてあなたがたのうち、心に知恵ある者はきて、主の命じられたものをみな造りなさい。"},{"ref":"Exod.35.11","start":2035011,"end":2035011,"break":"none","ruby":[[4,2,"まくや"],[9,2,"てんまく"],[21,1,"こま"],[26,1,"わく"],[30,2,"よこぎ"],[35,1,"はしら"],[40,1,"ざ"]],"text":"すなわち幕屋、その天幕と、そのおおい、その鉤と、その枠、その横木、その柱と、その座、"},{"ref":"Exod.35.12","start":2035012,"end":2035012,"break":"none","ruby":[[0,1,"はこ"],[8,3,"しょくざいしょ"],[12,1,"へだ"],[15,2,"たれまく"]],"text":"箱と、そのさお、贖罪所、隔ての垂幕、"},{"ref":"Exod.35.13","start":2035013,"end":2035013,"break":"none","ruby":[[0,1,"つくえ"],[18,1,"うつわ"],[20,1,"そな"]],"text":"机と、そのさお、およびそのもろもろの器、供えのパン、"},{"ref":"Exod.35.14","start":2035014,"end":2035014,"break":"none","ruby":[[11,2,"しょくだい"],[17,1,"うつわ"],[23,1,"ざら"],[29,1,"あぶら"]],"text":"また、ともしびのための燭台と、その器、ともしび皿と、ともし油、"},{"ref":"Exod.35.15","start":2035015,"end":2035015,"break":"none","ruby":[[0,1,"こう"],[2,2,"さいだん"],[11,1,"そそ"],[13,1,"あぶら"],[15,1,"こう"],[19,2,"くんこう"],[22,2,"まくや"],[25,2,"いりぐち"]],"text":"香の祭壇と、そのさお、注ぎ油、香ばしい薫香、幕屋の入口のとばり、"},{"ref":"Exod.35.16","start":2035016,"end":2035016,"break":"none","ruby":[[0,2,"はんさい"],[3,2,"さいだん"],[10,2,"せいどう"],[13,1,"あみ"],[28,1,"うつわ"],[30,2,"せんばん"],[36,1,"だい"]],"text":"燔祭の祭壇およびその青銅の網、そのさおと、そのもろもろの器、洗盤と、その台、"},{"ref":"Exod.35.17","start":2035017,"end":2035017,"break":"none","ruby":[[0,1,"にわ"],[9,1,"はしら"],[13,1,"ざ"],[15,1,"にわ"],[17,1,"もん"]],"text":"庭のあげばり、その柱とその座、庭の門のとばり、"},{"ref":"Exod.35.18","start":2035018,"end":2035018,"break":"none","ruby":[[0,2,"まくや"],[3,1,"くぎ"],[5,1,"にわ"],[7,1,"くぎ"]],"text":"幕屋の釘、庭の釘およびそのひも、"},{"ref":"Exod.35.19","start":2035019,"end":2035019,"break":"none","ruby":[[0,2,"せいじょ"],[6,1,"つとめ"],[11,2,"あみもの"],[14,1,"ふく"],[20,2,"さいし"],[23,1,"つとめ"],[30,2,"さいし"],[36,1,"せい"],[39,1,"ふく"],[45,1,"こ"],[49,1,"ふく"]],"text":"聖所における務のための編物の服、すなわち祭司の務をなすための祭司アロンの聖なる服およびその子たちの服」。"},{"ref":"Exod.35.20","start":2035020,"end":2035020,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"ぜん"],[10,2,"かいしゅう"],[17,1,"まえ"],[19,1,"さ"]],"text":"イスラエルの人々の全会衆はモーセの前を去り、"},{"ref":"Exod.35.21","start":2035021,"end":2035021,"break":"none","ruby":[[3,1,"こころ"],[5,1,"かん"],[8,1,"もの"],[13,1,"こころ"],[16,1,"よろこ"],[21,1,"もの"],[24,2,"かいけん"],[27,2,"まくや"],[30,2,"さぎょう"],[41,2,"ほうし"],[45,1,"せい"],[48,1,"ふく"],[55,1,"しゅ"],[61,1,"もの"],[63,1,"たずさ"]],"text":"すべて心に感じた者、すべて心から喜んでする者は、会見の幕屋の作業と、そのもろもろの奉仕と、聖なる服とのために、主にささげる物を携えてきた。"},{"ref":"Exod.35.22","start":2035022,"end":2035022,"break":"none","ruby":[[8,1,"こころ"],[11,1,"よろこ"],[16,2,"だんじょ"],[20,2,"はなわ"],[23,2,"みみわ"],[26,2,"ゆびわ"],[29,2,"くびかざ"],[40,1,"きん"],[42,1,"かざ"],[45,1,"たずさ"],[54,1,"きん"],[59,1,"もの"],[61,1,"しゅ"],[67,1,"もの"]],"text":"すなわち、すべて心から喜んでする男女は、鼻輪、耳輪、指輪、首飾り、およびすべての金の飾りを携えてきた。すべて金のささげ物を主にささげる者はそのようにした。"},{"ref":"Exod.35.23","start":2035023,"end":2035023,"break":"none","ruby":[[3,1,"あお"],[4,1,"いと"],[6,1,"むらさき"],[7,1,"いと"],[9,1,"ひ"],[10,1,"いと"],[12,2,"あま"],[14,1,"いと"],[19,2,"けいと"],[25,1,"ぞ"],[28,2,"おひつじ"],[31,1,"かわ"],[38,1,"かわ"],[40,1,"も"],[45,1,"もの"],[51,1,"たずさ"]],"text":"すべて青糸、紫糸、緋糸、亜麻糸、やぎの毛糸、あかね染めの雄羊の皮、じゅごんの皮を持っている者は、それを携えてきた。"},{"ref":"Exod.35.24","start":2035024,"end":2035024,"break":"none","ruby":[[3,1,"ぎん"],[5,2,"せいどう"],[11,1,"もの"],[23,1,"もの"],[29,1,"しゅ"],[35,1,"もの"],[39,1,"たずさ"],[51,2,"くみた"],[55,2,"こうじ"],[58,1,"もち"],[65,1,"ざい"],[67,1,"も"],[72,1,"もの"],[78,1,"たずさ"]],"text":"すべて銀、青銅のささげ物をささげることのできる者は、それを主にささげる物として携えてきた。また、すべて組立ての工事に用いるアカシヤ材を持っている者は、それを携えてきた。"},{"ref":"Exod.35.25","start":2035025,"end":2035025,"break":"none","ruby":[[6,1,"こころ"],[8,2,"ちえ"],[12,1,"おんな"],[19,1,"て"],[24,1,"つむ"],[29,1,"つむ"],[32,1,"あお"],[33,1,"いと"],[35,1,"むらさき"],[36,1,"いと"],[38,1,"ひ"],[39,1,"いと"],[41,2,"あま"],[43,1,"いと"],[45,1,"たずさ"]],"text":"また、すべて心に知恵ある女たちは、その手をもって紡ぎ、その紡いだ青糸、紫糸、緋糸、亜麻糸を携えてきた。"},{"ref":"Exod.35.26","start":2035026,"end":2035026,"break":"none","ruby":[[3,2,"ちえ"],[10,1,"こころ"],[12,1,"かん"],[15,1,"おんな"],[23,1,"け"],[25,1,"つむ"]],"text":"すべて知恵があって、心に感じた女たちは、やぎの毛を紡いだ。"},{"ref":"Exod.35.27","start":2035027,"end":2035027,"break":"none","ruby":[[9,1,"しま"],[21,2,"むねあて"],[27,2,"ほうせき"],[30,1,"たずさ"]],"text":"また、かしらたちは縞めのう、およびエポデと胸当にはめる宝石を携えてきた。"},{"ref":"Exod.35.28","start":2035028,"end":2035028,"break":"none","ruby":[[9,1,"そそ"],[11,1,"あぶら"],[14,1,"こう"],[18,2,"くんこう"],[24,2,"こうりょう"],[28,1,"あぶら"],[31,1,"たずさ"]],"text":"また、ともしびと、注ぎ油と、香ばしい薫香のための香料と、油とを携えてきた。"},{"ref":"Exod.35.29","start":2035029,"end":2035029,"break":"none","ruby":[[11,2,"ひとびと"],[14,2,"じはつ"],[20,1,"もの"],[22,1,"しゅ"],[24,1,"たずさ"],[34,1,"しゅ"],[47,1,"めい"],[56,2,"こうさく"],[63,1,"もの"],[65,1,"たずさ"],[73,1,"こころ"],[76,1,"よろこ"],[81,2,"だんじょ"]],"text":"このようにイスラエルの人々は自発のささげ物を主に携えてきた。すなわち主がモーセによって、なせと命じられたすべての工作のために、物を携えてこようと、心から喜んでする男女はみな、そのようにした。"},{"ref":"Exod.35.30","start":2035030,"end":2035030,"break":"paragraph","ruby":[[10,2,"ひとびと"],[13,1,"い"],[18,1,"み"],[21,1,"しゅ"],[26,2,"ぶぞく"],[29,1,"ぞく"],[35,1,"こ"],[41,1,"こ"],[47,1,"な"],[51,1,"め"]],"text":"モーセはイスラエルの人々に言った、「見よ、主はユダの部族に属するホルの子なるウリの子ベザレルを名ざして召し、"},{"ref":"Exod.35.31","start":2035031,"end":2035031,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かみ"],[4,1,"れい"],[6,1,"み"],[11,2,"ちえ"],[14,1,"さと"],[17,2,"ちしき"],[20,2,"しょしゅ"],[23,2,"こうさく"],[26,1,"ちょう"]],"text":"彼に神の霊を満たして、知恵と悟りと知識と諸種の工作に長ぜしめ、"},{"ref":"Exod.35.32","start":2035032,"end":2035032,"break":"none","ruby":[[0,2,"くふう"],[3,1,"こ"],[7,1,"きん"],[9,1,"ぎん"],[11,2,"せいどう"],[14,2,"さいく"]],"text":"工夫を凝らして金、銀、青銅の細工をさせ、"},{"ref":"Exod.35.33","start":2035033,"end":2035033,"break":"none","ruby":[[2,2,"ほうせき"],[5,1,"き"],[10,1,"き"],[12,2,"ちょうこく"],[19,2,"しょしゅ"],[22,2,"こうさく"]],"text":"また宝石を切りはめ、木を彫刻するなど、諸種の工作をさせ、"},{"ref":"Exod.35.34","start":2035034,"end":2035034,"break":"none","ruby":[[2,1,"ひと"],[4,1,"おし"],[8,1,"ちから"],[11,1,"かれ"],[13,1,"こころ"],[15,1,"さづ"],[21,1,"かれ"],[26,2,"ぶぞく"],[29,1,"ぞく"],[38,1,"こ"]],"text":"また人を教えうる力を、彼の心に授けられた。彼とダンの部族に属するアヒサマクの子アホリアブとが、それである。"},{"ref":"Exod.35.35","start":2035035,"end":2035035,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,2,"ちえ"],[8,1,"こころ"],[10,1,"み"],[15,2,"しょしゅ"],[18,2,"こうさく"],[31,2,"ちょうこく"],[34,1,"う"],[36,1,"おり"],[40,1,"あお"],[41,1,"いと"],[43,1,"むらさき"],[44,1,"いと"],[46,1,"ひ"],[47,1,"いと"],[49,2,"あま"],[51,1,"いと"],[53,2,"ぬいと"],[59,1,"はた"],[60,1,"おり"],[63,2,"しょしゅ"],[66,2,"こうさく"],[72,2,"くふう"],[75,1,"こ"],[79,1,"たく"]],"text":"主は彼らに知恵の心を満たして、諸種の工作をさせられた。すなわち彫刻、浮き織および青糸、紫糸、緋糸、亜麻糸の縫取り、また機織など諸種の工作をさせ、工夫を凝らして巧みなわざをさせられた。"}]