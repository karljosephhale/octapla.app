[{"ref":"Esth.10.1","start":17010001,"end":17010001,"break":"paragraph","ruby":[[7,1,"おう"],[11,1,"くに"],[15,1,"うみ"],[17,1,"そ"],[20,2,"くにぐに"],[27,1,"か"]],"text":"アハシュエロス王はその国および海に沿った国々にみつぎを課した。"},{"ref":"Esth.10.2","start":17010002,"end":17010002,"break":"none","ruby":[[0,1,"かれ"],[2,2,"けんりょく"],[5,2,"せいりょく"],[14,2,"じぎょう"],[20,1,"おう"],[28,1,"たか"],[30,2,"ちい"],[38,1,"こと"],[40,1,"くわ"],[43,1,"はなし"],[54,1,"おう"],[58,2,"にっし"],[61,1,"しょ"]],"text":"彼の権力と勢力によるすべての事業、および王がモルデカイを高い地位にのぼらせた事の詳しい話はメデアとペルシャの王たちの日誌の書にしるされているではないか。"},{"ref":"Esth.10.3","start":17010003,"end":17010003,"break":"none","ruby":[[3,1,"じん"],[17,1,"おう"],[19,1,"つ"],[21,1,"もの"],[29,1,"じん"],[31,1,"なか"],[36,1,"おお"],[40,1,"もの"],[47,1,"おお"],[50,2,"きょうだい"],[53,1,"よろこ"],[58,1,"かれ"],[62,1,"たみ"],[64,2,"こうふく"],[67,1,"もと"],[74,2,"こくみん"],[77,2,"へいわ"],[80,1,"の"]],"text":"ユダヤ人モルデカイはアハシュエロス王に次ぐ者となり、ユダヤ人の中にあって大いなる者となり、その多くの兄弟に喜ばれた。彼はその民の幸福を求め、すべての国民に平和を述べたからである。"}]