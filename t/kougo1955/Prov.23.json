[{"ref":"Prov.23.1","start":20023001,"end":20023001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[0,1,"おさ"],[3,1,"ひと"],[5,1,"とも"],[7,1,"ざ"],[10,2,"しょくじ"],[21,1,"まえ"]],"text":"治める人と共に座して食事するとき、あなたの前にあるものを、よくわきまえ、"},{"ref":"Prov.23.2","start":20023002,"end":20023002,"break":"line","breaks":[[20,"line"]],"ruby":[[6,1,"しょく"],[12,1,"もの"],[27,1,"かたな"]],"text":"あなたがもし食をたしなむ者であるならば、あなたののどに刀をあてよ。"},{"ref":"Prov.23.3","start":20023003,"end":20023003,"break":"line","breaks":[[20,"line"]],"ruby":[[11,1,"た"],[23,1,"ひと"],[25,1,"あざむ"],[27,2,"しょくもつ"]],"text":"そのごちそうをむさぼり食べてはならない、これは人を欺く食物だからである。"},{"ref":"Prov.23.4","start":20023004,"end":20023004,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"とみ"],[2,1,"え"],[6,2,"くろう"],[20,1,"おも"]],"text":"富を得ようと苦労してはならない、かしこく思いとどまるがよい。"},{"ref":"Prov.23.5","start":20023005,"end":20023005,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[4,1,"め"],[20,1,"とみ"],[26,1,"みずか"],[28,1,"つばさ"],[30,1,"しょう"],[40,1,"てん"],[42,1,"と"],[44,1,"さ"]],"text":"あなたの目をそれにとめると、それはない、富はたちまち自ら翼を生じて、わしのように天に飛び去るからだ。"},{"ref":"Prov.23.6","start":20023006,"end":20023006,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"ものお"],[6,1,"ひと"],[11,1,"た"],[31,1,"ねが"]],"text":"物惜しみする人のパンを食べてはならない、そのごちそうをむさぼり願ってはならない。"},{"ref":"Prov.23.7","start":20023007,"end":20023007,"break":"line","breaks":[[17,"line"],[36,"line"]],"ruby":[[0,1,"かれ"],[2,1,"こころ"],[7,2,"かんじょう"],[11,1,"ひと"],[18,1,"く"],[21,1,"の"],[29,1,"い"],[38,1,"こころ"],[44,2,"しんじつ"]],"text":"彼は心のうちで勘定する人のように、「食え、飲め」とあなたに言うけれども、その心はあなたに真実ではない。"},{"ref":"Prov.23.8","start":20023008,"end":20023008,"break":"line","breaks":[[24,"line"]],"ruby":[[9,1,"た"],[12,1,"もの"],[14,1,"は"],[16,1,"だ"],[33,2,"ことば"]],"text":"あなたはついにその食べた物を吐き出すようになり、あなたのねんごろな言葉もむだになる。"},{"ref":"Prov.23.9","start":20023009,"end":20023009,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"みみ"],[7,1,"かた"],[16,1,"かれ"],[22,2,"ことば"],[25,1,"しめ"],[27,2,"ちえ"]],"text":"愚かな者の耳に語ってはならない、彼はあなたの言葉が示す知恵をいやしめるからだ。"},{"ref":"Prov.23.10","start":20023010,"end":20023010,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ふる"],[2,2,"じざかい"],[5,1,"うつ"],[19,1,"はたけ"],[21,1,"おか"]],"text":"古い地境を移してはならない、みなしごの畑を侵してはならない。"},{"ref":"Prov.23.11","start":20023011,"end":20023011,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[7,1,"しゅ"],[9,1,"つよ"],[21,1,"さか"],[25,1,"かれ"],[28,1,"うった"],[31,2,"べんご"]],"text":"彼らのあがない主は強くいらせられ、あなたに逆らって彼らの訴えを弁護されるからだ。"},{"ref":"Prov.23.12","start":20023012,"end":20023012,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"こころ"],[6,2,"きょうくん"],[9,1,"もち"],[16,1,"みみ"],[18,2,"ちしき"],[21,2,"ことば"],[24,1,"かたむ"]],"text":"あなたの心を教訓に用い、あなたの耳を知識の言葉に傾けよ。"},{"ref":"Prov.23.13","start":20023013,"end":20023013,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"こ"],[2,1,"こ"],[11,1,"ひか"],[23,1,"かれ"],[25,1,"う"],[29,1,"し"]],"text":"子を懲らすことを、さし控えてはならない、むちで彼を打っても死ぬことはない。"},{"ref":"Prov.23.14","start":20023014,"end":20023014,"break":"line","breaks":[[14,"line"]],"ruby":[[6,1,"かれ"],[8,1,"う"],[16,1,"いのち"],[18,2,"よみ"],[22,1,"すく"]],"text":"もし、むちで彼を打つならば、その命を陰府から救うことができる。"},{"ref":"Prov.23.15","start":20023015,"end":20023015,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"こ"],[11,1,"こころ"],[13,1,"かしこ"],[23,1,"こころ"],[27,1,"よろこ"]],"text":"わが子よ、もしあなたの心が賢くあれば、わたしの心もまた喜び、"},{"ref":"Prov.23.16","start":20023016,"end":20023016,"break":"line","breaks":[[22,"line"]],"ruby":[[11,1,"ただ"],[14,1,"こと"],[16,1,"い"],[26,1,"こころ"],[28,1,"よろこ"]],"text":"もしあなたのくちびるが正しい事を言うならば、わたしの心も喜ぶ。"},{"ref":"Prov.23.17","start":20023017,"end":20023017,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"こころ"],[2,1,"つみ"],[24,1,"しゅ"],[26,1,"おそ"]],"text":"心に罪びとをうらやんではならない、ただ、ひねもす主を恐れよ。"},{"ref":"Prov.23.18","start":20023018,"end":20023018,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"のち"],[8,1,"むく"],[19,1,"のぞ"]],"text":"かならず後のよい報いがあって、あなたの望みは、すたらない。"},{"ref":"Prov.23.19","start":20023019,"end":20023019,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"こ"],[7,1,"き"],[11,2,"ちえ"],[14,1,"え"],[24,1,"こころ"],[26,1,"みち"],[28,1,"む"]],"text":"わが子よ、よく聞いて、知恵を得よ、かつ、あなたの心を道に向けよ。"},{"ref":"Prov.23.20","start":20023020,"end":20023020,"break":"line","breaks":[[6,"line"]],"ruby":[[0,1,"さけ"],[6,1,"にく"],[12,1,"もの"],[14,1,"まじ"]],"text":"酒にふけり、肉をたしなむ者と交わってはならない。"},{"ref":"Prov.23.21","start":20023021,"end":20023021,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"さけ"],[5,1,"もの"],[8,1,"にく"],[14,1,"もの"],[17,1,"まず"],[23,1,"ねむ"],[30,1,"もの"],[36,1,"み"]],"text":"酒にふける者と、肉をたしなむ者とは貧しくなり、眠りをむさぼる者は、ぼろを身にまとうようになる。"},{"ref":"Prov.23.22","start":20023022,"end":20023022,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"う"],[7,1,"ちち"],[14,1,"き"],[17,2,"としお"],[21,1,"はは"],[23,1,"かろ"]],"text":"あなたを生んだ父のいうことを聞き、年老いた母を軽んじてはならない。"},{"ref":"Prov.23.23","start":20023023,"end":20023023,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"しんり"],[3,1,"か"],[9,1,"う"],[18,2,"ちえ"],[21,2,"きょうくん"],[24,1,"さと"],[28,1,"か"]],"text":"真理を買え、これを売ってはならない、知恵と教訓と悟りをも買え。"},{"ref":"Prov.23.24","start":20023024,"end":20023024,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"ちち"],[7,1,"おお"],[15,2,"ちえ"],[19,1,"こ"],[21,1,"う"],[23,1,"もの"],[25,1,"こ"],[30,1,"たの"]],"text":"正しい人の父は大いによろこび、知恵ある子を生む者は子のために楽しむ。"},{"ref":"Prov.23.25","start":20023025,"end":20023025,"break":"line","breaks":[[12,"line"]],"ruby":[[4,2,"ふぼ"],[7,1,"たの"],[16,1,"う"],[19,1,"はは"],[21,1,"よろこ"]],"text":"あなたの父母を楽しませ、あなたを産んだ母を喜ばせよ。"},{"ref":"Prov.23.26","start":20023026,"end":20023026,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"こ"],[9,1,"こころ"],[15,1,"あた"],[22,1,"め"],[28,1,"みち"],[30,1,"そそ"]],"text":"わが子よ、あなたの心をわたしに与え、あなたの目をわたしの道に注げ。"},{"ref":"Prov.23.27","start":20023027,"end":20023027,"break":"line","breaks":[[11,"line"]],"ruby":[[0,2,"ゆうじょ"],[3,1,"ふか"],[5,1,"あな"],[15,1,"おんな"],[17,1,"せま"],[19,2,"いど"]],"text":"遊女は深い穴のごとく、みだらな女は狭い井戸のようだ。"},{"ref":"Prov.23.28","start":20023028,"end":20023028,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"ぬす"],[10,1,"ひと"],[19,1,"よ"],[21,1,"ひと"],[27,3,"ふしんじつ"],[31,1,"もの"],[33,1,"おお"]],"text":"彼女は盗びとのように人をうかがい、かつ世の人のうちに、不信実な者を多くする。"},{"ref":"Prov.23.29","start":20023029,"end":20023029,"break":"line","breaks":[[19,"line"],[40,"line"],[55,"line"]],"ruby":[[0,1,"わざわい"],[3,1,"もの"],[9,1,"うれ"],[13,1,"もの"],[19,1,"あらそ"],[24,1,"もの"],[30,1,"わずら"],[34,1,"もの"],[44,1,"きず"],[49,1,"もの"],[55,1,"あか"],[57,1,"め"],[63,1,"もの"]],"text":"災ある者はだれか、憂いある者はだれか、争いをする者はだれか、煩いある者はだれか、ゆえなく傷をうける者はだれか、赤い目をしている者はだれか。"},{"ref":"Prov.23.30","start":20023030,"end":20023030,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"さけ"],[2,1,"よる"],[7,1,"もの"],[9,1,"い"],[13,1,"ま"],[15,1,"あ"],[19,1,"さけ"],[21,1,"あじ"],[24,1,"もの"]],"text":"酒に夜をふかす者、行って、混ぜ合わせた酒を味わう者である。"},{"ref":"Prov.23.31","start":20023031,"end":20023031,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"さけ"],[6,1,"はい"],[8,1,"なか"],[31,1,"み"]],"text":"酒はあかく、杯の中にあわだち、なめらかにくだる、あなたはこれを見てはならない。"},{"ref":"Prov.23.32","start":20023032,"end":20023032,"break":"line","breaks":[[16,"line"]],"ruby":[[23,1,"さ"]],"text":"これはついに、へびのようにかみ、まむしのように刺す。"},{"ref":"Prov.23.33","start":20023033,"end":20023033,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"め"],[6,1,"あや"],[12,1,"み"],[18,1,"こころ"],[20,1,"いつわ"],[23,1,"い"]],"text":"あなたの目は怪しいものを見、あなたの心は偽りを言う。"},{"ref":"Prov.23.34","start":20023034,"end":20023034,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"うみ"],[6,1,"なか"],[8,1,"ね"],[12,1,"ひと"],[18,2,"ほばしら"],[21,1,"うえ"],[23,1,"ね"],[27,1,"ひと"]],"text":"あなたは海の中に寝ている人のように、帆柱の上に寝ている人のようになる。"},{"ref":"Prov.23.35","start":20023035,"end":20023035,"break":"line","breaks":[[7,"line"],[31,"line"],[54,"line"],[66,"line"]],"ruby":[[4,1,"い"],[8,1,"ひと"],[14,1,"う"],[23,1,"いた"],[46,1,"なに"],[48,1,"おぼ"],[68,1,"さけ"],[70,1,"もと"]],"text":"あなたは言う、「人がわたしを撃ったが、わたしは痛くはなかった。わたしを、たたいたが、わたしは何も覚えはない。いつわたしはさめるのか、また酒を求めよう」と。"}]