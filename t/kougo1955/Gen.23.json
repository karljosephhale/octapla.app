[{"ref":"Gen.23.1","start":1023001,"end":1023001,"break":"paragraph","ruby":[[3,2,"いっしょう"],[10,1,"ねん"],[22,1,"い"],[29,1,"とし"]],"text":"サラの一生は百二十七年であった。これがサラの生きながらえた年である。"},{"ref":"Gen.23.2","start":1023002,"end":1023002,"break":"none","ruby":[[7,1,"ち"],[26,1,"し"],[36,1,"なか"],[48,1,"かな"],[51,1,"な"]],"text":"サラはカナンの地のキリアテ・アルバすなわちヘブロンで死んだ。アブラハムは中にはいってサラのために悲しみ泣いた。"},{"ref":"Gen.23.3","start":1023003,"end":1023003,"break":"none","ruby":[[6,2,"しにん"],[13,1,"た"],[20,2,"ひとびと"],[23,1,"い"]],"text":"アブラハムは死人のそばから立って、ヘテの人々に言った、"},{"ref":"Gen.23.4","start":1023004,"end":1023004,"break":"none","ruby":[[14,1,"たび"],[16,1,"もの"],[18,3,"きりゅうしゃ"],[29,2,"しにん"],[32,1,"だ"],[35,1,"ほうむ"],[53,2,"しょゆう"],[61,2,"ぼち"]],"text":"「わたしはあなたがたのうちの旅の者で寄留者ですが、わたしの死人を出して葬るため、あなたがたのうちにわたしの所有として一つの墓地をください」。"},{"ref":"Gen.23.5","start":1023005,"end":1023005,"break":"none","ruby":[[3,2,"ひとびと"],[12,1,"こた"],[15,1,"い"]],"text":"ヘテの人々はアブラハムに答えて言った、"},{"ref":"Gen.23.6","start":1023006,"end":1023006,"break":"none","ruby":[[3,1,"しゅ"],[7,1,"き"],[30,1,"かみ"],[35,2,"しゅくん"],[45,2,"ぼち"],[48,1,"もっと"],[50,1,"よ"],[52,1,"ところ"],[58,2,"しにん"],[61,1,"ほうむ"],[69,2,"ぼち"],[72,1,"こば"],[82,2,"しにん"],[85,1,"ほうむ"],[90,1,"もの"]],"text":"「わが主よ、お聞きなさい。あなたはわれわれのうちにおられて、神のような主君です。われわれの墓地の最も良い所にあなたの死人を葬りなさい。その墓地を拒んで、あなたにその死人を葬らせない者はわれわれのうちには、ひとりもないでしょう」。"},{"ref":"Gen.23.7","start":1023007,"end":1023007,"break":"none","ruby":[[6,1,"た"],[14,1,"ち"],[16,1,"たみ"],[20,2,"ひとびと"],[23,1,"れい"]],"text":"アブラハムは立ちあがり、その地の民ヘテの人々に礼をして、"},{"ref":"Gen.23.8","start":1023008,"end":1023008,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[14,2,"しにん"],[17,1,"ほうむ"],[21,2,"どうい"],[33,1,"ねが"],[51,1,"こ"],[57,1,"たの"]],"text":"彼らに言った、「もしわたしの死人を葬るのに同意されるなら、わたしの願いをいれて、わたしのためにゾハルの子エフロンに頼み、"},{"ref":"Gen.23.9","start":1023009,"end":1023009,"break":"none","ruby":[[0,1,"かれ"],[2,1,"も"],[7,1,"はたけ"],[9,1,"はし"],[18,1,"あな"],[26,2,"だいか"],[33,1,"あた"],[45,2,"ぼち"],[48,1,"も"]],"text":"彼が持っている畑の端のマクペラのほら穴をじゅうぶんな代価でわたしに与え、あなたがたのうちに墓地を持たせてください」。"},{"ref":"Gen.23.10","start":1023010,"end":1023010,"break":"none","ruby":[[0,1,"とき"],[10,2,"ひとびと"],[38,2,"ひとびと"],[50,1,"まち"],[52,1,"もん"],[57,2,"ひとびと"],[60,1,"き"],[76,1,"こた"],[79,1,"い"]],"text":"時にエフロンはヘテの人々のうちにすわっていた。そこでヘテびとエフロンはヘテの人々、すなわちすべてその町の門にはいる人々の聞いているところで、アブラハムに答えて言った、"},{"ref":"Gen.23.11","start":1023011,"end":1023011,"break":"none","ruby":[[7,1,"しゅ"],[11,1,"き"],[23,1,"はたけ"],[40,1,"なか"],[46,1,"あな"],[59,1,"たみ"],[61,2,"ひとびと"],[64,1,"まえ"],[81,2,"しにん"],[84,1,"ほうむ"]],"text":"「いいえ、わが主よ、お聞きなさい。わたしはあの畑をあなたにさしあげます。またその中にあるほら穴もさしあげます。わたしの民の人々の前で、それをさしあげます。あなたの死人を葬りなさい」。"},{"ref":"Gen.23.12","start":1023012,"end":1023012,"break":"none","ruby":[[8,1,"ち"],[10,1,"たみ"],[12,1,"まえ"],[14,1,"れい"]],"text":"アブラハムはその地の民の前で礼をし、"},{"ref":"Gen.23.13","start":1023013,"end":1023013,"break":"none","ruby":[[2,1,"ち"],[4,1,"たみ"],[6,1,"き"],[20,1,"い"],[32,2,"しょうだく"],[41,1,"き"],[53,1,"はたけ"],[55,2,"だいか"],[58,1,"はら"],[64,1,"う"],[66,1,"と"],[77,2,"しにん"],[83,1,"ほうむ"]],"text":"その地の民の聞いているところでエフロンに言った、「あなたがそれを承諾されるなら、お聞きなさい。わたしはその畑の代価を払います。お受け取りください。わたしの死人をそこに葬りましょう」。"},{"ref":"Gen.23.14","start":1023014,"end":1023014,"break":"none","ruby":[[11,1,"こた"],[14,1,"い"]],"text":"エフロンはアブラハムに答えて言った、"},{"ref":"Gen.23.15","start":1023015,"end":1023015,"break":"none","ruby":[[3,1,"しゅ"],[7,1,"き"],[15,1,"ち"],[17,1,"ぎん"],[38,1,"あいだ"],[57,2,"しにん"],[60,1,"ほうむ"]],"text":"「わが主よ、お聞きなさい。あの地は銀四百シケルですが、これはわたしとあなたの間で、なにほどのことでしょう。あなたの死人を葬りなさい」。"},{"ref":"Gen.23.16","start":1023016,"end":1023016,"break":"none","ruby":[[14,2,"ことば"],[30,2,"ひとびと"],[33,1,"き"],[42,1,"い"],[45,1,"ぎん"],[51,2,"しょうにん"],[54,2,"つうよう"],[56,1,"ぎん"],[63,1,"はか"],[71,1,"あた"]],"text":"そこでアブラハムはエフロンの言葉にしたがい、エフロンがヘテの人々の聞いているところで言った銀、すなわち商人の通用銀四百シケルを量ってエフロンに与えた。"},{"ref":"Gen.23.17","start":1023017,"end":1023017,"break":"paragraph","ruby":[[8,1,"まえ"],[22,1,"はたけ"],[25,1,"はたけ"],[30,1,"なか"],[34,1,"あな"],[37,1,"はたけ"],[39,1,"なか"],[45,2,"しゅうい"],[48,1,"さかい"],[56,1,"き"],[58,1,"みな"]],"text":"こうしてマムレの前のマクペラにあるエフロンの畑は、畑も、その中のほら穴も、畑の中およびその周囲の境にあるすべての木も皆、"},{"ref":"Gen.23.18","start":1023018,"end":1023018,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"まえ"],[14,1,"まち"],[16,1,"もん"],[25,2,"ひとびと"],[28,1,"まえ"],[37,2,"しょゆう"],[40,1,"き"]],"text":"ヘテの人々の前、すなわちその町の門にはいるすべての人々の前で、アブラハムの所有と決まった。"},{"ref":"Gen.23.19","start":1023019,"end":1023019,"break":"none","ruby":[[2,1,"のち"],[12,1,"つま"],[20,1,"ち"],[37,1,"まえ"],[44,1,"はたけ"],[48,1,"あな"],[50,1,"ほうむ"]],"text":"その後、アブラハムはその妻サラをカナンの地にあるマムレ、すなわちヘブロンの前のマクペラの畑のほら穴に葬った。"},{"ref":"Gen.23.20","start":1023020,"end":1023020,"break":"none","ruby":[[5,1,"はたけ"],[9,1,"なか"],[15,1,"あな"],[21,2,"ひとびと"],[33,2,"しょゆう"],[36,2,"ぼち"],[39,1,"さだ"]],"text":"このように畑とその中にあるほら穴とはヘテの人々によってアブラハムの所有の墓地と定められた。"}]