[{"ref":"Isa.23.1","start":23023001,"end":23023001,"break":"paragraph","breaks":[[10,"stanza"],[28,"line"],[42,"line"],[56,"line"]],"ruby":[[7,2,"たくせん"],[20,1,"ふね"],[23,1,"な"],[25,1,"さけ"],[31,1,"あ"],[38,1,"いえ"],[42,1,"ふね"],[43,1,"と"],[48,1,"みなと"],[58,1,"こと"],[64,1,"ち"],[67,1,"かれ"],[70,1,"つ"],[72,1,"し"]],"text":"ツロについての託宣。タルシシのもろもろの船よ、泣き叫べ、ツロは荒れすたれて、家なく、船泊まりする港もないからだ。この事はクプロの地から彼らに告げ知らせられる。"},{"ref":"Isa.23.2","start":23023002,"end":23023002,"break":"line","breaks":[[8,"line"],[20,"line"],[34,"line"]],"ruby":[[0,1,"うみ"],[3,1,"す"],[5,1,"たみ"],[12,2,"しょうにん"],[26,2,"ししゃ"],[29,1,"うみ"],[31,1,"わた"],[34,1,"おお"],[38,1,"みず"],[40,1,"うえ"]],"text":"海べに住む民よ、シドンの商人よ、もだせ、あなたがたの使者は海を渡り、大いなる水の上にあった。"},{"ref":"Isa.23.3","start":23023003,"end":23023003,"break":"line","breaks":[[13,"line"],[25,"line"]],"ruby":[[3,2,"しゅうにゅう"],[10,2,"こくもつ"],[16,1,"かわ"],[18,2,"しゅうかく"],[33,1,"くに"],[37,2,"しょうにん"]],"text":"ツロの収入はシホルの穀物、ナイル川の収穫であった。ツロはもろもろの国びとの商人であった。"},{"ref":"Isa.23.4","start":23023004,"end":23023004,"break":"line","breaks":[[9,"line"],[22,"line"],[41,"line"],[54,"line"]],"ruby":[[5,1,"は"],[9,1,"うみ"],[11,1,"い"],[15,1,"うみ"],[17,1,"しろ"],[19,1,"い"],[27,1,"くる"],[34,1,"う"],[45,1,"わか"],[47,2,"だんし"],[50,1,"やしな"],[56,2,"しょじょ"],[59,1,"そだ"]],"text":"シドンよ、恥じよ、海は言った、海の城は言う、「わたしは苦しまず、また産まなかった。わたしは若い男子を養わず、また処女を育てなかった」。"},{"ref":"Isa.23.5","start":23023005,"end":23023005,"break":"line","breaks":[[16,"line"]],"ruby":[[2,2,"ほうどう"],[10,1,"たっ"],[16,1,"かれ"],[26,2,"ほうどう"],[36,1,"くる"]],"text":"この報道がエジプトに達するとき、彼らはツロについての報道によって、いたく苦しむ。"},{"ref":"Isa.23.6","start":23023006,"end":23023006,"break":"line","breaks":[[8,"line"]],"ruby":[[5,1,"わた"],[8,1,"うみ"],[11,1,"す"],[13,1,"たみ"],[16,1,"な"],[18,1,"さけ"]],"text":"タルシシに渡れ、海べに住む民よ、泣き叫べ。"},{"ref":"Isa.23.7","start":23023007,"end":23023007,"break":"line","breaks":[[12,"line"],[31,"line"]],"ruby":[[5,2,"きげん"],[8,1,"ふる"],[10,1,"まち"],[12,2,"じぶん"],[15,1,"あし"],[17,1,"うつ"],[20,1,"とお"],[25,2,"いじゅう"],[29,1,"まち"],[37,1,"よろこ"],[39,1,"ほこ"],[41,1,"まち"]],"text":"これがその起源も古い町、自分の足で移り、遠くにまで移住した町、あなたがたの喜び誇る町なのか。"},{"ref":"Isa.23.8","start":23023008,"end":23023008,"break":"line","breaks":[[19,"line"],[29,"line"],[38,"line"]],"ruby":[[10,1,"さだ"],[22,1,"かんむり"],[24,1,"さづ"],[27,1,"まち"],[31,2,"しょうにん"],[34,1,"きみ"],[40,2,"ぼうえき"],[42,2,"ぎょうしゃ"],[45,1,"ち"],[47,1,"たっと"],[49,2,"ひとびと"]],"text":"ツロにむかってこれを定めたのはだれか。ツロは冠を授けた町、その商人は君たち、その貿易業者は地の尊い人々であった。"},{"ref":"Isa.23.9","start":23023009,"end":23023009,"break":"line","breaks":[[17,"line"],[36,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[9,2,"えいこう"],[12,1,"ほこり"],[14,1,"けが"],[17,1,"ち"],[23,1,"たっと"],[25,1,"もの"],[39,1,"さだ"]],"text":"万軍の主はすべての栄光の誇を汚し、地のすべての尊い者をはずかしめるためにこれを定められたのだ。"},{"ref":"Isa.23.10","start":23023010,"end":23023010,"break":"line","breaks":[[8,"line"],[26,"line"]],"ruby":[[5,1,"むすめ"],[11,1,"かわ"],[19,1,"ち"],[29,2,"そくばく"]],"text":"タルシシの娘よ、ナイル川のようにおのが地にあふれよ。もはや束縛するものはない。"},{"ref":"Isa.23.11","start":23023011,"end":23023011,"break":"line","breaks":[[13,"line"],[24,"line"],[38,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"て"],[6,1,"うみ"],[8,1,"うえ"],[10,1,"の"],[13,2,"くにぐに"],[16,1,"ふる"],[18,1,"うご"],[24,1,"しゅ"],[33,1,"みことのり"],[35,1,"だ"]],"text":"主はその手を海の上に伸べて国々を震い動かされた。主はカナンについて詔を出し、そのとりでをこわされた。"},{"ref":"Isa.23.12","start":23023012,"end":23023012,"break":"line","breaks":[[7,"line"],[24,"line"],[39,"line"],[50,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[15,2,"しょじょ"],[21,1,"むすめ"],[31,1,"よろこ"],[39,1,"た"],[47,1,"わた"],[58,2,"あんそく"],[61,1,"え"]],"text":"主は言われた、「しえたげられた処女シドンの娘よ、あなたはもはや喜ぶことはない。立って、クプロに渡れ、そこでもあなたは安息を得ることはない」。"},{"ref":"Isa.23.13","start":23023013,"end":23023013,"break":"paragraph","ruby":[[7,1,"くに"],[9,1,"み"],[24,1,"たみ"],[29,1,"の"],[31,1,"けもの"],[37,1,"さだ"],[41,1,"かれ"],[48,1,"た"],[56,2,"きゅうでん"],[63,2,"あらつか"]],"text":"カルデヤびとの国を見よ、アッスリヤではなく、この民がツロを野の獣のすみかに定めた。彼らはやぐらを建て、もろもろの宮殿をこわして荒塚とした。"},{"ref":"Isa.23.14","start":23023014,"end":23023014,"break":"stanza","breaks":[[18,"line"]],"ruby":[[10,1,"ふね"],[13,1,"な"],[15,1,"さけ"],[28,1,"あ"]],"text":"タルシシのもろもろの船よ、泣き叫べ、あなたがたのとりでは荒れすたれたから。"},{"ref":"Isa.23.15","start":23023015,"end":23023015,"break":"paragraph","ruby":[[2,1,"ひ"],[11,1,"おう"],[18,1,"ひ"],[20,1,"おな"],[25,1,"ねん"],[27,1,"あいだ"],[28,1,"わす"],[35,1,"ねん"],[36,1,"おわ"],[39,1,"のち"],[44,2,"ゆうじょ"],[47,1,"うた"]],"text":"その日、ツロはひとりの王のながらえる日と同じく七十年の間忘れられ、七十年終って後、ツロは遊女の歌のようになる、"},{"ref":"Isa.23.16","start":23023016,"end":23023016,"break":"stanza","breaks":[[10,"line"],[22,"line"],[38,"line"]],"ruby":[[1,1,"わす"],[6,2,"ゆうじょ"],[10,1,"こと"],[12,1,"と"],[15,1,"まち"],[17,1,"へ"],[22,1,"たく"],[25,1,"だん"],[28,1,"おお"],[31,1,"うた"],[38,1,"ひと"],[40,1,"おも"],[42,1,"だ"]],"text":"「忘れられた遊女よ、琴を執って町を経めぐり、巧みに弾じ、多くの歌をうたって、人に思い出されよ」。"},{"ref":"Isa.23.17","start":23023017,"end":23023017,"break":"paragraph","ruby":[[2,1,"ねん"],[3,1,"おわ"],[6,1,"のち"],[8,1,"しゅ"],[13,1,"かえり"],[22,1,"ふたた"],[24,2,"いんこう"],[27,1,"あたい"],[29,1,"え"],[32,1,"ち"],[40,1,"よ"],[46,2,"くにぐに"],[49,2,"かんいん"],[52,1,"おこな"]],"text":"七十年終って後、主はツロを顧みられる。ツロは再び淫行の価を得て、地のおもてにある世のすべての国々と姦淫を行い、"},{"ref":"Isa.23.18","start":23023018,"end":23023018,"break":"none","ruby":[[2,2,"しょうひん"],[7,1,"あたい"],[10,1,"しゅ"],[34,1,"つ"],[45,2,"しょうひん"],[48,1,"しゅ"],[50,1,"まえ"],[52,1,"す"],[54,1,"もの"],[59,1,"ゆた"],[62,2,"しょくもつ"],[72,2,"いふく"]],"text":"その商品とその価とは主にささげられる。これはたくわえられることなく、積まれることなく、その商品は主の前に住む者のために豊かな食物となり、みごとな衣服となる。"}]