[{"ref":"1Cor.7.1","start":46007001,"end":46007001,"break":"paragraph","ruby":[[9,1,"か"],[16,1,"こと"],[21,1,"こた"],[26,2,"だんし"],[29,2,"ふじん"]],"text":"さて、あなたがたが書いてよこした事について答えると、男子は婦人にふれないがよい。"},{"ref":"1Cor.7.2","start":46007002,"end":46007002,"break":"none","ruby":[[4,3,"ふひんこう"],[8,1,"おちい"],[19,2,"だんし"],[26,2,"じぶん"],[29,1,"つま"],[31,1,"も"],[34,2,"ふじん"],[41,2,"じぶん"],[44,1,"おっと"],[46,1,"も"]],"text":"しかし、不品行に陥ることのないために、男子はそれぞれ自分の妻を持ち、婦人もそれぞれ自分の夫を持つがよい。"},{"ref":"1Cor.7.3","start":46007003,"end":46007003,"break":"none","ruby":[[0,1,"おっと"],[2,1,"つま"],[6,1,"ぶん"],[8,1,"はた"],[11,1,"つま"],[13,2,"どうよう"],[16,1,"おっと"],[20,1,"ぶん"],[22,1,"はた"]],"text":"夫は妻にその分を果し、妻も同様に夫にその分を果すべきである。"},{"ref":"1Cor.7.4","start":46007004,"end":46007004,"break":"none","ruby":[[0,1,"つま"],[2,2,"じぶん"],[9,2,"じゆう"],[30,1,"おっと"],[35,1,"おっと"],[37,2,"どうよう"],[40,2,"じぶん"],[47,2,"じゆう"],[68,1,"つま"]],"text":"妻は自分のからだを自由にすることはできない。それができるのは夫である。夫も同様に自分のからだを自由にすることはできない。それができるのは妻である。"},{"ref":"1Cor.7.5","start":46007005,"end":46007005,"break":"none","ruby":[[0,1,"たがい"],[2,1,"こば"],[15,2,"ごうい"],[18,1,"うえ"],[20,1,"いのり"],[22,2,"せんしん"],[34,2,"あいわか"],[44,2,"いっしょ"],[68,3,"じせいりょく"],[76,1,"じょう"],[90,2,"ゆうわく"],[96,1,"し"]],"text":"互に拒んではいけない。ただし、合意の上で祈に専心するために、しばらく相別れ、それからまた一緒になることは、さしつかえない。そうでないと、自制力のないのに乗じて、サタンがあなたがたを誘惑するかも知れない。"},{"ref":"1Cor.7.6","start":46007006,"end":46007006,"break":"none","ruby":[[0,2,"いじょう"],[7,2,"じょうほ"],[14,1,"い"],[22,2,"めいれい"]],"text":"以上のことは、譲歩のつもりで言うのであって、命令するのではない。"},{"ref":"1Cor.7.7","start":46007007,"end":46007007,"break":"none","ruby":[[12,1,"もの"],[17,2,"じしん"],[40,1,"かみ"],[48,2,"たまもの"],[61,1,"ひと"],[70,1,"た"],[72,1,"ひと"]],"text":"わたしとしては、みんなの者がわたし自身のようになってほしい。しかし、ひとりびとり神からそれぞれの賜物をいただいていて、ある人はこうしており、他の人はそうしている。"},{"ref":"1Cor.7.8","start":46007008,"end":46007008,"break":"paragraph","ruby":[[0,1,"つぎ"],[3,3,"みこんしゃ"],[16,1,"い"]],"text":"次に、未婚者たちとやもめたちとに言うが、わたしのように、ひとりでおれば、それがいちばんよい。"},{"ref":"1Cor.7.9","start":46007009,"end":46007009,"break":"none","ruby":[[6,1,"じ"],[7,1,"せい"],[20,2,"けっこん"],[28,1,"じょう"],[30,1,"も"],[37,2,"けっこん"],[41,1,"ほう"]],"text":"しかし、もし自制することができないなら、結婚するがよい。情の燃えるよりは、結婚する方が、よいからである。"},{"ref":"1Cor.7.10","start":46007010,"end":46007010,"break":"none","ruby":[[0,1,"さら"],[3,2,"けっこん"],[9,1,"もの"],[13,1,"めい"],[17,1,"めい"],[30,1,"しゅ"],[36,1,"つま"],[38,1,"おっと"],[41,1,"わか"]],"text":"更に、結婚している者たちに命じる。命じるのは、わたしではなく主であるが、妻は夫から別れてはいけない。"},{"ref":"1Cor.7.11","start":46007011,"end":46007011,"break":"none","ruby":[[5,2,"まんいち"],[7,1,"わか"],[15,2,"けっこん"],[29,1,"おっと"],[31,2,"わかい"],[44,1,"おっと"],[46,1,"つま"],[48,2,"りこん"]],"text":"（しかし、万一別れているなら、結婚しないでいるか、それとも夫と和解するかしなさい）。また夫も妻と離婚してはならない。"},{"ref":"1Cor.7.12","start":46007012,"end":46007012,"break":"none","ruby":[[5,2,"ひとびと"],[8,1,"い"],[14,1,"い"],[19,1,"しゅ"],[34,2,"きょうだい"],[37,3,"ふしんじゃ"],[41,1,"つま"],[49,1,"とも"],[56,1,"よろこ"],[61,2,"ばあい"],[66,2,"りこん"]],"text":"そのほかの人々に言う。これを言うのは、主ではなく、わたしである。ある兄弟に不信者の妻があり、そして共にいることを喜んでいる場合には、離婚してはいけない。"},{"ref":"1Cor.7.13","start":46007013,"end":46007013,"break":"none","ruby":[[5,2,"ふじん"],[8,1,"おっと"],[10,3,"ふしんじゃ"],[20,1,"とも"],[27,1,"よろこ"],[32,2,"ばあい"],[37,2,"りこん"]],"text":"また、ある婦人の夫が不信者であり、そして共にいることを喜んでいる場合には、離婚してはいけない。"},{"ref":"1Cor.7.14","start":46007014,"end":46007014,"break":"none","ruby":[[5,3,"ふしんじゃ"],[9,1,"おっと"],[11,1,"つま"],[28,3,"ふしんじゃ"],[32,1,"つま"],[34,1,"おっと"],[69,1,"こ"],[71,1,"けが"],[83,2,"じっさい"]],"text":"なぜなら、不信者の夫は妻によってきよめられており、また、不信者の妻も夫によってきよめられているからである。もしそうでなければ、あなたがたの子は汚れていることになるが、実際はきよいではないか。"},{"ref":"1Cor.7.15","start":46007015,"end":46007015,"break":"none","ruby":[[6,3,"ふしんじゃ"],[10,1,"ほう"],[12,1,"はな"],[15,1,"い"],[21,1,"はな"],[35,2,"きょうだい"],[38,2,"しまい"],[46,2,"ばあい"],[51,2,"そくばく"],[61,1,"かみ"],[70,2,"へいわ"],[73,1,"くら"],[81,1,"め"]],"text":"しかし、もし不信者の方が離れて行くのなら、離れるままにしておくがよい。兄弟も姉妹も、こうした場合には、束縛されてはいない。神は、あなたがたを平和に暮させるために、召されたのである。"},{"ref":"1Cor.7.16","start":46007016,"end":46007016,"break":"none","ruby":[[5,1,"つま"],[12,1,"おっと"],[14,1,"すく"],[35,1,"おっと"],[42,1,"つま"],[44,1,"すく"]],"text":"なぜなら、妻よ、あなたが夫を救いうるかどうか、どうしてわかるか。また、夫よ、あなたも妻を救いうるかどうか、どうしてわかるか。"},{"ref":"1Cor.7.17","start":46007017,"end":46007017,"break":"paragraph","ruby":[[3,2,"かくじ"],[7,1,"しゅ"],[10,1,"たま"],[14,1,"ぶん"],[16,1,"おう"],[21,1,"かみ"],[23,1,"め"],[30,2,"じょうたい"],[39,1,"あゆ"],[55,2,"きょうかい"],[58,1,"たい"],[65,1,"めい"]],"text":"ただ、各自は、主から賜わった分に応じ、また神に召されたままの状態にしたがって、歩むべきである。これが、すべての教会に対してわたしの命じるところである。"},{"ref":"1Cor.7.18","start":46007018,"end":46007018,"break":"none","ruby":[[0,1,"め"],[6,2,"かつれい"],[9,1,"う"],[18,1,"あと"],[35,1,"め"],[41,2,"かつれい"],[44,1,"う"],[54,2,"かつれい"],[57,1,"う"]],"text":"召されたとき割礼を受けていたら、その跡をなくそうとしないがよい。また、召されたとき割礼を受けていなかったら、割礼を受けようとしないがよい。"},{"ref":"1Cor.7.19","start":46007019,"end":46007019,"break":"none","ruby":[[0,2,"かつれい"],[15,2,"もんだい"],[22,2,"だいじ"],[30,1,"かみ"],[32,1,"いまし"],[35,1,"まも"]],"text":"割礼があってもなくても、それは問題ではない。大事なのは、ただ神の戒めを守ることである。"},{"ref":"1Cor.7.20","start":46007020,"end":46007020,"break":"none","ruby":[[0,2,"かくじ"],[4,1,"め"],[11,2,"じょうたい"]],"text":"各自は、召されたままの状態にとどまっているべきである。"},{"ref":"1Cor.7.21","start":46007021,"end":46007021,"break":"none","ruby":[[0,1,"め"],[6,2,"どれい"],[17,1,"き"],[32,2,"じゆう"],[35,1,"み"],[47,2,"じゆう"]],"text":"召されたとき奴隷であっても、それを気にしないがよい。しかし、もし自由の身になりうるなら、むしろ自由になりなさい。"},{"ref":"1Cor.7.22","start":46007022,"end":46007022,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"め"],[9,2,"どれい"],[13,1,"しゅ"],[18,3,"じゆうじん"],[25,1,"もの"],[33,1,"め"],[37,3,"じゆうじん"],[46,2,"どれい"]],"text":"主にあって召された奴隷は、主によって自由人とされた者であり、また、召された自由人はキリストの奴隷なのである。"},{"ref":"1Cor.7.23","start":46007023,"end":46007023,"break":"none","ruby":[[7,2,"だいか"],[10,1,"はら"],[13,1,"か"],[22,1,"ひと"],[24,2,"どれい"]],"text":"あなたがたは、代価を払って買いとられたのだ。人の奴隷となってはいけない。"},{"ref":"1Cor.7.24","start":46007024,"end":46007024,"break":"none","ruby":[[0,2,"きょうだい"],[6,2,"かくじ"],[12,1,"め"],[19,2,"じょうたい"],[23,1,"かみ"]],"text":"兄弟たちよ。各自は、その召されたままの状態で、神のみまえにいるべきである。"},{"ref":"1Cor.7.25","start":46007025,"end":46007025,"break":"paragraph","ruby":[[16,1,"しゅ"],[18,2,"めいれい"],[21,1,"う"],[30,1,"しゅ"],[39,1,"しん"],[40,1,"にん"],[42,1,"う"],[47,1,"もの"],[52,2,"いけん"],[55,1,"の"]],"text":"おとめのことについては、わたしは主の命令を受けてはいないが、主のあわれみにより信任を受けている者として、意見を述べよう。"},{"ref":"1Cor.7.26","start":46007026,"end":46007026,"break":"none","ruby":[[6,1,"かんが"],[10,2,"げんざい"],[12,1,"せま"],[17,2,"きき"],[24,1,"ひと"],[26,2,"げんじょう"]],"text":"わたしはこう考える。現在迫っている危機のゆえに、人は現状にとどまっているがよい。"},{"ref":"1Cor.7.27","start":46007027,"end":46007027,"break":"none","ruby":[[2,1,"つま"],[4,1,"むす"],[13,1,"と"],[21,1,"つま"],[23,1,"むす"],[33,1,"つま"],[35,1,"むか"]],"text":"もし妻に結ばれているなら、解こうとするな。妻に結ばれていないなら、妻を迎えようとするな。"},{"ref":"1Cor.7.28","start":46007028,"end":46007028,"break":"none","ruby":[[7,2,"けっこん"],[13,1,"つみ"],[15,1,"おか"],[30,2,"けっこん"],[36,1,"つみ"],[38,1,"おか"],[53,2,"ひとびと"],[58,1,"み"],[60,2,"くなん"],[63,1,"う"]],"text":"しかし、たとい結婚しても、罪を犯すのではない。また、おとめが結婚しても、罪を犯すのではない。ただ、それらの人々はその身に苦難を受けるであろう。わたしは、あなたがたを、それからのがれさせたいのだ。"},{"ref":"1Cor.7.29","start":46007029,"end":46007029,"break":"none","ruby":[[0,2,"きょうだい"],[10,1,"い"],[15,1,"き"],[22,1,"とき"],[24,1,"ちぢ"],[31,1,"いま"],[35,1,"つま"],[39,1,"もの"]],"text":"兄弟たちよ。わたしの言うことを聞いてほしい。時は縮まっている。今からは妻のある者はないもののように、"},{"ref":"1Cor.7.30","start":46007030,"end":46007030,"break":"none","ruby":[[0,1,"な"],[2,1,"もの"],[4,1,"な"],[15,1,"よろこ"],[17,1,"もの"],[19,1,"よろこ"],[30,1,"か"],[32,1,"もの"],[34,1,"も"]],"text":"泣く者は泣かないもののように、喜ぶ者は喜ばないもののように、買う者は持たないもののように、"},{"ref":"1Cor.7.31","start":46007031,"end":46007031,"break":"none","ruby":[[0,1,"よ"],[2,2,"こうしょう"],[7,1,"もの"],[13,1,"ふか"],[14,1,"い"],[36,1,"よ"],[38,2,"ありさま"],[41,1,"す"],[43,1,"さ"]],"text":"世と交渉のある者は、それに深入りしないようにすべきである。なぜなら、この世の有様は過ぎ去るからである。"},{"ref":"1Cor.7.32","start":46007032,"end":46007032,"break":"none","ruby":[[11,1,"おも"],[13,1,"わずら"],[28,2,"みこん"],[31,2,"だんし"],[34,1,"しゅ"],[39,1,"こころ"],[51,1,"しゅ"],[53,1,"よろこ"]],"text":"わたしはあなたがたが、思い煩わないようにしていてほしい。未婚の男子は主のことに心をくばって、どうかして主を喜ばせようとするが、"},{"ref":"1Cor.7.33","start":46007033,"end":46007033,"break":"none","ruby":[[0,2,"けっこん"],[6,2,"だんし"],[11,1,"よ"],[16,1,"こころ"],[28,1,"つま"],[30,1,"よろこ"],[41,1,"こころ"],[43,1,"わか"]],"text":"結婚している男子はこの世のことに心をくばって、どうかして妻を喜ばせようとして、その心が分れるのである。"},{"ref":"1Cor.7.34","start":46007034,"end":46007034,"break":"none","ruby":[[0,2,"みこん"],[3,2,"ふじん"],[12,1,"しゅ"],[17,1,"こころ"],[24,1,"み"],[26,1,"たましい"],[39,2,"けっこん"],[43,2,"ふじん"],[48,1,"よ"],[53,1,"こころ"],[65,1,"おっと"],[67,1,"よろこ"]],"text":"未婚の婦人とおとめとは、主のことに心をくばって、身も魂もきよくなろうとするが、結婚した婦人はこの世のことに心をくばって、どうかして夫を喜ばせようとする。"},{"ref":"1Cor.7.35","start":46007035,"end":46007035,"break":"none","ruby":[[6,1,"い"],[17,2,"りえき"],[23,1,"おも"],[38,2,"そくばく"],[56,1,"ただ"],[59,2,"せいかつ"],[62,1,"おく"],[66,2,"よねん"],[70,1,"しゅ"],[72,2,"ほうし"]],"text":"わたしがこう言うのは、あなたがたの利益になると思うからであって、あなたがたを束縛するためではない。そうではなく、正しい生活を送って、余念なく主に奉仕させたいからである。"},{"ref":"1Cor.7.36","start":46007036,"end":46007036,"break":"paragraph","ruby":[[4,1,"ひと"],[7,2,"あいて"],[14,1,"たい"],[18,1,"じょう"],[19,1,"ねつ"],[30,2,"ばあい"],[36,2,"てきとう"],[42,1,"おも"],[51,1,"え"],[57,1,"のぞ"],[72,1,"つみ"],[74,1,"おか"],[87,2,"けっこん"]],"text":"もしある人が、相手のおとめに対して、情熱をいだくようになった場合、それは適当でないと思いつつも、やむを得なければ、望みどおりにしてもよい。それは罪を犯すことではない。ふたりは結婚するがよい。"},{"ref":"1Cor.7.37","start":46007037,"end":46007037,"break":"none","ruby":[[4,1,"かれ"],[6,1,"こころ"],[8,1,"うち"],[10,1,"かた"],[12,2,"けっしん"],[19,2,"むり"],[26,2,"じぶん"],[29,1,"おも"],[32,1,"せい"],[43,1,"うえ"],[46,2,"あいて"],[65,1,"こころ"],[67,1,"なか"],[69,1,"き"]],"text":"しかし、彼が心の内で堅く決心していて、無理をしないで自分の思いを制することができ、その上で、相手のおとめをそのままにしておこうと、心の中で決めたなら、そうしてもよい。"},{"ref":"1Cor.7.38","start":46007038,"end":46007038,"break":"none","ruby":[[4,2,"あいて"],[11,2,"けっこん"],[27,2,"けっこん"],[32,1,"ほう"]],"text":"だから、相手のおとめと結婚することはさしつかえないが、結婚しない方がもっとよい。"},{"ref":"1Cor.7.39","start":46007039,"end":46007039,"break":"none","ruby":[[0,1,"つま"],[2,1,"おっと"],[4,1,"い"],[9,1,"あいだ"],[14,1,"おっと"],[24,1,"おっと"],[26,1,"し"],[30,1,"のぞ"],[32,1,"ひと"],[34,2,"けっこん"],[51,1,"しゅ"],[55,1,"もの"],[58,1,"かぎ"]],"text":"妻は夫が生きている間は、その夫につながれている。夫が死ねば、望む人と結婚してもさしつかえないが、それは主にある者とに限る。"},{"ref":"1Cor.7.40","start":46007040,"end":46007040,"break":"none","ruby":[[8,2,"いけん"],[26,2,"こうふく"],[36,1,"かみ"],[38,1,"れい"],[40,1,"う"],[46,1,"おも"]],"text":"しかし、わたしの意見では、そのままでいたなら、もっと幸福である。わたしも神の霊を受けていると思う。"}]