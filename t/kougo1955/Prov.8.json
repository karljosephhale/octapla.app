[{"ref":"Prov.8.1","start":20008001,"end":20008001,"break":"paragraph","breaks":[[12,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"よ"],[12,1,"さと"],[15,1,"こえ"]],"text":"知恵は呼ばわらないのか、悟りは声をあげないのか。"},{"ref":"Prov.8.2","start":20008002,"end":20008002,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"みち"],[9,1,"たか"],[11,1,"ところ"],[13,1,"いただき"],[22,1,"なか"],[24,1,"た"]],"text":"これは道のほとりの高い所の頂、また、ちまたの中に立ち、"},{"ref":"Prov.8.3","start":20008003,"end":20008003,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"まち"],[2,2,"いりぐち"],[12,1,"もん"],[19,2,"せいもん"],[22,2,"いりぐち"],[25,1,"よ"],[30,1,"い"]],"text":"町の入口にあるもろもろの門のかたわら、正門の入口で呼ばわって言う、"},{"ref":"Prov.8.4","start":20008004,"end":20008004,"break":"line","breaks":[[20,"line"]],"ruby":[[1,2,"ひとびと"],[15,1,"よ"],[20,1,"こえ"],[25,1,"ひと"],[27,1,"こ"],[30,1,"よ"]],"text":"「人々よ、わたしはあなたがたに呼ばわり、声をあげて人の子らを呼ぶ。"},{"ref":"Prov.8.5","start":20008005,"end":20008005,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"しりょ"],[5,1,"もの"],[8,1,"さと"],[11,1,"え"],[14,1,"おろ"],[17,1,"もの"],[20,2,"ちえ"],[23,1,"え"]],"text":"思慮のない者よ、悟りを得よ、愚かな者よ、知恵を得よ。"},{"ref":"Prov.8.6","start":20008006,"end":20008006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"き"],[7,2,"こうき"],[10,1,"こと"],[12,1,"かた"],[22,1,"ただ"],[25,1,"こと"],[27,1,"かた"],[29,1,"だ"]],"text":"聞け、わたしは高貴な事を語り、わがくちびるは正しい事を語り出す。"},{"ref":"Prov.8.7","start":20008007,"end":20008007,"break":"line","breaks":[[10,"line"]],"ruby":[[2,1,"くち"],[4,2,"しんじつ"],[7,1,"の"],[17,1,"あ"],[20,1,"こと"],[22,1,"にく"]],"text":"わが口は真実を述べ、わがくちびるは悪しき事を憎む。"},{"ref":"Prov.8.8","start":20008008,"end":20008008,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"くち"],[4,2,"ことば"],[9,1,"ただ"],[18,1,"いつわ"]],"text":"わが口の言葉はみな正しい、そのうちに偽りと、よこしまはない。"},{"ref":"Prov.8.9","start":20008009,"end":20008009,"break":"line","breaks":[[21,"line"]],"ruby":[[9,1,"もの"],[11,1,"あき"],[21,2,"ちしき"],[24,1,"え"],[26,1,"もの"],[28,1,"ただ"]],"text":"これはみな、さとき者の明らかにするところ、知識を得る者の正しとするところである。"},{"ref":"Prov.8.10","start":20008010,"end":20008010,"break":"line","breaks":[[25,"line"]],"ruby":[[6,1,"ぎん"],[8,1,"う"],[19,1,"おしえ"],[21,1,"う"],[25,1,"せい"],[26,1,"きん"],[34,2,"ちしき"],[37,1,"え"]],"text":"あなたがたは銀を受けるよりも、わたしの教を受けよ、精金よりも、むしろ知識を得よ。"},{"ref":"Prov.8.11","start":20008011,"end":20008011,"break":"line","breaks":[[10,"line"],[25,"line"]],"ruby":[[0,2,"ちえ"],[3,2,"ほうせき"],[16,1,"のぞ"],[22,1,"もの"],[28,1,"くら"]],"text":"知恵は宝石にまさり、あなたがたの望むすべての物は、これと比べるにたりない。"},{"ref":"Prov.8.12","start":20008012,"end":20008012,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"ちえ"],[9,1,"さと"],[18,2,"ちしき"],[21,1,"つつし"]],"text":"知恵であるわたしは悟りをすみかとし、知識と慎みとをもつ。"},{"ref":"Prov.8.13","start":20008013,"end":20008013,"break":"line","breaks":[[17,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[7,1,"あく"],[9,1,"にく"],[21,1,"たか"],[31,1,"あ"],[34,1,"みち"],[37,1,"いつわ"],[40,2,"ことば"],[44,1,"にく"]],"text":"主を恐れるとは悪を憎むことである。わたしは高ぶりと、おごりと、悪しき道と、偽りの言葉とを憎む。"},{"ref":"Prov.8.14","start":20008014,"end":20008014,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"はか"],[6,1,"たし"],[9,2,"ちえ"],[26,1,"さと"],[37,1,"ちから"]],"text":"計りごとと、確かな知恵とは、わたしにある、わたしには悟りがあり、わたしには力がある。"},{"ref":"Prov.8.15","start":20008015,"end":20008015,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"おう"],[11,1,"もの"],[13,1,"よ"],[15,1,"おさ"],[18,1,"きみ"],[21,1,"もの"],[23,1,"ただ"],[26,1,"さだ"],[29,1,"た"]],"text":"わたしによって、王たる者は世を治め、君たる者は正しい定めを立てる。"},{"ref":"Prov.8.16","start":20008016,"end":20008016,"break":"line","breaks":[[17,"line"]],"ruby":[[8,1,"しゅ"],[11,1,"もの"],[13,2,"しはい"],[22,1,"もの"],[24,1,"ち"],[26,1,"おさ"]],"text":"わたしによって、主たる者は支配し、つかさたる者は地を治める。"},{"ref":"Prov.8.17","start":20008017,"end":20008017,"break":"line","breaks":[[18,"line"]],"ruby":[[9,1,"あい"],[12,1,"もの"],[14,1,"あい"],[25,1,"もと"],[28,1,"もの"],[35,2,"であ"]],"text":"わたしは、わたしを愛する者を愛する、わたしをせつに求める者は、わたしに出会う。"},{"ref":"Prov.8.18","start":20008018,"end":20008018,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"とみ"],[2,1,"ほまれ"],[16,1,"たから"],[18,2,"はんえい"]],"text":"富と誉とはわたしにあり、すぐれた宝と繁栄もまたそうである。"},{"ref":"Prov.8.19","start":20008019,"end":20008019,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"み"],[6,1,"きん"],[10,1,"せい"],[11,1,"きん"],[15,1,"よ"],[22,2,"さんぶつ"],[25,1,"せい"],[26,1,"ぎん"]],"text":"わたしの実は金よりも精金よりも良く、わたしの産物は精銀にまさる。"},{"ref":"Prov.8.20","start":20008020,"end":20008020,"break":"line","ruby":[[4,2,"せいぎ"],[7,1,"みち"],[9,2,"こうせい"],[12,2,"みちすじ"],[15,1,"なか"],[17,1,"あゆ"]],"text":"わたしは正義の道、公正な道筋の中を歩み、"},{"ref":"Prov.8.21","start":20008021,"end":20008021,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"あい"],[7,1,"もの"],[9,1,"たから"],[11,1,"え"],[19,1,"くら"],[21,1,"み"]],"text":"わたしを愛する者に宝を得させ、またその倉を満ちさせる。"},{"ref":"Prov.8.22","start":20008022,"end":20008022,"break":"stanza","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"むかし"],[10,1,"はじ"],[23,1,"はじ"],[33,1,"つく"]],"text":"主が昔そのわざをなし始められるとき、そのわざの初めとして、わたしを造られた。"},{"ref":"Prov.8.23","start":20008023,"end":20008023,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"ち"],[11,1,"とき"],[13,1,"はじ"],[21,1,"た"]],"text":"いにしえ、地のなかった時、初めに、わたしは立てられた。"},{"ref":"Prov.8.24","start":20008024,"end":20008024,"break":"line","breaks":[[23,"line"]],"ruby":[[2,1,"うみ"],[9,1,"おお"],[13,1,"みず"],[15,1,"いずみ"],[21,1,"とき"],[30,1,"うま"]],"text":"まだ海もなく、また大いなる水の泉もなかった時、わたしはすでに生れ、"},{"ref":"Prov.8.25","start":20008025,"end":20008025,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"やま"],[4,1,"さだ"],[10,1,"おか"],[18,1,"とき"],[27,1,"うま"]],"text":"山もまだ定められず、丘もまだなかった時、わたしはすでに生れた。"},{"ref":"Prov.8.26","start":20008026,"end":20008026,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"かみ"],[8,1,"ち"],[11,1,"の"],[15,1,"ち"],[24,1,"つく"],[31,1,"とき"]],"text":"すなわち神がまだ地をも野をも、地のちりのもとをも造られなかった時である。"},{"ref":"Prov.8.27","start":20008027,"end":20008027,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かれ"],[2,1,"てん"],[4,1,"つく"],[7,1,"うみ"],[14,2,"おおぞら"],[17,1,"は"]],"text":"彼が天を造り、海のおもてに、大空を張られたとき、わたしはそこにあった。"},{"ref":"Prov.8.28","start":20008028,"end":20008028,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[2,1,"うえ"],[4,1,"そら"],[6,1,"かた"],[8,1,"た"],[12,1,"ふち"],[14,1,"いずみ"],[19,1,"さだ"]],"text":"彼が上に空を堅く立たせ、淵の泉をつよく定め、"},{"ref":"Prov.8.29","start":20008029,"end":20008029,"break":"line","breaks":[[10,"line"],[25,"line"]],"ruby":[[0,1,"うみ"],[4,2,"げんかい"],[10,1,"みず"],[14,1,"きし"],[16,1,"こ"],[27,1,"ち"],[29,1,"もとい"],[31,1,"さだ"]],"text":"海にその限界をたて、水にその岸を越えないようにし、また地の基を定められたとき、"},{"ref":"Prov.8.30","start":20008030,"end":20008030,"break":"line","breaks":[[22,"line"]],"ruby":[[16,2,"めいしょう"],[22,2,"ひび"],[25,1,"よろこ"],[28,1,"つね"],[32,1,"まえ"],[34,1,"たの"]],"text":"わたしは、そのかたわらにあって、名匠となり、日々に喜び、常にその前に楽しみ、"},{"ref":"Prov.8.31","start":20008031,"end":20008031,"break":"line","breaks":[[8,"line"]],"ruby":[[2,1,"ち"],[4,1,"たの"],[10,1,"よ"],[12,1,"ひと"],[14,1,"よろこ"]],"text":"その地で楽しみ、また世の人を喜んだ。"},{"ref":"Prov.8.32","start":20008032,"end":20008032,"break":"stanza","breaks":[[23,"line"]],"ruby":[[5,2,"こども"],[10,1,"いま"],[15,1,"い"],[20,1,"き"],[27,1,"みち"],[29,1,"まも"],[31,1,"もの"]],"text":"それゆえ、子供らよ、今わたしの言うことを聞け、わたしの道を守る者はさいわいである。"},{"ref":"Prov.8.33","start":20008033,"end":20008033,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"きょうくん"],[3,1,"き"],[7,2,"ちえ"],[10,1,"え"],[16,1,"す"]],"text":"教訓を聞いて、知恵を得よ、これを捨ててはならない。"},{"ref":"Prov.8.34","start":20008034,"end":20008034,"break":"line","breaks":[[12,"line"],[30,"line"]],"ruby":[[4,1,"い"],[9,1,"き"],[12,2,"ひび"],[18,1,"もん"],[34,2,"とぐち"],[37,1,"はしら"],[42,1,"ま"],[44,1,"ひと"]],"text":"わたしの言うことを聞き、日々わたしの門のかたわらでうかがい、わたしの戸口の柱のわきで待つ人はさいわいである。"},{"ref":"Prov.8.35","start":20008035,"end":20008035,"break":"line","breaks":[[16,"line"]],"ruby":[[8,1,"え"],[10,1,"もの"],[12,1,"いのち"],[14,1,"え"],[16,1,"しゅ"],[19,1,"めぐ"],[22,1,"え"]],"text":"それは、わたしを得る者は命を得、主から恵みを得るからである。"},{"ref":"Prov.8.36","start":20008036,"end":20008036,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"うしな"],[6,1,"もの"],[8,2,"じぶん"],[11,1,"いのち"],[25,1,"にく"],[27,1,"もの"],[29,1,"し"],[31,1,"あい"],[34,1,"もの"]],"text":"わたしを失う者は自分の命をそこなう、すべてわたしを憎む者は死を愛する者である」。"}]