[{"ref":"Matt.13.1","start":40013001,"end":40013001,"break":"paragraph","ruby":[[2,1,"ひ"],[8,1,"いえ"],[10,1,"で"],[13,1,"うみ"]],"text":"その日、イエスは家を出て、海べにすわっておられた。"},{"ref":"Matt.13.2","start":40013002,"end":40013002,"break":"none","ruby":[[5,1,"おお"],[9,2,"ぐんしゅう"],[16,1,"あつ"],[27,1,"ふね"],[29,1,"の"],[37,2,"ぐんしゅう"],[42,1,"きし"],[44,1,"た"]],"text":"ところが、大ぜいの群衆がみもとに集まったので、イエスは舟に乗ってすわられ、群衆はみな岸に立っていた。"},{"ref":"Matt.13.3","start":40013003,"end":40013003,"break":"none","ruby":[[4,1,"たとえ"],[6,1,"おお"],[9,1,"こと"],[11,1,"かた"],[16,1,"い"],[22,1,"み"],[25,1,"たね"],[29,1,"たね"],[34,1,"で"],[36,1,"い"]],"text":"イエスは譬で多くの事を語り、こう言われた、「見よ、種まきが種をまきに出て行った。"},{"ref":"Matt.13.4","start":40013004,"end":40013004,"break":"none","ruby":[[9,1,"みち"],[13,1,"お"],[16,1,"たね"],[26,1,"とり"],[30,1,"た"]],"text":"まいているうちに、道ばたに落ちた種があった。すると、鳥がきて食べてしまった。"},{"ref":"Matt.13.5","start":40013005,"end":40013005,"break":"none","ruby":[[3,1,"たね"],[5,1,"つち"],[7,1,"うす"],[9,2,"いしじ"],[12,1,"お"],[19,1,"つち"],[21,1,"ふか"],[30,1,"め"],[32,1,"だ"]],"text":"ほかの種は土の薄い石地に落ちた。そこは土が深くないので、すぐ芽を出したが、"},{"ref":"Matt.13.6","start":40013006,"end":40013006,"break":"none","ruby":[[0,1,"ひ"],[2,1,"のぼ"],[5,1,"や"],[9,1,"ね"],[16,1,"か"]],"text":"日が上ると焼けて、根がないために枯れてしまった。"},{"ref":"Matt.13.7","start":40013007,"end":40013007,"break":"none","ruby":[[3,1,"たね"],[9,1,"ち"],[11,1,"お"],[23,1,"の"]],"text":"ほかの種はいばらの地に落ちた。すると、いばらが伸びて、ふさいでしまった。"},{"ref":"Matt.13.8","start":40013008,"end":40013008,"break":"none","ruby":[[3,1,"たね"],[5,1,"よ"],[7,1,"ち"],[9,1,"お"],[12,1,"み"],[14,1,"むす"],[23,1,"ばい"],[32,1,"ばい"],[41,1,"ばい"]],"text":"ほかの種は良い地に落ちて実を結び、あるものは百倍、あるものは六十倍、あるものは三十倍にもなった。"},{"ref":"Matt.13.9","start":40013009,"end":40013009,"break":"none","ruby":[[0,1,"みみ"],[4,1,"もの"],[6,1,"き"]],"text":"耳のある者は聞くがよい」。"},{"ref":"Matt.13.10","start":40013010,"end":40013010,"break":"paragraph","ruby":[[5,2,"でし"],[14,2,"ちかよ"],[20,1,"い"],[28,1,"かれ"],[31,1,"たとえ"],[34,1,"はな"]],"text":"それから、弟子たちがイエスに近寄ってきて言った、「なぜ、彼らに譬でお話しになるのですか」。"},{"ref":"Matt.13.11","start":40013011,"end":40013011,"break":"none","ruby":[[7,1,"こた"],[10,1,"い"],[24,2,"てんごく"],[27,2,"おくぎ"],[30,1,"し"],[35,1,"ゆる"],[43,1,"かれ"],[47,1,"ゆる"]],"text":"そこでイエスは答えて言われた、「あなたがたには、天国の奥義を知ることが許されているが、彼らには許されていない。"},{"ref":"Matt.13.12","start":40013012,"end":40013012,"break":"none","ruby":[[5,1,"も"],[10,1,"ひと"],[12,1,"あた"],[22,1,"ゆた"],[29,1,"も"],[35,1,"ひと"],[38,1,"も"],[48,1,"と"],[50,1,"あ"]],"text":"おおよそ、持っている人は与えられて、いよいよ豊かになるが、持っていない人は、持っているものまでも取り上げられるであろう。"},{"ref":"Matt.13.13","start":40013013,"end":40013013,"break":"none","ruby":[[4,1,"かれ"],[8,1,"たとえ"],[10,1,"かた"],[20,1,"かれ"],[24,1,"み"],[27,1,"み"],[30,1,"き"],[34,1,"き"],[40,1,"さと"]],"text":"だから、彼らには譬で語るのである。それは彼らが、見ても見ず、聞いても聞かず、また悟らないからである。"},{"ref":"Matt.13.14","start":40013014,"end":40013014,"break":"none","breaks":[[29,"stanza"],[52,"line"]],"ruby":[[8,1,"い"],[11,2,"よげん"],[15,1,"かれ"],[18,1,"うえ"],[20,2,"じょうじゅ"],[36,1,"き"],[40,1,"き"],[44,1,"けっ"],[47,1,"さと"],[52,1,"み"],[56,1,"み"],[60,1,"けっ"],[63,1,"みと"]],"text":"こうしてイザヤの言った預言が、彼らの上に成就したのである。『あなたがたは聞くには聞くが、決して悟らない。見るには見るが、決して認めない。"},{"ref":"Matt.13.15","start":40013015,"end":40013015,"break":"line","breaks":[[11,"line"],[21,"line"],[31,"line"],[55,"line"]],"ruby":[[2,1,"たみ"],[4,1,"こころ"],[6,1,"にぶ"],[13,1,"みみ"],[15,1,"きこ"],[23,1,"め"],[25,1,"と"],[35,1,"かれ"],[38,1,"め"],[40,1,"み"],[43,1,"みみ"],[45,1,"き"],[49,1,"こころ"],[51,1,"さと"],[55,1,"く"],[57,1,"あらた"]],"text":"この民の心は鈍くなり、その耳は聞えにくく、その目は閉じている。それは、彼らが目で見ず、耳で聞かず、心で悟らず、悔い改めていやされることがないためである』。"},{"ref":"Matt.13.16","start":40013016,"end":40013016,"break":"paragraph","ruby":[[10,1,"め"],[12,1,"み"],[17,1,"みみ"],[19,1,"き"]],"text":"しかし、あなたがたの目は見ており、耳は聞いているから、さいわいである。"},{"ref":"Matt.13.17","start":40013017,"end":40013017,"break":"none","ruby":[[8,1,"い"],[14,1,"おお"],[17,3,"よげんしゃ"],[21,2,"ぎじん"],[31,1,"み"],[38,1,"み"],[42,2,"ねっしん"],[45,1,"ねが"],[50,1,"み"],[67,1,"き"],[75,1,"き"],[83,1,"き"]],"text":"あなたがたによく言っておく。多くの預言者や義人は、あなたがたの見ていることを見ようと熱心に願ったが、見ることができず、またあなたがたの聞いていることを聞こうとしたが、聞けなかったのである。"},{"ref":"Matt.13.18","start":40013018,"end":40013018,"break":"none","ruby":[[4,1,"たね"],[8,1,"たとえ"],[10,1,"き"]],"text":"そこで、種まきの譬を聞きなさい。"},{"ref":"Matt.13.19","start":40013019,"end":40013019,"break":"none","ruby":[[4,2,"みくに"],[7,1,"ことば"],[9,1,"き"],[12,1,"さと"],[20,1,"わる"],[22,1,"もの"],[29,1,"ひと"],[31,1,"こころ"],[40,1,"うば"],[45,1,"い"],[48,1,"みち"],[68,1,"ひと"]],"text":"だれでも御国の言を聞いて悟らないならば、悪い者がきて、その人の心にまかれたものを奪いとって行く。道ばたにまかれたものというのは、そういう人のことである。"},{"ref":"Matt.13.20","start":40013020,"end":40013020,"break":"none","ruby":[[0,2,"いしじ"],[15,2,"みことば"],[18,1,"き"],[25,1,"よろこ"],[28,1,"う"],[31,1,"ひと"]],"text":"石地にまかれたものというのは、御言を聞くと、すぐに喜んで受ける人のことである。"},{"ref":"Matt.13.21","start":40013021,"end":40013021,"break":"none","ruby":[[2,1,"なか"],[4,1,"ね"],[15,1,"つづ"],[24,2,"みことば"],[30,2,"こんなん"],[33,2,"はくがい"],[36,1,"おこ"]],"text":"その中に根がないので、しばらく続くだけであって、御言のために困難や迫害が起ってくると、すぐつまずいてしまう。"},{"ref":"Matt.13.22","start":40013022,"end":40013022,"break":"none","ruby":[[7,1,"なか"],[18,2,"みことば"],[21,1,"き"],[25,1,"よ"],[27,1,"こころ"],[32,1,"とみ"],[34,1,"まど"],[39,2,"みことば"],[48,1,"み"],[50,1,"むす"],[56,1,"ひと"]],"text":"また、いばらの中にまかれたものとは、御言を聞くが、世の心づかいと富の惑わしとが御言をふさぐので、実を結ばなくなる人のことである。"},{"ref":"Matt.13.23","start":40013023,"end":40013023,"break":"none","ruby":[[3,1,"よ"],[5,1,"ち"],[16,2,"みことば"],[19,1,"き"],[22,1,"さと"],[24,1,"ひと"],[37,1,"ひと"],[39,1,"み"],[41,1,"むす"],[45,1,"ばい"],[53,1,"ばい"],[61,1,"ばい"]],"text":"また、良い地にまかれたものとは、御言を聞いて悟る人のことであって、そういう人が実を結び、百倍、あるいは六十倍、あるいは三十倍にもなるのである」。"},{"ref":"Matt.13.24","start":40013024,"end":40013024,"break":"paragraph","ruby":[[6,1,"たとえ"],[8,1,"かれ"],[11,1,"しめ"],[14,1,"い"],[20,2,"てんごく"],[24,1,"よ"],[26,1,"たね"],[28,2,"じぶん"],[31,1,"はたけ"],[39,1,"ひと"]],"text":"また、ほかの譬を彼らに示して言われた、「天国は、良い種を自分の畑にまいておいた人のようなものである。"},{"ref":"Matt.13.25","start":40013025,"end":40013025,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"ねむ"],[8,1,"あいだ"],[10,1,"てき"],[15,1,"むぎ"],[17,1,"なか"],[19,1,"どく"],[20,1,"むぎ"],[25,1,"た"],[27,1,"さ"]],"text":"人々が眠っている間に敵がきて、麦の中に毒麦をまいて立ち去った。"},{"ref":"Matt.13.26","start":40013026,"end":40013026,"break":"none","ruby":[[0,1,"め"],[4,1,"で"],[6,1,"み"],[8,1,"むす"],[12,2,"どうじ"],[15,1,"どく"],[16,1,"むぎ"]],"text":"芽がはえ出て実を結ぶと、同時に毒麦もあらわれてきた。"},{"ref":"Matt.13.27","start":40013027,"end":40013027,"break":"none","ruby":[[0,1,"しもべ"],[7,1,"いえ"],[9,2,"しゅじん"],[12,1,"い"],[18,3,"しゅじんさま"],[22,1,"はたけ"],[34,1,"よ"],[36,1,"たね"],[53,1,"どく"],[54,1,"むぎ"]],"text":"僕たちがきて、家の主人に言った、『ご主人様、畑におまきになったのは、良い種ではありませんでしたか。どうして毒麦がはえてきたのですか』。"},{"ref":"Matt.13.28","start":40013028,"end":40013028,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"い"],[11,1,"てき"],[22,1,"しもべ"],[26,1,"い"],[32,1,"い"],[39,1,"ぬ"],[41,1,"あつ"]],"text":"主人は言った、『それは敵のしわざだ』。すると僕たちが言った『では行って、それを抜き集めましょうか』。"},{"ref":"Matt.13.29","start":40013029,"end":40013029,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[10,1,"どく"],[11,1,"むぎ"],[13,1,"あつ"],[21,1,"むぎ"],[23,2,"いっしょ"],[26,1,"ぬ"],[30,1,"し"]],"text":"彼は言った、『いや、毒麦を集めようとして、麦も一緒に抜くかも知れない。"},{"ref":"Matt.13.30","start":40013030,"end":40013030,"break":"none","ruby":[[0,2,"しゅうかく"],[5,2,"りょうほう"],[9,1,"そだ"],[19,2,"しゅうかく"],[22,1,"とき"],[29,1,"か"],[31,1,"もの"],[36,1,"どく"],[37,1,"むぎ"],[39,1,"あつ"],[42,1,"たば"],[46,1,"や"],[49,1,"むぎ"],[51,1,"ほう"],[53,1,"あつ"],[56,1,"くら"],[58,1,"い"],[65,1,"い"]],"text":"収穫まで、両方とも育つままにしておけ。収穫の時になったら、刈る者に、まず毒麦を集めて束にして焼き、麦の方は集めて倉に入れてくれ、と言いつけよう』」。"},{"ref":"Matt.13.31","start":40013031,"end":40013031,"break":"paragraph","ruby":[[6,1,"たとえ"],[8,1,"かれ"],[11,1,"しめ"],[14,1,"い"],[20,2,"てんごく"],[25,1,"つぶ"],[30,1,"だね"],[43,1,"ひと"],[51,1,"はたけ"]],"text":"また、ほかの譬を彼らに示して言われた、「天国は、一粒のからし種のようなものである。ある人がそれをとって畑にまくと、"},{"ref":"Matt.13.32","start":40013032,"end":40013032,"break":"none","ruby":[[6,1,"たね"],[10,1,"ちい"],[15,2,"せいちょう"],[21,2,"やさい"],[24,1,"なか"],[30,1,"おお"],[36,1,"そら"],[38,1,"とり"],[45,1,"えだ"],[47,1,"やど"],[52,1,"き"]],"text":"それはどんな種よりも小さいが、成長すると、野菜の中でいちばん大きくなり、空の鳥がきて、その枝に宿るほどの木になる」。"},{"ref":"Matt.13.33","start":40013033,"end":40013033,"break":"paragraph","ruby":[[5,1,"たとえ"],[7,1,"かれ"],[10,1,"かた"],[16,2,"てんごく"],[22,1,"たね"],[33,1,"おんな"],[38,1,"と"],[42,1,"と"],[44,1,"こな"],[46,1,"なか"],[48,1,"ま"],[53,2,"ぜんたい"]],"text":"またほかの譬を彼らに語られた、「天国は、パン種のようなものである。女がそれを取って三斗の粉の中に混ぜると、全体がふくらんでくる」。"},{"ref":"Matt.13.34","start":40013034,"end":40013034,"break":"paragraph","ruby":[[15,1,"たとえ"],[17,2,"ぐんしゅう"],[20,1,"かた"],[25,1,"たとえ"],[33,2,"なにごと"],[36,1,"かれ"],[39,1,"かた"]],"text":"イエスはこれらのことをすべて、譬で群衆に語られた。譬によらないでは何事も彼らに語られなかった。"},{"ref":"Matt.13.35","start":40013035,"end":40013035,"break":"none","breaks":[[28,"stanza"],[43,"line"]],"ruby":[[3,3,"よげんしゃ"],[10,1,"い"],[18,2,"じょうじゅ"],[33,1,"くち"],[35,1,"ひら"],[38,1,"たとえ"],[40,1,"かた"],[43,1,"よ"],[45,1,"はじ"],[49,1,"かく"],[58,1,"かた"],[60,1,"だ"]],"text":"これは預言者によって言われたことが、成就するためである、「わたしは口を開いて譬を語り、世の初めから隠されていることを語り出そう」。"},{"ref":"Matt.13.36","start":40013036,"end":40013036,"break":"paragraph","ruby":[[9,2,"ぐんしゅう"],[15,1,"のこ"],[18,1,"いえ"],[29,2,"でし"],[41,1,"い"],[46,1,"はたけ"],[48,1,"どく"],[49,1,"むぎ"],[51,1,"たとえ"],[53,2,"せつめい"]],"text":"それからイエスは、群衆をあとに残して家にはいられた。すると弟子たちは、みもとにきて言った、「畑の毒麦の譬を説明してください」。"},{"ref":"Matt.13.37","start":40013037,"end":40013037,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[13,1,"よ"],[15,1,"たね"],[19,1,"もの"],[22,1,"ひと"],[24,1,"こ"]],"text":"イエスは答えて言われた、「良い種をまく者は、人の子である。"},{"ref":"Matt.13.38","start":40013038,"end":40013038,"break":"none","ruby":[[0,1,"はたけ"],[2,2,"せかい"],[8,1,"よ"],[10,1,"たね"],[12,1,"い"],[16,2,"みくに"],[19,1,"こ"],[24,1,"どく"],[25,1,"むぎ"],[27,1,"わる"],[29,1,"もの"],[31,1,"こ"]],"text":"畑は世界である。良い種と言うのは御国の子たちで、毒麦は悪い者の子たちである。"},{"ref":"Matt.13.39","start":40013039,"end":40013039,"break":"none","ruby":[[6,1,"てき"],[8,2,"あくま"],[14,2,"しゅうかく"],[18,1,"よ"],[20,1,"おわ"],[27,1,"か"],[29,1,"もの"],[31,2,"みつかい"]],"text":"それをまいた敵は悪魔である。収穫とは世の終りのことで、刈る者は御使たちである。"},{"ref":"Matt.13.40","start":40013040,"end":40013040,"break":"none","ruby":[[4,1,"どく"],[5,1,"むぎ"],[7,1,"あつ"],[12,1,"ひ"],[14,1,"や"],[22,1,"よ"],[24,1,"おわ"]],"text":"だから、毒麦が集められて火で焼かれるように、世の終りにもそのとおりになるであろう。"},{"ref":"Matt.13.41","start":40013041,"end":40013041,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[6,1,"つかい"],[25,2,"ふほう"],[28,1,"おこな"],[30,1,"もの"],[39,2,"みくに"],[45,1,"あつ"]],"text":"人の子はその使たちをつかわし、つまずきとなるものと不法を行う者とを、ことごとく御国からとり集めて、"},{"ref":"Matt.13.42","start":40013042,"end":40013042,"break":"none","ruby":[[0,1,"ろ"],[2,1,"ひ"],[4,1,"な"],[6,1,"い"],[20,1,"な"],[22,1,"さけ"],[27,1,"は"]],"text":"炉の火に投げ入れさせるであろう。そこでは泣き叫んだり、歯がみをしたりするであろう。"},{"ref":"Matt.13.43","start":40013043,"end":40013043,"break":"none","ruby":[[5,2,"ぎじん"],[10,1,"かれ"],[13,1,"ちち"],[15,2,"みくに"],[19,2,"たいよう"],[25,1,"かがや"],[35,1,"みみ"],[39,1,"もの"],[41,1,"き"]],"text":"そのとき、義人たちは彼らの父の御国で、太陽のように輝きわたるであろう。耳のある者は聞くがよい。"},{"ref":"Matt.13.44","start":40013044,"end":40013044,"break":"paragraph","ruby":[[0,2,"てんごく"],[4,1,"はたけ"],[6,1,"かく"],[11,1,"たから"],[22,1,"ひと"],[27,1,"み"],[32,1,"かく"],[38,1,"よろこ"],[45,1,"い"],[48,1,"も"],[50,1,"もの"],[54,1,"う"],[65,1,"はたけ"],[67,1,"か"]],"text":"天国は、畑に隠してある宝のようなものである。人がそれを見つけると隠しておき、喜びのあまり、行って持ち物をみな売りはらい、そしてその畑を買うのである。"},{"ref":"Matt.13.45","start":40013045,"end":40013045,"break":"paragraph","ruby":[[2,2,"てんごく"],[6,1,"よ"],[8,2,"しんじゅ"],[11,1,"さが"],[16,2,"しょうにん"]],"text":"また天国は、良い真珠を捜している商人のようなものである。"},{"ref":"Matt.13.46","start":40013046,"end":40013046,"break":"none","ruby":[[0,2,"こうか"],[3,2,"しんじゅ"],[6,1,"こ"],[8,1,"み"],[14,1,"い"],[17,1,"も"],[19,1,"もの"],[23,1,"う"],[35,1,"か"]],"text":"高価な真珠一個を見いだすと、行って持ち物をみな売りはらい、そしてこれを買うのである。"},{"ref":"Matt.13.47","start":40013047,"end":40013047,"break":"paragraph","ruby":[[2,2,"てんごく"],[6,1,"うみ"],[17,2,"しゅるい"],[20,1,"うお"],[22,1,"かこ"],[27,1,"あみ"]],"text":"また天国は、海におろして、あらゆる種類の魚を囲みいれる網のようなものである。"},{"ref":"Matt.13.48","start":40013048,"end":40013048,"break":"none","ruby":[[11,1,"きし"],[13,1,"ひ"],[15,1,"あ"],[26,1,"よ"],[30,1,"うつわ"],[32,1,"い"],[35,1,"わる"],[39,1,"そと"],[41,1,"す"]],"text":"それがいっぱいになると岸に引き上げ、そしてすわって、良いのを器に入れ、悪いのを外へ捨てるのである。"},{"ref":"Matt.13.49","start":40013049,"end":40013049,"break":"none","ruby":[[0,1,"よ"],[2,1,"おわ"],[25,2,"みつかい"],[33,2,"ぎじん"],[40,2,"あくにん"],[45,1,"わ"]],"text":"世の終りにも、そのとおりになるであろう。すなわち、御使たちがきて、義人のうちから悪人をえり分け、"},{"ref":"Matt.13.50","start":40013050,"end":40013050,"break":"none","ruby":[[3,1,"ろ"],[5,1,"ひ"],[7,1,"な"],[20,1,"な"],[22,1,"さけ"],[27,1,"は"]],"text":"そして炉の火に投げこむであろう。そこでは泣き叫んだり、歯がみをしたりするであろう。"},{"ref":"Matt.13.51","start":40013051,"end":40013051,"break":"paragraph","ruby":[[14,1,"みな"],[22,1,"かれ"],[34,1,"こた"]],"text":"あなたがたは、これらのことが皆わかったか」。彼らは「わかりました」と答えた。"},{"ref":"Matt.13.52","start":40013052,"end":40013052,"break":"none","ruby":[[8,1,"かれ"],[11,1,"い"],[23,2,"てんごく"],[29,1,"まな"],[32,2,"がくしゃ"],[36,1,"あたら"],[42,1,"ふる"],[51,1,"くら"],[54,1,"と"],[56,1,"だ"],[58,2,"いっか"],[61,2,"しゅじん"]],"text":"そこで、イエスは彼らに言われた、「それだから、天国のことを学んだ学者は、新しいものと古いものとを、その倉から取り出す一家の主人のようなものである」。"},{"ref":"Matt.13.53","start":40013053,"end":40013053,"break":"paragraph","ruby":[[8,1,"たとえ"],[10,1,"かた"],[12,1,"お"],[21,1,"た"],[23,1,"さ"]],"text":"イエスはこれらの譬を語り終えてから、そこを立ち去られた。"},{"ref":"Matt.13.54","start":40013054,"end":40013054,"break":"none","ruby":[[3,2,"きょうり"],[6,1,"い"],[9,2,"かいどう"],[12,2,"ひとびと"],[15,1,"おし"],[24,1,"かれ"],[27,1,"おどろ"],[30,1,"い"],[37,1,"ひと"],[42,2,"ちえ"],[49,1,"ちから"],[60,1,"なら"]],"text":"そして郷里に行き、会堂で人々を教えられたところ、彼らは驚いて言った、「この人は、この知恵とこれらの力あるわざとを、どこで習ってきたのか。"},{"ref":"Matt.13.55","start":40013055,"end":40013055,"break":"none","ruby":[[2,1,"ひと"],[4,2,"だいく"],[7,1,"こ"],[14,1,"はは"],[23,2,"きょうだい"]],"text":"この人は大工の子ではないか。母はマリヤといい、兄弟たちは、ヤコブ、ヨセフ、シモン、ユダではないか。"},{"ref":"Matt.13.56","start":40013056,"end":40013056,"break":"none","ruby":[[4,2,"しまい"],[18,2,"いっしょ"],[32,2,"かずかず"],[47,1,"なら"]],"text":"またその姉妹たちもみな、わたしたちと一緒にいるではないか。こんな数々のことを、いったい、どこで習ってきたのか」。"},{"ref":"Matt.13.57","start":40013057,"end":40013057,"break":"none","ruby":[[4,2,"ひとびと"],[25,1,"い"],[31,3,"よげんしゃ"],[36,2,"じぶん"],[39,2,"きょうり"],[42,2,"じぶん"],[45,1,"いえ"],[46,2,"いがい"],[56,1,"うやま"]],"text":"こうして人々はイエスにつまずいた。しかし、イエスは言われた、「預言者は、自分の郷里や自分の家以外では、どこででも敬われないことはない」。"},{"ref":"Matt.13.58","start":40013058,"end":40013058,"break":"none","ruby":[[3,1,"かれ"],[6,1,"ふ"],[7,2,"しんこう"],[18,1,"ちから"]],"text":"そして彼らの不信仰のゆえに、そこでは力あるわざを、あまりなさらなかった。"}]