[{"ref":"Jer.20.1","start":24020001,"end":24020001,"break":"paragraph","ruby":[[2,2,"さいし"],[9,1,"こ"],[12,1,"しゅ"],[14,1,"みや"],[20,1,"ちょう"],[40,1,"こと"],[42,2,"よげん"],[48,1,"き"]],"text":"さて祭司インメルの子で、主の宮のつかさの長であったパシュルは、エレミヤがこれらの事を預言するのを聞いた。"},{"ref":"Jer.20.2","start":24020002,"end":24020002,"break":"none","ruby":[[8,3,"よげんしゃ"],[16,1,"う"],[19,1,"しゅ"],[21,1,"みや"],[25,1,"うえ"],[33,1,"もん"],[35,1,"あし"]],"text":"そしてパシュルは預言者エレミヤを打ち、主の宮にある上のベニヤミンの門の足かせにつないだ。"},{"ref":"Jer.20.3","start":24020003,"end":24020003,"break":"none","ruby":[[2,2,"よくじつ"],[14,1,"あし"],[19,1,"と"],[21,1,"はな"],[24,1,"とき"],[31,1,"かれ"],[33,1,"い"],[38,1,"しゅ"],[44,1,"な"],[52,1,"よ"],[59,1,"おそ"],[62,2,"しゅうい"],[69,1,"よ"]],"text":"その翌日パシュルがエレミヤを足かせから解き放した時、エレミヤは彼に言った、「主はあなたの名をパシュルとは呼ばないで、『恐れが周囲にある』と呼ばれる。"},{"ref":"Jer.20.4","start":24020004,"end":24020004,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"おお"],[10,1,"み"],[25,2,"じしん"],[36,1,"とも"],[40,1,"おそ"],[43,1,"おこ"],[47,1,"もの"],[52,1,"かれ"],[59,1,"み"],[63,1,"め"],[65,1,"まえ"],[67,1,"てき"],[73,1,"たお"],[90,1,"たみ"],[96,1,"おう"],[98,1,"て"],[100,1,"わた"],[103,1,"かれ"],[105,1,"かれ"],[108,1,"とら"],[116,1,"うつ"],[126,1,"ころ"]],"text":"主はこう仰せられる、見よ、わたしはあなたを、あなた自身とあなたのすべての友だちに恐れを起させる者とする。彼らはあなたが見ている目の前で敵のつるぎに倒れる。わたしはまたユダのすべての民をバビロン王の手に渡す。彼は彼らを捕えてバビロンに移し、つるぎをもって殺す。"},{"ref":"Jer.20.5","start":24020005,"end":24020005,"break":"none","ruby":[[8,1,"まち"],[14,1,"とみ"],[19,1,"え"],[25,1,"もの"],[34,2,"きちょう"],[37,1,"もの"],[43,1,"おう"],[51,2,"ほうもつ"],[56,1,"てき"],[58,1,"て"],[60,1,"わた"],[63,1,"かれ"],[73,1,"たみ"],[75,1,"とら"],[83,1,"うつ"]],"text":"わたしはまたこの町のすべての富と、その獲たすべての物と、そのすべての貴重な物と、ユダの王たちのすべての宝物をその敵の手に渡す。彼らはこれをかすめ、民を捕えてバビロンに移す。"},{"ref":"Jer.20.6","start":24020006,"end":24020006,"break":"none","ruby":[[15,1,"いえ"],[17,1,"す"],[19,1,"もの"],[24,1,"とら"],[26,1,"うつ"],[40,1,"い"],[46,1,"ところ"],[48,1,"し"],[53,1,"ところ"],[55,1,"ほうむ"],[69,1,"いつわ"],[72,2,"よげん"],[76,2,"ことば"],[79,1,"き"],[81,1,"したが"],[84,1,"とも"]],"text":"パシュルよ、あなたと、あなたの家に住む者とはみな捕え移される。あなたはバビロンに行って、その所で死に、その所に葬られる。あなたも、あなたが偽って預言した言葉に聞き従った友もみなそのようになる」。"},{"ref":"Jer.20.7","start":24020007,"end":24020007,"break":"paragraph","breaks":[[18,"line"],[33,"line"],[48,"line"],[63,"line"],[78,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"あざむ"],[24,1,"あざむ"],[27,1,"したが"],[43,1,"つよ"],[52,1,"と"],[54,1,"ふ"],[67,2,"いちにち"],[69,1,"ぢゅう"],[71,2,"ものわら"],[78,1,"ひと"]],"text":"主よ、あなたがわたしを欺かれたので、わたしはその欺きに従いました。あなたはわたしよりも強いので、わたしを説き伏せられたのです。わたしは一日中、物笑いとなり、人はみなわたしをあざけります。"},{"ref":"Jer.20.8","start":24020008,"end":24020008,"break":"line","breaks":[[19,"line"],[34,"line"],[43,"line"]],"ruby":[[8,1,"かた"],[11,1,"よ"],[20,2,"ぼうぎゃく"],[23,2,"めつぼう"],[27,1,"さけ"],[34,1,"しゅ"],[36,2,"ことば"],[39,2,"いちにち"],[41,1,"ぢゅう"],[45,1,"み"]],"text":"それは、わたしが語り、呼ばわるごとに、「暴虐、滅亡」と叫ぶからです。主の言葉が一日中、わが身のはずかしめと、あざけりになるからです。"},{"ref":"Jer.20.9","start":24020009,"end":24020009,"break":"line","breaks":[[22,"line"],[46,"line"],[66,"line"],[86,"line"],[100,"line"]],"ruby":[[8,1,"しゅ"],[14,1,"かさ"],[17,1,"い"],[28,1,"な"],[33,1,"かた"],[35,1,"こと"],[42,1,"い"],[46,1,"しゅ"],[48,2,"ことば"],[55,1,"こころ"],[61,1,"も"],[64,1,"ひ"],[68,1,"ほね"],[73,1,"と"],[89,1,"おさ"],[94,1,"つか"],[100,1,"た"]],"text":"もしわたしが、「主のことは、重ねて言わない、このうえその名によって語る事はしない」と言えば、主の言葉がわたしの心にあって、燃える火のわが骨のうちに閉じこめられているようで、それを押えるのに疲れはてて、耐えることができません。"},{"ref":"Jer.20.10","start":24020010,"end":24020010,"break":"line","breaks":[[18,"line"],[29,"line"],[51,"line"],[59,"line"],[79,"line"],[93,"line"],[109,"line"]],"ruby":[[0,1,"おお"],[3,1,"ひと"],[11,1,"き"],[18,1,"おそ"],[21,2,"しほう"],[30,2,"こくはつ"],[38,1,"かれ"],[40,2,"こくはつ"],[47,1,"い"],[53,1,"した"],[56,1,"とも"],[58,1,"みな"],[83,1,"かれ"],[85,1,"あざむ"],[103,1,"かれ"],[105,1,"か"],[112,1,"かえ"],[122,1,"い"]],"text":"多くの人のささやくのを聞くからです。恐れが四方にあります。「告発せよ。さあ、彼を告発しよう」と言って、わが親しい友は皆わたしのつまずくのを、うかがっています。また、「彼は欺かれるだろう。そのとき、われわれは彼に勝って、あだを返すことができる」と言います。"},{"ref":"Jer.20.11","start":24020011,"end":24020011,"break":"line","breaks":[[13,"line"],[24,"line"],[44,"line"],[60,"line"],[78,"line"],[86,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"つよ"],[7,2,"ゆうし"],[17,1,"とも"],[33,1,"せま"],[37,1,"もの"],[48,1,"う"],[50,1,"か"],[60,1,"かれ"],[66,1,"と"],[78,1,"おお"],[81,1,"はじ"],[88,1,"はじ"],[96,1,"わす"]],"text":"しかし主は強い勇士のようにわたしと共におられる。それゆえ、わたしに迫りくる者はつまずき、わたしに打ち勝つことはできない。彼らは、なし遂げることができなくて、大いに恥をかく。その恥は、いつまでも忘れられることはない。"},{"ref":"Jer.20.12","start":24020012,"end":24020012,"break":"line","breaks":[[8,"line"],[25,"line"],[33,"line"],[50,"line"],[66,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"こころ"],[8,1,"ひと"],[10,1,"こころ"],[12,1,"おも"],[15,1,"み"],[19,2,"ばんぐん"],[22,1,"しゅ"],[29,1,"かれ"],[36,1,"かえ"],[42,1,"み"],[63,1,"うった"],[67,1,"まか"]],"text":"正しき者を試み、人の心と思いを見られる万軍の主よ、あなたが彼らに、あだを返されるのを見せてください。わたしはあなたに、わたしの訴えをお任せしたからです。"},{"ref":"Jer.20.13","start":24020013,"end":24020013,"break":"stanza","breaks":[[18,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"む"],[6,1,"うた"],[9,1,"しゅ"],[18,1,"しゅ"],[20,1,"まず"],[23,1,"もの"],[25,1,"いのち"],[28,2,"あくにん"],[31,1,"て"],[34,1,"すく"]],"text":"主に向かって歌い、主をほめたたえよ。主は貧しい者の命を、悪人の手から救われたからである。"},{"ref":"Jer.20.14","start":24020014,"end":24020014,"break":"stanza","breaks":[[15,"line"]],"ruby":[[4,1,"うま"],[7,1,"ひ"],[15,1,"はは"],[21,1,"う"],[24,1,"ひ"],[26,2,"しゅくふく"],[29,1,"う"]],"text":"わたしの生れた日はのろわれよ。母がわたしを産んだ日は祝福を受けるな。"},{"ref":"Jer.20.15","start":24020015,"end":24020015,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"ちち"],[7,1,"おとこ"],[9,1,"こ"],[12,1,"うま"],[19,1,"つ"],[23,1,"かれ"],[25,1,"おお"],[28,1,"よろこ"],[32,1,"ひと"]],"text":"わたしの父に「男の子が、生れました」と告げて、彼を大いに喜ばせた人は、のろわれよ。"},{"ref":"Jer.20.16","start":24020016,"end":24020016,"break":"line","breaks":[[20,"line"],[33,"line"],[46,"line"]],"ruby":[[2,1,"ひと"],[5,1,"しゅ"],[12,1,"う"],[20,1,"ほろ"],[25,1,"まち"],[33,1,"あさ"],[37,1,"かれ"],[39,1,"さけ"],[42,1,"き"],[46,1,"ひる"],[49,1,"たたか"],[52,1,"こえ"],[54,1,"き"]],"text":"その人は、主のあわれみを受けることなく、滅ぼされた町のようになれ。朝には、彼に叫びを聞かせ、昼には戦いの声を聞かせよ。"},{"ref":"Jer.20.17","start":24020017,"end":24020017,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[6,2,"たいない"],[9,1,"ころ"],[15,1,"はは"],[21,2,"はかば"],[30,1,"たい"],[37,1,"おお"]],"text":"彼がわたしを胎内で殺さず、わが母をわたしの墓場となさず、その胎をいつまでも大きくしなかったからである。"},{"ref":"Jer.20.18","start":24020018,"end":24020018,"break":"line","breaks":[[17,"line"]],"ruby":[[9,2,"たいない"],[12,1,"で"],[17,1,"なや"],[20,1,"かな"],[24,1,"あ"],[27,1,"はじ"],[29,1,"う"],[32,2,"いっしょう"],[35,1,"す"]],"text":"なにゆえにわたしは胎内を出てきて、悩みと悲しみに会い、恥を受けて一生を過ごすのか。"}]