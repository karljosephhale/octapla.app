[{"ref":"Ezek.2.1","start":26002001,"end":26002001,"break":"paragraph","ruby":[[0,1,"かれ"],[6,1,"い"],[12,1,"ひと"],[14,1,"こ"],[17,1,"た"],[31,1,"かた"]],"text":"彼はわたしに言われた、「人の子よ、立ちあがれ、わたしはあなたに語ろう」。"},{"ref":"Ezek.2.2","start":26002002,"end":26002002,"break":"none","ruby":[[3,1,"かれ"],[9,1,"かた"],[13,1,"とき"],[15,1,"れい"],[24,1,"い"],[31,1,"た"],[42,1,"かれ"],[48,1,"かた"],[54,1,"き"]],"text":"そして彼がわたしに語られた時、霊がわたしのうちに入り、わたしを立ちあがらせた。そして彼のわたしに語られるのを聞いた。"},{"ref":"Ezek.2.3","start":26002003,"end":26002003,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[12,1,"ひと"],[14,1,"こ"],[31,1,"たみ"],[45,2,"はんぎゃく"],[48,1,"たみ"],[55,1,"かれ"],[60,2,"せんぞ"],[72,2,"こんにち"],[75,1,"およ"]],"text":"彼はわたしに言われた、「人の子よ、わたしはあなたをイスラエルの民、すなわちわたしにそむいた反逆の民につかわす。彼らもその先祖も、わたしにそむいて今日に及んでいる。"},{"ref":"Ezek.2.4","start":26002004,"end":26002004,"break":"none","ruby":[[0,1,"かれ"],[3,2,"こうがん"],[6,2,"ごうじょう"],[9,1,"もの"],[24,1,"かれ"],[36,1,"かれ"],[40,1,"しゅ"],[43,1,"かみ"],[47,1,"い"],[53,1,"い"]],"text":"彼らは厚顔で強情な者たちである。わたしはあなたを彼らにつかわす。あなたは彼らに『主なる神はこう言われる』と言いなさい。"},{"ref":"Ezek.2.5","start":26002005,"end":26002005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"き"],[8,1,"こば"],[14,1,"かれ"],[17,2,"はんぎゃく"],[20,1,"いえ"],[25,1,"かれ"],[28,1,"なか"],[30,3,"よげんしゃ"],[39,1,"し"]],"text":"彼らは聞いても、拒んでも、（彼らは反逆の家だから）彼らの中に預言者がいたことを知るだろう。"},{"ref":"Ezek.2.6","start":26002006,"end":26002006,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[5,1,"かれ"],[8,1,"おそ"],[17,1,"かれ"],[20,2,"ことば"],[24,1,"おそ"],[48,2,"いっしょ"],[67,1,"なか"],[69,1,"す"],[74,1,"かれ"],[77,2,"ことば"],[80,1,"おそ"],[89,1,"かれ"],[92,1,"かお"],[105,1,"かれ"],[108,2,"はんぎゃく"],[111,1,"いえ"]],"text":"人の子よ、彼らを恐れてはならない。彼らの言葉をも恐れてはならない。たといあざみといばらがあなたと一緒にあっても、またあなたが、さそりの中に住んでも、彼らの言葉を恐れてはならない。彼らの顔をはばかってはならない。彼らは反逆の家である。"},{"ref":"Ezek.2.7","start":26002007,"end":26002007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"き"],[8,1,"こば"],[23,2,"ことば"],[26,1,"かれ"],[29,1,"かた"],[40,1,"かれ"],[43,2,"はんぎゃく"],[46,1,"いえ"]],"text":"彼らが聞いても、拒んでも、あなたはただわたしの言葉を彼らに語らなければならない。彼らは反逆の家だから。"},{"ref":"Ezek.2.8","start":26002008,"end":26002008,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[13,1,"かた"],[19,1,"き"],[25,2,"はんぎゃく"],[28,1,"いえ"],[47,1,"くち"],[49,1,"ひら"],[57,1,"あた"],[63,1,"た"]],"text":"人の子よ、わたしがあなたに語るところを聞きなさい。反逆の家のようにそむいてはならない。あなたの口を開いて、わたしが与えるものを食べなさい」。"},{"ref":"Ezek.2.9","start":26002009,"end":26002009,"break":"none","ruby":[[2,1,"とき"],[7,1,"み"],[11,1,"み"],[18,1,"ほう"],[20,1,"の"],[23,1,"て"],[31,1,"み"],[34,1,"て"],[36,1,"なか"],[38,2,"まきもの"]],"text":"この時わたしが見ると、見よ、わたしの方に伸べた手があった。また見よ、手の中に巻物があった。"},{"ref":"Ezek.2.10","start":26002010,"end":26002010,"break":"none","ruby":[[0,1,"かれ"],[6,1,"まえ"],[11,1,"ひら"],[17,1,"おもて"],[20,1,"うら"],[23,2,"もじ"],[26,1,"か"],[35,1,"か"],[44,1,"かな"],[49,1,"なげ"],[53,1,"わざわい"],[55,2,"ことば"]],"text":"彼がわたしの前にこれを開くと、その表にも裏にも文字が書いてあった。その書かれていることは悲しみと、嘆きと、災の言葉であった。"}]