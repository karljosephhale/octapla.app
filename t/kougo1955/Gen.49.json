[{"ref":"Gen.49.1","start":1049001,"end":1049001,"break":"paragraph","ruby":[[6,1,"こ"],[9,1,"よ"],[12,1,"い"],[17,1,"あつ"],[24,1,"のち"],[26,1,"ひ"],[35,1,"うえ"],[37,1,"おこ"],[43,1,"つ"]],"text":"ヤコブはその子らを呼んで言った、「集まりなさい。後の日に、あなたがたの上に起ることを、告げましょう、"},{"ref":"Gen.49.2","start":1049002,"end":1049002,"break":"stanza","breaks":[[15,"line"]],"ruby":[[4,1,"こ"],[8,1,"あつ"],[12,1,"き"],[15,1,"ちち"],[26,1,"き"]],"text":"ヤコブの子らよ、集まって聞け。父イスラエルのことばを聞け。"},{"ref":"Gen.49.3","start":1049003,"end":1049003,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[11,2,"ちょうし"],[16,1,"いきお"],[21,1,"ちから"],[27,2,"いこう"],[34,1,"もの"],[36,2,"けんりょく"],[43,1,"もの"]],"text":"ルベンよ、あなたはわが長子、わが勢い、わが力のはじめ、威光のすぐれた者、権力のすぐれた者。"},{"ref":"Gen.49.4","start":1049004,"end":1049004,"break":"line","breaks":[[16,"line"],[33,"line"],[48,"line"]],"ruby":[[4,1,"わ"],[6,1,"た"],[8,1,"みず"],[24,1,"もの"],[29,1,"え"],[37,1,"ちち"],[39,1,"ゆか"],[41,1,"のぼ"],[44,1,"けが"],[57,2,"ねどこ"],[60,1,"のぼ"]],"text":"しかし、沸き立つ水のようだから、もはや、すぐれた者ではあり得ない。あなたは父の床に上って汚した。ああ、あなたはわが寝床に上った。"},{"ref":"Gen.49.5","start":1049005,"end":1049005,"break":"line","breaks":[[12,"line"]],"ruby":[[9,2,"きょうだい"],[12,1,"かれ"],[19,2,"ぼうぎゃく"],[22,2,"ぶき"]],"text":"シメオンとレビとは兄弟。彼らのつるぎは暴虐の武器。"},{"ref":"Gen.49.6","start":1049006,"end":1049006,"break":"line","breaks":[[15,"line"],[33,"line"],[47,"line"]],"ruby":[[2,1,"たましい"],[5,1,"かれ"],[8,2,"かいぎ"],[11,1,"のぞ"],[17,1,"さか"],[21,1,"かれ"],[28,1,"つら"],[33,1,"かれ"],[36,1,"いか"],[39,1,"まか"],[42,1,"ひと"],[44,1,"ころ"],[53,2,"おうし"],[56,1,"あし"],[58,1,"すじ"],[60,1,"き"]],"text":"わが魂よ、彼らの会議に臨むな。わが栄えよ、彼らのつどいに連なるな。彼らは怒りに任せて人を殺し、ほしいままに雄牛の足の筋を切った。"},{"ref":"Gen.49.7","start":1049007,"end":1049007,"break":"line","breaks":[[18,"line"],[40,"line"],[57,"line"]],"ruby":[[0,1,"かれ"],[3,1,"いか"],[7,1,"はげ"],[18,1,"かれ"],[21,1,"いきどお"],[44,1,"かれ"],[54,1,"わ"],[66,1,"ち"]],"text":"彼らの怒りは、激しいゆえにのろわれ、彼らの憤りは、はなはだしいゆえにのろわれる。わたしは彼らをヤコブのうちに分け、イスラエルのうちに散らそう。"},{"ref":"Gen.49.8","start":1049008,"end":1049008,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[4,2,"きょうだい"],[21,1,"て"],[23,1,"てき"],[28,1,"おさ"],[31,1,"ちち"],[33,1,"こ"],[40,1,"まえ"],[42,1,"み"]],"text":"ユダよ、兄弟たちはあなたをほめる。あなたの手は敵のくびを押え、父の子らはあなたの前に身をかがめるであろう。"},{"ref":"Gen.49.9","start":1049009,"end":1049009,"break":"line","breaks":[[9,"line"],[30,"line"],[45,"line"],[58,"line"]],"ruby":[[7,1,"こ"],[11,1,"こ"],[18,2,"えもの"],[24,1,"のぼ"],[27,1,"く"],[30,1,"かれ"],[32,1,"お"],[45,1,"め"],[52,1,"み"],[54,1,"ふ"],[64,1,"おこ"]],"text":"ユダは、ししの子。わが子よ、あなたは獲物をもって上って来る。彼は雄じしのようにうずくまり、雌じしのように身を伏せる。だれがこれを起すことができよう。"},{"ref":"Gen.49.10","start":1049010,"end":1049010,"break":"line","breaks":[[10,"line"],[31,"line"],[47,"line"]],"ruby":[[6,1,"はな"],[10,2,"りっぽう"],[12,1,"しゃ"],[19,1,"あし"],[21,1,"あいだ"],[23,1,"はな"],[34,1,"く"],[36,1,"とき"],[40,1,"およ"],[52,1,"たみ"],[54,1,"かれ"],[56,1,"したが"]],"text":"つえはユダを離れず、立法者のつえはその足の間を離れることなく、シロの来る時までに及ぶであろう。もろもろの民は彼に従う。"},{"ref":"Gen.49.11","start":1049011,"end":1049011,"break":"line","breaks":[[19,"line"],[39,"line"],[54,"line"]],"ruby":[[0,1,"かれ"],[7,1,"こ"],[13,1,"き"],[21,1,"め"],[25,1,"こ"],[27,1,"よ"],[33,1,"き"],[39,1,"かれ"],[43,2,"いふく"],[49,1,"しゅ"],[51,1,"あら"],[56,2,"きもの"],[63,1,"しる"],[65,1,"あら"]],"text":"彼はそのろばの子をぶどうの木につなぎ、その雌ろばの子を良きぶどうの木につなぐ。彼はその衣服をぶどう酒で洗い、その着物をぶどうの汁で洗うであろう。"},{"ref":"Gen.49.12","start":1049012,"end":1049012,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"め"],[7,1,"しゅ"],[12,1,"あか"],[17,1,"は"],[19,1,"ちち"],[24,1,"しろ"]],"text":"その目はぶどう酒によって赤く、その歯は乳によって白い。"},{"ref":"Gen.49.13","start":1049013,"end":1049013,"break":"line","breaks":[[11,"line"],[22,"line"]],"ruby":[[5,1,"うみ"],[8,1,"す"],[11,1,"ふね"],[13,1,"と"],[16,1,"みなと"],[24,1,"さかい"],[30,1,"およ"]],"text":"ゼブルンは海べに住み、舟の泊まる港となって、その境はシドンに及ぶであろう。"},{"ref":"Gen.49.14","start":1049014,"end":1049014,"break":"line","breaks":[[14,"line"]],"ruby":[[14,1,"かれ"],[16,1,"ひつじ"],[21,1,"あいだ"],[23,1,"ふ"]],"text":"イッサカルはたくましいろば、彼は羊のおりの間に伏している。"},{"ref":"Gen.49.15","start":1049015,"end":1049015,"break":"line","breaks":[[14,"line"],[26,"line"],[39,"line"]],"ruby":[[0,1,"かれ"],[2,2,"ていじゅう"],[5,1,"ち"],[7,1,"み"],[9,1,"よ"],[16,1,"くに"],[18,1,"み"],[20,1,"たの"],[26,1,"かれ"],[30,1,"かた"],[32,1,"さ"],[39,2,"どれい"],[45,1,"お"],[47,1,"つか"]],"text":"彼は定住の地を見て良しとし、その国を見て楽しとした。彼はその肩を下げてにない、奴隷となって追い使われる。"},{"ref":"Gen.49.16","start":1049016,"end":1049016,"break":"line","breaks":[[17,"line"]],"ruby":[[7,1,"たみ"],[26,2,"ぶぞく"]],"text":"ダンはおのれの民をさばくであろう、イスラエルのほかの部族のように。"},{"ref":"Gen.49.17","start":1049017,"end":1049017,"break":"line","breaks":[[13,"line"],[23,"line"],[33,"line"]],"ruby":[[3,1,"みち"],[13,1,"みち"],[23,1,"うま"],[33,1,"の"],[35,1,"もの"],[41,1,"おと"]],"text":"ダンは道のかたわらのへび、道のほとりのまむし。馬のかかとをかんで、乗る者をうしろに落すであろう。"},{"ref":"Gen.49.18","start":1049018,"end":1049018,"break":"line","ruby":[[0,1,"しゅ"],[11,1,"すくい"],[13,1,"ま"],[15,1,"のぞ"]],"text":"主よ、わたしはあなたの救を待ち望む。"},{"ref":"Gen.49.19","start":1049019,"end":1049019,"break":"line","breaks":[[11,"line"]],"ruby":[[4,3,"りゃくだつしゃ"],[8,1,"せま"],[14,1,"かれ"],[20,1,"てき"],[26,1,"せま"]],"text":"ガドには略奪者が迫る。しかし彼はかえって敵のかかとに迫るであろう。"},{"ref":"Gen.49.20","start":1049020,"end":1049020,"break":"line","breaks":[[14,"line"]],"ruby":[[6,2,"しょくもつ"],[14,1,"おう"],[16,2,"びみ"]],"text":"アセルはその食物がゆたかで、王の美味をいだすであろう。"},{"ref":"Gen.49.21","start":1049021,"end":1049021,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"はな"],[9,1,"め"],[13,1,"かれ"],[15,1,"うつく"],[18,1,"こ"],[22,1,"う"]],"text":"ナフタリは放たれた雌じか、彼は美しい子じかを生むであろう。"},{"ref":"Gen.49.22","start":1049022,"end":1049022,"break":"line","breaks":[[11,"line"],[24,"line"]],"ruby":[[4,1,"み"],[6,1,"むす"],[8,2,"わかぎ"],[11,1,"いずみ"],[17,1,"み"],[19,1,"むす"],[21,2,"わかぎ"],[26,1,"えだ"],[33,1,"こ"]],"text":"ヨセフは実を結ぶ若木、泉のほとりの実を結ぶ若木。その枝は、かきねを越えるであろう。"},{"ref":"Gen.49.23","start":1049023,"end":1049023,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"い"],[2,1,"もの"],[4,1,"かれ"],[6,1,"はげ"],[9,1,"せ"],[12,1,"かれ"],[14,1,"い"],[16,1,"かれ"],[21,1,"なや"]],"text":"射る者は彼を激しく攻め、彼を射、彼をいたく悩ました。"},{"ref":"Gen.49.24","start":1049024,"end":1049024,"break":"line","breaks":[[12,"line"],[20,"line"],[36,"line"]],"ruby":[[3,1,"かれ"],[5,1,"ゆみ"],[9,1,"つよ"],[12,1,"かれ"],[14,1,"うで"],[16,2,"すばや"],[27,3,"ぜんのうしゃ"],[31,1,"て"],[42,1,"いわ"],[45,2,"ぼくしゃ"],[48,1,"な"]],"text":"しかし彼の弓はなお強く、彼の腕は素早い。これはヤコブの全能者の手により、イスラエルの岩なる牧者の名により、"},{"ref":"Gen.49.25","start":1049025,"end":1049025,"break":"line","breaks":[[14,"line"],[24,"line"],[35,"line"],[48,"line"]],"ruby":[[4,1,"たす"],[7,1,"ちち"],[9,1,"かみ"],[16,1,"うえ"],[19,1,"てん"],[21,2,"しゅくふく"],[24,1,"した"],[26,1,"よこ"],[30,1,"ふち"],[32,2,"しゅくふく"],[35,1,"ち"],[39,1,"たい"],[41,2,"しゅくふく"],[52,1,"めぐ"],[56,3,"ぜんのうしゃ"]],"text":"あなたを助ける父の神により、また上なる天の祝福、下に横たわる淵の祝福、乳ぶさと胎の祝福をもって、あなたを恵まれる全能者による。"},{"ref":"Gen.49.26","start":1049026,"end":1049026,"break":"line","breaks":[[21,"line"],[33,"line"],[51,"line"]],"ruby":[[4,1,"ちち"],[6,2,"しゅくふく"],[9,2,"えいえん"],[12,1,"やま"],[14,2,"しゅくふく"],[21,2,"えいきゅう"],[24,1,"おか"],[26,2,"たまもの"],[37,2,"しゅくふく"],[48,1,"き"],[53,2,"きょうだい"],[58,1,"きみ"],[61,1,"もの"],[63,1,"あたま"],[65,1,"いただき"],[67,1,"き"]],"text":"あなたの父の祝福は永遠の山の祝福にまさり、永久の丘の賜物にまさる。これらの祝福はヨセフのかしらに帰し、その兄弟たちの君たる者の頭の頂に帰する。"},{"ref":"Gen.49.27","start":1049027,"end":1049027,"break":"line","breaks":[[15,"line"],[26,"line"]],"ruby":[[8,1,"さ"],[15,1,"あさ"],[19,2,"えもの"],[22,1,"く"],[26,1,"ゆう"],[30,1,"ぶん"],[31,2,"とりもの"],[34,1,"わ"]],"text":"ベニヤミンはかき裂くおおかみ、朝にその獲物を食らい、夕にその分捕物を分けるであろう」。"},{"ref":"Gen.49.28","start":1049028,"end":1049028,"break":"paragraph","ruby":[[16,2,"ぶぞく"],[28,1,"かれ"],[31,1,"ちち"],[33,1,"かれ"],[36,1,"かた"],[39,1,"かれ"],[42,2,"しゅくふく"],[50,1,"かれ"],[52,2,"しゅくふく"],[61,1,"したが"],[65,1,"かれ"],[72,2,"しゅくふく"]],"text":"すべてこれらはイスラエルの十二の部族である。そしてこれは彼らの父が彼らに語り、彼らを祝福したもので、彼は祝福すべきところに従って、彼らおのおのを祝福した。"},{"ref":"Gen.49.29","start":1049029,"end":1049029,"break":"none","ruby":[[0,1,"かれ"],[4,1,"かれ"],[7,1,"めい"],[10,1,"い"],[21,1,"たみ"],[23,1,"くわ"],[50,1,"はたけ"],[56,1,"あな"],[63,2,"せんぞ"],[68,1,"とも"],[74,1,"ほうむ"]],"text":"彼はまた彼らに命じて言った、「わたしはわが民に加えられようとしている。あなたがたはヘテびとエフロンの畑にあるほら穴に、わたしの先祖たちと共にわたしを葬ってください。"},{"ref":"Gen.49.30","start":1049030,"end":1049030,"break":"none","ruby":[[4,1,"あな"],[10,1,"ち"],[16,1,"ひがし"],[25,1,"はたけ"],[46,1,"はたけ"],[48,1,"とも"],[50,1,"か"],[52,1,"と"],[55,2,"しょゆう"],[58,2,"ぼち"]],"text":"そのほら穴はカナンの地のマムレの東にあるマクペラの畑にあり、アブラハムがヘテびとエフロンから畑と共に買い取り、所有の墓地としたもので、"},{"ref":"Gen.49.31","start":1049031,"end":1049031,"break":"none","ruby":[[9,1,"つま"],[14,1,"ほうむ"],[22,1,"つま"],[30,1,"ほうむ"],[48,1,"ほうむ"]],"text":"そこにアブラハムと妻サラとが葬られ、イサクと妻リベカもそこに葬られたが、わたしはまたそこにレアを葬った。"},{"ref":"Gen.49.32","start":1049032,"end":1049032,"break":"none","ruby":[[2,1,"はたけ"],[6,1,"なか"],[12,1,"あな"],[18,2,"ひとびと"],[22,1,"か"]],"text":"あの畑とその中にあるほら穴とはヘテの人々から買ったものです」。"},{"ref":"Gen.49.33","start":1049033,"end":1049033,"break":"none","ruby":[[8,1,"こ"],[11,1,"めい"],[13,1,"おわ"],[17,1,"あし"],[19,1,"ゆか"],[25,1,"いき"],[26,1,"た"],[32,1,"たみ"],[34,1,"くわ"]],"text":"こうしてヤコブは子らに命じ終って、足を床におさめ、息絶えて、その民に加えられた。"}]