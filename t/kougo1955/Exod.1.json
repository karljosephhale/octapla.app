[{"ref":"Exod.1.1","start":2001001,"end":2001001,"break":"paragraph","ruby":[[7,1,"とも"],[16,2,"かぞく"],[19,1,"ともな"],[28,1,"い"],[37,1,"こ"],[40,1,"な"],[42,1,"つぎ"]],"text":"さて、ヤコブと共に、おのおのその家族を伴って、エジプトへ行ったイスラエルの子らの名は次のとおりである。"},{"ref":"Exod.1.2","start":2001002,"end":2001002,"break":"none","text":"すなわちルベン、シメオン、レビ、ユダ、"},{"ref":"Exod.1.3","start":2001003,"end":2001003,"break":"none","text":"イッサカル、ゼブルン、ベニヤミン、"},{"ref":"Exod.1.4","start":2001004,"end":2001004,"break":"none","text":"ダン、ナフタリ、ガド、アセルであった。"},{"ref":"Exod.1.5","start":2001005,"end":2001005,"break":"none","ruby":[[4,1,"こし"],[7,1,"で"],[13,1,"あ"],[19,1,"にん"]],"text":"ヤコブの腰から出たものは、合わせて七十人。ヨセフはすでにエジプトにいた。"},{"ref":"Exod.1.6","start":2001006,"end":2001006,"break":"none","ruby":[[8,1,"し"],[11,2,"きょうだい"],[19,2,"じだい"],[22,2,"ひとびと"],[27,1,"し"]],"text":"そして、ヨセフは死に、兄弟たちも、その時代の人々もみな死んだ。"},{"ref":"Exod.1.7","start":2001007,"end":2001007,"break":"none","ruby":[[10,2,"しそん"],[13,1,"おお"],[16,1,"こ"],[18,1,"う"],[32,1,"つよ"],[38,1,"くに"],[40,1,"み"]],"text":"けれどもイスラエルの子孫は多くの子を生み、ますますふえ、はなはだ強くなって、国に満ちるようになった。"},{"ref":"Exod.1.8","start":2001008,"end":2001008,"break":"paragraph","ruby":[[11,1,"し"],[15,1,"あたら"],[18,1,"おう"],[26,1,"た"]],"text":"ここに、ヨセフのことを知らない新しい王が、エジプトに起った。"},{"ref":"Exod.1.9","start":2001009,"end":2001009,"break":"none","ruby":[[0,1,"かれ"],[4,1,"たみ"],[6,1,"い"],[11,1,"み"],[25,1,"たみ"],[42,1,"おお"],[47,1,"つよ"]],"text":"彼はその民に言った、「見よ、イスラエルびとなるこの民は、われわれにとって、あまりにも多く、また強すぎる。"},{"ref":"Exod.1.10","start":2001010,"end":2001010,"break":"none","ruby":[[9,1,"ぬ"],[14,1,"かれ"],[17,1,"と"],[19,1,"あつか"],[23,1,"かれ"],[26,1,"おお"],[31,1,"たたか"],[34,1,"おこ"],[39,1,"てき"],[41,2,"みかた"],[51,1,"たたか"],[59,1,"くに"],[62,1,"に"],[64,1,"さ"]],"text":"さあ、われわれは、抜かりなく彼らを取り扱おう。彼らが多くなり、戦いの起るとき、敵に味方して、われわれと戦い、ついにこの国から逃げ去ることのないようにしよう」。"},{"ref":"Exod.1.11","start":2001011,"end":2001011,"break":"none","ruby":[[10,1,"かれ"],[13,1,"うえ"],[15,2,"かんとく"],[21,1,"おも"],[23,2,"ろうえき"],[29,1,"かれ"],[32,1,"くる"],[37,1,"かれ"],[46,2,"そうこ"],[49,1,"まち"],[59,1,"た"]],"text":"そこでエジプトびとは彼らの上に監督をおき、重い労役をもって彼らを苦しめた。彼らはパロのために倉庫の町ピトムとラメセスを建てた。"},{"ref":"Exod.1.12","start":2001012,"end":2001012,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"くる"],[38,1,"かれ"],[47,2,"ひとびと"],[53,1,"おそ"]],"text":"しかしイスラエルの人々が苦しめられるにしたがって、いよいよふえひろがるので、彼らはイスラエルの人々のゆえに恐れをなした。"},{"ref":"Exod.1.13","start":2001013,"end":2001013,"break":"none","ruby":[[13,2,"ひとびと"],[20,1,"つか"]],"text":"エジプトびとはイスラエルの人々をきびしく使い、"},{"ref":"Exod.1.14","start":2001014,"end":2001014,"break":"none","ruby":[[3,1,"つとめ"],[10,2,"せいかつ"],[13,1,"くる"],[33,1,"つく"],[39,2,"たはた"],[46,1,"つとめ"],[48,1,"あた"],[60,2,"ろうえき"]],"text":"つらい務をもってその生活を苦しめた。すなわち、しっくいこね、れんが作り、および田畑のあらゆる務に当らせたが、そのすべての労役はきびしかった。"},{"ref":"Exod.1.15","start":2001015,"end":2001015,"break":"paragraph","ruby":[[7,1,"おう"],[14,1,"おんな"],[19,2,"とりあ"],[25,3,"じょさんぷ"],[33,1,"な"],[42,1,"た"],[48,1,"な"],[55,1,"もの"]],"text":"またエジプトの王は、ヘブルの女のために取上げをする助産婦でひとりは名をシフラといい、他のひとりは名をプアという者にさとして、"},{"ref":"Exod.1.16","start":2001016,"end":2001016,"break":"none","ruby":[[0,1,"い"],[9,1,"おんな"],[14,2,"じょさん"],[22,1,"う"],[24,1,"だい"],[26,1,"うえ"],[28,1,"み"],[33,1,"おとこ"],[35,1,"こ"],[42,1,"ころ"],[45,1,"おんな"],[47,1,"こ"],[51,1,"い"]],"text":"言った、「ヘブルの女のために助産をするとき、産み台の上を見て、もし男の子ならばそれを殺し、女の子ならば生かしておきなさい」。"},{"ref":"Exod.1.17","start":2001017,"end":2001017,"break":"none","ruby":[[3,3,"じょさんぷ"],[9,1,"かみ"],[20,1,"おう"],[22,1,"かれ"],[25,1,"めい"],[35,1,"おとこ"],[37,1,"こ"],[39,1,"い"]],"text":"しかし助産婦たちは神をおそれ、エジプトの王が彼らに命じたようにはせず、男の子を生かしておいた。"},{"ref":"Exod.1.18","start":2001018,"end":2001018,"break":"none","ruby":[[5,1,"おう"],[7,3,"じょさんぷ"],[13,1,"め"],[16,1,"い"],[40,1,"おとこ"],[42,1,"こ"],[44,1,"い"]],"text":"エジプトの王は助産婦たちを召して言った、「あなたがたはなぜこのようなことをして、男の子を生かしておいたのか」。"},{"ref":"Exod.1.19","start":2001019,"end":2001019,"break":"none","ruby":[[0,3,"じょさんぷ"],[9,1,"い"],[18,1,"おんな"],[25,1,"おんな"],[28,1,"ちが"],[31,2,"かのじょ"],[36,1,"すこ"],[40,3,"じょさんぷ"],[44,1,"い"],[46,1,"まえ"],[48,1,"う"]],"text":"助産婦たちはパロに言った、「ヘブルの女はエジプトの女とは違い、彼女たちは健やかで助産婦が行く前に産んでしまいます」。"},{"ref":"Exod.1.20","start":2001020,"end":2001020,"break":"none","ruby":[[3,1,"かみ"],[5,3,"じょさんぷ"],[11,1,"めぐ"],[24,1,"たみ"],[29,2,"ひじょう"],[32,1,"つよ"]],"text":"それで神は助産婦たちに恵みをほどこされた。そして民はふえ、非常に強くなった。"},{"ref":"Exod.1.21","start":2001021,"end":2001021,"break":"none","ruby":[[0,3,"じょさんぷ"],[6,1,"かみ"],[15,1,"かみ"],[17,2,"かのじょ"],[22,1,"いえ"],[24,1,"さか"]],"text":"助産婦たちは神をおそれたので、神は彼女たちの家を栄えさせられた。"},{"ref":"Exod.1.22","start":2001022,"end":2001022,"break":"none","ruby":[[12,1,"たみ"],[14,1,"めい"],[17,1,"い"],[28,1,"おとこ"],[30,1,"こ"],[32,1,"うま"],[44,1,"かわ"],[46,1,"な"],[54,1,"おんな"],[56,1,"こ"],[60,1,"い"]],"text":"そこでパロはそのすべての民に命じて言った、「ヘブルびとに男の子が生れたならば、みなナイル川に投げこめ。しかし女の子はみな生かしておけ」。"}]