[{"ref":"Isa.22.1","start":23022001,"end":23022001,"break":"paragraph","breaks":[[11,"stanza"]],"ruby":[[0,1,"まぼろし"],[2,1,"たに"],[8,2,"たくせん"],[22,2,"やね"]],"text":"幻の谷についての託宣。あなたがたはなぜ、みな屋根にのぼったのか。"},{"ref":"Isa.22.2","start":23022002,"end":23022002,"break":"line","breaks":[[11,"line"],[28,"line"],[41,"line"],[55,"line"]],"ruby":[[0,1,"さけ"],[2,1,"ごえ"],[4,1,"み"],[9,1,"もの"],[11,1,"さわ"],[15,1,"みやこ"],[17,1,"よろこ"],[20,1,"よ"],[25,1,"まち"],[35,1,"ころ"],[39,1,"もの"],[45,1,"ころ"],[57,1,"たたか"],[60,1,"たお"]],"text":"叫び声で満ちている者、騒がしい都、喜びに酔っている町よ。あなたのうちの殺された者はつるぎで殺されたのではなく、また戦いに倒れたのでもない。"},{"ref":"Isa.22.3","start":23022003,"end":23022003,"break":"line","breaks":[[22,"line"],[33,"line"],[46,"line"]],"ruby":[[10,1,"みな"],[11,1,"とも"],[17,1,"い"],[22,1,"ゆみ"],[24,1,"す"],[27,1,"とら"],[33,1,"かれ"],[36,1,"とお"],[38,1,"に"],[41,1,"い"],[53,1,"み"],[58,1,"もの"],[62,1,"とら"]],"text":"あなたのつかさたちは皆共にのがれて行ったが、弓を捨てて捕えられた。彼らは遠く逃げて行ったが、あなたのうちの見つかった者はみな捕えられた。"},{"ref":"Isa.22.4","start":23022004,"end":23022004,"break":"line","breaks":[[13,"line"],[26,"line"],[39,"line"],[52,"line"]],"ruby":[[9,1,"い"],[18,1,"かえり"],[33,1,"な"],[35,1,"かな"],[41,1,"たみ"],[43,1,"むすめ"],[45,1,"ほろ"],[56,1,"なぐさ"],[61,1,"つと"]],"text":"それゆえ、わたしは言った、「わたしを顧みてくれるな、わたしはいたく泣き悲しむ。わが民の娘の滅びのために、わたしを慰めようと努めてはならない」。"},{"ref":"Isa.22.5","start":23022005,"end":23022005,"break":"paragraph","breaks":[[11,"line"],[34,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[5,1,"しゅ"],[7,1,"まぼろし"],[9,1,"たに"],[11,1,"さわ"],[15,1,"ふ"],[22,2,"こんらん"],[25,1,"ひ"],[34,2,"じょうへき"],[40,1,"お"],[43,1,"さけ"],[45,1,"ごえ"],[47,1,"やま"],[49,1,"きこ"]],"text":"万軍の神、主は幻の谷に騒ぎと、踏みにじりと、混乱の日をこさせられる。城壁はくずれ落ち、叫び声は山に聞える。"},{"ref":"Isa.22.6","start":23022006,"end":23022006,"break":"line","breaks":[[9,"line"],[23,"line"]],"ruby":[[4,1,"えびら"],[6,1,"お"],[9,2,"せんしゃ"],[12,2,"きへい"],[26,1,"たて"]],"text":"エラムは箙を負い、戦車と騎兵とをもってきたり、キルは盾をあらわした。"},{"ref":"Isa.22.7","start":23022007,"end":23022007,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"もっと"],[6,1,"うつく"],[9,1,"たに"],[11,2,"せんしゃ"],[14,1,"み"],[17,2,"きへい"],[25,1,"もん"],[31,1,"た"]],"text":"あなたの最も美しい谷は戦車で満ち、騎兵はもろもろの門にむかって立った。"},{"ref":"Isa.22.8","start":23022008,"end":23022008,"break":"line","breaks":[[16,"paragraph"]],"ruby":[[3,1,"まも"],[9,1,"と"],[11,1,"のぞ"],[18,1,"ひ"],[23,1,"はやし"],[25,1,"いえ"],[27,2,"ぶぐ"],[30,1,"あお"],[32,1,"のぞ"]],"text":"ユダを守るおおいは取り除かれた。その日あなたは林の家の武具を仰ぎ望んだ。"},{"ref":"Isa.22.9","start":23022009,"end":23022009,"break":"none","ruby":[[12,1,"まち"],[14,1,"やぶ"],[17,1,"おお"],[21,1,"み"],[23,1,"した"],[25,1,"いけ"],[27,1,"みず"],[29,1,"あつ"]],"text":"またあなたがたはダビデの町の破れの多いのを見、下の池の水を集め、"},{"ref":"Isa.22.10","start":23022010,"end":23022010,"break":"none","ruby":[[6,1,"いえ"],[8,1,"かぞ"],[15,1,"いえ"],[21,2,"じょうへき"],[24,1,"きず"]],"text":"エルサレムの家を数え、またその家をこわして城壁を築き、"},{"ref":"Isa.22.11","start":23022011,"end":23022011,"break":"none","ruby":[[3,3,"ちょすいち"],[10,2,"じょうへき"],[13,1,"あいだ"],[15,1,"つく"],[18,2,"ふるいけ"],[21,1,"みず"],[38,1,"こと"],[44,1,"もの"],[46,1,"あお"],[48,1,"のぞ"],[54,1,"こと"],[56,1,"むかし"],[59,2,"けいかく"],[64,1,"もの"],[66,1,"かえり"]],"text":"一つの貯水池を二つの城壁の間に造って古池の水をひいた。しかしあなたがたはこの事をなされた者を仰ぎ望まず、この事を昔から計画された者を顧みなかった。"},{"ref":"Isa.22.12","start":23022012,"end":23022012,"break":"paragraph","breaks":[[11,"line"],[25,"line"]],"ruby":[[2,1,"ひ"],[4,2,"ばんぐん"],[7,1,"かみ"],[9,1,"しゅ"],[11,1,"な"],[13,1,"かな"],[17,1,"あたま"],[25,2,"あらぬの"],[34,1,"めい"]],"text":"その日、万軍の神、主は泣き悲しみ、頭をかぶろにし、荒布をまとうことを命じられたが、"},{"ref":"Isa.22.13","start":23022013,"end":23022013,"break":"line","breaks":[[15,"line"],[26,"line"],[39,"line"],[54,"line"]],"ruby":[[0,1,"み"],[9,1,"よろこ"],[11,1,"たの"],[15,1,"うし"],[21,1,"ひつじ"],[23,1,"ころ"],[26,1,"にく"],[28,1,"く"],[31,1,"さけ"],[33,1,"の"],[36,1,"い"],[45,1,"く"],[50,1,"の"],[54,2,"みょうにち"],[57,1,"し"]],"text":"見よ、あなたがたは喜び楽しみ、牛をほふり、羊を殺し、肉を食い、酒を飲んで言う、「われわれは食い、かつ飲もう、明日は死ぬのだから」。"},{"ref":"Isa.22.14","start":23022014,"end":23022014,"break":"line","breaks":[[20,"line"],[42,"line"],[54,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[13,1,"みみ"],[15,1,"しめ"],[28,2,"ふぎ"],[37,1,"し"],[54,2,"ばんぐん"],[57,1,"かみ"],[59,1,"しゅ"],[61,1,"い"]],"text":"万軍の主はみずからわたしの耳に示された、「まことに、この不義はあなたがたが死ぬまで、ゆるされることはない」と万軍の神、主は言われる。"},{"ref":"Isa.22.15","start":23022015,"end":23022015,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[5,1,"しゅ"],[9,1,"い"],[18,1,"おう"],[20,1,"いえ"],[29,2,"しつじ"],[35,1,"い"],[38,1,"い"]],"text":"万軍の神、主はこう言われる、「さあ、王の家をつかさどるこの執事セブナに行って言いなさい、"},{"ref":"Isa.22.16","start":23022016,"end":23022016,"break":"none","ruby":[[11,1,"かか"],[28,2,"えんこ"],[34,2,"じぶん"],[40,1,"はか"],[42,1,"ほ"],[54,1,"たか"],[56,1,"ところ"],[58,1,"はか"],[60,1,"ほ"],[63,1,"いわ"],[69,2,"じぶん"],[79,1,"つく"]],"text":"『あなたはここになんの係わりがありますか。あなたはだれの縁故でここに自分のために墓を掘ったのですか。あなたは高い所に墓を掘り、岩をうがって自分のためにすみかを造った。"},{"ref":"Isa.22.17","start":23022017,"end":23022017,"break":"none","ruby":[[0,1,"つよ"],[2,1,"ひと"],[5,1,"み"],[8,1,"しゅ"],[14,1,"はげ"],[19,1,"たお"],[24,1,"しゅ"],[30,1,"かた"]],"text":"強い人よ、見よ、主はあなたを激しくなげ倒される。主はあなたを堅くつかまえ、"},{"ref":"Isa.22.18","start":23022018,"end":23022018,"break":"none","ruby":[[15,2,"ひろびろ"],[19,1,"ち"],[21,1,"な"],[27,2,"しゅじん"],[30,1,"いえ"],[32,1,"はじ"],[36,1,"もの"],[46,1,"し"],[53,2,"かれい"],[56,1,"くるま"],[61,1,"のこ"]],"text":"ぐるぐるまわして、まりのように広々した地に投げられる。主人の家の恥となる者よ、あなたはそこで死に、あなたの華麗な車はそこに残る。"},{"ref":"Isa.22.19","start":23022019,"end":23022019,"break":"none","ruby":[[11,1,"しょく"],[14,1,"お"],[19,2,"ちい"],[23,1,"ひ"]],"text":"わたしは、あなたをその職から追い、その地位から引きおろす。"},{"ref":"Isa.22.20","start":23022020,"end":23022020,"break":"none","ruby":[[2,1,"ひ"],[19,1,"こ"],[26,1,"よ"]],"text":"その日、わたしは、わがしもべヒルキヤの子エリアキムを呼んで、"},{"ref":"Isa.22.21","start":23022021,"end":23022021,"break":"none","ruby":[[4,1,"ころも"],[6,1,"き"],[13,1,"おび"],[24,2,"けんりょく"],[27,1,"かれ"],[29,1,"て"],[36,1,"かれ"],[44,1,"たみ"],[49,1,"いえ"],[52,1,"ちち"]],"text":"あなたの衣を着せ、あなたの帯をしめさせ、あなたの権力を彼の手にゆだねる。彼はエルサレムの民とユダの家との父となる。"},{"ref":"Isa.22.22","start":23022022,"end":23022022,"break":"none","ruby":[[10,1,"いえ"],[15,1,"かれ"],[17,1,"かた"],[19,1,"お"],[22,1,"かれ"],[24,1,"ひら"],[27,1,"と"],[30,1,"もの"],[34,1,"かれ"],[36,1,"と"],[40,1,"ひら"],[42,1,"もの"]],"text":"わたしはまたダビデの家のかぎを彼の肩に置く。彼が開けば閉じる者なく、彼が閉じれば開く者はない。"},{"ref":"Isa.22.23","start":23022023,"end":23022023,"break":"none","ruby":[[4,1,"かれ"],[6,1,"かた"],[8,1,"ところ"],[10,1,"う"],[25,1,"かれ"],[29,1,"ちち"],[31,1,"いえ"],[33,1,"ほまれ"],[35,1,"ざ"]],"text":"わたしは彼を堅い所に打ったくぎのようにする。そして彼はその父の家の誉の座となり、"},{"ref":"Isa.22.24","start":23022024,"end":23022024,"break":"none","ruby":[[2,1,"ちち"],[4,1,"いえ"],[10,1,"おも"],[13,1,"かれ"],[15,1,"うえ"],[27,1,"こ"],[31,1,"まご"],[39,1,"ちい"],[42,1,"うつわ"],[44,1,"はち"],[62,1,"かれ"],[64,1,"うえ"]],"text":"その父の家のすべての重さは彼の上にかかる。すなわちその子、その孫およびすべての小さい器、鉢からすべてのびんにいたるまでみな、彼の上にかかる』」。"},{"ref":"Isa.22.25","start":23022025,"end":23022025,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[13,1,"ひ"],[15,1,"かた"],[17,1,"ところ"],[19,1,"う"],[25,1,"ぬ"],[28,1,"き"],[32,1,"お"],[38,1,"うえ"],[46,1,"に"],[50,1,"と"],[52,1,"さ"],[58,1,"しゅ"],[60,1,"かた"]],"text":"万軍の主は言われる、「その日、堅い所に打ったくぎは抜け、切られて落ちる。その上にかかっている荷もまた取り去られる」と主は語られた。"}]