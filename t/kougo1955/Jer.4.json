[{"ref":"Jer.4.1","start":24004001,"end":24004001,"break":"paragraph","breaks":[[15,"line"],[28,"line"],[46,"line"],[59,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[22,1,"かえ"],[35,1,"かえ"],[53,1,"にく"],[57,1,"もの"],[63,1,"まえ"],[66,1,"と"],[68,1,"のぞ"]],"text":"主は言われる、「イスラエルよ、もし、あなたが帰るならば、わたしのもとに帰らなければならない。もし、あなたが憎むべき者をわたしの前から取り除いて、ためらうことなく、"},{"ref":"Jer.4.2","start":24004002,"end":24004002,"break":"line","breaks":[[16,"line"],[34,"line"],[50,"line"]],"ruby":[[2,2,"しんじつ"],[5,2,"せいぎ"],[8,2,"しょうじき"],[17,1,"しゅ"],[19,1,"い"],[28,1,"ちか"],[34,2,"ばんこく"],[37,1,"たみ"],[39,1,"かれ"],[44,2,"しゅくふく"],[47,1,"う"],[50,1,"かれ"],[55,1,"ほこ"]],"text":"また真実と正義と正直とをもって、『主は生きておられる』と誓うならば、万国の民は彼によって祝福を受け、彼によって誇る」。"},{"ref":"Jer.4.3","start":24004003,"end":24004003,"break":"line","breaks":[[19,"line"],[26,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[5,2,"ひとびと"],[14,1,"す"],[16,2,"ひとびと"],[21,1,"い"],[33,2,"しんでん"],[36,1,"たがや"],[43,1,"なか"],[45,1,"たね"]],"text":"主はユダの人々とエルサレムに住む人々にこう言われる、「あなたがたの新田を耕せ、いばらの中に種をまくな。"},{"ref":"Jer.4.4","start":24004004,"end":24004004,"break":"line","breaks":[[18,"line"],[33,"line"],[44,"line"],[58,"line"],[79,"line"],[97,"line"]],"ruby":[[3,2,"ひとびと"],[12,1,"す"],[14,2,"ひとびと"],[24,1,"みずか"],[26,2,"かつれい"],[29,1,"おこな"],[33,1,"しゅ"],[35,1,"ぞく"],[44,2,"じぶん"],[47,1,"こころ"],[49,1,"まえ"],[51,1,"かわ"],[53,1,"と"],[55,1,"さ"],[70,1,"あ"],[73,1,"おこな"],[83,1,"いか"],[86,1,"ひ"],[91,1,"はっ"],[94,1,"も"],[100,1,"け"],[102,1,"もの"]],"text":"ユダの人々とエルサレムに住む人々よ、あなたがたは自ら割礼を行って、主に属するものとなり、自分の心の前の皮を取り去れ。さもないと、あなたがたの悪しき行いのためにわたしの怒りが火のように発して燃え、これを消す者はない」。"},{"ref":"Jer.4.5","start":24004005,"end":24004005,"break":"stanza","breaks":[[18,"line"],[40,"line"]],"ruby":[[3,1,"つ"],[12,1,"しめ"],[15,1,"い"],[19,2,"くにぢゅう"],[26,1,"ふ"],[29,2,"おおごえ"],[32,1,"よ"],[37,1,"い"],[41,1,"あつ"],[50,2,"けんご"],[53,2,"まちまち"],[56,1,"い"]],"text":"ユダに告げ、エルサレムに示して言え、「国中にラッパを吹き、大声に呼ばわって言え、『集まれ、われわれは堅固な町々へ行こう』と。"},{"ref":"Jer.4.6","start":24004006,"end":24004006,"break":"line","breaks":[[14,"line"],[30,"line"],[39,"line"]],"ruby":[[4,1,"ほう"],[6,1,"しめ"],[8,1,"はた"],[10,1,"た"],[14,2,"ひなん"],[34,1,"きた"],[37,1,"わざわい"],[39,1,"おお"],[43,2,"はめつ"]],"text":"シオンの方を示す旗を立てよ。避難せよ、とどまってはならない、わたしが北から災と大いなる破滅をこさせるからだ。"},{"ref":"Jer.4.7","start":24004007,"end":24004007,"break":"line","breaks":[[14,"line"],[28,"line"],[43,"line"],[56,"line"],[69,"line"]],"ruby":[[5,1,"もり"],[8,1,"で"],[14,2,"くにぐに"],[17,1,"ほろ"],[20,1,"もの"],[22,1,"すす"],[28,1,"かれ"],[34,1,"くに"],[36,1,"あら"],[48,1,"ところ"],[51,1,"で"],[60,2,"まちまち"],[63,1,"ほろ"],[69,1,"す"],[71,1,"もの"]],"text":"ししはその森から出てのぼり、国々を滅ぼす者は進んできた。彼はあなたの国を荒そうとして、すでにその所から出てきた。あなたの町々は滅ぼされて、住む者もなくなる。"},{"ref":"Jer.4.8","start":24004008,"end":24004008,"break":"line","breaks":[[22,"line"],[28,"line"],[37,"line"]],"ruby":[[12,2,"あらぬの"],[15,1,"み"],[22,1,"かな"],[25,1,"なげ"],[28,1,"しゅ"],[30,1,"はげ"],[33,1,"いか"],[44,1,"はな"]],"text":"このために、あなたがたは荒布を身にまとって、悲しみ嘆け。主の激しい怒りが、まだわれわれを離れないからだ」。"},{"ref":"Jer.4.9","start":24004009,"end":24004009,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[10,1,"ひ"],[12,1,"おう"],[14,1,"きみ"],[21,1,"こころ"],[23,1,"うしな"],[26,2,"さいし"],[29,1,"おどろ"],[32,3,"よげんしゃ"],[36,1,"あや"]],"text":"主は言われる、「その日、王と君たちとはその心を失い、祭司は驚き、預言者は怪しむ」。"},{"ref":"Jer.4.10","start":24004010,"end":24004010,"break":"none","ruby":[[7,1,"い"],[14,1,"しゅ"],[17,1,"かみ"],[30,1,"たみ"],[43,1,"あざむ"],[57,1,"やす"],[65,1,"い"],[77,1,"いのち"],[82,1,"およ"]],"text":"そこでわたしは言った、「ああ主なる神よ、まことにあなたはこの民とエルサレムとをまったく欺かれました。『あなたがたは安らかになる』と言われましたが、つるぎが命にまでも及びました」。"},{"ref":"Jer.4.11","start":24004011,"end":24004011,"break":"paragraph","ruby":[[2,1,"とき"],[5,1,"たみ"],[16,1,"つ"],[23,1,"あつ"],[25,1,"かぜ"],[27,2,"あらの"],[30,1,"はだか"],[32,1,"やま"],[39,1,"たみ"],[41,1,"むすめ"],[46,1,"ふ"],[58,1,"わ"],[68,1,"きよ"]],"text":"その時この民とエルサレムとはこう告げられる、「熱い風が荒野の裸の山からわたしの民の娘のほうに吹いてくる。これはあおぎ分けるためではなく、清めるためでもない。"},{"ref":"Jer.4.12","start":24004012,"end":24004012,"break":"none","ruby":[[7,1,"はげ"],[10,1,"かぜ"],[19,1,"ふ"],[28,1,"かれ"],[35,1,"つ"]],"text":"これよりもなお激しい風がわたしのために吹く。いまわたしは彼らにさばきを告げる」。"},{"ref":"Jer.4.13","start":24004013,"end":24004013,"break":"stanza","breaks":[[16,"line"],[29,"line"],[44,"line"],[58,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[5,1,"くも"],[10,1,"のぼ"],[18,2,"せんしゃ"],[24,1,"かぜ"],[31,1,"うま"],[36,1,"と"],[41,1,"はや"],[63,1,"ほろ"]],"text":"見よ、彼は雲のように上ってくる。その戦車はつむじ風のよう、その馬はわしの飛ぶよりも速い。ああ、われわれはわざわいだ、われわれは滅ぼされる。"},{"ref":"Jer.4.14","start":24004014,"end":24004014,"break":"line","breaks":[[21,"line"],[33,"line"],[43,"line"]],"ruby":[[11,1,"こころ"],[13,1,"あく"],[15,1,"あら"],[17,1,"きよ"],[28,1,"すく"],[33,1,"あ"],[36,1,"おも"]],"text":"エルサレムよ、あなたの心の悪を洗い清めよ、そうするならば救われる。悪しき思いはいつまであなたのうちにとどまるのか。"},{"ref":"Jer.4.15","start":24004015,"end":24004015,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"つ"],[7,1,"こえ"],[18,1,"やま"],[21,1,"わざわい"],[23,1,"し"]],"text":"ダンから告げる声がある、エフライムの山から災を知らせている。"},{"ref":"Jer.4.16","start":24004016,"end":24004016,"break":"line","breaks":[[15,"line"],[28,"line"],[45,"line"]],"ruby":[[0,2,"くにぐに"],[3,1,"たみ"],[5,1,"かれ"],[7,1,"く"],[12,1,"つ"],[23,1,"し"],[29,1,"せ"],[34,1,"もの"],[36,1,"とお"],[39,1,"くに"],[42,1,"き"],[48,2,"まちまち"],[57,1,"こえ"]],"text":"国々の民に彼の来ることを告げ、またエルサレムに知らせよ。「攻めかこむ者が遠くの国から来て、ユダの町々にむかってその声をあげる。"},{"ref":"Jer.4.17","start":24004017,"end":24004017,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[3,1,"はたけ"],[5,1,"まも"],[7,1,"もの"],[15,1,"せ"],[37,1,"しゅ"],[39,1,"い"]],"text":"彼らは畑を守る者のようにこれを攻めかこむ。それはわたしにそむいたからだと、主は言われる。"},{"ref":"Jer.4.18","start":24004018,"end":24004018,"break":"line","breaks":[[13,"line"],[28,"line"],[48,"line"]],"ruby":[[4,1,"みち"],[8,1,"おこな"],[17,1,"み"],[22,1,"まね"],[35,1,"あく"],[37,2,"けっか"],[45,1,"にが"],[52,1,"こころ"]],"text":"あなたの道とその行いとが、あなたの身にこれを招いたのだ。これはあなたの悪の結果で、まことに苦く、あなたの心をつらぬく」。"},{"ref":"Jer.4.19","start":24004019,"end":24004019,"break":"stanza","breaks":[[19,"line"],[32,"line"],[43,"line"],[60,"line"],[77,"line"]],"ruby":[[23,1,"くる"],[37,2,"しんぞう"],[40,1,"かべ"],[47,2,"しんぞう"],[55,2,"こどう"],[64,2,"ちんもく"],[67,1,"まも"],[81,1,"こえ"],[84,1,"たたか"],[87,1,"さけ"],[90,1,"き"]],"text":"ああ、わがはらわたよ、わがはらわたよ、わたしは苦しみにもだえる。ああ、わが心臓の壁よ、わたしの心臓は、はげしく鼓動する。わたしは沈黙を守ることができない、ラッパの声と、戦いの叫びを聞くからである。"},{"ref":"Jer.4.20","start":24004020,"end":24004020,"break":"line","breaks":[[12,"line"],[19,"line"],[34,"line"]],"ruby":[[0,2,"はかい"],[3,1,"つ"],[6,2,"はかい"],[12,1,"ぜん"],[13,1,"ち"],[15,1,"あら"],[23,2,"てんまく"],[30,1,"やぶ"],[38,1,"まく"],[44,1,"やぶ"]],"text":"破壊に次ぐに破壊があり、全地は荒され、わたしの天幕はにわかに破られ、わたしの幕はたちまち破られた。"},{"ref":"Jer.4.21","start":24004021,"end":24004021,"break":"line","breaks":[[12,"line"]],"ruby":[[8,1,"はた"],[10,1,"み"],[18,1,"こえ"],[20,1,"き"]],"text":"いつまでわたしは旗を見、またラッパの声を聞かなければならないのか。"},{"ref":"Jer.4.22","start":24004022,"end":24004022,"break":"line","breaks":[[23,"line"],[43,"line"],[60,"line"]],"ruby":[[5,1,"たみ"],[7,1,"おろ"],[18,1,"し"],[23,1,"かれ"],[26,2,"ぐどん"],[29,1,"こ"],[35,1,"さと"],[43,1,"かれ"],[46,1,"あく"],[48,1,"おこな"],[60,1,"ぜん"],[62,1,"おこな"],[67,1,"し"]],"text":"「わたしの民は愚かであって、わたしを知らない。彼らは愚鈍な子どもらで、悟ることがない。彼らは悪を行うのにさといけれども、善を行うことを知らない」。"},{"ref":"Jer.4.23","start":24004023,"end":24004023,"break":"stanza","breaks":[[10,"line"],[27,"line"]],"ruby":[[4,1,"ち"],[6,1,"み"],[13,1,"かたち"],[27,1,"てん"],[39,1,"ひかり"]],"text":"わたしは地を見たが、それは形がなく、またむなしかった。天をあおいだが、そこには光がなかった。"},{"ref":"Jer.4.24","start":24004024,"end":24004024,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"やま"],[6,1,"み"],[12,1,"ふる"],[20,1,"おか"],[22,1,"うご"]],"text":"わたしは山を見たが、みな震え、もろもろの丘は動いていた。"},{"ref":"Jer.4.25","start":24004025,"end":24004025,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"み"],[8,1,"ひと"],[18,1,"そら"],[20,1,"とり"],[24,1,"と"],[26,1,"さ"]],"text":"わたしは見たが、人はひとりもおらず、空の鳥はみな飛び去っていた。"},{"ref":"Jer.4.26","start":24004026,"end":24004026,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[4,1,"み"],[8,1,"ゆた"],[11,1,"ち"],[13,1,"あ"],[15,1,"ち"],[26,1,"まち"],[29,1,"しゅ"],[31,1,"まえ"],[36,1,"はげ"],[39,1,"いか"],[42,1,"まえ"],[45,2,"はかい"]],"text":"わたしは見たが、豊かな地は荒れ地となり、そのすべての町は、主の前に、その激しい怒りの前に、破壊されていた。"},{"ref":"Jer.4.27","start":24004027,"end":24004027,"break":"line","ruby":[[3,1,"しゅ"],[7,1,"い"],[16,1,"ぜん"],[17,1,"ち"],[19,1,"あ"],[21,1,"ち"],[42,1,"ほろ"]],"text":"それは主がこう言われたからだ、「全地は荒れ地となる。しかしわたしはことごとくはこれを滅ぼさない。"},{"ref":"Jer.4.28","start":24004028,"end":24004028,"break":"line","breaks":[[21,"line"],[44,"line"]],"ruby":[[5,1,"ち"],[7,1,"かな"],[11,1,"うえ"],[14,1,"てん"],[16,1,"くら"],[31,1,"い"],[37,1,"さだ"],[48,1,"く"],[60,1,"こと"]],"text":"このために地は悲しみ、上なる天は暗くなる。わたしがすでにこれを言い、これを定めたからだ。わたしは悔いない、またそれをする事をやめない」。"},{"ref":"Jer.4.29","start":24004029,"end":24004029,"break":"stanza","breaks":[[19,"line"],[32,"line"]],"ruby":[[2,1,"まち"],[4,1,"ひと"],[7,2,"きへい"],[10,2,"いて"],[13,1,"さけ"],[19,1,"に"],[22,1,"もり"],[24,1,"はい"],[27,1,"いわ"],[29,1,"のぼ"],[32,1,"まち"],[36,1,"す"],[44,1,"す"],[46,1,"ひと"]],"text":"どの町の人も、騎兵と射手の叫びのために逃げて森に入り、岩に上る。町はみな捨てられ、そこに住む人はない。"},{"ref":"Jer.4.30","start":24004030,"end":24004030,"break":"line","breaks":[[21,"line"],[33,"line"],[53,"line"],[70,"line"],[86,"line"]],"ruby":[[3,1,"あら"],[7,1,"おんな"],[14,1,"べに"],[16,2,"きもの"],[21,1,"きん"],[23,1,"かざ"],[26,1,"み"],[33,1,"め"],[35,1,"ぬ"],[38,1,"おお"],[57,1,"うつく"],[74,2,"こいびと"],[82,1,"いや"],[90,1,"いのち"],[92,1,"もと"]],"text":"ああ、荒された女よ、あなたが紅の着物をき、金の飾りで身をよそおい、目を塗って大きくするのは、なんのためか。あなたが美しくしても、むだである。あなたの恋人らはあなたを卑しめ、あなたの命を求めている。"},{"ref":"Jer.4.31","start":24004031,"end":24004031,"break":"line","breaks":[[15,"line"],[35,"line"],[50,"line"],[73,"line"]],"ruby":[[4,1,"こ"],[6,1,"う"],[8,1,"おんな"],[13,1,"こえ"],[19,1,"う"],[21,1,"おんな"],[23,1,"くる"],[29,1,"こえ"],[31,1,"き"],[39,1,"むすめ"],[44,1,"さけ"],[50,2,"りょうて"],[53,1,"の"],[56,2,"かのじょ"],[59,1,"い"],[77,1,"ころ"],[79,1,"もの"],[82,1,"まえ"],[88,1,"き"],[90,1,"とお"]],"text":"わたしは子を産む女のような声、ういごを産む女の苦しむような声を聞いた。シオンの娘のあえぐ叫びである。両手を伸べて彼女は言う、「わたしはわざわいだ、わたしを殺す者らの前にわたしは気が遠くなる」と。"}]