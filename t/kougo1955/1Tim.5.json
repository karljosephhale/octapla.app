[{"ref":"1Tim.5.1","start":54005001,"end":54005001,"break":"paragraph","ruby":[[0,2,"ろうじん"],[16,2,"ちちおや"],[19,1,"たい"],[26,1,"はな"],[35,1,"わか"],[37,1,"おとこ"],[40,2,"きょうだい"],[43,1,"たい"]],"text":"老人をとがめてはいけない。むしろ父親に対するように、話してあげなさい。若い男には兄弟に対するように、"},{"ref":"1Tim.5.2","start":54005002,"end":54005002,"break":"none","ruby":[[0,1,"とし"],[4,1,"おんな"],[7,2,"ははおや"],[10,1,"たい"],[17,1,"わか"],[19,1,"おんな"],[23,1,"しん"],[25,2,"じゅんけつ"],[28,1,"おも"],[35,2,"しまい"],[38,1,"たい"],[45,2,"かんこく"]],"text":"年とった女には母親に対するように、若い女には、真に純潔な思いをもって、姉妹に対するように、勧告しなさい。"},{"ref":"1Tim.5.3","start":54005003,"end":54005003,"break":"paragraph","ruby":[[9,1,"しん"]],"text":"やもめについては、真にたよりのないやもめたちを、よくしてあげなさい。"},{"ref":"1Tim.5.4","start":54005004,"end":54005004,"break":"none","ruby":[[4,1,"こ"],[6,1,"まご"],[11,2,"ばあい"],[20,1,"もの"],[25,2,"じぶん"],[28,1,"いえ"],[30,2,"こうよう"],[37,1,"おや"],[39,1,"おん"],[41,1,"むく"],[47,1,"まな"],[61,1,"かみ"]],"text":"やもめに子か孫かがある場合には、これらの者に、まず自分の家で孝養をつくし、親の恩に報いることを学ばせるべきである。それが、神のみこころにかなうことなのである。"},{"ref":"1Tim.5.5","start":54005005,"end":54005005,"break":"none","ruby":[[0,1,"しん"],[12,1,"ぐら"],[20,1,"のぞ"],[23,1,"かみ"],[29,2,"にちや"],[35,1,"ねが"],[38,1,"いのり"],[41,2,"せんしん"]],"text":"真にたよりのない、ひとり暮しのやもめは、望みを神において、日夜、たえず願いと祈とに専心するが、"},{"ref":"1Tim.5.6","start":54005006,"end":54005006,"break":"none","ruby":[[3,1,"はん"],[11,2,"せいかつ"],[23,1,"い"]],"text":"これに反して、みだらな生活をしているやもめは、生けるしかばねにすぎない。"},{"ref":"1Tim.5.7","start":54005007,"end":54005007,"break":"none","ruby":[[7,1,"めい"],[11,2,"かのじょ"],[16,2,"ひなん"],[21,1,"もの"]],"text":"これらのことを命じて、彼女たちを非難のない者としなさい。"},{"ref":"1Tim.5.8","start":54005008,"end":54005008,"break":"none","ruby":[[4,1,"ひと"],[9,2,"しんぞく"],[16,2,"じぶん"],[19,2,"かぞく"],[28,2,"ばあい"],[35,2,"しんこう"],[38,1,"す"],[52,3,"ふしんじゃ"],[55,2,"いじょう"]],"text":"もしある人が、その親族を、ことに自分の家族をかえりみない場合には、その信仰を捨てたことになるのであって、不信者以上にわるい。"},{"ref":"1Tim.5.9","start":54005009,"end":54005009,"break":"none","ruby":[[6,2,"とうろく"],[12,1,"もの"],[17,1,"さい"],[18,2,"いか"],[33,1,"おっと"],[35,1,"つま"],[40,1,"もの"]],"text":"やもめとして登録さるべき者は、六十歳以下のものではなくて、ひとりの夫の妻であった者、"},{"ref":"1Tim.5.10","start":54005010,"end":54005010,"break":"none","ruby":[[2,2,"しじょ"],[7,2,"よういく"],[11,2,"たびびと"],[19,2,"せいと"],[22,1,"あし"],[24,1,"あら"],[27,1,"こま"],[32,1,"ひと"],[34,1,"たす"],[37,2,"しゅじゅ"],[40,2,"ぜんこう"],[43,1,"つと"],[59,1,"みと"],[66,1,"もの"]],"text":"また子女をよく養育し、旅人をもてなし、聖徒の足を洗い、困っている人を助け、種々の善行に努めるなど、そのよいわざでひろく認められている者でなければならない。"},{"ref":"1Tim.5.11","start":54005011,"end":54005011,"break":"none","ruby":[[0,1,"わか"],[6,1,"じょ"],[7,1,"がい"],[15,2,"かのじょ"],[29,1,"き"],[37,2,"けっこん"]],"text":"若いやもめは除外すべきである。彼女たちがキリストにそむいて気ままになると、結婚をしたがるようになり、"},{"ref":"1Tim.5.12","start":54005012,"end":54005012,"break":"none","ruby":[[0,1,"はじ"],[3,1,"ちか"],[6,2,"むし"],[13,2,"ひなん"],[16,1,"う"]],"text":"初めの誓いを無視したという非難を受けねばならないからである。"},{"ref":"1Tim.5.13","start":54005013,"end":54005013,"break":"none","ruby":[[2,1,"うえ"],[4,2,"かのじょ"],[16,2,"いえいえ"],[19,1,"あそ"],[21,1,"ある"],[55,1,"うご"],[61,1,"くち"],[73,1,"い"]],"text":"その上、彼女たちはなまけていて、家々を遊び歩くことをおぼえ、なまけるばかりか、むだごとをしゃべって、いたずらに動きまわり、口にしてはならないことを言う。"},{"ref":"1Tim.5.14","start":54005014,"end":54005014,"break":"none","ruby":[[10,1,"わか"],[16,2,"けっこん"],[20,1,"こ"],[22,1,"う"],[25,1,"いえ"],[35,3,"はんたいしゃ"],[47,1,"つく"]],"text":"そういうわけだから、若いやもめは結婚して子を産み、家をおさめ、そして、反対者にそしられるすきを作らないようにしてほしい。"},{"ref":"1Tim.5.15","start":54005015,"end":54005015,"break":"none","ruby":[[0,2,"かのじょ"],[17,1,"お"],[20,1,"みち"],[22,1,"ふ"],[28,1,"もの"]],"text":"彼女たちのうちには、サタンのあとを追って道を踏みはずした者もある。"},{"ref":"1Tim.5.16","start":54005016,"end":54005016,"break":"none","ruby":[[0,1,"おんな"],[2,2,"しんじゃ"],[5,1,"いえ"],[11,1,"も"],[16,2,"ばあい"],[21,2,"じぶん"],[30,2,"せわ"],[41,2,"きょうかい"],[58,2,"きょうかい"],[62,1,"しん"],[74,2,"せわ"]],"text":"女の信者が家にやもめを持っている場合には、自分でそのやもめの世話をしてあげなさい。教会のやっかいになってはいけない。教会は、真にたよりのないやもめの世話をしなければならない。"},{"ref":"1Tim.5.17","start":54005017,"end":54005017,"break":"paragraph","ruby":[[2,2,"しどう"],[9,2,"ちょうろう"],[12,1,"とく"],[14,2,"せんきょう"],[17,1,"おしえ"],[23,1,"ろう"],[28,2,"ちょうろう"],[33,1,"ばい"],[35,2,"そんけい"],[38,1,"う"],[47,1,"もの"]],"text":"よい指導をしている長老、特に宣教と教とのために労している長老は、二倍の尊敬を受けるにふさわしい者である。"},{"ref":"1Tim.5.18","start":54005018,"end":54005018,"break":"none","ruby":[[0,2,"せいしょ"],[5,2,"こくもつ"],[14,1,"うし"],[33,1,"はたら"],[35,1,"びと"],[39,2,"ほうしゅう"],[42,1,"う"],[47,2,"とうぜん"],[54,1,"い"]],"text":"聖書は、「穀物をこなしている牛に、くつこをかけてはならない」また「働き人がその報酬を受けるのは当然である」と言っている。"},{"ref":"1Tim.5.19","start":54005019,"end":54005019,"break":"none","ruby":[[0,2,"ちょうろう"],[3,1,"たい"],[6,2,"そしょう"],[15,1,"にん"],[17,2,"しょうにん"],[22,2,"ばあい"],[27,2,"じゅり"]],"text":"長老に対する訴訟は、ふたりか三人の証人がない場合には、受理してはならない。"},{"ref":"1Tim.5.20","start":54005020,"end":54005020,"break":"none","ruby":[[0,1,"つみ"],[2,1,"おか"],[5,1,"もの"],[7,1,"たい"],[15,2,"ひとびと"],[18,1,"おそ"],[25,1,"いた"],[35,1,"ひと"],[37,1,"まえ"],[41,1,"つみ"]],"text":"罪を犯した者に対しては、ほかの人々も恐れをいだくに至るために、すべての人の前でその罪をとがむべきである。"},{"ref":"1Tim.5.21","start":54005021,"end":54005021,"break":"none","ruby":[[5,1,"かみ"],[16,1,"えら"],[20,2,"みつかい"],[26,1,"まえ"],[38,1,"めい"],[49,2,"へんけん"],[54,1,"まも"],[57,2,"なにごと"],[65,1,"ふ"],[66,2,"こうへい"],[69,2,"しかた"]],"text":"わたしは、神とキリスト・イエスと選ばれた御使たちとの前で、おごそかにあなたに命じる。これらのことを偏見なしに守り、何事についても、不公平な仕方をしてはならない。"},{"ref":"1Tim.5.22","start":54005022,"end":54005022,"break":"none","ruby":[[0,2,"かるがる"],[4,1,"ひと"],[6,1,"て"],[23,1,"ひと"],[25,1,"つみ"],[27,1,"くわ"],[37,2,"じぶん"],[43,1,"まも"]],"text":"軽々しく人に手をおいてはならない。また、ほかの人の罪に加わってはいけない。自分をきよく守りなさい。"},{"ref":"1Tim.5.23","start":54005023,"end":54005023,"break":"none","ruby":[[7,1,"みず"],[12,1,"の"],[18,1,"い"],[35,1,"やわ"],[43,2,"しょうりょう"],[49,1,"しゅ"],[51,1,"もち"]],"text":"（これからは、水ばかりを飲まないで、胃のため、また、たびたびのいたみを和らげるために、少量のぶどう酒を用いなさい。）"},{"ref":"1Tim.5.24","start":54005024,"end":54005024,"break":"none","ruby":[[2,1,"ひと"],[4,1,"つみ"],[6,2,"めいはく"],[15,2,"さいばん"],[28,1,"ひと"],[30,1,"つみ"],[43,1,"く"]],"text":"ある人の罪は明白であって、すぐ裁判にかけられるが、ほかの人の罪は、あとになってわかって来る。"},{"ref":"1Tim.5.25","start":54005025,"end":54005025,"break":"none","ruby":[[3,1,"おな"],[7,1,"よ"],[14,1,"あき"],[27,2,"ばあい"],[32,1,"かく"],[42,1,"え"]],"text":"それと同じく、良いわざもすぐ明らかになり、そうならない場合でも、隠れていることはあり得ない。"}]