[{"ref":"Matt.10.1","start":40010001,"end":40010001,"break":"paragraph","ruby":[[10,2,"でし"],[13,1,"よ"],[15,1,"よ"],[19,1,"けが"],[22,1,"れい"],[24,1,"お"],[26,1,"だ"],[33,2,"びょうき"],[48,2,"けんい"],[52,1,"さづ"]],"text":"そこで、イエスは十二弟子を呼び寄せて、汚れた霊を追い出し、あらゆる病気、あらゆるわずらいをいやす権威をお授けになった。"},{"ref":"Matt.10.2","start":40010002,"end":40010002,"break":"paragraph","ruby":[[2,2,"しと"],[5,1,"な"],[8,1,"つぎ"],[23,1,"よ"],[33,2,"きょうだい"],[49,1,"こ"],[56,2,"きょうだい"]],"text":"十二使徒の名は、次のとおりである。まずペテロと呼ばれたシモンとその兄弟アンデレ、それからゼベダイの子ヤコブとその兄弟ヨハネ、"},{"ref":"Matt.10.3","start":40010003,"end":40010003,"break":"none","ruby":[[15,3,"しゅぜいにん"],[27,1,"こ"]],"text":"ピリポとバルトロマイ、トマスと取税人マタイ、アルパヨの子ヤコブとタダイ、"},{"ref":"Matt.10.4","start":40010004,"end":40010004,"break":"none","ruby":[[0,2,"ねっしん"],[2,1,"とう"],[27,2,"うらぎ"],[31,1,"もの"]],"text":"熱心党のシモンとイスカリオテのユダ。このユダはイエスを裏切った者である。"},{"ref":"Matt.10.5","start":40010005,"end":40010005,"break":"paragraph","ruby":[[8,1,"にん"],[15,1,"あた"],[18,1,"かれ"],[21,1,"めい"],[24,1,"い"],[30,3,"いほうじん"],[34,1,"みち"],[36,1,"い"],[46,1,"びと"],[48,1,"まち"]],"text":"イエスはこの十二人をつかわすに当り、彼らに命じて言われた、「異邦人の道に行くな。またサマリヤ人の町にはいるな。"},{"ref":"Matt.10.6","start":40010006,"end":40010006,"break":"none","ruby":[[10,1,"いえ"],[12,1,"うしな"],[16,1,"ひつじ"],[22,1,"い"]],"text":"むしろ、イスラエルの家の失われた羊のところに行け。"},{"ref":"Matt.10.7","start":40010007,"end":40010007,"break":"none","ruby":[[0,1,"い"],[5,2,"てんごく"],[8,1,"ちか"],[14,1,"の"],[16,1,"つた"]],"text":"行って、『天国が近づいた』と宣べ伝えよ。"},{"ref":"Matt.10.8","start":40010008,"end":40010008,"break":"none","ruby":[[0,2,"びょうにん"],[7,2,"しにん"],[19,2,"びょうにん"],[26,2,"あくれい"],[29,1,"お"],[31,1,"だ"],[37,1,"う"],[48,1,"あた"]],"text":"病人をいやし、死人をよみがえらせ、らい病人をきよめ、悪霊を追い出せ。ただで受けたのだから、ただで与えるがよい。"},{"ref":"Matt.10.9","start":40010009,"end":40010009,"break":"none","ruby":[[0,2,"さいふ"],[3,1,"なか"],[5,1,"きん"],[7,1,"ぎん"],[11,1,"ぜに"],[13,1,"い"],[16,1,"い"]],"text":"財布の中に金、銀または銭を入れて行くな。"},{"ref":"Matt.10.10","start":40010010,"end":40010010,"break":"none","ruby":[[0,2,"りょこう"],[6,1,"ふくろ"],[10,1,"まい"],[12,2,"したぎ"],[23,1,"も"],[26,1,"い"],[30,1,"はたら"],[32,1,"びと"],[36,2,"しょくもつ"],[39,1,"え"],[43,2,"とうぜん"]],"text":"旅行のための袋も、二枚の下着も、くつも、つえも持って行くな。働き人がその食物を得るのは当然である。"},{"ref":"Matt.10.11","start":40010011,"end":40010011,"break":"none","ruby":[[2,1,"まち"],[6,1,"むら"],[16,1,"なか"],[26,1,"ひと"],[32,1,"だ"],[36,1,"た"],[38,1,"さ"],[45,1,"ひと"]],"text":"どの町、どの村にはいっても、その中でだれがふさわしい人か、たずね出して、立ち去るまではその人のところにとどまっておれ。"},{"ref":"Matt.10.12","start":40010012,"end":40010012,"break":"none","ruby":[[2,1,"いえ"],[11,2,"へいあん"],[14,1,"いの"]],"text":"その家にはいったなら、平安を祈ってあげなさい。"},{"ref":"Matt.10.13","start":40010013,"end":40010013,"break":"none","ruby":[[2,2,"へいあん"],[5,1,"う"],[14,1,"いえ"],[26,1,"いの"],[28,2,"へいあん"],[33,1,"いえ"],[35,1,"く"],[56,2,"へいあん"],[65,1,"かえ"],[68,1,"く"]],"text":"もし平安を受けるにふさわしい家であれば、あなたがたの祈る平安はその家に来るであろう。もしふさわしくなければ、その平安はあなたがたに帰って来るであろう。"},{"ref":"Matt.10.14","start":40010014,"end":40010014,"break":"none","ruby":[[8,1,"むか"],[22,2,"ことば"],[25,1,"き"],[31,1,"ひと"],[39,1,"いえ"],[41,1,"まち"],[43,1,"た"],[45,1,"さ"],[47,1,"とき"],[50,1,"あし"],[55,1,"はら"],[57,1,"おと"]],"text":"もしあなたがたを迎えもせず、またあなたがたの言葉を聞きもしない人があれば、その家や町を立ち去る時に、足のちりを払い落しなさい。"},{"ref":"Matt.10.15","start":40010015,"end":40010015,"break":"none","ruby":[[8,1,"い"],[18,1,"ひ"],[30,1,"ち"],[32,1,"ほう"],[37,1,"まち"],[41,1,"た"]],"text":"あなたがたによく言っておく。さばきの日には、ソドム、ゴモラの地の方が、その町よりは耐えやすいであろう。"},{"ref":"Matt.10.16","start":40010016,"end":40010016,"break":"paragraph","ruby":[[17,1,"ひつじ"],[24,1,"なか"],[26,1,"おく"],[47,1,"かしこ"],[56,2,"すなお"]],"text":"わたしがあなたがたをつかわすのは、羊をおおかみの中に送るようなものである。だから、へびのように賢く、はとのように素直であれ。"},{"ref":"Matt.10.17","start":40010017,"end":40010017,"break":"none","ruby":[[0,2,"ひとびと"],[3,2,"ちゅうい"],[10,1,"かれ"],[19,3,"しゅうぎしょ"],[23,1,"ひ"],[25,1,"わた"],[28,2,"かいどう"],[33,1,"う"]],"text":"人々に注意しなさい。彼らはあなたがたを衆議所に引き渡し、会堂でむち打つであろう。"},{"ref":"Matt.10.18","start":40010018,"end":40010018,"break":"none","ruby":[[16,2,"ちょうかん"],[21,1,"おう"],[25,1,"まえ"],[27,1,"ひ"],[29,1,"だ"],[42,1,"かれ"],[45,3,"いほうじん"],[50,1,"たい"]],"text":"またあなたがたは、わたしのために長官たちや王たちの前に引き出されるであろう。それは、彼らと異邦人とに対してあかしをするためである。"},{"ref":"Matt.10.19","start":40010019,"end":40010019,"break":"none","ruby":[[0,1,"かれ"],[9,1,"ひ"],[11,1,"わた"],[17,1,"なに"],[21,1,"い"],[26,2,"しんぱい"],[35,1,"い"],[45,1,"とき"],[47,1,"さづ"]],"text":"彼らがあなたがたを引き渡したとき、何をどう言おうかと心配しないがよい。言うべきことは、その時に授けられるからである。"},{"ref":"Matt.10.20","start":40010020,"end":40010020,"break":"none","ruby":[[0,1,"かた"],[2,1,"もの"],[21,1,"なか"],[26,1,"かた"],[28,1,"ちち"],[30,1,"れい"]],"text":"語る者は、あなたがたではなく、あなたがたの中にあって語る父の霊である。"},{"ref":"Matt.10.21","start":40010021,"end":40010021,"break":"none","ruby":[[0,2,"きょうだい"],[3,2,"きょうだい"],[7,1,"ちち"],[9,1,"こ"],[11,1,"ころ"],[16,1,"わた"],[21,1,"こ"],[23,1,"おや"],[25,1,"さか"],[29,1,"た"],[32,1,"かれ"],[35,1,"ころ"]],"text":"兄弟は兄弟を、父は子を殺すために渡し、また子は親に逆らって立ち、彼らを殺させるであろう。"},{"ref":"Matt.10.22","start":40010022,"end":40010022,"break":"none","ruby":[[13,1,"な"],[22,1,"ひと"],[24,1,"にく"],[37,2,"さいご"],[41,1,"た"],[43,1,"しの"],[45,1,"もの"],[47,1,"すく"]],"text":"またあなたがたは、わたしの名のゆえにすべての人に憎まれるであろう。しかし、最後まで耐え忍ぶ者は救われる。"},{"ref":"Matt.10.23","start":40010023,"end":40010023,"break":"none","ruby":[[3,1,"まち"],[5,2,"はくがい"],[13,1,"た"],[15,1,"まち"],[17,1,"に"],[25,1,"い"],[43,2,"まちまち"],[46,1,"まわ"],[48,1,"おわ"],[56,1,"ひと"],[58,1,"こ"],[60,1,"く"]],"text":"一つの町で迫害されたなら、他の町へ逃げなさい。よく言っておく。あなたがたがイスラエルの町々を回り終らないうちに、人の子は来るであろう。"},{"ref":"Matt.10.24","start":40010024,"end":40010024,"break":"paragraph","ruby":[[0,2,"でし"],[5,1,"し"],[6,2,"いじょう"],[16,1,"しもべ"],[20,2,"しゅじん"],[22,2,"いじょう"],[25,1,"もの"]],"text":"弟子はその師以上のものではなく、僕はその主人以上の者ではない。"},{"ref":"Matt.10.25","start":40010025,"end":40010025,"break":"none","ruby":[[0,2,"でし"],[5,1,"し"],[13,1,"しもべ"],[17,2,"しゅじん"],[30,2,"じゅうぶん"],[38,1,"いえ"],[40,2,"しゅじん"],[49,1,"い"],[59,1,"いえ"],[61,1,"もの"],[75,1,"わる"],[77,1,"い"]],"text":"弟子がその師のようであり、僕がその主人のようであれば、それで十分である。もし家の主人がベルゼブルと言われるならば、その家の者どもはなおさら、どんなにか悪く言われることであろう。"},{"ref":"Matt.10.26","start":40010026,"end":40010026,"break":"none","ruby":[[3,1,"かれ"],[6,1,"おそ"],[20,1,"あらわ"],[32,1,"かく"],[41,1,"し"]],"text":"だから彼らを恐れるな。おおわれたもので、現れてこないものはなく、隠れているもので、知られてこないものはない。"},{"ref":"Matt.10.27","start":40010027,"end":40010027,"break":"none","ruby":[[4,1,"くら"],[14,1,"はな"],[20,1,"あか"],[24,1,"い"],[27,1,"みみ"],[39,2,"やね"],[42,1,"うえ"],[44,1,"い"]],"text":"わたしが暗やみであなたがたに話すことを、明るみで言え。耳にささやかれたことを、屋根の上で言いひろめよ。"},{"ref":"Matt.10.28","start":40010028,"end":40010028,"break":"none","ruby":[[7,1,"ころ"],[12,1,"たましい"],[14,1,"ころ"],[23,1,"もの"],[27,1,"おそ"],[40,1,"たましい"],[42,2,"じごく"],[45,1,"ほろ"],[48,1,"ちから"],[55,1,"おそ"]],"text":"また、からだを殺しても、魂を殺すことのできない者どもを恐れるな。むしろ、からだも魂も地獄で滅ぼす力のあるかたを恐れなさい。"},{"ref":"Matt.10.29","start":40010029,"end":40010029,"break":"none","ruby":[[1,1,"わ"],[14,1,"う"],[35,1,"ちち"],[37,1,"ゆる"],[48,1,"わ"],[50,1,"ち"],[52,1,"お"]],"text":"二羽のすずめは一アサリオンで売られているではないか。しかもあなたがたの父の許しがなければ、その一羽も地に落ちることはない。"},{"ref":"Matt.10.30","start":40010030,"end":40010030,"break":"none","ruby":[[8,1,"あたま"],[10,1,"け"],[17,1,"かぞ"]],"text":"またあなたがたの頭の毛までも、みな数えられている。"},{"ref":"Matt.10.31","start":40010031,"end":40010031,"break":"none","ruby":[[6,1,"おそ"],[21,1,"おお"],[35,1,"もの"]],"text":"それだから、恐れることはない。あなたがたは多くのすずめよりも、まさった者である。"},{"ref":"Matt.10.32","start":40010032,"end":40010032,"break":"none","ruby":[[3,1,"ひと"],[5,1,"まえ"],[11,1,"う"],[16,1,"もの"],[26,1,"てん"],[35,1,"ちち"],[37,1,"まえ"],[39,1,"う"]],"text":"だから人の前でわたしを受けいれる者を、わたしもまた、天にいますわたしの父の前で受けいれるであろう。"},{"ref":"Matt.10.33","start":40010033,"end":40010033,"break":"none","ruby":[[4,1,"ひと"],[6,1,"まえ"],[12,1,"こば"],[14,1,"もの"],[21,1,"てん"],[30,1,"ちち"],[32,1,"まえ"],[34,1,"こば"]],"text":"しかし、人の前でわたしを拒む者を、わたしも天にいますわたしの父の前で拒むであろう。"},{"ref":"Matt.10.34","start":40010034,"end":40010034,"break":"paragraph","ruby":[[0,2,"ちじょう"],[3,2,"へいわ"],[21,1,"おも"],[25,2,"へいわ"],[36,1,"な"],[38,1,"こ"]],"text":"地上に平和をもたらすために、わたしがきたと思うな。平和ではなく、つるぎを投げ込むためにきたのである。"},{"ref":"Matt.10.35","start":40010035,"end":40010035,"break":"none","ruby":[[9,1,"ひと"],[13,1,"ちち"],[16,1,"むすめ"],[20,1,"はは"],[23,1,"よめ"],[33,1,"なか"]],"text":"わたしがきたのは、人をその父と、娘をその母と、嫁をそのしゅうとめと仲たがいさせるためである。"},{"ref":"Matt.10.36","start":40010036,"end":40010036,"break":"none","ruby":[[3,1,"いえ"],[5,1,"もの"],[10,1,"ひと"],[12,1,"てき"]],"text":"そして家の者が、その人の敵となるであろう。"},{"ref":"Matt.10.37","start":40010037,"end":40010037,"break":"none","ruby":[[6,1,"ちち"],[10,1,"はは"],[12,1,"あい"],[15,1,"もの"],[40,1,"むすめ"],[42,1,"あい"],[45,1,"もの"]],"text":"わたしよりも父または母を愛する者は、わたしにふさわしくない。わたしよりもむすこや娘を愛する者は、わたしにふさわしくない。"},{"ref":"Matt.10.38","start":40010038,"end":40010038,"break":"none","ruby":[[2,2,"じぶん"],[5,3,"じゅうじか"],[16,1,"したが"],[22,1,"もの"]],"text":"また自分の十字架をとってわたしに従ってこない者はわたしにふさわしくない。"},{"ref":"Matt.10.39","start":40010039,"end":40010039,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"いのち"],[5,1,"え"],[9,1,"もの"],[14,1,"うしな"],[24,2,"じぶん"],[27,1,"いのち"],[29,1,"うしな"],[34,1,"もの"],[40,1,"え"]],"text":"自分の命を得ている者はそれを失い、わたしのために自分の命を失っている者は、それを得るであろう。"},{"ref":"Matt.10.40","start":40010040,"end":40010040,"break":"paragraph","ruby":[[6,1,"う"],[11,1,"もの"],[18,1,"う"],[32,1,"う"],[37,1,"もの"],[56,1,"う"]],"text":"あなたがたを受けいれる者は、わたしを受けいれるのである。わたしを受けいれる者は、わたしをおつかわしになったかたを受けいれるのである。"},{"ref":"Matt.10.41","start":40010041,"end":40010041,"break":"none","ruby":[[0,3,"よげんしゃ"],[4,1,"な"],[9,3,"よげんしゃ"],[13,1,"う"],[18,1,"もの"],[21,3,"よげんしゃ"],[25,1,"むく"],[28,1,"う"],[31,2,"ぎじん"],[34,1,"な"],[39,2,"ぎじん"],[42,1,"う"],[47,1,"もの"],[50,2,"ぎじん"],[53,1,"むく"],[56,1,"う"]],"text":"預言者の名のゆえに預言者を受けいれる者は、預言者の報いを受け、義人の名のゆえに義人を受けいれる者は、義人の報いを受けるであろう。"},{"ref":"Matt.10.42","start":40010042,"end":40010042,"break":"none","ruby":[[4,2,"でし"],[12,1,"な"],[20,1,"ちい"],[23,1,"もの"],[29,1,"つめ"],[32,1,"みず"],[34,1,"ぱい"],[37,1,"の"],[44,1,"もの"],[49,1,"い"],[56,1,"けっ"],[61,1,"むく"]],"text":"わたしの弟子であるという名のゆえに、この小さい者のひとりに冷たい水一杯でも飲ませてくれる者は、よく言っておくが、決してその報いからもれることはない」。"}]