[{"ref":"Jude.1.1","start":65001001,"end":65001001,"break":"paragraph","ruby":[[9,1,"しもべ"],[16,2,"きょうだい"],[26,1,"ちち"],[29,1,"かみ"],[31,1,"あい"],[44,1,"まも"],[50,1,"め"],[54,2,"ひとびと"]],"text":"イエス・キリストの僕またヤコブの兄弟であるユダから、父なる神に愛され、イエス・キリストに守られている召された人々へ。"},{"ref":"Jude.1.2","start":65001002,"end":65001002,"break":"paragraph","ruby":[[5,2,"へいあん"],[8,1,"あい"],[18,1,"ゆた"],[21,1,"くわ"]],"text":"あわれみと平安と愛とが、あなたがたに豊かに加わるように。"},{"ref":"Jude.1.3","start":65001003,"end":65001003,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[14,1,"とも"],[23,1,"すくい"],[35,1,"か"],[43,1,"こころ"],[46,1,"ねが"],[54,2,"せいと"],[67,1,"つた"],[72,2,"しんこう"],[78,1,"たたか"],[83,1,"すす"],[90,2,"てがみ"],[96,2,"ひつよう"],[99,1,"かん"],[103,1,"いた"]],"text":"愛する者たちよ。わたしたちが共にあずかっている救について、あなたがたに書きおくりたいと心から願っていたので、聖徒たちによって、ひとたび伝えられた信仰のために戦うことを勧めるように、手紙をおくる必要を感じるに至った。"},{"ref":"Jude.1.4","start":65001004,"end":65001004,"break":"none","ruby":[[6,1,"ふ"],[7,2,"しんこう"],[10,2,"ひとびと"],[16,1,"こ"],[28,1,"かみ"],[30,1,"めぐ"],[33,2,"ほうじゅう"],[36,2,"せいかつ"],[39,1,"か"],[42,2,"ゆいいつ"],[45,1,"きみ"],[56,1,"しゅ"],[69,2,"ひてい"],[81,1,"かれ"],[94,1,"う"],[101,1,"むかし"],[104,2,"よこく"]],"text":"そのわけは、不信仰な人々がしのび込んできて、わたしたちの神の恵みを放縦な生活に変え、唯一の君であり、わたしたちの主であるイエス・キリストを否定しているからである。彼らは、このようなさばきを受けることに、昔から予告されているのである。"},{"ref":"Jude.1.5","start":65001005,"end":65001005,"break":"paragraph","ruby":[[15,1,"し"],[28,1,"しゅ"],[30,1,"たみ"],[37,1,"ち"],[40,1,"すく"],[42,1,"だ"],[45,1,"のち"],[47,1,"ふ"],[48,2,"しんこう"],[51,1,"もの"],[53,1,"ほろ"],[62,1,"おも"],[64,1,"おこ"]],"text":"あなたがたはみな、じゅうぶんに知っていることではあるが、主が民をエジプトの地から救い出して後、不信仰な者を滅ぼされたことを、思い起してもらいたい。"},{"ref":"Jude.1.6","start":65001006,"end":65001006,"break":"none","ruby":[[0,1,"しゅ"],[3,2,"じぶん"],[8,2,"ちい"],[11,1,"まも"],[25,1,"ところ"],[27,1,"す"],[29,1,"さ"],[32,2,"みつかい"],[38,1,"おお"],[42,1,"ひ"],[52,2,"えいきゅう"],[64,1,"くら"],[68,1,"なか"],[70,1,"と"],[72,1,"こ"]],"text":"主は、自分たちの地位を守ろうとはせず、そのおるべき所を捨て去った御使たちを、大いなる日のさばきのために、永久にしばりつけたまま、暗やみの中に閉じ込めておかれた。"},{"ref":"Jude.1.7","start":65001007,"end":65001007,"break":"none","ruby":[[13,2,"まちまち"],[17,2,"どうよう"],[24,1,"おな"],[29,2,"いんこう"],[36,3,"ふしぜん"],[40,2,"にくよく"],[43,1,"はし"],[49,2,"えいえん"],[52,1,"ひ"],[54,2,"けいばつ"],[57,1,"う"],[60,2,"ひとびと"],[63,1,"み"]],"text":"ソドム、ゴモラも、まわりの町々も、同様であって、同じように淫行にふけり、不自然な肉欲に走ったので、永遠の火の刑罰を受け、人々の見せしめにされている。"},{"ref":"Jude.1.8","start":65001008,"end":65001008,"break":"none","ruby":[[7,1,"おな"],[17,2,"ひとびと"],[21,1,"ゆめ"],[23,1,"まよ"],[28,1,"にく"],[30,1,"けが"],[33,2,"けんい"],[37,1,"もの"],[41,1,"かろ"],[45,2,"えいこう"],[49,1,"もの"]],"text":"しかし、これと同じように、これらの人々は、夢に迷わされて肉を汚し、権威ある者たちを軽んじ、栄光ある者たちをそしっている。"},{"ref":"Jude.1.9","start":65001009,"end":65001009,"break":"none","ruby":[[0,2,"みつかい"],[16,2,"したい"],[22,2,"あくま"],[25,1,"ろん"],[27,1,"あらそ"],[30,1,"とき"],[32,2,"あいて"],[55,1,"しゅ"],[61,1,"いまし"],[64,1,"くだ"],[72,1,"い"]],"text":"御使のかしらミカエルは、モーセの死体について悪魔と論じ争った時、相手をののしりさばくことはあえてせず、ただ、「主がおまえを戒めて下さるように」と言っただけであった。"},{"ref":"Jude.1.10","start":65001010,"end":65001010,"break":"none","ruby":[[6,2,"ひとびと"],[9,2,"じぶん"],[12,1,"し"],[28,2,"ふんべつ"],[33,2,"どうぶつ"],[42,2,"ほんのう"],[44,1,"てき"],[46,2,"ちしき"],[56,1,"みずか"],[59,2,"めつぼう"],[62,1,"まね"]],"text":"しかし、この人々は自分が知りもしないことをそしり、また、分別のない動物のように、ただ本能的な知識にあやまられて、自らの滅亡を招いている。"},{"ref":"Jude.1.11","start":65001011,"end":65001011,"break":"none","ruby":[[0,1,"かれ"],[11,1,"かれ"],[18,1,"みち"],[20,1,"い"],[23,1,"り"],[32,1,"まど"],[36,1,"まよ"],[38,1,"い"],[47,2,"はんぎゃく"],[52,1,"ほろ"]],"text":"彼らはわざわいである。彼らはカインの道を行き、利のためにバラムの惑わしに迷い入り、コラのような反逆をして滅んでしまうのである。"},{"ref":"Jude.1.12","start":65001012,"end":65001012,"break":"none","ruby":[[0,1,"かれ"],[10,1,"あい"],[11,1,"さん"],[13,1,"くわ"],[21,1,"けが"],[24,3,"ぶえんりょ"],[28,2,"えんかい"],[31,2,"どうせき"],[36,2,"じぶん"],[39,1,"はら"],[41,1,"こ"],[48,1,"かれ"],[56,1,"かぜ"],[58,1,"ふ"],[65,1,"みず"],[68,1,"くも"],[70,1,"みの"],[74,1,"か"],[76,1,"は"],[80,1,"ぬ"],[82,1,"す"],[87,1,"あき"],[89,1,"き"]],"text":"彼らは、あなたがたの愛餐に加わるが、それを汚し、無遠慮に宴会に同席して、自分の腹を肥やしている。彼らは、いわば、風に吹きまわされる水なき雲、実らない枯れ果てて、抜き捨てられた秋の木、"},{"ref":"Jude.1.13","start":65001013,"end":65001013,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"はじ"],[10,1,"だ"],[12,1,"うみ"],[14,2,"あらなみ"],[21,1,"ほし"],[26,1,"かれ"],[39,2,"えいきゅう"],[42,2,"ようい"]],"text":"自分の恥をあわにして出す海の荒波、さまよう星である。彼らには、まっくらなやみが永久に用意されている。"},{"ref":"Jude.1.14","start":65001014,"end":65001014,"break":"none","ruby":[[6,2,"だいめ"],[16,1,"かれ"],[22,2,"よげん"],[26,1,"い"],[31,1,"み"],[34,1,"しゅ"],[36,2,"むすう"],[39,2,"せいと"],[44,1,"ひき"]],"text":"アダムから七代目にあたるエノクも彼らについて預言して言った、「見よ、主は無数の聖徒たちを率いてこられた。"},{"ref":"Jude.1.15","start":65001015,"end":65001015,"break":"none","ruby":[[8,1,"もの"],[14,1,"おこな"],[25,3,"ふしんじん"],[29,1,"もの"],[32,2,"しんこう"],[35,2,"むし"],[39,1,"おか"],[46,3,"ふしんじん"],[59,3,"ふしんじん"],[63,2,"つみびと"],[66,1,"しゅ"],[72,1,"かた"],[79,2,"ぼうげん"],[83,1,"せ"]],"text":"それは、すべての者にさばきを行うためであり、また、不信心な者が、信仰を無視して犯したすべての不信心なしわざと、さらに、不信心な罪人が主にそむいて語ったすべての暴言とを責めるためである」。"},{"ref":"Jude.1.16","start":65001016,"end":65001016,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ふへい"],[10,2,"ふまん"],[13,1,"な"],[16,1,"もの"],[21,2,"じぶん"],[24,1,"よく"],[29,2,"せいかつ"],[35,1,"くち"],[37,2,"たいげん"],[40,1,"は"],[43,1,"り"],[48,1,"ひと"],[54,1,"もの"]],"text":"彼らは不平をならべ、不満を鳴らす者であり、自分の欲のままに生活し、その口は大言を吐き、利のために人にへつらう者である。"},{"ref":"Jude.1.17","start":65001017,"end":65001017,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[14,1,"しゅ"],[24,2,"しと"],[29,2,"よこく"],[33,2,"ことば"],[36,1,"おも"],[38,1,"だ"]],"text":"愛する者たちよ。わたしたちの主イエス・キリストの使徒たちが予告した言葉を思い出しなさい。"},{"ref":"Jude.1.18","start":65001018,"end":65001018,"break":"none","ruby":[[0,1,"かれ"],[11,1,"い"],[16,1,"おわ"],[19,1,"とき"],[26,1,"もの"],[36,2,"じぶん"],[39,3,"ふしんじん"],[43,1,"よく"],[48,2,"せいかつ"]],"text":"彼らはあなたがたにこう言った、「終りの時に、あざける者たちがあらわれて、自分の不信心な欲のままに生活するであろう」。"},{"ref":"Jude.1.19","start":65001019,"end":65001019,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ぶんぱ"],[9,1,"もの"],[11,1,"にく"],[13,1,"ぞく"],[16,1,"もの"],[18,2,"みたま"],[21,1,"も"],[25,1,"もの"]],"text":"彼らは分派をつくる者、肉に属する者、御霊を持たない者たちである。"},{"ref":"Jude.1.20","start":65001020,"end":65001020,"break":"none","ruby":[[4,1,"あい"],[7,1,"もの"],[19,1,"もっと"],[21,2,"しんせい"],[24,2,"しんこう"],[27,1,"うえ"],[29,1,"みずか"],[32,1,"きず"],[34,1,"あ"],[37,2,"せいれい"],[43,1,"いの"]],"text":"しかし、愛する者たちよ。あなたがたは、最も神聖な信仰の上に自らを築き上げ、聖霊によって祈り、"},{"ref":"Jude.1.21","start":65001021,"end":65001021,"break":"none","ruby":[[0,1,"かみ"],[2,1,"あい"],[4,1,"なか"],[6,1,"みずか"],[9,1,"たも"],[12,2,"えいえん"],[19,1,"め"],[32,1,"しゅ"],[47,1,"ま"],[49,1,"のぞ"]],"text":"神の愛の中に自らを保ち、永遠のいのちを目あてとして、わたしたちの主イエス・キリストのあわれみを待ち望みなさい。"},{"ref":"Jude.1.22","start":65001022,"end":65001022,"break":"none","ruby":[[0,1,"うたが"],[6,2,"ひとびと"],[13,1,"かれ"]],"text":"疑いをいだく人々があれば、彼らをあわれみ、"},{"ref":"Jude.1.23","start":65001023,"end":65001023,"break":"none","ruby":[[0,1,"ひ"],[2,1,"なか"],[5,1,"ひ"],[7,1,"だ"],[10,1,"すく"],[27,1,"ひと"],[36,1,"こころ"],[53,1,"にく"],[55,1,"けが"],[58,1,"もの"],[60,1,"たい"],[67,2,"したぎ"],[72,1,"い"]],"text":"火の中から引き出して救ってやりなさい。また、そのほかの人たちを、おそれの心をもってあわれみなさい。しかし、肉に汚れた者に対しては、その下着さえも忌みきらいなさい。"},{"ref":"Jude.1.24","start":65001024,"end":65001024,"break":"paragraph","ruby":[[6,1,"まも"],[15,1,"もの"],[24,2,"えいこう"],[30,1,"きず"],[33,1,"もの"],[38,1,"よろこ"],[44,1,"た"],[48,1,"くだ"]],"text":"あなたがたを守ってつまずかない者とし、また、その栄光のまえに傷なき者として、喜びのうちに立たせて下さるかた、"},{"ref":"Jude.1.25","start":65001025,"end":65001025,"break":"none","ruby":[[11,2,"すくいぬし"],[15,2,"ゆいいつ"],[18,1,"かみ"],[21,2,"えいこう"],[24,2,"たいのう"],[27,1,"ちから"],[29,2,"けんい"],[39,1,"しゅ"],[53,2,"よよ"],[56,1,"はじ"],[61,1,"いま"],[67,2,"よよ"],[69,1,"かぎ"]],"text":"すなわち、わたしたちの救主なる唯一の神に、栄光、大能、力、権威が、わたしたちの主イエス・キリストによって、世々の初めにも、今も、また、世々限りなく、あるように、アァメン。"}]