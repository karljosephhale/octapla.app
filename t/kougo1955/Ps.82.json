[{"ref":"Ps.82.1","start":19082001,"end":19082001,"break":"paragraph","title":"アサフの歌","breaks":[[15,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かみ"],[4,2,"かいぎ"],[10,1,"た"],[15,1,"かみ"],[17,2,"かみがみ"],[28,1,"おこな"]],"titleRuby":[[4,1,"うた"]],"text":"神は神の会議のなかに立たれる。神は神々のなかで、さばきを行われる。"},{"ref":"Ps.82.2","start":19082002,"end":19082002,"break":"line","breaks":[[21,"line"]],"ruby":[[11,2,"ふせい"],[21,1,"あ"],[24,1,"もの"],[26,2,"こうい"],[29,1,"しめ"]],"text":"「あなたがたはいつまで不正なさばきをなし、悪しき者に好意を示すのか。〔セラ"},{"ref":"Ps.82.3","start":19082003,"end":19082003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"よわ"],[2,1,"もの"],[11,2,"こうへい"],[14,1,"あつか"],[17,1,"くる"],[20,1,"もの"],[22,1,"とぼ"],[25,1,"もの"],[27,2,"けんり"],[30,2,"ようご"]],"text":"弱い者と、みなしごとを公平に扱い、苦しむ者と乏しい者の権利を擁護せよ。"},{"ref":"Ps.82.4","start":19082004,"end":19082004,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"よわ"],[2,1,"もの"],[4,1,"まず"],[7,1,"もの"],[9,1,"すく"],[12,1,"かれ"],[15,1,"あ"],[18,1,"もの"],[20,1,"て"],[23,1,"たす"],[25,1,"だ"]],"text":"弱い者と貧しい者を救い、彼らを悪しき者の手から助け出せ」。"},{"ref":"Ps.82.5","start":19082005,"end":19082005,"break":"line","breaks":[[19,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[3,1,"し"],[10,1,"さと"],[19,1,"くら"],[21,1,"なか"],[28,1,"ち"],[35,1,"もとい"],[39,1,"うご"]],"text":"彼らは知ることなく、悟ることもなくて、暗き中をさまよう。地のもろもろの基はゆり動いた。"},{"ref":"Ps.82.6","start":19082006,"end":19082006,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"い"],[14,1,"かみ"],[23,1,"みな"],[26,1,"たか"],[28,1,"もの"],[30,1,"こ"]],"text":"わたしは言う、「あなたがたは神だ、あなたがたは皆いと高き者の子だ。"},{"ref":"Ps.82.7","start":19082007,"end":19082007,"break":"line","breaks":[[18,"line"]],"ruby":[[10,1,"ひと"],[15,1,"し"],[23,1,"きみ"],[32,1,"たお"]],"text":"しかし、あなたがたは人のように死に、もろもろの君のひとりのように倒れるであろう」。"},{"ref":"Ps.82.8","start":19082008,"end":19082008,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[3,1,"お"],[7,1,"ち"],[22,2,"くにたみ"]],"text":"神よ、起きて、地をさばいてください。すべての国民はあなたのものだからです。"}]