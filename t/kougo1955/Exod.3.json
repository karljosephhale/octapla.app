[{"ref":"Exod.3.1","start":2003001,"end":2003001,"break":"paragraph","ruby":[[4,1,"つま"],[6,1,"ちち"],[13,2,"さいし"],[19,1,"ひつじ"],[21,1,"む"],[24,1,"か"],[33,1,"む"],[36,2,"あらの"],[39,1,"おく"],[41,1,"みちび"],[45,1,"かみ"],[47,1,"やま"]],"text":"モーセは妻の父、ミデヤンの祭司エテロの羊の群れを飼っていたが、その群れを荒野の奥に導いて、神の山ホレブにきた。"},{"ref":"Exod.3.2","start":2003002,"end":2003002,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"つかい"],[11,1,"なか"],[13,1,"ほのお"],[18,1,"かれ"],[20,1,"あらわ"],[24,1,"かれ"],[26,1,"み"],[33,1,"ひ"],[35,1,"も"]],"text":"ときに主の使は、しばの中の炎のうちに彼に現れた。彼が見ると、しばは火に燃えているのに、そのしばはなくならなかった。"},{"ref":"Exod.3.3","start":2003003,"end":2003003,"break":"none","ruby":[[4,1,"い"],[9,1,"い"],[14,1,"おお"],[17,1,"み"],[21,1,"み"],[28,1,"も"],[38,1,"し"]],"text":"モーセは言った、「行ってこの大きな見ものを見、なぜしばが燃えてしまわないかを知ろう」。"},{"ref":"Exod.3.4","start":2003004,"end":2003004,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[6,2,"みさだめ"],[15,1,"み"],[17,1,"かみ"],[22,1,"なか"],[25,1,"かれ"],[27,1,"よ"],[43,1,"い"],[48,1,"かれ"],[59,1,"い"]],"text":"主は彼がきて見定ようとするのを見、神はしばの中から彼を呼んで、「モーセよ、モーセよ」と言われた。彼は「ここにいます」と言った。"},{"ref":"Exod.3.5","start":2003005,"end":2003005,"break":"none","ruby":[[0,1,"かみ"],[2,1,"い"],[11,1,"ちか"],[21,1,"あし"],[27,1,"ぬ"],[37,1,"た"],[44,2,"ばしょ"],[47,1,"せい"],[50,1,"ち"]],"text":"神は言われた、「ここに近づいてはいけない。足からくつを脱ぎなさい。あなたが立っているその場所は聖なる地だからである」。"},{"ref":"Exod.3.6","start":2003006,"end":2003006,"break":"none","ruby":[[2,1,"い"],[17,2,"せんぞ"],[20,1,"かみ"],[28,1,"かみ"],[34,1,"かみ"],[40,1,"かみ"],[50,1,"かみ"],[52,1,"み"],[57,1,"おそ"],[62,1,"かお"],[64,1,"かく"]],"text":"また言われた、「わたしは、あなたの先祖の神、アブラハムの神、イサクの神、ヤコブの神である」。モーセは神を見ることを恐れたので顔を隠した。"},{"ref":"Exod.3.7","start":2003007,"end":2003007,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"い"],[26,1,"たみ"],[28,1,"なや"],[36,1,"み"],[40,1,"お"],[42,1,"つか"],[44,1,"もの"],[49,1,"かれ"],[52,1,"さけ"],[56,1,"き"],[64,1,"かれ"],[67,1,"くる"],[71,1,"し"]],"text":"主はまた言われた、「わたしは、エジプトにいるわたしの民の悩みを、つぶさに見、また追い使う者のゆえに彼らの叫ぶのを聞いた。わたしは彼らの苦しみを知っている。"},{"ref":"Exod.3.8","start":2003008,"end":2003008,"break":"none","ruby":[[4,1,"くだ"],[8,1,"かれ"],[18,1,"て"],[21,1,"すく"],[23,1,"だ"],[31,1,"ち"],[34,1,"みちび"],[36,1,"のぼ"],[40,1,"よ"],[42,1,"ひろ"],[44,1,"ち"],[46,1,"ちち"],[48,1,"みつ"],[50,1,"なが"],[53,1,"ち"],[95,1,"ところ"],[97,1,"いた"]],"text":"わたしは下って、彼らをエジプトびとの手から救い出し、これをかの地から導き上って、良い広い地、乳と蜜の流れる地、すなわちカナンびと、ヘテびと、アモリびと、ペリジびと、ヒビびと、エブスびとのおる所に至らせようとしている。"},{"ref":"Exod.3.9","start":2003009,"end":2003009,"break":"none","ruby":[[8,2,"ひとびと"],[11,1,"さけ"],[18,1,"とど"],[35,1,"かれ"],[51,1,"み"]],"text":"いまイスラエルの人々の叫びがわたしに届いた。わたしはまたエジプトびとが彼らをしえたげる、そのしえたげを見た。"},{"ref":"Exod.3.10","start":2003010,"end":2003010,"break":"none","ruby":[[25,1,"たみ"],[33,2,"ひとびと"],[42,1,"みちび"],[44,1,"だ"]],"text":"さあ、わたしは、あなたをパロにつかわして、わたしの民、イスラエルの人々をエジプトから導き出させよう」。"},{"ref":"Exod.3.11","start":2003011,"end":2003011,"break":"none","ruby":[[4,1,"かみ"],[6,1,"い"],[20,2,"なにもの"],[38,1,"い"],[48,2,"ひとびと"],[57,1,"みちび"],[59,1,"だ"]],"text":"モーセは神に言った、「わたしは、いったい何者でしょう。わたしがパロのところへ行って、イスラエルの人々をエジプトから導き出すのでしょうか」。"},{"ref":"Exod.3.12","start":2003012,"end":2003012,"break":"none","ruby":[[0,1,"かみ"],[2,1,"い"],[12,1,"かなら"],[18,1,"とも"],[51,1,"たみ"],[59,1,"みちび"],[61,1,"だ"],[75,1,"やま"],[77,1,"かみ"],[79,1,"つか"]],"text":"神は言われた、「わたしは必ずあなたと共にいる。これが、わたしのあなたをつかわしたしるしである。あなたが民をエジプトから導き出したとき、あなたがたはこの山で神に仕えるであろう」。"},{"ref":"Exod.3.13","start":2003013,"end":2003013,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"い"],[21,2,"ひとびと"],[28,1,"い"],[32,1,"かれ"],[42,2,"せんぞ"],[45,1,"かみ"],[72,1,"い"],[77,1,"かれ"],[83,1,"な"],[100,1,"き"],[109,1,"こた"]],"text":"モーセは神に言った、「わたしがイスラエルの人々のところへ行って、彼らに『あなたがたの先祖の神が、わたしをあなたがたのところへつかわされました』と言うとき、彼らが『その名はなんというのですか』とわたしに聞くならば、なんと答えましょうか」。"},{"ref":"Exod.3.14","start":2003014,"end":2003014,"break":"none","ruby":[[0,1,"かみ"],[6,1,"い"],[17,1,"あ"],[20,1,"あ"],[22,1,"もの"],[27,1,"い"],[39,2,"ひとびと"],[44,1,"い"],[56,1,"あ"]],"text":"神はモーセに言われた、「わたしは、有って有る者」。また言われた、「イスラエルの人々にこう言いなさい、『「わたしは有る」というかたが、わたしをあなたがたのところへつかわされました』と」。"},{"ref":"Exod.3.15","start":2003015,"end":2003015,"break":"none","ruby":[[0,1,"かみ"],[8,1,"い"],[20,2,"ひとびと"],[25,1,"い"],[37,2,"せんぞ"],[40,1,"かみ"],[48,1,"かみ"],[54,1,"かみ"],[60,1,"かみ"],[64,1,"しゅ"],[95,2,"えいえん"],[102,1,"な"],[107,2,"よよ"],[114,1,"よ"],[116,1,"な"]],"text":"神はまたモーセに言われた、「イスラエルの人々にこう言いなさい『あなたがたの先祖の神、アブラハムの神、イサクの神、ヤコブの神である主が、わたしをあなたがたのところへつかわされました』と。これは永遠にわたしの名、これは世々のわたしの呼び名である。"},{"ref":"Exod.3.16","start":2003016,"end":2003016,"break":"none","ruby":[[4,1,"い"],[14,2,"ちょうろう"],[19,1,"あつ"],[22,1,"い"],[35,2,"せんぞ"],[38,1,"かみ"],[54,1,"かみ"],[58,1,"しゅ"],[65,1,"あらわ"],[68,1,"い"],[86,1,"かえり"],[105,1,"こと"],[107,1,"たし"],[110,1,"み"]],"text":"あなたは行って、イスラエルの長老たちを集めて言いなさい、『あなたがたの先祖の神、アブラハム、イサク、ヤコブの神である主は、わたしに現れて言われました、「わたしはあなたがたを顧み、あなたがたがエジプトでされている事を確かに見た。"},{"ref":"Exod.3.17","start":2003017,"end":2003017,"break":"none","ruby":[[19,1,"なや"],[23,1,"みちび"],[25,1,"だ"],[63,1,"ち"],[65,1,"ちち"],[67,1,"みつ"],[69,1,"なが"],[72,1,"ち"],[74,1,"たずさ"],[76,1,"のぼ"],[80,2,"けっしん"]],"text":"それでわたしはあなたがたを、エジプトの悩みから導き出して、カナンびと、ヘテびと、アモリびと、ペリジびと、ヒビびと、エブスびとの地、乳と蜜の流れる地へ携え上ろうと決心した」と』。"},{"ref":"Exod.3.18","start":2003018,"end":2003018,"break":"none","ruby":[[0,1,"かれ"],[7,1,"こえ"],[9,1,"き"],[11,1,"したが"],[28,2,"ちょうろう"],[33,2,"いっしょ"],[41,1,"おう"],[47,1,"い"],[50,1,"い"],[63,1,"かみ"],[65,1,"しゅ"],[73,1,"あらわ"],[93,1,"か"],[95,1,"みち"],[100,2,"あらの"],[103,1,"い"],[114,1,"かみ"],[116,1,"しゅ"],[118,2,"ぎせい"],[128,1,"ゆる"]],"text":"彼らはあなたの声に聞き従うであろう。あなたはイスラエルの長老たちと一緒にエジプトの王のところへ行って言いなさい、『ヘブルびとの神、主がわたしたちに現れられました。それで、わたしたちを、三日の道のりほど荒野に行かせて、わたしたちの神、主に犠牲をささげることを許してください』と。"},{"ref":"Exod.3.19","start":2003019,"end":2003019,"break":"none","ruby":[[9,1,"おう"],[11,1,"つよ"],[13,1,"て"],[18,1,"せま"],[31,1,"い"],[42,1,"し"]],"text":"しかし、エジプトの王は強い手をもって迫らなければ、あなたがたを行かせないのをわたしは知っている。"},{"ref":"Exod.3.20","start":2003020,"end":2003020,"break":"none","ruby":[[8,1,"て"],[10,1,"の"],[22,1,"おこな"],[34,3,"ふしぎ"],[46,1,"う"],[52,1,"のち"],[54,1,"かれ"],[62,1,"さ"]],"text":"それで、わたしは手を伸べて、エジプトのうちに行おうとする、さまざまの不思議をもってエジプトを打とう。その後に彼はあなたがたを去らせるであろう。"},{"ref":"Exod.3.21","start":2003021,"end":2003021,"break":"none","ruby":[[6,1,"たみ"],[15,2,"こうい"],[18,1,"え"],[29,1,"さ"],[38,1,"て"],[40,1,"さ"]],"text":"わたしはこの民にエジプトびとの好意を得させる。あなたがたは去るときに、むなし手で去ってはならない。"},{"ref":"Exod.3.22","start":2003022,"end":2003022,"break":"none","ruby":[[0,1,"おんな"],[7,1,"となり"],[9,1,"おんな"],[12,1,"いえ"],[14,1,"やど"],[19,1,"おんな"],[22,1,"ぎん"],[24,1,"かざ"],[27,1,"きん"],[29,1,"かざ"],[34,2,"いふく"],[37,1,"もと"],[61,1,"むすめ"],[63,1,"つ"],[86,1,"うば"],[88,1,"と"]],"text":"女はみな、その隣の女と、家に宿っている女に、銀の飾り、金の飾り、また衣服を求めなさい。そしてこれらを、あなたがたのむすこ、娘に着けさせなさい。このようにエジプトびとのものを奪い取りなさい」。"}]