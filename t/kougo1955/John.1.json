[{"ref":"John.1.1","start":43001001,"end":43001001,"break":"paragraph","ruby":[[0,1,"はじ"],[3,1,"ことば"],[9,1,"ことば"],[11,1,"かみ"],[13,1,"とも"],[19,1,"ことば"],[21,1,"かみ"]],"text":"初めに言があった。言は神と共にあった。言は神であった。"},{"ref":"John.1.2","start":43001002,"end":43001002,"break":"none","ruby":[[2,1,"ことば"],[4,1,"はじ"],[7,1,"かみ"],[9,1,"とも"]],"text":"この言は初めに神と共にあった。"},{"ref":"John.1.3","start":43001003,"end":43001003,"break":"none","text":"すべてのものは、これによってできた。できたもののうち、一つとしてこれによらないものはなかった。"},{"ref":"John.1.4","start":43001004,"end":43001004,"break":"none","ruby":[[2,1,"ことば"],[4,1,"いのち"],[15,1,"いのち"],[17,1,"ひと"],[19,1,"ひかり"]],"text":"この言に命があった。そしてこの命は人の光であった。"},{"ref":"John.1.5","start":43001005,"end":43001005,"break":"none","ruby":[[0,1,"ひかり"],[5,1,"なか"],[7,1,"かがや"],[23,1,"か"]],"text":"光はやみの中に輝いている。そして、やみはこれに勝たなかった。"},{"ref":"John.1.6","start":43001006,"end":43001006,"break":"paragraph","ruby":[[7,1,"ひと"],[13,1,"かみ"],[27,1,"な"],[33,1,"い"]],"text":"ここにひとりの人があって、神からつかわされていた。その名をヨハネと言った。"},{"ref":"John.1.7","start":43001007,"end":43001007,"break":"none","ruby":[[2,1,"ひと"],[14,1,"ひかり"],[25,1,"かれ"],[34,1,"ひと"],[36,1,"しん"]],"text":"この人はあかしのためにきた。光についてあかしをし、彼によってすべての人が信じるためである。"},{"ref":"John.1.8","start":43001008,"end":43001008,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ひかり"],[11,1,"ひかり"]],"text":"彼は光ではなく、ただ、光についてあかしをするためにきたのである。"},{"ref":"John.1.9","start":43001009,"end":43001009,"break":"paragraph","ruby":[[4,1,"ひと"],[6,1,"てら"],[12,1,"ひかり"],[18,1,"よ"]],"text":"すべての人を照すまことの光があって、世にきた。"},{"ref":"John.1.10","start":43001010,"end":43001010,"break":"none","ruby":[[0,1,"かれ"],[2,1,"よ"],[11,1,"よ"],[13,1,"かれ"],[27,1,"よ"],[29,1,"かれ"],[31,1,"し"]],"text":"彼は世にいた。そして、世は彼によってできたのであるが、世は彼を知らずにいた。"},{"ref":"John.1.11","start":43001011,"end":43001011,"break":"none","ruby":[[0,1,"かれ"],[2,2,"じぶん"],[14,2,"じぶん"],[17,1,"たみ"],[19,1,"かれ"],[21,1,"う"]],"text":"彼は自分のところにきたのに、自分の民は彼を受けいれなかった。"},{"ref":"John.1.12","start":43001012,"end":43001012,"break":"none","ruby":[[4,1,"かれ"],[6,1,"う"],[11,1,"もの"],[20,1,"な"],[22,1,"しん"],[25,2,"ひとびと"],[30,1,"かれ"],[32,1,"かみ"],[34,1,"こ"],[38,1,"ちから"],[40,1,"あた"]],"text":"しかし、彼を受けいれた者、すなわち、その名を信じた人々には、彼は神の子となる力を与えたのである。"},{"ref":"John.1.13","start":43001013,"end":43001013,"break":"none","ruby":[[4,1,"ひと"],[7,1,"ち"],[15,1,"にく"],[17,1,"よく"],[26,1,"ひと"],[28,1,"よく"],[37,1,"かみ"],[42,1,"うま"]],"text":"それらの人は、血すじによらず、肉の欲によらず、また、人の欲にもよらず、ただ神によって生れたのである。"},{"ref":"John.1.14","start":43001014,"end":43001014,"break":"paragraph","ruby":[[3,1,"ことば"],[5,2,"にくたい"],[20,1,"やど"],[32,2,"えいこう"],[35,1,"み"],[41,1,"ちち"],[46,1,"こ"],[51,2,"えいこう"],[67,1,"み"]],"text":"そして言は肉体となり、わたしたちのうちに宿った。わたしたちはその栄光を見た。それは父のひとり子としての栄光であって、めぐみとまこととに満ちていた。"},{"ref":"John.1.15","start":43001015,"end":43001015,"break":"none","ruby":[[4,1,"かれ"],[15,1,"さけ"],[18,1,"い"],[31,1,"く"],[59,1,"さき"],[76,1,"い"],[84,1,"ひと"]],"text":"ヨハネは彼についてあかしをし、叫んで言った、「『わたしのあとに来るかたは、わたしよりもすぐれたかたである。わたしよりも先におられたからである』とわたしが言ったのは、この人のことである」。"},{"ref":"John.1.16","start":43001016,"end":43001016,"break":"none","ruby":[[9,1,"もの"],[14,1,"み"],[16,1,"み"],[24,1,"なか"],[27,1,"う"],[39,1,"くわ"]],"text":"わたしたちすべての者は、その満ち満ちているものの中から受けて、めぐみにめぐみを加えられた。"},{"ref":"John.1.17","start":43001017,"end":43001017,"break":"none","ruby":[[0,2,"りっぽう"],[11,1,"あた"]],"text":"律法はモーセをとおして与えられ、めぐみとまこととは、イエス・キリストをとおしてきたのである。"},{"ref":"John.1.18","start":43001018,"end":43001018,"break":"none","ruby":[[0,1,"かみ"],[2,1,"み"],[4,1,"もの"],[18,1,"ちち"],[30,1,"こ"],[33,1,"かみ"],[38,1,"かみ"]],"text":"神を見た者はまだひとりもいない。ただ父のふところにいるひとり子なる神だけが、神をあらわしたのである。"},{"ref":"John.1.19","start":43001019,"end":43001019,"break":"paragraph","ruby":[[6,1,"じん"],[18,2,"さいし"],[25,1,"ひと"],[55,1,"と"],[63,1,"とき"],[68,1,"た"]],"text":"さて、ユダヤ人たちが、エルサレムから祭司たちやレビ人たちをヨハネのもとにつかわして、「あなたはどなたですか」と問わせたが、その時ヨハネが立てたあかしは、こうであった。"},{"ref":"John.1.20","start":43001020,"end":43001020,"break":"none","ruby":[[5,1,"かれ"],[7,2,"こくはく"],[11,1,"いな"],[30,2,"こくはく"]],"text":"すなわち、彼は告白して否まず、「わたしはキリストではない」と告白した。"},{"ref":"John.1.21","start":43001021,"end":43001021,"break":"none","ruby":[[4,1,"かれ"],[7,1,"と"],[38,1,"かれ"],[52,1,"い"],[62,3,"よげんしゃ"],[70,1,"かれ"],[78,1,"こた"]],"text":"そこで、彼らは問うた、「それでは、どなたなのですか、あなたはエリヤですか」。彼は「いや、そうではない」と言った。「では、あの預言者ですか」。彼は「いいえ」と答えた。"},{"ref":"John.1.22","start":43001022,"end":43001022,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[34,2,"ひとびと"],[38,1,"こたえ"],[40,1,"も"],[43,1,"い"],[61,2,"じしん"],[68,1,"かんが"]],"text":"そこで、彼らは言った、「あなたはどなたですか。わたしたちをつかわした人々に、答を持って行けるようにしていただきたい。あなた自身をだれだと考えるのですか」。"},{"ref":"John.1.23","start":43001023,"end":43001023,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[12,3,"よげんしゃ"],[19,1,"い"],[27,1,"しゅ"],[29,1,"みち"],[39,2,"あらの"],[42,1,"よ"],[46,1,"もの"],[48,1,"こえ"]],"text":"彼は言った、「わたしは、預言者イザヤが言ったように、『主の道をまっすぐにせよと荒野で呼ばわる者の声』である」。"},{"ref":"John.1.24","start":43001024,"end":43001024,"break":"paragraph","ruby":[[6,1,"ひと"],[15,1,"びと"]],"text":"つかわされた人たちは、パリサイ人であった。"},{"ref":"John.1.25","start":43001025,"end":43001025,"break":"none","ruby":[[0,1,"かれ"],[7,1,"と"],[10,1,"い"],[37,3,"よげんしゃ"],[56,1,"さづ"]],"text":"彼らはヨハネに問うて言った、「では、あなたがキリストでもエリヤでもまたあの預言者でもないのなら、なぜバプテスマを授けるのですか」。"},{"ref":"John.1.26","start":43001026,"end":43001026,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[10,1,"い"],[19,1,"みず"],[27,1,"さづ"],[38,1,"し"],[52,1,"なか"],[54,1,"た"]],"text":"ヨハネは彼らに答えて言った、「わたしは水でバプテスマを授けるが、あなたがたの知らないかたが、あなたがたの中に立っておられる。"},{"ref":"John.1.27","start":43001027,"end":43001027,"break":"none","ruby":[[19,1,"かた"],[31,1,"ひと"],[39,1,"と"],[41,1,"ね"]],"text":"それがわたしのあとにあとにおいでになる方であって、わたしはその人のくつのひもを解く値うちもない」。"},{"ref":"John.1.28","start":43001028,"end":43001028,"break":"none","ruby":[[18,1,"さづ"],[28,1,"む"]],"text":"これらのことは、ヨハネがバプテスマを授けていたヨルダンの向こうのベタニヤであったのである。"},{"ref":"John.1.29","start":43001029,"end":43001029,"break":"paragraph","ruby":[[2,2,"よくじつ"],[13,2,"じぶん"],[16,1,"ほう"],[24,1,"み"],[26,1,"い"],[31,1,"み"],[34,1,"よ"],[36,1,"つみ"],[38,1,"と"],[40,1,"のぞ"],[42,1,"かみ"],[44,2,"こひつじ"]],"text":"その翌日、ヨハネはイエスが自分の方にこられるのを見て言った、「見よ、世の罪を取り除く神の小羊。"},{"ref":"John.1.30","start":43001030,"end":43001030,"break":"none","ruby":[[8,1,"く"],[36,1,"さき"],[53,1,"い"],[61,1,"ひと"]],"text":"『わたしのあとに来るかたは、わたしよりもすぐれたかたである。わたしよりも先におられたからである』とわたしが言ったのは、この人のことである。"},{"ref":"John.1.31","start":43001031,"end":43001031,"break":"none","ruby":[[9,1,"し"],[31,1,"あらわ"],[54,1,"みず"],[62,1,"さづ"]],"text":"わたしはこのかたを知らなかった。しかし、このかたがイスラエルに現れてくださるそのことのために、わたしはきて、水でバプテスマを授けているのである」。"},{"ref":"John.1.32","start":43001032,"end":43001032,"break":"none","ruby":[[12,1,"い"],[22,2,"みたま"],[31,1,"てん"],[34,1,"くだ"],[38,1,"かれ"],[40,1,"うえ"],[48,1,"み"]],"text":"ヨハネはまたあかしをして言った、「わたしは、御霊がはとのように天から下って、彼の上にとどまるのを見た。"},{"ref":"John.1.33","start":43001033,"end":43001033,"break":"none","ruby":[[6,1,"ひと"],[8,1,"し"],[19,1,"みず"],[27,1,"さづ"],[58,1,"い"],[66,1,"ひと"],[68,1,"うえ"],[71,2,"みたま"],[74,1,"くだ"],[83,1,"み"],[89,1,"ひと"],[94,2,"みたま"],[106,1,"さづ"]],"text":"わたしはこの人を知らなかった。しかし、水でバプテスマを授けるようにと、わたしをおつかわしになったそのかたが、わたしに言われた、『ある人の上に、御霊が下ってとどまるのを見たら、その人こそは、御霊によってバプテスマを授けるかたである』。"},{"ref":"John.1.34","start":43001034,"end":43001034,"break":"none","ruby":[[7,1,"み"],[18,1,"かみ"],[20,1,"こ"]],"text":"わたしはそれを見たので、このかたこそ神の子であると、あかしをしたのである」。"},{"ref":"John.1.35","start":43001035,"end":43001035,"break":"paragraph","ruby":[[2,2,"よくじつ"],[15,2,"でし"],[20,2,"いっしょ"],[23,1,"た"]],"text":"その翌日、ヨハネはまたふたりの弟子たちと一緒に立っていたが、"},{"ref":"John.1.36","start":43001036,"end":43001036,"break":"none","ruby":[[4,1,"ある"],[13,1,"め"],[18,1,"い"],[23,1,"み"],[26,1,"かみ"],[28,2,"こひつじ"]],"text":"イエスが歩いておられるのに目をとめて言った、「見よ、神の小羊」。"},{"ref":"John.1.37","start":43001037,"end":43001037,"break":"none","ruby":[[6,2,"でし"],[16,1,"い"],[20,1,"き"],[31,1,"い"]],"text":"そのふたりの弟子は、ヨハネがそう言うのを聞いて、イエスについて行った。"},{"ref":"John.1.38","start":43001038,"end":43001038,"break":"none","ruby":[[6,1,"む"],[9,1,"かれ"],[19,1,"み"],[21,1,"い"],[27,1,"なに"],[29,1,"ねが"],[38,1,"かれ"],[41,1,"い"],[49,1,"やく"],[52,1,"い"],[56,2,"せんせい"]],"text":"イエスはふり向き、彼らがついてくるのを見て言われた、「何か願いがあるのか」。彼らは言った、「ラビ（訳して言えば、先生）どこにおとまりなのですか」。"},{"ref":"John.1.39","start":43001039,"end":43001039,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[38,1,"かれ"],[44,1,"い"],[52,1,"と"],[60,1,"ところ"],[62,1,"み"],[71,1,"ひ"],[81,1,"と"],[86,1,"とき"],[88,2,"ごご"],[91,1,"じ"]],"text":"イエスは彼らに言われた、「きてごらんなさい。そうしたらわかるだろう」。そこで彼らはついて行って、イエスの泊まっておられる所を見た。そして、その日はイエスのところに泊まった。時は午後四時ごろであった。"},{"ref":"John.1.40","start":43001040,"end":43001040,"break":"none","ruby":[[5,1,"き"],[16,1,"い"],[39,2,"きょうだい"]],"text":"ヨハネから聞いて、イエスについて行ったふたりのうちのひとりは、シモン・ペテロの兄弟アンデレであった。"},{"ref":"John.1.41","start":43001041,"end":43001041,"break":"none","ruby":[[0,1,"かれ"],[4,2,"じぶん"],[7,2,"きょうだい"],[13,2,"であ"],[17,1,"い"],[32,1,"やく"],[44,2,"であ"]],"text":"彼はまず自分の兄弟シモンに出会って言った、「わたしたちはメシヤ（訳せば、キリスト）にいま出会った」。"},{"ref":"John.1.42","start":43001042,"end":43001042,"break":"none","ruby":[[24,1,"かれ"],[26,1,"め"],[31,1,"い"],[45,1,"こ"],[60,1,"やく"],[69,1,"よ"]],"text":"そしてシモンをイエスのもとにつれてきた。イエスは彼に目をとめて言われた、「あなたはヨハネの子シモンである。あなたをケパ（訳せば、ペテロ）と呼ぶことにする」。"},{"ref":"John.1.43","start":43001043,"end":43001043,"break":"paragraph","ruby":[[2,2,"よくじつ"],[14,1,"い"],[27,2,"であ"],[31,1,"い"],[41,1,"したが"]],"text":"その翌日、イエスはガリラヤに行こうとされたが、ピリポに出会って言われた、「わたしに従ってきなさい」。"},{"ref":"John.1.44","start":43001044,"end":43001044,"break":"none","ruby":[[15,1,"まち"],[22,1,"ひと"]],"text":"ピリポは、アンデレとペテロとの町ベツサイダの人であった。"},{"ref":"John.1.45","start":43001045,"end":43001045,"break":"none","ruby":[[12,2,"であ"],[16,1,"い"],[32,2,"りっぽう"],[35,1,"なか"],[44,3,"よげんしゃ"],[56,1,"ひと"],[62,1,"こ"],[74,2,"であ"]],"text":"このピリポがナタナエルに出会って言った、「わたしたちは、モーセが律法の中にしるしており、預言者たちがしるしていた人、ヨセフの子、ナザレのイエスにいま出会った」。"},{"ref":"John.1.46","start":43001046,"end":43001046,"break":"none","ruby":[[6,1,"かれ"],[8,1,"い"],[27,1,"で"],[37,1,"かれ"],[39,1,"い"],[46,1,"み"]],"text":"ナタナエルは彼に言った、「ナザレから、なんのよいものが出ようか」。ピリポは彼に言った、「きて見なさい」。"},{"ref":"John.1.47","start":43001047,"end":43001047,"break":"none","ruby":[[10,2,"じぶん"],[13,1,"ほう"],[15,1,"く"],[19,1,"み"],[22,1,"かれ"],[27,1,"い"],[33,1,"み"],[38,1,"ひと"],[52,1,"びと"],[59,1,"こころ"],[62,1,"いつわ"]],"text":"イエスはナタナエルが自分の方に来るのを見て、彼について言われた、「見よ、あの人こそ、ほんとうのイスラエル人である。その心には偽りがない」。"},{"ref":"John.1.48","start":43001048,"end":43001048,"break":"none","ruby":[[6,1,"い"],[20,1,"ぞん"],[33,1,"こた"],[36,1,"い"],[50,1,"よ"],[52,1,"まえ"],[69,1,"き"],[71,1,"した"],[77,1,"み"]],"text":"ナタナエルは言った、「どうしてわたしをご存じなのですか」。イエスは答えて言われた、「ピリポがあなたを呼ぶ前に、わたしはあなたが、いちじくの木の下にいるのを見た」。"},{"ref":"John.1.49","start":43001049,"end":43001049,"break":"none","ruby":[[6,1,"こた"],[11,2,"せんせい"],[18,1,"かみ"],[20,1,"こ"],[34,1,"おう"]],"text":"ナタナエルは答えた、「先生、あなたは神の子です。あなたはイスラエルの王です」。"},{"ref":"John.1.50","start":43001050,"end":43001050,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[23,1,"き"],[25,1,"した"],[31,1,"み"],[39,1,"い"],[44,1,"しん"],[59,1,"おお"],[70,1,"み"]],"text":"イエスは答えて言われた、「あなたが、いちじくの木の下にいるのを見たと、わたしが言ったので信じるのか。これよりも、もっと大きなことを、あなたは見るであろう」。"},{"ref":"John.1.51","start":43001051,"end":43001051,"break":"none","ruby":[[2,1,"い"],[18,1,"い"],[24,1,"てん"],[26,1,"あ"],[30,1,"かみ"],[32,2,"みつかい"],[37,1,"ひと"],[39,1,"こ"],[41,1,"うえ"],[43,1,"のぼ"],[45,1,"くだ"],[58,1,"み"]],"text":"また言われた、「よくよくあなたがたに言っておく。天が開けて、神の御使たちが人の子の上に上り下りするのを、あなたがたは見るであろう」。"}]