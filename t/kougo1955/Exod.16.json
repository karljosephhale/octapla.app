[{"ref":"Exod.16.1","start":2016001,"end":2016001,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"ぜん"],[10,2,"かいしゅう"],[17,2,"しゅっぱつ"],[26,1,"ち"],[28,1,"で"],[32,1,"げつ"],[33,1,"め"],[37,1,"にち"],[49,1,"あいだ"],[56,2,"あらの"]],"text":"イスラエルの人々の全会衆はエリムを出発し、エジプトの地を出て二か月目の十五日に、エリムとシナイとの間にあるシンの荒野にきたが、"},{"ref":"Exod.16.2","start":2016002,"end":2016002,"break":"none","ruby":[[2,2,"あらの"],[11,2,"ひとびと"],[14,1,"ぜん"],[15,2,"かいしゅう"]],"text":"その荒野でイスラエルの人々の全会衆は、モーセとアロンにつぶやいた。"},{"ref":"Exod.16.3","start":2016003,"end":2016003,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"かれ"],[12,1,"い"],[27,1,"ち"],[30,1,"にく"],[40,1,"ざ"],[43,1,"あ"],[51,1,"た"],[56,1,"とき"],[59,1,"しゅ"],[61,1,"て"],[67,1,"し"],[73,1,"よ"],[92,2,"あらの"],[95,1,"みちび"],[97,1,"だ"],[101,1,"ぜん"],[102,2,"かいしゅう"],[105,2,"がし"]],"text":"イスラエルの人々は彼らに言った、「われわれはエジプトの地で、肉のなべのかたわらに座し、飽きるほどパンを食べていた時に、主の手にかかって死んでいたら良かった。あなたがたは、われわれをこの荒野に導き出して、全会衆を餓死させようとしている」。"},{"ref":"Exod.16.4","start":2016004,"end":2016004,"break":"paragraph","ruby":[[4,1,"しゅ"],[10,1,"い"],[16,1,"み"],[33,1,"てん"],[39,1,"ふ"],[45,1,"たみ"],[47,1,"で"],[49,2,"ひび"],[52,1,"ぶん"],[54,1,"ひ"],[58,1,"あつ"],[73,1,"かれ"],[80,2,"りっぽう"],[83,1,"したが"],[90,1,"こころ"]],"text":"そのとき主はモーセに言われた、「見よ、わたしはあなたがたのために、天からパンを降らせよう。民は出て日々の分を日ごとに集めなければならない。こうして彼らがわたしの律法に従うかどうかを試みよう。"},{"ref":"Exod.16.5","start":2016005,"end":2016005,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[6,1,"かれ"],[9,1,"と"],[11,1,"い"],[17,2,"ちょうり"],[26,1,"ひ"],[30,1,"あつ"],[37,1,"ばい"]],"text":"六日目には、彼らが取り入れたものを調理すると、それは日ごとに集めるものの二倍あるであろう」。"},{"ref":"Exod.16.6","start":2016006,"end":2016006,"break":"none","ruby":[[19,2,"ひとびと"],[22,1,"い"],[27,2,"ゆうぐれ"],[44,1,"ち"],[53,1,"みちび"],[55,1,"だ"],[62,1,"しゅ"],[69,1,"し"]],"text":"モーセとアロンは、イスラエルのすべての人々に言った、「夕暮には、あなたがたは、エジプトの地からあなたがたを導き出されたのが、主であることを知るであろう。"},{"ref":"Exod.16.7","start":2016007,"end":2016007,"break":"none","ruby":[[3,1,"あさ"],[13,1,"しゅ"],[15,2,"えいこう"],[18,1,"み"],[25,1,"しゅ"],[33,1,"しゅ"],[45,1,"き"],[71,2,"なにもの"]],"text":"また、朝には、あなたがたは主の栄光を見るであろう。主はあなたがたが主にむかってつぶやくのを聞かれたからである。あなたがたは、いったいわれわれを何者として、われわれにむかってつぶやくのか」。"},{"ref":"Exod.16.8","start":2016008,"end":2016008,"break":"none","ruby":[[6,1,"い"],[11,1,"しゅ"],[13,2,"ゆうぐれ"],[23,1,"にく"],[25,1,"あた"],[28,1,"た"],[33,1,"あさ"],[39,1,"あた"],[42,1,"あ"],[44,1,"た"],[55,1,"しゅ"],[64,1,"しゅ"],[79,1,"き"],[98,2,"なにもの"],[130,1,"しゅ"]],"text":"モーセはまた言った、「主は夕暮にはあなたがたに肉を与えて食べさせ、朝にはパンを与えて飽き足らせられるであろう。主はあなたがたが、主にむかってつぶやくつぶやきを聞かれたからである。いったいわれわれは何者なのか。あなたがたのつぶやくのは、われわれにむかってでなく、主にむかってである」。"},{"ref":"Exod.16.9","start":2016009,"end":2016009,"break":"paragraph","ruby":[[8,1,"い"],[19,2,"ひとびと"],[22,1,"ぜん"],[23,2,"かいしゅう"],[26,1,"い"],[39,1,"しゅ"],[41,1,"まえ"],[43,1,"ちか"],[50,1,"しゅ"],[63,1,"き"]],"text":"モーセはアロンに言った、「イスラエルの人々の全会衆に言いなさい、『あなたがたは主の前に近づきなさい。主があなたがたのつぶやきを聞かれたからである』と」。"},{"ref":"Exod.16.10","start":2016010,"end":2016010,"break":"none","ruby":[[13,2,"ひとびと"],[16,1,"ぜん"],[17,2,"かいしゅう"],[20,1,"かた"],[26,1,"かれ"],[29,2,"あらの"],[32,1,"ほう"],[34,1,"のぞ"],[38,1,"み"],[41,1,"しゅ"],[43,2,"えいこう"],[46,1,"くも"],[51,1,"あらわ"]],"text":"それでアロンがイスラエルの人々の全会衆に語ったとき、彼らが荒野の方を望むと、見よ、主の栄光が雲のうちに現れていた。"},{"ref":"Exod.16.11","start":2016011,"end":2016011,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Exod.16.12","start":2016012,"end":2016012,"break":"none","ruby":[[11,2,"ひとびと"],[19,1,"き"],[23,1,"かれ"],[26,1,"い"],[39,1,"ゆう"],[42,1,"にく"],[44,1,"た"],[47,1,"あさ"],[53,1,"あ"],[55,1,"た"],[77,1,"かみ"],[79,1,"しゅ"],[86,1,"し"]],"text":"「わたしはイスラエルの人々のつぶやきを聞いた。彼らに言いなさい、『あなたがたは夕には肉を食べ、朝にはパンに飽き足りるであろう。そうしてわたしがあなたがたの神、主であることを知るであろう』と」。"},{"ref":"Exod.16.13","start":2016013,"end":2016013,"break":"paragraph","ruby":[[0,1,"ゆう"],[11,1,"と"],[16,2,"しゅくえい"],[27,1,"あさ"],[33,2,"しゅくえい"],[36,2,"しゅうい"],[39,1,"つゆ"],[41,1,"ふ"]],"text":"夕べになると、うずらが飛んできて宿営をおおった。また、朝になると、宿営の周囲に露が降りた。"},{"ref":"Exod.16.14","start":2016014,"end":2016014,"break":"none","ruby":[[2,1,"ふ"],[5,1,"つゆ"],[12,2,"あらの"],[15,1,"めん"],[19,1,"うす"],[38,1,"ち"],[40,1,"むす"],[42,1,"うす"],[44,1,"しも"]],"text":"その降りた露がかわくと、荒野の面には、薄いうろこのようなものがあり、ちょうど地に結ぶ薄い霜のようであった。"},{"ref":"Exod.16.15","start":2016015,"end":2016015,"break":"none","ruby":[[6,2,"ひとびと"],[12,1,"み"],[14,1,"たがい"],[16,1,"い"],[32,1,"かれ"],[45,1,"し"],[61,1,"かれ"],[64,1,"い"],[72,1,"しゅ"],[80,2,"しょくもつ"],[85,1,"たま"]],"text":"イスラエルの人々はそれを見て互に言った、「これはなんであろう」。彼らはそれがなんであるのか知らなかったからである。モーセは彼らに言った、「これは主があなたがたの食物として賜わるパンである。"},{"ref":"Exod.16.16","start":2016016,"end":2016016,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"めい"],[29,1,"た"],[36,1,"したが"],[42,1,"あつ"],[51,2,"にんずう"],[54,1,"したが"],[74,2,"てんまく"],[88,1,"と"]],"text":"主が命じられるのはこうである、『あなたがたは、おのおのその食べるところに従ってそれを集め、あなたがたの人数に従って、ひとり一オメルずつ、おのおのその天幕におるもののためにそれを取りなさい』と」。"},{"ref":"Exod.16.17","start":2016017,"end":2016017,"break":"none","ruby":[[6,2,"ひとびと"],[19,1,"もの"],[21,1,"おお"],[26,1,"もの"],[28,1,"すく"],[31,1,"あつ"]],"text":"イスラエルの人々はそのようにして、ある者は多く、ある者は少なく集めた。"},{"ref":"Exod.16.18","start":2016018,"end":2016018,"break":"none","ruby":[[11,1,"はか"],[18,1,"おお"],[20,1,"あつ"],[23,1,"もの"],[26,1,"あま"],[30,1,"すく"],[33,1,"あつ"],[36,1,"もの"],[39,2,"ふそく"],[53,1,"た"],[60,1,"したが"],[63,1,"あつ"]],"text":"しかし、オメルでそれを計ってみると、多く集めた者にも余らず、少なく集めた者にも不足しなかった。おのおのその食べるところに従って集めていた。"},{"ref":"Exod.16.19","start":2016019,"end":2016019,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[15,1,"あさ"],[21,1,"のこ"]],"text":"モーセは彼らに言った、「だれも朝までそれを残しておいてはならない」。"},{"ref":"Exod.16.20","start":2016020,"end":2016020,"break":"none","ruby":[[3,1,"かれ"],[10,1,"き"],[12,1,"したが"],[20,1,"もの"],[22,1,"あさ"],[28,1,"のこ"],[36,1,"むし"],[41,1,"くさ"],[51,1,"かれ"],[58,1,"いか"]],"text":"しかし彼らはモーセに聞き従わないで、ある者は朝までそれを残しておいたが、虫がついて臭くなった。モーセは彼らにむかって怒った。"},{"ref":"Exod.16.21","start":2016021,"end":2016021,"break":"none","ruby":[[0,1,"かれ"],[10,1,"た"],[17,1,"したが"],[21,1,"あさ"],[28,1,"あつ"],[33,1,"ひ"],[35,1,"あつ"],[43,1,"と"]],"text":"彼らは、おのおのその食べるところに従って、朝ごとにそれを集めたが、日が熱くなるとそれは溶けた。"},{"ref":"Exod.16.22","start":2016022,"end":2016022,"break":"paragraph","ruby":[[1,1,"か"],[2,1,"め"],[6,1,"かれ"],[10,1,"ばい"],[28,1,"あつ"],[36,2,"かいしゅう"],[39,1,"ちょう"],[43,1,"みな"],[51,1,"つ"]],"text":"六日目には、彼らは二倍のパン、すなわちひとりに二オメルを集めた。そこで、会衆の長たちは皆きて、モーセに告げたが、"},{"ref":"Exod.16.23","start":2016023,"end":2016023,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[12,1,"しゅ"],[14,1,"かた"],[30,1,"しゅ"],[32,1,"せい"],[33,3,"あんそくにち"],[37,1,"やす"],[47,1,"や"],[56,1,"や"],[59,1,"に"],[68,1,"に"],[73,1,"のこ"],[81,1,"あさ"],[89,2,"ほぞん"]],"text":"モーセは彼らに言った、「主の語られたのはこうである、『あすは主の聖安息日で休みである。きょう、焼こうとするものを焼き、煮ようとするものを煮なさい。残ったものはみな朝までたくわえて保存しなさい』と」。"},{"ref":"Exod.16.24","start":2016024,"end":2016024,"break":"none","ruby":[[0,1,"かれ"],[7,1,"めい"],[17,1,"あさ"],[20,2,"ほぞん"],[26,1,"くさ"],[34,1,"むし"]],"text":"彼らはモーセの命じたように、それを朝まで保存したが、臭くならず、また虫もつかなかった。"},{"ref":"Exod.16.25","start":2016025,"end":2016025,"break":"none","ruby":[[4,1,"い"],[16,1,"た"],[26,1,"しゅ"],[28,3,"あんそくにち"],[41,1,"の"],[46,1,"え"]],"text":"モーセは言った、「きょう、それを食べなさい。きょうは主の安息日であるから、きょうは野でそれを獲られないであろう。"},{"ref":"Exod.16.26","start":2016026,"end":2016026,"break":"none","ruby":[[1,1,"か"],[3,1,"あいだ"],[8,1,"あつ"],[19,2,"なぬか"],[21,1,"め"],[23,3,"あんそくにち"],[34,1,"ひ"],[37,1,"な"]],"text":"六日の間はそれを集めなければならない。七日目は安息日であるから、その日には無いであろう」。"},{"ref":"Exod.16.27","start":2016027,"end":2016027,"break":"none","ruby":[[4,1,"たみ"],[11,2,"なぬか"],[13,1,"め"],[15,1,"で"],[17,1,"あつ"],[24,1,"もの"],[31,1,"え"]],"text":"ところが民のうちには、七日目に出て集めようとした者があったが、獲られなかった。"},{"ref":"Exod.16.28","start":2016028,"end":2016028,"break":"none","ruby":[[3,1,"しゅ"],[9,1,"い"],[30,1,"いまし"],[34,2,"りっぽう"],[38,1,"まも"],[43,1,"こば"]],"text":"そこで主はモーセに言われた、「あなたがたは、いつまでわたしの戒めと、律法とを守ることを拒むのか。"},{"ref":"Exod.16.29","start":2016029,"end":2016029,"break":"none","ruby":[[0,1,"み"],[3,1,"しゅ"],[11,3,"あんそくにち"],[15,1,"あた"],[25,1,"か"],[26,1,"め"],[33,1,"ぶん"],[44,1,"たま"],[58,1,"ところ"],[65,2,"なぬか"],[67,1,"め"],[72,1,"ところ"],[75,1,"で"]],"text":"見よ、主はあなたがたに安息日を与えられた。ゆえに六日目には、ふつか分のパンをあなたがたに賜わるのである。おのおのその所にとどまり、七日目にはその所から出てはならない」。"},{"ref":"Exod.16.30","start":2016030,"end":2016030,"break":"none","ruby":[[4,1,"たみ"],[6,2,"なぬか"],[8,1,"め"],[10,1,"やす"]],"text":"こうして民は七日目に休んだ。"},{"ref":"Exod.16.31","start":2016031,"end":2016031,"break":"paragraph","ruby":[[6,1,"いえ"],[10,1,"もの"],[12,1,"な"],[17,1,"よ"],[30,1,"み"],[35,1,"しろ"],[40,1,"あじ"],[42,1,"みつ"],[44,1,"い"]],"text":"イスラエルの家はその物の名をマナと呼んだ。それはコエンドロの実のようで白く、その味は蜜を入れたせんべいのようであった。"},{"ref":"Exod.16.32","start":2016032,"end":2016032,"break":"none","ruby":[[4,1,"い"],[9,1,"しゅ"],[11,1,"めい"],[39,2,"しそん"],[75,1,"ち"],[78,1,"みちび"],[80,1,"だ"],[83,1,"とき"],[85,2,"あらの"],[94,1,"た"],[102,1,"かれ"],[105,1,"み"]],"text":"モーセは言った、「主の命じられることはこうである、『それを一オメルあなたがたの子孫のためにたくわえておきなさい。それはわたしが、あなたがたをエジプトの地から導き出した時、荒野であなたがたに食べさせたパンを彼らに見させるためである』と」。"},{"ref":"Exod.16.33","start":2016033,"end":2016033,"break":"none","ruby":[[11,1,"い"],[21,1,"と"],[33,1,"なか"],[35,1,"い"],[41,1,"しゅ"],[43,1,"まえ"],[45,1,"お"],[49,2,"しそん"]],"text":"そしてモーセはアロンに言った「一つのつぼを取り、マナ一オメルをその中に入れ、それを主の前に置いて、子孫のためにたくわえなさい」。"},{"ref":"Exod.16.34","start":2016034,"end":2016034,"break":"none","ruby":[[3,1,"しゅ"],[9,1,"めい"],[29,1,"はこ"],[31,1,"まえ"],[33,1,"お"]],"text":"そこで主がモーセに命じられたように、アロンはそれをあかしの箱の前に置いてたくわえた。"},{"ref":"Exod.16.35","start":2016035,"end":2016035,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"ひと"],[11,1,"す"],[13,1,"ち"],[15,1,"つ"],[21,1,"ねん"],[23,1,"あいだ"],[27,1,"た"],[36,1,"かれ"],[43,1,"ち"],[45,1,"さかい"],[47,1,"いた"],[54,1,"た"]],"text":"イスラエルの人々は人の住む地に着くまで四十年の間マナを食べた。すなわち、彼らはカナンの地の境に至るまでマナを食べた。"},{"ref":"Exod.16.36","start":2016036,"end":2016036,"break":"none","ruby":[[10,1,"ぶん"]],"text":"一オメルは一エパの十分の一である。"}]