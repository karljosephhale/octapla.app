[{"ref":"1John.3.1","start":62003001,"end":62003001,"break":"paragraph","ruby":[[6,1,"かみ"],[8,1,"こ"],[10,1,"よ"],[23,1,"おお"],[26,1,"あい"],[28,1,"ちち"],[31,1,"たま"],[41,1,"かんが"],[59,1,"かみ"],[61,1,"こ"],[68,1,"よ"],[76,1,"し"],[83,1,"ちち"],[85,1,"し"]],"text":"わたしたちが神の子と呼ばれるためには、どんなに大きな愛を父から賜わったことか、よく考えてみなさい。わたしたちは、すでに神の子なのである。世がわたしたちを知らないのは、父を知らなかったからである。"},{"ref":"1John.3.2","start":62003002,"end":62003002,"break":"none","ruby":[[0,1,"あい"],[3,1,"もの"],[14,1,"いま"],[16,1,"かみ"],[18,1,"こ"],[42,1,"あき"],[50,1,"かれ"],[52,1,"あらわ"],[55,1,"とき"],[64,2,"じぶん"],[69,1,"かれ"],[71,1,"に"],[81,1,"し"],[93,2,"みすがた"],[96,1,"み"]],"text":"愛する者たちよ。わたしたちは今や神の子である。しかし、わたしたちがどうなるのか、まだ明らかではない。彼が現れる時、わたしたちは、自分たちが彼に似るものとなることを知っている。そのまことの御姿を見るからである。"},{"ref":"1John.3.3","start":62003003,"end":62003003,"break":"none","ruby":[[0,1,"かれ"],[7,1,"のぞ"],[16,1,"もの"],[18,1,"みな"],[20,1,"かれ"],[33,1,"みずか"]],"text":"彼についてこの望みをいだいている者は皆、彼がきよくあられるように、自らをきよくする。"},{"ref":"1John.3.4","start":62003004,"end":62003004,"break":"none","ruby":[[3,1,"つみ"],[5,1,"おか"],[7,1,"もの"],[10,2,"ふほう"],[13,1,"おこな"],[15,1,"もの"],[20,1,"つみ"],[22,2,"ふほう"]],"text":"すべて罪を犯す者は、不法を行う者である。罪は不法である。"},{"ref":"1John.3.5","start":62003005,"end":62003005,"break":"none","ruby":[[6,1,"し"],[15,1,"かれ"],[17,1,"つみ"],[21,1,"のぞ"],[26,1,"あらわ"],[35,1,"かれ"],[42,1,"つみ"]],"text":"あなたがたが知っているとおり、彼は罪をとり除くために現れたのであって、彼にはなんらの罪がない。"},{"ref":"1John.3.6","start":62003006,"end":62003006,"break":"none","ruby":[[3,1,"かれ"],[7,1,"もの"],[10,1,"つみ"],[12,1,"おか"],[20,1,"つみ"],[22,1,"おか"],[24,1,"もの"],[26,1,"かれ"],[28,1,"み"],[36,1,"し"],[44,1,"もの"]],"text":"すべて彼におる者は、罪を犯さない。すべて罪を犯す者は彼を見たこともなく、知ったこともない者である。"},{"ref":"1John.3.7","start":62003007,"end":62003007,"break":"none","ruby":[[0,1,"こ"],[9,1,"まど"],[20,1,"かれ"],[22,2,"ぎじん"],[28,2,"どうよう"],[32,1,"ぎ"],[34,1,"おこな"],[36,1,"もの"],[38,2,"ぎじん"]],"text":"子たちよ。だれにも惑わされてはならない。彼が義人であると同様に、義を行う者は義人である。"},{"ref":"1John.3.8","start":62003008,"end":62003008,"break":"none","ruby":[[0,1,"つみ"],[2,1,"おか"],[4,1,"もの"],[7,2,"あくま"],[11,1,"で"],[13,1,"もの"],[18,2,"あくま"],[21,1,"はじ"],[25,1,"つみ"],[27,1,"おか"],[38,1,"かみ"],[40,1,"こ"],[42,1,"あらわ"],[48,2,"あくま"],[54,1,"ほろ"]],"text":"罪を犯す者は、悪魔から出た者である。悪魔は初めから罪を犯しているからである。神の子が現れたのは、悪魔のわざを滅ぼしてしまうためである。"},{"ref":"1John.3.9","start":62003009,"end":62003009,"break":"none","ruby":[[3,1,"かみ"],[6,1,"うま"],[9,1,"もの"],[12,1,"つみ"],[14,1,"おか"],[19,1,"かみ"],[21,1,"たね"],[26,1,"ひと"],[49,1,"ひと"],[52,1,"かみ"],[55,1,"うま"],[58,1,"もの"],[65,1,"つみ"],[67,1,"おか"]],"text":"すべて神から生れた者は、罪を犯さない。神の種が、その人のうちにとどまっているからである。また、その人は、神から生れた者であるから、罪を犯すことができない。"},{"ref":"1John.3.10","start":62003010,"end":62003010,"break":"none","ruby":[[0,1,"かみ"],[2,1,"こ"],[4,2,"あくま"],[7,1,"こ"],[10,2,"くべつ"],[20,1,"あき"],[35,1,"ぎ"],[37,1,"おこな"],[41,1,"もの"],[44,1,"かみ"],[47,1,"で"],[49,1,"もの"],[55,2,"きょうだい"],[58,1,"あい"],[62,1,"もの"],[65,2,"どうよう"]],"text":"神の子と悪魔の子との区別は、これによって明らかである。すなわち、すべて義を行わない者は、神から出た者ではない。兄弟を愛さない者も、同様である。"},{"ref":"1John.3.11","start":62003011,"end":62003011,"break":"none","ruby":[[6,1,"たがい"],[8,1,"あい"],[10,1,"あ"],[28,1,"はじ"],[32,1,"き"]],"text":"わたしたちは互に愛し合うべきである。これが、あなたがたの初めから聞いていたおとずれである。"},{"ref":"1John.3.12","start":62003012,"end":62003012,"break":"none","ruby":[[16,1,"かれ"],[18,1,"あ"],[21,1,"もの"],[24,1,"で"],[29,2,"きょうだい"],[32,1,"ころ"],[42,2,"きょうだい"],[45,1,"ころ"],[51,1,"かれ"],[56,1,"わる"],[61,2,"きょうだい"],[67,1,"ただ"]],"text":"カインのようになってはいけない。彼は悪しき者から出て、その兄弟を殺したのである。なぜ兄弟を殺したのか。彼のわざが悪く、その兄弟のわざは正しかったからである。"},{"ref":"1John.3.13","start":62003013,"end":62003013,"break":"paragraph","ruby":[[0,2,"きょうだい"],[6,1,"よ"],[14,1,"にく"],[19,1,"おどろ"],[23,1,"およ"]],"text":"兄弟たちよ。世があなたがたを憎んでも、驚くには及ばない。"},{"ref":"1John.3.14","start":62003014,"end":62003014,"break":"none","ruby":[[7,2,"きょうだい"],[10,1,"あい"],[18,1,"し"],[25,1,"うつ"],[34,1,"し"],[40,1,"あい"],[44,1,"もの"],[47,1,"し"]],"text":"わたしたちは、兄弟を愛しているので、死からいのちへ移ってきたことを、知っている。愛さない者は、死のうちにとどまっている。"},{"ref":"1John.3.15","start":62003015,"end":62003015,"break":"none","ruby":[[6,1,"し"],[18,2,"きょうだい"],[21,1,"にく"],[23,1,"もの"],[25,2,"ひとごろ"],[32,2,"ひとごろ"],[45,2,"えいえん"]],"text":"あなたがたが知っているとおり、すべて兄弟を憎む者は人殺しであり、人殺しはすべて、そのうちに永遠のいのちをとどめてはいない。"},{"ref":"1John.3.16","start":62003016,"end":62003016,"break":"none","ruby":[[0,1,"しゅ"],[16,1,"す"],[19,1,"くだ"],[37,1,"あい"],[44,1,"し"],[63,2,"きょうだい"],[73,1,"す"]],"text":"主は、わたしたちのためにいのちを捨てて下さった。それによって、わたしたちは愛ということを知った。それゆえに、わたしたちもまた、兄弟のためにいのちを捨てるべきである。"},{"ref":"1John.3.17","start":62003017,"end":62003017,"break":"none","ruby":[[0,1,"よ"],[2,1,"とみ"],[4,1,"も"],[12,2,"きょうだい"],[15,1,"こま"],[22,1,"み"],[30,1,"こころ"],[32,1,"と"],[35,1,"もの"],[43,1,"かみ"],[45,1,"あい"],[48,1,"かれ"]],"text":"世の富を持っていながら、兄弟が困っているのを見て、あわれみの心を閉じる者には、どうして神の愛が、彼のうちにあろうか。"},{"ref":"1John.3.18","start":62003018,"end":62003018,"break":"none","ruby":[[0,1,"こ"],[11,2,"ことば"],[14,1,"くち"],[15,1,"さき"],[19,1,"あい"],[28,1,"おこな"],[31,2,"しんじつ"],[38,1,"あい"]],"text":"子たちよ。わたしたちは言葉や口先だけで愛するのではなく、行いと真実とをもって愛し合おうではないか。"},{"ref":"1John.3.19","start":62003019,"end":62003019,"break":"none","ruby":[[13,2,"しんり"],[17,1,"で"],[35,1,"かみ"],[41,1,"こころ"],[43,1,"やす"]],"text":"それによって、わたしたちが真理から出たものであることがわかる。そして、神のみまえに心を安んじていよう。"},{"ref":"1John.3.20","start":62003020,"end":62003020,"break":"none","ruby":[[14,1,"こころ"],[16,1,"せ"],[32,1,"かみ"],[40,1,"こころ"],[44,1,"おお"],[60,1,"ぞん"]],"text":"なぜなら、たといわたしたちの心に責められるようなことがあっても、神はわたしたちの心よりも大いなるかたであって、すべてをご存じだからである。"},{"ref":"1John.3.21","start":62003021,"end":62003021,"break":"none","ruby":[[0,1,"あい"],[3,1,"もの"],[10,1,"こころ"],[12,1,"せ"],[34,1,"かみ"],[36,1,"たい"],[39,2,"かくしん"],[42,1,"も"]],"text":"愛する者たちよ。もし心に責められるようなことがなければ、わたしたちは神に対して確信を持つことができる。"},{"ref":"1John.3.22","start":62003022,"end":62003022,"break":"none","ruby":[[4,1,"ねが"],[6,1,"もと"],[37,1,"かみ"],[39,1,"いまし"],[42,1,"まも"],[57,1,"おこな"]],"text":"そして、願い求めるものは、なんでもいただけるのである。それは、わたしたちが神の戒めを守り、みこころにかなうことを、行っているからである。"},{"ref":"1John.3.23","start":62003023,"end":62003023,"break":"none","ruby":[[2,1,"いまし"],[10,1,"かみ"],[12,1,"こ"],[22,2,"みな"],[25,1,"しん"],[34,1,"めい"],[43,1,"たがい"],[45,1,"あい"],[47,1,"あ"]],"text":"その戒めというのは、神の子イエス・キリストの御名を信じ、わたしたちに命じられたように、互に愛し合うべきことである。"},{"ref":"1John.3.24","start":62003024,"end":62003024,"break":"none","ruby":[[0,1,"かみ"],[2,1,"いまし"],[5,1,"まも"],[7,1,"ひと"],[10,1,"かみ"],[15,1,"かみ"],[21,1,"ひと"],[31,1,"かみ"],[49,1,"かみ"],[57,1,"たま"],[61,2,"みたま"],[67,1,"し"]],"text":"神の戒めを守る人は、神におり、神もまたその人にいます。そして、神がわたしたちのうちにいますことは、神がわたしたちに賜わった御霊によって知るのである。"}]