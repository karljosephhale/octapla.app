[{"ref":"2Cor.1.1","start":47001001,"end":47001001,"break":"paragraph","ruby":[[0,1,"かみ"],[2,2,"みむね"],[16,2,"しと"],[27,2,"きょうだい"],[43,1,"かみ"],[45,2,"きょうかい"],[55,2,"ぜんど"],[64,2,"せいと"]],"text":"神の御旨によりキリスト・イエスの使徒となったパウロと、兄弟テモテとから、コリントにある神の教会、ならびにアカヤ全土にいるすべての聖徒たちへ。"},{"ref":"2Cor.1.2","start":47001002,"end":47001002,"break":"paragraph","ruby":[[6,1,"ちち"],[9,1,"かみ"],[11,1,"しゅ"],[23,1,"めぐ"],[26,2,"へいあん"]],"text":"わたしたちの父なる神と主イエス・キリストから、恵みと平安とが、あなたがたにあるように。"},{"ref":"2Cor.1.3","start":47001003,"end":47001003,"break":"paragraph","ruby":[[13,1,"しゅ"],[23,1,"ちち"],[26,1,"かみ"],[32,1,"ぶか"],[34,1,"ちち"],[36,1,"なぐさ"],[39,1,"み"],[43,1,"かみ"]],"text":"ほむべきかな、わたしたちの主イエス・キリストの父なる神、あわれみ深き父、慰めに満ちたる神。"},{"ref":"2Cor.1.4","start":47001004,"end":47001004,"break":"none","ruby":[[0,1,"かみ"],[7,2,"かんなん"],[10,1,"なか"],[14,1,"とき"],[23,1,"なぐさ"],[26,1,"くだ"],[38,2,"じしん"],[42,1,"かみ"],[44,1,"なぐさ"],[53,1,"なぐさ"],[64,2,"かんなん"],[67,1,"なか"],[71,2,"ひとびと"],[74,1,"なぐさ"],[88,1,"くだ"]],"text":"神は、いかなる患難の中にいる時でもわたしたちを慰めて下さり、また、わたしたち自身も、神に慰めていただくその慰めをもって、あらゆる患難の中にある人々を慰めることができるようにして下さるのである。"},{"ref":"2Cor.1.5","start":47001005,"end":47001005,"break":"none","ruby":[[9,2,"くなん"],[18,1,"み"],[36,1,"う"],[39,1,"なぐさ"],[53,1,"み"]],"text":"それは、キリストの苦難がわたしたちに満ちあふれているように、わたしたちの受ける慰めもまた、キリストによって満ちあふれているからである。"},{"ref":"2Cor.1.6","start":47001006,"end":47001006,"break":"none","ruby":[[6,2,"かんなん"],[9,1,"あ"],[23,1,"なぐさ"],[26,1,"すくい"],[35,1,"なぐさ"],[38,1,"う"],[53,1,"なぐさ"],[65,1,"なぐさ"],[75,1,"う"],[82,1,"おな"],[84,2,"くなん"],[87,1,"た"],[92,1,"ちから"]],"text":"わたしたちが患難に会うなら、それはあなたがたの慰めと救とのためであり、慰めを受けるなら、それはあなたがたの慰めのためであって、その慰めは、わたしたちが受けているのと同じ苦難に耐えさせる力となるのである。"},{"ref":"2Cor.1.7","start":47001007,"end":47001007,"break":"none","ruby":[[10,1,"たい"],[25,1,"のぞ"],[29,1,"うご"],[50,1,"とも"],[52,2,"くなん"],[66,1,"なぐさ"],[70,1,"とも"],[82,1,"し"]],"text":"だから、あなたがたに対していだいているわたしたちの望みは、動くことがない。あなたがたが、わたしたちと共に苦難にあずかっているように、慰めにも共にあずかっていることを知っているからである。"},{"ref":"2Cor.1.8","start":47001008,"end":47001008,"break":"paragraph","ruby":[[0,2,"きょうだい"],[16,1,"あ"],[19,2,"かんなん"],[23,1,"し"],[43,2,"きょくど"],[47,1,"た"],[55,2,"あっぱく"],[61,1,"い"],[64,1,"のぞ"],[69,1,"うしな"]],"text":"兄弟たちよ。わたしたちがアジヤで会った患難を、知らずにいてもらいたくない。わたしたちは極度に、耐えられないほど圧迫されて、生きる望みをさえ失ってしまい、"},{"ref":"2Cor.1.9","start":47001009,"end":47001009,"break":"none","ruby":[[0,1,"こころ"],[5,1,"し"],[7,2,"かくご"],[11,2,"じぶん"],[13,2,"じしん"],[16,1,"たの"],[24,2,"しにん"],[34,1,"くだ"],[37,1,"かみ"],[39,1,"たの"],[45,1,"いた"]],"text":"心のうちで死を覚悟し、自分自身を頼みとしないで、死人をよみがえらせて下さる神を頼みとするに至った。"},{"ref":"2Cor.1.10","start":47001010,"end":47001010,"break":"none","ruby":[[0,1,"かみ"],[7,1,"し"],[9,2,"きけん"],[20,1,"すく"],[22,1,"だ"],[25,1,"くだ"],[32,1,"すく"],[34,1,"だ"],[37,1,"くだ"],[52,1,"かみ"],[54,2,"こんご"],[57,1,"すく"],[59,1,"だ"],[62,1,"くだ"],[68,1,"のぞ"]],"text":"神はこのような死の危険から、わたしたちを救い出して下さった、また救い出して下さるであろう。わたしたちは、神が今後も救い出して下さることを望んでいる。"},{"ref":"2Cor.1.11","start":47001011,"end":47001011,"break":"none","ruby":[[12,1,"いのり"],[30,1,"たす"],[44,1,"おお"],[47,2,"ひとびと"],[50,1,"ねが"],[61,1,"たま"],[65,1,"めぐ"],[72,1,"おお"],[75,1,"ひと"],[77,2,"かんしゃ"]],"text":"そして、あなたがたもまた祈をもって、ともどもに、わたしたちを助けてくれるであろう。これは多くの人々の願いによりわたしたちに賜わった恵みについて、多くの人が感謝をささげるようになるためである。"},{"ref":"2Cor.1.12","start":47001012,"end":47001012,"break":"paragraph","ruby":[[11,1,"よ"],[23,1,"たい"],[26,2,"にんげん"],[29,2,"ちえ"],[39,1,"かみ"],[41,1,"めぐ"],[48,1,"かみ"],[50,2,"しんせい"],[53,2,"しんじつ"],[60,2,"こうどう"],[70,1,"じつ"],[78,1,"ほこり"],[84,2,"りょうしん"]],"text":"さて、わたしたちがこの世で、ことにあなたがたに対し、人間の知恵によってではなく神の恵みによって、神の神聖と真実とによって行動してきたことは、実にわたしたちの誇であって、良心のあかしするところである。"},{"ref":"2Cor.1.13","start":47001013,"end":47001013,"break":"none","ruby":[[6,1,"か"],[21,1,"よ"],[24,2,"りかい"],[40,2,"かんぜん"],[43,2,"りかい"],[58,2,"きぼう"]],"text":"わたしたちが書いていることは、あなたがたが読んで理解できないことではない。それを完全に理解してくれるように、わたしは希望する。"},{"ref":"2Cor.1.14","start":47001014,"end":47001014,"break":"none","ruby":[[5,2,"ていど"],[13,2,"りかい"],[32,1,"しゅ"],[37,1,"ひ"],[53,1,"ほこり"],[73,1,"ほこり"]],"text":"すでにある程度わたしたちを理解してくれているとおり、わたしたちの主イエスの日には、あなたがたがわたしたちの誇であるように、わたしたちもあなたがたの誇なのである。"},{"ref":"2Cor.1.15","start":47001015,"end":47001015,"break":"paragraph","ruby":[[2,2,"かくしん"],[17,2,"いちど"],[19,1,"めぐ"],[22,1,"え"],[38,1,"ところ"],[40,1,"い"]],"text":"この確信をもって、わたしたちはもう一度恵みを得させたいので、まずあなたがたの所に行き、"},{"ref":"2Cor.1.16","start":47001016,"end":47001016,"break":"none","ruby":[[8,1,"とお"],[25,1,"ふたた"],[40,1,"ところ"],[42,1,"かえ"],[51,2,"みおく"],[55,1,"う"],[62,1,"ゆ"],[64,2,"けいかく"],[67,1,"た"]],"text":"それからそちらを通ってマケドニヤにおもむき、そして再びマケドニヤからあなたがたの所に帰り、あなたがたの見送りを受けてユダヤに行く計画を立てたのである。"},{"ref":"2Cor.1.17","start":47001017,"end":47001017,"break":"none","ruby":[[2,2,"けいかく"],[5,1,"た"],[11,2,"けいそつ"],[31,2,"じぶん"],[34,2,"けいかく"],[37,1,"にく"],[39,1,"おも"],[45,2,"けいかく"],[66,2,"どうじ"],[70,1,"いな"],[72,1,"いな"]],"text":"この計画を立てたのは、軽率なことであったであろうか。それとも、自分の計画を肉の思いによって計画したため、わたしの「しかり、しかり」が同時に「否、否」であったのだろうか。"},{"ref":"2Cor.1.18","start":47001018,"end":47001018,"break":"none","ruby":[[0,1,"かみ"],[2,2,"しんじつ"],[8,1,"い"],[18,1,"たい"],[25,2,"ことば"],[35,2,"どうじ"],[39,1,"いな"]],"text":"神の真実にかけて言うが、あなたがたに対するわたしの言葉は、「しかり」と同時に「否」というようなものではない。"},{"ref":"2Cor.1.19","start":47001019,"end":47001019,"break":"none","ruby":[[37,1,"の"],[39,1,"つた"],[42,1,"かみ"],[44,1,"こ"],[64,2,"どうじ"],[68,1,"いな"],[100,2,"じつげん"]],"text":"なぜなら、わたしたち、すなわち、わたしとシルワノとテモテとが、あなたがたに宣べ伝えた神の子キリスト・イエスは、「しかり」となると同時に「否」となったのではない。そうではなく、「しかり」がイエスにおいて実現されたのである。"},{"ref":"2Cor.1.20","start":47001020,"end":47001020,"break":"none","ruby":[[5,1,"かみ"],[7,2,"やくそく"],[16,1,"かれ"],[47,1,"かれ"],[59,1,"とな"],[63,1,"かみ"],[65,2,"えいこう"],[68,1,"き"]],"text":"なぜなら、神の約束はことごとく、彼において「しかり」となったからである。だから、わたしたちは、彼によって「アァメン」と唱えて、神に栄光を帰するのである。"},{"ref":"2Cor.1.21","start":47001021,"end":47001021,"break":"none","ruby":[[6,1,"とも"],[23,1,"かた"],[29,1,"あぶら"],[35,1,"くだ"],[42,1,"かみ"]],"text":"あなたがたと共にわたしたちを、キリストのうちに堅くささえ、油をそそいで下さったのは、神である。"},{"ref":"2Cor.1.22","start":47001022,"end":47001022,"break":"none","ruby":[[0,1,"かみ"],[11,2,"しょういん"],[19,2,"ほしょう"],[31,1,"こころ"],[33,2,"みたま"],[36,1,"たま"]],"text":"神はまた、わたしたちに証印をおし、その保証として、わたしたちの心に御霊を賜わったのである。"},{"ref":"2Cor.1.23","start":47001023,"end":47001023,"break":"paragraph","ruby":[[4,2,"じぶん"],[7,1,"たましい"],[12,1,"かみ"],[14,2,"しょうにん"],[17,1,"よ"],[19,1,"もと"],[22,1,"い"],[35,1,"い"],[51,1,"たい"],[54,2,"かんだい"]],"text":"わたしは自分の魂をかけ、神を証人に呼び求めて言うが、わたしがコリントに行かないでいるのは、あなたがたに対して寛大でありたいためである。"},{"ref":"2Cor.1.24","start":47001024,"end":47001024,"break":"none","ruby":[[13,2,"しんこう"],[16,2,"しはい"],[20,1,"もの"],[32,1,"よろこ"],[38,1,"とも"],[40,1,"はたら"],[45,1,"もの"],[59,2,"しんこう"],[62,1,"かた"],[64,1,"た"]],"text":"わたしたちは、あなたがたの信仰を支配する者ではなく、あなたがたの喜びのために共に働いている者にすぎない。あなたがたは、信仰に堅く立っているからである。"}]