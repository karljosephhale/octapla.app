[{"ref":"2Cor.8.1","start":47008001,"end":47008001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[22,1,"しょ"],[23,2,"きょうかい"],[26,1,"あた"],[31,1,"かみ"],[33,1,"めぐ"],[43,1,"し"]],"text":"兄弟たちよ。わたしたちはここで、マケドニヤの諸教会に与えられた神の恵みを、あなたがたに知らせよう。"},{"ref":"2Cor.8.2","start":47008002,"end":47008002,"break":"none","ruby":[[5,1,"かれ"],[9,2,"かんなん"],[15,1,"はげ"],[18,2,"しれん"],[28,1,"み"],[34,1,"よろこ"],[38,2,"きょくど"],[41,1,"まず"],[55,1,"で"],[57,1,"お"],[62,1,"ほどこ"],[64,1,"とみ"]],"text":"すなわち、彼らは、患難のために激しい試錬をうけたが、その満ちあふれる喜びは、極度の貧しさにもかかわらず、あふれ出て惜しみなく施す富となったのである。"},{"ref":"2Cor.8.3","start":47008003,"end":47008003,"break":"none","ruby":[[11,1,"かれ"],[14,1,"ちから"],[16,1,"おう"],[20,1,"いな"],[22,1,"ちから"],[23,2,"いじょう"],[26,1,"ほどこ"],[37,1,"みずか"],[39,1,"すす"]],"text":"わたしはあかしするが、彼らは力に応じて、否、力以上に施しをした。すなわち、自ら進んで、"},{"ref":"2Cor.8.4","start":47008004,"end":47008004,"break":"none","ruby":[[0,2,"せいと"],[6,2,"ほうし"],[9,1,"くわ"],[12,1,"めぐ"],[29,2,"ねっしん"],[32,1,"ねが"],[34,1,"で"]],"text":"聖徒たちへの奉仕に加わる恵みにあずかりたいと、わたしたちに熱心に願い出て、"},{"ref":"2Cor.8.5","start":47008005,"end":47008005,"break":"none","ruby":[[6,2,"きぼう"],[19,2,"じぶん"],[21,2,"じしん"],[27,1,"かみ"],[40,1,"しゅ"]],"text":"わたしたちの希望どおりにしたばかりか、自分自身をまず、神のみこころにしたがって、主にささげ、また、わたしたちにもささげたのである。"},{"ref":"2Cor.8.6","start":47008006,"end":47008006,"break":"none","ruby":[[6,2,"ぼきん"],[19,1,"ところ"],[25,1,"はじ"],[28,2,"いじょう"],[36,2,"かんせい"],[51,1,"かれ"],[53,1,"すす"]],"text":"そこで、この募金をテトスがあなたがたの所で、すでに始めた以上、またそれを完成するようにと、わたしたちは彼に勧めたのである。"},{"ref":"2Cor.8.7","start":47008007,"end":47008007,"break":"none","ruby":[[13,1,"こと"],[20,1,"と"],[34,2,"しんこう"],[38,2,"ことば"],[42,2,"ちしき"],[51,1,"ねつ"],[52,1,"じょう"],[65,1,"たい"],[74,1,"あい"],[77,1,"と"],[88,1,"めぐ"],[95,1,"と"]],"text":"さて、あなたがたがあらゆる事がらについて富んでいるように、すなわち、信仰にも言葉にも知識にも、あらゆる熱情にも、また、あなたがたに対するわたしたちの愛にも富んでいるように、この恵みのわざにも富んでほしい。"},{"ref":"2Cor.8.8","start":47008008,"end":47008008,"break":"none","ruby":[[2,1,"い"],[11,2,"めいれい"],[24,1,"た"],[26,1,"ひと"],[30,1,"ねつ"],[31,1,"じょう"],[43,1,"あい"],[45,2,"じゅんしん"]],"text":"こう言っても、わたしは命令するのではない。ただ、他の人たちの熱情によって、あなたがたの愛の純真さをためそうとするのである。"},{"ref":"2Cor.8.9","start":47008009,"end":47008009,"break":"none","ruby":[[13,1,"しゅ"],[23,1,"めぐ"],[26,1,"し"],[37,1,"しゅ"],[39,1,"と"],[58,1,"まず"],[77,1,"かれ"],[79,1,"まず"],[86,1,"と"],[88,1,"もの"]],"text":"あなたがたは、わたしたちの主イエス・キリストの恵みを知っている。すなわち、主は富んでおられたのに、あなたがたのために貧しくなられた。それは、あなたがたが、彼の貧しさによって富む者になるためである。"},{"ref":"2Cor.8.10","start":47008010,"end":47008010,"break":"none","ruby":[[11,1,"めぐ"],[20,2,"いけん"],[23,1,"の"],[37,1,"えき"],[55,1,"こと"],[58,2,"さくねん"],[60,2,"いらい"],[63,1,"ほか"],[65,1,"さき"],[69,2,"じっこう"],[84,1,"ねが"]],"text":"そこで、わたしは、この恵みのわざについて意見を述べよう。それがあなたがたの益になるからである。あなたがたはこの事を、昨年以来、他に先んじて実行したばかりではなく、それを願っていた。"},{"ref":"2Cor.8.11","start":47008011,"end":47008011,"break":"none","ruby":[[3,1,"いま"],[22,1,"こころ"],[25,1,"ねが"],[34,1,"も"],[43,1,"おう"]],"text":"だから今、それをやりとげなさい。あなたがたが心から願っているように、持っているところに応じて、それをやりとげなさい。"},{"ref":"2Cor.8.12","start":47008012,"end":47008012,"break":"none","ruby":[[2,1,"こころ"],[5,1,"ねが"],[15,1,"も"],[27,1,"も"],[40,1,"かみ"],[42,1,"う"]],"text":"もし心から願ってそうするなら、持たないところによらず、持っているところによって、神に受けいれられるのである。"},{"ref":"2Cor.8.13","start":47008013,"end":47008013,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"らく"],[22,2,"くろう"],[38,1,"も"],[40,1,"もの"],[42,1,"ひと"]],"text":"それは、ほかの人々に楽をさせて、あなたがたに苦労をさせようとするのではなく、持ち物を等しくするためである。"},{"ref":"2Cor.8.14","start":47008014,"end":47008014,"break":"none","ruby":[[5,1,"いま"],[7,2,"ばあい"],[17,2,"よゆう"],[22,1,"ひと"],[26,2,"けつぼう"],[29,1,"おぎな"],[32,1,"のち"],[36,1,"かれ"],[39,2,"よゆう"],[48,2,"けつぼう"],[51,1,"おぎな"],[58,1,"ひと"]],"text":"すなわち、今の場合は、あなたがたの余裕があの人たちの欠乏を補い、後には、彼らの余裕があなたがたの欠乏を補い、こうして等しくなるようにするのである。"},{"ref":"2Cor.8.15","start":47008015,"end":47008015,"break":"none","ruby":[[4,1,"おお"],[6,1,"え"],[8,1,"もの"],[10,1,"あま"],[18,1,"すこ"],[22,1,"え"],[27,1,"もの"],[29,1,"た"],[42,1,"か"]],"text":"それは「多く得た者も余ることがなく、少ししか得なかった者も足りないことはなかった」と書いてあるとおりである。"},{"ref":"2Cor.8.16","start":47008016,"end":47008016,"break":"paragraph","ruby":[[10,1,"たい"],[13,1,"も"],[18,1,"おな"],[20,1,"ねつ"],[21,1,"じょう"],[28,1,"こころ"],[31,1,"あた"],[34,1,"くだ"],[38,1,"かみ"],[40,2,"かんしゃ"]],"text":"わたしがあなたがたに対して持っている同じ熱情を、テトスの心にも与えて下さった神に感謝する。"},{"ref":"2Cor.8.17","start":47008017,"end":47008017,"break":"none","ruby":[[0,1,"かれ"],[6,1,"すす"],[9,1,"う"],[17,1,"さら"],[19,2,"ねっしん"],[26,2,"じぶん"],[30,1,"すす"],[43,1,"い"]],"text":"彼はわたしの勧めを受けいれ、そして更に熱心になって、自分から進んであなたがたのところに行った。"},{"ref":"2Cor.8.18","start":47008018,"end":47008018,"break":"none","ruby":[[13,2,"いっしょ"],[21,2,"きょうだい"],[24,1,"おく"],[29,2,"きょうだい"],[32,2,"ふくいん"],[34,2,"せんでん"],[37,1,"うえ"],[39,1,"え"],[50,2,"きょうかい"],[53,1,"きこ"]],"text":"わたしたちはまた、テトスと一緒に、ひとりの兄弟を送る。この兄弟が福音宣伝の上で得たほまれは、すべての教会に聞えているが、"},{"ref":"2Cor.8.19","start":47008019,"end":47008019,"break":"none","ruby":[[5,1,"かれ"],[8,1,"しゅ"],[10,2,"じしん"],[13,2,"えいこう"],[33,2,"こうい"],[36,1,"しめ"],[42,1,"ほね"],[44,1,"お"],[47,1,"おく"],[49,1,"もの"],[51,1,"あつ"],[62,3,"どうはんしゃ"],[69,1,"しょ"],[70,2,"きょうかい"],[74,1,"えら"]],"text":"そのうえ、彼は、主ご自身の栄光があらわれるため、また、わたしたちの好意を示すために、骨を折って贈り物を集めているわたしたちの同伴者として、諸教会から選ばれたのである。"},{"ref":"2Cor.8.20","start":47008020,"end":47008020,"break":"none","ruby":[[13,1,"あつ"],[20,2,"きふ"],[22,1,"きん"],[31,1,"ひと"],[37,1,"い"],[43,1,"さ"]],"text":"そうしたのは、わたしたちが集めているこの寄附金のことについて、人にかれこれ言われるのを避けるためである。"},{"ref":"2Cor.8.21","start":47008021,"end":47008021,"break":"none","ruby":[[7,1,"しゅ"],[20,1,"ひと"],[22,1,"まえ"],[25,2,"こうせい"],[34,1,"き"],[36,1,"くば"]],"text":"わたしたちは、主のみまえばかりではなく、人の前でも公正であるように、気を配っているのである。"},{"ref":"2Cor.8.22","start":47008022,"end":47008022,"break":"none","ruby":[[9,2,"きょうだい"],[12,1,"かれ"],[15,2,"いっしょ"],[18,1,"おく"],[28,1,"おお"],[31,1,"こと"],[36,1,"かれ"],[38,2,"ねっしん"],[52,1,"みと"],[56,1,"かれ"],[58,1,"いま"],[66,2,"ひじょう"],[69,2,"しんらい"],[78,2,"ねっしん"]],"text":"また、もうひとりの兄弟を彼らと一緒に送る。わたしたちは、多くの事について彼が熱心であったことを、たびたび認めた。彼は今、あなたがたを非常に信頼して、ますます熱心になっている。"},{"ref":"2Cor.8.23","start":47008023,"end":47008023,"break":"none","ruby":[[7,1,"い"],[11,1,"かれ"],[17,2,"なかま"],[29,1,"たい"],[36,3,"きょうりょくしゃ"],[45,2,"きょうだい"],[53,1,"い"],[57,1,"かれ"],[60,1,"しょ"],[61,2,"きょうかい"],[64,2,"ししゃ"],[72,2,"えいこう"]],"text":"テトスについて言えば、彼はわたしの仲間であり、あなたがたに対するわたしの協力者である。この兄弟たちについて言えば、彼らは諸教会の使者、キリストの栄光である。"},{"ref":"2Cor.8.24","start":47008024,"end":47008024,"break":"none","ruby":[[10,1,"あい"],[37,1,"ほこり"],[41,2,"しんじつ"],[50,1,"しょ"],[51,2,"きょうかい"],[54,1,"まえ"],[56,1,"かれ"]],"text":"だから、あなたがたの愛と、また、あなたがたについてわたしたちがいだいている誇とが、真実であることを、諸教会の前で彼らにあかししていただきたい。"}]