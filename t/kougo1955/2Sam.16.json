[{"ref":"2Sam.16.1","start":10016001,"end":10016001,"break":"paragraph","ruby":[[4,1,"やま"],[6,1,"いただき"],[8,1,"す"],[15,1,"い"],[18,1,"とき"],[36,1,"お"],[40,1,"とう"],[45,1,"ひ"],[50,1,"うえ"],[56,1,"こ"],[58,1,"ほし"],[66,1,"なつ"],[78,1,"しゅ"],[80,1,"ふくろ"],[82,1,"の"],[91,1,"むか"]],"text":"ダビデが山の頂を過ぎて、すこし行った時、メピボセテのしもべヂバは、くらを置いた二頭のろばを引き、その上にパン二百個、干ぶどう百ふさ、夏のくだもの一百、ぶどう酒一袋を載せてきてダビデを迎えた。"},{"ref":"2Sam.16.2","start":10016002,"end":10016002,"break":"none","ruby":[[0,1,"おう"],[5,1,"い"],[25,1,"も"],[39,1,"こた"],[47,1,"おう"],[49,2,"かぞく"],[52,1,"の"],[60,1,"なつ"],[67,2,"わかもの"],[72,1,"た"],[81,1,"しゅ"],[83,2,"あらの"],[86,1,"よわ"],[89,1,"もの"],[91,1,"の"]],"text":"王はヂバに言った、「あなたはどうしてこれらのものを持ってきたのですか」。ヂバは答えた、「ろばは王の家族が乗るため、パンと夏のくだものは若者たちが食べるため、ぶどう酒は荒野で弱った者が飲むためです」。"},{"ref":"2Sam.16.3","start":10016003,"end":10016003,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[11,2,"しゅじん"],[14,1,"こ"],[30,1,"おう"],[32,1,"い"],[52,1,"かれ"],[62,1,"いえ"],[72,1,"ちち"],[74,1,"くに"],[80,1,"かえ"],[88,1,"おも"]],"text":"王は言った、「あなたの主人の子はどこにおるのですか」。ヂバは王に言った、「エルサレムにとどまっています。彼は、『イスラエルの家はきょう、わたしの父の国をわたしに返すであろう』と思ったのです」。"},{"ref":"2Sam.16.4","start":10016004,"end":10016004,"break":"none","ruby":[[0,1,"おう"],[5,1,"い"],[10,1,"み"],[40,1,"い"],[49,2,"けいい"],[52,1,"あらわ"],[59,1,"しゅ"],[61,1,"おう"],[68,1,"まえ"],[75,1,"めぐ"],[78,1,"え"]],"text":"王はヂバに言った、「見よ、メピボセテのものはことごとくあなたのものです」。ヂバは言った、「わたしは敬意を表します。わが主、王よ、あなたの前にいつまでも恵みを得させてください」。"},{"ref":"2Sam.16.5","start":10016005,"end":10016005,"break":"paragraph","ruby":[[3,1,"おう"],[12,1,"とき"],[18,1,"いえ"],[20,2,"いちぞく"],[23,1,"もの"],[32,1,"で"],[39,1,"な"],[51,1,"こ"],[56,1,"かれ"],[58,1,"で"],[64,1,"た"]],"text":"ダビデ王がバホリムにきた時、サウルの家の一族の者がひとりそこから出てきた。その名をシメイといい、ゲラの子である。彼は出てきながら絶えずのろった。"},{"ref":"2Sam.16.6","start":10016006,"end":10016006,"break":"none","ruby":[[3,1,"かれ"],[12,1,"おう"],[19,2,"けらい"],[22,1,"む"],[26,1,"いし"],[28,1,"な"],[34,1,"とき"],[36,1,"たみ"],[38,2,"ゆうし"],[45,1,"おう"],[47,2,"さゆう"]],"text":"そして彼はダビデとダビデ王のもろもろの家来に向かって石を投げた。その時、民と勇士たちはみな王の左右にいた。"},{"ref":"2Sam.16.7","start":10016007,"end":10016007,"break":"none","ruby":[[7,1,"とき"],[11,1,"い"],[16,1,"ち"],[18,1,"なが"],[20,1,"ひと"],[28,1,"ひと"],[31,1,"た"],[33,1,"さ"],[36,1,"た"],[38,1,"さ"]],"text":"シメイはのろう時にこう言った、「血を流す人よ、よこしまな人よ、立ち去れ、立ち去れ。"},{"ref":"2Sam.16.8","start":10016008,"end":10016008,"break":"none","ruby":[[4,1,"かわ"],[7,1,"おう"],[16,1,"いえ"],[18,1,"ち"],[23,1,"しゅ"],[29,1,"むく"],[37,1,"しゅ"],[39,2,"おうこく"],[46,1,"こ"],[53,1,"て"],[55,1,"わた"],[60,1,"み"],[67,1,"ち"],[69,1,"なが"],[71,1,"ひと"],[76,1,"わざわい"],[78,1,"あ"]],"text":"あなたが代って王となったサウルの家の血をすべて主があなたに報いられたのだ。主は王国をあなたの子アブサロムの手に渡された。見よ、あなたは血を流す人だから、災に会うのだ」。"},{"ref":"2Sam.16.9","start":10016009,"end":10016009,"break":"paragraph","ruby":[[0,1,"とき"],[6,1,"こ"],[13,1,"おう"],[15,1,"い"],[22,1,"し"],[25,1,"いぬ"],[33,1,"しゅ"],[35,1,"おう"],[52,1,"い"],[55,1,"かれ"],[57,1,"くび"],[59,1,"と"]],"text":"時にゼルヤの子アビシャイは王に言った、「この死んだ犬がどうしてわが主、王をのろってよかろうか。わたしに、行って彼の首を取らせてください」。"},{"ref":"2Sam.16.10","start":10016010,"end":10016010,"break":"none","ruby":[[3,1,"おう"],[5,1,"い"],[14,1,"こ"],[39,1,"かれ"],[47,1,"しゅ"],[49,1,"かれ"],[62,1,"い"],[101,1,"い"]],"text":"しかし王は言った、「ゼルヤの子たちよ、あなたがたと、なんのかかわりがあるのか。彼がのろうのは、主が彼に、『ダビデをのろえ』と言われたからであるならば、だれが、『あなたはどうしてこういうことをするのか』と言ってよいであろうか」。"},{"ref":"2Sam.16.11","start":10016011,"end":10016011,"break":"none","ruby":[[12,2,"じぶん"],[19,2,"けらい"],[23,1,"い"],[32,1,"み"],[35,1,"で"],[39,1,"こ"],[45,1,"いのち"],[47,1,"もと"],[53,1,"いま"],[74,1,"かれ"],[76,1,"ゆる"],[90,1,"しゅ"],[92,1,"かれ"],[94,1,"めい"]],"text":"ダビデはまたアビシャイと自分のすべての家来とに言った、「わたしの身から出たわが子がわたしの命を求めている。今、このベニヤミンびととしてはなおさらだ。彼を許してのろわせておきなさい。主が彼に命じられたのだ。"},{"ref":"2Sam.16.12","start":10016012,"end":10016012,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"なや"],[9,1,"かえり"],[25,1,"しゅ"],[30,1,"かれ"],[44,1,"ぜん"],[46,1,"むく"],[55,1,"し"]],"text":"主はわたしの悩みを顧みてくださるかもしれない。また主はきょう彼ののろいにかえて、わたしに善を報いてくださるかも知れない」。"},{"ref":"2Sam.16.13","start":10016013,"end":10016013,"break":"none","ruby":[[10,2,"じゅうしゃ"],[16,1,"みち"],[18,1,"い"],[31,1,"なら"],[34,1,"む"],[38,1,"やま"],[40,2,"ちゅうふく"],[43,1,"い"],[46,1,"い"],[57,1,"かれ"],[59,1,"む"],[63,1,"いし"],[69,1,"な"]],"text":"こうしてダビデとその従者たちとは道を行ったが、シメイはダビデに並んで向かいの山の中腹を行き、行きながらのろい、また彼に向かって石や、ちりを投げつけた。"},{"ref":"2Sam.16.14","start":10016014,"end":10016014,"break":"none","ruby":[[0,1,"おう"],[4,1,"とも"],[8,1,"たみ"],[12,1,"つか"],[20,1,"つ"],[23,1,"かれ"],[27,1,"ところ"],[29,1,"いき"]],"text":"王および共にいる民はみな疲れてヨルダンに着き、彼はその所で息をついだ。"},{"ref":"2Sam.16.15","start":10016015,"end":10016015,"break":"paragraph","ruby":[[12,1,"たみ"],[20,2,"ひとびと"],[44,1,"とも"]],"text":"さてアブサロムとすべての民、イスラエルの人々はエルサレムにきた。アヒトペルもアブサロムと共にいた。"},{"ref":"2Sam.16.16","start":10016016,"end":10016016,"break":"none","ruby":[[4,1,"とも"],[29,1,"とき"],[43,1,"おう"],[44,2,"ばんざい"],[47,1,"おう"],[48,2,"ばんざい"],[52,1,"い"]],"text":"ダビデの友であるアルキびとホシャイがアブサロムのもとにきた時、ホシャイはアブサロムに「王万歳、王万歳」と言った。"},{"ref":"2Sam.16.17","start":10016017,"end":10016017,"break":"none","ruby":[[11,1,"い"],[25,1,"とも"],[27,1,"しめ"],[29,2,"しんじつ"],[47,1,"とも"],[49,2,"いっしょ"],[52,1,"い"]],"text":"アブサロムはホシャイに言った、「これはあなたがその友に示す真実なのか。あなたはどうしてあなたの友と一緒に行かなかったのか」。"},{"ref":"2Sam.16.18","start":10016018,"end":10016018,"break":"none","ruby":[[11,1,"い"],[20,1,"しゅ"],[24,1,"たみ"],[36,2,"ひとびと"],[39,1,"えら"],[42,1,"もの"],[48,1,"ぞく"],[55,1,"ひと"],[57,2,"いっしょ"]],"text":"ホシャイはアブサロムに言った、「いいえ、主とこの民とイスラエルのすべての人々が選んだ者にわたしは属し、かつその人と一緒におります。"},{"ref":"2Sam.16.19","start":10016019,"end":10016019,"break":"none","ruby":[[11,1,"つか"],[22,1,"こ"],[24,1,"まえ"],[26,1,"つか"],[44,1,"ちち"],[46,1,"まえ"],[48,1,"つか"],[63,1,"まえ"],[65,1,"つか"]],"text":"かつまたわたしはだれに仕えるべきですか。その子の前に仕えるべきではありませんか。あなたの父の前に仕えたように、わたしはあなたの前に仕えます」。"},{"ref":"2Sam.16.20","start":10016020,"end":10016020,"break":"paragraph","ruby":[[15,1,"い"],[42,1,"はか"],[47,1,"の"]],"text":"そこでアブサロムはアヒトペルに言った、「あなたがたは、われわれがどうしたらよいのか、計りごとを述べなさい」。"},{"ref":"2Sam.16.21","start":10016021,"end":10016021,"break":"none","ruby":[[12,1,"い"],[21,1,"ちち"],[23,1,"いえ"],[25,1,"まも"],[30,1,"のこ"],[41,1,"ところ"],[61,1,"みな"],[66,2,"ちちうえ"],[69,1,"にく"],[76,1,"き"],[90,2,"いっしょ"],[95,1,"もの"],[97,1,"て"],[99,1,"つよ"]],"text":"アヒトペルはアブサロムに言った、「あなたの父が家を守るために残された、めかけたちの所にはいりなさい。そうすればイスラエルは皆あなたが父上に憎まれることを聞くでしょう。そしてあなたと一緒にいる者の手は強くなるでしょう」。"},{"ref":"2Sam.16.22","start":10016022,"end":10016022,"break":"none","ruby":[[4,1,"かれ"],[16,2,"おくじょう"],[19,2,"てんまく"],[22,1,"は"],[34,1,"ぜん"],[41,1,"め"],[43,1,"まえ"],[45,1,"ちち"],[53,1,"ところ"]],"text":"こうして彼らがアブサロムのために屋上に天幕を張ったので、アブサロムは全イスラエルの目の前で父のめかけたちの所にはいった。"},{"ref":"2Sam.16.23","start":10016023,"end":10016023,"break":"none","ruby":[[10,1,"さづ"],[13,1,"はか"],[18,1,"ひと"],[20,1,"かみ"],[23,1,"つ"],[26,1,"うかが"],[41,1,"はか"],[46,1,"みな"],[59,1,"とも"],[66,1,"おも"]],"text":"そのころアヒトペルが授ける計りごとは人が神のみ告げを伺うようであった。アヒトペルの計りごとは皆ダビデにもアブサロムにも共にそのように思われた。"}]