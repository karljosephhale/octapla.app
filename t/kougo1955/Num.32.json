[{"ref":"Num.32.1","start":4032001,"end":4032001,"break":"paragraph","ruby":[[4,2,"しそん"],[10,2,"しそん"],[14,2,"ひじょう"],[17,1,"おお"],[20,2,"かちく"],[23,1,"む"],[26,1,"も"],[32,1,"かれ"],[39,1,"ち"],[47,1,"ち"],[50,1,"み"],[57,2,"かちく"],[60,1,"か"],[64,1,"てき"]],"text":"ルベンの子孫とガドの子孫とは非常に多くの家畜の群れを持っていた。彼らがヤゼルの地と、ギレアデの地とを見ると、そこは家畜を飼うのに適していたので、"},{"ref":"Num.32.2","start":4032002,"end":4032002,"break":"none","ruby":[[3,2,"しそん"],[10,2,"しそん"],[22,2,"さいし"],[31,2,"かいしゅう"],[41,1,"い"]],"text":"ガドの子孫とルベンの子孫とがきて、モーセと、祭司エレアザルと、会衆のつかさたちとに言った、"},{"ref":"Num.32.3","start":4032003,"end":4032003,"break":"none","text":"「アタロテ、デボン、ヤゼル、ニムラ、ヘシボン、エレアレ、シバム、ネボ、ベオン、"},{"ref":"Num.32.4","start":4032004,"end":4032004,"break":"none","ruby":[[4,1,"しゅ"],[12,2,"かいしゅう"],[15,1,"まえ"],[17,1,"う"],[19,1,"ほろ"],[24,1,"くに"],[27,2,"かちく"],[30,1,"か"],[34,1,"てき"],[37,1,"ち"],[47,2,"かちく"],[50,1,"も"]],"text":"すなわち主がイスラエルの会衆の前に撃ち滅ぼされた国は、家畜を飼うのに適した地ですが、しもべらは家畜を持っています」。"},{"ref":"Num.32.5","start":4032005,"end":4032005,"break":"none","ruby":[[0,1,"かれ"],[5,1,"い"],[20,1,"めぐ"],[23,1,"え"],[36,1,"ち"],[43,2,"りょうち"],[59,1,"わた"]],"text":"彼らはまた言った、「それでもし、あなたの恵みを得られますなら、どうぞこの地をしもべらの領地にして、われわれにヨルダンを渡らせないでください」。"},{"ref":"Num.32.6","start":4032006,"end":4032006,"break":"paragraph","ruby":[[7,2,"しそん"],[14,2,"しそん"],[18,1,"い"],[29,2,"きょうだい"],[32,1,"たたか"],[35,1,"い"]],"text":"モーセはガドの子孫とルベンの子孫とに言った、「あなたがたは兄弟が戦いに行くのに、ここにすわっていようというのか。"},{"ref":"Num.32.7","start":4032007,"end":4032007,"break":"none","ruby":[[16,2,"ひとびと"],[19,1,"こころ"],[26,1,"しゅ"],[28,1,"かれ"],[31,1,"あた"],[36,1,"ち"],[38,1,"わた"]],"text":"どうしてあなたがたはイスラエルの人々の心をくじいて、主が彼らに与えられる地に渡ることができないようにするのか。"},{"ref":"Num.32.8","start":4032008,"end":4032008,"break":"none","ruby":[[6,2,"せんぞ"],[27,1,"ち"],[29,1,"み"],[39,1,"とき"],[42,1,"おな"]],"text":"あなたがたの先祖も、わたしがカデシ・バルネアから、その地を見るためにつかわした時に、同じようなことをした。"},{"ref":"Num.32.9","start":4032009,"end":4032009,"break":"none","ruby":[[4,1,"かれ"],[12,1,"たに"],[14,1,"い"],[20,1,"ち"],[22,1,"み"],[33,2,"ひとびと"],[36,1,"こころ"],[43,1,"しゅ"],[45,1,"あた"],[50,1,"ち"],[52,1,"い"]],"text":"すなわち彼らはエシコルの谷に行って、その地を見たとき、イスラエルの人々の心をくじいて、主が与えられる地に行くことができないようにした。"},{"ref":"Num.32.10","start":4032010,"end":4032010,"break":"none","ruby":[[5,1,"とき"],[7,1,"しゅ"],[9,1,"いか"],[12,1,"はっ"],[15,1,"ちか"],[18,1,"い"]],"text":"そこでその時、主は怒りを発し、誓って言われた、"},{"ref":"Num.32.11","start":4032011,"end":4032011,"break":"none","ruby":[[7,1,"で"],[11,2,"ひとびと"],[16,1,"さい"],[17,2,"いじょう"],[20,1,"もの"],[44,1,"ちか"],[47,1,"ち"],[49,1,"み"],[59,1,"かれ"],[66,1,"したが"]],"text":"『エジプトから出てきた人々で二十歳以上の者はひとりもわたしがアブラハム、イサク、ヤコブに誓った地を見ることはできない。彼らはわたしに従わなかったからである。"},{"ref":"Num.32.12","start":4032012,"end":4032012,"break":"none","ruby":[[12,1,"こ"],[20,1,"こ"],[40,1,"まった"],[42,1,"しゅ"],[44,1,"したが"]],"text":"ただケニズびとエフンネの子カレブとヌンの子ヨシュアとはそうではない。このふたりは全く主に従ったからである』。"},{"ref":"Num.32.13","start":4032013,"end":4032013,"break":"none","ruby":[[0,1,"しゅ"],[17,1,"いか"],[20,1,"はっ"],[23,1,"かれ"],[28,1,"ねん"],[33,2,"あらの"],[46,1,"しゅ"],[48,1,"まえ"],[50,1,"あく"],[52,1,"おこな"],[57,2,"せだい"],[60,2,"ひとびと"],[69,1,"ほろ"]],"text":"主はこのようにイスラエルにむかって怒りを発し、彼らを四十年のあいだ荒野にさまよわされたので、主の前に悪を行ったその世代の人々は、ついにみな滅びた。"},{"ref":"Num.32.14","start":4032014,"end":4032014,"break":"none","ruby":[[8,1,"ちち"],[10,1,"かわ"],[13,1,"た"],[16,1,"つみ"],[28,1,"しゅ"],[36,1,"たい"],[39,1,"はげ"],[42,1,"いか"],[48,1,"ま"]],"text":"あなたがたはその父に代って立った罪びとのやからであって、主のイスラエルに対する激しい怒りをさらに増そうとしている。"},{"ref":"Num.32.15","start":4032015,"end":4032015,"break":"none","ruby":[[12,1,"しゅ"],[14,1,"したが"],[22,1,"しゅ"],[28,1,"たみ"],[30,2,"あらの"],[57,1,"たみ"],[64,1,"ほろ"],[68,1,"いた"]],"text":"あなたがたがもしそむいて主に従わないならば、主はまたこの民を荒野にすておかれるであろう。そうすればあなたがたはこの民をことごとく滅ぼすに至るであろう」。"},{"ref":"Num.32.16","start":4032016,"end":4032016,"break":"paragraph","ruby":[[0,1,"かれ"],[11,1,"すす"],[13,1,"よ"],[16,1,"い"],[28,1,"ところ"],[31,1,"む"],[37,1,"ひつじ"],[42,1,"た"],[47,2,"こども"],[55,2,"まちまち"],[58,1,"た"],[63,1,"おも"]],"text":"彼らはモーセのところへ進み寄って言った、「われわれはこの所に、群れのために羊のおりを建て、また子供たちのために町々を建てようと思います。"},{"ref":"Num.32.17","start":4032017,"end":4032017,"break":"none","ruby":[[9,2,"ぶそう"],[19,2,"ひとびと"],[22,1,"まえ"],[24,1,"すす"],[27,1,"かれ"],[32,1,"ところ"],[34,1,"みちび"],[37,1,"い"],[51,2,"こども"],[59,1,"ち"],[61,2,"じゅうみん"],[64,1,"がい"],[73,2,"けんご"],[76,2,"まちまち"],[79,1,"す"]],"text":"しかし、われわれは武装してイスラエルの人々の前に進み、彼らをその所へ導いて行きましょう。ただわれわれの子供たちは、この地の住民の害をのがれるため、堅固な町々に住ませておかなければなりません。"},{"ref":"Num.32.18","start":4032018,"end":4032018,"break":"none","ruby":[[11,2,"ひとびと"],[21,1,"し"],[22,1,"ぎょう"],[24,1,"う"],[31,1,"いえ"],[33,1,"かえ"]],"text":"われわれはイスラエルの人々が、おのおのその嗣業を受けるまでは、家に帰りません。"},{"ref":"Num.32.19","start":4032019,"end":4032019,"break":"none","ruby":[[16,1,"かれ"],[23,1,"し"],[24,1,"ぎょう"],[26,1,"う"],[50,1,"ひがし"],[52,1,"ほう"],[54,1,"し"],[55,1,"ぎょう"],[57,1,"う"]],"text":"またわれわれはヨルダンのかなたで彼らとともには嗣業を受けません。われわれはヨルダンのこなた、すなわち東の方で嗣業を受けるからです」。"},{"ref":"Num.32.20","start":4032020,"end":4032020,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[30,2,"ぶそう"],[34,1,"しゅ"],[36,1,"まえ"],[38,1,"い"],[41,1,"たたか"]],"text":"モーセは彼らに言った、「もし、あなたがたがそのようにし、みな武装して主の前に行って戦い、"},{"ref":"Num.32.21","start":4032021,"end":4032021,"break":"none","ruby":[[2,2,"ぶそう"],[6,1,"しゅ"],[8,1,"まえ"],[10,1,"い"],[17,1,"がわ"],[19,1,"わた"],[22,1,"しゅ"],[26,1,"てき"],[28,2,"じぶん"],[31,1,"まえ"],[34,1,"お"],[36,1,"はら"]],"text":"みな武装して主の前に行ってヨルダン川を渡り、主がその敵を自分の前から追い払われて、"},{"ref":"Num.32.22","start":4032022,"end":4032022,"break":"none","ruby":[[2,1,"くに"],[4,1,"しゅ"],[6,1,"まえ"],[8,2,"せいふく"],[13,1,"のち"],[15,1,"かえ"],[30,1,"しゅ"],[32,1,"まえ"],[42,1,"まえ"],[62,1,"ち"],[64,1,"しゅ"],[66,1,"まえ"],[74,2,"しょゆう"]],"text":"この国が主の前に征服されて後、帰ってくるならば、あなたがたは主の前にも、イスラエルの前にも、とがめはないであろう。そしてこの地は主の前にあなたがたの所有となるであろう。"},{"ref":"Num.32.23","start":4032023,"end":4032023,"break":"none","ruby":[[19,1,"しゅ"],[25,1,"つみ"],[27,1,"おか"],[30,1,"もの"],[37,1,"つみ"],[39,1,"かなら"],[41,1,"み"],[43,1,"およ"],[48,1,"し"]],"text":"しかし、そうしないならば、あなたがたは主にむかって罪を犯した者となり、その罪は必ず身に及ぶことを知らなければならない。"},{"ref":"Num.32.24","start":4032024,"end":4032024,"break":"none","ruby":[[6,2,"こども"],[14,2,"まちまち"],[17,1,"た"],[20,1,"ひつじ"],[29,1,"た"],[45,2,"やくそく"],[52,1,"おこな"]],"text":"あなたがたは子供たちのために町々を建て、羊のために、おりを建てなさい。しかし、あなたがたは約束したことは行わなければならない」。"},{"ref":"Num.32.25","start":4032025,"end":4032025,"break":"none","ruby":[[3,2,"しそん"],[10,2,"しそん"],[19,1,"い"],[33,1,"めい"]],"text":"ガドの子孫とルベンの子孫とは、モーセに言った、「しもべらはあなたの命じられたとおりにいたします。"},{"ref":"Num.32.26","start":4032026,"end":4032026,"break":"none","ruby":[[5,2,"こども"],[10,1,"つま"],[12,1,"ひつじ"],[19,2,"かちく"],[31,2,"まちまち"],[34,1,"のこ"]],"text":"われわれの子供たちと妻と羊と、すべての家畜とは、このギレアデの町々に残します。"},{"ref":"Num.32.27","start":4032027,"end":4032027,"break":"none","ruby":[[11,2,"ぶそう"],[20,1,"い"],[28,1,"しゅ"],[30,1,"まえ"],[32,1,"わた"],[35,1,"い"],[38,1,"たたか"]],"text":"しかし、しもべらはみな武装して、あなたの言われるとおり、主の前に渡って行って戦います」。"},{"ref":"Num.32.28","start":4032028,"end":4032028,"break":"paragraph","ruby":[[4,1,"かれ"],[14,2,"さいし"],[26,1,"こ"],[39,2,"ひとびと"],[42,2,"ぶぞく"],[48,2,"しぞく"],[58,1,"めい"]],"text":"モーセは彼らのことについて、祭司エレアザルと、ヌンの子ヨシュアと、イスラエルの人々の部族のうちの氏族のかしらたちとに命じた。"},{"ref":"Num.32.29","start":4032029,"end":4032029,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[18,2,"しそん"],[26,2,"しそん"],[35,2,"ぶそう"],[45,2,"いっしょ"],[53,1,"わた"],[56,1,"しゅ"],[58,1,"まえ"],[60,1,"たたか"],[66,1,"ち"],[74,2,"せいふく"],[88,1,"かれ"],[96,1,"ち"],[98,2,"りょうち"],[103,1,"あた"]],"text":"そしてモーセは彼らに言った、「ガドの子孫と、ルベンの子孫とが、おのおの武装してあなたがたと一緒にヨルダンを渡り、主の前に戦って、その地をあなたがたが征服するならば、あなたがたは彼らにギレアデの地を領地として与えなければならない。"},{"ref":"Num.32.30","start":4032030,"end":4032030,"break":"none","ruby":[[6,1,"かれ"],[9,2,"ぶそう"],[19,2,"いっしょ"],[22,1,"わた"],[25,1,"い"],[33,1,"かれ"],[40,1,"ち"],[51,2,"りょうち"],[54,1,"え"]],"text":"しかし、もし彼らが武装してあなたがたと一緒に渡って行かないならば、彼らはカナンの地であなたがたのうちに領地を獲なければならない」。"},{"ref":"Num.32.31","start":4032031,"end":4032031,"break":"none","ruby":[[3,2,"しそん"],[11,2,"しそん"],[15,1,"こた"],[18,1,"い"],[28,1,"しゅ"],[30,1,"い"]],"text":"ガドの子孫と、ルベンの子孫とは答えて言った、「しもべらは主が言われたとおりにいたします。"},{"ref":"Num.32.32","start":4032032,"end":4032032,"break":"none","ruby":[[5,2,"ぶそう"],[10,1,"しゅ"],[12,1,"まえ"],[18,1,"ち"],[20,1,"わた"],[23,1,"い"],[44,1,"し"],[45,1,"ぎょう"]],"text":"われわれは武装して、主の前にカナンの地へ渡って行きますが、ヨルダンのこなたで、われわれの嗣業をもつことにします」。"},{"ref":"Num.32.33","start":4032033,"end":4032033,"break":"paragraph","ruby":[[10,2,"しそん"],[18,2,"しそん"],[26,1,"こ"],[31,2,"ぶぞく"],[34,1,"なか"],[45,1,"おう"],[50,1,"くに"],[58,1,"おう"],[62,1,"くに"],[65,1,"あた"],[76,1,"くに"],[82,2,"りょうない"],[85,2,"まちまち"],[90,2,"まちまち"],[93,2,"しゅうい"],[96,1,"ち"],[99,1,"あた"]],"text":"そこでモーセはガドの子孫と、ルベンの子孫と、ヨセフの子マナセの部族の半ばとに、アモリびとの王シホンの国と、バシャンの王オグの国とを与えた。すなわち、その国およびその領内の町々とその町々の周囲の地とを与えた。"},{"ref":"Num.32.34","start":4032034,"end":4032034,"break":"none","ruby":[[7,2,"しそん"]],"text":"こうしてガドの子孫は、デボン、アタロテ、アロエル、"},{"ref":"Num.32.35","start":4032035,"end":4032035,"break":"none","text":"アテロテ・ショパン、ヤゼル、ヨグベハ、"},{"ref":"Num.32.36","start":4032036,"end":4032036,"break":"none","ruby":[[14,2,"けんご"],[17,2,"まちまち"],[20,1,"た"],[23,1,"ひつじ"],[28,1,"た"]],"text":"ベテニムラ、ベテハランなどの堅固な町々を建て、羊のおりを建てた。"},{"ref":"Num.32.37","start":4032037,"end":4032037,"break":"none","ruby":[[6,2,"しそん"]],"text":"またルベンの子孫は、ヘシボン、エレアレ、キリヤタイム、"},{"ref":"Num.32.38","start":4032038,"end":4032038,"break":"none","ruby":[[3,1,"のち"],[5,1,"な"],[7,1,"あらた"],[22,1,"まち"],[24,1,"た"],[33,1,"まち"],[35,1,"た"],[39,1,"かれ"],[42,1,"た"],[45,2,"まちまち"],[48,1,"あたら"],[51,1,"な"],[53,1,"あた"]],"text":"および後に名を改めたネボと、バアル・メオンの町を建て、またシブマの町を建てた。彼らは建てた町々に新しい名を与えた。"},{"ref":"Num.32.39","start":4032039,"end":4032039,"break":"none","ruby":[[6,1,"こ"],[11,2,"しそん"],[19,1,"い"],[26,1,"と"],[31,2,"じゅうみん"],[39,1,"お"],[41,1,"はら"]],"text":"またマナセの子マキルの子孫はギレアデに行って、そこを取り、その住民アモリびとを追い払ったので、"},{"ref":"Num.32.40","start":4032040,"end":4032040,"break":"none","ruby":[[13,1,"こ"],[18,1,"あた"],[24,1,"す"]],"text":"モーセはギレアデをマナセの子マキルに与えてそこに住まわせた。"},{"ref":"Num.32.41","start":4032041,"end":4032041,"break":"none","ruby":[[6,1,"こ"],[11,1,"い"],[14,2,"むらむら"],[17,1,"と"],[30,1,"な"]],"text":"またマナセの子ヤイルは行って村々を取り、それをハオテヤイルと名づけた。"},{"ref":"Num.32.42","start":4032042,"end":4032042,"break":"none","ruby":[[5,1,"い"],[14,2,"むらむら"],[17,1,"と"],[20,2,"じぶん"],[23,1,"な"],[37,1,"な"]],"text":"またノバは行ってケナテとその村々を取り、自分の名にしたがって、それをノバと名づけた。"}]