[{"ref":"1Chr.5.1","start":13005001,"end":13005001,"break":"paragraph","ruby":[[6,2,"ちょうし"],[12,1,"こ"],[15,1,"つぎ"],[30,2,"ちょうし"],[37,1,"ちち"],[39,1,"とこ"],[41,1,"けが"],[47,2,"ちょうし"],[50,1,"けん"],[58,1,"こ"],[63,1,"こ"],[66,1,"あた"],[75,2,"ちょうし"],[78,1,"けん"],[82,2,"けいず"]],"text":"イスラエルの長子ルベンの子らは次のとおりである。――ルベンは長子であったが父の床を汚したので、長子の権はイスラエルの子ヨセフの子らに与えられた。それで長子の権による系図にしるされていない。"},{"ref":"1Chr.5.2","start":13005002,"end":13005002,"break":"none","ruby":[[5,2,"きょうだい"],[13,1,"もの"],[20,1,"なか"],[23,1,"くん"],[26,1,"もの"],[31,2,"ちょうし"],[34,1,"けん"]],"text":"またユダは兄弟たちにまさる者となり、その中から君たる者がでたが長子の権はヨセフのものとなったのである。――"},{"ref":"1Chr.5.3","start":13005003,"end":13005003,"break":"none","ruby":[[10,2,"ちょうし"],[16,1,"こ"]],"text":"すなわちイスラエルの長子ルベンの子らはハノク、パル、ヘヅロン、カルミ。"},{"ref":"1Chr.5.4","start":13005004,"end":13005004,"break":"none","ruby":[[4,1,"こ"],[9,1,"こ"],[17,1,"こ"],[24,1,"こ"]],"text":"ヨエルの子らはその子はシマヤ、その子はゴグ、その子はシメイ、"},{"ref":"1Chr.5.5","start":13005005,"end":13005005,"break":"none","ruby":[[2,1,"こ"],[9,1,"こ"],[17,1,"こ"]],"text":"その子はミカ、その子はレアヤ、その子はバアル、"},{"ref":"1Chr.5.6","start":13005006,"end":13005006,"break":"none","ruby":[[2,1,"こ"],[23,1,"おう"],[35,1,"とら"],[37,1,"うつ"],[40,1,"もの"],[45,1,"かれ"]],"text":"その子はベエラである。このベエラはアッスリヤの王テルガテ・ピルネセルが捕え移した者である。彼はルベンびとのつかさであった。"},{"ref":"1Chr.5.7","start":13005007,"end":13005007,"break":"none","ruby":[[0,1,"かれ"],[2,2,"きょうだい"],[10,2,"しぞく"],[18,2,"れきだい"],[21,2,"けいず"]],"text":"彼の兄弟たちは、その氏族により、その歴代の系図によれば、かしらエイエルおよびゼカリヤ、"},{"ref":"1Chr.5.8","start":13005008,"end":13005008,"break":"none","ruby":[[15,1,"こ"],[20,1,"まご"],[32,1,"かれ"],[39,1,"す"],[56,1,"およ"]],"text":"ベラなどである。ベラはアザズの子、シマの孫、ヨエルのひこである。彼はアロエルに住み、ネボおよびバアル・メオンまで及んでいたが、"},{"ref":"1Chr.5.9","start":13005009,"end":13005009,"break":"none","ruby":[[5,1,"ち"],[7,1,"かれ"],[9,2,"かちく"],[14,1,"ま"],[20,1,"かれ"],[22,1,"ひがし"],[24,1,"ほう"],[29,1,"かわ"],[35,2,"あらの"],[38,2,"いりぐち"],[43,1,"す"]],"text":"ギレアデの地で彼の家畜がふえ増したので、彼は東の方ユフラテ川のこなたの荒野の入口にまで住んだ。"},{"ref":"1Chr.5.10","start":13005010,"end":13005010,"break":"none","ruby":[[6,1,"とき"],[8,1,"かれ"],[17,1,"たたか"],[24,1,"う"],[26,1,"たお"],[34,1,"ひがし"],[36,2,"ぜんぶ"],[43,1,"かれ"],[46,2,"てんまく"],[49,1,"す"]],"text":"またサウルの時、彼らはハガルびとと戦って、これを撃ち倒し、ギレアデの東の全部にわたって彼らの天幕に住んだ。"},{"ref":"1Chr.5.11","start":13005011,"end":13005011,"break":"paragraph","ruby":[[3,2,"しそん"],[9,2,"あいたい"],[18,1,"ち"],[20,1,"す"],[28,1,"およ"]],"text":"ガドの子孫はこれと相対してバシャンの地に住み、サルカまで及んでいた。"},{"ref":"1Chr.5.12","start":13005012,"end":13005012,"break":"none","ruby":[[10,1,"つぎ"],[36,1,"す"]],"text":"そのかしらはヨエル、次はシャパム、ヤアナイ、シャパテで、ともにバシャンに住んだ。"},{"ref":"1Chr.5.13","start":13005013,"end":13005013,"break":"none","ruby":[[0,1,"かれ"],[3,2,"きょうだい"],[11,2,"しぞく"],[47,1,"にん"]],"text":"彼らの兄弟たちは、その氏族によればミカエル、メシュラム、シバ、ヨライ、ヤカン、ジア、エベルの七人である。"},{"ref":"1Chr.5.14","start":13005014,"end":13005014,"break":"none","ruby":[[7,1,"こ"],[14,1,"こ"],[27,1,"こ"],[38,1,"こ"],[50,1,"こ"],[62,1,"こ"],[72,1,"こ"],[80,1,"こ"]],"text":"これらはホリの子アビハイルの子らである。ホリはヤロアの子、ヤロアはギレアデの子、ギレアデはミカエルの子、ミカエルはエシサイの子、エシサイはヤドの子、ヤドはブズの子である。"},{"ref":"1Chr.5.15","start":13005015,"end":13005015,"break":"none","ruby":[[8,1,"こ"],[18,1,"こ"],[25,2,"しぞく"],[28,1,"ちょう"]],"text":"アヒはアブデルの子、アブデルはグニの子、グニはその氏族の長である。"},{"ref":"1Chr.5.16","start":13005016,"end":13005016,"break":"none","ruby":[[0,1,"かれ"],[15,2,"むらざと"],[27,2,"ほうぼく"],[29,1,"ち"],[31,1,"す"],[37,2,"しほう"],[40,1,"さかい"],[44,1,"およ"]],"text":"彼らはギレアデとバシャンとその村里とシャロンのすべての放牧地に住んで、その四方の境にまで及んでいた。"},{"ref":"1Chr.5.17","start":13005017,"end":13005017,"break":"none","ruby":[[9,1,"おう"],[14,1,"よ"],[22,1,"おう"],[29,1,"よ"],[31,2,"けいず"]],"text":"これらはみなユダの王ヨタムの世とイスラエルの王ヤラベアムの世に系図にのせられた。"},{"ref":"1Chr.5.18","start":13005018,"end":13005018,"break":"paragraph","ruby":[[17,1,"はん"],[18,2,"ぶぞく"],[22,1,"で"],[24,1,"たたか"],[28,1,"もの"],[37,1,"にん"],[41,1,"みな"],[42,2,"ゆうし"],[46,1,"たて"],[55,1,"ゆみ"],[60,1,"たたか"],[63,1,"たく"],[66,2,"ひとびと"]],"text":"ルベンびとと、ガドびとと、マナセの半部族には出て戦いうる者四万四千七百六十人あり、皆勇士で、盾とつるぎをとり、弓をひき、戦いに巧みな人々であった。"},{"ref":"1Chr.5.19","start":13005019,"end":13005019,"break":"none","ruby":[[0,1,"かれ"],[25,1,"たたか"]],"text":"彼らはハガルびとおよびエトル、ネフシ、ノダブなどと戦ったが、"},{"ref":"1Chr.5.20","start":13005020,"end":13005020,"break":"none","ruby":[[0,1,"たす"],[3,1,"え"],[8,1,"せ"],[30,1,"もの"],[32,1,"みな"],[34,1,"かれ"],[37,1,"て"],[48,1,"かれ"],[51,1,"たたか"],[58,1,"かみ"],[60,1,"よ"],[65,1,"かみ"],[67,1,"よ"],[69,1,"たよ"],[74,1,"かみ"],[78,1,"ねが"],[81,1,"き"]],"text":"助けを得てこれを攻めたので、ハガルびとおよびこれとともにいた者は皆、彼らの手にわたされた。これは彼らが戦いにあたって神に呼ばわり、神に寄り頼んだので神はその願いを聞かれたからである。"},{"ref":"1Chr.5.21","start":13005021,"end":13005021,"break":"none","ruby":[[0,1,"かれ"],[5,2,"かちく"],[8,1,"うば"],[10,1,"と"],[21,1,"ひつじ"],[36,1,"ひと"],[38,1,"じゅう"],[39,1,"まん"],[40,1,"にん"]],"text":"彼らはその家畜を奪い取ったが、らくだ五万、羊二十五万、ろば二千あり、また人は十万人あった。"},{"ref":"1Chr.5.22","start":13005022,"end":13005022,"break":"none","ruby":[[5,1,"たたか"],[8,1,"かみ"],[16,1,"おお"],[19,1,"もの"],[21,1,"ころ"],[25,1,"たお"],[37,1,"かれ"],[40,1,"とら"],[42,1,"うつ"],[46,1,"とき"],[53,1,"かわ"],[58,1,"ところ"],[60,1,"す"]],"text":"これはその戦いが神によったので、多くの者が殺されて倒れたからである。そして彼らは捕え移される時まで、これに代ってその所に住んだ。"},{"ref":"1Chr.5.23","start":13005023,"end":13005023,"break":"paragraph","ruby":[[4,1,"はん"],[5,2,"ぶぞく"],[8,2,"ひとびと"],[13,1,"ち"],[15,1,"す"],[20,1,"ひろ"],[53,1,"やま"],[57,1,"およ"]],"text":"マナセの半部族の人々はこの地に住み、ふえ広がって、ついにバシャンからバアル・ヘルモン、セニルおよびヘルモン山にまで及んだ。"},{"ref":"1Chr.5.24","start":13005024,"end":13005024,"break":"none","ruby":[[2,2,"しぞく"],[5,1,"ちょう"],[9,1,"つぎ"],[59,1,"みな"],[62,2,"しぞく"],[65,1,"ちょう"],[67,2,"なだか"],[70,1,"だい"],[71,2,"ゆうし"]],"text":"その氏族の長たちは次のとおりである。すなわち、エペル、イシ、エリエル、アズリエル、エレミヤ、ホダヤ、ヤデエル。これらは皆その氏族の長で名高い大勇士であった。"},{"ref":"1Chr.5.25","start":13005025,"end":13005025,"break":"none","ruby":[[0,1,"かれ"],[3,2,"せんぞ"],[8,1,"かみ"],[14,1,"つみ"],[16,1,"おか"],[19,1,"かみ"],[25,1,"かれ"],[28,1,"まえ"],[31,1,"ほろ"],[36,1,"くに"],[38,1,"たみ"],[40,2,"かみがみ"],[43,1,"した"],[50,2,"かんいん"]],"text":"彼らは先祖たちの神にむかって罪を犯し、神が、かつて彼らの前から滅ぼされた国の民の神々を慕って、これと姦淫したので、"},{"ref":"1Chr.5.26","start":13005026,"end":13005026,"break":"none","ruby":[[6,1,"かみ"],[15,1,"おう"],[19,1,"こころ"],[21,1,"ふる"],[23,1,"おこ"],[34,1,"おう"],[46,1,"こころ"],[48,1,"ふる"],[50,1,"おこ"],[57,1,"かれ"],[79,1,"はん"],[80,2,"ぶぞく"],[83,1,"とら"],[86,1,"い"],[103,1,"かわ"],[109,1,"うつ"],[112,2,"こんにち"],[115,1,"いた"]],"text":"イスラエルの神は、アッスリヤの王プルの心を奮い起し、またアッスリヤの王テルガテ・ピルネセルの心を奮い起されたので、彼はついにルベンびとと、ガドびとと、マナセの半部族を捕えて行き、ハウラとハボルとハラとゴザン川のほとりに移して今日に至っている。"}]