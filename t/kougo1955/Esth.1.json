[{"ref":"Esth.1.1","start":17001001,"end":17001001,"break":"paragraph","ruby":[[27,1,"しゅう"],[29,1,"おさ"],[40,1,"よ"]],"text":"アハシュエロスすなわちインドからエチオピヤまで百二十七州を治めたアハシュエロスの世、"},{"ref":"Esth.1.2","start":17001002,"end":17001002,"break":"none","ruby":[[7,1,"おう"],[9,2,"しゅと"],[17,1,"くに"],[19,1,"くらい"],[21,1,"ざ"]],"text":"アハシュエロス王が首都スサで、その国の位に座していたころ、"},{"ref":"Esth.1.3","start":17001003,"end":17001003,"break":"none","ruby":[[2,2,"ちせい"],[5,1,"だい"],[7,1,"ねん"],[10,1,"かれ"],[14,2,"だいじん"],[19,2,"じしん"],[27,2,"しゅえん"],[30,1,"もう"],[43,2,"しょうぐん"],[48,2,"きぞく"],[54,1,"しょ"],[55,1,"しゅう"],[57,2,"だいじん"],[64,1,"まえ"]],"text":"その治世の第三年に、彼はその大臣および侍臣たちのために酒宴を設けた。ペルシャとメデアの将軍および貴族ならびに諸州の大臣たちがその前にいた。"},{"ref":"Esth.1.4","start":17001004,"end":17001004,"break":"none","ruby":[[2,1,"とき"],[4,1,"おう"],[8,1,"さか"],[11,1,"くに"],[13,1,"とみ"],[18,2,"おうい"],[21,1,"かがや"],[31,1,"しめ"],[34,1,"おお"],[37,1,"ひ"],[39,1,"かさ"],[45,1,"にち"],[47,1,"およ"]],"text":"その時、王はその盛んな国の富と、その王威の輝きと、はなやかさを示して多くの日を重ね、百八十日に及んだ。"},{"ref":"Esth.1.5","start":17001005,"end":17001005,"break":"none","ruby":[[4,1,"ひ"],[6,1,"おわ"],[9,1,"とき"],[11,1,"おう"],[13,1,"おう"],[15,2,"きゅうでん"],[18,1,"その"],[20,1,"にわ"],[23,2,"しゅと"],[30,2,"だいしょう"],[37,1,"たみ"],[42,2,"なぬか"],[45,1,"あいだ"],[47,2,"しゅえん"],[50,1,"もう"]],"text":"これらの日が終った時、王は王の宮殿の園の庭で、首都スサにいる大小のすべての民のために七日の間、酒宴を設けた。"},{"ref":"Esth.1.6","start":17001006,"end":17001006,"break":"none","ruby":[[4,1,"しろ"],[5,2,"めんぷ"],[8,2,"たれまく"],[11,2,"あおいろ"],[23,2,"むらさきいろ"],[26,1,"ほそ"],[27,1,"ぬの"],[32,1,"ぎん"],[34,1,"わ"],[38,3,"だいりせき"],[42,1,"はしら"],[54,1,"なが"],[58,2,"きんぎん"],[61,1,"つく"],[65,2,"せっこう"],[68,3,"だいりせき"],[72,3,"しんじゅがい"],[78,2,"ほうせき"],[81,1,"き"],[85,2,"ざいく"],[88,1,"ゆか"],[90,1,"うえ"],[92,1,"お"]],"text":"そこには白綿布の垂幕と青色のとばりとがあって、紫色の細布のひもで銀の輪および大理石の柱につながれていた。また長いすは金銀で作られ、石膏と大理石と真珠貝および宝石の切りはめ細工の床の上に置かれていた。"},{"ref":"Esth.1.7","start":17001007,"end":17001007,"break":"none","ruby":[[0,1,"さけ"],[2,1,"きん"],[4,1,"さかずき"],[6,1,"たま"],[12,1,"さかずき"],[18,1,"ちが"],[25,1,"おう"],[27,1,"おお"],[30,2,"どりょう"],[39,1,"おう"],[41,1,"もち"],[44,1,"さけ"],[46,1,"お"],[51,1,"たま"]],"text":"酒は金の杯で賜わり、その杯はそれぞれ違ったもので、王の大きな度量にふさわしく、王の用いる酒を惜しみなく賜わった。"},{"ref":"Esth.1.8","start":17001008,"end":17001008,"break":"none","ruby":[[2,1,"の"],[7,1,"ほう"],[32,1,"おう"],[34,2,"ひとびと"],[41,2,"じぶん"],[44,1,"この"],[53,2,"きゅうてい"],[60,2,"やくにん"],[63,1,"めい"]],"text":"その飲むことは法にかない、だれもしいられることはなかった。これは王が人々におのおの自分の好むようにさせよと宮廷のすべての役人に命じておいたからである。"},{"ref":"Esth.1.9","start":17001009,"end":17001009,"break":"none","ruby":[[0,2,"おうひ"],[15,1,"おう"],[17,1,"ぞく"],[20,2,"おうきゅう"],[23,1,"うち"],[25,1,"おんな"],[32,2,"しゅえん"],[35,1,"もう"]],"text":"王妃ワシテもまたアハシュエロス王に属する王宮の内で女たちのために酒宴を設けた。"},{"ref":"Esth.1.10","start":17001010,"end":17001010,"break":"paragraph","ruby":[[0,2,"なぬか"],[2,1,"め"],[11,1,"おう"],[13,1,"さけ"],[18,1,"こころ"],[20,1,"たの"],[26,1,"おう"],[28,1,"まえ"],[30,1,"つか"],[34,1,"にん"],[36,2,"じじゅう"],[72,1,"めい"]],"text":"七日目にアハシュエロス王は酒のために心が楽しくなり、王の前に仕える七人の侍従メホマン、ビズタ、ハルボナ、ビグタ、アバグタ、ゼタルおよびカルカスに命じて、"},{"ref":"Esth.1.11","start":17001011,"end":17001011,"break":"none","ruby":[[0,2,"おうひ"],[6,2,"おうひ"],[9,1,"かんむり"],[16,1,"おう"],[18,1,"まえ"],[25,1,"い"],[32,2,"かのじょ"],[35,1,"うつく"],[45,1,"うつく"],[49,1,"たみ"],[52,2,"だいじん"],[57,1,"み"]],"text":"王妃ワシテに王妃の冠をかぶらせて王の前にこさせよと言った。これは彼女が美しかったので、その美しさを民らと大臣たちに見せるためであった。"},{"ref":"Esth.1.12","start":17001012,"end":17001012,"break":"none","ruby":[[5,2,"おうひ"],[11,2,"じじゅう"],[14,1,"つた"],[17,1,"おう"],[19,2,"めいれい"],[22,1,"したが"],[25,1,"く"],[30,1,"こば"],[36,1,"おう"],[38,1,"おお"],[41,1,"いきどお"],[46,1,"いか"],[49,1,"かれ"],[51,1,"うち"],[53,1,"も"]],"text":"ところが、王妃ワシテは侍従が伝えた王の命令に従って来ることを拒んだので、王は大いに憤り、その怒りが彼の内に燃えた。"},{"ref":"Esth.1.13","start":17001013,"end":17001013,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"とき"],[7,1,"し"],[12,2,"ちしゃ"],[15,1,"い"],[21,1,"おう"],[26,2,"ほうりつ"],[29,2,"しんぱん"],[32,1,"つう"],[37,1,"もの"],[39,2,"そうだん"],[45,1,"つね"]],"text":"そこで王は時を知っている知者に言った、――王はすべて法律と審判に通じている者に相談するのを常とした。"},{"ref":"Esth.1.14","start":17001014,"end":17001014,"break":"none","ruby":[[0,1,"とき"],[2,1,"おう"],[4,1,"つぎ"],[8,2,"ひとびと"],[23,1,"にん"],[25,2,"だいじん"],[64,1,"かれ"],[67,1,"みな"],[68,1,"おう"],[70,1,"かお"],[72,1,"み"],[74,1,"もの"],[77,1,"くに"],[79,2,"しゅい"],[82,1,"ざ"],[85,2,"ひとびと"]],"text":"時に王の次にいた人々はペルシャおよびメデアの七人の大臣カルシナ、セタル、アデマタ、タルシシ、メレス、マルセナ、メムカンであった。彼らは皆王の顔を見る者で、国の首位に座する人々であった――"},{"ref":"Esth.1.15","start":17001015,"end":17001015,"break":"none","ruby":[[1,2,"おうひ"],[15,1,"おう"],[17,2,"じじゅう"],[23,1,"つた"],[26,2,"めいれい"],[29,1,"おこな"],[36,2,"ほうりつ"],[39,1,"したが"],[42,2,"かのじょ"]],"text":"「王妃ワシテは、アハシュエロス王が侍従をもって伝えた命令を行わないゆえ、法律に従って彼女にどうしたらよかろうか」。"},{"ref":"Esth.1.16","start":17001016,"end":17001016,"break":"none","ruby":[[5,1,"おう"],[7,2,"だいじん"],[12,1,"まえ"],[14,1,"い"],[19,2,"おうひ"],[27,1,"おう"],[33,1,"わる"],[35,1,"こと"],[50,2,"だいじん"],[62,1,"おう"],[64,2,"かくしゅう"],[71,1,"たみ"]],"text":"メムカンは王と大臣たちの前で言った、「王妃ワシテはただ王にむかって悪い事をしたばかりでなく、すべての大臣およびアハシュエロス王の各州のすべての民にむかってもしたのです。"},{"ref":"Esth.1.17","start":17001017,"end":17001017,"break":"none","ruby":[[0,2,"おうひ"],[5,1,"おこな"],[16,1,"おんな"],[20,1,"きこ"],[24,1,"かれ"],[32,1,"め"],[34,1,"おっと"],[36,1,"いや"],[48,1,"おう"],[50,2,"おうひ"],[57,1,"かれ"],[59,1,"まえ"],[61,1,"く"],[66,1,"めい"],[77,1,"い"]],"text":"王妃のこの行いはあまねくすべての女たちに聞えて、彼らはついにその目に夫を卑しめ、『アハシュエロス王は王妃ワシテに、彼の前に来るように命じたがこなかった』と言うでしょう。"},{"ref":"Esth.1.18","start":17001018,"end":17001018,"break":"none","ruby":[[0,2,"おうひ"],[5,1,"おこな"],[8,1,"き"],[20,2,"だいじん"],[23,2,"ふじん"],[31,2,"こんにち"],[34,1,"おう"],[40,2,"だいじん"],[50,1,"い"],[62,1,"かなら"],[64,1,"いや"],[68,1,"いか"],[71,1,"おお"],[73,1,"おこ"]],"text":"王妃のこの行いを聞いたペルシャとメデアの大臣の夫人たちもまた、今日、王のすべての大臣たちにこのように言うでしょう。そうすれば必ず卑しめと怒りが多く起ります。"},{"ref":"Esth.1.19","start":17001019,"end":17001019,"break":"none","ruby":[[2,1,"おう"],[20,1,"のち"],[22,1,"ふたた"],[31,1,"おう"],[33,1,"まえ"],[45,1,"おう"],[47,2,"めいれい"],[50,1,"くだ"],[65,2,"ほうりつ"],[68,1,"なか"],[70,1,"か"],[75,1,"かわ"],[90,2,"おうひ"],[93,1,"くらい"],[95,2,"かのじょ"],[101,1,"た"],[103,1,"もの"],[105,1,"あた"]],"text":"もし王がよしとされるならば、ワシテはこの後、再びアハシュエロス王の前にきてはならないという王の命令を下し、これをペルシャとメデアの法律の中に書きいれて変ることのないようにし、そして王妃の位を彼女にまさる他の者に与えなさい。"},{"ref":"Esth.1.20","start":17001020,"end":17001020,"break":"none","ruby":[[0,1,"おう"],[2,1,"くだ"],[6,1,"みことのり"],[10,1,"おお"],[13,1,"くに"],[19,1,"つ"],[21,1,"しめ"],[28,1,"つま"],[31,1,"もの"],[41,1,"おっと"],[43,2,"こうげ"],[46,1,"べつ"],[49,1,"とも"],[51,1,"うやま"]],"text":"王の下される詔がこの大きな国にあまねく告げ示されるとき、妻たる者はことごとく、その夫を高下の別なく共に敬うようになるでしょう」。"},{"ref":"Esth.1.21","start":17001021,"end":17001021,"break":"none","ruby":[[0,1,"おう"],[2,2,"だいじん"],[9,2,"ことば"],[20,1,"おう"],[27,2,"ことば"],[34,1,"おこな"]],"text":"王と大臣たちはこの言葉をよしとしたので、王はメムカンの言葉のとおりに行った。"},{"ref":"Esth.1.22","start":17001022,"end":17001022,"break":"none","ruby":[[0,1,"おう"],[2,1,"おう"],[4,1,"しょ"],[5,1,"しゅう"],[11,1,"しょ"],[13,1,"おく"],[16,2,"かくしゅう"],[22,2,"もんじ"],[30,1,"かく"],[31,2,"みんぞく"],[37,2,"げんご"],[45,1,"か"],[47,1,"おく"],[53,2,"だんし"],[57,1,"もの"],[61,1,"いえ"],[63,1,"しゅ"],[74,2,"じぶん"],[77,1,"たみ"],[79,2,"げんご"],[82,1,"もち"],[85,1,"かた"]],"text":"王は王の諸州にあまねく書を送り、各州にはその文字にしたがい、各民族にはその言語にしたがって書き送り、すべて男子たる者はその家の主となるべきこと、また自分の民の言語を用いて語るべきことをさとした。"}]