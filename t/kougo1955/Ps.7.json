[{"ref":"Ps.7.1","start":19007001,"end":19007001,"break":"paragraph","title":"ベニヤミンびとクシのことについてダビデが主にむかってうたったシガヨンの歌","breaks":[[22,"line"],[43,"line"]],"ruby":[[2,1,"かみ"],[4,1,"しゅ"],[15,1,"よ"],[17,1,"たの"],[29,1,"お"],[31,1,"せま"],[33,1,"もの"],[40,1,"すく"],[48,1,"たす"]],"titleRuby":[[20,1,"しゅ"],[35,1,"うた"]],"text":"わが神、主よ、わたしはあなたに寄り頼みます。どうかすべての追い迫る者からわたしを救い、わたしをお助けください。"},{"ref":"Ps.7.2","start":19007002,"end":19007002,"break":"line","breaks":[[25,"line"]],"ruby":[[5,1,"かれ"],[22,1,"さ"],[25,1,"たす"],[28,1,"もの"],[30,1,"こ"],[37,1,"ひ"],[40,1,"い"]],"text":"さもないと彼らは、ししのように、わたしをかき裂き、助ける者の来ないうちに、引いて行くでしょう。"},{"ref":"Ps.7.3","start":19007003,"end":19007003,"break":"line","breaks":[[24,"line"]],"ruby":[[2,1,"かみ"],[4,1,"しゅ"],[15,1,"こと"],[17,1,"おこな"],[30,1,"て"],[37,1,"こと"]],"text":"わが神、主よ、もしわたしがこの事を行ったならば、もしわたしの手によこしまな事があるならば、"},{"ref":"Ps.7.4","start":19007004,"end":19007004,"break":"line","breaks":[[22,"line"]],"ruby":[[6,1,"とも"],[8,1,"あく"],[13,1,"むく"],[27,1,"てき"],[32,2,"りゃくだつ"]],"text":"もしわたしの友に悪をもって報いたことがあり、ゆえなく、敵のものを略奪したことがあるならば、"},{"ref":"Ps.7.5","start":19007005,"end":19007005,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[0,1,"てき"],[6,1,"お"],[8,1,"とら"],[17,1,"いのち"],[19,1,"ち"],[21,1,"ふ"],[32,1,"たましい"]],"text":"敵にわたしを追い捕えさせ、わたしの命を地に踏みにじらせ、わたしの魂をちりにゆだねさせてください。〔セラ"},{"ref":"Ps.7.6","start":19007006,"end":19007006,"break":"line","breaks":[[12,"line"],[31,"line"],[49,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"いか"],[9,1,"た"],[16,1,"てき"],[18,1,"いきどお"],[25,1,"た"],[38,1,"め"],[57,1,"めい"]],"text":"主よ、怒りをもって立ち、わたしの敵の憤りにむかって立ちあがり、わたしのために目をさましてください。あなたはさばきを命じられました。"},{"ref":"Ps.7.7","start":19007007,"end":19007007,"break":"line","breaks":[[20,"line"]],"ruby":[[5,1,"たみ"],[22,1,"うえ"],[25,1,"たか"]],"text":"もろもろの民をあなたのまわりにつどわせ、その上なる高みくらにおすわりください。"},{"ref":"Ps.7.8","start":19007008,"end":19007008,"break":"line","breaks":[[16,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"たみ"],[16,1,"しゅ"],[23,1,"ぎ"],[32,2,"せいじつ"],[36,1,"したが"]],"text":"主はもろもろの民をさばかれます。主よ、わたしの義と、わたしにある誠実とに従って、わたしをさばいてください。"},{"ref":"Ps.7.9","start":19007009,"end":19007009,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[3,1,"あ"],[6,1,"もの"],[8,1,"あく"],[10,1,"た"],[13,1,"ただ"],[16,1,"もの"],[18,1,"かた"],[20,1,"た"],[29,1,"ぎ"],[32,1,"かみ"],[39,1,"ひと"],[41,1,"こころ"],[43,1,"おも"],[47,1,"しら"]],"text":"どうか悪しき者の悪を断ち、正しき者を堅く立たせてください。義なる神よ、あなたは人の心と思いとを調べられます。"},{"ref":"Ps.7.10","start":19007010,"end":19007010,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"まも"],[6,1,"たて"],[8,1,"かみ"],[13,1,"かみ"],[15,1,"こころ"],[17,1,"なお"],[19,1,"もの"],[21,1,"すく"]],"text":"わたしを守る盾は神である。神は心の直き者を救われる。"},{"ref":"Ps.7.11","start":19007011,"end":19007011,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かみ"],[2,1,"ぎ"],[11,1,"ひ"],[15,1,"いきどお"],[18,1,"おこ"],[22,1,"かみ"]],"text":"神は義なるさばきびと、日ごとに憤りを起される神である。"},{"ref":"Ps.7.12","start":19007012,"end":19007012,"break":"line","breaks":[[25,"line"]],"ruby":[[2,1,"ひと"],[4,1,"く"],[6,1,"あらた"],[14,1,"かみ"],[27,1,"ゆみ"],[29,1,"は"],[32,1,"かま"]],"text":"もし人が悔い改めないならば、神はそのつるぎをとぎ、その弓を張って構え、"},{"ref":"Ps.7.13","start":19007013,"end":19007013,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"し"],[4,1,"いた"],[8,2,"ぶき"],[11,1,"そな"],[16,1,"や"],[18,2,"ひや"]],"text":"また死に至らせる武器を備え、その矢を火矢とされる。"},{"ref":"Ps.7.14","start":19007014,"end":19007014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"み"],[3,1,"あ"],[6,1,"もの"],[8,2,"じゃあく"],[15,2,"がいどく"],[22,1,"いつわ"],[25,1,"う"]],"text":"見よ、悪しき者は邪悪をはらみ、害毒をやどし、偽りを生む。"},{"ref":"Ps.7.15","start":19007015,"end":19007015,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[2,1,"あな"],[4,1,"ほ"],[11,1,"ふか"],[19,1,"つく"],[22,1,"あな"],[24,1,"おちい"]],"text":"彼は穴を掘って、それを深くし、みずから作った穴に陥る。"},{"ref":"Ps.7.16","start":19007016,"end":19007016,"break":"line","breaks":[[15,"line"]],"ruby":[[2,2,"がいどく"],[5,2,"じぶん"],[12,1,"かえ"],[17,2,"きょうぼう"],[20,2,"じぶん"],[27,1,"くだ"]],"text":"その害毒は自分のかしらに帰り、その強暴は自分のこうべに下る。"},{"ref":"Ps.7.17","start":19007017,"end":19007017,"break":"line","breaks":[[11,"line"],[27,"line"]],"ruby":[[4,1,"しゅ"],[13,1,"ぎ"],[20,2,"かんしゃ"],[29,1,"たか"],[31,1,"もの"],[34,1,"しゅ"],[36,1,"な"],[40,1,"うた"]],"text":"わたしは主にむかって、その義にふさわしい感謝をささげ、いと高き者なる主の名をほめ歌うであろう。"}]