[{"ref":"Rev.5.1","start":66005001,"end":66005001,"break":"paragraph","ruby":[[7,2,"みざ"],[16,1,"みぎ"],[18,1,"て"],[21,2,"まきもの"],[28,1,"み"],[33,2,"うちがわ"],[37,2,"そとがわ"],[41,1,"じ"],[43,1,"か"],[53,2,"ふういん"],[56,1,"ふう"]],"text":"わたしはまた、御座にいますかたの右の手に、巻物があるのを見た。その内側にも外側にも字が書いてあって、七つの封印で封じてあった。"},{"ref":"Rev.5.2","start":66005002,"end":66005002,"break":"none","ruby":[[7,1,"つよ"],[9,2,"みつかい"],[13,2,"おおごえ"],[20,2,"まきもの"],[23,1,"ひら"],[26,2,"ふういん"],[38,1,"もの"],[46,1,"よ"],[55,1,"み"]],"text":"また、ひとりの強い御使が、大声で、「その巻物を開き、封印をとくのにふさわしい者は、だれか」と呼ばわっているのを見た。"},{"ref":"Rev.5.3","start":66005003,"end":66005003,"break":"none","ruby":[[4,1,"てん"],[7,1,"ち"],[10,1,"ち"],[12,1,"した"],[18,2,"まきもの"],[21,1,"ひら"],[28,1,"み"],[36,1,"もの"]],"text":"しかし、天にも地にも地の下にも、この巻物を開いて、それを見ることのできる者は、ひとりもいなかった。"},{"ref":"Rev.5.4","start":66005004,"end":66005004,"break":"none","ruby":[[0,2,"まきもの"],[3,1,"ひら"],[9,1,"み"],[18,1,"もの"],[20,2,"みあた"],[32,1,"はげ"],[35,1,"な"]],"text":"巻物を開いてそれを見るのにふさわしい者が見当らないので、わたしは激しく泣いていた。"},{"ref":"Rev.5.5","start":66005005,"end":66005005,"break":"none","ruby":[[4,2,"ちょうろう"],[15,1,"い"],[20,1,"な"],[24,1,"み"],[29,1,"ぞく"],[38,1,"わか"],[39,1,"えだ"],[47,2,"しょうり"],[50,1,"え"],[57,2,"まきもの"],[60,1,"ひら"],[65,2,"ふういん"],[68,1,"と"]],"text":"すると、長老のひとりがわたしに言った、「泣くな。見よ、ユダ族のしし、ダビデの若枝であるかたが、勝利を得たので、その巻物を開き七つの封印を解くことができる」。"},{"ref":"Rev.5.6","start":66005006,"end":66005006,"break":"paragraph","ruby":[[7,2,"みざ"],[13,1,"い"],[15,1,"もの"],[18,1,"あいだ"],[20,2,"ちょうろう"],[25,1,"あいだ"],[37,2,"こひつじ"],[40,1,"た"],[47,1,"み"],[56,1,"つの"],[61,1,"め"],[72,1,"め"],[75,1,"ぜん"],[76,2,"せかい"],[86,1,"かみ"],[91,1,"れい"]],"text":"わたしはまた、御座と四つの生き物との間、長老たちの間に、ほふられたとみえる小羊が立っているのを見た。それに七つの角と七つの目とがあった。これらの目は、全世界につかわされた、神の七つの霊である。"},{"ref":"Rev.5.7","start":66005007,"end":66005007,"break":"none","ruby":[[0,2,"こひつじ"],[3,1,"すす"],[5,1,"で"],[8,2,"みざ"],[17,1,"みぎ"],[19,1,"て"],[23,2,"まきもの"],[26,1,"う"]],"text":"小羊は進み出て、御座にいますかたの右の手から、巻物を受けとった。"},{"ref":"Rev.5.8","start":66005008,"end":66005008,"break":"none","ruby":[[0,2,"まきもの"],[3,1,"う"],[8,1,"とき"],[13,1,"い"],[15,1,"もの"],[20,1,"にん"],[22,2,"ちょうろう"],[32,2,"たてごと"],[36,1,"こう"],[38,1,"み"],[43,1,"きん"],[45,1,"はち"],[48,1,"て"],[50,1,"も"],[54,2,"こひつじ"],[57,1,"まえ"],[61,1,"ふ"],[67,1,"こう"],[69,2,"せいと"],[72,1,"いのり"]],"text":"巻物を受けとった時、四つの生き物と二十四人の長老とは、おのおの、立琴と、香の満ちている金の鉢とを手に持って、小羊の前にひれ伏した。この香は聖徒の祈である。"},{"ref":"Rev.5.9","start":66005009,"end":66005009,"break":"none","ruby":[[0,1,"かれ"],[3,1,"あたら"],[6,1,"うた"],[8,1,"うた"],[11,1,"い"],[25,2,"まきもの"],[28,1,"う"],[33,2,"ふういん"],[36,1,"と"],[63,1,"ち"],[69,1,"かみ"],[79,2,"ぶぞく"],[82,2,"こくご"],[85,2,"みんぞく"],[88,2,"こくみん"],[91,1,"なか"],[94,2,"ひとびと"]],"text":"彼らは新しい歌を歌って言った、「あなたこそは、その巻物を受けとり、封印を解くにふさわしいかたであります。あなたはほふられ、その血によって、神のために、あらゆる部族、国語、民族、国民の中から人々をあがない、"},{"ref":"Rev.5.10","start":66005010,"end":66005010,"break":"none","ruby":[[6,1,"かみ"],[12,1,"かれ"],[15,2,"みくに"],[18,1,"たみ"],[22,2,"さいし"],[32,1,"かれ"],[35,2,"ちじょう"],[38,2,"しはい"],[43,1,"いた"]],"text":"わたしたちの神のために、彼らを御国の民とし、祭司となさいました。彼らは地上を支配するに至るでしょう」。"},{"ref":"Rev.5.11","start":66005011,"end":66005011,"break":"paragraph","ruby":[[3,1,"み"],[9,2,"みざ"],[12,1,"い"],[14,1,"もの"],[16,2,"ちょうろう"],[27,1,"おお"],[30,2,"みつかい"],[35,1,"こえ"],[37,1,"あ"],[42,1,"き"],[48,1,"かず"],[52,1,"いく"],[54,1,"ばい"],[58,1,"いく"],[60,1,"ばい"]],"text":"さらに見ていると、御座と生き物と長老たちとのまわりに、多くの御使たちの声が上がるのを聞いた。その数は万の幾万倍、千の幾千倍もあって、"},{"ref":"Rev.5.12","start":66005012,"end":66005012,"break":"none","breaks":[[9,"stanza"],[21,"line"],[44,"line"]],"ruby":[[0,2,"おおごえ"],[3,1,"さけ"],[15,2,"こひつじ"],[21,1,"ちから"],[24,1,"とみ"],[27,2,"ちえ"],[31,1,"いきお"],[40,2,"えいこう"],[49,1,"う"]],"text":"大声で叫んでいた、「ほふられた小羊こそは、力と、富と、知恵と、勢いと、ほまれと、栄光と、さんびとを受けるにふさわしい」。"},{"ref":"Rev.5.13","start":66005013,"end":66005013,"break":"none","breaks":[[59,"stanza"],[74,"line"],[93,"line"]],"ruby":[[7,1,"てん"],[9,1,"ち"],[11,1,"ち"],[13,1,"した"],[15,1,"うみ"],[17,1,"なか"],[25,1,"つく"],[40,1,"なか"],[51,1,"い"],[53,1,"こえ"],[55,1,"き"],[60,2,"みざ"],[69,2,"こひつじ"],[84,2,"えいこう"],[88,2,"けんりょく"],[93,2,"よよ"],[95,1,"かぎ"]],"text":"またわたしは、天と地、地の下と海の中にあるすべての造られたもの、そして、それらの中にあるすべてのものの言う声を聞いた、「御座にいますかたと小羊とに、さんびと、ほまれと、栄光と、権力とが、世々限りなくあるように」。"},{"ref":"Rev.5.14","start":66005014,"end":66005014,"break":"none","ruby":[[3,1,"い"],[5,1,"もの"],[12,1,"とな"],[15,2,"ちょうろう"],[22,1,"ふ"],[25,2,"れいはい"]],"text":"四つの生き物はアァメンと唱え、長老たちはひれ伏して礼拝した。"}]