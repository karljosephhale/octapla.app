[{"ref":"Ps.50.1","start":19050001,"end":19050001,"break":"paragraph","title":"アサフの歌","breaks":[[13,"line"],[31,"line"]],"ruby":[[0,3,"ぜんのうしゃ"],[5,1,"かみ"],[7,1,"しゅ"],[9,1,"みことのり"],[13,1,"ひ"],[15,1,"で"],[22,1,"ひ"],[24,1,"い"],[35,1,"ち"],[37,1,"す"],[39,1,"もの"],[41,1,"め"],[43,1,"あつ"]],"titleRuby":[[4,1,"うた"]],"text":"全能者なる神、主は詔して、日の出るところから日の入るところまであまねく地に住む者を召し集められる。"},{"ref":"Ps.50.2","start":19050002,"end":19050002,"break":"line","ruby":[[0,1,"かみ"],[2,1,"うるわ"],[17,1,"ひかり"],[19,1,"はな"]],"text":"神は麗しさのきわみであるシオンから光を放たれる。"},{"ref":"Ps.50.3","start":19050003,"end":19050003,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[4,1,"かみ"],[6,1,"き"],[17,1,"まえ"],[20,1,"や"],[25,1,"ひ"],[42,2,"ぼうふう"]],"text":"われらの神は来て、もだされない。み前には焼きつくす火があり、そのまわりには、はげしい暴風がある。"},{"ref":"Ps.50.4","start":19050004,"end":19050004,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かみ"],[4,1,"たみ"],[13,1,"うえ"],[16,1,"てん"],[20,1,"ち"],[22,1,"よ"]],"text":"神はその民をさばくために、上なる天および地に呼ばわれる、"},{"ref":"Ps.50.5","start":19050005,"end":19050005,"break":"line","breaks":[[19,"line"]],"ruby":[[13,2,"けいやく"],[16,1,"むす"],[21,2,"せいと"],[31,1,"あつ"]],"text":"「いけにえをもってわたしと契約を結んだわが聖徒をわたしのもとに集めよ」と。"},{"ref":"Ps.50.6","start":19050006,"end":19050006,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"てん"],[2,1,"かみ"],[4,1,"ぎ"],[11,1,"かみ"]],"text":"天は神の義をあらわす、神はみずから、さばきぬしだからである。〔セラ"},{"ref":"Ps.50.7","start":19050007,"end":19050007,"break":"line","breaks":[[16,"line"],[35,"line"],[42,"line"]],"ruby":[[3,1,"たみ"],[6,1,"き"],[13,1,"い"],[46,1,"かみ"],[52,1,"かみ"]],"text":"「わが民よ、聞け、わたしは言う。イスラエルよ、わたしはあなたにむかってあかしをなす。わたしは神、あなたの神である。"},{"ref":"Ps.50.8","start":19050008,"end":19050008,"break":"line","breaks":[[14,"line"],[30,"line"]],"ruby":[[8,1,"せ"],[34,2,"はんさい"],[44,1,"まえ"]],"text":"わたしがあなたを責めるのは、あなたのいけにえのゆえではない。あなたの燔祭はいつもわたしの前にある。"},{"ref":"Ps.50.9","start":19050009,"end":19050009,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"いえ"],[11,2,"おうし"],[14,1,"と"],[29,1,"お"],[33,1,"と"]],"text":"わたしはあなたの家から雄牛を取らない。またあなたのおりから雄やぎを取らない。"},{"ref":"Ps.50.10","start":19050010,"end":19050010,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"はやし"],[6,1,"けもの"],[15,1,"おか"],[17,1,"うえ"],[19,2,"ちぢ"],[22,2,"かちく"]],"text":"林のすべての獣はわたしのもの、丘の上の千々の家畜もわたしのものである。"},{"ref":"Ps.50.11","start":19050011,"end":19050011,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"そら"],[6,1,"とり"],[13,1,"し"],[19,1,"の"],[21,1,"うご"]],"text":"わたしは空の鳥をことごとく知っている。野に動くすべてのものはわたしのものである。"},{"ref":"Ps.50.12","start":19050012,"end":19050012,"break":"line","breaks":[[21,"line"],[35,"line"]],"ruby":[[7,1,"う"],[16,1,"つ"],[21,2,"せかい"],[26,1,"なか"],[28,1,"み"]],"text":"たといわたしは飢えても、あなたに告げない、世界とその中に満ちるものとはわたしのものだからである。"},{"ref":"Ps.50.13","start":19050013,"end":19050013,"break":"line","breaks":[[12,"line"]],"ruby":[[4,2,"おうし"],[7,1,"にく"],[9,1,"た"],[12,1,"お"],[16,1,"ち"],[18,1,"の"]],"text":"わたしは雄牛の肉を食べ、雄やぎの血を飲むだろうか。"},{"ref":"Ps.50.14","start":19050014,"end":19050014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"かんしゃ"],[8,1,"かみ"],[19,1,"ちか"],[24,1,"たか"],[26,1,"もの"],[28,1,"はた"]],"text":"感謝のいけにえを神にささげよ。あなたの誓いをいと高き者に果せ。"},{"ref":"Ps.50.15","start":19050015,"end":19050015,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"なや"],[3,1,"ひ"],[9,1,"よ"],[20,1,"たす"]],"text":"悩みの日にわたしを呼べ、わたしはあなたを助け、あなたはわたしをあがめるであろう」。"},{"ref":"Ps.50.16","start":19050016,"end":19050016,"break":"line","breaks":[[15,"line"],[39,"line"]],"ruby":[[3,1,"かみ"],[5,1,"あ"],[8,1,"もの"],[10,1,"い"],[23,2,"けんり"],[33,1,"さだ"],[36,1,"の"],[43,2,"けいやく"],[46,1,"くち"]],"text":"しかし神は悪しき者に言われる、「あなたはなんの権利があってわたしの定めを述べ、わたしの契約を口にするのか。"},{"ref":"Ps.50.17","start":19050017,"end":19050017,"break":"line","ruby":[[4,1,"おしえ"],[6,1,"にく"],[13,2,"ことば"],[16,1,"す"],[18,1,"さ"]],"text":"あなたは教を憎み、わたしの言葉を捨て去った。"},{"ref":"Ps.50.18","start":19050018,"end":19050018,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"ぬす"],[8,1,"み"],[18,2,"かんいん"],[21,1,"おこな"],[23,1,"もの"],[25,1,"まじ"]],"text":"あなたは盗びとを見ればこれとむつみ、姦淫を行う者と交わる。"},{"ref":"Ps.50.19","start":19050019,"end":19050019,"break":"line","breaks":[[14,"line"]],"ruby":[[6,1,"くち"],[8,1,"あく"],[18,1,"した"],[25,2,"しく"]],"text":"あなたはその口を悪にわたし、あなたの舌はたばかりを仕組む。"},{"ref":"Ps.50.20","start":19050020,"end":19050020,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"ざ"],[9,2,"きょうだい"],[16,2,"じぶん"],[19,1,"はは"],[21,1,"こ"]],"text":"あなたは座してその兄弟をそしり、自分の母の子をののしる。"},{"ref":"Ps.50.21","start":19050021,"end":19050021,"break":"line","breaks":[[27,"line"],[50,"line"],[64,"line"]],"ruby":[[8,1,"こと"],[19,1,"だま"],[35,1,"まった"],[37,2,"じぶん"],[44,1,"もの"],[46,1,"おも"],[61,1,"せ"],[68,1,"め"],[70,1,"まえ"],[74,1,"つみ"]],"text":"あなたがこれらの事をしたのを、わたしが黙っていたので、あなたはわたしを全く自分とひとしい者と思った。しかしわたしはあなたを責め、あなたの目の前にその罪をならべる。"},{"ref":"Ps.50.22","start":19050022,"end":19050022,"break":"line","breaks":[[16,"line"],[34,"line"]],"ruby":[[0,1,"かみ"],[2,1,"わす"],[5,1,"もの"],[13,1,"おも"],[31,1,"さ"],[41,1,"たす"],[44,1,"もの"]],"text":"神を忘れる者よ、このことを思え。さもないとわたしはあなたをかき裂く。そのときだれも助ける者はないであろう。"},{"ref":"Ps.50.23","start":19050023,"end":19050023,"break":"line","breaks":[[23,"line"]],"ruby":[[0,2,"かんしゃ"],[12,1,"もの"],[23,2,"じぶん"],[31,1,"つつし"],[33,1,"もの"],[40,1,"かみ"],[42,1,"すくい"],[44,1,"しめ"]],"text":"感謝のいけにえをささげる者はわたしをあがめる。自分のおこないを慎む者にはわたしは神の救を示す」。"}]