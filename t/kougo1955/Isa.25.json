[{"ref":"Isa.25.1","start":23025001,"end":23025001,"break":"paragraph","breaks":[[11,"line"],[33,"line"],[51,"line"],[63,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"かみ"],[24,1,"な"],[40,1,"おどろ"],[48,1,"おこな"],[57,1,"さだ"],[60,2,"けいかく"],[63,2,"しんじつ"],[69,1,"おこな"]],"text":"主よ、あなたはわが神、わたしはあなたをあがめ、み名をほめたたえる。あなたはさきに驚くべきみわざを行い、いにしえから定めた計画を真実をもって行われたから。"},{"ref":"Isa.25.2","start":23025002,"end":23025002,"break":"line","breaks":[[23,"line"],[41,"line"]],"ruby":[[4,1,"まち"],[6,2,"いしづか"],[11,2,"けんご"],[14,1,"まち"],[16,2,"あらつか"],[23,2,"がいこく"],[25,1,"じん"],[35,1,"まち"],[46,1,"た"]],"text":"あなたは町を石塚とし、堅固な町を荒塚とされた。外国人のやかたは、もはや町ではなく、とこしえに建てられることはない。"},{"ref":"Isa.25.3","start":23025003,"end":23025003,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"つよ"],[7,1,"たみ"],[13,1,"たっと"],[20,2,"くにぐに"],[23,1,"まち"],[29,1,"おそ"]],"text":"それゆえ、強い民はあなたを尊び、あらぶる国々の町はあなたを恐れる。"},{"ref":"Isa.25.4","start":23025004,"end":23025004,"break":"line","breaks":[[16,"line"],[34,"line"],[48,"line"],[61,"line"],[73,"line"]],"ruby":[[4,1,"まず"],[7,1,"もの"],[16,1,"とぼ"],[19,1,"もの"],[21,1,"なや"],[41,1,"さ"],[43,1,"どころ"],[48,1,"あつ"],[54,1,"かげ"],[65,1,"もの"],[67,1,"およ"],[70,1,"がい"],[73,1,"いし"],[77,1,"う"]],"text":"あなたは貧しい者のとりでとなり、乏しい者の悩みのときのとりでとなり、あらしをさける避け所となり、熱さをさける陰となられた。あらぶる者の及ぼす害は、石がきを打つあらしのごとく、"},{"ref":"Isa.25.5","start":23025005,"end":23025005,"break":"line","breaks":[[18,"line"],[33,"line"],[49,"line"]],"ruby":[[4,1,"ち"],[6,1,"あつ"],[22,2,"がいこく"],[24,1,"じん"],[26,1,"さわ"],[33,1,"くも"],[35,1,"かげ"],[40,1,"ねつ"],[53,1,"もの"],[55,1,"うた"]],"text":"かわいた地の熱さのようだからである。あなたは外国人の騒ぎをおさえ、雲が陰をもって熱をとどめるようにあらぶる者の歌をとどめられる。"},{"ref":"Isa.25.6","start":23025006,"end":23025006,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"やま"],[14,1,"たみ"],[19,1,"こ"],[28,2,"しゅくえん"],[31,1,"もう"],[34,1,"ひさ"],[45,1,"しゅ"],[50,2,"しゅくえん"],[53,1,"もう"],[63,1,"ずい"],[65,1,"おお"],[67,1,"こ"],[76,1,"す"],[79,1,"なが"],[89,1,"しゅ"],[94,2,"しゅくえん"],[97,1,"もう"]],"text":"万軍の主はこの山で、すべての民のために肥えたものをもって祝宴を設け、久しくたくわえたぶどう酒をもって祝宴を設けられる。すなわち髄の多い肥えたものと、よく澄んだ長くたくわえたぶどう酒をもって祝宴を設けられる。"},{"ref":"Isa.25.7","start":23025007,"end":23025007,"break":"none","ruby":[[2,1,"しゅ"],[6,1,"やま"],[13,1,"たみ"],[21,1,"かお"],[31,1,"くに"],[42,1,"もの"],[45,1,"やぶ"]],"text":"また主はこの山で、すべての民のかぶっている顔おおいと、すべての国のおおっているおおい物とを破られる。"},{"ref":"Isa.25.8","start":23025008,"end":23025008,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"し"],[9,1,"ほろ"],[13,1,"しゅ"],[16,1,"かみ"],[22,1,"かお"],[25,1,"なみだ"],[33,1,"たみ"],[41,1,"ぜん"],[42,1,"ち"],[44,1,"うえ"],[47,1,"のぞ"],[55,1,"しゅ"],[57,1,"かた"]],"text":"主はとこしえに死を滅ぼし、主なる神はすべての顔から涙をぬぐい、その民のはずかしめを全地の上から除かれる。これは主の語られたことである。"},{"ref":"Isa.25.9","start":23025009,"end":23025009,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"ひと"],[6,1,"い"],[10,1,"み"],[21,1,"かみ"],[32,1,"かれ"],[34,1,"ま"],[36,1,"のぞ"],[40,1,"かれ"],[48,1,"すく"],[56,1,"しゅ"],[67,1,"かれ"],[69,1,"ま"],[71,1,"のぞ"],[83,1,"すくい"],[85,1,"よろこ"],[87,1,"たの"]],"text":"その日、人は言う、「見よ、これはわれわれの神である。わたしたちは彼を待ち望んだ。彼はわたしたちを救われる。これは主である。わたしたちは彼を待ち望んだ。わたしたちはその救を喜び楽しもう」と。"},{"ref":"Isa.25.10","start":23025010,"end":23025010,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"て"],[6,1,"やま"],[17,1,"こえ"],[21,1,"なか"],[23,1,"ふ"],[38,1,"ところ"],[40,1,"ふ"]],"text":"主の手はこの山にとどまり、モアブは肥だめの中に踏まれるわらのように、おのれの所で踏みにじられる。"},{"ref":"Isa.25.11","start":23025011,"end":23025011,"break":"none","ruby":[[0,1,"かれ"],[4,1,"なか"],[6,1,"およ"],[8,1,"もの"],[10,1,"およ"],[16,1,"て"],[18,1,"の"],[27,1,"て"],[29,1,"の"],[36,1,"しゅ"],[40,1,"たか"],[47,1,"て"],[49,1,"たく"],[55,1,"とも"],[57,1,"ひく"]],"text":"彼はその中で泳ぐ物が泳ごうとして手を伸ばすように、その手を伸ばす。しかし主はその高ぶりを、その手の巧みなわざと共に低くされる。"},{"ref":"Isa.25.12","start":23025012,"end":23025012,"break":"none","ruby":[[2,1,"いし"],[6,1,"たか"],[8,2,"じょうかく"],[11,1,"しゅ"],[13,1,"かたむ"],[15,1,"たお"],[18,1,"ち"],[20,1,"な"]],"text":"その石がきの高い城郭を主は傾け倒し、地に投げうって、ちりにかえされる。"}]