[{"ref":"Gen.32.1","start":1032001,"end":1032001,"break":"paragraph","ruby":[[7,2,"たびじ"],[10,1,"すす"],[16,1,"かみ"],[18,1,"つかい"],[22,1,"かれ"],[24,1,"あ"]],"text":"さて、ヤコブが旅路に進んだとき、神の使たちが彼に会った。"},{"ref":"Gen.32.2","start":1032002,"end":1032002,"break":"none","ruby":[[4,1,"かれ"],[7,1,"み"],[14,1,"かみ"],[16,2,"じんえい"],[22,1,"い"],[28,1,"ところ"],[30,1,"な"],[38,1,"な"]],"text":"ヤコブは彼らを見て、「これは神の陣営です」と言って、その所の名をマハナイムと名づけた。"},{"ref":"Gen.32.3","start":1032003,"end":1032003,"break":"paragraph","ruby":[[8,1,"ち"],[14,1,"の"],[16,1,"す"],[18,1,"あに"],[32,2,"ししゃ"]],"text":"ヤコブはセイルの地、エドムの野に住む兄エサウのもとに、さきだって使者をつかわした。"},{"ref":"Gen.32.4","start":1032004,"end":1032004,"break":"none","ruby":[[7,1,"めい"],[10,1,"い"],[25,2,"しゅじん"],[33,1,"い"],[53,1,"い"],[70,2,"きりゅう"],[74,1,"いま"]],"text":"すなわちそれに命じて言った、「あなたがたはわたしの主人エサウにこう言いなさい、『あなたのしもべヤコブはこう言いました。わたしはラバンのもとに寄留して今までとどまりました。"},{"ref":"Gen.32.5","start":1032005,"end":1032005,"break":"none","ruby":[[4,1,"うし"],[9,1,"ひつじ"],[11,2,"だんじょ"],[14,2,"どれい"],[17,1,"も"],[29,1,"しゅ"],[31,1,"もう"],[33,1,"あ"],[41,1,"まえ"],[43,1,"めぐ"],[46,1,"え"],[50,1,"ひと"]],"text":"わたしは牛、ろば、羊、男女の奴隷を持っています。それでわが主に申し上げて、あなたの前に恵みを得ようと人をつかわしたのです』」。"},{"ref":"Gen.32.6","start":1032006,"end":1032006,"break":"paragraph","ruby":[[0,2,"ししゃ"],[10,1,"かえ"],[13,1,"い"],[28,1,"あに"],[36,1,"い"],[42,1,"かれ"],[50,1,"むか"],[57,1,"にん"],[59,1,"ひき"]],"text":"使者はヤコブのもとに帰って言った、「わたしたちはあなたの兄エサウのもとへ行きました。彼もまたあなたを迎えようと四百人を率いてきます」。"},{"ref":"Gen.32.7","start":1032007,"end":1032007,"break":"none","ruby":[[7,1,"おお"],[10,1,"おそ"],[13,1,"くる"],[17,1,"とも"],[21,1,"たみ"],[25,1,"ひつじ"],[27,1,"うし"],[36,1,"くみ"],[38,1,"わ"]],"text":"そこでヤコブは大いに恐れ、苦しみ、共にいる民および羊、牛、らくだを二つの組に分けて、"},{"ref":"Gen.32.8","start":1032008,"end":1032008,"break":"none","ruby":[[0,1,"い"],[19,1,"くみ"],[21,1,"う"],[26,1,"のこ"],[29,1,"くみ"]],"text":"言った、「たとい、エサウがきて、一つの組を撃っても、残りの組はのがれるであろう」。"},{"ref":"Gen.32.9","start":1032009,"end":1032009,"break":"paragraph","ruby":[[6,1,"い"],[11,1,"ちち"],[18,1,"かみ"],[20,1,"ちち"],[25,1,"かみ"],[40,1,"くに"],[42,1,"かえ"],[49,2,"しんぞく"],[52,1,"い"],[63,1,"めぐ"],[68,1,"い"],[72,1,"しゅ"]],"text":"ヤコブはまた言った、「父アブラハムの神、父イサクの神よ、かつてわたしに『おまえの国へ帰り、おまえの親族に行け。わたしはおまえを恵もう』と言われた主よ、"},{"ref":"Gen.32.10","start":1032010,"end":1032010,"break":"none","ruby":[[8,1,"ほどこ"],[16,1,"めぐ"],[27,1,"う"],[31,1,"た"],[35,1,"もの"],[49,1,"なに"],[51,1,"も"],[63,1,"わた"],[70,1,"いま"],[75,1,"くみ"]],"text":"あなたがしもべに施されたすべての恵みとまことをわたしは受けるに足りない者です。わたしは、つえのほか何も持たないでこのヨルダンを渡りましたが、今は二つの組にもなりました。"},{"ref":"Gen.32.11","start":1032011,"end":1032011,"break":"none","ruby":[[4,1,"あに"],[9,1,"て"],[17,1,"すく"],[28,1,"かれ"],[37,1,"う"],[40,1,"はは"],[42,2,"こども"],[49,1,"およ"],[53,1,"おそ"]],"text":"どうぞ、兄エサウの手からわたしをお救いください。わたしは彼がきて、わたしを撃ち、母や子供たちにまで及ぶのを恐れます。"},{"ref":"Gen.32.12","start":1032012,"end":1032012,"break":"none","ruby":[[14,1,"かなら"],[20,1,"めぐ"],[27,2,"しそん"],[30,1,"うみ"],[32,1,"すな"],[34,1,"かぞ"],[41,1,"おお"],[48,1,"い"]],"text":"あなたは、かつて、『わたしは必ずおまえを恵み、おまえの子孫を海の砂の数えがたいほど多くしよう』と言われました」。"},{"ref":"Gen.32.13","start":1032013,"end":1032013,"break":"paragraph","ruby":[[0,1,"かれ"],[4,1,"よ"],[8,1,"やど"],[11,1,"も"],[13,1,"もの"],[19,1,"あに"],[25,1,"おく"],[27,1,"もの"],[29,1,"えら"]],"text":"彼はその夜そこに宿り、持ち物のうちから兄エサウへの贈り物を選んだ。"},{"ref":"Gen.32.14","start":1032014,"end":1032014,"break":"none","ruby":[[4,1,"め"],[10,1,"お"],[16,1,"め"],[17,1,"ひつじ"],[21,2,"おひつじ"]],"text":"すなわち雌やぎ二百、雄やぎ二十、雌羊二百、雄羊二十、"},{"ref":"Gen.32.15","start":1032015,"end":1032015,"break":"none","ruby":[[0,1,"ちち"],[9,1,"こ"],[11,2,"めうし"],[16,2,"おうし"],[20,1,"め"],[26,1,"お"]],"text":"乳らくだ三十とその子、雌牛四十、雄牛十、雌ろば二十、雄ろば十。"},{"ref":"Gen.32.16","start":1032016,"end":1032016,"break":"none","ruby":[[0,1,"かれ"],[11,1,"む"],[14,1,"わ"],[24,1,"て"],[36,1,"い"],[51,1,"さき"],[53,1,"すす"],[62,1,"む"],[65,1,"む"],[69,1,"あいだ"],[72,1,"へだ"]],"text":"彼はこれらをそれぞれの群れに分けて、しもべたちの手にわたし、しもべたちに言った、「あなたがたはわたしの先に進みなさい、そして群れと群れとの間には隔たりをおきなさい」。"},{"ref":"Gen.32.17","start":1032017,"end":1032017,"break":"none","ruby":[[2,2,"せんとう"],[5,1,"もの"],[7,1,"めい"],[10,1,"い"],[18,1,"あに"],[27,1,"あ"],[42,1,"い"],[51,1,"まえ"],[65,1,"もの"],[69,1,"たず"]],"text":"また先頭の者に命じて言った、「もし、兄エサウがあなたに会って『だれのしもべで、どこへ行くのか。あなたの前にあるこれらのものはだれの物か』と尋ねたら、"},{"ref":"Gen.32.18","start":1032018,"end":1032018,"break":"none","ruby":[[12,1,"もの"],[17,1,"しゅ"],[25,1,"おく"],[27,1,"もの"],[31,1,"かれ"],[49,1,"い"]],"text":"『あなたのしもべヤコブの物で、わが主エサウにおくる贈り物です。彼もわたしたちのうしろにおります』と言いなさい」。"},{"ref":"Gen.32.19","start":1032019,"end":1032019,"break":"none","ruby":[[0,1,"かれ"],[2,1,"だい"],[5,1,"もの"],[9,1,"だい"],[12,1,"もの"],[18,1,"む"],[20,1,"む"],[26,1,"い"],[32,1,"もの"],[35,1,"めい"],[38,1,"い"],[53,1,"あ"],[59,1,"おな"],[64,1,"かれ"],[66,1,"つ"]],"text":"彼は第二の者にも、第三の者にも、また群れ群れについて行くすべての者にも命じて言った、「あなたがたがエサウに会うときは、同じように彼に告げて、"},{"ref":"Gen.32.20","start":1032020,"end":1032020,"break":"none","ruby":[[27,1,"い"],[47,1,"おく"],[49,1,"おく"],[51,1,"もの"],[58,1,"かれ"],[69,1,"かれ"],[71,1,"かお"],[73,1,"み"],[83,1,"かれ"],[89,1,"むか"],[101,1,"おも"]],"text":"『あなたのしもべヤコブもわれわれのうしろにおります』と言いなさい」。ヤコブは、「わたしがさきに送る贈り物をもってまず彼をなだめ、それから、彼の顔を見よう。そうすれば、彼はわたしを迎えてくれるであろう」と思ったからである。"},{"ref":"Gen.32.21","start":1032021,"end":1032021,"break":"none","ruby":[[4,1,"おく"],[6,1,"もの"],[8,1,"かれ"],[10,2,"さきだ"],[14,1,"わた"],[17,1,"かれ"],[21,1,"よ"],[23,2,"しゅくえい"]],"text":"こうして贈り物は彼に先立って渡り、彼はその夜、宿営にやどった。"},{"ref":"Gen.32.22","start":1032022,"end":1032022,"break":"paragraph","ruby":[[0,1,"かれ"],[4,1,"よ"],[5,1,"お"],[13,1,"つま"],[26,1,"にん"],[28,1,"こ"],[33,1,"つ"],[40,1,"わた"]],"text":"彼はその夜起きて、ふたりの妻とふたりのつかえめと十一人の子どもとを連れてヤボクの渡しをわたった。"},{"ref":"Gen.32.23","start":1032023,"end":1032023,"break":"none","ruby":[[4,1,"かれ"],[7,1,"みちび"],[10,1,"かわ"],[12,1,"わた"],[18,1,"かれ"],[20,1,"も"],[22,1,"もの"],[24,1,"わた"]],"text":"すなわち彼らを導いて川を渡らせ、また彼の持ち物を渡らせた。"},{"ref":"Gen.32.24","start":1032024,"end":1032024,"break":"none","ruby":[[10,1,"のこ"],[19,1,"ひと"],[22,2,"よあ"],[27,1,"かれ"],[29,2,"くみう"]],"text":"ヤコブはひとりあとに残ったが、ひとりの人が、夜明けまで彼と組打ちした。"},{"ref":"Gen.32.25","start":1032025,"end":1032025,"break":"none","ruby":[[6,1,"ひと"],[12,1,"か"],[18,1,"み"],[53,1,"ひと"],[55,2,"くみう"]],"text":"ところでその人はヤコブに勝てないのを見て、ヤコブのもものつがいにさわったので、ヤコブのもものつがいが、その人と組打ちするあいだにはずれた。"},{"ref":"Gen.32.26","start":1032026,"end":1032026,"break":"none","ruby":[[2,1,"ひと"],[4,1,"い"],[9,1,"よ"],[11,1,"あ"],[20,1,"さ"],[34,1,"こた"],[43,2,"しゅくふく"],[60,1,"さ"]],"text":"その人は言った、「夜が明けるからわたしを去らせてください」。ヤコブは答えた、「わたしを祝福してくださらないなら、あなたを去らせません」。"},{"ref":"Gen.32.27","start":1032027,"end":1032027,"break":"none","ruby":[[2,1,"ひと"],[4,1,"かれ"],[6,1,"い"],[15,1,"な"],[20,1,"い"],[27,1,"かれ"],[29,1,"こた"]],"text":"その人は彼に言った、「あなたの名はなんと言いますか」。彼は答えた、「ヤコブです」。"},{"ref":"Gen.32.28","start":1032028,"end":1032028,"break":"none","ruby":[[2,1,"ひと"],[4,1,"い"],[16,1,"な"],[22,1,"い"],[32,1,"い"],[42,1,"かみ"],[44,1,"ひと"],[48,1,"ちから"],[50,1,"あらそ"],[53,1,"か"]],"text":"その人は言った、「あなたはもはや名をヤコブと言わず、イスラエルと言いなさい。あなたが神と人とに、力を争って勝ったからです」。"},{"ref":"Gen.32.29","start":1032029,"end":1032029,"break":"none","ruby":[[4,1,"たず"],[7,1,"い"],[23,1,"な"],[25,1,"し"],[40,1,"ひと"],[54,1,"な"],[64,1,"い"],[71,1,"ところ"],[73,1,"かれ"],[75,2,"しゅくふく"]],"text":"ヤコブは尋ねて言った、「どうかわたしにあなたの名を知らせてください」。するとその人は、「なぜあなたはわたしの名をきくのですか」と言ったが、その所で彼を祝福した。"},{"ref":"Gen.32.30","start":1032030,"end":1032030,"break":"none","ruby":[[9,1,"ところ"],[11,1,"な"],[18,1,"な"],[22,1,"い"],[31,1,"かお"],[33,1,"かお"],[39,1,"かみ"],[41,1,"み"],[47,1,"い"]],"text":"そこでヤコブはその所の名をペニエルと名づけて言った、「わたしは顔と顔をあわせて神を見たが、なお生きている」。"},{"ref":"Gen.32.31","start":1032031,"end":1032031,"break":"none","ruby":[[4,1,"かれ"],[11,1,"す"],[14,1,"とき"],[16,1,"ひ"],[18,1,"かれ"],[20,1,"うえ"],[28,1,"かれ"],[42,1,"ひ"]],"text":"こうして彼がペニエルを過ぎる時、日は彼の上にのぼったが、彼はそのもものゆえにびっこを引いていた。"},{"ref":"Gen.32.32","start":1032032,"end":1032032,"break":"none","ruby":[[11,1,"こ"],[14,2,"こんにち"],[26,1,"うえ"],[30,1,"こし"],[32,1,"すじ"],[34,1,"た"],[41,1,"ひと"],[58,1,"こし"],[60,1,"すじ"]],"text":"そのため、イスラエルの子らは今日まで、もものつがいの上にある腰の筋を食べない。かの人がヤコブのもものつがい、すなわち腰の筋にさわったからである。"}]