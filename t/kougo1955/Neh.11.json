[{"ref":"Neh.11.1","start":16011001,"end":16011001,"break":"paragraph","ruby":[[0,1,"たみ"],[14,1,"す"],[19,1,"た"],[21,1,"たみ"],[26,1,"ひ"],[31,1,"にん"],[44,2,"せいと"],[52,1,"き"],[54,1,"す"],[59,1,"にん"],[61,1,"た"],[63,2,"まちまち"],[66,1,"す"]],"text":"民のつかさたちはエルサレムに住み、その他の民はくじを引いて、十人のうちからひとりずつを、聖都エルサレムに来て住ませ、九人を他の町々に住ませた。"},{"ref":"Neh.11.2","start":16011002,"end":16011002,"break":"none","ruby":[[9,1,"すす"],[19,1,"す"],[24,1,"もう"],[26,1,"で"],[28,2,"ひとびと"],[32,1,"たみ"],[37,2,"しゅくふく"]],"text":"またすべてみずから進みでてエルサレムに住むことを申し出た人々は、民はこれを祝福した。"},{"ref":"Neh.11.3","start":16011003,"end":16011003,"break":"paragraph","ruby":[[8,1,"す"],[13,1,"しゅう"],[15,1,"ちょう"],[19,1,"つぎ"],[34,2,"まちまち"],[44,2,"まちまち"],[49,2,"じぶん"],[52,2,"しょゆう"],[54,1,"ち"],[56,1,"す"],[72,2,"さいし"],[80,1,"みや"],[82,1,"つか"],[104,1,"もの"],[108,2,"しそん"]],"text":"さてエルサレムに住んだこの州の長たちは次のとおりである。ただしユダの町々ではおのおのその町々にある自分の所有地に住んだ。すなわちイスラエルびと、祭司、レビびと、宮に仕えるしもべ、およびソロモンのしもべであった者たちの子孫である。"},{"ref":"Neh.11.4","start":16011004,"end":16011004,"break":"none","ruby":[[13,2,"しそん"],[24,2,"しそん"],[32,1,"もの"],[36,1,"す"],[47,2,"しそん"],[55,1,"こ"],[70,1,"こ"],[82,1,"こ"],[94,1,"こ"],[107,1,"こ"],[119,2,"しそん"]],"text":"そしてエルサレムにはユダの子孫およびベニヤミンの子孫のうちのある者たちが住んだ。すなわちユダの子孫ではウジヤの子アタヤで、ウジヤはゼカリヤの子、ゼカリヤはアマリヤの子、アマリヤはシパテヤの子、シパテヤはマハラレルの子、マハラレルはペレヅの子孫である。"},{"ref":"Neh.11.5","start":16011005,"end":16011005,"break":"none","ruby":[[6,1,"こ"],[22,1,"こ"],[33,1,"こ"],[43,1,"こ"],[54,1,"こ"],[66,1,"こ"],[79,1,"こ"]],"text":"またバルクの子マアセヤで、バルクはコロホゼの子、コロホゼはハザヤの子、ハザヤはアダヤの子、アダヤはヨヤリブの子、ヨヤリブはゼカリヤの子、ゼカリヤはシロニびとの子である。"},{"ref":"Neh.11.6","start":16011006,"end":16011006,"break":"none","ruby":[[4,2,"しそん"],[13,1,"す"],[16,1,"もの"],[18,1,"あ"],[27,1,"にん"],[32,2,"ゆうかん"],[35,2,"ひとびと"]],"text":"ペレヅの子孫でエルサレムに住んだ者は合わせて四百六十八人で、みな勇敢な人々である。"},{"ref":"Neh.11.7","start":16011007,"end":16011007,"break":"paragraph","ruby":[[6,2,"しそん"],[10,1,"つぎ"],[29,1,"こ"],[44,1,"こ"],[54,1,"こ"],[64,1,"こ"],[75,1,"こ"],[87,1,"こ"],[98,1,"こ"]],"text":"ベニヤミンの子孫では次のとおりである。すなわちメシュラムの子サルで、メシュラムはヨエデの子、ヨエデはペダヤの子、ペダヤはコラヤの子、コラヤはマアセヤの子、マアセヤはイテエルの子、イテエルはエサヤの子である。"},{"ref":"Neh.11.8","start":16011008,"end":16011008,"break":"none","ruby":[[2,1,"つぎ"],[16,1,"あ"],[25,1,"にん"]],"text":"その次はガバイおよびサライなどで合わせて九百二十八人。"},{"ref":"Neh.11.9","start":16011009,"end":16011009,"break":"none","ruby":[[4,1,"こ"],[9,1,"かれ"],[12,2,"かんとく"],[24,1,"こ"],[30,2,"ふくかん"],[35,1,"まち"],[37,1,"おさ"]],"text":"ジクリの子ヨエルが彼らの監督である。ハッセヌアの子ユダがその副官として町を治めた。"},{"ref":"Neh.11.10","start":16011010,"end":16011010,"break":"paragraph","ruby":[[0,2,"さいし"],[9,1,"こ"]],"text":"祭司ではヨヤリブの子エダヤ、ヤキン、"},{"ref":"Neh.11.11","start":16011011,"end":16011011,"break":"none","ruby":[[3,1,"かみ"],[5,1,"みや"],[24,1,"こ"],[37,1,"こ"],[49,1,"こ"],[60,1,"こ"],[72,1,"こ"]],"text":"および神の宮のつかさセラヤで、セラヤはヒルキヤの子、ヒルキヤはメシュラムの子、メシュラムはザドクの子、ザドクはメラヨテの子、メラヨテはアヒトブの子である。"},{"ref":"Neh.11.12","start":16011012,"end":16011012,"break":"none","ruby":[[0,1,"みや"],[2,1,"つとめ"],[8,2,"きょうだい"],[16,1,"にん"],[28,1,"こ"],[46,1,"こ"],[57,1,"こ"],[68,1,"こ"],[80,1,"こ"],[92,1,"こ"]],"text":"宮の務をするその兄弟は八百二十二人あり、また、エロハムの子アダヤがある。エロハムはペラリヤの子、ペラリヤはアムジの子、アムジはゼカリヤの子、ゼカリヤはパシホルの子、パシホルはマルキヤの子である。"},{"ref":"Neh.11.13","start":16011013,"end":16011013,"break":"none","ruby":[[4,2,"きょうだい"],[8,2,"しぞく"],[11,1,"ちょう"],[14,1,"もの"],[21,1,"にん"],[33,1,"こ"],[54,1,"こ"],[67,1,"こ"],[80,1,"こ"]],"text":"アダヤの兄弟で、氏族の長たる者は二百四十二人あり、またアザリエルの子アマシサイがある。アザリエルはアハザイの子、アハザイはメシレモテの子、メシレモテはインメルの子である。"},{"ref":"Neh.11.14","start":16011014,"end":16011014,"break":"none","ruby":[[2,2,"きょうだい"],[7,2,"ゆうし"],[14,1,"にん"],[20,2,"かんとく"],[30,1,"こ"]],"text":"その兄弟である勇士は百二十八人あり、その監督はハッゲドリムの子ザブデエルである。"},{"ref":"Neh.11.15","start":16011015,"end":16011015,"break":"paragraph","ruby":[[11,1,"こ"],[28,1,"こ"],[42,1,"こ"],[54,1,"こ"]],"text":"レビびとではハシュブの子シマヤで、ハシュブはアズリカムの子、アズリカムはハシャビヤの子、ハシャビヤはブンニの子である。"},{"ref":"Neh.11.16","start":16011016,"end":16011016,"break":"none","ruby":[[35,1,"かみ"],[37,1,"みや"],[39,1,"そと"]],"text":"またシャベタイおよびヨザバデがある。これらはレビびとのかしらであって、神の宮の外のわざをつかさどった。"},{"ref":"Neh.11.17","start":16011017,"end":16011017,"break":"none","ruby":[[5,1,"こ"],[22,1,"こ"],[32,1,"こ"],[43,1,"いのり"],[45,1,"とき"],[47,2,"かんしゃ"],[50,2,"ことば"],[53,1,"とな"],[55,1,"はじ"],[58,1,"もの"],[65,2,"きょうだい"],[77,1,"かれ"],[79,1,"つ"],[81,1,"もの"],[94,1,"こ"],[111,1,"こ"],[122,1,"こ"]],"text":"またミカの子マッタニヤがある。ミカはザブデの子、ザブデはアサフの子である。マッタニヤは祈の時に感謝の言葉を唱え始める者である。その兄弟のうちのバクブキヤは彼に次ぐ者であった。またシャンマの子アブダがある。シャンマはガラルの子、ガラルはエドトンの子である。"},{"ref":"Neh.11.18","start":16011018,"end":16011018,"break":"none","ruby":[[0,2,"せいと"],[10,1,"あ"],[19,1,"にん"]],"text":"聖都におるレビびとは合わせて二百八十四人であった。"},{"ref":"Neh.11.19","start":16011019,"end":16011019,"break":"paragraph","ruby":[[0,2,"もんえい"],[4,1,"もん"],[6,1,"まも"],[22,2,"きょうだい"],[26,1,"あ"],[34,1,"にん"]],"text":"門衛では門を守るアックブ、タルモンおよびその兄弟たち合わせて百七十二人である。"},{"ref":"Neh.11.20","start":16011020,"end":16011020,"break":"none","ruby":[[2,1,"た"],[12,2,"さいし"],[22,1,"みな"],[30,2,"まちまち"],[41,2,"じぶん"],[44,1,"し"],[45,1,"ぎょう"]],"text":"その他のイスラエルびと、祭司、レビびとたちは皆ユダのすべての町々にあって、おのおの自分の嗣業にとどまった。"},{"ref":"Neh.11.21","start":16011021,"end":16011021,"break":"none","ruby":[[3,1,"みや"],[5,1,"つか"],[18,1,"す"],[30,1,"みや"],[32,1,"つか"],[41,2,"かんとく"]],"text":"ただし宮に仕えるしもべたちはオペルに住み、ヂハおよびギシパが宮に仕えるしもべたちを監督していた。"},{"ref":"Neh.11.22","start":16011022,"end":16011022,"break":"paragraph","ruby":[[13,2,"かんとく"],[28,1,"こ"],[39,1,"こ"],[53,1,"こ"],[64,1,"こ"],[72,1,"うた"],[76,1,"もの"],[83,2,"しそん"],[92,1,"かみ"],[94,1,"みや"],[99,2,"かんとく"]],"text":"エルサレムにおるレビびとの監督はウジである。ウジはバニの子、バニはハシャビヤの子、ハシャビヤはマッタニヤの子、マッタニヤはミカの子である。ミカは歌うたう者なるアサフの子孫である。ウジは神の宮のわざを監督した。"},{"ref":"Neh.11.23","start":16011023,"end":16011023,"break":"none","ruby":[[0,1,"かれ"],[7,1,"おう"],[11,2,"めいれい"],[18,1,"うた"],[22,1,"もの"],[24,2,"ひび"],[27,1,"さだ"],[31,1,"ぶん"],[33,1,"あた"]],"text":"彼らについては王からの命令があって、歌うたう者に日々の定まった分を与えさせた。"},{"ref":"Neh.11.24","start":16011024,"end":16011024,"break":"none","ruby":[[5,1,"こ"],[9,2,"しそん"],[20,1,"こ"],[26,1,"おう"],[28,1,"て"],[30,1,"ぞく"],[33,1,"たみ"],[35,1,"かん"],[42,1,"こと"],[44,1,"と"],[46,1,"あつか"]],"text":"またユダの子ゼラの子孫であるメシザベルの子ペタヒヤは王の手に属して民に関するすべての事を取り扱った。"},{"ref":"Neh.11.25","start":16011025,"end":16011025,"break":"paragraph","ruby":[[2,2,"むらむら"],[7,2,"たはた"],[18,2,"しそん"],[21,1,"もの"],[34,2,"むらむら"],[43,2,"むらむら"],[55,2,"むらむら"],[58,1,"す"]],"text":"また村々とその田畑については、ユダの子孫の者はキリアテ・アルバとその村々、デボンとその村々、エカブジエルとその村々に住み、"},{"ref":"Neh.11.26","start":16011026,"end":16011026,"break":"none","ruby":[[17,1,"す"]],"text":"エシュア、モラダおよびベテペレテに住み、"},{"ref":"Neh.11.27","start":16011027,"end":16011027,"break":"none","ruby":[[19,2,"むらむら"],[22,1,"す"]],"text":"ハザル・シュアルおよびベエルシバとその村々に住み、"},{"ref":"Neh.11.28","start":16011028,"end":16011028,"break":"none","ruby":[[13,2,"むらむら"],[16,1,"す"]],"text":"チクラグおよびメコナとその村々に住み、"},{"ref":"Neh.11.29","start":16011029,"end":16011029,"break":"none","ruby":[[16,1,"す"]],"text":"エンリンモン、ザレア、ヤルムテに住み、"},{"ref":"Neh.11.30","start":16011030,"end":16011030,"break":"none","ruby":[[15,2,"むらむら"],[24,2,"でんや"],[33,2,"むらむら"],[36,1,"す"],[44,1,"かれ"],[59,1,"たに"],[63,2,"しゅくえい"]],"text":"ザノア、アドラムおよびそれらの村々、ラキシとその田野、アゼカとその村々に住んだ。こうして彼らはベエルシバからヒンノムの谷にまで宿営した。"},{"ref":"Neh.11.31","start":16011031,"end":16011031,"break":"none","ruby":[[6,2,"しそん"],[31,2,"むらむら"],[34,1,"す"]],"text":"ベニヤミンの子孫はまたゲバからミクマシ、アヤおよびベテルとその村々に住み、"},{"ref":"Neh.11.32","start":16011032,"end":16011032,"break":"none","text":"アナトテ、ノブ、アナニヤ、"},{"ref":"Neh.11.33","start":16011033,"end":16011033,"break":"none","text":"ハゾル、ラマ、ギッタイム、"},{"ref":"Neh.11.34","start":16011034,"end":16011034,"break":"none","text":"ハデデ、ゼボイム、ネバラテ、"},{"ref":"Neh.11.35","start":16011035,"end":16011035,"break":"none","ruby":[[6,2,"こうじん"],[9,1,"たに"],[11,1,"す"]],"text":"ロド、オノ、工人の谷に住んだ。"},{"ref":"Neh.11.36","start":16011036,"end":16011036,"break":"none","ruby":[[5,1,"くみ"],[23,1,"あわ"]],"text":"レビびとの組のユダにあるもののうちベニヤミンに合したものもあった。"}]