[{"ref":"Prov.9.1","start":20009001,"end":20009001,"break":"paragraph","breaks":[[11,"line"]],"ruby":[[0,2,"ちえ"],[3,2,"じぶん"],[6,1,"いえ"],[8,1,"た"],[16,1,"はしら"],[18,1,"た"]],"text":"知恵は自分の家を建て、その七つの柱を立て、"},{"ref":"Prov.9.2","start":20009002,"end":20009002,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"けもの"],[6,1,"さけ"],[8,1,"ま"],[10,1,"あ"],[20,1,"そな"]],"text":"獣をほふり、酒を混ぜ合わせて、ふるまいを備え、"},{"ref":"Prov.9.3","start":20009003,"end":20009003,"break":"line","breaks":[[11,"line"]],"ruby":[[11,1,"まち"],[13,1,"たか"],[15,1,"ところ"],[17,1,"よ"],[21,1,"い"]],"text":"はしためをつかわして、町の高い所で呼ばわり言わせた、"},{"ref":"Prov.9.4","start":20009004,"end":20009004,"break":"line","breaks":[[17,"line"]],"ruby":[[1,2,"しりょ"],[6,1,"もの"],[12,1,"きた"],[20,2,"ちえ"],[25,1,"もの"],[27,1,"い"]],"text":"「思慮のない者よ、ここに来れ」と。また、知恵のない者に言う、"},{"ref":"Prov.9.5","start":20009005,"end":20009005,"break":"line","breaks":[[14,"line"]],"ruby":[[1,1,"き"],[11,1,"た"],[18,1,"ま"],[20,1,"あ"],[24,1,"さけ"]],"text":"「来て、わたしのパンを食べ、わたしの混ぜ合わせた酒をのみ、"},{"ref":"Prov.9.6","start":20009006,"end":20009006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"しりょ"],[8,1,"す"],[11,1,"いのち"],[13,1,"え"],[15,1,"さと"],[18,1,"みち"],[20,1,"あゆ"]],"text":"思慮のないわざを捨てて命を得、悟りの道を歩め」と。"},{"ref":"Prov.9.7","start":20009007,"end":20009007,"break":"stanza","breaks":[[18,"line"]],"ruby":[[4,1,"もの"],[6,1,"いまし"],[9,1,"もの"],[12,1,"みずか"],[14,1,"はじ"],[16,1,"え"],[18,1,"あ"],[21,1,"もの"],[23,1,"せ"],[26,1,"もの"],[28,1,"みずか"],[30,1,"きず"],[32,1,"う"]],"text":"あざける者を戒める者は、自ら恥を得、悪しき者を責める者は自ら傷を受ける。"},{"ref":"Prov.9.8","start":20009008,"end":20009008,"break":"line","breaks":[[11,"line"],[28,"line"]],"ruby":[[4,1,"もの"],[6,1,"せ"],[15,1,"かれ"],[21,1,"にく"],[28,2,"ちえ"],[32,1,"もの"],[34,1,"せ"],[38,1,"かれ"],[44,1,"あい"]],"text":"あざける者を責めるな、おそらく彼はあなたを憎むであろう。知恵ある者を責めよ、彼はあなたを愛する。"},{"ref":"Prov.9.9","start":20009009,"end":20009009,"break":"line","breaks":[[13,"line"],[25,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[6,2,"きょうくん"],[9,1,"さづ"],[13,1,"かれ"],[19,2,"ちえ"],[22,1,"え"],[25,1,"ただ"],[28,1,"もの"],[30,1,"おし"],[34,1,"かれ"],[36,1,"がく"],[38,1,"すす"]],"text":"知恵ある者に教訓を授けよ、彼はますます知恵を得る。正しい者を教えよ、彼は学に進む。"},{"ref":"Prov.9.10","start":20009010,"end":20009010,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[8,2,"ちえ"],[17,1,"せい"],[20,1,"もの"],[22,1,"し"],[28,1,"さと"]],"text":"主を恐れることは知恵のもとである、聖なる者を知ることは、悟りである。"},{"ref":"Prov.9.11","start":20009011,"end":20009011,"break":"line","breaks":[[19,"line"]],"ruby":[[12,1,"ひ"],[14,1,"おお"],[23,1,"いのち"],[25,1,"とし"],[27,1,"ま"]],"text":"わたしによって、あなたの日は多くなり、あなたの命の年は増す。"},{"ref":"Prov.9.12","start":20009012,"end":20009012,"break":"line","breaks":[[15,"line"],[34,"line"],[48,"line"]],"ruby":[[6,2,"ちえ"],[18,2,"じしん"],[24,2,"ちえ"],[57,1,"せ"],[60,1,"お"]],"text":"もしあなたに知恵があるならば、あなた自身のために知恵があるのである。もしあなたがあざけるならば、あなたひとりがその責めを負うことになる。"},{"ref":"Prov.9.13","start":20009013,"end":20009013,"break":"stanza","ruby":[[0,1,"おろ"],[3,1,"おんな"],[6,1,"さわ"],[16,1,"はじ"],[18,1,"し"]],"text":"愚かな女は、騒がしく、みだらで、恥を知らない。"},{"ref":"Prov.9.14","start":20009014,"end":20009014,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"かのじょ"],[5,1,"いえ"],[7,2,"とぐち"],[10,1,"ざ"],[13,1,"まち"],[15,1,"たか"],[17,1,"ところ"],[21,1,"ざ"]],"text":"彼女はその家の戸口に座し、町の高い所にある座にすわり、"},{"ref":"Prov.9.15","start":20009015,"end":20009015,"break":"line","ruby":[[0,1,"みち"],[2,1,"いそ"],[4,1,"い"],[6,1,"き"],[8,1,"ひと"],[10,1,"まね"],[13,1,"い"]],"text":"道を急ぐ行き来の人を招いて言う、"},{"ref":"Prov.9.16","start":20009016,"end":20009016,"break":"line","breaks":[[17,"line"]],"ruby":[[1,2,"しりょ"],[6,1,"もの"],[12,1,"きた"],[19,2,"ちえ"],[24,1,"ひと"],[26,1,"む"],[33,1,"い"]],"text":"「思慮のない者よ、ここに来れ」と。また知恵のない人に向かってこれに言う、"},{"ref":"Prov.9.17","start":20009017,"end":20009017,"break":"line","breaks":[[9,"line"]],"ruby":[[1,1,"ぬす"],[4,1,"みず"],[6,1,"あま"],[13,1,"た"]],"text":"「盗んだ水は甘く、ひそかに食べるパンはうまい」と。"},{"ref":"Prov.9.18","start":20009018,"end":20009018,"break":"line","breaks":[[24,"line"]],"ruby":[[5,1,"ひと"],[8,1,"し"],[10,1,"かげ"],[20,1,"し"],[24,2,"かのじょ"],[27,1,"きゃく"],[29,2,"よみ"],[32,1,"ふか"],[40,1,"し"]],"text":"しかしその人は、死の影がそこにあることを知らず、彼女の客は陰府の深みにおることを知らない。"}]