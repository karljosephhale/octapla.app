[{"ref":"2Sam.6.1","start":10006001,"end":10006001,"break":"paragraph","ruby":[[4,1,"ふたた"],[14,1,"ぬ"],[17,1,"もの"],[20,1,"にん"],[27,1,"あつ"]],"text":"ダビデは再びイスラエルのえり抜きの者三万人をことごとく集めた。"},{"ref":"2Sam.6.2","start":10006002,"end":10006002,"break":"none","ruby":[[7,1,"た"],[11,2,"じぶん"],[14,1,"とも"],[22,1,"たみ"],[24,1,"とも"],[33,1,"い"],[37,1,"かみ"],[39,1,"はこ"],[47,1,"のぼ"],[56,1,"はこ"],[63,1,"うえ"],[65,1,"ざ"],[72,2,"ばんぐん"],[75,1,"しゅ"],[77,1,"な"],[82,1,"よ"]],"text":"そしてダビデは立って、自分と共にいるすべての民と共にバアレ・ユダへ行って、神の箱をそこからかき上ろうとした。この箱はケルビムの上に座しておられる万軍の主の名をもって呼ばれている。"},{"ref":"2Sam.6.3","start":10006003,"end":10006003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,1,"はこ"],[7,1,"あたら"],[10,1,"くるま"],[12,1,"の"],[16,1,"やま"],[18,1,"うえ"],[28,1,"いえ"],[31,1,"はこ"],[33,1,"だ"]],"text":"彼らは神の箱を新しい車に載せて、山の上にあるアビナダブの家から運び出した。"},{"ref":"2Sam.6.4","start":10006004,"end":10006004,"break":"none","ruby":[[6,1,"こ"],[18,1,"かみ"],[20,1,"はこ"],[22,1,"の"],[25,1,"あたら"],[28,1,"くるま"],[30,2,"しき"],[37,1,"かみ"],[39,1,"はこ"],[46,1,"そ"],[53,1,"はこ"],[55,1,"まえ"],[57,1,"すす"]],"text":"アビナダブの子たち、ウザとアヒオとが神の箱を載せた新しい車を指揮し、ウザは神の箱のかたわらに沿い、アヒオは箱の前に進んだ。"},{"ref":"2Sam.6.5","start":10006005,"end":10006005,"break":"none","ruby":[[10,2,"ぜんか"],[13,1,"こと"],[15,2,"たてごと"],[18,1,"て"],[19,1,"つづみ"],[21,1,"すず"],[32,1,"うた"],[38,1,"ちから"],[45,1,"しゅ"],[47,1,"まえ"],[49,1,"おど"]],"text":"ダビデとイスラエルの全家は琴と立琴と手鼓と鈴とシンバルとをもって歌をうたい、力をきわめて、主の前に踊った。"},{"ref":"2Sam.6.6","start":10006006,"end":10006006,"break":"paragraph","ruby":[[0,1,"かれ"],[7,1,"う"],[9,1,"ば"],[13,1,"とき"],[18,1,"かみ"],[20,1,"はこ"],[22,1,"て"],[24,1,"の"],[31,1,"おさ"],[35,1,"うし"]],"text":"彼らがナコンの打ち場にきた時、ウザは神の箱に手を伸べて、それを押えた。牛がつまずいたからである。"},{"ref":"2Sam.6.7","start":10006007,"end":10006007,"break":"none","ruby":[[3,1,"しゅ"],[8,1,"む"],[12,1,"いか"],[15,1,"はっ"],[18,1,"かれ"],[20,1,"て"],[22,1,"はこ"],[24,1,"の"],[30,1,"かれ"],[34,1,"ば"],[36,1,"う"],[41,1,"かれ"],[43,1,"かみ"],[45,1,"はこ"],[52,1,"し"]],"text":"すると主はウザに向かって怒りを発し、彼が手を箱に伸べたので、彼をその場で撃たれた。彼は神の箱のかたわらで死んだ。"},{"ref":"2Sam.6.8","start":10006008,"end":10006008,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"う"],[16,1,"いか"],[22,1,"ところ"],[24,2,"こんにち"],[35,1,"よ"]],"text":"主がウザを撃たれたので、ダビデは怒った。その所は今日までペレヅ・ウザと呼ばれている。"},{"ref":"2Sam.6.9","start":10006009,"end":10006009,"break":"none","ruby":[[2,1,"ひ"],[7,1,"しゅ"],[9,1,"おそ"],[12,1,"い"],[21,1,"しゅ"],[23,1,"はこ"],[29,1,"ところ"],[31,1,"く"]],"text":"その日ダビデは主を恐れて言った、「どうして主の箱がわたしの所に来ることができようか」。"},{"ref":"2Sam.6.10","start":10006010,"end":10006010,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"はこ"],[12,1,"まち"],[14,1,"い"],[20,1,"この"],[27,1,"うつ"],[41,1,"いえ"],[43,1,"はこ"]],"text":"ダビデは主の箱をダビデの町に入れることを好まず、これを移してガテびとオベデエドムの家に運ばせた。"},{"ref":"2Sam.6.11","start":10006011,"end":10006011,"break":"none","ruby":[[0,1,"かみ"],[2,1,"はこ"],[15,1,"いえ"],[19,1,"げつ"],[26,1,"しゅ"],[37,2,"ぜんか"],[40,2,"しゅくふく"]],"text":"神の箱はガテびとオベデエドムの家に三か月とどまった。主はオベデエドムとその全家を祝福された。"},{"ref":"2Sam.6.12","start":10006012,"end":10006012,"break":"paragraph","ruby":[[6,1,"おう"],[10,1,"しゅ"],[12,1,"かみ"],[14,1,"はこ"],[27,1,"いえ"],[35,2,"しょゆう"],[38,2,"しゅくふく"],[47,1,"き"],[54,1,"い"],[58,1,"よろこ"],[65,1,"かみ"],[67,1,"はこ"],[76,1,"いえ"],[83,1,"まち"],[87,1,"のぼ"]],"text":"しかしダビデ王は、「主が神の箱のゆえに、オベデエドムの家とそのすべての所有を祝福されている」と聞き、ダビデは行って、喜びをもって、神の箱をオベデエドムの家からダビデの町にかき上った。"},{"ref":"2Sam.6.13","start":10006013,"end":10006013,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"はこ"],[6,1,"もの"],[9,1,"ほ"],[10,1,"すす"],[13,1,"とき"],[19,1,"うし"],[21,1,"こ"],[24,1,"もの"],[26,2,"ぎせい"]],"text":"主の箱をかく者が六歩進んだ時、ダビデは牛と肥えた物を犠牲としてささげた。"},{"ref":"2Sam.6.14","start":10006014,"end":10006014,"break":"none","ruby":[[7,1,"ちから"],[14,1,"しゅ"],[16,1,"はこ"],[18,1,"まえ"],[20,1,"おど"],[26,1,"とき"],[31,2,"あま"],[33,1,"ぬの"]],"text":"そしてダビデは力をきわめて、主の箱の前で踊った。その時ダビデは亜麻布のエポデをつけていた。"},{"ref":"2Sam.6.15","start":10006015,"end":10006015,"break":"none","ruby":[[14,2,"ぜんか"],[19,1,"よろこ"],[22,1,"さけ"],[25,2,"つのぶえ"],[28,1,"おと"],[34,1,"かみ"],[36,1,"はこ"],[40,1,"のぼ"]],"text":"こうしてダビデとイスラエルの全家とは、喜びの叫びと角笛の音をもって、神の箱をかき上った。"},{"ref":"2Sam.6.16","start":10006016,"end":10006016,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"はこ"],[8,1,"まち"],[14,1,"とき"],[20,1,"むすめ"],[25,1,"まど"],[35,1,"おう"],[37,1,"しゅ"],[39,1,"まえ"],[41,1,"ま"],[43,1,"おど"],[47,1,"み"],[50,1,"こころ"]],"text":"主の箱がダビデの町にはいった時、サウルの娘ミカルは窓からながめ、ダビデ王が主の前に舞い踊るのを見て、心のうちにダビデをさげすんだ。"},{"ref":"2Sam.6.17","start":10006017,"end":10006017,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"しゅ"],[5,1,"はこ"],[9,1,"い"],[22,1,"は"],[25,2,"てんまく"],[28,1,"なか"],[32,2,"ばしょ"],[35,1,"お"],[46,2,"はんさい"],[49,3,"しゅうおんさい"],[53,1,"しゅ"],[55,1,"まえ"]],"text":"人々は主の箱をかき入れて、ダビデがそのために張った天幕の中のその場所に置いた。そしてダビデは燔祭と酬恩祭を主の前にささげた。"},{"ref":"2Sam.6.18","start":10006018,"end":10006018,"break":"none","ruby":[[4,2,"はんさい"],[7,3,"しゅうおんさい"],[14,1,"おわ"],[17,1,"とき"],[19,2,"ばんぐん"],[22,1,"しゅ"],[24,1,"な"],[29,1,"たみ"],[31,2,"しゅくふく"]],"text":"ダビデは燔祭と酬恩祭をささげ終った時、万軍の主の名によって民を祝福した。"},{"ref":"2Sam.6.19","start":10006019,"end":10006019,"break":"none","ruby":[[7,1,"たみ"],[15,1,"ぜん"],[16,2,"みんしゅう"],[20,1,"おとこ"],[23,1,"おんな"],[34,2,"かし"],[37,1,"こ"],[39,1,"にく"],[55,1,"わ"],[57,1,"あた"],[65,1,"たみ"],[75,1,"いえ"],[77,1,"かえ"]],"text":"そしてすべての民、イスラエルの全民衆に、男にも女にも、おのおのパンの菓子一個、肉一きれ、ほしぶどう一かたまりを分け与えた。こうして民はみなおのおのその家に帰った。"},{"ref":"2Sam.6.20","start":10006020,"end":10006020,"break":"paragraph","ruby":[[4,2,"かぞく"],[7,2,"しゅくふく"],[15,1,"かえ"],[20,1,"とき"],[26,1,"むすめ"],[35,2,"でむか"],[39,1,"い"],[53,1,"おう"],[58,2,"いげん"],[75,1,"もの"],[78,1,"はじ"],[80,1,"し"],[86,1,"み"],[88,1,"あらわ"],[97,2,"けらい"],[108,1,"まえ"],[110,2,"じぶん"],[113,1,"み"],[115,1,"あらわ"]],"text":"ダビデが家族を祝福しようとして帰ってきた時、サウルの娘ミカルはダビデを出迎えて言った、「きょうイスラエルの王はなんと威厳のあったことでしょう。いたずら者が、恥も知らず、その身を現すように、きょう家来たちのはしためらの前に自分の身を現されました」。"},{"ref":"2Sam.6.21","start":10006021,"end":10006021,"break":"none","ruby":[[8,1,"い"],[17,1,"ちち"],[26,2,"ぜんか"],[39,1,"えら"],[43,1,"しゅ"],[45,1,"たみ"],[52,1,"きみ"],[58,1,"しゅ"],[60,1,"まえ"],[62,1,"おど"],[74,1,"しゅ"],[76,1,"まえ"],[78,1,"おど"]],"text":"ダビデはミカルに言った、「あなたの父よりも、またその全家よりも、むしろわたしを選んで、主の民イスラエルの君とせられた主の前に踊ったのだ。わたしはまた主の前に踊るであろう。"},{"ref":"2Sam.6.22","start":10006022,"end":10006022,"break":"none","ruby":[[12,1,"かろ"],[32,1,"め"],[35,1,"いや"],[61,1,"い"],[72,1,"ほまれ"],[74,1,"え"]],"text":"わたしはこれよりももっと軽んじられるようにしよう。そしてあなたの目には卑しめられるであろう。しかしわたしは、あなたがさきに言った、はしためたちに誉を得るであろう」。"},{"ref":"2Sam.6.23","start":10006023,"end":10006023,"break":"none","ruby":[[8,1,"むすめ"],[13,1,"し"],[15,1,"ひ"],[18,2,"こども"]],"text":"こうしてサウルの娘ミカルは死ぬ日まで子供がなかった。"}]