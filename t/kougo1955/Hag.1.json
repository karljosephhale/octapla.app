[{"ref":"Hag.1.1","start":37001001,"end":37001001,"break":"paragraph","ruby":[[4,1,"おう"],[7,1,"ねん"],[9,1,"がつ"],[13,1,"つき"],[16,1,"にち"],[19,1,"しゅ"],[21,2,"ことば"],[24,3,"よげんしゃ"],[41,1,"こ"],[46,2,"そうとく"],[62,1,"こ"],[64,1,"だい"],[65,2,"さいし"],[72,1,"のぞ"]],"text":"ダリヨス王の二年六月、その月の一日に、主の言葉が預言者ハガイによって、シャルテルの子、ユダの総督ゼルバベル、およびヨザダクの子、大祭司ヨシュアに臨んだ、"},{"ref":"Hag.1.2","start":37001002,"end":37001002,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[8,1,"い"],[15,1,"たみ"],[18,1,"しゅ"],[20,1,"いえ"],[22,1,"ふたた"],[24,1,"た"],[27,1,"とき"],[36,1,"い"]],"text":"「万軍の主はこう言われる、この民は、主の家を再び建てる時は、まだこないと言っている」。"},{"ref":"Hag.1.3","start":37001003,"end":37001003,"break":"none","ruby":[[4,1,"しゅ"],[6,2,"ことば"],[11,3,"よげんしゃ"],[18,1,"のぞ"]],"text":"そこで、主の言葉はまた預言者ハガイに臨んだ、"},{"ref":"Hag.1.4","start":37001004,"end":37001004,"break":"none","ruby":[[1,1,"しゅ"],[3,1,"いえ"],[10,1,"あ"],[31,1,"いた"],[33,1,"は"],[36,1,"いえ"],[38,1,"す"],[43,1,"とき"]],"text":"「主の家はこのように荒れはてているのに、あなたがたは、みずから板で張った家に住んでいる時であろうか。"},{"ref":"Hag.1.5","start":37001005,"end":37001005,"break":"none","ruby":[[3,1,"いま"],[5,2,"ばんぐん"],[8,1,"しゅ"],[12,1,"い"],[23,2,"じぶん"],[35,1,"かんが"]],"text":"それで今、万軍の主はこう言われる、あなたがたは自分のなすべきことをよく考えるがよい。"},{"ref":"Hag.1.6","start":37001006,"end":37001006,"break":"none","ruby":[[6,1,"おお"],[13,2,"とりい"],[17,1,"すく"],[21,1,"た"],[26,1,"あ"],[35,1,"の"],[40,1,"み"],[47,1,"き"],[51,1,"あたた"],[57,2,"ちんぎん"],[60,1,"え"],[67,1,"やぶ"],[70,1,"ふくろ"],[72,1,"い"]],"text":"あなたがたは多くまいても、取入れは少なく、食べても、飽きることはない。飲んでも、満たされない。着ても、暖まらない。賃銀を得ても、これを破れた袋に入れているようなものである。"},{"ref":"Hag.1.7","start":37001007,"end":37001007,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"い"],[19,2,"じぶん"],[29,1,"かんが"]],"text":"万軍の主はこう言われる、あなたがたは、自分のなすべきことを考えるがよい。"},{"ref":"Hag.1.8","start":37001008,"end":37001008,"break":"none","ruby":[[0,1,"やま"],[2,1,"のぼ"],[5,1,"き"],[7,1,"も"],[12,1,"しゅ"],[14,1,"いえ"],[16,1,"た"],[32,1,"よろこ"],[37,2,"えいこう"],[43,1,"あらわ"],[47,1,"しゅ"],[49,1,"い"]],"text":"山に登り、木を持ってきて主の家を建てよ。そうすればわたしはこれを喜び、かつ栄光のうちに現れると主は言われる。"},{"ref":"Hag.1.9","start":37001009,"end":37001009,"break":"none","ruby":[[6,1,"おお"],[9,1,"のぞ"],[14,1,"み"],[20,1,"すく"],[32,1,"いえ"],[34,1,"も"],[49,1,"ふ"],[51,1,"はら"],[58,1,"なに"],[67,2,"ばんぐん"],[70,1,"しゅ"],[72,1,"い"],[84,1,"いえ"],[86,1,"あ"],[107,2,"じぶん"],[110,1,"いえ"],[112,1,"こと"],[117,1,"いそが"]],"text":"あなたがたは多くを望んだが、見よ、それは少なかった。あなたがたが家に持ってきたとき、わたしはそれを吹き払った。これは何ゆえであるかと、万軍の主は言われる。これはわたしの家が荒れはてているのに、あなたがたは、おのおの自分の家の事だけに、忙しくしている。"},{"ref":"Hag.1.10","start":37001010,"end":37001010,"break":"none","ruby":[[11,1,"うえ"],[13,1,"てん"],[15,1,"つゆ"],[19,1,"と"],[22,1,"ち"],[26,2,"さんぶつ"],[31,1,"と"]],"text":"それゆえ、あなたがたの上の天は露をさし止め、地はその産物をさし止めた。"},{"ref":"Hag.1.11","start":37001011,"end":37001011,"break":"none","ruby":[[7,1,"ち"],[11,1,"やま"],[15,2,"こくもつ"],[20,1,"あたら"],[23,1,"さけ"],[27,1,"あぶら"],[31,1,"ち"],[33,1,"しょう"],[41,2,"にんげん"],[46,2,"かちく"],[51,1,"て"],[53,1,"つく"],[59,2,"さくもつ"],[68,1,"よ"],[70,1,"よ"]],"text":"また、わたしは地にも、山にも、穀物にも、新しい酒にも、油にも、地に生じるものにも、人間にも、家畜にも、手で作るすべての作物にも、ひでりを呼び寄せた」。"},{"ref":"Hag.1.12","start":37001012,"end":37001012,"break":"paragraph","ruby":[[10,1,"こ"],[22,1,"こ"],[24,1,"だい"],[25,2,"さいし"],[34,1,"のこ"],[41,1,"たみ"],[46,1,"かみ"],[48,1,"しゅ"],[50,1,"こえ"],[55,1,"かみ"],[57,1,"しゅ"],[65,3,"よげんしゃ"],[72,2,"ことば"],[76,1,"き"],[86,1,"たみ"],[89,1,"しゅ"],[91,1,"まえ"],[93,1,"おそ"]],"text":"そこで、シャルテルの子ゼルバベルとヨザダクの子、大祭司ヨシュアおよび残りのすべての民は、その神、主の声と、その神、主のつかわされた預言者ハガイの言葉とに聞きしたがい、そして民は、主の前に恐れかしこんだ。"},{"ref":"Hag.1.13","start":37001013,"end":37001013,"break":"none","ruby":[[0,1,"とき"],[3,1,"しゅ"],[5,2,"ししゃ"],[11,1,"しゅ"],[13,2,"めいれい"],[19,1,"たみ"],[21,1,"つ"],[24,1,"い"],[39,1,"とも"],[44,1,"しゅ"],[46,1,"い"]],"text":"時に、主の使者ハガイは主の命令により、民に告げて言った、「わたしはあなたがたと共にいると主は言われる」。"},{"ref":"Hag.1.14","start":37001014,"end":37001014,"break":"none","ruby":[[3,1,"しゅ"],[12,1,"こ"],[17,2,"そうとく"],[25,1,"こころ"],[33,1,"こ"],[35,1,"だい"],[36,2,"さいし"],[43,1,"こころ"],[48,1,"のこ"],[55,1,"たみ"],[57,1,"こころ"],[60,1,"ふ"],[62,1,"うご"],[70,1,"かれ"],[73,1,"き"],[78,1,"かみ"],[80,2,"ばんぐん"],[83,1,"しゅ"],[85,1,"いえ"],[87,2,"さぎょう"]],"text":"そして主は、シャルテルの子、ユダの総督ゼルバベルの心と、ヨザダクの子、大祭司ヨシュアの心、および残りのすべての民の心を、振り動かされたので、彼らは来て、その神、万軍の主の家の作業にとりかかった。"},{"ref":"Hag.1.15","start":37001015,"end":37001015,"break":"none","ruby":[[4,1,"がつ"],[8,1,"か"]],"text":"これは六月二十四日のことであった。"}]