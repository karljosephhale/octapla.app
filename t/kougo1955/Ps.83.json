[{"ref":"Ps.83.1","start":19083001,"end":19083001,"break":"paragraph","title":"アサフの歌、さんび","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[3,2,"ちんもく"],[6,1,"まも"],[16,1,"かみ"],[19,1,"なに"],[21,1,"い"],[26,1,"だま"]],"titleRuby":[[4,1,"うた"]],"text":"神よ、沈黙を守らないでください。神よ、何も言わずに、黙っていないでください。"},{"ref":"Ps.83.2","start":19083002,"end":19083002,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"み"],[7,1,"てき"],[9,1,"さわ"],[18,1,"にく"],[20,1,"もの"],[22,1,"あたま"]],"text":"見よ、あなたの敵は騒ぎたち、あなたを憎む者は頭をあげました。"},{"ref":"Ps.83.3","start":19083003,"end":19083003,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[0,1,"かれ"],[7,1,"たみ"],[13,1,"たく"],[31,2,"ほご"],[36,1,"もの"],[42,1,"あい"],[46,1,"はか"]],"text":"彼らはあなたの民にむかって巧みなはかりごとをめぐらし、あなたの保護される者にむかって相ともに計ります。"},{"ref":"Ps.83.4","start":19083004,"end":19083004,"break":"line","breaks":[[8,"line"],[29,"line"],[37,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[12,1,"かれ"],[15,1,"た"],[17,1,"ほろ"],[21,1,"くに"],[23,1,"た"],[35,1,"な"],[41,1,"おも"],[43,1,"だ"]],"text":"彼らは言います、「さあ、彼らを断ち滅ぼして国を立てさせず、イスラエルの名をふたたび思い出させないようにしよう」。"},{"ref":"Ps.83.5","start":19083005,"end":19083005,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こころ"],[11,1,"とも"],[21,1,"さか"],[25,2,"けいやく"],[28,1,"むす"]],"text":"彼らは心をひとつにして共にはかり、あなたに逆らって契約を結びます。"},{"ref":"Ps.83.6","start":19083006,"end":19083006,"break":"line","breaks":[[23,"line"]],"ruby":[[8,2,"てんまく"],[11,1,"す"],[13,1,"もの"]],"text":"すなわちエドムの天幕に住む者とイシマエルびと、モアブとハガルびと、"},{"ref":"Ps.83.7","start":19083007,"end":19083007,"break":"line","breaks":[[14,"line"]],"ruby":[[22,2,"じゅうみん"]],"text":"ゲバルとアンモンとアマレク、ペリシテとツロの住民などです。"},{"ref":"Ps.83.8","start":19083008,"end":19083008,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"かれ"],[18,1,"かれ"],[24,2,"しそん"],[27,1,"たす"]],"text":"アッスリヤもまた彼らにくみしました。彼らはロトの子孫を助けました。〔セラ"},{"ref":"Ps.83.9","start":19083009,"end":19083009,"break":"line","breaks":[[16,"line"],[37,"line"]],"ruby":[[20,1,"かわ"],[37,1,"かれ"]],"text":"あなたがミデアンにされたように、キション川でシセラとヤビンにされたように、彼らにしてください。"},{"ref":"Ps.83.10","start":19083010,"end":19083010,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[8,1,"ほろ"],[13,1,"ち"],[18,2,"ひりょう"]],"text":"彼らはエンドルで滅ぼされ、地のために肥料となりました。"},{"ref":"Ps.83.11","start":19083011,"end":19083011,"break":"line","breaks":[[18,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[3,2,"きじん"],[24,1,"きみ"]],"text":"彼らの貴人をオレブとゼエブのように、そのすべての君たちをゼバとザルムンナのようにしてください。"},{"ref":"Ps.83.12","start":19083012,"end":19083012,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[14,1,"かみ"],[16,2,"まきば"],[19,1,"え"],[26,2,"しょゆう"]],"text":"彼らは言いました、「われらは神の牧場を獲て、われらの所有にしよう」と。"},{"ref":"Ps.83.13","start":19083013,"end":19083013,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"かみ"],[5,1,"かれ"],[8,1,"ま"],[22,1,"かぜ"],[24,1,"まえ"]],"text":"わが神よ、彼らを巻きあげられるちりのように、風の前のもみがらのようにしてください。"},{"ref":"Ps.83.14","start":19083014,"end":19083014,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"はやし"],[2,1,"や"],[4,1,"ひ"],[10,1,"やま"],[12,1,"も"],[15,1,"ほのお"]],"text":"林を焼く火のように、山を燃やす炎のように、"},{"ref":"Ps.83.15","start":19083015,"end":19083015,"break":"line","breaks":[[17,"line"]],"ruby":[[11,1,"かれ"],[14,1,"お"],[26,1,"かれ"],[29,1,"おそ"]],"text":"あなたのはやてをもって彼らを追い、つむじかぜをもって彼らを恐れさせてください。"},{"ref":"Ps.83.16","start":19083016,"end":19083016,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かお"],[5,1,"はじ"],[7,1,"み"],[16,1,"しゅ"],[24,1,"かれ"],[31,1,"な"],[33,1,"もと"]],"text":"彼らの顔に恥を満たしてください。主よ、そうすれば彼らはあなたの名を求めるでしょう。"},{"ref":"Ps.83.17","start":19083017,"end":19083017,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[8,1,"は"],[10,1,"おそ"],[18,1,"まど"],[21,1,"ほろ"]],"text":"彼らをとこしえに恥じ恐れさせ、あわて惑って滅びうせさせてください。"},{"ref":"Ps.83.18","start":19083018,"end":19083018,"break":"line","breaks":[[18,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"な"],[18,1,"ぜん"],[19,1,"ち"],[28,1,"たか"],[30,1,"もの"],[37,1,"かれ"],[40,1,"し"]],"text":"主という名をおもちになるあなたのみ、全地をしろしめすいと高き者であることを彼らに知らせてください。"}]