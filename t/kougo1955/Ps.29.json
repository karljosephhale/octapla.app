[{"ref":"Ps.29.1","start":19029001,"end":19029001,"break":"paragraph","title":"ダビデの歌","breaks":[[12,"line"]],"ruby":[[0,1,"かみ"],[2,1,"こ"],[6,1,"しゅ"],[8,1,"き"],[12,2,"えいこう"],[15,1,"ちから"],[18,1,"しゅ"],[20,1,"き"]],"titleRuby":[[4,1,"うた"]],"text":"神の子らよ、主に帰せよ、栄光と力とを主に帰せよ。"},{"ref":"Ps.29.2","start":19029002,"end":19029002,"break":"line","breaks":[[12,"line"]],"ruby":[[1,1,"な"],[3,2,"えいこう"],[6,1,"しゅ"],[8,1,"き"],[12,1,"せい"],[15,1,"よそお"],[21,1,"しゅ"],[23,1,"おが"]],"text":"み名の栄光を主に帰せよ、聖なる装いをもって主を拝め。"},{"ref":"Ps.29.3","start":19029003,"end":19029003,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"こえ"],[5,1,"みず"],[7,1,"うえ"],[12,2,"えいこう"],[15,1,"かみ"],[17,1,"かみなり"],[25,1,"しゅ"],[27,1,"だい"],[28,1,"みず"],[30,1,"うえ"]],"text":"主のみ声は水の上にあり、栄光の神は雷をとどろかせ、主は大水の上におられる。"},{"ref":"Ps.29.4","start":19029004,"end":19029004,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"こえ"],[5,1,"ちから"],[10,1,"しゅ"],[13,1,"こえ"],[15,2,"いげん"]],"text":"主のみ声は力があり、主のみ声は威厳がある。"},{"ref":"Ps.29.5","start":19029005,"end":19029005,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"こえ"],[5,2,"こうはく"],[8,1,"お"],[10,1,"くだ"],[13,1,"しゅ"],[20,2,"こうはく"],[23,1,"お"],[25,1,"くだ"]],"text":"主のみ声は香柏を折り砕き、主はレバノンの香柏を折り砕かれる。"},{"ref":"Ps.29.6","start":19029006,"end":19029006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"こ"],[8,1,"うし"],[13,1,"おど"],[22,1,"わか"],[24,2,"のうし"],[30,1,"おど"]],"text":"主はレバノンを子牛のように踊らせ、シリオンを若い野牛のように踊らされる。"},{"ref":"Ps.29.7","start":19029007,"end":19029007,"break":"line","ruby":[[0,1,"しゅ"],[3,1,"こえ"],[5,1,"ほのお"]],"text":"主のみ声は炎をひらめかす。"},{"ref":"Ps.29.8","start":19029008,"end":19029008,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"こえ"],[5,2,"あらの"],[8,1,"ふる"],[12,1,"しゅ"],[18,2,"あらの"],[21,1,"ふる"]],"text":"主のみ声は荒野を震わせ、主はカデシの荒野を震わされる。"},{"ref":"Ps.29.9","start":19029009,"end":19029009,"break":"line","breaks":[[24,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"こえ"],[8,1,"き"],[10,1,"ま"],[17,1,"はやし"],[19,1,"はだか"],[26,1,"みや"],[36,1,"よ"],[41,1,"い"],[45,2,"えいこう"]],"text":"主のみ声はかしの木を巻きあげ、また林を裸にする。その宮で、すべてのものは呼ばわって言う、「栄光」と。"},{"ref":"Ps.29.10","start":19029010,"end":19029010,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"みず"],[5,1,"うえ"],[7,1,"ざ"],[10,1,"しゅ"],[16,1,"ざ"],[25,1,"おう"]],"text":"主は洪水の上に座し、主はみくらに座して、とこしえに王であらせられる。"},{"ref":"Ps.29.11","start":19029011,"end":19029011,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"たみ"],[6,1,"ちから"],[8,1,"あた"],[11,2,"へいあん"],[19,1,"たみ"],[21,2,"しゅくふく"]],"text":"主はその民に力を与え、平安をもってその民を祝福されるであろう。"}]