[{"ref":"Amos.9.1","start":30009001,"end":30009001,"break":"paragraph","breaks":[[24,"line"],[31,"line"],[47,"line"],[56,"line"],[74,"line"],[93,"line"],[109,"line"]],"ruby":[[4,2,"さいだん"],[12,1,"た"],[19,1,"しゅ"],[21,1,"み"],[24,1,"しゅ"],[26,1,"い"],[32,1,"はしら"],[34,1,"あたま"],[36,1,"う"],[40,2,"しきい"],[43,1,"ふる"],[50,1,"う"],[52,1,"くだ"],[60,1,"たみ"],[62,1,"あたま"],[64,1,"うえ"],[66,1,"お"],[76,1,"のこ"],[79,1,"もの"],[90,1,"ころ"],[99,1,"に"],[104,1,"もの"],[114,1,"もの"]],"text":"わたしは祭壇のかたわらに立っておられる主を見た。主は言われた、「柱の頭を打って、敷居を震わせ、これを打ち砕いて、すべての民の頭の上に落ちかからせよ。その残った者を、わたしはつるぎで殺し、そのひとりも逃げおおす者はなく、のがれうる者はない。"},{"ref":"Amos.9.2","start":30009002,"end":30009002,"break":"line","breaks":[[16,"line"],[34,"line"],[50,"line"]],"ruby":[[3,1,"かれ"],[6,2,"よみ"],[9,1,"ほ"],[11,1,"くだ"],[20,1,"て"],[29,1,"ひ"],[31,1,"だ"],[37,1,"かれ"],[40,1,"てん"],[61,1,"ひ"]],"text":"たとい彼らは陰府に掘り下っても、わたしの手はこれをそこから引き出す。たとい彼らは天によじのぼっても、わたしはそこからこれを引きおろす。"},{"ref":"Amos.9.3","start":30009003,"end":30009003,"break":"line","breaks":[[18,"line"],[38,"line"],[55,"line"],[64,"line"]],"ruby":[[3,1,"かれ"],[11,1,"いただき"],[13,1,"かく"],[25,1,"さが"],[33,1,"ひ"],[35,1,"だ"],[41,1,"かれ"],[48,1,"め"],[55,1,"うみ"],[57,1,"そこ"],[59,1,"かく"],[71,1,"めい"],[77,1,"ところ"]],"text":"たとい彼らはカルメルの頂に隠れても、わたしはこれを捜して、そこから引き出す。たとい彼らはわたしの目をのがれて、海の底に隠れても、わたしはへびに命じて、その所でこれをかませる。"},{"ref":"Amos.9.4","start":30009004,"end":30009004,"break":"line","breaks":[[22,"line"],[46,"line"],[64,"line"]],"ruby":[[3,1,"かれ"],[6,1,"とら"],[13,1,"てき"],[15,1,"まえ"],[17,1,"い"],[28,1,"ところ"],[34,1,"めい"],[41,1,"ころ"],[50,1,"かれ"],[53,1,"うえ"],[59,1,"め"],[61,1,"そそ"],[67,1,"わざわい"],[76,1,"さいわい"]],"text":"たとい彼らは捕われて、その敵の前に行っても、わたしはその所でつるぎに命じて、これを殺させる。わたしは彼らの上にわたしの目を注ぐ、それは災のためであって、幸のためではない」。"},{"ref":"Amos.9.5","start":30009005,"end":30009005,"break":"line","breaks":[[21,"line"],[34,"line"],[52,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[5,1,"しゅ"],[7,1,"ち"],[9,1,"ふ"],[16,1,"ち"],[18,1,"と"],[23,1,"なか"],[25,1,"す"],[27,1,"もの"],[31,1,"なげ"],[34,1,"ち"],[41,1,"かわ"],[60,1,"かわ"],[67,1,"しず"]],"text":"万軍の神、主が地に触れられると、地は溶け、その中に住む者はみな嘆き、地はみなナイル川のようにわきあがり、エジプトのナイル川のようにまた沈む。"},{"ref":"Amos.9.6","start":30009006,"end":30009006,"break":"line","breaks":[[14,"line"],[26,"line"],[45,"line"]],"ruby":[[0,1,"しゅ"],[3,2,"じぶん"],[6,2,"たかどの"],[9,1,"てん"],[11,1,"きず"],[14,2,"おおぞら"],[17,1,"もとい"],[19,1,"ち"],[21,1,"うえ"],[26,1,"うみ"],[28,1,"みず"],[30,1,"よ"],[34,1,"ち"],[40,1,"そそ"],[47,1,"な"],[49,1,"しゅ"]],"text":"主はご自分の高殿を天に築き、大空の基を地の上にすえ、海の水を呼んで、地のおもてに注がれる。その名は主ととなえられる。"},{"ref":"Amos.9.7","start":30009007,"end":30009007,"break":"line","breaks":[[7,"line"],[31,"line"],[47,"line"],[66,"line"],[80,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[14,1,"こ"],[62,1,"くに"],[90,1,"みちび"],[92,1,"のぼ"]],"text":"主は言われる、「イスラエルの子らよ、あなたがたはわたしにとってエチオピヤびとのようではないか。わたしはイスラエルをエジプトの国から、ペリシテびとをカフトルから、スリヤびとをキルから導き上ったではないか。"},{"ref":"Amos.9.8","start":30009008,"end":30009008,"break":"line","breaks":[[10,"line"],[28,"line"],[48,"line"],[62,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[6,1,"かみ"],[8,1,"め"],[12,1,"つみ"],[14,1,"おか"],[17,1,"くに"],[19,1,"うえ"],[21,1,"そそ"],[35,1,"ち"],[42,1,"た"],[44,1,"ほろ"],[60,1,"いえ"],[68,1,"ほろ"],[75,1,"しゅ"],[77,1,"い"]],"text":"見よ、主なる神の目はこの罪を犯した国の上に注がれている。わたしはこれを地のおもてから断ち滅ぼす。しかし、わたしはヤコブの家をことごとくは滅ぼさない」と主は言われる。"},{"ref":"Amos.9.9","start":30009009,"end":30009009,"break":"line","breaks":[[12,"line"],[27,"line"],[50,"line"]],"ruby":[[1,1,"み"],[8,1,"めい"],[12,1,"ひと"],[18,1,"もの"],[37,1,"いえ"],[39,3,"ばんこくみん"],[52,1,"つぶ"],[54,1,"ち"],[56,1,"お"]],"text":"「見よ、わたしは命じて、人がふるいで物をふるうように、わたしはイスラエルの家を万国民のうちでふるう。ひと粒も地に落ちることはない。"},{"ref":"Amos.9.10","start":30009010,"end":30009010,"break":"line","breaks":[[12,"line"],[26,"line"],[37,"line"]],"ruby":[[2,1,"たみ"],[4,1,"つみ"],[13,1,"わざわい"],[20,1,"ちか"],[31,1,"のぞ"],[37,1,"い"],[39,1,"もの"],[50,1,"ころ"]],"text":"わが民の罪びと、すなわち『災はわれわれに近づかない、われわれに臨まない』と言う者どもはみな、つるぎで殺される。"},{"ref":"Amos.9.11","start":30009011,"end":30009011,"break":"stanza","breaks":[[6,"line"],[23,"line"],[42,"line"]],"ruby":[[2,1,"ひ"],[14,1,"たお"],[17,2,"まくや"],[20,1,"おこ"],[25,2,"はそん"],[28,1,"つくろ"],[37,1,"ところ"],[39,1,"おこ"],[45,1,"むかし"],[47,1,"とき"],[52,1,"た"]],"text":"その日には、わたしはダビデの倒れた幕屋を興し、その破損を繕い、そのくずれた所を興し、これを昔の時のように建てる。"},{"ref":"Amos.9.12","start":30009012,"end":30009012,"break":"line","breaks":[[15,"line"],[36,"line"],[47,"line"]],"ruby":[[3,1,"かれ"],[10,1,"のこ"],[13,1,"もの"],[20,1,"な"],[25,1,"よ"],[33,2,"くにたみ"],[36,2,"しょゆう"],[49,1,"こと"],[55,1,"しゅ"],[57,1,"い"]],"text":"これは彼らがエドムの残った者、およびわが名をもって呼ばれるすべての国民を所有するためである」とこの事をなされる主は言われる。"},{"ref":"Amos.9.13","start":30009013,"end":30009013,"break":"stanza","breaks":[[7,"line"],[21,"line"],[39,"line"],[56,"line"],[74,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"み"],[16,1,"とき"],[18,1,"く"],[23,1,"とき"],[27,1,"たがや"],[29,1,"もの"],[31,1,"か"],[33,1,"もの"],[35,2,"あいつ"],[43,1,"ふ"],[45,1,"もの"],[47,1,"たね"],[50,1,"もの"],[52,2,"あいつ"],[61,1,"やま"],[67,1,"さけ"],[79,1,"おか"],[81,1,"と"],[84,1,"なが"]],"text":"主は言われる、「見よ、このような時が来る。その時には、耕す者は刈る者に相継ぎ、ぶどうを踏む者は種まく者に相継ぐ。もろもろの山にはうまい酒がしたたり、もろもろの丘は溶けて流れる。"},{"ref":"Amos.9.14","start":30009014,"end":30009014,"break":"line","breaks":[[22,"line"],[37,"line"],[52,"line"]],"ruby":[[6,1,"たみ"],[13,2,"こうふく"],[19,1,"かえ"],[22,1,"かれ"],[25,1,"あ"],[28,2,"まちまち"],[31,1,"た"],[34,1,"す"],[40,1,"ばたけ"],[42,1,"つく"],[47,1,"さけ"],[49,1,"の"],[52,1,"その"],[54,1,"つく"],[59,1,"み"],[61,1,"た"]],"text":"わたしはわが民イスラエルの幸福をもとに返す。彼らは荒れた町々を建てて住み、ぶどう畑を作ってその酒を飲み、園を作ってその実を食べる。"},{"ref":"Amos.9.15","start":30009015,"end":30009015,"break":"line","breaks":[[17,"line"],[30,"line"],[45,"line"]],"ruby":[[4,1,"かれ"],[9,1,"ち"],[11,1,"う"],[17,1,"かれ"],[24,1,"あた"],[27,1,"ち"],[30,1,"ふたた"],[32,1,"ぬ"],[49,1,"かみ"],[51,1,"しゅ"],[53,1,"い"]],"text":"わたしは彼らをその地に植えつける。彼らはわたしが与えた地から再び抜きとられることはない」とあなたの神、主は言われる。"}]