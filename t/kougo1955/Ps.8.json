[{"ref":"Ps.8.1","start":19008001,"end":19008001,"break":"paragraph","title":"聖歌隊の指揮者によってギテトにあわせてうたわせたダビデの歌","breaks":[[22,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"しゅ"],[13,1,"な"],[15,1,"ち"],[25,1,"たっと"],[38,2,"えいこう"],[41,1,"てん"],[43,1,"うえ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[28,1,"うた"]],"text":"主、われらの主よ、あなたの名は地にあまねく、いかに尊いことでしょう。あなたの栄光は天の上にあり、"},{"ref":"Ps.8.2","start":19008002,"end":19008002,"break":"line","breaks":[[18,"line"],[30,"line"],[51,"line"]],"ruby":[[12,1,"くち"],[34,1,"てき"],[36,1,"うら"],[39,1,"は"],[42,1,"もの"],[45,1,"しず"],[54,1,"そな"],[62,1,"もう"]],"text":"みどりごと、ちのみごとの口によって、ほめたたえられています。あなたは敵と恨みを晴らす者とを静めるため、あだに備えて、とりでを設けられました。"},{"ref":"Ps.8.3","start":19008003,"end":19008003,"break":"line","breaks":[[19,"line"]],"ruby":[[9,1,"ゆび"],[15,1,"てん"],[17,1,"み"],[23,1,"もう"],[28,1,"つき"],[30,1,"ほし"],[33,1,"み"],[35,1,"おも"]],"text":"わたしは、あなたの指のわざなる天を見、あなたが設けられた月と星とを見て思います。"},{"ref":"Ps.8.4","start":19008004,"end":19008004,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"ひと"],[2,2,"なにもの"],[12,1,"こころ"],[24,1,"ひと"],[26,1,"こ"],[28,2,"なにもの"],[37,1,"かえり"]],"text":"人は何者なので、これをみ心にとめられるのですか、人の子は何者なので、これを顧みられるのですか。"},{"ref":"Ps.8.5","start":19008005,"end":19008005,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"すこ"],[5,1,"ひと"],[7,1,"かみ"],[11,1,"ひく"],[13,1,"つく"],[17,1,"さか"],[20,1,"ほまれ"]],"text":"ただ少しく人を神よりも低く造って、栄えと誉とをこうむらせ、"},{"ref":"Ps.8.6","start":19008006,"end":19008006,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"て"],[9,1,"おさ"],[18,1,"もの"],[22,1,"あし"],[24,1,"した"]],"text":"これにみ手のわざを治めさせ、よろずの物をその足の下におかれました。"},{"ref":"Ps.8.7","start":19008007,"end":19008007,"break":"line","ruby":[[4,1,"ひつじ"],[6,1,"うし"],[10,1,"の"],[12,1,"けもの"]],"text":"すべての羊と牛、また野の獣、"},{"ref":"Ps.8.8","start":19008008,"end":19008008,"break":"line","ruby":[[0,1,"そら"],[2,1,"とり"],[4,1,"うみ"],[6,1,"うお"],[8,2,"かいろ"],[11,1,"かよ"]],"text":"空の鳥と海の魚、海路を通うものまでも。"},{"ref":"Ps.8.9","start":19008009,"end":19008009,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"しゅ"],[13,1,"な"],[15,1,"ち"],[25,1,"たっと"]],"text":"主、われらの主よ、あなたの名は地にあまねく、いかに尊いことでしょう。"}]