[{"ref":"1Chr.29.1","start":13029001,"end":13029001,"break":"paragraph","ruby":[[3,1,"おう"],[7,1,"ぜん"],[8,2,"かいしゅう"],[11,1,"い"],[18,1,"こ"],[24,1,"かみ"],[32,1,"えら"],[36,1,"もの"],[44,1,"わか"],[47,2,"けいけん"],[55,2,"じぎょう"],[58,1,"おお"],[64,1,"みや"],[66,1,"ひと"],[75,1,"しゅ"],[78,1,"かみ"]],"text":"ダビデ王はまた全会衆に言った、「わが子ソロモンは神がただひとりを選ばれた者であるが、まだ若くて経験がなく、この事業は大きい。この宮は人のためではなく、主なる神のためだからである。"},{"ref":"1Chr.29.2","start":13029002,"end":13029002,"break":"none","ruby":[[7,1,"ちから"],[13,1,"かみ"],[15,1,"みや"],[20,1,"そな"],[28,1,"きん"],[30,1,"もの"],[32,1,"つく"],[37,1,"きん"],[39,1,"ぎん"],[41,1,"もの"],[46,1,"ぎん"],[48,2,"せいどう"],[51,1,"もの"],[56,2,"せいどう"],[59,1,"てつ"],[61,1,"もの"],[66,1,"てつ"],[68,1,"き"],[70,1,"もの"],[75,1,"き"],[77,1,"そな"],[83,1,"た"],[84,1,"しま"],[91,1,"いし"],[100,1,"いろ"],[105,1,"いし"],[112,2,"ほうせき"],[115,3,"だいりせき"]],"text":"そこでわたしは力をつくして神の宮のために備えた。すなわち金の物を造るために金、銀の物のために銀、青銅の物のために青銅、鉄の物のために鉄、木の物のために木を備えた。その他縞めのう、はめ石、アンチモニイ、色のついた石、さまざまの宝石、大理石などおびただしい。"},{"ref":"1Chr.29.3","start":13029003,"end":13029003,"break":"none","ruby":[[8,1,"かみ"],[10,1,"みや"],[12,2,"ねっしん"],[21,1,"せい"],[24,1,"いえ"],[29,1,"そな"],[36,1,"もの"],[38,1,"くわ"],[46,1,"も"],[51,2,"きんぎん"],[54,2,"ざいほう"],[59,1,"かみ"],[61,1,"みや"]],"text":"なおわたしはわが神の宮に熱心なるがゆえに、聖なる家のために備えたすべての物に加えて、わたしの持っている金銀の財宝をわが神の宮にささげる。"},{"ref":"1Chr.29.4","start":13029004,"end":13029004,"break":"none","ruby":[[8,1,"きん"],[16,1,"せい"],[17,1,"ぎん"],[32,2,"たてもの"],[35,1,"かべ"]],"text":"すなわちオフルの金三千タラント、精銀七千タラントをそのもろもろの建物の壁をおおうためにささげる。"},{"ref":"1Chr.29.5","start":13029005,"end":13029005,"break":"none","ruby":[[0,1,"きん"],[2,1,"きん"],[4,1,"もの"],[10,1,"ぎん"],[12,1,"ぎん"],[14,1,"もの"],[23,2,"こうじん"],[29,1,"つく"],[39,1,"もち"],[50,1,"しゅ"],[54,1,"み"],[60,1,"もの"],[65,1,"よろこ"],[71,1,"もの"]],"text":"金は金の物のために、銀は銀の物のために、すべて工人によって造られるもののために用いる。だれかきょう、主にその身をささげる者のように喜んでささげ物をするだろうか」。"},{"ref":"1Chr.29.6","start":13029006,"end":13029006,"break":"paragraph","ruby":[[3,2,"しぞく"],[6,1,"ちょう"],[16,2,"ぶぞく"],[26,1,"にん"],[28,1,"ちょう"],[31,1,"にん"],[33,1,"ちょう"],[37,1,"おう"],[39,2,"こうじ"],[47,1,"もの"],[51,1,"よろこ"],[57,1,"もの"]],"text":"そこで氏族の長たち、イスラエルの部族のつかさたち、千人の長、百人の長および王の工事をつかさどる者たちは喜んでささげ物をした。"},{"ref":"1Chr.29.7","start":13029007,"end":13029007,"break":"none","ruby":[[4,1,"かれ"],[7,1,"かみ"],[9,1,"みや"],[11,1,"つとめ"],[16,1,"きん"],[29,1,"ぎん"],[37,2,"せいどう"],[48,1,"てつ"]],"text":"こうして彼らは神の宮の務のために金五千タラント一万ダリク、銀一万タラント、青銅一万八千タラント、鉄十万タラントをささげた。"},{"ref":"1Chr.29.8","start":13029008,"end":13029008,"break":"none","ruby":[[0,2,"ほうせき"],[3,1,"も"],[8,1,"もの"],[25,1,"て"],[30,1,"かみ"],[32,1,"みや"],[34,1,"くら"],[36,1,"おさ"]],"text":"宝石を持っている者はそれをゲルションびとエヒエルの手によって神の宮の倉に納めた。"},{"ref":"1Chr.29.9","start":13029009,"end":13029009,"break":"none","ruby":[[0,1,"かれ"],[9,1,"こころ"],[16,1,"すす"],[19,1,"しゅ"],[28,1,"たみ"],[36,1,"すす"],[45,1,"よろこ"],[52,1,"おう"],[56,1,"おお"],[59,1,"よろこ"]],"text":"彼らがこのように真心からみずから進んで主にささげたので、民はそのみずから進んでささげたのを喜んだ。ダビデ王もまた大いに喜んだ。"},{"ref":"1Chr.29.10","start":13029010,"end":13029010,"break":"paragraph","ruby":[[7,1,"ぜん"],[8,2,"かいしゅう"],[11,1,"まえ"],[13,1,"しゅ"],[26,1,"い"],[36,2,"せんぞ"],[44,1,"かみ"],[46,1,"しゅ"]],"text":"そこでダビデは全会衆の前で主をほめたたえた。ダビデは言った、「われわれの先祖イスラエルの神、主よ、あなたはとこしえにほむべきかたです。"},{"ref":"1Chr.29.11","start":13029011,"end":13029011,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"おお"],[11,1,"ちから"],[14,2,"えいこう"],[18,2,"しょうり"],[22,2,"いこう"],[35,1,"てん"],[42,1,"ち"],[49,1,"みな"],[59,1,"しゅ"],[62,1,"くに"],[79,2,"ばんゆう"]],"text":"主よ、大いなることと、力と、栄光と、勝利と、威光とはあなたのものです。天にあるもの、地にあるものも皆あなたのものです。主よ、国もまたあなたのものです。あなたは万有のかしらとして、あがめられます。"},{"ref":"1Chr.29.12","start":13029012,"end":13029012,"break":"none","ruby":[[0,1,"とみ"],[2,1,"ほまれ"],[10,1,"で"],[18,2,"ばんゆう"],[34,1,"て"],[37,1,"いきお"],[40,1,"ちから"],[51,1,"て"],[60,1,"おお"],[67,1,"つよ"]],"text":"富と誉とはあなたから出ます。あなたは万有をつかさどられます。あなたの手には勢いと力があります。あなたの手はすべてのものを大いならしめ、強くされます。"},{"ref":"1Chr.29.13","start":13029013,"end":13029013,"break":"none","ruby":[[5,1,"かみ"],[21,2,"かんしゃ"],[29,2,"こうえい"],[33,1,"な"]],"text":"われわれの神よ、われわれは、いま、あなたに感謝し、あなたの光栄ある名をたたえます。"},{"ref":"1Chr.29.14","start":13029014,"end":13029014,"break":"paragraph","ruby":[[13,1,"よろこ"],[32,2,"なにもの"],[43,1,"たみ"],[45,1,"なに"],[55,1,"もの"],[62,1,"で"],[76,1,"う"]],"text":"しかしわれわれがこのように喜んでささげることができても、わたしは何者でしょう。わたしの民は何でしょう。すべての物はあなたから出ます。われわれはあなたから受けて、あなたにささげたのです。"},{"ref":"1Chr.29.15","start":13029015,"end":13029015,"break":"none","ruby":[[9,1,"まえ"],[16,2,"せんぞ"],[25,1,"たび"],[31,3,"きりゅうしゃ"],[42,1,"よ"],[46,1,"ひ"],[48,1,"かげ"],[54,1,"なが"]],"text":"われわれはあなたの前ではすべての先祖たちのように、旅びとです、寄留者です。われわれの世にある日は影のようで、長くとどまることはできません。"},{"ref":"1Chr.29.16","start":13029016,"end":13029016,"break":"none","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[14,1,"せい"],[17,1,"な"],[27,1,"いえ"],[29,1,"た"],[41,1,"そな"],[46,1,"おお"],[49,1,"もの"],[51,1,"みな"],[56,1,"て"],[59,1,"で"],[66,1,"みな"]],"text":"われわれの神、主よ、あなたの聖なる名のために、あなたに家を建てようとしてわれわれが備えたこの多くの物は皆あなたの手から出たもの、また皆あなたのものです。"},{"ref":"1Chr.29.17","start":13029017,"end":13029017,"break":"none","ruby":[[2,1,"かみ"],[9,1,"こころ"],[17,2,"しょうじき"],[20,1,"よろこ"],[32,1,"し"],[43,1,"ただ"],[46,1,"こころ"],[55,1,"もの"],[57,1,"よろこ"],[67,1,"いま"],[84,1,"たみ"],[86,1,"よろこ"],[94,1,"すす"],[104,1,"もの"],[110,1,"み"]],"text":"わが神よ、あなたは心をためし、また正直を喜ばれることを、わたしは知っています。わたしは正しい心で、このすべての物を喜んでささげました。今わたしはまた、ここにおるあなたの民が喜んで、みずから進んであなたにささげ物をするのを見ました。"},{"ref":"1Chr.29.18","start":13029018,"end":13029018,"break":"none","ruby":[[5,2,"せんぞ"],[23,1,"かみ"],[25,1,"しゅ"],[32,1,"たみ"],[34,1,"こころ"],[38,2,"いし"],[41,2,"せいしん"],[50,1,"たも"],[56,1,"こころ"],[62,1,"む"]],"text":"われわれの先祖アブラハム、イサク、イスラエルの神、主よ、あなたの民の心にこの意志と精神とをいつまでも保たせ、その心をあなたに向けさせてください。"},{"ref":"1Chr.29.19","start":13029019,"end":13029019,"break":"none","ruby":[[4,1,"こ"],[10,1,"こころ"],[20,2,"めいれい"],[42,1,"まも"],[55,1,"おこな"],[63,1,"そな"],[68,1,"みや"],[70,1,"た"]],"text":"またわが子ソロモンに心をつくしてあなたの命令と、あなたのあかしと、あなたのさだめとを守らせて、これをことごとく行わせ、わたしが備えをした宮を建てさせてください」。"},{"ref":"1Chr.29.20","start":13029020,"end":13029020,"break":"paragraph","ruby":[[7,1,"ぜん"],[8,2,"かいしゅう"],[23,1,"かみ"],[25,1,"しゅ"],[35,1,"い"],[41,1,"ぜん"],[42,2,"かいしゅう"],[45,2,"せんぞ"],[50,1,"かみ"],[52,1,"しゅ"],[60,1,"ふ"],[63,1,"しゅ"],[65,1,"はい"],[68,1,"おう"],[70,2,"けいれい"]],"text":"そしてダビデが全会衆にむかって、「あなたがたの神、主をほめたたえよ」と言ったので、全会衆は先祖たちの神、主をほめたたえ、伏して主を拝し、王に敬礼した。"},{"ref":"1Chr.29.21","start":13029021,"end":13029021,"break":"none","ruby":[[5,2,"よくじつ"],[7,1,"かれ"],[10,1,"ぜん"],[20,1,"しゅ"],[22,2,"ぎせい"],[34,2,"はんさい"],[39,2,"おうし"],[44,2,"おひつじ"],[49,2,"こひつじ"],[56,2,"かんさい"],[59,1,"とも"],[61,1,"しゅ"],[73,2,"ぎせい"]],"text":"そしてその翌日彼らは全イスラエルのために主に犠牲をささげた。すなわち燔祭として雄牛一千、雄羊一千、小羊一千をその灌祭と共に主にささげ、おびただしい犠牲をささげた。"},{"ref":"1Chr.29.22","start":13029022,"end":13029022,"break":"none","breaks":[[31,"paragraph"]],"ruby":[[5,1,"ひ"],[7,1,"かれ"],[10,1,"おお"],[14,1,"よろこ"],[20,1,"しゅ"],[22,1,"まえ"],[24,1,"く"],[26,1,"の"],[31,1,"かれ"],[37,1,"あらた"],[44,1,"こ"],[50,1,"おう"],[58,1,"あぶら"],[60,1,"そそ"],[63,1,"しゅ"],[65,1,"きみ"],[76,2,"さいし"]],"text":"そしてその日、彼らは大いなる喜びをもって主の前に食い飲みした。彼らはさらに改めてダビデの子ソロモンを王となし、これに油を注いで主の君となし、またザドクを祭司とした。"},{"ref":"1Chr.29.23","start":13029023,"end":13029023,"break":"none","ruby":[[11,1,"ちち"],[16,1,"かわ"],[19,1,"おう"],[23,1,"しゅ"],[25,1,"くらい"],[27,1,"ざ"],[31,1,"かれ"],[33,1,"さか"],[42,1,"みな"],[43,1,"かれ"],[45,1,"したが"]],"text":"こうしてソロモンはその父ダビデに代り、王として主の位に座した。彼は栄え、イスラエルは皆彼に従った。"},{"ref":"1Chr.29.24","start":13029024,"end":13029024,"break":"none","ruby":[[12,2,"ゆうし"],[23,1,"おう"],[25,2,"おうじ"],[30,1,"みな"],[35,1,"おう"],[37,2,"ちゅうせい"],[40,1,"ちか"]],"text":"またすべてのつかさたち、勇士たち、およびダビデ王の王子たちも皆ソロモン王に忠誠を誓った。"},{"ref":"1Chr.29.25","start":13029025,"end":13029025,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"ぜん"],[9,1,"め"],[11,1,"まえ"],[18,2,"ひじょう"],[21,1,"おお"],[28,1,"かれ"],[31,1,"まえ"],[41,1,"おう"],[43,1,"え"],[50,2,"おうい"],[53,1,"かれ"],[55,1,"あた"]],"text":"主は全イスラエルの目の前でソロモンを非常に大いならしめ、彼より前のイスラエルのどの王も得たことのない王威を彼に与えられた。"},{"ref":"1Chr.29.26","start":13029026,"end":13029026,"break":"paragraph","ruby":[[10,1,"こ"],[15,1,"ぜん"],[22,1,"おさ"]],"text":"このようにエッサイの子ダビデは全イスラエルを治めた。"},{"ref":"1Chr.29.27","start":13029027,"end":13029027,"break":"none","ruby":[[0,1,"かれ"],[8,1,"おさ"],[11,2,"きかん"],[16,1,"ねん"],[32,1,"ねん"],[33,1,"よ"],[35,1,"おさ"],[47,1,"ねん"],[48,1,"よ"],[50,1,"おさ"]],"text":"彼がイスラエルを治めた期間は四十年であった。すなわちヘブロンで七年世を治め、エルサレムで三十三年世を治めた。"},{"ref":"1Chr.29.28","start":13029028,"end":13029028,"break":"none","ruby":[[0,1,"かれ"],[2,2,"こうれい"],[5,1,"たっ"],[8,1,"ねん"],[10,1,"とみ"],[12,1,"ほまれ"],[14,1,"み"],[16,1,"た"],[19,1,"し"],[25,1,"こ"],[31,1,"かれ"],[33,1,"かわ"],[36,1,"おう"]],"text":"彼は高齢に達し、年も富も誉も満ち足りて死んだ。その子ソロモンが彼に代って王となった。"},{"ref":"1Chr.29.29","start":13029029,"end":13029029,"break":"none","ruby":[[3,1,"おう"],[5,2,"しじゅう"],[8,2,"こうい"],[12,3,"せんけんしゃ"],[20,1,"しょ"],[22,3,"よげんしゃ"],[29,1,"しょ"],[33,3,"せんけんしゃ"],[39,1,"しょ"]],"text":"ダビデ王の始終の行為は、先見者サムエルの書、預言者ナタンの書および先見者ガドの書にしるされている。"},{"ref":"1Chr.29.30","start":13029030,"end":13029030,"break":"none","ruby":[[6,1,"かれ"],[12,1,"せい"],[17,1,"ちから"],[21,1,"かれ"],[29,1,"た"],[35,2,"くにぐに"],[38,1,"のぞ"],[41,1,"こと"]],"text":"そのうちには彼のすべての政と、その力および彼とイスラエルと他のすべての国々に臨んだ事どもをしるしている。"}]