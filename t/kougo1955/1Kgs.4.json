[{"ref":"1Kgs.4.1","start":11004001,"end":11004001,"break":"paragraph","ruby":[[4,1,"おう"],[12,1,"ぜん"],[13,1,"ち"],[15,1,"おう"]],"text":"ソロモン王はイスラエルの全地の王であった。"},{"ref":"1Kgs.4.2","start":11004002,"end":11004002,"break":"none","ruby":[[0,1,"かれ"],[2,2,"こうかん"],[7,1,"つぎ"],[20,1,"こ"],[26,2,"さいし"]],"text":"彼の高官たちは次のとおりである。ザドクの子アザリヤは祭司。"},{"ref":"1Kgs.4.3","start":11004003,"end":11004003,"break":"none","ruby":[[4,1,"こ"],[15,3,"しょきかん"],[24,1,"こ"],[31,2,"しかん"]],"text":"シシャの子エリホレフとアヒヤは書記官。アヒルデの子ヨシャバテは史官。"},{"ref":"1Kgs.4.4","start":11004004,"end":11004004,"break":"none","ruby":[[5,1,"こ"],[10,1,"ぐん"],[12,1,"ちょう"],[24,2,"さいし"]],"text":"エホヤダの子ベナヤは軍の長。ザドクとアビヤタルは祭司。"},{"ref":"1Kgs.4.5","start":11004005,"end":11004005,"break":"none","ruby":[[4,1,"こ"],[10,2,"だいかん"],[13,1,"ちょう"],[19,1,"こ"],[24,2,"さいし"],[28,1,"おう"],[30,1,"とも"]],"text":"ナタンの子アザリヤは代官の長。ナタンの子ザブデは祭司で、王の友であった。"},{"ref":"1Kgs.4.6","start":11004006,"end":11004006,"break":"none","ruby":[[6,3,"くないきょう"],[14,1,"こ"],[21,2,"ちょうぼ"],[24,1,"ちょう"]],"text":"アヒシャルは宮内卿。アブダの子アドニラムは徴募の長であった。"},{"ref":"1Kgs.4.7","start":11004007,"end":11004007,"break":"paragraph","ruby":[[13,1,"ぜん"],[14,1,"ち"],[18,1,"にん"],[20,2,"だいかん"],[23,1,"お"],[29,2,"ひとびと"],[32,1,"おう"],[36,1,"いえ"],[41,2,"しょくもつ"],[44,1,"そな"],[57,1,"ねん"],[60,1,"つき"],[63,2,"しょくもつ"],[66,1,"そな"]],"text":"ソロモンはまたイスラエルの全地に十二人の代官を置いた。その人々は王とその家のために食物を備えた。すなわちおのおの一年に一月ずつ食物を備えるのであった。"},{"ref":"1Kgs.4.8","start":11004008,"end":11004008,"break":"none","ruby":[[2,1,"な"],[4,1,"つぎ"],[19,2,"さんち"]],"text":"その名は次のとおりである。エフライムの山地にはベンホル。"},{"ref":"1Kgs.4.9","start":11004009,"end":11004009,"break":"none","text":"マカヅと、シャラビムと、ベテシメシと、エロン・ベテハナンにはベンデケル。"},{"ref":"1Kgs.4.10","start":11004010,"end":11004010,"break":"none","ruby":[[13,1,"かれ"],[22,1,"ぜん"],[23,1,"ち"],[25,2,"たんとう"]],"text":"アルボテにはベンヘセデ、（彼はソコとヘペルの全地を担当した）。"},{"ref":"1Kgs.4.11","start":11004011,"end":11004011,"break":"none","ruby":[[3,2,"こうち"],[6,2,"ぜんぶ"],[20,1,"かれ"],[27,1,"むすめ"],[32,1,"つま"]],"text":"ドルの高地の全部にはベン・アビナダブ、（彼はソロモンの娘タパテを妻とした）。"},{"ref":"1Kgs.4.12","start":11004012,"end":11004012,"break":"none","ruby":[[5,1,"こ"],[25,1,"した"],[45,1,"ぜん"],[46,1,"ち"],[48,2,"たんとう"],[68,1,"いた"],[77,1,"む"],[83,1,"およ"]],"text":"アヒルデの子バアナはタアナクとメギドと、エズレルの下、ザレタンのかたわらにあるベテシャンの全地を担当して、ベテシャンからアベル・メホラに至り、ヨクメアムの向こうにまで及んだ。"},{"ref":"1Kgs.4.13","start":11004013,"end":11004013,"break":"none","ruby":[[17,1,"かれ"],[30,1,"こ"],[35,2,"むらむら"],[38,2,"たんとう"],[56,2,"ちほう"],[59,2,"じょうへき"],[62,2,"せいどう"],[65,1,"かん"],[67,1,"き"],[71,1,"おお"],[74,1,"まち"],[78,2,"たんとう"]],"text":"ラモテ・ギレアデにはベンゲベル、（彼はギレアデにあるマナセの子ヤイルの村々を担当し、またバシャンにあるアルゴブの地方の城壁と青銅の貫の木のある大きな町六十を担当した）。"},{"ref":"1Kgs.4.14","start":11004014,"end":11004014,"break":"none","ruby":[[10,1,"こ"]],"text":"マハナイムにはイドの子アヒナダブ。"},{"ref":"1Kgs.4.15","start":11004015,"end":11004015,"break":"none","ruby":[[13,1,"かれ"],[20,1,"むすめ"],[26,1,"つま"]],"text":"ナフタリにはアヒマアズ、（彼もソロモンの娘バスマテを妻にめとった）。"},{"ref":"1Kgs.4.16","start":11004016,"end":11004016,"break":"none","ruby":[[15,1,"こ"]],"text":"アセルとベアロテにはホシャイの子バアナ。"},{"ref":"1Kgs.4.17","start":11004017,"end":11004017,"break":"none","ruby":[[11,1,"こ"]],"text":"イッサカルにはパルアの子ヨシャパテ。"},{"ref":"1Kgs.4.18","start":11004018,"end":11004018,"break":"none","ruby":[[10,1,"こ"]],"text":"ベニヤミンにはエラの子シメイ。"},{"ref":"1Kgs.4.19","start":11004019,"end":11004019,"break":"none","ruby":[[6,1,"おう"],[11,1,"ち"],[20,1,"おう"],[24,1,"ち"],[32,1,"ち"],[38,1,"こ"],[43,1,"かれ"],[47,1,"ち"],[55,2,"だいかん"]],"text":"アモリびとの王シホンの地およびバシャンの王オグの地なるギレアデの地にはウリの子ゲベル。彼はその地のただひとりの代官であった。"},{"ref":"1Kgs.4.20","start":11004020,"end":11004020,"break":"paragraph","ruby":[[9,2,"ひとびと"],[12,1,"おお"],[16,1,"うみ"],[19,1,"すな"],[29,1,"かれ"],[32,1,"の"],[34,1,"く"],[38,1,"たの"]],"text":"ユダとイスラエルの人々は多くて、海べの砂のようであったが、彼らは飲み食いして楽しんだ。"},{"ref":"1Kgs.4.21","start":11004021,"end":11004021,"break":"none","ruby":[[9,1,"かわ"],[19,1,"ち"],[27,1,"さかい"],[29,1,"いた"],[34,2,"しょこく"],[37,1,"おさ"],[43,1,"みな"],[47,1,"もの"],[49,1,"たずさ"],[60,2,"いっしょう"],[66,1,"つか"]],"text":"ソロモンはユフラテ川からペリシテびとの地と、エジプトの境に至るまでの諸国を治めたので、皆みつぎ物を携えてきて、ソロモンの一生のあいだ仕えた。"},{"ref":"1Kgs.4.22","start":11004022,"end":11004022,"break":"paragraph","ruby":[[8,1,"にち"],[10,2,"しょくもつ"],[13,1,"こま"],[16,2,"むぎこ"],[23,1,"あら"],[25,2,"むぎこ"]],"text":"さてソロモンの一日の食物は細かい麦粉三十コル、荒い麦粉六十コル、"},{"ref":"1Kgs.4.23","start":11004023,"end":11004023,"break":"none","ruby":[[0,1,"こ"],[3,1,"うし"],[5,1,"とう"],[7,2,"まきば"],[10,1,"うし"],[13,1,"とう"],[15,1,"ひつじ"],[17,1,"とう"],[25,1,"お"],[41,1,"こ"],[44,1,"とり"]],"text":"肥えた牛十頭、牧場の牛二十頭、羊百頭で、そのほかに雄じか、かもしか、こじか、および肥えた鳥があった。"},{"ref":"1Kgs.4.24","start":11004024,"end":11004024,"break":"none","ruby":[[12,1,"かわ"],[14,1,"にし"],[16,2,"ちほう"],[34,1,"おさ"],[47,1,"かれ"],[53,1,"かわ"],[55,1,"にし"],[57,2,"しょおう"],[65,1,"おさ"],[68,2,"しゅうい"],[70,1,"いた"],[72,1,"ところ"],[74,2,"へいあん"],[77,1,"え"]],"text":"これはソロモンがユフラテ川の西の地方をテフサからガザまで、ことごとく治めたからである。すなわち彼はユフラテ川の西の諸王をことごとく治め、周囲至る所に平安を得た。"},{"ref":"1Kgs.4.25","start":11004025,"end":11004025,"break":"none","ruby":[[5,2,"いっしょう"],[8,1,"あいだ"],[29,1,"いた"],[34,1,"やす"],[42,2,"じぶん"],[51,1,"き"],[53,1,"した"],[61,1,"き"],[63,1,"した"],[65,1,"す"]],"text":"ソロモンの一生の間、ユダとイスラエルはダンからベエルシバに至るまで、安らかにおのおの自分たちのぶどうの木の下と、いちじくの木の下に住んだ。"},{"ref":"1Kgs.4.26","start":11004026,"end":11004026,"break":"none","ruby":[[7,2,"せんしゃ"],[10,1,"うま"],[20,2,"きへい"],[27,1,"も"]],"text":"ソロモンはまた戦車の馬の、うまや四千と、騎兵一万二千を持っていた。"},{"ref":"1Kgs.4.27","start":11004027,"end":11004027,"break":"none","ruby":[[7,2,"だいかん"],[16,2,"とうばん"],[19,1,"つき"],[25,1,"おう"],[40,1,"おう"],[42,2,"しょくたく"],[45,1,"つら"],[48,1,"もの"],[54,2,"しょくもつ"],[57,1,"そな"],[60,1,"か"]],"text":"そしてそれらの代官たちはおのおの当番の月にソロモン王のため、およびすべてソロモン王の食卓に連なる者のために、食物を備えて欠けることのないようにした。"},{"ref":"1Kgs.4.28","start":11004028,"end":11004028,"break":"none","ruby":[[2,1,"かれ"],[11,2,"わりあて"],[19,1,"うま"],[23,2,"はやうま"],[26,1,"く"],[30,2,"おおむぎ"],[39,1,"うま"],[43,1,"ところ"],[45,1,"も"]],"text":"また彼らはおのおのその割当にしたがって馬および早馬に食わせる大麦とわらを、その馬のいる所に持ってきた。"},{"ref":"1Kgs.4.29","start":11004029,"end":11004029,"break":"paragraph","ruby":[[0,1,"かみ"],[7,2,"ひじょう"],[10,1,"おお"],[13,2,"ちえ"],[16,1,"さと"],[19,1,"さづ"],[24,1,"うみ"],[27,2,"すなはら"],[33,1,"ひろ"],[35,1,"こころ"],[37,1,"さづ"]],"text":"神はソロモンに非常に多くの知恵と悟りを授け、また海べの砂原のように広い心を授けられた。"},{"ref":"1Kgs.4.30","start":11004030,"end":11004030,"break":"none","ruby":[[5,2,"ちえ"],[8,1,"ひがし"],[10,2,"ひとびと"],[13,2,"ちえ"],[25,2,"ちえ"]],"text":"ソロモンの知恵は東の人々の知恵とエジプトのすべての知恵にまさった。"},{"ref":"1Kgs.4.31","start":11004031,"end":11004031,"break":"none","ruby":[[0,1,"かれ"],[6,1,"ひと"],[10,1,"かしこ"],[31,1,"こ"],[47,1,"かしこ"],[52,2,"めいせい"],[55,2,"しゅうい"],[62,2,"くにぐに"],[65,1,"きこ"]],"text":"彼はすべての人よりも賢く、エズラびとエタンよりも、またマホルの子ヘマン、カルコル、ダルダよりも賢く、その名声は周囲のすべての国々に聞えた。"},{"ref":"1Kgs.4.32","start":11004032,"end":11004032,"break":"none","ruby":[[0,1,"かれ"],[4,2,"しんげん"],[9,1,"と"],[17,1,"うた"],[22,1,"しゅ"]],"text":"彼はまた箴言三千を説いた。またその歌は一千五首あった。"},{"ref":"1Kgs.4.33","start":11004033,"end":11004033,"break":"none","ruby":[[0,1,"かれ"],[4,2,"くさき"],[10,1,"ろん"],[18,2,"こうはく"],[22,1,"いし"],[35,1,"およ"],[39,1,"かれ"],[43,1,"けもの"],[45,1,"とり"],[47,1,"は"],[52,1,"うお"],[57,1,"ろん"]],"text":"彼はまた草木のことを論じてレバノンの香柏から石がきにはえるヒソプにまで及んだ。彼はまた獣と鳥と這うものと魚のことを論じた。"},{"ref":"1Kgs.4.34","start":11004034,"end":11004034,"break":"none","ruby":[[0,2,"しょこく"],[3,2,"ひとびと"],[11,2,"ちえ"],[14,1,"き"],[22,1,"ち"],[24,2,"しょおう"],[32,2,"ちえ"],[35,1,"き"],[38,1,"ひと"]],"text":"諸国の人々はソロモンの知恵を聞くためにきた。地の諸王はソロモンの知恵を聞いて人をつかわした。"}]