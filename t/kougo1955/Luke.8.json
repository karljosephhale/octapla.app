[{"ref":"Luke.8.1","start":42008001,"end":42008001,"break":"paragraph","ruby":[[9,1,"かみ"],[11,1,"くに"],[13,2,"ふくいん"],[16,1,"と"],[20,1,"つた"],[26,2,"まちまち"],[28,2,"むらむら"],[31,2,"じゅんかい"],[34,1,"つづ"],[43,2,"でし"],[47,1,"とも"]],"text":"そののちイエスは、神の国の福音を説きまた伝えながら、町々村々を巡回し続けられたが、十二弟子もお供をした。"},{"ref":"Luke.8.2","start":42008002,"end":42008002,"break":"none","ruby":[[2,2,"あくれい"],[5,1,"お"],[7,1,"だ"],[10,2,"びょうき"],[18,2,"すうめい"],[21,2,"ふじん"],[34,2,"あくれい"],[37,1,"お"],[39,1,"だ"],[51,1,"よ"]],"text":"また悪霊を追い出され病気をいやされた数名の婦人たち、すなわち、七つの悪霊を追い出してもらったマグダラと呼ばれるマリヤ、"},{"ref":"Luke.8.3","start":42008003,"end":42008003,"break":"none","ruby":[[4,2,"かれい"],[10,1,"つま"],[25,1,"おお"],[28,2,"ふじん"],[33,2,"いっしょ"],[39,2,"じぶん"],[44,1,"も"],[46,1,"もの"],[51,2,"いっこう"],[54,2,"ほうし"]],"text":"ヘロデの家令クーザの妻ヨハンナ、スザンナ、そのほか多くの婦人たちも一緒にいて、自分たちの持ち物をもって一行に奉仕した。"},{"ref":"Luke.8.4","start":42008004,"end":42008004,"break":"paragraph","ruby":[[3,1,"おお"],[7,2,"ぐんしゅう"],[10,1,"あつ"],[16,1,"うえ"],[18,2,"まちまち"],[23,1,"ひと"],[41,1,"お"],[43,1,"よ"],[54,1,"たとえ"],[56,1,"はなし"]],"text":"さて、大ぜいの群衆が集まり、その上、町々からの人たちがイエスのところに、ぞくぞくと押し寄せてきたので、一つの譬で話をされた、"},{"ref":"Luke.8.5","start":42008005,"end":42008005,"break":"none","ruby":[[1,1,"たね"],[5,1,"たね"],[10,1,"で"],[12,1,"い"],[27,1,"たね"],[29,1,"みち"],[33,1,"お"],[36,1,"ふ"],[46,1,"そら"],[48,1,"とり"],[50,1,"た"]],"text":"「種まきが種をまきに出て行った。まいているうちに、ある種は道ばたに落ち、踏みつけられ、そして空の鳥に食べられてしまった。"},{"ref":"Luke.8.6","start":42008006,"end":42008006,"break":"none","ruby":[[3,1,"たね"],[5,1,"いわ"],[7,1,"うえ"],[9,1,"お"],[18,2,"みずけ"],[25,1,"か"]],"text":"ほかの種は岩の上に落ち、はえはしたが水気がないので枯れてしまった。"},{"ref":"Luke.8.7","start":42008007,"end":42008007,"break":"none","ruby":[[3,1,"たね"],[10,1,"あいだ"],[12,1,"お"],[22,2,"いっしょ"],[25,1,"しげ"]],"text":"ほかの種は、いばらの間に落ちたので、いばらも一緒に茂ってきて、それをふさいでしまった。"},{"ref":"Luke.8.8","start":42008008,"end":42008008,"break":"none","ruby":[[8,1,"たね"],[10,1,"よ"],[12,1,"ち"],[14,1,"お"],[22,1,"そだ"],[26,1,"ばい"],[29,1,"み"],[31,1,"むす"],[38,1,"かた"],[45,1,"こえ"],[51,1,"き"],[53,1,"みみ"],[57,1,"もの"],[59,1,"き"],[66,1,"い"]],"text":"ところが、ほかの種は良い地に落ちたので、はえ育って百倍もの実を結んだ」。こう語られたのち、声をあげて「聞く耳のある者は聞くがよい」と言われた。"},{"ref":"Luke.8.9","start":42008009,"end":42008009,"break":"paragraph","ruby":[[0,2,"でし"],[8,1,"たとえ"],[14,2,"いみ"],[27,2,"しつもん"]],"text":"弟子たちは、この譬はどういう意味でしょうか、とイエスに質問した。"},{"ref":"Luke.8.10","start":42008010,"end":42008010,"break":"none","ruby":[[3,1,"い"],[17,1,"かみ"],[19,1,"くに"],[21,2,"おくぎ"],[24,1,"し"],[29,1,"ゆる"],[40,1,"ひと"],[46,1,"み"],[49,1,"み"],[53,1,"き"],[57,1,"さと"],[66,1,"たとえ"],[68,1,"はな"]],"text":"そこで言われた、「あなたがたには、神の国の奥義を知ることが許されているが、ほかの人たちには、見ても見えず、聞いても悟られないために、譬で話すのである。"},{"ref":"Luke.8.11","start":42008011,"end":42008011,"break":"none","ruby":[[2,1,"たとえ"],[8,2,"いみ"],[14,1,"たね"],[16,1,"かみ"],[18,1,"ことば"]],"text":"この譬はこういう意味である。種は神の言である。"},{"ref":"Luke.8.12","start":42008012,"end":42008012,"break":"none","ruby":[[0,1,"みち"],[4,1,"お"],[10,1,"き"],[16,1,"しん"],[22,1,"すく"],[35,2,"あくま"],[43,1,"こころ"],[46,2,"みことば"],[49,1,"うば"],[51,1,"と"],[55,1,"ひと"]],"text":"道ばたに落ちたのは、聞いたのち、信じることも救われることもないように、悪魔によってその心から御言が奪い取られる人たちのことである。"},{"ref":"Luke.8.13","start":42008013,"end":42008013,"break":"none","ruby":[[0,1,"いわ"],[2,1,"うえ"],[4,1,"お"],[10,2,"みことば"],[13,1,"き"],[16,1,"とき"],[19,1,"よろこ"],[22,1,"う"],[29,1,"ね"],[31,1,"な"],[41,1,"しん"],[48,2,"しれん"],[51,1,"とき"],[53,1,"く"],[57,2,"しんこう"],[60,1,"す"],[63,1,"ひと"]],"text":"岩の上に落ちたのは、御言を聞いた時には喜んで受けいれるが、根が無いので、しばらくは信じていても、試錬の時が来ると、信仰を捨てる人たちのことである。"},{"ref":"Luke.8.14","start":42008014,"end":42008014,"break":"none","ruby":[[4,1,"なか"],[6,1,"お"],[12,1,"き"],[17,1,"ひ"],[19,1,"す"],[26,2,"せいかつ"],[29,1,"こころ"],[34,1,"とみ"],[36,2,"かいらく"],[45,1,"み"],[47,1,"じゅく"],[57,1,"ひと"]],"text":"いばらの中に落ちたのは、聞いてから日を過ごすうちに、生活の心づかいや富や快楽にふさがれて、実の熟するまでにならない人たちのことである。"},{"ref":"Luke.8.15","start":42008015,"end":42008015,"break":"none","ruby":[[0,1,"よ"],[2,1,"ち"],[4,1,"お"],[10,2,"みことば"],[13,1,"き"],[22,1,"ただ"],[25,1,"よ"],[27,1,"こころ"],[34,1,"まも"],[37,1,"た"],[39,1,"しの"],[42,1,"み"],[44,1,"むす"],[47,1,"いた"],[49,1,"ひと"]],"text":"良い地に落ちたのは、御言を聞いたのち、これを正しい良い心でしっかりと守り、耐え忍んで実を結ぶに至る人たちのことである。"},{"ref":"Luke.8.16","start":42008016,"end":42008016,"break":"paragraph","ruby":[[15,1,"なに"],[18,1,"うつわ"],[29,2,"しんだい"],[32,1,"した"],[34,1,"お"],[43,2,"しょくだい"],[46,1,"うえ"],[48,1,"お"],[56,1,"く"],[58,1,"ひと"],[62,1,"ひかり"],[64,1,"み"]],"text":"だれもあかりをともして、それを何かの器でおおいかぶせたり、寝台の下に置いたりはしない。燭台の上に置いて、はいって来る人たちに光が見えるようにするのである。"},{"ref":"Luke.8.17","start":42008017,"end":42008017,"break":"none","ruby":[[0,1,"かく"],[24,2,"ひみつ"],[40,1,"し"],[44,1,"あか"],[48,1,"だ"]],"text":"隠されているもので、あらわにならないものはなく、秘密にされているもので、ついには知られ、明るみに出されないものはない。"},{"ref":"Luke.8.18","start":42008018,"end":42008018,"break":"none","ruby":[[6,1,"き"],[10,2,"ちゅうい"],[18,1,"も"],[23,1,"ひと"],[25,1,"さら"],[27,1,"あた"],[32,1,"も"],[38,1,"ひと"],[41,1,"も"],[47,1,"おも"],[58,1,"と"],[60,1,"あ"]],"text":"だから、どう聞くかに注意するがよい。持っている人は更に与えられ、持っていない人は、持っていると思っているものまでも、取り上げられるであろう」。"},{"ref":"Luke.8.19","start":42008019,"end":42008019,"break":"paragraph","ruby":[[7,1,"はは"],[9,2,"きょうだい"],[27,2,"ぐんしゅう"],[34,1,"ちか"],[37,1,"い"]],"text":"さて、イエスの母と兄弟たちとがイエスのところにきたが、群衆のためそば近くに行くことができなかった。"},{"ref":"Luke.8.20","start":42008020,"end":42008020,"break":"none","ruby":[[13,2,"ははうえ"],[16,2,"きょうだい"],[23,1,"め"],[30,1,"おも"],[34,1,"そと"],[36,1,"た"],[46,2,"とりつ"]],"text":"それで、だれかが「あなたの母上と兄弟がたが、お目にかかろうと思って、外に立っておられます」と取次いだ。"},{"ref":"Luke.8.21","start":42008021,"end":42008021,"break":"none","ruby":[[7,2,"ひとびと"],[14,1,"い"],[20,1,"かみ"],[22,2,"みことば"],[25,1,"き"],[28,1,"おこな"],[30,1,"もの"],[38,1,"はは"],[44,2,"きょうだい"]],"text":"するとイエスは人々にむかって言われた、「神の御言を聞いて行う者こそ、わたしの母、わたしの兄弟なのである」。"},{"ref":"Luke.8.22","start":42008022,"end":42008022,"break":"paragraph","ruby":[[2,1,"ひ"],[11,2,"でし"],[16,1,"ふね"],[18,1,"の"],[20,1,"こ"],[24,1,"みずうみ"],[26,1,"む"],[29,1,"ぎし"],[31,1,"わた"],[36,1,"い"],[43,2,"いちどう"],[46,2,"ふなで"]],"text":"ある日のこと、イエスは弟子たちと舟に乗り込み、「湖の向こう岸へ渡ろう」と言われたので、一同が船出した。"},{"ref":"Luke.8.23","start":42008023,"end":42008023,"break":"none","ruby":[[0,1,"わた"],[3,1,"い"],[5,1,"あいだ"],[12,1,"ねむ"],[24,2,"とっぷう"],[27,1,"みずうみ"],[29,1,"ふ"],[40,1,"かれ"],[43,1,"みず"],[49,2,"きけん"]],"text":"渡って行く間に、イエスは眠ってしまわれた。すると突風が湖に吹きおろしてきたので、彼らは水をかぶって危険になった。"},{"ref":"Luke.8.24","start":42008024,"end":42008024,"break":"none","ruby":[[8,1,"よ"],[17,1,"おこ"],[21,2,"せんせい"],[24,2,"せんせい"],[33,1,"し"],[41,1,"い"],[49,1,"お"],[51,1,"あ"],[56,1,"かぜ"],[58,2,"あらなみ"],[71,1,"や"]],"text":"そこで、みそばに寄ってきてイエスを起し、「先生、先生、わたしたちは死にそうです」と言った。イエスは起き上がって、風と荒浪とをおしかりになると、止んでなぎになった。"},{"ref":"Luke.8.25","start":42008025,"end":42008025,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[19,2,"しんこう"],[32,1,"かれ"],[35,1,"おそ"],[37,1,"おどろ"],[40,1,"たがい"],[42,1,"い"],[44,1,"あ"],[66,1,"めい"],[73,1,"かぜ"],[75,1,"みず"],[77,1,"したが"]],"text":"イエスは彼らに言われた、「あなたがたの信仰は、どこにあるのか」。彼らは恐れ驚いて互に言い合った、「いったい、このかたはだれだろう。お命じになると、風も水も従うとは」。"},{"ref":"Luke.8.26","start":42008026,"end":42008026,"break":"paragraph","ruby":[[5,1,"かれ"],[13,2,"たいがん"],[19,1,"びと"],[21,1,"ち"],[23,1,"わた"]],"text":"それから、彼らはガリラヤの対岸、ゲラサ人の地に渡った。"},{"ref":"Luke.8.27","start":42008027,"end":42008027,"break":"none","ruby":[[0,1,"りく"],[11,1,"まち"],[13,1,"ひと"],[16,2,"あくれい"],[23,1,"なが"],[28,2,"きもの"],[31,1,"き"],[34,1,"いえ"],[36,1,"い"],[42,2,"はかば"],[50,1,"ひと"],[53,2,"であ"]],"text":"陸にあがられると、その町の人で、悪霊につかれて長いあいだ着物も着ず、家に居つかないで墓場にばかりいた人に、出会われた。"},{"ref":"Luke.8.28","start":42008028,"end":42008028,"break":"none","ruby":[[2,1,"ひと"],[8,1,"み"],[10,1,"さけ"],[12,1,"だ"],[21,1,"ふ"],[24,2,"おおごえ"],[27,1,"い"],[34,1,"たか"],[36,1,"かみ"],[38,1,"こ"],[55,1,"かか"],[66,1,"ねが"],[75,1,"くる"]],"text":"この人がイエスを見て叫び出し、みまえにひれ伏して大声で言った、「いと高き神の子イエスよ、あなたはわたしとなんの係わりがあるのです。お願いです、わたしを苦しめないでください」。"},{"ref":"Luke.8.29","start":42008029,"end":42008029,"break":"none","ruby":[[8,1,"けが"],[11,1,"れい"],[16,1,"ひと"],[19,1,"で"],[21,1,"い"],[26,1,"めい"],[44,2,"あくれい"],[47,1,"なん"],[48,1,"ど"],[50,1,"かれ"],[54,1,"とら"],[60,1,"かれ"],[62,1,"くさり"],[64,1,"あし"],[74,1,"み"],[75,1,"し"],[86,1,"た"],[88,1,"き"],[92,2,"あくれい"],[98,2,"あらの"],[101,1,"お"]],"text":"それは、イエスが汚れた霊に、その人から出て行け、とお命じになったからである。というのは、悪霊が何度も彼をひき捕えたので、彼は鎖と足かせとでつながれて看視されていたが、それを断ち切っては悪霊によって荒野へ追いやられていたのである。"},{"ref":"Luke.8.30","start":42008030,"end":42008030,"break":"none","ruby":[[4,1,"かれ"],[12,2,"なまえ"],[18,1,"たず"],[31,1,"い"],[37,1,"こた"],[41,1,"かれ"],[43,1,"なか"],[50,2,"あくれい"],[56,1,"こ"]],"text":"イエスは彼に「なんという名前か」とお尋ねになると、「レギオンと言います」と答えた。彼の中にたくさんの悪霊がはいり込んでいたからである。"},{"ref":"Luke.8.31","start":42008031,"end":42008031,"break":"none","ruby":[[0,2,"あくれい"],[6,1,"そこ"],[7,1,"し"],[10,1,"ところ"],[12,1,"お"],[15,1,"い"],[20,2,"じぶん"],[26,1,"めい"],[41,1,"ねが"]],"text":"悪霊どもは、底知れぬ所に落ちて行くことを自分たちにお命じにならぬようにと、イエスに願いつづけた。"},{"ref":"Luke.8.32","start":42008032,"end":42008032,"break":"none","ruby":[[8,1,"やま"],[17,1,"ぶた"],[19,1,"む"],[22,1,"か"],[33,1,"ぶた"],[35,1,"なか"],[43,1,"ゆる"],[54,2,"あくれい"],[59,1,"ねが"],[61,1,"で"],[72,1,"ゆる"]],"text":"ところが、そこの山べにおびただしい豚の群れが飼ってあったので、その豚の中へはいることを許していただきたいと、悪霊どもが願い出た。イエスはそれをお許しになった。"},{"ref":"Luke.8.33","start":42008033,"end":42008033,"break":"none","ruby":[[3,2,"あくれい"],[11,1,"ひと"],[14,1,"で"],[16,1,"ぶた"],[18,1,"なか"],[23,1,"こ"],[32,1,"む"],[40,1,"みずうみ"],[46,1,"う"],[49,1,"か"],[51,1,"くだ"],[57,1,"し"]],"text":"そこで悪霊どもは、その人から出て豚の中へはいり込んだ。するとその群れは、がけから湖へなだれを打って駆け下り、おぼれ死んでしまった。"},{"ref":"Luke.8.34","start":42008034,"end":42008034,"break":"none","ruby":[[0,1,"か"],[2,1,"もの"],[9,3,"できごと"],[13,1,"み"],[15,1,"に"],[17,1,"だ"],[21,1,"まち"],[23,2,"むらざと"]],"text":"飼う者たちは、この出来事を見て逃げ出して、町や村里にふれまわった。"},{"ref":"Luke.8.35","start":42008035,"end":42008035,"break":"none","ruby":[[0,2,"ひとびと"],[5,3,"できごと"],[9,1,"み"],[11,1,"で"],[31,2,"あくれい"],[34,1,"お"],[36,1,"だ"],[43,1,"ひと"],[45,2,"きもの"],[48,1,"き"],[51,2,"しょうき"],[61,1,"あし"],[73,1,"み"],[76,1,"おそ"]],"text":"人々はこの出来事を見に出てきた。そして、イエスのところにきて、悪霊を追い出してもらった人が着物を着て、正気になってイエスの足もとにすわっているのを見て、恐れた。"},{"ref":"Luke.8.36","start":42008036,"end":42008036,"break":"none","ruby":[[3,1,"み"],[5,1,"ひと"],[12,2,"あくれい"],[21,1,"もの"],[23,1,"すく"],[27,2,"しだい"],[31,1,"かれ"],[34,1,"かた"],[36,1,"き"]],"text":"それを見た人たちは、この悪霊につかれていた者が救われた次第を、彼らに語り聞かせた。"},{"ref":"Luke.8.37","start":42008037,"end":42008037,"break":"none","ruby":[[9,2,"ちほう"],[12,2,"みんしゅう"],[20,2,"じぶん"],[25,1,"ところ"],[28,1,"た"],[30,1,"さ"],[45,1,"たの"],[49,1,"かれ"],[52,2,"ひじょう"],[55,2,"きょうふ"],[58,1,"おそ"],[78,1,"ふね"],[80,1,"の"],[83,1,"かえ"]],"text":"それから、ゲラサの地方の民衆はこぞって、自分たちの所から立ち去ってくださるようにとイエスに頼んだ。彼らが非常な恐怖に襲われていたからである。そこで、イエスは舟に乗って帰りかけられた。"},{"ref":"Luke.8.38","start":42008038,"end":42008038,"break":"none","ruby":[[0,2,"あくれい"],[3,1,"お"],[5,1,"だ"],[12,1,"ひと"],[16,1,"とも"],[27,1,"ねが"],[38,1,"い"],[41,1,"かれ"],[44,1,"かえ"]],"text":"悪霊を追い出してもらった人は、お供をしたいと、しきりに願ったが、イエスはこう言って彼をお帰しになった。"},{"ref":"Luke.8.39","start":42008039,"end":42008039,"break":"none","ruby":[[1,1,"いえ"],[3,1,"かえ"],[7,1,"かみ"],[17,1,"おお"],[32,1,"かた"],[34,1,"き"],[45,1,"かれ"],[47,1,"た"],[49,1,"さ"],[53,2,"じぶん"],[62,1,"くだ"],[75,2,"まちじゅう"],[78,1,"い"]],"text":"「家へ帰って、神があなたにどんなに大きなことをしてくださったか、語り聞かせなさい」。そこで彼は立ち去って、自分にイエスがして下さったことを、ことごとく町中に言いひろめた。"},{"ref":"Luke.8.40","start":42008040,"end":42008040,"break":"paragraph","ruby":[[4,1,"かえ"],[13,2,"ぐんしゅう"],[16,1,"よろこ"],[18,1,"むか"],[30,1,"ま"]],"text":"イエスが帰ってこられると、群衆は喜び迎えた。みんながイエスを待ちうけていたのである。"},{"ref":"Luke.8.41","start":42008041,"end":42008041,"break":"none","ruby":[[13,1,"な"],[15,1,"ひと"],[22,1,"ひと"],[24,3,"かいどうづかさ"],[36,1,"あし"],[42,1,"ふ"],[46,2,"じぶん"],[49,1,"いえ"],[67,1,"ねが"]],"text":"するとそこに、ヤイロという名の人がきた。この人は会堂司であった。イエスの足もとにひれ伏して、自分の家においでくださるようにと、しきりに願った。"},{"ref":"Luke.8.42","start":42008042,"end":42008042,"break":"none","ruby":[[0,1,"かれ"],[4,1,"さい"],[14,1,"むすめ"],[21,1,"し"],[38,1,"で"],[40,1,"い"],[44,2,"とちゅう"],[47,2,"ぐんしゅう"],[50,1,"お"],[52,1,"せま"]],"text":"彼に十二歳ばかりになるひとり娘があったが、死にかけていた。ところが、イエスが出て行かれる途中、群衆が押し迫ってきた。"},{"ref":"Luke.8.43","start":42008043,"end":42008043,"break":"paragraph","ruby":[[6,2,"ねんかん"],[9,1,"なが"],[10,1,"ち"],[20,2,"いしゃ"],[26,2,"じぶん"],[29,2,"しんだい"],[34,1,"つか"],[36,1,"はた"],[60,1,"おんな"]],"text":"ここに、十二年間も長血をわずらっていて、医者のために自分の身代をみな使い果してしまったが、だれにもなおしてもらえなかった女がいた。"},{"ref":"Luke.8.44","start":42008044,"end":42008044,"break":"none","ruby":[[2,1,"おんな"],[9,2,"ちかよ"],[14,1,"ころも"],[29,1,"なが"],[30,1,"ち"],[36,1,"と"]],"text":"この女がうしろから近寄ってみ衣のふさにさわったところ、その長血がたちまち止まってしまった。"},{"ref":"Luke.8.45","start":42008045,"end":42008045,"break":"none","ruby":[[4,1,"い"],[26,2,"ひとびと"],[31,2,"じぶん"],[38,1,"い"],[49,2,"せんせい"],[52,2,"ぐんしゅう"],[59,1,"と"],[61,1,"かこ"],[69,1,"あ"],[79,1,"こた"]],"text":"イエスは言われた、「わたしにさわったのは、だれか」。人々はみな自分ではないと言ったので、ペテロが「先生、群衆があなたを取り囲んで、ひしめき合っているのです」と答えた。"},{"ref":"Luke.8.46","start":42008046,"end":42008046,"break":"none","ruby":[[7,1,"い"],[26,1,"ちから"],[33,1,"で"],[35,1,"い"],[40,1,"かん"]],"text":"しかしイエスは言われた、「だれかがわたしにさわった。力がわたしから出て行ったのを感じたのだ」。"},{"ref":"Luke.8.47","start":42008047,"end":42008047,"break":"none","ruby":[[0,1,"おんな"],[2,1,"かく"],[10,1,"し"],[14,1,"ふる"],[19,1,"すす"],[21,1,"で"],[30,1,"ふ"],[41,1,"わけ"],[65,1,"まえ"],[67,1,"はな"]],"text":"女は隠しきれないのを知って、震えながら進み出て、みまえにひれ伏し、イエスにさわった訳と、さわるとたちまちなおったこととを、みんなの前で話した。"},{"ref":"Luke.8.48","start":42008048,"end":42008048,"break":"none","ruby":[[7,1,"おんな"],[9,1,"い"],[15,1,"むすめ"],[22,2,"しんこう"],[29,1,"すく"],[36,2,"あんしん"],[40,1,"い"]],"text":"そこでイエスが女に言われた、「娘よ、あなたの信仰があなたを救ったのです。安心して行きなさい」。"},{"ref":"Luke.8.49","start":42008049,"end":42008049,"break":"paragraph","ruby":[[6,1,"はな"],[17,3,"かいどうづかさ"],[21,1,"いえ"],[24,1,"ひと"],[31,1,"じょう"],[46,1,"うえ"],[48,2,"せんせい"],[51,1,"わずら"],[56,1,"およ"],[63,1,"い"]],"text":"イエスがまだ話しておられるうちに、会堂司の家から人がきて、「お嬢さんはなくなられました。この上、先生を煩わすには及びません」と言った。"},{"ref":"Luke.8.50","start":42008050,"end":42008050,"break":"none","ruby":[[10,1,"き"],[13,3,"かいどうづかさ"],[21,1,"い"],[27,1,"おそ"],[38,1,"しん"],[44,1,"むすめ"],[46,1,"たす"]],"text":"しかしイエスはこれを聞いて会堂司にむかって言われた、「恐れることはない。ただ信じなさい。娘は助かるのだ」。"},{"ref":"Luke.8.51","start":42008051,"end":42008051,"break":"none","ruby":[[4,1,"いえ"],[30,1,"こ"],[32,2,"ふぼ"],[42,2,"いっしょ"],[49,1,"く"],[55,1,"ゆる"]],"text":"それから家にはいられるとき、ペテロ、ヨハネ、ヤコブおよびその子の父母のほかは、だれも一緒にはいって来ることをお許しにならなかった。"},{"ref":"Luke.8.52","start":42008052,"end":42008052,"break":"none","ruby":[[0,2,"ひとびと"],[6,1,"むすめ"],[11,1,"な"],[13,1,"かな"],[24,1,"い"],[30,1,"な"],[34,1,"むすめ"],[36,1,"し"],[45,1,"ねむ"]],"text":"人々はみな、娘のために泣き悲しんでいた。イエスは言われた、「泣くな、娘は死んだのではない。眠っているだけである」。"},{"ref":"Luke.8.53","start":42008053,"end":42008053,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"むすめ"],[5,1,"し"],[11,1,"し"],[25,1,"わら"]],"text":"人々は娘が死んだことを知っていたので、イエスをあざ笑った。"},{"ref":"Luke.8.54","start":42008054,"end":42008054,"break":"none","ruby":[[4,1,"むすめ"],[6,1,"て"],[8,1,"と"],[12,1,"よ"],[17,1,"い"],[23,1,"むすめ"],[26,1,"お"]],"text":"イエスは娘の手を取って、呼びかけて言われた、「娘よ、起きなさい」。"},{"ref":"Luke.8.55","start":42008055,"end":42008055,"break":"none","ruby":[[5,1,"れい"],[14,1,"むすめ"],[16,2,"そくざ"],[19,1,"た"],[21,1,"あ"],[30,1,"なに"],[32,1,"た"],[34,1,"もの"],[36,1,"あた"]],"text":"するとその霊がもどってきて、娘は即座に立ち上がった。イエスは何か食べ物を与えるように、さしずをされた。"},{"ref":"Luke.8.56","start":42008056,"end":42008056,"break":"none","ruby":[[0,2,"りょうしん"],[3,1,"おどろ"],[17,3,"できごと"],[25,1,"はな"],[34,1,"かれ"],[37,1,"めい"]],"text":"両親は驚いてしまった。イエスはこの出来事をだれにも話さないようにと、彼らに命じられた。"}]