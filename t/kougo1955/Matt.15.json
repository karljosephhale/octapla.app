[{"ref":"Matt.15.1","start":40015001,"end":40015001,"break":"paragraph","ruby":[[8,1,"びと"],[10,2,"りっぽう"],[12,2,"がくしゃ"],[35,1,"い"]],"text":"ときに、パリサイ人と律法学者たちとが、エルサレムからイエスのもとにきて言った、"},{"ref":"Matt.15.2","start":40015002,"end":40015002,"break":"none","ruby":[[5,2,"でし"],[13,1,"むかし"],[15,2,"ひとびと"],[18,2,"いいつた"],[22,1,"やぶ"],[29,1,"かれ"],[32,2,"しょくじ"],[35,1,"とき"],[37,1,"て"],[39,1,"あら"]],"text":"「あなたの弟子たちは、なぜ昔の人々の言伝えを破るのですか。彼らは食事の時に手を洗っていません」。"},{"ref":"Matt.15.3","start":40015003,"end":40015003,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[22,2,"じぶん"],[27,2,"いいつた"],[35,1,"かみ"],[42,1,"やぶ"]],"text":"イエスは答えて言われた、「なぜ、あなたがたも自分たちの言伝えによって、神のいましめを破っているのか。"},{"ref":"Matt.15.4","start":40015004,"end":40015004,"break":"none","ruby":[[0,1,"かみ"],[2,1,"い"],[8,1,"ちち"],[10,1,"はは"],[13,1,"うやま"],[20,1,"ちち"],[24,1,"はは"],[30,1,"もの"],[33,1,"かなら"],[35,1,"し"],[37,1,"さだ"]],"text":"神は言われた、『父と母とを敬え』、また『父または母をののしる者は、必ず死に定められる』と。"},{"ref":"Matt.15.5","start":40015005,"end":40015005,"break":"none","ruby":[[17,1,"ちち"],[21,1,"はは"],[45,1,"そな"],[47,1,"もの"],[52,1,"い"]],"text":"それだのに、あなたがたは『だれでも父または母にむかって、あなたにさしあげるはずのこのものは供え物です、と言えば、"},{"ref":"Matt.15.6","start":40015006,"end":40015006,"break":"none","ruby":[[0,1,"ちち"],[4,1,"はは"],[6,1,"うやま"],[18,1,"い"],[34,2,"じぶん"],[39,2,"いいつた"],[47,1,"かみ"],[49,1,"ことば"],[51,1,"む"]],"text":"父または母を敬わなくてもよろしい』と言っている。こうしてあなたがたは自分たちの言伝えによって、神の言を無にしている。"},{"ref":"Matt.15.7","start":40015007,"end":40015007,"break":"none","ruby":[[0,3,"ぎぜんしゃ"],[25,2,"てきせつ"],[28,2,"よげん"]],"text":"偽善者たちよ、イザヤがあなたがたについて、こういう適切な預言をしている、"},{"ref":"Matt.15.8","start":40015008,"end":40015008,"break":"stanza","breaks":[[19,"line"]],"ruby":[[3,1,"たみ"],[6,1,"くち"],[15,1,"うやま"],[21,1,"こころ"],[28,1,"とお"],[30,1,"はな"]],"text":"『この民は、口さきではわたしを敬うが、その心はわたしから遠く離れている。"},{"ref":"Matt.15.9","start":40015009,"end":40015009,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"にんげん"],[8,1,"おしえ"],[12,1,"おし"],[15,3,"むいみ"],[23,1,"おが"]],"text":"人間のいましめを教として教え、無意味にわたしを拝んでいる』」。"},{"ref":"Matt.15.10","start":40015010,"end":40015010,"break":"paragraph","ruby":[[8,2,"ぐんしゅう"],[11,1,"よ"],[13,1,"よ"],[16,1,"い"],[22,1,"き"],[25,1,"さと"]],"text":"それからイエスは群衆を呼び寄せて言われた、「聞いて悟るがよい。"},{"ref":"Matt.15.11","start":40015011,"end":40015011,"break":"none","ruby":[[0,1,"くち"],[8,1,"ひと"],[10,1,"けが"],[23,1,"くち"],[26,1,"で"],[31,1,"ひと"],[33,1,"けが"]],"text":"口にはいるものは人を汚すことはない。かえって、口から出るものが人を汚すのである」。"},{"ref":"Matt.15.12","start":40015012,"end":40015012,"break":"none","ruby":[[5,2,"でし"],[10,2,"ちかよ"],[20,1,"い"],[29,1,"びと"],[33,2,"みことば"],[36,1,"き"],[49,1,"ぞん"]],"text":"そのとき、弟子たちが近寄ってきてイエスに言った、「パリサイ人たちが御言を聞いてつまずいたことを、ご存じですか」。"},{"ref":"Matt.15.13","start":40015013,"end":40015013,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[17,1,"てん"],[19,1,"ちち"],[22,1,"う"],[37,1,"ぬ"],[39,1,"と"]],"text":"イエスは答えて言われた、「わたしの天の父がお植えにならなかったものは、みな抜き取られるであろう。"},{"ref":"Matt.15.14","start":40015014,"end":40015014,"break":"none","ruby":[[0,1,"かれ"],[13,1,"かれ"],[16,2,"もうじん"],[19,2,"てび"],[24,2,"もうじん"],[32,2,"もうじん"],[35,2,"もうじん"],[38,2,"てび"],[51,1,"あな"],[53,1,"お"],[55,1,"こ"]],"text":"彼らをそのままにしておけ。彼らは盲人を手引きする盲人である。もし盲人が盲人を手引きするなら、ふたりとも穴に落ち込むであろう」。"},{"ref":"Matt.15.15","start":40015015,"end":40015015,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[14,1,"たとえ"],[16,2,"せつめい"]],"text":"ペテロが答えて言った、「その譬を説明してください」。"},{"ref":"Matt.15.16","start":40015016,"end":40015016,"break":"none","ruby":[[4,1,"い"]],"text":"イエスは言われた、「あなたがたも、まだわからないのか。"},{"ref":"Matt.15.17","start":40015017,"end":40015017,"break":"none","ruby":[[0,1,"くち"],[14,1,"はら"],[16,1,"なか"],[26,1,"そと"],[28,1,"で"],[30,1,"い"],[35,1,"し"]],"text":"口にはいってくるものは、みな腹の中にはいり、そして、外に出て行くことを知らないのか。"},{"ref":"Matt.15.18","start":40015018,"end":40015018,"break":"none","ruby":[[4,1,"くち"],[7,1,"で"],[9,1,"い"],[15,1,"こころ"],[17,1,"なか"],[20,1,"で"],[33,1,"ひと"],[35,1,"けが"]],"text":"しかし、口から出て行くものは、心の中から出てくるのであって、それが人を汚すのである。"},{"ref":"Matt.15.19","start":40015019,"end":40015019,"break":"none","ruby":[[6,1,"わる"],[8,1,"おも"],[16,2,"さつじん"],[19,2,"かんいん"],[22,3,"ふひんこう"],[26,1,"ぬす"],[29,2,"ぎしょう"],[32,1,"そし"],[36,1,"こころ"],[38,1,"なか"],[41,1,"で"]],"text":"というのは、悪い思い、すなわち、殺人、姦淫、不品行、盗み、偽証、誹りは、心の中から出てくるのであって、"},{"ref":"Matt.15.20","start":40015020,"end":40015020,"break":"none","ruby":[[7,1,"ひと"],[9,1,"けが"],[20,1,"あら"],[24,1,"て"],[26,2,"しょくじ"],[34,1,"ひと"],[36,1,"けが"]],"text":"これらのものが人を汚すのである。しかし、洗わない手で食事することは、人を汚すのではない」。"},{"ref":"Matt.15.21","start":40015021,"end":40015021,"break":"paragraph","ruby":[[10,1,"で"],[21,2,"ちほう"],[24,1,"い"]],"text":"さて、イエスはそこを出て、ツロとシドンとの地方へ行かれた。"},{"ref":"Matt.15.22","start":40015022,"end":40015022,"break":"none","ruby":[[10,2,"ちほう"],[12,1,"で"],[18,1,"おんな"],[20,1,"で"],[26,1,"しゅ"],[33,1,"こ"],[50,1,"むすめ"],[52,2,"あくれい"],[61,1,"くる"],[70,1,"い"],[73,1,"さけ"]],"text":"すると、そこへ、その地方出のカナンの女が出てきて、「主よ、ダビデの子よ、わたしをあわれんでください。娘が悪霊にとりつかれて苦しんでいます」と言って叫びつづけた。"},{"ref":"Matt.15.23","start":40015023,"end":40015023,"break":"none","ruby":[[10,1,"こと"],[13,1,"こた"],[26,2,"でし"],[37,1,"ねが"],[40,1,"い"],[47,1,"おんな"],[49,1,"お"],[51,1,"はら"],[59,1,"さけ"]],"text":"しかし、イエスはひと言もお答えにならなかった。そこで弟子たちがみもとにきて願って言った、「この女を追い払ってください。叫びながらついてきていますから」。"},{"ref":"Matt.15.24","start":40015024,"end":40015024,"break":"none","ruby":[[7,1,"こた"],[10,1,"い"],[27,1,"いえ"],[29,1,"うしな"],[33,1,"ひつじ"],[34,2,"いがい"],[37,1,"もの"]],"text":"するとイエスは答えて言われた、「わたしは、イスラエルの家の失われた羊以外の者には、つかわされていない」。"},{"ref":"Matt.15.25","start":40015025,"end":40015025,"break":"none","ruby":[[4,1,"おんな"],[6,2,"ちかよ"],[13,1,"はい"],[16,1,"い"],[21,1,"しゅ"],[29,1,"たす"]],"text":"しかし、女は近寄りイエスを拝して言った、「主よ、わたしをお助けください」。"},{"ref":"Matt.15.26","start":40015026,"end":40015026,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[13,2,"こども"],[21,1,"と"],[24,2,"こいぬ"],[27,1,"な"]],"text":"イエスは答えて言われた、「子供たちのパンを取って小犬に投げてやるのは、よろしくない」。"},{"ref":"Matt.15.27","start":40015027,"end":40015027,"break":"none","ruby":[[3,1,"おんな"],[5,1,"い"],[10,1,"しゅ"],[14,2,"ことば"],[25,2,"こいぬ"],[30,2,"しゅじん"],[33,2,"しょくたく"],[37,1,"お"]],"text":"すると女は言った、「主よ、お言葉どおりです。でも、小犬もその主人の食卓から落ちるパンくずは、いただきます」。"},{"ref":"Matt.15.28","start":40015028,"end":40015028,"break":"none","ruby":[[7,1,"こた"],[10,1,"い"],[16,1,"おんな"],[23,2,"しんこう"],[26,1,"み"],[40,1,"ねが"],[55,1,"とき"],[58,1,"むすめ"]],"text":"そこでイエスは答えて言われた、「女よ、あなたの信仰は見あげたものである。あなたの願いどおりになるように」。その時に、娘はいやされた。"},{"ref":"Matt.15.29","start":40015029,"end":40015029,"break":"paragraph","ruby":[[7,1,"さ"],[16,1,"うみ"],[19,1,"い"],[26,1,"やま"],[28,1,"のぼ"]],"text":"イエスはそこを去って、ガリラヤの海べに行き、それから山に登ってそこにすわられた。"},{"ref":"Matt.15.30","start":40015030,"end":40015030,"break":"none","ruby":[[3,1,"おお"],[7,2,"ぐんしゅう"],[11,1,"あし"],[15,3,"ふぐしゃ"],[19,2,"もうじん"],[29,1,"おお"],[32,2,"ひとびと"],[35,1,"つ"],[45,1,"あし"],[49,1,"お"],[55,1,"かれ"]],"text":"すると大ぜいの群衆が、足なえ、不具者、盲人、おし、そのほか多くの人々を連れてきて、イエスの足もとに置いたので、彼らをおいやしになった。"},{"ref":"Matt.15.31","start":40015031,"end":40015031,"break":"none","ruby":[[0,2,"ぐんしゅう"],[7,1,"もの"],[9,1,"い"],[12,3,"ふぐしゃ"],[16,1,"なお"],[19,1,"あし"],[23,1,"ある"],[26,2,"もうじん"],[29,1,"み"],[40,1,"み"],[42,1,"おどろ"],[54,1,"かみ"]],"text":"群衆は、おしが物を言い、不具者が直り、足なえが歩き、盲人が見えるようになったのを見て驚き、そしてイスラエルの神をほめたたえた。"},{"ref":"Matt.15.32","start":40015032,"end":40015032,"break":"paragraph","ruby":[[4,2,"でし"],[9,1,"よ"],[11,1,"よ"],[14,1,"い"],[22,2,"ぐんしゅう"],[37,2,"かかん"],[44,2,"いっしょ"],[52,1,"なに"],[54,1,"た"],[67,1,"かれ"],[70,2,"くうふく"],[76,1,"かえ"],[85,1,"おそ"],[88,2,"とちゅう"],[91,1,"よわ"],[93,1,"き"]],"text":"イエスは弟子たちを呼び寄せて言われた、「この群衆がかわいそうである。もう三日間もわたしと一緒にいるのに、何も食べるものがない。しかし、彼らを空腹のままで帰らせたくはない。恐らく途中で弱り切ってしまうであろう」。"},{"ref":"Matt.15.33","start":40015033,"end":40015033,"break":"none","ruby":[[0,2,"でし"],[5,1,"い"],[10,2,"あらの"],[13,1,"なか"],[20,1,"おお"],[24,2,"ぐんしゅう"],[32,1,"た"],[51,1,"て"],[53,1,"い"]],"text":"弟子たちは言った、「荒野の中で、こんなに大ぜいの群衆にじゅうぶん食べさせるほどたくさんのパンを、どこで手に入れましょうか」。"},{"ref":"Matt.15.34","start":40015034,"end":40015034,"break":"none","ruby":[[4,2,"でし"],[21,1,"たず"],[38,1,"ちい"],[41,1,"うお"],[43,1,"すこ"],[51,1,"こた"]],"text":"イエスは弟子たちに「パンはいくつあるか」と尋ねられると、「七つあります。また小さい魚が少しあります」と答えた。"},{"ref":"Matt.15.35","start":40015035,"end":40015035,"break":"none","ruby":[[7,2,"ぐんしゅう"],[11,1,"ち"],[20,1,"めい"]],"text":"そこでイエスは群衆に、地にすわるようにと命じ、"},{"ref":"Matt.15.36","start":40015036,"end":40015036,"break":"none","ruby":[[6,1,"うお"],[9,1,"と"],[12,2,"かんしゃ"],[22,2,"でし"],[32,2,"でし"],[40,2,"ぐんしゅう"]],"text":"七つのパンと魚とを取り、感謝してこれをさき、弟子たちにわたされ、弟子たちはこれを群衆にわけた。"},{"ref":"Matt.15.37","start":40015037,"end":40015037,"break":"none","ruby":[[0,2,"いちどう"],[3,1,"もの"],[5,1,"た"],[8,2,"まんぷく"],[16,1,"のこ"],[24,1,"あつ"]],"text":"一同の者は食べて満腹した。そして残ったパンくずを集めると、七つのかごにいっぱいになった。"},{"ref":"Matt.15.38","start":40015038,"end":40015038,"break":"none","ruby":[[0,1,"た"],[3,1,"もの"],[6,1,"おんな"],[8,2,"こども"],[12,1,"のぞ"],[17,1,"にん"]],"text":"食べた者は、女と子供とを除いて四千人であった。"},{"ref":"Matt.15.39","start":40015039,"end":40015039,"break":"none","ruby":[[7,2,"ぐんしゅう"],[10,2,"かいさん"],[15,1,"ふね"],[17,1,"の"],[25,2,"ちほう"],[28,1,"い"]],"text":"そこでイエスは群衆を解散させ、舟に乗ってマガダンの地方へ行かれた。"}]