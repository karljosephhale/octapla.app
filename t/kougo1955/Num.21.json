[{"ref":"Num.21.1","start":4021001,"end":4021001,"break":"paragraph","ruby":[[0,1,"とき"],[6,1,"す"],[20,1,"おう"],[34,1,"みち"],[40,1,"く"],[43,1,"き"],[53,2,"こうげき"],[62,2,"すうにん"],[65,2,"ほりょ"]],"text":"時にネゲブに住んでいたカナンびとアラデの王は、イスラエルがアタリムの道をとおって来ると聞いて、イスラエルを攻撃し、そのうちの数人を捕虜にした。"},{"ref":"Num.21.2","start":4021002,"end":4021002,"break":"none","ruby":[[9,1,"しゅ"],[11,1,"ちか"],[14,1,"た"],[17,1,"い"],[31,1,"たみ"],[37,1,"て"],[57,2,"まちまち"],[65,1,"ほろ"]],"text":"そこでイスラエルは主に誓いを立てて言った、「もし、あなたがこの民をわたしの手にわたしてくださるならば、わたしはその町々をことごとく滅ぼしましょう」。"},{"ref":"Num.21.3","start":4021003,"end":4021003,"break":"none","ruby":[[0,1,"しゅ"],[8,2,"ことば"],[11,1,"き"],[47,2,"まちまち"],[56,1,"ほろ"],[66,1,"ところ"],[68,1,"な"],[74,1,"よ"]],"text":"主はイスラエルの言葉を聞きいれ、カナンびとをわたされたので、イスラエルはそのカナンびとと、その町々とをことごとく滅ぼした。それでその所の名はホルマと呼ばれた。"},{"ref":"Num.21.4","start":4021004,"end":4021004,"break":"paragraph","ruby":[[0,1,"たみ"],[4,1,"やま"],[7,1,"すす"],[10,2,"こうかい"],[13,1,"みち"],[24,1,"ち"],[26,1,"まわ"],[34,1,"たみ"],[38,1,"みち"],[40,1,"た"]],"text":"民はホル山から進み、紅海の道をとおって、エドムの地を回ろうとしたが、民はその道に堪えがたくなった。"},{"ref":"Num.21.5","start":4021005,"end":4021005,"break":"none","ruby":[[0,1,"たみ"],[2,1,"かみ"],[18,1,"い"],[43,1,"みちび"],[45,1,"のぼ"],[49,2,"あらの"],[52,1,"し"],[69,2,"しょくもつ"],[75,1,"みず"],[91,2,"そあく"],[94,2,"しょくもつ"]],"text":"民は神とモーセとにむかい、つぶやいて言った、「あなたがたはなぜわたしたちをエジプトから導き上って、荒野で死なせようとするのですか。ここには食物もなく、水もありません。わたしたちはこの粗悪な食物はいやになりました」。"},{"ref":"Num.21.6","start":4021006,"end":4021006,"break":"none","ruby":[[3,1,"しゅ"],[6,1,"ひ"],[11,1,"たみ"],[16,1,"おく"],[24,1,"たみ"],[38,1,"たみ"],[43,1,"おお"],[49,1,"し"]],"text":"そこで主は、火のへびを民のうちに送られた。へびは民をかんだので、イスラエルの民のうち、多くのものが死んだ。"},{"ref":"Num.21.7","start":4021007,"end":4021007,"break":"none","ruby":[[0,1,"たみ"],[9,1,"い"],[12,1,"い"],[23,1,"しゅ"],[44,1,"つみ"],[46,1,"おか"],[65,1,"と"],[67,1,"さ"],[74,1,"しゅ"],[76,1,"いの"],[89,1,"たみ"],[94,1,"いの"]],"text":"民はモーセのもとに行って言った、「わたしたちは主にむかい、またあなたにむかい、つぶやいて罪を犯しました。どうぞへびをわたしたちから取り去られるように主に祈ってください」。モーセは民のために祈った。"},{"ref":"Num.21.8","start":4021008,"end":4021008,"break":"none","ruby":[[3,1,"しゅ"],[9,1,"い"],[15,1,"ひ"],[20,1,"つく"],[30,1,"うえ"],[32,1,"か"],[46,1,"もの"],[48,1,"あお"],[55,1,"み"],[60,1,"い"]],"text":"そこで主はモーセに言われた、「火のへびを造って、それをさおの上に掛けなさい。すべてのかまれた者が仰いで、それを見るならば生きるであろう」。"},{"ref":"Num.21.9","start":4021009,"end":4021009,"break":"none","ruby":[[4,2,"せいどう"],[13,1,"つく"],[22,1,"うえ"],[24,1,"か"],[27,1,"お"],[41,1,"もの"],[45,2,"せいどう"],[51,1,"あお"],[54,1,"み"],[56,1,"い"]],"text":"モーセは青銅で一つのへびを造り、それをさおの上に掛けて置いた。すべてへびにかまれた者はその青銅のへびを仰いで見て生きた。"},{"ref":"Num.21.10","start":4021010,"end":4021010,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"みち"],[11,1,"すす"],[18,2,"しゅくえい"]],"text":"イスラエルの人々は道を進んでオボテに宿営した。"},{"ref":"Num.21.11","start":4021011,"end":4021011,"break":"none","ruby":[[7,1,"すす"],[10,1,"ひがし"],[12,1,"ほう"],[18,1,"まえ"],[22,2,"あらの"],[36,2,"しゅくえい"]],"text":"またオボテから進んで東の方、モアブの前にある荒野において、イエアバリムに宿営した。"},{"ref":"Num.21.12","start":4021012,"end":4021012,"break":"none","ruby":[[6,1,"すす"],[13,1,"たに"],[15,2,"しゅくえい"]],"text":"またそこから進んでゼレデの谷に宿営し、"},{"ref":"Num.21.13","start":4021013,"end":4021013,"break":"none","ruby":[[7,1,"すす"],[14,1,"かわ"],[20,2,"しゅくえい"],[29,1,"かわ"],[37,1,"さかい"],[40,1,"の"],[42,1,"ひろ"],[45,2,"あらの"],[48,1,"なが"],[66,1,"あいだ"],[76,1,"さかい"]],"text":"さらにそこから進んでアルノン川のかなたに宿営した。アルノン川はアモリびとの境から延び広がる荒野を流れるもので、モアブとアモリびととの間にあって、モアブの境をなしていた。"},{"ref":"Num.21.14","start":4021014,"end":4021014,"break":"none","breaks":[[24,"stanza"],[32,"line"]],"ruby":[[7,1,"しゅ"],[9,1,"たたか"],[12,1,"しょ"],[17,1,"い"],[37,2,"たにだに"]],"text":"それゆえに、「主の戦いの書」にこう言われている。「スパのワヘブ、アルノンの谷々、"},{"ref":"Num.21.15","start":4021015,"end":4021015,"break":"line","breaks":[[6,"line"],[15,"line"]],"ruby":[[0,2,"たにだに"],[3,2,"しゃめん"],[9,1,"まち"],[12,1,"かたむ"],[19,1,"さかい"],[21,1,"よ"]],"text":"谷々の斜面、アルの町まで傾き、モアブの境に寄りかかる」。"},{"ref":"Num.21.16","start":4021016,"end":4021016,"break":"paragraph","ruby":[[0,1,"かれ"],[11,1,"すす"],[14,1,"い"],[21,1,"しゅ"],[33,1,"たみ"],[35,1,"あつ"],[47,1,"みず"],[49,1,"あた"],[58,1,"い"],[62,2,"いど"]],"text":"彼らはそこからベエルへ進んで行った。これは主がモーセにむかって、「民を集めよ。わたしはかれらに水を与えるであろう」と言われた井戸である。"},{"ref":"Num.21.17","start":4021017,"end":4021017,"break":"none","breaks":[[18,"stanza"],[31,"line"]],"ruby":[[2,1,"とき"],[11,1,"うた"],[19,2,"いど"],[22,1,"みず"],[31,2,"ひとびと"],[37,2,"いど"],[43,1,"うた"]],"text":"その時イスラエルはこの歌をうたった。「井戸の水よ、わきあがれ、人々よ、この井戸のために歌え、"},{"ref":"Num.21.18","start":4021018,"end":4021018,"break":"line","breaks":[[9,"line"],[23,"line"]],"ruby":[[0,1,"しゃく"],[17,2,"いど"],[20,1,"ほ"],[23,1,"たみ"],[33,1,"ほ"],[41,1,"かれ"],[44,2,"あらの"],[53,1,"すす"]],"text":"笏とつえとをもってつかさたちがこの井戸を掘り、民のおさたちがこれを掘った」。そして彼らは荒野からマッタナに進み、"},{"ref":"Num.21.19","start":4021019,"end":4021019,"break":"none","text":"マッタナからナハリエルに、ナハリエルからバモテに、"},{"ref":"Num.21.20","start":4021020,"end":4021020,"break":"none","ruby":[[9,1,"の"],[13,1,"たに"],[15,1,"い"],[18,2,"あらの"],[21,1,"み"],[29,1,"いただき"],[31,1,"つ"]],"text":"バモテからモアブの野にある谷に行き、荒野を見おろすピスガの頂に着いた。"},{"ref":"Num.21.21","start":4021021,"end":4021021,"break":"paragraph","ruby":[[15,1,"おう"],[20,2,"ししゃ"],[28,1,"い"]],"text":"ここでイスラエルはアモリびとの王シホンに使者をつかわして言わせた、"},{"ref":"Num.21.22","start":4021022,"end":4021022,"break":"none","ruby":[[9,1,"くに"],[11,1,"とお"],[26,1,"はたけ"],[32,1,"はたけ"],[45,2,"いど"],[48,1,"みず"],[50,1,"の"],[66,2,"りょうち"],[69,1,"とお"],[71,1,"す"],[79,1,"おう"],[81,2,"おおじ"],[84,1,"とお"]],"text":"「わたしにあなたの国を通らせてください。わたしたちは畑にもぶどう畑にも、はいりません。また井戸の水も飲みません。わたしたちはあなたの領地を通り過ぎるまで、ただ王の大路を通ります」。"},{"ref":"Num.21.23","start":4021023,"end":4021023,"break":"none","ruby":[[14,2,"じぶん"],[17,2,"りょうち"],[20,1,"とお"],[25,1,"ゆる"],[39,1,"たみ"],[46,1,"あつ"],[49,2,"あらの"],[52,1,"で"],[61,1,"せ"],[80,1,"たたか"]],"text":"しかし、シホンはイスラエルに自分の領地を通ることを許さなかった。そしてシホンは民をことごとく集め、荒野に出て、イスラエルを攻めようとし、ヤハズにきてイスラエルと戦った。"},{"ref":"Num.21.24","start":4021024,"end":4021024,"break":"none","ruby":[[11,1,"かれ"],[13,1,"う"],[30,1,"かれ"],[32,1,"ち"],[34,2,"せんりょう"],[45,1,"さかい"],[47,1,"およ"],[62,1,"さかい"]],"text":"イスラエルは、やいばで彼を撃ちやぶり、アルノンからヤボクまで彼の地を占領し、アンモンびとの境に及んだ。ヤゼルはアンモンびとの境だからである。"},{"ref":"Num.21.25","start":4021025,"end":4021025,"break":"none","ruby":[[14,2,"まちまち"],[22,1,"と"],[45,2,"まちまち"],[48,1,"す"],[59,2,"ふぞく"],[67,2,"むらむら"]],"text":"こうしてイスラエルはこれらの町々をことごとく取った。そしてイスラエルはアモリびとのすべての町々に住み、ヘシボンとそれに附属するすべての村々にいた。"},{"ref":"Num.21.26","start":4021026,"end":4021026,"break":"none","ruby":[[11,1,"おう"],[16,1,"みやこ"],[30,2,"いぜん"],[33,1,"おう"],[35,1,"たたか"],[39,1,"かれ"],[41,1,"ち"],[57,1,"て"],[60,1,"うば"],[62,1,"と"]],"text":"ヘシボンはアモリびとの王シホンの都であって、シホンはモアブの以前の王と戦って、彼の地をアルノンまで、ことごとくその手から奪い取ったのである。"},{"ref":"Num.21.27","start":4021027,"end":4021027,"break":"none","breaks":[[15,"stanza"],[29,"line"]],"ruby":[[5,1,"うた"],[16,2,"ひとびと"],[33,1,"まち"],[35,1,"きず"],[37,1,"た"]],"text":"それゆえに歌にうたわれている。「人々よ、ヘシボンにきたれ、シホンの町を築き建てよ。"},{"ref":"Num.21.28","start":4021028,"end":4021028,"break":"line","breaks":[[13,"line"],[25,"line"],[37,"line"]],"ruby":[[6,1,"ひ"],[8,1,"も"],[10,1,"だ"],[17,1,"みやこ"],[20,1,"ほのお"],[22,1,"で"],[32,1,"や"],[34,1,"つく"],[42,2,"こうち"],[45,1,"きみ"],[49,1,"ほろ"]],"text":"ヘシボンから火が燃え出し、シホンの都から炎が出て、モアブのアルを焼き尽し、アルノンの高地の君たちを滅ぼしたからだ。"},{"ref":"Num.21.29","start":4021029,"end":4021029,"break":"line","breaks":[[17,"line"],[37,"line"],[51,"line"]],"ruby":[[6,1,"まえ"],[21,1,"たみ"],[25,1,"まえ"],[27,1,"ほろ"],[37,1,"かれ"],[45,1,"に"],[47,1,"さ"],[51,1,"むすめ"],[60,1,"おう"],[65,2,"ほりょ"]],"text":"モアブよ、お前はわざわいなるかな、ケモシの民よ、お前は滅ぼされるであろう。彼は、むすこらを逃げ去らせ、娘らをアモリびとの王シホンの捕虜とならせた。"},{"ref":"Num.21.30","start":4021030,"end":4021030,"break":"line","breaks":[[12,"line"],[24,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こ"],[6,1,"ほろ"],[8,1,"さ"],[29,1,"あら"],[33,1,"ひ"],[42,1,"およ"]],"text":"彼らの子らは滅び去った、ヘシボンからデボンまで。われわれは荒した、火はついてメデバに及んだ」。"},{"ref":"Num.21.31","start":4021031,"end":4021031,"break":"paragraph","ruby":[[16,1,"ち"],[18,1,"す"]],"text":"こうしてイスラエルはアモリびとの地に住んだが、"},{"ref":"Num.21.32","start":4021032,"end":4021032,"break":"none","ruby":[[6,1,"ひと"],[17,1,"さぐ"],[26,2,"むらむら"],[29,1,"と"],[44,1,"お"],[46,1,"だ"]],"text":"モーセはまた人をつかわしてヤゼルを探らせ、ついにその村々を取って、そこにいたアモリびとを追い出し、"},{"ref":"Num.21.33","start":4021033,"end":4021033,"break":"none","ruby":[[0,1,"てん"],[8,1,"みち"],[10,1,"のぼ"],[13,1,"い"],[23,1,"おう"],[30,1,"たみ"],[37,1,"ひき"],[45,1,"たたか"],[51,2,"でむか"]],"text":"転じてバシャンの道に上って行ったが、バシャンの王オグは、その民をことごとく率い、エデレイで戦おうとして出迎えた。"},{"ref":"Num.21.34","start":4021034,"end":4021034,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"かれ"],[14,1,"おそ"],[27,1,"かれ"],[31,1,"たみ"],[35,1,"ち"],[48,1,"て"],[63,1,"す"],[74,1,"おう"],[84,1,"かれ"]],"text":"主はモーセに言われた、「彼を恐れてはならない。わたしは彼とその民とその地とを、ことごとくあなたの手にわたす。あなたはヘシボンに住んでいたアモリびとの王シホンにしたように彼にもするであろう」。"},{"ref":"Num.21.35","start":4021035,"end":4021035,"break":"none","ruby":[[3,1,"かれ"],[7,1,"こ"],[13,1,"たみ"],[20,1,"のこ"],[23,1,"う"],[25,1,"ころ"],[31,1,"ち"],[33,2,"せんりょう"]],"text":"そこで彼とその子とすべての民とを、ひとり残らず撃ち殺して、その地を占領した。"}]