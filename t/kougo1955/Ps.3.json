[{"ref":"Ps.3.1","start":19003001,"end":19003001,"break":"paragraph","title":"ダビデがその子アブサロムを避けてのがれたときの歌","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"てき"],[10,1,"もの"],[15,1,"おお"],[28,1,"さか"],[32,1,"た"],[34,1,"もの"],[36,1,"おお"]],"titleRuby":[[6,1,"こ"],[13,1,"さ"],[23,1,"うた"]],"text":"主よ、わたしに敵する者のいかに多いことでしょう。わたしに逆らって立つ者が多く、"},{"ref":"Ps.3.2","start":19003002,"end":19003002,"break":"line","breaks":[[14,"line"]],"ruby":[[1,1,"かれ"],[4,1,"かみ"],[6,1,"たす"],[21,1,"い"],[23,1,"もの"],[25,1,"おお"]],"text":"「彼には神の助けがない」と、わたしについて言う者が多いのです。〔セラ"},{"ref":"Ps.3.3","start":19003003,"end":19003003,"break":"line","breaks":[[23,"line"]],"ruby":[[3,1,"しゅ"],[14,1,"かこ"],[16,1,"たて"],[20,1,"さか"],[27,1,"あたま"]],"text":"しかし主よ、あなたはわたしを囲む盾、わが栄え、わたしの頭を、もたげてくださるかたです。"},{"ref":"Ps.3.4","start":19003004,"end":19003004,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"こえ"],[9,1,"しゅ"],[11,1,"よ"],[17,1,"しゅ"],[19,1,"せい"],[22,1,"やま"],[29,1,"こた"]],"text":"わたしが声をあげて主を呼ばわると、主は聖なる山からわたしに答えられる。〔セラ"},{"ref":"Ps.3.5","start":19003005,"end":19003005,"break":"line","breaks":[[18,"line"]],"ruby":[[7,1,"ねむ"],[12,1,"め"],[18,1,"しゅ"]],"text":"わたしはふして眠り、また目をさます。主がわたしをささえられるからだ。"},{"ref":"Ps.3.6","start":19003006,"end":19003006,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"かこ"],[7,1,"た"],[9,1,"かま"],[17,1,"たみ"],[24,1,"おそ"]],"text":"わたしを囲んで立ち構えるちよろずの民をもわたしは恐れない。"},{"ref":"Ps.3.7","start":19003007,"end":19003007,"break":"line","breaks":[[11,"line"],[28,"line"],[48,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"た"],[13,1,"かみ"],[21,1,"すく"],[40,1,"てき"],[45,1,"う"],[48,1,"あ"],[51,1,"もの"],[53,1,"は"],[55,1,"お"]],"text":"主よ、お立ちください。わが神よ、わたしをお救いください。あなたはわたしのすべての敵のほおを打ち、悪しき者の歯を折られるのです。"},{"ref":"Ps.3.8","start":19003008,"end":19003008,"break":"line","breaks":[[9,"line"],[19,"line"]],"ruby":[[0,1,"すくい"],[2,1,"しゅ"],[16,2,"しゅくふく"],[23,1,"たみ"],[25,1,"うえ"]],"text":"救は主のものです。どうかあなたの祝福があなたの民の上にありますように。〔セラ"}]