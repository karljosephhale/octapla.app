[{"ref":"Deut.20.1","start":5020001,"end":5020001,"break":"paragraph","ruby":[[4,1,"てき"],[6,1,"たたか"],[11,1,"で"],[13,1,"とき"],[15,1,"うま"],[17,2,"せんしゃ"],[27,1,"だい"],[31,2,"ぐんたい"],[34,1,"み"],[38,1,"かれ"],[41,1,"おそ"],[59,1,"くに"],[62,1,"みちび"],[73,1,"かみ"],[75,1,"しゅ"],[77,1,"とも"]],"text":"あなたが敵と戦うために出る時、馬と戦車と、あなたよりも大ぜいの軍隊を見ても、彼らを恐れてはならない。あなたをエジプトの国から導きのぼられたあなたの神、主が共におられるからである。"},{"ref":"Deut.20.2","start":5020002,"end":5020002,"break":"none","ruby":[[6,1,"たたか"],[9,1,"のぞ"],[14,2,"さいし"],[17,1,"すす"],[19,1,"で"],[21,1,"たみ"],[23,1,"つ"]],"text":"あなたがたが戦いに臨むとき、祭司は進み出て民に告げて、"},{"ref":"Deut.20.3","start":5020003,"end":5020003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[21,1,"き"],[35,1,"てき"],[37,1,"たたか"],[46,1,"き"],[58,1,"おそ"],[77,1,"かれ"],[80,1,"おどろ"]],"text":"彼らに言わなければならない、『イスラエルよ聞け。あなたがたは、きょう、敵と戦おうとしている。気おくれしてはならない。恐れてはならない。あわててはならない。彼らに驚いてはならない。"},{"ref":"Deut.20.4","start":5020004,"end":5020004,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"とも"],[12,1,"い"],[25,1,"てき"],[27,1,"たたか"],[37,1,"すく"]],"text":"あなたがたの神、主が共に行かれ、あなたがたのために敵と戦って、あなたがたを救われるからである』。"},{"ref":"Deut.20.5","start":5020005,"end":5020005,"break":"none","ruby":[[0,1,"つぎ"],[8,1,"たみ"],[10,1,"つ"],[13,1,"い"],[25,1,"あたら"],[28,1,"いえ"],[30,1,"た"],[46,1,"もの"],[54,1,"ひと"],[56,1,"いえ"],[58,1,"かえ"],[78,1,"かれ"],[80,1,"たたか"],[83,1,"し"],[92,1,"ひと"]],"text":"次につかさたちは民に告げて言わなければならない。『新しい家を建てて、まだそれをささげていない者があれば、その人を家に帰らせなければならない。そうしなければ、彼が戦いに死んだとき、ほかの人がそれをささげるようになるであろう。"},{"ref":"Deut.20.6","start":5020006,"end":5020006,"break":"none","ruby":[[3,1,"はたけ"],[5,1,"つく"],[13,1,"み"],[15,1,"た"],[21,1,"もの"],[29,1,"ひと"],[31,1,"いえ"],[33,1,"かえ"],[52,1,"かれ"],[54,1,"たたか"],[57,1,"し"],[66,1,"ひと"],[71,1,"た"]],"text":"ぶどう畑を作って、まだその実を食べていない者があれば、その人を家に帰らせなければならない。そうしなければ彼が戦いに死んだとき、ほかの人がそれを食べるようになるであろう。"},{"ref":"Deut.20.7","start":5020007,"end":5020007,"break":"none","ruby":[[0,1,"おんな"],[2,2,"こんやく"],[11,1,"おんな"],[20,1,"もの"],[28,1,"ひと"],[30,1,"いえ"],[32,1,"かえ"],[51,1,"かれ"],[53,1,"たたか"],[56,1,"し"],[65,1,"ひと"],[67,2,"かのじょ"]],"text":"女と婚約して、まだその女をめとっていない者があれば、その人を家に帰らせなければならない。そうしなければ彼が戦いに死んだとき、ほかの人が彼女をめとるようになるであろう』。"},{"ref":"Deut.20.8","start":5020008,"end":5020008,"break":"none","ruby":[[9,1,"たみ"],[11,1,"つ"],[14,1,"い"],[26,1,"おそ"],[29,1,"き"],[35,1,"もの"],[45,1,"ひと"],[47,1,"いえ"],[49,1,"かえ"],[69,2,"きょうだい"],[74,1,"こころ"],[76,1,"かれ"],[78,1,"こころ"]],"text":"つかさたちは、また民に告げて言わなければならない。『恐れて気おくれする者があるならば、その人を家に帰らせなければならない。そうしなければ、兄弟たちの心が彼の心のようにくじけるであろう』。"},{"ref":"Deut.20.9","start":5020009,"end":5020009,"break":"none","ruby":[[11,1,"たみ"],[13,1,"つ"],[15,1,"おわ"],[22,2,"ぐんぜい"],[31,1,"た"],[34,1,"たみ"],[36,1,"ひき"]],"text":"つかさたちがこのように民に告げ終ったならば、軍勢のかしらたちを立てて民を率いさせなければならない。"},{"ref":"Deut.20.10","start":5020010,"end":5020010,"break":"paragraph","ruby":[[3,1,"まち"],[5,1,"すす"],[8,1,"い"],[15,1,"せ"],[22,1,"とき"],[27,1,"おだ"],[31,2,"こうふく"],[38,1,"すす"]],"text":"一つの町へ進んで行って、それを攻めようとする時は、まず穏やかに降服することを勧めなければならない。"},{"ref":"Deut.20.11","start":5020011,"end":5020011,"break":"none","ruby":[[4,1,"まち"],[6,1,"おだ"],[10,2,"こうふく"],[16,1,"こた"],[20,1,"もん"],[22,1,"ひら"],[37,1,"たみ"],[44,1,"おさ"],[53,1,"つか"]],"text":"もしその町が穏やかに降服しようと答えて、門を開くならば、そこにいるすべての民に、みつぎを納めさせ、あなたに仕えさせなければならない。"},{"ref":"Deut.20.12","start":5020012,"end":5020012,"break":"none","ruby":[[2,1,"おだ"],[6,2,"こうふく"],[11,1,"たたか"],[28,1,"せ"]],"text":"もし穏やかに降服せず、戦おうとするならば、あなたはそれを攻めなければならない。"},{"ref":"Deut.20.13","start":5020013,"end":5020013,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[18,1,"て"],[25,1,"とき"],[39,1,"おとこ"],[43,1,"う"],[45,1,"ころ"]],"text":"そしてあなたの神、主がそれをあなたの手にわたされる時、つるぎをもってそのうちの男をみな撃ち殺さなければならない。"},{"ref":"Deut.20.14","start":5020014,"end":5020014,"break":"none","ruby":[[3,1,"おんな"],[5,2,"こども"],[8,2,"かちく"],[16,1,"まち"],[34,1,"もの"],[36,1,"みな"],[38,2,"せんり"],[40,1,"ひん"],[44,1,"と"],[55,1,"てき"],[63,1,"もの"],[69,1,"かみ"],[71,1,"しゅ"],[73,1,"たま"],[90,1,"もち"]],"text":"ただし女、子供、家畜およびすべて町のうちにあるもの、すなわちぶんどり物は皆、戦利品として取ることができる。また敵からぶんどった物はあなたの神、主が賜わったものだから、あなたはそれを用いることができる。"},{"ref":"Deut.20.15","start":5020015,"end":5020015,"break":"none","ruby":[[0,1,"とお"],[2,1,"はな"],[7,2,"まちまち"],[18,2,"くにぐに"],[21,1,"ぞく"],[25,2,"まちまち"]],"text":"遠く離れている町々、すなわちこれらの国々に属さない町々には、すべてこのようにしなければならない。"},{"ref":"Deut.20.16","start":5020016,"end":5020016,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"し"],[13,1,"ぎょう"],[17,1,"あた"],[26,1,"たみ"],[28,2,"まちまち"],[33,1,"いき"],[37,1,"もの"],[43,1,"い"]],"text":"ただし、あなたの神、主が嗣業として与えられるこれらの民の町々では、息のある者をひとりも生かしておいてはならない。"},{"ref":"Deut.20.17","start":5020017,"end":5020017,"break":"none","ruby":[[40,1,"ほろ"],[49,1,"かみ"],[51,1,"しゅ"],[53,1,"めい"]],"text":"すなわちヘテびと、アモリびと、カナンびと、ペリジびと、ヒビびと、エブスびとはみな滅ぼして、あなたの神、主が命じられたとおりにしなければならない。"},{"ref":"Deut.20.18","start":5020018,"end":5020018,"break":"none","ruby":[[3,1,"かれ"],[8,2,"かみがみ"],[11,1,"おが"],[23,1,"にく"],[27,1,"こと"],[36,1,"おし"],[43,1,"おこな"],[53,1,"かみ"],[55,1,"しゅ"],[57,1,"つみ"],[59,1,"おか"]],"text":"これは彼らがその神々を拝んでおこなったすべての憎むべき事を、あなたがたに教えて、それを行わせ、あなたがたの神、主に罪を犯させることのないためである。"},{"ref":"Deut.20.19","start":5020019,"end":5020019,"break":"paragraph","ruby":[[0,1,"なが"],[2,1,"まち"],[4,1,"せ"],[6,1,"かこ"],[13,1,"と"],[19,1,"とき"],[34,1,"き"],[36,1,"き"],[38,1,"か"],[55,1,"しょく"],[65,1,"き"],[67,1,"たお"],[80,2,"でんや"],[83,1,"き"],[88,1,"ひと"],[93,1,"せ"]],"text":"長く町を攻め囲んで、それを取ろうとする時でも、おのをふるって、そこの木を切り枯らしてはならない。それはあなたの食となるものだから、切り倒してはならない。あなたは田野の木までも、人のように攻めなければならないであろうか。"},{"ref":"Deut.20.20","start":5020020,"end":5020020,"break":"none","ruby":[[3,1,"み"],[5,1,"むす"],[9,1,"き"],[17,1,"き"],[19,1,"き"],[21,1,"たお"],[29,1,"たたか"],[34,1,"まち"],[50,1,"きず"],[53,2,"かんらく"],[63,1,"せ"]],"text":"ただし実を結ばない木とわかっている木は切り倒して、あなたと戦っている町にむかい、それをもってとりでを築き、陥落するまで、それを攻めることができる。"}]