[{"ref":"Ps.24.1","start":19024001,"end":19024001,"break":"paragraph","title":"ダビデの歌","breaks":[[12,"line"]],"ruby":[[0,1,"ち"],[6,1,"み"],[12,2,"せかい"],[21,1,"す"],[23,1,"もの"],[26,1,"しゅ"]],"titleRuby":[[4,1,"うた"]],"text":"地と、それに満ちるもの、世界と、そのなかに住む者とは主のものである。"},{"ref":"Ps.24.2","start":19024002,"end":19024002,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"もとい"],[6,2,"たいかい"],[15,2,"おおかわ"],[21,1,"さだ"]],"text":"主はその基を大海のうえにすえ、大川のうえに定められた。"},{"ref":"Ps.24.3","start":19024003,"end":19024003,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"やま"],[4,1,"のぼ"],[8,1,"もの"],[16,2,"せいじょ"],[19,1,"た"],[23,1,"もの"]],"text":"主の山に登るべき者はだれか。その聖所に立つべき者はだれか。"},{"ref":"Ps.24.4","start":19024004,"end":19024004,"break":"line","breaks":[[14,"line"],[33,"line"]],"ruby":[[0,1,"て"],[2,1,"きよ"],[5,1,"こころ"],[12,1,"もの"],[16,1,"たましい"],[22,1,"こと"],[24,1,"のぞ"],[31,1,"もの"],[33,1,"いつわ"],[36,1,"ちか"],[40,1,"もの"],[46,1,"ひと"]],"text":"手が清く、心のいさぎよい者、その魂がむなしい事に望みをかけない者、偽って誓わない者こそ、その人である。"},{"ref":"Ps.24.5","start":19024005,"end":19024005,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"ひと"],[7,1,"しゅ"],[10,2,"しゅくふく"],[18,1,"すくい"],[20,1,"かみ"],[23,1,"ぎ"]],"text":"このような人は主から祝福をうけ、その救の神から義をうける。"},{"ref":"Ps.24.6","start":19024006,"end":19024006,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"した"],[8,1,"もの"],[18,1,"かみ"],[22,1,"かお"],[24,1,"もと"],[27,1,"もの"]],"text":"これこそ主を慕う者のやから、ヤコブの神の、み顔を求める者のやからである。〔セラ"},{"ref":"Ps.24.7","start":19024007,"end":19024007,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"もん"],[16,1,"と"],[23,2,"えいこう"],[26,1,"おう"]],"text":"門よ、こうべをあげよ。とこしえの戸よ、あがれ。栄光の王がはいられる。"},{"ref":"Ps.24.8","start":19024008,"end":19024008,"break":"line","breaks":[[10,"line"]],"ruby":[[0,2,"えいこう"],[3,1,"おう"],[10,1,"つよ"],[12,1,"いさ"],[16,1,"しゅ"],[18,1,"たたか"],[21,1,"いさ"],[25,1,"しゅ"]],"text":"栄光の王とはだれか。強く勇ましい主、戦いに勇ましい主である。"},{"ref":"Ps.24.9","start":19024009,"end":19024009,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"もん"],[16,1,"と"],[23,2,"えいこう"],[26,1,"おう"]],"text":"門よ、こうべをあげよ。とこしえの戸よ、あがれ。栄光の王がはいられる。"},{"ref":"Ps.24.10","start":19024010,"end":19024010,"break":"line","ruby":[[2,2,"えいこう"],[5,1,"おう"],[12,2,"ばんぐん"],[15,1,"しゅ"],[21,2,"えいこう"],[24,1,"おう"]],"text":"この栄光の王とはだれか。万軍の主、これこそ栄光の王である。〔セラ"}]