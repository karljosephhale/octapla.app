[{"ref":"Ps.63.1","start":19063001,"end":19063001,"break":"paragraph","title":"ユダの野にあったときによんだダビデの歌","breaks":[[13,"line"],[29,"line"],[43,"line"],[61,"line"]],"ruby":[[0,1,"かみ"],[11,1,"かみ"],[17,1,"せつ"],[26,1,"もと"],[31,1,"たましい"],[40,1,"のぞ"],[43,1,"みず"],[50,1,"おとろ"],[53,1,"ち"],[63,2,"にくたい"],[70,1,"した"]],"titleRuby":[[3,1,"の"],[18,1,"うた"]],"text":"神よ、あなたはわたしの神、わたしは切にあなたをたずね求め、わが魂はあなたをかわき望む。水なき、かわき衰えた地にあるように、わが肉体はあなたを慕いこがれる。"},{"ref":"Ps.63.2","start":19063002,"end":19063002,"break":"line","breaks":[[22,"line"]],"ruby":[[11,1,"ちから"],[13,1,"さか"],[17,1,"み"],[22,2,"せいじょ"],[28,1,"め"],[34,1,"そそ"]],"text":"それでわたしはあなたの力と栄えとを見ようと、聖所にあって目をあなたに注いだ。"},{"ref":"Ps.63.3","start":19063003,"end":19063003,"break":"line","breaks":[[22,"line"]],"text":"あなたのいつくしみは、いのちにもまさるゆえ、わがくちびるはあなたをほめたたえる。"},{"ref":"Ps.63.4","start":19063004,"end":19063004,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"い"],[11,1,"あいだ"],[20,1,"て"],[27,1,"な"],[29,1,"よ"]],"text":"わたしは生きながらえる間、あなたをほめ、手をあげて、み名を呼びまつる。"},{"ref":"Ps.63.5","start":19063005,"end":19063006,"break":"line","breaks":[[17,"line"],[36,"line"],[52,"line"],[66,"line"],[83,"line"]],"ruby":[[4,1,"とこ"],[6,1,"うえ"],[12,1,"おも"],[17,1,"よ"],[29,1,"ふか"],[31,1,"おも"],[40,1,"たましい"],[42,1,"ずい"],[61,1,"あ"],[63,1,"た"],[70,1,"くち"],[72,1,"よろこ"]],"text":"わたしが床の上であなたを思いだし、夜のふけるままにあなたを深く思うとき、わたしの魂は髄とあぶらとをもってもてなされるように飽き足り、わたしの口は喜びのくちびるをもってあなたをほめたたえる。"},{"ref":"Ps.63.7","start":19063007,"end":19063007,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"たす"],[26,1,"つばさ"],[28,1,"かげ"],[30,1,"よろこ"],[32,1,"うた"]],"text":"あなたはわたしの助けとなられたゆえ、わたしはあなたの翼の陰で喜び歌う。"},{"ref":"Ps.63.8","start":19063008,"end":19063008,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"たましい"],[20,1,"みぎ"],[22,1,"て"]],"text":"わたしの魂はあなたにすがりつき、あなたの右の手はわたしをささえられる。"},{"ref":"Ps.63.9","start":19063009,"end":19063009,"break":"line","breaks":[[22,"line"]],"ruby":[[7,1,"たましい"],[9,1,"ほろ"],[17,1,"もと"],[20,1,"もの"],[22,1,"ち"],[24,1,"ふか"],[26,1,"ところ"],[28,1,"い"]],"text":"しかしわたしの魂を滅ぼそうとたずね求める者は地の深き所に行き、"},{"ref":"Ps.63.10","start":19063010,"end":19063010,"break":"line","ruby":[[4,1,"ちから"],[11,2,"やまいぬ"]],"text":"つるぎの力にわたされ、山犬のえじきとなる。"},{"ref":"Ps.63.11","start":19063011,"end":19063011,"break":"line","breaks":[[13,"line"],[33,"line"]],"ruby":[[3,1,"おう"],[5,1,"かみ"],[10,1,"よろこ"],[13,1,"かみ"],[18,1,"ちか"],[20,1,"もの"],[24,1,"ほこ"],[33,1,"いつわ"],[36,1,"い"],[38,1,"もの"],[40,1,"くち"]],"text":"しかし王は神にあって喜び、神によって誓う者はみな誇ることができる。偽りを言う者の口はふさがれるからである。"}]