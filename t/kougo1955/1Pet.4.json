[{"ref":"1Pet.4.1","start":60004001,"end":60004001,"break":"paragraph","ruby":[[11,1,"にく"],[16,1,"くる"],[34,1,"おな"],[36,2,"かくご"],[39,1,"こころ"],[41,2,"ぶそう"],[49,1,"にく"],[54,1,"くる"],[58,1,"ひと"],[67,1,"つみ"]],"text":"このように、キリストは肉において苦しまれたのであるから、あなたがたも同じ覚悟で心の武装をしなさい。肉において苦しんだ人は、それによって罪からのがれたのである。"},{"ref":"1Pet.4.2","start":60004002,"end":60004002,"break":"none","ruby":[[4,1,"にく"],[9,1,"のこ"],[12,2,"しょうがい"],[19,2,"にんげん"],[22,2,"よくじょう"],[29,1,"かみ"],[31,2,"みむね"],[37,1,"す"]],"text":"それは、肉における残りの生涯を、もはや人間の欲情によらず、神の御旨によって過ごすためである。"},{"ref":"1Pet.4.3","start":60004003,"end":60004003,"break":"none","ruby":[[0,1,"す"],[2,1,"さ"],[5,2,"じだい"],[17,3,"いほうじん"],[21,1,"この"],[29,2,"こうしょく"],[32,2,"よくじょう"],[35,2,"すいしゅ"],[38,2,"えんらく"],[41,2,"ぼういん"],[44,1,"き"],[48,2,"ぐうぞう"],[50,2,"れいはい"],[68,2,"じゅうぶん"]],"text":"過ぎ去った時代には、あなたがたは、異邦人の好みにまかせて、好色、欲情、酔酒、宴楽、暴飲、気ままな偶像礼拝などにふけってきたが、もうそれで十分であろう。"},{"ref":"1Pet.4.4","start":60004004,"end":60004004,"break":"none","ruby":[[0,1,"いま"],[13,1,"ど"],[15,1,"す"],[19,2,"らんぎょう"],[22,1,"くわ"],[30,1,"かれ"],[33,1,"おどろ"]],"text":"今はあなたがたが、そうした度を過ごした乱行に加わらないので、彼らは驚きあやしみ、かつ、ののしっている。"},{"ref":"1Pet.4.5","start":60004005,"end":60004005,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[10,1,"もの"],[12,1,"し"],[15,1,"もの"],[25,1,"もう"],[27,1,"ひら"]],"text":"彼らは、やがて生ける者と死ねる者とをさばくかたに、申し開きをしなくてはならない。"},{"ref":"1Pet.4.6","start":60004006,"end":60004006,"break":"none","ruby":[[0,2,"しにん"],[5,2,"ふくいん"],[8,1,"の"],[10,1,"つた"],[18,1,"かれ"],[21,1,"にく"],[27,2,"にんげん"],[36,1,"う"],[41,1,"れい"],[47,1,"かみ"],[49,1,"したが"],[52,1,"い"]],"text":"死人にさえ福音が宣べ伝えられたのは、彼らは肉においては人間としてさばきを受けるが、霊においては神に従って生きるようになるためである。"},{"ref":"1Pet.4.7","start":60004007,"end":60004007,"break":"paragraph","ruby":[[0,2,"ばんぶつ"],[3,1,"おわ"],[6,1,"ちか"],[17,1,"こころ"],[19,1,"たし"],[24,1,"み"],[26,1,"つつし"],[30,1,"つと"],[33,1,"いの"]],"text":"万物の終りが近づいている。だから、心を確かにし、身を慎んで、努めて祈りなさい。"},{"ref":"1Pet.4.8","start":60004008,"end":60004008,"break":"none","ruby":[[0,1,"なに"],[7,1,"たがい"],[9,1,"あい"],[11,1,"あつ"],[13,1,"たも"],[19,1,"あい"],[21,1,"おお"],[24,1,"つみ"]],"text":"何よりもまず、互の愛を熱く保ちなさい。愛は多くの罪をおおうものである。"},{"ref":"1Pet.4.9","start":60004009,"end":60004009,"break":"none","ruby":[[0,2,"ふへい"],[3,1,"い"],[8,1,"たがい"],[14,1,"あ"]],"text":"不平を言わずに、互にもてなし合いなさい。"},{"ref":"1Pet.4.10","start":60004010,"end":60004010,"break":"none","ruby":[[11,2,"たまもの"],[26,1,"かみ"],[33,1,"めぐ"],[36,1,"よ"],[38,3,"かんりにん"],[49,1,"たがい"],[54,1,"やく"],[55,1,"た"]],"text":"あなたがたは、それぞれ賜物をいただいているのだから、神のさまざまな恵みの良き管理人として、それをお互のために役立てるべきである。"},{"ref":"1Pet.4.11","start":60004011,"end":60004011,"break":"none","ruby":[[0,1,"かた"],[2,1,"もの"],[5,1,"かみ"],[7,2,"みことば"],[10,1,"かた"],[12,1,"もの"],[19,1,"かた"],[22,2,"ほうし"],[26,1,"もの"],[29,1,"かみ"],[32,1,"たま"],[35,1,"ちから"],[39,1,"もの"],[46,2,"ほうし"],[82,1,"かみ"],[96,2,"えいこう"],[99,1,"ちから"],[102,2,"よよ"],[104,1,"かぎ"],[109,1,"かれ"]],"text":"語る者は、神の御言を語る者にふさわしく語り、奉仕する者は、神から賜わる力による者にふさわしく奉仕すべきである。それは、すべてのことにおいてイエス・キリストによって、神があがめられるためである。栄光と力とが世々限りなく、彼にあるように、アァメン。"},{"ref":"1Pet.4.12","start":60004012,"end":60004012,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[14,1,"こころ"],[20,1,"ふ"],[26,1,"く"],[28,1,"ひ"],[33,2,"しれん"],[37,1,"なに"],[39,1,"おも"],[48,1,"おこ"],[56,1,"おどろ"]],"text":"愛する者たちよ。あなたがたを試みるために降りかかって来る火のような試錬を、何か思いがけないことが起ったかのように驚きあやしむことなく、"},{"ref":"1Pet.4.13","start":60004013,"end":60004013,"break":"none","ruby":[[9,1,"くる"],[25,1,"よろこ"],[40,2,"えいこう"],[43,1,"あらわ"],[46,1,"さい"]],"text":"むしろ、キリストの苦しみにあずかればあずかるほど、喜ぶがよい。それは、キリストの栄光が現れる際に、よろこびにあふれるためである。"},{"ref":"1Pet.4.14","start":60004014,"end":60004014,"break":"none","ruby":[[5,1,"な"],[34,1,"とき"],[38,2,"えいこう"],[41,1,"れい"],[43,1,"かみ"],[45,1,"れい"],[54,1,"やど"]],"text":"キリストの名のためにそしられるなら、あなたがたはさいわいである。その時には、栄光の霊、神の霊が、あなたがたに宿るからである。"},{"ref":"1Pet.4.15","start":60004015,"end":60004015,"break":"none","ruby":[[13,2,"ひとごろ"],[17,2,"ぬすびと"],[20,1,"あく"],[22,1,"おこな"],[24,1,"もの"],[31,2,"たにん"],[34,2,"かんしょう"],[38,1,"もの"],[42,1,"くる"],[46,1,"あ"]],"text":"あなたがたのうち、だれも、人殺し、盗人、悪を行う者、あるいは、他人に干渉する者として苦しみに会うことのないようにしなさい。"},{"ref":"1Pet.4.16","start":60004016,"end":60004016,"break":"none","ruby":[[13,1,"くる"],[17,1,"う"],[26,1,"は"],[42,1,"な"],[47,1,"かみ"]],"text":"しかし、クリスチャンとして苦しみを受けるのであれば、恥じることはない。かえって、この名によって神をあがめなさい。"},{"ref":"1Pet.4.17","start":60004017,"end":60004017,"break":"none","ruby":[[4,1,"かみ"],[6,1,"いえ"],[9,1,"はじ"],[14,1,"とき"],[32,1,"はじ"],[42,1,"かみ"],[44,2,"ふくいん"],[47,1,"したが"],[51,2,"ひとびと"],[54,1,"ゆ"],[56,1,"すえ"]],"text":"さばきが神の家から始められる時がきた。それが、わたしたちからまず始められるとしたら、神の福音に従わない人々の行く末は、どんなであろうか。"},{"ref":"1Pet.4.18","start":60004018,"end":60004018,"break":"none","ruby":[[2,2,"ぎじん"],[13,1,"すく"],[24,2,"ふしん"],[28,1,"もの"],[30,2,"つみびと"]],"text":"また義人でさえ、かろうじて救われるのだとすれば、不信なる者や罪人は、どうなるであろうか。"},{"ref":"1Pet.4.19","start":60004019,"end":60004019,"break":"none","ruby":[[4,1,"かみ"],[6,2,"みむね"],[9,1,"したが"],[12,1,"くる"],[16,1,"う"],[19,2,"ひとびと"],[23,1,"ぜん"],[34,2,"しんじつ"],[41,3,"そうぞうしゃ"],[46,2,"じぶん"]],"text":"だから、神の御旨に従って苦しみを受ける人々は、善をおこない、そして、真実であられる創造者に、自分のたましいをゆだねるがよい。"}]