[{"ref":"Jer.25.1","start":24025001,"end":24025001,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"こ"],[16,1,"ねん"],[23,1,"おう"],[32,2,"がんねん"],[43,1,"たみ"],[49,2,"ことば"],[57,1,"のぞ"]],"text":"ユダの王ヨシヤの子エホヤキムの四年（バビロンの王ネブカデレザルの元年）にユダのすべての民についての言葉がエレミヤに臨んだ。"},{"ref":"Jer.25.2","start":24025002,"end":24025002,"break":"none","ruby":[[0,3,"よげんしゃ"],[10,2,"ことば"],[20,1,"たみ"],[28,1,"す"],[34,1,"ひと"],[36,1,"つ"],[39,1,"い"]],"text":"預言者エレミヤはこの言葉をユダのすべての民とエルサレムに住むすべての人に告げて言った、"},{"ref":"Jer.25.3","start":24025003,"end":24025003,"break":"none","ruby":[[4,1,"おう"],[9,1,"こ"],[16,1,"ねん"],[19,2,"こんにち"],[30,1,"ねん"],[32,1,"あいだ"],[34,1,"しゅ"],[36,2,"ことば"],[43,1,"のぞ"],[65,1,"かた"],[78,1,"き"]],"text":"「ユダの王アモンの子ヨシヤの十三年から今日にいたるまで二十三年の間、主の言葉がわたしに臨んだ。わたしはたゆまずにそれをあなたがたに語ってきたが、あなたがたは聞かなかった。"},{"ref":"Jer.25.4","start":24025004,"end":24025004,"break":"none","ruby":[[0,1,"しゅ"],[15,3,"よげんしゃ"],[40,1,"き"],[45,1,"みみ"],[47,1,"かたむ"],[50,1,"き"]],"text":"主はたゆまず、そのしもべである預言者を、あなたがたにつかわされたが、あなたがたは聞かずまた耳を傾けて聞こうともしなかった。"},{"ref":"Jer.25.5","start":24025005,"end":24025005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[18,1,"いま"],[21,1,"あく"],[23,1,"みち"],[25,1,"わる"],[27,1,"おこな"],[30,1,"す"],[41,1,"しゅ"],[43,1,"むかし"],[52,2,"せんぞ"],[58,1,"あた"],[63,1,"ち"],[65,2,"えいえん"],[68,1,"す"]],"text":"彼らは言った、『あなたがたはおのおの今その悪の道と悪い行いを捨てなさい。そうすれば主が昔からあなたがたと先祖たちとに与えられた地に永遠に住むことができる。"},{"ref":"Jer.25.6","start":24025006,"end":24025006,"break":"none","ruby":[[10,1,"かみ"],[12,1,"したが"],[19,1,"つか"],[25,1,"おが"],[40,1,"て"],[42,1,"つく"],[56,1,"いか"]],"text":"あなたがたは、ほかの神に従って、それに仕え、それを拝んではならない。あなたがたの手で作ったものをもって、わたしを怒らせてはならない。このようなことをしないなら、わたしはあなたがたをそこなうことはない』と。"},{"ref":"Jer.25.7","start":24025007,"end":24025007,"break":"none","ruby":[[13,1,"き"],[15,1,"したが"],[25,1,"て"],[27,1,"つく"],[30,1,"もの"],[40,1,"いか"],[44,1,"みずか"],[46,1,"がい"],[48,1,"まね"],[53,1,"しゅ"],[55,1,"い"]],"text":"しかしあなたがたはわたしに聞き従わず、あなたがたの手で作った物をもって、わたしを怒らせて自ら害を招いたと、主は言われる。"},{"ref":"Jer.25.8","start":24025008,"end":24025008,"break":"paragraph","ruby":[[4,2,"ばんぐん"],[7,1,"しゅ"],[11,1,"おお"],[27,2,"ことば"],[30,1,"き"],[32,1,"したが"]],"text":"それゆえ万軍の主はこう仰せられる、あなたがたがわたしの言葉に聞き従わないゆえ、"},{"ref":"Jer.25.9","start":24025009,"end":24025009,"break":"none","ruby":[[0,1,"み"],[7,1,"きた"],[9,1,"ほう"],[15,2,"しゅぞく"],[34,1,"おう"],[43,1,"よ"],[45,1,"よ"],[51,1,"ち"],[55,1,"たみ"],[64,2,"くにぐに"],[67,1,"せ"],[69,1,"ほろ"],[77,1,"い"],[89,1,"ひと"],[91,1,"わら"],[98,2,"えいえん"],[111,1,"しゅ"],[113,1,"い"]],"text":"見よ、わたしは北の方のすべての種族と、わたしのしもべであるバビロンの王ネブカデレザルを呼び寄せて、この地とその民と、そのまわりの国々を攻め滅ぼさせ、これを忌みきらわれるものとし、人の笑いものとし、永遠のはずかしめとすると、主は言われる。"},{"ref":"Jer.25.10","start":24025010,"end":24025010,"break":"none","ruby":[[6,1,"よろこ"],[9,1,"こえ"],[11,1,"たの"],[15,1,"こえ"],[17,2,"はなむこ"],[20,1,"こえ"],[22,2,"はなよめ"],[25,1,"こえ"],[32,1,"おと"],[39,1,"ひかり"],[41,1,"かれ"],[44,1,"なか"],[46,1,"た"]],"text":"またわたしは喜びの声、楽しみの声、花婿の声、花嫁の声、ひきうすの音、ともしびの光を彼らの中に絶えさせる。"},{"ref":"Jer.25.11","start":24025011,"end":24025011,"break":"none","ruby":[[2,1,"ち"],[6,1,"ほろ"],[11,1,"あ"],[13,1,"ち"],[23,2,"くにぐに"],[28,1,"ねん"],[30,1,"あいだ"],[36,1,"おう"],[38,1,"つか"]],"text":"この地はみな滅ぼされて荒れ地となる。そしてその国々は七十年の間バビロンの王に仕える。"},{"ref":"Jer.25.12","start":24025012,"end":24025012,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"ねん"],[11,1,"おわ"],[14,1,"のち"],[26,1,"おう"],[31,1,"たみ"],[41,1,"ち"],[46,1,"つみ"],[51,1,"ばっ"],[54,2,"えいえん"],[57,1,"あ"],[59,1,"ち"]],"text":"主は言われる、七十年の終った後に、わたしはバビロンの王と、その民と、カルデヤびとの地を、その罪のために罰し、永遠の荒れ地とする。"},{"ref":"Jer.25.13","start":24025013,"end":24025013,"break":"none","ruby":[[6,1,"ち"],[16,1,"かた"],[23,2,"ことば"],[28,1,"うえ"],[30,1,"のぞ"],[44,2,"ばんこく"],[53,2,"よげん"],[68,1,"しょ"]],"text":"わたしはあの地について、わたしが語ったすべての言葉をその上に臨ませる。これはエレミヤが、万国のことについて預言したものであって、みなこの書にしるされている。"},{"ref":"Jer.25.14","start":24025014,"end":24025014,"break":"none","ruby":[[0,1,"おお"],[3,2,"くにぐに"],[6,2,"いだい"],[9,1,"おう"],[15,1,"かれ"],[20,2,"どれい"],[25,1,"つか"],[35,1,"かれ"],[38,1,"おこな"],[44,1,"て"],[49,1,"したが"],[52,1,"むく"]],"text":"多くの国々と偉大な王たちとは、彼らをさえ奴隷として仕えさせる。わたしは彼らの行いと、その手のわざに従って報いる」。"},{"ref":"Jer.25.15","start":24025015,"end":24025015,"break":"paragraph","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[16,1,"おお"],[27,1,"て"],[33,1,"いか"],[36,1,"さかずき"],[38,1,"う"],[54,2,"くにぐに"],[57,1,"たみ"],[59,1,"の"]],"text":"イスラエルの神、主はわたしにこう仰せられた、「わたしの手から、この怒りの杯を受けて、わたしがあなたをつかわす国々の民に飲ませなさい。"},{"ref":"Jer.25.16","start":24025016,"end":24025016,"break":"none","ruby":[[0,1,"かれ"],[3,1,"の"],[11,1,"くる"],[21,1,"かれ"]],"text":"彼らは飲んで、よろめき狂う。これはわたしが彼らのうちに、つるぎをつかわそうとしているからである」。"},{"ref":"Jer.25.17","start":24025017,"end":24025017,"break":"paragraph","ruby":[[8,1,"しゅ"],[10,1,"て"],[13,1,"さかずき"],[15,1,"う"],[18,1,"しゅ"],[30,2,"くにぐに"],[33,1,"たみ"],[35,1,"の"]],"text":"こうしてわたしは主の手から杯を受け、主がわたしをつかわされた国々の民に飲ませた。"},{"ref":"Jer.25.18","start":24025018,"end":24025018,"break":"none","ruby":[[17,1,"まち"],[22,1,"おう"],[36,1,"の"],[45,1,"ほろ"],[49,1,"あ"],[51,1,"ち"],[55,1,"ひと"],[57,1,"わら"],[75,2,"こんにち"]],"text":"すなわちエルサレムとユダのすべての町と、その王たちおよびそのつかさたちに飲ませて、それらを滅ぼし、荒れ地とし、人の笑いものとし、のろわれるものとした。今日のとおりである。"},{"ref":"Jer.25.19","start":24025019,"end":24025019,"break":"none","ruby":[[7,1,"おう"],[13,2,"けらい"],[20,1,"きみ"],[30,1,"たみ"]],"text":"またエジプトの王パロとその家来たち、その君たち、そのすべての民と、"},{"ref":"Jer.25.20","start":24025020,"end":24025020,"break":"none","ruby":[[5,2,"きりゅう"],[8,3,"いほうじん"],[18,1,"ち"],[24,1,"おう"],[38,1,"ち"],[44,1,"おう"],[68,1,"のこ"],[71,1,"もの"]],"text":"もろもろの寄留の異邦人、およびウズの地のすべての王たち、およびペリシテびとの地のすべての王たち、（アシケロン、ガザ、エクロン、アシドドの残りの者）、"},{"ref":"Jer.25.21","start":24025021,"end":24025021,"break":"none","ruby":[[13,2,"しそん"]],"text":"エドム、モアブ、アンモンの子孫、"},{"ref":"Jer.25.22","start":24025022,"end":24025022,"break":"none","ruby":[[7,1,"おう"],[19,1,"おう"],[23,1,"うみ"],[29,2,"うみぞ"],[33,1,"ち"],[35,1,"おう"]],"text":"ツロのすべての王たち、シドンのすべての王たち、海のかなたの海沿いの地の王たち、"},{"ref":"Jer.25.23","start":24025023,"end":24025023,"break":"none","ruby":[[15,1,"かみ"],[17,1,"け"],[26,1,"もの"]],"text":"デダン、テマ、ブズおよびすべて髪の毛のすみずみをそる者、"},{"ref":"Jer.25.24","start":24025024,"end":24025024,"break":"none","ruby":[[9,1,"おう"],[13,2,"あらの"],[16,2,"ざっしゅ"],[19,1,"たみ"],[25,1,"おう"]],"text":"アラビヤのすべての王たち、荒野の雑種の民のすべての王たち、"},{"ref":"Jer.25.25","start":24025025,"end":24025025,"break":"none","ruby":[[8,1,"おう"],[20,1,"おう"],[32,1,"おう"]],"text":"ジムリのすべての王たち、エラムのすべての王たち、メデアのすべての王たち、"},{"ref":"Jer.25.26","start":24025026,"end":24025026,"break":"none","ruby":[[0,1,"きた"],[6,1,"おう"],[10,1,"とお"],[12,1,"もの"],[14,1,"ちか"],[16,1,"もの"],[29,1,"ち"],[37,1,"よ"],[39,2,"くにぐに"],[42,1,"おう"],[48,1,"さかずき"],[50,1,"の"],[56,1,"かれ"],[59,1,"つぎ"],[66,1,"おう"],[71,1,"の"]],"text":"北のすべての王たちの遠き者、近き者もつぎつぎに、またすべて地のおもてにある世の国々の王たちもこの杯を飲む。そして彼らの次にバビロンの王もこれを飲む。"},{"ref":"Jer.25.27","start":24025027,"end":24025027,"break":"paragraph","ruby":[[8,1,"かれ"],[11,1,"い"],[18,2,"ばんぐん"],[21,1,"しゅ"],[29,1,"かみ"],[33,1,"おお"],[39,1,"の"],[42,1,"よ"],[45,1,"は"],[48,1,"たお"],[51,1,"ふたた"],[53,1,"た"]],"text":"「それであなたは彼らに言いなさい、『万軍の主、イスラエルの神はこう仰せられる、飲め、酔って吐け、倒れて再び立つな、わたしがあなたがたのうちに、つるぎをつかわすからである』」。"},{"ref":"Jer.25.28","start":24025028,"end":24025028,"break":"paragraph","ruby":[[3,1,"かれ"],[10,1,"て"],[13,1,"さかずき"],[15,1,"う"],[18,1,"の"],[34,1,"かれ"],[37,1,"い"],[44,2,"ばんぐん"],[47,1,"しゅ"],[51,1,"おお"],[63,1,"かなら"],[65,1,"の"]],"text":"「もし彼らがあなたの手から杯を受けて飲むことをしないならば、あなたは彼らに言いなさい、『万軍の主はこう仰せられる、あなたがたは必ず飲まなければならない。"},{"ref":"Jer.25.29","start":24025029,"end":24025029,"break":"none","ruby":[[0,1,"み"],[7,1,"な"],[12,1,"よ"],[18,1,"まち"],[22,1,"わざわい"],[24,1,"くだ"],[39,1,"ばつ"],[41,1,"まぬか"],[59,1,"ばつ"],[61,1,"まぬか"],[80,1,"よ"],[82,1,"よ"],[86,1,"ち"],[88,1,"す"],[94,1,"もの"],[96,1,"せ"],[106,2,"ばんぐん"],[109,1,"しゅ"],[111,1,"おお"]],"text":"見よ、わたしの名をもって呼ばれるこの町にさえ災を下すのだ。どうしてあなたがたが罰を免れることができようか。あなたがたは罰を免れることはできない。わたしがつるぎを呼び寄せて、地に住むすべての者を攻めるからであると、万軍の主は仰せられる』。"},{"ref":"Jer.25.30","start":24025030,"end":24025030,"break":"paragraph","breaks":[[31,"stanza"],[44,"line"],[59,"line"],[78,"line"],[92,"line"]],"ruby":[[9,1,"かれ"],[18,2,"ことば"],[21,2,"よげん"],[25,1,"い"],[32,1,"しゅ"],[34,1,"たか"],[36,1,"ところ"],[39,1,"よ"],[46,1,"せい"],[54,1,"こえ"],[56,1,"だ"],[59,2,"じぶん"],[66,1,"む"],[70,1,"おお"],[73,1,"よ"],[78,1,"ち"],[80,1,"す"],[86,1,"もの"],[88,1,"む"],[96,1,"ふ"],[98,1,"もの"],[103,1,"さけ"]],"text":"それゆえ、あなたは彼らにこのすべての言葉を預言して言いなさい、『主は高い所から呼ばわり、その聖なるすまいから声を出し、自分のすみかに向かって大いに呼ばわり、地に住むすべての者に向かってぶどうを踏む者のように叫ばれる。"},{"ref":"Jer.25.31","start":24025031,"end":24025031,"break":"line","breaks":[[15,"line"],[23,"line"],[36,"line"]],"ruby":[[0,1,"さけ"],[3,1,"ち"],[5,1,"はて"],[9,1,"ひび"],[15,1,"しゅ"],[17,2,"くにぐに"],[20,1,"あらそ"],[27,1,"にく"],[30,1,"もの"],[36,2,"あくにん"],[43,1,"わた"],[52,1,"しゅ"],[54,1,"い"]],"text":"叫びは地の果にまで響きわたる。主が国々と争い、すべての肉なる者をさばき、悪人をつるぎに渡すからであると、主は言われる』。"},{"ref":"Jer.25.32","start":24025032,"end":24025032,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"おお"],[13,1,"み"],[16,1,"くに"],[19,1,"くに"],[21,1,"わざわい"],[23,1,"で"],[25,1,"い"],[28,1,"おお"],[35,1,"ち"],[37,1,"はて"]],"text":"万軍の主はこう仰せられる、見よ、国から国へ災が出て行く。大きなあらしが地の果からおこる。"},{"ref":"Jer.25.33","start":24025033,"end":24025033,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"しゅ"],[6,1,"ころ"],[10,2,"ひとびと"],[14,1,"ち"],[18,1,"はて"],[24,1,"はて"],[26,1,"およ"],[29,1,"かれ"],[32,1,"かな"],[38,1,"あつ"],[46,1,"ほうむ"],[52,1,"ち"],[58,2,"ふんど"]],"text":"その日、主に殺される人々は、地のこの果から、かの果に及ぶ。彼らは悲しまれず、集められず、また葬られずに、地のおもてに糞土となる。"},{"ref":"Jer.25.34","start":24025034,"end":24025034,"break":"stanza","breaks":[[9,"line"],[27,"line"],[40,"line"],[53,"line"]],"ruby":[[0,2,"ぼくしゃ"],[4,1,"なげ"],[6,1,"さけ"],[9,1,"む"],[19,1,"はい"],[21,1,"なか"],[38,1,"ひ"],[40,1,"ち"],[45,1,"ひ"],[47,1,"き"],[59,1,"えら"],[61,1,"わ"],[66,2,"おひつじ"],[72,1,"たお"]],"text":"牧者よ、嘆き叫べ、群れのかしらたちよ、灰の中にまろべ。あなたがたのほふられる日、散らされる日が来たからだ。あなたがたは選び分けられた雄羊のように倒れる。"},{"ref":"Jer.25.35","start":24025035,"end":24025035,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"ぼくしゃ"],[8,1,"ば"],[12,1,"む"],[21,1,"に"],[24,1,"ところ"]],"text":"牧者には、のがれ場なく、群れのかしらたちは逃げる所がない。"},{"ref":"Jer.25.36","start":24025036,"end":24025036,"break":"line","breaks":[[8,"line"],[26,"line"]],"ruby":[[0,2,"ぼくしゃ"],[3,1,"さけ"],[5,1,"ごえ"],[8,1,"む"],[17,1,"なげ"],[20,1,"こえ"],[22,1,"きこ"],[26,1,"しゅ"],[28,1,"かれ"],[31,2,"まきば"],[34,1,"ほろ"]],"text":"牧者の叫び声と、群れのかしらたちの嘆きの声が聞える。主が彼らの牧場を滅ぼしておられるからだ。"},{"ref":"Jer.25.37","start":24025037,"end":24025037,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"はげ"],[5,1,"いか"],[12,2,"へいわ"],[15,2,"まきば"],[18,1,"あ"]],"text":"主の激しい怒りによって、平和な牧場は荒れていく。"},{"ref":"Jer.25.38","start":24025038,"end":24025038,"break":"line","breaks":[[15,"line"],[34,"line"]],"ruby":[[6,1,"かれ"],[10,1,"す"],[12,1,"で"],[15,1,"しゅ"],[24,1,"はげ"],[27,1,"いか"],[34,1,"かれ"],[37,1,"ち"],[39,1,"あ"],[41,1,"ち"]],"text":"ししのように彼はその巣を出た。主のつるぎと、その激しい怒りによって、彼らの地は荒れ地となった」。"}]