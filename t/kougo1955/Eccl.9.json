[{"ref":"Eccl.9.1","start":21009001,"end":21009001,"break":"paragraph","ruby":[[10,1,"こと"],[12,1,"こころ"],[14,1,"もち"],[24,1,"こと"],[26,1,"あき"],[41,1,"ただ"],[44,1,"もの"],[46,1,"かしこ"],[48,1,"もの"],[53,1,"かれ"],[60,1,"かみ"],[62,1,"て"],[69,1,"あき"],[80,1,"あい"],[84,1,"にく"],[88,1,"ひと"],[97,1,"かれ"],[100,1,"まえ"],[111,1,"くう"]],"text":"わたしはこのすべての事に心を用いて、このすべての事を明らかにしようとした。すなわち正しい者と賢い者、および彼らのわざが、神の手にあることを明らかにしようとした。愛するか憎むかは人にはわからない。彼らの前にあるすべてのことは空である。"},{"ref":"Eccl.9.2","start":21009002,"end":21009002,"break":"none","ruby":[[4,1,"ひと"],[6,1,"のぞ"],[15,2,"どうよう"],[21,1,"ただ"],[24,1,"もの"],[27,1,"ただ"],[32,1,"もの"],[36,2,"ぜんりょう"],[39,1,"もの"],[42,1,"わる"],[44,1,"もの"],[48,1,"きよ"],[50,1,"もの"],[53,1,"けが"],[56,1,"もの"],[60,2,"ぎせい"],[67,1,"もの"],[71,2,"ぎせい"],[79,1,"もの"],[85,1,"のぞ"],[91,2,"どうよう"],[97,2,"ぜんりょう"],[100,1,"ひと"],[102,1,"つみ"],[106,1,"こと"],[115,1,"ちか"],[120,1,"もの"],[123,1,"ちか"],[131,1,"おそ"],[134,1,"もの"],[136,1,"こと"]],"text":"すべての人に臨むところは、みな同様である。正しい者にも正しくない者にも、善良な者にも悪い者にも、清い者にも汚れた者にも、犠牲をささげる者にも、犠牲をささげない者にも、その臨むところは同様である。善良な人も罪びとも異なることはない。誓いをなす者も、誓いをなすことを恐れる者も異なることはない。"},{"ref":"Eccl.9.3","start":21009003,"end":21009003,"break":"none","ruby":[[4,1,"ひと"],[6,2,"どういつ"],[9,1,"のぞ"],[14,1,"ひ"],[16,1,"した"],[18,1,"おこな"],[26,1,"こと"],[31,2,"あくじ"],[39,1,"ひと"],[41,1,"こころ"],[43,1,"あく"],[45,1,"み"],[50,1,"い"],[55,1,"あいだ"],[58,2,"きょうき"],[63,1,"こころ"],[73,1,"のち"],[75,2,"ししゃ"],[81,1,"い"]],"text":"すべての人に同一に臨むのは、日の下に行われるすべての事のうちの悪事である。また人の心は悪に満ち、その生きている間は、狂気がその心のうちにあり、その後は死者のもとに行くのである。"},{"ref":"Eccl.9.4","start":21009004,"end":21009004,"break":"none","ruby":[[3,1,"い"],[6,1,"もの"],[8,1,"つら"],[11,1,"もの"],[14,1,"のぞ"],[20,1,"い"],[23,1,"いぬ"],[26,1,"し"]],"text":"すべて生ける者に連なる者には望みがある。生ける犬は、死せるししにまさるからである。"},{"ref":"Eccl.9.5","start":21009005,"end":21009005,"break":"none","ruby":[[0,1,"い"],[5,1,"もの"],[7,1,"し"],[11,1,"こと"],[13,1,"し"],[22,2,"ししゃ"],[25,2,"なにごと"],[29,1,"し"],[40,1,"むく"],[43,1,"う"],[54,2,"きおく"],[57,1,"のこ"],[59,1,"こと"],[69,1,"わす"]],"text":"生きている者は死ぬべき事を知っている。しかし死者は何事をも知らない、また、もはや報いを受けることもない。その記憶に残る事がらさえも、ついに忘れられる。"},{"ref":"Eccl.9.6","start":21009006,"end":21009006,"break":"none","ruby":[[2,1,"あい"],[5,1,"にく"],[18,1,"き"],[24,1,"かれ"],[30,1,"ひ"],[32,1,"した"],[34,1,"おこな"],[42,1,"こと"],[45,2,"えいきゅう"]],"text":"その愛も、憎しみも、ねたみも、すでに消えうせて、彼らはもはや日の下に行われるすべての事に、永久にかかわることがない。"},{"ref":"Eccl.9.7","start":21009007,"end":21009007,"break":"paragraph","ruby":[[4,1,"い"],[8,1,"よろこ"],[21,1,"た"],[24,1,"たの"],[27,1,"こころ"],[36,1,"さけ"],[38,1,"の"],[44,1,"かみ"]],"text":"あなたは行って、喜びをもってあなたのパンを食べ、楽しい心をもってあなたの酒を飲むがよい。神はすでに、あなたのわざをよみせられたからである。"},{"ref":"Eccl.9.8","start":21009008,"end":21009008,"break":"paragraph","ruby":[[4,1,"ころも"],[6,1,"つね"],[8,1,"しろ"],[17,1,"あたま"],[19,1,"あぶら"],[21,1,"た"]],"text":"あなたの衣を常に白くせよ。あなたの頭に油を絶やすな。"},{"ref":"Eccl.9.9","start":21009009,"end":21009009,"break":"paragraph","ruby":[[0,1,"ひ"],[2,1,"した"],[4,1,"かみ"],[7,1,"たま"],[15,1,"くう"],[18,1,"いのち"],[20,1,"ひ"],[22,1,"あいだ"],[30,1,"あい"],[33,1,"つま"],[35,1,"とも"],[37,1,"たの"],[40,1,"くら"],[53,1,"よ"],[61,1,"ぶん"],[67,1,"ひ"],[69,1,"した"],[71,1,"ろう"],[74,2,"ろうく"],[80,1,"え"]],"text":"日の下で神から賜わったあなたの空なる命の日の間、あなたはその愛する妻と共に楽しく暮すがよい。これはあなたが世にあってうける分、あなたが日の下で労する労苦によって得るものだからである。"},{"ref":"Eccl.9.10","start":21009010,"end":21009010,"break":"none","ruby":[[7,1,"て"],[13,1,"こと"],[16,1,"ちから"],[29,1,"い"],[31,2,"よみ"],[40,2,"けいりゃく"],[44,2,"ちしき"],[48,2,"ちえ"]],"text":"すべてあなたの手のなしうる事は、力をつくしてなせ。あなたの行く陰府には、わざも、計略も、知識も、知恵もないからである。"},{"ref":"Eccl.9.11","start":21009011,"end":21009011,"break":"paragraph","ruby":[[6,1,"ひ"],[8,1,"した"],[10,1,"み"],[14,1,"かなら"],[18,1,"はや"],[20,1,"もの"],[22,2,"きょうそう"],[25,1,"か"],[33,1,"つよ"],[35,1,"もの"],[37,1,"たたか"],[40,1,"か"],[50,1,"かしこ"],[52,1,"もの"],[57,1,"え"],[68,1,"もの"],[70,1,"とみ"],[72,1,"え"],[82,2,"ちしき"],[86,1,"もの"],[88,1,"めぐ"],[91,1,"え"],[102,1,"とき"],[104,2,"さいなん"],[111,1,"ひと"],[113,1,"のぞ"]],"text":"わたしはまた日の下を見たが、必ずしも速い者が競走に勝つのではなく、強い者が戦いに勝つのでもない。また賢い者がパンを得るのでもなく、さとき者が富を得るのでもない。また知識ある者が恵みを得るのでもない。しかし時と災難はすべての人に臨む。"},{"ref":"Eccl.9.12","start":21009012,"end":21009012,"break":"none","ruby":[[0,1,"ひと"],[4,1,"とき"],[6,1,"し"],[11,1,"うお"],[18,1,"あみ"],[24,1,"とり"],[36,1,"ひと"],[38,1,"こ"],[46,1,"とき"],[48,2,"とつぜん"],[50,1,"かれ"],[53,1,"のぞ"],[55,1,"とき"]],"text":"人はその時を知らない。魚がわざわいの網にかかり、鳥がわなにかかるように、人の子らもわざわいの時が突然彼らに臨む時、それにかかるのである。"},{"ref":"Eccl.9.13","start":21009013,"end":21009013,"break":"paragraph","ruby":[[6,1,"ひ"],[8,1,"した"],[15,2,"ちえ"],[18,1,"れい"],[20,1,"み"],[33,1,"おお"],[36,1,"こと"]],"text":"またわたしは日の下にこのような知恵の例を見た。これはわたしにとって大きな事である。"},{"ref":"Eccl.9.14","start":21009014,"end":21009014,"break":"none","ruby":[[6,1,"ちい"],[9,1,"まち"],[18,1,"す"],[20,1,"ひと"],[22,1,"すく"],[29,1,"おお"],[33,1,"おう"],[35,1,"せ"],[38,1,"き"],[44,1,"かこ"],[50,1,"む"],[54,1,"おお"],[57,2,"うんてい"],[60,1,"た"]],"text":"ここに一つの小さい町があって、そこに住む人は少なかったが、大いなる王が攻めて来て、これを囲み、これに向かって大きな雲梯を建てた。"},{"ref":"Eccl.9.15","start":21009015,"end":21009015,"break":"none","ruby":[[4,1,"まち"],[13,1,"まず"],[16,2,"ちえ"],[21,1,"ひと"],[28,2,"ちえ"],[34,1,"まち"],[36,1,"すく"],[52,1,"まず"],[55,1,"ひと"],[57,2,"きおく"],[61,1,"もの"]],"text":"しかし、町のうちにひとりの貧しい知恵のある人がいて、その知恵をもって町を救った。ところがだれひとり、その貧しい人を記憶する者がなかった。"},{"ref":"Eccl.9.16","start":21009016,"end":21009016,"break":"none","ruby":[[7,1,"い"],[11,2,"ちえ"],[14,1,"ちから"],[25,1,"まず"],[28,1,"ひと"],[30,2,"ちえ"],[33,1,"かろ"],[41,2,"ことば"],[44,1,"き"]],"text":"そこでわたしは言う、「知恵は力にまさる。しかしかの貧しい人の知恵は軽んぜられ、その言葉は聞かれなかった」。"},{"ref":"Eccl.9.17","start":21009017,"end":21009017,"break":"paragraph","ruby":[[0,1,"しず"],[3,1,"き"],[7,2,"ちしゃ"],[10,2,"ことば"],[14,1,"おろ"],[17,1,"もの"],[19,1,"なか"],[26,1,"もの"],[28,1,"さけ"]],"text":"静かに聞かれる知者の言葉は、愚かな者の中のつかさたる者の叫びにまさる。"},{"ref":"Eccl.9.18","start":21009018,"end":21009018,"break":"none","ruby":[[0,2,"ちえ"],[3,1,"たたか"],[6,2,"ぶき"],[21,1,"つみ"],[25,1,"おお"],[28,1,"よ"],[33,1,"ほろ"]],"text":"知恵は戦いの武器にまさる。しかし、ひとりの罪びとは多くの良きわざを滅ぼす。"}]