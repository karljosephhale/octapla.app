[{"ref":"1Cor.5.1","start":46005001,"end":46005001,"break":"paragraph","ruby":[[0,1,"げん"],[2,1,"き"],[18,1,"あいだ"],[20,3,"ふひんこう"],[24,1,"もの"],[34,3,"ふひんこう"],[39,3,"いほうじん"],[43,1,"あいだ"],[57,1,"ひと"],[61,1,"ちち"],[63,1,"つま"],[65,2,"いっしょ"],[68,1,"す"]],"text":"現に聞くところによると、あなたがたの間に不品行な者があり、しかもその不品行は、異邦人の間にもないほどのもので、ある人がその父の妻と一緒に住んでいるということである。"},{"ref":"1Cor.5.2","start":46005002,"end":46005002,"break":"none","ruby":[[15,1,"たか"],[29,1,"おこな"],[36,1,"もの"],[45,1,"なか"],[48,1,"のぞ"],[60,1,"おも"],[64,1,"かな"]],"text":"それだのに、なお、あなたがたは高ぶっている。むしろ、そんな行いをしている者が、あなたがたの中から除かれねばならないことを思って、悲しむべきではないか。"},{"ref":"1Cor.5.3","start":46005003,"end":46005003,"break":"none","ruby":[[7,2,"じしん"],[18,1,"はな"],[25,1,"れい"],[28,2,"いっしょ"],[36,1,"ば"],[40,1,"もの"],[49,1,"おこな"],[54,1,"もの"]],"text":"しかし、わたし自身としては、からだは離れていても、霊では一緒にいて、その場にいる者のように、そんな行いをした者を、すでにさばいてしまっている。"},{"ref":"1Cor.5.4","start":46005004,"end":46005004,"break":"none","ruby":[[5,1,"しゅ"],[10,1,"な"],[26,1,"れい"],[28,1,"とも"],[37,1,"しゅ"],[42,2,"けんい"],[48,1,"あつ"]],"text":"すなわち、主イエスの名によって、あなたがたもわたしの霊も共に、わたしたちの主イエスの権威のもとに集まって、"},{"ref":"1Cor.5.5","start":46005005,"end":46005005,"break":"none","ruby":[[0,1,"かれ"],[2,1,"にく"],[4,1,"ほろ"],[13,1,"れい"],[15,1,"しゅ"],[21,1,"ひ"],[23,1,"すく"],[31,1,"かれ"],[37,1,"ひ"],[39,1,"わた"]],"text":"彼の肉が滅ぼされても、その霊が主のさばきの日に救われるように、彼をサタンに引き渡してしまったのである。"},{"ref":"1Cor.5.6","start":46005006,"end":46005006,"break":"none","ruby":[[6,1,"ほこ"],[28,1,"すこ"],[33,1,"だね"],[35,1,"こな"],[41,2,"ぜんたい"],[54,1,"し"]],"text":"あなたがたが誇っているのは、よろしくない。あなたがたは、少しのパン種が粉のかたまり全体をふくらませることを、知らないのか。"},{"ref":"1Cor.5.7","start":46005007,"end":46005007,"break":"none","ruby":[[0,1,"あたら"],[3,1,"こな"],[16,1,"ふる"],[20,1,"だね"],[22,1,"と"],[24,1,"のぞ"],[37,2,"じじつ"],[41,1,"だね"],[45,1,"もの"],[58,2,"すぎこし"],[61,2,"こひつじ"]],"text":"新しい粉のかたまりになるために、古いパン種を取り除きなさい。あなたがたは、事実パン種のない者なのだから。わたしたちの過越の小羊であるキリストは、すでにほふられたのだ。"},{"ref":"1Cor.5.8","start":46005008,"end":46005008,"break":"none","ruby":[[11,1,"ふる"],[15,1,"だね"],[20,2,"あくい"],[23,2,"じゃあく"],[29,1,"だね"],[31,1,"もち"],[38,1,"だね"],[47,2,"じゅんすい"],[50,2,"しんじつ"],[60,1,"まつり"]],"text":"ゆえに、わたしたちは、古いパン種や、また悪意と邪悪とのパン種を用いずに、パン種のはいっていない純粋で真実なパンをもって、祭をしようではないか。"},{"ref":"1Cor.5.9","start":46005009,"end":46005009,"break":"paragraph","ruby":[[4,1,"まえ"],[6,2,"てがみ"],[10,3,"ふひんこう"],[14,1,"もの"],[18,2,"こうさい"],[28,1,"か"]],"text":"わたしは前の手紙で、不品行な者たちと交際してはいけないと書いたが、"},{"ref":"1Cor.5.10","start":46005010,"end":46005010,"break":"none","ruby":[[6,1,"よ"],[8,3,"ふひんこう"],[12,1,"もの"],[14,2,"どんよく"],[17,1,"もの"],[19,2,"りゃくだつ"],[24,1,"もの"],[26,2,"ぐうぞう"],[28,2,"れいはい"],[33,1,"もの"],[37,2,"ぜんぜん"],[39,2,"こうさい"],[50,1,"い"],[77,1,"よ"],[80,1,"で"],[82,1,"い"]],"text":"それは、この世の不品行な者、貪欲な者、略奪をする者、偶像礼拝をする者などと全然交際してはいけないと、言ったのではない。もしそうだとしたら、あなたがたはこの世から出て行かねばならないことになる。"},{"ref":"1Cor.5.11","start":46005011,"end":46005011,"break":"none","ruby":[[8,2,"じっさい"],[11,1,"か"],[17,2,"きょうだい"],[20,1,"よ"],[24,1,"ひと"],[27,3,"ふひんこう"],[31,1,"もの"],[33,2,"どんよく"],[36,1,"もの"],[38,2,"ぐうぞう"],[40,2,"れいはい"],[45,1,"もの"],[47,1,"ひと"],[52,1,"もの"],[54,1,"さけ"],[56,1,"よ"],[58,1,"もの"],[60,2,"りゃくだつ"],[65,1,"もの"],[74,1,"ひと"],[76,2,"こうさい"],[87,2,"しょくじ"],[90,1,"とも"]],"text":"しかし、わたしが実際に書いたのは、兄弟と呼ばれる人で、不品行な者、貪欲な者、偶像礼拝をする者、人をそしる者、酒に酔う者、略奪をする者があれば、そんな人と交際をしてはいけない、食事を共にしてもいけない、ということであった。"},{"ref":"1Cor.5.12","start":46005012,"end":46005012,"break":"none","ruby":[[0,1,"そと"],[2,1,"ひと"],[37,1,"もの"],[40,1,"うち"],[42,1,"ひと"],[51,1,"そと"],[53,1,"ひと"],[58,1,"かみ"]],"text":"外の人たちをさばくのは、わたしのすることであろうか。あなたがたのさばくべき者は、内の人たちではないか。外の人たちは、神がさばくのである。"},{"ref":"1Cor.5.13","start":46005013,"end":46005013,"break":"none","ruby":[[2,2,"あくにん"],[12,1,"なか"],[15,1,"のぞ"]],"text":"その悪人を、あなたがたの中から除いてしまいなさい。"}]