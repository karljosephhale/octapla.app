[{"ref":"1Sam.23.1","start":9023001,"end":9023001,"break":"paragraph","ruby":[[2,2,"ひとびと"],[9,1,"つ"],[12,1,"い"],[28,1,"せ"],[32,1,"う"],[34,1,"ば"],[36,2,"こくもつ"]],"text":"さて人々はダビデに告げて言った、「ペリシテびとがケイラを攻めて、打ち場の穀物をかすめています」。"},{"ref":"1Sam.23.2","start":9023002,"end":9023002,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"と"],[12,1,"い"],[21,1,"い"],[34,1,"う"],[43,1,"しゅ"],[49,1,"い"],[55,1,"い"],[65,1,"う"],[72,1,"すく"]],"text":"そこでダビデは主に問うて言った、「わたしが行って、このペリシテびとを撃ちましょうか」。主はダビデに言われた、「行ってペリシテびとを撃ち、ケイラを救いなさい」。"},{"ref":"1Sam.23.3","start":9023003,"end":9023003,"break":"none","ruby":[[7,2,"じゅうしゃ"],[12,1,"かれ"],[14,1,"い"],[37,1,"おそ"],[52,1,"い"],[63,1,"ぐん"],[65,1,"あた"]],"text":"しかしダビデの従者たちは彼に言った、「われわれは、ユダのここにおってさえ、恐れているのに、ましてケイラへ行って、ペリシテびとの軍に当ることができましょうか」。"},{"ref":"1Sam.23.4","start":9023004,"end":9023004,"break":"none","ruby":[[4,1,"かさ"],[7,1,"しゅ"],[9,1,"と"],[16,1,"しゅ"],[18,1,"かれ"],[20,1,"こた"],[23,1,"い"],[29,1,"た"],[37,1,"くだ"],[58,1,"て"],[60,1,"わた"]],"text":"ダビデが重ねて主に問うたところ、主は彼に答えて言われた、「立って、ケイラへ下りなさい。わたしはペリシテびとをあなたの手に渡します」。"},{"ref":"1Sam.23.5","start":9023005,"end":9023005,"break":"none","ruby":[[6,2,"じゅうしゃ"],[15,1,"い"],[26,1,"たたか"],[29,1,"かれ"],[32,2,"かちく"],[35,1,"うば"],[40,1,"かれ"],[43,1,"おお"],[45,1,"う"],[47,1,"ころ"],[63,2,"じゅうみん"],[66,1,"すく"]],"text":"ダビデとその従者たちはケイラへ行って、ペリシテびとと戦い、彼らの家畜を奪いとり、彼らを多く撃ち殺した。こうしてダビデはケイラの住民を救った。"},{"ref":"1Sam.23.6","start":9023006,"end":9023006,"break":"paragraph","ruby":[[6,1,"こ"],[33,1,"とき"],[35,1,"て"],[44,1,"くだ"]],"text":"アヒメレクの子アビヤタルは、ケイラにいるダビデのもとにのがれてきた時、手にエポデをもって下ってきた。"},{"ref":"1Sam.23.7","start":9023007,"end":9023007,"break":"none","ruby":[[19,1,"きこ"],[29,1,"い"],[34,1,"かみ"],[40,1,"て"],[42,1,"かれ"],[50,1,"かれ"],[52,1,"もん"],[54,1,"かん"],[56,1,"き"],[60,1,"まち"],[67,2,"じぶん"],[70,1,"み"],[72,1,"と"]],"text":"さてダビデのケイラにきたことがサウルに聞えたので、サウルは言った、「神はわたしの手に彼をわたされた。彼は門と貫の木のある町にはいって、自分で身を閉じこめたからである」。"},{"ref":"1Sam.23.8","start":9023008,"end":9023008,"break":"none","ruby":[[11,1,"たみ"],[13,1,"たたか"],[16,1,"よ"],[18,1,"あつ"],[26,1,"くだ"],[35,2,"じゅうしゃ"],[38,1,"せ"],[40,1,"かこ"]],"text":"そこでサウルはすべての民を戦いに呼び集めて、ケイラに下り、ダビデとその従者を攻め囲もうとした。"},{"ref":"1Sam.23.9","start":9023009,"end":9023009,"break":"none","ruby":[[8,2,"じぶん"],[11,1,"がい"],[13,1,"くわ"],[24,1,"し"],[28,2,"さいし"],[36,1,"い"],[45,1,"も"]],"text":"ダビデはサウルが自分に害を加えようとしているのを知って、祭司アビヤタルに言った、「エポデを持ってきてください」。"},{"ref":"1Sam.23.10","start":9023010,"end":9023010,"break":"none","ruby":[[7,1,"い"],[18,1,"かみ"],[20,1,"しゅ"],[48,1,"まち"],[50,1,"ほろ"],[62,1,"たし"],[65,1,"き"]],"text":"そしてダビデは言った、「イスラエルの神、主よ、しもべはサウルがケイラにきて、わたしのために、この町を滅ぼそうとしていることを確かに聞きました。"},{"ref":"1Sam.23.11","start":9023011,"end":9023011,"break":"none","ruby":[[4,2,"ひとびと"],[11,1,"かれ"],[13,1,"て"],[15,1,"わた"],[27,1,"き"],[38,1,"くだ"],[55,1,"かみ"],[57,1,"しゅ"],[68,1,"つ"],[77,1,"しゅ"],[79,1,"い"],[85,1,"かれ"],[87,1,"くだ"],[90,1,"く"]],"text":"ケイラの人々はわたしを彼の手に渡すでしょうか。しもべの聞いたように、サウルは下ってくるでしょうか。イスラエルの神、主よ、どうぞ、しもべに告げてください」。主は言われた、「彼は下って来る」。"},{"ref":"1Sam.23.12","start":9023012,"end":9023012,"break":"none","ruby":[[4,1,"い"],[13,2,"ひとびと"],[20,2,"じゅうしゃ"],[29,1,"て"],[41,1,"しゅ"],[43,1,"い"],[49,1,"かれ"],[58,1,"わた"]],"text":"ダビデは言った、「ケイラの人々はわたしと従者たちをサウルの手にわたすでしょうか」。主は言われた、「彼らはあなたがたを渡すであろう」。"},{"ref":"1Sam.23.13","start":9023013,"end":9023013,"break":"none","ruby":[[11,1,"にん"],[15,2,"じゅうしゃ"],[20,1,"た"],[28,1,"さ"],[53,1,"に"],[55,1,"さ"],[65,1,"きこ"],[75,1,"たたか"],[78,1,"で"]],"text":"そこでダビデとその六百人ほどの従者たちは立って、ケイラを去り、いずこともなくさまよった。ダビデのケイラから逃げ去ったことがサウルに聞えたので、サウルは戦いに出ることをやめた。"},{"ref":"1Sam.23.14","start":9023014,"end":9023014,"break":"none","ruby":[[4,2,"あらの"],[9,2,"ようがい"],[20,2,"あらの"],[23,2,"さんち"],[34,2,"ひび"],[37,1,"かれ"],[39,1,"たず"],[41,1,"もと"],[46,1,"かみ"],[48,1,"かれ"],[52,1,"て"],[54,1,"わた"]],"text":"ダビデは荒野にある要害におり、またジフの荒野の山地におった。サウルは日々に彼を尋ね求めたが、神は彼をその手に渡されなかった。"},{"ref":"1Sam.23.15","start":9023015,"end":9023015,"break":"paragraph","ruby":[[10,2,"じぶん"],[13,1,"いのち"],[15,1,"もと"],[18,1,"で"],[24,1,"おそ"],[30,1,"とき"],[38,2,"あらの"]],"text":"さてダビデはサウルが自分の命を求めて出てきたので恐れた。その時ダビデはジフの荒野のホレシにいたが、"},{"ref":"1Sam.23.16","start":9023016,"end":9023016,"break":"none","ruby":[[4,1,"こ"],[10,1,"た"],[27,1,"い"],[30,1,"かみ"],[35,1,"かれ"],[37,1,"ちから"]],"text":"サウルの子ヨナタンは立って、ホレシにいるダビデのもとに行き、神によって彼を力づけた。"},{"ref":"1Sam.23.17","start":9023017,"end":9023017,"break":"none","ruby":[[8,1,"かれ"],[10,1,"い"],[15,1,"おそ"],[27,1,"ちち"],[32,1,"て"],[38,1,"とど"],[57,1,"おう"],[70,1,"つぎ"],[84,1,"ちち"],[89,1,"し"]],"text":"そしてヨナタンは彼に言った、「恐れるにはおよびません。父サウルの手はあなたに届かないでしょう。あなたはイスラエルの王となり、わたしはあなたの次となるでしょう。このことは父サウルも知っています」。"},{"ref":"1Sam.23.18","start":9023018,"end":9023018,"break":"none","ruby":[[4,1,"かれ"],[10,1,"しゅ"],[12,1,"まえ"],[14,2,"けいやく"],[17,1,"むす"],[38,1,"いえ"],[40,1,"かえ"]],"text":"こうして彼らふたりは主の前で契約を結び、ダビデはホレシにとどまり、ヨナタンは家に帰った。"},{"ref":"1Sam.23.19","start":9023019,"end":9023019,"break":"paragraph","ruby":[[2,1,"とき"],[21,1,"のぼ"],[24,1,"い"],[30,1,"い"],[40,2,"あらの"],[43,1,"みなみ"],[51,1,"おか"],[53,1,"うえ"],[59,2,"ようがい"],[62,1,"かく"],[71,1,"とも"]],"text":"その時ジフびとはギベアにいるサウルのもとに上って行き、そして言った、「ダビデは、荒野の南にあるハキラの丘の上のホレシの要害に隠れて、われわれと共にいるではありませんか。"},{"ref":"1Sam.23.20","start":9023020,"end":9023020,"break":"none","ruby":[[4,1,"おう"],[11,1,"くだ"],[14,1,"い"],[20,1,"のぞ"],[29,1,"くだ"],[44,1,"かれ"],[46,1,"おう"],[48,1,"て"],[50,1,"わた"]],"text":"それゆえ王よ、あなたが下って行こうという望みのとおり、いま下ってきてください。われわれは彼を王の手に渡します」。"},{"ref":"1Sam.23.21","start":9023021,"end":9023021,"break":"none","ruby":[[4,1,"い"],[19,2,"どうじょう"],[22,1,"よ"],[35,1,"しゅ"],[43,2,"しゅくふく"]],"text":"サウルは言った、「あなたがたはわたしに同情を寄せてくれたのです。どうぞ主があなたがたを祝福されるように。"},{"ref":"1Sam.23.22","start":9023022,"end":9023022,"break":"none","ruby":[[6,1,"い"],[12,1,"たし"],[21,1,"かれ"],[25,1,"い"],[27,1,"ところ"],[35,1,"かれ"],[37,1,"み"],[41,1,"み"],[51,1,"ひと"],[53,1,"かた"],[63,1,"かれ"],[70,2,"わるがしこ"]],"text":"あなたがたは行って、なお確かめてください。彼のよく行く所とだれがそこで彼を見たかを見きわめてください。人の語るところによると、彼はひじょうに悪賢いそうだ。"},{"ref":"1Sam.23.23","start":9023023,"end":9023023,"break":"none","ruby":[[10,1,"かれ"],[12,1,"かく"],[15,1,"かく"],[17,2,"ばしょ"],[22,1,"み"],[27,1,"たし"],[30,1,"し"],[41,1,"ところ"],[43,1,"かえ"],[53,1,"とき"],[64,1,"とも"],[66,1,"い"],[73,1,"かれ"],[77,1,"ち"],[92,2,"しぞく"],[99,1,"たず"],[102,1,"かれ"],[104,1,"さが"]],"text":"それで、あなたがたは彼が隠れる隠れ場所をみな見きわめ、確かな知らせをもってわたしの所に帰ってきなさい。その時わたしはあなたがたと共に行きます。もし彼がこの地にいるならば、わたしはユダの氏族をあまねく尋ねて彼を捜しだします」。"},{"ref":"1Sam.23.24","start":9023024,"end":9023024,"break":"none","breaks":[[22,"paragraph"]],"ruby":[[0,1,"かれ"],[3,1,"た"],[11,2,"さきだ"],[18,1,"い"],[30,2,"じゅうしゃ"],[35,2,"あらの"],[38,1,"みなみ"],[50,2,"あらの"]],"text":"彼らは立って、サウルに先立ってジフへ行った。さてダビデとその従者たちは荒野の南のアラバにあるマオンの荒野にいた。"},{"ref":"1Sam.23.25","start":9023025,"end":9023025,"break":"none","ruby":[[9,2,"じゅうしゃ"],[16,1,"かれ"],[18,1,"さが"],[22,2,"ひとびと"],[32,1,"つ"],[46,2,"あらの"],[51,1,"いわ"],[53,1,"ところ"],[55,1,"くだ"],[58,1,"い"],[69,1,"き"],[77,2,"あらの"],[86,1,"お"]],"text":"そしてサウルとその従者たちはきて彼を捜した。人々がこれをダビデに告げたので、ダビデはマオンの荒野にある岩の所へ下って行った。サウルはこれを聞いて、マオンの荒野にきてダビデを追った。"},{"ref":"1Sam.23.26","start":9023026,"end":9023026,"break":"none","ruby":[[4,1,"やま"],[9,1,"がわ"],[11,1,"い"],[20,2,"じゅうしゃ"],[26,1,"やま"],[31,1,"がわ"],[33,1,"おこな"],[44,1,"いそ"],[67,2,"じゅうしゃ"],[79,2,"じゅうしゃ"],[84,1,"かこ"],[87,1,"とら"]],"text":"サウルは山のこちら側を行き、ダビデとその従者たちとは山のむこう側を行った。そしてダビデは急いでサウルからのがれようとした。サウルとその従者たちが、ダビデとその従者たちを囲んで捕えようとしたからである。"},{"ref":"1Sam.23.27","start":9023027,"end":9023027,"break":"none","ruby":[[2,1,"とき"],[8,1,"ところ"],[15,2,"ししゃ"],[20,1,"い"],[32,1,"くに"],[34,1,"おか"],[41,1,"いそ"]],"text":"その時、サウルの所に、ひとりの使者がきて言った、「ペリシテびとが国を侵しています。急いできてください」。"},{"ref":"1Sam.23.28","start":9023028,"end":9023028,"break":"none","ruby":[[11,1,"お"],[19,1,"かえ"],[22,1,"い"],[32,1,"あた"],[39,2,"ひとびと"],[45,1,"ところ"],[52,1,"いわ"],[55,1,"な"]],"text":"そこでサウルはダビデを追うことをやめて帰り、行ってペリシテびとに当った。それで人々は、その所を「のがれの岩」と名づけた。"},{"ref":"1Sam.23.29","start":9023029,"end":9023029,"break":"none","ruby":[[8,1,"のぼ"],[16,2,"ようがい"]],"text":"ダビデはそこから上ってエンゲデの要害にいた。"}]