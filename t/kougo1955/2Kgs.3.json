[{"ref":"2Kgs.3.1","start":12003001,"end":12003001,"break":"paragraph","ruby":[[3,1,"おう"],[10,1,"だい"],[13,1,"ねん"],[19,1,"こ"],[35,1,"おう"],[42,1,"ねん"],[43,1,"よ"],[45,1,"おさ"]],"text":"ユダの王ヨシャパテの第十八年にアハブの子ヨラムはサマリヤでイスラエルの王となり、十二年世を治めた。"},{"ref":"2Kgs.3.2","start":12003002,"end":12003002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[19,2,"ふぼ"],[31,1,"かれ"],[35,1,"ちち"],[37,1,"つく"],[44,2,"せきちゅう"],[47,1,"のぞ"]],"text":"彼は主の目の前に悪をおこなったが、その父母のようではなかった。彼がその父の造ったバアルの石柱を除いたからである。"},{"ref":"2Kgs.3.3","start":12003003,"end":12003003,"break":"none","ruby":[[3,1,"かれ"],[11,1,"つみ"],[13,1,"おか"],[21,1,"こ"],[28,1,"つみ"],[32,1,"したが"],[39,1,"はな"]],"text":"しかし彼はイスラエルに罪を犯させたネバテの子ヤラベアムの罪につき従って、それを離れなかった。"},{"ref":"2Kgs.3.4","start":12003004,"end":12003004,"break":"paragraph","ruby":[[4,1,"おう"],[9,1,"ひつじ"],[11,2,"しいく"],[13,1,"もの"],[19,2,"こひつじ"],[26,2,"おひつじ"],[29,1,"け"],[32,2,"ねんねん"],[40,1,"おう"],[42,1,"おさ"]],"text":"モアブの王メシャは羊の飼育者で、十万の小羊と、十万の雄羊の毛とを年々イスラエルの王に納めていたが、"},{"ref":"2Kgs.3.5","start":12003005,"end":12003005,"break":"none","ruby":[[4,1,"し"],[7,1,"のち"],[13,1,"おう"],[21,1,"おう"]],"text":"アハブが死んだ後、モアブの王はイスラエルの王にそむいた。"},{"ref":"2Kgs.3.6","start":12003006,"end":12003006,"break":"none","ruby":[[6,1,"おう"],[10,1,"とき"],[16,1,"で"],[32,1,"あつ"]],"text":"そこでヨラム王はその時サマリヤを出て、イスラエルびとをことごとく集め、"},{"ref":"2Kgs.3.7","start":12003007,"end":12003007,"break":"none","ruby":[[3,1,"ひと"],[8,1,"おう"],[25,1,"おう"],[46,1,"たたか"],[56,2,"いっしょ"],[59,1,"い"],[68,1,"い"],[73,1,"かれ"],[75,1,"い"],[80,1,"い"],[104,1,"たみ"],[110,1,"たみ"],[121,1,"うま"],[127,1,"うま"]],"text":"また、人をユダの王ヨシャパテにつかわし、「モアブの王はわたしにそむきました。あなたはモアブと戦うために、わたしと一緒に行かれませんか」と言わせた。彼は言った、「行きましょう。わたしはあなたと一つです。わたしの民はあなたの民と一つです。わたしの馬はあなたの馬と一つです」。"},{"ref":"2Kgs.3.8","start":12003008,"end":12003008,"break":"none","ruby":[[0,1,"かれ"],[4,1,"い"],[16,1,"みち"],[18,1,"のぼ"],[30,1,"こた"],[39,2,"あらの"],[42,1,"みち"],[44,1,"のぼ"]],"text":"彼はまた言った、「われわれはどの道を上るのですか」。ヨラムは答えた、「エドムの荒野の道を上りましょう」。"},{"ref":"2Kgs.3.9","start":12003009,"end":12003009,"break":"paragraph","ruby":[[10,1,"おう"],[15,1,"おう"],[23,1,"おう"],[25,1,"とも"],[27,1,"で"],[29,1,"い"],[36,1,"かれ"],[39,1,"まわ"],[41,1,"みち"],[46,2,"なぬか"],[49,1,"あいだ"],[50,1,"すす"],[55,2,"ぐんぜい"],[61,1,"したが"],[63,2,"かちく"],[66,1,"の"],[68,1,"みず"]],"text":"こうしてイスラエルの王はユダの王およびエドムの王と共に出て行った。しかし彼らは回り道をして、七日の間進んだが、軍勢とそれに従う家畜の飲む水がなかったので、"},{"ref":"2Kgs.3.10","start":12003010,"end":12003010,"break":"none","ruby":[[6,1,"おう"],[8,1,"い"],[16,1,"しゅ"],[22,1,"にん"],[24,1,"おう"],[30,1,"て"],[32,1,"わた"],[38,1,"め"],[40,1,"あつ"]],"text":"イスラエルの王は言った、「ああ、主は、この三人の王をモアブの手に渡そうとして召し集められたのだ」。"},{"ref":"2Kgs.3.11","start":12003011,"end":12003011,"break":"none","ruby":[[6,1,"い"],[16,1,"しゅ"],[18,1,"と"],[26,1,"しゅ"],[28,3,"よげんしゃ"],[48,1,"おう"],[54,2,"けらい"],[57,1,"こた"],[66,1,"て"],[68,1,"みず"],[70,1,"そそ"],[78,1,"こ"]],"text":"ヨシャパテは言った、「われわれが主に問うことのできる主の預言者はここにいませんか」。イスラエルの王のひとりの家来が答えた、「エリヤの手に水を注いだシャパテの子エリシャがここにいます」。"},{"ref":"2Kgs.3.12","start":12003012,"end":12003012,"break":"none","ruby":[[6,1,"い"],[11,1,"しゅ"],[13,2,"ことば"],[16,1,"かれ"],[33,1,"おう"],[45,1,"おう"],[48,1,"かれ"],[53,1,"くだ"]],"text":"ヨシャパテは言った、「主の言葉が彼にあります」。そこでイスラエルの王とヨシャパテとエドムの王とは彼のもとへ下っていった。"},{"ref":"2Kgs.3.13","start":12003013,"end":12003013,"break":"paragraph","ruby":[[11,1,"おう"],[13,1,"い"],[44,2,"ちちうえ"],[47,3,"よげんしゃ"],[53,2,"ははうえ"],[56,3,"よげんしゃ"],[62,1,"ところ"],[64,1,"い"],[77,1,"おう"],[79,1,"かれ"],[81,1,"い"],[90,1,"しゅ"],[95,1,"にん"],[97,1,"おう"],[103,1,"て"],[105,1,"わた"],[111,1,"め"],[113,1,"あつ"]],"text":"エリシャはイスラエルの王に言った、「わたしはあなたとなんのかかわりがありますか。あなたの父上の預言者たちと母上の預言者たちの所へ行きなさい」。イスラエルの王は彼に言った、「いいえ、主がこの三人の王をモアブの手に渡そうとして召し集められたのです」。"},{"ref":"2Kgs.3.14","start":12003014,"end":12003014,"break":"none","ruby":[[5,1,"い"],[14,1,"つか"],[17,2,"ばんぐん"],[20,1,"しゅ"],[22,1,"い"],[38,1,"おう"],[61,1,"かえり"],[68,1,"あ"]],"text":"エリシャは言った、「わたしの仕える万軍の主は生きておられます。わたしはユダの王ヨシャパテのためにするのでなければ、あなたを顧み、あなたに会うことはしないのだが、"},{"ref":"2Kgs.3.15","start":12003015,"end":12003015,"break":"none","ruby":[[2,2,"がくじん"],[9,1,"ところ"],[11,1,"つ"],[23,2,"がくじん"],[26,1,"がく"],[28,1,"そう"],[33,1,"しゅ"],[35,1,"て"],[37,1,"かれ"],[39,1,"のぞ"]],"text":"いま楽人をわたしの所に連れてきなさい」。そこで楽人が楽を奏すると、主の手が彼に臨んで、"},{"ref":"2Kgs.3.16","start":12003016,"end":12003016,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,1,"しゅ"],[11,1,"おお"],[24,1,"たに"],[26,1,"みず"],[31,1,"み"]],"text":"彼は言った、「主はこう仰せられる、『わたしはこの谷を水たまりで満たそう』。"},{"ref":"2Kgs.3.17","start":12003017,"end":12003017,"break":"none","ruby":[[3,1,"しゅ"],[7,1,"おお"],[25,1,"かぜ"],[27,1,"あめ"],[29,1,"み"],[37,1,"たに"],[39,1,"みず"],[41,1,"み"],[54,2,"かちく"],[59,1,"けもの"],[61,1,"の"]],"text":"これは主がこう仰せられるからである、『あなたがたは風も雨も見ないのに、この谷に水が満ちて、あなたがたと、その家畜および獣が飲むであろう』。"},{"ref":"2Kgs.3.18","start":12003018,"end":12003018,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"め"],[8,1,"ちい"],[11,1,"こと"],[16,1,"しゅ"],[32,1,"て"],[34,1,"わた"]],"text":"これは主の目には小さい事である。主はモアブびとをも、あなたがたの手に渡される。"},{"ref":"2Kgs.3.19","start":12003019,"end":12003019,"break":"none","ruby":[[13,2,"けんご"],[16,1,"まち"],[23,1,"よ"],[25,1,"まち"],[27,1,"う"],[34,1,"よ"],[36,1,"き"],[38,1,"き"],[40,1,"たお"],[47,1,"みず"],[49,2,"いど"],[56,1,"いし"],[61,1,"ち"],[67,1,"よ"],[69,1,"ところ"],[71,1,"あら"]],"text":"そしてあなたがたはすべての堅固な町と、すべての良い町を撃ち、すべての良い木を切り倒し、すべての水の井戸をふさぎ、石をもって地のすべての良い所を荒すであろう」。"},{"ref":"2Kgs.3.20","start":12003020,"end":12003020,"break":"none","ruby":[[3,1,"あさ"],[9,1,"そな"],[11,1,"もの"],[17,1,"とき"],[20,1,"みず"],[26,1,"ほう"],[29,1,"なが"],[35,1,"みず"],[37,1,"くに"],[39,1,"み"]],"text":"あくる朝になって、供え物をささげる時に、水がエドムの方から流れてきて、水は国に満ちた。"},{"ref":"2Kgs.3.21","start":12003021,"end":12003021,"break":"paragraph","ruby":[[8,1,"みな"],[10,1,"おう"],[14,2,"じぶん"],[19,1,"せ"],[25,1,"のぼ"],[32,1,"き"],[42,1,"き"],[50,1,"もの"],[53,1,"お"],[56,1,"わか"],[64,2,"しょうしゅう"],[69,2,"こっきょう"],[72,2,"はいち"]],"text":"さてモアブびとは皆、王たちが自分たちを攻めるために上ってきたのを聞いたので、よろいを着ることのできる者を、老いも若きもことごとく召集して、国境に配置したが、"},{"ref":"2Kgs.3.22","start":12003022,"end":12003022,"break":"none","ruby":[[0,1,"あさ"],[4,1,"お"],[8,2,"たいよう"],[15,1,"みず"],[17,1,"てら"],[29,1,"め"],[31,1,"まえ"],[33,1,"ち"],[38,1,"あか"],[40,1,"みず"],[42,1,"み"]],"text":"朝はやく起きて、太陽がのぼって水を照したとき、モアブびとは目の前に血のように赤い水を見たので、"},{"ref":"2Kgs.3.23","start":12003023,"end":12003023,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[11,1,"ち"],[17,1,"おう"],[21,1,"たがい"],[23,1,"たたか"],[26,1,"ころ"],[28,1,"あ"],[48,1,"い"]],"text":"彼らは言った、「これは血だ、きっと王たちが互に戦って殺し合ったのだ。だから、モアブよ、ぶんどりに行きなさい」。"},{"ref":"2Kgs.3.24","start":12003024,"end":12003024,"break":"none","ruby":[[15,2,"じんえい"],[18,1,"い"],[30,1,"た"],[42,1,"う"],[48,1,"かれ"],[57,1,"まえ"],[60,1,"に"],[62,1,"さ"],[74,1,"すす"],[84,1,"う"],[89,1,"くに"]],"text":"しかしモアブびとがイスラエルの陣営に行くと、イスラエルびとは立ちあがってモアブびとを撃ったので、彼らはイスラエルの前から逃げ去った。イスラエルびとは進んで、モアブびとを撃ち、その国にはいって、"},{"ref":"2Kgs.3.25","start":12003025,"end":12003025,"break":"none","ruby":[[0,2,"まちまち"],[3,1,"ほろ"],[11,1,"いし"],[18,1,"ち"],[24,1,"よ"],[26,1,"ところ"],[28,1,"な"],[35,1,"み"],[39,1,"みず"],[41,2,"いど"],[53,1,"よ"],[55,1,"き"],[62,1,"き"],[64,1,"たお"],[80,1,"な"],[82,1,"のこ"],[92,1,"いし"],[94,1,"な"],[97,1,"もの"],[102,1,"かこ"],[105,1,"う"],[107,1,"ほろ"]],"text":"町々を滅ぼし、おのおの石を一つずつ、地のすべての良い所に投げて、これに満たし、水の井戸をことごとくふさぎ、良い木をことごとく切り倒して、ただキル・ハラセテはその名を残すのみとなったが、石を投げる者がこれを囲んで撃ち滅ぼした。"},{"ref":"2Kgs.3.26","start":12003026,"end":12003026,"break":"none","ruby":[[4,1,"おう"],[6,1,"たたか"],[13,1,"はげ"],[17,1,"あた"],[24,1,"み"],[31,1,"ぬ"],[33,1,"もの"],[36,1,"にん"],[38,1,"ひき"],[45,1,"おう"],[47,1,"ところ"],[49,1,"つ"],[51,1,"はい"],[59,1,"はた"]],"text":"モアブの王は戦いがあまりに激しく、当りがたいのを見て、つるぎを抜く者七百人を率い、エドムの王の所に突き入ろうとしたが、果さなかったので、"},{"ref":"2Kgs.3.27","start":12003027,"end":12003027,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"くらい"],[5,1,"つ"],[11,2,"ちょうし"],[17,2,"じょうへき"],[20,1,"うえ"],[22,2,"はんさい"],[34,1,"とき"],[41,1,"おお"],[45,1,"いきどお"],[48,1,"のぞ"],[54,1,"かれ"],[57,1,"かれ"],[62,2,"じぶん"],[65,1,"くに"],[67,1,"かえ"]],"text":"自分の位を継ぐべきその長子をとって城壁の上で燔祭としてささげた。その時イスラエルに大いなる憤りが臨んだので、彼らは彼をすてて自分の国に帰った。"}]