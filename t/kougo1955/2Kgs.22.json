[{"ref":"2Kgs.22.1","start":12022001,"end":12022001,"break":"paragraph","ruby":[[5,1,"さい"],[7,1,"おう"],[21,1,"ねん"],[23,1,"あいだ"],[25,1,"よ"],[27,1,"おさ"],[31,1,"はは"],[42,1,"むすめ"],[45,1,"な"]],"text":"ヨシヤは八歳で王となり、エルサレムで三十一年の間、世を治めた。母はボヅカテのアダヤの娘で、名をエデダといった。"},{"ref":"2Kgs.22.2","start":12022002,"end":12022002,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"め"],[11,1,"こと"],[13,1,"おこな"],[16,2,"せんぞ"],[22,1,"みち"],[24,1,"あゆ"],[27,1,"みぎ"],[30,1,"ひだり"],[33,1,"まが"]],"text":"ヨシヤは主の目にかなう事を行い、先祖ダビデの道に歩んで右にも左にも曲らなかった。"},{"ref":"2Kgs.22.3","start":12022003,"end":12022003,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"だい"],[8,1,"ねん"],[10,1,"おう"],[18,1,"こ"],[24,1,"こ"],[28,3,"しょきかん"],[36,1,"しゅ"],[38,1,"みや"],[45,1,"い"]],"text":"ヨシヤ王の第十八年に王はメシュラムの子アザリヤの子である書記官シャパンを主の宮につかわして言った、"},{"ref":"2Kgs.22.4","start":12022004,"end":12022004,"break":"none","ruby":[[1,1,"だい"],[2,2,"さいし"],[16,1,"い"],[20,1,"しゅ"],[22,1,"みや"],[30,1,"ぎん"],[36,1,"もん"],[38,1,"まも"],[40,1,"もの"],[42,1,"たみ"],[45,1,"あつ"],[51,2,"そうがく"],[54,1,"かれ"],[56,1,"かぞ"]],"text":"「大祭司ヒルキヤのもとへのぼって行って、主に宮にはいってきた銀、すなわち門を守る者が民から集めたものの総額を彼に数えさせ、"},{"ref":"2Kgs.22.5","start":12022005,"end":12022005,"break":"none","ruby":[[3,2,"こうじ"],[11,1,"しゅ"],[13,1,"みや"],[15,2,"かんとく"],[17,1,"もの"],[19,1,"て"],[21,1,"わた"],[25,1,"かれ"],[29,1,"しゅ"],[31,1,"みや"],[33,2,"こうじ"],[38,1,"もの"],[43,1,"わた"],[47,1,"みや"],[49,1,"やぶ"],[52,1,"つくろ"]],"text":"それを工事をつかさどる主の宮の監督者の手に渡させ、彼らから主の宮で工事をする者にそれを渡して、宮の破れを繕わせなさい。"},{"ref":"2Kgs.22.6","start":12022006,"end":12022006,"break":"none","ruby":[[4,2,"もっこう"],[7,2,"けんちく"],[9,1,"し"],[11,2,"いしく"],[17,1,"わた"],[22,1,"みや"],[24,1,"つくろ"],[26,2,"ざいもく"],[29,1,"き"],[31,1,"いし"],[33,1,"か"]],"text":"すなわち木工と建築師と石工にそれを渡し、また宮を繕う材木と切り石を買わせなさい。"},{"ref":"2Kgs.22.7","start":12022007,"end":12022007,"break":"none","ruby":[[3,1,"かれ"],[6,2,"しょうじき"],[9,1,"こと"],[11,1,"おこな"],[16,1,"かれ"],[19,1,"わた"],[22,1,"ぎん"],[28,1,"かれ"],[31,2,"けいさん"],[36,1,"およ"]],"text":"ただし彼らは正直に事を行うから、彼らに渡した銀については彼らと計算するに及ばない」。"},{"ref":"2Kgs.22.8","start":12022008,"end":12022008,"break":"paragraph","ruby":[[2,1,"とき"],[3,1,"だい"],[4,2,"さいし"],[11,3,"しょきかん"],[19,1,"い"],[28,1,"しゅ"],[30,1,"みや"],[32,2,"りっぽう"],[35,1,"しょ"],[37,1,"み"],[55,2,"しょもつ"],[63,1,"わた"],[69,1,"かれ"],[74,1,"よ"]],"text":"その時大祭司ヒルキヤは書記官シャパンに言った、「わたしは主の宮で律法の書を見つけました」。そしてヒルキヤがその書物をシャパンに渡したので、彼はそれを読んだ。"},{"ref":"2Kgs.22.9","start":12022009,"end":12022009,"break":"none","ruby":[[0,3,"しょきかん"],[8,1,"おう"],[13,1,"い"],[16,1,"おう"],[18,2,"ほうこく"],[22,1,"い"],[33,1,"みや"],[38,1,"ぎん"],[40,1,"みな"],[41,1,"だ"],[48,2,"こうじ"],[56,1,"しゅ"],[58,1,"みや"],[60,2,"かんとく"],[62,1,"もの"],[64,1,"て"],[66,1,"わた"]],"text":"書記官シャパンは王のもとへ行き、王に報告して言った、「しもべどもは宮にあった銀を皆出して、それを工事をつかさどる主の宮の監督者の手に渡しました」。"},{"ref":"2Kgs.22.10","start":12022010,"end":12022010,"break":"none","ruby":[[0,3,"しょきかん"],[10,1,"おう"],[12,1,"つ"],[16,2,"さいし"],[30,2,"しょもつ"],[33,1,"わた"],[40,1,"い"],[46,1,"おう"],[48,1,"まえ"],[50,1,"よ"]],"text":"書記官シャパンはまた王に告げて「祭司ヒルキヤはわたしに一つの書物を渡しました」と言い、それを王の前で読んだ。"},{"ref":"2Kgs.22.11","start":12022011,"end":12022011,"break":"paragraph","ruby":[[0,1,"おう"],[4,2,"りっぽう"],[7,1,"しょ"],[9,2,"ことば"],[12,1,"き"],[18,1,"ころも"],[20,1,"さ"]],"text":"王はその律法の書の言葉を聞くと、その衣を裂いた。"},{"ref":"2Kgs.22.12","start":12022012,"end":12022012,"break":"none","ruby":[[3,1,"おう"],[5,2,"さいし"],[18,1,"こ"],[29,1,"こ"],[36,3,"しょきかん"],[45,1,"おう"],[47,2,"だいじん"],[54,1,"めい"],[57,1,"い"]],"text":"そして王は祭司ヒルキヤと、シャパンの子アヒカムと、ミカヤの子アクボルと、書記官シャパンと、王の大臣アサヤとに命じて言った、"},{"ref":"2Kgs.22.13","start":12022013,"end":12022013,"break":"none","ruby":[[7,1,"い"],[13,1,"み"],[18,2,"しょもつ"],[21,2,"ことば"],[35,1,"たみ"],[44,2,"ぜんこく"],[50,1,"しゅ"],[52,1,"たず"],[63,2,"せんぞ"],[70,2,"しょもつ"],[73,2,"ことば"],[76,1,"き"],[78,1,"したが"],[100,1,"こと"],[102,1,"おこな"],[112,1,"しゅ"],[124,1,"おお"],[128,1,"いか"],[131,1,"はっ"]],"text":"「あなたがたは行って、この見つかった書物の言葉について、わたしのため、民のため、またユダ全国のために主に尋ねなさい。われわれの先祖たちがこの書物の言葉に聞き従わず、すべてわれわれについてしるされている事を行わなかったために、主はわれわれにむかって、大いなる怒りを発しておられるからです」。"},{"ref":"2Kgs.22.14","start":12022014,"end":12022014,"break":"paragraph","ruby":[[3,2,"さいし"],[36,1,"つま"],[40,1,"おんな"],[41,3,"よげんしゃ"],[51,1,"い"],[65,1,"こ"],[73,1,"こ"],[76,2,"いしょう"],[81,1,"まも"],[83,1,"もの"],[91,1,"とき"],[102,2,"したまち"],[105,1,"す"],[111,1,"かれ"],[118,1,"つ"]],"text":"そこで祭司ヒルキヤ、アヒカム、アクボル、シャパンおよびアサヤはシャルムの妻である女預言者ホルダのもとへ行った。シャルムはハルハスの子であるテクワの子で、衣装べやを守る者であった。その時ホルダはエルサレムの下町に住んでいた。彼らがホルダに告げたので、"},{"ref":"2Kgs.22.15","start":12022015,"end":12022015,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[18,1,"かみ"],[20,1,"しゅ"],[24,1,"おお"],[47,1,"ひと"],[49,1,"い"]],"text":"ホルダは彼らに言った、「イスラエルの神、主はこう仰せられます、『あなたがたをわたしにつかわした人に言いなさい。"},{"ref":"2Kgs.22.16","start":12022016,"end":12022016,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"い"],[10,1,"み"],[20,1,"おう"],[22,1,"よ"],[27,2,"しょもつ"],[34,2,"ことば"],[43,1,"わざわい"],[47,1,"ところ"],[53,1,"す"],[58,1,"たみ"],[60,1,"くだ"]],"text":"主はこう言われます、見よ、わたしはユダの王が読んだあの書物のすべての言葉にしたがって、災をこの所と、ここに住んでいる民に下そうとしている。"},{"ref":"2Kgs.22.17","start":12022017,"end":12022017,"break":"none","ruby":[[0,1,"かれ"],[7,1,"す"],[10,1,"た"],[12,2,"かみがみ"],[15,1,"こう"],[20,2,"じぶん"],[25,1,"て"],[27,1,"つく"],[35,1,"もの"],[45,1,"いか"],[66,1,"ところ"],[72,1,"いか"],[75,1,"ひ"],[77,1,"はっ"],[84,1,"き"]],"text":"彼らがわたしを捨てて他の神々に香をたき、自分たちの手で作ったもろもろの物をもって、わたしを怒らせたからである。それゆえ、わたしはこの所にむかって怒りの火を発する。これは消えることがないであろう』。"},{"ref":"2Kgs.22.18","start":12022018,"end":12022018,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"たず"],[26,1,"おう"],[31,1,"い"],[42,1,"き"],[45,2,"ことば"],[57,1,"かみ"],[59,1,"しゅ"],[63,1,"おお"]],"text":"ただし主に尋ねるために、あなたがたをつかわしたユダの王にはこう言いなさい、『あなたが聞いた言葉についてイスラエルの神、主はこう仰せられます、"},{"ref":"2Kgs.22.19","start":12022019,"end":12022019,"break":"none","ruby":[[11,1,"ところ"],[17,1,"す"],[22,1,"たみ"],[32,1,"あ"],[34,1,"ち"],[50,1,"い"],[54,1,"き"],[57,1,"とき"],[59,1,"こころ"],[61,1,"く"],[64,1,"しゅ"],[66,1,"まえ"],[74,1,"ころも"],[76,1,"さ"],[83,1,"まえ"],[85,1,"な"],[101,1,"い"],[106,1,"き"],[114,1,"しゅ"],[116,1,"い"]],"text":"あなたは、わたしがこの所と、ここに住んでいる民にむかって、これは荒れ地となり、のろいとなるであろうと言うのを聞いた時、心に悔い、主の前にへりくだり、衣を裂いてわたしの前に泣いたゆえ、わたしもまたあなたの言うことを聞いたのであると主は言われる。"},{"ref":"2Kgs.22.20","start":12022020,"end":12022020,"break":"none","ruby":[[5,1,"み"],[16,2,"せんぞ"],[24,1,"あつ"],[32,1,"やす"],[36,1,"はか"],[38,1,"あつ"],[49,1,"ところ"],[51,1,"くだ"],[58,1,"わざわい"],[60,1,"め"],[62,1,"み"],[76,1,"かれ"],[81,2,"ことば"],[84,1,"おう"],[86,1,"も"],[88,1,"かえ"]],"text":"それゆえ、見よ、わたしはあなたを先祖たちのもとに集める。あなたは安らかに墓に集められ、わたしがこの所に下すもろもろの災を目に見ることはないであろう』」。彼らはこの言葉を王に持ち帰った。"}]