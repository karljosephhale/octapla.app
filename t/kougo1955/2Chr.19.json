[{"ref":"2Chr.19.1","start":14019001,"end":14019001,"break":"paragraph","ruby":[[3,1,"おう"],[22,2,"じぶん"],[25,1,"いえ"],[27,1,"かえ"]],"text":"ユダの王ヨシャパテは、つつがなくエルサレムの自分の家に帰った。"},{"ref":"2Chr.19.2","start":14019002,"end":14019002,"break":"none","ruby":[[5,3,"せんけんしゃ"],[12,1,"こ"],[17,1,"で"],[25,1,"むか"],[28,1,"い"],[37,2,"あくにん"],[40,1,"たす"],[43,1,"しゅ"],[45,1,"にく"],[47,1,"もの"],[49,1,"あい"],[63,1,"いか"],[66,1,"しゅ"],[68,1,"まえ"],[71,1,"で"],[78,1,"うえ"],[80,1,"のぞ"]],"text":"そのとき、先見者ハナニの子エヒウが出てヨシャパテを迎えて言った、「あなたは悪人を助け、主を憎む者を愛してよいのですか。それゆえ怒りが主の前から出て、あなたの上に臨みます。"},{"ref":"2Chr.19.3","start":14019003,"end":14019003,"break":"none","ruby":[[11,1,"よ"],[13,1,"こと"],[27,1,"ぞう"],[29,1,"くに"],[31,1,"なか"],[34,1,"のぞ"],[37,1,"こころ"],[39,1,"かたむ"],[42,1,"かみ"],[44,1,"もと"]],"text":"しかしあなたには、なお良い事もあります。あなたはアシラ像を国の中から除き、心を傾けて神を求められました」。"},{"ref":"2Chr.19.4","start":14019004,"end":14019004,"break":"paragraph","ruby":[[12,1,"す"],[21,1,"で"],[37,2,"さんち"],[41,1,"たみ"],[43,1,"なか"],[45,1,"めぐ"],[48,2,"せんぞ"],[53,1,"かみ"],[55,1,"しゅ"],[57,1,"かれ"],[60,1,"みちび"],[62,1,"かえ"]],"text":"ヨシャパテはエルサレムに住んでいたが、また出て、ベエルシバからエフライムの山地まで民の中を巡り、先祖たちの神、主に彼らを導き返した。"},{"ref":"2Chr.19.5","start":14019005,"end":14019005,"break":"none","ruby":[[0,1,"かれ"],[7,2,"くにぢゅう"],[14,2,"けんご"],[17,1,"まち"],[21,3,"さいばんにん"],[25,1,"お"]],"text":"彼はまたユダの国中、すべての堅固な町ごとに裁判人を置いた。"},{"ref":"2Chr.19.6","start":14019006,"end":14019006,"break":"none","ruby":[[3,3,"さいばんにん"],[9,1,"い"],[20,2,"じぶん"],[25,1,"こと"],[27,1,"き"],[41,1,"ひと"],[46,2,"さいばん"],[56,1,"しゅ"],[73,2,"さいばん"],[77,1,"とき"],[81,1,"しゅ"],[89,1,"とも"]],"text":"そして裁判人たちに言った、「あなたがたは自分のする事に気をつけなさい。あなたがたは人のために裁判するのではなく、主のためにするのです。あなたがたが裁判する時には、主はあなたがたと共におられます。"},{"ref":"2Chr.19.7","start":14019007,"end":14019007,"break":"none","ruby":[[9,1,"しゅ"],[11,1,"おそ"],[14,1,"つつし"],[17,1,"おこな"],[28,1,"かみ"],[30,1,"しゅ"],[33,2,"ふぎ"],[39,1,"ひと"],[45,1,"み"],[57,1,"と"]],"text":"だからあなたがたは主を恐れ、慎んで行いなさい。われわれの神、主には不義がなく、人をかたより見ることなく、まいないを取ることもないからです」。"},{"ref":"2Chr.19.8","start":14019008,"end":14019008,"break":"paragraph","ruby":[[13,2,"さいし"],[25,2,"しぞく"],[28,1,"ちょう"],[32,1,"えら"],[41,1,"お"],[44,1,"しゅ"],[49,2,"さいばん"],[52,1,"おこな"],[55,2,"そうぎ"],[58,2,"かいけつ"],[61,1,"あた"],[66,1,"かれ"],[75,2,"きょじゅう"]],"text":"ヨシャパテはまたレビびと、祭司、およびイスラエルの氏族の長たちを選んでエルサレムに置き、主のために裁判を行い、争議の解決に当らせた。彼らはエルサレムに居住した。"},{"ref":"2Chr.19.9","start":14019009,"end":14019009,"break":"none","ruby":[[6,1,"かれ"],[9,1,"めい"],[12,1,"い"],[23,1,"しゅ"],[25,1,"おそ"],[28,2,"しんじつ"],[31,2,"まごころ"],[38,1,"おこな"]],"text":"ヨシャパテは彼らに命じて言った、「あなたがたは主を恐れ、真実と真心とをもって行わなければならない。"},{"ref":"2Chr.19.10","start":14019010,"end":14019010,"break":"none","ruby":[[5,2,"まちまち"],[8,1,"す"],[19,2,"きょうだい"],[26,1,"ち"],[28,1,"なが"],[31,1,"こと"],[35,2,"りっぽう"],[38,1,"いまし"],[41,1,"さだ"],[50,1,"こと"],[55,1,"うった"],[64,1,"かれ"],[72,1,"しゅ"],[74,1,"まえ"],[76,1,"つみ"],[78,1,"おか"],[83,1,"いか"],[99,2,"きょうだい"],[104,1,"のぞ"],[131,1,"つみ"],[133,1,"おか"]],"text":"すべてその町々に住んでいるあなたがたの兄弟たちから、血を流した事または律法と戒め、定めとおきてなどの事について訴えてきたならば、彼らをさとして、主の前に罪を犯させず、怒りがあなたがたと、あなたがたの兄弟たちに臨まないようにしなさい。そのようにすれば、あなたがたは罪を犯すことがないでしょう。"},{"ref":"2Chr.19.11","start":14019011,"end":14019011,"break":"none","ruby":[[0,1,"み"],[3,2,"さいし"],[5,1,"ちょう"],[18,1,"うえ"],[23,1,"しゅ"],[25,1,"こと"],[42,1,"こ"],[47,1,"いえ"],[57,1,"おう"],[59,1,"こと"],[83,1,"まえ"],[88,2,"やくにん"],[96,2,"おお"],[100,2,"こうどう"],[107,1,"しゅ"],[109,2,"しょうじき"],[112,1,"ひと"],[114,1,"とも"]],"text":"見よ、祭司長アマリヤは、あなたがたの上にいて、主の事をすべてつかさどり、イシマエルの子、ユダの家のつかさゼバデヤは王の事をすべてつかさどり、またレビびとはあなたがたの前にあって役人となります。雄々しく行動しなさい。主は正直な人と共におられます」。"}]