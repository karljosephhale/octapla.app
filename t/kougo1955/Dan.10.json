[{"ref":"Dan.10.1","start":27010001,"end":27010001,"break":"paragraph","ruby":[[5,1,"おう"],[10,1,"だい"],[12,1,"ねん"],[23,1,"な"],[38,2,"ことば"],[41,2,"けいじ"],[50,2,"ことば"],[53,2,"しんじつ"],[59,1,"おお"],[63,1,"たたか"],[66,2,"いみ"],[77,1,"かれ"],[81,2,"ことば"],[84,1,"こころ"],[86,1,"と"],[91,1,"まぼろし"],[93,1,"さと"]],"text":"ペルシャの王クロスの第三年に、ベルテシャザルと名づけられたダニエルに、一つの言葉が啓示されたが、その言葉は真実であり、大いなる戦いを意味するものであった。彼はその言葉に心を留め、その幻を悟った。"},{"ref":"Dan.10.2","start":27010002,"end":27010002,"break":"paragraph","ruby":[[13,1,"しゅう"],[15,1,"あいだ"],[17,1,"かな"]],"text":"そのころ、われダニエルは三週の間、悲しんでいた。"},{"ref":"Dan.10.3","start":27010003,"end":27010003,"break":"none","ruby":[[5,2,"しゅうかん"],[8,1,"まった"],[10,1,"み"],[20,1,"もの"],[22,1,"た"],[26,1,"にく"],[28,1,"さけ"],[31,1,"くち"],[38,1,"み"],[40,1,"あぶら"],[42,1,"ぬ"]],"text":"すなわち三週間の全く満ちるまでは、うまい物を食べず、肉と酒とを口にせず、また身に油を塗らなかった。"},{"ref":"Dan.10.4","start":27010004,"end":27010004,"break":"none","ruby":[[0,2,"しょうがつ"],[6,1,"か"],[20,2,"おおかわ"],[23,1,"きし"],[25,1,"た"]],"text":"正月の二十四日に、わたしがチグリスという大川の岸に立っていたとき、"},{"ref":"Dan.10.5","start":27010005,"end":27010005,"break":"none","ruby":[[0,1,"め"],[5,1,"のぞ"],[7,1,"み"],[15,1,"ひと"],[20,2,"あま"],[22,1,"ぬの"],[24,1,"ころも"],[26,1,"き"],[32,1,"きん"],[34,1,"おび"],[36,1,"こし"]],"text":"目をあげて望み見ると、ひとりの人がいて、亜麻布の衣を着、ウパズの金の帯を腰にしめていた。"},{"ref":"Dan.10.6","start":27010006,"end":27010006,"break":"none","ruby":[[6,3,"りょくちゅうせき"],[16,1,"かお"],[18,2,"でんこう"],[27,1,"め"],[29,1,"も"],[43,1,"うで"],[45,1,"あし"],[52,2,"せいどう"],[58,1,"かがや"],[63,2,"ことば"],[66,1,"こえ"],[69,2,"ぐんしゅう"],[72,1,"こえ"]],"text":"そのからだは緑柱石のごとく、その顔は電光のごとく、その目は燃えるたいまつのごとく、その腕と足は、みがいた青銅のように輝き、その言葉の声は、群衆の声のようであった。"},{"ref":"Dan.10.7","start":27010007,"end":27010007,"break":"none","ruby":[[2,1,"まぼろし"],[4,1,"み"],[6,1,"もの"],[26,1,"とも"],[30,2,"ひとびと"],[36,1,"まぼろし"],[38,1,"み"],[45,1,"かれ"],[48,1,"おお"],[57,1,"に"]],"text":"この幻を見た者は、われダニエルのみであって、わたしと共にいた人々は、この幻を見なかったが、彼らは大いにおののいて、逃げかくれた。"},{"ref":"Dan.10.8","start":27010008,"end":27010008,"break":"none","ruby":[[9,1,"のこ"],[15,1,"おお"],[19,1,"まぼろし"],[21,1,"み"],[26,1,"ちから"],[28,1,"ぬ"],[30,1,"さ"],[35,1,"かお"],[37,1,"かがや"],[40,1,"おそ"],[44,1,"かわ"],[48,1,"まった"],[50,1,"ちから"]],"text":"それでわたしひとり残って、この大いなる幻を見たので、力が抜け去り、わが顔の輝きは恐ろしく変って、全く力がなくなった。"},{"ref":"Dan.10.9","start":27010009,"end":27010009,"break":"none","ruby":[[6,2,"ことば"],[9,1,"こえ"],[11,1,"き"],[18,2,"ことば"],[21,1,"こえ"],[23,1,"き"],[29,1,"かお"],[31,1,"ふ"],[34,1,"ち"],[38,1,"ふ"],[42,1,"ふか"],[44,1,"ねむ"],[47,1,"おちい"]],"text":"わたしはその言葉の声を聞いたが、その言葉の声を聞いたとき、顔を伏せ、地にひれ伏して、深い眠りに陥った。"},{"ref":"Dan.10.10","start":27010010,"end":27010010,"break":"paragraph","ruby":[[0,1,"み"],[6,1,"て"],[16,1,"ふ"],[26,1,"ふる"],[37,1,"て"]],"text":"見よ、一つの手があって、わたしに触れたので、わたしは震えながらひざまずき、手をつくと、"},{"ref":"Dan.10.11","start":27010011,"end":27010011,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[11,1,"おお"],[14,1,"あい"],[19,1,"ひと"],[34,1,"つ"],[37,2,"ことば"],[40,1,"こころ"],[42,1,"と"],[45,1,"た"],[58,1,"いま"],[77,1,"かれ"],[81,2,"ことば"],[88,1,"つ"],[100,1,"ふる"],[105,1,"た"]],"text":"彼はわたしに言った、「大いに愛せられる人ダニエルよ、わたしがあなたに告げる言葉に心を留め、立ちあがりなさい。わたしは今あなたのもとにつかわされたのです」。彼がこの言葉をわたしに告げているとき、わたしは震えながら立ちあがった。"},{"ref":"Dan.10.12","start":27010012,"end":27010012,"break":"none","ruby":[[3,1,"かれ"],[9,1,"い"],[20,1,"おそ"],[24,1,"およ"],[33,1,"さと"],[37,1,"こころ"],[46,1,"かみ"],[48,1,"まえ"],[50,1,"み"],[52,1,"なや"],[58,1,"はじ"],[61,1,"ひ"],[69,2,"ことば"],[76,1,"き"],[92,2,"ことば"]],"text":"すると彼はわたしに言った、「ダニエルよ、恐れるに及ばない。あなたが悟ろうと心をこめ、あなたの神の前に身を悩ましたその初めの日から、あなたの言葉は、すでに聞かれたので、わたしは、あなたの言葉のゆえにきたのです。"},{"ref":"Dan.10.13","start":27010013,"end":27010013,"break":"none","ruby":[[5,1,"くに"],[7,1,"きみ"],[13,1,"にち"],[15,1,"あいだ"],[20,1,"まえ"],[22,1,"た"],[31,2,"てんし"],[34,1,"ちょう"],[54,1,"たす"],[65,1,"かれ"],[72,1,"くに"],[74,1,"きみ"],[76,1,"とも"],[82,1,"のこ"]],"text":"ペルシャの国の君が、二十一日の間わたしの前に立ちふさがったが、天使の長のひとりであるミカエルがきて、わたしを助けたので、わたしは、彼をペルシャの国の君と共に、そこに残しておき、"},{"ref":"Dan.10.14","start":27010014,"end":27010014,"break":"none","ruby":[[0,1,"すえ"],[2,1,"ひ"],[9,1,"たみ"],[11,1,"のぞ"],[17,1,"こと"],[24,1,"さと"],[39,1,"まぼろし"],[49,1,"ひ"]],"text":"末の日に、あなたの民に臨まんとする事を、あなたに悟らせるためにきたのです。この幻は、なおきたるべき日にかかわるものです」。"},{"ref":"Dan.10.15","start":27010015,"end":27010015,"break":"paragraph","ruby":[[0,1,"かれ"],[6,2,"ことば"],[14,1,"の"],[27,1,"ち"],[31,1,"ふ"],[34,1,"だま"]],"text":"彼がこれらの言葉を、わたしに述べていたとき、わたしは、地にひれ伏して黙っていたが、"},{"ref":"Dan.10.16","start":27010016,"end":27010016,"break":"none","ruby":[[0,1,"み"],[3,1,"ひと"],[5,1,"こ"],[10,1,"もの"],[33,1,"くち"],[35,1,"ひら"],[40,1,"まえ"],[42,1,"た"],[47,1,"もの"],[49,1,"かた"],[52,1,"い"],[59,1,"しゅ"],[64,1,"まぼろし"],[70,1,"くる"],[78,1,"のぞ"],[81,1,"まった"],[83,1,"ちから"],[85,1,"うしな"]],"text":"見よ、人の子のような者が、わたしのくちびるにさわったので、わたしは口を開き、わが前に立っている者に語って言った、「わが主よ、この幻によって、苦しみがわたしに臨み、全く力を失いました。"},{"ref":"Dan.10.17","start":27010017,"end":27010017,"break":"none","ruby":[[2,1,"しゅ"],[15,1,"しゅ"],[17,1,"かた"],[33,1,"まった"],[35,1,"ちから"],[37,1,"うしな"],[40,1,"いき"],[42,1,"と"]],"text":"わが主のしもべは、どうしてわが主と語ることができましょう。わたしは全く力を失い、息も止まるばかりです」。"},{"ref":"Dan.10.18","start":27010018,"end":27010018,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"かたち"],[6,1,"もの"],[9,1,"ふたた"],[23,1,"ちから"]],"text":"人の形をした者は、再びわたしにさわり、わたしを力づけて、"},{"ref":"Dan.10.19","start":27010019,"end":27010019,"break":"none","ruby":[[0,1,"い"],[5,1,"おお"],[8,1,"あい"],[13,1,"ひと"],[16,1,"おそ"],[21,1,"およ"],[26,2,"あんしん"],[33,1,"こころ"],[35,1,"つよ"],[39,2,"ゆうき"],[42,1,"だ"],[49,1,"かれ"],[53,1,"い"],[63,1,"ちから"],[67,1,"い"],[74,1,"しゅ"],[77,1,"かた"],[94,1,"ちから"]],"text":"言った、「大いに愛せられる人よ、恐れるには及ばない。安心しなさい。心を強くし、勇気を出しなさい」。彼がこう言ったとき、わたしは力づいて言った、「わが主よ、語ってください。あなたは、わたしに力をつけてくださったから」。"},{"ref":"Dan.10.20","start":27010020,"end":27010020,"break":"none","ruby":[[3,1,"かれ"],[5,1,"い"],[29,1,"し"],[42,1,"いま"],[43,1,"かえ"],[55,1,"きみ"],[57,1,"たたか"],[69,1,"かれ"],[72,1,"たたか"],[84,1,"きみ"]],"text":"そこで彼は言った、「あなたは、わたしがなんのためにきたかを知っていますか。わたしは、今帰っていって、ペルシャの君と戦おうとしているのです。彼との戦いがすむと、ギリシヤの君があらわれるでしょう。"},{"ref":"Dan.10.21","start":27010021,"end":27010021,"break":"none","ruby":[[10,2,"しんり"],[13,1,"しょ"],[22,1,"こと"],[29,1,"つ"],[38,1,"たす"],[42,1,"かれ"],[45,1,"たたか"],[47,1,"もの"],[56,1,"きみ"]],"text":"しかしわたしは、まず真理の書にしるされている事を、あなたに告げよう。わたしを助けて、彼らと戦う者は、あなたがたの君ミカエルのほかにはありません。"}]