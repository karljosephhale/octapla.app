[{"ref":"Acts.7.1","start":44007001,"end":44007001,"break":"paragraph","ruby":[[0,3,"だいさいし"],[13,1,"たず"]],"text":"大祭司は「そのとおりか」と尋ねた。"},{"ref":"Acts.7.2","start":44007002,"end":44007002,"break":"none","breaks":[[13,"paragraph"]],"ruby":[[9,1,"い"],[14,2,"きょうだい"],[19,1,"ちち"],[25,1,"き"],[27,1,"くだ"],[37,2,"ふそ"],[50,1,"す"],[52,1,"まえ"],[68,2,"えいこう"],[71,1,"かみ"],[73,1,"かれ"],[75,1,"あらわ"]],"text":"そこで、ステパノが言った、「兄弟たち、父たちよ、お聞き下さい。わたしたちの父祖アブラハムが、カランに住む前、まだメソポタミヤにいたとき、栄光の神が彼に現れて"},{"ref":"Acts.7.3","start":44007003,"end":44007003,"break":"none","ruby":[[0,1,"おお"],[12,2,"とち"],[15,2,"しんぞく"],[19,1,"はな"],[29,1,"しめ"],[31,1,"ち"],[33,1,"い"]],"text":"仰せになった、『あなたの土地と親族から離れて、あなたにさし示す地に行きなさい』。"},{"ref":"Acts.7.4","start":44007004,"end":44007004,"break":"none","ruby":[[14,1,"びと"],[16,1,"ち"],[18,1,"で"],[25,1,"す"],[33,1,"かれ"],[35,1,"ちち"],[37,1,"し"],[43,1,"かみ"],[45,1,"かれ"],[52,1,"いま"],[59,1,"す"],[66,1,"ち"],[68,2,"いじゅう"]],"text":"そこで、アブラハムはカルデヤ人の地を出て、カランに住んだ。そして、彼の父が死んだのち、神は彼をそこから、今あなたがたの住んでいるこの地に移住させたが、"},{"ref":"Acts.7.5","start":44007005,"end":44007005,"break":"none","ruby":[[5,2,"いさん"],[13,1,"なに"],[17,2,"いっぽ"],[20,1,"はば"],[22,2,"とち"],[28,1,"あた"],[42,1,"ち"],[44,2,"しょりょう"],[49,1,"さづ"],[55,2,"やくそく"],[59,1,"かれ"],[65,1,"かれ"],[70,1,"こ"],[81,2,"しそん"],[85,1,"あた"]],"text":"そこでは、遺産となるものは何一つ、一歩の幅の土地すらも、与えられなかった。ただ、その地を所領として授けようとの約束を、彼と、そして彼にはまだ子がなかったのに、その子孫とに与えられたのである。"},{"ref":"Acts.7.6","start":44007006,"end":44007006,"break":"none","ruby":[[0,1,"かみ"],[4,1,"おお"],[12,1,"かれ"],[14,2,"しそん"],[17,2,"たこく"],[20,1,"み"],[22,1,"よ"],[39,1,"ねん"],[45,2,"どれい"],[51,2,"ぎゃくたい"],[54,1,"う"]],"text":"神はこう仰せになった、『彼の子孫は他国に身を寄せるであろう。そして、そこで四百年のあいだ、奴隷にされて虐待を受けるであろう』。"},{"ref":"Acts.7.7","start":44007007,"end":44007007,"break":"none","ruby":[[8,1,"おお"],[16,1,"かれ"],[19,2,"どれい"],[24,2,"こくみん"],[42,1,"のち"],[44,1,"かれ"],[54,1,"で"],[59,2,"ばしょ"],[66,2,"れいはい"]],"text":"それから、さらに仰せになった、『彼らを奴隷にする国民を、わたしはさばくであろう。その後、彼らはそこからのがれ出て、この場所でわたしを礼拝するであろう』。"},{"ref":"Acts.7.8","start":44007008,"end":44007008,"break":"none","ruby":[[4,1,"かみ"],[13,2,"かつれい"],[16,2,"けいやく"],[20,1,"あた"],[32,1,"かれ"],[38,1,"ちち"],[47,2,"かめ"],[50,2,"かつれい"],[53,1,"ほどこ"],[69,1,"ちち"],[80,1,"にん"],[82,2,"ぞくちょう"],[87,1,"ちち"]],"text":"そして、神はアブラハムに、割礼の契約をお与えになった。こうして、彼はイサクの父となり、これに八日目に割礼を施し、それから、イサクはヤコブの父となり、ヤコブは十二人の族長たちの父となった。"},{"ref":"Acts.7.9","start":44007009,"end":44007009,"break":"paragraph","ruby":[[0,2,"ぞくちょう"],[20,1,"う"],[31,1,"かみ"],[33,1,"かれ"],[35,1,"とも"]],"text":"族長たちは、ヨセフをねたんで、エジプトに売りとばした。しかし、神は彼と共にいまして、"},{"ref":"Acts.7.10","start":44007010,"end":44007010,"break":"none","ruby":[[4,2,"くなん"],[8,1,"かれ"],[10,1,"すく"],[12,1,"だ"],[19,1,"おう"],[23,1,"まえ"],[25,1,"めぐ"],[28,1,"あた"],[31,2,"ちえ"],[48,1,"かれ"],[50,2,"さいしょう"],[53,1,"にん"],[67,2,"おうけ"],[69,2,"ぜんたい"],[72,2,"しはい"],[75,1,"あた"]],"text":"あらゆる苦難から彼を救い出し、エジプト王パロの前で恵みを与え、知恵をあらわさせた。そこで、パロは彼を宰相の任につかせ、エジプトならびに王家全体の支配に当らせた。"},{"ref":"Acts.7.11","start":44007011,"end":44007011,"break":"none","ruby":[[0,1,"とき"],[13,2,"ぜんど"],[25,1,"おこ"],[28,1,"おお"],[31,2,"くなん"],[34,1,"おそ"],[46,2,"せんぞ"],[52,2,"しょくもつ"],[55,1,"え"]],"text":"時に、エジプトとカナンとの全土にわたって、ききんが起り、大きな苦難が襲ってきて、わたしたちの先祖たちは、食物が得られなくなった。"},{"ref":"Acts.7.12","start":44007012,"end":44007012,"break":"none","ruby":[[11,2,"しょくりょう"],[17,1,"き"],[21,1,"はじ"],[24,2,"せんぞ"]],"text":"ヤコブは、エジプトには食糧があると聞いて、初めに先祖たちをつかわしたが、"},{"ref":"Acts.7.13","start":44007013,"end":44007013,"break":"none","ruby":[[1,1,"かい"],[2,1,"め"],[4,1,"とき"],[11,2,"きょうだい"],[17,2,"じぶん"],[20,1,"み"],[22,1,"うえ"],[24,1,"う"],[26,1,"あ"],[32,1,"かれ"],[34,2,"しんぞく"],[36,2,"かんけい"],[42,1,"し"]],"text":"二回目の時に、ヨセフが兄弟たちに、自分の身の上を打ち明けたので、彼の親族関係がパロに知れてきた。"},{"ref":"Acts.7.14","start":44007014,"end":44007014,"break":"none","ruby":[[4,1,"つかい"],[10,1,"ちち"],[18,1,"にん"],[23,2,"しんぞく"],[25,2,"いちどう"],[29,1,"まね"]],"text":"ヨセフは使をやって、父ヤコブと七十五人にのぼる親族一同とを招いた。"},{"ref":"Acts.7.15","start":44007015,"end":44007015,"break":"none","ruby":[[14,1,"くだ"],[17,1,"かれ"],[18,2,"じしん"],[21,2,"せんぞ"],[29,1,"し"]],"text":"こうして、ヤコブはエジプトに下り、彼自身も先祖たちもそこで死に、"},{"ref":"Acts.7.16","start":44007016,"end":44007016,"break":"none","ruby":[[4,1,"かれ"],[12,1,"うつ"],[31,1,"かね"],[33,1,"だ"],[38,1,"ち"],[44,1,"こ"],[48,1,"か"],[54,1,"はか"],[57,1,"ほうむ"]],"text":"それから彼らは、シケムに移されて、かねてアブラハムがいくらかの金を出してこの地のハモルの子らから買っておいた墓に、葬られた。"},{"ref":"Acts.7.17","start":44007017,"end":44007017,"break":"paragraph","ruby":[[0,1,"かみ"],[8,1,"たい"],[11,1,"た"],[16,2,"やくそく"],[19,2,"じき"],[22,1,"ちか"],[29,1,"たみ"],[38,2,"ぜんど"]],"text":"神がアブラハムに対して立てられた約束の時期が近づくにつれ、民はふえてエジプト全土にひろがった。"},{"ref":"Acts.7.18","start":44007018,"end":44007018,"break":"none","ruby":[[11,1,"し"],[15,1,"べつ"],[17,1,"おう"],[25,1,"おこ"]],"text":"やがて、ヨセフのことを知らない別な王が、エジプトに起った。"},{"ref":"Acts.7.19","start":44007019,"end":44007019,"break":"none","ruby":[[2,1,"おう"],[11,2,"どうぞく"],[14,1,"たい"],[16,2,"さくりゃく"],[25,2,"せんぞ"],[30,2,"ぎゃくたい"],[36,1,"おさ"],[38,1,"ご"],[41,1,"い"],[52,1,"す"]],"text":"この王は、わたしたちの同族に対し策略をめぐらして、先祖たちを虐待し、その幼な子らを生かしておかないように捨てさせた。"},{"ref":"Acts.7.20","start":44007020,"end":44007020,"break":"none","ruby":[[4,1,"うま"],[25,1,"かれ"],[30,1,"み"],[32,1,"うつく"],[35,1,"こ"],[43,1,"げつ"],[45,1,"あいだ"],[48,1,"ちち"],[50,1,"いえ"],[52,1,"そだ"]],"text":"モーセが生れたのは、ちょうどこのころのことである。彼はまれに見る美しい子であった。三か月の間は、父の家で育てられたが、"},{"ref":"Acts.7.21","start":44007021,"end":44007021,"break":"none","ruby":[[4,1,"す"],[15,1,"むすめ"],[17,1,"ひろ"],[23,2,"じぶん"],[26,1,"こ"],[30,1,"そだ"]],"text":"そののち捨てられたのを、パロの娘が拾いあげて、自分の子として育てた。"},{"ref":"Acts.7.22","start":44007022,"end":44007022,"break":"none","ruby":[[8,1,"じん"],[14,2,"がくもん"],[17,1,"おし"],[19,1,"こ"],[23,2,"ことば"],[32,1,"ちから"]],"text":"モーセはエジプト人のあらゆる学問を教え込まれ、言葉にもわざにも、力があった。"},{"ref":"Acts.7.23","start":44007023,"end":44007023,"break":"paragraph","ruby":[[2,1,"さい"],[7,1,"とき"],[13,2,"じぶん"],[16,2,"きょうだい"],[26,1,"びと"],[33,1,"つく"],[39,1,"おも"],[41,1,"た"]],"text":"四十歳になった時、モーセは自分の兄弟であるイスラエル人たちのために尽すことを、思い立った。"},{"ref":"Acts.7.24","start":44007024,"end":44007024,"break":"none","ruby":[[21,1,"み"],[31,2,"ぎゃくたい"],[40,1,"ひと"],[46,2,"あいて"],[53,1,"じん"],[55,1,"う"],[58,2,"しかえ"]],"text":"ところが、そのひとりがいじめられているのを見て、これをかばい、虐待されているその人のために、相手のエジプト人を撃って仕返しをした。"},{"ref":"Acts.7.25","start":44007025,"end":44007025,"break":"none","ruby":[[0,1,"かれ"],[3,2,"じぶん"],[6,1,"て"],[11,1,"かみ"],[13,2,"きょうだい"],[18,1,"すく"],[21,1,"くだ"],[32,1,"さと"],[37,1,"おも"],[44,2,"じっさい"],[50,1,"さと"]],"text":"彼は、自分の手によって神が兄弟たちを救って下さることを、みんなが悟るものと思っていたが、実際はそれを悟らなかったのである。"},{"ref":"Acts.7.26","start":44007026,"end":44007026,"break":"none","ruby":[[0,2,"よくじつ"],[7,1,"かれ"],[10,1,"あらそ"],[12,1,"あ"],[21,1,"あらわ"],[24,2,"ちゅうさい"],[32,1,"い"],[40,1,"きみ"],[44,2,"きょうだい"],[46,2,"どうし"],[58,1,"たがい"],[60,1,"きず"],[63,1,"あ"]],"text":"翌日モーセは、彼らが争い合っているところに現れ、仲裁しようとして言った、『まて、君たちは兄弟同志ではないか。どうして互に傷つけ合っているのか』。"},{"ref":"Acts.7.27","start":44007027,"end":44007027,"break":"none","ruby":[[4,2,"なかま"],[13,1,"もの"],[20,1,"つ"],[22,1,"と"],[26,1,"い"],[35,1,"きみ"],[42,3,"しはいしゃ"],[46,3,"さいばんにん"]],"text":"すると、仲間をいじめていた者が、モーセを突き飛ばして言った、『だれが、君をわれわれの支配者や裁判人にしたのか。"},{"ref":"Acts.7.28","start":44007028,"end":44007028,"break":"none","ruby":[[0,1,"きみ"],[11,1,"じん"],[13,1,"ころ"],[24,1,"ころ"],[28,1,"おも"]],"text":"君は、きのう、エジプト人を殺したように、わたしも殺そうと思っているのか』。"},{"ref":"Acts.7.29","start":44007029,"end":44007029,"break":"none","ruby":[[7,2,"ことば"],[10,1,"き"],[13,1,"に"],[21,1,"ち"],[23,1,"み"],[25,1,"よ"],[31,1,"おとこ"],[33,1,"こ"]],"text":"モーセは、この言葉を聞いて逃げ、ミデアンの地に身を寄せ、そこで男の子ふたりをもうけた。"},{"ref":"Acts.7.30","start":44007030,"end":44007030,"break":"paragraph","ruby":[[2,1,"ねん"],[6,1,"とき"],[11,1,"ざん"],[13,2,"あらの"],[20,2,"みつかい"],[23,1,"しば"],[25,1,"も"],[28,1,"ほのお"],[30,1,"なか"],[36,1,"あらわ"]],"text":"四十年たった時、シナイ山の荒野において、御使が柴の燃える炎の中でモーセに現れた。"},{"ref":"Acts.7.31","start":44007031,"end":44007031,"break":"none","ruby":[[0,1,"かれ"],[4,2,"こうけい"],[7,1,"み"],[9,3,"ふしぎ"],[13,1,"おも"],[19,1,"み"],[27,2,"ちかよ"],[35,1,"しゅ"],[37,1,"こえ"],[39,1,"きこ"]],"text":"彼はこの光景を見て不思議に思い、それを見きわめるために近寄ったところ、主の声が聞えてきた、"},{"ref":"Acts.7.32","start":44007032,"end":44007032,"break":"none","ruby":[[10,2,"せんぞ"],[15,1,"かみ"],[31,1,"かみ"],[41,1,"おそ"],[54,1,"み"],[56,2,"ゆうき"]],"text":"『わたしは、あなたの先祖たちの神、アブラハム、イサク、ヤコブの神である』。モーセは恐れおののいて、もうそれを見る勇気もなくなった。"},{"ref":"Acts.7.33","start":44007033,"end":44007033,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"かれ"],[8,1,"い"],[18,1,"あし"],[25,1,"ぬ"],[35,1,"た"],[42,2,"ばしょ"],[46,1,"せい"],[49,1,"ち"]],"text":"すると、主が彼に言われた、『あなたの足から、くつを脱ぎなさい。あなたの立っているこの場所は、聖なる地である。"},{"ref":"Acts.7.34","start":44007034,"end":44007034,"break":"none","ruby":[[16,1,"たみ"],[18,2,"ぎゃくたい"],[25,2,"ありさま"],[28,1,"たし"],[31,1,"み"],[38,2,"くのう"],[44,1,"ごえ"],[46,1,"き"],[52,1,"かれ"],[55,1,"すく"],[57,1,"だ"],[62,1,"くだ"],[75,1,"いま"]],"text":"わたしは、エジプトにいるわたしの民が虐待されている有様を確かに見とどけ、その苦悩のうめき声を聞いたので、彼らを救い出すために下ってきたのである。さあ、今あなたをエジプトにつかわそう』。"},{"ref":"Acts.7.35","start":44007035,"end":44007035,"break":"paragraph","ruby":[[10,1,"きみ"],[12,3,"しはいしゃ"],[16,3,"さいばんにん"],[26,1,"い"],[29,2,"はいせき"],[41,1,"かみ"],[44,1,"しば"],[46,1,"なか"],[48,1,"かれ"],[50,1,"あらわ"],[53,2,"みつかい"],[56,1,"て"],[62,3,"しはいしゃ"],[66,3,"かいほうしゃ"]],"text":"こうして、『だれが、君を支配者や裁判人にしたのか』と言って排斥されたこのモーセを、神は、柴の中で彼に現れた御使の手によって、支配者、解放者として、おつかわしになったのである。"},{"ref":"Acts.7.36","start":44007036,"end":44007036,"break":"none","ruby":[[2,1,"ひと"],[5,2,"ひとびと"],[8,1,"みちび"],[10,1,"だ"],[19,1,"ち"],[26,2,"こうかい"],[38,1,"ねん"],[43,2,"あらの"],[51,2,"きせき"],[59,1,"おこな"]],"text":"この人が、人々を導き出して、エジプトの地においても、紅海においても、また四十年のあいだ荒野においても、奇跡としるしとを行ったのである。"},{"ref":"Acts.7.37","start":44007037,"end":44007037,"break":"none","ruby":[[2,1,"ひと"],[10,1,"ひと"],[16,1,"かみ"],[23,1,"た"],[39,2,"きょうだい"],[44,1,"なか"],[52,3,"よげんしゃ"],[57,1,"た"],[68,1,"い"]],"text":"この人が、イスラエル人たちに、『神はわたしをお立てになったように、あなたがたの兄弟たちの中から、ひとりの預言者をお立てになるであろう』と言ったモーセである。"},{"ref":"Acts.7.38","start":44007038,"end":44007038,"break":"none","ruby":[[2,1,"ひと"],[8,1,"ざん"],[11,1,"かれ"],[13,1,"かた"],[18,2,"みつかい"],[21,2,"せんぞ"],[26,1,"とも"],[29,2,"あらの"],[35,2,"しゅうかい"],[41,1,"い"],[44,3,"みことば"],[48,1,"さず"],[61,1,"つた"]],"text":"この人が、シナイ山で、彼に語りかけた御使や先祖たちと共に、荒野における集会にいて、生ける御言葉を授かり、それをあなたがたに伝えたのである。"},{"ref":"Acts.7.39","start":44007039,"end":44007039,"break":"none","ruby":[[5,2,"せんぞ"],[10,1,"かれ"],[12,1,"したが"],[24,1,"かれ"],[26,1,"しりぞ"],[29,1,"こころ"],[31,1,"なか"]],"text":"ところが、先祖たちは彼に従おうとはせず、かえって彼を退け、心の中でエジプトにあこがれて、"},{"ref":"Acts.7.40","start":44007040,"end":44007040,"break":"none","ruby":[[7,1,"みちび"],[13,2,"かみがみ"],[16,1,"つく"],[19,1,"くだ"],[34,1,"ち"],[37,1,"みちび"],[70,1,"い"]],"text":"『わたしたちを導いてくれる神々を造って下さい。わたしたちをエジプトの地から導いてきたあのモーセがどうなったのか、わかりませんから』とアロンに言った。"},{"ref":"Acts.7.41","start":44007041,"end":44007041,"break":"none","ruby":[[5,1,"かれ"],[8,1,"こ"],[9,1,"うし"],[11,1,"ぞう"],[13,1,"つく"],[18,2,"ぐうぞう"],[21,1,"そな"],[23,1,"もの"],[29,2,"じぶん"],[34,1,"て"],[36,1,"つく"],[42,1,"まつ"]],"text":"そのころ、彼らは子牛の像を造り、その偶像に供え物をささげ、自分たちの手で造ったものを祭ってうち興じていた。"},{"ref":"Acts.7.42","start":44007042,"end":44007042,"break":"none","breaks":[[50,"stanza"],[60,"line"],[75,"line"]],"ruby":[[4,1,"かみ"],[6,1,"かお"],[12,1,"かれ"],[15,1,"てん"],[17,1,"ほし"],[19,1,"おが"],[24,1,"まか"],[30,3,"よげんしゃ"],[34,1,"しょ"],[38,1,"か"],[57,1,"いえ"],[62,1,"ねん"],[67,2,"あらの"],[72,1,"とき"],[80,1,"そな"],[82,1,"もの"]],"text":"そこで、神は顔をそむけ、彼らを天の星を拝むままに任せられた。預言者の書にこう書いてあるとおりである、『イスラエルの家よ、四十年のあいだ荒野にいた時に、いけにえと供え物とを、わたしにささげたことがあったか。"},{"ref":"Acts.7.43","start":44007043,"end":44007043,"break":"line","breaks":[[30,"line"],[53,"line"]],"ruby":[[11,2,"まくや"],[18,1,"ほし"],[20,1,"かみ"],[26,1,"まわ"],[35,1,"おが"],[40,2,"じぶん"],[43,1,"つく"],[46,2,"ぐうぞう"],[49,1,"す"],[77,1,"うつ"]],"text":"あなたがたは、モロクの幕屋やロンパの星の神を、かつぎ回った。それらは、拝むために自分で造った偶像に過ぎぬ。だからわたしは、あなたがたをバビロンのかなたへ、移してしまうであろう』。"},{"ref":"Acts.7.44","start":44007044,"end":44007044,"break":"paragraph","ruby":[[6,2,"せんぞ"],[11,2,"あらの"],[18,2,"まくや"],[29,1,"み"],[34,1,"かた"],[41,1,"つく"],[52,1,"かた"],[59,2,"めいれい"],[65,1,"つく"]],"text":"わたしたちの先祖には、荒野にあかしの幕屋があった。それは、見たままの型にしたがって造るようにと、モーセに語ったかたのご命令どおりに造ったものである。"},{"ref":"Acts.7.45","start":44007045,"end":44007045,"break":"none","ruby":[[2,2,"まくや"],[12,2,"せんぞ"],[21,1,"ひき"],[26,1,"かみ"],[31,1,"しょ"],[32,2,"みんぞく"],[35,1,"かれ"],[38,1,"まえ"],[41,1,"お"],[43,1,"はら"],[48,2,"しょりょう"],[53,1,"と"],[63,1,"も"],[65,1,"こ"],[69,2,"つぎつぎ"],[72,1,"う"],[74,1,"つ"],[83,2,"じだい"],[86,1,"およ"]],"text":"この幕屋は、わたしたちの先祖が、ヨシュアに率いられ、神によって諸民族を彼らの前から追い払い、その所領をのり取ったときに、そこに持ち込まれ、次々に受け継がれて、ダビデの時代に及んだものである。"},{"ref":"Acts.7.46","start":44007046,"end":44007046,"break":"none","ruby":[[5,1,"かみ"],[7,1,"めぐ"],[23,1,"かみ"],[28,1,"みや"],[30,2,"ぞうえい"],[36,1,"ねが"]],"text":"ダビデは、神の恵みをこうむり、そして、ヤコブの神のために宮を造営したいと願った。"},{"ref":"Acts.7.47","start":44007047,"end":44007047,"break":"none","ruby":[[12,1,"みや"],[14,1,"た"]],"text":"けれども、じっさいにその宮を建てたのは、ソロモンであった。"},{"ref":"Acts.7.48","start":44007048,"end":44007048,"break":"none","ruby":[[6,1,"たか"],[8,1,"もの"],[11,1,"て"],[13,1,"つく"],[16,1,"いえ"],[18,1,"うち"],[22,1,"す"],[30,3,"よげんしゃ"],[34,1,"い"]],"text":"しかし、いと高き者は、手で造った家の内にはお住みにならない。預言者が言っているとおりである、"},{"ref":"Acts.7.49","start":44007049,"end":44007049,"break":"stanza","breaks":[[9,"line"],[27,"line"],[43,"line"],[52,"line"]],"ruby":[[1,1,"しゅ"],[3,1,"おお"],[12,1,"いえ"],[21,1,"た"],[35,2,"ばしょ"],[43,1,"てん"],[49,2,"おうざ"],[52,1,"ち"],[58,1,"あし"],[59,1,"だい"]],"text":"『主が仰せられる、どんな家をわたしのために建てるのか。わたしのいこいの場所は、どれか。天はわたしの王座、地はわたしの足台である。"},{"ref":"Acts.7.50","start":44007050,"end":44007050,"break":"paragraph","ruby":[[3,1,"みな"],[8,1,"て"],[10,1,"つく"]],"text":"これは皆わたしの手が造ったものではないか』。"},{"ref":"Acts.7.51","start":44007051,"end":44007051,"break":"none","ruby":[[3,2,"ごうじょう"],[7,1,"こころ"],[10,1,"みみ"],[13,2,"かつれい"],[18,1,"ひと"],[33,2,"せいれい"],[36,1,"さか"],[53,2,"せんぞ"],[58,1,"おな"]],"text":"ああ、強情で、心にも耳にも割礼のない人たちよ。あなたがたは、いつも聖霊に逆らっている。それは、あなたがたの先祖たちと同じである。"},{"ref":"Acts.7.52","start":44007052,"end":44007052,"break":"none","ruby":[[11,2,"せんぞ"],[14,2,"はくがい"],[21,3,"よげんしゃ"],[35,1,"かれ"],[38,1,"ただ"],[44,1,"く"],[49,2,"よこく"],[53,1,"ひと"],[57,1,"ころ"],[60,1,"いま"],[71,1,"ただ"],[77,2,"うらぎ"],[80,1,"もの"],[84,1,"ころ"],[86,1,"もの"]],"text":"いったい、あなたがたの先祖が迫害しなかった預言者が、ひとりでもいたか。彼らは正しいかたの来ることを予告した人たちを殺し、今やあなたがたは、その正しいかたを裏切る者、また殺す者となった。"},{"ref":"Acts.7.53","start":44007053,"end":44007053,"break":"none","ruby":[[7,2,"みつかい"],[15,1,"つた"],[20,2,"りっぽう"],[23,1,"う"],[32,1,"まも"]],"text":"あなたがたは、御使たちによって伝えられた律法を受けたのに、それを守ることをしなかった」。"},{"ref":"Acts.7.54","start":44007054,"end":44007054,"break":"paragraph","ruby":[[0,2,"ひとびと"],[6,1,"き"],[10,1,"こころ"],[12,1,"そこ"],[15,1,"はげ"],[18,1,"いか"],[31,1,"は"]],"text":"人々はこれを聞いて、心の底から激しく怒り、ステパノにむかって、歯ぎしりをした。"},{"ref":"Acts.7.55","start":44007055,"end":44007055,"break":"none","ruby":[[4,1,"かれ"],[6,2,"せいれい"],[9,1,"み"],[15,1,"てん"],[17,1,"み"],[25,1,"かみ"],[27,2,"えいこう"],[30,1,"あらわ"],[37,1,"かみ"],[39,1,"みぎ"],[41,1,"た"],[50,1,"み"]],"text":"しかし、彼は聖霊に満たされて、天を見つめていると、神の栄光が現れ、イエスが神の右に立っておられるのが見えた。"},{"ref":"Acts.7.56","start":44007056,"end":44007056,"break":"none","ruby":[[4,1,"かれ"],[10,1,"てん"],[12,1,"ひら"],[16,1,"ひと"],[18,1,"こ"],[20,1,"かみ"],[22,1,"みぎ"],[24,1,"た"],[35,1,"み"],[40,1,"い"]],"text":"そこで、彼は「ああ、天が開けて、人の子が神の右に立っておいでになるのが見える」と言った。"},{"ref":"Acts.7.57","start":44007057,"end":44007057,"break":"none","ruby":[[0,2,"ひとびと"],[3,2,"おおごえ"],[6,1,"さけ"],[12,1,"みみ"],[23,1,"め"],[33,2,"さっとう"]],"text":"人々は大声で叫びながら、耳をおおい、ステパノを目がけて、いっせいに殺到し、"},{"ref":"Acts.7.58","start":44007058,"end":44007058,"break":"none","ruby":[[0,1,"かれ"],[2,2,"しがい"],[5,1,"ひ"],[7,1,"だ"],[11,1,"いし"],[13,1,"う"],[20,1,"た"],[22,1,"あ"],[25,1,"ひと"],[30,2,"じぶん"],[33,2,"うわぎ"],[36,1,"ぬ"],[46,2,"わかもの"],[49,1,"あし"],[53,1,"お"]],"text":"彼を市外に引き出して、石で打った。これに立ち合った人たちは、自分の上着を脱いで、サウロという若者の足もとに置いた。"},{"ref":"Acts.7.59","start":44007059,"end":44007059,"break":"none","ruby":[[5,1,"かれ"],[13,1,"いし"],[15,1,"な"],[22,1,"あいだ"],[29,1,"いの"],[35,1,"い"],[40,1,"しゅ"],[50,1,"れい"],[53,1,"う"],[55,1,"くだ"]],"text":"こうして、彼らがステパノに石を投げつけている間、ステパノは祈りつづけて言った、「主イエスよ、わたしの霊をお受け下さい」。"},{"ref":"Acts.7.60","start":44007060,"end":44007060,"break":"none","ruby":[[11,2,"おおごえ"],[14,1,"さけ"],[19,1,"しゅ"],[28,1,"つみ"],[30,1,"かれ"],[33,1,"お"],[39,1,"くだ"],[46,1,"い"],[50,1,"かれ"],[52,1,"ねむ"]],"text":"そして、ひざまずいて、大声で叫んだ、「主よ、どうぞ、この罪を彼らに負わせないで下さい」。こう言って、彼は眠りについた。"}]