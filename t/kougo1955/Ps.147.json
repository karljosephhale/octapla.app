[{"ref":"Ps.147.1","start":19147001,"end":19147001,"break":"paragraph","breaks":[[9,"line"],[31,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[13,1,"かみ"],[31,1,"しゅ"],[33,1,"めぐ"]],"text":"主をほめたたえよ。われらの神をほめうたうことはよいことである。主は恵みふかい。さんびはふさわしいことである。"},{"ref":"Ps.147.2","start":19147002,"end":19147002,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"きず"],[17,1,"お"],[23,1,"もの"],[25,1,"あつ"]],"text":"主はエルサレムを築き、イスラエルの追いやられた者を集められる。"},{"ref":"Ps.147.3","start":19147003,"end":19147003,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"こころ"],[4,1,"う"],[6,1,"くだ"],[10,1,"もの"],[18,1,"きず"],[20,1,"つつ"]],"text":"主は心の打ち砕かれた者をいやし、その傷を包まれる。"},{"ref":"Ps.147.4","start":19147004,"end":19147004,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"ほし"],[9,1,"かず"],[11,1,"さだ"],[20,1,"な"],[22,1,"あた"]],"text":"主はもろもろの星の数を定め、すべてそれに名を与えられる。"},{"ref":"Ps.147.5","start":19147005,"end":19147005,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"おお"],[10,1,"かみ"],[12,1,"ちから"],[14,1,"ゆた"],[23,2,"ちえ"]],"text":"われらの主は大いなる神、力も豊かであって、その知恵ははかりがたい。"},{"ref":"Ps.147.6","start":19147006,"end":19147006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"もの"],[15,1,"あ"],[18,1,"もの"],[20,1,"ち"],[22,1,"な"],[24,1,"す"]],"text":"主はしえたげられた者をささえ、悪しき者を地に投げ捨てられる。"},{"ref":"Ps.147.7","start":19147007,"end":19147007,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"かんしゃ"],[6,1,"うた"],[9,1,"こと"],[19,1,"かみ"]],"text":"主に感謝して歌え、琴にあわせてわれらの神をほめうたえ。"},{"ref":"Ps.147.8","start":19147008,"end":19147008,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"くも"],[7,1,"てん"],[13,1,"ち"],[18,1,"あめ"],[20,1,"そな"],[28,1,"やま"],[30,1,"くさ"]],"text":"主は雲をもって天をおおい、地のために雨を備え、もろもろの山に草をはえさせ、"},{"ref":"Ps.147.9","start":19147009,"end":19147009,"break":"line","breaks":[[8,"line"]],"ruby":[[0,2,"しょくもつ"],[3,1,"けもの"],[5,1,"あた"],[10,1,"な"],[12,1,"こ"],[17,1,"あた"]],"text":"食物を獣に与え、また鳴く小がらすに与えられる。"},{"ref":"Ps.147.10","start":19147010,"end":19147010,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"うま"],[4,1,"ちから"],[6,1,"よろこ"],[11,1,"ひと"],[13,1,"あし"]],"text":"主は馬の力を喜ばれず、人の足をよみせられない。"},{"ref":"Ps.147.11","start":19147011,"end":19147011,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"おそ"],[9,1,"もの"],[19,1,"のぞ"],[21,1,"もの"]],"text":"主はおのれを恐れる者とそのいつくしみを望む者とをよみせられる。"},{"ref":"Ps.147.12","start":19147012,"end":19147012,"break":"line","breaks":[[16,"line"]],"ruby":[[7,1,"しゅ"],[25,1,"かみ"]],"text":"エルサレムよ、主をほめたたえよ。シオンよ、あなたの神をほめたたえよ。"},{"ref":"Ps.147.13","start":19147013,"end":19147013,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"もん"],[8,1,"かん"],[10,1,"き"],[12,1,"かた"],[25,1,"こ"],[28,2,"しゅくふく"]],"text":"主はあなたの門の貫の木を堅くし、あなたのうちにいる子らを祝福されるからである。"},{"ref":"Ps.147.14","start":19147014,"end":19147014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[6,2,"こっきょう"],[9,1,"やす"],[15,1,"もっと"],[17,1,"よ"],[19,1,"むぎ"],[28,1,"あ"]],"text":"主はあなたの国境を安らかにし、最も良い麦をもってあなたを飽かせられる。"},{"ref":"Ps.147.15","start":19147015,"end":19147015,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"いまし"],[7,1,"ち"],[9,1,"くだ"],[17,2,"ことば"],[25,1,"はし"]],"text":"主はその戒めを地に下される。そのみ言葉はすみやかに走る。"},{"ref":"Ps.147.16","start":19147016,"end":19147016,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ゆき"],[4,1,"ひつじ"],[6,1,"け"],[11,1,"ふ"],[15,1,"しも"],[17,1,"はい"]],"text":"主は雪を羊の毛のように降らせ、霜を灰のようにまかれる。"},{"ref":"Ps.147.17","start":19147017,"end":19147017,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"こおり"],[12,1,"な"],[24,1,"さむ"],[27,1,"た"]],"text":"主は氷をパンくずのように投げうたれる。だれがその寒さに耐えることができましょうか。"},{"ref":"Ps.147.18","start":19147018,"end":19147018,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[3,2,"ことば"],[6,1,"くだ"],[12,1,"と"],[18,1,"かぜ"],[20,1,"ふ"],[33,1,"みず"],[35,1,"なが"]],"text":"主はみ言葉を下してこれを溶かし、その風を吹かせられると、もろもろの水は流れる。"},{"ref":"Ps.147.19","start":19147019,"end":19147019,"break":"line","breaks":[[15,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[5,2,"ことば"],[12,1,"しめ"],[22,1,"さだ"],[37,1,"しめ"]],"text":"主はそのみ言葉をヤコブに示し、そのもろもろの定めと、おきてとをイスラエルに示される。"},{"ref":"Ps.147.20","start":19147020,"end":19147020,"break":"line","breaks":[[11,"line"],[27,"line"],[46,"line"]],"ruby":[[0,1,"しゅ"],[6,2,"くにたみ"],[27,1,"かれ"],[30,1,"しゅ"],[41,1,"し"],[46,1,"しゅ"]],"text":"主はいずれの国民をも、このようにはあしらわれなかった。彼らは主のもろもろのおきてを知らない。主をほめたたえよ。"}]