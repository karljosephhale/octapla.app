[{"ref":"Gen.30.1","start":1030001,"end":1030001,"break":"paragraph","ruby":[[4,2,"じぶん"],[11,1,"こ"],[13,1,"う"],[19,1,"し"],[22,1,"とき"],[24,1,"あね"],[34,1,"い"],[43,1,"こ"],[62,1,"し"]],"text":"ラケルは自分がヤコブに子を産まないのを知った時、姉をねたんでヤコブに言った、「わたしに子どもをください。さもないと、わたしは死にます」。"},{"ref":"Gen.30.2","start":1030002,"end":1030002,"break":"none","ruby":[[8,1,"む"],[11,1,"いか"],[14,1,"い"],[23,1,"たい"],[25,1,"こ"],[37,1,"かみ"],[45,1,"かみ"],[47,1,"かわ"]],"text":"ヤコブはラケルに向かい怒って言った、「あなたの胎に子どもをやどらせないのは神です。わたしが神に代ることができようか」。"},{"ref":"Gen.30.3","start":1030003,"end":1030003,"break":"none","ruby":[[4,1,"い"],[25,2,"かのじょ"],[28,1,"ところ"],[38,2,"かのじょ"],[41,1,"こ"],[43,1,"う"],[54,1,"お"],[71,2,"かのじょ"],[77,1,"こ"],[79,1,"も"]],"text":"ラケルは言った、「わたしのつかえめビルハがいます。彼女の所におはいりなさい。彼女が子を産んで、わたしのひざに置きます。そうすれば、わたしもまた彼女によって子を持つでしょう」。"},{"ref":"Gen.30.4","start":1030004,"end":1030004,"break":"none","ruby":[[12,1,"かれ"],[14,1,"あた"],[18,1,"つま"],[30,2,"かのじょ"],[33,1,"ところ"]],"text":"ラケルはつかえめビルハを彼に与えて、妻とさせたので、ヤコブは彼女の所にはいった。"},{"ref":"Gen.30.5","start":1030005,"end":1030005,"break":"none","ruby":[[14,1,"こ"],[16,1,"う"]],"text":"ビルハは、みごもってヤコブに子を産んだ。"},{"ref":"Gen.30.6","start":1030006,"end":1030006,"break":"none","ruby":[[9,1,"かみ"],[15,1,"うった"],[18,1,"こた"],[27,1,"こえ"],[29,1,"き"],[37,1,"こ"],[39,1,"たま"],[45,1,"い"],[49,1,"な"],[54,1,"な"]],"text":"そこでラケルは、「神はわたしの訴えに答え、またわたしの声を聞いて、わたしに子を賜わった」と言って、名をダンと名づけた。"},{"ref":"Gen.30.7","start":1030007,"end":1030007,"break":"none","ruby":[[20,1,"だい"],[23,1,"こ"],[29,1,"う"]],"text":"ラケルのつかえめビルハはまた、みごもって第二の子をヤコブに産んだ。"},{"ref":"Gen.30.8","start":1030008,"end":1030008,"break":"none","ruby":[[13,1,"はげ"],[16,1,"あらそ"],[20,1,"あね"],[22,1,"あらそ"],[25,1,"か"],[30,1,"い"],[34,1,"な"],[41,1,"な"]],"text":"そこでラケルは、「わたしは激しい争いで、姉と争って勝った」と言って、名をナフタリと名づけた。"},{"ref":"Gen.30.9","start":1030009,"end":1030009,"break":"paragraph","ruby":[[5,2,"じぶん"],[8,1,"こ"],[10,1,"う"],[20,1,"み"],[33,1,"と"],[36,1,"つま"],[44,1,"あた"]],"text":"さてレアは自分が子を産むことのやんだのを見たとき、つかえめジルパを取り、妻としてヤコブに与えた。"},{"ref":"Gen.30.10","start":1030010,"end":1030010,"break":"none","ruby":[[15,1,"こ"],[17,1,"う"]],"text":"レアのつかえめジルパはヤコブに子を産んだ。"},{"ref":"Gen.30.11","start":1030011,"end":1030011,"break":"none","ruby":[[8,2,"こううん"],[15,1,"い"],[19,1,"な"],[24,1,"な"]],"text":"そこでレアは、「幸運がきた」と言って、名をガドと名づけた。"},{"ref":"Gen.30.12","start":1030012,"end":1030012,"break":"none","ruby":[[11,1,"だい"],[14,1,"こ"],[20,1,"う"]],"text":"レアのつかえめジルパは第二の子をヤコブに産んだ。"},{"ref":"Gen.30.13","start":1030013,"end":1030013,"break":"none","ruby":[[20,1,"むすめ"],[33,1,"もの"],[35,1,"い"],[43,1,"い"],[47,1,"な"],[53,1,"な"]],"text":"そこでレアは、「わたしは、しあわせです。娘たちはわたしをしあわせな者と言うでしょう」と言って、名をアセルと名づけた。"},{"ref":"Gen.30.14","start":1030014,"end":1030014,"break":"paragraph","ruby":[[6,1,"むぎ"],[7,1,"か"],[10,1,"ひ"],[12,1,"の"],[14,1,"で"],[17,1,"の"],[19,1,"こい"],[24,1,"み"],[31,1,"はは"],[38,1,"も"],[51,1,"い"],[60,1,"こ"],[62,1,"こい"]],"text":"さてルベンは麦刈りの日に野に出て、野で恋なすびを見つけ、それを母レアのもとに持ってきた。ラケルはレアに言った、「あなたの子の恋なすびをどうぞわたしにください」。"},{"ref":"Gen.30.15","start":1030015,"end":1030015,"break":"none","ruby":[[7,1,"い"],[20,1,"おっと"],[22,1,"と"],[27,1,"ちい"],[30,1,"こと"],[39,1,"うえ"],[51,1,"こ"],[53,1,"こい"],[59,1,"と"],[75,1,"い"],[88,1,"こ"],[90,1,"こい"],[95,1,"か"],[99,2,"こんや"],[101,1,"かれ"],[107,1,"とも"],[109,1,"ね"]],"text":"レアはラケルに言った、「あなたがわたしの夫を取ったのは小さな事でしょうか。その上、あなたはまたわたしの子の恋なすびをも取ろうとするのですか」。ラケルは言った、「それではあなたの子の恋なすびに換えて、今夜彼をあなたと共に寝させましょう」。"},{"ref":"Gen.30.16","start":1030016,"end":1030016,"break":"none","ruby":[[0,2,"ゆうがた"],[11,1,"の"],[14,1,"かえ"],[25,1,"かれ"],[27,2,"でむか"],[31,1,"い"],[40,1,"こ"],[42,1,"こい"],[59,1,"やと"],[76,1,"ところ"],[99,1,"よ"],[103,1,"とも"],[105,1,"ね"]],"text":"夕方になって、ヤコブが野から帰ってきたので、レアは彼を出迎えて言った、「わたしの子の恋なすびをもって、わたしがあなたを雇ったのですから、あなたはわたしの所に、はいらなければなりません」。ヤコブはその夜レアと共に寝た。"},{"ref":"Gen.30.17","start":1030017,"end":1030017,"break":"none","ruby":[[0,1,"かみ"],[5,1,"ねが"],[8,1,"き"],[15,2,"かのじょ"],[24,2,"ばんめ"],[27,1,"こ"],[33,1,"う"]],"text":"神はレアの願いを聞かれたので、彼女はみごもって五番目の子をヤコブに産んだ。"},{"ref":"Gen.30.18","start":1030018,"end":1030018,"break":"none","ruby":[[17,1,"おっと"],[19,1,"あた"],[25,1,"かみ"],[33,1,"あたい"],[35,1,"たま"],[44,1,"い"],[48,1,"な"],[56,1,"な"]],"text":"そこでレアは、「わたしがつかえめを夫に与えたから、神がわたしにその価を賜わったのです」と言って、名をイッサカルと名づけた。"},{"ref":"Gen.30.19","start":1030019,"end":1030019,"break":"none","ruby":[[12,2,"ばんめ"],[15,1,"こ"],[21,1,"う"]],"text":"レアはまた、みごもって六番目の子をヤコブに産んだ。"},{"ref":"Gen.30.20","start":1030020,"end":1030020,"break":"none","ruby":[[8,1,"かみ"],[14,1,"よ"],[16,2,"たまもの"],[30,1,"にん"],[32,1,"こ"],[34,1,"おっと"],[36,1,"う"],[42,1,"いま"],[45,1,"かれ"],[51,2,"いっしょ"],[54,1,"す"],[62,1,"い"],[68,1,"な"],[75,1,"な"]],"text":"そこでレアは、「神はわたしに良い賜物をたまわった。わたしは六人の子を夫に産んだから、今こそ彼はわたしと一緒に住むでしょう」と言って、その名をゼブルンと名づけた。"},{"ref":"Gen.30.21","start":1030021,"end":1030021,"break":"none","ruby":[[2,1,"のち"],[4,2,"かのじょ"],[11,1,"むすめ"],[13,1,"う"],[17,1,"な"],[22,1,"な"]],"text":"その後、彼女はひとりの娘を産んで、名をデナと名づけた。"},{"ref":"Gen.30.22","start":1030022,"end":1030022,"break":"none","ruby":[[0,1,"つぎ"],[2,1,"かみ"],[8,1,"こころ"],[15,2,"かのじょ"],[18,1,"ねが"],[21,1,"き"],[26,1,"たい"],[28,1,"ひら"]],"text":"次に神はラケルを心にとめられ、彼女の願いを聞き、その胎を開かれたので、"},{"ref":"Gen.30.23","start":1030023,"end":1030023,"break":"none","ruby":[[0,2,"かのじょ"],[9,1,"おとこ"],[11,1,"こ"],[13,1,"う"],[17,1,"かみ"],[23,1,"はじ"],[36,1,"い"]],"text":"彼女は、みごもって男の子を産み、「神はわたしの恥をすすいでくださった」と言って、"},{"ref":"Gen.30.24","start":1030024,"end":1030024,"break":"none","ruby":[[0,1,"な"],[6,1,"な"],[11,1,"しゅ"],[24,1,"こ"],[26,1,"くわ"],[36,1,"い"]],"text":"名をヨセフと名づけ、「主がわたしに、なおひとりの子を加えられるように」と言った。"},{"ref":"Gen.30.25","start":1030025,"end":1030025,"break":"paragraph","ruby":[[8,1,"う"],[11,1,"とき"],[21,1,"い"],[30,1,"さ"],[39,2,"こきょう"],[46,1,"くに"],[48,1,"い"]],"text":"ラケルがヨセフを産んだ時、ヤコブはラバンに言った、「わたしを去らせて、わたしの故郷、わたしの国へ行かせてください。"},{"ref":"Gen.30.26","start":1030026,"end":1030026,"break":"none","ruby":[[4,1,"つか"],[7,1,"え"],[13,2,"さいし"],[21,1,"あた"],[24,1,"い"],[44,1,"はたら"],[47,2,"ほねお"]],"text":"あなたに仕えて得たわたしの妻子を、わたしに与えて行かせてください。わたしがあなたのために働いた骨折りは、あなたがごぞんじです」。"},{"ref":"Gen.30.27","start":1030027,"end":1030027,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[18,1,"こころ"],[40,1,"しゅ"],[54,1,"めぐ"],[62,1,"み"]],"text":"ラバンは彼に言った、「もし、あなたの心にかなうなら、とどまってください。わたしは主があなたのゆえに、わたしを恵まれるしるしを見ました」。"},{"ref":"Gen.30.28","start":1030028,"end":1030028,"break":"none","ruby":[[2,1,"い"],[11,2,"ほうしゅう"],[14,1,"もう"],[16,1,"で"],[30,1,"はら"]],"text":"また言った、「あなたの報酬を申し出てください。わたしはそれを払います」。"},{"ref":"Gen.30.29","start":1030029,"end":1030029,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[24,1,"つか"],[40,2,"かちく"],[43,1,"か"]],"text":"ヤコブは彼に言った、「わたしがどのようにあなたに仕えたか、またどのようにあなたの家畜を飼ったかは、あなたがごぞんじです。"},{"ref":"Gen.30.30","start":1030030,"end":1030030,"break":"none","ruby":[[4,1,"く"],[6,1,"まえ"],[14,1,"も"],[35,1,"おお"],[43,1,"しゅ"],[49,1,"い"],[51,1,"ところ"],[61,1,"めぐ"],[83,2,"じぶん"],[86,1,"いえ"],[88,1,"な"]],"text":"わたしが来る前には、あなたの持っておられたものはわずかでしたが、ふえて多くなりました。主はわたしの行く所どこでも、あなたを恵まれました。しかし、いつになったらわたしも自分の家を成すようになるでしょうか」。"},{"ref":"Gen.30.31","start":1030031,"end":1030031,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,1,"なに"],[24,1,"い"],[41,1,"およ"],[66,1,"こと"],[81,1,"いま"],[83,1,"ど"],[88,1,"む"],[91,1,"か"],[94,1,"まも"]],"text":"彼は言った、「何をあなたにあげようか」。ヤコブは言った、「なにもわたしにくださるに及びません。もしあなたが、わたしのためにこの一つの事をしてくださるなら、わたしは今一度あなたの群れを飼い、守りましょう。"},{"ref":"Gen.30.32","start":1030032,"end":1030032,"break":"none","ruby":[[12,1,"む"],[17,1,"まわ"],[25,1,"なか"],[38,1,"ひつじ"],[46,1,"くろ"],[48,2,"こひつじ"],[55,1,"なか"],[72,1,"うつ"],[85,2,"ほうしゅう"]],"text":"わたしはきょう、あなたの群れをみな回ってみて、その中からすべてぶちとまだらの羊、およびすべて黒い小羊と、やぎの中のまだらのものと、ぶちのものとを移しますが、これをわたしの報酬としましょう。"},{"ref":"Gen.30.33","start":1030033,"end":1030033,"break":"none","ruby":[[15,1,"まえ"],[21,2,"ほうしゅう"],[28,1,"とき"],[34,1,"ただ"],[37,1,"こと"],[39,2,"しょうめい"],[56,1,"なか"],[80,2,"こひつじ"],[83,1,"なか"],[85,1,"くろ"],[105,1,"ぬす"]],"text":"あとで、あなたがきて、あなたの前でわたしの報酬をしらべる時、わたしの正しい事が証明されるでしょう。もしも、やぎの中にぶちのないもの、まだらでないものがあったり、小羊の中に黒くないものがあれば、それはみなわたしが盗んだものとなるでしょう」。"},{"ref":"Gen.30.34","start":1030034,"end":1030034,"break":"none","ruby":[[4,1,"い"],[18,1,"い"]],"text":"ラバンは言った、「よろしい。あなたの言われるとおりにしましょう」。"},{"ref":"Gen.30.35","start":1030035,"end":1030035,"break":"none","ruby":[[9,1,"ひ"],[11,1,"お"],[33,1,"め"],[53,1,"しろ"],[69,2,"こひつじ"],[72,1,"なか"],[74,1,"くろ"],[79,1,"うつ"],[82,1,"こ"],[85,1,"て"]],"text":"そこでラバンはその日、雄やぎのしまのあるもの、まだらのもの、すべて雌やぎのぶちのもの、まだらのもの、すべて白みをおびているもの、またすべて小羊の中の黒いものを移して子らの手にわたし、"},{"ref":"Gen.30.36","start":1030036,"end":1030036,"break":"none","ruby":[[5,1,"あいだ"],[8,1,"か"],[9,1,"じ"],[11,1,"へだ"],[15,1,"もう"],[27,1,"のこ"],[30,1,"む"],[33,1,"か"]],"text":"ヤコブとの間に三日路の隔たりを設けた。ヤコブはラバンの残りの群れを飼った。"},{"ref":"Gen.30.37","start":1030037,"end":1030037,"break":"paragraph","ruby":[[24,1,"き"],[29,1,"えだ"],[31,1,"と"],[34,1,"かわ"],[42,1,"しろ"],[44,1,"すじ"],[50,1,"えだ"],[52,1,"しろ"],[54,1,"ところ"],[56,1,"あら"]],"text":"ヤコブは、はこやなぎと、あめんどうと、すずかけの木のなまの枝を取り、皮をはいでそれに白い筋をつくり、枝の白い所を表わし、"},{"ref":"Gen.30.38","start":1030038,"end":1030038,"break":"none","ruby":[[0,1,"かわ"],[5,1,"えだ"],[8,1,"む"],[13,1,"みず"],[15,1,"の"],[17,1,"はち"],[23,1,"みず"],[27,1,"なか"],[30,1,"む"],[33,1,"む"],[38,1,"お"],[42,1,"む"],[45,1,"みず"],[47,1,"の"],[52,1,"とき"]],"text":"皮をはいだ枝を、群れがきて水を飲む鉢、すなわち水ぶねの中に、群れに向かわせて置いた。群れは水を飲みにきた時に、はらんだ。"},{"ref":"Gen.30.39","start":1030039,"end":1030039,"break":"none","ruby":[[4,1,"む"],[7,1,"えだ"],[9,1,"まえ"],[38,1,"う"]],"text":"すなわち群れは枝の前で、はらんで、しまのあるもの、ぶちのもの、まだらのものを産んだ。"},{"ref":"Gen.30.40","start":1030040,"end":1030040,"break":"none","ruby":[[6,2,"こひつじ"],[9,1,"べつ"],[15,1,"かれ"],[19,1,"む"],[22,1,"かお"],[28,1,"む"],[43,1,"くろ"],[49,1,"む"],[58,2,"じぶん"],[61,1,"む"],[64,1,"べつ"],[78,1,"む"],[83,1,"い"]],"text":"ヤコブはその小羊を別においた。彼はまた群れの顔をラバンの群れのしまのあるものと、すべて黒いものとに向かわせた。そして自分の群れを別にまとめておいて、ラバンの群れには、入れなかった。"},{"ref":"Gen.30.41","start":1030041,"end":1030041,"break":"none","ruby":[[2,1,"む"],[5,1,"つよ"],[10,2,"はつじょう"],[14,1,"とき"],[22,1,"みず"],[26,1,"なか"],[31,1,"む"],[34,1,"め"],[36,1,"まえ"],[41,1,"えだ"],[43,1,"お"],[47,1,"えだ"],[49,1,"あいだ"]],"text":"また群れの強いものが発情した時には、ヤコブは水ぶねの中に、その群れの目の前に、かの枝を置いて、枝の間で、はらませた。"},{"ref":"Gen.30.42","start":1030042,"end":1030042,"break":"none","ruby":[[4,1,"む"],[7,1,"よわ"],[12,1,"とき"],[19,1,"お"],[30,1,"よわ"],[45,1,"つよ"]],"text":"けれども群れの弱いものの時には、それを置かなかった。こうして弱いものはラバンのものとなり、強いものはヤコブのものとなったので、"},{"ref":"Gen.30.43","start":1030043,"end":1030043,"break":"none","ruby":[[2,1,"ひと"],[4,1,"おお"],[7,1,"と"],[10,1,"おお"],[13,1,"む"],[17,2,"だんじょ"],[20,2,"どれい"],[33,1,"も"]],"text":"この人は大いに富み、多くの群れと、男女の奴隷、およびらくだ、ろばを持つようになった。"}]