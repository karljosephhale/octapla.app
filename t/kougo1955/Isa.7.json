[{"ref":"Isa.7.1","start":23007001,"end":23007001,"break":"paragraph","ruby":[[3,1,"おう"],[9,1,"こ"],[16,1,"こ"],[21,1,"とき"],[27,1,"おう"],[37,1,"こ"],[47,1,"おう"],[52,1,"のぼ"],[64,1,"せ"],[68,1,"か"]],"text":"ユダの王、ウジヤの子ヨタム、その子アハズの時、スリヤの王レヂンとレマリヤの子であるイスラエルの王ペカとが上ってきて、エルサレムを攻めたが勝つことができなかった。"},{"ref":"Isa.7.2","start":23007002,"end":23007002,"break":"none","ruby":[[0,1,"とき"],[13,2,"どうめい"],[25,1,"いえ"],[27,1,"つ"],[30,1,"もの"],[38,1,"おう"],[40,1,"こころ"],[42,1,"たみ"],[44,1,"こころ"],[47,1,"かぜ"],[49,1,"うご"],[54,1,"はやし"],[56,1,"き"],[61,2,"どうよう"]],"text":"時に「スリヤがエフライムと同盟している」とダビデの家に告げる者があったので、王の心と民の心とは風に動かされる林の木のように動揺した。"},{"ref":"Isa.7.3","start":23007003,"end":23007003,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[10,1,"い"],[16,1,"いま"],[26,1,"こ"],[36,1,"とも"],[38,1,"で"],[40,1,"い"],[44,1,"ぬの"],[49,1,"の"],[51,1,"い"],[53,2,"おおじ"],[56,1,"そ"],[58,1,"うえ"],[60,1,"いけ"],[62,2,"すいどう"],[65,1,"はし"],[71,1,"あ"]],"text":"その時、主はイザヤに言われた、「今、あなたとあなたの子シャル・ヤシュブと共に出て行って、布さらしの野へ行く大路に沿う上の池の水道の端でアハズに会い、"},{"ref":"Isa.7.4","start":23007004,"end":23007004,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[9,1,"き"],[15,1,"しず"],[20,1,"おそ"],[44,1,"こ"],[46,1,"はげ"],[49,1,"いか"],[60,1,"も"],[62,1,"のこ"],[72,1,"き"],[74,1,"かぶ"],[79,1,"こころ"],[81,1,"よわ"]],"text":"彼に言いなさい、『気をつけて、静かにし、恐れてはならない。レヂンとスリヤおよびレマリヤの子が激しく怒っても、これら二つの燃え残りのくすぶっている切り株のゆえに心を弱くしてはならない。"},{"ref":"Isa.7.5","start":23007005,"end":23007005,"break":"none","ruby":[[17,1,"こ"],[19,1,"とも"],[29,1,"わる"],[31,1,"こと"],[33,1,"くわだ"],[36,1,"い"]],"text":"スリヤはエフライムおよびレマリヤの子と共にあなたにむかって悪い事を企てて言う、"},{"ref":"Isa.7.6","start":23007006,"end":23007006,"break":"none","ruby":[[9,1,"せ"],[11,1,"のぼ"],[18,1,"おびやか"],[32,1,"やぶ"],[34,1,"と"],[42,1,"こ"],[47,1,"おう"]],"text":"「われわれはユダに攻め上って、これを脅し、われわれのためにこれを破り取り、タビエルの子をそこの王にしよう」と。"},{"ref":"Isa.7.7","start":23007007,"end":23007007,"break":"stanza","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[14,1,"こと"],[16,1,"けっ"],[19,1,"おこな"],[27,1,"おこ"]],"text":"主なる神はこう言われる、この事は決して行われない、また起ることはない。"},{"ref":"Isa.7.8","start":23007008,"end":23007008,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[33,1,"ねん"],[44,1,"やぶ"],[48,1,"くに"]],"text":"スリヤのかしらはダマスコ、ダマスコのかしらはレヂンである。（六十五年のうちにエフライムは敗れて、国をなさないようになる。）"},{"ref":"Isa.7.9","start":23007009,"end":23007009,"break":"line","breaks":[[15,"line"],[34,"line"]],"ruby":[[29,1,"こ"],[42,1,"しん"],[50,1,"た"]],"text":"エフライムのかしらはサマリヤ、サマリヤのかしらはレマリヤの子である。もしあなたがたが信じないならば、立つことはできない』」。"},{"ref":"Isa.7.10","start":23007010,"end":23007010,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"ふたた"],[8,1,"つ"],[11,1,"い"]],"text":"主は再びアハズに告げて言われた、"},{"ref":"Isa.7.11","start":23007011,"end":23007011,"break":"none","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[16,1,"もと"],[20,2,"よみ"],[26,1,"ふか"],[28,1,"ところ"],[35,1,"てん"],[40,1,"たか"],[42,1,"ところ"],[44,1,"もと"]],"text":"「あなたの神、主に一つのしるしを求めよ、陰府のように深い所に、あるいは天のように高い所に求めよ」。"},{"ref":"Isa.7.12","start":23007012,"end":23007012,"break":"none","ruby":[[7,1,"い"],[19,1,"もと"],[23,1,"しゅ"],[25,1,"こころ"]],"text":"しかしアハズは言った、「わたしはそれを求めて、主を試みることをいたしません」。"},{"ref":"Isa.7.13","start":23007013,"end":23007013,"break":"none","ruby":[[7,1,"い"],[16,1,"いえ"],[19,1,"き"],[28,1,"ひと"],[30,1,"わずら"],[36,1,"ちい"],[39,1,"こと"],[47,1,"かみ"],[50,1,"わずら"]],"text":"そこでイザヤは言った、「ダビデの家よ、聞け。あなたがたは人を煩わすことを小さい事とし、またわが神をも煩わそうとするのか。"},{"ref":"Isa.7.14","start":23007014,"end":23007014,"break":"none","ruby":[[5,1,"しゅ"],[24,1,"あた"],[30,1,"み"],[42,1,"おとこ"],[44,1,"こ"],[46,1,"う"],[51,1,"な"]],"text":"それゆえ、主はみずから一つのしるしをあなたがたに与えられる。見よ、おとめがみごもって男の子を産む。その名はインマヌエルととなえられる。"},{"ref":"Isa.7.15","start":23007015,"end":23007015,"break":"none","ruby":[[2,1,"こ"],[4,1,"あく"],[6,1,"す"],[9,1,"ぜん"],[11,1,"えら"],[16,1,"し"],[25,2,"ぎょうにゅう"],[29,2,"はちみつ"],[33,1,"た"]],"text":"その子が悪を捨て、善を選ぶことを知るころになって、凝乳と、蜂蜜とを食べる。"},{"ref":"Isa.7.16","start":23007016,"end":23007016,"break":"none","ruby":[[5,1,"こ"],[7,1,"あく"],[9,1,"す"],[12,1,"ぜん"],[14,1,"えら"],[19,1,"し"],[21,1,"まえ"],[28,1,"おそ"],[37,1,"おう"],[39,1,"ち"],[41,1,"す"]],"text":"それはこの子が悪を捨て、善を選ぶことを知る前に、あなたが恐れているふたりの王の地は捨てられるからである。"},{"ref":"Isa.7.17","start":23007017,"end":23007017,"break":"none","ruby":[[0,1,"しゅ"],[12,1,"わか"],[15,1,"とき"],[23,1,"のぞ"],[34,1,"ひ"],[45,1,"たみ"],[52,1,"ちち"],[54,1,"いえ"],[57,1,"のぞ"],[73,1,"おう"]],"text":"主はエフライムがユダから分れた時からこのかた、臨んだことのないような日をあなたと、あなたの民と、あなたの父の家とに臨ませられる。それはアッスリヤの王である」。"},{"ref":"Isa.7.18","start":23007018,"end":23007018,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"しゅ"],[11,2,"かわがわ"],[14,1,"みなもと"],[22,1,"まね"],[31,1,"ち"],[35,1,"はち"],[37,1,"よ"]],"text":"その日、主はエジプトの川々の源にいる、はえを招き、アッスリヤの地にいる蜂を呼ばれる。"},{"ref":"Isa.7.19","start":23007019,"end":23007019,"break":"none","ruby":[[0,1,"かれ"],[5,1,"き"],[8,1,"けわ"],[11,1,"たに"],[13,1,"いわ"],[15,1,"さ"],[17,1,"め"],[31,2,"まきば"],[34,1,"うえ"]],"text":"彼らはみな来て、険しい谷、岩の裂け目、すべてのいばら、すべての牧場の上にとどまる。"},{"ref":"Isa.7.20","start":23007020,"end":23007020,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"しゅ"],[6,2,"おおかわ"],[9,1,"む"],[14,1,"やと"],[32,1,"おう"],[38,1,"あたま"],[40,1,"あし"],[42,1,"け"],[55,1,"のぞ"],[57,1,"さ"]],"text":"その日、主は大川の向こうから雇ったかみそり、すなわちアッスリヤの王をもって、頭と足の毛とをそり、また、ひげをも除き去られる。"},{"ref":"Isa.7.21","start":23007021,"end":23007021,"break":"none","ruby":[[2,1,"ひ"],[4,1,"ひと"],[6,1,"わか"],[8,2,"めうし"],[11,1,"とう"],[13,1,"ひつじ"],[15,1,"とう"],[17,1,"か"]],"text":"その日、人は若い雌牛一頭と羊二頭を飼い、"},{"ref":"Isa.7.22","start":23007022,"end":23007022,"break":"paragraph","ruby":[[4,1,"で"],[6,1,"ちち"],[8,1,"おお"],[13,2,"ぎょうにゅう"],[16,1,"た"],[28,1,"くに"],[33,1,"のこ"],[37,1,"もの"],[39,2,"ぎょうにゅう"],[43,2,"はちみつ"],[47,1,"た"]],"text":"それから出る乳が多いので、凝乳を食べることができ、すべて国のうちに残された者は凝乳と、蜂蜜とを食べることができる。"},{"ref":"Isa.7.23","start":23007023,"end":23007023,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"ぎん"],[11,1,"あたい"],[15,1,"かぶ"],[21,1,"き"],[26,1,"ところ"],[43,1,"は"],[46,1,"ところ"]],"text":"その日、銀一千シケルの価ある千株のぶどうの木のあった所も、ことごとくいばらと、おどろの生える所となり、"},{"ref":"Isa.7.24","start":23007024,"end":23007024,"break":"none","ruby":[[10,1,"ち"],[20,2,"ひとびと"],[23,1,"ゆみ"],[25,1,"や"],[33,1,"い"]],"text":"いばらと、おどろとが地にはびこるために、人々は弓と矢をもってそこへ行く。"},{"ref":"Isa.7.25","start":23007025,"end":23007025,"break":"none","ruby":[[6,1,"ほ"],[8,1,"たがや"],[15,2,"やまやま"],[35,1,"おそ"],[42,1,"い"],[54,1,"ち"],[58,1,"うし"],[60,1,"はな"],[63,1,"ひつじ"],[65,1,"ふ"]],"text":"くわをもって掘り耕したすべての山々にも、あなたは、いばらと、おどろとを恐れて、そこへ行くことができない。その地はただ牛を放ち、羊の踏むところとなる。"}]