[{"ref":"Hos.12.1","start":28012001,"end":28012001,"break":"paragraph","breaks":[[15,"line"],[21,"line"],[33,"line"],[45,"line"]],"ruby":[[10,1,"かぜ"],[12,1,"ぼく"],[15,2,"ひがしかぜ"],[18,1,"お"],[21,1,"いつわ"],[24,2,"ぼうぎゃく"],[28,1,"ま"],[30,1,"くわ"],[39,2,"とりひき"],[45,1,"あぶら"],[52,1,"おく"]],"text":"エフライムはひねもす風を牧し、東風を追い、偽りと暴虐とを増し加え、アッスリヤと取引をなし、油をエジプトに送った。"},{"ref":"Hos.12.2","start":28012002,"end":28012002,"break":"stanza","breaks":[[8,"line"],[26,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"あらそ"],[23,1,"ばっ"],[38,1,"むく"]],"text":"主はユダと争い、ヤコブをそのしわざにしたがって罰し、そのおこないにしたがって報いられる。"},{"ref":"Hos.12.3","start":28012003,"end":28012003,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"たい"],[13,2,"きょうだい"],[20,1,"とら"],[23,2,"せいじん"],[29,1,"かみ"],[31,1,"あらそ"]],"text":"ヤコブは胎にいたとき、その兄弟のかかとを捕え、成人したとき神と争った。"},{"ref":"Hos.12.4","start":28012004,"end":28012004,"break":"line","breaks":[[12,"line"],[27,"line"],[39,"line"]],"ruby":[[0,1,"かれ"],[2,1,"てん"],[4,1,"つかい"],[6,1,"あらそ"],[9,1,"か"],[12,1,"な"],[23,1,"もと"],[27,1,"かれ"],[33,1,"かみ"],[35,2,"であ"],[41,1,"ところ"],[43,1,"かみ"],[45,1,"かれ"],[47,1,"かた"]],"text":"彼は天の使と争って勝ち、泣いてこれにあわれみを求めた。彼はベテルで神に出会い、その所で神は彼と語られた。"},{"ref":"Hos.12.5","start":28012005,"end":28012005,"break":"line","ruby":[[0,1,"しゅ"],[2,2,"ばんぐん"],[5,1,"かみ"],[9,1,"な"],[11,1,"しゅ"]],"text":"主は万軍の神、その名は主である。"},{"ref":"Hos.12.6","start":28012006,"end":28012006,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[13,1,"かみ"],[15,1,"かえ"],[24,1,"ただ"],[29,1,"まも"],[39,1,"かみ"],[41,1,"ま"],[43,1,"のぞ"]],"text":"それゆえ、あなたはあなたの神に帰り、いつくしみと正しきとを守り、つねにあなたの神を待ち望め。"},{"ref":"Hos.12.7","start":28012007,"end":28012007,"break":"stanza","breaks":[[17,"line"]],"ruby":[[0,2,"しょうにん"],[5,1,"て"],[7,1,"いつわ"],[14,1,"も"],[25,1,"この"]],"text":"商人はその手に偽りのはかりを持ち、しえたげることを好む。"},{"ref":"Hos.12.8","start":28012008,"end":28012008,"break":"line","breaks":[[10,"line"],[28,"line"],[45,"line"],[56,"line"]],"ruby":[[6,1,"い"],[19,1,"と"],[22,1,"もの"],[32,2,"じぶん"],[37,2,"ざいほう"],[40,1,"え"],[48,1,"かれ"],[54,1,"とみ"],[58,1,"おか"],[61,1,"つみ"]],"text":"エフライムは言った、「まことにわたしは富める者となった。わたしは自分ために財宝を得た」と。しかし彼のすべての富もその犯した罪をつぐなうことはできない。"},{"ref":"Hos.12.9","start":28012009,"end":28012009,"break":"line","breaks":[[18,"line"],[29,"line"],[41,"line"]],"ruby":[[9,1,"くに"],[11,1,"で"],[22,1,"かみ"],[24,1,"しゅ"],[33,1,"まつり"],[35,1,"ひ"],[41,1,"ふたた"],[47,2,"てんまく"],[50,1,"す"]],"text":"わたしはエジプトの国を出たときから、あなたの神、主である。わたしは祭の日のように、再びあなたを天幕に住まわせよう。"},{"ref":"Hos.12.10","start":28012010,"end":28012010,"break":"stanza","breaks":[[14,"line"],[30,"line"]],"ruby":[[4,3,"よげんしゃ"],[10,1,"かた"],[14,1,"まぼろし"],[16,1,"おお"],[18,1,"しめ"],[34,3,"よげんしゃ"],[47,1,"かた"]],"text":"わたしは預言者たちに語った。幻を多く示したのはわたしである。わたしは預言者たちによってたとえを語った。"},{"ref":"Hos.12.11","start":28012011,"end":28012011,"break":"line","breaks":[[15,"line"],[29,"line"],[52,"line"]],"ruby":[[7,2,"ふぎ"],[15,1,"かれ"],[18,1,"かなら"],[24,1,"もの"],[31,1,"かれ"],[39,2,"おうし"],[42,2,"ぎせい"],[52,1,"かれ"],[55,2,"さいだん"],[58,1,"はたけ"],[63,1,"つ"],[66,2,"いしづか"]],"text":"もしギレアデに不義があるなら、彼らは必ずむなしき者となる。もし彼らがギルガルで雄牛を犠牲にささげるなら、彼らの祭壇は畑のうねに積んだ石塚のようになる。"},{"ref":"Hos.12.12","start":28012012,"end":28012012,"break":"line","breaks":[[19,"line"],[39,"line"]],"ruby":[[9,1,"ち"],[11,1,"に"],[25,1,"つま"],[33,1,"ひと"],[35,1,"つか"],[39,1,"かれ"],[41,1,"つま"],[49,1,"ひつじ"],[51,1,"か"]],"text":"（ヤコブはアラムの地に逃げっていった。イスラエルは妻をめとるために人に仕えた。彼は妻をめとるために羊を飼った。）"},{"ref":"Hos.12.13","start":28012013,"end":28012013,"break":"line","breaks":[[14,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[6,3,"よげんしゃ"],[26,1,"みちび"],[28,1,"だ"],[35,3,"よげんしゃ"],[45,1,"まも"]],"text":"主はひとりの預言者によって、イスラエルをエジプトから導き出し、ひとりの預言者によってこれを守られた。"},{"ref":"Hos.12.14","start":28012014,"end":28012014,"break":"line","breaks":[[16,"line"],[37,"line"]],"ruby":[[9,1,"しゅ"],[11,1,"いか"],[20,1,"しゅ"],[24,1,"ち"],[29,1,"かれ"],[31,1,"うえ"],[45,1,"かれ"],[47,1,"かえ"]],"text":"エフライムはいたく主を怒らせた。それゆえ主はその血のとがを彼の上にのこし、そのはずかしめを彼に返される。"}]