[{"ref":"Jonah.4.1","start":32004001,"end":32004001,"break":"paragraph","ruby":[[10,2,"ひじょう"],[13,2,"ふかい"],[19,1,"はげ"],[22,1,"いか"]],"text":"ところがヨナはこれを非常に不快として、激しく怒り、"},{"ref":"Jonah.4.2","start":32004002,"end":32004002,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"いの"],[5,1,"い"],[10,1,"しゅ"],[19,1,"くに"],[26,1,"とき"],[30,1,"こと"],[32,1,"もう"],[54,1,"いそ"],[87,1,"めぐ"],[89,1,"ふか"],[91,1,"かみ"],[100,1,"いか"],[113,1,"ゆた"],[117,1,"わざわい"],[119,1,"おも"],[130,1,"し"]],"text":"主に祈って言った、「主よ、わたしがなお国におりました時、この事を申したではありませんか。それでこそわたしは、急いでタルシシにのがれようとしたのです。なぜなら、わたしはあなたが恵み深い神、あわれみあり、怒ることおそく、いつくしみ豊かで、災を思いかえされることを、知っていたからです。"},{"ref":"Jonah.4.3","start":32004003,"end":32004003,"break":"none","ruby":[[3,1,"しゅ"],[9,1,"いま"],[14,1,"いのち"],[33,1,"い"],[39,1,"し"],[41,1,"ほう"]],"text":"それで主よ、どうぞ今わたしの命をとってください。わたしにとっては、生きるよりも死ぬ方がましだからです」。"},{"ref":"Jonah.4.4","start":32004004,"end":32004004,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"いか"]],"text":"主は言われた、「あなたの怒るのは、よいことであろうか」。"},{"ref":"Jonah.4.5","start":32004005,"end":32004005,"break":"none","ruby":[[6,1,"まち"],[9,1,"で"],[12,1,"まち"],[14,1,"ひがし"],[16,1,"ほう"],[18,1,"ざ"],[24,2,"じぶん"],[33,2,"こや"],[36,1,"つく"],[39,1,"まち"],[46,1,"み"],[56,1,"した"],[58,1,"ひ"],[59,1,"かげ"]],"text":"そこでヨナは町から出て、町の東の方に座し、そこに自分のために一つの小屋を造り、町のなりゆきを見きわめようと、その下の日陰にすわっていた。"},{"ref":"Jonah.4.6","start":32004006,"end":32004006,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"しゅ"],[5,1,"かみ"],[11,1,"あつ"],[14,2,"くつう"],[18,1,"すく"],[29,1,"そな"],[36,1,"そだ"],[42,1,"あたま"],[44,1,"うえ"],[46,2,"ひかげ"],[49,1,"もう"],[63,2,"ひじょう"],[66,1,"よろこ"]],"text":"時に主なる神は、ヨナを暑さの苦痛から救うために、とうごまを備えて、それを育て、ヨナの頭の上に日陰を設けた。ヨナはこのとうごまを非常に喜んだ。"},{"ref":"Jonah.4.7","start":32004007,"end":32004007,"break":"none","ruby":[[4,1,"かみ"],[6,2,"よくじつ"],[9,2,"よあ"],[13,1,"むし"],[15,1,"そな"],[38,1,"か"]],"text":"ところが神は翌日の夜明けに虫を備えて、そのとうごまをかませられたので、それは枯れた。"},{"ref":"Jonah.4.8","start":32004008,"end":32004008,"break":"none","ruby":[[3,2,"たいよう"],[6,1,"で"],[11,1,"かみ"],[13,1,"あつ"],[15,2,"ひがしかぜ"],[18,1,"そな"],[23,2,"たいよう"],[29,1,"あたま"],[31,1,"てら"],[40,1,"よわ"],[45,1,"し"],[50,1,"ねが"],[53,1,"い"],[58,1,"い"],[64,1,"し"],[66,1,"ほう"]],"text":"やがて太陽が出たとき、神が暑い東風を備え、また太陽がヨナの頭を照したので、ヨナは弱りはて、死ぬことを願って言った、「生きるよりも死ぬ方がわたしにはましだ」。"},{"ref":"Jonah.4.9","start":32004009,"end":32004009,"break":"none","ruby":[[3,1,"かみ"],[8,1,"い"],[26,1,"いか"],[39,1,"い"],[48,1,"いか"],[54,1,"くる"],[56,1,"し"]],"text":"しかし神はヨナに言われた、「とうごまのためにあなたの怒るのはよくない」。ヨナは言った、「わたしは怒りのあまり狂い死にそうです」。"},{"ref":"Jonah.4.10","start":32004010,"end":32004010,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"ろう"],[16,1,"そだ"],[21,1,"や"],[23,1,"しょう"],[28,1,"や"],[30,1,"ほろ"],[43,1,"お"]],"text":"主は言われた、「あなたは労せず、育てず、一夜に生じて、一夜に滅びたこのとうごまをさえ、惜しんでいる。"},{"ref":"Jonah.4.11","start":32004011,"end":32004011,"break":"none","ruby":[[9,1,"まん"],[15,2,"みぎひだり"],[24,2,"ひとびと"],[32,2,"かちく"],[40,1,"おお"],[43,1,"まち"],[49,1,"お"]],"text":"ましてわたしは十二万あまりの、右左をわきまえない人々と、あまたの家畜とのいるこの大きな町ニネベを、惜しまないでいられようか」。"}]