[{"ref":"Amos.5.1","start":30005001,"end":30005001,"break":"paragraph","ruby":[[6,1,"いえ"],[13,1,"かな"],[17,1,"うた"],[32,1,"の"],[37,2,"ことば"],[40,1,"き"]],"text":"イスラエルの家よ、わたしが悲しみの歌をもって、あなたがたについて宣べるこの言葉を聞け、"},{"ref":"Amos.5.2","start":30005002,"end":30005002,"break":"stanza","breaks":[[14,"line"],[23,"line"],[38,"line"]],"ruby":[[10,1,"たお"],[16,1,"お"],[18,1,"あ"],[23,2,"かのじょ"],[30,1,"ち"],[32,1,"な"],[34,1,"たお"],[41,1,"おこ"],[43,1,"もの"]],"text":"「おとめイスラエルは倒れて、また起き上がらず、彼女はおのれの地に投げ倒されてこれを起す者がない」。"},{"ref":"Amos.5.3","start":30005003,"end":30005003,"break":"stanza","breaks":[[12,"line"],[23,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[19,1,"いえ"],[24,1,"にん"],[25,1,"で"],[27,1,"まち"],[30,1,"にん"],[31,1,"のこ"],[35,1,"にん"],[36,1,"で"],[38,1,"まち"],[41,1,"にん"],[42,1,"のこ"]],"text":"主なる神はこう言われる、「イスラエルの家では、千人出た町は百人残り、百人出た町は十人残る」。"},{"ref":"Amos.5.4","start":30005004,"end":30005004,"break":"stanza","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"いえ"],[12,1,"い"],[28,1,"もと"],[35,1,"い"]],"text":"主はイスラエルの家にこう言われる、「あなたがたはわたしを求めよ、そして生きよ。"},{"ref":"Amos.5.5","start":30005005,"end":30005005,"break":"line","breaks":[[9,"line"],[18,"line"],[30,"line"],[45,"line"]],"ruby":[[4,1,"もと"],[14,1,"い"],[35,1,"かなら"],[37,1,"とら"],[42,1,"い"],[49,1,"む"],[51,1,"き"]],"text":"ベテルを求めるな、ギルガルに行くな。ベエルシバにおもむくな。ギルガルは必ず捕えられて行き、ベテルは無に帰するからである」。"},{"ref":"Amos.5.6","start":30005006,"end":30005006,"break":"stanza","breaks":[[19,"line"],[31,"line"],[44,"line"],[53,"line"]],"ruby":[[6,1,"しゅ"],[8,1,"もと"],[15,1,"い"],[24,1,"しゅ"],[26,1,"ひ"],[35,1,"いえ"],[37,1,"お"],[39,1,"くだ"],[44,1,"ひ"],[49,1,"や"],[63,1,"け"],[65,1,"もの"]],"text":"あなたがたは主を求めよ、そして生きよ。さもないと主は火のようにヨセフの家に落ち下られる。火はこれを焼くが、ベテルのためにこれを消す者はひとりもない。"},{"ref":"Amos.5.7","start":30005007,"end":30005007,"break":"line","breaks":[[18,"line"]],"ruby":[[6,2,"こうどう"],[15,1,"か"],[18,2,"せいぎ"],[21,1,"ち"],[23,1,"な"],[25,1,"す"],[28,1,"もの"]],"text":"あなたがた、公道をにがよもぎに変え、正義を地に投げ捨てる者よ。"},{"ref":"Amos.5.8","start":30005008,"end":30005008,"break":"stanza","breaks":[[16,"line"],[24,"line"],[35,"line"],[55,"line"]],"ruby":[[13,1,"つく"],[16,2,"あんこく"],[19,1,"あさ"],[21,1,"へん"],[24,1,"ひる"],[26,1,"くら"],[30,1,"よる"],[35,1,"うみ"],[37,1,"みず"],[39,1,"よ"],[43,1,"ち"],[49,1,"そそ"],[53,1,"もの"],[57,1,"な"],[59,1,"しゅ"]],"text":"プレアデスおよびオリオンを造り、暗黒を朝に変じ、昼を暗くして夜となし、海の水を呼んで、地のおもてに注がれる者、その名は主という。"},{"ref":"Amos.5.9","start":30005009,"end":30005009,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ほろ"],[9,1,"つよ"],[11,1,"もの"],[13,1,"のぞ"],[22,1,"ほろ"],[28,1,"しろ"],[30,1,"のぞ"]],"text":"主は滅びをたちまち強い者に臨ませられるので、滅びはついに城に臨む。"},{"ref":"Amos.5.10","start":30005010,"end":30005010,"break":"stanza","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"もん"],[7,1,"いまし"],[10,1,"もの"],[12,1,"にく"],[15,2,"しんじつ"],[18,1,"かた"],[20,1,"もの"],[22,1,"い"]],"text":"彼らは門にいて戒める者を憎み、真実を語る者を忌みきらう。"},{"ref":"Amos.5.11","start":30005011,"end":30005011,"break":"line","breaks":[[16,"line"],[30,"line"],[47,"line"],[61,"line"],[74,"line"]],"ruby":[[6,1,"まず"],[9,1,"もの"],[11,1,"ふ"],[16,1,"かれ"],[19,1,"むぎ"],[21,1,"おく"],[23,1,"もの"],[36,1,"き"],[38,1,"いし"],[40,1,"いえ"],[42,1,"た"],[49,1,"なか"],[51,1,"す"],[61,1,"うつく"],[67,1,"ばたけ"],[69,1,"つく"],[76,1,"さけ"],[78,1,"の"]],"text":"あなたがたは貧しい者を踏みつけ、彼から麦の贈り物をとるゆえ、あなたがたは切り石の家を建てても、その中に住むことはできない。美しいぶどう畑を作っても、その酒を飲むことはできない。"},{"ref":"Amos.5.12","start":30005012,"end":30005012,"break":"line","breaks":[[19,"line"],[36,"line"],[60,"line"]],"ruby":[[4,1,"し"],[16,1,"おお"],[25,1,"つみ"],[27,1,"おお"],[42,1,"ただ"],[45,1,"もの"],[57,1,"と"],[60,1,"もん"],[62,1,"まず"],[65,1,"もの"],[67,1,"しりぞ"]],"text":"わたしは知る、あなたがたのとがは多く、あなたがたの罪は大きいからである。あなたがたは正しい者をしえたげ、まいないを取り、門で貧しい者を退ける。"},{"ref":"Amos.5.13","start":30005013,"end":30005013,"break":"line","breaks":[[22,"line"]],"ruby":[[10,1,"とき"],[13,1,"かしこ"],[15,1,"もの"],[17,2,"ちんもく"],[25,1,"わる"],[27,1,"とき"]],"text":"それゆえ、このような時には賢い者は沈黙する、これは悪い時だからである。"},{"ref":"Amos.5.14","start":30005014,"end":30005014,"break":"stanza","breaks":[[13,"line"],[34,"line"],[48,"line"]],"ruby":[[0,1,"ぜん"],[2,1,"もと"],[6,1,"あく"],[8,1,"もと"],[24,1,"い"],[42,1,"い"],[48,2,"ばんぐん"],[51,1,"かみ"],[53,1,"しゅ"],[61,1,"とも"]],"text":"善を求めよ、悪を求めるな。そうすればあなたがたは生きることができる。またあなたがたが言うように、万軍の神、主はあなたがたと共におられる。"},{"ref":"Amos.5.15","start":30005015,"end":30005015,"break":"line","breaks":[[19,"line"],[31,"line"]],"ruby":[[0,1,"あく"],[2,1,"にく"],[5,1,"ぜん"],[7,1,"あい"],[10,1,"もん"],[12,2,"こうぎ"],[15,1,"た"],[19,2,"ばんぐん"],[22,1,"かみ"],[24,1,"しゅ"],[35,1,"のこ"],[38,1,"もの"]],"text":"悪を憎み、善を愛し、門で公義を立てよ。万軍の神、主は、あるいはヨセフの残りの者をあわれまれるであろう。"},{"ref":"Amos.5.16","start":30005016,"end":30005016,"break":"stanza","breaks":[[13,"line"],[22,"line"],[39,"line"],[50,"line"],[67,"line"],[84,"line"]],"ruby":[[5,1,"しゅ"],[8,2,"ばんぐん"],[11,1,"かみ"],[13,1,"しゅ"],[17,1,"い"],[27,2,"ひろば"],[30,1,"な"],[47,2,"ひとびと"],[51,1,"かな"],[57,1,"かな"],[64,1,"い"],[69,1,"かれ"],[72,2,"のうふ"],[75,1,"よ"],[80,1,"なげ"],[84,1,"たく"],[87,1,"な"],[89,1,"おんな"],[91,1,"まね"],[94,1,"な"]],"text":"それゆえ、主なる万軍の神、主はこう言われる、「すべての広場で泣くことがあろう。すべてのちまたで人々は『悲しいかな、悲しいかな』と言う。また彼らは農夫を呼んできて嘆かせ、巧みな泣き女を招いて泣かせ、"},{"ref":"Amos.5.17","start":30005017,"end":30005017,"break":"line","breaks":[[21,"line"],[36,"line"]],"ruby":[[9,1,"はたけ"],[12,1,"な"],[34,1,"なか"],[36,1,"とお"],[45,1,"しゅ"],[47,1,"い"]],"text":"またすべてのぶどう畑にも泣くことがあろう。それはわたしがあなたがたの中を通るからである」と主は言われる。"},{"ref":"Amos.5.18","start":30005018,"end":30005018,"break":"stanza","breaks":[[18,"line"],[36,"line"]],"ruby":[[9,1,"しゅ"],[11,1,"ひ"],[13,1,"のぞ"],[15,1,"もの"],[24,1,"なに"],[27,1,"しゅ"],[29,1,"ひ"],[31,1,"のぞ"],[39,1,"くら"],[42,1,"ひかり"]],"text":"わざわいなるかな、主の日を望む者よ、あなたがたは何ゆえ主の日を望むのか。これは暗くて光がない。"},{"ref":"Amos.5.19","start":30005019,"end":30005019,"break":"line","breaks":[[18,"line"],[36,"line"]],"ruby":[[0,1,"ひと"],[5,1,"まえ"],[7,1,"のが"],[14,2,"であ"],[20,1,"いえ"],[27,1,"て"],[29,1,"かべ"]],"text":"人がししの前を逃れてもくまに出会い、また家にはいって、手を壁につけると、へびにかまれるようなものである。"},{"ref":"Amos.5.20","start":30005020,"end":30005020,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ひ"],[4,1,"くら"],[8,1,"ひかり"],[13,2,"うすぐら"],[17,1,"かがや"]],"text":"主の日は暗くて、光がなく、薄暗くて輝きがないではないか。"},{"ref":"Amos.5.21","start":30005021,"end":30005021,"break":"stanza","breaks":[[22,"line"]],"ruby":[[10,1,"まつり"],[12,1,"にく"],[17,1,"いや"],[35,1,"せい"],[36,1,"かい"],[38,1,"よろこ"]],"text":"わたしはあなたがたの祭を憎み、かつ卑しめる。わたしはまた、あなたがたの聖会を喜ばない。"},{"ref":"Amos.5.22","start":30005022,"end":30005022,"break":"line","breaks":[[21,"line"],[35,"line"],[50,"line"]],"ruby":[[9,2,"はんさい"],[12,2,"そさい"],[28,1,"う"],[41,1,"こ"],[44,1,"けもの"],[46,3,"しゅうおんさい"],[57,1,"かえり"]],"text":"たといあなたがたは燔祭や素祭をささげても、わたしはこれを受けいれない。あなたがたの肥えた獣の酬恩祭はわたしはこれを顧みない。"},{"ref":"Amos.5.23","start":30005023,"end":30005023,"break":"line","breaks":[[14,"line"],[24,"line"]],"ruby":[[6,1,"うた"],[8,1,"さわ"],[12,1,"おと"],[18,1,"まえ"],[21,1,"た"],[30,1,"こと"],[32,1,"おと"],[42,1,"き"]],"text":"あなたがたの歌の騒がしい音をわたしの前から断て。あなたがたの琴の音は、わたしはこれを聞かない。"},{"ref":"Amos.5.24","start":30005024,"end":30005024,"break":"line","breaks":[[9,"line"]],"ruby":[[0,2,"こうどう"],[3,1,"みず"],[9,2,"せいぎ"],[16,1,"かわ"],[21,1,"なが"]],"text":"公道を水のように、正義をつきない川のように流れさせよ。"},{"ref":"Amos.5.25","start":30005025,"end":30005025,"break":"none","ruby":[[7,1,"いえ"],[18,1,"ねん"],[20,1,"あいだ"],[22,2,"あらの"],[29,2,"ぎせい"],[32,1,"そな"],[34,1,"もの"]],"text":"「イスラエルの家よ、あなたがたは四十年の間、荒野でわたしに犠牲と供え物をささげたか。"},{"ref":"Amos.5.26","start":30005026,"end":30005026,"break":"none","ruby":[[10,1,"おう"],[25,2,"じぶん"],[28,1,"つく"],[37,2,"ぐうぞう"],[40,1,"ほし"],[42,1,"かみ"]],"text":"かえってあなたがたの王シクテをにない、あなたがたが自分で作ったあなたがたの偶像、星の神、キウンをになった。"},{"ref":"Amos.5.27","start":30005027,"end":30005027,"break":"none","ruby":[[23,1,"とら"],[25,1,"うつ"],[32,1,"な"],[34,2,"ばんぐん"],[37,1,"かみ"],[45,1,"しゅ"],[47,1,"い"]],"text":"それゆえわたしはあなたがたをダマスコのかなたに捕え移す」と、その名を万軍の神ととなえられる主は言われる。"}]