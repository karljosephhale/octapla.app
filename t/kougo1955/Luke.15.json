[{"ref":"Luke.15.1","start":42015001,"end":42015001,"break":"paragraph","ruby":[[3,3,"しゅぜいにん"],[7,2,"つみびと"],[12,1,"みな"],[18,1,"はなし"],[20,1,"き"],[26,2,"ちかよ"]],"text":"さて、取税人や罪人たちが皆、イエスの話を聞こうとして近寄ってきた。"},{"ref":"Luke.15.2","start":42015002,"end":42015002,"break":"none","ruby":[[7,1,"びと"],[9,2,"りっぽう"],[11,2,"がくしゃ"],[25,1,"ひと"],[27,2,"つみびと"],[32,1,"むか"],[35,2,"いっしょ"],[38,2,"しょくじ"],[47,1,"い"]],"text":"するとパリサイ人や律法学者たちがつぶやいて、「この人は罪人たちを迎えて一緒に食事をしている」と言った。"},{"ref":"Luke.15.3","start":42015003,"end":42015003,"break":"none","ruby":[[7,1,"かれ"],[13,1,"たとえ"],[16,1,"はな"]],"text":"そこでイエスは彼らに、この譬をお話しになった、"},{"ref":"Luke.15.4","start":42015004,"end":42015004,"break":"none","ruby":[[12,1,"ぴき"],[14,1,"ひつじ"],[16,1,"も"],[21,1,"もの"],[32,1,"ぴき"],[45,1,"ひき"],[47,2,"のはら"],[50,1,"のこ"],[64,1,"ぴき"],[66,1,"み"],[73,1,"さが"],[75,1,"ある"]],"text":"「あなたがたのうちに、百匹の羊を持っている者がいたとする。その一匹がいなくなったら、九十九匹を野原に残しておいて、いなくなった一匹を見つけるまでは捜し歩かないであろうか。"},{"ref":"Luke.15.5","start":42015005,"end":42015005,"break":"none","ruby":[[3,1,"み"],[9,1,"よろこ"],[15,2,"じぶん"],[18,1,"かた"],[20,1,"の"]],"text":"そして見つけたら、喜んでそれを自分の肩に乗せ、"},{"ref":"Luke.15.6","start":42015006,"end":42015006,"break":"none","ruby":[[0,1,"いえ"],[2,1,"かえ"],[7,2,"ゆうじん"],[10,1,"とな"],[12,1,"びと"],[14,1,"よ"],[16,1,"あつ"],[24,2,"いっしょ"],[27,1,"よろこ"],[41,1,"ひつじ"],[43,1,"み"],[53,1,"い"]],"text":"家に帰ってきて友人や隣り人を呼び集め、『わたしと一緒に喜んでください。いなくなった羊を見つけましたから』と言うであろう。"},{"ref":"Luke.15.7","start":42015007,"end":42015007,"break":"none","ruby":[[2,1,"き"],[11,1,"おな"],[17,2,"つみびと"],[25,1,"く"],[27,1,"あらた"],[33,2,"くいあらた"],[37,2,"ひつよう"],[46,1,"にん"],[48,1,"ただ"],[51,1,"ひと"],[60,1,"おお"],[69,1,"てん"]],"text":"よく聞きなさい。それと同じように、罪人がひとりでも悔い改めるなら、悔改めを必要としない九十九人の正しい人のためにもまさる大きいよろこびが、天にあるであろう。"},{"ref":"Luke.15.8","start":42015008,"end":42015008,"break":"paragraph","ruby":[[5,1,"おんな"],[7,2,"ぎんか"],[10,1,"まい"],[12,1,"も"],[23,1,"まい"],[34,2,"かのじょ"],[44,2,"いえじゅう"],[47,1,"は"],[53,1,"み"],[60,3,"ちゅういぶか"],[64,1,"さが"]],"text":"また、ある女が銀貨十枚を持っていて、もしその一枚をなくしたとすれば、彼女はあかりをつけて家中を掃き、それを見つけるまでは注意深く捜さないであろうか。"},{"ref":"Luke.15.9","start":42015009,"end":42015009,"break":"none","ruby":[[4,1,"み"],[11,1,"おんな"],[12,1,"とも"],[16,2,"きんじょ"],[19,1,"おんな"],[23,1,"よ"],[25,1,"あつ"],[34,2,"いっしょ"],[37,1,"よろこ"],[49,2,"ぎんか"],[52,1,"み"],[63,1,"い"]],"text":"そして、見つけたなら、女友だちや近所の女たちを呼び集めて、『わたしと一緒に喜んでください。なくした銀貨が見つかりましたから』と言うであろう。"},{"ref":"Luke.15.10","start":42015010,"end":42015010,"break":"none","ruby":[[2,1,"き"],[11,1,"おな"],[17,2,"つみびと"],[25,1,"く"],[27,1,"あらた"],[33,1,"かみ"],[35,2,"みつかい"],[40,1,"まえ"]],"text":"よく聞きなさい。それと同じように、罪人がひとりでも悔い改めるなら、神の御使たちの前でよろこびがあるであろう」。"},{"ref":"Luke.15.11","start":42015011,"end":42015011,"break":"paragraph","ruby":[[2,1,"い"],[10,1,"ひと"]],"text":"また言われた、「ある人に、ふたりのむすこがあった。"},{"ref":"Luke.15.12","start":42015012,"end":42015012,"break":"none","ruby":[[5,1,"おとうと"],[7,2,"ちちおや"],[10,1,"い"],[15,1,"ちち"],[22,2,"ざいさん"],[36,1,"ぶん"],[48,1,"ちち"],[52,2,"しんだい"],[59,1,"わ"]],"text":"ところが、弟が父親に言った、『父よ、あなたの財産のうちでわたしがいただく分をください』。そこで、父はその身代をふたりに分けてやった。"},{"ref":"Luke.15.13","start":42015013,"end":42015013,"break":"none","ruby":[[4,2,"いくにち"],[15,1,"おとうと"],[17,2,"じぶん"],[23,2,"ぜんぶ"],[31,1,"とお"],[33,1,"ところ"],[35,1,"い"],[41,2,"ほうとう"],[44,1,"み"],[46,1,"も"],[52,2,"ざいさん"],[55,1,"つか"],[57,1,"はた"]],"text":"それから幾日もたたないうちに、弟は自分のものを全部とりまとめて遠い所へ行き、そこで放蕩に身を持ちくずして財産を使い果した。"},{"ref":"Luke.15.14","start":42015014,"end":42015014,"break":"none","ruby":[[0,1,"なに"],[4,2,"ろうひ"],[17,2,"ちほう"],[33,1,"かれ"],[35,1,"た"],[42,1,"きゅう"]],"text":"何もかも浪費してしまったのち、その地方にひどいききんがあったので、彼は食べることにも窮しはじめた。"},{"ref":"Luke.15.15","start":42015015,"end":42015015,"break":"none","ruby":[[6,2,"ちほう"],[11,2,"じゅうみん"],[18,1,"い"],[21,1,"み"],[23,1,"よ"],[33,1,"ひと"],[35,1,"かれ"],[37,1,"はたけ"],[42,1,"ぶた"],[44,1,"か"]],"text":"そこで、その地方のある住民のところに行って身を寄せたところが、その人は彼を畑にやって豚を飼わせた。"},{"ref":"Luke.15.16","start":42015016,"end":42015016,"break":"none","ruby":[[0,1,"かれ"],[3,1,"ぶた"],[5,1,"た"],[11,1,"まめ"],[13,1,"はら"],[15,1,"み"],[21,1,"おも"],[31,1,"なに"],[36,1,"ひと"]],"text":"彼は、豚の食べるいなご豆で腹を満たしたいと思うほどであったが、何もくれる人はなかった。"},{"ref":"Luke.15.17","start":42015017,"end":42015017,"break":"none","ruby":[[3,1,"かれ"],[5,2,"ほんしん"],[8,1,"た"],[14,1,"い"],[19,1,"ちち"],[26,2,"しょくもつ"],[31,1,"あま"],[36,2,"やといにん"],[39,1,"おお"],[54,1,"う"],[57,1,"し"]],"text":"そこで彼は本心に立ちかえって言った、『父のところには食物のあり余っている雇人が大ぜいいるのに、わたしはここで飢えて死のうとしている。"},{"ref":"Luke.15.18","start":42015018,"end":42015018,"break":"none","ruby":[[0,1,"た"],[4,1,"ちち"],[10,1,"かえ"],[16,1,"い"],[20,1,"ちち"],[27,1,"てん"],[29,1,"たい"],[44,1,"つみ"],[46,1,"おか"]],"text":"立って、父のところへ帰って、こう言おう、父よ、わたしは天に対しても、あなたにむかっても、罪を犯しました。"},{"ref":"Luke.15.19","start":42015019,"end":42015019,"break":"none","ruby":[[11,1,"よ"],[15,2,"しかく"],[28,2,"やといにん"],[34,2,"どうよう"]],"text":"もう、あなたのむすこと呼ばれる資格はありません。どうぞ、雇人のひとり同様にしてください』。"},{"ref":"Luke.15.20","start":42015020,"end":42015020,"break":"none","ruby":[[3,1,"た"],[7,1,"ちち"],[13,1,"で"],[20,1,"とお"],[22,1,"はな"],[30,1,"ちち"],[32,1,"かれ"],[38,1,"あわ"],[41,1,"おも"],[44,1,"はし"],[46,1,"よ"],[51,1,"くび"],[56,2,"せっぷん"]],"text":"そこで立って、父のところへ出かけた。まだ遠く離れていたのに、父は彼をみとめ、哀れに思って走り寄り、その首をだいて接吻した。"},{"ref":"Luke.15.21","start":42015021,"end":42015021,"break":"none","ruby":[[4,1,"ちち"],[6,1,"い"],[11,1,"ちち"],[18,1,"てん"],[20,1,"たい"],[35,1,"つみ"],[37,1,"おか"],[53,1,"よ"],[57,2,"しかく"]],"text":"むすこは父に言った、『父よ、わたしは天に対しても、あなたにむかっても、罪を犯しました。もうあなたのむすこと呼ばれる資格はありません』。"},{"ref":"Luke.15.22","start":42015022,"end":42015022,"break":"none","ruby":[[3,1,"ちち"],[5,1,"しもべ"],[9,1,"い"],[19,1,"はや"],[22,2,"さいじょう"],[25,2,"きもの"],[28,1,"だ"],[35,1,"こ"],[37,1,"き"],[40,2,"ゆびわ"],[43,1,"て"],[53,1,"あし"]],"text":"しかし父は僕たちに言いつけた、『さあ、早く、最上の着物を出してきてこの子に着せ、指輪を手にはめ、はきものを足にはかせなさい。"},{"ref":"Luke.15.23","start":42015023,"end":42015023,"break":"none","ruby":[[3,1,"こ"],[6,1,"こ"],[7,1,"うし"],[9,1,"ひ"],[21,1,"た"],[24,1,"たの"]],"text":"また、肥えた子牛を引いてきてほふりなさい。食べて楽しもうではないか。"},{"ref":"Luke.15.24","start":42015024,"end":42015024,"break":"none","ruby":[[6,1,"し"],[13,1,"い"],[15,1,"かえ"],[28,1,"み"],[43,2,"しゅくえん"]],"text":"このむすこが死んでいたのに生き返り、いなくなっていたのに見つかったのだから』。それから祝宴がはじまった。"},{"ref":"Luke.15.25","start":42015025,"end":42015025,"break":"none","ruby":[[5,1,"あに"],[7,1,"はたけ"],[13,1,"かえ"],[18,1,"いえ"],[20,1,"ちか"],[25,2,"おんがく"],[28,1,"おど"],[31,1,"おと"],[33,1,"きこ"]],"text":"ところが、兄は畑にいたが、帰ってきて家に近づくと、音楽や踊りの音が聞えたので、"},{"ref":"Luke.15.26","start":42015026,"end":42015026,"break":"none","ruby":[[4,1,"しもべ"],[6,1,"よ"],[19,2,"なにごと"],[26,1,"たず"]],"text":"ひとりの僕を呼んで、『いったい、これは何事なのか』と尋ねた。"},{"ref":"Luke.15.27","start":42015027,"end":42015027,"break":"none","ruby":[[0,1,"しもべ"],[2,1,"こた"],[12,2,"きょうだい"],[16,1,"かえ"],[25,2,"ぶじ"],[28,1,"むか"],[37,2,"ちちうえ"],[40,1,"こ"],[43,1,"こ"],[44,1,"うし"]],"text":"僕は答えた、『あなたのご兄弟がお帰りになりました。無事に迎えたというので、父上が肥えた子牛をほふらせなさったのです』。"},{"ref":"Luke.15.28","start":42015028,"end":42015028,"break":"none","ruby":[[0,1,"あに"],[6,1,"いえ"],[21,1,"ちち"],[23,1,"で"]],"text":"兄はおこって家にはいろうとしなかったので、父が出てきてなだめると、"},{"ref":"Luke.15.29","start":42015029,"end":42015029,"break":"none","ruby":[[0,1,"あに"],[2,1,"ちち"],[8,1,"い"],[17,1,"なん"],[19,1,"ねん"],[25,1,"つか"],[30,1,"ど"],[37,1,"い"],[56,1,"とも"],[60,1,"たの"],[66,1,"こ"],[70,1,"ぴき"],[72,1,"くだ"]],"text":"兄は父にむかって言った、『わたしは何か年もあなたに仕えて、一度でもあなたの言いつけにそむいたことはなかったのに、友だちと楽しむために子やぎ一匹も下さったことはありません。"},{"ref":"Luke.15.30","start":42015030,"end":42015030,"break":"none","ruby":[[6,2,"ゆうじょ"],[11,2,"いっしょ"],[22,2,"しんだい"],[25,1,"く"],[37,1,"こ"],[39,1,"かえ"],[51,1,"こ"],[54,1,"こ"],[55,1,"うし"]],"text":"それだのに、遊女どもと一緒になって、あなたの身代を食いつぶしたこのあなたの子が帰ってくると、そのために肥えた子牛をほふりなさいました』。"},{"ref":"Luke.15.31","start":42015031,"end":42015031,"break":"none","ruby":[[3,1,"ちち"],[5,1,"い"],[10,1,"こ"],[24,2,"いっしょ"],[40,2,"ぜんぶ"]],"text":"すると父は言った、『子よ、あなたはいつもわたしと一緒にいるし、またわたしのものは全部あなたのものだ。"},{"ref":"Luke.15.32","start":42015032,"end":42015032,"break":"none","ruby":[[10,1,"おとうと"],[13,1,"し"],[20,1,"い"],[22,1,"かえ"],[35,1,"み"],[45,1,"よろこ"],[47,1,"いわ"]],"text":"しかし、このあなたの弟は、死んでいたのに生き返り、いなくなっていたのに見つかったのだから、喜び祝うのはあたりまえである』」。"}]