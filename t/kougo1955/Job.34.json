[{"ref":"Job.34.1","start":18034001,"end":18034001,"break":"paragraph","ruby":[[6,1,"こた"],[9,1,"い"]],"text":"エリフはまた答えて言った、"},{"ref":"Job.34.2","start":18034002,"end":18034002,"break":"stanza","breaks":[[24,"line"]],"ruby":[[6,2,"ちえ"],[10,2,"ひとびと"],[18,2,"ことば"],[21,1,"き"],[29,2,"ちしき"],[33,2,"ひとびと"],[41,1,"みみ"],[43,1,"かたむ"]],"text":"「あなたがた知恵ある人々よ、わたしの言葉を聞け、あなたがた知識ある人々よ、わたしに耳を傾けよ。"},{"ref":"Job.34.3","start":18034003,"end":18034003,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"くち"],[2,2,"しょくもつ"],[5,1,"あじ"],[12,1,"みみ"],[14,2,"ことば"]],"text":"口が食物を味わうように、耳は言葉をわきまえるからだ。"},{"ref":"Job.34.4","start":18034004,"end":18034004,"break":"line","breaks":[[13,"line"],[24,"line"]],"ruby":[[5,1,"ただ"],[8,1,"こと"],[10,1,"えら"],[18,1,"あいだ"],[20,1,"よ"],[22,1,"こと"],[24,1,"なに"],[30,1,"あき"]],"text":"われわれは正しい事を選び、われわれの間に良い事の何であるかを明らかにしよう。"},{"ref":"Job.34.5","start":18034005,"end":18034005,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"い"],[12,1,"ただ"],[16,1,"かみ"],[22,2,"こうぎ"],[25,1,"うば"]],"text":"ヨブは言った、『わたしは正しい、神はわたしの公義を奪われた。"},{"ref":"Job.34.6","start":18034006,"end":18034006,"break":"line","breaks":[[23,"line"],[38,"line"]],"ruby":[[4,1,"ただ"],[15,1,"いつわ"],[17,1,"もの"],[42,1,"や"],[43,1,"きず"]],"text":"わたしは正しいにもかかわらず、偽る者とされた。わたしにはとががないけれども、わたしの矢傷はいえない』と。"},{"ref":"Job.34.7","start":18034007,"end":18034007,"break":"line","breaks":[[15,"line"]],"ruby":[[9,1,"ひと"],[15,1,"かれ"],[22,1,"みず"],[27,1,"の"]],"text":"だれかヨブのような人があろう。彼はあざけりを水のように飲み、"},{"ref":"Job.34.8","start":18034008,"end":18034008,"break":"line","ruby":[[0,1,"あく"],[4,1,"もの"],[8,1,"まじ"],[12,2,"あくにん"],[15,1,"とも"],[17,1,"あゆ"]],"text":"悪をなす者どもと交わり、悪人と共に歩む。"},{"ref":"Job.34.9","start":18034009,"end":18034009,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[2,1,"い"],[7,1,"ひと"],[9,1,"かみ"],[11,1,"した"],[20,1,"えき"]],"text":"彼は言った、『人は神と親しんでも、なんの益もない』と。"},{"ref":"Job.34.10","start":18034010,"end":18034010,"break":"stanza","breaks":[[23,"line"],[37,"line"]],"ruby":[[8,2,"りかい"],[12,2,"ひとびと"],[20,1,"き"],[23,1,"かみ"],[25,1,"だん"],[28,1,"あく"],[30,1,"おこな"],[37,3,"ぜんのうしゃ"],[41,1,"だん"],[44,2,"ふぎ"],[47,1,"おこな"]],"text":"それであなたがた理解ある人々よ、わたしに聞け、神は断じて悪を行うことなく、全能者は断じて不義を行うことはない。"},{"ref":"Job.34.11","start":18034011,"end":18034011,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[0,1,"かみ"],[2,1,"ひと"],[14,1,"み"],[16,1,"むく"],[24,1,"みち"],[34,1,"み"],[36,1,"ふ"]],"text":"神は人のわざにしたがってその身に報い、おのおのの道にしたがって、その身に振りかからせられる。"},{"ref":"Job.34.12","start":18034012,"end":18034012,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"かみ"],[6,1,"あ"],[9,1,"こと"],[11,1,"おこな"],[17,3,"ぜんのうしゃ"]],"text":"まことに神は悪しき事を行われない。全能者はさばきをまげられない。"},{"ref":"Job.34.13","start":18034013,"end":18034013,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"ち"],[7,1,"かれ"],[13,1,"もの"],[22,1,"ぜん"],[23,2,"せかい"],[26,1,"かれ"],[28,1,"お"],[32,1,"もの"]],"text":"だれかこの地を彼にゆだねた者があるか。だれか全世界を彼に負わせた者があるか。"},{"ref":"Job.34.14","start":18034014,"end":18034014,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[6,1,"れい"],[9,2,"じぶん"],[12,1,"と"],[20,1,"いき"],[23,2,"じぶん"],[26,1,"と"]],"text":"神がもしその霊をご自分に取りもどし、その息をご自分に取りあつめられるならば、"},{"ref":"Job.34.15","start":18034015,"end":18034015,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"にく"],[6,1,"とも"],[8,1,"ほろ"],[11,1,"ひと"],[16,1,"かえ"]],"text":"すべての肉は共に滅び、人はちりに帰るであろう。"},{"ref":"Job.34.16","start":18034016,"end":18034016,"break":"stanza","breaks":[[22,"line"]],"ruby":[[7,1,"さと"],[19,1,"き"],[26,1,"い"],[32,1,"みみ"],[34,1,"かたむ"]],"text":"もし、あなたに悟りがあるならば、これを聞け、わたしの言うところに耳を傾けよ。"},{"ref":"Job.34.17","start":18034017,"end":18034017,"break":"line","breaks":[[21,"line"]],"ruby":[[0,2,"こうぎ"],[3,1,"にく"],[5,1,"もの"],[7,1,"よ"],[9,1,"おさ"],[21,1,"ただ"],[24,1,"ちから"],[27,1,"もの"],[34,2,"ひなん"]],"text":"公義を憎む者は世を治めることができようか。正しく力ある者を、あなたは非難するであろうか。"},{"ref":"Job.34.18","start":18034018,"end":18034018,"break":"line","breaks":[[21,"line"],[40,"line"]],"ruby":[[0,1,"おう"],[3,1,"もの"],[5,1,"む"],[15,1,"もの"],[18,1,"い"],[26,1,"もの"],[28,1,"む"],[34,1,"あ"],[37,1,"もの"],[40,1,"い"]],"text":"王たる者に向かって『よこしまな者』と言い、つかさたる者に向かって、『悪しき者』と言うことができるであろうか。"},{"ref":"Job.34.19","start":18034019,"end":18034019,"break":"line","breaks":[[21,"line"],[35,"line"],[46,"line"]],"ruby":[[0,1,"かみ"],[2,1,"くん"],[5,1,"もの"],[12,1,"み"],[21,1,"と"],[24,1,"もの"],[26,1,"まず"],[29,1,"もの"],[35,1,"かえり"],[46,1,"かれ"],[49,1,"みな"],[51,1,"て"]],"text":"神は君たる者をもかたより見られることなく、富める者を貧しき者にまさって顧みられることはない。彼らは皆み手のわざだからである。"},{"ref":"Job.34.20","start":18034020,"end":18034020,"break":"line","breaks":[[12,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[7,1,"ま"],[9,1,"し"],[12,1,"たみ"],[14,1,"よる"],[16,1,"あいだ"],[18,1,"ふ"],[23,1,"き"],[28,1,"ちから"],[31,1,"もの"],[33,2,"ひとで"],[40,1,"のぞ"]],"text":"彼らはまたたく間に死に、民は夜の間に振われて、消えうせ、力ある者も人手によらずに除かれる。"},{"ref":"Job.34.21","start":18034021,"end":18034021,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[2,1,"め"],[4,1,"ひと"],[6,1,"みち"],[8,1,"うえ"],[20,1,"あゆ"],[23,1,"み"]],"text":"神の目が人の道の上にあって、そのすべての歩みを見られるからだ。"},{"ref":"Job.34.22","start":18034022,"end":18034022,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"あく"],[2,1,"おこな"],[4,1,"もの"],[7,1,"み"],[9,1,"かく"],[13,1,"くら"],[20,2,"あんこく"]],"text":"悪を行う者には身を隠すべき暗やみもなく、暗黒もない。"},{"ref":"Job.34.23","start":18034023,"end":18034023,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ひと"],[9,1,"かみ"],[11,1,"まえ"],[13,1,"で"],[18,1,"かみ"],[20,1,"ひと"],[25,1,"とき"],[27,1,"さだ"]],"text":"人がさばきのために神の前に出るとき、神は人のために時を定めておかれない。"},{"ref":"Job.34.24","start":18034024,"end":18034024,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ちから"],[5,1,"もの"],[8,1,"しら"],[15,1,"う"],[17,1,"ほろ"],[21,1,"た"],[23,2,"ひとびと"],[26,1,"た"],[33,1,"か"]],"text":"彼は力ある者をも調べることなく打ち滅ぼし、他の人々を立てて、これに替えられる。"},{"ref":"Job.34.25","start":18034025,"end":18034025,"break":"line","breaks":[[17,"line"],[34,"line"]],"ruby":[[6,1,"かみ"],[8,1,"かれ"],[14,1,"し"],[17,1,"よ"],[19,1,"ま"],[21,1,"かれ"],[34,1,"かれ"],[40,1,"ほろ"]],"text":"このように、神は彼らのわざを知り、夜の間に彼らをくつがえされるので、彼らはやがて滅びる。"},{"ref":"Job.34.26","start":18034026,"end":18034026,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"かれ"],[2,2,"ひとびと"],[5,1,"み"],[7,1,"ところ"],[10,1,"かれ"],[15,1,"あく"],[20,1,"う"]],"text":"彼は人々の見る所で、彼らをその悪のために撃たれる。"},{"ref":"Job.34.27","start":18034027,"end":18034027,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"かれ"],[10,1,"かれ"],[12,1,"したが"],[18,1,"みち"],[20,1,"まった"],[22,1,"かえり"]],"text":"これは彼らがそむいて彼に従わず、その道を全く顧みないからだ。"},{"ref":"Job.34.28","start":18034028,"end":18034028,"break":"line","breaks":[[15,"line"],[25,"line"]],"ruby":[[4,1,"かれ"],[7,1,"まず"],[10,1,"もの"],[12,1,"さけ"],[15,1,"かれ"],[25,1,"なや"],[28,1,"もの"],[30,1,"さけ"],[33,1,"かれ"],[35,1,"き"]],"text":"こうして彼らは貧しき者の叫びを彼のもとにいたらせ、悩める者の叫びを彼に聞かせる。"},{"ref":"Job.34.29","start":18034029,"end":18034029,"break":"line","breaks":[[12,"line"],[28,"line"],[39,"line"],[55,"line"]],"ruby":[[0,1,"かれ"],[2,1,"だま"],[15,2,"ひなん"],[28,1,"かれ"],[30,1,"かお"],[32,1,"かく"],[42,1,"かれ"],[44,1,"み"],[56,1,"こく"],[58,1,"うえ"],[63,1,"にん"],[65,1,"うえ"],[68,2,"どうよう"]],"text":"彼が黙っておられるとき、だれが非難することができようか。彼が顔を隠されるとき、だれが彼を見ることができようか。一国の上にも、一人の上にも同様だ。"},{"ref":"Job.34.30","start":18034030,"end":18034030,"break":"line","breaks":[[22,"line"]],"ruby":[[3,1,"かみ"],[5,1,"しん"],[9,1,"もの"],[11,1,"よ"],[13,1,"おさ"],[22,1,"たみ"],[30,1,"こと"]],"text":"これは神を信じない者が世を治めることがなく、民をわなにかける事のないようにするためである。"},{"ref":"Job.34.31","start":18034031,"end":18034031,"break":"stanza","breaks":[[14,"line"]],"ruby":[[3,1,"かみ"],[5,1,"む"],[9,1,"い"],[19,1,"つみ"],[21,1,"おか"],[28,1,"こら"]],"text":"だれが神に向かって言ったか、『わたしは罪を犯さないのに、懲しめられた。"},{"ref":"Job.34.32","start":18034032,"end":18034032,"break":"line","breaks":[[21,"line"],[36,"line"]],"ruby":[[4,1,"み"],[14,1,"おし"],[27,1,"わる"],[29,1,"こと"],[36,1,"かさ"]],"text":"わたしの見ないものをわたしに教えられたい。もしわたしが悪い事をしたなら、重ねてこれをしない』と。"},{"ref":"Job.34.33","start":18034033,"end":18034033,"break":"line","breaks":[[10,"line"],[33,"line"],[54,"line"]],"ruby":[[4,1,"こば"],[10,1,"かれ"],[16,1,"この"],[21,1,"むく"],[40,1,"えら"],[58,1,"し"],[64,1,"い"]],"text":"あなたが拒むゆえに、彼はあなたの好むように報いをされるであろうか。あなたみずから選ぶがよい、わたしはしない。あなたの知るところを言いなさい。"},{"ref":"Job.34.34","start":18034034,"end":18034034,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"さと"],[4,2,"ひとびと"],[11,1,"い"],[21,1,"き"],[27,2,"ちえ"],[31,1,"ひと"],[33,1,"い"]],"text":"悟りある人々はわたしに言うだろう、わたしに聞くところの知恵ある人は言うだろう、"},{"ref":"Job.34.35","start":18034035,"end":18034035,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"い"],[10,2,"ちしき"],[18,2,"ことば"],[21,1,"さと"]],"text":"『ヨブの言うところは知識がなく、その言葉は悟りがない』と。"},{"ref":"Job.34.36","start":18034036,"end":18034036,"break":"line","breaks":[[19,"line"]],"ruby":[[6,1,"おわ"],[10,1,"こころ"],[19,1,"かれ"],[21,2,"あくにん"],[27,1,"こた"]],"text":"どうかヨブが終りまで試みられるように、彼は悪人のように答えるからである。"},{"ref":"Job.34.37","start":18034037,"end":18034037,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[2,2,"じぶん"],[5,1,"つみ"],[11,1,"くわ"],[19,1,"なか"],[24,1,"て"],[29,1,"かみ"],[31,1,"さか"],[38,2,"ことば"]],"text":"彼は自分の罪に、とがを加え、われわれの中にあって手をうち、神に逆らって、その言葉をしげくする」。"}]