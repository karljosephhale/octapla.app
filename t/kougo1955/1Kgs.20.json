[{"ref":"1Kgs.20.1","start":11020001,"end":11020001,"break":"paragraph","ruby":[[4,1,"おう"],[13,2,"ぐんぜい"],[21,1,"あつ"],[28,1,"にん"],[30,1,"おう"],[32,1,"かれ"],[34,1,"とも"],[41,1,"うま"],[43,2,"せんしゃ"],[50,1,"かれ"],[52,1,"のぼ"],[60,1,"かこ"],[66,1,"せ"]],"text":"スリヤの王ベネハダデはその軍勢をことごとく集めた。三十二人の王が彼と共におり、また馬と戦車もあった。彼は上ってサマリヤを囲み、これを攻めた。"},{"ref":"1Kgs.20.2","start":11020002,"end":11020002,"break":"none","ruby":[[2,1,"かれ"],[4,1,"まち"],[6,2,"ししゃ"],[20,1,"おう"],[25,1,"い"],[38,1,"もう"]],"text":"また彼は町に使者をつかわし、イスラエルの王アハブに言った、「ベネハダデはこう申します、"},{"ref":"1Kgs.20.3","start":11020003,"end":11020003,"break":"none","ruby":[[5,2,"きんぎん"],[21,1,"つま"],[25,2,"こども"],[30,1,"もっと"],[32,1,"うつく"],[35,1,"もの"]],"text":"『あなたの金銀はわたしのもの、またあなたの妻たちと子供たちの最も美しい者もわたしのものです』」。"},{"ref":"1Kgs.20.4","start":11020004,"end":11020004,"break":"none","ruby":[[6,1,"おう"],[8,1,"こた"],[13,1,"おう"],[17,1,"しゅ"],[20,1,"おお"],[36,1,"も"],[38,1,"もの"],[40,1,"みな"]],"text":"イスラエルの王は答えた、「王、わが主よ、仰せのとおり、わたしと、わたしの持ち物は皆あなたのものです」。"},{"ref":"1Kgs.20.5","start":11020005,"end":11020005,"break":"none","ruby":[[0,2,"ししゃ"],[3,1,"ふたた"],[7,1,"い"],[20,1,"もう"],[33,1,"ひと"],[45,2,"きんぎん"],[48,2,"さいし"],[51,1,"ひ"],[57,1,"い"]],"text":"使者は再びきて言った、「ベネハダデはこう申します、『わたしはさきに人をつかわして、あなたの金銀、妻子を引きわたせと言いました。"},{"ref":"1Kgs.20.6","start":11020006,"end":11020006,"break":"none","ruby":[[7,1,"いま"],[28,1,"かれ"],[35,1,"いえ"],[42,2,"けらい"],[45,1,"いえ"],[47,1,"さぐ"],[54,1,"かれ"],[57,1,"き"],[61,1,"もの"],[63,1,"て"],[65,1,"い"],[68,1,"うば"],[70,1,"さ"]],"text":"しかし、あすの今ごろ、しもべたちをあなたにつかわします。彼らはあなたの家と、あなたの家来の家を探って、すべて彼らの気にいる物を手に入れて奪い去るでしょう』」。"},{"ref":"1Kgs.20.7","start":11020007,"end":11020007,"break":"paragraph","ruby":[[9,1,"おう"],[11,1,"くに"],[13,2,"ちょうろう"],[21,1,"め"],[24,1,"い"],[31,2,"ちゅうい"],[38,1,"ひと"],[40,2,"むり"],[43,1,"こと"],[45,1,"もと"],[52,1,"し"],[58,1,"かれ"],[60,1,"ひと"],[72,2,"さいし"],[75,2,"きんぎん"],[78,1,"もと"],[90,1,"こば"]],"text":"そこでイスラエルの王は国の長老をことごとく召して言った、「よく注意して、この人が無理な事を求めているのを知りなさい。彼は人をつかわして、わたしの妻子と金銀を求めたが、わたしはそれを拒まなかった」。"},{"ref":"1Kgs.20.8","start":11020008,"end":11020008,"break":"none","ruby":[[4,2,"ちょうろう"],[9,1,"たみ"],[11,1,"みな"],[12,1,"かれ"],[14,1,"い"],[19,1,"き"],[29,2,"しょうだく"]],"text":"すべての長老および民は皆彼に言った、「聞いてはなりません。承諾してはなりません」。"},{"ref":"1Kgs.20.9","start":11020009,"end":11020009,"break":"none","ruby":[[3,1,"かれ"],[11,2,"ししゃ"],[14,1,"い"],[19,1,"おう"],[23,1,"しゅ"],[25,1,"つ"],[36,1,"はじ"],[39,2,"ようきゅう"],[47,1,"みな"],[59,2,"こんど"],[62,1,"こと"],[72,2,"ししゃ"],[75,1,"さ"],[78,2,"ふくめい"]],"text":"それで彼はベネハダデの使者に言った、「王、わが主に告げなさい。『あなたが初めに要求されたことは皆いたしましょう。しかし今度の事はできません』」。使者は去って復命した。"},{"ref":"1Kgs.20.10","start":11020010,"end":11020010,"break":"none","ruby":[[6,1,"かれ"],[8,1,"ひと"],[15,1,"い"],[35,1,"したが"],[41,1,"たみ"],[43,1,"て"],[45,1,"み"],[49,1,"た"],[56,2,"かみがみ"],[70,1,"ばっ"]],"text":"ベネハダデは彼に人をつかわして言った、「もしサマリヤのちりが、わたしに従うすべての民の手を満たすに足りるならば、神々がどんなにでも、わたしを罰してくださるように」。"},{"ref":"1Kgs.20.11","start":11020011,"end":11020011,"break":"none","ruby":[[6,1,"おう"],[8,1,"こた"],[14,2,"ぶぐ"],[17,1,"お"],[20,1,"もの"],[26,1,"ぬ"],[28,1,"もの"],[33,1,"ほこ"],[43,1,"つ"]],"text":"イスラエルの王は答えた、「『武具を帯びる者は、それを脱ぐ者のように誇ってはならない』と告げなさい」。"},{"ref":"1Kgs.20.12","start":11020012,"end":11020012,"break":"none","ruby":[[6,1,"かり"],[7,2,"ごや"],[11,1,"おう"],[15,1,"さけ"],[17,1,"の"],[26,1,"こと"],[28,1,"き"],[34,2,"けらい"],[39,1,"い"],[44,1,"たたか"],[47,1,"そな"],[54,1,"かれ"],[57,1,"まち"],[63,1,"たたか"],[66,1,"そな"]],"text":"ベネハダデは仮小屋で、王たちと酒を飲んでいたが、この事を聞いて、その家来たちに言った、「戦いの備えをせよ」。彼らは町にむかって戦いの備えをした。"},{"ref":"1Kgs.20.13","start":11020013,"end":11020013,"break":"paragraph","ruby":[[2,1,"とき"],[7,3,"よげんしゃ"],[17,1,"おう"],[27,1,"い"],[32,1,"しゅ"],[36,1,"おお"],[49,2,"たいぐん"],[52,1,"み"],[71,1,"て"],[86,1,"しゅ"],[94,1,"し"]],"text":"この時ひとりの預言者がイスラエルの王アハブのもとにきて言った、「主はこう仰せられる、『あなたはこの大軍を見たか。わたしはきょう、これをあなたの手にわたす。あなたは、わたしが主であることを、知るようになるであろう』」。"},{"ref":"1Kgs.20.14","start":11020014,"end":11020014,"break":"none","ruby":[[4,1,"い"],[21,1,"かれ"],[23,1,"い"],[28,1,"しゅ"],[32,1,"おお"],[39,2,"ちほう"],[42,2,"だいかん"],[45,2,"けらい"],[60,1,"い"],[68,1,"たたか"],[71,1,"はじ"],[80,1,"かれ"],[82,1,"こた"]],"text":"アハブは言った、「だれにさせましょうか」。彼は言った、「主はこう仰せられる、『地方の代官の家来たちにさせよ』」。アハブは言った、「だれが戦いを始めましょうか」。彼は答えた、「あなたです」。"},{"ref":"1Kgs.20.15","start":11020015,"end":11020015,"break":"none","ruby":[[7,2,"ちほう"],[10,2,"だいかん"],[13,2,"けらい"],[18,1,"しら"],[29,1,"にん"],[34,1,"つぎ"],[40,1,"たみ"],[56,1,"ひと"],[58,1,"しら"],[66,1,"にん"]],"text":"そこでアハブは地方の代官の家来たちを調べたところ二百三十二人あった。次にすべての民、すなわちイスラエルのすべての人を調べたところ七千人あった。"},{"ref":"1Kgs.20.16","start":11020016,"end":11020016,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"ひる"],[6,1,"で"],[19,1,"かり"],[20,2,"ごや"],[24,2,"みかた"],[30,1,"にん"],[32,1,"おう"],[36,1,"とも"],[38,1,"さけ"],[40,1,"の"],[43,1,"よ"]],"text":"彼らは昼ごろ出ていったが、ベネハダデは仮小屋で、味方の三十二人の王たちと共に酒を飲んで酔っていた。"},{"ref":"1Kgs.20.17","start":11020017,"end":11020017,"break":"none","ruby":[[0,2,"ちほう"],[3,2,"だいかん"],[6,2,"けらい"],[11,1,"さき"],[13,1,"で"],[25,2,"せっこう"],[35,1,"かれ"],[45,2,"ひとびと"],[48,1,"で"],[54,2,"ほうこく"]],"text":"地方の代官の家来たちが先に出ていった。ベネハダデは斥候をつかわしたが、彼らは「サマリヤから人々が出てきた」と報告したので、"},{"ref":"1Kgs.20.18","start":11020018,"end":11020018,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,2,"わかい"],[13,1,"で"],[24,1,"いけ"],[33,1,"たたか"],[39,1,"で"],[50,1,"いけ"]],"text":"彼は言った、「和解のために出てきたのであっても、生どりにせよ。また戦いのために出てきたのであっても、生どりにせよ」。"},{"ref":"1Kgs.20.19","start":11020019,"end":11020019,"break":"paragraph","ruby":[[0,2,"ちほう"],[3,2,"だいかん"],[6,2,"けらい"],[15,1,"したが"],[17,2,"ぐんぜい"],[20,1,"まち"],[23,1,"で"]],"text":"地方の代官の家来たちと、それに従う軍勢が町から出ていって、"},{"ref":"1Kgs.20.20","start":11020020,"end":11020020,"break":"none","ruby":[[6,2,"あいて"],[9,1,"う"],[11,1,"ころ"],[23,1,"に"],[36,1,"お"],[45,1,"おう"],[52,1,"うま"],[54,1,"の"],[57,2,"きへい"],[60,1,"したが"]],"text":"おのおのその相手を撃ち殺したので、スリヤびとは逃げた。イスラエルはこれを追ったが、スリヤの王ベネハダデは馬に乗り、騎兵を従えてのがれた。"},{"ref":"1Kgs.20.21","start":11020021,"end":11020021,"break":"none","ruby":[[6,1,"おう"],[8,1,"で"],[14,1,"うま"],[16,2,"せんしゃ"],[26,1,"おお"],[35,1,"う"],[37,1,"ころ"]],"text":"イスラエルの王は出ていって、馬と戦車をぶんどり、また大いにスリヤびとを撃ち殺した。"},{"ref":"1Kgs.20.22","start":11020022,"end":11020022,"break":"paragraph","ruby":[[0,1,"とき"],[5,3,"よげんしゃ"],[15,1,"おう"],[22,1,"い"],[27,1,"い"],[31,1,"ちから"],[33,1,"やしな"],[40,1,"こと"],[44,1,"かんが"],[50,2,"らいねん"],[53,1,"はる"],[60,1,"おう"],[71,1,"せ"],[73,1,"のぼ"]],"text":"時に、かの預言者がイスラエルの王のもとにきて言った、「行って、力を養い、なすべき事をよく考えなさい。来年の春にはスリヤの王が、あなたのところに攻め上ってくるからです」。"},{"ref":"1Kgs.20.23","start":11020023,"end":11020023,"break":"paragraph","ruby":[[4,1,"おう"],[6,2,"けらい"],[11,1,"おう"],[13,1,"い"],[18,1,"かれ"],[21,2,"かみがみ"],[24,1,"やま"],[26,1,"かみ"],[31,1,"かれ"],[41,1,"つよ"],[56,2,"へいち"],[59,1,"たたか"],[65,1,"かなら"],[67,1,"かれ"],[72,1,"つよ"]],"text":"スリヤの王の家来たちは王に言った、「彼らの神々は山の神ですから彼らがわれわれよりも強かったのです。もしわれわれが平地で戦うならば、必ず彼らよりも強いでしょう。"},{"ref":"1Kgs.20.24","start":11020024,"end":11020024,"break":"none","ruby":[[10,1,"おう"],[20,2,"ちい"],[24,1,"しりぞ"],[28,2,"そうとく"],[31,1,"お"],[37,1,"かわ"]],"text":"それでこうしなさい。王たちをおのおのその地位から退かせ、総督を置いてそれに代らせなさい。"},{"ref":"1Kgs.20.25","start":11020025,"end":11020025,"break":"none","ruby":[[6,1,"うしな"],[9,2,"ぐんぜい"],[12,1,"ひと"],[15,2,"ぐんぜい"],[18,1,"あつ"],[21,1,"うま"],[23,1,"うま"],[25,2,"せんしゃ"],[28,2,"せんしゃ"],[34,1,"おぎな"],[49,2,"へいち"],[52,1,"たたか"],[57,1,"かなら"],[59,1,"かれ"],[64,1,"つよ"],[72,1,"かれ"],[76,2,"ことば"],[79,1,"き"]],"text":"またあなたが失った軍勢に等しい軍勢を集め、馬は馬、戦車は戦車をもって補いなさい。こうしてわれわれが平地で戦うならば必ず彼らよりも強いでしょう」。彼はその言葉を聞きいれて、そのようにした。"},{"ref":"1Kgs.20.26","start":11020026,"end":11020026,"break":"paragraph","ruby":[[0,1,"はる"],[18,1,"あつ"],[28,1,"たたか"],[38,1,"のぼ"]],"text":"春になって、ベネハダデはスリヤびとを集めて、イスラエルと戦うために、アペクに上ってきた。"},{"ref":"1Kgs.20.27","start":11020027,"end":11020027,"break":"none","ruby":[[6,2,"ひとびと"],[9,2,"しょうしゅう"],[14,2,"りょうしょく"],[17,1,"う"],[20,1,"かれ"],[23,1,"むか"],[25,1,"う"],[30,1,"で"],[41,2,"ひとびと"],[50,1,"ちい"],[53,1,"む"],[59,1,"かれ"],[62,1,"まえ"],[64,2,"じんど"],[78,1,"ち"],[80,1,"み"]],"text":"イスラエルの人々は召集され、糧食を受けて彼らを迎え撃つために出かけた。イスラエルの人々はやぎの二つの小さい群れのように彼らの前に陣取ったが、スリヤびとはその地に満ちていた。"},{"ref":"1Kgs.20.28","start":11020028,"end":11020028,"break":"none","ruby":[[2,1,"とき"],[3,1,"かみ"],[5,1,"ひと"],[16,1,"おう"],[18,1,"い"],[23,1,"しゅ"],[27,1,"おお"],[41,1,"しゅ"],[43,1,"やま"],[45,1,"かみ"],[51,1,"たに"],[53,1,"かみ"],[59,1,"い"],[77,2,"たいぐん"],[84,1,"て"],[99,1,"しゅ"],[106,1,"し"]],"text":"その時神の人がきて、イスラエルの王に言った、「主はこう仰せられる、『スリヤびとが、主は山の神であって、谷の神ではないと言っているから、わたしはこのすべての大軍をあなたの手にわたす。あなたは、わたしが主であることを知るようになるであろう』」。"},{"ref":"1Kgs.20.29","start":11020029,"end":11020029,"break":"none","ruby":[[0,1,"かれ"],[3,2,"なぬか"],[6,1,"あいだ"],[8,1,"たがい"],[16,2,"じんど"],[20,2,"なぬか"],[22,1,"め"],[27,1,"たたか"],[30,1,"まじ"],[41,2,"ひとびと"],[45,1,"にち"],[53,2,"ほへい"],[57,1,"にん"],[59,1,"ころ"]],"text":"彼らは七日の間、互にむかいあって陣取り、七日目になって戦いを交えたが、イスラエルの人々は一日にスリヤびとの歩兵十万人を殺した。"},{"ref":"1Kgs.20.30","start":11020030,"end":11020030,"break":"none","breaks":[[45,"paragraph"]],"ruby":[[5,1,"もの"],[11,1,"まち"],[13,1,"に"],[20,2,"じょうへき"],[30,1,"のこ"],[37,1,"にん"],[39,1,"うえ"],[41,1,"たお"],[51,1,"に"],[54,1,"まち"],[56,1,"はい"],[59,1,"おく"],[61,1,"あいだ"]],"text":"そのほかの者はアペクの町に逃げこんだが、城壁がくずれて、その残った二万七千人の上に倒れた。ベネハダデは逃げて町に入り、奥の間にはいった。"},{"ref":"1Kgs.20.31","start":11020031,"end":11020031,"break":"none","ruby":[[0,2,"けらい"],[5,1,"かれ"],[7,1,"い"],[18,1,"いえ"],[20,1,"おう"],[28,1,"ふか"],[30,1,"おう"],[35,1,"き"],[50,1,"こし"],[52,2,"あらぬの"],[74,1,"おう"],[76,1,"ところ"],[78,1,"い"],[90,1,"かれ"],[96,1,"いのち"],[98,1,"たす"]],"text":"家来たちは彼に言った、「イスラエルの家の王たちはあわれみ深い王であると聞いています。それでわれわれの腰に荒布をつけ、くびになわをかけて、イスラエルの王の所へ行かせてください。たぶん彼はあなたの命を助けるでしょう」。"},{"ref":"1Kgs.20.32","start":11020032,"end":11020032,"break":"none","ruby":[[3,1,"かれ"],[6,2,"あらぬの"],[9,1,"こし"],[29,1,"おう"],[31,1,"ところ"],[33,1,"い"],[36,1,"い"],[63,1,"いのち"],[65,1,"たす"],[74,1,"もう"],[86,1,"い"],[91,1,"かれ"],[95,1,"い"],[105,1,"かれ"],[111,2,"きょうだい"]],"text":"そこで彼らは荒布を腰にまき、なわをくびにかけてイスラエルの王の所へ行って言った、「あなたのしもべベネハダデが『どうぞ、わたしの命を助けてください』と申しています」。アハブは言った、「彼はまだ生きているのですか。彼はわたしの兄弟です」。"},{"ref":"1Kgs.20.33","start":11020033,"end":11020033,"break":"none","ruby":[[2,2,"ひとびと"],[8,2,"きっちょう"],[18,1,"かれ"],[20,2,"ことば"],[42,2,"きょうだい"],[48,1,"い"],[54,1,"かれ"],[56,1,"い"],[61,1,"い"],[64,1,"かれ"],[84,1,"かれ"],[86,1,"ところ"],[88,1,"で"],[95,1,"かれ"],[100,2,"じぶん"],[103,1,"くるま"],[105,1,"の"]],"text":"その人々はこれを吉兆としてすみやかに彼の言葉をうけ、「そうです。ベネハダデはあなたの兄弟です」と言ったので、彼は言った、「行って彼をつれてきなさい」。それでベネハダデは彼の所に出てきたので、彼はこれを自分の車に乗せた。"},{"ref":"1Kgs.20.34","start":11020034,"end":11020034,"break":"none","ruby":[[6,1,"かれ"],[8,1,"い"],[17,1,"ちち"],[24,2,"ちちうえ"],[28,1,"と"],[31,2,"まちまち"],[34,1,"かえ"],[45,1,"ちち"],[52,1,"つく"],[76,2,"しじょう"],[79,1,"もう"],[90,1,"い"],[101,2,"けいやく"],[111,1,"かえ"],[128,1,"かれ"],[130,2,"けいやく"],[133,1,"むす"],[136,1,"かれ"],[138,1,"かえ"]],"text":"ベネハダデは彼に言った、「わたしの父が、あなたの父上から取った町々は返します。またわたしの父がサマリヤに造ったように、あなたはダマスコに、あなたのために市場を設けなさい」。アハブは言った、「わたしはこの契約をもってあなたを帰らせましょう」。こうしてアハブは彼と契約を結び、彼を帰らせた。"},{"ref":"1Kgs.20.35","start":11020035,"end":11020035,"break":"paragraph","ruby":[[2,3,"よげんしゃ"],[15,1,"しゅ"],[17,2,"ことば"],[20,1,"したが"],[25,2,"なかま"],[28,1,"い"],[41,1,"う"],[55,1,"ひと"],[57,1,"う"],[62,1,"こば"]],"text":"さて預言者のともがらのひとりが主の言葉に従ってその仲間に言った、「どうぞ、わたしを撃ってください」。しかしその人は撃つことを拒んだので、"},{"ref":"1Kgs.20.36","start":11020036,"end":11020036,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ひと"],[6,1,"い"],[15,1,"しゅ"],[17,2,"ことば"],[20,1,"き"],[22,1,"したが"],[33,1,"はな"],[36,1,"い"],[49,1,"ころ"],[59,1,"ひと"],[61,1,"かれ"],[66,1,"はな"],[69,1,"い"],[78,1,"かれ"],[80,1,"あ"],[83,1,"かれ"],[85,1,"ころ"]],"text":"彼はその人に言った、「あなたは主の言葉に聞き従わないゆえ、わたしを離れて行くとすぐ、ししがあなたを殺すでしょう」。その人が彼のそばを離れて行くとすぐ、ししが彼に会って彼を殺した。"},{"ref":"1Kgs.20.37","start":11020037,"end":11020037,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ひと"],[9,1,"あ"],[12,1,"い"],[25,1,"う"],[39,1,"ひと"],[41,1,"かれ"],[43,1,"う"],[46,1,"う"],[49,1,"きず"]],"text":"彼はまたほかの人に会って言った、「どうぞ、わたしを撃ってください」。するとその人は彼を撃ち、撃って傷つけた。"},{"ref":"1Kgs.20.38","start":11020038,"end":11020038,"break":"none","ruby":[[6,3,"よげんしゃ"],[10,1,"い"],[14,1,"みち"],[21,1,"おう"],[23,1,"ま"],[26,1,"め"],[33,1,"あ"],[36,1,"すがた"],[38,1,"か"]],"text":"こうしてその預言者は行って、道のかたわらで王を待ち、目にほうたいを当てて姿を変えていた。"},{"ref":"1Kgs.20.39","start":11020039,"end":11020039,"break":"none","ruby":[[0,1,"おう"],[2,1,"とお"],[4,1,"す"],[7,1,"とき"],[9,1,"おう"],[11,1,"よ"],[16,1,"い"],[29,1,"なか"],[31,1,"で"],[33,1,"い"],[42,2,"ぐんじん"],[50,1,"ひと"],[56,1,"ところ"],[63,1,"い"],[72,1,"ひと"],[74,1,"まも"],[84,1,"かれ"],[97,1,"いのち"],[99,1,"かれ"],[101,1,"いのち"],[103,1,"か"],[111,1,"ぎん"],[118,1,"はら"]],"text":"王が通り過ぎる時、王に呼ばわって言った、「しもべはいくさの中に出て行きましたが、ある軍人が、ひとりの人をわたしの所につれてきて言いました、『この人を守っていなさい。もし彼がいなくなれば、あなたの命を彼の命に代えるか、または銀一タラントを払わなければならない』。"},{"ref":"1Kgs.20.40","start":11020040,"end":11020040,"break":"none","ruby":[[16,1,"いそが"],[29,1,"かれ"],[47,1,"おう"],[49,1,"かれ"],[51,1,"い"],[83,2,"じぶん"],[89,1,"さだ"]],"text":"ところが、しもべはあちらこちらと忙しくしていたので、ついに彼はいなくなりました」。イスラエルの王は彼に言った、「あなたはそのとおりにさばかれなければならない。あなたが自分でそれを定めたのです」。"},{"ref":"1Kgs.20.41","start":11020041,"end":11020041,"break":"none","ruby":[[3,1,"かれ"],[5,1,"いそ"],[8,1,"め"],[15,1,"と"],[17,1,"のぞ"],[29,1,"おう"],[34,3,"よげんしゃ"],[47,1,"し"]],"text":"そこで彼が急いで目のほうたいを取り除いたので、イスラエルの王はそれが預言者のひとりであることを知った。"},{"ref":"1Kgs.20.42","start":11020042,"end":11020042,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おう"],[4,1,"い"],[9,1,"しゅ"],[13,1,"おお"],[24,1,"ほろ"],[29,1,"さだ"],[32,1,"ひと"],[39,2,"じぶん"],[42,1,"て"],[45,1,"はな"],[48,1,"い"],[59,1,"いのち"],[61,1,"かれ"],[63,1,"いのち"],[65,1,"かわ"],[72,1,"たみ"],[74,1,"かれ"],[76,1,"たみ"],[78,1,"かわ"]],"text":"彼は王に言った、「主はこう仰せられる、『わたしが滅ぼそうと定めた人を、あなたは自分の手から放して行かせたので、あなたの命は彼の命に代り、あなたの民は彼の民に代るであろう』と」。"},{"ref":"1Kgs.20.43","start":11020043,"end":11020043,"break":"none","ruby":[[6,1,"おう"],[8,1,"かな"],[14,1,"いか"],[17,2,"じぶん"],[20,1,"いえ"],[32,1,"かえ"]],"text":"イスラエルの王は悲しみ、かつ怒って自分の家におもむき、サマリヤに帰った。"}]