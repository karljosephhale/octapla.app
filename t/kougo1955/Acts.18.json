[{"ref":"Acts.18.1","start":44018001,"end":44018001,"break":"paragraph","ruby":[[2,1,"のち"],[12,1,"さ"],[20,1,"い"]],"text":"その後、パウロはアテネを去ってコリントへ行った。"},{"ref":"Acts.18.2","start":44018002,"end":44018002,"break":"none","ruby":[[13,1,"うま"],[19,1,"じん"],[24,1,"つま"],[32,2,"であ"],[42,1,"てい"],[52,1,"じん"],[59,2,"たいきょ"],[69,2,"めいれい"],[76,1,"かれ"],[79,1,"ちか"],[88,1,"で"]],"text":"そこで、アクラというポント生れのユダヤ人と、その妻プリスキラとに出会った。クラウデオ帝が、すべてのユダヤ人をローマから退去させるようにと、命令したため、彼らは近ごろイタリヤから出てきたのである。"},{"ref":"Acts.18.3","start":44018003,"end":44018003,"break":"none","ruby":[[4,1,"かれ"],[11,1,"い"],[16,1,"たがい"],[18,2,"どうぎょう"],[29,1,"いえ"],[31,1,"す"],[33,1,"こ"],[37,2,"いっしょ"],[40,2,"しごと"],[46,2,"てんまく"],[48,1,"つく"],[53,2,"しょくぎょう"]],"text":"パウロは彼らのところに行ったが、互に同業であったので、その家に住み込んで、一緒に仕事をした。天幕造りがその職業であった。"},{"ref":"Acts.18.4","start":44018004,"end":44018004,"break":"none","ruby":[[4,3,"あんそくにち"],[10,2,"かいどう"],[13,1,"ろん"],[21,1,"じん"],[27,1,"じん"],[29,2,"せっとく"],[32,1,"つと"]],"text":"パウロは安息日ごとに会堂で論じては、ユダヤ人やギリシヤ人の説得に努めた。"},{"ref":"Acts.18.5","start":44018005,"end":44018005,"break":"paragraph","ruby":[[16,1,"くだ"],[29,2,"みことば"],[32,1,"つた"],[38,2,"せんねん"],[60,1,"じん"],[64,2,"ちからづよ"]],"text":"シラスとテモテが、マケドニヤから下ってきてからは、パウロは御言を伝えることに専念し、イエスがキリストであることを、ユダヤ人たちに力強くあかしした。"},{"ref":"Acts.18.6","start":44018006,"end":44018006,"break":"none","ruby":[[4,1,"かれ"],[10,2,"はんこう"],[18,1,"つづ"],[28,2,"じぶん"],[31,2,"うわぎ"],[34,1,"ふ"],[41,1,"かれ"],[44,1,"い"],[55,1,"ち"],[63,2,"じしん"],[75,2,"せきにん"],[81,1,"いま"],[88,3,"いほうじん"],[92,1,"ほう"],[94,1,"い"]],"text":"しかし、彼らがこれに反抗してののしり続けたので、パウロは自分の上着を振りはらって、彼らに言った、「あなたがたの血は、あなたがた自身にかえれ。わたしには責任がない。今からわたしは異邦人の方に行く」。"},{"ref":"Acts.18.7","start":44018007,"end":44018007,"break":"none","ruby":[[2,1,"い"],[6,1,"かれ"],[11,1,"さ"],[24,1,"かみ"],[26,1,"うやま"],[28,1,"ひと"],[30,1,"いえ"],[32,1,"い"],[38,1,"いえ"],[40,2,"かいどう"],[43,1,"とな"],[45,1,"あ"]],"text":"こう言って、彼はそこを去り、テテオ・ユストという神を敬う人の家に行った。その家は会堂と隣り合っていた。"},{"ref":"Acts.18.8","start":44018008,"end":44018008,"break":"none","ruby":[[0,3,"かいどうづかさ"],[11,2,"かぞく"],[13,2,"いちどう"],[16,1,"とも"],[18,1,"しゅ"],[20,1,"しん"],[26,1,"おお"],[33,1,"びと"],[40,1,"はなし"],[42,1,"き"],[45,1,"しん"],[59,1,"う"]],"text":"会堂司クリスポは、その家族一同と共に主を信じた。また多くのコリント人も、パウロの話を聞いて信じ、ぞくぞくとバプテスマを受けた。"},{"ref":"Acts.18.9","start":44018009,"end":44018009,"break":"none","ruby":[[6,1,"よ"],[8,1,"まぼろし"],[13,1,"しゅ"],[19,1,"い"],[25,1,"おそ"],[30,1,"かた"],[37,1,"だま"]],"text":"すると、ある夜、幻のうちに主がパウロに言われた、「恐れるな。語りつづけよ、黙っているな。"},{"ref":"Acts.18.10","start":44018010,"end":44018010,"break":"none","ruby":[[23,1,"おそ"],[27,2,"きがい"],[30,1,"くわ"],[44,1,"まち"],[52,1,"たみ"],[54,1,"おお"]],"text":"あなたには、わたしがついている。だれもあなたを襲って、危害を加えるようなことはない。この町には、わたしの民が大ぜいいる」。"},{"ref":"Acts.18.11","start":44018011,"end":44018011,"break":"none","ruby":[[5,1,"ねん"],[8,1,"げつ"],[10,1,"あいだ"],[14,1,"こし"],[20,1,"かみ"],[22,1,"ことば"],[24,1,"かれ"],[27,1,"あいだ"],[29,1,"おし"]],"text":"パウロは一年六か月の間ここに腰をすえて、神の言を彼らの間に教えつづけた。"},{"ref":"Acts.18.12","start":44018012,"end":44018012,"break":"paragraph","ruby":[[13,2,"そうとく"],[19,1,"とき"],[24,1,"じん"],[28,2,"いっしょ"],[38,1,"おそ"],[41,1,"かれ"],[43,2,"ほうてい"],[51,1,"い"],[54,1,"うった"]],"text":"ところが、ガリオがアカヤの総督であった時、ユダヤ人たちは一緒になってパウロを襲い、彼を法廷にひっぱって行って訴えた、"},{"ref":"Acts.18.13","start":44018013,"end":44018013,"break":"none","ruby":[[3,1,"ひと"],[6,2,"りっぽう"],[13,1,"かみ"],[15,1,"おが"],[21,2,"ひとびと"]],"text":"「この人は、律法にそむいて神を拝むように、人々をそそのかしています」。"},{"ref":"Acts.18.14","start":44018014,"end":44018014,"break":"none","ruby":[[4,1,"くち"],[6,1,"ひら"],[21,1,"じん"],[25,1,"い"],[33,1,"じん"],[34,2,"しょくん"],[37,1,"なに"],[39,2,"ふほう"],[41,2,"こうい"],[46,2,"あくしつ"],[49,2,"はんざい"],[63,2,"とうぜん"],[66,2,"しょくん"],[69,1,"うった"],[72,1,"と"],[74,1,"あ"]],"text":"パウロが口を開こうとすると、ガリオはユダヤ人たちに言った、「ユダヤ人諸君、何か不法行為とか、悪質の犯罪とかのことなら、わたしは当然、諸君の訴えを取り上げもしようが、"},{"ref":"Acts.18.15","start":44018015,"end":44018015,"break":"none","ruby":[[3,2,"しょくん"],[6,2,"ことば"],[9,2,"めいしょう"],[12,2,"りっぽう"],[15,1,"かん"],[18,2,"もんだい"],[26,2,"しょくん"],[32,2,"しまつ"],[49,1,"こと"],[51,3,"さいばんにん"]],"text":"これは諸君の言葉や名称や律法に関する問題なのだから、諸君みずから始末するがよかろう。わたしはそんな事の裁判人にはなりたくない」。"},{"ref":"Acts.18.16","start":44018016,"end":44018016,"break":"none","ruby":[[2,1,"い"],[6,1,"かれ"],[9,2,"ほうてい"],[13,1,"お"]],"text":"こう言って、彼らを法廷から追いはらった。"},{"ref":"Acts.18.17","start":44018017,"end":44018017,"break":"none","ruby":[[8,1,"もの"],[11,3,"かいどうづかさ"],[19,1,"ひ"],[21,1,"とら"],[24,2,"ほうてい"],[27,1,"まえ"],[29,1,"う"],[43,1,"たい"],[48,1,"し"],[51,1,"かお"]],"text":"そこで、みんなの者は、会堂司ソステネを引き捕え、法廷の前で打ちたたいた。ガリオはそれに対して、そ知らぬ顔をしていた。"},{"ref":"Acts.18.18","start":44018018,"end":44018018,"break":"paragraph","ruby":[[9,2,"いくにち"],[16,2,"たいざい"],[20,1,"のち"],[22,2,"きょうだい"],[27,1,"わか"],[30,1,"つ"],[38,1,"む"],[40,2,"しゅっぱん"],[55,2,"どうこう"],[73,2,"せいがん"],[76,1,"た"],[90,1,"あたま"]],"text":"さてパウロは、なお幾日ものあいだ滞在した後、兄弟たちに別れを告げて、シリヤへ向け出帆した。プリスキラとアクラも同行した。パウロは、かねてから、ある誓願を立てていたので、ケンクレヤで頭をそった。"},{"ref":"Acts.18.19","start":44018019,"end":44018019,"break":"none","ruby":[[0,2,"いっこう"],[7,1,"つ"],[22,1,"のこ"],[28,2,"じぶん"],[32,2,"かいどう"],[43,1,"じん"],[47,1,"ろん"]],"text":"一行がエペソに着くと、パウロはふたりをそこに残しておき、自分だけ会堂にはいって、ユダヤ人たちと論じた。"},{"ref":"Acts.18.20","start":44018020,"end":44018020,"break":"none","ruby":[[0,2,"ひとびと"],[11,1,"なが"],[16,2,"たいざい"],[23,1,"ねが"],[28,1,"かれ"],[30,1,"き"]],"text":"人々は、パウロにもっと長いあいだ滞在するように願ったが、彼は聞きいれないで、"},{"ref":"Acts.18.21","start":44018021,"end":44018021,"break":"none","ruby":[[1,1,"かみ"],[22,1,"かえ"],[30,1,"い"],[34,1,"わか"],[37,1,"つ"],[45,2,"ふなで"]],"text":"「神のみこころなら、またあなたがたのところに帰ってこよう」と言って、別れを告げ、エペソから船出した。"},{"ref":"Acts.18.22","start":44018022,"end":44018022,"break":"none","ruby":[[11,2,"じょうりく"],[21,1,"のぼ"],[24,2,"きょうかい"],[42,1,"くだ"],[45,1,"い"]],"text":"それから、カイザリヤで上陸してエルサレムに上り、教会にあいさつしてから、アンテオケに下って行った。"},{"ref":"Acts.18.23","start":44018023,"end":44018023,"break":"none","ruby":[[12,1,"かれ"],[16,1,"で"],[32,2,"ちほう"],[35,2,"れきほう"],[44,2,"でし"],[49,1,"ちから"]],"text":"そこにしばらくいてから、彼はまた出かけ、ガラテヤおよびフルギヤの地方を歴訪して、すべての弟子たちを力づけた。"},{"ref":"Acts.18.24","start":44018024,"end":44018024,"break":"paragraph","ruby":[[11,1,"うま"],[15,2,"せいしょ"],[18,2,"せいつう"],[26,2,"ゆうべん"],[38,1,"じん"]],"text":"さて、アレキサンデリヤ生れで、聖書に精通し、しかも、雄弁なアポロというユダヤ人が、エペソにきた。"},{"ref":"Acts.18.25","start":44018025,"end":44018025,"break":"none","ruby":[[2,1,"ひと"],[4,1,"しゅ"],[6,1,"みち"],[8,1,"つう"],[17,1,"れい"],[19,1,"も"],[29,1,"くわ"],[32,1,"かた"],[36,1,"おし"],[59,1,"し"]],"text":"この人は主の道に通じており、また、霊に燃えてイエスのことを詳しく語ったり教えたりしていたが、ただヨハネのバプテスマしか知っていなかった。"},{"ref":"Acts.18.26","start":44018026,"end":44018026,"break":"none","ruby":[[0,1,"かれ"],[2,2,"かいどう"],[5,2,"だいたん"],[8,1,"かた"],[10,1,"はじ"],[28,1,"き"],[32,1,"かれ"],[34,1,"まね"],[42,1,"くわ"],[45,1,"かみ"],[47,1,"みち"],[49,1,"と"],[51,1,"き"]],"text":"彼は会堂で大胆に語り始めた。それをプリスキラとアクラとが聞いて、彼を招きいれ、さらに詳しく神の道を解き聞かせた。"},{"ref":"Acts.18.27","start":44018027,"end":44018027,"break":"none","ruby":[[13,1,"わた"],[18,1,"おも"],[26,2,"きょうだい"],[31,1,"かれ"],[33,1,"はげ"],[37,2,"せんぽう"],[40,2,"でし"],[46,1,"かれ"],[50,1,"むか"],[58,2,"てがみ"],[61,1,"か"],[63,1,"おく"],[67,1,"かれ"],[69,2,"とうちゃく"],[84,2,"しんじゃ"],[92,1,"ひと"],[97,1,"おお"],[100,1,"ちから"]],"text":"それから、アポロがアカヤに渡りたいと思っていたので、兄弟たちは彼を励まし、先方の弟子たちに、彼をよく迎えるようにと、手紙を書き送った。彼は到着して、すでにめぐみによって信者になっていた人たちに、大いに力になった。"},{"ref":"Acts.18.28","start":44018028,"end":44018028,"break":"none","ruby":[[0,1,"かれ"],[17,2,"せいしょ"],[20,1,"もとづ"],[23,1,"しめ"],[26,2,"こうぜん"],[33,1,"じん"],[37,1,"はげ"],[40,2,"ごちょう"],[43,2,"ろんぱ"]],"text":"彼はイエスがキリストであることを、聖書に基いて示し、公然と、ユダヤ人たちを激しい語調で論破したからである。"}]