[{"ref":"Ezek.36.1","start":26036001,"end":26036001,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[11,2,"やまやま"],[14,2,"よげん"],[18,1,"い"],[27,2,"やまやま"],[31,1,"しゅ"],[33,2,"ことば"],[36,1,"き"]],"text":"人の子よ、イスラエルの山々に預言して言え。イスラエルの山々よ、主の言葉を聞け。"},{"ref":"Ezek.36.2","start":26036002,"end":26036002,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[12,1,"てき"],[23,1,"い"],[30,1,"むかし"],[32,1,"たか"],[34,1,"ところ"]],"text":"主なる神はこう言われる、敵はあなたがたについて言う、『ああ、昔の高き所が、われわれのものとなった』と。"},{"ref":"Ezek.36.3","start":26036003,"end":26036003,"break":"none","ruby":[[9,2,"よげん"],[13,1,"い"],[16,1,"しゅ"],[19,1,"かみ"],[23,1,"い"],[28,1,"かれ"],[37,1,"あら"],[40,2,"しほう"],[50,1,"う"],[52,1,"ほろ"],[65,1,"た"],[67,2,"こくみん"],[70,2,"しょゆう"],[78,1,"たみ"],[80,1,"わる"]],"text":"それゆえ、あなたは預言して言え。主なる神はこう言われる、彼らはあなたがたを荒し、四方からあなたがたを打ち滅ぼしたので、あなたがたは他の国民の所有となり、また民の悪いうわさとなった。"},{"ref":"Ezek.36.4","start":26036004,"end":26036004,"break":"none","ruby":[[11,2,"やまやま"],[15,1,"しゅ"],[18,1,"かみ"],[20,2,"ことば"],[23,1,"き"],[26,1,"しゅ"],[29,1,"かみ"],[32,1,"やま"],[35,1,"おか"],[40,1,"ち"],[43,1,"たに"],[46,1,"ほろ"],[49,1,"あ"],[51,1,"あと"],[54,1,"ひと"],[56,1,"す"],[59,2,"まちまち"],[68,2,"しゅうい"],[73,1,"しょ"],[74,2,"こくみん"],[77,1,"のこ"],[80,1,"もの"],[106,1,"い"]],"text":"それゆえ、イスラエルの山々よ、主なる神の言葉を聞け。主なる神は、山と、丘と、くぼ地と、谷と、滅びた荒れ跡と、人の捨てた町々、すなわちその周囲にある諸国民の残った者にかすめられ、あざけられるようになったものに、こう言われる。"},{"ref":"Ezek.36.5","start":26036005,"end":26036005,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[20,1,"ほのお"],[26,1,"た"],[28,2,"こくみん"],[34,2,"ぜんこく"],[38,1,"たい"],[41,1,"い"],[44,1,"かれ"],[47,1,"こころ"],[52,1,"よろこ"],[55,1,"こころ"],[57,1,"ほこ"],[62,1,"ち"],[64,2,"じぶん"],[67,2,"しょゆう"],[75,1,"うば"],[82,1,"もの"]],"text":"主なる神はこう言われる、わたしはねたみの炎をもって、他の国民とエドム全国とに対して言う、彼らは心ゆくまで喜び、心に誇ってわが地を自分の所有とし、これを奪い、かすめた者である。"},{"ref":"Ezek.36.6","start":26036006,"end":26036006,"break":"none","ruby":[[15,1,"ち"],[17,1,"こと"],[19,2,"よげん"],[23,1,"やま"],[26,1,"おか"],[31,1,"ち"],[34,1,"たに"],[37,1,"い"],[40,1,"しゅ"],[43,1,"かみ"],[47,1,"い"],[52,1,"み"],[61,1,"しょ"],[62,2,"こくみん"],[71,1,"う"],[85,1,"いか"],[92,1,"かた"]],"text":"それゆえ、あなたはイスラエルの地の事を預言し、山と、丘と、くぼ地と、谷とに言え。主なる神はこう言われる、見よ、あなたがたは諸国民のはずかしめを受けたので、わたしはねたみと怒りとをもって語る。"},{"ref":"Ezek.36.7","start":26036007,"end":26036007,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[21,1,"ちか"],[24,1,"い"],[33,2,"しゅうい"],[36,1,"しょ"],[37,2,"こくみん"],[40,1,"かなら"],[48,1,"う"]],"text":"それゆえ、主なる神はこう言われる、わたしは誓って言う、あなたがたの周囲の諸国民は必ずはずかしめを受ける。"},{"ref":"Ezek.36.8","start":26036008,"end":26036008,"break":"paragraph","ruby":[[9,2,"やまやま"],[19,1,"えだ"],[21,1,"だ"],[26,1,"たみ"],[36,1,"み"],[38,1,"むす"],[43,1,"こと"],[45,1,"な"],[49,1,"ちか"]],"text":"しかしイスラエルの山々よ、あなたがたは枝を出し、わが民イスラエルのために実を結ぶ。この事の成るのは近い。"},{"ref":"Ezek.36.9","start":26036009,"end":26036009,"break":"none","ruby":[[0,1,"み"],[13,1,"のぞ"],[22,1,"かえり"],[32,1,"たがや"],[36,1,"たね"]],"text":"見よ、わたしはあなたがたに臨み、あなたがたを顧みる。あなたがたは耕され、種をまかれる。"},{"ref":"Ezek.36.10","start":26036010,"end":26036010,"break":"none","ruby":[[10,1,"うえ"],[12,1,"ひと"],[32,1,"いえ"],[34,1,"もの"],[39,2,"まちまち"],[43,1,"ひと"],[45,1,"す"],[48,1,"あ"],[50,1,"あと"],[52,1,"た"],[54,1,"なお"]],"text":"わたしはあなたがたの上に人をふやす。これはことごとくイスラエルの家の者となり、町々には人が住み、荒れ跡は建て直される。"},{"ref":"Ezek.36.11","start":26036011,"end":26036011,"break":"none","ruby":[[10,1,"うえ"],[12,1,"ひと"],[14,1,"けもの"],[21,1,"かれ"],[28,1,"こ"],[30,1,"う"],[43,1,"うえ"],[46,1,"むかし"],[51,1,"ひと"],[53,1,"す"],[57,1,"はじ"],[60,1,"とき"],[68,1,"めぐ"],[77,1,"ほどこ"],[82,1,"とき"],[94,1,"しゅ"],[101,1,"さと"]],"text":"わたしはあなたがたの上に人と獣とをふやす。彼らはふえて、子を生む。わたしはあなたがたの上に、昔のように人を住ませ、初めの時よりも、まさる恵みをあなたがたに施す。その時あなたがたは、わたしが主であることを悟る。"},{"ref":"Ezek.36.12","start":26036012,"end":26036012,"break":"none","ruby":[[6,1,"たみ"],[13,2,"ひとびと"],[22,1,"うえ"],[24,1,"あゆ"],[29,1,"かれ"],[38,2,"しょゆう"],[50,1,"し"],[51,1,"ぎょう"],[62,1,"かさ"],[65,1,"かれ"],[68,1,"こ"],[72,1,"なげ"]],"text":"わたしはわが民イスラエルの人々をあなたがたの上に歩ませる。彼らはあなたがたを所有し、あなたがたはその嗣業となり、あなたがたは重ねて彼らに子のない嘆きをさせない。"},{"ref":"Ezek.36.13","start":26036013,"end":26036013,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[12,1,"かれ"],[21,1,"む"],[31,1,"ひと"],[33,1,"く"],[40,1,"たみ"],[42,1,"こ"],[46,1,"なげ"],[54,1,"い"]],"text":"主なる神はこう言われる、彼らはあなたがたに向かって、『あなたは人を食い、あなたの民に子のない嘆きをさせる』と言う。"},{"ref":"Ezek.36.14","start":26036014,"end":26036014,"break":"none","ruby":[[7,1,"ひと"],[9,1,"く"],[18,1,"たみ"],[20,1,"かさ"],[23,1,"こ"],[27,1,"なげ"],[40,1,"しゅ"],[43,1,"かみ"],[45,1,"い"]],"text":"あなたはもはや人を食わない。あなたの民に重ねて子のない嘆きをさせることはないと、主なる神は言われる。"},{"ref":"Ezek.36.15","start":26036015,"end":26036015,"break":"none","ruby":[[4,1,"かさ"],[7,1,"しょ"],[8,2,"こくみん"],[21,1,"き"],[31,1,"かさ"],[40,1,"たみ"],[48,1,"う"],[61,1,"たみ"],[63,1,"かさ"],[79,1,"しゅ"],[82,1,"かみ"],[84,1,"い"]],"text":"わたしは重ねて諸国民のはずかしめをあなたに聞かせない。あなたは重ねて、もろもろの民のはずかしめを受けることはなく、あなたの民を重ねてつまずかせることはないと、主なる神は言われる」。"},{"ref":"Ezek.36.16","start":26036016,"end":26036016,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.36.17","start":26036017,"end":26036017,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[6,1,"むかし"],[14,1,"いえ"],[17,2,"じぶん"],[20,1,"くに"],[22,1,"す"],[28,1,"かれ"],[51,1,"けが"],[67,1,"まえ"],[71,1,"けが"],[76,1,"おんな"],[78,1,"けが"]],"text":"「人の子よ、昔、イスラエルの家が、自分の国に住んだとき、彼らはおのれのおこないとわざとをもって、これを汚した。そのおこないは、わたしの前には、汚れにある女の汚れのようであった。"},{"ref":"Ezek.36.18","start":26036018,"end":26036018,"break":"none","ruby":[[0,1,"かれ"],[3,1,"くに"],[5,1,"ち"],[7,1,"なが"],[14,2,"ぐうぞう"],[21,1,"くに"],[23,1,"けが"],[35,1,"いか"],[38,1,"かれ"],[41,1,"うえ"],[43,1,"そそ"]],"text":"彼らが国に血を流し、またその偶像をもって、国を汚したため、わたしはわが怒りを彼らの上に注ぎ、"},{"ref":"Ezek.36.19","start":26036019,"end":26036019,"break":"none","ruby":[[0,1,"かれ"],[3,1,"しょ"],[4,2,"こくみん"],[7,1,"なか"],[9,1,"ち"],[16,1,"かれ"],[19,2,"くにぐに"],[22,1,"なか"],[24,1,"ち"],[32,1,"かれ"],[51,1,"かれ"]],"text":"彼らを諸国民の中に散らしたので、彼らは国々の中に散った。わたしは彼らのおこないと、わざとにしたがって、彼らをさばいた。"},{"ref":"Ezek.36.20","start":26036020,"end":26036020,"break":"none","ruby":[[0,1,"かれ"],[5,1,"い"],[11,2,"くにぐに"],[14,1,"い"],[22,1,"せい"],[25,1,"な"],[27,1,"けが"],[34,2,"ひとびと"],[37,1,"かれ"],[47,1,"しゅ"],[49,1,"たみ"],[57,1,"くに"],[60,1,"で"],[62,1,"もの"],[68,1,"い"]],"text":"彼らがその行くところの国々へ行ったとき、わが聖なる名を汚した。これは人々が彼らについて『これは主の民であるが、その国から出た者である』と言ったからである。"},{"ref":"Ezek.36.21","start":26036021,"end":26036021,"break":"none","ruby":[[13,1,"いえ"],[18,1,"い"],[24,1,"しょ"],[25,2,"こくみん"],[28,1,"なか"],[30,1,"けが"],[35,1,"せい"],[38,1,"な"],[40,1,"お"]],"text":"しかしわたしはイスラエルの家が、その行くところの諸国民の中で汚したわが聖なる名を惜しんだ。"},{"ref":"Ezek.36.22","start":26036022,"end":26036022,"break":"paragraph","ruby":[[15,1,"いえ"],[17,1,"い"],[20,1,"しゅ"],[23,1,"かみ"],[27,1,"い"],[38,1,"いえ"],[72,1,"い"],[75,1,"しょ"],[76,2,"こくみん"],[79,1,"なか"],[81,1,"けが"],[87,1,"せい"],[90,1,"な"]],"text":"それゆえ、あなたはイスラエルの家に言え。主なる神はこう言われる、イスラエルの家よ、わたしがすることはあなたがたのためではない。それはあなたがたが行った諸国民の中で汚した、わが聖なる名のためである。"},{"ref":"Ezek.36.23","start":26036023,"end":26036023,"break":"none","ruby":[[4,1,"しょ"],[5,2,"こくみん"],[8,1,"なか"],[10,1,"けが"],[28,1,"かれ"],[31,1,"なか"],[33,1,"けが"],[39,1,"おお"],[43,1,"な"],[45,1,"せい"],[51,1,"しめ"],[68,1,"かれ"],[71,1,"め"],[73,1,"まえ"],[80,1,"せい"],[86,1,"しめ"],[88,1,"とき"],[90,1,"しょ"],[91,2,"こくみん"],[98,1,"しゅ"],[105,1,"さと"],[109,1,"しゅ"],[112,1,"かみ"],[114,1,"い"]],"text":"わたしは諸国民の中で汚されたもの、すなわち、あなたがたが彼らの中で汚した、わが大いなる名の聖なることを示す。わたしがあなたがたによって、彼らの目の前に、わたしの聖なることを示す時、諸国民はわたしが主であることを悟ると、主なる神は言われる。"},{"ref":"Ezek.36.24","start":26036024,"end":26036024,"break":"none","ruby":[[10,1,"しょ"],[11,2,"こくみん"],[14,1,"なか"],[17,1,"みちび"],[19,1,"だ"],[22,2,"ばんこく"],[26,1,"あつ"],[36,1,"くに"],[38,1,"い"]],"text":"わたしはあなたがたを諸国民の中から導き出し、万国から集めて、あなたがたの国に行かせる。"},{"ref":"Ezek.36.25","start":26036025,"end":26036025,"break":"none","ruby":[[4,1,"きよ"],[6,1,"みず"],[14,1,"そそ"],[22,1,"けが"],[26,1,"きよ"],[42,2,"ぐうぞう"],[46,1,"きよ"]],"text":"わたしは清い水をあなたがたに注いで、すべての汚れから清め、またあなたがたを、すべての偶像から清める。"},{"ref":"Ezek.36.26","start":26036026,"end":26036026,"break":"none","ruby":[[4,1,"あたら"],[7,1,"こころ"],[15,1,"あた"],[18,1,"あたら"],[21,1,"れい"],[29,1,"うち"],[31,1,"さづ"],[40,1,"にく"],[44,1,"いし"],[46,1,"こころ"],[48,1,"のぞ"],[52,1,"にく"],[54,1,"こころ"],[56,1,"あた"]],"text":"わたしは新しい心をあなたがたに与え、新しい霊をあなたがたの内に授け、あなたがたの肉から、石の心を除いて、肉の心を与える。"},{"ref":"Ezek.36.27","start":26036027,"end":26036027,"break":"none","ruby":[[8,1,"れい"],[19,1,"お"],[25,1,"さだ"],[28,1,"あゆ"],[38,1,"まも"],[44,1,"おこな"]],"text":"わたしはまたわが霊をあなたがたのうちに置いて、わが定めに歩ませ、わがおきてを守ってこれを行わせる。"},{"ref":"Ezek.36.28","start":26036028,"end":26036028,"break":"none","ruby":[[17,2,"せんぞ"],[20,1,"あた"],[23,1,"ち"],[25,1,"す"],[31,1,"たみ"],[46,1,"かみ"]],"text":"あなたがたは、わたしがあなたがたの先祖に与えた地に住んで、わが民となり、わたしはあなたがたの神となる。"},{"ref":"Ezek.36.29","start":26036029,"end":26036029,"break":"none","ruby":[[16,1,"けが"],[20,1,"すく"],[23,2,"こくもつ"],[26,1,"よ"],[34,1,"ま"],[47,1,"のぞ"]],"text":"わたしはあなたがたをそのすべての汚れから救い、穀物を呼びよせてこれを増し、ききんをあなたがたに臨ませない。"},{"ref":"Ezek.36.30","start":26036030,"end":26036030,"break":"none","ruby":[[6,1,"き"],[8,1,"み"],[11,2,"たはた"],[14,2,"さくもつ"],[18,1,"おお"],[29,1,"かさ"],[32,1,"しょ"],[33,2,"こくみん"],[36,1,"あいだ"],[49,1,"う"]],"text":"またわたしは木の実と、田畑の作物とを多くする。あなたがたは重ねて諸国民の間に、ききんのはずかしめを受けることがない。"},{"ref":"Ezek.36.31","start":26036031,"end":26036031,"break":"none","ruby":[[2,1,"とき"],[9,2,"じしん"],[12,1,"あ"],[21,1,"よ"],[29,1,"おぼ"],[35,1,"つみ"],[40,1,"にく"],[56,1,"うら"]],"text":"その時あなたがたは自身の悪しきおこないと、良からぬわざとを覚えて、その罪と、その憎むべきこととのために、みずから恨む。"},{"ref":"Ezek.36.32","start":26036032,"end":26036032,"break":"none","ruby":[[23,1,"しゅ"],[26,1,"かみ"],[28,1,"い"],[42,1,"し"],[51,1,"いえ"],[60,2,"じぶん"],[68,1,"は"],[71,1,"く"]],"text":"わたしがなすことはあなたがたのためではないと、主なる神は言われる。あなたがたはこれを知れ。イスラエルの家よ、あなたがたは自分のおこないを恥じて悔やむべきである。"},{"ref":"Ezek.36.33","start":26036033,"end":26036033,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[27,1,"つみ"],[29,1,"きよ"],[32,1,"ひ"],[35,2,"まちまち"],[38,1,"ひと"],[40,1,"す"],[46,1,"あ"],[48,1,"あと"],[50,1,"た"],[52,1,"なお"]],"text":"主なる神はこう言われる、わたしは、あなたがたのすべての罪を清める日に、町々に人を住ませ、その荒れ跡を建て直す。"},{"ref":"Ezek.36.34","start":26036034,"end":26036034,"break":"none","ruby":[[0,1,"あ"],[3,1,"ち"],[6,1,"い"],[8,1,"き"],[10,2,"ひとびと"],[13,1,"め"],[15,1,"あ"],[17,1,"ち"],[19,1,"み"],[24,1,"ひ"],[29,1,"たがや"]],"text":"荒れた地は、行き来の人々の目に荒れ地と見えたのに引きかえて耕される。"},{"ref":"Ezek.36.35","start":26036035,"end":26036035,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"い"],[12,1,"あ"],[15,1,"ち"],[22,1,"その"],[31,1,"あ"],[34,1,"ほろ"],[41,2,"まちまち"],[45,2,"けんご"],[51,1,"ひと"],[53,1,"す"],[55,1,"ところ"]],"text":"そこで人々は言う、『この荒れた地は、エデンの園のようになった。荒れ、滅び、くずれた町々は、堅固になり、人の住む所となった』と。"},{"ref":"Ezek.36.36","start":26036036,"end":26036036,"break":"none","ruby":[[6,2,"しゅうい"],[9,1,"のこ"],[12,1,"しょ"],[13,2,"こくみん"],[16,1,"しゅ"],[27,1,"ところ"],[29,1,"た"],[31,1,"なお"],[34,1,"あ"],[37,1,"ところ"],[42,1,"う"],[51,1,"さと"],[59,1,"しゅ"],[69,1,"い"]],"text":"あなたがたの周囲に残った諸国民は主なるわたしがくずれた所を建て直し、荒れた所にものを植えたということを悟るようになる。主なるわたしがこれを言い、これをなすのである。"},{"ref":"Ezek.36.37","start":26036037,"end":26036037,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[18,1,"いえ"],[25,1,"つぎ"],[30,1,"かれ"],[46,1,"もと"],[59,1,"ひと"],[61,1,"む"]],"text":"主なる神はこう言われる、イスラエルの家は、わたしが次のことを彼らのためにするように、わたしに求めるべきである。すなわち人を群れのようにふやすこと、"},{"ref":"Ezek.36.38","start":26036038,"end":26036038,"break":"none","ruby":[[4,2,"ぎせい"],[10,1,"む"],[23,1,"いわ"],[25,1,"び"],[27,1,"む"],[45,1,"あ"],[48,2,"まちまち"],[51,1,"ひと"],[53,1,"む"],[56,1,"み"],[62,1,"とき"],[63,2,"ひとびと"],[71,1,"しゅ"],[78,1,"さと"]],"text":"すなわち犠牲のための群れのように、エルサレムの祝い日の群れのようにすることである。こうして荒れた町々は人の群れで満ちる。その時人々は、わたしが主であることを悟るようになる」。"}]