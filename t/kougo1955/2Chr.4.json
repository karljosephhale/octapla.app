[{"ref":"2Chr.4.1","start":14004001,"end":14004001,"break":"paragraph","ruby":[[7,2,"せいどう"],[10,2,"さいだん"],[13,1,"つく"],[19,1,"なが"],[28,1,"はば"],[36,1,"たか"]],"text":"ソロモンはまた青銅の祭壇を造った。その長さ二十キュビト、幅二十キュビト、高さ十キュビトである。"},{"ref":"2Chr.4.2","start":14004002,"end":14004002,"break":"none","ruby":[[0,1,"かれ"],[4,1,"うみ"],[6,1,"い"],[8,1,"つく"],[12,1,"ふち"],[15,1,"ふち"],[28,2,"しゅうい"],[31,2,"えんけい"],[37,1,"たか"],[48,2,"しゅうい"],[51,1,"つな"],[56,1,"はか"]],"text":"彼はまた海を鋳て造った。縁から縁まで十キュビトであって、周囲は円形をなし、高さ五キュビトで、その周囲は綱をもって測ると三十キュビトあった。"},{"ref":"2Chr.4.3","start":14004003,"end":14004003,"break":"none","ruby":[[0,1,"うみ"],[2,1,"した"],[12,2,"しゅうい"],[22,1,"かたち"],[28,1,"うみ"],[30,2,"しゅうい"],[33,1,"かこ"],[46,1,"なら"],[50,1,"うみ"],[52,1,"い"],[54,1,"とき"],[56,1,"い"]],"text":"海の下には三十キュビトの周囲をめぐるひさごの形があって、海の周囲を囲んでいた。そのひさごは二並びで、海を鋳る時に鋳たものである。"},{"ref":"2Chr.4.4","start":14004004,"end":14004004,"break":"none","ruby":[[2,1,"うみ"],[7,1,"うし"],[9,1,"うえ"],[11,1,"お"],[20,1,"きた"],[22,1,"む"],[29,1,"にし"],[31,1,"む"],[38,1,"みなみ"],[40,1,"む"],[47,1,"ひがし"],[49,1,"む"],[56,1,"うみ"],[60,1,"うえ"],[62,1,"お"],[66,1,"うし"],[74,1,"うち"],[76,1,"む"]],"text":"その海は十二の牛の上に置かれ、その三つは北に向かい、三つは西に向かい、三つは南に向かい、三つは東に向かっていた。海はその上に置かれ、牛のうしろはみな内に向かっていた。"},{"ref":"2Chr.4.5","start":14004005,"end":14004005,"break":"none","ruby":[[0,1,"うみ"],[2,1,"あつ"],[5,1,"て"],[7,1,"はば"],[12,1,"ふち"],[14,1,"はい"],[16,1,"ふち"],[25,1,"はな"],[27,1,"に"],[30,1,"つく"],[35,1,"うみ"],[38,1,"みず"],[44,1,"い"]],"text":"海の厚さは手の幅で、その縁は杯の縁のように、ゆりの花に似せて造られた。海には水を三千バテ入れることができた。"},{"ref":"2Chr.4.6","start":14004006,"end":14004006,"break":"none","ruby":[[0,1,"かれ"],[4,1,"もの"],[6,1,"あら"],[11,2,"せんばん"],[14,1,"こ"],[16,1,"つく"],[21,1,"こ"],[23,2,"みなみがわ"],[28,1,"こ"],[30,2,"きたがわ"],[33,1,"お"],[39,1,"なか"],[41,2,"はんさい"],[44,1,"もち"],[50,1,"あら"],[57,1,"うみ"],[59,2,"さいし"],[64,1,"なか"],[66,1,"み"],[68,1,"あら"]],"text":"彼はまた物を洗うために洗盤十個を造って、五個を南側に、五個を北側に置いた。その中で燔祭に用いるものを洗った。しかし海は祭司がその中で身を洗うためであった。"},{"ref":"2Chr.4.7","start":14004007,"end":14004007,"break":"paragraph","ruby":[[0,1,"かれ"],[4,1,"きん"],[6,2,"しょくだい"],[9,1,"こ"],[13,1,"さだ"],[16,1,"したが"],[19,1,"つく"],[22,2,"はいでん"],[25,1,"なか"],[27,2,"みなみがわ"],[31,1,"こ"],[33,2,"きたがわ"],[37,1,"こ"],[39,1,"お"]],"text":"彼はまた金の燭台十個をその定めに従って造り、拝殿の中の南側に五個、北側に五個を置き、"},{"ref":"2Chr.4.8","start":14004008,"end":14004008,"break":"none","ruby":[[2,1,"つくえ"],[4,1,"こ"],[6,1,"つく"],[9,2,"しんでん"],[12,1,"なか"],[14,2,"みなみがわ"],[18,1,"こ"],[20,2,"きたがわ"],[24,1,"こ"],[26,1,"お"],[31,1,"きん"],[33,1,"はち"],[36,1,"つく"]],"text":"また机十個を造り、神殿の中の南側に五個、北側に五個を置き、また金の鉢百を造った。"},{"ref":"2Chr.4.9","start":14004009,"end":14004009,"break":"none","ruby":[[0,1,"かれ"],[4,2,"さいし"],[7,1,"にわ"],[9,2,"おおにわ"],[14,1,"にわ"],[16,1,"と"],[18,1,"つく"],[23,1,"と"],[25,2,"せいどう"]],"text":"彼はまた祭司の庭と大庭および庭の戸を造り、その戸を青銅でおおった。"},{"ref":"2Chr.4.10","start":14004010,"end":14004010,"break":"none","ruby":[[0,1,"かれ"],[2,1,"うみ"],[4,1,"みや"],[6,2,"とうなん"]],"text":"彼は海を宮の東南のすみにすえた。"},{"ref":"2Chr.4.11","start":14004011,"end":14004011,"break":"paragraph","ruby":[[9,2,"じゅうのう"],[12,1,"はち"],[15,1,"つく"],[31,1,"おう"],[36,1,"かみ"],[38,1,"みや"],[40,2,"こうじ"],[43,1,"お"]],"text":"ヒラムはまたつぼと十能と鉢とを造った。こうしてヒラムはソロモン王のため、神の宮の工事を終えた。"},{"ref":"2Chr.4.12","start":14004012,"end":14004012,"break":"none","ruby":[[5,1,"ほん"],[7,1,"はしら"],[9,1,"たま"],[12,1,"はしら"],[14,1,"いただき"],[21,2,"ちゅうとう"],[25,1,"はしら"],[27,1,"いただき"],[31,2,"ちゅうとう"],[37,1,"たま"],[45,1,"あみ"],[46,2,"ざいく"]],"text":"すなわち二本の柱と玉と、柱の頂にある二つの柱頭と、柱の頂にある柱頭の二つの玉をおおう二つの網細工と、"},{"ref":"2Chr.4.13","start":14004013,"end":14004013,"break":"none","ruby":[[5,1,"あみ"],[6,2,"ざいく"],[28,1,"あみ"],[29,2,"ざいく"],[33,1,"なら"],[40,1,"はしら"],[42,1,"いただき"],[46,2,"ちゅうとう"],[52,1,"たま"],[54,1,"ま"]],"text":"その二つの網細工のためのざくろ四百、このざくろはおのおの網細工に二並びにつけて、柱の頂にある柱頭の二つの玉を巻いていた。"},{"ref":"2Chr.4.14","start":14004014,"end":14004014,"break":"none","ruby":[[0,1,"かれ"],[4,1,"だい"],[6,1,"だい"],[8,1,"うえ"],[10,2,"せんばん"]],"text":"彼はまた台と台の上の洗盤と、"},{"ref":"2Chr.4.15","start":14004015,"end":14004015,"break":"none","ruby":[[3,1,"うみ"],[7,1,"した"],[12,1,"うし"],[14,1,"つく"]],"text":"一つの海とその下の十二の牛を造った。"},{"ref":"2Chr.4.16","start":14004016,"end":14004016,"break":"none","ruby":[[3,2,"じゅうのう"],[6,1,"にく"],[18,2,"うつわもの"],[22,2,"たつじん"],[32,1,"おう"],[37,1,"しゅ"],[39,1,"みや"],[45,1,"ひかり"],[49,2,"せいどう"],[52,1,"つく"]],"text":"つぼ、十能、肉さしなどすべてこれらの器物を、達人ヒラムはソロモン王のため、主の宮のために、光のある青銅で造った。"},{"ref":"2Chr.4.17","start":14004017,"end":14004017,"break":"none","ruby":[[0,1,"おう"],[7,2,"ていち"],[19,1,"あいだ"],[21,2,"ねんど"],[24,1,"ち"],[29,1,"い"]],"text":"王はヨルダンの低地で、スコテとゼレダの間の粘土の地でこれを鋳た。"},{"ref":"2Chr.4.18","start":14004018,"end":14004018,"break":"none","ruby":[[18,2,"うつわもの"],[21,2,"ひじょう"],[24,1,"おお"],[26,1,"つく"],[34,2,"せいどう"],[37,2,"じゅうりょう"],[41,1,"はか"]],"text":"このようにソロモンはこれらのすべての器物を非常に多く造ったので、その青銅の重量は、量ることができなかった。"},{"ref":"2Chr.4.19","start":14004019,"end":14004019,"break":"paragraph","ruby":[[9,1,"かみ"],[11,1,"みや"],[17,2,"うつわもの"],[20,1,"つく"],[28,1,"きん"],[30,2,"さいだん"],[34,1,"そな"],[40,1,"の"],[43,1,"つくえ"]],"text":"こうしてソロモンは神の宮のすべての器物を造った。すなわち金の祭壇と、供えのパンを載せる机、"},{"ref":"2Chr.4.20","start":14004020,"end":14004020,"break":"none","ruby":[[2,1,"さだ"],[8,2,"ほんでん"],[11,1,"まえ"],[13,1,"ひ"],[18,2,"じゅんきん"],[21,2,"しょくだい"],[31,1,"さら"],[33,1,"つく"]],"text":"また定めのように本殿の前で火をともす純金の燭台と、そのともしび皿を造った。"},{"ref":"2Chr.4.21","start":14004021,"end":14004021,"break":"none","ruby":[[2,1,"はな"],[8,1,"さら"],[10,1,"こころ"],[14,1,"せい"],[15,1,"きん"]],"text":"その花、ともしび皿、心かきは精金であった。"},{"ref":"2Chr.4.22","start":14004022,"end":14004022,"break":"none","ruby":[[2,2,"しんき"],[9,1,"はち"],[11,1,"こう"],[13,1,"はい"],[15,2,"しんと"],[18,1,"ざら"],[20,2,"じゅんきん"],[29,1,"みや"],[31,1,"と"],[37,3,"しせいじょ"],[41,2,"ないぶ"],[44,1,"と"],[48,2,"はいでん"],[51,1,"と"],[58,1,"きん"]],"text":"また心切りばさみ、鉢、香の杯、心取り皿は純金であった。また宮の戸、すなわち至聖所の内部の戸および拝殿の戸のひじつぼは金であった。"}]