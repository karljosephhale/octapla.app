[{"ref":"Rom.3.1","start":45003001,"end":45003001,"break":"paragraph","ruby":[[6,1,"じん"],[14,1,"てん"],[16,1,"なに"],[21,2,"かつれい"],[24,1,"えき"],[26,1,"なに"]],"text":"では、ユダヤ人のすぐれている点は何か。また割礼の益は何か。"},{"ref":"Rom.3.2","start":45003002,"end":45003002,"break":"none","ruby":[[9,1,"てん"],[11,2,"かずおお"],[19,1,"だい"],[23,1,"かみ"],[25,1,"ことば"],[27,1,"かれ"]],"text":"それは、いろいろの点で数多くある。まず第一に、神の言が彼らにゆだねられたことである。"},{"ref":"Rom.3.3","start":45003003,"end":45003003,"break":"none","ruby":[[14,1,"かれ"],[20,1,"ふ"],[21,2,"しんじつ"],[24,1,"もの"],[36,1,"ふ"],[37,2,"しんじつ"],[44,1,"かみ"],[46,2,"しんじつ"],[49,1,"む"]],"text":"すると、どうなるのか。もし、彼らのうちに不真実の者があったとしたら、その不真実によって、神の真実は無になるであろうか。"},{"ref":"Rom.3.4","start":45003004,"end":45003004,"break":"none","breaks":[[43,"stanza"],[64,"line"]],"ruby":[[0,1,"だん"],[14,1,"ひと"],[16,1,"いつわ"],[18,1,"もの"],[24,1,"かみ"],[26,2,"しんじつ"],[48,2,"ことば"],[51,1,"の"],[58,1,"ぎ"],[72,1,"う"],[78,2,"しょうり"],[81,1,"え"],[87,1,"か"]],"text":"断じてそうではない。あらゆる人を偽り者としても、神を真実なものとすべきである。それは、「あなたが言葉を述べるときは、義とせられ、あなたがさばきを受けるとき、勝利を得るため」と書いてあるとおりである。"},{"ref":"Rom.3.5","start":45003005,"end":45003005,"break":"paragraph","ruby":[[12,2,"ふぎ"],[16,1,"かみ"],[18,1,"ぎ"],[20,1,"あき"],[34,1,"い"],[40,1,"いか"],[43,1,"くだ"],[45,1,"かみ"],[48,2,"ふぎ"],[54,1,"い"],[62,2,"にんげん"],[64,1,"てき"],[66,1,"い"],[68,1,"かた"]],"text":"しかし、もしわたしたちの不義が、神の義を明らかにするとしたら、なんと言うべきか。怒りを下す神は、不義であると言うのか（これは人間的な言い方ではある）。"},{"ref":"Rom.3.6","start":45003006,"end":45003006,"break":"none","ruby":[[0,1,"だん"],[20,1,"かみ"],[24,1,"よ"]],"text":"断じてそうではない。もしそうであったら、神はこの世を、どうさばかれるだろうか。"},{"ref":"Rom.3.7","start":45003007,"end":45003007,"break":"none","ruby":[[6,1,"かみ"],[8,2,"しんじつ"],[16,1,"いつわ"],[25,1,"あき"],[33,1,"かみ"],[35,2,"えいこう"],[55,2,"つみびと"]],"text":"しかし、もし神の真実が、わたしの偽りによりいっそう明らかにされて、神の栄光となるなら、どうして、わたしはなおも罪人としてさばかれるのだろうか。"},{"ref":"Rom.3.8","start":45003008,"end":45003008,"break":"none","ruby":[[5,1,"ぜん"],[22,1,"あく"],[42,1,"い"],[51,2,"ひとびと"],[62,1,"かれ"],[65,1,"ばっ"],[72,2,"とうぜん"]],"text":"むしろ、「善をきたらせるために、わたしたちは悪をしようではないか」（わたしたちがそう言っていると、ある人々はそしっている）。彼らが罰せられるのは当然である。"},{"ref":"Rom.3.9","start":45003009,"end":45003009,"break":"paragraph","ruby":[[18,1,"なに"],[33,2,"ぜったい"],[42,1,"じん"],[48,1,"じん"],[56,1,"つみ"],[58,1,"もと"],[75,2,"してき"]],"text":"すると、どうなるのか。わたしたちには何かまさったところがあるのか。絶対にない。ユダヤ人もギリシヤ人も、ことごとく罪の下にあることを、わたしたちはすでに指摘した。"},{"ref":"Rom.3.10","start":45003010,"end":45003010,"break":"none","breaks":[[11,"stanza"]],"ruby":[[0,1,"つぎ"],[5,1,"か"],[12,2,"ぎじん"]],"text":"次のように書いてある、「義人はいない、ひとりもいない。"},{"ref":"Rom.3.11","start":45003011,"end":45003011,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"さと"],[5,1,"ひと"],[11,1,"かみ"],[13,1,"もと"],[16,1,"ひと"]],"text":"悟りのある人はいない、神を求める人はいない。"},{"ref":"Rom.3.12","start":45003012,"end":45003012,"break":"line","breaks":[[11,"line"],[28,"line"],[38,"line"]],"ruby":[[4,1,"ひと"],[6,1,"まよ"],[8,1,"で"],[16,2,"むえき"],[28,1,"ぜん"],[30,1,"おこな"],[32,1,"もの"]],"text":"すべての人は迷い出て、ことごとく無益なものになっている。善を行う者はいない、ひとりもいない。"},{"ref":"Rom.3.13","start":45003013,"end":45003013,"break":"line","breaks":[[15,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[7,1,"ひら"],[10,1,"はか"],[15,1,"かれ"],[21,1,"した"],[23,1,"ひと"],[25,1,"あざむ"],[28,1,"かれ"],[42,1,"どく"]],"text":"彼らののどは、開いた墓であり、彼らは、その舌で人を欺き、彼らのくちびるには、まむしの毒があり、"},{"ref":"Rom.3.14","start":45003014,"end":45003014,"break":"line","ruby":[[0,1,"かれ"],[3,1,"くち"],[10,1,"にが"],[12,2,"ことば"],[16,1,"み"]],"text":"彼らの口は、のろいと苦い言葉とで満ちている。"},{"ref":"Rom.3.15","start":45003015,"end":45003015,"break":"line","ruby":[[0,1,"かれ"],[3,1,"あし"],[6,1,"ち"],[8,1,"なが"],[12,1,"はや"]],"text":"彼らの足は、血を流すのに速く、"},{"ref":"Rom.3.16","start":45003016,"end":45003016,"break":"line","ruby":[[0,1,"かれ"],[3,1,"みち"],[7,2,"はかい"],[10,2,"ひさん"]],"text":"彼らの道には、破壊と悲惨とがある。"},{"ref":"Rom.3.17","start":45003017,"end":45003017,"break":"line","ruby":[[4,1,"かれ"],[7,2,"へいわ"],[10,1,"みち"],[12,1,"し"]],"text":"そして、彼らは平和の道を知らない。"},{"ref":"Rom.3.18","start":45003018,"end":45003018,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"め"],[5,1,"まえ"],[9,1,"かみ"],[11,1,"たい"],[14,1,"おそ"]],"text":"彼らの目の前には、神に対する恐れがない」。"},{"ref":"Rom.3.19","start":45003019,"end":45003019,"break":"none","ruby":[[9,1,"し"],[21,2,"りっぽう"],[24,1,"い"],[31,2,"りっぽう"],[39,1,"もの"],[43,1,"たい"],[46,1,"かた"],[61,1,"くち"],[68,1,"ぜん"],[69,2,"せかい"],[72,1,"かみ"],[78,1,"ふく"]],"text":"さて、わたしたちが知っているように、すべて律法の言うところは、律法のもとにある者たちに対して語られている。それは、すべての口がふさがれ、全世界が神のさばきに服するためである。"},{"ref":"Rom.3.20","start":45003020,"end":45003020,"break":"none","ruby":[[5,2,"りっぽう"],[8,1,"おこな"],[22,2,"にんげん"],[25,1,"かみ"],[27,1,"まえ"],[29,1,"ぎ"],[42,2,"りっぽう"],[50,1,"つみ"],[52,2,"じかく"],[55,1,"しょう"]],"text":"なぜなら、律法を行うことによっては、すべての人間は神の前に義とせられないからである。律法によっては、罪の自覚が生じるのみである。"},{"ref":"Rom.3.21","start":45003021,"end":45003021,"break":"paragraph","ruby":[[3,1,"いま"],[6,1,"かみ"],[8,1,"ぎ"],[11,2,"りっぽう"],[15,1,"べつ"],[21,2,"りっぽう"],[24,3,"よげんしゃ"],[39,1,"あらわ"]],"text":"しかし今や、神の義が、律法とは別に、しかも律法と預言者とによってあかしされて、現された。"},{"ref":"Rom.3.22","start":45003022,"end":45003022,"break":"none","ruby":[[13,1,"しん"],[16,2,"しんこう"],[21,1,"かみ"],[23,1,"ぎ"],[32,1,"しん"],[35,1,"ひと"],[37,1,"あた"],[56,2,"さべつ"]],"text":"それは、イエス・キリストを信じる信仰による神の義であって、すべて信じる人に与えられるものである。そこにはなんらの差別もない。"},{"ref":"Rom.3.23","start":45003023,"end":45003023,"break":"none","ruby":[[9,1,"ひと"],[11,1,"つみ"],[13,1,"おか"],[19,1,"かみ"],[21,2,"えいこう"],[24,1,"う"]],"text":"すなわち、すべての人は罪を犯したため、神の栄光を受けられなくなっており、"},{"ref":"Rom.3.24","start":45003024,"end":45003024,"break":"none","ruby":[[0,1,"かれ"],[4,1,"あたい"],[9,1,"かみ"],[11,1,"めぐ"],[36,1,"ぎ"]],"text":"彼らは、価なしに、神の恵みにより、キリスト・イエスによるあがないによって義とされるのである。"},{"ref":"Rom.3.25","start":45003025,"end":45003025,"break":"none","ruby":[[0,1,"かみ"],[9,1,"た"],[15,1,"ち"],[20,2,"しんこう"],[26,1,"う"],[35,1,"そな"],[37,1,"もの"],[46,1,"かみ"],[48,1,"ぎ"],[50,1,"しめ"],[64,1,"いま"],[68,1,"おか"],[72,1,"つみ"],[75,1,"かみ"],[77,2,"にんたい"],[83,1,"み"]],"text":"神はこのキリストを立てて、その血による、信仰をもって受くべきあがないの供え物とされた。それは神の義を示すためであった。すなわち、今までに犯された罪を、神は忍耐をもって見のがしておられたが、"},{"ref":"Rom.3.26","start":45003026,"end":45003026,"break":"none","ruby":[[4,1,"いま"],[6,1,"とき"],[9,1,"かみ"],[11,1,"ぎ"],[13,1,"しめ"],[27,1,"かみ"],[33,1,"ぎ"],[46,1,"しん"],[49,1,"もの"],[51,1,"ぎ"]],"text":"それは、今の時に、神の義を示すためであった。こうして、神みずからが義となり、さらに、イエスを信じる者を義とされるのである。"},{"ref":"Rom.3.27","start":45003027,"end":45003027,"break":"none","ruby":[[13,1,"ほこり"],[20,1,"まった"],[28,2,"ほうそく"],[36,1,"おこな"],[39,2,"ほうそく"],[54,2,"しんこう"],[57,2,"ほうそく"]],"text":"すると、どこにわたしたちの誇があるのか。全くない。なんの法則によってか。行いの法則によってか。そうではなく、信仰の法則によってである。"},{"ref":"Rom.3.28","start":45003028,"end":45003028,"break":"none","ruby":[[9,1,"おも"],[12,1,"ひと"],[14,1,"ぎ"],[22,2,"りっぽう"],[25,1,"おこな"],[36,2,"しんこう"]],"text":"わたしたちは、こう思う。人が義とされるのは、律法の行いによるのではなく、信仰によるのである。"},{"ref":"Rom.3.29","start":45003029,"end":45003029,"break":"none","ruby":[[5,1,"かみ"],[10,1,"じん"],[14,1,"かみ"],[24,3,"いほうじん"],[28,1,"かみ"],[39,1,"たし"],[43,3,"いほうじん"],[47,1,"かみ"]],"text":"それとも、神はユダヤ人だけの神であろうか。また、異邦人の神であるのではないか。確かに、異邦人の神でもある。"},{"ref":"Rom.3.30","start":45003030,"end":45003030,"break":"none","ruby":[[5,1,"かみ"],[7,2,"ゆいいつ"],[14,2,"かつれい"],[19,1,"もの"],[21,2,"しんこう"],[27,1,"ぎ"],[34,1,"む"],[35,2,"かつれい"],[38,1,"もの"],[41,2,"しんこう"],[47,1,"ぎ"]],"text":"まことに、神は唯一であって、割礼のある者を信仰によって義とし、また、無割礼の者をも信仰のゆえに義とされるのである。"},{"ref":"Rom.3.31","start":45003031,"end":45003031,"break":"none","ruby":[[4,2,"しんこう"],[17,2,"りっぽう"],[20,2,"むこう"],[31,1,"だん"],[52,2,"りっぽう"],[55,2,"かくりつ"]],"text":"すると、信仰のゆえに、わたしたちは律法を無効にするのであるか。断じてそうではない。かえって、それによって律法を確立するのである。"}]