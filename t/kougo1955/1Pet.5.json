[{"ref":"1Pet.5.1","start":60005001,"end":60005001,"break":"paragraph","ruby":[[13,2,"ちょうろう"],[18,1,"すす"],[27,2,"ちょうろう"],[40,2,"くなん"],[47,2,"しょうにん"],[59,1,"あらわ"],[66,2,"えいこう"],[73,1,"もの"]],"text":"そこで、あなたがたのうちの長老たちに勧める。わたしも、長老のひとりで、キリストの苦難についての証人であり、また、やがて現れようとする栄光にあずかる者である。"},{"ref":"1Pet.5.2","start":60005002,"end":60005002,"break":"none","ruby":[[14,1,"かみ"],[16,1,"ひつじ"],[18,1,"む"],[21,1,"ぼく"],[40,1,"かみ"],[42,1,"したが"],[45,1,"みずか"],[47,1,"すす"],[53,1,"は"],[57,2,"りとく"],[67,2,"ほんしん"]],"text":"あなたがたにゆだねられている神の羊の群れを牧しなさい。しいられてするのではなく、神に従って自ら進んでなし、恥ずべき利得のためではなく、本心から、それをしなさい。"},{"ref":"1Pet.5.3","start":60005003,"end":60005003,"break":"none","ruby":[[9,1,"もの"],[13,1,"うえ"],[15,2,"けんりょく"],[33,1,"む"],[36,2,"もはん"]],"text":"また、ゆだねられた者たちの上に権力をふるうことをしないで、むしろ、群れの模範となるべきである。"},{"ref":"1Pet.5.4","start":60005004,"end":60005004,"break":"none","ruby":[[6,3,"だいぼくしゃ"],[10,1,"あらわ"],[13,1,"とき"],[25,2,"えいこう"],[28,1,"かんむり"],[30,1,"う"]],"text":"そうすれば、大牧者が現れる時には、しぼむことのない栄光の冠を受けるであろう。"},{"ref":"1Pet.5.5","start":60005005,"end":60005005,"break":"none","ruby":[[0,1,"おな"],[6,1,"わか"],[8,1,"ひと"],[13,2,"ちょうろう"],[18,1,"したが"],[29,1,"たがい"],[31,2,"けんそん"],[34,1,"み"],[42,1,"かみ"],[44,1,"たか"],[47,1,"もの"],[59,1,"もの"],[61,1,"めぐ"],[64,1,"たま"]],"text":"同じように、若い人たちよ。長老たちに従いなさい。また、みな互に謙遜を身につけなさい。神は高ぶる者をしりぞけ、へりくだる者に恵みを賜うからである。"},{"ref":"1Pet.5.6","start":60005006,"end":60005006,"break":"paragraph","ruby":[[11,1,"かみ"],[13,2,"ちからづよ"],[16,1,"み"],[17,1,"て"],[19,1,"もと"],[22,1,"みずか"],[25,1,"ひく"],[32,1,"とき"],[34,1,"く"],[37,1,"かみ"],[45,1,"たか"],[49,1,"くだ"]],"text":"だから、あなたがたは、神の力強い御手の下に、自らを低くしなさい。時が来れば神はあなたがたを高くして下さるであろう。"},{"ref":"1Pet.5.7","start":60005007,"end":60005007,"break":"none","ruby":[[0,1,"かみ"],[15,1,"くだ"],[25,2,"じぶん"],[28,1,"おも"],[40,1,"かみ"]],"text":"神はあなたがたをかえりみていて下さるのであるから、自分の思いわずらいを、いっさい神にゆだねるがよい。"},{"ref":"1Pet.5.8","start":60005008,"end":60005008,"break":"none","ruby":[[0,1,"み"],[2,1,"つつし"],[5,1,"め"],[22,1,"てき"],[26,2,"あくま"],[42,1,"く"],[52,1,"もと"],[55,1,"ある"],[57,1,"まわ"]],"text":"身を慎み、目をさましていなさい。あなたがたの敵である悪魔が、ほえたけるししのように、食いつくすべきものを求めて歩き回っている。"},{"ref":"1Pet.5.9","start":60005009,"end":60005009,"break":"none","ruby":[[2,2,"あくま"],[9,2,"しんこう"],[15,1,"た"],[19,2,"ていこう"],[34,1,"し"],[43,1,"ぜん"],[44,2,"せかい"],[55,2,"きょうだい"],[61,1,"おな"],[66,1,"くる"],[70,2,"かずかず"],[73,1,"あ"]],"text":"この悪魔にむかい、信仰にかたく立って、抵抗しなさい。あなたがたのよく知っているとおり、全世界にいるあなたがたの兄弟たちも、同じような苦しみの数々に会っているのである。"},{"ref":"1Pet.5.10","start":60005010,"end":60005010,"break":"none","ruby":[[13,2,"えいえん"],[16,2,"えいこう"],[19,1,"まね"],[21,1,"い"],[24,1,"くだ"],[32,1,"めぐ"],[35,1,"かみ"],[43,1,"くる"],[47,1,"のち"],[59,1,"つよ"],[62,1,"ちから"],[66,2,"ふどう"],[74,1,"くだ"]],"text":"あなたがたをキリストにある永遠の栄光に招き入れて下さったあふるる恵みの神は、しばらくの苦しみの後、あなたがたをいやし、強め、力づけ、不動のものとして下さるであろう。"},{"ref":"1Pet.5.11","start":60005011,"end":60005011,"break":"none","ruby":[[4,1,"ちから"],[6,2,"よよ"],[8,1,"かぎ"],[13,1,"かみ"]],"text":"どうか、力が世々限りなく、神にあるように、アァメン。"},{"ref":"1Pet.5.12","start":60005012,"end":60005012,"break":"paragraph","ruby":[[5,2,"ちゅうじつ"],[8,2,"きょうだい"],[13,2,"しんらい"],[24,1,"て"],[32,1,"みじか"],[34,2,"てがみ"],[47,1,"すす"],[58,1,"かみ"],[64,1,"めぐ"],[80,1,"めぐ"],[90,1,"た"]],"text":"わたしは、忠実な兄弟として信頼しているシルワノの手によって、この短い手紙をあなたがたにおくり、勧めをし、また、これが神のまことの恵みであることをあかしした。この恵みのうちに、かたく立っていなさい。"},{"ref":"1Pet.5.13","start":60005013,"end":60005013,"break":"none","ruby":[[6,1,"とも"],[8,1,"えら"],[19,2,"きょうかい"],[31,1,"こ"]],"text":"あなたがたと共に選ばれてバビロンにある教会、ならびに、わたしの子マルコから、あなたがたによろしく。"},{"ref":"1Pet.5.14","start":60005014,"end":60005014,"break":"none","breaks":[[22,"paragraph"]],"ruby":[[0,1,"あい"],[2,2,"せっぷん"],[8,1,"たがい"],[34,2,"いちどう"],[38,2,"へいあん"]],"text":"愛の接吻をもって互にあいさつをかわしなさい。キリストにあるあなたがた一同に、平安があるように。"}]