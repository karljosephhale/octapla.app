[{"ref":"Ps.149.1","start":19149001,"end":19149001,"break":"paragraph","breaks":[[9,"line"],[24,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"しゅ"],[15,1,"あたら"],[18,1,"うた"],[24,2,"せいと"],[32,1,"しゅ"],[34,1,"ほまれ"],[36,1,"うた"]],"text":"主をほめたたえよ。主にむかって新しい歌をうたえ。聖徒のつどいで、主の誉を歌え。"},{"ref":"Ps.149.2","start":19149002,"end":19149002,"break":"line","breaks":[[16,"line"]],"ruby":[[8,1,"つく"],[10,1,"ぬし"],[12,1,"よろこ"],[20,1,"こ"],[25,1,"おう"],[27,1,"よろこ"]],"text":"イスラエルにその造り主を喜ばせ、シオンの子らにその王を喜ばせよ。"},{"ref":"Ps.149.3","start":19149003,"end":19149003,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おど"],[9,1,"しゅ"],[12,1,"な"],[22,1,"つづみ"],[24,1,"こと"],[30,1,"しゅ"],[34,1,"うた"]],"text":"彼らに踊りをもって主のみ名をほめたたえさせ、鼓と琴とをもって主をほめ歌わせよ。"},{"ref":"Ps.149.4","start":19149004,"end":19149004,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"たみ"],[7,1,"よろこ"],[15,1,"もの"],[17,2,"しょうり"],[23,1,"かざ"]],"text":"主はおのが民を喜び、へりくだる者を勝利をもって飾られるからである。"},{"ref":"Ps.149.5","start":19149005,"end":19149005,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"せいと"],[3,2,"えいこう"],[9,1,"よろこ"],[15,1,"とこ"],[17,1,"うえ"],[19,1,"よろこ"],[21,1,"うた"]],"text":"聖徒を栄光によって喜ばせ、その床の上で喜び歌わせよ。"},{"ref":"Ps.149.6","start":19149006,"end":19149006,"break":"line","breaks":[[17,"line"]],"ruby":[[6,1,"かみ"],[12,1,"うた"],[19,1,"て"],[24,1,"は"]],"text":"そののどには神をあがめる歌があり、その手にはもろ刃のつるぎがある。"},{"ref":"Ps.149.7","start":19149007,"end":19149007,"break":"line","breaks":[[16,"line"]],"ruby":[[8,1,"くに"],[13,1,"かえ"],[21,1,"たみ"],[23,1,"こ"]],"text":"これはもろもろの国にあだを返し、もろもろの民を懲らし、"},{"ref":"Ps.149.8","start":19149008,"end":19149008,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おう"],[7,1,"くさり"],[9,1,"しば"],[12,1,"かれ"],[15,2,"きじん"],[20,1,"てつ"],[25,1,"しば"]],"text":"彼らの王たちを鎖で縛り、彼らの貴人たちを鉄のかせで縛りつけ、"},{"ref":"Ps.149.9","start":19149009,"end":19149009,"break":"line","breaks":[[20,"line"],[42,"line"]],"ruby":[[9,1,"かれ"],[12,1,"おこな"],[29,2,"せいと"],[32,1,"あた"],[37,1,"ほまれ"],[42,1,"しゅ"]],"text":"しるされたさばきを彼らに行うためである。これはそのすべての聖徒に与えられる誉である。主をほめたたえよ。"}]