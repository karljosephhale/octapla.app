[{"ref":"Ps.20.1","start":19020001,"end":19020001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"なや"],[5,1,"ひ"],[11,1,"こた"],[18,1,"かみ"],[21,1,"な"],[27,1,"まも"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"主が悩みの日にあなたに答え、ヤコブの神のみ名があなたを守られるように。"},{"ref":"Ps.20.2","start":19020002,"end":19020002,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"せいじょ"],[6,1,"たす"]],"text":"主が聖所から助けをあなたにおくり、シオンからあなたをささえ、"},{"ref":"Ps.20.3","start":19020003,"end":19020003,"break":"line","breaks":[[19,"line"]],"ruby":[[9,1,"そな"],[11,1,"もの"],[14,1,"こころ"],[23,2,"はんさい"]],"text":"あなたのもろもろの供え物をみ心にとめ、あなたの燔祭をうけられるように。〔セラ"},{"ref":"Ps.20.4","start":19020004,"end":19020004,"break":"line","breaks":[[15,"line"],[25,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"こころ"],[8,1,"ねが"],[30,1,"と"]],"text":"主があなたの心の願いをゆるし、あなたのはかりごとをことごとく遂げさせられるように。"},{"ref":"Ps.20.5","start":19020005,"end":19020005,"break":"line","breaks":[[17,"line"],[38,"line"]],"ruby":[[8,2,"しょうり"],[11,1,"よろこ"],[21,1,"かみ"],[24,1,"な"],[29,1,"はた"],[31,1,"あ"],[38,1,"しゅ"],[44,1,"もと"],[50,1,"と"]],"text":"われらがあなたの勝利を喜びうたい、われらの神のみ名によって旗を揚げるように。主があなたの求めをすべて遂げさせられるように。"},{"ref":"Ps.20.6","start":19020006,"end":19020006,"break":"line","breaks":[[8,"line"],[29,"line"],[49,"line"]],"ruby":[[0,1,"いま"],[5,1,"し"],[8,1,"しゅ"],[12,1,"あぶら"],[18,1,"もの"],[20,1,"たす"],[29,1,"しゅ"],[33,1,"みぎ"],[35,1,"て"],[39,1,"おお"],[43,2,"しょうり"],[51,1,"せい"],[54,1,"てん"],[57,1,"かれ"],[59,1,"こた"]],"text":"今わたしは知る、主はその油そそがれた者を助けられることを。主はその右の手による大いなる勝利をもってその聖なる天から彼に答えられるであろう。"},{"ref":"Ps.20.7","start":19020007,"end":19020007,"break":"line","breaks":[[19,"line"],[33,"line"]],"ruby":[[2,1,"もの"],[4,2,"せんしゃ"],[7,1,"ほこ"],[12,1,"もの"],[14,1,"うま"],[16,1,"ほこ"],[31,1,"かみ"],[33,1,"しゅ"],[36,1,"な"],[38,1,"ほこ"]],"text":"ある者は戦車を誇り、ある者は馬を誇る。しかしわれらは、われらの神、主のみ名を誇る。"},{"ref":"Ps.20.8","start":19020008,"end":19020008,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[9,1,"たお"],[20,1,"お"],[29,1,"た"]],"text":"彼らはかがみ、また倒れる。しかしわれらは起きて、まっすぐに立つ。"},{"ref":"Ps.20.9","start":19020009,"end":19020009,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"おう"],[5,2,"しょうり"],[21,1,"よ"],[25,1,"とき"],[32,1,"こた"]],"text":"主よ、王に勝利をおさずけください。われらが呼ばわる時、われらにお答えください。"}]