[{"ref":"Isa.62.1","start":23062001,"end":23062001,"break":"paragraph","breaks":[[6,"line"],[22,"line"],[45,"line"],[60,"line"]],"ruby":[[4,1,"ぎ"],[6,2,"あさひ"],[9,1,"かがや"],[28,1,"すくい"],[30,1,"も"],[38,1,"よう"],[56,1,"もく"],[69,1,"やす"]],"text":"シオンの義が朝日の輝きのようにあらわれいで、エルサレムの救が燃えるたいまつの様になるまで、わたしはシオンのために黙せず、エルサレムのために休まない。"},{"ref":"Isa.62.2","start":23062002,"end":23062002,"break":"line","breaks":[[15,"line"],[33,"line"],[50,"line"]],"ruby":[[5,1,"くに"],[11,1,"ぎ"],[13,1,"み"],[20,1,"おう"],[22,1,"みな"],[27,1,"さか"],[30,1,"み"],[41,1,"しゅ"],[43,1,"くち"],[45,1,"さだ"],[50,1,"あたら"],[53,1,"な"]],"text":"もろもろの国はあなたの義を見、もろもろの王は皆あなたの栄えを見る。そして、あなたは主の口が定められる新しい名をもってとなえられる。"},{"ref":"Isa.62.3","start":23062003,"end":23062003,"break":"line","breaks":[[21,"line"]],"ruby":[[7,1,"しゅ"],[9,1,"て"],[13,1,"うるわ"],[16,1,"かんむり"],[25,1,"かみ"],[27,1,"て"],[31,1,"おう"],[33,1,"かんむり"]],"text":"また、あなたは主の手にある麗しい冠となり、あなたの神の手にある王の冠となる。"},{"ref":"Isa.62.4","start":23062004,"end":23062004,"break":"line","breaks":[[21,"line"],[42,"line"],[65,"line"],[86,"line"],[96,"line"]],"ruby":[[8,1,"す"],[13,1,"もの"],[16,1,"い"],[25,1,"ち"],[31,1,"あ"],[34,1,"もの"],[37,1,"い"],[49,1,"よろこ"],[52,2,"かのじょ"],[69,1,"ち"],[72,2,"はいぐう"],[76,1,"もの"],[86,1,"しゅ"],[92,1,"よろこ"],[100,1,"ち"],[102,2,"はいぐう"],[105,1,"え"]],"text":"あなたはもはや「捨てられた者」と言われず、あなたの地はもはや「荒れた者」と言われず、あなたは「わが喜びは彼女にある」ととなえられ、あなたの地は「配偶ある者」ととなえられる。主はあなたを喜ばれ、あなたの地は配偶を得るからである。"},{"ref":"Isa.62.5","start":23062005,"end":23062005,"break":"line","breaks":[[13,"line"],[28,"line"],[39,"line"]],"ruby":[[0,1,"わか"],[2,1,"もの"],[4,2,"しょじょ"],[17,1,"こ"],[28,2,"はなむこ"],[31,2,"はなよめ"],[34,1,"よろこ"],[43,1,"かみ"],[49,1,"よろこ"]],"text":"若い者が処女をめとるようにあなたの子らはあなたをめとり、花婿が花嫁を喜ぶようにあなたの神はあなたを喜ばれる。"},{"ref":"Isa.62.6","start":23062006,"end":23062006,"break":"paragraph","breaks":[[7,"line"],[28,"line"],[51,"line"],[68,"line"]],"ruby":[[15,2,"じょうへき"],[18,1,"うえ"],[20,2,"みはり"],[22,1,"にん"],[28,1,"ひる"],[30,1,"よる"],[51,1,"しゅ"],[53,1,"おも"],[55,1,"だ"],[62,1,"もと"],[65,1,"もの"],[72,1,"やす"]],"text":"エルサレムよ、わたしはあなたの城壁の上に見張人をおいて、昼も夜もたえず、もだすことのないようにしよう。主に思い出されることを求める者よ、みずから休んではならない。"},{"ref":"Isa.62.7","start":23062007,"end":23062007,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"かた"],[10,1,"た"],[14,1,"ぜん"],[15,1,"ち"],[17,1,"ほまれ"],[19,1,"え"],[29,1,"やす"]],"text":"主がエルサレムを堅く立てて、全地に誉を得させられるまで、お休みにならぬようにせよ。"},{"ref":"Isa.62.8","start":23062008,"end":23062008,"break":"line","breaks":[[11,"line"],[26,"line"],[40,"line"],[56,"line"],[73,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"みぎ"],[6,1,"て"],[11,2,"たいのう"],[21,1,"ちか"],[31,1,"ふたた"],[37,2,"こくもつ"],[44,1,"てき"],[46,1,"あた"],[49,1,"た"],[63,1,"ろう"],[66,1,"え"],[71,1,"しゅ"],[73,3,"いほうじん"],[77,1,"あた"],[80,1,"の"]],"text":"主はその右の手をさし、大能のかいなをさして誓われた、「わたしは再びあなたの穀物をあなたの敵に与えて食べさせない。また、あなたが労して得たぶどう酒を異邦人に与えて飲ませない。"},{"ref":"Isa.62.9","start":23062009,"end":23062009,"break":"line","breaks":[[14,"line"],[28,"line"],[37,"line"]],"ruby":[[4,2,"こくもつ"],[7,1,"か"],[9,1,"い"],[12,1,"もの"],[17,1,"た"],[20,1,"しゅ"],[32,1,"あつ"],[35,1,"もの"],[39,2,"せいじょ"],[42,1,"にわ"],[47,1,"の"]],"text":"しかし、穀物を刈り入れた者はこれを食べて主をほめたたえ、ぶどうを集めた者はわが聖所の庭でこれを飲む」。"},{"ref":"Isa.62.10","start":23062010,"end":23062010,"break":"paragraph","breaks":[[14,"line"],[22,"line"],[39,"line"],[46,"line"]],"ruby":[[0,1,"もん"],[2,1,"とお"],[5,1,"い"],[8,1,"とお"],[11,1,"い"],[14,1,"たみ"],[16,1,"みち"],[18,1,"そな"],[22,1,"つち"],[24,1,"も"],[27,1,"つち"],[29,1,"も"],[32,2,"おおじ"],[35,1,"もう"],[39,1,"いし"],[41,1,"と"],[51,1,"たみ"],[53,1,"うえ"],[55,1,"はた"]],"text":"門を通って行け、通って行け。民の道を備えよ。土を盛り、土を盛って大路を設けよ。石を取りのけ。もろもろの民の上に旗をあげよ。"},{"ref":"Isa.62.11","start":23062011,"end":23062011,"break":"line","breaks":[[19,"line"],[29,"line"],[42,"line"],[57,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,1,"ち"],[7,1,"はて"],[11,1,"つ"],[14,1,"い"],[24,1,"むすめ"],[26,1,"い"],[30,1,"み"],[37,1,"すくい"],[39,1,"く"],[42,1,"み"],[47,1,"むく"],[50,1,"しゅ"],[52,1,"とも"],[59,1,"はたら"],[62,1,"むく"],[68,1,"まえ"]],"text":"見よ、主は地の果にまで告げて言われた、「シオンの娘に言え、『見よ、あなたの救は来る。見よ、その報いは主と共にあり、その働きの報いは、その前にある』と。"},{"ref":"Isa.62.12","start":23062012,"end":23062012,"break":"line","breaks":[[9,"line"],[26,"line"],[42,"line"]],"ruby":[[0,1,"かれ"],[4,1,"せい"],[7,1,"たみ"],[9,1,"しゅ"],[17,1,"もの"],[31,1,"ひと"],[33,1,"たず"],[35,1,"もと"],[40,1,"もの"],[42,1,"す"],[48,1,"まち"]],"text":"彼らは『聖なる民、主にあがなわれた者』ととなえられ、あなたは『人に尋ね求められる者、捨てられない町』ととなえられる」。"}]