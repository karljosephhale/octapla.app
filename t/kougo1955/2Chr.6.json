[{"ref":"2Chr.6.1","start":14006001,"end":14006001,"break":"paragraph","breaks":[[12,"stanza"]],"ruby":[[8,1,"い"],[13,1,"しゅ"],[19,1,"こ"],[21,1,"くも"],[23,1,"なか"],[25,1,"す"],[30,1,"い"]],"text":"そこでソロモンは言った、「主はみずから濃き雲の中に住まおうと言われた。"},{"ref":"2Chr.6.2","start":14006002,"end":14006002,"break":"line","breaks":[[18,"line"]],"ruby":[[14,1,"たか"],[16,1,"いえ"],[28,1,"た"]],"text":"しかしわたしはあなたのために高き家、とこしえのみすまいを建てた」。"},{"ref":"2Chr.6.3","start":14006003,"end":14006003,"break":"none","ruby":[[3,1,"おう"],[5,1,"かお"],[9,1,"む"],[18,1,"ぜん"],[19,2,"かいしゅう"],[22,2,"しゅくふく"],[29,1,"とき"],[36,1,"ぜん"],[37,2,"かいしゅう"],[40,1,"た"]],"text":"そして王は顔をふり向けてイスラエルの全会衆を祝福した。その時イスラエルの全会衆は立っていた。"},{"ref":"2Chr.6.4","start":14006004,"end":14006004,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[13,1,"かみ"],[15,1,"しゅ"],[24,1,"しゅ"],[26,1,"くち"],[33,1,"ちち"],[38,2,"やくそく"],[49,1,"て"],[56,1,"と"],[66,1,"しゅ"],[68,1,"い"]],"text":"彼は言った、「イスラエルの神、主はほむべきかな。主は口をもってわが父ダビデに約束されたことを、その手をもってなし遂げられた。すなわち主は言われた、"},{"ref":"2Chr.6.5","start":14006005,"end":14006005,"break":"none","ruby":[[3,1,"たみ"],[10,1,"ち"],[13,1,"みちび"],[15,1,"だ"],[18,1,"ひ"],[28,1,"な"],[30,1,"お"],[34,1,"いえ"],[36,1,"た"],[54,2,"ぶぞく"],[64,1,"まち"],[67,1,"えら"],[78,1,"た"],[86,1,"たみ"],[93,1,"きみ"],[97,1,"えら"]],"text":"『わが民をエジプトの地から導き出した日から、わたしはわが名を置くべき家を建てるために、イスラエルのもろもろの部族のうちから、どの町をも選んだことがなく、また他のだれをもわが民イスラエルの君として選んだことがない。"},{"ref":"2Chr.6.6","start":14006006,"end":14006006,"break":"none","ruby":[[2,1,"な"],[4,1,"お"],[20,1,"えら"],[27,1,"たみ"],[34,1,"おさ"],[51,1,"えら"]],"text":"わが名を置くために、ただエルサレムだけを選び、またわが民イスラエルを治めさせるために、ただダビデだけを選んだ』。"},{"ref":"2Chr.6.7","start":14006007,"end":14006007,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"な"],[15,1,"いえ"],[17,1,"た"],[24,1,"ちち"],[29,1,"こころ"]],"text":"イスラエルの神、主の名のために家を建てることは、父ダビデの心にあった。"},{"ref":"2Chr.6.8","start":14006008,"end":14006008,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"ちち"],[10,1,"い"],[20,1,"な"],[25,1,"いえ"],[27,1,"た"],[37,1,"こころ"],[47,1,"こころ"],[51,1,"こと"],[58,2,"けっこう"]],"text":"しかし主は父ダビデに言われた、『わたしの名のために家を建てることはあなたの心にあった。あなたの心にこの事のあったのは結構である。"},{"ref":"2Chr.6.9","start":14006009,"end":14006009,"break":"none","ruby":[[9,1,"いえ"],[11,1,"た"],[24,1,"こし"],[27,1,"で"],[33,1,"こ"],[39,1,"な"],[44,1,"いえ"],[46,1,"た"]],"text":"しかしあなたはその家を建ててはならない。あなたの腰から出るあなたの子がわたしの名のために家を建てるであろう』。"},{"ref":"2Chr.6.10","start":14006010,"end":14006010,"break":"none","ruby":[[3,1,"しゅ"],[7,1,"い"],[11,2,"ことば"],[14,1,"おこな"],[27,1,"ちち"],[32,1,"かわ"],[35,1,"た"],[38,1,"しゅ"],[40,1,"い"],[54,1,"くらい"],[56,1,"ざ"],[65,1,"かみ"],[67,1,"しゅ"],[69,1,"な"],[74,1,"いえ"],[76,1,"た"]],"text":"そして主はそう言われた言葉を行われた。すなわちわたしは父ダビデに代って立ち、主が言われたように、イスラエルの位に座し、イスラエルの神、主の名のために家を建てた。"},{"ref":"2Chr.6.11","start":14006011,"end":14006011,"break":"none","ruby":[[7,1,"しゅ"],[15,2,"ひとびと"],[18,1,"むす"],[22,1,"しゅ"],[24,2,"けいやく"],[27,1,"い"],[30,1,"はこ"],[35,1,"おさ"]],"text":"わたしはまた、主がイスラエルの人々と結ばれた主の契約を入れた箱をそこに納めた」。"},{"ref":"2Chr.6.12","start":14006012,"end":14006012,"break":"paragraph","ruby":[[11,1,"ぜん"],[12,2,"かいしゅう"],[15,1,"まえ"],[17,1,"しゅ"],[19,2,"さいだん"],[22,1,"まえ"],[24,1,"た"],[28,1,"て"],[30,1,"の"]],"text":"ソロモンはイスラエルの全会衆の前、主の祭壇の前に立って、手を伸べた。"},{"ref":"2Chr.6.13","start":14006013,"end":14006013,"break":"none","ruby":[[8,1,"なが"],[16,1,"はば"],[23,1,"たか"],[31,2,"せいどう"],[34,1,"だい"],[36,1,"つく"],[40,1,"にわ"],[44,1,"なか"],[49,1,"お"],[55,1,"かれ"],[59,1,"うえ"],[61,1,"た"],[70,1,"ぜん"],[71,2,"かいしゅう"],[74,1,"まえ"],[85,1,"て"],[87,1,"てん"],[89,1,"の"]],"text":"ソロモンはさきに長さ五キュビト、幅五キュビト、高さ三キュビトの青銅の台を造って、庭のまん中にすえて置いたので、彼はその上に立ち、イスラエルの全会衆の前でひざをかがめ、その手を天に伸べて、"},{"ref":"2Chr.6.14","start":14006014,"end":14006014,"break":"none","ruby":[[0,1,"い"],[11,1,"かみ"],[13,1,"しゅ"],[16,1,"てん"],[19,1,"ち"],[30,1,"かみ"],[42,2,"けいやく"],[45,1,"まも"],[49,1,"こころ"],[59,1,"まえ"],[61,1,"あゆ"],[79,1,"ほどこ"]],"text":"言った、「イスラエルの神、主よ、天にも地にも、あなたのような神はありません。あなたは契約を守られ、心をつくしてあなたの前に歩むあなたのしもべらに、いつくしみを施し、"},{"ref":"2Chr.6.15","start":14006015,"end":14006015,"break":"none","ruby":[[12,1,"ちち"],[17,2,"やくそく"],[25,1,"まも"],[36,1,"くち"],[41,2,"やくそく"],[50,1,"て"],[57,1,"と"],[66,2,"こんにち"],[68,1,"み"]],"text":"あなたのしもべ、わたしの父ダビデに約束されたことを守られました。あなたが口をもって約束されたことを、手をもってなし遂げられたことは、今日見るとおりであります。"},{"ref":"2Chr.6.16","start":14006016,"end":14006016,"break":"none","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[28,1,"ちち"],[38,2,"やくそく"],[52,1,"まえ"],[54,1,"あゆ"],[65,2,"しそん"],[70,1,"みち"],[72,1,"つつし"],[84,1,"あゆ"],[101,1,"くらい"],[103,1,"ざ"],[106,1,"ひと"],[112,1,"まえ"],[114,1,"か"],[124,1,"い"],[140,1,"まも"]],"text":"それゆえ、イスラエルの神、主よ、あなたのしもべ、わたしの父ダビデに、あなたが約束して、『おまえがわたしの前に歩んだように、おまえの子孫がその道を慎んで、わたしのおきてに歩むならば、おまえにはイスラエルの位に座する人がわたしの前に欠けることはない』と言われたことを、ダビデのためにお守りください。"},{"ref":"2Chr.6.17","start":14006017,"end":14006017,"break":"none","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[31,1,"い"],[35,2,"ことば"],[38,2,"かくにん"]],"text":"それゆえ、イスラエルの神、主よ、どうぞ、あなたのしもべダビデに言われた言葉を確認してください。"},{"ref":"2Chr.6.18","start":14006018,"end":14006018,"break":"paragraph","ruby":[[3,1,"かみ"],[10,1,"ひと"],[12,1,"とも"],[14,2,"ちじょう"],[17,1,"す"],[28,1,"み"],[31,1,"てん"],[36,1,"たか"],[38,1,"てん"],[60,1,"た"],[65,1,"いえ"]],"text":"しかし神は、はたして人と共に地上に住まわれるでしょうか。見よ、天も、いと高き天もあなたをいれることはできません。わたしの建てたこの家などなおさらです。"},{"ref":"2Chr.6.19","start":14006019,"end":14006019,"break":"none","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[14,1,"いのり"],[16,1,"ねが"],[19,1,"かえり"],[31,1,"まえ"],[37,1,"さけ"],[40,1,"いのり"],[43,1,"き"]],"text":"しかしわが神、主よ、しもべの祈と願いを顧みて、しもべがあなたの前にささげる叫びと祈をお聞きください。"},{"ref":"2Chr.6.20","start":14006020,"end":14006020,"break":"none","ruby":[[8,1,"め"],[10,1,"ひる"],[12,1,"よる"],[16,1,"いえ"],[28,1,"な"],[33,1,"お"],[36,1,"い"],[40,1,"ところ"],[42,1,"む"],[47,1,"ひら"],[64,1,"ところ"],[66,1,"む"],[74,1,"いのり"],[77,1,"き"]],"text":"どうぞ、あなたの目を昼も夜もこの家に、すなわち、あなたの名をそこに置くと言われた所に向かってお開きください。どうぞ、しもべがこの所に向かってささげる祈をお聞きください。"},{"ref":"2Chr.6.21","start":14006021,"end":14006021,"break":"none","ruby":[[13,1,"たみ"],[22,1,"ところ"],[24,1,"む"],[28,1,"いの"],[30,1,"とき"],[35,1,"ねが"],[39,1,"き"],[56,1,"てん"],[59,1,"き"],[62,1,"き"]],"text":"どうぞ、しもべと、あなたの民イスラエルがこの所に向かって祈る時に、その願いをお聞きください。あなたのすみかである天から聞き、聞いておゆるしください。"},{"ref":"2Chr.6.22","start":14006022,"end":14006022,"break":"paragraph","ruby":[[2,1,"ひと"],[6,1,"とな"],[8,1,"びと"],[10,1,"たい"],[13,1,"つみ"],[15,1,"おか"],[18,1,"ちか"],[26,1,"もと"],[34,1,"き"],[38,1,"みや"],[45,2,"さいだん"],[48,1,"まえ"],[50,1,"ちか"]],"text":"もし人がその隣り人に対して罪を犯し、誓いをすることを求められるとき、来てこの宮で、あなたの祭壇の前に誓うならば、"},{"ref":"2Chr.6.23","start":14006023,"end":14006023,"break":"none","ruby":[[4,1,"てん"],[7,1,"き"],[11,1,"おこな"],[27,2,"あくにん"],[30,1,"むく"],[39,1,"おこな"],[42,1,"むく"],[51,1,"き"],[54,2,"ぎじん"],[57,1,"ぎ"],[64,1,"ぎ"],[73,1,"ひと"],[75,1,"むく"]],"text":"あなたは天から聞いて、行い、あなたのしもべらをさばき、悪人に報いをなして、その行いの報いをそのこうべに帰し、義人を義として、その義にしたがってその人に報いてください。"},{"ref":"2Chr.6.24","start":14006024,"end":14006024,"break":"paragraph","ruby":[[6,1,"たみ"],[18,1,"たい"],[21,1,"つみ"],[23,1,"おか"],[30,1,"てき"],[32,1,"まえ"],[34,1,"やぶ"],[37,1,"とき"],[43,1,"た"],[45,1,"かえ"],[53,1,"な"],[61,1,"みや"],[67,1,"まえ"],[69,1,"いの"],[71,1,"ねが"]],"text":"もしあなたの民イスラエルが、あなたに対して罪を犯したために、敵の前に敗れた時、あなたに立ち返って、あなたの名をあがめ、この宮であなたの前に祈り願うならば、"},{"ref":"2Chr.6.25","start":14006025,"end":14006025,"break":"none","ruby":[[4,1,"てん"],[7,1,"き"],[14,1,"たみ"],[21,1,"つみ"],[32,1,"かれ"],[37,2,"せんぞ"],[40,1,"あた"],[45,1,"ち"],[47,1,"かれ"],[50,1,"かえ"]],"text":"あなたは天から聞き、あなたの民イスラエルの罪をゆるして、あなたが彼らとその先祖に与えられた地に彼らを帰らせてください。"},{"ref":"2Chr.6.26","start":14006026,"end":14006026,"break":"paragraph","ruby":[[2,1,"かれ"],[9,1,"つみ"],[11,1,"おか"],[18,1,"てん"],[20,1,"と"],[26,1,"あめ"],[35,1,"かれ"],[38,1,"くる"],[47,1,"かれ"],[52,1,"ところ"],[54,1,"む"],[58,1,"いの"],[65,1,"な"],[73,1,"つみ"],[75,1,"はな"]],"text":"もし彼らがあなたに罪を犯したために、天が閉ざされて、雨がなく、あなたが彼らを苦しめられるとき、彼らがこの所に向かって祈り、あなたの名をあがめ、その罪を離れるならば、"},{"ref":"2Chr.6.27","start":14006027,"end":14006027,"break":"none","ruby":[[4,1,"てん"],[9,1,"き"],[24,1,"たみ"],[31,1,"つみ"],[38,1,"かれ"],[41,1,"あゆ"],[45,1,"よ"],[47,1,"みち"],[49,1,"おし"],[56,1,"たみ"],[58,1,"し"],[59,1,"ぎょう"],[63,1,"たま"],[67,1,"ち"],[69,1,"あめ"],[71,1,"ふ"]],"text":"あなたは天にあって聞き、あなたのしもべ、あなたの民イスラエルの罪をゆるして、彼らに歩むべき良い道を教え、あなたの民に嗣業として賜わった地に雨を降らせてください。"},{"ref":"2Chr.6.28","start":14006028,"end":14006028,"break":"paragraph","ruby":[[2,1,"くに"],[16,2,"えきびょう"],[19,1,"た"],[21,1,"が"],[24,1,"くさ"],[26,1,"ほ"],[32,2,"あおむし"],[42,1,"てき"],[47,1,"まち"],[49,1,"もん"],[51,1,"なか"],[53,1,"せ"],[55,1,"かこ"],[69,2,"さいがい"],[75,2,"びょうき"]],"text":"もし国にききんがあるか、もしくは疫病、立ち枯れ、腐り穂、いなご、青虫があるか、または敵のために町の門の中に攻め囲まれることがあるか、どんな災害、どんな病気があっても、"},{"ref":"2Chr.6.29","start":14006029,"end":14006029,"break":"none","ruby":[[16,1,"たみ"],[23,1,"みな"],[30,1,"こころ"],[32,1,"なや"],[35,1,"し"],[41,1,"みや"],[43,1,"む"],[47,1,"て"],[49,1,"の"],[59,1,"いのり"],[64,1,"ねが"]],"text":"もし、ひとりか、あるいはあなたの民イスラエルが皆おのおのその心の悩みを知って、この宮に向かい、手を伸べるならば、どんな祈、どんな願いでも、"},{"ref":"2Chr.6.30","start":14006030,"end":14006030,"break":"none","ruby":[[12,1,"てん"],[15,1,"き"],[27,1,"ひと"],[32,1,"こころ"],[34,1,"し"],[50,1,"みち"],[57,1,"むく"],[77,1,"ひと"],[79,1,"こころ"],[81,1,"し"]],"text":"あなたはそのすみかである天から聞いてゆるし、おのおのの人に、その心を知っておられるゆえ、そのすべての道にしたがって報いてください。ただあなただけがすべての人の心を知っておられるからです。"},{"ref":"2Chr.6.31","start":14006031,"end":14006031,"break":"none","ruby":[[9,2,"せんぞ"],[14,1,"たま"],[18,1,"ち"],[21,1,"かれ"],[24,1,"い"],[31,1,"ひ"],[33,1,"あいだ"],[35,1,"つね"],[41,1,"おそ"],[50,1,"みち"],[52,1,"あゆ"]],"text":"あなたがわれわれの先祖たちに賜わった地に、彼らの生きながらえる日の間、常にあなたを恐れさせ、あなたの道に歩ませてください。"},{"ref":"2Chr.6.32","start":14006032,"end":14006032,"break":"paragraph","ruby":[[6,1,"たみ"],[13,1,"もの"],[18,2,"たこく"],[20,1,"じん"],[27,1,"おお"],[31,1,"な"],[34,1,"つよ"],[36,1,"て"],[39,1,"の"],[42,1,"うで"],[47,1,"とお"],[49,1,"くに"],[52,1,"き"],[57,1,"みや"],[59,1,"む"],[63,1,"いの"]],"text":"またあなたの民イスラエルの者でなく、他国人で、あなたの大いなる名と、強い手と、伸べた腕のために遠い国から来て、この宮に向かって祈るならば、"},{"ref":"2Chr.6.33","start":14006033,"end":14006033,"break":"none","ruby":[[15,1,"てん"],[18,1,"き"],[24,2,"たこく"],[26,1,"じん"],[32,1,"よ"],[34,1,"もと"],[52,1,"ち"],[58,1,"たみ"],[64,1,"たみ"],[79,1,"な"],[81,1,"し"],[88,1,"おそ"],[97,1,"た"],[102,1,"みや"],[109,1,"な"],[114,1,"よ"],[121,1,"し"]],"text":"あなたは、あなたのすみかである天から聞き、すべて他国人があなたに呼び求めるようにしてください。そうすれば地のすべての民はあなたの民イスラエルのように、あなたの名を知り、あなたを恐れ、またわたしが建てたこの宮が、あなたの名によって呼ばれることを知るにいたるでしょう。"},{"ref":"2Chr.6.34","start":14006034,"end":14006034,"break":"paragraph","ruby":[[4,1,"たみ"],[6,1,"てき"],[8,1,"たたか"],[24,1,"みち"],[29,1,"で"],[36,1,"かれ"],[43,1,"えら"],[49,1,"まち"],[60,1,"な"],[65,1,"た"],[70,1,"みや"],[72,1,"む"],[80,1,"いの"]],"text":"あなたの民が敵と戦うために、あなたがつかわされる道によって出るとき、もし彼らがあなたの選ばれたこの町と、わたしがあなたの名のために建てたこの宮に向かってあなたに祈るならば、"},{"ref":"2Chr.6.35","start":14006035,"end":14006035,"break":"none","ruby":[[4,1,"てん"],[7,1,"かれ"],[10,1,"いのり"],[12,1,"ねが"],[16,1,"き"],[19,1,"かれ"],[23,1,"たす"]],"text":"あなたは天から彼らの祈と願いとを聞いて彼らをお助けください。"},{"ref":"2Chr.6.36","start":14006036,"end":14006036,"break":"none","ruby":[[0,1,"かれ"],[7,1,"たい"],[10,1,"つみ"],[12,1,"おか"],[23,1,"つみ"],[25,1,"おか"],[29,1,"ひと"],[42,1,"かれ"],[45,1,"いか"],[49,1,"てき"],[55,1,"てき"],[57,1,"かれ"],[60,2,"ほりょ"],[65,1,"とお"],[67,1,"ち"],[72,1,"ちか"],[74,1,"ち"],[76,1,"ひ"],[79,1,"い"]],"text":"彼らがあなたに対して罪を犯すことがあって、――罪を犯さない人はないゆえ、――あなたが彼らを怒って、敵にわたし、敵が彼らを捕虜として遠い地あるいは近い地に引いて行くとき、"},{"ref":"2Chr.6.37","start":14006037,"end":14006037,"break":"none","ruby":[[3,1,"かれ"],[6,1,"とら"],[10,1,"い"],[13,1,"ち"],[20,1,"かえり"],[23,1,"く"],[28,1,"とら"],[32,1,"ち"],[38,1,"ねが"],[47,1,"つみ"],[49,1,"おか"],[57,1,"こと"],[61,1,"あく"],[63,1,"おこな"],[70,1,"い"]],"text":"もし、彼らが捕われて行った地で、みずから省みて悔い、その捕われの地であなたに願い、『われわれは罪を犯し、よこしまな事をし、悪を行いました』と言い、"},{"ref":"2Chr.6.38","start":14006038,"end":14006038,"break":"none","ruby":[[2,1,"とら"],[6,1,"ち"],[8,1,"こころ"],[14,2,"せいしん"],[25,1,"た"],[27,1,"かえ"],[34,1,"かれ"],[37,2,"せんぞ"],[40,1,"あた"],[45,1,"ち"],[51,1,"えら"],[55,1,"まち"],[65,1,"な"],[70,1,"た"],[75,1,"みや"],[77,1,"む"],[81,1,"いの"]],"text":"その捕われの地で心をつくし、精神をつくしてあなたに立ち返り、あなたが彼らの先祖に与えられた地、あなたが選ばれた町、わたしがあなたの名のために建てたこの宮に向かって祈るならば、"},{"ref":"2Chr.6.39","start":14006039,"end":14006039,"break":"none","ruby":[[10,1,"てん"],[14,1,"かれ"],[17,1,"いのり"],[19,1,"ねが"],[23,1,"き"],[26,1,"かれ"],[29,1,"たす"],[36,1,"む"],[40,1,"つみ"],[42,1,"おか"],[49,1,"たみ"]],"text":"あなたのすみかである天から、彼らの祈と願いとを聞いて彼らを助け、あなたに向かって罪を犯したあなたの民をおゆるしください。"},{"ref":"2Chr.6.40","start":14006040,"end":14006040,"break":"none","ruby":[[2,1,"かみ"],[11,1,"ところ"],[17,1,"いのり"],[23,1,"め"],[25,1,"ひら"],[32,1,"みみ"],[34,1,"かたむ"]],"text":"わが神よ、どうぞ、この所でささげる祈にあなたの目を開き、あなたの耳を傾けてください。"},{"ref":"2Chr.6.41","start":14006041,"end":14006041,"break":"stanza","breaks":[[20,"line"],[41,"line"],[59,"line"],[66,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[6,1,"いま"],[16,1,"ちから"],[18,1,"はこ"],[20,1,"た"],[28,3,"あんそくじょ"],[41,1,"しゅ"],[44,1,"かみ"],[54,2,"さいし"],[59,1,"すくい"],[61,1,"ころも"],[63,1,"き"],[70,2,"せいと"],[75,1,"めぐ"],[78,1,"よろこ"]],"text":"主なる神よ、今あなたと、あなたの力の箱が立って、あなたの安息所におはいりください。主なる神よ、どうぞあなたの祭司たちに救の衣を着せ、あなたの聖徒たちに恵みを喜ばせてください。"},{"ref":"2Chr.6.42","start":14006042,"end":14006042,"break":"line","breaks":[[23,"line"],[33,"line"],[54,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[13,1,"あぶら"],[19,1,"もの"],[21,1,"かお"],[23,1,"しりぞ"],[44,1,"しめ"],[54,1,"おぼ"],[57,1,"くだ"]],"text":"主なる神よ、どうぞあなたの油そそがれた者の顔を退けないでください。あなたのしもべダビデに示されたいつくしみを覚えて下さい」。"}]