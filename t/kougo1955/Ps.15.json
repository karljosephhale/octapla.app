[{"ref":"Ps.15.1","start":19015001,"end":19015001,"break":"paragraph","title":"ダビデの歌","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"まくや"],[15,1,"もの"],[27,1,"せい"],[30,1,"やま"],[32,1,"す"],[36,1,"もの"]],"titleRuby":[[4,1,"うた"]],"text":"主よ、あなたの幕屋にやどるべき者はだれですか、あなたの聖なる山に住むべき者はだれですか。"},{"ref":"Ps.15.2","start":19015002,"end":19015002,"break":"line","ruby":[[0,1,"なお"],[2,1,"あゆ"],[5,1,"ぎ"],[7,1,"おこな"],[10,1,"こころ"],[13,2,"しんじつ"],[16,1,"かた"],[18,1,"もの"]],"text":"直く歩み、義を行い、心から真実を語る者、"},{"ref":"Ps.15.3","start":19015003,"end":19015003,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"した"],[14,1,"とも"],[16,1,"あく"],[22,1,"とな"],[24,1,"びと"],[26,1,"たい"],[33,1,"と"]],"text":"その舌をもってそしらず、その友に悪をなさず、隣り人に対するそしりを取りあげず、"},{"ref":"Ps.15.4","start":19015004,"end":19015004,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[2,1,"め"],[4,1,"かみ"],[6,1,"す"],[11,1,"もの"],[13,1,"いや"],[17,1,"しゅ"],[19,1,"おそ"],[22,1,"もの"],[24,1,"たっと"],[27,1,"ちか"],[30,1,"こと"],[32,2,"じぶん"],[35,2,"そんがい"],[42,1,"か"]],"text":"その目は神に捨てられた者を卑しめ、主を恐れる者を尊び、誓った事は自分の損害になっても変えることなく、"},{"ref":"Ps.15.5","start":19015005,"end":19015005,"break":"line","breaks":[[24,"line"],[47,"line"],[57,"line"]],"ruby":[[0,2,"りそく"],[6,2,"きんせん"],[9,1,"か"],[21,1,"と"],[24,1,"つみ"],[28,1,"もの"],[30,2,"ふり"],[42,1,"ひと"],[51,1,"こと"],[53,1,"おこな"],[55,1,"もの"],[62,1,"うご"]],"text":"利息をとって金銭を貸すことなく、まいないを取って罪のない者の不利をはかることをしない人である。これらの事を行う者はとこしえに動かされることはない。"}]