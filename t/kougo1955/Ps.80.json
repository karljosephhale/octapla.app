[{"ref":"Ps.80.1","start":19080001,"end":19080001,"break":"paragraph","title":"聖歌隊の指揮者によってゆりの花のしらべにあわせてうたわせたアサフのあかしの歌","breaks":[[10,"line"],[29,"line"],[39,"line"],[54,"line"]],"ruby":[[6,2,"ぼくしゃ"],[10,1,"ひつじ"],[12,1,"む"],[22,1,"みちび"],[26,1,"もの"],[29,1,"みみ"],[31,1,"かたむ"],[44,1,"うえ"],[46,1,"ざ"],[51,1,"もの"],[54,1,"ひかり"],[56,1,"はな"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[14,1,"はな"],[37,1,"うた"]],"text":"イスラエルの牧者よ、羊の群れのようにヨセフを導かれる者よ、耳を傾けてください。ケルビムの上に座せられる者よ、光を放ってください。"},{"ref":"Ps.80.2","start":19080002,"end":19080002,"break":"line","breaks":[[18,"line"],[29,"line"]],"ruby":[[16,1,"まえ"],[22,1,"ちから"],[24,1,"ふ"],[26,1,"おこ"],[29,1,"き"],[37,1,"すく"]],"text":"エフライム、ベニヤミン、マナセの前にあなたの力を振り起し、来て、われらをお救いください。"},{"ref":"Ps.80.3","start":19080003,"end":19080003,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[0,1,"かみ"],[10,1,"かえ"],[14,1,"かお"],[16,1,"ひかり"],[18,1,"てら"],[35,1,"すくい"]],"text":"神よ、われらをもとに返し、み顔の光を照してください。そうすればわれらは救をえるでしょう。"},{"ref":"Ps.80.4","start":19080004,"end":19080004,"break":"line","breaks":[[8,"line"],[23,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[5,1,"しゅ"],[15,1,"たみ"],[17,1,"いのり"],[24,1,"いか"]],"text":"万軍の神、主よ、いつまで、その民の祈にむかってお怒りになるのですか。"},{"ref":"Ps.80.5","start":19080005,"end":19080005,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"なみだ"],[9,1,"かれ"],[12,1,"く"],[16,1,"おお"],[19,1,"なみだ"],[21,1,"かれ"],[24,1,"の"]],"text":"あなたは涙のパンを彼らに食わせ、多くの涙を彼らに飲ませられました。"},{"ref":"Ps.80.6","start":19080006,"end":19080006,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"とな"],[10,1,"びと"],[23,1,"てき"]],"text":"あなたはわれらを隣り人のあざけりとし、われらの敵はたがいにあざわらいました。"},{"ref":"Ps.80.7","start":19080007,"end":19080007,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[13,1,"かえ"],[20,1,"すく"],[28,1,"かお"],[30,1,"ひかり"],[32,1,"てら"]],"text":"万軍の神よ、われらをもとに返し、われらの救われるため、み顔の光を照してください。"},{"ref":"Ps.80.8","start":19080008,"end":19080008,"break":"line","breaks":[[22,"line"]],"ruby":[[9,1,"き"],[17,1,"たずさ"],[19,1,"だ"],[27,2,"くにたみ"],[30,1,"お"],[32,1,"だ"],[39,1,"う"]],"text":"あなたは、ぶどうの木をエジプトから携え出し、もろもろの国民を追い出して、これを植えられました。"},{"ref":"Ps.80.9","start":19080009,"end":19080009,"break":"line","breaks":[[19,"line"]],"ruby":[[10,1,"ち"],[12,1,"ひら"],[19,1,"ふか"],[21,1,"ね"],[26,1,"くに"]],"text":"あなたはこれがために地を開かれたので、深く根ざして、国にはびこりました。"},{"ref":"Ps.80.10","start":19080010,"end":19080010,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"やまやま"],[5,1,"かげ"],[12,1,"かみ"],[14,2,"こうはく"],[19,1,"えだ"]],"text":"山々はその影でおおわれ、神の香柏はその枝でおおわれました。"},{"ref":"Ps.80.11","start":19080011,"end":19080011,"break":"line","breaks":[[14,"line"]],"ruby":[[5,1,"えだ"],[7,1,"うみ"],[16,1,"わか"],[17,1,"えだ"],[19,2,"おおかわ"]],"text":"これはその枝を海にまでのべ、その若枝を大川にまでのべました。"},{"ref":"Ps.80.12","start":19080012,"end":19080012,"break":"line","breaks":[[17,"line"],[30,"line"]],"ruby":[[4,1,"なに"],[17,1,"みち"],[24,1,"ひと"],[28,1,"み"],[30,1,"つ"],[32,1,"と"]],"text":"あなたは何ゆえ、そのかきをくずして道ゆくすべての人にその実を摘み取らせられるのですか。"},{"ref":"Ps.80.13","start":19080013,"end":19080013,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"はやし"],[10,1,"あら"],[13,1,"の"],[19,1,"けもの"],[24,1,"た"]],"text":"林のいのししはこれを荒し、野のすべての獣はこれを食べます。"},{"ref":"Ps.80.14","start":19080014,"end":19080014,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[6,1,"ふたた"],[8,1,"てん"],[11,1,"み"],[23,1,"き"]],"text":"万軍の神よ、再び天から見おろして、このぶどうの木をかえりみてください。"},{"ref":"Ps.80.15","start":19080015,"end":19080015,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[4,1,"みぎ"],[6,1,"て"],[8,1,"う"],[13,1,"みき"],[24,1,"つよ"],[29,1,"えだ"]],"text":"あなたの右の手の植えられた幹と、みずからのために強くされた枝とをかえりみてください。"},{"ref":"Ps.80.16","start":19080016,"end":19080016,"break":"line","breaks":[[14,"line"],[25,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ひ"],[11,1,"や"],[17,1,"き"],[19,1,"たお"],[25,1,"かれ"],[29,1,"かお"],[38,1,"ほろ"]],"text":"彼らは火をもってこれを焼き、これを切り倒しました。彼らをみ顔のとがめによって滅ぼしてください。"},{"ref":"Ps.80.17","start":19080017,"end":19080017,"break":"line","breaks":[[22,"line"],[41,"line"]],"ruby":[[7,1,"て"],[11,1,"みぎ"],[13,1,"て"],[15,1,"ひと"],[17,1,"うえ"],[30,1,"つよ"],[35,1,"ひと"],[37,1,"こ"],[39,1,"うえ"]],"text":"しかしあなたの手をその右の手の人の上におき、みずからのために強くされた人の子の上においてください。"},{"ref":"Ps.80.18","start":19080018,"end":19080018,"break":"line","breaks":[[14,"line"],[27,"line"],[40,"line"]],"ruby":[[14,1,"はな"],[16,1,"しりぞ"],[31,1,"い"],[49,1,"な"],[51,1,"よ"]],"text":"そうすれば、われらはあなたを離れ退くことはありません。われらを生かしてください。われらはあなたのみ名を呼びます。"},{"ref":"Ps.80.19","start":19080019,"end":19080019,"break":"line","breaks":[[18,"line"],[31,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[5,1,"しゅ"],[15,1,"かえ"],[19,1,"かお"],[21,1,"ひかり"],[23,1,"てら"],[40,1,"すくい"]],"text":"万軍の神、主よ、われらをもとに返し、み顔の光を照してください。そうすればわれらは救をえるでしょう。"}]