[{"ref":"1Chr.28.1","start":13028001,"end":13028001,"break":"paragraph","ruby":[[14,2,"ちょうかん"],[21,2,"ぶぞく"],[24,1,"ちょう"],[26,1,"おう"],[28,1,"つか"],[31,1,"くみ"],[33,1,"ちょう"],[36,1,"にん"],[38,1,"ちょう"],[41,1,"にん"],[43,1,"ちょう"],[45,1,"おう"],[49,1,"こ"],[57,2,"ざいさん"],[62,2,"かちく"],[69,2,"かんがん"],[72,2,"ゆうりょく"],[74,1,"しゃ"],[76,2,"ゆうし"],[92,1,"め"],[94,1,"あつ"]],"text":"ダビデはイスラエルのすべての長官、すなわち部族の長、王に仕えた組の長、千人の長、百人の長、王とその子たちのすべての財産および家畜のつかさ、宦官、有力者、勇士などをことごとくエルサレムに召し集めた。"},{"ref":"1Chr.28.2","start":13028002,"end":13028002,"break":"none","ruby":[[6,1,"おう"],[10,1,"あし"],[12,1,"た"],[14,1,"あ"],[18,1,"い"],[25,2,"きょうだい"],[32,1,"たみ"],[39,1,"き"],[49,1,"しゅ"],[51,2,"けいやく"],[54,1,"はこ"],[64,1,"かみ"],[66,1,"あし"],[67,1,"だい"],[72,2,"あんじゅう"],[75,1,"いえ"],[77,1,"た"],[83,1,"こころざし"],[94,1,"た"],[97,2,"じゅんび"]],"text":"そしてダビデ王はその足で立ち上がって言った、「わが兄弟たち、わが民よ、わたしに聞きなさい。わたしは主の契約の箱のため、われわれの神の足台のために安住の家を建てようとの志をもち、すでにこれを建てる準備をした。"},{"ref":"1Chr.28.3","start":13028003,"end":13028003,"break":"none","ruby":[[3,1,"かみ"],[9,1,"い"],[21,1,"な"],[26,1,"いえ"],[28,1,"た"],[41,2,"ぐんじん"],[48,1,"おお"],[51,1,"ち"],[53,1,"なが"]],"text":"しかし神はわたしに言われた、『おまえはわが名のために家を建ててはならない。おまえは軍人であって、多くの血を流したからである』と。"},{"ref":"1Chr.28.4","start":13028004,"end":13028004,"break":"none","ruby":[[16,1,"かみ"],[18,1,"しゅ"],[24,1,"ちち"],[26,2,"ぜんか"],[37,1,"えら"],[40,1,"なが"],[48,1,"おう"],[62,1,"えら"],[74,1,"いえ"],[84,1,"ちち"],[86,1,"いえ"],[88,1,"えら"],[95,1,"ちち"],[97,1,"こ"],[108,1,"よろこ"],[111,1,"ぜん"],[118,1,"おう"]],"text":"それにもかかわらず、イスラエルの神、主はわたしの父の全家のうちからわたしを選んで長くイスラエルの王とせられた。すなわちユダを選んでかしらとし、ユダの家のうちで、わたしの父の家を選び、わたしの父の子らのうちで、わたしを喜び、全イスラエルの王とせられた。"},{"ref":"1Chr.28.5","start":13028005,"end":13028005,"break":"none","ruby":[[3,1,"しゅ"],[9,1,"おお"],[12,1,"こ"],[14,1,"たま"],[24,1,"こ"],[33,1,"こ"],[39,1,"えら"],[45,1,"しゅ"],[47,1,"くに"],[49,1,"くらい"],[63,1,"おさ"]],"text":"そして主はわたしに多くの子を賜わり、そのすべての子らのうちからわが子ソロモンを選び、これを主の国の位にすわらせて、イスラエルを治めさせようとせられた。"},{"ref":"1Chr.28.6","start":13028006,"end":13028006,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"い"],[18,1,"こ"],[26,1,"や"],[32,1,"にわ"],[34,1,"つく"],[45,1,"かれ"],[47,1,"えら"],[52,1,"こ"],[67,1,"かれ"],[69,1,"ちち"]],"text":"主はまたわたしに言われた、『おまえの子ソロモンがわが家およびわが庭を造るであろう。わたしは彼を選んでわが子となしたからである。わたしは彼の父となる。"},{"ref":"1Chr.28.7","start":13028007,"end":13028007,"break":"none","ruby":[[0,1,"かれ"],[4,2,"こんにち"],[13,1,"いまし"],[22,1,"かた"],[24,1,"まも"],[27,1,"おこな"],[39,1,"くに"],[46,1,"かた"]],"text":"彼がもし今日のように、わが戒めとわがおきてを固く守って行うならば、わたしはその国をいつまでも堅くするであろう』と。"},{"ref":"1Chr.28.8","start":13028008,"end":13028008,"break":"none","ruby":[[7,1,"しゅ"],[9,2,"かいしゅう"],[13,1,"ぜん"],[20,1,"め"],[22,1,"まえ"],[31,1,"かみ"],[33,1,"き"],[37,1,"ところ"],[45,1,"すす"],[57,1,"かみ"],[59,1,"しゅ"],[65,1,"いまし"],[68,1,"まも"],[74,1,"もと"],[93,1,"よ"],[95,1,"ち"],[97,2,"しょゆう"],[110,1,"のち"],[112,2,"しそん"],[115,1,"なが"],[117,1,"し"],[118,1,"ぎょう"],[122,1,"つた"]],"text":"それゆえいま、主の会衆なる全イスラエルの目の前およびわれわれの神の聞かれる所であなたがたに勧める。あなたがたはその神、主のすべての戒めを守り、これを求めなさい。そうすればあなたがたはこの良き地を所有し、これをあなたがたの後の子孫に長く嗣業として伝えることができる。"},{"ref":"1Chr.28.9","start":13028009,"end":13028009,"break":"paragraph","ruby":[[2,1,"こ"],[13,1,"ちち"],[15,1,"かみ"],[17,1,"し"],[20,1,"まった"],[22,1,"こころ"],[27,1,"よろこ"],[29,1,"いさ"],[32,1,"かれ"],[34,1,"つか"],[40,1,"しゅ"],[46,1,"こころ"],[48,1,"さぐ"],[55,1,"おも"],[58,1,"さと"],[74,1,"かれ"],[76,1,"もと"],[82,1,"あ"],[103,1,"す"],[109,1,"かれ"],[111,1,"なが"],[117,1,"す"]],"text":"わが子ソロモンよ、あなたの父の神を知り、全き心をもって喜び勇んで彼に仕えなさい。主はすべての心を探り、すべての思いを悟られるからである。あなたがもし彼を求めるならば会うことができる。しかしあなたがもしかれを捨てるならば彼は長くあなたを捨てられるであろう。"},{"ref":"1Chr.28.10","start":13028010,"end":13028010,"break":"none","ruby":[[7,1,"つつし"],[13,1,"しゅ"],[19,1,"えら"],[22,2,"せいじょ"],[28,1,"いえ"],[30,1,"た"],[44,1,"こころ"],[46,1,"つよ"],[53,1,"おこな"]],"text":"それであなたは慎みなさい。主はあなたを選んで聖所とすべき家を建てさせようとされるのだから心を強くしてこれを行いなさい」。"},{"ref":"1Chr.28.11","start":13028011,"end":13028011,"break":"paragraph","ruby":[[8,2,"しんでん"],[11,1,"ろう"],[17,1,"いえ"],[21,1,"くら"],[25,1,"うえ"],[27,1,"しつ"],[31,1,"うち"],[33,1,"しつ"],[35,3,"しょくざいしょ"],[39,1,"しつ"],[43,2,"けいかく"],[48,1,"こ"],[54,1,"さづ"]],"text":"こうしてダビデは神殿の廊およびその家、その倉、その上の室、その内の室、贖罪所の室などの計画をその子ソロモンに授け、"},{"ref":"1Chr.28.12","start":13028012,"end":13028012,"break":"none","ruby":[[4,1,"こころ"],[20,1,"しゅ"],[22,1,"みや"],[24,1,"にわ"],[26,2,"しゅうい"],[33,1,"しつ"],[35,1,"かみ"],[37,1,"いえ"],[39,1,"くら"],[44,1,"もの"],[46,1,"くら"],[50,2,"けいかく"],[53,1,"さづ"]],"text":"またその心にあったすべてのもの、すなわち主の宮の庭、周囲のすべての室、神の家の倉、ささげ物の倉などの計画を授け、"},{"ref":"1Chr.28.13","start":13028013,"end":13028013,"break":"none","ruby":[[2,2,"さいし"],[12,1,"くみ"],[15,1,"しゅ"],[17,1,"みや"],[24,1,"つとめ"],[26,2,"しごと"],[30,1,"しゅ"],[32,1,"みや"],[39,1,"つと"],[42,2,"うつわもの"],[48,1,"さづ"]],"text":"また祭司およびレビびとの組と、主の宮のもろもろの務の仕事と、主の宮のもろもろの勤めの器物について授け、"},{"ref":"1Chr.28.14","start":13028014,"end":13028014,"break":"none","ruby":[[7,1,"つと"],[10,1,"もち"],[17,1,"きん"],[19,1,"うつわ"],[21,1,"つく"],[23,1,"きん"],[25,2,"めかた"],[36,1,"つと"],[39,1,"もち"],[42,1,"ぎん"],[44,1,"うつわ"],[46,2,"めかた"],[49,1,"さだ"]],"text":"またもろもろの勤めに用いるすべての金の器を造る金の目方、およびもろもろの勤めに用いる銀の器の目方を定めた。"},{"ref":"1Chr.28.15","start":13028015,"end":13028015,"break":"none","ruby":[[4,1,"きん"],[6,2,"しょくだい"],[16,1,"さら"],[18,2,"めかた"],[26,2,"しょくだい"],[36,1,"さら"],[38,1,"きん"],[40,2,"めかた"],[43,1,"さだ"],[48,1,"ぎん"],[50,2,"しょくだい"],[62,2,"しょくだい"],[65,2,"ようほう"],[73,2,"しょくだい"],[83,1,"さら"],[85,1,"ぎん"],[87,2,"めかた"],[90,1,"さだ"]],"text":"すなわち金の燭台と、そのともしび皿の目方、おのおのの燭台と、そのともしび皿の金の目方を定め、また銀の燭台についてもおのおのの燭台の用法にしたがって燭台と、そのともしび皿の銀の目方を定めた。"},{"ref":"1Chr.28.16","start":13028016,"end":13028016,"break":"none","ruby":[[2,1,"そな"],[8,1,"つくえ"],[22,1,"つくえ"],[27,1,"きん"],[29,2,"めかた"],[32,1,"さだ"],[37,1,"ぎん"],[39,1,"つくえ"],[45,1,"ぎん"],[47,1,"さだ"]],"text":"また供えのパンの机については、そのおのおのの机のために金の目方を定め、また銀の机のためにも銀を定め、"},{"ref":"1Chr.28.17","start":13028017,"end":13028017,"break":"none","ruby":[[2,1,"にく"],[6,1,"はち"],[11,1,"もち"],[14,2,"じゅんきん"],[17,2,"めかた"],[20,1,"さだ"],[23,1,"きん"],[25,2,"たいはい"],[37,2,"めかた"],[40,1,"さだ"],[43,1,"ぎん"],[45,2,"たいはい"],[57,2,"めかた"],[60,1,"さだ"]],"text":"また肉さし、鉢、かめに用いる純金の目方を定め、金の大杯についてもおのおのの目方を定め、銀の大杯についてもおのおのの目方を定め、"},{"ref":"1Chr.28.18","start":13028018,"end":13028018,"break":"none","ruby":[[2,1,"こう"],[4,2,"さいだん"],[10,1,"せい"],[11,1,"きん"],[13,2,"めかた"],[16,1,"さだ"],[21,1,"つばさ"],[23,1,"の"],[26,1,"しゅ"],[28,2,"けいやく"],[31,1,"はこ"],[44,1,"きん"],[46,1,"くるま"],[50,1,"がた"],[52,1,"きん"],[54,1,"さだ"]],"text":"また香の祭壇のために精金の目方を定め、また翼を伸べて主の契約の箱をおおっているケルビムの金の車のひな型の金を定めた。"},{"ref":"1Chr.28.19","start":13028019,"end":13028019,"break":"none","ruby":[[8,2,"こうさく"],[11,2,"けいかく"],[32,1,"しゅ"],[34,1,"て"],[39,1,"か"],[57,1,"あき"]],"text":"ダビデはすべての工作が計画にしたがってなされるため、これについて主の手によって書かれたものにより、これをことごとく明らかにした。"},{"ref":"1Chr.28.20","start":13028020,"end":13028020,"break":"paragraph","ruby":[[6,1,"こ"],[12,1,"い"],[21,1,"こころ"],[23,1,"つよ"],[27,1,"いさ"],[33,1,"おこな"],[39,1,"おそ"],[59,1,"しゅ"],[62,1,"かみ"],[68,1,"かみ"],[87,1,"しゅ"],[93,1,"はな"],[101,1,"す"],[108,1,"しゅ"],[110,1,"みや"],[112,1,"つとめ"],[118,2,"こうじ"],[123,1,"お"]],"text":"ダビデはその子ソロモンに言った、「あなたは心を強くし、勇んでこれを行いなさい。恐れてはならない。おののいてはならない。主なる神、わたしの神があなたとともにおられるからである。主はあなたを離れず、あなたを捨てず、ついに主の宮の務のすべての工事をなし終えさせられるでしょう。"},{"ref":"1Chr.28.21","start":13028021,"end":13028021,"break":"none","ruby":[[0,1,"み"],[3,1,"かみ"],[5,1,"みや"],[11,1,"つとめ"],[17,2,"さいし"],[25,1,"くみ"],[37,1,"つと"],[47,2,"しごと"],[50,1,"よろこ"],[55,1,"たく"],[58,1,"もの"],[60,1,"みな"],[65,1,"とも"],[84,1,"たみ"],[90,1,"めい"],[102,1,"おこな"]],"text":"見よ、神の宮のすべての務のためには祭司とレビびとの組がある。またもろもろの勤めのためにすべての仕事を喜んでする巧みな者が皆あなたと共にある。またつかさたちおよびすべての民もあなたの命じるところをことごとく行うでしょう」。"}]