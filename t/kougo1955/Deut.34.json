[{"ref":"Deut.34.1","start":5034001,"end":5034001,"break":"paragraph","ruby":[[8,2,"へいや"],[14,1,"やま"],[16,1,"のぼ"],[23,1,"む"],[31,1,"いただき"],[33,1,"い"],[40,1,"しゅ"],[42,1,"かれ"],[49,1,"ぜん"],[50,1,"ち"],[56,1,"しめ"]],"text":"モーセはモアブの平野からネボ山に登り、エリコの向かいのピスガの頂へ行った。そこで主は彼にギレアデの全地をダンまで示し、"},{"ref":"Deut.34.2","start":5034002,"end":5034002,"break":"none","ruby":[[5,2,"ぜんぶ"],[18,1,"ち"],[25,1,"ぜん"],[26,1,"ち"],[28,1,"にし"],[30,1,"うみ"],[33,1,"しめ"]],"text":"ナフタリの全部、エフライムとマナセの地およびユダの全地を西の海まで示し、"},{"ref":"Deut.34.3","start":5034003,"end":5034003,"break":"none","ruby":[[4,2,"ていち"],[16,1,"まち"],[21,1,"たに"],[28,1,"しめ"]],"text":"ネゲブと低地、すなわち、しゅろの町エリコの谷をゾアルまで示された。"},{"ref":"Deut.34.4","start":5034004,"end":5034004,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"かれ"],[7,1,"い"],[39,2,"しそん"],[42,1,"あた"],[46,1,"い"],[49,1,"ちか"],[52,1,"ち"],[71,1,"め"],[73,1,"み"],[85,1,"わた"],[88,1,"い"]],"text":"そして主は彼に言われた、「わたしがアブラハム、イサク、ヤコブに、これをあなたの子孫に与えると言って誓った地はこれである。わたしはこれをあなたの目に見せるが、あなたはそこへ渡って行くことはできない」。"},{"ref":"Deut.34.5","start":5034005,"end":5034005,"break":"none","ruby":[[4,1,"しゅ"],[13,1,"しゅ"],[15,2,"ことば"],[26,1,"ち"],[28,1,"し"]],"text":"こうして主のしもべモーセは主の言葉のとおりにモアブの地で死んだ。"},{"ref":"Deut.34.6","start":5034006,"end":5034006,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[10,1,"たい"],[17,1,"ち"],[19,1,"たに"],[21,1,"ほうむ"],[27,2,"こんにち"],[33,1,"はか"],[35,1,"し"],[37,1,"ひと"]],"text":"主は彼をベテペオルに対するモアブの地の谷に葬られたが、今日までその墓を知る人はない。"},{"ref":"Deut.34.7","start":5034007,"end":5034007,"break":"none","ruby":[[4,1,"し"],[7,1,"とき"],[12,1,"さい"],[19,1,"め"],[26,2,"きりょく"],[29,1,"おとろ"]],"text":"モーセは死んだ時、百二十歳であったが、目はかすまず、気力は衰えていなかった。"},{"ref":"Deut.34.8","start":5034008,"end":5034008,"break":"none","ruby":[[6,2,"ひとびと"],[13,2,"へいや"],[18,1,"にち"],[20,1,"あいだ"],[28,1,"な"],[42,1,"な"],[44,1,"かな"],[47,1,"ひ"],[52,1,"おわ"]],"text":"イスラエルの人々はモアブの平野で三十日の間モーセのために泣いた。そしてモーセのために泣き悲しむ日はついに終った。"},{"ref":"Deut.34.9","start":5034009,"end":5034009,"break":"paragraph","ruby":[[3,1,"こ"],[9,2,"ちえ"],[12,1,"れい"],[14,1,"み"],[17,1,"ひと"],[27,1,"かれ"],[29,1,"うえ"],[31,1,"て"],[33,1,"お"],[48,2,"ひとびと"],[51,1,"かれ"],[53,1,"き"],[55,1,"したが"],[58,1,"しゅ"],[64,1,"めい"]],"text":"ヌンの子ヨシュアは知恵の霊に満ちた人であった。モーセが彼の上に手を置いたからである。イスラエルの人々は彼に聞き従い、主がモーセに命じられたとおりにおこなった。"},{"ref":"Deut.34.10","start":5034010,"end":5034010,"break":"none","ruby":[[19,3,"よげんしゃ"],[23,1,"おこ"],[34,1,"しゅ"],[36,1,"かお"],[38,1,"あ"],[42,1,"し"],[46,1,"もの"]],"text":"イスラエルには、こののちモーセのような預言者は起らなかった。モーセは主が顔を合わせて知られた者であった。"},{"ref":"Deut.34.11","start":5034011,"end":5034011,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"ち"],[9,1,"かれ"],[20,2,"けらい"],[27,1,"ぜん"],[28,1,"ち"],[45,3,"ふしぎ"],[49,1,"おこな"]],"text":"主はエジプトの地で彼をパロとそのすべての家来およびその全地につかわして、もろもろのしるしと不思議を行わせられた。"},{"ref":"Deut.34.12","start":5034012,"end":5034012,"break":"none","ruby":[[14,1,"ひと"],[16,1,"まえ"],[18,1,"おお"],[22,1,"ちから"],[29,1,"おお"],[33,1,"おそ"],[37,1,"こと"]],"text":"モーセはイスラエルのすべての人の前で大いなる力をあらわし、大いなる恐るべき事をおこなった。"}]