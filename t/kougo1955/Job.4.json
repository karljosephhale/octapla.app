[{"ref":"Job.4.1","start":18004001,"end":18004001,"break":"paragraph","ruby":[[2,1,"とき"],[14,1,"こた"],[17,1,"い"]],"text":"その時、テマンびとエリパズが答えて言った、"},{"ref":"Job.4.2","start":18004002,"end":18004002,"break":"stanza","breaks":[[23,"line"],[38,"line"]],"ruby":[[3,1,"ひと"],[13,2,"いけん"],[16,1,"の"],[27,1,"はら"],[29,1,"た"],[44,1,"だま"]],"text":"「もし人があなたにむかって意見を述べるならば、あなたは腹を立てるでしょうか。しかしだれが黙っておれましょう。"},{"ref":"Job.4.3","start":18004003,"end":18004003,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"み"],[7,1,"おお"],[10,1,"ひと"],[12,1,"おし"],[18,1,"おとろ"],[21,1,"て"],[23,1,"つよ"]],"text":"見よ、あなたは多くの人を教えさとし、衰えた手を強くした。"},{"ref":"Job.4.4","start":18004004,"end":18004004,"break":"line","breaks":[[19,"line"]],"ruby":[[4,2,"ことば"],[11,1,"もの"],[16,1,"おこ"],[26,1,"つよ"]],"text":"あなたの言葉はつまずく者をたすけ起し、かよわいひざを強くした。"},{"ref":"Job.4.5","start":18004005,"end":18004005,"break":"line","breaks":[[18,"line"],[28,"line"]],"ruby":[[4,1,"いま"],[8,1,"こと"],[14,1,"のぞ"],[22,1,"た"],[24,1,"え"],[30,1,"こと"],[36,1,"ふ"],[47,1,"まど"]],"text":"ところが今、この事があなたに臨むと、あなたは耐え得ない。この事があなたに触れると、あなたはおじ惑う。"},{"ref":"Job.4.6","start":18004006,"end":18004006,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[4,1,"かみ"],[6,1,"おそ"],[34,1,"みち"],[36,1,"まった"],[46,1,"のぞ"]],"text":"あなたが神を恐れていることは、あなたのよりどころではないか。あなたの道の全きことは、あなたの望みではないか。"},{"ref":"Job.4.7","start":18004007,"end":18004007,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[0,1,"かんが"],[9,1,"つみ"],[16,1,"ほろ"],[21,1,"もの"],[30,1,"ただ"],[33,1,"もの"],[36,1,"た"],[38,1,"ほろ"],[43,1,"もの"]],"text":"考えてみよ、だれが罪のないのに、滅ぼされた者があるか。どこに正しい者で、断ち滅ぼされた者があるか。"},{"ref":"Job.4.8","start":18004008,"end":18004008,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"み"],[6,1,"ところ"],[12,2,"ふぎ"],[15,1,"たがや"],[18,2,"がいあく"],[23,1,"もの"],[29,1,"か"],[31,1,"と"]],"text":"わたしの見た所によれば、不義を耕し、害悪をまく者は、それを刈り取っている。"},{"ref":"Job.4.9","start":18004009,"end":18004009,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かみ"],[12,1,"ほろ"],[17,1,"いか"],[20,1,"いき"],[25,1,"き"]],"text":"彼らは神のいぶきによって滅び、その怒りの息によって消えうせる。"},{"ref":"Job.4.10","start":18004010,"end":18004010,"break":"line","breaks":[[22,"line"]],"ruby":[[6,1,"こえ"],[14,1,"こえ"],[22,1,"わか"],[30,1,"お"]],"text":"ししのほえる声、たけきししの声はともにやみ、若きししのきばは折られ、"},{"ref":"Job.4.11","start":18004011,"end":18004011,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"お"],[4,2,"えもの"],[7,1,"え"],[10,1,"ほろ"],[13,1,"め"],[17,1,"こ"],[19,1,"ち"]],"text":"雄じしは獲物を得ずに滅び、雌じしの子は散らされる。"},{"ref":"Job.4.12","start":18004012,"end":18004012,"break":"stanza","breaks":[[19,"line"]],"ruby":[[8,2,"ことば"],[15,1,"のぞ"],[23,1,"みみ"],[32,1,"き"]],"text":"さて、わたしに、言葉がひそかに臨んだ、わたしの耳はそのささやきを聞いた。"},{"ref":"Job.4.13","start":18004013,"end":18004013,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"ひと"],[6,2,"じゅくすい"],[13,1,"よる"],[15,1,"まぼろし"],[20,1,"おも"],[22,1,"みだ"],[27,1,"とき"]],"text":"すなわち人の熟睡するころ、夜の幻によって思い乱れている時、"},{"ref":"Job.4.14","start":18004014,"end":18004014,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"おそ"],[7,1,"のぞ"],[22,1,"ほね"],[29,1,"ふる"]],"text":"恐れがわたしに臨んだので、おののき、わたしの骨はことごとく震えた。"},{"ref":"Job.4.15","start":18004015,"end":18004015,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"とき"],[3,1,"れい"],[13,1,"かお"],[15,1,"まえ"],[17,1,"す"],[27,1,"み"],[29,1,"け"]],"text":"時に、霊があって、わたしの顔の前を過ぎたので、わたしの身の毛はよだった。"},{"ref":"Job.4.16","start":18004016,"end":18004016,"break":"line","breaks":[[13,"line"],[35,"line"],[55,"line"]],"ruby":[[5,1,"た"],[19,1,"すがた"],[21,1,"み"],[47,1,"め"],[49,1,"まえ"],[59,1,"しず"],[62,1,"こえ"],[64,1,"き"]],"text":"そのものは立ちどまったが、わたしはその姿を見わけることができなかった。一つのかたちが、わたしの目の前にあった。わたしは静かな声を聞いた、"},{"ref":"Job.4.17","start":18004017,"end":18004017,"break":"line","breaks":[[17,"line"]],"ruby":[[1,1,"ひと"],[3,1,"かみ"],[5,1,"まえ"],[7,1,"ただ"],[17,1,"ひと"],[21,1,"つく"],[23,1,"ぬし"],[25,1,"まえ"],[27,1,"きよ"]],"text":"『人は神の前に正しくありえようか。人はその造り主の前に清くありえようか。"},{"ref":"Job.4.18","start":18004018,"end":18004018,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[13,1,"たの"],[21,2,"てんし"],[25,1,"あやま"],[28,1,"もの"]],"text":"見よ、彼はそのしもべをさえ頼みとせず、その天使をも誤れる者とみなされる。"},{"ref":"Job.4.19","start":18004019,"end":18004019,"break":"line","breaks":[[12,"line"],[23,"line"]],"ruby":[[4,1,"どろ"],[6,1,"いえ"],[8,1,"す"],[10,1,"もの"],[17,1,"もとい"],[21,1,"もの"],[34,1,"もの"]],"text":"まして、泥の家に住む者、ちりをその基とする者、しみのようにつぶされる者。"},{"ref":"Job.4.20","start":18004020,"end":18004020,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あさ"],[6,1,"ゆう"],[10,1,"あいだ"],[12,1,"う"],[14,1,"くだ"],[18,1,"かえり"],[21,1,"もの"],[26,2,"えいえん"],[29,1,"ほろ"]],"text":"彼らは朝から夕までの間に打ち砕かれ、顧みる者もなく、永遠に滅びる。"},{"ref":"Job.4.21","start":18004021,"end":18004021,"break":"line","breaks":[[9,"line"],[24,"line"]],"ruby":[[4,2,"てんまく"],[7,1,"つな"],[9,1,"かれ"],[15,1,"と"],[17,1,"さ"],[27,1,"さと"],[35,1,"し"]],"text":"もしその天幕の綱が彼らのうちに取り去られるなら、ついに悟ることもなく、死にうせるではないか』。"}]