[{"ref":"2Sam.15.1","start":10015001,"end":10015001,"break":"paragraph","ruby":[[2,1,"のち"],[10,2,"じぶん"],[16,2,"せんしゃ"],[19,1,"うま"],[24,2,"じぶん"],[27,1,"まえ"],[29,1,"か"],[32,1,"もの"],[35,1,"にん"],[37,1,"そな"]],"text":"この後、アブサロムは自分のために戦車と馬、および自分の前に駆ける者五十人を備えた。"},{"ref":"2Sam.15.2","start":10015002,"end":10015002,"break":"none","ruby":[[6,1,"はや"],[8,1,"お"],[11,1,"もん"],[13,1,"みち"],[20,1,"た"],[24,1,"つね"],[29,1,"ひと"],[31,1,"うった"],[37,1,"おう"],[39,2,"さいばん"],[42,1,"もと"],[45,1,"く"],[57,1,"ひと"],[59,1,"よ"],[62,1,"い"],[73,1,"まち"],[75,1,"もの"],[83,1,"ひと"],[101,2,"ぶぞく"],[110,1,"い"]],"text":"アブサロムは早く起きて門の道のかたわらに立つのを常とした。人が訴えがあって王に裁判を求めに来ると、アブサロムはその人を呼んで言った、「あなたはどの町の者ですか」。その人が「しもべはイスラエルのこれこれの部族のものです」と言うと、"},{"ref":"2Sam.15.3","start":10015003,"end":10015003,"break":"none","ruby":[[8,1,"ひと"],[10,1,"い"],[15,1,"み"],[22,2,"ようきゅう"],[25,1,"よ"],[30,1,"ただ"],[44,1,"き"],[48,1,"ひと"],[50,1,"おう"],[54,1,"た"]],"text":"アブサロムはその人に言った、「見よ、あなたの要求は良く、また正しい。しかしあなたのことを聞くべき人は王がまだ立てていない」。"},{"ref":"2Sam.15.4","start":10015004,"end":10015004,"break":"none","ruby":[[8,1,"い"],[22,1,"ち"],[46,1,"うった"],[52,1,"もうし"],[53,1,"た"],[62,1,"みな"],[67,1,"ところ"],[79,2,"こうへい"],[86,1,"おこな"]],"text":"アブサロムはまた言った、「ああ、わたしがこの地のさばきびとであったならばよいのに。そうすれば訴え、または申立てのあるものは、皆わたしの所にきて、わたしはこれに公平なさばきを行うことができるのだが」。"},{"ref":"2Sam.15.5","start":10015005,"end":10015005,"break":"none","ruby":[[3,1,"ひと"],[5,1,"かれ"],[7,2,"けいれい"],[15,1,"ちか"],[20,1,"かれ"],[22,1,"て"],[24,1,"の"],[29,1,"ひと"],[31,1,"だ"],[37,1,"くち"]],"text":"そして人が彼に敬礼しようとして近づくと、彼は手を伸べ、その人を抱きかかえて口づけした。"},{"ref":"2Sam.15.6","start":10015006,"end":10015006,"break":"none","ruby":[[6,1,"おう"],[12,1,"もと"],[15,1,"く"],[53,2,"ひとびと"],[56,1,"こころ"],[58,2,"じぶん"]],"text":"アブサロムは王にさばきを求めて来るすべてのイスラエルびとにこのようにした。こうしてアブサロムはイスラエルの人々の心を自分のものとした。"},{"ref":"2Sam.15.7","start":10015007,"end":10015007,"break":"paragraph","ruby":[[4,1,"ねん"],[6,1,"おわ"],[16,1,"おう"],[18,1,"い"],[30,1,"い"],[43,1,"しゅ"],[45,1,"た"],[48,1,"ちか"],[51,1,"はた"]],"text":"そして四年の終りに、アブサロムは王に言った、「どうぞわたしを行かせ、ヘブロンで、かつて主に立てた誓いを果させてください。"},{"ref":"2Sam.15.8","start":10015008,"end":10015008,"break":"none","ruby":[[19,1,"とき"],[21,1,"ちか"],[24,1,"た"],[31,1,"しゅ"],[48,1,"つ"],[50,1,"かえ"],[65,1,"しゅ"],[67,2,"れいはい"],[77,1,"い"]],"text":"それは、しもべがスリヤのゲシュルにいた時、誓いを立てて、『もし主がほんとうにわたしをエルサレムに連れ帰ってくださるならば、わたしは主に礼拝をささげます』と言ったからです」。"},{"ref":"2Sam.15.9","start":10015009,"end":10015009,"break":"none","ruby":[[0,1,"おう"],[2,1,"かれ"],[6,1,"やす"],[10,1,"い"],[17,1,"い"],[23,1,"かれ"],[25,1,"た"],[33,1,"い"]],"text":"王が彼に、「安らかに行きなさい」と言ったので、彼は立ってヘブロンへ行った。"},{"ref":"2Sam.15.10","start":10015010,"end":10015010,"break":"none","ruby":[[9,2,"みっし"],[22,2,"ぶぞく"],[33,1,"い"],[42,1,"ひび"],[45,1,"き"],[63,1,"おう"],[70,1,"い"]],"text":"そしてアブサロムは密使をイスラエルのすべての部族のうちにつかわして言った、「ラッパの響きを聞くならば、『アブサロムがヘブロンで王となった』と言いなさい」。"},{"ref":"2Sam.15.11","start":10015011,"end":10015011,"break":"none","ruby":[[2,1,"にん"],[4,1,"まね"],[8,1,"もの"],[23,1,"とも"],[25,1,"い"],[29,1,"かれ"],[32,1,"なに"],[33,1,"こころ"],[36,1,"い"],[39,2,"なにごと"],[43,1,"し"]],"text":"二百人の招かれた者がエルサレムからアブサロムと共に行った。彼らは何心なく行き、何事をも知らなかった。"},{"ref":"2Sam.15.12","start":10015012,"end":10015012,"break":"none","ruby":[[6,2,"ぎせい"],[15,1,"あいだ"],[17,1,"ひと"],[29,1,"ぎ"],[30,1,"かん"],[44,1,"まち"],[49,1,"よ"],[51,1,"よ"],[55,2,"ととう"],[58,1,"つよ"],[61,1,"たみ"],[73,1,"くわ"]],"text":"アブサロムは犠牲をささげている間に人をつかわして、ダビデの議官ギロびとアヒトペルを、その町ギロから呼び寄せた。徒党は強く、民はしだいにアブサロムに加わった。"},{"ref":"2Sam.15.13","start":10015013,"end":10015013,"break":"paragraph","ruby":[[4,2,"ししゃ"],[25,2,"ひとびと"],[28,1,"こころ"],[36,1,"したが"],[43,1,"い"]],"text":"ひとりの使者がダビデのところにきて、「イスラエルの人々の心はアブサロムに従いました」と言った。"},{"ref":"2Sam.15.14","start":10015014,"end":10015014,"break":"none","ruby":[[5,2,"じぶん"],[8,2,"いっしょ"],[23,2,"けらい"],[26,1,"い"],[31,1,"た"],[39,1,"に"],[57,1,"まえ"],[78,1,"いそ"],[81,1,"い"],[93,1,"かれ"],[96,1,"いそ"],[98,1,"お"],[109,1,"がい"],[124,1,"まち"],[126,1,"う"]],"text":"ダビデは、自分と一緒にエルサレムにいるすべての家来に言った、「立て、われわれは逃げよう。そうしなければアブサロムの前からのがれることはできなくなるであろう。急いで行くがよい。さもないと、彼らが急ぎ追いついて、われわれに害をこうむらせ、つるぎをもって町を撃つであろう」。"},{"ref":"2Sam.15.15","start":10015015,"end":10015015,"break":"none","ruby":[[0,1,"おう"],[8,1,"おう"],[10,1,"い"],[24,2,"しゅくん"],[27,1,"おう"],[29,1,"えら"],[33,1,"ところ"],[38,1,"おこな"]],"text":"王のしもべたちは王に言った、「しもべたちは、わが主君、王の選ばれる所をすべて行います」。"},{"ref":"2Sam.15.16","start":10015016,"end":10015016,"break":"none","ruby":[[4,1,"おう"],[6,1,"で"],[8,1,"い"],[13,2,"ぜんか"],[16,1,"かれ"],[18,1,"したが"],[22,1,"おう"],[25,1,"にん"],[31,1,"のこ"],[34,1,"いえ"],[36,1,"まも"]],"text":"こうして王は出て行き、その全家は彼に従った。王は十人のめかけを残して家を守らせた。"},{"ref":"2Sam.15.17","start":10015017,"end":10015017,"break":"none","ruby":[[0,1,"おう"],[2,1,"で"],[4,1,"い"],[7,1,"たみ"],[11,1,"かれ"],[13,1,"したが"],[17,1,"かれ"],[20,1,"まち"],[25,1,"いえ"]],"text":"王は出て行き、民はみな彼に従った。彼らは町はずれの家にとどまった。"},{"ref":"2Sam.15.18","start":10015018,"end":10015018,"break":"none","ruby":[[0,1,"かれ"],[8,1,"みな"],[10,1,"かれ"],[17,1,"すす"],[44,1,"かれ"],[46,1,"したが"],[57,1,"にん"],[64,1,"みな"],[66,1,"おう"],[68,1,"まえ"],[70,1,"すす"]],"text":"彼のしもべたちは皆、彼のかたわらを進み、すべてのケレテびとと、すべてのペレテびと、および彼に従ってガテからきた六百人のガテびとは皆、王の前に進んだ。"},{"ref":"2Sam.15.19","start":10015019,"end":10015019,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"おう"],[13,1,"い"],[34,1,"とも"],[36,1,"い"],[47,1,"かえ"],[50,1,"おう"],[52,1,"とも"],[63,2,"がいこく"],[65,1,"じん"],[70,2,"じぶん"],[73,1,"くに"],[76,2,"ついほう"],[81,1,"もの"]],"text":"時に王はガテびとイッタイに言った、「どうしてあなたもまた、われわれと共に行くのですか。あなたは帰って王と共にいなさい。あなたは外国人で、また自分の国から追放された者だからです。"},{"ref":"2Sam.15.20","start":10015020,"end":10015020,"break":"none","ruby":[[8,1,"き"],[20,2,"じぶん"],[23,1,"い"],[25,1,"ところ"],[27,1,"し"],[31,1,"い"],[54,1,"とも"],[73,1,"かえ"],[83,2,"きょうだい"],[88,1,"つ"],[91,1,"かえ"],[100,1,"しゅ"],[102,1,"めぐ"],[105,2,"しんじつ"],[112,1,"しめ"]],"text":"あなたは、きのう来たばかりです。わたしは自分の行く所を知らずに行くのに、どうしてきょう、あなたを、われわれと共にさまよわせてよいでしょう。あなたは帰りなさい。あなたの兄弟たちも連れて帰りなさい。どうぞ主が恵みと真実をあなたに示してくださるように」。"},{"ref":"2Sam.15.21","start":10015021,"end":10015021,"break":"none","ruby":[[8,1,"おう"],[10,1,"こた"],[15,1,"しゅ"],[17,1,"い"],[27,1,"きみ"],[29,1,"おう"],[31,1,"い"],[41,1,"きみ"],[43,1,"おう"],[49,1,"ところ"],[52,1,"し"],[55,1,"い"]],"text":"しかしイッタイは王に答えた、「主は生きておられる。わが君、王は生きておられる。わが君、王のおられる所に、死ぬも生きるも、しもべもまたそこにおります」。"},{"ref":"2Sam.15.22","start":10015022,"end":10015022,"break":"none","ruby":[[9,1,"い"],[16,1,"すす"],[19,1,"い"],[38,1,"すす"],[43,1,"かれ"],[49,2,"じゅうしゃ"],[54,1,"かれ"],[56,1,"とも"],[60,1,"こ"],[66,1,"みな"],[68,1,"すす"]],"text":"ダビデはイッタイに言った、「では進んで行きなさい」。そこでガテびとイッタイは進み、また彼のすべての従者および彼と共にいた子どもたちも皆、進んだ。"},{"ref":"2Sam.15.23","start":10015023,"end":10015023,"break":"none","ruby":[[0,2,"くにぢゅう"],[4,2,"おおごえ"],[7,1,"な"],[11,1,"たみ"],[15,1,"すす"],[19,1,"おう"],[28,1,"たに"],[30,1,"わた"],[33,1,"すす"],[36,1,"たみ"],[38,1,"みな"],[39,1,"すす"],[42,2,"あらの"],[45,1,"ほう"],[47,1,"む"]],"text":"国中みな大声で泣いた。民はみな進んだ。王もまたキデロンの谷を渡って進み、民は皆進んで荒野の方に向かった。"},{"ref":"2Sam.15.24","start":10015024,"end":10015024,"break":"paragraph","ruby":[[9,1,"のぼ"],[15,1,"み"],[24,1,"かれ"],[26,1,"とも"],[42,1,"かみ"],[44,2,"けいやく"],[47,1,"はこ"],[55,1,"かれ"],[58,1,"かみ"],[60,1,"はこ"],[67,1,"たみ"],[74,1,"まち"],[76,1,"で"],[83,1,"ま"]],"text":"そしてアビヤタルも上ってきた。見よ、ザドクおよび彼と共にいるすべてのレビびともまた、神の契約の箱をかいてきた。彼らは神の箱をおろして、民がことごとく町を出てしまうのを待った。"},{"ref":"2Sam.15.25","start":10015025,"end":10015025,"break":"none","ruby":[[3,1,"おう"],[9,1,"い"],[14,1,"かみ"],[16,1,"はこ"],[18,1,"まち"],[35,1,"しゅ"],[37,1,"まえ"],[39,1,"めぐ"],[42,1,"え"],[48,1,"しゅ"],[54,1,"つ"],[56,1,"かえ"],[66,1,"はこ"],[75,1,"み"]],"text":"そこで王はザドクに言った、「神の箱を町にかきもどすがよい。もしわたしが主の前に恵みを得るならば、主はわたしを連れ帰って、わたしにその箱とそのすまいとを見させてくださるであろう。"},{"ref":"2Sam.15.26","start":10015026,"end":10015026,"break":"none","ruby":[[5,1,"しゅ"],[17,1,"よろこ"],[25,1,"い"],[38,1,"しゅ"],[40,1,"よ"],[43,1,"おも"]],"text":"しかしもし主が、『わたしはおまえを喜ばない』とそう言われるのであれば、どうぞ主が良しと思われることをわたしにしてくださるように。わたしはここにおります」。"},{"ref":"2Sam.15.27","start":10015027,"end":10015027,"break":"none","ruby":[[0,1,"おう"],[4,2,"さいし"],[10,1,"い"],[15,1,"み"],[33,1,"こ"],[45,1,"こ"],[58,1,"こ"],[64,1,"つ"],[68,1,"やす"],[72,1,"まち"],[74,1,"かえ"]],"text":"王はまた祭司ザドクに言った、「見よ、あなたもアビヤタルも、ふたりの子たち、すなわちあなたの子アヒマアズとアビヤタルの子ヨナタンを連れて、安らかに町に帰りなさい。"},{"ref":"2Sam.15.28","start":10015028,"end":10015028,"break":"none","ruby":[[11,2,"ことば"],[17,1,"し"],[27,2,"あらの"],[30,1,"わた"],[32,1,"ば"]],"text":"わたしはあなたがたから言葉があって知らせをうけるまで、荒野の渡し場にとどまります」。"},{"ref":"2Sam.15.29","start":10015029,"end":10015029,"break":"none","ruby":[[13,1,"かみ"],[15,1,"はこ"]],"text":"そこでザドクとアビヤタルは神の箱をエルサレムにかきもどり、そこにとどまった。"},{"ref":"2Sam.15.30","start":10015030,"end":10015030,"break":"paragraph","ruby":[[7,1,"やま"],[9,2,"さかみち"],[12,1,"のぼ"],[17,1,"のぼ"],[19,1,"とき"],[21,1,"な"],[26,1,"あたま"],[36,1,"い"],[40,1,"かれ"],[42,1,"とも"],[46,1,"たみ"],[50,1,"あたま"],[56,1,"のぼ"],[59,1,"な"],[64,1,"のぼ"]],"text":"ダビデはオリブ山の坂道を登ったが、登る時に泣き、その頭をおおい、はだしで行った。彼と共にいる民もみな頭をおおって登り、泣きながら登った。"},{"ref":"2Sam.15.31","start":10015031,"end":10015031,"break":"none","ruby":[[0,1,"とき"],[16,2,"きょうぼう"],[20,1,"もの"],[33,1,"つ"],[36,1,"ひと"],[47,1,"い"],[52,1,"しゅ"],[64,2,"けいりゃく"],[67,1,"おろ"]],"text":"時に、「アヒトペルがアブサロムと共謀した者のうちにいる」とダビデに告げる人があったのでダビデは言った、「主よ、どうぞアヒトペルの計略を愚かなものにしてください」。"},{"ref":"2Sam.15.32","start":10015032,"end":10015032,"break":"paragraph","ruby":[[4,1,"やま"],[6,1,"いただき"],[10,1,"かみ"],[12,1,"れい"],[13,1,"はい"],[16,2,"ばしょ"],[21,1,"とき"],[23,1,"み"],[38,2,"うわぎ"],[41,1,"さ"],[44,1,"あたま"],[46,1,"つち"],[52,1,"き"],[58,1,"むか"]],"text":"ダビデが山の頂にある神を礼拝する場所にきた時、見よ、アルキびとホシャイはその上着を裂き、頭に土をかぶり、来てダビデを迎えた。"},{"ref":"2Sam.15.33","start":10015033,"end":10015033,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[21,1,"とも"],[23,1,"すす"],[33,2,"おもに"]],"text":"ダビデは彼に言った、「もしあなたがわたしと共に進むならば、わたしの重荷となるであろう。"},{"ref":"2Sam.15.34","start":10015034,"end":10015034,"break":"none","ruby":[[9,1,"まち"],[11,1,"かえ"],[20,1,"む"],[25,1,"おう"],[58,1,"ちち"],[75,1,"いま"],[90,1,"い"],[113,2,"けいりゃく"],[116,1,"やぶ"]],"text":"しかしもしあなたが町に帰ってアブサロムに向かい、『王よ、わたしはあなたのしもべとなります。わたしがこれまで、あなたの父のしもべであったように、わたしは今あなたのしもべとなります』と言うならば、あなたはわたしのためにアヒトペルの計略を破ることができるであろう。"},{"ref":"2Sam.15.35","start":10015035,"end":10015035,"break":"none","ruby":[[0,2,"さいし"],[21,1,"とも"],[44,1,"おう"],[46,1,"いえ"],[49,1,"き"],[59,2,"さいし"],[75,1,"つ"]],"text":"祭司たち、ザドクとアビヤタルとは、あなたと共にあそこにいるではないか。それゆえ、あなたは王の家から聞くことをことごとく祭司たち、ザドクとアビヤタルとに告げなさい。"},{"ref":"2Sam.15.36","start":10015036,"end":10015036,"break":"none","ruby":[[5,1,"かれ"],[8,1,"とも"],[16,1,"こ"],[28,1,"こ"],[41,1,"こ"],[57,1,"き"],[68,1,"かれ"],[71,1,"て"],[80,2,"つうほう"]],"text":"あそこには彼らと共にそのふたりの子たち、すなわちザドクの子アヒマアズとアビヤタルの子ヨナタンとがいる。あなたがたは聞いたことをことごとく彼らの手によってわたしに通報しなさい」。"},{"ref":"2Sam.15.37","start":10015037,"end":10015037,"break":"none","ruby":[[7,1,"とも"],[13,1,"まち"],[22,1,"とき"]],"text":"そこでダビデの友ホシャイは町にはいった。その時アブサロムはすでにエルサレムにはいっていた。"}]