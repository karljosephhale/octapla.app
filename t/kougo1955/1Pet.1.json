[{"ref":"1Pet.1.1","start":60001001,"end":60001001,"break":"paragraph","ruby":[[9,2,"しと"],[43,2,"りさん"],[46,2,"きりゅう"],[52,1,"ひと"]],"text":"イエス・キリストの使徒ペテロから、ポント、ガラテヤ、カパドキヤ、アジヤおよびビテニヤに離散し寄留している人たち、"},{"ref":"1Pet.1.2","start":60001002,"end":60001002,"break":"none","breaks":[[75,"paragraph"]],"ruby":[[14,1,"したが"],[22,1,"ち"],[28,1,"う"],[35,1,"ちち"],[38,1,"かみ"],[40,2,"よち"],[52,1,"えら"],[56,2,"みたま"],[70,1,"ひと"],[75,1,"めぐ"],[78,2,"へいあん"],[89,1,"ゆた"],[92,1,"くわ"]],"text":"すなわち、イエス・キリストに従い、かつ、その血のそそぎを受けるために、父なる神の予知されたところによって選ばれ、御霊のきよめにあずかっている人たちへ。恵みと平安とが、あなたがたに豊かに加わるように。"},{"ref":"1Pet.1.3","start":60001003,"end":60001003,"break":"paragraph","ruby":[[13,1,"しゅ"],[23,1,"ちち"],[26,1,"かみ"],[28,1,"かみ"],[33,1,"ゆた"],[53,2,"しにん"],[56,1,"なか"],[78,1,"あら"],[81,1,"うま"],[86,1,"い"],[89,1,"のぞ"]],"text":"ほむべきかな、わたしたちの主イエス・キリストの父なる神。神は、その豊かなあわれみにより、イエス・キリストを死人の中からよみがえらせ、それにより、わたしたちを新たに生れさせて生ける望みをいだかせ、"},{"ref":"1Pet.1.4","start":60001004,"end":60001004,"break":"none","ruby":[[9,1,"てん"],[19,1,"く"],[22,1,"けが"],[34,2,"しさん"],[37,1,"う"],[39,1,"つ"],[41,1,"もの"],[45,1,"くだ"]],"text":"あなたがたのために天にたくわえてある、朽ちず汚れず、しぼむことのない資産を受け継ぐ者として下さったのである。"},{"ref":"1Pet.1.5","start":60001005,"end":60001005,"break":"none","ruby":[[7,1,"おわ"],[10,1,"とき"],[12,2,"けいじ"],[18,1,"すくい"],[28,2,"しんこう"],[33,1,"かみ"],[35,1,"み"],[36,1,"ちから"],[38,1,"まも"]],"text":"あなたがたは、終りの時に啓示さるべき救にあずかるために、信仰により神の御力に守られているのである。"},{"ref":"1Pet.1.6","start":60001006,"end":60001006,"break":"none","ruby":[[5,1,"おも"],[9,1,"いま"],[25,2,"しれん"],[28,1,"なや"],[38,1,"し"],[50,1,"おお"],[53,1,"よろこ"]],"text":"そのことを思って、今しばらくのあいだは、さまざまな試錬で悩まねばならないかも知れないが、あなたがたは大いに喜んでいる。"},{"ref":"1Pet.1.7","start":60001007,"end":60001007,"break":"none","ruby":[[11,2,"しんこう"],[20,1,"ひ"],[22,2,"せいれん"],[28,1,"く"],[31,1,"ほか"],[35,1,"きん"],[43,1,"たっと"],[48,1,"あき"],[64,1,"あらわ"],[74,2,"えいこう"],[82,1,"かわ"]],"text":"こうして、あなたがたの信仰はためされて、火で精錬されても朽ちる外はない金よりもはるかに尊いことが明らかにされ、イエス・キリストの現れるとき、さんびと栄光とほまれとに変るであろう。"},{"ref":"1Pet.1.8","start":60001008,"end":60001008,"break":"none","ruby":[[16,1,"み"],[25,1,"かれ"],[27,1,"あい"],[33,2,"げんざい"],[36,1,"み"],[47,1,"しん"],[51,2,"ことば"],[60,1,"かがや"],[66,1,"よろこ"]],"text":"あなたがたは、イエス・キリストを見たことはないが、彼を愛している。現在、見てはいないけれども、信じて、言葉につくせない、輝きにみちた喜びにあふれている。"},{"ref":"1Pet.1.9","start":60001009,"end":60001009,"break":"none","ruby":[[4,2,"しんこう"],[7,2,"けっか"],[16,1,"すくい"],[18,1,"え"]],"text":"それは、信仰の結果なるたましいの救を得ているからである。"},{"ref":"1Pet.1.10","start":60001010,"end":60001010,"break":"none","ruby":[[2,1,"すくい"],[15,1,"たい"],[18,1,"めぐ"],[24,2,"よげん"],[28,3,"よげんしゃ"],[38,1,"もと"],[48,1,"しら"]],"text":"この救については、あなたがたに対する恵みのことを預言した預言者たちも、たずね求め、かつ、つぶさに調べた。"},{"ref":"1Pet.1.11","start":60001011,"end":60001011,"break":"none","ruby":[[0,1,"かれ"],[4,2,"じぶん"],[20,1,"れい"],[28,2,"くなん"],[34,1,"つづ"],[36,2,"えいこう"],[51,1,"とき"],[60,1,"とき"],[65,2,"ばあい"],[75,1,"しら"]],"text":"彼らは、自分たちのうちにいますキリストの霊が、キリストの苦難とそれに続く栄光とを、あらかじめあかしした時、それは、いつの時、どんな場合をさしたのかを、調べたのである。"},{"ref":"1Pet.1.12","start":60001012,"end":60001012,"break":"none","ruby":[[11,1,"しら"],[17,2,"じぶん"],[39,2,"ほうし"],[47,1,"しめ"],[56,1,"こと"],[59,1,"てん"],[68,2,"せいれい"],[71,1,"かん"],[74,2,"ふくいん"],[83,1,"の"],[85,1,"つた"],[88,2,"ひとびと"],[95,1,"いま"],[104,1,"つ"],[106,1,"し"],[121,2,"みつかい"],[131,1,"み"],[135,1,"ねが"],[140,1,"こと"]],"text":"そして、それらについて調べたのは、自分たちのためではなくて、あなたがたのための奉仕であることを示された。それらの事は、天からつかわされた聖霊に感じて福音をあなたがたに宣べ伝えた人々によって、今や、あなたがたに告げ知らされたのであるが、これは、御使たちも、うかがい見たいと願っている事である。"},{"ref":"1Pet.1.13","start":60001013,"end":60001013,"break":"paragraph","ruby":[[6,1,"こころ"],[8,1,"こし"],[10,1,"おび"],[12,1,"し"],[15,1,"み"],[17,1,"つつし"],[29,1,"あらわ"],[32,1,"とき"],[34,1,"あた"],[39,1,"めぐ"],[48,1,"うたが"],[52,1,"ま"],[54,1,"のぞ"]],"text":"それだから、心の腰に帯を締め、身を慎み、イエス・キリストの現れる時に与えられる恵みを、いささかも疑わずに待ち望んでいなさい。"},{"ref":"1Pet.1.14","start":60001014,"end":60001014,"break":"none","ruby":[[0,2,"じゅうじゅん"],[3,2,"こども"],[9,2,"むち"],[15,2,"じだい"],[18,2,"よくじょう"],[21,1,"したが"]],"text":"従順な子供として、無知であった時代の欲情に従わず、"},{"ref":"1Pet.1.15","start":60001015,"end":60001015,"break":"none","ruby":[[10,1,"め"],[13,1,"くだ"],[17,1,"せい"],[33,2,"じしん"],[41,1,"おこな"],[47,1,"せい"],[50,1,"もの"]],"text":"むしろ、あなたがたを召して下さった聖なるかたにならって、あなたがた自身も、あらゆる行いにおいて聖なる者となりなさい。"},{"ref":"1Pet.1.16","start":60001016,"end":60001016,"break":"none","ruby":[[0,2,"せいしょ"],[9,1,"せい"],[12,1,"もの"],[25,1,"せい"],[28,1,"もの"],[39,1,"か"]],"text":"聖書に、「わたしが聖なる者であるから、あなたがたも聖なる者になるべきである」と書いてあるからである。"},{"ref":"1Pet.1.17","start":60001017,"end":60001017,"break":"none","ruby":[[7,1,"ひと"],[18,1,"おう"],[22,2,"こうへい"],[32,1,"ちち"],[34,1,"よ"],[44,2,"ちじょう"],[47,1,"やど"],[52,1,"あいだ"],[59,1,"こころ"],[64,1,"す"]],"text":"あなたがたは、人をそれぞれのしわざに応じて、公平にさばくかたを、父と呼んでいるからには、地上に宿っている間を、おそれの心をもって過ごすべきである。"},{"ref":"1Pet.1.18","start":60001018,"end":60001018,"break":"none","ruby":[[8,1,"し"],[23,2,"せんぞ"],[25,2,"でんらい"],[28,2,"くうそ"],[31,2,"せいかつ"],[39,1,"だ"],[46,1,"ぎん"],[48,1,"きん"],[53,1,"く"],[56,1,"もの"]],"text":"あなたがたのよく知っているとおり、あなたがたが先祖伝来の空疎な生活からあがない出されたのは、銀や金のような朽ちる物によったのではなく、"},{"ref":"1Pet.1.19","start":60001019,"end":60001019,"break":"none","ruby":[[9,2,"こひつじ"],[20,1,"たっと"],[22,1,"ち"]],"text":"きずも、しみもない小羊のようなキリストの尊い血によったのである。"},{"ref":"1Pet.1.20","start":60001020,"end":60001020,"break":"none","ruby":[[6,2,"てんち"],[9,1,"つく"],[13,1,"まえ"],[22,1,"し"],[36,1,"おわ"],[39,1,"とき"],[41,1,"いた"],[54,1,"あらわ"]],"text":"キリストは、天地が造られる前から、あらかじめ知られていたのであるが、この終りの時に至って、あなたがたのために現れたのである。"},{"ref":"1Pet.1.21","start":60001021,"end":60001021,"break":"none","ruby":[[18,1,"かれ"],[20,2,"しにん"],[23,1,"なか"],[34,2,"えいこう"],[38,1,"あた"],[44,1,"かみ"],[46,1,"しん"],[49,1,"もの"],[71,2,"しんこう"],[74,1,"のぞ"],[79,1,"かみ"]],"text":"あなたがたは、このキリストによって、彼を死人の中からよみがえらせて、栄光をお与えになった神を信じる者となったのであり、したがって、あなたがたの信仰と望みとは、神にかかっているのである。"},{"ref":"1Pet.1.22","start":60001022,"end":60001022,"break":"paragraph","ruby":[[7,2,"しんり"],[10,1,"したが"],[28,1,"いつわ"],[33,2,"きょうだい"],[35,1,"あい"],[41,1,"いた"],[51,1,"たがい"],[53,1,"こころ"],[56,1,"あつ"],[58,1,"あい"],[60,1,"あ"]],"text":"あなたがたは、真理に従うことによって、たましいをきよめ、偽りのない兄弟愛をいだくに至ったのであるから、互に心から熱く愛し合いなさい。"},{"ref":"1Pet.1.23","start":60001023,"end":60001023,"break":"none","ruby":[[6,1,"あら"],[9,1,"うま"],[15,1,"く"],[18,1,"たね"],[26,1,"く"],[30,1,"たね"],[39,1,"かみ"],[41,1,"かわ"],[48,1,"い"],[51,2,"みことば"]],"text":"あなたがたが新たに生れたのは、朽ちる種からではなく、朽ちない種から、すなわち、神の変ることのない生ける御言によったのである。"},{"ref":"1Pet.1.24","start":60001024,"end":60001024,"break":"stanza","breaks":[[11,"line"],[27,"line"],[32,"line"],[37,"line"]],"ruby":[[1,1,"ひと"],[5,1,"くさ"],[13,2,"えいが"],[18,1,"くさ"],[20,1,"はな"],[22,1,"に"],[27,1,"くさ"],[29,1,"か"],[32,1,"はな"],[41,1,"しゅ"],[43,2,"ことば"],[52,1,"のこ"]],"text":"「人はみな草のごとく、その栄華はみな草の花に似ている。草は枯れ、花は散る。しかし、主の言葉は、とこしえに残る」。"},{"ref":"1Pet.1.25","start":60001025,"end":60001025,"break":"none","ruby":[[10,1,"の"],[12,1,"つた"],[17,3,"みことば"]],"text":"これが、あなたがたに宣べ伝えられた御言葉である。"}]