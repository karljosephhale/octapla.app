[{"ref":"2Pet.2.1","start":61002001,"end":61002001,"break":"paragraph","ruby":[[4,1,"たみ"],[6,1,"あいだ"],[11,3,"よげんしゃ"],[15,1,"おこ"],[28,1,"おな"],[38,1,"あいだ"],[44,2,"きょうし"],[47,1,"あらわ"],[55,1,"かれ"],[59,1,"ほろ"],[62,1,"いた"],[66,2,"いたん"],[73,1,"も"],[75,1,"こ"],[78,2,"じぶん"],[88,1,"くだ"],[92,1,"しゅ"],[94,2,"ひてい"],[104,2,"めつぼう"],[107,2,"じぶん"],[110,1,"み"],[112,1,"まね"]],"text":"しかし、民の間に、にせ預言者が起ったことがあるが、それと同じく、あなたがたの間にも、にせ教師が現れるであろう。彼らは、滅びに至らせる異端をひそかに持ち込み、自分たちをあがなって下さった主を否定して、すみやかな滅亡を自分の身に招いている。"},{"ref":"2Pet.2.2","start":61002002,"end":61002002,"break":"none","ruby":[[3,1,"おお"],[7,1,"ひと"],[9,1,"かれ"],[12,2,"ほうしょう"],[15,2,"みなら"],[25,2,"しんり"],[28,1,"みち"],[34,1,"う"],[38,1,"いた"]],"text":"また、大ぜいの人が彼らの放縦を見習い、そのために、真理の道がそしりを受けるに至るのである。"},{"ref":"2Pet.2.3","start":61002003,"end":61002003,"break":"none","ruby":[[0,1,"かれ"],[4,2,"どんよく"],[11,2,"かんげん"],[28,1,"り"],[39,1,"かれ"],[42,1,"たい"],[49,1,"むかし"],[52,2,"ゆうよ"],[56,1,"おこな"],[60,1,"かれ"],[63,2,"めつぼう"]],"text":"彼らは、貪欲のために、甘言をもってあなたがたをあざむき、利をむさぼるであろう。彼らに対するさばきは昔から猶予なく行われ、彼らの滅亡も滞ることはない。"},{"ref":"2Pet.2.4","start":61002004,"end":61002004,"break":"none","ruby":[[0,1,"かみ"],[3,1,"つみ"],[5,1,"おか"],[8,2,"みつかい"],[13,1,"ゆる"],[22,1,"かれ"],[25,2,"げかい"],[38,1,"とき"],[41,1,"くら"],[45,1,"あな"],[47,1,"と"],[49,1,"こ"]],"text":"神は、罪を犯した御使たちを許しておかないで、彼らを下界におとしいれ、さばきの時まで暗やみの穴に閉じ込めておかれた。"},{"ref":"2Pet.2.5","start":61002005,"end":61002005,"break":"none","ruby":[[3,1,"ふる"],[5,2,"せかい"],[23,1,"ふ"],[24,2,"しんこう"],[27,2,"せかい"],[30,2,"こうずい"],[41,1,"ぎ"],[43,3,"せんでんしゃ"],[51,1,"にん"],[53,1,"もの"],[57,2,"ほご"]],"text":"また、古い世界をそのままにしておかないで、その不信仰な世界に洪水をきたらせ、ただ、義の宣伝者ノアたち八人の者だけを保護された。"},{"ref":"2Pet.2.6","start":61002006,"end":61002006,"break":"none","ruby":[[11,2,"まちまち"],[14,1,"はい"],[16,1,"き"],[21,2,"はめつ"],[24,1,"しょ"],[27,1,"ふ"],[28,2,"しんこう"],[31,1,"はし"],[37,2,"ひとびと"],[40,1,"み"]],"text":"また、ソドムとゴモラの町々を灰に帰せしめて破滅に処し、不信仰に走ろうとする人々の見せしめとし、"},{"ref":"2Pet.2.7","start":61002007,"end":61002007,"break":"none","ruby":[[3,2,"ひどう"],[6,1,"もの"],[10,2,"ほうじゅう"],[13,1,"おこな"],[27,2,"ぎじん"],[34,1,"すく"],[36,1,"だ"]],"text":"ただ、非道の者どもの放縦な行いによってなやまされていた義人ロトだけを救い出された。"},{"ref":"2Pet.2.8","start":61002008,"end":61002008,"break":"none","ruby":[[3,2,"ぎじん"],[7,1,"かれ"],[10,1,"あいだ"],[12,1,"す"],[15,1,"かれ"],[18,2,"ふほう"],[21,1,"おこな"],[24,2,"ひび"],[26,2,"みき"],[34,1,"ただ"],[37,1,"こころ"],[39,1,"いた"]],"text":"（この義人は、彼らの間に住み、彼らの不法の行いを日々見聞きして、その正しい心を痛めていたのである。）"},{"ref":"2Pet.2.9","start":61002009,"end":61002009,"break":"none","ruby":[[8,1,"しゅ"],[11,2,"しんじん"],[13,1,"ぶか"],[15,1,"もの"],[17,2,"しれん"],[20,1,"なか"],[23,1,"すく"],[25,1,"だ"],[31,2,"ふぎ"],[34,1,"もの"]],"text":"こういうわけで、主は、信心深い者を試錬の中から救い出し、また、不義な者ども、"},{"ref":"2Pet.2.10","start":61002010,"end":61002010,"break":"none","ruby":[[0,1,"とく"],[3,1,"けが"],[6,2,"じょうよく"],[12,1,"にく"],[19,1,"あゆ"],[25,2,"けんい"],[29,1,"もの"],[31,1,"かろ"],[35,2,"ひとびと"],[38,1,"ばっ"],[46,1,"ひ"],[49,1,"と"],[51,1,"こ"],[65,1,"ぞん"],[77,2,"ひとびと"],[81,2,"だいたん"],[83,1,"ふ"],[84,1,"てき"],[90,1,"もの"],[96,2,"えいこう"],[100,1,"もの"]],"text":"特に、汚れた情欲におぼれ肉にしたがって歩み、また、権威ある者を軽んじる人々を罰して、さばきの日まで閉じ込めておくべきことを、よくご存じなのである。こういう人々は、大胆不敵なわがまま者であって、栄光ある者たちをそしってはばかるところがない。"},{"ref":"2Pet.2.11","start":61002011,"end":61002011,"break":"none","ruby":[[4,2,"みつかい"],[10,1,"いきお"],[17,1,"ちから"],[24,1,"かれ"],[40,1,"かれ"],[43,1,"しゅ"],[49,1,"うった"]],"text":"しかし、御使たちは、勢いにおいても力においても、彼らにまさっているにかかわらず、彼らを主のみまえに訴えそしることはしない。"},{"ref":"2Pet.2.12","start":61002012,"end":61002012,"break":"none","ruby":[[4,1,"もの"],[7,1,"とら"],[20,1,"うま"],[26,2,"ふんべつ"],[31,2,"どうぶつ"],[41,2,"じぶん"],[44,1,"し"],[59,2,"ふぎ"],[62,1,"むく"],[67,1,"ばつ"],[69,1,"う"],[72,1,"かなら"],[74,1,"ほろ"]],"text":"これらの者は、捕えられ、ほふられるために生れてきた、分別のない動物のようなもので、自分が知りもしないことをそしり、その不義の報いとして罰を受け、必ず滅ぼされてしまうのである。"},{"ref":"2Pet.2.13","start":61002013,"end":61002013,"break":"none","ruby":[[0,1,"かれ"],[4,2,"まひる"],[9,2,"しゅしょく"],[12,1,"たの"],[22,2,"えんかい"],[25,2,"どうせき"],[43,1,"かれ"]],"text":"彼らは、真昼でさえ酒食を楽しみ、あなたがたと宴会に同席して、だましごとにふけっている。彼らは、しみであり、きずである。"},{"ref":"2Pet.2.14","start":61002014,"end":61002014,"break":"none","ruby":[[2,1,"め"],[4,2,"いんこう"],[7,1,"お"],[10,1,"つみ"],[12,1,"おか"],[15,1,"あ"],[20,1,"し"],[25,1,"かれ"],[28,1,"こころ"],[30,1,"さだ"],[35,1,"もの"],[37,2,"ゆうわく"],[43,1,"こころ"],[45,2,"どんよく"],[48,1,"な"],[55,1,"こ"]],"text":"その目は淫行を追い、罪を犯して飽くことを知らない。彼らは心の定まらない者を誘惑し、その心は貪欲に慣れ、のろいの子となっている。"},{"ref":"2Pet.2.15","start":61002015,"end":61002015,"break":"none","ruby":[[0,1,"かれ"],[3,1,"ただ"],[6,1,"みち"],[13,1,"まよ"],[16,1,"おちい"],[23,1,"こ"],[28,1,"みち"],[30,1,"したが"],[38,1,"ふ"],[39,1,"ぎ"],[41,1,"み"],[43,1,"あい"]],"text":"彼らは正しい道からはずれて迷いに陥り、ベオルの子バラムの道に従った。バラムは不義の実を愛し、"},{"ref":"2Pet.2.16","start":61002016,"end":61002016,"break":"none","ruby":[[6,2,"じぶん"],[14,1,"たい"],[21,1,"う"],[28,1,"い"],[36,2,"にんげん"],[39,1,"こえ"],[44,1,"い"],[49,3,"よげんしゃ"],[53,2,"きょうき"]],"text":"そのために、自分のあやまちに対するとがめを受けた。ものを言わないろばが、人間の声でものを言い、この預言者の狂気じみたふるまいをはばんだのである。"},{"ref":"2Pet.2.17","start":61002017,"end":61002017,"break":"none","ruby":[[2,2,"ひとびと"],[10,1,"みず"],[14,2,"いど"],[17,2,"とっぷう"],[20,1,"ふ"],[27,1,"きり"],[33,1,"かれ"],[37,1,"くら"],[41,2,"ようい"]],"text":"この人々は、いわば、水のない井戸、突風に吹きはらわれる霧であって、彼らには暗やみが用意されている。"},{"ref":"2Pet.2.18","start":61002018,"end":61002018,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ほこり"],[9,1,"かた"],[12,1,"まよ"],[15,1,"なか"],[17,1,"い"],[22,2,"ひとびと"],[25,1,"あいだ"],[40,1,"もの"],[45,2,"にくよく"],[48,2,"しきじょう"],[55,2,"ゆうわく"]],"text":"彼らはむなしい誇を語り、迷いの中に生きている人々の間から、かろうじてのがれてきた者たちを、肉欲と色情とによって誘惑し、"},{"ref":"2Pet.2.19","start":61002019,"end":61002019,"break":"none","ruby":[[2,2,"ひとびと"],[5,2,"じゆう"],[8,1,"あた"],[12,2,"やくそく"],[19,1,"かれ"],[21,2,"じしん"],[24,2,"めつぼう"],[27,2,"どれい"],[41,1,"ひと"],[43,3,"せいふくしゃ"],[47,2,"どれい"]],"text":"この人々に自由を与えると約束しながら、彼ら自身は滅亡の奴隷になっている。おおよそ、人は征服者の奴隷となるものである。"},{"ref":"2Pet.2.20","start":61002020,"end":61002020,"break":"none","ruby":[[0,1,"かれ"],[4,1,"しゅ"],[7,2,"すくいぬし"],[20,1,"し"],[30,1,"よ"],[32,1,"けが"],[40,1,"のち"],[47,1,"ま"],[49,1,"こ"],[53,2,"せいふく"],[62,1,"かれ"],[65,1,"のち"],[67,2,"じょうたい"],[70,1,"はじ"],[79,1,"わる"]],"text":"彼らが、主また救主なるイエス・キリストを知ることにより、この世の汚れからのがれた後、またそれに巻き込まれて征服されるならば、彼らの後の状態は初めよりも、もっと悪くなる。"},{"ref":"2Pet.2.21","start":61002021,"end":61002021,"break":"none","ruby":[[0,1,"ぎ"],[2,1,"みち"],[4,2,"こころえ"],[12,2,"じぶん"],[15,1,"さづ"],[20,1,"せい"],[23,1,"いまし"],[36,1,"ぎ"],[38,1,"みち"],[40,1,"し"],[46,1,"ほう"]],"text":"義の道を心得ていながら、自分に授けられた聖なる戒めにそむくよりは、むしろ義の道を知らなかった方がよい。"},{"ref":"2Pet.2.22","start":61002022,"end":61002022,"break":"none","ruby":[[7,1,"いぬ"],[9,2,"じぶん"],[12,1,"は"],[15,1,"もの"],[17,1,"かえ"],[20,1,"ぶた"],[22,1,"あら"],[34,1,"なか"],[41,1,"い"],[49,1,"かれ"],[52,1,"み"],[54,1,"おこ"]],"text":"ことわざに、「犬は自分の吐いた物に帰り、豚は洗われても、また、どろの中にころがって行く」とあるが、彼らの身に起ったことは、そのとおりである。"}]