[{"ref":"Isa.49.1","start":23049001,"end":23049001,"break":"paragraph","breaks":[[15,"line"],[35,"line"],[51,"line"]],"ruby":[[0,2,"うみぞ"],[4,2,"くにぐに"],[12,1,"き"],[15,1,"とお"],[26,1,"たみ"],[29,1,"みみ"],[31,1,"かたむ"],[35,1,"しゅ"],[41,1,"うま"],[43,1,"で"],[45,1,"とき"],[48,1,"め"],[51,1,"はは"],[53,1,"たい"],[55,1,"で"],[57,1,"とき"],[62,1,"な"],[64,1,"かた"],[66,1,"つ"]],"text":"海沿いの国々よ、わたしに聞け。遠いところのもろもろの民よ、耳を傾けよ。主はわたしを生れ出た時から召し、母の胎を出た時からわが名を語り告げられた。"},{"ref":"Isa.49.2","start":23049002,"end":23049002,"break":"line","breaks":[[16,"line"],[29,"line"],[41,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"くち"],[6,2,"えいり"],[21,1,"て"],[23,1,"かげ"],[35,1,"や"],[41,1,"えびら"],[47,1,"かく"]],"text":"主はわが口を鋭利なつるぎとなし、わたしをみ手の陰にかくし、とぎすました矢となして、箙にわたしを隠された。"},{"ref":"Isa.49.3","start":23049003,"end":23049003,"break":"line","breaks":[[12,"line"],[23,"line"]],"ruby":[[7,1,"い"],[25,2,"えいこう"]],"text":"また、わたしに言われた、「あなたはわがしもべ、わが栄光をあらわすべきイスラエルである」と。"},{"ref":"Isa.49.4","start":23049004,"end":23049004,"break":"line","breaks":[[12,"line"],[25,"line"],[39,"line"],[62,"line"]],"ruby":[[8,1,"い"],[22,1,"はたら"],[25,1,"えき"],[33,1,"ちから"],[35,1,"ついや"],[51,1,"ただ"],[55,1,"しゅ"],[57,1,"とも"],[64,1,"むく"],[69,1,"かみ"],[71,1,"とも"]],"text":"しかし、わたしは言った、「わたしはいたずらに働き、益なく、むなしく力を費した。しかもなお、まことにわが正しきは主と共にあり、わが報いはわが神と共にある」と。"},{"ref":"Isa.49.5","start":23049005,"end":23049005,"break":"paragraph","breaks":[[12,"line"],[32,"line"],[45,"line"],[61,"line"],[74,"line"]],"ruby":[[8,1,"かえ"],[25,1,"あつ"],[36,1,"はら"],[38,1,"うち"],[54,1,"しゅ"],[56,1,"い"],[66,1,"しゅ"],[68,1,"まえ"],[70,1,"たっと"],[76,1,"かみ"],[80,1,"ちから"]],"text":"ヤコブをおのれに帰らせ、イスラエルをおのれのもとに集めるために、わたしを腹の中からつくってそのしもべとされた主は言われる。（わたしは主の前に尊ばれ、わが神はわが力となられた）"},{"ref":"Isa.49.6","start":23049006,"end":23049006,"break":"line","breaks":[[7,"line"],[22,"line"],[38,"line"],[60,"line"],[70,"line"],[94,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[31,2,"ぶぞく"],[47,1,"のこ"],[50,1,"もの"],[52,1,"かえ"],[63,1,"かる"],[65,1,"こと"],[84,1,"くに"],[88,1,"ひかり"],[96,1,"すくい"],[98,1,"ち"],[100,1,"はて"]],"text":"主は言われる、「あなたがわがしもべとなって、ヤコブのもろもろの部族をおこし、イスラエルのうちの残った者を帰らせることは、いとも軽い事である。わたしはあなたを、もろもろの国びとの光となして、わが救を地の果にまでいたらせよう」と。"},{"ref":"Isa.49.7","start":23049007,"end":23049007,"break":"paragraph","breaks":[[12,"line"],[25,"line"],[44,"line"],[65,"line"],[82,"line"],[97,"line"],[116,"line"]],"ruby":[[10,1,"ぬし"],[18,2,"せいじゃ"],[22,1,"しゅ"],[25,1,"ひと"],[27,1,"あなど"],[31,1,"もの"],[33,1,"たみ"],[35,1,"い"],[42,1,"もの"],[60,1,"い"],[71,1,"おう"],[73,1,"み"],[76,1,"た"],[87,1,"きみ"],[89,1,"た"],[93,1,"はい"],[100,2,"しんじつ"],[104,1,"しゅ"],[112,2,"せいじゃ"],[120,1,"えら"]],"text":"イスラエルのあがない主、イスラエルの聖者なる主は、人に侮られる者、民に忌みきらわれる者、つかさたちのしもべにむかってこう言われる、「もろもろの王は見て、立ちあがり、もろもろの君は立って、拝する。これは真実なる主、イスラエルの聖者が、あなたを選ばれたゆえである」。"},{"ref":"Isa.49.8","start":23049008,"end":23049008,"break":"paragraph","breaks":[[9,"line"],[27,"line"],[39,"line"],[50,"line"],[64,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[14,1,"めぐ"],[17,1,"とき"],[24,1,"こた"],[27,1,"すくい"],[29,1,"ひ"],[35,1,"たす"],[47,1,"まも"],[54,1,"あた"],[57,1,"たみ"],[59,2,"けいやく"],[64,1,"くに"],[66,1,"おこ"],[69,1,"あ"],[75,1,"ち"],[77,1,"し"],[78,1,"ぎょう"],[82,1,"つ"]],"text":"主はこう言われる、「わたしは恵みの時に、あなたに答え、救の日にあなたを助けた。わたしはあなたを守り、あなたを与えて民の契約とし、国を興し、荒れすたれた地を嗣業として継がせる。"},{"ref":"Isa.49.9","start":23049009,"end":23049009,"break":"line","breaks":[[19,"line"],[37,"line"],[53,"line"]],"ruby":[[4,1,"とら"],[9,1,"ひと"],[12,1,"で"],[16,1,"い"],[19,1,"くら"],[24,1,"もの"],[34,1,"い"],[37,1,"かれ"],[40,1,"みち"],[44,1,"た"],[57,1,"はだか"],[59,1,"やま"],[62,2,"ぼくそう"],[65,1,"え"]],"text":"わたしは捕えられた人に『出よ』と言い、暗きにおる者に『あらわれよ』と言う。彼らは道すがら食べることができ、すべての裸の山にも牧草を得る。"},{"ref":"Isa.49.10","start":23049010,"end":23049010,"break":"line","breaks":[[21,"line"],[42,"line"],[57,"line"]],"ruby":[[0,1,"かれ"],[3,1,"う"],[23,1,"あつ"],[25,1,"かぜ"],[28,2,"たいよう"],[31,1,"かれ"],[34,1,"う"],[42,1,"かれ"],[49,1,"もの"],[51,1,"かれ"],[54,1,"みちび"],[57,1,"いずみ"],[63,1,"かれ"],[66,1,"みちび"]],"text":"彼らは飢えることがなく、かわくこともない。また熱い風も、太陽も彼らを撃つことはない。彼らをあわれむ者が彼らを導き、泉のほとりに彼らを導かれるからだ。"},{"ref":"Isa.49.11","start":23049011,"end":23049011,"break":"line","breaks":[[18,"line"]],"ruby":[[12,1,"やま"],[14,1,"みち"],[20,2,"おおじ"],[23,1,"たか"]],"text":"わたしは、わがもろもろの山を道とし、わが大路を高くする。"},{"ref":"Isa.49.12","start":23049012,"end":23049012,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[0,1,"み"],[3,2,"ひとびと"],[6,1,"とお"],[10,1,"く"],[13,1,"み"],[16,2,"ひとびと"],[19,1,"きた"],[22,1,"にし"],[32,1,"ち"],[35,1,"く"]],"text":"見よ、人々は遠くから来る。見よ、人々は北から西から、またスエネの地から来る」。"},{"ref":"Isa.49.13","start":23049013,"end":23049013,"break":"line","breaks":[[12,"line"],[28,"line"],[37,"line"]],"ruby":[[0,1,"てん"],[3,1,"うた"],[6,1,"ち"],[9,1,"よろこ"],[17,1,"やま"],[20,1,"こえ"],[22,1,"はな"],[25,1,"うた"],[28,1,"しゅ"],[32,1,"たみ"],[34,1,"なぐさ"],[39,1,"くる"],[42,1,"もの"]],"text":"天よ、歌え、地よ、喜べ。もろもろの山よ、声を放って歌え。主はその民を慰め、その苦しむ者をあわれまれるからだ。"},{"ref":"Isa.49.14","start":23049014,"end":23049014,"break":"paragraph","breaks":[[11,"line"]],"ruby":[[7,1,"い"],[12,1,"しゅ"],[18,1,"す"],[21,1,"しゅ"],[27,1,"わす"]],"text":"しかしシオンは言った、「主はわたしを捨て、主はわたしを忘れられた」と。"},{"ref":"Isa.49.15","start":23049015,"end":23049015,"break":"line","breaks":[[14,"line"],[38,"line"],[58,"line"]],"ruby":[[1,1,"おんな"],[5,1,"ち"],[8,1,"ご"],[10,1,"わす"],[16,1,"はら"],[18,1,"こ"],[41,1,"かれ"],[44,1,"わす"],[67,1,"わす"]],"text":"「女がその乳のみ子を忘れて、その腹の子を、あわれまないようなことがあろうか。たとい彼らが忘れるようなことがあっても、わたしは、あなたを忘れることはない。"},{"ref":"Isa.49.16","start":23049016,"end":23049016,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"み"],[18,1,"ほ"],[20,1,"きざ"],[28,1,"いし"],[32,1,"つね"],[36,1,"まえ"]],"text":"見よ、わたしは、たなごころにあなたを彫り刻んだ。あなたの石がきは常にわが前にある。"},{"ref":"Isa.49.17","start":23049017,"end":23049017,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"た"],[7,1,"もの"],[17,1,"もの"],[19,1,"お"],[21,1,"こ"],[28,1,"あら"],[31,1,"もの"],[39,1,"で"],[41,1,"い"]],"text":"あなたを建てる者は、あなたをこわす者を追い越し、あなたを荒した者は、あなたから出て行く。"},{"ref":"Isa.49.18","start":23049018,"end":23049018,"break":"line","breaks":[[14,"line"],[33,"line"],[50,"line"],[69,"line"]],"ruby":[[4,1,"め"],[9,1,"み"],[14,1,"かれ"],[17,1,"みな"],[18,1,"あつ"],[30,1,"く"],[33,1,"しゅ"],[35,1,"い"],[44,1,"い"],[54,1,"かれ"],[57,1,"みな"],[59,1,"かざ"],[64,1,"み"],[69,2,"はなよめ"],[72,1,"おび"],[80,1,"むす"]],"text":"あなたの目をあげて見まわせ。彼らは皆集まって、あなたのもとに来る。主は言われる、わたしは生きている、あなたは彼らを皆、飾りとして身につけ、花嫁の帯のようにこれを結ぶ。"},{"ref":"Isa.49.19","start":23049019,"end":23049019,"break":"line","breaks":[[23,"line"],[37,"line"]],"ruby":[[4,1,"あ"],[13,1,"ところ"],[20,1,"ち"],[23,1,"す"],[25,1,"ひと"],[27,1,"おお"],[32,1,"せま"],[48,1,"もの"],[55,1,"はな"],[57,1,"さ"]],"text":"あなたの荒れ、かつすたれた所、こわされた地は、住む人の多いために狭くなり、あなたを、のみつくした者は、はるかに離れ去る。"},{"ref":"Isa.49.20","start":23049020,"end":23049020,"break":"line","breaks":[[18,"line"],[29,"line"],[44,"line"]],"ruby":[[4,1,"こ"],[6,1,"うしな"],[9,1,"のち"],[11,1,"うま"],[14,1,"こ"],[24,1,"みみ"],[26,1,"い"],[32,1,"ところ"],[39,1,"せま"],[51,1,"す"],[55,1,"ところ"],[57,1,"え"]],"text":"あなたが子を失った後に生れた子らは、なおあなたの耳に言う、『この所はわたしには狭すぎる、わたしのために住むべき所を得させよ』と。"},{"ref":"Isa.49.21","start":23049021,"end":23049021,"break":"line","breaks":[[15,"line"],[38,"line"],[55,"line"],[72,"line"],[87,"line"],[102,"line"]],"ruby":[[2,1,"とき"],[7,1,"こころ"],[12,1,"い"],[30,1,"もの"],[32,1,"う"],[42,1,"こ"],[44,1,"うしな"],[48,1,"こ"],[59,1,"とら"],[65,1,"お"],[79,1,"もの"],[81,1,"そだ"],[87,1,"み"],[97,1,"のこ"],[106,1,"もの"],[112,1,"き"]],"text":"その時あなたは心のうちに言う、『だれがわたしのためにこれらの者を産んだのか。わたしは子を失って、子をもたない。わたしは捕われ、かつ追いやられた。だれがこれらの者を育てたのか。見よ、わたしはひとり残された。これらの者はどこから来たのか』と」。"},{"ref":"Isa.49.22","start":23049022,"end":23049022,"break":"paragraph","breaks":[[12,"line"],[36,"line"],[53,"line"],[73,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[13,1,"み"],[20,1,"て"],[27,1,"くに"],[36,1,"はた"],[43,1,"たみ"],[49,1,"た"],[53,1,"かれ"],[67,1,"こ"],[70,1,"たずさ"],[75,1,"かた"],[81,1,"むすめ"],[85,1,"の"],[88,1,"く"]],"text":"主なる神はこう言われる、「見よ、わたしは手をもろもろの国にむかってあげ、旗をもろもろの民にむかって立てる。彼らはそのふところにあなたの子らを携え、その肩にあなたの娘たちを載せて来る。"},{"ref":"Isa.49.23","start":23049023,"end":23049023,"break":"line","breaks":[[18,"line"],[36,"line"],[58,"line"],[71,"line"],[94,"line"]],"ruby":[[5,1,"おう"],[12,2,"ようふ"],[20,2,"おうひ"],[30,2,"うば"],[36,1,"かれ"],[41,1,"かお"],[43,1,"ち"],[55,1,"ふ"],[62,1,"あし"],[84,1,"しゅ"],[91,1,"し"],[98,1,"ま"],[100,1,"のぞ"],[102,1,"もの"],[104,1,"はじ"]],"text":"もろもろの王は、あなたの養父となり、その王妃たちは、あなたの乳母となり、彼らはその顔を地につけて、あなたにひれ伏し、あなたの足のちりをなめる。こうして、あなたはわたしが主であることを知る。わたしを待ち望む者は恥をこうむることがない」。"},{"ref":"Isa.49.24","start":23049024,"end":23049024,"break":"paragraph","breaks":[[9,"line"],[26,"line"],[36,"line"]],"ruby":[[0,2,"ゆうし"],[3,1,"うば"],[6,2,"えもの"],[13,1,"と"],[15,1,"かえ"],[26,2,"ぼうくん"],[33,2,"ほりょ"],[40,1,"すく"],[42,1,"だ"]],"text":"勇士が奪った獲物をどうして取り返すことができようか。暴君がかすめた捕虜をどうして救い出すことができようか。"},{"ref":"Isa.49.25","start":23049025,"end":23049025,"break":"line","breaks":[[12,"line"],[29,"line"],[45,"line"],[60,"line"]],"ruby":[[3,1,"しゅ"],[7,1,"い"],[13,2,"ゆうし"],[20,2,"ほりょ"],[23,1,"と"],[25,1,"かえ"],[29,2,"ぼうくん"],[32,1,"うば"],[35,2,"えもの"],[38,1,"すく"],[40,1,"だ"],[53,1,"あらそ"],[55,1,"もの"],[57,1,"あらそ"],[64,1,"こ"],[67,1,"すく"]],"text":"しかし主はこう言われる、「勇士がかすめた捕虜も取り返され、暴君が奪った獲物も救い出される。わたしはあなたと争う者と争い、あなたの子らを救うからである。"},{"ref":"Isa.49.26","start":23049026,"end":23049026,"break":"line","breaks":[[23,"line"],[44,"line"],[65,"line"],[84,"line"]],"ruby":[[13,1,"もの"],[17,1,"にく"],[19,1,"く"],[25,1,"ち"],[27,1,"あたら"],[30,1,"さけ"],[35,1,"の"],[39,1,"よ"],[53,1,"ひと"],[59,1,"しゅ"],[69,2,"すくいぬし"],[82,1,"ぬし"],[88,3,"ぜんのうしゃ"],[97,1,"し"]],"text":"わたしはあなたをしえたげる者にその肉を食わせ、その血を新しい酒のように飲ませて酔わせる。こうして、すべての人はわたしが主であって、あなたの救主、またあなたのあがない主、ヤコブの全能者であることを知るようになる」。"}]