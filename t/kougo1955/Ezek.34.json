[{"ref":"Ezek.34.1","start":26034001,"end":26034001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.34.2","start":26034002,"end":26034002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[12,2,"ぼくしゃ"],[17,1,"む"],[21,2,"よげん"],[26,2,"よげん"],[30,1,"かれ"],[32,2,"ぼくしゃ"],[35,1,"い"],[38,1,"しゅ"],[41,1,"かみ"],[45,1,"い"],[59,2,"じぶん"],[61,2,"じしん"],[64,1,"やしな"],[72,2,"ぼくしゃ"],[75,2,"ぼくしゃ"],[78,1,"む"],[81,1,"やしな"],[85,1,"もの"]],"text":"「人の子よ、イスラエルの牧者たちに向かって預言せよ。預言して彼ら牧者に言え、主なる神はこう言われる、わざわいなるかな、自分自身を養うイスラエルの牧者。牧者は群れを養うべき者ではないか。"},{"ref":"Ezek.34.3","start":26034003,"end":26034003,"break":"none","ruby":[[11,2,"しぼう"],[14,1,"た"],[17,3,"けおりもの"],[25,1,"こ"],[36,1,"む"],[39,1,"やしな"]],"text":"ところが、あなたがたは脂肪を食べ、毛織物をまとい、肥えたものをほふるが、群れを養わない。"},{"ref":"Ezek.34.4","start":26034004,"end":26034004,"break":"none","ruby":[[6,1,"よわ"],[9,1,"もの"],[11,1,"つよ"],[16,1,"や"],[21,1,"もの"],[28,1,"きず"],[32,1,"もの"],[39,1,"まよ"],[41,1,"で"],[43,1,"もの"],[45,1,"ひ"],[47,1,"かえ"],[55,1,"もの"],[57,1,"たず"],[61,1,"かれ"],[64,2,"てあら"],[72,1,"おさ"]],"text":"あなたがたは弱った者を強くせず、病んでいる者をいやさず、傷ついた者をつつまず、迷い出た者を引き返らせず、うせた者を尋ねず、彼らを手荒く、きびしく治めている。"},{"ref":"Ezek.34.5","start":26034005,"end":26034005,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ぼくしゃ"],[11,1,"ち"],[14,1,"の"],[21,1,"けもの"]],"text":"彼らは牧者がないために散り、野のもろもろの獣のえじきになる。"},{"ref":"Ezek.34.6","start":26034006,"end":26034006,"break":"none","ruby":[[2,1,"ひつじ"],[4,1,"ち"],[12,1,"かれ"],[20,1,"やま"],[28,1,"たか"],[30,1,"おか"],[39,1,"ひつじ"],[41,1,"ち"],[43,2,"ぜんめん"],[46,1,"ち"],[58,1,"さが"],[60,1,"もの"],[65,1,"たず"],[68,1,"もの"]],"text":"わが羊は散らされている。彼らはもろもろの山と、もろもろの高き丘にさまよい、わが羊は地の全面に散らされているが、これを捜す者もなく、尋ねる者もない。"},{"ref":"Ezek.34.7","start":26034007,"end":26034007,"break":"paragraph","ruby":[[5,2,"ぼくしゃ"],[9,1,"しゅ"],[11,2,"ことば"],[14,1,"き"]],"text":"それゆえ、牧者よ、主の言葉を聞け。"},{"ref":"Ezek.34.8","start":26034008,"end":26034008,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[14,1,"い"],[22,1,"ひつじ"],[32,1,"ひつじ"],[34,1,"の"],[41,1,"けもの"],[56,2,"ぼくしゃ"],[65,2,"ぼくしゃ"],[70,1,"ひつじ"],[72,1,"たず"],[77,2,"ぼくしゃ"],[80,2,"じしん"],[83,1,"やしな"],[89,1,"ひつじ"],[91,1,"やしな"]],"text":"主なる神は言われる、わたしは生きている。わが羊はかすめられ、わが羊は野のもろもろの獣のえじきとなっているが、その牧者はいない。わが牧者はわが羊を尋ねない。牧者は自身を養うが、わが羊を養わない。"},{"ref":"Ezek.34.9","start":26034009,"end":26034009,"break":"none","ruby":[[4,2,"ぼくしゃ"],[9,1,"しゅ"],[11,2,"ことば"],[14,1,"き"]],"text":"それゆえ牧者らよ、主の言葉を聞け。"},{"ref":"Ezek.34.10","start":26034010,"end":26034010,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[12,1,"み"],[19,2,"ぼくしゃ"],[23,1,"てき"],[32,1,"ひつじ"],[34,1,"かれ"],[37,1,"て"],[39,1,"もと"],[42,1,"かれ"],[49,1,"む"],[52,1,"やしな"],[62,1,"ふたた"],[64,2,"ぼくしゃ"],[66,2,"じしん"],[69,1,"やしな"],[79,1,"ひつじ"],[81,1,"かれ"],[84,1,"くち"],[87,1,"すく"],[91,1,"かれ"],[94,2,"しょくもつ"]],"text":"主なる神はこう言われる、見よ、わたしは牧者らの敵となり、わたしの羊を彼らの手に求め、彼らにわたしの群れを養うことをやめさせ、再び牧者自身を養わせない。またわが羊を彼らの口から救って、彼らの食物にさせない。"},{"ref":"Ezek.34.11","start":26034011,"end":26034011,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[12,1,"み"],[29,1,"ひつじ"],[31,1,"たず"],[38,1,"さが"],[40,1,"だ"]],"text":"主なる神はこう言われる、見よ、わたしは、わたしみずからわが羊を尋ねて、これを捜し出す。"},{"ref":"Ezek.34.12","start":26034012,"end":26034012,"break":"none","ruby":[[0,2,"ぼくしゃ"],[5,1,"ひつじ"],[7,1,"ち"],[9,1,"さ"],[12,1,"とき"],[16,1,"ひつじ"],[18,1,"む"],[21,1,"さが"],[23,1,"だ"],[35,1,"ひつじ"],[37,1,"さが"],[39,1,"だ"],[42,1,"くも"],[44,1,"くら"],[48,1,"ひ"],[50,1,"ち"],[58,1,"ところ"],[64,1,"すく"]],"text":"牧者がその羊の散り去った時、その羊の群れを捜し出すように、わたしはわが羊を捜し出し、雲と暗やみの日に散った、すべての所からこれを救う。"},{"ref":"Ezek.34.13","start":26034013,"end":26034013,"break":"none","ruby":[[4,1,"かれ"],[12,1,"たみ"],[14,1,"なか"],[17,1,"みちび"],[19,1,"だ"],[27,1,"くに"],[30,1,"あつ"],[34,1,"かれ"],[37,1,"くに"],[39,1,"たずさ"],[41,1,"い"],[50,1,"やま"],[52,1,"うえ"],[54,1,"いずみ"],[62,1,"くに"],[67,1,"ひと"],[69,1,"す"],[75,1,"ところ"],[80,1,"やしな"]],"text":"わたしは彼らをもろもろの民の中から導き出し、もろもろの国から集めて、彼らの国に携え入れ、イスラエルの山の上、泉のほとり、また国のうちの人の住むすべての所でこれを養う。"},{"ref":"Ezek.34.14","start":26034014,"end":26034014,"break":"none","ruby":[[4,1,"よ"],[6,2,"まきば"],[9,1,"かれ"],[12,1,"やしな"],[17,2,"まきば"],[26,1,"たか"],[28,1,"やま"],[35,1,"ところ"],[37,1,"かれ"],[40,1,"よ"],[42,1,"ひつじ"],[47,1,"ふ"],[56,2,"やまやま"],[59,1,"うえ"],[61,1,"こ"],[64,2,"まきば"],[67,1,"くさ"],[69,1,"く"]],"text":"わたしは良き牧場で彼らを養う。その牧場はイスラエルの高い山にあり、その所で彼らは良い羊のおりに伏し、イスラエルの山々の上で肥えた牧場で草を食う。"},{"ref":"Ezek.34.15","start":26034015,"end":26034015,"break":"none","ruby":[[10,1,"ひつじ"],[12,1,"か"],[18,1,"ふ"],[23,1,"しゅ"],[26,1,"かみ"],[28,1,"い"]],"text":"わたしはみずからわが羊を飼い、これを伏させると主なる神は言われる。"},{"ref":"Ezek.34.16","start":26034016,"end":26034016,"break":"none","ruby":[[11,1,"たず"],[14,1,"まよ"],[16,1,"で"],[21,1,"ひ"],[23,1,"かえ"],[26,1,"きず"],[33,1,"つつ"],[36,1,"よわ"],[42,1,"つよ"],[46,1,"こ"],[52,1,"つよ"],[62,2,"かんとく"],[71,2,"こうへい"],[77,1,"かれ"],[80,1,"やしな"]],"text":"わたしは、うせたものを尋ね、迷い出たものを引き返し、傷ついたものを包み、弱ったものを強くし、肥えたものと強いものとは、これを監督する。わたしは公平をもって彼らを養う。"},{"ref":"Ezek.34.17","start":26034017,"end":26034017,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[20,1,"む"],[24,1,"み"],[31,1,"ひつじ"],[33,1,"ひつじ"],[36,1,"あいだ"],[38,2,"おひつじ"],[41,1,"お"],[46,1,"あいだ"]],"text":"主なる神はこう言われる、あなたがた、わが群れよ、見よ、わたしは羊と羊との間、雄羊と雄やぎとの間をさばく。"},{"ref":"Ezek.34.18","start":26034018,"end":26034018,"break":"none","ruby":[[6,1,"よ"],[8,2,"まきば"],[11,1,"くさ"],[13,1,"く"],[18,1,"くさ"],[20,1,"のこ"],[23,1,"あし"],[25,1,"ふ"],[30,1,"す"],[33,1,"みず"],[35,1,"の"],[40,1,"のこ"],[43,1,"あし"],[45,1,"にご"]],"text":"あなたがたは良き牧場で草を食い、その草の残りを足で踏み、また澄んだ水を飲み、その残りを足で濁すが、これは、あまりのことではないか。"},{"ref":"Ezek.34.19","start":26034019,"end":26034019,"break":"none","ruby":[[2,1,"ひつじ"],[11,1,"あし"],[13,1,"ふ"],[19,1,"く"],[28,1,"あし"],[30,1,"にご"],[37,1,"の"]],"text":"わが羊はあなたがたが、足で踏んだものを食い、あなたがたの足で濁したものを、飲まなければならないのか。"},{"ref":"Ezek.34.20","start":26034020,"end":26034020,"break":"paragraph","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"かれ"],[15,1,"い"],[20,1,"み"],[27,1,"こ"],[30,1,"ひつじ"],[36,1,"ひつじ"],[39,1,"あいだ"]],"text":"それゆえ、主なる神はこう彼らに言われる、見よ、わたしは肥えた羊と、やせた羊との間をさばく。"},{"ref":"Ezek.34.21","start":26034021,"end":26034021,"break":"none","ruby":[[10,1,"かた"],[16,1,"お"],[19,1,"つの"],[28,1,"よわ"],[30,1,"もの"],[32,1,"つ"],[38,1,"かれ"],[41,1,"そと"],[43,1,"お"],[45,1,"ち"]],"text":"あなたがたは、わきと肩とをもって押し、角をもって、すべて弱い者を突き、ついに彼らを外に追い散らした。"},{"ref":"Ezek.34.22","start":26034022,"end":26034022,"break":"none","ruby":[[11,1,"む"],[14,1,"たす"],[18,1,"ふたた"],[27,1,"ひつじ"],[29,1,"ひつじ"],[32,1,"あいだ"]],"text":"それゆえ、わたしはわが群れを助けて、再びかすめさせず、羊と羊との間をさばく。"},{"ref":"Ezek.34.23","start":26034023,"end":26034023,"break":"none","ruby":[[4,1,"かれ"],[7,1,"うえ"],[13,2,"ぼくしゃ"],[16,1,"た"],[36,1,"かれ"],[38,1,"かれ"],[41,1,"やしな"],[44,1,"かれ"],[46,1,"かれ"],[49,1,"やしな"],[52,1,"かれ"],[55,2,"ぼくしゃ"]],"text":"わたしは彼らの上にひとりの牧者を立てる。すなわちわがしもべダビデである。彼は彼らを養う。彼は彼らを養い、彼らの牧者となる。"},{"ref":"Ezek.34.24","start":26034024,"end":26034024,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"かれ"],[10,1,"かみ"],[24,1,"かれ"],[33,1,"きみ"],[38,1,"しゅ"],[48,1,"い"]],"text":"主なるわたしは彼らの神となり、わがしもべダビデは彼らのうちにあって君となる。主なるわたしはこれを言う。"},{"ref":"Ezek.34.25","start":26034025,"end":26034025,"break":"paragraph","ruby":[[4,1,"かれ"],[7,2,"へいわ"],[10,2,"けいやく"],[13,1,"むす"],[16,1,"くに"],[18,1,"うち"],[21,2,"やじゅう"],[24,1,"お"],[26,1,"はら"],[29,1,"かれ"],[32,1,"こころ"],[34,1,"やす"],[38,2,"あらの"],[41,1,"す"],[44,1,"もり"],[46,1,"なか"],[48,1,"ねむ"]],"text":"わたしは彼らと平和の契約を結び、国の内から野獣を追い払う。彼らは心を安んじて荒野に住み、森の中に眠る。"},{"ref":"Ezek.34.26","start":26034026,"end":26034026,"break":"none","ruby":[[4,1,"かれ"],[11,1,"やま"],[13,2,"しゅうい"],[16,2,"ところどころ"],[19,2,"しゅくふく"],[23,2,"きせつ"],[31,1,"あめ"],[33,1,"ふ"],[40,2,"しゅくふく"],[43,1,"あめ"]],"text":"わたしは彼らおよびわが山の周囲の所々を祝福し、季節にしたがって雨を降らす。これは祝福の雨となる。"},{"ref":"Ezek.34.27","start":26034027,"end":26034027,"break":"none","ruby":[[0,1,"の"],[2,1,"き"],[4,1,"み"],[6,1,"むす"],[9,1,"ち"],[11,2,"さんぶつ"],[14,1,"だ"],[17,1,"かれ"],[20,1,"こころ"],[22,1,"やす"],[28,1,"くに"],[37,1,"かれ"],[44,1,"ぼう"],[46,1,"くだ"],[49,1,"かれ"],[52,2,"どれい"],[57,1,"もの"],[59,1,"て"],[62,1,"すく"],[64,1,"だ"],[66,1,"とき"],[68,1,"かれ"],[75,1,"しゅ"],[82,1,"さと"]],"text":"野の木は実を結び、地は産物を出す。彼らは心を安んじてその国におり、わたしが彼らのくびきの棒を砕き、彼らを奴隷とした者の手から救い出す時、彼らはわたしが主であることを悟る。"},{"ref":"Ezek.34.28","start":26034028,"end":26034028,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かさ"],[12,2,"こくみん"],[26,1,"ち"],[28,1,"けもの"],[30,1,"かれ"],[33,1,"く"],[41,1,"かれ"],[44,1,"こころ"],[46,1,"やす"],[50,1,"す"],[53,1,"かれ"],[56,1,"おそ"],[61,1,"もの"]],"text":"彼らは重ねて、もろもろの国民にかすめられることなく、地の獣も彼らを食うことはない。彼らは心を安んじて住み、彼らを恐れさせる者はない。"},{"ref":"Ezek.34.29","start":26034029,"end":26034029,"break":"none","ruby":[[4,1,"かれ"],[11,1,"よ"],[13,2,"さいばい"],[15,1,"じょ"],[17,1,"あた"],[21,1,"かれ"],[24,1,"かさ"],[28,1,"くに"],[34,1,"ほろ"],[41,1,"かさ"],[44,1,"しょ"],[45,2,"こくみん"],[54,1,"う"]],"text":"わたしは彼らのために、良い栽培所を与える。彼らは重ねて、国のききんに滅びることなく重ねて諸国民のはずかしめを受けることはない。"},{"ref":"Ezek.34.30","start":26034030,"end":26034030,"break":"none","ruby":[[0,1,"かれ"],[5,1,"かみ"],[7,1,"しゅ"],[14,1,"かれ"],[17,1,"とも"],[22,1,"かれ"],[30,1,"いえ"],[35,1,"たみ"],[42,1,"さと"],[46,1,"しゅ"],[49,1,"かみ"],[51,1,"い"]],"text":"彼らはその神、主なるわたしが彼らと共におり、彼らイスラエルの家が、わが民であることを悟ると、主なる神は言われる。"},{"ref":"Ezek.34.31","start":26034031,"end":26034031,"break":"none","ruby":[[8,1,"ひつじ"],[12,2,"まきば"],[15,1,"ひつじ"],[30,1,"かみ"],[36,1,"しゅ"],[39,1,"かみ"],[41,1,"い"]],"text":"あなたがたはわが羊、わが牧場の羊である。わたしはあなたがたの神であると、主なる神は言われる」。"}]