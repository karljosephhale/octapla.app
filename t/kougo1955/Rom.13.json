[{"ref":"Rom.13.1","start":45013001,"end":45013001,"break":"paragraph","ruby":[[4,1,"ひと"],[7,1,"うえ"],[9,1,"た"],[11,2,"けんい"],[14,1,"したが"],[27,1,"かみ"],[33,2,"けんい"],[43,2,"そんざい"],[49,2,"けんい"],[56,1,"かみ"],[61,1,"た"]],"text":"すべての人は、上に立つ権威に従うべきである。なぜなら、神によらない権威はなく、おおよそ存在している権威は、すべて神によって立てられたものだからである。"},{"ref":"Rom.13.2","start":45013002,"end":45013002,"break":"none","ruby":[[6,2,"けんい"],[9,1,"さか"],[12,1,"もの"],[15,1,"かみ"],[17,1,"さだ"],[23,1,"もの"],[31,1,"もの"],[34,2,"じぶん"],[37,1,"み"],[43,1,"まね"]],"text":"したがって、権威に逆らう者は、神の定めにそむく者である。そむく者は、自分の身にさばきを招くことになる。"},{"ref":"Rom.13.3","start":45013003,"end":45013003,"break":"none","ruby":[[5,3,"しはいしゃ"],[12,2,"ぜんじ"],[17,1,"もの"],[20,2,"きょうふ"],[26,2,"あくじ"],[31,1,"もの"],[35,2,"きょうふ"],[45,2,"けんい"],[48,1,"おそ"],[55,1,"ねが"],[65,2,"ぜんじ"],[80,1,"かれ"]],"text":"いったい、支配者たちは、善事をする者には恐怖でなく、悪事をする者にこそ恐怖である。あなたは権威を恐れないことを願うのか。それでは、善事をするがよい。そうすれば、彼からほめられるであろう。"},{"ref":"Rom.13.4","start":45013004,"end":45013004,"break":"none","ruby":[[0,1,"かれ"],[7,1,"えき"],[9,1,"あた"],[15,1,"かみ"],[17,1,"しもべ"],[34,2,"あくじ"],[41,1,"おそ"],[52,1,"かれ"],[59,1,"けん"],[61,1,"お"],[72,1,"かれ"],[74,1,"かみ"],[76,1,"しもべ"],[82,2,"あくじ"],[85,1,"おこな"],[87,1,"もの"],[89,1,"たい"],[94,1,"いか"],[100,1,"むく"]],"text":"彼は、あなたに益を与えるための神の僕なのである。しかし、もしあなたが悪事をすれば、恐れなければならない。彼はいたずらに剣を帯びているのではない。彼は神の僕であって、悪事を行う者に対しては、怒りをもって報いるからである。"},{"ref":"Rom.13.5","start":45013005,"end":45013005,"break":"none","ruby":[[6,1,"いか"],[22,2,"りょうしん"],[29,1,"したが"]],"text":"だから、ただ怒りをのがれるためだけではなく、良心のためにも従うべきである。"},{"ref":"Rom.13.6","start":45013006,"end":45013006,"break":"none","ruby":[[6,1,"みつぎ"],[8,1,"おさ"],[16,1,"おな"],[18,2,"りゆう"],[26,1,"かれ"],[29,1,"かみ"],[31,1,"つか"],[34,1,"もの"],[45,1,"つとめ"],[47,1,"たずさ"]],"text":"あなたがたが貢を納めるのも、また同じ理由からである。彼らは神に仕える者として、もっぱらこの務に携わっているのである。"},{"ref":"Rom.13.7","start":45013007,"end":45013007,"break":"none","ruby":[[7,1,"かれ"],[13,1,"たい"],[17,2,"ぎむ"],[20,1,"はた"],[31,1,"みつぎ"],[33,1,"おさめ"],[37,1,"もの"],[40,1,"みつぎ"],[42,1,"おさ"],[45,1,"ぜい"],[47,1,"おさめ"],[51,1,"もの"],[54,1,"ぜい"],[56,1,"おさ"],[59,1,"おそ"],[63,1,"もの"],[65,1,"おそ"],[68,1,"うやま"],[72,1,"もの"],[74,1,"うやま"]],"text":"あなたがたは、彼らすべてに対して、義務を果しなさい。すなわち、貢を納むべき者には貢を納め、税を納むべき者には税を納め、恐るべき者は恐れ、敬うべき者は敬いなさい。"},{"ref":"Rom.13.8","start":45013008,"end":45013008,"break":"paragraph","ruby":[[0,1,"たがい"],[2,1,"あい"],[4,1,"あ"],[9,1,"そと"],[12,2,"なにびと"],[16,1,"か"],[28,1,"ひと"],[30,1,"あい"],[33,1,"もの"],[36,2,"りっぽう"],[39,1,"まっと"]],"text":"互に愛し合うことの外は、何人にも借りがあってはならない。人を愛する者は、律法を全うするのである。"},{"ref":"Rom.13.9","start":45013009,"end":45013009,"break":"none","ruby":[[1,2,"かんいん"],[7,1,"ころ"],[11,1,"ぬす"],[33,1,"いまし"],[41,2,"けっきょく"],[44,2,"じぶん"],[47,1,"あい"],[57,1,"とな"],[59,1,"ひと"],[61,1,"あい"],[70,2,"ことば"],[73,1,"き"]],"text":"「姦淫するな、殺すな、盗むな、むさぼるな」など、そのほかに、どんな戒めがあっても、結局「自分を愛するようにあなたの隣り人を愛せよ」というこの言葉に帰する。"},{"ref":"Rom.13.10","start":45013010,"end":45013010,"break":"none","ruby":[[0,1,"あい"],[2,1,"とな"],[4,1,"ひと"],[6,1,"がい"],[8,1,"くわ"],[21,1,"あい"],[23,2,"りっぽう"],[26,2,"かんせい"]],"text":"愛は隣り人に害を加えることはない。だから、愛は律法を完成するものである。"},{"ref":"Rom.13.11","start":45013011,"end":45013011,"break":"paragraph","ruby":[[9,1,"とき"],[11,1,"し"],[21,1,"とく"],[26,1,"こと"],[28,1,"はげ"],[48,1,"ねむ"],[57,1,"とき"],[72,1,"いま"],[81,1,"すくい"],[84,1,"はじ"],[86,1,"しん"],[89,1,"とき"],[97,1,"ちか"]],"text":"なお、あなたがたは時を知っているのだから、特に、この事を励まねばならない。すなわち、あなたがたの眠りからさめるべき時が、すでにきている。なぜなら今は、わたしたちの救が、初め信じた時よりも、もっと近づいているからである。"},{"ref":"Rom.13.12","start":45013012,"end":45013012,"break":"none","ruby":[[0,1,"よ"],[5,1,"ひ"],[7,1,"ちか"],[33,1,"す"],[37,1,"ひかり"],[39,2,"ぶぐ"],[42,1,"つ"]],"text":"夜はふけ、日が近づいている。それだから、わたしたちは、やみのわざを捨てて、光の武具を着けようではないか。"},{"ref":"Rom.13.13","start":45013013,"end":45013013,"break":"none","ruby":[[4,2,"えんらく"],[7,2,"でいすい"],[10,2,"いんらん"],[13,2,"こうしょく"],[16,1,"あらそ"],[23,1,"す"],[27,1,"ひる"],[28,1,"ある"],[39,1,"ある"]],"text":"そして、宴楽と泥酔、淫乱と好色、争いとねたみを捨てて、昼歩くように、つつましく歩こうではないか。"},{"ref":"Rom.13.14","start":45013014,"end":45013014,"break":"none","ruby":[[7,1,"しゅ"],[17,1,"き"],[22,1,"にく"],[24,1,"よく"],[26,1,"み"],[32,1,"こころ"],[34,1,"む"]],"text":"あなたがたは、主イエス・キリストを着なさい。肉の欲を満たすことに心を向けてはならない。"}]