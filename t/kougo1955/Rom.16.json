[{"ref":"Rom.16.1","start":45016001,"end":45016001,"break":"paragraph","ruby":[[8,2,"きょうかい"],[11,2,"しつじ"],[20,2,"しまい"],[33,2,"しょうかい"]],"text":"ケンクレヤにある教会の執事、わたしたちの姉妹フィベを、あなたがたに紹介する。"},{"ref":"Rom.16.2","start":45016002,"end":45016002,"break":"none","ruby":[[4,2,"せいと"],[15,1,"しゅ"],[20,2,"かのじょ"],[23,1,"むか"],[30,2,"かのじょ"],[53,2,"なにごと"],[58,1,"たす"],[68,2,"かのじょ"],[71,1,"おお"],[74,1,"ひと"],[76,3,"えんじょしゃ"],[88,2,"じしん"],[91,3,"えんじょしゃ"]],"text":"どうか、聖徒たるにふさわしく、主にあって彼女を迎え、そして、彼女があなたがたにしてもらいたいことがあれば、何事でも、助けてあげてほしい。彼女は多くの人の援助者であり、またわたし自身の援助者でもあった。"},{"ref":"Rom.16.3","start":45016003,"end":45016003,"break":"paragraph","ruby":[[15,3,"どうろうしゃ"],[33,1,"い"]],"text":"キリスト・イエスにあるわたしの同労者プリスカとアクラとに、よろしく言ってほしい。"},{"ref":"Rom.16.4","start":45016004,"end":45016004,"break":"none","ruby":[[0,1,"かれ"],[12,1,"すく"],[18,2,"じぶん"],[21,1,"くび"],[25,1,"さ"],[27,1,"だ"],[38,1,"かれ"],[41,1,"たい"],[56,3,"いほうじん"],[64,2,"きょうかい"],[68,2,"かんしゃ"]],"text":"彼らは、わたしのいのちを救うために、自分の首をさえ差し出してくれたのである。彼らに対しては、わたしだけではなく、異邦人のすべての教会も、感謝している。"},{"ref":"Rom.16.5","start":45016005,"end":45016005,"break":"none","ruby":[[3,1,"かれ"],[6,1,"いえ"],[8,2,"きょうかい"],[22,1,"あい"],[35,1,"い"],[42,1,"かれ"],[60,2,"はつほ"]],"text":"また、彼らの家の教会にも、よろしく。わたしの愛するエパネトに、よろしく言ってほしい。彼は、キリストにささげられたアジヤの初穂である。"},{"ref":"Rom.16.6","start":45016006,"end":45016006,"break":"none","ruby":[[9,2,"ひとかた"],[14,2,"ろうく"],[27,1,"い"]],"text":"あなたがたのために一方ならず労苦したマリヤに、よろしく言ってほしい。"},{"ref":"Rom.16.7","start":45016007,"end":45016007,"break":"none","ruby":[[4,2,"どうぞく"],[15,2,"いっしょ"],[18,2,"とうごく"],[47,1,"かれ"],[50,2,"しと"],[55,1,"あいだ"],[57,2,"ひょうばん"],[72,1,"さき"],[79,1,"しん"],[82,2,"ひとびと"]],"text":"わたしの同族であって、わたしと一緒に投獄されたことのあるアンデロニコとユニアスとに、よろしく。彼らは使徒たちの間で評判がよく、かつ、わたしよりも先にキリストを信じた人々である。"},{"ref":"Rom.16.8","start":45016008,"end":45016008,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"あい"]],"text":"主にあって愛するアムプリアトに、よろしく。"},{"ref":"Rom.16.9","start":45016009,"end":45016009,"break":"none","ruby":[[13,3,"どうろうしゃ"],[22,1,"あい"]],"text":"キリストにあるわたしたちの同労者ウルバノと、愛するスタキスとに、よろしく。"},{"ref":"Rom.16.10","start":45016010,"end":45016010,"break":"none","ruby":[[8,2,"れんたつ"],[28,1,"いえ"],[30,1,"ひと"]],"text":"キリストにあって錬達なアペレに、よろしく。アリストブロの家の人たちに、よろしく。"},{"ref":"Rom.16.11","start":45016011,"end":45016011,"break":"none","ruby":[[0,2,"どうぞく"],[20,1,"いえ"],[23,1,"しゅ"],[27,1,"ひと"]],"text":"同族のヘロデオンに、よろしく。ナルキソの家の、主にある人たちに、よろしく。"},{"ref":"Rom.16.12","start":45016012,"end":45016012,"break":"none","ruby":[[0,1,"しゅ"],[5,2,"ろうく"],[28,1,"しゅ"],[33,2,"ひとかた"],[38,2,"ろうく"],[42,1,"あい"]],"text":"主にあって労苦しているツルパナとツルポサとに、よろしく。主にあって一方ならず労苦した愛するペルシスに、よろしく。"},{"ref":"Rom.16.13","start":45016013,"end":45016013,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"えら"],[14,1,"かれ"],[16,1,"はは"],[25,1,"かれ"],[27,1,"はは"],[34,1,"はは"]],"text":"主にあって選ばれたルポスと、彼の母とに、よろしく。彼の母は、わたしの母でもある。"},{"ref":"Rom.16.14","start":45016014,"end":45016014,"break":"none","ruby":[[29,1,"かれ"],[32,2,"いっしょ"],[37,2,"きょうだい"]],"text":"アスンクリト、フレゴン、ヘルメス、パトロバ、ヘルマスおよび彼らと一緒にいる兄弟たちに、よろしく。"},{"ref":"Rom.16.15","start":45016015,"end":45016015,"break":"none","ruby":[[19,2,"しまい"],[32,1,"かれ"],[35,2,"いっしょ"],[44,2,"せいと"],[54,1,"い"]],"text":"ピロロゴとユリヤとに、またネレオとその姉妹とに、オルンパに、また彼らと一緒にいるすべての聖徒たちに、よろしく言ってほしい。"},{"ref":"Rom.16.16","start":45016016,"end":45016016,"break":"none","ruby":[[3,2,"せっぷん"],[10,1,"たがい"],[33,2,"きょうかい"]],"text":"きよい接吻をもって、互にあいさつをかわしなさい。キリストのすべての教会から、あなたがたによろしく。"},{"ref":"Rom.16.17","start":45016017,"end":45016017,"break":"paragraph","ruby":[[2,2,"きょうだい"],[14,2,"かんこく"],[25,1,"まな"],[28,1,"おしえ"],[34,2,"ぶんれつ"],[37,1,"ひ"],[39,1,"おこ"],[47,1,"あた"],[50,2,"ひとびと"],[53,2,"けいかい"],[59,1,"かれ"],[63,1,"とお"]],"text":"さて兄弟たちよ。あなたがたに勧告する。あなたがたが学んだ教にそむいて分裂を引き起し、つまずきを与える人々を警戒し、かつ彼らから遠ざかるがよい。"},{"ref":"Rom.16.18","start":45016018,"end":45016018,"break":"none","ruby":[[9,2,"ひとびと"],[19,1,"しゅ"],[25,1,"つか"],[31,2,"じぶん"],[34,1,"はら"],[36,1,"つか"],[42,2,"かんげん"],[45,2,"びじ"],[53,2,"じゅんぼく"],[56,2,"ひとびと"],[59,1,"こころ"],[61,1,"あざむ"],[63,1,"もの"]],"text":"なぜなら、こうした人々は、わたしたちの主キリストに仕えないで、自分の腹に仕え、そして甘言と美辞とをもって、純朴な人々の心を欺く者どもだからである。"},{"ref":"Rom.16.19","start":45016019,"end":45016019,"break":"none","ruby":[[6,2,"じゅうじゅん"],[14,2,"ひとびと"],[17,1,"みみ"],[19,1,"たっ"],[37,1,"よろこ"],[51,1,"ねが"],[64,1,"ぜん"],[70,1,"あく"]],"text":"あなたがたの従順は、すべての人々の耳に達しており、それをあなたがたのために喜んでいる。しかし、わたしの願うところは、あなたがたが善にさとく、悪には、うとくあってほしいことである。"},{"ref":"Rom.16.20","start":45016020,"end":45016020,"break":"none","breaks":[[34,"paragraph"]],"ruby":[[0,2,"へいわ"],[3,1,"かみ"],[21,1,"あし"],[23,1,"した"],[25,1,"ふ"],[27,1,"くだ"],[44,1,"しゅ"],[49,1,"めぐ"],[59,1,"とも"]],"text":"平和の神は、サタンをすみやかにあなたがたの足の下に踏み砕くであろう。どうか、わたしたちの主イエスの恵みが、あなたがたと共にあるように。"},{"ref":"Rom.16.21","start":45016021,"end":45016021,"break":"paragraph","ruby":[[4,3,"どうろうしゃ"],[13,2,"どうぞく"]],"text":"わたしの同労者テモテおよび同族のルキオ、ヤソン、ソシパテロから、あなたがたによろしく。"},{"ref":"Rom.16.22","start":45016022,"end":45016022,"break":"none","ruby":[[3,2,"てがみ"],[6,2,"ひっき"],[19,1,"しゅ"],[35,2,"ことば"]],"text":"（この手紙を筆記したわたしテルテオも、主にあってあなたがたにあいさつの言葉をおくる。）"},{"ref":"Rom.16.23","start":45016023,"end":45016023,"break":"none","breaks":[[58,"paragraph"]],"ruby":[[4,1,"ぜん"],[5,2,"きょうかい"],[9,2,"やぬし"],[28,1,"し"],[30,2,"かいけい"],[32,1,"がかり"],[38,2,"きょうだい"]],"text":"わたしと全教会との家主ガイオから、あなたがたによろしく。市の会計係エラストと兄弟クワルトから、あなたがたによろしく。〔"},{"ref":"Rom.16.24","start":45016024,"end":45016024,"break":"none","ruby":[[6,1,"しゅ"],[16,1,"めぐ"],[25,2,"いちどう"],[28,1,"とも"]],"text":"わたしたちの主イエス・キリストの恵みが、あなたがた一同と共にあるように、アァメン。〕"},{"ref":"Rom.16.25","start":45016025,"end":45016026,"break":"paragraph","ruby":[[0,1,"ねが"],[9,2,"ふくいん"],[21,2,"せんきょう"],[31,1,"なが"],[33,2,"よよ"],[41,1,"かく"],[49,1,"いま"],[57,2,"よげん"],[60,1,"しょ"],[67,2,"えいえん"],[70,1,"かみ"],[72,2,"めいれい"],[75,1,"したが"],[78,2,"しんこう"],[81,2,"じゅうじゅん"],[84,1,"いた"],[97,1,"くに"],[98,1,"ひと"],[100,1,"つ"],[102,1,"し"],[107,2,"おくぎ"],[110,2,"けいじ"],[123,1,"ちから"]],"text":"願わくは、わたしの福音とイエス・キリストの宣教とにより、かつ、長き世々にわたって、隠されていたが、今やあらわされ、預言の書をとおして、永遠の神の命令に従い、信仰の従順に至らせるために、もろもろの国人に告げ知らされた奥義の啓示によって、あなたがたを力づけることのできるかた、"},{"ref":"Rom.16.27","start":45016027,"end":45016027,"break":"none","ruby":[[5,2,"ゆいいつ"],[8,2,"ちえ"],[10,1,"ふか"],[12,1,"かみ"],[27,2,"えいこう"],[30,2,"えいえん"],[34,2,"えいえん"]],"text":"すなわち、唯一の知恵深き神に、イエス・キリストにより、栄光が永遠より永遠にあるように、アァメン。"}]