[{"ref":"2Kgs.11.1","start":12011001,"end":12011001,"break":"paragraph","ruby":[[7,1,"はは"],[15,1,"こ"],[17,1,"し"],[22,1,"み"],[25,1,"た"],[28,1,"おう"],[30,2,"いちぞく"],[38,1,"ほろ"]],"text":"さてアハジヤの母アタリヤはその子の死んだのを見て、立って王の一族をことごとく滅ぼしたが、"},{"ref":"2Kgs.11.2","start":12011002,"end":12011002,"break":"none","ruby":[[3,1,"おう"],[5,1,"むすめ"],[13,2,"しまい"],[28,1,"こ"],[34,1,"ころ"],[44,1,"おう"],[46,1,"こ"],[54,1,"ぬす"],[56,1,"と"],[59,1,"かれ"],[67,2,"しんしつ"],[70,1,"い"],[79,1,"かく"],[85,1,"かれ"],[90,1,"ころ"]],"text":"ヨラム王の娘で、アハジヤの姉妹であるエホシバはアハジヤの子ヨアシを、殺されようとしている王の子たちのうちから盗み取り、彼とそのうばとを寝室に入れて、アタリヤに隠したので、彼はついに殺されなかった。"},{"ref":"2Kgs.11.3","start":12011003,"end":12011003,"break":"none","ruby":[[7,1,"とも"],[10,1,"ねん"],[12,1,"あいだ"],[14,1,"しゅ"],[16,1,"みや"],[18,1,"かく"],[27,1,"かん"],[33,1,"くに"],[35,1,"おさ"]],"text":"ヨアシはうばと共に六年の間、主の宮に隠れていたが、その間アタリヤが国を治めた。"},{"ref":"2Kgs.11.4","start":12011004,"end":12011004,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"ねん"],[12,1,"ひと"],[25,2,"このえ"],[27,1,"へい"],[30,2,"たいしょう"],[35,1,"まね"],[40,1,"しゅ"],[42,1,"みや"],[46,2,"じぶん"],[56,1,"かれ"],[59,2,"けいやく"],[62,1,"むす"],[65,1,"しゅ"],[67,1,"みや"],[69,1,"かれ"],[72,1,"ちか"],[78,1,"おう"],[80,1,"こ"],[82,1,"み"]],"text":"第七年になってエホヤダは人をつかわして、カリびとと近衛兵との大将たちを招きよせ、主の宮にいる自分のもとにこさせ、彼らと契約を結び、主の宮で彼らに誓いをさせて王の子を見せ、"},{"ref":"2Kgs.11.5","start":12011005,"end":12011005,"break":"none","ruby":[[0,1,"めい"],[3,1,"い"],[16,1,"こと"],[28,3,"あんそくにち"],[32,2,"ひばん"],[38,1,"おう"],[40,1,"いえ"],[42,1,"まも"],[51,1,"ぶん"]],"text":"命じて言った、「あなたがたのする事はこれです、すなわち、安息日に非番となって王の家を守るあなたがたの三分の一は、"},{"ref":"2Kgs.11.6","start":12011006,"end":12011006,"break":"none","ruby":[[0,2,"きゅうでん"],[3,1,"まも"],[15,1,"た"],[18,1,"ぶん"],[25,1,"もん"],[31,1,"ぶん"],[35,2,"このえ"],[37,1,"へい"],[43,1,"もん"]],"text":"宮殿を守らなければならない。（他の三分の一はスルの門におり、三分の一は近衛兵のうしろの門におる）。"},{"ref":"2Kgs.11.7","start":12011007,"end":12011007,"break":"none","ruby":[[3,3,"あんそくにち"],[7,2,"とうばん"],[10,1,"しゅ"],[12,1,"みや"],[14,1,"まも"],[25,2,"ぶたい"]],"text":"すべて安息日に当番で主の宮を守るあなたがたの二つの部隊は、"},{"ref":"2Kgs.11.8","start":12011008,"end":12011008,"break":"none","ruby":[[5,2,"ぶき"],[8,1,"て"],[10,1,"と"],[13,1,"おう"],[19,1,"た"],[33,1,"れつ"],[35,1,"ちか"],[38,1,"もの"],[40,1,"ころ"],[58,1,"おう"],[60,1,"で"],[62,1,"とき"],[69,1,"とき"],[72,1,"おう"],[74,1,"とも"]],"text":"おのおのの武器を手に取って王のまわりに立たなければならない。すべて列に近よる者は殺されなければならない。あなたがたは王が出る時にも、はいる時にも王と共にいなければならない」。"},{"ref":"2Kgs.11.9","start":12011009,"end":12011009,"break":"paragraph","ruby":[[5,2,"たいしょう"],[10,2,"さいし"],[20,1,"めい"],[37,1,"かれ"],[44,3,"あんそくにち"],[48,2,"ひばん"],[53,1,"もの"],[56,3,"あんそくにち"],[60,2,"とうばん"],[65,1,"もの"],[68,1,"ひき"],[71,2,"さいし"]],"text":"そこでその大将たちは祭司エホヤダがすべて命じたとおりにおこなった。すなわち彼らはおのおの安息日に非番となる者と、安息日に当番となる者とを率いて祭司エホヤダのもとにきたので、"},{"ref":"2Kgs.11.10","start":12011010,"end":12011010,"break":"none","ruby":[[0,2,"さいし"],[3,1,"しゅ"],[5,1,"みや"],[12,1,"おう"],[17,1,"たて"],[19,2,"たいしょう"],[24,1,"わた"]],"text":"祭司は主の宮にあるダビデ王のやりと盾を大将たちに渡した。"},{"ref":"2Kgs.11.11","start":12011011,"end":12011011,"break":"none","ruby":[[0,2,"このえ"],[2,1,"へい"],[8,1,"て"],[10,2,"ぶき"],[16,1,"しゅ"],[18,1,"みや"],[20,2,"みなみがわ"],[24,2,"きたがわ"],[29,2,"さいだん"],[32,1,"みや"],[34,1,"と"],[36,1,"ま"],[39,1,"た"]],"text":"近衛兵はおのおの手に武器をとって主の宮の南側から北側まで、祭壇と宮を取り巻いて立った。"},{"ref":"2Kgs.11.12","start":12011012,"end":12011012,"break":"none","ruby":[[8,1,"おう"],[10,1,"こ"],[14,1,"だ"],[17,1,"かんむり"],[25,2,"りっぽう"],[28,1,"しょ"],[30,1,"わた"],[33,1,"かれ"],[35,1,"おう"],[37,2,"せんげん"],[41,1,"あぶら"],[43,1,"そそ"],[49,2,"ひとびと"],[52,1,"て"],[54,1,"う"],[58,1,"おう"],[59,2,"ばんざい"],[63,1,"い"]],"text":"そこでエホヤダは王の子をつれ出して冠をいただかせ、律法の書を渡し、彼を王と宣言して油を注いだので、人々は手を打って「王万歳」と言った。"},{"ref":"2Kgs.11.13","start":12011013,"end":12011013,"break":"paragraph","ruby":[[5,2,"このえ"],[7,1,"へい"],[9,1,"たみ"],[11,1,"こえ"],[13,1,"き"],[17,1,"しゅ"],[19,1,"みや"],[21,1,"はい"],[24,1,"たみ"],[30,1,"い"]],"text":"アタリヤは近衛兵と民の声を聞いて、主の宮に入り、民のところへ行って、"},{"ref":"2Kgs.11.14","start":12011014,"end":12011014,"break":"none","ruby":[[0,1,"み"],[4,1,"おう"],[6,2,"かんれい"],[14,1,"はしら"],[21,1,"た"],[24,1,"おう"],[32,2,"たいしょう"],[40,1,"て"],[44,1,"た"],[49,1,"くに"],[51,1,"たみ"],[53,1,"みな"],[54,1,"よろこ"],[61,1,"ふ"],[76,1,"ころも"],[78,1,"さ"],[83,2,"はんぎゃく"],[88,2,"はんぎゃく"],[94,1,"さけ"]],"text":"見ると、王は慣例にしたがって柱のかたわらに立ち、王のかたわらには大将たちとラッパ手たちが立ち、また国の民は皆喜んでラッパを吹いていたので、アタリヤはその衣を裂いて、「反逆です、反逆です」と叫んだ。"},{"ref":"2Kgs.11.15","start":12011015,"end":12011015,"break":"none","ruby":[[2,1,"とき"],[3,2,"さいし"],[10,2,"ぐんぜい"],[13,2,"しき"],[19,2,"たいしょう"],[24,1,"めい"],[29,2,"かのじょ"],[32,1,"れつ"],[34,1,"あいだ"],[40,1,"で"],[42,1,"い"],[46,2,"かのじょ"],[49,1,"したが"],[51,1,"もの"],[60,1,"ころ"],[67,1,"い"],[74,2,"さいし"],[81,2,"かのじょ"],[84,1,"しゅ"],[86,1,"みや"],[88,1,"ころ"],[98,1,"い"]],"text":"その時祭司エホヤダは軍勢を指揮していた大将たちに命じて、「彼女を列の間をとおって出て行かせ、彼女に従う者をつるぎをもって殺しなさい」と言った。これは祭司がさきに「彼女を主の宮で殺してはならない」と言ったからである。"},{"ref":"2Kgs.11.16","start":12011016,"end":12011016,"break":"none","ruby":[[3,1,"かれ"],[6,2,"かのじょ"],[9,1,"とら"],[12,1,"おう"],[14,1,"いえ"],[16,2,"うまみち"],[19,1,"つ"],[22,1,"い"],[27,2,"かのじょ"],[36,1,"ころ"]],"text":"そこで彼らは彼女を捕え、王の家の馬道へ連れて行ったが、彼女はついにそこで殺された。"},{"ref":"2Kgs.11.17","start":12011017,"end":12011017,"break":"paragraph","ruby":[[8,1,"しゅ"],[10,1,"おう"],[14,1,"たみ"],[17,1,"あいだ"],[20,1,"みな"],[21,1,"しゅ"],[23,1,"たみ"],[30,2,"けいやく"],[33,1,"た"],[40,1,"おう"],[42,1,"たみ"],[45,1,"あいだ"],[51,1,"た"]],"text":"かくてエホヤダは主と王および民との間に、皆主の民となるという契約を立てさせ、また王と民との間にもそれを立てさせた。"},{"ref":"2Kgs.11.18","start":12011018,"end":12011018,"break":"none","ruby":[[3,1,"くに"],[5,1,"たみ"],[7,1,"みな"],[12,1,"みや"],[14,1,"い"],[27,2,"さいだん"],[32,1,"ぞう"],[34,1,"う"],[36,1,"くだ"],[43,2,"さいし"],[52,2,"さいだん"],[55,1,"まえ"],[57,1,"ころ"],[64,2,"さいし"],[67,1,"しゅ"],[69,1,"みや"],[71,2,"かんり"],[73,1,"ひと"],[75,1,"お"]],"text":"そこで国の民は皆バアルの宮に行って、これをこわし、その祭壇とその像を打ち砕き、バアルの祭司マッタンをその祭壇の前で殺した。そして祭司は主の宮に管理人を置いた。"},{"ref":"2Kgs.11.19","start":12011019,"end":12011019,"break":"none","ruby":[[0,1,"つ"],[8,2,"たいしょう"],[20,2,"このえ"],[22,1,"へい"],[24,1,"くに"],[30,1,"たみ"],[32,1,"ひき"],[36,1,"しゅ"],[38,1,"みや"],[41,1,"おう"],[43,1,"みちび"],[45,1,"くだ"],[48,2,"このえ"],[50,1,"へい"],[52,1,"もん"],[54,1,"みち"],[57,1,"おう"],[59,1,"いえ"],[61,1,"はい"],[64,1,"おう"],[66,1,"くらい"],[68,1,"ざ"]],"text":"次いでエホヤダは大将たちと、カリびとと、近衛兵と国のすべての民を率いて、主の宮から王を導き下り、近衛兵の門の道から王の家に入り、王の位に座せしめた。"},{"ref":"2Kgs.11.20","start":12011020,"end":12011020,"break":"none","ruby":[[4,1,"くに"],[6,1,"たみ"],[8,1,"みな"],[9,1,"よろこ"],[12,1,"まち"],[19,1,"おう"],[21,1,"いえ"],[30,1,"ころ"]],"text":"こうして国の民は皆喜び、町はアタリヤが王の家でつるぎをもって殺されてのち、おだやかになった。"},{"ref":"2Kgs.11.21","start":12011021,"end":12011021,"break":"none","ruby":[[4,1,"くらい"],[9,1,"とき"],[11,1,"さい"]],"text":"ヨアシは位についた時七歳であった。"}]