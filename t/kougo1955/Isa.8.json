[{"ref":"Isa.8.1","start":23008001,"end":23008001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[13,1,"まい"],[15,1,"おお"],[18,1,"ふだ"],[20,1,"と"],[26,1,"うえ"],[28,2,"ふつう"],[31,2,"もじ"],[52,1,"か"]],"text":"主はわたしに言われた、「一枚の大きな札を取って、その上に普通の文字で、『マヘル・シャラル・ハシ・バズ』と書きなさい」。"},{"ref":"Isa.8.2","start":23008002,"end":23008002,"break":"none","ruby":[[8,1,"たし"],[11,2,"しょうにん"],[17,2,"さいし"],[31,1,"こ"],[37,1,"た"]],"text":"そこで、わたしは確かな証人として、祭司ウリヤおよびエベレキヤの子ゼカリヤを立てた。"},{"ref":"Isa.8.3","start":23008003,"end":23008003,"break":"none","ruby":[[4,3,"よげんしゃ"],[8,1,"つま"],[10,1,"ちか"],[15,2,"かのじょ"],[23,1,"おとこ"],[25,1,"こ"],[27,1,"う"],[33,1,"とき"],[35,1,"しゅ"],[41,1,"い"],[49,1,"な"],[66,1,"よ"]],"text":"わたしが預言者の妻に近づくと、彼女はみごもって男の子を産んだ。その時、主はわたしに言われた、「その名をマヘル・シャラル・ハシ・バズと呼びなさい。"},{"ref":"Isa.8.4","start":23008004,"end":23008004,"break":"none","ruby":[[5,1,"こ"],[23,1,"よ"],[28,1,"し"],[41,1,"とみ"],[53,1,"ひん"],[62,1,"おう"],[64,1,"まえ"],[66,1,"うば"],[68,1,"さ"]],"text":"それはこの子がまだ『おとうさん、おかあさん』と呼ぶことを知らないうちに、ダマスコの富と、サマリヤのぶんどり品とが、アッスリヤ王の前に奪い去られるからである」。"},{"ref":"Isa.8.5","start":23008005,"end":23008005,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"かさ"],[11,1,"い"]],"text":"主はまた重ねてわたしに言われた、"},{"ref":"Isa.8.6","start":23008006,"end":23008006,"break":"none","ruby":[[3,1,"たみ"],[10,1,"なが"],[17,1,"みず"],[19,1,"す"],[32,1,"こ"],[34,1,"まえ"],[36,1,"おそ"]],"text":"「この民はゆるやかに流れるシロアの水を捨てて、レヂンとレマリヤの子の前に恐れくじける。"},{"ref":"Isa.8.7","start":23008007,"end":23008007,"break":"none","ruby":[[4,1,"み"],[7,1,"しゅ"],[9,1,"いきお"],[22,2,"おおかわ"],[25,1,"みず"],[27,1,"かれ"],[36,1,"い"],[51,1,"おう"],[61,2,"いせい"],[75,2,"しりゅう"],[87,1,"きし"],[89,1,"こ"]],"text":"それゆえ見よ、主は勢いたけく、みなぎりわたる大川の水を彼らにむかってせき入れられる。これはアッスリヤの王と、そのもろもろの威勢とであって、そのすべての支流にはびこり、すべての岸を越え、"},{"ref":"Isa.8.8","start":23008008,"end":23008008,"break":"none","ruby":[[3,1,"なが"],[5,1,"い"],[17,1,"くび"],[21,1,"およ"],[34,1,"ひろ"],[37,1,"つばさ"],[48,1,"くに"],[50,1,"み"]],"text":"ユダに流れ入り、あふれみなぎって、首にまで及ぶ。インマヌエルよ、その広げた翼はあまねく、あなたの国に満ちわたる」。"},{"ref":"Isa.8.9","start":23008009,"end":23008009,"break":"stanza","breaks":[[22,"line"],[37,"line"],[50,"line"]],"ruby":[[5,1,"たみ"],[8,1,"う"],[10,1,"やぶ"],[15,1,"おどろ"],[22,1,"とお"],[24,2,"くにぐに"],[31,1,"みみ"],[33,1,"かたむ"],[37,1,"こし"],[39,1,"おび"],[43,1,"おどろ"],[50,1,"こし"],[52,1,"おび"],[56,1,"おどろ"]],"text":"もろもろの民よ、打ち破られて、驚きあわてよ。遠き国々のものよ、耳を傾けよ。腰に帯して、驚きあわてよ。腰に帯して、驚きあわてよ。"},{"ref":"Isa.8.10","start":23008010,"end":23008010,"break":"line","breaks":[[15,"line"],[31,"line"]],"ruby":[[3,1,"はか"],[10,1,"な"],[15,2,"ことば"],[18,1,"だ"],[25,1,"おこな"],[31,1,"かみ"],[38,1,"とも"]],"text":"ともに計れ、しかし、成らない。言葉を出せ、しかし、行われない。神がわれわれと共におられるからである。"},{"ref":"Isa.8.11","start":23008011,"end":23008011,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"つよ"],[5,1,"て"],[15,1,"とら"],[22,1,"かた"],[27,1,"たみ"],[29,1,"みち"],[31,1,"あゆ"],[43,1,"い"]],"text":"主は強いみ手をもって、わたしを捕え、わたしに語り、この民の道に歩まないように、さとして言われた、"},{"ref":"Isa.8.12","start":23008012,"end":23008012,"break":"none","ruby":[[3,1,"たみ"],[8,2,"いんぼう"],[18,2,"いんぼう"],[31,1,"かれ"],[34,1,"おそ"],[40,1,"おそ"]],"text":"「この民がすべて陰謀ととなえるものを陰謀ととなえてはならない。彼らの恐れるものを恐れてはならない。またおののいてはならない。"},{"ref":"Isa.8.13","start":23008013,"end":23008013,"break":"none","ruby":[[9,2,"ばんぐん"],[12,1,"しゅ"],[14,1,"せい"],[19,1,"かれ"],[26,1,"かれ"],[28,1,"おそ"]],"text":"あなたがたは、ただ万軍の主を聖として、彼をかしこみ、彼を恐れなければならない。"},{"ref":"Isa.8.14","start":23008014,"end":23008014,"break":"none","ruby":[[0,1,"しゅ"],[11,1,"いえ"],[14,2,"せいじょ"],[27,1,"いし"],[34,1,"いわ"],[45,2,"じゅうみん"],[49,1,"あみ"]],"text":"主はイスラエルの二つの家には聖所となり、またさまたげの石、つまずきの岩となり、エルサレムの住民には網となり、わなとなる。"},{"ref":"Isa.8.15","start":23008015,"end":23008015,"break":"none","ruby":[[0,1,"おお"],[3,1,"もの"],[15,1,"たお"],[18,1,"やぶ"],[30,1,"とら"]],"text":"多くの者はこれにつまずき、かつ倒れ、破られ、わなにかけられ、捕えられる」。"},{"ref":"Isa.8.16","start":23008016,"end":23008016,"break":"paragraph","ruby":[[16,1,"おしえ"],[20,2,"でし"],[28,1,"ふう"]],"text":"わたしは、あかしを一つにまとめ、教をわが弟子たちのうちに封じておこう。"},{"ref":"Isa.8.17","start":23008017,"end":23008017,"break":"none","ruby":[[0,1,"しゅ"],[9,1,"いえ"],[13,1,"かお"],[34,1,"しゅ"],[36,1,"ま"],[39,1,"しゅ"],[41,1,"のぞ"]],"text":"主はいま、ヤコブの家に、み顔をかくしておられるとはいえ、わたしはその主を待ち、主を望みまつる。"},{"ref":"Isa.8.18","start":23008018,"end":23008018,"break":"none","ruby":[[0,1,"み"],[8,1,"しゅ"],[14,1,"たま"],[18,1,"こ"],[28,1,"やま"],[33,2,"ばんぐん"],[36,1,"しゅ"],[39,1,"あた"],[57,1,"まえ"]],"text":"見よ、わたしと、主のわたしに賜わった子たちとは、シオンの山にいます万軍の主から与えられたイスラエルのしるしであり、前ぶれである。"},{"ref":"Isa.8.19","start":23008019,"end":23008019,"break":"none","ruby":[[0,2,"ひとびと"],[29,1,"かた"],[31,2,"みこ"],[36,3,"まじゅつしゃ"],[40,1,"もと"],[47,1,"とき"],[49,1,"たみ"],[51,2,"じぶん"],[56,1,"かみ"],[58,1,"もと"],[68,1,"い"],[71,1,"もの"],[76,1,"し"],[79,1,"もの"],[81,1,"もと"]],"text":"人々があなたがたにむかって「さえずるように、ささやくように語る巫子および魔術者に求めよ」という時、民は自分たちの神に求むべきではないか。生ける者のために死んだ者に求めるであろうか。"},{"ref":"Isa.8.20","start":23008020,"end":23008020,"break":"none","ruby":[[2,1,"おしえ"],[9,1,"もと"],[17,1,"かれ"],[22,2,"ことば"],[28,1,"かた"],[36,2,"よあ"]],"text":"ただ教とあかしとに求めよ。まことに彼らはこの言葉によって語るが、そこには夜明けがない。"},{"ref":"Isa.8.21","start":23008021,"end":23008021,"break":"none","ruby":[[0,1,"かれ"],[10,1,"う"],[13,1,"くに"],[15,1,"なか"],[17,1,"へ"],[24,1,"う"],[29,1,"いか"],[32,1,"はな"],[35,2,"じぶん"],[40,1,"おう"],[42,2,"じぶん"],[47,1,"かみ"],[57,1,"かお"],[59,1,"てん"],[61,1,"む"]],"text":"彼らはしえたげられ、飢えて国の中を経あるく。その飢えるとき怒りを放ち、自分たちの王、自分たちの神をのろい、かつその顔を天に向ける。"},{"ref":"Isa.8.22","start":23008022,"end":23008022,"break":"none","ruby":[[2,1,"ち"],[4,1,"み"],[8,1,"み"],[11,1,"なや"],[14,1,"くら"],[18,1,"くる"],[29,1,"かれ"],[32,2,"あんこく"],[35,1,"お"]],"text":"また地を見ると、見よ、悩みと暗きと、苦しみのやみとがあり、彼らは暗黒に追いやられる。"}]