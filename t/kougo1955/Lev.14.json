[{"ref":"Lev.14.1","start":3014001,"end":3014001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.14.2","start":3014002,"end":3014002,"break":"none","ruby":[[3,2,"びょうにん"],[6,1,"きよ"],[8,1,"もの"],[13,1,"とき"],[19,1,"つぎ"],[35,1,"ひと"],[37,2,"さいし"],[43,1,"つ"],[46,1,"い"]],"text":"「らい病人が清い者とされる時のおきては次のとおりである。すなわち、その人を祭司のもとに連れて行き、"},{"ref":"Lev.14.3","start":3014003,"end":3014003,"break":"none","ruby":[[0,2,"さいし"],[3,2,"しゅくえい"],[6,1,"そと"],[8,1,"で"],[10,1,"い"],[16,1,"ひと"],[18,1,"み"],[24,1,"びょう"],[26,2,"かんぶ"]],"text":"祭司は宿営の外に出て行って、その人を見、もしらい病の患部がいえているならば、"},{"ref":"Lev.14.4","start":3014004,"end":3014004,"break":"none","ruby":[[0,2,"さいし"],[3,1,"めい"],[8,1,"きよ"],[13,1,"もの"],[19,1,"い"],[24,1,"きよ"],[26,2,"ことり"],[29,1,"わ"],[32,2,"こうはく"],[35,1,"き"],[38,1,"ひ"],[40,1,"いと"],[48,1,"と"]],"text":"祭司は命じてその清められる者のために、生きている清い小鳥二羽と、香柏の木と、緋の糸と、ヒソプとを取ってこさせ、"},{"ref":"Lev.14.5","start":3014005,"end":3014005,"break":"none","ruby":[[0,2,"さいし"],[5,1,"めい"],[11,2,"ことり"],[15,1,"わ"],[18,1,"なが"],[20,1,"みず"],[22,1,"も"],[25,1,"つち"],[27,1,"うつわ"],[29,1,"うえ"],[31,1,"ころ"]],"text":"祭司はまた命じて、その小鳥の一羽を、流れ水を盛った土の器の上で殺させ、"},{"ref":"Lev.14.6","start":3014006,"end":3014006,"break":"none","ruby":[[3,1,"い"],[8,2,"ことり"],[12,2,"こうはく"],[15,1,"き"],[18,1,"ひ"],[20,1,"いと"],[27,1,"とも"],[29,1,"と"],[38,1,"なが"],[40,1,"みず"],[42,1,"も"],[45,1,"つち"],[47,1,"うつわ"],[49,1,"うえ"],[51,1,"ころ"],[54,2,"ことり"],[57,1,"ち"],[62,1,"い"],[67,2,"ことり"],[70,1,"とも"],[72,1,"ひた"]],"text":"そして生きている小鳥を、香柏の木と、緋の糸と、ヒソプと共に取って、これをかの流れ水を盛った土の器の上で殺した小鳥の血に、その生きている小鳥と共に浸し、"},{"ref":"Lev.14.7","start":3014007,"end":3014007,"break":"none","ruby":[[5,1,"びょう"],[8,1,"きよ"],[13,1,"もの"],[18,1,"そそ"],[24,1,"ひと"],[26,1,"きよ"],[28,1,"もの"],[34,1,"い"],[39,2,"ことり"],[42,1,"の"],[44,1,"はな"]],"text":"これをらい病から清められる者に七たび注いで、その人を清い者とし、その生きている小鳥は野に放たなければならない。"},{"ref":"Lev.14.8","start":3014008,"end":3014008,"break":"none","ruby":[[0,1,"きよ"],[5,1,"もの"],[9,2,"いふく"],[12,1,"あら"],[15,1,"け"],[24,1,"おと"],[27,1,"みず"],[29,1,"み"],[35,1,"きよ"],[42,1,"のち"],[44,2,"しゅくえい"],[60,2,"なぬか"],[63,1,"あいだ"],[67,2,"てんまく"],[70,1,"そと"]],"text":"清められる者はその衣服を洗い、毛をことごとくそり落し、水に身をすすいで清くなり、その後、宿営にはいることができる。ただし七日の間はその天幕の外にいなければならない。"},{"ref":"Lev.14.9","start":3014009,"end":3014009,"break":"none","ruby":[[3,2,"なぬか"],[5,1,"め"],[7,1,"け"],[24,1,"あたま"],[26,1,"け"],[53,1,"かれ"],[57,2,"いふく"],[60,1,"あら"],[63,1,"みず"],[65,1,"み"],[71,1,"きよ"]],"text":"そして七日目に毛をことごとくそらなければならい。頭の毛も、ひげも、まゆも、ことごとくそらなければならない。彼はその衣服を洗い、水に身をすすいで清くなるであろう。"},{"ref":"Lev.14.10","start":3014010,"end":3014010,"break":"paragraph","ruby":[[1,1,"か"],[2,1,"め"],[6,1,"ひと"],[8,1,"おす"],[10,2,"こひつじ"],[13,1,"まった"],[18,1,"とう"],[22,1,"さい"],[24,1,"めす"],[26,2,"こひつじ"],[29,1,"まった"],[34,1,"とう"],[37,1,"と"],[42,2,"むぎこ"],[45,1,"ぶん"],[51,1,"あぶら"],[53,1,"ま"],[56,2,"そさい"],[60,1,"あぶら"],[66,1,"と"]],"text":"八日目にその人は雄の小羊の全きもの二頭と、一歳の雌の小羊の全きもの一頭とを取り、また麦粉十分の三エパに油を混ぜた素祭と、油一ログとを取らなければならない。"},{"ref":"Lev.14.11","start":3014011,"end":3014011,"break":"none","ruby":[[0,1,"きよ"],[5,2,"さいし"],[9,1,"きよ"],[14,1,"ひと"],[20,1,"もの"],[24,2,"かいけん"],[27,2,"まくや"],[30,2,"いりぐち"],[33,1,"しゅ"],[35,1,"まえ"],[37,1,"お"]],"text":"清めをなす祭司は、清められる人とこれらの物とを、会見の幕屋の入口で主の前に置き、"},{"ref":"Lev.14.12","start":3014012,"end":3014012,"break":"none","ruby":[[0,2,"さいし"],[6,1,"おす"],[8,2,"こひつじ"],[11,1,"とう"],[13,1,"と"],[24,1,"あぶら"],[26,1,"とも"],[28,2,"けんさい"],[42,1,"しゅ"],[44,1,"まえ"],[46,1,"ゆ"],[48,1,"うご"],[52,2,"ようさい"]],"text":"祭司は、かの雄の小羊一頭を取って、これを一ログの油と共に愆祭としてささげ、またこれを主の前に揺り動かして揺祭としなければならない。"},{"ref":"Lev.14.13","start":3014013,"end":3014013,"break":"none","ruby":[[2,1,"おす"],[4,2,"こひつじ"],[7,2,"ざいさい"],[12,2,"はんさい"],[18,2,"ばしょ"],[25,1,"せい"],[28,1,"ところ"],[46,2,"けんさい"],[49,2,"ざいさい"],[52,1,"おな"],[56,2,"さいし"],[59,1,"き"],[71,1,"せい"],[74,1,"もの"]],"text":"この雄の小羊は罪祭および燔祭をほふる場所、すなわち聖なる所で、これをほふらなければならない。愆祭は罪祭と同じく、祭司に帰するものであって、いと聖なる物である。"},{"ref":"Lev.14.14","start":3014014,"end":3014014,"break":"none","ruby":[[3,2,"さいし"],[8,2,"けんさい"],[11,1,"ち"],[13,1,"と"],[19,1,"きよ"],[24,1,"もの"],[26,1,"みぎ"],[28,1,"みみ"],[33,1,"みぎ"],[35,1,"て"],[37,2,"おやゆび"],[41,1,"みぎ"],[43,1,"あし"],[45,2,"おやゆび"]],"text":"そして祭司はその愆祭の血を取り、これを清められる者の右の耳たぶと、右の手の親指と、右の足の親指とにつけなければならない。"},{"ref":"Lev.14.15","start":3014015,"end":3014015,"break":"none","ruby":[[0,2,"さいし"],[9,1,"あぶら"],[11,1,"と"],[18,2,"じぶん"],[21,1,"ひだり"],[23,1,"て"],[28,1,"そそ"]],"text":"祭司はまた一ログの油を取って、これを自分の左の手のひらに注ぎ、"},{"ref":"Lev.14.16","start":3014016,"end":3014016,"break":"none","ruby":[[3,2,"さいし"],[6,1,"みぎ"],[8,1,"ゆび"],[10,1,"ひだり"],[12,1,"て"],[19,1,"あぶら"],[21,1,"ひた"],[26,1,"ゆび"],[34,1,"あぶら"],[39,1,"しゅ"],[41,1,"まえ"],[43,1,"そそ"]],"text":"そして祭司は右の指を左の手のひらにある油に浸し、その指をもって、その油を七たび主の前に注がなければならない。"},{"ref":"Lev.14.17","start":3014017,"end":3014017,"break":"none","ruby":[[0,2,"さいし"],[3,1,"て"],[10,1,"あぶら"],[12,1,"のこ"],[16,1,"きよ"],[21,1,"もの"],[23,1,"みぎ"],[25,1,"みみ"],[30,1,"みぎ"],[32,1,"て"],[34,2,"おやゆび"],[38,1,"みぎ"],[40,1,"あし"],[42,2,"おやゆび"],[53,2,"けんさい"],[56,1,"ち"],[58,1,"うえ"]],"text":"祭司は手のひらにある油の残りを、清められる者の右の耳たぶと、右の手の親指と、右の足の親指とに、さきにつけた愆祭の血の上につけなければならない。"},{"ref":"Lev.14.18","start":3014018,"end":3014018,"break":"none","ruby":[[3,2,"さいし"],[6,1,"て"],[13,1,"のこ"],[18,1,"あぶら"],[21,1,"きよ"],[26,1,"もの"],[28,1,"あたま"],[33,1,"しゅ"],[35,1,"まえ"],[40,1,"ひと"]],"text":"そして祭司は手のひらになお残っている油を、清められる者の頭につけ、主の前で、その人のためにあがないをしなければならない。"},{"ref":"Lev.14.19","start":3014019,"end":3014019,"break":"none","ruby":[[2,2,"さいし"],[5,2,"ざいさい"],[13,1,"けが"],[20,1,"きよ"],[29,1,"もの"],[43,1,"のち"],[45,2,"はんさい"]],"text":"また祭司は罪祭をささげて、汚れのゆえに、清められねばならぬ者のためにあがないをし、その後、燔祭のものをほふらなければならない。"},{"ref":"Lev.14.20","start":3014020,"end":3014020,"break":"none","ruby":[[3,2,"さいし"],[6,2,"はんさい"],[9,2,"そさい"],[13,2,"さいだん"],[16,1,"うえ"],[24,1,"ひと"],[51,1,"ひと"],[53,1,"きよ"]],"text":"そして祭司は燔祭と素祭とを祭壇の上にささげ、その人のために、あがないをしなければならない。こうしてその人は清くなるであろう。"},{"ref":"Lev.14.21","start":3014021,"end":3014021,"break":"paragraph","ruby":[[2,1,"ひと"],[6,1,"まず"],[14,1,"て"],[16,1,"とど"],[20,1,"とき"],[23,2,"じぶん"],[34,1,"ゆ"],[36,1,"うご"],[39,2,"けんさい"],[45,1,"おす"],[47,2,"こひつじ"],[50,1,"とう"],[52,1,"と"],[57,2,"そさい"],[62,1,"あぶら"],[64,1,"ま"],[67,2,"むぎこ"],[70,1,"ぶん"],[77,1,"あぶら"],[83,1,"と"]],"text":"その人がもし貧しくて、それに手の届かない時は、自分のあがないのために揺り動かす愆祭として、雄の小羊一頭を取り、また素祭として油を混ぜた麦粉十分の一エパと、油一ログとを取り、"},{"ref":"Lev.14.22","start":3014022,"end":3014022,"break":"none","ruby":[[5,1,"て"],[7,1,"とど"],[9,1,"やま"],[13,1,"わ"],[18,1,"いえ"],[25,1,"わ"],[27,1,"と"],[43,2,"ざいさい"],[49,1,"た"],[54,2,"はんさい"]],"text":"さらにその手の届く山ばと二羽、または家ばとのひな二羽を取らなければならない。その一つは罪祭のため、他の一つは燔祭のためである。"},{"ref":"Lev.14.23","start":3014023,"end":3014023,"break":"none","ruby":[[4,1,"か"],[5,1,"め"],[10,1,"きよ"],[16,2,"かいけん"],[19,2,"まくや"],[22,2,"いりぐち"],[27,2,"さいし"],[33,1,"しゅ"],[35,1,"まえ"],[40,1,"たずさ"],[43,1,"い"]],"text":"そして八日目に、その清めのために会見の幕屋の入口におる祭司のもと、主の前にこれを携えて行かなければならない。"},{"ref":"Lev.14.24","start":3014024,"end":3014024,"break":"none","ruby":[[0,2,"さいし"],[5,2,"けんさい"],[8,1,"おす"],[10,2,"こひつじ"],[18,1,"あぶら"],[21,1,"と"],[27,1,"しゅ"],[29,1,"まえ"],[31,1,"ゆ"],[33,1,"うご"],[37,2,"ようさい"]],"text":"祭司はその愆祭の雄の小羊と、一ログの油とを取り、これを主の前に揺り動かして揺祭としなければならない。"},{"ref":"Lev.14.25","start":3014025,"end":3014025,"break":"none","ruby":[[3,2,"さいし"],[6,2,"けんさい"],[9,1,"おす"],[11,2,"こひつじ"],[20,2,"けんさい"],[23,1,"ち"],[25,1,"と"],[32,1,"きよ"],[37,1,"もの"],[39,1,"みぎ"],[41,1,"みみ"],[46,1,"みぎ"],[48,1,"て"],[50,2,"おやゆび"],[54,1,"みぎ"],[56,1,"あし"],[58,2,"おやゆび"]],"text":"そして祭司は愆祭の雄の小羊をほふり、その愆祭の血を取って、これを清められる者の右の耳たぶと、右の手の親指と、右の足の親指とにつけなければならない。"},{"ref":"Lev.14.26","start":3014026,"end":3014026,"break":"none","ruby":[[2,2,"さいし"],[7,1,"あぶら"],[9,2,"じぶん"],[12,1,"ひだり"],[14,1,"て"],[19,1,"そそ"]],"text":"また祭司はその油を自分の左の手のひらに注ぎ、"},{"ref":"Lev.14.27","start":3014027,"end":3014027,"break":"none","ruby":[[0,2,"さいし"],[5,1,"みぎ"],[7,1,"ゆび"],[13,1,"ひだり"],[15,1,"て"],[22,1,"あぶら"],[28,1,"しゅ"],[30,1,"まえ"],[32,1,"そそ"]],"text":"祭司はその右の指をもって、左の手のひらにある油を、七たび主の前に注がなければならない。"},{"ref":"Lev.14.28","start":3014028,"end":3014028,"break":"none","ruby":[[2,2,"さいし"],[7,1,"て"],[14,1,"あぶら"],[17,1,"きよ"],[22,1,"もの"],[24,1,"みぎ"],[26,1,"みみ"],[31,1,"みぎ"],[33,1,"て"],[35,2,"おやゆび"],[39,1,"みぎ"],[41,1,"あし"],[43,2,"おやゆび"],[53,2,"けんさい"],[56,1,"ち"]],"text":"また祭司はその手のひらにある油を、清められる者の右の耳たぶと、右の手の親指と、右の足の親指とに、すなわち、愆祭の血をつけたところにつけなければならない。"},{"ref":"Lev.14.29","start":3014029,"end":3014029,"break":"none","ruby":[[2,2,"さいし"],[5,1,"て"],[10,1,"のこ"],[15,1,"あぶら"],[18,1,"きよ"],[23,1,"もの"],[25,1,"あたま"],[30,1,"しゅ"],[32,1,"まえ"],[37,1,"ひと"]],"text":"また祭司は手のひらに残っている油を、清められる者の頭につけ、主の前で、その人のために、あがないをしなければならない。"},{"ref":"Lev.14.30","start":3014030,"end":3014030,"break":"none","ruby":[[2,1,"ひと"],[6,1,"て"],[8,1,"とど"],[10,1,"やま"],[14,1,"わ"],[19,1,"いえ"],[26,1,"わ"]],"text":"その人はその手の届く山ばと一羽、または家ばとのひな一羽をささげなければならない。"},{"ref":"Lev.14.31","start":3014031,"end":3014031,"break":"none","ruby":[[7,1,"て"],[9,1,"とど"],[17,2,"ざいさい"],[22,1,"た"],[27,2,"はんさい"],[32,2,"そさい"],[35,1,"とも"],[53,2,"さいし"],[56,1,"きよ"],[61,1,"もの"],[67,1,"しゅ"],[69,1,"まえ"]],"text":"すなわち、その手の届くものの一つを罪祭とし、他の一つを燔祭として素祭と共にささげなければならない。こうして祭司は清められる者のために、主の前にあがないをするであろう。"},{"ref":"Lev.14.32","start":3014032,"end":3014032,"break":"none","ruby":[[5,1,"びょう"],[7,2,"かんじゃ"],[13,1,"きよ"],[16,2,"ひつよう"],[23,1,"て"],[25,1,"とど"],[29,1,"もの"]],"text":"これはらい病の患者で、その清めに必要なものに、手の届かない者のためのおきてである」。"},{"ref":"Lev.14.33","start":3014033,"end":3014033,"break":"paragraph","ruby":[[0,1,"しゅ"],[12,1,"い"]],"text":"主はまたモーセとアロンに言われた、"},{"ref":"Lev.14.34","start":3014034,"end":3014034,"break":"none","ruby":[[7,2,"しょゆう"],[12,1,"あた"],[19,1,"ち"],[31,1,"とき"],[35,2,"しょゆう"],[38,1,"ち"],[44,1,"いえ"],[52,1,"びょう"],[54,2,"かんぶ"],[57,1,"しょう"]],"text":"「あなたがたに所有として与えるカナンの地に、あなたがたがはいる時、その所有の地において、家にわたしがらい病の患部を生じさせることがあれば、"},{"ref":"Lev.14.35","start":3014035,"end":3014035,"break":"none","ruby":[[2,1,"いえ"],[4,1,"も"],[6,1,"ぬし"],[11,2,"さいし"],[14,1,"つ"],[18,2,"かんぶ"],[32,1,"いえ"],[40,1,"い"]],"text":"その家の持ち主はきて、祭司に告げ、『患部のようなものが、わたしの家にあります』と言わなければならない。"},{"ref":"Lev.14.36","start":3014036,"end":3014036,"break":"none","ruby":[[0,2,"さいし"],[3,1,"めい"],[7,2,"さいし"],[12,2,"かんぶ"],[15,1,"み"],[17,1,"い"],[19,1,"まえ"],[24,1,"いえ"],[33,1,"いえ"],[41,1,"もの"],[43,1,"けが"],[55,1,"のち"],[57,2,"さいし"],[67,1,"いえ"],[69,1,"み"]],"text":"祭司は命じて、祭司がその患部を見に行く前に、その家をあけさせ、その家にあるすべての物が汚されないようにし、その後、祭司は、はいってその家を見なければならない。"},{"ref":"Lev.14.37","start":3014037,"end":3014037,"break":"none","ruby":[[2,2,"かんぶ"],[5,1,"み"],[12,2,"かんぶ"],[15,1,"いえ"],[17,1,"かべ"],[23,1,"あお"],[27,1,"あか"],[39,1,"かべ"],[43,1,"ひく"],[45,1,"み"]],"text":"その患部を見て、もしその患部が家の壁にあって、青または赤のくぼみをもち、それが壁よりも低く見えるならば、"},{"ref":"Lev.14.38","start":3014038,"end":3014038,"break":"none","ruby":[[0,2,"さいし"],[5,1,"いえ"],[7,1,"で"],[10,1,"いえ"],[12,2,"いりぐち"],[19,2,"なぬか"],[22,1,"あいだ"],[25,1,"いえ"],[27,2,"へいさ"]],"text":"祭司はその家を出て、家の入口にいたり、七日の間その家を閉鎖しなければならない。"},{"ref":"Lev.14.39","start":3014039,"end":3014039,"break":"none","ruby":[[0,2,"さいし"],[3,2,"なぬか"],[5,1,"め"],[15,1,"み"],[19,2,"かんぶ"],[24,1,"いえ"],[26,1,"かべ"],[28,1,"ひろ"]],"text":"祭司は七日目に、またきてそれを見、その患部がもし家の壁に広がっているならば、"},{"ref":"Lev.14.40","start":3014040,"end":3014040,"break":"none","ruby":[[0,2,"さいし"],[3,1,"めい"],[9,2,"かんぶ"],[14,1,"いし"],[16,1,"と"],[18,1,"だ"],[21,1,"まち"],[23,1,"そと"],[25,1,"けが"],[28,1,"もの"],[30,1,"す"],[33,2,"ばしょ"],[36,1,"す"]],"text":"祭司は命じて、その患部のある石を取り出し、町の外の汚れた物を捨てる場所に捨てさせ、"},{"ref":"Lev.14.41","start":3014041,"end":3014041,"break":"none","ruby":[[4,1,"いえ"],[6,2,"うちがわ"],[13,1,"けず"],[19,1,"けず"],[27,1,"まち"],[29,1,"そと"],[31,1,"けが"],[34,1,"もの"],[36,1,"す"],[39,2,"ばしょ"],[42,1,"す"]],"text":"またその家の内側のまわりを削らせ、その削ったしっくいを町の外の汚れた物を捨てる場所に捨てさせ、"},{"ref":"Lev.14.42","start":3014042,"end":3014042,"break":"none","ruby":[[3,1,"いし"],[5,1,"と"],[9,1,"もと"],[11,1,"いし"],[17,1,"い"],[32,1,"と"],[36,1,"いえ"],[38,1,"ぬ"]],"text":"ほかの石を取って、元の石のところに入れさせ、またほかのしっくいを取って、家を塗らせなければならない。"},{"ref":"Lev.14.43","start":3014043,"end":3014043,"break":"paragraph","ruby":[[5,1,"いし"],[7,1,"と"],[9,1,"だ"],[12,1,"いえ"],[14,1,"けず"],[17,1,"ぬ"],[22,1,"のち"],[27,2,"かんぶ"],[32,1,"ふたた"],[34,1,"いえ"],[36,1,"で"]],"text":"このように石を取り出し、家を削り、塗りかえた後に、その患部がもし再び家に出るならば、"},{"ref":"Lev.14.44","start":3014044,"end":3014044,"break":"none","ruby":[[0,2,"さいし"],[7,1,"み"],[17,2,"かんぶ"],[22,1,"いえ"],[24,1,"ひろ"],[37,1,"いえ"],[41,2,"あくせい"],[46,1,"びょう"],[55,1,"けが"],[58,1,"もの"]],"text":"祭司はまたきて見なければならない。患部がもし家に広がっているならば、これは家にある悪性のらい病であって、これは汚れた物である。"},{"ref":"Lev.14.45","start":3014045,"end":3014045,"break":"none","ruby":[[2,1,"いえ"],[11,1,"いし"],[15,1,"き"],[19,1,"いえ"],[32,1,"まち"],[34,1,"そと"],[36,1,"けが"],[39,1,"もの"],[41,1,"す"],[44,2,"ばしょ"],[47,1,"はこ"],[49,1,"だ"]],"text":"その家は、こぼち、その石、その木、その家のしっくいは、ことごとく町の外の汚れた物を捨てる場所に運び出さなければならない。"},{"ref":"Lev.14.46","start":3014046,"end":3014046,"break":"none","ruby":[[2,1,"いえ"],[4,2,"へいさ"],[11,1,"ひ"],[13,1,"あいだ"],[22,1,"もの"],[24,1,"ゆう"],[27,1,"けが"]],"text":"その家が閉鎖されている日の間に、これにはいる者は夕まで汚れるであろう。"},{"ref":"Lev.14.47","start":3014047,"end":3014047,"break":"none","ruby":[[2,1,"いえ"],[4,1,"ね"],[6,1,"もの"],[10,2,"いふく"],[13,1,"あら"],[26,1,"いえ"],[28,1,"しょく"],[31,1,"もの"],[36,2,"いふく"],[39,1,"あら"]],"text":"その家に寝る者はその衣服を洗わなければならない。その家で食する者も、その衣服を洗わなければならない。"},{"ref":"Lev.14.48","start":3014048,"end":3014048,"break":"paragraph","ruby":[[4,2,"さいし"],[11,1,"み"],[16,1,"いえ"],[18,1,"ぬ"],[23,1,"のち"],[28,2,"かんぶ"],[31,1,"いえ"],[33,1,"ひろ"],[48,2,"かんぶ"],[61,2,"さいし"],[66,1,"いえ"],[68,1,"きよ"]],"text":"しかし、祭司がはいって見て、もし家を塗りかえた後に、その患部が家に広がっていなければ、これはその患部がいえたのであるから、祭司はその家を清いものとしなければならない。"},{"ref":"Lev.14.49","start":3014049,"end":3014049,"break":"none","ruby":[[2,1,"かれ"],[6,1,"いえ"],[8,1,"きよ"],[15,2,"ことり"],[18,1,"わ"],[21,2,"こうはく"],[24,1,"き"],[27,1,"ひ"],[29,1,"いと"],[37,1,"と"]],"text":"また彼はその家を清めるために、小鳥二羽と、香柏の木と、緋の糸と、ヒソプとを取り、"},{"ref":"Lev.14.50","start":3014050,"end":3014050,"break":"none","ruby":[[2,2,"ことり"],[6,1,"わ"],[8,1,"なが"],[10,1,"みず"],[12,1,"も"],[15,1,"つち"],[17,1,"うつわ"],[19,1,"うえ"],[21,1,"ころ"]],"text":"その小鳥の一羽を流れ水を盛った土の器の上で殺し、"},{"ref":"Lev.14.51","start":3014051,"end":3014051,"break":"none","ruby":[[0,2,"こうはく"],[3,1,"き"],[11,1,"ひ"],[13,1,"いと"],[16,1,"い"],[21,2,"ことり"],[25,1,"と"],[31,1,"ころ"],[34,2,"ことり"],[37,1,"ち"],[39,1,"なが"],[41,1,"みず"],[43,1,"ひた"],[52,1,"いえ"],[54,1,"そそ"]],"text":"香柏の木と、ヒソプと、緋の糸と、生きている小鳥とを取って、その殺した小鳥の血と流れ水に浸し、これを七たび家に注がなければならない。"},{"ref":"Lev.14.52","start":3014052,"end":3014052,"break":"none","ruby":[[4,2,"さいし"],[7,2,"ことり"],[10,1,"ち"],[12,1,"なが"],[14,1,"みず"],[17,1,"い"],[22,2,"ことり"],[26,2,"こうはく"],[29,1,"き"],[37,1,"ひ"],[39,1,"いと"],[45,1,"いえ"],[47,1,"きよ"]],"text":"こうして祭司は小鳥の血と流れ水と、生きている小鳥と、香柏の木と、ヒソプと、緋の糸とをもって家を清め、"},{"ref":"Lev.14.53","start":3014053,"end":3014053,"break":"none","ruby":[[2,1,"い"],[7,2,"ことり"],[10,1,"まち"],[12,1,"そと"],[14,1,"の"],[16,1,"はな"],[22,1,"いえ"],[51,1,"きよ"]],"text":"その生きている小鳥は町の外の野に放して、その家のために、あがないをしなければならない。こうして、それは清くなるであろう」。"},{"ref":"Lev.14.54","start":3014054,"end":3014054,"break":"paragraph","ruby":[[5,1,"びょう"],[11,2,"かんぶ"]],"text":"これはらい病のすべての患部、かいせん、"},{"ref":"Lev.14.55","start":3014055,"end":3014055,"break":"none","ruby":[[3,2,"いふく"],[6,1,"いえ"],[10,1,"びょう"]],"text":"および衣服と家のらい病、"},{"ref":"Lev.14.56","start":3014056,"end":3014056,"break":"none","ruby":[[4,1,"しゅ"],[7,3,"ふきでもの"],[12,1,"ひか"],[14,1,"ところ"],[17,1,"かん"]],"text":"ならびに腫と、吹出物と、光る所とに関するおきてであって、"},{"ref":"Lev.14.57","start":3014057,"end":3014057,"break":"none","ruby":[[5,1,"けが"],[17,1,"きよ"],[21,1,"おし"],[35,1,"びょう"],[37,1,"かん"]],"text":"いつそれが汚れているか、いつそれが清いかを教えるものである。これがらい病に関するおきてである。"}]