[{"ref":"Ezek.3.1","start":26003001,"end":26003001,"break":"paragraph","ruby":[[0,1,"かれ"],[6,1,"い"],[12,1,"ひと"],[14,1,"こ"],[21,1,"あた"],[29,1,"た"],[37,2,"まきもの"],[40,1,"た"],[43,1,"い"],[52,1,"いえ"],[54,1,"かた"]],"text":"彼はわたしに言われた。「人の子よ、あなたに与えられたものを食べなさい。この巻物を食べ、行ってイスラエルの家に語りなさい」。"},{"ref":"Ezek.3.2","start":26003002,"end":26003002,"break":"none","ruby":[[7,1,"くち"],[9,1,"ひら"],[13,1,"かれ"],[21,2,"まきもの"],[24,1,"た"]],"text":"そこでわたしが口を開くと、彼はわたしにその巻物を食べさせた。"},{"ref":"Ezek.3.3","start":26003003,"end":26003003,"break":"none","ruby":[[3,1,"かれ"],[9,1,"い"],[15,1,"ひと"],[17,1,"こ"],[28,1,"あた"],[33,2,"まきもの"],[36,1,"た"],[46,1,"はら"],[48,1,"み"],[63,1,"た"],[75,1,"くち"],[77,1,"あま"],[81,1,"みつ"]],"text":"そして彼はわたしに言われた、「人の子よ、わたしがあなたに与えるこの巻物を食べ、これであなたの腹を満たしなさい」。わたしがそれを食べると、それはわたしの口に甘いこと蜜のようであった。"},{"ref":"Ezek.3.4","start":26003004,"end":26003004,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"い"],[14,1,"ひと"],[16,1,"こ"],[25,1,"いえ"],[27,1,"い"],[35,2,"ことば"],[38,1,"かた"]],"text":"彼はまたわたしに言われた、「人の子よ、イスラエルの家に行って、わたしの言葉を語りなさい。"},{"ref":"Ezek.3.5","start":26003005,"end":26003005,"break":"none","ruby":[[9,2,"いこく"],[11,1,"ご"],[13,1,"もち"],[16,1,"した"],[18,1,"おも"],[20,1,"たみ"],[37,1,"いえ"]],"text":"わたしはあなたを、異国語を用い、舌の重い民につかわすのでなく、イスラエルの家につかわすのである。"},{"ref":"Ezek.3.6","start":26003006,"end":26003006,"break":"none","ruby":[[10,2,"ことば"],[13,1,"し"],[18,2,"いこく"],[20,1,"ご"],[22,1,"した"],[24,1,"おも"],[26,1,"おお"],[29,1,"たみ"],[56,1,"たみ"],[65,1,"かれ"],[72,1,"き"]],"text":"すなわちあなたがその言葉を知らない、異国語の舌の重い多くの民につかわすのではない。もしわたしがあなたをそのような民につかわしたら、彼らはあなたに聞いたであろう。"},{"ref":"Ezek.3.7","start":26003007,"end":26003007,"break":"none","ruby":[[9,1,"いえ"],[15,1,"き"],[19,1,"この"],[24,1,"かれ"],[31,1,"き"],[35,1,"この"],[51,1,"いえ"],[56,2,"こうがん"],[61,2,"ごうじょう"]],"text":"しかしイスラエルの家はあなたに聞くのを好まない。彼らはわたしに聞くのを好まないからである。イスラエルの家はすべて厚顔でまた強情である。"},{"ref":"Ezek.3.8","start":26003008,"end":26003008,"break":"none","ruby":[[0,1,"み"],[11,1,"かお"],[13,1,"かれ"],[16,1,"かお"],[18,1,"む"],[22,1,"かた"],[30,1,"ひたい"],[32,1,"かれ"],[35,1,"ひたい"],[37,1,"む"],[41,1,"かた"]],"text":"見よ、わたしはあなたの顔を彼らの顔に向かって堅くし、あなたの額を彼らの額に向かって堅くした。"},{"ref":"Ezek.3.9","start":26003009,"end":26003009,"break":"none","ruby":[[8,1,"ひたい"],[10,1,"いわ"],[14,1,"かた"],[32,1,"かれ"],[35,1,"おそ"],[44,1,"かれ"],[47,1,"かお"],[60,1,"かれ"],[63,2,"はんぎゃく"],[66,1,"いえ"]],"text":"わたしはあなたの額を岩よりも堅いダイヤモンドのようにした。ゆえに彼らを恐れてはならない。彼らの顔をはばかってはならない。彼らは反逆の家である」。"},{"ref":"Ezek.3.10","start":26003010,"end":26003010,"break":"none","ruby":[[2,1,"かれ"],[8,1,"い"],[14,1,"ひと"],[16,1,"こ"],[27,1,"かた"],[33,2,"ことば"],[40,1,"こころ"],[50,1,"みみ"],[52,1,"き"]],"text":"また彼はわたしに言われた、「人の子よ、わたしがあなたに語るすべての言葉をあなたの心におさめ、あなたの耳に聞きなさい。"},{"ref":"Ezek.3.11","start":26003011,"end":26003011,"break":"none","ruby":[[3,2,"ほしゅう"],[6,2,"ひとびと"],[13,1,"たみ"],[15,2,"ひとびと"],[18,1,"ところ"],[20,1,"い"],[24,1,"かれ"],[27,1,"き"],[32,1,"かれ"],[35,1,"こば"],[41,1,"しゅ"],[44,1,"かみ"],[48,1,"い"],[54,1,"かれ"],[57,1,"い"]],"text":"そして捕囚の人々、あなたの民の人々の所へ行って、彼らが聞いても、彼らが拒んでも、『主なる神はこう言われる』と彼らに言いなさい」。"},{"ref":"Ezek.3.12","start":26003012,"end":26003012,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"れい"],[16,1,"しゅ"],[18,2,"えいこう"],[23,1,"ところ"],[30,1,"とき"],[36,1,"うしろ"],[38,1,"おお"],[42,2,"じしん"],[45,1,"ひび"],[48,1,"き"]],"text":"時に霊がわたしをもたげた。そして主の栄光がその所からのぼった時、わたしの後に大いなる地震の響きを聞いた。"},{"ref":"Ezek.3.13","start":26003013,"end":26003013,"break":"none","ruby":[[3,1,"たがい"],[5,2,"あいふ"],[9,1,"い"],[14,1,"つばさ"],[16,1,"おと"],[26,1,"わ"],[28,1,"おと"],[31,1,"おお"],[35,2,"じしん"],[41,1,"ひび"]],"text":"それは互に相触れる生きものの翼の音と、そのかたわらの輪の音で、大いなる地震のように響いた。"},{"ref":"Ezek.3.14","start":26003014,"end":26003014,"break":"none","ruby":[[0,1,"れい"],[14,1,"と"],[16,1,"さ"],[26,1,"こころ"],[28,1,"あつ"],[32,2,"にがにが"],[36,1,"おも"],[39,1,"で"],[41,1,"い"],[45,1,"しゅ"],[47,1,"て"],[49,1,"つよ"],[55,1,"うえ"]],"text":"霊はわたしをもたげ、わたしを取り去ったので、わたしは心を熱くし、苦々しい思いで出て行った。主の手が強くわたしの上にあった。"},{"ref":"Ezek.3.15","start":26003015,"end":26003015,"break":"none","ruby":[[10,1,"がわ"],[24,2,"ほしゅう"],[27,2,"ひとびと"],[33,1,"い"],[36,2,"なぬか"],[39,1,"あいだ"],[41,1,"おどろ"],[47,1,"かれ"],[50,1,"なか"],[52,1,"ざ"]],"text":"そしてわたしはケバル川のほとりのテルアビブにいる捕囚の人々のもとへ行き、七日の間、驚きあきれて彼らの中に座した。"},{"ref":"Ezek.3.16","start":26003016,"end":26003016,"break":"paragraph","ruby":[[0,2,"なぬか"],[2,1,"す"],[5,1,"のち"],[7,1,"しゅ"],[9,2,"ことば"],[16,1,"のぞ"]],"text":"七日過ぎて後、主の言葉がわたしに臨んだ、"},{"ref":"Ezek.3.17","start":26003017,"end":26003017,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[20,1,"いえ"],[25,2,"みまも"],[28,1,"もの"],[41,1,"くち"],[44,2,"ことば"],[47,1,"き"],[57,1,"かわ"],[60,1,"かれ"],[63,1,"いまし"]],"text":"「人の子よ、わたしはあなたをイスラエルの家のために見守る者とした。あなたはわたしの口から言葉を聞くたびに、わたしに代って彼らを戒めなさい。"},{"ref":"Ezek.3.18","start":26003018,"end":26003018,"break":"none","ruby":[[4,2,"あくにん"],[12,1,"かなら"],[14,1,"し"],[18,1,"い"],[27,1,"かれ"],[29,1,"いのち"],[31,1,"すく"],[36,1,"かれ"],[38,1,"いまし"],[44,2,"あくにん"],[47,1,"いまし"],[53,1,"わる"],[55,1,"みち"],[58,1,"はな"],[64,1,"かた"],[73,2,"あくにん"],[76,2,"じぶん"],[79,1,"あく"],[84,1,"し"],[92,1,"ち"],[102,1,"て"],[105,1,"もと"]],"text":"わたしが悪人に『あなたは必ず死ぬ』と言うとき、あなたは彼の命を救うために彼を戒めず、また悪人を戒めて、その悪い道から離れるように語らないなら、その悪人は自分の悪のために死ぬ。しかしその血をわたしはあなたの手から求める。"},{"ref":"Ezek.3.19","start":26003019,"end":26003019,"break":"none","ruby":[[10,2,"あくにん"],[13,1,"いまし"],[18,1,"かれ"],[22,1,"あく"],[30,1,"わる"],[32,1,"みち"],[35,1,"はな"],[42,1,"かれ"],[46,1,"あく"],[51,1,"し"],[61,2,"じぶん"],[64,1,"いのち"],[66,1,"すく"]],"text":"しかし、もしあなたが悪人を戒めても、彼がその悪をも、またその悪い道をも離れないなら、彼はその悪のために死ぬ。しかしあなたは自分の命を救う。"},{"ref":"Ezek.3.20","start":26003020,"end":26003020,"break":"none","ruby":[[2,2,"ぎじん"],[7,1,"ぎ"],[13,2,"ふぎ"],[16,1,"おこな"],[25,1,"かれ"],[27,1,"まえ"],[35,1,"お"],[38,1,"かれ"],[40,1,"し"],[47,1,"かれ"],[49,1,"いまし"],[58,1,"かれ"],[62,1,"つみ"],[67,1,"し"],[72,1,"おこな"],[75,1,"ぎ"],[77,1,"おぼ"],[89,1,"ち"],[99,1,"て"],[102,1,"もと"]],"text":"また義人がその義にそむき、不義を行うなら、わたしは彼の前に、つまずきを置き、彼は死ぬ。あなたが彼を戒めなかったゆえ、彼はその罪のために死に、その行った義は覚えられない。しかしその血をわたしはあなたの手から求める。"},{"ref":"Ezek.3.21","start":26003021,"end":26003021,"break":"none","ruby":[[11,2,"ぎじん"],[14,1,"いまし"],[18,1,"つみ"],[20,1,"おか"],[27,1,"かた"],[33,1,"かれ"],[35,1,"つみ"],[37,1,"おか"],[44,1,"かれ"],[46,1,"いまし"],[49,1,"う"],[60,1,"いのち"],[62,1,"たも"],[69,2,"じぶん"],[72,1,"いのち"],[74,1,"すく"]],"text":"けれども、もしあなたが義人を戒めて、罪を犯さないように語り、そして彼が罪を犯さないなら、彼は戒めを受けいれたゆえに、その命を保ち、あなたは自分の命を救う」。"},{"ref":"Ezek.3.22","start":26003022,"end":26003022,"break":"paragraph","ruby":[[2,1,"ところ"],[4,1,"しゅ"],[6,1,"て"],[12,1,"うえ"],[14,1,"のぞ"],[17,1,"かれ"],[23,1,"い"],[29,1,"た"],[33,2,"へいや"],[36,1,"で"],[38,1,"い"],[46,1,"ところ"],[56,1,"かた"]],"text":"その所で主の手がわたしの上に臨み、彼はわたしに言われた、「立って、平野に出て行きなさい。その所でわたしはあなたに語ろう」。"},{"ref":"Ezek.3.23","start":26003023,"end":26003023,"break":"none","ruby":[[8,1,"た"],[11,2,"へいや"],[14,1,"で"],[16,1,"い"],[20,1,"み"],[23,1,"しゅ"],[25,2,"えいこう"],[39,1,"がわ"],[45,1,"み"],[47,2,"えいこう"],[56,1,"ところ"],[58,1,"た"],[60,1,"あらわ"],[72,1,"ふ"]],"text":"そこで、わたしは立って平野に出て行った。見よ、主の栄光が、かつてわたしがケバル川のほとりで見た栄光のように、その所に立ち現れたので、わたしはひれ伏した。"},{"ref":"Ezek.3.24","start":26003024,"end":26003024,"break":"none","ruby":[[3,1,"れい"],[21,1,"た"],[32,1,"かた"],[35,1,"い"],[40,1,"い"],[48,1,"いえ"]],"text":"しかし霊がわたしのうちにはいって、わたしを立ちあがらせ、わたしに語って言った、「行って、あなたの家にこもっていなさい。"},{"ref":"Ezek.3.25","start":26003025,"end":26003025,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[5,1,"み"],[8,1,"かれ"],[15,1,"うえ"],[30,1,"しば"],[37,1,"たみ"],[39,1,"なか"],[41,1,"い"]],"text":"人の子よ、見よ、彼らはあなたの上になわをかけ、それであなたを縛り、あなたを民の中に行かせないようにする。"},{"ref":"Ezek.3.26","start":26003026,"end":26003026,"break":"none","ruby":[[8,1,"した"],[10,1,"うえ"],[28,1,"かれ"],[31,1,"いまし"],[47,1,"かれ"],[50,2,"はんぎゃく"],[53,1,"いえ"]],"text":"わたしはあなたの舌を上あごにつかせ、あなたをおしにして、彼らを戒めることができないようにする。彼らは反逆の家だからである。"},{"ref":"Ezek.3.27","start":26003027,"end":26003027,"break":"none","ruby":[[12,1,"かた"],[22,1,"くち"],[24,1,"ひら"],[31,1,"かれ"],[35,1,"しゅ"],[38,1,"かみ"],[42,1,"い"],[48,1,"い"],[59,1,"き"],[61,1,"もの"],[63,1,"き"],[69,1,"こば"],[71,1,"もの"],[73,1,"こば"],[79,1,"かれ"],[82,2,"はんぎゃく"],[85,1,"いえ"]],"text":"しかし、わたしがあなたと語るときは、あなたの口を開く。あなたは彼らに『主なる神はこう言われる』と言わなければならない。聞く者は聞くがよい、拒む者は拒むがよい。彼らは反逆の家だからである。"}]