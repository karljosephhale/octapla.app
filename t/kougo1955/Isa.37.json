[{"ref":"Isa.37.1","start":23037001,"end":23037001,"break":"paragraph","ruby":[[4,1,"おう"],[9,1,"き"],[13,1,"ころも"],[15,1,"さ"],[18,2,"あらぬの"],[21,1,"み"],[27,1,"しゅ"],[29,1,"みや"],[31,1,"い"]],"text":"ヒゼキヤ王はこれを聞いて、衣を裂き、荒布を身にまとって主の宮に入り、"},{"ref":"Isa.37.2","start":23037002,"end":23037002,"break":"none","ruby":[[0,3,"くないきょう"],[9,3,"しょきかん"],[18,2,"さいし"],[24,3,"ねんちょうしゃ"],[30,2,"あらぬの"],[43,1,"こ"],[44,3,"よげんしゃ"]],"text":"宮内卿エリアキムと書記官セブナおよび祭司のうちの年長者たちに荒布をまとわせて、アモツの子預言者イザヤのもとへつかわした。"},{"ref":"Isa.37.3","start":23037003,"end":23037003,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[19,1,"い"],[29,1,"なや"],[32,1,"せ"],[42,1,"ひ"],[46,2,"たいじ"],[52,1,"うま"],[63,1,"う"],[65,1,"だ"],[67,1,"ちから"]],"text":"彼らはイザヤに言った、「ヒゼキヤはこう言います、『きょうは悩みと責めと、はずかしめの日です。胎児がまさに生れようとして、これを産み出す力がないのです。"},{"ref":"Isa.37.4","start":23037004,"end":23037004,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[24,2,"ことば"],[27,1,"き"],[39,1,"かれ"],[43,2,"しゅくん"],[51,1,"おう"],[60,1,"い"],[63,1,"かみ"],[76,1,"かみ"],[78,1,"しゅ"],[82,2,"ことば"],[85,1,"き"],[93,1,"せ"],[113,1,"のこ"],[118,1,"もの"],[123,1,"いのり"]],"text":"あなたの神、主は、あるいはラブシャケのもろもろの言葉を聞かれたかもしれません。彼はその主君アッスリヤの王につかわされて、生ける神をそしりました。あなたの神、主はその言葉を聞いて、あるいは責められるかもしれません。それゆえ、この残っている者のために祈をささげてください』」。"},{"ref":"Isa.37.5","start":23037005,"end":23037005,"break":"paragraph","ruby":[[4,1,"おう"],[6,2,"けらい"],[18,1,"き"]],"text":"ヒゼキヤ王の家来たちがイザヤのもとに来たとき、"},{"ref":"Isa.37.6","start":23037006,"end":23037006,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[18,2,"しゅくん"],[23,1,"い"],[30,1,"しゅ"],[34,1,"おお"],[46,1,"おう"],[62,2,"ことば"],[65,1,"き"],[68,1,"おそ"],[73,1,"およ"]],"text":"イザヤは彼らに言った、「あなたがたの主君にこう言いなさい、『主はこう仰せられる、アッスリヤの王のしもべらが、わたしをそしった言葉を聞いて恐れるには及ばない。"},{"ref":"Isa.37.7","start":23037007,"end":23037007,"break":"none","ruby":[[0,1,"み"],[10,1,"れい"],[12,1,"かれ"],[17,1,"おく"],[28,1,"き"],[32,1,"かれ"],[34,2,"じぶん"],[37,1,"くに"],[39,1,"かえ"],[46,1,"くに"],[52,1,"たお"]],"text":"見よ、わたしは一つの霊を彼のうちに送って、一つのうわさを聞かせ、彼を自分の国へ帰らせて、その国でつるぎに倒れさせる』」。"},{"ref":"Isa.37.8","start":23037008,"end":23037008,"break":"paragraph","ruby":[[6,1,"ひ"],[8,1,"かえ"],[18,1,"おう"],[24,1,"せ"],[33,1,"い"],[37,1,"かれ"],[39,1,"おう"],[45,1,"さ"],[51,1,"き"]],"text":"ラブシャケは引き返して、アッスリヤの王がリブナを攻めているところへ行った。彼は王がラキシを去ったことを聞いたからである。"},{"ref":"Isa.37.9","start":23037009,"end":23037009,"break":"none","ruby":[[2,1,"とき"],[10,1,"おう"],[18,1,"おう"],[29,1,"かれ"],[35,1,"たたか"],[40,1,"で"],[46,2,"ひとびと"],[49,1,"い"],[53,1,"き"],[57,1,"かれ"],[64,1,"き"],[68,2,"ししゃ"],[84,1,"い"]],"text":"この時、アッスリヤの王はエチオピヤの王テルハカについて、「彼はあなたと戦うために出てきた」と人々が言うのを聞いた。彼はこのことを聞いて、使者をヒゼキヤにつかわそうとして言った、"},{"ref":"Isa.37.10","start":23037010,"end":23037010,"break":"none","ruby":[[4,1,"おう"],[12,1,"い"],[36,1,"おう"],[38,1,"て"],[40,1,"おちい"],[49,1,"い"],[55,2,"しんらい"],[59,1,"かみ"],[61,1,"あざむ"]],"text":"「ユダの王ヒゼキヤにこう言いなさい、『あなたは、エルサレムはアッスリヤの王の手に陥ることはない、と言うあなたの信頼する神に欺かれてはならない。"},{"ref":"Isa.37.11","start":23037011,"end":23037011,"break":"none","ruby":[[10,1,"おう"],[15,2,"くにぐに"],[23,1,"かれ"],[26,1,"まった"],[28,1,"ほろ"],[35,1,"き"],[49,1,"すく"]],"text":"あなたはアッスリヤの王たちが、国々にしたこと、彼らを全く滅ぼしたことを聞いている。どうしてあなたは救われることができようか。"},{"ref":"Isa.37.12","start":23037012,"end":23037012,"break":"none","ruby":[[4,2,"せんぞ"],[34,2,"ひとびと"],[37,1,"ほろ"],[45,2,"くにぐに"],[48,2,"かみがみ"],[51,1,"かれ"],[54,1,"すく"]],"text":"わたしの先祖たちはゴザン、ハラン、レゼフおよびテラサルにいたエデンの人々を滅ぼしたが、その国々の神々は彼らを救ったか。"},{"ref":"Isa.37.13","start":23037013,"end":23037013,"break":"none","ruby":[[4,1,"おう"],[11,1,"おう"],[20,1,"まち"],[22,1,"おう"],[27,1,"おう"],[34,1,"おう"]],"text":"ハマテの王、アルパデの王、セパルワイムの町の王、ヘナの王およびイワの王はどこにいるか』」。"},{"ref":"Isa.37.14","start":23037014,"end":23037014,"break":"paragraph","ruby":[[5,2,"ししゃ"],[8,1,"て"],[11,2,"てがみ"],[14,1,"う"],[16,1,"と"],[22,1,"よ"],[25,1,"しゅ"],[27,1,"みや"],[37,1,"しゅ"],[39,1,"まえ"]],"text":"ヒゼキヤは使者の手から手紙を受け取ってそれを読み、主の宮にのぼっていって、主の前にそれをひろげ、"},{"ref":"Isa.37.15","start":23037015,"end":23037015,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"いの"],[5,1,"い"]],"text":"主に祈って言った、"},{"ref":"Isa.37.16","start":23037016,"end":23037016,"break":"none","ruby":[[6,1,"うえ"],[8,1,"ざ"],[21,1,"かみ"],[23,2,"ばんぐん"],[26,1,"しゅ"],[29,1,"ち"],[35,1,"くに"],[49,1,"かみ"],[63,1,"てん"],[65,1,"ち"],[67,1,"つく"]],"text":"「ケルビムの上に座しておられるイスラエルの神、万軍の主よ、地のすべての国のうちで、ただあなただけが神でいらせられます。あなたは天と地を造られました。"},{"ref":"Isa.37.17","start":23037017,"end":23037017,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"みみ"],[5,1,"かたむ"],[8,1,"き"],[16,1,"しゅ"],[19,1,"め"],[21,1,"ひら"],[24,1,"み"],[37,1,"い"],[40,1,"かみ"],[48,1,"か"],[50,1,"おく"],[53,2,"ことば"],[56,1,"き"]],"text":"主よ、耳を傾けて聞いてください。主よ、目を開いて見てください。セナケリブが生ける神をそしるために書き送った言葉を聞いてください。"},{"ref":"Isa.37.18","start":23037018,"end":23037018,"break":"none","ruby":[[0,1,"しゅ"],[13,1,"おう"],[23,1,"たみ"],[27,2,"くにぐに"],[30,1,"ほろ"]],"text":"主よ、まことにアッスリヤの王たちは、もろもろの民とその国々を滅ぼし、"},{"ref":"Isa.37.19","start":23037019,"end":23037019,"break":"none","ruby":[[4,2,"かみがみ"],[7,1,"ひ"],[9,1,"な"],[11,1,"い"],[21,1,"かみ"],[27,1,"ひと"],[29,1,"て"],[31,1,"つく"],[38,1,"き"],[40,1,"いし"],[44,1,"ほろ"]],"text":"またその神々を火に投げ入れました。それらは神ではなく、人の手の造ったもので、木や石だから滅ぼされたのです。"},{"ref":"Isa.37.20","start":23037020,"end":23037020,"break":"none","ruby":[[0,1,"いま"],[6,1,"かみ"],[8,1,"しゅ"],[20,1,"かれ"],[22,1,"て"],[25,1,"すく"],[27,1,"だ"],[40,1,"ち"],[42,2,"くにぐに"],[45,1,"みな"],[52,1,"しゅ"],[63,1,"し"]],"text":"今われわれの神、主よ、どうぞ、われわれを彼の手から救い出してください。そうすれば地の国々は皆あなただけが主でいらせられることを知るようになるでしょう」。"},{"ref":"Isa.37.21","start":23037021,"end":23037021,"break":"paragraph","ruby":[[2,1,"とき"],[7,1,"こ"],[12,1,"ひと"],[24,1,"い"],[35,1,"かみ"],[37,1,"しゅ"],[41,1,"い"],[56,1,"おう"],[70,1,"いの"]],"text":"その時アモツの子イザヤは人をつかわしてヒゼキヤに言った、「イスラエルの神、主はこう言われる、あなたはアッスリヤの王セナケリブについてわたしに祈ったゆえ、"},{"ref":"Isa.37.22","start":23037022,"end":23037022,"break":"none","breaks":[[20,"stanza"],[32,"line"],[48,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[7,1,"かた"],[11,2,"ことば"],[21,2,"しょじょ"],[30,1,"むすめ"],[36,1,"あなど"],[54,1,"むすめ"],[65,1,"あたま"],[67,1,"ふ"]],"text":"主が彼について語られた言葉はこうである、『処女であるシオンの娘はあなたを侮り、あなたをあざける。エルサレムの娘は、あなたのうしろで頭を振る。"},{"ref":"Isa.37.23","start":23037023,"end":23037023,"break":"line","breaks":[[22,"line"],[38,"line"],[48,"line"]],"ruby":[[33,1,"こえ"],[38,1,"め"],[40,1,"たか"],[54,2,"せいじゃ"]],"text":"あなたはだれをそしり、だれをののしったのか。あなたはだれにむかって声をあげ、目を高くあげたのか。イスラエルの聖者にむかってだ。"},{"ref":"Isa.37.24","start":23037024,"end":23037024,"break":"line","breaks":[[15,"line"],[25,"line"],[48,"line"],[58,"line"],[81,"line"]],"ruby":[[15,1,"しゅ"],[21,1,"い"],[30,1,"おお"],[33,2,"せんしゃ"],[36,1,"ひき"],[39,2,"やまやま"],[42,1,"いただき"],[53,1,"おく"],[55,1,"い"],[61,1,"たか"],[63,2,"こうはく"],[67,1,"もっと"],[69,1,"よ"],[76,1,"き"],[78,1,"たお"],[85,1,"はて"],[87,2,"こうち"],[90,1,"い"],[95,2,"みつりん"]],"text":"あなたは、そのしもべらによって主をそしって言った、「わたしは多くの戦車を率いて山々の頂にのぼり、レバノンの奥へ行き、たけの高い香柏と、最も良いいとすぎを切り倒し、またその果の高地へ行き、その密林にはいった。"},{"ref":"Isa.37.25","start":23037025,"end":23037025,"break":"line","breaks":[[16,"line"],[24,"line"]],"ruby":[[4,2,"いど"],[7,1,"ほ"],[10,1,"みず"],[12,1,"の"],[20,1,"あし"],[22,1,"うら"],[33,1,"かわ"],[35,1,"ふ"]],"text":"わたしは井戸を掘って水を飲んだ。わたしは足の裏でエジプトのすべての川を踏みからした」。"},{"ref":"Isa.37.26","start":23037026,"end":23037026,"break":"line","breaks":[[12,"line"],[27,"line"],[34,"line"],[51,"line"],[68,"line"]],"ruby":[[4,1,"き"],[12,1,"むかし"],[20,1,"さだ"],[27,2,"けんご"],[30,2,"まちまち"],[42,2,"あらつか"],[56,1,"ひ"],[64,2,"けいかく"],[68,1,"いま"]],"text":"あなたは聞かなかったか、昔わたしがそれを定めたことを。堅固な町々を、あなたがこわして荒塚とすることも、いにしえの日から、わたしが計画して今それをきたらせたのだ。"},{"ref":"Isa.37.27","start":23037027,"end":23037027,"break":"line","breaks":[[13,"line"],[24,"line"],[41,"line"]],"ruby":[[5,1,"す"],[7,1,"たみ"],[9,1,"ちから"],[10,1,"よわ"],[17,1,"はじ"],[24,1,"の"],[26,1,"くさ"],[32,2,"あおな"],[41,1,"そだ"],[45,1,"か"],[48,2,"やね"],[51,1,"くさ"]],"text":"そのうちに住む民は力弱く、おののき恥をいだいて、野の草のように、青菜のようになり、育たずに枯れる屋根の草のようになった。"},{"ref":"Isa.37.28","start":23037028,"end":23037028,"break":"line","breaks":[[23,"line"],[34,"line"]],"ruby":[[9,1,"ざ"],[15,2,"でい"],[34,1,"いか"],[36,1,"さけ"],[43,1,"し"]],"text":"わたしは、あなたの座すること、出入りすること、また、わたしにむかって怒り叫んだことをも知っている。"},{"ref":"Isa.37.29","start":23037029,"end":23037029,"break":"line","breaks":[[22,"line"],[46,"line"],[62,"line"],[76,"line"]],"ruby":[[13,1,"いか"],[15,1,"さけ"],[26,2,"こうまん"],[29,2,"ことば"],[37,1,"みみ"],[55,1,"はな"],[57,1,"わ"],[66,1,"くち"],[83,1,"き"],[85,1,"みち"],[87,1,"ひ"]],"text":"あなたが、わたしにむかって怒り叫んだことと、あなたの高慢な言葉とがわたしの耳にはいったゆえ、わたしは、あなたの鼻に輪をつけ、あなたの口にくつわをはめて、あなたを、もと来た道へ引きもどす』。"},{"ref":"Isa.37.30","start":23037030,"end":23037030,"break":"paragraph","ruby":[[4,1,"あた"],[26,1,"お"],[28,1,"ぼ"],[31,1,"は"],[34,1,"もの"],[36,1,"た"],[40,1,"ねん"],[41,1,"め"],[49,1,"お"],[51,1,"ぼ"],[54,1,"は"],[57,1,"もの"],[59,1,"た"],[63,1,"ねん"],[64,1,"め"],[67,1,"たね"],[72,1,"か"],[74,1,"い"],[80,1,"はたけ"],[82,1,"つく"],[87,1,"み"],[89,1,"た"]],"text":"あなたに与えるしるしはこれである。すなわち、ことしは落ち穂から生えた物を食べ、二年目には、またその落ち穂から生えた物を食べ、三年目には種をまき、刈り入れ、ぶどう畑を作ってその実を食べる。"},{"ref":"Isa.37.31","start":23037031,"end":23037031,"break":"none","ruby":[[3,1,"いえ"],[10,1,"のこ"],[12,1,"もの"],[14,1,"ふたた"],[16,1,"した"],[18,1,"ね"],[20,1,"は"],[23,1,"うえ"],[25,1,"み"],[27,1,"むす"]],"text":"ユダの家の、のがれて残る者は再び下に根を張り、上に実を結ぶ。"},{"ref":"Isa.37.32","start":23037032,"end":23037032,"break":"none","ruby":[[4,1,"のこ"],[6,1,"もの"],[15,1,"で"],[21,1,"もの"],[27,1,"やま"],[30,1,"で"],[33,2,"ばんぐん"],[36,1,"しゅ"],[38,2,"ねっしん"],[46,1,"と"]],"text":"すなわち残る者はエルサレムから出、のがれる物はシオンの山から出る。万軍の主の熱心がこれをなし遂げられる。"},{"ref":"Isa.37.33","start":23037033,"end":23037033,"break":"paragraph","ruby":[[5,1,"しゅ"],[13,1,"おう"],[21,1,"おお"],[28,1,"かれ"],[32,1,"まち"],[43,1,"や"],[45,1,"はな"],[52,1,"たて"],[60,1,"まえ"],[68,1,"るい"],[70,1,"きず"],[77,1,"せ"]],"text":"それゆえ、主はアッスリヤの王について、こう仰せられる、『彼はこの町にこない。またここに矢を放たない。また盾をもって、その前にこない。また塁を築いて、これを攻めることはない。"},{"ref":"Isa.37.34","start":23037034,"end":23037034,"break":"none","ruby":[[0,1,"かれ"],[2,1,"き"],[4,1,"みち"],[7,1,"かえ"],[13,1,"まち"],[26,1,"しゅ"],[28,1,"い"]],"text":"彼は来た道から帰って、この町に、はいることはない、と主は言う。"},{"ref":"Isa.37.35","start":23037035,"end":23037035,"break":"none","ruby":[[4,2,"じぶん"],[27,1,"まち"],[29,1,"まも"],[36,1,"すく"]],"text":"わたしは自分のため、また、わたしのしもべダビデのために町を守って、これを救おう』」。"},{"ref":"Isa.37.36","start":23037036,"end":23037036,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,1,"で"],[15,2,"じんえい"],[23,1,"にん"],[25,1,"う"],[27,1,"ころ"],[31,2,"ひとびと"],[34,1,"あさ"],[35,1,"はや"],[37,1,"お"],[40,1,"み"],[44,1,"かれ"],[47,1,"みな"],[48,2,"したい"]],"text":"主の使が出て、アッスリヤびとの陣営で十八万五千人を撃ち殺した。人々が朝早く起きて見ると、彼らは皆死体となっていた。"},{"ref":"Isa.37.37","start":23037037,"end":23037037,"break":"none","ruby":[[6,1,"おう"],[13,1,"た"],[15,1,"さ"],[18,1,"かえ"]],"text":"アッスリヤの王セナケリブは立ち去り、帰っていってニネベにいたが、"},{"ref":"Isa.37.38","start":23037038,"end":23037038,"break":"none","ruby":[[2,1,"かみ"],[8,2,"しんでん"],[11,2,"れいはい"],[17,1,"とき"],[21,1,"こ"],[46,1,"かれ"],[48,1,"ころ"],[59,1,"ち"],[61,1,"に"],[74,1,"こ"],[82,1,"かわ"],[85,1,"おう"]],"text":"その神ニスロクの神殿で礼拝していた時、その子らのアデラン・メレクとシャレゼルがつるぎをもって彼を殺し、ともにアララテの地へ逃げていった。それで、その子エサルハドンが代って王となった。"}]