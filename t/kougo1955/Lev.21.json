[{"ref":"Lev.21.1","start":3021001,"end":3021001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[18,1,"こ"],[21,2,"さいし"],[26,1,"つ"],[29,1,"い"],[36,1,"たみ"],[41,2,"しにん"],[48,1,"み"],[50,1,"けが"],[52,1,"もの"]],"text":"主はまたモーセに言われた、「アロンの子なる祭司たちに告げて言いなさい、『民のうちの死人のために、身を汚す者があってはならない。"},{"ref":"Lev.21.2","start":3021002,"end":3021002,"break":"none","ruby":[[4,2,"きんしん"],[7,1,"もの"],[14,1,"ちち"],[16,1,"はは"],[22,1,"むすめ"],[24,2,"きょうだい"]],"text":"ただし、近親の者、すなわち、父、母、むすこ、娘、兄弟のため、"},{"ref":"Lev.21.3","start":3021003,"end":3021003,"break":"none","ruby":[[2,1,"かれ"],[4,2,"きんしん"],[10,1,"おっと"],[14,2,"しょじょ"],[18,2,"しまい"],[28,1,"み"],[30,1,"けが"]],"text":"また彼の近親で、まだ夫のない処女なる姉妹のためには、その身を汚してもよい。"},{"ref":"Lev.21.4","start":3021004,"end":3021004,"break":"none","ruby":[[4,1,"おっと"],[10,2,"しまい"],[18,1,"み"],[20,1,"けが"]],"text":"しかし、夫にとついだ姉妹のためには、身を汚してはならない。"},{"ref":"Lev.21.5","start":3021005,"end":3021005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"あたま"],[5,1,"いただき"],[19,2,"りょうたん"],[24,1,"おと"],[35,1,"み"],[37,1,"きず"]],"text":"彼らは頭の頂をそってはならない。ひげの両端をそり落してはならない。また身に傷をつけてはならない。"},{"ref":"Lev.21.6","start":3021006,"end":3021006,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,1,"たい"],[8,1,"せい"],[21,1,"かみ"],[23,1,"な"],[25,1,"けが"],[34,1,"かれ"],[37,1,"しゅ"],[39,2,"かさい"],[47,1,"かみ"],[49,2,"しょくもつ"],[56,1,"もの"],[63,1,"せい"]],"text":"彼らは神に対して聖でなければならない。また神の名を汚してはならない。彼らは主の火祭、すなわち、神の食物をささげる者であるから、聖でなければならない。"},{"ref":"Lev.21.7","start":3021007,"end":3021007,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ゆうじょ"],[6,1,"けが"],[9,1,"おんな"],[23,1,"おっと"],[25,1,"だ"],[29,1,"おんな"],[41,2,"さいし"],[44,1,"かみ"],[46,1,"たい"],[49,1,"せい"],[52,1,"もの"]],"text":"彼らは遊女や汚れた女をめとってはならない。また夫に出された女をめとってはならない。祭司は神に対して聖なる者だからである。"},{"ref":"Lev.21.8","start":3021008,"end":3021008,"break":"none","ruby":[[4,1,"かれ"],[6,1,"せい"],[18,1,"かれ"],[24,1,"かみ"],[26,2,"しょくもつ"],[33,1,"もの"],[41,1,"かれ"],[50,1,"せい"],[53,1,"もの"],[70,1,"せい"],[74,1,"しゅ"],[85,1,"せい"],[88,1,"もの"]],"text":"あなたは彼を聖としなければならない。彼はあなたの神の食物をささげる者だからである。彼はあなたにとって聖なる者でなければならない。あなたがたを聖とする主、すなわち、わたしは聖なる者だからである。"},{"ref":"Lev.21.9","start":3021009,"end":3021009,"break":"none","ruby":[[0,2,"さいし"],[3,1,"むすめ"],[7,1,"もの"],[10,2,"いんこう"],[19,1,"み"],[21,1,"けが"],[29,1,"ちち"],[31,1,"けが"],[40,2,"かのじょ"],[43,1,"ひ"],[45,1,"や"]],"text":"祭司の娘である者が、淫行をなして、その身を汚すならば、その父を汚すのであるから、彼女を火で焼かなければならない。"},{"ref":"Lev.21.10","start":3021010,"end":3021010,"break":"paragraph","ruby":[[2,2,"きょうだい"],[8,1,"あたま"],[10,1,"そそ"],[12,1,"あぶら"],[14,1,"そそ"],[18,1,"しょく"],[20,1,"にん"],[28,2,"いふく"],[34,1,"だい"],[35,2,"さいし"],[41,1,"もの"],[46,1,"かみ"],[48,1,"け"],[50,1,"みだ"],[63,2,"いふく"],[66,1,"さ"]],"text":"その兄弟のうち、頭に注ぎ油を注がれ、職に任ぜられて、その衣服をつけ、大祭司となった者は、その髪の毛を乱してはならない。またその衣服を裂いてはならない。"},{"ref":"Lev.21.11","start":3021011,"end":3021011,"break":"none","ruby":[[0,2,"しにん"],[20,1,"ちち"],[26,1,"はは"],[32,1,"み"],[34,1,"けが"]],"text":"死人のところに、はいってはならない。また父のためにも母のためにも身を汚してはならない。"},{"ref":"Lev.21.12","start":3021012,"end":3021012,"break":"none","ruby":[[2,2,"せいじょ"],[6,1,"で"],[14,1,"かみ"],[16,2,"せいじょ"],[19,1,"けが"],[30,1,"かみ"],[32,1,"そそ"],[34,1,"あぶら"],[38,2,"せいべつ"],[42,1,"かれ"],[44,1,"うえ"],[58,1,"しゅ"]],"text":"また聖所から出てはならない。神の聖所を汚してはならない。その神の注ぎ油による聖別が、彼の上にあるからである。わたしは主である。"},{"ref":"Lev.21.13","start":3021013,"end":3021013,"break":"none","ruby":[[0,1,"かれ"],[2,2,"しょじょ"],[5,1,"つま"]],"text":"彼は処女を妻にめとらなければならない。"},{"ref":"Lev.21.14","start":3021014,"end":3021014,"break":"none","ruby":[[0,2,"かふ"],[3,1,"だ"],[7,1,"おんな"],[9,1,"けが"],[12,1,"おんな"],[14,2,"ゆうじょ"],[32,2,"じぶん"],[35,1,"たみ"],[40,2,"しょじょ"],[44,1,"つま"]],"text":"寡婦、出された女、汚れた女、遊女などをめとってはならない。ただ、自分の民のうちの処女を、妻にめとらなければならない。"},{"ref":"Lev.21.15","start":3021015,"end":3021015,"break":"none","ruby":[[6,1,"かれ"],[8,1,"たみ"],[14,2,"じぶん"],[17,2,"しそん"],[20,1,"けが"],[32,1,"かれ"],[34,2,"せいべつ"],[38,1,"しゅ"]],"text":"そうすれば、彼は民のうちに、自分の子孫を汚すことはない。わたしは彼を聖別する主だからである』」。"},{"ref":"Lev.21.16","start":3021016,"end":3021016,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.21.17","start":3021017,"end":3021017,"break":"none","ruby":[[5,1,"つ"],[8,1,"い"],[19,2,"よよ"],[22,2,"しそん"],[30,1,"み"],[37,1,"もの"],[39,2,"ちかよ"],[44,1,"かみ"],[46,2,"しょくもつ"]],"text":"「アロンに告げて言いなさい、『あなたの代々の子孫で、だれでも身にきずのある者は近寄って、神の食物をささげてはならない。"},{"ref":"Lev.21.18","start":3021018,"end":3021018,"break":"none","ruby":[[6,1,"み"],[13,1,"もの"],[15,2,"ちかよ"],[30,1,"め"],[34,1,"あし"],[38,1,"はな"],[43,1,"もの"],[45,2,"てあし"],[48,1,"ふ"],[54,1,"もの"]],"text":"すべて、その身にきずのある者は近寄ってはならない。すなわち、目しい、足なえ、鼻のかけた者、手足の不つりあいの者、"},{"ref":"Lev.21.19","start":3021019,"end":3021019,"break":"none","ruby":[[0,1,"あし"],[2,1,"お"],[5,1,"もの"],[7,1,"て"],[9,1,"お"],[12,1,"もの"]],"text":"足の折れた者、手の折れた者、"},{"ref":"Lev.21.20","start":3021020,"end":3021020,"break":"none","ruby":[[8,1,"め"],[15,1,"もの"],[22,1,"もの"],[31,1,"もの"],[42,1,"もの"]],"text":"せむし、こびと、目にきずのある者、かいせんの者、かさぶたのある者、こうがんのつぶれた者などである。"},{"ref":"Lev.21.21","start":3021021,"end":3021021,"break":"none","ruby":[[3,2,"さいし"],[9,2,"しそん"],[15,1,"み"],[22,1,"もの"],[24,2,"ちかよ"],[29,1,"しゅ"],[31,2,"かさい"],[44,1,"かれ"],[46,1,"み"],[56,1,"かみ"],[58,2,"しょくもつ"],[69,2,"ちかよ"]],"text":"すべて祭司アロンの子孫のうち、身にきずのある者は近寄って、主の火祭をささげてはならない。彼は身にきずがあるから、神の食物をささげるために、近寄ってはならない。"},{"ref":"Lev.21.22","start":3021022,"end":3021022,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かみ"],[4,2,"しょくもつ"],[7,1,"せい"],[10,1,"もの"],[13,1,"もっと"],[15,1,"せい"],[18,1,"もの"],[20,1,"た"]],"text":"彼は神の食物の聖なる物も、最も聖なる物も食べることができる。"},{"ref":"Lev.21.23","start":3021023,"end":3021023,"break":"none","ruby":[[4,2,"たれまく"],[7,1,"ちか"],[19,2,"さいだん"],[22,2,"ちかよ"],[32,1,"み"],[45,1,"かれ"],[51,2,"せいじょ"],[54,1,"けが"],[70,2,"せいべつ"],[74,1,"しゅ"]],"text":"ただし、垂幕に近づいてはならない。また祭壇に近寄ってはならない。身にきずがあるからである。彼はわたしの聖所を汚してはならない。わたしはそれを聖別する主である』」。"},{"ref":"Lev.21.24","start":3021024,"end":3021024,"break":"none","ruby":[[13,1,"こ"],[15,1,"およ"],[27,2,"ひとびと"],[30,1,"つ"]],"text":"モーセはこれをアロンとその子ら及びイスラエルのすべての人々に告げた。"}]