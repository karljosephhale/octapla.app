[{"ref":"2Tim.1.1","start":55001001,"end":55001001,"break":"paragraph","ruby":[[0,1,"かみ"],[2,2,"みむね"],[23,2,"やくそく"],[29,1,"た"],[43,2,"しと"]],"text":"神の御旨により、キリスト・イエスにあるいのちの約束によって立てられたキリスト・イエスの使徒パウロから、"},{"ref":"2Tim.1.2","start":55001002,"end":55001002,"break":"none","breaks":[[9,"paragraph"]],"ruby":[[0,1,"あい"],[3,1,"こ"],[9,1,"ちち"],[12,1,"かみ"],[20,1,"しゅ"],[32,1,"めぐ"],[40,2,"へいあん"]],"text":"愛する子テモテへ。父なる神とわたしたちの主キリスト・イエスから、恵みとあわれみと平安とが、あなたにあるように。"},{"ref":"2Tim.1.3","start":55001003,"end":55001003,"break":"paragraph","ruby":[[5,2,"にちや"],[8,1,"いのり"],[10,1,"なか"],[13,1,"た"],[23,1,"おも"],[25,1,"だ"],[33,2,"りょうしん"],[39,2,"せんぞ"],[41,2,"いらい"],[49,1,"かみ"],[51,2,"かんしゃ"]],"text":"わたしは、日夜、祈の中で、絶えずあなたのことを思い出しては、きよい良心をもって先祖以来つかえている神に感謝している。"},{"ref":"2Tim.1.4","start":55001004,"end":55001004,"break":"none","ruby":[[9,1,"なみだ"],[22,1,"あ"],[25,1,"よろこ"],[28,1,"み"],[36,1,"せつ"],[38,1,"ねが"]],"text":"わたしは、あなたの涙をおぼえており、あなたに会って喜びで満たされたいと、切に願っている。"},{"ref":"2Tim.1.5","start":55001005,"end":55001005,"break":"none","ruby":[[13,1,"いつわ"],[18,2,"しんこう"],[21,1,"おも"],[23,1,"おこ"],[31,2,"しんこう"],[41,2,"そぼ"],[51,1,"はは"],[57,1,"やど"],[68,1,"いま"],[74,1,"やど"],[85,2,"かくしん"]],"text":"また、あなたがいだいている偽りのない信仰を思い起している。この信仰は、まずあなたの祖母ロイスとあなたの母ユニケとに宿ったものであったが、今あなたにも宿っていると、わたしは確信している。"},{"ref":"2Tim.1.6","start":55001006,"end":55001006,"break":"none","ruby":[[12,2,"ちゅうい"],[22,2,"あんしゅ"],[28,1,"うち"],[35,1,"かみ"],[37,2,"たまもの"],[41,1,"ふたた"],[43,1,"も"]],"text":"こういうわけで、あなたに注意したい。わたしの按手によって内にいただいた神の賜物を、再び燃えたたせなさい。"},{"ref":"2Tim.1.7","start":55001007,"end":55001007,"break":"none","ruby":[[6,1,"かみ"],[14,1,"くだ"],[21,1,"おく"],[24,1,"れい"],[30,1,"ちから"],[32,1,"あい"],[34,1,"つつし"],[38,1,"れい"]],"text":"というのは、神がわたしたちに下さったのは、臆する霊ではなく、力と愛と慎みとの霊なのである。"},{"ref":"2Tim.1.8","start":55001008,"end":55001008,"break":"none","ruby":[[15,1,"しゅ"],[31,1,"しゅ"],[33,2,"しゅうじん"],[42,1,"けっ"],[45,1,"は"],[50,1,"おも"],[63,1,"かみ"],[65,1,"ちから"],[74,2,"ふくいん"],[85,1,"くる"],[89,1,"とも"]],"text":"だから、あなたは、わたしたちの主のあかしをすることや、わたしが主の囚人であることを、決して恥ずかしく思ってはならない。むしろ、神の力にささえられて、福音のために、わたしと苦しみを共にしてほしい。"},{"ref":"2Tim.1.9","start":55001009,"end":55001009,"break":"none","ruby":[[0,1,"かみ"],[8,1,"すく"],[11,1,"せい"],[14,1,"まね"],[20,1,"め"],[23,1,"くだ"],[54,1,"かみ"],[56,2,"じしん"],[59,2,"けいかく"],[62,1,"もとづ"],[68,2,"えいえん"],[71,1,"むかし"],[91,1,"たま"],[97,1,"めぐ"]],"text":"神はわたしたちを救い、聖なる招きをもって召して下さったのであるが、それは、わたしたちのわざによるのではなく、神ご自身の計画に基き、また、永遠の昔にキリスト・イエスにあってわたしたちに賜わっていた恵み、"},{"ref":"2Tim.1.10","start":55001010,"end":55001010,"break":"none","ruby":[[3,1,"いま"],[12,2,"すくいぬし"],[23,2,"しゅつげん"],[29,1,"あき"],[36,1,"めぐ"],[51,1,"し"],[53,1,"ほろ"],[57,2,"ふくいん"],[67,1,"ふ"],[68,1,"し"],[71,1,"あき"],[75,1,"しめ"]],"text":"そして今や、わたしたちの救主キリスト・イエスの出現によって明らかにされた恵みによるのである。キリストは死を滅ぼし、福音によっていのちと不死とを明らかに示されたのである。"},{"ref":"2Tim.1.11","start":55001011,"end":55001011,"break":"none","ruby":[[7,2,"ふくいん"],[13,1,"た"],[21,3,"せんきょうしゃ"],[25,2,"しと"],[28,2,"きょうし"]],"text":"わたしは、この福音のために立てられて、その宣教者、使徒、教師になった。"},{"ref":"2Tim.1.12","start":55001012,"end":55001012,"break":"none","ruby":[[17,1,"くる"],[21,1,"う"],[31,1,"はじ"],[46,2,"じぶん"],[49,1,"しん"],[57,1,"し"],[89,1,"ひ"],[91,1,"いた"],[95,1,"まも"],[98,1,"くだ"],[109,2,"かくしん"]],"text":"そのためにまた、わたしはこのような苦しみを受けているが、それを恥としない。なぜなら、わたしは自分の信じてきたかたを知っており、またそのかたは、わたしにゆだねられているものを、かの日に至るまで守って下さることができると、確信しているからである。"},{"ref":"2Tim.1.13","start":55001013,"end":55001013,"break":"none","ruby":[[14,1,"たい"],[17,2,"しんこう"],[20,1,"あい"],[32,1,"き"],[35,2,"けんぜん"],[38,2,"ことば"],[41,2,"もはん"]],"text":"あなたは、キリスト・イエスに対する信仰と愛とをもって、わたしから聞いた健全な言葉を模範にしなさい。"},{"ref":"2Tim.1.14","start":55001014,"end":55001014,"break":"none","ruby":[[16,1,"たっと"],[28,1,"うち"],[30,1,"やど"],[35,2,"せいれい"],[41,1,"まも"]],"text":"そして、あなたにゆだねられている尊いものを、わたしたちの内に宿っている聖霊によって守りなさい。"},{"ref":"2Tim.1.15","start":55001015,"end":55001015,"break":"paragraph","ruby":[[4,1,"し"],[19,1,"もの"],[24,1,"みな"],[30,1,"はな"],[33,1,"い"],[39,1,"なか"]],"text":"あなたの知っているように、アジヤにいる者たちは、皆わたしから離れて行った。その中には、フゲロとヘルモゲネもいる。"},{"ref":"2Tim.1.16","start":55001016,"end":55001016,"break":"none","ruby":[[4,1,"しゅ"],[13,1,"いえ"],[23,1,"くだ"],[30,1,"かれ"],[41,1,"なぐさ"],[53,1,"くさり"],[55,1,"はじ"],[58,1,"おも"]],"text":"どうか、主が、オネシポロの家にあわれみをたれて下さるように。彼はたびたび、わたしを慰めてくれ、またわたしの鎖を恥とも思わないで、"},{"ref":"2Tim.1.17","start":55001017,"end":55001017,"break":"none","ruby":[[4,1,"つ"],[7,1,"とき"],[11,2,"ねっしん"],[18,1,"さが"],[24,1,"すえ"],[26,1,"たず"],[28,1,"だ"]],"text":"ローマに着いた時には、熱心にわたしを捜しまわった末、尋ね出してくれたのである。"},{"ref":"2Tim.1.18","start":55001018,"end":55001018,"break":"none","ruby":[[4,1,"しゅ"],[8,1,"ひ"],[16,1,"かれ"],[18,1,"たま"],[27,1,"かれ"],[42,1,"つか"],[62,1,"し"]],"text":"どうか、主がかの日に、あわれみを彼に賜わるように。――彼がエペソで、どれほどわたしに仕えてくれたかは、だれよりもあなたがよく知っている。"}]