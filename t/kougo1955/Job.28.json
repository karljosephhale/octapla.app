[{"ref":"Job.28.1","start":18028001,"end":18028001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[6,1,"ほ"],[8,1,"だ"],[10,1,"あな"],[15,2,"せいれん"],[24,1,"で"]],"text":"しろがねには掘り出す穴があり、精錬するこがねには出どころがある。"},{"ref":"Job.28.2","start":18028002,"end":18028002,"break":"line","breaks":[[11,"line"]],"ruby":[[5,1,"つち"],[8,1,"と"],[16,1,"いし"],[19,1,"と"],[23,1,"と"]],"text":"くろがねは土から取り、あかがねは石から溶かして取る。"},{"ref":"Job.28.3","start":18028003,"end":18028003,"break":"line","breaks":[[9,"line"],[23,"line"]],"ruby":[[0,1,"ひと"],[2,1,"くら"],[6,1,"やぶ"],[16,1,"たず"],[23,1,"くら"],[29,2,"あんこく"],[32,1,"なか"],[35,2,"こうせき"],[38,1,"と"]],"text":"人は暗やみを破り、いやはてまでも尋ねきわめて、暗やみおよび暗黒の中から鉱石を取る。"},{"ref":"Job.28.4","start":18028004,"end":18028004,"break":"line","breaks":[[19,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ひと"],[5,1,"す"],[7,1,"ところ"],[9,1,"はな"],[12,2,"たてあな"],[19,2,"みちゆ"],[22,1,"ひと"],[24,1,"わす"],[29,1,"ひと"],[31,1,"はな"],[34,1,"み"],[41,1,"ゆ"],[43,1,"うご"]],"text":"彼らは人の住む所を離れて縦穴をうがち、道行く人に忘れられ、人を離れて身をつりさげ、揺れ動く。"},{"ref":"Job.28.5","start":18028005,"end":18028005,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ち"],[6,2,"しょくもつ"],[9,1,"だ"],[14,1,"した"],[16,1,"ひ"]],"text":"地はそこから食物を出す。その下は火でくつがえされるようにくつがえる。"},{"ref":"Job.28.6","start":18028006,"end":18028006,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"いし"],[12,1,"ところ"],[20,2,"きんかい"]],"text":"その石はサファイヤのある所、そこにはまた金塊がある。"},{"ref":"Job.28.7","start":18028007,"end":18028007,"break":"line","ruby":[[2,1,"みち"],[4,2,"もうきん"],[7,1,"し"],[14,1,"め"],[19,1,"み"]],"text":"その道は猛禽も知らず、たかの目もこれを見ず、"},{"ref":"Job.28.8","start":18028008,"end":18028008,"break":"line","ruby":[[0,2,"もうじゅう"],[6,1,"ふ"],[16,1,"とお"]],"text":"猛獣もこれを踏まず、ししもこれを通らなかった。"},{"ref":"Job.28.9","start":18028009,"end":18028009,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ひと"],[2,1,"かた"],[4,1,"いわ"],[6,1,"て"],[13,1,"やま"],[15,2,"ねもと"]],"text":"人は堅い岩に手をくだして、山を根元からくつがえす。"},{"ref":"Job.28.10","start":18028010,"end":18028010,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"かれ"],[2,1,"いわ"],[4,2,"こうどう"],[7,1,"ほ"],[12,1,"め"],[19,1,"たっと"],[21,1,"もの"],[23,1,"み"]],"text":"彼は岩に坑道を掘り、その目はもろもろの尊い物を見る。"},{"ref":"Job.28.11","start":18028011,"end":18028011,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[2,2,"すいろ"],[10,1,"も"],[19,1,"かく"],[22,1,"もの"],[24,1,"ひかり"],[26,1,"と"],[28,1,"だ"]],"text":"彼は水路をふさいで、漏れないようにし、隠れた物を光に取り出す。"},{"ref":"Job.28.12","start":18028012,"end":18028012,"break":"stanza","breaks":[[17,"line"]],"ruby":[[3,2,"ちえ"],[9,1,"み"],[17,1,"さと"],[22,1,"ところ"]],"text":"しかし知恵はどこに見いだされるか。悟りのある所はどこか。"},{"ref":"Job.28.13","start":18028013,"end":18028013,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ひと"],[5,1,"いた"],[7,1,"みち"],[9,1,"し"],[16,1,"い"],[19,1,"もの"],[21,1,"ち"],[26,1,"え"]],"text":"人はそこに至る道を知らない、また生ける者の地でそれを獲ることができない。"},{"ref":"Job.28.14","start":18028014,"end":18028014,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ふち"],[2,1,"い"],[23,1,"うみ"],[25,1,"い"]],"text":"淵は言う、『それはわたしのうちにない』と。また海は言う、『わたしのもとにない』と。"},{"ref":"Job.28.15","start":18028015,"end":18028015,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"せい"],[1,1,"きん"],[6,1,"か"],[17,1,"ぎん"],[19,1,"はか"],[24,1,"あたい"]],"text":"精金もこれと換えることはできない。銀も量ってその価とすることはできない。"},{"ref":"Job.28.16","start":18028016,"end":18028016,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[4,1,"きん"],[15,1,"あたい"],[17,1,"はか"],[27,1,"たっと"],[29,1,"しま"],[41,2,"どうよう"]],"text":"オフルの金をもってしても、その価を量ることはできない。尊い縞めのうも、サファイヤも同様である。"},{"ref":"Job.28.17","start":18028017,"end":18028017,"break":"line","breaks":[[21,"line"]],"ruby":[[5,2,"はり"],[11,1,"なら"],[23,1,"せい"],[24,1,"きん"],[26,2,"うつわもの"],[32,1,"か"]],"text":"こがねも、玻璃もこれに並ぶことができない。また精金の器物もこれと換えることができない。"},{"ref":"Job.28.18","start":18028018,"end":18028018,"break":"line","breaks":[[15,"line"]],"ruby":[[4,2,"すいしょう"],[7,1,"い"],[10,1,"た"],[15,2,"ちえ"],[18,1,"え"],[22,2,"しんじゅ"],[25,1,"え"]],"text":"さんごも水晶も言うに足りない。知恵を得るのは真珠を得るのにまさる。"},{"ref":"Job.28.19","start":18028019,"end":18028019,"break":"line","breaks":[[23,"line"]],"ruby":[[13,1,"なら"],[23,2,"じゅんきん"],[35,1,"あたい"],[37,1,"はか"]],"text":"エチオピヤのトパズもこれに並ぶことができない。純金をもってしても、その価を量ることはできない。"},{"ref":"Job.28.20","start":18028020,"end":18028020,"break":"line","breaks":[[15,"line"]],"ruby":[[4,2,"ちえ"],[11,1,"く"],[15,1,"さと"],[20,1,"ところ"]],"text":"それでは知恵はどこから来るか。悟りのある所はどこか。"},{"ref":"Job.28.21","start":18028021,"end":18028021,"break":"line","breaks":[[17,"line"]],"ruby":[[7,1,"い"],[9,1,"もの"],[11,1,"め"],[13,1,"かく"],[17,1,"そら"],[19,1,"とり"],[22,1,"かく"]],"text":"これはすべての生き物の目に隠され、空の鳥にも隠されている。"},{"ref":"Job.28.22","start":18028022,"end":18028022,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"ほろ"],[3,1,"し"],[5,1,"い"],[20,1,"みみ"],[22,1,"き"]],"text":"滅びも死も言う、『われわれはそのうわさを耳に聞いただけだ』。"},{"ref":"Job.28.23","start":18028023,"end":18028023,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かみ"],[5,1,"いた"],[7,1,"みち"],[9,1,"さと"],[17,1,"かれ"],[23,1,"ところ"],[25,1,"し"]],"text":"神はこれに至る道を悟っておられる、彼はそのある所を知っておられる。"},{"ref":"Job.28.24","start":18028024,"end":18028024,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ち"],[4,1,"はて"],[14,1,"あめ"],[16,1,"した"],[18,1,"み"]],"text":"彼は地の果までもみそなわし、天が下を見きわめられるからだ。"},{"ref":"Job.28.25","start":18028025,"end":18028025,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"かれ"],[2,1,"かぜ"],[4,1,"おも"],[7,1,"あた"],[10,1,"みず"],[15,1,"はか"]],"text":"彼が風に重さを与え、水をますで量られたとき、"},{"ref":"Job.28.26","start":18028026,"end":18028026,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[2,1,"あめ"],[7,2,"きてい"],[10,1,"もう"],[13,1,"かみなり"],[23,1,"みち"],[25,1,"もう"]],"text":"彼が雨のために規定を設け、雷のひらめきのために道を設けられたとき、"},{"ref":"Job.28.27","start":18028027,"end":18028027,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[2,2,"ちえ"],[5,1,"み"],[19,1,"たし"]],"text":"彼は知恵を見て、これをあらわし、これを確かめ、これをきわめられた。"},{"ref":"Job.28.28","start":18028028,"end":18028028,"break":"line","breaks":[[10,"line"],[28,"line"]],"ruby":[[3,1,"ひと"],[5,1,"い"],[11,1,"み"],[14,1,"しゅ"],[16,1,"おそ"],[22,2,"ちえ"],[28,1,"あく"],[30,1,"はな"],[36,1,"さと"]],"text":"そして人に言われた、『見よ、主を恐れることは知恵である、悪を離れることは悟りである』と」。"}]