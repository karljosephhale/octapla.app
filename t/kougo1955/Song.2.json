[{"ref":"Song.2.1","start":22002001,"end":22002001,"break":"paragraph","breaks":[[12,"line"]],"ruby":[[12,1,"たに"]],"text":"わたしはシャロンのばら、谷のゆりです。"},{"ref":"Song.2.2","start":22002002,"end":22002002,"break":"stanza","breaks":[[21,"line"]],"ruby":[[11,1,"あい"],[14,1,"もの"],[25,1,"なか"],[30,1,"はな"]],"text":"おとめたちのうちにわが愛する者のあるのは、いばらの中にゆりの花があるようだ。"},{"ref":"Song.2.3","start":22002003,"end":22002003,"break":"stanza","breaks":[[19,"line"],[38,"line"],[61,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[7,2,"わこうど"],[12,1,"なか"],[19,1,"はやし"],[21,1,"き"],[23,1,"なか"],[29,1,"き"],[42,1,"おお"],[45,1,"よろこ"],[52,1,"かれ"],[54,1,"かげ"],[61,1,"かれ"],[63,1,"あた"],[66,1,"み"],[72,1,"くち"],[74,1,"あま"]],"text":"わが愛する者の若人たちの中にあるのは、林の木の中にりんごの木があるようです。わたしは大きな喜びをもって、彼の陰にすわった。彼の与える実はわたしの口に甘かった。"},{"ref":"Song.2.4","start":22002004,"end":22002004,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[6,2,"しゅえん"],[9,1,"いえ"],[11,1,"つ"],[14,1,"い"],[22,1,"うえ"],[29,1,"かれ"],[31,1,"はた"],[33,1,"あい"]],"text":"彼はわたしを酒宴の家に連れて行った。わたしの上にひるがえる彼の旗は愛であった。"},{"ref":"Song.2.5","start":22002005,"end":22002005,"break":"line","breaks":[[18,"line"],[41,"line"]],"ruby":[[0,1,"ほし"],[13,1,"ちから"],[30,2,"げんき"],[45,1,"あい"],[50,1,"や"]],"text":"干ぶどうをもって、わたしに力をつけ、りんごをもって、わたしに元気をつけてください。わたしは愛のために病みわずらっているのです。"},{"ref":"Song.2.6","start":22002006,"end":22002006,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"かれ"],[6,1,"ひだり"],[8,1,"て"],[14,1,"あたま"],[16,1,"した"],[21,1,"みぎ"],[23,1,"て"],[29,1,"だ"]],"text":"どうか、彼の左の手がわたしの頭の下にあり、右の手がわたしを抱いてくれるように。"},{"ref":"Song.2.7","start":22002007,"end":22002007,"break":"line","breaks":[[11,"line"],[31,"line"],[46,"line"],[61,"line"],[74,"line"]],"ruby":[[6,1,"むすめ"],[21,1,"の"],[23,1,"め"],[37,1,"ちか"],[41,1,"ねが"],[46,1,"あい"],[53,1,"おこ"],[66,1,"よ"],[68,1,"おこ"]],"text":"エルサレムの娘たちよ、わたしは、かもしかと野の雌じかをさして、あなたがたに誓い、お願いする、愛のおのずから起るときまでは、ことさらに呼び起すことも、さますこともしないように。"},{"ref":"Song.2.8","start":22002008,"end":22002008,"break":"stanza","breaks":[[13,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[7,1,"こえ"],[9,1,"きこ"],[13,1,"み"],[16,1,"かれ"],[18,1,"やま"],[23,1,"おか"],[28,1,"こ"],[31,1,"く"]],"text":"わが愛する者の声が聞える。見よ、彼は山をとび、丘をおどり越えて来る。"},{"ref":"Song.2.9","start":22002009,"end":22002009,"break":"line","breaks":[[16,"line"],[27,"line"],[47,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[16,1,"わか"],[18,1,"お"],[27,1,"み"],[30,1,"かれ"],[38,1,"かべ"],[44,1,"た"],[47,1,"まど"],[54,2,"こうし"]],"text":"わが愛する者はかもしかのごとく、若い雄じかのようです。見よ、彼はわたしたちの壁のうしろに立ち、窓からのぞき、格子からうかがっている。"},{"ref":"Song.2.10","start":22002010,"end":22002010,"break":"line","breaks":[[17,"line"],[34,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[11,1,"かた"],[14,1,"い"],[20,1,"あい"],[23,1,"もの"],[28,1,"うるわ"],[31,1,"もの"],[34,1,"た"],[38,1,"で"]],"text":"わが愛する者はわたしに語って言う、「わが愛する者よ、わが麗しき者よ、立って、出てきなさい。"},{"ref":"Song.2.11","start":22002011,"end":22002011,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"み"],[3,1,"ふゆ"],[5,1,"す"],[8,1,"あめ"],[17,1,"さ"]],"text":"見よ、冬は過ぎ、雨もやんで、すでに去り、"},{"ref":"Song.2.12","start":22002012,"end":22002012,"break":"line","breaks":[[14,"line"],[25,"line"]],"ruby":[[5,1,"はな"],[7,1,"ち"],[14,1,"とり"],[20,1,"とき"],[25,1,"やま"],[29,1,"こえ"],[36,1,"ち"],[38,1,"きこ"]],"text":"もろもろの花は地にあらわれ、鳥のさえずる時がきた。山ばとの声がわれわれの地に聞える。"},{"ref":"Song.2.13","start":22002013,"end":22002013,"break":"line","breaks":[[14,"line"],[37,"line"],[53,"line"]],"ruby":[[5,1,"き"],[9,1,"み"],[11,1,"むす"],[18,1,"き"],[20,1,"はな"],[21,1,"さ"],[34,1,"はな"],[39,1,"あい"],[42,1,"もの"],[47,1,"うるわ"],[50,1,"もの"],[53,1,"た"],[57,1,"で"]],"text":"いちじくの木はその実を結び、ぶどうの木は花咲いて、かんばしいにおいを放つ。わが愛する者よ、わが麗しき者よ、立って、出てきなさい。"},{"ref":"Song.2.14","start":22002014,"end":22002014,"break":"line","breaks":[[21,"line"],[33,"line"],[46,"line"]],"ruby":[[0,1,"いわ"],[2,1,"さ"],[4,1,"め"],[9,1,"かく"],[11,1,"ば"],[25,1,"かお"],[27,1,"み"],[37,1,"こえ"],[39,1,"き"],[50,1,"こえ"],[52,1,"あい"],[61,1,"かお"],[63,1,"うつく"]],"text":"岩の裂け目、がけの隠れ場におるわがはとよ、あなたの顔を見せなさい。あなたの声を聞かせなさい。あなたの声は愛らしく、あなたの顔は美しい。"},{"ref":"Song.2.15","start":22002015,"end":22002015,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[12,1,"とら"],[19,1,"えん"],[21,1,"あら"],[23,1,"こ"],[28,1,"とら"],[40,1,"えん"],[42,2,"はなざか"]],"text":"われわれのためにきつねを捕えよ、ぶどう園を荒す小ぎつねを捕えよ、われわれのぶどう園は花盛りだから」と。"},{"ref":"Song.2.16","start":22002016,"end":22002016,"break":"stanza","breaks":[[23,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[18,1,"かれ"],[23,1,"かれ"],[28,1,"はな"],[30,1,"なか"],[35,1,"む"],[38,1,"やしな"]],"text":"わが愛する者はわたしのもの、わたしは彼のもの。彼はゆりの花の中で、その群れを養っている。"},{"ref":"Song.2.17","start":22002017,"end":22002017,"break":"line","breaks":[[8,"line"],[18,"line"],[38,"line"],[56,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[8,1,"ひ"],[10,1,"すず"],[18,1,"かげ"],[20,1,"き"],[26,1,"み"],[32,1,"で"],[38,1,"けわ"],[41,2,"やまやま"],[44,1,"うえ"],[56,1,"わか"],[58,1,"お"]],"text":"わが愛する者よ、日の涼しくなるまで、影の消えるまで、身をかえして出ていって、険しい山々の上で、かもしかのように、若い雄じかのようになってください。"}]