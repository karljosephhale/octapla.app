[{"ref":"Eph.6.1","start":49006001,"end":49006001,"break":"paragraph","ruby":[[0,1,"こ"],[3,1,"もの"],[6,1,"しゅ"],[11,2,"りょうしん"],[14,1,"したが"],[23,1,"ただ"]],"text":"子たる者よ。主にあって両親に従いなさい。これは正しいことである。"},{"ref":"Eph.6.2","start":49006002,"end":49006002,"break":"none","ruby":[[5,1,"ちち"],[7,1,"はは"],[10,1,"うやま"],[17,1,"だい"],[20,1,"いまし"],[27,1,"つぎ"],[29,2,"やくそく"]],"text":"「あなたの父と母とを敬え」。これが第一の戒めであって、次の約束がそれについている、"},{"ref":"Eph.6.3","start":49006003,"end":49006003,"break":"none","ruby":[[11,2,"こうふく"],[17,2,"ちじょう"],[23,1,"い"]],"text":"「そうすれば、あなたは幸福になり、地上でながく生きながらえるであろう」。"},{"ref":"Eph.6.4","start":49006004,"end":49006004,"break":"none","ruby":[[0,1,"ちち"],[3,1,"もの"],[6,2,"こども"],[17,1,"しゅ"],[19,2,"くんとう"],[22,2,"くんかい"],[30,1,"かれ"],[33,1,"そだ"]],"text":"父たる者よ。子供をおこらせないで、主の薫陶と訓戒とによって、彼らを育てなさい。"},{"ref":"Eph.6.5","start":49006005,"end":49006005,"break":"paragraph","ruby":[[0,1,"しもべ"],[3,1,"もの"],[11,1,"したが"],[17,1,"おそ"],[26,2,"まごころ"],[33,1,"にく"],[37,2,"しゅじん"],[40,1,"したが"]],"text":"僕たる者よ。キリストに従うように、恐れおののきつつ、真心をこめて、肉による主人に従いなさい。"},{"ref":"Eph.6.6","start":49006006,"end":49006006,"break":"none","ruby":[[0,1,"ひと"],[10,2,"めさき"],[15,1,"つと"],[30,1,"しもべ"],[34,1,"こころ"],[37,1,"かみ"],[39,2,"みむね"],[42,1,"おこな"]],"text":"人にへつらおうとして目先だけの勤めをするのでなく、キリストの僕として心から神の御旨を行い、"},{"ref":"Eph.6.7","start":49006007,"end":49006007,"break":"none","ruby":[[0,1,"ひと"],[6,1,"しゅ"],[8,1,"つか"],[15,1,"こころよ"],[17,1,"つか"]],"text":"人にではなく主に仕えるように、快く仕えなさい。"},{"ref":"Eph.6.8","start":49006008,"end":49006008,"break":"none","ruby":[[6,1,"し"],[19,1,"よ"],[24,1,"おこな"],[28,1,"しもべ"],[33,3,"じゆうじん"],[43,2,"そうとう"],[47,1,"むく"],[55,1,"しゅ"],[58,1,"う"]],"text":"あなたがたが知っているとおり、だれでも良いことを行えば、僕であれ、自由人であれ、それに相当する報いを、それぞれ主から受けるであろう。"},{"ref":"Eph.6.9","start":49006009,"end":49006009,"break":"none","ruby":[[0,2,"しゅじん"],[4,1,"もの"],[7,1,"しもべ"],[11,1,"たい"],[15,2,"どうよう"],[44,1,"し"],[53,1,"かれ"],[63,1,"しゅ"],[65,1,"てん"],[77,1,"ひと"],[83,1,"み"]],"text":"主人たる者よ。僕たちに対して、同様にしなさい。おどすことを、してはならない。あなたがたが知っているとおり、彼らとあなたがたとの主は天にいますのであり、かつ人をかたより見ることをなさらないのである。"},{"ref":"Eph.6.10","start":49006010,"end":49006010,"break":"paragraph","ruby":[[0,2,"さいご"],[3,1,"い"],[6,1,"しゅ"],[14,2,"いだい"],[17,1,"ちから"],[23,1,"つよ"]],"text":"最後に言う。主にあって、その偉大な力によって、強くなりなさい。"},{"ref":"Eph.6.11","start":49006011,"end":49006011,"break":"none","ruby":[[0,2,"あくま"],[3,2,"さくりゃく"],[6,2,"たいこう"],[10,1,"た"],[18,1,"かみ"],[20,2,"ぶぐ"],[23,1,"み"],[25,1,"かた"]],"text":"悪魔の策略に対抗して立ちうるために、神の武具で身を固めなさい。"},{"ref":"Eph.6.12","start":49006012,"end":49006012,"break":"none","ruby":[[6,1,"たたか"],[10,2,"けつにく"],[13,1,"たい"],[28,2,"しはい"],[32,2,"けんい"],[39,1,"よ"],[41,3,"しゅけんしゃ"],[47,2,"てんじょう"],[52,1,"あく"],[54,1,"れい"],[56,1,"たい"],[59,1,"たたか"]],"text":"わたしたちの戦いは、血肉に対するものではなく、もろもろの支配と、権威と、やみの世の主権者、また天上にいる悪の霊に対する戦いである。"},{"ref":"Eph.6.13","start":49006013,"end":49006013,"break":"none","ruby":[[6,1,"あ"],[9,1,"ひ"],[18,2,"ていこう"],[22,2,"かんぜん"],[25,1,"か"],[27,1,"ぬ"],[31,1,"かた"],[33,1,"た"],[41,1,"かみ"],[43,2,"ぶぐ"],[46,1,"み"]],"text":"それだから、悪しき日にあたって、よく抵抗し、完全に勝ち抜いて、堅く立ちうるために、神の武具を身につけなさい。"},{"ref":"Eph.6.14","start":49006014,"end":49006014,"break":"none","ruby":[[5,1,"た"],[8,2,"しんり"],[11,1,"おび"],[13,1,"こし"],[18,2,"せいぎ"],[21,2,"むねあて"],[24,1,"むね"]],"text":"すなわち、立って真理の帯を腰にしめ、正義の胸当を胸につけ、"},{"ref":"Eph.6.15","start":49006015,"end":49006015,"break":"none","ruby":[[0,2,"へいわ"],[3,2,"ふくいん"],[6,1,"そな"],[9,1,"あし"]],"text":"平和の福音の備えを足にはき、"},{"ref":"Eph.6.16","start":49006016,"end":49006016,"break":"none","ruby":[[2,1,"うえ"],[5,2,"しんこう"],[11,1,"て"],[13,1,"と"],[26,1,"あ"],[29,1,"もの"],[31,1,"はな"],[33,1,"ひ"],[35,1,"や"],[37,1,"け"]],"text":"その上に、信仰のたてを手に取りなさい。それをもって、悪しき者の放つ火の矢を消すことができるであろう。"},{"ref":"Eph.6.17","start":49006017,"end":49006017,"break":"none","ruby":[[3,1,"すくい"],[13,2,"みたま"],[16,1,"つるぎ"],[23,1,"かみ"],[25,1,"ことば"],[27,1,"と"]],"text":"また、救のかぶとをかぶり、御霊の剣、すなわち、神の言を取りなさい。"},{"ref":"Eph.6.18","start":49006018,"end":49006018,"break":"none","ruby":[[0,1,"た"],[3,1,"いのり"],[5,1,"ねが"],[13,1,"とき"],[16,2,"みたま"],[22,1,"いの"],[30,1,"め"],[48,2,"せいと"],[54,1,"いの"]],"text":"絶えず祈と願いをし、どんな時でも御霊によって祈り、そのために目をさましてうむことがなく、すべての聖徒のために祈りつづけなさい。"},{"ref":"Eph.6.19","start":49006019,"end":49006019,"break":"none","ruby":[[7,1,"くち"],[9,1,"ひら"],[14,1,"かた"],[18,2,"ことば"],[21,1,"たま"],[25,2,"だいたん"],[28,2,"ふくいん"],[31,2,"おくぎ"],[34,1,"あき"],[38,1,"しめ"],[54,1,"いの"]],"text":"また、わたしが口を開くときに語るべき言葉を賜わり、大胆に福音の奥義を明らかに示しうるように、わたしのためにも祈ってほしい。"},{"ref":"Eph.6.20","start":49006020,"end":49006020,"break":"none","ruby":[[6,2,"ふくいん"],[12,2,"しせつ"],[21,1,"くさり"],[45,1,"かた"],[49,1,"とき"],[52,2,"だいたん"],[55,1,"かた"],[61,1,"いの"]],"text":"わたしはこの福音のための使節であり、そして鎖につながれているのであるが、つながれていても、語るべき時には大胆に語れるように祈ってほしい。"},{"ref":"Eph.6.21","start":49006021,"end":49006021,"break":"paragraph","ruby":[[8,2,"ようす"],[12,1,"なに"],[27,1,"し"],[37,1,"しゅ"],[42,2,"ちゅうじつ"],[45,1,"つか"],[50,1,"あい"],[53,2,"きょうだい"],[65,1,"こと"],[67,2,"ほうこく"]],"text":"わたしがどういう様子か、何をしているかを、あなたがたに知ってもらうために、主にあって忠実に仕えている愛する兄弟テキコが、いっさいの事を報告するであろう。"},{"ref":"Eph.6.22","start":49006022,"end":49006022,"break":"none","ruby":[[0,1,"かれ"],[11,1,"おく"],[28,2,"ようす"],[31,1,"し"],[36,1,"かれ"],[41,1,"こころ"],[43,1,"はげ"],[47,1,"う"]],"text":"彼をあなたがたのもとに送るのは、あなたがたがわたしたちの様子を知り、また彼によって心に励ましを受けるようになるためなのである。"},{"ref":"Eph.6.23","start":49006023,"end":49006023,"break":"paragraph","ruby":[[0,1,"ちち"],[3,1,"かみ"],[11,1,"しゅ"],[22,2,"へいあん"],[28,2,"しんこう"],[31,1,"ともな"],[33,1,"あい"],[36,2,"きょうだい"]],"text":"父なる神とわたしたちの主イエス・キリストから平安ならびに信仰に伴う愛が、兄弟たちにあるように。"},{"ref":"Eph.6.24","start":49006024,"end":49006024,"break":"none","ruby":[[0,1,"かわ"],[4,2,"しんじつ"],[17,1,"しゅ"],[27,1,"あい"],[34,2,"ひとびと"],[38,1,"めぐ"]],"text":"変らない真実をもって、わたしたちの主イエス・キリストを愛するすべての人々に、恵みがあるように。"}]