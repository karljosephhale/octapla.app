[{"ref":"Ps.142.1","start":19142001,"end":19142001,"break":"paragraph","title":"ダビデがほら穴にいた時によんだマスキールの歌、祈","breaks":[[16,"line"]],"ruby":[[4,1,"こえ"],[6,1,"だ"],[9,1,"しゅ"],[11,1,"よ"],[16,1,"こえ"],[18,1,"だ"],[21,1,"しゅ"],[23,1,"ねが"],[25,1,"もと"]],"titleRuby":[[6,1,"あな"],[10,1,"とき"],[21,1,"うた"],[23,1,"いのり"]],"text":"わたしは声を出して主に呼ばわり、声を出して主に願い求めます。"},{"ref":"Ps.142.2","start":19142002,"end":19142002,"break":"line","breaks":[[17,"line"]],"ruby":[[5,1,"まえ"],[9,1,"なげ"],[12,1,"そそ"],[14,1,"だ"],[18,1,"まえ"],[22,1,"なや"]],"text":"わたしはみ前にわが嘆きを注ぎ出し、み前にわが悩みをあらわします。"},{"ref":"Ps.142.3","start":19142003,"end":19142003,"break":"line","breaks":[[21,"line"],[35,"line"],[47,"line"]],"ruby":[[2,1,"れい"],[9,1,"き"],[18,1,"とき"],[27,1,"みち"],[29,1,"し"],[35,1,"かれ"],[42,1,"とら"],[51,1,"い"],[53,1,"みち"],[58,1,"かく"]],"text":"わが霊のわがうちに消えうせようとする時も、あなたはわが道を知られます。彼らはわたしを捕えようとわたしの行く道にわなを隠しました。"},{"ref":"Ps.142.4","start":19142004,"end":19142004,"break":"line","breaks":[[19,"line"],[40,"line"],[52,"line"]],"ruby":[[4,1,"みぎ"],[6,1,"ほう"],[8,1,"め"],[10,1,"そそ"],[13,2,"みまわ"],[23,1,"こころ"],[28,1,"もの"],[45,1,"さ"],[47,1,"どころ"],[61,1,"ひと"]],"text":"わたしは右の方に目を注いで見回したが、わたしに心をとめる者はひとりもありません。わたしには避け所がなく、わたしをかえりみる人はありません。"},{"ref":"Ps.142.5","start":19142005,"end":19142005,"break":"line","breaks":[[18,"line"],[38,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"よ"],[22,1,"い"],[34,1,"さ"],[36,1,"どころ"],[38,1,"い"],[41,1,"もの"],[43,1,"ち"],[49,1,"う"],[53,1,"ぶん"]],"text":"主よ、わたしはあなたに呼ばわります。わたしは言います、「あなたはわが避け所、生ける者の地でわたしの受くべき分です。"},{"ref":"Ps.142.6","start":19142006,"end":19142006,"break":"line","breaks":[[22,"line"],[42,"line"],[62,"line"]],"ruby":[[6,1,"さけ"],[33,1,"ひく"],[46,1,"せ"],[49,1,"もの"],[52,1,"たす"],[54,1,"だ"],[62,1,"かれ"],[73,1,"つよ"]],"text":"どうか、わが叫びにみこころをとめてください。わたしは、はなはだしく低くされています。わたしを責める者から助け出してください。彼らはわたしにまさって強いのです。"},{"ref":"Ps.142.7","start":19142007,"end":19142007,"break":"line","breaks":[[12,"line"],[25,"line"],[45,"line"]],"ruby":[[9,1,"だ"],[13,1,"な"],[15,2,"かんしゃ"],[29,1,"ゆた"],[45,1,"ただ"],[48,2,"ひとびと"],[59,1,"あつ"]],"text":"わたしをひとやから出し、み名に感謝させてください。あなたが豊かにわたしをあしらわれるので、正しい人々はわたしのまわりに集まるでしょう」。"}]