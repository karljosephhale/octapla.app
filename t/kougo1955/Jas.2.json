[{"ref":"Jas.2.1","start":59002001,"end":59002001,"break":"paragraph","ruby":[[4,2,"きょうだい"],[16,2,"えいこう"],[19,1,"しゅ"],[30,2,"しんこう"],[33,1,"まも"],[38,1,"わ"],[40,1,"へだ"]],"text":"わたしの兄弟たちよ。わたしたちの栄光の主イエス・キリストへの信仰を守るのに、分け隔てをしてはならない。"},{"ref":"Jas.2.2","start":59002002,"end":59002002,"break":"none","ruby":[[11,2,"かいどう"],[15,1,"きん"],[17,2,"ゆびわ"],[27,2,"きもの"],[30,1,"き"],[32,1,"ひと"],[38,1,"く"],[41,2,"どうじ"],[51,2,"きもの"],[54,1,"き"],[56,1,"まず"],[59,1,"ひと"]],"text":"たとえば、あなたがたの会堂に、金の指輪をはめ、りっぱな着物を着た人がはいって来ると同時に、みすぼらしい着物を着た貧しい人がはいってきたとする。"},{"ref":"Jas.2.3","start":59002003,"end":59002003,"break":"none","ruby":[[2,1,"さい"],[8,2,"きもの"],[11,1,"き"],[13,1,"ひと"],[15,1,"たい"],[35,1,"よ"],[37,1,"せき"],[40,1,"か"],[42,1,"くだ"],[47,1,"い"],[50,1,"まず"],[53,1,"ひと"],[66,1,"た"],[83,1,"あし"],[98,1,"い"]],"text":"その際、りっぱな着物を着た人に対しては、うやうやしく「どうぞ、こちらの良い席にお掛け下さい」と言い、貧しい人には、「あなたは、そこに立っていなさい。それとも、わたしの足もとにすわっているがよい」と言ったとしたら、"},{"ref":"Jas.2.4","start":59002004,"end":59002004,"break":"none","ruby":[[7,2,"じぶん"],[12,1,"あいだ"],[14,2,"さべつ"],[16,1,"だ"],[25,1,"かんが"],[28,1,"ひと"],[33,1,"もの"]],"text":"あなたがたは、自分たちの間で差別立てをし、よからぬ考えで人をさばく者になったわけではないか。"},{"ref":"Jas.2.5","start":59002005,"end":59002005,"break":"none","ruby":[[0,1,"あい"],[3,2,"きょうだい"],[11,1,"き"],[17,1,"かみ"],[22,1,"よ"],[24,1,"まず"],[27,1,"ひと"],[31,1,"えら"],[34,2,"しんこう"],[37,1,"と"],[41,1,"かみ"],[43,1,"あい"],[46,1,"もの"],[50,2,"やくそく"],[55,2,"みくに"],[58,3,"そうぞくしゃ"]],"text":"愛する兄弟たちよ。よく聞きなさい。神は、この世の貧しい人たちを選んで信仰に富ませ、神を愛する者たちに約束された御国の相続者とされたではないか。"},{"ref":"Jas.2.6","start":59002006,"end":59002006,"break":"none","ruby":[[11,1,"まず"],[14,1,"ひと"],[38,3,"さいばんしょ"],[42,1,"ひ"],[46,1,"こ"],[51,1,"と"],[56,1,"もの"]],"text":"しかるに、あなたがたは貧しい人をはずかしめたのである。あなたがたをしいたげ、裁判所に引きずり込むのは、富んでいる者たちではないか。"},{"ref":"Jas.2.7","start":59002007,"end":59002007,"break":"none","ruby":[[6,1,"たい"],[9,1,"とな"],[14,1,"たっと"],[16,2,"みな"],[19,1,"けが"],[24,1,"じつ"],[26,1,"かれ"]],"text":"あなたがたに対して唱えられた尊い御名を汚すのは、実に彼らではないか。"},{"ref":"Jas.2.8","start":59002008,"end":59002008,"break":"none","ruby":[[14,2,"じぶん"],[17,1,"あい"],[28,1,"とな"],[30,1,"ひと"],[32,1,"あい"],[39,2,"せいしょ"],[42,2,"ことば"],[45,1,"したが"],[55,1,"たっと"],[57,2,"りっぽう"],[60,1,"まも"],[69,1,"よ"]],"text":"しかし、もしあなたがたが、「自分を愛するように、あなたの隣り人を愛せよ」という聖書の言葉に従って、このきわめて尊い律法を守るならば、それは良いことである。"},{"ref":"Jas.2.9","start":59002009,"end":59002009,"break":"none","ruby":[[6,1,"わ"],[8,1,"へだ"],[23,1,"つみ"],[25,1,"おか"],[33,2,"りっぽう"],[39,3,"いはんしゃ"],[45,2,"せんこく"]],"text":"しかし、もし分け隔てをするならば、あなたがたは罪を犯すことになり、律法によって違反者として宣告される。"},{"ref":"Jas.2.10","start":59002010,"end":59002010,"break":"none","ruby":[[5,2,"りっぽう"],[13,1,"まも"],[26,1,"てん"],[30,1,"お"],[32,1,"ど"],[38,2,"ぜんたい"],[41,1,"おか"]],"text":"なぜなら、律法をことごとく守ったとしても、その一つの点にでも落ち度があれば、全体を犯したことになるからである。"},{"ref":"Jas.2.11","start":59002011,"end":59002011,"break":"none","ruby":[[6,2,"かんいん"],[13,1,"い"],[24,1,"ころ"],[30,1,"おお"],[44,2,"かんいん"],[53,2,"ひとごろ"],[61,2,"りっぽう"],[64,3,"いはんしゃ"]],"text":"たとえば、「姦淫するな」と言われたかたは、また「殺すな」とも仰せになった。そこで、たとい姦淫はしなくても、人殺しをすれば、律法の違反者になったことになる。"},{"ref":"Jas.2.12","start":59002012,"end":59002012,"break":"none","ruby":[[4,2,"じゆう"],[7,2,"りっぽう"],[19,1,"もの"],[23,1,"かた"],[28,1,"おこな"]],"text":"だから、自由の律法によってさばかるべき者らしく語り、かつ行いなさい。"},{"ref":"Jas.2.13","start":59002013,"end":59002013,"break":"none","ruby":[[5,1,"おこな"],[11,1,"もの"],[13,1,"たい"],[18,2,"かしゃく"],[27,1,"くだ"],[44,1,"か"]],"text":"あわれみを行わなかった者に対しては、仮借のないさばきが下される。あわれみは、さばきにうち勝つ。"},{"ref":"Jas.2.14","start":59002014,"end":59002014,"break":"paragraph","ruby":[[4,2,"きょうだい"],[12,1,"ひと"],[14,2,"じぶん"],[18,2,"しんこう"],[24,1,"しょう"],[33,1,"おこな"],[45,1,"やく"],[47,1,"た"],[53,2,"しんこう"],[56,1,"かれ"],[58,1,"すく"]],"text":"わたしの兄弟たちよ。ある人が自分には信仰があると称していても、もし行いがなかったら、なんの役に立つか。その信仰は彼を救うことができるか。"},{"ref":"Jas.2.15","start":59002015,"end":59002015,"break":"none","ruby":[[2,2,"きょうだい"],[7,2,"しまい"],[10,1,"はだか"],[17,1,"ひ"],[19,2,"しょくもつ"],[25,1,"か"],[30,2,"ばあい"]],"text":"ある兄弟または姉妹が裸でいて、その日の食物にもこと欠いている場合、"},{"ref":"Jas.2.16","start":59002016,"end":59002016,"break":"none","ruby":[[15,1,"やす"],[19,1,"い"],[25,1,"あたた"],[30,1,"た"],[32,1,"あ"],[39,1,"い"],[51,2,"ひつよう"],[57,1,"なに"],[61,1,"あた"],[75,1,"やく"],[77,1,"た"]],"text":"あなたがたのうち、だれかが、「安らかに行きなさい。暖まって、食べ飽きなさい」と言うだけで、そのからだに必要なものを何ひとつ与えなかったとしたら、なんの役に立つか。"},{"ref":"Jas.2.17","start":59002017,"end":59002017,"break":"none","ruby":[[0,2,"しんこう"],[7,2,"どうよう"],[11,1,"おこな"],[14,1,"ともな"],[27,1,"し"]],"text":"信仰も、それと同様に、行いを伴わなければ、それだけでは死んだものである。"},{"ref":"Jas.2.18","start":59002018,"end":59002018,"break":"none","ruby":[[7,1,"ひと"],[10,2,"しんこう"],[21,1,"ひと"],[24,1,"おこな"],[31,1,"い"],[33,1,"もの"],[44,1,"おこな"],[53,2,"しんこう"],[60,1,"み"],[77,1,"おこな"],[83,2,"しんこう"],[86,1,"み"]],"text":"しかし、「ある人には信仰があり、またほかの人には行いがある」と言う者があろう。それなら、行いのないあなたの信仰なるものを見せてほしい。そうしたら、わたしの行いによって信仰を見せてあげよう。"},{"ref":"Jas.2.19","start":59002019,"end":59002019,"break":"none","ruby":[[5,1,"かみ"],[16,1,"しん"],[27,2,"けっこう"],[33,2,"あくりょう"],[41,1,"しん"]],"text":"あなたは、神はただひとりであると信じているのか。それは結構である。悪霊どもでさえ、信じておののいている。"},{"ref":"Jas.2.20","start":59002020,"end":59002020,"break":"none","ruby":[[3,1,"おろ"],[6,1,"ひと"],[9,1,"おこな"],[12,1,"ともな"],[16,2,"しんこう"],[26,1,"し"]],"text":"ああ、愚かな人よ。行いを伴わない信仰のむなしいことを知りたいのか。"},{"ref":"Jas.2.21","start":59002021,"end":59002021,"break":"none","ruby":[[6,2,"ふそ"],[17,1,"こ"],[22,2,"さいだん"],[29,1,"とき"],[31,1,"おこな"],[37,1,"ぎ"]],"text":"わたしたちの父祖アブラハムは、その子イサクを祭壇にささげた時、行いによって義とされたのではなかったか。"},{"ref":"Jas.2.22","start":59002022,"end":59002022,"break":"none","ruby":[[4,1,"し"],[13,1,"かれ"],[20,2,"しんこう"],[23,1,"おこな"],[26,1,"とも"],[28,1,"はたら"],[33,1,"おこな"],[39,2,"しんこう"],[42,1,"まっと"]],"text":"あなたが知っているとおり、彼においては、信仰が行いと共に働き、その行いによって信仰が全うされ、"},{"ref":"Jas.2.23","start":59002023,"end":59002023,"break":"none","ruby":[[12,1,"かみ"],[14,1,"しん"],[25,1,"かれ"],[27,1,"ぎ"],[29,1,"みと"],[38,2,"せいしょ"],[41,2,"ことば"],[44,2,"じょうじゅ"],[52,1,"かれ"],[55,1,"かみ"],[57,1,"とも"],[60,1,"とな"]],"text":"こうして、「アブラハムは神を信じた。それによって、彼は義と認められた」という聖書の言葉が成就し、そして、彼は「神の友」と唱えられたのである。"},{"ref":"Jas.2.24","start":59002024,"end":59002024,"break":"none","ruby":[[10,1,"ひと"],[12,1,"ぎ"],[20,1,"おこな"],[31,2,"しんこう"]],"text":"これでわかるように、人が義とされるのは、行いによるのであって、信仰だけによるのではない。"},{"ref":"Jas.2.25","start":59002025,"end":59002025,"break":"none","ruby":[[0,1,"おな"],[8,2,"ゆうじょ"],[18,2,"ししゃ"],[28,1,"かれ"],[31,1,"べつ"],[33,1,"みち"],[36,1,"おく"],[38,1,"だ"],[41,1,"とき"],[43,1,"おこな"],[49,1,"ぎ"]],"text":"同じように、かの遊女ラハブでさえも、使者たちをもてなし、彼らを別な道から送り出した時、行いによって義とされたではないか。"},{"ref":"Jas.2.26","start":59002026,"end":59002026,"break":"none","ruby":[[0,2,"れいこん"],[9,1,"し"],[18,2,"どうよう"],[22,1,"おこな"],[27,2,"しんこう"],[30,1,"し"]],"text":"霊魂のないからだが死んだものであると同様に、行いのない信仰も死んだものなのである。"}]