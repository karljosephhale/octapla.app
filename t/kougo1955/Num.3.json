[{"ref":"Num.3.1","start":4003001,"end":4003001,"break":"paragraph","ruby":[[0,1,"しゅ"],[5,1,"さん"],[12,1,"かた"],[16,1,"とき"],[27,2,"いちぞく"],[31,1,"つぎ"]],"text":"主がシナイ山で、モーセと語られた時の、アロンとモーセの一族は、次のとおりであった。"},{"ref":"Num.3.2","start":4003002,"end":4003002,"break":"none","ruby":[[4,1,"こ"],[8,1,"な"],[11,1,"つぎ"],[20,2,"ちょうし"],[27,1,"つぎ"]],"text":"アロンの子たちの名は、次のとおりである。長子はナダブ、次はアビウ、エレアザル、イタマル。"},{"ref":"Num.3.3","start":4003003,"end":4003003,"break":"none","ruby":[[7,1,"こ"],[11,1,"な"],[17,1,"かれ"],[22,1,"あぶら"],[24,1,"そそ"],[28,2,"さいし"],[31,1,"しょく"],[33,1,"にん"],[38,2,"さいし"]],"text":"これがアロンの子たちの名であって、彼らはみな油を注がれ、祭司の職に任じられて祭司となった。"},{"ref":"Num.3.4","start":4003004,"end":4003004,"break":"none","ruby":[[14,2,"あらの"],[21,2,"ことび"],[24,1,"しゅ"],[26,1,"まえ"],[35,1,"しゅ"],[37,1,"まえ"],[39,1,"し"],[43,1,"かれ"],[47,2,"こども"],[71,1,"ちち"],[76,1,"まえ"],[78,2,"さいし"],[81,1,"つとめ"]],"text":"ナダブとアビウとは、シナイの荒野において、異火を主の前にささげたので、主の前で死んだ。彼らには子供がなかった。そしてエレアザルとイタマルとが、父アロンの前で祭司の務をした。"},{"ref":"Num.3.5","start":4003005,"end":4003005,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.3.6","start":4003006,"end":4003006,"break":"none","ruby":[[4,2,"ぶぞく"],[7,1,"め"],[9,1,"よ"],[12,2,"さいし"],[18,1,"まえ"],[20,1,"た"],[23,1,"つか"]],"text":"「レビの部族を召し寄せ、祭司アロンの前に立って仕えさせなさい。"},{"ref":"Num.3.7","start":4003007,"end":4003007,"break":"none","ruby":[[0,1,"かれ"],[3,2,"かいけん"],[6,2,"まくや"],[9,1,"まえ"],[19,1,"ぜん"],[20,2,"かいしゅう"],[29,1,"つとめ"],[33,2,"まくや"],[36,1,"はたら"]],"text":"彼らは会見の幕屋の前にあって、アロンと全会衆のために、その務をし、幕屋の働きをしなければならない。"},{"ref":"Num.3.8","start":4003008,"end":4003008,"break":"none","ruby":[[5,1,"かれ"],[8,2,"かいけん"],[11,2,"まくや"],[19,1,"うつわ"],[31,2,"ひとびと"],[37,1,"つとめ"],[41,2,"まくや"],[44,1,"はたら"]],"text":"すなわち、彼らは会見の幕屋の、すべての器をまもり、イスラエルの人々のために務をし、幕屋の働きをしなければならない。"},{"ref":"Num.3.9","start":4003009,"end":4003009,"break":"none","ruby":[[16,1,"こ"],[22,1,"あた"],[33,1,"かれ"],[42,2,"ひとびと"],[50,1,"まった"],[56,1,"あた"]],"text":"あなたはレビびとを、アロンとその子たちとに、与えなければならない。彼らはイスラエルの人々のうちから、全くアロンに与えられたものである。"},{"ref":"Num.3.10","start":4003010,"end":4003010,"break":"none","ruby":[[10,1,"こ"],[15,1,"た"],[19,2,"さいし"],[22,1,"しょく"],[24,1,"まも"],[39,1,"ひと"],[41,1,"ちか"],[47,1,"ころ"]],"text":"あなたはアロンとその子たちとを立てて、祭司の職を守らせなければならない。ほかの人で近づくものは殺されるであろう」。"},{"ref":"Num.3.11","start":4003011,"end":4003011,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.3.12","start":4003012,"end":4003012,"break":"none","ruby":[[12,2,"ひとびと"],[18,1,"はじ"],[21,1,"うま"],[32,1,"かわ"],[47,2,"ひとびと"],[54,1,"と"]],"text":"「わたしは、イスラエルの人々のうちの初めに生れたすべてのういごの代りに、レビびとをイスラエルの人々のうちから取るであろう。レビびとは、わたしのものとなるであろう。"},{"ref":"Num.3.13","start":4003013,"end":4003013,"break":"none","ruby":[[30,1,"くに"],[44,1,"う"],[46,1,"ころ"],[49,1,"ひ"],[63,1,"ひと"],[65,1,"けもの"],[73,2,"せいべつ"],[82,1,"き"],[88,1,"かれ"],[109,1,"しゅ"]],"text":"ういごはすべてわたしのものだからである。わたしは、エジプトの国において、すべてのういごを撃ち殺した日に、イスラエルのういごを、人も獣も、ことごとく聖別して、わたしに帰せしめた。彼らはわたしのものとなるであろう。わたしは主である」。"},{"ref":"Num.3.14","start":4003014,"end":4003014,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,2,"あらの"],[15,1,"い"]],"text":"主はまたシナイの荒野でモーセに言われた、"},{"ref":"Num.3.15","start":4003015,"end":4003015,"break":"none","ruby":[[8,1,"こ"],[15,2,"ふそ"],[18,1,"いえ"],[25,2,"しぞく"],[31,1,"かぞ"],[44,1,"げつ"],[45,2,"いじょう"],[48,2,"だんし"],[51,1,"かぞ"]],"text":"「あなたはレビの子たちを、その父祖の家により、その氏族によって数えなさい。すなわち、一か月以上の男子を数えなければならない」。"},{"ref":"Num.3.16","start":4003016,"end":4003016,"break":"none","ruby":[[7,1,"しゅ"],[9,2,"ことば"],[18,1,"めい"],[31,1,"かぞ"]],"text":"それでモーセは主の言葉にしたがって、命じられたとおりに、それを数えた。"},{"ref":"Num.3.17","start":4003017,"end":4003017,"break":"none","ruby":[[3,1,"こ"],[7,1,"な"],[9,1,"つぎ"]],"text":"レビの子たちの名は次のとおりである。すなわち、ゲルション、コハテ、メラリ。"},{"ref":"Num.3.18","start":4003018,"end":4003018,"break":"none","ruby":[[6,1,"こ"],[10,1,"な"],[15,2,"しぞく"],[21,1,"つぎ"]],"text":"ゲルションの子たちの名は、その氏族によれば次のとおりである。すなわち、リブニ、シメイ。"},{"ref":"Num.3.19","start":4003019,"end":4003019,"break":"none","ruby":[[4,1,"こ"],[11,2,"しぞく"]],"text":"コハテの子たちは、その氏族によれば、アムラム、イヅハル、ヘブロン、ウジエル。"},{"ref":"Num.3.20","start":4003020,"end":4003020,"break":"none","ruby":[[4,1,"こ"],[11,2,"しぞく"],[31,2,"ふそ"],[34,1,"いえ"],[41,2,"しぞく"]],"text":"メラリの子たちは、その氏族によれば、マヘリ、ムシ。これらはその父祖の家によるレビの氏族である。"},{"ref":"Num.3.21","start":4003021,"end":4003021,"break":"paragraph","ruby":[[13,2,"しぞく"],[23,2,"しぞく"],[27,1,"で"],[42,2,"しぞく"]],"text":"ゲルションからリブニびとの氏族と、シメイびとの氏族とが出た。これらはゲルションびとの氏族である。"},{"ref":"Num.3.22","start":4003022,"end":4003022,"break":"none","ruby":[[2,1,"かぞ"],[7,1,"もの"],[16,1,"げつ"],[17,2,"いじょう"],[20,2,"だんし"],[23,1,"かず"],[25,1,"あ"],[33,1,"にん"]],"text":"その数えられた者、すなわち、一か月以上の男子の数は合わせて七千五百人であった。"},{"ref":"Num.3.23","start":4003023,"end":4003023,"break":"none","ruby":[[8,2,"しぞく"],[11,2,"まくや"],[14,2,"こうほう"],[22,1,"にし"],[24,1,"ほう"],[26,2,"しゅくえい"]],"text":"ゲルションびとの氏族は幕屋の後方、すなわち、西の方に宿営し、"},{"ref":"Num.3.24","start":4003024,"end":4003024,"break":"none","ruby":[[4,1,"こ"],[20,2,"ふそ"],[23,1,"いえ"]],"text":"ラエルの子エリアサフが、ゲルションびとの父祖の家のつかさとなるであろう。"},{"ref":"Num.3.25","start":4003025,"end":4003025,"break":"none","ruby":[[0,2,"かいけん"],[3,2,"まくや"],[13,1,"こ"],[17,1,"つとめ"],[20,2,"まくや"],[23,2,"てんまく"],[32,2,"かいけん"],[35,2,"まくや"],[38,2,"いりぐち"]],"text":"会見の幕屋の、ゲルションの子たちの務は、幕屋、天幕とそのおおい、会見の幕屋の入口のとばり、"},{"ref":"Num.3.26","start":4003026,"end":4003026,"break":"none","ruby":[[0,1,"にわ"],[7,2,"まくや"],[10,2,"さいだん"],[17,1,"にわ"],[19,2,"いりぐち"],[40,1,"もち"],[43,1,"もの"],[45,1,"まも"]],"text":"庭のあげばり、幕屋と祭壇のまわりの庭の入口のとばり、そのひも、およびすべてそれに用いる物を守ることである。"},{"ref":"Num.3.27","start":4003027,"end":4003027,"break":"paragraph","ruby":[[15,2,"しぞく"],[25,2,"しぞく"],[35,2,"しぞく"],[45,2,"しぞく"],[48,1,"で"],[61,2,"しぞく"]],"text":"また、コハテからアムラムびとの氏族、イヅハルびとの氏族、ヘブロンびとの氏族、ウジエルびとの氏族が出た。これらはコハテびとの氏族である。"},{"ref":"Num.3.28","start":4003028,"end":4003028,"break":"none","ruby":[[2,1,"げつ"],[3,2,"いじょう"],[6,2,"だんし"],[9,1,"かず"],[12,1,"あ"],[20,1,"にん"],[26,2,"せいじょ"],[29,1,"つとめ"],[31,1,"まも"],[33,1,"もの"]],"text":"一か月以上の男子の数は、合わせて八千六百人であって、聖所の務を守る者たちである。"},{"ref":"Num.3.29","start":4003029,"end":4003029,"break":"none","ruby":[[4,1,"こ"],[8,2,"しぞく"],[12,2,"まくや"],[15,1,"みなみ"],[17,1,"ほう"],[19,2,"しゅくえい"]],"text":"コハテの子たちの氏族は、幕屋の南の方に宿営し、"},{"ref":"Num.3.30","start":4003030,"end":4003030,"break":"none","ruby":[[5,1,"こ"],[19,2,"しぞく"],[22,2,"ふそ"],[25,1,"いえ"]],"text":"ウジエルの子エリザパンが、コハテびとの氏族の父祖の家のつかさとなるであろう。"},{"ref":"Num.3.31","start":4003031,"end":4003031,"break":"none","ruby":[[0,1,"かれ"],[3,1,"つとめ"],[6,2,"けいやく"],[9,1,"はこ"],[11,1,"つくえ"],[13,2,"しょくだい"],[19,2,"さいだん"],[22,2,"せいじょ"],[25,1,"つとめ"],[27,1,"もち"],[30,1,"うつわ"],[45,1,"もち"],[48,1,"もの"],[50,1,"まも"]],"text":"彼らの務は、契約の箱、机、燭台、二つの祭壇、聖所の務に用いる器、とばり、およびすべてそれに用いる物を守ることである。"},{"ref":"Num.3.32","start":4003032,"end":4003032,"break":"none","ruby":[[0,2,"さいし"],[6,1,"こ"],[25,1,"ちょう"],[30,2,"せいじょ"],[33,1,"つとめ"],[35,1,"まも"],[42,2,"かんとく"]],"text":"祭司アロンの子エレアザルが、レビびとのつかさたちの長となり、聖所の務を守るものたちを監督するであろう。"},{"ref":"Num.3.33","start":4003033,"end":4003033,"break":"paragraph","ruby":[[11,2,"しぞく"],[20,2,"しぞく"],[24,1,"で"],[35,2,"しぞく"]],"text":"メラリからマヘリびとの氏族と、ムシびとの氏族とが出た。これらはメラリの氏族である。"},{"ref":"Num.3.34","start":4003034,"end":4003034,"break":"none","ruby":[[2,1,"かぞ"],[7,1,"もの"],[16,1,"げつ"],[17,2,"いじょう"],[20,2,"だんし"],[23,1,"かず"],[26,1,"あ"],[34,1,"にん"]],"text":"その数えられた者、すなわち、一か月以上の男子の数は、合わせて六千二百人であった。"},{"ref":"Num.3.35","start":4003035,"end":4003035,"break":"none","ruby":[[6,1,"こ"],[17,2,"しぞく"],[20,2,"ふそ"],[23,1,"いえ"],[36,1,"かれ"],[39,2,"まくや"],[42,1,"きた"],[44,1,"ほう"],[46,2,"しゅくえい"]],"text":"アビハイルの子ツリエルが、メラリの氏族の父祖の家のつかさとなるであろう。彼らは幕屋の北の方に宿営しなければならない。"},{"ref":"Num.3.36","start":4003036,"end":4003036,"break":"none","ruby":[[4,1,"こ"],[11,1,"つとめ"],[15,2,"かんり"],[24,2,"まくや"],[27,1,"わく"],[31,2,"よこぎ"],[36,1,"はしら"],[40,1,"ざ"],[48,1,"うつわ"],[56,1,"もち"],[63,1,"もの"]],"text":"メラリの子たちが、その務として管理すべきものは、幕屋の枠、その横木、その柱、その座、そのすべての器、およびそれに用いるすべての物、"},{"ref":"Num.3.37","start":4003037,"end":4003037,"break":"none","ruby":[[4,1,"にわ"],[10,1,"はしら"],[14,1,"ざ"],[18,1,"くぎ"]],"text":"ならびに庭のまわりの柱とその座、その釘、およびそのひもである。"},{"ref":"Num.3.38","start":4003038,"end":4003038,"break":"paragraph","ruby":[[2,2,"まくや"],[5,1,"まえ"],[9,1,"ひがし"],[11,1,"ほう"],[18,2,"かいけん"],[21,2,"まくや"],[24,1,"ひがし"],[26,1,"ほう"],[28,2,"しゅくえい"],[32,1,"もの"],[50,1,"こ"],[64,2,"ひとびと"],[67,1,"つとめ"],[69,1,"かわ"],[73,2,"せいじょ"],[76,1,"つとめ"],[78,1,"まも"],[89,1,"ひと"],[91,1,"ちか"],[94,1,"もの"],[96,1,"ころ"]],"text":"また幕屋の前、その東の方、すなわち、会見の幕屋の東の方に宿営する者は、モーセとアロン、およびアロンの子たちであって、イスラエルの人々の務に代って、聖所の務を守るものである。ほかの人で近づく者は殺されるであろう。"},{"ref":"Num.3.39","start":4003039,"end":4003039,"break":"none","ruby":[[10,1,"しゅ"],[12,2,"ことば"],[20,1,"かぞ"],[31,2,"しぞく"],[37,1,"かぞ"],[42,1,"もの"],[46,1,"げつ"],[47,2,"いじょう"],[50,2,"だんし"],[54,1,"あ"],[62,1,"にん"]],"text":"モーセとアロンとが、主の言葉にしたがって数えたレビびとで、その氏族によって数えられた者、一か月以上の男子は、合わせて二万二千人であった。"},{"ref":"Num.3.40","start":4003040,"end":4003040,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[25,2,"ひとびと"],[40,2,"だんし"],[45,1,"げつ"],[46,2,"いじょう"],[52,1,"かぞ"],[58,1,"な"],[60,1,"かず"],[62,1,"しら"]],"text":"主はまたモーセに言われた、「あなたは、イスラエルの人々のうち、すべてういごである男子の一か月以上のものを数えて、その名の数を調べなさい。"},{"ref":"Num.3.41","start":4003041,"end":4003041,"break":"none","ruby":[[2,1,"しゅ"],[19,2,"ひとびと"],[34,1,"かわ"],[42,1,"と"],[53,2,"ひとびと"],[56,2,"かちく"],[71,1,"かわ"],[80,2,"かちく"],[83,1,"と"]],"text":"また主なるわたしのために、イスラエルの人々のうちの、すべてのういごの代りにレビびとを取り、またイスラエルの人々の家畜のうちの、すべてのういごの代りに、レビびとの家畜を取りなさい」。"},{"ref":"Num.3.42","start":4003042,"end":4003042,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"めい"],[24,2,"ひとびと"],[39,1,"かぞ"]],"text":"そこでモーセは主の命じられたように、イスラエルの人々のうちの、すべてのういごを数えた。"},{"ref":"Num.3.43","start":4003043,"end":4003043,"break":"none","ruby":[[2,1,"かぞ"],[11,2,"だんし"],[19,1,"げつ"],[20,2,"いじょう"],[23,1,"もの"],[28,1,"な"],[30,1,"かず"],[44,1,"にん"]],"text":"その数えられたういごの男子、すべて一か月以上の者は、その名の数によると二万二千二百七十三人であった。"},{"ref":"Num.3.44","start":4003044,"end":4003044,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.3.45","start":4003045,"end":4003045,"break":"none","ruby":[[11,2,"ひとびと"],[26,1,"かわ"],[35,1,"と"],[40,1,"かれ"],[43,2,"かちく"],[46,1,"かわ"],[55,2,"かちく"],[58,1,"と"],[83,1,"しゅ"]],"text":"「あなたはイスラエルの人々のうちの、すべてのういごの代りに、レビびとを取り、また彼らの家畜の代りに、レビびとの家畜を取りなさい。レビびとはわたしのものとなる。わたしは主である。"},{"ref":"Num.3.46","start":4003046,"end":4003046,"break":"none","ruby":[[8,2,"ひとびと"],[21,1,"かず"],[28,1,"にん"],[29,2,"ちょうか"]],"text":"またイスラエルの人々のういごは、レビびとの数を二百七十三人超過しているから、そのあがないのために、"},{"ref":"Num.3.47","start":4003047,"end":4003047,"break":"none","ruby":[[18,1,"ぎん"],[19,1,"ご"],[24,1,"と"],[40,2,"せいじょ"],[56,1,"と"]],"text":"そのあたまかずによって、ひとりごとに銀五シケルを取らなければならない。すなわち、聖所のシケルにしたがって、それを取らなければならない。一シケルは二十ゲラである。"},{"ref":"Num.3.48","start":4003048,"end":4003048,"break":"none","ruby":[[7,2,"ちょうか"],[11,1,"もの"],[17,1,"かね"],[27,1,"こ"],[31,1,"わた"]],"text":"あなたは、その超過した者をあがなう金を、アロンと、その子たちに渡さなければならない」。"},{"ref":"Num.3.49","start":4003049,"end":4003049,"break":"none","ruby":[[22,1,"もの"],[24,2,"ちょうか"],[28,2,"ひとびと"],[38,1,"かね"],[40,1,"と"]],"text":"そこでモーセは、レビびとによってあがなわれた者を超過した人々から、あがないの金を取った。"},{"ref":"Num.3.50","start":4003050,"end":4003050,"break":"none","ruby":[[16,2,"ひとびと"],[25,2,"せいじょ"],[47,1,"ぎん"],[49,1,"と"]],"text":"すなわち、モーセは、イスラエルの人々のういごから、聖所のシケルにしたがって千三百六十五シケルの銀を取り、"},{"ref":"Num.3.51","start":4003051,"end":4003051,"break":"none","ruby":[[7,1,"かね"],[10,1,"しゅ"],[12,2,"ことば"],[27,1,"こ"],[31,1,"わた"],[35,1,"しゅ"],[41,1,"めい"]],"text":"そのあがないの金を、主の言葉にしたがって、アロンとその子たちに渡した。主がモーセに命じられたとおりである。"}]