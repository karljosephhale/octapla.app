[{"ref":"Isa.14.1","start":23014001,"end":23014001,"break":"paragraph","ruby":[[0,1,"しゅ"],[17,1,"ふたた"],[19,1,"えら"],[30,1,"ち"],[32,1,"お"],[37,3,"いほうじん"],[44,1,"くわ"],[53,1,"いえ"],[55,1,"むす"]],"text":"主はヤコブをあわれみ、イスラエルを再び選んで、これをおのれの地に置かれる。異邦人はこれに加わって、ヤコブの家に結びつらなり、"},{"ref":"Isa.14.2","start":23014002,"end":23014002,"break":"none","ruby":[[5,1,"たみ"],[7,1,"かれ"],[10,1,"つ"],[15,1,"ところ"],[17,1,"みちび"],[20,1,"く"],[32,1,"いえ"],[35,1,"しゅ"],[37,1,"ち"],[39,1,"かれ"],[42,2,"だんじょ"],[45,2,"どれい"],[53,2,"じぶん"],[58,2,"ほりょ"],[63,1,"もの"],[65,2,"ほりょ"],[70,2,"じぶん"],[80,1,"もの"],[82,1,"おさ"]],"text":"もろもろの民は彼らを連れてその所に導いて来る。そしてイスラエルの家は、主の地で彼らを男女の奴隷とし、さきに自分たちを捕虜にした者を捕虜にし、自分たちをしえたげた者を治める。"},{"ref":"Isa.14.3","start":23014003,"end":23014003,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,2,"くろう"],[9,2,"ふあん"],[13,1,"のぞ"],[22,1,"ふく"],[25,2,"くえき"],[28,1,"のぞ"],[32,2,"あんそく"],[36,1,"あた"]],"text":"主があなたの苦労と不安とを除き、またあなたが服した苦役を除いて、安息をお与えになるとき、"},{"ref":"Isa.14.4","start":23014004,"end":23014004,"break":"none","breaks":[[32,"stanza"],[53,"line"]],"ruby":[[11,1,"うた"],[22,1,"おう"],[29,1,"い"],[41,1,"もの"],[43,1,"まった"],[45,1,"た"],[59,1,"もの"],[61,1,"まった"],[63,1,"た"]],"text":"あなたはこのあざけりの歌をとなえ、バビロンの王をののしって言う、「あの、しえたげる者は全く絶えてしまった。あの、おごる者は全く絶えてしまった。"},{"ref":"Isa.14.5","start":23014005,"end":23014005,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"わる"],[4,1,"もの"],[16,1,"しゃく"],[18,1,"お"]],"text":"主は悪い者のつえと、つかさびとの笏を折られた。"},{"ref":"Isa.14.6","start":23014006,"end":23014006,"break":"line","breaks":[[16,"line"],[26,"line"],[44,"line"]],"ruby":[[0,1,"かれ"],[3,1,"いきどお"],[14,1,"たみ"],[16,1,"た"],[19,1,"う"],[23,1,"う"],[26,1,"いか"],[37,1,"くに"],[39,1,"おさ"],[55,1,"もの"]],"text":"彼らは憤りをもってもろもろの民を絶えず撃っては打ち、怒りをもってもろもろの国を治めても、そのしえたげをとどめる者がなかった。"},{"ref":"Isa.14.7","start":23014007,"end":23014007,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ぜん"],[1,1,"ち"],[7,1,"え"],[9,1,"おだ"],[21,1,"こえ"],[26,1,"うた"]],"text":"全地はやすみを得、穏やかになり、ことごとく声をあげて歌う。"},{"ref":"Isa.14.8","start":23014008,"end":23014008,"break":"line","breaks":[[18,"line"],[31,"line"],[45,"line"],[59,"line"]],"ruby":[[12,2,"こうはく"],[25,1,"よろこ"],[28,1,"い"],[39,1,"たお"],[53,1,"のぼ"],[64,1,"せ"]],"text":"いとすぎおよびレバノンの香柏でさえもあなたのゆえに喜んで言う、『あなたはすでに倒れたので、もはや、きこりが上ってきて、われわれを攻めることはない』。"},{"ref":"Isa.14.9","start":23014009,"end":23014009,"break":"line","breaks":[[16,"line"],[27,"line"],[43,"line"],[53,"line"],[63,"line"]],"ruby":[[0,1,"した"],[2,2,"よみ"],[12,1,"うご"],[20,1,"く"],[24,1,"むか"],[27,1,"ち"],[34,3,"しどうしゃ"],[40,2,"ぼうれい"],[50,1,"おこ"],[53,2,"くにぐに"],[61,1,"おう"],[65,2,"おうざ"],[69,1,"た"]],"text":"下の陰府はあなたのために動いて、あなたの来るのを迎え、地のもろもろの指導者たちの亡霊をあなたのために起し、国々のもろもろの王をその王座から立ちあがらせる。"},{"ref":"Isa.14.10","start":23014010,"end":23014010,"break":"line","breaks":[[14,"line"],[35,"line"]],"ruby":[[0,1,"かれ"],[3,1,"みな"],[8,1,"つ"],[11,1,"い"],[29,1,"よわ"],[44,1,"おな"]],"text":"彼らは皆あなたに告げて言う、『あなたもまたわれわれのように弱くなった、あなたもわれわれと同じようになった』。"},{"ref":"Isa.14.11","start":23014011,"end":23014011,"break":"line","breaks":[[15,"line"],[26,"line"],[39,"line"]],"ruby":[[4,2,"えいが"],[11,1,"こと"],[13,1,"ね"],[15,2,"よみ"],[18,1,"お"],[33,1,"した"],[35,1,"し"]],"text":"あなたの栄華とあなたの琴の音は陰府に落ちてしまった。うじはあなたの下に敷かれ、みみずはあなたをおおっている。"},{"ref":"Isa.14.12","start":23014012,"end":23014012,"break":"paragraph","breaks":[[12,"line"],[27,"line"],[40,"line"]],"ruby":[[0,2,"れいめい"],[3,1,"こ"],[5,1,"あ"],[8,2,"みょうじょう"],[16,1,"てん"],[19,1,"お"],[32,1,"くに"],[34,1,"たお"],[37,1,"もの"],[44,1,"き"],[48,1,"ち"],[50,1,"たお"]],"text":"黎明の子、明けの明星よ、あなたは天から落ちてしまった。もろもろの国を倒した者よ、あなたは切られて地に倒れてしまった。"},{"ref":"Isa.14.13","start":23014013,"end":23014013,"break":"line","breaks":[[16,"line"],[27,"line"],[45,"line"]],"ruby":[[7,1,"こころ"],[12,1,"い"],[21,1,"てん"],[31,2,"おうざ"],[34,1,"たか"],[36,1,"かみ"],[38,1,"ほし"],[40,1,"うえ"],[45,1,"きた"],[47,1,"はて"],[50,2,"しゅうかい"],[53,1,"やま"],[55,1,"ざ"]],"text":"あなたはさきに心のうちに言った、『わたしは天にのぼり、わたしの王座を高く神の星の上におき、北の果なる集会の山に座し、"},{"ref":"Isa.14.14","start":23014014,"end":23014014,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"くも"],[13,1,"たか"],[15,1,"もの"]],"text":"雲のいただきにのぼり、いと高き者のようになろう』。"},{"ref":"Isa.14.15","start":23014015,"end":23014015,"break":"line","breaks":[[14,"line"]],"ruby":[[7,2,"よみ"],[10,1,"おと"],[14,1,"あな"],[16,2,"おくそこ"],[19,1,"い"]],"text":"しかしあなたは陰府に落され、穴の奥底に入れられる。"},{"ref":"Isa.14.16","start":23014016,"end":23014016,"break":"line","breaks":[[18,"line"],[30,"line"]],"ruby":[[4,1,"み"],[6,1,"もの"],[16,1,"み"],[22,1,"め"],[27,1,"い"],[33,1,"ひと"],[35,1,"ち"],[37,1,"ふる"],[41,2,"くにぐに"],[44,1,"うご"]],"text":"あなたを見る者はつくづくあなたを見、あなたに目をとめて言う、『この人は地を震わせ、国々を動かし、"},{"ref":"Isa.14.17","start":23014017,"end":23014017,"break":"line","breaks":[[20,"line"],[29,"line"]],"ruby":[[0,2,"せかい"],[3,2,"あらの"],[13,2,"とし"],[20,1,"とら"],[23,1,"もの"],[27,1,"いえ"],[29,1,"と"],[31,1,"かえ"],[37,1,"もの"]],"text":"世界を荒野のようにし、その都市をこわし、捕えた者をその家に解き帰さなかった者であるのか』。"},{"ref":"Isa.14.18","start":23014018,"end":23014018,"break":"line","breaks":[[12,"line"]],"ruby":[[5,1,"くに"],[7,1,"おう"],[11,1,"みな"],[12,1,"たっと"],[18,2,"じぶん"],[21,1,"はか"],[23,1,"ねむ"]],"text":"もろもろの国の王たちは皆尊いさまで、自分の墓に眠る。"},{"ref":"Isa.14.19","start":23014019,"end":23014019,"break":"line","breaks":[[23,"line"],[33,"line"],[50,"line"]],"ruby":[[7,1,"い"],[14,1,"つき"],[15,1,"た"],[18,1,"こ"],[23,1,"はか"],[28,1,"す"],[37,1,"さ"],[39,1,"ころ"],[43,1,"もの"],[50,1,"ふ"],[57,2,"したい"],[63,1,"あな"],[65,1,"いし"],[67,1,"くだ"]],"text":"しかしあなたは忌みきらわれる月足らぬ子のように墓のそとに捨てられ、つるぎで刺し殺された者でおおわれ、踏みつけられる死体のように穴の石に下る。"},{"ref":"Isa.14.20","start":23014020,"end":23014020,"break":"line","breaks":[[13,"line"],[25,"line"],[40,"line"],[53,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"くに"],[9,1,"ほろ"],[13,2,"じぶん"],[16,1,"たみ"],[18,1,"ころ"],[25,1,"かれ"],[28,1,"とも"],[30,1,"ほうむ"],[44,1,"あく"],[46,1,"おこな"],[48,1,"もの"],[50,2,"しそん"],[58,1,"な"],[60,1,"よ"]],"text":"あなたは自分の国を滅ぼし、自分の民を殺したために、彼らと共に葬られることはない。どうか、悪を行う者の子孫はとこしえに名を呼ばれることのないように。"},{"ref":"Isa.14.21","start":23014021,"end":23014021,"break":"line","breaks":[[12,"line"],[29,"line"],[43,"line"],[53,"line"]],"ruby":[[0,2,"せんぞ"],[14,2,"しそん"],[23,1,"ば"],[25,1,"そな"],[32,1,"かれ"],[35,1,"た"],[38,1,"ち"],[40,1,"と"],[43,2,"せかい"],[50,2,"まちまち"],[53,1,"み"]],"text":"先祖のよこしまのゆえに、その子孫のためにほふり場を備えよ。これは彼らが起って地を取り、世界のおもてに町々を満たすことのないためである」。"},{"ref":"Isa.14.22","start":23014022,"end":23014022,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[15,1,"た"],[18,1,"かれ"],[21,1,"せ"],[32,1,"な"],[35,1,"のこ"],[38,1,"もの"],[42,1,"こ"],[44,1,"まご"],[47,1,"た"],[49,1,"ほろ"],[54,1,"しゅ"],[56,1,"い"]],"text":"万軍の主は言われる、「わたしは立って彼らを攻め、バビロンからその名と、残れる者、その子と孫とを断ち滅ぼす、と主は言う。"},{"ref":"Isa.14.23","start":23014023,"end":23014023,"break":"none","ruby":[[19,1,"みず"],[21,1,"いけ"],[25,1,"ほろ"],[39,1,"はら"],[41,1,"のぞ"],[45,2,"ばんぐん"],[48,1,"しゅ"],[50,1,"い"]],"text":"わたしはこれをはりねずみのすみかとし、水の池とし、滅びのほうきをもって、これを払い除く、と万軍の主は言う」。"},{"ref":"Isa.14.24","start":23014024,"end":23014024,"break":"paragraph","breaks":[[13,"line"],[29,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"ちか"],[8,1,"い"],[18,1,"おも"],[24,1,"かなら"],[26,1,"な"],[33,1,"さだ"],[39,1,"かなら"],[41,1,"た"]],"text":"万軍の主は誓って言われる、「わたしが思ったように必ず成り、わたしが定めたように必ず立つ。"},{"ref":"Isa.14.25","start":23014025,"end":23014025,"break":"line","breaks":[[21,"line"],[34,"line"],[47,"line"],[59,"line"],[68,"line"]],"ruby":[[14,1,"ち"],[16,1,"う"],[18,1,"やぶ"],[23,2,"やまやま"],[26,1,"かれ"],[28,1,"ふ"],[38,1,"かれ"],[40,1,"お"],[56,1,"はな"],[59,1,"かれ"],[61,1,"お"],[65,2,"おもに"],[76,1,"かた"],[79,1,"はな"]],"text":"わたしはアッスリヤびとをわが地で打ち破り、わが山々で彼を踏みにじる。こうして彼が置いたくびきはイスラエルびとから離れ、彼が負わせた重荷はイスラエルびとの肩から離れる」。"},{"ref":"Isa.14.26","start":23014026,"end":23014026,"break":"line","breaks":[[20,"line"]],"ruby":[[3,1,"ぜん"],[4,1,"ち"],[9,1,"さだ"],[14,2,"けいかく"],[23,2,"くにぐに"],[26,1,"うえ"],[28,1,"の"],[33,1,"て"]],"text":"これは全地について定められた計画である。これは国々の上に伸ばされた手である。"},{"ref":"Isa.14.27","start":23014027,"end":23014027,"break":"line","breaks":[[13,"line"],[32,"line"],[44,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"さだ"],[19,1,"と"],[21,1,"け"],[34,1,"て"],[36,1,"の"],[50,1,"ひ"]],"text":"万軍の主が定められるとき、だれがそれを取り消すことができるのか。その手を伸ばされるとき、だれがそれを引きもどすことができるのか。"},{"ref":"Isa.14.28","start":23014028,"end":23014028,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"し"],[8,1,"ねん"],[12,2,"たくせん"]],"text":"アハズ王の死んだ年にこの託宣があった、"},{"ref":"Isa.14.29","start":23014029,"end":23014029,"break":"line","breaks":[[20,"line"],[36,"line"],[48,"line"]],"ruby":[[6,1,"ぜん"],[7,1,"ち"],[14,1,"う"],[20,1,"お"],[27,1,"よろこ"],[39,1,"ね"],[46,1,"で"],[50,1,"み"],[52,1,"と"]],"text":"「ペリシテの全地よ、あなたを打ったむちが折られたことを喜んではならない。へびの根からまむしが出、その実は飛びかけるへびとなるからだ。"},{"ref":"Isa.14.30","start":23014030,"end":23014030,"break":"line","breaks":[[11,"line"],[23,"line"],[38,"line"],[48,"line"]],"ruby":[[2,1,"まず"],[5,1,"もの"],[7,1,"しょく"],[9,1,"え"],[11,1,"とぼ"],[14,1,"もの"],[16,1,"やす"],[20,1,"ふ"],[42,2,"しそん"],[45,1,"ころ"],[52,1,"のこ"],[55,1,"もの"],[57,1,"ほろ"]],"text":"いと貧しい者は食を得、乏しい者は安らかに伏す。しかし、わたしはききんをもってあなたの子孫を殺し、あなたの残れる者を滅ぼす。"},{"ref":"Isa.14.31","start":23014031,"end":23014031,"break":"line","breaks":[[15,"line"],[36,"line"],[47,"line"]],"ruby":[[0,1,"もん"],[3,1,"な"],[9,1,"まち"],[12,1,"さけ"],[20,1,"ぜん"],[21,1,"ち"],[24,1,"おそ"],[30,1,"き"],[36,1,"きた"],[39,1,"けむり"],[41,1,"く"],[49,2,"たいれつ"],[59,2,"だつらく"],[63,1,"もの"]],"text":"門よ、泣きわめけ。町よ、叫べ。ペリシテの全地よ、恐れのあまり消えうせよ、北から煙が来るからだ。その隊列からは、ひとりも脱落する者はない」。"},{"ref":"Isa.14.32","start":23014032,"end":23014032,"break":"paragraph","breaks":[[18,"line"],[32,"line"],[41,"line"]],"ruby":[[2,1,"くに"],[4,2,"ししゃ"],[12,1,"こた"],[19,1,"しゅ"],[25,1,"もとい"],[34,1,"たみ"],[36,1,"くる"],[39,1,"もの"],[43,1,"なか"],[45,1,"さ"],[47,1,"どころ"],[49,1,"え"],[53,1,"こた"]],"text":"その国の使者たちになんと答えようか。「主はシオンの基をおかれた、その民の苦しむ者はこの中に避け所を得る」と答えよ。"}]