[{"ref":"2John.1.1","start":63001001,"end":63001001,"break":"paragraph","ruby":[[0,2,"ちょうろう"],[9,2,"しんじつ"],[12,1,"あい"],[17,1,"えら"],[21,2,"ふじん"],[26,1,"こ"],[37,1,"あい"],[55,2,"しんり"],[58,1,"し"],[63,1,"もの"]],"text":"長老のわたしから、真実に愛している選ばれた婦人とその子たちへ。あなたがたを愛しているのは、わたしだけではなく、真理を知っている者はみなそうである。"},{"ref":"2John.1.2","start":63001002,"end":63001002,"break":"none","ruby":[[18,2,"えいえん"],[21,1,"とも"],[27,2,"しんり"]],"text":"それは、わたしたちのうちにあり、また永遠に共にあるべき真理によるのである。"},{"ref":"2John.1.3","start":63001003,"end":63001003,"break":"paragraph","ruby":[[0,1,"ちち"],[3,1,"かみ"],[7,1,"ちち"],[9,2,"みこ"],[22,1,"めぐ"],[30,2,"へいあん"],[35,2,"しんり"],[38,1,"あい"],[53,1,"とも"]],"text":"父なる神および父の御子イエス・キリストから、恵みとあわれみと平安とが、真理と愛のうちにあって、わたしたちと共にあるように。"},{"ref":"2John.1.4","start":63001004,"end":63001004,"break":"paragraph","ruby":[[4,2,"こども"],[19,1,"ちち"],[22,1,"う"],[25,1,"いまし"],[32,2,"しんり"],[38,1,"ある"],[43,1,"もの"],[49,1,"み"],[56,2,"ひじょう"],[59,1,"よろこ"]],"text":"あなたの子供たちのうちで、わたしたちが父から受けた戒めどおりに、真理のうちを歩いている者があるのを見て、わたしは非常に喜んでいる。"},{"ref":"2John.1.5","start":63001005,"end":63001005,"break":"none","ruby":[[0,2,"ふじん"],[8,1,"ねが"],[23,1,"あたら"],[26,1,"いまし"],[29,1,"か"],[38,1,"はじ"],[42,1,"も"],[47,1,"いまし"],[66,1,"たがい"],[68,1,"あい"]],"text":"婦人よ。ここにお願いしたいことがある。それは、新しい戒めを書くわけではなく、初めから持っていた戒めなのであるが、わたしたちは、みんな互に愛し合おうではないか。"},{"ref":"2John.1.6","start":63001006,"end":63001006,"break":"none","ruby":[[0,1,"ちち"],[2,1,"いまし"],[8,1,"ある"],[19,1,"あい"],[30,1,"はじ"],[34,1,"き"],[43,1,"あい"],[48,1,"ある"],[59,1,"いまし"]],"text":"父の戒めどおりに歩くことが、すなわち、愛であり、あなたがたが初めから聞いてきたとおりに愛のうちを歩くことが、すなわち、戒めなのである。"},{"ref":"2John.1.7","start":63001007,"end":63001007,"break":"none","ruby":[[14,2,"にくたい"],[27,2,"こくはく"],[33,1,"ひと"],[35,1,"まど"],[38,1,"もの"],[41,1,"おお"],[43,1,"よ"],[61,1,"もの"],[64,1,"まど"],[67,1,"もの"],[72,1,"はん"]],"text":"なぜなら、イエス・キリストが肉体をとってこられたことを告白しないで人を惑わす者が、多く世にはいってきたからである。そういう者は、惑わす者であり、反キリストである。"},{"ref":"2John.1.8","start":63001008,"end":63001008,"break":"none","ruby":[[2,2,"ちゅうい"],[13,1,"はたら"],[16,1,"え"],[18,2,"せいか"],[21,1,"うしな"],[29,1,"ゆた"],[32,1,"むく"],[35,1,"う"]],"text":"よく注意して、わたしたちの働いて得た成果を失うことがなく、豊かな報いを受けられるようにしなさい。"},{"ref":"2John.1.9","start":63001009,"end":63001009,"break":"none","ruby":[[8,1,"おしえ"],[13,1,"す"],[27,1,"もの"],[30,1,"かみ"],[32,1,"も"],[45,1,"おしえ"],[54,1,"もの"],[57,1,"ちち"],[59,1,"も"],[64,2,"みこ"],[68,1,"も"]],"text":"すべてキリストの教をとおり過ごして、それにとどまらない者は、神を持っていないのである。その教にとどまっている者は、父を持ち、また御子をも持つ。"},{"ref":"2John.1.10","start":63001010,"end":63001010,"break":"none","ruby":[[2,1,"おしえ"],[4,1,"も"],[18,1,"く"],[20,1,"もの"],[28,1,"ひと"],[30,1,"いえ"],[32,1,"い"]],"text":"この教を持たずにあなたがたのところに来る者があれば、その人を家に入れることも、あいさつすることもしてはいけない。"},{"ref":"2John.1.11","start":63001011,"end":63001011,"break":"none","ruby":[[5,1,"ひと"],[13,1,"もの"],[18,1,"わる"],[20,1,"おこな"]],"text":"そのような人にあいさつする者は、その悪い行いにあずかることになるからである。"},{"ref":"2John.1.12","start":63001012,"end":63001012,"break":"paragraph","ruby":[[6,1,"か"],[22,1,"かみ"],[24,1,"すみ"],[27,1,"か"],[50,1,"い"],[53,2,"ちょくせつ"],[58,1,"あ"],[62,1,"とも"],[64,1,"よろこ"],[67,1,"み"]],"text":"あなたがたに書きおくることはたくさんあるが、紙と墨とで書くことはすまい。むしろ、あなたがたのところに行き、直接はなし合って、共に喜びに満ちあふれたいものである。"},{"ref":"2John.1.13","start":63001013,"end":63001013,"break":"none","ruby":[[0,1,"えら"],[8,2,"しまい"],[11,2,"こども"]],"text":"選ばれたあなたの姉妹の子供たちが、あなたによろしく。"}]