[{"ref":"1Cor.9.1","start":46009001,"end":46009001,"break":"paragraph","ruby":[[4,2,"じゆう"],[7,1,"もの"],[14,2,"しと"],[28,1,"しゅ"],[33,1,"み"],[48,1,"しゅ"],[56,1,"はたら"],[59,1,"み"]],"text":"わたしは自由な者ではないか。使徒ではないか。わたしたちの主イエスを見たではないか。あなたがたは、主にあるわたしの働きの実ではないか。"},{"ref":"1Cor.9.2","start":46009002,"end":46009002,"break":"none","ruby":[[8,1,"ひと"],[10,1,"たい"],[14,2,"しと"],[31,2,"しと"],[43,1,"しゅ"],[55,2,"しと"],[57,1,"しょく"],[59,1,"しるし"]],"text":"わたしは、ほかの人に対しては使徒でないとしても、あなたがたには使徒である。あなたがたが主にあることは、わたしの使徒職の印なのである。"},{"ref":"1Cor.9.3","start":46009003,"end":46009003,"break":"none","ruby":[[4,3,"ひはんしゃ"],[10,1,"たい"],[13,2,"べんめい"]],"text":"わたしの批判者たちに対する弁明は、これである。"},{"ref":"1Cor.9.4","start":46009004,"end":46009004,"break":"none","ruby":[[8,1,"の"],[10,1,"く"],[15,2,"けんり"]],"text":"わたしたちには、飲み食いをする権利がないのか。"},{"ref":"1Cor.9.5","start":46009005,"end":46009005,"break":"none","ruby":[[11,2,"しと"],[16,1,"しゅ"],[18,2,"きょうだい"],[30,2,"しんじゃ"],[35,1,"つま"],[37,1,"つ"],[40,1,"ある"],[42,2,"けんり"]],"text":"わたしたちには、ほかの使徒たちや主の兄弟たちやケパのように、信者である妻を連れて歩く権利がないのか。"},{"ref":"1Cor.9.6","start":46009006,"end":46009006,"break":"none","ruby":[[19,2,"ろうどう"],[27,2,"けんり"]],"text":"それとも、わたしとバルナバとだけには、労働をせずにいる権利がないのか。"},{"ref":"1Cor.9.7","start":46009007,"end":46009007,"break":"none","ruby":[[5,2,"じぶん"],[8,2,"ひよう"],[11,1,"だ"],[14,2,"ぐんたい"],[17,1,"くわ"],[20,1,"もの"],[30,1,"はたけ"],[32,1,"つく"],[40,1,"み"],[42,1,"た"],[46,1,"もの"],[56,1,"ひつじ"],[58,1,"か"],[66,1,"ちち"],[68,1,"の"],[72,1,"もの"]],"text":"いったい、自分で費用を出して軍隊に加わる者があろうか。ぶどう畑を作っていて、その実を食べない者があろうか。また、羊を飼っていて、その乳を飲まない者があろうか。"},{"ref":"1Cor.9.8","start":46009008,"end":46009008,"break":"none","ruby":[[5,2,"にんげん"],[8,1,"かんが"],[13,1,"い"],[21,2,"りっぽう"],[32,1,"い"]],"text":"わたしは、人間の考えでこう言うのではない。律法もまた、そのように言っているではないか。"},{"ref":"1Cor.9.9","start":46009009,"end":46009009,"break":"none","ruby":[[9,2,"りっぽう"],[14,2,"こくもつ"],[23,1,"うし"],[40,1,"か"],[46,1,"かみ"],[49,1,"うし"],[54,1,"こころ"]],"text":"すなわち、モーセの律法に、「穀物をこなしている牛に、くつこをかけてはならない」と書いてある。神は、牛のことを心にかけておられるのだろうか。"},{"ref":"1Cor.9.10","start":46009010,"end":46009010,"break":"none","ruby":[[19,1,"い"],[61,1,"たがや"],[63,1,"もの"],[65,1,"のぞ"],[71,1,"たがや"],[74,2,"こくもつ"],[80,1,"もの"],[85,1,"わ"],[87,1,"まえ"],[92,1,"のぞ"]],"text":"それとも、もっぱら、わたしたちのために言っておられるのか。もちろん、それはわたしたちのためにしるされたのである。すなわち、耕す者は望みをもって耕し、穀物をこなす者は、その分け前をもらう望みをもってこなすのである。"},{"ref":"1Cor.9.11","start":46009011,"end":46009011,"break":"none","ruby":[[18,1,"れい"],[30,1,"にく"],[42,1,"か"],[49,1,"ゆ"],[51,1,"す"]],"text":"もしわたしたちが、あなたがたのために霊のものをまいたのなら、肉のものをあなたがたから刈りとるのは、行き過ぎだろうか。"},{"ref":"1Cor.9.12","start":46009012,"end":46009012,"break":"none","ruby":[[5,2,"ひとびと"],[15,1,"たい"],[20,2,"けんり"],[66,2,"けんり"],[69,1,"り"],[70,1,"よう"],[83,2,"ふくいん"],[86,1,"さまた"],[105,1,"しの"]],"text":"もしほかの人々が、あなたがたに対するこの権利にあずかっているとすれば、わたしたちはなおさらのことではないか。しかしわたしたちは、この権利を利用せず、かえってキリストの福音の妨げにならないようにと、すべてのことを忍んでいる。"},{"ref":"1Cor.9.13","start":46009013,"end":46009013,"break":"none","ruby":[[7,2,"みやづか"],[15,1,"ひと"],[19,1,"みや"],[22,1,"さ"],[25,1,"もの"],[27,1,"た"],[30,2,"さいだん"],[33,2,"ほうし"],[39,1,"ひと"],[43,2,"さいだん"],[46,1,"そな"],[48,1,"もの"],[50,1,"わ"],[52,1,"まえ"],[62,1,"し"]],"text":"あなたがたは、宮仕えをしている人たちは宮から下がる物を食べ、祭壇に奉仕している人たちは祭壇の供え物の分け前にあずかることを、知らないのか。"},{"ref":"1Cor.9.14","start":46009014,"end":46009014,"break":"none","ruby":[[3,2,"どうよう"],[7,1,"しゅ"],[10,2,"ふくいん"],[13,1,"の"],[15,1,"つた"],[20,1,"もの"],[24,2,"ふくいん"],[30,2,"せいかつ"],[39,1,"さだ"]],"text":"それと同様に、主は、福音を宣べ伝えている者たちが福音によって生活すべきことを、定められたのである。"},{"ref":"1Cor.9.15","start":46009015,"end":46009015,"break":"paragraph","ruby":[[12,2,"けんり"],[18,1,"り"],[19,1,"よう"],[29,2,"じぶん"],[49,1,"か"],[66,1,"し"],[68,1,"ほう"],[82,1,"ほこり"],[85,2,"なにもの"],[89,1,"うば"],[91,1,"さ"]],"text":"しかしわたしは、これらの権利を一つも利用しなかった。また、自分がそうしてもらいたいから、このように書くのではない。そうされるよりは、死ぬ方がましである。わたしのこの誇は、何者にも奪い去られてはならないのだ。"},{"ref":"1Cor.9.16","start":46009016,"end":46009016,"break":"none","ruby":[[4,2,"ふくいん"],[7,1,"の"],[9,1,"つた"],[17,1,"ほこり"],[53,2,"ふくいん"],[56,1,"の"],[58,1,"つた"]],"text":"わたしが福音を宣べ伝えても、それは誇にはならない。なぜなら、わたしは、そうせずにはおれないからである。もし福音を宣べ伝えないなら、わたしはわざわいである。"},{"ref":"1Cor.9.17","start":46009017,"end":46009017,"break":"none","ruby":[[0,1,"すす"],[10,2,"ほうしゅう"],[13,1,"う"],[25,1,"すす"],[50,1,"つとめ"]],"text":"進んでそれをすれば、報酬を受けるであろう。しかし、進んでしないとしても、それは、わたしにゆだねられた務なのである。"},{"ref":"1Cor.9.18","start":46009018,"end":46009018,"break":"none","ruby":[[7,2,"ほうしゅう"],[17,2,"ふくいん"],[20,1,"の"],[22,1,"つた"],[30,1,"む"],[31,2,"だいか"],[34,2,"ていきょう"],[42,3,"せんきょうしゃ"],[48,1,"も"],[50,2,"けんり"],[53,1,"り"],[54,1,"よう"]],"text":"それでは、その報酬はなんであるか。福音を宣べ伝えるのにそれを無代価で提供し、わたしが宣教者として持つ権利を利用しないことである。"},{"ref":"1Cor.9.19","start":46009019,"end":46009019,"break":"paragraph","ruby":[[9,1,"ひと"],[11,1,"たい"],[14,2,"じゆう"],[26,1,"おお"],[29,1,"ひと"],[31,1,"え"],[37,1,"みずか"],[39,1,"すす"],[46,1,"ひと"],[48,2,"どれい"]],"text":"わたしは、すべての人に対して自由であるが、できるだけ多くの人を得るために、自ら進んですべての人の奴隷になった。"},{"ref":"1Cor.9.20","start":46009020,"end":46009020,"break":"none","ruby":[[3,1,"じん"],[10,1,"じん"],[22,1,"じん"],[24,1,"え"],[32,2,"りっぽう"],[35,1,"もと"],[39,1,"ひと"],[46,2,"じしん"],[49,2,"りっぽう"],[52,1,"もと"],[59,2,"りっぽう"],[62,1,"もと"],[66,1,"もの"],[75,2,"りっぽう"],[78,1,"もと"],[82,1,"ひと"],[84,1,"え"]],"text":"ユダヤ人には、ユダヤ人のようになった。ユダヤ人を得るためである。律法の下にある人には、わたし自身は律法の下にはないが、律法の下にある者のようになった。律法の下にある人を得るためである。"},{"ref":"1Cor.9.21","start":46009021,"end":46009021,"break":"none","ruby":[[0,2,"りっぽう"],[5,1,"ひと"],[14,1,"かみ"],[16,2,"りっぽう"],[19,1,"そと"],[34,2,"りっぽう"],[37,1,"なか"],[46,2,"りっぽう"],[51,1,"ひと"],[60,2,"りっぽう"],[65,1,"ひと"],[67,1,"え"]],"text":"律法のない人には――わたしは神の律法の外にあるのではなく、キリストの律法の中にあるのだが――律法のない人のようになった。律法のない人を得るためである。"},{"ref":"1Cor.9.22","start":46009022,"end":46009022,"break":"none","ruby":[[0,1,"よわ"],[2,1,"ひと"],[5,1,"よわ"],[7,1,"もの"],[13,1,"よわ"],[15,1,"ひと"],[17,1,"え"],[29,1,"ひと"],[31,1,"たい"],[40,1,"ひと"],[55,2,"いくにん"],[59,1,"すく"]],"text":"弱い人には弱い者になった。弱い人を得るためである。すべての人に対しては、すべての人のようになった。なんとかして幾人かを救うためである。"},{"ref":"1Cor.9.23","start":46009023,"end":46009023,"break":"none","ruby":[[0,2,"ふくいん"],[14,1,"こと"],[24,1,"とも"],[26,2,"ふくいん"]],"text":"福音のために、わたしはどんな事でもする。わたしも共に福音にあずかるためである。"},{"ref":"1Cor.9.24","start":46009024,"end":46009024,"break":"paragraph","ruby":[[6,1,"し"],[13,3,"きょうぎじょう"],[17,1,"はし"],[19,1,"もの"],[24,1,"はし"],[31,1,"しょう"],[33,1,"え"],[35,1,"もの"],[53,1,"しょう"],[55,1,"え"],[60,1,"はし"]],"text":"あなたがたは知らないのか。競技場で走る者は、みな走りはするが、賞を得る者はひとりだけである。あなたがたも、賞を得るように走りなさい。"},{"ref":"1Cor.9.25","start":46009025,"end":46009025,"break":"none","ruby":[[7,2,"きょうぎ"],[12,1,"もの"],[15,1,"なに"],[20,2,"せっせい"],[26,1,"かれ"],[29,1,"く"],[32,1,"かんむり"],[34,1,"え"],[51,1,"く"],[55,1,"かんむり"],[57,1,"え"]],"text":"しかし、すべて競技をする者は、何ごとにも節制をする。彼らは朽ちる冠を得るためにそうするが、わたしたちは朽ちない冠を得るためにそうするのである。"},{"ref":"1Cor.9.26","start":46009026,"end":46009026,"break":"none","ruby":[[8,2,"もくひょう"],[21,1,"はし"],[23,1,"かた"],[28,1,"くう"],[30,1,"う"],[35,2,"けんとう"]],"text":"そこで、わたしは目標のはっきりしないような走り方をせず、空を打つような拳闘はしない。"},{"ref":"1Cor.9.27","start":46009027,"end":46009027,"break":"none","ruby":[[5,2,"じぶん"],[12,1,"う"],[18,2,"ふくじゅう"],[38,1,"ひと"],[40,1,"の"],[42,1,"つた"],[51,2,"じぶん"],[54,3,"しっかくしゃ"],[62,1,"し"]],"text":"すなわち、自分のからだを打ちたたいて服従させるのである。そうしないと、ほかの人に宣べ伝えておきながら、自分は失格者になるかも知れない。"}]