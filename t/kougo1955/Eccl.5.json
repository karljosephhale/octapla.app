[{"ref":"Eccl.5.1","start":21005001,"end":21005001,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"みや"],[4,1,"ゆ"],[6,1,"とき"],[12,1,"あし"],[14,1,"つつし"],[20,1,"ちか"],[24,1,"き"],[28,1,"おろ"],[31,1,"もの"],[33,2,"ぎせい"],[46,1,"かれ"],[49,1,"あく"],[51,1,"おこな"],[59,1,"し"]],"text":"神の宮に行く時には、その足を慎むがよい。近よって聞くのは愚かな者の犠牲をささげるのにまさる。彼らは悪を行っていることを知らないからである。"},{"ref":"Eccl.5.2","start":21005002,"end":21005002,"break":"none","ruby":[[0,1,"かみ"],[2,1,"まえ"],[4,2,"かるがる"],[8,1,"くち"],[16,2,"ことば"],[19,1,"だ"],[24,1,"こころ"],[36,1,"かみ"],[38,1,"てん"],[48,1,"ち"],[67,2,"ことば"],[70,1,"すく"]],"text":"神の前で軽々しく口をひらき、また言葉を出そうと、心にあせってはならない。神は天にいまし、あなたは地におるからである。それゆえ、あなたは言葉を少なくせよ。"},{"ref":"Eccl.5.3","start":21005003,"end":21005003,"break":"paragraph","ruby":[[0,1,"ゆめ"],[2,2,"しごと"],[5,1,"おお"],[17,1,"おろ"],[21,1,"もの"],[23,1,"こえ"],[25,2,"ことば"],[28,1,"おお"],[36,1,"し"]],"text":"夢は仕事の多いことによってきたり、愚かなる者の声は言葉の多いことによって知られる。"},{"ref":"Eccl.5.4","start":21005004,"end":21005004,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"ちか"],[17,1,"はた"],[22,1,"の"],[32,1,"かみ"],[34,1,"おろ"],[37,1,"もの"],[39,1,"よろこ"],[54,1,"ちか"],[60,1,"かなら"],[62,1,"はた"]],"text":"あなたは神に誓いをなすとき、それを果すことを延ばしてはならない。神は愚かな者を喜ばれないからである。あなたの誓ったことを必ず果せ。"},{"ref":"Eccl.5.5","start":21005005,"end":21005005,"break":"none","ruby":[[4,1,"ちか"],[13,1,"はた"],[24,1,"ちか"]],"text":"あなたが誓いをして、それを果さないよりは、むしろ誓いをしないほうがよい。"},{"ref":"Eccl.5.6","start":21005006,"end":21005006,"break":"none","ruby":[[4,1,"くち"],[11,1,"つみ"],[13,1,"おか"],[26,2,"ししゃ"],[29,1,"まえ"],[34,1,"あやま"],[41,1,"い"],[55,1,"かみ"],[61,2,"ことば"],[64,1,"いか"],[71,1,"て"],[76,1,"ほろ"]],"text":"あなたの口が、あなたに罪を犯させないようにせよ。また使者の前にそれは誤りであったと言ってはならない。どうして、神があなたの言葉を怒り、あなたの手のわざを滅ぼしてよかろうか。"},{"ref":"Eccl.5.7","start":21005007,"end":21005007,"break":"paragraph","ruby":[[0,1,"ゆめ"],[2,1,"おお"],[6,1,"くう"],[9,2,"ことば"],[12,1,"おお"],[23,1,"かみ"],[25,1,"おそ"]],"text":"夢が多ければ空なる言葉も多い。しかし、あなたは神を恐れよ。"},{"ref":"Eccl.5.8","start":21005008,"end":21005008,"break":"paragraph","ruby":[[4,1,"くに"],[9,1,"まず"],[12,1,"もの"],[19,2,"こうどう"],[22,2,"せいぎ"],[25,1,"ま"],[35,1,"み"],[41,1,"こと"],[43,1,"あや"],[56,1,"くらい"],[58,1,"たか"],[60,1,"ひと"],[68,1,"たか"],[70,1,"もの"],[78,1,"ひと"],[101,1,"たか"],[103,1,"もの"]],"text":"あなたは国のうちに貧しい者をしえたげ、公道と正義を曲げることのあるのを見ても、その事を怪しんではならない。それは位の高い人よりも、さらに高い者があって、その人をうかがうからである。そしてそれらよりもなお高い者がある。"},{"ref":"Eccl.5.9","start":21005009,"end":21005009,"break":"none","ruby":[[4,1,"よう"],[8,2,"こうさく"],[12,2,"たはた"],[17,1,"くに"],[20,1,"おう"],[22,2,"りえき"]],"text":"しかし、要するに耕作した田畑をもつ国には王は利益である。"},{"ref":"Eccl.5.10","start":21005010,"end":21005010,"break":"paragraph","ruby":[[0,2,"きんせん"],[3,1,"この"],[5,1,"もの"],[7,2,"きんせん"],[13,2,"まんぞく"],[19,1,"とみ"],[21,1,"この"],[23,1,"もの"],[25,1,"とみ"],[27,1,"え"],[29,2,"まんぞく"],[40,1,"くう"]],"text":"金銭を好む者は金銭をもって満足しない。富を好む者は富を得て満足しない。これもまた空である。"},{"ref":"Eccl.5.11","start":21005011,"end":21005011,"break":"paragraph","ruby":[[0,2,"ざいさん"],[3,1,"ま"],[10,1,"く"],[12,1,"もの"],[14,1,"ま"],[19,1,"も"],[21,1,"ぬし"],[23,1,"め"],[28,1,"み"],[37,1,"えき"]],"text":"財産が増せば、これを食う者も増す。その持ち主は目にそれを見るだけで、なんの益があるか。"},{"ref":"Eccl.5.12","start":21005012,"end":21005012,"break":"paragraph","ruby":[[0,1,"はたら"],[2,1,"もの"],[4,1,"た"],[10,1,"すく"],[15,1,"おお"],[20,1,"こころよ"],[22,1,"ねむ"],[28,1,"あ"],[30,1,"た"],[36,1,"とみ"],[39,1,"かれ"],[41,1,"ねむ"]],"text":"働く者は食べることが少なくても多くても、快く眠る。しかし飽き足りるほどの富は、彼に眠ることをゆるさない。"},{"ref":"Eccl.5.13","start":21005013,"end":21005013,"break":"paragraph","ruby":[[4,1,"ひ"],[6,1,"した"],[8,1,"かな"],[13,1,"あく"],[19,1,"み"],[27,1,"とみ"],[39,1,"も"],[41,1,"ぬし"],[43,1,"がい"],[45,1,"およ"]],"text":"わたしは日の下に悲しむべき悪のあるのを見た。すなわち、富はこれをたくわえるその持ち主に害を及ぼすことである。"},{"ref":"Eccl.5.14","start":21005014,"end":21005014,"break":"none","ruby":[[4,1,"とみ"],[6,2,"ふこう"],[9,3,"できごと"],[18,1,"い"],[32,1,"ひと"],[34,1,"こ"],[42,1,"かれ"],[44,1,"て"],[47,1,"なに"],[49,1,"のこ"]],"text":"またその富は不幸な出来事によってうせ行くことである。それで、その人が子をもうけても、彼の手には何も残らない。"},{"ref":"Eccl.5.15","start":21005015,"end":21005015,"break":"none","ruby":[[0,1,"かれ"],[2,1,"はは"],[4,1,"たい"],[7,1,"で"],[19,1,"はだか"],[21,1,"で"],[28,1,"かえ"],[31,1,"い"],[34,1,"かれ"],[38,2,"ろうく"],[44,1,"え"],[46,1,"なに"],[47,1,"もの"],[52,1,"て"],[54,1,"たずさ"],[56,1,"い"]],"text":"彼は母の胎から出てきたように、すなわち裸で出てきたように帰って行く。彼はその労苦によって得た何物をもその手に携え行くことができない。"},{"ref":"Eccl.5.16","start":21005016,"end":21005016,"break":"none","ruby":[[0,1,"ひと"],[2,1,"まった"],[6,1,"き"],[14,1,"さ"],[17,1,"い"],[33,1,"かな"],[38,1,"あく"],[43,1,"かぜ"],[48,1,"ろう"],[51,1,"もの"],[56,1,"えき"]],"text":"人は全くその来たように、また去って行かなければならない。これもまた悲しむべき悪である。風のために労する者になんの益があるか。"},{"ref":"Eccl.5.17","start":21005017,"end":21005017,"break":"none","ruby":[[0,1,"ひと"],[2,2,"いっしょう"],[5,1,"くら"],[10,1,"かな"],[15,1,"おお"],[18,1,"なや"],[22,1,"やまい"],[25,1,"いきどお"],[28,1,"なか"]],"text":"人は一生、暗やみと、悲しみと、多くの悩みと、病と、憤りの中にある。"},{"ref":"Eccl.5.18","start":21005018,"end":21005018,"break":"paragraph","ruby":[[0,1,"み"],[7,1,"み"],[13,1,"ぜん"],[16,1,"び"],[19,1,"こと"],[22,1,"かみ"],[25,1,"たま"],[29,1,"みじか"],[31,2,"いっしょう"],[34,1,"あいだ"],[36,1,"く"],[39,1,"の"],[44,1,"ひ"],[46,1,"した"],[48,1,"ろう"],[55,2,"ろうく"],[62,1,"たの"],[66,1,"え"],[68,1,"こと"],[78,1,"ぶん"]],"text":"見よ、わたしが見たところの善かつ美なる事は、神から賜わった短い一生の間、食い、飲み、かつ日の下で労するすべての労苦によって、楽しみを得る事である。これがその分だからである。"},{"ref":"Eccl.5.19","start":21005019,"end":21005019,"break":"none","ruby":[[2,1,"かみ"],[8,1,"ひと"],[10,1,"とみ"],[12,1,"たから"],[18,1,"たの"],[21,1,"ちから"],[23,1,"あた"],[30,1,"ぶん"],[32,1,"と"],[38,2,"ろうく"],[44,1,"たの"],[48,1,"え"],[58,1,"かみ"],[60,2,"たまもの"]],"text":"また神はすべての人に富と宝と、それを楽しむ力を与え、またその分を取らせ、その労苦によって楽しみを得させられる。これが神の賜物である。"},{"ref":"Eccl.5.20","start":21005020,"end":21005020,"break":"none","ruby":[[5,1,"ひと"],[7,2,"じぶん"],[10,1,"い"],[13,1,"ひ"],[18,1,"おお"],[20,1,"おも"],[25,1,"かみ"],[27,1,"よろこ"],[33,1,"かれ"],[35,1,"こころ"],[37,1,"み"]],"text":"このような人は自分の生きる日のことを多く思わない。神は喜びをもって彼の心を満たされるからである。"}]