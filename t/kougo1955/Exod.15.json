[{"ref":"Exod.15.1","start":2015001,"end":2015001,"break":"paragraph","breaks":[[41,"stanza"],[56,"line"],[71,"line"]],"ruby":[[13,2,"ひとびと"],[19,1,"うた"],[21,1,"しゅ"],[27,1,"うた"],[31,1,"かれ"],[34,1,"うた"],[37,1,"い"],[42,1,"しゅ"],[52,1,"うた"],[56,1,"かれ"],[58,1,"かがや"],[63,1,"か"],[66,1,"え"],[71,1,"かれ"],[73,1,"うま"],[75,1,"の"],[77,1,"て"],[79,1,"うみ"],[81,1,"な"],[83,1,"こ"]],"text":"そこでモーセとイスラエルの人々は、この歌を主にむかって歌った。彼らは歌って言った、「主にむかってわたしは歌おう、彼は輝かしくも勝ちを得られた、彼は馬と乗り手を海に投げ込まれた。"},{"ref":"Exod.15.2","start":2015002,"end":2015002,"break":"line","breaks":[[22,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ちから"],[9,1,"うた"],[15,1,"すくい"],[22,1,"かれ"],[29,1,"かみ"],[35,1,"かれ"],[42,1,"かれ"],[48,1,"ちち"],[50,1,"かみ"],[56,1,"かれ"]],"text":"主はわたしの力また歌、わたしの救となられた、彼こそわたしの神、わたしは彼をたたえる、彼はわたしの父の神、わたしは彼をあがめる。"},{"ref":"Exod.15.3","start":2015003,"end":2015003,"break":"line","ruby":[[0,1,"しゅ"],[10,1,"な"],[12,1,"しゅ"]],"text":"主はいくさびと、その名は主。"},{"ref":"Exod.15.4","start":2015004,"end":2015004,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かれ"],[5,2,"せんしゃ"],[10,2,"ぐんぜい"],[14,1,"うみ"],[16,1,"な"],[18,1,"こ"],[29,3,"しきしゃ"],[35,2,"こうかい"],[38,1,"しず"]],"text":"彼はパロの戦車とその軍勢とを海に投げ込まれた、そのすぐれた指揮者たちは紅海に沈んだ。"},{"ref":"Exod.15.5","start":2015005,"end":2015005,"break":"line","ruby":[[0,2,"おおみず"],[3,1,"かれ"],[10,1,"かれ"],[13,1,"いし"],[18,1,"ふち"],[20,1,"くだ"]],"text":"大水は彼らをおおい、彼らは石のように淵に下った。"},{"ref":"Exod.15.6","start":2015006,"end":2015006,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"みぎ"],[9,1,"て"],[11,1,"ちから"],[16,2,"えいこう"],[24,1,"しゅ"],[31,1,"みぎ"],[33,1,"て"],[35,1,"てき"],[37,1,"う"],[39,1,"くだ"]],"text":"主よ、あなたの右の手は力をもって栄光にかがやく、主よ、あなたの右の手は敵を打ち砕く。"},{"ref":"Exod.15.7","start":2015007,"end":2015007,"break":"line","breaks":[[15,"line"],[33,"line"],[47,"line"]],"ruby":[[4,1,"おお"],[8,2,"いこう"],[19,1,"た"],[24,1,"もの"],[26,1,"う"],[28,1,"やぶ"],[37,1,"いか"],[40,1,"はっ"],[47,1,"かれ"],[57,1,"や"]],"text":"あなたは大いなる威光をもって、あなたに立ちむかう者を打ち破られた。あなたが怒りを発せられると、彼らは、わらのように焼きつくされた。"},{"ref":"Exod.15.8","start":2015008,"end":2015008,"break":"line","breaks":[[20,"line"],[31,"line"]],"ruby":[[4,1,"はな"],[6,1,"いき"],[11,1,"みず"],[13,1,"つ"],[20,1,"なが"],[23,1,"つつみ"],[28,1,"た"],[31,2,"おおみず"],[34,1,"うみ"],[40,1,"こ"],[42,1,"かた"]],"text":"あなたの鼻の息によって水は積みかさなり、流れは堤となって立ち、大水は海のもなかに凝り固まった。"},{"ref":"Exod.15.9","start":2015009,"end":2015009,"break":"line","breaks":[[22,"line"],[33,"line"],[51,"line"]],"ruby":[[0,1,"てき"],[2,1,"い"],[11,1,"お"],[13,1,"い"],[16,1,"お"],[18,1,"つ"],[22,2,"ぶんどり"],[24,1,"もの"],[26,1,"わ"],[29,1,"と"],[37,2,"よくぼう"],[40,1,"かれ"],[46,1,"み"],[55,1,"ぬ"],[63,1,"て"],[65,1,"かれ"],[68,1,"ほろ"]],"text":"敵は言った、『わたしは追い行き、追い着いて、分捕物を分かち取ろう、わたしの欲望を彼らによって満たそう、つるぎを抜こう、わたしの手は彼らを滅ぼそう』。"},{"ref":"Exod.15.10","start":2015010,"end":2015010,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"いき"],[6,1,"ふ"],[12,1,"うみ"],[14,1,"かれ"],[21,1,"かれ"],[24,1,"なまり"],[30,2,"おおみず"],[33,1,"なか"],[35,1,"しず"]],"text":"あなたが息を吹かれると、海は彼らをおおい、彼らは鉛のように、大水の中に沈んだ。"},{"ref":"Exod.15.11","start":2015011,"end":2015011,"break":"line","breaks":[[24,"line"],[46,"line"],[59,"line"]],"ruby":[[0,1,"しゅ"],[3,2,"かみがみ"],[16,1,"くら"],[35,1,"せい"],[39,1,"さか"],[52,1,"おそ"],[66,1,"おこな"]],"text":"主よ、神々のうち、だれがあなたに比べられようか、だれがあなたのように、聖にして栄えあるもの、ほむべくして恐るべきもの、くすしきわざを行うものであろうか。"},{"ref":"Exod.15.12","start":2015012,"end":2015012,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"みぎ"],[6,1,"て"],[8,1,"の"],[15,1,"ち"],[17,1,"かれ"]],"text":"あなたが右の手を伸べられると、地は彼らをのんだ。"},{"ref":"Exod.15.13","start":2015013,"end":2015013,"break":"line","breaks":[[22,"line"]],"ruby":[[11,1,"たみ"],[13,1,"めぐ"],[19,1,"みちび"],[23,1,"ちから"],[33,1,"せい"],[40,1,"ともな"]],"text":"あなたは、あがなわれた民を恵みをもって導き、み力をもって、あなたの聖なるすまいに伴われた。"},{"ref":"Exod.15.14","start":2015014,"end":2015014,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"たみ"],[7,1,"き"],[10,1,"ふる"],[18,2,"じゅうみん"],[21,1,"くる"],[25,1,"おそ"]],"text":"もろもろの民は聞いて震え、ペリシテの住民は苦しみに襲われた。"},{"ref":"Exod.15.15","start":2015015,"end":2015015,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[4,2,"ぞくちょう"],[18,2,"しゅちょう"],[32,2,"じゅうみん"],[38,1,"と"],[40,1,"さ"]],"text":"エドムの族長らは、おどろき、モアブの首長らは、わななき、カナンの住民は、みな溶け去った。"},{"ref":"Exod.15.16","start":2015016,"end":2015016,"break":"line","breaks":[[16,"line"],[39,"line"],[56,"line"]],"ruby":[[0,1,"おそ"],[10,1,"かれ"],[13,1,"のぞ"],[17,1,"うで"],[19,1,"おお"],[27,1,"かれ"],[30,1,"いし"],[35,1,"もく"],[39,1,"しゅ"],[46,1,"たみ"],[48,1,"とお"],[60,1,"か"],[66,1,"たみ"],[68,1,"とお"]],"text":"恐れと、おののきとは彼らに臨み、み腕の大いなるゆえに、彼らは石のように黙した、主よ、あなたの民の通りすぎるまで、あなたが買いとられた民の通りすぎるまで。"},{"ref":"Exod.15.17","start":2015017,"end":2015017,"break":"line","breaks":[[11,"line"],[26,"line"],[44,"line"],[54,"line"]],"ruby":[[4,1,"かれ"],[7,1,"みちび"],[15,1,"し"],[16,1,"ぎょう"],[18,1,"やま"],[20,1,"う"],[26,1,"しゅ"],[48,1,"つく"],[52,1,"ところ"],[54,1,"しゅ"],[58,1,"て"],[63,1,"た"],[68,2,"せいじょ"]],"text":"あなたは彼らを導いて、あなたの嗣業の山に植えられる。主よ、これこそあなたのすまいとして、みずから造られた所、主よ、み手によって建てられた聖所。"},{"ref":"Exod.15.18","start":2015018,"end":2015018,"break":"line","ruby":[[0,1,"しゅ"],[2,2,"えいえん"],[5,1,"す"],[7,1,"おさ"]],"text":"主は永遠に統べ治められる」。"},{"ref":"Exod.15.19","start":2015019,"end":2015019,"break":"none","ruby":[[3,1,"うま"],[8,2,"せんしゃ"],[13,2,"きへい"],[16,1,"とも"],[18,1,"うみ"],[25,1,"しゅ"],[27,1,"うみ"],[29,1,"みず"],[31,1,"かれ"],[34,1,"うえ"],[36,1,"なが"],[38,1,"かえ"],[51,2,"ひとびと"],[54,1,"うみ"],[56,1,"なか"],[62,1,"ち"],[64,1,"おこな"]],"text":"パロの馬が、その戦車および騎兵と共に海にはいると、主は海の水を彼らの上に流れ返らされたが、イスラエルの人々は海の中のかわいた地を行った。"},{"ref":"Exod.15.20","start":2015020,"end":2015020,"break":"none","ruby":[[9,1,"あね"],[11,1,"おんな"],[12,3,"よげんしゃ"],[26,1,"て"],[28,1,"と"],[31,1,"おんな"],[35,1,"みな"],[42,1,"と"],[46,1,"おど"],[57,1,"したが"],[60,1,"で"]],"text":"そのとき、アロンの姉、女預言者ミリアムはタンバリンを手に取り、女たちも皆タンバリンを取って、踊りながら、そのあとに従って出てきた。"},{"ref":"Exod.15.21","start":2015021,"end":2015021,"break":"none","breaks":[[18,"stanza"],[28,"line"],[43,"line"]],"ruby":[[8,1,"かれ"],[11,1,"わ"],[14,1,"うた"],[19,1,"しゅ"],[25,1,"うた"],[28,1,"かれ"],[30,1,"かがや"],[35,1,"か"],[38,1,"え"],[43,1,"かれ"],[45,1,"うま"],[47,1,"の"],[49,1,"て"],[51,1,"うみ"],[53,1,"な"],[55,1,"こ"]],"text":"そこでミリアムは彼らに和して歌った、「主にむかって歌え、彼は輝かしくも勝ちを得られた、彼は馬と乗り手を海に投げ込まれた」。"},{"ref":"Exod.15.22","start":2015022,"end":2015022,"break":"paragraph","ruby":[[13,2,"こうかい"],[17,2,"たびだ"],[23,1,"かれ"],[30,2,"あらの"],[33,1,"い"],[37,1,"か"],[42,2,"あらの"],[45,1,"ある"],[50,1,"みず"],[52,1,"え"]],"text":"さて、モーセはイスラエルを紅海から旅立たせた。彼らはシュルの荒野に入り、三日のあいだ荒野を歩いたが、水を得なかった。"},{"ref":"Exod.15.23","start":2015023,"end":2015023,"break":"none","ruby":[[0,1,"かれ"],[6,1,"つ"],[14,1,"みず"],[16,1,"にが"],[19,1,"の"],[37,1,"ところ"],[39,1,"な"],[44,1,"よ"]],"text":"彼らはメラに着いたが、メラの水は苦くて飲むことができなかった。それで、その所の名はメラと呼ばれた。"},{"ref":"Exod.15.24","start":2015024,"end":2015024,"break":"none","ruby":[[4,1,"たみ"],[15,1,"い"],[26,1,"なに"],[28,1,"の"]],"text":"ときに、民はモーセにつぶやいて言った、「わたしたちは何を飲むのですか」。"},{"ref":"Exod.15.25","start":2015025,"end":2015025,"break":"none","breaks":[[46,"paragraph"]],"ruby":[[4,1,"しゅ"],[6,1,"さけ"],[10,1,"しゅ"],[12,1,"かれ"],[15,1,"ぽん"],[17,1,"き"],[19,1,"しめ"],[29,1,"みず"],[31,1,"な"],[33,1,"い"],[38,1,"みず"],[40,1,"あま"],[48,1,"ところ"],[50,1,"しゅ"],[52,1,"たみ"],[57,1,"さだ"],[65,1,"た"],[70,1,"かれ"],[73,1,"こころ"]],"text":"モーセは主に叫んだ。主は彼に一本の木を示されたので、それを水に投げ入れると、水は甘くなった。その所で主は民のために定めと、おきてを立てられ、彼らを試みて、"},{"ref":"Exod.15.26","start":2015026,"end":2015026,"break":"none","ruby":[[0,1,"い"],[17,1,"かみ"],[19,1,"しゅ"],[21,1,"こえ"],[23,1,"よ"],[25,1,"き"],[27,1,"したが"],[32,1,"め"],[34,1,"ただ"],[38,1,"み"],[45,1,"おこな"],[50,1,"いまし"],[53,1,"みみ"],[55,1,"かたむ"],[62,1,"さだ"],[65,1,"まも"],[86,1,"くだ"],[89,1,"やまい"],[98,1,"くだ"],[111,1,"しゅ"]],"text":"言われた、「あなたが、もしあなたの神、主の声に良く聞き従い、その目に正しいと見られることを行い、その戒めに耳を傾け、すべての定めを守るならば、わたしは、かつてエジプトびとに下した病を一つもあなたに下さないであろう。わたしは主であって、あなたをいやすものである」。"},{"ref":"Exod.15.27","start":2015027,"end":2015027,"break":"paragraph","ruby":[[4,1,"かれ"],[11,1,"つ"],[19,1,"みず"],[21,1,"いずみ"],[32,1,"き"],[35,1,"ぽん"],[43,1,"ところ"],[45,1,"かれ"],[48,1,"みず"],[54,2,"しゅくえい"]],"text":"こうして彼らはエリムに着いた。そこには水の泉十二と、なつめやしの木七十本があった。その所で彼らは水のほとりに宿営した。"}]