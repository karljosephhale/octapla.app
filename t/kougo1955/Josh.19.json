[{"ref":"Josh.19.1","start":6019001,"end":6019001,"break":"paragraph","ruby":[[0,1,"つぎ"],[19,2,"しそん"],[22,2,"ぶぞく"],[31,2,"かぞく"],[43,1,"ひ"],[49,1,"し"],[50,1,"ぎょう"],[55,2,"しそん"],[58,1,"し"],[59,1,"ぎょう"]],"text":"次にシメオンのため、すなわちシメオンの子孫の部族のために、その家族にしたがって、くじを引いた。その嗣業はユダの子孫の嗣業のうちにあった。"},{"ref":"Josh.19.2","start":6019002,"end":6019002,"break":"none","ruby":[[2,1,"し"],[3,1,"ぎょう"],[7,1,"え"]],"text":"その嗣業として獲たものは、ベエルシバ、すなわちシバ、モラダ、"},{"ref":"Josh.19.3","start":6019003,"end":6019003,"break":"none","text":"ハザル・シュアル、バラ、エゼム、"},{"ref":"Josh.19.4","start":6019004,"end":6019004,"break":"none","text":"エルトラデ、ベトル、ホルマ、"},{"ref":"Josh.19.5","start":6019005,"end":6019005,"break":"none","text":"チクラグ、ベテ・マルカボテ、ハザルスサ、"},{"ref":"Josh.19.6","start":6019006,"end":6019006,"break":"none","ruby":[[20,2,"まちまち"],[27,1,"ぞく"],[30,2,"むらむら"]],"text":"ベテレバオテ、シャルヘン。すなわち十三の町々と、それに属する村々。"},{"ref":"Josh.19.7","start":6019007,"end":6019007,"break":"none","ruby":[[27,2,"まちまち"],[34,1,"ぞく"],[37,2,"むらむら"]],"text":"またアイン、リンモン、エテル、アシャン。すなわち四つの町々と、それに属する村々。"},{"ref":"Josh.19.8","start":6019008,"end":6019008,"break":"none","ruby":[[7,1,"まち"],[9,2,"しゅうい"],[36,1,"いた"],[45,2,"むらむら"],[56,2,"しそん"],[59,2,"ぶぞく"],[65,2,"かぞく"],[73,1,"え"],[75,1,"し"],[76,1,"ぎょう"]],"text":"およびこれらの町の周囲にあって、バアラテ・ベエル、すなわちネゲブのラマに至るまでのすべての村々。これがシメオンの子孫の部族の、その家族にしたがって獲た嗣業である。"},{"ref":"Josh.19.9","start":6019009,"end":6019009,"break":"none","ruby":[[5,2,"しそん"],[8,1,"し"],[9,1,"ぎょう"],[15,2,"しそん"],[18,2,"りょういき"],[34,2,"しそん"],[37,1,"ぶん"],[39,1,"おお"],[52,2,"しそん"],[58,1,"し"],[59,1,"ぎょう"],[61,1,"かれ"],[64,1,"し"],[65,1,"ぎょう"],[67,1,"なか"],[69,1,"え"]],"text":"シメオンの子孫の嗣業は、ユダの子孫の領域のうちにあった。これはユダの子孫の分が大きかったので、シメオンの子孫が、その嗣業を彼らの嗣業の中に獲たからである。"},{"ref":"Josh.19.10","start":6019010,"end":6019010,"break":"paragraph","ruby":[[0,1,"だい"],[8,2,"しそん"],[17,2,"かぞく"],[29,1,"ひ"],[35,1,"し"],[36,1,"ぎょう"],[38,2,"りょういき"],[45,1,"およ"]],"text":"第三にゼブルンの子孫のために、その家族にしたがって、くじを引いた。その嗣業の領域はサリデに及び、"},{"ref":"Josh.19.11","start":6019011,"end":6019011,"break":"none","ruby":[[2,1,"さかい"],[4,1,"にし"],[6,1,"のぼ"],[14,1,"いた"],[22,1,"たっ"],[31,1,"ひがし"],[35,1,"かわ"],[37,1,"たっ"]],"text":"その境は西に上って、マララに至り、ダバセテに達し、ヨクネアムの東にある川に達し、"},{"ref":"Josh.19.12","start":6019012,"end":6019012,"break":"none","ruby":[[6,1,"ひがし"],[8,1,"ほう"],[10,1,"ひ"],[12,1,"で"],[14,1,"ほう"],[16,1,"まが"],[28,1,"さかい"],[30,1,"いた"],[38,1,"で"],[45,1,"のぼ"]],"text":"サリデから、東の方、日の出の方に曲り、キスロテ・タボルの境に至り、ダベラテに出て、ヤピアに上り、"},{"ref":"Josh.19.13","start":6019013,"end":6019013,"break":"none","ruby":[[4,1,"ひがし"],[6,1,"ほう"],[8,1,"ひ"],[10,1,"で"],[12,1,"ほう"],[14,1,"すす"],[32,1,"いた"],[40,1,"すす"],[47,1,"ほう"],[49,1,"まが"]],"text":"そこから東の方、日の出の方に進んで、ガテヘペルとイッタ・カジンに至り、リンモンに進んで、ネアの方に曲る。"},{"ref":"Josh.19.14","start":6019014,"end":6019014,"break":"none","ruby":[[0,1,"きた"],[5,1,"さかい"],[13,1,"まわ"],[22,1,"たに"],[24,1,"いた"],[27,1,"つ"]],"text":"北ではその境はハンナトンに回り、イフタエルの谷に至って尽きる。"},{"ref":"Josh.19.15","start":6019015,"end":6019015,"break":"none","ruby":[[32,2,"まちまち"],[39,1,"ぞく"],[42,2,"むらむら"]],"text":"そしてカッタテ、ナハラル、シムロン、イダラ、ベツレヘムなど十二の町々と、それに属する村々があった。"},{"ref":"Josh.19.16","start":6019016,"end":6019016,"break":"none","ruby":[[8,2,"しそん"],[14,2,"かぞく"],[22,1,"え"],[24,1,"し"],[25,1,"ぎょう"],[33,2,"まちまち"],[40,1,"ぞく"],[43,2,"むらむら"]],"text":"これがゼブルンの子孫の、その家族にしたがって獲た嗣業であって、その町々と、それに属する村々とである。"},{"ref":"Josh.19.17","start":6019017,"end":6019017,"break":"paragraph","ruby":[[0,1,"だい"],[19,2,"しそん"],[28,2,"かぞく"],[40,1,"ひ"]],"text":"第四にイッサカル、すなわちイッサカルの子孫のために、その家族にしたがって、くじを引いた。"},{"ref":"Josh.19.18","start":6019018,"end":6019018,"break":"none","ruby":[[2,2,"りょういき"]],"text":"その領域には、エズレル、ケスロテ、シュネム、"},{"ref":"Josh.19.19","start":6019019,"end":6019019,"break":"none","text":"ハパライム、シオン、アナハラテ、"},{"ref":"Josh.19.20","start":6019020,"end":6019020,"break":"none","text":"ラビテ、キション、エベツ、"},{"ref":"Josh.19.21","start":6019021,"end":6019021,"break":"none","text":"レメテ、エンガンニム、エンハダ、ベテパッゼズがあり、"},{"ref":"Josh.19.22","start":6019022,"end":6019022,"break":"none","ruby":[[2,1,"さかい"],[20,1,"たっ"],[25,1,"さかい"],[32,1,"いた"],[35,1,"つ"],[42,2,"まちまち"],[49,1,"ぞく"],[52,2,"むらむら"]],"text":"その境はタボル、シャハヂマ、ベテシメシに達し、その境はヨルダンに至って尽きる。十六の町々と、それに属する村々があった。"},{"ref":"Josh.19.23","start":6019023,"end":6019023,"break":"none","ruby":[[9,2,"しそん"],[12,2,"ぶぞく"],[18,2,"かぞく"],[26,1,"え"],[28,1,"し"],[29,1,"ぎょう"],[37,2,"まちまち"],[44,1,"ぞく"],[47,2,"むらむら"]],"text":"これがイッサカルの子孫の部族の、その家族にしたがって獲た嗣業であって、その町々と、それに属する村々とである。"},{"ref":"Josh.19.24","start":6019024,"end":6019024,"break":"paragraph","ruby":[[0,1,"だい"],[8,2,"しそん"],[11,2,"ぶぞく"],[20,2,"かぞく"],[32,1,"ひ"]],"text":"第五に、アセルの子孫の部族のために、その家族にしたがって、くじを引いた。"},{"ref":"Josh.19.25","start":6019025,"end":6019025,"break":"none","ruby":[[2,2,"りょういき"]],"text":"その領域には、ヘルカテ、ハリ、ベテン、アクサフ、"},{"ref":"Josh.19.26","start":6019026,"end":6019026,"break":"none","ruby":[[21,1,"さかい"],[23,1,"にし"],[41,1,"たっ"]],"text":"アランメレク、アマデ、ミシャルがあり、その境は西では、カルメルとシホル・リブナテに達し、"},{"ref":"Josh.19.27","start":6019027,"end":6019027,"break":"none","ruby":[[4,1,"ひがし"],[6,1,"お"],[16,1,"いた"],[19,1,"きた"],[21,1,"ほう"],[34,1,"たに"],[36,1,"たっ"],[52,1,"いた"],[55,1,"きた"]],"text":"それから東に折れて、ベテダゴンに至り、北の方ゼブルンと、イプタエルの谷に達し、ベテエメクおよびネイエルに至り、北はカブルにいで、"},{"ref":"Josh.19.28","start":6019028,"end":6019028,"break":"none","ruby":[[0,1,"さら"],[19,1,"へ"],[22,1,"だい"],[27,1,"およ"]],"text":"更にエブロン、レホブ、ハンモン、カナを経て、大シドンに及び、"},{"ref":"Josh.19.29","start":6019029,"end":6019029,"break":"none","ruby":[[7,1,"さかい"],[12,1,"まが"],[15,2,"けんご"],[18,1,"まち"],[22,1,"いた"],[29,1,"さかい"],[34,1,"まが"],[37,1,"うみ"],[39,1,"いた"],[42,1,"つ"]],"text":"それから、その境はラマに曲り、堅固な町ツロに至る。またその境はホサに曲り、海に至って尽きる。そして、マハラブ、アクジブ、"},{"ref":"Josh.19.30","start":6019030,"end":6019030,"break":"none","ruby":[[18,2,"まちまち"],[25,1,"ぞく"],[28,2,"むらむら"]],"text":"ウンマ、アペク、レホブなど、二十二の町々と、それに属する村々があった。"},{"ref":"Josh.19.31","start":6019031,"end":6019031,"break":"none","ruby":[[7,2,"しそん"],[10,2,"ぶぞく"],[16,2,"かぞく"],[24,1,"え"],[26,1,"し"],[27,1,"ぎょう"],[35,2,"まちまち"],[42,1,"ぞく"],[45,2,"むらむら"]],"text":"これがアセルの子孫の部族の、その家族にしたがって獲た嗣業であって、その町々と、それに属する村々とである。"},{"ref":"Josh.19.32","start":6019032,"end":6019032,"break":"paragraph","ruby":[[0,1,"だい"],[9,2,"しそん"],[18,2,"かぞく"],[30,1,"ひ"]],"text":"第六に、ナフタリの子孫のために、その家族にしたがって、くじを引いた。"},{"ref":"Josh.19.33","start":6019033,"end":6019033,"break":"none","ruby":[[2,1,"さかい"],[24,1,"き"],[27,1,"おこ"],[46,1,"へ"],[53,1,"いた"],[61,1,"いた"],[64,1,"つ"]],"text":"その境はヘレフから、すなわちザアナニイムのかしの木から起り、アダミ・ネケブおよび、ヤブネルを経て、ラクムに至り、ヨルダンに至って尽きる。"},{"ref":"Josh.19.34","start":6019034,"end":6019034,"break":"none","ruby":[[5,1,"さかい"],[7,1,"にし"],[9,1,"む"],[23,1,"いた"],[35,1,"で"],[38,1,"みなみ"],[45,1,"せっ"],[48,1,"にし"],[54,1,"せっ"],[57,1,"ひがし"],[67,1,"たっ"]],"text":"そしてその境は西に向かって、アズノテ・タボルに至り、そこからホッコクに出る。南はゼブルンに接し、西はアセルに接し、東はヨルダンのユダに達する。"},{"ref":"Josh.19.35","start":6019035,"end":6019035,"break":"none","ruby":[[2,2,"けんご"],[5,2,"まちまち"]],"text":"その堅固な町々は、ヂデム、ゼル、ハンマテ、ラッカテ、キンネレテ、"},{"ref":"Josh.19.36","start":6019036,"end":6019036,"break":"none","text":"アダマ、ラマ、ハゾル、"},{"ref":"Josh.19.37","start":6019037,"end":6019037,"break":"none","text":"ケデシ、エデレイ、エンハゾル、"},{"ref":"Josh.19.38","start":6019038,"end":6019038,"break":"none","ruby":[[33,2,"まちまち"],[40,1,"ぞく"],[43,2,"むらむら"]],"text":"イロン、ミグダルエル、ホレム、ベテアナテ、ベテシメシなどで、十九の町々と、それに属する村々があった。"},{"ref":"Josh.19.39","start":6019039,"end":6019039,"break":"none","ruby":[[8,2,"しそん"],[11,2,"ぶぞく"],[17,2,"かぞく"],[25,1,"え"],[27,1,"し"],[28,1,"ぎょう"],[36,2,"まちまち"],[43,1,"ぞく"],[46,2,"むらむら"]],"text":"これがナフタリの子孫の部族が、その家族にしたがって獲た嗣業であって、その町々と、それに属する村々とである。"},{"ref":"Josh.19.40","start":6019040,"end":6019040,"break":"paragraph","ruby":[[0,1,"だい"],[7,2,"しそん"],[10,2,"ぶぞく"],[19,2,"かぞく"],[31,1,"ひ"]],"text":"第七に、ダンの子孫の部族のために、その家族にしたがって、くじを引いた。"},{"ref":"Josh.19.41","start":6019041,"end":6019041,"break":"none","ruby":[[2,1,"し"],[3,1,"ぎょう"],[5,2,"りょういき"]],"text":"その嗣業の領域には、ゾラ、エシタオル、イルシメシ、"},{"ref":"Josh.19.42","start":6019042,"end":6019042,"break":"none","text":"シャラビム、アヤロン、イテラ、"},{"ref":"Josh.19.43","start":6019043,"end":6019043,"break":"none","text":"エロン、テムナ、エクロン、"},{"ref":"Josh.19.44","start":6019044,"end":6019044,"break":"none","text":"エルテケ、ギベトン、バアラテ、"},{"ref":"Josh.19.45","start":6019045,"end":6019045,"break":"none","text":"エホデ、ベネベラク、ガテリンモン、"},{"ref":"Josh.19.46","start":6019046,"end":6019046,"break":"none","ruby":[[18,2,"あいたい"],[22,2,"ちいき"]],"text":"メヤルコン、ラッコン、およびヨッパと相対する地域があった。"},{"ref":"Josh.19.47","start":6019047,"end":6019047,"break":"none","ruby":[[7,2,"しそん"],[10,2,"りょういき"],[14,1,"かれ"],[20,1,"ちい"],[31,2,"しそん"],[35,1,"のぼ"],[38,1,"い"],[45,1,"せ"],[51,1,"と"],[61,1,"う"],[63,1,"ほろ"],[70,1,"え"],[75,1,"す"],[78,2,"せんぞ"],[83,1,"な"],[98,1,"な"]],"text":"ただし、ダンの子孫の領域は、彼らのために小さかったので、ダンの子孫は、上って行き、レセムを攻めてそれを取り、つるぎにかけて撃ち滅ぼし、それを獲てそこに住み、先祖ダンの名にしたがって、レセムをダンと名づけた。"},{"ref":"Josh.19.48","start":6019048,"end":6019048,"break":"none","ruby":[[6,2,"しそん"],[9,2,"ぶぞく"],[15,2,"かぞく"],[23,1,"え"],[25,1,"し"],[26,1,"ぎょう"],[34,2,"まちまち"],[41,1,"ぞく"],[44,2,"むらむら"]],"text":"これがダンの子孫の部族の、その家族にしたがって獲た嗣業であって、その町々と、それに属する村々とである。"},{"ref":"Josh.19.49","start":6019049,"end":6019049,"break":"paragraph","ruby":[[4,1,"くに"],[6,2,"かくち"],[10,1,"し"],[11,1,"ぎょう"],[15,1,"わ"],[17,1,"あた"],[23,1,"おわ"],[35,2,"ひとびと"],[39,2,"じぶん"],[51,1,"し"],[52,1,"ぎょう"],[58,1,"こ"],[64,1,"あた"]],"text":"こうして国の各地域を嗣業として分け与えることを終ったとき、イスラエルの人々は、自分たちのうちに、一つの嗣業を、ヌンの子ヨシュアに与えた。"},{"ref":"Josh.19.50","start":6019050,"end":6019050,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"いのち"],[9,1,"したが"],[13,1,"かれ"],[15,1,"もと"],[18,1,"まち"],[20,1,"あた"],[34,2,"さんち"],[51,1,"かれ"],[55,1,"まち"],[57,1,"た"],[67,1,"す"]],"text":"すなわち、主の命に従って、彼が求めた町を与えたが、それはエフライムの山地にあるテムナテ・セラであって、彼はその町を建てなおして、そこに住んだ。"},{"ref":"Josh.19.51","start":6019051,"end":6019051,"break":"paragraph","ruby":[[5,2,"さいし"],[16,1,"こ"],[31,2,"しそん"],[34,2,"ぶぞく"],[37,2,"ぞくちょう"],[49,2,"かいけん"],[52,2,"まくや"],[55,2,"いりぐち"],[59,1,"しゅ"],[61,1,"まえ"],[67,1,"ひ"],[70,1,"わ"],[72,1,"あた"],[75,1,"し"],[76,1,"ぎょう"],[85,1,"ち"],[87,1,"わ"],[93,1,"おわ"]],"text":"これらは、祭司エレアザル、ヌンの子ヨシュア、およびイスラエルの子孫の部族の族長たちが、シロにおいて会見の幕屋の入口で、主の前に、くじを引いて分け与えた嗣業である。こうして地を分けることを終った。"}]