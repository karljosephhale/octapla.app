[{"ref":"Rev.9.1","start":66009001,"end":66009001,"break":"paragraph","ruby":[[0,1,"だい"],[3,2,"みつかい"],[11,1,"ふ"],[13,1,"な"],[29,1,"ほし"],[31,1,"てん"],[34,1,"ち"],[36,1,"お"],[39,1,"く"],[43,1,"み"],[48,1,"ほし"],[51,1,"そこ"],[52,1,"し"],[55,1,"ところ"],[57,1,"あな"],[59,1,"ひら"],[64,1,"あた"]],"text":"第五の御使が、ラッパを吹き鳴らした。するとわたしは、一つの星が天から地に落ちて来るのを見た。この星に、底知れぬ所の穴を開くかぎが与えられた。"},{"ref":"Rev.9.2","start":66009002,"end":66009002,"break":"none","ruby":[[6,1,"そこ"],[7,1,"し"],[10,1,"ところ"],[12,1,"あな"],[14,1,"ひら"],[25,1,"あな"],[28,1,"けむり"],[30,1,"おお"],[33,1,"ろ"],[35,1,"けむり"],[40,1,"た"],[48,1,"あな"],[50,1,"けむり"],[53,2,"たいよう"],[56,2,"くうき"],[59,1,"くら"]],"text":"そして、この底知れぬ所の穴が開かれた。すると、その穴から煙が大きな炉の煙のように立ちのぼり、その穴の煙で、太陽も空気も暗くなった。"},{"ref":"Rev.9.3","start":66009003,"end":66009003,"break":"none","ruby":[[2,1,"けむり"],[4,1,"なか"],[12,2,"ちじょう"],[15,1,"で"],[21,1,"ち"],[27,1,"も"],[35,1,"ちから"],[38,1,"かれ"],[41,1,"あた"]],"text":"その煙の中から、いなごが地上に出てきたが、地のさそりが持っているような力が、彼らに与えられた。"},{"ref":"Rev.9.4","start":66009004,"end":66009004,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ち"],[6,1,"くさ"],[12,2,"あおくさ"],[21,1,"き"],[35,1,"ひたい"],[37,1,"かみ"],[39,1,"いん"],[43,1,"ひと"],[48,1,"がい"],[50,1,"くわ"],[58,1,"い"],[60,1,"わた"]],"text":"彼らは、地の草やすべての青草、またすべての木をそこなってはならないが、額に神の印がない人たちには害を加えてもよいと、言い渡された。"},{"ref":"Rev.9.5","start":66009005,"end":66009005,"break":"none","ruby":[[0,1,"かれ"],[4,2,"にんげん"],[7,1,"ころ"],[19,1,"げつ"],[24,1,"くる"],[33,1,"ゆる"],[38,1,"かれ"],[41,1,"あた"],[44,2,"くつう"],[48,1,"ひと"],[58,1,"とき"],[63,2,"くつう"]],"text":"彼らは、人間を殺すことはしないで、五か月のあいだ苦しめることだけが許された。彼らの与える苦痛は、人がさそりにさされる時のような苦痛であった。"},{"ref":"Rev.9.6","start":66009006,"end":66009006,"break":"none","ruby":[[2,1,"とき"],[6,2,"ひとびと"],[9,1,"し"],[11,1,"もと"],[15,1,"あた"],[21,1,"し"],[26,1,"ねが"],[31,1,"し"],[33,1,"に"],[36,1,"い"]],"text":"その時には、人々は死を求めても与えられず、死にたいと願っても、死は逃げて行くのである。"},{"ref":"Rev.9.7","start":66009007,"end":66009007,"break":"none","ruby":[[9,2,"しゅつじん"],[12,2,"ようい"],[22,1,"うま"],[26,1,"に"],[33,1,"あたま"],[36,1,"きん"],[38,1,"かんむり"],[51,1,"かお"],[53,2,"にんげん"],[56,1,"かお"]],"text":"これらのいなごは、出陣の用意のととのえられた馬によく似ており、その頭には金の冠のようなものをつけ、その顔は人間の顔のようであり、"},{"ref":"Rev.9.8","start":66009008,"end":66009008,"break":"none","ruby":[[8,1,"け"],[10,1,"おんな"],[23,1,"は"],[28,1,"は"]],"text":"また、そのかみの毛は女のかみのようであり、その歯はししの歯のようであった。"},{"ref":"Rev.9.9","start":66009009,"end":66009009,"break":"none","ruby":[[3,1,"てつ"],[5,2,"むねあて"],[11,2,"むねあて"],[22,1,"はね"],[24,1,"おと"],[27,1,"うま"],[29,1,"ひ"],[33,2,"せんじょう"],[36,1,"いそ"],[38,1,"おお"],[41,2,"せんしゃ"],[44,1,"ひび"]],"text":"また、鉄の胸当のような胸当をつけており、その羽の音は、馬に引かれて戦場に急ぐ多くの戦車の響きのようであった。"},{"ref":"Rev.9.10","start":66009010,"end":66009010,"break":"none","ruby":[[2,1,"うえ"],[11,1,"お"],[13,1,"はり"],[16,1,"も"],[24,1,"お"],[30,1,"げつ"],[35,2,"にんげん"],[42,1,"ちから"]],"text":"その上、さそりのような尾と針とを持っている。その尾には、五か月のあいだ人間をそこなう力がある。"},{"ref":"Rev.9.11","start":66009011,"end":66009011,"break":"none","ruby":[[0,1,"かれ"],[4,1,"そこ"],[5,1,"し"],[8,1,"ところ"],[10,1,"つかい"],[12,1,"おう"],[24,1,"な"],[29,1,"ご"],[36,1,"い"],[43,1,"ご"],[52,1,"い"]],"text":"彼らは、底知れぬ所の使を王にいただいており、その名をヘブル語でアバドンと言い、ギリシヤ語ではアポルオンと言う。"},{"ref":"Rev.9.12","start":66009012,"end":66009012,"break":"paragraph","ruby":[[0,1,"だい"],[9,1,"す"],[11,1,"さ"],[15,1,"み"],[20,1,"のち"],[32,1,"く"]],"text":"第一のわざわいは、過ぎ去った。見よ、この後、なお二つのわざわいが来る。"},{"ref":"Rev.9.13","start":66009013,"end":66009013,"break":"paragraph","ruby":[[0,1,"だい"],[3,2,"みつかい"],[11,1,"ふ"],[13,1,"な"],[25,1,"こえ"],[28,1,"かみ"],[36,1,"きん"],[38,2,"さいだん"],[44,1,"つの"],[47,1,"で"]],"text":"第六の御使が、ラッパを吹き鳴らした。すると、一つの声が、神のみまえにある金の祭壇の四つの角から出て、"},{"ref":"Rev.9.14","start":66009014,"end":66009014,"break":"none","ruby":[[4,1,"も"],[9,1,"だい"],[12,2,"みつかい"],[17,1,"よ"],[29,1,"き"],[34,1,"だい"],[40,1,"がわ"],[54,1,"にん"],[56,2,"みつかい"],[60,1,"と"]],"text":"ラッパを持っている第六の御使にこう呼びかけるのを、わたしは聞いた。「大ユウフラテ川のほとりにつながれている四人の御使を、解いてやれ」。"},{"ref":"Rev.9.15","start":66009015,"end":66009015,"break":"none","ruby":[[6,1,"とき"],[10,1,"ひ"],[14,1,"つき"],[18,1,"とし"],[20,1,"そな"],[28,1,"にん"],[30,2,"みつかい"],[34,2,"にんげん"],[38,1,"ぶん"],[42,1,"ころ"],[48,1,"と"],[50,1,"はな"]],"text":"すると、その時、その日、その月、その年に備えておかれた四人の御使が、人間の三分の一を殺すために、解き放たれた。"},{"ref":"Rev.9.16","start":66009016,"end":66009016,"break":"none","ruby":[[0,3,"きへいたい"],[4,1,"かず"],[7,1,"おく"],[19,1,"かず"],[21,1,"き"]],"text":"騎兵隊の数は二億であった。わたしはその数を聞いた。"},{"ref":"Rev.9.17","start":66009017,"end":66009017,"break":"none","ruby":[[9,1,"なか"],[16,1,"うま"],[21,1,"の"],[26,1,"もの"],[31,1,"み"],[35,1,"の"],[40,1,"もの"],[45,1,"ひ"],[47,1,"いろ"],[49,3,"せいぎょくしょく"],[53,2,"いおう"],[56,1,"いろ"],[58,2,"むねあて"],[75,1,"うま"],[77,1,"あたま"],[82,1,"あたま"],[93,1,"くち"],[96,1,"ひ"],[98,1,"けむり"],[100,2,"いおう"],[105,1,"で"]],"text":"そして、まぼろしの中で、それらの馬とそれに乗っている者たちとを見ると、乗っている者たちは、火の色と青玉色と硫黄の色の胸当をつけていた。そして、それらの馬の頭はししの頭のようであって、その口から火と煙と硫黄とが、出ていた。"},{"ref":"Rev.9.18","start":66009018,"end":66009018,"break":"none","ruby":[[5,2,"さいがい"],[13,1,"かれ"],[16,1,"くち"],[19,1,"で"],[21,1,"く"],[23,1,"ひ"],[25,1,"けむり"],[27,2,"いおう"],[35,2,"にんげん"],[39,1,"ぶん"],[43,1,"ころ"]],"text":"この三つの災害、すなわち、彼らの口から出て来る火と煙と硫黄とによって、人間の三分の一は殺されてしまった。"},{"ref":"Rev.9.19","start":66009019,"end":66009019,"break":"none","ruby":[[0,1,"うま"],[2,1,"ちから"],[6,1,"くち"],[8,1,"お"],[16,1,"お"],[21,1,"に"],[29,1,"あたま"],[36,1,"あたま"],[38,1,"ひと"],[40,1,"がい"],[42,1,"くわ"]],"text":"馬の力はその口と尾とにある。その尾はへびに似ていて、それに頭があり、その頭で人に害を加えるのである。"},{"ref":"Rev.9.20","start":66009020,"end":66009020,"break":"none","ruby":[[4,2,"さいがい"],[7,1,"ころ"],[12,1,"のこ"],[15,2,"ひとびと"],[19,2,"じぶん"],[22,1,"て"],[24,1,"つく"],[34,1,"く"],[36,1,"あらた"],[46,2,"あくれい"],[54,1,"きん"],[56,1,"ぎん"],[58,1,"どう"],[60,1,"いし"],[62,1,"き"],[64,1,"つく"],[68,1,"み"],[73,1,"き"],[78,1,"ある"],[87,2,"ぐうぞう"],[90,2,"れいはい"]],"text":"これらの災害で殺されずに残った人々は、自分の手で造ったものについて、悔い改めようとせず、また悪霊のたぐいや、金、銀、銅、石、木で造られ、見ることも聞くことも歩くこともできない偶像を礼拝して、やめようともしなかった。"},{"ref":"Rev.9.21","start":66009021,"end":66009021,"break":"none","ruby":[[3,1,"かれ"],[9,1,"おか"],[12,2,"さつじん"],[22,3,"ふひんこう"],[27,1,"ぬす"],[30,1,"く"],[32,1,"あらた"]],"text":"また、彼らは、その犯した殺人や、まじないや、不品行や、盗みを悔い改めようとしなかった。"}]