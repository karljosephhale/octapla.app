[{"ref":"1Sam.19.1","start":9019001,"end":9019001,"break":"paragraph","ruby":[[6,1,"こ"],[18,2,"けらい"],[27,1,"ころ"],[33,1,"い"],[44,1,"こ"],[50,1,"ふか"],[56,1,"あい"]],"text":"サウルはその子ヨナタンおよびすべての家来たちにダビデを殺すようにと言った。しかしサウルの子ヨナタンは深くダビデを愛していた。"},{"ref":"1Sam.19.2","start":9019002,"end":9019002,"break":"none","ruby":[[9,1,"い"],[14,1,"ちち"],[23,1,"ころ"],[40,1,"あさ"],[42,1,"き"],[53,2,"ばしょ"],[56,1,"み"],[58,1,"かく"]],"text":"ヨナタンはダビデに言った、「父サウルはあなたを殺そうとしています。それゆえあすの朝、気をつけて、わからない場所に身を隠していてください。"},{"ref":"1Sam.19.3","start":9019003,"end":9019003,"break":"none","ruby":[[4,1,"で"],[6,1,"い"],[16,2,"のはら"],[19,1,"ちち"],[26,1,"た"],[29,1,"ちち"],[38,1,"はな"],[49,1,"なに"],[64,1,"つ"]],"text":"わたしは出て行って、あなたがいる野原で父のかたわらに立ち、父にあなたのことを話しましょう。そして、何かわたしにわかれば、あなたに告げましょう」。"},{"ref":"1Sam.19.4","start":9019004,"end":9019004,"break":"none","ruby":[[5,1,"ちち"],[20,1,"い"],[25,1,"おう"],[31,2,"けらい"],[37,1,"たい"],[40,1,"つみ"],[42,1,"おか"],[52,1,"かれ"],[59,1,"つみ"],[61,1,"おか"],[67,1,"かれ"]],"text":"ヨナタンは父サウルにダビデのことをほめて言った、「王よ、どうか家来ダビデに対して罪を犯さないでください。彼は、あなたに罪を犯さず、また彼のしたことは、あなたのためになることでした。"},{"ref":"1Sam.19.5","start":9019005,"end":9019005,"break":"none","ruby":[[0,1,"かれ"],[2,1,"いのち"],[17,1,"ころ"],[20,1,"しゅ"],[28,2,"ひとびと"],[31,1,"おお"],[35,2,"しょうり"],[38,1,"あた"],[54,1,"み"],[56,1,"よろこ"],[83,1,"ころ"],[86,1,"つみ"],[89,1,"もの"],[91,1,"ち"],[93,1,"なが"],[96,1,"つみ"],[98,1,"おか"]],"text":"彼は命をかけて、あのペリシテびとを殺し、主はイスラエルの人々に大いなる勝利を与えられたのです。あなたはそれを見て喜ばれました。それであるのに、どうしてゆえなくダビデを殺し、罪なき者の血を流して罪を犯そうとされるのですか」。"},{"ref":"1Sam.19.6","start":9019006,"end":9019006,"break":"none","ruby":[[9,2,"ことば"],[12,1,"き"],[25,1,"ちか"],[30,1,"しゅ"],[32,1,"い"],[44,1,"けっ"],[47,1,"かれ"],[49,1,"ころ"]],"text":"サウルはヨナタンの言葉を聞きいれた。そしてサウルは誓った、「主は生きておられる。わたしは決して彼を殺さない」。"},{"ref":"1Sam.19.7","start":9019007,"end":9019007,"break":"none","ruby":[[9,1,"よ"],[25,1,"つ"],[48,1,"つ"],[71,1,"まえ"]],"text":"ヨナタンはダビデを呼んでこれらのことをみなダビデに告げた。そしてヨナタンがダビデをサウルのもとに連れてきたので、ダビデは、もとのようにサウルの前にいた。"},{"ref":"1Sam.19.8","start":9019008,"end":9019008,"break":"paragraph","ruby":[[6,2,"せんそう"],[18,1,"で"],[27,1,"たたか"],[30,1,"おお"],[33,1,"かれ"],[36,1,"ころ"],[42,1,"かれ"],[47,1,"まえ"],[50,1,"に"],[52,1,"さ"]],"text":"ところがまた戦争がおこって、ダビデは出てペリシテびとと戦い、大いに彼らを殺したので、彼らはその前から逃げ去った。"},{"ref":"1Sam.19.9","start":9019009,"end":9019009,"break":"none","ruby":[[6,1,"いえ"],[10,1,"て"],[15,1,"も"],[24,1,"とき"],[26,1,"しゅ"],[29,1,"く"],[31,2,"あくれい"],[38,1,"のぞ"],[48,1,"こと"]],"text":"さてサウルが家にいて手にやりを持ってすわっていた時、主から来る悪霊がサウルに臨んだので、ダビデは琴をひいていたが、"},{"ref":"1Sam.19.10","start":9019010,"end":9019010,"break":"none","ruby":[[16,1,"かべ"],[18,1,"さ"],[20,1,"とお"],[30,1,"かれ"],[36,1,"まえ"],[38,1,"み"],[50,1,"かべ"],[66,1,"に"],[68,1,"さ"]],"text":"サウルはそのやりをもってダビデを壁に刺し通そうとした。しかし彼はサウルの前に身をかわしたので、やりは壁につきささった。そしてダビデは逃げ去った。"},{"ref":"1Sam.19.11","start":9019011,"end":9019011,"break":"paragraph","ruby":[[2,1,"よる"],[12,1,"いえ"],[14,2,"ししゃ"],[24,2,"みは"],[31,1,"あさ"],[36,1,"かれ"],[38,1,"ころ"],[54,1,"つま"],[63,1,"い"],[70,2,"こんや"],[81,2,"じぶん"],[84,1,"いのち"],[86,1,"すく"],[97,1,"ころ"]],"text":"その夜、サウルはダビデの家に使者たちをつかわして見張りをさせ、朝になって彼を殺させようとした。しかしダビデの妻ミカルはダビデに言った、「もし今夜のうちに、あなたが自分の命を救わないならば、あすは殺されるでしょう」。"},{"ref":"1Sam.19.12","start":9019012,"end":9019012,"break":"none","ruby":[[11,1,"まど"],[23,1,"かれ"],[25,1,"に"],[27,1,"さ"]],"text":"そしてミカルがダビデを窓からつりおろしたので、彼は逃げ去った。"},{"ref":"1Sam.19.13","start":9019013,"end":9019013,"break":"none","ruby":[[7,1,"ぞう"],[13,2,"ねどこ"],[16,1,"うえ"],[18,1,"よこ"],[24,1,"あたま"],[29,1,"け"],[31,1,"あみ"],[36,2,"きもの"]],"text":"ミカルは一つの像をとって、寝床の上に横たえ、その頭にやぎの毛の網をかけ、着物をもってそれをおおった。"},{"ref":"1Sam.19.14","start":9019014,"end":9019014,"break":"none","ruby":[[8,1,"とら"],[13,2,"ししゃ"],[25,2,"かのじょ"],[28,1,"い"],[35,1,"ひと"],[37,2,"びょうき"]],"text":"サウルはダビデを捕えるため使者たちをつかわしたが、彼女は言った、「あの人は病気です」。"},{"ref":"1Sam.19.15","start":9019015,"end":9019015,"break":"none","ruby":[[12,1,"み"],[18,2,"ししゃ"],[28,1,"い"],[33,1,"かれ"],[35,2,"ねどこ"],[45,1,"ところ"],[47,1,"つ"],[59,1,"かれ"],[61,1,"ころ"]],"text":"そこでサウルは、ダビデを見させようと使者たちをつかわして言った、「彼を寝床のまま、わたしの所に連れてきなさい。わたしが彼を殺そう」。"},{"ref":"1Sam.19.16","start":9019016,"end":9019016,"break":"none","ruby":[[0,2,"ししゃ"],[9,1,"み"],[13,2,"ねどこ"],[17,1,"ぞう"],[19,1,"よこ"],[29,1,"あたま"],[36,1,"け"],[38,1,"あみ"]],"text":"使者たちがはいって見ると、寝床には像が横たえてあって、その頭には、やぎの毛の網がかけてあった。"},{"ref":"1Sam.19.17","start":9019017,"end":9019017,"break":"none","ruby":[[8,1,"い"],[31,1,"あざむ"],[39,1,"てき"],[41,1,"に"],[57,1,"こた"],[64,1,"ひと"],[71,1,"に"],[88,1,"ころ"],[92,1,"い"]],"text":"サウルはミカルに言った、「あなたはどうして、このようにわたしを欺いて、わたしの敵を逃がしたのか」。ミカルはサウルに答えた、「あの人はわたしに『逃がしてくれ。さもないと、おまえを殺す』と言いました」。"},{"ref":"1Sam.19.18","start":9019018,"end":9019018,"break":"paragraph","ruby":[[4,1,"に"],[6,1,"さ"],[22,1,"い"],[30,2,"じぶん"],[42,1,"かれ"],[44,1,"つ"],[60,1,"い"],[67,1,"す"]],"text":"ダビデは逃げ去り、ラマにいるサムエルのもとへ行って、サウルが自分にしたすべてのことを彼に告げた。そしてダビデとサムエルは行ってナヨテに住んだ。"},{"ref":"1Sam.19.19","start":9019019,"end":9019019,"break":"none","ruby":[[2,1,"ひと"],[25,1,"つ"]],"text":"ある人がサウルに「ダビデはラマのナヨテにいます」と告げたので、"},{"ref":"1Sam.19.20","start":9019020,"end":9019020,"break":"none","ruby":[[9,1,"とら"],[16,2,"ししゃ"],[27,1,"かれ"],[30,3,"よげんしゃ"],[34,2,"いちぐん"],[37,2,"よげん"],[63,1,"た"],[70,1,"み"],[76,1,"とき"],[78,1,"かみ"],[80,1,"れい"],[86,2,"ししゃ"],[92,1,"のぞ"],[96,1,"かれ"],[101,2,"よげん"]],"text":"サウルは、ダビデを捕えるために、使者たちをつかわした。彼らは預言者の一群が預言していて、サムエルが、そのうちの、かしらとなって立っているのを見たが、その時、神の霊はサウルの使者たちにも臨んで、彼らもまた預言した。"},{"ref":"1Sam.19.21","start":9019021,"end":9019021,"break":"none","ruby":[[10,1,"き"],[14,1,"た"],[16,2,"ししゃ"],[28,1,"かれ"],[33,2,"よげん"],[45,2,"ししゃ"],[57,1,"かれ"],[62,2,"よげん"]],"text":"サウルは、このことを聞いて、他の使者たちをつかわしたが、彼らもまた預言した。サウルは三たび使者たちをつかわしたが、彼らもまた預言した。"},{"ref":"1Sam.19.22","start":9019022,"end":9019022,"break":"none","ruby":[[14,1,"い"],[20,3,"おおいど"],[24,1,"つ"],[27,1,"とき"],[29,1,"と"],[32,1,"い"],[59,1,"ひと"],[61,1,"こた"],[66,1,"かれ"]],"text":"そこでサウルはみずからラマに行き、セクの大井戸に着いた時、問うて言った、「サムエルとダビデは、どこにおるか」。ひとりの人が答えた、「彼らはラマのナヨテにいます」。"},{"ref":"1Sam.19.23","start":9019023,"end":9019023,"break":"none","ruby":[[18,1,"い"],[23,1,"かみ"],[25,1,"れい"],[29,1,"かれ"],[32,1,"のぞ"],[36,1,"かれ"],[45,1,"つ"],[49,1,"ある"],[54,2,"よげん"]],"text":"そこでサウルはそこからラマのナヨテに行ったが、神の霊はまた彼にも臨んで、彼はラマのナヨテに着くまで歩きながら預言した。"},{"ref":"1Sam.19.24","start":9019024,"end":9019024,"break":"none","ruby":[[3,1,"かれ"],[7,2,"きもの"],[10,1,"ぬ"],[14,1,"おな"],[24,1,"まえ"],[26,2,"よげん"],[31,1,"にち"],[33,1,"や"],[35,1,"はだか"],[37,1,"たお"],[39,1,"ふ"],[45,2,"ひとびと"],[55,3,"よげんしゃ"]],"text":"そして彼もまた着物を脱いで、同じようにサムエルの前で預言し、一日一夜、裸で倒れ伏していた。人々が「サウルもまた預言者たちのうちにいるのか」というのはこのためである。"}]