[{"ref":"2Chr.11.1","start":14011001,"end":14011001,"break":"paragraph","ruby":[[12,1,"き"],[24,1,"いえ"],[26,1,"もの"],[35,1,"ぬ"],[38,2,"ぐんじん"],[43,1,"にん"],[45,1,"あつ"],[48,1,"くに"],[50,1,"と"],[64,1,"たたか"]],"text":"レハベアムはエルサレムに来て、ユダとベニヤミンの家の者、すなわち、えり抜きの軍人十八万人を集め、国を取りもどすためにイスラエルと戦おうとしたが、"},{"ref":"2Chr.11.2","start":14011002,"end":14011002,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[5,1,"かみ"],[7,1,"ひと"],[12,1,"のぞ"],[15,1,"い"]],"text":"主の言葉が神の人シマヤに臨んで言った、"},{"ref":"2Chr.11.3","start":14011003,"end":14011003,"break":"none","ruby":[[6,1,"こ"],[11,1,"おう"],[41,2,"ひとびと"],[44,1,"い"]],"text":"「ソロモンの子、ユダの王レハベアムおよびユダとベニヤミンにいるすべてのイスラエルの人々に言いなさい、"},{"ref":"2Chr.11.4","start":14011004,"end":14011004,"break":"none","ruby":[[1,1,"しゅ"],[5,1,"おお"],[17,1,"のぼ"],[32,2,"きょうだい"],[35,1,"たたか"],[48,2,"じぶん"],[51,1,"いえ"],[53,1,"かえ"],[61,1,"こと"],[68,1,"で"],[80,2,"ひとびと"],[83,1,"しゅ"],[85,2,"ことば"],[88,1,"き"],[97,1,"せ"],[100,1,"い"],[107,1,"かえ"]],"text":"『主はこう仰せられる、あなたがたは上ってはならない。あなたがたの兄弟と戦ってはならない。おのおの自分の家に帰りなさい。この事はわたしから出たのである』」。それで人々は主の言葉を聞き、ヤラベアムを攻めに行くのをやめて帰った。"},{"ref":"2Chr.11.5","start":14011005,"end":14011005,"break":"paragraph","ruby":[[12,1,"す"],[19,2,"ぼうえい"],[22,2,"まちまち"],[25,1,"た"]],"text":"レハベアムはエルサレムに住んで、ユダに防衛の町々を建てた。"},{"ref":"2Chr.11.6","start":14011006,"end":14011006,"break":"none","text":"すなわちベツレヘム、エタム、テコア、"},{"ref":"2Chr.11.7","start":14011007,"end":14011007,"break":"none","text":"ベテズル、ソコ、アドラム、"},{"ref":"2Chr.11.8","start":14011008,"end":14011008,"break":"none","text":"ガテ、マレシャ、ジフ、"},{"ref":"2Chr.11.9","start":14011009,"end":14011009,"break":"none","text":"アドライム、ラキシ、アゼカ、"},{"ref":"2Chr.11.10","start":14011010,"end":14011010,"break":"none","ruby":[[32,2,"ようがい"],[35,2,"まちまち"]],"text":"ゾラ、アヤロン、およびヘブロン。これらはユダとベニヤミンにあって要害の町々である。"},{"ref":"2Chr.11.11","start":14011011,"end":14011011,"break":"none","ruby":[[0,1,"かれ"],[4,2,"ようがい"],[7,2,"けんご"],[15,1,"ぐん"],[16,1,"ちょう"],[18,1,"お"],[21,2,"りょうしょく"],[24,1,"あぶら"],[29,1,"しゅ"]],"text":"彼はその要害を堅固にし、これに軍長を置き、糧食と油とぶどう酒をたくわえ、"},{"ref":"2Chr.11.12","start":14011012,"end":14011012,"break":"none","ruby":[[8,1,"まち"],[10,1,"たて"],[15,1,"そな"],[22,2,"ひじょう"],[25,2,"きょうか"],[41,2,"かくほ"]],"text":"またそのすべての町に盾とやりを備えて、これを非常に強化し、そしてユダとベニヤミンを確保した。"},{"ref":"2Chr.11.13","start":14011013,"end":14011013,"break":"paragraph","ruby":[[6,1,"ぜん"],[7,1,"ち"],[9,2,"さいし"],[17,2,"しほう"],[20,1,"さかい"],[23,1,"き"],[31,1,"み"],[33,1,"よ"]],"text":"イスラエルの全地の祭司とレビびとは四方の境から来てレハベアムに身を寄せた。"},{"ref":"2Chr.11.14","start":14011014,"end":14011014,"break":"none","ruby":[[9,2,"じぶん"],[12,2,"ほうぼく"],[14,1,"ち"],[16,2,"りょうち"],[19,1,"はな"],[31,1,"き"],[45,1,"こ"],[48,1,"かれ"],[51,2,"はいせき"],[56,1,"しゅ"],[58,1,"まえ"],[60,2,"さいし"],[63,1,"つとめ"]],"text":"すなわちレビびとは自分の放牧地と領地を離れてユダとエルサレムに来た。これはヤラベアムとその子らが彼らを排斥して、主の前に祭司の務をさせなかったためである。"},{"ref":"2Chr.11.15","start":14011015,"end":14011015,"break":"none","ruby":[[6,1,"たか"],[8,1,"ところ"],[15,1,"かみ"],[18,2,"じぶん"],[21,1,"つく"],[24,1,"こ"],[25,1,"うし"],[30,2,"じぶん"],[33,2,"さいし"],[36,1,"た"]],"text":"ヤラベアムは高き所と、みだらな神と、自分で造った子牛のために自分の祭司を立てた。"},{"ref":"2Chr.11.16","start":14011016,"end":14011016,"break":"none","ruby":[[12,2,"ぶぞく"],[24,1,"こころ"],[26,1,"かたむ"],[36,1,"かみ"],[38,1,"しゅ"],[40,1,"もと"],[43,1,"もの"],[45,2,"せんぞ"],[48,1,"かみ"],[50,1,"しゅ"],[52,2,"ぎせい"],[68,1,"したが"],[77,1,"き"]],"text":"またイスラエルのすべての部族のうちで、すべてその心を傾けて、イスラエルの神、主を求める者は先祖の神、主に犠牲をささげるために、レビびとに従ってエルサレムに来た。"},{"ref":"2Chr.11.17","start":14011017,"end":14011017,"break":"none","ruby":[[5,1,"かれ"],[11,1,"くに"],[13,1,"かた"],[22,1,"こ"],[30,1,"ねん"],[32,1,"あいだ"],[33,1,"つよ"],[38,1,"かれ"],[42,1,"ねん"],[44,1,"あいだ"],[54,1,"みち"],[56,1,"あゆ"]],"text":"このように彼らはユダの国を堅くし、ソロモンの子レハベアムを三年の間強くした。彼らは三年の間ダビデとソロモンの道に歩んだからである。"},{"ref":"2Chr.11.18","start":14011018,"end":14011018,"break":"paragraph","ruby":[[10,1,"こ"],[16,1,"むすめ"],[22,1,"つま"],[39,1,"こ"],[45,1,"むすめ"],[52,1,"う"],[55,1,"もの"]],"text":"レハベアムはダビデの子エレモテの娘マハラテを妻にめとった。マハラテはエッサイの子エリアブの娘アビハイルが産んだ者である。"},{"ref":"2Chr.11.19","start":14011019,"end":14011019,"break":"none","ruby":[[0,2,"かのじょ"],[19,1,"し"],[21,1,"う"]],"text":"彼女はエウシ、シマリヤおよびザハムの三子を産んだ。"},{"ref":"2Chr.11.20","start":14011020,"end":14011020,"break":"none","ruby":[[0,1,"かれ"],[4,2,"かのじょ"],[7,1,"のち"],[15,1,"むすめ"],[48,1,"う"]],"text":"彼はまた彼女の後にアブサロムの娘マアカをめとった。マアカはアビヤ、アッタイ、ジザおよびシロミテを産んだ。"},{"ref":"2Chr.11.21","start":14011021,"end":14011021,"break":"none","ruby":[[12,1,"むすめ"],[21,1,"つま"],[31,1,"あい"],[35,1,"かれ"],[37,1,"つま"],[40,1,"にん"],[47,1,"にん"],[54,1,"おとこ"],[56,1,"こ"],[60,1,"にん"],[62,1,"おんな"],[64,1,"こ"],[67,1,"にん"]],"text":"レハベアムはアブサロムの娘マアカをすべての妻とそばめにまさって愛した。彼は妻十八人、そばめ六十人をめとって、男の子二十八人と女の子六十人をもうけた。"},{"ref":"2Chr.11.22","start":14011022,"end":14011022,"break":"none","ruby":[[10,1,"こ"],[15,1,"た"],[26,2,"きょうだい"],[29,1,"ちょう"],[34,1,"かれ"],[40,1,"おう"],[46,1,"おも"]],"text":"レハベアムはマアカの子アビヤを立ててかしらとし、その兄弟の長とした。彼はアビヤを王にしようと思ったからである。"},{"ref":"2Chr.11.23","start":14011023,"end":14011023,"break":"none","ruby":[[3,1,"おう"],[5,1,"かしこ"],[9,1,"おこな"],[35,1,"ぜん"],[36,2,"ちほう"],[45,2,"ようがい"],[48,1,"まち"],[50,2,"さんざい"],[55,1,"かれ"],[58,2,"りょうしょく"],[61,1,"おお"],[63,1,"あた"],[68,1,"おお"],[71,1,"つま"],[73,1,"え"]],"text":"それで王は賢くとり行い、そのむすこたちをことごとく、ユダとベニヤミンの全地方にあるすべての要害の町に散在させ、彼らに糧食を多く与え、また多くの妻を得させた。"}]