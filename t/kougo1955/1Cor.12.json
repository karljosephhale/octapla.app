[{"ref":"1Cor.12.1","start":46012001,"end":46012001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[6,1,"れい"],[8,2,"たまもの"],[16,1,"つぎ"],[21,1,"し"]],"text":"兄弟たちよ。霊の賜物については、次のことを知らずにいてもらいたくない。"},{"ref":"1Cor.12.2","start":46012002,"end":46012002,"break":"none","ruby":[[8,3,"いほうじん"],[15,1,"とき"],[17,1,"さそ"],[24,1,"もの"],[26,1,"い"],[30,2,"ぐうぞう"],[37,1,"ひ"],[41,1,"い"],[54,2,"しょうち"]],"text":"あなたがたがまだ異邦人であった時、誘われるまま、物の言えない偶像のところに引かれて行ったことは、あなたがたの承知しているとおりである。"},{"ref":"1Cor.12.3","start":46012003,"end":46012003,"break":"none","ruby":[[10,1,"い"],[17,1,"かみ"],[19,1,"れい"],[24,1,"かた"],[26,1,"もの"],[44,1,"い"],[53,2,"せいれい"],[71,1,"しゅ"],[77,1,"い"]],"text":"そこで、あなたがたに言っておくが、神の霊によって語る者はだれも「イエスはのろわれよ」とは言わないし、また、聖霊によらなければ、だれも「イエスは主である」と言うことができない。"},{"ref":"1Cor.12.4","start":46012004,"end":46012004,"break":"paragraph","ruby":[[0,1,"れい"],[2,2,"たまもの"],[5,2,"しゅじゅ"],[11,2,"みたま"],[14,1,"おな"]],"text":"霊の賜物は種々あるが、御霊は同じである。"},{"ref":"1Cor.12.5","start":46012005,"end":46012005,"break":"none","ruby":[[0,1,"つとめ"],[2,2,"しゅじゅ"],[8,1,"しゅ"],[10,1,"おな"]],"text":"務は種々あるが、主は同じである。"},{"ref":"1Cor.12.6","start":46012006,"end":46012006,"break":"none","ruby":[[0,1,"はたら"],[3,2,"しゅじゅ"],[16,1,"なか"],[18,1,"はたら"],[31,1,"かみ"],[34,1,"おな"]],"text":"働きは種々あるが、すべてのものの中に働いてすべてのことをなさる神は、同じである。"},{"ref":"1Cor.12.7","start":46012007,"end":46012007,"break":"none","ruby":[[0,2,"かくじ"],[3,2,"みたま"],[6,1,"あらわ"],[9,1,"たま"],[18,2,"ぜんたい"],[21,1,"えき"]],"text":"各自が御霊の現れを賜わっているのは、全体の益になるためである。"},{"ref":"1Cor.12.8","start":46012008,"end":46012008,"break":"none","ruby":[[7,1,"ひと"],[10,2,"みたま"],[16,2,"ちえ"],[19,2,"ことば"],[22,1,"あた"],[30,1,"ひと"],[34,1,"おな"],[36,2,"みたま"],[42,2,"ちしき"],[45,1,"ことば"]],"text":"すなわち、ある人には御霊によって知恵の言葉が与えられ、ほかの人には、同じ御霊によって知識の言、"},{"ref":"1Cor.12.9","start":46012009,"end":46012009,"break":"none","ruby":[[5,1,"ひと"],[9,1,"おな"],[11,2,"みたま"],[17,2,"しんこう"],[25,1,"ひと"],[32,2,"みたま"],[42,2,"たまもの"]],"text":"またほかの人には、同じ御霊によって信仰、またほかの人には、一つの御霊によっていやしの賜物、"},{"ref":"1Cor.12.10","start":46012010,"end":46012010,"break":"none","ruby":[[5,1,"ひと"],[8,1,"ちから"],[19,1,"ひと"],[22,2,"よげん"],[30,1,"ひと"],[33,1,"れい"],[35,1,"み"],[39,1,"ちから"],[46,1,"ひと"],[49,2,"しゅじゅ"],[52,2,"いげん"],[60,1,"ひと"],[63,2,"いげん"],[66,1,"と"],[68,1,"ちから"],[71,1,"あた"]],"text":"またほかの人には力あるわざ、またほかの人には預言、またほかの人には霊を見わける力、またほかの人には種々の異言、またほかの人には異言を解く力が、与えられている。"},{"ref":"1Cor.12.11","start":46012011,"end":46012011,"break":"none","ruby":[[14,1,"おな"],[16,2,"みたま"],[19,1,"はたら"],[26,2,"みたま"],[29,1,"おも"],[40,2,"かくじ"],[43,1,"わ"],[45,1,"あた"]],"text":"すべてこれらのものは、一つの同じ御霊の働きであって、御霊は思いのままに、それらを各自に分け与えられるのである。"},{"ref":"1Cor.12.12","start":46012012,"end":46012012,"break":"paragraph","ruby":[[11,2,"したい"],[14,1,"おお"],[30,2,"したい"],[33,1,"おお"],[58,2,"ばあい"],[61,2,"どうよう"]],"text":"からだが一つであっても肢体は多くあり、また、からだのすべての肢体が多くあっても、からだは一つであるように、キリストの場合も同様である。"},{"ref":"1Cor.12.13","start":46012013,"end":46012013,"break":"none","ruby":[[11,1,"みな"],[16,1,"じん"],[22,1,"じん"],[25,2,"どれい"],[28,3,"じゆうじん"],[36,2,"みたま"],[61,1,"う"],[67,1,"みな"],[71,2,"みたま"],[74,1,"の"]],"text":"なぜなら、わたしたちは皆、ユダヤ人もギリシヤ人も、奴隷も自由人も、一つの御霊によって、一つのからだとなるようにバプテスマを受け、そして皆一つの御霊を飲んだからである。"},{"ref":"1Cor.12.14","start":46012014,"end":46012014,"break":"none","ruby":[[0,2,"じっさい"],[10,2,"したい"],[19,1,"おお"]],"text":"実際、からだは一つの肢体だけではなく、多くのものからできている。"},{"ref":"1Cor.12.15","start":46012015,"end":46012015,"break":"none","ruby":[[2,1,"あし"],[9,1,"て"],[21,1,"ぞく"],[28,1,"い"],[41,1,"ぞく"]],"text":"もし足が、わたしは手ではないから、からだに属していないと言っても、それで、からだに属さないわけではない。"},{"ref":"1Cor.12.16","start":46012016,"end":46012016,"break":"none","ruby":[[5,1,"みみ"],[12,1,"め"],[24,1,"ぞく"],[31,1,"い"],[44,1,"ぞく"]],"text":"また、もし耳が、わたしは目ではないから、からだに属していないと言っても、それで、からだに属さないわけではない。"},{"ref":"1Cor.12.17","start":46012017,"end":46012017,"break":"none","ruby":[[5,2,"ぜんたい"],[8,1,"め"],[18,1,"き"],[29,2,"ぜんたい"],[32,1,"みみ"]],"text":"もしからだ全体が目だとすれば、どこで聞くのか。もし、からだ全体が耳だとすれば、どこでかぐのか。"},{"ref":"1Cor.12.18","start":46012018,"end":46012018,"break":"none","ruby":[[3,1,"かみ"],[5,2,"みむね"],[12,2,"したい"],[24,1,"そな"]],"text":"そこで神は御旨のままに、肢体をそれぞれ、からだに備えられたのである。"},{"ref":"1Cor.12.19","start":46012019,"end":46012019,"break":"none","ruby":[[13,2,"したい"]],"text":"もし、すべてのものが一つの肢体なら、どこにからだがあるのか。"},{"ref":"1Cor.12.20","start":46012020,"end":46012020,"break":"none","ruby":[[4,2,"じっさい"],[7,2,"したい"],[10,1,"おお"]],"text":"ところが実際、肢体は多くあるが、からだは一つなのである。"},{"ref":"1Cor.12.21","start":46012021,"end":46012021,"break":"none","ruby":[[0,1,"め"],[2,1,"て"],[21,1,"い"],[27,1,"あたま"],[29,1,"あし"],[48,1,"い"]],"text":"目は手にむかって、「おまえはいらない」とは言えず、また頭は足にむかって、「おまえはいらない」とも言えない。"},{"ref":"1Cor.12.22","start":46012022,"end":46012022,"break":"none","ruby":[[18,1,"ほか"],[22,1,"よわ"],[24,1,"み"],[27,2,"したい"],[35,2,"ひつよう"]],"text":"そうではなく、むしろ、からだのうちで他よりも弱く見える肢体が、かえって必要なのであり、"},{"ref":"1Cor.12.23","start":46012023,"end":46012023,"break":"none","ruby":[[8,1,"ほか"],[12,1,"み"],[13,1,"おと"],[19,1,"おも"],[30,1,"き"],[37,1,"み"],[43,1,"うるわ"],[48,2,"ぶぶん"],[55,1,"うるわ"]],"text":"からだのうちで、他よりも見劣りがすると思えるところに、ものを着せていっそう見よくする。麗しくない部分はいっそう麗しくするが、"},{"ref":"1Cor.12.24","start":46012024,"end":46012024,"break":"none","ruby":[[0,1,"うるわ"],[3,2,"ぶぶん"],[10,2,"ひつよう"],[16,1,"かみ"],[18,1,"おと"],[23,2,"ぶぶん"],[30,1,"み"],[40,2,"ちょうわ"],[44,1,"あた"]],"text":"麗しい部分はそうする必要がない。神は劣っている部分をいっそう見よくして、からだに調和をお与えになったのである。"},{"ref":"1Cor.12.25","start":46012025,"end":46012025,"break":"none","ruby":[[8,1,"なか"],[10,2,"ぶんれつ"],[21,2,"したい"],[24,1,"たがい"],[30,1,"あ"]],"text":"それは、からだの中に分裂がなく、それぞれの肢体が互にいたわり合うためなのである。"},{"ref":"1Cor.12.26","start":46012026,"end":46012026,"break":"none","ruby":[[5,2,"したい"],[8,1,"なや"],[15,2,"したい"],[20,1,"とも"],[22,1,"なや"],[28,2,"したい"],[31,1,"たっと"],[40,2,"したい"],[45,1,"とも"],[47,1,"よろこ"]],"text":"もし一つの肢体が悩めば、ほかの肢体もみな共に悩み、一つの肢体が尊ばれると、ほかの肢体もみな共に喜ぶ。"},{"ref":"1Cor.12.27","start":46012027,"end":46012027,"break":"none","ruby":[[27,2,"したい"]],"text":"あなたがたはキリストのからだであり、ひとりびとりはその肢体である。"},{"ref":"1Cor.12.28","start":46012028,"end":46012028,"break":"none","ruby":[[4,1,"かみ"],[6,2,"きょうかい"],[9,1,"なか"],[12,2,"ひとびと"],[15,1,"た"],[19,1,"だい"],[22,2,"しと"],[25,1,"だい"],[28,3,"よげんしゃ"],[32,1,"だい"],[35,2,"きょうし"],[40,1,"つぎ"],[42,1,"ちから"],[48,1,"おこな"],[50,1,"もの"],[52,1,"つぎ"],[58,2,"たまもの"],[61,1,"も"],[63,1,"もの"],[67,3,"ほじょしゃ"],[71,3,"かんりしゃ"],[75,2,"しゅじゅ"],[78,2,"いげん"],[81,1,"かた"],[83,1,"もの"]],"text":"そして、神は教会の中で、人々を立てて、第一に使徒、第二に預言者、第三に教師とし、次に力あるわざを行う者、次にいやしの賜物を持つ者、また補助者、管理者、種々の異言を語る者をおかれた。"},{"ref":"1Cor.12.29","start":46012029,"end":46012029,"break":"none","ruby":[[4,2,"しと"],[15,3,"よげんしゃ"],[27,2,"きょうし"],[38,1,"ちから"],[44,1,"おこな"],[46,1,"もの"]],"text":"みんなが使徒だろうか。みんなが預言者だろうか。みんなが教師だろうか。みんなが力あるわざを行う者だろうか。"},{"ref":"1Cor.12.30","start":46012030,"end":46012030,"break":"none","ruby":[[8,2,"たまもの"],[11,1,"も"],[26,2,"いげん"],[29,1,"かた"],[41,2,"いげん"],[44,1,"と"]],"text":"みんながいやしの賜物を持っているのだろうか。みんなが異言を語るのだろうか。みんなが異言を解くのだろうか。"},{"ref":"1Cor.12.31","start":46012031,"end":46012031,"break":"none","ruby":[[10,1,"さら"],[12,1,"おお"],[16,2,"たまもの"],[19,1,"え"],[23,2,"ねっしん"],[26,1,"つと"],[40,1,"もっと"],[46,1,"みち"],[54,1,"しめ"]],"text":"だが、あなたがたは、更に大いなる賜物を得ようと熱心に努めなさい。そこで、わたしは最もすぐれた道をあなたがたに示そう。"}]