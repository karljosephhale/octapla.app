[{"ref":"Num.33.1","start":4033001,"end":4033001,"break":"paragraph","ruby":[[6,2,"ひとびと"],[19,1,"みちび"],[25,2,"ぶたい"],[28,1,"したが"],[37,1,"くに"],[39,1,"で"],[43,1,"へ"],[45,2,"たびじ"],[48,1,"つぎ"]],"text":"イスラエルの人々が、モーセとアロンとに導かれ、その部隊に従って、エジプトの国を出てから経た旅路は次のとおりである。"},{"ref":"Num.33.2","start":4033002,"end":4033002,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"めい"],[13,2,"たびじ"],[21,2,"しゅくえき"],[24,1,"か"],[32,2,"しゅくえき"],[40,2,"たびじ"],[43,1,"つぎ"]],"text":"モーセは主の命により、その旅路にしたがって宿駅を書きとめた。その宿駅にしたがえば旅路は次のとおりである。"},{"ref":"Num.33.3","start":4033003,"end":4033003,"break":"none","ruby":[[0,1,"かれ"],[3,2,"しょうがつ"],[8,1,"にち"],[15,2,"しゅったつ"],[24,2,"すぎこし"],[27,2,"よくじつ"],[35,2,"ひとびと"],[50,1,"め"],[52,1,"まえ"],[54,4,"いきようよう"],[59,2,"しゅったつ"]],"text":"彼らは正月の十五日にラメセスを出立した。すなわち過越の翌日イスラエルの人々は、すべてのエジプトびとの目の前を意気揚々と出立した。"},{"ref":"Num.33.4","start":4033004,"end":4033004,"break":"none","ruby":[[2,1,"とき"],[11,1,"しゅ"],[13,1,"う"],[15,1,"ころ"],[27,1,"ほうむ"],[33,1,"しゅ"],[37,1,"かれ"],[40,2,"かみがみ"],[44,1,"ばつ"],[46,1,"くわ"]],"text":"その時エジプトびとは、主に撃ち殺されたすべてのういごを葬っていた。主はまた彼らの神々にも罰を加えられた。"},{"ref":"Num.33.5","start":4033005,"end":4033005,"break":"paragraph","ruby":[[10,2,"ひとびと"],[18,2,"しゅったつ"],[26,2,"しゅくえい"]],"text":"こうしてイスラエルの人々はラメセスを出立してスコテに宿営し、"},{"ref":"Num.33.6","start":4033006,"end":4033006,"break":"none","ruby":[[4,2,"しゅったつ"],[8,2,"あらの"],[11,1,"はし"],[19,2,"しゅくえい"]],"text":"スコテを出立して荒野の端にあるエタムに宿営し、"},{"ref":"Num.33.7","start":4033007,"end":4033007,"break":"none","ruby":[[4,2,"しゅったつ"],[16,1,"まえ"],[26,1,"ひ"],[28,1,"かえ"],[36,1,"まえ"],[38,2,"しゅくえい"]],"text":"エタムを出立してバアル・ゼポンの前にあるピハヒロテに引き返してミグドルの前に宿営し、"},{"ref":"Num.33.8","start":4033008,"end":4033008,"break":"none","ruby":[[6,2,"しゅったつ"],[11,1,"うみ"],[20,2,"あらの"],[23,1,"い"],[30,2,"あらの"],[34,1,"か"],[35,1,"じ"],[38,1,"い"],[45,2,"しゅくえい"]],"text":"ピハヒロテを出立して、海のなかをとおって荒野に入り、エタムの荒野を三日路ほど行って、メラに宿営し、"},{"ref":"Num.33.9","start":4033009,"end":4033009,"break":"none","ruby":[[3,2,"しゅったつ"],[11,1,"い"],[14,2,"しゅくえい"],[24,1,"みず"],[26,1,"いずみ"],[38,1,"ほん"]],"text":"メラを出立し、エリムに行って宿営した。エリムには水の泉十二と、なつめやし七十本とがあった。"},{"ref":"Num.33.10","start":4033010,"end":4033010,"break":"none","ruby":[[4,2,"しゅったつ"],[8,2,"こうかい"],[15,2,"しゅくえい"]],"text":"エリムを出立して紅海のほとりに宿営し、"},{"ref":"Num.33.11","start":4033011,"end":4033011,"break":"none","ruby":[[0,2,"こうかい"],[3,2,"しゅったつ"],[10,2,"あらの"],[13,2,"しゅくえい"]],"text":"紅海を出立してシンの荒野に宿営し、"},{"ref":"Num.33.12","start":4033012,"end":4033012,"break":"none","ruby":[[3,2,"あらの"],[6,2,"しゅったつ"],[14,2,"しゅくえい"]],"text":"シンの荒野を出立してドフカに宿営し、"},{"ref":"Num.33.13","start":4033013,"end":4033013,"break":"none","ruby":[[4,2,"しゅったつ"],[12,2,"しゅくえい"]],"text":"ドフカを出立してアルシに宿営し、"},{"ref":"Num.33.14","start":4033014,"end":4033014,"break":"none","ruby":[[4,2,"しゅったつ"],[13,2,"しゅくえい"],[22,1,"たみ"],[24,1,"の"],[26,1,"みず"]],"text":"アルシを出立してレピデムに宿営した。そこには民の飲む水がなかった。"},{"ref":"Num.33.15","start":4033015,"end":4033015,"break":"none","ruby":[[5,2,"しゅったつ"],[13,2,"あらの"],[16,2,"しゅくえい"]],"text":"レピデムを出立してシナイの荒野に宿営し、"},{"ref":"Num.33.16","start":4033016,"end":4033016,"break":"none","ruby":[[4,2,"あらの"],[7,2,"しゅったつ"],[21,2,"しゅくえい"]],"text":"シナイの荒野を出立してキブロテ・ハッタワに宿営し、"},{"ref":"Num.33.17","start":4033017,"end":4033017,"break":"none","ruby":[[10,2,"しゅったつ"],[19,2,"しゅくえい"]],"text":"キブロテ・ハッタワを出立してハゼロテに宿営し、"},{"ref":"Num.33.18","start":4033018,"end":4033018,"break":"none","ruby":[[5,2,"しゅったつ"],[13,2,"しゅくえい"]],"text":"ハゼロテを出立してリテマに宿営し、"},{"ref":"Num.33.19","start":4033019,"end":4033019,"break":"none","ruby":[[4,2,"しゅったつ"],[17,2,"しゅくえい"]],"text":"リテマを出立してリンモン・パレツに宿営し、"},{"ref":"Num.33.20","start":4033020,"end":4033020,"break":"none","ruby":[[9,2,"しゅったつ"],[17,2,"しゅくえい"]],"text":"リンモン・パレツを出立してリブナに宿営し、"},{"ref":"Num.33.21","start":4033021,"end":4033021,"break":"none","ruby":[[4,2,"しゅったつ"],[12,2,"しゅくえい"]],"text":"リブナを出立してリッサに宿営し、"},{"ref":"Num.33.22","start":4033022,"end":4033022,"break":"none","ruby":[[4,2,"しゅったつ"],[13,2,"しゅくえい"]],"text":"リッサを出立してケヘラタに宿営し、"},{"ref":"Num.33.23","start":4033023,"end":4033023,"break":"none","ruby":[[5,2,"しゅったつ"],[13,1,"やま"],[15,2,"しゅくえい"]],"text":"ケヘラタを出立してシャペル山に宿営し、"},{"ref":"Num.33.24","start":4033024,"end":4033024,"break":"none","ruby":[[4,1,"やま"],[6,2,"しゅったつ"],[14,2,"しゅくえい"]],"text":"シャペル山を出立してハラダに宿営し、"},{"ref":"Num.33.25","start":4033025,"end":4033025,"break":"none","ruby":[[4,2,"しゅったつ"],[13,2,"しゅくえい"]],"text":"ハラダを出立してマケロテに宿営し、"},{"ref":"Num.33.26","start":4033026,"end":4033026,"break":"none","ruby":[[5,2,"しゅったつ"],[13,2,"しゅくえい"]],"text":"マケロテを出立してタハテに宿営し、"},{"ref":"Num.33.27","start":4033027,"end":4033027,"break":"none","ruby":[[4,2,"しゅったつ"],[11,2,"しゅくえい"]],"text":"タハテを出立してテラに宿営し、"},{"ref":"Num.33.28","start":4033028,"end":4033028,"break":"none","ruby":[[3,2,"しゅったつ"],[11,2,"しゅくえい"]],"text":"テラを出立してミテカに宿営し、"},{"ref":"Num.33.29","start":4033029,"end":4033029,"break":"none","ruby":[[4,2,"しゅったつ"],[13,2,"しゅくえい"]],"text":"ミテカを出立してハシモナに宿営し、"},{"ref":"Num.33.30","start":4033030,"end":4033030,"break":"none","ruby":[[5,2,"しゅったつ"],[13,2,"しゅくえい"]],"text":"ハシモナを出立してモセラに宿営し、"},{"ref":"Num.33.31","start":4033031,"end":4033031,"break":"none","ruby":[[4,2,"しゅったつ"],[14,2,"しゅくえい"]],"text":"モセラを出立してベネヤカンに宿営し、"},{"ref":"Num.33.32","start":4033032,"end":4033032,"break":"none","ruby":[[6,2,"しゅったつ"],[19,2,"しゅくえい"]],"text":"ベネヤカンを出立してホル・ハギデガデに宿営し、"},{"ref":"Num.33.33","start":4033033,"end":4033033,"break":"none","ruby":[[9,2,"しゅったつ"],[18,2,"しゅくえい"]],"text":"ホル・ハギデガデを出立してヨテバタに宿営し、"},{"ref":"Num.33.34","start":4033034,"end":4033034,"break":"none","ruby":[[5,2,"しゅったつ"],[14,2,"しゅくえい"]],"text":"ヨテバタを出立してアブロナに宿営し、"},{"ref":"Num.33.35","start":4033035,"end":4033035,"break":"none","ruby":[[5,2,"しゅったつ"],[18,2,"しゅくえい"]],"text":"アブロナを出立してエジオン・ゲベルに宿営し、"},{"ref":"Num.33.36","start":4033036,"end":4033036,"break":"none","ruby":[[9,2,"しゅったつ"],[16,2,"あらの"],[26,2,"しゅくえい"]],"text":"エジオン・ゲベルを出立してチンの荒野すなわちカデシに宿営し、"},{"ref":"Num.33.37","start":4033037,"end":4033037,"break":"none","ruby":[[4,2,"しゅったつ"],[12,1,"くに"],[14,1,"はし"],[20,1,"やま"],[22,2,"しゅくえい"]],"text":"カデシを出立してエドムの国の端にあるホル山に宿営した。"},{"ref":"Num.33.38","start":4033038,"end":4033038,"break":"paragraph","ruby":[[6,2,"ひとびと"],[14,1,"くに"],[16,1,"で"],[20,1,"ねん"],[21,1,"め"],[24,1,"がつ"],[26,1,"にち"],[29,2,"さいし"],[35,1,"しゅ"],[37,1,"めい"],[43,1,"やま"],[45,1,"のぼ"],[51,1,"ところ"],[53,1,"し"]],"text":"イスラエルの人々がエジプトの国を出て四十年目の五月一日に、祭司アロンは主の命によりホル山に登って、その所で死んだ。"},{"ref":"Num.33.39","start":4033039,"end":4033039,"break":"none","ruby":[[6,1,"やま"],[8,1,"し"],[17,1,"さい"]],"text":"アロンはホル山で死んだとき百二十三歳であった。"},{"ref":"Num.33.40","start":4033040,"end":4033040,"break":"paragraph","ruby":[[4,1,"ち"],[10,1,"す"],[24,1,"おう"],[33,2,"ひとびと"],[36,1,"く"],[40,1,"き"]],"text":"カナンの地のネゲブに住んでいたカナンびとアラデの王は、イスラエルの人々の来るのを聞いた。"},{"ref":"Num.33.41","start":4033041,"end":4033041,"break":"paragraph","ruby":[[6,1,"やま"],[8,2,"しゅったつ"],[17,2,"しゅくえい"]],"text":"ついで、ホル山を出立してザルモナに宿営し、"},{"ref":"Num.33.42","start":4033042,"end":4033042,"break":"none","ruby":[[5,2,"しゅったつ"],[13,2,"しゅくえい"]],"text":"ザルモナを出立してプノンに宿営し、"},{"ref":"Num.33.43","start":4033043,"end":4033043,"break":"none","ruby":[[4,2,"しゅったつ"],[12,2,"しゅくえい"]],"text":"プノンを出立してオボテに宿営し、"},{"ref":"Num.33.44","start":4033044,"end":4033044,"break":"none","ruby":[[4,2,"しゅったつ"],[12,1,"さかい"],[24,2,"しゅくえい"]],"text":"オボテを出立してモアブの境にあるイエ・アバリムに宿営し、"},{"ref":"Num.33.45","start":4033045,"end":4033045,"break":"none","ruby":[[8,2,"しゅったつ"],[19,2,"しゅくえい"]],"text":"イエ・アバリムを出立してデボン・ガドに宿営し、"},{"ref":"Num.33.46","start":4033046,"end":4033046,"break":"none","ruby":[[7,2,"しゅったつ"],[23,2,"しゅくえい"]],"text":"デボン・ガドを出立してアルモン・デブラタイムに宿営し、"},{"ref":"Num.33.47","start":4033047,"end":4033047,"break":"none","ruby":[[12,2,"しゅったつ"],[19,1,"まえ"],[28,1,"やま"],[30,2,"しゅくえい"]],"text":"アルモン・デブラタイムを出立してネボの前にあるアバリムの山に宿営し、"},{"ref":"Num.33.48","start":4033048,"end":4033048,"break":"none","ruby":[[5,1,"やま"],[7,2,"しゅったつ"],[15,1,"ちか"],[30,2,"へいや"],[33,2,"しゅくえい"]],"text":"アバリムの山を出立してエリコに近いヨルダンのほとりのモアブの平野に宿営した。"},{"ref":"Num.33.49","start":4033049,"end":4033049,"break":"none","ruby":[[17,2,"へいや"],[38,1,"あいだ"],[40,2,"しゅくえい"]],"text":"すなわちヨルダンのほとりのモアブの平野で、ベテエシモテとアベル・シッテムとの間に宿営した。"},{"ref":"Num.33.50","start":4033050,"end":4033050,"break":"paragraph","ruby":[[4,1,"ちか"],[19,2,"へいや"],[23,1,"しゅ"],[29,1,"い"]],"text":"エリコに近いヨルダンのほとりのモアブの平野で、主はモーセに言われた、"},{"ref":"Num.33.51","start":4033051,"end":4033051,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[27,1,"わた"],[34,1,"ち"]],"text":"「イスラエルの人々に言いなさい。あなたがたがヨルダンを渡ってカナンの地にはいるときは、"},{"ref":"Num.33.52","start":4033052,"end":4033052,"break":"none","ruby":[[2,1,"ち"],[4,2,"じゅうみん"],[18,1,"まえ"],[21,1,"お"],[23,1,"はら"],[30,2,"せきぞう"],[41,1,"い"],[42,1,"ぞう"],[52,1,"たか"],[54,1,"ところ"],[56,2,"はかい"]],"text":"その地の住民をことごとくあなたがたの前から追い払い、すべての石像をこぼち、すべての鋳像をこぼち、すべての高き所を破壊しなければならない。"},{"ref":"Num.33.53","start":4033053,"end":4033053,"break":"none","ruby":[[10,1,"ち"],[12,1,"たみ"],[14,1,"お"],[16,1,"はら"],[23,1,"す"],[40,1,"ち"],[48,2,"しょゆう"],[53,1,"あた"]],"text":"またあなたがたはその地の民を追い払って、そこに住まなければならない。わたしがその地をあなたがたの所有として与えたからである。"},{"ref":"Num.33.54","start":4033054,"end":4033054,"break":"none","ruby":[[11,2,"しぞく"],[19,1,"ひ"],[24,1,"ち"],[26,1,"わ"],[29,1,"し"],[30,1,"ぎょう"],[42,1,"おお"],[45,2,"ぶぞく"],[49,1,"おお"],[52,1,"し"],[53,1,"ぎょう"],[55,1,"あた"],[58,1,"ちい"],[61,2,"ぶぞく"],[65,1,"すこ"],[68,1,"し"],[69,1,"ぎょう"],[71,1,"あた"],[87,1,"あた"],[90,1,"ところ"],[94,2,"しょゆう"],[110,2,"ふそ"],[113,2,"ぶぞく"],[125,1,"つ"]],"text":"あなたがたは、おのおの氏族ごとにくじを引き、その地を分けて嗣業としなければならない。大きい部族には多くの嗣業を与え、小さい部族には少しの嗣業を与えなければならない。そのくじの当った所がその所有となるであろう。あなたがたは父祖の部族にしたがって、それを継がなければならない。"},{"ref":"Num.33.55","start":4033055,"end":4033055,"break":"none","ruby":[[6,1,"ち"],[8,2,"じゅうみん"],[17,1,"まえ"],[20,1,"お"],[22,1,"はら"],[32,1,"のこ"],[35,1,"お"],[38,1,"もの"],[46,1,"め"],[60,1,"わき"],[75,1,"す"],[77,1,"くに"],[89,1,"なや"]],"text":"しかし、その地の住民をあなたがたの前から追い払わないならば、その残して置いた者はあなたがたの目にとげとなり、あなたがたの脇にいばらとなり、あなたがたの住む国において、あなたがたを悩ますであろう。"},{"ref":"Num.33.56","start":4033056,"end":4033056,"break":"none","ruby":[[7,1,"かれ"],[14,1,"おも"]],"text":"また、わたしは彼らにしようと思ったとおりに、あなたがたにするであろう」。"}]