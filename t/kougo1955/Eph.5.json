[{"ref":"Eph.5.1","start":49005001,"end":49005001,"break":"paragraph","ruby":[[12,1,"かみ"],[14,1,"あい"],[20,2,"こども"],[26,1,"かみ"],[31,1,"もの"]],"text":"こうして、あなたがたは、神に愛されている子供として、神にならう者になりなさい。"},{"ref":"Eph.5.2","start":49005002,"end":49005002,"break":"none","ruby":[[2,1,"あい"],[7,1,"ある"],[24,1,"あい"],[27,1,"くだ"],[43,2,"じしん"],[47,1,"かみ"],[62,1,"もの"]],"text":"また愛のうちを歩きなさい。キリストもあなたがたを愛して下さって、わたしたちのために、ご自身を、神へのかんばしいかおりのささげ物、また、いけにえとしてささげられたのである。"},{"ref":"Eph.5.3","start":49005003,"end":49005003,"break":"none","ruby":[[3,3,"ふひんこう"],[12,1,"けが"],[15,2,"どんよく"],[21,2,"せいと"],[36,1,"あいだ"],[40,1,"くち"]],"text":"また、不品行といろいろな汚れや貪欲などを、聖徒にふさわしく、あなたがたの間では、口にすることさえしてはならない。"},{"ref":"Eph.5.4","start":49005004,"end":49005004,"break":"none","ruby":[[3,1,"いや"],[6,2,"ことば"],[9,1,"おろ"],[12,1,"はなし"],[18,2,"じょうだん"],[21,1,"さ"],[38,1,"こと"],[52,2,"かんしゃ"]],"text":"また、卑しい言葉と愚かな話やみだらな冗談を避けなさい。これらは、よろしくない事である。それよりは、むしろ感謝をささげなさい。"},{"ref":"Eph.5.5","start":49005005,"end":49005005,"break":"none","ruby":[[9,1,"し"],[24,3,"ふひんこう"],[28,1,"もの"],[30,1,"けが"],[38,1,"もの"],[40,2,"どんよく"],[43,1,"もの"],[50,2,"ぐうぞう"],[53,2,"れいはい"],[57,1,"もの"],[65,1,"かみ"],[68,1,"くに"]],"text":"あなたがたは、よく知っておかねばならない。すべて不品行な者、汚れたことをする者、貪欲な者、すなわち、偶像を礼拝する者は、キリストと神との国をつぐことができない。"},{"ref":"Eph.5.6","start":49005006,"end":49005006,"break":"none","ruby":[[11,3,"ふせいじつ"],[15,2,"ことば"],[38,1,"かみ"],[40,1,"いか"],[43,1,"ふ"],[44,2,"じゅうじゅん"],[47,1,"こ"],[50,1,"くだ"]],"text":"あなたがたは、だれにも不誠実な言葉でだまされてはいけない。これらのことから、神の怒りは不従順の子らに下るのである。"},{"ref":"Eph.5.7","start":49005007,"end":49005007,"break":"none","ruby":[[4,1,"かれ"],[7,2,"なかま"]],"text":"だから、彼らの仲間になってはいけない。"},{"ref":"Eph.5.8","start":49005008,"end":49005008,"break":"none","ruby":[[7,2,"いぜん"],[18,1,"いま"],[20,1,"しゅ"],[25,1,"ひかり"],[33,1,"ひかり"],[35,1,"こ"],[39,1,"ある"]],"text":"あなたがたは、以前はやみであったが、今は主にあって光となっている。光の子らしく歩きなさい――"},{"ref":"Eph.5.9","start":49005009,"end":49005009,"break":"none","ruby":[[0,1,"ひかり"],[6,2,"ぜんい"],[9,2,"せいぎ"],[12,2,"しんじつ"],[16,1,"み"],[18,1,"むす"]],"text":"光はあらゆる善意と正義と真実との実を結ばせるものである――"},{"ref":"Eph.5.10","start":49005010,"end":49005010,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"よろこ"],[21,1,"し"]],"text":"主に喜ばれるものがなんであるかを、わきまえ知りなさい。"},{"ref":"Eph.5.11","start":49005011,"end":49005011,"break":"none","ruby":[[0,1,"み"],[2,1,"むす"],[12,1,"くわ"],[26,2,"してき"]],"text":"実を結ばないやみのわざに加わらないで、むしろ、それを指摘してやりなさい。"},{"ref":"Eph.5.12","start":49005012,"end":49005012,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かく"],[6,1,"おこな"],[15,1,"くち"],[23,1,"は"],[28,1,"こと"]],"text":"彼らが隠れて行っていることは、口にするだけでも恥ずかしい事である。"},{"ref":"Eph.5.13","start":49005013,"end":49005013,"break":"none","ruby":[[4,1,"ひかり"],[11,1,"とき"],[21,1,"あき"]],"text":"しかし、光にさらされる時、すべてのものは、明らかになる。"},{"ref":"Eph.5.14","start":49005014,"end":49005014,"break":"none","breaks":[[33,"stanza"],[48,"line"],[65,"line"]],"ruby":[[0,1,"あき"],[10,1,"みな"],[12,1,"ひかり"],[27,1,"か"],[34,1,"ねむ"],[39,1,"もの"],[42,1,"お"],[48,2,"しにん"],[56,1,"た"],[58,1,"あ"],[80,1,"てら"]],"text":"明らかにされたものは皆、光となるのである。だから、こう書いてある、「眠っている者よ、起きなさい。死人のなかから、立ち上がりなさい。そうすれば、キリストがあなたを照すであろう」。"},{"ref":"Eph.5.15","start":49005015,"end":49005015,"break":"paragraph","ruby":[[10,1,"ある"],[17,2,"ちゅうい"],[22,1,"かしこ"],[26,1,"もの"],[36,1,"かしこ"],[38,1,"もの"],[43,1,"ある"]],"text":"そこで、あなたがたの歩きかたによく注意して、賢くない者のようにではなく、賢い者のように歩き、"},{"ref":"Eph.5.16","start":49005016,"end":49005016,"break":"none","ruby":[[0,1,"いま"],[2,1,"とき"],[4,1,"い"],[8,1,"もち"],[14,1,"いま"],[16,1,"わる"],[18,2,"じだい"]],"text":"今の時を生かして用いなさい。今は悪い時代なのである。"},{"ref":"Eph.5.17","start":49005017,"end":49005017,"break":"none","ruby":[[4,1,"おろ"],[7,1,"もの"],[15,1,"しゅ"],[17,2,"みむね"],[27,1,"さと"]],"text":"だから、愚かな者にならないで、主の御旨がなんであるかを悟りなさい。"},{"ref":"Eph.5.18","start":49005018,"end":49005018,"break":"none","ruby":[[0,1,"さけ"],[2,1,"よ"],[14,2,"らんぎょう"],[26,2,"みたま"],[29,1,"み"]],"text":"酒に酔ってはいけない。それは乱行のもとである。むしろ御霊に満たされて、"},{"ref":"Eph.5.19","start":49005019,"end":49005019,"break":"none","ruby":[[0,1,"し"],[6,1,"れい"],[8,1,"うた"],[14,1,"かた"],[16,1,"あ"],[19,1,"しゅ"],[25,1,"こころ"],[32,1,"うた"]],"text":"詩とさんびと霊の歌とをもって語り合い、主にむかって心からさんびの歌をうたいなさい。"},{"ref":"Eph.5.20","start":49005020,"end":49005020,"break":"none","ruby":[[23,1,"しゅ"],[33,2,"みな"],[40,1,"ちち"],[43,1,"かみ"],[45,2,"かんしゃ"]],"text":"そしてすべてのことにつき、いつも、わたしたちの主イエス・キリストの御名によって、父なる神に感謝し、"},{"ref":"Eph.5.21","start":49005021,"end":49005021,"break":"none","ruby":[[5,1,"たい"],[8,1,"おそ"],[11,1,"こころ"],[17,1,"たがい"],[19,1,"つか"],[21,1,"あ"]],"text":"キリストに対する恐れの心をもって、互に仕え合うべきである。"},{"ref":"Eph.5.22","start":49005022,"end":49005022,"break":"paragraph","ruby":[[0,1,"つま"],[3,1,"もの"],[6,1,"しゅ"],[8,1,"つか"],[14,2,"じぶん"],[17,1,"おっと"],[19,1,"つか"]],"text":"妻たる者よ。主に仕えるように自分の夫に仕えなさい。"},{"ref":"Eph.5.23","start":49005023,"end":49005023,"break":"none","ruby":[[5,2,"きょうかい"],[16,1,"みずか"],[25,2,"きょうかい"],[28,2,"すくいぬし"],[39,1,"おっと"],[41,1,"つま"]],"text":"キリストが教会のかしらであって、自らは、からだなる教会の救主であられるように、夫は妻のかしらである。"},{"ref":"Eph.5.24","start":49005024,"end":49005024,"break":"none","ruby":[[3,2,"きょうかい"],[11,1,"つか"],[18,1,"つま"],[31,1,"おっと"],[33,1,"つか"]],"text":"そして教会がキリストに仕えるように、妻もすべてのことにおいて、夫に仕えるべきである。"},{"ref":"Eph.5.25","start":49005025,"end":49005025,"break":"none","ruby":[[0,1,"おっと"],[3,1,"もの"],[11,2,"きょうかい"],[14,1,"あい"],[23,2,"じしん"],[36,1,"つま"],[38,1,"あい"]],"text":"夫たる者よ。キリストが教会を愛してそのためにご自身をささげられたように、妻を愛しなさい。"},{"ref":"Eph.5.26","start":49005026,"end":49005026,"break":"none","ruby":[[14,1,"みず"],[16,1,"あら"],[24,2,"ことば"],[31,2,"きょうかい"],[38,1,"せい"]],"text":"キリストがそうなさったのは、水で洗うことにより、言葉によって、教会をきよめて聖なるものとするためであり、"},{"ref":"Eph.5.27","start":49005027,"end":49005027,"break":"none","ruby":[[27,1,"きよ"],[30,1,"きず"],[34,2,"えいこう"],[37,1,"すがた"],[39,2,"きょうかい"],[44,2,"じぶん"],[47,1,"むか"]],"text":"また、しみも、しわも、そのたぐいのものがいっさいなく、清くて傷のない栄光の姿の教会を、ご自分に迎えるためである。"},{"ref":"Eph.5.28","start":49005028,"end":49005028,"break":"none","ruby":[[3,1,"おな"],[7,1,"おっと"],[9,2,"じぶん"],[12,1,"つま"],[15,2,"じぶん"],[25,1,"あい"],[34,2,"じぶん"],[37,1,"つま"],[39,1,"あい"],[42,1,"もの"],[45,2,"じぶん"],[47,2,"じしん"],[50,1,"あい"]],"text":"それと同じく、夫も自分の妻を、自分のからだのように愛さねばならない。自分の妻を愛する者は、自分自身を愛するのである。"},{"ref":"Eph.5.29","start":49005029,"end":49005029,"break":"none","ruby":[[0,2,"じぶん"],[2,2,"じしん"],[5,1,"にく"],[8,1,"もの"],[36,2,"きょうかい"],[53,1,"そだ"],[55,1,"やしな"],[59,1,"つね"]],"text":"自分自身を憎んだ者は、いまだかつて、ひとりもいない。かえって、キリストが教会になさったようにして、おのれを育て養うのが常である。"},{"ref":"Eph.5.30","start":49005030,"end":49005030,"break":"none","ruby":[[16,2,"したい"]],"text":"わたしたちは、キリストのからだの肢体なのである。"},{"ref":"Eph.5.31","start":49005031,"end":49005031,"break":"none","ruby":[[7,1,"ひと"],[9,2,"ふぼ"],[12,1,"はな"],[17,1,"つま"],[19,1,"むす"],[27,1,"もの"],[29,2,"いったい"]],"text":"「それゆえに、人は父母を離れてその妻と結ばれ、ふたりの者は一体となるべきである」。"},{"ref":"Eph.5.32","start":49005032,"end":49005032,"break":"none","ruby":[[2,2,"おくぎ"],[5,1,"おお"],[18,2,"きょうかい"]],"text":"この奥義は大きい。それは、キリストと教会とをさしている。"},{"ref":"Eph.5.33","start":49005033,"end":49005033,"break":"none","ruby":[[20,2,"じぶん"],[23,1,"つま"],[25,2,"じぶん"],[27,2,"じしん"],[33,1,"あい"],[39,1,"つま"],[43,1,"おっと"],[45,1,"うやま"]],"text":"いずれにしても、あなたがたは、それぞれ、自分の妻を自分自身のように愛しなさい。妻もまた夫を敬いなさい。"}]