[{"ref":"Lev.6.1","start":3006001,"end":3006001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.6.2","start":3006002,"end":3006002,"break":"none","ruby":[[3,1,"ひと"],[5,1,"つみ"],[7,1,"おか"],[10,1,"しゅ"],[12,1,"たい"],[15,2,"ふせい"],[28,1,"あず"],[31,1,"もの"],[33,1,"て"],[37,2,"しちぐさ"],[47,1,"もの"],[55,2,"りんじん"],[58,1,"あざむ"],[67,2,"りんじん"]],"text":"「もし人が罪を犯し、主に対して不正をなしたとき、すなわち預かり物、手にした質草、またはかすめた物について、その隣人を欺き、あるいはその隣人をしえたげ、"},{"ref":"Lev.6.3","start":3006003,"end":3006003,"break":"none","ruby":[[4,1,"おと"],[6,1,"もの"],[8,1,"ひろ"],[17,1,"あざむ"],[20,1,"いつわ"],[23,1,"ちか"],[31,1,"ひと"],[39,1,"つみ"]],"text":"あるいは落し物を拾い、それについて欺き、偽って誓うなど、すべて人がそれをなして罪となることの一つについて、"},{"ref":"Lev.6.4","start":3006004,"end":3006004,"break":"none","ruby":[[0,1,"つみ"],[2,1,"おか"],[8,1,"え"],[14,1,"かれ"],[22,1,"もの"],[29,1,"と"],[32,1,"もの"],[34,1,"あず"],[38,1,"もの"],[40,1,"ひろ"],[43,1,"おと"],[45,1,"もの"]],"text":"罪を犯し、とがを得たならば、彼はそのかすめた物、しえたげて取った物、預かった物、拾った落し物、"},{"ref":"Lev.6.5","start":3006005,"end":3006005,"break":"none","ruby":[[3,1,"いつわ"],[5,1,"ちか"],[12,1,"もの"],[14,1,"かえ"],[29,1,"のこ"],[33,1,"つぐな"],[36,1,"さら"],[41,1,"ぶん"],[48,1,"くわ"],[51,1,"かれ"],[53,2,"けんさい"],[60,1,"ひ"],[68,1,"もと"],[70,1,"も"],[72,1,"ぬし"],[74,1,"わた"]],"text":"または偽り誓ったすべての物を返さなければならない。すなわち残りなく償い、更にその五分の一をこれに加え、彼が愆祭をささげる日に、これをその元の持ち主に渡さなければならない。"},{"ref":"Lev.6.6","start":3006006,"end":3006006,"break":"none","ruby":[[0,1,"かれ"],[4,1,"つぐな"],[14,1,"ね"],[15,1,"づも"],[23,2,"おひつじ"],[26,1,"まった"],[32,1,"む"],[35,1,"なか"],[38,1,"と"],[44,2,"さいし"],[50,1,"たずさ"],[56,2,"けんさい"],[61,1,"しゅ"]],"text":"彼はその償いとして、あなたの値積りにしたがい、雄羊の全きものを、群れの中から取り、これを祭司のもとに携えてきて、愆祭として主にささげなければならない。"},{"ref":"Lev.6.7","start":3006007,"end":3006007,"break":"none","ruby":[[5,2,"さいし"],[8,1,"しゅ"],[10,1,"まえ"],[12,1,"かれ"],[28,1,"かれ"],[36,1,"い"],[42,1,"え"]],"text":"こうして、祭司が主の前で彼のためにあがないをするならば、彼はそのいずれを行ってとがを得てもゆるされるであろう」。"},{"ref":"Lev.6.8","start":3006008,"end":3006008,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.6.9","start":3006009,"end":3006009,"break":"none","ruby":[[7,1,"こ"],[11,1,"めい"],[14,1,"い"],[21,2,"はんさい"],[28,1,"つぎ"],[37,2,"はんさい"],[40,2,"さいだん"],[43,1,"ろ"],[45,1,"うえ"],[48,1,"あさ"],[51,1,"よ"],[66,2,"さいだん"],[69,1,"ひ"],[71,1,"も"],[73,1,"つづ"]],"text":"「アロンとその子たちに命じて言いなさい、『燔祭のおきては次のとおりである。燔祭は祭壇の炉の上に、朝まで夜もすがらあるようにし、そこに祭壇の火を燃え続かせなければならない。"},{"ref":"Lev.6.10","start":3006010,"end":3006010,"break":"none","ruby":[[0,2,"さいし"],[3,2,"あま"],[5,1,"ぬの"],[7,1,"ふく"],[9,1,"き"],[11,2,"あま"],[13,1,"ぬの"],[20,1,"み"],[25,2,"さいだん"],[28,1,"うえ"],[30,1,"ひ"],[32,1,"や"],[35,2,"はんさい"],[38,1,"はい"],[40,1,"と"],[47,2,"さいだん"],[53,1,"お"]],"text":"祭司は亜麻布の服を着、亜麻布のももひきを身につけ、祭壇の上で火に焼けた燔祭の灰を取って、これを祭壇のそばに置き、"},{"ref":"Lev.6.11","start":3006011,"end":3006011,"break":"none","ruby":[[2,2,"いふく"],[5,1,"ぬ"],[11,2,"いふく"],[14,1,"き"],[19,1,"はい"],[21,2,"しゅくえい"],[24,1,"そと"],[26,1,"きよ"],[28,2,"ばしょ"],[31,1,"たずさ"],[33,1,"だ"]],"text":"その衣服を脱ぎ、ほかの衣服を着て、その灰を宿営の外の清い場所に携え出さなければならない。"},{"ref":"Lev.6.12","start":3006012,"end":3006012,"break":"none","ruby":[[0,2,"さいだん"],[3,1,"うえ"],[5,1,"ひ"],[11,1,"も"],[13,1,"つづ"],[20,1,"け"],[29,2,"さいし"],[32,1,"あさ"],[43,1,"うえ"],[45,1,"も"],[49,2,"はんさい"],[54,1,"うえ"],[56,1,"なら"],[61,3,"しゅうおんさい"],[65,2,"しぼう"],[70,1,"うえ"],[72,1,"や"]],"text":"祭壇の上の火は、そこに燃え続かせ、それを消してはならない。祭司は朝ごとに、たきぎをその上に燃やし、燔祭をその上に並べ、また酬恩祭の脂肪をその上で焼かなければならない。"},{"ref":"Lev.6.13","start":3006013,"end":3006013,"break":"none","ruby":[[0,1,"ひ"],[2,1,"た"],[5,2,"さいだん"],[8,1,"うえ"],[10,1,"も"],[12,1,"つづ"],[19,1,"け"]],"text":"火は絶えず祭壇の上に燃え続かせ、これを消してはならない。"},{"ref":"Lev.6.14","start":3006014,"end":3006014,"break":"paragraph","ruby":[[0,2,"そさい"],[7,1,"つぎ"],[20,1,"こ"],[27,2,"さいだん"],[30,1,"まえ"],[32,1,"しゅ"],[34,1,"まえ"]],"text":"素祭のおきては次のとおりである。アロンの子たちはそれを祭壇の前で主の前にささげなければならない。"},{"ref":"Lev.6.15","start":3006015,"end":3006015,"break":"none","ruby":[[4,2,"そさい"],[7,2,"むぎこ"],[9,2,"ひとにぎ"],[15,1,"あぶら"],[18,2,"そさい"],[21,1,"うえ"],[25,2,"ぜんぶ"],[28,2,"にゅうこう"],[31,1,"とも"],[33,1,"と"],[37,2,"さいだん"],[40,1,"うえ"],[42,1,"や"],[45,1,"こう"],[55,2,"きねん"],[58,1,"ぶん"],[62,1,"しゅ"]],"text":"すなわち素祭の麦粉一握りとその油を、素祭の上にある全部の乳香と共に取って、祭壇の上で焼き、香ばしいかおりとし、記念の分として主にささげなければならない。"},{"ref":"Lev.6.16","start":3006016,"end":3006016,"break":"none","ruby":[[2,1,"のこ"],[11,1,"こ"],[15,1,"た"],[31,1,"たね"],[33,1,"い"],[37,1,"せい"],[40,1,"ところ"],[42,1,"た"],[53,2,"かいけん"],[56,2,"まくや"],[59,1,"にわ"],[64,1,"た"]],"text":"その残りはアロンとその子たちが食べなければならない。すなわち、種を入れずに聖なる所で食べなければならない。会見の幕屋の庭でこれを食べなければならない。"},{"ref":"Lev.6.17","start":3006017,"end":3006017,"break":"none","ruby":[[3,1,"たね"],[5,1,"い"],[8,1,"や"],[28,2,"かさい"],[35,1,"かれ"],[38,1,"ぶん"],[42,1,"あた"],[49,2,"ざいさい"],[54,2,"けんさい"],[57,2,"どうよう"],[63,1,"せい"]],"text":"これは種を入れて焼いてはならない。わたしはこれをわたしの火祭のうちから彼らの分として与える。これは罪祭および愆祭と同様に、いと聖なるものである。"},{"ref":"Lev.6.18","start":3006018,"end":3006018,"break":"none","ruby":[[4,1,"こ"],[15,2,"だんし"],[21,1,"た"],[34,1,"しゅ"],[40,2,"かさい"],[54,2,"よよ"],[56,2,"えいきゅう"],[59,1,"う"],[65,1,"さだ"],[70,1,"ぶん"],[81,1,"ふ"],[87,1,"せい"]],"text":"アロンの子たちのうち、すべての男子はこれを食べることができる。これは主にささげる火祭のうちから、あなたがたが代々永久に受けるように定められた分である。すべてこれに触れるものは聖となるであろう』」。"},{"ref":"Lev.6.19","start":3006019,"end":3006019,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.6.20","start":3006020,"end":3006020,"break":"none","ruby":[[7,1,"こ"],[16,1,"あぶら"],[17,1,"そそ"],[21,1,"ひ"],[24,1,"しゅ"],[31,1,"そな"],[33,1,"もの"],[35,1,"つぎ"],[48,2,"むぎこ"],[51,1,"ぶん"],[58,1,"た"],[65,2,"そさい"],[70,1,"なか"],[73,1,"あさ"],[76,1,"なか"],[79,1,"ゆう"]],"text":"「アロンとその子たちが、アロンの油注がれる日に、主にささぐべき供え物は次のとおりである。すなわち麦粉十分の一エパを、絶えずささげる素祭とし、半ばは朝に、半ばは夕にささげなければならない。"},{"ref":"Lev.6.21","start":3006021,"end":3006021,"break":"none","ruby":[[3,1,"あぶら"],[7,1,"ま"],[10,2,"ひらなべ"],[13,1,"や"],[19,1,"たずさ"],[25,1,"こま"],[28,1,"くだ"],[31,2,"そさい"],[36,1,"こう"],[47,1,"しゅ"]],"text":"それは油をよく混ぜて平鍋で焼き、それを携えてきて、細かく砕いた素祭とし、香ばしいかおりとして、主にささげなければならない。"},{"ref":"Lev.6.22","start":3006022,"end":3006022,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こ"],[9,1,"あぶら"],[10,1,"そそ"],[14,1,"かれ"],[19,2,"さいし"],[24,1,"もの"],[45,2,"えいきゅう"],[48,1,"しゅ"],[50,1,"き"],[53,1,"ぶん"],[58,1,"まった"],[60,1,"や"]],"text":"彼の子たちのうち、油注がれて彼についで祭司となる者は、これをささげなければならない。これは永久に主に帰する分として、全く焼きつくすべきものである。"},{"ref":"Lev.6.23","start":3006023,"end":3006023,"break":"none","ruby":[[3,2,"さいし"],[6,2,"そさい"],[9,1,"まった"],[11,1,"や"],[28,1,"た"]],"text":"すべて祭司の素祭は全く焼きつくすべきものであって、これを食べてはならない」。"},{"ref":"Lev.6.24","start":3006024,"end":3006024,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.6.25","start":3006025,"end":3006025,"break":"none","ruby":[[7,1,"こ"],[11,1,"い"],[18,2,"ざいさい"],[25,1,"つぎ"],[34,2,"ざいさい"],[37,2,"はんさい"],[43,2,"ばしょ"],[47,1,"しゅ"],[49,1,"まえ"],[68,1,"せい"],[71,1,"もの"]],"text":"「アロンとその子たちに言いなさい、『罪祭のおきては次のとおりである。罪祭は燔祭をほふる場所で、主の前にほふらなければならない。これはいと聖なる物である。"},{"ref":"Lev.6.26","start":3006026,"end":3006026,"break":"none","ruby":[[0,1,"つみ"],[12,2,"さいし"],[19,1,"た"],[34,2,"かいけん"],[37,2,"まくや"],[40,1,"にわ"],[42,1,"せい"],[45,1,"ところ"],[51,1,"た"]],"text":"罪のためにこれをささげる祭司が、これを食べなければならない。すなわち会見の幕屋の庭の聖なる所で、これを食べなければならない。"},{"ref":"Lev.6.27","start":3006027,"end":3006027,"break":"none","ruby":[[5,1,"にく"],[7,1,"ふ"],[10,1,"もの"],[12,1,"せい"],[25,1,"ち"],[27,2,"いふく"],[47,1,"せい"],[50,1,"ところ"],[52,1,"あら"]],"text":"すべてその肉に触れる者は聖となるであろう。もしその血が衣服にかかったならば、そのかかったものは聖なる所で洗わなければならない。"},{"ref":"Lev.6.28","start":3006028,"end":3006028,"break":"none","ruby":[[5,1,"に"],[7,1,"つち"],[9,1,"うつわ"],[11,1,"くだ"],[24,2,"せいどう"],[27,1,"うつわ"],[29,1,"に"],[45,1,"みず"],[47,1,"あら"]],"text":"またそれを煮た土の器は砕かなければならない。もし青銅の器で煮たのであれば、それはみがいて、水で洗わなければならない。"},{"ref":"Lev.6.29","start":3006029,"end":3006029,"break":"none","ruby":[[0,2,"さいし"],[12,2,"だんし"],[19,1,"た"],[34,1,"せい"]],"text":"祭司たちのうちのすべての男子は、これを食べることができる。これはいと聖なるものである。"},{"ref":"Lev.6.30","start":3006030,"end":3006030,"break":"none","ruby":[[6,1,"ち"],[8,2,"かいけん"],[11,2,"まくや"],[14,1,"たずさ"],[21,2,"せいじょ"],[29,1,"もち"],[32,2,"ざいさい"],[35,1,"た"],[47,1,"ひ"],[49,1,"や"],[51,1,"す"]],"text":"しかし、その血を会見の幕屋に携えていって、聖所であがないに用いた罪祭は食べてはならない。これは火で焼き捨てなければならない。"}]