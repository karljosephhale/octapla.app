[{"ref":"Song.4.1","start":22004001,"end":22004001,"break":"paragraph","breaks":[[8,"line"],[30,"line"],[50,"line"],[57,"line"],[72,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[8,1,"み"],[15,1,"うつく"],[19,1,"み"],[26,1,"うつく"],[34,1,"め"],[37,1,"かお"],[61,1,"かみ"],[68,1,"やま"],[70,1,"くだ"],[75,1,"む"]],"text":"わが愛する者よ、見よ、あなたは美しい、見よ、あなたは美しい。あなたの目は、顔おおいのうしろにあって、はとのようだ。あなたの髪はギレアデの山を下るやぎの群れのようだ。"},{"ref":"Song.4.2","start":22004002,"end":22004002,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[4,1,"は"],[6,1,"あら"],[8,1,"ば"],[11,1,"のぼ"],[16,1,"け"],[18,1,"き"],[22,1,"め"],[23,1,"ひつじ"],[25,1,"む"],[34,2,"ふたご"],[37,1,"う"],[42,1,"ぴき"],[44,1,"こ"]],"text":"あなたの歯は洗い場から上ってきた毛を切られた雌羊の群れのようだ。みな二子を産んで、一匹も子のないものはない。"},{"ref":"Song.4.3","start":22004003,"end":22004003,"break":"line","breaks":[[17,"line"],[26,"line"],[46,"line"]],"ruby":[[9,1,"くれない"],[11,1,"いと"],[19,1,"くち"],[21,1,"あい"],[33,1,"かお"],[50,1,"かた"]],"text":"あなたのくちびるは紅の糸のようで、その口は愛らしい。あなたのほおは顔おおいのうしろにあって、ざくろの片われのようだ。"},{"ref":"Song.4.4","start":22004004,"end":22004004,"break":"line","breaks":[[16,"line"],[28,"line"],[44,"line"]],"ruby":[[4,1,"くび"],[6,2,"ぶき"],[8,1,"ぐら"],[13,1,"た"],[30,1,"うえ"],[36,1,"たて"],[38,1,"か"],[46,2,"ゆうし"],[49,2,"おおだて"]],"text":"あなたの首は武器倉のために建てたダビデのやぐらのようだ。その上には一千の盾を掛けつらね、みな勇士の大盾である。"},{"ref":"Song.4.5","start":22004005,"end":22004005,"break":"line","breaks":[[10,"line"],[28,"line"]],"ruby":[[4,1,"りょう"],[5,1,"ち"],[15,2,"ふたご"],[21,1,"ひき"],[23,1,"こ"],[31,1,"はな"],[33,1,"なか"],[35,1,"くさ"],[37,1,"た"]],"text":"あなたの両乳ぶさは、かもしかの二子である二匹の子じかが、ゆりの花の中に草を食べているようだ。"},{"ref":"Song.4.6","start":22004006,"end":22004006,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ひ"],[2,1,"すず"],[10,1,"かげ"],[12,1,"き"],[22,2,"もつやく"],[25,1,"やま"],[29,2,"にゅうこう"],[32,1,"おか"],[34,1,"いそ"],[36,1,"ゆ"]],"text":"日の涼しくなるまで、影の消えるまで、わたしは没薬の山および乳香の丘へ急ぎ行こう。"},{"ref":"Song.4.7","start":22004007,"end":22004007,"break":"line","breaks":[[8,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[17,1,"うつく"],[21,1,"すこ"]],"text":"わが愛する者よ、あなたはことごとく美しく、少しのきずもない。"},{"ref":"Song.4.8","start":22004008,"end":22004008,"break":"line","breaks":[[24,"line"],[42,"line"],[67,"line"]],"ruby":[[2,2,"はなよめ"],[16,2,"いっしょ"],[34,2,"いっしょ"],[46,1,"いただき"],[48,1,"さ"],[62,1,"いただき"],[64,1,"さ"],[70,1,"あな"],[76,1,"やま"],[78,1,"さ"]],"text":"わが花嫁よ、レバノンからわたしと一緒にきなさい、レバノンからわたしと一緒にきなさい。アマナの頂を去り、セニルおよびヘルモンの頂を去り、ししの穴、ひょうの山を去りなさい。"},{"ref":"Song.4.9","start":22004009,"end":22004009,"break":"line","breaks":[[24,"line"],[35,"line"]],"ruby":[[2,1,"いもうと"],[6,2,"はなよめ"],[18,1,"こころ"],[20,1,"うば"],[32,1,"め"],[39,1,"くび"],[40,1,"かざり"],[44,1,"たま"],[51,1,"こころ"],[53,1,"うば"]],"text":"わが妹、わが花嫁よ、あなたはわたしの心を奪った。あなたはただひと目で、あなたの首飾のひと玉で、わたしの心を奪った。"},{"ref":"Song.4.10","start":22004010,"end":22004010,"break":"line","breaks":[[10,"line"],[30,"line"],[44,"line"],[65,"line"]],"ruby":[[2,1,"いもうと"],[6,2,"はなよめ"],[14,1,"あい"],[20,1,"うるわ"],[34,1,"あい"],[39,1,"しゅ"],[48,2,"こうゆ"],[59,2,"こうりょう"]],"text":"わが妹、わが花嫁よ、あなたの愛は、なんと麗しいことであろう。あなたの愛はぶどう酒よりも、あなたの香油のかおりはすべての香料よりも、いかにすぐれていることであろう。"},{"ref":"Song.4.11","start":22004011,"end":22004011,"break":"line","breaks":[[24,"line"],[42,"line"]],"ruby":[[2,2,"はなよめ"],[15,2,"かんろ"],[28,1,"した"],[30,1,"した"],[34,1,"みつ"],[36,1,"ちち"],[46,1,"ころも"]],"text":"わが花嫁よ、あなたのくちびるは甘露をしたたらせ、あなたの舌の下には、蜜と乳とがある。あなたの衣のかおりはレバノンのかおりのようだ。"},{"ref":"Song.4.12","start":22004012,"end":22004012,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"いもうと"],[6,2,"はなよめ"],[9,1,"と"],[12,1,"その"],[14,1,"と"],[17,1,"その"],[19,1,"ふう"],[22,1,"いずみ"]],"text":"わが妹、わが花嫁は閉じた園、閉じた園、封じた泉のようだ。"},{"ref":"Song.4.13","start":22004013,"end":22004013,"break":"line","breaks":[[11,"line"],[28,"line"]],"ruby":[[4,1,"う"],[6,1,"だ"],[8,1,"もの"],[16,1,"よ"],[18,1,"み"],[26,1,"その"]],"text":"あなたの産み出す物は、もろもろの良き実をもつざくろの園、ヘンナおよびナルド、"},{"ref":"Song.4.14","start":22004014,"end":22004014,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[14,2,"にっけい"],[22,2,"にゅうこう"],[25,1,"き"],[27,2,"もつやく"],[41,1,"たっと"],[43,2,"こうりょう"]],"text":"ナルド、さふらん、しょうぶ、肉桂、さまざまの乳香の木、没薬、ろかい、およびすべての尊い香料である。"},{"ref":"Song.4.15","start":22004015,"end":22004015,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"その"],[6,1,"いずみ"],[8,1,"い"],[11,1,"みず"],[13,1,"い"],[23,1,"なが"],[25,1,"で"],[27,1,"かわ"]],"text":"あなたは園の泉、生ける水の井、またレバノンから流れ出る川である。"},{"ref":"Song.4.16","start":22004016,"end":22004016,"break":"stanza","breaks":[[15,"line"],[35,"line"],[53,"line"]],"ruby":[[0,2,"きたかぜ"],[4,1,"おこ"],[7,2,"みなみかぜ"],[17,1,"その"],[19,1,"ふ"],[29,1,"ひろ"],[31,1,"ち"],[37,1,"あい"],[40,1,"もの"],[44,1,"その"],[55,1,"よ"],[57,1,"み"],[59,1,"た"]],"text":"北風よ、起れ、南風よ、きたれ。わが園を吹いて、そのかおりを広く散らせ。わが愛する者がその園にはいってきて、その良い実を食べるように。"}]