[{"ref":"Job.11.1","start":18011001,"end":18011001,"break":"paragraph","ruby":[[12,1,"こた"],[15,1,"い"]],"text":"そこでナアマびとゾパルは答えて言った、"},{"ref":"Job.11.2","start":18011002,"end":18011002,"break":"stanza","breaks":[[23,"line"]],"ruby":[[1,2,"ことば"],[4,1,"おお"],[9,1,"こたえ"],[23,1,"くち"],[25,2,"たっしゃ"],[28,1,"ひと"],[30,1,"ぎ"]],"text":"「言葉が多ければ、答なしにすまされるだろうか。口の達者な人は義とされるだろうか。"},{"ref":"Job.11.3","start":18011003,"end":18011003,"break":"line","breaks":[[23,"line"],[34,"line"]],"ruby":[[8,2,"ことば"],[11,1,"ひと"],[13,2,"ちんもく"],[34,1,"ひと"],[40,1,"は"]],"text":"あなたのむなしい言葉は人を沈黙させるだろうか。あなたがあざけるとき、人はあなたを恥じさせないだろうか。"},{"ref":"Job.11.4","start":18011004,"end":18011004,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"い"],[12,1,"おしえ"],[14,1,"ただ"],[22,1,"かみ"],[24,1,"め"],[26,1,"いさぎよ"]],"text":"あなたは言う、『わたしの教は正しい、わたしは神の目に潔い』と。"},{"ref":"Job.11.5","start":18011005,"end":18011005,"break":"line","breaks":[[11,"line"]],"ruby":[[3,1,"かみ"],[5,2,"ことば"],[8,1,"だ"],[24,1,"ひら"]],"text":"どうぞ神が言葉を出し、あなたにむかってくちびるを開き、"},{"ref":"Job.11.6","start":18011006,"end":18011006,"break":"line","breaks":[[18,"line"],[38,"line"],[61,"line"]],"ruby":[[0,2,"ちえ"],[3,2,"ひみつ"],[10,1,"しめ"],[18,1,"かみ"],[25,2,"ちしき"],[45,1,"し"],[51,1,"かみ"],[57,1,"つみ"],[61,1,"かる"],[67,1,"ばっ"]],"text":"知恵の秘密をあなたに示されるように。神はさまざまの知識をもたれるからである。それであなたは知るがよい、神はあなたの罪よりも軽くあなたを罰せられることを。"},{"ref":"Job.11.7","start":18011007,"end":18011007,"break":"stanza","breaks":[[21,"line"]],"ruby":[[4,1,"かみ"],[6,1,"ふか"],[8,1,"こと"],[10,1,"きわ"],[21,3,"ぜんのうしゃ"],[25,2,"げんかい"],[28,1,"きわ"]],"text":"あなたは神の深い事を窮めることができるか。全能者の限界を窮めることができるか。"},{"ref":"Job.11.8","start":18011008,"end":18011008,"break":"line","breaks":[[22,"line"]],"ruby":[[3,1,"てん"],[7,1,"たか"],[14,1,"なに"],[25,2,"よみ"],[30,1,"ふか"],[37,1,"なに"],[39,1,"し"]],"text":"それは天よりも高い、あなたは何をなしうるか。それは陰府よりも深い、あなたは何を知りうるか。"},{"ref":"Job.11.9","start":18011009,"end":18011009,"break":"line","ruby":[[2,1,"りょう"],[4,1,"ち"],[8,1,"なが"],[11,1,"うみ"],[15,1,"ひろ"]],"text":"その量は地よりも長く、海よりも広い。"},{"ref":"Job.11.10","start":18011010,"end":18011010,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[4,1,"ゆ"],[10,1,"ひと"],[12,1,"とら"],[19,1,"め"],[21,1,"あつ"],[32,1,"かれ"]],"text":"彼がもし行きめぐって人を捕え、さばきに召し集められるとき、だれが彼をはばむことができよう。"},{"ref":"Job.11.11","start":18011011,"end":18011011,"break":"line","breaks":[[19,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[2,1,"いや"],[5,2,"にんげん"],[8,1,"し"],[19,1,"かれ"],[21,2,"ふぎ"],[24,1,"み"],[26,1,"とき"],[31,1,"こころ"]],"text":"彼は卑しい人間を知っておられるからだ。彼は不義を見る時、これに心をとめられぬであろうか。"},{"ref":"Job.11.12","start":18011012,"end":18011012,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"の"],[7,1,"こ"],[9,1,"ひと"],[13,1,"うま"],[19,1,"おろ"],[22,1,"もの"],[24,1,"さと"],[27,1,"え"]],"text":"しかし野ろばの子が人として生れるとき、愚かな者も悟りを得るであろう。"},{"ref":"Job.11.13","start":18011013,"end":18011013,"break":"stanza","breaks":[[17,"line"]],"ruby":[[6,1,"こころ"],[8,1,"ただ"],[17,1,"かみ"],[19,1,"む"],[23,1,"て"],[25,1,"の"]],"text":"もしあなたが心を正しくするならば、神に向かって手を伸べるであろう。"},{"ref":"Job.11.14","start":18011014,"end":18011014,"break":"line","breaks":[[24,"line"]],"ruby":[[6,1,"て"],[8,2,"ふぎ"],[19,1,"とお"],[21,1,"さ"],[28,2,"てんまく"],[31,1,"あく"],[33,1,"す"]],"text":"もしあなたの手に不義があるなら、それを遠く去れ、あなたの天幕に悪を住まわせてはならない。"},{"ref":"Job.11.15","start":18011015,"end":18011015,"break":"line","breaks":[[17,"line"],[28,"line"]],"ruby":[[10,1,"は"],[17,1,"かお"],[28,1,"かた"],[30,1,"た"],[34,1,"おそ"]],"text":"そうすれば、あなたは恥じることなく顔をあげることができ、堅く立って、恐れることはない。"},{"ref":"Job.11.16","start":18011016,"end":18011016,"break":"line","breaks":[[11,"line"],[25,"line"]],"ruby":[[4,1,"くる"],[8,1,"わす"],[18,1,"おぼ"],[25,1,"なが"],[27,1,"さ"],[30,1,"みず"]],"text":"あなたは苦しみを忘れ、あなたのこれを覚えることは、流れ去った水のようになる。"},{"ref":"Job.11.17","start":18011017,"end":18011017,"break":"line","breaks":[[19,"line"]],"ruby":[[7,1,"いのち"],[9,2,"まひる"],[14,1,"ひか"],[16,1,"かがや"],[22,1,"くら"],[26,1,"あさ"]],"text":"そしてあなたの命は真昼よりも光り輝き、たとい暗くても朝のようになる。"},{"ref":"Job.11.18","start":18011018,"end":18011018,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"のぞ"],[12,1,"やす"],[16,2,"ほご"],[21,1,"やす"]],"text":"あなたは望みがあるゆえに安んじ、保護されて安らかにいこうことができる。"},{"ref":"Job.11.19","start":18011019,"end":18011019,"break":"line","breaks":[[11,"line"],[26,"line"]],"ruby":[[4,1,"ふ"],[15,1,"おそ"],[26,1,"おお"],[29,1,"もの"],[35,2,"こうい"],[38,1,"もと"]],"text":"あなたは伏してやすみ、あなたを恐れさせるものはない。多くの者はあなたの好意を求めるであろう。"},{"ref":"Job.11.20","start":18011020,"end":18011020,"break":"line","breaks":[[14,"line"],[24,"line"]],"ruby":[[3,1,"あ"],[6,1,"もの"],[8,1,"め"],[10,1,"おとろ"],[14,1,"かれ"],[17,1,"に"],[19,1,"ば"],[21,1,"うしな"],[26,1,"のぞ"],[29,1,"いき"],[31,1,"た"]],"text":"しかし悪しき者の目は衰える。彼らは逃げ場を失い、その望みは息の絶えるにひとしい」。"}]