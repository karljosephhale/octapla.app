[{"ref":"Lev.2.1","start":3002001,"end":3002001,"break":"paragraph","ruby":[[0,1,"ひと"],[2,2,"そさい"],[5,1,"そな"],[7,1,"もの"],[9,1,"しゅ"],[21,1,"そな"],[23,1,"もの"],[25,2,"むぎこ"],[39,1,"うえ"],[41,1,"あぶら"],[43,1,"そそ"],[50,1,"うえ"],[52,2,"にゅうこう"],[55,1,"そ"]],"text":"人が素祭の供え物を主にささげるときは、その供え物は麦粉でなければならない。その上に油を注ぎ、またその上に乳香を添え、"},{"ref":"Lev.2.2","start":3002002,"end":3002002,"break":"none","ruby":[[7,1,"こ"],[10,2,"さいし"],[18,1,"たずさ"],[21,1,"い"],[32,2,"さいし"],[37,2,"むぎこ"],[42,1,"あぶら"],[44,2,"ひとにぎ"],[48,2,"にゅうこう"],[51,2,"ぜんぶ"],[54,1,"とも"],[56,1,"と"],[62,2,"きねん"],[65,1,"ぶん"],[70,2,"さいだん"],[73,1,"うえ"],[75,1,"や"],[89,2,"かさい"],[96,1,"しゅ"],[102,1,"こう"]],"text":"これをアロンの子なる祭司たちのもとに携えて行かなければならない。祭司はその麦粉とその油の一握りを乳香の全部と共に取り、これを記念の分として、祭壇の上で焼かなければならない。これは火祭であって、主にささげる香ばしいかおりである。"},{"ref":"Lev.2.3","start":3002003,"end":3002003,"break":"none","ruby":[[0,2,"そさい"],[3,1,"のこ"],[12,1,"こ"],[24,1,"しゅ"],[26,2,"かさい"],[31,1,"せい"],[34,1,"もの"]],"text":"素祭の残りはアロンとその子らのものになる。これは主の火祭のいと聖なる物である。"},{"ref":"Lev.2.4","start":3002004,"end":3002004,"break":"paragraph","ruby":[[7,2,"てんぴ"],[10,1,"や"],[16,2,"そさい"],[32,2,"むぎこ"],[35,1,"あぶら"],[37,1,"ま"],[40,1,"つく"],[43,1,"たね"],[44,1,"い"],[47,2,"かし"],[53,1,"あぶら"],[55,1,"ぬ"],[58,1,"たね"],[59,1,"い"],[62,2,"せんべい"]],"text":"あなたが、もし天火で焼いたものを素祭としてささげるならば、それは麦粉に油を混ぜて作った種入れぬ菓子、または油を塗った種入れぬ煎餅でなければならない。"},{"ref":"Lev.2.5","start":3002005,"end":3002005,"break":"none","ruby":[[4,1,"そな"],[6,1,"もの"],[12,2,"ひらなべ"],[15,1,"や"],[18,2,"そさい"],[30,2,"むぎこ"],[33,1,"あぶら"],[35,1,"ま"],[38,1,"つく"],[41,1,"たね"],[42,1,"い"]],"text":"あなたの供え物が、もし、平鍋で焼いた素祭であるならば、それは麦粉に油を混ぜて作った種入れぬものでなければならない。"},{"ref":"Lev.2.6","start":3002006,"end":3002006,"break":"none","ruby":[[7,1,"こま"],[10,1,"くだ"],[15,1,"うえ"],[17,1,"あぶら"],[19,1,"そそ"],[33,2,"そさい"]],"text":"あなたはそれを細かく砕き、その上に油を注がなければならない。これは素祭である。"},{"ref":"Lev.2.7","start":3002007,"end":3002007,"break":"none","ruby":[[4,1,"そな"],[6,1,"もの"],[11,1,"ふか"],[12,1,"なべ"],[14,1,"に"],[16,2,"そさい"],[25,2,"むぎこ"],[28,1,"あぶら"],[30,1,"ま"],[33,1,"つく"]],"text":"あなたの供え物が、もし深鍋で煮た素祭であるならば、麦粉に油を混ぜて作らなければならない。"},{"ref":"Lev.2.8","start":3002008,"end":3002008,"break":"none","ruby":[[8,1,"もの"],[10,1,"つく"],[13,2,"そさい"],[17,1,"しゅ"],[19,1,"たずさ"],[22,1,"い"],[36,2,"さいし"],[39,1,"わた"],[45,2,"さいし"],[51,2,"さいだん"],[54,1,"たずさ"],[57,1,"い"]],"text":"あなたはこれらの物で作った素祭を、主に携えて行かなければならない。それを祭司に渡すならば、祭司はそれを祭壇に携えて行き、"},{"ref":"Lev.2.9","start":3002009,"end":3002009,"break":"none","ruby":[[2,2,"そさい"],[9,2,"きねん"],[12,1,"ぶん"],[14,1,"と"],[18,2,"さいだん"],[21,1,"うえ"],[23,1,"や"],[37,2,"かさい"],[44,1,"しゅ"],[50,1,"こう"]],"text":"その素祭のうちから記念の分を取って、祭壇の上で焼かなければならない。これは火祭であって、主にささげる香ばしいかおりである。"},{"ref":"Lev.2.10","start":3002010,"end":3002010,"break":"none","ruby":[[0,2,"そさい"],[3,1,"のこ"],[12,1,"こ"],[25,1,"しゅ"],[27,2,"かさい"],[32,1,"せい"],[35,1,"もの"]],"text":"素祭の残りはアロンとその子らのものになる。これは、主の火祭のいと聖なる物である。"},{"ref":"Lev.2.11","start":3002011,"end":3002011,"break":"paragraph","ruby":[[6,1,"しゅ"],[12,2,"そさい"],[19,1,"たね"],[21,1,"い"],[24,1,"つく"],[35,1,"だね"],[37,1,"みつ"],[43,1,"しゅ"],[49,2,"かさい"],[54,1,"や"]],"text":"あなたがたが主にささげる素祭は、すべて種を入れて作ってはならない。パン種も蜜も、すべて主にささげる火祭として焼いてはならないからである。"},{"ref":"Lev.2.12","start":3002012,"end":3002012,"break":"none","ruby":[[4,2,"はつほ"],[7,1,"そな"],[9,1,"もの"],[19,1,"しゅ"],[35,1,"こう"],[45,2,"さいだん"]],"text":"ただし、初穂の供え物としては、これらを主にささげることができる。しかし香ばしいかおりとして祭壇にささげてはならない。"},{"ref":"Lev.2.13","start":3002013,"end":3002013,"break":"none","ruby":[[4,2,"そさい"],[7,1,"そな"],[9,1,"もの"],[15,1,"しお"],[20,1,"あじ"],[37,2,"そさい"],[45,1,"かみ"],[47,2,"けいやく"],[50,1,"しお"],[52,1,"か"],[69,1,"そな"],[71,1,"もの"],[74,1,"しお"],[76,1,"そ"]],"text":"あなたの素祭の供え物は、すべて塩をもって味をつけなければならない。あなたの素祭に、あなたの神の契約の塩を欠いてはならない。すべて、あなたの供え物は、塩を添えてささげなければならない。"},{"ref":"Lev.2.14","start":3002014,"end":3002014,"break":"paragraph","ruby":[[6,2,"はつほ"],[9,2,"そさい"],[12,1,"しゅ"],[22,1,"ひ"],[24,1,"ほ"],[26,1,"や"],[32,2,"しんこく"],[35,1,"くだ"],[46,2,"はつほ"],[49,2,"そさい"]],"text":"もしあなたが初穂の素祭を主にささげるならば、火で穂を焼いたもの、新穀の砕いたものを、あなたの初穂の素祭としてささげなければならない。"},{"ref":"Lev.2.15","start":3002015,"end":3002015,"break":"none","ruby":[[7,1,"あぶら"],[9,1,"くわ"],[14,1,"うえ"],[16,2,"にゅうこう"],[19,1,"お"],[33,2,"そさい"]],"text":"あなたはそれに油を加え、その上に乳香を置かなければならない。これは素祭である。"},{"ref":"Lev.2.16","start":3002016,"end":3002016,"break":"none","ruby":[[0,2,"さいし"],[6,1,"くだ"],[9,1,"もの"],[15,1,"あぶら"],[21,2,"きねん"],[24,1,"ぶん"],[26,1,"と"],[30,2,"にゅうこう"],[33,2,"ぜんぶ"],[36,1,"とも"],[38,1,"や"],[52,1,"しゅ"],[58,2,"かさい"]],"text":"祭司は、その砕いた物およびその油のうちから記念の分を取って、乳香の全部と共に焼かなければならない。これは主にささげる火祭である。"}]