[{"ref":"Isa.66.1","start":23066001,"end":23066001,"break":"paragraph","breaks":[[9,"line"],[26,"line"],[54,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[10,1,"てん"],[14,1,"くらい"],[16,1,"ち"],[20,1,"あし"],[21,1,"だい"],[42,1,"いえ"],[44,1,"た"],[59,1,"ところ"],[63,1,"やす"],[65,1,"ところ"]],"text":"主はこう言われる、「天はわが位、地はわが足台である。あなたがたはわたしのためにどんな家を建てようとするのか。またどんな所がわが休み所となるのか」。"},{"ref":"Isa.66.2","start":23066002,"end":23066002,"break":"line","breaks":[[7,"line"],[25,"line"],[46,"line"],[65,"line"],[80,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[10,1,"て"],[19,1,"もの"],[21,1,"つく"],[29,1,"もの"],[54,1,"かえり"],[57,1,"ひと"],[76,1,"こころ"],[77,1,"く"],[82,2,"ことば"],[85,1,"おそ"],[91,1,"もの"]],"text":"主は言われる、「わが手はすべてこれらの物を造った。これらの物はことごとくわたしのものである。しかし、わたしが顧みる人はこれである。すなわち、へりくだって心悔い、わが言葉に恐れおののく者である。"},{"ref":"Isa.66.3","start":23066003,"end":23066003,"break":"line","breaks":[[16,"line"],[38,"line"],[61,"line"],[76,"line"],[89,"line"],[100,"line"]],"ruby":[[0,1,"うし"],[5,1,"もの"],[10,1,"ひと"],[12,1,"ころ"],[14,1,"もの"],[16,2,"こひつじ"],[19,2,"ぎせい"],[24,1,"もの"],[29,1,"いぬ"],[34,1,"ころ"],[36,1,"もの"],[38,1,"そな"],[40,1,"もの"],[46,1,"もの"],[51,1,"ぶた"],[53,1,"ち"],[59,1,"もの"],[61,2,"にゅうこう"],[64,2,"きねん"],[73,1,"もの"],[78,2,"ぐうぞう"],[84,1,"もの"],[95,1,"みち"],[97,1,"えら"],[102,1,"こころ"],[104,1,"にく"],[111,1,"たの"]],"text":"牛をほふる者は、また人を殺す者、小羊を犠牲とする者は、また犬をくびり殺す者、供え物をささげる者は、また豚の血をささげる者、乳香を記念としてささげる者は、また偶像をほめる者である。これはおのが道を選び、その心は憎むべきものを楽しむ。"},{"ref":"Isa.66.4","start":23066004,"end":23066004,"break":"line","breaks":[[18,"line"],[39,"line"],[60,"line"],[78,"line"],[91,"line"]],"ruby":[[6,1,"かれ"],[12,1,"なや"],[15,1,"えら"],[18,1,"かれ"],[21,1,"おそ"],[31,1,"かれ"],[34,1,"のぞ"],[47,1,"よ"],[53,1,"こた"],[56,1,"もの"],[64,1,"かた"],[70,1,"き"],[82,1,"め"],[84,1,"わる"],[86,1,"こと"],[88,1,"おこな"],[95,1,"この"],[101,1,"こと"],[103,1,"えら"]],"text":"わたしもまた彼らのために悩みを選び、彼らの恐れるところのものを彼らに臨ませる。これは、わたしが呼んだときに答える者なく、わたしが語ったときに聞くことをせず、わたしの目に悪い事を行い、わたしの好まなかった事を選んだからである」。"},{"ref":"Isa.66.5","start":23066005,"end":23066005,"break":"paragraph","breaks":[[20,"line"],[28,"line"],[49,"line"],[71,"line"],[88,"line"],[109,"line"]],"ruby":[[6,1,"しゅ"],[8,2,"ことば"],[11,1,"おそ"],[17,1,"もの"],[20,1,"しゅ"],[22,2,"ことば"],[25,1,"き"],[35,2,"きょうだい"],[46,1,"にく"],[57,1,"な"],[62,1,"お"],[64,1,"だ"],[67,1,"い"],[72,1,"ねが"],[76,1,"しゅ"],[80,2,"えいこう"],[99,1,"よろこ"],[102,1,"み"],[112,1,"かれ"],[115,1,"はじ"],[117,1,"う"]],"text":"あなたがた、主の言葉に恐れおののく者よ、主の言葉を聞け、「あなたがたの兄弟たちはあなたがたを憎み、あなたがたをわが名のために追い出して言った、『願わくは主がその栄光をあらわしてわれわれにあなたがたの喜びを見させよ』と。しかし彼らは恥を受ける。"},{"ref":"Isa.66.6","start":23066006,"end":23066006,"break":"paragraph","breaks":[[13,"line"],[22,"line"]],"ruby":[[0,1,"き"],[4,1,"まち"],[7,1,"おこ"],[9,1,"さわ"],[13,1,"みや"],[16,1,"きこ"],[19,1,"こえ"],[22,1,"しゅ"],[26,1,"てき"],[28,2,"ほうふく"],[33,1,"こえ"]],"text":"聞けよ、町から起る騒ぎを。宮から聞える声を。主がその敵に報復される声を。"},{"ref":"Isa.66.7","start":23066007,"end":23066007,"break":"paragraph","breaks":[[18,"line"]],"ruby":[[4,1,"う"],[7,1,"くる"],[13,1,"まえ"],[15,1,"う"],[20,1,"くる"],[24,1,"こ"],[27,1,"まえ"],[29,2,"だんし"],[32,1,"う"]],"text":"シオンは産みの苦しみをなす前に産み、その苦しみの来ない前に男子を産んだ。"},{"ref":"Isa.66.8","start":23066008,"end":23066008,"break":"line","breaks":[[15,"line"],[31,"line"],[51,"line"],[69,"line"],[90,"line"]],"ruby":[[8,1,"こと"],[10,1,"き"],[23,1,"こと"],[27,1,"み"],[34,1,"くに"],[37,1,"にち"],[39,1,"くる"],[43,1,"うま"],[54,2,"くにたみ"],[59,1,"とき"],[61,1,"うま"],[77,1,"う"],[80,1,"くる"],[92,1,"こ"],[95,1,"う"]],"text":"だれがこのような事を聞いたか、だれがこのような事どもを見たか。一つの国は一日の苦しみで生れるだろうか。一つの国民はひと時に生れるだろうか。しかし、シオンは産みの苦しみをするやいなやその子らを産んだ。"},{"ref":"Isa.66.9","start":23066009,"end":23066009,"break":"line","breaks":[[11,"line"],[25,"line"],[32,"line"],[45,"line"],[57,"line"]],"ruby":[[4,2,"しゅっさん"],[7,1,"のぞ"],[11,1,"う"],[25,1,"しゅ"],[27,1,"い"],[37,1,"う"],[41,1,"もの"],[45,1,"たい"],[61,1,"かみ"],[63,1,"い"]],"text":"わたしが出産に臨ませて産ませないことがあろうか」と主は言われる。「わたしは産ませる者なのに胎をとざすであろうか」とあなたの神は言われる。"},{"ref":"Isa.66.10","start":23066010,"end":23066010,"break":"paragraph","breaks":[[16,"line"],[34,"line"],[49,"line"]],"ruby":[[10,1,"あい"],[13,1,"もの"],[16,2,"かのじょ"],[19,1,"とも"],[21,1,"よろこ"],[24,2,"かのじょ"],[30,1,"たの"],[37,2,"かのじょ"],[43,1,"かな"],[46,1,"もの"],[49,2,"かのじょ"],[52,1,"とも"],[54,1,"よろこ"],[56,1,"たの"]],"text":"「すべてエルサレムを愛する者よ、彼女と共に喜べ、彼女のゆえに楽しめ。すべて彼女のために悲しむ者よ、彼女と共に喜び楽しめ。"},{"ref":"Isa.66.11","start":23066011,"end":23066011,"break":"line","breaks":[[23,"line"],[36,"line"],[47,"line"]],"ruby":[[6,1,"なぐさ"],[9,1,"あた"],[18,1,"ち"],[23,1,"ちち"],[25,1,"す"],[28,1,"あ"],[40,1,"ゆた"],[43,1,"さか"],[47,1,"の"],[50,1,"たの"]],"text":"あなたがたは慰めを与えるエルサレムの乳ぶさから乳を吸って飽くことができ、またその豊かな栄えから飲んで楽しむことができるからだ」。"},{"ref":"Isa.66.12","start":23066012,"end":23066012,"break":"paragraph","breaks":[[9,"line"],[31,"line"],[55,"line"],[72,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[10,1,"み"],[17,1,"かわ"],[22,2,"かのじょ"],[25,2,"はんえい"],[28,1,"あた"],[35,1,"なが"],[47,1,"くに"],[49,1,"とみ"],[51,1,"あた"],[61,1,"ちち"],[63,1,"の"],[66,1,"こし"],[68,1,"お"],[75,1,"うえ"]],"text":"主はこう言われる、「見よ、わたしは川のように彼女に繁栄を与え、みなぎる流れのように、もろもろの国の富を与える。あなたがたは乳を飲み、腰に負われ、ひざの上であやされる。"},{"ref":"Isa.66.13","start":23066013,"end":23066013,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[0,1,"はは"],[4,1,"こ"],[6,1,"なぐさ"],[23,1,"なぐさ"],[39,1,"なぐさ"],[42,1,"え"]],"text":"母のその子を慰めるように、わたしもあなたがたを慰める。あなたがたはエルサレムで慰めを得る。"},{"ref":"Isa.66.14","start":23066014,"end":23066014,"break":"line","breaks":[[13,"line"],[31,"line"],[47,"line"]],"ruby":[[6,1,"み"],[9,1,"こころ"],[10,1,"よろこ"],[19,1,"ほね"],[21,2,"わかくさ"],[27,1,"さか"],[31,1,"しゅ"],[33,1,"て"],[42,1,"とも"],[49,1,"いきどお"],[54,1,"てき"],[65,1,"し"]],"text":"あなたがたは見て、心喜び、あなたがたの骨は若草のように栄える。主の手はそのしもべらと共にあり、その憤りはその敵にむかっていることを知る。"},{"ref":"Isa.66.15","start":23066015,"end":23066015,"break":"paragraph","breaks":[[19,"line"],[32,"line"],[50,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,1,"ひ"],[7,1,"なか"],[14,1,"こ"],[21,1,"くるま"],[26,1,"かぜ"],[32,1,"はげ"],[35,1,"いか"],[43,1,"いきどお"],[50,1,"ひ"],[52,1,"ほのお"],[57,1,"せ"]],"text":"見よ、主は火の中にあらわれて来られる。その車はつむじ風のようだ。激しい怒りをもってその憤りをもらし、火の炎をもって責められる。"},{"ref":"Isa.66.16","start":23066016,"end":23066016,"break":"line","breaks":[[18,"line"],[33,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ひ"],[22,1,"ひと"],[28,1,"おこな"],[33,1,"しゅ"],[35,1,"ころ"],[39,1,"もの"],[41,1,"おお"]],"text":"主は火をもって、またつるぎをもって、すべての人にさばきを行われる。主に殺される者は多い」。"},{"ref":"Isa.66.17","start":23066017,"end":23066017,"break":"paragraph","ruby":[[6,2,"せいべつ"],[15,1,"きよ"],[18,1,"その"],[20,1,"い"],[25,1,"なか"],[32,1,"したが"],[35,1,"ぶた"],[37,1,"にく"],[39,1,"にく"],[43,1,"もの"],[51,1,"く"],[53,1,"もの"],[57,1,"とも"],[59,1,"た"],[66,1,"しゅ"],[68,1,"い"]],"text":"「みずからを聖別し、みずからを清めて園に行き、その中にあるものに従い、豚の肉、憎むべき物およびねずみを食う者はみな共に絶えうせる」と主は言われる。"},{"ref":"Isa.66.18","start":23066018,"end":23066018,"break":"paragraph","ruby":[[5,1,"かれ"],[12,1,"かれ"],[15,1,"おも"],[19,1,"し"],[29,1,"き"],[36,2,"こくみん"],[50,1,"あつ"],[54,1,"かれ"],[57,1,"き"],[62,2,"えいこう"],[65,1,"み"]],"text":"「わたしは彼らのわざと、彼らの思いとを知っている。わたしは来て、すべての国民と、もろもろのやからとを集める。彼らは来て、わが栄光を見る。"},{"ref":"Isa.66.19","start":23066019,"end":23066019,"break":"none","ruby":[[4,1,"かれ"],[7,1,"なか"],[16,1,"た"],[24,1,"もの"],[31,1,"くに"],[44,1,"ゆみ"],[68,2,"めいせい"],[71,1,"き"],[77,2,"えいこう"],[80,1,"み"],[83,1,"とお"],[86,2,"うみぞ"],[90,2,"くにぐに"],[98,1,"かれ"],[103,2,"えいこう"],[111,2,"こくみん"],[114,1,"なか"],[116,1,"つた"]],"text":"わたしは彼らの中に一つのしるしを立てて、のがれた者をもろもろの国、すなわちタルシシ、よく弓をひくプトおよびルデ、トバル、ヤワン、またわが名声を聞かず、わが栄光を見ない遠くの海沿いの国々につかわす。彼らはわが栄光をもろもろの国民の中に伝える。"},{"ref":"Isa.66.20","start":23066020,"end":23066020,"break":"none","ruby":[[0,1,"かれ"],[9,1,"こ"],[12,1,"きよ"],[14,1,"うつわ"],[16,1,"そな"],[18,1,"もの"],[20,1,"も"],[23,1,"しゅ"],[25,1,"みや"],[27,1,"たずさ"],[30,1,"く"],[42,2,"きょうだい"],[55,1,"くに"],[57,1,"なか"],[60,1,"うま"],[62,1,"くるま"],[67,2,"らば"],[74,1,"の"],[80,1,"せい"],[83,1,"やま"],[94,1,"しゅ"],[96,1,"そな"],[98,1,"もの"],[104,1,"しゅ"],[106,1,"い"]],"text":"彼らはイスラエルの子らが清い器に供え物を盛って主の宮に携えて来るように、あなたがたの兄弟をことごとくもろもろの国の中から馬、車、かご、騾馬、らくだに乗せて、わが聖なる山エルサレムにこさせ、主の供え物とする」と主は言われる。"},{"ref":"Isa.66.21","start":23066021,"end":23066021,"break":"none","ruby":[[7,1,"かれ"],[10,1,"なか"],[13,1,"ひと"],[15,1,"えら"],[18,2,"さいし"],[32,1,"しゅ"],[34,1,"い"]],"text":"「わたしはまた彼らの中から人を選んで祭司とし、レビびととする」と主は言われる。"},{"ref":"Isa.66.22","start":23066022,"end":23066022,"break":"paragraph","breaks":[[22,"line"],[39,"line"],[53,"line"]],"ruby":[[5,1,"つく"],[11,1,"あたら"],[14,1,"てん"],[17,1,"あたら"],[20,1,"ち"],[26,1,"まえ"],[43,2,"しそん"],[51,1,"な"],[62,1,"しゅ"],[64,1,"い"]],"text":"「わたしが造ろうとする新しい天と、新しい地がわたしの前にながくとどまるように、あなたの子孫と、あなたの名はながくとどまる」と主は言われる。"},{"ref":"Isa.66.23","start":23066023,"end":23066023,"break":"line","breaks":[[14,"line"],[32,"line"]],"ruby":[[1,2,"しんげつ"],[7,3,"あんそくにち"],[18,1,"ひと"],[22,1,"まえ"],[24,1,"き"],[26,1,"れい"],[27,1,"はい"],[32,1,"しゅ"],[34,1,"い"]],"text":"「新月ごとに、安息日ごとに、すべての人はわが前に来て礼拝する」と主は言われる。"},{"ref":"Isa.66.24","start":23066024,"end":23066024,"break":"paragraph","ruby":[[1,1,"かれ"],[4,1,"で"],[15,2,"ひとびと"],[23,1,"み"],[31,1,"し"],[37,1,"ひ"],[39,1,"き"],[48,1,"かれ"],[55,1,"ひと"],[57,1,"い"]],"text":"「彼らは出て、わたしにそむいた人々のしかばねを見る。そのうじは死なず、その火は消えることがない。彼らはすべての人に忌みきらわれる」。"}]