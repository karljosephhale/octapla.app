[{"ref":"1Sam.27.1","start":9027001,"end":9027001,"break":"paragraph","ruby":[[4,1,"こころ"],[9,1,"い"],[27,1,"て"],[33,1,"ほろ"],[43,1,"はや"],[52,1,"ち"],[75,1,"うえ"],[82,1,"ち"],[92,1,"さが"],[104,1,"かれ"],[106,1,"て"]],"text":"ダビデは心のうちに言った、「わたしは、いつかはサウルの手にかかって滅ぼされるであろう。早くペリシテびとの地へのがれるほかはない。そうすればサウルはこの上イスラエルの地にわたしをくまなく捜すことはやめ、わたしは彼の手からのがれることができるであろう」。"},{"ref":"1Sam.27.2","start":9027002,"end":9027002,"break":"none","ruby":[[9,1,"とも"],[15,1,"にん"],[17,2,"いっしょ"],[21,1,"た"],[27,1,"おう"],[32,1,"こ"],[37,1,"ところ"],[39,1,"い"]],"text":"こうしてダビデは、共にいた六百人と一緒に、立ってガテの王マオクの子アキシの所へ行った。"},{"ref":"1Sam.27.3","start":9027003,"end":9027003,"break":"none","ruby":[[4,2,"じゅうしゃ"],[16,2,"かぞく"],[30,1,"とも"],[32,1,"す"],[46,1,"つま"],[57,1,"おんな"],[70,1,"おんな"],[76,1,"つま"],[87,1,"とも"]],"text":"ダビデと従者たちは、おのおのその家族とともに、ガテでアキシと共に住んだ。ダビデはそのふたりの妻、すなわちエズレルの女アヒノアムと、カルメルの女でナバルの妻であったアビガイルと共におった。"},{"ref":"1Sam.27.4","start":9027004,"end":9027004,"break":"none","ruby":[[18,1,"きこ"],[31,1,"かれ"],[33,1,"さが"]],"text":"ダビデがガテにのがれたことがサウルに聞えたので、サウルはもはや彼を捜さなかった。"},{"ref":"1Sam.27.5","start":9027005,"end":9027005,"break":"paragraph","ruby":[[10,1,"い"],[25,1,"まえ"],[27,1,"めぐ"],[30,1,"え"],[46,1,"まち"],[54,2,"ばしょ"],[61,1,"あた"],[67,1,"す"],[89,1,"とも"],[91,1,"おう"],[93,1,"まち"],[95,1,"す"]],"text":"さてダビデはアキシに言った、「もしわたしがあなたの前に恵みを得るならば、どうぞ、いなかにある町のうちで一つの場所をわたしに与えてそこに住まわせてください。どうしてしもべがあなたと共に王の町に住むことができましょうか」。"},{"ref":"1Sam.27.6","start":9027006,"end":9027006,"break":"none","ruby":[[6,1,"ひ"],[12,1,"かれ"],[14,1,"あた"],[27,2,"こんにち"],[38,1,"おう"],[40,1,"ぞく"]],"text":"アキシはその日チクラグを彼に与えた。こうしてチクラグは今日にいたるまでユダの王に属している。"},{"ref":"1Sam.27.7","start":9027007,"end":9027007,"break":"none","ruby":[[11,1,"くに"],[13,1,"す"],[16,1,"ひ"],[18,1,"かず"],[21,1,"ねん"],[25,1,"げつ"]],"text":"ダビデがペリシテびとの国に住んだ日の数は一年と四か月であった。"},{"ref":"1Sam.27.8","start":9027008,"end":9027008,"break":"paragraph","ruby":[[6,2,"じゅうしゃ"],[9,1,"とも"],[38,1,"おそ"],[46,1,"むかし"],[53,1,"いた"],[58,1,"ち"],[60,2,"じゅうみん"],[72,1,"いた"],[77,1,"ち"],[79,1,"す"]],"text":"さてダビデは従者と共にのぼって、ゲシュルびと、ゲゼルびとおよびアマレクびとを襲った。これらは昔からシュルに至るまでの地の住民であって、エジプトに至るまでの地に住んでいた。"},{"ref":"1Sam.27.9","start":9027009,"end":9027009,"break":"none","ruby":[[6,1,"ち"],[8,1,"う"],[12,1,"おとこ"],[14,1,"おんな"],[16,1,"い"],[23,1,"ひつじ"],[25,1,"うし"],[34,2,"いふく"],[38,1,"と"],[49,1,"かえ"]],"text":"ダビデはその地を撃って、男も女も生かしおかず、羊と牛とろばとらくだと衣服とを取って、アキシのもとに帰ってきた。"},{"ref":"1Sam.27.10","start":9027010,"end":9027010,"break":"none","ruby":[[15,1,"おそ"],[23,1,"たず"],[35,2,"ときどき"],[76,1,"い"]],"text":"アキシが「あなたはきょうどこを襲いましたか」と尋ねると、ダビデは、その時々、「ユダのネゲブです」、「エラメルびとのネゲブです」「ケニびとのネゲブです」と言った。"},{"ref":"1Sam.27.11","start":9027011,"end":9027011,"break":"none","ruby":[[4,1,"おとこ"],[6,1,"おんな"],[8,1,"い"],[23,1,"ひ"],[26,1,"い"],[42,1,"おそ"],[47,1,"かれ"],[62,1,"い"],[74,1,"つ"],[83,1,"おも"],[107,1,"す"],[112,1,"あいだ"],[120,1,"つね"]],"text":"ダビデは男も女も生かしおかず、ひとりをもガテに引いて行かなかった。それはダビデが、「恐らくは、彼らが、『ダビデはこうした』と言って、われわれのことを告げるであろう」と思ったからである。ダビデはペリシテびとのいなかに住んでいる間はこうするのが常であった。"},{"ref":"1Sam.27.12","start":9027012,"end":9027012,"break":"none","ruby":[[8,1,"しん"],[11,1,"い"],[16,1,"かれ"],[18,2,"じぶん"],[21,1,"まった"],[25,1,"たみ"],[32,1,"にく"],[46,1,"かれ"],[48,2,"えいきゅう"]],"text":"アキシはダビデを信じて言った、「彼は自分を全くその民イスラエルに憎まれるようにした。それゆえ彼は永久にわたしのしもべとなるであろう」。"}]