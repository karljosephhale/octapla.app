[{"ref":"Matt.2.1","start":40002001,"end":40002001,"break":"paragraph","ruby":[[7,1,"おう"],[9,1,"だい"],[23,1,"うま"],[32,1,"み"],[35,1,"ひがし"],[40,2,"はかせ"],[51,1,"つ"],[54,1,"い"]],"text":"イエスがヘロデ王の代に、ユダヤのベツレヘムでお生れになったとき、見よ、東からきた博士たちがエルサレムに着いて言った、"},{"ref":"Matt.2.2","start":40002002,"end":40002002,"break":"none","ruby":[[4,1,"じん"],[6,1,"おう"],[11,1,"うま"],[37,1,"ひがし"],[39,1,"ほう"],[43,1,"ほし"],[45,1,"み"],[55,1,"おが"]],"text":"「ユダヤ人の王としてお生れになったかたは、どこにおられますか。わたしたちは東の方でその星を見たので、そのかたを拝みにきました」。"},{"ref":"Matt.2.3","start":40002003,"end":40002003,"break":"none","ruby":[[3,1,"おう"],[10,1,"き"],[13,2,"ふあん"],[16,1,"かん"],[26,2,"ひとびと"],[32,2,"どうよう"]],"text":"ヘロデ王はこのことを聞いて不安を感じた。エルサレムの人々もみな、同様であった。"},{"ref":"Matt.2.4","start":40002004,"end":40002004,"break":"none","ruby":[[3,1,"おう"],[5,3,"さいしちょう"],[11,1,"たみ"],[13,2,"りっぽう"],[15,2,"がくしゃ"],[21,2,"ぜんぶ"],[23,1,"あつ"],[35,1,"うま"],[42,1,"かれ"],[45,1,"と"]],"text":"そこで王は祭司長たちと民の律法学者たちとを全部集めて、キリストはどこに生れるのかと、彼らに問いただした。"},{"ref":"Matt.2.5","start":40002005,"end":40002005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おう"],[5,1,"い"],[25,3,"よげんしゃ"]],"text":"彼らは王に言った、「それはユダヤのベツレヘムです。預言者がこうしるしています、"},{"ref":"Matt.2.6","start":40002006,"end":40002006,"break":"stanza","breaks":[[13,"line"],[27,"line"],[42,"line"],[58,"line"]],"ruby":[[4,1,"ち"],[20,1,"きみ"],[24,1,"なか"],[27,1,"けっ"],[30,1,"もっと"],[32,1,"ちい"],[46,1,"なか"],[53,1,"きみ"],[55,1,"で"],[60,1,"たみ"],[67,2,"ぼくしゃ"]],"text":"『ユダの地、ベツレヘムよ、おまえはユダの君たちの中で、決して最も小さいものではない。おまえの中からひとりの君が出て、わが民イスラエルの牧者となるであろう』」。"},{"ref":"Matt.2.7","start":40002007,"end":40002007,"break":"paragraph","ruby":[[12,2,"はかせ"],[17,1,"よ"],[21,1,"ほし"],[23,1,"あらわ"],[26,1,"とき"],[31,1,"くわ"],[34,1,"き"]],"text":"そこで、ヘロデはひそかに博士たちを呼んで、星の現れた時について詳しく聞き、"},{"ref":"Matt.2.8","start":40002008,"end":40002008,"break":"none","ruby":[[0,1,"かれ"],[14,1,"い"],[19,1,"い"],[25,1,"おさ"],[27,1,"ご"],[32,1,"くわ"],[35,1,"しら"],[38,1,"み"],[48,1,"し"],[59,1,"おが"],[62,1,"い"]],"text":"彼らをベツレヘムにつかわして言った、「行って、その幼な子のことを詳しく調べ、見つかったらわたしに知らせてくれ。わたしも拝みに行くから」。"},{"ref":"Matt.2.9","start":40002009,"end":40002009,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おう"],[5,1,"い"],[10,1,"き"],[13,1,"で"],[19,1,"み"],[22,1,"かれ"],[25,2,"とうほう"],[28,1,"み"],[30,1,"ほし"],[33,1,"かれ"],[37,1,"さき"],[39,1,"すす"],[43,1,"おさ"],[45,1,"ご"],[49,1,"ところ"],[52,1,"い"],[57,1,"うえ"]],"text":"彼らは王の言うことを聞いて出かけると、見よ、彼らが東方で見た星が、彼らより先に進んで、幼な子のいる所まで行き、その上にとどまった。"},{"ref":"Matt.2.10","start":40002010,"end":40002010,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ほし"],[7,1,"み"],[10,2,"ひじょう"],[13,1,"よろこ"]],"text":"彼らはその星を見て、非常な喜びにあふれた。"},{"ref":"Matt.2.11","start":40002011,"end":40002011,"break":"none","ruby":[[4,1,"いえ"],[11,1,"はは"],[21,1,"おさ"],[23,1,"ご"],[25,1,"あ"],[30,1,"ふ"],[33,1,"おが"],[39,1,"たから"],[41,1,"はこ"],[47,2,"おうごん"],[50,2,"にゅうこう"],[53,2,"もつやく"],[58,1,"おく"],[60,1,"もの"]],"text":"そして、家にはいって、母マリヤのそばにいる幼な子に会い、ひれ伏して拝み、また、宝の箱をあけて、黄金・乳香・没薬などの贈り物をささげた。"},{"ref":"Matt.2.12","start":40002012,"end":40002012,"break":"none","ruby":[[4,1,"ゆめ"],[14,1,"かえ"],[20,1,"つ"],[23,1,"う"],[29,1,"た"],[31,1,"みち"],[37,2,"じぶん"],[40,1,"くに"],[42,1,"かえ"],[45,1,"い"]],"text":"そして、夢でヘロデのところに帰るなとのみ告げを受けたので、他の道をとおって自分の国へ帰って行った。"},{"ref":"Matt.2.13","start":40002013,"end":40002013,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"かえ"],[6,1,"い"],[12,1,"み"],[15,1,"しゅ"],[17,1,"つかい"],[19,1,"ゆめ"],[25,1,"あらわ"],[28,1,"い"],[33,1,"た"],[37,1,"おさ"],[39,1,"ご"],[43,1,"はは"],[45,1,"つ"],[54,1,"に"],[68,1,"し"],[92,1,"おさ"],[94,1,"ご"],[96,1,"さが"],[98,1,"だ"],[102,1,"ころ"]],"text":"彼らが帰って行ったのち、見よ、主の使が夢でヨセフに現れて言った、「立って、幼な子とその母を連れて、エジプトに逃げなさい。そして、あなたに知らせるまで、そこにとどまっていなさい。ヘロデが幼な子を捜し出して、殺そうとしている」。"},{"ref":"Matt.2.14","start":40002014,"end":40002014,"break":"none","ruby":[[8,1,"た"],[12,1,"よる"],[14,1,"あいだ"],[16,1,"おさ"],[18,1,"ご"],[22,1,"はは"],[25,1,"つ"],[33,1,"い"]],"text":"そこで、ヨセフは立って、夜の間に幼な子とその母とを連れてエジプトへ行き、"},{"ref":"Matt.2.15","start":40002015,"end":40002015,"break":"none","ruby":[[4,1,"し"],[23,1,"しゅ"],[25,3,"よげんしゃ"],[41,1,"こ"],[43,1,"よ"],[45,1,"だ"],[50,1,"い"],[58,2,"じょうじゅ"]],"text":"ヘロデが死ぬまでそこにとどまっていた。それは、主が預言者によって「エジプトからわが子を呼び出した」と言われたことが、成就するためである。"},{"ref":"Matt.2.16","start":40002016,"end":40002016,"break":"paragraph","ruby":[[7,2,"はかせ"],[18,1,"し"],[22,2,"ひじょう"],[25,2,"りっぷく"],[33,2,"ひとびと"],[41,2,"はかせ"],[47,1,"たし"],[51,1,"とき"],[53,1,"もとづ"],[65,2,"ふきん"],[68,2,"ちほう"],[75,1,"さい"],[76,2,"いか"],[79,1,"おとこ"],[81,1,"こ"],[89,1,"ころ"]],"text":"さて、ヘロデは博士たちにだまされたと知って、非常に立腹した。そして人々をつかわし、博士たちから確かめた時に基いて、ベツレヘムとその附近の地方とにいる二歳以下の男の子を、ことごとく殺した。"},{"ref":"Matt.2.17","start":40002017,"end":40002017,"break":"none","ruby":[[5,3,"よげんしゃ"],[16,1,"い"],[24,2,"じょうじゅ"]],"text":"こうして、預言者エレミヤによって言われたことが、成就したのである。"},{"ref":"Matt.2.18","start":40002018,"end":40002018,"break":"stanza","breaks":[[15,"line"],[22,"line"],[39,"line"],[51,"line"]],"ruby":[[1,1,"さけ"],[3,1,"な"],[5,1,"おお"],[9,1,"かな"],[13,1,"こえ"],[18,1,"きこ"],[28,1,"こ"],[39,1,"こ"],[51,1,"なぐさ"],[60,1,"ねが"]],"text":"「叫び泣く大いなる悲しみの声がラマで聞えた。ラケルはその子らのためになげいた。子らがもはやいないので、慰められることさえ願わなかった」。"},{"ref":"Matt.2.19","start":40002019,"end":40002019,"break":"paragraph","ruby":[[7,1,"し"],[13,1,"み"],[16,1,"しゅ"],[18,1,"つかい"],[31,1,"ゆめ"],[33,1,"あらわ"],[36,1,"い"]],"text":"さて、ヘロデが死んだのち、見よ、主の使がエジプトにいるヨセフに夢で現れて言った、"},{"ref":"Matt.2.20","start":40002020,"end":40002020,"break":"none","ruby":[[1,1,"た"],[5,1,"おさ"],[7,1,"ご"],[11,1,"はは"],[13,1,"つ"],[23,1,"ち"],[25,1,"い"],[28,1,"おさ"],[30,1,"ご"],[32,1,"いのち"],[40,2,"ひとびと"],[44,1,"し"]],"text":"「立って、幼な子とその母を連れて、イスラエルの地に行け。幼な子の命をねらっていた人々は、死んでしまった」。"},{"ref":"Matt.2.21","start":40002021,"end":40002021,"break":"none","ruby":[[7,1,"た"],[11,1,"おさ"],[13,1,"ご"],[17,1,"はは"],[20,1,"つ"],[30,1,"ち"],[32,1,"かえ"]],"text":"そこでヨセフは立って、幼な子とその母とを連れて、イスラエルの地に帰った。"},{"ref":"Matt.2.22","start":40002022,"end":40002022,"break":"none","ruby":[[11,1,"ちち"],[16,1,"かわ"],[23,2,"おさめ"],[29,1,"き"],[38,1,"い"],[43,1,"おそ"],[50,1,"ゆめ"],[53,1,"つ"],[56,1,"う"],[67,2,"ちほう"],[70,1,"しりぞ"]],"text":"しかし、アケラオがその父ヘロデに代ってユダヤを治めていると聞いたので、そこへ行くことを恐れた。そして夢でみ告げを受けたので、ガリラヤの地方に退き、"},{"ref":"Matt.2.23","start":40002023,"end":40002023,"break":"none","ruby":[[6,1,"まち"],[8,1,"い"],[11,1,"す"],[18,3,"よげんしゃ"],[29,1,"かれ"],[34,1,"びと"],[36,1,"よ"],[46,1,"い"],[54,2,"じょうじゅ"]],"text":"ナザレという町に行って住んだ。これは預言者たちによって、「彼はナザレ人と呼ばれるであろう」と言われたことが、成就するためである。"}]