[{"ref":"Ezek.1.1","start":26001001,"end":26001001,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"ねん"],[5,1,"がつ"],[7,1,"か"],[17,1,"がわ"],[24,2,"ほしゅう"],[27,2,"ひとびと"],[35,1,"とき"],[37,1,"てん"],[39,1,"ひら"],[43,1,"かみ"],[45,1,"まぼろし"],[47,1,"み"]],"text":"第三十年四月五日に、わたしがケバル川のほとりで、捕囚の人々のうちにいた時、天が開けて、神の幻を見た。"},{"ref":"Ezek.1.2","start":26001002,"end":26001002,"break":"none","ruby":[[8,1,"おう"],[10,1,"とら"],[12,1,"うつ"],[16,1,"だい"],[18,1,"ねん"],[26,1,"つき"],[29,1,"か"]],"text":"これはエホヤキン王の捕え移された第五年であって、その月の五日に、"},{"ref":"Ezek.1.3","start":26001003,"end":26001003,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[8,1,"がわ"],[21,1,"ち"],[26,1,"こ"],[27,2,"さいし"],[35,1,"のぞ"],[38,1,"しゅ"],[40,1,"て"],[44,1,"ところ"],[46,1,"かれ"],[48,1,"うえ"]],"text":"主の言葉がケバル川のほとり、カルデヤびとの地でブジの子祭司エゼキエルに臨み、主の手がその所で彼の上にあった。"},{"ref":"Ezek.1.4","start":26001004,"end":26001004,"break":"paragraph","ruby":[[4,1,"み"],[10,1,"み"],[13,1,"はげ"],[16,1,"かぜ"],[18,1,"おお"],[22,1,"くも"],[24,1,"きた"],[27,1,"き"],[32,2,"しゅうい"],[35,1,"かがや"],[44,1,"ひ"],[46,1,"ふ"],[48,1,"だ"],[56,1,"ひ"],[58,1,"なか"],[60,2,"せいどう"],[66,1,"かがや"]],"text":"わたしが見ていると、見よ、激しい風と大いなる雲が北から来て、その周囲に輝きがあり、たえず火を吹き出していた。その火の中に青銅のように輝くものがあった。"},{"ref":"Ezek.1.5","start":26001005,"end":26001005,"break":"none","ruby":[[4,1,"なか"],[10,1,"い"],[15,1,"かたち"],[17,1,"で"],[24,2,"ようす"],[33,1,"かれ"],[36,1,"ひと"],[38,1,"すがた"]],"text":"またその中から四つの生きものの形が出てきた。その様子はこうである。彼らは人の姿をもっていた。"},{"ref":"Ezek.1.6","start":26001006,"end":26001006,"break":"none","ruby":[[7,1,"かお"],[24,1,"つばさ"]],"text":"おのおの四つの顔をもち、またそのおのおのに四つの翼があった。"},{"ref":"Ezek.1.7","start":26001007,"end":26001007,"break":"none","ruby":[[2,1,"あし"],[10,1,"あし"],[15,1,"こ"],[16,1,"うし"],[18,1,"あし"],[33,2,"せいどう"],[39,1,"ひか"]],"text":"その足はまっすぐで、足のうらは子牛の足のうらのようであり、みがいた青銅のように光っていた。"},{"ref":"Ezek.1.8","start":26001008,"end":26001008,"break":"none","ruby":[[2,2,"しほう"],[13,1,"つばさ"],[15,1,"した"],[17,1,"ひと"],[19,1,"て"],[30,1,"もの"],[34,1,"かお"],[36,1,"つばさ"]],"text":"その四方に、そのおのおのの翼の下に人の手があった。この四つの者はみな顔と翼をもち、"},{"ref":"Ezek.1.9","start":26001009,"end":26001009,"break":"none","ruby":[[0,1,"つばさ"],[2,1,"たがい"],[4,1,"つら"],[8,1,"ゆ"],[10,1,"とき"],[12,1,"まわ"],[21,1,"かお"],[23,1,"む"],[35,1,"すす"]],"text":"翼は互に連なり、行く時は回らずに、おのおの顔の向かうところにまっすぐに進んだ。"},{"ref":"Ezek.1.10","start":26001010,"end":26001010,"break":"none","ruby":[[0,1,"かお"],[2,1,"かたち"],[11,2,"ぜんぽう"],[14,1,"ひと"],[16,1,"かお"],[27,1,"もの"],[29,1,"みぎ"],[31,1,"ほう"],[37,1,"かお"],[45,1,"もの"],[47,1,"ひだり"],[49,1,"ほう"],[51,1,"うし"],[53,1,"かお"],[63,1,"もの"],[65,1,"うし"],[68,1,"ほう"],[74,1,"かお"]],"text":"顔の形は、おのおのその前方に人の顔をもっていた。四つの者は右の方に、ししの顔をもち、四つの者は左の方に牛の顔をもち、また四つの者は後ろの方に、わしの顔をもっていた。"},{"ref":"Ezek.1.11","start":26001011,"end":26001011,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かお"],[16,1,"つばさ"],[18,1,"たか"],[20,1,"の"],[30,1,"たがい"],[32,1,"つら"],[36,1,"た"]],"text":"彼らの顔はこのようであった。その翼は高く伸ばされ、その二つは互に連なり、他の二つをもってからだをおおっていた。"},{"ref":"Ezek.1.12","start":26001012,"end":26001012,"break":"none","ruby":[[0,1,"かれ"],[9,1,"かお"],[11,1,"む"],[23,1,"い"],[26,1,"れい"],[28,1,"ゆ"],[34,1,"かれ"],[37,1,"ゆ"],[42,1,"ゆ"],[44,1,"とき"],[46,1,"まわ"]],"text":"彼らはおのおのその顔の向かうところへまっすぐに行き、霊の行くところへ彼らも行き、その行く時は回らない。"},{"ref":"Ezek.1.13","start":26001013,"end":26001013,"break":"none","ruby":[[2,1,"い"],[11,1,"も"],[14,1,"すみ"],[16,1,"ひ"],[36,1,"い"],[41,1,"なか"],[43,1,"ゆ"],[45,1,"き"],[51,1,"ひ"],[53,1,"かがや"],[59,1,"ひ"],[68,1,"で"]],"text":"この生きもののうちには燃える炭の火のようなものがあり、たいまつのように、生きものの中を行き来している。火は輝いて、その火から、いなずまが出ていた。"},{"ref":"Ezek.1.14","start":26001014,"end":26001014,"break":"none","ruby":[[0,1,"い"],[19,1,"はや"],[21,1,"ゆ"],[23,1,"き"]],"text":"生きものは、いなずまのひらめきのように速く行き来していた。"},{"ref":"Ezek.1.15","start":26001015,"end":26001015,"break":"paragraph","ruby":[[4,1,"い"],[9,1,"み"],[15,1,"い"],[25,1,"ち"],[27,1,"うえ"],[29,1,"わ"],[38,1,"い"],[53,1,"わ"]],"text":"わたしが生きものを見ていると、生きもののかたわら、地の上に輪があった。四つの生きものおのおのに、一つずつの輪である。"},{"ref":"Ezek.1.16","start":26001016,"end":26001016,"break":"none","ruby":[[5,1,"わ"],[7,1,"かたち"],[9,1,"つく"],[13,1,"ひか"],[15,1,"き"],[20,1,"いし"],[34,1,"おな"],[36,1,"かたち"],[41,1,"つく"],[50,1,"わ"],[52,1,"なか"],[54,1,"わ"]],"text":"もろもろの輪の形と作りは、光る貴かんらん石のようである。四つのものは同じ形で、その作りは、あたかも、輪の中に輪があるようである。"},{"ref":"Ezek.1.17","start":26001017,"end":26001017,"break":"none","ruby":[[2,1,"ゆ"],[4,1,"とき"],[6,1,"かれ"],[9,2,"しほう"],[17,1,"い"],[20,1,"ゆ"],[22,1,"とき"],[24,1,"まわ"]],"text":"その行く時、彼らは四方のいずれかに行き、行く時は回らない。"},{"ref":"Ezek.1.18","start":26001018,"end":26001018,"break":"none","ruby":[[3,1,"わ"],[6,1,"わ"],[7,1,"ぶち"],[9,1,"や"],[17,1,"わ"],[18,1,"ぶち"],[20,2,"しゅうい"],[23,1,"め"],[28,1,"み"]],"text":"四つの輪には輪縁と輻とがあり、その輪縁の周囲は目をもって満たされていた。"},{"ref":"Ezek.1.19","start":26001019,"end":26001019,"break":"none","ruby":[[0,1,"い"],[5,1,"ゆ"],[7,1,"とき"],[11,1,"わ"],[20,1,"い"],[23,1,"い"],[28,1,"ち"],[34,1,"とき"],[37,1,"わ"]],"text":"生きものが行く時には、輪もそのかたわらに行き、生きものが地からあがる時は、輪もあがる。"},{"ref":"Ezek.1.20","start":26001020,"end":26001020,"break":"none","ruby":[[0,1,"れい"],[2,1,"ゆ"],[4,1,"ところ"],[7,1,"かれ"],[10,1,"い"],[13,1,"わ"],[15,1,"かれ"],[18,1,"ともな"],[25,1,"い"],[30,1,"れい"],[32,1,"わ"],[34,1,"なか"]],"text":"霊の行く所には彼らも行き、輪は彼らに伴ってあがる。生きものの霊が輪の中にあるからである。"},{"ref":"Ezek.1.21","start":26001021,"end":26001021,"break":"none","ruby":[[0,1,"かれ"],[3,1,"ゆ"],[5,1,"とき"],[12,1,"い"],[15,1,"かれ"],[22,1,"とき"],[34,1,"かれ"],[37,1,"ち"],[43,1,"とき"],[46,1,"わ"],[54,1,"とも"],[60,1,"い"],[65,1,"れい"],[67,1,"わ"],[69,1,"なか"]],"text":"彼らが行く時は、これらも行き、彼らがとどまる時は、これらもとどまり、彼らが地からあがる時は、輪もまたこれらと共にあがる。生きものの霊が輪の中にあるからである。"},{"ref":"Ezek.1.22","start":26001022,"end":26001022,"break":"paragraph","ruby":[[0,1,"い"],[5,1,"あたま"],[7,1,"うえ"],[9,2,"すいしょう"],[15,1,"かがや"],[17,2,"おおぞら"],[20,1,"かたち"],[26,1,"かれ"],[29,1,"あたま"],[31,1,"うえ"],[33,1,"ひろ"]],"text":"生きものの頭の上に水晶のように輝く大空の形があって、彼らの頭の上に広がっている。、"},{"ref":"Ezek.1.23","start":26001023,"end":26001023,"break":"none","ruby":[[0,2,"おおぞら"],[3,1,"した"],[11,1,"の"],[15,1,"つばさ"],[24,2,"あいつら"],[29,1,"い"],[41,1,"つばさ"]],"text":"大空の下にはまっすぐに伸ばした翼があり、たがいに相連なり、生きものはおのおの二つの翼をもって、からだをおおっている。"},{"ref":"Ezek.1.24","start":26001024,"end":26001024,"break":"none","ruby":[[2,1,"ゆ"],[4,1,"とき"],[10,2,"おおみず"],[13,1,"こえ"],[15,3,"ぜんのうしゃ"],[19,1,"こえ"],[24,1,"つばさ"],[26,1,"こえ"],[28,1,"き"],[34,1,"こえ"],[36,1,"ひび"],[39,2,"たいぐん"],[42,1,"こえ"],[54,1,"とき"],[56,1,"つばさ"]],"text":"その行く時、わたしは大水の声、全能者の声のような翼の声を聞いた。その声の響きは大軍の声のようで、そのとどまる時は翼をたれる。"},{"ref":"Ezek.1.25","start":26001025,"end":26001025,"break":"none","ruby":[[2,1,"かれ"],[5,1,"あたま"],[7,1,"うえ"],[9,2,"おおぞら"],[13,1,"こえ"],[19,1,"かれ"],[22,1,"た"],[28,1,"とき"],[30,1,"つばさ"]],"text":"また彼らの頭の上の大空から声があった。彼らが立ちとどまる時は翼をおろした。"},{"ref":"Ezek.1.26","start":26001026,"end":26001026,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"あたま"],[5,1,"うえ"],[7,2,"おおぞら"],[10,1,"うえ"],[22,1,"くらい"],[24,1,"かたち"],[34,1,"くらい"],[36,1,"かたち"],[38,1,"うえ"],[41,1,"ひと"],[43,1,"すがた"],[48,1,"かたち"]],"text":"彼らの頭の上の大空の上に、サファイヤのような位の形があった。またその位の形の上に、人の姿のような形があった。"},{"ref":"Ezek.1.27","start":26001027,"end":26001027,"break":"none","ruby":[[5,1,"こし"],[10,1,"ところ"],[12,1,"うえ"],[14,1,"ほう"],[17,1,"ひ"],[19,1,"かたち"],[24,1,"ひか"],[26,2,"せいどう"],[29,1,"いろ"],[38,1,"かこ"],[45,1,"み"],[54,1,"こし"],[59,1,"ところ"],[61,1,"した"],[63,1,"ほう"],[66,1,"ひ"],[74,1,"み"],[80,1,"かれ"],[86,1,"かがや"]],"text":"そしてその腰とみえる所の上の方に、火の形のような光る青銅の色のものが、これを囲んでいるのを見た。わたしはその腰とみえる所の下の方に、火のようなものを見た。そして彼のまわりに輝きがあった。"},{"ref":"Ezek.1.28","start":26001028,"end":26001028,"break":"none","breaks":[[33,"paragraph"]],"ruby":[[8,1,"かがや"],[15,1,"あめ"],[17,1,"ひ"],[19,1,"くも"],[21,1,"おこ"],[33,1,"しゅ"],[35,2,"えいこう"],[38,1,"かたち"],[60,1,"み"],[67,1,"かお"],[75,1,"かた"],[77,1,"もの"],[79,1,"こえ"],[81,1,"き"]],"text":"そのまわりにある輝きのさまは、雨の日に雲に起るにじのようであった。主の栄光の形のさまは、このようであった。わたしはこれを見て、わたしの顔をふせたとき、語る者の声を聞いた。"}]