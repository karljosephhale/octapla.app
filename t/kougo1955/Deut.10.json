[{"ref":"Deut.10.1","start":5010001,"end":5010001,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[10,1,"い"],[21,1,"まえ"],[26,1,"いし"],[28,1,"いた"],[30,1,"まい"],[32,1,"き"],[35,1,"つく"],[38,1,"やま"],[40,1,"のぼ"],[58,1,"き"],[60,1,"はこ"],[64,1,"つく"]],"text":"その時、主はわたしに言われた、『おまえは、前のような石の板二枚を切って作り、山に登って、わたしのもとにきなさい。また木の箱一つを作りなさい。"},{"ref":"Deut.10.2","start":5010002,"end":5010002,"break":"none","ruby":[[7,1,"くだ"],[11,1,"まい"],[13,1,"いた"],[15,1,"か"],[21,2,"ことば"],[31,1,"いた"],[33,1,"か"],[49,1,"はこ"]],"text":"さきにおまえが砕いた二枚の板に書いてあった言葉を、わたしはその板に書きしるそう。おまえはそれをその箱におさめなければならない』。"},{"ref":"Deut.10.3","start":5010003,"end":5010003,"break":"none","ruby":[[11,1,"ざい"],[13,1,"はこ"],[17,1,"つく"],[22,1,"まえ"],[27,1,"いし"],[29,1,"いた"],[31,1,"まい"],[33,1,"き"],[36,1,"つく"],[42,1,"まい"],[44,1,"いた"],[46,1,"て"],[48,1,"も"],[51,1,"やま"],[53,1,"のぼ"]],"text":"そこでわたしはアカシヤ材の箱一つを作り、また前のような石の板二枚を切って作り、その二枚の板を手に持って山に登った。"},{"ref":"Deut.10.4","start":5010004,"end":5010004,"break":"none","ruby":[[0,1,"しゅ"],[8,2,"しゅうかい"],[11,1,"ひ"],[13,1,"やま"],[15,1,"ひ"],[17,1,"なか"],[26,1,"つ"],[31,2,"じっかい"],[34,1,"か"],[47,1,"いた"],[49,1,"か"],[58,1,"しゅ"],[64,1,"さづ"]],"text":"主はかつて、かの集会の日に山で火の中からあなたがたに告げられた十誡を書きしるされたように、その板に書きしるし、それを主はわたしに授けられた。"},{"ref":"Deut.10.5","start":5010005,"end":5010005,"break":"none","ruby":[[7,1,"み"],[14,1,"やま"],[17,1,"お"],[22,1,"いた"],[29,1,"つく"],[32,1,"はこ"],[39,1,"いま"],[44,1,"なか"],[49,1,"しゅ"],[55,1,"めい"]],"text":"それでわたしは身をめぐらして山から降り、その板を、わたしが作った箱におさめた。今なおその中にある。主がわたしに命じられたとおりである。"},{"ref":"Deut.10.6","start":5010006,"end":5010006,"break":"paragraph","ruby":[[11,2,"ひとびと"],[26,2,"しゅったつ"],[34,1,"つ"],[44,1,"ところ"],[46,1,"し"],[52,1,"ほうむ"],[58,1,"こ"],[65,1,"かれ"],[67,1,"かわ"],[70,2,"さいし"]],"text":"（こうしてイスラエルの人々はベエロテ・ベネ・ヤカンを出立してモセラに着いた。アロンはその所で死んでそこに葬られ、その子エレアザルが彼に代って祭司となった。"},{"ref":"Deut.10.7","start":5010007,"end":5010007,"break":"none","ruby":[[5,2,"しゅったつ"],[14,1,"いた"],[22,2,"しゅったつ"],[31,1,"つ"],[37,1,"ち"],[40,1,"おお"],[43,1,"みず"],[45,1,"なが"]],"text":"またそこを出立してグデゴダに至り、グデゴダを出立してヨテバタに着いた。この地には多くの水の流れがあった。"},{"ref":"Deut.10.8","start":5010008,"end":5010008,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[9,2,"ぶぞく"],[12,1,"えら"],[16,1,"しゅ"],[18,2,"けいやく"],[21,1,"はこ"],[27,1,"しゅ"],[29,1,"まえ"],[31,1,"た"],[34,1,"つか"],[39,1,"しゅ"],[41,1,"な"],[46,2,"しゅくふく"],[61,1,"こと"],[63,2,"こんにち"],[66,1,"およ"]],"text":"その時、主はレビの部族を選んで、主の契約の箱をかつぎ、主の前に立って仕え、また主の名をもって祝福することをさせられた。この事は今日に及んでいる。"},{"ref":"Deut.10.9","start":5010009,"end":5010009,"break":"none","ruby":[[7,2,"きょうだい"],[12,2,"いっしょ"],[16,1,"わ"],[18,1,"まえ"],[23,1,"し"],[24,1,"ぎょう"],[33,1,"かみ"],[35,1,"しゅ"],[37,1,"かれ"],[39,1,"い"],[47,1,"しゅ"],[53,1,"かれ"],[55,1,"し"],[56,1,"ぎょう"]],"text":"そのためレビは兄弟たちと一緒には分け前がなく、嗣業もない。あなたの神、主が彼に言われたとおり、主みずからが彼の嗣業であった。）"},{"ref":"Deut.10.10","start":5010010,"end":5010010,"break":"paragraph","ruby":[[4,1,"まえ"],[6,1,"とき"],[13,1,"にち"],[16,1,"や"],[18,1,"やま"],[25,1,"しゅ"],[29,1,"とき"],[36,1,"ねが"],[39,1,"き"],[44,1,"しゅ"],[50,1,"ほろ"],[56,1,"のぞ"]],"text":"わたしは前の時のように四十日四十夜、山におったが、主はその時にもわたしの願いを聞かれた。主はあなたを滅ぼすことを望まれなかった。"},{"ref":"Deut.10.11","start":5010011,"end":5010011,"break":"none","ruby":[[3,1,"しゅ"],[14,1,"た"],[20,1,"たみ"],[22,2,"さきだ"],[26,1,"すす"],[28,1,"い"],[35,1,"かれ"],[38,1,"あた"],[45,2,"せんぞ"],[48,1,"ちか"],[51,1,"ち"],[53,1,"かれ"],[64,1,"と"],[70,1,"い"]],"text":"そして主はわたしに『おまえは立ちあがり、民に先立って進み行き、わたしが彼らに与えると、その先祖に誓った地に彼らをはいらせ、それを取らせよ』と言われた。"},{"ref":"Deut.10.12","start":5010012,"end":5010012,"break":"paragraph","ruby":[[7,1,"いま"],[13,1,"かみ"],[15,1,"しゅ"],[21,1,"もと"],[26,1,"こと"],[53,1,"かみ"],[55,1,"しゅ"],[57,1,"おそ"],[66,1,"みち"],[68,1,"あゆ"],[72,1,"かれ"],[74,1,"あい"],[77,1,"こころ"],[83,2,"せいしん"],[94,1,"かみ"],[96,1,"しゅ"],[98,1,"つか"]],"text":"イスラエルよ、今、あなたの神、主があなたに求められる事はなんであるか。ただこれだけである。すなわちあなたの神、主を恐れ、そのすべての道に歩んで、彼を愛し、心をつくし、精神をつくしてあなたの神、主に仕え、"},{"ref":"Deut.10.13","start":5010013,"end":5010013,"break":"none","ruby":[[14,1,"めい"],[17,1,"しゅ"],[19,2,"めいれい"],[22,1,"さだ"],[26,1,"まも"],[35,1,"え"]],"text":"また、わたしがきょうあなたに命じる主の命令と定めとを守って、さいわいを得ることである。"},{"ref":"Deut.10.14","start":5010014,"end":5010014,"break":"none","ruby":[[0,1,"み"],[3,1,"てん"],[11,1,"てん"],[13,1,"てん"],[18,1,"ち"],[21,1,"ち"],[36,1,"かみ"],[38,1,"しゅ"]],"text":"見よ、天と、もろもろの天の天、および地と、地にあるものとはみな、あなたの神、主のものである。"},{"ref":"Deut.10.15","start":5010015,"end":5010015,"break":"none","ruby":[[8,1,"しゅ"],[16,2,"せんぞ"],[21,1,"よろこ"],[23,1,"あい"],[28,1,"のち"],[30,2,"しそん"],[41,2,"ばんみん"],[48,1,"えら"],[53,2,"こんにち"],[55,1,"み"]],"text":"そうであるのに、主はただあなたの先祖たちを喜び愛し、その後の子孫であるあなたがたを万民のうちから選ばれた。今日見るとおりである。"},{"ref":"Deut.10.16","start":5010016,"end":5010016,"break":"none","ruby":[[11,1,"こころ"],[13,2,"かつれい"],[24,2,"ごうじょう"]],"text":"それゆえ、あなたがたは心に割礼をおこない、もはや強情であってはならない。"},{"ref":"Deut.10.17","start":5010017,"end":5010017,"break":"none","ruby":[[6,1,"かみ"],[10,1,"しゅ"],[13,1,"かみ"],[15,1,"かみ"],[17,1,"しゅ"],[19,1,"しゅ"],[21,1,"おお"],[26,1,"ちから"],[29,1,"おそ"],[33,1,"かみ"],[40,1,"ひと"],[46,1,"み"],[57,1,"と"]],"text":"あなたがたの神である主は、神の神、主の主、大いにして力ある恐るべき神にましまし、人をかたより見ず、また、まいないを取らず、"},{"ref":"Deut.10.18","start":5010018,"end":5010018,"break":"none","ruby":[[3,1,"こ"],[12,1,"ただ"],[19,1,"おこな"],[24,2,"きりゅう"],[27,2,"たこく"],[29,1,"じん"],[31,1,"あい"],[35,2,"しょくもつ"],[38,2,"きもの"],[41,1,"あた"]],"text":"みなし子とやもめのために正しいさばきを行い、また寄留の他国人を愛して、食物と着物を与えられるからである。"},{"ref":"Deut.10.19","start":5010019,"end":5010019,"break":"none","ruby":[[11,2,"きりゅう"],[14,2,"たこく"],[16,1,"じん"],[18,1,"あい"],[35,1,"くに"],[37,2,"きりゅう"],[40,2,"たこく"],[42,1,"じん"]],"text":"それゆえ、あなたがたは寄留の他国人を愛しなさい。あなたがたもエジプトの国で寄留の他国人であった。"},{"ref":"Deut.10.20","start":5010020,"end":5010020,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"おそ"],[11,1,"かれ"],[13,1,"つか"],[16,1,"かれ"],[18,1,"したが"],[23,1,"な"],[28,1,"ちか"]],"text":"あなたの神、主を恐れ、彼に仕え、彼に従い、その名をさして誓わなければならない。"},{"ref":"Deut.10.21","start":5010021,"end":5010021,"break":"none","ruby":[[0,1,"かれ"],[21,1,"かみ"],[31,1,"め"],[33,1,"み"],[39,1,"おお"],[43,1,"おそ"],[47,1,"こと"],[57,1,"おこな"]],"text":"彼はあなたのさんびすべきもの、またあなたの神であって、あなたが目に見たこれらの大いなる恐るべき事を、あなたのために行われた。"},{"ref":"Deut.10.22","start":5010022,"end":5010022,"break":"none","ruby":[[4,2,"せんぞ"],[15,1,"にん"],[22,1,"くだ"],[34,1,"かみ"],[36,1,"しゅ"],[42,1,"てん"],[44,1,"ほし"],[49,1,"おお"]],"text":"あなたの先祖たちは、わずか七十人でエジプトに下ったが、いま、あなたの神、主はあなたを天の星のように多くされた。"}]