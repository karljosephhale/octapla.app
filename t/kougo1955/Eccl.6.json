[{"ref":"Eccl.6.1","start":21006001,"end":21006001,"break":"paragraph","ruby":[[4,1,"ひ"],[6,1,"した"],[11,1,"あく"],[17,1,"み"],[23,2,"ひとびと"],[26,1,"うえ"],[28,1,"おも"]],"text":"わたしは日の下に一つの悪のあるのを見た。これは人々の上に重い。"},{"ref":"Eccl.6.2","start":21006002,"end":21006002,"break":"none","ruby":[[4,1,"かみ"],[6,1,"とみ"],[9,2,"ざいさん"],[13,1,"ほまれ"],[16,1,"ひと"],[18,1,"あた"],[24,1,"こころ"],[26,1,"した"],[35,1,"か"],[53,1,"かみ"],[58,1,"ひと"],[63,1,"も"],[68,1,"ゆる"],[75,2,"たにん"],[81,1,"も"],[92,1,"くう"],[97,1,"あ"],[100,1,"やまい"]],"text":"すなわち神は富と、財産と、誉とを人に与えて、その心に慕うものを、一つも欠けることのないようにされる。しかし神は、その人にこれを持つことを許されないで、他人がこれを持つようになる。これは空である。悪しき病である。"},{"ref":"Eccl.6.3","start":21006003,"end":21006003,"break":"none","ruby":[[3,1,"ひと"],[6,1,"にん"],[8,1,"こ"],[16,1,"いのち"],[17,1,"なが"],[26,1,"ひ"],[28,1,"おお"],[35,1,"こころ"],[37,2,"こうふく"],[40,2,"まんぞく"],[47,1,"ほうむ"],[63,1,"い"],[66,2,"りゅうざん"],[69,1,"こ"],[73,1,"ひと"]],"text":"たとい人は百人の子をもうけ、また命長く、そのよわいの日が多くても、その心が幸福に満足せず、また葬られることがなければ、わたしは言う、流産の子はその人にまさると。"},{"ref":"Eccl.6.4","start":21006004,"end":21006004,"break":"none","ruby":[[7,1,"き"],[10,1,"くら"],[14,1,"なか"],[16,1,"さ"],[19,1,"い"],[24,1,"な"],[26,1,"くら"]],"text":"これはむなしく来て、暗やみの中に去って行き、その名は暗やみにおおわれる。"},{"ref":"Eccl.6.5","start":21006005,"end":21006005,"break":"none","ruby":[[5,1,"ひ"],[7,1,"み"],[10,1,"もの"],[12,1,"し"],[24,1,"かれ"],[28,1,"やす"]],"text":"またこれは日を見ず、物を知らない。けれどもこれは彼よりも安らかである。"},{"ref":"Eccl.6.6","start":21006006,"end":21006006,"break":"none","ruby":[[3,1,"かれ"],[6,1,"ねん"],[8,1,"ばい"],[13,1,"い"],[17,2,"こうふく"],[20,1,"み"],[26,1,"ひと"],[28,1,"ところ"],[30,1,"い"]],"text":"たとい彼は千年に倍するほど生きても幸福を見ない。みな一つ所に行くのではないか。"},{"ref":"Eccl.6.7","start":21006007,"end":21006007,"break":"paragraph","ruby":[[0,1,"ひと"],[2,2,"ろうく"],[5,1,"みな"],[9,1,"くち"],[22,2,"しょくよく"],[25,1,"み"]],"text":"人の労苦は皆、その口のためである。しかしその食欲は満たされない。"},{"ref":"Eccl.6.8","start":21006008,"end":21006008,"break":"none","ruby":[[0,1,"かしこ"],[2,1,"もの"],[4,1,"おろ"],[7,1,"もの"],[25,1,"い"],[28,1,"もの"],[30,1,"まえ"],[32,1,"あゆ"],[37,1,"し"],[39,1,"まず"],[42,1,"もの"]],"text":"賢い者は愚かな者になんのまさるところがあるか。また生ける者の前に歩むことを知る貧しい者もなんのまさるところがあるか。"},{"ref":"Eccl.6.9","start":21006009,"end":21006009,"break":"none","ruby":[[0,1,"め"],[2,1,"み"],[4,1,"こと"],[6,2,"よくぼう"],[13,1,"ある"],[25,1,"くう"],[31,1,"かぜ"],[33,1,"とら"]],"text":"目に見る事は欲望のさまよい歩くにまさる。これもまた空であって、風を捕えるようなものである。"},{"ref":"Eccl.6.10","start":21006010,"end":21006010,"break":"paragraph","ruby":[[0,1,"いま"],[12,1,"な"],[23,1,"ひと"],[29,1,"もの"],[35,1,"し"],[43,1,"ひと"],[45,2,"じぶん"],[50,2,"ちからづよ"],[53,1,"もの"],[55,1,"あらそ"]],"text":"今あるものは、すでにその名がつけられた。そして人はいかなる者であるかは知られた。それで人は自分よりも力強い者と争うことはできない。"},{"ref":"Eccl.6.11","start":21006011,"end":21006011,"break":"none","ruby":[[0,2,"ことば"],[3,1,"おお"],[11,1,"こと"],[13,1,"おお"],[16,1,"ひと"],[21,1,"えき"]],"text":"言葉が多ければむなしい事も多い。人になんの益があるか。"},{"ref":"Eccl.6.12","start":21006012,"end":21006012,"break":"none","ruby":[[0,1,"ひと"],[4,1,"みじか"],[11,1,"いのち"],[13,1,"ひ"],[15,1,"かげ"],[20,1,"おく"],[25,1,"なに"],[27,1,"ひと"],[32,1,"ぜん"],[38,1,"し"],[53,1,"み"],[55,1,"のち"],[58,1,"ひ"],[60,1,"した"],[62,1,"なに"],[72,1,"ひと"],[74,1,"つ"]],"text":"人はその短く、むなしい命の日を影のように送るのに、何が人のために善であるかを知ることができよう。だれがその身の後に、日の下に何があるであろうかを人に告げることができるか。"}]