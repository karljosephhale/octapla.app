[{"ref":"Hos.3.1","start":28003001,"end":28003001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"ふたた"],[18,1,"い"],[28,2,"ひとびと"],[31,1,"た"],[33,2,"かみがみ"],[36,1,"てん"],[40,1,"ほし"],[45,2,"かし"],[48,1,"あい"],[59,1,"しゅ"],[64,1,"あい"],[73,2,"かんぷ"],[76,1,"あい"],[81,1,"おんな"],[83,2,"かんいん"],[86,1,"おこな"],[88,1,"おんな"],[90,1,"あい"]],"text":"主はわたしに言われた、「あなたは再び行って、イスラエルの人々が他の神々に転じて、干ぶどうの菓子を愛するにもかかわらず、主がこれを愛せられるように、姦夫に愛せられる女、姦淫を行う女を愛せよ」と。"},{"ref":"Hos.3.2","start":28003002,"end":28003002,"break":"none","ruby":[[7,1,"ぎん"],[14,2,"おおむぎ"],[20,1,"はん"],[26,2,"かのじょ"],[29,1,"か"],[31,1,"と"]],"text":"そこでわたしは銀十五シケルと大麦一ホメル半とをもって彼女を買い取った。"},{"ref":"Hos.3.3","start":28003003,"end":28003003,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"い"],[16,1,"なが"],[22,1,"ところ"],[30,2,"いんこう"],[39,1,"た"],[41,1,"ひと"]],"text":"わたしは彼女に言った、「あなたは長くわたしの所にとどまって、淫行をなさず、また他の人のものとなってはならない。わたしもまた、あなたにそうしよう」と。"},{"ref":"Hos.3.4","start":28003004,"end":28003004,"break":"none","ruby":[[6,1,"こ"],[9,1,"おお"],[12,1,"ひ"],[14,1,"あいだ"],[16,1,"おう"],[20,1,"きみ"],[24,2,"ぎせい"],[29,1,"はしら"],[46,1,"す"]],"text":"イスラエルの子らは多くの日の間、王なく、君なく、犠牲なく、柱なく、エポデおよびテラピムもなく過ごす。"},{"ref":"Hos.3.5","start":28003005,"end":28003005,"break":"none","ruby":[[5,1,"のち"],[12,1,"こ"],[15,1,"かえ"],[18,1,"き"],[23,1,"かみ"],[25,1,"しゅ"],[30,1,"おう"],[39,1,"もと"],[42,1,"おわ"],[45,1,"ひ"],[53,1,"しゅ"],[57,1,"めぐ"],[60,1,"む"],[64,1,"く"]],"text":"そしてその後イスラエルの子らは帰って来て、その神、主と、その王ダビデとをたずね求め、終りの日におののいて、主とその恵みに向かって来る。"}]