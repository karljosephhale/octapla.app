[{"ref":"Isa.32.1","start":23032001,"end":23032001,"break":"paragraph","breaks":[[9,"line"],[20,"line"]],"ruby":[[0,1,"み"],[7,1,"おう"],[9,2,"せいぎ"],[15,1,"す"],[17,1,"おさ"],[20,1,"きみ"],[24,2,"こうへい"]],"text":"見よ、ひとりの王が正義をもって統べ治め、君たちは公平をもってつかさどり、"},{"ref":"Isa.32.2","start":23032002,"end":23032002,"break":"line","breaks":[[11,"line"],[27,"line"],[44,"line"]],"ruby":[[4,1,"かぜ"],[9,1,"ところ"],[11,3,"ぼうふうう"],[19,1,"ところ"],[31,1,"ところ"],[35,1,"みず"],[37,1,"なが"],[44,1,"つか"],[47,1,"ち"],[51,1,"おお"],[54,1,"いわ"],[56,1,"かげ"]],"text":"おのおの風をさける所、暴風雨をのがれる所のようになり、かわいた所にある水の流れのように、疲れた地にある大きな岩の陰のようになる。"},{"ref":"Isa.32.3","start":23032003,"end":23032003,"break":"line","breaks":[[15,"line"]],"ruby":[[5,1,"み"],[7,1,"もの"],[9,1,"め"],[11,1,"ひら"],[15,1,"き"],[17,1,"もの"],[19,1,"みみ"],[23,1,"き"]],"text":"こうして、見る者の目は開かれ、聞く者の耳はよく聞き、"},{"ref":"Isa.32.4","start":23032004,"end":23032004,"break":"line","breaks":[[14,"line"],[25,"line"]],"ruby":[[0,2,"きみじか"],[3,1,"もの"],[5,1,"こころ"],[7,1,"さと"],[9,2,"ちしき"],[12,1,"え"],[18,1,"した"],[30,1,"かた"]],"text":"気短な者の心は悟る知識を得、どもりの舌はたやすく、あざやかに語ることができる。"},{"ref":"Isa.32.5","start":23032005,"end":23032005,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[9,1,"たっと"],[11,1,"ひと"],[13,1,"よ"],[22,2,"あくにん"],[33,1,"ひと"],[35,1,"い"]],"text":"愚かな者は、もはや尊い人と呼ばれることなく、悪人はもはや、りっぱな人と言われることはない。"},{"ref":"Isa.32.6","start":23032006,"end":23032006,"break":"line","breaks":[[17,"line"],[37,"line"],[51,"line"],[64,"line"]],"ruby":[[3,1,"おろ"],[6,1,"もの"],[8,1,"おろ"],[14,1,"かた"],[19,1,"こころ"],[21,2,"ふぎ"],[34,1,"おこな"],[37,1,"しゅ"],[42,1,"あやま"],[48,1,"かた"],[51,1,"う"],[54,1,"もの"],[56,1,"のぞ"],[59,1,"み"],[68,1,"もの"],[70,1,"の"],[72,1,"もの"],[74,1,"うば"],[76,1,"と"]],"text":"それは愚かな者は愚かなことを語り、その心は不義をたくらみ、よこしまを行い、主について誤ったことを語り、飢えた者の望みを満たさず、かわいた者の飲み物を奪い取るからである。"},{"ref":"Isa.32.7","start":23032007,"end":23032007,"break":"line","breaks":[[9,"line"],[23,"line"],[43,"line"],[59,"line"]],"ruby":[[0,2,"あくにん"],[3,1,"おこな"],[6,1,"わる"],[9,1,"かれ"],[11,1,"わる"],[13,1,"はか"],[23,1,"いつわ"],[26,2,"ことば"],[32,1,"まず"],[35,1,"もの"],[43,1,"とぼ"],[46,1,"もの"],[48,1,"ただ"],[54,1,"かた"]],"text":"悪人の行いは悪い。彼は悪い計りごとをめぐらし、偽りの言葉をもって貧しい者をおとしいれ、乏しい者が正しいことを語っても、なお、これをおとしいれる。"},{"ref":"Isa.32.8","start":23032008,"end":23032008,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"たっと"],[5,1,"ひと"],[7,1,"たっと"],[12,1,"かた"],[18,1,"たっと"],[23,1,"おこな"]],"text":"しかし尊い人は尊いことを語り、つねに尊いことを行う。"},{"ref":"Isa.32.9","start":23032009,"end":23032009,"break":"paragraph","breaks":[[22,"line"]],"ruby":[[0,1,"やす"],[6,1,"おんな"],[11,1,"お"],[17,1,"こえ"],[19,1,"き"],[22,1,"おも"],[24,1,"わずら"],[28,1,"むすめ"],[35,2,"ことば"],[38,1,"みみ"],[40,1,"かたむ"]],"text":"安んじている女たちよ、起きて、わが声を聞け。思い煩いなき娘たちよ、わが言葉に耳を傾けよ。"},{"ref":"Isa.32.10","start":23032010,"end":23032010,"break":"line","breaks":[[11,"line"],[23,"line"],[36,"line"],[48,"line"]],"ruby":[[0,1,"おも"],[2,1,"わずら"],[6,1,"おんな"],[12,1,"ねん"],[17,1,"ひ"],[29,1,"ふる"],[40,2,"しゅうかく"],[48,1,"み"],[50,1,"と"],[52,1,"い"],[55,1,"とき"],[57,1,"こ"]],"text":"思い煩いなき女たちよ、一年あまりの日をすぎて、あなたがたは震えおののく。ぶどうの収穫がむなしく、実を取り入れる時が来ないからだ。"},{"ref":"Isa.32.11","start":23032011,"end":23032011,"break":"line","breaks":[[17,"line"],[35,"line"]],"ruby":[[0,1,"やす"],[6,1,"おんな"],[11,1,"ふる"],[13,1,"おそ"],[17,1,"おも"],[19,1,"わずら"],[23,1,"おんな"],[28,1,"ふる"],[35,1,"ころも"],[37,1,"ぬ"],[40,1,"はだか"],[45,1,"こし"],[47,2,"あらぬの"]],"text":"安んじている女たちよ、震え恐れよ。思い煩いなき女たちよ、震えおののけ。衣を脱ぎ、裸になって腰に荒布をまとえ。"},{"ref":"Isa.32.12","start":23032012,"end":23032012,"break":"line","breaks":[[7,"line"]],"ruby":[[0,1,"よ"],[2,1,"はたけ"],[7,1,"みの"],[9,1,"ゆた"],[16,1,"き"],[21,1,"むね"],[23,1,"う"]],"text":"良き畑のため、実り豊かなぶどうの木のために胸を打て。"},{"ref":"Isa.32.13","start":23032013,"end":23032013,"break":"line","breaks":[[22,"line"],[34,"line"]],"ruby":[[8,1,"は"],[15,1,"たみ"],[17,1,"ち"],[22,1,"よろこ"],[25,1,"み"],[30,1,"まち"],[38,1,"よろこ"],[41,1,"いえ"],[46,1,"むね"],[48,1,"う"]],"text":"いばら、おどろの生えているわが民の地のため、喜びに満ちている町にあるすべての喜びの家のために胸を打て。"},{"ref":"Isa.32.14","start":23032014,"end":23032014,"break":"line","breaks":[[21,"line"],[42,"line"],[52,"line"]],"ruby":[[0,2,"きゅうでん"],[3,1,"す"],[13,1,"まち"],[15,1,"あ"],[21,1,"おか"],[37,1,"あな"],[42,1,"の"],[47,1,"たの"],[50,1,"ところ"],[52,1,"ひつじ"],[54,1,"む"],[57,2,"まきば"]],"text":"宮殿は捨てられ、にぎわった町は荒れすたれ、丘と、やぐらとは、とこしえにほら穴となり、野のろばの楽しむ所、羊の群れの牧場となるからである。"},{"ref":"Isa.32.15","start":23032015,"end":23032015,"break":"line","breaks":[[13,"line"],[26,"line"],[36,"line"]],"ruby":[[8,1,"れい"],[10,1,"うえ"],[18,1,"うえ"],[26,2,"あらの"],[29,1,"よ"],[31,1,"はたけ"],[36,1,"よ"],[38,1,"はたけ"],[40,1,"はやし"],[45,1,"み"]],"text":"しかし、ついには霊が上からわれわれの上にそそがれて、荒野は良き畑となり、良き畑は林のごとく見られるようになる。"},{"ref":"Isa.32.16","start":23032016,"end":23032016,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"とき"],[4,2,"こうへい"],[7,2,"あらの"],[10,1,"す"],[13,2,"せいぎ"],[16,1,"よ"],[18,1,"はたけ"]],"text":"その時、公平は荒野に住み、正義は良き畑にやどる。"},{"ref":"Isa.32.17","start":23032017,"end":23032017,"break":"line","breaks":[[9,"line"]],"ruby":[[0,2,"せいぎ"],[3,2,"へいわ"],[6,1,"しょう"],[9,2,"せいぎ"],[12,1,"むす"],[14,1,"み"],[21,2,"へいあん"],[24,2,"しんらい"]],"text":"正義は平和を生じ、正義の結ぶ実はとこしえの平安と信頼である。"},{"ref":"Isa.32.18","start":23032018,"end":23032018,"break":"line","breaks":[[12,"line"],[23,"line"]],"ruby":[[2,1,"たみ"],[4,2,"へいわ"],[7,1,"いえ"],[12,1,"やす"],[23,1,"しず"],[26,1,"やす"],[28,1,"どころ"]],"text":"わが民は平和の家におり、安らかなすみかにおり、静かな休み所におる。"},{"ref":"Isa.32.19","start":23032019,"end":23032019,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"はやし"],[10,1,"き"],[12,1,"たお"],[16,1,"まち"],[23,1,"たお"]],"text":"しかし林はことごとく切り倒され、町もことごとく倒される。"},{"ref":"Isa.32.20","start":23032020,"end":23032020,"break":"line","breaks":[[15,"line"],[36,"line"]],"ruby":[[4,1,"みず"],[10,1,"たね"],[15,1,"うし"],[22,2,"じゆう"],[25,1,"はな"]],"text":"すべての水のほとりに種をまき、牛およびろばを自由に放ちおくあなたがたは、さいわいである。"}]