[{"ref":"Ps.127.1","start":19127001,"end":19127001,"break":"paragraph","title":"ソロモンがよんだ都もうでの歌","breaks":[[16,"line"],[29,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"いえ"],[4,1,"た"],[16,1,"た"],[19,1,"もの"],[21,2,"きんろう"],[29,1,"しゅ"],[31,1,"まち"],[33,1,"まも"],[44,1,"まも"],[46,1,"もの"]],"titleRuby":[[8,1,"みやこ"],[13,1,"うた"]],"text":"主が家を建てられるのでなければ、建てる者の勤労はむなしい。主が町を守られるのでなければ、守る者のさめているのはむなしい。"},{"ref":"Ps.127.2","start":19127002,"end":19127002,"break":"line","breaks":[[17,"line"],[40,"line"],[59,"line"]],"ruby":[[6,1,"はや"],[8,1,"お"],[14,1,"やす"],[17,2,"しんく"],[23,1,"た"],[40,1,"しゅ"],[44,1,"あい"],[47,1,"もの"],[50,1,"ねむ"],[55,1,"とき"],[68,1,"あた"]],"text":"あなたがたが早く起き、おそく休み、辛苦のかてを食べることは、むなしいことである。主はその愛する者に、眠っている時にも、なくてならぬものを与えられるからである。"},{"ref":"Ps.127.3","start":19127003,"end":19127003,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"み"],[3,2,"こども"],[8,1,"かみ"],[11,1,"たま"],[15,1,"し"],[16,1,"ぎょう"],[21,1,"たい"],[23,1,"み"],[25,1,"むく"],[28,2,"たまもの"]],"text":"見よ、子供たちは神から賜わった嗣業であり、胎の実は報いの賜物である。"},{"ref":"Ps.127.4","start":19127004,"end":19127004,"break":"line","ruby":[[0,2,"そうねん"],[3,1,"とき"],[5,2,"こども"],[8,2,"ゆうし"],[11,1,"て"],[15,1,"や"]],"text":"壮年の時の子供は勇士の手にある矢のようだ。"},{"ref":"Ps.127.5","start":19127005,"end":19127005,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"や"],[2,1,"み"],[5,2,"やづつ"],[8,1,"も"],[10,1,"ひと"],[20,1,"かれ"],[22,1,"もん"],[24,1,"てき"],[26,2,"ものい"],[31,1,"は"]],"text":"矢の満ちた矢筒を持つ人はさいわいである。彼は門で敵と物言うとき恥じることはない。"}]