[{"ref":"Gen.28.1","start":1028001,"end":1028001,"break":"paragraph","ruby":[[8,1,"よ"],[15,2,"しゅくふく"],[19,1,"めい"],[22,1,"い"],[35,1,"むすめ"],[37,1,"つま"]],"text":"イサクはヤコブを呼んで、これを祝福し、命じて言った、「あなたはカナンの娘を妻にめとってはならない。"},{"ref":"Gen.28.2","start":1028002,"end":1028002,"break":"none","ruby":[[0,1,"た"],[10,1,"い"],[17,1,"はは"],[19,1,"ちち"],[25,1,"いえ"],[27,1,"い"],[38,1,"はは"],[40,1,"あに"],[45,1,"むすめ"],[47,1,"つま"]],"text":"立ってパダンアラムへ行き、あなたの母の父ベトエルの家に行って、そこであなたの母の兄ラバンの娘を妻にめとりなさい。"},{"ref":"Gen.28.3","start":1028003,"end":1028003,"break":"none","ruby":[[0,2,"ぜんのう"],[3,1,"かみ"],[10,2,"しゅくふく"],[14,1,"おお"],[17,1,"こ"],[19,1,"え"],[31,1,"おお"],[34,2,"こくみん"]],"text":"全能の神が、あなたを祝福し、多くの子を得させ、かつふえさせて、多くの国民とし、"},{"ref":"Gen.28.4","start":1028004,"end":1028004,"break":"none","ruby":[[8,2,"しゅくふく"],[15,2,"しそん"],[19,1,"あた"],[23,1,"かみ"],[31,1,"さづ"],[40,2,"きりゅう"],[43,1,"ち"],[45,1,"つ"]],"text":"またアブラハムの祝福をあなたと子孫とに与えて、神がアブラハムに授けられたあなたの寄留の地を継がせてくださるように」。"},{"ref":"Gen.28.5","start":1028005,"end":1028005,"break":"none","ruby":[[12,1,"おく"],[14,1,"だ"],[29,1,"む"],[43,1,"こ"],[55,1,"はは"],[60,1,"あに"],[68,1,"い"]],"text":"こうしてイサクはヤコブを送り出した。ヤコブはパダンアラムに向かい、アラムびとベトエルの子で、ヤコブとエサウとの母リベカの兄ラバンのもとへ行った。"},{"ref":"Gen.28.6","start":1028006,"end":1028006,"break":"paragraph","ruby":[[15,2,"しゅくふく"],[36,1,"つま"],[50,1,"かれ"],[52,2,"しゅくふく"],[56,1,"めい"],[68,1,"むすめ"],[70,1,"つま"],[83,1,"い"]],"text":"さてエサウは、イサクがヤコブを祝福して、パダンアラムにつかわし、そこから妻をめとらせようとしたこと、彼を祝福し、命じて「あなたはカナンの娘を妻にめとってはならない」と言ったこと、"},{"ref":"Gen.28.7","start":1028007,"end":1028007,"break":"none","ruby":[[7,2,"ふぼ"],[10,2,"ことば"],[13,1,"したが"],[24,1,"い"],[30,1,"し"]],"text":"そしてヤコブが父母の言葉に従って、パダンアラムへ行ったことを知ったとき、"},{"ref":"Gen.28.8","start":1028008,"end":1028008,"break":"none","ruby":[[0,1,"かれ"],[6,1,"むすめ"],[8,1,"ちち"],[13,1,"こころ"],[22,1,"み"]],"text":"彼はカナンの娘が父イサクの心にかなわないのを見た。"},{"ref":"Gen.28.9","start":1028009,"end":1028009,"break":"none","ruby":[[13,1,"ところ"],[15,1,"い"],[23,1,"つま"],[36,1,"こ"],[43,1,"むすめ"],[51,1,"いもうと"],[57,1,"つま"]],"text":"そこでエサウはイシマエルの所に行き、すでにある妻たちのほかにアブラハムの子イシマエルの娘で、ネバヨテの妹マハラテを妻にめとった。"},{"ref":"Gen.28.10","start":1028010,"end":1028010,"break":"paragraph","ruby":[[12,1,"た"],[20,1,"む"]],"text":"さてヤコブはベエルシバを立って、ハランへ向かったが、"},{"ref":"Gen.28.11","start":1028011,"end":1028011,"break":"none","ruby":[[3,1,"ところ"],[5,1,"つ"],[8,1,"とき"],[10,1,"ひ"],[12,1,"く"],[22,1,"や"],[24,1,"す"],[30,1,"ところ"],[32,1,"いし"],[34,1,"と"],[46,1,"ふ"],[49,1,"ね"]],"text":"一つの所に着いた時、日が暮れたので、そこに一夜を過ごし、その所の石を取ってまくらとし、そこに伏して寝た。"},{"ref":"Gen.28.12","start":1028012,"end":1028012,"break":"none","ruby":[[0,1,"とき"],[2,1,"かれ"],[4,1,"ゆめ"],[16,1,"ち"],[18,1,"うえ"],[20,1,"た"],[28,1,"いただき"],[30,1,"てん"],[32,1,"たっ"],[35,1,"かみ"],[37,1,"つかい"],[44,1,"のぼ"],[46,1,"くだ"],[54,1,"み"]],"text":"時に彼は夢をみた。一つのはしごが地の上に立っていて、その頂は天に達し、神の使たちがそれを上り下りしているのを見た。"},{"ref":"Gen.28.13","start":1028013,"end":1028013,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"かれ"],[10,1,"た"],[13,1,"い"],[27,1,"ちち"],[34,1,"かみ"],[40,1,"かみ"],[42,1,"しゅ"],[51,1,"ふ"],[56,1,"ち"],[63,2,"しそん"],[67,1,"あた"]],"text":"そして主は彼のそばに立って言われた、「わたしはあなたの父アブラハムの神、イサクの神、主である。あなたが伏している地を、あなたと子孫とに与えよう。"},{"ref":"Gen.28.14","start":1028014,"end":1028014,"break":"none","ruby":[[4,2,"しそん"],[7,1,"ち"],[15,1,"おお"],[21,1,"にし"],[23,1,"ひがし"],[25,1,"きた"],[27,1,"みなみ"],[34,1,"ち"],[36,1,"しょ"],[37,1,"ぞく"],[43,2,"しそん"],[50,2,"しゅくふく"]],"text":"あなたの子孫は地のちりのように多くなって、西、東、北、南にひろがり、地の諸族はあなたと子孫とによって祝福をうけるであろう。"},{"ref":"Gen.28.15","start":1028015,"end":1028015,"break":"none","ruby":[[8,1,"とも"],[20,1,"い"],[28,1,"まも"],[37,1,"ち"],[39,1,"つ"],[41,1,"かえ"],[52,1,"けっ"],[59,1,"す"],[67,1,"かた"],[70,1,"こと"],[72,1,"おこな"]],"text":"わたしはあなたと共にいて、あなたがどこへ行くにもあなたを守り、あなたをこの地に連れ帰るであろう。わたしは決してあなたを捨てず、あなたに語った事を行うであろう」。"},{"ref":"Gen.28.16","start":1028016,"end":1028016,"break":"none","ruby":[[4,1,"ねむ"],[11,1,"い"],[20,1,"しゅ"],[24,1,"ところ"],[37,1,"し"]],"text":"ヤコブは眠りからさめて言った、「まことに主がこの所におられるのに、わたしは知らなかった」。"},{"ref":"Gen.28.17","start":1028017,"end":1028017,"break":"none","ruby":[[3,1,"かれ"],[5,1,"おそ"],[8,1,"い"],[21,1,"おそ"],[25,1,"ところ"],[33,1,"かみ"],[35,1,"いえ"],[43,1,"てん"],[45,1,"もん"]],"text":"そして彼は恐れて言った、「これはなんという恐るべき所だろう。これは神の家である。これは天の門だ」。"},{"ref":"Gen.28.18","start":1028018,"end":1028018,"break":"paragraph","ruby":[[4,1,"あさ"],[8,1,"お"],[20,1,"いし"],[22,1,"と"],[28,1,"た"],[31,1,"はしら"],[37,1,"いただき"],[39,1,"あぶら"],[41,1,"そそ"]],"text":"ヤコブは朝はやく起きて、まくらとしていた石を取り、それを立てて柱とし、その頂に油を注いで、"},{"ref":"Gen.28.19","start":1028019,"end":1028019,"break":"none","ruby":[[2,1,"ところ"],[4,1,"な"],[10,1,"な"],[17,1,"まち"],[19,1,"な"],[21,1,"はじ"]],"text":"その所の名をベテルと名づけた。その町の名は初めはルズといった。"},{"ref":"Gen.28.20","start":1028020,"end":1028020,"break":"none","ruby":[[4,1,"ちか"],[7,1,"た"],[10,1,"い"],[15,1,"かみ"],[21,1,"とも"],[31,1,"い"],[35,1,"みち"],[41,1,"まも"],[44,1,"た"],[50,1,"き"],[52,2,"きもの"],[55,1,"たま"]],"text":"ヤコブは誓いを立てて言った、「神がわたしと共にいまし、わたしの行くこの道でわたしを守り、食べるパンと着る着物を賜い、"},{"ref":"Gen.28.21","start":1028021,"end":1028021,"break":"none","ruby":[[0,1,"やす"],[4,1,"ちち"],[6,1,"いえ"],[8,1,"かえ"],[19,1,"しゅ"],[25,1,"かみ"]],"text":"安らかに父の家に帰らせてくださるなら、主をわたしの神といたしましょう。"},{"ref":"Gen.28.22","start":1028022,"end":1028022,"break":"none","ruby":[[6,1,"はしら"],[8,1,"た"],[13,1,"いし"],[15,1,"かみ"],[17,1,"いえ"],[42,1,"もの"],[45,1,"ぶん"],[54,1,"かなら"]],"text":"またわたしが柱に立てたこの石を神の家といたしましょう。そしてあなたがくださるすべての物の十分の一を、わたしは必ずあなたにささげます」。"}]