[{"ref":"Isa.56.1","start":23056001,"end":23056001,"break":"paragraph","breaks":[[9,"line"],[28,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[16,2,"こうへい"],[19,1,"まも"],[22,2,"せいぎ"],[25,1,"おこな"],[30,1,"すくい"],[32,1,"く"],[36,1,"ちか"],[41,1,"たす"],[51,1,"ちか"]],"text":"主はこう言われる、「あなたがたは公平を守って正義を行え。わが救の来るのは近く、わが助けのあらわれるのが近いからだ。"},{"ref":"Isa.56.2","start":23056002,"end":23056002,"break":"line","breaks":[[15,"line"],[32,"line"],[41,"line"]],"ruby":[[0,3,"あんそくにち"],[4,1,"まも"],[11,1,"けが"],[17,1,"て"],[24,1,"あ"],[27,1,"こと"],[37,1,"おこな"],[39,1,"ひと"],[44,1,"かた"],[46,1,"まも"],[48,1,"ひと"],[50,1,"こ"]],"text":"安息日を守って、これを汚さず、その手をおさえて、悪しき事をせず、このように行う人、これを堅く守る人の子はさいわいである」。"},{"ref":"Isa.56.3","start":23056003,"end":23056003,"break":"line","breaks":[[21,"line"],[43,"line"],[57,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"つら"],[8,3,"いほうじん"],[12,1,"い"],[22,1,"しゅ"],[24,1,"かなら"],[32,1,"たみ"],[35,1,"わ"],[43,2,"かんがん"],[48,1,"い"],[58,1,"み"],[65,1,"か"],[67,1,"き"]],"text":"主に連なっている異邦人は言ってはならない、「主は必ずわたしをその民から分かたれる」と。宦官もまた言ってはならない、「見よ、わたしは枯れ木だ」と。"},{"ref":"Isa.56.4","start":23056004,"end":23056004,"break":"line","breaks":[[9,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[12,3,"あんそくにち"],[16,1,"まも"],[21,1,"よろこ"],[26,1,"えら"],[32,2,"けいやく"],[35,1,"かた"],[37,1,"まも"],[39,2,"かんがん"]],"text":"主はこう言われる、「わが安息日を守り、わが喜ぶことを選んで、わが契約を堅く守る宦官には、"},{"ref":"Isa.56.5","start":23056005,"end":23056005,"break":"line","breaks":[[16,"line"],[39,"line"]],"ruby":[[2,1,"いえ"],[10,1,"かき"],[21,1,"むすめ"],[27,2,"きねん"],[34,1,"な"],[36,1,"あた"],[39,1,"た"],[53,1,"な"],[55,1,"あた"]],"text":"わが家のうちで、わが垣のうちで、むすこにも娘にもまさる記念のしるしと名を与え、絶えることのない、とこしえの名を与える。"},{"ref":"Isa.56.6","start":23056006,"end":23056006,"break":"line","breaks":[[13,"line"],[29,"line"],[47,"line"]],"ruby":[[2,1,"しゅ"],[4,1,"つら"],[8,1,"しゅ"],[10,1,"つか"],[13,1,"しゅ"],[15,1,"な"],[17,1,"あい"],[32,3,"あんそくにち"],[36,1,"まも"],[43,1,"けが"],[49,2,"けいやく"],[52,1,"かた"],[54,1,"まも"],[56,3,"いほうじん"]],"text":"また主に連なり、主に仕え、主の名を愛し、そのしもべとなり、すべて安息日を守って、これを汚さず、わが契約を堅く守る異邦人は――"},{"ref":"Isa.56.7","start":23056007,"end":23056007,"break":"line","breaks":[[18,"line"],[33,"line"],[44,"line"],[59,"line"],[69,"line"]],"ruby":[[9,1,"せい"],[12,1,"やま"],[20,1,"いのり"],[22,1,"いえ"],[27,1,"たの"],[33,1,"かれ"],[36,2,"はんさい"],[39,2,"ぎせい"],[46,2,"さいだん"],[49,1,"うえ"],[51,1,"う"],[61,1,"いえ"],[67,1,"たみ"],[69,1,"いのり"],[71,1,"いえ"]],"text":"わたしはこれをわが聖なる山にこさせ、わが祈の家のうちで楽しませる、彼らの燔祭と犠牲とは、わが祭壇の上に受けいれられる。わが家はすべての民の祈の家ととなえられるからである」。"},{"ref":"Isa.56.8","start":23056008,"end":23056008,"break":"line","breaks":[[19,"line"],[31,"line"],[45,"line"]],"ruby":[[6,1,"お"],[12,1,"もの"],[14,1,"あつ"],[19,1,"しゅ"],[22,1,"かみ"],[26,1,"い"],[39,1,"ひと"],[41,1,"あつ"],[48,1,"あつ"],[53,1,"もの"],[55,1,"くわ"]],"text":"イスラエルの追いやられた者を集められる主なる神はこう言われる、「わたしはさらに人を集めて、すでに集められた者に加えよう」と。"},{"ref":"Isa.56.9","start":23056009,"end":23056009,"break":"paragraph","breaks":[[9,"line"]],"ruby":[[0,1,"の"],[6,1,"けもの"],[9,1,"はやし"],[17,1,"けもの"],[20,1,"き"],[22,1,"く"]],"text":"野のすべての獣よ、林におるすべての獣よ、来て食らえ。"},{"ref":"Isa.56.10","start":23056010,"end":23056010,"break":"line","breaks":[[20,"line"],[40,"line"],[54,"line"]],"ruby":[[0,2,"みはり"],[2,1,"にん"],[7,1,"め"],[12,1,"し"],[26,1,"いぬ"],[42,1,"ゆめ"],[45,1,"もの"],[47,1,"ふ"],[52,1,"もの"],[61,1,"この"],[63,1,"もの"]],"text":"見張人らはみな目しいで、知ることがなく、みな、おしの犬で、ほえることができない。みな夢みる者、伏している者、まどろむことを好む者だ。"},{"ref":"Isa.56.11","start":23056011,"end":23056011,"break":"line","breaks":[[20,"line"],[38,"line"],[50,"line"]],"ruby":[[2,1,"いぬ"],[6,2,"ごうよく"],[10,1,"あ"],[15,1,"し"],[20,1,"かれ"],[25,1,"さと"],[34,2,"ぼくしゃ"],[38,1,"みな"],[42,1,"みち"],[61,1,"り"],[63,1,"もと"]],"text":"この犬どもは強欲で、飽くことを知らない。彼らはまた悟ることのできない牧者で、皆おのが道にむかいゆき、おのおのみな、おのれの利を求める。"},{"ref":"Isa.56.12","start":23056012,"end":23056012,"break":"line","breaks":[[8,"line"],[24,"line"],[37,"line"],[54,"line"]],"ruby":[[0,1,"かれ"],[3,1,"たがい"],[5,1,"い"],[17,1,"さけ"],[19,1,"て"],[21,1,"い"],[24,1,"こ"],[26,1,"さけ"],[33,1,"の"],[59,1,"ひ"]],"text":"彼らは互に言う、「さあ、われわれは酒を手に入れ、濃い酒をあびるほど飲もう。あすも、きょうのようであるだろう、すばらしい日だ」と。"}]