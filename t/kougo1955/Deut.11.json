[{"ref":"Deut.11.1","start":5011001,"end":5011001,"break":"paragraph","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[13,1,"あい"],[16,1,"つね"],[25,1,"さだ"],[34,1,"いまし"],[38,1,"まも"]],"text":"それゆえ、あなたの神、主を愛し、常にそのさとしと、定めと、おきてと、戒めとを守らなければならない。"},{"ref":"Deut.11.2","start":5011002,"end":5011002,"break":"none","ruby":[[11,1,"つぎ"],[16,1,"し"],[31,1,"かた"],[42,2,"こども"],[47,1,"たい"],[55,1,"かれ"],[64,1,"かみ"],[66,1,"しゅ"],[68,2,"くんれん"],[72,1,"しゅ"],[74,1,"おお"],[78,1,"こと"],[83,1,"つよ"],[85,1,"て"],[88,1,"の"],[91,1,"うで"],[94,1,"し"],[100,1,"み"]],"text":"あなたがたは、きょう、次のことを知らなければならない。わたしが語るのは、あなたがたの子供たちに対してではない。彼らはあなたがたの神、主の訓練と、主の大いなる事と、その強い手と、伸べた腕とを知らず、また見なかった。"},{"ref":"Deut.11.3","start":5011003,"end":5011003,"break":"none","ruby":[[2,1,"かれ"],[5,1,"しゅ"],[17,1,"おう"],[23,2,"ぜんこく"],[26,1,"たい"],[29,1,"おこな"]],"text":"また彼らは主がエジプトで、エジプト王パロとその全国に対して行われたしるしと、わざ、"},{"ref":"Deut.11.4","start":5011004,"end":5011004,"break":"none","ruby":[[2,1,"しゅ"],[9,2,"ぐんぜい"],[14,1,"うま"],[16,2,"せんしゃ"],[20,1,"おこな"],[24,1,"こと"],[30,1,"かれ"],[42,1,"お"],[47,1,"とき"],[50,2,"こうかい"],[53,1,"みず"],[55,1,"かれ"],[58,1,"うえ"],[66,1,"かれ"],[69,1,"ほろ"],[75,2,"こんにち"],[78,1,"いた"],[81,1,"こと"]],"text":"また主がエジプトの軍勢とその馬と戦車とに行われた事、すなわち彼らがあなたがたのあとを追ってきた時に、紅海の水を彼らの上にあふれさせ、彼らを滅ぼされて、今日に至った事、"},{"ref":"Deut.11.5","start":5011005,"end":5011005,"break":"none","ruby":[[10,1,"ところ"],[12,1,"く"],[17,1,"しゅ"],[19,2,"あらの"],[29,1,"おこな"],[33,1,"こと"]],"text":"またあなたがたがこの所に来るまで、主が荒野で、あなたがたに行われた事、"},{"ref":"Deut.11.6","start":5011006,"end":5011006,"break":"none","ruby":[[7,1,"こ"],[14,1,"こ"],[29,1,"こと"],[45,2,"ひとびと"],[48,1,"なか"],[51,1,"ち"],[53,1,"くち"],[55,1,"ひら"],[58,1,"かれ"],[64,2,"かぞく"],[68,2,"てんまく"],[72,1,"かれ"],[75,1,"したが"],[91,1,"こと"],[95,1,"かれ"],[98,1,"し"],[104,1,"み"]],"text":"およびルベンの子のエリアブの子、ダタンとアビラムとにされた事、すなわちイスラエルのすべての人々の中で、地が口を開き、彼らと、その家族と、天幕と、彼らに従うすべてのものを、のみつくした事などを彼らは知らず、また見なかった。"},{"ref":"Deut.11.7","start":5011007,"end":5011007,"break":"none","ruby":[[10,1,"しゅ"],[12,1,"おこな"],[20,1,"おお"],[24,1,"こと"],[32,1,"め"],[34,1,"み"]],"text":"しかし、あなたがたは主が行われたこれらの大いなる事を、ことごとく目に見たのである。"},{"ref":"Deut.11.8","start":5011008,"end":5011008,"break":"paragraph","ruby":[[19,1,"めい"],[22,1,"いまし"],[31,1,"まも"],[53,1,"つよ"],[58,1,"わた"],[61,1,"い"],[64,1,"と"],[70,1,"ち"],[80,1,"と"]],"text":"ゆえに、わたしが、きょう、あなたがたに命じる戒めを、ことごとく守らなければならない。そうすればあなたがたは強くなり、渡って行って取ろうとする地にはいって、それを取ることができ、"},{"ref":"Deut.11.9","start":5011009,"end":5011009,"break":"none","ruby":[[3,1,"しゅ"],[5,2,"せんぞ"],[10,1,"ちか"],[13,1,"かれ"],[18,2,"しそん"],[22,1,"あた"],[27,1,"い"],[31,1,"ち"],[33,1,"ちち"],[35,1,"みつ"],[37,1,"なが"],[40,1,"くに"],[46,1,"なが"],[48,1,"い"]],"text":"かつ、主が先祖たちに誓って彼らとその子孫とに与えようと言われた地、乳と蜜の流れる国において、長く生きることができるであろう。"},{"ref":"Deut.11.10","start":5011010,"end":5011010,"break":"none","ruby":[[6,1,"い"],[9,1,"と"],[15,1,"ち"],[24,1,"で"],[33,1,"ち"],[48,2,"あおもの"],[50,1,"ばたけ"],[64,1,"たね"],[69,1,"あし"],[74,1,"みず"],[76,1,"そそ"]],"text":"あなたがたが行って取ろうとする地は、あなたがたが出てきたエジプトの地のようではない。あそこでは、青物畑でするように、あなたがたは種をまき、足でそれに水を注いだ。"},{"ref":"Deut.11.11","start":5011011,"end":5011011,"break":"none","ruby":[[10,1,"わた"],[13,1,"い"],[16,1,"と"],[18,1,"ち"],[21,1,"やま"],[23,1,"たに"],[25,1,"おお"],[27,1,"ち"],[30,1,"てん"],[33,1,"ふ"],[35,1,"あめ"],[37,1,"うるお"]],"text":"しかし、あなたがたが渡って行って取る地は、山と谷の多い地で、天から降る雨で潤っている。"},{"ref":"Deut.11.12","start":5011012,"end":5011012,"break":"none","ruby":[[2,1,"ち"],[9,1,"かみ"],[11,1,"しゅ"],[13,1,"かえり"],[18,1,"ところ"],[21,1,"とし"],[23,1,"はじ"],[27,1,"とし"],[29,1,"おわ"],[38,1,"かみ"],[40,1,"しゅ"],[42,1,"め"],[44,1,"つね"],[48,1,"うえ"]],"text":"その地は、あなたの神、主が顧みられる所で、年の始めから年の終りまで、あなたの神、主の目が常にその上にある。"},{"ref":"Deut.11.13","start":5011013,"end":5011013,"break":"paragraph","ruby":[[13,1,"めい"],[20,2,"めいれい"],[25,1,"き"],[27,1,"したが"],[37,1,"かみ"],[39,1,"しゅ"],[41,1,"あい"],[44,1,"こころ"],[50,2,"せいしん"],[57,1,"つか"]],"text":"もし、きょう、あなたがたに命じるわたしの命令によく聞き従って、あなたがたの神、主を愛し、心をつくし、精神をつくして仕えるならば、"},{"ref":"Deut.11.14","start":5011014,"end":5011014,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"ち"],[10,1,"あめ"],[13,1,"あき"],[15,1,"あめ"],[17,1,"はる"],[19,1,"あめ"],[24,1,"とき"],[31,1,"ふ"],[35,2,"こくもつ"],[42,1,"しゅ"],[45,1,"あぶら"],[47,1,"と"],[49,1,"い"]],"text":"主はあなたがたの地に雨を、秋の雨、春の雨ともに、時にしたがって降らせ、穀物と、ぶどう酒と、油を取り入れさせ、"},{"ref":"Deut.11.15","start":5011015,"end":5011015,"break":"none","ruby":[[2,2,"かちく"],[8,1,"の"],[10,1,"くさ"],[12,1,"は"],[28,1,"あ"],[33,1,"た"]],"text":"また家畜のために野に草を生えさせられるであろう。あなたは飽きるほど食べることができるであろう。"},{"ref":"Deut.11.16","start":5011016,"end":5011016,"break":"none","ruby":[[6,1,"こころ"],[8,1,"まよ"],[11,1,"はな"],[13,1,"さ"],[17,1,"た"],[19,2,"かみがみ"],[22,1,"つか"],[28,1,"おが"],[38,1,"つつし"]],"text":"あなたがたは心が迷い、離れ去って、他の神々に仕え、それを拝むことのないよう、慎まなければならない。"},{"ref":"Deut.11.17","start":5011017,"end":5011017,"break":"none","ruby":[[4,1,"しゅ"],[15,1,"いか"],[18,1,"はっ"],[22,1,"てん"],[24,1,"と"],[38,1,"あめ"],[40,1,"ふ"],[44,1,"ち"],[46,2,"さんぶつ"],[49,1,"だ"],[59,1,"しゅ"],[61,1,"たま"],[64,1,"よ"],[66,1,"ち"],[75,1,"ほろ"]],"text":"おそらく主はあなたがたにむかい怒りを発して、天を閉ざされるであろう。そのため雨は降らず、地は産物を出さず、あなたがたは主が賜わる良い地から、すみやかに滅びうせるであろう。"},{"ref":"Deut.11.18","start":5011018,"end":5011018,"break":"paragraph","ruby":[[13,2,"ことば"],[16,1,"こころ"],[18,1,"たましい"],[29,1,"て"],[41,1,"め"],[43,1,"あいだ"],[45,1,"お"],[48,1,"おぼ"]],"text":"それゆえ、これらのわたしの言葉を心と魂におさめ、またそれを手につけて、しるしとし、目の間に置いて覚えとし、"},{"ref":"Deut.11.19","start":5011019,"end":5011019,"break":"none","ruby":[[3,2,"こども"],[8,1,"おし"],[11,1,"いえ"],[13,1,"ざ"],[18,1,"とき"],[21,1,"みち"],[23,1,"ある"],[25,1,"とき"],[28,1,"ね"],[30,1,"とき"],[33,1,"お"],[36,1,"とき"],[45,1,"かた"]],"text":"これを子供たちに教え、家に座している時も、道を歩く時も、寝る時も、起きる時も、それについて語り、"},{"ref":"Deut.11.20","start":5011020,"end":5011020,"break":"none","ruby":[[2,1,"いえ"],[4,2,"いりぐち"],[7,1,"はしら"],[10,1,"もん"],[15,1,"か"]],"text":"また家の入口の柱と、門にそれを書きしるさなければならない。"},{"ref":"Deut.11.21","start":5011021,"end":5011021,"break":"none","ruby":[[6,1,"しゅ"],[8,2,"せんぞ"],[13,1,"あた"],[18,1,"ちか"],[22,1,"ち"],[31,1,"す"],[33,2,"にっすう"],[44,2,"こども"],[49,1,"す"],[51,2,"にっすう"],[55,1,"てん"],[57,1,"ち"],[62,2,"にっすう"],[68,1,"おお"]],"text":"そうすれば、主が先祖たちに与えようと誓われた地に、あなたがたの住む日数およびあなたがたの子供たちの住む日数は、天が地をおおう日数のように多いであろう。"},{"ref":"Deut.11.22","start":5011022,"end":5011022,"break":"none","ruby":[[12,1,"めい"],[21,2,"めいれい"],[26,1,"まも"],[29,1,"おこな"],[38,1,"かみ"],[40,1,"しゅ"],[42,1,"あい"],[51,1,"みち"],[53,1,"あゆ"],[56,1,"しゅ"],[60,1,"したが"]],"text":"もしわたしがあなたがたに命じるこのすべての命令をよく守って行い、あなたがたの神、主を愛し、そのすべての道に歩み、主につき従うならば、"},{"ref":"Deut.11.23","start":5011023,"end":5011023,"break":"none","ruby":[[0,1,"しゅ"],[4,2,"くにぐに"],[7,1,"たみ"],[9,1,"みな"],[17,1,"まえ"],[20,1,"お"],[22,1,"はら"],[40,1,"おお"],[46,1,"つよ"],[48,2,"くにぐに"],[51,1,"と"],[54,1,"いた"]],"text":"主はこの国々の民を皆、あなたがたの前から追い払われ、あなたがたはあなたがたよりも大きく、かつ強い国々を取るに至るであろう。"},{"ref":"Deut.11.24","start":5011024,"end":5011024,"break":"none","ruby":[[6,1,"あし"],[8,1,"うら"],[10,1,"ふ"],[12,1,"ところ"],[14,1,"みな"],[34,2,"りょういき"],[37,2,"あらの"],[46,1,"およ"],[51,2,"おおかわ"],[59,1,"にし"],[61,1,"うみ"],[63,1,"およ"]],"text":"あなたがたが足の裏で踏む所は皆、あなたがたのものとなり、あなたがたの領域は荒野からレバノンに及び、また大川ユフラテから西の海に及ぶであろう。"},{"ref":"Deut.11.25","start":5011025,"end":5011025,"break":"none","ruby":[[9,1,"た"],[11,1,"む"],[20,1,"もの"],[35,1,"かみ"],[37,1,"しゅ"],[43,1,"い"],[57,1,"ふ"],[59,1,"い"],[61,1,"ち"],[63,2,"ひとびと"],[73,1,"おそ"]],"text":"だれもあなたがたに立ち向かうことのできる者はないであろう。あなたがたの神、主は、かつて言われたように、あなたがたの踏み入る地の人々が、あなたがたを恐れおののくようにされるであろう。"},{"ref":"Deut.11.26","start":5011026,"end":5011026,"break":"paragraph","ruby":[[0,1,"み"],[18,1,"まえ"],[20,2,"しゅくふく"],[29,1,"お"]],"text":"見よ、わたしは、きょう、あなたがたの前に祝福と、のろいとを置く。"},{"ref":"Deut.11.27","start":5011027,"end":5011027,"break":"none","ruby":[[17,1,"めい"],[26,1,"かみ"],[28,1,"しゅ"],[30,2,"めいれい"],[33,1,"き"],[35,1,"したが"],[41,2,"しゅくふく"],[44,1,"う"]],"text":"もし、きょう、わたしがあなたがたに命じるあなたがたの神、主の命令に聞き従うならば、祝福を受けるであろう。"},{"ref":"Deut.11.28","start":5011028,"end":5011028,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,2,"めいれい"],[15,1,"き"],[17,1,"したが"],[36,1,"めい"],[39,1,"みち"],[41,1,"はな"],[50,1,"し"],[56,1,"た"],[58,2,"かみがみ"],[61,1,"したが"],[71,1,"う"]],"text":"もしあなたがたの神、主の命令に聞き従わず、わたしが、きょう、あなたがたに命じる道を離れ、あなたがたの知らなかった他の神々に従うならば、のろいを受けるであろう。"},{"ref":"Deut.11.29","start":5011029,"end":5011029,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[13,1,"い"],[16,2,"せんりょう"],[20,1,"ち"],[26,1,"みちび"],[28,1,"い"],[33,1,"とき"],[43,1,"やま"],[45,2,"しゅくふく"],[48,1,"お"],[54,1,"やま"],[60,1,"お"]],"text":"あなたの神、主が、あなたの行って占領する地にあなたを導き入れられる時、あなたはゲリジム山に祝福を置き、エバル山にのろいを置かなければならない。"},{"ref":"Deut.11.30","start":5011030,"end":5011030,"break":"none","ruby":[[4,1,"やま"],[11,1,"む"],[14,1,"がわ"],[20,1,"す"],[31,1,"ち"],[34,1,"ひ"],[36,1,"い"],[38,1,"ほう"],[40,1,"みち"],[42,2,"にしがわ"],[53,1,"む"],[68,1,"き"],[70,1,"ちか"]],"text":"これらの山はヨルダンの向こう側、アラバに住んでいるカナンびとの地で、日の入る方の道の西側にあり、ギルガルに向かいあって、モレのテレビンの木の近くにあるではないか。"},{"ref":"Deut.11.31","start":5011031,"end":5011031,"break":"none","ruby":[[11,1,"わた"],[20,1,"かみ"],[22,1,"しゅ"],[24,1,"たま"],[27,1,"ち"],[37,2,"せんりょう"],[57,2,"せんりょう"],[65,1,"す"]],"text":"あなたがたはヨルダンを渡り、あなたがたの神、主が賜わる地にはいって、それを占領しようとしている。あなたがたはそれを占領して、そこに住むであろう。"},{"ref":"Deut.11.32","start":5011032,"end":5011032,"break":"none","ruby":[[20,1,"さづ"],[23,1,"さだ"],[36,1,"まも"],[39,1,"おこな"]],"text":"それゆえ、わたしが、きょう、あなたがたに授ける定めと、おきてをことごとく守って行わなければならない。"}]