[{"ref":"Isa.15.1","start":23015001,"end":23015001,"break":"paragraph","breaks":[[11,"stanza"],[34,"line"]],"ruby":[[8,2,"たくせん"],[15,1,"や"],[20,1,"あら"],[29,1,"ほろ"],[38,1,"や"],[43,1,"あら"],[52,1,"ほろ"]],"text":"モアブについての託宣。アルは一夜のうちに荒されて、モアブは滅びうせ、キルは一夜のうちに荒されて、モアブは滅びうせた。"},{"ref":"Isa.15.2","start":23015002,"end":23015002,"break":"line","breaks":[[17,"line"],[35,"line"],[49,"line"]],"ruby":[[4,1,"むすめ"],[6,1,"たか"],[8,1,"ところ"],[14,1,"な"],[28,1,"うえ"],[30,1,"なげ"],[32,1,"さけ"],[41,1,"あたま"]],"text":"デボンの娘は高き所にのぼって泣き、モアブはネボとメデバの上で嘆き叫ぶ。おのおのその頭をかぶろにし、そのひげをことごとくそった。"},{"ref":"Isa.15.3","start":23015003,"end":23015003,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[9,2,"あらぬの"],[18,2,"やね"],[23,2,"ひろば"],[29,1,"な"],[31,1,"さけ"],[34,1,"なみだ"],[36,1,"ひた"]],"text":"彼らはそのちまたで荒布をまとい、その屋根または広場で、みな泣き叫び、涙に浸る。"},{"ref":"Isa.15.4","start":23015004,"end":23015004,"break":"line","breaks":[[14,"line"],[27,"line"],[44,"line"]],"ruby":[[11,1,"さけ"],[16,1,"こえ"],[23,1,"きこ"],[36,2,"へいし"],[39,1,"こえ"],[46,1,"たましい"]],"text":"ヘシボンとエレアレとは叫び、その声はヤハズまで聞える。それゆえ、モアブの兵士は声をあげ、その魂はおののく。"},{"ref":"Isa.15.5","start":23015005,"end":23015005,"break":"line","breaks":[[18,"line"],[29,"line"],[43,"line"],[58,"line"]],"ruby":[[2,1,"こころ"],[11,1,"さけ"],[13,1,"よ"],[20,2,"おちうど"],[43,1,"な"],[52,1,"さか"],[64,1,"みち"],[66,1,"ほろ"],[69,1,"さけ"]],"text":"わが心はモアブのために叫び呼ばわる。その落人はゾアルおよびエグラテ・シリシヤにのがれ、泣きながらルヒテの坂をのぼり、ホロナイムの道で滅びの叫びをあげる。"},{"ref":"Isa.15.6","start":23015006,"end":23015006,"break":"line","breaks":[[11,"line"]],"ruby":[[5,1,"みず"],[11,1,"くさ"],[13,1,"か"],[16,1,"なえ"],[18,1,"き"],[22,1,"あお"],[24,1,"もの"]],"text":"ニムリムの水はかわき、草は枯れ、苗は消えて、青い物はない。"},{"ref":"Isa.15.7","start":23015007,"end":23015007,"break":"line","breaks":[[15,"line"]],"ruby":[[5,1,"かれ"],[10,1,"え"],[12,1,"とみ"],[22,1,"もの"],[25,1,"たずさ"],[29,1,"やなぎ"],[31,1,"かわ"]],"text":"それゆえ、彼らはその得た富と、そのたくわえた物とを携えて、柳の川をわたる。"},{"ref":"Isa.15.8","start":23015008,"end":23015008,"break":"line","breaks":[[17,"line"],[34,"line"]],"ruby":[[2,1,"さけ"],[5,1,"こえ"],[11,1,"さかい"],[19,1,"なげ"],[22,1,"こえ"],[38,1,"なげ"],[41,1,"こえ"]],"text":"その叫びの声はモアブの境をめぐり、その嘆きの声はエグライムにいたり、またその嘆きの声はベエル・エリムにいたる。"},{"ref":"Isa.15.9","start":23015009,"end":23015009,"break":"line","breaks":[[12,"line"],[30,"line"],[40,"line"]],"ruby":[[4,1,"みず"],[6,1,"ち"],[8,1,"み"],[20,1,"うえ"],[25,1,"わざわい"],[27,1,"くわ"],[38,1,"もの"],[42,1,"ち"],[44,1,"のこ"],[47,1,"もの"],[54,1,"おく"]],"text":"デボンの水は血で満ちる。わたしはデボンの上にさらに災を加え、モアブののがれた者とこの地の残った者とに、ししを送る。"}]