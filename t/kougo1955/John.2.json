[{"ref":"John.2.1","start":43002001,"end":43002001,"break":"paragraph","ruby":[[1,1,"か"],[2,1,"め"],[12,2,"こんれい"],[23,1,"はは"]],"text":"三日目にガリラヤのカナに婚礼があって、イエスの母がそこにいた。"},{"ref":"John.2.2","start":43002002,"end":43002002,"break":"none","ruby":[[4,2,"でし"],[12,2,"こんれい"],[15,1,"まね"]],"text":"イエスも弟子たちも、その婚礼に招かれた。"},{"ref":"John.2.3","start":43002003,"end":43002003,"break":"none","ruby":[[3,1,"しゅ"],[13,1,"はは"],[19,1,"い"],[27,1,"しゅ"]],"text":"ぶどう酒がなくなったので、母はイエスに言った、「ぶどう酒がなくなってしまいました」。"},{"ref":"John.2.4","start":43002004,"end":43002004,"break":"none","ruby":[[4,1,"はは"],[6,1,"い"],[12,2,"ふじん"],[29,1,"かか"],[43,1,"とき"]],"text":"イエスは母に言われた、「婦人よ、あなたは、わたしと、なんの係わりがありますか。わたしの時は、まだきていません」。"},{"ref":"John.2.5","start":43002005,"end":43002005,"break":"none","ruby":[[0,1,"はは"],[2,1,"しもべ"],[6,1,"い"],[23,1,"い"],[38,1,"くだ"]],"text":"母は僕たちに言った、「このかたが、あなたがたに言いつけることは、なんでもして下さい」。"},{"ref":"John.2.6","start":43002006,"end":43002006,"break":"none","ruby":[[8,1,"じん"],[19,1,"したが"],[30,1,"と"],[35,1,"いし"],[37,1,"みず"],[44,1,"お"]],"text":"そこには、ユダヤ人のきよめのならわしに従って、それぞれ四、五斗もはいる石の水がめが、六つ置いてあった。"},{"ref":"John.2.7","start":43002007,"end":43002007,"break":"none","ruby":[[4,1,"かれ"],[11,1,"みず"],[17,1,"い"],[24,1,"い"],[31,1,"かれ"],[34,1,"くち"],[46,1,"い"]],"text":"イエスは彼らに「かめに水をいっぱい入れなさい」と言われたので、彼らは口のところまでいっぱいに入れた。"},{"ref":"John.2.8","start":43002008,"end":43002008,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[19,2,"りょうり"],[29,1,"も"],[32,1,"い"],[43,1,"かれ"],[46,1,"も"],[49,1,"い"]],"text":"そこで彼らに言われた、「さあ、くんで、料理がしらのところに持って行きなさい」。すると、彼らは持って行った。"},{"ref":"John.2.9","start":43002009,"end":43002009,"break":"none","ruby":[[0,2,"りょうり"],[10,1,"しゅ"],[15,1,"みず"],[35,1,"し"],[45,1,"みず"],[50,1,"しもべ"],[54,1,"し"],[60,2,"はなむこ"],[63,1,"よ"]],"text":"料理がしらは、ぶどう酒になった水をなめてみたが、それがどこからきたのか知らなかったので、（水をくんだ僕たちは知っていた）花婿を呼んで"},{"ref":"John.2.10","start":43002010,"end":43002010,"break":"none","ruby":[[0,1,"い"],[8,1,"ひと"],[12,1,"はじ"],[20,1,"しゅ"],[22,1,"だ"],[26,1,"よ"],[41,1,"だ"],[62,1,"しゅ"],[64,1,"いま"]],"text":"言った、「どんな人でも、初めによいぶどう酒を出して、酔いがまわったころにわるいのを出すものだ。それだのに、あなたはよいぶどう酒を今までとっておかれました」。"},{"ref":"John.2.11","start":43002011,"end":43002011,"break":"none","ruby":[[7,2,"さいしょ"],[22,1,"おこな"],[27,2,"えいこう"],[30,1,"あらわ"],[38,2,"でし"],[47,1,"しん"]],"text":"イエスは、この最初のしるしをガリラヤのカナで行い、その栄光を現された。そして弟子たちはイエスを信じた。"},{"ref":"John.2.12","start":43002012,"end":43002012,"break":"paragraph","ruby":[[12,1,"はは"],[14,2,"きょうだい"],[19,2,"でし"],[24,2,"いっしょ"],[34,1,"くだ"],[38,2,"いくにち"]],"text":"そののち、イエスは、その母、兄弟たち、弟子たちと一緒に、カペナウムに下って、幾日かそこにとどまられた。"},{"ref":"John.2.13","start":43002013,"end":43002013,"break":"paragraph","ruby":[[6,1,"じん"],[8,2,"すぎこし"],[11,1,"まつり"],[13,1,"ちか"],[30,1,"のぼ"]],"text":"さて、ユダヤ人の過越の祭が近づいたので、イエスはエルサレムに上られた。"},{"ref":"John.2.14","start":43002014,"end":43002014,"break":"none","ruby":[[3,1,"うし"],[5,1,"ひつじ"],[10,1,"う"],[12,1,"もの"],[14,2,"りょうがえ"],[18,1,"もの"],[22,1,"みや"],[24,1,"にわ"],[29,1,"こ"]],"text":"そして牛、羊、はとを売る者や両替する者などが宮の庭にすわり込んでいるのをごらんになって、"},{"ref":"John.2.15","start":43002015,"end":43002015,"break":"none","ruby":[[6,1,"つく"],[9,1,"ひつじ"],[11,1,"うし"],[15,1,"みや"],[18,1,"お"],[23,3,"りょうがえにん"],[27,1,"かね"],[29,1,"ち"],[35,1,"だい"]],"text":"なわでむちを造り、羊も牛もみな宮から追いだし、両替人の金を散らし、その台をひっくりかえし、"},{"ref":"John.2.16","start":43002016,"end":43002016,"break":"none","ruby":[[3,1,"う"],[5,2,"ひとびと"],[17,1,"も"],[25,1,"で"],[27,1,"い"],[34,1,"ちち"],[36,1,"いえ"],[38,2,"しょうばい"],[41,1,"いえ"],[48,1,"い"]],"text":"はとを売る人々には「これらのものを持って、ここから出て行け。わたしの父の家を商売の家とするな」と言われた。"},{"ref":"John.2.17","start":43002017,"end":43002017,"break":"none","ruby":[[0,2,"でし"],[11,1,"いえ"],[13,1,"おも"],[15,2,"ねっしん"],[23,1,"く"],[34,1,"か"],[42,1,"おも"],[44,1,"だ"]],"text":"弟子たちは、「あなたの家を思う熱心が、わたしを食いつくすであろう」と書いてあることを思い出した。"},{"ref":"John.2.18","start":43002018,"end":43002018,"break":"none","ruby":[[7,1,"じん"],[13,1,"い"],[44,1,"み"]],"text":"そこで、ユダヤ人はイエスに言った、「こんなことをするからには、どんなしるしをわたしたちに見せてくれますか」。"},{"ref":"John.2.19","start":43002019,"end":43002019,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[10,1,"い"],[18,2,"しんでん"],[32,1,"か"],[41,1,"おこ"]],"text":"イエスは彼らに答えて言われた、「この神殿をこわしたら、わたしは三日のうちに、それを起すであろう」。"},{"ref":"John.2.20","start":43002020,"end":43002020,"break":"none","ruby":[[7,1,"じん"],[11,1,"い"],[18,2,"しんでん"],[21,1,"た"],[31,1,"ねん"],[52,1,"か"],[61,1,"た"]],"text":"そこで、ユダヤ人たちは言った、「この神殿を建てるのには、四十六年もかかっています。それだのに、あなたは三日のうちに、それを建てるのですか」。"},{"ref":"John.2.21","start":43002021,"end":43002021,"break":"none","ruby":[[4,2,"じぶん"],[13,2,"しんでん"],[19,1,"い"]],"text":"イエスは自分のからだである神殿のことを言われたのである。"},{"ref":"John.2.22","start":43002022,"end":43002022,"break":"none","ruby":[[8,2,"しにん"],[11,1,"なか"],[23,2,"でし"],[34,1,"い"],[41,1,"おも"],[43,1,"だ"],[47,2,"せいしょ"],[56,2,"ことば"],[60,1,"しん"]],"text":"それで、イエスが死人の中からよみがえったとき、弟子たちはイエスがこう言われたことを思い出して、聖書とイエスのこの言葉とを信じた。"},{"ref":"John.2.23","start":43002023,"end":43002023,"break":"none","ruby":[[0,2,"すぎこし"],[3,1,"まつり"],[5,1,"あいだ"],[17,2,"たいざい"],[28,1,"おお"],[31,2,"ひとびと"],[37,1,"おこな"],[45,1,"み"],[52,1,"な"],[54,1,"しん"]],"text":"過越の祭の間、イエスがエルサレムに滞在しておられたとき、多くの人々は、その行われたしるしを見て、イエスの名を信じた。"},{"ref":"John.2.24","start":43002024,"end":43002024,"break":"none","ruby":[[7,2,"じしん"],[11,1,"かれ"],[14,2,"じぶん"],[18,1,"まか"],[36,1,"ひと"],[38,1,"し"]],"text":"しかしイエスご自身は、彼らに自分をお任せにならなかった。それは、すべての人を知っておられ、"},{"ref":"John.2.25","start":43002025,"end":43002025,"break":"none","ruby":[[2,1,"ひと"],[12,1,"もの"],[15,2,"ひつよう"],[35,2,"じしん"],[37,1,"ひと"],[39,1,"こころ"],[41,1,"なか"],[48,1,"し"]],"text":"また人についてあかしする者を、必要とされなかったからである。それは、ご自身人の心の中にあることを知っておられたからである。"}]