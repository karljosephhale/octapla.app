[{"ref":"Job.1.1","start":18001001,"end":18001001,"break":"paragraph","ruby":[[3,1,"ち"],[10,1,"な"],[12,1,"ひと"],[26,1,"まった"],[31,1,"ただ"],[35,1,"かみ"],[37,1,"おそ"],[40,1,"あく"],[42,1,"とお"]],"text":"ウヅの地にヨブという名の人があった。そのひととなりは全く、かつ正しく、神を恐れ、悪に遠ざかった。"},{"ref":"Job.1.2","start":18001002,"end":18001002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おとこ"],[4,1,"こ"],[6,1,"にん"],[8,1,"おんな"],[10,1,"こ"],[12,1,"にん"]],"text":"彼に男の子七人と女の子三人があり、"},{"ref":"Job.1.3","start":18001003,"end":18001003,"break":"none","ruby":[[2,2,"かちく"],[5,1,"ひつじ"],[8,1,"とう"],[15,1,"とう"],[17,1,"うし"],[24,1,"め"],[29,1,"とう"],[36,2,"ひじょう"],[39,1,"おお"],[44,1,"ひと"],[46,1,"ひがし"],[48,2,"ひとびと"],[54,1,"もっと"],[56,1,"おお"],[60,1,"もの"]],"text":"その家畜は羊七千頭、らくだ三千頭、牛五百くびき、雌ろば五百頭で、しもべも非常に多く、この人は東の人々のうちで最も大いなる者であった。"},{"ref":"Job.1.4","start":18001004,"end":18001004,"break":"none","ruby":[[13,2,"じぶん"],[16,1,"ひ"],[19,2,"じぶん"],[22,1,"いえ"],[29,1,"もう"],[35,1,"にん"],[37,2,"しまい"],[41,1,"まね"],[44,2,"いっしょ"],[47,1,"く"],[49,1,"の"],[55,1,"つね"]],"text":"そのむすこたちは、めいめい自分の日に、自分の家でふるまいを設け、その三人の姉妹をも招いて一緒に食い飲みするのを常とした。"},{"ref":"Job.1.5","start":18001005,"end":18001005,"break":"none","ruby":[[7,1,"ひ"],[14,1,"おわ"],[23,1,"かれ"],[26,1,"よ"],[28,1,"よ"],[31,2,"せいべつ"],[35,1,"あさ"],[36,1,"はや"],[38,1,"お"],[42,1,"かれ"],[48,1,"かず"],[55,2,"はんさい"],[88,1,"つみ"],[90,1,"おか"],[95,1,"こころ"],[97,1,"かみ"],[111,1,"おも"],[132,1,"い"]],"text":"そのふるまいの日がひとめぐり終るごとに、ヨブは彼らを呼び寄せて聖別し、朝早く起きて、彼らすべての数にしたがって燔祭をささげた。これはヨブが「わたしのむすこたちは、ことによったら罪を犯し、その心に神をのろったかもしれない」と思ったからである。ヨブはいつも、このように行った。"},{"ref":"Job.1.6","start":18001006,"end":18001006,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"かみ"],[6,1,"こ"],[10,1,"き"],[13,1,"しゅ"],[15,1,"まえ"],[17,1,"た"],[25,1,"き"],[29,1,"なか"]],"text":"ある日、神の子たちが来て、主の前に立った。サタンも来てその中にいた。"},{"ref":"Job.1.7","start":18001007,"end":18001007,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[16,1,"き"],[25,1,"しゅ"],[27,1,"こた"],[30,1,"い"],[35,1,"ち"],[37,1,"い"],[49,1,"ある"]],"text":"主は言われた、「あなたはどこから来たか」。サタンは主に答えて言った、「地を行きめぐり、あちらこちら歩いてきました」。"},{"ref":"Job.1.8","start":18001008,"end":18001008,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[29,1,"まった"],[34,1,"ただ"],[38,1,"かみ"],[40,1,"おそ"],[43,1,"あく"],[45,1,"とお"],[49,1,"もの"],[51,1,"よ"],[58,1,"き"]],"text":"主はサタンに言われた、「あなたはわたしのしもべヨブのように全く、かつ正しく、神を恐れ、悪に遠ざかる者の世にないことを気づいたか」。"},{"ref":"Job.1.9","start":18001009,"end":18001009,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"こた"],[9,1,"い"],[22,1,"かみ"],[24,1,"おそ"]],"text":"サタンは主に答えて言った、「ヨブはいたずらに神を恐れましょうか。"},{"ref":"Job.1.10","start":18001010,"end":18001010,"break":"none","ruby":[[4,1,"かれ"],[8,1,"いえ"],[16,3,"しょゆうぶつ"],[33,1,"もう"],[51,1,"かれ"],[53,2,"きんろう"],[56,2,"しゅくふく"],[66,2,"かちく"],[69,1,"ち"]],"text":"あなたは彼とその家およびすべての所有物のまわりにくまなく、まがきを設けられたではありませんか。あなたは彼の勤労を祝福されたので、その家畜は地にふえたのです。"},{"ref":"Job.1.11","start":18001011,"end":18001011,"break":"none","ruby":[[3,1,"いま"],[8,1,"て"],[10,1,"の"],[14,1,"かれ"],[20,3,"しょゆうぶつ"],[24,1,"う"],[34,1,"かれ"],[36,1,"かなら"],[42,1,"かお"],[44,1,"む"]],"text":"しかし今あなたの手を伸べて、彼のすべての所有物を撃ってごらんなさい。彼は必ずあなたの顔に向かって、あなたをのろうでしょう」。"},{"ref":"Job.1.12","start":18001012,"end":18001012,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"み"],[15,1,"かれ"],[21,3,"しょゆうぶつ"],[29,1,"て"],[38,1,"かれ"],[40,1,"み"],[42,1,"て"],[58,1,"しゅ"],[60,1,"まえ"],[63,1,"で"],[65,1,"い"]],"text":"主はサタンに言われた、「見よ、彼のすべての所有物をあなたの手にまかせる。ただ彼の身に手をつけてはならない」。サタンは主の前から出て行った。"},{"ref":"Job.1.13","start":18001013,"end":18001013,"break":"paragraph","ruby":[[2,1,"ひ"],[10,1,"むすめ"],[14,1,"だい"],[17,1,"あに"],[19,1,"いえ"],[21,2,"しょくじ"],[26,1,"さけ"],[28,1,"の"]],"text":"ある日ヨブのむすこ、娘たちが第一の兄の家で食事をし、酒を飲んでいたとき、"},{"ref":"Job.1.14","start":18001014,"end":18001014,"break":"none","ruby":[[0,2,"ししゃ"],[9,1,"き"],[11,1,"い"],[16,1,"うし"],[18,1,"たがや"],[31,1,"くさ"],[33,1,"く"]],"text":"使者がヨブのもとに来て言った、「牛が耕し、ろばがそのかたわらで草を食っていると、"},{"ref":"Job.1.15","start":18001015,"end":18001015,"break":"none","ruby":[[5,1,"おそ"],[14,1,"うば"],[30,1,"う"],[32,1,"ころ"],[56,1,"つ"],[62,1,"き"]],"text":"シバびとが襲ってきて、これを奪い、つるぎをもってしもべたちを打ち殺しました。わたしはただひとりのがれて、あなたに告げるために来ました」。"},{"ref":"Job.1.16","start":18001016,"end":18001016,"break":"none","ruby":[[0,1,"かれ"],[4,1,"かた"],[19,1,"き"],[21,1,"い"],[26,1,"かみ"],[28,1,"ひ"],[30,1,"てん"],[33,1,"くだ"],[37,1,"ひつじ"],[47,1,"や"],[49,1,"ほろ"],[74,1,"つ"],[80,1,"き"]],"text":"彼がなお語っているうちに、またひとりが来て言った、「神の火が天から下って、羊およびしもべたちを焼き滅ぼしました。わたしはただひとりのがれて、あなたに告げるために来ました」。"},{"ref":"Job.1.17","start":18001017,"end":18001017,"break":"none","ruby":[[0,1,"かれ"],[4,1,"かた"],[19,1,"き"],[21,1,"い"],[34,1,"くみ"],[36,1,"わか"],[39,1,"き"],[46,1,"おそ"],[52,1,"うば"],[68,1,"う"],[70,1,"ころ"],[94,1,"つ"],[100,1,"き"]],"text":"彼がなお語っているうちに、またひとりが来て言った、「カルデヤびとが三組に分れて来て、らくだを襲ってこれを奪い、つるぎをもってしもべたちを打ち殺しました。わたしはただひとりのがれて、あなたに告げるために来ました」。"},{"ref":"Job.1.18","start":18001018,"end":18001018,"break":"none","ruby":[[0,1,"かれ"],[4,1,"かた"],[19,1,"き"],[21,1,"い"],[34,1,"むすめ"],[38,1,"だい"],[41,1,"あに"],[43,1,"いえ"],[45,2,"しょくじ"],[50,1,"さけ"],[52,1,"の"]],"text":"彼がなお語っているうちに、またひとりが来て言った、「あなたのむすこ、娘たちが第一の兄の家で食事をし、酒を飲んでいると、"},{"ref":"Job.1.19","start":18001019,"end":18001019,"break":"none","ruby":[[0,2,"あらの"],[3,1,"ほう"],[6,2,"おおかぜ"],[9,1,"ふ"],[15,1,"いえ"],[17,1,"よ"],[21,1,"う"],[29,1,"わか"],[31,1,"ひと"],[35,1,"うえ"],[40,1,"お"],[44,1,"みな"],[45,1,"し"],[69,1,"つ"],[75,1,"き"]],"text":"荒野の方から大風が吹いてきて、家の四すみを撃ったので、あの若い人たちの上につぶれ落ちて、皆死にました。わたしはただひとりのがれて、あなたに告げるために来ました」。"},{"ref":"Job.1.20","start":18001020,"end":18001020,"break":"paragraph","ruby":[[7,1,"お"],[9,1,"あ"],[13,2,"うわぎ"],[16,1,"さ"],[19,1,"あたま"],[24,1,"ち"],[26,1,"ふ"],[29,1,"はい"]],"text":"このときヨブは起き上がり、上着を裂き、頭をそり、地に伏して拝し、"},{"ref":"Job.1.21","start":18001021,"end":18001021,"break":"none","breaks":[[7,"stanza"],[21,"line"],[33,"line"],[47,"line"]],"ruby":[[3,1,"い"],[12,1,"はだか"],[14,1,"はは"],[16,1,"たい"],[18,1,"で"],[23,1,"はだか"],[29,1,"かえ"],[33,1,"しゅ"],[35,1,"あた"],[38,1,"しゅ"],[40,1,"と"],[47,1,"しゅ"],[50,1,"な"]],"text":"そして言った、「わたしは裸で母の胎を出た。また裸でかしこに帰ろう。主が与え、主が取られたのだ。主のみ名はほむべきかな」。"},{"ref":"Job.1.22","start":18001022,"end":18001022,"break":"paragraph","ruby":[[5,1,"こと"],[13,1,"つみ"],[15,1,"おか"],[21,1,"かみ"],[23,1,"む"],[27,1,"おろ"],[33,1,"い"]],"text":"すべてこの事においてヨブは罪を犯さず、また神に向かって愚かなことを言わなかった。"}]