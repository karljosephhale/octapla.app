[{"ref":"Phlm.1.1","start":57001001,"end":57001001,"break":"paragraph","ruby":[[9,2,"しゅうじん"],[15,2,"きょうだい"],[29,1,"あい"],[32,3,"どうろうしゃ"]],"text":"キリスト・イエスの囚人パウロと兄弟テモテから、わたしたちの愛する同労者ピレモン、"},{"ref":"Phlm.1.2","start":57001002,"end":57001002,"break":"none","ruby":[[0,2,"しまい"],[12,2,"せんゆう"],[28,1,"いえ"],[32,2,"きょうかい"]],"text":"姉妹アピヤ、わたしたちの戦友アルキポ、ならびに、あなたの家にある教会へ。"},{"ref":"Phlm.1.3","start":57001003,"end":57001003,"break":"paragraph","ruby":[[6,1,"ちち"],[9,1,"かみ"],[11,1,"しゅ"],[23,1,"めぐ"],[26,2,"へいあん"]],"text":"わたしたちの父なる神と主イエス・キリストから、恵みと平安とが、あなたがたにあるように。"},{"ref":"Phlm.1.4","start":57001004,"end":57001004,"break":"paragraph","ruby":[[5,1,"いのり"],[7,1,"とき"],[25,1,"かみ"],[27,2,"かんしゃ"]],"text":"わたしは、祈の時にあなたをおぼえて、いつもわたしの神に感謝している。"},{"ref":"Phlm.1.5","start":57001005,"end":57001005,"break":"none","ruby":[[4,1,"しゅ"],[9,1,"たい"],[19,2,"せいと"],[22,1,"たい"],[29,1,"あい"],[31,2,"しんこう"],[39,1,"き"]],"text":"それは、主イエスに対し、また、すべての聖徒に対するあなたの愛と信仰とについて、聞いているからである。"},{"ref":"Phlm.1.6","start":57001006,"end":57001006,"break":"none","ruby":[[8,2,"しんこう"],[11,1,"まじ"],[15,1,"つよ"],[27,1,"あいだ"],[47,1,"よ"],[53,1,"し"],[57,1,"く"]],"text":"どうか、あなたの信仰の交わりが強められて、わたしたちの間でキリストのためになされているすべての良いことが、知られて来るようになってほしい。"},{"ref":"Phlm.1.7","start":57001007,"end":57001007,"break":"none","ruby":[[0,2,"きょうだい"],[13,1,"あい"],[18,1,"おお"],[21,1,"よろこ"],[24,1,"なぐさ"],[28,1,"あた"],[34,2,"せいと"],[39,1,"こころ"],[49,1,"ちから"]],"text":"兄弟よ。わたしは、あなたの愛によって多くの喜びと慰めとを与えられた。聖徒たちの心が、あなたによって力づけられたからである。"},{"ref":"Phlm.1.8","start":57001008,"end":57001008,"break":"paragraph","ruby":[[29,1,"こと"],[36,2,"そっちょく"],[39,2,"しじ"],[47,1,"おも"]],"text":"こういうわけで、わたしは、キリストにあってあなたのなすべき事を、きわめて率直に指示してもよいと思うが、"},{"ref":"Phlm.1.9","start":57001009,"end":57001009,"break":"none","ruby":[[4,1,"あい"],[10,1,"ねが"],[18,2,"ろうねん"],[24,1,"いま"],[36,2,"しゅうじん"]],"text":"むしろ、愛のゆえにお願いする。すでに老年になり、今またキリスト・イエスの囚人となっているこのパウロが、"},{"ref":"Phlm.1.10","start":57001010,"end":57001010,"break":"none","ruby":[[0,1,"とら"],[4,1,"み"],[6,1,"う"],[13,2,"こども"],[29,1,"ねが"]],"text":"捕われの身で産んだわたしの子供オネシモについて、あなたにお願いする。"},{"ref":"Phlm.1.11","start":57001011,"end":57001011,"break":"none","ruby":[[0,1,"かれ"],[2,2,"いぜん"],[13,2,"むえき"],[16,1,"もの"],[23,1,"いま"],[38,2,"ゆうえき"],[41,1,"もの"]],"text":"彼は以前は、あなたにとって無益な者であったが、今は、あなたにも、わたしにも、有益な者になった。"},{"ref":"Phlm.1.12","start":57001012,"end":57001012,"break":"none","ruby":[[0,1,"かれ"],[9,1,"おく"],[15,1,"かれ"],[21,1,"こころ"]],"text":"彼をあなたのもとに送りかえす。彼はわたしの心である。"},{"ref":"Phlm.1.13","start":57001013,"end":57001013,"break":"none","ruby":[[4,1,"かれ"],[6,2,"みぢか"],[9,1,"ひ"],[22,2,"ふくいん"],[28,1,"とら"],[34,1,"あいだ"],[40,1,"かわ"],[43,1,"つか"]],"text":"わたしは彼を身近に引きとめておいて、わたしが福音のために捕われている間、あなたに代って仕えてもらいたかったのである。"},{"ref":"Phlm.1.14","start":57001014,"end":57001014,"break":"none","ruby":[[13,2,"しょうだく"],[19,1,"なに"],[31,2,"きょうせい"],[36,1,"よ"],[38,1,"おこな"],[49,2,"じはつ"],[51,1,"てき"],[58,1,"ねが"]],"text":"しかし、わたしは、あなたの承諾なしには何もしたくない。あなたが強制されて良い行いをするのではなく、自発的にすることを願っている。"},{"ref":"Phlm.1.15","start":57001015,"end":57001015,"break":"none","ruby":[[0,1,"かれ"],[7,1,"あいだ"],[13,1,"はな"],[25,1,"かれ"],[32,1,"と"],[45,1,"し"]],"text":"彼がしばらくの間あなたから離れていたのは、あなたが彼をいつまでも留めておくためであったかも知れない。"},{"ref":"Phlm.1.16","start":57001016,"end":57001016,"break":"none","ruby":[[7,2,"どれい"],[17,2,"どれい"],[19,2,"いじょう"],[25,1,"あい"],[28,2,"きょうだい"],[68,1,"にく"],[75,1,"しゅ"],[84,2,"いじょう"]],"text":"しかも、もはや奴隷としてではなく、奴隷以上のもの、愛する兄弟としてである。とりわけ、わたしにとってそうであるが、ましてあなたにとっては、肉においても、主にあっても、それ以上であろう。"},{"ref":"Phlm.1.17","start":57001017,"end":57001017,"break":"none","ruby":[[14,2,"しんこう"],[17,1,"とも"],[19,1,"おも"],[31,2,"どうよう"],[34,1,"かれ"],[36,1,"う"]],"text":"そこで、もしわたしをあなたの信仰の友と思ってくれるなら、わたし同様に彼を受けいれてほしい。"},{"ref":"Phlm.1.18","start":57001018,"end":57001018,"break":"none","ruby":[[3,1,"かれ"],[9,1,"なに"],[11,3,"ふつごう"],[27,1,"なに"],[29,2,"ふさい"],[43,1,"か"]],"text":"もし、彼があなたに何か不都合なことをしたか、あるいは、何か負債があれば、それをわたしの借りにしておいてほしい。"},{"ref":"Phlm.1.19","start":57001019,"end":57001019,"break":"none","ruby":[[6,1,"て"],[21,2,"へんさい"],[28,1,"さい"],[38,2,"じしん"],[45,1,"お"],[58,1,"なに"],[60,1,"い"]],"text":"このパウロが手ずからしるす、わたしがそれを返済する。この際、あなたが、あなた自身をわたしに負うていることについては、何も言うまい。"},{"ref":"Phlm.1.20","start":57001020,"end":57001020,"break":"none","ruby":[[0,2,"きょうだい"],[14,1,"しゅ"],[19,1,"なに"],[21,1,"えき"],[23,1,"え"],[36,1,"こころ"],[39,1,"しゅ"],[44,1,"ちから"]],"text":"兄弟よ。わたしはあなたから、主にあって何か益を得たいものである。わたしの心を、主にあって力づけてもらいたい。"},{"ref":"Phlm.1.21","start":57001021,"end":57001021,"break":"paragraph","ruby":[[8,2,"じゅうじゅん"],[11,1,"かた"],[13,1,"しん"],[19,2,"てがみ"],[22,1,"か"],[30,1,"たし"],[37,1,"い"],[39,2,"いじょう"]],"text":"わたしはあなたの従順を堅く信じて、この手紙を書く。あなたは、確かにわたしが言う以上のことをしてくれるだろう。"},{"ref":"Phlm.1.22","start":57001022,"end":57001022,"break":"none","ruby":[[5,1,"ねが"],[18,1,"やど"],[20,2,"ようい"],[37,1,"いのり"],[49,1,"ところ"],[51,1,"い"],[62,1,"のぞ"]],"text":"ついでにお願いするが、わたしのために宿を用意しておいてほしい。あなたがたの祈によって、あなたがたの所に行かせてもらえるように望んでいるのだから。"},{"ref":"Phlm.1.23","start":57001023,"end":57001023,"break":"paragraph","ruby":[[17,1,"とも"],[19,1,"とら"],[23,1,"み"]],"text":"キリスト・イエスにあって、わたしと共に捕われの身になっているエパフラスから、あなたによろしく。"},{"ref":"Phlm.1.24","start":57001024,"end":57001024,"break":"none","ruby":[[4,3,"どうろうしゃ"]],"text":"わたしの同労者たち、マルコ、アリスタルコ、デマス、ルカからも、よろしく。"},{"ref":"Phlm.1.25","start":57001025,"end":57001025,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"めぐ"],[20,1,"れい"],[22,1,"とも"]],"text":"主イエス・キリストの恵みが、あなたがたの霊と共にあるように。"}]