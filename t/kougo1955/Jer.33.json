[{"ref":"Jer.33.1","start":24033001,"end":24033001,"break":"paragraph","ruby":[[7,2,"かんし"],[10,1,"にわ"],[12,1,"と"],[14,1,"こ"],[21,1,"とき"],[23,1,"しゅ"],[25,2,"ことば"],[32,1,"かれ"],[34,1,"のぞ"]],"text":"エレミヤがなお監視の庭に閉じ込められている時、主の言葉はふたたび彼に臨んだ、"},{"ref":"Jer.33.2","start":24033002,"end":24033002,"break":"none","ruby":[[1,1,"ち"],[3,1,"つく"],[7,1,"しゅ"],[12,1,"かたち"],[13,1,"つく"],[16,1,"かた"],[18,1,"た"],[24,1,"しゅ"],[28,1,"な"],[30,1,"しゅ"],[32,1,"な"],[40,1,"もの"],[44,1,"おお"]],"text":"「地を造られた主、それを形造って堅く立たせられた主、その名を主と名のっておられる者がこう仰せられる、"},{"ref":"Jer.33.3","start":24033003,"end":24033003,"break":"none","ruby":[[4,1,"よ"],[6,1,"もと"],[24,1,"こた"],[35,1,"し"],[39,1,"おお"],[42,1,"かく"],[48,1,"こと"],[55,1,"しめ"]],"text":"わたしに呼び求めよ、そうすれば、わたしはあなたに答える。そしてあなたの知らない大きな隠されている事を、あなたに示す。"},{"ref":"Jer.33.4","start":24033004,"end":24033004,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"るい"],[18,1,"ふせ"],[23,2,"はかい"],[30,1,"まち"],[32,1,"いえ"],[38,1,"おう"],[40,1,"いえ"],[47,1,"い"]],"text":"イスラエルの神、主は塁と、つるぎとを防ぐために破壊されたこの町の家と、ユダの王の家についてこう言われる、"},{"ref":"Jer.33.5","start":24033005,"end":24033005,"break":"none","ruby":[[7,1,"き"],[9,1,"たたか"],[16,1,"いか"],[19,1,"いきどお"],[25,1,"ころ"],[27,2,"ひとびと"],[30,2,"したい"],[37,1,"み"],[45,2,"ひとびと"],[53,1,"あく"],[61,1,"まち"],[67,1,"かお"],[72,1,"かく"]],"text":"カルデヤびとは来て戦い、わたしが怒りと憤りをもって殺す人々の死体を、それに満たす。わたしは人々のもろもろの悪のために、この町にわたしの顔をおおい隠した。"},{"ref":"Jer.33.6","start":24033006,"end":24033006,"break":"none","ruby":[[0,1,"み"],[7,2,"けんこう"],[25,2,"ひとびと"],[32,1,"ゆた"],[35,2,"はんえい"],[38,2,"あんぜん"],[42,1,"かれ"],[45,1,"しめ"]],"text":"見よ、わたしは健康と、いやしとを、ここにもたらして人々をいやし、豊かな繁栄と安全とを彼らに示す。"},{"ref":"Jer.33.7","start":24033007,"end":24033007,"break":"none","ruby":[[13,1,"ふたた"],[15,1,"さか"],[20,1,"かれ"],[23,1,"た"]],"text":"わたしはユダとイスラエルを再び栄えさせ、彼らを建てて、もとのようにする。"},{"ref":"Jer.33.8","start":24033008,"end":24033008,"break":"none","ruby":[[4,1,"かれ"],[11,1,"む"],[15,1,"おか"],[18,1,"つみ"],[27,1,"きよ"],[30,1,"かれ"],[37,1,"む"],[41,1,"おか"],[44,1,"つみ"],[46,2,"はんぎゃく"]],"text":"わたしは彼らがわたしに向かって犯した罪のすべてのとがを清め、彼らがわたしに向かって犯した罪と反逆のすべてのとがをゆるす。"},{"ref":"Jer.33.9","start":24033009,"end":24033009,"break":"none","ruby":[[2,1,"まち"],[4,1,"ち"],[11,1,"たみ"],[13,1,"まえ"],[23,1,"よろこ"],[26,1,"な"],[31,1,"ほまれ"],[36,1,"さか"],[42,1,"かれ"],[53,1,"たみ"],[55,1,"ほどこ"],[62,1,"めぐ"],[68,1,"き"],[81,1,"まち"],[83,1,"ほどこ"],[90,1,"めぐ"],[99,2,"はんえい"],[105,1,"おそ"],[108,1,"み"]],"text":"この町は地のもろもろの民の前に、わたしのために喜びの名となり、誉となり、栄えとなる。彼らはわたしがわたしの民に施すもろもろの恵みのことを聞く。そして、わたしがこの町に施すもろもろの恵みと、もろもろの繁栄のために恐れて身をふるわす。"},{"ref":"Jer.33.10","start":24033010,"end":24033010,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"い"],[20,1,"あ"],[24,1,"ひと"],[29,1,"けもの"],[40,1,"ところ"],[47,1,"あ"],[51,1,"ひと"],[56,1,"す"],[58,1,"もの"],[63,1,"けもの"],[71,1,"まち"]],"text":"主はこう言われる、あなたがたが、『それは荒れて、人もおらず獣もいない』というこの所、すなわち、荒れて、人もおらず住む者もなく、獣もいないユダの町とエルサレムのちまたに、"},{"ref":"Jer.33.11","start":24033011,"end":24033011,"break":"none","breaks":[[26,"stanza"],[37,"line"],[45,"line"]],"ruby":[[0,1,"ふたた"],[2,1,"よろこ"],[5,1,"こえ"],[7,1,"たの"],[11,1,"こえ"],[13,2,"はなむこ"],[16,1,"こえ"],[18,2,"はなよめ"],[21,1,"こえ"],[27,2,"ばんぐん"],[30,1,"しゅ"],[32,2,"かんしゃ"],[37,1,"しゅ"],[39,1,"めぐ"],[59,1,"た"],[73,2,"かんしゃ"],[76,1,"そな"],[78,1,"もの"],[80,1,"しゅ"],[82,1,"みや"],[84,1,"たずさ"],[89,1,"もの"],[91,1,"こえ"],[93,1,"きこ"],[107,1,"ち"],[109,1,"ふたた"],[111,1,"さか"],[116,1,"はじ"],[130,1,"しゅ"],[132,1,"い"]],"text":"再び喜びの声、楽しみの声、花婿の声、花嫁の声、および『万軍の主に感謝せよ、主は恵みふかく、そのいつくしみは、いつまでも絶えることがない』といって、感謝の供え物を主の宮に携えてくる者の声が聞える。それは、わたしがこの地を再び栄えさせて初めのようにするからであると主は言われる。"},{"ref":"Jer.33.12","start":24033012,"end":24033012,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"い"],[12,1,"あ"],[16,1,"ひと"],[21,1,"けもの"],[28,1,"ところ"],[37,2,"まちまち"],[40,1,"ふたた"],[44,1,"む"],[47,1,"ふ"],[51,2,"ぼくしゃ"]],"text":"万軍の主はこう言われる、荒れて、人もおらず獣もいないこの所と、そのすべての町々に再びその群れを伏させる牧者のすまいがあるようになる。"},{"ref":"Jer.33.13","start":24033013,"end":24033013,"break":"none","ruby":[[0,2,"さんち"],[3,2,"まちまち"],[7,2,"へいち"],[10,2,"まちまち"],[18,2,"まちまち"],[28,1,"ち"],[36,2,"しゅうい"],[43,2,"まちまち"],[47,1,"む"],[50,1,"ふたた"],[55,1,"かぞ"],[58,1,"もの"],[60,1,"て"],[62,1,"した"],[64,1,"とお"],[70,1,"しゅ"],[72,1,"い"]],"text":"山地の町々と、平地の町々と、ネゲブの町々と、ベニヤミンの地、エルサレムの周囲と、ユダの町々で、群れは再びそれを数える者の手の下を通りすぎると主は言われる。"},{"ref":"Jer.33.14","start":24033014,"end":24033014,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"み"],[20,1,"いえ"],[25,1,"いえ"],[27,2,"やくそく"],[36,1,"と"],[39,1,"ひ"],[41,1,"く"]],"text":"主は言われる、見よ、わたしがイスラエルの家とユダの家に約束したことをなし遂げる日が来る。"},{"ref":"Jer.33.15","start":24033015,"end":24033015,"break":"none","ruby":[[2,1,"ひ"],[6,1,"とき"],[28,1,"ただ"],[31,1,"えだ"],[33,1,"しょう"],[40,1,"かれ"],[42,2,"こうへい"],[45,2,"せいぎ"],[48,1,"ち"],[50,1,"おこな"]],"text":"その日、その時になるならば、わたしはダビデのために一つの正しい枝を生じさせよう。彼は公平と正義を地に行う。"},{"ref":"Jer.33.16","start":24033016,"end":24033016,"break":"none","ruby":[[2,1,"ひ"],[7,1,"すくい"],[9,1,"え"],[17,1,"やす"],[26,1,"な"],[29,1,"しゅ"],[36,2,"せいぎ"]],"text":"その日、ユダは救を得、エルサレムは安らかにおる。その名は『主はわれわれの正義』ととなえられる。"},{"ref":"Jer.33.17","start":24033017,"end":24033017,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"おお"],[16,1,"いえ"],[18,1,"くらい"],[20,1,"ざ"],[23,1,"ひと"],[29,2,"しそん"],[35,1,"か"]],"text":"主はこう仰せられる、イスラエルの家の位に座する人がダビデの子孫のうちに欠けることはない。"},{"ref":"Jer.33.18","start":24033018,"end":24033018,"break":"none","ruby":[[6,1,"まえ"],[8,2,"はんさい"],[15,2,"そさい"],[18,1,"や"],[24,2,"ぎせい"],[31,1,"ひと"],[41,2,"さいし"],[47,1,"た"]],"text":"またわたしの前に燔祭をささげ、素祭を焼き、つねに犠牲をささげる人が、レビびとである祭司のうちに絶えることはない」。"},{"ref":"Jer.33.19","start":24033019,"end":24033019,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[10,1,"のぞ"]],"text":"主の言葉はエレミヤに臨んだ、"},{"ref":"Jer.33.20","start":24033020,"end":24033020,"break":"none","ruby":[[1,1,"しゅ"],[5,1,"おお"],[20,1,"ひる"],[22,1,"むす"],[29,2,"けいやく"],[32,1,"やぶ"],[37,1,"よる"],[39,1,"むす"],[46,2,"けいやく"],[49,1,"やぶ"],[52,1,"ひる"],[54,1,"よる"],[56,1,"さだ"],[61,1,"とき"],[63,1,"き"]],"text":"「主はこう仰せられる、もしあなたがたが、昼と結んだわたしの契約を破り、また夜と結んだわたしの契約を破り、昼と夜が定められた時に来ないようにすることができるならば、"},{"ref":"Jer.33.21","start":24033021,"end":24033021,"break":"none","ruby":[[11,1,"むす"],[14,2,"けいやく"],[19,1,"やぶ"],[22,1,"かれ"],[26,1,"くらい"],[28,1,"ざ"],[31,1,"おう"],[35,1,"こ"],[37,1,"あた"],[54,1,"つか"],[64,2,"さいし"],[67,1,"た"],[70,2,"けいやく"],[73,1,"やぶ"]],"text":"しもべダビデとわたしが結んだ契約もまた破れ、彼はその位に座して王となる子を与えられない。またわたしがわたしに仕えるレビびとである祭司に立てた契約も破れる。"},{"ref":"Jer.33.22","start":24033022,"end":24033022,"break":"none","ruby":[[0,1,"てん"],[2,1,"ほし"],[4,1,"かぞ"],[14,1,"はま"],[16,1,"すな"],[18,1,"はか"],[45,2,"しそん"],[53,1,"つか"],[63,2,"さいし"],[66,1,"かず"],[68,1,"ま"]],"text":"天の星は数えることができず、浜の砂は量ることができない。そのようにわたしは、しもべダビデの子孫と、わたしに仕えるレビびとである祭司の数を増そう」。"},{"ref":"Jer.33.23","start":24033023,"end":24033023,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[10,1,"のぞ"]],"text":"主の言葉はエレミヤに臨んだ、"},{"ref":"Jer.33.24","start":24033024,"end":24033024,"break":"none","ruby":[[7,1,"たみ"],[11,1,"しゅ"],[13,1,"みずか"],[15,1,"えら"],[25,1,"す"],[37,1,"き"],[43,1,"かれ"],[55,1,"たみ"],[57,1,"あなど"],[64,1,"くに"]],"text":"「あなたはこの民が、『主は自ら選んだ二つのやからを捨てた』といっているのを聞かないか。彼らはこのようにわたしの民を侮って、これを国とみなさないのである。"},{"ref":"Jer.33.25","start":24033025,"end":24033025,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"い"],[15,1,"ひる"],[17,1,"よる"],[20,2,"けいやく"],[23,1,"た"],[29,2,"てんち"],[36,1,"さだ"]],"text":"主はこう言われる、もしわたしが昼と夜とに契約を立てず、また天地のおきてを定めなかったのであれば、"},{"ref":"Jer.33.26","start":24033026,"end":24033026,"break":"none","ruby":[[21,2,"しそん"],[24,1,"す"],[28,1,"ふたた"],[30,1,"かれ"],[32,2,"しそん"],[53,2,"しそん"],[56,1,"おさ"],[59,1,"もの"],[61,1,"えら"],[70,1,"かれ"],[73,1,"ふたた"],[75,1,"さか"],[80,1,"かれ"]],"text":"わたしは、ヤコブとわたしのしもべダビデとの子孫を捨てて、再び彼の子孫のうちからアブラハム、イサク、ヤコブの子孫を治める者を選ばない。わたしは彼らを再び栄えさせ、彼らにあわれみをたれよう」。"}]