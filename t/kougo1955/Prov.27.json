[{"ref":"Prov.27.1","start":20027001,"end":20027001,"break":"paragraph","breaks":[[15,"line"],[28,"line"]],"ruby":[[6,1,"ほこ"],[16,1,"にち"],[21,1,"なに"],[28,1,"し"]],"text":"あすのことを誇ってはならない、一日のうちに何がおこるかを知ることができないからだ。"},{"ref":"Prov.27.2","start":20027002,"end":20027002,"break":"line","breaks":[[19,"line"],[28,"line"],[42,"line"]],"ruby":[[0,2,"じぶん"],[3,1,"くち"],[8,1,"みずか"],[19,2,"たにん"],[28,2,"じぶん"],[45,1,"ひと"]],"text":"自分の口をもって自らをほめることなく、他人にほめさせよ。自分のくちびるをもってせず、ほかの人にあなたをほめさせよ。"},{"ref":"Prov.27.3","start":20027003,"end":20027003,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"いし"],[2,1,"おも"],[5,1,"すな"],[7,1,"かる"],[16,1,"おろ"],[19,1,"もの"],[21,1,"いか"],[31,1,"おも"]],"text":"石は重く、砂も軽くはない、しかし愚かな者の怒りはこの二つよりも重い。"},{"ref":"Prov.27.4","start":20027004,"end":20027004,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"いきどお"],[7,1,"いか"],[22,1,"まえ"],[29,1,"た"]],"text":"憤りはむごく、怒りははげしい、しかしねたみの前には、だれが立ちえよう。"},{"ref":"Prov.27.5","start":20027005,"end":20027005,"break":"line","breaks":[[12,"line"]],"ruby":[[6,1,"いまし"],[16,1,"あい"]],"text":"あからさまに戒めるのは、ひそかに愛するのにまさる。"},{"ref":"Prov.27.6","start":20027006,"end":20027006,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"あい"],[3,1,"もの"],[5,1,"きず"],[24,1,"くち"],[31,1,"いつわ"]],"text":"愛する者が傷つけるのは、まことからであり、あだの口づけするのは偽りからである。"},{"ref":"Prov.27.7","start":20027007,"end":20027007,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あ"],[5,1,"もの"],[7,2,"はちみつ"],[11,1,"ふ"],[20,1,"う"],[23,1,"もの"],[26,1,"にが"],[28,1,"もの"],[35,1,"あま"]],"text":"飽いている者は蜂蜜をも踏みつける、しかし飢えた者には苦い物でさえ、みな甘い。"},{"ref":"Prov.27.8","start":20027008,"end":20027008,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"いえ"],[4,1,"はな"],[11,1,"ひと"],[14,1,"す"],[16,1,"はな"],[23,1,"とり"]],"text":"その家を離れてさまよう人は、巣を離れてさまよう鳥のようだ。"},{"ref":"Prov.27.9","start":20027009,"end":20027009,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"あぶら"],[2,1,"こう"],[5,1,"ひと"],[7,1,"こころ"],[9,1,"よろこ"],[17,1,"たましい"],[19,1,"なや"],[25,1,"さ"]],"text":"油と香とは人の心を喜ばせる、しかし魂は悩みによって裂かれる。"},{"ref":"Prov.27.10","start":20027010,"end":20027010,"break":"line","breaks":[[19,"line"],[40,"line"]],"ruby":[[4,1,"とも"],[10,1,"ちち"],[12,1,"とも"],[14,1,"す"],[23,1,"なや"],[28,1,"ひ"],[31,2,"きょうだい"],[34,1,"いえ"],[36,1,"い"],[40,1,"ちか"],[42,1,"とな"],[44,1,"びと"],[46,1,"とお"],[51,2,"きょうだい"]],"text":"あなたの友、あなたの父の友を捨てるな、あなたが悩みにあう日には兄弟の家に行くな、近い隣り人は遠くにいる兄弟にまさる。"},{"ref":"Prov.27.11","start":20027011,"end":20027011,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"こ"],[5,2,"ちえ"],[8,1,"え"],[15,1,"こころ"],[17,1,"よろこ"],[34,1,"もの"],[36,1,"こた"]],"text":"わが子よ、知恵を得て、わたしの心を喜ばせよ、そうすればわたしをそしる者に答えることができる。"},{"ref":"Prov.27.12","start":20027012,"end":20027012,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かしこ"],[2,1,"もの"],[4,1,"わざわい"],[6,1,"み"],[8,1,"みずか"],[10,1,"さ"],[13,2,"しりょ"],[18,1,"もの"],[20,1,"すす"],[27,1,"ばつ"]],"text":"賢い者は災を見て自ら避け、思慮のない者は進んでいって、罰をうける。"},{"ref":"Prov.27.13","start":20027013,"end":20027013,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"ひと"],[5,2,"ほしょう"],[9,1,"もの"],[18,2,"きもの"],[24,2,"たにん"],[30,2,"ほしょう"],[35,1,"もの"],[38,2,"ていとう"],[41,1,"と"]],"text":"人のために保証する者からは、まずその着物をとれ、他人のために保証をする者をば抵当に取れ。"},{"ref":"Prov.27.14","start":20027014,"end":20027014,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"あさ"],[4,1,"お"],[7,2,"おおごえ"],[12,1,"とな"],[14,1,"びと"],[16,1,"しゅく"],[29,1,"み"]],"text":"朝はやく起きて大声にその隣り人を祝すれば、かえってのろいと見なされよう。"},{"ref":"Prov.27.15","start":20027015,"end":20027015,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あめ"],[2,1,"ふ"],[4,1,"ひ"],[6,2,"あまも"],[10,1,"た"],[17,1,"あらそ"],[19,1,"す"],[22,1,"おんな"],[25,1,"おな"]],"text":"雨の降る日に雨漏りの絶えないのと、争い好きな女とは同じだ。"},{"ref":"Prov.27.16","start":20027016,"end":20027016,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"おんな"],[4,1,"せい"],[9,1,"かぜ"],[11,1,"せい"],[21,1,"みぎ"],[23,1,"て"],[25,1,"あぶら"]],"text":"この女を制するのは風を制するのとおなじく、右の手に油をつかむのとおなじだ。"},{"ref":"Prov.27.17","start":20027017,"end":20027017,"break":"line","breaks":[[7,"line"]],"ruby":[[0,1,"てつ"],[2,1,"てつ"],[12,1,"ひと"],[16,1,"とも"],[18,1,"かお"]],"text":"鉄は鉄をとぐ、そのように人はその友の顔をとぐ。"},{"ref":"Prov.27.18","start":20027018,"end":20027018,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"き"],[7,1,"まも"],[9,1,"もの"],[13,1,"み"],[15,1,"た"],[19,2,"しゅじん"],[22,1,"たっと"],[24,1,"もの"],[26,1,"ほまれ"],[28,1,"え"]],"text":"いちじくの木を守る者はその実を食べる、主人を尊ぶ者は誉を得る。"},{"ref":"Prov.27.19","start":20027019,"end":20027019,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"みず"],[6,1,"かお"],[8,1,"かお"],[11,1,"おう"],[18,1,"ひと"],[20,1,"こころ"],[24,1,"ひと"]],"text":"水にうつせば顔と顔とが応じるように、人の心はその人をうつす。"},{"ref":"Prov.27.20","start":20027020,"end":20027020,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"よみ"],[3,1,"ほろ"],[7,1,"あ"],[14,1,"ひと"],[16,1,"め"],[20,1,"あ"]],"text":"陰府と滅びとは飽くことなく、人の目もまた飽くことがない。"},{"ref":"Prov.27.21","start":20027021,"end":20027021,"break":"line","breaks":[[13,"line"],[24,"line"]],"ruby":[[7,1,"ぎん"],[13,1,"ろ"],[18,1,"きん"],[24,1,"ひと"],[28,2,"しょうさん"]],"text":"るつぼによって銀をためし、炉によって金をためす、人はその称賛によってためされる。"},{"ref":"Prov.27.22","start":20027022,"end":20027022,"break":"line","breaks":[[11,"line"],[30,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[8,1,"い"],[18,1,"むぎ"],[20,1,"とも"],[32,1,"おろ"],[36,1,"さ"]],"text":"愚かな者をうすに入れ、きねをもって、麦と共にこれをついても、その愚かさは去ることがない。"},{"ref":"Prov.27.23","start":20027023,"end":20027023,"break":"stanza","breaks":[[14,"line"]],"ruby":[[4,1,"ひつじ"],[6,2,"じょうたい"],[11,1,"し"],[18,1,"む"],[21,1,"こころ"]],"text":"あなたの羊の状態をよく知り、あなたの群れに心をとめよ。"},{"ref":"Prov.27.24","start":20027024,"end":20027024,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"とみ"],[7,1,"つづ"],[20,1,"くらい"],[22,2,"まつだい"],[27,1,"たも"]],"text":"富はいつまでも続くものではない、どうして位が末代までも保つであろうか。"},{"ref":"Prov.27.25","start":20027025,"end":20027025,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"くさ"],[2,1,"か"],[4,1,"と"],[8,1,"あたら"],[11,1,"め"],[16,1,"やま"],[18,2,"ぼくそう"],[21,1,"あつ"]],"text":"草が刈り取られ、新しい芽がのび、山の牧草も集められると、"},{"ref":"Prov.27.26","start":20027026,"end":20027026,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"こひつじ"],[7,2,"いりょう"],[10,1,"だ"],[16,1,"はたけ"],[18,1,"か"],[20,1,"あたい"]],"text":"小羊はあなたの衣料を出し、やぎは畑を買う価となり、"},{"ref":"Prov.27.27","start":20027027,"end":20027027,"break":"line","breaks":[[9,"line"],[29,"line"]],"ruby":[[3,1,"ちち"],[5,1,"おお"],[18,1,"いえ"],[23,2,"しょくもつ"],[34,1,"やしな"]],"text":"やぎの乳は多くて、あなたと、あなたの家のものの食物となり、おとめらを養うのにじゅうぶんである。"}]