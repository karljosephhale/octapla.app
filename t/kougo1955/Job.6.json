[{"ref":"Job.6.1","start":18006001,"end":18006001,"break":"paragraph","ruby":[[3,1,"こた"],[6,1,"い"]],"text":"ヨブは答えて言った、"},{"ref":"Job.6.2","start":18006002,"end":18006002,"break":"stanza","breaks":[[18,"line"]],"ruby":[[8,1,"いきどお"],[11,1,"ただ"],[14,1,"はか"],[18,2,"どうじ"],[25,1,"わざわい"]],"text":"「どうかわたしの憤りが正しく量られ、同時にわたしの災も、はかりにかけられるように。"},{"ref":"Job.6.3","start":18006003,"end":18006003,"break":"line","breaks":[[23,"line"]],"ruby":[[9,1,"うみ"],[11,1,"すな"],[15,1,"おも"],[18,2,"そうい"],[32,2,"ことば"],[35,2,"けいそつ"]],"text":"そうすれば、これは海の砂よりも重いに相違ない。それゆえ、わたしの言葉が軽率であったのだ。"},{"ref":"Job.6.4","start":18006004,"end":18006004,"break":"line","breaks":[[17,"line"],[30,"line"]],"ruby":[[0,3,"ぜんのうしゃ"],[4,1,"や"],[21,1,"れい"],[25,1,"どく"],[27,1,"の"],[30,1,"かみ"],[32,1,"おそ"],[36,2,"ぐんぜい"],[44,1,"おそ"],[46,1,"せ"]],"text":"全能者の矢が、わたしのうちにあり、わたしの霊はその毒を飲み、神の恐るべき軍勢が、わたしを襲い攻めている。"},{"ref":"Job.6.5","start":18006005,"end":18006005,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"の"],[5,2,"あおくさ"],[12,1,"な"],[20,1,"うし"],[22,2,"かいば"],[25,1,"うえ"]],"text":"野ろばは、青草のあるのに鳴くであろうか。牛は飼葉の上でうなるであろうか。"},{"ref":"Job.6.6","start":18006006,"end":18006006,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"あじ"],[4,1,"もの"],[6,1,"しお"],[11,1,"た"],[28,1,"あじ"]],"text":"味のない物は塩がなくて食べられようか。すべりひゆのしるは味があろうか。"},{"ref":"Job.6.7","start":18006007,"end":18006007,"break":"line","breaks":[[19,"line"]],"ruby":[[4,2,"しょくよく"],[10,1,"ふ"],[16,1,"こば"],[30,2,"しょくもつ"]],"text":"わたしの食欲はこれに触れることを拒む。これは、わたしのきらう食物のようだ。"},{"ref":"Job.6.8","start":18006008,"end":18006008,"break":"stanza","breaks":[[21,"line"]],"ruby":[[7,1,"もと"],[13,1,"え"],[24,1,"かみ"],[30,1,"のぞ"]],"text":"どうかわたしの求めるものが獲られるように。どうか神がわたしの望むものをくださるように。"},{"ref":"Job.6.9","start":18006009,"end":18006009,"break":"line","breaks":[[22,"line"]],"ruby":[[3,1,"かみ"],[9,1,"う"],[11,1,"ほろ"],[23,1,"て"],[25,1,"の"],[32,1,"た"]],"text":"どうか神がわたしを打ち滅ぼすことをよしとし、み手を伸べてわたしを断たれるように。"},{"ref":"Job.6.10","start":18006010,"end":18006010,"break":"line","breaks":[[17,"line"],[37,"line"],[49,"line"]],"ruby":[[12,1,"なぐさ"],[15,1,"え"],[17,1,"はげ"],[20,1,"くる"],[24,1,"なか"],[30,1,"よろこ"],[41,1,"せい"],[44,1,"もの"],[46,2,"ことば"],[49,1,"いな"]],"text":"そうすれば、わたしはなお慰めを得、激しい苦しみの中にあっても喜ぶであろう。わたしは聖なる者の言葉を否んだことがないからだ。"},{"ref":"Job.6.11","start":18006011,"end":18006011,"break":"line","breaks":[[13,"line"],[26,"line"],[41,"line"]],"ruby":[[7,1,"ちから"],[15,1,"ま"],[33,1,"おわ"],[43,1,"た"],[45,1,"しの"]],"text":"わたしにどんな力があって、なお待たねばならないのか。わたしにどんな終りがあるので、なお耐え忍ばねばならないのか。"},{"ref":"Job.6.12","start":18006012,"end":18006012,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"ちから"],[6,1,"いし"],[8,1,"ちから"],[22,1,"にく"],[24,2,"せいどう"]],"text":"わたしの力は石の力のようであるのか。わたしの肉は青銅のようであるのか。"},{"ref":"Job.6.13","start":18006013,"end":18006013,"break":"line","breaks":[[18,"line"]],"ruby":[[12,1,"たす"],[18,1,"すく"],[22,1,"のぞ"],[31,1,"お"]],"text":"まことに、わたしのうちに助けはなく、救われる望みは、わたしから追いやられた。"},{"ref":"Job.6.14","start":18006014,"end":18006014,"break":"stanza","breaks":[[21,"line"]],"ruby":[[2,1,"とも"],[4,1,"たい"],[15,1,"ひか"],[18,1,"もの"],[21,3,"ぜんのうしゃ"],[25,1,"おそ"]],"text":"その友に対するいつくしみをさし控える者は、全能者を恐れることをすてる。"},{"ref":"Job.6.15","start":18006015,"end":18006015,"break":"line","breaks":[[14,"line"]],"ruby":[[2,2,"きょうだい"],[7,2,"たにがわ"],[14,1,"す"],[16,1,"さ"],[18,2,"でみず"],[24,1,"あざむ"]],"text":"わが兄弟たちは谷川のように、過ぎ去る出水のように欺く。"},{"ref":"Job.6.16","start":18006016,"end":18006016,"break":"line","breaks":[[13,"line"]],"ruby":[[3,1,"こおり"],[8,1,"くろ"],[18,1,"ゆき"],[20,1,"かく"]],"text":"これは氷のために黒くなり、そのうちに雪が隠れる。"},{"ref":"Job.6.17","start":18006017,"end":18006017,"break":"line","breaks":[[14,"line"]],"ruby":[[3,1,"あたた"],[9,1,"き"],[11,1,"さ"],[14,1,"あつ"],[21,1,"ところ"]],"text":"これは暖かになると消え去り、暑くなるとその所からなくなる。"},{"ref":"Job.6.18","start":18006018,"end":18006018,"break":"line","breaks":[[10,"line"]],"ruby":[[0,2,"たいしょう"],[5,1,"みち"],[7,1,"てん"],[14,1,"ところ"],[16,1,"い"],[19,1,"ほろ"]],"text":"隊商はその道を転じ、むなしい所へ行って滅びる。"},{"ref":"Job.6.19","start":18006019,"end":18006019,"break":"line","breaks":[[12,"line"]],"ruby":[[3,2,"たいしょう"],[9,1,"のぞ"],[15,1,"たび"],[22,1,"した"]],"text":"テマの隊商はこれを望み、シバの旅びとはこれを慕う。"},{"ref":"Job.6.20","start":18006020,"end":18006020,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[13,2,"しつぼう"],[20,1,"き"]],"text":"彼らはこれにたよったために失望し、そこに来てみて、あわてる。"},{"ref":"Job.6.21","start":18006021,"end":18006021,"break":"line","breaks":[[23,"line"]],"ruby":[[6,1,"いま"],[17,1,"もの"],[33,2,"さいなん"],[36,1,"み"],[38,1,"おそ"]],"text":"あなたがたは今わたしにはこのような者となった。あなたがたはわたしの災難を見て恐れた。"},{"ref":"Job.6.22","start":18006022,"end":18006022,"break":"line","breaks":[[25,"line"],[43,"line"]],"ruby":[[4,1,"い"],[19,1,"あた"],[36,2,"ざいさん"],[56,1,"おく"]],"text":"わたしは言ったことがあるか、『わたしに与えよ』と、あるいは『あなたがたの財産のうちからわたしのために、まいないを贈れ』と、"},{"ref":"Job.6.23","start":18006023,"end":18006023,"break":"line","breaks":[[22,"line"],[37,"line"]],"ruby":[[8,1,"て"],[15,1,"すく"],[17,1,"だ"],[32,1,"もの"],[34,1,"て"]],"text":"あるいは『あだの手からわたしを救い出せ』と、あるいは『しえたげる者の手からわたしをあがなえ』と。"},{"ref":"Job.6.24","start":18006024,"end":18006024,"break":"stanza","breaks":[[24,"line"]],"ruby":[[4,1,"おし"],[17,1,"だま"],[28,1,"あやま"],[33,1,"ところ"],[39,1,"さと"]],"text":"わたしに教えよ、そうすればわたしは黙るであろう。わたしの誤っている所をわたしに悟らせよ。"},{"ref":"Job.6.25","start":18006025,"end":18006025,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ただ"],[3,2,"ことば"],[9,1,"ちから"],[26,1,"いまし"],[29,1,"なに"],[31,1,"いまし"]],"text":"正しい言葉はいかに力のあるものか。しかしあなたがたの戒めは何を戒めるのか。"},{"ref":"Job.6.26","start":18006026,"end":18006026,"break":"line","breaks":[[19,"line"]],"ruby":[[6,2,"ことば"],[9,1,"いまし"],[14,1,"おも"],[19,1,"のぞ"],[22,1,"た"],[25,1,"もの"],[27,1,"かた"],[32,1,"かぜ"]],"text":"あなたがたは言葉を戒めうると思うのか。望みの絶えた者の語ることは風のようなものだ。"},{"ref":"Job.6.27","start":18006027,"end":18006027,"break":"line","breaks":[[21,"line"]],"ruby":[[27,1,"とも"],[31,1,"う"],[33,1,"か"]],"text":"あなたがたは、みなしごのためにくじをひき、あなたがたの友をさえ売り買いするであろう。"},{"ref":"Job.6.28","start":18006028,"end":18006028,"break":"stanza","breaks":[[14,"line"]],"ruby":[[0,1,"いま"],[9,1,"み"],[24,1,"かお"],[26,1,"む"],[30,1,"いつわ"]],"text":"今、どうぞわたしを見られよ、わたしはあなたがたの顔に向かって偽らない。"},{"ref":"Job.6.29","start":18006029,"end":18006029,"break":"line","breaks":[[21,"line"],[30,"line"]],"ruby":[[4,1,"おも"],[24,1,"おも"],[34,1,"ぎ"]],"text":"どうぞ、思いなおせ、まちがってはならない。さらに思いなおせ、わたしの義は、なおわたしのうちにある。"},{"ref":"Job.6.30","start":18006030,"end":18006030,"break":"line","breaks":[[13,"line"],[21,"line"]],"ruby":[[4,1,"した"],[6,2,"ふぎ"],[17,1,"くち"],[19,1,"わざわい"]],"text":"わたしの舌に不義があるか。わたしの口は災をわきまえることができぬであろうか。"}]