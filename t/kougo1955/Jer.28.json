[{"ref":"Jer.28.1","start":24028001,"end":24028001,"break":"paragraph","ruby":[[2,1,"ねん"],[11,1,"おう"],[17,2,"ちせい"],[20,1,"はじ"],[25,1,"だい"],[27,1,"ねん"],[30,1,"がつ"],[36,2,"しゅっしん"],[39,3,"よげんしゃ"],[51,1,"こ"],[61,1,"しゅ"],[63,1,"みや"],[65,2,"さいし"],[72,1,"たみ"],[74,1,"まえ"],[80,1,"かた"],[83,1,"い"]],"text":"その年、すなわちユダの王ゼデキヤの治世の初め、その第四年の五月、ギベオン出身の預言者であって、アズルの子であるハナニヤは、主の宮で祭司とすべての民の前でわたしに語って言った、"},{"ref":"Jer.28.2","start":24028002,"end":24028002,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[12,1,"かみ"],[16,1,"おお"],[31,1,"おう"],[37,1,"くだ"]],"text":"「万軍の主、イスラエルの神はこう仰せられる、わたしはバビロンの王のくびきを砕いた。"},{"ref":"Jer.28.3","start":24028003,"end":24028003,"break":"none","ruby":[[1,1,"ねん"],[3,1,"うち"],[11,1,"おう"],[23,1,"ところ"],[26,1,"と"],[34,1,"たずさ"],[37,1,"い"],[40,1,"しゅ"],[42,1,"みや"],[44,1,"うつわ"],[47,1,"みな"],[50,1,"ところ"],[52,1,"かえ"]],"text":"二年の内に、バビロンの王ネブカデネザルが、この所から取ってバビロンに携えて行った主の宮の器を、皆この所に帰らせる。"},{"ref":"Jer.28.4","start":24028004,"end":24028004,"break":"none","ruby":[[9,1,"おう"],[16,1,"こ"],[28,1,"い"],[38,1,"とら"],[41,1,"びと"],[45,1,"ところ"],[47,1,"かえ"],[65,1,"おう"],[72,1,"くだ"],[80,1,"しゅ"],[82,1,"い"]],"text":"わたしはまたユダの王エホヤキムの子エコニヤと、バビロンに行ったユダのすべての捕われ人をこの所に帰らせる。それは、わたしがバビロンの王のくびきを、砕くからであると主は言われる」。"},{"ref":"Jer.28.5","start":24028005,"end":24028005,"break":"paragraph","ruby":[[3,3,"よげんしゃ"],[11,1,"しゅ"],[13,1,"みや"],[18,1,"た"],[23,2,"さいし"],[30,1,"たみ"],[32,1,"まえ"],[35,3,"よげんしゃ"],[43,1,"い"]],"text":"そこで預言者エレミヤは主の宮のうちに立っている祭司とすべての民の前で、預言者ハナニヤに言った。"},{"ref":"Jer.28.6","start":24028006,"end":24028006,"break":"none","ruby":[[4,3,"よげんしゃ"],[12,1,"い"],[25,1,"しゅ"],[49,2,"よげん"],[53,2,"ことば"],[56,2,"じょうじゅ"],[66,1,"たずさ"],[69,1,"い"],[72,1,"しゅ"],[74,1,"みや"],[76,1,"うつわ"],[82,1,"とら"],[85,1,"びと"],[88,1,"しゅ"],[96,1,"ふたた"],[100,1,"ところ"],[102,1,"かえ"]],"text":"すなわち預言者エレミヤは言った、「アァメン。どうか主がこのようにしてくださるように。どうかあなたの預言した言葉が成就して、バビロンに携えて行った主の宮の器とすべての捕われ人を、主がバビロンから再びこの所に帰らせてくださるように。"},{"ref":"Jer.28.7","start":24028007,"end":24028007,"break":"none","ruby":[[4,1,"いま"],[17,1,"たみ"],[19,1,"き"],[24,1,"ところ"],[26,1,"かた"],[30,2,"ことば"],[33,1,"き"]],"text":"ただし、今わたしがあなたとすべての民の聞いている所で語るこの言葉を聞きなさい。"},{"ref":"Jer.28.8","start":24028008,"end":24028008,"break":"none","ruby":[[9,1,"さき"],[11,1,"で"],[13,3,"よげんしゃ"],[24,1,"おお"],[27,1,"ち"],[29,1,"おお"],[32,1,"くに"],[38,1,"たたか"],[47,2,"えきびょう"],[50,1,"こと"],[52,2,"よげん"]],"text":"わたしと、あなたの先に出た預言者は、むかしから、多くの地と大きな国について、戦いと、ききんと、疫病の事を預言した。"},{"ref":"Jer.28.9","start":24028009,"end":24028009,"break":"none","ruby":[[0,2,"へいわ"],[3,2,"よげん"],[7,3,"よげんしゃ"],[14,3,"よげんしゃ"],[18,2,"ことば"],[21,2,"じょうじゅ"],[28,2,"しんじつ"],[31,1,"しゅ"],[35,3,"よげんしゃ"],[52,1,"し"]],"text":"平和を預言する預言者は、その預言者の言葉が成就するとき、真実に主がその預言者をつかわされたのであることが知られるのだ」。"},{"ref":"Jer.28.10","start":24028010,"end":24028010,"break":"paragraph","ruby":[[3,3,"よげんしゃ"],[11,3,"よげんしゃ"],[19,1,"くび"],[27,1,"と"],[34,1,"くだ"]],"text":"そこで預言者ハナニヤは預言者エレミヤの首から、くびきを取って、それを砕いた。"},{"ref":"Jer.28.11","start":24028011,"end":24028011,"break":"none","ruby":[[13,1,"たみ"],[15,1,"まえ"],[17,1,"かた"],[21,1,"しゅ"],[25,1,"おお"],[37,1,"ねん"],[49,3,"ばんこくみん"],[53,1,"くび"],[61,1,"おう"],[74,1,"はな"],[77,1,"くだ"],[82,1,"い"],[86,3,"よげんしゃ"],[94,1,"さ"],[97,1,"い"]],"text":"そしてハナニヤは、すべての民の前で語り、「主はこう仰せられる、『わたしは二年のうちに、このように、万国民の首からバビロンの王ネブカデネザルのくびきを離して砕く』」と言った。預言者エレミヤは去って行った。"},{"ref":"Jer.28.12","start":24028012,"end":24028012,"break":"paragraph","ruby":[[0,3,"よげんしゃ"],[8,3,"よげんしゃ"],[16,1,"くび"],[24,1,"はな"],[27,1,"くだ"],[30,1,"のち"],[38,1,"しゅ"],[40,2,"ことば"],[48,1,"のぞ"]],"text":"預言者ハナニヤが預言者エレミヤの首から、くびきを離して砕いた後、しばらくして主の言葉がエレミヤに臨んだ、"},{"ref":"Jer.28.13","start":24028013,"end":24028013,"break":"none","ruby":[[1,1,"い"],[10,1,"つ"],[17,1,"しゅ"],[21,1,"おお"],[31,1,"き"],[37,1,"くだ"],[49,1,"か"],[52,1,"てつ"],[58,1,"つく"]],"text":"「行って、ハナニヤに告げなさい、『主はこう仰せられる、あなたは木のくびきを砕いたが、わたしはそれに替えて鉄のくびきを作ろう。"},{"ref":"Jer.28.14","start":24028014,"end":24028014,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[15,1,"おお"],[25,1,"てつ"],[33,3,"ばんこくみん"],[37,1,"くび"],[39,1,"お"],[48,1,"おう"],[57,1,"つか"],[63,1,"かれ"],[69,1,"つか"],[77,1,"の"],[79,1,"けもの"],[82,1,"かれ"],[84,1,"あた"]],"text":"万軍の主、イスラエルの神はこう仰せられる、わたしは鉄のくびきをこの万国民の首に置いて、バビロンの王ネブカデネザルに仕えさせる。彼らはこれに仕える。わたしは野の獣をも彼に与えた』」。"},{"ref":"Jer.28.15","start":24028015,"end":24028015,"break":"none","ruby":[[0,3,"よげんしゃ"],[10,3,"よげんしゃ"],[18,1,"い"],[29,1,"き"],[35,1,"しゅ"],[59,1,"たみ"],[61,1,"いつわ"],[64,1,"しん"]],"text":"預言者エレミヤはまた預言者ハナニヤに言った、「ハナニヤよ、聞きなさい。主があなたをつかわされたのではない。あなたはこの民に偽りを信じさせた。"},{"ref":"Jer.28.16","start":24028016,"end":24028016,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"おお"],[21,1,"ち"],[28,1,"のぞ"],[35,1,"しゅ"],[37,1,"たい"],[40,2,"はんぎゃく"],[43,1,"かた"],[49,1,"いま"],[50,1,"とし"],[55,1,"し"]],"text":"それゆえ主は仰せられる、『わたしはあなたを地のおもてから除く。あなたは主に対する反逆を語ったので、今年のうちに死ぬのだ』と」。"},{"ref":"Jer.28.17","start":24028017,"end":24028017,"break":"paragraph","ruby":[[0,3,"よげんしゃ"],[10,1,"ねん"],[13,1,"がつ"],[15,1,"し"]],"text":"預言者ハナニヤはその年の七月に死んだ。"}]