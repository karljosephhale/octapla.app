[{"ref":"Num.11.1","start":4011001,"end":4011001,"break":"paragraph","ruby":[[3,1,"たみ"],[5,2,"さいなん"],[8,1,"あ"],[13,1,"ひと"],[19,1,"しゅ"],[21,1,"みみ"],[29,1,"しゅ"],[34,1,"き"],[37,1,"いか"],[40,1,"はっ"],[45,1,"しゅ"],[47,1,"ひ"],[49,1,"かれ"],[55,1,"も"],[62,2,"しゅくえい"],[65,1,"はし"],[67,1,"や"]],"text":"さて、民は災難に会っている人のように、主の耳につぶやいた。主はこれを聞いて怒りを発せられ、主の火が彼らのうちに燃えあがって、宿営の端を焼いた。"},{"ref":"Num.11.2","start":4011002,"end":4011002,"break":"none","ruby":[[3,1,"たみ"],[13,1,"さけ"],[21,1,"しゅ"],[23,1,"いの"],[31,1,"ひ"]],"text":"そこで民はモーセにむかって叫んだ。モーセが主に祈ったので、その火はしずまった。"},{"ref":"Num.11.3","start":4011003,"end":4011003,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"ひ"],[4,1,"かれ"],[10,1,"も"],[25,1,"ところ"],[27,1,"な"],[33,1,"よ"]],"text":"主の火が彼らのうちに燃えあがったことによって、その所の名はタベラと呼ばれた。"},{"ref":"Num.11.4","start":4011004,"end":4011004,"break":"paragraph","ruby":[[2,1,"かれ"],[10,1,"おお"],[13,1,"よ"],[15,1,"あつ"],[21,2,"よくしん"],[24,1,"おこ"],[33,2,"ひとびと"],[38,1,"ふたた"],[40,1,"な"],[43,1,"い"],[51,1,"にく"],[53,1,"た"]],"text":"また彼らのうちにいた多くの寄り集まりびとは欲心を起し、イスラエルの人々もまた再び泣いて言った、「ああ、肉が食べたい。"},{"ref":"Num.11.5","start":4011005,"end":4011005,"break":"none","ruby":[[5,1,"おも"],[7,1,"おこ"],[22,1,"うお"],[24,1,"た"]],"text":"われわれは思い起すが、エジプトでは、ただで、魚を食べた。きゅうりも、すいかも、にらも、たまねぎも、そして、にんにくも。"},{"ref":"Num.11.6","start":4011006,"end":4011006,"break":"none","ruby":[[12,2,"せいこん"],[15,1,"つ"],[24,1,"め"],[26,1,"まえ"],[37,1,"なに"]],"text":"しかし、いま、われわれの精根は尽きた。われわれの目の前には、このマナのほか何もない」。"},{"ref":"Num.11.7","start":4011007,"end":4011007,"break":"paragraph","ruby":[[10,1,"み"],[16,1,"いろ"],[23,1,"いろ"]],"text":"マナは、こえんどろの実のようで、色はブドラクの色のようであった。"},{"ref":"Num.11.8","start":4011008,"end":4011008,"break":"none","ruby":[[0,1,"たみ"],[2,1,"ある"],[12,1,"あつ"],[36,1,"に"],[50,1,"あじ"],[52,1,"あぶら"],[53,2,"かし"],[56,1,"あじ"]],"text":"民は歩きまわって、これを集め、ひきうすでひき、または、うすでつき、かまで煮て、これをもちとした。その味は油菓子の味のようであった。"},{"ref":"Num.11.9","start":4011009,"end":4011009,"break":"none","ruby":[[0,1,"よる"],[2,2,"しゅくえい"],[5,1,"つゆ"],[19,1,"とも"],[21,1,"ふ"]],"text":"夜、宿営の露がおりるとき、マナはそれと共に降った。"},{"ref":"Num.11.10","start":4011010,"end":4011010,"break":"paragraph","ruby":[[5,1,"たみ"],[7,1,"いえ"],[18,2,"てんまく"],[21,2,"いりぐち"],[24,1,"な"],[28,1,"き"],[35,1,"しゅ"],[37,1,"はげ"],[40,1,"いか"],[50,2,"ふかい"],[53,1,"おも"]],"text":"モーセは、民が家ごとに、おのおのその天幕の入口で泣くのを聞いた。そこで主は激しく怒られ、またモーセは不快に思った。"},{"ref":"Num.11.11","start":4011011,"end":4011011,"break":"none","ruby":[[8,1,"しゅ"],[10,1,"い"],[26,1,"わる"],[28,2,"しう"],[52,1,"まえ"],[54,1,"めぐ"],[57,1,"え"],[68,1,"たみ"],[70,2,"おもに"],[73,1,"お"]],"text":"そして、モーセは主に言った、「あなたはなぜ、しもべに悪い仕打ちをされるのですか。どうしてわたしはあなたの前に恵みを得ないで、このすべての民の重荷を負わされるのですか。"},{"ref":"Num.11.12","start":4011012,"end":4011012,"break":"none","ruby":[[10,1,"たみ"],[29,1,"う"],[57,1,"やしな"],[59,1,"おや"],[61,2,"にゅうじ"],[64,1,"だ"],[70,1,"かれ"],[78,1,"だ"],[86,1,"かれ"],[89,2,"せんぞ"],[94,1,"ちか"],[98,1,"ち"],[100,1,"い"],[104,1,"い"]],"text":"わたしがこのすべての民を、はらんだのですか。わたしがこれを生んだのですか。そうではないのに、あなたはなぜわたしに『養い親が乳児を抱くように、彼らをふところに抱いて、あなたが彼らの先祖たちに誓われた地に行け』と言われるのですか。"},{"ref":"Num.11.13","start":4011013,"end":4011013,"break":"none","ruby":[[8,1,"にく"],[10,1,"え"],[19,1,"たみ"],[21,1,"あた"],[35,1,"かれ"],[38,1,"な"],[43,1,"にく"],[45,1,"た"],[56,1,"い"]],"text":"わたしはどこから肉を獲て、このすべての民に与えることができましょうか。彼らは泣いて、『肉を食べさせよ』とわたしに言っているのです。"},{"ref":"Num.11.14","start":4011014,"end":4011014,"break":"none","ruby":[[15,1,"たみ"],[17,1,"お"],[36,1,"おも"],[37,1,"す"]],"text":"わたしひとりでは、このすべての民を負うことができません。それはわたしには重過ぎます。"},{"ref":"Num.11.15","start":4011015,"end":4011015,"break":"none","ruby":[[10,1,"まえ"],[12,1,"めぐ"],[15,1,"え"],[31,2,"しう"],[48,1,"おも"],[51,1,"ころ"],[58,1,"くる"],[62,1,"あ"]],"text":"もしわたしがあなたの前に恵みを得ますならば、わたしにこのような仕打ちをされるよりは、むしろ、ひと思いに殺し、このうえ苦しみに会わせないでください」。"},{"ref":"Num.11.16","start":4011016,"end":4011016,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[18,2,"ちょうろう"],[26,1,"たみ"],[28,2,"ちょうろう"],[50,1,"し"],[55,1,"もの"],[58,1,"にん"],[67,1,"あつ"],[70,2,"かいけん"],[73,2,"まくや"],[76,1,"つ"],[89,1,"とも"],[91,1,"た"]],"text":"主はモーセに言われた、「イスラエルの長老たちのうち、民の長老となり、つかさとなるべきことを、あなたが知っている者七十人をわたしのもとに集め、会見の幕屋に連れてきて、そこにあなたと共に立たせなさい。"},{"ref":"Num.11.17","start":4011017,"end":4011017,"break":"none","ruby":[[4,1,"くだ"],[10,1,"ところ"],[17,1,"かた"],[30,1,"うえ"],[34,1,"れい"],[37,1,"かれ"],[41,1,"わ"],[43,1,"あた"],[51,1,"かれ"],[58,1,"とも"],[61,1,"たみ"],[63,2,"おもに"],[66,1,"お"],[84,1,"お"]],"text":"わたしは下って、その所で、あなたと語り、またわたしはあなたの上にある霊を、彼らにも分け与えるであろう。彼らはあなたと共に、民の重荷を負い、あなたが、ただひとりで、それを負うことのないようにするであろう。"},{"ref":"Num.11.18","start":4011018,"end":4011018,"break":"none","ruby":[[6,1,"たみ"],[8,1,"い"],[21,1,"み"],[23,1,"きよ"],[30,1,"ま"],[42,1,"にく"],[44,1,"た"],[64,1,"な"],[67,1,"しゅ"],[69,1,"みみ"],[78,1,"にく"],[80,1,"た"],[92,1,"とき"],[94,1,"よ"],[99,1,"い"],[113,1,"しゅ"],[121,1,"にく"],[123,1,"あた"],[126,1,"た"]],"text":"あなたはまた民に言いなさい、『あなたがたは身を清めて、あすを待ちなさい。あなたがたは肉を食べることができるであろう。あなたがたが泣いて主の耳に、わたしたちは肉が食べたい。エジプトにいた時は良かったと言ったからである。それゆえ、主はあなたがたに肉を与えて食べさせられるであろう。"},{"ref":"Num.11.19","start":4011019,"end":4011019,"break":"none","ruby":[[9,1,"た"],[16,1,"にち"],[18,2,"ふつか"],[22,1,"か"],[25,1,"か"],[27,3,"はつか"]],"text":"あなたがたがそれを食べるのは、一日や二日や五日や十日や二十日ではなく、"},{"ref":"Num.11.20","start":4011020,"end":4011020,"break":"none","ruby":[[2,1,"げつ"],[4,1,"およ"],[16,1,"はな"],[19,1,"で"],[37,1,"あ"],[39,1,"は"],[63,1,"しゅ"],[65,1,"かる"],[72,1,"まえ"],[74,1,"な"],[92,1,"で"],[101,1,"い"]],"text":"一か月に及び、ついにあなたがたの鼻から出るようになり、あなたがたは、それに飽き果てるであろう。それはあなたがたのうちにおられる主を軽んじて、その前に泣き、なぜ、わたしたちはエジプトから出てきたのだろうと言ったからである』」。"},{"ref":"Num.11.21","start":4011021,"end":4011021,"break":"none","ruby":[[4,1,"い"],[13,1,"とも"],[17,1,"たみ"],[19,2,"とほ"],[22,2,"だんし"],[48,1,"かれ"],[51,1,"にく"],[53,1,"あた"],[58,1,"げつ"],[63,1,"た"],[71,1,"い"]],"text":"モーセは言った、「わたしと共におる民は徒歩の男子だけでも六十万です。ところがあなたは、『わたしは彼らに肉を与えて一か月のあいだ食べさせよう』と言われます。"},{"ref":"Num.11.22","start":4011022,"end":4011022,"break":"none","ruby":[[0,1,"ひつじ"],[2,1,"うし"],[4,1,"む"],[7,1,"かれ"],[18,1,"かれ"],[21,1,"あ"],[34,1,"うみ"],[40,1,"うお"],[42,1,"かれ"],[48,1,"あつ"],[52,1,"かれ"],[55,1,"あ"]],"text":"羊と牛の群れを彼らのためにほふって、彼らを飽きさせるというのですか。海のすべての魚を彼らのために集めて、彼らを飽きさせるというのですか」。"},{"ref":"Num.11.23","start":4011023,"end":4011023,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"しゅ"],[14,1,"て"],[16,1,"みじか"],[34,2,"ことば"],[37,1,"な"],[44,1,"み"]],"text":"主はモーセに言われた、「主の手は短かろうか。あなたは、いま、わたしの言葉の成るかどうかを見るであろう」。"},{"ref":"Num.11.24","start":4011024,"end":4011024,"break":"paragraph","ruby":[[2,1,"とき"],[7,1,"で"],[10,1,"しゅ"],[12,2,"ことば"],[15,1,"たみ"],[17,1,"つ"],[20,1,"たみ"],[22,2,"ちょうろう"],[28,1,"にん"],[30,1,"あつ"],[34,2,"まくや"],[37,2,"しゅうい"],[40,1,"た"]],"text":"この時モーセは出て、主の言葉を民に告げ、民の長老たち七十人を集めて、幕屋の周囲に立たせた。"},{"ref":"Num.11.25","start":4011025,"end":4011025,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"くも"],[10,1,"くだ"],[17,1,"かた"],[25,1,"うえ"],[29,1,"れい"],[36,1,"にん"],[38,2,"ちょうろう"],[44,1,"わ"],[46,1,"あた"],[54,1,"れい"],[56,1,"かれ"],[59,1,"うえ"],[66,1,"とき"],[68,1,"かれ"],[71,2,"よげん"],[82,1,"のち"],[84,1,"かさ"],[87,2,"よげん"]],"text":"主は雲のうちにあって下り、モーセと語られ、モーセの上にある霊を、その七十人の長老たちにも分け与えられた。その霊が彼らの上にとどまった時、彼らは預言した。ただし、その後は重ねて預言しなかった。"},{"ref":"Num.11.26","start":4011026,"end":4011026,"break":"paragraph","ruby":[[2,1,"とき"],[7,1,"もの"],[10,2,"しゅくえい"],[26,1,"な"],[33,1,"い"],[40,1,"な"],[50,1,"かれ"],[53,1,"うえ"],[56,1,"れい"],[64,1,"かれ"],[67,1,"な"],[74,1,"もの"],[81,2,"まくや"],[84,1,"い"],[93,2,"しゅくえい"],[99,2,"よげん"]],"text":"その時ふたりの者が、宿営にとどまっていたが、ひとりの名はエルダデと言い、ひとりの名はメダデといった。彼らの上にも霊がとどまった。彼らは名をしるされた者であったが、幕屋に行かなかったので、宿営のうちで預言した。"},{"ref":"Num.11.27","start":4011027,"end":4011027,"break":"none","ruby":[[0,1,"とき"],[6,2,"わかもの"],[9,1,"はし"],[19,1,"つ"],[22,1,"い"],[37,2,"しゅくえい"],[43,2,"よげん"]],"text":"時にひとりの若者が走ってきて、モーセに告げて言った、「エルダデとメダデとが宿営のうちで預言しています」。"},{"ref":"Num.11.28","start":4011028,"end":4011028,"break":"none","ruby":[[0,1,"わか"],[2,1,"とき"],[9,2,"じゅうしゃ"],[18,1,"こ"],[24,1,"こた"],[27,1,"い"],[34,1,"しゅ"],[41,1,"かれ"],[46,1,"と"]],"text":"若い時からモーセの従者であったヌンの子ヨシュアは答えて言った、「わが主、モーセよ、彼らをさし止めてください」。"},{"ref":"Num.11.29","start":4011029,"end":4011029,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[23,1,"おも"],[31,1,"おこ"],[39,1,"しゅ"],[41,1,"たみ"],[45,3,"よげんしゃ"],[52,1,"しゅ"],[56,1,"れい"],[58,1,"かれ"],[61,1,"あた"],[70,1,"ねが"]],"text":"モーセは彼に言った、「あなたは、わたしのためを思って、ねたみを起しているのか。主の民がみな預言者となり、主がその霊を彼らに与えられることは、願わしいことだ」。"},{"ref":"Num.11.30","start":4011030,"end":4011030,"break":"none","ruby":[[14,2,"ちょうろう"],[19,1,"とも"],[22,2,"しゅくえい"],[25,1,"ひ"]],"text":"こうしてモーセはイスラエルの長老たちと共に、宿営に引きあげた。"},{"ref":"Num.11.31","start":4011031,"end":4011031,"break":"paragraph","ruby":[[3,1,"しゅ"],[9,1,"かぜ"],[11,1,"おこ"],[14,1,"うみ"],[16,1,"む"],[26,1,"はこ"],[35,2,"しゅくえい"],[38,1,"ちか"],[41,1,"おと"],[47,1,"お"],[50,2,"はんい"],[54,2,"しゅくえい"],[57,2,"しゅうい"],[64,1,"がわ"],[72,1,"にち"],[74,2,"こうてい"],[80,1,"がわ"],[88,1,"にち"],[90,2,"こうてい"],[93,2,"じめん"],[97,1,"たか"]],"text":"さて、主のもとから風が起り、海の向こうから、うずらを運んできて、これを宿営の近くに落した。その落ちた範囲は、宿営の周囲で、こちら側も、おおよそ一日の行程、あちら側も、おおよそ一日の行程、地面から高さおおよそ二キュビトであった。"},{"ref":"Num.11.32","start":4011032,"end":4011032,"break":"none","ruby":[[3,1,"たみ"],[5,1,"た"],[7,1,"あ"],[13,1,"ひ"],[15,2,"しゅうじつ"],[20,1,"よ"],[22,2,"しゅうや"],[29,1,"つぎ"],[31,1,"ひ"],[33,2,"しゅうじつ"],[40,1,"あつ"],[45,1,"あつ"],[48,1,"こと"],[50,1,"もっと"],[52,1,"すく"],[55,1,"もの"],[64,1,"あつ"],[68,1,"かれ"],[77,2,"しゅくえい"],[80,2,"しゅうい"],[83,1,"ひろ"]],"text":"そこで民は立ち上がってその日は終日、その夜は終夜、またその次の日も終日、うずらを集めたが、集める事の最も少ない者も、十ホメルほど集めた。彼らはみな、それを宿営の周囲に広げておいた。"},{"ref":"Num.11.33","start":4011033,"end":4011033,"break":"none","ruby":[[2,1,"にく"],[7,1,"かれ"],[10,1,"は"],[12,1,"あいだ"],[17,1,"た"],[28,1,"しゅ"],[30,1,"たみ"],[36,1,"いか"],[39,1,"はっ"],[42,1,"しゅ"],[44,2,"ひじょう"],[47,1,"はげ"],[50,2,"えきびょう"],[56,1,"たみ"],[58,1,"う"]],"text":"その肉がなお、彼らの歯の間にあって食べつくさないうちに、主は民にむかって怒りを発し、主は非常に激しい疫病をもって民を撃たれた。"},{"ref":"Num.11.34","start":4011034,"end":4011034,"break":"none","ruby":[[9,1,"ところ"],[11,1,"な"],[23,1,"よ"],[28,2,"よくしん"],[31,1,"おこ"],[34,1,"たみ"],[40,1,"う"]],"text":"これによって、その所の名はキブロテ・ハッタワと呼ばれた。欲心を起した民を、そこに埋めたからである。"},{"ref":"Num.11.35","start":4011035,"end":4011035,"break":"none","ruby":[[12,1,"たみ"],[19,1,"すす"]],"text":"キブロテ・ハッタワから、民はハゼロテに進み、ハゼロテにとどまった。"}]