[{"ref":"Isa.44.1","start":23044001,"end":23044001,"break":"paragraph","breaks":[[14,"line"]],"ruby":[[18,1,"えら"],[30,1,"き"]],"text":"しかし、わがしもべヤコブよ、わたしが選んだイスラエルよ、いま聞け。"},{"ref":"Isa.44.2","start":23044002,"end":23044002,"break":"line","breaks":[[18,"line"],[34,"line"],[45,"line"]],"ruby":[[4,1,"つく"],[11,2,"たいない"],[14,1,"かたち"],[15,1,"つく"],[22,1,"たす"],[25,1,"しゅ"],[29,1,"い"],[49,1,"えら"],[59,1,"おそ"]],"text":"あなたを造り、あなたを胎内に形造り、あなたを助ける主はこう言われる、『わがしもべヤコブよ、わたしが選んだエシュルンよ、恐れるな。"},{"ref":"Isa.44.3","start":23044003,"end":23044003,"break":"line","breaks":[[16,"line"],[30,"line"],[45,"line"]],"ruby":[[9,1,"ち"],[11,1,"みず"],[13,1,"そそ"],[16,1,"ひ"],[21,1,"ち"],[23,1,"なが"],[32,1,"れい"],[38,1,"こ"],[47,1,"めぐ"],[54,2,"しそん"],[57,1,"あた"]],"text":"わたしは、かわいた地に水を注ぎ、干からびた地に流れをそそぎ、わが霊をあなたの子らにそそぎ、わが恵みをあなたの子孫に与えるからである。"},{"ref":"Isa.44.4","start":23044004,"end":23044004,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"かれ"],[8,1,"みず"],[10,1,"なか"],[12,1,"くさ"],[18,1,"なが"],[25,1,"やなぎ"],[31,1,"は"],[33,1,"そだ"]],"text":"こうして、彼らは水の中の草のように、流れのほとりの柳のように、生え育つ。"},{"ref":"Isa.44.5","start":23044005,"end":23044005,"break":"line","breaks":[[21,"line"],[40,"line"],[63,"line"]],"ruby":[[2,1,"ひと"],[9,1,"しゅ"],[18,1,"い"],[23,1,"ひと"],[29,1,"な"],[34,2,"じぶん"],[37,1,"よ"],[44,1,"ひと"],[47,1,"しゅ"],[56,1,"て"],[69,1,"な"],[74,2,"じぶん"],[77,1,"よ"]],"text":"ある人は「わたしは主のものである」と言い、ある人はヤコブの名をもって自分を呼び、またある人は「主のものである」と手にしるして、イスラエルの名をもって自分を呼ぶ』」。"},{"ref":"Isa.44.6","start":23044006,"end":23044006,"break":"paragraph","breaks":[[22,"line"],[34,"line"],[55,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"おう"],[20,1,"もの"],[22,2,"ばんぐん"],[25,1,"しゅ"],[29,1,"い"],[39,1,"はじ"],[49,1,"おわ"],[62,1,"かみ"]],"text":"主、イスラエルの王、イスラエルをあがなう者、万軍の主はこう言われる、「わたしは初めであり、わたしは終りである。わたしのほかに神はない。"},{"ref":"Isa.44.7","start":23044007,"end":23044007,"break":"line","breaks":[[16,"line"],[34,"line"],[45,"line"],[66,"line"]],"ruby":[[7,1,"ひと"],[10,1,"もの"],[18,1,"もの"],[23,1,"しめ"],[31,1,"つ"],[36,1,"まえ"],[38,1,"い"],[49,1,"むかし"],[58,1,"こと"],[60,1,"き"],[68,1,"もの"],[73,1,"な"],[77,1,"こと"],[84,1,"つ"]],"text":"だれかわたしに等しい者があるか。その者はそれを示し、またそれを告げ、わが前に言いつらねよ。だれが、昔から、きたるべき事を聞かせたか。その者はやがて成るべき事をわれわれに告げよ。"},{"ref":"Isa.44.8","start":23044008,"end":23044008,"break":"line","breaks":[[22,"line"],[34,"line"],[49,"line"],[59,"line"],[73,"line"],[86,"line"],[98,"line"]],"ruby":[[0,1,"おそ"],[28,1,"こと"],[30,1,"むかし"],[40,1,"き"],[51,1,"つ"],[67,2,"しょうにん"],[80,1,"かみ"],[93,1,"いわ"],[109,1,"し"]],"text":"恐れてはならない、またおののいてはならない。わたしはこの事を昔から、あなたがたに聞かせなかったか、また告げなかったか。あなたがたはわが証人である。わたしのほかに神があるか。わたしのほかに岩はない。わたしはそのあることを知らない」。"},{"ref":"Isa.44.9","start":23044009,"end":23044009,"break":"paragraph","ruby":[[0,2,"ぐうぞう"],[3,1,"つく"],[5,1,"もの"],[7,1,"みな"],[13,1,"かれ"],[16,1,"よろこ"],[29,1,"やく"],[32,1,"た"],[39,2,"しんじゃ"],[42,1,"み"],[52,1,"し"],[63,1,"かれ"],[66,1,"はじ"],[68,1,"う"]],"text":"偶像を造る者は皆むなしく、彼らの喜ぶところのものは、なんの役にも立たない。その信者は見ることもなく、また知ることもない。ゆえに彼らは恥を受ける。"},{"ref":"Isa.44.10","start":23044010,"end":23044010,"break":"none","ruby":[[3,1,"かみ"],[5,1,"つく"],[13,1,"やく"],[16,1,"た"],[20,2,"ぐうぞう"],[23,1,"い"]],"text":"だれが神を造り、またなんの役にも立たない偶像を鋳たか。"},{"ref":"Isa.44.11","start":23044011,"end":23044011,"break":"none","ruby":[[0,1,"み"],[5,2,"なかま"],[8,1,"みな"],[9,1,"はじ"],[11,1,"う"],[17,3,"さいくにん"],[22,2,"にんげん"],[30,1,"かれ"],[33,1,"みな"],[34,1,"あつ"],[38,1,"た"],[43,1,"おそ"],[46,1,"とも"],[48,1,"は"]],"text":"見よ、その仲間は皆恥を受ける。その細工人らは人間にすぎない。彼らが皆集まって立つとき、恐れて共に恥じる。"},{"ref":"Isa.44.12","start":23044012,"end":23044012,"break":"paragraph","ruby":[[0,1,"てつ"],[2,3,"さいくにん"],[9,1,"つく"],[13,1,"すみ"],[15,1,"ひ"],[20,2,"さいく"],[24,1,"つち"],[32,1,"つく"],[35,1,"つよ"],[37,1,"うで"],[45,1,"きた"],[49,1,"かれ"],[51,1,"う"],[55,1,"ちから"],[57,1,"おとろ"],[60,1,"みず"],[62,1,"の"],[68,1,"つか"]],"text":"鉄の細工人はこれを造るのに炭の火をもって細工し、鎚をもってこれを造り、強い腕をもってこれを鍛える。彼が飢えれば力は衰え、水を飲まなければ疲れはてる。"},{"ref":"Isa.44.13","start":23044013,"end":23044013,"break":"none","ruby":[[0,1,"き"],[2,3,"さいくにん"],[6,1,"せん"],[8,1,"ひ"],[11,2,"えんぴつ"],[22,1,"けず"],[37,1,"ひと"],[39,1,"うつく"],[42,1,"すがた"],[49,1,"ひと"],[51,1,"かたち"],[53,1,"つく"],[56,1,"いえ"],[58,1,"なか"],[60,2,"あんち"]],"text":"木の細工人は線を引き、鉛筆でえがき、かんなで削り、コンパスでえがき、それを人の美しい姿にしたがって人の形に造り、家の中に安置する。"},{"ref":"Isa.44.14","start":23044014,"end":23044014,"break":"none","ruby":[[0,1,"かれ"],[2,2,"こうはく"],[5,1,"き"],[7,1,"たお"],[17,1,"き"],[27,1,"き"],[29,1,"えら"],[36,1,"はやし"],[38,1,"き"],[40,1,"なか"],[42,1,"つよ"],[44,1,"そだ"],[52,2,"こうはく"],[55,1,"う"],[58,1,"あめ"],[63,1,"そだ"]],"text":"彼は香柏を切り倒し、あるいはかしの木、あるいはかしわの木を選んで、それを林の木の中で強く育てる。あるいは香柏を植え、雨にそれを育てさせる。"},{"ref":"Isa.44.15","start":23044015,"end":23044015,"break":"none","ruby":[[4,1,"ひと"],[8,2,"いちぶ"],[27,1,"み"],[29,1,"あたた"],[37,1,"も"],[44,1,"や"],[49,1,"た"],[51,2,"いちぶ"],[54,1,"かみ"],[56,1,"つく"],[59,1,"おが"],[62,1,"きざ"],[65,1,"ぞう"],[67,1,"つく"],[72,1,"まえ"],[76,1,"ふ"]],"text":"こうして人はその一部をとって、たきぎとし、これをもって身を暖め、またこれを燃やしてパンを焼き、また他の一部を神に造って拝み、刻んだ像に造ってその前にひれ伏す。"},{"ref":"Isa.44.16","start":23044016,"end":23044016,"break":"none","ruby":[[2,1,"なか"],[5,1,"ひ"],[7,1,"も"],[13,1,"なか"],[16,1,"にく"],[18,1,"に"],[20,1,"た"],[27,1,"にく"],[33,1,"た"],[35,1,"あ"],[40,1,"み"],[42,1,"あたた"],[45,1,"い"],[52,1,"あたた"],[57,1,"あつ"]],"text":"その半ばは火に燃やし、その半ばで肉を煮て食べ、あるいは肉をあぶって食べ飽き、また身を暖めて言う、「ああ、暖まった、熱くなった」と。"},{"ref":"Isa.44.17","start":23044017,"end":23044017,"break":"none","ruby":[[5,1,"あま"],[11,1,"かみ"],[13,1,"つく"],[16,2,"ぐうぞう"],[23,1,"まえ"],[27,1,"ふ"],[30,1,"おが"],[36,1,"いの"],[47,1,"かみ"],[54,1,"すく"],[58,1,"い"]],"text":"そしてその余りをもって神を造って偶像とし、その前にひれ伏して拝み、これに祈って、「あなたはわが神だ、わたしを救え」と言う。"},{"ref":"Isa.44.18","start":23044018,"end":23044018,"break":"paragraph","ruby":[[4,1,"ひと"],[6,1,"し"],[16,1,"さと"],[26,1,"め"],[33,1,"み"],[44,1,"こころ"],[46,1,"にぶ"],[51,1,"さと"]],"text":"これらの人は知ることがなく、また悟ることがない。その目はふさがれて見ることができず、その心は鈍くなって悟ることができない。"},{"ref":"Isa.44.19","start":23044019,"end":23044019,"break":"none","ruby":[[2,1,"こころ"],[7,1,"おも"],[17,2,"ちしき"],[23,1,"さと"],[39,1,"なか"],[42,1,"ひ"],[44,1,"も"],[52,2,"すみび"],[55,1,"うえ"],[60,1,"や"],[63,1,"にく"],[69,1,"た"],[74,1,"のこ"],[77,1,"き"],[82,1,"にく"],[89,1,"つく"],[94,1,"き"],[101,1,"まえ"],[105,1,"ふ"],[111,1,"い"],[113,1,"もの"]],"text":"その心のうちに思うことをせず、また知識がなく、悟りがないために、「わたしはその半ばを火に燃やし、またその炭火の上でパンを焼き、肉をあぶって食べ、その残りの木をもって憎むべきものを造るのか。木のはしくれの前にひれ伏すのか」と言う者もない。"},{"ref":"Isa.44.20","start":23044020,"end":23044020,"break":"none","ruby":[[0,1,"かれ"],[2,1,"はい"],[4,1,"く"],[7,1,"まよ"],[10,1,"こころ"],[12,1,"まど"],[22,1,"すく"],[36,1,"みぎ"],[38,1,"て"],[40,1,"いつわ"],[52,1,"い"]],"text":"彼は灰を食い、迷った心に惑わされて、おのれを救うことができず、また「わが右の手に偽りがあるではないか」と言わない。"},{"ref":"Isa.44.21","start":23044021,"end":23044021,"break":"paragraph","breaks":[[24,"line"],[37,"line"],[49,"line"],[60,"line"]],"ruby":[[16,1,"こと"],[18,1,"こころ"],[45,1,"つく"],[75,1,"わす"]],"text":"ヤコブよ、イスラエルよ、これらの事を心にとめよ。あなたはわがしもべだから。わたしはあなたを造った、あなたはわがしもべだ。イスラエルよ、わたしはあなたを忘れない。"},{"ref":"Isa.44.22","start":23044022,"end":23044022,"break":"line","breaks":[[21,"line"],[36,"line"],[45,"line"]],"ruby":[[11,1,"くも"],[16,1,"ふ"],[18,1,"はら"],[25,1,"つみ"],[27,1,"きり"],[32,1,"け"],[40,1,"た"],[42,1,"かえ"]],"text":"わたしはあなたのとがを雲のように吹き払い、あなたの罪を霧のように消した。わたしに立ち返れ、わたしはあなたをあがなったから。"},{"ref":"Isa.44.23","start":23044023,"end":23044023,"break":"paragraph","breaks":[[19,"line"],[31,"line"],[55,"line"],[63,"line"],[74,"line"]],"ruby":[[0,1,"てん"],[3,1,"うた"],[6,1,"しゅ"],[10,1,"こと"],[19,1,"ち"],[21,1,"ふか"],[23,1,"ところ"],[26,1,"よ"],[36,1,"やま"],[39,1,"はやし"],[45,1,"なか"],[52,1,"き"],[55,1,"こえ"],[57,1,"はな"],[60,1,"うた"],[63,1,"しゅ"],[83,2,"えいこう"]],"text":"天よ、歌え、主がこの事をなされたから。地の深き所よ、呼ばわれ。もろもろの山よ、林およびその中のもろもろの木よ、声を放って歌え。主はヤコブをあがない、イスラエルのうちに栄光をあらわされたから。"},{"ref":"Isa.44.24","start":23044024,"end":23044024,"break":"paragraph","breaks":[[9,"line"],[29,"line"],[52,"line"],[71,"line"]],"ruby":[[13,2,"たいない"],[16,1,"つく"],[20,1,"しゅ"],[24,1,"い"],[34,1,"しゅ"],[47,1,"もの"],[49,1,"つく"],[60,1,"てん"],[65,1,"ち"],[80,1,"とも"]],"text":"あなたをあがない、あなたを胎内に造られた主はこう言われる、「わたしは主である。わたしはよろずの物を造り、ただわたしだけが天をのべ、地をひらき、――だれがわたしと共にいたか――"},{"ref":"Isa.44.25","start":23044025,"end":23044025,"break":"line","breaks":[[14,"line"],[22,"line"]],"ruby":[[0,1,"いつわ"],[2,1,"もの"],[14,1,"うらな"],[16,1,"もの"],[18,1,"くる"],[22,1,"かしこ"],[24,1,"もの"],[30,1,"しりぞ"],[36,2,"ちしき"],[39,1,"おろ"]],"text":"偽る物のしるしをむなしくし、占う者を狂わせ、賢い者をうしろに退けて、その知識を愚かにする。"},{"ref":"Isa.44.26","start":23044026,"end":23044026,"break":"line","breaks":[[19,"line"],[32,"line"],[43,"line"],[60,"line"],[75,"line"],[86,"line"]],"ruby":[[11,2,"ことば"],[14,1,"と"],[21,1,"つかい"],[23,1,"はか"],[28,1,"な"],[47,1,"たみ"],[49,1,"す"],[51,1,"ところ"],[57,1,"い"],[68,1,"まち"],[80,1,"た"],[92,1,"あ"],[94,1,"あと"],[96,1,"おこ"],[101,1,"い"]],"text":"わたしは、わがしもべの言葉を遂げさせ、わが使の計りごとを成らせ、エルサレムについては、『これは民の住む所となる』と言い、ユダのもろもろの町については、『ふたたび建てられる、わたしはその荒れ跡を興そう』と言い、"},{"ref":"Isa.44.27","start":23044027,"end":23044027,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"ふち"],[27,1,"かわ"],[29,1,"ほ"],[33,1,"い"]],"text":"また淵については、『かわけ、わたしはあなたのもろもろの川を干す』と言い、"},{"ref":"Isa.44.28","start":23044028,"end":23044028,"break":"line","breaks":[[19,"line"],[39,"line"],[50,"line"],[65,"line"],[73,"line"]],"ruby":[[12,1,"かれ"],[16,2,"ぼくしゃ"],[21,2,"もくてき"],[31,1,"と"],[36,1,"い"],[55,1,"た"],[62,1,"い"],[65,2,"しんでん"],[78,1,"もとい"],[87,1,"い"]],"text":"またクロスについては、『彼はわが牧者、わが目的をことごとくなし遂げる』と言い、エルサレムについては、『ふたたび建てられる』と言い、神殿については、『あなたの基がすえられる』と言う」。"}]