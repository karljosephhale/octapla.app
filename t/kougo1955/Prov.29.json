[{"ref":"Prov.29.1","start":20029001,"end":20029001,"break":"paragraph","breaks":[[11,"line"],[21,"line"]],"ruby":[[18,1,"もの"],[25,1,"う"],[27,1,"やぶ"],[31,1,"たす"]],"text":"しばしばしかられても、なおかたくなな者は、たちまち打ち敗られて助かることはない。"},{"ref":"Prov.29.2","start":20029002,"end":20029002,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,2,"けんりょく"],[8,1,"え"],[11,1,"たみ"],[13,1,"よろこ"],[16,1,"あ"],[19,1,"もの"],[21,1,"おさ"],[27,1,"たみ"],[32,1,"くる"]],"text":"正しい者が権力を得れば民は喜び、悪しき者が治めるとき、民はうめき苦しむ。"},{"ref":"Prov.29.3","start":20029003,"end":20029003,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"あい"],[6,1,"ひと"],[10,1,"ちち"],[12,1,"よろこ"],[16,2,"ゆうじょ"],[19,1,"まじ"],[22,1,"もの"],[26,2,"しさん"],[29,2,"ろうひ"]],"text":"知恵を愛する人はその父を喜ばせ、遊女に交わる者はその資産を浪費する。"},{"ref":"Prov.29.4","start":20029004,"end":20029004,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おう"],[2,2,"こうぎ"],[8,1,"くに"],[10,1,"かた"],[19,2,"じゅうぜい"],[22,1,"と"],[24,1,"た"],[27,1,"もの"],[32,1,"ほろ"]],"text":"王は公儀をもって国を堅くする、しかし、重税を取り立てる者はこれを滅ぼす。"},{"ref":"Prov.29.5","start":20029005,"end":20029005,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"とな"],[4,1,"びと"],[10,1,"もの"],[13,1,"かれ"],[15,1,"あし"],[17,1,"まえ"],[19,1,"あみ"],[21,1,"は"]],"text":"その隣り人にへつらう者は、彼の足の前に網を張る。"},{"ref":"Prov.29.6","start":20029006,"end":20029006,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"あくにん"],[3,2,"じぶん"],[6,1,"つみ"],[11,1,"おちい"],[17,1,"ただ"],[20,1,"ひと"],[22,1,"よろこ"],[24,1,"たの"]],"text":"悪人は自分の罪のわなに陥る、しかし正しい人は喜び楽しむ。"},{"ref":"Prov.29.7","start":20029007,"end":20029007,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"まず"],[8,1,"もの"],[10,1,"うった"],[19,1,"あ"],[22,1,"ひと"],[27,1,"し"]],"text":"正しい人は貧しい者の訴えをかえりみる、悪しき人はそれを知ろうとはしない。"},{"ref":"Prov.29.8","start":20029008,"end":20029008,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"ひと"],[6,1,"まち"],[8,1,"みだ"],[11,2,"ちえ"],[15,1,"もの"],[17,1,"いか"],[20,1,"しず"]],"text":"あざける人は町を乱し、知恵ある者は怒りを静める。"},{"ref":"Prov.29.9","start":20029009,"end":20029009,"break":"line","breaks":[[15,"line"],[25,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"ひと"],[6,1,"おろ"],[9,1,"ひと"],[11,1,"あらそ"],[15,1,"おろ"],[18,1,"もの"],[22,1,"いか"],[29,1,"わら"],[33,1,"やす"]],"text":"知恵ある人が愚かな人と争うと、愚かな者はただ怒り、あるいは笑って、休むことがない。"},{"ref":"Prov.29.10","start":20029010,"end":20029010,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ち"],[2,1,"う"],[7,1,"ひと"],[9,1,"つみ"],[13,1,"もの"],[15,1,"にく"],[18,1,"あ"],[21,1,"もの"],[23,1,"かれ"],[25,1,"いのち"],[27,1,"もと"]],"text":"血に飢えている人は罪のない者を憎む、悪しき者は彼の命を求める。"},{"ref":"Prov.29.11","start":20029011,"end":20029011,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"いか"],[13,1,"あら"],[17,2,"ちえ"],[21,1,"もの"],[23,1,"しず"]],"text":"愚かな者は怒りをことごとく表わし、知恵ある者は静かにこれをおさえる。"},{"ref":"Prov.29.12","start":20029012,"end":20029012,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"おさ"],[5,1,"もの"],[7,1,"いつわ"],[10,2,"ことば"],[13,1,"き"],[21,2,"やくにん"],[27,1,"わる"]],"text":"もし治める者が偽りの言葉に聞くならば、その役人らはみな悪くなる。"},{"ref":"Prov.29.13","start":20029013,"end":20029013,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[11,1,"もの"],[14,1,"とも"],[16,1,"よ"],[21,1,"しゅ"],[23,1,"かれ"],[25,2,"りょうしゃ"],[28,1,"め"],[30,1,"ひかり"],[32,1,"あた"]],"text":"貧しい者と、しえたげる者とは共に世におる、主は彼ら両者の目に光を与えられる。"},{"ref":"Prov.29.14","start":20029014,"end":20029014,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"おう"],[4,1,"まず"],[7,1,"もの"],[9,2,"こうへい"],[21,1,"くらい"],[28,1,"かた"],[30,1,"た"]],"text":"もし王が貧しい者を公平にさばくならば、その位はいつまでも堅く立つ。"},{"ref":"Prov.29.15","start":20029015,"end":20029015,"break":"line","breaks":[[14,"line"]],"ruby":[[3,1,"いまし"],[7,2,"ちえ"],[10,1,"あた"],[22,1,"こ"],[26,1,"はは"],[28,1,"はじ"]],"text":"むちと戒めとは知恵を与える、わがままにさせた子はその母に恥をもたらす。"},{"ref":"Prov.29.16","start":20029016,"end":20029016,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,2,"けんりょく"],[8,1,"え"],[11,1,"つみ"],[13,1,"ま"],[16,1,"ただ"],[19,1,"もの"],[21,1,"かれ"],[24,1,"たお"],[29,1,"み"]],"text":"悪しき者が権力を得ると罪も増す、正しい者は彼らの倒れるのを見る。"},{"ref":"Prov.29.17","start":20029017,"end":20029017,"break":"line","breaks":[[11,"line"],[28,"line"]],"ruby":[[4,1,"こ"],[6,1,"こら"],[16,1,"かれ"],[22,1,"やす"],[34,1,"こころ"],[36,1,"よろこ"],[39,1,"あた"]],"text":"あなたの子を懲しめよ、そうすれば彼はあなたを安らかにし、またあなたの心に喜びを与える。"},{"ref":"Prov.29.18","start":20029018,"end":20029018,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"よげん"],[7,1,"たみ"],[22,2,"りっぽう"],[25,1,"まも"],[27,1,"もの"]],"text":"預言がなければ民はわがままにふるまう、しかし律法を守る者はさいわいである。"},{"ref":"Prov.29.19","start":20029019,"end":20029019,"break":"line","breaks":[[21,"line"]],"ruby":[[4,2,"ことば"],[9,2,"くんれん"],[21,1,"かれ"],[23,1,"き"],[26,1,"し"],[31,1,"こころ"]],"text":"しもべは言葉だけで訓練することはできない、彼は聞いて知っても、心にとめないからである。"},{"ref":"Prov.29.20","start":20029020,"end":20029020,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"ことば"],[3,2,"けいそつ"],[6,1,"ひと"],[8,1,"み"],[12,1,"かれ"],[20,1,"おろ"],[23,1,"もの"],[28,1,"のぞ"]],"text":"言葉の軽率な人を見るか、彼よりもかえって愚かな者のほうに望みがある。"},{"ref":"Prov.29.21","start":20029021,"end":20029021,"break":"line","breaks":[[22,"line"]],"ruby":[[6,1,"おさな"],[8,1,"とき"],[16,1,"そだ"],[19,1,"ひと"],[29,2,"じぶん"]],"text":"しもべをその幼い時からわがままに育てる人は、ついにはそれを自分のあとつぎにする。"},{"ref":"Prov.29.22","start":20029022,"end":20029022,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"いか"],[2,1,"ひと"],[4,1,"あらそ"],[7,1,"おこ"],[10,1,"いきどお"],[12,1,"ひと"],[14,1,"おお"],[17,1,"つみ"],[19,1,"おか"]],"text":"怒る人は争いを起し、憤る人は多くの罪を犯す。"},{"ref":"Prov.29.23","start":20029023,"end":20029023,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ひと"],[2,1,"たか"],[8,1,"ひと"],[10,1,"ひく"],[14,1,"こころ"],[21,1,"もの"],[23,1,"ほまれ"],[25,1,"え"]],"text":"人の高ぶりはその人を低くし、心にへりくだる者は誉を得る。"},{"ref":"Prov.29.24","start":20029024,"end":20029024,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ぬす"],[8,1,"もの"],[10,2,"じぶん"],[13,1,"たましい"],[15,1,"にく"],[18,1,"かれ"],[24,1,"き"],[28,2,"なにごと"],[32,2,"こうがい"]],"text":"盗びとにくみする者は自分の魂を憎む、彼はのろいを聞いても何事をも口外しない。"},{"ref":"Prov.29.25","start":20029025,"end":20029025,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ひと"],[2,1,"おそ"],[10,1,"おちい"],[13,1,"しゅ"],[15,2,"しんらい"],[19,1,"もの"],[21,1,"やす"]],"text":"人を恐れると、わなに陥る、主に信頼する者は安らかである。"},{"ref":"Prov.29.26","start":20029026,"end":20029026,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"おさ"],[3,1,"もの"],[5,2,"かんしん"],[8,1,"え"],[14,1,"ひと"],[16,1,"おお"],[22,1,"ひと"],[24,1,"こと"],[26,1,"さだ"],[31,1,"しゅ"]],"text":"治める者の歓心を得ようとする人は多い、しかし人の事を定めるのは主による。"},{"ref":"Prov.29.27","start":20029027,"end":20029027,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,2,"ふせい"],[8,1,"おこな"],[10,1,"ひと"],[12,1,"にく"],[15,1,"あ"],[18,1,"もの"],[20,1,"ただ"],[23,1,"あゆ"],[25,1,"ひと"],[27,1,"にく"]],"text":"正しい人は不正を行う人を憎み、悪しき者は正しく歩む人を憎む。"}]