[{"ref":"Deut.7.1","start":5007001,"end":5007001,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[13,1,"い"],[16,1,"と"],[18,1,"ち"],[24,1,"みちび"],[26,1,"い"],[29,1,"おお"],[32,2,"くにぐに"],[35,1,"たみ"],[91,2,"かずおお"],[97,1,"ちから"],[104,1,"たみ"],[111,1,"まえ"],[114,1,"お"],[121,1,"とき"]],"text":"あなたの神、主が、あなたの行って取る地にあなたを導き入れ、多くの国々の民、ヘテびと、ギルガシびと、アモリびと、カナンびと、ペリジびと、ヒビびと、およびエブスびと、すなわちあなたよりも数多く、また力のある七つの民を、あなたの前から追いはらわれる時、"},{"ref":"Deut.7.2","start":5007002,"end":5007002,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"かれ"],[19,1,"わた"],[26,1,"う"],[32,1,"とき"],[39,1,"かれ"],[42,1,"まった"],[44,1,"ほろ"],[56,1,"かれ"],[62,2,"けいやく"],[74,1,"かれ"],[77,1,"なに"],[85,1,"しめ"]],"text":"すなわちあなたの神、主が彼らをあなたに渡して、これを撃たせられる時は、あなたは彼らを全く滅ぼさなければならない。彼らとなんの契約をもしてはならない。彼らに何のあわれみをも示してはならない。"},{"ref":"Deut.7.3","start":5007003,"end":5007003,"break":"none","ruby":[[2,1,"かれ"],[5,2,"こんいん"],[20,1,"むすめ"],[22,1,"かれ"],[28,1,"あた"],[40,1,"むすめ"]],"text":"また彼らと婚姻をしてはならない。あなたの娘を彼のむすこに与えてはならない。かれの娘をあなたのむすこにめとってはならない。"},{"ref":"Deut.7.4","start":5007004,"end":5007004,"break":"none","ruby":[[3,1,"かれ"],[14,1,"まど"],[22,1,"したが"],[30,2,"かみがみ"],[33,1,"つか"],[42,1,"しゅ"],[54,1,"いか"],[57,1,"はっ"],[71,1,"ほろ"]],"text":"それは彼らがあなたのむすこを惑わしてわたしに従わせず、ほかの神々に仕えさせ、そのため主はあなたがたにむかって怒りを発し、すみやかにあなたがたを滅ぼされることとなるからである。"},{"ref":"Deut.7.5","start":5007005,"end":5007005,"break":"none","ruby":[[15,1,"かれ"],[18,1,"おこな"],[33,1,"かれ"],[36,2,"さいだん"],[45,1,"いし"],[47,1,"はしら"],[49,1,"う"],[51,1,"くだ"],[59,1,"ぞう"],[61,1,"き"],[63,1,"たお"],[68,1,"きざ"],[71,1,"ぞう"],[73,1,"ひ"],[75,1,"や"]],"text":"むしろ、あなたがたはこのように彼らに行わなければならない。すなわち彼らの祭壇をこぼち、その石の柱を撃ち砕き、そのアシラ像を切り倒し、その刻んだ像を火で焼かなければならない。"},{"ref":"Deut.7.6","start":5007006,"end":5007006,"break":"paragraph","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"せい"],[15,1,"たみ"],[24,1,"かみ"],[26,1,"しゅ"],[28,1,"ち"],[38,1,"たみ"],[48,1,"えら"],[52,2,"じぶん"],[55,1,"たから"],[57,1,"たみ"]],"text":"あなたはあなたの神、主の聖なる民である。あなたの神、主は地のおもてのすべての民のうちからあなたを選んで、自分の宝の民とされた。"},{"ref":"Deut.7.7","start":5007007,"end":5007007,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"あい"],[17,1,"えら"],[32,2,"こくみん"],[37,1,"かず"],[39,1,"おお"],[60,1,"たみ"],[69,1,"かず"],[71,1,"すく"]],"text":"主があなたがたを愛し、あなたがたを選ばれたのは、あなたがたがどの国民よりも数が多かったからではない。あなたがたはよろずの民のうち、もっとも数の少ないものであった。"},{"ref":"Deut.7.8","start":5007008,"end":5007008,"break":"none","ruby":[[2,1,"しゅ"],[10,1,"あい"],[21,2,"せんぞ"],[24,1,"ちか"],[28,1,"ちか"],[31,1,"まも"],[38,1,"しゅ"],[40,1,"つよ"],[42,1,"て"],[53,1,"みちび"],[55,1,"だ"],[58,2,"どれい"],[61,1,"いえ"],[70,1,"おう"],[74,1,"て"],[82,1,"だ"]],"text":"ただ主があなたがたを愛し、またあなたがたの先祖に誓われた誓いを守ろうとして、主は強い手をもってあなたがたを導き出し、奴隷の家から、エジプトの王パロの手から、あがない出されたのである。"},{"ref":"Deut.7.9","start":5007009,"end":5007009,"break":"none","ruby":[[8,1,"し"],[23,1,"かみ"],[25,1,"しゅ"],[27,1,"かみ"],[34,2,"しんじつ"],[37,1,"かみ"],[45,1,"かれ"],[47,1,"あい"],[52,2,"めいれい"],[55,1,"まも"],[57,1,"もの"],[61,2,"けいやく"],[64,1,"まも"],[67,1,"めぐ"],[70,1,"ほどこ"],[73,1,"せん"],[74,1,"だい"],[76,1,"およ"]],"text":"それゆえあなたは知らなければならない。あなたの神、主は神にましまし、真実の神にましまして、彼を愛し、その命令を守る者には、契約を守り、恵みを施して千代に及び、"},{"ref":"Deut.7.10","start":5007010,"end":5007010,"break":"none","ruby":[[2,1,"かれ"],[4,1,"にく"],[6,1,"もの"],[15,1,"むく"],[18,1,"ほろ"],[27,1,"しゅ"],[29,2,"じぶん"],[32,1,"にく"],[34,1,"もの"],[37,2,"ゆうよ"],[51,1,"むく"]],"text":"また彼を憎む者には、めいめいに報いて滅ぼされることを。主は自分を憎む者には猶予することなく、めいめいに報いられる。"},{"ref":"Deut.7.11","start":5007011,"end":5007011,"break":"none","ruby":[[16,1,"めい"],[19,2,"めいれい"],[23,1,"さだ"],[32,1,"まも"],[39,1,"おこな"]],"text":"それゆえ、きょうわたしがあなたに命じる命令と、定めと、おきてとを守って、これを行わなければならない。"},{"ref":"Deut.7.12","start":5007012,"end":5007012,"break":"paragraph","ruby":[[14,1,"き"],[17,1,"まも"],[19,1,"おこな"],[29,1,"かみ"],[31,1,"しゅ"],[37,2,"せんぞ"],[42,1,"ちか"],[46,2,"けいやく"],[49,1,"まも"],[58,1,"ほどこ"]],"text":"あなたがたがこれらのおきてを聞いて守り行うならば、あなたの神、主はあなたの先祖たちに誓われた契約を守り、いつくしみを施されるであろう。"},{"ref":"Deut.7.13","start":5007013,"end":5007013,"break":"none","ruby":[[4,1,"あい"],[11,2,"しゅくふく"],[19,1,"かず"],[21,1,"ま"],[28,1,"あた"],[32,2,"せんぞ"],[37,1,"ちか"],[41,1,"ち"],[48,2,"しじょ"],[51,2,"しゅくふく"],[59,1,"ち"],[61,2,"さんぶつ"],[64,2,"こくもつ"],[67,1,"さけ"],[69,1,"あぶら"],[73,1,"うし"],[75,1,"こ"],[77,1,"ひつじ"],[79,1,"こ"],[81,1,"ま"]],"text":"あなたを愛し、あなたを祝福し、あなたの数を増し、あなたに与えると先祖たちに誓われた地で、あなたの子女を祝福し、あなたの地の産物、穀物、酒、油、また牛の子、羊の子を増されるであろう。"},{"ref":"Deut.7.14","start":5007014,"end":5007014,"break":"none","ruby":[[4,2,"ばんみん"],[11,2,"しゅくふく"],[28,1,"おとこ"],[30,1,"おんな"],[32,1,"こ"],[48,2,"かちく"],[52,1,"こ"]],"text":"あなたは万民にまさって祝福されるであろう。あなたのうち、男も女も子のないものはなく、またあなたの家畜にも子のないものはないであろう。"},{"ref":"Deut.7.15","start":5007015,"end":5007015,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"やまい"],[15,1,"と"],[17,1,"さ"],[24,1,"し"],[37,2,"あくえき"],[52,1,"にく"],[58,1,"もの"],[63,1,"のぞ"]],"text":"主はまたすべての病をあなたから取り去り、あなたの知っている、あのエジプトの悪疫にかからせず、ただあなたを憎むすべての者にそれを臨ませられるであろう。"},{"ref":"Deut.7.16","start":5007016,"end":5007016,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[12,1,"わた"],[16,2,"こくみん"],[19,1,"ほろ"],[26,1,"かれ"],[29,1,"み"],[44,1,"かれ"],[47,2,"かみがみ"],[50,1,"つか"]],"text":"あなたの神、主があなたに渡される国民を滅ぼしつくし、彼らを見てあわれんではならない。また彼らの神々に仕えてはならない。それがあなたのわなとなるからである。"},{"ref":"Deut.7.17","start":5007017,"end":5007017,"break":"paragraph","ruby":[[4,1,"こころ"],[14,2,"こくみん"],[23,1,"おお"],[35,1,"お"],[37,1,"はら"],[49,1,"い"]],"text":"あなたは心のうちで『これらの国民はわたしよりも多いから、どうしてこれを追い払うことができようか』と言うのか。"},{"ref":"Deut.7.18","start":5007018,"end":5007018,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おそ"],[16,1,"かみ"],[18,1,"しゅ"],[45,1,"おぼ"]],"text":"彼らを恐れてはならない。あなたの神、主がパロと、すべてのエジプトびととにされたことを、よく覚えなさい。"},{"ref":"Deut.7.19","start":5007019,"end":5007019,"break":"none","ruby":[[9,1,"め"],[11,1,"み"],[13,1,"おお"],[17,1,"こころ"],[26,3,"ふしぎ"],[31,1,"つよ"],[33,1,"て"],[36,1,"の"],[40,1,"うで"],[43,1,"おぼ"],[53,1,"かみ"],[55,1,"しゅ"],[69,1,"みちび"],[71,1,"だ"],[92,1,"かみ"],[94,1,"しゅ"],[100,1,"おそ"],[109,1,"たみ"]],"text":"すなわち、あなたが目で見た大いなる試みと、しるしと、不思議と、強い手と、伸ばした腕とを覚えなさい。あなたの神、主はこれらをもって、あなたを導き出されたのである。またそのように、あなたの神、主はあなたが恐れているすべての民にされるであろう。"},{"ref":"Deut.7.20","start":5007020,"end":5007020,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[16,1,"かれ"],[22,1,"おく"],[28,1,"のこ"],[33,1,"もの"],[35,1,"に"],[37,1,"かく"],[42,1,"もの"],[44,1,"ほろ"]],"text":"あなたの神、主はまた、くまばちを彼らのうちに送って、なお残っている者と逃げ隠れている者を滅ぼしつくされるであろう。"},{"ref":"Deut.7.21","start":5007021,"end":5007021,"break":"none","ruby":[[4,1,"かれ"],[7,1,"おそ"],[20,1,"かみ"],[22,1,"しゅ"],[26,1,"おお"],[30,1,"おそ"],[34,1,"かみ"]],"text":"あなたは彼らを恐れてはならない。あなたの神、主である大いなる恐るべき神があなたのうちにおられるからである。"},{"ref":"Deut.7.22","start":5007022,"end":5007022,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[12,2,"こくみん"],[15,2,"じょじょ"],[22,1,"まえ"],[25,1,"お"],[27,1,"はら"],[45,1,"かれ"],[48,1,"ほろ"],[69,1,"の"],[71,1,"けもの"],[73,1,"ま"],[80,1,"がい"]],"text":"あなたの神、主はこれらの国民を徐々にあなたの前から追い払われるであろう。あなたはすみやかに彼らを滅ぼしつくしてはならない。そうでなければ、野の獣が増してあなたを害するであろう。"},{"ref":"Deut.7.23","start":5007023,"end":5007023,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"かれ"],[19,1,"わた"],[22,1,"おお"],[26,2,"こんらん"],[39,1,"ほろ"]],"text":"しかし、あなたの神、主は彼らをあなたに渡し、大いなる混乱におとしいれて、ついに滅ぼされるであろう。"},{"ref":"Deut.7.24","start":5007024,"end":5007024,"break":"none","ruby":[[2,1,"かれ"],[5,1,"おう"],[13,1,"て"],[15,1,"わた"],[28,1,"かれ"],[31,1,"な"],[33,1,"てん"],[35,1,"した"],[38,1,"け"],[40,1,"さ"],[51,1,"た"],[69,1,"かれ"],[72,1,"ほろ"]],"text":"また彼らの王たちをあなたの手に渡されるであろう。あなたは彼らの名を天の下から消し去るであろう。あなたに立ちむかうものはなく、あなたはついに彼らを滅ぼすにいたるであろう。"},{"ref":"Deut.7.25","start":5007025,"end":5007025,"break":"none","ruby":[[4,1,"かれ"],[7,2,"かみがみ"],[10,2,"ちょうぞう"],[13,1,"ひ"],[15,1,"や"],[29,1,"き"],[32,1,"ぎん"],[36,1,"きん"],[52,1,"と"],[55,2,"じぶん"],[106,1,"かみ"],[108,1,"い"]],"text":"あなたは彼らの神々の彫像を火に焼かなければならない。それに着せた銀または金をむさぼってはならない。これを取って自分のものにしてはならない。そうでなければ、あなたはこれによって、わなにかかるであろう。これはあなたの神が忌みきらわれるものだからである。"},{"ref":"Deut.7.26","start":5007026,"end":5007026,"break":"none","ruby":[[4,1,"い"],[11,1,"いえ"],[13,1,"も"],[22,1,"おな"],[30,2,"じしん"],[58,1,"まった"],[60,1,"い"]],"text":"あなたは忌むべきものを家に持ちこんで、それと同じようにあなた自身も、のろわれたものとなってはならない。あなたはそれを全く忌みきらわなければならない。それはのろわれたものだからである。"}]