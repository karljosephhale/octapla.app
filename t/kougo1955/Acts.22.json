[{"ref":"Acts.22.1","start":44022001,"end":44022001,"break":"paragraph","ruby":[[1,2,"きょうだい"],[6,1,"ちち"],[13,1,"もう"],[15,1,"あ"],[22,2,"べんめい"],[25,1,"き"]],"text":"「兄弟たち、父たちよ、いま申し上げるわたしの弁明を聞いていただきたい」。"},{"ref":"Acts.22.2","start":44022002,"end":44022002,"break":"none","ruby":[[8,1,"ご"],[12,1,"かた"],[19,1,"き"],[23,2,"ひとびと"],[30,2,"せいしゅく"]],"text":"パウロが、ヘブル語でこう語りかけるのを聞いて、人々はますます静粛になった。"},{"ref":"Acts.22.3","start":44022003,"end":44022003,"break":"none","ruby":[[3,1,"かれ"],[5,2,"ことば"],[11,1,"い"],[29,1,"うま"],[35,1,"じん"],[43,1,"みやこ"],[45,1,"そだ"],[61,2,"せんぞ"],[63,2,"でんらい"],[66,2,"りっぽう"],[77,2,"くんとう"],[80,1,"う"],[83,2,"きょう"],[86,1,"みな"],[90,1,"おな"],[93,1,"かみ"],[95,1,"たい"],[98,2,"ねっしん"],[101,1,"もの"]],"text":"そこで彼は言葉をついで言った、「わたしはキリキヤのタルソで生れたユダヤ人であるが、この都で育てられ、ガマリエルのひざもとで先祖伝来の律法について、きびしい薫陶を受け、今日の皆さんと同じく神に対して熱心な者であった。"},{"ref":"Acts.22.4","start":44022004,"end":44022004,"break":"none","ruby":[[6,1,"みち"],[8,2,"はくがい"],[12,1,"おとこ"],[16,1,"おんな"],[21,1,"しば"],[26,1,"ごく"],[28,1,"とう"],[31,1,"かれ"],[34,1,"し"],[36,1,"いた"]],"text":"そして、この道を迫害し、男であれ女であれ、縛りあげて獄に投じ、彼らを死に至らせた。"},{"ref":"Acts.22.5","start":44022005,"end":44022005,"break":"none","ruby":[[6,3,"だいさいし"],[10,2,"ちょうろう"],[14,2,"いちどう"],[18,2,"しょうめい"],[39,1,"ひと"],[49,2,"どうし"],[57,2,"てがみ"],[67,1,"ち"],[71,1,"もの"],[75,1,"しば"],[94,2,"しょばつ"],[101,1,"で"],[105,1,"い"]],"text":"このことは、大祭司も長老たち一同も、証明するところである。さらにわたしは、この人たちからダマスコの同志たちへあてた手紙をもらって、その地にいる者たちを縛りあげ、エルサレムにひっぱってきて、処罰するため、出かけて行った。"},{"ref":"Acts.22.6","start":44022006,"end":44022006,"break":"paragraph","ruby":[[0,1,"たび"],[11,1,"ちか"],[16,1,"とき"],[19,2,"まひる"],[24,2,"とつぜん"],[30,1,"ひかり"],[32,1,"てん"],[42,1,"てら"]],"text":"旅をつづけてダマスコの近くにきた時に、真昼ごろ、突然、つよい光が天からわたしをめぐり照した。"},{"ref":"Acts.22.7","start":44022007,"end":44022007,"break":"none","ruby":[[4,1,"ち"],[6,1,"たお"],[29,2,"はくがい"],[38,1,"よ"],[43,1,"こえ"],[45,1,"き"]],"text":"わたしは地に倒れた。そして、『サウロ、サウロ、なぜわたしを迫害するのか』と、呼びかける声を聞いた。"},{"ref":"Acts.22.8","start":44022008,"end":44022008,"break":"none","ruby":[[3,1,"たい"],[12,1,"しゅ"],[27,1,"い"],[37,1,"こえ"],[50,2,"はくがい"],[59,1,"びと"],[68,1,"こた"]],"text":"これに対してわたしは、『主よ、あなたはどなたですか』と言った。すると、その声が、『わたしは、あなたが迫害しているナザレ人イエスである』と答えた。"},{"ref":"Acts.22.9","start":44022009,"end":44022009,"break":"none","ruby":[[4,2,"いっしょ"],[9,1,"もの"],[16,1,"ひかり"],[18,1,"み"],[26,1,"かた"],[34,1,"こえ"],[36,1,"き"]],"text":"わたしと一緒にいた者たちは、その光は見たが、わたしに語りかけたかたの声は聞かなかった。"},{"ref":"Acts.22.10","start":44022010,"end":44022010,"break":"none","ruby":[[5,1,"しゅ"],[12,1,"なに"],[26,1,"たず"],[33,1,"しゅ"],[35,1,"い"],[41,1,"お"],[52,1,"い"],[73,1,"き"],[78,1,"こと"],[87,1,"つ"]],"text":"わたしが『主よ、わたしは何をしたらよいでしょうか』と尋ねたところ、主は言われた、『起きあがってダマスコに行きなさい。そうすれば、あなたがするように決めてある事が、すべてそこで告げられるであろう』。"},{"ref":"Acts.22.11","start":44022011,"end":44022011,"break":"none","ruby":[[5,1,"ひかり"],[7,1,"かがや"],[10,1,"め"],[16,1,"なに"],[18,1,"み"],[30,1,"つ"],[33,1,"もの"],[37,1,"て"],[39,1,"ひ"],[51,1,"い"]],"text":"わたしは、光の輝きで目がくらみ、何も見えなくなっていたので、連れの者たちに手を引かれながら、ダマスコに行った。"},{"ref":"Acts.22.12","start":44022012,"end":44022012,"break":"paragraph","ruby":[[4,2,"りっぽう"],[7,2,"ちゅうじつ"],[15,2,"ざいじゅう"],[21,1,"じん"],[22,2,"ぜんたい"],[25,2,"ひょうばん"],[37,1,"ひと"]],"text":"すると、律法に忠実で、ダマスコ在住のユダヤ人全体に評判のよいアナニヤという人が、"},{"ref":"Acts.22.13","start":44022013,"end":44022013,"break":"none","ruby":[[14,1,"た"],[18,2,"きょうだい"],[25,1,"み"],[38,1,"い"],[47,2,"しゅんかん"],[55,1,"め"],[57,1,"ひら"],[61,1,"かれ"],[63,1,"すがた"],[65,1,"み"]],"text":"わたしのところにきて、そばに立ち、『兄弟サウロよ、見えるようになりなさい』と言った。するとその瞬間に、わたしの目が開いて、彼の姿が見えた。"},{"ref":"Acts.22.14","start":44022014,"end":44022014,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[13,2,"せんぞ"],[16,1,"かみ"],[23,1,"えら"],[27,1,"むね"],[29,1,"し"],[35,2,"ぎじん"],[38,1,"み"],[44,1,"くち"],[47,1,"こえ"],[50,1,"き"]],"text":"彼は言った、『わたしたちの先祖の神が、あなたを選んでみ旨を知らせ、かの義人を見させ、その口から声をお聞かせになった。"},{"ref":"Acts.22.15","start":44022015,"end":44022015,"break":"none","ruby":[[10,2,"みき"],[15,1,"こと"],[24,1,"ひと"],[26,1,"たい"],[30,1,"かれ"],[32,2,"しょうにん"]],"text":"それはあなたが、その見聞きした事につき、すべての人に対して、彼の証人になるためである。"},{"ref":"Acts.22.16","start":44022016,"end":44022016,"break":"none","ruby":[[3,1,"いま"],[22,1,"た"],[27,1,"な"],[39,1,"う"],[46,1,"つみ"],[48,1,"あら"],[50,1,"おと"]],"text":"そこで今、なんのためらうことがあろうか。すぐ立って、み名をとなえてバプテスマを受け、あなたの罪を洗い落しなさい』。"},{"ref":"Acts.22.17","start":44022017,"end":44022017,"break":"paragraph","ruby":[[15,1,"かえ"],[18,1,"みや"],[20,1,"いの"],[29,1,"ゆめ"]],"text":"それからわたしは、エルサレムに帰って宮で祈っているうちに、夢うつつになり、"},{"ref":"Acts.22.18","start":44022018,"end":44022018,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"しゅ"],[10,1,"い"],[16,1,"いそ"],[29,1,"で"],[31,1,"い"],[54,2,"ひとびと"],[57,1,"う"]],"text":"主にまみえたが、主は言われた、『急いで、すぐにエルサレムを出て行きなさい。わたしについてのあなたのあかしを、人々が受けいれないから』。"},{"ref":"Acts.22.19","start":44022019,"end":44022019,"break":"none","ruby":[[8,1,"い"],[13,1,"しゅ"],[16,1,"かれ"],[31,2,"かいどう"],[39,1,"しん"],[42,2,"ひとびと"],[45,1,"ごく"],[47,1,"とう"],[54,1,"う"],[66,1,"し"]],"text":"そこで、わたしが言った、『主よ、彼らは、わたしがいたるところの会堂で、あなたを信じる人々を獄に投じたり、むち打ったりしていたことを、知っています。"},{"ref":"Acts.22.20","start":44022020,"end":44022020,"break":"none","ruby":[[7,2,"しょうにん"],[14,1,"ち"],[16,1,"なが"],[20,1,"とき"],[27,1,"た"],[29,1,"あ"],[37,2,"さんせい"],[43,1,"かれ"],[45,1,"ころ"],[48,1,"ひと"],[52,2,"うわぎ"],[55,1,"ばん"]],"text":"また、あなたの証人ステパノの血が流された時も、わたしは立ち合っていてそれに賛成し、また彼を殺した人たちの上着の番をしていたのです』。"},{"ref":"Acts.22.21","start":44022021,"end":44022021,"break":"none","ruby":[[4,1,"しゅ"],[10,1,"い"],[16,1,"い"],[31,1,"とお"],[33,2,"いほう"],[36,1,"たみ"]],"text":"すると、主がわたしに言われた、『行きなさい。わたしが、あなたを遠く異邦の民へつかわすのだ』」。"},{"ref":"Acts.22.22","start":44022022,"end":44022022,"break":"paragraph","ruby":[[0,1,"かれ"],[2,2,"ことば"],[9,1,"き"],[14,2,"ひとびと"],[23,1,"こえ"],[25,1,"は"],[30,1,"い"],[38,1,"おとこ"],[40,2,"ちじょう"],[44,1,"と"],[46,1,"のぞ"],[53,1,"い"]],"text":"彼の言葉をここまで聞いていた人々は、このとき、声を張りあげて言った、「こんな男は地上から取り除いてしまえ。生かしおくべきではない」。"},{"ref":"Acts.22.23","start":44022023,"end":44022023,"break":"none","ruby":[[0,2,"ひとびと"],[8,1,"た"],[12,2,"くうちゅう"],[15,2,"うわぎ"],[18,1,"な"],[26,1,"ち"],[29,2,"しまつ"]],"text":"人々がこうわめき立てて、空中に上着を投げ、ちりをまき散らす始末であったので、"},{"ref":"Acts.22.24","start":44022024,"end":44022024,"break":"none","ruby":[[0,3,"せんそつちょう"],[8,2,"へいえい"],[11,1,"ひ"],[13,1,"い"],[19,1,"めい"],[30,1,"かれ"],[32,1,"たい"],[42,1,"た"],[50,1,"たし"],[57,1,"かれ"],[62,2,"ごうもん"],[69,1,"と"],[71,1,"しら"],[77,1,"い"]],"text":"千卒長はパウロを兵営に引き入れるように命じ、どういうわけで、彼に対してこんなにわめき立てているのかを確かめるため、彼をむちの拷問にかけて、取り調べるように言いわたした。"},{"ref":"Acts.22.25","start":44022025,"end":44022025,"break":"none","ruby":[[0,1,"かれ"],[6,1,"あ"],[12,1,"かれ"],[14,1,"しば"],[21,1,"とき"],[30,1,"た"],[35,3,"ひゃくそつちょう"],[39,1,"い"],[48,2,"しみん"],[52,1,"もの"],[55,2,"さいばん"],[68,1,"う"]],"text":"彼らがむちを当てるため、彼を縛りつけていた時、パウロはそばに立っている百卒長に言った、「ローマの市民たる者を、裁判にかけもしないで、むち打ってよいのか」。"},{"ref":"Acts.22.26","start":44022026,"end":44022026,"break":"none","ruby":[[0,3,"ひゃくそつちょう"],[7,1,"き"],[10,3,"せんそつちょう"],[18,1,"い"],[21,2,"ほうこく"],[28,1,"い"],[44,1,"ひと"],[50,2,"しみん"]],"text":"百卒長はこれを聞き、千卒長のところに行って報告し、そして言った、「どうなさいますか。あの人はローマの市民なのです」。"},{"ref":"Acts.22.27","start":44022027,"end":44022027,"break":"none","ruby":[[4,3,"せんそつちょう"],[18,1,"い"],[27,1,"い"],[41,2,"しみん"],[59,1,"い"]],"text":"そこで、千卒長がパウロのところにきて言った、「わたしに言ってくれ。あなたはローマの市民なのか」。パウロは「そうです」と言った。"},{"ref":"Acts.22.28","start":44022028,"end":44022028,"break":"none","ruby":[[3,1,"たい"],[6,3,"せんそつちょう"],[10,1,"い"],[21,2,"しみん"],[23,1,"けん"],[26,2,"たがく"],[29,1,"かね"],[31,1,"か"],[33,1,"と"],[47,1,"い"],[56,1,"うま"],[62,2,"しみん"]],"text":"これに対して千卒長が言った、「わたしはこの市民権を、多額の金で買い取ったのだ」。するとパウロは言った、「わたしは生れながらの市民です」。"},{"ref":"Acts.22.29","start":44022029,"end":44022029,"break":"none","ruby":[[8,1,"と"],[10,1,"しら"],[19,1,"ひと"],[28,1,"かれ"],[31,1,"み"],[33,1,"ひ"],[37,3,"せんそつちょう"],[50,2,"しみん"],[65,1,"ひと"],[67,1,"しば"],[80,1,"おそ"]],"text":"そこで、パウロを取り調べようとしていた人たちは、ただちに彼から身を引いた。千卒長も、パウロがローマの市民であること、また、そういう人を縛っていたことがわかって、恐れた。"},{"ref":"Acts.22.30","start":44022030,"end":44022030,"break":"paragraph","ruby":[[0,2,"よくじつ"],[3,1,"かれ"],[9,1,"じん"],[17,1,"うった"],[19,1,"で"],[26,2,"しんそう"],[29,1,"し"],[33,1,"おも"],[36,1,"かれ"],[38,1,"と"],[44,2,"どうじ"],[47,3,"さいしちょう"],[53,1,"ぜん"],[54,2,"ぎかい"],[58,2,"しょうしゅう"],[66,1,"かれ"],[68,1,"ひ"],[70,1,"だ"],[74,1,"かれ"],[77,1,"まえ"],[79,1,"た"]],"text":"翌日、彼は、ユダヤ人がなぜパウロを訴え出たのか、その真相を知ろうと思って彼を解いてやり、同時に祭司長たちと全議会とを召集させ、そこに彼を引き出して、彼らの前に立たせた。"}]