[{"ref":"Gen.7.1","start":1007001,"end":1007001,"break":"paragraph","ruby":[[0,1,"しゅ"],[5,1,"い"],[15,2,"かぞく"],[21,2,"はこぶね"],[37,2,"じだい"],[40,2,"ひとびと"],[43,1,"なか"],[50,1,"まえ"],[52,1,"ただ"],[55,1,"ひと"],[64,1,"みと"]],"text":"主はノアに言われた、「あなたと家族とはみな箱舟にはいりなさい。あなたがこの時代の人々の中で、わたしの前に正しい人であるとわたしは認めたからである。"},{"ref":"Gen.7.2","start":1007002,"end":1007002,"break":"none","ruby":[[8,1,"きよ"],[10,1,"けもの"],[12,1,"なか"],[15,1,"おす"],[17,1,"めす"],[24,1,"と"],[27,1,"きよ"],[31,1,"けもの"],[33,1,"なか"],[36,1,"おす"],[38,1,"めす"],[45,1,"と"]],"text":"あなたはすべての清い獣の中から雄と雌とを七つずつ取り、清くない獣の中から雄と雌とを二つずつ取り、"},{"ref":"Gen.7.3","start":1007003,"end":1007003,"break":"none","ruby":[[2,1,"そら"],[4,1,"とり"],[6,1,"なか"],[9,1,"おす"],[11,1,"めす"],[18,1,"と"],[24,2,"しゅるい"],[27,1,"ぜん"],[28,1,"ち"],[34,1,"い"],[36,1,"のこ"]],"text":"また空の鳥の中から雄と雌とを七つずつ取って、その種類が全地のおもてに生き残るようにしなさい。"},{"ref":"Gen.7.4","start":1007004,"end":1007004,"break":"none","ruby":[[0,2,"なぬか"],[3,1,"のち"],[11,1,"にち"],[14,1,"や"],[16,1,"ち"],[18,1,"あめ"],[20,1,"ふ"],[29,1,"つく"],[36,1,"い"],[38,1,"もの"],[41,1,"ち"],[51,1,"さ"]],"text":"七日の後、わたしは四十日四十夜、地に雨を降らせて、わたしの造ったすべての生き物を、地のおもてからぬぐい去ります」。"},{"ref":"Gen.7.5","start":1007005,"end":1007005,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"めい"]],"text":"ノアはすべて主が命じられたようにした。"},{"ref":"Gen.7.6","start":1007006,"end":1007006,"break":"paragraph","ruby":[[2,2,"こうずい"],[5,1,"ち"],[7,1,"た"],[10,1,"とき"],[17,1,"さい"]],"text":"さて洪水が地に起った時、ノアは六百歳であった。"},{"ref":"Gen.7.7","start":1007007,"end":1007007,"break":"none","ruby":[[3,1,"こ"],[7,1,"つま"],[10,1,"こ"],[13,1,"つま"],[17,1,"とも"],[19,2,"こうずい"],[22,1,"さ"],[25,2,"はこぶね"]],"text":"ノアは子らと、妻と、子らの妻たちと共に洪水を避けて箱舟にはいった。"},{"ref":"Gen.7.8","start":1007008,"end":1007008,"break":"none","ruby":[[2,1,"きよ"],[4,1,"けもの"],[7,1,"きよ"],[11,1,"けもの"],[14,1,"とり"],[17,1,"ち"],[19,1,"は"]],"text":"また清い獣と、清くない獣と、鳥と、地に這うすべてのものとの、"},{"ref":"Gen.7.9","start":1007009,"end":1007009,"break":"none","ruby":[[0,1,"おす"],[2,1,"めす"],[19,1,"かみ"],[24,1,"めい"],[32,2,"はこぶね"]],"text":"雄と雌とが、二つずつノアのもとにきて、神がノアに命じられたように箱舟にはいった。"},{"ref":"Gen.7.10","start":1007010,"end":1007010,"break":"none","ruby":[[4,2,"なぬか"],[7,1,"のち"],[9,2,"こうずい"],[12,1,"ち"],[14,1,"た"]],"text":"こうして七日の後、洪水が地に起った。"},{"ref":"Gen.7.11","start":1007011,"end":1007011,"break":"paragraph","ruby":[[8,1,"さい"],[11,1,"がつ"],[14,1,"にち"],[22,1,"ひ"],[24,1,"おお"],[28,1,"ふち"],[30,1,"みなもと"],[38,1,"やぶ"],[41,1,"てん"],[43,1,"まど"],[45,1,"ひら"]],"text":"それはノアの六百歳の二月十七日であって、その日に大いなる淵の源は、ことごとく破れ、天の窓が開けて、"},{"ref":"Gen.7.12","start":1007012,"end":1007012,"break":"none","ruby":[[0,1,"あめ"],[4,1,"にち"],[7,1,"や"],[9,1,"ち"],[11,1,"ふ"],[13,1,"そそ"]],"text":"雨は四十日四十夜、地に降り注いだ。"},{"ref":"Gen.7.13","start":1007013,"end":1007013,"break":"none","ruby":[[2,1,"おな"],[4,1,"ひ"],[14,1,"こ"],[29,1,"つま"],[34,1,"こ"],[38,1,"にん"],[40,1,"つま"],[43,1,"とも"],[45,2,"はこぶね"]],"text":"その同じ日に、ノアと、ノアの子セム、ハム、ヤペテと、ノアの妻と、その子らの三人の妻とは共に箱舟にはいった。"},{"ref":"Gen.7.14","start":1007014,"end":1007014,"break":"none","ruby":[[6,2,"しゅるい"],[9,1,"けもの"],[16,2,"しゅるい"],[19,2,"かちく"],[23,1,"ち"],[29,2,"しゅるい"],[32,1,"は"],[42,2,"しゅるい"],[45,1,"とり"],[52,1,"つばさ"],[59,1,"みな"]],"text":"またすべての種類の獣も、すべての種類の家畜も、地のすべての種類の這うものも、すべての種類の鳥も、すべての翼あるものも、皆はいった。"},{"ref":"Gen.7.15","start":1007015,"end":1007015,"break":"none","ruby":[[4,1,"いのち"],[6,1,"いき"],[14,1,"にく"],[34,2,"はこぶね"]],"text":"すなわち命の息のあるすべての肉なるものが、二つずつノアのもとにきて、箱舟にはいった。"},{"ref":"Gen.7.16","start":1007016,"end":1007016,"break":"none","ruby":[[13,1,"にく"],[19,1,"おす"],[21,1,"めす"],[28,1,"かみ"],[30,1,"かれ"],[32,1,"めい"],[48,1,"しゅ"],[50,1,"かれ"],[56,1,"と"],[58,1,"と"]],"text":"そのはいったものは、すべて肉なるものの雄と雌とであって、神が彼に命じられたようにはいった。そこで主は彼のうしろの戸を閉ざされた。"},{"ref":"Gen.7.17","start":1007017,"end":1007017,"break":"paragraph","ruby":[[0,2,"こうずい"],[5,1,"にち"],[10,2,"ちじょう"],[17,1,"みず"],[19,1,"ま"],[22,2,"はこぶね"],[25,1,"うか"],[31,2,"はこぶね"],[34,1,"ち"],[37,1,"たか"],[39,1,"あ"]],"text":"洪水は四十日のあいだ地上にあった。水が増して箱舟を浮べたので、箱舟は地から高く上がった。"},{"ref":"Gen.7.18","start":1007018,"end":1007018,"break":"none","ruby":[[2,1,"みず"],[9,1,"ち"],[11,1,"ま"],[17,2,"はこぶね"],[20,1,"みず"],[26,1,"ただよ"]],"text":"また水がみなぎり、地に増したので、箱舟は水のおもてに漂った。"},{"ref":"Gen.7.19","start":1007019,"end":1007019,"break":"none","ruby":[[0,1,"みず"],[9,1,"ち"],[16,1,"てん"],[18,1,"した"],[20,1,"たか"],[22,2,"やまやま"],[25,1,"みな"]],"text":"水はまた、ますます地にみなぎり、天の下の高い山々は皆おおわれた。"},{"ref":"Gen.7.20","start":1007020,"end":1007020,"break":"none","ruby":[[0,1,"みず"],[4,1,"うえ"],[21,2,"やまやま"],[24,1,"まった"]],"text":"水はその上、さらに十五キュビトみなぎって、山々は全くおおわれた。"},{"ref":"Gen.7.21","start":1007021,"end":1007021,"break":"none","ruby":[[0,1,"ち"],[2,1,"うえ"],[4,1,"うご"],[9,1,"にく"],[16,1,"とり"],[18,2,"かちく"],[21,1,"けもの"],[24,1,"ち"],[26,1,"むら"],[33,1,"は"],[43,1,"ひと"],[47,1,"ほろ"]],"text":"地の上に動くすべて肉なるものは、鳥も家畜も獣も、地に群がるすべての這うものも、すべての人もみな滅びた。"},{"ref":"Gen.7.22","start":1007022,"end":1007022,"break":"none","ruby":[[4,1,"はな"],[6,1,"いのち"],[8,1,"いき"],[19,1,"りく"],[30,1,"し"]],"text":"すなわち鼻に命の息のあるすべてのもの、陸にいたすべてのものは死んだ。"},{"ref":"Gen.7.23","start":1007023,"end":1007023,"break":"none","ruby":[[0,1,"ち"],[12,1,"い"],[14,1,"もの"],[17,1,"ひと"],[19,2,"かちく"],[23,1,"は"],[29,1,"そら"],[31,1,"とり"],[35,1,"ち"],[41,1,"さ"],[52,1,"かれ"],[54,1,"とも"],[56,2,"はこぶね"],[66,1,"のこ"]],"text":"地のおもてにいたすべての生き物は、人も家畜も、這うものも、空の鳥もみな地からぬぐい去られて、ただノアと、彼と共に箱舟にいたものだけが残った。"},{"ref":"Gen.7.24","start":1007024,"end":1007024,"break":"none","ruby":[[0,1,"みず"],[5,1,"にち"],[10,2,"ちじょう"]],"text":"水は百五十日のあいだ地上にみなぎった。"}]