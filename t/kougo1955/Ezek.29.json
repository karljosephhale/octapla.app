[{"ref":"Ezek.29.1","start":26029001,"end":26029001,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"ねん"],[5,1,"がつ"],[8,1,"にち"],[11,1,"しゅ"],[13,2,"ことば"],[20,1,"のぞ"]],"text":"第十年の十月十二日に、主の言葉がわたしに臨んだ、"},{"ref":"Ezek.29.2","start":26029002,"end":26029002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,1,"かお"],[17,1,"おう"],[21,1,"む"],[24,1,"かれ"],[30,2,"ぜんこく"],[33,1,"たい"],[36,2,"よげん"]],"text":"「人の子よ、あなたの顔をエジプトの王パロに向け、彼とエジプト全国に対して預言し、"},{"ref":"Ezek.29.3","start":26029003,"end":26029003,"break":"none","breaks":[[18,"stanza"],[28,"line"],[44,"line"],[63,"line"],[76,"line"]],"ruby":[[0,1,"かた"],[3,1,"い"],[6,1,"しゅ"],[9,1,"かみ"],[13,1,"い"],[23,1,"おう"],[28,1,"み"],[39,1,"てき"],[50,1,"かわ"],[52,1,"なか"],[54,1,"ふ"],[56,1,"おお"],[60,1,"りゅう"],[67,1,"がわ"],[83,1,"つく"],[88,1,"い"]],"text":"語って言え。主なる神はこう言われる、エジプトの王パロよ、見よ、わたしはあなたの敵となる。あなたはその川の中に伏す大いなる龍で、『ナイル川はわたしのもの、わたしがこれを造った』と言う。"},{"ref":"Ezek.29.4","start":26029004,"end":26029004,"break":"line","breaks":[[18,"line"],[39,"line"],[57,"line"]],"ruby":[[22,1,"かわ"],[24,1,"うお"],[62,1,"うお"],[69,1,"かわ"],[72,1,"ひ"]],"text":"わたしは、かぎをあなたのあごにかけ、あなたの川の魚を、あなたのうろこにつかせ、あなたと、あなたのうろこについているもろもろの魚を、あなたの川から引きあげ、"},{"ref":"Ezek.29.5","start":26029005,"end":26029005,"break":"line","breaks":[[18,"line"],[27,"line"],[38,"line"],[57,"line"],[65,"line"]],"ruby":[[8,1,"かわ"],[15,1,"うお"],[18,2,"あらの"],[21,1,"な"],[23,1,"す"],[31,1,"の"],[33,1,"おもて"],[35,1,"たお"],[42,1,"と"],[44,1,"あつ"],[47,1,"もの"],[50,1,"ほうむ"],[52,1,"もの"],[65,1,"ち"],[67,1,"けもの"],[69,1,"そら"],[71,1,"とり"],[79,1,"あた"]],"text":"あなたとあなたの川のもろもろの魚を、荒野に投げ捨てる。あなたは野の面に倒れ、あなたを取り集める者も、葬る者もない。わたしはあなたを地の獣と空の鳥のえじきとして与える。"},{"ref":"Ezek.29.6","start":26029006,"end":26029006,"break":"paragraph","ruby":[[12,2,"じゅうみん"],[19,1,"しゅ"],[26,1,"し"],[39,1,"いえ"],[41,1,"たい"],[44,1,"あし"]],"text":"そしてエジプトのすべての住民はわたしが主であることを知る。あなたはイスラエルの家に対して葦のつえであった。"},{"ref":"Ezek.29.7","start":26029007,"end":26029007,"break":"none","ruby":[[0,1,"かれ"],[7,1,"て"],[11,1,"とき"],[17,1,"お"],[20,1,"かれ"],[23,1,"かた"],[30,1,"さ"],[34,1,"かれ"],[43,1,"よ"],[48,1,"とき"],[54,1,"やぶ"],[57,1,"かれ"],[60,1,"こし"],[67,1,"ふる"]],"text":"彼らがあなたを手にとる時、あなたは折れ、彼らの肩はことごとく裂ける。彼らがまたあなたに寄りかかる時、あなたは破れ、彼らの腰をことごとく震えさせる。"},{"ref":"Ezek.29.8","start":26029008,"end":26029008,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[17,1,"み"],[32,1,"も"],[38,1,"ひと"],[40,1,"けもの"],[51,1,"た"]],"text":"それゆえ、主なる神はこう言われる、見よ、わたしはつるぎをあなたに持ってきて、人と獣とをあなたのうちから断つ。"},{"ref":"Ezek.29.9","start":26029009,"end":26029009,"break":"none","breaks":[[37,"paragraph"]],"ruby":[[5,1,"ち"],[7,1,"あ"],[21,1,"かれ"],[27,1,"しゅ"],[34,1,"し"],[45,1,"がわ"],[61,1,"つく"],[66,1,"い"]],"text":"エジプトの地は荒れて、むなしくなる。そして彼はわたしが主であることを知る。あなたは『ナイル川はわたしのもの、わたしがこれを造った』と言っているゆえに、"},{"ref":"Ezek.29.10","start":26029010,"end":26029010,"break":"none","ruby":[[0,1,"み"],[15,2,"かわがわ"],[18,1,"てき"],[29,1,"ち"],[49,1,"さかい"],[51,1,"いた"],[61,1,"あら"]],"text":"見よ、わたしはあなたとあなたの川々の敵となって、エジプトの地をミグドルからスエネまで、エチオピヤの境に至るまで、ことごとく荒し、むなしくする。"},{"ref":"Ezek.29.11","start":26029011,"end":26029011,"break":"none","ruby":[[0,1,"ひと"],[2,1,"あし"],[7,1,"わた"],[11,1,"けもの"],[13,1,"あし"],[18,1,"わた"],[25,1,"ねん"],[27,1,"あいだ"],[32,1,"す"],[34,1,"もの"]],"text":"人の足はこれを渡らず、獣の足もこれを渡らない。四十年の間、ここに住む者はない。"},{"ref":"Ezek.29.12","start":26029012,"end":26029012,"break":"none","ruby":[[9,1,"ち"],[11,1,"あら"],[15,1,"あ"],[18,2,"くにぐに"],[21,1,"なか"],[23,1,"お"],[28,2,"まちまち"],[31,1,"あ"],[37,1,"ねん"],[42,1,"あ"],[45,2,"まちまち"],[48,1,"なか"],[70,2,"こくみん"],[73,1,"なか"],[75,1,"ち"],[84,1,"くに"],[86,1,"なか"],[88,1,"ち"]],"text":"わたしはエジプトの地を荒して、荒れた国々の中に置き、その町々は荒れて、四十年のあいだ荒れた町々の中にある。わたしはエジプトびとを、もろもろの国民の中に散らし、もろもろの国の中に散らす。"},{"ref":"Ezek.29.13","start":26029013,"end":26029013,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[14,1,"ねん"],[16,1,"のち"],[32,1,"ち"],[42,1,"たみ"],[44,1,"なか"],[47,1,"あつ"]],"text":"主なる神はこう言われる、四十年の後、わたしはエジプトびとを、その散らされたもろもろの民の中から集める。"},{"ref":"Ezek.29.14","start":26029014,"end":26029014,"break":"none","ruby":[[9,2,"うんめい"],[15,1,"かえ"],[18,1,"かれ"],[23,1,"うま"],[26,1,"ち"],[35,1,"ち"],[37,1,"かえ"],[44,1,"ところ"],[46,1,"かれ"],[49,1,"いや"],[52,1,"くに"]],"text":"すなわちエジプトの運命をもとに返し、彼らをその生れた地であるパテロスの地に帰らせる。その所で彼らは卑しい国となる。"},{"ref":"Ezek.29.15","start":26029015,"end":26029015,"break":"none","ruby":[[8,1,"くに"],[12,1,"いや"],[18,1,"ふたた"],[25,2,"こくみん"],[28,1,"うえ"],[30,1,"で"],[44,1,"かれ"],[47,1,"ちい"],[55,1,"ふたた"],[62,2,"こくみん"],[65,1,"おさ"]],"text":"これはもろもろの国よりも卑しくなり、再びもろもろの国民の上に出ることができない。わたしは彼らを小さくするゆえ、再びもろもろの国民を治めることはない。"},{"ref":"Ezek.29.16","start":26029016,"end":26029016,"break":"none","ruby":[[9,1,"たす"],[12,1,"もと"],[15,1,"とき"],[19,1,"つみ"],[21,1,"おも"],[23,1,"だ"],[27,1,"ふたた"],[35,1,"いえ"],[37,1,"たの"],[50,1,"かれ"],[58,1,"しゅ"],[61,1,"かみ"],[68,1,"し"]],"text":"これはイスラエルが助けを求める時、その罪を思い出して、再びイスラエルの家の頼みとはならない。こうして彼らは、わたしが主なる神であることを知る」。"},{"ref":"Ezek.29.17","start":26029017,"end":26029017,"break":"paragraph","ruby":[[0,1,"だい"],[4,1,"ねん"],[7,1,"がつ"],[9,1,"にち"],[12,1,"しゅ"],[14,2,"ことば"],[21,1,"のぞ"]],"text":"第二十七年の一月一日に、主の言葉がわたしに臨んだ、"},{"ref":"Ezek.29.18","start":26029018,"end":26029018,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[11,1,"おう"],[23,2,"ぐんぜい"],[29,1,"たい"],[32,1,"おお"],[35,1,"はたら"],[40,1,"あたま"],[42,1,"みな"],[46,1,"かた"],[50,1,"やぶ"],[57,1,"かれ"],[61,2,"ぐんぜい"],[68,1,"たい"],[76,1,"はたら"],[86,1,"むく"],[90,1,"え"]],"text":"「人の子よ、バビロンの王ネブカデレザルは、その軍勢をツロに対して大いに働かせた。頭は皆はげ、肩はみな破れた。しかし彼もその軍勢も、ツロに対してなしたその働きのために、なんの報いをも得なかった。"},{"ref":"Ezek.29.19","start":26029019,"end":26029019,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[17,1,"み"],[29,1,"おう"],[44,1,"ち"],[46,1,"あた"],[50,1,"かれ"],[54,2,"ざいほう"],[57,1,"と"],[60,1,"もの"],[66,1,"もの"],[68,1,"うば"],[76,2,"ぐんぜい"],[79,1,"あた"],[82,1,"むく"]],"text":"それゆえ、主なる神はこう言われる、見よ、わたしはバビロンの王ネブカデレザルに、エジプトの地を与える。彼はその財宝を取り、物をかすめ、物を奪い、それをその軍勢に与えて報いとする。"},{"ref":"Ezek.29.20","start":26029020,"end":26029020,"break":"none","ruby":[[0,1,"かれ"],[2,1,"はたら"],[5,2,"ほうしゅう"],[20,1,"ち"],[22,1,"かれ"],[24,1,"あた"],[28,1,"かれ"],[51,1,"しゅ"],[54,1,"かみ"],[56,1,"い"]],"text":"彼の働いた報酬として、わたしはエジプトの地を彼に与える。彼らはわたしのために、これをしたからであると、主なる神は言われる。"},{"ref":"Ezek.29.21","start":26029021,"end":26029021,"break":"paragraph","ruby":[[2,1,"ひ"],[14,1,"いえ"],[20,1,"つの"],[22,1,"しょう"],[31,1,"くち"],[33,1,"かれ"],[39,1,"ひら"],[47,1,"かれ"],[54,1,"しゅ"],[61,1,"し"]],"text":"その日、わたしはイスラエルの家に、一つの角を生じさせ、あなたの口を彼らのうちに開かせる。そして彼らはわたしが主であることを知る」。"}]