[{"ref":"Song.3.1","start":22003001,"end":22003001,"break":"paragraph","breaks":[[11,"line"],[25,"line"],[46,"line"]],"ruby":[[4,1,"よる"],[6,1,"とこ"],[8,1,"うえ"],[13,1,"たましい"],[15,1,"あい"],[18,1,"もの"],[29,1,"かれ"],[37,1,"み"],[50,1,"かれ"],[52,1,"よ"],[57,1,"こたえ"]],"text":"わたしは夜、床の上で、わが魂の愛する者をたずねた。わたしは彼をたずねたが、見つからなかった。わたしは彼を呼んだが、答がなかった。"},{"ref":"Song.3.2","start":22003002,"end":22003002,"break":"line","breaks":[[18,"line"],[42,"line"]],"ruby":[[5,1,"いま"],[6,1,"お"],[10,1,"まち"],[15,1,"ある"],[18,2,"がいろ"],[21,2,"ひろば"],[27,1,"たましい"],[29,1,"あい"],[32,1,"もの"],[42,1,"かれ"],[50,1,"み"]],"text":"「わたしは今起きて、町をまわり歩き、街路や広場で、わが魂の愛する者をたずねよう」と、彼をたずねたが、見つからなかった。"},{"ref":"Song.3.3","start":22003003,"end":22003003,"break":"line","breaks":[[20,"line"],[28,"line"]],"ruby":[[0,1,"まち"],[5,1,"ある"],[7,2,"よまわ"],[13,2,"であ"],[30,1,"たましい"],[32,1,"あい"],[35,1,"もの"],[37,1,"み"],[44,1,"たず"]],"text":"町をまわり歩く夜回りたちに出会ったので、「あなたがたは、わが魂の愛する者を見ましたか」と尋ねた。"},{"ref":"Song.3.4","start":22003004,"end":22003004,"break":"line","breaks":[[16,"line"],[30,"line"],[46,"line"],[61,"line"]],"ruby":[[4,1,"かれ"],[7,1,"わか"],[10,1,"い"],[18,1,"たましい"],[20,1,"あい"],[23,1,"もの"],[25,2,"であ"],[34,1,"かれ"],[36,1,"ひ"],[38,1,"と"],[41,1,"い"],[51,1,"はは"],[53,1,"いえ"],[58,1,"い"],[65,1,"う"],[68,1,"もの"]],"text":"わたしが彼らと別れて行くとすぐ、わが魂の愛する者に出会った。わたしは彼を引き留めて行かせず、ついにわが母の家につれて行き、わたしを産んだ者のへやにはいった。"},{"ref":"Song.3.5","start":22003005,"end":22003005,"break":"line","breaks":[[11,"line"],[31,"line"],[46,"line"],[61,"line"],[74,"line"]],"ruby":[[6,1,"むすめ"],[21,1,"の"],[23,1,"め"],[37,1,"ちか"],[41,1,"ねが"],[46,1,"あい"],[53,1,"おこ"],[66,1,"よ"],[68,1,"おこ"]],"text":"エルサレムの娘たちよ、わたしは、かもしかと野の雌じかをさして、あなたがたに誓い、お願いする、愛のおのずから起るときまでは、ことさらに呼び起すことも、さますこともしないように。"},{"ref":"Song.3.6","start":22003006,"end":22003006,"break":"stanza","breaks":[[23,"line"],[30,"line"]],"ruby":[[0,2,"もつやく"],[3,2,"にゅうこう"],[8,2,"しょうにん"],[16,2,"こうりょう"],[27,1,"はな"],[30,1,"けむり"],[32,1,"はしら"],[38,2,"あらの"],[42,1,"のぼ"],[45,1,"く"],[50,1,"なに"]],"text":"没薬、乳香など、商人のもろもろの香料をもって、かおりを放ち、煙の柱のように、荒野から上って来るものは何か。"},{"ref":"Song.3.7","start":22003007,"end":22003007,"break":"line","breaks":[[15,"line"],[31,"line"]],"ruby":[[0,1,"み"],[11,2,"のりもの"],[17,1,"にん"],[19,2,"ゆうし"],[37,2,"ゆうし"]],"text":"見よ、あれはソロモンの乗物で、六十人の勇士がそのまわりにいる。イスラエルの勇士で、"},{"ref":"Song.3.8","start":22003008,"end":22003008,"break":"line","breaks":[[16,"line"],[28,"line"]],"ruby":[[0,1,"みな"],[9,1,"たたか"],[20,1,"こし"],[22,1,"けん"],[24,1,"お"],[28,1,"よる"],[30,2,"きけん"],[33,1,"そな"]],"text":"皆、つるぎをとり、戦いをよくし、おのおの腰に剣を帯びて、夜の危険に備えている。"},{"ref":"Song.3.9","start":22003009,"end":22003009,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"おう"],[11,1,"き"],[17,2,"じぶん"],[23,1,"こし"]],"text":"ソロモン王はレバノンの木をもって、自分のために輿をつくった。"},{"ref":"Song.3.10","start":22003010,"end":22003010,"break":"line","breaks":[[14,"line"],[27,"line"],[44,"line"]],"ruby":[[2,1,"はしら"],[4,1,"ぎん"],[12,1,"きん"],[16,1,"ざ"],[18,1,"むらさき"],[20,1,"ぬの"],[29,2,"ないぶ"],[39,1,"むすめ"],[44,2,"あいじょう"],[54,1,"もの"],[56,1,"は"]],"text":"その柱は銀、そのうしろは金、その座は紫の布でつくった。その内部にはエルサレムの娘たちが、愛情をこめてつくった物を張りつけた。"},{"ref":"Song.3.11","start":22003011,"end":22003011,"break":"line","breaks":[[22,"line"],[37,"line"]],"ruby":[[4,1,"むすめ"],[9,1,"で"],[17,1,"おう"],[19,1,"み"],[22,1,"かれ"],[24,2,"こんいん"],[27,1,"ひ"],[29,1,"こころ"],[31,1,"よろこ"],[34,1,"ひ"],[39,1,"はは"],[41,1,"かれ"],[48,1,"かんむり"]],"text":"シオンの娘たちよ、出てきてソロモン王を見よ。彼は婚姻の日、心の喜びの日に、その母の彼にかぶらせた冠をいただいている。"}]