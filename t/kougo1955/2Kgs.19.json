[{"ref":"2Kgs.19.1","start":12019001,"end":12019001,"break":"paragraph","ruby":[[4,1,"おう"],[9,1,"き"],[13,1,"ころも"],[15,1,"さ"],[18,2,"あらぬの"],[21,1,"み"],[27,1,"しゅ"],[29,1,"みや"],[31,1,"はい"]],"text":"ヒゼキヤ王はこれを聞いて、衣を裂き、荒布を身にまとって主に宮に入り、"},{"ref":"2Kgs.19.2","start":12019002,"end":12019002,"break":"none","ruby":[[0,3,"くないきょう"],[9,3,"しょきかん"],[18,2,"さいし"],[24,3,"ねんちょうしゃ"],[30,2,"あらぬの"],[43,1,"こ"],[44,3,"よげんしゃ"]],"text":"宮内卿エリアキムと書記官セブナおよび祭司のうちの年長者たちに荒布をまとわせて、アモツの子預言者イザヤのもとにつかわした。"},{"ref":"2Kgs.19.3","start":12019003,"end":12019003,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[19,1,"もう"],[30,1,"なや"],[34,1,"こら"],[45,1,"ひ"],[49,2,"たいじ"],[55,1,"うま"],[66,1,"う"],[68,1,"だ"],[70,1,"ちから"]],"text":"彼らはイザヤに言った、「ヒゼキヤはこう申されます、『きょうは悩みと、懲しめと、はずかしめの日です。胎児がまさに生れようとして、これを産み出す力がないのです。"},{"ref":"2Kgs.19.4","start":12019004,"end":12019004,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[16,2,"しゅくん"],[24,1,"おう"],[33,1,"い"],[36,1,"かみ"],[47,2,"ことば"],[50,1,"き"],[69,1,"かみ"],[71,1,"しゅ"],[75,1,"き"],[78,2,"ことば"],[102,1,"のこ"],[107,1,"もの"],[112,1,"いのり"]],"text":"あなたの神、主はラブシャケがその主君アッスリヤの王につかわされて、生ける神をそしったもろもろの言葉を聞かれたかもしれません。そしてあなたの神、主はその聞いた言葉をとがめられるかもしれません。それゆえ、この残っている者のために祈をささげてください』」。"},{"ref":"2Kgs.19.5","start":12019005,"end":12019005,"break":"none","ruby":[[4,1,"おう"],[6,2,"けらい"],[18,1,"き"]],"text":"ヒゼキヤ王の家来たちがイザヤのもとに来たとき、"},{"ref":"2Kgs.19.6","start":12019006,"end":12019006,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[18,2,"しゅくん"],[23,1,"い"],[30,1,"しゅ"],[34,1,"おお"],[46,1,"おう"],[48,2,"けらい"],[62,2,"ことば"],[65,1,"き"],[68,1,"おそ"],[73,1,"およ"]],"text":"イザヤは彼らに言った、「あなたがたの主君にこう言いなさい、『主はこう仰せられる、アッスリヤの王の家来たちが、わたしをそしった言葉を聞いて恐れるには及ばない。"},{"ref":"2Kgs.19.7","start":12019007,"end":12019007,"break":"none","ruby":[[0,1,"み"],[10,1,"れい"],[12,1,"かれ"],[18,1,"おく"],[29,1,"き"],[33,1,"かれ"],[35,2,"じぶん"],[38,1,"くに"],[40,1,"かえ"],[45,2,"じぶん"],[48,1,"くに"],[54,1,"たお"]],"text":"見よ、わたしは一つの霊を彼らのうちに送って、一つのうわさを聞かせ、彼を自分の国へ帰らせて、自分の国でつるぎに倒れさせるであろう』」。"},{"ref":"2Kgs.19.8","start":12019008,"end":12019008,"break":"paragraph","ruby":[[6,1,"ひ"],[8,1,"かえ"],[18,1,"おう"],[24,1,"せ"],[33,1,"い"],[37,1,"かれ"],[39,1,"おう"],[45,1,"さ"],[51,1,"き"]],"text":"ラブシャケは引き返して、アッスリヤの王がリブナを攻めているところへ行った。彼が王のラキシを去ったことを聞いたからである。"},{"ref":"2Kgs.19.9","start":12019009,"end":12019009,"break":"none","ruby":[[2,1,"とき"],[9,1,"おう"],[17,1,"おう"],[28,1,"かれ"],[34,1,"たたか"],[39,1,"で"],[45,2,"ひとびと"],[52,1,"き"],[58,1,"ふたた"],[60,2,"ししゃ"],[73,1,"い"]],"text":"この時アッスリヤの王はエチオピヤの王テルハカについて、「彼はあなたと戦うために出てきた」と人々がいうのを聞いたので、再び使者をヒゼキヤにつかわして言った、"},{"ref":"2Kgs.19.10","start":12019010,"end":12019010,"break":"none","ruby":[[4,1,"おう"],[12,1,"い"],[36,1,"おう"],[38,1,"て"],[40,1,"おちい"],[49,1,"い"],[55,2,"しんらい"],[59,1,"かみ"],[61,1,"あざむ"]],"text":"「ユダの王ヒゼキヤにこう言いなさい、『あなたは、エルサレムはアッスリヤの王の手に陥ることはない、と言うあなたの信頼する神に欺かれてはならない。"},{"ref":"2Kgs.19.11","start":12019011,"end":12019011,"break":"none","ruby":[[10,1,"おう"],[19,2,"くにぐに"],[24,1,"こと"],[26,1,"かれ"],[29,1,"まった"],[31,1,"ほろ"],[35,1,"こと"],[37,1,"き"],[51,1,"すく"]],"text":"あなたはアッスリヤの王たちがもろもろの国々にした事、彼らを全く滅ぼした事を聞いている。どうしてあなたが救われることができようか。"},{"ref":"2Kgs.19.12","start":12019012,"end":12019012,"break":"none","ruby":[[4,1,"ちち"],[34,2,"ひとびと"],[37,1,"ほろ"],[45,2,"くにぐに"],[48,2,"かみがみ"],[51,1,"かれ"],[54,1,"すく"]],"text":"わたしの父たちはゴザン、ハラン、レゼフ、およびテラサルにいたエデンの人々を滅ぼしたが、その国々の神々は彼らを救ったか。"},{"ref":"2Kgs.19.13","start":12019013,"end":12019013,"break":"none","ruby":[[4,1,"おう"],[11,1,"おう"],[20,1,"まち"],[22,1,"おう"],[27,1,"おう"],[34,1,"おう"]],"text":"ハマテの王、アルパデの王、セパルワイムの町の王、ヘナの王およびイワの王はどこにいるのか』」。"},{"ref":"2Kgs.19.14","start":12019014,"end":12019014,"break":"paragraph","ruby":[[5,2,"ししゃ"],[8,1,"て"],[11,2,"てがみ"],[14,1,"う"],[16,1,"と"],[22,1,"よ"],[25,1,"しゅ"],[27,1,"みや"],[37,1,"しゅ"],[39,1,"まえ"]],"text":"ヒゼキヤは使者の手から手紙を受け取ってそれを読み、主の宮にのぼっていって、主の前にそれをひろげ、"},{"ref":"2Kgs.19.15","start":12019015,"end":12019015,"break":"none","ruby":[[8,1,"しゅ"],[10,1,"まえ"],[12,1,"いの"],[15,1,"い"],[25,1,"うえ"],[27,1,"ざ"],[40,1,"かみ"],[42,1,"しゅ"],[45,1,"ち"],[51,1,"くに"],[65,1,"かみ"],[79,1,"てん"],[81,1,"ち"],[83,1,"つく"]],"text":"そしてヒゼキヤは主の前に祈って言った、「ケルビムの上に座しておられるイスラエルの神、主よ、地のすべての国のうちで、ただあなただけが神でいらせられます。あなたは天と地を造られました。"},{"ref":"2Kgs.19.16","start":12019016,"end":12019016,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"みみ"],[5,1,"かたむ"],[8,1,"き"],[16,1,"しゅ"],[19,1,"め"],[21,1,"ひら"],[38,1,"い"],[41,1,"かみ"],[49,1,"か"],[51,1,"おく"],[54,2,"ことば"],[58,1,"き"]],"text":"主よ、耳を傾けて聞いてください。主よ、目を開いてごらんください。セナケリブが生ける神をそしるために書き送った言葉をお聞きください。"},{"ref":"2Kgs.19.17","start":12019017,"end":12019017,"break":"none","ruby":[[0,1,"しゅ"],[13,1,"おう"],[22,1,"たみ"],[26,2,"くにぐに"],[29,1,"ほろ"]],"text":"主よ、まことにアッスリヤの王たちはもろもろの民とその国々を滅ぼし、"},{"ref":"2Kgs.19.18","start":12019018,"end":12019018,"break":"none","ruby":[[4,2,"かみがみ"],[7,1,"ひ"],[9,1,"な"],[11,1,"い"],[21,1,"かみ"],[27,1,"ひと"],[29,1,"て"],[31,1,"つく"],[38,1,"き"],[40,1,"いし"],[44,1,"ほろ"]],"text":"またその神々を火に投げ入れました。それらは神ではなく、人の手の作ったもので、木や石だから滅ぼされたのです。"},{"ref":"2Kgs.19.19","start":12019019,"end":12019019,"break":"none","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[14,1,"いま"],[20,1,"かれ"],[22,1,"て"],[25,1,"すく"],[27,1,"だ"],[40,1,"ち"],[42,2,"くにぐに"],[45,1,"みな"],[47,1,"しゅ"],[57,1,"かみ"],[68,1,"し"]],"text":"われわれの神、主よ、どうぞ、今われわれを彼の手から救い出してください。そうすれば地の国々は皆、主であるあなただけが神でいらせられることを知るようになるでしょう」。"},{"ref":"2Kgs.19.20","start":12019020,"end":12019020,"break":"none","ruby":[[2,1,"とき"],[7,1,"こ"],[12,1,"ひと"],[24,1,"い"],[35,1,"かみ"],[37,1,"しゅ"],[41,1,"おお"],[54,1,"おう"],[72,1,"いの"],[78,1,"き"]],"text":"その時アモツの子イザヤは人をつかわしてヒゼキヤに言った、「イスラエルの神、主はこう仰せられる、『アッスリヤの王セナケリブについてあなたがわたしに祈ったことは聞いた』。"},{"ref":"2Kgs.19.21","start":12019021,"end":12019021,"break":"none","breaks":[[20,"stanza"],[32,"line"],[48,"line"],[56,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[7,1,"かた"],[11,2,"ことば"],[21,2,"しょじょ"],[30,1,"むすめ"],[36,1,"あなど"],[54,1,"むすめ"],[64,1,"あたま"],[66,1,"ふ"]],"text":"主が彼について語られた言葉はこうである、『処女であるシオンの娘はあなたを侮り、あなたをあざける。エルサレムの娘はあなたのうしろで頭を振る。"},{"ref":"2Kgs.19.22","start":12019022,"end":12019022,"break":"line","breaks":[[22,"line"],[38,"line"],[48,"line"]],"ruby":[[33,1,"こえ"],[38,1,"め"],[40,1,"たか"],[54,2,"せいじゃ"]],"text":"あなたはだれをそしり、だれをののしったのか。あなたはだれにむかって声をあげ、目を高くあげたのか。イスラエルの聖者にむかってしたのだ。"},{"ref":"2Kgs.19.23","start":12019023,"end":12019023,"break":"line","breaks":[[20,"line"],[44,"line"],[54,"line"],[76,"line"],[89,"line"]],"ruby":[[4,2,"ししゃ"],[10,1,"しゅ"],[16,1,"い"],[25,1,"おお"],[28,2,"せんしゃ"],[35,2,"やまやま"],[38,1,"いただき"],[49,1,"おく"],[51,1,"い"],[57,1,"たか"],[59,2,"こうはく"],[62,1,"もっと"],[64,1,"よ"],[71,1,"き"],[73,1,"たお"],[80,1,"はて"],[82,2,"やえい"],[84,1,"ち"],[86,1,"い"],[91,2,"みつりん"]],"text":"あなたは使者をもって主をそしって言った、「わたしは多くの戦車をひきいて山々の頂にのぼり、レバノンの奥に行き、たけの高い香柏と最も良いいとすぎを切り倒し、またその果の野営地に行き、その密林にはいった。"},{"ref":"2Kgs.19.24","start":12019024,"end":12019024,"break":"line","breaks":[[19,"line"],[28,"line"]],"ruby":[[4,2,"いど"],[7,1,"ほ"],[10,2,"がいこく"],[13,1,"みず"],[15,1,"の"],[23,1,"あし"],[25,1,"うら"],[37,1,"かわ"],[39,1,"ふ"]],"text":"わたしは井戸を掘って外国の水を飲んだ。わたしは足の裏で、エジプトのすべての川を踏みからした」。"},{"ref":"2Kgs.19.25","start":12019025,"end":12019025,"break":"line","breaks":[[12,"line"],[27,"line"],[46,"line"],[62,"line"]],"ruby":[[4,1,"き"],[12,1,"むかし"],[20,1,"さだ"],[27,2,"けんご"],[30,2,"まちまち"],[37,2,"あらつか"],[51,1,"ひ"],[58,2,"けいかく"],[62,1,"いま"]],"text":"あなたは聞かなかったか、昔わたしがこれを定めたことを。堅固な町々をあなたが荒塚とすることも、いにしえの日からわたしが計画して今これをおこなうのだ。"},{"ref":"2Kgs.19.26","start":12019026,"end":12019026,"break":"line","breaks":[[24,"line"],[41,"line"]],"ruby":[[5,1,"す"],[7,1,"たみ"],[9,1,"ちから"],[10,1,"よわ"],[17,1,"はじ"],[24,1,"の"],[26,1,"くさ"],[32,2,"あおな"],[41,1,"そだ"],[46,1,"か"],[49,2,"やね"],[52,1,"くさ"]],"text":"そのうちに住む民は力弱くおののき、恥をいだいて、野の草のように、青菜のようになり、育たないで枯れる屋根の草のようになった。"},{"ref":"2Kgs.19.27","start":12019027,"end":12019027,"break":"line","breaks":[[22,"line"]],"ruby":[[14,2,"でい"],[30,1,"いか"],[32,1,"さけ"],[39,1,"し"]],"text":"わたしはあなたのすわること、出入りすること、わたしにむかって怒り叫んだことをも知っている。"},{"ref":"2Kgs.19.28","start":12019028,"end":12019028,"break":"line","breaks":[[21,"line"],[41,"line"],[56,"line"],[70,"line"]],"ruby":[[12,1,"いか"],[14,1,"さけ"],[25,2,"こうまん"],[32,1,"みみ"],[49,1,"はな"],[51,1,"わ"],[60,1,"くち"],[78,1,"みち"],[80,1,"ひ"]],"text":"あなたがわたしにむかって怒り叫んだことと、あなたの高慢がわたしの耳にはいったため、わたしはあなたの鼻に輪をつけ、あなたの口にくつわをはめて、あなたをもときた道へ引きもどすであろう』。"},{"ref":"2Kgs.19.29","start":12019029,"end":12019029,"break":"paragraph","ruby":[[5,1,"あた"],[27,1,"お"],[29,1,"ぼ"],[38,1,"た"],[42,1,"ねん"],[43,1,"め"],[50,1,"お"],[52,1,"ぼ"],[61,1,"た"],[65,1,"ねん"],[66,1,"め"],[69,1,"たね"],[74,1,"か"],[76,1,"い"],[82,1,"はたけ"],[84,1,"つく"],[89,1,"み"],[91,1,"た"]],"text":"『あなたに与えるしるしはこれである。すなわち、ことしは落ち穂からはえたものを食べ、二年目にはまたその落ち穂からはえたものを食べ、三年目には種をまき、刈り入れ、ぶどう畑を作ってその実を食べるであろう。"},{"ref":"2Kgs.19.30","start":12019030,"end":12019030,"break":"none","ruby":[[3,1,"いえ"],[9,1,"のこ"],[11,1,"もの"],[13,1,"ふたた"],[15,1,"した"],[17,1,"ね"],[19,1,"は"],[22,1,"うえ"],[24,1,"み"],[26,1,"むす"]],"text":"ユダの家ののがれて残る者は再び下に根を張り、上に実を結ぶであろう。"},{"ref":"2Kgs.19.31","start":12019031,"end":12019031,"break":"none","ruby":[[4,1,"のこ"],[6,1,"もの"],[15,1,"で"],[23,1,"もの"],[29,1,"やま"],[32,1,"で"],[34,1,"く"],[41,1,"しゅ"],[43,2,"ねっしん"]],"text":"すなわち残る者がエルサレムから出てき、のがれた者がシオンの山から出て来るであろう。主の熱心がこれをされるであろう』。"},{"ref":"2Kgs.19.32","start":12019032,"end":12019032,"break":"paragraph","ruby":[[5,1,"しゅ"],[13,1,"おう"],[21,1,"おお"],[28,1,"かれ"],[32,1,"まち"],[43,1,"や"],[45,1,"はな"],[50,1,"たて"],[57,1,"まえ"],[59,1,"く"],[68,1,"るい"],[70,1,"きず"],[76,1,"せ"]],"text":"それゆえ、主はアッスリヤの王について、こう仰せられる、『彼はこの町にこない、またここに矢を放たない、盾をもってその前に来ることなく、また塁を築いてこれを攻めることはない。"},{"ref":"2Kgs.19.33","start":12019033,"end":12019033,"break":"none","ruby":[[0,1,"かれ"],[2,1,"き"],[4,1,"みち"],[6,1,"かえ"],[12,1,"まち"],[24,1,"しゅ"],[29,1,"い"]],"text":"彼は来た道を帰って、この町に、はいることはない。主がこれを言う。"},{"ref":"2Kgs.19.34","start":12019034,"end":12019034,"break":"none","ruby":[[4,2,"じぶん"],[28,1,"まち"],[30,1,"まも"],[37,1,"すく"]],"text":"わたしは自分のため、またわたしのしもべダビデのためにこの町を守って、これを救うであろう』」。"},{"ref":"2Kgs.19.35","start":12019035,"end":12019035,"break":"paragraph","ruby":[[2,1,"よる"],[4,1,"しゅ"],[6,1,"つかい"],[8,1,"で"],[17,2,"じんえい"],[25,1,"にん"],[27,1,"う"],[29,1,"ころ"],[33,2,"ひとびと"],[36,1,"あさ"],[37,1,"はや"],[39,1,"お"],[42,1,"み"],[46,1,"かれ"],[49,1,"みな"],[51,2,"したい"]],"text":"その夜、主の使が出て、アッスリヤの陣営で十八万五千人を撃ち殺した。人々が朝早く起きて見ると、彼らは皆、死体となっていた。"},{"ref":"2Kgs.19.36","start":12019036,"end":12019036,"break":"none","ruby":[[6,1,"おう"],[13,1,"た"],[15,1,"さ"],[18,1,"かえ"],[21,1,"い"]],"text":"アッスリヤの王セナケリブは立ち去り、帰って行ってニネベにいたが、"},{"ref":"2Kgs.19.37","start":12019037,"end":12019037,"break":"none","ruby":[[2,1,"かみ"],[8,2,"しんでん"],[11,2,"れいはい"],[17,1,"とき"],[21,1,"こ"],[44,1,"かれ"],[46,1,"ころ"],[57,1,"ち"],[59,1,"に"],[62,1,"い"],[71,1,"こ"],[79,1,"かわ"],[82,1,"おう"]],"text":"その神ニスロクの神殿で礼拝していた時、その子アデランメレクとシャレゼルが、つるぎをもって彼を殺し、ともにアララテの地へ逃げて行った。そこでその子エサルハドンが代って王となった。"}]