[{"ref":"Num.12.1","start":4012001,"end":4012001,"break":"paragraph","ruby":[[7,1,"おんな"],[22,1,"おんな"],[48,2,"ひなん"]],"text":"モーセはクシの女をめとっていたが、そのクシの女をめとったゆえをもって、ミリアムとアロンはモーセを非難した。"},{"ref":"Num.12.2","start":4012002,"end":4012002,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[8,1,"しゅ"],[19,1,"かた"],[35,1,"かた"],[48,1,"しゅ"],[53,1,"き"]],"text":"彼らは言った、「主はただモーセによって語られるのか。われわれによっても語られるのではないのか」。主はこれを聞かれた。"},{"ref":"Num.12.3","start":4012003,"end":4012003,"break":"none","ruby":[[6,1,"ひと"],[10,2,"にゅうわ"],[16,2,"ちじょう"],[23,1,"ひと"]],"text":"モーセはその人となり柔和なこと、地上のすべての人にまさっていた。"},{"ref":"Num.12.4","start":4012004,"end":4012004,"break":"none","ruby":[[4,1,"しゅ"],[6,2,"とつぜん"],[35,1,"にん"],[37,2,"かいけん"],[40,2,"まくや"],[43,1,"で"],[51,1,"い"],[58,1,"かれ"],[61,1,"にん"],[63,1,"で"]],"text":"そこで、主は突然モーセとアロン、およびミリアムにむかって「あなたがた三人、会見の幕屋に出てきなさい」と言われたので、彼ら三人は出てきたが、"},{"ref":"Num.12.5","start":4012005,"end":4012005,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"くも"],[4,1,"はしら"],[12,1,"くだ"],[15,2,"まくや"],[18,2,"いりぐち"],[21,1,"た"],[34,1,"よ"],[39,1,"かれ"],[45,1,"すす"],[47,1,"で"]],"text":"主は雲の柱のうちにあって下り、幕屋の入口に立って、アロンとミリアムを呼ばれた。彼らふたりが進み出ると、"},{"ref":"Num.12.6","start":4012006,"end":4012006,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[23,2,"ことば"],[26,1,"き"],[45,3,"よげんしゃ"],[55,1,"しゅ"],[62,1,"まぼろし"],[75,1,"し"],[81,1,"ゆめ"],[90,1,"かた"]],"text":"彼らに言われた、「あなたがたは、いま、わたしの言葉を聞きなさい。あなたがたのうちに、もし、預言者があるならば、主なるわたしは幻をもって、これにわたしを知らせ、また夢をもって、これと語るであろう。"},{"ref":"Num.12.7","start":4012007,"end":4012007,"break":"none","ruby":[[24,1,"かれ"],[30,2,"ぜんか"],[33,2,"ちゅうしん"],[37,1,"もの"]],"text":"しかし、わたしのしもべモーセとは、そうではない。彼はわたしの全家に忠信なる者である。"},{"ref":"Num.12.8","start":4012008,"end":4012008,"break":"none","ruby":[[0,1,"かれ"],[8,1,"くち"],[12,1,"かた"],[15,1,"あき"],[19,1,"い"],[26,1,"つか"],[31,1,"かれ"],[35,1,"しゅ"],[37,1,"かたち"],[39,1,"み"],[66,1,"おそ"],[69,2,"ひなん"]],"text":"彼とは、わたしは口ずから語り、明らかに言って、なぞを使わない。彼はまた主の形を見るのである。なぜ、あなたがたはわたしのしもべモーセを恐れず非難するのか」。"},{"ref":"Num.12.9","start":4012009,"end":4012009,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[8,1,"いか"],[11,1,"はっ"],[14,1,"さ"]],"text":"主は彼らにむかい怒りを発して去られた。"},{"ref":"Num.12.10","start":4012010,"end":4012010,"break":"none","ruby":[[0,1,"くも"],[2,2,"まくや"],[5,1,"うえ"],[7,1,"はな"],[9,1,"さ"],[12,1,"とき"],[22,1,"びょう"],[29,1,"み"],[31,1,"ゆき"],[36,1,"しろ"],[48,1,"かえ"],[56,1,"み"],[60,2,"かのじょ"],[65,1,"びょう"]],"text":"雲が幕屋の上を離れ去った時、ミリアムは、らい病となり、その身は雪のように白くなった。アロンがふり返ってミリアムを見ると、彼女はらい病になっていた。"},{"ref":"Num.12.11","start":4012011,"end":4012011,"break":"none","ruby":[[12,1,"い"],[22,1,"しゅ"],[31,1,"おろ"],[39,1,"つみ"],[41,1,"おか"],[53,1,"ばつ"],[61,1,"う"]],"text":"そこで、アロンはモーセに言った、「ああ、わが主よ、わたしたちは愚かなことをして罪を犯しました。どうぞ、その罰をわたしたちに受けさせないでください。"},{"ref":"Num.12.12","start":4012012,"end":4012012,"break":"none","ruby":[[3,2,"かのじょ"],[6,1,"はは"],[8,1,"たい"],[11,1,"にく"],[13,1,"なか"],[15,1,"ほろ"],[20,1,"で"],[22,2,"しにん"]],"text":"どうぞ彼女を母の胎から肉が半ば滅びうせて出る死人のようにしないでください」。"},{"ref":"Num.12.13","start":4012013,"end":4012013,"break":"none","ruby":[[2,1,"とき"],[7,1,"しゅ"],[9,1,"よ"],[14,1,"い"],[22,1,"かみ"],[28,2,"かのじょ"]],"text":"その時モーセは主に呼ばわって言った、「ああ、神よ、どうぞ彼女をいやしてください」。"},{"ref":"Num.12.14","start":4012014,"end":4012014,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,2,"かのじょ"],[15,1,"ちち"],[17,2,"かのじょ"],[20,1,"かお"],[30,2,"かのじょ"],[33,2,"なぬか"],[40,1,"は"],[43,1,"み"],[45,1,"かく"],[53,2,"かのじょ"],[56,2,"なぬか"],[63,2,"しゅくえい"],[66,1,"そと"],[68,1,"と"],[86,1,"のち"],[88,1,"つ"]],"text":"主はモーセに言われた、「彼女の父が彼女の顔につばきしてさえ、彼女は七日のあいだ、恥じて身を隠すではないか。彼女を七日のあいだ、宿営の外で閉じこめておかなければならない。その後、連れもどしてもよい」。"},{"ref":"Num.12.15","start":4012015,"end":4012015,"break":"none","ruby":[[8,2,"なぬか"],[15,2,"しゅくえい"],[18,1,"そと"],[20,1,"と"],[28,1,"たみ"],[35,1,"つ"],[46,1,"みち"],[48,1,"すす"]],"text":"そこでミリアムは七日のあいだ、宿営の外で閉じこめられた。民はミリアムが連れもどされるまでは、道に進まなかった。"},{"ref":"Num.12.16","start":4012016,"end":4012016,"break":"none","ruby":[[2,1,"のち"],[4,1,"たみ"],[11,1,"た"],[14,1,"すす"],[21,2,"あらの"],[24,2,"しゅくえい"]],"text":"その後、民はハゼロテを立って進み、パランの荒野に宿営した。"}]