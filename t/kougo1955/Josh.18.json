[{"ref":"Josh.18.1","start":6018001,"end":6018001,"break":"paragraph","ruby":[[9,2,"ひとびと"],[12,1,"ぜん"],[13,2,"かいしゅう"],[19,1,"ち"],[21,2,"せいふく"],[31,1,"あつ"],[38,2,"かいけん"],[41,2,"まくや"],[44,1,"た"]],"text":"そこでイスラエルの人々の全会衆は、その地を征服したので、シロに集まり、そこに会見の幕屋を立てた。"},{"ref":"Josh.18.2","start":6018002,"end":6018002,"break":"paragraph","ruby":[[2,1,"とき"],[10,2,"ひとびと"],[19,1,"し"],[20,1,"ぎょう"],[22,1,"わ"],[25,1,"と"],[29,2,"ぶぞく"],[35,1,"のこ"]],"text":"その時、イスラエルの人々のうちに、まだ嗣業を分かち取らない部族が、七つ残っていたので、"},{"ref":"Josh.18.3","start":6018003,"end":6018003,"break":"none","ruby":[[11,2,"ひとびと"],[14,1,"い"],[26,2,"せんぞ"],[29,1,"かみ"],[31,1,"しゅ"],[40,1,"あた"],[45,1,"ち"],[47,1,"と"],[50,1,"い"],[59,1,"おこた"]],"text":"ヨシュアはイスラエルの人々に言った、「あなたがたは、先祖の神、主が、あなたがたに与えられた地を取りに行くのを、いつまで怠っているのですか。"},{"ref":"Josh.18.4","start":6018004,"end":6018004,"break":"none","ruby":[[0,2,"ぶぞく"],[6,1,"にん"],[10,1,"だ"],[22,2,"ひとびと"],[34,1,"かれ"],[37,1,"た"],[46,1,"ち"],[48,1,"い"],[50,1,"めぐ"],[58,1,"し"],[59,1,"ぎょう"],[68,2,"ずめん"],[82,1,"も"]],"text":"部族ごとに三人ずつを出しなさい。わたしはその人々をつかわしましょう。彼らは立っていって、その地を行き巡り、おのおのの嗣業のために、それを図面にして、わたしのところへ持ってこなければならない。"},{"ref":"Josh.18.5","start":6018005,"end":6018005,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ち"],[10,2,"ぶぶん"],[13,1,"わ"],[27,1,"みなみ"],[31,2,"りょうち"],[43,1,"いえ"],[45,1,"きた"],[49,2,"りょうち"]],"text":"彼らはその地を七つの部分に分けなければならない。ユダは南のその領地にとどまり、ヨセフの家は北のその領地にとどまらなければならない。"},{"ref":"Josh.18.6","start":6018006,"end":6018006,"break":"none","ruby":[[9,1,"ち"],[14,1,"わ"],[18,2,"ずめん"],[38,1,"も"],[64,1,"かみ"],[66,1,"しゅ"],[68,1,"まえ"],[84,1,"ひ"]],"text":"あなたがたは、その地を七つに分けて、図面にし、それをここに、わたしのところへ持ってこなければならない。わたしはここで、われわれの神、主の前に、あなたがたのために、くじを引くであろう。"},{"ref":"Josh.18.7","start":6018007,"end":6018007,"break":"none","ruby":[[15,1,"なに"],[17,1,"ぶん"],[20,1,"も"],[25,1,"しゅ"],[27,2,"さいし"],[35,1,"かれ"],[38,1,"し"],[39,1,"ぎょう"],[60,1,"はん"],[61,2,"ぶぞく"],[71,1,"む"],[74,1,"がわ"],[76,1,"ひがし"],[78,1,"ほう"],[86,1,"し"],[87,1,"ぎょう"],[89,1,"う"],[96,1,"しゅ"],[106,1,"かれ"],[109,1,"あた"]],"text":"レビびとは、あなたがたのうちに何の分をも持たない。主の祭司たることが、彼らの嗣業だからである。またガドとルベンとマナセの半部族とは、ヨルダンの向こう側、東の方で、すでにその嗣業を受けた。それは主のしもべモーセが、彼らに与えたものである」。"},{"ref":"Josh.18.8","start":6018008,"end":6018008,"break":"paragraph","ruby":[[5,2,"ひとびと"],[8,1,"た"],[11,1,"い"],[17,1,"ち"],[19,2,"ずめん"],[22,1,"つく"],[27,1,"で"],[29,1,"い"],[31,2,"ひとびと"],[40,1,"めい"],[43,1,"い"],[54,1,"い"],[60,1,"ち"],[62,1,"い"],[64,1,"めぐ"],[70,2,"ずめん"],[84,1,"も"],[87,1,"かえ"],[101,1,"しゅ"],[103,1,"まえ"],[122,1,"ひ"]],"text":"そこでその人々は立って行った。その地の図面を作るために出て行く人々に、ヨシュアは命じて言った、「あなたがたは行って、その地を行き巡り、それを図面にして、わたしのところに持って帰りなさい。わたしはシロで、主の前に、あなたがたのために、ここでくじを引きましょう」。"},{"ref":"Josh.18.9","start":6018009,"end":6018009,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"い"],[15,1,"ち"],[17,1,"へ"],[22,2,"まちまち"],[37,2,"ぶぶん"],[42,2,"ずめん"],[48,2,"しょもつ"],[51,1,"か"],[60,2,"しゅくえい"],[73,1,"も"]],"text":"こうしてその人々は行って、その地を経めぐり、町々にしたがって、それを七つの部分とし、図面にして、書物に書きしるし、シロの宿営におるヨシュアのもとへ持ってきた。"},{"ref":"Josh.18.10","start":6018010,"end":6018010,"break":"none","ruby":[[9,1,"かれ"],[15,1,"しゅ"],[17,1,"まえ"],[23,1,"ひ"],[37,1,"ところ"],[46,2,"ひとびと"],[55,1,"ぶん"],[60,1,"ち"],[62,1,"わ"],[64,1,"あた"]],"text":"ヨシュアはシロで、彼らのために主の前に、くじを引いた。そしてヨシュアはその所で、イスラエルの人々に、それぞれの分として、地を分け与えた。"},{"ref":"Josh.18.11","start":6018011,"end":6018011,"break":"paragraph","ruby":[[8,2,"しそん"],[11,2,"ぶぞく"],[20,2,"かぞく"],[32,1,"ひ"],[47,1,"え"],[49,2,"りょうち"],[56,2,"しそん"],[64,2,"しそん"],[68,1,"あいだ"]],"text":"まずベニヤミンの子孫の部族のために、その家族にしたがって、くじを引いた。そしてそのくじによって獲た領地は、ユダの子孫と、ヨセフの子孫との間にあった。"},{"ref":"Josh.18.12","start":6018012,"end":6018012,"break":"none","ruby":[[7,1,"きた"],[9,1,"ほう"],[11,1,"さかい"],[19,1,"はじ"],[27,1,"きた"],[32,1,"のぼ"],[37,1,"にし"],[39,1,"ほう"],[41,2,"さんち"],[48,1,"のぼ"],[57,2,"あらの"],[60,1,"たっ"],[63,1,"つ"]],"text":"すなわち、その北の方の境は、ヨルダンに始まり、エリコの北のわきに上り、また西の方の山地をとおって上り、ベテアベンの荒野に達して尽きる。"},{"ref":"Josh.18.13","start":6018013,"end":6018013,"break":"none","ruby":[[7,1,"さかい"],[12,1,"すす"],[18,1,"みなみ"],[23,1,"いた"],[41,1,"さかい"],[43,1,"した"],[50,1,"みなみ"],[52,1,"やま"],[65,1,"くだ"]],"text":"そこから、その境はルズに進み、ルズの南のわきに至る。ルズはベテルである。ついでその境は下ベテホロンの南の山にあるアタロテ・アダルに下り、"},{"ref":"Josh.18.14","start":6018014,"end":6018014,"break":"none","ruby":[[0,1,"にし"],[2,1,"ほう"],[12,1,"みなみ"],[16,1,"やま"],[19,1,"みなみ"],[21,1,"まが"],[27,2,"しそん"],[30,1,"まち"],[40,1,"いた"],[43,1,"つ"],[71,1,"にし"],[73,1,"ほう"],[75,1,"さかい"]],"text":"西の方では、ベテホロンの南にある山から南に曲り、ユダの子孫の町キリアテ・バアルに至って尽きる。キリアテ・バアルはキリアテ・ヤリムである。これが西の方の境であった。"},{"ref":"Josh.18.15","start":6018015,"end":6018015,"break":"none","ruby":[[2,1,"みなみ"],[4,1,"ほう"],[16,1,"はし"],[18,1,"はじ"],[24,1,"さかい"],[45,1,"みず"],[47,1,"みなもと"],[49,1,"いた"]],"text":"また南の方は、キリアテ・ヤリムの端に始まり、その境はそこからエフロンにおもむき、ネフトアの水の源に至り、"},{"ref":"Josh.18.16","start":6018016,"end":6018016,"break":"none","ruby":[[5,1,"さかい"],[13,1,"たに"],[15,1,"きた"],[17,1,"はし"],[28,1,"たに"],[30,1,"み"],[34,1,"やま"],[36,1,"はし"],[38,1,"くだ"],[41,1,"すす"],[53,1,"みなみ"],[60,1,"たに"],[62,1,"くだ"],[65,2,"また"],[67,1,"した"],[76,1,"いた"]],"text":"ついでその境は、レパイムの谷の北の端にあるベンヒンノムの谷を見おろす山の端に下り、進んでエブスびとのわきの南、ヒンノムの谷に下り、また下ってエンロゲルに至り、"},{"ref":"Josh.18.17","start":6018017,"end":6018017,"break":"none","ruby":[[0,1,"きた"],[2,1,"まが"],[21,1,"さか"],[23,1,"たい"],[45,1,"いし"],[47,1,"くだ"]],"text":"北に曲ってエンシメシにおもむき、アドミムの坂に対するゲリロテにおもむき、ルベンびとボハンの石に下り、"},{"ref":"Josh.18.18","start":6018018,"end":6018018,"break":"none","ruby":[[9,1,"きた"],[11,1,"すす"],[19,1,"くだ"]],"text":"ベテアラバのわきを北に進んで、アラバに下り、"},{"ref":"Josh.18.19","start":6018019,"end":6018019,"break":"none","ruby":[[2,1,"さかい"],[11,1,"きた"],[16,1,"すす"],[24,2,"なんたん"],[28,1,"しお"],[30,1,"うみ"],[32,1,"きた"],[34,2,"いりうみ"],[37,1,"いた"],[40,1,"つ"],[47,1,"みなみ"],[49,1,"さかい"]],"text":"その境は、ベテホグラの北のわきに進み、ヨルダンの南端で、塩の海の北の入海に至って尽きる。これが南の境である。"},{"ref":"Josh.18.20","start":6018020,"end":6018020,"break":"none","ruby":[[5,1,"ひがし"],[7,1,"ほう"],[9,1,"さかい"],[26,2,"しそん"],[32,2,"かぞく"],[40,1,"え"],[42,1,"し"],[43,1,"ぎょう"],[45,2,"しほう"],[48,1,"さかい"]],"text":"ヨルダンは東の方の境となっていた。これがベニヤミンの子孫の、その家族にしたがって獲た嗣業の四方の境である。"},{"ref":"Josh.18.21","start":6018021,"end":6018021,"break":"paragraph","ruby":[[6,2,"しそん"],[9,2,"ぶぞく"],[15,2,"かぞく"],[23,1,"え"],[25,2,"まちまち"]],"text":"ベニヤミンの子孫の部族が、その家族にしたがって獲た町々は、エリコ、ベテホグラ、エメクケジツ、"},{"ref":"Josh.18.22","start":6018022,"end":6018022,"break":"none","text":"ベテアラバ、ゼマライム、ベテル、"},{"ref":"Josh.18.23","start":6018023,"end":6018023,"break":"none","text":"アビム、パラ、オフラ、"},{"ref":"Josh.18.24","start":6018024,"end":6018024,"break":"none","ruby":[[23,2,"まちまち"],[30,1,"ぞく"],[33,2,"むらむら"]],"text":"ケパル・アンモニ、オフニ、ゲバ。すなわち十二の町々と、それに属する村々。"},{"ref":"Josh.18.25","start":6018025,"end":6018025,"break":"none","text":"またギベオン、ラマ、ベエロテ、"},{"ref":"Josh.18.26","start":6018026,"end":6018026,"break":"none","text":"ミヅパ、ケピラ、モザ、"},{"ref":"Josh.18.27","start":6018027,"end":6018027,"break":"none","text":"レケム、イルピエル、タララ、"},{"ref":"Josh.18.28","start":6018028,"end":6018028,"break":"none","ruby":[[40,2,"まちまち"],[47,1,"ぞく"],[50,2,"むらむら"],[62,2,"しそん"],[68,2,"かぞく"],[76,1,"え"],[78,1,"し"],[79,1,"ぎょう"]],"text":"ゼラ、エレフ、エブスすなわちエルサレム、ギベア、キリアテ・ヤリム。すなわち十四の町々と、それに属する村々。これがベニヤミンの子孫の、その家族にしたがって獲た嗣業である。"}]