[{"ref":"Ps.90.1","start":19090001,"end":19090001,"break":"paragraph","title":"神の人モーセの祈","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"よよ"]],"titleRuby":[[0,1,"かみ"],[2,1,"ひと"],[7,1,"いのり"]],"text":"主よ、あなたは世々われらのすみかでいらせられる。"},{"ref":"Ps.90.2","start":19090002,"end":19090002,"break":"line","breaks":[[8,"line"],[30,"line"],[43,"line"]],"ruby":[[0,1,"やま"],[4,1,"うま"],[14,1,"ち"],[16,2,"せかい"],[20,1,"つく"],[47,1,"かみ"]],"text":"山がまだ生れず、あなたがまだ地と世界とを造られなかったとき、とこしえからとこしえまで、あなたは神でいらせられる。"},{"ref":"Ps.90.3","start":19090003,"end":19090003,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"ひと"],[9,1,"かえ"],[13,1,"い"],[20,1,"ひと"],[22,1,"こ"],[25,1,"かえ"]],"text":"あなたは人をちりに帰らせて言われます、「人の子よ、帰れ」と。"},{"ref":"Ps.90.4","start":19090004,"end":19090004,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[4,1,"め"],[6,1,"まえ"],[10,1,"ねん"],[12,1,"す"],[14,1,"さ"],[25,1,"よ"],[27,1,"ま"],[31,1,"とき"]],"text":"あなたの目の前には千年も過ぎ去ればきのうのごとく、夜の間のひと時のようです。"},{"ref":"Ps.90.5","start":19090005,"end":19090005,"break":"line","breaks":[[22,"line"],[35,"line"]],"ruby":[[4,1,"ひと"],[6,2,"おおみず"],[12,1,"なが"],[14,1,"さ"],[22,1,"かれ"],[27,1,"よ"],[29,1,"ゆめ"],[43,2,"あおくさ"]],"text":"あなたは人を大水のように流れ去らせられます。彼らはひと夜の夢のごとく、あしたにもえでる青草のようです。"},{"ref":"Ps.90.6","start":19090006,"end":19090006,"break":"line","breaks":[[14,"line"]],"ruby":[[9,1,"さか"],[14,1,"ゆう"],[23,1,"か"]],"text":"あしたにもえでて、栄えるが、夕べには、しおれて枯れるのです。"},{"ref":"Ps.90.7","start":19090007,"end":19090007,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"いか"],[14,1,"き"],[23,1,"いきどお"],[29,1,"ほろ"],[31,1,"さ"]],"text":"われらはあなたの怒りによって消えうせ、あなたの憤りによって滅び去るのです。"},{"ref":"Ps.90.8","start":19090008,"end":19090008,"break":"line","breaks":[[17,"line"]],"ruby":[[8,2,"ふぎ"],[12,1,"まえ"],[21,1,"かく"],[24,1,"つみ"],[27,1,"かお"],[29,1,"ひかり"]],"text":"あなたはわれらの不義をみ前におき、われらの隠れた罪をみ顔の光のなかにおかれました。"},{"ref":"Ps.90.9","start":19090009,"end":19090009,"break":"line","breaks":[[11,"line"],[26,"line"]],"ruby":[[8,1,"ひ"],[15,1,"いか"],[21,1,"す"],[23,1,"さ"],[30,1,"とし"],[32,1,"つ"],[40,1,"いき"]],"text":"われらのすべての日は、あなたの怒りによって過ぎ去り、われらの年の尽きるのは、ひと息のようです。"},{"ref":"Ps.90.10","start":19090010,"end":19090010,"break":"line","breaks":[[18,"line"],[38,"line"],[61,"line"]],"ruby":[[10,1,"ねん"],[22,1,"すこ"],[32,1,"ねん"],[43,2,"いっしょう"],[54,1,"なや"],[63,1,"す"],[70,1,"はや"],[77,1,"と"],[79,1,"さ"]],"text":"われらのよわいは七十年にすぎません。あるいは健やかであっても八十年でしょう。しかしその一生はただ、ほねおりと悩みであって、その過ぎゆくことは速く、われらは飛び去るのです。"},{"ref":"Ps.90.11","start":19090011,"end":19090011,"break":"line","breaks":[[20,"line"],[39,"line"]],"ruby":[[7,1,"いか"],[10,1,"ちから"],[12,1,"し"],[31,1,"おそ"],[43,1,"いきどお"],[46,1,"し"]],"text":"だれがあなたの怒りの力を知るでしょうか。だれがあなたをおそれる恐れにしたがってあなたの憤りを知るでしょうか。"},{"ref":"Ps.90.12","start":19090012,"end":19090012,"break":"line","breaks":[[19,"line"]],"ruby":[[7,1,"ひ"],[9,1,"かぞ"],[15,1,"おし"],[19,2,"ちえ"],[22,1,"こころ"],[24,1,"え"]],"text":"われらにおのが日を数えることを教えて、知恵の心を得させてください。"},{"ref":"Ps.90.13","start":19090013,"end":19090013,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"こころ"],[6,1,"か"],[19,1,"いか"]],"text":"主よ、み心を変えてください。いつまでお怒りになるのですか。あなたのしもべをあわれんでください。"},{"ref":"Ps.90.14","start":19090014,"end":19090014,"break":"line","breaks":[[18,"line"],[28,"line"]],"ruby":[[22,1,"あ"],[24,1,"た"],[28,1,"よ"],[30,1,"おわ"],[34,1,"よろこ"],[36,1,"たの"]],"text":"あしたに、あなたのいつくしみをもってわれらを飽き足らせ、世を終るまで喜び楽しませてください。"},{"ref":"Ps.90.15","start":19090015,"end":19090015,"break":"line","breaks":[[20,"line"],[39,"line"]],"ruby":[[8,1,"くる"],[14,1,"おお"],[17,1,"ひ"],[24,1,"わざわい"],[29,1,"おお"],[32,1,"とし"],[35,1,"くら"],[43,1,"たの"]],"text":"あなたがわれらを苦しめられた多くの日と、われらが災にあった多くの年とに比べて、われらを楽しませてください。"},{"ref":"Ps.90.16","start":19090016,"end":19090016,"break":"line","breaks":[[19,"line"]],"ruby":[[23,2,"えいこう"],[29,1,"こ"]],"text":"あなたのみわざを、あなたのしもべらに、あなたの栄光を、その子らにあらわしてください。"},{"ref":"Ps.90.17","start":19090017,"end":19090017,"break":"line","breaks":[[22,"line"],[38,"line"],[48,"line"]],"ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"めぐ"],[16,1,"うえ"],[26,1,"て"],[36,1,"うえ"],[38,1,"さか"],[52,1,"て"],[57,1,"さか"]],"text":"われらの神、主の恵みを、われらの上にくだし、われらの手のわざを、われらの上に栄えさせてください。われらの手のわざを栄えさせてください。"}]