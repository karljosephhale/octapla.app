[{"ref":"1Kgs.7.1","start":11007001,"end":11007001,"break":"paragraph","ruby":[[7,2,"じぶん"],[10,1,"いえ"],[12,1,"た"],[19,1,"ねん"],[26,1,"いえ"],[28,2,"ぜんぶ"],[30,1,"た"],[32,1,"おわ"]],"text":"またソロモンは自分の家を建てたが、十三年かかってその家を全部建て終った。"},{"ref":"1Kgs.7.2","start":11007002,"end":11007002,"break":"paragraph","ruby":[[0,1,"かれ"],[7,1,"もり"],[9,1,"いえ"],[11,1,"た"],[15,1,"なが"],[23,1,"はば"],[31,1,"たか"],[42,1,"れつ"],[44,2,"こうはく"],[47,1,"はしら"],[54,1,"はしら"],[56,1,"うえ"],[58,2,"こうはく"],[61,1,"はり"]],"text":"彼はレバノンの森の家を建てた。長さ百キュビト、幅五十キュビト、高さ三十キュビトで、三列の香柏の柱があり、その柱の上に香柏の梁があった。"},{"ref":"1Kgs.7.3","start":11007003,"end":11007003,"break":"none","ruby":[[3,1,"ほん"],[5,1,"はしら"],[7,1,"うえ"],[11,1,"しつ"],[13,2,"こうはく"],[16,1,"いた"],[23,1,"はしら"],[25,1,"かく"],[26,1,"れつ"],[29,1,"ほん"]],"text":"四十五本の柱の上にある室は香柏の板でおおった。柱は各列十五本あった。"},{"ref":"1Kgs.7.4","start":11007004,"end":11007004,"break":"none","ruby":[[2,1,"まど"],[7,1,"れつ"],[12,1,"まど"],[14,1,"まど"],[17,1,"だん"],[19,1,"む"],[22,1,"あ"]],"text":"また窓わくが三列あって、窓と窓と三段に向かい合っていた。"},{"ref":"1Kgs.7.5","start":11007005,"end":11007005,"break":"none","ruby":[[0,2,"とぐち"],[3,1,"まど"],[7,2,"しかく"],[10,1,"わく"],[15,1,"まど"],[17,1,"まど"],[20,1,"だん"],[22,1,"む"],[25,1,"あ"]],"text":"戸口と窓はみな四角の枠をもち、窓と窓と三段に向かい合った。"},{"ref":"1Kgs.7.6","start":11007006,"end":11007006,"break":"paragraph","ruby":[[2,1,"はしら"],[4,2,"ひろま"],[7,1,"つく"],[11,1,"なが"],[20,1,"はば"],[32,1,"はしら"],[34,1,"まえ"],[39,2,"ひろま"],[47,2,"げんかん"],[50,1,"はしら"]],"text":"また柱の広間を造った。長さ五十キュビト、幅三十キュビトであった。柱の前に一つの広間があり、その玄関に柱とひさしがあった。"},{"ref":"1Kgs.7.7","start":11007007,"end":11007007,"break":"paragraph","ruby":[[11,2,"しんぱん"],[19,2,"ぎょくざ"],[22,2,"ひろま"],[29,2,"しんぱん"],[32,2,"ひろま"],[35,1,"つく"],[39,1,"ゆか"],[47,2,"こうはく"]],"text":"またソロモンはみずから審判をするために玉座の広間、すなわち審判の広間を造った。床からたるきまで香柏をもっておおった。"},{"ref":"1Kgs.7.8","start":11007008,"end":11007008,"break":"paragraph","ruby":[[5,1,"す"],[8,2,"きゅうでん"],[13,2,"ひろま"],[20,1,"た"],[22,1,"にわ"],[30,2,"ぞうさ"],[33,1,"おな"],[47,1,"かれ"],[56,1,"むすめ"],[61,1,"いえ"],[63,1,"た"],[70,2,"ひろま"],[73,1,"おな"]],"text":"ソロモンが住んだ宮殿はその広間のうしろの他の庭にあって、その造作は同じであった。ソロモンはまた彼がめとったパロの娘のために家を建てたが、その広間と同じであった。"},{"ref":"1Kgs.7.9","start":11007009,"end":11007009,"break":"paragraph","ruby":[[6,2,"ないがい"],[11,2,"どだい"],[15,1,"のき"],[21,1,"しゅ"],[23,1,"みや"],[25,1,"にわ"],[28,2,"おおにわ"],[33,2,"すんぽう"],[36,1,"あ"],[40,1,"き"],[43,1,"いし"],[58,2,"こうか"],[61,1,"いし"],[63,1,"つく"]],"text":"これらはみな内外とも、土台から軒まで、また主の宮の庭から大庭まで、寸法に合わせて切った石、すなわち、のこぎりでひいた高価な石で造られた。"},{"ref":"1Kgs.7.10","start":11007010,"end":11007010,"break":"none","ruby":[[2,2,"どだい"],[5,2,"こうか"],[8,1,"いし"],[10,1,"おお"],[13,1,"いし"],[25,1,"いし"],[33,1,"いし"]],"text":"また土台は高価な石、大きな石、すなわち八キュビトの石、十キュビトの石であった。"},{"ref":"1Kgs.7.11","start":11007011,"end":11007011,"break":"none","ruby":[[2,1,"うえ"],[5,2,"すんぽう"],[8,1,"あ"],[12,1,"き"],[15,2,"こうか"],[18,1,"いし"],[20,2,"こうはく"]],"text":"その上には寸法に合わせて切った高価な石と香柏とがあった。"},{"ref":"1Kgs.7.12","start":11007012,"end":11007012,"break":"none","ruby":[[2,2,"おおにわ"],[5,2,"しゅうい"],[14,1,"き"],[16,1,"いし"],[24,2,"こうはく"],[27,2,"かくざい"],[34,1,"しゅ"],[36,1,"みや"],[38,1,"うち"],[39,1,"にわ"],[41,2,"きゅうでん"],[44,2,"ひろま"],[47,1,"にわ"],[49,2,"ばあい"],[52,1,"おな"]],"text":"また大庭の周囲には三かさねの切り石と、一かさねの香柏の角材があった。主の宮の内庭と宮殿の広間の庭の場合と同じである。"},{"ref":"1Kgs.7.13","start":11007013,"end":11007013,"break":"paragraph","ruby":[[4,1,"おう"],[6,1,"ひと"],[21,1,"よ"]],"text":"ソロモン王は人をつかわしてツロからヒラムを呼んできた。"},{"ref":"1Kgs.7.14","start":11007014,"end":11007014,"break":"none","ruby":[[0,1,"かれ"],[7,2,"ぶぞく"],[10,2,"かふ"],[13,1,"こ"],[21,1,"ちち"],[26,1,"ひと"],[29,2,"せいどう"],[32,3,"さいくにん"],[44,2,"せいどう"],[52,2,"さいく"],[57,2,"ちえ"],[60,1,"さと"],[63,2,"ちしき"],[66,1,"み"],[69,1,"もの"],[80,1,"おう"],[95,2,"さいく"]],"text":"彼はナフタリの部族の寡婦の子であって、その父はツロの人で、青銅の細工人であった。ヒラムは青銅のいろいろな細工をする知恵と悟りと知識に満ちた者であったが、ソロモン王のところにきて、そのすべての細工をした。"},{"ref":"1Kgs.7.15","start":11007015,"end":11007015,"break":"paragraph","ruby":[[0,1,"かれ"],[2,2,"せいどう"],[5,1,"はしら"],[7,1,"ほん"],[9,1,"い"],[13,1,"ぽん"],[15,1,"はしら"],[17,1,"たか"],[33,1,"つな"],[38,1,"はか"],[50,1,"ゆび"],[52,1,"ほん"],[54,1,"あつ"],[57,2,"くうどう"],[64,1,"た"],[66,1,"はしら"],[68,1,"おな"]],"text":"彼は青銅の柱二本を鋳た。一本の柱の高さは十八キュビト、そのまわりは綱をもって測ると十二キュビトあり、指四本の厚さで空洞であった。他の柱も同じである。"},{"ref":"1Kgs.7.16","start":11007016,"end":11007016,"break":"none","ruby":[[2,2,"せいどう"],[5,1,"と"],[9,2,"ちゅうとう"],[14,1,"つく"],[17,1,"はしら"],[19,1,"いただき"],[30,2,"ちゅうとう"],[33,1,"たか"],[42,1,"た"],[44,2,"ちゅうとう"],[47,1,"たか"]],"text":"また青銅を溶かして柱頭二つを造り、柱の頂にすえた。その一つの柱頭の高さは五キュビト、他の柱頭の高さも五キュビトであった。"},{"ref":"1Kgs.7.17","start":11007017,"end":11007017,"break":"none","ruby":[[0,1,"はしら"],[2,1,"いただき"],[6,2,"ちゅうとう"],[12,1,"くさり"],[14,1,"あ"],[17,1,"かざ"],[22,2,"いちまつ"],[24,2,"もよう"],[27,1,"あみ"],[28,2,"ざいく"],[33,1,"つく"],[43,2,"ちゅうとう"],[54,2,"ちゅうとう"],[63,1,"つく"]],"text":"柱の頂にある柱頭のために鎖に編んだ飾りひもで市松模様の網細工二つを造った。すなわちこの柱頭のために一つ、かの柱頭のために一つを造った。"},{"ref":"1Kgs.7.18","start":11007018,"end":11007018,"break":"none","ruby":[[6,1,"つく"],[15,1,"なら"],[25,1,"あみ"],[26,2,"ざいく"],[29,1,"うえ"],[35,1,"つく"],[39,1,"はしら"],[41,1,"いただき"],[45,2,"ちゅうとう"],[48,1,"ま"],[52,1,"た"],[54,2,"ちゅうとう"],[58,1,"おな"]],"text":"またざくろを造った。すなわち二並びのざくろを一つの網細工の上のまわりに造って、柱の頂にある柱頭を巻いた。他の柱頭にも同じようにした。"},{"ref":"1Kgs.7.19","start":11007019,"end":11007019,"break":"none","ruby":[[2,1,"ろう"],[4,1,"はしら"],[6,1,"いただき"],[10,2,"ちゅうとう"],[13,1,"うえ"],[24,1,"はな"],[26,2,"さいく"]],"text":"この廊の柱の頂にある柱頭の上に四キュビトのゆりの花の細工があった。"},{"ref":"1Kgs.7.20","start":11007020,"end":11007020,"break":"none","ruby":[[3,1,"はしら"],[5,2,"じょうたん"],[8,1,"まる"],[10,2,"とっしゅつ"],[12,1,"ぶ"],[14,1,"うえ"],[18,1,"あみ"],[19,2,"ざいく"],[22,2,"ちゅうとう"],[25,2,"しゅうい"],[42,1,"なら"]],"text":"二つの柱の上端の丸い突出部の上にある網細工の柱頭の周囲には、おのおの二百のざくろが二並びになっていた。"},{"ref":"1Kgs.7.21","start":11007021,"end":11007021,"break":"none","ruby":[[2,1,"はしら"],[4,2,"しんでん"],[7,1,"ろう"],[9,1,"た"],[17,1,"みなみ"],[19,1,"はしら"],[21,1,"た"],[27,1,"な"],[33,1,"な"],[37,1,"きた"],[39,1,"はしら"],[41,1,"た"],[47,1,"な"],[53,1,"な"]],"text":"この柱を神殿の廊に立てた。すなわち南に柱を立てて、その名をヤキンと名づけ、北に柱を立てて、その名をボアズと名づけた。"},{"ref":"1Kgs.7.22","start":11007022,"end":11007022,"break":"none","ruby":[[2,1,"はしら"],[4,1,"いただき"],[10,1,"はな"],[12,2,"さいく"],[25,1,"はしら"],[27,2,"ぞうさ"]],"text":"その柱の頂にはゆりの花の細工があった。こうしてその柱の造作ができあがった。"},{"ref":"1Kgs.7.23","start":11007023,"end":11007023,"break":"paragraph","ruby":[[2,1,"うみ"],[4,1,"い"],[6,1,"つく"],[10,1,"ふち"],[13,1,"ふち"],[26,2,"しゅうい"],[29,2,"えんけい"],[35,1,"たか"],[46,2,"しゅうい"],[49,1,"つな"],[54,1,"はか"]],"text":"また海を鋳て造った。縁から縁まで十キュビトであって、周囲は円形をなし、高さ五キュビトで、その周囲は綱をもって測ると三十キュビトであった。"},{"ref":"1Kgs.7.24","start":11007024,"end":11007024,"break":"none","ruby":[[2,1,"ふち"],[4,1,"した"],[14,2,"しゅうい"],[28,1,"うみ"],[30,2,"しゅうい"],[33,1,"かこ"],[46,1,"なら"],[50,1,"うみ"],[52,1,"い"],[54,1,"とき"],[56,1,"い"]],"text":"その縁の下には三十キュビトの周囲をめぐるひさごがあって、海の周囲を囲んでいた。そのひさごは二並びで、海を鋳る時に鋳たものである。"},{"ref":"1Kgs.7.25","start":11007025,"end":11007025,"break":"none","ruby":[[2,1,"うみ"],[7,1,"うし"],[9,1,"うえ"],[11,1,"お"],[20,1,"きた"],[22,1,"む"],[29,1,"にし"],[31,1,"む"],[38,1,"みなみ"],[40,1,"む"],[47,1,"ひがし"],[49,1,"む"],[56,1,"うみ"],[60,1,"うえ"],[62,1,"お"],[66,1,"うし"],[72,1,"みな"],[73,1,"うち"],[75,1,"む"]],"text":"その海は十二の牛の上に置かれ、その三つは北に向かい、三つは西に向かい、三つは南に向かい、三つは東に向かっていた。海はその上に置かれ、牛のうしろは皆内に向かっていた。"},{"ref":"1Kgs.7.26","start":11007026,"end":11007026,"break":"none","ruby":[[0,1,"うみ"],[2,1,"あつ"],[5,1,"て"],[7,1,"はば"],[12,1,"ふち"],[14,1,"はい"],[16,1,"ふち"],[25,1,"はな"],[27,1,"に"],[30,1,"つく"],[35,1,"うみ"],[38,1,"みず"]],"text":"海の厚さは手の幅で、その縁は杯の縁のように、ゆりの花に似せて造られた。海には水が二千バテはいった。"},{"ref":"1Kgs.7.27","start":11007027,"end":11007027,"break":"paragraph","ruby":[[2,2,"せいどう"],[5,1,"だい"],[8,1,"こ"],[9,1,"つく"],[13,1,"だい"],[15,1,"なが"],[23,1,"はば"],[30,1,"たか"]],"text":"また青銅の台を十個造った。台は長さ四キュビト、幅四キュビト、高さ三キュビトであった。"},{"ref":"1Kgs.7.28","start":11007028,"end":11007028,"break":"none","ruby":[[2,1,"だい"],[4,2,"こうぞう"],[7,1,"つぎ"],[16,1,"だい"],[19,2,"かがみいた"],[25,2,"かがみいた"],[28,1,"わく"],[30,1,"なか"]],"text":"その台の構造は次のとおりである。台には鏡板があり、鏡板は枠の中にあった。"},{"ref":"1Kgs.7.29","start":11007029,"end":11007029,"break":"none","ruby":[[0,1,"わく"],[2,1,"なか"],[6,2,"かがみいた"],[14,1,"うし"],[31,1,"うし"],[33,1,"うえ"],[35,1,"した"],[39,1,"わく"],[41,2,"しゃめん"],[45,1,"はな"],[46,1,"かざ"],[49,2,"さいく"]],"text":"枠の中にある鏡板には、ししと牛とケルビムとがあり、また、ししと牛の上と下にある枠の斜面には花飾りが細工してあった。"},{"ref":"1Kgs.7.30","start":11007030,"end":11007030,"break":"none","ruby":[[2,1,"だい"],[12,2,"せいどう"],[15,2,"しゃりん"],[19,2,"せいどう"],[22,2,"しゃじく"],[35,2,"せんばん"],[57,1,"はな"],[58,1,"かざ"],[66,1,"い"],[68,1,"つく"]],"text":"また台にはおのおの四つの青銅の車輪と、青銅の車軸があり、その四すみには洗盤のささえがあった。そのささえは、おのおの花飾りのかたわらに鋳て造りつけてあった。"},{"ref":"1Kgs.7.31","start":11007031,"end":11007031,"break":"none","ruby":[[2,1,"くち"],[9,1,"うえ"],[11,1,"つ"],[13,1,"で"],[16,1,"だい"],[18,1,"いただき"],[20,1,"うち"],[27,1,"くち"],[29,1,"まる"],[32,2,"だいざ"],[38,1,"つく"],[42,1,"ふか"],[49,1,"はん"],[59,1,"くち"],[62,1,"ほ"],[64,1,"もの"],[72,2,"かがみいた"],[75,2,"しかく"],[79,1,"まる"]],"text":"その口は一キュビト上に突き出て、台の頂の内にあり、その口は丸く、台座のように造られ、深さ一キュビト半であった。またその口には彫り物があった。その鏡板は四角で、丸くなかった。"},{"ref":"1Kgs.7.32","start":11007032,"end":11007032,"break":"none","ruby":[[3,2,"しゃりん"],[6,2,"かがみいた"],[9,1,"した"],[14,2,"しゃじく"],[17,1,"だい"],[19,1,"と"],[21,1,"つ"],[27,2,"しゃりん"],[30,1,"たか"],[42,1,"はん"]],"text":"四つの車輪は鏡板の下にあり、車軸は台に取り付けてあり、車輪の高さはおのおの一キュビト半であった。"},{"ref":"1Kgs.7.33","start":11007033,"end":11007033,"break":"none","ruby":[[0,2,"しゃりん"],[3,2,"こうぞう"],[6,2,"せんしゃ"],[9,2,"しゃりん"],[12,2,"こうぞう"],[15,1,"おな"],[21,2,"しゃじく"],[24,1,"ふち"],[26,1,"や"],[28,1,"こしき"],[33,2,"いもの"]],"text":"車輪の構造は戦車の車輪の構造と同じで、その車軸と縁と輻と轂とはみな鋳物であった。"},{"ref":"1Kgs.7.34","start":11007034,"end":11007034,"break":"none","ruby":[[5,1,"だい"],[27,1,"だい"],[29,2,"いちぶ"]],"text":"おのおのの台の四すみに四つのささえがあり、そのささえは台の一部をなしていた。"},{"ref":"1Kgs.7.35","start":11007035,"end":11007035,"break":"none","ruby":[[0,1,"だい"],[2,1,"うえ"],[5,1,"たか"],[7,1,"はん"],[13,1,"まる"],[15,1,"おび"],[16,1,"わ"],[25,1,"だい"],[27,1,"うえ"],[33,2,"しちゅう"],[36,2,"かがみいた"],[42,2,"いちぶ"]],"text":"台の上には高さ半キュビトの丸い帯輪があった。そして台の上にあるその支柱と鏡板とはその一部をなしていた。"},{"ref":"1Kgs.7.36","start":11007036,"end":11007036,"break":"none","ruby":[[2,2,"しちゅう"],[5,2,"ひょうめん"],[8,2,"かがみいた"],[17,2,"ばしょ"],[35,1,"きざ"],[42,2,"しゅうい"],[45,1,"はな"],[46,1,"かざ"],[49,1,"ほどこ"]],"text":"その支柱の表面と鏡板にはそれぞれの場所に、ケルビムと、ししと、しゅろを刻み、またその周囲に花飾りを施した。"},{"ref":"1Kgs.7.37","start":11007037,"end":11007037,"break":"none","ruby":[[8,1,"こ"],[10,1,"だい"],[12,1,"つく"],[21,1,"おな"],[23,2,"いかた"],[26,1,"おな"],[28,2,"すんぽう"],[31,1,"おな"],[33,1,"かたち"]],"text":"このようにして十個の台を造った。それはみな同じ鋳方、同じ寸法、同じ形であった。"},{"ref":"1Kgs.7.38","start":11007038,"end":11007038,"break":"paragraph","ruby":[[2,2,"せいどう"],[5,2,"せんばん"],[9,1,"こ"],[10,1,"つく"],[14,2,"せんばん"],[26,1,"みず"],[32,2,"せんばん"],[50,1,"こ"],[52,1,"だい"],[54,1,"うえ"],[66,2,"せんばん"]],"text":"また青銅の洗盤を十個造った。洗盤はおのおの四十バテの水がはいり、洗盤はおのおの四キュビトであった。十個の台の上にはおのおの一つずつの洗盤があった。"},{"ref":"1Kgs.7.39","start":11007039,"end":11007039,"break":"none","ruby":[[2,1,"だい"],[5,1,"こ"],[7,1,"みや"],[9,1,"みなみ"],[11,1,"ほう"],[15,1,"こ"],[17,1,"みや"],[19,1,"きた"],[21,1,"ほう"],[23,1,"お"],[26,1,"みや"],[28,2,"とうなん"],[31,1,"ほう"],[33,1,"うみ"]],"text":"その台の五個を宮の南の方に、五個を宮の北の方に置き、宮の東南の方に海をすえた。"},{"ref":"1Kgs.7.40","start":11007040,"end":11007040,"break":"paragraph","ruby":[[9,2,"じゅうのう"],[12,1,"はち"],[14,1,"つく"],[30,1,"おう"],[35,1,"しゅ"],[37,1,"みや"],[43,2,"さいく"],[48,1,"お"]],"text":"ヒラムはまたつぼと十能と鉢を造った。こうしてヒラムはソロモン王のために主の宮のすべての細工をなし終えた。"},{"ref":"1Kgs.7.41","start":11007041,"end":11007041,"break":"none","ruby":[[5,1,"ほん"],[7,1,"はしら"],[12,1,"はしら"],[14,1,"いただき"],[18,2,"ちゅうとう"],[24,1,"たま"],[27,1,"はしら"],[29,1,"いただき"],[33,2,"ちゅうとう"],[39,1,"たま"],[47,1,"あみ"],[48,2,"ざいく"]],"text":"すなわち二本の柱と、その柱の頂にある柱頭の二つの玉と、柱の頂にある柱頭の二つの玉をおおう二つの網細工と、"},{"ref":"1Kgs.7.42","start":11007042,"end":11007042,"break":"none","ruby":[[5,1,"あみ"],[6,2,"ざいく"],[27,1,"あみ"],[28,2,"ざいく"],[33,1,"なら"],[40,1,"はしら"],[42,1,"いただき"],[46,2,"ちゅうとう"],[52,1,"たま"],[54,1,"ま"]],"text":"その二つの網細工のためのざくろ四百。このざくろは一つの網細工に、二並びにつけて、柱の頂にある柱頭の二つの玉を巻いた。"},{"ref":"1Kgs.7.43","start":11007043,"end":11007043,"break":"none","ruby":[[3,1,"こ"],[5,1,"だい"],[10,1,"だい"],[12,1,"うえ"],[15,1,"こ"],[17,2,"せんばん"]],"text":"また十個の台と、その台の上の十個の洗盤と、"},{"ref":"1Kgs.7.44","start":11007044,"end":11007044,"break":"none","ruby":[[3,1,"うみ"],[8,1,"うみ"],[10,1,"した"],[15,1,"うし"]],"text":"一つの海と、その海の下の十二の牛とであった。"},{"ref":"1Kgs.7.45","start":11007045,"end":11007045,"break":"paragraph","ruby":[[5,2,"じゅうのう"],[8,1,"はち"],[22,1,"おう"],[27,1,"つく"],[30,1,"しゅ"],[32,1,"みや"],[38,1,"うつわ"],[42,1,"ひかり"],[46,2,"せいどう"]],"text":"さてつぼと十能と鉢、すなわちヒラムがソロモン王のために造った主の宮のこれらの器はみな光のある青銅であった。"},{"ref":"1Kgs.7.46","start":11007046,"end":11007046,"break":"none","ruby":[[0,1,"おう"],[7,2,"ていち"],[20,1,"あいだ"],[22,2,"ねんど"],[25,1,"ち"],[31,1,"い"]],"text":"王はヨルダンの低地で、スコテとザレタンの間の粘土の地でこれらを鋳た。"},{"ref":"1Kgs.7.47","start":11007047,"end":11007047,"break":"none","ruby":[[7,1,"うつわ"],[9,2,"ひじょう"],[12,1,"おお"],[19,1,"みな"],[34,2,"せいどう"],[37,1,"おも"],[44,1,"え"]],"text":"ソロモンはその器が非常に多かったので、皆それをはからずにおいた。その青銅の重さは、はかり得なかった。"},{"ref":"1Kgs.7.48","start":11007048,"end":11007048,"break":"paragraph","ruby":[[7,1,"しゅ"],[9,1,"みや"],[18,1,"うつわ"],[20,1,"つく"],[28,1,"きん"],[30,2,"さいだん"],[34,1,"そな"],[40,1,"の"],[43,1,"きん"],[45,1,"つくえ"]],"text":"またソロモンは主の宮にあるもろもろの器を造った。すなわち金の祭壇と、供えのパンを載せる金の机、"},{"ref":"1Kgs.7.49","start":11007049,"end":11007049,"break":"none","ruby":[[3,2,"じゅんきん"],[6,2,"しょくだい"],[11,2,"しょくだい"],[14,2,"ほんでん"],[17,1,"まえ"],[23,1,"みなみ"],[29,1,"きた"],[37,1,"きん"],[39,1,"はな"],[46,1,"さら"],[49,1,"こころ"]],"text":"および純金の燭台。この燭台は本殿の前に、五つは南に、五つは北にあった。また金の花と、ともしび皿と、心かきと、"},{"ref":"1Kgs.7.50","start":11007050,"end":11007050,"break":"none","ruby":[[0,2,"じゅんきん"],[3,1,"さら"],[6,2,"しんき"],[14,1,"はち"],[17,1,"こう"],[19,1,"はい"],[22,2,"しんと"],[25,1,"ざら"],[28,3,"しせいじょ"],[34,1,"みや"],[36,1,"おく"],[48,1,"みや"],[50,2,"はいでん"],[61,1,"きん"],[68,1,"つく"]],"text":"純金の皿と、心切りばさみと、鉢と、香の杯と、心取り皿と、至聖所である宮の奥のとびらのためおよび、宮の拝殿のとびらのために、金のひじつぼを造った。"},{"ref":"1Kgs.7.51","start":11007051,"end":11007051,"break":"paragraph","ruby":[[8,1,"おう"],[10,1,"しゅ"],[12,1,"みや"],[17,1,"つく"],[23,2,"さいく"],[26,1,"おわ"],[38,1,"ちち"],[47,1,"もの"],[53,2,"きんぎん"],[58,2,"うつわもの"],[61,1,"たずさ"],[63,1,"はい"],[66,1,"しゅ"],[68,1,"みや"],[70,2,"ほうぞう"],[73,1,"なか"]],"text":"こうしてソロモン王が主の宮のために造るすべての細工は終った。そしてソロモンは父ダビデがささげた物、すなわち金銀および器物を携え入り、主の宮の宝蔵の中にたくわえた。"}]