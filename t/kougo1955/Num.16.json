[{"ref":"Num.16.1","start":4016001,"end":4016001,"break":"paragraph","ruby":[[7,1,"こ"],[12,1,"こ"],[20,1,"こ"],[29,1,"こ"],[37,1,"こ"],[54,1,"こ"],[61,1,"こ"],[66,1,"あい"],[67,1,"むす"]],"text":"ここに、レビの子コハテの子なるイヅハルの子コラと、ルベンの子なるエリアブの子ダタンおよびアビラムと、ルベンの子なるペレテの子オンとが相結び、"},{"ref":"Num.16.2","start":4016002,"end":4016002,"break":"none","ruby":[[6,2,"ひとびと"],[12,2,"かいしゅう"],[19,1,"えら"],[31,1,"な"],[35,2,"ひとびと"],[41,1,"にん"],[43,1,"とも"],[45,1,"た"],[53,1,"さか"]],"text":"イスラエルの人々のうち、会衆のうちから選ばれて、つかさとなった名のある人々二百五十人と共に立って、モーセに逆らった。"},{"ref":"Num.16.3","start":4016003,"end":4016003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"あつ"],[17,1,"さか"],[21,1,"い"],[33,1,"ぶん"],[35,1,"こ"],[42,1,"ぜん"],[43,2,"かいしゅう"],[52,1,"せい"],[62,1,"しゅ"],[87,1,"しゅ"],[89,2,"かいしゅう"],[92,1,"うえ"],[94,1,"た"]],"text":"彼らは集まって、モーセとアロンとに逆らって言った、「あなたがたは、分を越えています。全会衆は、ことごとく聖なるものであって、主がそのうちにおられるのに、どうしてあなたがたは、主の会衆の上に立つのですか」。"},{"ref":"Num.16.4","start":4016004,"end":4016004,"break":"none","ruby":[[7,1,"き"],[12,1,"ふ"]],"text":"モーセはこれを聞いてひれ伏した。"},{"ref":"Num.16.5","start":4016005,"end":4016005,"break":"none","ruby":[[3,1,"かれ"],[15,2,"なかま"],[19,1,"い"],[27,1,"しゅ"],[30,1,"しゅ"],[40,1,"せい"],[43,1,"もの"],[52,1,"しめ"],[58,1,"ひと"],[64,1,"ちか"],[82,1,"えら"],[85,1,"ひと"],[92,1,"ちか"]],"text":"やがて彼はコラと、そのすべての仲間とに言った、「あす、主は、主につくものはだれ、聖なる者はだれであるかを示して、その人をみもとに近づけられるであろう。すなわち、その選んだ人を、みもとに近づけられるであろう。"},{"ref":"Num.16.6","start":4016006,"end":4016006,"break":"none","ruby":[[4,1,"つぎ"],[23,2,"なかま"],[28,1,"ひ"],[32,1,"と"]],"text":"それで、次のようにしなさい。コラとそのすべての仲間とは、火ざらを取り、"},{"ref":"Num.16.7","start":4016007,"end":4016007,"break":"none","ruby":[[2,1,"なか"],[4,1,"ひ"],[6,1,"い"],[12,2,"くんこう"],[15,1,"も"],[22,1,"しゅ"],[24,1,"まえ"],[26,1,"で"],[33,1,"とき"],[35,1,"しゅ"],[37,1,"えら"],[41,1,"ひと"],[43,1,"せい"],[46,1,"もの"],[54,1,"こ"],[67,1,"ぶん"],[69,1,"こ"]],"text":"その中に火を入れ、それに薫香を盛って、あす、主の前に出なさい。その時、主が選ばれる人は聖なる者である。レビの子たちよ、あなたがたこそ、分を越えている」。"},{"ref":"Num.16.8","start":4016008,"end":4016008,"break":"none","ruby":[[9,1,"い"],[17,1,"こ"],[22,1,"き"]],"text":"モーセはまたコラに言った、「レビの子たちよ、聞きなさい。"},{"ref":"Num.16.9","start":4016009,"end":4016009,"break":"none","ruby":[[6,1,"かみ"],[20,2,"かいしゅう"],[27,1,"わ"],[31,1,"しゅ"],[33,1,"ちか"],[39,1,"しゅ"],[41,2,"まくや"],[44,1,"つとめ"],[51,2,"かいしゅう"],[54,1,"まえ"],[56,1,"た"],[59,1,"つか"],[80,1,"ちい"]],"text":"イスラエルの神はあなたがたをイスラエルの会衆のうちから分かち、主に近づかせて、主の幕屋の務をさせ、かつ会衆の前に立って仕えさせられる。これはあなたがたにとって、小さいことであろうか。"},{"ref":"Num.16.10","start":4016010,"end":4016010,"break":"none","ruby":[[0,1,"かみ"],[10,2,"きょうだい"],[17,1,"こ"],[23,1,"ちか"],[41,1,"うえ"],[43,2,"さいし"],[51,1,"もと"]],"text":"神はあなたとあなたの兄弟なるレビの子たちをみな近づけられた。あなたがたはなお、その上に祭司となることを求めるのか。"},{"ref":"Num.16.11","start":4016011,"end":4016011,"break":"none","ruby":[[8,2,"なかま"],[19,1,"あつ"],[23,1,"しゅ"],[25,1,"てき"],[44,1,"おも"],[48,1,"かれ"],[50,1,"たい"]],"text":"あなたとあなたの仲間は、みなそのために集まって主に敵している。あなたがたはアロンをなんと思って、彼に対してつぶやくのか」。"},{"ref":"Num.16.12","start":4016012,"end":4016012,"break":"paragraph","ruby":[[4,1,"ひと"],[15,1,"こ"],[26,1,"よ"],[32,1,"かれ"],[35,1,"い"],[46,1,"まい"]],"text":"モーセは人をやって、エリアブの子ダタンとアビラムとを呼ばせたが、彼らは言った、「わたしたちは参りません。"},{"ref":"Num.16.13","start":4016013,"end":4016013,"break":"none","ruby":[[4,1,"ちち"],[6,1,"みつ"],[8,1,"なが"],[11,1,"ち"],[21,1,"みちび"],[23,1,"だ"],[27,2,"あらの"],[36,1,"ころ"],[48,1,"ちい"],[61,1,"うえ"],[73,2,"くんりん"]],"text":"あなたは乳と蜜の流れる地から、わたしたちを導き出して、荒野でわたしたちを殺そうとしている。これは小さいことでしょうか。その上、あなたはわたしたちに君臨しようとしている。"},{"ref":"Num.16.14","start":4016014,"end":4016014,"break":"none","ruby":[[16,1,"ちち"],[18,1,"みつ"],[20,1,"なが"],[23,1,"ち"],[25,1,"みちび"],[28,1,"い"],[32,1,"はたけ"],[38,1,"はたけ"],[41,1,"し"],[42,1,"ぎょう"],[46,1,"あた"],[57,2,"ひとびと"],[60,1,"め"],[81,1,"まい"]],"text":"かつまた、あなたはわたしたちを、乳と蜜の流れる地に導いて行かず、畑と、ぶどう畑とを嗣業として与えもしない。これらの人々の目をくらまそうとするのですか。わたしたちは参りません」。"},{"ref":"Num.16.15","start":4016015,"end":4016015,"break":"paragraph","ruby":[[4,1,"おお"],[7,1,"いか"],[11,1,"しゅ"],[13,1,"い"],[18,1,"かれ"],[21,1,"そな"],[23,1,"もの"],[25,1,"かえり"],[39,1,"かれ"],[47,1,"とう"],[50,1,"と"],[60,1,"かれ"],[68,1,"がい"]],"text":"モーセは大いに怒って、主に言った、「彼らの供え物を顧みないでください。わたしは彼らから、ろば一頭をも取ったことなく、また彼らのひとりをも害したことはありません」。"},{"ref":"Num.16.16","start":4016016,"end":4016016,"break":"none","ruby":[[10,1,"い"],[23,2,"なかま"],[32,2,"いっしょ"],[39,1,"しゅ"],[41,1,"まえ"],[43,1,"で"]],"text":"そしてモーセはコラに言った、「あなたとあなたの仲間はみなアロンと一緒に、あす、主の前に出なさい。"},{"ref":"Num.16.17","start":4016017,"end":4016017,"break":"none","ruby":[[11,1,"ひ"],[15,1,"と"],[22,2,"くんこう"],[25,1,"も"],[34,1,"ひ"],[38,1,"しゅ"],[40,1,"まえ"],[42,1,"たずさ"],[45,1,"い"],[53,1,"ひ"],[57,1,"あ"],[79,1,"ひ"],[83,1,"たずさ"],[86,1,"い"]],"text":"あなたがたは、おのおの火ざらを取って、それに薫香を盛り、おのおのその火ざらを主の前に携えて行きなさい。その火ざらは会わせて二百五十。あなたとアロンも、おのおの火ざらを携えて行きなさい」。"},{"ref":"Num.16.18","start":4016018,"end":4016018,"break":"none","ruby":[[0,1,"かれ"],[8,1,"ひ"],[12,1,"と"],[15,1,"ひ"],[19,1,"なか"],[21,1,"い"],[27,2,"くんこう"],[30,1,"も"],[41,1,"とも"],[44,2,"かいけん"],[47,2,"まくや"],[50,2,"いりぐち"],[53,1,"た"]],"text":"彼らは、おのおの火ざらを取り、火をその中に入れ、それに薫香を盛り、モーセとアロンも共に、会見の幕屋の入口に立った。"},{"ref":"Num.16.19","start":4016019,"end":4016019,"break":"none","ruby":[[8,2,"かいしゅう"],[17,2,"かいけん"],[20,2,"まくや"],[23,2,"いりぐち"],[26,1,"あつ"],[30,1,"かれ"],[36,1,"さか"],[47,1,"しゅ"],[49,2,"えいこう"],[52,1,"ぜん"],[53,2,"かいしゅう"],[56,1,"あらわ"]],"text":"そのとき、コラは会衆を、ことごとく会見の幕屋の入口に集めて、彼らふたりに逆らわせようとしたが、主の栄光は全会衆に現れた。"},{"ref":"Num.16.20","start":4016020,"end":4016020,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"い"]],"text":"主はモーセとアロンに言われた、"},{"ref":"Num.16.21","start":4016021,"end":4016021,"break":"none","ruby":[[9,2,"かいしゅう"],[12,1,"はな"],[26,1,"かれ"],[29,1,"ほろ"]],"text":"「あなたがたはこの会衆を離れなさい。わたしはただちに彼らを滅ぼすであろう」。"},{"ref":"Num.16.22","start":4016022,"end":4016022,"break":"none","ruby":[[0,1,"かれ"],[9,1,"ふ"],[12,1,"い"],[17,1,"かみ"],[24,1,"にく"],[27,1,"もの"],[29,1,"いのち"],[31,1,"かみ"],[40,1,"ひと"],[43,1,"つみ"],[45,1,"おか"],[59,1,"ぜん"],[60,2,"かいしゅう"],[63,1,"たい"],[66,1,"いか"]],"text":"彼らふたりは、ひれ伏して言った、「神よ、すべての肉なる者の命の神よ、このひとりの人が、罪を犯したからといって、あなたは全会衆に対して怒られるのですか」。"},{"ref":"Num.16.23","start":4016023,"end":4016023,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.16.24","start":4016024,"end":4016024,"break":"none","ruby":[[5,2,"かいしゅう"],[8,1,"つ"],[28,2,"しゅうい"],[31,1,"さ"],[34,1,"い"]],"text":"「あなたは会衆に告げて、コラとダタンとアビラムのすまいの周囲を去れと言いなさい」。"},{"ref":"Num.16.25","start":4016025,"end":4016025,"break":"paragraph","ruby":[[4,1,"た"],[19,1,"い"],[30,2,"ちょうろう"],[36,1,"かれ"],[38,1,"したが"],[41,1,"い"]],"text":"モーセは立ってダタンとアビラムのもとに行ったが、イスラエルの長老たちも、彼に従って行った。"},{"ref":"Num.16.26","start":4016026,"end":4016026,"break":"none","ruby":[[4,2,"かいしゅう"],[7,1,"い"],[26,1,"わる"],[28,2,"ひとびと"],[31,2,"てんまく"],[34,1,"はな"],[42,1,"かれ"],[49,1,"なに"],[52,1,"ふ"],[61,1,"かれ"],[69,1,"つみ"],[81,1,"ほろ"]],"text":"モーセは会衆に言った、「どうぞ、あなたがたはこれらの悪い人々の天幕を離れてください。彼らのものには何にも触れてはならない。彼らのもろもろの罪によって、あなたがたも滅ぼされてはいけないから」。"},{"ref":"Num.16.27","start":4016027,"end":4016027,"break":"none","ruby":[[3,2,"ひとびと"],[22,2,"しゅうい"],[25,1,"はな"],[27,1,"さ"],[46,1,"つま"],[48,1,"こ"],[53,2,"ようじ"],[56,2,"いっしょ"],[59,1,"で"],[62,2,"てんまく"],[65,2,"いりぐち"],[68,1,"た"]],"text":"そこで人々はコラとダタンとアビラムのすまいの周囲を離れ去った。そして、ダタンとアビラムとは、妻、子、および幼児と一緒に出て、天幕の入口に立った。"},{"ref":"Num.16.28","start":4016028,"end":4016028,"break":"none","ruby":[[4,1,"い"],[15,1,"しゅ"],[25,1,"こと"],[57,2,"じぶん"],[60,1,"こころ"],[67,1,"おこな"],[78,1,"つぎ"],[86,1,"し"]],"text":"モーセは言った、「あなたがたは主がこれらのすべての事をさせるために、わたしをつかわされたこと、またわたしが、これを自分の心にしたがって行うものでないことを、次のことによって知るであろう。"},{"ref":"Num.16.29","start":4016029,"end":4016029,"break":"none","ruby":[[11,2,"ひとびと"],[15,2,"ふつう"],[18,1,"し"],[20,1,"かた"],[22,1,"し"],[25,2,"ふつう"],[28,2,"うんめい"],[31,1,"あ"],[39,1,"しゅ"]],"text":"すなわち、もしこれらの人々が、普通の死に方で死に、普通の運命に会うのであれば、主がわたしをつかわされたのではない。"},{"ref":"Num.16.30","start":4016030,"end":4016030,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"あたら"],[9,1,"こと"],[14,1,"ち"],[16,1,"くち"],[18,1,"ひら"],[26,2,"ひとびと"],[33,1,"ぞく"],[36,1,"もの"],[52,1,"い"],[57,2,"よみ"],[60,1,"くだ"],[80,2,"ひとびと"],[84,1,"しゅ"],[86,1,"あなど"],[96,1,"し"]],"text":"しかし、主が新しい事をされ、地が口を開いて、これらの人々と、それに属する者とを、ことごとくのみつくして、生きながら陰府に下らせられるならば、あなたがたはこれらの人々が、主を侮ったのであることを知らなければならない」。"},{"ref":"Num.16.31","start":4016031,"end":4016031,"break":"paragraph","ruby":[[13,2,"ことば"],[16,1,"の"],[18,1,"おわ"],[24,1,"かれ"],[27,1,"した"],[29,2,"とち"],[32,1,"さ"]],"text":"モーセが、これらのすべての言葉を述べ終ったとき、彼らの下の土地が裂け、"},{"ref":"Num.16.32","start":4016032,"end":4016032,"break":"none","ruby":[[0,1,"ち"],[2,1,"くち"],[4,1,"ひら"],[8,1,"かれ"],[13,2,"かぞく"],[23,1,"ぞく"],[30,2,"ひとびと"],[38,3,"しょゆうぶつ"]],"text":"地は口を開いて、彼らとその家族、ならびにコラに属するすべての人々と、すべての所有物をのみつくした。"},{"ref":"Num.16.33","start":4016033,"end":4016033,"break":"none","ruby":[[5,1,"かれ"],[9,1,"かれ"],[12,1,"ぞく"],[19,1,"みな"],[20,1,"い"],[25,2,"よみ"],[28,1,"くだ"],[31,1,"ち"],[35,1,"うえ"],[37,1,"と"],[44,1,"かれ"],[47,2,"かいしゅう"],[55,1,"た"],[57,1,"ほろ"]],"text":"すなわち、彼らと、彼らに属するものは、皆生きながら陰府に下り、地はその上を閉じふさいで、彼らは会衆のうちから、断ち滅ぼされた。"},{"ref":"Num.16.34","start":4016034,"end":4016034,"break":"none","ruby":[[2,1,"とき"],[6,2,"しゅうい"],[17,2,"ひとびと"],[23,1,"かれ"],[26,1,"さけ"],[29,1,"き"],[32,1,"に"],[34,1,"さ"],[38,1,"おそ"],[41,1,"ち"],[62,1,"い"]],"text":"この時、その周囲にいたイスラエルの人々は、みな彼らの叫びを聞いて逃げ去り、「恐らく地はわたしたちをも、のみつくすであろう」と言った。"},{"ref":"Num.16.35","start":4016035,"end":4016035,"break":"none","ruby":[[2,1,"しゅ"],[8,1,"ひ"],[10,1,"で"],[13,2,"くんこう"],[16,1,"そな"],[23,1,"にん"],[26,1,"や"]],"text":"また主のもとから火が出て、薫香を供える二百五十人をも焼きつくした。"},{"ref":"Num.16.36","start":4016036,"end":4016036,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.16.37","start":4016037,"end":4016037,"break":"none","ruby":[[5,2,"さいし"],[11,1,"こ"],[18,1,"つ"],[24,1,"も"],[27,1,"ひ"],[29,1,"なか"],[35,1,"ひ"],[39,1,"と"],[41,1,"だ"],[47,1,"なか"],[49,1,"ひ"],[51,1,"とお"],[53,1,"ひろ"],[57,1,"ち"],[69,1,"ひ"],[73,1,"せい"]],"text":"「あなたは祭司アロンの子エレアザルに告げて、その燃える火の中から、かの火ざらを取り出させ、その中の火を遠く広くまき散らさせなさい。それらの火ざらは聖となったから、"},{"ref":"Num.16.38","start":4016038,"end":4016038,"break":"none","ruby":[[0,1,"つみ"],[2,1,"おか"],[5,1,"いのち"],[7,1,"うしな"],[10,2,"ひとびと"],[18,1,"ひ"],[23,1,"ひろ"],[25,1,"の"],[27,1,"いた"],[32,2,"さいだん"],[47,1,"しゅ"],[49,1,"まえ"],[58,1,"せい"],[83,2,"ひとびと"]],"text":"罪を犯して命を失った人々の、これらの火ざらを、広い延べ板として、祭壇のおおいとしなさい。これは主の前にささげられて、聖となったからである。こうして、これはイスラエルの人々に、しるしとなるであろう」。"},{"ref":"Num.16.39","start":4016039,"end":4016039,"break":"none","ruby":[[3,2,"さいし"],[14,1,"や"],[16,1,"ころ"],[20,2,"ひとびと"],[23,1,"そな"],[26,2,"せいどう"],[29,1,"ひ"],[33,1,"と"],[39,1,"ひろ"],[41,1,"う"],[43,1,"の"],[48,2,"さいだん"]],"text":"そこで祭司エレアザルは、かの焼き殺された人々が供えた青銅の火ざらを取り、これを広く打ち延ばして、祭壇のおおいとし、"},{"ref":"Num.16.40","start":4016040,"end":4016040,"break":"none","ruby":[[9,2,"ひとびと"],[12,2,"きねん"],[15,1,"もの"],[27,2,"しそん"],[35,1,"ひと"],[38,1,"しゅ"],[40,1,"まえ"],[42,1,"ちか"],[47,2,"くんこう"],[69,1,"ひと"],[79,2,"なかま"],[100,1,"しゅ"],[115,1,"い"]],"text":"これをイスラエルの人々の記念の物とした。これはアロンの子孫でないほかの人が、主の前に近づいて、薫香をたくことのないようにするため、またその人がコラ、およびその仲間のようにならないためである。すなわち、主がモーセによってエレアザルに言われたとおりである。"},{"ref":"Num.16.41","start":4016041,"end":4016041,"break":"paragraph","ruby":[[2,2,"よくじつ"],[11,2,"ひとびと"],[14,2,"かいしゅう"],[34,1,"い"],[45,1,"しゅ"],[47,1,"たみ"],[49,1,"ころ"]],"text":"その翌日、イスラエルの人々の会衆は、みなモーセとアロンとにつぶやいて言った、「あなたがたは主の民を殺しました」。"},{"ref":"Num.16.42","start":4016042,"end":4016042,"break":"none","ruby":[[0,2,"かいしゅう"],[3,1,"あつ"],[17,1,"さか"],[24,2,"かいけん"],[27,2,"まくや"],[30,1,"のぞ"],[32,1,"み"],[36,1,"くも"],[45,1,"しゅ"],[47,2,"えいこう"],[50,1,"あらわ"]],"text":"会衆が集まって、モーセとアロンとに逆らったとき、会見の幕屋を望み見ると、雲がこれをおおい、主の栄光が現れていた。"},{"ref":"Num.16.43","start":4016043,"end":4016043,"break":"none","ruby":[[10,2,"かいけん"],[13,2,"まくや"],[16,1,"まえ"],[18,1,"い"]],"text":"モーセとアロンとが、会見の幕屋の前に行くと、"},{"ref":"Num.16.44","start":4016044,"end":4016044,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.16.45","start":4016045,"end":4016045,"break":"none","ruby":[[9,2,"かいしゅう"],[12,1,"はな"],[26,1,"かれ"],[29,1,"ほろ"],[38,1,"かれ"],[47,1,"ふ"]],"text":"「あなたがたはこの会衆を離れなさい。わたしはただちに彼らを滅ぼそう」。そこで彼らふたりは、ひれ伏した。"},{"ref":"Num.16.46","start":4016046,"end":4016046,"break":"none","ruby":[[8,1,"い"],[17,1,"ひ"],[21,1,"と"],[28,2,"さいだん"],[32,1,"と"],[35,1,"ひ"],[37,1,"い"],[42,1,"うえ"],[44,2,"くんこう"],[47,1,"も"],[50,1,"いそ"],[56,2,"かいしゅう"],[62,1,"も"],[65,1,"い"],[69,1,"かれ"],[75,1,"つみ"],[87,1,"しゅ"],[89,1,"いか"],[92,1,"はっ"],[97,2,"えきびょう"],[103,1,"はじ"]],"text":"モーセはアロンに言った、「あなたは火ざらを取って、それに祭壇から取った火を入れ、その上に薫香を盛り、急いでそれを会衆のもとに持って行って、彼らのために罪のあがないをしなさい。主が怒りを発せられ、疫病がすでに始まったからです」。"},{"ref":"Num.16.47","start":4016047,"end":4016047,"break":"none","ruby":[[12,1,"い"],[22,1,"と"],[25,2,"かいしゅう"],[28,1,"なか"],[30,1,"はし"],[33,1,"い"],[38,2,"えきびょう"],[44,1,"たみ"],[49,1,"はじ"],[58,2,"くんこう"],[65,1,"たみ"],[70,1,"つみ"]],"text":"そこで、アロンはモーセの言ったように、それを取って会衆の中に走って行ったが、疫病はすでに民のうちに始まっていたので、薫香をたいて、民のために罪のあがないをし、"},{"ref":"Num.16.48","start":4016048,"end":4016048,"break":"none","ruby":[[3,1,"し"],[6,1,"もの"],[11,1,"い"],[16,1,"もの"],[19,1,"あいだ"],[21,1,"た"],[25,2,"えきびょう"]],"text":"すでに死んだ者と、なお生きている者との間に立つと、疫病はやんだ。"},{"ref":"Num.16.49","start":4016049,"end":4016049,"break":"none","ruby":[[3,1,"こと"],[8,1,"し"],[11,1,"もの"],[19,2,"えきびょう"],[25,1,"し"],[28,1,"もの"],[36,1,"にん"]],"text":"コラの事によって死んだ者のほかに、この疫病によって死んだ者は一万四千七百人であった。"},{"ref":"Num.16.50","start":4016050,"end":4016050,"break":"none","ruby":[[4,2,"かいけん"],[7,2,"まくや"],[10,2,"いりぐち"],[22,1,"かえ"],[30,2,"えきびょう"]],"text":"アロンは会見の幕屋の入口にいるモーセのもとに帰った。こうして疫病はやんだ。"}]