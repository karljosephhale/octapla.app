[{"ref":"Rom.4.1","start":45004001,"end":45004001,"break":"paragraph","ruby":[[5,1,"にく"],[15,2,"せんぞ"],[23,2,"ばあい"],[34,1,"い"]],"text":"それでは、肉によるわたしたちの先祖アブラハムの場合については、なんと言ったらよいか。"},{"ref":"Rom.4.2","start":45004002,"end":45004002,"break":"none","ruby":[[11,1,"おこな"],[17,1,"ぎ"],[28,1,"かれ"],[30,1,"ほこ"],[44,1,"かみ"]],"text":"もしアブラハムが、その行いによって義とされたのであれば、彼は誇ることができよう。しかし、神のみまえでは、できない。"},{"ref":"Rom.4.3","start":45004003,"end":45004003,"break":"none","ruby":[[5,2,"せいしょ"],[11,1,"い"],[25,1,"かみ"],[27,1,"しん"],[38,1,"かれ"],[40,1,"ぎ"],[42,1,"みと"]],"text":"なぜなら、聖書はなんと言っているか、「アブラハムは神を信じた。それによって、彼は義と認められた」とある。"},{"ref":"Rom.4.4","start":45004004,"end":45004004,"break":"none","ruby":[[5,1,"はたら"],[7,1,"ひと"],[9,1,"たい"],[12,2,"ほうしゅう"],[16,2,"おんけい"],[26,2,"とうぜん"],[29,2,"しはら"],[35,1,"みと"]],"text":"いったい、働く人に対する報酬は、恩恵としてではなく、当然の支払いとして認められる。"},{"ref":"Rom.4.5","start":45004005,"end":45004005,"break":"none","ruby":[[4,1,"はたら"],[12,3,"ふしんじん"],[16,1,"もの"],[18,1,"ぎ"],[25,1,"しん"],[28,1,"ひと"],[33,2,"しんこう"],[36,1,"ぎ"],[38,1,"みと"]],"text":"しかし、働きはなくても、不信心な者を義とするかたを信じる人は、その信仰が義と認められるのである。"},{"ref":"Rom.4.6","start":45004006,"end":45004006,"break":"none","ruby":[[7,1,"おこな"],[14,1,"かみ"],[16,1,"ぎ"],[18,1,"みと"],[23,1,"ひと"],[25,2,"こうふく"],[32,1,"つぎ"],[37,1,"い"]],"text":"ダビデもまた、行いがなくても神に義と認められた人の幸福について、次のように言っている、"},{"ref":"Rom.4.7","start":45004007,"end":45004007,"break":"stanza","breaks":[[21,"line"]],"ruby":[[1,2,"ふほう"],[9,1,"つみ"],[16,1,"ひと"]],"text":"「不法をゆるされ、罪をおおわれた人たちは、さいわいである。"},{"ref":"Rom.4.8","start":45004008,"end":45004008,"break":"line","ruby":[[0,1,"つみ"],[2,1,"しゅ"],[4,1,"みと"],[10,1,"ひと"]],"text":"罪を主に認められない人は、さいわいである」。"},{"ref":"Rom.4.9","start":45004009,"end":45004009,"break":"paragraph","ruby":[[5,2,"こうふく"],[9,2,"かつれい"],[12,1,"もの"],[16,1,"う"],[27,1,"む"],[28,2,"かつれい"],[31,1,"もの"],[34,1,"およ"],[45,1,"い"],[59,2,"しんこう"],[62,1,"ぎ"],[64,1,"みと"]],"text":"さて、この幸福は、割礼の者だけが受けるのか。それとも、無割礼の者にも及ぶのか。わたしたちは言う、「アブラハムには、その信仰が義と認められた」のである。"},{"ref":"Rom.4.10","start":45004010,"end":45004010,"break":"none","ruby":[[9,2,"ばあい"],[14,1,"みと"],[22,2,"かつれい"],[25,1,"う"],[36,1,"う"],[39,1,"まえ"],[42,2,"かつれい"],[45,1,"う"],[55,1,"む"],[56,2,"かつれい"],[59,1,"とき"]],"text":"それでは、どういう場合にそう認められたのか。割礼を受けてからか、それとも受ける前か。割礼を受けてからではなく、無割礼の時であった。"},{"ref":"Rom.4.11","start":45004011,"end":45004011,"break":"none","ruby":[[10,2,"かつれい"],[19,1,"う"],[28,1,"む"],[29,2,"かつれい"],[35,2,"しんこう"],[41,1,"う"],[44,1,"ぎ"],[46,2,"しょういん"],[53,1,"かれ"],[56,1,"む"],[57,2,"かつれい"],[63,1,"しん"],[66,1,"ぎ"],[72,1,"いた"],[78,1,"ひと"],[80,1,"ちち"]],"text":"そして、アブラハムは割礼というしるしを受けたが、それは、無割礼のままで信仰によって受けた義の証印であって、彼が、無割礼のままで信じて義とされるに至るすべての人の父となり、"},{"ref":"Rom.4.12","start":45004012,"end":45004012,"break":"none","ruby":[[3,2,"かつれい"],[6,1,"もの"],[8,1,"ちち"],[20,2,"かつれい"],[23,1,"もの"],[30,2,"かつれい"],[33,1,"う"],[36,1,"もの"],[49,1,"ちち"],[56,1,"む"],[57,2,"かつれい"],[60,1,"とき"],[62,1,"も"],[67,2,"しんこう"],[70,2,"あしあと"],[73,1,"ふ"],[75,2,"ひとびと"]],"text":"かつ、割礼の者の父となるためなのである。割礼の者というのは、割礼を受けた者ばかりではなく、われらの父アブラハムが無割礼の時に持っていた信仰の足跡を踏む人々をもさすのである。"},{"ref":"Rom.4.13","start":45004013,"end":45004013,"break":"none","ruby":[[5,2,"せかい"],[8,2,"そうぞく"],[15,2,"やくそく"],[27,2,"しそん"],[31,1,"たい"],[41,2,"りっぽう"],[52,2,"しんこう"],[55,1,"ぎ"]],"text":"なぜなら、世界を相続させるとの約束が、アブラハムとその子孫とに対してなされたのは、律法によるのではなく、信仰の義によるからである。"},{"ref":"Rom.4.14","start":45004014,"end":45004014,"break":"none","ruby":[[3,2,"りっぽう"],[6,1,"た"],[8,2,"ひとびと"],[11,3,"そうぞくにん"],[22,2,"しんこう"],[32,2,"やくそく"],[37,2,"むこう"]],"text":"もし、律法に立つ人々が相続人であるとすれば、信仰はむなしくなり、約束もまた無効になってしまう。"},{"ref":"Rom.4.15","start":45004015,"end":45004015,"break":"none","ruby":[[5,2,"りっぽう"],[8,1,"いか"],[11,1,"まね"],[20,2,"りっぽう"],[30,2,"いはん"]],"text":"いったい、律法は怒りを招くものであって、律法のないところには違反なるものはない。"},{"ref":"Rom.4.16","start":45004016,"end":45004016,"break":"none","ruby":[[13,2,"しんこう"],[26,1,"めぐ"],[41,2,"しそん"],[50,2,"りっぽう"],[53,1,"た"],[55,1,"もの"],[70,2,"しんこう"],[73,1,"したが"],[75,1,"もの"],[81,2,"やくそく"],[84,2,"ほしょう"],[101,1,"かみ"],[103,1,"まえ"],[115,1,"もの"],[117,1,"ちち"]],"text":"このようなわけで、すべては信仰によるのである。それは恵みによるのであって、すべての子孫に、すなわち、律法に立つ者だけにではなく、アブラハムの信仰に従う者にも、この約束が保証されるのである。アブラハムは、神の前で、わたしたちすべての者の父であって、"},{"ref":"Rom.4.17","start":45004017,"end":45004017,"break":"none","ruby":[[10,1,"た"],[13,1,"おお"],[16,2,"こくみん"],[19,1,"ちち"],[25,1,"か"],[37,1,"かれ"],[41,1,"かみ"],[48,2,"しにん"],[51,1,"い"],[55,1,"む"],[58,1,"ゆう"],[60,1,"よ"],[62,1,"だ"],[66,1,"かみ"],[68,1,"しん"]],"text":"「わたしは、あなたを立てて多くの国民の父とした」と書いてあるとおりである。彼はこの神、すなわち、死人を生かし、無から有を呼び出される神を信じたのである。"},{"ref":"Rom.4.18","start":45004018,"end":45004018,"break":"none","ruby":[[0,1,"かれ"],[2,1,"のぞ"],[4,1,"え"],[13,1,"のぞ"],[17,1,"しん"],[32,2,"しそん"],[45,1,"い"],[55,1,"おお"],[58,2,"こくみん"],[61,1,"ちち"]],"text":"彼は望み得ないのに、なおも望みつつ信じた。そのために、「あなたの子孫はこうなるであろう」と言われているとおり、多くの国民の父となったのである。"},{"ref":"Rom.4.19","start":45004019,"end":45004019,"break":"none","ruby":[[9,1,"さい"],[15,1,"かれ"],[16,2,"じしん"],[23,1,"し"],[26,2,"じょうたい"],[38,1,"たい"],[40,2,"ふにん"],[47,1,"みと"],[56,1,"かれ"],[58,2,"しんこう"],[61,1,"よわ"]],"text":"すなわち、およそ百歳となって、彼自身のからだが死んだ状態であり、また、サラの胎が不妊であるのを認めながらも、なお彼の信仰は弱らなかった。"},{"ref":"Rom.4.20","start":45004020,"end":45004020,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,2,"やくそく"],[8,1,"ふ"],[9,2,"しんこう"],[15,1,"うたが"],[30,2,"しんこう"],[36,1,"つよ"],[41,2,"えいこう"],[44,1,"かみ"],[46,1,"き"]],"text":"彼は、神の約束を不信仰のゆえに疑うようなことはせず、かえって信仰によって強められ、栄光を神に帰し、"},{"ref":"Rom.4.21","start":45004021,"end":45004021,"break":"none","ruby":[[0,1,"かみ"],[4,2,"やくそく"],[15,2,"じょうじゅ"],[26,2,"かくしん"]],"text":"神はその約束されたことを、また成就することができると確信した。"},{"ref":"Rom.4.22","start":45004022,"end":45004022,"break":"none","ruby":[[4,1,"かれ"],[6,1,"ぎ"],[8,1,"みと"]],"text":"だから、彼は義と認められたのである。"},{"ref":"Rom.4.23","start":45004023,"end":45004023,"break":"none","ruby":[[4,1,"ぎ"],[6,1,"みと"],[13,1,"か"]],"text":"しかし「義と認められた」と書いてあるのは、アブラハムのためだけではなく、"},{"ref":"Rom.4.24","start":45004024,"end":45004024,"break":"none","ruby":[[20,1,"しゅ"],[25,2,"しにん"],[28,1,"なか"],[41,1,"しん"],[51,1,"ぎ"],[53,1,"みと"]],"text":"わたしたちのためでもあって、わたしたちの主イエスを死人の中からよみがえらせたかたを信じるわたしたちも、義と認められるのである。"},{"ref":"Rom.4.25","start":45004025,"end":45004025,"break":"none","ruby":[[0,1,"しゅ"],[9,2,"ざいか"],[15,1,"し"],[17,1,"わた"],[27,1,"ぎ"]],"text":"主は、わたしたちの罪過のために死に渡され、わたしたちが義とされるために、よみがえらされたのである。"}]