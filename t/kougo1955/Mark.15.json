[{"ref":"Mark.15.1","start":41015001,"end":41015001,"break":"paragraph","ruby":[[0,1,"よ"],[2,1,"あ"],[9,3,"さいしちょう"],[15,2,"ちょうろう"],[18,2,"りっぽう"],[20,2,"がくしゃ"],[28,1,"ぜん"],[29,2,"ぎかい"],[32,2,"きょうぎ"],[39,1,"すえ"],[45,1,"しば"],[48,1,"ひ"],[50,1,"だ"],[57,1,"わた"]],"text":"夜が明けるとすぐ、祭司長たちは長老、律法学者たち、および全議会と協議をこらした末、イエスを縛って引き出し、ピラトに渡した。"},{"ref":"Mark.15.2","start":41015002,"end":41015002,"break":"none","ruby":[[8,1,"たず"],[20,1,"じん"],[22,1,"おう"],[46,1,"こた"]],"text":"ピラトはイエスに尋ねた、「あなたがユダヤ人の王であるか」。イエスは、「そのとおりである」とお答えになった。"},{"ref":"Mark.15.3","start":41015003,"end":41015003,"break":"none","ruby":[[3,3,"さいしちょう"],[22,1,"うった"]],"text":"そこで祭司長たちは、イエスのことをいろいろと訴えた。"},{"ref":"Mark.15.4","start":41015004,"end":41015004,"break":"none","ruby":[[6,2,"いちど"],[12,1,"たず"],[17,1,"なに"],[19,1,"こた"],[26,1,"み"],[33,1,"たい"],[42,2,"つぎつぎ"],[45,1,"うった"]],"text":"ピラトはもう一度イエスに尋ねた、「何も答えないのか。見よ、あなたに対してあんなにまで次々に訴えているではないか」。"},{"ref":"Mark.15.5","start":41015005,"end":41015005,"break":"none","ruby":[[12,3,"ふしぎ"],[16,1,"おも"],[24,1,"なに"],[27,1,"こた"]],"text":"しかし、イエスはピラトが不思議に思うほどに、もう何もお答えにならなかった。"},{"ref":"Mark.15.6","start":41015006,"end":41015006,"break":"paragraph","ruby":[[3,1,"まつり"],[15,2,"ひとびと"],[18,1,"ねが"],[20,1,"で"],[22,2,"しゅうじん"]],"text":"さて、祭のたびごとに、ピラトは人々が願い出る囚人ひとりを、ゆるしてやることにしていた。"},{"ref":"Mark.15.7","start":41015007,"end":41015007,"break":"none","ruby":[[4,2,"ぼうどう"],[7,1,"おこ"],[9,2,"ひとごろ"],[22,2,"ぼうと"],[25,1,"なか"],[34,1,"もの"]],"text":"ここに、暴動を起し人殺しをしてつながれていた暴徒の中に、バラバという者がいた。"},{"ref":"Mark.15.8","start":41015008,"end":41015008,"break":"none","ruby":[[0,2,"ぐんしゅう"],[3,1,"お"],[25,2,"ようきゅう"]],"text":"群衆が押しかけてきて、いつものとおりにしてほしいと要求しはじめたので、"},{"ref":"Mark.15.9","start":41015009,"end":41015009,"break":"none","ruby":[[4,1,"かれ"],[22,1,"じん"],[24,1,"おう"],[39,1,"い"]],"text":"ピラトは彼らにむかって、「おまえたちはユダヤ人の王をゆるしてもらいたいのか」と言った。"},{"ref":"Mark.15.10","start":41015010,"end":41015010,"break":"none","ruby":[[4,3,"さいしちょう"],[14,1,"ひ"]],"text":"それは、祭司長たちがイエスを引きわたしたのは、ねたみのためであることが、ピラトにわかっていたからである。"},{"ref":"Mark.15.11","start":41015011,"end":41015011,"break":"none","ruby":[[3,3,"さいしちょう"],[14,1,"ほう"],[27,2,"ぐんしゅう"],[30,2,"せんどう"]],"text":"しかし祭司長たちは、バラバの方をゆるしてもらうように、群衆を煽動した。"},{"ref":"Mark.15.12","start":41015012,"end":41015012,"break":"none","ruby":[[9,1,"かれ"],[12,1,"い"],[31,1,"じん"],[33,1,"おう"],[35,1,"よ"],[42,1,"ひと"]],"text":"そこでピラトはまた彼らに言った、「それでは、おまえたちがユダヤ人の王と呼んでいるあの人は、どうしたらよいか」。"},{"ref":"Mark.15.13","start":41015013,"end":41015013,"break":"none","ruby":[[0,1,"かれ"],[6,1,"さけ"],[11,3,"じゅうじか"]],"text":"彼らは、また叫んだ、「十字架につけよ」。"},{"ref":"Mark.15.14","start":41015014,"end":41015014,"break":"none","ruby":[[4,1,"い"],[11,1,"ひと"],[22,2,"あくじ"],[35,1,"かれ"],[41,1,"はげ"],[44,1,"さけ"],[49,3,"じゅうじか"],[58,1,"い"]],"text":"ピラトは言った、「あの人は、いったい、どんな悪事をしたのか」。すると、彼らは一そう激しく叫んで、「十字架につけよ」と言った。"},{"ref":"Mark.15.15","start":41015015,"end":41015015,"break":"none","ruby":[[8,2,"ぐんしゅう"],[11,2,"まんぞく"],[18,1,"おも"],[39,1,"う"],[45,3,"じゅうじか"],[55,1,"ひ"]],"text":"それで、ピラトは群衆を満足させようと思って、バラバをゆるしてやり、イエスをむち打ったのち、十字架につけるために引きわたした。"},{"ref":"Mark.15.16","start":41015016,"end":41015016,"break":"paragraph","ruby":[[0,2,"へいし"],[10,2,"ていたく"],[17,2,"そうとく"],[19,2,"かんてい"],[22,1,"うち"],[24,1,"つ"],[27,1,"い"],[30,1,"ぜん"],[31,2,"ぶたい"],[34,1,"よ"],[36,1,"あつ"]],"text":"兵士たちはイエスを、邸宅、すなわち総督官邸の内に連れて行き、全部隊を呼び集めた。"},{"ref":"Mark.15.17","start":41015017,"end":41015017,"break":"none","ruby":[[7,1,"むらさき"],[9,1,"ころも"],[11,1,"き"],[18,1,"かんむり"],[20,1,"あ"]],"text":"そしてイエスに紫の衣を着せ、いばらの冠を編んでかぶらせ、"},{"ref":"Mark.15.18","start":41015018,"end":41015018,"break":"none","ruby":[[4,1,"じん"],[6,1,"おう"],[14,1,"い"],[17,2,"けいれい"]],"text":"「ユダヤ人の王、ばんざい」と言って敬礼をしはじめた。"},{"ref":"Mark.15.19","start":41015019,"end":41015019,"break":"none","ruby":[[3,1,"あし"],[5,1,"ぼう"],[9,1,"あたま"],[28,1,"おが"]],"text":"また、葦の棒でその頭をたたき、つばきをかけ、ひざまずいて拝んだりした。"},{"ref":"Mark.15.20","start":41015020,"end":41015020,"break":"none","ruby":[[9,2,"ちょうろう"],[17,1,"むらさき"],[19,1,"ころも"],[26,1,"もと"],[28,2,"うわぎ"],[31,1,"き"],[40,1,"かれ"],[47,3,"じゅうじか"],[57,1,"ひ"],[59,1,"だ"]],"text":"こうして、イエスを嘲弄したあげく、紫の衣をはぎとり、元の上着を着せた。それから、彼らはイエスを十字架につけるために引き出した。"},{"ref":"Mark.15.21","start":41015021,"end":41015021,"break":"none","ruby":[[17,1,"ちち"],[27,1,"びと"],[30,2,"こうがい"],[36,1,"とお"],[45,2,"ひとびと"],[52,3,"じゅうじか"],[56,2,"むり"],[59,1,"お"]],"text":"そこへ、アレキサンデルとルポスとの父シモンというクレネ人が、郊外からきて通りかかったので、人々はイエスの十字架を無理に負わせた。"},{"ref":"Mark.15.22","start":41015022,"end":41015022,"break":"none","ruby":[[14,2,"いみ"],[27,1,"ところ"],[29,1,"つ"],[32,1,"い"]],"text":"そしてイエスをゴルゴタ、その意味は、されこうべ、という所に連れて行った。"},{"ref":"Mark.15.23","start":41015023,"end":41015023,"break":"none","ruby":[[8,2,"もつやく"],[17,1,"しゅ"],[21,1,"だ"],[27,1,"う"]],"text":"そしてイエスに、没薬をまぜたぶどう酒をさし出したが、お受けにならなかった。"},{"ref":"Mark.15.24","start":41015024,"end":41015024,"break":"none","ruby":[[9,3,"じゅうじか"],[23,1,"ひ"],[30,1,"なに"],[32,1,"と"],[36,1,"さだ"],[46,2,"きもの"],[49,1,"わ"]],"text":"それから、イエスを十字架につけた。そしてくじを引いて、だれが何を取るかを定めたうえ、イエスの着物を分けた。"},{"ref":"Mark.15.25","start":41015025,"end":41015025,"break":"none","ruby":[[4,3,"じゅうじか"],[14,1,"あさ"],[17,1,"じ"]],"text":"イエスを十字架につけたのは、朝の九時ごろであった。"},{"ref":"Mark.15.26","start":41015026,"end":41015026,"break":"none","ruby":[[4,2,"ざいじょう"],[6,1,"が"],[14,1,"じん"],[16,1,"おう"]],"text":"イエスの罪状書きには「ユダヤ人の王」と、しるしてあった。"},{"ref":"Mark.15.27","start":41015027,"end":41015027,"break":"none","ruby":[[7,1,"とも"],[13,2,"ごうとう"],[21,1,"みぎ"],[28,1,"ひだり"],[31,3,"じゅうじか"]],"text":"また、イエスと共にふたりの強盗を、ひとりを右に、ひとりを左に、十字架につけた。〔"},{"ref":"Mark.15.28","start":41015028,"end":41015028,"break":"none","ruby":[[5,1,"かれ"],[7,2,"つみびと"],[16,1,"かぞ"],[23,1,"か"],[28,2,"ことば"],[31,2,"じょうじゅ"]],"text":"こうして「彼は罪人たちのひとりに数えられた」と書いてある言葉が成就したのである。〕"},{"ref":"Mark.15.29","start":41015029,"end":41015029,"break":"none","ruby":[[3,1,"とお"],[9,1,"もの"],[14,1,"あたま"],[16,1,"ふ"],[31,1,"い"],[39,2,"しんでん"],[42,1,"う"],[49,1,"か"],[54,1,"た"],[57,1,"もの"]],"text":"そこを通りかかった者たちは、頭を振りながら、イエスをののしって言った、「ああ、神殿を打ちこわして三日のうちに建てる者よ、"},{"ref":"Mark.15.30","start":41015030,"end":41015030,"break":"none","ruby":[[0,3,"じゅうじか"],[10,2,"じぶん"],[13,1,"すく"]],"text":"十字架からおりてきて自分を救え」。"},{"ref":"Mark.15.31","start":41015031,"end":41015031,"break":"none","ruby":[[0,3,"さいしちょう"],[6,1,"おな"],[12,2,"りっぽう"],[14,2,"がくしゃ"],[19,2,"いっしょ"],[32,2,"ちょうろう"],[36,1,"い"],[41,2,"たにん"],[44,1,"すく"],[49,2,"じぶん"],[51,2,"じしん"],[54,1,"すく"]],"text":"祭司長たちも同じように、律法学者たちと一緒になって、かわるがわる嘲弄して言った、「他人を救ったが、自分自身を救うことができない。"},{"ref":"Mark.15.32","start":41015032,"end":41015032,"break":"none","ruby":[[6,1,"おう"],[14,3,"じゅうじか"],[31,1,"み"],[34,1,"しん"],[43,2,"いっしょ"],[46,3,"じゅうじか"],[55,1,"もの"]],"text":"イスラエルの王キリスト、いま十字架からおりてみるがよい。それを見たら信じよう」。また、一緒に十字架につけられた者たちも、イエスをののしった。"},{"ref":"Mark.15.33","start":41015033,"end":41015033,"break":"paragraph","ruby":[[0,1,"ひる"],[4,1,"じ"],[10,1,"ぜん"],[11,1,"ち"],[13,1,"くら"],[20,1,"じ"],[22,1,"およ"]],"text":"昼の十二時になると、全地は暗くなって、三時に及んだ。"},{"ref":"Mark.15.34","start":41015034,"end":41015034,"break":"none","ruby":[[4,1,"じ"],[11,2,"おおごえ"],[34,1,"さけ"],[45,1,"かみ"],[49,1,"かみ"],[60,2,"みす"],[75,2,"いみ"]],"text":"そして三時に、イエスは大声で、「エロイ、エロイ、ラマ、サバクタニ」と叫ばれた。それは「わが神、わが神、どうしてわたしをお見捨てになったのですか」という意味である。"},{"ref":"Mark.15.35","start":41015035,"end":41015035,"break":"none","ruby":[[7,1,"た"],[14,2,"ひとびと"],[21,1,"き"],[24,1,"い"],[36,1,"よ"]],"text":"すると、そばに立っていたある人々が、これを聞いて言った、「そら、エリヤを呼んでいる」。"},{"ref":"Mark.15.36","start":41015036,"end":41015036,"break":"none","ruby":[[4,1,"ひと"],[6,1,"はし"],[9,1,"い"],[12,2,"かいめん"],[15,1,"す"],[20,1,"しゅ"],[22,1,"ふく"],[26,1,"あし"],[28,1,"ぼう"],[37,1,"の"],[45,1,"い"],[50,1,"ま"],[57,1,"かれ"],[63,1,"く"],[70,1,"み"]],"text":"ひとりの人が走って行き、海綿に酢いぶどう酒を含ませて葦の棒につけ、イエスに飲ませようとして言った、「待て、エリヤが彼をおろしに来るかどうか、見ていよう」。"},{"ref":"Mark.15.37","start":41015037,"end":41015037,"break":"none","ruby":[[4,1,"こえ"],[5,1,"たか"],[7,1,"さけ"],[14,1,"いき"]],"text":"イエスは声高く叫んで、ついに息をひきとられた。"},{"ref":"Mark.15.38","start":41015038,"end":41015038,"break":"none","ruby":[[5,2,"しんでん"],[8,1,"まく"],[10,1,"うえ"],[13,1,"した"],[16,2,"まっぷた"],[20,1,"さ"]],"text":"そのとき、神殿の幕が上から下まで真二つに裂けた。"},{"ref":"Mark.15.39","start":41015039,"end":41015039,"break":"none","ruby":[[8,1,"た"],[13,3,"ひゃくそつちょう"],[25,1,"いき"],[35,1,"み"],[37,1,"い"],[49,1,"ひと"],[51,1,"かみ"],[53,1,"こ"]],"text":"イエスにむかって立っていた百卒長は、このようにして息をひきとられたのを見て言った、「まことに、この人は神の子であった」。"},{"ref":"Mark.15.40","start":41015040,"end":41015040,"break":"none","ruby":[[3,1,"とお"],[6,1,"ほう"],[9,1,"み"],[13,1,"おんな"],[22,1,"なか"],[35,1,"しょう"],[44,1,"はは"]],"text":"また、遠くの方から見ている女たちもいた。その中には、マグダラのマリヤ、小ヤコブとヨセとの母マリヤ、またサロメがいた。"},{"ref":"Mark.15.41","start":41015041,"end":41015041,"break":"none","ruby":[[0,1,"かれ"],[24,1,"したが"],[27,1,"つか"],[30,1,"おんな"],[49,1,"とも"],[57,1,"のぼ"],[62,1,"おお"],[65,1,"おんな"]],"text":"彼らはイエスがガリラヤにおられたとき、そのあとに従って仕えた女たちであった。なおそのほか、イエスと共にエルサレムに上ってきた多くの女たちもいた。"},{"ref":"Mark.15.42","start":41015042,"end":41015042,"break":"paragraph","ruby":[[6,1,"ゆう"],[17,1,"ひ"],[19,2,"じゅんび"],[22,1,"ひ"],[28,3,"あんそくにち"],[32,2,"ぜんじつ"]],"text":"さて、すでに夕がたになったが、その日は準備の日、すなわち安息日の前日であったので、"},{"ref":"Mark.15.43","start":41015043,"end":41015043,"break":"none","ruby":[[10,2,"だいたん"],[18,1,"ところ"],[20,1,"い"],[32,1,"と"],[37,1,"ねが"],[41,1,"かれ"],[43,2,"ちい"],[46,1,"たか"],[48,2,"ぎいん"],[55,1,"かれ"],[56,2,"じしん"],[59,1,"かみ"],[61,1,"くに"],[63,1,"ま"],[65,1,"のぞ"],[70,1,"ひと"]],"text":"アリマタヤのヨセフが大胆にもピラトの所へ行き、イエスのからだの引取りかたを願った。彼は地位の高い議員であって、彼自身、神の国を待ち望んでいる人であった。"},{"ref":"Mark.15.44","start":41015044,"end":41015044,"break":"none","ruby":[[12,1,"し"],[22,2,"ふしん"],[25,1,"おも"],[28,3,"ひゃくそつちょう"],[32,1,"よ"],[38,1,"し"],[44,1,"たず"]],"text":"ピラトは、イエスがもはや死んでしまったのかと不審に思い、百卒長を呼んで、もう死んだのかと尋ねた。"},{"ref":"Mark.15.45","start":41015045,"end":41015045,"break":"none","ruby":[[4,3,"ひゃくそつちょう"],[9,1,"たし"],[13,1,"うえ"],[15,2,"したい"],[22,1,"わた"]],"text":"そして、百卒長から確かめた上、死体をヨセフに渡した。"},{"ref":"Mark.15.46","start":41015046,"end":41015046,"break":"none","ruby":[[8,3,"あまぬの"],[12,1,"か"],[14,1,"もと"],[30,3,"あまぬの"],[34,1,"つつ"],[37,1,"いわ"],[39,1,"ほ"],[42,1,"つく"],[45,1,"はか"],[47,1,"おさ"],[50,1,"はか"],[52,2,"いりぐち"],[55,1,"いし"]],"text":"そこで、ヨセフは亜麻布を買い求め、イエスをとりおろして、その亜麻布に包み、岩を掘って造った墓に納め、墓の入口に石をころがしておいた。"},{"ref":"Mark.15.47","start":41015047,"end":41015047,"break":"none","ruby":[[12,1,"はは"],[23,1,"おさ"],[28,2,"ばしょ"],[31,1,"み"]],"text":"マグダラのマリヤとヨセの母マリヤとは、イエスが納められた場所を見とどけた。"}]