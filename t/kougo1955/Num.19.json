[{"ref":"Num.19.1","start":4019001,"end":4019001,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"い"]],"text":"主はモーセとアロンに言われた、"},{"ref":"Num.19.2","start":4019002,"end":4019002,"break":"none","ruby":[[1,1,"しゅ"],[3,1,"めい"],[8,2,"りっぽう"],[11,1,"さだ"],[14,1,"つぎ"],[34,2,"ひとびと"],[37,1,"つ"],[41,2,"かんぜん"],[45,1,"きず"],[56,1,"お"],[64,1,"あか"],[66,2,"めうし"],[77,1,"ひ"]],"text":"「主の命じられた律法の定めは次のとおりである。すなわち『イスラエルの人々に告げて、完全で、傷がなく、まだくびきを負ったことのない赤い雌牛を、あなたのもとに引いてこさせ、"},{"ref":"Num.19.3","start":4019003,"end":4019003,"break":"none","ruby":[[3,2,"さいし"],[16,2,"しゅくえい"],[19,1,"そと"],[23,1,"だ"],[27,1,"かれ"],[29,1,"まえ"]],"text":"これを祭司エレアザルにわたして、宿営の外にひき出させ、彼の前でこれをほふらせなければならない。"},{"ref":"Num.19.4","start":4019004,"end":4019004,"break":"none","ruby":[[3,2,"さいし"],[12,1,"ゆび"],[19,1,"ち"],[21,1,"と"],[24,2,"かいけん"],[27,2,"まくや"],[30,1,"ひょう"],[32,1,"む"],[39,1,"ち"]],"text":"そして祭司エレアザルは、指をもってその血を取り、会見の幕屋の表に向かって、その血を七たびふりかけなければならない。"},{"ref":"Num.19.5","start":4019005,"end":4019005,"break":"none","ruby":[[5,2,"めうし"],[8,2,"じぶん"],[11,1,"め"],[13,1,"まえ"],[15,1,"や"],[21,1,"かわ"],[23,1,"にく"],[25,1,"ち"],[31,2,"おぶつ"],[34,1,"とも"],[36,1,"や"]],"text":"ついでその雌牛を自分の目の前で焼かせ、その皮と肉と血とは、その汚物と共に焼かなければならない。"},{"ref":"Num.19.6","start":4019006,"end":4019006,"break":"none","ruby":[[3,2,"さいし"],[6,2,"こうはく"],[9,1,"き"],[17,1,"ひ"],[19,1,"いと"],[22,1,"と"],[25,2,"めうし"],[28,1,"も"],[36,1,"な"],[38,1,"い"]],"text":"そして祭司は香柏の木と、ヒソプと、緋の糸とを取って雌牛の燃えているなかに投げ入れなければならない。"},{"ref":"Num.19.7","start":4019007,"end":4019007,"break":"none","ruby":[[3,2,"さいし"],[6,2,"いふく"],[9,1,"あら"],[12,1,"みず"],[14,1,"み"],[20,1,"のち"],[22,2,"しゅくえい"],[39,2,"さいし"],[42,1,"ゆう"],[45,1,"けが"]],"text":"そして祭司は衣服を洗い、水に身をすすいで後、宿営に、はいることができる。ただし祭司は夕まで汚れる。"},{"ref":"Num.19.8","start":4019008,"end":4019008,"break":"none","ruby":[[4,2,"めうし"],[7,1,"や"],[10,1,"もの"],[12,1,"みず"],[14,2,"いふく"],[17,1,"あら"],[20,1,"みず"],[22,1,"み"],[36,1,"かれ"],[38,1,"ゆう"],[41,1,"けが"]],"text":"またその雌牛を焼いた者も水で衣服を洗い、水に身をすすがなければならない。彼も夕まで汚れる。"},{"ref":"Num.19.9","start":4019009,"end":4019009,"break":"none","ruby":[[4,1,"み"],[6,1,"きよ"],[8,1,"もの"],[16,2,"めうし"],[19,1,"はい"],[21,1,"あつ"],[24,2,"しゅくえい"],[27,1,"そと"],[29,1,"きよ"],[31,1,"ところ"],[58,2,"ひとびと"],[61,2,"かいしゅう"],[67,1,"けが"],[70,1,"きよ"],[73,1,"みず"],[81,1,"そな"],[91,1,"つみ"],[93,1,"きよ"]],"text":"それから身の清い者がひとり、その雌牛の灰を集め、宿営の外の清い所にたくわえておかなければならない。これはイスラエルの人々の会衆のため、汚れを清める水をつくるために備えるものであって、罪を清めるものである。"},{"ref":"Num.19.10","start":4019010,"end":4019010,"break":"none","ruby":[[2,2,"めうし"],[5,1,"はい"],[7,1,"あつ"],[10,1,"もの"],[12,2,"いふく"],[15,1,"あら"],[28,1,"ひと"],[30,1,"ゆう"],[33,1,"けが"],[46,2,"ひとびと"],[55,1,"やど"],[60,2,"たこく"],[62,1,"じん"],[66,2,"えいきゅう"],[69,1,"まも"],[73,1,"さだ"]],"text":"その雌牛の灰を集めた者は衣服を洗わなければならない。その人は夕まで汚れる。これはイスラエルの人々と、そのうちに宿っている他国人との、永久に守るべき定めとしなければならない。"},{"ref":"Num.19.11","start":4019011,"end":4019011,"break":"paragraph","ruby":[[3,1,"ひと"],[5,2,"したい"],[8,1,"ふ"],[11,1,"もの"],[14,2,"なぬか"],[20,1,"けが"]],"text":"すべて人の死体に触れる者は、七日のあいだ汚れる。"},{"ref":"Num.19.12","start":4019012,"end":4019012,"break":"none","ruby":[[2,1,"ひと"],[5,1,"か"],[6,1,"め"],[8,2,"なぬか"],[10,1,"め"],[16,1,"はい"],[18,1,"みず"],[23,1,"み"],[25,1,"きよ"],[41,1,"きよ"],[57,1,"か"],[58,1,"め"],[60,2,"なぬか"],[62,1,"め"],[66,1,"み"],[68,1,"きよ"],[76,1,"きよ"]],"text":"その人は三日目と七日目とに、この灰の水をもって身を清めなければならない。そうすれば清くなるであろう。しかし、もし三日目と七日目とに、身を清めないならば、清くならないであろう。"},{"ref":"Num.19.13","start":4019013,"end":4019013,"break":"none","ruby":[[3,2,"しにん"],[6,2,"したい"],[9,1,"ふ"],[13,1,"み"],[15,1,"きよ"],[19,1,"もの"],[21,1,"しゅ"],[23,2,"まくや"],[26,1,"けが"],[28,1,"もの"],[33,1,"ひと"],[42,1,"た"],[54,1,"けが"],[57,1,"きよ"],[60,1,"みず"],[64,1,"み"],[66,1,"そそ"],[79,1,"ひと"],[81,1,"きよ"],[89,1,"けが"],[98,1,"み"]],"text":"すべて死人の死体に触れて、身を清めない者は主の幕屋を汚す者で、その人はイスラエルから断たれなければならない。汚れを清める水がその身に注ぎかけられないゆえ、その人は清くならず、その汚れは、なお、その身にあるからである。"},{"ref":"Num.19.14","start":4019014,"end":4019014,"break":"paragraph","ruby":[[0,1,"ひと"],[2,2,"てんまく"],[5,1,"なか"],[7,1,"し"],[10,1,"とき"],[12,1,"もち"],[15,2,"りっぽう"],[18,1,"つぎ"],[37,2,"てんまく"],[44,1,"もの"],[54,2,"てんまく"],[59,1,"もの"],[61,2,"なぬか"],[67,1,"けが"]],"text":"人が天幕の中で死んだ時に用いる律法は次のとおりである。すなわち、すべてその天幕にはいった者、およびすべてその天幕にいた者は七日のあいだ汚れる。"},{"ref":"Num.19.15","start":4019015,"end":4019015,"break":"none","ruby":[[3,1,"うえ"],[10,1,"うつわ"],[14,1,"けが"]],"text":"ふたで上をおおわない器はみな汚れる。"},{"ref":"Num.19.16","start":4019016,"end":4019016,"break":"none","ruby":[[4,1,"ころ"],[8,1,"もの"],[13,1,"し"],[16,1,"もの"],[21,1,"ひと"],[23,1,"ほね"],[28,1,"はか"],[33,2,"やがい"],[36,1,"ふ"],[39,1,"もの"],[41,1,"みな"],[43,2,"なぬか"],[49,1,"けが"]],"text":"つるぎで殺された者、または死んだ者、または人の骨、または墓などに、野外で触れる者は皆、七日のあいだ汚れる。"},{"ref":"Num.19.17","start":4019017,"end":4019017,"break":"none","ruby":[[0,1,"けが"],[3,1,"もの"],[8,1,"とき"],[12,1,"つみ"],[14,1,"きよ"],[17,1,"や"],[20,2,"めうし"],[23,1,"はい"],[25,1,"と"],[28,1,"うつわ"],[30,1,"い"],[33,1,"なが"],[36,1,"みず"],[41,1,"くわ"]],"text":"汚れた者があった時には、罪を清める焼いた雌牛の灰を取って器に入れ、流れの水をこれに加え、"},{"ref":"Num.19.18","start":4019018,"end":4019018,"break":"none","ruby":[[0,1,"み"],[2,1,"きよ"],[4,1,"もの"],[13,1,"と"],[19,1,"みず"],[21,1,"ひた"],[29,2,"てんまく"],[37,1,"うつわ"],[45,2,"ひとびと"],[49,1,"ほね"],[55,1,"ころ"],[59,1,"もの"],[65,1,"し"],[68,1,"もの"],[74,1,"はか"],[78,1,"ふ"],[81,1,"もの"]],"text":"身の清い者がひとりヒソプを取って、その水に浸し、これをその天幕と、すべての器と、そこにいた人々と、骨、あるいは殺された者、あるいは死んだ者、あるいは墓などに触れた者とにふりかけなければならない。"},{"ref":"Num.19.19","start":4019019,"end":4019019,"break":"none","ruby":[[6,1,"み"],[8,1,"きよ"],[10,1,"ひと"],[13,1,"か"],[14,1,"め"],[16,2,"なぬか"],[18,1,"め"],[23,1,"けが"],[49,2,"なぬか"],[51,1,"め"],[55,1,"ひと"],[57,1,"み"],[59,1,"きよ"],[62,2,"いふく"],[65,1,"あら"],[68,1,"みず"],[70,1,"み"],[89,1,"ゆう"],[94,1,"きよ"]],"text":"すなわちその身の清い人は三日目と七日目とにその汚れたものに、それをふりかけなければならない。そして七日目にその人は身を清め、衣服を洗い、水に身をすすがなければならない。そうすれば夕になって清くなるであろう。"},{"ref":"Num.19.20","start":4019020,"end":4019020,"break":"paragraph","ruby":[[4,1,"けが"],[7,1,"み"],[9,1,"きよ"],[13,1,"ひと"],[15,1,"しゅ"],[17,2,"せいじょ"],[20,1,"けが"],[22,1,"もの"],[27,1,"ひと"],[29,2,"かいしゅう"],[36,1,"た"],[48,1,"けが"],[51,1,"きよ"],[54,1,"みず"],[58,1,"み"],[60,1,"そそ"],[73,1,"ひと"],[75,1,"けが"]],"text":"しかし、汚れて身を清めない人は主の聖所を汚す者で、その人は会衆のうちから断たれなければならない。汚れを清める水がその身に注ぎかけられないゆえ、その人は汚れているからである。"},{"ref":"Num.19.21","start":4019021,"end":4019021,"break":"none","ruby":[[3,1,"かれ"],[6,2,"えいきゅう"],[9,1,"まも"],[13,1,"さだ"],[30,1,"けが"],[33,1,"きよ"],[36,1,"みず"],[43,1,"もの"],[45,2,"いふく"],[48,1,"あら"],[61,1,"けが"],[64,1,"きよ"],[67,1,"みず"],[69,1,"ふ"],[72,1,"もの"],[74,1,"ゆう"],[77,1,"けが"]],"text":"これは彼らの永久に守るべき定めとしなければならない。すなわち汚れを清める水をふりかけた者は衣服を洗わなければならない。また汚れを清める水に触れた者も夕まで汚れるであろう。"},{"ref":"Num.19.22","start":4019022,"end":4019022,"break":"none","ruby":[[3,1,"けが"],[6,1,"ひと"],[8,1,"ふ"],[11,1,"もの"],[13,1,"けが"],[22,1,"ふ"],[25,1,"ひと"],[27,1,"ゆう"],[30,1,"けが"]],"text":"すべて汚れた人の触れる物は汚れる。またそれに触れる人も夕まで汚れるであろう』」。"}]