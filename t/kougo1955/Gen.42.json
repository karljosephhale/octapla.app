[{"ref":"Gen.42.1","start":1042001,"end":1042001,"break":"paragraph","ruby":[[9,2,"こくもつ"],[15,1,"し"],[25,1,"い"],[38,1,"かお"],[40,2,"みあ"]],"text":"ヤコブはエジプトに穀物があると知って、むすこたちに言った、「あなたがたはなぜ顔を見合わせているのですか」。"},{"ref":"Gen.42.2","start":1042002,"end":1042002,"break":"none","ruby":[[2,1,"い"],[12,2,"こくもつ"],[34,1,"くだ"],[37,1,"い"],[53,2,"こくもつ"],[56,1,"か"],[75,1,"い"],[83,1,"し"],[85,1,"まぬか"]],"text":"また言った、「エジプトに穀物があるということだが、あなたがたはそこへ下って行って、そこから、われわれのため穀物を買ってきなさい。そうすれば、われわれは生きながらえて、死を免れるであろう」。"},{"ref":"Gen.42.3","start":1042003,"end":1042003,"break":"none","ruby":[[8,1,"にん"],[10,2,"きょうだい"],[13,2,"こくもつ"],[16,1,"か"],[26,1,"くだ"]],"text":"そこでヨセフの十人の兄弟は穀物を買うためにエジプトへ下った。"},{"ref":"Gen.42.4","start":1042004,"end":1042004,"break":"none","ruby":[[12,1,"おとうと"],[19,2,"きょうだい"],[24,2,"いっしょ"],[34,1,"かれ"],[36,1,"わざわい"],[38,1,"あ"],[42,1,"おそ"]],"text":"しかし、ヤコブはヨセフの弟ベニヤミンを兄弟たちと一緒にやらなかった。彼が災に会うのを恐れたからである。"},{"ref":"Gen.42.5","start":1042005,"end":1042005,"break":"none","ruby":[[10,1,"こ"],[13,2,"こくもつ"],[16,1,"か"],[20,2,"ひとびと"],[23,1,"ま"],[37,1,"ち"]],"text":"こうしてイスラエルの子らは穀物を買おうと人々に交じってやってきた。カナンの地にききんがあったからである。"},{"ref":"Gen.42.6","start":1042006,"end":1042006,"break":"paragraph","ruby":[[7,1,"くに"],[17,1,"くに"],[23,1,"たみ"],[25,2,"こくもつ"],[28,1,"う"],[42,2,"きょうだい"],[50,1,"ち"],[54,1,"ふ"],[57,1,"かれ"],[59,1,"はい"]],"text":"ときにヨセフは国のつかさであって、国のすべての民に穀物を売ることをしていた。ヨセフの兄弟たちはきて、地にひれ伏し、彼を拝した。"},{"ref":"Gen.42.7","start":1042007,"end":1042007,"break":"none","ruby":[[4,2,"きょうだい"],[9,1,"み"],[15,1,"し"],[20,1,"かれ"],[23,1,"む"],[28,1,"し"],[31,1,"もの"],[38,2,"あらあら"],[42,1,"かた"],[50,1,"かれ"],[53,1,"い"],[74,1,"かれ"],[77,1,"こた"],[82,2,"しょくりょう"],[85,1,"か"],[94,1,"ち"]],"text":"ヨセフは兄弟たちを見て、それと知ったが、彼らに向かっては知らぬ者のようにし、荒々しく語った。すなわち彼らに言った、「あなたがたはどこからきたのか」。彼らは答えた、「食糧を買うためにカナンの地からきました」。"},{"ref":"Gen.42.8","start":1042008,"end":1042008,"break":"none","ruby":[[5,2,"きょうだい"],[14,1,"し"],[21,1,"かれ"],[29,1,"し"]],"text":"ヨセフは、兄弟たちであるのを知っていたが、彼らはヨセフとは知らなかった。"},{"ref":"Gen.42.9","start":1042009,"end":1042009,"break":"none","ruby":[[7,1,"かれ"],[13,1,"み"],[15,1,"ゆめ"],[17,1,"おも"],[19,1,"だ"],[23,1,"かれ"],[26,1,"い"],[37,1,"まわ"],[39,1,"もの"],[44,1,"くに"]],"text":"ヨセフはかつて彼らについて見た夢を思い出して、彼らに言った、「あなたがたは回し者で、この国のすきをうかがうためにきたのです」。"},{"ref":"Gen.42.10","start":1042010,"end":1042010,"break":"none","ruby":[[0,1,"かれ"],[7,1,"こた"],[18,1,"しゅ"],[28,2,"しょくりょう"],[31,1,"か"]],"text":"彼らはヨセフに答えた、「いいえ、わが主よ、しもべらはただ食糧を買うためにきたのです。"},{"ref":"Gen.42.11","start":1042011,"end":1042011,"break":"none","ruby":[[5,1,"みな"],[11,1,"ひと"],[13,1,"こ"],[16,2,"しんじつ"],[19,1,"もの"],[28,1,"まわ"],[30,1,"もの"]],"text":"われわれは皆、ひとりの人の子で、真実な者です。しもべらは回し者ではありません」。"},{"ref":"Gen.42.12","start":1042012,"end":1042012,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[23,1,"くに"]],"text":"ヨセフは彼らに言った、「いや、あなたがたはこの国のすきをうかがうためにきたのです」。"},{"ref":"Gen.42.13","start":1042013,"end":1042013,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[15,1,"にん"],[16,2,"きょうだい"],[24,1,"ち"],[32,1,"ひと"],[34,1,"こ"],[38,1,"すえ"],[40,1,"おとうと"],[42,1,"いま"],[44,1,"ちち"],[46,2,"いっしょ"],[54,1,"た"]],"text":"彼らは言った、「しもべらは十二人兄弟で、カナンの地にいるひとりの人の子です。末の弟は今、父と一緒にいますが、他のひとりはいなくなりました」。"},{"ref":"Gen.42.14","start":1042014,"end":1042014,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[16,1,"い"],[29,1,"まわ"],[31,1,"もの"]],"text":"ヨセフは彼らに言った、「わたしが言ったとおり、あなたがたは回し者です。"},{"ref":"Gen.42.15","start":1042015,"end":1042015,"break":"none","ruby":[[28,1,"ちか"],[33,1,"すえ"],[35,1,"おとうと"],[55,1,"で"]],"text":"あなたがたをこうしてためしてみよう。パロのいのちにかけて誓います。末の弟がここにこなければ、あなたがたはここを出ることはできません。"},{"ref":"Gen.42.16","start":1042016,"end":1042016,"break":"none","ruby":[[13,1,"おとうと"],[15,1,"つ"],[49,2,"せいじつ"],[65,2,"ことば"],[86,1,"ちか"],[97,1,"たし"],[100,1,"まわ"],[102,1,"もの"]],"text":"あなたがたのひとりをやって弟を連れてこさせなさい。それまであなたがたをつないでおいて、あなたがたに誠実があるかどうか、あなたがたの言葉をためしてみよう。パロのいのちにかけて誓います。あなたがたは確かに回し者です」。"},{"ref":"Gen.42.17","start":1042017,"end":1042017,"break":"none","ruby":[[4,1,"かれ"],[9,2,"いっしょ"],[13,1,"か"],[15,1,"あいだ"],[17,3,"かんきんじょ"],[21,1,"い"]],"text":"ヨセフは彼らをみな一緒に三日の間、監禁所に入れた。"},{"ref":"Gen.42.18","start":1042018,"end":1042018,"break":"paragraph","ruby":[[1,1,"か"],[2,1,"め"],[8,1,"かれ"],[11,1,"い"],[27,1,"たす"],[39,1,"かみ"],[41,1,"おそ"]],"text":"三日目にヨセフは彼らに言った、「こうすればあなたがたは助かるでしょう。わたしは神を恐れます。"},{"ref":"Gen.42.19","start":1042019,"end":1042019,"break":"none","ruby":[[8,2,"しんじつ"],[11,1,"もの"],[15,2,"きょうだい"],[30,3,"かんきんじょ"],[34,1,"のこ"],[43,2,"こくもつ"],[46,1,"たずさ"],[49,1,"い"],[53,2,"かぞく"],[56,1,"う"],[59,1,"すく"]],"text":"もしあなたがたが真実な者なら、兄弟のひとりをあなたがたのいる監禁所に残し、あなたがたは穀物を携えて行って、家族の飢えを救いなさい。"},{"ref":"Gen.42.20","start":1042020,"end":1042020,"break":"none","ruby":[[3,1,"すえ"],[5,1,"おとうと"],[14,1,"つ"],[33,2,"ことば"],[51,1,"し"],[53,1,"まぬか"],[62,1,"かれ"]],"text":"そして末の弟をわたしのもとに連れてきなさい。そうすればあなたがたの言葉のほんとうであることがわかって、死を免れるでしょう」。彼らはそのようにした。"},{"ref":"Gen.42.21","start":1042021,"end":1042021,"break":"none","ruby":[[0,1,"かれ"],[3,1,"たがい"],[5,1,"い"],[10,1,"たし"],[18,1,"おとうと"],[20,1,"こと"],[22,1,"つみ"],[27,1,"かれ"],[33,1,"ねが"],[36,1,"とき"],[40,1,"こころ"],[42,1,"くる"],[46,1,"み"],[56,1,"き"],[58,1,"い"],[70,1,"くる"],[74,1,"あ"]],"text":"彼らは互に言った、「確かにわれわれは弟の事で罪がある。彼がしきりに願った時、その心の苦しみを見ながら、われわれは聞き入れなかった。それでこの苦しみに会うのだ」。"},{"ref":"Gen.42.22","start":1042022,"end":1042022,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[10,1,"い"],[28,2,"こども"],[31,1,"つみ"],[33,1,"おか"],[37,1,"い"],[62,1,"き"],[64,1,"い"],[74,1,"かれ"],[76,1,"ち"],[78,1,"むく"],[81,1,"う"]],"text":"ルベンが彼らに答えて言った、「わたしはあなたがたに、この子供に罪を犯すなと言ったではないか。それにもかかわらず、あなたがたは聞き入れなかった。それで彼の血の報いを受けるのです」。"},{"ref":"Gen.42.23","start":1042023,"end":1042023,"break":"none","ruby":[[0,1,"かれ"],[7,1,"き"],[16,1,"し"],[23,2,"そうご"],[26,1,"あいだ"],[28,3,"つうやくしゃ"]],"text":"彼らはヨセフが聞きわけているのを知らなかった。相互の間に通訳者がいたからである。"},{"ref":"Gen.42.24","start":1042024,"end":1042024,"break":"none","ruby":[[4,1,"かれ"],[7,1,"はな"],[10,1,"い"],[13,1,"な"],[18,1,"かえ"],[23,1,"かれ"],[26,1,"かた"],[39,1,"とら"],[43,1,"かれ"],[46,1,"め"],[48,1,"まえ"],[50,1,"しば"]],"text":"ヨセフは彼らを離れて行って泣き、また帰ってきて彼らと語り、そのひとりシメオンを捕えて、彼らの目の前で縛った。"},{"ref":"Gen.42.25","start":1042025,"end":1042025,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"めい"],[14,1,"かれ"],[17,1,"ふくろ"],[19,2,"こくもつ"],[22,1,"み"],[31,1,"ぎん"],[33,1,"ふくろ"],[35,1,"かえ"],[38,2,"どうちゅう"],[41,2,"しょくりょう"],[44,1,"あた"],[59,1,"かれ"]],"text":"そしてヨセフは人々に命じて、彼らの袋に穀物を満たし、めいめいの銀を袋に返し、道中の食料を与えさせた。ヨセフはこのように彼らにした。"},{"ref":"Gen.42.26","start":1042026,"end":1042026,"break":"paragraph","ruby":[[0,1,"かれ"],[3,2,"こくもつ"],[9,1,"お"],[16,1,"さ"]],"text":"彼らは穀物をろばに負わせてそこを去った。"},{"ref":"Gen.42.27","start":1042027,"end":1042027,"break":"none","ruby":[[6,1,"やど"],[12,2,"かいば"],[19,1,"ふくろ"],[24,1,"み"],[28,1,"ふくろ"],[30,1,"くち"],[32,2,"じぶん"],[35,1,"ぎん"]],"text":"そのひとりが宿で、ろばに飼葉をやるため袋をあけて見ると、袋の口に自分の銀があった。"},{"ref":"Gen.42.28","start":1042028,"end":1042028,"break":"none","ruby":[[0,1,"かれ"],[2,2,"きょうだい"],[7,1,"い"],[16,1,"ぎん"],[18,1,"かえ"],[27,1,"み"],[33,1,"ふくろ"],[35,1,"なか"],[44,1,"かれ"],[47,2,"ひじょう"],[50,1,"おどろ"],[53,1,"たがい"],[55,1,"ふる"],[60,1,"い"],[65,1,"かみ"],[80,2,"なにごと"]],"text":"彼は兄弟たちに言った、「わたしの銀は返してある。しかも見よ、それは袋の中にある」。そこで彼らは非常に驚き、互に震えながら言った、「神がわれわれにされたこのことは何事だろう」。"},{"ref":"Gen.42.29","start":1042029,"end":1042029,"break":"paragraph","ruby":[[4,1,"かれ"],[11,1,"ち"],[15,1,"ちち"],[23,1,"かえ"],[28,1,"み"],[30,1,"た"],[33,1,"こと"],[40,1,"つ"],[43,1,"い"]],"text":"こうして彼らはカナンの地にいる父ヤコブのもとに帰り、その身に起った事をことごとく告げて言った、"},{"ref":"Gen.42.30","start":1042030,"end":1042030,"break":"none","ruby":[[3,1,"くに"],[5,1,"きみ"],[13,2,"あらあら"],[17,1,"かた"],[20,1,"くに"],[26,1,"まわ"],[28,1,"もの"],[31,1,"い"]],"text":"「あの国の君は、われわれに荒々しく語り、国をうかがう回し者だと言いました。"},{"ref":"Gen.42.31","start":1042031,"end":1042031,"break":"none","ruby":[[5,1,"かれ"],[7,1,"こた"],[19,2,"しんじつ"],[22,1,"もの"],[27,1,"まわ"],[29,1,"もの"]],"text":"われわれは彼に答えました、『われわれは真実な者であって回し者ではない。"},{"ref":"Gen.42.32","start":1042032,"end":1042032,"break":"none","ruby":[[7,1,"にん"],[8,2,"きょうだい"],[12,1,"おな"],[14,1,"ちち"],[16,1,"こ"],[31,1,"すえ"],[33,1,"おとうと"],[35,1,"いま"],[36,1,"ちち"],[38,1,"とも"],[44,1,"ち"]],"text":"われわれは十二人兄弟で、同じ父の子である。ひとりはいなくなり、末の弟は今父と共にカナンの地にいる』。"},{"ref":"Gen.42.33","start":1042033,"end":1042033,"break":"none","ruby":[[2,1,"くに"],[4,1,"きみ"],[10,1,"ひと"],[17,1,"い"],[38,2,"しんじつ"],[41,1,"もの"],[47,1,"し"],[57,2,"きょうだい"],[71,1,"のこ"],[74,2,"こくもつ"],[77,1,"たずさ"],[80,1,"い"],[84,2,"かぞく"],[87,1,"う"],[90,1,"すく"]],"text":"その国の君であるその人はわれわれに言いました、『わたしはこうしてあなたがたの真実な者であるのを知ろう。あなたがたは兄弟のひとりをわたしのもとに残し、穀物を携えて行って、家族の飢えを救いなさい。"},{"ref":"Gen.42.34","start":1042034,"end":1042034,"break":"none","ruby":[[3,1,"すえ"],[5,1,"おとうと"],[14,1,"つ"],[33,1,"まわ"],[35,1,"もの"],[41,2,"しんじつ"],[44,1,"もの"],[50,1,"し"],[60,2,"きょうだい"],[63,1,"かえ"],[68,1,"くに"],[76,2,"とりひき"]],"text":"そして末の弟をわたしのもとに連れてきなさい。そうすればあなたがたが回し者ではなく、真実な者であるのを知って、あなたがたの兄弟を返し、この国であなたがたに取引させましょう』」。"},{"ref":"Gen.42.35","start":1042035,"end":1042035,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"ふくろ"],[8,1,"だ"],[11,1,"み"],[20,1,"かね"],[21,1,"つつ"],[24,1,"ふくろ"],[26,1,"なか"],[34,1,"かれ"],[37,1,"ちち"],[39,1,"かね"],[40,1,"つつ"],[43,1,"み"],[45,1,"おそ"]],"text":"彼らが袋のものを出して見ると、めいめいの金包みが袋の中にあったので、彼らも父も金包みを見て恐れた。"},{"ref":"Gen.42.36","start":1042036,"end":1042036,"break":"none","ruby":[[0,1,"ちち"],[5,1,"かれ"],[8,1,"い"],[23,1,"こ"],[25,1,"うしな"],[52,2,"こんど"],[62,1,"と"],[64,1,"さ"],[77,1,"み"],[85,1,"く"]],"text":"父ヤコブは彼らに言った、「あなたがたはわたしに子を失わせた。ヨセフはいなくなり、シメオンもいなくなった。今度はベニヤミンをも取り去る。これらはみなわたしの身にふりかかって来るのだ」。"},{"ref":"Gen.42.37","start":1042037,"end":1042037,"break":"none","ruby":[[4,1,"ちち"],[6,1,"い"],[17,1,"かれ"],[26,1,"つ"],[29,1,"かえ"],[45,1,"こ"],[47,1,"ころ"],[57,1,"かれ"],[63,1,"て"],[89,1,"かれ"],[91,1,"つ"],[94,1,"かえ"]],"text":"ルベンは父に言った、「もしわたしが彼をあなたのもとに連れて帰らなかったら、わたしのふたりの子を殺してください。ただ彼をわたしの手にまかせてください。わたしはきっと、あなたのもとに彼を連れて帰ります」。"},{"ref":"Gen.42.38","start":1042038,"end":1042038,"break":"none","ruby":[[4,1,"い"],[13,1,"こ"],[21,1,"とも"],[23,1,"くだ"],[26,1,"い"],[35,1,"かれ"],[37,1,"あに"],[39,1,"し"],[47,1,"かれ"],[49,1,"のこ"],[67,1,"い"],[69,1,"みち"],[71,1,"かれ"],[73,1,"わざわい"],[75,1,"あ"],[94,1,"かな"],[98,2,"よみ"],[101,1,"くだ"]],"text":"ヤコブは言った、「わたしの子はあなたがたと共に下って行ってはならない。彼の兄は死に、ただひとり彼が残っているのだから。もしあなたがたの行く道で彼が災に会えば、あなたがたは、しらがのわたしを悲しんで陰府に下らせるであろう」。"}]