[{"ref":"Num.14.1","start":4014001,"end":4014001,"break":"paragraph","ruby":[[4,2,"かいしゅう"],[9,1,"こえ"],[14,1,"さけ"],[17,1,"たみ"],[21,1,"よ"],[23,1,"な"],[25,1,"あ"]],"text":"そこで、会衆はみな声をあげて叫び、民はその夜、泣き明かした。"},{"ref":"Num.14.2","start":4014002,"end":4014002,"break":"none","ruby":[[8,2,"ひとびと"],[30,1,"ぜん"],[31,2,"かいしゅう"],[34,1,"かれ"],[37,1,"い"],[56,1,"くに"],[58,1,"し"],[73,2,"あらの"],[76,1,"し"]],"text":"またイスラエルの人々はみなモーセとアロンにむかってつぶやき、全会衆は彼らに言った、「ああ、わたしたちはエジプトの国で死んでいたらよかったのに。この荒野で死んでいたらよかったのに。"},{"ref":"Num.14.3","start":4014003,"end":4014003,"break":"none","ruby":[[5,1,"しゅ"],[15,1,"ち"],[17,1,"つ"],[27,1,"たお"],[40,2,"さいし"],[62,1,"かえ"],[64,1,"ほう"],[70,1,"よ"]],"text":"なにゆえ、主はわたしたちをこの地に連れてきて、つるぎに倒れさせ、またわたしたちの妻子をえじきとされるのであろうか。エジプトに帰る方が、むしろ良いではないか」。"},{"ref":"Num.14.4","start":4014004,"end":4014004,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"たがい"],[5,1,"い"],[24,1,"た"],[33,1,"かえ"]],"text":"彼らは互に言った、「わたしたちはひとりのかしらを立てて、エジプトに帰ろう」。"},{"ref":"Num.14.5","start":4014005,"end":4014005,"break":"none","ruby":[[18,2,"ひとびと"],[21,1,"ぜん"],[22,2,"かいしゅう"],[25,1,"まえ"]],"text":"そこで、モーセとアロンはイスラエルの人々の全会衆の前でひれふした。"},{"ref":"Num.14.6","start":4014006,"end":4014006,"break":"none","ruby":[[7,1,"ち"],[9,1,"さぐ"],[12,1,"もの"],[20,1,"こ"],[31,1,"こ"],[39,2,"いふく"],[42,1,"さ"]],"text":"このとき、その地を探った者のうちのヌンの子ヨシュアとエフンネの子カレブは、その衣服を裂き、"},{"ref":"Num.14.7","start":4014007,"end":4014007,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"ぜん"],[10,2,"かいしゅう"],[13,1,"い"],[24,1,"い"],[26,1,"めぐ"],[29,1,"さぐ"],[32,1,"ち"],[34,2,"ひじょう"],[37,1,"よ"],[39,1,"ち"]],"text":"イスラエルの人々の全会衆に言った、「わたしたちが行き巡って探った地は非常に良い地です。"},{"ref":"Num.14.8","start":4014008,"end":4014008,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"よ"],[23,1,"ち"],[25,1,"みちび"],[28,1,"い"],[53,1,"ちち"],[55,1,"みつ"],[57,1,"なが"],[62,1,"ち"]],"text":"もし、主が良しとされるならば、わたしたちをその地に導いて行って、それをわたしたちにくださるでしょう。それは乳と蜜の流れている地です。"},{"ref":"Num.14.9","start":4014009,"end":4014009,"break":"none","ruby":[[3,1,"しゅ"],[20,1,"ち"],[22,1,"たみ"],[24,1,"おそ"],[34,1,"かれ"],[43,1,"く"],[45,1,"もの"],[53,1,"かれ"],[56,1,"まも"],[58,1,"もの"],[60,1,"す"],[62,1,"のぞ"],[68,1,"しゅ"],[76,1,"とも"],[86,1,"かれ"],[89,1,"おそ"]],"text":"ただ、主にそむいてはなりません。またその地の民を恐れてはなりません。彼らはわたしたちの食い物にすぎません。彼らを守る者は取り除かれます。主がわたしたちと共におられますから、彼らを恐れてはなりません」。"},{"ref":"Num.14.10","start":4014010,"end":4014010,"break":"none","breaks":[[23,"paragraph"]],"ruby":[[4,2,"かいしゅう"],[9,1,"いし"],[11,1,"かれ"],[14,1,"う"],[16,1,"ころ"],[28,1,"しゅ"],[30,2,"えいこう"],[34,2,"かいけん"],[37,2,"まくや"],[51,1,"ひと"],[53,1,"あらわ"]],"text":"ところが会衆はみな石で彼らを撃ち殺そうとした。そのとき、主の栄光が、会見の幕屋からイスラエルのすべての人に現れた。"},{"ref":"Num.14.11","start":4014011,"end":4014011,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[14,1,"たみ"],[24,1,"あなど"],[42,1,"かれ"],[48,1,"い"],[54,1,"かれ"],[65,1,"しん"]],"text":"主はモーセに言われた、「この民はいつまでわたしを侮るのか。わたしがもろもろのしるしを彼らのうちに行ったのに、彼らはいつまでわたしを信じないのか。"},{"ref":"Num.14.12","start":4014012,"end":4014012,"break":"none","ruby":[[4,2,"えきびょう"],[10,1,"かれ"],[13,1,"う"],[15,1,"ほろ"],[23,1,"かれ"],[28,1,"おお"],[32,1,"つよ"],[34,2,"こくみん"]],"text":"わたしは疫病をもって彼らを撃ち滅ぼし、あなたを彼らよりも大いなる強い国民としよう」。"},{"ref":"Num.14.13","start":4014013,"end":4014013,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"い"],[23,1,"ちから"],[31,1,"たみ"],[33,1,"かれ"],[40,1,"みちび"],[42,1,"だ"],[49,1,"き"]],"text":"モーセは主に言った、「エジプトびとは、あなたが力をもって、この民を彼らのうちから導き出されたことを聞いて、"},{"ref":"Num.14.14","start":4014014,"end":4014014,"break":"none","ruby":[[2,1,"ち"],[4,2,"じゅうみん"],[7,1,"つ"],[15,1,"かれ"],[19,1,"しゅ"],[29,1,"たみ"],[38,1,"しゅ"],[51,1,"あらわ"],[58,1,"くも"],[61,1,"かれ"],[64,1,"うえ"],[71,1,"ひる"],[73,1,"くも"],[75,1,"はしら"],[81,1,"よる"],[83,1,"ひ"],[85,1,"はしら"],[94,1,"かれ"],[97,1,"まえ"],[99,1,"い"],[105,1,"き"]],"text":"この地の住民に告げるでしょう。彼らは、主なるあなたが、この民のうちにおられ、主なるあなたが、まのあたり現れ、あなたの雲が、彼らの上にとどまり、昼は雲の柱のうちに、夜は火の柱のうちにあって、彼らの前に行かれるのを聞いたのです。"},{"ref":"Num.14.15","start":4014015,"end":4014015,"break":"none","ruby":[[12,1,"たみ"],[17,1,"のこ"],[20,1,"ころ"],[35,1,"き"],[38,2,"こくみん"],[41,1,"かた"]],"text":"いま、もし、あなたがこの民をひとり残らず殺されるならば、あなたのことを聞いた国民は語って、"},{"ref":"Num.14.16","start":4014016,"end":4014016,"break":"none","ruby":[[1,1,"しゅ"],[3,1,"あた"],[7,1,"ちか"],[10,1,"ち"],[15,1,"たみ"],[17,1,"みちび"],[19,1,"い"],[34,1,"かれ"],[37,2,"あらの"],[40,1,"ころ"],[47,1,"い"]],"text":"『主は与えると誓った地に、この民を導き入れることができなかったため、彼らを荒野で殺したのだ』と言うでしょう。"},{"ref":"Num.14.17","start":4014017,"end":4014017,"break":"none","ruby":[[8,2,"やくそく"],[19,1,"しゅ"],[21,1,"おお"],[25,1,"ちから"],[27,1,"あらわ"]],"text":"どうぞ、あなたが約束されたように、いま主の大いなる力を現してください。"},{"ref":"Num.14.18","start":4014018,"end":4014018,"break":"none","ruby":[[9,1,"しゅ"],[11,1,"いか"],[25,1,"と"],[28,1,"つみ"],[36,1,"もの"],[42,1,"ばつ"],[46,1,"もの"],[49,1,"けっ"],[57,1,"ちち"],[59,1,"つみ"],[61,1,"こ"],[63,1,"むく"],[70,1,"だい"],[72,1,"およ"],[75,1,"もの"],[81,1,"い"]],"text":"あなたはかつて、『主は怒ることおそく、いつくしみに富み、罪ととがをゆるす者、しかし、罰すべき者は、決してゆるさず、父の罪を子に報いて、三、四代に及ぼす者である』と言われました。"},{"ref":"Num.14.19","start":4014019,"end":4014019,"break":"none","ruby":[[8,1,"おお"],[33,1,"いま"],[43,1,"たみ"],[56,1,"たみ"],[58,1,"つみ"]],"text":"どうぞ、あなたの大いなるいつくしみによって、エジプトからこのかた、今にいたるまで、この民をゆるされたように、この民の罪をおゆるしください」。"},{"ref":"Num.14.20","start":4014020,"end":4014020,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[16,2,"ことば"]],"text":"主は言われた、「わたしはあなたの言葉のとおりにゆるそう。"},{"ref":"Num.14.21","start":4014021,"end":4014021,"break":"none","ruby":[[8,1,"い"],[16,1,"しゅ"],[18,2,"えいこう"],[22,1,"ぜん"],[23,2,"せかい"],[26,1,"み"]],"text":"しかし、わたしは生きている。また主の栄光が、全世界に満ちている。"},{"ref":"Num.14.22","start":4014022,"end":4014022,"break":"none","ruby":[[4,2,"えいこう"],[17,2,"あらの"],[20,1,"い"],[27,1,"み"],[38,1,"ど"],[44,1,"こころ"],[52,1,"こえ"],[54,1,"き"],[64,2,"ひとびと"]],"text":"わたしの栄光と、わたしがエジプトと荒野で行ったしるしを見ながら、このように十度もわたしを試みて、わたしの声に聞きしたがわなかった人々はひとりも、"},{"ref":"Num.14.23","start":4014023,"end":4014023,"break":"none","ruby":[[7,1,"かれ"],[10,2,"せんぞ"],[15,1,"あた"],[19,1,"ちか"],[22,1,"ち"],[24,1,"み"],[38,1,"あなど"],[41,2,"ひとびと"],[48,1,"み"]],"text":"わたしがかつて彼らの先祖たちに与えると誓った地を見ないであろう。またわたしを侮った人々も、それを見ないであろう。"},{"ref":"Num.14.24","start":4014024,"end":4014024,"break":"none","ruby":[[15,1,"ちが"],[18,1,"こころ"],[30,2,"かんぜん"],[33,1,"したが"],[43,1,"かれ"],[45,1,"い"],[50,1,"ち"],[52,1,"かれ"],[54,1,"みちび"],[56,1,"い"],[64,1,"かれ"],[66,2,"しそん"],[72,2,"しょゆう"]],"text":"ただし、わたしのしもべカレブは違った心をもっていて、わたしに完全に従ったので、わたしは彼が行ってきた地に彼を導き入れるであろう。彼の子孫はそれを所有するにいたるであろう。"},{"ref":"Num.14.25","start":4014025,"end":4014025,"break":"none","ruby":[[0,1,"たに"],[16,1,"す"],[34,1,"み"],[41,2,"こうかい"],[44,1,"みち"],[46,2,"あらの"],[49,1,"すす"]],"text":"谷にはアマレクびととカナンびとが住んでいるから、あなたがたは、あす、身をめぐらして紅海の道を荒野へ進みなさい」。"},{"ref":"Num.14.26","start":4014026,"end":4014026,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"い"]],"text":"主はモーセとアロンに言われた、"},{"ref":"Num.14.27","start":4014027,"end":4014027,"break":"none","ruby":[[15,1,"わる"],[17,2,"かいしゅう"],[24,1,"しの"],[45,2,"ひとびと"],[63,1,"き"]],"text":"「わたしにむかってつぶやくこの悪い会衆をいつまで忍ぶことができようか。わたしはイスラエルの人々が、わたしにむかってつぶやくのを聞いた。"},{"ref":"Num.14.28","start":4014028,"end":4014028,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[14,1,"しゅ"],[16,1,"い"],[26,1,"い"],[43,1,"みみ"],[45,1,"かた"]],"text":"あなたは彼らに言いなさい、『主は言われる、「わたしは生きている。あなたがたが、わたしの耳に語ったように、わたしはあなたがたにするであろう。"},{"ref":"Num.14.29","start":4014029,"end":4014029,"break":"none","ruby":[[6,2,"したい"],[15,2,"あらの"],[18,1,"たお"],[48,1,"もの"],[58,1,"かぞ"],[65,1,"さい"],[66,2,"いじょう"],[69,1,"もの"],[73,1,"たお"]],"text":"あなたがたは死体となって、この荒野に倒れるであろう。あなたがたのうち、わたしにむかってつぶやいた者、すなわち、すべて数えられた二十歳以上の者はみな倒れるであろう。"},{"ref":"Num.14.30","start":4014030,"end":4014030,"break":"none","ruby":[[5,1,"こ"],[14,1,"こ"],[38,1,"す"],[46,1,"て"],[51,1,"ちか"],[54,1,"ち"]],"text":"エフンネの子カレブと、ヌンの子ヨシュアのほかは、わたしがかつて、あなたがたを住まわせようと、手をあげて誓った地に、はいることができないであろう。"},{"ref":"Num.14.31","start":4014031,"end":4014031,"break":"none","ruby":[[22,1,"い"],[31,2,"こども"],[39,1,"みちび"],[51,1,"かれ"],[66,1,"ち"],[68,1,"し"]],"text":"しかし、あなたがたが、えじきになるであろうと言ったあなたがたの子供は、わたしが導いて、はいるであろう。彼らはあなたがたが、いやしめた地を知るようになるであろう。"},{"ref":"Num.14.32","start":4014032,"end":4014032,"break":"none","ruby":[[9,2,"したい"],[17,2,"あらの"],[20,1,"たお"]],"text":"しかしあなたがたは死体となってこの荒野に倒れるであろう。"},{"ref":"Num.14.33","start":4014033,"end":4014033,"break":"none","ruby":[[6,1,"こ"],[17,2,"したい"],[20,2,"あらの"],[23,1,"く"],[25,1,"は"],[32,1,"ねん"],[38,2,"あらの"],[41,2,"ひつじかい"],[53,2,"ふしん"],[56,1,"つみ"],[58,1,"お"]],"text":"あなたがたの子たちは、あなたがたの死体が荒野に朽ち果てるまで四十年のあいだ、荒野で羊飼となり、あなたがたの不信の罪を負うであろう。"},{"ref":"Num.14.34","start":4014034,"end":4014034,"break":"none","ruby":[[9,1,"ち"],[11,1,"さぐ"],[16,1,"にち"],[18,1,"ひ"],[19,1,"かず"],[29,1,"にち"],[32,1,"ねん"],[39,1,"ねん"],[45,2,"じぶん"],[48,1,"つみ"],[50,1,"お"],[63,1,"とお"],[71,1,"し"]],"text":"あなたがたは、かの地を探った四十日の日数にしたがい、その一日を一年として、四十年のあいだ、自分の罪を負い、わたしがあなたがたを遠ざかったことを知るであろう」。"},{"ref":"Num.14.35","start":4014035,"end":4014035,"break":"none","ruby":[[0,1,"しゅ"],[10,1,"い"],[17,1,"かなら"],[23,1,"さか"],[27,1,"あつ"],[33,1,"わる"],[35,2,"かいしゅう"],[47,1,"おこな"],[54,1,"かれ"],[59,2,"あらの"],[62,1,"く"],[68,1,"し"]],"text":"主なるわたしがこれを言う。わたしは必ずわたしに逆らって集まったこの悪い会衆に、これをことごとく行うであろう。彼らはこの荒野に朽ち、ここで死ぬであろう』」。"},{"ref":"Num.14.36","start":4014036,"end":4014036,"break":"paragraph","ruby":[[17,1,"ち"],[19,1,"さぐ"],[22,1,"い"],[25,1,"かえ"],[33,1,"ち"],[35,1,"わる"],[37,1,"い"],[40,1,"ぜん"],[41,2,"かいしゅう"],[60,2,"ひとびと"]],"text":"こうして、モーセにつかわされ、かの地を探りに行き、帰ってきて、その地を悪く言い、全会衆を、モーセにむかって、つぶやかせた人々、"},{"ref":"Num.14.37","start":4014037,"end":4014037,"break":"none","ruby":[[7,1,"ち"],[9,1,"わる"],[11,1,"い"],[17,2,"ひとびと"],[21,2,"えきびょう"],[28,1,"しゅ"],[30,1,"まえ"],[32,1,"し"]],"text":"すなわち、その地を悪く言いふらした人々は、疫病にかかって主の前に死んだが、"},{"ref":"Num.14.38","start":4014038,"end":4014038,"break":"none","ruby":[[2,1,"ち"],[4,1,"さぐ"],[7,1,"い"],[10,2,"ひとびと"],[19,1,"こ"],[31,1,"こ"],[37,1,"い"],[39,1,"のこ"]],"text":"その地を探りに行った人々のうち、ヌンの子ヨシュアと、エフンネの子カレブとは生き残った。"},{"ref":"Num.14.39","start":4014039,"end":4014039,"break":"paragraph","ruby":[[23,2,"ひとびと"],[26,1,"つ"],[32,1,"たみ"],[34,2,"ひじょう"],[37,1,"かな"]],"text":"モーセが、これらのことを、イスラエルのすべての人々に告げたとき、民は非常に悲しみ、"},{"ref":"Num.14.40","start":4014040,"end":4014040,"break":"none","ruby":[[0,1,"あさ"],[1,1,"はや"],[3,1,"お"],[6,1,"やま"],[8,1,"いただ"],[11,1,"のぼ"],[14,1,"い"],[34,1,"しゅ"],[36,2,"やくそく"],[41,1,"ところ"],[43,1,"のぼ"],[46,1,"い"],[56,1,"つみ"],[58,1,"おか"]],"text":"朝早く起きて山の頂きに登って言った、「わたしたちはここにいる。さあ、主が約束された所へ上って行こう。わたしたちは罪を犯したのだから」。"},{"ref":"Num.14.41","start":4014041,"end":4014041,"break":"none","ruby":[[4,1,"い"],[21,1,"と"],[44,1,"しゅ"],[46,1,"めい"]],"text":"モーセは言った、「あなたがたは、それをなし遂げることもできないのに、どうして、そのように主の命にそむくのか。"},{"ref":"Num.14.42","start":4014042,"end":4014042,"break":"none","ruby":[[6,1,"のぼ"],[9,1,"い"],[18,1,"しゅ"],[43,1,"てき"],[45,1,"まえ"],[48,1,"う"],[50,1,"やぶ"]],"text":"あなたがたは上って行ってはならない。主があなたがたのうちにおられないから、あなたがたは敵の前に、撃ち破られるであろう。"},{"ref":"Num.14.43","start":4014043,"end":4014043,"break":"none","ruby":[[25,1,"まえ"],[43,1,"たお"],[62,1,"しゅ"],[64,1,"したが"],[73,1,"しゅ"],[81,1,"とも"]],"text":"そこには、アマレクびとと、カナンびとがあなたがたの前にいるから、あなたがたは、つるぎに倒れるであろう。あなたがたがそむいて、主に従わなかったゆえ、主はあなたがたと共におられないからである」。"},{"ref":"Num.14.44","start":4014044,"end":4014044,"break":"none","ruby":[[4,1,"かれ"],[14,1,"やま"],[16,1,"いただき"],[18,1,"のぼ"],[26,1,"しゅ"],[28,2,"けいやく"],[31,1,"はこ"],[40,2,"しゅくえい"],[43,1,"なか"],[46,1,"で"]],"text":"しかし、彼らは、ほしいままに山の頂に登った。ただし、主の契約の箱と、モーセとは、宿営の中から出なかった。"},{"ref":"Num.14.45","start":4014045,"end":4014045,"break":"none","ruby":[[6,1,"やま"],[8,1,"す"],[27,1,"くだ"],[33,1,"かれ"],[36,1,"う"],[38,1,"やぶ"],[46,1,"お"]],"text":"そこで、その山に住んでいたアマレクびとと、カナンびとが下ってきて、彼らを撃ち破り、ホルマまで追ってきた。"}]