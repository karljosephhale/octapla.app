[{"ref":"2Kgs.23.1","start":12023001,"end":12023001,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"ひと"],[21,2,"ちょうろう"],[31,1,"あつ"]],"text":"そこで王は人をつかわしてユダとエルサレムの長老たちをことごとく集めた。"},{"ref":"2Kgs.23.2","start":12023002,"end":12023002,"break":"none","ruby":[[3,1,"おう"],[13,2,"ひとびと"],[27,2,"じゅうみん"],[32,2,"さいし"],[35,3,"よげんしゃ"],[42,2,"だいしょう"],[49,1,"たみ"],[51,1,"したが"],[54,1,"しゅ"],[56,1,"みや"],[62,1,"しゅ"],[64,1,"みや"],[66,1,"み"],[71,2,"けいやく"],[74,1,"しょ"],[76,2,"ことば"],[84,1,"かれ"],[87,1,"よ"],[89,1,"き"]],"text":"そして王はユダのもろもろの人々と、エルサレムのすべての住民および祭司、預言者ならびに大小のすべての民を従えて主の宮にのぼり、主の宮で見つかった契約の書の言葉をことごとく彼らに読み聞かせた。"},{"ref":"2Kgs.23.3","start":12023003,"end":12023003,"break":"none","ruby":[[0,1,"つ"],[3,1,"おう"],[5,1,"はしら"],[12,1,"た"],[16,1,"しゅ"],[18,1,"まえ"],[20,2,"けいやく"],[23,1,"た"],[26,1,"しゅ"],[28,1,"したが"],[31,1,"あゆ"],[34,1,"こころ"],[39,2,"せいしん"],[47,1,"しゅ"],[49,1,"いまし"],[58,1,"さだ"],[62,1,"まも"],[67,2,"しょもつ"],[79,2,"けいやく"],[82,2,"ことば"],[85,1,"おこな"],[90,1,"ちか"],[94,1,"たみ"],[96,1,"みな"],[99,2,"けいやく"],[102,1,"くわ"]],"text":"次いで王は柱のかたわらに立って、主の前に契約を立て、主に従って歩み、心をつくし精神をつくして、主の戒めと、あかしと、定めとを守り、この書物にしるされているこの契約の言葉を行うことを誓った。民は皆その契約に加わった。"},{"ref":"2Kgs.23.4","start":12023004,"end":12023004,"break":"paragraph","ruby":[[4,1,"おう"],[6,1,"だい"],[7,2,"さいし"],[18,1,"つ"],[20,2,"さいし"],[27,1,"もん"],[29,1,"まも"],[31,1,"もの"],[35,1,"めい"],[39,1,"しゅ"],[41,2,"しんでん"],[53,1,"てん"],[55,2,"ばんしょう"],[62,1,"つく"],[70,1,"うつわ"],[72,1,"と"],[74,1,"だ"],[84,1,"そと"],[91,1,"の"],[96,1,"や"],[101,1,"はい"],[107,1,"も"],[110,1,"い"]],"text":"こうして王は大祭司ヒルキヤと、それに次ぐ祭司たちおよび門を守る者どもに命じて、主の神殿からバアルとアシラと天の万象とのために作ったもろもろの器を取り出させ、エルサレムの外のキデロンの野でそれを焼き、その灰をベテルに持って行かせた。"},{"ref":"2Kgs.23.5","start":12023005,"end":12023005,"break":"none","ruby":[[6,2,"まちまち"],[15,2,"しゅうい"],[20,1,"たか"],[22,1,"ところ"],[24,1,"こう"],[34,1,"おう"],[38,2,"にんめい"],[42,2,"さいし"],[47,1,"はい"],[56,1,"ひ"],[58,1,"つき"],[60,2,"せいしゅく"],[63,1,"てん"],[65,2,"ばんしょう"],[69,1,"こう"],[73,1,"もの"],[78,1,"はい"]],"text":"また、ユダの町々とエルサレムの周囲にある高き所で香をたくためにユダの王たちが任命した祭司たちを廃し、またバアルと日と月と星宿と天の万象とに香をたく者どもをも廃した。"},{"ref":"2Kgs.23.6","start":12023006,"end":12023006,"break":"none","ruby":[[0,1,"かれ"],[4,1,"しゅ"],[6,1,"みや"],[12,1,"ぞう"],[14,1,"と"],[16,1,"だ"],[25,1,"そと"],[31,1,"かわ"],[33,1,"も"],[36,1,"い"],[44,1,"かわ"],[49,1,"や"],[55,1,"う"],[57,1,"くだ"],[60,1,"こな"],[66,1,"こな"],[68,1,"たみ"],[70,1,"はか"],[72,1,"な"]],"text":"彼はまた主の宮からアシラ像を取り出し、エルサレムの外のキデロン川に持って行って、キデロン川でそれを焼き、それを打ち砕いて粉とし、その粉を民の墓に投げすてた。"},{"ref":"2Kgs.23.7","start":12023007,"end":12023007,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"みや"],[9,2,"しんでん"],[11,2,"だんしょう"],[14,1,"いえ"],[24,1,"おんな"],[31,1,"ぞう"],[36,1,"か"],[38,1,"まく"],[40,1,"お"],[42,1,"ところ"]],"text":"また主の宮にあった神殿男娼の家をこわした。そこは女たちがアシラ像のために掛け幕を織る所であった。"},{"ref":"2Kgs.23.8","start":12023008,"end":12023008,"break":"none","ruby":[[0,1,"かれ"],[7,2,"まちまち"],[11,2,"さいし"],[19,1,"め"],[26,2,"さいし"],[29,1,"こう"],[46,1,"たか"],[48,1,"ところ"],[50,1,"けが"],[55,1,"もん"],[59,1,"たか"],[61,1,"ところ"],[72,1,"たか"],[74,1,"ところ"],[76,1,"まち"],[86,1,"もん"],[88,2,"いりぐち"],[94,1,"まち"],[96,1,"もん"],[101,1,"ひと"],[103,1,"ひだり"]],"text":"彼はまたユダの町々から祭司をことごとく召しよせ、また祭司が香をたいたゲバからベエルシバまでの高き所を汚し、また門にある高き所をこわした。これらの高き所は町のつかさヨシュアの門の入口にあり、町の門にはいる人の左にあった。"},{"ref":"2Kgs.23.9","start":12023009,"end":12023009,"break":"none","ruby":[[0,1,"たか"],[2,1,"ところ"],[4,2,"さいし"],[15,1,"しゅ"],[17,2,"さいだん"],[35,2,"きょうだい"],[46,1,"たね"],[47,1,"い"],[53,1,"た"]],"text":"高き所の祭司たちはエルサレムで主の祭壇にのぼることをしなかったが、その兄弟たちのうちにあって種入れぬパンを食べた。"},{"ref":"2Kgs.23.10","start":12023010,"end":12023010,"break":"none","ruby":[[0,1,"おう"],[13,1,"むすめ"],[15,1,"ひ"],[17,1,"や"],[28,1,"もの"],[48,1,"たに"],[56,1,"けが"]],"text":"王はまた、だれもそのむすこ娘を火に焼いて、モレクにささげ物とすることのないように、ベンヒンノムの谷にあるトペテを汚した。"},{"ref":"2Kgs.23.11","start":12023011,"end":12023011,"break":"none","ruby":[[5,1,"おう"],[9,2,"たいよう"],[16,1,"しゅ"],[18,1,"みや"],[20,1,"もん"],[22,1,"お"],[25,1,"うま"],[28,2,"けいだい"],[33,2,"じじゅう"],[50,1,"うつ"],[53,2,"たいよう"],[56,1,"くるま"],[58,1,"ひ"],[60,1,"や"]],"text":"またユダの王たちが太陽にささげて主の宮の門に置いた馬を、境内にある侍従ナタンメレクのへやのかたわらに移し、太陽の車を火で焼いた。"},{"ref":"2Kgs.23.12","start":12023012,"end":12023012,"break":"none","ruby":[[2,1,"おう"],[7,1,"おう"],[15,2,"たかどの"],[18,2,"おくじょう"],[21,1,"つく"],[24,2,"さいだん"],[32,1,"しゅ"],[34,1,"みや"],[39,1,"にわ"],[41,1,"つく"],[44,2,"さいだん"],[56,1,"う"],[58,1,"くだ"],[61,1,"くだ"],[71,1,"かわ"],[73,1,"な"]],"text":"また王はユダの王たちがアハズの高殿の屋上に造った祭壇と、マナセが主の宮の二つの庭に造った祭壇とをこわして、それを打ち砕き、砕けたものをキデロン川に投げすてた。"},{"ref":"2Kgs.23.13","start":12023013,"end":12023013,"break":"none","ruby":[[2,1,"おう"],[10,1,"おう"],[16,1,"むかし"],[23,1,"にく"],[27,1,"もの"],[41,1,"にく"],[45,1,"もの"],[56,2,"ひとびと"],[59,1,"にく"],[63,1,"もの"],[78,1,"ひがし"],[80,2,"めつぼう"],[83,1,"やま"],[85,1,"みなみ"],[87,1,"きず"],[90,1,"たか"],[92,1,"ところ"],[94,1,"けが"]],"text":"また王はイスラエルの王ソロモンが昔シドンびとの憎むべき者アシタロテと、モアブびとの憎むべき者ケモシと、アンモンの人々の憎むべき者ミルコムのためにエルサレムの東、滅亡の山の南に築いた高き所を汚した。"},{"ref":"2Kgs.23.14","start":12023014,"end":12023014,"break":"none","ruby":[[7,2,"せきちゅう"],[10,1,"う"],[12,1,"くだ"],[18,1,"ぞう"],[20,1,"き"],[22,1,"たお"],[25,1,"ひと"],[27,1,"ほね"],[34,1,"ところ"],[36,1,"み"]],"text":"またもろもろの石柱を打ち砕き、アシラ像を切り倒し、人の骨をもってその所を満たした。"},{"ref":"2Kgs.23.15","start":12023015,"end":12023015,"break":"paragraph","ruby":[[9,2,"さいだん"],[19,1,"つみ"],[21,1,"おか"],[29,1,"こ"],[36,1,"つく"],[39,1,"たか"],[41,1,"ところ"],[49,2,"さいだん"],[52,1,"たか"],[54,1,"ところ"],[57,1,"かれ"],[65,1,"いし"],[67,1,"う"],[69,1,"くだ"],[72,1,"こな"],[81,1,"ぞう"],[83,1,"や"]],"text":"また、ベテルにある祭壇と、イスラエルに罪を犯させたネバテの子ヤラベアムが造った高き所、すなわちその祭壇と高き所とを彼はこわし、その石を打ち砕いて粉とし、かつアシラ像を焼いた。"},{"ref":"2Kgs.23.16","start":12023016,"end":12023016,"break":"none","ruby":[[7,1,"み"],[14,1,"やま"],[16,1,"はか"],[22,1,"み"],[24,1,"ひと"],[33,1,"はか"],[36,1,"ほね"],[38,1,"と"],[47,2,"さいだん"],[50,1,"うえ"],[52,1,"や"],[59,1,"けが"],[63,1,"むかし"],[65,1,"かみ"],[67,1,"ひと"],[69,1,"しゅ"],[71,2,"ことば"],[78,1,"こと"],[80,1,"よ"],[84,1,"つ"]],"text":"そしてヨシヤは身をめぐらして山に墓のあるのを見、人をつかわしてその墓から骨を取らせ、それをその祭壇の上で焼いて、それを汚した。昔、神の人が主の言葉としてこの事を呼ばわり告げたが、そのとおりになった。"},{"ref":"2Kgs.23.17","start":12023017,"end":12023017,"break":"none","ruby":[[2,1,"とき"],[12,1,"み"],[15,2,"せきひ"],[18,1,"なに"],[22,1,"たず"],[26,1,"まち"],[28,2,"ひとびと"],[31,1,"かれ"],[45,2,"さいだん"],[48,1,"たい"],[51,1,"おこな"],[59,1,"こと"],[68,2,"よげん"],[72,1,"かみ"],[74,1,"ひと"],[76,1,"はか"],[81,1,"い"]],"text":"その時ヨシヤは「あそこに見える石碑は何か」と尋ねた。町の人々が彼に「あれはあなたがベテルの祭壇に対して行われたこれらの事を、ユダからきて預言した神の人の墓です」と言ったので、"},{"ref":"2Kgs.23.18","start":12023018,"end":12023018,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[14,1,"お"],[25,1,"ほね"],[27,1,"うつ"],[42,1,"ほね"],[53,3,"よげんしゃ"],[57,1,"ほね"],[60,1,"て"]],"text":"彼は言った、「そのままにして置きなさい。だれもその骨を移してはならない」。それでその骨と、サマリヤからきた預言者の骨には手をつけなかった。"},{"ref":"2Kgs.23.19","start":12023019,"end":12023019,"break":"none","ruby":[[8,1,"おう"],[17,2,"まちまち"],[20,1,"つく"],[24,1,"しゅ"],[26,1,"いか"],[30,1,"たか"],[32,1,"ところ"],[34,1,"いえ"],[36,1,"みな"],[41,1,"と"],[43,1,"のぞ"],[47,1,"かれ"],[56,1,"い"],[65,1,"い"]],"text":"またイスラエルの王たちがサマリヤの町々に造って、主を怒らせた高き所の家も皆ヨシヤは取り除いて、彼がすべてベテルに行ったようにこれに行った。"},{"ref":"2Kgs.23.20","start":12023020,"end":12023020,"break":"none","ruby":[[0,1,"かれ"],[11,1,"たか"],[13,1,"ところ"],[15,2,"さいし"],[20,1,"みな"],[21,2,"さいだん"],[24,1,"うえ"],[26,1,"ころ"],[29,1,"ひと"],[31,1,"ほね"],[33,2,"さいだん"],[36,1,"うえ"],[38,1,"や"],[46,1,"かれ"],[54,1,"かえ"]],"text":"彼はまた、そこにあった高き所の祭司たちを皆祭壇の上で殺し、人の骨を祭壇の上で焼いた。こうして彼はエルサレムに帰った。"},{"ref":"2Kgs.23.21","start":12023021,"end":12023021,"break":"paragraph","ruby":[[3,1,"おう"],[9,1,"たみ"],[11,1,"めい"],[24,2,"けいやく"],[27,1,"しょ"],[46,1,"かみ"],[48,1,"しゅ"],[50,2,"すぎこし"],[53,1,"まつり"],[55,1,"と"],[57,1,"おこな"],[64,1,"い"]],"text":"そして王はすべての民に命じて、「あなたがたはこの契約の書にしるされているように、あなたがたの神、主に過越の祭を執り行いなさい」と言った。"},{"ref":"2Kgs.23.22","start":12023022,"end":12023022,"break":"none","ruby":[[17,1,"ひ"],[33,1,"おう"],[40,1,"おう"],[44,1,"よ"],[53,2,"すぎこし"],[56,1,"まつり"],[58,1,"と"],[60,1,"おこな"]],"text":"さばきづかさがイスラエルをさばいた日からこのかた、またイスラエルの王たちとユダの王たちの世にも、このような過越の祭を執り行ったことはなかったが、"},{"ref":"2Kgs.23.23","start":12023023,"end":12023023,"break":"none","ruby":[[3,1,"おう"],[5,1,"だい"],[8,1,"ねん"],[19,2,"すぎこし"],[22,1,"まつり"],[24,1,"しゅ"],[26,1,"と"],[28,1,"おこな"]],"text":"ヨシヤ王の第十八年に、エルサレムでこの過越の祭を主に執り行ったのである。"},{"ref":"2Kgs.23.24","start":12023024,"end":12023024,"break":"paragraph","ruby":[[6,2,"さいし"],[13,1,"しゅ"],[15,1,"みや"],[17,1,"み"],[21,2,"しょもつ"],[31,2,"りっぽう"],[34,2,"ことば"],[37,2,"かくじつ"],[40,1,"おこな"],[46,2,"くちよ"],[50,1,"うらな"],[52,1,"し"],[60,2,"ぐうぞう"],[68,1,"ち"],[76,1,"み"],[85,1,"にく"],[89,1,"もの"],[91,1,"と"],[93,1,"のぞ"]],"text":"ヨシヤはまた祭司ヒルキヤが主の宮で見つけた書物にしるされている律法の言葉を確実に行うために、口寄せと占い師と、テラピムと偶像およびユダの地とエルサレムに見られるもろもろの憎むべき者を取り除いた。"},{"ref":"2Kgs.23.25","start":12023025,"end":12023025,"break":"none","ruby":[[7,1,"こころ"],[13,2,"せいしん"],[20,1,"ちから"],[34,2,"りっぽう"],[42,1,"しゅ"],[44,1,"よ"],[46,1,"たよ"],[49,1,"おう"],[55,1,"さき"],[65,1,"のち"],[68,1,"かれ"],[73,1,"もの"],[75,1,"おこ"]],"text":"ヨシヤのように心をつくし、精神をつくし、力をつくしてモーセのすべての律法にしたがい、主に寄り頼んだ王はヨシヤの先にはなく、またその後にも彼のような者は起らなかった。"},{"ref":"2Kgs.23.26","start":12023026,"end":12023026,"break":"paragraph","ruby":[[4,1,"しゅ"],[15,1,"はっ"],[20,1,"はげ"],[23,1,"おお"],[27,1,"いか"],[51,1,"はら"],[56,1,"おこな"],[62,1,"しゅ"],[64,1,"いか"]],"text":"けれども主はなおユダにむかって発せられた激しい大いなる怒りをやめられなかった。これはマナセがもろもろの腹だたしい行いをもって主を怒らせたためである。"},{"ref":"2Kgs.23.27","start":12023027,"end":12023027,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"い"],[22,1,"うつ"],[37,1,"め"],[39,1,"まえ"],[42,1,"うつ"],[49,1,"えら"],[60,1,"まち"],[67,1,"な"],[72,1,"お"],[76,1,"い"],[81,1,"みや"],[84,1,"す"]],"text":"それゆえ主は言われた、「わたしはイスラエルを移したように、ユダをもわたしの目の前から移し、わたしが選んだこのエルサレムの町と、わたしの名をそこに置こうと言ったこの宮とを捨てるであろう」。"},{"ref":"2Kgs.23.28","start":12023028,"end":12023028,"break":"paragraph","ruby":[[6,1,"た"],[8,2,"じせき"],[12,1,"かれ"],[14,1,"い"],[21,1,"こと"],[27,1,"おう"],[29,3,"れきだいし"],[33,1,"しょ"]],"text":"ヨシヤのその他の事績と、彼が行ったすべての事は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.23.29","start":12023029,"end":12023029,"break":"none","ruby":[[4,1,"よ"],[11,1,"おう"],[25,1,"おう"],[31,1,"い"],[40,1,"かわ"],[45,1,"のぼ"],[56,1,"おう"],[58,1,"かれ"],[60,1,"むか"],[62,1,"う"],[66,1,"で"],[68,1,"い"],[79,1,"かれ"],[81,1,"み"],[92,1,"かれ"],[94,1,"ころ"]],"text":"ヨシヤの世にエジプトの王パロ・ネコが、アッスリヤの王のところへ行こうと、ユフラテ川をさして上ってきたので、ヨシヤ王は彼を迎え撃とうと出て行ったが、パロ・ネコは彼を見るや、メギドにおいて彼を殺した。"},{"ref":"2Kgs.23.30","start":12023030,"end":12023030,"break":"none","ruby":[[2,2,"けらい"],[7,1,"かれ"],[9,2,"したい"],[12,1,"くるま"],[14,1,"の"],[28,1,"はこ"],[31,1,"かれ"],[33,1,"はか"],[35,1,"ほうむ"],[39,1,"くに"],[41,1,"たみ"],[47,1,"こ"],[54,1,"た"],[57,1,"かれ"],[59,1,"あぶら"],[61,1,"そそ"],[64,1,"おう"],[68,1,"ちち"],[70,1,"かわ"]],"text":"その家来たちは彼の死体を車に載せ、メギドからエルサレムに運んで彼の墓に葬った。国の民はヨシヤの子エホアハズを立て、彼に油を注ぎ、王として父に代らせた。"},{"ref":"2Kgs.23.31","start":12023031,"end":12023031,"break":"paragraph","ruby":[[6,1,"おう"],[11,1,"とき"],[15,1,"さい"],[26,1,"げつ"],[28,1,"あいだ"],[30,1,"よ"],[32,1,"おさ"],[36,1,"はは"],[47,1,"むすめ"],[50,1,"な"]],"text":"エホアハズは王となった時二十三歳で、エルサレムで三か月の間、世を治めた。母はリブナのエレミヤの娘で、名をハムタルといった。"},{"ref":"2Kgs.23.32","start":12023032,"end":12023032,"break":"none","ruby":[[6,2,"せんぞ"],[14,1,"い"],[20,1,"しゅ"],[22,1,"め"],[24,1,"まえ"],[26,1,"あく"],[28,1,"おこな"]],"text":"エホアハズは先祖たちがすべて行ったように主の目の前に悪を行ったが、"},{"ref":"2Kgs.23.33","start":12023033,"end":12023033,"break":"none","ruby":[[6,1,"かれ"],[12,1,"ち"],[22,1,"お"],[32,1,"よ"],[34,1,"おさ"],[52,1,"ぎん"],[59,1,"きん"],[70,1,"くに"],[72,1,"か"]],"text":"パロ・ネコは彼をハマテの地のリブラにつないで置いて、エルサレムで世を治めることができないようにした。また銀百タラントと金一タラントのみつぎを国に課した。"},{"ref":"2Kgs.23.34","start":12023034,"end":12023034,"break":"none","ruby":[[13,1,"こ"],[20,1,"ちち"],[25,1,"かわ"],[28,1,"おう"],[34,1,"な"],[42,1,"あらた"],[56,1,"ひ"],[59,1,"い"],[74,1,"い"],[80,1,"し"]],"text":"そしてパロ・ネコはヨシヤの子エリアキムを父ヨシヤに代って王とならせ、名をエホヤキムと改め、エホアハズをエジプトへ引いて行った。エホアハズはエジプトへ行ってそこで死んだ。"},{"ref":"2Kgs.23.35","start":12023035,"end":12023035,"break":"none","ruby":[[6,2,"きんぎん"],[12,1,"おく"],[19,1,"かれ"],[24,1,"いのち"],[26,1,"したが"],[29,1,"かね"],[31,1,"おく"],[36,1,"くに"],[38,1,"ぜい"],[40,1,"か"],[43,1,"くに"],[45,1,"たみ"],[54,2,"かぜい"],[62,2,"きんぎん"],[69,1,"と"],[71,1,"た"],[84,1,"おく"]],"text":"エホヤキムは金銀をパロに送った。しかし彼はパロの命に従って金を送るために国に税を課し、国の民おのおのからその課税にしたがって金銀をきびしく取り立てて、それをパロ・ネコに送った。"},{"ref":"2Kgs.23.36","start":12023036,"end":12023036,"break":"paragraph","ruby":[[9,1,"さい"],[11,1,"おう"],[24,1,"ねん"],[26,1,"あいだ"],[28,1,"よ"],[30,1,"おさ"],[34,1,"はは"],[43,1,"むすめ"],[46,1,"な"]],"text":"エホヤキムは二十五歳で王となり、エルサレムで十一年の間、世を治めた。母はルマのペダヤの娘で、名をゼビダといった。"},{"ref":"2Kgs.23.37","start":12023037,"end":12023037,"break":"none","ruby":[[6,2,"せんぞ"],[14,1,"い"],[20,1,"しゅ"],[22,1,"め"],[24,1,"まえ"],[26,1,"あく"],[28,1,"おこな"]],"text":"エホヤキムは先祖たちがすべて行ったように主の目の前に悪を行った。"}]