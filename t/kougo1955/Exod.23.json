[{"ref":"Exod.23.1","start":2023001,"end":2023001,"break":"paragraph","ruby":[[4,1,"いつわ"],[11,1,"い"],[27,2,"あくにん"],[30,1,"て"],[32,1,"たずさ"],[36,2,"あくい"],[41,2,"しょうにん"]],"text":"あなたは偽りのうわさを言いふらしてはならない。あなたは悪人と手を携えて、悪意のある証人になってはならない。"},{"ref":"Exod.23.2","start":2023002,"end":2023002,"break":"none","ruby":[[4,2,"たすう"],[7,1,"したが"],[10,1,"あく"],[27,2,"そしょう"],[34,2,"たすう"],[37,1,"したが"],[40,2,"かたよ"],[44,2,"せいぎ"],[47,1,"ま"],[53,2,"しょうげん"]],"text":"あなたは多数に従って悪をおこなってはならない。あなたは訴訟において、多数に従って片寄り、正義を曲げるような証言をしてはならない。"},{"ref":"Exod.23.3","start":2023003,"end":2023003,"break":"none","ruby":[[2,1,"まず"],[5,1,"ひと"],[9,2,"そしょう"],[16,1,"ま"]],"text":"また貧しい人をその訴訟において、曲げてかばってはならない。"},{"ref":"Exod.23.4","start":2023004,"end":2023004,"break":"paragraph","ruby":[[7,1,"てき"],[9,1,"うし"],[17,1,"まよ"],[24,1,"あ"],[26,1,"とき"],[29,1,"かなら"],[34,1,"かれ"],[36,1,"ところ"],[38,1,"つ"],[41,1,"い"],[45,1,"き"]],"text":"もし、あなたが敵の牛または、ろばの迷っているのに会う時は、必ずこれを彼の所に連れて行って、帰さなければならない。"},{"ref":"Exod.23.5","start":2023005,"end":2023005,"break":"none","ruby":[[6,1,"にく"],[8,1,"もの"],[16,2,"にもつ"],[19,1,"した"],[21,1,"たお"],[23,1,"ふ"],[30,1,"み"],[32,1,"とき"],[38,2,"みす"],[42,1,"お"],[49,1,"き"],[54,1,"かなら"],[58,1,"ひと"],[60,1,"て"],[62,1,"か"],[69,1,"おこ"]],"text":"もしあなたを憎む者のろばが、その荷物の下に倒れ伏しているのを見る時は、これを見捨てて置かないように気をつけ、必ずその人に手を貸して、これを起さなければならない。"},{"ref":"Exod.23.6","start":2023006,"end":2023006,"break":"paragraph","ruby":[[4,1,"まず"],[7,1,"もの"],[9,2,"そしょう"],[16,2,"さいばん"],[19,1,"ま"]],"text":"あなたは貧しい者の訴訟において、裁判を曲げてはならない。"},{"ref":"Exod.23.7","start":2023007,"end":2023007,"break":"none","ruby":[[4,1,"いつわ"],[6,1,"こと"],[8,1,"とお"],[25,1,"つみ"],[29,1,"もの"],[31,1,"ただ"],[34,1,"もの"],[37,1,"ころ"],[50,2,"あくにん"],[53,1,"ぎ"]],"text":"あなたは偽り事に遠ざからなければならない。あなたは罪のない者と正しい者とを殺してはならない。わたしは悪人を義とすることはないからである。"},{"ref":"Exod.23.8","start":2023008,"end":2023008,"break":"none","ruby":[[4,2,"わいろ"],[7,1,"と"],[16,2,"わいろ"],[19,1,"ひと"],[21,1,"め"],[28,1,"ただ"],[31,1,"もの"],[33,2,"じけん"],[37,1,"ま"]],"text":"あなたは賄賂を取ってはならない。賄賂は人の目をくらまし、正しい者の事件をも曲げさせるからである。"},{"ref":"Exod.23.9","start":2023009,"end":2023009,"break":"paragraph","ruby":[[4,2,"きりゅう"],[7,2,"たこく"],[9,1,"じん"],[33,1,"くに"],[35,2,"きりゅう"],[38,2,"たこく"],[40,1,"じん"],[48,2,"きりゅう"],[51,2,"たこく"],[53,1,"じん"],[55,1,"こころ"],[57,1,"し"]],"text":"あなたは寄留の他国人をしえたげてはならない。あなたがたはエジプトの国で寄留の他国人であったので、寄留の他国人の心を知っているからである。"},{"ref":"Exod.23.10","start":2023010,"end":2023010,"break":"paragraph","ruby":[[5,1,"ねん"],[11,1,"ち"],[13,1,"たね"],[20,2,"さんぶつ"],[23,1,"と"],[25,1,"い"]],"text":"あなたは六年のあいだ、地に種をまき、その産物を取り入れることができる。"},{"ref":"Exod.23.11","start":2023011,"end":2023011,"break":"none","ruby":[[5,1,"ねん"],[6,1,"め"],[13,1,"やす"],[18,1,"たがや"],[22,1,"お"],[43,1,"たみ"],[45,1,"まず"],[48,1,"もの"],[53,1,"た"],[58,1,"のこ"],[61,1,"の"],[63,1,"けもの"],[65,1,"た"],[82,1,"はたけ"],[88,1,"はたけ"],[90,2,"どうよう"]],"text":"しかし、七年目には、これを休ませて、耕さずに置かなければならない。そうすれば、あなたの民の貧しい者がこれを食べ、その残りは野の獣が食べることができる。あなたのぶどう畑も、オリブ畑も同様にしなければならない。"},{"ref":"Exod.23.12","start":2023012,"end":2023012,"break":"paragraph","ruby":[[5,1,"か"],[11,2,"しごと"],[16,2,"なぬか"],[18,1,"め"],[21,1,"やす"],[39,1,"うし"],[47,1,"やす"],[50,1,"え"],[63,1,"こ"],[67,2,"きりゅう"],[70,2,"たこく"],[72,1,"じん"],[74,1,"やす"]],"text":"あなたは六日のあいだ、仕事をし、七日目には休まなければならない。これはあなたの牛および、ろばが休みを得、またあなたのはしための子および寄留の他国人を休ませるためである。"},{"ref":"Exod.23.13","start":2023013,"end":2023013,"break":"none","ruby":[[11,1,"い"],[18,1,"こと"],[20,1,"こころ"],[22,1,"と"],[28,1,"た"],[30,2,"かみがみ"],[33,1,"な"],[35,1,"とな"],[60,1,"きこ"]],"text":"わたしが、あなたがたに言ったすべての事に心を留めなさい。他の神々の名を唱えてはならない。また、これをあなたのくちびるから聞えさせてはならない。"},{"ref":"Exod.23.14","start":2023014,"end":2023014,"break":"paragraph","ruby":[[4,1,"ねん"],[7,1,"ど"],[16,1,"まつり"],[18,1,"おこな"]],"text":"あなたは年に三度、わたしのために祭を行わなければならない。"},{"ref":"Exod.23.15","start":2023015,"end":2023015,"break":"none","ruby":[[4,1,"たね"],[5,1,"い"],[11,1,"まつり"],[13,1,"まも"],[33,1,"めい"],[44,1,"つき"],[46,1,"さだ"],[49,1,"とき"],[51,2,"なぬか"],[58,1,"たね"],[59,1,"い"],[65,1,"た"],[81,1,"つき"],[93,1,"で"],[108,1,"て"],[114,1,"まえ"],[116,1,"で"]],"text":"あなたは種入れぬパンの祭を守らなければならない。わたしが、あなたに命じたように、アビブの月の定めの時に七日のあいだ、種入れぬパンを食べなければならない。それはその月にあなたがエジプトから出たからである。だれも、むなし手でわたしの前に出てはならない。"},{"ref":"Exod.23.16","start":2023016,"end":2023016,"break":"none","ruby":[[7,1,"はたけ"],[12,1,"え"],[14,1,"もの"],[16,2,"きんろう"],[19,2,"はつほ"],[26,2,"かりい"],[30,1,"まつり"],[37,2,"きんろう"],[40,1,"み"],[42,1,"はたけ"],[45,1,"と"],[47,1,"い"],[50,1,"ねん"],[52,1,"おわ"],[56,2,"とりい"],[60,1,"まつり"],[62,1,"おこな"]],"text":"また、あなたが畑にまいて獲た物の勤労の初穂をささげる刈入れの祭と、あなたの勤労の実を畑から取り入れる年の終りに、取入れの祭を行わなければならない。"},{"ref":"Exod.23.17","start":2023017,"end":2023017,"break":"none","ruby":[[0,2,"だんし"],[6,1,"ねん"],[9,1,"ど"],[11,1,"しゅ"],[14,1,"かみ"],[16,1,"まえ"],[18,1,"で"]],"text":"男子はみな、年に三度、主なる神の前に出なければならない。"},{"ref":"Exod.23.18","start":2023018,"end":2023018,"break":"paragraph","ruby":[[8,2,"ぎせい"],[11,1,"ち"],[14,1,"たね"],[16,1,"い"],[22,1,"とも"],[41,1,"まつり"],[43,2,"しぼう"],[46,2,"よくあさ"],[50,1,"のこ"],[53,1,"お"]],"text":"あなたはわたしの犠牲の血を、種を入れたパンと共にささげてはならない。また、わたしの祭の脂肪を翌朝まで残して置いてはならない。"},{"ref":"Exod.23.19","start":2023019,"end":2023019,"break":"paragraph","ruby":[[4,2,"とち"],[7,2,"はつほ"],[10,1,"もっと"],[12,1,"よ"],[14,1,"もの"],[21,1,"かみ"],[23,1,"しゅ"],[25,1,"いえ"],[27,1,"たずさ"],[44,1,"こ"],[51,1,"はは"],[53,1,"ちち"],[55,1,"に"]],"text":"あなたの土地の初穂の最も良い物を、あなたの神、主の家に携えてこなければならない。あなたは子やぎを、その母の乳で煮てはならない。"},{"ref":"Exod.23.20","start":2023020,"end":2023020,"break":"paragraph","ruby":[[0,1,"み"],[7,1,"つかい"],[13,1,"まえ"],[24,1,"みち"],[26,1,"まも"],[34,1,"そな"],[37,1,"ところ"],[39,1,"みちび"]],"text":"見よ、わたしは使をあなたの前につかわし、あなたを道で守らせ、わたしが備えた所に導かせるであろう。"},{"ref":"Exod.23.21","start":2023021,"end":2023021,"break":"none","ruby":[[6,1,"まえ"],[8,1,"つつし"],[13,2,"ことば"],[16,1,"き"],[18,1,"したが"],[21,1,"かれ"],[37,1,"な"],[39,1,"かれ"],[50,1,"かれ"]],"text":"あなたはその前に慎み、その言葉に聞き従い、彼にそむいてはならない。わたしの名が彼のうちにあるゆえに、彼はあなたがたのとがをゆるさないであろう。"},{"ref":"Exod.23.22","start":2023022,"end":2023022,"break":"paragraph","ruby":[[10,1,"かれ"],[12,1,"こえ"],[16,1,"き"],[18,1,"したが"],[28,1,"かた"],[33,1,"おこな"],[47,1,"てき"],[49,1,"てき"]],"text":"しかし、もしあなたが彼の声によく聞き従い、すべてわたしが語ることを行うならば、わたしはあなたの敵を敵とし、あなたのあだをあだとするであろう。"},{"ref":"Exod.23.23","start":2023023,"end":2023023,"break":"paragraph","ruby":[[4,1,"つかい"],[10,1,"まえ"],[12,1,"い"],[57,1,"ところ"],[59,1,"みちび"],[66,1,"かれ"],[69,1,"ほろ"]],"text":"わたしの使はあなたの前に行って、あなたをアモリびと、ヘテびと、ペリジびと、カナンびと、ヒビびと、およびエブスびとの所に導き、わたしは彼らを滅ぼすであろう。"},{"ref":"Exod.23.24","start":2023024,"end":2023024,"break":"none","ruby":[[4,1,"かれ"],[7,2,"かみがみ"],[10,1,"おが"],[22,1,"つか"],[33,1,"かれ"],[55,1,"かれ"],[58,1,"まった"],[60,1,"う"],[62,1,"たお"],[67,1,"いし"],[69,1,"はしら"],[71,1,"う"],[73,1,"くだ"]],"text":"あなたは彼らの神々を拝んではならない。これに仕えてはならない。また彼らのおこないにならってはならない。あなたは彼らを全く打ち倒し、その石の柱を打ち砕かなければならない。"},{"ref":"Exod.23.25","start":2023025,"end":2023025,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"つか"],[40,1,"みず"],[42,1,"しゅく"],[55,1,"やまい"],[57,1,"のぞ"],[59,1,"さ"]],"text":"あなたがたの神、主に仕えなければならない。そうすれば、わたしはあなたがたのパンと水を祝し、あなたがたのうちから病を除き去るであろう。"},{"ref":"Exod.23.26","start":2023026,"end":2023026,"break":"none","ruby":[[4,1,"くに"],[10,2,"りゅうざん"],[14,1,"おんな"],[19,2,"ふにん"],[22,1,"おんな"],[35,1,"ひ"],[37,1,"かず"],[39,1,"み"],[41,1,"た"]],"text":"あなたの国のうちには流産する女もなく、不妊の女もなく、わたしはあなたの日の数を満ち足らせるであろう。"},{"ref":"Exod.23.27","start":2023027,"end":2023027,"break":"none","ruby":[[8,1,"さき"],[15,1,"おそ"],[27,1,"い"],[29,1,"ところ"],[31,1,"たみ"],[39,1,"う"],[41,1,"やぶ"],[48,1,"てき"],[53,1,"せ"],[59,1,"ほう"],[61,1,"む"]],"text":"わたしはあなたの先に、わたしの恐れをつかわし、あなたが行く所の民を、ことごとく打ち敗り、すべての敵に、その背をあなたの方へ向けさせるであろう。"},{"ref":"Exod.23.28","start":2023028,"end":2023028,"break":"none","ruby":[[16,1,"さき"],[53,1,"まえ"],[56,1,"お"],[58,1,"はら"]],"text":"わたしはまた、くまばちをあなたの先につかわすであろう。これはヒビびと、カナンびと、およびヘテびとをあなたの前から追い払うであろう。"},{"ref":"Exod.23.29","start":2023029,"end":2023029,"break":"none","ruby":[[8,1,"かれ"],[12,1,"ねん"],[23,1,"まえ"],[26,1,"お"],[28,1,"はら"],[37,2,"とち"],[40,1,"あ"],[46,1,"の"],[48,1,"けもの"],[50,1,"ま"],[58,1,"がい"]],"text":"しかし、わたしは彼らを一年のうちには、あなたの前から追い払わないであろう。土地が荒れすたれ、野の獣が増して、あなたを害することのないためである。"},{"ref":"Exod.23.30","start":2023030,"end":2023030,"break":"none","ruby":[[4,2,"じょじょ"],[7,1,"かれ"],[14,1,"まえ"],[17,1,"お"],[19,1,"はら"],[44,1,"ち"],[46,1,"つ"]],"text":"わたしは徐々に彼らをあなたの前から追い払うであろう。あなたは、ついにふえひろがって、この地を継ぐようになるであろう。"},{"ref":"Exod.23.31","start":2023031,"end":2023031,"break":"none","ruby":[[4,2,"こうかい"],[15,1,"うみ"],[17,1,"いた"],[23,2,"あらの"],[31,1,"かわ"],[33,1,"いた"],[43,2,"りょういき"],[50,1,"ち"],[52,1,"す"],[57,1,"もの"],[63,1,"て"],[77,1,"かれ"],[84,1,"まえ"],[87,1,"お"],[89,1,"はら"]],"text":"わたしは紅海からペリシテびとの海に至るまでと、荒野からユフラテ川に至るまでを、あなたの領域とし、この地に住んでいる者をあなたの手にわたすであろう。あなたは彼らをあなたの前から追い払うであろう。"},{"ref":"Exod.23.32","start":2023032,"end":2023032,"break":"none","ruby":[[4,1,"かれ"],[10,1,"かれ"],[13,2,"かみがみ"],[16,2,"けいやく"],[19,1,"むす"]],"text":"あなたは彼ら、および彼らの神々と契約を結んではならない。"},{"ref":"Exod.23.33","start":2023033,"end":2023033,"break":"none","ruby":[[0,1,"かれ"],[7,1,"くに"],[9,1,"す"],[18,1,"かれ"],[35,1,"たい"],[38,1,"つみ"],[40,1,"おか"],[62,1,"かれ"],[65,1,"かみ"],[67,1,"つか"],[77,1,"かなら"]],"text":"彼らはあなたの国に住んではならない。彼らがあなたをいざなって、わたしに対して罪を犯させることのないためである。もし、あなたが彼らの神に仕えるならば、それは必ずあなたのわなとなるであろう」。"}]