[{"ref":"Gen.4.1","start":1004001,"end":1004001,"break":"paragraph","ruby":[[0,1,"ひと"],[4,1,"つま"],[8,1,"し"],[12,2,"かのじょ"],[24,1,"う"],[27,1,"い"],[36,1,"しゅ"],[46,1,"ひと"],[48,1,"え"]],"text":"人はその妻エバを知った。彼女はみごもり、カインを産んで言った、「わたしは主によって、ひとりの人を得た」。"},{"ref":"Gen.4.2","start":1004002,"end":1004002,"break":"none","ruby":[[0,2,"かのじょ"],[8,1,"おとうと"],[13,1,"う"],[21,1,"ひつじ"],[23,1,"か"],[25,1,"もの"],[34,1,"つち"],[36,1,"たがや"],[38,1,"もの"]],"text":"彼女はまた、その弟アベルを産んだ。アベルは羊を飼う者となり、カインは土を耕す者となった。"},{"ref":"Gen.4.3","start":1004003,"end":1004003,"break":"none","ruby":[[0,1,"ひ"],[10,1,"ち"],[12,2,"さんぶつ"],[15,1,"も"],[21,1,"しゅ"],[23,1,"そな"],[25,1,"もの"]],"text":"日がたって、カインは地の産物を持ってきて、主に供え物とした。"},{"ref":"Gen.4.4","start":1004004,"end":1004004,"break":"none","ruby":[[9,1,"む"],[16,1,"こ"],[23,1,"も"],[29,1,"しゅ"],[37,1,"そな"],[39,1,"もの"],[42,1,"かえり"]],"text":"アベルもまた、その群れのういごと肥えたものとを持ってきた。主はアベルとその供え物とを顧みられた。"},{"ref":"Gen.4.5","start":1004005,"end":1004005,"break":"none","ruby":[[9,1,"そな"],[11,1,"もの"],[14,1,"かえり"],[29,1,"おお"],[32,1,"いきどお"],[36,1,"かお"],[38,1,"ふ"]],"text":"しかしカインとその供え物とは顧みられなかったので、カインは大いに憤って、顔を伏せた。"},{"ref":"Gen.4.6","start":1004006,"end":1004006,"break":"none","ruby":[[3,1,"しゅ"],[9,1,"い"],[21,1,"いきどお"],[30,1,"かお"],[32,1,"ふ"]],"text":"そこで主はカインに言われた、「なぜあなたは憤るのですか、なぜ顔を伏せるのですか。"},{"ref":"Gen.4.7","start":1004007,"end":1004007,"break":"none","ruby":[[0,1,"ただ"],[3,1,"こと"],[15,1,"かお"],[30,1,"ただ"],[33,1,"こと"],[46,1,"つみ"],[48,2,"かどぐち"],[51,1,"ま"],[53,1,"ぶ"],[67,1,"した"],[69,1,"もと"],[82,1,"おさ"]],"text":"正しい事をしているのでしたら、顔をあげたらよいでしょう。もし正しい事をしていないのでしたら、罪が門口に待ち伏せています。それはあなたを慕い求めますが、あなたはそれを治めなければなりません」。"},{"ref":"Gen.4.8","start":1004008,"end":1004008,"break":"paragraph","ruby":[[4,1,"おとうと"],[9,1,"い"],[17,2,"のはら"],[20,1,"い"],[25,1,"かれ"],[28,1,"の"],[39,1,"おとうと"],[44,1,"た"],[54,1,"ころ"]],"text":"カインは弟アベルに言った、「さあ、野原へ行こう」。彼らが野にいたとき、カインは弟アベルに立ちかかって、これを殺した。"},{"ref":"Gen.4.9","start":1004009,"end":1004009,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"おとうと"],[31,1,"こた"],[36,1,"し"],[46,1,"おとうと"],[48,2,"ばんにん"]],"text":"主はカインに言われた、「弟アベルは、どこにいますか」。カインは答えた、「知りません。わたしが弟の番人でしょうか」。"},{"ref":"Gen.4.10","start":1004010,"end":1004010,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"なに"],[24,1,"おとうと"],[26,1,"ち"],[28,1,"こえ"],[30,1,"つち"],[32,1,"なか"],[39,1,"さけ"]],"text":"主は言われた、「あなたは何をしたのです。あなたの弟の血の声が土の中からわたしに叫んでいます。"},{"ref":"Gen.4.11","start":1004011,"end":1004011,"break":"none","ruby":[[0,1,"いま"],[12,2,"とち"],[15,1,"はな"],[29,2,"とち"],[32,1,"くち"],[42,1,"て"],[45,1,"おとうと"],[47,1,"ち"],[49,1,"う"]],"text":"今あなたはのろわれてこの土地を離れなければなりません。この土地が口をあけて、あなたの手から弟の血を受けたからです。"},{"ref":"Gen.4.12","start":1004012,"end":1004012,"break":"none","ruby":[[4,2,"とち"],[7,1,"たがや"],[12,2,"とち"],[26,1,"み"],[28,1,"むす"],[38,2,"ちじょう"],[41,3,"ほうろうしゃ"]],"text":"あなたが土地を耕しても、土地は、もはやあなたのために実を結びません。あなたは地上の放浪者となるでしょう」。"},{"ref":"Gen.4.13","start":1004013,"end":1004013,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"い"],[15,1,"ばつ"],[17,1,"おも"],[20,1,"お"]],"text":"カインは主に言った、「わたしの罰は重くて負いきれません。"},{"ref":"Gen.4.14","start":1004014,"end":1004014,"break":"none","ruby":[[13,1,"ち"],[20,2,"ついほう"],[36,1,"はな"],[40,2,"ちじょう"],[43,3,"ほうろうしゃ"],[61,2,"みつ"],[65,1,"ひと"],[75,1,"ころ"]],"text":"あなたは、きょう、わたしを地のおもてから追放されました。わたしはあなたを離れて、地上の放浪者とならねばなりません。わたしを見付ける人はだれでもわたしを殺すでしょう」。"},{"ref":"Gen.4.15","start":1004015,"end":1004015,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[30,1,"ころ"],[32,1,"もの"],[35,1,"ばい"],[37,2,"ふくしゅう"],[40,1,"う"],[52,1,"しゅ"],[58,2,"みつ"],[62,1,"もの"],[68,1,"かれ"],[70,1,"う"],[72,1,"ころ"],[83,1,"かれ"]],"text":"主はカインに言われた、「いや、そうではない。だれでもカインを殺す者は七倍の復讐を受けるでしょう」。そして主はカインを見付ける者が、だれも彼を打ち殺すことのないように、彼に一つのしるしをつけられた。"},{"ref":"Gen.4.16","start":1004016,"end":1004016,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"まえ"],[8,1,"さ"],[16,1,"ひがし"],[21,1,"ち"],[23,1,"す"]],"text":"カインは主の前を去って、エデンの東、ノドの地に住んだ。"},{"ref":"Gen.4.17","start":1004017,"end":1004017,"break":"paragraph","ruby":[[6,1,"つま"],[8,1,"し"],[12,2,"かのじょ"],[24,1,"う"],[32,1,"まち"],[34,1,"た"],[39,1,"まち"],[41,1,"な"],[45,1,"こ"],[47,1,"な"],[59,1,"な"]],"text":"カインはその妻を知った。彼女はみごもってエノクを産んだ。カインは町を建て、その町の名をその子の名にしたがって、エノクと名づけた。"},{"ref":"Gen.4.18","start":1004018,"end":1004018,"break":"none","ruby":[[9,1,"うま"],[17,1,"こ"],[31,1,"こ"],[45,1,"こ"]],"text":"エノクにはイラデが生れた。イラデの子はメホヤエル、メホヤエルの子はメトサエル、メトサエルの子はレメクである。"},{"ref":"Gen.4.19","start":1004019,"end":1004019,"break":"none","ruby":[[8,1,"つま"],[19,1,"な"],[31,1,"な"]],"text":"レメクはふたりの妻をめとった。ひとりの名はアダといい、ひとりの名はチラといった。"},{"ref":"Gen.4.20","start":1004020,"end":1004020,"break":"none","ruby":[[7,1,"う"],[11,1,"かれ"],[13,2,"てんまく"],[16,1,"す"],[20,2,"かちく"],[23,1,"か"],[25,1,"もの"],[27,2,"せんぞ"]],"text":"アダはヤバルを産んだ。彼は天幕に住んで、家畜を飼う者の先祖となった。"},{"ref":"Gen.4.21","start":1004021,"end":1004021,"break":"none","ruby":[[2,1,"おとうと"],[4,1,"な"],[14,1,"かれ"],[16,1,"こと"],[18,1,"ふえ"],[20,1,"と"],[26,1,"もの"],[28,2,"せんぞ"]],"text":"その弟の名はユバルといった。彼は琴や笛を執るすべての者の先祖となった。"},{"ref":"Gen.4.22","start":1004022,"end":1004022,"break":"none","ruby":[[12,1,"う"],[16,1,"かれ"],[18,2,"せいどう"],[21,1,"てつ"],[27,2,"はもの"],[30,1,"きた"],[33,1,"もの"],[46,1,"いもうと"]],"text":"チラもまたトバルカインを産んだ。彼は青銅や鉄のすべての刃物を鍛える者となった。トバルカインの妹をナアマといった。"},{"ref":"Gen.4.23","start":1004023,"end":1004023,"break":"stanza","breaks":[[14,"line"],[31,"line"],[53,"line"],[71,"line"]],"ruby":[[6,1,"つま"],[10,1,"い"],[26,1,"こえ"],[28,1,"き"],[35,1,"つま"],[44,2,"ことば"],[47,1,"みみ"],[49,1,"かたむ"],[57,1,"う"],[60,1,"きず"],[66,1,"ひと"],[68,1,"ころ"],[71,1,"う"],[74,1,"う"],[76,1,"きず"],[86,2,"わかもの"],[89,1,"ころ"]],"text":"レメクはその妻たちに言った、「アダとチラよ、わたしの声を聞け、レメクの妻たちよ、わたしの言葉に耳を傾けよ。わたしは受ける傷のために、人を殺し、受ける打ち傷のために、わたしは若者を殺す。"},{"ref":"Gen.4.24","start":1004024,"end":1004024,"break":"line","breaks":[[16,"line"]],"ruby":[[7,2,"ふくしゅう"],[11,1,"ばい"],[23,2,"ふくしゅう"],[29,1,"ばい"]],"text":"カインのための復讐が七倍ならば、レメクのための復讐は七十七倍」。"},{"ref":"Gen.4.25","start":1004025,"end":1004025,"break":"paragraph","ruby":[[8,1,"つま"],[10,1,"し"],[14,2,"かのじょ"],[17,1,"おとこ"],[19,1,"こ"],[21,1,"う"],[26,1,"な"],[31,1,"な"],[35,1,"い"],[48,1,"ころ"],[54,1,"かみ"],[60,1,"かわ"],[68,1,"こ"],[74,1,"さづ"]],"text":"アダムはまたその妻を知った。彼女は男の子を産み、その名をセツと名づけて言った、「カインがアベルを殺したので、神はアベルの代りに、ひとりの子をわたしに授けられました」。"},{"ref":"Gen.4.26","start":1004026,"end":1004026,"break":"none","ruby":[[6,1,"おとこ"],[8,1,"こ"],[10,1,"うま"],[14,1,"かれ"],[18,1,"な"],[24,1,"な"],[31,1,"とき"],[33,2,"ひとびと"],[36,1,"しゅ"],[38,1,"な"],[40,1,"よ"],[42,1,"はじ"]],"text":"セツにもまた男の子が生れた。彼はその名をエノスと名づけた。この時、人々は主の名を呼び始めた。"}]