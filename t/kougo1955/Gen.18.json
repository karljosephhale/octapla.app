[{"ref":"Gen.18.1","start":1018001,"end":1018001,"break":"paragraph","ruby":[[0,1,"しゅ"],[11,1,"き"],[24,1,"あらわ"],[33,1,"ひる"],[35,1,"あつ"],[41,1,"かれ"],[43,2,"てんまく"],[46,2,"いりぐち"]],"text":"主はマムレのテレビンの木のかたわらでアブラハムに現れられた。それは昼の暑いころで、彼は天幕の入口にすわっていたが、"},{"ref":"Gen.18.2","start":1018002,"end":1018002,"break":"none","ruby":[[0,1,"め"],[2,1,"あ"],[5,1,"み"],[10,1,"にん"],[12,1,"ひと"],[14,1,"かれ"],[16,1,"む"],[20,1,"た"],[26,1,"かれ"],[31,1,"み"],[34,2,"てんまく"],[37,2,"いりぐち"],[41,1,"はし"],[44,1,"い"],[47,1,"かれ"],[50,1,"むか"],[53,1,"ち"],[55,1,"み"]],"text":"目を上げて見ると、三人の人が彼に向かって立っていた。彼はこれを見て、天幕の入口から走って行って彼らを迎え、地に身をかがめて、"},{"ref":"Gen.18.3","start":1018003,"end":1018003,"break":"none","ruby":[[0,1,"い"],[7,1,"しゅ"],[20,1,"まえ"],[22,1,"めぐ"],[25,1,"え"],[39,1,"とお"],[41,1,"す"]],"text":"言った、「わが主よ、もしわたしがあなたの前に恵みを得ているなら、どうぞしもべを通り過ごさないでください。"},{"ref":"Gen.18.4","start":1018004,"end":1018004,"break":"none","ruby":[[0,1,"みず"],[5,1,"と"],[22,1,"あし"],[24,1,"あら"],[30,1,"き"],[32,1,"した"],[35,1,"やす"]],"text":"水をすこし取ってこさせますから、あなたがたは足を洗って、この木の下でお休みください。"},{"ref":"Gen.18.5","start":1018005,"end":1018005,"break":"none","ruby":[[4,2,"ひとくち"],[10,1,"と"],[17,2,"げんき"],[29,1,"で"],[45,1,"ところ"],[61,1,"かれ"],[64,1,"い"],[70,2,"ことば"]],"text":"わたしは一口のパンを取ってきます。元気をつけて、それからお出かけください。せっかくしもべの所においでになったのですから」。彼らは言った、「お言葉どおりにしてください」。"},{"ref":"Gen.18.6","start":1018006,"end":1018006,"break":"none","ruby":[[9,1,"いそ"],[12,2,"てんまく"],[15,1,"い"],[21,1,"ところ"],[23,1,"い"],[26,1,"い"],[31,1,"いそ"],[34,1,"こま"],[37,2,"むぎこ"],[52,1,"つく"]],"text":"そこでアブラハムは急いで天幕に入り、サラの所に行って言った、「急いで細かい麦粉三セヤをとり、こねてパンを造りなさい」。"},{"ref":"Gen.18.7","start":1018007,"end":1018007,"break":"none","ruby":[[6,1,"うし"],[8,1,"む"],[11,1,"はし"],[14,1,"い"],[17,1,"やわ"],[21,1,"よ"],[23,1,"こ"],[24,1,"うし"],[26,1,"と"],[29,2,"わかもの"],[32,1,"わた"],[38,1,"いそ"],[41,2,"ちょうり"]],"text":"アブラハムは牛の群れに走って行き、柔らかな良い子牛を取って若者に渡したので、急いで調理した。"},{"ref":"Gen.18.8","start":1018008,"end":1018008,"break":"none","ruby":[[9,2,"ぎょうにゅう"],[12,2,"ぎゅうにゅう"],[17,1,"こ"],[18,1,"うし"],[20,2,"ちょうり"],[27,1,"と"],[31,1,"かれ"],[34,1,"まえ"],[36,1,"そな"],[39,1,"き"],[41,1,"した"],[43,1,"かれ"],[51,1,"た"],[54,2,"きゅうじ"],[58,1,"かれ"],[61,2,"しょくじ"]],"text":"そしてアブラハムは凝乳と牛乳および子牛の調理したものを取って、彼らの前に供え、木の下で彼らのかたわらに立って給仕し、彼らは食事した。"},{"ref":"Gen.18.9","start":1018009,"end":1018009,"break":"paragraph","ruby":[[0,1,"かれ"],[9,1,"い"],[18,1,"つま"],[33,1,"かれ"],[35,1,"い"],[40,2,"てんまく"],[43,1,"なか"]],"text":"彼らはアブラハムに言った、「あなたの妻サラはどこにおられますか」。彼は言った、「天幕の中です」。"},{"ref":"Gen.18.10","start":1018010,"end":1018010,"break":"none","ruby":[[6,1,"い"],[11,2,"らいねん"],[14,1,"はる"],[28,1,"ところ"],[30,1,"かえ"],[41,1,"とき"],[47,1,"つま"],[52,1,"おとこ"],[54,1,"こ"],[56,1,"うま"],[74,1,"ほう"],[76,2,"てんまく"],[79,2,"いりぐち"],[82,1,"き"]],"text":"そのひとりが言った、「来年の春、わたしはかならずあなたの所に帰ってきましょう。その時、あなたの妻サラには男の子が生れているでしょう」。サラはうしろの方の天幕の入口で聞いていた。"},{"ref":"Gen.18.11","start":1018011,"end":1018011,"break":"none","ruby":[[12,1,"とし"],[18,2,"ろうじん"],[27,1,"おんな"],[29,1,"つき"],[38,1,"と"]],"text":"さてアブラハムとサラとは年がすすみ、老人となり、サラは女の月のものが、すでに止まっていた。"},{"ref":"Gen.18.12","start":1018012,"end":1018012,"break":"none","ruby":[[6,1,"こころ"],[8,1,"なか"],[10,1,"わら"],[13,1,"い"],[22,1,"おとろ"],[25,2,"しゅじん"],[30,2,"ろうじん"],[42,1,"たの"]],"text":"それでサラは心の中で笑って言った、「わたしは衰え、主人もまた老人であるのに、わたしに楽しみなどありえようか」。"},{"ref":"Gen.18.13","start":1018013,"end":1018013,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"い"],[24,2,"ろうじん"],[36,1,"こ"],[38,1,"う"],[49,1,"い"],[52,1,"わら"]],"text":"主はアブラハムに言われた、「なぜサラは、わたしは老人であるのに、どうして子を産むことができようかと言って笑ったのか。"},{"ref":"Gen.18.14","start":1018014,"end":1018014,"break":"none","ruby":[[0,1,"しゅ"],[5,3,"ふかのう"],[20,2,"らいねん"],[23,1,"はる"],[25,1,"さだ"],[28,1,"とき"],[39,1,"ところ"],[41,1,"かえ"],[56,1,"おとこ"],[58,1,"こ"],[60,1,"うま"]],"text":"主にとって不可能なことがありましょうか。来年の春、定めの時に、わたしはあなたの所に帰ってきます。そのときサラには男の子が生れているでしょう」。"},{"ref":"Gen.18.15","start":1018015,"end":1018015,"break":"none","ruby":[[3,1,"おそ"],[12,1,"う"],[14,1,"け"],[17,1,"い"],[26,1,"わら"],[33,1,"しゅ"],[35,1,"い"],[48,1,"わら"]],"text":"サラは恐れたので、これを打ち消して言った、「わたしは笑いません」。主は言われた、「いや、あなたは笑いました」。"},{"ref":"Gen.18.16","start":1018016,"end":1018016,"break":"paragraph","ruby":[[2,2,"ひとびと"],[8,1,"た"],[15,1,"ほう"],[17,1,"む"],[30,1,"かれ"],[33,2,"みおく"],[37,1,"とも"],[39,1,"い"]],"text":"その人々はそこを立ってソドムの方に向かったので、アブラハムは彼らを見送って共に行った。"},{"ref":"Gen.18.17","start":1018017,"end":1018017,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,1,"い"],[20,1,"こと"],[28,1,"かく"]],"text":"時に主は言われた、「わたしのしようとする事をアブラハムに隠してよいであろうか。"},{"ref":"Gen.18.18","start":1018018,"end":1018018,"break":"none","ruby":[[6,1,"かなら"],[8,1,"おお"],[11,1,"つよ"],[13,2,"こくみん"],[20,1,"ち"],[26,1,"たみ"],[31,1,"かれ"],[36,2,"しゅくふく"],[39,1,"う"]],"text":"アブラハムは必ず大きな強い国民となって、地のすべての民がみな、彼によって祝福を受けるのではないか。"},{"ref":"Gen.18.19","start":1018019,"end":1018019,"break":"none","ruby":[[4,1,"かれ"],[6,1,"のち"],[8,1,"こ"],[11,2,"かぞく"],[15,1,"めい"],[18,1,"しゅ"],[20,1,"みち"],[22,1,"まも"],[26,2,"せいぎ"],[29,2,"こうどう"],[33,1,"おこな"],[40,1,"かれ"],[42,1,"し"],[53,1,"しゅ"],[67,1,"い"],[70,1,"こと"],[72,1,"かれ"],[74,1,"うえ"],[76,1,"のぞ"]],"text":"わたしは彼が後の子らと家族とに命じて主の道を守らせ、正義と公道とを行わせるために彼を知ったのである。これは主がかつてアブラハムについて言った事を彼の上に臨ませるためである」。"},{"ref":"Gen.18.20","start":1018020,"end":1018020,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"い"],[18,1,"さけ"],[21,1,"おお"],[29,1,"つみ"],[31,2,"ひじょう"],[34,1,"おも"]],"text":"主はまた言われた、「ソドムとゴモラの叫びは大きく、またその罪は非常に重いので、"},{"ref":"Gen.18.21","start":1018021,"end":1018021,"break":"none","ruby":[[6,1,"くだ"],[14,1,"とど"],[17,1,"さけ"],[28,1,"かれ"],[43,1,"み"],[49,1,"し"]],"text":"わたしはいま下って、わたしに届いた叫びのとおりに、すべて彼らがおこなっているかどうかを見て、それを知ろう」。"},{"ref":"Gen.18.22","start":1018022,"end":1018022,"break":"paragraph","ruby":[[2,2,"ひとびと"],[9,1,"み"],[11,1,"めぐ"],[19,1,"ほう"],[21,1,"い"],[35,1,"しゅ"],[37,1,"まえ"],[39,1,"た"]],"text":"その人々はそこから身を巡らしてソドムの方に行ったが、アブラハムはなお、主の前に立っていた。"},{"ref":"Gen.18.23","start":1018023,"end":1018023,"break":"none","ruby":[[6,2,"ちかよ"],[10,1,"い"],[23,1,"ただ"],[26,1,"もの"],[29,1,"わる"],[31,1,"もの"],[33,2,"いっしょ"],[36,1,"ほろ"]],"text":"アブラハムは近寄って言った、「まことにあなたは正しい者を、悪い者と一緒に滅ぼされるのですか。"},{"ref":"Gen.18.24","start":1018024,"end":1018024,"break":"none","ruby":[[6,1,"まち"],[10,1,"にん"],[12,1,"ただ"],[15,1,"もの"],[31,1,"ところ"],[33,1,"ほろ"],[39,1,"なか"],[45,1,"にん"],[47,1,"ただ"],[50,1,"もの"]],"text":"たとい、あの町に五十人の正しい者があっても、あなたはなお、その所を滅ぼし、その中にいる五十人の正しい者のためにこれをゆるされないのですか。"},{"ref":"Gen.18.25","start":1018025,"end":1018025,"break":"none","ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"わる"],[7,1,"もの"],[10,2,"いっしょ"],[13,1,"ころ"],[26,1,"けっ"],[39,1,"ただ"],[42,1,"もの"],[44,1,"わる"],[46,1,"もの"],[49,1,"おな"],[64,1,"けっ"],[77,1,"ぜん"],[78,1,"ち"],[83,1,"もの"],[85,2,"こうぎ"],[88,1,"おこな"]],"text":"正しい者と悪い者とを一緒に殺すようなことを、あなたは決してなさらないでしょう。正しい者と悪い者とを同じようにすることも、あなたは決してなさらないでしょう。全地をさばく者は公義を行うべきではありませんか」。"},{"ref":"Gen.18.26","start":1018026,"end":1018026,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[14,1,"まち"],[16,1,"なか"],[20,1,"にん"],[22,1,"ただ"],[25,1,"もの"],[34,2,"ひとびと"],[42,1,"ところ"]],"text":"主は言われた、「もしソドムで町の中に五十人の正しい者があったら、その人々のためにその所をすべてゆるそう」。"},{"ref":"Gen.18.27","start":1018027,"end":1018027,"break":"none","ruby":[[6,1,"こた"],[9,1,"い"],[20,1,"はい"],[22,1,"す"],[34,1,"しゅ"],[36,1,"もう"]],"text":"アブラハムは答えて言った、「わたしはちり灰に過ぎませんが、あえてわが主に申します。"},{"ref":"Gen.18.28","start":1018028,"end":1018028,"break":"none","ruby":[[4,1,"にん"],[6,1,"ただ"],[9,1,"もの"],[14,1,"にん"],[15,1,"か"],[24,1,"にん"],[25,1,"か"],[31,1,"まち"],[33,1,"まった"],[35,1,"ほろ"],[44,1,"しゅ"],[46,1,"い"],[60,1,"にん"],[65,1,"ほろ"]],"text":"もし五十人の正しい者のうち五人欠けたなら、その五人欠けたために町を全く滅ぼされますか」。主は言われた、「もしそこに四十五人いたら、滅ぼさないであろう」。"},{"ref":"Gen.18.29","start":1018029,"end":1018029,"break":"none","ruby":[[8,1,"かさ"],[11,1,"しゅ"],[13,1,"い"],[25,1,"にん"],[31,1,"しゅ"],[33,1,"い"],[43,1,"にん"]],"text":"アブラハムはまた重ねて主に言った、「もしそこに四十人いたら」。主は言われた、「その四十人のために、これをしないであろう」。"},{"ref":"Gen.18.30","start":1018030,"end":1018030,"break":"none","ruby":[[6,1,"い"],[13,1,"しゅ"],[20,1,"いか"],[33,1,"もう"],[45,1,"にん"],[51,1,"しゅ"],[53,1,"い"],[64,1,"にん"]],"text":"アブラハムは言った、「わが主よ、どうかお怒りにならぬよう。わたしは申します。もしそこに三十人いたら」。主は言われた、「そこに三十人いたら、これをしないであろう」。"},{"ref":"Gen.18.31","start":1018031,"end":1018031,"break":"none","ruby":[[6,1,"い"],[22,1,"しゅ"],[24,1,"もう"],[36,1,"にん"],[42,1,"しゅ"],[44,1,"い"],[58,1,"にん"],[63,1,"ほろ"]],"text":"アブラハムは言った、「いまわたしはあえてわが主に申します。もしそこに二十人いたら」。主は言われた、「わたしはその二十人のために滅ぼさないであろう」。"},{"ref":"Gen.18.32","start":1018032,"end":1018032,"break":"none","ruby":[[6,1,"い"],[13,1,"しゅ"],[20,1,"いか"],[36,1,"ど"],[37,1,"もう"],[48,1,"にん"],[54,1,"しゅ"],[56,1,"い"],[69,1,"にん"],[74,1,"ほろ"]],"text":"アブラハムは言った、「わが主よ、どうかお怒りにならぬよう。わたしはいま一度申します、もしそこに十人いたら」。主は言われた、「わたしはその十人のために滅ぼさないであろう」。"},{"ref":"Gen.18.33","start":1018033,"end":1018033,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"かた"],[10,1,"おわ"],[13,1,"さ"],[16,1,"い"],[27,2,"じぶん"],[30,1,"ところ"],[32,1,"かえ"]],"text":"主はアブラハムと語り終り、去って行かれた。アブラハムは自分の所に帰った。"}]