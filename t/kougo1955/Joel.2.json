[{"ref":"Joel.2.1","start":29002001,"end":29002001,"break":"paragraph","breaks":[[17,"line"],[33,"line"],[48,"line"],[60,"line"]],"ruby":[[14,1,"ふ"],[19,1,"せい"],[22,1,"やま"],[24,2,"けいほう"],[27,1,"ふ"],[33,1,"くに"],[35,1,"たみ"],[48,1,"しゅ"],[50,1,"ひ"],[52,1,"く"],[63,1,"ちか"]],"text":"あなたがたはシオンでラッパを吹け。わが聖なる山で警報を吹きならせ。国の民はみな、ふるいわななけ。主の日が来るからである。それは近い。"},{"ref":"Joel.2.2","start":29002002,"end":29002002,"break":"line","breaks":[[11,"line"],[26,"line"],[33,"line"],[51,"line"],[71,"line"]],"ruby":[[3,1,"くら"],[6,2,"うすぐら"],[9,1,"ひ"],[11,1,"くも"],[13,1,"むら"],[21,1,"ひ"],[26,1,"おお"],[29,1,"つよ"],[31,1,"たみ"],[33,1,"くら"],[45,1,"やま"],[59,1,"むかし"],[71,1,"のち"],[73,2,"よよ"],[76,1,"とし"],[79,1,"ふたた"],[81,1,"おこ"]],"text":"これは暗く、薄暗い日、雲の群がるまっくらな日である。多くの強い民が暗やみのようにもろもろの山をおおう。このようなことは昔からあったことがなく、後の代々の年にも再び起ることがないであろう。"},{"ref":"Joel.2.3","start":29002003,"end":29002003,"break":"stanza","breaks":[[21,"line"],[31,"line"],[46,"line"],[66,"line"]],"ruby":[[0,1,"ひ"],[2,1,"かれ"],[5,1,"まえ"],[7,1,"や"],[10,1,"ほのお"],[12,1,"かれ"],[15,1,"うしろ"],[17,1,"も"],[21,1,"かれ"],[27,1,"まえ"],[31,1,"ち"],[37,1,"その"],[48,1,"さ"],[51,1,"のち"],[53,1,"あ"],[55,1,"は"],[58,1,"の"]],"text":"火は彼らの前を焼き、炎は彼らの後に燃える。彼らのこない前には、地はエデンの園のようであるが、その去った後は荒れ果てた野のようになる。これをのがれうるものは一つもない。"},{"ref":"Joel.2.4","start":29002004,"end":29002004,"break":"stanza","breaks":[[18,"line"]],"ruby":[[6,1,"うま"],[20,1,"はし"],[25,2,"ぐんば"]],"text":"そのかたちは馬のかたちのようであり、その走ることは軍馬のようである。"},{"ref":"Joel.2.5","start":29002005,"end":29002005,"break":"line","breaks":[[12,"line"],[25,"line"],[45,"line"]],"ruby":[[0,1,"やま"],[2,1,"いただき"],[9,1,"おと"],[12,2,"せんしゃ"],[27,1,"か"],[29,1,"かぶ"],[31,1,"や"],[33,1,"ひ"],[35,1,"ほのお"],[37,1,"おと"],[45,1,"たたか"],[48,1,"そな"],[53,1,"つよ"],[55,2,"ぐんたい"]],"text":"山の頂でとびおどる音は、戦車のとどろくようである。また刈り株を焼く火の炎の音のようであり、戦いの備えをした強い軍隊のようである。"},{"ref":"Joel.2.6","start":29002006,"end":29002006,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"まえ"],[9,1,"たみ"],[19,1,"かお"],[21,1,"いろ"],[23,1,"うしな"]],"text":"その前にもろもろの民はなやみ、すべての顔は色を失う。"},{"ref":"Joel.2.7","start":29002007,"end":29002007,"break":"line","breaks":[[12,"line"],[26,"line"],[45,"line"]],"ruby":[[0,1,"かれ"],[3,2,"ゆうし"],[9,1,"はし"],[12,2,"へいし"],[18,2,"じょうへき"],[23,1,"のぼ"],[26,1,"かれ"],[33,2,"じぶん"],[36,1,"みち"],[38,1,"すす"],[41,1,"い"],[47,1,"みち"],[49,1,"ふ"]],"text":"彼らは勇士のように走り、兵士のように城壁によじ登る。彼らはおのおの自分の道を進んで行って、その道を踏みはずさない。"},{"ref":"Joel.2.8","start":29002008,"end":29002008,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かれ"],[3,1,"たがい"],[17,1,"みち"],[19,1,"すす"],[21,1,"い"],[24,1,"かれ"],[27,2,"ぶき"],[30,1,"なか"],[39,1,"み"]],"text":"彼らは互におしあわず、おのおのその道を進み行く。彼らは武器の中にとびこんでも、身をそこなわない。"},{"ref":"Joel.2.9","start":29002009,"end":29002009,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"まち"],[7,1,"はい"],[10,2,"じょうへき"],[13,1,"うえ"],[15,1,"はし"],[18,2,"いえいえ"],[23,1,"のぼ"],[26,1,"ぬす"],[33,1,"まど"]],"text":"彼らは町にとび入り、城壁の上を走り、家々によじ登り、盗びとのように窓からはいる。"},{"ref":"Joel.2.10","start":29002010,"end":29002010,"break":"stanza","breaks":[[18,"line"]],"ruby":[[0,1,"ち"],[2,1,"かれ"],[5,1,"まえ"],[12,1,"てん"],[18,1,"ひ"],[20,1,"つき"],[22,1,"くら"],[27,1,"ほし"],[31,1,"ひかり"],[33,1,"うしな"]],"text":"地は彼らの前におののき、天はふるい、日も月も暗くなり、星はその光を失う。"},{"ref":"Joel.2.11","start":29002011,"end":29002011,"break":"line","breaks":[[17,"line"],[33,"line"],[49,"line"],[70,"line"]],"ruby":[[0,1,"しゅ"],[4,2,"ぐんぜい"],[7,1,"まえ"],[9,1,"こえ"],[19,2,"ぐんたい"],[22,2,"ひじょう"],[25,1,"おお"],[36,2,"ことば"],[41,1,"と"],[44,1,"もの"],[46,1,"つよ"],[49,1,"しゅ"],[51,1,"ひ"],[53,1,"おお"],[63,1,"おそ"],[76,1,"た"]],"text":"主はその軍勢の前で声をあげられる。その軍隊は非常に多いからである。そのみ言葉をなし遂げる者は強い。主の日は大いにして、はなはだ恐ろしいゆえ、だれがこれに耐えることができよう。"},{"ref":"Joel.2.12","start":29002012,"end":29002012,"break":"stanza","breaks":[[7,"line"],[26,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"いま"],[20,1,"こころ"],[26,2,"だんじき"],[29,1,"なげ"],[33,1,"かな"],[45,1,"かえ"]],"text":"主は言われる、「今からでも、あなたがたは心をつくし、断食と嘆きと、悲しみとをもってわたしに帰れ。"},{"ref":"Joel.2.13","start":29002013,"end":29002013,"break":"line","breaks":[[19,"line"],[32,"line"],[46,"line"],[65,"line"]],"ruby":[[6,2,"いふく"],[13,1,"こころ"],[15,1,"さ"],[25,1,"かみ"],[27,1,"しゅ"],[29,1,"かえ"],[32,1,"しゅ"],[34,1,"めぐ"],[46,1,"いか"],[61,1,"ゆた"],[65,1,"わざわい"],[67,1,"おも"]],"text":"あなたがたは衣服ではなく、心を裂け」。あなたがたの神、主に帰れ。主は恵みあり、あわれみあり、怒ることがおそく、いつくしみが豊かで、災を思いかえされるからである。"},{"ref":"Joel.2.14","start":29002014,"end":29002014,"break":"line","breaks":[[11,"line"],[27,"line"],[34,"line"],[57,"line"]],"ruby":[[0,1,"かみ"],[6,1,"た"],[8,1,"かえ"],[11,1,"おも"],[17,2,"しゅくふく"],[22,1,"のち"],[24,1,"のこ"],[27,2,"そさい"],[30,2,"かんさい"],[40,1,"かみ"],[42,1,"しゅ"],[52,1,"こと"],[60,1,"し"]],"text":"神があるいは立ち返り、思いかえして祝福をその後に残し、素祭と灌祭とをあなたがたの神、主にささげさせられる事はないとだれが知るだろうか。"},{"ref":"Joel.2.15","start":29002015,"end":29002015,"break":"stanza","breaks":[[14,"line"]],"ruby":[[8,1,"ふ"],[14,2,"だんじき"],[17,2,"せいべつ"],[21,1,"せい"],[22,1,"かい"],[24,2,"しょうしゅう"]],"text":"シオンでラッパを吹きならせ。断食を聖別し、聖会を召集し、"},{"ref":"Joel.2.16","start":29002016,"end":29002016,"break":"line","breaks":[[12,"line"],[32,"line"],[45,"line"]],"ruby":[[0,1,"たみ"],[2,1,"あつ"],[5,2,"かいしゅう"],[8,2,"せいべつ"],[12,2,"ろうじん"],[17,1,"あつ"],[20,1,"おさ"],[22,1,"ご"],[24,1,"ち"],[27,1,"ご"],[29,1,"あつ"],[32,2,"はなむこ"],[37,1,"いえ"],[40,1,"よ"],[45,2,"はなよめ"],[54,1,"よ"]],"text":"民を集め、会衆を聖別し、老人たちを集め、幼な子、乳のみ子を集め、花婿をその家から呼びだし、花嫁をそのへやから呼びだせ。"},{"ref":"Joel.2.17","start":29002017,"end":29002017,"break":"line","breaks":[[11,"line"],[25,"line"],[39,"line"],[58,"line"],[76,"line"],[89,"line"],[104,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"つか"],[5,2,"さいし"],[11,1,"ろう"],[13,2,"さいだん"],[17,1,"あいだ"],[19,1,"な"],[22,1,"い"],[26,1,"しゅ"],[33,1,"たみ"],[43,1,"し"],[44,1,"ぎょう"],[51,2,"くにたみ"],[62,1,"わら"],[64,1,"ぐさ"],[85,2,"くにたみ"],[90,1,"かれ"],[93,1,"かみ"],[104,1,"い"]],"text":"主に仕える祭司たちは、廊と祭壇との間で泣いて言え、「主よ、あなたの民をゆるし、あなたの嗣業をもろもろの国民のうちに、そしりと笑い草にさせないでください。どうしてもろもろの国民に、『彼らの神はどこにいるのか』と言わせてよいでしょうか」。"},{"ref":"Joel.2.18","start":29002018,"end":29002018,"break":"stanza","breaks":[[21,"line"]],"ruby":[[2,1,"とき"],[3,1,"しゅ"],[5,2,"じぶん"],[8,1,"ち"],[18,1,"おこ"],[23,1,"たみ"]],"text":"その時主は自分の地のために、ねたみを起し、その民をあわれまれた。"},{"ref":"Joel.2.19","start":29002019,"end":29002019,"break":"line","breaks":[[15,"line"],[34,"line"],[43,"line"],[63,"line"],[76,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"こた"],[8,1,"たみ"],[10,1,"い"],[16,1,"み"],[23,2,"こくもつ"],[26,1,"あたら"],[29,1,"さけ"],[31,1,"あぶら"],[40,1,"おく"],[52,1,"た"],[55,1,"あ"],[67,1,"かさ"],[81,2,"くにたみ"],[91,1,"う"]],"text":"主は答えて、その民に言われた、「見よ、わたしは穀物と新しい酒と油とをあなたがたに送る。あなたがたはこれを食べて飽きるであろう。わたしは重ねてあなたがたにもろもろの国民のうちでそしりを受けさせない。"},{"ref":"Joel.2.20","start":29002020,"end":29002020,"break":"stanza","breaks":[[22,"line"],[38,"line"],[49,"line"],[64,"line"],[87,"line"]],"ruby":[[4,1,"きた"],[7,1,"く"],[9,1,"もの"],[18,1,"とお"],[29,1,"あ"],[31,1,"ち"],[33,1,"お"],[40,1,"まえ"],[42,1,"もの"],[44,1,"ひがし"],[46,1,"うみ"],[51,1,"のち"],[53,1,"もの"],[55,1,"にし"],[57,1,"うみ"],[59,1,"お"],[66,1,"くさ"],[72,1,"おこ"],[77,1,"あ"],[84,1,"のぼ"],[90,1,"おお"],[94,1,"こと"]],"text":"わたしは北から来る者をあなたがたから遠ざけ、これをかわいた荒れ地に追いやり、その前の者を東の海に、その後の者を西の海に追いやる。その臭いにおいは起り、その悪しきにおいは上る。これは大いなる事をしたからである。"},{"ref":"Joel.2.21","start":29002021,"end":29002021,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ち"],[2,1,"おそれ"],[6,1,"よろこ"],[8,1,"たの"],[12,1,"しゅ"],[14,1,"おお"],[18,1,"こと"],[20,1,"おこな"]],"text":"地よ恐るな、喜び楽しめ、主は大いなる事を行われたからである。"},{"ref":"Joel.2.22","start":29002022,"end":29002022,"break":"line","breaks":[[14,"line"],[34,"line"]],"ruby":[[0,1,"の"],[7,1,"けもの"],[10,1,"おそれ"],[14,2,"あらの"],[17,2,"ぼくそう"],[25,1,"き"],[29,1,"み"],[31,1,"むす"],[39,1,"き"],[45,1,"き"],[48,1,"ゆた"],[51,1,"みの"]],"text":"野のもろもろの獣よ、恐るな。荒野の牧草はもえいで、木はその実を結び、いちじくの木とぶどうの木とは豊かに実る。"},{"ref":"Joel.2.23","start":29002023,"end":29002023,"break":"stanza","breaks":[[8,"line"],[27,"line"],[49,"line"],[69,"line"]],"ruby":[[4,1,"こ"],[14,1,"かみ"],[16,1,"しゅ"],[21,1,"よろこ"],[23,1,"たの"],[27,1,"しゅ"],[35,1,"ぎ"],[42,1,"あき"],[44,1,"あめ"],[46,1,"たま"],[60,1,"ゆた"],[63,1,"あめ"],[65,1,"ふ"],[69,1,"まえ"],[75,1,"あき"],[77,1,"あめ"],[79,1,"はる"],[81,1,"あめ"],[84,1,"ふ"]],"text":"シオンの子らよ、あなたがたの神、主によって喜び楽しめ。主はあなたがたを義とするために秋の雨を賜い、またあなたがたのために豊かに雨を降らせ、前のように、秋の雨と春の雨とを降らせられる。"},{"ref":"Joel.2.24","start":29002024,"end":29002024,"break":"stanza","breaks":[[10,"line"]],"ruby":[[0,1,"う"],[2,1,"ば"],[4,2,"こくもつ"],[7,1,"み"],[10,1,"いし"],[14,1,"あたら"],[17,1,"さけ"],[19,1,"あぶら"]],"text":"打ち場は穀物で満ち、石がめは新しい酒と油とであふれる。"},{"ref":"Joel.2.25","start":29002025,"end":29002025,"break":"line","breaks":[[16,"line"],[33,"line"]],"ruby":[[10,1,"おく"],[13,2,"たいぐん"],[20,1,"むら"],[33,1,"ほろ"],[42,1,"く"],[49,1,"く"],[52,1,"とし"],[64,1,"つぐな"]],"text":"わたしがあなたがたに送った大軍、すなわち群がるいなご、とびいなご、滅ぼすいなご、かみ食らういなごの食った年をわたしはあなたがたに償う。"},{"ref":"Joel.2.26","start":29002026,"end":29002026,"break":"stanza","breaks":[[18,"line"],[35,"line"],[55,"line"]],"ruby":[[12,1,"た"],[15,1,"あ"],[24,3,"ふしぎ"],[41,1,"かみ"],[43,1,"しゅ"],[46,1,"な"],[57,1,"たみ"],[59,2,"えいえん"]],"text":"あなたがたは、じゅうぶん食べて飽き、あなたがたに不思議なわざをなされたあなたがたの神、主のみ名をほめたたえる。わが民は永遠にはずかしめられることがない。"},{"ref":"Joel.2.27","start":29002027,"end":29002027,"break":"none","breaks":[[15,"line"],[27,"line"],[46,"line"],[57,"line"]],"ruby":[[24,1,"し"],[27,1,"しゅ"],[40,1,"かみ"],[54,1,"し"],[59,1,"たみ"],[61,2,"えいえん"]],"text":"あなたがたはイスラエルのうちにわたしのいることを知り、主なるわたしがあなたがたの神であって、ほかにないことを知る。わが民は永遠にはずかしめられることがない。"},{"ref":"Joel.2.28","start":29002028,"end":29002028,"break":"stanza","breaks":[[11,"line"],[23,"line"],[40,"line"],[55,"line"]],"ruby":[[2,1,"のち"],[9,1,"れい"],[15,1,"にく"],[18,1,"もの"],[20,1,"そそ"],[33,1,"むすめ"],[35,2,"よげん"],[46,2,"ろうじん"],[51,1,"ゆめ"],[53,1,"み"],[61,2,"わかもの"],[66,1,"まぼろし"],[68,1,"み"]],"text":"その後わたしはわが霊をすべての肉なる者に注ぐ。あなたがたのむすこ、娘は預言をし、あなたがたの老人たちは夢を見、あなたがたの若者たちは幻を見る。"},{"ref":"Joel.2.29","start":29002029,"end":29002029,"break":"line","breaks":[[9,"line"]],"ruby":[[2,1,"ひ"],[11,1,"れい"],[22,1,"そそ"]],"text":"その日わたしはまたわが霊をしもべ、はしために注ぐ。"},{"ref":"Joel.2.30","start":29002030,"end":29002030,"break":"none","ruby":[[7,1,"てん"],[9,1,"ち"],[16,1,"しめ"],[23,1,"ち"],[26,1,"ひ"],[29,1,"けむり"],[31,1,"はしら"]],"text":"わたしはまた、天と地とにしるしを示す。すなわち血と、火と、煙の柱とがあるであろう。"},{"ref":"Joel.2.31","start":29002031,"end":29002031,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"おお"],[6,1,"おそ"],[10,1,"ひ"],[12,1,"く"],[14,1,"まえ"],[17,1,"ひ"],[19,1,"くら"],[22,1,"つき"],[24,1,"ち"],[26,1,"かわ"]],"text":"主の大いなる恐るべき日が来る前に、日は暗く、月は血に変る。"},{"ref":"Joel.2.32","start":29002032,"end":29002032,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"な"],[7,1,"よ"],[9,1,"もの"],[11,1,"すく"],[19,1,"しゅ"],[21,1,"い"],[33,1,"やま"],[47,1,"もの"],[59,1,"のこ"],[62,1,"もの"],[68,1,"しゅ"],[71,1,"め"],[76,1,"もの"]],"text":"すべて主の名を呼ぶ者は救われる。それは主が言われたように、シオンの山とエルサレムとに、のがれる者があるからである。その残った者のうちに、主のお召しになる者がある。"}]