[{"ref":"Ps.101.1","start":19101001,"end":19101001,"break":"paragraph","title":"ダビデの歌","breaks":[[21,"line"]],"ruby":[[10,2,"こうぎ"],[16,1,"うた"],[21,1,"しゅ"],[36,1,"うた"]],"titleRuby":[[4,1,"うた"]],"text":"わたしはいつくしみと公義について歌います。主よ、わたしはあなたにむかって歌います。"},{"ref":"Ps.101.2","start":19101002,"end":19101002,"break":"line","breaks":[[15,"line"],[36,"line"]],"ruby":[[4,1,"まった"],[6,1,"みち"],[8,1,"こころ"],[26,1,"こ"],[40,1,"なお"],[42,1,"こころ"],[50,1,"いえ"],[55,1,"あゆ"]],"text":"わたしは全き道に心をとめます。あなたはいつ、わたしに来られるでしょうか。わたしは直き心をもって、わが家のうちを歩みます。"},{"ref":"Ps.101.3","start":19101003,"end":19101003,"break":"line","breaks":[[19,"line"],[36,"line"]],"ruby":[[4,1,"め"],[6,1,"まえ"],[8,1,"いや"],[11,1,"こと"],[13,1,"お"],[26,1,"もの"],[28,1,"おこな"],[31,1,"にく"],[43,1,"つ"]],"text":"わたしは目の前に卑しい事を置きません。わたしはそむく者の行いを憎みます。それはわたしに付きまといません。"},{"ref":"Ps.101.4","start":19101004,"end":19101004,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"こころ"],[10,1,"はな"],[22,1,"わる"],[24,1,"こと"],[26,1,"し"]],"text":"ひがんだ心はわたしを離れるでしょう。わたしは悪い事を知りません。"},{"ref":"Ps.101.5","start":19101005,"end":19101005,"break":"line","breaks":[[16,"line"],[26,"line"]],"ruby":[[7,1,"とな"],[9,1,"びと"],[14,1,"もの"],[20,1,"ほろ"],[26,1,"たか"],[29,1,"め"],[31,2,"こうまん"],[34,1,"こころ"],[36,1,"ひと"],[38,1,"た"],[40,1,"しの"],[42,1,"こと"]],"text":"ひそかに、その隣り人をそしる者をわたしは滅ぼします。高ぶる目と高慢な心の人を耐え忍ぶ事はできません。"},{"ref":"Ps.101.6","start":19101006,"end":19101006,"break":"line","breaks":[[20,"line"],[33,"line"]],"ruby":[[4,1,"くに"],[9,2,"ちゅうしん"],[12,1,"もの"],[14,2,"こうい"],[17,1,"よ"],[24,1,"とも"],[26,1,"す"],[33,1,"まった"],[35,1,"みち"],[37,1,"あゆ"],[39,1,"もの"],[45,1,"つか"]],"text":"わたしは国のうちの忠信な者に好意を寄せ、わたしと共に住まわせます。全き道を歩む者はわたしに仕えるでしょう。"},{"ref":"Ps.101.7","start":19101007,"end":19101007,"break":"line","breaks":[[9,"line"],[27,"line"]],"ruby":[[0,1,"あざむ"],[7,1,"もの"],[11,1,"いえ"],[16,1,"す"],[27,1,"いつわ"],[30,1,"い"],[32,1,"もの"],[36,1,"め"],[38,1,"まえ"],[40,1,"た"]],"text":"欺くことをする者はわが家のうちに住むことができません。偽りを言う者はわが目の前に立つことができません。"},{"ref":"Ps.101.8","start":19101008,"end":19101008,"break":"line","breaks":[[15,"line"],[24,"line"]],"ruby":[[4,1,"あさ"],[8,1,"くに"],[10,1,"あ"],[13,1,"もの"],[20,1,"ほろ"],[24,2,"ふぎ"],[27,1,"おこな"],[29,1,"もの"],[36,1,"しゅ"],[38,1,"みやこ"],[41,1,"た"],[43,1,"のぞ"]],"text":"わたしは朝ごとに国の悪しき者をことごとく滅ぼし、不義を行う者をことごとく主の都から断ち除きます。"}]