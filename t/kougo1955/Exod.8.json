[{"ref":"Exod.8.1","start":2008001,"end":2008001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[23,1,"い"],[26,1,"い"],[33,1,"しゅ"],[37,1,"おお"],[49,1,"たみ"],[51,1,"さ"],[60,1,"つか"]],"text":"主はモーセに言われた、「あなたはパロのところに行って言いなさい、『主はこう仰せられます、「わたしの民を去らせて、わたしに仕えさせなさい。"},{"ref":"Exod.8.2","start":2008002,"end":2008002,"break":"none","ruby":[[4,1,"さ"],[11,1,"こば"],[17,1,"み"],[37,2,"りょうど"],[46,1,"う"]],"text":"しかし、去らせることを拒むならば、見よ、わたしは、かえるをもって、あなたの領土を、ことごとく撃つであろう。"},{"ref":"Exod.8.3","start":2008003,"end":2008003,"break":"none","ruby":[[3,1,"かわ"],[9,1,"むら"],[22,1,"いえ"],[28,2,"しんしつ"],[35,2,"しんだい"],[46,2,"けらい"],[49,1,"たみ"],[51,1,"いえ"],[70,1,"はち"]],"text":"ナイル川にかえるが群がり、のぼって、あなたの家、あなたの寝室にはいり、寝台にのぼり、あなたの家来と民の家にはいり、またあなたのかまどや、こね鉢にはいり、"},{"ref":"Exod.8.4","start":2008004,"end":2008004,"break":"none","ruby":[[9,1,"たみ"],[16,2,"けらい"],[26,1,"あ"]],"text":"あなたと、あなたの民と、すべての家来のからだに、はい上がるであろう」と』」。"},{"ref":"Exod.8.5","start":2008005,"end":2008005,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[20,1,"い"],[30,1,"も"],[34,1,"て"],[36,1,"かわ"],[38,1,"うえ"],[40,1,"なが"],[43,1,"うえ"],[46,1,"いけ"],[48,1,"うえ"],[52,1,"の"],[64,1,"ち"]],"text":"主はモーセに言われた、「あなたはアロンに言いなさい、『つえを持って、手を川の上、流れの上、、池の上にさし伸べ、かえるをエジプトの地にのぼらせなさい』と」。"},{"ref":"Exod.8.6","start":2008006,"end":2008006,"break":"none","ruby":[[4,1,"て"],[11,1,"みず"],[13,1,"うえ"],[17,1,"の"],[36,1,"ち"]],"text":"アロンが手をエジプトの水の上にさし伸べたので、かえるはのぼってエジプトの地をおおった。"},{"ref":"Exod.8.7","start":2008007,"end":2008007,"break":"none","ruby":[[0,2,"まじゅつ"],[2,1,"し"],[5,2,"ひじゅつ"],[11,1,"おな"],[16,1,"おこな"],[28,1,"ち"]],"text":"魔術師らも秘術をもって同じように行い、かえるをエジプトの地にのぼらせた。"},{"ref":"Exod.8.8","start":2008008,"end":2008008,"break":"paragraph","ruby":[[11,1,"め"],[14,1,"い"],[32,1,"たみ"],[35,1,"と"],[37,1,"さ"],[42,1,"しゅ"],[44,1,"ねが"],[62,1,"たみ"],[64,1,"さ"],[69,1,"しゅ"],[71,2,"ぎせい"]],"text":"パロはモーセとアロンを召して言った、「かえるをわたしと、わたしの民から取り去るように主に願ってください。そのときわたしはこの民を去らせて、主に犠牲をささげさせるでしょう」。"},{"ref":"Exod.8.9","start":2008009,"end":2008009,"break":"none","ruby":[[7,1,"い"],[21,2,"けらい"],[29,1,"たみ"],[41,1,"ねが"],[60,1,"いえ"],[63,1,"た"],[70,1,"かわ"]],"text":"モーセはパロに言った、「あなたと、あなたの家来と、あなたの民のために、わたしがいつ願って、このかえるを、あなたとあなたの家から断って、ナイル川だけにとどまらせるべきか、きめてください」。"},{"ref":"Exod.8.10","start":2008010,"end":2008010,"break":"none","ruby":[[3,1,"い"],[8,2,"みょうにち"],[16,1,"い"],[21,1,"おお"],[38,1,"かみ"],[40,1,"しゅ"],[42,1,"なら"],[57,1,"し"]],"text":"パロは言った、「明日」。モーセは言った、「仰せのとおりになって、わたしたちの神、主に並ぶもののないことを、あなたが知られますように。"},{"ref":"Exod.8.11","start":2008011,"end":2008011,"break":"none","ruby":[[17,1,"いえ"],[24,2,"けらい"],[32,1,"たみ"],[34,1,"はな"],[40,1,"かわ"]],"text":"そして、かえるはあなたと、あなたの家と、あなたの家来と、あなたの民を離れてナイル川にだけとどまるでしょう」。"},{"ref":"Exod.8.12","start":2008012,"end":2008012,"break":"none","ruby":[[15,1,"はな"],[18,1,"で"],[25,1,"しゅ"],[40,1,"こと"],[46,1,"しゅ"],[48,1,"よ"],[50,1,"もと"]],"text":"こうしてモーセとアロンはパロを離れて出た。モーセは主がパロにつかわされたかえるの事について、主に呼び求めたので、"},{"ref":"Exod.8.13","start":2008013,"end":2008013,"break":"none","ruby":[[0,1,"しゅ"],[20,1,"いえ"],[24,1,"にわ"],[30,1,"はたけ"],[33,1,"し"],[35,1,"た"]],"text":"主はモーセのことばのようにされ、かえるは家から、庭から、また畑から死に絶えた。"},{"ref":"Exod.8.14","start":2008014,"end":2008014,"break":"none","ruby":[[5,1,"やま"],[8,1,"やま"],[10,1,"つ"],[16,1,"ち"],[18,1,"くさ"]],"text":"これをひと山ひと山に積んだので、地は臭くなった。"},{"ref":"Exod.8.15","start":2008015,"end":2008015,"break":"none","ruby":[[7,1,"いき"],[18,1,"み"],[21,1,"しゅ"],[23,1,"い"],[33,1,"こころ"],[42,1,"かれ"],[45,1,"い"],[50,1,"き"]],"text":"ところがパロは息つくひまのできたのを見て、主が言われたように、その心をかたくなにして彼らの言うことを聞かなかった。"},{"ref":"Exod.8.16","start":2008016,"end":2008016,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[20,1,"い"],[36,1,"の"],[39,1,"ち"],[44,1,"う"],[55,2,"ぜんこく"]],"text":"主はモーセに言われた、「あなたはアロンに言いなさい、『あなたのつえをさし伸べて地のちりを打ち、それをエジプトの全国にわたって、ぶよとならせなさい』と」。"},{"ref":"Exod.8.17","start":2008017,"end":2008017,"break":"none","ruby":[[0,1,"かれ"],[8,1,"おこな"],[28,1,"て"],[32,1,"の"],[35,1,"ち"],[40,1,"う"],[49,1,"ひと"],[51,2,"かちく"],[63,1,"ち"],[75,2,"ぜんこく"]],"text":"彼らはそのように行った。すなわちアロンはそのつえをとって手をさし伸べ、地のちりを打ったので、ぶよは人と家畜についた。すなわち、地のちりはみなエジプトの全国にわたって、ぶよとなった。"},{"ref":"Exod.8.18","start":2008018,"end":2008018,"break":"none","ruby":[[0,2,"まじゅつ"],[2,1,"し"],[5,2,"ひじゅつ"],[11,1,"おな"],[16,1,"おこな"],[22,1,"だ"],[30,1,"かれ"],[44,1,"ひと"],[46,2,"かちく"]],"text":"魔術師らも秘術をもって同じように行い、ぶよを出そうとしたが、彼らにはできなかった。ぶよが人と家畜についたので、"},{"ref":"Exod.8.19","start":2008019,"end":2008019,"break":"none","ruby":[[0,2,"まじゅつ"],[2,1,"し"],[8,1,"い"],[16,1,"かみ"],[18,1,"ゆび"],[26,1,"しゅ"],[28,1,"い"],[39,1,"こころ"],[50,1,"かれ"],[58,1,"き"]],"text":"魔術師らはパロに言った、「これは神の指です」。しかし主の言われたように、パロの心はかたくなになって、彼らのいうことを聞かなかった。"},{"ref":"Exod.8.20","start":2008020,"end":2008020,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"あさ"],[17,1,"はや"],[19,1,"お"],[25,1,"まえ"],[27,1,"た"],[37,1,"かれ"],[39,1,"みず"],[45,1,"で"],[51,1,"かれ"],[53,1,"い"],[60,1,"しゅ"],[64,1,"おお"],[75,1,"たみ"],[77,1,"さ"],[86,1,"つか"]],"text":"主はモーセに言われた、「あなたは朝早く起きてパロの前に立ちなさい。ちょうど彼は水のところに出ているから彼に言いなさい、『主はこう仰せられる、「わたしの民を去らせて、わたしに仕えさせなさい。"},{"ref":"Exod.8.21","start":2008021,"end":2008021,"break":"none","ruby":[[8,1,"たみ"],[10,1,"さ"],[32,2,"けらい"],[40,1,"たみ"],[46,1,"いえ"],[53,1,"む"],[72,2,"いえいえ"],[79,1,"む"],[82,1,"み"],[85,1,"かれ"],[88,1,"ふ"],[90,1,"ち"]],"text":"あなたがわたしの民を去らせないならば、わたしは、あなたとあなたの家来と、あなたの民とあなたの家とに、あぶの群れをつかわすであろう。エジプトびとの家々は、あぶの群れで満ち、彼らの踏む地もまた、そうなるであろう。"},{"ref":"Exod.8.22","start":2008022,"end":2008022,"break":"none","ruby":[[2,1,"ひ"],[12,1,"たみ"],[14,1,"す"],[20,1,"ち"],[22,1,"く"],[23,1,"べっ"],[33,1,"む"],[36,1,"い"],[45,1,"くに"],[47,1,"なか"],[53,1,"しゅ"],[64,1,"し"]],"text":"その日わたしは、わたしの民の住むゴセンの地を区別して、そこにあぶの群れを入れないであろう。国の中でわたしが主であることをあなたが知るためである。"},{"ref":"Exod.8.23","start":2008023,"end":2008023,"break":"none","ruby":[[8,1,"たみ"],[14,1,"たみ"],[16,1,"あいだ"],[18,2,"くべつ"],[33,1,"おこ"]],"text":"わたしはわたしの民とあなたの民の間に区別をおく。このしるしは、あす起るであろう」と』」。"},{"ref":"Exod.8.24","start":2008024,"end":2008024,"break":"none","ruby":[[0,1,"しゅ"],[26,1,"いえ"],[31,2,"けらい"],[34,1,"いえ"],[42,2,"ぜんこく"],[52,1,"ち"],[57,1,"む"],[63,1,"がい"]],"text":"主はそのようにされたので、おびただしいあぶが、パロの家と、その家来の家と、エジプトの全国にはいってきて、地はあぶの群れのために害をうけた。"},{"ref":"Exod.8.25","start":2008025,"end":2008025,"break":"paragraph","ruby":[[15,1,"め"],[18,1,"い"],[29,1,"い"],[34,1,"くに"],[36,1,"うち"],[45,1,"かみ"],[47,2,"ぎせい"]],"text":"そこで、パロはモーセとアロンを召して言った、「あなたがたは行ってこの国の内で、あなたがたの神に犠牲をささげなさい」。"},{"ref":"Exod.8.26","start":2008026,"end":2008026,"break":"none","ruby":[[4,1,"い"],[35,1,"い"],[40,2,"ぎせい"],[52,1,"かみ"],[54,1,"しゅ"],[75,1,"め"],[77,1,"まえ"],[80,1,"かれ"],[83,1,"い"],[88,2,"ぎせい"],[99,1,"かれ"],[108,1,"いし"],[110,1,"う"]],"text":"モーセは言った、「そうすることはできません。わたしたちはエジプトびとの忌むものを犠牲として、わたしたちの神、主にささげるからです。もし、エジプトびとの目の前で、彼らの忌むものを犠牲にささげるならば、彼らはわたしたちを石で打たないでしょうか。"},{"ref":"Exod.8.27","start":2008027,"end":2008027,"break":"none","ruby":[[7,1,"か"],[9,1,"みち"],[15,2,"あらの"],[29,1,"かみ"],[31,1,"しゅ"],[33,2,"ぎせい"],[40,1,"しゅ"],[48,1,"めい"]],"text":"わたしたちは三日の道のりほど、荒野にはいって、わたしたちの神、主に犠牲をささげ、主がわたしたちに命じられるようにしなければなりません」。"},{"ref":"Exod.8.28","start":2008028,"end":2008028,"break":"none","ruby":[[3,1,"い"],[18,1,"さ"],[22,2,"あらの"],[32,1,"かみ"],[34,1,"しゅ"],[36,2,"ぎせい"],[52,1,"とお"],[55,1,"い"],[71,2,"きがん"]],"text":"パロは言った、「わたしはあなたがたを去らせ、荒野で、あなたがたの神、主に犠牲をささげさせよう。ただあまり遠くへ行ってはならない。わたしのために祈願しなさい」。"},{"ref":"Exod.8.29","start":2008029,"end":2008029,"break":"none","ruby":[[4,1,"い"],[21,1,"で"],[23,1,"い"],[26,1,"しゅ"],[28,2,"きがん"],[41,1,"む"],[50,2,"けらい"],[56,1,"たみ"],[59,1,"はな"],[74,1,"あざむ"],[78,1,"たみ"],[80,1,"しゅ"],[82,2,"ぎせい"],[89,1,"い"]],"text":"モーセは言った、「わたしはあなたのもとから出て行って主に祈願しましょう。あすあぶの群れがパロと、その家来と、その民から離れるでしょう。ただパロはまた欺いて、民が主に犠牲をささげに行くのをとめないようにしてください」。"},{"ref":"Exod.8.30","start":2008030,"end":2008030,"break":"none","ruby":[[14,1,"で"],[17,1,"しゅ"],[19,2,"きがん"]],"text":"こうしてモーセはパロのもとを出て、主に祈願したので、"},{"ref":"Exod.8.31","start":2008031,"end":2008031,"break":"none","ruby":[[0,1,"しゅ"],[6,2,"ことば"],[24,1,"む"],[33,2,"けらい"],[39,1,"たみ"],[42,1,"と"],[44,1,"さ"],[54,1,"のこ"]],"text":"主はモーセの言葉のようにされた。すなわち、あぶの群れをパロと、その家来と、その民から取り去られたので、一つも残らなかった。"},{"ref":"Exod.8.32","start":2008032,"end":2008032,"break":"none","ruby":[[15,1,"こころ"],[24,1,"たみ"],[26,1,"さ"]],"text":"しかしパロはこんどもまた、その心をかたくなにして民を去らせなかった。"}]