[{"ref":"Exod.32.1","start":2032001,"end":2032001,"break":"paragraph","ruby":[[0,1,"たみ"],[6,1,"やま"],[8,1,"くだ"],[18,1,"み"],[28,1,"あつ"],[32,1,"かれ"],[34,1,"い"],[48,2,"さきだ"],[52,1,"ゆ"],[54,1,"かみ"],[66,1,"つく"],[85,1,"くに"],[88,1,"みちび"],[94,1,"ひと"]],"text":"民はモーセが山を下ることのおそいのを見て、アロンのもとに集まって彼に言った、「さあ、わたしたちに先立って行く神を、わたしたちのために造ってください。わたしたちをエジプトの国から導きのぼった人、あのモーセはどうなったのかわからないからです」。"},{"ref":"Exod.32.2","start":2032002,"end":2032002,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[18,1,"つま"],[24,1,"むすめ"],[27,1,"きん"],[29,2,"みみわ"],[40,1,"も"]],"text":"アロンは彼らに言った、「あなたがたの妻、むすこ、娘らの金の耳輪をはずしてわたしに持ってきなさい」。"},{"ref":"Exod.32.3","start":2032003,"end":2032003,"break":"none","ruby":[[3,1,"たみ"],[5,1,"みな"],[8,1,"きん"],[10,2,"みみわ"],[24,1,"も"]],"text":"そこで民は皆その金の耳輪をはずしてアロンのもとに持ってきた。"},{"ref":"Exod.32.4","start":2032004,"end":2032004,"break":"none","ruby":[[7,1,"かれ"],[10,1,"て"],[13,1,"う"],[15,1,"と"],[18,2,"こうぐ"],[21,1,"かた"],[23,1,"つく"],[26,1,"い"],[28,1,"こ"],[29,1,"うし"],[36,1,"かれ"],[39,1,"い"],[63,1,"くに"],[66,1,"みちび"],[76,1,"かみ"]],"text":"アロンがこれを彼らの手から受け取り、工具で型を造り、鋳て子牛としたので、彼らは言った、「イスラエルよ、これはあなたをエジプトの国から導きのぼったあなたの神である」。"},{"ref":"Exod.32.5","start":2032005,"end":2032005,"break":"none","ruby":[[7,1,"み"],[12,1,"まえ"],[14,2,"さいだん"],[17,1,"きず"],[28,2,"ふこく"],[32,1,"い"],[40,1,"しゅ"],[42,1,"まつり"]],"text":"アロンはこれを見て、その前に祭壇を築いた。そしてアロンは布告して言った、「あすは主の祭である」。"},{"ref":"Exod.32.6","start":2032006,"end":2032006,"break":"none","ruby":[[3,2,"ひとびと"],[9,1,"あさ"],[10,1,"はや"],[12,1,"お"],[15,2,"はんさい"],[22,3,"しゅうおんさい"],[26,1,"そな"],[30,1,"たみ"],[32,1,"ざ"],[35,1,"く"],[37,1,"の"],[41,1,"た"],[44,1,"ざ"]],"text":"そこで人々はあくる朝早く起きて燔祭をささげ、酬恩祭を供えた。民は座して食い飲みし、立って戯れた。"},{"ref":"Exod.32.7","start":2032007,"end":2032007,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"いそ"],[15,1,"くだ"],[30,1,"くに"],[33,1,"みちび"],[43,1,"たみ"],[45,1,"わる"]],"text":"主はモーセに言われた、「急いで下りなさい。あなたがエジプトの国から導きのぼったあなたの民は悪いことをした。"},{"ref":"Exod.32.8","start":2032008,"end":2032008,"break":"none","ruby":[[0,1,"かれ"],[3,1,"はや"],[10,1,"めい"],[13,1,"みち"],[15,1,"はな"],[18,2,"じぶん"],[24,2,"いもの"],[27,1,"こ"],[28,1,"うし"],[30,1,"つく"],[36,1,"おが"],[42,2,"ぎせい"],[70,1,"くに"],[73,1,"みちび"],[83,1,"かみ"],[89,1,"い"]],"text":"彼らは早くもわたしが命じた道を離れ、自分のために鋳物の子牛を造り、これを拝み、これに犠牲をささげて、『イスラエルよ、これはあなたをエジプトの国から導きのぼったあなたの神である』と言っている」。"},{"ref":"Exod.32.9","start":2032009,"end":2032009,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"い"],[20,1,"たみ"],[22,1,"み"],[33,1,"たみ"]],"text":"主はまたモーセに言われた、「わたしはこの民を見た。これはかたくなな民である。"},{"ref":"Exod.32.10","start":2032010,"end":2032010,"break":"none","ruby":[[17,1,"いか"],[20,1,"かれ"],[27,1,"も"],[30,1,"かれ"],[33,1,"ほろ"],[56,1,"おお"],[60,2,"こくみん"]],"text":"それで、わたしをとめるな。わたしの怒りは彼らにむかって燃え、彼らを滅ぼしつくすであろう。しかし、わたしはあなたを大いなる国民とするであろう」。"},{"ref":"Exod.32.11","start":2032011,"end":2032011,"break":"paragraph","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[14,1,"い"],[19,1,"しゅ"],[22,1,"おお"],[26,1,"ちから"],[28,1,"つよ"],[30,1,"て"],[41,1,"くに"],[44,1,"みちび"],[46,1,"だ"],[54,1,"たみ"],[67,1,"いか"],[70,1,"も"]],"text":"モーセはその神、主をなだめて言った、「主よ、大いなる力と強き手をもって、エジプトの国から導き出されたあなたの民にむかって、なぜあなたの怒りが燃えるのでしょうか。"},{"ref":"Exod.32.12","start":2032012,"end":2032012,"break":"none","ruby":[[12,1,"かれ"],[14,2,"あくい"],[20,1,"かれ"],[23,1,"みちび"],[25,1,"だ"],[28,1,"かれ"],[31,2,"さんち"],[34,1,"ころ"],[37,1,"ち"],[39,1,"めん"],[42,1,"た"],[44,1,"ほろ"],[51,1,"い"],[70,1,"はげ"],[73,1,"いか"],[83,1,"たみ"],[85,1,"くだ"],[94,1,"わざわい"],[96,1,"おも"],[98,1,"なお"]],"text":"どうしてエジプトびとに『彼は悪意をもって彼らを導き出し、彼らを山地で殺し、地の面から断ち滅ぼすのだ』と言わせてよいでしょうか。どうかあなたの激しい怒りをやめ、あなたの民に下そうとされるこの災を思い直し、"},{"ref":"Exod.32.13","start":2032013,"end":2032013,"break":"none","ruby":[[28,1,"ご"],[29,2,"じしん"],[35,1,"ちか"],[43,1,"てん"],[45,1,"ほし"],[57,2,"しそん"],[60,1,"ま"],[67,2,"やくそく"],[73,1,"ち"],[75,1,"みな"],[82,2,"しそん"],[85,1,"あた"],[89,1,"なが"],[94,2,"しょゆう"],[105,1,"かれ"],[108,1,"おお"],[116,1,"おぼ"]],"text":"あなたのしもべアブラハム、イサク、イスラエルに、あなたが御自身をさして誓い、『わたしは天の星のように、あなたがたの子孫を増し、わたしが約束したこの地を皆あなたがたの子孫に与えて、長くこれを所有させるであろう』と彼らに仰せられたことを覚えてください」。"},{"ref":"Exod.32.14","start":2032014,"end":2032014,"break":"none","ruby":[[4,1,"しゅ"],[8,1,"たみ"],[10,1,"くだ"],[13,1,"い"],[17,1,"わざわい"],[22,1,"おも"],[24,1,"なお"]],"text":"それで、主はその民に下すと言われた災について思い直された。"},{"ref":"Exod.32.15","start":2032015,"end":2032015,"break":"paragraph","ruby":[[4,1,"み"],[6,1,"てん"],[9,1,"やま"],[11,1,"くだ"],[15,1,"かれ"],[17,1,"て"],[24,1,"まい"],[30,1,"いた"],[36,1,"いた"],[40,2,"りょうめん"],[43,2,"もじ"],[57,1,"めん"],[63,1,"めん"],[66,2,"もじ"]],"text":"モーセは身を転じて山を下った。彼の手には、かの二枚のあかしの板があった。板はその両面に文字があった。すなわち、この面にも、かの面にも文字があった。"},{"ref":"Exod.32.16","start":2032016,"end":2032016,"break":"none","ruby":[[2,1,"いた"],[4,1,"かみ"],[6,1,"さく"],[10,2,"もじ"],[13,1,"かみ"],[15,2,"もじ"],[22,1,"いた"],[24,1,"ほ"]],"text":"その板は神の作、その文字は神の文字であって、板に彫ったものである。"},{"ref":"Exod.32.17","start":2032017,"end":2032017,"break":"none","ruby":[[5,1,"たみ"],[7,1,"よ"],[11,1,"こえ"],[13,1,"き"],[21,1,"い"],[26,2,"しゅくえい"],[29,1,"なか"],[31,1,"たたか"],[34,1,"こえ"]],"text":"ヨシュアは民の呼ばわる声を聞いて、モーセに言った、「宿営の中に戦いの声がします」。"},{"ref":"Exod.32.18","start":2032018,"end":2032018,"break":"none","ruby":[[8,1,"い"],[13,1,"かち"],[17,1,"こえ"],[22,2,"はいぼく"],[25,1,"さけ"],[27,1,"ごえ"],[37,1,"き"],[41,1,"うた"],[43,1,"こえ"]],"text":"しかし、モーセは言った、「勝どきの声でなく、敗北の叫び声でもない。わたしの聞くのは歌の声である」。"},{"ref":"Exod.32.19","start":2032019,"end":2032019,"break":"none","ruby":[[4,2,"しゅくえい"],[7,1,"ちか"],[12,1,"こ"],[13,1,"うし"],[15,1,"おど"],[19,1,"み"],[24,1,"かれ"],[26,1,"いか"],[29,1,"も"],[32,1,"て"],[37,1,"いた"],[39,1,"な"],[47,1,"やま"],[53,1,"くだ"]],"text":"モーセが宿営に近づくと、子牛と踊りとを見たので、彼は怒りに燃え、手からかの板を投げうち、これを山のふもとで砕いた。"},{"ref":"Exod.32.20","start":2032020,"end":2032020,"break":"none","ruby":[[2,1,"かれ"],[5,1,"つく"],[8,1,"こ"],[9,1,"うし"],[11,1,"と"],[14,1,"ひ"],[16,1,"や"],[24,1,"くだ"],[30,1,"みず"],[32,1,"うえ"],[44,2,"ひとびと"],[47,1,"の"]],"text":"また彼らが造った子牛を取って火に焼き、こなごなに砕き、これを水の上にまいて、イスラエルの人々に飲ませた。"},{"ref":"Exod.32.21","start":2032021,"end":2032021,"break":"paragraph","ruby":[[8,1,"い"],[15,1,"たみ"],[21,1,"なに"],[32,1,"かれ"],[35,1,"おお"],[39,1,"つみ"],[41,1,"おか"]],"text":"モーセはアロンに言った、「この民があなたに何をしたので、あなたは彼らに大いなる罪を犯させたのですか」。"},{"ref":"Exod.32.22","start":2032022,"end":2032022,"break":"none","ruby":[[4,1,"い"],[11,1,"しゅ"],[14,1,"はげ"],[17,1,"いか"],[29,1,"たみ"],[31,1,"わる"]],"text":"アロンは言った、「わが主よ、激しく怒らないでください。この民の悪いのは、あなたがごぞんじです。"},{"ref":"Exod.32.23","start":2032023,"end":2032023,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[20,2,"さきだ"],[24,1,"い"],[26,1,"かみ"],[38,1,"つく"],[57,1,"くに"],[60,1,"みちび"],[66,1,"ひと"]],"text":"彼らはわたしに言いました、『わたしたちに先立って行く神を、わたしたちのために造ってください。わたしたちをエジプトの国から導きのぼった人、あのモーセは、どうなったのかわからないからです』。"},{"ref":"Exod.32.24","start":2032024,"end":2032024,"break":"none","ruby":[[13,1,"きん"],[15,1,"も"],[20,1,"もの"],[26,1,"と"],[36,1,"かれ"],[39,1,"い"],[45,1,"かれ"],[55,1,"わた"],[68,1,"ひ"],[70,1,"な"],[72,1,"い"],[79,1,"こ"],[80,1,"うし"],[82,1,"で"]],"text":"そこでわたしは『だれでも、金を持っている者は、それを取りはずしなさい』と彼らに言いました。彼らがそれをわたしに渡したので、わたしがこれを火に投げ入れると、この子牛が出てきたのです」。"},{"ref":"Exod.32.25","start":2032025,"end":2032025,"break":"paragraph","ruby":[[4,1,"たみ"],[19,1,"み"],[26,1,"かれ"],[40,1,"まか"],[43,1,"てき"],[45,1,"なか"],[47,2,"ものわら"]],"text":"モーセは民がほしいままにふるまったのを見た。アロンは彼らがほしいままにふるまうに任せ、敵の中に物笑いとなったからである。"},{"ref":"Exod.32.26","start":2032026,"end":2032026,"break":"none","ruby":[[4,2,"しゅくえい"],[7,1,"もん"],[9,1,"た"],[12,1,"い"],[20,1,"しゅ"],[24,1,"もの"],[42,1,"こ"],[48,1,"かれ"],[53,1,"あつ"]],"text":"モーセは宿営の門に立って言った、「すべて主につく者はわたしのもとにきなさい」。レビの子たちはみな彼のもとに集まった。"},{"ref":"Exod.32.27","start":2032027,"end":2032027,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[21,1,"かみ"],[23,1,"しゅ"],[27,1,"い"],[44,1,"こし"],[50,1,"お"],[53,2,"しゅくえい"],[56,1,"なか"],[58,1,"もん"],[61,1,"もん"],[63,1,"い"],[65,1,"めぐ"],[75,2,"きょうだい"],[80,1,"とも"],[84,2,"りんじん"],[87,1,"ころ"]],"text":"そこでモーセは彼らに言った、「イスラエルの神、主はこう言われる、『あなたがたは、おのおの腰につるぎを帯び、宿営の中を門から門へ行き巡って、おのおのその兄弟、その友、その隣人を殺せ』」。"},{"ref":"Exod.32.28","start":2032028,"end":2032028,"break":"none","ruby":[[3,1,"こ"],[11,2,"ことば"],[24,1,"ひ"],[26,1,"たみ"],[37,1,"にん"],[39,1,"たお"]],"text":"レビの子たちはモーセの言葉どおりにしたので、その日、民のうち、おおよそ三千人が倒れた。"},{"ref":"Exod.32.29","start":2032029,"end":2032029,"break":"none","ruby":[[8,1,"い"],[26,1,"こ"],[30,2,"きょうだい"],[33,1,"さか"],[42,1,"しゅ"],[44,1,"み"],[54,1,"しゅ"],[67,2,"しゅくふく"],[70,1,"あた"]],"text":"そこで、モーセは言った、「あなたがたは、おのおのその子、その兄弟に逆らって、きょう、主に身をささげた。それで主は、きょう、あなたがたに祝福を与えられるであろう」。"},{"ref":"Exod.32.30","start":2032030,"end":2032030,"break":"paragraph","ruby":[[3,1,"ひ"],[9,1,"たみ"],[11,1,"い"],[22,1,"おお"],[26,1,"つみ"],[28,1,"おか"],[35,1,"いま"],[41,1,"しゅ"],[46,1,"のぼ"],[49,1,"い"],[58,1,"つみ"],[60,1,"つぐな"],[71,1,"し"]],"text":"あくる日、モーセは民に言った、「あなたがたは大いなる罪を犯した。それで今、わたしは主のもとに上って行く。あなたがたの罪を償うことが、できるかも知れない」。"},{"ref":"Exod.32.31","start":2032031,"end":2032031,"break":"none","ruby":[[4,1,"しゅ"],[9,1,"かえ"],[16,1,"い"],[26,1,"たみ"],[28,1,"おお"],[32,1,"つみ"],[34,1,"おか"],[37,2,"じぶん"],[43,1,"きん"],[45,1,"かみ"],[47,1,"つく"]],"text":"モーセは主のもとに帰って、そして言った、「ああ、この民は大いなる罪を犯し、自分のために金の神を造りました。"},{"ref":"Exod.32.32","start":2032032,"end":2032032,"break":"none","ruby":[[0,1,"いま"],[8,1,"かれ"],[11,1,"つみ"],[46,1,"か"],[62,1,"な"],[64,1,"け"],[66,1,"さ"]],"text":"今もしあなたが、彼らの罪をゆるされますならば――。しかし、もしかなわなければ、どうぞあなたが書きしるされたふみから、わたしの名を消し去ってください」。"},{"ref":"Exod.32.33","start":2032033,"end":2032033,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[19,1,"つみ"],[21,1,"おか"],[24,1,"もの"],[38,1,"け"],[40,1,"さ"]],"text":"主はモーセに言われた、「すべてわたしに罪を犯した者は、これをわたしのふみから消し去るであろう。"},{"ref":"Exod.32.34","start":2032034,"end":2032034,"break":"none","ruby":[[4,1,"いま"],[9,1,"い"],[21,1,"つ"],[28,1,"たみ"],[30,1,"みちび"],[36,1,"み"],[43,1,"つかい"],[49,2,"さきだ"],[53,1,"い"],[63,2,"けいばつ"],[66,1,"ひ"],[73,1,"かれ"],[76,1,"つみ"],[78,1,"ばっ"]],"text":"しかし、今あなたは行って、わたしがあなたに告げたところに民を導きなさい。見よ、わたしの使はあなたに先立って行くであろう。ただし刑罰の日に、わたしは彼らの罪を罰するであろう」。"},{"ref":"Exod.32.35","start":2032035,"end":2032035,"break":"paragraph","ruby":[[3,1,"しゅ"],[5,1,"たみ"],[7,1,"う"],[12,1,"かれ"],[15,1,"こ"],[16,1,"うし"],[18,1,"つく"],[34,1,"つく"]],"text":"そして主は民を撃たれた。彼らが子牛を造ったからである。それはアロンが造ったのである。"}]