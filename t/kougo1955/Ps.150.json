[{"ref":"Ps.150.1","start":19150001,"end":19150001,"break":"paragraph","breaks":[[9,"line"],[23,"line"]],"ruby":[[0,1,"しゅ"],[11,2,"せいじょ"],[14,1,"かみ"],[25,1,"ちから"],[32,2,"おおぞら"],[35,1,"しゅ"]],"text":"主をほめたたえよ。その聖所で神をほめたたえよ。その力のあらわれる大空で主をほめたたえよ。"},{"ref":"Ps.150.2","start":19150002,"end":19150002,"break":"line","breaks":[[22,"line"],[38,"line"]],"ruby":[[2,2,"たいのう"],[13,1,"しゅ"],[28,1,"おお"],[38,1,"しゅ"]],"text":"その大能のはたらきのゆえに主をほめたたえよ。そのすぐれて大いなることのゆえに主をほめたたえよ。"},{"ref":"Ps.150.3","start":19150003,"end":19150003,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"こえ"],[9,1,"しゅ"],[18,2,"たてごと"],[21,1,"こと"],[27,1,"しゅ"]],"text":"ラッパの声をもって主をほめたたえよ。立琴と琴とをもって主をほめたたえよ。"},{"ref":"Ps.150.4","start":19150004,"end":19150004,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"つづみ"],[2,1,"おど"],[9,1,"しゅ"],[18,2,"おごと"],[21,1,"ふえ"],[27,1,"しゅ"]],"text":"鼓と踊りとをもって主をほめたたえよ。緒琴と笛とをもって主をほめたたえよ。"},{"ref":"Ps.150.5","start":19150005,"end":19150005,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ね"],[2,1,"たか"],[12,1,"しゅ"],[21,1,"な"],[34,1,"しゅ"]],"text":"音の高いシンバルをもって主をほめたたえよ。鳴りひびくシンバルをもって主をほめたたえよ。"},{"ref":"Ps.150.6","start":19150006,"end":19150006,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"いき"],[11,1,"しゅ"],[22,1,"しゅ"]],"text":"息のあるすべてのものに主をほめたたえさせよ。主をほめたたえよ。"}]