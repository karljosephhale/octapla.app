[{"ref":"Hos.7.1","start":28007001,"end":28007001,"break":"paragraph","breaks":[[16,"line"],[26,"line"],[42,"line"],[53,"line"],[65,"line"]],"ruby":[[22,2,"ふぎ"],[31,1,"あ"],[38,1,"あらわ"],[42,1,"かれ"],[45,1,"いつわ"],[53,1,"うち"],[56,1,"ぬす"],[60,1,"お"],[62,1,"い"],[65,1,"そと"],[68,2,"さんぞく"],[71,1,"む"],[74,1,"おそ"]],"text":"わたしがイスラエルをいやすとき、エフライムの不義と、サマリヤの悪しきわざとは現れる。彼らは偽りをおこない、内では盗びとが押し入り、外では山賊の群れが襲いきたる。"},{"ref":"Hos.7.2","start":28007002,"end":28007002,"break":"line","breaks":[[20,"line"],[33,"line"],[47,"line"]],"ruby":[[4,1,"かれ"],[11,1,"かれ"],[18,1,"あく"],[20,1,"おぼ"],[28,1,"さと"],[33,1,"いま"],[40,1,"かれ"],[43,1,"かこ"],[51,1,"かお"],[53,1,"まえ"]],"text":"しかし、彼らはわたしが彼らのすべての悪を覚えていることを悟らない。今、そのわざは彼らを囲んで、わたしの顔の前にある。"},{"ref":"Hos.7.3","start":28007003,"end":28007003,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[5,1,"あく"],[10,1,"おう"],[12,1,"よろこ"],[18,1,"いつわ"],[24,1,"きみ"],[28,1,"よろこ"]],"text":"彼らはその悪をもって王を喜ばせ、その偽りをもって君たちを喜ばせる。"},{"ref":"Hos.7.4","start":28007004,"end":28007004,"break":"line","breaks":[[13,"line"],[30,"line"],[48,"line"]],"ruby":[[0,1,"かれ"],[5,2,"かんいん"],[8,1,"おこな"],[10,1,"もの"],[16,1,"や"],[18,1,"もの"],[20,1,"あつ"],[24,1,"ろ"],[33,1,"や"],[35,1,"もの"],[40,1,"こ"],[63,1,"ひ"],[68,1,"こと"]],"text":"彼らはみな姦淫を行う者で、パンを焼く者が熱くする炉のようだ。パンを焼く者は、ねり粉をこねてから、それがふくれるまで、しばらく、火をおこす事をしないだけだ。"},{"ref":"Hos.7.5","start":28007005,"end":28007005,"break":"line","breaks":[[10,"line"],[30,"line"]],"ruby":[[5,1,"おう"],[7,1,"ひ"],[16,1,"さけ"],[18,1,"ねつ"],[23,1,"や"],[30,1,"おう"],[36,1,"もの"],[38,1,"とも"],[40,1,"て"],[42,1,"の"]],"text":"われわれの王の日に、つかさたちは酒の熱によって病みわずらい、王はあざける者と共に手を伸べた。"},{"ref":"Hos.7.6","start":28007006,"end":28007006,"break":"line","breaks":[[22,"line"],[35,"line"]],"ruby":[[0,1,"かれ"],[3,2,"いんぼう"],[11,1,"こころ"],[13,1,"ろ"],[18,1,"も"],[24,1,"いか"],[27,2,"よどお"],[35,1,"あさ"],[40,1,"ほのお"],[45,1,"も"]],"text":"彼らは陰謀をもってその心を炉のように燃やす。その怒りは夜通しくすぶり、朝になると炎のように燃える。"},{"ref":"Hos.7.7","start":28007007,"end":28007007,"break":"line","breaks":[[16,"line"],[30,"line"],[45,"line"]],"ruby":[[0,1,"かれ"],[3,1,"みな"],[5,1,"ろ"],[10,1,"あつ"],[24,1,"や"],[26,1,"ほろ"],[37,1,"おう"],[39,1,"みな"],[45,1,"かれ"],[48,1,"なか"],[55,1,"よ"],[57,1,"もの"]],"text":"彼らは皆、炉のように熱くなって、そのさばきびとを焼き滅ぼす。そのもろもろの王は皆たおれる。彼らの中にはわたしを呼ぶ者がひとりもない。"},{"ref":"Hos.7.8","start":28007008,"end":28007008,"break":"stanza","breaks":[[21,"line"]],"ruby":[[11,1,"たみ"],[13,1,"なか"],[15,1,"はい"],[17,1,"ま"],[27,1,"ひ"],[38,2,"かし"]],"text":"エフライムはもろもろの民の中に入り混じる。エフライムは火にかけて、かえさない菓子である。"},{"ref":"Hos.7.9","start":28007009,"end":28007009,"break":"line","breaks":[[15,"line"],[25,"line"]],"ruby":[[0,2,"たこく"],[2,1,"じん"],[5,1,"かれ"],[7,1,"ちから"],[9,1,"く"],[11,1,"つく"],[15,1,"かれ"],[20,1,"し"],[29,1,"ま"],[41,1,"さと"]],"text":"他国人らは彼の力を食い尽すが、彼はそれを知らない。しらがが混じってはえても、それを悟らない。"},{"ref":"Hos.7.10","start":28007010,"end":28007010,"break":"line","breaks":[[22,"line"],[39,"line"],[51,"line"]],"ruby":[[6,1,"ほこり"],[8,1,"みずか"],[11,1,"む"],[15,2,"しょうげん"],[22,1,"かれ"],[32,1,"こと"],[43,1,"かみ"],[45,1,"しゅ"],[47,1,"かえ"],[53,1,"しゅ"],[55,1,"もと"]],"text":"イスラエルの誇は自らに向かって証言している、彼らはこのもろもろの事があっても、なおその神、主に帰らず、また主を求めない。"},{"ref":"Hos.7.11","start":28007011,"end":28007011,"break":"stanza","breaks":[[22,"line"],[39,"line"]],"ruby":[[6,2,"ちえ"],[11,1,"おろ"],[22,1,"かれ"],[30,1,"む"],[34,1,"よ"],[36,1,"もと"],[47,1,"い"]],"text":"エフライムは知恵のない愚かな、はとのようだ。彼らはエジプトに向かって呼び求め、またアッスリヤへ行く。"},{"ref":"Hos.7.12","start":28007012,"end":28007012,"break":"line","breaks":[[23,"line"],[35,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[12,1,"かれ"],[15,1,"うえ"],[17,1,"あみ"],[19,1,"は"],[23,1,"そら"],[25,1,"とり"],[30,1,"ひ"],[32,1,"おと"],[37,1,"あ"],[49,1,"かれ"],[52,1,"こ"]],"text":"彼らが行くとき、わたしは彼らの上に網を張って、空の鳥のように引き落し、その悪しきおこないのゆえに、彼らを懲らしめる。"},{"ref":"Hos.7.13","start":28007013,"end":28007013,"break":"line","breaks":[[24,"line"],[33,"line"],[53,"line"],[70,"line"]],"ruby":[[9,1,"かれ"],[16,1,"はな"],[19,1,"まよ"],[21,1,"で"],[24,1,"ほろ"],[27,1,"かれ"],[30,1,"のぞ"],[33,1,"かれ"],[40,1,"む"],[44,1,"つみ"],[46,1,"おか"],[57,1,"かれ"],[66,1,"おも"],[70,1,"かれ"],[77,1,"さか"],[81,1,"いつわ"],[84,1,"い"]],"text":"わざわいなるかな、彼らはわたしを離れて迷い出た。滅びは彼らに臨む。彼らがわたしに向かって罪を犯したからだ。わたしは彼らをあがなおうと思うが、彼らはわたしに逆らって偽りを言う。"},{"ref":"Hos.7.14","start":28007014,"end":28007014,"break":"stanza","breaks":[[17,"line"],[29,"line"],[46,"line"]],"ruby":[[0,1,"かれ"],[3,2,"まごころ"],[13,1,"よ"],[19,1,"ゆか"],[21,1,"うえ"],[23,1,"かな"],[26,1,"さけ"],[29,1,"かれ"],[32,2,"こくもつ"],[35,1,"さけ"],[41,1,"あつ"],[50,1,"さか"]],"text":"彼らは真心をもってわたしを呼ばず、ただ床の上で悲しみ叫ぶ。彼らは穀物と酒のためには集まるが、わたしに逆らう。"},{"ref":"Hos.7.15","start":28007015,"end":28007015,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"かれ"],[7,1,"おし"],[12,1,"うで"],[14,1,"つよ"],[20,1,"かれ"],[27,1,"さか"],[32,1,"あ"],[35,1,"こと"]],"text":"わたしは彼らを教え、その腕を強くしたが、彼らはわたしに逆らって、悪しき事をはかる。"},{"ref":"Hos.7.16","start":28007016,"end":28007016,"break":"line","breaks":[[10,"line"],[23,"line"],[42,"line"],[50,"line"]],"ruby":[[0,1,"かれ"],[7,1,"かえ"],[10,1,"かれ"],[17,1,"ゆみ"],[23,1,"かれ"],[26,1,"きみ"],[32,1,"した"],[34,1,"たか"],[46,1,"たお"],[58,1,"くに"],[60,2,"ひとびと"]],"text":"彼らはバアルに帰る。彼らはあざむく弓のようだ。彼らの君たちはその舌の高ぶりのために、つるぎに倒れる。これはエジプトの国で人々のあざけりとなる。"}]