[{"ref":"Rev.18.1","start":66018001,"end":66018001,"break":"paragraph","ruby":[[2,1,"のち"],[15,2,"みつかい"],[19,1,"おお"],[23,2,"けんい"],[26,1,"も"],[30,1,"てん"],[33,1,"お"],[36,1,"く"],[40,1,"み"],[43,1,"ち"],[45,1,"かれ"],[47,2,"えいこう"],[53,1,"あか"]],"text":"この後、わたしは、もうひとりの御使が、大いなる権威を持って、天から降りて来るのを見た。地は彼の栄光によって明るくされた。"},{"ref":"Rev.18.2","start":66018002,"end":66018002,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ちからづよ"],[5,1,"こえ"],[7,1,"さけ"],[10,1,"い"],[15,1,"たお"],[19,1,"おお"],[28,1,"たお"],[39,2,"あくま"],[42,1,"す"],[44,1,"ところ"],[50,1,"けが"],[53,1,"れい"],[55,1,"そう"],[66,1,"けが"],[69,1,"にく"],[73,1,"とり"],[75,1,"そう"]],"text":"彼は力強い声で叫んで言った、「倒れた、大いなるバビロンは倒れた。そして、それは悪魔の住む所、あらゆる汚れた霊の巣くつ、また、あらゆる汚れた憎むべき鳥の巣くつとなった。"},{"ref":"Rev.18.3","start":66018003,"end":66018003,"break":"none","ruby":[[4,2,"こくみん"],[8,2,"かのじょ"],[11,2,"かんいん"],[14,1,"たい"],[17,1,"はげ"],[20,1,"いか"],[26,1,"しゅ"],[28,1,"の"],[31,1,"ち"],[33,1,"おう"],[37,2,"かのじょ"],[40,2,"かんいん"],[43,1,"おこな"],[46,2,"ちじょう"],[49,2,"しょうにん"],[55,2,"かのじょ"],[58,2,"きょくど"],[69,1,"とみ"],[71,1,"え"]],"text":"すべての国民は、彼女の姦淫に対する激しい怒りのぶどう酒を飲み、地の王たちは彼女と姦淫を行い、地上の商人たちは、彼女の極度のぜいたくによって富を得たからである」。"},{"ref":"Rev.18.4","start":66018004,"end":66018004,"break":"paragraph","ruby":[[13,1,"こえ"],[15,1,"てん"],[18,1,"で"],[22,1,"き"],[31,1,"たみ"],[34,2,"かのじょ"],[38,1,"はな"],[40,1,"さ"],[46,1,"つみ"],[61,2,"さいがい"],[64,1,"ま"],[66,1,"こ"]],"text":"わたしはまた、もうひとつの声が天から出るのを聞いた、「わたしの民よ。彼女から離れ去って、その罪にあずからないようにし、その災害に巻き込まれないようにせよ。"},{"ref":"Rev.18.5","start":66018005,"end":66018005,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"つみ"],[5,1,"つも"],[7,1,"つ"],[10,1,"てん"],[12,1,"たっ"],[18,1,"かみ"],[22,2,"ふぎ"],[25,1,"おこな"],[28,1,"おぼ"]],"text":"彼女の罪は積り積って天に達しており、神はその不義の行いを覚えておられる。"},{"ref":"Rev.18.6","start":66018006,"end":66018006,"break":"none","ruby":[[0,2,"かのじょ"],[9,2,"かのじょ"],[13,1,"かえ"],[22,1,"おう"],[26,1,"ばい"],[28,2,"ほうふく"],[33,2,"かのじょ"],[36,1,"ま"],[39,1,"い"],[42,1,"さかずき"],[44,1,"なか"],[49,1,"ばい"],[51,1,"りょう"],[54,1,"い"]],"text":"彼女がしたとおりに彼女にし返し、そのしわざに応じて二倍に報復をし、彼女が混ぜて入れた杯の中に、その倍の量を、入れてやれ。"},{"ref":"Rev.18.7","start":66018007,"end":66018007,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"みずか"],[5,1,"たか"],[28,1,"たい"],[32,1,"おな"],[37,1,"くる"],[41,1,"かな"],[46,1,"あじ"],[54,2,"かのじょ"],[57,1,"こころ"],[59,1,"なか"],[66,2,"じょおう"],[69,1,"くらい"],[76,1,"もの"],[94,1,"かな"],[98,1,"し"],[104,1,"い"]],"text":"彼女が自ら高ぶり、ぜいたくをほしいままにしたので、それに対して、同じほどの苦しみと悲しみとを味わわせてやれ。彼女は心の中で『わたしは女王の位についている者であって、やもめではないのだから、悲しみを知らない』と言っている。"},{"ref":"Rev.18.8","start":66018008,"end":66018008,"break":"none","ruby":[[10,2,"さいがい"],[14,1,"し"],[16,1,"かな"],[27,1,"にち"],[32,2,"かのじょ"],[35,1,"おそ"],[42,2,"かのじょ"],[45,1,"ひ"],[47,1,"や"],[55,2,"かのじょ"],[61,1,"しゅ"],[64,1,"かみ"],[67,2,"ちからづよ"]],"text":"それゆえ、さまざまの災害が、死と悲しみとききんとが、一日のうちに彼女を襲い、そして、彼女は火で焼かれてしまう。彼女をさばく主なる神は、力強いかたなのである。"},{"ref":"Rev.18.9","start":66018009,"end":66018009,"break":"none","ruby":[[0,2,"かのじょ"],[3,2,"かんいん"],[6,1,"おこな"],[24,1,"ち"],[26,1,"おう"],[31,2,"かのじょ"],[34,1,"や"],[38,1,"ひ"],[40,1,"けむり"],[42,1,"み"],[45,2,"かのじょ"],[51,1,"むね"],[53,1,"う"],[56,1,"な"],[58,1,"かな"]],"text":"彼女と姦淫を行い、ぜいたくをほしいままにしていた地の王たちは、彼女が焼かれる火の煙を見て、彼女のために胸を打って泣き悲しみ、"},{"ref":"Rev.18.10","start":66018010,"end":66018010,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"くる"],[7,1,"おそ"],[14,1,"とお"],[17,1,"た"],[20,1,"い"],[37,1,"おお"],[41,1,"みやこ"],[43,1,"ふ"],[44,1,"お"],[46,1,"みやこ"],[64,1,"たい"],[72,2,"いっしゅん"]],"text":"彼女の苦しみに恐れをいだき、遠くに立って言うであろう、『ああ、わざわいだ、大いなる都、不落の都、バビロンは、わざわいだ。おまえに対するさばきは、一瞬にしてきた』。"},{"ref":"Rev.18.11","start":66018011,"end":66018011,"break":"none","ruby":[[3,1,"ち"],[5,2,"しょうにん"],[10,2,"かのじょ"],[16,1,"な"],[18,1,"かな"],[26,1,"かれ"],[29,2,"しょうひん"],[32,1,"か"],[34,1,"もの"]],"text":"また、地の商人たちも彼女のために泣き悲しむ。もはや、彼らの商品を買う者が、ひとりもないからである。"},{"ref":"Rev.18.12","start":66018012,"end":66018012,"break":"none","ruby":[[2,2,"しょうひん"],[6,1,"きん"],[8,1,"ぎん"],[10,2,"ほうせき"],[13,2,"しんじゅ"],[16,2,"あさぬの"],[19,1,"むらさき"],[20,1,"ぬの"],[22,1,"きぬ"],[24,1,"ひ"],[25,1,"ぬの"],[27,2,"かくしゅ"],[30,2,"こうぼく"],[33,2,"かくしゅ"],[36,2,"ぞうげ"],[38,2,"ざいく"],[41,2,"こうか"],[44,2,"もくざい"],[47,1,"どう"],[49,1,"てつ"],[51,3,"だいりせき"],[57,1,"うつわ"]],"text":"その商品は、金、銀、宝石、真珠、麻布、紫布、絹、緋布、各種の香木、各種の象牙細工、高価な木材、銅、鉄、大理石などの器、"},{"ref":"Rev.18.13","start":66018013,"end":66018013,"break":"none","ruby":[[0,2,"にっけい"],[3,2,"こうりょう"],[6,1,"こう"],[11,1,"あぶら"],[13,2,"にゅうこう"],[19,1,"しゅ"],[24,1,"ゆ"],[26,2,"むぎこ"],[29,1,"むぎ"],[31,1,"うし"],[33,1,"ひつじ"],[35,1,"うま"],[37,1,"くるま"],[39,2,"どれい"],[45,2,"じんしん"]],"text":"肉桂、香料、香、におい油、乳香、ぶどう酒、オリブ油、麦粉、麦、牛、羊、馬、車、奴隷、そして人身などである。"},{"ref":"Rev.18.14","start":66018014,"end":66018014,"break":"none","ruby":[[4,1,"こころ"],[6,1,"よろこ"],[35,1,"もの"],[42,1,"き"],[44,1,"さ"],[58,1,"み"]],"text":"おまえの心の喜びであったくだものはなくなり、あらゆるはでな、はなやかな物はおまえから消え去った。それらのものはもはや見られない。"},{"ref":"Rev.18.15","start":66018015,"end":66018015,"break":"none","ruby":[[4,2,"しなじな"],[7,1,"う"],[11,2,"かのじょ"],[15,1,"とみ"],[17,1,"え"],[19,2,"しょうにん"],[23,2,"かのじょ"],[26,1,"くる"],[30,1,"おそ"],[37,1,"とお"],[40,1,"た"],[43,1,"な"],[45,1,"かな"],[49,1,"い"]],"text":"これらの品々を売って、彼女から富を得た商人は、彼女の苦しみに恐れをいだいて遠くに立ち、泣き悲しんで言う、"},{"ref":"Rev.18.16","start":66018016,"end":66018016,"break":"none","ruby":[[10,2,"あさぬの"],[13,1,"むらさき"],[14,1,"ぬの"],[16,1,"ひ"],[17,1,"ぬの"],[23,1,"きん"],[25,2,"ほうせき"],[28,2,"しんじゅ"],[31,1,"み"],[33,1,"かざ"],[38,1,"おお"],[42,1,"みやこ"]],"text":"『ああ、わざわいだ、麻布と紫布と緋布をまとい、金や宝石や真珠で身を飾っていた大いなる都は、わざわいだ。"},{"ref":"Rev.18.17","start":66018017,"end":66018017,"break":"none","ruby":[[5,1,"とみ"],[8,2,"いっしゅん"],[13,1,"む"],[15,1,"き"],[32,2,"せんちょう"],[35,3,"こうかいしゃ"],[39,2,"すいふ"],[45,1,"うみ"],[47,1,"はたら"],[52,1,"ひと"],[57,1,"とお"],[60,1,"た"]],"text":"これほどの富が、一瞬にして無に帰してしまうとは』。また、すべての船長、航海者、水夫、すべて海で働いている人たちは、遠くに立ち、"},{"ref":"Rev.18.18","start":66018018,"end":66018018,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"や"],[7,1,"ひ"],[9,1,"けむり"],[11,1,"み"],[14,1,"さけ"],[17,1,"い"],[26,1,"おお"],[30,1,"みやこ"]],"text":"彼女が焼かれる火の煙を見て、叫んで言う、『これほどの大いなる都は、どこにあろう』。"},{"ref":"Rev.18.19","start":66018019,"end":66018019,"break":"none","ruby":[[0,1,"かれ"],[3,1,"あたま"],[12,1,"な"],[14,1,"かな"],[18,1,"さけ"],[33,1,"おお"],[37,1,"みやこ"],[56,1,"うみ"],[58,1,"ふね"],[60,1,"も"],[66,1,"ひと"],[68,1,"とみ"],[70,1,"え"],[79,1,"みやこ"],[81,2,"いっしゅん"],[86,1,"む"],[88,1,"き"]],"text":"彼らは頭にちりをかぶり、泣き悲しんで叫ぶ、『ああ、わざわいだ、この大いなる都は、わざわいだ。そのおごりによって、海に舟を持つすべての人が富を得ていたのに、この都も一瞬にして無に帰してしまった』。"},{"ref":"Rev.18.20","start":66018020,"end":66018020,"break":"none","ruby":[[0,1,"てん"],[3,2,"せいと"],[9,2,"しと"],[15,3,"よげんしゃ"],[24,1,"みやこ"],[29,1,"おお"],[32,1,"よろこ"],[35,1,"かみ"],[50,1,"みやこ"]],"text":"天よ、聖徒たちよ、使徒たちよ、預言者たちよ。この都について大いに喜べ。神は、あなたがたのために、この都をさばかれたのである」。"},{"ref":"Rev.18.21","start":66018021,"end":66018021,"break":"paragraph","ruby":[[8,2,"ちからづよ"],[11,2,"みつかい"],[15,1,"おお"],[26,1,"いし"],[28,1,"も"],[36,1,"うみ"],[38,1,"な"],[40,1,"こ"],[43,1,"い"],[48,1,"おお"],[52,1,"みやこ"],[64,1,"はげ"],[67,1,"う"],[69,1,"たお"],[77,1,"まった"],[79,1,"すがた"],[81,1,"け"]],"text":"すると、ひとりの力強い御使が、大きなひきうすのような石を持ちあげ、それを海に投げ込んで言った、「大いなる都バビロンは、このように激しく打ち倒され、そして、全く姿を消してしまう。"},{"ref":"Rev.18.22","start":66018022,"end":66018022,"break":"none","ruby":[[7,1,"なか"],[11,2,"たてごと"],[16,1,"もの"],[18,1,"うた"],[20,1,"うた"],[22,1,"もの"],[24,1,"ふえ"],[26,1,"ふ"],[28,1,"もの"],[34,1,"ふ"],[36,1,"な"],[39,1,"もの"],[41,1,"がく"],[43,1,"ね"],[45,1,"まった"],[47,1,"き"],[56,2,"しごと"],[59,2,"しょくにん"],[64,1,"まった"],[66,1,"すがた"],[68,1,"け"],[79,1,"おと"],[82,1,"まった"],[84,1,"き"]],"text":"また、おまえの中では、立琴をひく者、歌を歌う者、笛を吹く者、ラッパを吹き鳴らす者の楽の音は全く聞かれず、あらゆる仕事の職人たちも全く姿を消し、また、ひきうすの音も、全く聞かれない。"},{"ref":"Rev.18.23","start":66018023,"end":66018023,"break":"none","ruby":[[7,1,"なか"],[21,2,"はなむこ"],[24,2,"はなよめ"],[27,1,"こえ"],[29,1,"き"],[45,2,"しょうにん"],[50,2,"ちじょう"],[53,2,"せいりょく"],[56,1,"は"],[58,1,"もの"],[67,2,"こくみん"]],"text":"また、おまえの中では、あかりもともされず、花婿、花嫁の声も聞かれない。というのは、おまえの商人たちは地上で勢力を張る者となり、すべての国民はおまえのまじないでだまされ、"},{"ref":"Rev.18.24","start":66018024,"end":66018024,"break":"none","ruby":[[3,3,"よげんしゃ"],[7,2,"せいと"],[10,1,"ち"],[16,2,"ちじょう"],[19,1,"ころ"],[27,1,"もの"],[29,1,"ち"],[34,1,"みやこ"],[36,1,"なが"]],"text":"また、預言者や聖徒の血、さらに、地上で殺されたすべての者の血が、この都で流されたからである」。"}]