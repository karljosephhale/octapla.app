[{"ref":"Esth.4.1","start":17004001,"end":17004001,"break":"paragraph","ruby":[[18,1,"し"],[26,1,"ころも"],[28,1,"さ"],[31,2,"あらぬの"],[38,1,"はい"],[44,1,"まち"],[46,1,"なか"],[48,1,"い"],[51,2,"おおごえ"],[57,1,"はげ"],[60,1,"さけ"]],"text":"モルデカイはすべてこのなされたことを知ったとき、その衣を裂き、荒布をまとい、灰をかぶり、町の中へ行って大声をあげ、激しく叫んで、"},{"ref":"Esth.4.2","start":17004002,"end":17004002,"break":"none","ruby":[[0,1,"おう"],[2,1,"もん"],[4,2,"いりぐち"],[8,1,"い"],[12,2,"あらぬの"],[20,1,"おう"],[22,1,"もん"],[24,1,"うち"]],"text":"王の門の入口まで行った。荒布をまとっては王の門の内にはいることができないからである。"},{"ref":"Esth.4.3","start":17004003,"end":17004003,"break":"none","ruby":[[3,1,"おう"],[5,2,"めいれい"],[8,1,"みことのり"],[12,1,"と"],[15,2,"かくしゅう"],[22,1,"ひと"],[27,1,"おお"],[31,1,"かな"],[38,2,"だんじき"],[41,1,"なげ"],[44,1,"さけ"],[47,1,"おこ"],[52,2,"あらぬの"],[59,1,"はい"],[61,1,"うえ"],[63,1,"ざ"],[66,1,"もの"],[68,1,"おお"]],"text":"すべて王の命令と詔をうけ取った各州ではユダヤ人のうちに大いなる悲しみがあり、断食、嘆き、叫びが起り、また荒布をまとい、灰の上に座する者が多かった。"},{"ref":"Esth.4.4","start":17004004,"end":17004004,"break":"paragraph","ruby":[[5,2,"じじょ"],[12,2,"じじゅう"],[22,1,"こと"],[24,1,"つ"],[30,2,"おうひ"],[33,2,"ひじょう"],[36,1,"かな"],[46,2,"きもの"],[49,1,"おく"],[55,1,"き"],[59,2,"あらぬの"],[62,1,"ぬ"],[71,1,"う"]],"text":"エステルの侍女たちおよび侍従たちがきて、この事を告げたので、王妃は非常に悲しみ、モルデカイに着物を贈り、それを着せて、荒布を脱がせようとしたが受けなかった。"},{"ref":"Esth.4.5","start":17004005,"end":17004005,"break":"none","ruby":[[8,1,"おう"],[10,2,"じじゅう"],[18,1,"おう"],[20,2,"じぶん"],[32,1,"め"],[44,1,"い"],[51,2,"なにごと"],[58,1,"なに"],[66,1,"たず"],[69,1,"く"],[75,1,"めい"]],"text":"そこでエステルは王の侍従のひとりで、王が自分にはべらせたハタクを召し、モルデカイのもとへ行って、それは何事であるか、何ゆえであるかを尋ねて来るようにと命じた。"},{"ref":"Esth.4.6","start":17004006,"end":17004006,"break":"none","ruby":[[4,1,"で"],[7,1,"おう"],[9,1,"もん"],[11,1,"まえ"],[15,1,"まち"],[17,2,"ひろば"],[31,1,"い"]],"text":"ハタクは出て、王の門の前にある町の広場にいるモルデカイのもとへ行くと、"},{"ref":"Esth.4.7","start":17004007,"end":17004007,"break":"none","ruby":[[6,2,"じぶん"],[9,1,"み"],[11,1,"おこ"],[18,1,"こと"],[20,1,"かれ"],[22,1,"つ"],[34,1,"ひと"],[36,1,"ほろ"],[45,1,"おう"],[47,2,"きんこ"],[50,1,"はか"],[52,1,"い"],[56,2,"やくそく"],[60,1,"ぎん"],[62,2,"せいかく"],[65,1,"がく"],[67,1,"つ"]],"text":"モルデカイは自分の身に起ったすべての事を彼に告げ、かつハマンがユダヤ人を滅ぼすことのために王の金庫に量り入れると約束した銀の正確な額を告げた。"},{"ref":"Esth.4.8","start":17004008,"end":17004008,"break":"none","ruby":[[2,1,"かれ"],[5,1,"ほろ"],[17,2,"はっぷ"],[22,2,"しょうしょ"],[25,1,"うつ"],[28,1,"かれ"],[42,1,"み"],[47,1,"と"],[53,2,"かのじょ"],[56,1,"おう"],[61,1,"い"],[66,1,"たみ"],[71,1,"おう"],[78,1,"こ"],[81,1,"おう"],[83,1,"まえ"],[85,1,"ねが"],[87,1,"もと"],[93,2,"かのじょ"],[96,1,"い"],[98,1,"つた"],[102,1,"い"]],"text":"また彼らを滅ぼさせるために、スサで発布された詔書の写しを彼にわたし、それをエステルに見せ、かつ説きあかし、彼女が王のもとへ行ってその民のために王のあわれみを請い、王の前に願い求めるように彼女に言い伝えよと言った。"},{"ref":"Esth.4.9","start":17004009,"end":17004009,"break":"none","ruby":[[4,1,"かえ"],[15,2,"ことば"],[23,1,"つ"]],"text":"ハタクが帰ってきてモルデカイの言葉をエステルに告げたので、"},{"ref":"Esth.4.10","start":17004010,"end":17004010,"break":"none","ruby":[[9,1,"めい"],[18,2,"ことば"],[21,1,"つた"],[26,1,"い"]],"text":"エステルはハタクに命じ、モルデカイに言葉を伝えさせて言った、"},{"ref":"Esth.4.11","start":17004011,"end":17004011,"break":"none","ruby":[[1,1,"おう"],[3,2,"じしん"],[8,1,"おう"],[10,1,"しょ"],[11,1,"しゅう"],[13,1,"たみ"],[15,1,"みな"],[17,1,"おとこ"],[20,1,"おんな"],[27,1,"め"],[34,2,"うちにわ"],[41,1,"おう"],[46,1,"ゆ"],[48,1,"もの"],[51,1,"かなら"],[53,1,"ころ"],[70,2,"ほうりつ"],[78,1,"し"],[88,1,"おう"],[92,1,"もの"],[94,1,"きん"],[96,1,"しゃく"],[98,1,"の"],[102,1,"い"],[126,1,"にち"],[128,1,"あいだ"],[130,1,"おう"],[135,1,"い"],[139,1,"めし"]],"text":"「王の侍臣および王の諸州の民は皆、男でも女でも、すべて召されないのに内庭にはいって王のもとへ行く者は、必ず殺されなければならないという一つの法律のあることを知っています。ただし王がその者に金の笏を伸べれば生きることができるのです。しかしわたしはこの三十日の間、王のもとへ行くべき召をこうむらないのです」。"},{"ref":"Esth.4.12","start":17004012,"end":17004012,"break":"none","ruby":[[5,2,"ことば"],[14,1,"つ"]],"text":"エステルの言葉をモルデカイに告げたので、"},{"ref":"Esth.4.13","start":17004013,"end":17004013,"break":"none","ruby":[[6,1,"めい"],[14,1,"こた"],[19,1,"い"],[28,2,"おうきゅう"],[43,1,"ひと"],[45,1,"こと"],[49,1,"なん"],[51,1,"まぬか"],[58,1,"おも"]],"text":"モルデカイは命じてエステルに答えさせて言った、「あなたは王宮にいるゆえ、すべてのユダヤ人と異なり、難を免れるだろうと思ってはならない。"},{"ref":"Esth.4.14","start":17004014,"end":17004014,"break":"none","ruby":[[12,1,"とき"],[14,1,"だま"],[26,1,"ところ"],[30,1,"たす"],[33,1,"すくい"],[38,1,"ひと"],[43,1,"おこ"],[62,1,"ちち"],[64,1,"いえ"],[67,1,"ほろ"],[81,1,"くに"],[83,1,"むか"],[96,1,"とき"],[109,1,"し"]],"text":"あなたがもし、このような時に黙っているならば、ほかの所から、助けと救がユダヤ人のために起るでしょう。しかし、あなたとあなたの父の家とは滅びるでしょう。あなたがこの国に迎えられたのは、このような時のためでなかったとだれが知りましょう」。"},{"ref":"Esth.4.15","start":17004015,"end":17004015,"break":"none","ruby":[[8,1,"めい"],[17,1,"こた"]],"text":"そこでエステルは命じてモルデカイに答えさせた、"},{"ref":"Esth.4.16","start":17004016,"end":17004016,"break":"none","ruby":[[5,1,"い"],[20,1,"ひと"],[22,1,"あつ"],[32,2,"だんじき"],[42,1,"か"],[47,1,"よる"],[49,1,"ひる"],[51,1,"く"],[53,1,"の"],[72,2,"じじょ"],[77,2,"どうよう"],[80,2,"だんじき"],[95,2,"ほうりつ"],[106,1,"おう"],[111,1,"い"],[122,1,"し"],[134,1,"し"]],"text":"「あなたは行ってスサにいるすべてのユダヤ人を集め、わたしのために断食してください。三日のあいだ夜も昼も食い飲みしてはなりません。わたしとわたしの侍女たちも同様に断食しましょう。そしてわたしは法律にそむくことですが王のもとへ行きます。わたしがもし死なねばならないのなら、死にます」。"},{"ref":"Esth.4.17","start":17004017,"end":17004017,"break":"none","ruby":[[6,1,"い"],[18,2,"じぶん"],[21,1,"めい"],[28,1,"おこな"]],"text":"モルデカイは行って、エステルがすべて自分に命じたとおりに行った。"}]