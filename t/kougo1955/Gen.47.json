[{"ref":"Gen.47.1","start":1047001,"end":1047001,"break":"paragraph","ruby":[[4,1,"い"],[11,1,"い"],[20,1,"ちち"],[22,2,"きょうだい"],[29,1,"ひつじ"],[31,1,"うし"],[39,1,"も"],[41,1,"もの"],[47,1,"ち"],[53,1,"いま"],[58,1,"ち"]],"text":"ヨセフは行って、パロに言った、「わたしの父と兄弟たち、その羊、牛およびすべての持ち物がカナンの地からきて、今ゴセンの地におります」。"},{"ref":"Gen.47.2","start":1047002,"end":1047002,"break":"none","ruby":[[5,2,"きょうだい"],[12,1,"にん"],[14,1,"つ"],[17,1,"い"],[24,1,"あ"]],"text":"そしてその兄弟のうちの五人を連れて行って、パロに会わせた。"},{"ref":"Gen.47.3","start":1047003,"end":1047003,"break":"none","ruby":[[7,2,"きょうだい"],[12,1,"い"],[23,2,"しょくぎょう"],[26,1,"なに"],[30,1,"かれ"],[36,1,"い"],[46,1,"ひつじ"],[48,1,"か"],[50,1,"もの"],[65,2,"せんぞ"]],"text":"パロはヨセフの兄弟たちに言った、「あなたがたの職業は何か」。彼らはパロに言った、「しもべらは羊を飼う者です。われわれも、われわれの先祖もそうです」。"},{"ref":"Gen.47.4","start":1047004,"end":1047004,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[15,1,"くに"],[17,2,"きりゅう"],[34,1,"ち"],[40,1,"はげ"],[49,1,"む"],[55,2,"ぼくそう"],[76,1,"ち"],[78,1,"す"]],"text":"彼らはまたパロに言った、「この国に寄留しようとしてきました。カナンの地はききんが激しく、しもべらの群れのための牧草がないのです。どうかしもべらをゴセンの地に住ませてください」。"},{"ref":"Gen.47.5","start":1047005,"end":1047005,"break":"none","ruby":[[7,1,"い"],[16,1,"ちち"],[18,2,"きょうだい"]],"text":"パロはヨセフに言った、「あなたの父と兄弟たちとがあなたのところにきた。"},{"ref":"Gen.47.6","start":1047006,"end":1047006,"break":"none","ruby":[[5,1,"ち"],[11,1,"まえ"],[16,1,"ち"],[18,1,"もっと"],[20,1,"よ"],[22,1,"ところ"],[28,1,"ちち"],[30,2,"きょうだい"],[36,1,"す"],[47,1,"ち"],[49,1,"かれ"],[52,1,"す"],[65,1,"かれ"],[71,2,"ゆうのう"],[74,1,"もの"],[80,1,"し"],[90,1,"もの"],[96,2,"かちく"]],"text":"エジプトの地はあなたの前にある。地の最も良い所にあなたの父と兄弟たちとを住ませなさい。ゴセンの地に彼らを住ませなさい。もしあなたが彼らのうちに有能な者があるのを知っているなら、その者にわたしの家畜をつかさどらせなさい」。"},{"ref":"Gen.47.7","start":1047007,"end":1047007,"break":"paragraph","ruby":[[7,1,"ちち"],[12,1,"みちび"],[18,1,"まえ"],[20,1,"た"],[32,2,"しゅくふく"]],"text":"そこでヨセフは父ヤコブを導いてパロの前に立たせた。ヤコブはパロを祝福した。"},{"ref":"Gen.47.8","start":1047008,"end":1047008,"break":"none","ruby":[[7,1,"い"],[16,1,"とし"]],"text":"パロはヤコブに言った、「あなたの年はいくつか」。"},{"ref":"Gen.47.9","start":1047009,"end":1047009,"break":"none","ruby":[[7,1,"い"],[16,2,"たびじ"],[28,1,"ねん"],[40,1,"ひ"],[58,2,"せんぞ"],[67,1,"ひ"],[69,2,"たびじ"],[72,1,"ひ"],[75,1,"およ"]],"text":"ヤコブはパロに言った、「わたしの旅路のとしつきは、百三十年です。わたしのよわいの日はわずかで、ふしあわせで、わたしの先祖たちのよわいの日と旅路の日には及びません」。"},{"ref":"Gen.47.10","start":1047010,"end":1047010,"break":"none","ruby":[[7,2,"しゅくふく"],[14,1,"まえ"],[16,1,"さ"]],"text":"ヤコブはパロを祝福し、パロの前を去った。"},{"ref":"Gen.47.11","start":1047011,"end":1047011,"break":"none","ruby":[[7,1,"めい"],[14,1,"ちち"],[16,2,"きょうだい"],[26,1,"さだ"],[29,1,"かれ"],[37,1,"くに"],[39,1,"もっと"],[41,1,"よ"],[43,1,"ち"],[50,1,"ち"],[52,2,"しょゆう"],[57,1,"あた"]],"text":"ヨセフはパロの命じたように、父と兄弟たちとのすまいを定め、彼らにエジプトの国で最も良い地、ラメセスの地を所有として与えた。"},{"ref":"Gen.47.12","start":1047012,"end":1047012,"break":"none","ruby":[[6,1,"ちち"],[8,2,"きょうだい"],[13,1,"ちち"],[15,2,"ぜんか"],[20,2,"かぞく"],[23,1,"かず"],[30,2,"しょくもつ"],[33,1,"あた"],[36,1,"やしな"]],"text":"またヨセフは父と兄弟たちと父の全家とに、家族の数にしたがい、食物を与えて養った。"},{"ref":"Gen.47.13","start":1047013,"end":1047013,"break":"paragraph","ruby":[[7,2,"ひじょう"],[10,1,"はげ"],[18,1,"ぜん"],[19,1,"ち"],[21,2,"しょくもつ"],[32,1,"くに"],[38,1,"くに"],[48,1,"おとろ"]],"text":"さて、ききんが非常に激しかったので、全地に食物がなく、エジプトの国もカナンの国も、ききんのために衰えた。"},{"ref":"Gen.47.14","start":1047014,"end":1047014,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"か"],[13,2,"こくもつ"],[16,2,"だいきん"],[26,1,"くに"],[32,1,"くに"],[37,1,"ぎん"],[41,1,"あつ"],[46,1,"ぎん"],[51,1,"いえ"],[53,1,"おさ"]],"text":"それでヨセフは人々が買った穀物の代金としてエジプトの国とカナンの国にあった銀をみな集め、その銀をパロの家に納めた。"},{"ref":"Gen.47.15","start":1047015,"end":1047015,"break":"none","ruby":[[9,1,"くに"],[15,1,"くに"],[17,1,"ぎん"],[19,1,"つ"],[43,1,"い"],[48,2,"しょくもつ"],[56,1,"ぎん"],[58,1,"つ"],[74,1,"まえ"],[76,1,"し"]],"text":"こうしてエジプトの国とカナンの国に銀が尽きたとき、エジプトびとはみなヨセフのもとにきて言った、「食物をください。銀が尽きたからとて、どうしてあなたの前で死んでよいでしょう」。"},{"ref":"Gen.47.16","start":1047016,"end":1047016,"break":"none","ruby":[[4,1,"い"],[15,2,"かちく"],[18,1,"だ"],[24,1,"ぎん"],[26,1,"つ"],[39,2,"かちく"],[42,1,"ひ"],[44,1,"か"],[47,2,"しょくもつ"]],"text":"ヨセフは言った、「あなたがたの家畜を出しなさい。銀が尽きたのなら、あなたがたの家畜と引き替えで食物をわたそう」。"},{"ref":"Gen.47.17","start":1047017,"end":1047017,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ところ"],[9,2,"かちく"],[24,1,"うま"],[26,1,"ひつじ"],[28,1,"む"],[31,1,"うし"],[33,1,"む"],[35,1,"およ"],[40,1,"ひ"],[42,1,"か"],[46,2,"しょくもつ"],[49,1,"かれ"],[61,1,"かれ"],[65,1,"とし"],[71,2,"かちく"],[74,1,"ひ"],[76,1,"か"],[79,2,"しょくもつ"],[82,1,"かれ"],[85,1,"やしな"]],"text":"彼らはヨセフの所へ家畜をひいてきたので、ヨセフは馬と羊の群れと牛の群れ及びろばと引き替えで、食物を彼らにわたした。こうして彼はその年、すべての家畜と引き替えた食物で彼らを養った。"},{"ref":"Gen.47.18","start":1047018,"end":1047018,"break":"none","ruby":[[5,1,"とし"],[7,1,"く"],[10,1,"つぎ"],[12,1,"とし"],[14,2,"ひとびと"],[23,1,"ところ"],[27,1,"い"],[34,1,"しゅ"],[37,2,"なにごと"],[40,1,"かく"],[51,1,"ぎん"],[53,1,"つ"],[56,1,"けもの"],[58,1,"む"],[63,1,"しゅ"],[81,2,"でんち"],[89,1,"しゅ"],[91,1,"まえ"],[93,1,"なに"],[95,1,"のこ"]],"text":"やがてその年は暮れ、次の年、人々はまたヨセフの所へきて言った、「わが主には何事も隠しません。われわれの銀は尽き、獣の群れもわが主のものになって、われわれのからだと田地のほかはわが主の前に何も残っていません。"},{"ref":"Gen.47.19","start":1047019,"end":1047019,"break":"none","ruby":[[9,2,"でんち"],[12,2,"いっしょ"],[20,1,"め"],[22,1,"まえ"],[24,1,"ほろ"],[39,2,"でんち"],[43,2,"しょくもつ"],[46,1,"ひ"],[48,1,"か"],[51,1,"か"],[64,2,"でんち"],[67,2,"いっしょ"],[73,2,"どれい"],[85,1,"たね"],[102,1,"い"],[109,1,"し"],[111,1,"まぬか"],[115,2,"でんち"],[118,1,"あ"]],"text":"われわれはどうして田地と一緒に、あなたの目の前で滅んでよいでしょう。われわれと田地とを食物と引き替えで買ってください。われわれは田地と一緒にパロの奴隷となりましょう。また種をください。そうすればわれわれは生きながらえ、死を免れて、田地も荒れないでしょう」。"},{"ref":"Gen.47.20","start":1047020,"end":1047020,"break":"paragraph","ruby":[[12,2,"でんち"],[23,1,"か"],[25,1,"と"],[56,2,"たはた"],[59,1,"う"],[72,1,"ち"]],"text":"そこでヨセフはエジプトの田地をみなパロのために買い取った。ききんがエジプトびとに、きびしかったので、めいめいその田畑を売ったからである。こうして地はパロのものとなった。"},{"ref":"Gen.47.21","start":1047021,"end":1047021,"break":"none","ruby":[[12,2,"こっきょう"],[17,1,"はし"],[22,1,"はし"],[25,1,"たみ"],[27,2,"どれい"]],"text":"そしてヨセフはエジプトの国境のこの端からかの端まで民を奴隷とした。"},{"ref":"Gen.47.22","start":1047022,"end":1047022,"break":"none","ruby":[[2,2,"さいし"],[5,2,"でんち"],[8,1,"か"],[10,1,"と"],[17,2,"さいし"],[24,2,"きゅうよ"],[34,1,"あた"],[37,2,"きゅうよ"],[40,2,"せいかつ"],[51,2,"でんち"],[54,1,"う"]],"text":"ただ祭司の田地は買い取らなかった。祭司にはパロの給与があって、パロが与える給与で生活していたので、その田地を売らなかったからである。"},{"ref":"Gen.47.23","start":1047023,"end":1047023,"break":"none","ruby":[[4,1,"たみ"],[6,1,"い"],[27,2,"でんち"],[31,1,"か"],[33,1,"と"],[52,1,"たね"],[59,1,"ち"]],"text":"ヨセフは民に言った、「わたしはきょう、あなたがたとその田地とを買い取って、パロのものとした。あなたがたに種をあげるから地にまきなさい。"},{"ref":"Gen.47.24","start":1047024,"end":1047024,"break":"none","ruby":[[0,2,"しゅうかく"],[3,1,"とき"],[9,1,"ぶん"],[16,1,"おさ"],[20,1,"ぶん"],[24,2,"じぶん"],[32,2,"たはた"],[35,1,"たね"],[39,2,"じぶん"],[42,2,"かぞく"],[45,2,"しょくりょう"],[52,2,"こども"],[55,2,"しょくりょう"]],"text":"収穫の時は、その五分の一をパロに納め、五分の四を自分のものとして田畑の種とし、自分と家族の食糧とし、また子供の食糧としなさい」。"},{"ref":"Gen.47.25","start":1047025,"end":1047025,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[17,1,"いのち"],[20,1,"すく"],[33,1,"しゅ"],[35,1,"まえ"],[37,1,"めぐ"],[40,1,"え"],[57,2,"どれい"]],"text":"彼らは言った、「あなたはわれわれの命をお救いくださった。どうかわが主の前に恵みを得させてください。われわれはパロの奴隷になりましょう」。"},{"ref":"Gen.47.26","start":1047026,"end":1047026,"break":"none","ruby":[[9,2,"でんち"],[16,2,"しゅうかく"],[20,1,"ぶん"],[27,1,"おさ"],[44,2,"こんにち"],[47,1,"およ"],[56,2,"さいし"],[59,2,"でんち"]],"text":"ヨセフはエジプトの田地について、収穫の五分の一をパロに納めることをおきてとしたが、それは今日に及んでいる。ただし祭司の田地だけはパロのものとならなかった。"},{"ref":"Gen.47.27","start":1047027,"end":1047027,"break":"paragraph","ruby":[[13,1,"くに"],[19,1,"ち"],[21,1,"す"],[27,2,"ざいさん"],[30,1,"え"],[32,1,"こ"],[34,1,"う"],[37,1,"おお"]],"text":"さてイスラエルはエジプトの国でゴセンの地に住み、そこで財産を得、子を生み、大いにふえた。"},{"ref":"Gen.47.28","start":1047028,"end":1047028,"break":"none","ruby":[[9,1,"くに"],[13,1,"ねん"],[14,1,"い"],[30,1,"ひ"],[36,1,"ねん"]],"text":"ヤコブはエジプトの国で十七年生きながらえた。ヤコブのよわいの日は百四十七年であった。"},{"ref":"Gen.47.29","start":1047029,"end":1047029,"break":"paragraph","ruby":[[6,1,"し"],[8,1,"とき"],[10,1,"ちか"],[19,1,"こ"],[24,1,"よ"],[27,1,"い"],[42,1,"まえ"],[44,1,"めぐ"],[47,1,"え"],[55,1,"て"],[64,1,"した"],[66,1,"い"],[69,1,"ちか"],[72,2,"しんせつ"],[75,2,"せいじつ"],[86,1,"と"],[88,1,"あつか"],[109,1,"ほうむ"]],"text":"イスラエルは死ぬ時が近づいたので、その子ヨセフを呼んで言った、「もしわたしがあなたの前に恵みを得るなら、どうか手をわたしのももの下に入れて誓い、親切と誠実とをもってわたしを取り扱ってください。どうかわたしをエジプトには葬らないでください。"},{"ref":"Gen.47.30","start":1047030,"end":1047030,"break":"none","ruby":[[4,2,"せんぞ"],[9,1,"とも"],[11,1,"ねむ"],[28,1,"はこ"],[30,1,"だ"],[33,2,"せんぞ"],[38,1,"はか"],[40,1,"ほうむ"],[53,1,"い"],[62,1,"い"]],"text":"わたしが先祖たちと共に眠るときには、わたしをエジプトから運び出して先祖たちの墓に葬ってください」。ヨセフは言った、「あなたの言われたようにいたします」。"},{"ref":"Gen.47.31","start":1047031,"end":1047031,"break":"none","ruby":[[12,1,"ちか"],[21,1,"い"],[27,1,"かれ"],[29,1,"ちか"],[39,1,"ゆか"],[45,1,"おが"]],"text":"ヤコブがまた、「わたしに誓ってください」と言ったので、彼は誓った。イスラエルは床のかしらで拝んだ。"}]