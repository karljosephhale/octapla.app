[{"ref":"Exod.30.1","start":2030001,"end":2030001,"break":"paragraph","ruby":[[6,1,"こう"],[10,2,"さいだん"],[13,1,"つく"],[28,1,"ざい"],[33,1,"つく"]],"text":"あなたはまた香をたく祭壇を造らなければならない。アカシヤ材でこれを造り、"},{"ref":"Exod.30.2","start":2030002,"end":2030002,"break":"none","ruby":[[0,1,"なが"],[8,1,"はば"],[16,1,"かく"],[20,1,"たか"],[34,2,"いちぶ"],[39,1,"つの"]],"text":"長さ一キュビト、幅一キュビトの四角にし、高さ二キュビトで、これにその一部として角をつけなければならない。"},{"ref":"Exod.30.3","start":2030003,"end":2030003,"break":"none","ruby":[[2,1,"いただき"],[9,2,"そくめん"],[17,1,"つの"],[19,2,"じゅんきん"],[28,2,"しゅうい"],[31,1,"きん"],[33,1,"かざ"],[35,1,"ふち"],[37,1,"つく"]],"text":"その頂、その四つの側面、およびその角を純金でおおい、その周囲に金の飾り縁を造り、"},{"ref":"Exod.30.4","start":2030004,"end":2030004,"break":"none","ruby":[[5,2,"りょうがわ"],[9,1,"かざ"],[11,1,"ふち"],[13,1,"した"],[15,1,"きん"],[17,1,"かん"],[27,1,"つく"],[48,1,"がわ"],[53,1,"つく"],[76,1,"とお"]],"text":"また、その両側に、飾り縁の下に金の環二つをこれのために造らなければならない。すなわち、その二つの側にこれを造らなければならない。これはそれをかつぐさおを通すところである。"},{"ref":"Exod.30.5","start":2030005,"end":2030005,"break":"none","ruby":[[9,1,"ざい"],[11,1,"つく"],[14,1,"きん"]],"text":"そのさおはアカシヤ材で造り、金でおおわなければならない。"},{"ref":"Exod.30.6","start":2030006,"end":2030006,"break":"none","ruby":[[12,1,"はこ"],[14,1,"まえ"],[18,2,"たれまく"],[21,1,"まえ"],[23,1,"お"],[35,1,"あ"],[41,1,"はこ"],[43,1,"うえ"],[47,3,"しょくざいしょ"],[51,1,"む"]],"text":"あなたはそれを、あかしの箱の前にある垂幕の前に置いて、わたしがあなたと会うあかしの箱の上にある贖罪所に向かわせなければならない。"},{"ref":"Exod.30.7","start":2030007,"end":2030007,"break":"none","ruby":[[6,1,"うえ"],[8,1,"こう"],[12,2,"くんこう"],[26,1,"あさ"],[36,1,"ととの"],[39,1,"とき"]],"text":"アロンはその上で香ばしい薫香をたかなければならない。朝ごとに、ともしびを整える時、これをたかなければならない。"},{"ref":"Exod.30.8","start":2030008,"end":2030008,"break":"none","ruby":[[6,1,"ゆう"],[17,1,"とき"],[38,1,"しゅ"],[40,1,"まえ"],[48,2,"よよ"],[51,1,"た"],[64,2,"くんこう"]],"text":"アロンはまた夕べにともしびをともす時にも、これをたかなければならない。これは主の前にあなたがたが代々に絶やすことなく、ささぐべき薫香である。"},{"ref":"Exod.30.9","start":2030009,"end":2030009,"break":"none","ruby":[[8,1,"うえ"],[10,1,"こと"],[13,1,"こう"],[25,2,"はんさい"],[29,2,"そさい"],[35,1,"うえ"],[52,1,"うえ"],[54,2,"かんさい"],[57,1,"そそ"]],"text":"あなたがたはその上で異なる香をささげてはならない。燔祭をも素祭をもその上でささげてはならない。また、その上に灌祭を注いではならない。"},{"ref":"Exod.30.10","start":2030010,"end":2030010,"break":"none","ruby":[[4,1,"ねん"],[7,1,"ど"],[10,1,"つの"],[12,1,"ち"],[42,2,"ざいさい"],[45,1,"ち"],[50,2,"よよ"],[57,1,"ねん"],[60,1,"ど"],[86,1,"しゅ"],[88,1,"もっと"],[90,1,"せい"]],"text":"アロンは年に一度その角に血をつけてあがないをしなければならない。すなわち、あがないの罪祭の血をもって代々にわたり、年に一度これがために、あがないをしなければならない。これは主に最も聖なるものである」。"},{"ref":"Exod.30.11","start":2030011,"end":2030011,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Exod.30.12","start":2030012,"end":2030012,"break":"none","ruby":[[11,2,"ひとびと"],[14,1,"かず"],[16,2,"そうけい"],[22,1,"あた"],[31,1,"かぞ"],[36,1,"とき"],[40,1,"いのち"],[47,1,"しゅ"],[64,1,"かぞ"],[69,1,"とき"],[71,1,"かれ"],[77,1,"わざわい"],[79,1,"おこ"]],"text":"「あなたがイスラエルの人々の数の総計をとるに当り、おのおのその数えられる時、その命のあがないを主にささげなければならない。これは数えられる時、彼らのうちに災の起らないためである。"},{"ref":"Exod.30.13","start":2030013,"end":2030013,"break":"none","ruby":[[3,1,"かず"],[5,1,"い"],[7,1,"もの"],[9,2,"せいじょ"],[17,1,"はん"],[22,1,"はら"],[51,1,"はん"],[56,1,"しゅ"],[61,1,"もの"]],"text":"すべて数に入る者は聖所のシケルで、半シケルを払わなければならない。一シケルは二十ゲラであって、おのおの半シケルを主にささげ物としなければならない。"},{"ref":"Exod.30.14","start":2030014,"end":2030014,"break":"none","ruby":[[3,1,"かず"],[5,1,"い"],[9,1,"さい"],[10,2,"いじょう"],[13,1,"もの"],[16,1,"しゅ"],[21,1,"もの"]],"text":"すべて数に入る二十歳以上の者は、主にささげ物をしなければならない。"},{"ref":"Exod.30.15","start":2030015,"end":2030015,"break":"none","ruby":[[6,1,"いのち"],[16,1,"しゅ"],[21,1,"もの"],[25,1,"とき"],[27,1,"と"],[30,1,"もの"],[32,1,"はん"],[38,1,"おお"],[40,1,"だ"],[48,1,"まず"],[51,1,"もの"],[57,1,"すく"],[60,1,"だ"]],"text":"あなたがたの命をあがなうために、主にささげ物をする時、富める者も半シケルより多く出してはならず、貧しい者もそれより少なく出してはならない。"},{"ref":"Exod.30.16","start":2030016,"end":2030016,"break":"none","ruby":[[10,2,"ひとびと"],[20,1,"ぎん"],[22,1,"と"],[29,2,"かいけん"],[32,2,"まくや"],[35,1,"よう"],[37,1,"あ"],[51,1,"しゅ"],[53,1,"まえ"],[61,2,"ひとびと"],[66,2,"きねん"],[79,1,"いのち"]],"text":"あなたはイスラエルの人々から、あがないの銀を取って、これを会見の幕屋の用に当てなければならない。これは主の前にイスラエルの人々のため記念となって、あなたがたの命をあがなうであろう」。"},{"ref":"Exod.30.17","start":2030017,"end":2030017,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Exod.30.18","start":2030018,"end":2030018,"break":"none","ruby":[[7,1,"あら"],[12,2,"せんばん"],[18,1,"だい"],[20,2,"せいどう"],[23,1,"つく"],[29,2,"かいけん"],[32,2,"まくや"],[35,2,"さいだん"],[39,1,"あいだ"],[41,1,"お"],[47,1,"なか"],[49,1,"みず"],[51,1,"い"]],"text":"「あなたはまた洗うために洗盤と、その台を青銅で造り、それを会見の幕屋と祭壇との間に置いて、その中に水を入れ、"},{"ref":"Exod.30.19","start":2030019,"end":2030019,"break":"none","ruby":[[6,1,"こ"],[14,1,"て"],[16,1,"あし"],[19,1,"あら"]],"text":"アロンとその子たちは、それで手と足とを洗わなければならない。"},{"ref":"Exod.30.20","start":2030020,"end":2030020,"break":"none","ruby":[[0,1,"かれ"],[3,2,"かいけん"],[6,2,"まくや"],[12,1,"とき"],[14,1,"みず"],[16,1,"あら"],[20,1,"し"],[39,2,"さいだん"],[42,1,"ちか"],[49,1,"つとめ"],[54,2,"かさい"],[57,1,"しゅ"],[63,1,"とき"]],"text":"彼らは会見の幕屋にはいる時、水で洗って、死なないようにしなければならない。また祭壇に近づいて、その務をなし、火祭を主にささげる時にも、そうしなければならない。"},{"ref":"Exod.30.21","start":2030021,"end":2030021,"break":"none","ruby":[[7,1,"て"],[11,1,"あし"],[13,1,"あら"],[17,1,"し"],[37,1,"かれ"],[41,2,"しそん"],[44,2,"よよ"],[50,2,"えいきゅう"],[53,1,"さだ"]],"text":"すなわち、その手、その足を洗って、死なないようにしなければならない。これは彼とその子孫の代々にわたる永久の定めでなければならない」。"},{"ref":"Exod.30.22","start":2030022,"end":2030022,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Exod.30.23","start":2030023,"end":2030023,"break":"none","ruby":[[7,1,"もっと"],[9,1,"よ"],[11,2,"こうりょう"],[14,1,"と"],[24,2,"えきたい"],[27,2,"もつやく"],[35,1,"こう"],[39,2,"にっけい"],[44,1,"なか"],[62,2,"しょうぶ"]],"text":"「あなたはまた最も良い香料を取りなさい。すなわち液体の没薬五百シケル、香ばしい肉桂をその半ば、すなわち二百五十シケル、におい菖蒲二百五十シケル、"},{"ref":"Exod.30.24","start":2030024,"end":2030024,"break":"none","ruby":[[0,1,"けい"],[1,1,"し"],[8,2,"せいじょ"],[15,1,"と"],[25,1,"あぶら"],[30,1,"と"]],"text":"桂枝五百シケルを聖所のシケルで取り、また、オリブの油一ヒンを取りなさい。"},{"ref":"Exod.30.25","start":2030025,"end":2030025,"break":"none","ruby":[[7,1,"せい"],[10,1,"そそ"],[12,1,"あぶら"],[18,2,"こうゆ"],[21,1,"つく"],[33,1,"あ"],[41,1,"あぶら"],[43,1,"つく"],[57,1,"せい"],[60,1,"そそ"],[62,1,"あぶら"]],"text":"あなたはこれを聖なる注ぎ油、すなわち香油を造るわざにしたがい、まぜ合わせて、におい油に造らなければならない。これは聖なる注ぎ油である。"},{"ref":"Exod.30.26","start":2030026,"end":2030026,"break":"none","ruby":[[6,1,"あぶら"],[8,2,"かいけん"],[11,2,"まくや"],[19,1,"はこ"],[22,1,"そそ"]],"text":"あなたはこの油を会見の幕屋と、あかしの箱とに注ぎ、"},{"ref":"Exod.30.27","start":2030027,"end":2030027,"break":"none","ruby":[[0,1,"つくえ"],[10,1,"うつわ"],[12,2,"しょくだい"],[23,1,"うつわ"],[25,1,"こう"],[27,2,"さいだん"]],"text":"机と、そのもろもろの器、燭台と、そのもろもろの器、香の祭壇、"},{"ref":"Exod.30.28","start":2030028,"end":2030028,"break":"none","ruby":[[0,2,"はんさい"],[3,2,"さいだん"],[14,1,"うつわ"],[16,2,"せんばん"],[22,1,"だい"],[25,1,"あぶら"],[27,1,"そそ"]],"text":"燔祭の祭壇と、そのもろもろの器、洗盤と、その台とに油を注ぎ、"},{"ref":"Exod.30.29","start":2030029,"end":2030029,"break":"none","ruby":[[8,1,"もっと"],[10,1,"せい"],[13,1,"もの"],[31,1,"ふ"],[34,1,"もの"],[36,1,"せい"]],"text":"これらをきよめて最も聖なる物としなければならない。すべてこれに触れる者は聖となるであろう。"},{"ref":"Exod.30.30","start":2030030,"end":2030030,"break":"none","ruby":[[10,1,"こ"],[14,1,"あぶら"],[16,1,"そそ"],[20,1,"かれ"],[23,2,"せいべつ"],[27,2,"さいし"],[36,1,"つか"]],"text":"あなたはアロンとその子たちに油を注いで、彼らを聖別し、祭司としてわたしに仕えさせなければならない。"},{"ref":"Exod.30.31","start":2030031,"end":2030031,"break":"none","ruby":[[13,2,"ひとびと"],[16,1,"い"],[37,2,"よよ"],[48,1,"せい"],[51,1,"そそ"],[53,1,"あぶら"]],"text":"そしてあなたはイスラエルの人々に言わなければならない、『これはあなたがたの代々にわたる、わたしの聖なる注ぎ油であって、"},{"ref":"Exod.30.32","start":2030032,"end":2030032,"break":"none","ruby":[[0,1,"つね"],[2,1,"ひと"],[4,1,"み"],[9,1,"そそ"],[22,2,"わりあい"],[32,1,"ひと"],[38,1,"つく"],[50,1,"せい"],[71,1,"せい"],[74,1,"もの"]],"text":"常の人の身にこれを注いではならない。またこの割合をもって、これと等しいものを造ってはならない。これは聖なるものであるから、あなたがたにとっても聖なる物でなければならない。"},{"ref":"Exod.30.33","start":2030033,"end":2030033,"break":"none","ruby":[[6,1,"ひと"],[9,1,"もの"],[11,1,"つく"],[13,1,"もの"],[22,2,"さいし"],[24,2,"いがい"],[27,1,"ひと"],[32,1,"もの"],[35,1,"たみ"],[41,1,"た"]],"text":"すべてこれと等しい物を造る者、あるいはこれを祭司以外の人につける者は、民のうちから断たれるであろう』」。"},{"ref":"Exod.30.34","start":2030034,"end":2030034,"break":"paragraph","ruby":[[0,1,"しゅ"],[9,1,"い"],[19,2,"こうりょう"],[26,1,"そ"],[27,1,"ごう"],[28,1,"こう"],[34,1,"こう"],[36,1,"ふう"],[37,1,"し"],[38,1,"こう"],[40,2,"じゅんすい"],[43,2,"にゅうこう"],[46,2,"こうりょう"],[49,1,"と"],[59,1,"おな"],[61,1,"りょう"]],"text":"主はまた、モーセに言われた、「あなたは香料、すなわち蘇合香、シケレテ香、楓子香、純粋の乳香の香料を取りなさい。おのおの同じ量でなければならない。"},{"ref":"Exod.30.35","start":2030035,"end":2030035,"break":"none","ruby":[[10,1,"こう"],[16,2,"こうりょう"],[30,2,"くんこう"],[33,1,"つく"],[36,1,"しお"],[38,1,"くわ"],[41,1,"じゅん"],[45,1,"せい"],[48,1,"もの"]],"text":"あなたはこれをもって香、すなわち香料をつくるわざにしたがって薫香を造り、塩を加え、純にして聖なる物としなさい。"},{"ref":"Exod.30.36","start":2030036,"end":2030036,"break":"none","ruby":[[5,1,"いく"],[9,1,"こま"],[12,1,"くだ"],[23,1,"あ"],[25,2,"かいけん"],[28,2,"まくや"],[38,1,"はこ"],[40,1,"まえ"],[45,1,"そな"],[65,1,"もっと"],[67,1,"せい"]],"text":"また、その幾ぶんを細かに砕き、わたしがあなたと会う会見の幕屋にある、あかしの箱の前にこれを供えなければならない。これはあなたがたに最も聖なるものである。"},{"ref":"Exod.30.37","start":2030037,"end":2030037,"break":"none","ruby":[[4,1,"つく"],[6,1,"こう"],[8,1,"おな"],[10,2,"わりあい"],[20,2,"じぶん"],[26,1,"つく"],[45,1,"しゅ"],[47,1,"せい"]],"text":"あなたが造る香の同じ割合をもって、それを自分のために造ってはならない。これはあなたにとって主に聖なるものでなければならない。"},{"ref":"Exod.30.38","start":2030038,"end":2030038,"break":"none","ruby":[[6,1,"ひと"],[12,1,"つく"],[21,1,"もの"],[23,1,"たみ"],[29,1,"た"]],"text":"すべてこれと等しいものを造って、これをかぐ者は民のうちから断たれるであろう」。"}]