[{"ref":"Ps.69.1","start":19069001,"end":19069001,"break":"paragraph","title":"聖歌隊の指揮者によってゆりの花のしらべにあわせてうたわせたダビデの歌","breaks":[[15,"line"]],"ruby":[[0,1,"かみ"],[8,1,"すく"],[15,2,"おおみず"],[18,1,"なが"],[20,1,"き"],[27,1,"くび"],[31,1,"たっ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[14,1,"はな"],[33,1,"うた"]],"text":"神よ、わたしをお救いください。大水が流れ来て、わたしの首にまで達しました。"},{"ref":"Ps.69.2","start":19069002,"end":19069002,"break":"line","breaks":[[23,"line"],[34,"line"]],"ruby":[[4,1,"あし"],[11,1,"ふか"],[13,1,"どろ"],[15,1,"なか"],[17,1,"しず"],[27,1,"ふか"],[29,1,"みず"],[31,1,"おちい"],[34,2,"おおみず"],[41,1,"うえ"],[43,1,"なが"],[45,1,"す"]],"text":"わたしは足がかりもない深い泥の中に沈みました。わたしは深い水に陥り、大水がわたしの上を流れ過ぎました。"},{"ref":"Ps.69.3","start":19069003,"end":19069003,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"さけ"],[10,1,"つか"],[28,1,"め"],[30,1,"かみ"],[32,1,"ま"],[37,1,"おとろ"]],"text":"わたしは叫びによって疲れ、わたしののどはかわき、わたしの目は神を待ちわびて衰えました。"},{"ref":"Ps.69.4","start":19069004,"end":19069004,"break":"line","breaks":[[13,"line"],[26,"line"],[38,"line"],[57,"line"],[70,"line"]],"ruby":[[9,1,"にく"],[11,1,"もの"],[17,1,"あたま"],[19,1,"け"],[23,1,"おお"],[26,1,"いつわ"],[33,1,"てき"],[42,1,"ほろ"],[49,1,"もの"],[51,1,"つよ"],[61,1,"ぬす"],[67,1,"もの"],[70,1,"つぐな"]],"text":"ゆえなく、わたしを憎む者はわたしの頭の毛よりも多く、偽ってわたしの敵となり、わたしを滅ぼそうとする者は強いのです。わたしは盗まなかった物をも償わなければならないのですか。"},{"ref":"Ps.69.5","start":19069005,"end":19069005,"break":"line","breaks":[[17,"line"],[26,"line"],[38,"line"]],"ruby":[[0,1,"かみ"],[11,1,"おろ"],[17,1,"し"],[42,1,"かく"]],"text":"神よ、あなたはわたしの愚かなことを知っておられます。わたしのもろもろのとがはあなたに隠れることはありません。"},{"ref":"Ps.69.6","start":19069006,"end":19069006,"break":"line","breaks":[[18,"line"],[28,"line"],[51,"line"],[69,"line"],[79,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[5,1,"しゅ"],[12,1,"ま"],[14,1,"のぞ"],[16,1,"もの"],[22,1,"こと"],[57,1,"かみ"],[64,1,"もと"],[67,1,"もの"],[73,1,"こと"],[79,1,"はじ"],[81,1,"お"]],"text":"万軍の神、主よ、あなたを待ち望む者がわたしの事によって、はずかしめられることのないようにしてください。イスラエルの神よ、あなたを求める者がわたしの事によって、恥を負わせられることのないようにしてください。"},{"ref":"Ps.69.7","start":19069007,"end":19069007,"break":"line","breaks":[[18,"line"]],"ruby":[[15,1,"お"],[18,1,"はじ"],[24,1,"かお"]],"text":"わたしはあなたのためにそしりを負い、恥がわたしの顔をおおったのです。"},{"ref":"Ps.69.8","start":19069008,"end":19069008,"break":"line","breaks":[[19,"line"]],"ruby":[[6,2,"きょうだい"],[11,1,"し"],[14,1,"もの"],[21,1,"はは"],[23,1,"こ"],[30,1,"もの"]],"text":"わたしはわが兄弟には、知らぬ者となり、わが母の子らには、のけ者となりました。"},{"ref":"Ps.69.9","start":19069009,"end":19069009,"break":"line","breaks":[[21,"line"],[34,"line"]],"ruby":[[4,1,"いえ"],[6,1,"おも"],[8,2,"ねっしん"],[15,1,"く"],[28,1,"もの"],[38,1,"およ"]],"text":"あなたの家を思う熱心がわたしを食いつくし、あなたをそしる者のそしりがわたしに及んだからです。"},{"ref":"Ps.69.10","start":19069010,"end":19069010,"break":"line","breaks":[[21,"line"]],"ruby":[[4,2,"だんじき"],[14,1,"たましい"],[16,1,"なや"]],"text":"わたしが断食をもってわたしの魂を悩ませば、かえってそれによってそしりをうけました。"},{"ref":"Ps.69.11","start":19069011,"end":19069011,"break":"line","breaks":[[13,"line"]],"ruby":[[4,2,"あらぬの"],[7,1,"ころも"],[17,1,"かれ"]],"text":"わたしが荒布を衣とすれば、かえって彼らのことわざとなりました。"},{"ref":"Ps.69.12","start":19069012,"end":19069012,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"もん"],[6,1,"ざ"],[9,1,"もの"],[11,2,"わだい"],[17,1,"よ"],[22,1,"うた"]],"text":"わたしは門に座する者の話題となり、酔いどれの歌となりました。"},{"ref":"Ps.69.13","start":19069013,"end":19069013,"break":"line","breaks":[[19,"line"],[28,"line"],[46,"line"]],"ruby":[[3,1,"しゅ"],[14,1,"いの"],[19,1,"かみ"],[22,1,"めぐ"],[25,1,"とき"],[38,1,"ゆた"],[51,1,"こた"]],"text":"しかし主よ、わたしはあなたに祈ります。神よ、恵みの時に、あなたのいつくしみの豊かなるにより、わたしにお答えください。"},{"ref":"Ps.69.14","start":19069014,"end":19069014,"break":"line","breaks":[[13,"line"],[36,"line"],[46,"line"]],"ruby":[[8,1,"すくい"],[17,1,"どろ"],[19,1,"なか"],[21,1,"しず"],[26,1,"たす"],[28,1,"だ"],[40,1,"にく"],[42,1,"もの"],[48,1,"ふか"],[50,1,"みず"],[57,1,"たす"],[59,1,"だ"]],"text":"あなたのまことの救により、わたしを泥の中に沈まぬよう助け出してください。わたしを憎む者から、また深い水からわたしを助け出してください。"},{"ref":"Ps.69.15","start":19069015,"end":19069015,"break":"line","breaks":[[19,"line"],[32,"line"],[55,"line"]],"ruby":[[0,2,"おおみず"],[7,1,"うえ"],[9,1,"なが"],[11,1,"す"],[19,1,"ふち"],[32,1,"あな"],[36,1,"くち"],[42,1,"うえ"],[44,1,"と"]],"text":"大水がわたしの上を流れ過ぎることなく、淵がわたしをのむことなく、穴がその口をわたしの上に閉じることのないようにしてください。"},{"ref":"Ps.69.16","start":19069016,"end":19069016,"break":"line","breaks":[[19,"line"],[31,"line"],[48,"line"]],"ruby":[[0,1,"しゅ"],[13,1,"ふか"],[24,1,"こた"],[40,1,"ゆた"],[52,1,"かえり"]],"text":"主よ、あなたのいつくしみの深きにより、わたしにお答えください。あなたのあわれみの豊かなるにより、わたしを顧みてください。"},{"ref":"Ps.69.17","start":19069017,"end":19069017,"break":"line","breaks":[[20,"line"],[33,"line"]],"ruby":[[4,1,"かお"],[10,1,"かく"],[24,1,"なや"],[43,1,"こた"]],"text":"あなたの顔をしもべに隠さないでください。わたしは悩んでいるのです。すみやかにわたしにお答えください。"},{"ref":"Ps.69.18","start":19069018,"end":19069018,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"ちか"],[6,1,"よ"],[21,1,"てき"],[31,1,"すく"]],"text":"わたしに近く寄って、わたしをあがない、わが敵のゆえにわたしをお救いください。"},{"ref":"Ps.69.19","start":19069019,"end":19069019,"break":"line","breaks":[[16,"line"],[35,"line"]],"ruby":[[8,1,"う"],[16,1,"はじ"],[26,1,"し"],[42,1,"みな"],[47,1,"まえ"]],"text":"あなたはわたしの受けるそしりと、恥と、はずかしめとを知っておられます。わたしのあだは皆あなたの前にあります。"},{"ref":"Ps.69.20","start":19069020,"end":19069020,"break":"line","breaks":[[16,"line"],[29,"line"],[54,"line"]],"ruby":[[8,1,"こころ"],[10,1,"くだ"],[20,1,"のぞ"],[23,1,"うしな"],[33,2,"どうじょう"],[37,1,"もの"],[39,1,"もと"],[54,1,"なぐさ"],[57,1,"もの"],[59,1,"もと"],[71,1,"み"]],"text":"そしりがわたしの心を砕いたので、わたしは望みを失いました。わたしは同情する者を求めたけれども、ひとりもなく、慰める者を求めたけれども、ひとりも見ませんでした。"},{"ref":"Ps.69.21","start":19069021,"end":19069021,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[7,2,"しょくもつ"],[10,1,"どく"],[12,1,"い"],[23,1,"とき"],[25,1,"す"],[27,1,"の"]],"text":"彼らはわたしの食物に毒を入れ、わたしのかわいた時に酢を飲ませました。"},{"ref":"Ps.69.22","start":19069022,"end":19069022,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[3,1,"まえ"],[5,2,"しょくたく"],[8,1,"あみ"],[12,1,"かれ"],[15,2,"ぎせい"],[22,1,"まつり"]],"text":"彼らの前の食卓を網とし、彼らが犠牲をささげる祭を、わなとしてください。"},{"ref":"Ps.69.23","start":19069023,"end":19069023,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"め"],[5,1,"くら"],[9,1,"み"],[15,1,"かれ"],[18,1,"こし"],[20,1,"つね"],[22,1,"ふる"]],"text":"彼らの目を暗くして見えなくし、彼らの腰を常に震わせ、"},{"ref":"Ps.69.24","start":19069024,"end":19069024,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"いきどお"],[7,1,"かれ"],[10,1,"うえ"],[20,1,"はげ"],[23,1,"いか"],[26,1,"かれ"],[29,1,"お"]],"text":"あなたの憤りを彼らの上にそそぎ、あなたの激しい怒りを彼らに追いつかせてください。"},{"ref":"Ps.69.25","start":19069025,"end":19069025,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"かれ"],[3,2,"しゅくえい"],[6,1,"あら"],[15,2,"てんまく"],[18,1,"す"]],"text":"彼らの宿営を荒し、ひとりもその天幕に住まわせないでください。"},{"ref":"Ps.69.26","start":19069026,"end":19069026,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[7,1,"う"],[11,1,"もの"],[13,2,"はくがい"],[21,1,"きず"],[27,1,"もの"],[32,1,"くる"]],"text":"彼らはあなたが撃たれた者を迫害し、あなたが傷つけられた者をさらに苦しめるからです。"},{"ref":"Ps.69.27","start":19069027,"end":19069027,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[4,1,"ばつ"],[6,1,"ばつ"],[8,1,"くわ"],[15,2,"しゃめん"]],"text":"彼らに、罰に罰を加え、あなたの赦免にあずからせないでください。"},{"ref":"Ps.69.28","start":19069028,"end":19069028,"break":"line","breaks":[[16,"line"],[35,"line"]],"ruby":[[0,1,"かれ"],[7,1,"か"],[10,1,"け"],[12,1,"さ"],[16,2,"ぎじん"],[22,2,"きろく"]],"text":"彼らをいのちの書から消し去って、義人のうちに記録されることのないようにしてください。"},{"ref":"Ps.69.29","start":19069029,"end":19069029,"break":"line","breaks":[[17,"line"],[26,"line"]],"ruby":[[7,1,"なや"],[9,1,"くる"],[17,1,"かみ"],[24,1,"すくい"],[30,1,"たか"],[32,1,"ところ"],[34,1,"お"]],"text":"しかしわたしは悩み苦しんでいます。神よ、あなたの救がわたしを高い所に置かれますように。"},{"ref":"Ps.69.30","start":19069030,"end":19069030,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"うた"],[9,1,"かみ"],[11,1,"な"],[19,2,"かんしゃ"],[25,1,"かみ"]],"text":"わたしは歌をもって神の名をほめたたえ、感謝をもって神をあがめます。"},{"ref":"Ps.69.31","start":19069031,"end":19069031,"break":"line","breaks":[[23,"line"]],"ruby":[[3,2,"おうし"],[8,1,"つの"],[16,2,"おうし"],[23,1,"しゅ"],[25,1,"よろこ"]],"text":"これは雄牛または角とひずめのある雄牛にまさって主を喜ばせるでしょう。"},{"ref":"Ps.69.32","start":19069032,"end":19069032,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"もの"],[11,1,"み"],[13,1,"よろこ"],[16,1,"かみ"],[18,1,"もと"],[21,1,"もの"],[30,1,"こころ"],[32,1,"い"]],"text":"へりくだる者は、これを見て喜べ。神を求める者よ、あなたがたの心を生きかえらせよ。"},{"ref":"Ps.69.33","start":19069033,"end":19069033,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"とぼ"],[5,1,"もの"],[7,1,"き"],[12,1,"とら"],[15,1,"びと"]],"text":"主は乏しい者に聞き、その捕われ人をかろしめられないからである。"},{"ref":"Ps.69.34","start":19069034,"end":19069034,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"てん"],[2,1,"ち"],[4,1,"しゅ"],[12,1,"うみ"],[16,1,"なか"],[18,1,"うご"],[27,1,"しゅ"]],"text":"天と地は主をほめたたえ、海とその中に動くあらゆるものは主をほめたたえよ。"},{"ref":"Ps.69.35","start":19069035,"end":19069035,"break":"line","breaks":[[9,"line"],[27,"line"]],"ruby":[[0,1,"かみ"],[6,1,"すく"],[12,2,"まちまち"],[15,1,"た"],[17,1,"なお"],[37,1,"す"],[43,2,"しょゆう"]],"text":"神はシオンを救い、ユダの町々を建て直されるからである。そのしもべらはそこに住んでこれを所有し、"},{"ref":"Ps.69.36","start":19069036,"end":19069036,"break":"line","breaks":[[16,"line"]],"ruby":[[7,2,"しそん"],[13,1,"つ"],[17,1,"な"],[19,1,"あい"],[22,1,"もの"],[26,1,"なか"],[28,1,"す"]],"text":"そのしもべらの子孫はこれを継ぎ、み名を愛する者はその中に住むであろう。"}]