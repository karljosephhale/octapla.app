[{"ref":"1Pet.3.1","start":60003001,"end":60003001,"break":"paragraph","ruby":[[0,1,"おな"],[6,1,"つま"],[9,1,"もの"],[12,1,"おっと"],[14,1,"つか"],[29,2,"みことば"],[32,1,"したが"],[36,1,"おっと"]],"text":"同じように、妻たる者よ。夫に仕えなさい。そうすれば、たとい御言に従わない夫であっても、"},{"ref":"1Pet.3.2","start":60003002,"end":60003002,"break":"none","ruby":[[12,1,"きよ"],[14,1,"おこな"],[17,1,"み"],[22,1,"つま"],[24,2,"むごん"],[27,1,"おこな"],[34,1,"すくい"],[36,1,"い"]],"text":"あなたがたのうやうやしく清い行いを見て、その妻の無言の行いによって、救に入れられるようになるであろう。"},{"ref":"1Pet.3.3","start":60003003,"end":60003003,"break":"none","ruby":[[7,1,"かみ"],[9,1,"あ"],[12,1,"きん"],[14,1,"かざ"],[20,2,"ふくそう"],[31,1,"がい"],[32,1,"めん"],[34,1,"かざ"]],"text":"あなたがたは、髪を編み、金の飾りをつけ、服装をととのえるような外面の飾りではなく、"},{"ref":"1Pet.3.4","start":60003004,"end":60003004,"break":"none","ruby":[[4,1,"うち"],[7,1,"ひと"],[9,2,"にゅうわ"],[18,1,"れい"],[22,1,"く"],[30,1,"かざ"],[34,1,"み"],[50,1,"かみ"],[61,1,"たっと"]],"text":"かくれた内なる人、柔和で、しとやかな霊という朽ちることのない飾りを、身につけるべきである。これこそ、神のみまえに、きわめて尊いものである。"},{"ref":"1Pet.3.5","start":60003005,"end":60003005,"break":"none","ruby":[[4,1,"かみ"],[6,1,"あお"],[8,1,"のぞ"],[13,1,"せい"],[16,1,"おんな"],[26,1,"み"],[28,1,"かざ"],[34,1,"おっと"],[36,1,"つか"]],"text":"むかし、神を仰ぎ望んでいた聖なる女たちも、このように身を飾って、その夫に仕えたのである。"},{"ref":"1Pet.3.6","start":60003006,"end":60003006,"break":"none","ruby":[[14,1,"つか"],[18,1,"かれ"],[20,1,"しゅ"],[22,1,"よ"],[33,2,"なにごと"],[40,1,"おく"],[47,1,"ぜん"],[49,1,"おこな"],[56,1,"むすめ"]],"text":"たとえば、サラはアブラハムに仕えて、彼を主と呼んだ。あなたがたも、何事にもおびえ臆することなく善を行えば、サラの娘たちとなるのである。"},{"ref":"1Pet.3.7","start":60003007,"end":60003007,"break":"paragraph","ruby":[[0,1,"おっと"],[3,1,"もの"],[12,1,"おな"],[18,1,"おんな"],[20,2,"じぶん"],[25,1,"よわ"],[27,1,"うつわ"],[34,1,"みと"],[38,2,"ちしき"],[41,1,"したが"],[44,1,"つま"],[46,1,"とも"],[48,1,"す"],[55,1,"めぐ"],[58,1,"とも"],[62,1,"う"],[64,1,"つ"],[66,1,"もの"],[71,1,"たっと"],[87,1,"いのり"],[89,1,"さまた"]],"text":"夫たる者よ。あなたがたも同じように、女は自分よりも弱い器であることを認めて、知識に従って妻と共に住み、いのちの恵みを共どもに受け継ぐ者として、尊びなさい。それは、あなたがたの祈が妨げられないためである。"},{"ref":"1Pet.3.8","start":60003008,"end":60003008,"break":"paragraph","ruby":[[0,2,"さいご"],[3,1,"い"],[12,1,"みな"],[14,1,"こころ"],[22,2,"どうじょう"],[25,1,"あ"],[28,2,"きょうだい"],[30,1,"あい"],[39,1,"ぶか"],[44,2,"けんきょ"]],"text":"最後に言う。あなたがたは皆、心をひとつにし、同情し合い、兄弟愛をもち、あわれみ深くあり、謙虚でありなさい。"},{"ref":"1Pet.3.9","start":60003009,"end":60003009,"break":"none","ruby":[[0,1,"あく"],[5,1,"あく"],[7,1,"むく"],[11,2,"あっこう"],[17,2,"あっこう"],[20,1,"むく"],[29,2,"しゅくふく"],[35,1,"むく"],[47,1,"め"],[54,2,"しゅくふく"],[57,1,"う"],[59,1,"つ"]],"text":"悪をもって悪に報いず、悪口をもって悪口に報いず、かえって、祝福をもって報いなさい。あなたがたが召されたのは、祝福を受け継ぐためなのである。"},{"ref":"1Pet.3.10","start":60003010,"end":60003010,"break":"stanza","breaks":[[8,"line"],[26,"line"],[37,"line"]],"ruby":[[5,1,"あい"],[13,2,"ひび"],[16,1,"す"],[21,1,"ねが"],[23,1,"ひと"],[26,1,"した"],[28,1,"せい"],[31,1,"あく"],[33,1,"い"],[42,1,"と"],[45,1,"いつわ"],[48,1,"かた"]],"text":"「いのちを愛し、さいわいな日々を過ごそうと願う人は、舌を制して悪を言わず、くちびるを閉じて偽りを語らず、"},{"ref":"1Pet.3.11","start":60003011,"end":60003011,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"あく"],[2,1,"さ"],[5,1,"ぜん"],[7,1,"おこな"],[10,2,"へいわ"],[13,1,"もと"],[20,1,"お"]],"text":"悪を避けて善を行い、平和を求めて、これを追え。"},{"ref":"1Pet.3.12","start":60003012,"end":60003012,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"め"],[4,2,"ぎじん"],[9,1,"そそ"],[13,1,"しゅ"],[15,1,"みみ"],[17,1,"かれ"],[20,1,"いのり"],[30,1,"しゅ"],[32,2,"みかお"],[36,1,"あく"],[38,1,"おこな"],[40,1,"もの"],[42,1,"たい"],[45,1,"む"]],"text":"主の目は義人たちに注がれ、主の耳は彼らの祈にかたむく。しかし主の御顔は、悪を行う者に対して向かう」。"},{"ref":"1Pet.3.13","start":60003013,"end":60003013,"break":"paragraph","ruby":[[12,1,"ぜん"],[14,2,"ねっしん"],[31,2,"きがい"],[34,1,"くわ"]],"text":"そこで、もしあなたがたが善に熱心であれば、だれが、あなたがたに危害を加えようか。"},{"ref":"1Pet.3.14","start":60003014,"end":60003014,"break":"none","ruby":[[4,2,"まんいち"],[6,1,"ぎ"],[11,1,"くる"],[39,1,"かれ"],[42,1,"おそ"],[47,1,"こころ"],[49,1,"みだ"]],"text":"しかし、万一義のために苦しむようなことがあっても、あなたがたはさいわいである。彼らを恐れたり、心を乱したりしてはならない。"},{"ref":"1Pet.3.15","start":60003015,"end":60003015,"break":"none","ruby":[[3,1,"こころ"],[5,1,"なか"],[12,1,"しゅ"],[35,1,"のぞ"],[41,2,"せつめい"],[44,1,"もと"],[47,1,"ひと"],[55,2,"べんめい"],[61,2,"ようい"]],"text":"ただ、心の中でキリストを主とあがめなさい。また、あなたがたのうちにある望みについて説明を求める人には、いつでも弁明のできる用意をしていなさい。"},{"ref":"1Pet.3.16","start":60003016,"end":60003016,"break":"none","ruby":[[9,1,"つつし"],[11,1,"ぶか"],[14,1,"あき"],[18,2,"りょうしん"],[25,2,"べんめい"],[52,1,"いとな"],[57,1,"よ"],[59,2,"せいかつ"],[65,2,"ひとびと"],[82,1,"は"]],"text":"しかし、やさしく、慎み深く、明らかな良心をもって、弁明しなさい。そうすれば、あなたがたがキリストにあって営んでいる良い生活をそしる人々も、そのようにののしったことを恥じいるであろう。"},{"ref":"1Pet.3.17","start":60003017,"end":60003017,"break":"none","ruby":[[0,1,"ぜん"],[7,1,"くる"],[18,1,"かみ"],[20,2,"みむね"],[28,1,"あく"],[35,1,"くる"]],"text":"善をおこなって苦しむことは――それが神の御旨であれば――悪をおこなって苦しむよりも、まさっている。"},{"ref":"1Pet.3.18","start":60003018,"end":60003018,"break":"none","ruby":[[12,1,"かみ"],[23,1,"みずか"],[26,1,"ぎ"],[37,2,"ふぎ"],[41,2,"ひとびと"],[52,1,"つみ"],[57,1,"し"],[66,1,"にく"],[72,1,"ころ"],[78,1,"れい"],[84,1,"い"]],"text":"キリストも、あなたがたを神に近づけようとして、自らは義なるかたであるのに、不義なる人々のために、ひとたび罪のゆえに死なれた。ただし、肉においては殺されたが、霊においては生かされたのである。"},{"ref":"1Pet.3.19","start":60003019,"end":60003019,"break":"none","ruby":[[5,1,"かれ"],[7,1,"ごく"],[9,1,"とら"],[15,1,"れい"],[23,1,"くだ"],[26,1,"い"],[29,1,"の"],[31,1,"つた"]],"text":"こうして、彼は獄に捕われている霊どものところに下って行き、宣べ伝えることをされた。"},{"ref":"1Pet.3.20","start":60003020,"end":60003020,"break":"none","ruby":[[4,1,"れい"],[17,2,"はこぶね"],[20,1,"つく"],[26,1,"あいだ"],[28,1,"かみ"],[30,2,"かんよう"],[36,1,"ま"],[45,1,"したが"],[51,1,"もの"],[63,2,"はこぶね"],[66,1,"の"],[68,1,"こ"],[71,1,"みず"],[73,1,"へ"],[75,1,"すく"],[87,1,"めい"]],"text":"これらの霊というのは、むかしノアの箱舟が造られていた間、神が寛容をもって待っておられたのに従わなかった者どものことである。その箱舟に乗り込み、水を経て救われたのは、わずかに八名だけであった。"},{"ref":"1Pet.3.21","start":60003021,"end":60003021,"break":"none","ruby":[[2,1,"みず"],[10,2,"しょうちょう"],[21,1,"いま"],[30,1,"すく"],[50,2,"ふっかつ"],[65,1,"けが"],[68,1,"のぞ"],[77,1,"あき"],[81,2,"りょうしん"],[84,1,"かみ"],[86,1,"ねが"],[88,1,"もと"]],"text":"この水はバプテスマを象徴するものであって、今やあなたがたをも救うのである。それは、イエス・キリストの復活によるのであって、からだの汚れを除くことではなく、明らかな良心を神に願い求めることである。"},{"ref":"1Pet.3.22","start":60003022,"end":60003022,"break":"none","ruby":[[5,1,"てん"],[7,1,"のぼ"],[10,1,"かみ"],[12,1,"みぎ"],[14,1,"ざ"],[17,2,"てんし"],[27,2,"けんい"],[30,2,"けんりょく"],[33,1,"したが"]],"text":"キリストは天に上って神の右に座し、天使たちともろもろの権威、権力を従えておられるのである。"}]