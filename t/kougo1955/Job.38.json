[{"ref":"Job.38.1","start":18038001,"end":18038001,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[9,1,"かぜ"],[11,1,"なか"],[17,1,"こた"]],"text":"この時、主はつむじ風の中からヨブに答えられた、"},{"ref":"Job.38.2","start":18038002,"end":18038002,"break":"stanza","breaks":[[11,"line"]],"ruby":[[1,2,"むち"],[4,2,"ことば"],[11,1,"かみ"],[13,1,"はか"],[18,1,"くら"],[24,1,"もの"]],"text":"「無知の言葉をもって、神の計りごとを暗くするこの者はだれか。"},{"ref":"Job.38.3","start":18038003,"end":18038003,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"こし"],[6,1,"おび"],[10,1,"おとこ"],[25,1,"たず"],[33,1,"こた"]],"text":"あなたは腰に帯して、男らしくせよ。わたしはあなたに尋ねる、わたしに答えよ。"},{"ref":"Job.38.4","start":18038004,"end":18038004,"break":"stanza","breaks":[[20,"line"]],"ruby":[[4,1,"ち"],[6,1,"もとい"],[11,1,"とき"],[26,1,"し"],[33,1,"い"]],"text":"わたしが地の基をすえた時、どこにいたか。もしあなたが知っているなら言え。"},{"ref":"Job.38.5","start":18038005,"end":18038005,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[6,1,"し"],[19,2,"どりょう"],[22,1,"さだ"],[30,1,"はか"],[35,1,"ち"],[37,1,"うえ"],[39,1,"は"]],"text":"あなたがもし知っているなら、だれがその度量を定めたか。だれが測りなわを地の上に張ったか。"},{"ref":"Job.38.6","start":18038006,"end":18038006,"break":"line","breaks":[[15,"line"]],"ruby":[[2,2,"どだい"],[5,1,"なに"],[7,1,"うえ"],[9,1,"お"],[17,1,"すみ"],[19,1,"いし"]],"text":"その土台は何の上に置かれたか。その隅の石はだれがすえたか。"},{"ref":"Job.38.7","start":18038007,"end":18038007,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"とき"],[5,1,"あ"],[8,1,"ほし"],[10,1,"あい"],[11,1,"とも"],[13,1,"うた"],[16,1,"かみ"],[18,1,"こ"],[24,1,"よろこ"],[26,1,"よ"]],"text":"かの時には明けの星は相共に歌い、神の子たちはみな喜び呼ばわった。"},{"ref":"Job.38.8","start":18038008,"end":18038008,"break":"stanza","breaks":[[20,"line"]],"ruby":[[0,1,"うみ"],[2,1,"みず"],[4,1,"なが"],[9,2,"たいない"],[15,1,"で"],[23,1,"と"],[32,1,"と"]],"text":"海の水が流れいで、胎内からわき出たとき、だれが戸をもって、これを閉じこめたか。"},{"ref":"Job.38.9","start":18038009,"end":18038009,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"とき"],[8,1,"くも"],[13,1,"ころも"],[17,2,"くろくも"]],"text":"あの時、わたしは雲をもって衣とし、黒雲をもってむつきとし、"},{"ref":"Job.38.10","start":18038010,"end":18038010,"break":"line","breaks":[[11,"line"]],"ruby":[[6,1,"さかい"],[8,1,"さだ"],[11,1,"かん"],[15,1,"と"],[17,1,"もう"]],"text":"これがために境を定め、関および戸を設けて、"},{"ref":"Job.38.11","start":18038011,"end":18038011,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"い"],[9,1,"き"],[15,1,"こ"],[27,2,"たかなみ"]],"text":"言った、『ここまで来てもよい、越えてはならぬ、おまえの高波はここにとどまるのだ』と。"},{"ref":"Job.38.12","start":18038012,"end":18038012,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"うま"],[7,1,"ひ"],[14,1,"あさ"],[16,1,"めい"],[19,2,"よあ"],[25,1,"ところ"],[27,1,"し"]],"text":"あなたは生れた日からこのかた朝に命じ、夜明けにその所を知らせ、"},{"ref":"Job.38.13","start":18038013,"end":18038013,"break":"line","breaks":[[13,"line"]],"ruby":[[3,1,"ち"],[5,1,"ふち"],[13,2,"あくにん"],[18,1,"うえ"],[21,1,"ふ"],[23,1,"おと"]],"text":"これに地の縁をとらえさせ、悪人をその上から振り落させたことがあるか。"},{"ref":"Job.38.14","start":18038014,"end":18038014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ち"],[2,1,"いん"],[7,1,"つち"],[12,1,"かわ"],[15,1,"ころも"]],"text":"地は印せられた土のように変り、衣のようにいろどられる。"},{"ref":"Job.38.15","start":18038015,"end":18038015,"break":"line","breaks":[[11,"line"]],"ruby":[[0,2,"あくにん"],[5,1,"ひかり"],[7,1,"うば"],[13,1,"たか"],[18,1,"うで"],[20,1,"お"]],"text":"悪人はその光を奪われ、その高くあげた腕は折られる。"},{"ref":"Job.38.16","start":18038016,"end":18038016,"break":"stanza","breaks":[[18,"line"]],"ruby":[[4,1,"うみ"],[6,1,"みなもと"],[8,1,"い"],[18,1,"ふち"],[20,1,"そこ"],[22,1,"ある"]],"text":"あなたは海の源に行ったことがあるか。淵の底を歩いたことがあるか。"},{"ref":"Job.38.17","start":18038017,"end":18038017,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"し"],[2,1,"もん"],[11,1,"ひら"],[21,2,"あんこく"],[24,1,"もん"],[26,1,"み"]],"text":"死の門はあなたのために開かれたか。あなたは暗黒の門を見たことがあるか。"},{"ref":"Job.38.18","start":18038018,"end":18038018,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"ち"],[6,1,"ひろ"],[9,1,"み"],[26,1,"し"],[34,1,"い"]],"text":"あなたは地の広さを見きわめたか。もしこれをことごとく知っているならば言え。"},{"ref":"Job.38.19","start":18038019,"end":18038019,"break":"stanza","breaks":[[15,"line"]],"ruby":[[0,1,"ひかり"],[4,1,"ところ"],[6,1,"いた"],[8,1,"みち"],[15,1,"くら"],[21,1,"ところ"]],"text":"光のある所に至る道はいずれか。暗やみのある所はどこか。"},{"ref":"Job.38.20","start":18038020,"end":18038020,"break":"line","breaks":[[21,"line"]],"ruby":[[9,1,"さかい"],[11,1,"みちび"],[23,2,"いえじ"],[26,1,"し"]],"text":"あなたはこれをその境に導くことができるか。その家路を知っているか。"},{"ref":"Job.38.21","start":18038021,"end":18038021,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[4,1,"し"],[19,1,"とき"],[23,1,"うま"],[35,1,"ひ"],[36,1,"かず"],[38,1,"おお"]],"text":"あなたは知っているだろう、あなたはかの時すでに生れており、またあなたの日数も多いのだから。"},{"ref":"Job.38.22","start":18038022,"end":18038022,"break":"stanza","breaks":[[19,"line"]],"ruby":[[4,1,"ゆき"],[6,1,"くら"],[23,1,"くら"],[25,1,"み"]],"text":"あなたは雪の倉にはいったことがあるか。ひょうの倉を見たことがあるか。"},{"ref":"Job.38.23","start":18038023,"end":18038023,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"なや"],[7,1,"とき"],[16,1,"たたか"],[19,1,"ひ"],[33,1,"お"]],"text":"これらは悩みの時のため、いくさと戦いの日のため、わたしがたくわえて置いたものだ。"},{"ref":"Job.38.24","start":18038024,"end":18038024,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"ひかり"],[2,1,"ひろ"],[5,1,"みち"],[11,2,"ひがしかぜ"],[14,1,"ち"],[16,1,"ふ"],[18,1,"わた"],[20,1,"みち"]],"text":"光の広がる道はどこか。東風の地に吹き渡る道はどこか。"},{"ref":"Job.38.25","start":18038025,"end":18038025,"break":"line","breaks":[[17,"line"]],"ruby":[[3,2,"おおあめ"],[9,2,"すいろ"],[12,1,"き"],[14,1,"ひら"],[22,1,"ひかり"],[27,1,"みち"],[29,1,"ひら"]],"text":"だれが大雨のために水路を切り開き、いかずちの光のために道を開き、"},{"ref":"Job.38.26","start":18038026,"end":18038026,"break":"line","ruby":[[0,1,"ひと"],[3,1,"ち"],[7,1,"ひと"],[10,2,"あらの"],[14,1,"あめ"],[16,1,"ふ"]],"text":"人なき地にも、人なき荒野にも雨を降らせ、"},{"ref":"Job.38.27","start":18038027,"end":18038027,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"あ"],[6,1,"ち"],[10,1,"た"],[17,2,"わかくさ"]],"text":"荒れすたれた地をあき足らせ、これに若草をはえさせるか。"},{"ref":"Job.38.28","start":18038028,"end":18038028,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"あめ"],[2,1,"ちち"],[8,1,"つゆ"],[10,1,"たま"],[15,1,"う"]],"text":"雨に父があるか。露の玉はだれが生んだか。"},{"ref":"Job.38.29","start":18038029,"end":18038029,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"こおり"],[5,1,"たい"],[8,1,"で"],[12,1,"そら"],[14,1,"しも"],[19,1,"う"]],"text":"氷はだれの胎から出たか。空の霜はだれが生んだか。"},{"ref":"Job.38.30","start":18038030,"end":18038030,"break":"line","ruby":[[0,1,"みず"],[2,1,"かた"],[6,1,"いし"],[14,1,"ふち"],[20,1,"こお"]],"text":"水は固まって石のようになり、淵のおもては凍る。"},{"ref":"Job.38.31","start":18038031,"end":18038031,"break":"stanza","breaks":[[22,"line"]],"ruby":[[10,1,"くさり"],[12,1,"むす"],[27,1,"つな"],[29,1,"と"]],"text":"あなたはプレアデスの鎖を結ぶことができるか。オリオンの綱を解くことができるか。"},{"ref":"Job.38.32","start":18038032,"end":18038032,"break":"line","breaks":[[17,"line"],[29,"line"]],"ruby":[[6,1,"きゅう"],[10,1,"とき"],[17,1,"ひ"],[19,1,"だ"],[29,2,"ほくと"],[34,1,"こ"],[35,1,"ぼし"],[37,1,"みちび"]],"text":"あなたは十二宮をその時にしたがって引き出すことができるか。北斗とその子星を導くことができるか。"},{"ref":"Job.38.33","start":18038033,"end":18038033,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"てん"],[6,2,"ほうそく"],[9,1,"し"],[22,1,"ち"],[24,1,"ほどこ"]],"text":"あなたは天の法則を知っているか、そのおきてを地に施すことができるか。"},{"ref":"Job.38.34","start":18038034,"end":18038034,"break":"stanza","breaks":[[11,"line"]],"ruby":[[4,1,"こえ"],[6,1,"くも"],[11,1,"おお"],[14,1,"みず"]],"text":"あなたは声を雲にあげ、多くの水にあなたをおおわせることができるか。"},{"ref":"Job.38.35","start":18038035,"end":18038035,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[14,1,"い"],[36,1,"い"]],"text":"あなたはいなずまをつかわして行かせ、『われわれはここにいる』と、あなたに言わせることができるか。"},{"ref":"Job.38.36","start":18038036,"end":18038036,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"くも"],[2,2,"ちえ"],[5,1,"お"],[8,1,"きり"],[10,1,"さと"],[13,1,"あた"]],"text":"雲に知恵を置き、霧に悟りを与えたのはだれか。"},{"ref":"Job.38.37","start":18038037,"end":18038037,"break":"line","breaks":[[22,"line"]],"ruby":[[3,2,"ちえ"],[9,1,"くも"],[11,1,"かぞ"],[25,1,"てん"],[27,1,"かわ"],[28,1,"ぶくろ"],[30,1,"かたむ"]],"text":"だれが知恵をもって雲を数えることができるか。だれが天の皮袋を傾けて、"},{"ref":"Job.38.38","start":18038038,"end":18038038,"break":"line","breaks":[[13,"line"]],"ruby":[[6,1,"なが"],[8,1,"あ"],[13,1,"つち"],[17,1,"かた"]],"text":"ちりを一つに流れ合わさせ、土くれを固まらせることができるか。"},{"ref":"Job.38.39","start":18038039,"end":18038039,"break":"stanza","breaks":[[16,"line"]],"ruby":[[10,2,"しょくもつ"],[13,1,"か"],[16,1,"こ"],[20,2,"しょくよく"],[23,1,"み"]],"text":"あなたはししのために食物を狩り、子じしの食欲を満たすことができるか。"},{"ref":"Job.38.40","start":18038040,"end":18038040,"break":"line","breaks":[[10,"line"],[23,"line"]],"ruby":[[0,1,"かれ"],[5,1,"あな"],[7,1,"ふ"],[10,1,"はやし"],[15,1,"ま"],[17,1,"ぶ"],[21,1,"とき"],[29,1,"こと"]],"text":"彼らがほら穴に伏し、林のなかに待ち伏せする時、あなたはこの事をなすことができるか。"},{"ref":"Job.38.41","start":18038041,"end":18038041,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[4,1,"こ"],[6,1,"かみ"],[8,1,"む"],[12,1,"よ"],[17,2,"しょくもつ"],[38,1,"あた"],[41,1,"もの"]],"text":"からすの子が神に向かって呼ばわり、食物がなくて、さまようとき、からすにえさを与える者はだれか。"}]