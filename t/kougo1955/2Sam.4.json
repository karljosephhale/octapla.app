[{"ref":"2Sam.4.1","start":10004001,"end":10004001,"break":"paragraph","ruby":[[4,1,"こ"],[22,1,"し"],[28,1,"き"],[34,1,"ちから"],[36,1,"うしな"],[45,1,"みな"]],"text":"サウルの子イシボセテは、アブネルがヘブロンで死んだことを聞いて、その力を失い、イスラエルは皆あわてた。"},{"ref":"2Sam.4.2","start":10004002,"end":10004002,"break":"none","ruby":[[4,1,"こ"],[16,2,"りゃくだつ"],[18,1,"たい"],[20,2,"たいちょう"],[31,1,"な"],[37,1,"た"],[43,1,"な"],[59,2,"しそん"],[74,1,"こ"],[101,1,"かぞ"]],"text":"サウルの子イシボセテにはふたりの略奪隊の隊長があった。ひとりの名はバアナ、他のひとりの名はレカブといって、ベニヤミンの子孫であるベロテびとリンモンの子たちであった。（それはベロテもまたベニヤミンのうちに数えられているからである。"},{"ref":"2Sam.4.3","start":10004003,"end":10004003,"break":"none","ruby":[[12,1,"に"],[19,2,"こんにち"],[25,1,"ところ"],[27,2,"きりゅう"]],"text":"ベロテびとはギッタイムに逃げていって、今日までその所に寄留している）。"},{"ref":"2Sam.4.4","start":10004004,"end":10004004,"break":"paragraph","ruby":[[6,1,"こ"],[12,1,"あし"],[17,1,"こ"],[41,1,"こと"],[43,1,"し"],[49,1,"とき"],[51,1,"かれ"],[54,1,"さい"],[63,1,"かれ"],[65,1,"だ"],[68,1,"に"],[73,1,"いそ"],[76,1,"に"],[79,1,"とき"],[83,1,"こ"],[85,1,"お"],[88,1,"あし"],[98,1,"な"]],"text":"さてサウルの子ヨナタンに足のなえた子がひとりあった。エズレルからサウルとヨナタンの事の知らせがきた時、彼は五歳であった。うばが彼を抱いて逃げたが、急いで逃げる時、その子は落ちて足なえとなった。その名はメピボセテといった。"},{"ref":"2Sam.4.5","start":10004005,"end":10004005,"break":"paragraph","ruby":[[10,1,"こ"],[23,2,"しゅったつ"],[28,1,"ひ"],[30,1,"あつ"],[40,1,"いえ"],[52,2,"ひるね"]],"text":"ベロテびとリンモンの子たち、レカブとバアナとは出立して、日の暑いころイシボセテの家にきたが、イシボセテは昼寝をしていた。"},{"ref":"2Sam.4.6","start":10004006,"end":10004006,"break":"none","ruby":[[0,1,"いえ"],[2,1,"もん"],[4,1,"まも"],[6,1,"おんな"],[8,1,"むぎ"],[13,1,"わ"],[20,1,"ねむ"],[25,1,"ね"],[41,2,"きょうだい"],[52,1,"なか"]],"text":"家の門を守る女は麦をあおぎ分けていたが、眠くなって寝てしまった。そこでレカブとその兄弟バアナは、ひそかに中にはいった。"},{"ref":"2Sam.4.7","start":10004007,"end":10004007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"いえ"],[9,1,"とき"],[17,2,"しんしつ"],[20,1,"ゆか"],[22,1,"うえ"],[24,1,"ね"],[31,1,"かれ"],[37,1,"う"],[40,1,"ころ"],[45,1,"くび"],[52,1,"くび"],[54,1,"と"],[67,1,"みち"],[69,1,"い"]],"text":"彼らが家にはいった時、イシボセテは寝室で床の上に寝ていたので、彼らはそれを撃って殺し、その首をはね、その首を取って、よもすがらアラバの道を行き、"},{"ref":"2Sam.4.8","start":10004008,"end":10004008,"break":"none","ruby":[[6,1,"くび"],[22,1,"たずさ"],[25,1,"い"],[28,1,"おう"],[30,1,"い"],[39,1,"いのち"],[41,1,"もと"],[48,1,"てき"],[53,1,"こ"],[60,1,"くび"],[64,1,"しゅ"],[72,1,"きみ"],[74,1,"おう"],[89,2,"ほうふく"]],"text":"イシボセテの首をヘブロンにいるダビデのもとに携えて行って王に言った、「あなたの命を求めたあなたの敵サウルの子イシボセテの首です。主はきょう、わが君、王のためにサウルとそのすえとに報復されました」。"},{"ref":"2Sam.4.9","start":10004009,"end":10004009,"break":"none","ruby":[[14,1,"こ"],[21,2,"きょうだい"],[27,1,"こた"],[36,1,"いのち"],[44,2,"くなん"],[48,1,"すく"],[52,1,"しゅ"],[54,1,"い"]],"text":"ダビデはベロテびとリンモンの子レカブとその兄弟バアナに答えた、「わたしの命を、もろもろの苦難から救われた主は生きておられる。"},{"ref":"2Sam.4.10","start":10004010,"end":10004010,"break":"none","ruby":[[8,1,"ひと"],[14,1,"つ"],[19,1,"み"],[26,1,"し"],[31,1,"い"],[39,1,"よ"],[46,1,"つた"],[49,1,"もの"],[51,1,"おも"],[56,1,"もの"],[58,1,"とら"],[66,1,"ころ"],[76,1,"むく"]],"text":"わたしはかつて、人がわたしに告げて、『見よ、サウルは死んだ』と言って、みずから良いおとずれを伝える者と思っていた者を捕えてチクラグで殺し、そのおとずれに報いたのだ。"},{"ref":"2Sam.4.11","start":10004011,"end":10004011,"break":"none","ruby":[[0,2,"あくにん"],[3,1,"ただ"],[6,1,"ひと"],[10,1,"いえ"],[12,1,"ゆか"],[14,1,"うえ"],[16,1,"ころ"],[32,1,"いま"],[38,1,"かれ"],[40,1,"ち"],[42,1,"なが"],[45,1,"つみ"],[47,1,"むく"],[59,1,"ち"],[62,1,"た"],[64,1,"ほろ"]],"text":"悪人が正しい人をその家の床の上で殺したときは、なおさらのことだ。今わたしが、彼の血を流した罪を報い、あなたがたを、この地から絶ち滅ぼさないでおくであろうか」。"},{"ref":"2Sam.4.12","start":10004012,"end":10004012,"break":"none","ruby":[[7,2,"わかもの"],[12,1,"めい"],[18,2,"わかもの"],[23,1,"かれ"],[26,1,"ころ"],[31,2,"てあし"],[34,1,"き"],[36,1,"はな"],[44,1,"いけ"],[50,1,"き"],[52,1,"か"],[56,2,"ひとびと"],[65,1,"くび"],[67,1,"も"],[70,1,"い"],[86,1,"はか"],[88,1,"ほうむ"]],"text":"そしてダビデは若者たちに命じたので、若者たちは彼らを殺し、その手足を切り離し、ヘブロンの池のほとりで木に掛けた。人々はイシボセテの首を持って行って、ヘブロンにあるアブネルの墓に葬った。"}]