[{"ref":"Zech.8.1","start":38008001,"end":38008001,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,2,"ことば"],[12,1,"のぞ"]],"text":"万軍の主の言葉がわたしに臨んだ、"},{"ref":"Zech.8.2","start":38008002,"end":38008002,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[9,1,"おお"],[28,1,"おお"],[36,1,"おこ"],[48,1,"おお"],[52,1,"いきどお"]],"text":"「万軍の主は、こう仰せられる、『わたしはシオンのために、大いなるねたみを起し、またこれがために、大いなる憤りをもってねたむ』。"},{"ref":"Zech.8.3","start":38008003,"end":38008003,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"おお"],[19,1,"かえ"],[29,1,"なか"],[31,1,"す"],[40,2,"ちゅうしん"],[43,1,"まち"],[51,2,"ばんぐん"],[54,1,"しゅ"],[56,1,"やま"],[58,1,"せい"],[61,1,"やま"]],"text":"主はこう仰せられる、『わたしはシオンに帰って、エルサレムの中に住む。エルサレムは忠信な町ととなえられ、万軍の主の山は聖なる山と、となえられる』。"},{"ref":"Zech.8.4","start":38008004,"end":38008004,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[8,1,"おお"],[21,2,"がいろ"],[25,1,"ふたた"],[27,1,"お"],[30,1,"おとこ"],[32,1,"お"],[35,1,"おんな"],[37,1,"ざ"],[48,2,"としより"],[51,2,"ひとびと"],[62,1,"て"],[64,1,"も"]],"text":"万軍の主は、こう仰せられる、『エルサレムの街路には再び老いた男、老いた女が座するようになる。みな年寄の人々で、おのおのつえを手に持つ。"},{"ref":"Zech.8.5","start":38008005,"end":38008005,"break":"none","ruby":[[4,1,"まち"],[6,2,"がいろ"],[11,1,"おとこ"],[13,1,"こ"],[15,1,"おんな"],[17,1,"こ"],[19,1,"み"],[23,2,"がいろ"],[26,1,"あそ"],[28,1,"たわむ"]],"text":"またその町の街路には、男の子、女の子が満ちて、街路に遊び戯れる』。"},{"ref":"Zech.8.6","start":38008006,"end":38008006,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[8,1,"おお"],[17,1,"ひ"],[27,1,"たみ"],[29,1,"のこ"],[32,1,"もの"],[34,1,"め"],[37,3,"ふしぎ"],[41,1,"こと"],[55,1,"め"],[59,3,"ふしぎ"],[63,1,"こと"],[71,2,"ばんぐん"],[74,1,"しゅ"],[76,1,"い"]],"text":"万軍の主は、こう仰せられる、『その日には、たとい、この民の残れる者の目に、不思議な事であっても、それはわたしの目にも、不思議な事であろうか』と万軍の主は言われる。"},{"ref":"Zech.8.7","start":38008007,"end":38008007,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[8,1,"おお"],[15,1,"み"],[20,1,"たみ"],[22,1,"ひがし"],[24,1,"くに"],[30,1,"にし"],[32,1,"くに"],[35,1,"すく"],[37,1,"だ"]],"text":"万軍の主は、こう仰せられる、『見よ、わが民を東の国から、また西の国から救い出し、"},{"ref":"Zech.8.8","start":38008008,"end":38008008,"break":"none","ruby":[[0,1,"かれ"],[3,1,"つ"],[15,1,"す"],[20,1,"かれ"],[25,1,"たみ"],[34,1,"かれ"],[37,1,"かみ"],[43,1,"とも"],[45,2,"しんじつ"],[48,2,"せいぎ"],[55,1,"た"]],"text":"彼らを連れてきて、エルサレムに住まわせ、彼らはわが民となり、わたしは彼らの神となって、共に真実と正義とをもって立つ』」。"},{"ref":"Zech.8.9","start":38008009,"end":38008009,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[8,1,"おお"],[15,2,"ばんぐん"],[18,1,"しゅ"],[20,1,"いえ"],[24,1,"みや"],[26,1,"た"],[35,1,"いしずえ"],[40,1,"ひ"],[48,3,"よげんしゃ"],[54,1,"くち"],[57,1,"で"],[63,2,"ことば"],[70,1,"き"],[72,1,"もの"],[81,1,"て"],[83,1,"つよ"]],"text":"万軍の主は、こう仰せられる、「万軍の主の家である宮を建てるために、その礎をすえた日からこのかた、預言者たちの口から出たこれらの言葉を、きょう聞く者よ、あなたがたの手を強くせよ。"},{"ref":"Zech.8.10","start":38008010,"end":38008010,"break":"none","ruby":[[2,1,"ひ"],[4,2,"いぜん"],[9,1,"ひと"],[11,1,"はたら"],[14,1,"あたい"],[16,1,"え"],[19,1,"けもの"],[21,1,"はたら"],[24,1,"あたい"],[26,1,"え"],[31,1,"で"],[33,1,"もの"],[38,1,"もの"],[47,2,"あんぜん"],[62,2,"ひとびと"],[65,1,"あい"]],"text":"この日の以前には、人も働きの価を得ず、獣も働きの価を得ず、また出る者もはいる者も、あだのために安全ではなかった。わたしはまた人々を相たがいにそむかせた。"},{"ref":"Zech.8.11","start":38008011,"end":38008011,"break":"none","ruby":[[3,1,"いま"],[12,1,"たみ"],[14,1,"のこ"],[17,1,"もの"],[19,1,"たい"],[29,1,"ひ"],[39,2,"ばんぐん"],[42,1,"しゅ"],[44,1,"い"]],"text":"しかし今は、わたしのこの民の残れる者に対することは、さきの日のようではないと、万軍の主は言われる。"},{"ref":"Zech.8.12","start":38008012,"end":38008012,"break":"none","ruby":[[5,2,"へいわ"],[8,2,"はんえい"],[12,1,"たね"],[32,1,"き"],[34,1,"み"],[36,1,"むす"],[39,1,"ち"],[41,2,"さんぶつ"],[44,1,"だ"],[47,1,"てん"],[49,1,"つゆ"],[51,1,"あた"],[61,1,"たみ"],[63,1,"のこ"],[66,1,"もの"],[77,1,"あた"]],"text":"そこには、平和と繁栄との種がまかれるからである。すなわちぶどうの木は実を結び、地は産物を出し、天は露を与える。わたしはこの民の残れる者に、これをことごとく与える。"},{"ref":"Zech.8.13","start":38008013,"end":38008013,"break":"none","ruby":[[3,1,"いえ"],[13,1,"いえ"],[23,2,"くにぐに"],[26,1,"たみ"],[28,1,"なか"],[54,1,"すく"],[57,2,"しゅくふく"],[63,1,"おそ"],[78,1,"て"],[80,1,"つよ"]],"text":"ユダの家およびイスラエルの家よ、あなたがたが、国々の民の中に、のろいとなっていたように、わたしはあなたがたを救って祝福とする。恐れてはならない。あなたがたの手を強くせよ」。"},{"ref":"Zech.8.14","start":38008014,"end":38008014,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[8,1,"おお"],[21,2,"せんぞ"],[29,1,"いか"],[33,1,"とき"],[36,1,"わざわい"],[38,1,"くだ"],[42,1,"おも"],[61,2,"ばんぐん"],[64,1,"しゅ"],[66,1,"い"]],"text":"万軍の主は、こう仰せられる、「あなたがたの先祖が、わたしを怒らせた時に、災を下そうと思って、これをやめなかったように、――万軍の主は言われる――"},{"ref":"Zech.8.15","start":38008015,"end":38008015,"break":"none","ruby":[[12,2,"こんにち"],[24,1,"いえ"],[26,1,"めぐ"],[29,1,"あた"],[34,1,"おそ"]],"text":"そのように、わたしはまた今日、エルサレムとユダの家に恵みを与えよう。恐れてはならない。"},{"ref":"Zech.8.16","start":38008016,"end":38008016,"break":"none","ruby":[[10,1,"こと"],[24,1,"たがい"],[26,2,"しんじつ"],[29,1,"かた"],[40,1,"もん"],[43,2,"しんじつ"],[46,2,"へいわ"],[55,1,"おこな"]],"text":"あなたがたのなすべき事はこれである。あなたがたは互に真実を語り、またあなたがたの門で、真実と平和のさばきとを、行わなければならない。"},{"ref":"Zech.8.17","start":38008017,"end":38008017,"break":"none","ruby":[[7,1,"たがい"],[9,1,"ひと"],[11,1,"がい"],[18,1,"こころ"],[20,1,"はか"],[29,1,"いつわ"],[32,1,"ちか"],[35,1,"この"],[52,1,"こと"],[54,1,"にく"],[63,1,"しゅ"],[65,1,"い"]],"text":"あなたがたは、互に人を害することを、心に図ってはならない。偽りの誓いを好んではならない。わたしはこれらの事を憎むからであると、主は言われる」。"},{"ref":"Zech.8.18","start":38008018,"end":38008018,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,2,"ことば"],[12,1,"のぞ"]],"text":"万軍の主の言葉がわたしに臨んだ、"},{"ref":"Zech.8.19","start":38008019,"end":38008019,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[9,1,"おお"],[16,1,"がつ"],[18,2,"だんじき"],[23,1,"がつ"],[25,2,"だんじき"],[30,1,"がつ"],[32,2,"だんじき"],[37,1,"がつ"],[39,2,"だんじき"],[47,1,"いえ"],[49,1,"よろこ"],[51,1,"たの"],[55,1,"とき"],[62,1,"いわい"],[64,1,"とき"],[79,2,"しんじつ"],[82,2,"へいわ"],[86,1,"あい"]],"text":"「万軍の主は、こう仰せられる、四月の断食と、五月の断食と、七月の断食と、十月の断食とは、ユダの家の喜び楽しみの時となり、よき祝の時となる。ゆえにあなたがたは、真実と平和とを愛せよ。"},{"ref":"Zech.8.20","start":38008020,"end":38008020,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[8,1,"おお"],[19,1,"たみ"],[23,1,"おお"],[26,1,"まち"],[28,2,"じゅうみん"],[39,1,"まち"],[41,2,"じゅうみん"],[45,1,"た"],[47,1,"まち"],[49,2,"ひとびと"],[56,1,"い"]],"text":"万軍の主は、こう仰せられる、もろもろの民および多くの町の住民、すなわち、一つの町の住民は、他の町の人々のところに行き、"},{"ref":"Zech.8.21","start":38008021,"end":38008021,"break":"none","ruby":[[11,1,"い"],[15,1,"しゅ"],[17,1,"めぐ"],[20,1,"こ"],[23,2,"ばんぐん"],[26,1,"しゅ"],[28,1,"よ"],[30,1,"もと"],[36,1,"い"],[45,1,"い"],[50,1,"い"]],"text":"『われわれは、ただちに行って、主の恵みを請い、万軍の主に呼び求めよう』と言うと、『わたしも行こう』と言う。"},{"ref":"Zech.8.22","start":38008022,"end":38008022,"break":"none","ruby":[[0,1,"おお"],[3,1,"たみ"],[7,1,"つよ"],[9,2,"こくみん"],[18,1,"き"],[21,2,"ばんぐん"],[24,1,"しゅ"],[26,1,"もと"],[29,1,"しゅ"],[31,1,"めぐ"],[34,1,"こ"]],"text":"多くの民および強い国民はエルサレムに来て、万軍の主を求め、主の恵みを請う。"},{"ref":"Zech.8.23","start":38008023,"end":38008023,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[8,1,"おお"],[16,1,"ひ"],[25,1,"くに"],[30,1,"たみ"],[32,1,"なか"],[36,1,"にん"],[38,1,"もの"],[48,1,"ひと"],[50,1,"ころも"],[68,2,"いっしょ"],[71,1,"い"],[75,1,"かみ"],[83,1,"とも"],[91,1,"き"],[98,1,"い"]],"text":"万軍の主は、こう仰せられる、その日には、もろもろの国ことばの民の中から十人の者が、ひとりのユダヤ人の衣のすそをつかまえて、『あなたがたと一緒に行こう。神があなたがたと共にいますことを聞いたから』と言う」。"}]