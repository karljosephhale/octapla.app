[{"ref":"Jer.29.1","start":24029001,"end":24029001,"break":"paragraph","ruby":[[3,3,"よげんしゃ"],[21,1,"とら"],[23,1,"うつ"],[27,2,"ちょうろう"],[58,1,"とら"],[60,1,"うつ"],[64,2,"さいし"],[67,3,"よげんしゃ"],[78,1,"たみ"],[80,1,"おく"],[83,2,"てがみ"],[86,1,"か"],[92,2,"ことば"]],"text":"これは預言者エレミヤがエルサレムから、かの捕え移された長老たち、およびネブカデネザルによってエルサレムからバビロンに捕え移された祭司と預言者ならびにすべての民に送った手紙に書きしるした言葉である。"},{"ref":"Jer.29.2","start":24029002,"end":24029002,"break":"none","ruby":[[7,1,"おう"],[9,2,"たいこう"],[12,2,"かんがん"],[35,2,"こうしょう"],[38,2,"かじ"],[48,1,"さ"],[54,1,"か"]],"text":"それはエコニヤ王と太后と宦官およびユダとエルサレムのつかさたち、および工匠と鍛冶とがエルサレムを去ってのちに書かれたものであって、"},{"ref":"Jer.29.3","start":24029003,"end":24029003,"break":"none","ruby":[[7,2,"てがみ"],[15,1,"こ"],[27,1,"こ"],[33,1,"て"],[38,1,"おく"],[44,2,"ひとびと"],[50,1,"おう"],[61,1,"い"],[70,1,"おう"],[96,2,"てがみ"],[100,1,"つぎ"],[105,1,"か"]],"text":"エレミヤはその手紙をシャパンの子エラサおよびヒルキヤの子ゲマリヤの手によって送った。この人々はユダの王ゼデキヤがバビロンに行かせ、バビロンの王ネブカデネザルのもとにつかわしたものであった。その手紙には次のように書いてあった。"},{"ref":"Jer.29.4","start":24029004,"end":24029004,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[12,1,"かみ"],[18,1,"とら"],[20,1,"うつ"],[24,1,"もの"],[48,1,"とら"],[50,1,"うつ"],[54,1,"もの"],[59,1,"い"]],"text":"「万軍の主、イスラエルの神は、すべて捕え移された者、すなわち、わたしがエルサレムから、バビロンに捕え移させた者に、こう言う、"},{"ref":"Jer.29.5","start":24029005,"end":24029005,"break":"none","ruby":[[6,1,"いえ"],[8,1,"た"],[15,1,"す"],[18,1,"はたけ"],[20,1,"つく"],[25,2,"さんぶつ"],[28,1,"た"]],"text":"あなたがたは家を建てて、それに住み、畑を作ってその産物を食べよ。"},{"ref":"Jer.29.6","start":24029006,"end":24029006,"break":"none","ruby":[[0,1,"つま"],[10,1,"むすめ"],[12,1,"う"],[24,1,"よめ"],[30,1,"むすめ"],[41,1,"むすめ"],[43,1,"う"],[53,1,"ところ"],[61,1,"かず"],[63,1,"ま"],[66,1,"へ"]],"text":"妻をめとって、むすこ娘を産み、また、そのむすこに嫁をめとり、娘をとつがせて、むすこ娘を産むようにせよ。その所であなたがたの数を増し、減ってはならない。"},{"ref":"Jer.29.7","start":24029007,"end":24029007,"break":"none","ruby":[[10,1,"とら"],[12,1,"うつ"],[20,1,"まち"],[22,2,"へいあん"],[25,1,"もと"],[33,1,"しゅ"],[35,1,"いの"],[43,1,"まち"],[45,2,"へいあん"],[58,2,"へいあん"],[61,1,"え"]],"text":"わたしがあなたがたを捕え移させたところの町の平安を求め、そのために主に祈るがよい。その町が平安であれば、あなたがたも平安を得るからである。"},{"ref":"Jer.29.8","start":24029008,"end":24029008,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[15,1,"い"],[31,3,"よげんしゃ"],[35,1,"うらな"],[37,1,"し"],[39,1,"まど"],[52,1,"かれ"],[55,1,"み"],[57,1,"ゆめ"],[59,1,"き"],[61,1,"したが"]],"text":"万軍の主、イスラエルの神はこう言われる、あなたがたのうちにいる預言者と占い師に惑わされてはならない。また彼らの見る夢に聞き従ってはならない。"},{"ref":"Jer.29.9","start":24029009,"end":24029009,"break":"none","ruby":[[4,1,"かれ"],[11,1,"な"],[22,1,"いつわ"],[25,2,"よげん"],[41,1,"かれ"],[55,1,"しゅ"],[57,1,"い"]],"text":"それは、彼らがわたしの名によってあなたがたに偽りを預言しているからである。わたしが彼らをつかわしたのではないと主は言われる。"},{"ref":"Jer.29.10","start":24029010,"end":24029010,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"い"],[16,1,"ねん"],[18,1,"み"],[35,1,"かえり"],[42,2,"やくそく"],[45,1,"はた"],[56,1,"ところ"],[58,1,"みちび"],[60,1,"かえ"]],"text":"主はこう言われる、バビロンで七十年が満ちるならば、わたしはあなたがたを顧み、わたしの約束を果し、あなたがたをこの所に導き帰る。"},{"ref":"Jer.29.11","start":24029011,"end":24029011,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[17,1,"たい"],[26,2,"けいかく"],[33,1,"し"],[42,1,"わざわい"],[44,1,"あた"],[57,2,"へいあん"],[60,1,"あた"],[79,2,"しょうらい"],[82,1,"あた"],[85,2,"きぼう"],[88,1,"あた"]],"text":"主は言われる、わたしがあなたがたに対していだいている計画はわたしが知っている。それは災を与えようというのではなく、平安を与えようとするものであり、あなたがたに将来を与え、希望を与えようとするものである。"},{"ref":"Jer.29.12","start":24029012,"end":24029012,"break":"none","ruby":[[2,1,"とき"],[14,1,"よ"],[19,1,"き"],[26,1,"いの"],[39,1,"いのり"],[41,1,"き"]],"text":"その時、あなたがたはわたしに呼ばわり、来て、わたしに祈る。わたしはあなたがたの祈を聞く。"},{"ref":"Jer.29.13","start":24029013,"end":24029013,"break":"none","ruby":[[10,1,"たず"],[12,1,"もと"],[20,1,"あ"],[31,2,"いっしん"],[38,1,"たず"],[40,1,"もと"]],"text":"あなたがたはわたしを尋ね求めて、わたしに会う。もしあなたがたが一心にわたしを尋ね求めるならば、"},{"ref":"Jer.29.14","start":24029014,"end":24029014,"break":"none","ruby":[[10,1,"あ"],[13,1,"しゅ"],[15,1,"い"],[30,2,"はんえい"],[33,2,"かいふく"],[43,2,"ばんこく"],[61,1,"お"],[66,1,"ところ"],[69,1,"あつ"],[85,1,"とら"],[88,1,"はな"],[98,1,"ところ"],[107,1,"みちび"],[109,1,"かえ"],[113,1,"しゅ"],[115,1,"い"]],"text":"わたしはあなたがたに会うと主は言われる。わたしはあなたがたの繁栄を回復し、あなたがたを万国から、すべてわたしがあなたがたを追いやった所から集め、かつ、わたしがあなたがたを捕われ離れさせたそのもとの所に、あなたがたを導き帰ろうと主は言われる。"},{"ref":"Jer.29.15","start":24029015,"end":24029015,"break":"paragraph","ruby":[[8,1,"しゅ"],[23,3,"よげんしゃ"],[29,1,"おこ"],[35,1,"い"]],"text":"あなたがたは、『主はバビロンでわれわれのために預言者たちを起された』と言ったが、――"},{"ref":"Jer.29.16","start":24029016,"end":24029016,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"くらい"],[8,1,"ざ"],[13,1,"おう"],[18,1,"まち"],[20,1,"す"],[26,1,"たみ"],[35,1,"とも"],[37,1,"とら"],[39,1,"うつ"],[46,2,"きょうだい"],[57,1,"い"]],"text":"主はダビデの位に座している王と、この町に住むすべての民で、あなたがたと共に捕え移されなかった兄弟たちについて、こう言われる、"},{"ref":"Jer.29.17","start":24029017,"end":24029017,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[8,1,"い"],[13,1,"み"],[31,2,"えきびょう"],[34,1,"かれ"],[37,1,"おく"],[40,1,"かれ"],[43,1,"わる"],[46,1,"た"],[52,1,"くさ"]],"text":"『万軍の主はこう言われる、見よ、わたしは、つるぎと、ききんと、疫病を彼らに送り、彼らを悪くて食べられない腐ったいちじくのようにしてしまう。"},{"ref":"Jer.29.18","start":24029018,"end":24029018,"break":"none","ruby":[[14,2,"えきびょう"],[20,1,"かれ"],[26,1,"お"],[31,1,"かれ"],[34,1,"ち"],[36,2,"ばんこく"],[39,1,"い"],[56,1,"かれ"],[59,1,"お"],[63,2,"くにぐに"],[74,1,"おそ"],[80,2,"ものわら"]],"text":"わたしはつるぎと、ききんと、疫病をもって彼らのあとを追い、また彼らを地の万国に忌みきらわれるものとなし、わたしが彼らを追いやる国々で、のろいとなり、恐れとなり、物笑いとなり、はずかしめとならせる。"},{"ref":"Jer.29.19","start":24029019,"end":24029019,"break":"none","ruby":[[3,1,"かれ"],[10,2,"ことば"],[13,1,"き"],[15,1,"したが"],[27,1,"しゅ"],[29,1,"い"],[40,2,"ことば"],[54,3,"よげんしゃ"],[68,1,"おく"],[79,1,"き"],[90,1,"しゅ"],[92,1,"い"]],"text":"それは彼らがわたしの言葉に聞き従わなかったからであると主は言われる。わたしはこの言葉を、わたしのしもべである預言者たちによって、しきりに送ったが、あなたがたは聞こうともしなかったと主は言われる』。――"},{"ref":"Jer.29.20","start":24029020,"end":24029020,"break":"none","ruby":[[16,1,"おく"],[28,1,"とら"],[31,1,"びと"],[34,1,"しゅ"],[36,2,"ことば"],[39,1,"き"]],"text":"わたしがエルサレムからバビロンに送ったあなたがたすべての捕われ人よ、主の言葉を聞きなさい、"},{"ref":"Jer.29.21","start":24029021,"end":24029021,"break":"none","ruby":[[5,1,"な"],[17,1,"いつわ"],[20,2,"よげん"],[30,1,"こ"],[41,1,"こ"],[50,2,"ばんぐん"],[53,1,"しゅ"],[61,1,"かみ"],[65,1,"おお"],[71,1,"み"],[78,1,"かれ"],[86,1,"おう"],[95,1,"て"],[97,1,"わた"],[100,1,"おう"],[108,1,"め"],[110,1,"まえ"],[112,1,"かれ"],[115,1,"ころ"]],"text":"『わたしの名によって、あなたがたに偽りを預言しているコラヤの子アハブと、マアセヤの子ゼデキヤについて万軍の主、イスラエルの神はこう仰せられる、見よ、わたしは彼らをバビロンの王ネブカデレザルの手に渡す。王はあなたがたの目の前で彼らを殺す。"},{"ref":"Jer.29.22","start":24029022,"end":24029022,"break":"none","ruby":[[10,1,"とら"],[13,1,"びと"],[15,1,"みな"],[17,1,"かれ"],[20,1,"な"],[27,2,"ことば"],[30,1,"もち"],[35,1,"しゅ"],[46,1,"おう"],[48,1,"ひ"],[50,1,"や"]],"text":"バビロンにいるユダの捕われ人は皆、彼らの名を、のろいの言葉に用いて、「主があなたをバビロンの王が火で焼いたゼデキヤとアハブのようにされるように」という。"},{"ref":"Jer.29.23","start":24029023,"end":24029023,"break":"none","ruby":[[4,1,"かれ"],[16,1,"おろ"],[19,1,"こと"],[23,1,"となり"],[25,1,"つま"],[27,2,"ふぎ"],[30,1,"おこな"],[37,1,"めい"],[44,1,"いつわ"],[47,2,"ことば"],[55,1,"な"],[60,1,"かた"],[80,1,"し"],[90,2,"しょうにん"],[96,1,"しゅ"],[98,1,"い"]],"text":"それは、彼らがイスラエルのうちで愚かな事をし、隣の妻と不義を行い、わたしが命じたのでない偽りの言葉を、わたしの名によって語ったことによるのである。わたしはそれを知っており、またその証人であると主は言われる』」。"},{"ref":"Jer.29.24","start":24029024,"end":24029024,"break":"paragraph","ruby":[[14,1,"い"]],"text":"ネヘラムびとシマヤにあなたは言いなさい、"},{"ref":"Jer.29.25","start":24029025,"end":24029025,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[12,1,"かみ"],[16,1,"おお"],[26,2,"じぶん"],[29,1,"な"],[43,1,"たみ"],[51,1,"こ"],[52,2,"さいし"],[65,2,"さいし"],[68,2,"てがみ"],[71,1,"おく"],[74,1,"い"]],"text":"「万軍の主、イスラエルの神はこう仰せられる、あなたは自分の名でエルサレムにいるすべての民と、マアセヤの子祭司ゼパニヤおよびすべての祭司に手紙を送って言う、"},{"ref":"Jer.29.26","start":24029026,"end":24029026,"break":"none","ruby":[[1,1,"しゅ"],[3,2,"さいし"],[10,1,"かわ"],[17,2,"さいし"],[22,1,"しゅ"],[24,1,"みや"],[36,1,"くる"],[41,2,"よげん"],[45,1,"もの"],[47,1,"あし"],[51,1,"くび"]],"text":"『主は祭司エホヤダに代ってあなたを祭司とし、主の宮をつかさどらせ、すべて狂い、かつ預言する者を足かせと首かせにつながせられる。"},{"ref":"Jer.29.27","start":24029027,"end":24029027,"break":"none","ruby":[[23,2,"よげん"],[39,1,"いまし"]],"text":"そうであるのに、どうしてあなたは、あなたがたに預言しているアナトテのエレミヤを戒めないのか。"},{"ref":"Jer.29.28","start":24029028,"end":24029028,"break":"none","ruby":[[0,1,"かれ"],[14,1,"ところ"],[16,2,"てがみ"],[19,1,"おく"],[23,1,"とら"],[27,1,"とき"],[31,1,"なが"],[42,1,"いえ"],[44,1,"た"],[50,1,"す"],[53,1,"はたけ"],[55,1,"つく"],[60,2,"さんぶつ"],[63,1,"た"],[67,1,"い"]],"text":"彼はバビロンにいるわれわれの所に手紙を送って、捕われの時はなお長いゆえ、あなたがたは家を建ててそこに住み、畑を作ってその産物を食べよと言ってきた』」。"},{"ref":"Jer.29.29","start":24029029,"end":24029029,"break":"paragraph","ruby":[[0,2,"さいし"],[9,2,"てがみ"],[12,3,"よげんしゃ"],[20,1,"よ"],[22,1,"き"]],"text":"祭司ゼパニヤはこの手紙を預言者エレミヤに読み聞かせた。"},{"ref":"Jer.29.30","start":24029030,"end":24029030,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,2,"ことば"],[14,1,"のぞ"]],"text":"その時、主の言葉がエレミヤに臨んだ、"},{"ref":"Jer.29.31","start":24029031,"end":24029031,"break":"none","ruby":[[5,1,"とら"],[8,1,"びと"],[10,1,"か"],[12,1,"おく"],[15,1,"い"],[31,1,"こと"],[36,1,"しゅ"],[40,1,"おお"],[65,1,"かれ"],[73,2,"よげん"],[77,1,"いつわ"],[80,1,"しん"]],"text":"「すべての捕われ人に書き送って言いなさい、ネヘラムびとシマヤの事について主はこう仰せられる、わたしはシマヤをつかわさなかったのに、彼があなたがたに預言して偽りを信じさせたので、"},{"ref":"Jer.29.32","start":24029032,"end":24029032,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"おお"],[10,1,"み"],[29,2,"しそん"],[32,1,"ばっ"],[36,1,"かれ"],[38,1,"しゅ"],[40,1,"たい"],[43,2,"はんぎゃく"],[46,1,"かた"],[52,1,"かれ"],[54,1,"ぞく"],[57,1,"もの"],[62,1,"たみ"],[67,1,"す"],[74,2,"じぶん"],[77,1,"たみ"],[79,1,"おこな"],[87,1,"よ"],[89,1,"こと"],[91,1,"み"]],"text":"主はこう仰せられる、見よ、わたしはネヘラムびとシマヤとその子孫を罰する。彼は主に対する反逆を語ったゆえ、彼に属する者で、この民のうちに住み、わたしが自分の民に行おうとしている良い事を見るものはひとりもいない」。"}]