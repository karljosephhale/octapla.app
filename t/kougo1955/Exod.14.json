[{"ref":"Exod.14.1","start":2014001,"end":2014001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Exod.14.2","start":2014002,"end":2014002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"つ"],[13,1,"ひ"],[15,1,"かえ"],[24,1,"うみ"],[27,1,"あいだ"],[37,1,"まえ"],[46,1,"まえ"],[48,2,"しゅくえい"],[70,1,"うみ"],[77,2,"しゅくえい"]],"text":"「イスラエルの人々に告げ、引き返して、ミグドルと海との間にあるピハヒロテの前、バアルゼポンの前に宿営させなさい。あなたがたはそれにむかって、海のかたわらに宿営しなければならない。"},{"ref":"Exod.14.3","start":2014003,"end":2014003,"break":"none","ruby":[[9,2,"ひとびと"],[17,1,"かれ"],[22,1,"ち"],[24,1,"まよ"],[30,2,"あらの"],[33,1,"かれ"],[36,1,"と"],[38,1,"こ"],[47,1,"い"]],"text":"パロはイスラエルの人々について、『彼らはその地で迷っている。荒野は彼らを閉じ込めてしまった』と言うであろう。"},{"ref":"Exod.14.4","start":2014004,"end":2014004,"break":"none","ruby":[[7,1,"こころ"],[22,1,"かれ"],[28,1,"お"],[48,2,"ぐんぜい"],[51,1,"やぶ"],[54,1,"ほまれ"],[56,1,"え"],[69,1,"しゅ"],[76,1,"し"],[86,1,"かれ"]],"text":"わたしがパロの心をかたくなにするから、パロは彼らのあとを追うであろう。わたしはパロとそのすべての軍勢を破って誉を得、エジプトびとにわたしが主であることを知らせるであろう」。彼らはそのようにした。"},{"ref":"Exod.14.5","start":2014005,"end":2014005,"break":"paragraph","ruby":[[0,1,"たみ"],[2,1,"に"],[4,1,"さ"],[16,1,"おう"],[18,1,"つた"],[31,2,"けらい"],[38,1,"たみ"],[40,1,"たい"],[43,1,"かんが"],[46,1,"か"],[49,1,"い"],[72,1,"さ"],[82,1,"つか"]],"text":"民の逃げ去ったことが、エジプトの王に伝えられたので、パロとその家来たちとは、民に対する考えを変えて言った、「われわれはなぜこのようにイスラエルを去らせて、われわれに仕えさせないようにしたのであろう」。"},{"ref":"Exod.14.6","start":2014006,"end":2014006,"break":"none","ruby":[[6,2,"せんしゃ"],[9,1,"ととの"],[18,1,"たみ"],[20,1,"ひき"]],"text":"それでパロは戦車を整え、みずからその民を率い、"},{"ref":"Exod.14.7","start":2014007,"end":2014007,"break":"none","ruby":[[5,1,"ぬ"],[8,2,"せんしゃ"],[23,2,"せんしゃ"],[32,3,"しきしゃ"],[38,1,"ひき"]],"text":"また、えり抜きの戦車六百と、エジプトのすべての戦車およびすべての指揮者たちを率いた。"},{"ref":"Exod.14.8","start":2014008,"end":2014008,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"おう"],[11,1,"こころ"],[24,1,"かれ"],[32,2,"ひとびと"],[38,1,"お"],[48,2,"ひとびと"],[51,4,"いきようよう"],[56,1,"で"]],"text":"主がエジプトの王パロの心をかたくなにされたので、彼はイスラエルの人々のあとを追った。イスラエルの人々は意気揚々と出たのである。"},{"ref":"Exod.14.9","start":2014009,"end":2014009,"break":"none","ruby":[[7,1,"かれ"],[13,1,"お"],[23,1,"うま"],[25,2,"せんしゃ"],[32,2,"きへい"],[35,2,"ぐんぜい"],[47,1,"まえ"],[62,1,"うみ"],[69,2,"しゅくえい"],[75,1,"かれ"],[78,1,"お"]],"text":"エジプトびとは彼らのあとを追い、パロのすべての馬と戦車およびその騎兵と軍勢とは、バアルゼポンの前にあるピハヒロテのあたりで、海のかたわらに宿営している彼らに追いついた。"},{"ref":"Exod.14.10","start":2014010,"end":2014010,"break":"paragraph","ruby":[[3,2,"ちかよ"],[7,1,"とき"],[15,2,"ひとびと"],[18,1,"め"],[20,1,"あ"],[30,1,"かれ"],[36,1,"すす"],[45,1,"み"],[48,2,"ひじょう"],[51,1,"おそ"],[64,2,"ひとびと"],[67,1,"しゅ"],[73,1,"さけ"]],"text":"パロが近寄った時、イスラエルの人々は目を上げてエジプトびとが彼らのあとに進んできているのを見て、非常に恐れた。そしてイスラエルの人々は主にむかって叫び、"},{"ref":"Exod.14.11","start":2014011,"end":2014011,"break":"none","ruby":[[6,1,"い"],[16,1,"はか"],[23,2,"あらの"],[26,1,"し"],[40,1,"たずさ"],[42,1,"だ"],[64,1,"みちび"],[66,1,"だ"]],"text":"かつモーセに言った、「エジプトに墓がないので、荒野で死なせるために、わたしたちを携え出したのですか。なぜわたしたちをエジプトから導き出して、こんなにするのですか。"},{"ref":"Exod.14.12","start":2014012,"end":2014012,"break":"none","ruby":[[15,1,"つ"],[26,1,"す"],[40,1,"つか"],[51,1,"い"],[70,2,"あらの"],[73,1,"し"],[85,1,"つか"],[88,1,"ほう"]],"text":"わたしたちがエジプトであなたに告げて、『わたしたちを捨てておいて、エジプトびとに仕えさせてください』と言ったのは、このことではありませんか。荒野で死ぬよりもエジプトびとに仕える方が、わたしたちにはよかったのです」。"},{"ref":"Exod.14.13","start":2014013,"end":2014013,"break":"none","ruby":[[4,1,"たみ"],[6,1,"い"],[17,1,"おそ"],[29,1,"た"],[33,1,"しゅ"],[52,1,"すくい"],[54,1,"み"],[76,1,"み"],[83,2,"えいきゅう"],[88,1,"ど"],[90,1,"かれ"],[93,1,"み"]],"text":"モーセは民に言った、「あなたがたは恐れてはならない。かたく立って、主がきょう、あなたがたのためになされる救を見なさい。きょう、あなたがたはエジプトびとを見るが、もはや永久に、二度と彼らを見ないであろう。"},{"ref":"Exod.14.14","start":2014014,"end":2014014,"break":"none","ruby":[[0,1,"しゅ"],[11,1,"たたか"],[24,1,"もく"]],"text":"主があなたがたのために戦われるから、あなたがたは黙していなさい」。"},{"ref":"Exod.14.15","start":2014015,"end":2014015,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[27,1,"さけ"],[38,2,"ひとびと"],[41,1,"かた"],[44,1,"かれ"],[47,1,"すす"],[49,1,"い"]],"text":"主はモーセに言われた、「あなたは、なぜわたしにむかって叫ぶのか。イスラエルの人々に語って彼らを進み行かせなさい。"},{"ref":"Exod.14.16","start":2014016,"end":2014016,"break":"none","ruby":[[7,1,"あ"],[10,1,"て"],[12,1,"うみ"],[14,1,"うえ"],[18,1,"の"],[24,1,"わ"],[33,2,"ひとびと"],[36,1,"うみ"],[38,1,"なか"],[44,1,"ち"],[46,1,"い"]],"text":"あなたはつえを上げ、手を海の上にさし伸べてそれを分け、イスラエルの人々に海の中のかわいた地を行かせなさい。"},{"ref":"Exod.14.17","start":2014017,"end":2014017,"break":"none","ruby":[[11,1,"こころ"],[23,1,"かれ"],[31,1,"お"],[59,2,"ぐんぜい"],[64,2,"せんしゃ"],[67,2,"きへい"],[71,1,"う"],[73,1,"やぶ"],[76,1,"ほまれ"],[78,1,"え"]],"text":"わたしがエジプトびとの心をかたくなにするから、彼らはそのあとを追ってはいるであろう。こうしてわたしはパロとそのすべての軍勢および戦車と騎兵とを打ち破って誉を得よう。"},{"ref":"Exod.14.18","start":2014018,"end":2014018,"break":"none","ruby":[[9,2,"せんしゃ"],[14,2,"きへい"],[18,1,"う"],[20,1,"やぶ"],[23,1,"ほまれ"],[25,1,"え"],[41,1,"しゅ"],[48,1,"し"]],"text":"わたしがパロとその戦車とその騎兵とを打ち破って誉を得るとき、エジプトびとはわたしが主であることを知るであろう」。"},{"ref":"Exod.14.19","start":2014019,"end":2014019,"break":"paragraph","ruby":[[11,2,"ぶたい"],[14,1,"まえ"],[16,1,"い"],[18,1,"かみ"],[20,1,"つかい"],[22,1,"うつ"],[25,1,"かれ"],[32,1,"い"],[36,1,"くも"],[38,1,"はしら"],[40,1,"かれ"],[43,1,"まえ"],[46,1,"うつ"],[49,1,"かれ"],[56,1,"た"]],"text":"このとき、イスラエルの部隊の前に行く神の使は移って彼らのうしろに行った。雲の柱も彼らの前から移って彼らのうしろに立ち、"},{"ref":"Exod.14.20","start":2014020,"end":2014020,"break":"none","ruby":[[7,2,"ぶたい"],[18,2,"ぶたい"],[22,1,"あいだ"],[32,1,"くも"],[39,1,"よ"],[51,1,"ちか"],[59,1,"よる"]],"text":"エジプトびとの部隊とイスラエルびとの部隊との間にきたので、そこに雲とやみがあり夜もすがら、かれとこれと近づくことなく、夜がすぎた。"},{"ref":"Exod.14.21","start":2014021,"end":2014021,"break":"paragraph","ruby":[[4,1,"て"],[6,1,"うみ"],[8,1,"うえ"],[12,1,"の"],[18,1,"しゅ"],[20,1,"よ"],[25,1,"つよ"],[27,2,"ひがしかぜ"],[33,1,"うみ"],[35,1,"しりぞ"],[39,1,"うみ"],[41,2,"りくち"],[47,1,"みず"],[49,1,"わ"]],"text":"モーセが手を海の上にさし伸べたので、主は夜もすがら強い東風をもって海を退かせ、海を陸地とされ、水は分かれた。"},{"ref":"Exod.14.22","start":2014022,"end":2014022,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"うみ"],[11,1,"なか"],[17,1,"ち"],[19,1,"おこな"],[24,1,"みず"],[26,1,"かれ"],[29,1,"みぎ"],[31,1,"ひだり"]],"text":"イスラエルの人々は海の中のかわいた地を行ったが、水は彼らの右と左に、かきとなった。"},{"ref":"Exod.14.23","start":2014023,"end":2014023,"break":"none","ruby":[[7,1,"お"],[20,1,"うま"],[22,2,"せんしゃ"],[25,2,"きへい"],[30,1,"かれ"],[39,1,"うみ"],[41,1,"なか"]],"text":"エジプトびとは追ってきて、パロのすべての馬と戦車と騎兵とは、彼らのあとについて海の中にはいった。"},{"ref":"Exod.14.24","start":2014024,"end":2014024,"break":"none","ruby":[[0,1,"あかつき"],[2,1,"さら"],[5,1,"しゅ"],[7,1,"ひ"],[9,1,"くも"],[11,1,"はしら"],[24,2,"ぐんぜい"],[27,1,"み"],[40,2,"ぐんぜい"],[43,1,"みだ"]],"text":"暁の更に、主は火と雲の柱のうちからエジプトびとの軍勢を見おろして、エジプトびとの軍勢を乱し、"},{"ref":"Exod.14.25","start":2014025,"end":2014025,"break":"none","ruby":[[2,2,"せんしゃ"],[5,1,"わ"],[13,1,"すす"],[17,1,"おも"],[32,1,"い"],[48,1,"はな"],[51,1,"に"],[56,1,"しゅ"],[58,1,"かれ"],[71,1,"たたか"]],"text":"その戦車の輪をきしらせて、進むのに重くされたので、エジプトびとは言った、「われわれはイスラエルを離れて逃げよう。主が彼らのためにエジプトびとと戦う」。"},{"ref":"Exod.14.26","start":2014026,"end":2014026,"break":"paragraph","ruby":[[4,1,"しゅ"],[10,1,"い"],[20,1,"て"],[22,1,"うみ"],[24,1,"うえ"],[28,1,"の"],[32,1,"みず"],[44,2,"せんしゃ"],[47,2,"きへい"],[51,1,"うえ"],[53,1,"なが"],[55,1,"かえ"]],"text":"そのとき主はモーセに言われた、「あなたの手を海の上にさし伸べて、水をエジプトびとと、その戦車と騎兵との上に流れ返らせなさい」。"},{"ref":"Exod.14.27","start":2014027,"end":2014027,"break":"none","ruby":[[4,1,"て"],[6,1,"うみ"],[8,1,"うえ"],[12,1,"の"],[17,2,"よあ"],[24,1,"うみ"],[30,1,"なが"],[33,1,"かえ"],[50,1,"に"],[55,1,"しゅ"],[64,1,"うみ"],[66,1,"なか"],[68,1,"な"],[70,1,"こ"]],"text":"モーセが手を海の上にさし伸べると、夜明けになって海はいつもの流れに返り、エジプトびとはこれにむかって逃げたが、主はエジプトびとを海の中に投げ込まれた。"},{"ref":"Exod.14.28","start":2014028,"end":2014028,"break":"none","ruby":[[0,1,"みず"],[2,1,"なが"],[4,1,"かえ"],[16,1,"お"],[19,1,"うみ"],[25,2,"せんしゃ"],[28,2,"きへい"],[40,2,"ぐんぜい"],[51,1,"のこ"]],"text":"水は流れ返り、イスラエルのあとを追って海にはいった戦車と騎兵およびパロのすべての軍勢をおおい、ひとりも残らなかった。"},{"ref":"Exod.14.29","start":2014029,"end":2014029,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"うみ"],[15,1,"なか"],[21,1,"ち"],[23,1,"おこな"],[28,1,"みず"],[30,1,"かれ"],[33,1,"みぎ"],[35,1,"ひだり"]],"text":"しかし、イスラエルの人々は海の中のかわいた地を行ったが、水は彼らの右と左に、かきとなった。"},{"ref":"Exod.14.30","start":2014030,"end":2014030,"break":"paragraph","ruby":[[6,1,"しゅ"],[10,1,"ひ"],[24,1,"て"],[27,1,"すく"],[45,1,"うみ"],[48,1,"し"],[55,1,"み"]],"text":"このように、主はこの日イスラエルをエジプトびとの手から救われた。イスラエルはエジプトびとが海べに死んでいるのを見た。"},{"ref":"Exod.14.31","start":2014031,"end":2014031,"break":"none","ruby":[[9,1,"しゅ"],[18,1,"おこな"],[22,1,"おお"],[30,1,"み"],[36,1,"たみ"],[38,1,"しゅ"],[40,1,"おそ"],[43,1,"しゅ"],[55,1,"しん"]],"text":"イスラエルはまた、主がエジプトびとに行われた大いなるみわざを見た。それで民は主を恐れ、主とそのしもべモーセとを信じた。"}]