[{"ref":"Ezra.9.1","start":15009001,"end":15009001,"break":"paragraph","ruby":[[4,1,"こと"],[10,1,"のち"],[26,1,"き"],[28,1,"い"],[39,1,"たみ"],[41,2,"さいし"],[51,2,"しょこく"],[54,1,"たみ"],[56,1,"はな"],[113,1,"にく"],[117,1,"こと"],[119,1,"おこな"]],"text":"これらの事がなされた後、つかさたちは、わたしのもとに来て言った、「イスラエルの民、祭司およびレビびとは諸国の民と離れないで、カナンびと、ヘテびと、ペリジびと、エブスびと、アンモンびと、モアブびと、エジプトびと、アモリびとなどの憎むべき事を行いました。"},{"ref":"Ezra.9.2","start":15009002,"end":15009002,"break":"none","ruby":[[5,1,"かれ"],[8,1,"むすめ"],[37,1,"せい"],[40,1,"たね"],[42,2,"しょこく"],[45,1,"たみ"],[62,1,"もの"],[64,1,"ちょう"],[67,1,"もの"],[69,1,"さき"],[79,1,"おか"]],"text":"すなわち、彼らの娘たちをみずからめとり、またそのむすこたちにめとったので、聖なる種が諸国の民とまじりました。そしてつかさたる者、長たる者が先だって、このとがを犯しました」。"},{"ref":"Ezra.9.3","start":15009003,"end":15009003,"break":"none","ruby":[[6,1,"こと"],[8,1,"き"],[11,1,"とき"],[13,2,"きもの"],[16,2,"うわぎ"],[20,1,"さ"],[23,1,"かみ"],[25,1,"け"],[30,1,"ぬ"],[33,1,"おどろ"]],"text":"わたしはこの事を聞いた時、着物と上着とを裂き、髪の毛とひげを抜き、驚きあきれてすわった。"},{"ref":"Ezra.9.4","start":15009004,"end":15009004,"break":"none","ruby":[[6,1,"かみ"],[8,2,"ことば"],[15,1,"もの"],[17,1,"みな"],[19,2,"ほしゅう"],[23,1,"かえ"],[26,1,"き"],[28,2,"ひとびと"],[45,1,"あつ"],[55,1,"ゆう"],[57,1,"そな"],[59,1,"もの"],[61,1,"とき"],[65,1,"おどろ"]],"text":"イスラエルの神の言葉におののく者は皆、捕囚から帰って来た人々のとがのゆえに、わたしのもとに集まったが、わたしは夕の供え物の時まで、驚きあきれてすわった。"},{"ref":"Ezra.9.5","start":15009005,"end":15009005,"break":"none","ruby":[[0,1,"ゆう"],[2,1,"そな"],[4,1,"もの"],[6,1,"とき"],[16,2,"だんじき"],[20,1,"た"],[26,2,"きもの"],[29,2,"うわぎ"],[32,1,"さ"],[48,1,"かみ"],[50,1,"しゅ"],[56,1,"て"],[60,1,"の"]],"text":"夕の供え物の時になって、わたしは断食から立ちあがり、着物と上着を裂いたまま、ひざをかがめて、わが神、主にむかって手をさし伸べて、"},{"ref":"Ezra.9.6","start":15009006,"end":15009006,"break":"none","breaks":[[4,"paragraph"]],"ruby":[[0,1,"い"],[7,1,"かみ"],[22,1,"かお"],[24,1,"あ"],[29,1,"は"],[33,2,"せきめん"],[44,2,"ふぎ"],[47,1,"つ"],[50,1,"あたま"],[54,1,"たか"],[67,1,"かさ"],[71,1,"てん"],[73,1,"たっ"]],"text":"言った、「わが神よ、わたしはあなたにむかって顔を上げるのを恥じて、赤面します。われわれの不義は積って頭よりも高くなり、われわれのとがは重なって天に達したからです。"},{"ref":"Ezra.9.7","start":15009007,"end":15009007,"break":"none","ruby":[[5,2,"せんぞ"],[8,1,"ひ"],[11,2,"こんにち"],[21,1,"おお"],[28,1,"お"],[36,2,"ふぎ"],[53,1,"おう"],[60,2,"さいし"],[65,2,"くにぐに"],[68,1,"おう"],[72,1,"て"],[88,1,"とら"],[90,1,"ゆ"],[100,1,"はじ"],[110,2,"こんにち"]],"text":"われわれの先祖の日から今日まで、われわれは大いなるとがを負い、われわれの不義によって、われわれとわれわれの王たち、および祭司たちは国々の王たちの手にわたされ、つるぎにかけられ、捕え行かれ、かすめられ、恥をこうむりました。今日のとおりです。"},{"ref":"Ezra.9.8","start":15009008,"end":15009008,"break":"none","ruby":[[12,1,"かみ"],[14,1,"しゅ"],[20,1,"めぐ"],[23,1,"ほどこ"],[30,1,"のこ"],[34,1,"もの"],[49,2,"せいじょ"],[55,1,"たし"],[64,1,"あた"],[76,1,"かみ"],[83,1,"め"],[85,1,"あき"],[98,2,"どれい"],[108,1,"すこ"],[111,1,"い"],[113,1,"かえ"]],"text":"ところがいま、われわれの神、主は、しばし恵みを施して、のがれ残るべき者をわれわれのうちにおき、その聖所のうちに確かなよりどころを与え、こうしてわれわれの神はわれわれの目を明らかにし、われわれをその奴隷のうちにあって、少しく生き返らせられました。"},{"ref":"Ezra.9.9","start":15009009,"end":15009009,"break":"none","ruby":[[5,2,"どれい"],[8,1,"み"],[18,2,"どれい"],[22,1,"とき"],[25,1,"かみ"],[32,2,"みす"],[47,1,"おう"],[51,1,"め"],[53,1,"まえ"],[61,1,"ほどこ"],[70,1,"い"],[72,1,"かえ"],[81,1,"かみ"],[83,1,"みや"],[85,1,"た"],[92,2,"はかい"],[115,2,"ほご"],[118,1,"あた"]],"text":"われわれは奴隷の身でありますが、その奴隷たる時にも神はわれわれを見捨てられず、かえってペルシャ王たちの目の前でいつくしみを施して、われわれを生き返らせ、われわれの神の宮を建てさせ、その破壊をつくろわせ、ユダとエルサレムでわれわれに保護を与えられました。"},{"ref":"Ezra.9.10","start":15009010,"end":15009010,"break":"paragraph","ruby":[[5,1,"かみ"],[10,1,"のち"],[12,1,"なに"],[14,1,"い"],[36,1,"いまし"],[39,1,"す"]],"text":"われわれの神よ、この後、何を言うことができましょう。われわれは、あなたの戒めを捨てたからです。"},{"ref":"Ezra.9.11","start":15009011,"end":15009011,"break":"none","ruby":[[18,3,"よげんしゃ"],[27,1,"めい"],[30,1,"おお"],[45,1,"い"],[48,1,"え"],[54,1,"ち"],[57,2,"かくち"],[60,1,"たみ"],[62,1,"けが"],[70,1,"にく"],[80,1,"けが"],[83,1,"ち"],[88,1,"はて"],[94,1,"はて"],[100,1,"けが"],[103,1,"み"]],"text":"あなたはかつて、あなたのしもべである預言者たちによって命じて仰せられました、『おまえたちが行って獲ようとする地は、各地の民の汚れにより、その憎むべきわざによって汚れた地で、この果から、かの果まで、その汚れに満ちている。"},{"ref":"Ezra.9.12","start":15009012,"end":15009012,"break":"none","ruby":[[9,1,"むすめ"],[12,1,"かれ"],[19,1,"あた"],[28,1,"かれ"],[31,1,"むすめ"],[56,2,"えいきゅう"],[59,1,"かれ"],[62,2,"へいあん"],[66,2,"ふくし"],[70,1,"もと"],[90,1,"つよ"],[97,1,"ち"],[99,1,"よ"],[101,1,"もの"],[103,1,"た"],[109,2,"えいきゅう"],[118,2,"しそん"],[121,1,"つた"],[124,1,"し"],[125,1,"ぎょう"]],"text":"それでおまえたちの娘を、彼らのむすこに与えてはならない。彼らの娘を、おまえたちのむすこにめとってはならない。また永久に彼らの平安をも福祉をも求めてはならない。そうすればおまえたちは強くなり、その地の良き物を食べ、これを永久におまえたちの子孫に伝えて嗣業とさせることができる』と。"},{"ref":"Ezra.9.13","start":15009013,"end":15009013,"break":"none","ruby":[[5,1,"わる"],[7,1,"おこな"],[13,1,"おお"],[43,1,"のぞ"],[55,1,"かみ"],[68,2,"ふぎ"],[73,1,"かる"],[75,1,"ばつ"],[87,1,"のこ"],[90,1,"もの"],[92,1,"あた"],[102,1,"み"]],"text":"われわれの悪い行いにより、大いなるとがによって、これらすべてのことが、すでにわれわれに臨みましたが、われわれの神なるあなたは、われわれの不義よりも軽い罰をくだして、このように残りの者を与えてくださったのを見ながら、"},{"ref":"Ezra.9.14","start":15009014,"end":15009014,"break":"none","ruby":[[5,1,"ふたた"],[11,2,"めいれい"],[14,1,"やぶ"],[22,1,"にく"],[29,1,"おこな"],[31,1,"たみ"],[33,1,"ふち"],[35,1,"むす"],[55,1,"いか"],[62,1,"ほろ"],[65,1,"つく"],[68,1,"のこ"],[70,1,"もの"],[77,1,"もの"]],"text":"われわれは再びあなたの命令を破って、これらの憎むべきわざを行う民と縁を結んでよいでしょうか。あなたはわれわれを怒って、ついに滅ぼし尽し、残る者も、のがれる者もないようにされるのではないでしょうか。"},{"ref":"Ezra.9.15","start":15009015,"end":15009015,"break":"none","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[18,1,"ただ"],[38,1,"のこ"],[42,2,"こんにち"],[67,1,"まえ"],[85,1,"まえ"],[87,1,"た"]],"text":"ああ、イスラエルの神、主よ、あなたは正しくいらせられます。われわれはのがれて残ること今日のとおりです。われわれは、とがをもってあなたの前にあります。それゆえだれもあなたの前に立つことはできません」。"}]