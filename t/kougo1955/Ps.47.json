[{"ref":"Ps.47.1","start":19047001,"end":19047001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたコラの子の歌","breaks":[[13,"line"]],"ruby":[[5,1,"たみ"],[8,1,"て"],[13,1,"よろこ"],[16,1,"こえ"],[21,1,"かみ"],[27,1,"さけ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[19,1,"こ"],[21,1,"うた"]],"text":"もろもろの民よ、手をうち、喜びの声をあげ、神にむかって叫べ。"},{"ref":"Ps.47.2","start":19047002,"end":19047002,"break":"line","breaks":[[11,"line"]],"ruby":[[2,1,"たか"],[4,1,"しゅ"],[6,1,"おそ"],[11,1,"ぜん"],[12,1,"ち"],[19,1,"おお"],[23,1,"おう"]],"text":"いと高き主は恐るべく、全地をしろしめす大いなる王だからである。"},{"ref":"Ps.47.3","start":19047003,"end":19047003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"たみ"],[13,1,"したが"],[22,1,"くに"],[28,1,"あし"],[30,1,"した"],[32,1,"したが"]],"text":"主はもろもろの民をわれらに従わせ、もろもろの国をわれらの足の下に従わせられた。"},{"ref":"Ps.47.4","start":19047004,"end":19047004,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"あい"],[12,1,"ほこり"],[18,1,"し"],[19,1,"ぎょう"],[31,1,"えら"]],"text":"主はその愛されたヤコブの誇をわれらの嗣業として、われらのために選ばれた。〔セラ"},{"ref":"Ps.47.5","start":19047005,"end":19047005,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[2,1,"よろこ"],[4,1,"さけ"],[6,1,"こえ"],[8,1,"とも"],[14,1,"しゅ"],[20,1,"こえ"],[22,1,"とも"]],"text":"神は喜び叫ぶ声と共にのぼり、主はラッパの声と共にのぼられた。"},{"ref":"Ps.47.6","start":19047006,"end":19047006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[20,1,"おう"]],"text":"神をほめうたえよ、ほめうたえよ、われらの王をほめうたえよ、ほめうたえよ。"},{"ref":"Ps.47.7","start":19047007,"end":19047007,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"かみ"],[2,1,"ぜん"],[3,1,"ち"],[5,1,"おう"],[10,1,"たく"],[13,1,"うた"]],"text":"神は全地の王である。巧みな歌をもってほめうたえよ。"},{"ref":"Ps.47.8","start":19047008,"end":19047008,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[7,2,"くにたみ"],[10,1,"す"],[12,1,"おさ"],[18,1,"かみ"],[22,1,"せい"],[29,1,"ざ"]],"text":"神はもろもろの国民を統べ治められる。神はその聖なるみくらに座せられる。"},{"ref":"Ps.47.9","start":19047009,"end":19047009,"break":"line","breaks":[[17,"line"]],"ruby":[[5,1,"たみ"],[7,1,"きみ"],[14,1,"き"],[23,1,"かみ"],[25,1,"たみ"]],"text":"もろもろの民の君たちはつどい来て、アブラハムの神の民となる。"},{"ref":"Ps.47.10","start":19047009,"end":19047009,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ち"],[7,1,"たて"],[9,1,"かみ"],[17,1,"かみ"],[19,1,"おお"]],"text":"地のもろもろの盾は神のものである。神は大いにあがめられる。"}]