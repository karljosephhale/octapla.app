[{"ref":"Ps.98.1","start":19098001,"end":19098001,"break":"paragraph","title":"歌","breaks":[[15,"line"],[35,"line"],[48,"line"]],"ruby":[[0,1,"あたら"],[3,1,"うた"],[5,1,"しゅ"],[15,1,"しゅ"],[37,1,"みぎ"],[39,1,"て"],[41,1,"せい"],[44,1,"うで"],[55,2,"しょうり"],[58,1,"え"]],"titleRuby":[[0,1,"うた"]],"text":"新しき歌を主にむかってうたえ。主はくすしきみわざをなされたからである。その右の手と聖なる腕とは、おのれのために勝利を得られた。"},{"ref":"Ps.98.2","start":19098002,"end":19098002,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[4,2,"しょうり"],[7,1,"し"],[13,1,"ぎ"],[20,2,"くにたみ"],[23,1,"まえ"]],"text":"主はその勝利を知らせ、その義をもろもろの国民の前にあらわされた。"},{"ref":"Ps.98.3","start":19098003,"end":19098003,"break":"line","breaks":[[16,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[22,1,"いえ"],[28,1,"おぼ"],[34,1,"ち"],[49,1,"かみ"],[51,2,"しょうり"],[54,1,"み"]],"text":"主はそのいつくしみと、まこととをイスラエルの家にむかって覚えられた。地のもろもろのはては、われらの神の勝利を見た。"},{"ref":"Ps.98.4","start":19098004,"end":19098004,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ぜん"],[1,1,"ち"],[4,1,"しゅ"],[10,1,"よろこ"],[14,1,"こえ"],[20,1,"こえ"],[22,1,"はな"],[25,1,"よろこ"],[27,1,"うた"]],"text":"全地よ、主にむかって喜ばしき声をあげよ。声を放って喜び歌え、ほめうたえ。"},{"ref":"Ps.98.5","start":19098005,"end":19098005,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"こと"],[5,1,"しゅ"],[13,1,"こと"],[15,1,"うた"],[17,1,"こえ"]],"text":"琴をもって主をほめうたえ。琴と歌の声をもってほめうたえ。"},{"ref":"Ps.98.6","start":19098006,"end":19098006,"break":"line","breaks":[[12,"line"]],"ruby":[[4,2,"つのぶえ"],[7,1,"おと"],[12,1,"おう"],[15,1,"しゅ"],[17,1,"まえ"],[19,1,"よろこ"],[23,1,"こえ"]],"text":"ラッパと角笛の音をもって王なる主の前に喜ばしき声をあげよ。"},{"ref":"Ps.98.7","start":19098007,"end":19098007,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"うみ"],[4,1,"なか"],[6,1,"み"],[12,2,"せかい"],[20,1,"す"],[22,1,"もの"],[25,1,"な"]],"text":"海とその中に満ちるもの、世界とそのうちに住む者とは鳴りどよめけ。"},{"ref":"Ps.98.8","start":19098008,"end":19098008,"break":"line","breaks":[[10,"line"]],"ruby":[[0,2,"おおみず"],[5,1,"て"],[7,1,"う"],[15,1,"やま"],[17,1,"とも"],[19,1,"しゅ"],[22,1,"まえ"],[24,1,"よろこ"],[26,1,"うた"]],"text":"大水はその手を打ち、もろもろの山は共に主のみ前に喜び歌え。"},{"ref":"Ps.98.9","start":19098009,"end":19098009,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ち"],[10,1,"こ"],[20,1,"しゅ"],[22,1,"ぎ"],[27,2,"せかい"],[34,2,"こうへい"],[45,1,"たみ"]],"text":"主は地をさばくために来られるからである。主は義をもって世界をさばき、公平をもってもろもろの民をさばかれる。"}]