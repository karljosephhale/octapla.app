[{"ref":"Isa.27.1","start":23027001,"end":23027001,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"しゅ"],[6,1,"かた"],[8,1,"おお"],[12,1,"つよ"],[18,1,"に"],[29,1,"まが"],[42,1,"ばっ"],[47,1,"うみ"],[51,1,"りゅう"],[53,1,"ころ"]],"text":"その日、主は堅く大いなる強いつるぎで逃げるへびレビヤタン、曲りくねるへびレビヤタンを罰し、また海におる龍を殺される。"},{"ref":"Isa.27.2","start":23027002,"end":23027002,"break":"paragraph","breaks":[[3,"line"]],"ruby":[[2,1,"ひ"],[4,1,"うるわ"],[10,1,"はたけ"],[18,1,"うた"]],"text":"その日「麗しきぶどう畑よ、このことを歌え。"},{"ref":"Isa.27.3","start":23027003,"end":23027003,"break":"line","breaks":[[13,"line"],[21,"line"]],"ruby":[[0,1,"しゅ"],[10,1,"まも"],[13,1,"つね"],[15,1,"みず"],[21,1,"よる"],[23,1,"ひる"],[25,1,"まも"],[33,1,"もの"]],"text":"主なるわたしはこれを守り、常に水をそそぎ、夜も昼も守って、そこなう者のないようにする。"},{"ref":"Isa.27.4","start":23027004,"end":23027004,"break":"line","breaks":[[9,"line"],[26,"line"],[39,"line"]],"ruby":[[4,1,"いきどお"],[21,1,"たたか"],[30,1,"すす"],[36,1,"せ"],[39,1,"みな"],[45,1,"や"]],"text":"わたしは憤らない。いばら、おどろがわたしと戦うなら、わたしは進んでこれを攻め、皆もろともに焼きつくす。"},{"ref":"Isa.27.5","start":23027005,"end":23027005,"break":"line","breaks":[[22,"line"],[33,"line"]],"ruby":[[3,1,"のぞ"],[14,2,"ほご"],[26,1,"やわ"],[37,1,"やわ"]],"text":"それを望まないなら、わたしの保護にたよって、わたしと和らぎをなせ、わたしと和らぎをなせ」。"},{"ref":"Isa.27.6","start":23027006,"end":23027006,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[0,1,"のち"],[10,1,"ね"],[21,1,"め"],[23,1,"だ"],[26,1,"はな"],[27,1,"さ"],[32,1,"み"],[34,1,"ぜん"],[35,2,"せかい"],[38,1,"み"]],"text":"後になれば、ヤコブは根をはり、イスラエルは芽を出して花咲き、その実を全世界に満たす。"},{"ref":"Isa.27.7","start":23027007,"end":23027007,"break":"paragraph","breaks":[[17,"line"],[26,"line"],[45,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"う"],[8,1,"もの"],[10,1,"う"],[17,1,"かれ"],[20,1,"う"],[30,1,"かれ"],[33,1,"ころ"],[36,1,"もの"],[38,1,"ころ"],[45,1,"かれ"],[48,1,"ころ"]],"text":"主は彼らを撃った者を撃たれたように彼らを撃たれたか。あるいは彼らを殺した者が殺されたように彼らは殺されたか。"},{"ref":"Isa.27.8","start":23027008,"end":23027008,"break":"line","breaks":[[20,"line"],[38,"line"]],"ruby":[[4,1,"かれ"],[7,1,"あらそ"],[11,1,"かれ"],[14,2,"ついほう"],[20,1,"しゅ"],[22,2,"ひがしかぜ"],[25,1,"ひ"],[30,1,"はげ"],[33,1,"かぜ"],[38,1,"かれ"],[41,1,"うつ"]],"text":"あなたは彼らと争って、彼らを追放された。主は東風の日に、その激しい風をもって彼らを移しやられた。"},{"ref":"Isa.27.9","start":23027009,"end":23027009,"break":"line","breaks":[[12,"line"],[26,"line"],[43,"line"],[58,"line"],[69,"line"]],"ruby":[[9,2,"ふぎ"],[32,1,"むす"],[34,1,"み"],[36,1,"かれ"],[38,1,"つみ"],[40,1,"のぞ"],[47,1,"かれ"],[49,2,"さいだん"],[56,1,"いし"],[58,1,"くだ"],[61,2,"はくあ"],[72,1,"ぞう"],[74,1,"こう"],[76,2,"さいだん"],[80,1,"ふたた"],[82,1,"た"]],"text":"それゆえ、ヤコブの不義はこれによって、あがなわれる。これによって結ぶ実は彼の罪を除く。すなわち彼が祭壇のすべての石を砕けた白堊のようにし、アシラ像と香の祭壇とを再び建てないことである。"},{"ref":"Isa.27.10","start":23027010,"end":23027010,"break":"line","breaks":[[13,"line"],[30,"line"],[41,"line"]],"ruby":[[0,2,"けんご"],[3,1,"まち"],[5,1,"あ"],[13,1,"す"],[15,1,"さ"],[23,2,"あらの"],[30,1,"こ"],[31,1,"うし"],[36,1,"くさ"],[38,1,"く"],[44,1,"ふ"],[50,1,"き"],[52,1,"えだ"],[54,1,"はだか"]],"text":"堅固な町は荒れてさびしく、捨て去られたすまいは荒野のようだ。子牛はそこに草を食い、そこに伏して、その木の枝を裸にする。"},{"ref":"Isa.27.11","start":23027011,"end":23027011,"break":"line","breaks":[[15,"line"],[26,"line"],[40,"line"],[54,"line"],[65,"line"]],"ruby":[[2,1,"えだ"],[4,1,"か"],[9,1,"お"],[11,1,"と"],[15,1,"おんな"],[17,1,"き"],[22,1,"も"],[29,2,"むち"],[32,1,"たみ"],[45,1,"かれ"],[48,1,"つく"],[52,1,"しゅ"],[54,1,"かれ"],[65,1,"かれ"],[68,1,"かたち"],[69,1,"つく"],[73,1,"しゅ"],[76,1,"かれ"],[79,1,"めぐ"]],"text":"その枝が枯れると、折り取られ、女が来てそれを燃やす。これは無知の民だからである。それゆえ、彼らを造られた主は彼らをあわれまれない。彼らを形造られた主は、彼らを恵まれない。"},{"ref":"Isa.27.12","start":23027012,"end":23027012,"break":"paragraph","ruby":[[6,2,"ひとびと"],[12,1,"ひ"],[14,1,"しゅ"],[20,1,"かわ"],[28,1,"かわ"],[35,2,"こくもつ"],[38,1,"ほ"],[40,1,"う"],[42,1,"おと"],[63,1,"あつ"]],"text":"イスラエルの人々よ、その日、主はユフラテ川からエジプトの川にいたるまで穀物の穂を打ち落される。そしてあなたがたは、ひとりびとり集められる。"},{"ref":"Isa.27.13","start":23027013,"end":23027013,"break":"none","ruby":[[2,1,"ひ"],[3,1,"おお"],[11,1,"な"],[23,1,"ち"],[27,1,"うしな"],[31,1,"もの"],[39,1,"ち"],[41,1,"お"],[47,1,"もの"],[59,2,"せいざん"],[62,1,"しゅ"],[64,1,"おが"]],"text":"その日大いなるラッパが鳴りひびき、アッスリヤの地にある失われた者と、エジプトの地に追いやられた者とがきて、エルサレムの聖山で主を拝む。"}]