[{"ref":"Luke.2.1","start":42002001,"end":42002001,"break":"paragraph","ruby":[[5,1,"ぜん"],[6,2,"せかい"],[9,2,"じんこう"],[11,2,"ちょうさ"],[18,2,"ちょくれい"],[22,2,"こうてい"],[31,1,"で"]],"text":"そのころ、全世界の人口調査をせよとの勅令が、皇帝アウグストから出た。"},{"ref":"Luke.2.2","start":42002002,"end":42002002,"break":"none","ruby":[[13,2,"そうとく"],[19,1,"とき"],[21,1,"おこな"],[25,2,"さいしょ"],[28,2,"じんこう"],[30,2,"ちょうさ"]],"text":"これは、クレニオがシリヤの総督であった時に行われた最初の人口調査であった。"},{"ref":"Luke.2.3","start":42002003,"end":42002003,"break":"none","ruby":[[0,2,"ひとびと"],[5,2,"とうろく"],[18,2,"じぶん"],[21,1,"まち"],[23,1,"かえ"],[26,1,"い"]],"text":"人々はみな登録をするために、それぞれ自分の町へ帰って行った。"},{"ref":"Luke.2.4","start":42002004,"end":42002004,"break":"none","ruby":[[8,2,"かけい"],[18,2,"けっとう"],[32,1,"まち"],[37,1,"で"],[56,1,"まち"],[58,1,"のぼ"],[61,1,"い"]],"text":"ヨセフもダビデの家系であり、またその血統であったので、ガリラヤの町ナザレを出て、ユダヤのベツレヘムというダビデの町へ上って行った。"},{"ref":"Luke.2.5","start":42002005,"end":42002005,"break":"none","ruby":[[7,2,"みおも"],[21,1,"つま"],[26,1,"とも"],[29,2,"とうろく"]],"text":"それは、すでに身重になっていたいいなづけの妻マリヤと共に、登録をするためであった。"},{"ref":"Luke.2.6","start":42002006,"end":42002006,"break":"none","ruby":[[5,1,"かれ"],[14,2,"たいざい"],[20,1,"あいだ"],[27,1,"つき"],[29,1,"み"]],"text":"ところが、彼らがベツレヘムに滞在している間に、マリヤは月が満ちて、"},{"ref":"Luke.2.7","start":42002007,"end":42002007,"break":"none","ruby":[[0,2,"ういご"],[3,1,"う"],[6,1,"ぬの"],[13,2,"かいば"],[18,1,"なか"],[20,1,"ね"],[25,2,"きゃくま"],[29,1,"かれ"],[34,2,"よち"]],"text":"初子を産み、布にくるんで、飼葉おけの中に寝かせた。客間には彼らのいる余地がなかったからである。"},{"ref":"Luke.2.8","start":42002008,"end":42002008,"break":"paragraph","ruby":[[5,2,"ちほう"],[8,2,"ひつじかい"],[13,1,"よる"],[15,2,"のじゅく"],[21,1,"ひつじ"],[23,1,"む"],[26,1,"ばん"]],"text":"さて、この地方で羊飼たちが夜、野宿しながら羊の群れの番をしていた。"},{"ref":"Luke.2.9","start":42002009,"end":42002009,"break":"none","ruby":[[3,1,"しゅ"],[5,2,"みつかい"],[8,1,"あらわ"],[11,1,"しゅ"],[13,2,"えいこう"],[16,1,"かれ"],[22,1,"てら"],[28,1,"かれ"],[31,2,"ひじょう"],[34,1,"おそ"]],"text":"すると主の御使が現れ、主の栄光が彼らをめぐり照したので、彼らは非常に恐れた。"},{"ref":"Luke.2.10","start":42002010,"end":42002010,"break":"none","ruby":[[0,2,"みつかい"],[3,1,"い"],[8,1,"おそ"],[13,1,"み"],[20,1,"たみ"],[22,1,"あた"],[27,1,"おお"],[30,1,"よろこ"],[40,1,"つた"]],"text":"御使は言った、「恐れるな。見よ、すべての民に与えられる大きな喜びを、あなたがたに伝える。"},{"ref":"Luke.2.11","start":42002011,"end":42002011,"break":"none","ruby":[[7,1,"まち"],[19,2,"すくいぬし"],[23,1,"うま"],[36,1,"しゅ"]],"text":"きょうダビデの町に、あなたがたのために救主がお生れになった。このかたこそ主なるキリストである。"},{"ref":"Luke.2.12","start":42002012,"end":42002012,"break":"none","ruby":[[7,1,"おさ"],[9,1,"ご"],[11,1,"ぬの"],[18,2,"かいば"],[23,1,"なか"],[25,1,"ね"],[33,1,"み"],[50,1,"あた"]],"text":"あなたがたは、幼な子が布にくるまって飼葉おけの中に寝かしてあるのを見るであろう。それが、あなたがたに与えられるしるしである」。"},{"ref":"Luke.2.13","start":42002013,"end":42002013,"break":"none","ruby":[[14,1,"てん"],[16,2,"ぐんぜい"],[19,1,"あらわ"],[22,2,"みつかい"],[25,2,"いっしょ"],[31,1,"かみ"],[38,1,"い"]],"text":"するとたちまち、おびただしい天の軍勢が現れ、御使と一緒になって神をさんびして言った、"},{"ref":"Luke.2.14","start":42002014,"end":42002014,"break":"stanza","breaks":[[22,"line"]],"ruby":[[3,1,"たか"],[11,1,"かみ"],[13,2,"えいこう"],[22,1,"ち"],[24,1,"うえ"],[29,1,"こころ"],[34,2,"ひとびと"],[37,2,"へいわ"]],"text":"「いと高きところでは、神に栄光があるように、地の上では、み心にかなう人々に平和があるように」。"},{"ref":"Luke.2.15","start":42002015,"end":42002015,"break":"none","ruby":[[0,2,"みつかい"],[5,1,"かれ"],[8,1,"はな"],[11,1,"てん"],[13,1,"かえ"],[19,2,"ひつじかい"],[34,1,"い"],[38,1,"しゅ"],[41,1,"し"],[44,1,"くだ"],[50,3,"できごと"],[54,1,"み"],[67,1,"たがい"],[69,1,"かた"],[71,1,"あ"]],"text":"御使たちが彼らを離れて天に帰ったとき、羊飼たちは「さあ、ベツレヘムへ行って、主がお知らせ下さったその出来事を見てこようではないか」と、互に語り合った。"},{"ref":"Luke.2.16","start":42002016,"end":42002016,"break":"none","ruby":[[3,1,"いそ"],[6,1,"い"],[20,2,"かいば"],[25,1,"ね"],[31,1,"おさ"],[33,1,"ご"],[35,1,"さが"]],"text":"そして急いで行って、マリヤとヨセフ、また飼葉おけに寝かしてある幼な子を捜しあてた。"},{"ref":"Luke.2.17","start":42002017,"end":42002017,"break":"none","ruby":[[0,1,"かれ"],[3,1,"あ"],[6,1,"うえ"],[11,1,"こ"],[16,2,"じぶん"],[21,1,"つ"],[23,1,"し"],[28,1,"こと"],[31,2,"ひとびと"],[34,1,"つた"]],"text":"彼らに会った上で、この子について自分たちに告げ知らされた事を、人々に伝えた。"},{"ref":"Luke.2.18","start":42002018,"end":42002018,"break":"none","ruby":[[0,2,"ひとびと"],[6,2,"ひつじかい"],[11,1,"はな"],[20,1,"き"],[24,3,"ふしぎ"],[28,1,"おも"]],"text":"人々はみな、羊飼たちが話してくれたことを聞いて、不思議に思った。"},{"ref":"Luke.2.19","start":42002019,"end":42002019,"break":"none","ruby":[[12,1,"こと"],[19,1,"こころ"],[21,1,"と"],[25,1,"おも"]],"text":"しかし、マリヤはこれらの事をことごとく心に留めて、思いめぐらしていた。"},{"ref":"Luke.2.20","start":42002020,"end":42002020,"break":"none","ruby":[[0,2,"ひつじかい"],[6,2,"みき"],[14,1,"なに"],[18,2,"じぶん"],[23,1,"かた"],[37,1,"かみ"],[52,1,"かえ"],[55,1,"い"]],"text":"羊飼たちは、見聞きしたことが何もかも自分たちに語られたとおりであったので、神をあがめ、またさんびしながら帰って行った。"},{"ref":"Luke.2.21","start":42002021,"end":42002021,"break":"paragraph","ruby":[[1,1,"か"],[3,1,"す"],[6,2,"かつれい"],[13,1,"とき"],[21,2,"じゅたい"],[27,2,"みつかい"],[30,1,"つ"],[37,1,"おさ"],[39,1,"ご"],[45,1,"な"]],"text":"八日が過ぎ、割礼をほどこす時となったので、受胎のまえに御使が告げたとおり、幼な子をイエスと名づけた。"},{"ref":"Luke.2.22","start":42002022,"end":42002022,"break":"paragraph","ruby":[[9,2,"りっぽう"],[14,1,"かれ"],[21,2,"きかん"],[24,1,"す"],[30,2,"りょうしん"],[33,1,"おさ"],[35,1,"ご"],[37,1,"つ"],[46,1,"のぼ"]],"text":"それから、モーセの律法による彼らのきよめの期間が過ぎたとき、両親は幼な子を連れてエルサレムへ上った。"},{"ref":"Luke.2.23","start":42002023,"end":42002023,"break":"none","ruby":[[3,1,"しゅ"],[5,2,"りっぽう"],[9,1,"はは"],[11,1,"たい"],[13,1,"はじ"],[16,1,"ひら"],[18,1,"おとこ"],[20,1,"こ"],[25,1,"しゅ"],[27,1,"せい"],[28,1,"べつ"],[32,1,"もの"],[48,1,"か"],[57,1,"おさ"],[59,1,"ご"],[61,1,"しゅ"]],"text":"それは主の律法に「母の胎を初めて開く男の子はみな、主に聖別された者と、となえられねばならない」と書いてあるとおり、幼な子を主にささげるためであり、"},{"ref":"Luke.2.24","start":42002024,"end":42002024,"break":"none","ruby":[[2,1,"おな"],[4,1,"しゅ"],[6,2,"りっぽう"],[11,1,"やま"],[23,1,"いえ"],[30,1,"わ"],[33,1,"さだ"],[40,1,"したが"],[44,2,"ぎせい"]],"text":"また同じ主の律法に、「山ばと一つがい、または、家ばとのひな二羽」と定めてあるのに従って、犠牲をささげるためであった。"},{"ref":"Luke.2.25","start":42002025,"end":42002025,"break":"none","ruby":[[2,1,"とき"],[17,1,"な"],[19,1,"ひと"],[26,1,"ひと"],[28,1,"ただ"],[31,2,"しんこう"],[33,1,"ふか"],[35,1,"ひと"],[44,1,"なぐさ"],[51,1,"ま"],[53,1,"のぞ"],[61,2,"せいれい"],[64,1,"かれ"],[66,1,"やど"]],"text":"その時、エルサレムにシメオンという名の人がいた。この人は正しい信仰深い人で、イスラエルの慰められるのを待ち望んでいた。また聖霊が彼に宿っていた。"},{"ref":"Luke.2.26","start":42002026,"end":42002026,"break":"none","ruby":[[3,1,"しゅ"],[9,2,"すくいぬし"],[12,1,"あ"],[17,1,"し"],[26,2,"せいれい"],[29,1,"しめ"],[32,1,"う"]],"text":"そして主のつかわす救主に会うまでは死ぬことはないと、聖霊の示しを受けていた。"},{"ref":"Luke.2.27","start":42002027,"end":42002027,"break":"none","ruby":[[2,1,"ひと"],[4,2,"みたま"],[7,1,"かん"],[10,1,"みや"],[20,2,"りっぽう"],[23,1,"さだ"],[31,1,"おこな"],[36,2,"りょうしん"],[41,1,"こ"],[46,1,"つ"]],"text":"この人が御霊に感じて宮にはいった。すると律法に定めてあることを行うため、両親もその子イエスを連れてはいってきたので、"},{"ref":"Luke.2.28","start":42002028,"end":42002028,"break":"none","ruby":[[5,1,"おさ"],[7,1,"ご"],[9,1,"うで"],[11,1,"いだ"],[14,1,"かみ"],[22,1,"い"]],"text":"シメオンは幼な子を腕に抱き、神をほめたたえて言った、"},{"ref":"Luke.2.29","start":42002029,"end":42002029,"break":"stanza","breaks":[[20,"line"]],"ruby":[[1,1,"しゅ"],[4,1,"いま"],[13,2,"ことば"],[22,1,"しもべ"],[24,1,"やす"],[28,1,"さ"]],"text":"「主よ、今こそ、あなたはみ言葉のとおりにこの僕を安らかに去らせてくださいます、"},{"ref":"Luke.2.30","start":42002030,"end":42002030,"break":"line","ruby":[[4,1,"め"],[6,1,"いま"],[11,1,"すくい"],[13,1,"み"]],"text":"わたしの目が今あなたの救を見たのですから。"},{"ref":"Luke.2.31","start":42002031,"end":42002031,"break":"line","ruby":[[2,1,"すくい"],[8,2,"ばんみん"],[15,1,"そな"]],"text":"この救はあなたが万民のまえにお備えになったもので、"},{"ref":"Luke.2.32","start":42002032,"end":42002032,"break":"line","breaks":[[11,"line"]],"ruby":[[0,3,"いほうじん"],[4,1,"てら"],[6,2,"けいじ"],[9,1,"ひかり"],[12,1,"たみ"],[19,2,"えいこう"]],"text":"異邦人を照す啓示の光、み民イスラエルの栄光であります」。"},{"ref":"Luke.2.33","start":42002033,"end":42002033,"break":"none","ruby":[[0,1,"ちち"],[2,1,"はは"],[5,1,"おさ"],[7,1,"ご"],[17,1,"かた"],[25,3,"ふしぎ"],[29,1,"おも"]],"text":"父と母とは幼な子についてこのように語られたことを、不思議に思った。"},{"ref":"Luke.2.34","start":42002034,"end":42002034,"break":"none","ruby":[[8,1,"かれ"],[11,1,"しゅく"],[17,1,"はは"],[22,1,"い"],[36,1,"おさ"],[38,1,"ご"],[47,1,"おお"],[50,1,"ひと"],[52,1,"たお"],[58,1,"た"],[74,2,"はんたい"],[77,1,"う"],[87,1,"さだ"]],"text":"するとシメオンは彼らを祝し、そして母マリヤに言った、「ごらんなさい、この幼な子は、イスラエルの多くの人を倒れさせたり立ちあがらせたりするために、また反対を受けるしるしとして、定められています。――"},{"ref":"Luke.2.35","start":42002035,"end":42002035,"break":"none","ruby":[[7,2,"じしん"],[14,1,"むね"],[16,1,"さ"],[18,1,"つらぬ"],[32,1,"おお"],[35,1,"ひと"],[37,1,"こころ"],[41,1,"おも"],[45,1,"あらわ"]],"text":"そして、あなた自身もつるぎで胸を刺し貫かれるでしょう。――それは多くの人の心にある思いが、現れるようになるためです」。"},{"ref":"Luke.2.36","start":42002036,"end":42002036,"break":"paragraph","ruby":[[6,1,"ぞく"],[13,1,"むすめ"],[22,1,"おんな"],[23,3,"よげんしゃ"],[30,2,"かのじょ"],[33,2,"ひじょう"],[36,1,"とし"],[47,2,"じだい"],[56,2,"ねんかん"],[60,1,"おっと"],[62,1,"とも"],[64,1,"す"]],"text":"また、アセル族のパヌエルの娘で、アンナという女預言者がいた。彼女は非常に年をとっていた。むすめ時代にとついで、七年間だけ夫と共に住み、"},{"ref":"Luke.2.37","start":42002037,"end":42002037,"break":"none","ruby":[[2,1,"のち"],[15,1,"さい"],[26,1,"みや"],[28,1,"はな"],[32,1,"よる"],[34,1,"ひる"],[36,2,"だんじき"],[39,1,"いのり"],[45,1,"かみ"],[47,1,"つか"]],"text":"その後やもめぐらしをし、八十四歳になっていた。そして宮を離れずに夜も昼も断食と祈とをもって神に仕えていた。"},{"ref":"Luke.2.38","start":42002038,"end":42002038,"break":"none","ruby":[[2,2,"ろうじょ"],[14,2,"ちかよ"],[21,1,"かみ"],[23,2,"かんしゃ"],[35,1,"おさ"],[37,1,"ご"],[49,1,"すくい"],[51,1,"ま"],[53,1,"のぞ"],[62,2,"ひとびと"],[65,1,"かた"]],"text":"この老女も、ちょうどそのとき近寄ってきて、神に感謝をささげ、そしてこの幼な子のことを、エルサレムの救を待ち望んでいるすべての人々に語りきかせた。"},{"ref":"Luke.2.39","start":42002039,"end":42002039,"break":"paragraph","ruby":[[0,2,"りょうしん"],[3,1,"しゅ"],[5,2,"りっぽう"],[14,1,"こと"],[32,2,"じぶん"],[35,1,"まち"],[40,1,"かえ"]],"text":"両親は主の律法どおりすべての事をすませたので、ガリラヤへむかい、自分の町ナザレに帰った。"},{"ref":"Luke.2.40","start":42002040,"end":42002040,"break":"paragraph","ruby":[[0,1,"おさ"],[2,1,"ご"],[9,2,"せいちょう"],[13,1,"つよ"],[18,2,"ちえ"],[21,1,"み"],[27,1,"かみ"],[29,1,"めぐ"],[34,1,"うえ"]],"text":"幼な子は、ますます成長して強くなり、知恵に満ち、そして神の恵みがその上にあった。"},{"ref":"Luke.2.41","start":42002041,"end":42002041,"break":"paragraph","ruby":[[7,2,"りょうしん"],[11,2,"すぎこし"],[14,1,"まつり"],[17,2,"まいとし"],[25,1,"のぼ"]],"text":"さて、イエスの両親は、過越の祭には毎年エルサレムへ上っていた。"},{"ref":"Luke.2.42","start":42002042,"end":42002042,"break":"none","ruby":[[6,1,"さい"],[11,1,"とき"],[14,2,"かんれい"],[17,1,"したが"],[20,1,"まつり"],[25,2,"じょうきょう"]],"text":"イエスが十二歳になった時も、慣例に従って祭のために上京した。"},{"ref":"Luke.2.43","start":42002043,"end":42002043,"break":"none","ruby":[[5,1,"まつり"],[7,1,"おわ"],[10,1,"かえ"],[15,2,"しょうねん"],[27,2,"いのこ"],[37,2,"りょうしん"],[43,1,"き"]],"text":"ところが、祭が終って帰るとき、少年イエスはエルサレムに居残っておられたが、両親はそれに気づかなかった。"},{"ref":"Luke.2.44","start":42002044,"end":42002044,"break":"none","ruby":[[3,2,"みちづ"],[7,1,"なか"],[14,1,"おも"],[21,1,"にち"],[22,1,"じ"],[24,1,"い"],[36,2,"しんぞく"],[39,2,"ちじん"],[42,1,"なか"],[44,1,"さが"]],"text":"そして道連れの中にいることと思いこんで、一日路を行ってしまい、それから、親族や知人の中を捜しはじめたが、"},{"ref":"Luke.2.45","start":42002045,"end":42002045,"break":"none","ruby":[[0,1,"み"],[9,1,"さが"],[23,2,"ひきかえ"]],"text":"見つからないので、捜しまわりながらエルサレムへ引返した。"},{"ref":"Luke.2.46","start":42002046,"end":42002046,"break":"none","ruby":[[4,1,"か"],[6,1,"のち"],[13,1,"みや"],[15,1,"なか"],[17,2,"きょうし"],[24,1,"なか"],[31,1,"かれ"],[34,1,"はなし"],[36,1,"き"],[40,2,"しつもん"],[53,1,"み"]],"text":"そして三日の後に、イエスが宮の中で教師たちのまん中にすわって、彼らの話を聞いたり質問したりしておられるのを見つけた。"},{"ref":"Luke.2.47","start":42002047,"end":42002047,"break":"none","ruby":[[0,1,"き"],[2,2,"ひとびと"],[12,1,"かしこ"],[17,1,"こたえ"],[19,2,"きょうたん"]],"text":"聞く人々はみな、イエスの賢さやその答に驚嘆していた。"},{"ref":"Luke.2.48","start":42002048,"end":42002048,"break":"none","ruby":[[0,2,"りょうしん"],[6,1,"み"],[8,1,"おどろ"],[14,1,"はは"],[16,1,"かれ"],[18,1,"い"],[30,1,"こと"],[51,1,"さま"],[57,2,"しんぱい"],[66,1,"さが"]],"text":"両親はこれを見て驚き、そして母が彼に言った、「どうしてこんな事をしてくれたのです。ごらんなさい、おとう様もわたしも心配して、あなたを捜していたのです」。"},{"ref":"Luke.2.49","start":42002049,"end":42002049,"break":"none","ruby":[[7,1,"い"],[18,1,"さが"],[33,2,"じぶん"],[36,1,"ちち"],[38,1,"いえ"],[50,1,"ぞん"]],"text":"するとイエスは言われた、「どうしてお捜しになったのですか。わたしが自分の父の家にいるはずのことを、ご存じなかったのですか」。"},{"ref":"Luke.2.50","start":42002050,"end":42002050,"break":"none","ruby":[[4,2,"りょうしん"],[9,1,"かた"],[13,2,"ことば"],[16,1,"さと"]],"text":"しかし、両親はその語られた言葉を悟ることができなかった。"},{"ref":"Luke.2.51","start":42002051,"end":42002051,"break":"none","ruby":[[8,2,"りょうしん"],[11,2,"いっしょ"],[18,1,"くだ"],[21,1,"い"],[24,1,"かれ"],[28,1,"つか"],[35,1,"はは"],[41,1,"こと"],[45,1,"こころ"],[47,1,"と"]],"text":"それからイエスは両親と一緒にナザレに下って行き、彼らにお仕えになった。母はこれらの事をみな心に留めていた。"},{"ref":"Luke.2.52","start":42002052,"end":42002052,"break":"paragraph","ruby":[[8,2,"ちえ"],[11,1,"くわ"],[15,1,"せ"],[19,1,"の"],[25,1,"かみ"],[27,1,"ひと"],[30,1,"あい"]],"text":"イエスはますます知恵が加わり、背たけも伸び、そして神と人から愛された。"}]