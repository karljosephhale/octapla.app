[{"ref":"Judg.7.1","start":7007001,"end":7007001,"break":"paragraph","ruby":[[8,1,"よ"],[19,1,"かれ"],[21,1,"とも"],[29,1,"たみ"],[31,1,"あさ"],[32,1,"はや"],[34,1,"お"],[41,1,"いずみ"],[47,1,"じん"],[49,1,"と"],[60,1,"じん"],[62,1,"かれ"],[65,1,"きた"],[67,1,"ほう"],[75,1,"おか"],[77,1,"そ"],[80,1,"たに"],[82,1,"なか"]],"text":"さてエルバアルと呼ばれるギデオンおよび彼と共にいたすべての民は朝早く起き、ハロデの泉のほとりに陣を取った。ミデアンびとの陣は彼らの北の方にあり、モレの丘に沿って谷の中にあった。"},{"ref":"Judg.7.2","start":7007002,"end":7007002,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"い"],[17,1,"とも"],[21,1,"たみ"],[27,1,"おお"],[37,1,"かれ"],[40,1,"て"],[69,1,"む"],[77,1,"ほこ"],[85,2,"じしん"],[88,1,"て"],[90,2,"じぶん"],[93,1,"すく"],[100,1,"い"]],"text":"主はギデオンに言われた、「あなたと共におる民はあまりに多い。ゆえにわたしは彼らの手にミデアンびとをわたさない。おそらくイスラエルはわたしに向かってみずから誇り、『わたしは自身の手で自分を救ったのだ』と言うであろう。"},{"ref":"Judg.7.3","start":7007003,"end":7007003,"break":"none","ruby":[[5,1,"たみ"],[7,1,"みみ"],[9,1,"ふ"],[11,1,"しめ"],[20,1,"おそ"],[26,1,"もの"],[28,1,"かえ"],[32,1,"い"],[48,1,"かれ"],[51,1,"こころ"],[57,1,"たみ"],[61,1,"かえ"],[64,1,"もの"],[70,1,"にん"],[74,1,"のこ"],[77,1,"もの"],[81,1,"にん"]],"text":"それゆえ、民の耳に触れ示して、『だれでも恐れおののく者は帰れ』と言いなさい」。こうしてギデオンは彼らを試みたので、民のうち帰った者は二万二千人あり、残った者は一万人であった。"},{"ref":"Judg.7.4","start":7007004,"end":7007004,"break":"paragraph","ruby":[[0,1,"しゅ"],[9,1,"い"],[15,1,"たみ"],[19,1,"おお"],[22,1,"かれ"],[25,1,"みちび"],[28,1,"みず"],[32,1,"くだ"],[53,1,"かれ"],[56,1,"こころ"],[69,1,"つ"],[75,1,"ひと"],[81,1,"とも"],[83,1,"い"],[90,1,"い"],[92,1,"もの"],[99,1,"とも"],[101,1,"い"],[119,1,"つ"],[125,1,"ひと"],[131,1,"とも"],[133,1,"い"],[143,1,"い"],[145,1,"もの"],[151,1,"い"]],"text":"主はまたギデオンに言われた、「民はまだ多い。彼らを導いて水ぎわに下りなさい。わたしはそこで、あなたのために彼らを試みよう。わたしがあなたに告げて『この人はあなたと共に行くべきだ』と言う者は、あなたと共に行くべきである。またわたしがあなたに告げて『この人はあなたと共に行ってはならない』と言う者は、だれも行ってはならない」。"},{"ref":"Judg.7.5","start":7007005,"end":7007005,"break":"none","ruby":[[8,1,"たみ"],[10,1,"みちび"],[13,1,"みず"],[17,1,"くだ"],[21,1,"しゅ"],[23,1,"かれ"],[25,1,"い"],[34,1,"いぬ"],[42,1,"した"],[47,1,"みず"],[52,1,"もの"],[57,1,"べつ"],[75,1,"お"],[82,1,"みず"],[84,1,"の"],[86,1,"もの"]],"text":"そこでギデオンが民を導いて水ぎわに下ると、主は彼に言われた、「すべて犬のなめるように舌をもって水をなめる者はそれを別にしておきなさい。またすべてひざを折り、かがんで水を飲む者もそうしなさい」。"},{"ref":"Judg.7.6","start":7007006,"end":7007006,"break":"none","ruby":[[3,1,"て"],[5,1,"くち"],[10,1,"みず"],[15,1,"もの"],[17,1,"かず"],[21,1,"にん"],[27,1,"のこ"],[30,1,"たみ"],[37,1,"お"],[44,1,"みず"],[46,1,"の"]],"text":"そして手を口にあてて水をなめた者の数は三百人であった。残りの民はみなひざを折り、かがんで水を飲んだ。"},{"ref":"Judg.7.7","start":7007007,"end":7007007,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"い"],[17,1,"みず"],[24,1,"にん"],[26,1,"もの"],[38,1,"すく"],[52,1,"て"],[59,1,"のこ"],[62,1,"たみ"],[70,1,"いえ"],[72,1,"かえ"]],"text":"主はギデオンに言われた、「わたしは水をなめた三百人の者をもって、あなたがたを救い、ミデアンびとをあなたの手にわたそう。残りの民はおのおのその家に帰らせなさい」。"},{"ref":"Judg.7.8","start":7007008,"end":7007008,"break":"none","ruby":[[3,1,"かれ"],[9,1,"にん"],[11,1,"と"],[16,1,"のこ"],[27,1,"て"],[38,1,"と"],[41,1,"たみ"],[49,2,"てんまく"],[52,1,"かえ"],[57,1,"とき"],[66,1,"じん"],[68,1,"した"],[70,1,"たに"],[72,1,"なか"]],"text":"そこで彼はかの三百人を留めおき、残りのイスラエルびとの手から、つぼとラッパを取り、民をおのおのその天幕に帰らせた。時にミデアンびとの陣は下の谷の中にあった。"},{"ref":"Judg.7.9","start":7007009,"end":7007009,"break":"paragraph","ruby":[[2,1,"よる"],[4,1,"しゅ"],[11,1,"い"],[17,1,"た"],[21,1,"くだ"],[27,2,"てきじん"],[30,1,"せ"],[32,1,"い"],[46,1,"て"]],"text":"その夜、主はギデオンに言われた、「立てよ、下っていって敵陣に攻め入れ。わたしはそれをあなたの手にわたす。"},{"ref":"Judg.7.10","start":7007010,"end":7007010,"break":"none","ruby":[[6,1,"くだ"],[9,1,"い"],[14,1,"おそ"],[31,1,"とも"],[33,2,"てきじん"],[36,1,"くだ"]],"text":"もしあなたが下って行くことを恐れるならば、あなたのしもべプラと共に敵陣に下っていって、"},{"ref":"Judg.7.11","start":7007011,"end":7007011,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[9,1,"き"],[21,1,"て"],[23,1,"つよ"],[29,2,"てきじん"],[32,1,"せ"],[34,1,"くだ"],[59,1,"とも"],[61,1,"くだ"],[65,2,"てきじん"],[70,2,"へいたい"],[75,2,"ぜんしょう"],[77,2,"ちてん"],[80,1,"い"]],"text":"彼らの言うところを聞け。そうすればあなたの手が強くなって、敵陣に攻め下ることができるであろう」。ギデオンがしもべプラと共に下って、敵陣にある兵隊たちの前哨地点に行ってみると、"},{"ref":"Judg.7.12","start":7007012,"end":7007012,"break":"none","ruby":[[20,2,"とうほう"],[23,1,"たみ"],[32,2,"かずおお"],[35,1,"たに"],[37,1,"そ"],[40,1,"ふ"],[52,1,"うみ"],[55,1,"すな"],[60,1,"おお"],[63,1,"かぞ"]],"text":"ミデアンびと、アマレクびとおよびすべての東方の民はいなごのように数多く谷に沿って伏していた。そのらくだは海べの砂のように多くて数えきれなかった。"},{"ref":"Judg.7.13","start":7007013,"end":7007013,"break":"none","ruby":[[8,1,"い"],[16,1,"ひと"],[20,2,"なかま"],[23,1,"ゆめ"],[25,1,"かた"],[33,1,"ひと"],[35,1,"い"],[44,1,"ゆめ"],[46,1,"み"],[49,2,"おおむぎ"],[62,2,"じんちゅう"],[73,2,"てんまく"],[76,1,"たっ"],[82,1,"う"],[84,1,"たお"],[96,2,"てんまく"],[99,1,"たお"],[101,1,"ふ"]],"text":"ギデオンがそこへ行ったとき、ある人がその仲間に夢を語っていた。その人は言った、「わたしは夢を見た。大麦のパン一つがミデアンの陣中にころがってきて、天幕に達し、それを打ち倒し、くつがえしたので、天幕は倒れ伏した」。"},{"ref":"Judg.7.14","start":7007014,"end":7007014,"break":"none","ruby":[[0,2,"なかま"],[3,1,"こた"],[6,1,"い"],[20,1,"ひと"],[26,1,"こ"],[42,1,"かみ"],[53,2,"ぐんぜい"],[56,1,"かれ"],[58,1,"て"]],"text":"仲間は答えて言った、「それはイスラエルの人、ヨアシの子ギデオンのつるぎにちがいない。神はミデアンとすべての軍勢を彼の手にわたされるのだ」。"},{"ref":"Judg.7.15","start":7007015,"end":7007015,"break":"paragraph","ruby":[[5,1,"ゆめ"],[7,2,"ものがたり"],[12,1,"と"],[14,1,"あ"],[19,1,"き"],[25,2,"れいはい"],[35,2,"じんえい"],[38,1,"かえ"],[44,1,"い"],[49,1,"た"],[53,1,"しゅ"],[60,2,"ぐんぜい"],[69,1,"て"]],"text":"ギデオンは夢の物語とその解き明かしとを聞いたので、礼拝し、イスラエルの陣営に帰り、そして言った、「立てよ、主はミデアンの軍勢をあなたがたの手にわたされる」。"},{"ref":"Judg.7.16","start":7007016,"end":7007016,"break":"none","ruby":[[3,1,"かれ"],[7,1,"にん"],[10,1,"くみ"],[12,1,"わ"],[15,1,"て"],[17,1,"て"],[30,1,"と"],[37,1,"なか"]],"text":"そして彼は三百人を三組に分け、手に手にラッパと、からつぼとを取らせ、つぼの中にたいまつをともさせ、"},{"ref":"Judg.7.17","start":7007017,"end":7007017,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[12,1,"み"],[33,2,"てきじん"],[40,1,"たっ"]],"text":"彼らに言った、「わたしを見て、わたしのするようにしなさい。わたしが敵陣のはずれに達したとき、あなたがたもわたしのするようにしなさい。"},{"ref":"Judg.7.18","start":7007018,"end":7007018,"break":"none","ruby":[[4,1,"とも"],[8,1,"もの"],[16,1,"ふ"],[32,2,"じんえい"],[35,2,"しほう"],[42,1,"ふ"],[46,1,"しゅ"],[62,1,"い"]],"text":"わたしと共におる者がみなラッパを吹くと、あなたがたもまたすべての陣営の四方でラッパを吹き、『主のためだ、ギデオンのためだ』と言いなさい」。"},{"ref":"Judg.7.19","start":7007019,"end":7007019,"break":"paragraph","ruby":[[10,1,"かれ"],[12,1,"とも"],[17,1,"にん"],[19,1,"もの"],[22,2,"ちゅうこう"],[25,1,"はじ"],[28,2,"てきじん"],[35,1,"い"],[46,2,"ばんぺい"],[49,2,"こうたい"],[53,1,"とき"],[61,1,"かれ"],[68,1,"ふ"],[71,1,"て"],[73,1,"たずさ"],[81,1,"う"],[83,1,"くだ"]],"text":"こうしてギデオンと、彼と共にいた百人の者が、中更の初めに敵陣のはずれに行ってみると、ちょうど番兵を交代した時であったので、彼らはラッパを吹き、手に携えていたつぼを打ち砕いた。"},{"ref":"Judg.7.20","start":7007020,"end":7007020,"break":"none","ruby":[[5,1,"くみ"],[7,1,"もの"],[13,1,"ふ"],[19,1,"う"],[21,1,"くだ"],[24,1,"ひだり"],[26,1,"て"],[37,1,"みぎ"],[39,1,"て"],[46,1,"も"],[52,1,"ふ"],[56,1,"しゅ"],[78,1,"さけ"]],"text":"すなわち三組の者がラッパを吹き、つぼを打ち砕き、左の手にはたいまつをとり、右の手にはラッパを持ってそれを吹き、「主のためのつるぎ、ギデオンのためのつるぎ」と叫んだ。"},{"ref":"Judg.7.21","start":7007021,"end":7007021,"break":"none","ruby":[[9,1,"も"],[11,1,"ば"],[13,1,"た"],[16,2,"てきじん"],[19,1,"と"],[21,1,"かこ"],[27,1,"てき"],[28,1,"ぐん"],[32,1,"はし"],[35,2,"おおごえ"],[41,1,"に"],[43,1,"さ"]],"text":"そしておのおのその持ち場に立ち、敵陣を取り囲んだので、敵軍はみな走り、大声をあげて逃げ去った。"},{"ref":"Judg.7.22","start":7007022,"end":7007022,"break":"none","ruby":[[2,1,"にん"],[11,1,"ふ"],[15,1,"しゅ"],[17,1,"てき"],[18,1,"ぐん"],[24,1,"たがい"],[26,2,"どうし"],[28,1,"う"],[38,1,"てき"],[39,1,"ぐん"],[45,1,"ほう"],[62,1,"さかい"],[68,1,"ちか"],[72,1,"に"],[74,1,"さ"]],"text":"三百人のものがラッパを吹くと、主は敵軍をしてみな互に同志打ちさせられたので、敵軍はゼレラの方、ベテシッタおよびアベルメホラの境、タバテの近くまで逃げ去った。"},{"ref":"Judg.7.23","start":7007023,"end":7007023,"break":"none","ruby":[[6,2,"ひとびと"],[20,1,"ぜん"],[26,1,"あつ"],[40,2,"ついげき"]],"text":"イスラエルの人々はナフタリ、アセルおよび全マナセから集まってきて、ミデアンびとを追撃した。"},{"ref":"Judg.7.24","start":7007024,"end":7007024,"break":"paragraph","ruby":[[5,2,"ししゃ"],[18,2,"さんち"],[27,1,"くだ"],[40,1,"せ"],[48,1,"いた"],[53,1,"なが"],[56,1,"と"],[67,1,"と"],[71,1,"い"],[85,2,"ひとびと"],[90,1,"あつ"],[102,1,"いた"],[107,1,"なが"],[110,1,"と"],[121,1,"と"]],"text":"ギデオンは使者をあまねくエフライムの山地につかわし、「下ってきて、ミデアンびとを攻め、ベタバラに至るまでの流れを取り、またヨルダンをも取れ」と言わせた。そこでエフライムの人々はみな集まってきて、ベタバラに至るまでの流れを取り、またヨルダンをも取った。"},{"ref":"Judg.7.25","start":7007025,"end":7007025,"break":"none","ruby":[[0,1,"かれ"],[16,1,"きみ"],[25,1,"とら"],[35,1,"いわ"],[41,1,"ころ"],[52,1,"さか"],[60,1,"ころ"],[73,2,"ついげき"],[85,1,"くび"],[87,1,"たずさ"],[95,1,"む"],[107,1,"い"]],"text":"彼らはまたミデアンびとのふたりの君オレブとゼエブを捕え、オレブをオレブ岩のほとりで殺し、ゼエブをゼエブの酒ぶねのほとりで殺した。またミデアンびとを追撃し、オレブとゼエブの首を携えてヨルダンの向こうのギデオンのもとへ行った。"}]