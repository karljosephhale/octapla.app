[{"ref":"Matt.11.1","start":40011001,"end":40011001,"break":"paragraph","ruby":[[6,2,"でし"],[14,1,"めい"],[16,1,"お"],[22,2,"まちまち"],[25,1,"おし"],[29,1,"の"],[31,1,"つた"],[41,1,"た"],[43,1,"さ"]],"text":"イエスは十二弟子にこのように命じ終えてから、町々で教えまた宣べ伝えるために、そこを立ち去られた。"},{"ref":"Matt.11.2","start":40011002,"end":40011002,"break":"paragraph","ruby":[[7,2,"ごくちゅう"],[22,1,"つた"],[24,1,"き"],[27,2,"じぶん"],[30,2,"でし"]],"text":"さて、ヨハネは獄中でキリストのみわざについて伝え聞き、自分の弟子たちをつかわして、"},{"ref":"Matt.11.3","start":40011003,"end":40011003,"break":"none","ruby":[[4,1,"い"],[41,1,"ま"]],"text":"イエスに言わせた、「『きたるべきかた』はあなたなのですか。それとも、ほかにだれかを待つべきでしょうか」。"},{"ref":"Matt.11.4","start":40011004,"end":40011004,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[13,1,"い"],[23,2,"みき"],[37,2,"ほうこく"]],"text":"イエスは答えて言われた、「行って、あなたがたが見聞きしていることをヨハネに報告しなさい。"},{"ref":"Matt.11.5","start":40011005,"end":40011005,"break":"none","ruby":[[0,2,"もうじん"],[3,1,"み"],[6,1,"あし"],[10,1,"ある"],[15,2,"びょうにん"],[23,1,"みみ"],[27,1,"きこ"],[30,2,"しにん"],[33,1,"い"],[39,1,"まず"],[42,2,"ひとびと"],[45,2,"ふくいん"],[48,1,"き"]],"text":"盲人は見え、足なえは歩き、らい病人はきよまり、耳しいは聞え、死人は生きかえり、貧しい人々は福音を聞かされている。"},{"ref":"Matt.11.6","start":40011006,"end":40011006,"break":"none","ruby":[[10,1,"もの"]],"text":"わたしにつまずかない者は、さいわいである」。"},{"ref":"Matt.11.7","start":40011007,"end":40011007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かえ"],[22,2,"ぐんしゅう"],[25,1,"かた"],[42,1,"なに"],[44,1,"み"],[46,2,"あらの"],[49,1,"で"],[56,1,"かぜ"],[58,1,"ゆ"],[61,1,"あし"]],"text":"彼らが帰ってしまうと、イエスはヨハネのことを群衆に語りはじめられた、「あなたがたは、何を見に荒野に出てきたのか。風に揺らぐ葦であるか。"},{"ref":"Matt.11.8","start":40011008,"end":40011008,"break":"none","ruby":[[3,1,"なに"],[5,1,"み"],[7,1,"で"],[14,1,"やわ"],[18,2,"きもの"],[25,1,"ひと"],[28,1,"やわ"],[32,2,"きもの"],[39,2,"ひとびと"],[44,1,"おう"],[46,1,"いえ"]],"text":"では、何を見に出てきたのか。柔らかい着物をまとった人か。柔らかい着物をまとった人々なら、王の家にいる。"},{"ref":"Matt.11.9","start":40011009,"end":40011009,"break":"none","ruby":[[9,1,"で"],[16,3,"よげんしゃ"],[20,1,"み"],[36,1,"い"],[40,3,"よげんしゃ"],[43,2,"いじょう"],[46,1,"もの"]],"text":"では、なんのために出てきたのか。預言者を見るためか。そうだ、あなたがたに言うが、預言者以上の者である。"},{"ref":"Matt.11.10","start":40011010,"end":40011010,"break":"stanza","breaks":[[21,"line"]],"ruby":[[1,1,"み"],[8,1,"つかい"],[14,1,"さき"],[25,1,"まえ"],[28,1,"みち"],[30,1,"ととの"],[41,1,"か"],[51,1,"ひと"]],"text":"『見よ、わたしは使をあなたの先につかわし、あなたの前に、道を整えさせるであろう』と書いてあるのは、この人のことである。"},{"ref":"Matt.11.11","start":40011011,"end":40011011,"break":"none","ruby":[[8,1,"い"],[14,1,"おんな"],[16,1,"う"],[19,1,"もの"],[21,1,"なか"],[35,1,"おお"],[38,2,"じんぶつ"],[41,1,"おこ"],[52,2,"てんごく"],[55,1,"もっと"],[57,1,"ちい"],[60,1,"もの"],[63,1,"かれ"],[67,1,"おお"]],"text":"あなたがたによく言っておく。女の産んだ者の中で、バプテスマのヨハネより大きい人物は起らなかった。しかし、天国で最も小さい者も、彼よりは大きい。"},{"ref":"Matt.11.12","start":40011012,"end":40011012,"break":"none","ruby":[[10,1,"とき"],[13,1,"いま"],[15,1,"いた"],[20,2,"てんごく"],[23,1,"はげ"],[26,1,"おそ"],[36,1,"はげ"],[39,1,"おそ"],[41,1,"もの"],[48,1,"うば"],[50,1,"と"]],"text":"バプテスマのヨハネの時から今に至るまで、天国は激しく襲われている。そして激しく襲う者たちがそれを奪い取っている。"},{"ref":"Matt.11.13","start":40011013,"end":40011013,"break":"none","ruby":[[4,3,"よげんしゃ"],[8,2,"りっぽう"],[12,2,"よげん"],[23,1,"とき"]],"text":"すべての預言者と律法とが預言したのは、ヨハネの時までである。"},{"ref":"Matt.11.14","start":40011014,"end":40011014,"break":"none","ruby":[[12,1,"う"],[20,1,"のぞ"],[26,1,"ひと"]],"text":"そして、もしあなたがたが受けいれることを望めば、この人こそは、きたるべきエリヤなのである。"},{"ref":"Matt.11.15","start":40011015,"end":40011015,"break":"none","ruby":[[0,1,"みみ"],[4,1,"もの"],[6,1,"き"]],"text":"耳のある者は聞くがよい。"},{"ref":"Matt.11.16","start":40011016,"end":40011016,"break":"paragraph","ruby":[[0,1,"いま"],[2,2,"じだい"],[5,1,"なに"],[7,1,"くら"],[16,2,"こども"],[21,2,"ひろば"],[32,2,"こども"],[37,1,"よ"]],"text":"今の時代を何に比べようか。それは子供たちが広場にすわって、ほかの子供たちに呼びかけ、"},{"ref":"Matt.11.17","start":40011017,"end":40011017,"break":"stanza","breaks":[[15,"line"],[31,"line"],[42,"line"]],"ruby":[[7,1,"ふえ"],[9,1,"ふ"],[21,1,"おど"],[31,1,"とむら"],[34,1,"うた"],[36,1,"うた"],[42,1,"むね"],[44,1,"う"],[55,1,"い"],[59,1,"に"]],"text":"『わたしたちが笛を吹いたのに、あなたたちは踊ってくれなかった。弔いの歌を歌ったのに、胸を打ってくれなかった』と言うのに似ている。"},{"ref":"Matt.11.18","start":40011018,"end":40011018,"break":"none","ruby":[[12,1,"た"],[19,1,"の"],[32,2,"あくれい"],[45,1,"い"]],"text":"なぜなら、ヨハネがきて、食べることも、飲むこともしないと、あれは悪霊につかれているのだ、と言い、"},{"ref":"Matt.11.19","start":40011019,"end":40011019,"break":"none","ruby":[[2,1,"ひと"],[4,1,"こ"],[9,1,"た"],[13,1,"の"],[23,1,"み"],[29,1,"しょく"],[35,1,"もの"],[37,2,"おおざけ"],[40,1,"の"],[42,1,"もの"],[46,3,"しゅぜいにん"],[50,2,"つみびと"],[53,2,"なかま"],[58,1,"い"],[65,2,"ちえ"],[68,1,"ただ"],[77,1,"はたら"],[80,2,"しょうめい"]],"text":"また人の子がきて、食べたり飲んだりしていると、見よ、あれは食をむさぼる者、大酒を飲む者、また取税人、罪人の仲間だ、と言う。しかし、知恵の正しいことは、その働きが証明する」。"},{"ref":"Matt.11.20","start":40011020,"end":40011020,"break":"paragraph","ruby":[[9,2,"かずかず"],[12,1,"ちから"],[25,1,"く"],[27,1,"あらた"],[38,2,"まちまち"],[42,1,"せ"]],"text":"それからイエスは、数々の力あるわざがなされたのに、悔い改めることをしなかった町々を、責めはじめられた。"},{"ref":"Matt.11.21","start":40011021,"end":40011021,"break":"none","ruby":[[39,1,"ちから"],[62,1,"かれ"],[68,1,"むかし"],[71,2,"あらぬの"],[77,1,"はい"],[84,1,"く"],[86,1,"あらた"]],"text":"「わざわいだ、コラジンよ。わざわいだ、ベツサイダよ。おまえたちのうちでなされた力あるわざが、もしツロとシドンでなされたなら、彼らはとうの昔に、荒布をまとい灰をかぶって、悔い改めたであろう。"},{"ref":"Matt.11.22","start":40011022,"end":40011022,"break":"none","ruby":[[10,1,"い"],[20,1,"ひ"],[31,1,"ほう"],[42,1,"た"]],"text":"しかし、おまえたちに言っておく。さばきの日には、ツロとシドンの方がおまえたちよりも、耐えやすいであろう。"},{"ref":"Matt.11.23","start":40011023,"end":40011023,"break":"none","ruby":[[14,1,"てん"],[18,1,"あ"],[32,2,"よみ"],[37,1,"おと"],[50,1,"なか"],[56,1,"ちから"],[78,1,"まち"],[80,2,"きょう"],[85,1,"のこ"]],"text":"ああ、カペナウムよ、おまえは天にまで上げられようとでもいうのか。黄泉にまで落されるであろう。おまえの中でなされた力あるわざが、もしソドムでなされたなら、その町は今日までも残っていたであろう。"},{"ref":"Matt.11.24","start":40011024,"end":40011024,"break":"none","ruby":[[10,1,"い"],[17,1,"ひ"],[25,1,"ち"],[27,1,"ほう"],[35,1,"た"]],"text":"しかし、あなたがたに言う。さばきの日には、ソドムの地の方がおまえよりは耐えやすいであろう」。"},{"ref":"Matt.11.25","start":40011025,"end":40011025,"break":"paragraph","ruby":[[8,1,"こえ"],[13,1,"い"],[19,2,"てんち"],[22,1,"しゅ"],[25,1,"ちち"],[44,1,"こと"],[46,2,"ちえ"],[51,1,"もの"],[53,1,"かしこ"],[55,1,"もの"],[57,1,"かく"],[61,1,"おさ"],[63,1,"ご"]],"text":"そのときイエスは声をあげて言われた、「天地の主なる父よ。あなたをほめたたえます。これらの事を知恵のある者や賢い者に隠して、幼な子にあらわしてくださいました。"},{"ref":"Matt.11.26","start":40011026,"end":40011026,"break":"none","ruby":[[0,1,"ちち"],[19,1,"こと"]],"text":"父よ、これはまことにみこころにかなった事でした。"},{"ref":"Matt.11.27","start":40011027,"end":40011027,"break":"none","ruby":[[4,1,"こと"],[6,1,"ちち"],[13,1,"まか"],[26,1,"こ"],[28,1,"し"],[30,1,"もの"],[32,1,"ちち"],[41,1,"ちち"],[43,1,"し"],[45,1,"もの"],[48,1,"こ"],[51,1,"ちち"],[61,1,"こ"],[63,1,"えら"],[66,1,"もの"]],"text":"すべての事は父からわたしに任せられています。そして、子を知る者は父のほかにはなく、父を知る者は、子と、父をあらわそうとして子が選んだ者とのほかに、だれもありません。"},{"ref":"Matt.11.28","start":40011028,"end":40011028,"break":"paragraph","ruby":[[3,2,"おもに"],[6,1,"お"],[9,2,"くろう"],[15,1,"もの"],[36,1,"やす"]],"text":"すべて重荷を負うて苦労している者は、わたしのもとにきなさい。あなたがたを休ませてあげよう。"},{"ref":"Matt.11.29","start":40011029,"end":40011029,"break":"none","ruby":[[4,2,"にゅうわ"],[7,1,"こころ"],[15,1,"もの"],[30,1,"お"],[38,1,"まな"],[56,1,"たましい"],[58,1,"やす"],[61,1,"あた"]],"text":"わたしは柔和で心のへりくだった者であるから、わたしのくびきを負うて、わたしに学びなさい。そうすれば、あなたがたの魂に休みが与えられるであろう。"},{"ref":"Matt.11.30","start":40011030,"end":40011030,"break":"none","ruby":[[8,1,"お"],[18,1,"に"],[20,1,"かる"]],"text":"わたしのくびきは負いやすく、わたしの荷は軽いからである」。"}]