[{"ref":"2Chr.33.1","start":14033001,"end":14033001,"break":"paragraph","ruby":[[6,1,"さい"],[8,1,"おう"],[16,1,"ねん"],[18,1,"あいだ"],[25,1,"よ"],[27,1,"おさ"]],"text":"マナセは十二歳で王となり、五十五年の間エルサレムで世を治めた。"},{"ref":"2Chr.33.2","start":14033002,"end":14033002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[10,2,"ひとびと"],[13,1,"まえ"],[16,1,"お"],[18,1,"はら"],[22,2,"くにぐに"],[25,1,"たみ"],[27,1,"にく"],[31,1,"おこな"],[34,1,"み"],[40,1,"しゅ"],[42,1,"め"],[44,1,"まえ"],[46,1,"あく"],[48,1,"おこな"]],"text":"彼は主がイスラエルの人々の前から追い払われた国々の民の憎むべき行いに見ならって、主の目の前に悪を行った。"},{"ref":"2Chr.33.3","start":14033003,"end":14033003,"break":"none","ruby":[[7,1,"ちち"],[17,1,"たか"],[19,1,"ところ"],[21,1,"ふたた"],[23,1,"きず"],[40,2,"さいだん"],[43,1,"もう"],[49,1,"ぞう"],[51,1,"つく"],[54,1,"てん"],[56,2,"ばんしょう"],[59,1,"おが"],[66,1,"つか"]],"text":"すなわち、その父ヒゼキヤがこわした高き所を再び築き、またもろもろのバアルのために祭壇を設け、アシラ像を造り、天の万象を拝んで、これに仕え、"},{"ref":"2Chr.33.4","start":14033004,"end":14033004,"break":"none","ruby":[[2,1,"しゅ"],[7,1,"な"],[9,2,"えいえん"],[22,1,"い"],[26,1,"しゅ"],[28,1,"みや"],[33,2,"すうこ"],[36,2,"さいだん"],[39,1,"きず"]],"text":"また主が「わが名は永遠にエルサレムにある」と言われた主の宮のうちに数個の祭壇を築き、"},{"ref":"2Chr.33.5","start":14033005,"end":14033005,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"みや"],[7,1,"にわ"],[9,1,"てん"],[11,2,"ばんしょう"],[17,2,"さいだん"],[20,1,"きず"]],"text":"主の宮の二つの庭に天の万象のために祭壇を築いた。"},{"ref":"2Chr.33.6","start":14033006,"end":14033006,"break":"none","ruby":[[0,1,"かれ"],[11,1,"たに"],[15,1,"こ"],[16,1,"とも"],[18,1,"ひ"],[20,1,"や"],[23,1,"そな"],[25,1,"もの"],[29,1,"うらな"],[34,2,"まほう"],[46,1,"おこな"],[49,2,"くちよ"],[54,1,"うらな"],[56,1,"し"],[58,2,"にんよう"],[65,1,"しゅ"],[67,1,"まえ"],[69,1,"おお"],[72,1,"あく"],[74,1,"い"],[80,1,"いか"],[85,1,"おこ"]],"text":"彼はまたベンヒンノムの谷でその子供を火に焼いて供え物とし、占いをし、魔法をつかい、まじないを行い、口寄せと、占い師を任用するなど、主の前に多くの悪を行って、その怒りをひき起した。"},{"ref":"2Chr.33.7","start":14033007,"end":14033007,"break":"none","ruby":[[0,1,"かれ"],[4,1,"きざ"],[7,2,"ぐうぞう"],[10,1,"つく"],[13,1,"かみ"],[15,1,"みや"],[17,2,"あんち"],[22,1,"かみ"],[26,1,"みや"],[37,1,"こ"],[43,1,"い"],[60,1,"みや"],[77,2,"ぶぞく"],[84,1,"えら"],[99,1,"な"],[101,2,"えいえん"],[104,1,"お"]],"text":"彼はまた刻んだ偶像を造って神の宮に安置した。神はこの宮についてダビデとその子ソロモンに言われたことがある、「わたしはこの宮と、わたしがイスラエルのすべての部族のうちから選んだエルサレムとに、わたしの名を永遠に置く。"},{"ref":"2Chr.33.8","start":14033008,"end":14033008,"break":"none","ruby":[[0,1,"かれ"],[13,1,"めい"],[16,1,"こと"],[27,1,"つた"],[34,2,"りっぽう"],[37,1,"さだ"],[45,1,"つつし"],[48,1,"おこな"],[64,2,"せんぞ"],[70,1,"さだ"],[73,1,"ち"],[77,1,"かさ"],[86,1,"あし"],[88,1,"うつ"]],"text":"彼らがもし、わたしがすべて命じた事、すなわち、モーセが伝えたすべての律法と定めとおきてとを慎んで行うならば、わたしがあなたがたの先祖のために定めた地から、重ねてイスラエルの足を移すことをしない」と。"},{"ref":"2Chr.33.9","start":14033009,"end":14033009,"break":"none","ruby":[[18,2,"じゅうみん"],[21,1,"まよ"],[25,1,"しゅ"],[33,2,"ひとびと"],[36,1,"まえ"],[38,1,"ほろ"],[43,2,"くにぐに"],[46,1,"たみ"],[53,1,"あく"],[55,1,"おこな"]],"text":"マナセはこのようにユダとエルサレムの住民を迷わせ、主がイスラエルの人々の前に滅ぼされた国々の民にもまさって悪を行わせた。"},{"ref":"2Chr.33.10","start":14033010,"end":14033010,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"たみ"],[12,1,"つ"],[19,1,"かれ"],[22,1,"こころ"],[24,1,"と"]],"text":"主はマナセおよびその民に告げられたが、彼らは心に留めなかった。"},{"ref":"2Chr.33.11","start":14033011,"end":14033011,"break":"none","ruby":[[5,1,"しゅ"],[13,1,"おう"],[15,2,"ぐんぜい"],[18,1,"しょ"],[19,1,"しょう"],[24,1,"せ"],[35,1,"かれ"],[45,1,"とら"],[48,2,"せいどう"],[64,1,"ひ"],[67,1,"い"]],"text":"それゆえ、主はアッスリヤの王の軍勢の諸将をこれに攻めこさせられたので、彼らはマナセをかぎで捕え、青銅のかせにつないで、バビロンに引いて行った。"},{"ref":"2Chr.33.12","start":14033012,"end":14033012,"break":"none","ruby":[[0,1,"かれ"],[2,1,"なや"],[8,1,"およ"],[14,1,"かみ"],[16,1,"しゅ"],[18,1,"ねが"],[20,1,"もと"],[25,2,"せんぞ"],[28,1,"かみ"],[30,1,"まえ"],[32,1,"おお"],[35,1,"み"],[37,1,"ひく"]],"text":"彼は悩みにあうに及んで、その神、主に願い求め、その先祖の神の前に大いに身を低くして、"},{"ref":"2Chr.33.13","start":14033013,"end":14033013,"break":"none","ruby":[[0,1,"かみ"],[2,1,"いの"],[8,1,"かみ"],[12,1,"いのり"],[14,1,"う"],[21,1,"ねが"],[24,1,"き"],[27,1,"かれ"],[35,1,"つ"],[37,1,"かえ"],[41,1,"ふたた"],[43,1,"くに"],[45,1,"のぞ"],[62,1,"しゅ"],[70,1,"かみ"],[78,1,"し"]],"text":"神に祈ったので、神はその祈を受けいれ、その願いを聞き、彼をエルサレムに連れ帰って、再び国に臨ませられた。これによってマナセは主こそ、まことに神にいますことを知った。"},{"ref":"2Chr.33.14","start":14033014,"end":14033014,"break":"paragraph","ruby":[[2,1,"のち"],[4,1,"かれ"],[10,1,"まち"],[12,1,"そと"],[14,1,"いし"],[22,1,"にし"],[24,1,"ほう"],[26,1,"たに"],[31,1,"きず"],[34,1,"うお"],[36,1,"もん"],[38,2,"いりぐち"],[43,1,"およ"],[53,1,"いし"],[63,2,"ひじょう"],[66,1,"たか"],[71,1,"きず"],[73,1,"あ"],[83,2,"けんご"],[86,1,"まち"],[88,1,"ぐん"],[89,1,"ちょう"],[91,1,"お"]],"text":"この後、彼はダビデの町の外の石がきをギホンの西の方の谷のうちに築き、魚の門の入口にまで及ぼし、またオペルに石がきをめぐらして、非常に高くこれを築き上げ、ユダのすべての堅固な町に軍長を置き、"},{"ref":"2Chr.33.15","start":14033015,"end":14033015,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"みや"],[8,2,"いほう"],[11,2,"かみがみ"],[16,2,"ぐうぞう"],[19,1,"と"],[21,1,"のぞ"],[24,1,"しゅ"],[26,1,"みや"],[28,1,"やま"],[36,2,"じぶん"],[39,1,"きず"],[46,2,"さいだん"],[49,1,"と"],[51,1,"のぞ"],[55,1,"まち"],[57,1,"そと"],[59,1,"な"],[61,1,"す"]],"text":"また主の宮から、異邦の神々および偶像を取り除き、主の宮の山とエルサレムに自分で築いたすべての祭壇を取り除いて、町の外に投げ捨て、"},{"ref":"2Chr.33.16","start":14033016,"end":14033016,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"さいだん"],[5,1,"きず"],[7,1,"なお"],[11,3,"しゅうおんさい"],[17,2,"かんしゃ"],[20,2,"ぎせい"],[26,1,"うえ"],[35,1,"めい"],[44,1,"かみ"],[46,1,"しゅ"],[48,1,"つか"]],"text":"主の祭壇を築き直して、酬恩祭および感謝の犠牲を、その上にささげ、ユダに命じてイスラエルの神、主に仕えさせた。"},{"ref":"2Chr.33.17","start":14033017,"end":14033017,"break":"none","ruby":[[3,1,"たみ"],[8,1,"たか"],[10,1,"ところ"],[12,2,"ぎせい"],[25,1,"かみ"],[27,1,"しゅ"]],"text":"しかし民は、なお高き所で犠牲をささげた。ただしその神、主にのみささげた。"},{"ref":"2Chr.33.18","start":14033018,"end":14033018,"break":"paragraph","ruby":[[9,2,"こうい"],[14,1,"かみ"],[20,1,"いのり"],[31,1,"かみ"],[33,1,"しゅ"],[35,1,"な"],[40,1,"かれ"],[42,1,"つ"],[45,3,"せんけんしゃ"],[51,2,"ことば"],[61,1,"れつ"],[62,1,"おう"],[64,2,"きろく"]],"text":"マナセのそのほかの行為、その神にささげた祈、およびイスラエルの神、主の名をもって彼に告げた先見者たちの言葉は、イスラエルの列王の記録のうちにしるされている。"},{"ref":"2Chr.33.19","start":14033019,"end":14033019,"break":"none","ruby":[[4,1,"いのり"],[7,1,"いのり"],[9,1,"き"],[13,1,"こと"],[22,1,"つみ"],[30,1,"み"],[32,1,"ひく"],[36,1,"まえ"],[38,1,"たか"],[40,1,"ところ"],[42,1,"きず"],[49,1,"ぞう"],[53,1,"きざ"],[56,1,"ぞう"],[58,1,"た"],[61,2,"ばしょ"],[67,3,"せんけんしゃ"],[71,2,"きろく"]],"text":"またその祈と、祈の聞かれた事、そのもろもろの罪と、とが、その身を低くする前に高き所を築いて、アシラ像および刻んだ像を立てた場所などは、先見者の記録のうちにしるされている。"},{"ref":"2Chr.33.20","start":14033020,"end":14033020,"break":"none","ruby":[[6,2,"せんぞ"],[11,1,"とも"],[13,1,"ねむ"],[21,1,"いえ"],[23,1,"ほうむ"],[30,1,"こ"],[35,1,"かれ"],[37,1,"かわ"],[40,1,"おう"]],"text":"マナセはその先祖たちと共に眠ったので、その家に葬られた。その子アモンが彼に代って王となった。"},{"ref":"2Chr.33.21","start":14033021,"end":14033021,"break":"paragraph","ruby":[[4,1,"おう"],[9,1,"とき"],[13,1,"さい"],[17,1,"ねん"],[19,1,"あいだ"],[26,1,"よ"],[28,1,"おさ"]],"text":"アモンは王となった時二十二歳で、二年の間エルサレムで世を治めた。"},{"ref":"2Chr.33.22","start":14033022,"end":14033022,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ちち"],[14,1,"しゅ"],[16,1,"まえ"],[18,1,"あく"],[20,1,"おこな"],[34,1,"ちち"],[39,1,"つく"],[47,1,"きざ"],[50,1,"ぞう"],[52,2,"ぎせい"],[63,1,"つか"]],"text":"彼はその父マナセのしたように主の前に悪を行った。すなわちアモンはその父マナセが造ったもろもろの刻んだ像に犠牲をささげて、これに仕え、"},{"ref":"2Chr.33.23","start":14033023,"end":14033023,"break":"none","ruby":[[2,1,"ちち"],[7,1,"み"],[9,1,"ひく"],[16,1,"しゅ"],[18,1,"まえ"],[20,1,"み"],[22,1,"ひく"],[50,1,"ま"]],"text":"その父マナセが身を低くしたように主の前に身を低くしなかった。かえってこのアモンは、いよいよそのとがを増した。"},{"ref":"2Chr.33.24","start":14033024,"end":14033024,"break":"none","ruby":[[2,2,"けらい"],[7,1,"とう"],[9,1,"むす"],[12,1,"かれ"],[18,1,"かれ"],[22,1,"いえ"],[24,1,"ころ"]],"text":"その家来たちは党を結んで彼にそむき、彼をその家で殺した。"},{"ref":"2Chr.33.25","start":14033025,"end":14033025,"break":"none","ruby":[[3,1,"くに"],[5,1,"たみ"],[8,1,"とう"],[10,1,"むす"],[16,1,"おう"],[22,1,"もの"],[31,1,"う"],[33,1,"ころ"],[40,1,"くに"],[42,1,"たみ"],[46,1,"こ"],[51,1,"おう"],[62,1,"つ"]],"text":"しかし国の民は、党を結んでアモン王にそむいた者どもをことごとく撃ち殺した。そして国の民はその子ヨシヤを王となして、そのあとを継がせた。"}]