[{"ref":"Rev.16.1","start":66016001,"end":66016001,"break":"paragraph","ruby":[[5,1,"おお"],[8,1,"こえ"],[10,2,"せいじょ"],[14,1,"で"],[18,1,"にん"],[20,2,"みつかい"],[30,1,"い"],[34,1,"かみ"],[36,1,"はげ"],[39,1,"いか"],[45,1,"はち"],[48,1,"ち"],[50,1,"かたむ"],[55,1,"い"],[59,1,"き"]],"text":"それから、大きな声が聖所から出て、七人の御使にむかい、「さあ行って、神の激しい怒りの七つの鉢を、地に傾けよ」と言うのを聞いた。"},{"ref":"Rev.16.2","start":66016002,"end":66016002,"break":"paragraph","ruby":[[4,1,"だい"],[7,1,"もの"],[9,1,"で"],[11,1,"い"],[17,1,"はち"],[19,1,"ち"],[21,1,"かたむ"],[29,1,"けもの"],[31,2,"こくいん"],[34,1,"も"],[36,2,"ひとびと"],[42,1,"ぞう"],[44,1,"おが"],[46,2,"ひとびと"],[58,2,"あくせい"],[63,1,"もの"]],"text":"そして、第一の者が出て行って、その鉢を地に傾けた。すると、獣の刻印を持つ人々と、その像を拝む人々とのからだに、ひどい悪性のでき物ができた。"},{"ref":"Rev.16.3","start":66016003,"end":66016003,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"もの"],[8,1,"はち"],[10,1,"うみ"],[12,1,"かたむ"],[20,1,"うみ"],[22,2,"しにん"],[25,1,"ち"],[36,1,"なか"],[38,1,"い"],[40,1,"もの"],[44,1,"し"]],"text":"第二の者が、その鉢を海に傾けた。すると、海は死人の血のようになって、その中の生き物がみな死んでしまった。"},{"ref":"Rev.16.4","start":66016004,"end":66016004,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"もの"],[7,1,"はち"],[9,1,"かわ"],[11,1,"みず"],[13,1,"みなもと"],[16,1,"かたむ"],[26,1,"ち"]],"text":"第三の者がその鉢を川と水の源とに傾けた。すると、みな血になった。"},{"ref":"Rev.16.5","start":66016005,"end":66016005,"break":"none","ruby":[[5,1,"みず"],[12,2,"みつかい"],[17,1,"い"],[22,1,"き"],[27,1,"いま"],[32,1,"むかし"],[37,1,"せい"],[40,1,"もの"],[49,1,"さだ"],[60,1,"ただ"]],"text":"それから、水をつかさどる御使がこう言うのを、聞いた、「今いまし、昔いませる聖なる者よ。このようにお定めになったあなたは、正しいかたであります。"},{"ref":"Rev.16.6","start":66016006,"end":66016006,"break":"none","ruby":[[0,2,"せいと"],[3,3,"よげんしゃ"],[8,1,"ち"],[10,1,"なが"],[13,1,"もの"],[18,1,"ち"],[21,1,"の"],[35,2,"とうぜん"]],"text":"聖徒と預言者との血を流した者たちに、血をお飲ませになりましたが、それは当然のことであります」。"},{"ref":"Rev.16.7","start":66016007,"end":66016007,"break":"none","ruby":[[6,2,"さいだん"],[11,1,"い"],[15,1,"き"],[20,3,"ぜんのうしゃ"],[26,1,"しゅ"],[29,1,"かみ"],[44,2,"しんじつ"],[50,1,"ただ"]],"text":"わたしはまた祭壇がこう言うのを聞いた、「全能者にして主なる神よ。しかり、あなたのさばきは真実で、かつ正しいさばきであります」。"},{"ref":"Rev.16.8","start":66016008,"end":66016008,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"もの"],[8,1,"はち"],[10,2,"たいよう"],[13,1,"かたむ"],[21,2,"たいよう"],[24,1,"ひ"],[26,2,"ひとびと"],[29,1,"や"],[34,1,"ゆる"]],"text":"第四の者が、その鉢を太陽に傾けた。すると、太陽は火で人々を焼くことを許された。"},{"ref":"Rev.16.9","start":66016009,"end":66016009,"break":"none","ruby":[[0,2,"ひとびと"],[4,1,"はげ"],[7,2,"えんねつ"],[10,1,"や"],[20,2,"さいがい"],[23,2,"しはい"],[27,1,"かみ"],[29,2,"みな"],[32,1,"けが"],[35,1,"く"],[37,1,"あらた"],[40,1,"かみ"],[42,2,"えいこう"],[45,1,"き"]],"text":"人々は、激しい炎熱で焼かれたが、これらの災害を支配する神の御名を汚し、悔い改めて神に栄光を帰することをしなかった。"},{"ref":"Rev.16.10","start":66016010,"end":66016010,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"もの"],[8,1,"はち"],[10,1,"けもの"],[12,1,"ざ"],[14,1,"かたむ"],[22,1,"けもの"],[24,1,"くに"],[26,1,"くら"],[31,2,"ひとびと"],[34,2,"くつう"],[40,1,"した"]],"text":"第五の者が、その鉢を獣の座に傾けた。すると、獣の国は暗くなり、人々は苦痛のあまり舌をかみ、"},{"ref":"Rev.16.11","start":66016011,"end":66016011,"break":"none","ruby":[[2,2,"くつう"],[7,1,"もの"],[14,1,"てん"],[16,1,"かみ"],[27,2,"じぶん"],[30,1,"おこな"],[33,1,"く"],[35,1,"あらた"]],"text":"その苦痛とでき物とのゆえに、天の神をのろった。そして、自分の行いを悔い改めなかった。"},{"ref":"Rev.16.12","start":66016012,"end":66016012,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"もの"],[8,1,"はち"],[10,1,"だい"],[16,1,"がわ"],[18,1,"かたむ"],[28,1,"みず"],[31,1,"ひ"],[33,1,"で"],[35,1,"ほう"],[38,1,"く"],[40,1,"おう"],[44,1,"たい"],[46,1,"みち"],[48,1,"そな"]],"text":"第六の者が、その鉢を大ユウフラテ川に傾けた。すると、その水は、日の出る方から来る王たちに対し道を備えるために、かれてしまった。"},{"ref":"Rev.16.13","start":66016013,"end":66016013,"break":"none","ruby":[[2,1,"み"],[6,1,"りゅう"],[8,1,"くち"],[12,1,"けもの"],[14,1,"くち"],[20,3,"よげんしゃ"],[24,1,"くち"],[38,1,"けが"],[41,1,"れい"],[43,1,"で"]],"text":"また見ると、龍の口から、獣の口から、にせ預言者の口から、かえるのような三つの汚れた霊が出てきた。"},{"ref":"Rev.16.14","start":66016014,"end":66016014,"break":"none","ruby":[[9,1,"おこな"],[11,2,"あくれい"],[14,1,"れい"],[20,1,"ぜん"],[21,2,"せかい"],[24,1,"おう"],[32,1,"い"],[35,1,"かれ"],[38,2,"しょうしゅう"],[48,2,"ぜんのう"],[52,1,"かみ"],[54,1,"おお"],[58,1,"ひ"],[61,1,"たたか"]],"text":"これらは、しるしを行う悪霊の霊であって、全世界の王たちのところに行き、彼らを召集したが、それは、全能なる神の大いなる日に、戦いをするためであった。"},{"ref":"Rev.16.15","start":66016015,"end":66016015,"break":"none","ruby":[[1,1,"み"],[8,2,"ぬすびと"],[14,1,"く"],[17,1,"はだか"],[22,1,"ある"],[33,1,"はだか"],[35,1,"はじ"],[37,1,"み"],[46,1,"め"],[51,2,"きもの"],[54,1,"み"],[56,1,"つ"],[61,1,"もの"]],"text":"（見よ、わたしは盗人のように来る。裸のままで歩かないように、また、裸の恥を見られないように、目をさまし着物を身に着けている者は、さいわいである。）"},{"ref":"Rev.16.16","start":66016016,"end":66016016,"break":"none","ruby":[[3,1,"れい"],[9,1,"ご"],[20,1,"ところ"],[23,1,"おう"],[27,2,"しょうしゅう"]],"text":"三つの霊は、ヘブル語でハルマゲドンという所に、王たちを召集した。"},{"ref":"Rev.16.17","start":66016017,"end":66016017,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"もの"],[8,1,"はち"],[10,2,"くうちゅう"],[13,1,"かたむ"],[21,1,"おお"],[24,1,"こえ"],[26,2,"せいじょ"],[29,1,"なか"],[33,2,"みざ"],[37,1,"で"],[41,1,"こと"],[46,1,"な"],[51,1,"い"]],"text":"第七の者が、その鉢を空中に傾けた。すると、大きな声が聖所の中から、御座から出て、「事はすでに成った」と言った。"},{"ref":"Rev.16.18","start":66016018,"end":66016018,"break":"none","ruby":[[15,1,"こえ"],[18,2,"らいめい"],[22,1,"おこ"],[27,1,"はげ"],[30,2,"じしん"],[40,2,"にんげん"],[43,2,"ちじょう"],[51,2,"いらい"],[73,1,"はげ"],[76,2,"じしん"]],"text":"すると、いなずまと、もろもろの声と、雷鳴とが起り、また激しい地震があった。それは人間が地上にあらわれて以来、かつてなかったようなもので、それほどに激しい地震であった。"},{"ref":"Rev.16.19","start":66016019,"end":66016019,"break":"none","ruby":[[0,1,"おお"],[4,1,"みやこ"],[9,1,"さ"],[13,1,"しょ"],[14,2,"こくみん"],[17,2,"まちまち"],[20,1,"たお"],[24,1,"かみ"],[26,1,"おお"],[35,1,"おも"],[37,1,"おこ"],[43,1,"かみ"],[45,1,"はげ"],[48,1,"いか"],[54,1,"しゅ"],[56,1,"さかずき"],[58,1,"あた"]],"text":"大いなる都は三つに裂かれ、諸国民の町々は倒れた。神は大いなるバビロンを思い起し、これに神の激しい怒りのぶどう酒の杯を与えられた。"},{"ref":"Rev.16.20","start":66016020,"end":66016020,"break":"none","ruby":[[0,2,"しまじま"],[5,1,"に"],[7,1,"さ"],[10,2,"やまやま"],[13,1,"み"]],"text":"島々はみな逃げ去り、山々は見えなくなった。"},{"ref":"Rev.16.21","start":66016021,"end":66016021,"break":"none","ruby":[[8,1,"おも"],[13,1,"おお"],[16,1,"ひょう"],[19,1,"てん"],[22,2,"ひとびと"],[25,1,"うえ"],[27,1,"ふ"],[33,2,"ひとびと"],[39,1,"ひょう"],[41,2,"さいがい"],[47,1,"かみ"],[56,2,"さいがい"],[60,2,"ひじょう"],[63,1,"おお"]],"text":"また一タラントの重さほどの大きな雹が、天から人々の上に降ってきた。人々は、この雹の災害のゆえに神をのろった。その災害が、非常に大きかったからである。"}]