[{"ref":"Num.28.1","start":4028001,"end":4028001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.28.2","start":4028002,"end":4028002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"めい"],[13,1,"い"],[26,1,"こう"],[44,2,"かさい"],[56,1,"そな"],[58,1,"もの"],[64,2,"しょくもつ"],[67,1,"さだ"],[70,1,"とき"],[83,1,"おこた"]],"text":"「イスラエルの人々に命じて言いなさい、『あなたがたは香ばしいかおりとしてわたしにささげる火祭、すなわち、わたしの供え物、わたしの食物を定めの時にわたしにささげることを怠ってはならない』。"},{"ref":"Num.28.3","start":4028003,"end":4028003,"break":"none","ruby":[[2,1,"かれ"],[5,1,"い"],[18,1,"しゅ"],[25,2,"かさい"],[39,1,"さい"],[41,1,"おす"],[43,1,"まった"],[45,2,"こひつじ"],[48,1,"とう"],[50,2,"まいにち"],[56,3,"じょうはんさい"]],"text":"また彼らに言いなさい、『あなたがたが主にささぐべき火祭はこれである。すなわち一歳の雄の全き小羊二頭を毎日ささげて常燔祭としなければならない。"},{"ref":"Num.28.4","start":4028004,"end":4028004,"break":"none","ruby":[[5,1,"とう"],[7,2,"こひつじ"],[10,1,"あさ"],[17,1,"とう"],[19,2,"こひつじ"],[22,1,"ゆう"]],"text":"すなわち一頭の小羊を朝にささげ、一頭の小羊を夕にささげなければならない。"},{"ref":"Num.28.5","start":4028005,"end":4028005,"break":"none","ruby":[[2,2,"むぎこ"],[9,1,"ぶん"],[14,1,"くだ"],[17,1,"と"],[20,1,"あぶら"],[26,1,"ぶん"],[30,1,"ま"],[33,2,"そさい"]],"text":"また麦粉一エパの十分の一に、砕いて取った油一ヒンの四分の一を混ぜて素祭としなければならない。"},{"ref":"Num.28.6","start":4028006,"end":4028006,"break":"none","ruby":[[6,1,"さん"],[8,1,"さだ"],[13,3,"じょうはんさい"],[21,1,"しゅ"],[23,1,"こう"],[37,2,"かさい"]],"text":"これはシナイ山で定められた常燔祭であって、主に香ばしいかおりとしてささげる火祭である。"},{"ref":"Num.28.7","start":4028007,"end":4028007,"break":"none","ruby":[[4,2,"かんさい"],[7,2,"こひつじ"],[10,1,"とう"],[20,1,"ぶん"],[40,2,"せいじょ"],[46,1,"しゅ"],[51,1,"こ"],[53,1,"さけ"],[59,2,"かんさい"]],"text":"またその灌祭は小羊一頭について一ヒンの四分の一をささげなければならない。すなわち聖所において主のために濃い酒をそそいで灌祭としなければならない。"},{"ref":"Num.28.8","start":4028008,"end":4028008,"break":"none","ruby":[[0,1,"ゆう"],[3,1,"た"],[6,1,"とう"],[8,2,"こひつじ"],[25,2,"そさい"],[28,2,"かんさい"],[32,1,"あさ"],[37,1,"おな"],[46,2,"こひつじ"],[49,2,"かさい"],[58,1,"しゅ"],[60,1,"こう"]],"text":"夕には他の一頭の小羊をささげなければならない。その素祭と灌祭とは朝のものと同じようにし、その小羊を火祭としてささげ、主に香ばしいかおりとしなければならない。"},{"ref":"Num.28.9","start":4028009,"end":4028009,"break":"paragraph","ruby":[[2,3,"あんそくにち"],[8,1,"さい"],[10,1,"おす"],[12,1,"まった"],[14,2,"こひつじ"],[17,1,"とう"],[20,2,"むぎこ"],[27,1,"ん"],[31,1,"あぶら"],[33,1,"ま"],[36,2,"そさい"],[42,2,"かんさい"]],"text":"また安息日には一歳の雄の全き小羊二頭と、麦粉一エパの十分の二に油を混ぜた素祭と、その灌祭とをささげなければならない。"},{"ref":"Num.28.10","start":4028010,"end":4028010,"break":"none","ruby":[[3,3,"あんそくにち"],[9,2,"はんさい"],[16,3,"じょうはんさい"],[22,2,"かんさい"],[26,1,"くわ"]],"text":"これは安息日ごとの燔祭であって、常燔祭とその灌祭とに加えらるべきものである。"},{"ref":"Num.28.11","start":4028011,"end":4028011,"break":"paragraph","ruby":[[8,2,"つきづき"],[11,1,"だい"],[13,1,"にち"],[15,2,"はんさい"],[18,1,"しゅ"],[36,1,"わか"],[38,2,"おうし"],[41,1,"とう"],[43,2,"おひつじ"],[46,1,"とう"],[49,1,"さい"],[51,1,"おす"],[53,1,"まった"],[55,2,"こひつじ"],[58,1,"とう"]],"text":"またあなたがたは月々の第一日に燔祭を主にささげなければならない。すなわち若い雄牛二頭、雄羊一頭、一歳の雄の全き小羊七頭をささげ、"},{"ref":"Num.28.12","start":4028012,"end":4028012,"break":"none","ruby":[[0,2,"おうし"],[3,1,"とう"],[6,2,"むぎこ"],[13,1,"ぶん"],[17,1,"あぶら"],[19,1,"ま"],[25,2,"そさい"],[30,2,"おひつじ"],[33,1,"とう"],[36,2,"むぎこ"],[43,1,"ぶん"],[47,1,"あぶら"],[49,1,"ま"],[55,2,"そさい"]],"text":"雄牛一頭には麦粉一エパの十分の三に油を混ぜたものを素祭とし、雄羊一頭には麦粉一エパの十分の二に油を混ぜたものを素祭とし、"},{"ref":"Num.28.13","start":4028013,"end":4028013,"break":"none","ruby":[[0,2,"こひつじ"],[3,1,"とう"],[6,2,"むぎこ"],[9,1,"ぶん"],[13,1,"あぶら"],[15,1,"ま"],[21,2,"そさい"],[29,1,"こう"],[37,2,"はんさい"],[42,1,"しゅ"],[47,2,"かさい"]],"text":"小羊一頭には麦粉十分の一に油を混ぜたものを素祭とし、これを香ばしいかおりの燔祭として主のために火祭としなければならない。"},{"ref":"Num.28.14","start":4028014,"end":4028014,"break":"none","ruby":[[4,2,"かんさい"],[7,2,"おうし"],[10,1,"とう"],[18,1,"しゅ"],[24,1,"ぶん"],[28,2,"おひつじ"],[31,1,"とう"],[41,1,"ぶん"],[45,2,"こひつじ"],[48,1,"とう"],[58,1,"ぶん"],[77,1,"ねん"],[79,2,"つきづき"],[82,1,"つう"],[86,2,"しんげつ"],[96,2,"はんさい"]],"text":"またその灌祭は雄牛一頭についてぶどう酒一ヒンの二分の一、雄羊一頭について一ヒンの三分の一、小羊一頭について一ヒンの四分の一をささげなければならない。これは年の月々を通じて、新月ごとにささぐべき燔祭である。"},{"ref":"Num.28.15","start":4028015,"end":4028015,"break":"none","ruby":[[2,3,"じょうはんさい"],[8,2,"かんさい"],[16,1,"お"],[20,1,"とう"],[22,2,"ざいさい"],[27,1,"しゅ"]],"text":"また常燔祭とその灌祭とのほかに、雄やぎ一頭を罪祭として主にささげなければならない。"},{"ref":"Num.28.16","start":4028016,"end":4028016,"break":"paragraph","ruby":[[0,2,"しょうがつ"],[5,1,"か"],[7,1,"しゅ"],[9,2,"すぎこし"],[12,1,"まつり"]],"text":"正月の十四日は主の過越の祭である。"},{"ref":"Num.28.17","start":4028017,"end":4028017,"break":"none","ruby":[[4,1,"つき"],[8,1,"にち"],[10,2,"さいじつ"],[23,2,"なぬか"],[29,1,"たね"],[30,1,"い"],[36,1,"た"]],"text":"またその月の十五日は祭日としなければならない。七日のあいだ種入れぬパンを食べなければならない。"},{"ref":"Num.28.18","start":4028018,"end":4028018,"break":"none","ruby":[[2,1,"はじ"],[5,1,"ひ"],[8,1,"せい"],[9,1,"かい"],[11,1,"ひら"],[25,2,"ろうえき"]],"text":"その初めの日には聖会を開かなければならない。なんの労役をもしてはならない。"},{"ref":"Num.28.19","start":4028019,"end":4028019,"break":"none","ruby":[[6,2,"かさい"],[11,1,"しゅ"],[13,2,"はんさい"],[32,1,"わか"],[34,2,"おうし"],[37,1,"とう"],[39,2,"おひつじ"],[42,1,"とう"],[45,1,"さい"],[47,1,"おす"],[49,2,"こひつじ"],[52,1,"とう"],[72,1,"まった"]],"text":"あなたがたは火祭として主に燔祭をささげなければならない。すなわち若い雄牛二頭、雄羊一頭、一歳の雄の小羊七頭をささげなければならない。これらはみな全きものでなければならない。"},{"ref":"Num.28.20","start":4028020,"end":4028020,"break":"none","ruby":[[2,2,"そさい"],[6,1,"あぶら"],[8,1,"ま"],[11,2,"むぎこ"],[30,2,"おうし"],[33,1,"とう"],[37,2,"むぎこ"],[44,1,"ぶん"],[48,2,"おひつじ"],[51,1,"とう"],[56,1,"ぶん"]],"text":"その素祭には油を混ぜた麦粉をささげなければならない。すなわち雄牛一頭につき麦粉一エパの十分の三、雄羊一頭につき十分の二をささげ、"},{"ref":"Num.28.21","start":4028021,"end":4028021,"break":"none","ruby":[[3,1,"とう"],[5,2,"こひつじ"],[12,1,"とう"],[17,1,"ぶん"]],"text":"また七頭の小羊にはその一頭ごとに十分の一をささげなければならない。"},{"ref":"Num.28.22","start":4028022,"end":4028022,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[26,1,"つみ"]],"text":"また雄やぎ一頭を罪祭としてささげ、あなたがたのために罪のあがないをしなければならない。"},{"ref":"Num.28.23","start":4028023,"end":4028023,"break":"none","ruby":[[6,1,"あさ"],[12,3,"じょうはんさい"],[16,2,"はんさい"]],"text":"あなたがたは朝にささげる常燔祭の燔祭のほかに、これらをささげなければならない。"},{"ref":"Num.28.24","start":4028024,"end":4028024,"break":"none","ruby":[[11,2,"なぬか"],[17,2,"まいにち"],[20,2,"かさい"],[23,2,"しょくもつ"],[31,1,"しゅ"],[33,1,"こう"],[54,3,"じょうはんさい"],[60,2,"かんさい"]],"text":"このようにあなたがたは七日のあいだ毎日、火祭の食物をささげて、主に香ばしいかおりとしなければならない。これは常燔祭とその灌祭とのほかにささぐべきものである。"},{"ref":"Num.28.25","start":4028025,"end":4028025,"break":"none","ruby":[[3,1,"だい"],[5,1,"にち"],[14,1,"せい"],[15,1,"かい"],[17,1,"ひら"],[31,2,"ろうえき"]],"text":"そして第七日に、あなたがたは聖会を開かなければならない。なんの労役をもしてはならない。"},{"ref":"Num.28.26","start":4028026,"end":4028026,"break":"paragraph","ruby":[[7,1,"しゅう"],[9,1,"まつり"],[15,1,"あたら"],[18,2,"そさい"],[21,1,"しゅ"],[27,2,"はつほ"],[30,1,"ひ"],[33,1,"せい"],[34,1,"かい"],[36,1,"ひら"],[50,2,"ろうえき"]],"text":"あなたがたは七週の祭、すなわち新しい素祭を主にささげる初穂の日にも聖会を開かなければならない。なんの労役をもしてはならない。"},{"ref":"Num.28.27","start":4028027,"end":4028027,"break":"none","ruby":[[6,2,"はんさい"],[14,1,"しゅ"],[16,1,"こう"],[38,1,"わか"],[40,2,"おうし"],[43,1,"とう"],[45,2,"おひつじ"],[48,1,"とう"],[51,1,"さい"],[53,1,"おす"],[55,2,"こひつじ"],[58,1,"とう"]],"text":"あなたがたは燔祭をささげて、主に香ばしいかおりとしなければならない。すなわち若い雄牛二頭、雄羊一頭、一歳の雄の小羊七頭をささげなければならない。"},{"ref":"Num.28.28","start":4028028,"end":4028028,"break":"none","ruby":[[2,2,"そさい"],[6,1,"あぶら"],[8,1,"ま"],[11,2,"むぎこ"],[30,2,"おうし"],[33,1,"とう"],[42,1,"ぶん"],[46,2,"おひつじ"],[49,1,"とう"],[54,1,"ぶん"]],"text":"その素祭には油を混ぜた麦粉をささげなければならない。すなわち雄牛一頭につき一エパの十分の三、雄羊一頭につき十分の二をささげ、"},{"ref":"Num.28.29","start":4028029,"end":4028029,"break":"none","ruby":[[3,1,"とう"],[5,2,"こひつじ"],[10,1,"とう"],[15,1,"ぶん"]],"text":"また七頭の小羊には一頭ごとに十分の一をささげなければならない。"},{"ref":"Num.28.30","start":4028030,"end":4028030,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[21,1,"つみ"]],"text":"また雄やぎ一頭をささげてあなたがたのために罪のあがないをしなければならない。"},{"ref":"Num.28.31","start":4028031,"end":4028031,"break":"none","ruby":[[6,3,"じょうはんさい"],[12,2,"そさい"],[17,2,"かんさい"],[48,1,"まった"]],"text":"あなたがたは常燔祭とその素祭とその灌祭とのほかに、これらをささげなければならない。これらはみな、全きものでなければならない。"}]