[{"ref":"Gal.6.1","start":48006001,"end":48006001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[11,1,"ひと"],[13,2,"ざいか"],[16,1,"おちい"],[31,1,"れい"],[33,1,"ひと"],[44,2,"にゅうわ"],[47,1,"こころ"],[55,1,"ひと"],[57,1,"ただ"],[66,2,"どうじ"],[73,2,"じぶん"],[75,2,"じしん"],[78,2,"ゆうわく"],[81,1,"おちい"],[95,2,"はんせい"]],"text":"兄弟たちよ。もしもある人が罪過に陥っていることがわかったなら、霊の人であるあなたがたは、柔和な心をもって、その人を正しなさい。それと同時に、もしか自分自身も誘惑に陥ることがありはしないかと、反省しなさい。"},{"ref":"Gal.6.2","start":48006002,"end":48006002,"break":"none","ruby":[[0,1,"たがい"],[2,2,"おもに"],[5,1,"お"],[7,1,"あ"],[30,2,"りっぽう"],[33,1,"まっと"]],"text":"互に重荷を負い合いなさい。そうすれば、あなたがたはキリストの律法を全うするであろう。"},{"ref":"Gal.6.3","start":48006003,"end":48006003,"break":"none","ruby":[[4,1,"ひと"],[7,2,"じじつ"],[17,2,"じぶん"],[20,1,"なに"],[22,1,"えら"],[24,1,"もの"],[31,1,"おも"],[43,1,"ひと"],[45,2,"じぶん"],[48,1,"あざむ"]],"text":"もしある人が、事実そうでないのに、自分が何か偉い者であるように思っているとすれば、その人は自分を欺いているのである。"},{"ref":"Gal.6.4","start":48006004,"end":48006004,"break":"none","ruby":[[7,2,"じぶん"],[10,1,"おこな"],[13,2,"けんとう"],[29,2,"じぶん"],[35,1,"ほこ"],[48,1,"ひと"],[51,1,"ほこ"]],"text":"ひとりびとり、自分の行いを検討してみるがよい。そうすれば、自分だけには誇ることができても、ほかの人には誇れなくなるであろう。"},{"ref":"Gal.6.5","start":48006005,"end":48006005,"break":"none","ruby":[[0,1,"ひと"],[7,2,"じぶん"],[9,2,"じしん"],[12,2,"おもに"],[15,1,"お"]],"text":"人はそれぞれ、自分自身の重荷を負うべきである。"},{"ref":"Gal.6.6","start":48006006,"end":48006006,"break":"paragraph","ruby":[[0,2,"みことば"],[3,1,"おし"],[9,1,"ひと"],[12,1,"おし"],[15,1,"ひと"],[21,1,"よ"],[26,1,"わ"],[28,1,"あ"]],"text":"御言を教えてもらう人は、教える人と、すべて良いものを分け合いなさい。"},{"ref":"Gal.6.7","start":48006007,"end":48006007,"break":"none","ruby":[[11,1,"かみ"],[13,1,"あなど"],[27,1,"ひと"],[29,2,"じぶん"],[39,1,"か"],[41,1,"と"]],"text":"まちがってはいけない、神は侮られるようなかたではない。人は自分のまいたものを、刈り取ることになる。"},{"ref":"Gal.6.8","start":48006008,"end":48006008,"break":"none","ruby":[[5,2,"じぶん"],[8,1,"にく"],[12,1,"もの"],[15,1,"にく"],[18,1,"ほろ"],[21,1,"か"],[23,1,"と"],[26,1,"れい"],[30,1,"もの"],[33,1,"れい"],[36,2,"えいえん"],[43,1,"か"],[45,1,"と"]],"text":"すなわち、自分の肉にまく者は、肉から滅びを刈り取り、霊にまく者は、霊から永遠のいのちを刈り取るであろう。"},{"ref":"Gal.6.9","start":48006009,"end":48006009,"break":"none","ruby":[[7,1,"ぜん"],[9,1,"おこな"],[17,1,"つか"],[36,1,"とき"],[38,1,"く"],[41,1,"か"],[43,1,"と"]],"text":"わたしたちは、善を行うことに、うみ疲れてはならない。たゆまないでいると、時が来れば刈り取るようになる。"},{"ref":"Gal.6.10","start":48006010,"end":48006010,"break":"none","ruby":[[4,2,"きかい"],[16,1,"たい"],[24,2,"しんこう"],[27,2,"なかま"],[30,1,"たい"],[34,1,"ぜん"],[36,1,"おこな"]],"text":"だから、機会のあるごとに、だれに対しても、とくに信仰の仲間に対して、善を行おうではないか。"},{"ref":"Gal.6.11","start":48006011,"end":48006011,"break":"paragraph","ruby":[[10,2,"じしん"],[14,1,"ふで"],[24,1,"おお"],[27,1,"じ"],[36,1,"か"]],"text":"ごらんなさい。わたし自身いま筆をとって、こんなに大きい字で、あなたがたに書いていることを。"},{"ref":"Gal.6.12","start":48006012,"end":48006012,"break":"none","ruby":[[5,1,"にく"],[10,1,"み"],[13,1,"かざ"],[19,1,"もの"],[33,3,"じゅうじか"],[41,2,"はくがい"],[44,1,"う"],[64,2,"かつれい"],[67,1,"う"]],"text":"いったい、肉において見えを飾ろうとする者たちは、キリスト・イエスの十字架のゆえに、迫害を受けたくないばかりに、あなたがたにしいて割礼を受けさせようとする。"},{"ref":"Gal.6.13","start":48006013,"end":48006013,"break":"none","ruby":[[0,2,"じじつ"],[3,2,"かつれい"],[10,2,"じしん"],[13,2,"りっぽう"],[16,1,"まも"],[29,1,"にく"],[34,1,"ほこ"],[42,2,"かつれい"],[45,1,"う"]],"text":"事実、割礼のあるもの自身が律法を守らず、ただ、あなたがたの肉について誇りたいために、割礼を受けさせようとしているのである。"},{"ref":"Gal.6.14","start":48006014,"end":48006014,"break":"none","ruby":[[7,2,"じしん"],[18,1,"しゅ"],[28,3,"じゅうじか"],[31,2,"いがい"],[35,1,"ほこり"],[43,1,"だん"],[57,3,"じゅうじか"],[69,1,"よ"],[75,1,"たい"],[78,1,"し"],[87,1,"よ"],[89,1,"たい"],[92,1,"し"]],"text":"しかし、わたし自身には、わたしたちの主イエス・キリストの十字架以外に、誇とするものは、断じてあってはならない。この十字架につけられて、この世はわたしに対して死に、わたしもこの世に対して死んでしまったのである。"},{"ref":"Gal.6.15","start":48006015,"end":48006015,"break":"none","ruby":[[0,2,"かつれい"],[8,2,"もんだい"],[18,1,"あたら"],[21,1,"つく"],[30,2,"じゅうよう"]],"text":"割礼のあるなしは問題ではなく、ただ、新しく造られることこそ、重要なのである。"},{"ref":"Gal.6.16","start":48006016,"end":48006016,"break":"none","ruby":[[2,2,"ほうそく"],[5,1,"したが"],[8,1,"すす"],[10,2,"ひとびと"],[13,1,"うえ"],[16,2,"へいわ"],[34,1,"かみ"],[42,1,"うえ"]],"text":"この法則に従って進む人々の上に、平和とあわれみとがあるように。また、神のイスラエルの上にあるように。"},{"ref":"Gal.6.17","start":48006017,"end":48006017,"break":"paragraph","ruby":[[3,2,"こんご"],[11,1,"わずら"],[32,1,"や"],[34,1,"いん"],[36,1,"み"],[38,1,"お"]],"text":"だれも今後は、わたしに煩いをかけないでほしい。わたしは、イエスの焼き印を身に帯びているのだから。"},{"ref":"Gal.6.18","start":48006018,"end":48006018,"break":"paragraph","ruby":[[0,2,"きょうだい"],[12,1,"しゅ"],[22,1,"めぐ"],[32,1,"れい"],[34,1,"とも"]],"text":"兄弟たちよ。わたしたちの主イエス・キリストの恵みが、あなたがたの霊と共にあるように、アァメン。"}]