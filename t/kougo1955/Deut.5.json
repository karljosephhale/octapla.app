[{"ref":"Deut.5.1","start":5005001,"end":5005001,"break":"paragraph","ruby":[[16,1,"ひと"],[18,1,"め"],[20,1,"よ"],[23,1,"い"],[49,1,"みみ"],[51,1,"かた"],[53,1,"さだ"],[61,1,"き"],[67,1,"まな"],[73,1,"まも"],[76,1,"おこな"]],"text":"さてモーセはイスラエルのすべての人を召し寄せて言った、「イスラエルよ、きょう、わたしがあなたがたの耳に語る定めと、おきてを聞き、これを学び、これを守って行え。"},{"ref":"Deut.5.2","start":5005002,"end":5005002,"break":"none","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[19,2,"けいやく"],[22,1,"むす"]],"text":"われわれの神、主はホレブで、われわれと契約を結ばれた。"},{"ref":"Deut.5.3","start":5005003,"end":5005003,"break":"none","ruby":[[0,1,"しゅ"],[4,2,"けいやく"],[12,2,"せんぞ"],[18,1,"むす"],[29,1,"い"],[46,1,"もの"],[48,1,"むす"]],"text":"主はこの契約をわれわれの先祖たちとは結ばず、きょう、ここに生きながらえているわれわれすべての者と結ばれた。"},{"ref":"Deut.5.4","start":5005004,"end":5005004,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"やま"],[4,1,"ひ"],[6,1,"なか"],[16,1,"かお"],[18,1,"あ"],[22,1,"かた"]],"text":"主は山で火の中から、あなたがたと顔を合わせて語られた。"},{"ref":"Deut.5.5","start":5005005,"end":5005005,"break":"none","ruby":[[2,1,"とき"],[8,1,"しゅ"],[17,1,"あいだ"],[19,1,"た"],[22,1,"しゅ"],[24,2,"ことば"],[33,1,"つた"],[43,1,"ひ"],[48,1,"おそ"],[51,1,"やま"],[53,1,"のぼ"],[70,1,"しゅ"],[72,1,"い"]],"text":"その時、わたしは主とあなたがたとの間に立って主の言葉をあなたがたに伝えた。あなたがたは火のゆえに恐れて山に登ることができなかったからである。主は言われた、"},{"ref":"Deut.5.6","start":5005006,"end":5005006,"break":"paragraph","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[26,1,"ち"],[28,2,"どれい"],[31,1,"いえ"],[34,1,"みちび"],[36,1,"だ"],[39,1,"もの"]],"text":"『わたしはあなたの神、主であって、あなたをエジプトの地、奴隷の家から導き出した者である。"},{"ref":"Deut.5.7","start":5005007,"end":5005007,"break":"paragraph","ruby":[[11,1,"なに"],[16,1,"かみ"]],"text":"あなたはわたしのほかに何ものをも神としてはならない。"},{"ref":"Deut.5.8","start":5005008,"end":5005008,"break":"paragraph","ruby":[[4,2,"じぶん"],[10,1,"きざ"],[13,1,"ぞう"],[15,1,"つく"],[24,1,"うえ"],[26,1,"てん"],[33,1,"した"],[35,1,"ち"],[44,1,"ち"],[46,1,"した"],[48,1,"みず"],[50,1,"なか"],[63,1,"かたち"],[66,1,"つく"]],"text":"あなたは自分のために刻んだ像を造ってはならない。上は天にあるもの、下は地にあるもの、また地の下の水の中にあるものの、どのような形をも造ってはならない。"},{"ref":"Deut.5.9","start":5005009,"end":5005009,"break":"none","ruby":[[3,1,"おが"],[17,1,"つか"],[30,1,"かみ"],[32,1,"しゅ"],[44,1,"かみ"],[55,1,"にく"],[62,1,"ちち"],[64,1,"つみ"],[66,1,"こ"],[68,1,"むく"],[74,1,"だい"],[76,1,"およ"]],"text":"それを拝んではならない。またそれに仕えてはならない。あなたの神、主であるわたしは、ねたむ神であるから、わたしを憎むものには、父の罪を子に報いて三、四代に及ぼし、"},{"ref":"Deut.5.10","start":5005010,"end":5005010,"break":"none","ruby":[[4,1,"あい"],[11,1,"いまし"],[14,1,"まも"],[16,1,"もの"],[19,1,"めぐ"],[22,1,"ほどこ"],[25,1,"せん"],[26,1,"だい"],[28,1,"いた"]],"text":"わたしを愛し、わたしの戒めを守る者には恵みを施して千代に至るであろう。"},{"ref":"Deut.5.11","start":5005011,"end":5005011,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"な"],[14,1,"とな"],[23,1,"しゅ"],[27,1,"な"],[33,1,"とな"],[36,1,"もの"],[38,1,"ばっ"]],"text":"あなたの神、主の名をみだりに唱えてはならない。主はその名をみだりに唱える者を罰しないではおかないであろう。"},{"ref":"Deut.5.12","start":5005012,"end":5005012,"break":"paragraph","ruby":[[0,3,"あんそくにち"],[4,1,"まも"],[10,1,"せい"],[18,1,"かみ"],[20,1,"しゅ"],[26,1,"めい"]],"text":"安息日を守ってこれを聖とし、あなたの神、主があなたに命じられたようにせよ。"},{"ref":"Deut.5.13","start":5005013,"end":5005013,"break":"none","ruby":[[1,1,"か"],[6,1,"はたら"]],"text":"六日のあいだ働いて、あなたのすべてのわざをしなければならない。"},{"ref":"Deut.5.14","start":5005014,"end":5005014,"break":"none","ruby":[[0,2,"なぬか"],[2,1,"め"],[8,1,"かみ"],[10,1,"しゅ"],[12,2,"あんそく"],[48,1,"むすめ"],[59,1,"うし"],[69,2,"かちく"],[77,1,"もん"],[84,2,"たこく"],[87,1,"ひと"],[89,1,"おな"],[117,1,"おな"],[122,1,"やす"]],"text":"七日目はあなたの神、主の安息であるから、なんのわざをもしてはならない。あなたも、あなたのむすこ、娘、しもべ、はしため、牛、ろば、もろもろの家畜も、あなたの門のうちにおる他国の人も同じである。こうしてあなたのしもべ、はしためを、あなたと同じように休ませなければならない。"},{"ref":"Deut.5.15","start":5005015,"end":5005015,"break":"none","ruby":[[12,1,"ち"],[14,2,"どれい"],[26,1,"かみ"],[28,1,"しゅ"],[30,1,"つよ"],[32,1,"て"],[35,1,"の"],[39,1,"うで"],[54,1,"みちび"],[56,1,"だ"],[63,1,"おぼ"],[83,1,"かみ"],[85,1,"しゅ"],[87,3,"あんそくにち"],[91,1,"まも"],[96,1,"めい"]],"text":"あなたはかつてエジプトの地で奴隷であったが、あなたの神、主が強い手と、伸ばした腕とをもって、そこからあなたを導き出されたことを覚えなければならない。それゆえ、あなたの神、主は安息日を守ることを命じられるのである。"},{"ref":"Deut.5.16","start":5005016,"end":5005016,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"めい"],[21,1,"ちち"],[23,1,"はは"],[26,1,"うやま"],[33,1,"かみ"],[35,1,"しゅ"],[37,1,"たま"],[40,1,"ち"],[47,1,"なが"],[49,1,"いのち"],[51,1,"たも"],[59,1,"え"]],"text":"あなたの神、主が命じられたように、あなたの父と母とを敬え。あなたの神、主が賜わる地で、あなたが長く命を保ち、さいわいを得ることのできるためである。"},{"ref":"Deut.5.17","start":5005017,"end":5005017,"break":"paragraph","ruby":[[4,1,"ころ"]],"text":"あなたは殺してはならない。"},{"ref":"Deut.5.18","start":5005018,"end":5005018,"break":"paragraph","ruby":[[4,2,"かんいん"]],"text":"あなたは姦淫してはならない。"},{"ref":"Deut.5.19","start":5005019,"end":5005019,"break":"paragraph","ruby":[[4,1,"ぬす"]],"text":"あなたは盗んではならない。"},{"ref":"Deut.5.20","start":5005020,"end":5005020,"break":"paragraph","ruby":[[4,2,"りんじん"],[10,2,"ぎしょう"]],"text":"あなたは隣人について偽証してはならない。"},{"ref":"Deut.5.21","start":5005021,"end":5005021,"break":"paragraph","ruby":[[4,2,"りんじん"],[7,1,"つま"],[22,2,"りんじん"],[25,1,"いえ"],[27,1,"はたけ"],[38,1,"うし"],[48,2,"りんじん"]],"text":"あなたは隣人の妻をむさぼってはならない。また隣人の家、畑、しもべ、はしため、牛、ろば、またすべて隣人のものをほしがってはならない』。"},{"ref":"Deut.5.22","start":5005022,"end":5005022,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,2,"ことば"],[9,1,"やま"],[11,1,"ひ"],[13,1,"なか"],[15,1,"くも"],[17,1,"なか"],[19,1,"こ"],[21,1,"くも"],[23,1,"なか"],[27,1,"おお"],[31,1,"こえ"],[43,1,"ぜん"],[44,2,"かいしゅう"],[48,1,"つ"],[64,1,"い"],[70,1,"まい"],[72,1,"いし"],[74,1,"いた"],[79,1,"か"],[90,1,"さづ"]],"text":"主はこれらの言葉を山で火の中、雲の中、濃い雲の中から、大いなる声をもって、あなたがたの全会衆にお告げになったが、このほかのことは言われず、二枚の石の板にこれを書きしるして、わたしに授けられた。"},{"ref":"Deut.5.23","start":5005023,"end":5005023,"break":"none","ruby":[[0,1,"とき"],[2,1,"やま"],[4,1,"ひ"],[6,1,"も"],[19,2,"あんこく"],[26,1,"きこ"],[29,1,"こえ"],[31,1,"き"],[34,1,"およ"],[44,2,"ぶぞく"],[55,2,"ちょうろう"],[65,2,"ちかよ"]],"text":"時に山は火で燃えていたが、あなたがたが暗黒のうちから聞える声を聞くに及んで、あなたがたの部族のすべてのかしらと長老たちは、わたしに近寄って、"},{"ref":"Deut.5.24","start":5005024,"end":5005024,"break":"none","ruby":[[0,1,"い"],[10,1,"かみ"],[12,1,"しゅ"],[16,2,"えいこう"],[22,1,"おお"],[36,1,"しめ"],[46,1,"ひ"],[48,1,"なか"],[51,1,"で"],[55,1,"こえ"],[57,1,"き"],[72,1,"かみ"],[74,1,"ひと"],[76,1,"かた"],[87,1,"ひと"],[89,1,"い"],[96,1,"み"]],"text":"言った、『われわれの神、主がその栄光と、その大いなることとを、われわれに示されて、われわれは火の中から出るその声を聞きました。きょう、われわれは神が人と語られ、しかもなおその人が生きているのを見ました。"},{"ref":"Deut.5.25","start":5005025,"end":5005025,"break":"none","ruby":[[7,1,"し"],[25,1,"おお"],[29,1,"ひ"],[36,1,"や"],[38,1,"ほろ"],[53,1,"うえ"],[61,1,"かみ"],[63,1,"しゅ"],[65,1,"こえ"],[67,1,"き"],[78,1,"し"]],"text":"われわれはなぜ死ななければならないでしょうか。この大いなる火はわれわれを焼き滅ぼそうとしています。もしこの上なおわれわれの神、主の声を聞くならば、われわれは死んでしまうでしょう。"},{"ref":"Deut.5.26","start":5005026,"end":5005026,"break":"none","ruby":[[3,1,"にく"],[6,1,"もの"],[15,1,"ひ"],[17,1,"なか"],[20,1,"かた"],[24,1,"い"],[27,1,"かみ"],[29,1,"こえ"],[40,1,"き"],[45,1,"い"],[50,1,"もの"]],"text":"およそ肉なる者のうち、だれが、火の中から語られる生ける神の声を、われわれのように聞いてなお生きている者がありましょうか。"},{"ref":"Deut.5.27","start":5005027,"end":5005027,"break":"none","ruby":[[7,1,"ちか"],[9,1,"すす"],[12,1,"い"],[21,1,"かみ"],[23,1,"しゅ"],[25,1,"い"],[34,1,"き"],[42,1,"かみ"],[44,1,"しゅ"],[51,1,"つ"],[67,1,"つ"],[80,1,"き"],[83,1,"おこな"]],"text":"あなたはどうぞ近く進んで行って、われわれの神、主が言われることをみな聞き、われわれの神、主があなたにお告げになることをすべてわれわれに告げてください。われわれは聞いて行います』。"},{"ref":"Deut.5.28","start":5005028,"end":5005028,"break":"paragraph","ruby":[[10,1,"かた"],[15,1,"とき"],[17,1,"しゅ"],[25,2,"ことば"],[28,1,"き"],[36,1,"い"],[48,1,"たみ"],[54,1,"かた"],[59,2,"ことば"],[62,1,"き"],[66,1,"かれ"],[69,1,"い"],[77,1,"よ"]],"text":"あなたがたがわたしに語っている時、主はあなたがたの言葉を聞いて、わたしに言われた、『わたしはこの民がおまえに語っている言葉を聞いた。彼らの言ったことはみな良い。"},{"ref":"Deut.5.29","start":5005029,"end":5005029,"break":"none","ruby":[[2,1,"ねが"],[10,1,"かれ"],[21,1,"こころ"],[30,1,"おそ"],[41,2,"めいれい"],[44,1,"まも"],[48,1,"かれ"],[53,2,"しそん"],[56,2,"えいきゅう"],[64,1,"え"]],"text":"ただ願わしいことは、彼らがつねにこのような心をもってわたしを恐れ、わたしのすべての命令を守って、彼らもその子孫も永久にさいわいを得るにいたることである。"},{"ref":"Deut.5.30","start":5005030,"end":5005030,"break":"none","ruby":[[4,1,"い"],[7,1,"かれ"],[24,2,"てんまく"],[27,1,"かえ"],[31,1,"い"]],"text":"おまえは行って彼らに、「あなたがたはおのおのその天幕に帰れ」と言え。"},{"ref":"Deut.5.31","start":5005031,"end":5005031,"break":"none","ruby":[[10,1,"ところ"],[19,1,"た"],[30,2,"めいれい"],[34,1,"さだ"],[47,1,"つ"],[49,1,"しめ"],[63,1,"かれ"],[66,1,"おし"],[73,1,"かれ"],[76,1,"あた"],[79,1,"え"],[83,1,"ち"],[92,1,"おこな"]],"text":"しかし、おまえはこの所でわたしのそばに立て。わたしはすべての命令と、定めと、おきてとをおまえに告げ示すであろう。おまえはこれを彼らに教え、わたしが彼らに与えて獲させる地において、これを行わせなければならない』。"},{"ref":"Deut.5.32","start":5005032,"end":5005032,"break":"none","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[15,1,"めい"],[25,1,"つつし"],[28,1,"おこな"],[42,1,"ひだり"],[45,1,"みぎ"],[48,1,"まが"]],"text":"それゆえ、あなたがたの神、主が命じられたとおりに、慎んで行わなければならない。そして左にも右にも曲ってはならない。"},{"ref":"Deut.5.33","start":5005033,"end":5005033,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"めい"],[15,1,"みち"],[17,1,"あゆ"],[39,1,"い"],[55,1,"え"],[64,1,"え"],[66,1,"ち"],[72,1,"なが"],[74,1,"いのち"],[76,1,"たも"]],"text":"あなたがたの神、主が命じられた道に歩まなければならない。そうすればあなたがたは生きることができ、かつさいわいを得て、あなたがたの獲る地において、長く命を保つことができるであろう。"}]