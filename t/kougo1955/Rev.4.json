[{"ref":"Rev.4.1","start":66004001,"end":66004001,"break":"paragraph","ruby":[[2,1,"のち"],[8,1,"み"],[14,1,"み"],[17,1,"ひら"],[20,1,"もん"],[22,1,"てん"],[42,1,"こえ"],[48,1,"よ"],[55,1,"き"],[58,1,"はじ"],[61,1,"こえ"],[68,1,"のぼ"],[86,1,"のち"],[88,1,"おこ"],[96,1,"み"],[105,1,"い"]],"text":"その後、わたしが見ていると、見よ、開いた門が天にあった。そして、さきにラッパのような声でわたしに呼びかけるのを聞いた初めの声が、「ここに上ってきなさい。そうしたら、これから後に起るべきことを、見せてあげよう」と言った。"},{"ref":"Rev.4.2","start":66004002,"end":66004002,"break":"none","ruby":[[13,2,"みたま"],[16,1,"かん"],[20,1,"み"],[23,2,"みざ"],[26,1,"てん"],[28,1,"もう"],[38,2,"みざ"]],"text":"すると、たちまち、わたしは御霊に感じた。見よ、御座が天に設けられており、その御座にいますかたがあった。"},{"ref":"Rev.4.3","start":66004003,"end":66004003,"break":"none","ruby":[[2,1,"ざ"],[11,2,"へきぎょく"],[14,1,"あか"],[22,1,"み"],[28,2,"みざ"],[37,2,"りょくぎょく"],[43,1,"み"],[49,1,"あらわ"]],"text":"その座にいますかたは、碧玉や赤めのうのように見え、また、御座のまわりには、緑玉のように見えるにじが現れていた。"},{"ref":"Rev.4.4","start":66004004,"end":66004004,"break":"none","ruby":[[3,2,"みざ"],[15,1,"ざ"],[24,1,"にん"],[26,2,"ちょうろう"],[29,1,"しろ"],[31,1,"ころも"],[33,1,"み"],[39,1,"あたま"],[41,1,"きん"],[43,1,"かんむり"],[54,1,"ざ"]],"text":"また、御座のまわりには二十四の座があって、二十四人の長老が白い衣を身にまとい、頭に金の冠をかぶって、それらの座についていた。"},{"ref":"Rev.4.5","start":66004005,"end":66004005,"break":"none","ruby":[[0,2,"みざ"],[17,1,"こえ"],[20,2,"らいめい"],[25,1,"はっ"],[40,1,"ひ"],[43,2,"みざ"],[46,1,"まえ"],[48,1,"も"],[59,1,"かみ"],[64,1,"れい"]],"text":"御座からは、いなずまと、もろもろの声と、雷鳴とが、発していた。また、七つのともし火が、御座の前で燃えていた。これらは、神の七つの霊である。"},{"ref":"Rev.4.6","start":66004006,"end":66004006,"break":"none","ruby":[[0,2,"みざ"],[3,1,"まえ"],[6,2,"すいしょう"],[9,1,"に"],[15,1,"うみ"],[24,2,"みざ"],[29,1,"ちか"],[42,1,"い"],[44,1,"もの"],[52,1,"まえ"],[55,1,"のち"],[60,1,"めん"],[62,1,"め"]],"text":"御座の前は、水晶に似たガラスの海のようであった。御座のそば近くそのまわりには、四つの生き物がいたが、その前にも後にも、一面に目がついていた。"},{"ref":"Rev.4.7","start":66004007,"end":66004007,"break":"none","ruby":[[0,1,"だい"],[3,1,"い"],[5,1,"もの"],[16,1,"だい"],[19,1,"い"],[21,1,"もの"],[23,1,"お"],[24,1,"うし"],[32,1,"だい"],[35,1,"い"],[37,1,"もの"],[39,1,"ひと"],[44,1,"かお"],[51,1,"だい"],[54,1,"い"],[56,1,"もの"],[58,1,"と"]],"text":"第一の生き物はししのようであり、第二の生き物は雄牛のようであり、第三の生き物は人のような顔をしており、第四の生き物は飛ぶわしのようであった。"},{"ref":"Rev.4.8","start":66004008,"end":66004008,"break":"none","breaks":[[67,"stanza"],[86,"line"],[97,"line"]],"ruby":[[5,1,"い"],[7,1,"もの"],[18,1,"つばさ"],[25,1,"つばさ"],[31,2,"うちがわ"],[34,1,"め"],[36,1,"み"],[46,1,"ひる"],[48,1,"よる"],[51,1,"た"],[53,1,"ま"],[58,1,"さけ"],[68,1,"せい"],[74,1,"せい"],[80,1,"せい"],[86,3,"ぜんのうしゃ"],[92,1,"しゅ"],[95,1,"かみ"],[97,1,"むかし"],[102,1,"いま"],[115,1,"もの"]],"text":"この四つの生き物には、それぞれ六つの翼があり、その翼のまわりも内側も目で満ちていた。そして、昼も夜も、絶え間なくこう叫びつづけていた、「聖なるかな、聖なるかな、聖なるかな、全能者にして主なる神。昔いまし、今いまし、やがてきたるべき者」。"},{"ref":"Rev.4.9","start":66004009,"end":66004009,"break":"none","ruby":[[4,1,"い"],[6,1,"もの"],[9,2,"みざ"],[19,2,"よよ"],[21,1,"かぎ"],[25,1,"い"],[36,2,"えいこう"],[44,1,"き"],[50,2,"かんしゃ"],[59,1,"とき"]],"text":"これらの生き物が、御座にいまし、かつ、世々限りなく生きておられるかたに、栄光とほまれとを帰し、また、感謝をささげている時、"},{"ref":"Rev.4.10","start":66004010,"end":66004010,"break":"none","ruby":[[3,1,"にん"],[5,2,"ちょうろう"],[9,2,"みざ"],[24,1,"ふ"],[27,2,"よよ"],[29,1,"かぎ"],[33,1,"い"],[43,1,"おが"],[46,1,"かれ"],[49,1,"かんむり"],[51,2,"みざ"],[58,1,"な"],[60,1,"だ"],[63,1,"い"]],"text":"二十四人の長老は、御座にいますかたのみまえにひれ伏し、世々限りなく生きておられるかたを拝み、彼らの冠を御座のまえに、投げ出して言った、"},{"ref":"Rev.4.11","start":66004011,"end":66004011,"break":"stanza","breaks":[[11,"line"],[18,"line"],[40,"line"],[54,"line"],[68,"line"]],"ruby":[[5,1,"しゅ"],[8,1,"かみ"],[18,2,"えいこう"],[25,1,"ちから"],[28,1,"う"],[44,2,"ばんぶつ"],[47,1,"つく"],[54,2,"みむね"],[61,2,"ばんぶつ"],[64,2,"そんざい"],[70,1,"つく"]],"text":"「われらの主なる神よ、あなたこそは、栄光とほまれと力とを受けるにふさわしいかた。あなたは万物を造られました。御旨によって、万物は存在し、また造られたのであります」。"}]