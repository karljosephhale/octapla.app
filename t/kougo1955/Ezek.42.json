[{"ref":"Ezek.42.1","start":26042001,"end":26042001,"break":"paragraph","ruby":[[0,1,"かれ"],[6,1,"きた"],[8,1,"ほう"],[10,2,"うちにわ"],[13,1,"つ"],[15,1,"だ"],[18,1,"にわ"],[20,1,"む"],[24,1,"きた"],[26,1,"ほう"],[28,2,"たてもの"],[31,1,"たい"],[34,1,"しつ"],[36,1,"みちび"]],"text":"彼はわたしを北の方の内庭に連れ出し、庭に向かった北の方の建物に対する室に導いた。"},{"ref":"Ezek.42.2","start":26042002,"end":26042002,"break":"none","ruby":[[0,2,"きたがわ"],[5,2,"たてもの"],[8,1,"なが"],[17,1,"はば"]],"text":"北側にある建物の長さは百キュビト、幅は五十キュビトである。"},{"ref":"Ezek.42.3","start":26042003,"end":26042003,"break":"none","ruby":[[7,2,"うちにわ"],[10,1,"つづ"],[14,1,"そと"],[15,1,"にわ"],[17,2,"しきいし"],[20,1,"めん"],[24,1,"かい"],[29,2,"ろうか"]],"text":"二十キュビトの内庭に続いて、外庭の敷石に面し、三階になった廊下があった。"},{"ref":"Ezek.42.4","start":26042004,"end":26042004,"break":"none","ruby":[[2,1,"しつ"],[4,1,"まえ"],[6,1,"はば"],[13,1,"なが"],[21,2,"つうろ"],[30,1,"と"],[32,1,"きた"],[34,1,"む"]],"text":"また室の前に幅十キュビト、長さ百キュビトの通路があった。その戸は北に向かっていた。"},{"ref":"Ezek.42.5","start":26042005,"end":26042005,"break":"none","ruby":[[2,2,"たてもの"],[5,1,"うえ"],[7,1,"しつ"],[10,1,"した"],[12,1,"しつ"],[14,1,"なか"],[16,1,"しつ"],[20,1,"せま"],[28,2,"ろうか"],[35,2,"ばしょ"],[38,1,"と"]],"text":"その建物の上の室は、下の室と中の室よりも狭かった。それは廊下のために、場所を取ったためである。"},{"ref":"Ezek.42.6","start":26042006,"end":26042006,"break":"none","ruby":[[5,1,"かい"],[11,1,"そと"],[12,1,"にわ"],[14,1,"はしら"],[19,1,"はしら"],[21,1,"も"],[31,1,"うえ"],[33,1,"しつ"],[36,1,"した"],[40,1,"なか"],[42,1,"しつ"],[46,1,"せま"]],"text":"これらは三階であって、外庭の柱のような柱は持たなかった。それで上の室は、下および中の室よりも狭いのである。"},{"ref":"Ezek.42.7","start":26042007,"end":26042007,"break":"none","ruby":[[0,1,"しつ"],[2,1,"そと"],[4,1,"そ"],[16,1,"た"],[18,1,"しつ"],[20,1,"む"],[24,1,"そと"],[25,1,"にわ"],[27,1,"いた"],[32,1,"なが"]],"text":"室の外に沿ってかきがあり、それは他の室に向かって外庭に至る。その長さは五十キュビト、"},{"ref":"Ezek.42.8","start":26042008,"end":26042008,"break":"none","ruby":[[0,1,"そと"],[1,1,"にわ"],[3,1,"しつ"],[5,1,"なが"],[18,1,"みや"],[20,1,"めん"],[23,1,"ところ"]],"text":"外庭の室の長さも五十キュビトあった。宮に面する所は百キュビトであった。"},{"ref":"Ezek.42.9","start":26042009,"end":26042009,"break":"none","ruby":[[4,1,"しつ"],[6,1,"した"],[8,1,"そと"],[9,1,"にわ"],[22,2,"ひがしがわ"],[25,2,"いりぐち"]],"text":"これらの室の下に外庭からこれにはいるように、東側に入口があった。"},{"ref":"Ezek.42.10","start":26042010,"end":26042010,"break":"none","breaks":[[17,"paragraph"]],"ruby":[[0,2,"そとがわ"],[7,1,"そと"],[8,1,"にわ"],[10,1,"はじ"],[17,1,"みなみ"],[19,1,"ほう"],[22,1,"にわ"],[24,2,"たてもの"],[28,1,"まえ"],[31,1,"しつ"]],"text":"外側のかきは、外庭に始まっている。南の方で、庭と建物との前に、室があった。"},{"ref":"Ezek.42.11","start":26042011,"end":26042011,"break":"none","ruby":[[0,1,"きた"],[1,1,"む"],[4,1,"しつ"],[6,2,"どうよう"],[12,1,"まえ"],[14,2,"つうろ"],[22,1,"なが"],[25,1,"はば"],[27,2,"どうよう"],[33,2,"でぐち"],[38,2,"はいち"],[43,1,"と"],[45,2,"どうよう"]],"text":"北向きの室と同様に、その前に通路があり、その長さも幅も同様で、その出口もその配置もその戸も同様である。"},{"ref":"Ezek.42.12","start":26042012,"end":26042012,"break":"none","ruby":[[0,1,"みなみ"],[2,1,"しつ"],[4,1,"した"],[7,2,"ひとびと"],[10,2,"つうろ"],[16,1,"ひがし"],[18,2,"いりぐち"],[27,1,"たい"],[30,1,"へだ"]],"text":"南の室の下に、人々が通路にはいる東の入口があり、これに対して隔てのかきがあった。"},{"ref":"Ezek.42.13","start":26042013,"end":26042013,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"かれ"],[8,1,"い"],[13,1,"にわ"],[15,1,"めん"],[18,1,"きた"],[20,1,"しつ"],[23,1,"みなみ"],[25,1,"しつ"],[29,1,"せい"],[32,1,"しつ"],[38,1,"しゅ"],[40,1,"ちか"],[42,1,"つか"],[45,2,"さいし"],[51,1,"もっと"],[53,1,"せい"],[59,1,"た"],[62,2,"ばしょ"],[70,2,"ばしょ"],[73,1,"かれ"],[77,1,"もっと"],[79,1,"せい"],[89,2,"そさい"],[92,2,"ざいさい"],[95,2,"けんさい"],[101,1,"お"],[114,2,"ばしょ"],[117,1,"せい"]],"text":"時に彼はわたしに言った、「庭に面した北の室と、南の室とは、聖なる室であって、主に近く仕える祭司たちが、最も聖なるものを食べる場所である。その場所に彼らは、最も聖なるもの、すなわち素祭、罪祭、愆祭のものを置かなければならない。その場所は聖だからである。"},{"ref":"Ezek.42.14","start":26042014,"end":26042014,"break":"none","ruby":[[0,2,"さいし"],[6,2,"せいじょ"],[13,1,"とき"],[20,1,"そと"],[21,1,"にわ"],[23,1,"で"],[31,1,"かれ"],[34,1,"つと"],[37,1,"おこな"],[39,2,"いふく"],[45,1,"ところ"],[47,1,"お"],[61,1,"せい"],[69,1,"かれ"],[72,2,"みんしゅう"],[75,1,"ぞく"],[78,2,"ばしょ"],[81,1,"ちか"],[84,1,"まえ"],[87,1,"た"],[89,2,"いふく"],[92,1,"つ"]],"text":"祭司たちが、聖所にはいった時は、そこから外庭に出てはならない。彼らは勤めを行う衣服を、その所に置かなければならない。これは聖だからである。彼らは民衆に属する場所に近づく前に、他の衣服を着けなければならない」。"},{"ref":"Ezek.42.15","start":26042015,"end":26042015,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"みや"],[5,1,"にわ"],[7,2,"ないぶ"],[10,1,"はか"],[12,1,"お"],[17,1,"ひがし"],[18,1,"む"],[21,1,"もん"],[23,1,"みち"],[31,1,"つ"],[33,1,"だ"],[37,1,"みや"],[39,2,"しゅうい"],[42,1,"はか"]],"text":"彼らは宮の庭の内部を測り終えると、東向きの門の道から、わたしを連れ出して、宮の周囲を測った。"},{"ref":"Ezek.42.16","start":26042016,"end":26042016,"break":"none","ruby":[[0,1,"かれ"],[2,1,"はか"],[8,2,"ひがしがわ"],[11,1,"はか"],[15,1,"はか"]],"text":"彼が測りざおで、東側を測ると、測りざおで五百キュビトあり、"},{"ref":"Ezek.42.17","start":26042017,"end":26042017,"break":"none","ruby":[[2,1,"てん"],[6,2,"きたがわ"],[9,1,"はか"],[13,1,"はか"]],"text":"また転じて、北側を測ると、測りざおで五百キュビトあり、"},{"ref":"Ezek.42.18","start":26042018,"end":26042018,"break":"none","ruby":[[2,1,"てん"],[6,2,"みなみがわ"],[9,1,"はか"],[13,1,"はか"]],"text":"また転じて、南側を測ると、測りざおで五百キュビトあり、"},{"ref":"Ezek.42.19","start":26042019,"end":26042019,"break":"none","ruby":[[2,1,"てん"],[6,2,"にしがわ"],[9,1,"はか"],[13,1,"はか"]],"text":"また転じて、西側を測ると、測りざおで五百キュビトあった。"},{"ref":"Ezek.42.20","start":26042020,"end":26042020,"break":"none","ruby":[[6,2,"しほう"],[9,1,"はか"],[16,2,"しゅうい"],[20,1,"なが"],[29,1,"はば"],[44,2,"せいじょ"],[48,1,"ぞく"],[50,1,"ところ"],[53,1,"へだ"]],"text":"このように、四方を測ったが、その周囲に、長さ五百キュビト、幅五百キュビトのかきがあって、聖所と、俗の所との隔てをなしていた。"}]