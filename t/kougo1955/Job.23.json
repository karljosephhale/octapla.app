[{"ref":"Job.23.1","start":18023001,"end":18023001,"break":"paragraph","ruby":[[6,1,"こた"],[9,1,"い"]],"text":"そこでヨブは答えて言った、"},{"ref":"Job.23.2","start":18023002,"end":18023002,"break":"stanza","breaks":[[21,"line"]],"ruby":[[17,1,"はげ"],[21,1,"かれ"],[23,1,"て"],[29,1,"なげ"],[38,1,"おも"]],"text":"「きょうもまた、わたしのつぶやきは激しく、彼の手はわたしの嘆きにかかわらず、重い。"},{"ref":"Job.23.3","start":18023003,"end":18023003,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"かれ"],[6,1,"たず"],[12,1,"あ"],[17,1,"し"],[23,1,"ざ"],[25,1,"いた"]],"text":"どうか、彼を尋ねてどこで会えるかを知り、そのみ座に至ることができるように。"},{"ref":"Job.23.4","start":18023004,"end":18023004,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かれ"],[6,1,"まえ"],[12,1,"うった"],[19,1,"くち"],[26,1,"ぎ"]],"text":"わたしは彼の前にわたしの訴えをならべ、口をきわめて論議するであろう。"},{"ref":"Job.23.5","start":18023005,"end":18023005,"break":"line","breaks":[[21,"line"]],"ruby":[[9,1,"こた"],[15,2,"ことば"],[18,1,"し"],[25,1,"い"],[29,1,"ところ"],[31,1,"さと"]],"text":"わたしは、わたしに答えられるみ言葉を知り、わたしに言われる所を悟ろう。"},{"ref":"Job.23.6","start":18023006,"end":18023006,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"かれ"],[2,1,"おお"],[6,1,"ちから"],[16,1,"あらそ"],[37,1,"かえり"]],"text":"彼は大いなる力をもって、わたしと争われるであろうか、いな、かえってわたしを顧みられるであろう。"},{"ref":"Job.23.7","start":18023007,"end":18023007,"break":"line","breaks":[[23,"line"],[43,"line"]],"ruby":[[5,1,"ただ"],[8,1,"ひと"],[10,1,"かれ"],[12,1,"い"],[14,1,"あらそ"],[40,1,"もの"],[43,2,"えいきゅう"],[46,1,"すく"]],"text":"かしこでは正しい人は彼と言い争うことができる。そうすれば、わたしはわたしをさばく者から永久に救われるであろう。"},{"ref":"Job.23.8","start":18023008,"end":18023008,"break":"stanza","breaks":[[18,"line"]],"ruby":[[0,1,"み"],[7,1,"すす"],[12,1,"かれ"],[14,1,"み"],[18,1,"しりぞ"],[23,1,"かれ"],[25,1,"みと"]],"text":"見よ、わたしが進んでも、彼を見ない。退いても、彼を認めることができない。"},{"ref":"Job.23.9","start":18023009,"end":18023009,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ひだり"],[2,1,"ほう"],[4,1,"たず"],[9,1,"あ"],[19,1,"みぎ"],[21,1,"ほう"],[23,1,"む"],[29,1,"み"]],"text":"左の方に尋ねても、会うことができない。右の方に向かっても、見ることができない。"},{"ref":"Job.23.10","start":18023010,"end":18023010,"break":"line","breaks":[[21,"line"],[35,"line"]],"ruby":[[3,1,"かれ"],[9,1,"あゆ"],[11,1,"みち"],[13,1,"し"],[21,1,"かれ"],[27,1,"こころ"],[39,1,"きん"],[44,1,"で"],[46,1,"く"]],"text":"しかし彼はわたしの歩む道を知っておられる。彼がわたしを試みられるとき、わたしは金のように出て来るであろう。"},{"ref":"Job.23.11","start":18023011,"end":18023011,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"あし"],[6,1,"かれ"],[8,1,"あゆ"],[11,1,"かた"],[13,1,"したが"],[21,1,"かれ"],[23,1,"みち"],[25,1,"まも"],[28,1,"はな"]],"text":"わたしの足は彼の歩みに堅く従った。わたしは彼の道を守って離れなかった。"},{"ref":"Job.23.12","start":18023012,"end":18023012,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かれ"],[11,2,"めいれい"],[21,1,"くち"],[23,2,"ことば"],[30,1,"むね"]],"text":"わたしは彼のくちびるの命令にそむかず、その口の言葉をわたしの胸にたくわえた。"},{"ref":"Job.23.13","start":18023013,"end":18023013,"break":"line","breaks":[[13,"line"],[32,"line"]],"ruby":[[3,1,"かれ"],[5,1,"かわ"],[16,1,"かれ"],[32,1,"かれ"],[36,1,"こころ"],[38,1,"ほっ"],[45,1,"おこな"]],"text":"しかし彼は変ることはない。だれが彼をひるがえすことができようか。彼はその心の欲するところを行われるのだ。"},{"ref":"Job.23.14","start":18023014,"end":18023014,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[9,1,"さだ"],[12,1,"こと"],[16,1,"と"],[30,1,"こと"],[32,1,"おお"],[34,1,"かれ"],[36,1,"こころ"]],"text":"彼はわたしのために定めた事をなし遂げられる。そしてこのような事が多く彼の心にある。"},{"ref":"Job.23.15","start":18023015,"end":18023015,"break":"line","breaks":[[18,"line"]],"ruby":[[9,1,"かれ"],[11,1,"まえ"],[22,1,"かんが"],[28,1,"かれ"],[30,1,"おそ"]],"text":"それゆえ、わたしは彼の前におののく。わたしは考えるとき、彼を恐れる。"},{"ref":"Job.23.16","start":18023016,"end":18023016,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[6,1,"こころ"],[8,1,"よわ"],[14,3,"ぜんのうしゃ"],[22,1,"おそ"]],"text":"神はわたしの心を弱くされた。全能者はわたしを恐れさせられた。"},{"ref":"Job.23.17","start":18023017,"end":18023017,"break":"line","breaks":[[18,"line"]],"ruby":[[11,1,"と"],[18,2,"あんこく"],[25,1,"かお"]],"text":"わたしは、やみによって閉じこめられ、暗黒がわたしの顔をおおっている。"}]