[{"ref":"Jas.5.1","start":59005001,"end":59005001,"break":"paragraph","ruby":[[0,1,"と"],[5,1,"ひと"],[12,1,"き"],[25,2,"じぶん"],[28,1,"み"],[30,1,"ふ"],[46,1,"おも"],[50,1,"な"],[52,1,"さけ"]],"text":"富んでいる人たちよ。よく聞きなさい。あなたがたは、自分の身に降りかかろうとしているわざわいを思って、泣き叫ぶがよい。"},{"ref":"Jas.5.2","start":59005002,"end":59005002,"break":"none","ruby":[[6,1,"とみ"],[8,1,"く"],[10,1,"は"],[13,2,"きもの"]],"text":"あなたがたの富は朽ち果て、着物はむしばまれ、"},{"ref":"Jas.5.3","start":59005003,"end":59005003,"break":"none","ruby":[[0,2,"きんぎん"],[18,1,"どく"],[27,1,"つみ"],[29,1,"せ"],[38,1,"にく"],[40,1,"ひ"],[45,1,"く"],[62,1,"おわ"],[65,1,"とき"],[74,1,"たから"]],"text":"金銀はさびている。そして、そのさびの毒は、あなたがたの罪を責め、あなたがたの肉を火のように食いつくすであろう。あなたがたは、終りの時にいるのに、なお宝をたくわえている。"},{"ref":"Jas.5.4","start":59005004,"end":59005004,"break":"none","ruby":[[0,1,"み"],[9,3,"ろうどうしゃ"],[15,1,"はたけ"],[17,2,"かりい"],[27,2,"しはら"],[34,2,"ちんぎん"],[38,1,"さけ"],[48,2,"かりい"],[54,1,"ひと"],[58,1,"さけ"],[60,1,"ごえ"],[66,2,"ばんぐん"],[69,1,"しゅ"],[71,1,"みみ"],[73,1,"たっ"]],"text":"見よ、あなたがたが労働者たちに畑の刈入れをさせながら、支払わずにいる賃銀が、叫んでいる。そして、刈入れをした人たちの叫び声が、すでに万軍の主の耳に達している。"},{"ref":"Jas.5.5","start":59005005,"end":59005005,"break":"none","ruby":[[7,2,"ちじょう"],[13,1,"くら"],[16,2,"かいらく"],[29,1,"ひ"],[39,1,"こころ"],[41,1,"こ"]],"text":"あなたがたは、地上でおごり暮し、快楽にふけり、「ほふらるる日」のために、おのが心を肥やしている。"},{"ref":"Jas.5.6","start":59005006,"end":59005006,"break":"none","ruby":[[4,2,"ぎじん"],[7,1,"つみ"],[9,1,"さだ"],[15,1,"ころ"],[22,1,"かれ"],[31,2,"ていこう"]],"text":"そして、義人を罪に定め、これを殺した。しかも彼は、あなたがたに抵抗しない。"},{"ref":"Jas.5.7","start":59005007,"end":59005007,"break":"paragraph","ruby":[[4,2,"きょうだい"],[10,1,"しゅ"],[12,2,"らいりん"],[15,1,"とき"],[18,1,"た"],[20,1,"しの"],[26,1,"み"],[29,2,"のうふ"],[33,1,"ち"],[35,1,"たっと"],[37,1,"みの"],[41,1,"まえ"],[43,1,"あめ"],[45,1,"のち"],[47,1,"あめ"],[55,1,"た"],[57,1,"しの"],[60,1,"ま"]],"text":"だから、兄弟たちよ。主の来臨の時まで耐え忍びなさい。見よ、農夫は、地の尊い実りを、前の雨と後の雨とがあるまで、耐え忍んで待っている。"},{"ref":"Jas.5.8","start":59005008,"end":59005008,"break":"none","ruby":[[7,1,"しゅ"],[9,2,"らいりん"],[12,1,"ちか"],[21,1,"た"],[23,1,"しの"],[29,1,"こころ"],[31,1,"つよ"]],"text":"あなたがたも、主の来臨が近づいているから、耐え忍びなさい。心を強くしていなさい。"},{"ref":"Jas.5.9","start":59005009,"end":59005009,"break":"none","ruby":[[0,2,"きょうだい"],[6,1,"たがい"],[8,2,"ふへい"],[11,1,"い"],[13,1,"あ"],[26,1,"う"],[31,1,"し"],[38,1,"み"],[44,1,"しゅ"],[50,2,"とぐち"],[53,1,"た"]],"text":"兄弟たちよ。互に不平を言い合ってはならない。さばきを受けるかも知れないから。見よ、さばき主が、すでに戸口に立っておられる。"},{"ref":"Jas.5.10","start":59005010,"end":59005010,"break":"none","ruby":[[0,2,"きょうだい"],[6,1,"くる"],[10,1,"た"],[12,1,"しの"],[22,1,"しゅ"],[24,2,"みな"],[30,1,"かた"],[33,3,"よげんしゃ"],[39,2,"もはん"]],"text":"兄弟たちよ。苦しみを耐え忍ぶことについては、主の御名によって語った預言者たちを模範にするがよい。"},{"ref":"Jas.5.11","start":59005011,"end":59005011,"break":"none","ruby":[[0,1,"しの"],[2,1,"ぬ"],[5,1,"ひと"],[24,1,"おも"],[37,2,"にんたい"],[43,1,"き"],[52,1,"しゅ"],[54,1,"かれ"],[63,2,"けつまつ"],[66,1,"み"],[69,1,"しゅ"],[74,2,"じあい"],[83,1,"と"]],"text":"忍び抜いた人たちはさいわいであると、わたしたちは思う。あなたがたは、ヨブの忍耐のことを聞いている。また、主が彼になさったことの結末を見て、主がいかに慈愛とあわれみとに富んだかたであるかが、わかるはずである。"},{"ref":"Jas.5.12","start":59005012,"end":59005012,"break":"paragraph","ruby":[[7,2,"きょうだい"],[13,1,"なに"],[20,1,"ちか"],[31,1,"てん"],[38,1,"ち"],[58,1,"ちか"],[70,1,"ちか"],[98,1,"いな"],[102,1,"いな"],[128,1,"う"]],"text":"さて、わたしの兄弟たちよ。何はともあれ、誓いをしてはならない。天をさしても、地をさしても、あるいは、そのほかのどんな誓いによっても、いっさい誓ってはならない。むしろ、「しかり」を「しかり」とし、「否」を「否」としなさい。そうしないと、あなたがたは、さばきを受けることになる。"},{"ref":"Jas.5.13","start":59005013,"end":59005013,"break":"paragraph","ruby":[[6,1,"なか"],[9,1,"くる"],[15,1,"もの"],[23,1,"ひと"],[26,1,"いの"],[32,1,"よろこ"],[37,1,"もの"],[45,1,"ひと"]],"text":"あなたがたの中に、苦しんでいる者があるか。その人は、祈るがよい。喜んでいる者があるか。その人は、さんびするがよい。"},{"ref":"Jas.5.14","start":59005014,"end":59005014,"break":"none","ruby":[[6,1,"なか"],[9,1,"や"],[14,1,"もの"],[22,1,"ひと"],[25,2,"きょうかい"],[28,2,"ちょうろう"],[33,1,"まね"],[36,1,"しゅ"],[38,2,"みな"],[48,1,"ゆ"],[50,1,"そそ"],[53,1,"いの"]],"text":"あなたがたの中に、病んでいる者があるか。その人は、教会の長老たちを招き、主の御名によって、オリブ油を注いで祈ってもらうがよい。"},{"ref":"Jas.5.15","start":59005015,"end":59005015,"break":"none","ruby":[[0,2,"しんこう"],[5,1,"いのり"],[8,1,"や"],[13,1,"ひと"],[15,1,"すく"],[22,1,"しゅ"],[26,1,"ひと"],[28,1,"た"],[35,1,"くだ"],[44,1,"ひと"],[46,1,"つみ"],[48,1,"おか"]],"text":"信仰による祈は、病んでいる人を救い、そして、主はその人を立ちあがらせて下さる。かつ、その人が罪を犯していたなら、それもゆるされる。"},{"ref":"Jas.5.16","start":59005016,"end":59005016,"break":"none","ruby":[[4,1,"たがい"],[6,1,"つみ"],[8,2,"こくはく"],[11,1,"あ"],[26,1,"たがい"],[31,1,"いの"],[37,2,"ぎじん"],[40,1,"いのり"],[43,1,"おお"],[46,1,"ちから"],[51,2,"こうか"]],"text":"だから、互に罪を告白し合い、また、いやされるようにお互のために祈りなさい。義人の祈は、大いに力があり、効果のあるものである。"},{"ref":"Jas.5.17","start":59005017,"end":59005017,"break":"none","ruby":[[11,1,"おな"],[13,2,"にんげん"],[21,1,"あめ"],[23,1,"ふ"],[31,1,"いのり"],[42,1,"ねん"],[45,1,"げつ"],[51,2,"ちじょう"],[54,1,"あめ"],[56,1,"ふ"]],"text":"エリヤは、わたしたちと同じ人間であったが、雨が降らないようにと祈をささげたところ、三年六か月のあいだ、地上に雨が降らなかった。"},{"ref":"Jas.5.18","start":59005018,"end":59005018,"break":"none","ruby":[[9,1,"いの"],[16,1,"てん"],[18,1,"あめ"],[20,1,"ふ"],[24,1,"ち"],[28,1,"み"]],"text":"それから、ふたたび祈ったところ、天は雨を降らせ、地はその実をみのらせた。"},{"ref":"Jas.5.19","start":59005019,"end":59005019,"break":"paragraph","ruby":[[4,2,"きょうだい"],[19,2,"しんり"],[22,1,"みち"],[25,1,"ふ"],[27,1,"まよ"],[29,1,"もの"],[38,1,"かれ"],[40,1,"ひ"]],"text":"わたしの兄弟たちよ。あなたがたのうち、真理の道から踏み迷う者があり、だれかが彼を引きもどすなら、"},{"ref":"Jas.5.20","start":59005020,"end":59005020,"break":"none","ruby":[[4,2,"つみびと"],[7,1,"まよ"],[10,1,"みち"],[13,1,"ひ"],[18,1,"ひと"],[28,1,"し"],[31,1,"すく"],[33,1,"だ"],[39,1,"おお"],[42,1,"つみ"],[56,1,"し"]],"text":"かように罪人を迷いの道から引きもどす人は、そのたましいを死から救い出し、かつ、多くの罪をおおうものであることを、知るべきである。"}]