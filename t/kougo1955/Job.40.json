[{"ref":"Job.40.1","start":18040001,"end":18040001,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"こた"],[10,1,"い"]],"text":"主はまたヨブに答えて言われた、"},{"ref":"Job.40.2","start":18040002,"end":18040002,"break":"stanza","breaks":[[20,"line"]],"ruby":[[1,2,"ひなん"],[5,1,"もの"],[7,3,"ぜんのうしゃ"],[11,1,"あらそ"],[20,1,"かみ"],[22,1,"ろん"],[25,1,"もの"],[30,1,"こた"]],"text":"「非難する者が全能者と争おうとするのか、神と論ずる者はこれに答えよ」。"},{"ref":"Job.40.3","start":18040003,"end":18040003,"break":"paragraph","ruby":[[7,1,"しゅ"],[9,1,"こた"],[12,1,"い"]],"text":"そこで、ヨブは主に答えて言った、"},{"ref":"Job.40.4","start":18040004,"end":18040004,"break":"stanza","breaks":[[19,"line"],[34,"line"]],"ruby":[[1,1,"み"],[12,1,"いや"],[15,1,"もの"],[26,1,"こた"],[36,1,"て"],[38,1,"くち"],[40,1,"あ"]],"text":"「見よ、わたしはまことに卑しい者です、なんとあなたに答えましょうか。ただ手を口に当てるのみです。"},{"ref":"Job.40.5","start":18040005,"end":18040005,"break":"line","breaks":[[23,"line"]],"ruby":[[8,1,"ど"],[9,1,"い"],[17,1,"い"],[27,1,"ど"],[28,1,"い"],[34,1,"かさ"],[37,1,"もう"]],"text":"わたしはすでに一度言いました、また言いません、すでに二度言いました、重ねて申しません」。"},{"ref":"Job.40.6","start":18040006,"end":18040006,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"かぜ"],[9,1,"なか"],[15,1,"こた"]],"text":"主はまたつむじ風の中からヨブに答えられた、"},{"ref":"Job.40.7","start":18040007,"end":18040007,"break":"stanza","breaks":[[18,"line"]],"ruby":[[5,1,"こし"],[7,1,"おび"],[11,1,"おとこ"],[26,1,"たず"],[34,1,"こた"]],"text":"「あなたは腰に帯して、男らしくせよ。わたしはあなたに尋ねる、わたしに答えよ。"},{"ref":"Job.40.8","start":18040008,"end":18040008,"break":"line","breaks":[[24,"line"],[36,"line"]],"ruby":[[11,2,"せきにん"],[14,1,"お"],[32,1,"ひ"],[36,2,"じぶん"],[39,1,"ぜ"]],"text":"あなたはなお、わたしに責任を負わそうとするのか。あなたはわたしを非とし、自分を是としようとするのか。"},{"ref":"Job.40.9","start":18040009,"end":18040009,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かみ"],[9,1,"うで"],[11,1,"も"],[19,1,"かみ"],[24,1,"こえ"]],"text":"あなたは神のような腕を持っているのか、神のような声でとどろきわたることができるか。"},{"ref":"Job.40.10","start":18040010,"end":18040010,"break":"line","breaks":[[21,"line"]],"ruby":[[4,2,"いこう"],[7,2,"そんげん"],[16,1,"み"],[18,1,"かざ"],[21,2,"えいこう"],[24,2,"かれい"],[33,1,"み"],[35,1,"よそお"]],"text":"あなたは威光と尊厳とをもってその身を飾り、栄光と華麗とをもってその身を装ってみよ。"},{"ref":"Job.40.11","start":18040011,"end":18040011,"break":"line","breaks":[[15,"line"]],"ruby":[[8,1,"いか"],[11,1,"も"],[19,1,"たか"],[22,1,"もの"],[24,1,"み"],[30,1,"ひく"]],"text":"あなたのあふるる怒りを漏らし、すべての高ぶる者を見て、これを低くせよ。"},{"ref":"Job.40.12","start":18040012,"end":18040012,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"たか"],[7,1,"もの"],[9,1,"み"],[22,2,"あくにん"],[27,1,"ところ"],[29,1,"ふ"]],"text":"すべての高ぶる者を見て、これをかがませ、また悪人をその所で踏みつけ、"},{"ref":"Job.40.13","start":18040013,"end":18040013,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[9,1,"なか"],[17,1,"かお"],[19,1,"かく"],[22,1,"ところ"],[24,1,"と"]],"text":"彼らをともにちりの中にうずめ、その顔を隠れた所に閉じこめよ。"},{"ref":"Job.40.14","start":18040014,"end":18040014,"break":"line","breaks":[[21,"line"],[29,"line"]],"ruby":[[25,1,"みぎ"],[27,1,"て"],[33,1,"すく"]],"text":"そうすれば、わたしもまた、あなたをほめて、あなたの右の手はあなたを救うことができるとしよう。"},{"ref":"Job.40.15","start":18040015,"end":18040015,"break":"stanza","breaks":[[6,"line"],[27,"line"]],"ruby":[[0,2,"かば"],[3,1,"み"],[13,2,"どうよう"],[20,1,"つく"],[27,1,"うし"],[32,1,"くさ"],[34,1,"く"]],"text":"河馬を見よ、これはあなたと同様にわたしが造ったもので、牛のように草を食う。"},{"ref":"Job.40.16","start":18040016,"end":18040016,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"み"],[5,1,"ちから"],[7,1,"こし"],[14,1,"いきお"],[17,1,"はら"],[19,1,"すじ"]],"text":"見よ、その力は腰にあり、その勢いは腹の筋にある。"},{"ref":"Job.40.17","start":18040017,"end":18040017,"break":"line","breaks":[[17,"line"]],"ruby":[[5,1,"お"],[7,2,"こうはく"],[13,1,"うご"],[22,1,"すじ"],[24,1,"たがい"],[29,1,"あ"]],"text":"これはその尾を香柏のように動かし、そのももの筋は互にからみ合う。"},{"ref":"Job.40.18","start":18040018,"end":18040018,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"ほね"],[4,2,"せいどう"],[7,1,"くだ"],[15,2,"ろっこつ"],[18,1,"てつ"],[20,1,"ぼう"]],"text":"その骨は青銅の管のようで、その肋骨は鉄の棒のようだ。"},{"ref":"Job.40.19","start":18040019,"end":18040019,"break":"line","breaks":[[18,"line"]],"ruby":[[3,1,"かみ"],[8,1,"だい"],[21,1,"つく"],[24,1,"もの"],[33,1,"さづ"]],"text":"これは神のわざの第一のものであって、これを造った者がこれにつるぎを授けた。"},{"ref":"Job.40.20","start":18040020,"end":18040020,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"やま"],[8,2,"しょくもつ"],[20,1,"の"],[22,1,"けもの"],[27,1,"あそ"]],"text":"山もこれがために食物をいだし、もろもろの野の獣もそこに遊ぶ。"},{"ref":"Job.40.21","start":18040021,"end":18040021,"break":"line","breaks":[[13,"line"]],"ruby":[[3,2,"さんそう"],[6,1,"き"],[8,1,"した"],[10,1,"ふ"],[13,1,"あし"],[15,1,"しげ"],[21,1,"ぬま"],[23,1,"かく"]],"text":"これは酸棗の木の下に伏し、葦の茂み、または沼に隠れている。"},{"ref":"Job.40.22","start":18040022,"end":18040022,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"さんそう"],[3,1,"き"],[7,1,"かげ"],[16,1,"かわ"],[18,1,"やなぎ"],[26,1,"かこ"]],"text":"酸棗の木はその陰でこれをおおい、川の柳はこれをめぐり囲む。"},{"ref":"Job.40.23","start":18040023,"end":18040023,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[0,1,"み"],[6,1,"かわ"],[8,1,"あ"],[16,1,"おどろ"],[28,1,"くち"],[30,1,"そそ"]],"text":"見よ、たとい川が荒れても、これは驚かない。ヨルダンがその口に注ぎかかっても、これはあわてない。"},{"ref":"Job.40.24","start":18040024,"end":18040024,"break":"line","breaks":[[21,"line"]],"ruby":[[10,1,"とら"],[30,1,"はな"],[32,1,"つらぬ"]],"text":"だれが、かぎでこれを捕えることができるか。だれが、わなでその鼻を貫くことができるか。"}]