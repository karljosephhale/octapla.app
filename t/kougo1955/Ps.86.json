[{"ref":"Ps.86.1","start":19086001,"end":19086001,"break":"paragraph","title":"ダビデの祈","breaks":[[25,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"みみ"],[9,1,"かたむ"],[18,1,"こた"],[29,1,"くる"],[34,1,"とぼ"]],"titleRuby":[[4,1,"いのり"]],"text":"主よ、あなたの耳を傾けて、わたしにお答えください。わたしは苦しみかつ乏しいからです。"},{"ref":"Ps.86.2","start":19086002,"end":19086002,"break":"line","breaks":[[16,"line"],[31,"line"],[55,"line"]],"ruby":[[9,1,"まも"],[20,1,"かみ"],[22,1,"うやま"],[24,1,"もの"],[35,2,"しんらい"],[48,1,"すく"],[63,1,"かみ"]],"text":"わたしのいのちをお守りください。わたしは神を敬う者だからです。あなたに信頼するあなたのしもべをお救いください。あなたはわたしの神です。"},{"ref":"Ps.86.3","start":19086003,"end":19086003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[29,1,"よ"]],"text":"主よ、わたしをあわれんでください。わたしはひねもすあなたに呼ばわります。"},{"ref":"Ps.86.4","start":19086004,"end":19086004,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"たましい"],[10,1,"よろこ"],[19,1,"しゅ"],[24,1,"たましい"],[30,1,"あお"],[32,1,"のぞ"]],"text":"あなたのしもべの魂を喜ばせてください。主よ、わが魂はあなたを仰ぎ望みます。"},{"ref":"Ps.86.5","start":19086005,"end":19086005,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"めぐ"],[13,2,"かんよう"],[24,1,"よ"],[32,1,"もの"],[40,1,"ゆた"],[43,1,"ほどこ"]],"text":"主よ、あなたは恵みふかく、寛容であって、あなたに呼ばわるすべての者にいつくしみを豊かに施されます。"},{"ref":"Ps.86.6","start":19086006,"end":19086006,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"いのり"],[9,1,"みみ"],[11,1,"かたむ"],[18,1,"ねが"],[21,1,"こえ"],[24,1,"き"]],"text":"主よ、わたしの祈に耳を傾け、わたしの願いの声をお聞きください。"},{"ref":"Ps.86.7","start":19086007,"end":19086007,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"なや"],[7,1,"ひ"],[17,1,"よ"],[32,1,"こた"]],"text":"わたしの悩みの日にわたしはあなたに呼ばわります。あなたはわたしに答えられるからです。"},{"ref":"Ps.86.8","start":19086008,"end":19086008,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"かみ"],[17,1,"ひと"],[20,1,"もの"],[36,1,"ひと"]],"text":"主よ、もろもろの神のうちにあなたに等しい者はなく、また、あなたのみわざに等しいものはありません。"},{"ref":"Ps.86.9","start":19086009,"end":19086009,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"つく"],[15,2,"くにたみ"],[22,1,"まえ"],[24,1,"き"],[27,1,"ふ"],[29,1,"おが"],[33,1,"な"]],"text":"主よ、あなたが造られたすべての国民はあなたの前に来て、伏し拝み、み名をあがめるでしょう。"},{"ref":"Ps.86.10","start":19086010,"end":19086010,"break":"line","breaks":[[25,"line"]],"ruby":[[4,1,"おお"],[8,1,"かみ"],[33,1,"かみ"]],"text":"あなたは大いなる神で、くすしきみわざをなされます。ただあなたのみ、神でいらせられます。"},{"ref":"Ps.86.11","start":19086011,"end":19086011,"break":"line","breaks":[[21,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"みち"],[13,1,"おし"],[29,2,"しんり"],[32,1,"あゆ"],[37,1,"こころ"],[46,1,"な"],[48,1,"おそ"]],"text":"主よ、あなたの道をわたしに教えてください。わたしはあなたの真理に歩みます。心をひとつにしてみ名を恐れさせてください。"},{"ref":"Ps.86.12","start":19086012,"end":19086012,"break":"line","breaks":[[25,"line"]],"ruby":[[2,1,"かみ"],[4,1,"しゅ"],[11,1,"こころ"],[21,2,"かんしゃ"],[32,1,"な"]],"text":"わが神、主よ、わたしは心をつくしてあなたに感謝し、とこしえに、み名をあがめるでしょう。"},{"ref":"Ps.86.13","start":19086013,"end":19086013,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"しめ"],[18,1,"おお"],[24,1,"たましい"],[26,2,"よみ"],[29,1,"ふか"],[31,1,"ところ"],[34,1,"たす"],[36,1,"だ"]],"text":"わたしに示されたあなたのいつくしみは大きく、わが魂を陰府の深い所から助け出されたからです。"},{"ref":"Ps.86.14","start":19086014,"end":19086014,"break":"line","breaks":[[19,"line"],[38,"line"]],"ruby":[[0,1,"かみ"],[3,1,"たか"],[6,1,"もの"],[12,1,"さか"],[16,1,"おこ"],[19,1,"あら"],[22,1,"もの"],[24,1,"む"],[35,1,"もと"],[38,1,"かれ"],[41,2,"じぶん"],[44,1,"まえ"],[50,1,"お"]],"text":"神よ、高ぶる者はわたしに逆らって起り、荒ぶる者の群れはわたしのいのちを求め、彼らは自分の前にあなたを置くことをしません。"},{"ref":"Ps.86.15","start":19086015,"end":19086015,"break":"line","breaks":[[21,"line"],[41,"line"]],"ruby":[[3,1,"しゅ"],[15,1,"めぐ"],[18,1,"と"],[21,1,"いか"],[41,1,"ゆた"],[44,1,"かみ"]],"text":"しかし主よ、あなたはあわれみと恵みに富み、怒りをおそくし、いつくしみと、まこととに豊かな神でいらせられます。"},{"ref":"Ps.86.16","start":19086016,"end":19086016,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[27,1,"ちから"],[29,1,"あた"],[41,1,"こ"],[44,1,"すく"]],"text":"わたしをかえりみ、わたしをあわれみ、あなたのしもべにみ力を与え、あなたのはしための子をお救いください。"},{"ref":"Ps.86.17","start":19086017,"end":19086017,"break":"line","breaks":[[16,"line"],[26,"line"],[42,"line"],[56,"line"],[70,"line"]],"ruby":[[9,1,"めぐ"],[36,1,"にく"],[38,1,"もの"],[46,1,"み"],[48,1,"は"],[56,1,"しゅ"],[67,1,"たす"],[74,1,"なぐさ"]],"text":"わたしに、あなたの恵みのしるしをあらわしてください。そうすれば、わたしを憎む者どもはわたしを見て恥じるでしょう。主よ、あなたはわたしを助け、わたしを慰められたからです。"}]