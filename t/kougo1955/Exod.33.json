[{"ref":"Exod.33.1","start":2033001,"end":2033001,"break":"paragraph","ruby":[[3,1,"しゅ"],[9,1,"い"],[29,1,"くに"],[32,1,"みちび"],[38,1,"たみ"],[45,1,"た"],[66,1,"ちか"],[78,2,"しそん"],[81,1,"あた"],[86,1,"い"],[89,1,"ち"]],"text":"さて、主はモーセに言われた、「あなたと、あなたがエジプトの国から導きのぼった民とは、ここを立ってわたしがアブラハム、イサク、ヤコブに誓って、『これをあなたの子孫に与える』と言った地にのぼりなさい。"},{"ref":"Exod.33.2","start":2033002,"end":2033002,"break":"none","ruby":[[8,1,"つかい"],[19,2,"さきだ"],[58,1,"お"],[60,1,"はら"]],"text":"わたしはひとりの使をつかわしてあなたに先立たせ、カナンびと、アモリびと、ヘテびと、ペリジびと、ヒビびと、エブスびとを追い払うであろう。"},{"ref":"Exod.33.3","start":2033003,"end":2033003,"break":"none","ruby":[[6,1,"ちち"],[8,1,"みつ"],[10,1,"なが"],[13,1,"ち"],[38,1,"たみ"],[49,1,"みち"],[57,1,"ほろ"],[81,2,"いっしょ"]],"text":"あなたがたは乳と蜜の流れる地にのぼりなさい。しかし、あなたがたは、かたくなな民であるから、わたしが道であなたがたを滅ぼすことのないように、あなたがたのうちにあって一緒にはのぼらないであろう」。"},{"ref":"Exod.33.4","start":2033004,"end":2033004,"break":"paragraph","ruby":[[0,1,"たみ"],[4,1,"わる"],[6,1,"し"],[10,1,"き"],[13,1,"うれ"],[22,1,"かざ"],[25,1,"み"],[27,1,"つ"],[30,1,"もの"]],"text":"民はこの悪い知らせを聞いて憂い、ひとりもその飾りを身に着ける者はなかった。"},{"ref":"Exod.33.5","start":2033005,"end":2033005,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[18,2,"ひとびと"],[21,1,"い"],[40,1,"たみ"],[51,2,"いっこく"],[69,2,"いっしょ"],[76,1,"い"],[88,1,"ほろ"],[100,1,"いま"],[108,1,"かざ"],[111,1,"み"],[114,1,"と"],[116,1,"さ"],[144,1,"し"]],"text":"主はモーセに言われた、「イスラエルの人々に言いなさい、『あなたがたは、かたくなな民である。もしわたしが一刻でも、あなたがたのうちにあって、一緒にのぼって行くならば、あなたがたを滅ぼすであろう。ゆえに、今、あなたがたの飾りを身から取り去りなさい。そうすればわたしはあなたがたになすべきことを知るであろう』」。"},{"ref":"Exod.33.6","start":2033006,"end":2033006,"break":"none","ruby":[[10,2,"ひとびと"],[16,1,"やま"],[17,2,"いらい"],[21,1,"かざ"],[24,1,"と"],[26,1,"のぞ"]],"text":"それで、イスラエルの人々はホレブ山以来その飾りを取り除いていた。"},{"ref":"Exod.33.7","start":2033007,"end":2033007,"break":"paragraph","ruby":[[4,2,"まくや"],[7,1,"と"],[14,2,"しゅくえい"],[17,1,"そと"],[20,2,"しゅくえい"],[23,1,"はな"],[26,1,"は"],[32,2,"かいけん"],[35,2,"まくや"],[38,1,"な"],[46,1,"しゅ"],[48,1,"うかが"],[50,1,"こと"],[54,1,"もの"],[56,1,"で"],[59,2,"しゅくえい"],[62,1,"そと"],[66,2,"かいけん"],[69,2,"まくや"],[72,1,"い"]],"text":"モーセは幕屋を取って、これを宿営の外に、宿営を離れて張り、これを会見の幕屋と名づけた。すべて主に伺い事のある者は出て、宿営の外にある会見の幕屋に行った。"},{"ref":"Exod.33.8","start":2033008,"end":2033008,"break":"none","ruby":[[4,1,"で"],[7,2,"まくや"],[10,1,"い"],[12,1,"とき"],[16,1,"たみ"],[20,1,"た"],[30,2,"まくや"],[45,2,"てんまく"],[48,2,"いりぐち"],[51,1,"た"],[54,1,"かれ"],[56,2,"みおく"]],"text":"モーセが出て、幕屋に行く時には、民はみな立ちあがり、モーセが幕屋にはいるまで、おのおのその天幕の入口に立って彼を見送った。"},{"ref":"Exod.33.9","start":2033009,"end":2033009,"break":"none","ruby":[[4,2,"まくや"],[12,1,"くも"],[14,1,"はしら"],[16,1,"くだ"],[19,2,"まくや"],[22,2,"いりぐち"],[25,1,"た"],[32,1,"しゅ"],[38,1,"かた"]],"text":"モーセが幕屋にはいると、雲の柱が下って幕屋の入口に立った。そして主はモーセと語られた。"},{"ref":"Exod.33.10","start":2033010,"end":2033010,"break":"none","ruby":[[0,1,"たみ"],[4,2,"まくや"],[7,2,"いりぐち"],[10,1,"くも"],[12,1,"はしら"],[14,1,"た"],[18,1,"み"],[22,1,"た"],[29,2,"じぶん"],[32,2,"てんまく"],[35,2,"いりぐち"],[38,2,"れいはい"]],"text":"民はみな幕屋の入口に雲の柱が立つのを見ると、立っておのおの自分の天幕の入口で礼拝した。"},{"ref":"Exod.33.11","start":2033011,"end":2033011,"break":"none","ruby":[[0,1,"ひと"],[4,1,"とも"],[6,1,"かた"],[12,1,"しゅ"],[18,1,"かお"],[20,1,"あ"],[24,1,"かた"],[37,2,"しゅくえい"],[40,1,"かえ"],[47,2,"じゅうしゃ"],[51,2,"わかもの"],[57,1,"こ"],[63,2,"まくや"],[66,1,"はな"]],"text":"人がその友と語るように、主はモーセと顔を合わせて語られた。こうしてモーセは宿営に帰ったが、その従者なる若者、ヌンの子ヨシュアは幕屋を離れなかった。"},{"ref":"Exod.33.12","start":2033012,"end":2033012,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"い"],[26,1,"たみ"],[28,1,"みちび"],[39,1,"い"],[49,2,"いっしょ"],[58,1,"もの"],[60,1,"し"],[89,1,"まえ"],[91,1,"えら"],[96,1,"まえ"],[104,1,"まえ"],[106,1,"めぐ"],[109,1,"え"],[113,1,"おお"]],"text":"モーセは主に言った、「ごらんください。あなたは『この民を導きのぼれ』とわたしに言いながら、わたしと一緒につかわされる者を知らせてくださいません。しかも、あなたはかつて『わたしはお前を選んだ。お前はまたわたしの前に恵みを得た』と仰せになりました。"},{"ref":"Exod.33.13","start":2033013,"end":2033013,"break":"none","ruby":[[3,1,"いま"],[16,1,"まえ"],[18,1,"めぐ"],[21,1,"え"],[36,1,"みち"],[38,1,"しめ"],[49,1,"し"],[57,1,"まえ"],[59,1,"めぐ"],[62,1,"え"],[76,2,"こくみん"],[83,1,"たみ"],[90,1,"おぼ"]],"text":"それで今、わたしがもし、あなたの前に恵みを得ますならば、どうか、あなたの道を示し、あなたをわたしに知らせ、あなたの前に恵みを得させてください。また、この国民があなたの民であることを覚えてください」。"},{"ref":"Exod.33.14","start":2033014,"end":2033014,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[10,2,"じしん"],[13,2,"いっしょ"],[16,1,"い"],[30,2,"あんそく"],[33,1,"あた"]],"text":"主は言われた「わたし自身が一緒に行くであろう。そしてあなたに安息を与えるであろう」。"},{"ref":"Exod.33.15","start":2033015,"end":2033015,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"い"],[15,2,"じしん"],[18,2,"いっしょ"],[21,1,"い"]],"text":"モーセは主に言った「もしあなた自身が一緒に行かれないならば、わたしたちをここからのぼらせないでください。"},{"ref":"Exod.33.16","start":2033016,"end":2033016,"break":"none","ruby":[[8,1,"たみ"],[16,1,"まえ"],[18,1,"めぐ"],[21,1,"え"],[27,1,"なに"],[32,1,"し"],[54,2,"いっしょ"],[57,1,"い"],[70,1,"たみ"],[74,1,"ち"],[76,1,"めん"],[80,2,"しょみん"],[83,1,"こと"]],"text":"わたしとあなたの民とが、あなたの前に恵みを得ることは、何によって知られましょうか。それはあなたがわたしたちと一緒に行かれて、わたしとあなたの民とが、地の面にある諸民と異なるものになるからではありませんか」。"},{"ref":"Exod.33.17","start":2033017,"end":2033017,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[20,1,"まえ"],[22,1,"めぐ"],[25,1,"え"],[33,1,"な"],[42,1,"し"],[51,1,"い"],[56,1,"こと"]],"text":"主はモーセに言われた、「あなたはわたしの前に恵みを得、またわたしは名をもってあなたを知るから、あなたの言ったこの事をもするであろう」。"},{"ref":"Exod.33.18","start":2033018,"end":2033018,"break":"none","ruby":[[4,1,"い"],[17,2,"えいこう"],[25,1,"しめ"]],"text":"モーセは言った、「どうぞ、あなたの栄光をわたしにお示しください」。"},{"ref":"Exod.33.19","start":2033019,"end":2033019,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[21,1,"ぜん"],[27,1,"まえ"],[29,1,"とお"],[33,1,"しゅ"],[35,1,"な"],[41,1,"まえ"],[55,1,"めぐ"],[61,1,"もの"],[63,1,"めぐ"],[74,1,"もの"]],"text":"主は言われた、「わたしはわたしのもろもろの善をあなたの前に通らせ、主の名をあなたの前にのべるであろう。わたしは恵もうとする者を恵み、あわれもうとする者をあわれむ」。"},{"ref":"Exod.33.20","start":2033020,"end":2033020,"break":"none","ruby":[[2,1,"い"],[20,1,"かお"],[22,1,"み"],[36,1,"み"],[41,1,"い"],[46,1,"ひと"]],"text":"また言われた、「しかし、あなたはわたしの顔を見ることはできない。わたしを見て、なお生きている人はないからである」。"},{"ref":"Exod.33.21","start":2033021,"end":2033021,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"い"],[11,1,"み"],[26,1,"ところ"],[35,1,"いわ"],[37,1,"うえ"],[39,1,"た"]],"text":"そして主は言われた、「見よ、わたしのかたわらに一つの所がある。あなたは岩の上に立ちなさい。"},{"ref":"Exod.33.22","start":2033022,"end":2033022,"break":"none","ruby":[[4,2,"えいこう"],[10,1,"とお"],[12,1,"す"],[26,1,"いわ"],[28,1,"さ"],[30,1,"め"],[32,1,"い"],[40,1,"とお"],[42,1,"す"],[48,1,"て"]],"text":"わたしの栄光がそこを通り過ぎるとき、わたしはあなたを岩の裂け目に入れて、わたしが通り過ぎるまで、手であなたをおおうであろう。"},{"ref":"Exod.33.23","start":2033023,"end":2033023,"break":"none","ruby":[[7,1,"て"],[27,1,"み"],[35,1,"かお"],[37,1,"み"]],"text":"そしてわたしが手をのけるとき、あなたはわたしのうしろを見るが、わたしの顔は見ないであろう」。"}]