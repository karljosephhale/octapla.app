[{"ref":"Gen.3.1","start":1003001,"end":1003001,"break":"paragraph","ruby":[[2,1,"しゅ"],[5,1,"かみ"],[7,1,"つく"],[11,1,"の"],[13,1,"い"],[15,1,"もの"],[24,1,"もっと"],[26,2,"こうかつ"],[36,1,"おんな"],[38,1,"い"],[43,1,"その"],[49,1,"き"],[53,1,"と"],[56,1,"た"],[67,1,"かみ"],[69,1,"い"]],"text":"さて主なる神が造られた野の生き物のうちで、へびが最も狡猾であった。へびは女に言った、「園にあるどの木からも取って食べるなと、ほんとうに神が言われたのですか」。"},{"ref":"Gen.3.2","start":1003002,"end":1003002,"break":"none","ruby":[[0,1,"おんな"],[5,1,"い"],[16,1,"その"],[18,1,"き"],[20,1,"み"],[22,1,"た"],[28,1,"ゆる"]],"text":"女はへびに言った、「わたしたちは園の木の実を食べることは許されていますが、"},{"ref":"Gen.3.3","start":1003003,"end":1003003,"break":"none","ruby":[[2,1,"その"],[4,2,"ちゅうおう"],[9,1,"き"],[11,1,"み"],[21,1,"と"],[24,1,"た"],[32,1,"ふ"],[37,1,"し"],[49,1,"かみ"],[51,1,"い"]],"text":"ただ園の中央にある木の実については、これを取って食べるな、これに触れるな、死んではいけないからと、神は言われました」。"},{"ref":"Gen.3.4","start":1003004,"end":1003004,"break":"none","ruby":[[3,1,"おんな"],[5,1,"い"],[16,1,"けっ"],[19,1,"し"]],"text":"へびは女に言った、「あなたがたは決して死ぬことはないでしょう。"},{"ref":"Gen.3.5","start":1003005,"end":1003005,"break":"none","ruby":[[3,1,"た"],[14,1,"め"],[16,1,"ひら"],[19,1,"かみ"],[24,2,"ぜんあく"],[27,1,"し"],[29,1,"もの"],[37,1,"かみ"],[39,1,"し"]],"text":"それを食べると、あなたがたの目が開け、神のように善悪を知る者となることを、神は知っておられるのです」。"},{"ref":"Gen.3.6","start":1003006,"end":1003006,"break":"none","ruby":[[0,1,"おんな"],[4,1,"き"],[6,1,"み"],[13,1,"た"],[17,1,"よ"],[20,1,"め"],[23,1,"うつく"],[27,1,"かしこ"],[33,1,"この"],[38,1,"おも"],[47,1,"み"],[49,1,"と"],[52,1,"た"],[57,1,"とも"],[61,1,"おっと"],[64,1,"あた"],[70,1,"かれ"],[72,1,"た"]],"text":"女がその木を見ると、それは食べるに良く、目には美しく、賢くなるには好ましいと思われたから、その実を取って食べ、また共にいた夫にも与えたので、彼も食べた。"},{"ref":"Gen.3.7","start":1003007,"end":1003007,"break":"none","ruby":[[8,1,"め"],[10,1,"ひら"],[13,2,"じぶん"],[18,1,"はだか"],[37,1,"は"],[42,1,"あ"],[47,1,"こし"],[49,1,"ま"]],"text":"すると、ふたりの目が開け、自分たちの裸であることがわかったので、いちじくの葉をつづり合わせて、腰に巻いた。"},{"ref":"Gen.3.8","start":1003008,"end":1003008,"break":"paragraph","ruby":[[0,1,"かれ"],[4,1,"ひ"],[6,1,"すず"],[9,1,"かぜ"],[11,1,"ふ"],[16,1,"その"],[18,1,"なか"],[20,1,"しゅ"],[23,1,"かみ"],[25,1,"あゆ"],[29,1,"おと"],[31,1,"き"],[39,1,"ひと"],[43,1,"つま"],[46,1,"しゅ"],[49,1,"かみ"],[51,1,"かお"],[53,1,"さ"],[57,1,"その"],[59,1,"き"],[61,1,"あいだ"],[63,1,"み"],[65,1,"かく"]],"text":"彼らは、日の涼しい風の吹くころ、園の中に主なる神の歩まれる音を聞いた。そこで、人とその妻とは主なる神の顔を避けて、園の木の間に身を隠した。"},{"ref":"Gen.3.9","start":1003009,"end":1003009,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"ひと"],[7,1,"よ"],[12,1,"い"]],"text":"主なる神は人に呼びかけて言われた、「あなたはどこにいるのか」。"},{"ref":"Gen.3.10","start":1003010,"end":1003010,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こた"],[7,1,"その"],[9,1,"なか"],[15,1,"あゆ"],[19,1,"おと"],[21,1,"き"],[28,1,"はだか"],[35,1,"おそ"],[38,1,"み"],[40,1,"かく"]],"text":"彼は答えた、「園の中であなたの歩まれる音を聞き、わたしは裸だったので、恐れて身を隠したのです」。"},{"ref":"Gen.3.11","start":1003011,"end":1003011,"break":"none","ruby":[[0,1,"かみ"],[2,1,"い"],[12,1,"はだか"],[22,1,"し"],[29,1,"た"],[35,1,"めい"],[41,1,"き"],[49,1,"と"],[52,1,"た"]],"text":"神は言われた、「あなたが裸であるのを、だれが知らせたのか。食べるなと、命じておいた木から、あなたは取って食べたのか」。"},{"ref":"Gen.3.12","start":1003012,"end":1003012,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こた"],[11,2,"いっしょ"],[23,1,"おんな"],[26,1,"き"],[29,1,"と"],[42,1,"た"]],"text":"人は答えた、「わたしと一緒にしてくださったあの女が、木から取ってくれたので、わたしは食べたのです」。"},{"ref":"Gen.3.13","start":1003013,"end":1003013,"break":"none","ruby":[[3,1,"しゅ"],[6,1,"かみ"],[8,1,"おんな"],[10,1,"い"],[36,1,"おんな"],[38,1,"こた"],[65,1,"た"]],"text":"そこで主なる神は女に言われた、「あなたは、なんということをしたのです」。女は答えた、「へびがわたしをだましたのです。それでわたしは食べました」。"},{"ref":"Gen.3.14","start":1003014,"end":1003014,"break":"none","breaks":[[13,"stanza"],[29,"line"],[47,"line"],[55,"line"],[68,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[8,1,"い"],[21,1,"こと"],[33,2,"かちく"],[36,1,"の"],[42,1,"けもの"],[47,1,"もっと"],[59,1,"はら"],[62,1,"は"],[68,2,"いっしょう"],[74,1,"た"]],"text":"主なる神はへびに言われた、「おまえは、この事を、したので、すべての家畜、野のすべての獣のうち、最ものろわれる。おまえは腹で、這いあるき、一生、ちりを食べるであろう。"},{"ref":"Gen.3.15","start":1003015,"end":1003015,"break":"line","breaks":[[10,"line"],[22,"line"],[38,"line"],[51,"line"]],"ruby":[[4,1,"うら"],[14,1,"おんな"],[29,1,"おんな"],[35,1,"あいだ"],[38,1,"かれ"],[48,1,"くだ"],[55,1,"かれ"],[61,1,"くだ"]],"text":"わたしは恨みをおく、おまえと女とのあいだに、おまえのすえと女のすえとの間に。彼はおまえのかしらを砕き、おまえは彼のかかとを砕くであろう」。"},{"ref":"Gen.3.16","start":1003016,"end":1003016,"break":"none","breaks":[[10,"stanza"],[32,"line"],[45,"line"],[61,"line"]],"ruby":[[3,1,"おんな"],[5,1,"い"],[19,1,"う"],[22,1,"くる"],[26,1,"おお"],[29,1,"ま"],[36,1,"くる"],[40,1,"こ"],[42,1,"う"],[56,1,"おっと"],[58,1,"した"],[61,1,"かれ"],[67,1,"おさ"]],"text":"つぎに女に言われた、「わたしはあなたの産みの苦しみを大いに増す。あなたは苦しんで子を産む。それでもなお、あなたは夫を慕い、彼はあなたを治めるであろう」。"},{"ref":"Gen.3.17","start":1003017,"end":1003017,"break":"none","breaks":[[48,"stanza"],[62,"line"]],"ruby":[[0,1,"さら"],[2,1,"ひと"],[4,1,"い"],[14,1,"つま"],[16,2,"ことば"],[19,1,"き"],[23,1,"た"],[33,1,"めい"],[36,1,"き"],[39,1,"と"],[42,1,"た"],[48,1,"ち"],[66,2,"いっしょう"],[69,1,"くる"],[73,1,"ち"],[76,2,"しょくもつ"],[79,1,"と"]],"text":"更に人に言われた、「あなたが妻の言葉を聞いて、食べるなと、わたしが命じた木から取って食べたので、地はあなたのためにのろわれ、あなたは一生、苦しんで地から食物を取る。"},{"ref":"Gen.3.18","start":1003018,"end":1003018,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ち"],[19,1,"しょう"],[26,1,"の"],[28,1,"くさ"],[30,1,"た"]],"text":"地はあなたのために、いばらとあざみとを生じ、あなたは野の草を食べるであろう。"},{"ref":"Gen.3.19","start":1003019,"end":1003019,"break":"line","breaks":[[23,"line"],[39,"line"]],"ruby":[[4,1,"かお"],[6,1,"あせ"],[12,1,"た"],[18,1,"つち"],[20,1,"かえ"],[27,1,"つち"],[30,1,"と"],[53,1,"かえ"]],"text":"あなたは顔に汗してパンを食べ、ついに土に帰る、あなたは土から取られたのだから。あなたは、ちりだから、ちりに帰る」。"},{"ref":"Gen.3.20","start":1003020,"end":1003020,"break":"paragraph","ruby":[[3,1,"ひと"],[7,1,"つま"],[9,1,"な"],[14,1,"な"],[19,2,"かのじょ"],[25,1,"い"],[28,1,"もの"],[30,1,"はは"]],"text":"さて、人はその妻の名をエバと名づけた。彼女がすべて生きた者の母だからである。"},{"ref":"Gen.3.21","start":1003021,"end":1003021,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"ひと"],[9,1,"つま"],[15,1,"かわ"],[17,2,"きもの"],[20,1,"つく"],[24,1,"かれ"],[27,1,"き"]],"text":"主なる神は人とその妻とのために皮の着物を造って、彼らに着せられた。"},{"ref":"Gen.3.22","start":1003022,"end":1003022,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[11,1,"み"],[14,1,"ひと"],[31,2,"ぜんあく"],[34,1,"し"],[43,1,"かれ"],[45,1,"て"],[47,1,"の"],[50,1,"いのち"],[52,1,"き"],[56,1,"と"],[59,1,"た"],[62,2,"えいきゅう"],[65,1,"い"],[70,1,"し"]],"text":"主なる神は言われた、「見よ、人はわれわれのひとりのようになり、善悪を知るものとなった。彼は手を伸べ、命の木からも取って食べ、永久に生きるかも知れない」。"},{"ref":"Gen.3.23","start":1003023,"end":1003023,"break":"none","ruby":[[3,1,"しゅ"],[6,1,"かみ"],[8,1,"かれ"],[14,1,"その"],[17,1,"お"],[19,1,"だ"],[23,1,"ひと"],[25,1,"つく"],[31,1,"つち"],[33,1,"たがや"]],"text":"そこで主なる神は彼をエデンの園から追い出して、人が造られたその土を耕させられた。"},{"ref":"Gen.3.24","start":1003024,"end":1003024,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ひと"],[4,1,"お"],[6,1,"だ"],[13,1,"その"],[15,1,"ひがし"],[24,1,"まわ"],[26,1,"ほのお"],[33,1,"お"],[37,1,"いのち"],[39,1,"き"],[41,1,"みち"],[43,1,"まも"]],"text":"神は人を追い出し、エデンの園の東に、ケルビムと、回る炎のつるぎとを置いて、命の木の道を守らせられた。"}]