[{"ref":"Hos.6.1","start":28006001,"end":28006001,"break":"paragraph","breaks":[[16,"line"],[38,"line"],[50,"line"]],"ruby":[[10,1,"しゅ"],[12,1,"かえ"],[16,1,"しゅ"],[26,1,"さ"],[44,1,"う"],[52,1,"つつ"]],"text":"「さあ、わたしたちは主に帰ろう。主はわたしたちをかき裂かれたが、またいやし、わたしたちを打たれたが、また包んでくださるからだ。"},{"ref":"Hos.6.2","start":28006002,"end":28006002,"break":"line","breaks":[[19,"line"],[36,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"のち"],[15,1,"い"],[20,1,"か"],[21,1,"め"],[29,1,"た"],[43,1,"まえ"],[45,1,"い"]],"text":"主は、ふつかの後、わたしたちを生かし、三日目にわたしたちを立たせられる。わたしたちはみ前で生きる。"},{"ref":"Hos.6.3","start":28006003,"end":28006003,"break":"line","breaks":[[12,"line"],[27,"line"],[45,"line"],[62,"line"]],"ruby":[[6,1,"しゅ"],[8,1,"し"],[15,1,"しゅ"],[17,1,"し"],[22,1,"もと"],[27,1,"しゅ"],[33,1,"ひかり"],[38,1,"かなら"],[40,1,"あらわ"],[45,1,"ふゆ"],[47,1,"あめ"],[59,1,"のぞ"],[62,1,"はる"],[64,1,"あめ"],[69,1,"ち"],[71,1,"うるお"]],"text":"わたしたちは主を知ろう、せつに主を知ることを求めよう。主はあしたの光のように必ず現れいで、冬の雨のように、わたしたちに臨み、春の雨のように地を潤される」。"},{"ref":"Hos.6.4","start":28006004,"end":28006004,"break":"stanza","breaks":[[22,"line"],[41,"line"],[59,"line"]],"ruby":[[15,1,"なに"],[34,1,"なに"],[47,1,"あい"],[53,1,"くも"],[66,1,"き"],[69,1,"つゆ"]],"text":"エフライムよ、わたしはあなたに何をしようか。ユダよ、わたしはあなたに何をしようか。あなたがたの愛はあしたの雲のごとく、また、たちまち消える露のようなものである。"},{"ref":"Hos.6.5","start":28006005,"end":28006005,"break":"line","breaks":[[18,"line"],[26,"line"],[43,"line"]],"ruby":[[9,3,"よげんしゃ"],[18,1,"かれ"],[21,1,"き"],[23,1,"たお"],[28,1,"くち"],[30,2,"ことば"],[36,1,"かれ"],[39,1,"ころ"],[49,1,"あらわ"],[51,1,"で"],[53,1,"ひかり"]],"text":"それゆえ、わたしは預言者たちによって彼らを切り倒し、わが口の言葉をもって彼らを殺した。わがさばきは現れ出る光のようだ。"},{"ref":"Hos.6.6","start":28006006,"end":28006006,"break":"line","breaks":[[21,"line"]],"ruby":[[10,1,"よろこ"],[13,2,"ぎせい"],[16,1,"よろこ"],[21,2,"はんさい"],[29,1,"かみ"],[31,1,"し"],[36,1,"よろこ"]],"text":"わたしはいつくしみを喜び、犠牲を喜ばない。燔祭よりもむしろ神を知ることを喜ぶ。"},{"ref":"Hos.6.7","start":28006007,"end":28006007,"break":"stanza","breaks":[[17,"line"]],"ruby":[[4,1,"かれ"],[11,2,"けいやく"],[14,1,"やぶ"]],"text":"ところが彼らはアダムで契約を破り、かしこでわたしにそむいた。"},{"ref":"Hos.6.8","start":28006008,"end":28006008,"break":"line","breaks":[[14,"line"]],"ruby":[[5,1,"あく"],[7,1,"おこな"],[9,1,"もの"],[11,1,"まち"],[14,1,"ち"],[16,2,"あしあと"],[19,1,"み"]],"text":"ギレアデは悪を行う者の町で、血の足跡で満たされている。"},{"ref":"Hos.6.9","start":28006009,"end":28006009,"break":"line","breaks":[[15,"line"],[25,"line"],[38,"line"]],"ruby":[[0,2,"とうぞく"],[3,1,"ひと"],[5,1,"ま"],[7,1,"ぶ"],[15,2,"さいし"],[20,1,"とう"],[22,1,"く"],[29,1,"ゆ"],[31,1,"みち"],[33,1,"ひと"],[35,1,"ころ"],[43,1,"かれ"],[46,1,"あ"],[49,1,"こと"],[51,1,"おこな"]],"text":"盗賊が人を待ち伏せするように、祭司たちは党を組み、シケムへ行く道で人を殺す。このように彼らは悪しき事を行う。"},{"ref":"Hos.6.10","start":28006010,"end":28006010,"break":"line","breaks":[[21,"line"],[37,"line"]],"ruby":[[10,1,"いえ"],[12,1,"おそ"],[16,1,"こと"],[18,1,"み"],[31,2,"いんこう"],[43,1,"けが"]],"text":"わたしはイスラエルの家に恐るべき事を見た。かしこでエフライムは淫行をなし、イスラエルは汚された。"},{"ref":"Hos.6.11","start":28006011,"end":28006011,"break":"stanza","breaks":[[24,"stanza"]],"ruby":[[12,2,"かりい"],[16,1,"さだ"],[30,1,"たみ"],[32,2,"はんえい"],[35,2,"かいふく"]],"text":"ユダよ、あなたのためにも刈入れが定められている。わたしがわが民の繁栄を回復するとき、"}]