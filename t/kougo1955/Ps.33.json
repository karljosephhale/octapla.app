[{"ref":"Ps.33.1","start":19033001,"end":19033001,"break":"paragraph","breaks":[[14,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[6,1,"しゅ"],[11,1,"よろこ"],[18,1,"なお"],[20,1,"もの"]],"text":"正しき者よ、主によって喜べ、さんびは直き者にふさわしい。"},{"ref":"Ps.33.2","start":19033002,"end":19033002,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"こと"],[5,1,"しゅ"],[13,2,"じゅうげん"],[16,2,"たてごと"],[22,1,"しゅ"]],"text":"琴をもって主をさんびせよ、十弦の立琴をもって主をほめたたえよ。"},{"ref":"Ps.33.3","start":19033003,"end":19033003,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"あたら"],[3,1,"うた"],[5,1,"しゅ"],[11,1,"うた"],[14,1,"よろこ"],[17,1,"こえ"],[22,1,"たく"],[25,1,"こと"]],"text":"新しい歌を主にむかって歌い、喜びの声をあげて巧みに琴をかきならせ。"},{"ref":"Ps.33.4","start":19033004,"end":19033004,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"なお"],[20,2,"しんじつ"]],"text":"主のみことばは直く、そのすべてのみわざは真実だからである。"},{"ref":"Ps.33.5","start":19033005,"end":19033005,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"せいぎ"],[5,2,"こうへい"],[9,1,"あい"],[14,1,"ち"],[16,1,"しゅ"],[24,1,"み"]],"text":"主は正義と公平とを愛される。地は主のいつくしみで満ちている。"},{"ref":"Ps.33.6","start":19033006,"end":19033006,"break":"line","breaks":[[21,"line"]],"ruby":[[5,1,"てん"],[7,1,"しゅ"],[17,1,"つく"],[21,1,"てん"],[23,2,"ばんぐん"],[26,1,"しゅ"],[28,1,"くち"],[30,1,"いき"],[35,1,"つく"]],"text":"もろもろの天は主のみことばによって造られ、天の万軍は主の口の息によって造られた。"},{"ref":"Ps.33.7","start":19033007,"end":19033007,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"うみ"],[4,1,"みず"],[6,1,"みず"],[10,1,"なか"],[12,1,"あつ"],[18,1,"あつ"],[21,1,"ふか"],[23,1,"ふち"],[25,1,"くら"]],"text":"主は海の水を水がめの中に集めるように集め、深い淵を倉におさめられた。"},{"ref":"Ps.33.8","start":19033008,"end":19033008,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"ぜん"],[1,1,"ち"],[3,1,"しゅ"],[5,1,"おそ"],[8,1,"よ"],[10,1,"す"],[16,1,"もの"],[18,1,"しゅ"],[20,1,"おそ"]],"text":"全地は主を恐れ、世に住むすべての者は主を恐れかしこめ。"},{"ref":"Ps.33.9","start":19033009,"end":19033009,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おお"],[17,1,"めい"],[24,1,"かた"],[26,1,"た"]],"text":"主が仰せられると、そのようになり、命じられると、堅く立ったからである。"},{"ref":"Ps.33.10","start":19033010,"end":19033010,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"くに"],[26,1,"たみ"],[28,1,"くわだ"]],"text":"主はもろもろの国のはかりごとをむなしくし、もろもろの民の企てをくじかれる。"},{"ref":"Ps.33.11","start":19033011,"end":19033011,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[13,1,"た"],[23,1,"おも"],[26,2,"よよ"],[29,1,"た"]],"text":"主のはかりごとはとこしえに立ち、そのみこころの思いは世々に立つ。"},{"ref":"Ps.33.12","start":19033012,"end":19033012,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"かみ"],[9,1,"くに"],[19,1,"しゅ"],[23,1,"し"],[24,1,"ぎょう"],[28,1,"えら"],[32,1,"たみ"]],"text":"主をおのが神とする国はさいわいである。主がその嗣業として選ばれた民はさいわいである。"},{"ref":"Ps.33.13","start":19033013,"end":19033013,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"てん"],[5,1,"み"],[15,1,"ひと"],[17,1,"こ"],[20,1,"み"]],"text":"主は天から見おろされ、すべての人の子らを見、"},{"ref":"Ps.33.14","start":19033014,"end":19033014,"break":"line","breaks":[[9,"line"]],"ruby":[[6,1,"ところ"],[9,1,"ち"],[11,1,"す"],[17,1,"ひと"]],"text":"そのおられる所から地に住むすべての人をながめられる。"},{"ref":"Ps.33.15","start":19033015,"end":19033015,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"かれ"],[8,1,"こころ"],[10,1,"つく"],[22,1,"こころ"]],"text":"主はすべて彼らの心を造り、そのすべてのわざに心をとめられる。"},{"ref":"Ps.33.16","start":19033016,"end":19033016,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"おう"],[4,2,"ぐんぜい"],[7,1,"おお"],[13,1,"すくい"],[15,1,"え"],[19,2,"ゆうし"],[24,1,"ちから"],[26,1,"おお"],[34,1,"たす"],[37,1,"え"]],"text":"王はその軍勢の多きによって救を得ない。勇士はその力の大いなるによって助けを得ない。"},{"ref":"Ps.33.17","start":19033017,"end":19033017,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"うま"],[2,2,"しょうり"],[5,1,"たの"],[15,1,"おお"],[19,1,"ちから"],[21,1,"ひと"],[23,1,"たす"]],"text":"馬は勝利に頼みとならない。その大いなる力も人を助けることはできない。"},{"ref":"Ps.33.18","start":19033018,"end":19033018,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,1,"め"],[7,1,"しゅ"],[9,1,"おそ"],[12,1,"もの"],[14,1,"うえ"],[27,1,"のぞ"],[29,1,"もの"],[31,1,"うえ"]],"text":"見よ、主の目は主を恐れる者の上にあり、そのいつくしみを望む者の上にある。"},{"ref":"Ps.33.19","start":19033019,"end":19033019,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"かれ"],[8,1,"たましい"],[10,1,"し"],[13,1,"すく"],[20,1,"とき"],[23,1,"い"]],"text":"これは主が彼らの魂を死から救い、ききんの時にも生きながらえさせるためである。"},{"ref":"Ps.33.20","start":19033020,"end":19033020,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"たましい"],[6,1,"しゅ"],[8,1,"ま"],[10,1,"のぞ"],[13,1,"しゅ"],[19,1,"たす"],[26,1,"たて"]],"text":"われらの魂は主を待ち望む。主はわれらの助け、われらの盾である。"},{"ref":"Ps.33.21","start":19033021,"end":19033021,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"せい"],[10,1,"な"],[12,2,"しんらい"],[25,1,"こころ"],[27,1,"しゅ"],[32,1,"よろこ"]],"text":"われらは主の聖なるみ名に信頼するがゆえに、われらの心は主にあって喜ぶ。"},{"ref":"Ps.33.22","start":19033022,"end":19033022,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"ま"],[9,1,"のぞ"],[29,1,"うえ"]],"text":"主よ、われらが待ち望むように、あなたのいつくしみをわれらの上にたれてください。"}]