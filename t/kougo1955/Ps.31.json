[{"ref":"Ps.31.1","start":19031001,"end":19031001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[18,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"よ"],[13,1,"たの"],[38,1,"ぎ"],[48,1,"たす"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"主よ、わたしはあなたに寄り頼みます。とこしえにわたしをはずかしめず、あなたの義をもってわたしをお助けください。"},{"ref":"Ps.31.2","start":19031002,"end":19031002,"break":"line","breaks":[[14,"line"],[31,"line"],[47,"line"]],"ruby":[[4,1,"みみ"],[10,1,"かたむ"],[24,1,"すく"],[42,1,"いわ"],[51,1,"すく"],[53,2,"けんご"],[56,1,"しろ"]],"text":"あなたの耳をわたしに傾けて、すみやかにわたしをお救いください。わたしのためにのがれの岩となり、わたしを救う堅固な城となってください。"},{"ref":"Ps.31.3","start":19031003,"end":19031003,"break":"line","breaks":[[23,"line"]],"ruby":[[13,1,"いわ"],[19,1,"しろ"],[24,1,"な"],[33,1,"ひ"],[40,1,"みちび"]],"text":"まことに、あなたはわたしの岩、わたしの城です。み名のためにわたしを引き、わたしを導き、"},{"ref":"Ps.31.4","start":19031004,"end":19031004,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[11,1,"もう"],[14,1,"あみ"],[21,1,"と"],[23,1,"だ"],[39,1,"さ"],[41,1,"どころ"]],"text":"わたしのためにひそかに設けた網からわたしを取り出してください。あなたはわたしの避け所です。"},{"ref":"Ps.31.5","start":19031005,"end":19031005,"break":"line","breaks":[[18,"line"],[27,"line"]],"ruby":[[7,1,"たましい"],[10,1,"て"],[18,1,"しゅ"],[24,1,"かみ"]],"text":"わたしは、わが魂をみ手にゆだねます。主、まことの神よ、あなたはわたしをあがなわれました。"},{"ref":"Ps.31.6","start":19031006,"end":19031006,"break":"line","breaks":[[24,"line"]],"ruby":[[8,2,"ぐうぞう"],[11,1,"こころ"],[13,1,"よ"],[16,1,"もの"],[18,1,"にく"],[31,1,"しゅ"],[33,2,"しんらい"]],"text":"あなたはむなしい偶像に心を寄せる者を憎まれます。しかしわたしは主に信頼し、"},{"ref":"Ps.31.7","start":19031007,"end":19031007,"break":"line","breaks":[[18,"line"],[35,"line"]],"ruby":[[10,1,"よろこ"],[12,1,"たの"],[26,1,"くる"],[39,1,"なや"]],"text":"あなたのいつくしみを喜び楽しみます。あなたがわたしの苦しみをかえりみ、わたしの悩みにみこころをとめ、"},{"ref":"Ps.31.8","start":19031008,"end":19031008,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"てき"],[6,1,"て"],[17,1,"あし"],[19,1,"ひろ"],[21,1,"ところ"],[23,1,"た"]],"text":"わたしを敵の手にわたさず、わたしの足を広い所に立たせられたからです。"},{"ref":"Ps.31.9","start":19031009,"end":19031009,"break":"line","breaks":[[17,"line"],[31,"line"],[46,"line"]],"ruby":[[0,1,"しゅ"],[21,1,"なや"],[23,1,"くる"],[35,1,"め"],[37,1,"うれ"],[43,1,"おとろ"],[50,1,"たましい"],[59,1,"おとろ"]],"text":"主よ、わたしをあわれんでください。わたしは悩み苦しんでいます。わたしの目は憂いによって衰え、わたしの魂も、からだもまた衰えました。"},{"ref":"Ps.31.10","start":19031010,"end":19031010,"break":"line","breaks":[[20,"line"],[37,"line"],[53,"line"]],"ruby":[[8,1,"かな"],[15,1,"き"],[24,1,"とし"],[26,1,"なげ"],[32,1,"き"],[41,1,"ちから"],[43,1,"くる"],[50,1,"つ"],[57,1,"ほね"],[59,1,"か"]],"text":"わたしのいのちは悲しみによって消えゆき、わたしの年は嘆きによって消えさり、わたしの力は苦しみによって尽き、わたしの骨は枯れはてました。"},{"ref":"Ps.31.11","start":19031011,"end":19031011,"break":"line","breaks":[[21,"line"],[31,"line"],[45,"line"]],"ruby":[[16,1,"もの"],[21,1,"とな"],[23,1,"びと"],[26,1,"おそ"],[31,1,"し"],[33,1,"ひと"],[36,1,"おそ"],[40,1,"もの"],[53,1,"み"],[55,1,"もの"],[57,1,"さ"],[60,1,"に"]],"text":"わたしはすべてのあだにそしられる者となり、隣り人には恐れられ、知り人には恐るべき者となり、ちまたでわたしを見る者は避けて逃げます。"},{"ref":"Ps.31.12","start":19031012,"end":19031012,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"し"],[7,1,"もの"],[12,1,"ひと"],[14,1,"こころ"],[16,1,"わす"],[21,1,"やぶ"],[24,1,"うつわ"]],"text":"わたしは死んだ者のように人の心に忘れられ、破れた器のようになりました。"},{"ref":"Ps.31.13","start":19031013,"end":19031013,"break":"line","breaks":[[25,"line"],[42,"line"],[59,"line"]],"ruby":[[9,1,"おお"],[12,1,"ひと"],[20,1,"き"],[26,1,"いた"],[28,1,"ところ"],[30,1,"おそ"],[42,1,"かれ"],[49,1,"さか"],[56,1,"はか"],[67,1,"と"]],"text":"まことに、わたしは多くの人のささやくのを聞きます、「至る所に恐るべきことがある」と。彼らはわたしに逆らってともに計り、わたしのいのちを取ろうと、たくらむのです。"},{"ref":"Ps.31.14","start":19031014,"end":19031014,"break":"line","breaks":[[25,"line"]],"ruby":[[4,1,"しゅ"],[15,2,"しんらい"],[20,1,"い"],[34,1,"かみ"]],"text":"しかし、主よ、わたしはあなたに信頼して、言います、「あなたはわたしの神である」と。"},{"ref":"Ps.31.15","start":19031015,"end":19031015,"break":"line","breaks":[[18,"line"],[31,"line"]],"ruby":[[4,1,"とき"],[11,1,"て"],[26,1,"てき"],[28,1,"て"],[35,1,"せ"],[37,1,"た"],[40,1,"もの"],[43,1,"すく"],[45,1,"だ"]],"text":"わたしの時はあなたのみ手にあります。わたしをわたしの敵の手と、わたしを責め立てる者から救い出してください。"},{"ref":"Ps.31.16","start":19031016,"end":19031016,"break":"line","breaks":[[13,"line"]],"ruby":[[1,1,"かお"],[7,1,"うえ"],[9,1,"かがや"],[27,1,"すく"]],"text":"み顔をしもべの上に輝かせ、いつくしみをもってわたしをお救いください。"},{"ref":"Ps.31.17","start":19031017,"end":19031017,"break":"line","breaks":[[18,"line"],[35,"line"],[47,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"よ"],[35,1,"あ"],[38,1,"もの"],[40,1,"はじ"],[47,1,"かれ"],[50,1,"こえ"],[58,2,"よみ"],[61,1,"い"]],"text":"主よ、わたしはあなたに呼ばわります、わたしをはずかしめないでください。悪しき者に恥をうけさせ、彼らに声をあげさせずに陰府に行かせてください。"},{"ref":"Ps.31.18","start":19031018,"end":19031018,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"たか"],[4,1,"あなど"],[11,1,"ただ"],[14,1,"もの"],[23,1,"いつわ"]],"text":"高ぶりと侮りとをもって正しい者をみだりにそしる偽りのくちびるをつぐませてください。"},{"ref":"Ps.31.19","start":19031019,"end":19031019,"break":"line","breaks":[[17,"line"],[30,"line"],[48,"line"]],"ruby":[[4,1,"おそ"],[7,1,"もの"],[21,1,"よ"],[23,1,"たの"],[25,1,"もの"],[30,1,"ひと"],[32,1,"こ"],[35,1,"まえ"],[37,1,"ほどこ"],[45,1,"めぐ"],[51,1,"おお"]],"text":"あなたを恐れる者のためにたくわえ、あなたに寄り頼む者のために人の子らの前に施されたあなたの恵みはいかに大いなるものでしょう。"},{"ref":"Ps.31.20","start":19031020,"end":19031020,"break":"line","breaks":[[19,"line"],[33,"line"],[45,"line"]],"ruby":[[4,1,"かれ"],[8,1,"まえ"],[14,1,"ところ"],[16,1,"かく"],[19,2,"ひとびと"],[28,1,"まぬか"],[35,2,"かりや"],[41,1,"ひそ"],[45,1,"した"],[47,1,"あらそ"],[50,1,"さ"]],"text":"あなたは彼らをみ前のひそかな所に隠して人々のはかりごとを免れさせ、また仮屋のうちに潜ませて舌の争いを避けさせられます。"},{"ref":"Ps.31.21","start":19031021,"end":19031021,"break":"line","breaks":[[9,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[9,2,"ほうい"],[14,1,"まち"],[23,1,"かこ"],[30,1,"しゅ"],[32,1,"おどろ"],[49,1,"しめ"]],"text":"主はほむべきかな、包囲された町のようにわたしが囲まれたとき、主は驚くばかりに、いつくしみをわたしに示された。"},{"ref":"Ps.31.22","start":19031022,"end":19031022,"break":"line","breaks":[[14,"line"],[35,"line"],[57,"line"]],"ruby":[[4,1,"おどろ"],[10,1,"い"],[23,1,"め"],[25,1,"まえ"],[28,1,"た"],[46,1,"たす"],[49,1,"よ"],[51,1,"もと"],[61,1,"ねが"],[64,1,"き"]],"text":"わたしは驚きあわてて言った、「わたしはあなたの目の前から断たれた」と。しかしわたしがあなたに助けを呼び求めたとき、わたしの願いを聞きいれられた。"},{"ref":"Ps.31.23","start":19031023,"end":19031023,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[4,2,"せいと"],[8,1,"しゅ"],[10,1,"あい"],[14,1,"しゅ"],[16,2,"しんじつ"],[19,1,"もの"],[21,1,"まも"],[34,1,"もの"],[42,1,"むく"]],"text":"すべての聖徒よ、主を愛せよ。主は真実な者を守られるが、おごりふるまう者にはしたたかに報いられる。"},{"ref":"Ps.31.24","start":19031024,"end":19031024,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"ま"],[7,1,"のぞ"],[9,1,"もの"],[12,1,"つよ"],[17,1,"こころ"],[19,2,"おお"]],"text":"すべて主を待ち望む者よ、強くあれ、心を雄々しくせよ。"}]