[{"ref":"2Chr.26.1","start":14026001,"end":14026001,"break":"paragraph","ruby":[[6,1,"たみ"],[8,1,"みな"],[16,1,"おう"],[23,1,"ちち"],[29,1,"かわ"],[34,1,"とき"],[38,1,"さい"]],"text":"そこでユダの民は皆ウジヤをとって王となし、その父アマジヤに代らせた。時に十六歳であった。"},{"ref":"2Chr.26.2","start":14026002,"end":14026002,"break":"none","ruby":[[0,1,"かれ"],[6,1,"た"],[31,1,"おう"],[35,2,"せんぞ"],[40,1,"とも"],[42,1,"ねむ"],[45,1,"のち"]],"text":"彼はエラテを建てて、これをふたたびユダのものにした。これはかの王がその先祖たちと共に眠った後であった。"},{"ref":"2Chr.26.3","start":14026003,"end":14026003,"break":"none","ruby":[[4,1,"おう"],[9,1,"とき"],[12,1,"さい"],[24,1,"ねん"],[26,1,"あいだ"],[27,1,"よ"],[29,1,"おさ"],[35,1,"はは"],[43,1,"もの"],[45,1,"な"]],"text":"ウジヤは王となった時十六歳で、エルサレムで五十二年の間世を治めた。その母はエルサレムの者で名をエコリヤといった。"},{"ref":"2Chr.26.4","start":14026004,"end":14026004,"break":"none","ruby":[[4,1,"ちち"],[19,1,"しゅ"],[21,1,"よ"],[24,1,"み"],[31,1,"おこな"]],"text":"ウジヤは父アマジヤがしたように、すべて主の良しと見られることを行った。"},{"ref":"2Chr.26.5","start":14026005,"end":14026005,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かみ"],[4,1,"おそ"],[10,2,"じぶん"],[13,1,"おし"],[21,1,"よ"],[25,1,"ひ"],[27,1,"あいだ"],[29,1,"かみ"],[31,1,"もと"],[37,1,"つと"],[41,1,"かれ"],[43,1,"しゅ"],[45,1,"もと"],[48,1,"あいだ"],[50,1,"かみ"],[52,1,"かれ"],[54,1,"さか"]],"text":"彼は神を恐れることを自分に教えたゼカリヤの世にある日の間、神を求めることに努めた。彼が主を求めた間、神は彼を栄えさせられた。"},{"ref":"2Chr.26.6","start":14026006,"end":14026006,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"で"],[11,1,"たたか"],[17,2,"じょうへき"],[24,2,"じょうへき"],[34,2,"じょうへき"],[46,1,"ち"],[58,1,"まち"],[60,1,"た"]],"text":"彼は出てペリシテびとと戦い、ガテの城壁、ヤブネの城壁およびアシドドの城壁をくずし、アシドドの地とペリシテびとのなかに町を建てた。"},{"ref":"2Chr.26.7","start":14026007,"end":14026007,"break":"none","ruby":[[0,1,"かみ"],[2,1,"かれ"],[4,1,"たす"],[21,1,"す"],[38,1,"せ"],[40,1,"う"]],"text":"神は彼を助けてペリシテびとと、グルバアルに住むアラビヤびとおよびメウニびとを攻め撃たせられた。"},{"ref":"2Chr.26.8","start":14026008,"end":14026008,"break":"none","ruby":[[15,1,"おさ"],[23,2,"ひじょう"],[26,1,"つよ"],[36,1,"な"],[43,2,"いりぐち"],[48,1,"ひろ"]],"text":"アンモンびとはウジヤにみつぎを納めた。ウジヤは非常に強くなったので、その名はエジプトの入口までも広まった。"},{"ref":"2Chr.26.9","start":14026009,"end":14026009,"break":"none","ruby":[[12,1,"すみ"],[14,1,"もん"],[16,1,"たに"],[18,1,"もん"],[22,2,"じょうへき"],[25,1,"まが"],[34,1,"た"],[41,2,"けんご"]],"text":"ウジヤはまたエルサレムの隅の門、谷の門および城壁の曲りかどにやぐらを建てて、これを堅固にした。"},{"ref":"2Chr.26.10","start":14026010,"end":14026010,"break":"none","ruby":[[0,1,"かれ"],[4,2,"あらの"],[11,1,"た"],[16,1,"おお"],[19,1,"みず"],[23,1,"ほ"],[27,1,"かれ"],[29,2,"へいや"],[33,2,"へいち"],[42,2,"かちく"],[56,1,"かれ"],[60,2,"のうじ"],[63,1,"この"],[69,2,"やまやま"],[74,1,"こ"],[77,1,"はたけ"],[80,2,"のうふ"],[90,1,"もの"]],"text":"彼はまた荒野にやぐらを建て、また多くの水ためを掘った。彼は平野にも平地にもたくさんの家畜をもっていたからである。彼はまた農事を好んだので、山々および肥えた畑には農夫とぶどうをつくる者をもっていた。"},{"ref":"2Chr.26.11","start":14026011,"end":14026011,"break":"none","ruby":[[8,1,"たたか"],[11,2,"ぐんだん"],[14,1,"も"],[20,1,"かれ"],[23,2,"しょき"],[42,1,"しら"],[45,1,"かず"],[47,1,"したが"],[50,2,"くみぐみ"],[53,1,"わか"],[56,1,"みな"],[57,1,"おう"],[59,1,"ぐん"],[60,1,"ちょう"],[70,2,"しき"],[72,1,"した"]],"text":"ウジヤはまたよく戦う一軍団を持っていた。彼らは書記エイエルと、つかさマアセヤによって調べた数に従って組々に分れ、皆王の軍長のひとりハナニヤの指揮下にあった。"},{"ref":"2Chr.26.12","start":14026012,"end":14026012,"break":"none","ruby":[[2,2,"しぞく"],[5,1,"ちょう"],[9,1,"だい"],[10,2,"ゆうし"],[13,1,"かず"],[15,1,"あ"],[23,1,"にん"]],"text":"その氏族の長である大勇士の数は合わせて二千六百人であった。"},{"ref":"2Chr.26.13","start":14026013,"end":14026013,"break":"none","ruby":[[2,2,"しき"],[4,1,"した"],[8,2,"ぐんぜい"],[18,1,"にん"],[21,1,"みな"],[22,1,"おお"],[26,1,"ちから"],[31,1,"たたか"],[34,1,"おう"],[36,1,"たす"],[39,1,"てき"],[41,1,"あた"]],"text":"その指揮下にある軍勢は三十万七千五百人で、皆大いなる力をもって戦い、王を助けて敵に当った。"},{"ref":"2Chr.26.14","start":14026014,"end":14026014,"break":"none","ruby":[[6,1,"ぜん"],[7,1,"ぐん"],[12,1,"たて"],[25,1,"ゆみ"],[29,1,"いし"],[30,1,"な"],[33,1,"いし"],[35,1,"そな"]],"text":"ウジヤはその全軍のために盾、やり、かぶと、よろい、弓および石投げの石を備えた。"},{"ref":"2Chr.26.15","start":14026015,"end":14026015,"break":"none","ruby":[[0,1,"かれ"],[10,2,"ぎじゅつ"],[12,1,"もの"],[14,2,"こうあん"],[18,2,"きかい"],[21,1,"つく"],[34,2,"じょうへき"],[51,1,"や"],[55,2,"おおいし"],[58,2,"しゃしゅつ"],[67,1,"かれ"],[69,2,"めいせい"],[72,1,"とお"],[76,1,"ひろ"],[81,1,"かれ"],[83,1,"おどろ"],[87,1,"かみ"],[89,1,"たす"],[92,1,"え"],[94,1,"つよ"]],"text":"彼はまたエルサレムで技術者の考案した機械を造って、これをやぐらおよび城壁のすみずみにすえ、これをもって矢および大石を射出した。こうして彼の名声は遠くまで広まった。彼が驚くほど神の助けを得て強くなったからである。"},{"ref":"2Chr.26.16","start":14026016,"end":14026016,"break":"paragraph","ruby":[[4,1,"かれ"],[6,1,"つよ"],[11,1,"およ"],[17,1,"こころ"],[19,1,"たか"],[26,2,"じぶん"],[29,1,"ほろ"],[33,1,"いた"],[41,1,"かれ"],[45,1,"かみ"],[47,1,"しゅ"],[53,1,"つみ"],[55,1,"おか"],[58,1,"しゅ"],[60,1,"みや"],[66,1,"こう"],[68,2,"さいだん"],[71,1,"うえ"],[73,1,"こう"]],"text":"ところが彼は強くなるに及んで、その心に高ぶり、ついに自分を滅ぼすに至った。すなわち彼はその神、主にむかって罪を犯し、主の宮にはいって香の祭壇の上に香をたこうとした。"},{"ref":"2Chr.26.17","start":14026017,"end":14026017,"break":"none","ruby":[[2,1,"とき"],[4,2,"さいし"],[11,1,"しゅ"],[13,2,"さいし"],[18,2,"ゆうし"],[22,1,"にん"],[24,1,"ひき"],[28,1,"かれ"],[33,1,"したが"]],"text":"その時、祭司アザリヤは主の祭司である勇士八十人を率いて、彼のあとに従ってはいり、"},{"ref":"2Chr.26.18","start":14026018,"end":14026018,"break":"none","ruby":[[3,1,"おう"],[5,1,"ひ"],[7,1,"と"],[10,1,"い"],[20,1,"しゅ"],[22,1,"こう"],[50,2,"しそん"],[54,1,"こう"],[61,1,"きよ"],[66,2,"さいし"],[80,2,"せいじょ"],[84,1,"で"],[93,1,"つみ"],[95,1,"おか"],[105,1,"しゅ"],[108,1,"かみ"],[111,1,"さか"],[114,1,"え"]],"text":"ウジヤ王を引き止めて言った、「ウジヤよ、主に香をたくことはあなたのなすべきことではなく、ただアロンの子孫で、香をたくために清められた祭司たちのすることです。すぐ聖所から出なさい。あなたは罪を犯しました。あなたは主なる神から栄えを得ることはできません」。"},{"ref":"2Chr.26.19","start":14026019,"end":14026019,"break":"none","ruby":[[7,1,"いか"],[10,1,"はっ"],[13,2,"こうろ"],[16,1,"て"],[21,1,"こう"],[31,1,"かれ"],[33,2,"さいし"],[36,1,"む"],[40,1,"いか"],[43,1,"はっ"],[48,1,"あいだ"],[53,1,"びょう"],[57,1,"ひたい"],[59,1,"た"],[63,1,"とき"],[65,1,"かれ"],[67,1,"しゅ"],[69,1,"みや"],[71,2,"さいし"],[76,1,"まえ"],[78,1,"こう"],[80,2,"さいだん"]],"text":"するとウジヤは怒りを発し、香炉を手にとって香をたこうとしたが、彼が祭司に向かって怒りを発している間に、らい病がその額に起った。時に彼は主の宮で祭司たちの前、香の祭壇のかたわらにいた。"},{"ref":"2Chr.26.20","start":14026020,"end":14026020,"break":"none","ruby":[[0,2,"さいし"],[3,1,"ちょう"],[15,2,"さいし"],[20,1,"かれ"],[22,1,"み"],[26,1,"かれ"],[28,1,"ひたい"],[32,1,"びょう"],[34,1,"しょう"],[42,1,"いそ"],[45,1,"かれ"],[51,1,"お"],[53,1,"だ"],[57,1,"かれ"],[58,2,"じしん"],[63,1,"しゅ"],[65,1,"う"],[72,1,"し"],[76,1,"いそ"],[79,1,"で"],[81,1,"い"]],"text":"祭司の長アザリヤおよびすべての祭司たちが彼を見ると、彼の額にらい病が生じていたので、急いで彼をそこから追い出した。彼自身もまた主に撃たれたことを知って、急いで出て行った。"},{"ref":"2Chr.26.21","start":14026021,"end":14026021,"break":"none","ruby":[[3,1,"おう"],[6,1,"し"],[8,1,"ひ"],[13,2,"びょうにん"],[20,1,"かれ"],[24,2,"びょうにん"],[33,1,"はな"],[35,1,"どの"],[37,1,"す"],[41,1,"しゅ"],[43,1,"みや"],[46,1,"た"],[58,1,"こ"],[63,1,"おう"],[65,1,"いえ"],[73,1,"くに"],[75,1,"たみ"],[77,1,"おさ"]],"text":"ウジヤ王は、死ぬ日までらい病人であった。彼はらい病人であったので、離れ殿に住んだ。主の宮から断たれたからである。その子ヨタムが王の家をつかさどり、国の民を治めた。"},{"ref":"2Chr.26.22","start":14026022,"end":14026022,"break":"none","ruby":[[6,1,"た"],[8,2,"しじゅう"],[11,2,"こうい"],[19,1,"こ"],[20,3,"よげんしゃ"],[30,1,"か"]],"text":"ウジヤのその他の始終の行為は、アモツの子預言者イザヤがこれを書きしるした。"},{"ref":"2Chr.26.23","start":14026023,"end":14026023,"break":"none","ruby":[[4,2,"せんぞ"],[9,1,"とも"],[11,1,"ねむ"],[17,2,"ひとびと"],[21,1,"かれ"],[25,2,"びょうにん"],[32,1,"い"],[36,1,"おう"],[40,1,"はか"],[42,1,"つら"],[45,2,"ぼち"],[51,2,"せんぞ"],[56,1,"とも"],[58,1,"ほうむ"],[64,1,"こ"],[69,1,"かれ"],[71,1,"かわ"],[74,1,"おう"]],"text":"ウジヤは先祖たちと共に眠ったので、人々は「彼はらい病人である」と言って、王たちの墓に連なる墓地に、その先祖たちと共に葬った。その子ヨタムが彼に代って王となった。"}]