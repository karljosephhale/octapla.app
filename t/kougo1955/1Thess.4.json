[{"ref":"1Thess.4.1","start":52004001,"end":52004001,"break":"paragraph","ruby":[[0,2,"さいご"],[4,2,"きょうだい"],[16,1,"しゅ"],[30,1,"ねが"],[34,1,"すす"],[50,1,"ある"],[53,1,"かみ"],[55,1,"よろこ"],[69,1,"まな"],[81,1,"ある"],[95,1,"ある"],[97,1,"つづ"]],"text":"最後に、兄弟たちよ。わたしたちは主イエスにあってあなたがたに願いかつ勧める。あなたがたが、どのように歩いて神を喜ばすべきかをわたしたちから学んだように、また、いま歩いているとおりに、ますます歩き続けなさい。"},{"ref":"1Thess.4.2","start":52004002,"end":52004002,"break":"none","ruby":[[10,1,"おしえ"],[12,1,"しゅ"],[20,1,"あた"],[33,1,"し"]],"text":"わたしたちがどういう教を主イエスによって与えたか、あなたがたはよく知っている。"},{"ref":"1Thess.4.3","start":52004003,"end":52004003,"break":"none","ruby":[[0,1,"かみ"],[14,1,"きよ"],[29,3,"ふひんこう"],[33,1,"つつし"]],"text":"神のみこころは、あなたがたが清くなることである。すなわち、不品行を慎み、"},{"ref":"1Thess.4.4","start":52004004,"end":52004004,"break":"none","ruby":[[0,2,"かくじ"],[3,1,"き"],[8,2,"じぶん"],[15,1,"きよ"],[17,1,"たっと"],[19,1,"たも"]],"text":"各自、気をつけて自分のからだを清く尊く保ち、"},{"ref":"1Thess.4.5","start":52004005,"end":52004005,"break":"none","ruby":[[0,1,"かみ"],[2,1,"し"],[6,3,"いほうじん"],[13,2,"じょうよく"]],"text":"神を知らない異邦人のように情欲をほしいままにせず、"},{"ref":"1Thess.4.6","start":52004006,"end":52004006,"break":"none","ruby":[[11,2,"きょうだい"],[14,1,"ふ"],[34,1,"まえ"],[47,2,"けいこく"],[58,1,"しゅ"],[74,1,"むく"]],"text":"また、このようなことで兄弟を踏みつけたり、だましたりしてはならない。前にもあなたがたにきびしく警告しておいたように、主はこれらすべてのことについて、報いをなさるからである。"},{"ref":"1Thess.4.7","start":52004007,"end":52004007,"break":"none","ruby":[[0,1,"かみ"],[8,1,"め"],[15,1,"けが"],[30,1,"きよ"]],"text":"神がわたしたちを召されたのは、汚れたことをするためではなく、清くなるためである。"},{"ref":"1Thess.4.8","start":52004008,"end":52004008,"break":"none","ruby":[[16,2,"けいこく"],[19,1,"こば"],[21,1,"もの"],[24,1,"ひと"],[26,1,"こば"],[34,2,"せいれい"],[43,1,"こころ"],[45,1,"たま"],[48,1,"かみ"],[50,1,"こば"]],"text":"こういうわけであるから、これらの警告を拒む者は、人を拒むのではなく、聖霊をあなたがたの心に賜わる神を拒むのである。"},{"ref":"1Thess.4.9","start":52004009,"end":52004009,"break":"paragraph","ruby":[[0,2,"きょうだい"],[2,1,"あい"],[9,1,"いま"],[12,1,"か"],[17,2,"ひつよう"],[30,1,"たがい"],[32,1,"あい"],[34,1,"あ"],[39,1,"かみ"],[41,2,"ちょくせつ"],[43,1,"おし"]],"text":"兄弟愛については、今さら書きおくる必要はない。あなたがたは、互に愛し合うように神に直接教えられており、"},{"ref":"1Thess.4.10","start":52004010,"end":52004010,"break":"none","ruby":[[3,2,"じじつ"],[10,2,"ぜんど"],[19,2,"きょうだい"],[22,1,"たい"],[29,2,"じっこう"],[44,2,"きょうだい"],[56,1,"すす"]],"text":"また、事実マケドニヤ全土にいるすべての兄弟に対して、それを実行しているのだから。しかし、兄弟たちよ。あなたがたに勧める。ますます、そうしてほしい。"},{"ref":"1Thess.4.11","start":52004011,"end":52004011,"break":"none","ruby":[[10,1,"めい"],[24,1,"お"],[26,1,"つ"],[29,2,"せいかつ"],[34,2,"じぶん"],[37,2,"しごと"],[40,1,"み"],[45,1,"て"],[49,1,"はたら"]],"text":"そして、あなたがたに命じておいたように、つとめて落ち着いた生活をし、自分の仕事に身をいれ、手ずから働きなさい。"},{"ref":"1Thess.4.12","start":52004012,"end":52004012,"break":"none","ruby":[[6,2,"がいぶ"],[9,2,"ひとびと"],[12,1,"たい"],[15,2,"ひんい"],[18,1,"たも"],[26,2,"せわ"],[35,2,"せいかつ"]],"text":"そうすれば、外部の人々に対して品位を保ち、まただれの世話にもならずに、生活できるであろう。"},{"ref":"1Thess.4.13","start":52004013,"end":52004013,"break":"paragraph","ruby":[[0,2,"きょうだい"],[6,1,"ねむ"],[11,2,"ひとびと"],[19,2,"むち"],[32,1,"のぞ"],[35,1,"も"],[39,1,"ほか"],[41,2,"ひとびと"],[54,1,"かな"]],"text":"兄弟たちよ。眠っている人々については、無知でいてもらいたくない。望みを持たない外の人々のように、あなたがたが悲しむことのないためである。"},{"ref":"1Thess.4.14","start":52004014,"end":52004014,"break":"none","ruby":[[6,1,"しん"],[19,1,"し"],[22,2,"ふっかつ"],[32,2,"どうよう"],[35,1,"かみ"],[44,1,"ねむ"],[49,2,"ひとびと"],[58,2,"いっしょ"],[61,1,"みち"],[63,1,"だ"],[66,1,"くだ"]],"text":"わたしたちが信じているように、イエスが死んで復活されたからには、同様に神はイエスにあって眠っている人々をも、イエスと一緒に導き出して下さるであろう。"},{"ref":"1Thess.4.15","start":52004015,"end":52004015,"break":"none","ruby":[[6,1,"しゅ"],[8,2,"ことば"],[14,1,"い"],[18,1,"い"],[25,1,"しゅ"],[27,2,"らいりん"],[30,1,"とき"],[33,1,"のこ"],[42,1,"ねむ"],[45,2,"ひとびと"],[49,1,"さき"],[57,1,"けっ"]],"text":"わたしたちは主の言葉によって言うが、生きながらえて主の来臨の時まで残るわたしたちが、眠った人々より先になることは、決してないであろう。"},{"ref":"1Thess.4.16","start":52004016,"end":52004016,"break":"none","ruby":[[5,1,"しゅ"],[7,2,"じしん"],[10,2,"てんし"],[17,1,"こえ"],[19,1,"かみ"],[25,1,"な"],[27,1,"ひび"],[33,2,"あいず"],[36,1,"こえ"],[39,1,"てん"],[42,1,"くだ"],[52,1,"とき"],[62,1,"し"],[65,2,"ひとびと"],[71,2,"さいしょ"]],"text":"すなわち、主ご自身が天使のかしらの声と神のラッパの鳴り響くうちに、合図の声で、天から下ってこられる。その時、キリストにあって死んだ人々が、まず最初によみがえり、"},{"ref":"1Thess.4.17","start":52004017,"end":52004017,"break":"none","ruby":[[4,1,"い"],[6,1,"のこ"],[18,1,"かれ"],[21,1,"とも"],[23,1,"くも"],[25,1,"つつ"],[29,1,"ひ"],[31,1,"あ"],[36,2,"くうちゅう"],[39,1,"しゅ"],[41,1,"あ"],[52,1,"しゅ"],[54,1,"とも"]],"text":"それから生き残っているわたしたちが、彼らと共に雲に包まれて引き上げられ、空中で主に会い、こうして、いつも主と共にいるであろう。"},{"ref":"1Thess.4.18","start":52004018,"end":52004018,"break":"none","ruby":[[15,2,"ことば"],[21,1,"たがい"],[23,1,"なぐさ"],[25,1,"あ"]],"text":"だから、あなたがたは、これらの言葉をもって互に慰め合いなさい。"}]