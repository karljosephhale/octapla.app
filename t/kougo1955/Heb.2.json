[{"ref":"Heb.2.1","start":58002001,"end":58002001,"break":"paragraph","ruby":[[16,1,"き"],[31,1,"つよ"],[33,1,"こころ"],[35,1,"と"],[53,1,"なが"]],"text":"こういうわけだから、わたしたちは聞かされていることを、いっそう強く心に留めねばならない。そうでないと、おし流されてしまう。"},{"ref":"Heb.2.2","start":58002002,"end":58002002,"break":"none","ruby":[[6,2,"みつかい"],[15,1,"かた"],[19,2,"みことば"],[22,2,"こうりょく"],[25,1,"も"],[32,2,"ざいか"],[35,1,"ふ"],[36,2,"じゅうじゅん"],[40,1,"たい"],[43,2,"せいとう"],[46,1,"むく"],[49,1,"くわ"]],"text":"というのは、御使たちをとおして語られた御言が効力を持ち、あらゆる罪過と不従順とに対して正当な報いが加えられたとすれば、"},{"ref":"Heb.2.3","start":58002003,"end":58002003,"break":"none","ruby":[[11,1,"たっと"],[13,1,"すくい"],[28,1,"むく"],[46,1,"すくい"],[49,1,"はじ"],[51,1,"しゅ"],[56,1,"かた"],[67,1,"き"],[70,2,"ひとびと"]],"text":"わたしたちは、こんなに尊い救をなおざりにしては、どうして報いをのがれることができようか。この救は、初め主によって語られたものであって、聞いた人々からわたしたちにあかしされ、"},{"ref":"Heb.2.4","start":58002004,"end":58002004,"break":"none","ruby":[[3,1,"かみ"],[10,3,"ふしぎ"],[19,1,"ちから"],[32,2,"みむね"],[35,1,"したが"],[37,2,"せいれい"],[40,2,"かくじ"],[43,1,"たま"]],"text":"さらに神も、しるしと不思議とさまざまな力あるわざとにより、また、御旨に従い聖霊を各自に賜うことによって、あかしをされたのである。"},{"ref":"Heb.2.5","start":58002005,"end":58002005,"break":"paragraph","ruby":[[5,1,"かみ"],[17,1,"かた"],[27,2,"せかい"],[31,2,"みつかい"],[36,2,"ふくじゅう"]],"text":"いったい、神は、わたしたちがここで語っているきたるべき世界を、御使たちに服従させることは、なさらなかった。"},{"ref":"Heb.2.6","start":58002006,"end":58002006,"break":"none","breaks":[[19,"stanza"],[29,"line"],[46,"line"],[56,"line"]],"ruby":[[0,2,"せいしょ"],[5,2,"かしょ"],[20,2,"にんげん"],[23,2,"なにもの"],[32,1,"み"],[33,1,"こころ"],[35,1,"と"],[46,1,"ひと"],[48,1,"こ"],[50,2,"なにもの"]],"text":"聖書はある箇所で、こうあかししている、「人間が何者だから、これを御心に留められるのだろうか。人の子が何者だから、これをかえりみられるのだろうか。"},{"ref":"Heb.2.7","start":58002007,"end":58002007,"break":"line","breaks":[[12,"line"],[28,"line"]],"ruby":[[10,1,"あいだ"],[12,1,"かれ"],[14,2,"みつかい"],[21,1,"ひく"],[23,1,"もの"],[28,2,"えいこう"],[36,1,"かんむり"],[40,1,"かれ"],[42,1,"あた"]],"text":"あなたは、しばらくの間、彼を御使たちよりも低い者となし、栄光とほまれとを冠として彼に与え、"},{"ref":"Heb.2.8","start":58002008,"end":58002008,"break":"line","ruby":[[0,2,"ばんぶつ"],[5,1,"あし"],[7,1,"した"],[9,2,"ふくじゅう"],[14,1,"くだ"],[21,2,"ばんぶつ"],[24,1,"かれ"],[26,2,"ふくじゅう"],[31,1,"くだ"],[39,2,"いじょう"],[42,2,"ふくじゅう"],[51,1,"なに"],[55,1,"のこ"],[72,1,"いま"],[76,2,"ばんぶつ"],[79,1,"かれ"],[81,2,"ふくじゅう"],[87,2,"じじつ"],[97,1,"み"]],"text":"万物をその足の下に服従させて下さった」。「万物を彼に服従させて下さった」という以上、服従しないものは、何ひとつ残されていないはずである。しかし、今もなお万物が彼に服従している事実を、わたしたちは見ていない。"},{"ref":"Heb.2.9","start":58002009,"end":58002009,"break":"none","ruby":[[9,1,"あいだ"],[11,2,"みつかい"],[18,1,"ひく"],[20,1,"もの"],[31,1,"し"],[33,1,"くる"],[41,2,"えいこう"],[49,1,"かんむり"],[53,1,"あた"],[60,1,"み"],[67,1,"かれ"],[69,1,"かみ"],[71,1,"めぐ"],[82,1,"ひと"],[87,1,"し"],[89,1,"あじ"]],"text":"ただ、「しばらくの間、御使たちよりも低い者とされた」イエスが、死の苦しみのゆえに、栄光とほまれとを冠として与えられたのを見る。それは、彼が神の恵みによって、すべての人のために死を味わわれるためであった。"},{"ref":"Heb.2.10","start":58002010,"end":58002010,"break":"none","ruby":[[5,2,"ばんぶつ"],[8,1,"き"],[15,2,"ばんぶつ"],[18,1,"つく"],[26,1,"おお"],[29,1,"こ"],[32,2,"えいこう"],[35,1,"みちび"],[40,1,"かれ"],[43,1,"すくい"],[45,1,"きみ"],[48,2,"くなん"],[55,1,"まっと"],[63,1,"かれ"]],"text":"なぜなら、万物の帰すべきかた、万物を造られたかたが、多くの子らを栄光に導くのに、彼らの救の君を、苦難をとおして全うされたのは、彼にふさわしいことであったからである。"},{"ref":"Heb.2.11","start":58002011,"end":58002011,"break":"none","ruby":[[0,1,"じつ"],[17,1,"もの"],[22,1,"みな"],[31,1,"で"],[41,1,"しゅ"],[44,1,"かれ"],[47,2,"きょうだい"],[50,1,"よ"],[55,1,"はじ"]],"text":"実に、きよめるかたも、きよめられる者たちも、皆ひとりのかたから出ている。それゆえに主は、彼らを兄弟と呼ぶことを恥とされない。"},{"ref":"Heb.2.12","start":58002012,"end":58002012,"break":"none","breaks":[[5,"stanza"],[29,"line"]],"ruby":[[11,2,"みな"],[18,2,"きょうだい"],[23,1,"つ"],[25,1,"し"],[29,2,"きょうかい"],[32,1,"なか"],[41,1,"うた"],[46,1,"い"]],"text":"すなわち、「わたしは、御名をわたしの兄弟たちに告げ知らせ、教会の中で、あなたをほめ歌おう」と言い、"},{"ref":"Heb.2.13","start":58002013,"end":58002013,"break":"none","breaks":[[3,"stanza"],[20,"stanza"]],"ruby":[[9,1,"かれ"],[13,1,"たの"],[21,1,"み"],[29,1,"かみ"],[35,1,"たま"],[39,1,"こ"],[45,1,"い"]],"text":"また、「わたしは、彼により頼む」、また、「見よ、わたしと、神がわたしに賜わった子らとは」と言われた。"},{"ref":"Heb.2.14","start":58002014,"end":58002014,"break":"none","ruby":[[6,1,"こ"],[10,1,"ち"],[12,1,"にく"],[15,1,"とも"],[33,2,"どうよう"],[54,1,"し"],[56,1,"ちから"],[58,1,"も"],[60,1,"もの"],[66,2,"あくま"],[71,2,"じぶん"],[74,1,"し"],[79,1,"ほろ"]],"text":"このように、子たちは血と肉とに共にあずかっているので、イエスもまた同様に、それらをそなえておられる。それは、死の力を持つ者、すなわち悪魔を、ご自分の死によって滅ぼし、"},{"ref":"Heb.2.15","start":58002015,"end":58002015,"break":"none","ruby":[[0,1,"し"],[2,2,"きょうふ"],[8,1,"いっ"],[9,2,"しょうがい"],[12,2,"どれい"],[20,1,"もの"],[25,1,"と"],[27,1,"はな"]],"text":"死の恐怖のために一生涯、奴隷となっていた者たちを、解き放つためである。"},{"ref":"Heb.2.16","start":58002016,"end":58002016,"break":"none","ruby":[[0,1,"たし"],[4,1,"かれ"],[6,2,"てんし"],[11,1,"たす"],[28,2,"しそん"],[31,1,"たす"]],"text":"確かに、彼は天使たちを助けることはしないで、アブラハムの子孫を助けられた。"},{"ref":"Heb.2.17","start":58002017,"end":58002017,"break":"none","ruby":[[9,1,"かみ"],[19,1,"ぶか"],[21,2,"ちゅうじつ"],[24,3,"だいさいし"],[32,1,"たみ"],[34,1,"つみ"],[48,1,"てん"],[53,2,"きょうだい"],[58,1,"おな"]],"text":"そこで、イエスは、神のみまえにあわれみ深い忠実な大祭司となって、民の罪をあがなうために、あらゆる点において兄弟たちと同じようにならねばならなかった。"},{"ref":"Heb.2.18","start":58002018,"end":58002018,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"じしん"],[5,2,"しれん"],[8,1,"う"],[11,1,"くる"],[21,2,"しれん"],[24,1,"なか"],[28,1,"もの"],[32,1,"たす"]],"text":"主ご自身、試錬を受けて苦しまれたからこそ、試錬の中にある者たちを助けることができるのである。"}]