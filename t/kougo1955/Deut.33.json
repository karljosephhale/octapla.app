[{"ref":"Deut.33.1","start":5033001,"end":5033001,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"ひと"],[7,1,"し"],[9,1,"まえ"],[17,2,"ひとびと"],[20,2,"しゅくふく"],[25,2,"しゅくふく"],[28,2,"ことば"],[31,1,"つぎ"]],"text":"神の人モーセは死ぬ前にイスラエルの人々を祝福した。祝福の言葉は次のとおりである。"},{"ref":"Deut.33.2","start":5033002,"end":5033002,"break":"stanza","breaks":[[12,"line"],[31,"line"],[44,"line"],[60,"line"]],"ruby":[[1,1,"しゅ"],[35,1,"やま"],[38,1,"ひかり"],[40,1,"はな"],[49,2,"せいじゃ"],[52,1,"なか"],[62,1,"みぎ"],[64,1,"て"],[67,1,"も"],[70,1,"ひ"]],"text":"「主はシナイからこられ、セイルからわれわれにむかってのぼられ、パランの山から光を放たれ、ちよろずの聖者の中からこられた。その右の手には燃える火があった。"},{"ref":"Deut.33.3","start":5033003,"end":5033003,"break":"line","breaks":[[15,"line"],[38,"line"],[53,"line"]],"ruby":[[4,1,"しゅ"],[8,1,"たみ"],[10,1,"あい"],[18,1,"しゅ"],[20,2,"せいべつ"],[30,1,"て"],[38,1,"かれ"],[45,1,"あし"],[49,1,"ざ"],[53,1,"おしえ"]],"text":"まことに主はその民を愛される。すべて主に聖別されたものは、み手のうちにある。彼らはあなたの足もとに座して、教をうける。"},{"ref":"Deut.33.4","start":5033004,"end":5033004,"break":"line","breaks":[[16,"line"]],"ruby":[[9,2,"りっぽう"],[12,1,"さづ"],[20,2,"かいしゅう"],[23,2,"しょゆう"]],"text":"モーセはわれわれに律法を授けて、ヤコブの会衆の所有とさせた。"},{"ref":"Deut.33.5","start":5033005,"end":5033005,"break":"line","breaks":[[12,"line"],[29,"line"]],"ruby":[[0,1,"たみ"],[8,1,"あつ"],[18,2,"ぶぞく"],[23,1,"あつ"],[27,1,"とき"],[29,1,"しゅ"],[40,1,"おう"]],"text":"民のかしらたちが集まり、イスラエルの部族がみな集まった時、主はエシュルンのうちに王となられた」。"},{"ref":"Deut.33.6","start":5033006,"end":5033006,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"い"],[9,1,"し"],[22,2,"にんずう"],[25,1,"すく"]],"text":"「ルベンは生きる、死にはしない。しかし、その人数は少なくなるであろう」。"},{"ref":"Deut.33.7","start":5033007,"end":5033007,"break":"line","breaks":[[14,"line"],[27,"line"],[44,"line"],[64,"line"]],"ruby":[[10,1,"い"],[15,1,"しゅ"],[21,1,"こえ"],[23,1,"き"],[27,1,"かれ"],[31,1,"たみ"],[33,1,"みちび"],[45,1,"て"],[51,1,"かれ"],[56,1,"たたか"],[64,1,"かれ"],[66,1,"たす"],[70,1,"てき"],[72,1,"あた"]],"text":"ユダについては、こう言った、「主よ、ユダの声を聞いて、彼をその民に導きかえしてください。み手をもって、彼のために戦ってください。彼を助けて、敵に当らせてください」。"},{"ref":"Deut.33.8","start":5033008,"end":5033008,"break":"line","breaks":[[11,"line"],[32,"line"],[53,"line"],[69,"line"]],"ruby":[[7,1,"い"],[24,1,"あた"],[40,1,"つか"],[43,1,"ひと"],[45,1,"あた"],[64,1,"かれ"],[66,1,"こころ"],[73,1,"みず"],[79,1,"かれ"],[81,1,"あらそ"]],"text":"レビについては言った、「あなたのトンミムをレビに与えてください。ウリムをあなたに仕える人に与えてください。かつてあなたはマッサで彼を試み、メリバの水のほとりで彼と争われた。"},{"ref":"Deut.33.9","start":5033009,"end":5033009,"break":"line","breaks":[[17,"line"],[31,"line"],[44,"line"],[58,"line"],[73,"line"]],"ruby":[[0,1,"かれ"],[4,1,"ちち"],[8,1,"はは"],[13,1,"い"],[22,1,"かれ"],[25,1,"かえり"],[31,1,"かれ"],[33,2,"じぶん"],[36,2,"きょうだい"],[40,1,"みと"],[44,2,"じぶん"],[47,2,"こども"],[51,1,"かえり"],[58,1,"かれ"],[65,2,"ことば"],[77,2,"けいやく"],[80,1,"まも"]],"text":"彼はその父、その母について言った、『わたしは彼らを顧みない』。彼は自分の兄弟をも認めず、自分の子供をも顧みなかった。彼らはあなたの言葉にしたがい、あなたの契約を守ったからである。"},{"ref":"Deut.33.10","start":5033010,"end":5033010,"break":"line","breaks":[[18,"line"],[34,"line"],[46,"line"]],"ruby":[[0,1,"かれ"],[15,1,"おし"],[22,2,"りっぽう"],[31,1,"おし"],[34,2,"くんこう"],[41,1,"まえ"],[43,1,"そな"],[46,2,"はんさい"],[49,2,"さいだん"],[52,1,"うえ"]],"text":"彼らはあなたのおきてをヤコブに教え、あなたの律法をイスラエルに教え、薫香をあなたの前に供え、燔祭を祭壇の上にささげる。"},{"ref":"Deut.33.11","start":5033011,"end":5033011,"break":"line","breaks":[[11,"line"],[28,"line"],[36,"line"],[51,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かれ"],[5,1,"ちから"],[7,2,"しゅくふく"],[11,1,"かれ"],[13,1,"て"],[18,1,"よろこ"],[20,1,"う"],[28,1,"かれ"],[30,1,"さか"],[33,1,"もの"],[36,1,"かれ"],[38,1,"にく"],[40,1,"もの"],[43,1,"こし"],[45,1,"う"],[47,1,"くだ"],[51,1,"た"],[53,1,"あ"]],"text":"主よ、彼の力を祝福し、彼の手のわざを喜び受けてください。彼に逆らう者と、彼を憎む者との腰を打ち砕いて、立ち上がることのできないようにしてください」。"},{"ref":"Deut.33.12","start":5033012,"end":5033012,"break":"line","breaks":[[14,"line"],[23,"line"],[37,"line"],[47,"line"]],"ruby":[[10,1,"い"],[15,1,"しゅ"],[17,1,"あい"],[21,1,"もの"],[23,1,"かれ"],[25,1,"やす"],[29,1,"しゅ"],[37,1,"しゅ"],[39,2,"しゅうじつ"],[42,1,"かれ"],[44,1,"まも"],[49,1,"かた"],[51,1,"あいだ"],[57,1,"いとな"]],"text":"ベニヤミンについては言った、「主に愛される者、彼は安らかに主のそばにおり、主は終日、彼を守り、その肩の間にすまいを営まれるであろう」。"},{"ref":"Deut.33.13","start":5033013,"end":5033013,"break":"line","breaks":[[12,"line"],[31,"line"],[41,"line"]],"ruby":[[8,1,"い"],[16,1,"しゅ"],[18,1,"かれ"],[20,1,"ち"],[22,2,"しゅくふく"],[31,1,"うえ"],[34,1,"てん"],[36,2,"たまもの"],[39,1,"つゆ"],[41,1,"した"],[43,1,"よこ"],[47,1,"ふち"],[49,2,"たまもの"]],"text":"ヨセフについては言った、「どうぞ主が彼の地を祝福されるように。上なる天の賜物と露、下に横たわる淵の賜物、"},{"ref":"Deut.33.14","start":5033014,"end":5033014,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ひ"],[5,1,"さん"],[8,1,"たっと"],[10,2,"たまもの"],[13,1,"つき"],[18,1,"しょう"],[21,1,"たっと"],[23,2,"たまもの"]],"text":"日によって産する尊い賜物、月によって生ずる尊い賜物、"},{"ref":"Deut.33.15","start":5033015,"end":5033015,"break":"line","breaks":[[14,"line"]],"ruby":[[5,2,"やまやま"],[8,1,"さん"],[11,2,"たまもの"],[19,1,"おか"],[21,1,"たっと"],[23,2,"たまもの"]],"text":"いにしえの山々の産する賜物、とこしえの丘の尊い賜物、"},{"ref":"Deut.33.16","start":5033016,"end":5033016,"break":"line","breaks":[[13,"line"],[28,"line"],[37,"line"]],"ruby":[[0,1,"ち"],[5,1,"み"],[8,1,"たっと"],[10,2,"たまもの"],[16,1,"なか"],[22,1,"もの"],[24,1,"めぐ"],[32,1,"あたま"],[34,1,"のぞ"],[39,2,"きょうだい"],[44,1,"くん"],[47,1,"もの"],[49,1,"あたま"],[51,1,"いただき"]],"text":"地とそれに満ちる尊い賜物、しばの中におられた者の恵みが、ヨセフの頭に臨み、その兄弟たちの君たる者の頭の頂にくだるように。"},{"ref":"Deut.33.17","start":5033017,"end":5033017,"break":"line","breaks":[[14,"line"],[26,"line"],[47,"line"],[57,"line"],[76,"line"]],"ruby":[[0,1,"かれ"],[2,1,"うし"],[8,2,"いげん"],[16,1,"つの"],[18,2,"やぎゅう"],[21,1,"つの"],[32,2,"くにぐに"],[35,1,"たみ"],[42,1,"つ"],[44,1,"たお"],[47,1,"ち"],[54,1,"およ"],[62,1,"もの"],[70,1,"いく"],[71,1,"まん"],[83,1,"もの"],[89,1,"いく"],[90,1,"せん"]],"text":"彼の牛のういごは威厳があり、その角は野牛の角のよう、これをもって国々の民をことごとく突き倒し、地のはてにまで及ぶ。このような者はエフライムに幾万とあり、またこのような者はマナセに幾千とある」。"},{"ref":"Deut.33.18","start":5033018,"end":5033018,"break":"line","breaks":[[13,"line"],[35,"line"]],"ruby":[[9,1,"い"],[24,1,"そと"],[26,1,"で"],[28,1,"たの"],[32,1,"え"],[46,2,"てんまく"],[51,1,"たの"],[55,1,"え"]],"text":"ゼブルンについては言った、「ゼブルンよ、あなたは外に出て楽しみを得よ。イッサカルよ、あなたは天幕にいて楽しみを得よ。"},{"ref":"Deut.33.19","start":5033019,"end":5033019,"break":"line","breaks":[[13,"line"],[32,"line"],[42,"line"]],"ruby":[[0,1,"かれ"],[3,2,"くにぐに"],[6,1,"たみ"],[8,1,"やま"],[10,1,"まね"],[15,1,"ところ"],[17,1,"ただ"],[20,2,"ぎせい"],[32,1,"かれ"],[35,1,"うみ"],[37,1,"とみ"],[39,1,"す"],[42,1,"すな"],[44,1,"かく"],[47,1,"たから"],[49,1,"と"]],"text":"彼らは国々の民を山に招き、その所で正しい犠牲をささげるであろう。彼らは海の富を吸い、砂に隠れた宝を取るからである」。"},{"ref":"Deut.33.20","start":5033020,"end":5033020,"break":"line","breaks":[[11,"line"],[30,"line"],[43,"line"]],"ruby":[[7,1,"い"],[15,1,"おお"],[20,1,"もの"],[40,1,"ふ"],[43,1,"うで"],[45,1,"あたま"],[47,1,"いただき"],[51,1,"さ"]],"text":"ガドについては言った、「ガドを大きくする者は、ほむべきかな。ガドは、ししのように伏し、腕や頭の頂をかき裂くであろう。"},{"ref":"Deut.33.21","start":5033021,"end":5033021,"break":"line","breaks":[[17,"line"],[35,"line"],[50,"line"]],"ruby":[[0,1,"かれ"],[2,2,"はつほ"],[5,1,"ち"],[7,2,"じぶん"],[13,1,"えら"],[21,2,"しょうぐん"],[24,1,"ぶん"],[26,1,"と"],[28,1,"お"],[35,1,"かれ"],[37,1,"たみ"],[45,1,"とも"],[56,1,"とも"],[58,1,"しゅ"],[60,2,"せいぎ"],[63,2,"しんぱん"],[67,1,"おこな"]],"text":"彼は初穂の地を自分のために選んだ。そこには将軍の分も取り置かれていた。彼は民のかしらたちと共にきて、イスラエルと共に主の正義と審判とを行った」。"},{"ref":"Deut.33.22","start":5033022,"end":5033022,"break":"line","breaks":[[11,"line"],[24,"line"]],"ruby":[[7,1,"い"],[18,1,"こ"]],"text":"ダンについては言った、「ダンはししの子であって、バシャンからおどりでる」。"},{"ref":"Deut.33.23","start":5033023,"end":5033023,"break":"line","breaks":[[13,"line"],[32,"line"],[41,"line"]],"ruby":[[9,1,"い"],[24,1,"めぐ"],[27,1,"み"],[32,1,"しゅ"],[34,2,"しゅくふく"],[37,1,"み"],[41,1,"みずうみ"],[45,1,"みなみ"],[47,1,"ち"],[49,2,"しょゆう"]],"text":"ナフタリについては言った、「ナフタリよ、あなたは恵みに満たされ、主の祝福に満ちて、湖とその南の地を所有する」。"},{"ref":"Deut.33.24","start":5033024,"end":5033024,"break":"line","breaks":[[12,"line"],[32,"line"],[46,"line"]],"ruby":[[8,1,"い"],[17,1,"た"],[19,1,"こ"],[26,2,"しゅくふく"],[32,1,"かれ"],[36,2,"きょうだい"],[41,1,"あい"],[48,1,"あし"],[50,1,"あぶら"]],"text":"アセルについては言った、「アセルは他の子らにまさって祝福される。彼はその兄弟たちに愛せられ、その足を油にひたすことができるように。"},{"ref":"Deut.33.25","start":5033025,"end":5033025,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"かん"],[6,1,"き"],[8,1,"てつ"],[10,2,"せいどう"],[17,1,"ちから"],[23,1,"とし"],[25,1,"とも"],[27,1,"つづ"]],"text":"あなたの貫の木は鉄と青銅、あなたの力はあなたの年と共に続くであろう」。"},{"ref":"Deut.33.26","start":5033026,"end":5033026,"break":"line","breaks":[[20,"line"],[35,"line"]],"ruby":[[8,1,"かみ"],[10,1,"なら"],[12,1,"もの"],[24,1,"たす"],[30,1,"てん"],[32,1,"の"],[35,2,"いこう"],[41,1,"そら"],[43,1,"とお"]],"text":"「エシュルンよ、神に並ぶ者はほかにない。あなたを助けるために天に乗り、威光をもって空を通られる。"},{"ref":"Deut.33.27","start":5033027,"end":5033027,"break":"line","breaks":[[21,"line"],[32,"line"],[47,"line"]],"ruby":[[8,1,"かみ"],[21,1,"した"],[24,2,"えいえん"],[27,1,"うで"],[32,1,"てき"],[38,1,"まえ"],[41,1,"お"],[43,1,"はら"],[48,1,"ほろ"],[53,1,"い"]],"text":"とこしえにいます神はあなたのすみかであり、下には永遠の腕がある。敵をあなたの前から追い払って、『滅ぼせ』と言われた。"},{"ref":"Deut.33.28","start":5033028,"end":5033028,"break":"line","breaks":[[13,"line"],[30,"line"],[40,"line"]],"ruby":[[6,1,"やす"],[10,1,"す"],[17,1,"いずみ"],[19,2,"こくもつ"],[25,1,"しゅ"],[27,1,"ち"],[42,1,"てん"],[44,1,"つゆ"]],"text":"イスラエルは安らかに住み、ヤコブの泉は穀物とぶどう酒の地に、ひとりいるであろう。また天は露をくだすであろう。"},{"ref":"Deut.33.29","start":5033029,"end":5033029,"break":"line","breaks":[[19,"line"],[30,"line"],[46,"line"],[57,"line"],[68,"line"],[85,"line"]],"ruby":[[30,1,"しゅ"],[32,1,"すく"],[36,1,"たみ"],[46,1,"しゅ"],[52,1,"たす"],[55,1,"たて"],[61,2,"いこう"],[72,1,"てき"],[82,1,"ふく"],[89,1,"かれ"],[92,1,"たか"],[94,1,"ところ"],[96,1,"ふ"],[98,1,"すす"]],"text":"イスラエルよ、あなたはしあわせである。だれがあなたのように、主に救われた民があるであろうか。主はあなたを助ける盾、あなたの威光のつるぎ、あなたの敵はあなたにへつらい服し、あなたは彼らの高き所を踏み進むであろう」。"}]