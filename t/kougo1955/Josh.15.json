[{"ref":"Josh.15.1","start":6015001,"end":6015001,"break":"paragraph","ruby":[[3,2,"ひとびと"],[6,2,"ぶぞく"],[12,2,"かぞく"],[24,1,"え"],[26,1,"ち"],[29,1,"みなみ"],[31,1,"ほう"],[39,1,"さかい"],[41,1,"たっ"],[44,1,"みなみ"],[54,2,"あらの"],[57,1,"およ"]],"text":"ユダの人々の部族が、その家族にしたがって、くじで獲た地は、南の方では、エドムの境に達し、南のはてにあるチンの荒野に及んでいた。"},{"ref":"Josh.15.2","start":6015002,"end":6015002,"break":"none","ruby":[[2,1,"みなみ"],[4,1,"さかい"],[7,1,"しお"],[9,1,"うみ"],[11,1,"みなみ"],[13,1,"はし"],[16,2,"いりうみ"],[20,1,"おこ"]],"text":"その南の境は、塩の海の南の端の、入海から起り、"},{"ref":"Josh.15.3","start":6015003,"end":6015003,"break":"none","ruby":[[6,1,"さか"],[8,1,"みなみ"],[10,1,"で"],[15,1,"すす"],[27,1,"みなみ"],[30,1,"のぼ"],[39,1,"すす"],[46,1,"のぼ"],[57,1,"まわ"]],"text":"アクラビムの坂の南に出てチンに進み、カデシ・バルネアの南から上って、ヘヅロンに進み、アダルに上っていって、カルカに回り、"},{"ref":"Josh.15.4","start":6015004,"end":6015004,"break":"none","ruby":[[5,1,"すす"],[14,1,"かわ"],[16,1,"たっ"],[21,1,"さかい"],[23,1,"うみ"],[25,1,"いた"],[28,1,"つ"],[35,1,"かれ"],[38,1,"みなみ"],[40,1,"さかい"]],"text":"アヅモンに進んで、エジプトの川に達し、その境は海に至って尽きる。これが彼らの南の境である。"},{"ref":"Josh.15.5","start":6015005,"end":6015005,"break":"none","ruby":[[0,1,"ひがし"],[2,1,"さかい"],[4,1,"しお"],[6,1,"うみ"],[17,2,"かわぐち"],[20,1,"たっ"],[24,1,"きた"],[26,1,"ほう"],[28,1,"さかい"],[36,2,"かわぐち"],[40,2,"いりうみ"],[44,1,"おこ"]],"text":"東の境は塩の海であって、ヨルダンの川口に達する。北の方の境は、ヨルダンの川口の、入海から起り、"},{"ref":"Josh.15.6","start":6015006,"end":6015006,"break":"none","ruby":[[0,1,"のぼ"],[9,1,"い"],[18,1,"きた"],[20,1,"す"],[23,1,"のぼ"],[35,1,"いし"],[37,1,"たっ"]],"text":"上ってベテホグラに行き、ベテアラバの北を過ぎ、上ってルベンびとボハンの石に達し、"},{"ref":"Josh.15.7","start":6015007,"end":6015007,"break":"none","ruby":[[6,1,"たに"],[13,1,"のぼ"],[17,1,"きた"],[24,1,"かわ"],[26,1,"みなみ"],[35,1,"さか"],[37,1,"たい"],[45,1,"む"],[49,1,"すす"],[58,1,"みず"],[60,1,"たっ"],[69,1,"いた"],[72,1,"つ"]],"text":"またアコルの谷からデビルに上って、北におもむき、川の南にあるアドミムの坂に対するギルガルに向かって進み、エンシメシの水に達し、エンロゲルに至って尽きる。"},{"ref":"Josh.15.8","start":6015008,"end":6015008,"break":"none","ruby":[[4,1,"さかい"],[13,1,"たに"],[15,1,"そ"],[25,1,"ち"],[37,1,"みなみ"],[42,1,"のぼ"],[50,1,"たに"],[52,1,"にし"],[56,1,"やま"],[58,1,"いただき"],[60,1,"のぼ"],[71,1,"たに"],[73,1,"きた"],[75,1,"はて"]],"text":"またその境はベンヒンノムの谷に沿って、エブスびとの地、すなわちエルサレムの南のわきに上り、ヒンノムの谷の西にある山の頂に上る。これはレパイムの谷の北の果にあるものである。"},{"ref":"Josh.15.9","start":6015009,"end":6015009,"break":"none","ruby":[[2,1,"さかい"],[7,1,"やま"],[9,1,"いただき"],[17,1,"みず"],[19,1,"みなもと"],[21,1,"いた"],[26,1,"ところ"],[33,1,"やま"],[35,2,"まちまち"],[38,1,"およ"],[43,1,"さかい"],[45,1,"まが"],[52,1,"たっ"]],"text":"その境は、この山の頂からネフトアの水の源に至り、その所からエフロン山の町々に及び、その境は曲ってバアラに達する。これは、すなわちキリアテ・ヤリムである。"},{"ref":"Josh.15.10","start":6015010,"end":6015010,"break":"none","ruby":[[2,1,"さかい"],[10,1,"にし"],[12,1,"まわ"],[19,1,"やま"],[21,1,"およ"],[27,1,"やま"],[38,1,"きた"],[43,1,"へ"],[52,1,"くだ"],[59,1,"すす"]],"text":"その境は、バアラから西に回って、セイル山に及び、ヤリム山、すなわちケサロンの北のわきを経て、ベテシメシに下り、テムナに進み、"},{"ref":"Josh.15.11","start":6015011,"end":6015011,"break":"none","ruby":[[5,1,"きた"],[7,1,"おか"],[12,1,"で"],[21,1,"まが"],[27,1,"やま"],[29,1,"すす"],[37,1,"たっ"],[40,1,"うみ"],[42,1,"いた"],[45,1,"つ"]],"text":"エクロンの北の丘のわきに出て、シッケロンに曲り、バアラ山に進み、ヤブネルに達し、海に至って尽きる。"},{"ref":"Josh.15.12","start":6015012,"end":6015012,"break":"none","ruby":[[2,1,"にし"],[4,1,"さかい"],[6,2,"たいかい"],[13,2,"かいがん"],[16,1,"さかい"],[27,2,"ひとびと"],[33,2,"かぞく"],[41,1,"え"],[43,1,"ち"],[45,2,"しほう"],[48,1,"さかい"]],"text":"また西の境は大海であって、海岸を境とした。これがユダの人々の、その家族にしたがって獲た地の四方の境である。"},{"ref":"Josh.15.13","start":6015013,"end":6015013,"break":"paragraph","ruby":[[6,1,"しゅ"],[8,1,"めい"],[22,1,"こ"],[31,2,"ひとびと"],[56,1,"あた"],[62,1,"ぶん"],[76,1,"ちち"]],"text":"ヨシュアは、主に命じられたように、エフンネの子カレブに、ユダの人々のうちで、キリアテ・アルバ、すなわちヘブロンを与えて、その分とさせた。アルバはアナクの父であった。"},{"ref":"Josh.15.14","start":6015014,"end":6015014,"break":"none","ruby":[[6,1,"ところ"],[14,1,"こ"],[16,1,"にん"],[18,1,"お"],[20,1,"はら"],[56,1,"で"]],"text":"カレブはその所から、アナクの子三人を追い払った。すなわち、セシャイ、アヒマン、およびタルマイであって、アナクから出たものである。"},{"ref":"Josh.15.15","start":6015015,"end":6015015,"break":"none","ruby":[[3,1,"かれ"],[7,1,"ところ"],[14,1,"す"],[16,1,"たみ"],[18,1,"ところ"],[20,1,"せ"],[22,1,"のぼ"],[30,1,"な"]],"text":"そして彼はこの所からデビルに住む民の所に攻め上った。デビルの名は、もとはキリアテ・セペルといった。"},{"ref":"Josh.15.16","start":6015016,"end":6015016,"break":"none","ruby":[[4,1,"い"],[18,1,"う"],[25,1,"と"],[27,1,"もの"],[35,1,"むすめ"],[40,1,"つま"],[44,1,"あた"]],"text":"カレブは言った、「キリアテ・セペルを撃って、これを取る者には、わたしの娘アクサを妻として与えるであろう」。"},{"ref":"Josh.15.17","start":6015017,"end":6015017,"break":"none","ruby":[[4,1,"こ"],[11,1,"おとうと"],[21,1,"と"],[31,1,"むすめ"],[37,1,"つま"],[41,1,"かれ"],[43,1,"あた"]],"text":"ケナズの子で、カレブの弟オテニエルがそれを取ったので、カレブは娘アクサを、妻として彼に与えた。"},{"ref":"Josh.15.18","start":6015018,"end":6015018,"break":"none","ruby":[[0,2,"かのじょ"],[6,1,"とき"],[8,1,"はたけ"],[10,1,"ちち"],[12,1,"もと"],[26,1,"すす"],[35,2,"かのじょ"],[43,1,"ふ"],[53,2,"かのじょ"],[57,1,"なに"],[59,1,"のぞ"]],"text":"彼女がとつぐ時、畑を父に求めるようにと、オテニエルに勧められた。そして彼女が、ろばから降りたので、カレブは彼女に、何を望むのかとたずねた。"},{"ref":"Josh.15.19","start":6015019,"end":6015019,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"こた"],[6,1,"い"],[15,1,"おく"],[17,1,"もの"],[32,1,"ち"],[49,1,"いずみ"],[62,2,"かのじょ"],[65,1,"うえ"],[67,1,"いずみ"],[69,1,"した"],[71,1,"いずみ"],[74,1,"あた"]],"text":"彼女は答えて言った、「わたしに贈り物をください。あなたはネゲブの地に、わたしをやられるのですから、泉をもください」。カレブは彼女に上の泉と下の泉とを与えた。"},{"ref":"Josh.15.20","start":6015020,"end":6015020,"break":"paragraph","ruby":[[3,2,"ひとびと"],[6,2,"ぶぞく"],[12,2,"かぞく"],[20,1,"え"],[22,1,"し"],[23,1,"ぎょう"],[26,1,"つぎ"]],"text":"ユダの人々の部族が、その家族にしたがって獲た嗣業は、次のとおりである。"},{"ref":"Josh.15.21","start":6015021,"end":6015021,"break":"none","ruby":[[3,2,"ひとびと"],[6,2,"ぶぞく"],[10,1,"みなみ"],[16,1,"さかい"],[18,1,"ほう"],[25,1,"とお"],[28,2,"まちまち"]],"text":"ユダの人々の部族が、南でエドムの境の方にもっていた遠くの町々は、カブジエル、エデル、ヤグル、"},{"ref":"Josh.15.22","start":6015022,"end":6015022,"break":"none","text":"キナ、デモナ、アダダ、"},{"ref":"Josh.15.23","start":6015023,"end":6015023,"break":"none","text":"ケデシ、ハゾル、イテナン、"},{"ref":"Josh.15.24","start":6015024,"end":6015024,"break":"none","text":"ジフ、テレム、ベアロテ、"},{"ref":"Josh.15.25","start":6015025,"end":6015025,"break":"none","text":"ハゾル・ハダッタ、ケリオテ・ヘヅロンすなわちハゾル、"},{"ref":"Josh.15.26","start":6015026,"end":6015026,"break":"none","text":"アマム、シマ、モラダ、"},{"ref":"Josh.15.27","start":6015027,"end":6015027,"break":"none","text":"ハザルガダ、ヘシモン、ベテペレテ、"},{"ref":"Josh.15.28","start":6015028,"end":6015028,"break":"none","text":"ハザル・シュアル、ベエルシバ、ビジョテヤ、"},{"ref":"Josh.15.29","start":6015029,"end":6015029,"break":"none","text":"バアラ、イイム、エゼム、"},{"ref":"Josh.15.30","start":6015030,"end":6015030,"break":"none","text":"エルトラデ、ケシル、ホルマ、"},{"ref":"Josh.15.31","start":6015031,"end":6015031,"break":"none","text":"チクラグ、マデマンナ、サンサンナ、"},{"ref":"Josh.15.32","start":6015032,"end":6015032,"break":"none","ruby":[[23,1,"まち"],[25,1,"あ"],[40,1,"ぞく"],[43,2,"むらむら"]],"text":"レバオテ、シルヒム、アイン、リンモン。これらの町は合わせて二十九、ならびにそれに属する村々。"},{"ref":"Josh.15.33","start":6015033,"end":6015033,"break":"paragraph","ruby":[[0,2,"へいち"]],"text":"平地では、エシタオル、ゾラ、アシナ、"},{"ref":"Josh.15.34","start":6015034,"end":6015034,"break":"none","text":"ザノア、エンガンニム、タップア、エナム、"},{"ref":"Josh.15.35","start":6015035,"end":6015035,"break":"none","text":"ヤルムテ、アドラム、ソコ、アゼカ、"},{"ref":"Josh.15.36","start":6015036,"end":6015036,"break":"none","ruby":[[31,2,"まちまち"],[38,1,"ぞく"],[41,2,"むらむら"]],"text":"シャアライム、アデタイム、ゲデラ、ゲデロタイム。すなわち十四の町々と、それに属する村々。"},{"ref":"Josh.15.37","start":6015037,"end":6015037,"break":"paragraph","text":"ゼナン、ハダシャ、ミグダルガデ、"},{"ref":"Josh.15.38","start":6015038,"end":6015038,"break":"none","text":"デラン、ミヅパ、ヨクテル、"},{"ref":"Josh.15.39","start":6015039,"end":6015039,"break":"none","text":"ラキシ、ボヅカテ、エグロン、"},{"ref":"Josh.15.40","start":6015040,"end":6015040,"break":"none","text":"カボン、ラマム、キテリシ、"},{"ref":"Josh.15.41","start":6015041,"end":6015041,"break":"none","ruby":[[27,2,"まちまち"],[34,1,"ぞく"],[37,2,"むらむら"]],"text":"ゲデロテ、ベテダゴン、ナアマ、マッケダ。すなわち十六の町々と、それに属する村々。"},{"ref":"Josh.15.42","start":6015042,"end":6015042,"break":"paragraph","text":"またリブナ、エテル、アシャン、"},{"ref":"Josh.15.43","start":6015043,"end":6015043,"break":"none","text":"イフタ、アシナ、ネジブ、"},{"ref":"Josh.15.44","start":6015044,"end":6015044,"break":"none","ruby":[[21,2,"まちまち"],[28,1,"ぞく"],[31,2,"むらむら"]],"text":"ケイラ、アクジブ、マレシャ。すなわち九つの町々と、それに属する村々。"},{"ref":"Josh.15.45","start":6015045,"end":6015045,"break":"paragraph","ruby":[[8,2,"まちまち"],[14,2,"むらむら"]],"text":"エクロンと、その町々、および村々。"},{"ref":"Josh.15.46","start":6015046,"end":6015046,"break":"none","ruby":[[6,1,"うみ"],[24,2,"まちまち"],[33,1,"ぞく"],[36,2,"むらむら"]],"text":"エクロンから海まで、すべてアシドドのほとりにある町々、およびそれに属する村々。"},{"ref":"Josh.15.47","start":6015047,"end":6015047,"break":"paragraph","ruby":[[7,2,"まちまち"],[12,2,"むらむら"],[20,2,"まちまち"],[25,2,"むらむら"],[33,1,"かわ"],[35,2,"たいかい"],[38,2,"かいがん"],[46,1,"さかい"]],"text":"アシドドとその町々および村々。ガザとその町々および村々。エジプトの川と大海の海岸までが、その境であった。"},{"ref":"Josh.15.48","start":6015048,"end":6015048,"break":"paragraph","ruby":[[0,2,"さんち"]],"text":"山地では、シャミル、ヤッテル、ソコ、"},{"ref":"Josh.15.49","start":6015049,"end":6015049,"break":"none","text":"ダンナ、キリアテ・サンナすなわちデビル、"},{"ref":"Josh.15.50","start":6015050,"end":6015050,"break":"none","text":"アナブ、エシテモ、アニム、"},{"ref":"Josh.15.51","start":6015051,"end":6015051,"break":"none","ruby":[[18,2,"まちまち"],[25,1,"ぞく"],[28,2,"むらむら"]],"text":"ゴセン、ホロン、ギロ。すなわち十一の町々と、それに属する村々。"},{"ref":"Josh.15.52","start":6015052,"end":6015052,"break":"paragraph","text":"アラブ、ドマ、エシャン、"},{"ref":"Josh.15.53","start":6015053,"end":6015053,"break":"none","text":"ヤニム、ベテタップア、アペカ、"},{"ref":"Josh.15.54","start":6015054,"end":6015054,"break":"none","ruby":[[32,2,"まちまち"],[39,1,"ぞく"],[42,2,"むらむら"]],"text":"ホムタ、キリアテ・アルバすなわちヘブロン、ヂオル。すなわち九つの町々と、それに属する村々。"},{"ref":"Josh.15.55","start":6015055,"end":6015055,"break":"paragraph","text":"マオン、カルメル、ジフ、ユッタ、"},{"ref":"Josh.15.56","start":6015056,"end":6015056,"break":"none","text":"エズレル、ヨクデアム、ザノア、"},{"ref":"Josh.15.57","start":6015057,"end":6015057,"break":"none","ruby":[[18,2,"まちまち"],[25,1,"ぞく"],[28,2,"むらむら"]],"text":"カイン、ギベア、テムナ。すなわち十の町々と、それに属する村々。"},{"ref":"Josh.15.58","start":6015058,"end":6015058,"break":"paragraph","text":"ハルホル、ベテズル、ゲドル、"},{"ref":"Josh.15.59","start":6015059,"end":6015059,"break":"none","ruby":[[24,2,"まちまち"],[31,1,"ぞく"],[34,2,"むらむら"]],"text":"マアラテ、ベテアノテ、エルテコン。すなわち六つの町々と、それに属する村々。"},{"ref":"Josh.15.60","start":6015060,"end":6015060,"break":"paragraph","ruby":[[31,1,"まち"],[36,1,"ぞく"],[39,2,"むらむら"]],"text":"キリアテ・バアルすなわちキリアテ・ヤリム、ラバ。これらの二つの町とそれに属する村々。"},{"ref":"Josh.15.61","start":6015061,"end":6015061,"break":"paragraph","ruby":[[0,2,"あらの"]],"text":"荒野では、ベテアラバ、ミデン、セカカ、"},{"ref":"Josh.15.62","start":6015062,"end":6015062,"break":"none","ruby":[[6,1,"しお"],[8,1,"まち"],[22,2,"まちまち"],[29,1,"ぞく"],[32,2,"むらむら"]],"text":"ニブシャン、塩の町、エンゲデ。すなわち六つの町々と、それに属する村々。"},{"ref":"Josh.15.63","start":6015063,"end":6015063,"break":"paragraph","ruby":[[7,2,"ひとびと"],[17,2,"じゅうみん"],[25,1,"お"],[27,1,"はら"],[48,2,"こんにち"],[56,2,"ひとびと"],[59,1,"とも"],[67,1,"す"]],"text":"しかし、ユダの人々は、エルサレムの住民エブスびとを追い払うことができなかった。それでエブスびとは今日まで、ユダの人々と共にエルサレムに住んでいる。"}]