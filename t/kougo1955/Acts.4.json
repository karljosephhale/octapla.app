[{"ref":"Acts.4.1","start":44004001,"end":44004001,"break":"paragraph","ruby":[[0,1,"かれ"],[3,2,"ひとびと"],[11,1,"かた"],[21,2,"さいし"],[26,2,"みやもり"],[36,1,"びと"],[40,2,"ちかよ"]],"text":"彼らが人々にこのように語っているあいだに、祭司たち、宮守がしら、サドカイ人たちが近寄ってきて、"},{"ref":"Acts.4.2","start":44004002,"end":44004002,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ひとびと"],[6,1,"おしえ"],[8,1,"と"],[14,2,"じしん"],[17,1,"おこ"],[20,2,"しにん"],[23,2,"ふっかつ"],[26,2,"せんでん"],[34,1,"き"],[38,1,"た"]],"text":"彼らが人々に教を説き、イエス自身に起った死人の復活を宣伝しているのに気をいら立て、"},{"ref":"Acts.4.3","start":44004003,"end":44004003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"て"],[8,1,"とら"],[13,1,"ひ"],[15,1,"く"],[23,1,"よく"],[24,1,"あさ"],[27,2,"りゅうち"]],"text":"彼らに手をかけて捕え、はや日が暮れていたので、翌朝まで留置しておいた。"},{"ref":"Acts.4.4","start":44004004,"end":44004004,"break":"none","ruby":[[4,1,"かれ"],[7,1,"はなし"],[9,1,"き"],[12,1,"おお"],[15,1,"ひと"],[19,1,"しん"],[29,1,"おとこ"],[31,1,"かず"],[35,1,"にん"]],"text":"しかし、彼らの話を聞いた多くの人たちは信じた。そして、その男の数が五千人ほどになった。"},{"ref":"Acts.4.5","start":44004005,"end":44004005,"break":"paragraph","ruby":[[0,1,"あ"],[3,1,"ひ"],[5,2,"やくにん"],[8,2,"ちょうろう"],[11,2,"りっぽう"],[13,2,"がくしゃ"],[25,2,"しょうしゅう"]],"text":"明くる日、役人、長老、律法学者たちが、エルサレムに召集された。"},{"ref":"Acts.4.6","start":44004006,"end":44004006,"break":"none","ruby":[[0,3,"だいさいし"],[32,3,"だいさいし"],[36,2,"いちぞく"],[41,1,"あつ"]],"text":"大祭司アンナスをはじめ、カヤパ、ヨハネ、アレキサンデル、そのほか大祭司の一族もみな集まった。"},{"ref":"Acts.4.7","start":44004007,"end":44004007,"break":"none","ruby":[[8,1,"なか"],[10,2,"しと"],[15,1,"た"],[19,2,"じんもん"],[40,2,"けんい"],[49,1,"な"]],"text":"そして、そのまん中に使徒たちを立たせて尋問した、「あなたがたは、いったい、なんの権威、また、だれの名によって、このことをしたのか」。"},{"ref":"Acts.4.8","start":44004008,"end":44004008,"break":"none","ruby":[[2,1,"とき"],[8,2,"せいれい"],[11,1,"み"],[16,1,"い"],[21,1,"たみ"],[23,2,"やくにん"],[32,2,"ちょうろう"]],"text":"その時、ペテロが聖霊に満たされて言った、「民の役人たち、ならびに長老たちよ、"},{"ref":"Acts.4.9","start":44004009,"end":44004009,"break":"none","ruby":[[11,2,"とりしら"],[15,1,"う"],[23,2,"びょうにん"],[26,1,"たい"],[31,1,"よ"],[45,1,"ひと"]],"text":"わたしたちが、きょう、取調べを受けているのは、病人に対してした良いわざについてであり、この人がどうしていやされたかについてであるなら、"},{"ref":"Acts.4.10","start":44004010,"end":44004010,"break":"none","ruby":[[6,2,"いちどう"],[18,2,"ひとびと"],[20,2,"ぜんたい"],[24,1,"し"],[37,1,"ひと"],[39,2,"げんき"],[49,1,"まえ"],[51,1,"た"],[70,3,"じゅうじか"],[77,1,"ころ"],[83,1,"かみ"],[85,2,"しにん"],[88,1,"なか"],[101,1,"びと"],[111,2,"みな"]],"text":"あなたがたご一同も、またイスラエルの人々全体も、知っていてもらいたい。この人が元気になってみんなの前に立っているのは、ひとえに、あなたがたが十字架につけて殺したのを、神が死人の中からよみがえらせたナザレ人イエス・キリストの御名によるのである。"},{"ref":"Acts.4.11","start":44004011,"end":44004011,"break":"none","ruby":[[14,1,"いえ"],[15,1,"つく"],[19,1,"す"],[26,1,"すみ"],[31,1,"いし"],[36,1,"いし"]],"text":"このイエスこそは『あなたがた家造りらに捨てられたが、隅のかしら石となった石』なのである。"},{"ref":"Acts.4.12","start":44004012,"end":44004012,"break":"none","ruby":[[2,1,"ひと"],[6,2,"いがい"],[9,1,"すくい"],[20,1,"すく"],[24,1,"な"],[30,1,"べつ"],[36,2,"てんか"],[43,1,"あた"]],"text":"この人による以外に救はない。わたしたちを救いうる名は、これを別にしては、天下のだれにも与えられていないからである」。"},{"ref":"Acts.4.13","start":44004013,"end":44004013,"break":"paragraph","ruby":[[0,2,"ひとびと"],[12,2,"だいたん"],[15,1,"はな"],[20,1,"み"],[24,2,"どうじ"],[32,2,"むがく"],[39,1,"ひと"],[48,1,"し"],[52,3,"ふしぎ"],[56,1,"おも"],[63,1,"かれ"],[70,1,"とも"],[74,1,"もの"],[81,1,"みと"]],"text":"人々はペテロとヨハネとの大胆な話しぶりを見、また同時に、ふたりが無学な、ただの人たちであることを知って、不思議に思った。そして彼らがイエスと共にいた者であることを認め、"},{"ref":"Acts.4.14","start":44004014,"end":44004014,"break":"none","ruby":[[3,1,"かれ"],[11,1,"もの"],[18,1,"た"],[25,1,"み"],[33,1,"かえ"],[35,2,"ことば"]],"text":"かつ、彼らにいやされた者がそのそばに立っているのを見ては、まったく返す言葉がなかった。"},{"ref":"Acts.4.15","start":44004015,"end":44004015,"break":"none","ruby":[[8,2,"ぎかい"],[12,2,"たいじょう"],[19,1,"めい"],[25,1,"たがい"],[27,2,"きょうぎ"]],"text":"そこで、ふたりに議会から退場するように命じてから、互に協議をつづけて"},{"ref":"Acts.4.16","start":44004016,"end":44004016,"break":"none","ruby":[[0,1,"い"],[7,1,"ひと"],[23,1,"かれ"],[29,1,"いちじる"],[36,1,"おこな"],[50,2,"じゅうみん"],[52,2,"ぜんたい"],[55,1,"し"],[66,2,"ひてい"]],"text":"言った、「あの人たちを、どうしたらよかろうか。彼らによって著しいしるしが行われたことは、エルサレムの住民全体に知れわたっているので、否定しようもない。"},{"ref":"Acts.4.17","start":44004017,"end":44004017,"break":"none","ruby":[[5,2,"いじょう"],[12,2,"みんしゅう"],[15,1,"あいだ"],[27,2,"こんご"],[32,1,"な"],[46,1,"かた"]],"text":"ただ、これ以上このことが民衆の間にひろまらないように、今後はこの名によって、いっさいだれにも語ってはいけないと、おどしてやろうではないか」。"},{"ref":"Acts.4.18","start":44004018,"end":44004018,"break":"none","ruby":[[8,1,"よ"],[10,1,"い"],[18,1,"な"],[23,1,"かた"],[28,1,"と"],[38,2,"あいな"],[43,1,"い"]],"text":"そこで、ふたりを呼び入れて、イエスの名によって語ることも説くことも、いっさい相成らぬと言いわたした。"},{"ref":"Acts.4.19","start":44004019,"end":44004019,"break":"none","ruby":[[13,1,"たい"],[16,1,"い"],[21,1,"かみ"],[23,1,"き"],[25,1,"したが"],[37,1,"き"],[39,1,"したが"],[41,1,"ほう"],[44,1,"かみ"],[46,1,"まえ"],[48,1,"ただ"],[56,2,"はんだん"]],"text":"ペテロとヨハネとは、これに対して言った、「神に聞き従うよりも、あなたがたに聞き従う方が、神の前に正しいかどうか、判断してもらいたい。"},{"ref":"Acts.4.20","start":44004020,"end":44004020,"break":"none","ruby":[[10,2,"じぶん"],[13,1,"み"],[17,1,"き"],[24,1,"かた"]],"text":"わたしたちとしては、自分の見たこと聞いたことを、語らないわけにはいかない」。"},{"ref":"Acts.4.21","start":44004021,"end":44004021,"break":"none","ruby":[[4,1,"かれ"],[11,1,"さら"],[32,1,"もの"],[37,3,"できごと"],[45,1,"かみ"],[58,2,"ひとびと"],[61,2,"てまえ"],[68,1,"ばっ"]],"text":"そこで、彼らはふたりを更におどしたうえ、ゆるしてやった。みんなの者が、この出来事のために、神をあがめていたので、その人々の手前、ふたりを罰するすべがなかったからである。"},{"ref":"Acts.4.22","start":44004022,"end":44004022,"break":"none","ruby":[[19,1,"さい"],[24,1,"ひと"]],"text":"そのしるしによっていやされたのは、四十歳あまりの人であった。"},{"ref":"Acts.4.23","start":44004023,"end":44004023,"break":"paragraph","ruby":[[12,2,"なかま"],[15,1,"もの"],[23,1,"かえ"],[27,3,"さいしちょう"],[33,2,"ちょうろう"],[38,1,"い"],[49,2,"ほうこく"]],"text":"ふたりはゆるされてから、仲間の者たちのところに帰って、祭司長たちや長老たちが言ったいっさいのことを報告した。"},{"ref":"Acts.4.24","start":44004024,"end":44004024,"break":"none","ruby":[[0,2,"いちどう"],[6,1,"き"],[10,1,"くち"],[17,1,"かみ"],[22,1,"こえ"],[27,1,"い"],[32,1,"てん"],[34,1,"ち"],[36,1,"うみ"],[41,1,"なか"],[51,1,"つく"],[57,1,"しゅ"]],"text":"一同はこれを聞くと、口をそろえて、神にむかい声をあげて言った、「天と地と海と、その中のすべてのものとの造りぬしなる主よ。"},{"ref":"Acts.4.25","start":44004025,"end":44004025,"break":"none","breaks":[[48,"stanza"],[63,"line"]],"ruby":[[11,2,"せんぞ"],[18,1,"しもべ"],[23,1,"くち"],[30,2,"せいれい"],[39,1,"おお"],[52,3,"いほうじん"],[58,1,"さわ"],[60,1,"た"],[68,1,"たみ"],[78,1,"はか"]],"text":"あなたは、わたしたちの先祖、あなたの僕ダビデの口をとおして、聖霊によって、こう仰せになりました、『なぜ、異邦人らは、騒ぎ立ち、もろもろの民は、むなしいことを図り、"},{"ref":"Acts.4.26","start":44004026,"end":44004026,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[0,2,"ちじょう"],[3,1,"おう"],[8,1,"た"],[14,3,"しはいしゃ"],[21,1,"とう"],[23,1,"く"],[27,1,"しゅ"],[37,1,"さか"]],"text":"地上の王たちは、立ちかまえ、支配者たちは、党を組んで、主とそのキリストとに逆らったのか』。"},{"ref":"Acts.4.27","start":44004027,"end":44004027,"break":"none","ruby":[[20,3,"いほうじん"],[31,1,"たみ"],[33,2,"いっしょ"],[42,1,"みやこ"],[44,1,"あつ"],[53,1,"あぶら"],[55,1,"そそ"],[59,1,"せい"],[62,1,"しもべ"],[67,1,"さか"]],"text":"まことに、ヘロデとポンテオ・ピラトとは、異邦人らやイスラエルの民と一緒になって、この都に集まり、あなたから油を注がれた聖なる僕イエスに逆らい、"},{"ref":"Acts.4.28","start":44004028,"end":44004028,"break":"none","ruby":[[1,1,"て"],[4,1,"むね"],[16,1,"さだ"],[29,1,"と"]],"text":"み手とみ旨とによって、あらかじめ定められていたことを、なし遂げたのです。"},{"ref":"Acts.4.29","start":44004029,"end":44004029,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"かれ"],[9,2,"きょうはく"],[12,1,"め"],[17,1,"しもべ"],[22,1,"おも"],[24,1,"き"],[27,2,"だいたん"],[30,3,"みことば"],[34,1,"かた"],[38,1,"くだ"]],"text":"主よ、いま、彼らの脅迫に目をとめ、僕たちに、思い切って大胆に御言葉を語らせて下さい。"},{"ref":"Acts.4.30","start":44004030,"end":44004030,"break":"none","ruby":[[4,1,"て"],[6,1,"の"],[17,1,"せい"],[20,1,"しもべ"],[25,1,"な"],[35,2,"きせき"],[39,1,"おこな"],[43,1,"くだ"]],"text":"そしてみ手を伸ばしていやしをなし、聖なる僕イエスの名によって、しるしと奇跡とを行わせて下さい」。"},{"ref":"Acts.4.31","start":44004031,"end":44004031,"break":"none","ruby":[[0,1,"かれ"],[3,1,"いの"],[5,1,"お"],[12,1,"あつ"],[18,2,"ばしょ"],[21,1,"ゆ"],[23,1,"うご"],[26,2,"いちどう"],[29,2,"せいれい"],[32,1,"み"],[38,2,"だいたん"],[41,1,"かみ"],[43,1,"ことば"],[45,1,"かた"],[47,1,"だ"]],"text":"彼らが祈り終えると、その集まっていた場所が揺れ動き、一同は聖霊に満たされて、大胆に神の言を語り出した。"},{"ref":"Acts.4.32","start":44004032,"end":44004032,"break":"paragraph","ruby":[[0,1,"しん"],[3,1,"もの"],[5,1,"む"],[9,1,"こころ"],[15,1,"おも"],[31,1,"も"],[33,1,"もの"],[35,2,"じぶん"],[42,2,"しゅちょう"],[46,1,"もの"],[56,1,"もの"],[58,2,"きょうゆう"]],"text":"信じた者の群れは、心を一つにし思いを一つにして、だれひとりその持ち物を自分のものだと主張する者がなく、いっさいの物を共有にしていた。"},{"ref":"Acts.4.33","start":44004033,"end":44004033,"break":"none","ruby":[[0,2,"しと"],[5,1,"しゅ"],[10,2,"ふっかつ"],[17,2,"ひじょう"],[20,2,"ちからづよ"],[33,1,"おお"],[41,1,"かれ"],[43,2,"いちどう"],[46,1,"そそ"]],"text":"使徒たちは主イエスの復活について、非常に力強くあかしをした。そして大きなめぐみが、彼ら一同に注がれた。"},{"ref":"Acts.4.34","start":44004034,"end":44004034,"break":"none","ruby":[[0,1,"かれ"],[3,1,"なか"],[5,1,"とぼ"],[8,1,"もの"],[21,2,"じしょ"],[24,2,"かおく"],[27,1,"も"],[32,1,"ひと"],[40,1,"う"],[43,1,"う"],[46,1,"もの"],[48,2,"だいきん"]],"text":"彼らの中に乏しい者は、ひとりもいなかった。地所や家屋を持っている人たちは、それを売り、売った物の代金をもってきて、"},{"ref":"Acts.4.35","start":44004035,"end":44004035,"break":"none","ruby":[[0,2,"しと"],[5,1,"あし"],[9,1,"お"],[21,2,"ひつよう"],[24,1,"おう"],[33,1,"わ"],[35,1,"あた"]],"text":"使徒たちの足もとに置いた。そしてそれぞれの必要に応じて、だれにでも分け与えられた。"},{"ref":"Acts.4.36","start":44004036,"end":44004036,"break":"paragraph","ruby":[[3,1,"うま"],[8,1,"びと"],[11,2,"しと"],[22,1,"なぐさ"],[25,1,"こ"],[29,1,"い"],[32,1,"よ"]],"text":"クプロ生れのレビ人で、使徒たちにバルナバ（「慰めの子」との意）と呼ばれていたヨセフは、"},{"ref":"Acts.4.37","start":44004037,"end":44004037,"break":"none","ruby":[[0,2,"じぶん"],[3,2,"しょゆう"],[7,1,"はたけ"],[9,1,"う"],[14,2,"だいきん"],[23,2,"しと"],[28,1,"あし"],[32,1,"お"]],"text":"自分の所有する畑を売り、その代金をもってきて、使徒たちの足もとに置いた。"}]