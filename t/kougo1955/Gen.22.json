[{"ref":"Gen.22.1","start":1022001,"end":1022001,"break":"paragraph","ruby":[[4,1,"こと"],[6,1,"のち"],[8,1,"かみ"],[16,1,"こころ"],[19,1,"かれ"],[21,1,"い"],[35,1,"かれ"],[37,1,"い"]],"text":"これらの事の後、神はアブラハムを試みて彼に言われた、「アブラハムよ」。彼は言った、「ここにおります」。"},{"ref":"Gen.22.2","start":1022002,"end":1022002,"break":"none","ruby":[[0,1,"かみ"],[2,1,"い"],[12,1,"こ"],[18,1,"あい"],[24,1,"こ"],[29,1,"つ"],[36,1,"ち"],[38,1,"い"],[45,1,"しめ"],[47,1,"やま"],[49,1,"かれ"],[51,2,"はんさい"]],"text":"神は言われた、「あなたの子、あなたの愛するひとり子イサクを連れてモリヤの地に行き、わたしが示す山で彼を燔祭としてささげなさい」。"},{"ref":"Gen.22.3","start":1022003,"end":1022003,"break":"none","ruby":[[6,1,"あさ"],[10,1,"お"],[20,1,"お"],[27,2,"わかもの"],[33,1,"こ"],[39,1,"つ"],[44,2,"はんさい"],[51,1,"わ"],[54,1,"た"],[57,1,"かみ"],[59,1,"しめ"],[63,1,"ところ"],[65,1,"で"]],"text":"アブラハムは朝はやく起きて、ろばにくらを置き、ふたりの若者と、その子イサクとを連れ、また燔祭のたきぎを割り、立って神が示された所に出かけた。"},{"ref":"Gen.22.4","start":1022004,"end":1022004,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[11,1,"め"],[23,2,"ばしょ"],[26,1,"み"]],"text":"三日目に、アブラハムは目をあげて、はるかにその場所を見た。"},{"ref":"Gen.22.5","start":1022005,"end":1022005,"break":"none","ruby":[[9,2,"わかもの"],[14,1,"い"],[29,2,"いっしょ"],[48,1,"む"],[52,1,"い"],[55,2,"れいはい"],[70,1,"ところ"],[72,1,"かえ"]],"text":"そこでアブラハムは若者たちに言った、「あなたがたは、ろばと一緒にここにいなさい。わたしとわらべは向こうへ行って礼拝し、そののち、あなたがたの所に帰ってきます」。"},{"ref":"Gen.22.6","start":1022006,"end":1022006,"break":"none","ruby":[[6,2,"はんさい"],[13,1,"と"],[19,1,"こ"],[24,1,"お"],[28,1,"て"],[30,1,"ひ"],[32,2,"はもの"],[36,1,"と"],[43,2,"いっしょ"],[46,1,"い"]],"text":"アブラハムは燔祭のたきぎを取って、その子イサクに負わせ、手に火と刃物とを執って、ふたり一緒に行った。"},{"ref":"Gen.22.7","start":1022007,"end":1022007,"break":"none","ruby":[[7,1,"ちち"],[14,1,"い"],[19,1,"ちち"],[23,1,"かれ"],[25,1,"こた"],[30,1,"こ"],[49,1,"い"],[54,1,"ひ"],[67,2,"はんさい"],[70,2,"こひつじ"]],"text":"やがてイサクは父アブラハムに言った、「父よ」。彼は答えた、「子よ、わたしはここにいます」。イサクは言った、「火とたきぎとはありますが、燔祭の小羊はどこにありますか」。"},{"ref":"Gen.22.8","start":1022008,"end":1022008,"break":"none","ruby":[[6,1,"い"],[11,1,"こ"],[14,1,"かみ"],[19,2,"はんさい"],[22,2,"こひつじ"],[25,1,"そな"],[46,2,"いっしょ"],[49,1,"い"]],"text":"アブラハムは言った、「子よ、神みずから燔祭の小羊を備えてくださるであろう」。こうしてふたりは一緒に行った。"},{"ref":"Gen.22.9","start":1022009,"end":1022009,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,1,"しめ"],[9,2,"ばしょ"],[26,2,"さいだん"],[29,1,"きず"],[36,1,"なら"],[41,1,"こ"],[46,1,"しば"],[49,2,"さいだん"],[56,1,"うえ"],[58,1,"の"]],"text":"彼らが神の示された場所にきたとき、アブラハムはそこに祭壇を築き、たきぎを並べ、その子イサクを縛って祭壇のたきぎの上に載せた。"},{"ref":"Gen.22.10","start":1022010,"end":1022010,"break":"none","ruby":[[9,1,"て"],[11,1,"さ"],[13,1,"の"],[16,2,"はもの"],[19,1,"と"],[24,1,"こ"],[26,1,"ころ"],[32,1,"とき"]],"text":"そしてアブラハムが手を差し伸べ、刃物を執ってその子を殺そうとした時、"},{"ref":"Gen.22.11","start":1022011,"end":1022011,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,1,"てん"],[7,1,"かれ"],[9,1,"よ"],[12,1,"い"],[32,1,"かれ"],[34,1,"こた"]],"text":"主の使が天から彼を呼んで言った、「アブラハムよ、アブラハムよ」。彼は答えた、「はい、ここにおります」。"},{"ref":"Gen.22.12","start":1022012,"end":1022012,"break":"none","ruby":[[1,1,"つかい"],[3,1,"い"],[12,1,"て"],[25,1,"なに"],[27,1,"かれ"],[41,1,"こ"],[50,1,"こ"],[62,1,"お"],[74,1,"かみ"],[76,1,"おそ"],[79,1,"もの"],[90,1,"いま"],[91,1,"し"]],"text":"み使が言った、「わらべを手にかけてはならない。また何も彼にしてはならない。あなたの子、あなたのひとり子をさえ、わたしのために惜しまないので、あなたが神を恐れる者であることをわたしは今知った」。"},{"ref":"Gen.22.13","start":1022013,"end":1022013,"break":"none","ruby":[[2,1,"とき"],[9,1,"め"],[14,1,"み"],[23,1,"つの"],[28,1,"か"],[34,1,"とう"],[36,2,"おひつじ"],[48,1,"い"],[53,2,"おひつじ"],[56,1,"とら"],[64,1,"こ"],[70,2,"はんさい"]],"text":"この時アブラハムが目をあげて見ると、うしろに、角をやぶに掛けている一頭の雄羊がいた。アブラハムは行ってその雄羊を捕え、それをその子のかわりに燔祭としてささげた。"},{"ref":"Gen.22.14","start":1022014,"end":1022014,"break":"none","ruby":[[11,1,"ところ"],[13,1,"な"],[23,1,"よ"],[33,2,"ひとびと"],[36,2,"こんにち"],[42,1,"しゅ"],[44,1,"やま"],[46,1,"そな"],[52,1,"い"]],"text":"それでアブラハムはその所の名をアドナイ・エレと呼んだ。これにより、人々は今日もなお「主の山に備えあり」と言う。"},{"ref":"Gen.22.15","start":1022015,"end":1022015,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,1,"ふたた"],[6,1,"てん"],[15,1,"よ"]],"text":"主の使は再び天からアブラハムを呼んで、"},{"ref":"Gen.22.16","start":1022016,"end":1022016,"break":"none","ruby":[[0,1,"い"],[5,1,"しゅ"],[7,1,"い"],[17,2,"じぶん"],[23,1,"ちか"],[32,1,"こと"],[40,1,"こ"],[49,1,"こ"],[52,1,"お"]],"text":"言った、「主は言われた、『わたしは自分をさして誓う。あなたがこの事をし、あなたの子、あなたのひとり子をも惜しまなかったので、"},{"ref":"Gen.22.17","start":1022017,"end":1022017,"break":"none","ruby":[[4,1,"おお"],[11,2,"しゅくふく"],[15,1,"おお"],[22,2,"しそん"],[30,1,"てん"],[32,1,"ほし"],[38,1,"はま"],[41,1,"すな"],[53,2,"しそん"],[56,1,"てき"],[58,1,"もん"],[60,1,"う"],[62,1,"と"]],"text":"わたしは大いにあなたを祝福し、大いにあなたの子孫をふやして、天の星のように、浜べの砂のようにする。あなたの子孫は敵の門を打ち取り、"},{"ref":"Gen.22.18","start":1022018,"end":1022018,"break":"none","ruby":[[2,1,"ち"],[9,2,"こくみん"],[16,2,"しそん"],[22,2,"しゅくふく"],[25,1,"え"],[40,2,"ことば"],[43,1,"したが"]],"text":"また地のもろもろの国民はあなたの子孫によって祝福を得るであろう。あなたがわたしの言葉に従ったからである』」。"},{"ref":"Gen.22.19","start":1022019,"end":1022019,"break":"none","ruby":[[6,2,"わかもの"],[11,1,"ところ"],[13,1,"かえ"],[18,1,"た"],[22,1,"とも"],[30,1,"い"],[49,1,"す"]],"text":"アブラハムは若者たちの所に帰り、みな立って、共にベエルシバへ行った。そしてアブラハムはベエルシバに住んだ。"},{"ref":"Gen.22.20","start":1022020,"end":1022020,"break":"paragraph","ruby":[[4,1,"こと"],[6,1,"のち"],[10,1,"ひと"],[18,1,"つ"],[21,1,"い"],[36,2,"きょうだい"],[42,1,"こ"],[46,1,"う"]],"text":"これらの事の後、ある人がアブラハムに告げて言った、「ミルカもまたあなたの兄弟ナホルに子どもを産みました。"},{"ref":"Gen.22.21","start":1022021,"end":1022021,"break":"none","ruby":[[0,2,"ちょうなん"],[6,1,"おとうと"],[11,1,"つぎ"],[17,1,"ちち"]],"text":"長男はウヅ、弟はブズ、次はアラムの父ケムエル、"},{"ref":"Gen.22.22","start":1022022,"end":1022022,"break":"none","ruby":[[0,1,"つぎ"]],"text":"次はケセデ、ハゾ、ピルダシ、エデラフ、ベトエルです」。"},{"ref":"Gen.22.23","start":1022023,"end":1022023,"break":"none","ruby":[[5,1,"こ"],[19,1,"にん"],[31,2,"きょうだい"],[37,1,"う"]],"text":"ベトエルの子はリベカであって、これら八人はミルカがアブラハムの兄弟ナホルに産んだのである。"},{"ref":"Gen.22.24","start":1022024,"end":1022024,"break":"none","ruby":[[9,1,"な"],[16,1,"おんな"],[37,1,"う"]],"text":"ナホルのそばめで、名をルマという女もまたテバ、ガハム、タハシおよびマアカを産んだ。"}]