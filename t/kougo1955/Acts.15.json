[{"ref":"Acts.15.1","start":44015001,"end":44015001,"break":"paragraph","ruby":[[5,1,"ひと"],[14,1,"くだ"],[20,2,"きょうだい"],[37,2,"かんれい"],[45,2,"かつれい"],[48,1,"う"],[55,1,"すく"],[63,1,"と"]],"text":"さて、ある人たちがユダヤから下ってきて、兄弟たちに「あなたがたも、モーセの慣例にしたがって割礼を受けなければ、救われない」と、説いていた。"},{"ref":"Acts.15.2","start":44015002,"end":44015002,"break":"none","ruby":[[13,1,"かれ"],[17,1,"あいだ"],[20,1,"すく"],[25,2,"ふんきゅう"],[28,2,"そうろん"],[32,1,"しょう"],[50,2,"すうにん"],[53,1,"もの"],[61,1,"のぼ"],[64,2,"しと"],[69,2,"ちょうろう"],[77,2,"もんだい"],[83,2,"きょうぎ"]],"text":"そこで、パウロやバルナバと彼らとの間に、少なからぬ紛糾と争論とが生じたので、パウロ、バルナバそのほか数人の者がエルサレムに上り、使徒たちや長老たちと、この問題について協議することになった。"},{"ref":"Acts.15.3","start":44015003,"end":44015003,"break":"none","ruby":[[0,1,"かれ"],[3,2,"きょうかい"],[6,2,"ひとびと"],[9,2,"みおく"],[28,1,"みち"],[33,3,"いほうじん"],[39,2,"かいしゅう"],[42,2,"もよう"],[49,2,"せつめい"],[57,2,"きょうだい"],[62,1,"おお"],[65,1,"よろこ"]],"text":"彼らは教会の人々に見送られ、ピニケ、サマリヤをとおって、道すがら、異邦人たちの改宗の模様をくわしく説明し、すべての兄弟たちを大いに喜ばせた。"},{"ref":"Acts.15.4","start":44015004,"end":44015004,"break":"none","ruby":[[6,1,"つ"],[10,1,"かれ"],[13,2,"きょうかい"],[16,2,"しと"],[21,2,"ちょうろう"],[26,1,"むか"],[32,1,"かみ"],[34,1,"かれ"],[37,1,"とも"],[54,2,"ほうこく"]],"text":"エルサレムに着くと、彼らは教会と使徒たち、長老たちに迎えられて、神が彼らと共にいてなされたことを、ことごとく報告した。"},{"ref":"Acts.15.5","start":44015005,"end":44015005,"break":"none","ruby":[[9,1,"は"],[12,2,"しんこう"],[21,1,"ひと"],[25,1,"た"],[30,3,"いほうじん"],[35,2,"かつれい"],[38,1,"ほどこ"],[47,2,"りっぽう"],[50,1,"まも"],[61,2,"しゅちょう"]],"text":"ところが、パリサイ派から信仰にはいってきた人たちが立って、「異邦人にも割礼を施し、またモーセの律法を守らせるべきである」と主張した。"},{"ref":"Acts.15.6","start":44015006,"end":44015006,"break":"paragraph","ruby":[[4,2,"しと"],[9,2,"ちょうろう"],[17,2,"もんだい"],[23,2,"しんぎ"],[30,1,"あつ"]],"text":"そこで、使徒たちや長老たちが、この問題について審議するために集まった。"},{"ref":"Acts.15.7","start":44015007,"end":44015007,"break":"none","ruby":[[0,1,"はげ"],[3,2,"そうろん"],[9,1,"のち"],[15,1,"た"],[18,1,"い"],[23,2,"きょうだい"],[30,2,"しょうち"],[37,3,"いほうじん"],[45,1,"くち"],[48,2,"ふくいん"],[51,2,"ことば"],[54,1,"き"],[57,1,"しん"],[65,1,"かみ"],[67,1,"はじ"],[74,2,"しょくん"],[77,1,"なか"],[85,1,"えら"]],"text":"激しい争論があった後、ペテロが立って言った、「兄弟たちよ、ご承知のとおり、異邦人がわたしの口から福音の言葉を聞いて信じるようにと、神は初めのころに、諸君の中からわたしをお選びになったのである。"},{"ref":"Acts.15.8","start":44015008,"end":44015008,"break":"none","ruby":[[4,1,"ひと"],[6,1,"こころ"],[9,1,"ぞん"],[14,1,"かみ"],[17,2,"せいれい"],[25,1,"たま"],[30,2,"どうよう"],[33,1,"かれ"],[37,1,"たま"],[42,1,"かれ"],[45,1,"たい"]],"text":"そして、人の心をご存じである神は、聖霊をわれわれに賜わったと同様に彼らにも賜わって、彼らに対してあかしをなし、"},{"ref":"Acts.15.9","start":44015009,"end":44015009,"break":"none","ruby":[[5,2,"しんこう"],[11,1,"かれ"],[14,1,"こころ"],[25,1,"かれ"],[29,1,"あいだ"],[35,1,"わ"]],"text":"また、その信仰によって彼らの心をきよめ、われわれと彼らとの間に、なんの分けへだてもなさらなかった。"},{"ref":"Acts.15.10","start":44015010,"end":44015010,"break":"none","ruby":[[5,2,"しょくん"],[11,1,"いま"],[17,2,"せんぞ"],[24,2,"じしん"],[28,1,"お"],[42,2,"でし"],[47,1,"くび"],[53,1,"かみ"],[55,1,"こころ"]],"text":"しかるに、諸君はなぜ、今われわれの先祖もわれわれ自身も、負いきれなかったくびきをあの弟子たちの首にかけて、神を試みるのか。"},{"ref":"Acts.15.11","start":44015011,"end":44015011,"break":"none","ruby":[[0,1,"たし"],[4,1,"しゅ"],[22,1,"すく"],[29,1,"しん"],[34,1,"かれ"],[39,2,"どうよう"]],"text":"確かに、主イエスのめぐみによって、われわれは救われるのだと信じるが、彼らとても同様である」。"},{"ref":"Acts.15.12","start":44015012,"end":44015012,"break":"paragraph","ruby":[[4,1,"ぜん"],[5,2,"かいしゅう"],[8,1,"だま"],[32,1,"かれ"],[39,3,"いほうじん"],[43,1,"あいだ"],[45,1,"かみ"],[47,1,"おこな"],[51,2,"かずかず"],[58,2,"きせき"],[65,2,"せつめい"],[71,1,"き"]],"text":"すると、全会衆は黙ってしまった。それから、バルナバとパウロとが、彼らをとおして異邦人の間に神が行われた数々のしるしと奇跡のことを、説明するのを聞いた。"},{"ref":"Acts.15.13","start":44015013,"end":44015013,"break":"none","ruby":[[4,1,"かた"],[6,1,"お"],[9,1,"のち"],[18,1,"おう"],[21,1,"の"],[26,2,"きょうだい"],[36,2,"いけん"],[39,1,"き"]],"text":"ふたりが語り終えた後、ヤコブはそれに応じて述べた、「兄弟たちよ、わたしの意見を聞いていただきたい。"},{"ref":"Acts.15.14","start":44015014,"end":44015014,"break":"none","ruby":[[0,1,"かみ"],[2,1,"はじ"],[5,3,"いほうじん"],[11,1,"かえり"],[17,1,"なか"],[20,2,"みな"],[23,1,"お"],[25,1,"たみ"],[27,1,"えら"],[29,1,"だ"],[33,2,"しだい"],[45,2,"せつめい"]],"text":"神が初めに異邦人たちを顧みて、その中から御名を負う民を選び出された次第は、シメオンがすでに説明した。"},{"ref":"Acts.15.15","start":44015015,"end":44015015,"break":"none","ruby":[[0,3,"よげんしゃ"],[6,2,"ことば"],[13,2,"いっち"],[27,1,"か"]],"text":"預言者たちの言葉も、それと一致している。すなわち、こう書いてある、"},{"ref":"Acts.15.16","start":44015016,"end":44015016,"break":"stanza","breaks":[[15,"line"],[30,"line"],[41,"line"]],"ruby":[[3,1,"のち"],[9,1,"かえ"],[15,1,"たお"],[22,2,"まくや"],[25,1,"た"],[34,2,"かしょ"],[37,2,"しゅうり"],[44,1,"た"],[46,1,"なお"]],"text":"『その後、わたしは帰ってきて、倒れたダビデの幕屋を建てかえ、くずれた箇所を修理し、それを立て直そう。"},{"ref":"Acts.15.17","start":44015017,"end":44015017,"break":"line","breaks":[[9,"line"],[29,"line"]],"ruby":[[0,1,"のこ"],[5,2,"ひとびと"],[13,1,"な"],[15,1,"とな"],[24,3,"いほうじん"],[29,1,"しゅ"],[31,1,"たず"],[33,1,"もと"]],"text":"残っている人々も、わたしの名を唱えているすべての異邦人も、主を尋ね求めるようになるためである。"},{"ref":"Acts.15.18","start":44015018,"end":44015018,"break":"line","ruby":[[0,1,"よ"],[2,1,"はじ"],[10,1,"こと"],[12,1,"し"],[20,1,"しゅ"],[25,1,"おお"]],"text":"世の初めからこれらの事を知らせておられる主が、こう仰せになった』。"},{"ref":"Acts.15.19","start":44015019,"end":44015019,"break":"none","ruby":[[8,2,"いけん"],[13,3,"いほうじん"],[17,1,"なか"],[20,1,"かみ"],[22,2,"きえ"],[28,1,"ひと"]],"text":"そこで、わたしの意見では、異邦人の中から神に帰依している人たちに、わずらいをかけてはいけない。"},{"ref":"Acts.15.20","start":44015020,"end":44015020,"break":"none","ruby":[[3,2,"ぐうぞう"],[6,1,"そな"],[9,1,"けが"],[12,1,"もの"],[15,3,"ふひんこう"],[20,1,"し"],[22,1,"ころ"],[29,1,"ち"],[33,1,"さ"],[41,1,"かれ"],[44,1,"か"],[46,1,"おく"]],"text":"ただ、偶像に供えて汚れた物と、不品行と、絞め殺したものと、血とを、避けるようにと、彼らに書き送ることにしたい。"},{"ref":"Acts.15.21","start":44015021,"end":44015021,"break":"none","ruby":[[0,1,"ふる"],[2,2,"じだい"],[9,1,"まち"],[16,2,"りっぽう"],[19,1,"の"],[21,1,"つた"],[24,1,"もの"],[29,3,"あんそくにち"],[38,1,"しょ"],[39,2,"かいどう"],[42,2,"ろうどく"]],"text":"古い時代から、どの町にもモーセの律法を宣べ伝える者がいて、安息日ごとにそれを諸会堂で朗読するならわしであるから」。"},{"ref":"Acts.15.22","start":44015022,"end":44015022,"break":"paragraph","ruby":[[4,2,"しと"],[9,2,"ちょうろう"],[15,1,"ぜん"],[16,2,"きょうかい"],[19,2,"きょうぎ"],[23,1,"すえ"],[26,1,"たがい"],[28,1,"なか"],[31,2,"ひとびと"],[34,1,"えら"],[47,1,"とも"],[56,2,"はけん"],[63,1,"き"],[67,1,"えら"],[98,2,"きょうだい"],[103,1,"あいだ"],[105,1,"おも"],[113,1,"ひと"]],"text":"そこで、使徒たちや長老たちは、全教会と協議した末、お互の中から人々を選んで、パウロやバルナバと共に、アンテオケに派遣することに決めた。選ばれたのは、バルサバというユダとシラスとであったが、いずれも兄弟たちの間で重んじられていた人たちであった。"},{"ref":"Acts.15.23","start":44015023,"end":44015023,"break":"none","breaks":[[19,"paragraph"]],"ruby":[[2,1,"ひと"],[6,1,"たく"],[10,2,"しょめん"],[26,2,"きょうだい"],[31,2,"しと"],[36,2,"ちょうろう"],[60,3,"いほうじん"],[64,2,"きょうだい"],[75,1,"おく"]],"text":"この人たちに託された書面はこうである。「あなたがたの兄弟である使徒および長老たちから、アンテオケ、シリヤ、キリキヤにいる異邦人の兄弟がたに、あいさつを送る。"},{"ref":"Acts.15.24","start":44015024,"end":44015024,"break":"none","ruby":[[5,1,"い"],[10,1,"もの"],[23,2,"しじ"],[39,1,"い"],[49,1,"さわ"],[59,1,"こころ"],[61,1,"みだ"],[65,1,"つた"],[67,1,"き"]],"text":"こちらから行ったある者たちが、わたしたちからの指示もないのに、いろいろなことを言って、あなたがたを騒がせ、あなたがたの心を乱したと伝え聞いた。"},{"ref":"Acts.15.25","start":44015025,"end":44015025,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"えら"],[17,1,"あい"],[31,1,"とも"],[43,2,"はけん"],[51,2,"しゅうぎ"],[53,2,"いっけつ"]],"text":"そこで、わたしたちは人々を選んで、愛するバルナバおよびパウロと共に、あなたがたのもとに派遣することに、衆議一決した。"},{"ref":"Acts.15.26","start":44015026,"end":44015026,"break":"none","ruby":[[11,1,"しゅ"],[21,1,"な"],[29,1,"いのち"],[31,1,"な"],[33,1,"だ"],[36,2,"ひとびと"]],"text":"このふたりは、われらの主イエス・キリストの名のために、その命を投げ出した人々であるが、"},{"ref":"Acts.15.27","start":44015027,"end":44015027,"break":"none","ruby":[[0,1,"かれ"],[3,1,"とも"],[14,2,"はけん"],[18,2,"しだい"],[26,1,"ひと"],[38,1,"おな"],[40,2,"しゅし"],[47,2,"こうとう"],[51,1,"つた"]],"text":"彼らと共に、ユダとシラスとを派遣する次第である。この人たちは、あなたがたに、同じ趣旨のことを、口頭でも伝えるであろう。"},{"ref":"Acts.15.28","start":44015028,"end":44015028,"break":"none","ruby":[[5,2,"せいれい"],[16,1,"つぎ"],[18,2,"ひつよう"],[20,2,"じこう"],[30,2,"ふたん"],[41,1,"お"],[49,1,"き"]],"text":"すなわち、聖霊とわたしたちとは、次の必要事項のほかは、どんな負担をも、あなたがたに負わせないことに決めた。"},{"ref":"Acts.15.29","start":44015029,"end":44015029,"break":"none","ruby":[[4,2,"ぐうぞう"],[7,1,"そな"],[14,1,"ち"],[17,1,"し"],[19,1,"ころ"],[26,3,"ふひんこう"],[32,1,"さ"],[52,1,"とお"],[69,2,"いじょう"]],"text":"それは、偶像に供えたものと、血と、絞め殺したものと、不品行とを、避けるということである。これらのものから遠ざかっておれば、それでよろしい。以上」。"},{"ref":"Acts.15.30","start":44015030,"end":44015030,"break":"paragraph","ruby":[[3,2,"いっこう"],[6,2,"ひとびと"],[9,2,"みおく"],[21,1,"くだ"],[24,1,"い"],[27,2,"かいしゅう"],[30,1,"あつ"],[36,2,"しょめん"],[39,2,"てわた"]],"text":"さて、一行は人々に見送られて、アンテオケに下って行き、会衆を集めて、その書面を手渡した。"},{"ref":"Acts.15.31","start":44015031,"end":44015031,"break":"none","ruby":[[0,2,"ひとびと"],[6,1,"よ"],[12,1,"すす"],[15,2,"ことば"]],"text":"人々はそれを読んで、その勧めの言葉をよろこんだ。"},{"ref":"Acts.15.32","start":44015032,"end":44015032,"break":"none","ruby":[[8,1,"とも"],[10,3,"よげんしゃ"],[20,1,"おお"],[23,2,"ことば"],[29,2,"きょうだい"],[34,1,"はげ"],[40,1,"ちから"]],"text":"ユダとシラスとは共に預言者であったので、多くの言葉をもって兄弟たちを励まし、また力づけた。"},{"ref":"Acts.15.33","start":44015033,"end":44015033,"break":"none","ruby":[[10,1,"とき"],[16,1,"す"],[20,1,"のち"],[22,2,"きょうだい"],[29,1,"たび"],[31,2,"へいあん"],[34,1,"いの"],[39,2,"みおく"],[43,1,"う"],[46,2,"じぶん"],[50,2,"はけん"],[54,2,"ひとびと"],[61,1,"かえ"],[64,1,"い"]],"text":"ふたりは、しばらくの時を、そこで過ごした後、兄弟たちから、旅の平安を祈られて、見送りを受け、自分らを派遣した人々のところに帰って行った。〔"},{"ref":"Acts.15.34","start":44015034,"end":44015034,"break":"none","ruby":[[11,1,"ひ"]],"text":"しかし、シラスだけは、引きつづきとどまることにした。〕"},{"ref":"Acts.15.35","start":44015035,"end":44015035,"break":"none","ruby":[[16,2,"たいざい"],[27,1,"おお"],[30,1,"ひと"],[34,1,"とも"],[37,1,"しゅ"],[39,2,"ことば"],[42,1,"おし"],[46,1,"の"],[48,1,"つた"]],"text":"パウロとバルナバとはアンテオケに滞在をつづけて、ほかの多くの人たちと共に、主の言葉を教えかつ宣べ伝えた。"},{"ref":"Acts.15.36","start":44015036,"end":44015036,"break":"paragraph","ruby":[[0,2,"いくにち"],[4,1,"のち"],[15,1,"い"],[23,1,"まえ"],[25,1,"しゅ"],[27,2,"ことば"],[30,1,"つた"],[37,2,"まちまち"],[42,2,"きょうだい"],[50,2,"ほうもん"],[67,1,"み"]],"text":"幾日かの後、パウロはバルナバに言った、「さあ、前に主の言葉を伝えたすべての町々にいる兄弟たちを、また訪問して、みんながどうしているかを見てこようではないか」。"},{"ref":"Acts.15.37","start":44015037,"end":44015037,"break":"none","ruby":[[19,2,"いっしょ"],[22,1,"つ"],[25,1,"い"]],"text":"そこで、バルナバはマルコというヨハネも一緒に連れて行くつもりでいた。"},{"ref":"Acts.15.38","start":44015038,"end":44015038,"break":"none","ruby":[[9,1,"まえ"],[17,2,"いっこう"],[21,1,"はな"],[25,1,"はたら"],[28,1,"とも"],[38,1,"もの"],[41,1,"つ"],[44,1,"い"],[52,1,"かんが"]],"text":"しかし、パウロは、前にパンフリヤで一行から離れて、働きを共にしなかったような者は、連れて行かないがよいと考えた。"},{"ref":"Acts.15.39","start":44015039,"end":44015039,"break":"none","ruby":[[4,2,"げきろん"],[7,1,"おこ"],[12,2,"けっか"],[18,1,"たがい"],[20,1,"わか"],[22,1,"わか"],[37,1,"つ"],[44,1,"わた"],[47,1,"い"]],"text":"こうして激論が起り、その結果ふたりは互に別れ別れになり、バルナバはマルコを連れてクプロに渡って行き、"},{"ref":"Acts.15.40","start":44015040,"end":44015040,"break":"none","ruby":[[8,1,"えら"],[11,2,"きょうだい"],[17,1,"しゅ"],[19,1,"めぐ"],[29,1,"で"],[30,1,"はっ"]],"text":"パウロはシラスを選び、兄弟たちから主の恵みにゆだねられて、出発した。"},{"ref":"Acts.15.41","start":44015041,"end":44015041,"break":"none","ruby":[[17,2,"ちほう"],[25,1,"しょ"],[26,2,"きょうかい"],[29,1,"ちから"]],"text":"そしてパウロは、シリヤ、キリキヤの地方をとおって、諸教会を力づけた。"}]