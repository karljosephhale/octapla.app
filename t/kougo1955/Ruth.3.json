[{"ref":"Ruth.3.1","start":8003001,"end":8003001,"break":"paragraph","ruby":[[0,1,"とき"],[11,2,"かのじょ"],[14,1,"い"],[19,1,"むすめ"],[30,1,"お"],[32,1,"つ"],[34,1,"どころ"],[36,1,"もと"]],"text":"時にしゅうとめナオミは彼女に言った、「娘よ、わたしはあなたの落ち着き所を求めて、あなたをしあわせにすべきではないでしょうか。"},{"ref":"Ruth.3.2","start":8003002,"end":8003002,"break":"none","ruby":[[4,2,"いっしょ"],[7,1,"はたら"],[10,1,"おんな"],[14,2,"しゅじん"],[26,2,"しんせき"],[37,1,"かれ"],[39,2,"こんや"],[42,1,"う"],[44,1,"ば"],[46,2,"おおむぎ"],[52,1,"わ"]],"text":"あなたが一緒に働いた女たちの主人ボアズはわたしたちの親戚ではありませんか。彼は今夜、打ち場で大麦をあおぎ分けます。"},{"ref":"Ruth.3.3","start":8003003,"end":8003003,"break":"none","ruby":[[7,1,"み"],[9,1,"あら"],[12,1,"あぶら"],[17,1,"は"],[19,1,"ぎ"],[25,1,"う"],[27,1,"ば"],[29,1,"くだ"],[32,1,"い"],[47,1,"ひと"],[49,1,"の"],[51,1,"く"],[54,1,"おわ"],[61,1,"ひと"],[63,1,"し"]],"text":"それであなたは身を洗って油をぬり、晴れ着をまとって打ち場に下って行きなさい。ただ、あなたはその人が飲み食いを終るまで、その人に知られてはなりません。"},{"ref":"Ruth.3.4","start":8003004,"end":8003004,"break":"none","ruby":[[5,1,"ひと"],[7,1,"ね"],[9,1,"とき"],[13,1,"ね"],[15,2,"ばしょ"],[18,2,"みさだ"],[26,1,"い"],[32,1,"あし"],[34,1,"ところ"],[44,1,"ね"],[49,1,"かれ"],[61,1,"し"]],"text":"そしてその人が寝る時、その寝る場所を見定め、はいって行って、その足の所をまくって、そこに寝なさい。彼はあなたのすべきことを知らせるでしょう」。"},{"ref":"Ruth.3.5","start":8003005,"end":8003005,"break":"none","ruby":[[9,1,"い"],[26,1,"みな"]],"text":"ルツはしゅうとめに言った、「あなたのおっしゃることを皆いたしましょう」。"},{"ref":"Ruth.3.6","start":8003006,"end":8003006,"break":"paragraph","ruby":[[4,2,"かのじょ"],[7,1,"う"],[9,1,"ば"],[11,1,"くだ"],[23,1,"めい"]],"text":"こうして彼女は打ち場に下り、すべてしゅうとめが命じたとおりにした。"},{"ref":"Ruth.3.7","start":8003007,"end":8003007,"break":"none","ruby":[[4,1,"の"],[6,1,"く"],[11,1,"こころ"],[23,1,"むぎ"],[25,1,"つ"],[30,2,"ばしょ"],[38,1,"い"],[41,1,"ね"],[47,2,"かのじょ"],[54,1,"い"],[61,1,"あし"],[63,1,"ところ"],[73,1,"ね"]],"text":"ボアズは飲み食いして、心をたのしませたあとで、麦を積んである場所のかたわらへ行って寝た。そこで彼女はひそかに行き、ボアズの足の所をまくって、そこに寝た。"},{"ref":"Ruth.3.8","start":8003008,"end":8003008,"break":"none","ruby":[[0,2,"よなか"],[9,1,"ひと"],[11,1,"おどろ"],[14,1,"お"],[20,1,"み"],[28,1,"おんな"],[30,1,"あし"],[36,1,"ね"]],"text":"夜中になって、その人は驚き、起きかえって見ると、ひとりの女が足のところに寝ていたので、"},{"ref":"Ruth.3.9","start":8003009,"end":8003009,"break":"none","ruby":[[12,1,"い"],[16,2,"かのじょ"],[19,1,"こた"],[67,1,"もっと"],[69,1,"ちか"],[71,2,"しんせき"]],"text":"「あなたはだれですか」と言うと、彼女は答えた、「わたしはあなたのはしためルツです。あなたのすそで、はしためをおおってください。あなたは最も近い親戚です」。"},{"ref":"Ruth.3.10","start":8003010,"end":8003010,"break":"none","ruby":[[4,1,"い"],[9,1,"むすめ"],[16,1,"しゅ"],[22,2,"しゅくふく"],[35,2,"ひんぷ"],[43,1,"わか"],[45,1,"ひと"],[47,1,"したが"],[49,1,"ゆ"],[61,2,"さいご"],[64,1,"しめ"],[69,2,"しんせつ"],[76,1,"しめ"],[79,2,"しんせつ"]],"text":"ボアズは言った、「娘よ、どうぞ、主があなたを祝福されるように。あなたは貧富にかかわらず若い人に従い行くことはせず、あなたが最後に示したこの親切は、さきに示した親切にまさっています。"},{"ref":"Ruth.3.11","start":8003011,"end":8003011,"break":"none","ruby":[[4,1,"むすめ"],[11,1,"おそ"],[26,1,"もと"],[32,1,"みな"],[53,1,"まち"],[55,2,"ひとびと"],[58,1,"みな"],[68,1,"おんな"],[75,1,"し"]],"text":"それで、娘よ、あなたは恐れるにおよびません。あなたが求めることは皆、あなたのためにいたしましょう。わたしの町の人々は皆、あなたがりっぱな女であることを知っているからです。"},{"ref":"Ruth.3.12","start":8003012,"end":8003012,"break":"none","ruby":[[8,1,"ちか"],[10,2,"しんせき"],[30,1,"ちか"],[32,2,"しんせき"]],"text":"たしかにわたしは近い親戚ではありますが、わたしよりも、もっと近い親戚があります。"},{"ref":"Ruth.3.13","start":8003013,"end":8003013,"break":"none","ruby":[[0,2,"こんや"],[14,1,"あさ"],[24,1,"ひと"],[34,2,"しんせき"],[37,2,"ぎむ"],[54,1,"ひと"],[65,1,"しゅ"],[67,1,"い"],[78,1,"ひと"],[88,2,"しんせき"],[91,2,"ぎむ"],[100,1,"この"],[119,2,"しんせき"],[122,2,"ぎむ"],[133,1,"あさ"]],"text":"今夜はここにとどまりなさい。朝になって、もしその人が、あなたのために親戚の義務をつくすならば、よろしい、その人にさせなさい。しかし主は生きておられます。その人が、あなたのために親戚の義務をつくすことを好まないならば、わたしはあなたのために親戚の義務をつくしましょう。朝までここにおやすみなさい」。"},{"ref":"Ruth.3.14","start":8003014,"end":8003014,"break":"paragraph","ruby":[[3,1,"あさ"],[6,1,"かれ"],[8,1,"あし"],[14,1,"ね"],[23,2,"みわ"],[26,1,"がた"],[31,1,"お"],[48,1,"おんな"],[50,1,"う"],[52,1,"ば"],[59,1,"ひと"],[61,1,"し"],[72,1,"い"]],"text":"ルツは朝まで彼の足のところに寝たが、だれかれの見分け難いころに起きあがった。それはボアズが「この女の打ち場にきたことが人に知られてはならない」と言ったからである。"},{"ref":"Ruth.3.15","start":8003015,"end":8003015,"break":"none","ruby":[[7,1,"い"],[16,1,"き"],[18,2,"がいとう"],[21,1,"も"],[30,1,"ひろ"],[37,2,"かのじょ"],[43,1,"ひろ"],[52,2,"おおむぎ"],[63,2,"かのじょ"],[66,1,"お"],[71,2,"かのじょ"],[74,1,"まち"],[76,1,"かえ"]],"text":"そしてボアズは言った、「あなたの着る外套を持ってきて、それを広げなさい」。彼女がそれを広げると、ボアズは大麦六オメルをはかって彼女に負わせた。彼女は町に帰り、"},{"ref":"Ruth.3.16","start":8003016,"end":8003016,"break":"none","ruby":[[10,1,"い"],[20,1,"い"],[25,1,"むすめ"],[44,1,"ひと"],[46,2,"かのじょ"],[59,1,"つ"]],"text":"しゅうとめのところへ行くと、しゅうとめは言った、「娘よ、どうでしたか」。そこでルツはその人が彼女にしたことをことごとく告げて、"},{"ref":"Ruth.3.17","start":8003017,"end":8003017,"break":"none","ruby":[[0,1,"い"],[14,1,"む"],[21,1,"て"],[34,1,"かえ"],[43,1,"い"],[49,2,"おおむぎ"]],"text":"言った、「あのかたはわたしに向かって、から手で、しゅうとめのところへ帰ってはならないと言って、この大麦六オメルをわたしにくださいました」。"},{"ref":"Ruth.3.18","start":8003018,"end":8003018,"break":"none","ruby":[[6,1,"い"],[11,1,"むすめ"],[16,1,"こと"],[29,1,"ま"],[37,1,"ひと"],[46,1,"こと"],[48,2,"けってい"],[55,1,"お"],[57,1,"つ"]],"text":"しゅうとめは言った、「娘よ、この事がどうなるかわかるまでお待ちなさい。あの人は、きょう、その事を決定しなければ落ち着かないでしょう」。"}]