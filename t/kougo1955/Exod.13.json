[{"ref":"Exod.13.1","start":2013001,"end":2013001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Exod.13.2","start":2013002,"end":2013002,"break":"none","ruby":[[7,2,"ひとびと"],[29,1,"はじ"],[32,1,"たい"],[34,1,"ひら"],[41,1,"ひと"],[46,1,"けもの"],[61,2,"せいべつ"]],"text":"「イスラエルの人々のうちで、すべてのういご、すなわちすべて初めに胎を開いたものを、人であれ、獣であれ、みな、わたしのために聖別しなければならない。それはわたしのものである」。"},{"ref":"Exod.13.3","start":2013003,"end":2013003,"break":"paragraph","ruby":[[4,1,"たみ"],[6,1,"い"],[25,2,"どれい"],[28,1,"いえ"],[31,1,"で"],[35,1,"ひ"],[37,1,"おぼ"],[43,1,"しゅ"],[45,1,"つよ"],[47,1,"て"],[63,1,"みちび"],[65,1,"だ"],[75,1,"たね"],[77,1,"い"],[83,1,"た"]],"text":"モーセは民に言った、「あなたがたは、エジプトから、奴隷の家から出るこの日を覚えなさい。主が強い手をもって、あなたがたをここから導き出されるからである。種を入れたパンを食べてはならない。"},{"ref":"Exod.13.4","start":2013004,"end":2013004,"break":"none","ruby":[[10,1,"つき"],[14,1,"ひ"],[16,1,"で"]],"text":"あなたがたはアビブの月のこの日に出るのである。"},{"ref":"Exod.13.5","start":2013005,"end":2013005,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"あた"],[15,2,"せんぞ"],[20,1,"ちか"],[52,1,"ち"],[54,1,"ちち"],[56,1,"みつ"],[59,1,"なが"],[62,1,"ち"],[65,1,"みちび"],[67,1,"い"],[72,1,"とき"],[80,1,"つき"],[84,2,"ぎしき"],[87,1,"まも"]],"text":"主があなたに与えると、あなたの先祖たちに誓われたカナンびと、ヘテびと、アモリびと、ヒビびと、エブスびとの地、乳と蜜との流れる地に、導き入れられる時、あなたはこの月にこの儀式を守らなければならない。"},{"ref":"Exod.13.6","start":2013006,"end":2013006,"break":"none","ruby":[[0,2,"なぬか"],[6,1,"たね"],[7,1,"い"],[13,1,"た"],[16,2,"なぬか"],[18,1,"め"],[21,1,"しゅ"],[23,1,"まつり"]],"text":"七日のあいだ種入れぬパンを食べ、七日目には主に祭をしなければならない。"},{"ref":"Exod.13.7","start":2013007,"end":2013007,"break":"none","ruby":[[0,1,"たね"],[1,1,"い"],[7,2,"なぬか"],[13,1,"た"],[24,1,"たね"],[26,1,"い"],[36,1,"ところ"],[38,1,"お"],[54,2,"ちく"],[66,1,"ところ"],[70,1,"だね"],[72,1,"お"]],"text":"種入れぬパンを七日のあいだ食べなければならない。種を入れたパンをあなたの所に置いてはならない。また、あなたの地区のどこでも、あなたの所にパン種を置いてはならない。"},{"ref":"Exod.13.8","start":2013008,"end":2013008,"break":"none","ruby":[[2,1,"ひ"],[8,1,"こ"],[10,1,"つ"],[13,1,"い"],[33,1,"で"],[39,1,"しゅ"]],"text":"その日、あなたの子に告げて言いなさい、『これはわたしがエジプトから出るときに、主がわたしになされたことのためである』。"},{"ref":"Exod.13.9","start":2013009,"end":2013009,"break":"none","ruby":[[8,1,"て"],[20,1,"め"],[22,1,"あいだ"],[24,1,"お"],[27,2,"きねん"],[32,1,"しゅ"],[34,2,"りっぽう"],[41,1,"くち"],[43,1,"お"],[54,1,"しゅ"],[56,1,"つよ"],[58,1,"て"],[74,1,"みちび"],[76,1,"だ"]],"text":"そして、これを、手につけて、しるしとし、目の間に置いて記念とし、主の律法をあなたの口に置かなければならない。主が強い手をもって、あなたをエジプトから導き出されるからである。"},{"ref":"Exod.13.10","start":2013010,"end":2013010,"break":"none","ruby":[[11,1,"さだ"],[14,2,"ねんねん"],[18,2,"きせつ"],[21,1,"まも"]],"text":"それゆえ、あなたはこの定めを年々その期節に守らなければならない。"},{"ref":"Exod.13.11","start":2013011,"end":2013011,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,2,"せんぞ"],[15,1,"ちか"],[33,1,"ち"],[35,1,"みちび"],[46,1,"たま"],[49,1,"とき"]],"text":"主があなたとあなたの先祖たちに誓われたように、あなたをカナンびとの地に導いて、それをあなたに賜わる時、"},{"ref":"Exod.13.12","start":2013012,"end":2013012,"break":"none","ruby":[[8,1,"はじ"],[11,1,"たい"],[13,1,"ひら"],[16,1,"もの"],[25,2,"かちく"],[28,1,"う"],[40,1,"しゅ"],[63,2,"だんせい"],[69,1,"しゅ"],[71,1,"き"]],"text":"あなたは、すべて初めに胎を開いた者、およびあなたの家畜の産むういごは、ことごとく主にささげなければならない。すなわち、それらの男性のものは主に帰せしめなければならない。"},{"ref":"Exod.13.13","start":2013013,"end":2013013,"break":"none","ruby":[[11,1,"はじ"],[14,1,"たい"],[16,1,"ひら"],[23,2,"こひつじ"],[58,1,"くび"],[60,1,"お"],[75,1,"こ"],[85,1,"おとこ"]],"text":"また、すべて、ろばの、初めて胎を開いたものは、小羊をもって、あがなわなければならない。もし、あがなわないならば、その首を折らなければならない。あなたの子らのうち、すべて、男のういごは、あがなわなければならない。"},{"ref":"Exod.13.14","start":2013014,"end":2013014,"break":"none","ruby":[[0,1,"のち"],[10,1,"こ"],[19,2,"いみ"],[26,1,"と"],[35,1,"い"],[47,1,"しゅ"],[49,1,"つよ"],[51,1,"て"],[69,2,"どれい"],[72,1,"いえ"],[75,1,"みちび"],[77,1,"だ"]],"text":"後になって、あなたの子が『これはどんな意味ですか』と問うならば、これに言わなければならない、『主が強い手をもって、われわれをエジプトから、奴隷の家から導き出された。"},{"ref":"Exod.13.15","start":2013015,"end":2013015,"break":"none","ruby":[[19,1,"さ"],[29,1,"しゅ"],[36,1,"くに"],[43,1,"ひと"],[49,2,"かちく"],[62,1,"ころ"],[72,1,"はじ"],[75,1,"たい"],[77,1,"ひら"],[79,2,"だんせい"],[88,1,"しゅ"],[90,2,"ぎせい"],[105,2,"こども"]],"text":"そのときパロが、かたくなで、われわれを去らせなかったため、主はエジプトの国のういごを、人のういごも家畜のういごも、ことごとく殺された。それゆえ、初めて胎を開く男性のものはみな、主に犠牲としてささげるが、わたしの子供のうちのういごは、すべてあがなうのである』。"},{"ref":"Exod.13.16","start":2013016,"end":2013016,"break":"none","ruby":[[7,1,"て"],[19,1,"め"],[21,1,"あいだ"],[23,1,"お"],[26,1,"おぼ"],[39,1,"しゅ"],[41,1,"つよ"],[43,1,"て"],[60,1,"みちび"],[62,1,"だ"]],"text":"そして、これを手につけて、しるしとし、目の間に置いて覚えとしなければならない。主が強い手をもって、われわれをエジプトから導き出されたからである」。"},{"ref":"Exod.13.17","start":2013017,"end":2013017,"break":"paragraph","ruby":[[6,1,"たみ"],[8,1,"さ"],[12,1,"とき"],[21,1,"くに"],[23,1,"みち"],[25,1,"ちか"],[31,1,"かみ"],[33,1,"かれ"],[39,1,"みちび"],[47,1,"たみ"],[49,1,"たたか"],[52,1,"み"],[55,1,"く"],[63,1,"かえ"],[71,1,"かみ"],[73,1,"おも"]],"text":"さて、パロが民を去らせた時、ペリシテびとの国の道は近かったが、神は彼らをそれに導かれなかった。民が戦いを見れば悔いてエジプトに帰るであろうと、神は思われたからである。"},{"ref":"Exod.13.18","start":2013018,"end":2013018,"break":"none","ruby":[[0,1,"かみ"],[2,2,"こうかい"],[5,1,"そ"],[7,2,"あらの"],[10,1,"みち"],[13,1,"たみ"],[15,1,"まわ"],[27,2,"ひとびと"],[30,2,"ぶそう"],[39,1,"くに"],[41,1,"で"],[44,1,"のぼ"]],"text":"神は紅海に沿う荒野の道に、民を回らされた。イスラエルの人々は武装してエジプトの国を出て、上った。"},{"ref":"Exod.13.19","start":2013019,"end":2013019,"break":"none","ruby":[[12,2,"いがい"],[15,1,"たずさ"],[27,1,"かみ"],[29,1,"かなら"],[37,1,"かえり"],[63,2,"いがい"],[66,1,"たずさ"],[74,1,"のぼ"],[77,1,"い"],[89,1,"い"],[99,2,"ひとびと"],[102,1,"かた"],[104,1,"ちか"]],"text":"そのときモーセはヨセフの遺骸を携えていた。ヨセフが、「神は必ずあなたがたを顧みられるであろう。そのとき、あなたがたは、わたしの遺骸を携えて、ここから上って行かなければならない」と言って、イスラエルの人々に固く誓わせたからである。"},{"ref":"Exod.13.20","start":2013020,"end":2013020,"break":"none","ruby":[[4,1,"かれ"],[7,1,"さら"],[14,1,"すす"],[18,2,"あらの"],[21,1,"はし"],[29,2,"しゅくえい"]],"text":"こうして彼らは更にスコテから進んで、荒野の端にあるエタムに宿営した。"},{"ref":"Exod.13.21","start":2013021,"end":2013021,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"まえ"],[7,1,"い"],[11,1,"ひる"],[13,1,"くも"],[15,1,"はしら"],[20,1,"かれ"],[23,1,"みちび"],[26,1,"よる"],[28,1,"ひ"],[30,1,"はしら"],[35,1,"かれ"],[38,1,"てら"],[41,1,"ひる"],[43,1,"よる"],[45,1,"かれ"],[48,1,"すす"],[50,1,"い"]],"text":"主は彼らの前に行かれ、昼は雲の柱をもって彼らを導き、夜は火の柱をもって彼らを照し、昼も夜も彼らを進み行かせられた。"},{"ref":"Exod.13.22","start":2013022,"end":2013022,"break":"none","ruby":[[0,1,"ひる"],[2,1,"くも"],[4,1,"はしら"],[6,1,"よる"],[8,1,"ひ"],[10,1,"はしら"],[13,1,"たみ"],[15,1,"まえ"],[18,1,"はな"]],"text":"昼は雲の柱、夜は火の柱が、民の前から離れなかった。"}]