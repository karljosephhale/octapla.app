[{"ref":"Prov.14.1","start":20014001,"end":20014001,"break":"paragraph","breaks":[[10,"line"]],"ruby":[[0,2,"ちえ"],[5,1,"いえ"],[7,1,"た"],[10,1,"おろ"],[14,2,"じぶん"],[17,1,"て"]],"text":"知恵はその家を建て、愚かさは自分の手でそれをこわす。"},{"ref":"Prov.14.2","start":20014002,"end":20014002,"break":"line","breaks":[[15,"line"]],"ruby":[[5,1,"あゆ"],[7,1,"もの"],[9,1,"しゅ"],[11,1,"おそ"],[15,1,"まが"],[18,1,"あゆ"],[20,1,"もの"],[22,1,"しゅ"],[24,1,"あなど"]],"text":"まっすぐに歩む者は主を恐れる、曲って歩む者は主を侮る。"},{"ref":"Prov.14.3","start":20014003,"end":20014003,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,2,"ことば"],[8,2,"じぶん"],[11,1,"せ"],[16,1,"あ"],[20,2,"ちえ"],[24,1,"もの"],[33,1,"み"],[35,1,"まも"]],"text":"愚かな者の言葉は自分の背にむちを当てる、知恵ある者のくちびるはその身を守る。"},{"ref":"Prov.14.4","start":20014004,"end":20014004,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"うし"],[6,2,"こくもつ"],[12,1,"うし"],[14,1,"ちから"],[19,3,"のうさくもつ"],[23,1,"おお"]],"text":"牛がなければ穀物はない、牛の力によって農作物は多くなる。"},{"ref":"Prov.14.5","start":20014005,"end":20014005,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"しんじつ"],[3,2,"しょうにん"],[14,1,"いつわ"],[17,2,"しょうにん"]],"text":"真実な証人はうそをいわない、偽りの証人はうそをつく。"},{"ref":"Prov.14.6","start":20014006,"end":20014006,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"もの"],[6,2,"ちえ"],[9,1,"もと"],[13,1,"え"],[22,1,"もの"],[24,2,"ちしき"],[27,1,"え"]],"text":"あざける者は知恵を求めても得られない、さとき者は知識を得ることがたやすい。"},{"ref":"Prov.14.7","start":20014007,"end":20014007,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"まえ"],[7,1,"はな"],[9,1,"さ"],[16,2,"ちしき"],[19,2,"ことば"]],"text":"愚かな者の前を離れ去れ、そこには知識の言葉がないからである。"},{"ref":"Prov.14.8","start":20014008,"end":20014008,"break":"line","breaks":[[24,"line"]],"ruby":[[3,1,"もの"],[5,2,"ちえ"],[8,2,"じぶん"],[11,1,"みち"],[24,1,"おろ"],[27,1,"もの"],[29,1,"おろ"],[33,1,"あざむ"]],"text":"さとき者の知恵は自分の道をわきまえることにあり、愚かな者の愚かは、欺くことにある。"},{"ref":"Prov.14.9","start":20014009,"end":20014009,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[2,1,"あ"],[5,1,"もの"],[14,1,"ただ"],[17,1,"もの"],[22,1,"めぐ"],[25,1,"う"]],"text":"神は悪しき者をあざけられる、正しい者は、その恵みを受ける。"},{"ref":"Prov.14.10","start":20014010,"end":20014010,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"こころ"],[2,1,"くる"],[6,1,"こころ"],[12,1,"し"],[17,1,"よろこ"],[21,2,"たにん"]],"text":"心の苦しみは心みずからが知る、その喜びには他人はあずからない。"},{"ref":"Prov.14.11","start":20014011,"end":20014011,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"いえ"],[7,1,"ほろ"],[12,1,"ただ"],[15,1,"もの"],[17,2,"まくや"],[20,1,"さか"]],"text":"悪しき者の家は滅ぼされ、正しい者の幕屋は栄える。"},{"ref":"Prov.14.12","start":20014012,"end":20014012,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ひと"],[2,1,"み"],[4,1,"みずか"],[6,1,"ただ"],[12,1,"みち"],[18,1,"おわ"],[24,1,"し"],[26,1,"いた"],[28,1,"みち"]],"text":"人が見て自ら正しいとする道でも、その終りはついに死に至る道となるものがある。"},{"ref":"Prov.14.13","start":20014013,"end":20014013,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"わら"],[2,1,"とき"],[5,1,"こころ"],[7,1,"かな"],[14,1,"よろこ"],[20,1,"うれ"]],"text":"笑う時にも心に悲しみがあり、喜びのはてに憂いがある。"},{"ref":"Prov.14.14","start":20014014,"end":20014014,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"こころ"],[6,1,"もの"],[14,1,"み"],[16,1,"か"],[18,1,"と"],[21,2,"ぜんりょう"],[24,1,"ひと"],[30,1,"おこな"],[33,1,"み"],[35,1,"か"],[37,1,"と"]],"text":"心のもとれる者はそのしわざの実を刈り取り、善良な人もまたその行いの実を刈り取る。"},{"ref":"Prov.14.15","start":20014015,"end":20014015,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"しりょ"],[5,1,"もの"],[14,1,"しん"],[21,1,"もの"],[23,2,"じぶん"],[26,1,"あゆ"],[29,1,"つつし"]],"text":"思慮のない者はすべてのことを信じる、さとき者は自分の歩みを慎む。"},{"ref":"Prov.14.16","start":20014016,"end":20014016,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[6,2,"ようじん"],[12,1,"あく"],[14,1,"はな"],[18,1,"おろ"],[21,1,"もの"],[23,1,"たか"],[27,2,"ようじん"]],"text":"知恵ある者は用心ぶかく、悪を離れる、愚かな者は高ぶって用心しない。"},{"ref":"Prov.14.17","start":20014017,"end":20014017,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"いか"],[5,1,"もの"],[7,1,"おろ"],[13,1,"おこな"],[16,1,"かしこ"],[18,1,"もの"],[20,2,"にんたい"],[22,1,"づよ"]],"text":"怒りやすい者は愚かなことを行い、賢い者は忍耐強い。"},{"ref":"Prov.14.18","start":20014018,"end":20014018,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"しりょ"],[5,1,"もの"],[7,1,"おろ"],[13,2,"じぶん"],[25,1,"もの"],[27,2,"ちしき"],[33,1,"かんむり"]],"text":"思慮のない者は愚かなことを自分のものとする、さとき者は知識をもって冠とする。"},{"ref":"Prov.14.19","start":20014019,"end":20014019,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"あくにん"],[3,2,"ぜんにん"],[6,1,"まえ"],[10,1,"ふ"],[13,1,"あ"],[16,1,"もの"],[18,1,"ただ"],[21,1,"もの"],[23,1,"もん"],[27,1,"ふ"]],"text":"悪人は善人の前にひれ伏し、悪しき者は正しい者の門にひれ伏す。"},{"ref":"Prov.14.20","start":20014020,"end":20014020,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[7,1,"となり"],[12,1,"にく"],[20,1,"と"],[23,1,"もの"],[25,1,"おお"],[28,1,"とも"]],"text":"貧しい者はその隣にさえも憎まれる、しかし富める者は多くの友をもつ。"},{"ref":"Prov.14.21","start":20014021,"end":20014021,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"とな"],[2,1,"びと"],[4,1,"いや"],[8,1,"もの"],[10,1,"つみ"],[17,1,"まず"],[20,1,"ひと"],[26,1,"もの"]],"text":"隣り人を卑しめる者は罪びとである、貧しい人をあわれむ者はさいわいである。"},{"ref":"Prov.14.22","start":20014022,"end":20014022,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あく"],[2,1,"はか"],[4,1,"もの"],[10,1,"あやま"],[18,1,"ぜん"],[20,1,"はか"],[22,1,"もの"]],"text":"悪を計る者はおのれを誤るではないか、善を計る者にはいつくしみと、まこととがある。"},{"ref":"Prov.14.23","start":20014023,"end":20014023,"break":"line","breaks":[[14,"line"]],"ruby":[[4,2,"きんろう"],[8,2,"りえき"],[17,2,"くちさき"],[22,2,"ことば"],[25,2,"びんぼう"]],"text":"すべての勤労には利益がある、しかし口先だけの言葉は貧乏をきたらせるだけだ。"},{"ref":"Prov.14.24","start":20014024,"end":20014024,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[6,1,"かんむり"],[10,2,"ちえ"],[16,1,"おろ"],[19,1,"もの"],[21,1,"はな"],[23,1,"かんむり"],[27,1,"おろ"]],"text":"知恵ある者の冠はその知恵である、愚かな者の花の冠はただ愚かさである。"},{"ref":"Prov.14.25","start":20014025,"end":20014025,"break":"line","breaks":[[14,"line"]],"ruby":[[4,2,"しょうにん"],[7,1,"ひと"],[9,1,"いのち"],[11,1,"すく"],[14,1,"いつわ"],[17,1,"は"],[19,1,"もの"],[21,1,"うら"],[22,1,"ぎり"],[23,1,"もの"]],"text":"まことの証人は人の命を救う、偽りを吐く者は裏切者である。"},{"ref":"Prov.14.26","start":20014026,"end":20014026,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[11,1,"ひと"],[13,2,"あんしん"],[16,1,"え"],[20,1,"こ"],[26,1,"ば"],[28,1,"え"]],"text":"主を恐れることによって人は安心を得、その子らはのがれ場を得る。"},{"ref":"Prov.14.27","start":20014027,"end":20014027,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[8,1,"いのち"],[10,1,"いずみ"],[15,1,"ひと"],[17,1,"し"]],"text":"主を恐れることは命の泉である、人を死のわなからのがれさせる。"},{"ref":"Prov.14.28","start":20014028,"end":20014028,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おう"],[2,1,"さか"],[5,1,"たみ"],[7,1,"おお"],[15,1,"きみ"],[17,1,"ほろ"],[20,1,"たみ"],[22,1,"うしな"]],"text":"王の栄えは民の多いことにあり、君の滅びは民を失うことにある。"},{"ref":"Prov.14.29","start":20014029,"end":20014029,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"いか"],[8,1,"もの"],[10,1,"おお"],[14,1,"さと"],[20,1,"き"],[22,1,"みじか"],[24,1,"もの"],[26,1,"おろ"]],"text":"怒りをおそくする者は大いなる悟りがあり、気の短い者は愚かさをあらわす。"},{"ref":"Prov.14.30","start":20014030,"end":20014030,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"おだ"],[4,1,"こころ"],[6,1,"み"],[8,1,"いのち"],[16,2,"こうふん"],[19,1,"ほね"],[21,1,"くさ"]],"text":"穏やかな心は身の命である、しかし興奮は骨を腐らせる。"},{"ref":"Prov.14.31","start":20014031,"end":20014031,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[10,1,"もの"],[14,1,"つく"],[16,1,"ぬし"],[18,1,"あなど"],[21,1,"とぼ"],[24,1,"もの"],[30,1,"もの"],[33,1,"しゅ"]],"text":"貧しい者をしえたげる者はその造り主を侮る、乏しい者をあわれむ者は、主をうやまう。"},{"ref":"Prov.14.32","start":20014032,"end":20014032,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[7,1,"あ"],[10,1,"おこな"],[16,1,"ほろ"],[21,1,"ただ"],[24,1,"もの"],[28,1,"ただ"],[39,1,"ば"],[41,1,"え"]],"text":"悪しき者はその悪しき行いによって滅ぼされ、正しい者はその正しきによって、のがれ場を得る。"},{"ref":"Prov.14.33","start":20014033,"end":20014033,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"ちえ"],[6,1,"もの"],[8,1,"こころ"],[15,1,"おろ"],[18,1,"もの"],[20,1,"こころ"],[22,1,"し"]],"text":"知恵はさとき者の心にとどまり、愚かな者の心に知られない。"},{"ref":"Prov.14.34","start":20014034,"end":20014034,"break":"line","breaks":[[9,"line"]],"ruby":[[0,2,"せいぎ"],[3,1,"くに"],[5,1,"たか"],[9,1,"つみ"],[11,1,"たみ"]],"text":"正義は国を高くし、罪は民をはずかしめる。"},{"ref":"Prov.14.35","start":20014035,"end":20014035,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かしこ"],[6,1,"おう"],[8,1,"めぐ"],[14,1,"はじ"],[20,1,"もの"],[24,1,"いか"]],"text":"賢いしもべは王の恵みをうけ、恥をきたらす者はその怒りにあう。"}]