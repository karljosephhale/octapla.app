[{"ref":"2Thess.2.1","start":53002001,"end":53002001,"break":"paragraph","ruby":[[2,2,"きょうだい"],[14,1,"しゅ"],[24,2,"らいりん"],[38,1,"あつ"],[58,1,"ねが"]],"text":"さて兄弟たちよ。わたしたちの主イエス・キリストの来臨と、わたしたちがみもとに集められることとについて、あなたがたにお願いすることがある。"},{"ref":"2Thess.2.2","start":53002002,"end":53002002,"break":"none","ruby":[[0,1,"れい"],[9,2,"ことば"],[26,1,"で"],[31,2,"てがみ"],[38,1,"しゅ"],[40,1,"ひ"],[53,1,"もの"],[64,1,"こころ"],[66,1,"うご"]],"text":"霊により、あるいは言葉により、あるいはわたしたちから出たという手紙によって、主の日はすでにきたとふれまわる者があっても、すぐさま心を動かされたり、あわてたりしてはいけない。"},{"ref":"2Thess.2.3","start":53002003,"end":53002003,"break":"none","ruby":[[6,1,"こと"],[28,2,"はいきょう"],[34,1,"おこ"],[37,2,"ふほう"],[40,1,"もの"],[47,1,"ほろ"],[50,1,"こ"],[52,1,"あらわ"]],"text":"だれがどんな事をしても、それにだまされてはならない。まず背教のことが起り、不法の者、すなわち、滅びの子が現れるにちがいない。"},{"ref":"2Thess.2.4","start":53002004,"end":53002004,"break":"none","ruby":[[0,1,"かれ"],[6,1,"かみ"],[8,1,"よ"],[13,1,"おが"],[23,2,"はんこう"],[27,1,"た"],[29,1,"あ"],[33,1,"みずか"],[35,1,"かみ"],[37,1,"みや"],[39,1,"ざ"],[43,2,"じぶん"],[46,1,"かみ"],[49,2,"せんげん"]],"text":"彼は、すべて神と呼ばれたり拝まれたりするものに反抗して立ち上がり、自ら神の宮に座して、自分は神だと宣言する。"},{"ref":"2Thess.2.5","start":53002005,"end":53002005,"break":"none","ruby":[[12,1,"ところ"],[16,1,"とき"],[22,1,"こと"],[26,1,"かえ"],[29,1,"い"],[34,1,"おも"],[36,1,"だ"]],"text":"わたしがまだあなたがたの所にいた時、これらの事をくり返して言ったのを思い出さないのか。"},{"ref":"2Thess.2.6","start":53002006,"end":53002006,"break":"none","ruby":[[10,1,"し"],[19,1,"かれ"],[21,2,"じぶん"],[24,1,"さだ"],[29,1,"とき"],[36,1,"あらわ"],[45,1,"かれ"],[47,2,"そし"]],"text":"そして、あなたがたが知っているとおり、彼が自分に定められた時になってから現れるように、いま彼を阻止しているものがある。"},{"ref":"2Thess.2.7","start":53002007,"end":53002007,"break":"none","ruby":[[0,2,"ふほう"],[3,2,"ひみつ"],[6,1,"ちから"],[12,1,"はたら"],[30,2,"そし"],[36,1,"もの"],[38,1,"と"],[40,1,"のぞ"],[44,1,"とき"]],"text":"不法の秘密の力が、すでに働いているのである。ただそれは、いま阻止している者が取り除かれる時までのことである。"},{"ref":"2Thess.2.8","start":53002008,"end":53002008,"break":"none","ruby":[[2,1,"とき"],[8,2,"ふほう"],[11,1,"もの"],[13,1,"あらわ"],[19,1,"もの"],[22,1,"しゅ"],[27,1,"くち"],[29,1,"いき"],[34,1,"ころ"],[37,2,"らいりん"],[40,1,"かがや"],[46,1,"ほろ"]],"text":"その時になると、不法の者が現れる。この者を、主イエスは口の息をもって殺し、来臨の輝きによって滅ぼすであろう。"},{"ref":"2Thess.2.9","start":53002009,"end":53002009,"break":"none","ruby":[[0,2,"ふほう"],[3,1,"もの"],[5,1,"く"],[14,1,"はたら"],[29,1,"いつわ"],[32,1,"ちから"],[40,3,"ふしぎ"]],"text":"不法の者が来るのは、サタンの働きによるのであって、あらゆる偽りの力と、しるしと、不思議と、"},{"ref":"2Thess.2.10","start":53002010,"end":53002010,"break":"none","ruby":[[7,2,"ふぎ"],[10,1,"まど"],[16,1,"ほろ"],[20,1,"もの"],[24,1,"たい"],[27,1,"おこな"],[35,1,"かれ"],[38,1,"ほろ"],[44,2,"じぶん"],[48,1,"すくい"],[54,2,"しんり"],[57,1,"たい"],[60,1,"あい"],[62,1,"う"],[70,1,"むく"]],"text":"また、あらゆる不義の惑わしとを、滅ぶべき者どもに対して行うためである。彼らが滅びるのは、自分らの救となるべき真理に対する愛を受けいれなかった報いである。"},{"ref":"2Thess.2.11","start":53002011,"end":53002011,"break":"none","ruby":[[3,1,"かみ"],[6,1,"かれ"],[9,1,"いつわ"],[12,1,"しん"],[19,1,"まよ"],[22,1,"ちから"],[24,1,"おく"]],"text":"そこで神は、彼らが偽りを信じるように、迷わす力を送り、"},{"ref":"2Thess.2.12","start":53002012,"end":53002012,"break":"none","ruby":[[5,2,"しんり"],[8,1,"しん"],[13,2,"ふぎ"],[16,1,"よろこ"],[25,1,"ひと"]],"text":"こうして、真理を信じないで不義を喜んでいたすべての人を、さばくのである。"},{"ref":"2Thess.2.13","start":53002013,"end":53002013,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"あい"],[12,2,"きょうだい"],[37,1,"かみ"],[39,2,"かんしゃ"],[55,1,"かみ"],[63,1,"はじ"],[67,1,"えら"],[71,2,"みたま"],[81,2,"しんり"],[84,1,"たい"],[87,2,"しんこう"],[95,1,"すくい"],[97,1,"え"]],"text":"しかし、主に愛されている兄弟たちよ。わたしたちはいつもあなたがたのことを、神に感謝せずにはおられない。それは、神があなたがたを初めから選んで、御霊によるきよめと、真理に対する信仰とによって、救を得させようとし、"},{"ref":"2Thess.2.14","start":53002014,"end":53002014,"break":"none","ruby":[[12,2,"ふくいん"],[23,1,"め"],[33,1,"しゅ"],[43,2,"えいこう"],[52,1,"くだ"]],"text":"そのために、わたしたちの福音によりあなたがたを召して、わたしたちの主イエス・キリストの栄光にあずからせて下さるからである。"},{"ref":"2Thess.2.15","start":53002015,"end":53002015,"break":"none","ruby":[[4,2,"きょうだい"],[10,1,"かた"],[12,1,"た"],[22,2,"ことば"],[25,2,"てがみ"],[28,1,"おし"],[33,2,"いいつた"],[43,1,"まも"],[45,1,"つづ"]],"text":"そこで、兄弟たちよ。堅く立って、わたしたちの言葉や手紙で教えられた言伝えを、しっかりと守り続けなさい。"},{"ref":"2Thess.2.16","start":53002016,"end":53002016,"break":"paragraph","ruby":[[10,1,"しゅ"],[20,2,"じしん"],[30,1,"あい"],[33,1,"めぐ"],[39,2,"えいえん"],[42,1,"なぐさ"],[45,1,"たし"],[48,1,"のぞ"],[52,1,"たま"],[61,1,"ちち"],[64,1,"かみ"]],"text":"どうか、わたしたちの主イエス・キリストご自身と、わたしたちを愛し、恵みをもって永遠の慰めと確かな望みとを賜わるわたしたちの父なる神とが、"},{"ref":"2Thess.2.17","start":53002017,"end":53002017,"break":"none","ruby":[[6,1,"こころ"],[8,1,"はげ"],[18,1,"つよ"],[26,1,"よ"],[31,1,"おこな"],[34,1,"ただ"],[37,2,"ことば"],[40,1,"かた"],[42,1,"もの"],[46,1,"くだ"]],"text":"あなたがたの心を励まし、あなたがたを強めて、すべての良いわざを行い、正しい言葉を語る者として下さるように。"}]