[{"ref":"Num.9.1","start":4009001,"end":4009001,"break":"paragraph","ruby":[[5,1,"くに"],[7,1,"で"],[9,1,"つぎ"],[11,1,"とし"],[13,2,"しょうがつ"],[16,1,"しゅ"],[22,2,"あらの"],[29,1,"い"]],"text":"エジプトの国を出た次の年の正月、主はシナイの荒野でモーセに言われた、"},{"ref":"Num.9.2","start":4009002,"end":4009002,"break":"none","ruby":[[7,2,"ひとびと"],[11,2,"すぎこし"],[14,1,"まつり"],[16,1,"さだ"],[19,1,"とき"],[21,1,"おこな"]],"text":"「イスラエルの人々に、過越の祭を定めの時に行わせなさい。"},{"ref":"Num.9.3","start":4009003,"end":4009003,"break":"none","ruby":[[2,1,"つき"],[6,1,"か"],[8,2,"ゆうぐれ"],[11,1,"さだ"],[14,1,"とき"],[20,1,"おこな"],[44,1,"さだ"],[67,1,"おこな"]],"text":"この月の十四日の夕暮、定めの時に、それを行わなければならない。あなたがたは、そのすべての定めと、そのすべてのおきてにしたがって、それを行わなければならない」。"},{"ref":"Num.9.4","start":4009004,"end":4009004,"break":"none","ruby":[[13,2,"ひとびと"],[17,2,"すぎこし"],[20,1,"まつり"],[22,1,"おこな"],[33,1,"い"]],"text":"そこでモーセがイスラエルの人々に、過越の祭を行わなければならないと言ったので、"},{"ref":"Num.9.5","start":4009005,"end":4009005,"break":"none","ruby":[[0,1,"かれ"],[3,2,"しょうがつ"],[8,1,"か"],[10,2,"ゆうぐれ"],[17,2,"あらの"],[20,2,"すぎこし"],[23,1,"まつり"],[25,1,"おこな"],[40,2,"ひとびと"],[47,1,"しゅ"],[53,1,"めい"]],"text":"彼らは正月の十四日の夕暮、シナイの荒野で過越の祭を行った。すなわち、イスラエルの人々は、すべて主がモーセに命じられたようにおこなった。"},{"ref":"Num.9.6","start":4009006,"end":4009006,"break":"none","ruby":[[4,1,"ひと"],[6,2,"したい"],[9,1,"ふ"],[12,1,"み"],[14,1,"けが"],[23,1,"ひ"],[25,2,"すぎこし"],[28,1,"まつり"],[30,1,"おこな"],[39,2,"ひとびと"],[48,1,"ひ"],[57,1,"まえ"]],"text":"ところが人の死体に触れて身を汚したために、その日に過越の祭を行うことのできない人々があって、その日モーセとアロンの前にきて、"},{"ref":"Num.9.7","start":4009007,"end":4009007,"break":"none","ruby":[[2,2,"ひとびと"],[5,1,"かれ"],[7,1,"い"],[18,1,"ひと"],[20,2,"したい"],[23,1,"ふ"],[26,1,"み"],[28,1,"けが"],[39,1,"さだ"],[42,1,"とき"],[51,2,"ひとびと"],[54,1,"とも"],[57,1,"しゅ"],[59,1,"そな"],[61,1,"もの"]],"text":"その人々は彼に言った、「わたしたちは人の死体に触れて身を汚しましたが、なぜその定めの時に、イスラエルの人々と共に、主に供え物をささげることができないのですか」。"},{"ref":"Num.9.8","start":4009008,"end":4009008,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[16,1,"ま"],[19,1,"しゅ"],[33,1,"おお"],[40,1,"き"]],"text":"モーセは彼らに言った、「しばらく待て。主があなたがたについて、どう仰せになるかを聞こう」。"},{"ref":"Num.9.9","start":4009009,"end":4009009,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.9.10","start":4009010,"end":4009010,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[35,2,"しそん"],[41,2,"したい"],[44,1,"ふ"],[47,1,"み"],[49,1,"けが"],[52,1,"ひと"],[55,1,"とお"],[57,2,"たびじ"],[62,1,"ひと"],[68,2,"すぎこし"],[71,1,"まつり"],[73,1,"しゅ"],[75,1,"たい"],[78,1,"おこな"]],"text":"「イスラエルの人々に言いなさい、『あなたがたのうち、また、あなたがたの子孫のうち、死体に触れて身を汚した人も、遠い旅路にある人も、なお、過越の祭を主に対して行うことができるであろう。"},{"ref":"Num.9.11","start":4009011,"end":4009011,"break":"none","ruby":[[6,1,"にがつ"],[10,1,"か"],[12,2,"ゆうぐれ"],[18,1,"おこな"],[21,1,"たね"],[22,1,"い"],[28,1,"く"],[29,1,"な"],[31,1,"そ"],[38,1,"た"]],"text":"すなわち、二月の十四日の夕暮、それを行い、種入れぬパンと苦菜を添えて、それを食べなければならない。"},{"ref":"Num.9.12","start":4009012,"end":4009012,"break":"none","ruby":[[3,1,"すこ"],[7,1,"あさ"],[10,1,"のこ"],[26,1,"ほね"],[29,1,"ぽん"],[32,1,"お"],[41,2,"すぎこし"],[44,1,"まつり"],[50,1,"さだ"],[61,1,"おこな"]],"text":"これを少しでも朝まで残しておいてはならない。またその骨は一本でも折ってはならない。過越の祭のすべての定めにしたがってこれを行わなければならない。"},{"ref":"Num.9.13","start":4009013,"end":4009013,"break":"none","ruby":[[6,1,"み"],[8,1,"きよ"],[11,1,"たび"],[13,1,"で"],[22,2,"すぎこし"],[25,1,"まつり"],[27,1,"おこな"],[37,1,"ひと"],[39,1,"たみ"],[45,1,"た"],[59,1,"ひと"],[62,1,"さだ"],[65,1,"とき"],[67,1,"しゅ"],[69,1,"そな"],[71,1,"もの"],[83,1,"つみ"],[85,1,"お"]],"text":"しかし、その身は清く、旅に出てもいないのに、過越の祭を行わないときは、その人は民のうちから断たれるであろう。このような人は、定めの時に主の供え物をささげないゆえ、その罪を負わなければならない。"},{"ref":"Num.9.14","start":4009014,"end":4009014,"break":"none","ruby":[[2,2,"たこく"],[5,1,"ひと"],[17,2,"きりゅう"],[24,1,"しゅ"],[26,1,"たい"],[29,2,"すぎこし"],[32,1,"まつり"],[34,1,"おこな"],[44,2,"すぎこし"],[47,1,"まつり"],[49,1,"さだ"],[70,1,"おこな"],[87,2,"たこく"],[90,1,"ひと"],[94,2,"じこく"],[97,1,"ひと"],[101,2,"どういつ"],[104,1,"さだ"],[107,1,"もち"]],"text":"もし他国の人が、あなたがたのうちに寄留していて、主に対して過越の祭を行おうとするならば、過越の祭の定めにより、そのおきてにしたがって、これを行わなければならない。あなたがたは他国の人にも、自国の人にも、同一の定めを用いなければならない』」。"},{"ref":"Num.9.15","start":4009015,"end":4009015,"break":"paragraph","ruby":[[0,2,"まくや"],[3,1,"た"],[6,1,"ひ"],[9,1,"くも"],[11,2,"まくや"],[31,2,"まくや"],[38,1,"ゆう"],[42,2,"まくや"],[45,1,"うえ"],[48,1,"くも"],[50,1,"ひ"],[55,1,"み"],[59,1,"あさ"],[63,1,"およ"]],"text":"幕屋を建てた日に、雲は幕屋をおおった。すれはすなわち、あかしの幕屋であって、夕には、幕屋の上に、雲は火のように見えて、朝にまで及んだ。"},{"ref":"Num.9.16","start":4009016,"end":4009016,"break":"none","ruby":[[0,1,"つね"],[9,1,"ひる"],[11,1,"くも"],[20,1,"よる"],[22,1,"ひ"],[27,1,"み"]],"text":"常にそうであって、昼は雲がそれをおおい、夜は火のように見えた。"},{"ref":"Num.9.17","start":4009017,"end":4009017,"break":"none","ruby":[[0,1,"くも"],[2,2,"まくや"],[5,1,"はな"],[11,1,"とき"],[20,2,"ひとびと"],[28,1,"みち"],[30,1,"すす"],[36,1,"くも"],[42,1,"ところ"],[51,2,"ひとびと"],[54,2,"しゅくえい"]],"text":"雲が幕屋を離れてのぼる時は、イスラエルの人々は、ただちに道に進んだ。また雲がとどまる所に、イスラエルの人々は宿営した。"},{"ref":"Num.9.18","start":4009018,"end":4009018,"break":"none","ruby":[[11,2,"ひとびと"],[15,1,"しゅ"],[17,1,"めい"],[22,1,"みち"],[24,1,"すす"],[27,1,"しゅ"],[29,1,"めい"],[34,2,"しゅくえい"],[38,2,"まくや"],[41,1,"うえ"],[43,1,"くも"],[52,1,"あいだ"],[55,2,"しゅくえい"]],"text":"すなわち、イスラエルの人々は、主の命によって道に進み、主の命によって宿営し、幕屋の上に雲がとどまっている間は、宿営していた。"},{"ref":"Num.9.19","start":4009019,"end":4009019,"break":"none","ruby":[[0,2,"まくや"],[3,1,"うえ"],[6,1,"ひ"],[7,1,"ひさ"],[10,1,"くも"],[16,1,"とき"],[25,2,"ひとびと"],[28,1,"しゅ"],[30,1,"い"],[35,1,"まも"],[39,1,"みち"],[41,1,"すす"]],"text":"幕屋の上に、日久しく雲のとどまる時は、イスラエルの人々は主の言いつけを守って、道に進まなかった。"},{"ref":"Num.9.20","start":4009020,"end":4009020,"break":"none","ruby":[[2,2,"まくや"],[5,1,"うえ"],[8,1,"くも"],[14,1,"ひ"],[16,1,"すく"],[19,1,"とき"],[26,1,"かれ"],[32,1,"しゅ"],[34,1,"めい"],[41,2,"しゅくえい"],[45,1,"しゅ"],[47,1,"めい"],[55,1,"みち"],[57,1,"すす"]],"text":"また幕屋の上に、雲のとどまる日の少ない時もあったが、彼らは、ただ主の命にしたがって宿営し、主の命にしたがって、道に進んだ。"},{"ref":"Num.9.21","start":4009021,"end":4009021,"break":"none","ruby":[[2,1,"くも"],[4,1,"ゆう"],[7,1,"あさ"],[23,1,"あさ"],[29,1,"くも"],[34,1,"とき"],[37,1,"かれ"],[40,1,"みち"],[42,1,"すす"],[48,1,"ひる"],[51,1,"よる"],[55,1,"くも"],[60,1,"とき"],[63,1,"かれ"],[66,1,"みち"],[68,1,"すす"]],"text":"また雲は夕から朝まで、とどまることもあったが、朝になって、雲がのぼる時は、彼らは道に進んだ。また昼でも夜でも、雲がのぼる時は、彼らは道に進んだ。"},{"ref":"Num.9.22","start":4009022,"end":4009022,"break":"none","ruby":[[8,1,"げつ"],[18,2,"いじょう"],[23,2,"まくや"],[26,1,"うえ"],[29,1,"くも"],[38,1,"あいだ"],[47,2,"ひとびと"],[50,2,"しゅくえい"],[57,1,"みち"],[59,1,"すす"],[74,1,"みち"],[76,1,"すす"]],"text":"ふつかでも、一か月でも、あるいはそれ以上でも、幕屋の上に、雲がとどまっている間は、イスラエルの人々は宿営していて、道に進まなかったが、それがのぼると道に進んだ。"},{"ref":"Num.9.23","start":4009023,"end":4009023,"break":"none","ruby":[[5,1,"かれ"],[8,1,"しゅ"],[10,1,"めい"],[17,2,"しゅくえい"],[21,1,"しゅ"],[23,1,"めい"],[30,1,"みち"],[32,1,"すす"],[43,1,"しゅ"],[45,1,"めい"],[55,1,"しゅ"],[57,1,"い"],[62,1,"まも"]],"text":"すなわち、彼らは主の命にしたがって宿営し、主の命にしたがって道に進み、モーセによって、主が命じられたとおりに、主の言いつけを守った。"}]