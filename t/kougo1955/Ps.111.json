[{"ref":"Ps.111.1","start":19111001,"end":19111001,"break":"paragraph","breaks":[[9,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[13,1,"ただ"],[16,1,"もの"],[25,2,"こうかい"],[29,1,"こころ"],[35,1,"しゅ"],[37,2,"かんしゃ"]],"text":"主をほめたたえよ。わたしは正しい者のつどい、および公会で、心をつくして主に感謝する。"},{"ref":"Ps.111.2","start":19111002,"end":19111002,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[6,2,"いだい"],[21,1,"よろこ"],[23,1,"もの"],[28,1,"たず"],[30,1,"きわ"]],"text":"主のみわざは偉大である。すべてそのみわざを喜ぶ者によって尋ね窮められる。"},{"ref":"Ps.111.3","start":19111003,"end":19111003,"break":"line","breaks":[[16,"line"]],"ruby":[[6,2,"えいこう"],[9,2,"いげん"],[13,1,"み"],[18,1,"ぎ"]],"text":"そのみわざは栄光と威厳とに満ち、その義はとこしえに、うせることがない。"},{"ref":"Ps.111.4","start":19111004,"end":19111004,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[12,2,"きねん"],[20,1,"しゅ"],[22,1,"めぐ"],[33,1,"み"]],"text":"主はそのくすしきみわざを記念させられた。主は恵みふかく、あわれみに満ちていられる。"},{"ref":"Ps.111.5","start":19111005,"end":19111005,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"おそ"],[9,1,"もの"],[11,2,"しょくもつ"],[14,1,"あた"],[19,2,"けいやく"],[27,1,"こころ"]],"text":"主はおのれを恐れる者に食物を与え、その契約をとこしえに心にとめられる。"},{"ref":"Ps.111.6","start":19111006,"end":19111006,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"くにたみ"],[10,2,"しょりょう"],[15,1,"たみ"],[17,1,"あた"],[25,1,"ちから"]],"text":"主はもろもろの国民の所領をその民に与えて、みわざの力をこれにあらわされた。"},{"ref":"Ps.111.7","start":19111007,"end":19111007,"break":"line","breaks":[[18,"line"]],"ruby":[[3,1,"て"],[8,2,"しんじつ"],[12,2,"こうせい"],[26,1,"たし"]],"text":"そのみ手のわざは真実かつ公正であり、すべてのさとしは確かである。"},{"ref":"Ps.111.8","start":19111008,"end":19111008,"break":"line","breaks":[[16,"line"]],"ruby":[[4,2,"よよ"],[11,1,"かた"],[13,1,"た"],[16,2,"しんじつ"],[19,2,"しょうじき"]],"text":"これらは世々かぎりなく堅く立ち、真実と正直とをもってなされた。"},{"ref":"Ps.111.9","start":19111009,"end":19111009,"break":"line","breaks":[[14,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"たみ"],[11,1,"ほどこ"],[16,2,"けいやく"],[24,1,"た"],[33,1,"な"],[35,1,"せい"]],"text":"主はその民にあがないを施し、その契約をとこしえに立てられた。そのみ名は聖にして、おそれおおい。"},{"ref":"Ps.111.10","start":19111010,"end":19111010,"break":"line","breaks":[[18,"line"],[35,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[8,2,"ちえ"],[21,1,"おこな"],[23,1,"もの"],[27,1,"よ"],[29,1,"さと"],[32,1,"え"],[35,1,"しゅ"],[37,1,"ほまれ"]],"text":"主を恐れることは知恵のはじめである。これを行う者はみな良き悟りを得る。主の誉は、とこしえに、うせることはない。"}]