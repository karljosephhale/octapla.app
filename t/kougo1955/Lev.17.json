[{"ref":"Lev.17.1","start":3017001,"end":3017001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.17.2","start":3017002,"end":3017002,"break":"none","ruby":[[7,1,"こ"],[24,2,"ひとびと"],[27,1,"い"],[34,1,"しゅ"],[36,1,"めい"]],"text":"「アロンとその子たち、およびイスラエルのすべての人々に言いなさい、『主が命じられることはこれである。すなわち"},{"ref":"Lev.17.3","start":3017003,"end":3017003,"break":"none","ruby":[[6,1,"いえ"],[13,1,"うし"],[15,1,"ひつじ"],[24,2,"しゅくえい"],[27,1,"うち"],[36,2,"しゅくえい"],[39,1,"そと"]],"text":"イスラエルの家のだれでも、牛、羊あるいは、やぎを宿営の内でほふり、または宿営の外でほふり、"},{"ref":"Lev.17.4","start":3017004,"end":3017004,"break":"none","ruby":[[3,2,"かいけん"],[6,2,"まくや"],[9,2,"いりぐち"],[12,1,"たずさ"],[17,1,"しゅ"],[19,2,"まくや"],[22,1,"まえ"],[25,1,"そな"],[27,1,"もの"],[31,1,"しゅ"],[44,1,"ひと"],[46,1,"ち"],[48,1,"なが"],[51,1,"もの"],[59,1,"かれ"],[61,1,"ち"],[63,1,"なが"],[71,1,"たみ"],[77,1,"た"]],"text":"それを会見の幕屋の入口に携えてきて主の幕屋の前で、供え物として主にささげないならば、その人は血を流した者とみなされる。彼は血を流したゆえ、その民のうちから断たれるであろう。"},{"ref":"Lev.17.5","start":3017005,"end":3017005,"break":"none","ruby":[[9,2,"ひとびと"],[13,1,"かれ"],[16,1,"の"],[27,1,"つね"],[33,2,"ぎせい"],[36,1,"しゅ"],[48,2,"かいけん"],[51,2,"まくや"],[54,2,"いりぐち"],[59,2,"さいし"],[71,1,"しゅ"],[77,3,"しゅうおんさい"],[81,2,"ぎせい"]],"text":"これはイスラエルの人々に、彼らが野のおもてでほふるのを常としていた犠牲を主のもとにひいてこさせ、会見の幕屋の入口におる祭司のもとにきて、これを主にささげる酬恩祭の犠牲としてほふらせるためである。"},{"ref":"Lev.17.6","start":3017006,"end":3017006,"break":"none","ruby":[[0,2,"さいし"],[5,1,"ち"],[7,2,"かいけん"],[10,2,"まくや"],[13,2,"いりぐち"],[18,1,"しゅ"],[20,2,"さいだん"],[23,1,"そそ"],[32,2,"しぼう"],[35,1,"や"],[38,1,"こう"],[48,1,"しゅ"]],"text":"祭司はその血を会見の幕屋の入口にある主の祭壇に注ぎかけ、またその脂肪を焼いて香ばしいかおりとし、主にささげなければならない。"},{"ref":"Lev.17.7","start":3017007,"end":3017007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"した"],[6,2,"かんいん"],[18,1,"かみ"],[21,1,"ふたた"],[23,2,"ぎせい"],[39,1,"かれ"],[42,2,"よよ"],[47,1,"まも"],[51,1,"さだ"]],"text":"彼らが慕って姦淫をおこなったみだらな神に、再び犠牲をささげてはならない。これは彼らが代々ながく守るべき定めである』。"},{"ref":"Lev.17.8","start":3017008,"end":3017008,"break":"paragraph","ruby":[[6,1,"かれ"],[9,1,"い"],[22,1,"いえ"],[24,1,"もの"],[38,1,"やど"],[40,3,"きりゅうしゃ"],[49,2,"はんさい"],[55,2,"ぎせい"]],"text":"あなたはまた彼らに言いなさい、『イスラエルの家の者、またはあなたがたのうちに宿る寄留者のだれでも、燔祭あるいは犠牲をささげるのに、"},{"ref":"Lev.17.9","start":3017009,"end":3017009,"break":"none","ruby":[[3,2,"かいけん"],[6,2,"まくや"],[9,2,"いりぐち"],[12,1,"たずさ"],[18,1,"しゅ"],[31,1,"ひと"],[36,1,"たみ"],[42,1,"た"]],"text":"これを会見の幕屋の入口に携えてきて、主にささげないならば、その人は、その民のうちから断たれるであろう。"},{"ref":"Lev.17.10","start":3017010,"end":3017010,"break":"paragraph","ruby":[[6,1,"いえ"],[8,1,"もの"],[22,1,"やど"],[24,3,"きりゅうしゃ"],[33,1,"ち"],[35,1,"た"],[48,1,"ち"],[50,1,"た"],[53,1,"ひと"],[55,1,"てき"],[63,1,"かお"],[65,1,"む"],[73,1,"たみ"],[79,1,"た"]],"text":"イスラエルの家の者、またはあなたがたのうちに宿る寄留者のだれでも、血を食べるならば、わたしはその血を食べる人に敵して、わたしの顔を向け、これをその民のうちから断つであろう。"},{"ref":"Lev.17.11","start":3017011,"end":3017011,"break":"none","ruby":[[0,1,"にく"],[2,1,"いのち"],[4,1,"ち"],[20,1,"たましい"],[25,2,"さいだん"],[28,1,"うえ"],[54,1,"あた"],[58,1,"ち"],[60,1,"いのち"]],"text":"肉の命は血にあるからである。あなたがたの魂のために祭壇の上で、あがないをするため、わたしはこれをあなたがたに与えた。血は命であるゆえに、あがなうことができるからである。"},{"ref":"Lev.17.12","start":3017012,"end":3017012,"break":"none","ruby":[[16,2,"ひとびと"],[19,1,"い"],[35,1,"ち"],[37,1,"た"],[57,1,"やど"],[59,3,"きりゅうしゃ"],[63,1,"ち"],[65,1,"た"]],"text":"このゆえに、わたしはイスラエルの人々に言った。あなたがたのうち、だれも血を食べてはならない。またあなたがたのうちに宿る寄留者も血を食べてはならない。"},{"ref":"Lev.17.13","start":3017013,"end":3017013,"break":"none","ruby":[[6,2,"ひとびと"],[23,1,"やど"],[25,3,"きりゅうしゃ"],[37,1,"た"],[43,1,"けもの"],[48,1,"とり"],[50,1,"か"],[52,1,"え"],[54,1,"もの"],[59,1,"ち"],[61,1,"そそ"],[63,1,"だ"],[66,1,"つち"]],"text":"イスラエルの人々のうち、またあなたがたのうちに宿る寄留者のうち、だれでも、食べてもよい獣あるいは鳥を狩り獲た者は、その血を注ぎ出し、土でこれをおおわなければならない。"},{"ref":"Lev.17.14","start":3017014,"end":3017014,"break":"paragraph","ruby":[[3,1,"にく"],[5,1,"いのち"],[10,1,"ち"],[35,2,"ひとびと"],[38,1,"い"],[52,1,"にく"],[54,1,"ち"],[56,1,"た"],[68,1,"にく"],[70,1,"いのち"],[74,1,"ち"],[85,1,"ち"],[87,1,"た"],[90,1,"もの"],[92,1,"た"]],"text":"すべて肉の命は、その血と一つだからである。それで、わたしはイスラエルの人々に言った。あなたがたは、どんな肉の血も食べてはならない。すべて肉の命はその血だからである。すべて血を食べる者は断たれるであろう。"},{"ref":"Lev.17.15","start":3017015,"end":3017015,"break":"none","ruby":[[0,2,"しぜん"],[3,1,"し"],[12,1,"さ"],[14,1,"ころ"],[21,1,"た"],[24,1,"ひと"],[27,1,"くに"],[29,1,"うま"],[32,1,"もの"],[37,3,"きりゅうしゃ"],[46,2,"いふく"],[49,1,"あら"],[52,1,"みず"],[54,1,"み"],[68,1,"かれ"],[70,1,"ゆう"],[73,1,"けが"],[82,1,"のち"],[84,1,"きよ"]],"text":"自然に死んだもの、または裂き殺されたものを食べる人は、国に生れた者であれ、寄留者であれ、その衣服を洗い、水に身をすすがなければならない。彼は夕まで汚れているが、その後、清くなるであろう。"},{"ref":"Lev.17.16","start":3017016,"end":3017016,"break":"none","ruby":[[3,1,"あら"],[9,1,"み"],[20,1,"かれ"],[24,1,"つみ"],[26,1,"お"]],"text":"もし、洗わず、また身をすすがないならば、彼はその罪を負わなければならない』」。"}]