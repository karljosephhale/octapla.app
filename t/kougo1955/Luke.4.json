[{"ref":"Luke.4.1","start":42004001,"end":42004001,"break":"paragraph","ruby":[[7,2,"せいれい"],[10,1,"み"],[17,1,"がわ"],[20,1,"かえ"]],"text":"さて、イエスは聖霊に満ちてヨルダン川から帰り、"},{"ref":"Luke.4.2","start":42004002,"end":42004002,"break":"none","ruby":[[0,2,"あらの"],[5,1,"にち"],[10,2,"みたま"],[21,2,"あくま"],[24,1,"こころ"],[37,1,"なに"],[39,1,"た"],[45,2,"ひかず"],[53,2,"くうふく"]],"text":"荒野を四十日のあいだ御霊にひきまわされて、悪魔の試みにあわれた。そのあいだ何も食べず、その日数がつきると、空腹になられた。"},{"ref":"Luke.4.3","start":42004003,"end":42004003,"break":"none","ruby":[[3,2,"あくま"],[6,1,"い"],[17,1,"かみ"],[19,1,"こ"],[28,1,"いし"],[37,1,"めい"]],"text":"そこで悪魔が言った、「もしあなたが神の子であるなら、この石に、パンになれと命じてごらんなさい」。"},{"ref":"Luke.4.4","start":42004004,"end":42004004,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[14,1,"ひと"],[21,1,"い"],[32,1,"か"]],"text":"イエスは答えて言われた、「『人はパンだけで生きるものではない』と書いてある」。"},{"ref":"Luke.4.5","start":42004005,"end":42004005,"break":"none","ruby":[[5,2,"あくま"],[12,1,"たか"],[14,1,"ところ"],[16,1,"つ"],[19,1,"い"],[28,2,"せかい"],[35,2,"くにぐに"],[38,1,"み"]],"text":"それから、悪魔はイエスを高い所へ連れて行き、またたくまに世界のすべての国々を見せて"},{"ref":"Luke.4.6","start":42004006,"end":42004006,"break":"none","ruby":[[0,1,"い"],[9,2,"くにぐに"],[12,2,"けんい"],[15,2,"えいが"],[42,1,"まか"],[54,1,"す"],[57,1,"ひと"]],"text":"言った、「これらの国々の権威と栄華とをみんな、あなたにあげましょう。それらはわたしに任せられていて、だれでも好きな人にあげてよいのですから。"},{"ref":"Luke.4.7","start":42004007,"end":42004007,"break":"none","ruby":[[14,1,"まえ"],[27,2,"ぜんぶ"]],"text":"それで、もしあなたがわたしの前にひざまずくなら、これを全部あなたのものにしてあげましょう」。"},{"ref":"Luke.4.8","start":42004008,"end":42004008,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[14,1,"しゅ"],[21,1,"かみ"],[23,1,"はい"],[28,1,"かみ"],[32,1,"つか"],[37,1,"か"]],"text":"イエスは答えて言われた、「『主なるあなたの神を拝し、ただ神にのみ仕えよ』と書いてある」。"},{"ref":"Luke.4.9","start":42004009,"end":42004009,"break":"none","ruby":[[4,2,"あくま"],[17,1,"つ"],[20,1,"い"],[23,1,"みや"],[25,2,"ちょうじょう"],[28,1,"た"],[32,1,"い"],[43,1,"かみ"],[45,1,"こ"],[56,1,"した"],[58,1,"と"]],"text":"それから悪魔はイエスをエルサレムに連れて行き、宮の頂上に立たせて言った、「もしあなたが神の子であるなら、ここから下へ飛びおりてごらんなさい。"},{"ref":"Luke.4.10","start":42004010,"end":42004010,"break":"none","ruby":[[1,1,"かみ"],[11,2,"みつかい"],[16,1,"めい"],[23,1,"まも"]],"text":"『神はあなたのために、御使たちに命じてあなたを守らせるであろう』とあり、"},{"ref":"Luke.4.11","start":42004011,"end":42004011,"break":"none","ruby":[[8,1,"あし"],[10,1,"いし"],[12,1,"う"],[24,1,"かれ"],[31,1,"て"],[44,1,"か"]],"text":"また、『あなたの足が石に打ちつけられないように、彼らはあなたを手でささえるであろう』とも書いてあります」。"},{"ref":"Luke.4.12","start":42004012,"end":42004012,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[14,1,"しゅ"],[21,1,"かみ"],[23,1,"こころ"],[33,1,"い"]],"text":"イエスは答えて言われた、「『主なるあなたの神を試みてはならない』と言われている」。"},{"ref":"Luke.4.13","start":42004013,"end":42004013,"break":"none","ruby":[[0,2,"あくま"],[7,1,"こころ"],[16,2,"いちじ"],[22,1,"はな"]],"text":"悪魔はあらゆる試みをしつくして、一時イエスを離れた。"},{"ref":"Luke.4.14","start":42004014,"end":42004014,"break":"paragraph","ruby":[[8,2,"みたま"],[11,1,"ちから"],[13,1,"み"],[24,1,"かえ"],[38,2,"ちほう"],[40,2,"ぜんたい"]],"text":"それからイエスは御霊の力に満ちあふれてガリラヤへ帰られると、そのうわさがその地方全体にひろまった。"},{"ref":"Luke.4.15","start":42004015,"end":42004015,"break":"none","ruby":[[4,1,"しょ"],[5,2,"かいどう"],[8,1,"おし"],[15,1,"もの"],[18,2,"そんけい"],[22,1,"う"]],"text":"イエスは諸会堂で教え、みんなの者から尊敬をお受けになった。"},{"ref":"Luke.4.16","start":42004016,"end":42004016,"break":"paragraph","ruby":[[5,1,"そだ"],[15,1,"い"],[18,3,"あんそくにち"],[29,2,"かいどう"],[36,2,"せいしょ"],[39,2,"ろうどく"],[47,1,"た"]],"text":"それからお育ちになったナザレに行き、安息日にいつものように会堂にはいり、聖書を朗読しようとして立たれた。"},{"ref":"Luke.4.17","start":42004017,"end":42004017,"break":"none","ruby":[[3,3,"よげんしゃ"],[10,1,"しょ"],[12,2,"てわた"],[22,1,"しょ"],[24,1,"ひら"],[30,1,"か"],[35,1,"ところ"],[37,1,"だ"]],"text":"すると預言者イザヤの書が手渡されたので、その書を開いて、こう書いてある所を出された、"},{"ref":"Luke.4.18","start":42004018,"end":42004018,"break":"stanza","breaks":[[16,"line"],[36,"line"],[55,"line"],[67,"line"],[93,"line"]],"ruby":[[1,1,"しゅ"],[3,2,"みたま"],[10,1,"やど"],[16,1,"まず"],[19,2,"ひとびと"],[22,2,"ふくいん"],[25,1,"の"],[27,1,"つた"],[40,1,"せい"],[41,1,"べつ"],[55,1,"しゅ"],[67,2,"しゅうじん"],[70,2,"かいほう"],[75,2,"もうじん"],[78,1,"め"],[80,1,"ひら"],[87,1,"つ"],[89,1,"し"],[93,1,"う"],[102,1,"もの"],[104,2,"じゆう"],[107,1,"え"]],"text":"「主の御霊がわたしに宿っている。貧しい人々に福音を宣べ伝えさせるために、わたしを聖別してくださったからである。主はわたしをつかわして、囚人が解放され、盲人の目が開かれることを告げ知らせ、打ちひしがれている者に自由を得させ、"},{"ref":"Luke.4.19","start":42004019,"end":42004019,"break":"line","ruby":[[0,1,"しゅ"],[6,1,"とし"],[8,1,"つ"],[10,1,"し"]],"text":"主のめぐみの年を告げ知らせるのである」。"},{"ref":"Luke.4.20","start":42004020,"end":42004020,"break":"none","ruby":[[4,2,"せいしょ"],[7,1,"ま"],[10,1,"かか"],[13,1,"もの"],[15,1,"かえ"],[18,1,"せき"],[20,1,"つ"],[26,2,"かいどう"],[35,1,"もの"],[37,1,"め"],[43,1,"そそ"]],"text":"イエスは聖書を巻いて係りの者に返し、席に着かれると、会堂にいるみんなの者の目がイエスに注がれた。"},{"ref":"Luke.4.21","start":42004021,"end":42004021,"break":"none","ruby":[[11,1,"せい"],[12,1,"く"],[21,1,"みみ"],[27,1,"ひ"],[29,2,"じょうじゅ"],[35,1,"と"]],"text":"そこでイエスは、「この聖句は、あなたがたが耳にしたこの日に成就した」と説きはじめられた。"},{"ref":"Luke.4.22","start":42004022,"end":42004022,"break":"none","ruby":[[4,1,"かれ"],[20,1,"くち"],[23,1,"で"],[25,1,"く"],[31,2,"ことば"],[34,2,"かんたん"],[38,1,"い"],[45,1,"ひと"],[51,1,"こ"]],"text":"すると、彼らはみなイエスをほめ、またその口から出て来るめぐみの言葉に感嘆して言った、「この人はヨセフの子ではないか」。"},{"ref":"Luke.4.23","start":42004023,"end":42004023,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[23,2,"いしゃ"],[27,2,"じぶん"],[29,2,"じしん"],[44,1,"ひ"],[54,1,"おこな"],[59,1,"き"],[64,1,"こと"],[71,2,"きょうり"],[76,1,"ち"],[85,1,"い"]],"text":"そこで彼らに言われた、「あなたがたは、きっと『医者よ、自分自身をいやせ』ということわざを引いて、カペナウムで行われたと聞いていた事を、あなたの郷里のこの地でもしてくれ、と言うであろう」。"},{"ref":"Luke.4.24","start":42004024,"end":42004024,"break":"none","ruby":[[4,1,"い"],[12,1,"い"],[18,3,"よげんしゃ"],[23,2,"じぶん"],[26,2,"きょうり"],[30,2,"かんげい"]],"text":"それから言われた、「よく言っておく。預言者は、自分の郷里では歓迎されないものである。"},{"ref":"Luke.4.25","start":42004025,"end":42004025,"break":"none","ruby":[[2,1,"き"],[15,2,"じだい"],[20,1,"ねん"],[23,1,"げつ"],[29,1,"てん"],[31,1,"と"],[39,2,"ぜんど"],[42,1,"だい"],[50,1,"さい"],[56,1,"おお"]],"text":"よく聞いておきなさい。エリヤの時代に、三年六か月にわたって天が閉じ、イスラエル全土に大ききんがあった際、そこには多くのやもめがいたのに、"},{"ref":"Luke.4.26","start":42004026,"end":42004026,"break":"none","text":"エリヤはそのうちのだれにもつかわされないで、ただシドンのサレプタにいるひとりのやもめにだけつかわされた。"},{"ref":"Luke.4.27","start":42004027,"end":42004027,"break":"none","ruby":[[2,3,"よげんしゃ"],[10,2,"じだい"],[21,1,"おお"],[26,2,"びょうにん"]],"text":"また預言者エリシャの時代に、イスラエルには多くのらい病人がいたのに、そのうちのひとりもきよめられないで、ただシリヤのナアマンだけがきよめられた」。"},{"ref":"Luke.4.28","start":42004028,"end":42004028,"break":"none","ruby":[[0,2,"かいどう"],[5,1,"もの"],[12,1,"き"],[18,1,"いきどお"],[21,1,"み"]],"text":"会堂にいた者たちはこれを聞いて、みな憤りに満ち、"},{"ref":"Luke.4.29","start":42004029,"end":42004029,"break":"none","ruby":[[0,1,"た"],[2,1,"あ"],[10,1,"まち"],[12,1,"そと"],[14,1,"お"],[16,1,"だ"],[21,1,"まち"],[23,1,"た"],[28,1,"おか"],[39,1,"い"],[43,1,"つ"],[45,1,"おと"]],"text":"立ち上がってイエスを町の外へ追い出し、その町が建っている丘のがけまでひっぱって行って、突き落そうとした。"},{"ref":"Luke.4.30","start":42004030,"end":42004030,"break":"none","ruby":[[8,1,"かれ"],[13,1,"なか"],[15,1,"とお"],[17,1,"ぬ"],[21,1,"さ"],[24,1,"い"]],"text":"しかし、イエスは彼らのまん中を通り抜けて、去って行かれた。"},{"ref":"Luke.4.31","start":42004031,"end":42004031,"break":"paragraph","ruby":[[14,1,"まち"],[21,1,"くだ"],[24,1,"い"],[32,3,"あんそくにち"],[40,2,"ひとびと"],[44,1,"おし"]],"text":"それから、イエスはガリラヤの町カペナウムに下って行かれた。そして安息日になると、人々をお教えになったが、"},{"ref":"Luke.4.32","start":42004032,"end":42004032,"break":"none","ruby":[[2,2,"ことば"],[5,2,"けんい"],[14,1,"かれ"],[19,1,"おしえ"],[21,1,"おどろ"]],"text":"その言葉に権威があったので、彼らはその教に驚いた。"},{"ref":"Luke.4.33","start":42004033,"end":42004033,"break":"none","ruby":[[4,1,"けが"],[7,2,"あくれい"],[14,1,"ひと"],[16,2,"かいどう"],[22,2,"おおごえ"],[25,1,"さけ"],[27,1,"だ"]],"text":"すると、汚れた悪霊につかれた人が会堂にいて、大声で叫び出した、"},{"ref":"Luke.4.34","start":42004034,"end":42004034,"break":"none","ruby":[[26,1,"かか"],[42,1,"ほろ"],[75,1,"かみ"],[77,2,"せいじゃ"]],"text":"「ああ、ナザレのイエスよ、あなたはわたしたちとなんの係わりがあるのです。わたしたちを滅ぼしにこられたのですか。あなたがどなたであるか、わかっています。神の聖者です」。"},{"ref":"Luke.4.35","start":42004035,"end":42004035,"break":"none","ruby":[[13,1,"だま"],[18,1,"ひと"],[21,1,"で"],[23,1,"い"],[27,1,"い"],[35,2,"あくれい"],[38,1,"かれ"],[40,1,"ひと"],[44,1,"な"],[46,1,"たお"],[49,1,"きず"],[51,1,"お"],[59,1,"ひと"],[62,1,"で"],[64,1,"い"]],"text":"イエスはこれをしかって、「黙れ、この人から出て行け」と言われた。すると悪霊は彼を人なかに投げ倒し、傷は負わせずに、その人から出て行った。"},{"ref":"Luke.4.36","start":42004036,"end":42004036,"break":"none","ruby":[[4,1,"もの"],[6,1,"おどろ"],[10,1,"たがい"],[12,1,"かた"],[14,1,"あ"],[17,1,"い"],[36,2,"ことば"],[42,2,"けんい"],[45,1,"ちから"],[51,1,"けが"],[54,1,"れい"],[56,1,"めい"],[63,1,"かれ"],[66,1,"で"],[68,1,"い"]],"text":"みんなの者は驚いて、互に語り合って言った、「これは、いったい、なんという言葉だろう。権威と力とをもって汚れた霊に命じられると、彼らは出て行くのだ」。"},{"ref":"Luke.4.37","start":42004037,"end":42004037,"break":"none","ruby":[[8,2,"ひょうばん"],[14,2,"ちほう"],[20,1,"ところ"]],"text":"こうしてイエスの評判が、その地方のいたる所にひろまっていった。"},{"ref":"Luke.4.38","start":42004038,"end":42004038,"break":"paragraph","ruby":[[4,2,"かいどう"],[7,1,"で"],[13,1,"いえ"],[38,1,"たか"],[40,1,"ねつ"],[42,1,"や"],[50,2,"ひとびと"],[53,2,"かのじょ"],[64,1,"ねが"]],"text":"イエスは会堂を出てシモンの家におはいりになった。ところがシモンのしゅうとめが高い熱を病んでいたので、人々は彼女のためにイエスにお願いした。"},{"ref":"Luke.4.39","start":42004039,"end":42004039,"break":"none","ruby":[[16,1,"た"],[20,1,"ねつ"],[22,1,"ひ"],[27,1,"めい"],[34,1,"ねつ"],[36,1,"ひ"],[39,1,"おんな"],[44,1,"お"],[46,1,"あ"],[51,1,"かれ"]],"text":"そこで、イエスはそのまくらもとに立って、熱が引くように命じられると、熱は引き、女はすぐに起き上がって、彼らをもてなした。"},{"ref":"Luke.4.40","start":42004040,"end":42004040,"break":"paragraph","ruby":[[0,1,"ひ"],[2,1,"く"],[12,2,"びょうき"],[18,1,"もの"],[26,2,"ひとびと"],[30,1,"みな"],[42,1,"つ"],[59,1,"て"],[61,1,"お"]],"text":"日が暮れると、いろいろな病気になやむ者をかかえている人々が、皆それをイエスのところに連れてきたので、そのひとりびとりに手を置いて、おいやしになった。"},{"ref":"Luke.4.41","start":42004041,"end":42004041,"break":"none","ruby":[[0,2,"あくれい"],[9,1,"かみ"],[11,1,"こ"],[16,1,"さけ"],[21,1,"おお"],[24,2,"ひとびと"],[28,1,"で"],[42,1,"かれ"],[45,1,"いまし"],[49,1,"もの"],[51,1,"い"],[57,1,"ゆる"],[67,1,"かれ"],[80,1,"し"]],"text":"悪霊も「あなたこそ神の子です」と叫びながら多くの人々から出ていった。しかし、イエスは彼らを戒めて、物を言うことをお許しにならなかった。彼らがイエスはキリストだと知っていたからである。"},{"ref":"Luke.4.42","start":42004042,"end":42004042,"break":"paragraph","ruby":[[0,1,"よ"],[2,1,"あ"],[11,1,"さび"],[14,1,"ところ"],[16,1,"で"],[18,1,"い"],[24,2,"ぐんしゅう"],[27,1,"さが"],[38,1,"あつ"],[42,2,"じぶん"],[48,1,"はな"],[51,1,"い"],[61,1,"ひ"],[63,1,"と"]],"text":"夜が明けると、イエスは寂しい所へ出て行かれたが、群衆が捜しまわって、みもとに集まり、自分たちから離れて行かれないようにと、引き止めた。"},{"ref":"Luke.4.43","start":42004043,"end":42004043,"break":"none","ruby":[[17,2,"まちまち"],[21,1,"かみ"],[23,1,"くに"],[25,2,"ふくいん"],[28,1,"の"],[30,1,"つた"],[39,2,"じぶん"],[59,1,"い"]],"text":"しかしイエスは、「わたしは、ほかの町々にも神の国の福音を宣べ伝えねばならない。自分はそのためにつかわされたのである」と言われた。"},{"ref":"Luke.4.44","start":42004044,"end":42004044,"break":"none","ruby":[[8,1,"しょ"],[9,2,"かいどう"],[12,1,"おしえ"],[14,1,"と"]],"text":"そして、ユダヤの諸会堂で教を説かれた。"}]