[{"ref":"Isa.39.1","start":23039001,"end":23039001,"break":"paragraph","ruby":[[10,1,"こ"],[19,1,"おう"],[30,2,"てがみ"],[33,1,"おく"],[35,1,"もの"],[37,1,"も"],[41,2,"しせつ"],[63,2,"びょうき"],[71,1,"なお"],[77,1,"き"]],"text":"そのころ、バラダンの子であるバビロンの王メロダク・バラダンは手紙と贈り物を持たせて使節をヒゼキヤにつかわした。これはヒゼキヤが病気であったが、直ったことを聞いたからである。"},{"ref":"Isa.39.2","start":23039002,"end":23039002,"break":"none","ruby":[[5,1,"かれ"],[8,1,"よろこ"],[10,1,"むか"],[14,2,"ほうもつ"],[17,1,"くら"],[19,2,"きんぎん"],[22,2,"こうりょう"],[25,2,"きちょう"],[28,1,"あぶら"],[32,2,"ぶき"],[34,1,"くら"],[42,2,"そうこ"],[51,1,"もの"],[53,1,"かれ"],[56,1,"み"],[60,1,"いえ"],[64,1,"もの"],[67,1,"くに"],[71,1,"もの"],[79,1,"かれ"],[82,1,"み"],[86,1,"もの"]],"text":"ヒゼキヤは彼らを喜び迎えて、宝物の蔵、金銀、香料、貴重な油および武器倉、ならびにその倉庫にあるすべての物を彼らに見せた。家にある物も、国にある物も、ヒゼキヤが彼らに見せない物は一つもなかった。"},{"ref":"Isa.39.3","start":23039003,"end":23039003,"break":"none","ruby":[[0,1,"とき"],[2,3,"よげんしゃ"],[13,1,"おう"],[18,1,"き"],[20,1,"い"],[27,2,"ひとびと"],[30,1,"なに"],[32,1,"い"],[43,1,"き"],[56,1,"い"],[61,1,"かれ"],[64,1,"とお"],[66,1,"くに"],[80,1,"き"]],"text":"時に預言者イザヤはヒゼキヤ王のもとに来て言った、「あの人々は何を言いましたか。どこから来たのですか」。ヒゼキヤは言った、「彼らは遠い国から、すなわちバビロンから来たのです」。"},{"ref":"Isa.39.4","start":23039004,"end":23039004,"break":"none","ruby":[[4,1,"い"],[9,1,"かれ"],[17,1,"いえ"],[19,1,"なに"],[21,1,"み"],[33,1,"こた"],[36,1,"い"],[41,1,"かれ"],[49,1,"いえ"],[53,1,"もの"],[55,1,"みな"],[56,1,"み"],[61,2,"そうこ"],[69,1,"かれ"],[72,1,"み"],[78,1,"もの"]],"text":"イザヤは言った、「彼らは、あなたの家で何を見ましたか」。ヒゼキヤは答えて言った、「彼らは、わたしの家にある物を皆見ました。倉庫のうちには、彼らに見せなかった物は一つもありません」。"},{"ref":"Isa.39.5","start":23039005,"end":23039005,"break":"paragraph","ruby":[[12,1,"い"],[17,2,"ばんぐん"],[20,1,"しゅ"],[22,2,"ことば"],[25,1,"き"]],"text":"そこでイザヤはヒゼキヤに言った、「万軍の主の言葉を聞きなさい。"},{"ref":"Isa.39.6","start":23039006,"end":23039006,"break":"none","ruby":[[0,1,"み"],[10,1,"いえ"],[14,1,"もの"],[22,2,"せんぞ"],[27,2,"こんにち"],[32,1,"つ"],[39,1,"もの"],[46,1,"はこ"],[48,1,"さ"],[52,1,"ひ"],[54,1,"く"],[57,1,"なに"],[59,1,"のこ"],[68,1,"しゅ"],[70,1,"い"]],"text":"見よ、すべてあなたの家にある物およびあなたの先祖たちが今日までに積みたくわえた物がバビロンに運び去られる日が来る。何も残るものはない、と主が言われます。"},{"ref":"Isa.39.7","start":23039007,"end":23039007,"break":"none","ruby":[[7,1,"み"],[10,1,"で"],[16,1,"こ"],[20,1,"つ"],[22,1,"さ"],[32,1,"おう"],[34,2,"きゅうでん"],[40,2,"かんがん"]],"text":"また、あなたの身から出るあなたの子たちも連れ去られて、バビロンの王の宮殿において宦官となるでしょう」。"},{"ref":"Isa.39.8","start":23039008,"end":23039008,"break":"none","ruby":[[9,1,"い"],[18,1,"い"],[22,1,"しゅ"],[24,2,"ことば"],[27,2,"けっこう"],[33,1,"かれ"],[36,1,"すく"],[41,2,"じぶん"],[44,1,"よ"],[48,1,"あいだ"],[50,2,"たいへい"],[53,2,"あんぜん"],[63,1,"おも"]],"text":"ヒゼキヤはイザヤに言った、「あなたが言われた主の言葉は結構です」。彼は「少なくとも自分が世にある間は太平と安全があるだろう」と思ったからである。"}]