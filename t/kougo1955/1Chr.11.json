[{"ref":"1Chr.11.1","start":13011001,"end":13011001,"break":"paragraph","ruby":[[9,1,"ひと"],[11,1,"みな"],[26,1,"あつ"],[30,1,"き"],[32,1,"い"],[47,2,"こつにく"]],"text":"ここにイスラエルの人は皆ヘブロンにいるダビデのもとに集まって来て言った、「われわれは、あなたの骨肉です。"},{"ref":"1Chr.11.2","start":13011002,"end":13011002,"break":"none","ruby":[[0,1,"さき"],[6,1,"おう"],[11,1,"とき"],[25,1,"ひき"],[28,2,"でい"],[44,1,"かみ"],[46,1,"しゅ"],[59,1,"たみ"],[66,1,"ぼく"],[69,1,"もの"],[76,1,"たみ"],[83,1,"きみ"],[93,1,"い"]],"text":"先にサウルが王であった時にも、あなたはイスラエルを率いて出入りされました。そしてあなたの神、主はあなたに『あなたはわが民イスラエルを牧する者となり、わが民イスラエルの君となるであろう』と言われました」。"},{"ref":"1Chr.11.3","start":13011003,"end":13011003,"break":"none","ruby":[[11,2,"ちょうろう"],[14,1,"みな"],[22,1,"おう"],[27,1,"き"],[41,1,"しゅ"],[43,1,"まえ"],[45,1,"かれ"],[48,2,"けいやく"],[51,1,"むす"],[58,1,"かれ"],[70,1,"かた"],[74,1,"しゅ"],[76,2,"ことば"],[79,1,"したが"],[86,1,"あぶら"],[88,1,"そそ"],[97,1,"おう"]],"text":"このようにイスラエルの長老が皆ヘブロンにいる王のもとに来たので、ダビデはヘブロンで主の前に彼らと契約を結んだ。そして彼らは、サムエルによって語られた主の言葉に従ってダビデに油を注ぎ、イスラエルの王とした。"},{"ref":"1Chr.11.4","start":13011004,"end":13011004,"break":"paragraph","ruby":[[20,1,"い"],[48,1,"ち"],[50,2,"じゅうみん"]],"text":"ダビデとすべてのイスラエルはエルサレムへ行った。エルサレムはすなわちエブスであって、そこにはその地の住民であるエブスびとがいた。"},{"ref":"1Chr.11.5","start":13011005,"end":13011005,"break":"none","ruby":[[4,2,"じゅうみん"],[11,1,"い"],[46,2,"ようがい"],[49,1,"と"],[64,1,"まち"]],"text":"エブスの住民はダビデに言った、「あなたはここにはいってはならない」。しかし、ダビデはシオンの要害を取った。これがすなわちダビデの町である。"},{"ref":"1Chr.11.6","start":13011006,"end":13011006,"break":"none","ruby":[[2,1,"とき"],[7,1,"い"],[16,1,"だい"],[25,1,"う"],[27,1,"もの"],[36,1,"しょう"],[46,1,"こ"],[51,1,"だい"]],"text":"この時ダビデは言った、「だれでも第一にエブスびとを撃つ者を、かしらとし、将とする」。ゼルヤの子ヨアブが第一にのぼっていったので、かしらとなった。"},{"ref":"1Chr.11.7","start":13011007,"end":13011007,"break":"none","ruby":[[9,2,"ようがい"],[12,1,"す"],[17,2,"ひとびと"],[27,1,"まち"],[29,1,"な"]],"text":"そしてダビデがその要害に住んだので人々はこれをダビデの町と名づけた。"},{"ref":"1Chr.11.8","start":13011008,"end":13011008,"break":"none","ruby":[[8,1,"まち"],[10,2,"しゅうい"],[20,2,"しほう"],[23,1,"いし"],[27,1,"きず"],[34,1,"まち"],[39,2,"ぶぶん"],[42,1,"つくろ"]],"text":"ダビデはまたその町の周囲すなわちミロから四方に石がきを築き、ヨアブは町のほかの部分を繕った。"},{"ref":"1Chr.11.9","start":13011009,"end":13011009,"break":"none","ruby":[[12,1,"おお"],[16,1,"もの"],[22,2,"ばんぐん"],[25,1,"しゅ"],[27,1,"かれ"]],"text":"こうしてダビデはますます大いなる者となった。万軍の主が彼とともにおられたからである。"},{"ref":"1Chr.11.10","start":13011010,"end":13011010,"break":"paragraph","ruby":[[4,2,"ゆうし"],[13,1,"つぎ"],[22,1,"かれ"],[35,1,"ひと"],[44,1,"ちから"],[49,1,"くに"],[51,1,"え"],[55,1,"しゅ"],[66,1,"い"],[70,2,"ことば"],[79,1,"かれ"],[81,1,"おう"],[85,2,"ひとびと"]],"text":"ダビデの勇士のおもなものは次のとおりである。彼らはイスラエルのすべての人とともにダビデに力をそえて国を得させ、主がイスラエルについて言われた言葉にしたがって、彼を王とした人々である。"},{"ref":"1Chr.11.11","start":13011011,"end":13011011,"break":"none","ruby":[[4,2,"ゆうし"],[7,1,"かず"],[9,1,"つぎ"],[23,1,"にん"],[25,1,"ちょう"],[36,1,"こ"],[44,1,"かれ"],[55,1,"にん"],[57,1,"む"],[62,1,"ど"],[67,1,"ころ"],[70,1,"もの"]],"text":"ダビデの勇士の数は次のとおりである。すなわち三人の長であるハクモニびとの子ヤショベアム、彼はやりをふるって三百人に向かい、一度にこれを殺した者である。"},{"ref":"1Chr.11.12","start":13011012,"end":13011012,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"つぎ"],[12,1,"こ"],[21,2,"ゆうし"]],"text":"彼の次はアホアびとドドの子エレアザルで、三勇士のひとりである。"},{"ref":"1Chr.11.13","start":13011013,"end":13011013,"break":"none","ruby":[[0,1,"かれ"],[29,1,"あつ"],[33,1,"き"],[35,1,"たたか"],[42,2,"いちめん"],[45,2,"おおむぎ"],[51,2,"じしょ"],[58,1,"たみ"],[67,1,"まえ"],[70,1,"に"]],"text":"彼はダビデとともにパスダミムにいたが、ペリシテびとがそこに集まって来て戦った。そこに一面に大麦のはえた地所があった。民はペリシテびとの前から逃げた。"},{"ref":"1Chr.11.14","start":13011014,"end":13011014,"break":"none","ruby":[[3,1,"かれ"],[5,2,"じしょ"],[8,1,"なか"],[10,1,"た"],[16,1,"ふせ"],[26,1,"ころ"],[33,1,"しゅ"],[35,1,"おお"],[39,2,"しょうり"],[42,1,"あた"],[45,1,"かれ"],[48,1,"すく"]],"text":"しかし彼は地所の中に立ってこれを防ぎ、ペリシテびとを殺した。そして主は大いなる勝利を与えて彼らを救われた。"},{"ref":"1Chr.11.15","start":13011015,"end":13011015,"break":"paragraph","ruby":[[2,1,"にん"],[4,1,"ちょう"],[12,1,"にん"],[14,1,"くだ"],[30,1,"いわ"],[32,1,"ところ"],[43,1,"い"],[47,1,"とき"],[56,2,"ぐんぜい"],[64,1,"たに"],[66,1,"じん"],[68,1,"と"]],"text":"三十人の長たちのうちの三人は下っていってアドラムのほらあなの岩の所にいるダビデのもとへ行った。時にペリシテびとの軍勢はレパイムの谷に陣を取っていた。"},{"ref":"1Chr.11.16","start":13011016,"end":13011016,"break":"none","ruby":[[2,1,"とき"],[7,2,"ようがい"],[20,2,"せんじん"]],"text":"その時ダビデは要害におり、ペリシテびとの先陣はベツレヘムにあったが、"},{"ref":"1Chr.11.17","start":13011017,"end":13011017,"break":"none","ruby":[[7,1,"のぞ"],[21,1,"もん"],[30,2,"いど"],[33,1,"みず"],[39,1,"の"],[54,1,"い"]],"text":"ダビデはせつに望んで、「だれかベツレヘムの門のかたわらにある井戸の水をわたしに飲ませてくれるとよいのだが」と言った。"},{"ref":"1Chr.11.18","start":13011018,"end":13011018,"break":"none","ruby":[[6,1,"にん"],[15,1,"じん"],[17,1,"つ"],[19,1,"とお"],[29,1,"もん"],[38,2,"いど"],[41,1,"みず"],[45,1,"と"],[56,1,"たずさ"],[59,1,"き"],[72,1,"の"],[83,1,"しゅ"],[85,1,"まえ"],[87,1,"そそ"]],"text":"そこでその三人はペリシテびとの陣を突き通って、ベツレヘムの門のかたわらにある井戸の水をくみ取って、ダビデのもとに携えて来た。しかしダビデはそれを飲もうとはせず、それを主の前に注いで、"},{"ref":"1Chr.11.19","start":13011019,"end":13011019,"break":"none","ruby":[[0,1,"い"],[7,1,"かみ"],[14,1,"だん"],[27,1,"いのち"],[32,1,"い"],[37,1,"ひと"],[41,1,"ち"],[51,1,"の"],[63,1,"かれ"],[66,1,"いのち"],[73,1,"みず"],[78,1,"き"],[96,1,"みず"],[98,1,"の"],[110,2,"ゆうし"]],"text":"言った、「わが神よ、わたしは断じてこれをいたしません。命をかけて行ったこの人たちの血をどうしてわたしは飲むことができましょう。彼らは命をかけてこの水をとって来たのです」。それゆえ、ダビデはこの水を飲もうとはしなかった。三勇士はこのことをおこなった。"},{"ref":"1Chr.11.20","start":13011020,"end":13011020,"break":"paragraph","ruby":[[4,2,"きょうだい"],[14,1,"にん"],[16,1,"ちょう"],[22,1,"かれ"],[33,1,"にん"],[35,1,"た"],[37,1,"む"],[44,1,"ころ"],[48,1,"にん"],[53,1,"な"],[55,1,"え"]],"text":"ヨアブの兄弟アビシャイは三十人の長であった。彼はやりをふるって三百人に立ち向かい、これを殺して三人のほかに名を得た。"},{"ref":"1Chr.11.21","start":13011021,"end":13011021,"break":"none","ruby":[[0,1,"かれ"],[4,1,"にん"],[9,1,"もっと"],[11,1,"たっと"],[15,1,"もの"],[18,1,"かれ"],[36,1,"にん"],[39,1,"およ"]],"text":"彼は三十人のうち、最も尊ばれた者で、彼らのかしらとなった。しかし、かの三人には及ばなかった。"},{"ref":"1Chr.11.22","start":13011022,"end":13011022,"break":"paragraph","ruby":[[5,1,"こ"],[16,2,"しゅっしん"],[19,2,"ゆうし"],[26,1,"おお"],[33,1,"た"],[37,1,"かれ"],[52,1,"こ"],[54,1,"う"],[56,1,"ころ"],[60,1,"かれ"],[64,1,"ゆき"],[66,1,"ひ"],[68,1,"くだ"],[75,1,"あな"],[77,1,"なか"],[82,1,"う"],[84,1,"ころ"]],"text":"エホヤダの子ベナヤは、カブジエル出身の勇士であって、多くのてがらを立てた。彼はモアブのアリエルのふたりの子を撃ち殺した。彼はまた雪の日に下っていって、穴の中でししを撃ち殺した。"},{"ref":"1Chr.11.23","start":13011023,"end":13011023,"break":"none","ruby":[[0,1,"かれ"],[4,1,"み"],[24,1,"う"],[26,1,"ころ"],[39,1,"て"],[41,1,"はた"],[43,2,"まきぼう"],[51,1,"も"],[68,1,"かれ"],[70,1,"ところ"],[72,1,"くだ"],[75,1,"い"],[85,1,"て"],[105,1,"かれ"],[107,1,"ころ"]],"text":"彼はまた身のたけ五キュビトばかりのエジプトびとを撃ち殺した。そのエジプトびとは手に機の巻棒ほどのやりを持っていたが、ベナヤはつえをとって彼の所へ下って行き、エジプトびとの手から、やりをもぎとり、そのやりをもって彼を殺した。"},{"ref":"1Chr.11.24","start":13011024,"end":13011024,"break":"none","ruby":[[5,1,"こ"],[15,1,"こと"],[17,1,"い"],[21,2,"ゆうし"],[27,1,"な"],[29,1,"え"]],"text":"エホヤダの子ベナヤは、これらの事を行って三勇士のほかに名を得た。"},{"ref":"1Chr.11.25","start":13011025,"end":13011025,"break":"none","ruby":[[0,1,"かれ"],[4,1,"にん"],[9,2,"ゆうめい"],[20,1,"にん"],[23,1,"およ"],[34,1,"かれ"],[36,2,"じえい"],[39,1,"ちょう"]],"text":"彼は三十人のうちに有名であったが、かの三人には及ばなかった。ダビデは彼を侍衛の長とした。"},{"ref":"1Chr.11.26","start":13011026,"end":13011026,"break":"paragraph","ruby":[[0,2,"ぐんだん"],[6,2,"ゆうし"],[13,2,"きょうだい"],[25,2,"しゅっしん"],[31,1,"こ"]],"text":"軍団のうちの勇士はヨアブの兄弟アサヘル。ベツレヘム出身のドドの子エルハナン。"},{"ref":"1Chr.11.27","start":13011027,"end":13011027,"break":"none","ruby":[[3,2,"しゅっしん"]],"text":"ハロデ出身のシャンマ。ペロンびとヘレヅ。"},{"ref":"1Chr.11.28","start":13011028,"end":13011028,"break":"none","ruby":[[3,2,"しゅっしん"],[11,1,"こ"],[19,2,"しゅっしん"]],"text":"テコア出身のイッケシの子イラ。アナトテ出身のアビエゼル。"},{"ref":"1Chr.11.29","start":13011029,"end":13011029,"break":"none","text":"ホシャテびとシベカイ。アホアびとイライ。"},{"ref":"1Chr.11.30","start":13011030,"end":13011030,"break":"none","ruby":[[3,2,"しゅっしん"],[14,2,"しゅっしん"],[21,1,"こ"]],"text":"ネトパ出身のマハライ。ネトパ出身のバアナの子ヘレデ。"},{"ref":"1Chr.11.31","start":13011031,"end":13011031,"break":"none","ruby":[[13,1,"で"],[19,1,"こ"]],"text":"ベニヤミンびとのギベアから出たリバイの子イタイ。ピラトンのベナヤ。"},{"ref":"1Chr.11.32","start":13011032,"end":13011032,"break":"none","ruby":[[4,1,"たに"]],"text":"ガアシの谷のホライ。アルバテびとアビエル。"},{"ref":"1Chr.11.33","start":13011033,"end":13011033,"break":"none","ruby":[[4,2,"しゅっしん"],[18,2,"しゅっしん"]],"text":"バハルム出身のアズマウテ。シャルボン出身のエリヤバ。"},{"ref":"1Chr.11.34","start":13011034,"end":13011034,"break":"none","ruby":[[18,1,"こ"]],"text":"ギゾンびとハセム。ハラルびとシャゲの子ヨナタン。"},{"ref":"1Chr.11.35","start":13011035,"end":13011035,"break":"none","ruby":[[9,1,"こ"],[18,1,"こ"]],"text":"ハラルびとサカルの子アヒアム。ウルの子エリパル。"},{"ref":"1Chr.11.36","start":13011036,"end":13011036,"break":"none","text":"メケラテびとヘペル。ペロンびとアヒヤ。"},{"ref":"1Chr.11.37","start":13011037,"end":13011037,"break":"none","ruby":[[4,2,"しゅっしん"],[16,1,"こ"]],"text":"カルメル出身のヘズロ。エズバイの子ナアライ。"},{"ref":"1Chr.11.38","start":13011038,"end":13011038,"break":"none","ruby":[[4,2,"きょうだい"],[14,1,"こ"]],"text":"ナタンの兄弟ヨエル。ハグリの子ミブハル。"},{"ref":"1Chr.11.39","start":13011039,"end":13011039,"break":"none","ruby":[[14,1,"こ"],[19,2,"ぶき"],[22,1,"と"],[31,2,"しゅっしん"]],"text":"アンモンびとゼレク。ゼルヤの子ヨアブの武器を執るもの、ベエロテ出身のナハライ。"},{"ref":"1Chr.11.40","start":13011040,"end":13011040,"break":"none","text":"イテルびとイラ。イテルびとガレブ。"},{"ref":"1Chr.11.41","start":13011041,"end":13011041,"break":"none","ruby":[[13,1,"こ"]],"text":"ヘテびとウリヤ。アハライの子ザバデ。"},{"ref":"1Chr.11.42","start":13011042,"end":13011042,"break":"none","ruby":[[8,1,"こ"],[13,1,"かれ"],[21,1,"ちょう"],[29,1,"にん"],[31,1,"ひき"]],"text":"ルベンびとシザの子アデナ。彼はルベンびとの長であって、三十人を率いた。"},{"ref":"1Chr.11.43","start":13011043,"end":13011043,"break":"none","ruby":[[6,1,"こ"]],"text":"またマアカの子ハナン。ミテニびとヨシャパテ。"},{"ref":"1Chr.11.44","start":13011044,"end":13011044,"break":"none","ruby":[[21,1,"こ"]],"text":"アシテラテびとウジヤ。アロエルびとホタムの子らシャマとエイエル。"},{"ref":"1Chr.11.45","start":13011045,"end":13011045,"break":"none","ruby":[[8,1,"こ"],[19,2,"きょうだい"]],"text":"テジびとシムリの子エデアエルおよびその兄弟ヨハ。"},{"ref":"1Chr.11.46","start":13011046,"end":13011046,"break":"none","ruby":[[16,1,"こ"]],"text":"マハブびとエリエル。エルナアムの子らエリバイおよびヨシャビヤ。モアブびとイテマ。"},{"ref":"1Chr.11.47","start":13011047,"end":13011047,"break":"none","text":"エリエル、オベデおよびメゾバびとヤシエルである。"}]