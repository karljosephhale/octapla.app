[{"ref":"John.5.1","start":43005001,"end":43005001,"break":"paragraph","ruby":[[8,1,"じん"],[10,1,"まつり"],[28,1,"のぼ"]],"text":"こののち、ユダヤ人の祭があったので、イエスはエルサレムに上られた。"},{"ref":"John.5.2","start":43005002,"end":43005002,"break":"paragraph","ruby":[[8,1,"ひつじ"],[10,1,"もん"],[19,1,"ご"],[26,1,"よ"],[30,1,"いけ"],[43,1,"ろう"]],"text":"エルサレムにある羊の門のそばに、ヘブル語でベテスダと呼ばれる池があった。そこには五つの廊があった。"},{"ref":"John.5.3","start":43005003,"end":43005003,"break":"none","ruby":[[2,1,"ろう"],[4,1,"なか"],[8,2,"びょうにん"],[11,2,"もうじん"],[14,1,"あし"],[20,1,"おとろ"],[23,1,"もの"],[28,1,"おお"],[35,1,"よこ"],[43,1,"かれ"],[46,1,"みず"],[48,1,"うご"],[52,1,"ま"]],"text":"その廊の中には、病人、盲人、足なえ、やせ衰えた者などが、大ぜいからだを横たえていた。〔彼らは水の動くのを待っていたのである。"},{"ref":"John.5.4","start":43005004,"end":43005004,"break":"none","ruby":[[4,2,"ときどき"],[7,1,"しゅ"],[9,2,"みつかい"],[14,1,"いけ"],[16,1,"お"],[21,1,"みず"],[23,1,"うご"],[33,1,"みず"],[35,1,"うご"],[38,1,"とき"],[41,1,"さき"],[46,1,"もの"],[52,2,"びょうき"]],"text":"それは、時々、主の御使がこの池に降りてきて水を動かすことがあるが、水が動いた時まっ先にはいる者は、どんな病気にかかっていても、いやされたからである。〕"},{"ref":"John.5.5","start":43005005,"end":43005005,"break":"none","ruby":[[9,1,"ねん"],[15,2,"びょうき"],[18,1,"なや"],[23,1,"ひと"]],"text":"さて、そこに三十八年のあいだ、病気に悩んでいる人があった。"},{"ref":"John.5.6","start":43005006,"end":43005006,"break":"none","ruby":[[6,1,"ひと"],[8,1,"よこ"],[17,1,"み"],[21,1,"なが"],[23,1,"あいだ"],[33,1,"し"],[39,1,"ひと"],[51,1,"い"]],"text":"イエスはその人が横になっているのを見、また長い間わずらっていたのを知って、その人に「なおりたいのか」と言われた。"},{"ref":"John.5.7","start":43005007,"end":43005007,"break":"none","ruby":[[2,2,"びょうにん"],[9,1,"こた"],[14,1,"しゅ"],[17,1,"みず"],[19,1,"うご"],[21,1,"とき"],[28,1,"いけ"],[30,1,"なか"],[32,1,"い"],[38,1,"ひと"],[60,1,"ひと"],[62,1,"さき"],[64,1,"お"],[67,1,"い"]],"text":"この病人はイエスに答えた、「主よ、水が動く時に、わたしを池の中に入れてくれる人がいません。わたしがはいりかけると、ほかの人が先に降りて行くのです」。"},{"ref":"John.5.8","start":43005008,"end":43005008,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[12,1,"お"],[20,1,"とこ"],[22,1,"と"],[30,1,"ある"]],"text":"イエスは彼に言われた、「起きて、あなたの床を取りあげ、そして歩きなさい」。"},{"ref":"John.5.9","start":43005009,"end":43005009,"break":"none","breaks":[[30,"paragraph"]],"ruby":[[6,1,"ひと"],[16,1,"とこ"],[23,1,"ある"],[26,1,"い"],[32,1,"ひ"],[34,3,"あんそくにち"]],"text":"すると、この人はすぐにいやされ、床をとりあげて歩いて行った。その日は安息日であった。"},{"ref":"John.5.10","start":43005010,"end":43005010,"break":"none","ruby":[[6,1,"じん"],[18,1,"ひと"],[20,1,"い"],[29,3,"あんそくにち"],[34,1,"とこ"],[36,1,"と"]],"text":"そこでユダヤ人たちは、そのいやされた人に言った、「きょうは安息日だ。床を取りあげるのは、よろしくない」。"},{"ref":"John.5.11","start":43005011,"end":43005011,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こた"],[15,1,"くだ"],[23,1,"とこ"],[25,1,"と"],[30,1,"ある"],[38,1,"い"]],"text":"彼は答えた、「わたしをなおして下さったかたが、床を取りあげて歩けと、わたしに言われました」。"},{"ref":"John.5.12","start":43005012,"end":43005012,"break":"none","ruby":[[0,1,"かれ"],[3,1,"たず"],[8,1,"と"],[13,1,"ある"],[16,1,"い"],[19,1,"ひと"]],"text":"彼らは尋ねた、「取りあげて歩けと言った人は、だれか」。"},{"ref":"John.5.13","start":43005013,"end":43005013,"break":"none","ruby":[[11,1,"ひと"],[23,1,"し"],[30,2,"ぐんしゅう"],[35,1,"ば"],[49,1,"で"],[51,1,"い"]],"text":"しかし、このいやされた人は、それがだれであるか知らなかった。群衆がその場にいたので、イエスはそっと出て行かれたからである。"},{"ref":"John.5.14","start":43005014,"end":43005014,"break":"none","ruby":[[9,1,"みや"],[13,1,"ひと"],[15,2,"であ"],[22,1,"かれ"],[24,1,"い"],[46,1,"つみ"],[48,1,"おか"],[57,1,"なに"],[62,1,"わる"],[72,1,"み"],[74,1,"おこ"],[78,1,"し"]],"text":"そののち、イエスは宮でその人に出会ったので、彼に言われた、「ごらん、あなたはよくなった。もう罪を犯してはいけない。何かもっと悪いことが、あなたの身に起るかも知れないから」。"},{"ref":"John.5.15","start":43005015,"end":43005015,"break":"none","ruby":[[0,1,"かれ"],[2,1,"で"],[4,1,"い"],[8,2,"じぶん"],[29,1,"じん"],[33,1,"つ"]],"text":"彼は出て行って、自分をいやしたのはイエスであったと、ユダヤ人たちに告げた。"},{"ref":"John.5.16","start":43005016,"end":43005016,"break":"none","ruby":[[7,1,"じん"],[12,3,"あんそくにち"],[27,1,"い"],[35,1,"せ"]],"text":"そのためユダヤ人たちは、安息日にこのようなことをしたと言って、イエスを責めた。"},{"ref":"John.5.17","start":43005017,"end":43005017,"break":"none","ruby":[[8,1,"かれ"],[11,1,"こた"],[22,1,"ちち"],[24,1,"いま"],[26,1,"いた"],[30,1,"はたら"],[42,1,"はたら"]],"text":"そこで、イエスは彼らに答えられた、「わたしの父は今に至るまで働いておられる。わたしも働くのである」。"},{"ref":"John.5.18","start":43005018,"end":43005018,"break":"none","ruby":[[8,1,"じん"],[21,1,"ころ"],[25,1,"はか"],[42,3,"あんそくにち"],[46,1,"やぶ"],[58,1,"かみ"],[60,2,"じぶん"],[63,1,"ちち"],[65,1,"よ"],[69,2,"じぶん"],[72,1,"かみ"],[74,1,"ひと"]],"text":"このためにユダヤ人たちは、ますますイエスを殺そうと計るようになった。それは、イエスが安息日を破られたばかりではなく、神を自分の父と呼んで、自分を神と等しいものとされたからである。"},{"ref":"John.5.19","start":43005019,"end":43005019,"break":"paragraph","ruby":[[7,1,"かれ"],[10,1,"こた"],[13,1,"い"],[29,1,"い"],[35,1,"こ"],[37,1,"ちち"],[45,1,"み"],[49,2,"いがい"],[53,2,"じぶん"],[58,2,"なにごと"],[71,1,"ちち"],[86,1,"こ"]],"text":"さて、イエスは彼らに答えて言われた、「よくよくあなたがたに言っておく。子は父のなさることを見てする以外に、自分からは何事もすることができない。父のなさることであればすべて、子もそのとおりにするのである。"},{"ref":"John.5.20","start":43005020,"end":43005020,"break":"none","ruby":[[5,1,"ちち"],[7,1,"こ"],[9,1,"あい"],[27,1,"こ"],[30,1,"しめ"],[52,1,"おお"],[60,1,"しめ"],[83,3,"ふしぎ"],[87,1,"おも"]],"text":"なぜなら、父は子を愛して、みずからなさることは、すべて子にお示しになるからである。そして、それよりもなお大きなわざを、お示しになるであろう。あなたがたが、それによって不思議に思うためである。"},{"ref":"John.5.21","start":43005021,"end":43005021,"break":"none","ruby":[[5,1,"ちち"],[7,2,"しにん"],[10,1,"おこ"],[13,1,"いのち"],[16,1,"あた"],[25,1,"こ"],[39,2,"ひとびと"],[42,1,"いのち"],[44,1,"あた"]],"text":"すなわち、父が死人を起して命をお与えになるように、子もまた、そのこころにかなう人々に命を与えるであろう。"},{"ref":"John.5.22","start":43005022,"end":43005022,"break":"none","ruby":[[0,1,"ちち"],[23,1,"こ"]],"text":"父はだれをもさばかない。さばきのことはすべて、子にゆだねられたからである。"},{"ref":"John.5.23","start":43005023,"end":43005023,"break":"none","ruby":[[8,1,"ひと"],[10,1,"ちち"],[12,1,"うやま"],[15,2,"どうよう"],[19,1,"こ"],[21,1,"うやま"],[29,1,"こ"],[31,1,"うやま"],[35,1,"もの"],[38,1,"こ"],[46,1,"ちち"],[49,1,"うやま"]],"text":"それは、すべての人が父を敬うと同様に、子を敬うためである。子を敬わない者は、子をつかわされた父をも敬わない。"},{"ref":"John.5.24","start":43005024,"end":43005024,"break":"none","ruby":[[10,1,"い"],[20,2,"ことば"],[23,1,"き"],[40,1,"しん"],[43,1,"もの"],[46,2,"えいえん"],[49,1,"いのち"],[51,1,"う"],[67,1,"し"],[70,1,"いのち"],[72,1,"うつ"]],"text":"よくよくあなたがたに言っておく。わたしの言葉を聞いて、わたしをつかわされたかたを信じる者は、永遠の命を受け、またさばかれることがなく、死から命に移っているのである。"},{"ref":"John.5.25","start":43005025,"end":43005025,"break":"none","ruby":[[10,1,"い"],[16,1,"し"],[19,1,"ひと"],[24,1,"かみ"],[26,1,"こ"],[28,1,"こえ"],[30,1,"き"],[32,1,"とき"],[34,1,"く"],[37,1,"いま"],[49,1,"き"],[51,1,"ひと"],[53,1,"い"]],"text":"よくよくあなたがたに言っておく。死んだ人たちが、神の子の声を聞く時が来る。今すでにきている。そして聞く人は生きるであろう。"},{"ref":"John.5.26","start":43005026,"end":43005026,"break":"none","ruby":[[4,1,"ちち"],[7,2,"じぶん"],[13,2,"せいめい"],[17,1,"も"],[26,2,"どうよう"],[30,1,"こ"],[36,2,"じぶん"],[42,2,"せいめい"],[45,1,"も"],[51,1,"ゆる"]],"text":"それは、父がご自分のうちに生命をお持ちになっていると同様に、子にもまた、自分のうちに生命を持つことをお許しになったからである。"},{"ref":"John.5.27","start":43005027,"end":43005027,"break":"none","ruby":[[3,1,"こ"],[5,1,"ひと"],[7,1,"こ"],[14,1,"こ"],[20,1,"おこな"],[22,2,"けんい"],[26,1,"あた"]],"text":"そして子は人の子であるから、子にさばきを行う権威をお与えになった。"},{"ref":"John.5.28","start":43005028,"end":43005028,"break":"none","ruby":[[5,1,"おどろ"],[9,1,"およ"],[14,1,"はか"],[16,1,"なか"],[20,1,"もの"],[26,1,"かみ"],[28,1,"こ"],[30,1,"こえ"],[32,1,"き"]],"text":"このことを驚くには及ばない。墓の中にいる者たちがみな神の子の声を聞き、"},{"ref":"John.5.29","start":43005029,"end":43005029,"break":"none","ruby":[[0,1,"ぜん"],[7,2,"ひとびと"],[11,2,"せいめい"],[14,1,"う"],[26,1,"あく"],[33,2,"ひとびと"],[41,1,"う"],[58,1,"で"],[62,1,"とき"],[64,1,"く"]],"text":"善をおこなった人々は、生命を受けるためによみがえり、悪をおこなった人々は、さばきを受けるためによみがえって、それぞれ出てくる時が来るであろう。"},{"ref":"John.5.30","start":43005030,"end":43005030,"break":"paragraph","ruby":[[5,2,"じぶん"],[10,2,"なにごと"],[25,1,"き"],[52,1,"ただ"],[63,2,"じしん"],[66,1,"かんが"],[92,1,"むね"],[94,1,"もと"]],"text":"わたしは、自分からは何事もすることができない。ただ聞くままにさばくのである。そして、わたしのこのさばきは正しい。それは、わたし自身の考えでするのではなく、わたしをつかわされたかたの、み旨を求めているからである。"},{"ref":"John.5.31","start":43005031,"end":43005031,"break":"none","ruby":[[7,2,"じぶん"],[9,2,"じしん"]],"text":"もし、わたしが自分自身についてあかしをするならば、わたしのあかしはほんとうではない。"},{"ref":"John.5.32","start":43005032,"end":43005032,"break":"none","ruby":[[28,1,"ひと"],[51,1,"し"]],"text":"わたしについてあかしをするかたはほかにあり、そして、その人がするあかしがほんとうであることを、わたしは知っている。"},{"ref":"John.5.33","start":43005033,"end":43005033,"break":"none","ruby":[[13,1,"ひと"],[26,1,"かれ"],[28,2,"しんり"]],"text":"あなたがたはヨハネのもとへ人をつかわしたが、そのとき彼は真理についてあかしをした。"},{"ref":"John.5.34","start":43005034,"end":43005034,"break":"none","ruby":[[4,1,"ひと"],[11,1,"う"],[22,1,"い"],[33,1,"すく"]],"text":"わたしは人からあかしを受けないが、このことを言うのは、あなたがたが救われるためである。"},{"ref":"John.5.35","start":43005035,"end":43005035,"break":"none","ruby":[[4,1,"も"],[7,1,"かがや"],[29,1,"あいだ"],[32,1,"ひかり"],[34,1,"よろこ"],[36,1,"たの"]],"text":"ヨハネは燃えて輝くあかりであった。あなたがたは、しばらくの間その光を喜び楽しもうとした。"},{"ref":"John.5.36","start":43005036,"end":43005036,"break":"none","ruby":[[24,1,"ちから"],[34,1,"ちち"],[40,2,"じょうじゅ"],[50,1,"あた"],[64,1,"いま"],[79,1,"ちち"]],"text":"しかし、わたしには、ヨハネのあかしよりも、もっと力あるあかしがある。父がわたしに成就させようとしてお与えになったわざ、すなわち、今わたしがしているこのわざが、父のわたしをつかわされたことをあかししている。"},{"ref":"John.5.37","start":43005037,"end":43005037,"break":"none","ruby":[[13,1,"ちち"],[17,2,"じぶん"],[47,1,"こえ"],[49,1,"き"],[61,1,"すがた"],[63,1,"み"]],"text":"また、わたしをつかわされた父も、ご自分でわたしについてあかしをされた。あなたがたは、まだそのみ声を聞いたこともなく、そのみ姿を見たこともない。"},{"ref":"John.5.38","start":43005038,"end":43005038,"break":"none","ruby":[[3,1,"かみ"],[11,1,"もの"],[13,1,"しん"],[20,1,"かみ"],[22,2,"みことば"]],"text":"また、神がつかわされた者を信じないから、神の御言はあなたがたのうちにとどまっていない。"},{"ref":"John.5.39","start":43005039,"end":43005039,"break":"none","ruby":[[7,2,"せいしょ"],[10,1,"なか"],[12,2,"えいえん"],[15,1,"いのち"],[20,1,"おも"],[23,1,"しら"],[32,2,"せいしょ"]],"text":"あなたがたは、聖書の中に永遠の命があると思って調べているが、この聖書は、わたしについてあかしをするものである。"},{"ref":"John.5.40","start":43005040,"end":43005040,"break":"none","ruby":[[11,1,"いのち"],[13,1,"え"]],"text":"しかも、あなたがたは、命を得るためにわたしのもとにこようともしない。"},{"ref":"John.5.41","start":43005041,"end":43005041,"break":"none","ruby":[[4,1,"ひと"],[8,1,"ほまれ"],[10,1,"う"]],"text":"わたしは人からの誉を受けることはしない。"},{"ref":"John.5.42","start":43005042,"end":43005042,"break":"none","ruby":[[14,1,"かみ"],[16,1,"あい"],[19,1,"あい"],[26,1,"し"]],"text":"しかし、あなたがたのうちには神を愛する愛がないことを知っている。"},{"ref":"John.5.43","start":43005043,"end":43005043,"break":"none","ruby":[[4,1,"ちち"],[6,1,"な"],[26,1,"う"],[39,1,"ひと"],[41,1,"かれ"],[42,2,"じしん"],[45,1,"な"],[50,1,"く"],[58,1,"ひと"],[60,1,"う"]],"text":"わたしは父の名によってきたのに、あなたがたはわたしを受けいれない。もし、ほかの人が彼自身の名によって来るならば、その人を受けいれるのであろう。"},{"ref":"John.5.44","start":43005044,"end":43005044,"break":"none","ruby":[[0,1,"たがい"],[2,1,"ほまれ"],[4,1,"う"],[16,1,"かみ"],[20,1,"ほまれ"],[22,1,"もと"],[41,1,"しん"]],"text":"互に誉を受けながら、ただひとりの神からの誉を求めようとしないあなたがたは、どうして信じることができようか。"},{"ref":"John.5.45","start":43005045,"end":43005045,"break":"none","ruby":[[13,1,"ちち"],[15,1,"うった"],[20,1,"かんが"],[35,1,"うった"],[38,1,"もの"],[47,1,"たの"],[59,1,"ひと"]],"text":"わたしがあなたがたのことを父に訴えると、考えてはいけない。あなたがたを訴える者は、あなたがたが頼みとしているモーセその人である。"},{"ref":"John.5.46","start":43005046,"end":43005046,"break":"none","ruby":[[13,1,"しん"],[25,1,"しん"],[45,1,"か"]],"text":"もし、あなたがたがモーセを信じたならば、わたしをも信じたであろう。モーセは、わたしについて書いたのである。"},{"ref":"John.5.47","start":43005047,"end":43005047,"break":"none","ruby":[[8,1,"か"],[14,1,"しん"],[30,2,"ことば"],[33,1,"しん"]],"text":"しかし、モーセの書いたものを信じないならば、どうしてわたしの言葉を信じるだろうか」。"}]