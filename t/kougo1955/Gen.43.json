[{"ref":"Gen.43.1","start":1043001,"end":1043001,"break":"paragraph","ruby":[[6,1,"ち"],[8,1,"はげ"]],"text":"ききんはその地に激しかった。"},{"ref":"Gen.43.2","start":1043002,"end":1043002,"break":"none","ruby":[[0,1,"かれ"],[9,1,"たずさ"],[14,2,"こくもつ"],[17,1,"く"],[19,1,"つく"],[22,1,"とき"],[24,1,"ちち"],[26,1,"かれ"],[29,1,"い"],[36,1,"い"],[48,1,"すこ"],[51,2,"しょくりょう"],[54,1,"か"]],"text":"彼らがエジプトから携えてきた穀物を食い尽した時、父は彼らに言った、「また行って、われわれのために少しの食糧を買ってきなさい」。"},{"ref":"Gen.43.3","start":1043003,"end":1043003,"break":"none","ruby":[[3,1,"ちち"],[5,1,"こた"],[8,1,"い"],[15,1,"ひと"],[26,1,"いまし"],[30,1,"おとうと"],[32,2,"いっしょ"],[44,1,"かお"],[46,1,"み"],[54,1,"い"]],"text":"ユダは父に答えて言った、「あの人はわれわれをきびしく戒めて、弟が一緒でなければ、わたしの顔を見てはならないと言いました。"},{"ref":"Gen.43.4","start":1043004,"end":1043004,"break":"none","ruby":[[6,1,"おとうと"],[13,2,"いっしょ"],[31,1,"くだ"],[34,1,"い"],[45,2,"しょくりょう"],[48,1,"か"]],"text":"もしあなたが弟をわれわれと一緒にやってくださるなら、われわれは下って行って、あなたのために食糧を買ってきましょう。"},{"ref":"Gen.43.5","start":1043005,"end":1043005,"break":"none","ruby":[[6,1,"かれ"],[21,1,"くだ"],[24,1,"い"],[32,1,"ひと"],[40,1,"おとうと"],[42,2,"いっしょ"],[53,1,"かお"],[55,1,"み"],[63,1,"い"]],"text":"しかし、もし彼をやられないなら、われわれは下って行きません。あの人がわれわれに、弟が一緒でなければわたしの顔を見てはならないと言ったのですから」。"},{"ref":"Gen.43.6","start":1043006,"end":1043006,"break":"none","ruby":[[6,1,"い"],[20,1,"おとうと"],[27,1,"ひと"],[29,1,"い"],[37,1,"くる"]],"text":"イスラエルは言った、「なぜ、もうひとりの弟があるとあの人に言って、わたしを苦しめるのか」。"},{"ref":"Gen.43.7","start":1043007,"end":1043007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[10,1,"ひと"],[17,2,"いちぞく"],[24,1,"と"],[31,1,"ちち"],[35,1,"い"],[48,1,"おとうと"],[54,1,"い"],[60,1,"と"],[67,1,"こた"],[76,1,"ひと"],[79,1,"おとうと"],[81,1,"つ"],[87,1,"い"],[97,1,"し"]],"text":"彼らは言った、「あの人がわれわれと一族とのことを問いただして、父はまだ生きているか、もうひとりの弟があるかと言ったので、問われるままに答えましたが、その人が、弟を連れてこいと言おうとは、どうして知ることができたでしょう」。"},{"ref":"Gen.43.8","start":1043008,"end":1043008,"break":"none","ruby":[[3,1,"ちち"],[10,1,"い"],[17,1,"こ"],[23,2,"いっしょ"],[40,1,"た"],[43,1,"い"],[68,2,"こども"],[72,1,"い"],[79,1,"し"],[81,1,"まぬか"]],"text":"ユダは父イスラエルに言った、「あの子をわたしと一緒にやってくだされば、われわれは立って行きましょう。そしてわれわれもあなたも、われわれの子供らも生きながらえ、死を免れましょう。"},{"ref":"Gen.43.9","start":1043009,"end":1043009,"break":"none","ruby":[[4,1,"かれ"],[6,1,"み"],[8,1,"う"],[10,1,"あ"],[19,1,"て"],[22,1,"かれ"],[24,1,"もと"],[36,1,"かれ"],[45,1,"つ"],[47,1,"かえ"],[55,1,"まえ"],[57,1,"お"],[73,1,"たい"],[76,2,"えいきゅう"],[79,1,"つみ"],[81,1,"お"]],"text":"わたしが彼の身を請け合います。わたしの手から彼を求めなさい。もしわたしが彼をあなたのもとに連れ帰って、あなたの前に置かなかったら、わたしはあなたに対して永久に罪を負いましょう。"},{"ref":"Gen.43.10","start":1043010,"end":1043010,"break":"none","ruby":[[21,1,"いま"],[26,1,"ど"],[28,1,"い"]],"text":"もしわれわれがこんなにためらわなかったら、今ごろは二度も行ってきたでしょう」。"},{"ref":"Gen.43.11","start":1043011,"end":1043011,"break":"paragraph","ruby":[[0,1,"ちち"],[7,1,"かれ"],[10,1,"い"],[28,1,"くに"],[30,2,"めいさん"],[33,1,"うつわ"],[35,1,"い"],[38,1,"たずさ"],[40,1,"くだ"],[45,1,"ひと"],[47,1,"おく"],[49,1,"もの"],[60,1,"すこ"],[63,2,"にゅうこう"],[66,1,"すこ"],[69,1,"みつ"],[71,2,"こうりょう"]],"text":"父イスラエルは彼らに言った、「それではこうしなさい。この国の名産を器に入れ、携え下ってその人に贈り物にしなさい。すなわち少しの乳香、少しの蜜、香料、もつやく、ふすだしう、あめんどう。"},{"ref":"Gen.43.12","start":1043012,"end":1043012,"break":"none","ruby":[[5,1,"うえ"],[8,2,"ばいがく"],[11,1,"ぎん"],[13,1,"て"],[15,1,"も"],[18,1,"い"],[26,1,"ふくろ"],[28,1,"くち"],[30,1,"かえ"],[36,1,"ぎん"],[38,1,"も"],[41,1,"い"],[44,1,"かえ"],[56,1,"あやま"]],"text":"そしてその上に、倍額の銀を手に持って行きなさい。また袋の口に返してあった銀は持って行って返しなさい。たぶんそれは誤りであったのでしょう。"},{"ref":"Gen.43.13","start":1043013,"end":1043013,"break":"none","ruby":[[0,1,"おとうと"],[2,1,"つ"],[5,1,"た"],[13,1,"ひと"],[15,1,"ところ"],[17,1,"い"]],"text":"弟も連れ、立って、またその人の所へ行きなさい。"},{"ref":"Gen.43.14","start":1043014,"end":1043014,"break":"none","ruby":[[3,2,"ぜんのう"],[6,1,"かみ"],[10,1,"ひと"],[12,1,"まえ"],[31,2,"きょうだい"],[42,1,"かえ"],[60,1,"こ"],[62,1,"うしな"],[76,1,"うしな"]],"text":"どうか全能の神がその人の前であなたがたをあわれみ、もうひとりの兄弟とベニヤミンとを、返させてくださるように。もしわたしが子を失わなければならないのなら、失ってもよい」。"},{"ref":"Gen.43.15","start":1043015,"end":1043015,"break":"none","ruby":[[5,2,"ひとびと"],[8,1,"おく"],[10,1,"もの"],[12,1,"と"],[17,2,"ばいがく"],[20,1,"ぎん"],[22,1,"たずさ"],[31,1,"つ"],[34,1,"た"],[42,1,"くだ"],[49,1,"まえ"],[51,1,"た"]],"text":"そこでその人々は贈り物を取り、また倍額の銀を携え、ベニヤミンを連れ、立ってエジプトへ下り、ヨセフの前に立った。"},{"ref":"Gen.43.16","start":1043016,"end":1043016,"break":"paragraph","ruby":[[10,1,"かれ"],[13,1,"とも"],[19,1,"み"],[22,1,"いえ"],[27,1,"い"],[34,2,"ひとびと"],[37,1,"いえ"],[39,1,"つ"],[42,1,"い"],[45,1,"けもの"],[63,2,"ひとびと"],[66,1,"ひる"],[72,2,"いっしょ"],[75,2,"しょくじ"]],"text":"ヨセフはベニヤミンが彼らと共にいるのを見て、家づかさに言った、「この人々を家に連れて行き、獣をほふって、したくするように。この人々は昼、わたしと一緒に食事をします」。"},{"ref":"Gen.43.17","start":1043017,"end":1043017,"break":"none","ruby":[[2,1,"ひと"],[8,1,"い"],[19,2,"ひとびと"],[26,1,"いえ"],[28,1,"つ"],[31,1,"い"]],"text":"その人はヨセフの言ったようにして、この人々をヨセフの家へ連れて行った。"},{"ref":"Gen.43.18","start":1043018,"end":1043018,"break":"none","ruby":[[6,2,"ひとびと"],[13,1,"いえ"],[15,1,"つ"],[18,1,"い"],[24,1,"おそ"],[27,1,"い"],[32,1,"はじ"],[35,1,"とき"],[37,1,"ふくろ"],[39,1,"かえ"],[47,1,"ぎん"],[58,1,"ひ"],[60,1,"い"],[75,1,"おそ"],[78,1,"せ"],[81,1,"とら"],[84,2,"どれい"],[98,1,"うば"]],"text":"ところがこの人々はヨセフの家へ連れて行かれたので恐れて言った、「初めの時に袋に返してあったあの銀のゆえに、われわれを引き入れたのです。そしてわれわれを襲い、攻め、捕えて奴隷とし、われわれのろばをも奪うのです」。"},{"ref":"Gen.43.19","start":1043019,"end":1043019,"break":"none","ruby":[[0,1,"かれ"],[7,1,"いえ"],[12,1,"ちか"],[17,1,"いえ"],[19,2,"いりぐち"],[23,1,"い"]],"text":"彼らはヨセフの家づかさに近づいて、家の入口で、言った、"},{"ref":"Gen.43.20","start":1043020,"end":1043020,"break":"none","ruby":[[6,1,"しゅ"],[14,2,"さいしょ"],[17,2,"しょくりょう"],[20,1,"か"],[25,1,"くだ"]],"text":"「ああ、わが主よ、われわれは最初、食糧を買うために下ってきたのです。"},{"ref":"Gen.43.21","start":1043021,"end":1043021,"break":"none","ruby":[[4,1,"やど"],[6,1,"い"],[9,1,"ふくろ"],[14,1,"み"],[23,1,"ぎん"],[25,1,"ふくろ"],[27,1,"くち"],[33,1,"ぎん"],[35,1,"おも"],[38,1,"もと"],[57,1,"も"],[60,1,"まい"]],"text":"ところが宿に行って袋をあけて見ると、めいめいの銀は袋の口にあって、銀の重さは元のままでした。それでわれわれはそれを持って参りました。"},{"ref":"Gen.43.22","start":1043022,"end":1043022,"break":"none","ruby":[[3,2,"しょくりょう"],[6,1,"か"],[15,1,"ぎん"],[18,1,"も"],[21,1,"くだ"],[34,1,"ぎん"],[36,1,"ふくろ"],[38,1,"い"],[41,1,"もの"],[51,1,"わか"]],"text":"そして食糧を買うために、ほかの銀をも持って下ってきました。われわれの銀を袋に入れた者が、だれであるかは分りません」。"},{"ref":"Gen.43.23","start":1043023,"end":1043023,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,2,"あんしん"],[14,1,"おそ"],[26,1,"たから"],[34,1,"かみ"],[42,1,"ちち"],[44,1,"かみ"],[53,1,"ふくろ"],[55,1,"い"],[64,1,"たま"],[78,1,"ぎん"],[84,1,"う"],[86,1,"と"],[96,1,"かれ"],[103,1,"かれ"],[106,1,"ところ"],[108,1,"つ"]],"text":"彼は言った、「安心しなさい。恐れてはいけません。その宝はあなたがたの神、あなたがたの父の神が、あなたがたの袋に入れてあなたがたに賜わったのです。あなたがたの銀はわたしが受け取りました」。そして彼はシメオンを彼らの所へ連れてきた。"},{"ref":"Gen.43.24","start":1043024,"end":1043024,"break":"none","ruby":[[6,1,"ひと"],[10,2,"ひとびと"],[17,1,"いえ"],[19,1,"みちび"],[22,1,"みず"],[24,1,"あた"],[27,1,"あし"],[29,1,"あら"],[39,2,"かいば"],[42,1,"あた"]],"text":"こうしてその人はこの人々をヨセフの家へ導き、水を与えて足を洗わせ、また、ろばに飼葉を与えた。"},{"ref":"Gen.43.25","start":1043025,"end":1043025,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ところ"],[7,2,"しょくじ"],[15,1,"き"],[18,1,"おく"],[20,1,"もの"],[22,1,"ととの"],[26,1,"ひる"],[32,1,"く"],[36,1,"ま"]],"text":"彼らはその所で食事をするのだと聞き、贈り物を整えて、昼にヨセフの来るのを待った。"},{"ref":"Gen.43.26","start":1043026,"end":1043026,"break":"paragraph","ruby":[[6,1,"いえ"],[8,1,"かえ"],[16,1,"かれ"],[21,1,"いえ"],[23,1,"たずさ"],[28,1,"おく"],[30,1,"もの"],[40,1,"ち"],[42,1,"ふ"],[46,1,"かれ"],[48,1,"はい"]],"text":"さてヨセフが家に帰ってきたので、彼らはその家に携えてきた贈り物をヨセフにささげ、地に伏して、彼を拝した。"},{"ref":"Gen.43.27","start":1043027,"end":1043027,"break":"none","ruby":[[4,1,"かれ"],[7,2,"あんぴ"],[10,1,"と"],[13,1,"い"],[24,1,"ちち"],[35,1,"はな"],[42,2,"ろうじん"],[45,2,"ぶじ"],[53,1,"い"]],"text":"ヨセフは彼らの安否を問うて言った、「あなたがたの父、あなたがたがさきに話していたその老人は無事ですか。なお生きながらえておられますか」。"},{"ref":"Gen.43.28","start":1043028,"end":1043028,"break":"none","ruby":[[0,1,"かれ"],[3,1,"こた"],[21,1,"ちち"],[23,2,"ぶじ"],[29,1,"い"],[44,1,"かれ"],[48,1,"とう"],[53,1,"はい"]],"text":"彼らは答えた、「あなたのしもべ、われわれの父は無事で、なお生きながらえています」。そして彼らは、頭をさげて拝した。"},{"ref":"Gen.43.29","start":1043029,"end":1043029,"break":"none","ruby":[[4,1,"め"],[9,1,"おな"],[11,1,"はは"],[13,1,"こ"],[17,1,"おとうと"],[24,1,"み"],[26,1,"い"],[40,1,"まえ"],[46,1,"はな"],[49,1,"すえ"],[51,1,"おとうと"],[59,1,"い"],[66,1,"こ"],[72,1,"かみ"],[78,1,"めぐ"]],"text":"ヨセフは目をあげて同じ母の子である弟ベニヤミンを見て言った、「これはあなたがたが前にわたしに話した末の弟ですか」。また言った、「わが子よ、どうか神があなたを恵まれるように」。"},{"ref":"Gen.43.30","start":1043030,"end":1043030,"break":"none","ruby":[[4,1,"おとうと"],[11,1,"こころ"],[17,1,"いそ"],[20,1,"な"],[22,2,"ばしょ"],[36,1,"な"]],"text":"ヨセフは弟なつかしさに心がせまり、急いで泣く場所をたずね、へやにはいって泣いた。"},{"ref":"Gen.43.31","start":1043031,"end":1043031,"break":"none","ruby":[[3,1,"かれ"],[5,1,"かお"],[7,1,"あら"],[10,1,"で"],[18,2,"じぶん"],[21,1,"せい"],[24,1,"い"],[29,2,"しょくじ"]],"text":"やがて彼は顔を洗って出てきた。そして自分を制して言った、「食事にしよう」。"},{"ref":"Gen.43.32","start":1043032,"end":1043032,"break":"none","ruby":[[11,1,"かれ"],[14,1,"かれ"],[17,2,"ばいしょく"],[35,2,"べつべつ"],[38,1,"せき"],[40,1,"つ"],[57,1,"とも"],[59,2,"しょくじ"],[83,1,"い"]],"text":"そこでヨセフはヨセフ、彼らは彼ら、陪食のエジプトびとはエジプトびと、と別々に席に着いた。エジプトびとはヘブルびとと共に食事することができなかった。それはエジプトびとの忌むところであったからである。"},{"ref":"Gen.43.33","start":1043033,"end":1043033,"break":"none","ruby":[[4,1,"かれ"],[11,1,"まえ"],[14,2,"ちょうし"],[17,2,"ちょうし"],[23,1,"おとうと"],[25,1,"おとうと"],[41,2,"ひとびと"],[44,1,"たがい"],[46,1,"おどろ"]],"text":"こうして彼らはヨセフの前に、長子は長子として、弟は弟としてすわらせられたので、その人々は互に驚いた。"},{"ref":"Gen.43.34","start":1043034,"end":1043034,"break":"none","ruby":[[6,1,"まえ"],[15,1,"ぶん"],[17,1,"はこ"],[29,1,"ぶん"],[31,1,"た"],[37,1,"もの"],[39,1,"ぶん"],[44,1,"ばい"],[45,1,"おお"],[54,1,"かれ"],[57,1,"の"],[64,1,"とも"],[66,1,"たの"]],"text":"またヨセフの前から、めいめいの分が運ばれたが、ベニヤミンの分は他のいずれの者の分よりも五倍多かった。こうして彼らは飲み、ヨセフと共に楽しんだ。"}]