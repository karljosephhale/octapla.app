[{"ref":"Josh.10.1","start":6010001,"end":6010001,"break":"paragraph","ruby":[[6,1,"おう"],[23,1,"せ"],[25,1,"と"],[32,1,"まった"],[34,1,"ほろ"],[47,1,"おう"],[61,1,"おう"],[76,2,"じゅうみん"],[86,1,"わ"],[88,1,"こう"],[102,1,"き"]],"text":"エルサレムの王アドニゼデクは、ヨシュアがアイを攻め取って、それを全く滅ぼし、さきにエリコとその王とにしたように、アイとその王にもしたこと、またギベオンの住民が、イスラエルと和を講じて、そのうちにおることを聞き、"},{"ref":"Josh.10.2","start":6010002,"end":6010002,"break":"none","ruby":[[0,1,"おお"],[3,1,"おそ"],[16,1,"おお"],[19,1,"まち"],[25,1,"おう"],[27,1,"みやこ"],[46,1,"おお"],[56,2,"ひとびと"],[63,1,"つよ"]],"text":"大いに恐れた。それは、ギベオンが大きな町であって、王の都にもひとしいものであり、またアイより大きくて、そのうちの人々が、すべて強かったからである。"},{"ref":"Josh.10.3","start":6010003,"end":6010003,"break":"none","ruby":[[9,1,"おう"],[23,1,"おう"],[33,1,"おう"],[42,1,"おう"],[55,1,"おう"],[60,1,"ひと"],[67,1,"い"]],"text":"それでエルサレムの王アドニゼデクは、ヘブロンの王ホハム、ヤルムテの王ピラム、ラキシの王ヤピア、およびエグロンの王デビルに人をつかわして言った、"},{"ref":"Josh.10.4","start":6010004,"end":6010004,"break":"none","ruby":[[5,1,"ところ"],[7,1,"のぼ"],[17,1,"たす"],[35,1,"う"],[60,2,"ひとびと"],[63,1,"わ"],[65,1,"こう"]],"text":"「わたしの所に上ってきて、わたしを助けてください。われわれはギベオンを撃ちましょう。ギベオンはヨシュアおよびイスラエルの人々と和を講じたからです」。"},{"ref":"Josh.10.5","start":6010005,"end":6010005,"break":"none","ruby":[[7,1,"にん"],[9,1,"おう"],[21,1,"おう"],[28,1,"おう"],[35,1,"おう"],[41,1,"おう"],[51,1,"おう"],[53,1,"へい"],[55,1,"あつ"],[64,2,"ぐんぜい"],[67,1,"ひき"],[70,1,"のぼ"],[81,1,"む"],[85,1,"じん"],[87,1,"と"],[93,1,"せ"],[96,1,"たたか"]],"text":"アモリびとの五人の王、すなわちエルサレムの王、ヘブロンの王、ヤルムテの王、ラキシの王、およびエグロンの王は兵を集め、そのすべての軍勢を率いて上ってきて、ギベオンに向かって陣を取り、それを攻めて戦った。"},{"ref":"Josh.10.6","start":6010006,"end":6010006,"break":"paragraph","ruby":[[5,2,"ひとびと"],[14,2,"じんえい"],[17,1,"ひと"],[29,1,"い"],[38,1,"て"],[40,1,"ひ"],[52,1,"たす"],[60,1,"はや"],[68,1,"ところ"],[70,1,"のぼ"],[81,1,"すく"],[84,1,"たす"],[92,2,"さんち"],[95,1,"す"],[103,1,"おう"],[109,1,"あつ"],[119,1,"せ"]],"text":"ギベオンの人々は、ギルガルの陣営に人をつかわし、ヨシュアに言った、「あなたの手を引かないで、しもべどもを助けてください。早く、われわれの所に上ってきて、われわれを救い、助けてください。山地に住むアモリびとの王たちがみな集まって、われわれを攻めるからです」。"},{"ref":"Josh.10.7","start":6010007,"end":6010007,"break":"none","ruby":[[23,1,"だい"],[24,2,"ゆうし"],[27,1,"ひき"],[37,1,"のぼ"],[40,1,"い"]],"text":"そこでヨシュアはすべてのいくさびとと、すべての大勇士を率いて、ギルガルから上って行った。"},{"ref":"Josh.10.8","start":6010008,"end":6010008,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[11,1,"い"],[17,1,"かれ"],[20,1,"おそ"],[33,1,"かれ"],[40,1,"て"],[52,1,"かれ"],[64,1,"あた"]],"text":"その時、主はヨシュアに言われた、「彼らを恐れてはならない。わたしが彼らをあなたの手にわたしたからである。彼らのうちには、あなたに当ることのできるものは、ひとりもないであろう」。"},{"ref":"Josh.10.9","start":6010009,"end":6010009,"break":"none","ruby":[[18,1,"すす"],[29,1,"かれ"],[32,1,"せ"]],"text":"ヨシュアは、ギルガルから、よもすがら進みのぼって、にわかに彼らに攻めよせたところ、"},{"ref":"Josh.10.10","start":6010010,"end":6010010,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[12,1,"まえ"],[15,1,"おそ"],[39,1,"かれ"],[48,1,"う"],[50,1,"ころ"],[59,1,"のぼ"],[61,1,"ざか"],[67,1,"に"],[70,1,"かれ"],[84,2,"ついげき"]],"text":"主は彼らを、イスラエルの前に、恐れあわてさせられたので、イスラエルはギベオンで彼らをおびただしく撃ち殺し、ベテホロンの上り坂をとおって逃げる彼らを、アゼカとマッケダまで追撃した。"},{"ref":"Josh.10.11","start":6010011,"end":6010011,"break":"none","ruby":[[0,1,"かれ"],[9,1,"まえ"],[12,1,"に"],[14,1,"はし"],[24,1,"くだ"],[26,1,"ざか"],[33,1,"とき"],[35,1,"しゅ"],[37,1,"てん"],[40,1,"かれ"],[43,1,"うえ"],[45,2,"おおいし"],[48,1,"ふ"],[70,1,"おお"],[73,2,"ひとびと"],[76,1,"し"],[86,2,"ひとびと"],[96,1,"ころ"],[105,1,"ひょう"],[107,1,"う"],[111,1,"し"],[120,1,"おお"]],"text":"彼らがイスラエルの前から逃げ走って、ベテホロンの下り坂をおりていた時、主は天から彼らの上に大石を降らし、アゼカにいたるまでもそうされたので、多くの人々が死んだ。イスラエルの人々がつるぎをもって殺したものよりも、雹に打たれて死んだもののほうが多かった。"},{"ref":"Josh.10.12","start":6010012,"end":6010012,"break":"paragraph","breaks":[[51,"stanza"],[67,"line"]],"ruby":[[0,1,"しゅ"],[14,2,"ひとびと"],[22,1,"ひ"],[36,2,"ひとびと"],[39,1,"まえ"],[41,1,"しゅ"],[47,1,"い"],[52,1,"ひ"],[60,1,"うえ"],[67,1,"つき"],[75,1,"たに"]],"text":"主がアモリびとをイスラエルの人々にわたされた日に、ヨシュアはイスラエルの人々の前で主にむかって言った、「日よ、ギベオンの上にとどまれ、月よ、アヤロンの谷にやすらえ」。"},{"ref":"Josh.10.13","start":6010013,"end":6010013,"break":"line","breaks":[[13,"line"],[20,"line"]],"ruby":[[0,1,"たみ"],[4,1,"てき"],[6,1,"う"],[8,1,"やぶ"],[13,1,"ひ"],[20,1,"つき"],[22,1,"うご"],[37,1,"しょ"],[52,1,"ひ"],[54,1,"てん"],[56,2,"ちゅうくう"],[65,1,"いそ"],[68,1,"ぼっ"],[82,1,"にち"]],"text":"民がその敵を撃ち破るまで、日はとどまり、月は動かなかった。これはヤシャルの書にしるされているではないか。日が天の中空にとどまって、急いで没しなかったこと、おおよそ一日であった。"},{"ref":"Josh.10.14","start":6010014,"end":6010014,"break":"none","ruby":[[4,1,"さき"],[13,1,"しゅ"],[20,1,"ひと"],[22,2,"ことば"],[25,1,"き"],[32,1,"ひ"],[35,1,"にち"],[42,1,"しゅ"],[53,1,"たたか"]],"text":"これより先にも、あとにも、主がこのように人の言葉を聞きいれられた日は一日もなかった。主がイスラエルのために戦われたからである。"},{"ref":"Josh.10.15","start":6010015,"end":6010015,"break":"paragraph","ruby":[[19,1,"ひと"],[21,1,"とも"],[28,2,"じんえい"],[31,1,"かえ"]],"text":"こうしてヨシュアはイスラエルのすべての人と共にギルガルの陣営に帰った。"},{"ref":"Josh.10.16","start":6010016,"end":6010016,"break":"paragraph","ruby":[[3,1,"にん"],[5,1,"おう"],[9,1,"に"],[12,1,"い"],[23,1,"あな"],[25,1,"かく"]],"text":"かの五人の王たちは逃げて行って、マッケダのほら穴に隠れたが、"},{"ref":"Josh.10.17","start":6010017,"end":6010017,"break":"none","ruby":[[1,1,"にん"],[3,1,"おう"],[14,1,"あな"],[24,1,"み"],[36,1,"つ"],[39,1,"もの"]],"text":"五人の王たちがマッケダのほら穴にかくれているのが見つかったと、ヨシュアに告げる者があったので、"},{"ref":"Josh.10.18","start":6010018,"end":6010018,"break":"none","ruby":[[5,1,"い"],[12,1,"あな"],[14,1,"くち"],[16,2,"おおいし"],[29,1,"ひと"],[31,1,"お"],[35,1,"まも"]],"text":"ヨシュアは言った、「ほら穴の口に大石をころがし、そのそばに人を置いて、守らせなさい。"},{"ref":"Josh.10.19","start":6010019,"end":6010019,"break":"none","ruby":[[22,1,"てき"],[27,1,"お"],[37,1,"う"],[40,1,"かれ"],[45,1,"まち"],[64,1,"かみ"],[66,1,"しゅ"],[68,1,"かれ"],[77,1,"て"],[79,1,"わた"]],"text":"ただし、あなたがたは、そこにとどまらないで、敵のあとを追い、そのしんがりを撃ち、彼らをその町にはいらせてはならない。あなたがたの神、主が彼らをあなたがたの手に渡されたからである」。"},{"ref":"Josh.10.20","start":6010020,"end":6010020,"break":"none","ruby":[[11,2,"ひとびと"],[15,1,"おお"],[18,1,"かれ"],[21,1,"う"],[23,1,"ころ"],[29,1,"かれ"],[32,1,"ほろ"],[41,1,"かれ"],[50,1,"い"],[52,1,"のこ"],[55,1,"もの"],[60,2,"けんご"],[63,2,"まちまち"],[66,1,"に"]],"text":"ヨシュアとイスラエルの人々は、大いに彼らを撃ち殺し、ついに彼らを滅ぼしつくしたが、彼らのうちのがれて生き残った者どもは、堅固な町々に逃げこんだので、"},{"ref":"Josh.10.21","start":6010021,"end":6010021,"break":"none","ruby":[[0,1,"たみ"],[4,1,"やす"],[13,2,"じんえい"],[24,1,"かえ"],[37,2,"ひとびと"],[44,1,"した"],[46,1,"な"],[49,1,"もの"]],"text":"民はみな安らかにマッケダの陣営のヨシュアのもとに帰ってきたが、イスラエルの人々にむかって舌を鳴らす者はひとりもなかった。"},{"ref":"Josh.10.22","start":6010022,"end":6010022,"break":"paragraph","ruby":[[2,1,"とき"],[8,1,"い"],[15,1,"あな"],[17,1,"くち"],[19,1,"ひら"],[25,1,"あな"],[32,1,"にん"],[34,1,"おう"],[48,1,"だ"]],"text":"その時ヨシュアは言った、「ほら穴の口を開いて、ほら穴から、かの五人の王たちを、わたしのもとにひき出しなさい」。"},{"ref":"Josh.10.23","start":6010023,"end":6010023,"break":"none","ruby":[[15,1,"にん"],[17,1,"おう"],[32,1,"おう"],[39,1,"おう"],[46,1,"おう"],[52,1,"おう"],[62,1,"おう"],[67,1,"あな"],[70,1,"かれ"],[77,1,"だ"]],"text":"やがて、そのようにして、かの五人の王たち、すなわち、エルサレムの王、ヘブロンの王、ヤルムテの王、ラキシの王、およびエグロンの王を、ほら穴から彼のもとにひき出した。"},{"ref":"Josh.10.24","start":6010024,"end":6010024,"break":"none","ruby":[[2,1,"おう"],[16,1,"だ"],[19,1,"とき"],[36,2,"ひとびと"],[39,1,"よ"],[41,1,"よ"],[44,2,"じぶん"],[47,1,"とも"],[49,1,"い"],[58,1,"ちょう"],[62,1,"い"],[67,2,"ちかよ"],[74,1,"おう"],[81,1,"あし"],[93,2,"ちかよ"],[100,1,"おう"],[107,1,"あし"]],"text":"この王たちをヨシュアのもとにひき出した時、ヨシュアはイスラエルのすべての人々を呼び寄せ、自分と共に行ったいくさびとの長たちに言った、「近寄って、この王たちのくびに足をかけなさい」。そこで近寄って、その王たちのくびに足をかけたので、"},{"ref":"Josh.10.25","start":6010025,"end":6010025,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[13,1,"おそ"],[26,1,"つよ"],[30,2,"おお"],[43,1,"せ"],[46,1,"たたか"],[52,1,"てき"],[56,1,"しゅ"]],"text":"ヨシュアは彼らに言った、「恐れおののいてはならない。強くまた雄々しくあれ。あなたがたが攻めて戦うすべての敵には、主がこのようにされるのである」。"},{"ref":"Josh.10.26","start":6010026,"end":6010026,"break":"none","ruby":[[3,1,"のち"],[9,1,"かれ"],[12,1,"う"],[15,1,"し"],[20,1,"ほん"],[22,1,"き"],[28,2,"ゆうぐ"],[33,1,"き"],[35,1,"うえ"],[41,1,"お"]],"text":"そして後ヨシュアは彼らを撃って死なせ、五本の木にかけて、夕暮れまで木の上にさらして置いたが、"},{"ref":"Josh.10.27","start":6010027,"end":6010027,"break":"none","ruby":[[0,1,"ひ"],[2,1,"い"],[16,1,"めい"],[25,1,"き"],[32,1,"かれ"],[35,1,"かく"],[42,1,"あな"],[44,1,"な"],[46,1,"い"],[51,1,"あな"],[53,1,"くち"],[55,2,"おおいし"],[58,1,"お"],[65,2,"こんにち"],[69,1,"のこ"]],"text":"日の入るころになって、ヨシュアが命じたので、これを木からおろし、彼らが隠れていたほら穴に投げ入れ、ほら穴の口に大石を置いた。これは今日まで残っている。"},{"ref":"Josh.10.28","start":6010028,"end":6010028,"break":"paragraph","ruby":[[2,1,"ひ"],[13,1,"と"],[30,1,"おう"],[33,1,"う"],[38,1,"なか"],[44,1,"ひと"],[52,1,"ほろ"],[61,1,"のこ"],[69,1,"おう"],[82,1,"おう"]],"text":"その日ヨシュアはマッケダを取り、つるぎをもって、それと、その王とを撃ち、その中のすべての人を、ことごとく滅ぼして、ひとりも残さず、エリコの王にしたように、マッケダの王にもした。"},{"ref":"Josh.10.29","start":6010029,"end":6010029,"break":"paragraph","ruby":[[19,1,"ひと"],[21,1,"ひき"],[35,1,"すす"],[42,1,"せ"],[45,1,"たたか"]],"text":"こうしてヨシュアはイスラエルのすべての人を率いて、マッケダからリブナに進み、リブナを攻めて戦った。"},{"ref":"Josh.10.30","start":6010030,"end":6010030,"break":"none","ruby":[[0,1,"しゅ"],[9,1,"おう"],[19,1,"て"],[21,1,"わた"],[42,1,"なか"],[48,1,"ひと"],[50,1,"う"],[52,1,"ほろ"],[63,1,"なか"],[65,1,"のこ"],[73,1,"おう"],[83,1,"おう"]],"text":"主が、それと、その王をも、イスラエルの手に渡されたので、つるぎをもって、それと、その中のすべての人を撃ち滅ぼして、ひとりもその中に残さず、エリコの王にしたように、その王にもした。"},{"ref":"Josh.10.31","start":6010031,"end":6010031,"break":"paragraph","ruby":[[17,1,"ひと"],[19,1,"ひき"],[32,1,"すす"],[38,1,"む"],[42,1,"じん"],[47,1,"せ"],[49,1,"たたか"]],"text":"ヨシュアはまたイスラエルのすべての人を率いて、リブナからラキシに進み、これに向かって陣をしき、攻め戦った。"},{"ref":"Josh.10.32","start":6010032,"end":6010032,"break":"none","ruby":[[0,1,"しゅ"],[12,1,"て"],[14,1,"わた"],[24,1,"め"],[29,1,"と"],[46,1,"なか"],[52,1,"ひと"],[54,1,"う"],[56,1,"ほろ"]],"text":"主がラキシをイスラエルの手に渡されたので、ふつか目にこれを取り、つるぎをもって、それと、その中のすべての人を撃ち滅ぼした。すべてリブナにしたとおりであった。"},{"ref":"Josh.10.33","start":6010033,"end":6010033,"break":"paragraph","ruby":[[2,1,"とき"],[8,1,"おう"],[18,1,"たす"],[24,1,"のぼ"],[37,1,"かれ"],[42,1,"たみ"],[45,1,"う"],[47,1,"ほろ"],[59,1,"のこ"]],"text":"その時、ゲゼルの王ホラムが、ラキシを助けるために上ってきたので、ヨシュアは彼と、その民とを撃ち滅ぼして、ついにひとりも残さなかった。"},{"ref":"Josh.10.34","start":6010034,"end":6010034,"break":"paragraph","ruby":[[17,1,"ひと"],[19,1,"ひき"],[33,1,"すす"],[39,1,"む"],[43,1,"じん"],[48,1,"せ"],[50,1,"たたか"]],"text":"ヨシュアはまたイスラエルのすべての人を率いて、ラキシからエグロンに進み、これに向かって陣をしき、攻め戦った。"},{"ref":"Josh.10.35","start":6010035,"end":6010035,"break":"none","ruby":[[2,1,"ひ"],[6,1,"と"],[20,1,"う"],[25,1,"なか"],[31,1,"ひと"],[41,1,"ひ"],[43,1,"ほろ"]],"text":"その日これを取り、つるぎをもって、これを撃ち、その中のすべての人を、ことごとくその日に滅ぼした。すべてラキシにしたとおりであった。"},{"ref":"Josh.10.36","start":6010036,"end":6010036,"break":"paragraph","ruby":[[17,1,"ひと"],[19,1,"ひき"],[34,1,"すす"],[36,1,"のぼ"],[42,1,"せ"],[45,1,"たたか"]],"text":"ヨシュアはまたイスラエルのすべての人を率いて、エグロンからヘブロンに進み上り、これを攻めて戦い、"},{"ref":"Josh.10.37","start":6010037,"end":6010037,"break":"none","ruby":[[3,1,"と"],[13,1,"おう"],[24,2,"まちまち"],[30,1,"なか"],[36,1,"ひと"],[46,1,"う"],[48,1,"ほろ"],[56,1,"のこ"],[91,1,"なか"],[97,1,"ひと"],[105,1,"ほろ"]],"text":"それを取って、それと、その王、およびそのすべての町々と、その中のすべての人を、つるぎをもって撃ち滅ぼし、ひとりも残さなかった。すべてエグロンにしたとおりであった。すなわち、それとその中のすべての人を、ことごとく滅ぼした。"},{"ref":"Josh.10.38","start":6010038,"end":6010038,"break":"paragraph","ruby":[[17,1,"ひと"],[19,1,"ひき"],[36,1,"せ"],[39,1,"たたか"]],"text":"またヨシュアはイスラエルのすべての人を率いて、デビルへひきかえし、これを攻めて戦い、"},{"ref":"Josh.10.39","start":6010039,"end":6010039,"break":"none","ruby":[[6,1,"おう"],[17,2,"まちまち"],[20,1,"と"],[33,1,"う"],[38,1,"なか"],[44,1,"ひと"],[52,1,"ほろ"],[60,1,"のこ"],[67,1,"かれ"],[76,1,"おう"],[107,1,"おう"]],"text":"それと、その王、およびそのすべての町々を取り、つるぎをもってそれを撃ち、その中のすべての人を、ことごとく滅ぼし、ひとりも残さなかった。彼がデビルと、その王にしたことは、ヘブロンにしたとおりであり、またリブナと、その王にしたとおりであった。"},{"ref":"Josh.10.40","start":6010040,"end":6010040,"break":"paragraph","ruby":[[11,1,"ち"],[13,2,"ぜんぶ"],[21,2,"さんち"],[28,2,"へいち"],[34,2,"さんぷく"],[37,1,"ち"],[46,1,"おう"],[50,1,"う"],[52,1,"ほろ"],[61,1,"のこ"],[68,1,"いき"],[81,1,"ほろ"],[92,1,"かみ"],[94,1,"しゅ"],[96,1,"めい"]],"text":"こうしてヨシュアはその地の全部、すなわち、山地、ネゲブ、平地、および山腹の地と、そのすべての王たちを撃ち滅ぼして、ひとりも残さず、すべて息のあるものは、ことごとく滅ぼした。イスラエルの神、主が命じられたとおりであった。"},{"ref":"Josh.10.41","start":6010041,"end":6010041,"break":"none","ruby":[[20,2,"くにぐに"],[30,1,"ぜん"],[31,1,"ち"],[33,1,"う"],[35,1,"ほろ"],[47,1,"およ"]],"text":"ヨシュアはカデシ・バルネアからガザまでの国々、およびゴセンの全地を撃ち滅ぼして、ギベオンにまで及んだ。"},{"ref":"Josh.10.42","start":6010042,"end":6010042,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[19,1,"たたか"],[38,1,"おう"],[45,1,"ち"],[52,1,"と"]],"text":"イスラエルの神、主がイスラエルのために戦われたので、ヨシュアはこれらすべての王たちと、その地をいちどきに取った。"},{"ref":"Josh.10.43","start":6010043,"end":6010043,"break":"none","ruby":[[18,1,"ひと"],[20,1,"ひき"],[29,2,"じんえい"],[32,1,"かえ"]],"text":"そしてヨシュアはイスラエルのすべての人を率いて、ギルガルの陣営に帰った。"}]