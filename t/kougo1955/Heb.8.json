[{"ref":"Heb.8.1","start":58008001,"end":58008001,"break":"paragraph","ruby":[[0,2,"いじょう"],[2,1,"の"],[8,2,"ようてん"],[17,3,"だいさいし"],[34,1,"てん"],[39,3,"たいのうしゃ"],[43,2,"みざ"],[46,1,"みぎ"],[48,1,"ざ"]],"text":"以上述べたことの要点は、このような大祭司がわたしたちのためにおられ、天にあって大能者の御座の右に座し、"},{"ref":"Heb.8.2","start":58008002,"end":58008002,"break":"none","ruby":[[0,2,"にんげん"],[6,1,"しゅ"],[11,1,"もう"],[16,1,"しん"],[18,2,"まくや"],[22,2,"せいじょ"],[25,1,"つか"]],"text":"人間によらず主によって設けられた真の幕屋なる聖所で仕えておられる、ということである。"},{"ref":"Heb.8.3","start":58008003,"end":58008003,"break":"none","ruby":[[5,3,"だいさいし"],[9,1,"た"],[17,1,"そな"],[19,1,"もの"],[48,3,"だいさいし"],[55,1,"なに"],[62,1,"もの"],[64,1,"も"]],"text":"おおよそ、大祭司が立てられるのは、供え物やいけにえをささげるためにほかならない。したがって、この大祭司もまた、何かささぐべき物を持っておられねばならない。"},{"ref":"Heb.8.4","start":58008004,"end":58008004,"break":"none","ruby":[[6,1,"かれ"],[8,2,"ちじょう"],[18,2,"りっぽう"],[26,1,"そな"],[28,1,"もの"],[34,2,"さいし"],[40,1,"げん"],[49,1,"かれ"],[51,2,"さいし"],[57,1,"え"]],"text":"そこで、もし彼が地上におられたなら、律法にしたがって供え物をささげる祭司たちが、現にいるのだから、彼は祭司ではあり得なかったであろう。"},{"ref":"Heb.8.5","start":58008005,"end":58008005,"break":"none","ruby":[[0,1,"かれ"],[4,1,"てん"],[8,2,"せいじょ"],[13,1,"がた"],[15,1,"かげ"],[18,1,"つか"],[23,1,"もの"],[42,2,"まくや"],[45,1,"た"],[55,1,"み"],[56,1,"つ"],[59,1,"う"],[63,1,"やま"],[65,1,"しめ"],[69,1,"かた"],[75,2,"ちゅうい"],[86,1,"つく"],[93,1,"い"]],"text":"彼らは、天にある聖所のひな型と影とに仕えている者にすぎない。それについては、モーセが幕屋を建てようとしたとき、御告げを受け、「山で示された型どおりに、注意してそのいっさいを作りなさい」と言われたのである。"},{"ref":"Heb.8.6","start":58008006,"end":58008006,"break":"none","ruby":[[18,1,"つとめ"],[20,1,"え"],[40,2,"やくそく"],[43,1,"もとづ"],[46,1,"た"],[59,2,"けいやく"],[62,3,"ちゅうほしゃ"]],"text":"ところがキリストは、はるかにすぐれた務を得られたのである。それは、さらにまさった約束に基いて立てられた、さらにまさった契約の仲保者となられたことによる。"},{"ref":"Heb.8.7","start":58008007,"end":58008007,"break":"none","ruby":[[2,1,"はじ"],[5,2,"けいやく"],[8,1,"か"],[28,1,"た"],[33,2,"よち"]],"text":"もし初めの契約に欠けたところがなかったなら、あとのものが立てられる余地はなかったであろう。"},{"ref":"Heb.8.8","start":58008008,"end":58008008,"break":"none","breaks":[[18,"stanza"],[29,"line"],[49,"line"]],"ruby":[[5,1,"かみ"],[7,1,"かれ"],[10,1,"せ"],[13,1,"い"],[19,1,"しゅ"],[21,1,"い"],[26,1,"み"],[39,1,"いえ"],[46,1,"いえ"],[49,1,"あたら"],[52,2,"けいやく"],[55,1,"むす"],[57,1,"ひ"],[59,1,"く"]],"text":"ところが、神は彼らを責めて言われた、「主は言われる、見よ、わたしがイスラエルの家およびユダの家と、新しい契約を結ぶ日が来る。"},{"ref":"Heb.8.9","start":58008009,"end":58008009,"break":"line","breaks":[[22,"line"],[38,"line"],[57,"line"],[80,"line"],[102,"line"]],"ruby":[[8,1,"かれ"],[11,2,"せんぞ"],[16,1,"て"],[27,1,"ち"],[30,1,"みち"],[32,1,"だ"],[35,1,"ひ"],[38,1,"かれ"],[41,1,"むす"],[44,2,"けいやく"],[57,1,"かれ"],[64,2,"けいやく"],[84,1,"かれ"],[102,1,"しゅ"],[104,1,"い"]],"text":"それは、わたしが彼らの先祖たちの手をとって、エジプトの地から導き出した日に、彼らと結んだ契約のようなものではない。彼らがわたしの契約にとどまることをしないので、わたしも彼らをかえりみなかったからであると、主が言われる。"},{"ref":"Heb.8.10","start":58008010,"end":58008010,"break":"line","breaks":[[45,"line"],[68,"line"],[80,"line"],[97,"line"]],"ruby":[[9,1,"ひ"],[11,1,"のち"],[19,1,"いえ"],[21,1,"た"],[28,2,"けいやく"],[38,1,"しゅ"],[40,1,"い"],[54,2,"りっぽう"],[57,1,"かれ"],[60,1,"おも"],[63,1,"なか"],[65,1,"い"],[68,1,"かれ"],[71,1,"こころ"],[73,1,"か"],[89,1,"かれ"],[92,1,"かみ"],[97,1,"かれ"],[104,1,"たみ"]],"text":"わたしが、それらの日の後、イスラエルの家と立てようとする契約はこれである、と主が言われる。すなわち、わたしの律法を彼らの思いの中に入れ、彼らの心に書きつけよう。こうして、わたしは彼らの神となり、彼らはわたしの民となるであろう。"},{"ref":"Heb.8.11","start":58008011,"end":58008011,"break":"line","breaks":[[15,"line"],[29,"line"],[49,"line"],[70,"line"],[79,"line"]],"ruby":[[0,1,"かれ"],[11,2,"どうほう"],[25,2,"きょうだい"],[29,1,"しゅ"],[31,1,"し"],[35,1,"い"],[38,1,"おし"],[54,1,"おお"],[57,1,"もの"],[60,1,"しょう"],[63,1,"もの"],[65,1,"いた"],[70,1,"かれ"],[83,1,"し"]],"text":"彼らは、それぞれ、その同胞に、また、それぞれ、その兄弟に、主を知れ、と言って教えることはなくなる。なぜなら、大なる者から小なる者に至るまで、彼らはことごとく、わたしを知るようになるからである。"},{"ref":"Heb.8.12","start":58008012,"end":58008012,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"かれ"],[8,2,"ふぎ"],[20,1,"かれ"],[23,1,"つみ"],[25,1,"おも"],[27,1,"だ"]],"text":"わたしは、彼らの不義をあわれみ、もはや、彼らの罪を思い出すことはしない」。"},{"ref":"Heb.8.13","start":58008013,"end":58008013,"break":"paragraph","ruby":[[0,1,"かみ"],[4,1,"あたら"],[9,1,"い"],[20,1,"はじ"],[23,2,"けいやく"],[26,1,"ふる"],[37,1,"とし"],[39,1,"へ"],[41,1,"ふる"],[51,1,"き"]],"text":"神は、「新しい」と言われたことによって、初めの契約を古いとされたのである。年を経て古びたものは、やがて消えていく。"}]