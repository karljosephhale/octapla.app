[{"ref":"Rev.2.1","start":66002001,"end":66002001,"break":"paragraph","breaks":[[24,"paragraph"]],"ruby":[[6,2,"きょうかい"],[9,2,"みつかい"],[15,1,"か"],[25,1,"みぎ"],[27,1,"て"],[32,1,"ほし"],[34,1,"も"],[36,1,"もの"],[41,1,"きん"],[43,2,"しょくだい"],[46,1,"あいだ"],[48,1,"ある"],[50,1,"もの"],[53,1,"つぎ"],[58,1,"い"]],"text":"エペソにある教会の御使に、こう書きおくりなさい。『右の手に七つの星を持つ者、七つの金の燭台の間を歩く者が、次のように言われる。"},{"ref":"Rev.2.2","start":66002002,"end":66002002,"break":"none","ruby":[[12,2,"ろうく"],[15,2,"にんたい"],[19,1,"し"],[33,1,"わる"],[35,1,"もの"],[52,2,"しと"],[55,1,"じ"],[56,1,"しょう"],[66,1,"じつ"],[68,2,"しと"],[73,1,"もの"],[86,1,"もの"],[91,2,"みぬ"],[99,1,"し"]],"text":"わたしは、あなたのわざと労苦と忍耐とを知っている。また、あなたが、悪い者たちをゆるしておくことができず、使徒と自称してはいるが、その実、使徒でない者たちをためしてみて、にせ者であると見抜いたことも、知っている。"},{"ref":"Rev.2.3","start":66002003,"end":66002003,"break":"none","ruby":[[4,2,"にんたい"],[8,1,"つづ"],[15,1,"な"],[20,1,"しの"],[27,1,"よわ"],[29,1,"は"]],"text":"あなたは忍耐をし続け、わたしの名のために忍びとおして、弱り果てることがなかった。"},{"ref":"Rev.2.4","start":66002004,"end":66002004,"break":"none","ruby":[[8,1,"たい"],[11,1,"せめ"],[25,1,"はじ"],[28,1,"あい"],[31,1,"はな"]],"text":"しかし、あなたに対して責むべきことがある。あなたは初めの愛から離れてしまった。"},{"ref":"Rev.2.5","start":66002005,"end":66002005,"break":"none","ruby":[[12,1,"お"],[17,1,"おも"],[19,1,"おこ"],[22,1,"く"],[24,1,"あらた"],[27,1,"はじ"],[33,1,"おこな"],[48,1,"く"],[50,1,"あらた"],[76,2,"しょくだい"],[81,2,"ばしょ"],[85,1,"と"]],"text":"そこで、あなたはどこから落ちたかを思い起し、悔い改めて初めのわざを行いなさい。もし、そうしないで悔い改めなければ、わたしはあなたのところにきて、あなたの燭台をその場所から取りのけよう。"},{"ref":"Rev.2.6","start":66002006,"end":66002006,"break":"none","ruby":[[22,1,"しゅう"],[24,2,"ひとびと"],[30,1,"にく"],[43,1,"にく"]],"text":"しかし、こういうことはある、あなたはニコライ宗の人々のわざを憎んでおり、わたしもそれを憎んでいる。"},{"ref":"Rev.2.7","start":66002007,"end":66002007,"break":"none","ruby":[[0,1,"みみ"],[4,1,"もの"],[7,2,"みたま"],[10,1,"しょ"],[11,2,"きょうかい"],[14,1,"い"],[19,1,"き"],[25,2,"しょうり"],[28,1,"え"],[30,1,"もの"],[34,1,"かみ"],[48,1,"き"],[50,1,"み"],[52,1,"た"]],"text":"耳のある者は、御霊が諸教会に言うことを聞くがよい。勝利を得る者には、神のパラダイスにあるいのちの木の実を食べることをゆるそう』。"},{"ref":"Rev.2.8","start":66002008,"end":66002008,"break":"paragraph","breaks":[[25,"paragraph"]],"ruby":[[7,2,"きょうかい"],[10,2,"みつかい"],[16,1,"か"],[26,1,"はじ"],[32,1,"おわ"],[37,1,"もの"],[39,1,"し"],[48,1,"い"],[50,1,"かえ"],[53,1,"もの"],[56,1,"つぎ"],[61,1,"い"]],"text":"スミルナにある教会の御使に、こう書きおくりなさい。『初めであり、終りである者、死んだことはあるが生き返った者が、次のように言われる。"},{"ref":"Rev.2.9","start":66002009,"end":66002009,"break":"none","ruby":[[9,2,"くなん"],[13,1,"まず"],[17,1,"し"],[26,2,"じっさい"],[34,1,"と"],[49,1,"じん"],[51,1,"じ"],[52,1,"しょう"],[62,1,"じつ"],[66,1,"じん"],[75,2,"かいどう"],[78,1,"ぞく"],[81,1,"もの"],[100,1,"し"]],"text":"わたしは、あなたの苦難や、貧しさを知っている（しかし実際は、あなたは富んでいるのだ）。また、ユダヤ人と自称してはいるが、その実ユダヤ人でなくてサタンの会堂に属する者たちにそしられていることも、わたしは知っている。"},{"ref":"Rev.2.10","start":66002010,"end":66002010,"break":"none","ruby":[[4,1,"う"],[11,1,"くる"],[15,1,"おそ"],[24,1,"み"],[27,2,"あくま"],[42,1,"もの"],[51,1,"ごく"],[53,1,"い"],[70,1,"か"],[72,1,"あいだ"],[74,2,"くなん"],[84,1,"し"],[86,1,"いた"],[90,2,"ちゅうじつ"],[106,1,"かんむり"],[108,1,"あた"]],"text":"あなたの受けようとする苦しみを恐れてはならない。見よ、悪魔が、あなたがたのうちのある者をためすために、獄に入れようとしている。あなたがたは十日の間、苦難にあうであろう。死に至るまで忠実であれ。そうすれば、いのちの冠を与えよう。"},{"ref":"Rev.2.11","start":66002011,"end":66002011,"break":"none","ruby":[[0,1,"みみ"],[4,1,"もの"],[7,2,"みたま"],[10,1,"しょ"],[11,2,"きょうかい"],[14,1,"い"],[19,1,"き"],[25,2,"しょうり"],[28,1,"え"],[30,1,"もの"],[33,1,"だい"],[36,1,"し"],[41,1,"ほろ"]],"text":"耳のある者は、御霊が諸教会に言うことを聞くがよい。勝利を得る者は、第二の死によって滅ぼされることはない』。"},{"ref":"Rev.2.12","start":66002012,"end":66002012,"break":"paragraph","breaks":[[25,"paragraph"]],"ruby":[[7,2,"きょうかい"],[10,2,"みつかい"],[16,1,"か"],[26,1,"するど"],[30,1,"は"],[36,1,"も"],[45,1,"つぎ"],[50,1,"い"]],"text":"ペルガモにある教会の御使に、こう書きおくりなさい。『鋭いもろ刃のつるぎを持っているかたが、次のように言われる。"},{"ref":"Rev.2.13","start":66002013,"end":66002013,"break":"none","ruby":[[8,1,"す"],[13,1,"ところ"],[15,1,"し"],[29,1,"ざ"],[43,1,"な"],[45,1,"かた"],[47,1,"も"],[57,2,"ちゅうじつ"],[60,2,"しょうにん"],[72,1,"す"],[83,1,"ところ"],[85,1,"ころ"],[89,1,"とき"],[98,1,"たい"],[101,2,"しんこう"],[104,1,"す"]],"text":"わたしはあなたの住んでいる所を知っている。そこにはサタンの座がある。あなたは、わたしの名を堅く持ちつづけ、わたしの忠実な証人アンテパスがサタンの住んでいるあなたがたの所で殺された時でさえ、わたしに対する信仰を捨てなかった。"},{"ref":"Rev.2.14","start":66002014,"end":66002014,"break":"none","ruby":[[8,1,"たい"],[11,1,"せめ"],[19,1,"すこ"],[33,1,"なか"],[37,1,"げん"],[43,1,"おしえ"],[45,1,"ほう"],[50,1,"もの"],[64,1,"おし"],[66,1,"こ"],[75,1,"こ"],[78,1,"まえ"],[91,1,"お"],[96,2,"ぐうぞう"],[106,1,"た"],[113,3,"ふひんこう"]],"text":"しかし、あなたに対して責むべきことが、少しばかりある。あなたがたの中には、現にバラムの教を奉じている者がある。バラムは、バラクに教え込み、イスラエルの子らの前に、つまずきになるものを置かせて、偶像にささげたものを食べさせ、また不品行をさせたのである。"},{"ref":"Rev.2.15","start":66002015,"end":66002015,"break":"none","ruby":[[0,1,"おな"],[12,1,"なか"],[20,1,"しゅう"],[22,1,"おしえ"],[24,1,"ほう"],[29,1,"もの"]],"text":"同じように、あなたがたの中には、ニコライ宗の教を奉じている者もいる。"},{"ref":"Rev.2.16","start":66002016,"end":66002016,"break":"none","ruby":[[4,1,"く"],[6,1,"あらた"],[34,1,"い"],[41,1,"くち"],[50,1,"かれ"],[53,1,"たたか"]],"text":"だから、悔い改めなさい。そうしないと、わたしはすぐにあなたのところに行き、わたしの口のつるぎをもって彼らと戦おう。"},{"ref":"Rev.2.17","start":66002017,"end":66002017,"break":"none","ruby":[[0,1,"みみ"],[4,1,"もの"],[7,2,"みたま"],[10,1,"しょ"],[11,2,"きょうかい"],[14,1,"い"],[19,1,"き"],[25,2,"しょうり"],[28,1,"え"],[30,1,"もの"],[34,1,"かく"],[43,1,"あた"],[51,1,"しろ"],[53,1,"いし"],[55,1,"あた"],[62,1,"いし"],[64,1,"うえ"],[71,1,"う"],[74,1,"もの"],[81,1,"し"],[85,1,"あたら"],[88,1,"な"],[90,1,"か"]],"text":"耳のある者は、御霊が諸教会に言うことを聞くがよい。勝利を得る者には、隠されているマナを与えよう。また、白い石を与えよう。この石の上には、これを受ける者のほかだれも知らない新しい名が書いてある』。"},{"ref":"Rev.2.18","start":66002018,"end":66002018,"break":"paragraph","breaks":[[25,"paragraph"]],"ruby":[[7,2,"きょうかい"],[10,2,"みつかい"],[16,1,"か"],[26,1,"も"],[29,1,"ほのお"],[34,1,"め"],[36,1,"ひか"],[38,1,"かがや"],[49,1,"あし"],[52,1,"も"],[55,1,"かみ"],[57,1,"こ"],[60,1,"つぎ"],[65,1,"い"]],"text":"テアテラにある教会の御使に、こう書きおくりなさい。『燃える炎のような目と光り輝くしんちゅうのような足とを持った神の子が、次のように言われる。"},{"ref":"Rev.2.19","start":66002019,"end":66002019,"break":"none","ruby":[[17,1,"あい"],[19,2,"しんこう"],[22,2,"ほうし"],[25,2,"にんたい"],[29,1,"し"],[42,1,"のち"],[48,1,"はじ"],[63,1,"し"]],"text":"わたしは、あなたのわざと、あなたの愛と信仰と奉仕と忍耐とを知っている。また、あなたの後のわざが、初めのよりもまさっていることを知っている。"},{"ref":"Rev.2.20","start":66002020,"end":66002020,"break":"none","ruby":[[8,1,"たい"],[11,1,"せめ"],[35,1,"おんな"],[54,1,"おんな"],[56,1,"おんな"],[57,3,"よげんしゃ"],[61,1,"じ"],[62,1,"しょう"],[69,1,"しもべ"],[73,1,"おし"],[76,1,"まど"],[81,3,"ふひんこう"],[88,2,"ぐうぞう"],[98,1,"た"]],"text":"しかし、あなたに対して責むべきことがある。あなたは、あのイゼベルという女を、そのなすがままにさせている。この女は女預言者と自称し、わたしの僕たちを教え、惑わして、不品行をさせ、偶像にささげたものを食べさせている。"},{"ref":"Rev.2.21","start":66002021,"end":66002021,"break":"none","ruby":[[7,1,"おんな"],[9,1,"く"],[11,1,"あらた"],[17,1,"あた"],[22,1,"く"],[24,1,"あらた"],[29,3,"ふひんこう"]],"text":"わたしは、この女に悔い改めるおりを与えたが、悔い改めてその不品行をやめようとはしない。"},{"ref":"Rev.2.22","start":66002022,"end":66002022,"break":"none","ruby":[[0,1,"み"],[9,1,"おんな"],[11,1,"やまい"],[13,1,"とこ"],[15,1,"な"],[17,1,"い"],[23,1,"おんな"],[25,2,"かんいん"],[29,1,"もの"],[33,1,"く"],[35,1,"あらた"],[38,2,"かのじょ"],[45,1,"はな"],[52,1,"おお"],[55,2,"かんなん"],[58,1,"なか"],[60,1,"な"],[62,1,"い"]],"text":"見よ、わたしはこの女を病の床に投げ入れる。この女と姦淫する者をも、悔い改めて彼女のわざから離れなければ、大きな患難の中に投げ入れる。"},{"ref":"Rev.2.23","start":66002023,"end":66002023,"break":"none","ruby":[[5,1,"おんな"],[7,1,"こ"],[8,1,"とも"],[13,1,"う"],[15,1,"ころ"],[27,2,"きょうかい"],[35,1,"ひと"],[37,1,"こころ"],[39,2,"おくそこ"],[44,1,"さぐ"],[46,1,"し"],[48,1,"もの"],[55,1,"さと"],[85,1,"おう"],[88,1,"むく"]],"text":"また、この女の子供たちをも打ち殺そう。こうしてすべての教会は、わたしが人の心の奥底までも探り知る者であることを悟るであろう。そしてわたしは、あなたがたひとりびとりのわざに応じて報いよう。"},{"ref":"Rev.2.24","start":66002024,"end":66002024,"break":"none","ruby":[[13,1,"ひと"],[22,1,"おんな"],[24,1,"おしえ"],[26,1,"う"],[43,1,"ふか"],[47,1,"し"],[57,1,"い"],[64,1,"べつ"],[69,2,"おもに"],[79,1,"お"]],"text":"また、テアテラにいるほかの人たちで、まだあの女の教を受けておらず、サタンの、いわゆる「深み」を知らないあなたがたに言う。わたしは別にほかの重荷を、あなたがたに負わせることはしない。"},{"ref":"Rev.2.25","start":66002025,"end":66002025,"break":"none","ruby":[[7,1,"く"],[9,1,"とき"],[13,2,"じぶん"],[16,1,"も"],[24,1,"かた"],[26,1,"たも"]],"text":"ただ、わたしが来る時まで、自分の持っているものを堅く保っていなさい。"},{"ref":"Rev.2.26","start":66002026,"end":66002026,"break":"none","ruby":[[0,2,"しょうり"],[3,1,"え"],[5,1,"もの"],[14,2,"さいご"],[18,1,"も"],[20,1,"つづ"],[23,1,"もの"],[27,1,"しょ"],[28,2,"こくみん"],[31,2,"しはい"],[35,2,"けんい"],[38,1,"さづ"]],"text":"勝利を得る者、わたしのわざを最後まで持ち続ける者には、諸国民を支配する権威を授ける。"},{"ref":"Rev.2.27","start":66002027,"end":66002027,"break":"none","ruby":[[0,1,"かれ"],[2,1,"てつ"],[15,1,"つち"],[17,1,"うつわ"],[19,1,"くだ"],[25,1,"かれ"],[28,1,"おさ"],[43,2,"じしん"],[46,1,"ちち"],[49,2,"けんい"],[52,1,"う"],[55,1,"おさ"],[60,2,"どうよう"]],"text":"彼は鉄のつえをもって、ちょうど土の器を砕くように、彼らを治めるであろう。それは、わたし自身が父から権威を受けて治めるのと同様である。"},{"ref":"Rev.2.28","start":66002028,"end":66002028,"break":"none","ruby":[[7,1,"かれ"],[9,1,"あ"],[12,2,"みょうじょう"],[15,1,"あた"]],"text":"わたしはまた、彼に明けの明星を与える。"},{"ref":"Rev.2.29","start":66002029,"end":66002029,"break":"none","ruby":[[0,1,"みみ"],[4,1,"もの"],[7,2,"みたま"],[10,1,"しょ"],[11,2,"きょうかい"],[14,1,"い"],[19,1,"き"]],"text":"耳のある者は、御霊が諸教会に言うことを聞くがよい』。"}]