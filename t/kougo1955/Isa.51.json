[{"ref":"Isa.51.1","start":23051001,"end":23051001,"break":"paragraph","breaks":[[8,"line"],[25,"line"],[40,"line"]],"ruby":[[1,1,"ぎ"],[3,1,"お"],[5,1,"もと"],[8,1,"しゅ"],[10,1,"たず"],[12,1,"もと"],[15,1,"もの"],[22,1,"き"],[31,1,"き"],[33,1,"だ"],[37,1,"いわ"],[46,1,"ほ"],[48,1,"だ"],[52,1,"あな"],[55,1,"おも"]],"text":"「義を追い求め、主を尋ね求める者よ、わたしに聞け。あなたがたの切り出された岩と、あなたがたの掘り出された穴とを思いみよ。"},{"ref":"Isa.51.2","start":23051002,"end":23051002,"break":"line","breaks":[[14,"line"],[32,"line"],[53,"line"]],"ruby":[[6,1,"ちち"],[20,1,"う"],[27,1,"おも"],[36,1,"かれ"],[50,1,"め"],[53,1,"かれ"],[55,2,"しゅくふく"],[62,2,"しそん"],[65,1,"ま"],[67,1,"くわ"]],"text":"あなたがたの父アブラハムと、あなたがたを産んだサラとを思いみよ。わたしは彼をただひとりであったときに召し、彼を祝福して、その子孫を増し加えた。"},{"ref":"Isa.51.3","start":23051003,"end":23051003,"break":"line","breaks":[[9,"line"],[25,"line"],[38,"line"],[55,"line"],[75,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"なぐさ"],[16,1,"あ"],[19,1,"ところ"],[21,1,"なぐさ"],[27,2,"あらの"],[44,1,"しゅ"],[46,1,"その"],[62,1,"なか"],[64,1,"よろこ"],[67,1,"たの"],[75,2,"かんしゃ"],[78,1,"うた"],[80,1,"こえ"]],"text":"主はシオンを慰め、またそのすべて荒れた所を慰めて、その荒野をエデンのように、そのさばくを主の園のようにされる。こうして、その中に喜びと楽しみとがあり、感謝と歌の声とがある。"},{"ref":"Isa.51.4","start":23051004,"end":23051004,"break":"paragraph","breaks":[[12,"line"],[29,"line"],[39,"line"]],"ruby":[[2,1,"たみ"],[9,1,"き"],[14,1,"くに"],[23,1,"みみ"],[25,1,"かたむ"],[29,2,"りっぽう"],[37,1,"で"],[41,1,"みち"],[48,1,"たみ"],[50,1,"ひかり"]],"text":"わが民よ、わたしに聞け、わが国びとよ、わたしに耳を傾けよ。律法はわたしから出、わが道はもろもろの民の光となる。"},{"ref":"Isa.51.5","start":23051005,"end":23051005,"break":"line","breaks":[[13,"line"],[23,"line"],[38,"line"],[54,"line"]],"ruby":[[2,1,"ぎ"],[9,1,"ちか"],[15,1,"すくい"],[17,1,"で"],[19,1,"い"],[25,1,"うで"],[32,1,"たみ"],[34,1,"おさ"],[38,2,"うみぞ"],[42,2,"くにぐに"],[49,1,"ま"],[51,1,"のぞ"],[56,1,"うで"],[58,1,"よ"],[60,1,"たの"]],"text":"わが義はすみやかに近づき、わが救は出て行った。わが腕はもろもろの民を治める。海沿いの国々はわたしを待ち望み、わが腕に寄り頼む。"},{"ref":"Isa.51.6","start":23051006,"end":23051006,"break":"line","breaks":[[19,"line"],[40,"line"],[58,"line"],[76,"line"]],"ruby":[[0,1,"め"],[5,1,"てん"],[7,1,"み"],[9,2,"また"],[11,1,"した"],[14,1,"ち"],[16,1,"み"],[19,1,"てん"],[21,1,"けむり"],[26,1,"き"],[29,1,"ち"],[31,1,"ころも"],[42,1,"なか"],[44,1,"す"],[46,1,"もの"],[55,1,"し"],[64,1,"すくい"],[78,1,"ぎ"]],"text":"目をあげて天を見、また下なる地を見よ。天は煙のように消え、地は衣のようにふるび、その中に住む者は、ぶよのように死ぬ。しかし、わが救はとこしえにながらえ、わが義はくじけることがない。"},{"ref":"Isa.51.7","start":23051007,"end":23051007,"break":"paragraph","breaks":[[7,"line"],[30,"line"],[45,"line"]],"ruby":[[0,1,"ぎ"],[2,1,"し"],[4,1,"もの"],[7,1,"こころ"],[14,2,"りっぽう"],[20,1,"もの"],[27,1,"き"],[30,1,"ひと"],[36,1,"おそ"],[45,1,"かれ"],[53,1,"おどろ"]],"text":"義を知る者よ、心のうちにわが律法をたもつ者よ、わたしに聞け。人のそしりを恐れてはならない、彼らのののしりに驚いてはならない。"},{"ref":"Isa.51.8","start":23051008,"end":23051008,"break":"line","breaks":[[16,"line"],[33,"line"],[51,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ころも"],[12,1,"く"],[16,1,"ひつじ"],[18,1,"け"],[23,1,"むし"],[25,1,"く"],[39,1,"ぎ"],[53,1,"すくい"],[58,1,"よ"],[60,1,"およ"]],"text":"彼らは衣のように、しみに食われ、羊の毛のように虫に食われるからだ。しかし、わが義はとこしえにながらえ、わが救はよろず代に及ぶ」。"},{"ref":"Isa.51.9","start":23051009,"end":23051009,"break":"paragraph","breaks":[[7,"line"],[20,"line"],[44,"line"],[53,"line"]],"ruby":[[0,1,"しゅ"],[15,1,"ちから"],[17,1,"き"],[29,1,"ひ"],[31,1,"むかし"],[33,1,"よ"],[48,1,"き"],[50,1,"ころ"],[53,1,"りゅう"],[55,1,"さ"],[57,1,"つらぬ"]],"text":"主のかいなよ、さめよ、さめよ、力を着よ。さめて、いにしえの日、昔の代にあったようになれ。ラハブを切り殺し、龍を刺し貫いたのは、あなたではなかったか。"},{"ref":"Isa.51.10","start":23051010,"end":23051010,"break":"line","breaks":[[20,"line"],[29,"line"],[48,"line"]],"ruby":[[0,1,"うみ"],[7,1,"おお"],[11,1,"ふち"],[13,1,"みず"],[22,1,"うみ"],[24,1,"ふか"],[26,1,"ところ"],[35,1,"もの"],[37,1,"す"],[40,1,"みち"]],"text":"海をかわかし、大いなる淵の水をかわかし、また海の深き所を、あがなわれた者の過ぎる道とされたのは、あなたではなかったか。"},{"ref":"Isa.51.11","start":23051011,"end":23051011,"break":"line","breaks":[[11,"line"],[28,"line"],[48,"line"],[61,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"もの"],[11,1,"うた"],[22,1,"かえ"],[40,1,"よろこ"],[48,1,"かれ"],[51,1,"よろこ"],[54,1,"たの"],[59,1,"え"],[61,1,"かな"],[65,1,"なげ"],[69,1,"に"],[71,1,"さ"]],"text":"主にあがなわれた者は、歌うたいつつ、シオンに帰ってきて、そのこうべに、とこしえの喜びをいただき、彼らは喜びと楽しみとを得、悲しみと嘆きとは逃げ去る。"},{"ref":"Isa.51.12","start":23051012,"end":23051012,"break":"line","breaks":[[16,"line"],[35,"line"]],"ruby":[[10,1,"なぐさ"],[13,1,"もの"],[20,2,"なにもの"],[26,1,"し"],[30,1,"ひと"],[32,1,"おそ"],[35,1,"くさ"],[44,1,"ひと"],[46,1,"こ"],[48,1,"おそ"]],"text":"「わたしこそあなたを慰める者だ。あなたは何者なれば、死ぬべき人を恐れ、草のようになるべき人の子を恐れるのか。"},{"ref":"Isa.51.13","start":23051013,"end":23051013,"break":"line","breaks":[[14,"line"],[28,"line"],[51,"line"],[71,"line"]],"ruby":[[0,1,"てん"],[5,1,"ち"],[7,1,"もとい"],[18,1,"つく"],[20,1,"ぬし"],[22,1,"しゅ"],[24,1,"わす"],[36,1,"もの"],[38,1,"ほろ"],[43,1,"そな"],[53,1,"いきどお"],[59,1,"つね"],[65,1,"おそ"],[76,1,"もの"],[78,1,"いきどお"]],"text":"天をのべ、地の基をすえられたあなたの造り主、主を忘れて、なぜ、しえたげる者が滅ぼそうと備えをするとき、その憤りのゆえに常にひねもす恐れるのか。しえたげる者の憤りはどこにあるか。"},{"ref":"Isa.51.14","start":23051014,"end":23051014,"break":"line","breaks":[[24,"line"],[41,"line"]],"ruby":[[0,1,"み"],[8,1,"とら"],[11,1,"びと"],[19,1,"と"],[24,1,"し"],[31,1,"あな"],[43,2,"しょくもつ"]],"text":"身をかがめている捕われ人は、すみやかに解かれて、死ぬことなく、穴にくだることなく、その食物はつきることがない。"},{"ref":"Isa.51.15","start":23051015,"end":23051015,"break":"line","breaks":[[11,"line"],[33,"line"]],"ruby":[[4,1,"うみ"],[13,1,"なみ"],[26,1,"かみ"],[28,1,"しゅ"],[35,1,"な"],[37,2,"ばんぐん"],[40,1,"しゅ"]],"text":"わたしは海をふるわせ、その波をなりどよめかすあなたの神、主である。その名を万軍の主という。"},{"ref":"Isa.51.16","start":23051016,"end":23051016,"break":"line","breaks":[[18,"line"],[32,"line"],[53,"line"]],"ruby":[[6,2,"ことば"],[13,1,"くち"],[20,1,"て"],[22,1,"かげ"],[28,1,"かく"],[41,1,"てん"],[46,1,"ち"],[48,1,"もとい"],[68,1,"たみ"],[73,1,"い"]],"text":"わたしはわが言葉をあなたの口におき、わが手の陰にあなたを隠した。こうして、わたしは天をのべ、地の基をすえ、シオンにむかって、あなたはわが民であると言う」。"},{"ref":"Isa.51.17","start":23051017,"end":23051017,"break":"paragraph","breaks":[[18,"line"],[41,"line"]],"ruby":[[7,1,"お"],[11,1,"お"],[15,1,"た"],[25,1,"しゅ"],[27,1,"て"],[30,1,"いきどお"],[33,1,"さかずき"],[38,1,"の"],[46,2,"おおさかずき"],[50,1,"おり"],[54,1,"の"]],"text":"エルサレムよ、起きよ、起きよ、立て。あなたはさきに主の手から憤りの杯をうけて飲み、よろめかす大杯を、滓までも飲みほした。"},{"ref":"Isa.51.18","start":23051018,"end":23051018,"break":"line","breaks":[[16,"line"],[25,"line"],[41,"line"]],"ruby":[[2,1,"う"],[10,1,"こ"],[16,2,"じぶん"],[19,1,"みちび"],[21,1,"もの"],[27,1,"そだ"],[35,1,"こ"],[41,2,"じぶん"],[44,1,"て"],[48,1,"もの"]],"text":"その産んだもろもろの子のなかに、自分を導く者なく、その育てたもろもろの子のなかに、自分の手をとる者がない。"},{"ref":"Isa.51.19","start":23051019,"end":23051019,"break":"line","breaks":[[17,"line"],[34,"line"],[48,"line"]],"ruby":[[6,1,"こと"],[12,1,"のぞ"],[24,1,"とも"],[26,1,"なげ"],[34,2,"こうはい"],[37,2,"めつぼう"],[55,1,"なぐさ"]],"text":"これら二つの事があなたに臨んだ――だれがあなたと共に嘆くだろうか――荒廃と滅亡、ききんとつるぎ。だれがあなたを慰めるだろうか。"},{"ref":"Isa.51.20","start":23051020,"end":23051020,"break":"line","breaks":[[16,"line"],[32,"line"],[48,"line"],[65,"line"]],"ruby":[[4,1,"こ"],[7,1,"いき"],[8,1,"た"],[16,1,"あみ"],[43,1,"よこ"],[48,1,"しゅ"],[50,1,"いきどお"],[58,1,"かみ"],[60,1,"せ"],[65,1,"かれ"],[68,1,"み"]],"text":"あなたの子らは息絶えだえになり、網にかかった、かもしかのように、すべてのちまたのすみに横たわり、主の憤りと、あなたの神の責めとは、彼らに満ちている。"},{"ref":"Isa.51.21","start":23051021,"end":23051021,"break":"paragraph","breaks":[[11,"line"]],"ruby":[[5,1,"くる"],[9,1,"もの"],[11,1,"さけ"],[17,1,"よ"],[22,1,"もの"],[28,1,"き"]],"text":"それゆえ、苦しめる者、酒にではなく酔っている者よ、これを聞け。"},{"ref":"Isa.51.22","start":23051022,"end":23051022,"break":"line","breaks":[[19,"line"],[34,"line"],[49,"line"],[61,"line"],[75,"line"]],"ruby":[[4,1,"しゅ"],[9,1,"たみ"],[11,1,"うった"],[14,2,"べんご"],[23,1,"かみ"],[25,1,"しゅ"],[29,1,"い"],[35,1,"み"],[47,1,"さかずき"],[53,1,"て"],[56,1,"と"],[58,1,"のぞ"],[63,1,"いきどお"],[66,2,"おおさかずき"],[69,1,"と"],[71,1,"のぞ"],[79,1,"ふたた"],[84,1,"の"]],"text":"あなたの主、おのが民の訴えを弁護されるあなたの神、主はこう言われる、「見よ、わたしはよろめかす杯をあなたの手から取り除き、わが憤りの大杯を取り除いた。あなたは再びこれを飲むことはない。"},{"ref":"Isa.51.23","start":23051023,"end":23051023,"break":"line","breaks":[[21,"line"],[39,"line"],[61,"line"],[79,"line"],[89,"line"]],"ruby":[[11,1,"なや"],[14,1,"もの"],[16,1,"て"],[21,1,"かれ"],[35,1,"い"],[40,1,"み"],[52,1,"こ"],[70,1,"せ"],[72,1,"ち"],[89,1,"かれ"],[92,1,"こ"]],"text":"わたしはこれをあなたを悩ます者の手におく。彼らはさきにあなたにむかって言った、『身をかがめよ、われわれは越えていこう』と。そしてあなたはその背を地のようにし、ちまたのようにして、彼らの越えていくにまかせた」。"}]