[{"ref":"Dan.6.1","start":27006001,"end":27006001,"break":"paragraph","ruby":[[5,2,"ぜんこく"],[8,1,"おさ"],[17,1,"くに"],[22,1,"にん"],[24,2,"そうとく"],[27,1,"た"]],"text":"ダリヨスは全国を治めるために、その国に百二十人の総督を立てることをよしとし、"},{"ref":"Dan.6.2","start":27006002,"end":27006002,"break":"none","ruby":[[2,1,"かれ"],[5,1,"うえ"],[8,1,"にん"],[10,2,"そうかん"],[13,1,"た"],[35,2,"そうとく"],[46,1,"にん"],[48,1,"まえ"],[53,2,"しょくむ"],[56,1,"かん"],[59,2,"ほうこく"],[66,1,"おう"],[68,2,"そんしつ"],[71,1,"およ"]],"text":"また彼らの上に三人の総監を立てた。ダニエルはそのひとりであった。これは総督たちをして、この三人の前に、その職務に関する報告をさせて、王に損失の及ぶことのないようにするためであった。"},{"ref":"Dan.6.3","start":27006003,"end":27006003,"break":"none","ruby":[[5,1,"かれ"],[16,1,"れい"],[22,1,"た"],[28,2,"そうかん"],[33,2,"そうとく"],[47,1,"おう"],[49,1,"かれ"],[51,1,"た"],[54,2,"ぜんこく"],[57,1,"おさ"]],"text":"ダニエルは彼のうちにあるすぐれた霊のゆえに、他のすべての総監および総督たちにまさっていたので、王は彼を立てて全国を治めさせようとした。"},{"ref":"Dan.6.4","start":27006004,"end":27006004,"break":"none","ruby":[[3,2,"そうかん"],[8,2,"そうとく"],[13,2,"こくじ"],[24,1,"うった"],[29,2,"こうじつ"],[32,1,"え"],[40,1,"うった"],[48,2,"こうじつ"],[59,1,"み"],[76,1,"かれ"],[78,2,"ちゅうしん"],[81,1,"ひと"],[89,1,"み"],[103,1,"み"]],"text":"そこで総監および総督らは、国事についてダニエルを訴えるべき口実を得ようとしたが、訴えるべきなんの口実も、なんのとがをも見いだすことができなかった。それは彼が忠信な人であって、その身になんのあやまちも、とがも見いだされなかったからである。"},{"ref":"Dan.6.5","start":27006005,"end":27006005,"break":"none","ruby":[[5,2,"ひとびと"],[8,1,"い"],[23,1,"かみ"],[25,2,"りっぽう"],[28,1,"かん"],[32,1,"かれ"],[34,1,"うった"],[37,2,"こうじつ"],[40,1,"え"],[52,1,"かれ"],[54,1,"うった"]],"text":"そこでその人々は言った、「われわれはダニエルの神の律法に関して、彼を訴える口実を得るのでなければ、ついに彼を訴えることはできまい」と。"},{"ref":"Dan.6.6","start":27006006,"end":27006006,"break":"paragraph","ruby":[[4,2,"そうかん"],[7,2,"そうとく"],[12,1,"おう"],[17,1,"あつ"],[24,1,"おう"],[26,1,"い"],[35,1,"おう"],[46,1,"い"]],"text":"こうして総監と総督らは、王のもとに集まってきて、王に言った、「ダリヨス王よ、どうかとこしえに生きながらえられますように。"},{"ref":"Dan.6.7","start":27006007,"end":27006007,"break":"none","ruby":[[0,1,"くに"],[2,2,"そうかん"],[5,2,"ちょうかん"],[10,2,"そうとく"],[13,2,"さんぎ"],[18,2,"ちじ"],[23,1,"あい"],[29,1,"おう"],[38,1,"た"],[44,2,"きんれい"],[47,1,"さだ"],[54,1,"もと"],[66,1,"おう"],[81,1,"いま"],[86,1,"にち"],[88,1,"あいだ"],[99,1,"ねが"],[101,1,"ごと"],[116,1,"かみ"],[120,1,"ひと"],[127,1,"もの"],[138,1,"もの"],[144,1,"あな"],[146,1,"な"],[148,1,"い"]],"text":"国の総監、長官および総督、参議および知事らは、相はかって、王が一つのおきてを立て、一つの禁令を定められるよう求めることになりました。王よ、それはこうです。すなわち今から三十日の間は、ただあなたにのみ願い事をさせ、もしあなたをおいて、神または人にこれをなす者があれば、すべてその者を、ししの穴に投げ入れるというのです。"},{"ref":"Dan.6.8","start":27006008,"end":27006008,"break":"none","ruby":[[3,1,"おう"],[8,2,"きんれい"],[11,1,"さだ"],[16,2,"ぶんしょ"],[19,2,"しょめい"],[33,1,"かわ"],[40,2,"ほうりつ"],[50,1,"か"]],"text":"それで王よ、その禁令を定め、その文書に署名して、メデアとペルシャの変ることのない法律のごとく、これを変えることのできないようにしてください」。"},{"ref":"Dan.6.9","start":27006009,"end":27006009,"break":"none","ruby":[[7,1,"おう"],[12,2,"きんれい"],[15,2,"ぶんしょ"],[18,2,"しょめい"]],"text":"そこでダリヨス王は、その禁令の文書に署名した。"},{"ref":"Dan.6.10","start":27006010,"end":27006010,"break":"paragraph","ruby":[[8,2,"ぶんしょ"],[11,2,"しょめい"],[19,1,"し"],[22,1,"いえ"],[24,1,"かえ"],[28,1,"かい"],[40,1,"む"],[44,1,"まど"],[46,1,"ひら"],[50,1,"ところ"],[53,2,"いぜん"],[69,1,"にち"],[72,1,"ど"],[83,1,"かみ"],[85,1,"まえ"],[87,1,"いの"],[92,2,"かんしゃ"]],"text":"ダニエルは、その文書の署名されたことを知って家に帰り、二階のへやの、エルサレムに向かって窓の開かれた所で、以前からおこなっていたように、一日に三度ずつ、ひざをかがめて神の前に祈り、かつ感謝した。"},{"ref":"Dan.6.11","start":27006011,"end":27006011,"break":"none","ruby":[[5,2,"ひとびと"],[8,1,"あつ"],[22,1,"かみ"],[24,1,"まえ"],[26,1,"いの"],[31,1,"もと"],[39,1,"み"]],"text":"そこでその人々は集まってきて、ダニエルがその神の前に祈り、かつ求めていることを見たので、"},{"ref":"Dan.6.12","start":27006012,"end":27006012,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おう"],[5,1,"まえ"],[10,1,"おう"],[12,2,"きんれい"],[18,2,"そうじょう"],[22,1,"い"],[27,1,"おう"],[34,2,"きんれい"],[37,2,"しょめい"],[42,1,"いま"],[47,1,"にち"],[49,1,"あいだ"],[60,1,"ねが"],[62,1,"ごと"],[77,1,"かみ"],[81,1,"ひと"],[89,1,"もの"],[100,1,"もの"],[106,1,"あな"],[108,1,"な"],[110,1,"い"],[115,1,"さだ"],[130,1,"おう"],[132,1,"こた"],[135,1,"い"],[142,1,"こと"],[144,1,"たし"],[160,2,"ほうりつ"],[167,1,"か"]],"text":"彼らは王の前にきて、王の禁令について奏上して言った、「王よ、あなたは禁令に署名して、今から三十日の間は、ただあなたにのみ願い事をさせ、もしあなたをおいて、神または人に、これをなす者があれば、すべてその者を、ししの穴に投げ入れると、定められたではありませんか」。王は答えて言った、「その事は確かであって、メデアとペルシャの法律のごとく、変えることのできないものだ」。"},{"ref":"Dan.6.13","start":27006013,"end":27006013,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おう"],[5,1,"まえ"],[7,1,"こた"],[10,1,"い"],[15,1,"おう"],[22,1,"ひ"],[27,2,"ほしゅう"],[55,2,"しょめい"],[60,2,"きんれい"],[64,1,"かえり"],[69,1,"にち"],[72,1,"ど"],[76,1,"いのり"]],"text":"彼らは王の前に答えて言った、「王よ、ユダから引いてきた捕囚のひとりである、かのダニエルは、あなたをも、あなたの署名された禁令をも顧みず、一日に三度ずつ、祈をささげています」。"},{"ref":"Dan.6.14","start":27006014,"end":27006014,"break":"paragraph","ruby":[[0,1,"おう"],[4,2,"ことば"],[7,1,"き"],[10,1,"おお"],[13,1,"うれ"],[21,1,"すく"],[25,1,"こころ"],[27,1,"もち"],[30,1,"ひ"],[32,1,"い"],[37,1,"かれ"],[39,1,"すく"],[41,1,"だ"],[46,1,"つと"]],"text":"王はこの言葉を聞いて大いに憂え、ダニエルを救おうと心を用い、日の入るまで、彼を救い出すことに努めた。"},{"ref":"Dan.6.15","start":27006015,"end":27006015,"break":"none","ruby":[[0,1,"とき"],[4,2,"ひとびと"],[10,1,"おう"],[15,1,"あつ"],[22,1,"おう"],[24,1,"い"],[29,1,"おう"],[41,2,"ほうりつ"],[48,1,"おう"],[50,1,"た"],[53,2,"きんれい"],[64,1,"か"],[84,2,"しょうち"]],"text":"時にその人々は、また王のもとに集まってきて、王に言った、「王よ、メデアとペルシャの法律によれば、王の立てた禁令、または、おきては変えることのできないものであることを、ご承知ください」。"},{"ref":"Dan.6.16","start":27006016,"end":27006016,"break":"paragraph","ruby":[[3,1,"おう"],[5,2,"めいれい"],[8,1,"くだ"],[19,1,"ひ"],[21,1,"だ"],[29,1,"あな"],[31,1,"な"],[33,1,"い"],[39,1,"おう"],[46,1,"い"],[59,1,"つね"],[61,1,"つか"],[64,1,"かみ"],[71,1,"すく"]],"text":"そこで王は命令を下したので、ダニエルは引き出されて、ししの穴に投げ入れられた。王はダニエルに言った、「どうか、あなたの常に仕える神が、あなたを救われるように」。"},{"ref":"Dan.6.17","start":27006017,"end":27006017,"break":"none","ruby":[[6,1,"いし"],[8,1,"も"],[14,1,"あな"],[16,1,"くち"],[25,1,"おう"],[27,2,"じぶん"],[30,1,"いん"],[33,2,"だいじん"],[37,1,"いん"],[46,2,"ふういん"],[59,2,"しょち"],[62,1,"か"]],"text":"そして一つの石を持ってきて、穴の口をふさいだので、王は自分の印と、大臣らの印をもって、これに封印した。これはダニエルの処置を変えることのないようにするためであった。"},{"ref":"Dan.6.18","start":27006018,"end":27006018,"break":"none","ruby":[[4,1,"おう"],[8,2,"きゅうでん"],[11,1,"かえ"],[18,1,"よる"],[20,1,"しょく"],[35,1,"め"],[37,1,"よ"],[41,1,"まった"],[43,1,"ねむ"]],"text":"こうして王はその宮殿に帰ったが、その夜は食をとらず、また、そばめたちを召し寄せず、全く眠ることもしなかった。"},{"ref":"Dan.6.19","start":27006019,"end":27006019,"break":"paragraph","ruby":[[4,1,"おう"],[6,1,"あさ"],[10,1,"お"],[17,1,"あな"],[19,1,"いそ"],[22,1,"い"]],"text":"こうして王は朝まだき起きて、ししの穴へ急いで行ったが、"},{"ref":"Dan.6.20","start":27006020,"end":27006020,"break":"none","ruby":[[7,1,"あな"],[9,1,"ちか"],[16,1,"かな"],[20,1,"こえ"],[25,1,"よ"],[35,1,"い"],[40,1,"い"],[43,1,"かみ"],[58,1,"つね"],[60,1,"つか"],[65,1,"かみ"],[71,1,"すく"],[78,1,"がい"],[80,1,"まぬか"]],"text":"ダニエルのいる穴に近づいたとき、悲しげな声をあげて呼ばわり、ダニエルに言った、「生ける神のしもべダニエルよ、あなたが常に仕えている神はあなたを救って、ししの害を免れさせることができたか」。"},{"ref":"Dan.6.21","start":27006021,"end":27006021,"break":"none","ruby":[[5,1,"おう"],[7,1,"い"],[12,1,"おう"],[24,1,"い"]],"text":"ダニエルは王に言った、「王よ、どうか、とこしえに生きながらえられますように。"},{"ref":"Dan.6.22","start":27006022,"end":27006022,"break":"none","ruby":[[4,1,"かみ"],[8,1,"つかい"],[18,1,"くち"],[20,1,"と"],[35,1,"がい"],[51,1,"つみ"],[59,1,"かみ"],[61,1,"まえ"],[63,1,"みと"],[73,1,"おう"],[84,1,"まえ"],[88,1,"なに"],[90,1,"わる"],[92,1,"こと"]],"text":"わたしの神はその使をおくって、ししの口を閉ざされたので、ししはわたしを害しませんでした。これはわたしに罪のないことが、神の前に認められたからです。王よ、わたしはあなたの前にも、何も悪い事をしなかったのです」。"},{"ref":"Dan.6.23","start":27006023,"end":27006023,"break":"none","ruby":[[3,1,"おう"],[5,1,"おお"],[8,1,"よろこ"],[16,1,"あな"],[18,1,"なか"],[21,1,"だ"],[24,1,"めい"],[35,1,"あな"],[37,1,"なか"],[40,1,"だ"],[48,1,"み"],[53,1,"がい"],[56,1,"う"],[68,1,"かれ"],[70,2,"じぶん"],[73,1,"かみ"],[75,1,"たの"]],"text":"そこで王は大いに喜び、ダニエルを穴の中から出せと命じたので、ダニエルは穴の中から出されたが、その身になんの害をも受けていなかった。これは彼が自分の神を頼みとしていたからである。"},{"ref":"Dan.6.24","start":27006024,"end":27006024,"break":"none","ruby":[[0,1,"おう"],[4,2,"めいれい"],[7,1,"くだ"],[21,1,"うった"],[24,2,"ひとびと"],[27,1,"ひ"],[34,1,"かれ"],[39,2,"さいし"],[42,1,"とも"],[48,1,"あな"],[50,1,"な"],[52,1,"い"],[58,1,"かれ"],[61,1,"あな"],[63,1,"そこ"],[65,1,"たっ"],[76,1,"かれ"],[88,1,"ほね"],[94,1,"くだ"]],"text":"王はまた命令を下して、ダニエルをあしざまに訴えた人々を引いてこさせ、彼らをその妻子と共に、ししの穴に投げ入れさせた。彼らが穴の底に達しないうちに、ししは彼らにとびかかって、その骨までもかみ砕いた。"},{"ref":"Dan.6.25","start":27006025,"end":27006025,"break":"paragraph","ruby":[[7,1,"おう"],[9,1,"ぜん"],[10,2,"せかい"],[13,1,"す"],[15,2,"しょみん"],[18,1,"しょ"],[19,1,"ぞく"],[21,2,"しょこく"],[23,1,"ご"],[25,1,"もの"],[27,1,"みことのり"],[29,1,"か"],[35,1,"い"],[50,2,"へいあん"],[53,1,"ま"]],"text":"そこでダリヨス王は全世界に住む諸民、諸族、諸国語の者に詔を書きおくって言った、「どうか、あなたがたに平安が増すように。"},{"ref":"Dan.6.26","start":27006026,"end":27006026,"break":"none","breaks":[[47,"stanza"],[58,"line"],[70,"line"]],"ruby":[[4,2,"めいれい"],[7,1,"だ"],[12,1,"くに"],[18,1,"しゅう"],[20,1,"ひと"],[23,1,"みな"],[29,1,"かみ"],[36,1,"おそ"],[47,1,"かれ"],[49,1,"い"],[52,1,"かみ"],[63,1,"かわ"],[72,1,"くに"],[74,1,"ほろ"],[80,2,"しゅけん"],[83,1,"おわ"],[87,1,"つづ"]],"text":"わたしは命令を出す。わが国のすべての州の人は、皆ダニエルの神を、おののき恐れなければならない。彼は生ける神であって、とこしえに変ることなく、その国は滅びず、その主権は終りまで続く。"},{"ref":"Dan.6.27","start":27006027,"end":27006027,"break":"line","breaks":[[13,"line"],[27,"line"],[40,"line"],[49,"line"]],"ruby":[[0,1,"かれ"],[2,1,"すくい"],[4,1,"ほどこ"],[7,1,"たす"],[13,1,"てん"],[20,1,"ち"],[31,2,"きせき"],[45,1,"すく"],[52,1,"ちから"]],"text":"彼は救を施し、助けをなし、天においても、地においても、しるしと奇跡とをおこない、ダニエルを救って、ししの力をのがれさせたかたである」。"},{"ref":"Dan.6.28","start":27006028,"end":27006028,"break":"paragraph","ruby":[[17,1,"よ"],[24,1,"ひと"],[29,1,"よ"],[34,1,"さか"]],"text":"こうして、このダニエルはダリヨスの世と、ペルシャ人クロスの世において栄えた。"}]