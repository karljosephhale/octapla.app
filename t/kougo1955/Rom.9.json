[{"ref":"Rom.9.1","start":45009001,"end":45009001,"break":"paragraph","ruby":[[12,2,"しんじつ"],[15,1,"かた"],[18,1,"いつわ"],[21,1,"い"],[30,2,"りょうしん"],[33,2,"せいれい"]],"text":"わたしはキリストにあって真実を語る。偽りは言わない。わたしの良心も聖霊によって、わたしにこうあかしをしている。"},{"ref":"Rom.9.2","start":45009002,"end":45009002,"break":"none","ruby":[[9,1,"おお"],[12,1,"かな"],[23,1,"こころ"],[25,1,"た"],[29,1,"いた"]],"text":"すなわち、わたしに大きな悲しみがあり、わたしの心に絶えざる痛みがある。"},{"ref":"Rom.9.3","start":45009003,"end":45009003,"break":"none","ruby":[[0,2,"じっさい"],[7,2,"きょうだい"],[10,1,"にく"],[14,2,"どうぞく"],[28,1,"み"],[42,1,"はな"]],"text":"実際、わたしの兄弟、肉による同族のためなら、わたしのこの身がのろわれて、キリストから離されてもいとわない。"},{"ref":"Rom.9.4","start":45009004,"end":45009004,"break":"none","ruby":[[0,1,"かれ"],[8,1,"びと"],[14,1,"こ"],[17,2,"みぶん"],[20,1,"さづ"],[29,2,"えいこう"],[38,2,"けいやく"],[42,2,"りっぽう"],[45,1,"さづ"],[54,2,"れいはい"],[58,2,"かずかず"],[61,2,"やくそく"],[64,1,"かれ"]],"text":"彼らはイスラエル人であって、子たる身分を授けられることも、栄光も、もろもろの契約も、律法を授けられることも、礼拝も、数々の約束も彼らのもの、"},{"ref":"Rom.9.5","start":45009005,"end":45009005,"break":"none","ruby":[[2,2,"ふそ"],[7,1,"かれ"],[16,1,"にく"],[28,1,"かれ"],[32,1,"で"],[41,2,"ばんぶつ"],[44,1,"うえ"],[49,1,"かみ"],[52,2,"えいえん"]],"text":"また父祖たちも彼らのものであり、肉によればキリストもまた彼らから出られたのである。万物の上にいます神は、永遠にほむべきかな、アァメン。"},{"ref":"Rom.9.6","start":45009006,"end":45009006,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"ことば"],[8,2,"むこう"],[36,1,"で"],[38,1,"もの"],[40,2,"ぜんぶ"]],"text":"しかし、神の言が無効になったというわけではない。なぜなら、イスラエルから出た者が全部イスラエルなのではなく、"},{"ref":"Rom.9.7","start":45009007,"end":45009007,"break":"none","ruby":[[9,2,"しそん"],[21,2,"ぜんぶ"],[24,1,"こ"],[49,1,"で"],[51,1,"もの"],[58,2,"しそん"],[61,1,"よ"]],"text":"また、アブラハムの子孫だからといって、その全部が子であるのではないからである。かえって「イサクから出る者が、あなたの子孫と呼ばれるであろう」。"},{"ref":"Rom.9.8","start":45009008,"end":45009008,"break":"none","ruby":[[5,1,"にく"],[7,1,"こ"],[13,1,"かみ"],[15,1,"こ"],[26,2,"やくそく"],[29,1,"こ"],[31,2,"しそん"],[36,1,"みと"]],"text":"すなわち、肉の子がそのまま神の子なのではなく、むしろ約束の子が子孫として認められるのである。"},{"ref":"Rom.9.9","start":45009009,"end":45009009,"break":"none","ruby":[[0,2,"やくそく"],[3,2,"ことば"],[13,2,"らいねん"],[16,1,"いま"],[26,1,"く"],[36,2,"だんし"],[39,1,"あた"]],"text":"約束の言葉はこうである。「来年の今ごろ、わたしはまた来る。そして、サラに男子が与えられるであろう」。"},{"ref":"Rom.9.10","start":45009010,"end":45009010,"break":"none","ruby":[[14,1,"ひと"],[27,2,"ふそ"],[36,2,"じゅたい"],[44,2,"ばあい"],[50,2,"どうよう"]],"text":"そればかりではなく、ひとりの人、すなわち、わたしたちの父祖イサクによって受胎したリベカの場合も、また同様である。"},{"ref":"Rom.9.11","start":45009011,"end":45009011,"break":"none","ruby":[[2,2,"こども"],[6,1,"うま"],[12,1,"ぜん"],[14,1,"あく"],[19,1,"さき"],[22,1,"かみ"],[24,1,"えら"],[27,2,"けいかく"]],"text":"まだ子供らが生れもせず、善も悪もしない先に、神の選びの計画が、"},{"ref":"Rom.9.12","start":45009012,"end":45009012,"break":"none","ruby":[[7,1,"め"],[16,1,"おこな"],[25,1,"あに"],[27,1,"おとうと"],[29,1,"つか"],[39,2,"かのじょ"],[42,1,"おお"]],"text":"わざによらず、召したかたによって行われるために、「兄は弟に仕えるであろう」と、彼女に仰せられたのである。"},{"ref":"Rom.9.13","start":45009013,"end":45009013,"break":"none","ruby":[[9,1,"あい"],[15,1,"にく"],[20,1,"か"]],"text":"「わたしはヤコブを愛しエサウを憎んだ」と書いてあるとおりである。"},{"ref":"Rom.9.14","start":45009014,"end":45009014,"break":"paragraph","ruby":[[12,1,"い"],[17,1,"かみ"],[19,1,"がわ"],[21,2,"ふせい"],[29,1,"だん"]],"text":"では、わたしたちはなんと言おうか。神の側に不正があるのか。断じてそうではない。"},{"ref":"Rom.9.15","start":45009015,"end":45009015,"break":"none","ruby":[[0,1,"かみ"],[6,1,"い"],[16,2,"じぶん"],[27,1,"もの"],[43,1,"もの"]],"text":"神はモーセに言われた、「わたしは自分のあわれもうとする者をあわれみ、いつくしもうとする者を、いつくしむ」。"},{"ref":"Rom.9.16","start":45009016,"end":45009016,"break":"none","ruby":[[7,2,"にんげん"],[10,2,"いし"],[13,2,"どりょく"],[26,1,"かみ"]],"text":"ゆえに、それは人間の意志や努力によるのではなく、ただ神のあわれみによるのである。"},{"ref":"Rom.9.17","start":45009017,"end":45009017,"break":"none","ruby":[[0,2,"せいしょ"],[8,1,"い"],[23,1,"た"],[31,1,"こと"],[55,1,"ちから"],[69,1,"な"],[71,1,"ぜん"],[72,2,"せかい"],[75,1,"い"]],"text":"聖書はパロにこう言っている、「わたしがあなたを立てたのは、この事のためである。すなわち、あなたによってわたしの力をあらわし、また、わたしの名が全世界に言いひろめられるためである」。"},{"ref":"Rom.9.18","start":45009018,"end":45009018,"break":"none","ruby":[[4,1,"かみ"],[14,1,"おも"],[16,1,"もの"],[32,1,"おも"],[34,1,"もの"]],"text":"だから、神はそのあわれもうと思う者をあわれみ、かたくなにしようと思う者を、かたくなになさるのである。"},{"ref":"Rom.9.19","start":45009019,"end":45009019,"break":"paragraph","ruby":[[8,1,"い"],[18,1,"かみ"],[24,1,"ひと"],[26,1,"せ"],[38,1,"かみ"],[40,2,"いと"],[43,1,"さか"],[46,1,"え"]],"text":"そこで、あなたは言うであろう、「なぜ神は、なおも人を責められるのか。だれが、神の意図に逆らい得ようか」。"},{"ref":"Rom.9.20","start":45009020,"end":45009020,"break":"none","ruby":[[2,1,"ひと"],[10,1,"かみ"],[12,1,"い"],[14,1,"さか"],[25,2,"なにもの"],[31,1,"つく"],[38,1,"つく"],[41,1,"もの"],[43,1,"む"],[61,1,"つく"],[68,1,"い"]],"text":"ああ人よ。あなたは、神に言い逆らうとは、いったい、何者なのか。造られたものが造った者に向かって、「なぜ、わたしをこのように造ったのか」と言うことがあろうか。"},{"ref":"Rom.9.21","start":45009021,"end":45009021,"break":"none","ruby":[[0,2,"とうき"],[3,1,"つく"],[5,1,"もの"],[8,1,"おな"],[10,1,"つち"],[19,1,"たっと"],[21,1,"うつわ"],[24,1,"ほか"],[26,1,"いや"],[29,1,"うつわ"],[31,1,"つく"],[36,2,"けんのう"]],"text":"陶器を造る者は、同じ土くれから、一つを尊い器に、他を卑しい器に造りあげる権能がないのであろうか。"},{"ref":"Rom.9.22","start":45009022,"end":45009022,"break":"none","ruby":[[3,1,"かみ"],[5,1,"いか"],[17,2,"じしん"],[20,1,"ちから"],[22,1,"し"],[28,1,"おも"],[35,1,"ほろ"],[46,1,"いか"],[49,1,"うつわ"],[52,1,"おお"],[56,2,"かんよう"],[62,1,"しの"]],"text":"もし、神が怒りをあらわし、かつ、ご自身の力を知らせようと思われつつも、滅びることになっている怒りの器を、大いなる寛容をもって忍ばれたとすれば、"},{"ref":"Rom.9.23","start":45009023,"end":45009023,"break":"none","ruby":[[3,2,"えいこう"],[21,2,"ようい"],[31,1,"うつわ"],[34,2,"じしん"],[37,2,"えいこう"],[40,1,"とみ"],[42,1,"し"]],"text":"かつ、栄光にあずからせるために、あらかじめ用意されたあわれみの器にご自身の栄光の富を知らせようとされたとすれば、どうであろうか。"},{"ref":"Rom.9.24","start":45009024,"end":45009024,"break":"none","ruby":[[0,1,"かみ"],[10,1,"うつわ"],[28,1,"じん"],[30,1,"なか"],[40,3,"いほうじん"],[44,1,"なか"],[48,1,"め"]],"text":"神は、このあわれみの器として、またわたしたちをも、ユダヤ人の中からだけではなく、異邦人の中からも召されたのである。"},{"ref":"Rom.9.25","start":45009025,"end":45009025,"break":"none","breaks":[[24,"stanza"],[41,"line"],[50,"line"]],"ruby":[[8,1,"しょ"],[11,1,"い"],[34,1,"たみ"],[38,1,"もの"],[45,1,"たみ"],[47,1,"よ"],[50,1,"あい"],[57,1,"もの"],[60,1,"あい"],[64,1,"もの"],[66,1,"よ"]],"text":"それは、ホセアの書でも言われているとおりである、「わたしは、わたしの民でない者を、わたしの民と呼び、愛されなかった者を、愛される者と呼ぶであろう。"},{"ref":"Rom.9.26","start":45009026,"end":45009026,"break":"line","breaks":[[17,"line"],[29,"line"],[44,"line"]],"ruby":[[10,1,"たみ"],[17,1,"かれ"],[20,1,"い"],[25,2,"ばしょ"],[29,1,"かれ"],[32,1,"い"],[35,1,"かみ"],[37,1,"こ"],[44,1,"よ"]],"text":"あなたがたはわたしの民ではないと、彼らに言ったその場所で、彼らは生ける神の子らであると、呼ばれるであろう」。"},{"ref":"Rom.9.27","start":45009027,"end":45009027,"break":"none","breaks":[[22,"stanza"],[39,"line"],[51,"line"]],"ruby":[[16,1,"さけ"],[33,1,"こ"],[36,1,"かず"],[39,1,"はま"],[41,1,"すな"],[51,1,"すく"],[58,1,"のこ"],[62,1,"もの"]],"text":"また、イザヤはイスラエルについて叫んでいる、「たとい、イスラエルの子らの数は、浜の砂のようであっても、救われるのは、残された者だけであろう。"},{"ref":"Rom.9.28","start":45009028,"end":45009028,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[3,2,"みことば"],[18,2,"ちじょう"]],"text":"主は、御言をきびしくまたすみやかに、地上になしとげられるであろう」。"},{"ref":"Rom.9.29","start":45009029,"end":45009029,"break":"none","breaks":[[13,"stanza"],[28,"line"],[41,"line"],[57,"line"]],"ruby":[[8,2,"よげん"],[17,2,"ばんぐん"],[20,1,"しゅ"],[28,2,"しそん"],[31,1,"のこ"],[61,1,"おな"]],"text":"さらに、イザヤは預言した、「もし、万軍の主がわたしたちに子孫を残されなかったなら、わたしたちはソドムのようになり、ゴモラと同じようになったであろう」。"},{"ref":"Rom.9.30","start":45009030,"end":45009030,"break":"none","ruby":[[12,1,"い"],[17,1,"ぎ"],[19,1,"お"],[21,1,"もと"],[27,3,"いほうじん"],[32,1,"ぎ"],[39,2,"しんこう"],[44,1,"ぎ"],[46,1,"え"]],"text":"では、わたしたちはなんと言おうか。義を追い求めなかった異邦人は、義、すなわち、信仰による義を得た。"},{"ref":"Rom.9.31","start":45009031,"end":45009031,"break":"none","ruby":[[4,1,"ぎ"],[6,2,"りっぽう"],[9,1,"お"],[11,1,"もと"],[25,2,"りっぽう"],[28,1,"たっ"]],"text":"しかし、義の律法を追い求めていたイスラエルは、その律法に達しなかった。"},{"ref":"Rom.9.32","start":45009032,"end":45009032,"break":"none","ruby":[[7,2,"しんこう"],[16,1,"おこな"],[22,1,"え"],[32,1,"お"],[34,1,"もと"],[43,1,"かれ"],[52,1,"いし"]],"text":"なぜであるか。信仰によらないで、行いによって得られるかのように、追い求めたからである。彼らは、つまずきの石につまずいたのである。"},{"ref":"Rom.9.33","start":45009033,"end":45009033,"break":"stanza","breaks":[[13,"line"],[30,"line"]],"ruby":[[1,1,"み"],[18,1,"いし"],[25,1,"いわ"],[27,1,"お"],[35,1,"たの"],[37,1,"もの"],[40,2,"しつぼう"],[43,1,"おわ"],[52,1,"か"]],"text":"「見よ、わたしはシオンに、つまずきの石、さまたげの岩を置く。それにより頼む者は、失望に終ることがない」と書いてあるとおりである。"}]