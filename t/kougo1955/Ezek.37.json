[{"ref":"Ezek.37.1","start":26037001,"end":26037001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"て"],[8,1,"のぞ"],[11,1,"しゅ"],[17,1,"しゅ"],[19,1,"れい"],[21,1,"み"],[25,1,"で"],[27,1,"い"],[31,1,"たに"],[33,1,"なか"],[39,1,"お"],[48,1,"ほね"],[50,1,"み"]],"text":"主の手がわたしに臨み、主はわたしを主の霊に満たして出て行かせ、谷の中にわたしを置かれた。そこには骨が満ちていた。"},{"ref":"Ezek.37.2","start":26037002,"end":26037002,"break":"none","ruby":[[0,1,"かれ"],[6,1,"たに"],[8,2,"しゅうい"],[11,1,"ゆ"],[19,1,"み"],[22,1,"たに"],[24,1,"めん"],[32,1,"おお"],[35,1,"ほね"],[40,1,"みな"],[44,1,"か"]],"text":"彼はわたしに谷の周囲を行きめぐらせた。見よ、谷の面には、はなはだ多くの骨があり、皆いたく枯れていた。"},{"ref":"Ezek.37.3","start":26037003,"end":26037003,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[12,1,"ひと"],[14,1,"こ"],[21,1,"ほね"],[24,1,"い"],[26,1,"かえ"],[42,1,"こた"],[47,1,"しゅ"],[50,1,"かみ"],[58,1,"ぞん"]],"text":"彼はわたしに言われた、「人の子よ、これらの骨は、生き返ることができるのか」。わたしは答えた、「主なる神よ、あなたはご存じです」。"},{"ref":"Ezek.37.4","start":26037004,"end":26037004,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[18,1,"ほね"],[20,2,"よげん"],[25,1,"い"],[28,1,"か"],[31,1,"ほね"],[34,1,"しゅ"],[36,2,"ことば"],[39,1,"き"]],"text":"彼はまたわたしに言われた、「これらの骨に預言して、言え。枯れた骨よ、主の言葉を聞け。"},{"ref":"Ezek.37.5","start":26037005,"end":26037005,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[9,1,"ほね"],[13,1,"い"],[18,1,"み"],[34,1,"いき"],[36,1,"い"],[46,1,"い"]],"text":"主なる神はこれらの骨にこう言われる、見よ、わたしはあなたがたのうちに息を入れて、あなたがたを生かす。"},{"ref":"Ezek.37.6","start":26037006,"end":26037006,"break":"none","ruby":[[10,1,"うえ"],[12,1,"すじ"],[14,1,"あた"],[17,1,"にく"],[19,1,"しょう"],[24,1,"かわ"],[39,1,"いき"],[41,1,"あた"],[44,1,"い"],[61,1,"しゅ"],[68,1,"さと"]],"text":"わたしはあなたがたの上に筋を与え、肉を生じさせ、皮でおおい、あなたがたのうちに息を与えて生かす。そこであなたがたはわたしが主であることを悟る」。"},{"ref":"Ezek.37.7","start":26037007,"end":26037007,"break":"paragraph","ruby":[[4,1,"めい"],[12,2,"よげん"],[22,2,"よげん"],[26,1,"とき"],[28,1,"こえ"],[34,1,"み"],[37,1,"うご"],[39,1,"おと"],[44,1,"ほね"],[46,1,"ほね"],[48,1,"あつ"],[52,1,"あい"]],"text":"わたしは命じられたように預言したが、わたしが預言した時、声があった。見よ、動く音があり、骨と骨が集まって相つらなった。"},{"ref":"Ezek.37.8","start":26037008,"end":26037008,"break":"none","ruby":[[4,1,"み"],[12,1,"うえ"],[14,1,"すじ"],[19,1,"にく"],[21,1,"しょう"],[24,1,"かわ"],[35,1,"いき"],[39,1,"なか"]],"text":"わたしが見ていると、その上に筋ができ、肉が生じ、皮がこれをおおったが、息はその中になかった。"},{"ref":"Ezek.37.9","start":26037009,"end":26037009,"break":"none","ruby":[[0,1,"とき"],[2,1,"かれ"],[8,1,"い"],[14,1,"ひと"],[16,1,"こ"],[19,1,"いき"],[21,2,"よげん"],[26,1,"いき"],[28,2,"よげん"],[32,1,"い"],[35,1,"しゅ"],[38,1,"かみ"],[42,1,"い"],[47,1,"いき"],[50,2,"しほう"],[54,1,"ふ"],[57,1,"き"],[62,1,"ころ"],[66,1,"もの"],[70,1,"うえ"],[72,1,"ふ"],[75,1,"かれ"],[78,1,"い"]],"text":"時に彼はわたしに言われた、「人の子よ、息に預言せよ、息に預言して言え。主なる神はこう言われる、息よ、四方から吹いて来て、この殺された者たちの上に吹き、彼らを生かせ」。"},{"ref":"Ezek.37.10","start":26037010,"end":26037010,"break":"none","ruby":[[7,1,"めい"],[15,2,"よげん"],[21,1,"いき"],[34,1,"かれ"],[37,1,"い"],[42,1,"あし"],[44,1,"た"],[51,1,"おお"],[55,2,"ぐんしゅう"]],"text":"そこでわたしが命じられたように預言すると、息はこれにはいった。すると彼らは生き、その足で立ち、はなはだ大いなる群衆となった。"},{"ref":"Ezek.37.11","start":26037011,"end":26037011,"break":"paragraph","ruby":[[3,1,"かれ"],[9,1,"い"],[15,1,"ひと"],[17,1,"こ"],[24,1,"ほね"],[32,2,"ぜんか"],[38,1,"み"],[41,1,"かれ"],[44,1,"い"],[53,1,"ほね"],[55,1,"か"],[63,1,"のぞ"],[66,1,"つ"],[74,1,"た"],[76,1,"は"]],"text":"そこで彼はわたしに言われた、「人の子よ、これらの骨はイスラエルの全家である。見よ、彼らは言う、『われわれの骨は枯れ、われわれの望みは尽き、われわれは絶え果てる』と。"},{"ref":"Ezek.37.12","start":26037012,"end":26037012,"break":"none","ruby":[[4,1,"かれ"],[7,2,"よげん"],[11,1,"い"],[14,1,"しゅ"],[17,1,"かみ"],[21,1,"い"],[28,1,"たみ"],[31,1,"み"],[44,1,"はか"],[46,1,"ひら"],[55,1,"はか"],[70,1,"ち"]],"text":"それゆえ彼らに預言して言え。主なる神はこう言われる、わが民よ、見よ、わたしはあなたがたの墓を開き、あなたがたを墓からとりあげて、イスラエルの地にはいらせる。"},{"ref":"Ezek.37.13","start":26037013,"end":26037013,"break":"none","ruby":[[2,1,"たみ"],[15,1,"はか"],[17,1,"ひら"],[28,1,"はか"],[36,1,"とき"],[49,1,"しゅ"],[56,1,"さと"]],"text":"わが民よ、わたしがあなたがたの墓を開き、あなたがたをその墓からとりあげる時、あなたがたは、わたしが主であることを悟る。"},{"ref":"Ezek.37.14","start":26037014,"end":26037014,"break":"none","ruby":[[6,1,"れい"],[18,1,"お"],[28,1,"い"],[40,1,"ち"],[42,2,"あんじゅう"],[47,1,"とき"],[56,1,"しゅ"],[66,1,"い"],[80,1,"さと"],[84,1,"しゅ"],[86,1,"い"]],"text":"わたしがわが霊を、あなたがたのうちに置いて、あなたがたを生かし、あなたがたをその地に安住させる時、あなたがたは、主なるわたしがこれを言い、これをおこなったことを悟ると、主は言われる」。"},{"ref":"Ezek.37.15","start":26037015,"end":26037015,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.37.16","start":26037016,"end":26037016,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[11,1,"ぽん"],[13,1,"き"],[15,1,"と"],[20,1,"うえ"],[30,1,"とも"],[40,2,"しそん"],[48,1,"か"],[54,1,"ぽん"],[56,1,"き"],[58,1,"と"],[64,1,"うえ"],[75,1,"とも"],[85,2,"ぜんか"],[93,1,"か"],[105,1,"き"]],"text":"「人の子よ、あなたは一本の木を取り、その上に『ユダおよびその友であるイスラエルの子孫のために』と書き、また一本の木を取って、その上に『ヨセフおよびその友であるイスラエルの全家のために』と書け。これはエフライムの木である。"},{"ref":"Ezek.37.17","start":26037017,"end":26037017,"break":"none","ruby":[[8,1,"あ"],[16,1,"き"],[29,1,"て"]],"text":"あなたはこれらを合わせて、一つの木となせ。これらはあなたの手で一つになる。"},{"ref":"Ezek.37.18","start":26037018,"end":26037018,"break":"none","ruby":[[4,1,"たみ"],[6,2,"ひとびと"],[13,1,"む"],[37,1,"しめ"],[47,1,"い"],[49,1,"とき"]],"text":"あなたの民の人々があなたに向かって、『これはなんのことであるか、われわれに示してくれないか』と言う時は、"},{"ref":"Ezek.37.19","start":26037019,"end":26037019,"break":"none","ruby":[[3,1,"い"],[6,1,"しゅ"],[9,1,"かみ"],[13,1,"い"],[18,1,"み"],[31,1,"て"],[42,1,"とも"],[52,2,"ぶぞく"],[55,1,"き"],[57,1,"と"],[66,1,"き"],[68,1,"あ"],[76,1,"き"],[89,1,"て"]],"text":"これに言え、主なる神はこう言われる、見よ、わたしはエフライムの手にあるヨセフと、その友であるイスラエルの部族の木を取り、これをユダの木に合わせて、一つの木となす。これらはわたしの手で一つとなる。"},{"ref":"Ezek.37.20","start":26037020,"end":26037020,"break":"none","ruby":[[4,2,"もじ"],[7,1,"か"],[10,1,"き"],[13,1,"かれ"],[16,1,"め"],[18,1,"まえ"],[25,1,"て"]],"text":"あなたが文字を書いた木が、彼らの目の前で、あなたの手にあるとき、"},{"ref":"Ezek.37.21","start":26037021,"end":26037021,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[10,1,"しゅ"],[13,1,"かみ"],[18,1,"い"],[23,1,"み"],[36,2,"ひとびと"],[42,1,"い"],[45,2,"くにぐに"],[49,1,"と"],[51,1,"だ"],[54,2,"しほう"],[58,1,"かれ"],[61,1,"あつ"],[67,1,"ち"]],"text":"あなたは彼らに言え。主なる神は、こう言われる、見よ、わたしはイスラエルの人々を、その行った国々から取り出し、四方から彼らを集めて、その地にみちびき、"},{"ref":"Ezek.37.22","start":26037022,"end":26037022,"break":"none","ruby":[[2,1,"ち"],[4,1,"かれ"],[10,1,"たみ"],[21,2,"やまやま"],[32,1,"おう"],[34,1,"かれ"],[36,2,"ぜんたい"],[39,1,"おう"],[44,1,"かれ"],[47,1,"かさ"],[53,2,"こくみん"],[60,1,"ふたた"],[65,1,"くに"],[67,1,"わか"]],"text":"その地で彼らを一つの民となしてイスラエルの山々におらせ、ひとりの王が彼ら全体の王となり、彼らは重ねて二つの国民とならず、再び二つの国に分れない。"},{"ref":"Ezek.37.23","start":26037023,"end":26037023,"break":"none","ruby":[[0,1,"かれ"],[8,2,"ぐうぞう"],[14,1,"にく"],[37,1,"み"],[39,1,"けが"],[51,1,"かれ"],[57,1,"おか"],[64,2,"はいしん"],[68,1,"すく"],[70,1,"だ"],[77,1,"きよ"],[84,1,"かれ"],[89,1,"たみ"],[98,1,"かれ"],[101,1,"かみ"]],"text":"彼らはまた、その偶像と、その憎むべきことどもと、もろもろのとがとをもって、身を汚すことはない。わたしは彼らを、その犯したすべての背信から救い出して、これを清める。そして彼らはわが民となり、わたしは彼らの神となる。"},{"ref":"Ezek.37.24","start":26037024,"end":26037024,"break":"paragraph","ruby":[[9,1,"かれ"],[12,1,"おう"],[17,1,"かれ"],[23,1,"もの"],[33,2,"ぼくしゃ"],[36,1,"た"],[39,1,"かれ"],[48,1,"あゆ"],[53,1,"さだ"],[56,1,"まも"],[59,1,"おこな"]],"text":"わがしもべダビデは彼らの王となる。彼らすべての者のために、ひとりの牧者が立つ。彼らはわがおきてに歩み、わが定めを守って行う。"},{"ref":"Ezek.37.25","start":26037025,"end":26037025,"break":"none","ruby":[[0,1,"かれ"],[17,1,"あた"],[20,1,"ち"],[22,1,"す"],[34,2,"せんぞ"],[37,1,"す"],[40,1,"ところ"],[48,1,"かれ"],[54,1,"こ"],[60,2,"しそん"],[64,2,"えいえん"],[67,1,"す"],[80,2,"えいえん"],[83,1,"かれ"],[86,1,"きみ"]],"text":"彼らはわがしもべヤコブに、わたしが与えた地に住む。これはあなたがたの先祖の住んだ所である。そこに彼らと、その子らと、その子孫とが永遠に住み、わがしもべダビデが、永遠に彼らの君となる。"},{"ref":"Ezek.37.26","start":26037026,"end":26037026,"break":"none","ruby":[[4,1,"かれ"],[7,2,"へいわ"],[10,2,"けいやく"],[13,1,"むす"],[19,1,"かれ"],[22,2,"えいえん"],[25,2,"けいやく"],[35,1,"かれ"],[38,2,"しゅくふく"],[42,1,"かれ"],[51,2,"せいじょ"],[54,2,"えいえん"],[57,1,"かれ"],[60,1,"なか"],[62,1,"お"]],"text":"わたしは彼らと平和の契約を結ぶ。これは彼らの永遠の契約となる。わたしは彼らを祝福し、彼らをふやし、わが聖所を永遠に彼らの中に置く。"},{"ref":"Ezek.37.27","start":26037027,"end":26037027,"break":"none","ruby":[[6,1,"かれ"],[9,1,"とも"],[18,1,"かれ"],[21,1,"かみ"],[26,1,"かれ"],[31,1,"たみ"]],"text":"わがすみかは彼らと共にあり、わたしは彼らの神となり、彼らはわが民となる。"},{"ref":"Ezek.37.28","start":26037028,"end":26037028,"break":"none","ruby":[[5,2,"せいじょ"],[8,2,"えいえん"],[12,1,"かれ"],[28,1,"しょ"],[29,2,"こくみん"],[32,1,"しゅ"],[46,2,"せいべつ"],[50,1,"もの"],[57,1,"さと"]],"text":"そしてわが聖所が永遠に、彼らのうちにあるようになるとき、諸国民は主なるわたしが、イスラエルを聖別する者であることを悟る」。"}]