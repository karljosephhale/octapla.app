[{"ref":"Ps.125.1","start":19125001,"end":19125001,"break":"paragraph","title":"都もうでの歌","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"しんらい"],[6,1,"もの"],[9,1,"うご"],[31,1,"やま"]],"titleRuby":[[0,1,"みやこ"],[5,1,"うた"]],"text":"主に信頼する者は、動かされることなくて、とこしえにあるシオンの山のようである。"},{"ref":"Ps.125.2","start":19125002,"end":19125002,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"やまやま"],[9,1,"かこ"],[18,1,"しゅ"],[20,1,"いま"],[30,1,"たみ"],[32,1,"かこ"]],"text":"山々がエルサレムを囲んでいるように、主は今からとこしえにその民を囲まれる。"},{"ref":"Ps.125.3","start":19125003,"end":19125003,"break":"line","breaks":[[11,"line"],[28,"line"],[37,"line"]],"ruby":[[3,1,"あ"],[6,1,"もの"],[11,1,"ただ"],[14,1,"もの"],[16,2,"しょりょう"],[28,1,"ただ"],[31,1,"もの"],[35,1,"て"],[37,2,"ふぎ"],[40,1,"の"]],"text":"これは悪しき者のつえが正しい者の所領にとどまることなく、正しい者がその手を不義に伸べることのないためである。"},{"ref":"Ps.125.4","start":19125004,"end":19125004,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"しゅ"],[3,2,"ぜんりょう"],[6,1,"ひと"],[9,1,"こころ"],[11,1,"ただ"],[14,1,"ひと"],[23,1,"ほどこ"]],"text":"主よ、善良な人と、心の正しい人とに、さいわいを施してください。"},{"ref":"Ps.125.5","start":19125005,"end":19125005,"break":"line","breaks":[[18,"line"],[36,"line"]],"ruby":[[3,1,"てん"],[6,2,"じぶん"],[9,1,"まが"],[12,1,"みち"],[14,1,"い"],[16,1,"もの"],[18,1,"しゅ"],[21,1,"あく"],[23,1,"おこな"],[25,1,"もの"],[27,1,"とも"],[29,1,"さ"],[42,1,"うえ"],[44,2,"へいあん"]],"text":"しかし転じて自分の曲った道に入る者を主は、悪を行う者と共に去らせられる。イスラエルの上に平安があるように。"}]