[{"ref":"Col.2.1","start":51002001,"end":51002001,"break":"paragraph","ruby":[[19,1,"ひと"],[29,2,"ちょくせつ"],[35,1,"あ"],[43,2,"ひとびと"],[54,2,"くとう"]],"text":"わたしが、あなたがたとラオデキヤにいる人たちのため、また、直接にはまだ会ったことのない人々のために、どんなに苦闘しているか、わかってもらいたい。"},{"ref":"Col.2.2","start":51002002,"end":51002002,"break":"none","ruby":[[3,1,"かれ"],[7,1,"こころ"],[9,1,"はげ"],[14,1,"あい"],[19,1,"むす"],[21,1,"あ"],[26,1,"ゆた"],[29,3,"りかいりょく"],[33,2,"じゅうぶん"],[36,1,"あた"],[41,1,"かみ"],[43,2,"おくぎ"],[52,1,"し"],[55,1,"いた"]],"text":"それは彼らが、心を励まされ、愛によって結び合わされ、豊かな理解力を十分に与えられ、神の奥義なるキリストを知るに至るためである。"},{"ref":"Col.2.3","start":51002003,"end":51002003,"break":"none","ruby":[[10,2,"ちえ"],[13,2,"ちしき"],[17,1,"たから"],[24,1,"かく"]],"text":"キリストのうちには、知恵と知識との宝が、いっさい隠されている。"},{"ref":"Col.2.4","start":51002004,"end":51002004,"break":"none","ruby":[[6,1,"い"],[22,1,"たく"],[25,2,"ことば"],[28,1,"まよ"]],"text":"わたしがこう言うのは、あなたがたが、だれにも巧みな言葉で迷わされることのないためである。"},{"ref":"Col.2.5","start":51002005,"end":51002005,"break":"none","ruby":[[8,2,"にくたい"],[15,1,"はな"],[22,1,"れい"],[34,2,"いっしょ"],[46,2,"ちつじょ"],[48,1,"ただ"],[51,2,"ようす"],[59,1,"たい"],[68,2,"きょうこ"],[71,2,"しんこう"],[75,1,"み"],[78,1,"よろこ"]],"text":"たとい、わたしは肉体においては離れていても、霊においてはあなたがたと一緒にいて、あなたがたの秩序正しい様子とキリストに対するあなたがたの強固な信仰とを見て、喜んでいる。"},{"ref":"Col.2.6","start":51002006,"end":51002006,"break":"paragraph","ruby":[[12,1,"しゅ"],[22,1,"う"],[32,1,"かれ"],[37,1,"ある"]],"text":"このように、あなたがたは主キリスト・イエスを受けいれたのだから、彼にあって歩きなさい。"},{"ref":"Col.2.7","start":51002007,"end":51002007,"break":"none","ruby":[[3,1,"かれ"],[5,1,"ね"],[9,1,"かれ"],[14,1,"た"],[22,1,"おし"],[31,2,"しんこう"],[34,2,"かくりつ"],[47,2,"かんしゃ"]],"text":"また、彼に根ざし、彼にあって建てられ、そして教えられたように、信仰が確立されて、あふれるばかり感謝しなさい。"},{"ref":"Col.2.8","start":51002008,"end":51002008,"break":"paragraph","ruby":[[17,2,"てつがく"],[21,1,"ひと"],[35,1,"き"],[51,1,"したが"],[55,1,"よ"],[62,2,"れいりょく"],[65,1,"したが"],[67,2,"にんげん"],[70,2,"いいつた"],[74,1,"もとづ"]],"text":"あなたがたは、むなしいだましごとの哲学で、人のとりこにされないように、気をつけなさい。それはキリストに従わず、世のもろもろの霊力に従う人間の言伝えに基くものにすぎない。"},{"ref":"Col.2.9","start":51002009,"end":51002009,"break":"none","ruby":[[8,1,"み"],[20,1,"かみ"],[22,1,"とく"],[32,1,"やど"]],"text":"キリストにこそ、満ちみちているいっさいの神の徳が、かたちをとって宿っており、"},{"ref":"Col.2.10","start":51002010,"end":51002010,"break":"none","ruby":[[22,1,"み"],[34,1,"かれ"],[40,2,"しはい"],[43,2,"けんい"]],"text":"そしてあなたがたは、キリストにあって、それに満たされているのである。彼はすべての支配と権威とのかしらであり、"},{"ref":"Col.2.11","start":51002011,"end":51002011,"break":"none","ruby":[[9,1,"かれ"],[15,1,"て"],[21,2,"かつれい"],[34,2,"かつれい"],[37,1,"う"],[41,1,"にく"],[47,1,"ぬ"],[49,1,"す"]],"text":"あなたがたはまた、彼にあって、手によらない割礼、すなわち、キリストの割礼を受けて、肉のからだを脱ぎ捨てたのである。"},{"ref":"Col.2.12","start":51002012,"end":51002012,"break":"none","ruby":[[12,1,"う"],[15,1,"かれ"],[17,1,"とも"],[19,1,"ほうむ"],[23,2,"どうじ"],[27,1,"かれ"],[29,2,"しにん"],[32,1,"なか"],[42,1,"かみ"],[44,1,"ちから"],[46,1,"しん"],[49,2,"しんこう"],[56,1,"かれ"],[58,1,"とも"]],"text":"あなたがたはバプテスマを受けて彼と共に葬られ、同時に、彼を死人の中からよみがえらせた神の力を信じる信仰によって、彼と共によみがえらされたのである。"},{"ref":"Col.2.13","start":51002013,"end":51002013,"break":"none","ruby":[[7,1,"さき"],[10,1,"つみ"],[12,1,"なか"],[19,1,"にく"],[21,2,"かつれい"],[29,1,"し"],[34,1,"もの"],[40,1,"かみ"],[54,1,"とも"],[56,1,"い"],[71,1,"つみ"],[77,1,"くだ"]],"text":"あなたがたは、先には罪の中にあり、かつ肉の割礼がないままで死んでいた者であるが、神は、あなたがたをキリストと共に生かし、わたしたちのいっさいの罪をゆるして下さった。"},{"ref":"Col.2.14","start":51002014,"end":51002014,"break":"none","ruby":[[0,1,"かみ"],[9,1,"せ"],[12,2,"ふり"],[21,2,"しょうしょ"],[27,2,"きてい"],[35,1,"け"],[41,1,"と"],[43,1,"のぞ"],[47,3,"じゅうじか"]],"text":"神は、わたしたちを責めて不利におとしいれる証書を、その規定もろともぬり消し、これを取り除いて、十字架につけてしまわれた。"},{"ref":"Col.2.15","start":51002015,"end":51002015,"break":"none","ruby":[[9,2,"しはい"],[12,2,"けんい"],[16,2,"ぶそう"],[19,2,"かいじょ"],[31,2,"がいせん"],[35,1,"かれ"],[40,2,"ぎょうれつ"],[43,1,"くわ"]],"text":"そして、もろもろの支配と権威との武装を解除し、キリストにあって凱旋し、彼らをその行列に加えて、さらしものとされたのである。"},{"ref":"Col.2.16","start":51002016,"end":51002016,"break":"paragraph","ruby":[[11,2,"しょくもつ"],[14,1,"の"],[16,1,"もの"],[26,1,"まつり"],[28,2,"しんげつ"],[31,3,"あんそくにち"],[45,2,"ひひょう"]],"text":"だから、あなたがたは、食物と飲み物とにつき、あるいは祭や新月や安息日などについて、だれにも批評されてはならない。"},{"ref":"Col.2.17","start":51002017,"end":51002017,"break":"none","ruby":[[13,1,"かげ"],[21,2,"ほんたい"]],"text":"これらは、きたるべきものの影であって、その本体はキリストにある。"},{"ref":"Col.2.18","start":51002018,"end":51002018,"break":"none","ruby":[[13,1,"けん"],[17,2,"てんし"],[19,2,"れいはい"],[29,2,"ひとびと"],[39,2,"あくひょう"],[50,1,"かれ"],[53,1,"まぼろし"],[55,1,"み"],[60,1,"おも"],[64,1,"にく"],[66,1,"おも"],[77,1,"ほこ"]],"text":"あなたがたは、わざとらしい謙そんと天使礼拝とにおぼれている人々から、いろいろと悪評されてはならない。彼らは幻を見たことを重んじ、肉の思いによっていたずらに誇るだけで、"},{"ref":"Col.2.19","start":51002019,"end":51002019,"break":"none","ruby":[[16,1,"つ"],[32,1,"で"],[38,2,"ぜんたい"],[42,1,"ふし"],[44,1,"ふし"],[46,1,"すじ"],[48,1,"すじ"],[54,1,"つよ"],[58,1,"むす"],[60,1,"あ"],[65,1,"かみ"],[67,1,"そだ"],[72,2,"せいちょう"]],"text":"キリストなるかしらに、しっかりと着くことをしない。このかしらから出て、からだ全体は、節と節、筋と筋とによって強められ結び合わされ、神に育てられて成長していくのである。"},{"ref":"Col.2.20","start":51002020,"end":51002020,"break":"paragraph","ruby":[[14,1,"とも"],[16,1,"し"],[19,1,"よ"],[26,2,"れいりょく"],[30,1,"はな"],[44,1,"よ"],[46,1,"い"]],"text":"もしあなたがたが、キリストと共に死んで世のもろもろの霊力から離れたのなら、なぜ、なおこの世に生きているもののように、"},{"ref":"Col.2.21","start":51002021,"end":51002021,"break":"none","ruby":[[6,1,"あじ"],[11,1,"ふ"],[21,2,"きてい"],[24,1,"しば"]],"text":"「さわるな、味わうな、触れるな」などという規定に縛られているのか。"},{"ref":"Col.2.22","start":51002022,"end":51002022,"break":"none","ruby":[[4,1,"みな"],[6,1,"つか"],[9,1,"つ"],[18,2,"にんげん"],[21,2,"きてい"],[24,1,"おしえ"]],"text":"これらは皆、使えば尽きてしまうもの、人間の規定や教によっているものである。"},{"ref":"Col.2.23","start":51002023,"end":51002023,"break":"none","ruby":[[15,2,"れいはい"],[24,1,"けん"],[33,2,"くぎょう"],[44,2,"ちえ"],[55,1,"み"],[60,1,"じつ"],[69,2,"にくよく"],[72,1,"ふせ"],[80,1,"やく"],[83,1,"た"]],"text":"これらのことは、ひとりよがりの礼拝とわざとらしい謙そんと、からだの苦行とをともなうので、知恵のあるしわざらしく見えるが、実は、ほしいままな肉欲を防ぐのに、なんの役にも立つものではない。"}]