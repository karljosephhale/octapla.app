[{"ref":"Job.39.1","start":18039001,"end":18039001,"break":"paragraph","breaks":[[10,"line"],[24,"line"]],"ruby":[[4,2,"いわま"],[10,1,"こ"],[12,1,"う"],[17,1,"し"],[28,1,"め"],[32,1,"こ"],[34,1,"う"],[38,1,"み"]],"text":"あなたは岩間のやぎが子を産むときを知っているか。あなたは雌じかが子を産むのを見たことがあるか。"},{"ref":"Job.39.2","start":18039002,"end":18039002,"break":"line","breaks":[[20,"line"]],"ruby":[[4,2,"にんしん"],[7,1,"つき"],[9,1,"かぞ"],[24,1,"う"],[26,1,"とき"],[28,1,"し"]],"text":"これらの妊娠の月を数えることができるか。これらが産む時を知っているか。"},{"ref":"Job.39.3","start":18039003,"end":18039003,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"み"],[10,1,"こ"],[12,1,"う"],[20,1,"こ"],[22,1,"う"]],"text":"これらは身をかがめて子を産み、そのはらみ子を産みいだす。"},{"ref":"Job.39.4","start":18039004,"end":18039004,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"こ"],[4,1,"つよ"],[10,1,"の"],[12,1,"そだ"],[15,1,"で"],[17,1,"い"],[23,1,"おや"],[28,1,"かえ"]],"text":"その子は強くなって、野に育ち、出て行って、その親のもとに帰らない。"},{"ref":"Job.39.5","start":18039005,"end":18039005,"break":"stanza","breaks":[[18,"line"]],"ruby":[[3,1,"の"],[7,1,"はな"],[11,2,"じゆう"],[21,1,"の"],[29,1,"と"]],"text":"だれが野ろばを放って、自由にしたか。だれが野ろばのつなぎを解いたか。"},{"ref":"Job.39.6","start":18039006,"end":18039006,"break":"line","breaks":[[16,"line"]],"ruby":[[4,2,"あらの"],[9,1,"いえ"],[13,1,"あた"],[16,1,"あ"],[18,1,"ち"],[28,1,"あた"]],"text":"わたしは荒野をその家として与え、荒れ地をそのすみかとして与えた。"},{"ref":"Job.39.7","start":18039007,"end":18039007,"break":"line","breaks":[[13,"line"]],"ruby":[[3,1,"まち"],[5,1,"さわ"],[13,2,"ぎょしゃ"],[16,1,"よ"],[18,1,"こえ"],[20,1,"き"]],"text":"これは町の騒ぎをいやしめ、御者の呼ぶ声を聞きいれず、"},{"ref":"Job.39.8","start":18039008,"end":18039008,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"やま"],[2,2,"まきば"],[18,2,"あおもの"],[21,1,"たず"],[23,1,"もと"]],"text":"山を牧場としてはせまわり、もろもろの青物を尋ね求める。"},{"ref":"Job.39.9","start":18039009,"end":18039009,"break":"stanza","breaks":[[12,"line"]],"ruby":[[0,2,"やぎゅう"],[3,1,"こころよ"],[9,1,"つか"],[16,2,"かいば"]],"text":"野牛は快くあなたに仕え、あなたの飼葉おけのかたわらにとどまるだろうか。"},{"ref":"Job.39.10","start":18039010,"end":18039010,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[4,2,"やぎゅう"],[7,2,"たづな"],[16,1,"ある"],[35,1,"したが"],[38,1,"たに"],[40,1,"たがや"]],"text":"あなたは野牛に手綱をつけてうねを歩かせることができるか、これはあなたに従って谷を耕すであろうか。"},{"ref":"Job.39.11","start":18039011,"end":18039011,"break":"line","breaks":[[11,"line"],[26,"line"]],"ruby":[[2,1,"ちから"],[4,1,"つよ"],[18,1,"たの"],[32,2,"しごと"],[38,1,"まか"]],"text":"その力が強いからとて、あなたはこれに頼むであろうか。またあなたの仕事をこれに任せるであろうか。"},{"ref":"Job.39.12","start":18039012,"end":18039012,"break":"line","breaks":[[19,"line"]],"ruby":[[16,2,"こくもつ"],[19,1,"う"],[21,1,"ば"],[23,1,"はこ"],[25,1,"かえ"]],"text":"あなたはこれにたよって、あなたの穀物を打ち場に運び帰らせるであろうか。"},{"ref":"Job.39.13","start":18039013,"end":18039013,"break":"stanza","breaks":[[17,"line"]],"ruby":[[5,2,"いせい"],[11,1,"つばさ"],[28,1,"はね"],[30,2,"うもう"]],"text":"だちょうは威勢よくその翼をふるう。しかしこれにはきれいな羽と羽毛があるか。"},{"ref":"Job.39.14","start":18039014,"end":18039014,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"たまご"],[7,1,"つち"],[9,1,"なか"],[11,1,"す"],[13,1,"お"],[19,1,"すな"],[24,1,"あたた"]],"text":"これはその卵を土の中に捨て置き、これを砂のなかで暖め、"},{"ref":"Job.39.15","start":18039015,"end":18039015,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"あし"],[11,1,"の"],[13,1,"けもの"],[15,1,"ふ"],[22,1,"わす"]],"text":"足でつぶされることも、野の獣に踏まれることも忘れている。"},{"ref":"Job.39.16","start":18039016,"end":18039016,"break":"line","breaks":[[14,"line"],[30,"line"]],"ruby":[[5,1,"こ"],[7,2,"むじょう"],[18,2,"じぶん"],[21,1,"こ"],[32,2,"くろう"],[43,1,"おそ"]],"text":"これはその子に無情であって、あたかも自分の子でないようにし、その苦労のむなしくなるをも恐れない。"},{"ref":"Job.39.17","start":18039017,"end":18039017,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"かみ"],[8,2,"ちえ"],[11,1,"さづ"],[15,1,"さと"],[18,1,"あた"]],"text":"これは神がこれに知恵を授けず、悟りを与えなかったゆえである。"},{"ref":"Job.39.18","start":18039018,"end":18039018,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"み"],[7,1,"おこ"],[10,1,"はし"],[12,1,"とき"],[16,1,"うま"],[22,1,"の"],[24,1,"て"]],"text":"これがその身を起して走る時には、馬をも、その乗り手をもあざける。"},{"ref":"Job.39.19","start":18039019,"end":18039019,"break":"stanza","breaks":[[21,"line"]],"ruby":[[4,1,"うま"],[8,1,"ちから"],[10,1,"あた"],[21,1,"ちから"],[28,1,"くび"],[30,1,"よそお"]],"text":"あなたは馬にその力を与えることができるか。力をもってその首を装うことができるか。"},{"ref":"Job.39.20","start":18039020,"end":18039020,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[29,1,"はな"],[34,2,"いりょく"],[37,1,"おそ"]],"text":"あなたはこれをいなごのように、とばせることができるか。その鼻あらしの威力は恐ろしい。"},{"ref":"Job.39.21","start":18039021,"end":18039021,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"たに"],[11,1,"ちから"],[13,1,"ほこ"],[20,1,"で"],[25,2,"ぶき"],[28,1,"む"]],"text":"これは谷であがき、その力に誇り、みずから出ていって武器に向かう。"},{"ref":"Job.39.22","start":18039022,"end":18039022,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"おそ"],[8,1,"わら"],[12,1,"おどろ"],[26,1,"しりぞ"]],"text":"これは恐れをあざ笑って、驚くことなく、つるぎをさけて退くことがない。"},{"ref":"Job.39.23","start":18039023,"end":18039023,"break":"line","breaks":[[10,"line"]],"ruby":[[0,2,"やづつ"],[5,1,"うえ"],[7,1,"な"],[13,1,"な"]],"text":"矢筒はその上に鳴り、やりと投げやりと、あいきらめく。"},{"ref":"Job.39.24","start":18039024,"end":18039024,"break":"line","breaks":[[21,"line"]],"ruby":[[8,1,"くる"],[12,1,"ち"],[25,1,"おと"],[27,1,"な"],[29,1,"わた"],[34,1,"た"]],"text":"これはたけりつ、狂いつ、地をひとのみにし、ラッパの音が鳴り渡っても、立ちどまることがない。"},{"ref":"Job.39.25","start":18039025,"end":18039025,"break":"line","breaks":[[20,"line"],[32,"line"]],"ruby":[[7,1,"な"],[17,1,"い"],[20,1,"とお"],[24,1,"たたか"],[32,2,"たいちょう"],[35,2,"おおごえ"],[43,1,"こえ"],[45,1,"き"],[47,1,"し"]],"text":"これはラッパの鳴るごとにハアハアと言い、遠くから戦いをかぎつけ、隊長の大声およびときの声を聞き知る。"},{"ref":"Job.39.26","start":18039026,"end":18039026,"break":"stanza","breaks":[[24,"line"]],"ruby":[[3,1,"ま"],[11,1,"つばさ"],[16,1,"みなみ"],[18,1,"む"],[28,2,"ちえ"]],"text":"たかが舞いあがり、その翼をのべて南に向かうのは、あなたの知恵によるのか、"},{"ref":"Job.39.27","start":18039027,"end":18039027,"break":"line","breaks":[[23,"line"]],"ruby":[[11,1,"す"],[13,1,"たか"],[15,1,"ところ"],[27,2,"めいれい"]],"text":"わしがかけのぼり、その巣を高い所につくるのは、あなたの命令によるのか。"},{"ref":"Job.39.28","start":18039028,"end":18039028,"break":"line","breaks":[[14,"line"]],"ruby":[[3,1,"いわ"],[5,1,"うえ"],[11,1,"かま"],[14,1,"いわ"],[23,1,"けわ"],[26,1,"ところ"]],"text":"これは岩の上にすみかを構え、岩のとがり、または険しい所におり、"},{"ref":"Job.39.29","start":18039029,"end":18039029,"break":"line","breaks":[[12,"line"]],"ruby":[[4,2,"えもの"],[14,1,"め"],[16,1,"およ"],[22,1,"とお"]],"text":"そこから獲物をうかがう。その目の及ぶところは遠い。"},{"ref":"Job.39.30","start":18039030,"end":18039030,"break":"line","breaks":[[12,"line"]],"ruby":[[7,1,"ち"],[9,1,"す"],[16,1,"ころ"],[20,1,"もの"],[24,1,"ところ"]],"text":"そのひなもまた血を吸う。おおよそ殺された者のある所には、これもそこにいる」。"}]