[{"ref":"Acts.6.1","start":44006001,"end":44006001,"break":"paragraph","ruby":[[5,2,"でし"],[8,1,"かず"],[24,1,"ご"],[26,1,"つか"],[31,1,"じん"],[40,1,"ご"],[42,1,"つか"],[47,1,"じん"],[51,1,"たい"],[55,2,"じぶん"],[66,2,"ひび"],[69,2,"はいきゅう"],[85,2,"くじょう"],[88,1,"もう"],[90,1,"た"]],"text":"そのころ、弟子の数がふえてくるにつれて、ギリシヤ語を使うユダヤ人たちから、ヘブル語を使うユダヤ人たちに対して、自分たちのやもめらが、日々の配給で、おろそかにされがちだと、苦情を申し立てた。"},{"ref":"Acts.6.2","start":44006002,"end":44006002,"break":"none","ruby":[[6,2,"しと"],[9,2,"でし"],[11,2,"ぜんたい"],[14,1,"よ"],[16,1,"あつ"],[19,1,"い"],[30,1,"かみ"],[32,1,"ことば"],[40,2,"しょくたく"],[46,1,"たずさ"]],"text":"そこで、十二使徒は弟子全体を呼び集めて言った、「わたしたちが神の言をさしおいて、食卓のことに携わるのはおもしろくない。"},{"ref":"Acts.6.3","start":44006003,"end":44006003,"break":"none","ruby":[[4,2,"きょうだい"],[16,1,"なか"],[20,2,"みたま"],[23,2,"ちえ"],[27,1,"み"],[31,2,"ひょうばん"],[36,1,"ひと"],[40,1,"にん"],[42,1,"さが"],[44,1,"だ"],[53,1,"ひと"],[59,2,"しごと"]],"text":"そこで、兄弟たちよ、あなたがたの中から、御霊と知恵とに満ちた、評判のよい人たち七人を捜し出してほしい。その人たちにこの仕事をまかせ、"},{"ref":"Acts.6.4","start":44006004,"end":44006004,"break":"none","ruby":[[11,1,"いのり"],[13,2,"みことば"],[17,1,"よう"],[19,1,"あた"]],"text":"わたしたちは、もっぱら祈と御言のご用に当ることにしよう」。"},{"ref":"Acts.6.5","start":44006005,"end":44006005,"break":"none","ruby":[[2,2,"ていあん"],[5,2,"かいしゅう"],[7,2,"いちどう"],[10,2,"さんせい"],[25,2,"しんこう"],[28,2,"せいれい"],[32,1,"み"],[35,1,"ひと"],[77,3,"かいしゅうしゃ"],[85,1,"えら"],[87,1,"だ"]],"text":"この提案は会衆一同の賛成するところとなった。そして信仰と聖霊とに満ちた人ステパノ、それからピリポ、プロコロ、ニカノル、テモン、パルメナ、およびアンテオケの改宗者ニコラオを選び出して、"},{"ref":"Acts.6.6","start":44006006,"end":44006006,"break":"none","ruby":[[0,2,"しと"],[5,1,"まえ"],[7,1,"た"],[16,2,"しと"],[21,1,"いの"],[24,1,"て"],[26,1,"かれ"],[29,1,"うえ"]],"text":"使徒たちの前に立たせた。すると、使徒たちは祈って手を彼らの上においた。"},{"ref":"Acts.6.7","start":44006007,"end":44006007,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"ことば"],[27,2,"でし"],[30,1,"かず"],[33,2,"ひじょう"],[42,2,"さいし"],[47,2,"たすう"],[50,2,"しんこう"],[53,1,"う"]],"text":"こうして神の言は、ますますひろまり、エルサレムにおける弟子の数が、非常にふえていき、祭司たちも多数、信仰を受けいれるようになった。"},{"ref":"Acts.6.8","start":44006008,"end":44006008,"break":"paragraph","ruby":[[8,1,"めぐ"],[11,1,"ちから"],[14,1,"み"],[18,2,"みんしゅう"],[21,1,"なか"],[29,2,"きせき"],[37,1,"おこな"]],"text":"さて、ステパノは恵みと力とに満ちて、民衆の中で、めざましい奇跡としるしとを行っていた。"},{"ref":"Acts.6.9","start":44006009,"end":44006009,"break":"none","ruby":[[16,2,"かいどう"],[19,1,"ぞく"],[22,2,"ひとびと"],[28,1,"びと"],[38,1,"びと"],[52,2,"ひとびと"],[57,1,"た"],[66,2,"ぎろん"]],"text":"すると、いわゆる「リベルテン」の会堂に属する人々、クレネ人、アレキサンドリヤ人、キリキヤやアジヤからきた人々などが立って、ステパノと議論したが、"},{"ref":"Acts.6.10","start":44006010,"end":44006010,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ちえ"],[5,2,"みたま"],[9,1,"かた"],[20,2,"たいこう"]],"text":"彼は知恵と御霊とで語っていたので、それに対抗できなかった。"},{"ref":"Acts.6.11","start":44006011,"end":44006011,"break":"none","ruby":[[4,1,"かれ"],[7,2,"ひとびと"],[25,1,"かれ"],[31,1,"かみ"],[34,1,"けが"],[36,2,"ことば"],[39,1,"は"],[43,1,"き"],[48,1,"い"]],"text":"そこで、彼らは人々をそそのかして、「わたしたちは、彼がモーセと神とを汚す言葉を吐くのを聞いた」と言わせた。"},{"ref":"Acts.6.12","start":44006012,"end":44006012,"break":"none","ruby":[[2,1,"うえ"],[4,2,"みんしゅう"],[7,2,"ちょうろう"],[12,2,"りっぽう"],[14,2,"がくしゃ"],[19,2,"せんどう"],[23,1,"かれ"],[25,1,"おそ"],[28,1,"とら"],[33,2,"ぎかい"]],"text":"その上、民衆や長老たちや律法学者たちを煽動し、彼を襲って捕えさせ、議会にひっぱってこさせた。"},{"ref":"Acts.6.13","start":44006013,"end":44006013,"break":"none","ruby":[[5,1,"いつわ"],[8,2,"しょうにん"],[13,1,"た"],[16,1,"い"],[24,1,"ひと"],[29,2,"せいじょ"],[32,2,"りっぽう"],[36,1,"さか"],[39,2,"ことば"],[42,1,"は"]],"text":"それから、偽りの証人たちを立てて言わせた、「この人は、この聖所と律法とに逆らう言葉を吐いて、どうしても、やめようとはしません。"},{"ref":"Acts.6.14","start":44006014,"end":44006014,"break":"none","ruby":[[6,1,"びと"],[14,2,"せいじょ"],[17,1,"う"],[33,1,"つた"],[36,2,"かんれい"],[39,1,"か"],[53,1,"かれ"],[55,1,"い"],[66,1,"き"]],"text":"『あのナザレ人イエスは、この聖所を打ちこわし、モーセがわたしたちに伝えた慣例を変えてしまうだろう』などと、彼が言うのを、わたしたちは聞きました」。"},{"ref":"Acts.6.15","start":44006015,"end":44006015,"break":"none","ruby":[[0,2,"ぎかい"],[3,1,"せき"],[10,1,"ひと"],[14,1,"みな"],[21,1,"め"],[23,1,"そそ"],[28,1,"かれ"],[30,1,"かお"],[37,2,"てんし"],[40,1,"かお"],[45,1,"み"]],"text":"議会で席についていた人たちは皆、ステパノに目を注いだが、彼の顔は、ちょうど天使の顔のように見えた。"}]