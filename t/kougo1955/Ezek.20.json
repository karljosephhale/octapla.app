[{"ref":"Ezek.20.1","start":26020001,"end":26020001,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"ねん"],[5,1,"がつ"],[7,1,"か"],[16,2,"ちょうろう"],[23,2,"ひとびと"],[27,1,"しゅ"],[29,1,"たず"],[42,1,"まえ"],[44,1,"ざ"]],"text":"第七年の五月十日に、イスラエルの長老たちのある人々が、主に尋ねるためにきて、わたしの前に座した。"},{"ref":"Ezek.20.2","start":26020002,"end":26020002,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,2,"ことば"],[11,1,"のぞ"]],"text":"時に主の言葉がわたしに臨んだ、"},{"ref":"Ezek.20.3","start":26020003,"end":26020003,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[12,2,"ちょうろう"],[17,1,"つ"],[20,1,"い"],[23,1,"しゅ"],[26,1,"かみ"],[30,1,"い"],[48,1,"き"],[57,1,"なに"],[59,1,"たず"],[69,1,"しゅ"],[72,1,"かみ"],[74,1,"い"],[83,1,"い"],[99,1,"たず"],[102,1,"こた"]],"text":"「人の子よ、イスラエルの長老たちに告げて言え。主なる神はこう言われる、あなたがたがわたしのもとに来たのは、わたしに何か尋ねるためであるか。主なる神は言われる、わたしは生きている、わたしはあなたがたの尋ねに答えない。"},{"ref":"Ezek.20.4","start":26020004,"end":26020004,"break":"none","ruby":[[4,1,"かれ"],[17,1,"ひと"],[19,1,"こ"],[26,1,"かれ"],[43,1,"かれ"],[46,2,"せんぞ"],[53,1,"にく"],[57,1,"こと"],[59,1,"かれ"],[62,1,"し"]],"text":"あなたは彼らをさばこうとするのか。人の子よ、あなたは彼らをさばこうとするのか。それなら彼らの先祖たちのした憎むべき事を彼らに知らせ、"},{"ref":"Ezek.20.5","start":26020005,"end":26020005,"break":"none","ruby":[[2,1,"かれ"],[5,1,"い"],[8,1,"しゅ"],[11,1,"かみ"],[15,1,"い"],[30,1,"えら"],[37,1,"いえ"],[39,2,"しそん"],[42,1,"ちか"],[50,1,"ち"],[55,2,"じしん"],[58,1,"かれ"],[61,1,"し"],[64,1,"かれ"],[67,1,"ちか"],[81,1,"かみ"],[83,1,"しゅ"],[88,1,"い"],[91,1,"ひ"]],"text":"かつ彼らに言え。主なる神はこう言われる、わたしがイスラエルを選び、ヤコブの家の子孫に誓い、エジプトの地でわたし自身を彼らに知らせ彼らに誓って、わたしはあなたがたの神、主であると言った日、"},{"ref":"Ezek.20.6","start":26020006,"end":26020006,"break":"none","ruby":[[2,1,"ひ"],[8,1,"かれ"],[11,1,"ちか"],[20,1,"ち"],[23,1,"かれ"],[26,1,"みちび"],[28,1,"だ"],[35,1,"かれ"],[41,1,"さぐ"],[43,1,"もと"],[46,1,"ちち"],[48,1,"みつ"],[51,1,"なが"],[54,1,"ち"],[56,1,"ぜん"],[57,1,"ち"],[59,1,"なか"],[61,1,"もっと"],[68,1,"ところ"],[70,1,"い"],[75,1,"い"]],"text":"その日にわたしは彼らに誓って、エジプトの地から彼らを導き出し、わたしが彼らのために探り求めた乳と蜜との流れる地、全地の中で最もすばらしい所へ行かせると言った。"},{"ref":"Ezek.20.7","start":26020007,"end":26020007,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[24,1,"め"],[26,1,"たの"],[31,1,"にく"],[38,1,"す"],[47,2,"ぐうぞう"],[56,1,"み"],[58,1,"けが"],[72,1,"かみ"],[74,1,"しゅ"]],"text":"わたしは彼らに言った、あなたがたは、おのおのその目を楽しませる憎むべきものを捨てよ。エジプトの偶像をもって、その身を汚すな。わたしはあなたがたの神、主であると。"},{"ref":"Ezek.20.8","start":26020008,"end":26020008,"break":"none","breaks":[[80,"paragraph"]],"ruby":[[4,1,"かれ"],[19,1,"い"],[24,1,"き"],[35,1,"かれ"],[45,1,"め"],[47,1,"たの"],[52,1,"にく"],[59,1,"す"],[70,2,"ぐうぞう"],[73,1,"す"],[93,1,"ち"],[103,1,"いきどお"],[106,1,"かれ"],[109,1,"そそ"],[116,1,"いか"],[119,1,"かれ"],[122,1,"も"],[127,1,"おも"]],"text":"ところが彼らはわたしにそむき、わたしの言うことを聞こうともしなかった。彼らは、おのおのその目を楽しませた憎むべきものを捨てず、またエジプトの偶像を捨てなかった。それで、わたしはエジプトの地のうちで、わたしの憤りを彼らに注ぎ、わたしの怒りを彼らに漏らそうと思った。"},{"ref":"Ezek.20.9","start":26020009,"end":26020009,"break":"none","ruby":[[11,1,"な"],[16,2,"こうどう"],[29,1,"ち"],[32,1,"かれ"],[35,1,"みちび"],[37,1,"だ"],[41,2,"しゅうい"],[44,1,"す"],[49,3,"いほうじん"],[63,1,"し"],[71,1,"な"],[73,1,"かれ"],[76,1,"め"],[78,1,"まえ"]],"text":"しかしわたしはわたしの名のために行動した。それはエジプトの地から彼らを導き出して、周囲に住んでいた異邦人たちに、わたしのことを知らせ、わたしの名が彼らの目の前に、はずかしめられないためである。"},{"ref":"Ezek.20.10","start":26020010,"end":26020010,"break":"none","ruby":[[14,1,"ち"],[17,1,"かれ"],[20,1,"みちび"],[22,1,"だ"],[26,2,"あらの"],[29,1,"つ"],[32,1,"い"]],"text":"すなわち、わたしはエジプトの地から彼らを導き出して、荒野に連れて行き、"},{"ref":"Ezek.20.11","start":26020011,"end":26020011,"break":"none","ruby":[[4,1,"さだ"],[7,1,"かれ"],[10,1,"さづ"],[21,1,"かれ"],[24,1,"しめ"],[31,1,"ひと"],[36,1,"おこな"],[44,1,"い"]],"text":"わたしの定めを彼らに授け、わたしのおきてを彼らに示した。これは人がこれを行うことによって生きるものである。"},{"ref":"Ezek.20.12","start":26020012,"end":26020012,"break":"none","ruby":[[6,1,"かれ"],[9,3,"あんそくにち"],[13,1,"あた"],[21,1,"かれ"],[25,1,"あいだ"],[37,1,"しゅ"],[44,1,"かれ"],[47,2,"せいべつ"],[55,1,"かれ"],[58,1,"し"]],"text":"わたしはまた彼らに安息日を与えて、わたしと彼らとの間のしるしとした。これは主なるわたしが彼らを聖別したことを、彼らに知らせるためである。"},{"ref":"Ezek.20.13","start":26020013,"end":26020013,"break":"none","breaks":[[82,"paragraph"]],"ruby":[[9,1,"いえ"],[11,2,"あらの"],[26,1,"さだ"],[29,1,"あゆ"],[33,1,"ひと"],[38,1,"おこな"],[47,1,"い"],[64,1,"す"],[67,1,"おお"],[74,3,"あんそくにち"],[78,1,"けが"],[89,2,"あらの"],[97,1,"いきどお"],[100,1,"かれ"],[103,1,"うえ"],[105,1,"そそ"],[111,1,"ほろ"],[116,1,"おも"]],"text":"しかしイスラエルの家は荒野でわたしにそむき、わたしの定めに歩まず、人がそれを行うことによって、生きることのできるわたしのおきてを捨て、大いにわたしの安息日を汚した。そこでわたしは荒野で、わたしの憤りを彼らの上に注ぎ、これを滅ぼそうと思ったが、"},{"ref":"Ezek.20.14","start":26020014,"end":26020014,"break":"none","ruby":[[8,1,"な"],[13,2,"こうどう"],[25,1,"かれ"],[28,1,"みちび"],[30,1,"だ"],[33,1,"み"],[36,3,"いほうじん"],[40,1,"まえ"],[47,1,"な"],[49,1,"けが"]],"text":"わたしはわたしの名のために行動した。それはわたしが彼らを導き出して見せた異邦人の前に、わたしの名が汚されないためである。"},{"ref":"Ezek.20.15","start":26020015,"end":26020015,"break":"none","ruby":[[8,2,"あらの"],[11,1,"かれ"],[14,1,"ちか"],[21,1,"かれ"],[24,1,"あた"],[27,1,"ちち"],[29,1,"みつ"],[32,1,"なが"],[35,1,"ち"],[37,1,"ぜん"],[38,1,"ち"],[40,1,"もっと"],[47,1,"ち"],[50,1,"かれ"],[53,1,"みちび"],[58,1,"い"]],"text":"ただし、わたしは荒野で彼らに誓い、わたしが彼らに与えた乳と蜜との流れる地、全地の最もすばらしい地に、彼らを導かないと言った。"},{"ref":"Ezek.20.16","start":26020016,"end":26020016,"break":"none","ruby":[[3,1,"かれ"],[8,1,"こころ"],[10,2,"ぐうぞう"],[13,1,"した"],[23,1,"す"],[28,1,"さだ"],[31,1,"あゆ"],[37,3,"あんそくにち"],[41,1,"けが"]],"text":"これは彼らがその心に偶像を慕って、わがおきてを捨て、わが定めに歩まず、わが安息日を汚したからである。"},{"ref":"Ezek.20.17","start":26020017,"end":26020017,"break":"none","ruby":[[8,1,"かれ"],[11,1,"お"],[14,1,"み"],[17,1,"かれ"],[20,1,"ほろ"],[25,2,"あらの"],[28,1,"かれ"],[31,1,"た"]],"text":"けれどもわたしは彼らを惜しみ見て、彼らを滅ぼさず、荒野で彼らを絶やさなかった。"},{"ref":"Ezek.20.18","start":26020018,"end":26020018,"break":"paragraph","ruby":[[6,2,"あらの"],[9,1,"かれ"],[12,1,"こ"],[18,1,"い"],[28,2,"せんぞ"],[31,1,"さだ"],[34,1,"あゆ"],[49,1,"まも"],[60,2,"ぐうぞう"],[73,1,"み"],[75,1,"けが"]],"text":"わたしはまた荒野で彼らの子どもたちに言った、あなたがたの先祖の定めに歩んではならない。そのおきてを守ってはならない。その偶像をもって、あなたがたの身を汚してはならない。"},{"ref":"Ezek.20.19","start":26020019,"end":26020019,"break":"none","ruby":[[0,1,"しゅ"],[13,1,"かみ"],[20,1,"さだ"],[23,1,"あゆ"],[32,1,"まも"],[38,1,"おこな"]],"text":"主なるわたしはあなたがたの神である。わが定めに歩み、わがおきてを守ってこれを行い、"},{"ref":"Ezek.20.20","start":26020020,"end":26020020,"break":"none","ruby":[[2,3,"あんそくにち"],[6,2,"せいべつ"],[25,1,"あいだ"],[35,1,"しゅ"],[48,1,"かみ"],[62,1,"し"]],"text":"わが安息日を聖別せよ。これはわたしとあなたがたとの間のしるしとなって、主なるわたしがあなたがたの神であることを、あなたがたに知らせるためである。"},{"ref":"Ezek.20.21","start":26020021,"end":26020021,"break":"none","breaks":[[75,"paragraph"]],"ruby":[[5,1,"こ"],[21,1,"さだ"],[24,1,"あゆ"],[28,1,"ひと"],[33,1,"おこな"],[42,1,"い"],[59,1,"まも"],[61,1,"おこな"],[67,3,"あんそくにち"],[71,1,"けが"],[84,1,"いきどお"],[87,1,"かれ"],[90,1,"うえ"],[92,1,"そそ"],[95,2,"あらの"],[98,1,"かれ"],[101,1,"たい"],[106,1,"いか"],[109,1,"も"],[114,1,"おも"]],"text":"しかしその子どもたちはわたしにそむき、わが定めに歩まず、人がこれを行うことによって、生きることのできるわたしのおきてを守り行わず、わが安息日を汚した。そこでわたしはわが憤りを彼らの上に注ぎ、荒野で彼らに対し、わが怒りを漏らそうと思った。"},{"ref":"Ezek.20.22","start":26020022,"end":26020022,"break":"none","ruby":[[9,1,"て"],[11,1,"ひるがえ"],[17,1,"な"],[22,2,"こうどう"],[34,1,"かれ"],[37,1,"みちび"],[39,1,"だ"],[42,1,"み"],[45,3,"いほうじん"],[49,1,"まえ"],[56,1,"な"],[58,1,"けが"]],"text":"しかしわたしはわが手を翻して、わが名のために行動した。それはわたしが彼らを導き出して見せた異邦人の前に、わたしの名が汚されないためである。"},{"ref":"Ezek.20.23","start":26020023,"end":26020023,"break":"none","ruby":[[7,2,"あらの"],[10,1,"かれ"],[13,1,"ちか"],[20,3,"いほうじん"],[24,1,"あいだ"],[26,1,"かれ"],[29,1,"ち"],[33,2,"くにぐに"],[36,1,"なか"],[38,1,"かれ"],[46,1,"い"]],"text":"ただしわたしは荒野で彼らに誓い、わたしは異邦人の間に彼らを散らし、国々の中に彼らをふりまくと言った。"},{"ref":"Ezek.20.24","start":26020024,"end":26020024,"break":"none","ruby":[[3,1,"かれ"],[12,1,"おこな"],[18,1,"さだ"],[21,1,"す"],[26,3,"あんそくにち"],[30,1,"けが"],[33,1,"かれ"],[36,1,"め"],[40,2,"せんぞ"],[43,2,"ぐうぞう"],[46,1,"した"]],"text":"これは彼らがわがおきてを行わず、わが定めを捨て、わが安息日を汚し、彼らの目にその先祖の偶像を慕ったからである。"},{"ref":"Ezek.20.25","start":26020025,"end":26020025,"break":"none","ruby":[[6,1,"かれ"],[9,1,"よ"],[13,1,"さだ"],[23,1,"い"],[38,1,"あた"]],"text":"またわたしは彼らに良くない定めと、それによって生きることのできないおきてとを与え、"},{"ref":"Ezek.20.26","start":26020026,"end":26020026,"break":"none","ruby":[[4,1,"かれ"],[11,1,"ひ"],[13,1,"なか"],[15,1,"とお"],[21,1,"そな"],[23,1,"もの"],[29,1,"かれ"],[32,1,"けが"],[35,1,"かれ"],[38,1,"おそ"],[51,1,"おこな"],[61,1,"しゅ"],[69,1,"かれ"],[72,1,"し"]],"text":"そして、彼らのういごに火の中を通らせるその供え物によって、彼らを汚し、彼らを恐れさせた。わたしがこれを行ったのは、わたしが主であることを、彼らに知らせるためである。"},{"ref":"Ezek.20.27","start":26020027,"end":26020027,"break":"paragraph","ruby":[[4,1,"ひと"],[6,1,"こ"],[15,1,"いえ"],[17,1,"つ"],[20,1,"い"],[23,1,"しゅ"],[26,1,"かみ"],[30,1,"い"],[41,2,"せんぞ"],[47,2,"ふしん"],[50,1,"つみ"],[52,1,"おか"],[59,1,"けが"]],"text":"それゆえ人の子よ、イスラエルの家に告げて言え。主なる神はこう言われる、あなたがたの先祖はまた、不信の罪を犯してわたしを汚した。"},{"ref":"Ezek.20.28","start":26020028,"end":26020028,"break":"none","ruby":[[4,1,"かれ"],[7,1,"あた"],[12,1,"ちか"],[15,1,"ち"],[18,1,"かれ"],[21,1,"みちび"],[23,1,"い"],[26,1,"とき"],[28,1,"かれ"],[35,1,"たか"],[37,1,"おか"],[44,1,"しげ"],[47,1,"き"],[50,1,"み"],[55,1,"ところ"],[57,2,"ぎせい"],[64,1,"い"],[68,1,"そな"],[70,1,"もの"],[89,1,"ところ"],[91,1,"のぼ"],[97,1,"ところ"],[99,2,"かんさい"],[102,1,"そそ"]],"text":"わたしが彼らに与えようと誓った地に、彼らを導き入れた時、彼らはすべての高い丘と、すべての茂った木とを見て、その所で犠牲をささげ、忌むべき供え物をささげ、またこうばしいかおりをその所に上らせ、その所に灌祭を注いだ。"},{"ref":"Ezek.20.29","start":26020029,"end":26020029,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[18,1,"かよ"],[22,1,"たか"],[24,1,"ところ"],[38,1,"な"],[40,2,"こんにち"]],"text":"（わたしは彼らに言った、あなたがたが通うその高き所はなんであるか。それでその名は今日までバマととなえられている。）"},{"ref":"Ezek.20.30","start":26020030,"end":26020030,"break":"none","ruby":[[11,1,"いえ"],[13,1,"い"],[16,1,"しゅ"],[19,1,"かみ"],[23,1,"い"],[37,2,"せんぞ"],[45,1,"したが"],[51,1,"み"],[53,1,"けが"],[58,1,"にく"],[65,1,"した"]],"text":"それゆえ、イスラエルの家に言え。主なる神はこう言われる、あなたがたは、その先祖のおこないに従って、その身を汚し、その憎むべきものを慕うのか。"},{"ref":"Ezek.20.31","start":26020031,"end":26020031,"break":"none","ruby":[[9,1,"そな"],[11,1,"もの"],[19,1,"こ"],[20,1,"とも"],[22,1,"ひ"],[24,1,"なか"],[26,1,"とお"],[31,2,"こんにち"],[39,2,"ぐうぞう"],[48,1,"み"],[50,1,"けが"],[63,1,"いえ"],[79,1,"たず"],[96,1,"い"],[106,1,"けっ"],[115,1,"たず"],[127,1,"しゅ"],[130,1,"かみ"],[132,1,"い"]],"text":"あなたがたは、その供え物をささげ、その子供に火の中を通らせて、今日まですべての偶像をもって、その身を汚すのである。イスラエルの家よ、わたしは、なおあなたがたに尋ねられるべきであろうか。わたしは生きている。わたしは決してあなたがたに尋ねられるはずはないと、主なる神は言われる。"},{"ref":"Ezek.20.32","start":26020032,"end":26020032,"break":"paragraph","ruby":[[6,1,"こころ"],[23,3,"いほうじん"],[33,2,"くにぐに"],[52,1,"き"],[54,1,"いし"],[56,1,"おが"],[62,1,"かんが"],[65,1,"けっ"],[68,2,"じょうじゅ"]],"text":"あなたがたの心にあること、すなわち『われわれは異邦人のようになり、国々のもろもろのやからのようになって、木や石を拝もう』との考えは決して成就しない。"},{"ref":"Ezek.20.33","start":26020033,"end":26020033,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[14,1,"い"],[24,1,"かなら"],[26,1,"つよ"],[28,1,"て"],[30,1,"の"],[33,1,"うで"],[35,1,"そそ"],[39,1,"いきどお"],[53,1,"おさ"]],"text":"主なる神は言われる、わたしは生きている、わたしは必ず強い手と伸べた腕と注がれた憤りとをもって、あなたがたを治める。"},{"ref":"Ezek.20.34","start":26020034,"end":26020034,"break":"none","ruby":[[6,1,"つよ"],[8,1,"て"],[10,1,"の"],[13,1,"うで"],[15,1,"そそ"],[19,1,"いきどお"],[38,1,"たみ"],[40,1,"なか"],[43,1,"みちび"],[45,1,"だ"],[50,1,"ち"],[55,2,"くにぐに"],[59,1,"あつ"]],"text":"わたしはわが強い手と伸べた腕と注がれた憤りとをもって、あなたがたをもろもろの民の中から導き出し、その散らされた国々から集め、"},{"ref":"Ezek.20.35","start":26020035,"end":26020035,"break":"none","ruby":[[5,1,"たみ"],[7,2,"あらの"],[10,1,"みちび"],[12,1,"い"],[17,1,"ところ"],[19,1,"かお"],[21,1,"かお"],[24,1,"あ"]],"text":"もろもろの民の荒野に導き入れ、その所で顔と顔とを合わせて、あなたがたをさばく。"},{"ref":"Ezek.20.36","start":26020036,"end":26020036,"break":"none","ruby":[[10,1,"ち"],[12,2,"あらの"],[22,2,"せんぞ"],[48,1,"しゅ"],[51,1,"かみ"],[53,1,"い"]],"text":"すなわち、エジプトの地の荒野で、あなたがたの先祖をさばいたように、わたしはあなたがたをさばくと、主なる神は言われる。"},{"ref":"Ezek.20.37","start":26020037,"end":26020037,"break":"none","ruby":[[14,1,"した"],[16,1,"とお"],[20,1,"かぞ"]],"text":"わたしはあなたがたに、むちの下を通らせ、数えてはいらせ、"},{"ref":"Ezek.20.38","start":26020038,"end":26020038,"break":"none","ruby":[[11,1,"したが"],[14,1,"もの"],[25,1,"もの"],[28,1,"わ"],[34,2,"きりゅう"],[38,1,"ち"],[42,1,"かれ"],[45,1,"みちび"],[47,1,"だ"],[53,1,"かれ"],[62,1,"ち"],[64,1,"い"],[88,1,"しゅ"],[95,1,"し"]],"text":"あなたがたのうちから、従わぬ者と、わたしにそむいた者とを分かち、その寄留した地から、彼らを導き出す。しかし彼らはイスラエルの地に入ることはできない。こうしてあなたがたはわたしが主であることを知るようになる。"},{"ref":"Ezek.20.39","start":26020039,"end":26020039,"break":"paragraph","ruby":[[10,1,"いえ"],[13,1,"しゅ"],[16,1,"かみ"],[20,1,"い"],[35,1,"き"],[42,1,"いま"],[44,1,"のち"],[53,2,"ぐうぞう"],[56,1,"い"],[59,1,"つか"],[69,1,"ふたた"],[71,1,"そな"],[73,1,"もの"],[75,2,"ぐうぞう"],[87,1,"せい"],[90,1,"な"],[92,1,"けが"]],"text":"それで、イスラエルの家よ、主なる神はこう言われる、あなたがたはわたしに聞かないなら、今も後も、おのおのその偶像に行って仕えるがよい。しかし再び供え物と偶像とをもって、わたしの聖なる名を汚してはならない。"},{"ref":"Ezek.20.40","start":26020040,"end":26020040,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[14,1,"せい"],[17,1,"やま"],[25,1,"たか"],[27,1,"やま"],[29,1,"うえ"],[38,2,"ぜんか"],[43,1,"ち"],[55,1,"つか"],[61,1,"ところ"],[67,1,"よろこ"],[70,1,"かれ"],[73,1,"う"],[87,1,"もの"],[89,2,"さいじょう"],[92,1,"そな"],[94,1,"もの"],[100,1,"せい"],[106,1,"もの"],[108,1,"とも"],[110,1,"もと"]],"text":"主なる神は言われる、わたしの聖なる山、イスラエルの高い山の上で、イスラエルの全家はその地で、ことごとくわたしに仕える。その所でわたしは喜んで彼らを受けいれ、あなたがたのささげ物と最上の供え物とを、その聖なるささげ物と共に求める。"},{"ref":"Ezek.20.41","start":26020041,"end":26020041,"break":"none","ruby":[[15,1,"たみ"],[17,1,"なか"],[20,1,"みちび"],[22,1,"だ"],[34,1,"ち"],[38,2,"くにぐに"],[42,1,"あつ"],[45,1,"とき"],[65,1,"よろこ"],[68,1,"う"],[81,3,"いほうじん"],[85,1,"まえ"],[94,1,"なか"],[101,1,"せい"]],"text":"わたしがあなたがたをもろもろの民の中から導き出し、かつてあなたがたを散らした国々から集める時、こうばしいかおりとして、あなたがたを喜んで受けいれる。そしてわたしは異邦人の前で、あなたがたの中に、わたしの聖なることをあらわす。"},{"ref":"Ezek.20.42","start":26020042,"end":26020042,"break":"none","ruby":[[21,1,"ち"],[33,2,"せんぞ"],[38,1,"あた"],[42,1,"ちか"],[45,1,"ち"],[53,1,"とき"],[65,1,"しゅ"],[72,1,"し"]],"text":"こうしてわたしがあなたがたを、イスラエルの地、すなわちあなたがたの先祖たちに与えると誓った地に、はいらせる時、あなたがたはわたしが主であることを知るようになる。"},{"ref":"Ezek.20.43","start":26020043,"end":26020043,"break":"none","ruby":[[4,1,"ところ"],[15,1,"み"],[17,1,"けが"],[40,1,"おも"],[42,1,"だ"],[49,1,"おこな"],[56,2,"あくじ"],[63,2,"じぶん"],[66,1,"い"]],"text":"またその所であなたがたは、その身を汚したあなたがたのおこないと、すべてのわざとを思い出し、みずから行ったすべての悪事のために、自分を忌みきらうようになる。"},{"ref":"Ezek.20.44","start":26020044,"end":26020044,"break":"none","ruby":[[6,1,"いえ"],[19,1,"あ"],[35,1,"くさ"],[49,1,"な"],[61,1,"あつか"],[63,1,"とき"],[75,1,"しゅ"],[82,1,"し"],[90,1,"しゅ"],[93,1,"かみ"],[95,1,"い"]],"text":"イスラエルの家よ、わたしがあなたがたの悪しきおこないによらず、またその腐れたわざによらず、わたしの名のために、あなたがたを扱う時、あなたがたはわたしが主であることを知るのであると、主なる神は言われる」。"},{"ref":"Ezek.20.45","start":26020045,"end":26020045,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"]],"text":"主の言葉がまたわたしに臨んだ、"},{"ref":"Ezek.20.46","start":26020046,"end":26020046,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[6,1,"かお"],[8,1,"みなみ"],[10,1,"む"],[13,1,"みなみ"],[15,1,"む"],[19,1,"かた"],[26,1,"もり"],[28,1,"ち"],[30,1,"たい"],[33,2,"よげん"]],"text":"「人の子よ、顔を南に向け、南に向かって語り、ネゲブの森の地に対して預言せよ。"},{"ref":"Ezek.20.47","start":26020047,"end":26020047,"break":"none","ruby":[[8,1,"もり"],[10,1,"い"],[13,1,"しゅ"],[15,2,"ことば"],[18,1,"き"],[21,1,"しゅ"],[24,1,"かみ"],[28,1,"い"],[33,1,"み"],[47,1,"ひ"],[49,1,"も"],[55,1,"ひ"],[68,2,"あおき"],[76,1,"か"],[78,1,"き"],[80,1,"や"],[82,1,"ほろ"],[88,1,"も"],[91,1,"ほのお"],[93,1,"け"],[103,1,"みなみ"],[106,1,"きた"],[114,1,"ち"],[127,1,"や"]],"text":"すなわちネゲブの森に言え、主の言葉を聞け、主なる神はこう言われる、見よ、わたしはあなたのうちに火を燃やす。その火はあなたのうちのすべての青木と、すべての枯れ木を焼き滅ぼし、その燃える炎は消されることがなく、南から北まで、すべての地のおもては、これがために焼ける。"},{"ref":"Ezek.20.48","start":26020048,"end":26020048,"break":"none","ruby":[[3,1,"にく"],[6,1,"もの"],[9,1,"しゅ"],[19,1,"や"],[25,1,"み"],[30,1,"ひ"],[32,1,"け"]],"text":"すべて肉なる者は、主なるわたしがこれを焼いたことを見る。その火は消されない」。"},{"ref":"Ezek.20.49","start":26020049,"end":26020049,"break":"none","ruby":[[7,1,"い"],[14,1,"しゅ"],[17,1,"かみ"],[20,1,"かれ"],[32,1,"かた"],[40,1,"かれ"],[49,1,"かた"],[51,1,"もの"]],"text":"そこでわたしは言った、「ああ主なる神よ、彼らはわたしについてこう語っています、『彼はたとえをもって語る者ではないか』と」。"}]