[{"ref":"Prov.28.1","start":20028001,"end":20028001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"お"],[7,1,"ひと"],[13,1,"に"],[17,1,"ただ"],[20,1,"ひと"],[28,1,"いさ"]],"text":"悪しき者は追う人もないのに逃げる、正しい人はししのように勇ましい。"},{"ref":"Prov.28.2","start":20028002,"end":20028002,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"くに"],[2,1,"つみ"],[8,1,"おさ"],[11,1,"もの"],[13,1,"おお"],[24,2,"ちしき"],[28,1,"ひと"],[34,1,"くに"],[39,1,"たも"]],"text":"国の罪によって、治める者は多くなり、さとく、また知識ある人によって、国はながく保つ。"},{"ref":"Prov.28.3","start":20028003,"end":20028003,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[10,1,"まず"],[13,1,"ひと"],[16,2,"りょうしょく"],[19,1,"のこ"],[23,1,"はげ"],[26,1,"あめ"]],"text":"貧しい者をしえたげる貧しい人は、糧食を残さない激しい雨のようだ。"},{"ref":"Prov.28.4","start":20028004,"end":20028004,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"りっぽう"],[3,1,"す"],[6,1,"もの"],[8,1,"あ"],[11,1,"もの"],[17,2,"りっぽう"],[20,1,"まも"],[22,1,"もの"],[27,2,"てきたい"]],"text":"律法を捨てる者は悪しき者をほめる、律法を守る者はこれに敵対する。"},{"ref":"Prov.28.5","start":20028005,"end":20028005,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"あくにん"],[3,1,"ただ"],[9,1,"さと"],[14,1,"しゅ"],[16,1,"もと"],[19,1,"もの"],[29,1,"さと"]],"text":"悪人は正しいことを悟らない、主を求める者はこれをことごとく悟る。"},{"ref":"Prov.28.6","start":20028006,"end":20028006,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"ただ"],[3,1,"あゆ"],[5,1,"まず"],[8,1,"もの"],[11,1,"まが"],[14,1,"みち"],[16,1,"あゆ"],[18,1,"と"],[21,1,"もの"]],"text":"正しく歩む貧しい者は、曲った道を歩む富める者にまさる。"},{"ref":"Prov.28.7","start":20028007,"end":20028007,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"りっぽう"],[3,1,"まも"],[5,1,"もの"],[7,1,"かしこ"],[9,1,"こ"],[14,3,"ふひんこう"],[18,1,"もの"],[20,1,"まじ"],[27,1,"ちち"]],"text":"律法を守る者は賢い子である、不品行な者と交わるものは、父をはずかしめる。"},{"ref":"Prov.28.8","start":20028008,"end":20028008,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"りそく"],[3,2,"こうり"],[12,1,"とみ"],[16,1,"もの"],[19,1,"まず"],[22,1,"もの"],[24,1,"めぐ"],[26,1,"もの"]],"text":"利息と高利とによってその富をます者は、貧しい者を恵む者のために、それをたくわえる。"},{"ref":"Prov.28.9","start":20028009,"end":20028009,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"みみ"],[6,2,"りっぽう"],[9,1,"き"],[13,1,"もの"],[18,1,"いのり"],[23,1,"にく"]],"text":"耳をそむけて律法を聞かない者は、その祈でさえも憎まれる。"},{"ref":"Prov.28.10","start":20028010,"end":20028010,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"わる"],[7,1,"みち"],[9,1,"まど"],[12,1,"もの"],[19,2,"じぶん"],[22,1,"あな"],[24,1,"おちい"],[30,2,"せいじつ"],[33,1,"ひと"],[35,2,"こうふく"],[38,1,"つ"]],"text":"正しい者を悪い道に惑わす者は、みずから自分の穴に陥る、しかし誠実な人は幸福を継ぐ。"},{"ref":"Prov.28.11","start":20028011,"end":20028011,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"と"],[3,1,"ひと"],[5,2,"じぶん"],[8,1,"め"],[10,1,"みずか"],[13,2,"ちえ"],[17,1,"もの"],[19,1,"み"],[25,1,"さと"],[30,1,"まず"],[33,1,"もの"],[35,1,"かれ"],[37,1,"み"]],"text":"富める人は自分の目に自らを知恵ある者と見る、しかし悟りのある貧しい者は彼を見やぶる。"},{"ref":"Prov.28.12","start":20028012,"end":20028012,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"か"],[11,1,"おお"],[15,1,"さか"],[21,1,"あ"],[24,1,"もの"],[26,1,"おこ"],[32,1,"たみ"],[34,1,"み"]],"text":"正しい者が勝つときは、大いなる栄えがある、悪しき者が起るときは、民は身をかくす。"},{"ref":"Prov.28.13","start":20028013,"end":20028013,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"つみ"],[4,1,"かく"],[6,1,"もの"],[8,1,"さか"],[17,1,"い"],[19,1,"あら"],[26,1,"はな"],[29,1,"もの"]],"text":"その罪を隠す者は栄えることがない、言い表わしてこれを離れる者は、あわれみをうける。"},{"ref":"Prov.28.14","start":20028014,"end":20028014,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"つね"],[2,1,"しゅ"],[4,1,"おそ"],[7,1,"ひと"],[17,1,"こころ"],[26,1,"もの"],[28,1,"わざわい"],[30,1,"おちい"]],"text":"常に主を恐れる人はさいわいである、心をかたくなにする者は災に陥る。"},{"ref":"Prov.28.15","start":20028015,"end":20028015,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"まず"],[3,1,"たみ"],[5,1,"おさ"],[8,1,"わる"],[24,1,"う"]],"text":"貧しい民を治める悪いつかさは、ほえるしし、または飢えたくまのようだ。"},{"ref":"Prov.28.16","start":20028016,"end":20028016,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"さと"],[9,2,"ざんにん"],[12,3,"あっせいしゃ"],[19,2,"ふせい"],[22,1,"り"],[24,1,"にく"],[26,1,"もの"],[28,2,"ちょうめい"],[31,1,"え"]],"text":"悟りのないつかさは残忍な圧制者である、不正の利を憎む者は長命を得る。"},{"ref":"Prov.28.17","start":20028017,"end":20028017,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[0,1,"ひと"],[2,1,"ころ"],[7,1,"ち"],[9,1,"み"],[11,1,"お"],[13,1,"もの"],[15,1,"し"],[35,1,"たす"]],"text":"人を殺してその血を身に負う者は死ぬまで、のがれびとである、だれもこれを助けてはならない。"},{"ref":"Prov.28.18","start":20028018,"end":20028018,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"ただ"],[3,1,"あゆ"],[5,1,"もの"],[7,1,"すくい"],[9,1,"え"],[11,1,"まが"],[14,1,"みち"],[16,1,"あゆ"],[18,1,"もの"],[20,1,"あな"],[22,1,"おちい"]],"text":"正しく歩む者は救を得、曲った道に歩む者は穴に陥る。"},{"ref":"Prov.28.19","start":20028019,"end":20028019,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"じぶん"],[3,2,"でんち"],[6,1,"たがや"],[8,1,"もの"],[10,2,"しょくりょう"],[13,1,"あ"],[16,2,"むえき"],[19,1,"こと"],[21,1,"したが"],[23,1,"もの"],[25,2,"びんぼう"],[28,1,"あ"]],"text":"自分の田地を耕す者は食糧に飽き、無益な事に従う者は貧乏に飽きる。"},{"ref":"Prov.28.20","start":20028020,"end":20028020,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"ちゅうじつ"],[3,1,"ひと"],[5,1,"おお"],[8,2,"しゅくふく"],[11,1,"え"],[14,1,"いそ"],[17,1,"とみ"],[19,1,"え"],[25,1,"もの"],[27,1,"ばつ"],[29,1,"まぬか"]],"text":"忠実な人は多くの祝福を得る、急いで富を得ようとする者は罰を免れない。"},{"ref":"Prov.28.21","start":20028021,"end":20028021,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ひと"],[2,2,"かたよ"],[5,1,"み"],[10,1,"よ"],[15,1,"ひと"],[17,1,"いち"],[18,1,"き"],[31,1,"おか"]],"text":"人を片寄り見ることは良くない、人は一切れのパンのために、とがを犯すことがある。"},{"ref":"Prov.28.22","start":20028022,"end":20028022,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"よく"],[2,1,"ふか"],[4,1,"ひと"],[6,1,"いそ"],[9,1,"とみ"],[11,1,"え"],[22,2,"けつぼう"],[25,2,"じぶん"],[28,1,"ところ"],[30,1,"く"],[35,1,"し"]],"text":"欲の深い人は急いで富を得ようとする、かえって欠乏が自分の所に来ることを知らない。"},{"ref":"Prov.28.23","start":20028023,"end":20028023,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ひと"],[2,1,"いまし"],[5,1,"もの"],[7,1,"した"],[16,1,"もの"],[21,1,"おお"],[25,2,"かんしゃ"]],"text":"人を戒める者は舌をもってへつらう者よりも、大いなる感謝をうける。"},{"ref":"Prov.28.24","start":20028024,"end":20028024,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"ちち"],[2,1,"はは"],[4,1,"もの"],[6,1,"ぬす"],[13,1,"つみ"],[20,1,"い"],[22,1,"もの"],[25,1,"ほろ"],[28,1,"もの"],[30,1,"とも"]],"text":"父や母の物を盗んで「これは罪ではない」と言う者は、滅ぼす者の友である。"},{"ref":"Prov.28.25","start":20028025,"end":20028025,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"もの"],[6,1,"あらそ"],[9,1,"おこ"],[12,1,"しゅ"],[14,2,"しんらい"],[18,1,"もの"],[20,1,"ゆた"]],"text":"むさぼる者は争いを起し、主に信頼する者は豊かになる。"},{"ref":"Prov.28.26","start":20028026,"end":20028026,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"じぶん"],[3,1,"こころ"],[5,1,"たの"],[7,1,"もの"],[9,1,"おろ"],[15,2,"ちえ"],[21,1,"あゆ"],[23,1,"もの"],[25,1,"すくい"],[27,1,"え"]],"text":"自分の心を頼む者は愚かである、知恵をもって歩む者は救を得る。"},{"ref":"Prov.28.27","start":20028027,"end":20028027,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[5,1,"ほどこ"],[7,1,"もの"],[9,1,"もの"],[11,2,"ふそく"],[17,1,"め"],[23,1,"み"],[26,1,"ひと"],[28,1,"おお"]],"text":"貧しい者に施す者は物に不足しない、目をおおって見ない人は多くののろいをうける。"},{"ref":"Prov.28.28","start":20028028,"end":20028028,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"おこ"],[11,1,"たみ"],[13,1,"み"],[21,1,"ほろ"],[28,1,"ただ"],[31,1,"ひと"],[33,1,"ま"]],"text":"悪しき者が起るときは、民は身をかくす、その滅びるときは、正しい人が増す。"}]