[{"ref":"Ezek.7.1","start":26007001,"end":26007001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"]],"text":"主の言葉がまたわたしに臨んだ、"},{"ref":"Ezek.7.2","start":26007002,"end":26007002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[12,1,"ち"],[14,1,"おわ"],[20,1,"しゅ"],[24,1,"い"],[31,1,"くに"],[33,2,"しほう"],[36,1,"さかい"],[38,1,"おわ"],[41,1,"き"]],"text":"「人の子よ、イスラエルの地の終りについて主はこう言われる、この国の四方の境に終りが来た。"},{"ref":"Ezek.7.3","start":26007003,"end":26007003,"break":"none","ruby":[[7,1,"おわ"],[10,1,"き"],[19,1,"いか"],[26,1,"も"],[34,1,"おこな"],[37,1,"したが"],[58,1,"にく"],[62,1,"もの"],[71,1,"ばっ"]],"text":"いま、あなたの終りが来た。わたしはわが怒りをあなたに漏らし、あなたの行いに従って、あなたをさばき、あなたのもろもろの憎むべき物のためにあなたを罰する。"},{"ref":"Ezek.7.4","start":26007004,"end":26007004,"break":"none","ruby":[[4,1,"め"],[10,1,"お"],[13,1,"み"],[37,1,"おこな"],[47,1,"ばっ"],[55,1,"にく"],[59,1,"こと"],[88,1,"しゅ"],[95,1,"し"]],"text":"わたしの目はあなたを惜しみ見ず、またあなたをあわれまない。わたしはあなたの行いのためにあなたを罰する。あなたの憎むべき事があなたのうちにある。これによって、あなたがたはわたしが主であることを知るようになる。"},{"ref":"Ezek.7.5","start":26007005,"end":26007005,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[12,1,"わざわい"],[14,1,"ひ"],[16,1,"つづ"],[19,1,"おこ"],[22,1,"み"],[25,1,"わざわい"],[27,1,"く"]],"text":"主なる神はこう言われる、災が引き続いて起る。見よ、災が来る。"},{"ref":"Ezek.7.6","start":26007006,"end":26007006,"break":"none","ruby":[[0,1,"おわ"],[3,1,"く"],[8,1,"おわ"],[11,1,"く"],[17,1,"た"],[25,1,"のぞ"],[28,1,"み"],[34,1,"く"]],"text":"終りが来る。その終りが来る。それが起って、あなたに臨む。見よ、それが来る。"},{"ref":"Ezek.7.7","start":26007007,"end":26007007,"break":"none","ruby":[[2,1,"ち"],[4,1,"す"],[6,1,"もの"],[13,2,"さいご"],[16,2,"うんめい"],[23,1,"き"],[26,1,"とき"],[28,1,"き"],[31,1,"ひ"],[33,1,"ちか"],[38,2,"こんらん"],[41,1,"ひ"],[44,2,"やまやま"],[47,1,"きこ"],[50,1,"よろこ"],[53,1,"ひ"]],"text":"この地に住む者よ、あなたの最後の運命があなたに来た。時は来た。日が近づいた。混乱の日で、山々に聞える喜びの日ではない。"},{"ref":"Ezek.7.8","start":26007008,"end":26007008,"break":"none","ruby":[[0,1,"いま"],[15,1,"いきどお"],[22,1,"うえ"],[24,1,"そそ"],[31,1,"いか"],[38,1,"も"],[41,1,"つく"],[48,1,"おこな"],[51,1,"したが"],[71,1,"にく"],[75,1,"こと"],[84,1,"ばっ"]],"text":"今わたしは、すみやかにわたしの憤りをあなたの上に注ぎ、わたしの怒りをあなたに漏らし尽し、あなたの行いに従ってあなたをさばき、あなたのもろもろの憎むべき事のためにあなたを罰する。"},{"ref":"Ezek.7.9","start":26007009,"end":26007009,"break":"none","ruby":[[4,1,"め"],[10,1,"お"],[13,1,"み"],[37,1,"おこな"],[47,1,"ばっ"],[55,1,"にく"],[59,1,"こと"],[85,1,"しゅ"],[97,1,"う"],[102,1,"し"]],"text":"わたしの目はあなたを惜しみ見ず、またあなたをあわれまない。わたしはあなたの行いのためにあなたを罰する。あなたの憎むべき事があなたのうちにある。これによって、あなたがたは、主であるわたしがあなたを撃つことを知るようになる。"},{"ref":"Ezek.7.10","start":26007010,"end":26007010,"break":"paragraph","ruby":[[0,1,"み"],[5,1,"ひ"],[10,1,"み"],[15,1,"ひ"],[17,1,"き"],[24,2,"さいご"],[27,2,"うんめい"],[30,1,"き"],[33,2,"ふぎ"],[36,1,"はな"],[37,1,"さ"],[40,1,"たか"],[44,1,"め"],[46,1,"だ"]],"text":"見よ、その日を。また見よ、かの日が来た。あなたの最後の運命が来た。不義は花咲き、高ぶりは芽を出した。"},{"ref":"Ezek.7.11","start":26007011,"end":26007011,"break":"none","ruby":[[0,2,"ぼうぎゃく"],[7,1,"あく"],[16,1,"かれ"],[21,2,"ぐんしゅう"],[27,1,"とみ"],[29,1,"き"],[34,1,"かれ"],[37,2,"めいせい"],[40,1,"き"],[43,1,"なに"],[45,1,"のこ"]],"text":"暴虐はつのって悪のつえとなった。彼らもその群衆も、その富も消え、また彼らの名声も消えて何も残らなくなる。"},{"ref":"Ezek.7.12","start":26007012,"end":26007012,"break":"none","ruby":[[0,1,"とき"],[2,1,"き"],[5,1,"ひ"],[7,1,"ちか"],[12,1,"か"],[14,1,"もの"],[16,1,"よろこ"],[20,1,"う"],[22,1,"もの"],[24,1,"かな"],[29,1,"いか"],[36,2,"ぐんしゅう"],[39,1,"うえ"],[41,1,"のぞ"]],"text":"時は来た。日は近づいた。買う者は喜ぶな。売る者は悲しむな。怒りがすべての群衆の上に臨むからだ。"},{"ref":"Ezek.7.13","start":26007013,"end":26007013,"break":"none","ruby":[[0,1,"う"],[2,1,"もの"],[7,1,"い"],[16,1,"う"],[22,1,"かえ"],[30,1,"いか"],[39,2,"みんしゅう"],[42,1,"うえ"],[56,1,"かえ"],[63,2,"ふぎ"],[73,1,"いのち"],[75,1,"まっと"]],"text":"売る者はたとい生きていても、その売ったものに帰ることはない。怒りがそのすべての民衆の上にあるからだ。それはもとに帰らない。その不義のために、だれも命を全うすることはできない。"},{"ref":"Ezek.7.14","start":26007014,"end":26007014,"break":"paragraph","ruby":[[0,2,"ひとびと"],[7,1,"ふ"],[10,1,"そな"],[16,1,"たたか"],[19,1,"で"],[21,1,"もの"],[33,1,"いか"],[42,2,"ぐんしゅう"],[45,1,"うえ"]],"text":"人々がラッパを吹いて備えをしても戦いに出る者はない。それはわたしの怒りがそのすべての群衆の上にあるからだ。"},{"ref":"Ezek.7.15","start":26007015,"end":26007015,"break":"none","ruby":[[0,1,"そと"],[10,1,"うち"],[13,2,"えきびょう"],[23,1,"はたけ"],[27,1,"もの"],[33,1,"し"],[36,1,"まち"],[40,1,"もの"],[46,2,"えきびょう"],[49,1,"ほろ"]],"text":"外にはつるぎがあり、内には疫病とききんがある。畑にいる者はつるぎに死に、町にいる者はききんと疫病に滅ぼされる。"},{"ref":"Ezek.7.16","start":26007016,"end":26007016,"break":"none","ruby":[[10,1,"もの"],[12,2,"たにま"],[21,2,"やまやま"],[24,1,"い"],[32,1,"みな"],[35,1,"つみ"],[40,1,"かな"]],"text":"そのうちの、のがれる者は谷間のはとのように山々に行って、おのおの皆その罪のために悲しむ。"},{"ref":"Ezek.7.17","start":26007017,"end":26007017,"break":"none","ruby":[[0,2,"りょうて"],[4,1,"よわ"],[9,1,"りょう"],[14,1,"みず"],[19,1,"よわ"]],"text":"両手とも弱くなり、両ひざとも水のように弱くなる。"},{"ref":"Ezek.7.18","start":26007018,"end":26007018,"break":"none","ruby":[[0,1,"かれ"],[3,2,"あらぬの"],[6,1,"み"],[12,1,"おそ"],[15,1,"かれ"],[26,1,"かお"],[29,1,"はじ"],[40,1,"あたま"],[42,1,"かみ"],[46,1,"おと"]],"text":"彼らは荒布を身にまとい、恐れが彼らをおおい、すべての顔には恥があらわれ、すべての頭は髪をそり落す。"},{"ref":"Ezek.7.19","start":26007019,"end":26007019,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ぎん"],[11,1,"す"],[16,1,"きん"],[28,1,"しゅ"],[30,1,"いか"],[33,1,"ひ"],[36,2,"きんぎん"],[39,1,"かれ"],[42,1,"すく"],[56,1,"かれ"],[59,1,"う"],[62,2,"まんぞく"],[79,1,"はら"],[81,1,"み"],[95,1,"かれ"],[98,2,"ふぎ"]],"text":"彼らはその銀をちまたに捨て、その金はあくたのようになる。主の怒りの日には金銀も彼らを救うことはできない。それらは彼らの飢えを満足させることができない、またその腹を満たすことができない。それは彼らの不義のつまずきであったからだ。"},{"ref":"Ezek.7.20","start":26007020,"end":26007020,"break":"none","ruby":[[0,1,"かれ"],[5,1,"うつく"],[8,1,"かざ"],[10,1,"もの"],[12,1,"たか"],[19,1,"もち"],[32,1,"にく"],[36,2,"ぐうぞう"],[39,1,"い"],[43,1,"もの"],[45,1,"つく"],[60,1,"かれ"],[63,1,"たい"],[66,1,"けが"]],"text":"彼らはその美しい飾り物を高ぶりのために用い、またこれをもってその憎むべき偶像と忌むべき物を造った。それゆえわたしはこれを彼らに対して汚れたものとする。"},{"ref":"Ezek.7.21","start":26007021,"end":26007021,"break":"none","ruby":[[7,2,"がいこく"],[9,1,"じん"],[11,1,"て"],[13,1,"わた"],[16,1,"うば"],[20,1,"ち"],[22,2,"あくにん"],[25,1,"わた"],[35,1,"かれ"],[41,1,"けが"]],"text":"わたしはこれを外国人の手に渡して奪わせ、地の悪人に渡してかすめさせる。彼らはこれを汚す。"},{"ref":"Ezek.7.22","start":26007022,"end":26007022,"break":"none","ruby":[[4,1,"かれ"],[8,1,"かお"],[15,1,"かれ"],[22,2,"せいじょ"],[25,1,"けが"],[30,2,"ごうとう"],[40,1,"けが"]],"text":"わたしは彼らから顔をそむけて、彼らにわたしの聖所を汚させる。強盗がこれにはいって汚し、"},{"ref":"Ezek.7.23","start":26007023,"end":26007023,"break":"none","breaks":[[9,"paragraph"]],"ruby":[[2,1,"あ"],[4,1,"ち"],[11,1,"ち"],[13,2,"りゅうけつ"],[19,1,"み"],[24,1,"まち"],[26,2,"ぼうぎゃく"],[29,1,"み"]],"text":"また荒れ地とする。この地は流血のとがに満ち、この町は暴虐に満ちているゆえ、"},{"ref":"Ezek.7.24","start":26007024,"end":26007024,"break":"none","ruby":[[4,2,"くにぐに"],[10,1,"わる"],[12,1,"もの"],[16,1,"まね"],[20,1,"かれ"],[23,1,"いえ"],[36,1,"つよ"],[38,1,"もの"],[40,1,"たか"],[52,1,"かれ"],[55,2,"せいじょ"],[58,1,"けが"]],"text":"わたしは国々のうちの悪い者どもを招いて、彼らの家をかすめさせる。わたしは強い者の高ぶりをやめさせる。また彼らの聖所は汚される。"},{"ref":"Ezek.7.25","start":26007025,"end":26007025,"break":"none","ruby":[[0,1,"ほろ"],[3,1,"く"],[8,1,"かれ"],[11,2,"へいあん"],[14,1,"もと"],[18,1,"え"]],"text":"滅びが来るとき、彼らは平安を求めても得られない。"},{"ref":"Ezek.7.26","start":26007026,"end":26007026,"break":"none","ruby":[[0,1,"わざわい"],[2,1,"わざわい"],[4,1,"かさ"],[11,1,"し"],[15,1,"し"],[19,1,"あい"],[25,1,"とき"],[27,1,"かれ"],[30,3,"よげんしゃ"],[34,1,"まぼろし"],[36,1,"もと"],[43,2,"りっぽう"],[46,2,"さいし"],[52,1,"た"],[55,1,"はか"],[60,2,"ちょうろう"],[66,1,"た"]],"text":"災に災が重なりきたり、知らせに知らせが相つぐ。その時、彼らは預言者に幻を求める。しかし律法は祭司のうちに絶え、計りごとは長老のうちに絶える。"},{"ref":"Ezek.7.27","start":26007027,"end":26007027,"break":"none","ruby":[[0,1,"おう"],[2,1,"かな"],[10,1,"のぞ"],[13,1,"うしな"],[18,1,"ち"],[20,1,"たみ"],[22,1,"て"],[41,1,"かれ"],[44,1,"おこな"],[47,1,"したが"],[50,1,"かれ"],[64,1,"したが"],[67,1,"かれ"],[77,1,"かれ"],[84,1,"しゅ"],[91,1,"し"]],"text":"王は悲しみ、つかさは望みを失い、その地の民の手はおののきによってこわばる。わたしは彼らの行いに従って彼らをあつかい、そのさばきに従って彼らをさばく。そして彼らはわたしが主であることを知るようになる」。"}]