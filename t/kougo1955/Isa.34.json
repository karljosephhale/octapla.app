[{"ref":"Isa.34.1","start":23034001,"end":23034001,"break":"paragraph","breaks":[[15,"line"],[29,"line"],[40,"line"]],"ruby":[[5,1,"くに"],[8,1,"ちか"],[12,1,"き"],[20,1,"たみ"],[23,1,"みみ"],[25,1,"かたむ"],[29,1,"ち"],[34,1,"み"],[40,2,"せかい"],[47,1,"で"],[57,1,"き"]],"text":"もろもろの国よ、近づいて聞け。もろもろの民よ、耳を傾けよ。地とそれに満ちるもの、世界とそれから出るすべてのものよ、聞け。"},{"ref":"Isa.34.2","start":23034002,"end":23034002,"break":"line","breaks":[[15,"line"],[31,"line"],[43,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"くに"],[12,1,"いか"],[21,2,"ぐんぜい"],[28,1,"いきどお"],[31,1,"かれ"],[39,1,"ほろ"],[43,1,"かれ"]],"text":"主はすべての国にむかって怒り、そのすべての軍勢にむかって憤り、彼らをことごとく滅ぼし、彼らをわたして、ほふらせられた。"},{"ref":"Isa.34.3","start":23034003,"end":23034003,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ころ"],[7,1,"な"],[16,2,"したい"],[19,2,"あくしゅう"],[22,1,"た"],[28,2,"やまやま"],[33,1,"ち"],[35,1,"と"],[38,1,"なが"]],"text":"彼らは殺されて投げすてられ、その死体の悪臭は立ちのぼり、山々はその血で溶けて流れる。"},{"ref":"Isa.34.4","start":23034004,"end":23034004,"break":"line","breaks":[[8,"line"],[25,"line"],[46,"line"]],"ruby":[[0,1,"てん"],[2,2,"ばんしょう"],[5,1,"おとろ"],[13,1,"てん"],[15,2,"まきもの"],[21,1,"ま"],[27,2,"ばんしょう"],[34,1,"き"],[37,1,"は"],[39,1,"お"],[51,1,"き"],[54,1,"は"],[56,1,"お"],[62,1,"お"]],"text":"天の万象は衰え、もろもろの天は巻物のように巻かれ、その万象はぶどうの木から葉の落ちるように、いちじくの木から葉の落ちるように落ちる。"},{"ref":"Isa.34.5","start":23034005,"end":23034005,"break":"paragraph","breaks":[[23,"line"],[39,"line"],[58,"line"]],"ruby":[[8,1,"てん"],[13,1,"いきどお"],[19,1,"よ"],[23,1,"み"],[33,1,"うえ"],[43,1,"ほろ"],[46,1,"さだ"],[49,1,"たみ"],[51,1,"うえ"]],"text":"わたしのつるぎは天において憤りをもって酔った。見よ、これはエドムの上にくだり、わたしが滅びに定めた民の上にくだって、これをさばく。"},{"ref":"Isa.34.6","start":23034006,"end":23034006,"break":"line","breaks":[[17,"line"],[25,"line"],[40,"line"],[55,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ち"],[8,1,"み"],[11,2,"しぼう"],[14,1,"こ"],[17,2,"こひつじ"],[23,1,"ち"],[25,2,"おひつじ"],[28,2,"じんぞう"],[31,2,"しぼう"],[34,1,"こ"],[40,1,"しゅ"],[46,2,"ぎせい"],[49,1,"けもの"],[59,1,"ち"],[61,1,"おお"],[64,1,"ころ"]],"text":"主のつるぎは血で満ち、脂肪で肥え、小羊とやぎの血、雄羊の腎臓の脂肪で肥えている。主がボズラで犠牲の獣をほふり、エドムの地で大いに殺されたからである。"},{"ref":"Isa.34.7","start":23034007,"end":23034007,"break":"line","breaks":[[17,"line"],[32,"line"],[41,"line"]],"ruby":[[0,2,"やぎゅう"],[3,1,"かれ"],[6,1,"とも"],[11,1,"ば"],[17,1,"こ"],[18,1,"うし"],[20,1,"ちから"],[23,2,"おうし"],[26,1,"とも"],[34,1,"くに"],[36,1,"ち"],[38,1,"よ"],[43,1,"つち"],[45,2,"しぼう"],[48,1,"こ"]],"text":"野牛は彼らと共にほふり場にくだり、子牛は力ある雄牛と共にくだる。その国は血で酔い、その土は脂肪で肥やされる。"},{"ref":"Isa.34.8","start":23034008,"end":23034008,"break":"line","breaks":[[13,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"ひ"],[17,1,"うった"],[23,1,"むく"],[28,1,"とし"]],"text":"主はあだをかえす日をもち、シオンの訴えのために報いられる年をもたれるからである。"},{"ref":"Isa.34.9","start":23034009,"end":23034009,"break":"line","breaks":[[20,"line"],[33,"line"]],"ruby":[[9,1,"かわ"],[11,1,"かわ"],[14,2,"じゅし"],[22,1,"つち"],[24,1,"かわ"],[27,2,"いおう"],[35,1,"ち"],[37,1,"かわ"],[40,1,"も"],[43,2,"じゅし"]],"text":"エドムのもろもろの川は変って樹脂となり、その土は変って硫黄となり、その地は変って燃える樹脂となって、"},{"ref":"Isa.34.10","start":23034010,"end":23034010,"break":"line","breaks":[[8,"line"],[24,"line"],[36,"line"]],"ruby":[[0,1,"よる"],[2,1,"ひる"],[4,1,"き"],[10,1,"けむり"],[18,1,"た"],[27,2,"よよ"],[29,1,"あ"],[46,1,"とお"],[48,1,"もの"]],"text":"夜も昼も消えず、その煙は、とこしえに立ちのぼる。これは世々荒れすたれて、とこしえまでもそこを通る者はない。"},{"ref":"Isa.34.11","start":23034011,"end":23034011,"break":"line","breaks":[[20,"line"],[36,"line"],[58,"line"]],"ruby":[[33,1,"す"],[36,1,"しゅ"],[40,1,"うえ"],[42,2,"こうはい"],[50,1,"はか"],[55,1,"は"],[58,1,"たっと"],[60,2,"ひとびと"],[63,1,"うえ"],[65,2,"こんらん"],[68,1,"おこ"],[70,1,"さ"],[72,1,"ふ"]],"text":"たかと、やまあらしとがそこをすみかとし、ふくろうと、からすがそこに住む。主はその上に荒廃をきたらせる測りなわを張り、尊い人々の上に混乱を起す下げ振りをさげられる。"},{"ref":"Isa.34.12","start":23034012,"end":23034012,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"ひとびと"],[6,1,"な"],[11,1,"くに"],[14,1,"ところ"],[22,1,"きみ"],[26,1,"みな"]],"text":"人々はこれを名づけて「国なき所」といい、その君たちは皆うせてなくなる。"},{"ref":"Isa.34.13","start":23034013,"end":23034013,"break":"line","breaks":[[17,"line"],[37,"line"]],"ruby":[[6,1,"うえ"],[14,1,"は"],[19,1,"しろ"],[34,1,"は"],[37,2,"やまいぬ"],[51,1,"ところ"]],"text":"そのとりでの上には、いばらが生え、その城には、いらくさと、あざみとが生え、山犬のすみか、だちょうのおる所となる。"},{"ref":"Isa.34.14","start":23034014,"end":23034014,"break":"line","breaks":[[13,"line"],[23,"line"]],"ruby":[[0,1,"の"],[2,1,"けもの"],[9,2,"であ"],[13,2,"きしん"],[18,1,"とも"],[20,1,"よ"],[23,1,"よる"],[25,2,"まじょ"],[31,1,"お"],[37,1,"やす"],[39,1,"ところ"],[41,1,"え"]],"text":"野の獣はハイエナと出会い、鬼神はその友を呼び、夜の魔女もそこに降りてきて、休み所を得る。"},{"ref":"Isa.34.15","start":23034015,"end":23034015,"break":"line","breaks":[[19,"line"],[40,"line"],[60,"line"]],"ruby":[[8,1,"す"],[14,1,"たまご"],[16,1,"う"],[32,1,"つばさ"],[34,1,"かげ"],[36,1,"あつ"],[52,1,"つ"],[54,1,"あ"],[57,1,"とも"],[63,1,"あつ"]],"text":"ふくろうはそこに巣をつくって卵を産み、それをかえして、そのひなを翼の陰に集める。とびもまた、おのおのその連れ合いと共に、そこに集まる。"},{"ref":"Isa.34.16","start":23034016,"end":23034016,"break":"line","breaks":[[16,"line"],[27,"line"],[45,"line"],[65,"line"],[78,"line"]],"ruby":[[6,1,"しゅ"],[8,1,"しょ"],[24,1,"よ"],[37,1,"か"],[52,1,"つ"],[54,1,"あ"],[57,1,"か"],[68,1,"しゅ"],[70,1,"くち"],[75,1,"めい"],[80,1,"れい"],[82,1,"かれ"],[85,1,"あつ"]],"text":"あなたがたは主の書をつまびらかにたずねて、これを読め。これらのものは一つも欠けることなく、また一つもその連れ合いを欠くものはない。これは主の口がこれを命じ、その霊が彼らを集められたからである。"},{"ref":"Isa.34.17","start":23034017,"end":23034017,"break":"line","breaks":[[14,"line"],[36,"line"],[46,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[11,1,"ひ"],[14,1,"て"],[18,1,"はか"],[29,1,"ち"],[31,1,"わ"],[33,1,"あた"],[36,1,"なが"],[38,1,"かれ"],[41,2,"しょゆう"],[46,2,"よよ"],[51,1,"す"]],"text":"主は彼らのためにくじを引き、手ずから測りなわをもって、この地を分け与え、長く彼らに所有させ、世々ここに住まわせられる。"}]