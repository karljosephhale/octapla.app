[{"ref":"John.20.1","start":43020001,"end":43020001,"break":"paragraph","ruby":[[4,1,"しゅう"],[6,1,"はじ"],[9,1,"ひ"],[12,1,"あさ"],[13,1,"はや"],[17,1,"くら"],[32,1,"はか"],[34,1,"い"],[38,1,"はか"],[41,1,"いし"],[52,1,"み"]],"text":"さて、一週の初めの日に、朝早くまだ暗いうちに、マグダラのマリヤが墓に行くと、墓から石がとりのけてあるのを見た。"},{"ref":"John.20.2","start":43020002,"end":43020002,"break":"none","ruby":[[3,1,"はし"],[19,1,"あい"],[33,2,"でし"],[40,1,"い"],[44,1,"かれ"],[47,1,"い"],[57,1,"しゅ"],[59,1,"はか"],[62,1,"と"],[64,1,"さ"],[73,1,"お"]],"text":"そこで走って、シモン・ペテロとイエスが愛しておられた、もうひとりの弟子のところへ行って、彼らに言った、「だれかが、主を墓から取り去りました。どこへ置いたのか、わかりません」。"},{"ref":"John.20.3","start":43020003,"end":43020003,"break":"none","ruby":[[13,2,"でし"],[16,1,"で"],[21,1,"はか"],[27,1,"い"]],"text":"そこでペテロともうひとりの弟子は出かけて、墓へむかって行った。"},{"ref":"John.20.4","start":43020004,"end":43020004,"break":"none","ruby":[[4,2,"いっしょ"],[7,1,"はし"],[9,1,"だ"],[22,2,"でし"],[25,1,"ほう"],[34,1,"はや"],[36,1,"はし"],[39,1,"さき"],[41,1,"はか"],[43,1,"つ"]],"text":"ふたりは一緒に走り出したが、そのもうひとりの弟子の方が、ペテロよりも早く走って先に墓に着き、"},{"ref":"John.20.5","start":43020005,"end":43020005,"break":"none","ruby":[[3,1,"み"],[13,3,"あまぬの"],[20,1,"お"],[27,1,"み"],[31,1,"なか"]],"text":"そして身をかがめてみると、亜麻布がそこに置いてあるのを見たが、中へははいらなかった。"},{"ref":"John.20.6","start":43020006,"end":43020006,"break":"none","ruby":[[8,1,"つづ"],[14,1,"はか"],[16,1,"なか"],[23,1,"かれ"],[25,3,"あまぬの"],[32,1,"お"],[39,1,"み"]],"text":"シモン・ペテロも続いてきて、墓の中にはいった。彼は亜麻布がそこに置いてあるのを見たが、"},{"ref":"John.20.7","start":43020007,"end":43020007,"break":"none","ruby":[[4,1,"あたま"],[6,1,"ま"],[12,1,"ぬの"],[14,3,"あまぬの"],[30,1,"べつ"],[32,2,"ばしょ"]],"text":"イエスの頭に巻いてあった布は亜麻布のそばにはなくて、はなれた別の場所にくるめてあった。"},{"ref":"John.20.8","start":43020008,"end":43020008,"break":"none","ruby":[[4,1,"さき"],[6,1,"はか"],[8,1,"つ"],[17,2,"でし"],[30,1,"み"],[32,1,"しん"]],"text":"すると、先に墓に着いたもうひとりの弟子もはいってきて、これを見て信じた。"},{"ref":"John.20.9","start":43020009,"end":43020009,"break":"none","ruby":[[4,1,"かれ"],[7,2,"しにん"],[32,1,"せい"],[33,1,"く"],[38,1,"さと"]],"text":"しかし、彼らは死人のうちからイエスがよみがえるべきことをしるした聖句を、まだ悟っていなかった。"},{"ref":"John.20.10","start":43020010,"end":43020010,"break":"none","ruby":[[9,2,"でし"],[14,2,"じぶん"],[17,1,"いえ"],[19,1,"かえ"],[22,1,"い"]],"text":"それから、ふたりの弟子たちは自分の家に帰って行った。"},{"ref":"John.20.11","start":43020011,"end":43020011,"break":"paragraph","ruby":[[8,1,"はか"],[10,1,"そと"],[12,1,"た"],[15,1,"な"],[24,1,"な"],[30,1,"み"],[36,1,"はか"],[38,1,"なか"]],"text":"しかし、マリヤは墓の外に立って泣いていた。そして泣きながら、身をかがめて墓の中をのぞくと、"},{"ref":"John.20.12","start":43020012,"end":43020012,"break":"none","ruby":[[0,1,"しろ"],[2,1,"ころも"],[4,1,"き"],[10,2,"みつかい"],[18,2,"したい"],[27,2,"ばしょ"],[35,1,"あたま"],[37,1,"ほう"],[44,1,"あし"],[46,1,"ほう"],[57,1,"み"]],"text":"白い衣を着たふたりの御使が、イエスの死体のおかれていた場所に、ひとりは頭の方に、ひとりは足の方に、すわっているのを見た。"},{"ref":"John.20.13","start":43020013,"end":43020013,"break":"none","ruby":[[4,1,"かれ"],[13,1,"おんな"],[18,1,"な"],[27,1,"い"],[35,1,"かれ"],[38,1,"い"],[52,1,"しゅ"],[54,1,"と"],[56,1,"さ"],[69,1,"お"]],"text":"すると、彼らはマリヤに、「女よ、なぜ泣いているのか」と言った。マリヤは彼らに言った、「だれかが、わたしの主を取り去りました。そして、どこに置いたのか、わからないのです」。"},{"ref":"John.20.14","start":43020014,"end":43020014,"break":"none","ruby":[[2,1,"い"],[12,1,"む"],[23,1,"た"],[32,1,"み"],[51,1,"き"]],"text":"そう言って、うしろをふり向くと、そこにイエスが立っておられるのを見た。しかし、それがイエスであることに気がつかなかった。"},{"ref":"John.20.15","start":43020015,"end":43020015,"break":"none","ruby":[[4,1,"おんな"],[6,1,"い"],[12,1,"おんな"],[17,1,"な"],[28,1,"さが"],[44,1,"ひと"],[46,1,"その"],[48,2,"ばんにん"],[52,1,"おも"],[55,1,"い"],[72,1,"うつ"],[84,1,"お"],[100,1,"くだ"],[113,1,"ひ"],[115,1,"と"]],"text":"イエスは女に言われた、「女よ、なぜ泣いているのか。だれを捜しているのか」。マリヤは、その人が園の番人だと思って言った、「もしあなたが、あのかたを移したのでしたら、どこへ置いたのか、どうぞ、おっしゃって下さい。わたしがそのかたを引き取ります」。"},{"ref":"John.20.16","start":43020016,"end":43020016,"break":"none","ruby":[[4,2,"かのじょ"],[14,1,"い"],[25,1,"かえ"],[40,1,"ご"],[48,1,"い"],[56,2,"せんせい"],[61,2,"いみ"]],"text":"イエスは彼女に「マリヤよ」と言われた。マリヤはふり返って、イエスにむかってヘブル語で「ラボニ」と言った。それは、先生という意味である。"},{"ref":"John.20.17","start":43020017,"end":43020017,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"い"],[34,1,"ちち"],[40,1,"のぼ"],[58,2,"きょうだい"],[63,1,"ところ"],[65,1,"い"],[79,1,"ちち"],[88,1,"ちち"],[98,1,"かみ"],[107,1,"かみ"],[120,1,"のぼ"],[123,1,"い"],[128,1,"かれ"],[131,1,"つた"]],"text":"イエスは彼女に言われた、「わたしにさわってはいけない。わたしは、まだ父のみもとに上っていないのだから。ただ、わたしの兄弟たちの所に行って、『わたしは、わたしの父またあなたがたの父であって、わたしの神またあなたがたの神であられるかたのみもとへ上って行く』と、彼らに伝えなさい」。"},{"ref":"John.20.18","start":43020018,"end":43020018,"break":"none","ruby":[[9,2,"でし"],[18,1,"い"],[22,2,"じぶん"],[25,1,"しゅ"],[27,1,"あ"],[47,2,"じぶん"],[50,1,"おお"],[60,2,"ほうこく"]],"text":"マグダラのマリヤは弟子たちのところに行って、自分が主に会ったこと、またイエスがこれこれのことを自分に仰せになったことを、報告した。"},{"ref":"John.20.19","start":43020019,"end":43020019,"break":"paragraph","ruby":[[2,1,"ひ"],[10,1,"しゅう"],[12,1,"はじ"],[15,1,"ひ"],[17,2,"ゆうがた"],[20,2,"でし"],[28,1,"じん"],[35,2,"じぶん"],[42,1,"ところ"],[44,1,"と"],[66,1,"かれ"],[69,1,"なか"],[71,1,"た"],[75,1,"やす"],[80,1,"い"]],"text":"その日、すなわち、一週の初めの日の夕方、弟子たちはユダヤ人をおそれて、自分たちのおる所の戸をみなしめていると、イエスがはいってきて、彼らの中に立ち、「安かれ」と言われた。"},{"ref":"John.20.20","start":43020020,"end":43020020,"break":"none","ruby":[[2,1,"い"],[6,1,"て"],[13,1,"かれ"],[17,1,"み"],[24,2,"でし"],[29,1,"しゅ"],[31,1,"み"],[33,1,"よろこ"]],"text":"そう言って、手とわきとを、彼らにお見せになった。弟子たちは主を見て喜んだ。"},{"ref":"John.20.21","start":43020021,"end":43020021,"break":"none","ruby":[[6,1,"かれ"],[9,1,"い"],[15,1,"やす"],[19,1,"ちち"]],"text":"イエスはまた彼らに言われた、「安かれ。父がわたしをおつかわしになったように、わたしもまたあなたがたをつかわす」。"},{"ref":"John.20.22","start":43020022,"end":43020022,"break":"none","ruby":[[2,1,"い"],[6,1,"かれ"],[9,1,"いき"],[11,1,"ふ"],[16,1,"おお"],[24,2,"せいれい"],[27,1,"う"]],"text":"そう言って、彼らに息を吹きかけて仰せになった、「聖霊を受けよ。"},{"ref":"John.20.23","start":43020023,"end":43020023,"break":"none","ruby":[[9,1,"つみ"],[15,1,"つみ"],[36,1,"つみ"],[43,1,"のこ"]],"text":"あなたがたがゆるす罪は、だれの罪でもゆるされ、あなたがたがゆるさずにおく罪は、そのまま残るであろう」。"},{"ref":"John.20.24","start":43020024,"end":43020024,"break":"paragraph","ruby":[[2,2,"でし"],[14,1,"よ"],[36,1,"かれ"],[39,2,"いっしょ"]],"text":"十二弟子のひとりで、デドモと呼ばれているトマスは、イエスがこられたとき、彼らと一緒にいなかった。"},{"ref":"John.20.25","start":43020025,"end":43020025,"break":"none","ruby":[[3,2,"でし"],[9,1,"かれ"],[18,1,"しゅ"],[21,1,"め"],[29,1,"い"],[37,1,"かれ"],[40,1,"い"],[52,1,"て"],[54,1,"くぎ"],[58,1,"み"],[64,1,"ゆび"],[68,1,"くぎ"],[74,1,"い"],[84,1,"て"],[93,1,"い"],[102,1,"けっ"],[105,1,"しん"]],"text":"ほかの弟子たちが、彼に「わたしたちは主にお目にかかった」と言うと、トマスは彼らに言った、「わたしは、その手に釘あとを見、わたしの指をその釘あとにさし入れ、また、わたしの手をそのわきにさし入れてみなければ、決して信じない」。"},{"ref":"John.20.26","start":43020026,"end":43020026,"break":"paragraph","ruby":[[1,1,"か"],[10,2,"でし"],[17,1,"いえ"],[19,1,"うち"],[28,2,"いっしょ"],[34,1,"と"],[38,1,"と"],[59,1,"なか"],[61,1,"た"],[65,1,"やす"],[70,1,"い"]],"text":"八日ののち、イエスの弟子たちはまた家の内におり、トマスも一緒にいた。戸はみな閉ざされていたが、イエスがはいってこられ、中に立って「安かれ」と言われた。"},{"ref":"John.20.27","start":43020027,"end":43020027,"break":"none","ruby":[[8,1,"い"],[18,1,"ゆび"],[31,1,"て"],[33,1,"み"],[38,1,"て"],[53,1,"い"],[61,1,"しん"],[65,1,"もの"],[73,1,"しん"],[76,1,"もの"]],"text":"それからトマスに言われた、「あなたの指をここにつけて、わたしの手を見なさい。手をのばしてわたしのわきにさし入れてみなさい。信じない者にならないで、信じる者になりなさい」。"},{"ref":"John.20.28","start":43020028,"end":43020028,"break":"none","ruby":[[8,1,"こた"],[11,1,"い"],[18,1,"しゅ"],[23,1,"かみ"]],"text":"トマスはイエスに答えて言った、「わが主よ、わが神よ」。"},{"ref":"John.20.29","start":43020029,"end":43020029,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[20,1,"み"],[24,1,"しん"],[30,1,"み"],[34,1,"しん"],[37,1,"もの"]],"text":"イエスは彼に言われた、「あなたはわたしを見たので信じたのか。見ないで信ずる者は、さいわいである」。"},{"ref":"John.20.30","start":43020030,"end":43020030,"break":"paragraph","ruby":[[7,1,"しょ"],[9,1,"か"],[25,1,"おお"],[28,2,"でし"],[33,1,"まえ"],[35,1,"おこな"]],"text":"イエスは、この書に書かれていないしるしを、ほかにも多く、弟子たちの前で行われた。"},{"ref":"John.20.31","start":43020031,"end":43020031,"break":"none","ruby":[[11,1,"か"],[27,1,"かみ"],[29,1,"こ"],[38,1,"しん"],[52,1,"しん"],[60,1,"な"],[65,1,"いのち"],[67,1,"え"]],"text":"しかし、これらのことを書いたのは、あなたがたがイエスは神の子キリストであると信じるためであり、また、そう信じて、イエスの名によって命を得るためである。"}]