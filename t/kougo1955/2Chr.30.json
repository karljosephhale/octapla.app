[{"ref":"2Chr.30.1","start":14030001,"end":14030001,"break":"paragraph","ruby":[[18,1,"ひと"],[27,2,"てがみ"],[40,1,"か"],[42,1,"おく"],[53,1,"しゅ"],[55,1,"みや"],[57,1,"き"],[66,1,"かみ"],[68,1,"しゅ"],[70,2,"すぎこし"],[73,1,"まつり"],[75,1,"おこな"],[80,1,"すす"]],"text":"ヒゼキヤはイスラエルとユダにあまねく人をつかわし、また手紙をエフライムとマナセに書き送り、エルサレムにある主の宮に来て、イスラエルの神、主に過越の祭を行うように勧めた。"},{"ref":"2Chr.30.2","start":14030002,"end":14030002,"break":"none","ruby":[[0,1,"おう"],[21,1,"ぜん"],[22,2,"かいしゅう"],[25,1,"はか"],[30,1,"がつ"],[32,2,"すぎこし"],[35,1,"まつり"],[37,1,"おこな"],[42,1,"さだ"]],"text":"王はすでにつかさたちおよびエルサレムにおる全会衆に計って、二月に過越の祭を行うことを定めた。"},{"ref":"2Chr.30.3","start":14030003,"end":14030003,"break":"none","ruby":[[5,1,"み"],[7,1,"きよ"],[10,2,"さいし"],[13,1,"かず"],[15,1,"た"],[19,1,"たみ"],[30,1,"あつ"],[40,2,"しょうがつ"],[46,1,"おこな"]],"text":"――これは身を清めた祭司の数が足らず、民もまた、エルサレムに集まらなかったので、正月にこれを行うことができなかったからである――"},{"ref":"2Chr.30.4","start":14030004,"end":14030004,"break":"none","ruby":[[2,1,"こと"],[5,1,"おう"],[8,1,"ぜん"],[9,2,"かいしゅう"],[13,1,"よ"]],"text":"この事が、王にも全会衆にも良かったので、"},{"ref":"2Chr.30.5","start":14030005,"end":14030005,"break":"none","ruby":[[2,1,"こと"],[4,1,"さだ"],[31,1,"しめ"],[40,1,"き"],[49,1,"かみ"],[51,1,"しゅ"],[53,2,"すぎこし"],[56,1,"まつり"],[58,1,"おこな"],[63,1,"すす"],[84,1,"おこな"],[86,1,"もの"],[88,1,"おお"]],"text":"この事を定めて、ベエルシバからダンまでイスラエルにあまねくふれ示し、エルサレムに来て、イスラエルの神、主に過越の祭を行うことを勧めた。これはしるされているように、これを行う者が多くなかったゆえである。"},{"ref":"2Chr.30.6","start":14030006,"end":14030006,"break":"none","ruby":[[3,2,"ひきゃく"],[9,1,"おう"],[20,1,"う"],[23,2,"てがみ"],[43,1,"い"],[45,1,"めぐ"],[48,1,"おう"],[50,1,"いのち"],[52,1,"つた"],[55,1,"い"],[66,2,"ひとびと"],[92,1,"かみ"],[94,1,"しゅ"],[96,1,"た"],[98,1,"かえ"],[109,1,"しゅ"],[118,1,"おう"],[122,1,"て"],[129,1,"のこ"],[139,1,"かえ"]],"text":"そこで飛脚たちは、王とそのつかさたちから受けた手紙をもって、イスラエルとユダをあまねく行き巡り、王の命を伝えて言った、「イスラエルの人々よ、あなたがたはアブラハム、イサク、イスラエルの神、主に立ち返りなさい。そうすれば主は、アッスリヤの王たちの手からのがれた残りのあなたがたに、帰られるでしょう。"},{"ref":"2Chr.30.7","start":14030007,"end":14030007,"break":"none","ruby":[[6,1,"ちち"],[12,2,"きょうだい"],[29,1,"かれ"],[34,2,"せんぞ"],[39,1,"かみ"],[41,1,"しゅ"],[47,1,"つみ"],[49,1,"おか"],[61,1,"み"],[66,1,"しゅ"],[68,1,"かれ"],[71,1,"ほろ"],[74,1,"わた"]],"text":"あなたがたの父たちおよび兄弟たちのようになってはならない。彼らはその先祖たちの神、主にむかって罪を犯したので、あなたがたの見るように主は彼らを滅びに渡されたのです。"},{"ref":"2Chr.30.8","start":14030008,"end":14030008,"break":"none","ruby":[[6,1,"ちち"],[13,2,"ごうじょう"],[22,1,"しゅ"],[24,2,"きふく"],[28,1,"しゅ"],[35,2,"せいべつ"],[40,2,"せいじょ"],[43,1,"い"],[52,1,"かみ"],[54,1,"しゅ"],[56,1,"つか"],[70,1,"はげ"],[73,1,"いか"],[82,1,"はな"]],"text":"あなたがたの父たちのように強情にならないで、主に帰服し、主がとこしえに聖別された聖所に入り、あなたがたの神、主に仕えなさい。そうすれば、その激しい怒りがあなたがたを離れるでしょう。"},{"ref":"2Chr.30.9","start":14030009,"end":14030009,"break":"none","ruby":[[8,1,"しゅ"],[10,1,"た"],[12,1,"かえ"],[24,2,"きょうだい"],[29,2,"こども"],[36,1,"とら"],[42,1,"もの"],[44,1,"まえ"],[51,1,"え"],[56,1,"くに"],[58,1,"かえ"],[77,1,"かみ"],[79,1,"しゅ"],[81,1,"めぐ"],[92,1,"かた"],[107,1,"かれ"],[109,1,"た"],[111,1,"かえ"],[117,1,"かお"]],"text":"もしあなたがたが主に立ち返るならば、あなたがたの兄弟および子供は、これを捕えていった者の前にあわれみを得て、この国に帰ることができるでしょう。あなたがたの神、主は恵みあり、あわれみある方であられるゆえ、あなたがたが彼に立ち返るならば、顔をあなたがたにそむけられることはありません」。"},{"ref":"2Chr.30.10","start":14030010,"end":14030010,"break":"paragraph","ruby":[[5,2,"ひきゃく"],[21,1,"くに"],[28,1,"まち"],[31,1,"まち"],[33,1,"い"],[35,1,"めぐ"],[48,1,"い"],[53,2,"ひとびと"],[63,1,"わら"]],"text":"このように飛脚たちは、エフライムとマナセの国にはいって、町から町に行き巡り、ついに、ゼブルンまで行ったが、人々はこれをあざけり笑った。"},{"ref":"2Chr.30.11","start":14030011,"end":14030011,"break":"none","ruby":[[20,1,"み"],[22,1,"ひく"],[35,2,"ひとびと"]],"text":"ただしアセル、マナセ、ゼブルンのうちには身を低くして、エルサレムにきた人々もあった。"},{"ref":"2Chr.30.12","start":14030012,"end":14030012,"break":"none","ruby":[[9,1,"かみ"],[11,1,"て"],[13,2,"ひとびと"],[18,1,"こころ"],[20,1,"あた"],[24,1,"おう"],[32,1,"しゅ"],[34,2,"ことば"],[40,1,"めい"],[46,1,"おこな"]],"text":"またユダにおいては神の手が人々に一つ心を与えて、王とつかさたちが主の言葉によって命じたことを行わせた。"},{"ref":"2Chr.30.13","start":14030013,"end":14030013,"break":"paragraph","ruby":[[5,1,"がつ"],[11,1,"おお"],[14,1,"たみ"],[17,1,"たね"],[18,1,"い"],[24,1,"まつり"],[26,1,"おこな"],[36,1,"あつ"],[42,2,"ひじょう"],[45,1,"おお"],[48,2,"かいしゅう"]],"text":"こうして二月になって、多くの民は、種入れぬパンの祭を行うためエルサレムに集まったが、非常に大きな会衆であった。"},{"ref":"2Chr.30.14","start":14030014,"end":14030014,"break":"none","ruby":[[0,1,"かれ"],[3,1,"た"],[19,2,"さいだん"],[22,1,"と"],[24,1,"のぞ"],[33,1,"こう"],[37,2,"さいだん"],[40,1,"と"],[42,1,"のぞ"],[49,1,"かわ"],[51,1,"な"]],"text":"彼らは立ってエルサレムにあるもろもろの祭壇を取り除き、またすべての香をたく祭壇を取り除いてキデロン川に投げすて、"},{"ref":"2Chr.30.15","start":14030015,"end":14030015,"break":"none","ruby":[[1,1,"がつ"],[5,1,"か"],[7,2,"すぎこし"],[10,2,"こひつじ"],[21,2,"さいし"],[37,1,"は"],[40,1,"み"],[42,1,"きよ"],[45,1,"しゅ"],[47,1,"みや"],[49,2,"はんさい"],[52,1,"たずさ"],[55,1,"き"]],"text":"二月の十四日に過越の小羊をほふった。そこで祭司たちおよびレビびとはみずから恥じ、身を清めて主の宮に燔祭を携えて来た。"},{"ref":"2Chr.30.16","start":14030016,"end":14030016,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,1,"ひと"],[10,2,"りっぽう"],[13,1,"したが"],[25,1,"ところ"],[27,1,"た"],[30,2,"さいし"],[41,1,"て"],[44,1,"ち"],[46,1,"う"],[49,1,"そそ"]],"text":"彼らは神の人モーセの律法に従い、いつものようにその所に立ち、祭司たちは、レビびとの手から血を受けて注いだ。"},{"ref":"2Chr.30.17","start":14030017,"end":14030017,"break":"none","ruby":[[0,1,"とき"],[3,2,"かいしゅう"],[11,1,"み"],[13,1,"きよ"],[19,1,"もの"],[21,1,"おお"],[35,1,"きよ"],[43,2,"ひとびと"],[46,1,"かわ"],[49,2,"すぎこし"],[52,2,"こひつじ"],[59,1,"しゅ"],[61,1,"きよ"]],"text":"時に、会衆のうちにまだ身を清めていない者が多かったので、レビびとはその清くないすべての人々に代って過越の小羊をほふり、主に清めてささげた。"},{"ref":"2Chr.30.18","start":14030018,"end":14030018,"break":"none","ruby":[[0,1,"おお"],[3,1,"たみ"],[32,1,"おお"],[35,1,"もの"],[39,1,"み"],[41,1,"きよ"],[50,1,"か"],[65,2,"すぎこし"],[68,1,"もの"],[70,1,"た"],[83,1,"かれ"],[89,1,"いの"],[92,1,"い"],[97,1,"めぐ"],[102,1,"しゅ"],[105,1,"かれ"]],"text":"多くの民すなわちエフライム、マナセ、イッサカル、ゼブルンからきた多くの者はまだ身を清めていないのに、書きしるされたとおりにしないで過越の物を食べた。それでヒゼキヤは、彼らのために祈って言った、「恵みふかき主よ、彼らをゆるしてください。"},{"ref":"2Chr.30.19","start":14030019,"end":14030019,"break":"none","ruby":[[0,1,"かれ"],[3,2,"せいじょ"],[6,1,"きよ"],[9,2,"きてい"],[27,1,"こころ"],[29,1,"かたむ"],[32,1,"かみ"],[34,1,"もと"],[39,2,"せんぞ"],[42,1,"かみ"],[44,1,"しゅ"],[46,1,"もと"]],"text":"彼らは聖所の清めの規定どおりにしなかったけれども、その心を傾けて神を求め、その先祖の神、主を求めたのです」。"},{"ref":"2Chr.30.20","start":14030020,"end":14030020,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"き"],[11,1,"たみ"]],"text":"主はヒゼキヤに聞いて、民をいやされた。"},{"ref":"2Chr.30.21","start":14030021,"end":14030021,"break":"none","ruby":[[9,1,"き"],[19,2,"ひとびと"],[22,1,"おお"],[26,1,"よろこ"],[34,2,"なぬか"],[40,1,"たね"],[41,1,"い"],[47,1,"まつり"],[49,1,"おこな"],[60,2,"さいし"],[65,2,"ひび"],[68,1,"しゅ"],[75,1,"ちから"],[81,1,"しゅ"]],"text":"そこでエルサレムに来ていたイスラエルの人々は大いなる喜びをいだいて、七日のあいだ種入れぬパンの祭を行った。またレビびとと祭司たちは日々に主をさんびし、力をつくして主をたたえた。"},{"ref":"2Chr.30.22","start":14030022,"end":14030022,"break":"none","ruby":[[8,1,"しゅ"],[10,1,"つと"],[15,1,"つう"],[29,1,"ふか"],[41,2,"ひとびと"],[44,3,"しゅうおんさい"],[48,2,"ぎせい"],[57,2,"せんぞ"],[60,1,"かみ"],[62,1,"しゅ"],[64,2,"かんしゃ"],[69,2,"なぬか"],[75,1,"まつり"],[77,1,"そな"],[79,1,"もの"],[81,1,"た"]],"text":"そしてヒゼキヤは主の勤めによく通じているすべてのレビびとを深くねぎらった。こうして人々は酬恩祭の犠牲をささげ、その先祖の神、主に感謝して、七日のあいだ祭の供え物を食べた。"},{"ref":"2Chr.30.23","start":14030023,"end":14030023,"break":"paragraph","ruby":[[2,1,"ぜん"],[3,2,"かいしゅう"],[6,1,"あい"],[15,2,"なぬか"],[21,1,"まつり"],[23,1,"まも"],[28,1,"さだ"],[31,1,"よろこ"],[39,2,"なぬか"],[45,1,"まも"]],"text":"なお全会衆は相はかって、さらに七日のあいだ祭を守ることを定め、喜びをもってまた七日のあいだ守った。"},{"ref":"2Chr.30.24","start":14030024,"end":14030024,"break":"none","ruby":[[0,1,"とき"],[5,1,"おう"],[11,2,"おうし"],[15,1,"とう"],[17,1,"ひつじ"],[20,1,"とう"],[22,2,"かいしゅう"],[25,1,"おく"],[37,2,"おうし"],[41,1,"とう"],[43,1,"ひつじ"],[44,1,"いち"],[45,1,"まん"],[46,1,"とう"],[48,2,"かいしゅう"],[51,1,"おく"],[55,2,"さいし"],[60,1,"おお"],[62,1,"み"],[64,1,"きよ"]],"text":"時にユダの王ヒゼキヤは雄牛一千頭、羊七千頭を会衆に贈り、また、つかさたちは雄牛一千頭、羊一万頭を会衆に贈った。祭司もまた多く身を清めた。"},{"ref":"2Chr.30.25","start":14030025,"end":14030025,"break":"none","ruby":[[3,1,"ぜん"],[4,2,"かいしゅう"],[9,2,"さいし"],[30,1,"ぜん"],[31,2,"かいしゅう"],[43,1,"ち"],[48,2,"たこく"],[50,1,"じん"],[56,1,"す"],[58,2,"たこく"],[60,1,"じん"],[62,1,"みな"],[63,1,"よろこ"]],"text":"ユダの全会衆および祭司、レビびと、ならびにイスラエルからきた全会衆、およびイスラエルの地からきた他国人と、ユダに住む他国人は皆喜んだ。"},{"ref":"2Chr.30.26","start":14030026,"end":14030026,"break":"none","ruby":[[11,1,"おお"],[15,1,"よろこ"],[28,1,"おう"],[33,1,"こ"],[39,1,"とき"],[52,1,"こと"]],"text":"このようにエルサレムに大いなる喜びがあった。イスラエルの王ダビデの子ソロモンの時からこのかた、このような事はエルサレムになかった。"},{"ref":"2Chr.30.27","start":14030027,"end":14030027,"break":"none","ruby":[[4,2,"さいし"],[14,1,"た"],[18,1,"たみ"],[20,2,"しゅくふく"],[28,1,"こえ"],[30,1,"き"],[36,1,"いのり"],[38,1,"しゅ"],[40,1,"せい"],[49,1,"てん"],[51,1,"たっ"]],"text":"このとき祭司たちとレビびとは立って、民を祝福したが、その声は聞かれ、その祈は主の聖なるすみかである天に達した。"}]