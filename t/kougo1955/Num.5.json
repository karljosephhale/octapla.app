[{"ref":"Num.5.1","start":4005001,"end":4005001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.5.2","start":4005002,"end":4005002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"めい"],[16,2,"びょうにん"],[19,2,"りゅうしゅつ"],[24,1,"もの"],[26,2,"したい"],[32,1,"けが"],[35,1,"もの"],[43,2,"しゅくえい"],[46,1,"そと"],[48,1,"だ"]],"text":"「イスラエルの人々に命じて、らい病人、流出のある者、死体にふれて汚れた者を、ことごとく宿営の外に出させなさい。"},{"ref":"Num.5.3","start":4005003,"end":4005003,"break":"none","ruby":[[0,1,"おとこ"],[3,1,"おんな"],[13,1,"かれ"],[16,2,"しゅくえい"],[19,1,"そと"],[21,1,"だ"],[31,1,"かれ"],[34,2,"しゅくえい"],[37,1,"けが"],[53,1,"なか"],[55,1,"す"]],"text":"男でも女でも、あなたがたは彼らを宿営の外に出してそこにおらせ、彼らに宿営を汚させてはならない。わたしがその中に住んでいるからである」。"},{"ref":"Num.5.4","start":4005004,"end":4005004,"break":"none","ruby":[[6,2,"ひとびと"],[17,1,"かれ"],[20,2,"しゅくえい"],[23,1,"そと"],[25,1,"だ"],[34,1,"しゅ"],[40,1,"い"],[53,2,"ひとびと"],[56,1,"い"]],"text":"イスラエルの人々はそのようにして、彼らを宿営の外に出した。すなわち、主がモーセに言われたようにイスラエルの人々は行った。"},{"ref":"Num.5.5","start":4005005,"end":4005005,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.5.6","start":4005006,"end":4005006,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"つ"],[17,1,"おとこ"],[21,1,"おんな"],[26,1,"ひと"],[28,1,"おか"],[30,1,"つみ"],[37,1,"しゅ"],[39,1,"つみ"],[41,1,"え"],[45,1,"ひと"],[51,1,"もの"],[55,1,"とき"]],"text":"「イスラエルの人々に告げなさい、『男または女が、もし人の犯す罪をおかして、主に罪を得、その人がとがある者となる時は、"},{"ref":"Num.5.7","start":4005007,"end":4005007,"break":"none","ruby":[[2,1,"おか"],[5,1,"つみ"],[7,2,"こくはく"],[13,1,"もの"],[15,1,"あたい"],[20,1,"ぶん"],[24,1,"くわ"],[28,1,"かれ"],[33,1,"おか"],[36,3,"あいてがた"],[40,1,"わた"],[53,1,"つぐな"]],"text":"その犯した罪を告白し、その物の価にその五分の一を加えて、彼がとがを犯した相手方に渡し、そのとがをことごとく償わなければならない。"},{"ref":"Num.5.8","start":4005008,"end":4005008,"break":"none","ruby":[[12,1,"つぐな"],[15,1,"う"],[17,1,"と"],[21,2,"しんぞく"],[27,1,"ひと"],[31,1,"とき"],[34,1,"しゅ"],[41,1,"つぐな"],[50,2,"さいし"],[53,1,"き"],[86,1,"もち"],[89,2,"しょくざい"],[92,2,"おひつじ"],[96,2,"さいし"],[99,1,"き"]],"text":"しかし、もし、そのとがの償いを受け取るべき親族も、その人にない時は、主にそのとがの償いをして、これを祭司に帰せしめなければならない。なお、このほか、そのあがないをするために用いた贖罪の雄羊も、祭司に帰せしめなければならない。"},{"ref":"Num.5.9","start":4005009,"end":4005009,"break":"none","ruby":[[6,2,"ひとびと"],[10,2,"さいし"],[16,1,"たずさ"],[19,1,"く"],[25,1,"せい"],[31,1,"もの"],[36,2,"さいし"],[39,1,"き"]],"text":"イスラエルの人々が、祭司のもとに携えて来るすべての聖なるささげ物は、みな祭司に帰せしめなければならない。"},{"ref":"Num.5.10","start":4005010,"end":4005010,"break":"none","ruby":[[3,1,"ひと"],[5,1,"せい"],[11,1,"もの"],[13,2,"さいし"],[16,1,"き"],[22,1,"ひと"],[24,2,"さいし"],[27,1,"あた"],[30,1,"もの"],[32,2,"さいし"],[35,1,"き"]],"text":"すべて人の聖なるささげ物は祭司に帰し、すべて人が祭司に与える物は祭司に帰するであろう』」。"},{"ref":"Num.5.11","start":4005011,"end":4005011,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.5.12","start":4005012,"end":4005012,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"つ"],[19,1,"ひと"],[21,1,"つま"],[24,1,"もの"],[27,1,"みち"],[31,1,"こと"],[38,1,"おっと"],[40,1,"つみ"],[42,1,"おか"]],"text":"「イスラエルの人々に告げなさい、『もし人の妻たる者が、道ならぬ事をして、その夫に罪を犯し、"},{"ref":"Num.5.13","start":4005013,"end":4005013,"break":"none","ruby":[[0,1,"ひと"],[2,2,"かのじょ"],[5,1,"ね"],[12,1,"こと"],[14,1,"おっと"],[16,1,"め"],[18,1,"かく"],[21,1,"あらわ"],[25,2,"かのじょ"],[30,1,"み"],[32,1,"けが"],[43,1,"たい"],[46,2,"しょうにん"],[52,2,"かのじょ"],[59,1,"とき"],[61,1,"とら"],[69,2,"ばあい"]],"text":"人が彼女と寝たのに、その事が夫の目に隠れて現れず、彼女はその身を汚したけれども、それに対する証人もなく、彼女もまたその時に捕えられなかった場合、"},{"ref":"Num.5.14","start":4005014,"end":4005014,"break":"none","ruby":[[5,1,"つま"],[7,1,"み"],[9,1,"けが"],[16,1,"おっと"],[18,1,"うたが"],[21,1,"こころ"],[23,1,"おこ"],[26,1,"つま"],[28,1,"うたが"],[39,1,"つま"],[41,1,"み"],[43,1,"けが"],[46,1,"こと"],[53,1,"おっと"],[55,1,"うたが"],[58,1,"こころ"],[60,1,"おこ"],[63,1,"つま"],[65,1,"うたが"]],"text":"すなわち、妻が身を汚したために、夫が疑いの心を起して妻を疑うことがあり、または妻が身を汚した事がないのに、夫が疑いの心を起して妻を疑うことがあれば、"},{"ref":"Num.5.15","start":4005015,"end":4005015,"break":"none","ruby":[[0,1,"おっと"],[2,1,"つま"],[4,2,"さいし"],[10,1,"ともな"],[13,2,"かのじょ"],[19,2,"おおむぎ"],[22,1,"こな"],[28,1,"ぶん"],[32,1,"そな"],[34,1,"もの"],[38,1,"たずさ"],[57,1,"うえ"],[59,1,"あぶら"],[61,1,"そそ"],[72,2,"にゅうこう"],[75,1,"くわ"],[87,1,"うたが"],[90,1,"そな"],[92,1,"もの"],[94,1,"おぼ"],[97,1,"そな"],[99,1,"もの"],[104,1,"つみ"],[106,1,"おぼ"]],"text":"夫は妻を祭司のもとに伴い、彼女のために大麦の粉一エパの十分の一を供え物として携えてこなければならない。ただし、その上に油を注いではならない。また乳香を加えてはならない。これは疑いの供え物、覚えの供え物であって罪を覚えさせるものだからである。"},{"ref":"Num.5.16","start":4005016,"end":4005016,"break":"paragraph","ruby":[[0,2,"さいし"],[5,1,"おんな"],[7,1,"ちか"],[9,1,"すす"],[13,1,"しゅ"],[15,1,"まえ"],[17,1,"た"]],"text":"祭司はその女を近く進ませ、主の前に立たせなければならない。"},{"ref":"Num.5.17","start":4005017,"end":4005017,"break":"none","ruby":[[0,2,"さいし"],[5,1,"つち"],[7,1,"うつわ"],[9,1,"せい"],[12,1,"みず"],[14,1,"い"],[17,2,"まくや"],[26,1,"と"],[31,1,"みず"],[33,1,"い"]],"text":"祭司はまた土の器に聖なる水を入れ、幕屋のゆかのちりを取ってその水に入れ、"},{"ref":"Num.5.18","start":4005018,"end":4005018,"break":"none","ruby":[[2,1,"おんな"],[4,1,"しゅ"],[6,1,"まえ"],[8,1,"た"],[12,1,"おんな"],[16,1,"かみ"],[18,1,"け"],[25,1,"おぼ"],[28,1,"そな"],[30,1,"もの"],[36,1,"うたが"],[39,1,"そな"],[41,1,"もの"],[46,1,"て"],[48,1,"も"],[63,2,"さいし"],[71,1,"にが"],[73,1,"みず"],[75,1,"て"],[77,1,"と"]],"text":"その女を主の前に立たせ、女にその髪の毛をほどかせ、覚えの供え物すなわち、疑いの供え物を、その手に持たせなければならない。そして祭司は、のろいの苦い水を手に取り、"},{"ref":"Num.5.19","start":4005019,"end":4005019,"break":"none","ruby":[[0,1,"おんな"],[2,1,"ちか"],[10,1,"い"],[24,1,"ひと"],[30,1,"ね"],[45,1,"おっと"],[54,1,"みち"],[58,1,"こと"],[62,1,"けが"],[77,1,"にが"],[79,1,"みず"],[86,1,"がい"],[88,1,"あた"]],"text":"女に誓わせて、これに言わなければならない、「もし人があなたと寝たことがなく、またあなたが、夫のもとにあって、道ならぬ事をして汚れたことがなければ、のろいの苦い水も、あなたに害を与えないであろう。"},{"ref":"Num.5.20","start":4005020,"end":4005020,"break":"none","ruby":[[11,1,"おっと"],[20,1,"みち"],[29,1,"み"],[31,1,"けが"],[38,1,"おっと"],[42,1,"ひと"],[49,1,"ね"]],"text":"しかし、あなたが、もし夫のもとにあって、道ならぬことをして身を汚し、あなたの夫でない人が、あなたと寝たことがあるならば、――"},{"ref":"Num.5.21","start":4005021,"end":4005021,"break":"none","ruby":[[0,2,"さいし"],[5,1,"おんな"],[12,1,"ちか"],[18,1,"ちか"],[24,1,"おんな"],[26,1,"い"],[39,1,"しゅ"],[57,1,"はら"],[70,1,"たみ"]],"text":"祭司はその女に、のろいの誓いをもって誓わせ、その女に言わなければならない。――主はあなたのももをやせさせ、あなたの腹をふくれさせて、あなたを民のうちの、のろいとし、また、ののしりとされるように。"},{"ref":"Num.5.22","start":4005022,"end":4005022,"break":"none","ruby":[[7,1,"みず"],[14,1,"はら"],[24,1,"はら"],[51,1,"とき"],[53,1,"おんな"],[67,1,"い"]],"text":"また、のろいの水が、あなたの腹にはいってあなたの腹をふくれさせ、あなたのももをやせさせるように」。その時、女は「アァメン、アァメン」と言わなければならない。"},{"ref":"Num.5.23","start":4005023,"end":4005023,"break":"paragraph","ruby":[[0,2,"さいし"],[10,1,"か"],[12,1,"もの"],[14,1,"か"],[23,1,"にが"],[25,1,"みず"],[27,1,"あら"],[29,1,"おと"]],"text":"祭司は、こののろいを書き物に書きしるし、それを苦い水に洗い落し、"},{"ref":"Num.5.24","start":4005024,"end":4005024,"break":"none","ruby":[[0,1,"おんな"],[8,1,"みず"],[10,1,"の"],[28,1,"みず"],[30,2,"かのじょ"],[40,1,"にが"]],"text":"女にそののろいの水を飲ませなければならない。そののろいの水は彼女のうちにはいって苦くなるであろう。"},{"ref":"Num.5.25","start":4005025,"end":4005025,"break":"none","ruby":[[3,2,"さいし"],[8,1,"おんな"],[10,1,"て"],[13,1,"うたが"],[16,1,"そな"],[18,1,"もの"],[20,1,"と"],[25,1,"そな"],[27,1,"もの"],[29,1,"しゅ"],[31,1,"まえ"],[33,1,"ゆ"],[35,1,"うご"],[43,2,"さいだん"],[46,1,"も"]],"text":"そして祭司はその女の手から疑いの供え物を取り、その供え物を主の前に揺り動かして、それを祭壇に持ってこなければならない。"},{"ref":"Num.5.26","start":4005026,"end":4005026,"break":"none","ruby":[[0,2,"さいし"],[5,1,"そな"],[7,1,"もの"],[14,1,"おぼ"],[17,1,"ぶん"],[19,2,"ひとにぎ"],[23,1,"と"],[30,2,"さいだん"],[33,1,"や"],[38,1,"のち"],[40,1,"おんな"],[44,1,"みず"],[46,1,"の"]],"text":"祭司はその供え物のうちから、覚えの分、一握りを取って、それを祭壇で焼き、その後、女にその水を飲ませなければならない。"},{"ref":"Num.5.27","start":4005027,"end":4005027,"break":"none","ruby":[[2,1,"みず"],[4,1,"おんな"],[6,1,"の"],[10,1,"とき"],[16,1,"おんな"],[18,1,"み"],[20,1,"けが"],[23,1,"おっと"],[25,1,"つみ"],[27,1,"おか"],[30,1,"こと"],[42,1,"みず"],[44,1,"おんな"],[53,1,"にが"],[60,1,"はら"],[75,1,"おんな"],[77,1,"たみ"]],"text":"その水を女に飲ませる時、もしその女が身を汚し、夫に罪を犯した事があれば、そののろいの水は女のうちにはいって苦くなり、その腹はふくれ、ももはやせて、その女は民のうちののろいとなるであろう。"},{"ref":"Num.5.28","start":4005028,"end":4005028,"break":"none","ruby":[[6,1,"おんな"],[8,1,"み"],[10,1,"けが"],[13,1,"こと"],[18,1,"きよ"],[24,1,"がい"],[26,1,"う"],[32,1,"こ"],[34,1,"う"]],"text":"しかし、もし女が身を汚した事がなく、清いならば、害を受けないで、子を産むことができるであろう。"},{"ref":"Num.5.29","start":4005029,"end":4005029,"break":"paragraph","ruby":[[3,1,"うたが"],[8,1,"とき"],[17,1,"つま"],[20,1,"もの"],[22,1,"おっと"],[31,1,"みち"],[35,1,"こと"],[39,1,"み"],[41,1,"けが"],[44,1,"とき"]],"text":"これは疑いのある時のおきてである。妻たる者が夫のもとにあって、道ならぬ事をして身を汚した時、"},{"ref":"Num.5.30","start":4005030,"end":4005030,"break":"none","ruby":[[3,1,"おっと"],[6,1,"もの"],[8,1,"うたが"],[11,1,"こころ"],[13,1,"おこ"],[17,1,"つま"],[19,1,"うたが"],[21,1,"とき"],[23,1,"かれ"],[27,1,"おんな"],[29,1,"しゅ"],[31,1,"まえ"],[33,1,"た"],[37,2,"さいし"],[52,2,"かのじょ"],[55,1,"おこな"]],"text":"または夫たる者が疑いの心を起して、妻を疑う時、彼はその女を主の前に立たせ、祭司はこのおきてを、ことごとく彼女に行わなければならない。"},{"ref":"Num.5.31","start":4005031,"end":4005031,"break":"none","ruby":[[8,1,"おっと"],[10,1,"つみ"],[15,1,"つま"],[17,1,"つみ"],[19,1,"お"]],"text":"こうするならば、夫は罪がなく、妻は罪を負うであろう』」。"}]