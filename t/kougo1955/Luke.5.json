[{"ref":"Luke.5.1","start":42005001,"end":42005001,"break":"paragraph","ruby":[[3,2,"ぐんしゅう"],[6,1,"かみ"],[8,1,"ことば"],[10,1,"き"],[16,1,"お"],[18,1,"よ"],[34,2,"こはん"],[37,1,"た"]],"text":"さて、群衆が神の言を聞こうとして押し寄せてきたとき、イエスはゲネサレ湖畔に立っておられたが、"},{"ref":"Luke.5.2","start":42005002,"end":42005002,"break":"none","ruby":[[7,2,"こぶね"],[10,1,"よ"],[25,2,"りょうし"],[31,1,"ふね"],[37,1,"あみ"],[39,1,"あら"]],"text":"そこに二そうの小舟が寄せてあるのをごらんになった。漁師たちは、舟からおりて網を洗っていた。"},{"ref":"Luke.5.3","start":42005003,"end":42005003,"break":"none","ruby":[[10,1,"ふね"],[24,1,"の"],[26,1,"こ"],[33,1,"たの"],[36,1,"きし"],[39,1,"すこ"],[43,1,"だ"],[55,1,"ふね"],[57,1,"なか"],[60,2,"ぐんしゅう"],[64,1,"おし"]],"text":"その一そうはシモンの舟であったが、イエスはそれに乗り込み、シモンに頼んで岸から少しこぎ出させ、そしてすわって、舟の中から群衆にお教えになった。"},{"ref":"Luke.5.4","start":42005004,"end":42005004,"break":"none","ruby":[[0,1,"はなし"],[11,1,"おき"],[15,1,"だ"],[18,1,"あみ"],[24,1,"りょう"],[34,1,"い"]],"text":"話がすむと、シモンに「沖へこぎ出し、網をおろして漁をしてみなさい」と言われた。"},{"ref":"Luke.5.5","start":42005005,"end":42005005,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[12,2,"せんせい"],[21,2,"よどお"],[24,1,"はたら"],[31,1,"なに"],[33,1,"と"],[47,2,"ことば"],[54,1,"あみ"]],"text":"シモンは答えて言った、「先生、わたしたちは夜通し働きましたが、何も取れませんでした。しかし、お言葉ですから、網をおろしてみましょう」。"},{"ref":"Luke.5.6","start":42005006,"end":42005006,"break":"none","ruby":[[21,1,"うお"],[23,1,"む"],[31,1,"あみ"],[33,1,"やぶ"]],"text":"そしてそのとおりにしたところ、おびただしい魚の群れがはいって、網が破れそうになった。"},{"ref":"Luke.5.7","start":42005007,"end":42005007,"break":"none","ruby":[[10,1,"ふね"],[14,2,"なかま"],[18,2,"かせい"],[21,1,"く"],[25,2,"あいず"],[33,1,"かれ"],[38,1,"うお"],[40,2,"りょうほう"],[43,1,"ふね"],[49,1,"い"],[59,1,"ふね"],[61,1,"しず"]],"text":"そこで、もう一そうの舟にいた仲間に、加勢に来るよう合図をしたので、彼らがきて魚を両方の舟いっぱいに入れた。そのために、舟が沈みそうになった。"},{"ref":"Luke.5.8","start":42005008,"end":42005008,"break":"none","ruby":[[3,1,"み"],[25,1,"ふ"],[28,1,"い"],[33,1,"しゅ"],[41,1,"はな"],[53,2,"つみふか"],[56,1,"もの"]],"text":"これを見てシモン・ペテロは、イエスのひざもとにひれ伏して言った、「主よ、わたしから離れてください。わたしは罪深い者です」。"},{"ref":"Luke.5.9","start":42005009,"end":42005009,"break":"none","ruby":[[0,1,"かれ"],[2,2,"いっしょ"],[7,1,"もの"],[14,1,"と"],[17,1,"うお"],[27,1,"おどろ"]],"text":"彼も一緒にいた者たちもみな、取れた魚がおびただしいのに驚いたからである。"},{"ref":"Luke.5.10","start":42005010,"end":42005010,"break":"none","ruby":[[4,2,"なかま"],[15,1,"こ"],[25,2,"どうよう"],[44,1,"い"],[50,1,"おそ"],[59,1,"いま"],[66,2,"にんげん"],[71,2,"りょうし"]],"text":"シモンの仲間であったゼベダイの子ヤコブとヨハネも、同様であった。すると、イエスがシモンに言われた、「恐れることはない。今からあなたは人間をとる漁師になるのだ」。"},{"ref":"Luke.5.11","start":42005011,"end":42005011,"break":"none","ruby":[[3,1,"かれ"],[6,1,"ふね"],[8,1,"りく"],[10,1,"ひ"],[12,1,"あ"],[20,1,"す"],[27,1,"したが"]],"text":"そこで彼らは舟を陸に引き上げ、いっさいを捨ててイエスに従った。"},{"ref":"Luke.5.12","start":42005012,"end":42005012,"break":"paragraph","ruby":[[6,1,"まち"],[12,1,"とき"],[14,2,"ぜんしん"],[18,1,"びょう"],[25,1,"ひと"],[37,1,"み"],[41,1,"かお"],[43,1,"ち"],[45,1,"ふ"],[48,1,"ねが"],[51,1,"い"],[56,1,"しゅ"]],"text":"イエスがある町におられた時、全身らい病になっている人がそこにいた。イエスを見ると、顔を地に伏せて願って言った、「主よ、みこころでしたら、きよめていただけるのですが」。"},{"ref":"Luke.5.13","start":42005013,"end":42005013,"break":"none","ruby":[[4,1,"て"],[6,1,"の"],[10,1,"かれ"],[33,1,"い"],[44,1,"びょう"],[50,1,"さ"]],"text":"イエスは手を伸ばして彼にさわり、「そうしてあげよう、きよくなれ」と言われた。すると、らい病がただちに去ってしまった。"},{"ref":"Luke.5.14","start":42005014,"end":42005014,"break":"none","ruby":[[9,1,"はな"],[17,1,"かれ"],[19,1,"い"],[21,1,"き"],[28,1,"い"],[31,2,"じぶん"],[38,2,"さいし"],[41,1,"み"],[63,1,"めい"],[73,1,"もの"],[78,2,"ひとびと"],[81,2,"しょうめい"],[90,1,"めい"]],"text":"イエスは、だれにも話さないようにと彼に言い聞かせ、「ただ行って自分のからだを祭司に見せ、それからあなたのきよめのため、モーセが命じたとおりのささげ物をして、人々に証明しなさい」とお命じになった。"},{"ref":"Luke.5.15","start":42005015,"end":42005015,"break":"none","ruby":[[8,2,"ひょうばん"],[20,1,"い"],[29,2,"ぐんしゅう"],[33,1,"おしえ"],[35,1,"き"],[40,2,"びょうき"],[58,1,"あつ"]],"text":"しかし、イエスの評判はますますひろまって行き、おびただしい群衆が、教を聞いたり、病気をなおしてもらったりするために、集まってきた。"},{"ref":"Luke.5.16","start":42005016,"end":42005016,"break":"none","ruby":[[8,1,"さび"],[11,1,"ところ"],[13,1,"しりぞ"],[16,1,"いの"]],"text":"しかしイエスは、寂しい所に退いて祈っておられた。"},{"ref":"Luke.5.17","start":42005017,"end":42005017,"break":"paragraph","ruby":[[2,1,"ひ"],[11,1,"おし"],[29,2,"ほうぼう"],[32,1,"むら"],[51,1,"びと"],[53,2,"りっぽう"],[55,2,"がくしゃ"],[71,1,"しゅ"],[73,1,"ちから"],[75,1,"はたら"],[83,2,"ひとびと"]],"text":"ある日のこと、イエスが教えておられると、ガリラヤやユダヤの方々の村から、またエルサレムからきたパリサイ人や律法学者たちが、そこにすわっていた。主の力が働いて、イエスは人々をいやされた。"},{"ref":"Luke.5.18","start":42005018,"end":42005018,"break":"none","ruby":[[2,1,"とき"],[6,2,"ひとびと"],[14,2,"ちゅうぶ"],[24,1,"ひと"],[26,1,"とこ"],[33,1,"つ"],[39,1,"いえ"],[41,1,"なか"],[43,1,"はこ"],[45,1,"い"],[52,1,"まえ"],[54,1,"お"]],"text":"その時、ある人々が、ひとりの中風をわずらっている人を床にのせたまま連れてきて、家の中に運び入れ、イエスの前に置こうとした。"},{"ref":"Luke.5.19","start":42005019,"end":42005019,"break":"none","ruby":[[5,2,"ぐんしゅう"],[16,1,"はこ"],[18,1,"い"],[21,2,"ほうほう"],[31,2,"やね"],[38,1,"かわら"],[44,2,"びょうにん"],[47,1,"とこ"],[50,2,"ぐんしゅう"],[55,1,"なか"],[68,1,"まえ"]],"text":"ところが、群衆のためにどうしても運び入れる方法がなかったので、屋根にのぼり、瓦をはいで、病人を床ごと群衆のまん中につりおろして、イエスの前においた。"},{"ref":"Luke.5.20","start":42005020,"end":42005020,"break":"none","ruby":[[4,1,"かれ"],[7,2,"しんこう"],[10,1,"み"],[14,1,"ひと"],[21,1,"つみ"],[30,1,"い"]],"text":"イエスは彼らの信仰を見て、「人よ、あなたの罪はゆるされた」と言われた。"},{"ref":"Luke.5.21","start":42005021,"end":42005021,"break":"none","ruby":[[3,2,"りっぽう"],[5,2,"がくしゃ"],[12,1,"びと"],[19,1,"かみ"],[21,1,"けが"],[26,1,"い"],[30,1,"ひと"],[38,2,"なにもの"],[42,1,"かみ"],[55,1,"つみ"],[69,1,"い"],[72,1,"ろん"]],"text":"すると律法学者とパリサイ人たちとは、「神を汚すことを言うこの人は、いったい、何者だ。神おひとりのほかに、だれが罪をゆるすことができるか」と言って論じはじめた。"},{"ref":"Luke.5.22","start":42005022,"end":42005022,"break":"none","ruby":[[4,1,"かれ"],[7,2,"ろんぎ"],[10,1,"み"],[22,1,"こころ"],[24,1,"なか"],[26,1,"なに"],[28,1,"ろん"]],"text":"イエスは彼らの論議を見ぬいて、「あなたがたは心の中で何を論じているのか。"},{"ref":"Luke.5.23","start":42005023,"end":42005023,"break":"none","ruby":[[4,1,"つみ"],[12,1,"い"],[17,1,"お"],[20,1,"ある"],[23,1,"い"]],"text":"あなたの罪はゆるされたと言うのと、起きて歩けと言うのと、どちらがたやすいか。"},{"ref":"Luke.5.24","start":42005024,"end":42005024,"break":"none","ruby":[[4,1,"ひと"],[6,1,"こ"],[8,2,"ちじょう"],[11,1,"つみ"],[16,2,"けんい"],[19,1,"も"],[42,1,"かれ"],[45,1,"たい"],[48,1,"い"],[51,2,"ちゅうぶ"],[54,1,"もの"],[66,1,"めい"],[70,1,"お"],[74,1,"とこ"],[76,1,"と"],[78,1,"あ"],[81,1,"いえ"],[83,1,"かえ"],[87,1,"い"]],"text":"しかし、人の子は地上で罪をゆるす権威を持っていることが、あなたがたにわかるために」と彼らに対して言い、中風の者にむかって、「あなたに命じる。起きよ、床を取り上げて家に帰れ」と言われた。"},{"ref":"Luke.5.25","start":42005025,"end":42005025,"break":"none","ruby":[[3,2,"びょうにん"],[6,2,"そくざ"],[13,1,"まえ"],[15,1,"お"],[21,1,"ね"],[25,1,"とこ"],[27,1,"と"],[33,1,"かみ"],[41,1,"いえ"],[43,1,"かえ"],[46,1,"い"]],"text":"すると病人は即座にみんなの前で起きあがり、寝ていた床を取りあげて、神をあがめながら家に帰って行った。"},{"ref":"Luke.5.26","start":42005026,"end":42005026,"break":"none","ruby":[[4,1,"もの"],[6,2,"きょうたん"],[18,1,"かみ"],[28,1,"み"],[39,1,"おどろ"],[46,1,"み"],[50,1,"い"]],"text":"みんなの者は驚嘆してしまった。そして神をあがめ、おそれに満たされて、「きょうは驚くべきことを見た」と言った。"},{"ref":"Luke.5.27","start":42005027,"end":42005027,"break":"paragraph","ruby":[[9,1,"で"],[11,1,"い"],[22,1,"な"],[24,3,"しゅぜいにん"],[28,3,"しゅうぜいしょ"],[40,1,"み"],[48,1,"したが"],[57,1,"い"]],"text":"そののち、イエスが出て行かれると、レビという名の取税人が収税所にすわっているのを見て、「わたしに従ってきなさい」と言われた。"},{"ref":"Luke.5.28","start":42005028,"end":42005028,"break":"none","ruby":[[4,1,"かれ"],[11,1,"す"],[14,1,"た"],[24,1,"したが"]],"text":"すると、彼はいっさいを捨てて立ちあがり、イエスに従ってきた。"},{"ref":"Luke.5.29","start":42005029,"end":42005029,"break":"none","ruby":[[8,2,"じぶん"],[11,1,"いえ"],[21,2,"せいだい"],[24,2,"えんかい"],[27,1,"もよお"],[32,3,"しゅぜいにん"],[40,1,"おお"],[44,2,"ひとびと"],[48,1,"とも"],[50,2,"しょくたく"],[53,1,"つ"]],"text":"それから、レビは自分の家で、イエスのために盛大な宴会を催したが、取税人やそのほか大ぜいの人々が、共に食卓に着いていた。"},{"ref":"Luke.5.30","start":42005030,"end":42005030,"break":"none","ruby":[[9,1,"びと"],[13,2,"りっぽう"],[15,2,"がくしゃ"],[25,2,"でし"],[30,1,"たい"],[38,1,"い"],[54,3,"しゅぜいにん"],[58,2,"つみびと"],[63,2,"いんしょく"],[66,1,"とも"]],"text":"ところが、パリサイ人やその律法学者たちが、イエスの弟子たちに対してつぶやいて言った、「どうしてあなたがたは、取税人や罪人などと飲食を共にするのか」。"},{"ref":"Luke.5.31","start":42005031,"end":42005031,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[13,2,"けんこう"],[16,1,"ひと"],[19,2,"いしゃ"],[31,2,"びょうにん"]],"text":"イエスは答えて言われた、「健康な人には医者はいらない。いるのは病人である。"},{"ref":"Luke.5.32","start":42005032,"end":42005032,"break":"none","ruby":[[9,2,"ぎじん"],[12,1,"まね"],[21,2,"つみびと"],[24,1,"まね"],[27,1,"く"],[29,1,"あらた"]],"text":"わたしがきたのは、義人を招くためではなく、罪人を招いて悔い改めさせるためである」。"},{"ref":"Luke.5.33","start":42005033,"end":42005033,"break":"paragraph","ruby":[[2,1,"かれ"],[9,1,"い"],[18,2,"でし"],[28,2,"だんじき"],[35,1,"いのり"],[46,1,"びと"],[48,2,"でし"],[66,2,"でし"],[71,1,"た"],[75,1,"の"]],"text":"また彼らはイエスに言った、「ヨハネの弟子たちは、しばしば断食をし、また祈をしており、パリサイ人の弟子たちもそうしているのに、あなたの弟子たちは食べたり飲んだりしています」。"},{"ref":"Luke.5.34","start":42005034,"end":42005034,"break":"none","ruby":[[7,1,"い"],[20,2,"はなむこ"],[23,2,"いっしょ"],[31,2,"こんれい"],[34,1,"きゃく"],[36,2,"だんじき"]],"text":"するとイエスは言われた、「あなたがたは、花婿が一緒にいるのに、婚礼の客に断食をさせることができるであろうか。"},{"ref":"Luke.5.35","start":42005035,"end":42005035,"break":"none","ruby":[[4,2,"はなむこ"],[7,1,"うば"],[9,1,"さ"],[13,1,"ひ"],[15,1,"く"],[20,1,"ひ"],[23,2,"だんじき"]],"text":"しかし、花婿が奪い去られる日が来る。その日には断食をするであろう」。"},{"ref":"Luke.5.36","start":42005036,"end":42005036,"break":"none","ruby":[[13,1,"たとえ"],[15,1,"かた"],[25,1,"あたら"],[28,2,"きもの"],[32,1,"ぬの"],[36,1,"き"],[38,1,"と"],[42,1,"ふる"],[44,2,"きもの"],[50,1,"あ"],[71,1,"あたら"],[74,2,"きもの"],[77,1,"さ"],[86,1,"あたら"],[92,1,"と"],[95,1,"ぬの"],[99,1,"ふる"],[103,1,"あ"]],"text":"それからイエスはまた一つの譬を語られた、「だれも、新しい着物から布ぎれを切り取って、古い着物につぎを当てるものはない。もしそんなことをしたら、新しい着物を裂くことになるし、新しいのから取った布ぎれも古いのに合わないであろう。"},{"ref":"Luke.5.37","start":42005037,"end":42005037,"break":"none","ruby":[[6,1,"あたら"],[12,1,"しゅ"],[14,1,"ふる"],[16,1,"かわ"],[17,1,"ぶくろ"],[19,1,"い"],[38,1,"あたら"],[44,1,"しゅ"],[46,1,"かわ"],[47,1,"ぶくろ"],[51,1,"さ"],[60,1,"しゅ"],[62,1,"な"],[64,1,"で"],[68,1,"かわ"],[69,1,"ぶくろ"]],"text":"まただれも、新しいぶどう酒を古い皮袋に入れはしない。もしそんなことをしたら、新しいぶどう酒は皮袋をはり裂き、そしてぶどう酒は流れ出るし、皮袋もむだになるであろう。"},{"ref":"Luke.5.38","start":42005038,"end":42005038,"break":"none","ruby":[[0,1,"あたら"],[6,1,"しゅ"],[8,1,"あたら"],[11,1,"かわ"],[12,1,"ぶくろ"],[14,1,"い"]],"text":"新しいぶどう酒は新しい皮袋に入れるべきである。"},{"ref":"Luke.5.39","start":42005039,"end":42005039,"break":"none","ruby":[[6,1,"ふる"],[8,1,"さけ"],[10,1,"の"],[16,1,"あたら"],[31,1,"ふる"],[35,1,"よ"],[39,1,"かんが"]],"text":"まただれも、古い酒を飲んでから、新しいのをほしがりはしない。『古いのが良い』と考えているからである」。"}]