[{"ref":"Mark.11.1","start":41011001,"end":41011001,"break":"paragraph","ruby":[[3,1,"かれ"],[12,1,"ちか"],[20,1,"やま"],[22,1,"そ"],[35,2,"ふきん"],[40,1,"とき"],[50,2,"でし"],[58,1,"い"]],"text":"さて、彼らがエルサレムに近づき、オリブの山に沿ったベテパゲ、ベタニヤの附近にきた時、イエスはふたりの弟子をつかわして言われた、"},{"ref":"Mark.11.2","start":41011002,"end":41011002,"break":"none","ruby":[[5,1,"むら"],[7,1,"い"],[28,1,"の"],[39,1,"こ"],[50,1,"み"],[60,1,"と"],[63,1,"ひ"]],"text":"「むこうの村へ行きなさい。そこにはいるとすぐ、まだだれも乗ったことのないろばの子が、つないであるのを見るであろう。それを解いて引いてきなさい。"},{"ref":"Mark.11.3","start":41011003,"end":41011003,"break":"none","ruby":[[19,1,"こと"],[26,1,"い"],[32,1,"しゅ"],[35,1,"い"],[37,1,"よう"],[51,1,"かえ"],[62,1,"い"]],"text":"もし、だれかがあなたがたに、なぜそんな事をするのかと言ったなら、主がお入り用なのです。またすぐ、ここへ返してくださいますと、言いなさい」。"},{"ref":"Mark.11.4","start":41011004,"end":41011004,"break":"none","ruby":[[4,1,"かれ"],[7,1,"で"],[11,1,"い"],[17,2,"おもてどお"],[21,2,"とぐち"],[28,1,"こ"],[38,1,"み"],[46,1,"と"]],"text":"そこで、彼らは出かけて行き、そして表通りの戸口に、ろばの子がつないであるのを見たので、それを解いた。"},{"ref":"Mark.11.5","start":41011005,"end":41011005,"break":"none","ruby":[[7,1,"た"],[12,2,"ひとびと"],[15,1,"い"],[25,1,"こ"],[27,1,"と"]],"text":"すると、そこに立っていた人々が言った、「そのろばの子を解いて、どうするのか」。"},{"ref":"Mark.11.6","start":41011006,"end":41011006,"break":"none","ruby":[[0,2,"でし"],[10,1,"い"],[17,1,"かれ"],[20,1,"はな"]],"text":"弟子たちは、イエスが言われたとおり彼らに話したので、ゆるしてくれた。"},{"ref":"Mark.11.7","start":41011007,"end":41011007,"break":"none","ruby":[[4,2,"でし"],[15,1,"こ"],[25,1,"ひ"],[31,2,"じぶん"],[36,2,"うわぎ"],[42,1,"な"],[55,1,"うえ"],[58,1,"の"]],"text":"そこで、弟子たちは、そのろばの子をイエスのところに引いてきて、自分たちの上着をそれに投げかけると、イエスはその上にお乗りになった。"},{"ref":"Mark.11.8","start":41011008,"end":41011008,"break":"none","ruby":[[3,1,"おお"],[6,2,"ひとびと"],[9,2,"じぶん"],[14,2,"うわぎ"],[17,1,"みち"],[19,1,"し"],[24,1,"た"],[26,2,"ひとびと"],[29,1,"は"],[34,1,"えだ"],[36,2,"のはら"],[40,1,"き"],[45,1,"し"]],"text":"すると多くの人々は自分たちの上着を道に敷き、また他の人々は葉のついた枝を野原から切ってきて敷いた。"},{"ref":"Mark.11.9","start":41011009,"end":41011009,"break":"none","breaks":[[27,"stanza"],[32,"line"]],"ruby":[[4,1,"まえ"],[6,1,"ゆ"],[8,1,"もの"],[14,1,"したが"],[16,1,"もの"],[18,1,"とも"],[20,1,"さけ"],[32,1,"しゅ"],[34,2,"みな"],[43,1,"もの"],[46,2,"しゅくふく"]],"text":"そして、前に行く者も、あとに従う者も共に叫びつづけた、「ホサナ、主の御名によってきたる者に、祝福あれ。"},{"ref":"Mark.11.10","start":41011010,"end":41011010,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"いま"],[9,1,"ちち"],[14,1,"くに"],[17,2,"しゅくふく"],[24,1,"たか"],[26,1,"ところ"]],"text":"今きたる、われらの父ダビデの国に、祝福あれ。いと高き所に、ホサナ」。"},{"ref":"Mark.11.11","start":41011011,"end":41011011,"break":"none","ruby":[[14,1,"つ"],[17,1,"みや"],[36,1,"み"],[41,1,"のち"],[46,1,"とき"],[61,2,"でし"],[64,1,"とも"],[71,1,"で"],[73,1,"い"]],"text":"こうしてイエスはエルサレムに着き、宮にはいられた。そして、すべてのものを見まわった後、もはや時もおそくなっていたので、十二弟子と共にベタニヤに出て行かれた。"},{"ref":"Mark.11.12","start":41011012,"end":41011012,"break":"paragraph","ruby":[[0,2,"よくじつ"],[3,1,"かれ"],[12,1,"で"],[25,2,"くうふく"]],"text":"翌日、彼らがベタニヤから出かけてきたとき、イエスは空腹をおぼえられた。"},{"ref":"Mark.11.13","start":41011013,"end":41011013,"break":"none","ruby":[[4,1,"は"],[6,1,"しげ"],[14,1,"き"],[16,1,"とお"],[30,1,"き"],[32,1,"なに"],[42,2,"ちかよ"],[49,1,"は"],[54,1,"なに"],[56,2,"みあた"],[69,2,"きせつ"]],"text":"そして、葉の茂ったいちじくの木を遠くからごらんになって、その木に何かありはしないかと近寄られたが、葉のほかは何も見当らなかった。いちじくの季節でなかったからである。"},{"ref":"Mark.11.14","start":41011014,"end":41011014,"break":"none","ruby":[[10,1,"き"],[18,1,"いま"],[21,1,"のち"],[32,1,"み"],[34,1,"た"],[37,1,"もの"],[46,1,"い"],[51,2,"でし"],[59,1,"き"]],"text":"そこで、イエスはその木にむかって、「今から後いつまでも、おまえの実を食べる者がないように」と言われた。弟子たちはこれを聞いていた。"},{"ref":"Mark.11.15","start":41011015,"end":41011015,"break":"paragraph","ruby":[[5,1,"かれ"],[21,1,"みや"],[23,1,"はい"],[26,1,"みや"],[28,1,"にわ"],[30,1,"う"],[32,1,"か"],[38,2,"ひとびと"],[41,1,"お"],[43,1,"だ"],[49,3,"りょうがえにん"],[53,1,"だい"],[59,1,"う"],[61,1,"もの"],[63,2,"こしかけ"]],"text":"それから、彼らはエルサレムにきた。イエスは宮に入り、宮の庭で売り買いしていた人々を追い出しはじめ、両替人の台や、はとを売る者の腰掛をくつがえし、"},{"ref":"Mark.11.16","start":41011016,"end":41011016,"break":"none","ruby":[[2,1,"うつわ"],[6,1,"も"],[9,1,"みや"],[11,1,"にわ"],[13,1,"とお"],[15,1,"ぬ"],[21,1,"ゆる"]],"text":"また器ものを持って宮の庭を通り抜けるのをお許しにならなかった。"},{"ref":"Mark.11.17","start":41011017,"end":41011017,"break":"none","ruby":[[4,1,"かれ"],[7,1,"おし"],[10,1,"い"],[21,1,"いえ"],[28,2,"こくみん"],[31,1,"いのり"],[33,1,"いえ"],[47,1,"か"],[73,2,"ごうとう"],[76,1,"す"]],"text":"そして、彼らに教えて言われた、「『わたしの家は、すべての国民の祈の家ととなえらるべきである』と書いてあるではないか。それだのに、あなたがたはそれを強盗の巣にしてしまった」。"},{"ref":"Mark.11.18","start":41011018,"end":41011018,"break":"none","ruby":[[0,3,"さいしちょう"],[4,2,"りっぽう"],[6,2,"がくしゃ"],[14,1,"き"],[27,1,"ころ"],[31,1,"はか"],[35,1,"かれ"],[39,2,"ぐんしゅう"],[46,1,"おしえ"],[48,2,"かんどう"],[61,1,"おそ"]],"text":"祭司長、律法学者たちはこれを聞いて、どうかしてイエスを殺そうと計った。彼らは、群衆がみなその教に感動していたので、イエスを恐れていたからである。"},{"ref":"Mark.11.19","start":41011019,"end":41011019,"break":"paragraph","ruby":[[0,2,"ゆうがた"],[11,2,"でし"],[25,1,"みやこ"],[27,1,"そと"],[29,1,"で"],[31,1,"い"]],"text":"夕方になると、イエスと弟子たちとは、いつものように都の外に出て行った。"},{"ref":"Mark.11.20","start":41011020,"end":41011020,"break":"paragraph","ruby":[[0,1,"あさ"],[4,1,"みち"],[14,1,"かれ"],[17,1,"さき"],[24,2,"ねもと"],[28,1,"か"],[35,1,"み"]],"text":"朝はやく道をとおっていると、彼らは先のいちじくが根元から枯れているのを見た。"},{"ref":"Mark.11.21","start":41011021,"end":41011021,"break":"none","ruby":[[8,1,"おも"],[10,1,"だ"],[17,1,"い"],[22,2,"せんせい"],[47,1,"か"]],"text":"そこで、ペテロは思い出してイエスに言った、「先生、ごらんなさい。あなたがのろわれたいちじくが、枯れています」。"},{"ref":"Mark.11.22","start":41011022,"end":41011022,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[13,1,"かみ"],[15,1,"しん"]],"text":"イエスは答えて言われた、「神を信じなさい。"},{"ref":"Mark.11.23","start":41011023,"end":41011023,"break":"none","ruby":[[2,1,"き"],[17,1,"やま"],[20,1,"うご"],[22,1,"だ"],[26,1,"うみ"],[28,1,"なか"],[34,1,"い"],[39,1,"い"],[45,1,"かなら"],[47,1,"な"],[51,1,"こころ"],[53,1,"うたが"],[58,1,"しん"],[70,1,"な"]],"text":"よく聞いておくがよい。だれでもこの山に、動き出して、海の中にはいれと言い、その言ったことは必ず成ると、心に疑わないで信じるなら、そのとおりに成るであろう。"},{"ref":"Mark.11.24","start":41011024,"end":41011024,"break":"none","ruby":[[10,1,"い"],[18,1,"いの"],[20,1,"もと"],[37,1,"しん"]],"text":"そこで、あなたがたに言うが、なんでも祈り求めることは、すでにかなえられたと信じなさい。そうすれば、そのとおりになるであろう。"},{"ref":"Mark.11.25","start":41011025,"end":41011025,"break":"none","ruby":[[2,1,"た"],[5,1,"いの"],[14,1,"たい"],[18,1,"なに"],[20,1,"うら"],[22,1,"こと"],[46,1,"てん"],[57,1,"ちち"]],"text":"また立って祈るとき、だれかに対して、何か恨み事があるならば、ゆるしてやりなさい。そうすれば、天にいますあなたがたの父も、あなたがたのあやまちを、ゆるしてくださるであろう。〔"},{"ref":"Mark.11.26","start":41011026,"end":41011026,"break":"none","ruby":[[11,1,"てん"],[22,1,"ちち"]],"text":"もしゆるさないならば、天にいますあなたがたの父も、あなたがたのあやまちを、ゆるしてくださらないであろう〕」。"},{"ref":"Mark.11.27","start":41011027,"end":41011027,"break":"paragraph","ruby":[[0,1,"かれ"],[22,1,"みや"],[24,1,"うち"],[26,1,"ある"],[35,3,"さいしちょう"],[39,2,"りっぽう"],[41,2,"がくしゃ"],[44,2,"ちょうろう"],[56,1,"い"]],"text":"彼らはまたエルサレムにきた。そして、イエスが宮の内を歩いておられると、祭司長、律法学者、長老たちが、みもとにきて言った、"},{"ref":"Mark.11.28","start":41011028,"end":41011028,"break":"none","ruby":[[1,1,"なに"],[3,2,"けんい"],[13,1,"こと"],[30,2,"けんい"],[33,1,"さづ"]],"text":"「何の権威によってこれらの事をするのですか。だれが、そうする権威を授けたのですか」。"},{"ref":"Mark.11.29","start":41011029,"end":41011029,"break":"none","ruby":[[8,1,"かれ"],[11,1,"い"],[21,1,"たず"],[29,1,"こた"],[42,1,"なに"],[44,2,"けんい"],[59,1,"こと"],[72,1,"い"]],"text":"そこで、イエスは彼らに言われた、「一つだけ尋ねよう。それに答えてほしい。そうしたら、何の権威によって、わたしがこれらの事をするのか、あなたがたに言おう。"},{"ref":"Mark.11.30","start":41011030,"end":41011030,"break":"none","ruby":[[10,1,"てん"],[19,1,"ひと"],[28,1,"こた"]],"text":"ヨハネのバプテスマは天からであったか、人からであったか、答えなさい」。"},{"ref":"Mark.11.31","start":41011031,"end":41011031,"break":"none","ruby":[[4,1,"かれ"],[7,1,"たがい"],[9,1,"ろん"],[12,1,"い"],[19,1,"てん"],[24,1,"い"],[33,1,"かれ"],[35,1,"しん"],[49,1,"い"]],"text":"すると、彼らは互に論じて言った、「もし天からだと言えば、では、なぜ彼を信じなかったのか、とイエスは言うだろう。"},{"ref":"Mark.11.32","start":41011032,"end":41011032,"break":"none","ruby":[[4,1,"ひと"],[9,1,"い"],[16,1,"かれ"],[19,2,"ぐんしゅう"],[22,1,"おそ"],[28,2,"ひとびと"],[31,1,"みな"],[37,3,"よげんしゃ"],[47,1,"おも"]],"text":"しかし、人からだと言えば……」。彼らは群衆を恐れていた。人々が皆、ヨハネを預言者だとほんとうに思っていたからである。"},{"ref":"Mark.11.33","start":41011033,"end":41011033,"break":"none","ruby":[[3,1,"かれ"],[22,1,"こた"],[33,1,"い"],[43,1,"なに"],[45,2,"けんい"],[55,1,"こと"],[68,1,"い"]],"text":"それで彼らは「わたしたちにはわかりません」と答えた。するとイエスは言われた、「わたしも何の権威によってこれらの事をするのか、あなたがたに言うまい」。"}]