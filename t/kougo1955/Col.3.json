[{"ref":"Col.3.1","start":51003001,"end":51003001,"break":"paragraph","ruby":[[17,1,"とも"],[32,1,"うえ"],[39,1,"もと"],[54,1,"かみ"],[56,1,"みぎ"],[58,1,"ざ"]],"text":"このように、あなたがたはキリストと共によみがえらされたのだから、上にあるものを求めなさい。そこではキリストが神の右に座しておられるのである。"},{"ref":"Col.3.2","start":51003002,"end":51003002,"break":"none","ruby":[[6,1,"うえ"],[13,1,"おも"],[22,2,"ちじょう"],[28,1,"こころ"],[30,1,"ひ"]],"text":"あなたがたは上にあるものを思うべきであって、地上のものに心を引かれてはならない。"},{"ref":"Col.3.3","start":51003003,"end":51003003,"break":"none","ruby":[[9,1,"し"],[35,1,"とも"],[37,1,"かみ"],[42,1,"かく"]],"text":"あなたがたはすでに死んだものであって、あなたがたのいのちは、キリストと共に神のうちに隠されているのである。"},{"ref":"Col.3.4","start":51003004,"end":51003004,"break":"none","ruby":[[16,1,"あらわ"],[19,1,"とき"],[35,1,"とも"],[37,2,"えいこう"],[43,1,"あらわ"]],"text":"わたしたちのいのちなるキリストが現れる時には、あなたがたも、キリストと共に栄光のうちに現れるであろう。"},{"ref":"Col.3.5","start":51003005,"end":51003005,"break":"paragraph","ruby":[[4,2,"ちじょう"],[7,2,"したい"],[15,3,"ふひんこう"],[19,1,"けが"],[22,2,"じょうよく"],[25,1,"あく"],[26,1,"よく"],[30,2,"どんよく"],[33,1,"ころ"],[43,2,"どんよく"],[46,2,"ぐうぞう"],[48,2,"れいはい"]],"text":"だから、地上の肢体、すなわち、不品行、汚れ、情欲、悪欲、また貪欲を殺してしまいなさい。貪欲は偶像礼拝にほかならない。"},{"ref":"Col.3.6","start":51003006,"end":51003006,"break":"none","ruby":[[11,1,"かみ"],[13,1,"いか"],[16,1,"くだ"]],"text":"これらのことのために、神の怒りが下るのである。"},{"ref":"Col.3.7","start":51003007,"end":51003007,"break":"none","ruby":[[7,2,"いぜん"],[16,1,"ひ"],[18,1,"す"],[24,1,"とき"],[37,1,"ある"]],"text":"あなたがたも、以前これらのうちに日を過ごしていた時には、これらのことをして歩いていた。"},{"ref":"Col.3.8","start":51003008,"end":51003008,"break":"none","ruby":[[3,1,"いま"],[17,1,"す"],[20,1,"いか"],[23,1,"いきどお"],[26,2,"あくい"],[33,1,"くち"],[36,1,"で"],[38,1,"は"],[42,2,"ことば"],[46,1,"す"]],"text":"しかし今は、これらいっさいのことを捨て、怒り、憤り、悪意、そしり、口から出る恥ずべき言葉を、捨ててしまいなさい。"},{"ref":"Col.3.9","start":51003009,"end":51003009,"break":"none","ruby":[[0,1,"たがい"],[5,1,"い"],[21,1,"ふる"],[23,1,"ひと"],[27,1,"おこな"],[30,2,"いっしょ"],[33,1,"ぬ"],[35,1,"す"]],"text":"互にうそを言ってはならない。あなたがたは、古き人をその行いと一緒に脱ぎ捨て、"},{"ref":"Col.3.10","start":51003010,"end":51003010,"break":"none","ruby":[[0,1,"つく"],[2,1,"しゅ"],[8,1,"したが"],[11,1,"あたら"],[17,1,"しん"],[19,2,"ちしき"],[22,1,"いた"],[24,1,"あたら"],[27,1,"ひと"],[29,1,"き"]],"text":"造り主のかたちに従って新しくされ、真の知識に至る新しき人を着たのである。"},{"ref":"Col.3.11","start":51003011,"end":51003011,"break":"none","ruby":[[12,1,"じん"],[17,1,"じん"],[19,2,"かつれい"],[22,1,"む"],[23,2,"かつれい"],[26,2,"みかい"],[29,1,"ひと"],[35,1,"びと"],[37,2,"どれい"],[40,3,"じゆうじん"],[44,2,"さべつ"]],"text":"そこには、もはやギリシヤ人とユダヤ人、割礼と無割礼、未開の人、スクテヤ人、奴隷、自由人の差別はない。キリストがすべてであり、すべてのもののうちにいますのである。"},{"ref":"Col.3.12","start":51003012,"end":51003012,"break":"paragraph","ruby":[[11,1,"かみ"],[13,1,"えら"],[17,1,"もの"],[19,1,"せい"],[23,1,"あい"],[29,1,"もの"],[41,1,"こころ"],[43,2,"じあい"],[46,1,"けん"],[50,2,"にゅうわ"],[53,2,"かんよう"],[56,1,"み"],[58,1,"つ"]],"text":"だから、あなたがたは、神に選ばれた者、聖なる、愛されている者であるから、あわれみの心、慈愛、謙そん、柔和、寛容を身に着けなさい。"},{"ref":"Col.3.13","start":51003013,"end":51003013,"break":"none","ruby":[[0,1,"たがい"],[2,1,"しの"],[9,1,"たがい"],[11,1,"せめ"],[25,1,"あ"],[31,1,"しゅ"],[43,1,"くだ"],[67,1,"あ"]],"text":"互に忍びあい、もし互に責むべきことがあれば、ゆるし合いなさい。主もあなたがたをゆるして下さったのだから、そのように、あなたがたもゆるし合いなさい。"},{"ref":"Col.3.14","start":51003014,"end":51003014,"break":"none","ruby":[[11,1,"うえ"],[14,1,"あい"],[16,1,"くわ"],[22,1,"あい"],[29,2,"かんぜん"],[32,1,"むす"],[34,1,"おび"]],"text":"これらいっさいのものの上に、愛を加えなさい。愛は、すべてを完全に結ぶ帯である。"},{"ref":"Col.3.15","start":51003015,"end":51003015,"break":"none","ruby":[[5,2,"へいわ"],[15,1,"こころ"],[17,2,"しはい"],[35,1,"め"],[39,2,"いったい"],[60,2,"かんしゃ"]],"text":"キリストの平和が、あなたがたの心を支配するようにしなさい。あなたがたが召されて一体となったのは、このためでもある。いつも感謝していなさい。"},{"ref":"Col.3.16","start":51003016,"end":51003016,"break":"none","ruby":[[5,2,"ことば"],[18,1,"ゆた"],[21,1,"やど"],[32,2,"ちえ"],[39,1,"たがい"],[41,1,"おし"],[45,2,"くんかい"],[49,1,"し"],[55,1,"れい"],[57,1,"うた"],[64,2,"かんしゃ"],[68,1,"こころ"],[71,1,"かみ"]],"text":"キリストの言葉を、あなたがたのうちに豊かに宿らせなさい。そして、知恵をつくして互に教えまた訓戒し、詩とさんびと霊の歌とによって、感謝して心から神をほめたたえなさい。"},{"ref":"Col.3.17","start":51003017,"end":51003017,"break":"none","ruby":[[17,2,"ことば"],[30,1,"と"],[38,1,"しゅ"],[43,1,"な"],[51,1,"かれ"],[56,1,"ちち"],[59,1,"かみ"],[61,2,"かんしゃ"]],"text":"そして、あなたのすることはすべて、言葉によるとわざによるとを問わず、いっさい主イエスの名によってなし、彼によって父なる神に感謝しなさい。"},{"ref":"Col.3.18","start":51003018,"end":51003018,"break":"paragraph","ruby":[[0,1,"つま"],[3,1,"もの"],[6,1,"おっと"],[8,1,"つか"],[18,1,"しゅ"],[22,1,"もの"]],"text":"妻たる者よ、夫に仕えなさい。それが、主にある者にふさわしいことである。"},{"ref":"Col.3.19","start":51003019,"end":51003019,"break":"none","ruby":[[0,1,"おっと"],[3,1,"もの"],[6,1,"つま"],[8,1,"あい"]],"text":"夫たる者よ、妻を愛しなさい。つらくあたってはいけない。"},{"ref":"Col.3.20","start":51003020,"end":51003020,"break":"none","ruby":[[0,1,"こ"],[3,1,"もの"],[6,2,"なにごと"],[13,2,"りょうしん"],[16,1,"したが"],[25,1,"しゅ"],[27,1,"よろこ"]],"text":"子たる者よ、何事についても両親に従いなさい。これが主に喜ばれることである。"},{"ref":"Col.3.21","start":51003021,"end":51003021,"break":"none","ruby":[[0,1,"ちち"],[3,1,"もの"],[6,2,"こども"],[21,1,"こころ"],[29,1,"し"]],"text":"父たる者よ、子供をいらだたせてはいけない。心がいじけるかも知れないから。"},{"ref":"Col.3.22","start":51003022,"end":51003022,"break":"none","ruby":[[0,1,"しもべ"],[3,1,"もの"],[6,2,"なにごと"],[14,1,"にく"],[18,2,"しゅじん"],[21,1,"したが"],[27,1,"ひと"],[38,2,"めさき"],[43,1,"つと"],[54,2,"まごころ"],[60,1,"しゅ"],[62,1,"おそ"],[67,1,"したが"]],"text":"僕たる者よ、何事についても、肉による主人に従いなさい。人にへつらおうとして、目先だけの勤めをするのではなく、真心をこめて主を恐れつつ、従いなさい。"},{"ref":"Col.3.23","start":51003023,"end":51003023,"break":"none","ruby":[[0,1,"なに"],[7,1,"ひと"],[9,1,"たい"],[17,1,"しゅ"],[19,1,"たい"],[28,1,"こころ"],[31,1,"はたら"]],"text":"何をするにも、人に対してではなく、主に対してするように、心から働きなさい。"},{"ref":"Col.3.24","start":51003024,"end":51003024,"break":"none","ruby":[[6,1,"し"],[21,2,"みくに"],[30,1,"むく"],[35,1,"しゅ"],[38,1,"う"],[53,1,"しゅ"],[59,1,"つか"]],"text":"あなたがたが知っているとおり、あなたがたは御国をつぐことを、報いとして主から受けるであろう。あなたがたは、主キリストに仕えているのである。"},{"ref":"Col.3.25","start":51003025,"end":51003025,"break":"none","ruby":[[0,2,"ふせい"],[3,1,"おこな"],[5,1,"もの"],[8,2,"じぶん"],[11,1,"おこな"],[14,2,"ふせい"],[17,1,"たい"],[20,1,"むく"],[23,1,"う"],[35,2,"さべつ"],[37,1,"あつか"]],"text":"不正を行う者は、自分の行った不正に対して報いを受けるであろう。それには差別扱いはない。"}]