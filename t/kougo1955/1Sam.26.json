[{"ref":"1Sam.26.1","start":9026001,"end":9026001,"break":"paragraph","ruby":[[24,1,"い"],[33,2,"あらの"],[36,1,"まえ"],[44,1,"やま"],[46,1,"かく"]],"text":"そのころジフびとがギベアにおるサウルのもとにきて言った、「ダビデは荒野の前にあるハキラの山に隠れているではありませんか」。"},{"ref":"1Sam.26.2","start":9026002,"end":9026002,"break":"none","ruby":[[4,1,"た"],[11,2,"あらの"],[18,1,"さが"],[34,1,"えら"],[39,1,"にん"],[43,1,"つ"],[50,2,"あらの"],[53,1,"くだ"]],"text":"サウルは立って、ジフの荒野でダビデを捜すために、イスラエルのうちから選んだ三千人をひき連れて、ジフの荒野に下った。"},{"ref":"1Sam.26.3","start":9026003,"end":9026003,"break":"none","ruby":[[4,2,"あらの"],[7,1,"まえ"],[9,1,"みち"],[22,1,"やま"],[24,1,"じん"],[26,1,"と"],[34,2,"あらの"],[50,2,"じぶん"],[56,1,"お"],[59,2,"あらの"],[66,1,"み"]],"text":"サウルは荒野の前の道のかたわらにあるハキラの山に陣を取った。ダビデは荒野にとどまっていたが、サウルが自分のあとを追って荒野にきたのを見て、"},{"ref":"1Sam.26.4","start":9026004,"end":9026004,"break":"none","ruby":[[0,2,"せっこう"],[3,1,"だ"],[10,1,"たし"],[17,1,"し"]],"text":"斥候を出し、サウルが確かにきたのを知った。"},{"ref":"1Sam.26.5","start":9026005,"end":9026005,"break":"none","ruby":[[7,1,"た"],[15,1,"じん"],[17,1,"と"],[22,1,"ところ"],[24,1,"い"],[34,1,"ぐん"],[36,1,"ちょう"],[41,1,"こ"],[47,1,"ね"],[51,2,"ばしょ"],[54,1,"み"],[61,2,"じんしょ"],[67,1,"ね"],[72,1,"たみ"],[76,2,"しゅうい"],[79,2,"しゅくえい"]],"text":"そしてダビデは立って、サウルが陣を取っている所へ行って、サウルとその軍の長、ネルの子アブネルの寝ている場所を見た。サウルは陣所のうちに寝ていて、民はその周囲に宿営していた。"},{"ref":"1Sam.26.6","start":9026006,"end":9026006,"break":"paragraph","ruby":[[22,1,"こ"],[29,2,"きょうだい"],[40,1,"い"],[52,1,"とも"],[58,1,"じん"],[60,1,"くだ"],[63,1,"い"],[74,1,"い"],[83,2,"いっしょ"],[86,1,"くだ"],[89,1,"い"]],"text":"ダビデは、ヘテびとアヒメレク、およびゼルヤの子で、ヨアブの兄弟であるアビシャイに言った、「だれがわたしと共にサウルの陣に下って行くか」。アビシャイは言った、「わたしが一緒に下って行きます」。"},{"ref":"1Sam.26.7","start":9026007,"end":9026007,"break":"none","ruby":[[15,1,"よる"],[17,1,"たみ"],[23,1,"い"],[34,2,"じんしょ"],[40,1,"み"],[42,1,"よこ"],[46,1,"ね"],[56,1,"まくら"],[60,1,"ち"],[62,1,"つ"],[79,1,"たみ"],[85,2,"しゅうい"],[88,1,"ね"]],"text":"こうしてダビデとアビシャイとが夜、民のところへ行ってみると、サウルは陣所のうちに身を横たえて寝ており、そのやりは枕もとに地に突きさしてあった。そしてアブネルと民らとはその周囲に寝ていた。"},{"ref":"1Sam.26.8","start":9026008,"end":9026008,"break":"none","ruby":[[10,1,"い"],[15,1,"かみ"],[20,1,"てき"],[26,1,"て"],[28,1,"わた"],[43,1,"かれ"],[53,1,"つ"],[56,1,"かれ"],[58,1,"ち"],[60,1,"さ"],[76,1,"つ"],[80,1,"およ"]],"text":"アビシャイはダビデに言った、「神はきょう敵をあなたの手に渡されました。どうぞわたしに、彼のやりをもってひと突きで彼を地に刺しとおさせてください。ふたたび突くには及びません」。"},{"ref":"1Sam.26.9","start":9026009,"end":9026009,"break":"none","ruby":[[13,1,"い"],[18,1,"かれ"],[20,1,"ころ"],[29,1,"しゅ"],[31,1,"あぶら"],[33,1,"そそ"],[37,1,"もの"],[39,1,"む"],[44,1,"て"],[49,1,"つみ"],[51,1,"え"],[54,1,"もの"]],"text":"しかしダビデはアビシャイに言った、「彼を殺してはならない。主が油を注がれた者に向かって、手をのべ、罪を得ない者があろうか」。"},{"ref":"1Sam.26.10","start":9026010,"end":9026010,"break":"none","ruby":[[6,1,"い"],[11,1,"しゅ"],[13,1,"い"],[21,1,"しゅ"],[23,1,"かれ"],[25,1,"う"],[38,1,"かれ"],[40,1,"し"],[42,1,"ひ"],[44,1,"く"],[55,1,"たたか"],[58,1,"くだ"],[61,1,"い"],[64,1,"ほろ"]],"text":"ダビデはまた言った、「主は生きておられる。主が彼を撃たれるであろう。あるいは彼の死ぬ日が来るであろう。あるいは戦いに下って行って滅びるであろう。"},{"ref":"1Sam.26.11","start":9026011,"end":9026011,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"あぶら"],[4,1,"そそ"],[8,1,"もの"],[10,1,"む"],[19,1,"て"],[27,1,"しゅ"],[29,1,"きん"],[38,1,"いま"],[53,1,"みず"],[58,1,"と"],[72,1,"さ"]],"text":"主が油を注がれた者に向かって、わたしが手をのべることを主は禁じられる。しかし今、そのまくらもとにあるやりと水のびんを取りなさい。そしてわれわれは去ろう」。"},{"ref":"1Sam.26.12","start":9026012,"end":9026012,"break":"none","ruby":[[12,1,"まくら"],[21,1,"みず"],[26,1,"と"],[29,1,"かれ"],[32,1,"さ"],[43,1,"み"],[49,1,"し"],[59,1,"め"],[68,1,"ねむ"],[74,1,"しゅ"],[76,1,"かれ"],[79,1,"ふか"],[81,1,"ねむ"]],"text":"こうしてダビデはサウルの枕もとから、やりと水のびんを取って彼らは去ったが、だれもそれを見ず、だれも知らず、また、だれも目をさまさず、みな眠っていた。主が彼らを深く眠らされたからである。"},{"ref":"1Sam.26.13","start":9026013,"end":9026013,"break":"paragraph","ruby":[[4,1,"む"],[7,1,"がわ"],[9,1,"わた"],[12,1,"い"],[16,1,"とお"],[18,1,"はな"],[21,1,"やま"],[23,1,"いただき"],[25,1,"た"],[29,1,"かれ"],[32,1,"あいだ"],[34,1,"へだ"],[38,1,"おお"]],"text":"ダビデは向こう側に渡って行って、遠く離れて山の頂に立った。彼らの間の隔たりは大きかった。"},{"ref":"1Sam.26.14","start":9026014,"end":9026014,"break":"none","ruby":[[4,1,"たみ"],[9,1,"こ"],[15,1,"よ"],[20,1,"い"],[35,1,"こた"],[48,1,"こた"],[51,1,"い"],[56,1,"おう"],[58,1,"よ"]],"text":"ダビデは民とネルの子アブネルに呼ばわって言った、「アブネルよ、あなたは答えないのか」。アブネルは答えて言った、「王を呼んでいるあなたはだれか」。"},{"ref":"1Sam.26.15","start":9026015,"end":9026015,"break":"none","ruby":[[9,1,"い"],[18,1,"おとこ"],[39,1,"およ"],[41,1,"ひと"],[64,2,"しゅくん"],[69,1,"おう"],[71,1,"まも"],[80,1,"たみ"],[91,2,"しゅくん"],[96,1,"おう"],[98,1,"ころ"]],"text":"ダビデはアブネルに言った、「あなたは男ではないか。イスラエルのうちに、あなたに及ぶ人があろうか。それであるのに、どうしてあなたは主君である王を守らなかったのか。民のひとりが、あなたの主君である王を殺そうとして、はいりこんだではないか。"},{"ref":"1Sam.26.16","start":9026016,"end":9026016,"break":"none","ruby":[[8,1,"こと"],[10,1,"よ"],[15,1,"しゅ"],[17,1,"い"],[35,1,"し"],[37,1,"あたい"],[41,1,"しゅ"],[43,1,"あぶら"],[55,2,"しゅくん"],[58,1,"まも"],[70,1,"おう"],[84,1,"まくら"],[91,1,"みず"],[103,1,"み"]],"text":"あなたがしたこの事は良くない。主は生きておられる。あなたがたは、まさに死に値する。主が油をそそがれた、あなたの主君を守らなかったからだ。いま王のやりがどこにあるか。その枕もとにあった水のびんがどこにあるかを見なさい」。"},{"ref":"1Sam.26.17","start":9026017,"end":9026017,"break":"paragraph","ruby":[[8,1,"こえ"],[10,1,"き"],[15,1,"い"],[22,1,"こ"],[35,1,"こえ"],[43,1,"い"],[48,1,"おう"],[52,1,"きみ"],[59,1,"こえ"]],"text":"サウルはダビデの声を聞きわけて言った、「わが子ダビデよ、これはあなたの声か」。ダビデは言った、「王、わが君よ、わたしの声です」。"},{"ref":"1Sam.26.18","start":9026018,"end":9026018,"break":"none","ruby":[[6,1,"い"],[13,1,"きみ"],[26,1,"お"],[39,1,"なに"],[52,1,"て"]],"text":"ダビデはまた言った、「わが君はどうしてしもべのあとを追われるのですか。わたしが何をしたのですか。わたしの手になんのわるいことがあるのですか。"},{"ref":"1Sam.26.19","start":9026019,"end":9026019,"break":"none","ruby":[[0,1,"おう"],[4,1,"きみ"],[11,1,"いま"],[16,2,"ことば"],[19,1,"き"],[29,1,"しゅ"],[35,1,"うご"],[44,1,"てき"],[58,1,"しゅ"],[60,1,"そな"],[62,1,"もの"],[64,1,"う"],[67,1,"やわ"],[85,1,"ひと"],[98,2,"ひとびと"],[101,1,"しゅ"],[103,1,"まえ"],[109,1,"う"],[116,1,"かれ"],[124,1,"い"],[127,1,"た"],[129,2,"かみがみ"],[132,1,"つか"],[139,1,"い"],[151,1,"お"],[153,1,"だ"],[156,1,"しゅ"],[158,1,"し"],[159,1,"ぎょう"]],"text":"王、わが君よ、どうぞ、今しもべの言葉を聞いてください。もし主があなたを動かして、わたしの敵とされたのであれば、どうぞ主が供え物を受けて和らいでくださるように。もし、それが人であるならば、どうぞその人々が主の前にのろいを受けるように。彼らが『おまえは行って他の神々に仕えなさい』と言って、きょう、わたしを追い出し、主の嗣業にあずかることができないようにしたからです。"},{"ref":"1Sam.26.20","start":9026020,"end":9026020,"break":"none","ruby":[[4,1,"いま"],[6,1,"しゅ"],[8,1,"まえ"],[10,1,"はな"],[18,1,"ち"],[20,1,"ち"],[22,1,"お"],[46,1,"おう"],[49,1,"ひと"],[51,1,"やま"],[58,1,"お"],[68,1,"いのち"],[70,1,"と"],[76,1,"で"]],"text":"それゆえ今、主の前を離れて、わたしの血が地に落ちることのないようにしてください。イスラエルの王は、人が山で、しゃこを追うように、わたしの命を取ろうとして出てこられたのです」。"},{"ref":"1Sam.26.21","start":9026021,"end":9026021,"break":"paragraph","ruby":[[2,1,"とき"],[8,1,"い"],[17,1,"つみ"],[19,1,"おか"],[25,1,"こ"],[31,1,"かえ"],[49,1,"いのち"],[55,1,"め"],[57,1,"たっと"],[59,1,"み"],[78,1,"がい"],[80,1,"くわ"],[93,1,"おろ"],[102,2,"ひじょう"]],"text":"その時、サウルは言った、「わたしは罪を犯した。わが子ダビデよ、帰ってきてください。きょう、わたしの命があなたの目に尊く見られたゆえ、わたしは、もはやあなたに害を加えないであろう。わたしは愚かなことをして、非常なまちがいをした」。"},{"ref":"1Sam.26.22","start":9026022,"end":9026022,"break":"none","ruby":[[4,1,"こた"],[9,1,"おう"],[27,2,"わかもの"],[30,1,"わた"],[40,1,"も"]],"text":"ダビデは答えた、「王のやりは、ここにあります。ひとりの若者に渡ってこさせ、これを持ちかえらせてください。"},{"ref":"1Sam.26.23","start":9026023,"end":9026023,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"ひと"],[10,1,"ぎ"],[12,2,"しんじつ"],[16,1,"したが"],[19,1,"むく"],[26,1,"しゅ"],[40,1,"て"],[42,1,"わた"],[53,1,"しゅ"],[55,1,"あぶら"],[57,1,"そそ"],[61,1,"もの"],[63,1,"む"],[68,1,"て"]],"text":"主は人おのおのにその義と真実とに従って報いられます。主がきょう、あなたをわたしの手に渡されたのに、わたしは主が油を注がれた者に向かって、手をのべることをしなかったのです。"},{"ref":"1Sam.26.24","start":9026024,"end":9026024,"break":"none","ruby":[[12,1,"いのち"],[14,1,"おも"],[25,1,"しゅ"],[31,1,"いのち"],[33,1,"おも"],[43,2,"くなん"],[47,1,"すく"],[49,1,"だ"]],"text":"きょう、わたしがあなたの命を重んじたように、どうぞ主がわたしの命を重んじて、もろもろの苦難から救い出してくださるように」。"},{"ref":"1Sam.26.25","start":9026025,"end":9026025,"break":"none","ruby":[[8,1,"い"],[15,1,"こ"],[36,1,"おお"],[39,1,"こと"],[52,1,"と"],[71,1,"みち"],[73,1,"い"],[80,2,"じぶん"],[83,1,"ところ"],[85,1,"かえ"]],"text":"サウルはダビデに言った、「わが子ダビデよ、あなたはほむべきかな。あなたは多くの事をおこなって、それをなし遂げるであろう」。こうしてダビデはその道を行き、サウルは自分の所へ帰った。"}]