[{"ref":"Exod.20.1","start":2020001,"end":2020001,"break":"paragraph","ruby":[[0,1,"かみ"],[8,2,"ことば"],[11,1,"かた"],[14,1,"い"]],"text":"神はこのすべての言葉を語って言われた。"},{"ref":"Exod.20.2","start":2020002,"end":2020002,"break":"paragraph","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[26,1,"ち"],[28,2,"どれい"],[31,1,"いえ"],[34,1,"みちび"],[36,1,"だ"],[39,1,"もの"]],"text":"「わたしはあなたの神、主であって、あなたをエジプトの地、奴隷の家から導き出した者である。"},{"ref":"Exod.20.3","start":2020003,"end":2020003,"break":"paragraph","ruby":[[18,1,"かみ"]],"text":"あなたはわたしのほかに、なにものをも神としてはならない。"},{"ref":"Exod.20.4","start":2020004,"end":2020004,"break":"paragraph","ruby":[[4,2,"じぶん"],[11,1,"きざ"],[14,1,"ぞう"],[16,1,"つく"],[25,1,"うえ"],[27,1,"てん"],[34,1,"した"],[36,1,"ち"],[45,1,"ち"],[47,1,"した"],[49,1,"みず"],[63,1,"かたち"],[66,1,"つく"]],"text":"あなたは自分のために、刻んだ像を造ってはならない。上は天にあるもの、下は地にあるもの、また地の下の水のなかにあるものの、どんな形をも造ってはならない。"},{"ref":"Exod.20.5","start":2020005,"end":2020005,"break":"none","ruby":[[5,1,"ふ"],[17,1,"つか"],[30,1,"かみ"],[32,1,"しゅ"],[44,1,"かみ"],[55,1,"にく"],[61,1,"ちち"],[63,1,"つみ"],[65,1,"こ"],[67,1,"むく"],[73,1,"だい"],[75,1,"およ"]],"text":"それにひれ伏してはならない。それに仕えてはならない。あなたの神、主であるわたしは、ねたむ神であるから、わたしを憎むものは、父の罪を子に報いて、三四代に及ぼし、"},{"ref":"Exod.20.6","start":2020006,"end":2020006,"break":"none","ruby":[[4,1,"あい"],[11,1,"いまし"],[14,1,"まも"],[21,1,"めぐ"],[24,1,"ほどこ"],[29,1,"だい"],[31,1,"いた"]],"text":"わたしを愛し、わたしの戒めを守るものには、恵みを施して、千代に至るであろう。"},{"ref":"Exod.20.7","start":2020007,"end":2020007,"break":"paragraph","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[13,1,"な"],[20,1,"とな"],[29,1,"しゅ"],[33,1,"な"],[39,1,"とな"],[46,1,"ばっ"],[52,1,"お"]],"text":"あなたは、あなたの神、主の名を、みだりに唱えてはならない。主は、み名をみだりに唱えるものを、罰しないでは置かないであろう。"},{"ref":"Exod.20.8","start":2020008,"end":2020008,"break":"paragraph","ruby":[[0,3,"あんそくにち"],[4,1,"おぼ"],[11,1,"せい"]],"text":"安息日を覚えて、これを聖とせよ。"},{"ref":"Exod.20.9","start":2020009,"end":2020009,"break":"none","ruby":[[1,1,"か"],[6,1,"はたら"]],"text":"六日のあいだ働いてあなたのすべてのわざをせよ。"},{"ref":"Exod.20.10","start":2020010,"end":2020010,"break":"none","ruby":[[0,2,"なぬか"],[2,1,"め"],[8,1,"かみ"],[10,1,"しゅ"],[12,2,"あんそく"],[47,1,"むすめ"],[58,2,"かちく"],[67,1,"もん"],[74,2,"たこく"],[77,1,"ひと"]],"text":"七日目はあなたの神、主の安息であるから、なんのわざをもしてはならない。あなたもあなたのむすこ、娘、しもべ、はしため、家畜、またあなたの門のうちにいる他国の人もそうである。"},{"ref":"Exod.20.11","start":2020011,"end":2020011,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"か"],[9,1,"てん"],[11,1,"ち"],[13,1,"うみ"],[18,1,"なか"],[27,1,"つく"],[31,2,"なぬか"],[33,1,"め"],[35,1,"やす"],[48,1,"しゅ"],[50,3,"あんそくにち"],[54,2,"しゅくふく"],[58,1,"せい"]],"text":"主は六日のうちに、天と地と海と、その中のすべてのものを造って、七日目に休まれたからである。それで主は安息日を祝福して聖とされた。"},{"ref":"Exod.20.12","start":2020012,"end":2020012,"break":"paragraph","ruby":[[4,1,"ちち"],[6,1,"はは"],[8,1,"うやま"],[19,1,"かみ"],[21,1,"しゅ"],[23,1,"たま"],[26,1,"ち"],[33,1,"なが"],[35,1,"い"]],"text":"あなたの父と母を敬え。これは、あなたの神、主が賜わる地で、あなたが長く生きるためである。"},{"ref":"Exod.20.13","start":2020013,"end":2020013,"break":"paragraph","ruby":[[4,1,"ころ"]],"text":"あなたは殺してはならない。"},{"ref":"Exod.20.14","start":2020014,"end":2020014,"break":"paragraph","ruby":[[4,2,"かんいん"]],"text":"あなたは姦淫してはならない。"},{"ref":"Exod.20.15","start":2020015,"end":2020015,"break":"paragraph","ruby":[[4,1,"ぬす"]],"text":"あなたは盗んではならない。"},{"ref":"Exod.20.16","start":2020016,"end":2020016,"break":"paragraph","ruby":[[4,2,"りんじん"],[11,2,"ぎしょう"]],"text":"あなたは隣人について、偽証してはならない。"},{"ref":"Exod.20.17","start":2020017,"end":2020017,"break":"paragraph","ruby":[[4,2,"りんじん"],[7,1,"いえ"],[20,2,"りんじん"],[23,1,"つま"],[34,1,"うし"],[44,2,"りんじん"]],"text":"あなたは隣人の家をむさぼってはならない。隣人の妻、しもべ、はしため、牛、ろば、またすべて隣人のものをむさぼってはならない」。"},{"ref":"Exod.20.18","start":2020018,"end":2020018,"break":"paragraph","ruby":[[0,1,"たみ"],[2,1,"みな"],[20,1,"おと"],[23,1,"やま"],[25,1,"けむ"],[33,1,"み"],[36,1,"たみ"],[38,1,"おそ"],[45,1,"とお"],[47,1,"はな"],[50,1,"た"]],"text":"民は皆、かみなりと、いなずまと、ラッパの音と、山の煙っているのとを見た。民は恐れおののき、遠く離れて立った。"},{"ref":"Exod.20.19","start":2020019,"end":2020019,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[22,1,"かた"],[36,1,"き"],[38,1,"したが"],[43,1,"かみ"],[51,1,"かた"],[79,1,"し"]],"text":"彼らはモーセに言った、「あなたがわたしたちに語ってください。わたしたちは聞き従います。神がわたしたちに語られぬようにしてください。それでなければ、わたしたちは死ぬでしょう」。"},{"ref":"Exod.20.20","start":2020020,"end":2020020,"break":"none","ruby":[[4,1,"たみ"],[6,1,"い"],[11,1,"おそ"],[20,1,"かみ"],[28,1,"こころ"],[38,1,"おそ"],[47,1,"め"],[49,1,"まえ"],[61,1,"つみ"],[63,1,"おか"],[75,1,"のぞ"]],"text":"モーセは民に言った、「恐れてはならない。神はあなたがたを試みるため、またその恐れをあなたがたの目の前において、あなたがたが罪を犯さないようにするために臨まれたのである」。"},{"ref":"Exod.20.21","start":2020021,"end":2020021,"break":"paragraph","ruby":[[4,1,"たみ"],[6,1,"とお"],[8,1,"はな"],[11,1,"た"],[20,1,"かみ"],[26,1,"こ"],[28,1,"くも"],[30,1,"ちか"],[34,1,"い"]],"text":"そこで、民は遠く離れて立ったが、モーセは神のおられる濃い雲に近づいて行った。"},{"ref":"Exod.20.22","start":2020022,"end":2020022,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[22,2,"ひとびと"],[27,1,"い"],[45,1,"てん"],[54,1,"かた"],[58,1,"み"]],"text":"主はモーセに言われた、「あなたはイスラエルの人々にこう言いなさい、『あなたがたは、わたしが天からあなたがたと語るのを見た。"},{"ref":"Exod.20.23","start":2020023,"end":2020023,"break":"none","ruby":[[10,1,"なら"],[14,1,"なに"],[17,1,"つく"],[26,1,"ぎん"],[28,2,"かみがみ"],[32,1,"きん"],[34,2,"かみがみ"],[48,1,"つく"]],"text":"あなたがたはわたしと並べて、何をも造ってはならない。銀の神々も、金の神々も、あなたがたのために、造ってはならない。"},{"ref":"Exod.20.24","start":2020024,"end":2020024,"break":"none","ruby":[[11,1,"つち"],[13,2,"さいだん"],[16,1,"きず"],[21,1,"うえ"],[27,2,"はんさい"],[30,3,"しゅうおんさい"],[34,1,"ひつじ"],[36,1,"うし"],[54,1,"な"],[56,1,"おぼ"],[65,1,"ところ"],[76,1,"のぞ"],[84,2,"しゅくふく"]],"text":"あなたはわたしのために土の祭壇を築き、その上にあなたの燔祭、酬恩祭、羊、牛をささげなければならない。わたしの名を覚えさせるすべての所で、わたしはあなたに臨んで、あなたを祝福するであろう。"},{"ref":"Exod.20.25","start":2020025,"end":2020025,"break":"none","ruby":[[10,1,"いし"],[12,2,"さいだん"],[15,1,"つく"],[21,1,"き"],[23,1,"いし"],[25,1,"きず"],[47,1,"あ"]],"text":"あなたがもしわたしに石の祭壇を造るならば、切り石で築いてはならない。あなたがもし、のみをそれに当てるならば、それをけがすからである。"},{"ref":"Exod.20.26","start":2020026,"end":2020026,"break":"none","ruby":[[4,2,"かいだん"],[15,2,"さいだん"],[18,1,"のぼ"],[31,1,"かく"],[33,1,"ところ"],[38,1,"うえ"]],"text":"あなたは階段によって、わたしの祭壇に登ってはならない。あなたの隠し所が、その上にあらわれることのないようにするためである』。"}]