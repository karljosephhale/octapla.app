[{"ref":"1Kgs.17.1","start":11017001,"end":11017001,"break":"paragraph","ruby":[[9,1,"す"],[24,1,"い"],[33,1,"つか"],[44,1,"かみ"],[46,1,"しゅ"],[48,1,"い"],[61,2,"ことば"],[70,2,"すうねん"],[72,1,"あめ"],[74,1,"つゆ"]],"text":"ギレアデのテシベに住むテシベびとエリヤはアハブに言った、「わたしの仕えているイスラエルの神、主は生きておられます。わたしの言葉のないうちは、数年雨も露もないでしょう」。"},{"ref":"1Kgs.17.2","start":11017002,"end":11017002,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がエリヤに臨んだ、"},{"ref":"1Kgs.17.3","start":11017003,"end":11017003,"break":"none","ruby":[[4,1,"さ"],[7,1,"ひがし"],[19,1,"ひがし"],[26,1,"かわ"],[32,1,"み"],[34,1,"かく"]],"text":"「ここを去って東におもむき、ヨルダンの東にあるケリテ川のほとりに身を隠しなさい。"},{"ref":"1Kgs.17.4","start":11017004,"end":11017004,"break":"none","ruby":[[5,1,"かわ"],[7,1,"みず"],[9,1,"の"],[23,1,"めい"],[34,1,"やしな"]],"text":"そしてその川の水を飲みなさい。わたしはからすに命じて、そこであなたを養わせよう」。"},{"ref":"1Kgs.17.5","start":11017005,"end":11017005,"break":"none","ruby":[[4,1,"い"],[8,1,"しゅ"],[10,2,"ことば"],[24,1,"い"],[33,1,"ひがし"],[40,1,"かわ"],[46,1,"す"]],"text":"エリヤは行って、主の言葉のとおりにした。すなわち行って、ヨルダンの東にあるケリテ川のほとりに住んだ。"},{"ref":"1Kgs.17.6","start":11017006,"end":11017006,"break":"none","ruby":[[8,1,"あさ"],[12,1,"かれ"],[14,1,"ところ"],[19,1,"にく"],[21,1,"はこ"],[26,1,"ゆう"],[33,1,"にく"],[35,1,"はこ"],[44,1,"かれ"],[48,1,"かわ"],[50,1,"みず"],[52,1,"の"]],"text":"すると、からすが朝ごとに彼の所にパンと肉を運び、また夕ごとにパンと肉を運んできた。そして彼はその川の水を飲んだ。"},{"ref":"1Kgs.17.7","start":11017007,"end":11017007,"break":"none","ruby":[[3,1,"くに"],[5,1,"あめ"],[22,1,"かわ"]],"text":"しかし国に雨がなかったので、しばらくしてその川はかれた。"},{"ref":"1Kgs.17.8","start":11017008,"end":11017008,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,2,"ことば"],[9,1,"かれ"],[11,1,"のぞ"],[14,1,"い"]],"text":"その時、主の言葉が彼に臨んで言った、"},{"ref":"1Kgs.17.9","start":11017009,"end":11017009,"break":"none","ruby":[[1,1,"た"],[8,1,"ぞく"],[16,1,"い"],[23,1,"す"],[42,1,"おんな"],[44,1,"めい"],[51,1,"やしな"]],"text":"「立ってシドンに属するザレパテへ行って、そこに住みなさい。わたしはそのところのやもめ女に命じてあなたを養わせよう」。"},{"ref":"1Kgs.17.10","start":11017010,"end":11017010,"break":"none","ruby":[[3,1,"かれ"],[5,1,"た"],[13,1,"い"],[18,1,"まち"],[20,1,"もん"],[22,1,"つ"],[35,1,"おんな"],[40,1,"ところ"],[46,1,"ひろ"],[52,1,"かれ"],[56,1,"おんな"],[58,1,"こえ"],[63,1,"い"],[68,1,"うつわ"],[70,1,"みず"],[72,1,"すこ"],[74,1,"も"],[84,1,"の"]],"text":"そこで彼は立ってザレパテへ行ったが、町の門に着いたとき、ひとりのやもめ女が、その所でたきぎを拾っていた。彼はその女に声をかけて言った、「器に水を少し持ってきて、わたしに飲ませてください」。"},{"ref":"1Kgs.17.11","start":11017011,"end":11017011,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"い"],[10,1,"も"],[19,1,"とき"],[21,1,"かれ"],[23,2,"かのじょ"],[26,1,"よ"],[29,1,"い"],[34,1,"て"],[36,2,"ひとくち"],[42,1,"も"]],"text":"彼女が行って、それを持ってこようとした時、彼は彼女を呼んで言った、「手に一口のパンを持ってきてください」。"},{"ref":"1Kgs.17.12","start":11017012,"end":11017012,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"い"],[12,1,"かみ"],[14,1,"しゅ"],[16,1,"い"],[45,2,"ひとにぎ"],[49,1,"こな"],[55,1,"すこ"],[58,1,"あぶら"],[67,1,"いま"],[78,1,"ぼん"],[80,1,"ひろ"],[86,1,"かえ"],[94,2,"こども"],[103,2,"ちょうり"],[110,1,"た"],[113,1,"し"]],"text":"彼女は言った、「あなたの神、主は生きておられます。わたしにはパンはありません。ただ、かめに一握りの粉と、びんに少しの油があるだけです。今わたしはたきぎ二、三本を拾い、うちへ帰って、わたしと子供のためにそれを調理し、それを食べて死のうとしているのです」。"},{"ref":"1Kgs.17.13","start":11017013,"end":11017013,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"い"],[12,1,"おそ"],[23,1,"い"],[31,1,"い"],[59,1,"ちい"],[68,1,"つく"],[71,1,"も"],[81,1,"のち"],[92,2,"こども"],[98,1,"つく"]],"text":"エリヤは彼女に言った、「恐れるにはおよばない。行って、あなたが言ったとおりにしなさい。しかしまず、それでわたしのために小さいパンを、一つ作って持ってきなさい。その後、あなたと、あなたの子供のために作りなさい。"},{"ref":"1Kgs.17.14","start":11017014,"end":11017014,"break":"none","ruby":[[1,1,"しゅ"],[3,1,"あめ"],[5,1,"ち"],[11,1,"ふ"],[14,1,"ひ"],[21,1,"こな"],[23,1,"つ"],[30,1,"あぶら"],[32,1,"た"],[44,1,"かみ"],[46,1,"しゅ"],[48,1,"い"]],"text":"『主が雨を地のおもてに降らす日まで、かめの粉は尽きず、びんの油は絶えない』とイスラエルの神、主が言われるからです」。"},{"ref":"1Kgs.17.15","start":11017015,"end":11017015,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"い"],[11,1,"い"],[21,2,"かのじょ"],[24,1,"かれ"],[28,2,"かのじょ"],[31,2,"かぞく"],[34,1,"ひさ"],[37,1,"た"]],"text":"彼女は行って、エリヤが言ったとおりにした。彼女と彼および彼女の家族は久しく食べた。"},{"ref":"1Kgs.17.16","start":11017016,"end":11017016,"break":"none","ruby":[[0,1,"しゅ"],[9,1,"い"],[13,2,"ことば"],[23,1,"こな"],[25,1,"つ"],[32,1,"あぶら"],[34,1,"た"]],"text":"主がエリヤによって言われた言葉のように、かめの粉は尽きず、びんの油は絶えなかった。"},{"ref":"1Kgs.17.17","start":11017017,"end":11017017,"break":"paragraph","ruby":[[4,1,"こと"],[6,1,"のち"],[10,1,"いえ"],[12,2,"しゅふ"],[19,1,"おんな"],[21,1,"おとこ"],[23,1,"こ"],[25,2,"びょうき"],[34,2,"びょうき"],[41,1,"おも"],[44,1,"いき"],[46,1,"た"]],"text":"これらの事の後、その家の主婦であるこの女の男の子が病気になった。その病気はたいそう重く、息が絶えたので、"},{"ref":"1Kgs.17.18","start":11017018,"end":11017018,"break":"none","ruby":[[0,2,"かのじょ"],[7,1,"い"],[12,1,"かみ"],[14,1,"ひと"],[26,1,"なに"],[28,1,"うら"],[46,1,"つみ"],[48,1,"おも"],[50,1,"だ"],[63,1,"こ"],[65,1,"し"]],"text":"彼女はエリヤに言った、「神の人よ、あなたはわたしに、何の恨みがあるのですか。あなたはわたしの罪を思い出させるため、またわたしの子を死なせるためにおいでになったのですか」。"},{"ref":"1Kgs.17.19","start":11017019,"end":11017019,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"い"],[12,1,"こ"],[29,2,"かのじょ"],[38,2,"こども"],[41,1,"と"],[44,2,"じぶん"],[49,2,"おくじょう"],[59,1,"のぼ"],[62,2,"じぶん"],[65,2,"しんだい"],[68,1,"ね"]],"text":"エリヤは彼女に言った、「子をわたしによこしなさい」。そして彼女のふところから子供を取り、自分のいる屋上のへやへかかえて上り、自分の寝台に寝かせ、"},{"ref":"1Kgs.17.20","start":11017020,"end":11017020,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"よ"],[7,1,"い"],[14,1,"かみ"],[16,1,"しゅ"],[27,1,"やど"],[32,1,"いえ"],[40,1,"わざわい"],[47,2,"こども"],[50,1,"ころ"]],"text":"主に呼ばわって言った、「わが神、主よ、あなたはわたしが宿っている家のやもめにさえ災をくだして、子供を殺されるのですか」。"},{"ref":"1Kgs.17.21","start":11017021,"end":11017021,"break":"none","ruby":[[4,1,"ど"],[7,1,"こ"],[8,1,"とも"],[10,1,"うえ"],[12,1,"み"],[14,1,"の"],[18,1,"しゅ"],[20,1,"よ"],[25,1,"い"],[32,1,"かみ"],[34,1,"しゅ"],[39,2,"こども"],[42,1,"たましい"],[47,1,"かえ"]],"text":"そして三度その子供の上に身を伸ばし、主に呼ばわって言った、「わが神、主よ、この子供の魂をもとに帰らせてください」。"},{"ref":"1Kgs.17.22","start":11017022,"end":11017022,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"こえ"],[8,1,"き"],[20,1,"こ"],[21,1,"とも"],[23,1,"たましい"],[28,1,"かえ"],[32,1,"かれ"],[34,1,"い"]],"text":"主はエリヤの声を聞きいれられたので、その子供の魂はもとに帰って、彼は生きかえった。"},{"ref":"1Kgs.17.23","start":11017023,"end":11017023,"break":"none","ruby":[[6,1,"こ"],[7,1,"とも"],[9,1,"と"],[12,2,"おくじょう"],[19,1,"いえ"],[21,1,"なか"],[26,1,"ふ"],[31,1,"はは"],[37,1,"い"],[53,1,"こ"],[55,1,"い"]],"text":"エリヤはその子供を取って屋上のへやから家の中につれて降り、その母にわたして言った、「ごらんなさい。あなたの子は生きかえりました」。"},{"ref":"1Kgs.17.24","start":11017024,"end":11017024,"break":"none","ruby":[[0,1,"おんな"],[6,1,"い"],[11,1,"いま"],[20,1,"かみ"],[22,1,"ひと"],[34,1,"くち"],[38,1,"しゅ"],[40,2,"ことば"],[43,2,"しんじつ"],[51,1,"し"]],"text":"女はエリヤに言った、「今わたしはあなたが神の人であることと、あなたの口にある主の言葉が真実であることを知りました」。"}]