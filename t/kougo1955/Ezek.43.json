[{"ref":"Ezek.43.1","start":26043001,"end":26043001,"break":"paragraph","ruby":[[2,1,"のち"],[4,1,"かれ"],[10,1,"もん"],[12,1,"みちび"],[16,1,"もん"],[18,1,"ひがし"],[20,1,"めん"]],"text":"その後、彼はわたしを門に導いた。門は東に面していた。"},{"ref":"Ezek.43.2","start":26043002,"end":26043002,"break":"none","ruby":[[2,1,"とき"],[4,1,"み"],[13,1,"かみ"],[15,2,"えいこう"],[19,1,"ひがし"],[21,1,"ほう"],[24,1,"き"],[30,1,"く"],[32,1,"ひび"],[36,2,"おおみず"],[39,1,"ひび"],[46,1,"ち"],[50,2,"えいこう"],[53,1,"かがや"]],"text":"その時、見よ、イスラエルの神の栄光が、東の方から来たが、その来る響きは、大水の響きのようで、地はその栄光で輝いた。"},{"ref":"Ezek.43.3","start":26043003,"end":26043003,"break":"none","ruby":[[4,1,"み"],[6,1,"まぼろし"],[8,1,"よう"],[11,1,"かれ"],[15,1,"まち"],[17,1,"ほろ"],[21,1,"き"],[23,1,"とき"],[30,1,"み"],[32,1,"まぼろし"],[34,2,"どうよう"],[50,1,"がわ"],[56,1,"み"],[58,1,"まぼろし"],[74,1,"かお"],[76,1,"ふ"]],"text":"わたしが見た幻の様は、彼がこの町を滅ぼしに来た時に、わたしが見た幻と同様で、これはまたわたしがケバル川のほとりで見た幻のようであった。それでわたしは顔を伏せた。"},{"ref":"Ezek.43.4","start":26043004,"end":26043004,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"えいこう"],[6,1,"ひがし"],[8,1,"ほう"],[10,1,"めん"],[13,1,"もん"],[15,1,"みち"],[18,1,"みや"],[24,1,"とき"]],"text":"主の栄光が、東の方に面した門の道から宮にはいった時、"},{"ref":"Ezek.43.5","start":26043005,"end":26043005,"break":"none","ruby":[[0,1,"れい"],[6,1,"ひ"],[8,1,"あ"],[12,2,"うちにわ"],[15,1,"みちび"],[17,1,"い"],[22,1,"み"],[25,1,"しゅ"],[27,2,"えいこう"],[30,1,"みや"],[32,1,"み"]],"text":"霊がわたしを引き上げて、内庭に導き入れると、見よ、主の栄光が宮に満ちた。"},{"ref":"Ezek.43.6","start":26043006,"end":26043006,"break":"paragraph","ruby":[[2,1,"ひと"],[13,1,"た"],[16,1,"とき"],[26,1,"ひと"],[29,1,"みや"],[31,1,"なか"],[38,1,"かた"],[42,1,"き"]],"text":"その人がわたしのかたわらに立った時、わたしはひとりの人が、宮の中からわたしに語るのを聞いた。"},{"ref":"Ezek.43.7","start":26043007,"end":26043007,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[11,1,"ひと"],[13,1,"こ"],[23,1,"くらい"],[27,1,"ところ"],[33,1,"あし"],[35,1,"うら"],[37,1,"ふ"],[39,1,"ところ"],[45,2,"えいきゅう"],[54,2,"ひとびと"],[57,1,"なか"],[59,1,"す"],[61,1,"ところ"],[74,1,"いえ"],[77,1,"たみ"],[81,1,"おう"],[86,1,"ふたた"],[88,2,"かんいん"],[92,1,"おう"],[96,2,"したい"],[106,1,"せい"],[109,1,"な"],[111,1,"けが"]],"text":"彼はわたしに言った、「人の子よ、これはわたしの位のある所、わたしの足の裏の踏む所、わたしが永久にイスラエルの人々の中に住む所である。またイスラエルの家は、民もその王たちも、再び姦淫と、王たちの死体とをもって、わが聖なる名を汚さない。"},{"ref":"Ezek.43.8","start":26043008,"end":26043008,"break":"none","ruby":[[0,1,"かれ"],[5,2,"しきい"],[11,2,"しきい"],[19,1,"もう"],[24,2,"もんちゅう"],[30,2,"もんちゅう"],[38,1,"もう"],[48,1,"かれ"],[52,1,"あいだ"],[60,1,"かべ"],[73,1,"かれ"],[79,1,"おか"],[82,1,"にく"],[86,1,"こと"],[94,1,"せい"],[97,1,"な"],[99,1,"けが"],[109,1,"いか"],[119,1,"ほろ"]],"text":"彼らはその敷居を、わが敷居のかたわらに設け、その門柱を、わが門柱のかたわらに設けたので、わたしと彼らとの間には、わずかに壁があるのみである。そして彼らは、その犯した憎むべき事をもって、わが聖なる名を汚したので、わたしは怒りをもって、これを滅ぼした。"},{"ref":"Ezek.43.9","start":26043009,"end":26043009,"break":"none","ruby":[[0,1,"いま"],[1,1,"かれ"],[4,1,"めい"],[7,2,"かんいん"],[13,1,"おう"],[17,2,"したい"],[26,1,"とお"],[28,1,"す"],[30,1,"のぞ"],[45,2,"えいきゅう"],[48,1,"かれ"],[51,1,"なか"],[53,1,"す"]],"text":"今彼らに命じて姦淫と、その王たちの死体を、わたしから遠く取り除かせよ。そうしたら、わたしは永久に彼らの中に住む。"},{"ref":"Ezek.43.10","start":26043010,"end":26043010,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[5,1,"みや"],[10,2,"がいけい"],[14,2,"せっけい"],[24,1,"いえ"],[26,1,"しめ"],[29,1,"かれ"],[34,1,"あく"],[36,1,"は"]],"text":"人の子よ、宮と、その外形と、設計とをイスラエルの家に示せ。彼らはその悪を恥じるであろう。"},{"ref":"Ezek.43.11","start":26043011,"end":26043011,"break":"none","ruby":[[0,1,"かれ"],[5,1,"おか"],[12,1,"こと"],[14,1,"は"],[19,1,"かれ"],[25,1,"みや"],[27,1,"た"],[29,1,"かた"],[31,2,"せつび"],[34,2,"でぐち"],[37,2,"いりぐち"],[44,2,"けいしき"],[59,2,"きてい"],[62,1,"しめ"],[68,1,"かれ"],[71,1,"め"],[73,1,"まえ"],[75,1,"か"],[78,1,"かれ"],[87,2,"きてい"],[96,1,"まも"],[98,1,"おこな"]],"text":"彼らがその犯したすべての事を恥じたら、彼らに、この宮の建て方、設備、出口、入口、すべての形式、すべてのおきて、すべての規定を示せ。これを彼らの目の前に書き、彼らにそのすべての規定と、おきてとを守り行わせよ。"},{"ref":"Ezek.43.12","start":26043012,"end":26043012,"break":"none","ruby":[[0,1,"みや"],[2,2,"きてい"],[11,1,"やま"],[13,1,"いただき"],[15,2,"しほう"],[18,2,"ちいき"],[23,1,"もっと"],[25,1,"せい"],[30,1,"み"],[36,1,"みや"],[38,2,"きてい"]],"text":"宮の規定はこれである。山の頂の四方の地域はみな最も聖である。見よ、これは宮の規定である。"},{"ref":"Ezek.43.13","start":26043013,"end":26043013,"break":"paragraph","ruby":[[0,2,"さいだん"],[3,2,"すんぽう"],[15,1,"つぎ"],[37,1,"ひと"],[38,1,"て"],[39,1,"はば"],[45,2,"どだい"],[48,1,"たか"],[56,1,"はば"],[65,2,"しゅうい"],[68,1,"ふち"],[70,1,"はん"]],"text":"祭壇の寸法はキュビトですれば、次のようである。（そのキュビトは一キュビトと一手幅である。）土台は高さ一キュビト、幅一キュビト、その周囲の縁は半キュビトである。"},{"ref":"Ezek.43.14","start":26043014,"end":26043014,"break":"none","ruby":[[0,2,"さいだん"],[3,1,"たか"],[7,1,"つぎ"],[16,2,"じめん"],[19,2,"どだい"],[23,1,"した"],[36,1,"はば"],[46,1,"ちい"],[54,1,"おお"],[70,1,"はば"]],"text":"祭壇の高さは、次のとおりである。地面の土台から下のかさねまで二キュビト、幅は一キュビト、また小さいかさねから大きいかさねまで四キュビト、その幅は一キュビトである。"},{"ref":"Ezek.43.15","start":26043015,"end":26043015,"break":"none","ruby":[[0,2,"さいだん"],[3,1,"ろ"],[12,2,"さいだん"],[15,1,"ろ"],[18,1,"たか"],[26,1,"つの"],[29,1,"ほん"],[30,1,"で"]],"text":"祭壇の炉は四キュビトで、祭壇の炉から高さ一キュビトの角が四本出ていた。"},{"ref":"Ezek.43.16","start":26043016,"end":26043016,"break":"none","ruby":[[0,1,"ろ"],[2,1,"なが"],[11,1,"はば"],[20,2,"かくけい"]],"text":"炉は長さ十二キュビト、幅十二キュビトの四角形である。"},{"ref":"Ezek.43.17","start":26043017,"end":26043017,"break":"none","ruby":[[6,2,"しほう"],[10,1,"なが"],[19,1,"はば"],[28,2,"かくけい"],[33,2,"しゅうい"],[36,1,"ふち"],[38,1,"はば"],[39,1,"はん"],[47,1,"だい"],[49,2,"しほう"],[59,2,"かいだん"],[62,1,"ひがし"],[64,1,"めん"]],"text":"そのかさねは四方とも長さ十四キュビト、幅十四キュビトの四角形、その周囲の縁は幅半キュビト、その台は四方一キュビト、その階段は東に面する」。"},{"ref":"Ezek.43.18","start":26043018,"end":26043018,"break":"paragraph","ruby":[[0,1,"かれ"],[6,1,"い"],[11,1,"ひと"],[13,1,"こ"],[16,1,"しゅ"],[19,1,"かみ"],[23,1,"い"],[28,2,"さいだん"],[31,1,"た"],[36,1,"うえ"],[38,2,"はんさい"],[48,1,"ち"],[50,1,"そそ"],[52,1,"ひ"],[56,1,"つぎ"],[61,2,"さいだん"],[64,1,"さだ"]],"text":"彼はわたしに言った、「人の子よ、主なる神はこう言われる、祭壇を建て、その上に燔祭をささげ、これに血を注ぐ日には、次のことを祭壇の定めとせよ。"},{"ref":"Ezek.43.19","start":26043019,"end":26043019,"break":"none","ruby":[[4,1,"しゅ"],[7,1,"かみ"],[9,1,"い"],[18,2,"しそん"],[26,1,"ちか"],[28,1,"つか"],[38,2,"さいし"],[43,2,"ざいさい"],[49,2,"おうし"],[52,1,"こ"],[54,1,"あた"]],"text":"すなわち主なる神は言われる、ザドクの子孫で、わたしに近く仕えるレビびとである祭司には、罪祭のために雄牛の子を与えよ。"},{"ref":"Ezek.43.20","start":26043020,"end":26043020,"break":"none","ruby":[[4,1,"ち"],[13,2,"さいだん"],[19,1,"つの"],[31,2,"しゅうい"],[34,1,"ふち"],[36,1,"ぬ"],[40,2,"さいだん"],[43,1,"きよ"]],"text":"またその血をとって、これを祭壇の四つの角と、かさねの四すみと、周囲の縁に塗って、祭壇を清め、これをあがなえ。"},{"ref":"Ezek.43.21","start":26043021,"end":26043021,"break":"none","ruby":[[6,2,"ざいさい"],[9,1,"うし"],[18,2,"せいじょ"],[21,1,"そと"],[23,1,"みや"],[28,1,"さだ"],[33,1,"ところ"],[35,1,"や"]],"text":"あなたはまた罪祭の牛をとって、これを聖所の外、宮のうちの定められた所で焼け。"},{"ref":"Ezek.43.22","start":26043022,"end":26043022,"break":"none","ruby":[[0,1,"だい"],[2,1,"にち"],[9,2,"むきず"],[12,1,"お"],[17,2,"ざいさい"],[31,2,"おうし"],[34,1,"きよ"],[44,2,"さいだん"],[47,1,"きよ"]],"text":"第二日に、あなたは無傷の雄やぎを、罪祭としてささげよ。すなわち雄牛で清めたように、これで祭壇を清めよ。"},{"ref":"Ezek.43.23","start":26043023,"end":26043023,"break":"none","ruby":[[0,1,"きよ"],[5,1,"お"],[11,2,"むきず"],[14,2,"おうし"],[17,1,"こ"],[20,1,"む"],[23,1,"なか"],[25,2,"むきず"],[28,2,"おひつじ"]],"text":"清めごとを終えたなら、無傷の雄牛の子と、群れの中の無傷の雄羊とをささげよ。"},{"ref":"Ezek.43.24","start":26043024,"end":26043024,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"まえ"],[7,1,"も"],[13,2,"さいし"],[19,1,"うえ"],[21,1,"しお"],[30,2,"はんさい"],[35,1,"しゅ"]],"text":"これを主の前に持ってきて、祭司らはその上に塩をまき、これらを燔祭として主にささげよ。"},{"ref":"Ezek.43.25","start":26043025,"end":26043025,"break":"none","ruby":[[0,2,"なぬか"],[3,1,"あいだ"],[9,2,"ひび"],[11,1,"お"],[15,2,"ざいさい"],[23,2,"おうし"],[26,1,"こ"],[29,1,"む"],[32,1,"なか"],[34,2,"おひつじ"],[38,2,"むきず"]],"text":"七日の間、あなたは日々雄やぎを罪祭とせよ。また雄牛の子と、群れの中の雄羊との無傷のものをととのえ、"},{"ref":"Ezek.43.26","start":26043026,"end":26043026,"break":"none","ruby":[[0,2,"なぬか"],[3,1,"あいだ"],[5,1,"かれ"],[8,2,"さいだん"],[19,1,"きよ"],[25,2,"せいべつ"]],"text":"七日の間、彼らは祭壇をあがない、これを清め、これを聖別しなければならない。"},{"ref":"Ezek.43.27","start":26043027,"end":26043027,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ひ"],[9,1,"み"],[16,2,"ようか"],[18,1,"め"],[21,1,"のち"],[24,2,"さいし"],[36,2,"はんさい"],[40,3,"しゅうおんさい"],[45,2,"さいだん"],[48,1,"うえ"],[50,1,"そな"],[71,1,"う"],[78,1,"しゅ"],[81,1,"かみ"],[83,1,"い"]],"text":"彼らがこれらの日を満たしたとき、八日目から後は、祭司たちは、あなたがたの燔祭と、酬恩祭とを祭壇の上に供える。そうすれば、わたしは、あなたがたを受けいれると、主なる神は言われる」。"}]