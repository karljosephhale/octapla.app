[{"ref":"Rev.14.1","start":66014001,"end":66014001,"break":"paragraph","ruby":[[7,1,"み"],[13,1,"み"],[16,2,"こひつじ"],[23,1,"やま"],[25,1,"た"],[40,2,"ひとびと"],[43,2,"こひつじ"],[46,1,"とも"],[53,1,"ひたい"],[55,2,"こひつじ"],[58,1,"な"],[62,1,"ちち"],[64,1,"な"],[67,1,"か"]],"text":"なお、わたしが見ていると、見よ、小羊がシオンの山に立っていた。また、十四万四千の人々が小羊と共におり、その額に小羊の名とその父の名とが書かれていた。"},{"ref":"Rev.14.2","start":66014002,"end":66014002,"break":"none","ruby":[[7,2,"おおみず"],[19,1,"はげ"],[22,2,"らいめい"],[28,1,"こえ"],[31,1,"てん"],[34,1,"で"],[38,1,"き"],[46,1,"き"],[51,1,"こえ"],[54,1,"こと"],[58,1,"ひと"],[60,2,"たてごと"],[65,1,"おと"]],"text":"またわたしは、大水のとどろきのような、激しい雷鳴のような声が、天から出るのを聞いた。わたしの聞いたその声は、琴をひく人が立琴をひく音のようでもあった。"},{"ref":"Rev.14.3","start":66014003,"end":66014003,"break":"none","ruby":[[0,1,"かれ"],[4,2,"みざ"],[7,1,"まえ"],[12,1,"い"],[14,1,"もの"],[16,2,"ちょうろう"],[22,1,"まえ"],[25,1,"あたら"],[28,1,"うた"],[30,1,"うた"],[36,1,"うた"],[39,1,"ち"],[53,1,"にん"],[62,1,"まな"]],"text":"彼らは、御座の前、四つの生き物と長老たちとの前で、新しい歌を歌った。この歌は、地からあがなわれた十四万四千人のほかは、だれも学ぶことができなかった。"},{"ref":"Rev.14.4","start":66014004,"end":66014004,"break":"none","ruby":[[0,1,"かれ"],[4,1,"おんな"],[14,1,"もの"],[19,1,"かれ"],[23,2,"じゅんけつ"],[26,1,"もの"],[35,2,"こひつじ"],[38,1,"い"],[40,1,"ところ"],[52,1,"い"],[55,1,"かれ"],[59,1,"かみ"],[61,2,"こひつじ"],[71,2,"はつほ"],[77,2,"にんげん"],[80,1,"なか"],[89,1,"もの"]],"text":"彼らは、女にふれたことのない者である。彼らは、純潔な者である。そして、小羊の行く所へは、どこへでもついて行く。彼らは、神と小羊とにささげられる初穂として、人間の中からあがなわれた者である。"},{"ref":"Rev.14.5","start":66014005,"end":66014005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"くち"],[6,1,"いつわ"],[12,1,"かれ"],[15,1,"きず"],[19,1,"もの"]],"text":"彼らの口には偽りがなく、彼らは傷のない者であった。"},{"ref":"Rev.14.6","start":66014006,"end":66014006,"break":"paragraph","ruby":[[11,2,"みつかい"],[14,2,"なかぞら"],[17,1,"と"],[21,1,"み"],[24,1,"かれ"],[26,1,"ち"],[28,1,"す"],[30,1,"もの"],[41,2,"こくみん"],[44,2,"ぶぞく"],[47,2,"こくご"],[50,2,"みんぞく"],[53,1,"の"],[55,1,"つた"],[62,2,"えいえん"],[65,2,"ふくいん"]],"text":"わたしは、もうひとりの御使が中空を飛ぶのを見た。彼は地に住む者、すなわち、あらゆる国民、部族、国語、民族に宣べ伝えるために、永遠の福音をたずさえてきて、"},{"ref":"Rev.14.7","start":66014007,"end":66014007,"break":"none","ruby":[[0,2,"おおごえ"],[3,1,"い"],[8,1,"かみ"],[14,1,"かみ"],[16,2,"えいこう"],[19,1,"き"],[23,1,"かみ"],[29,1,"とき"],[39,1,"てん"],[41,1,"ち"],[43,1,"うみ"],[45,1,"みず"],[47,1,"みなもと"],[50,1,"つく"],[58,1,"ふ"],[60,1,"おが"]],"text":"大声で言った、「神をおそれ、神に栄光を帰せよ。神のさばきの時がきたからである。天と地と海と水の源とを造られたかたを、伏し拝め」。"},{"ref":"Rev.14.8","start":66014008,"end":66014008,"break":"paragraph","ruby":[[6,1,"だい"],[9,2,"みつかい"],[13,1,"つづ"],[18,1,"い"],[23,1,"たお"],[27,1,"おお"],[36,1,"たお"],[42,3,"ふひんこう"],[46,1,"たい"],[49,1,"はげ"],[52,1,"いか"],[58,1,"しゅ"],[65,2,"こくみん"],[68,1,"の"],[72,1,"もの"]],"text":"また、ほかの第二の御使が、続いてきて言った、「倒れた、大いなるバビロンは倒れた。その不品行に対する激しい怒りのぶどう酒を、あらゆる国民に飲ませた者」。"},{"ref":"Rev.14.9","start":66014009,"end":66014009,"break":"paragraph","ruby":[[3,1,"だい"],[6,2,"みつかい"],[9,1,"かれ"],[12,1,"つづ"],[18,2,"おおごえ"],[21,1,"い"],[31,1,"けもの"],[35,1,"ぞう"],[38,1,"おが"],[41,1,"ひたい"],[43,1,"て"],[45,2,"こくいん"],[48,1,"う"],[51,1,"もの"]],"text":"ほかの第三の御使が彼らに続いてきて、大声で言った、「おおよそ、獣とその像とを拝み、額や手に刻印を受ける者は、"},{"ref":"Rev.14.10","start":66014010,"end":66014010,"break":"none","ruby":[[0,1,"かみ"],[2,1,"いか"],[5,1,"さかずき"],[7,1,"ま"],[14,1,"も"],[19,1,"かみ"],[21,1,"はげ"],[24,1,"いか"],[30,1,"しゅ"],[32,1,"の"],[35,1,"せい"],[38,2,"みつかい"],[43,2,"こひつじ"],[47,1,"まえ"],[50,1,"ひ"],[52,2,"いおう"],[56,1,"くる"]],"text":"神の怒りの杯に混ぜものなしに盛られた、神の激しい怒りのぶどう酒を飲み、聖なる御使たちと小羊との前で、火と硫黄とで苦しめられる。"},{"ref":"Rev.14.11","start":66014011,"end":66014011,"break":"none","ruby":[[2,1,"くる"],[6,1,"けむり"],[8,2,"よよ"],[10,1,"かぎ"],[14,1,"た"],[24,1,"けもの"],[28,1,"ぞう"],[31,1,"おが"],[33,1,"もの"],[44,1,"な"],[46,2,"こくいん"],[49,1,"う"],[54,1,"もの"],[57,1,"ひる"],[59,1,"よる"],[61,1,"やす"],[64,1,"え"]],"text":"その苦しみの煙は世々限りなく立ちのぼり、そして、獣とその像とを拝む者、また、だれでもその名の刻印を受けている者は、昼も夜も休みが得られない。"},{"ref":"Rev.14.12","start":66014012,"end":66014012,"break":"none","ruby":[[4,1,"かみ"],[6,1,"いまし"],[9,1,"まも"],[16,1,"しん"],[19,2,"しんこう"],[22,1,"も"],[28,2,"せいと"],[31,2,"にんたい"]],"text":"ここに、神の戒めを守り、イエスを信じる信仰を持ちつづける聖徒の忍耐がある」。"},{"ref":"Rev.14.13","start":66014013,"end":66014013,"break":"paragraph","ruby":[[7,1,"てん"],[11,1,"こえ"],[15,1,"い"],[19,1,"き"],[24,1,"か"],[31,1,"いま"],[34,1,"のち"],[36,1,"しゅ"],[41,1,"し"],[43,2,"しにん"],[56,2,"みたま"],[59,1,"い"],[67,1,"かれ"],[72,2,"ろうく"],[75,1,"と"],[79,1,"やす"],[87,1,"かれ"]],"text":"またわたしは、天からの声がこう言うのを聞いた、「書きしるせ、『今から後、主にあって死ぬ死人はさいわいである』」。御霊も言う、「しかり、彼らはその労苦を解かれて休み、そのわざは彼らについていく」。"},{"ref":"Rev.14.14","start":66014014,"end":66014014,"break":"paragraph","ruby":[[2,1,"み"],[8,1,"み"],[11,1,"しろ"],[13,1,"くも"],[21,1,"くも"],[23,1,"うえ"],[25,1,"ひと"],[27,1,"こ"],[32,1,"もの"],[34,1,"ざ"],[40,1,"あたま"],[43,1,"きん"],[45,1,"かんむり"],[52,1,"て"],[55,1,"するど"],[60,1,"も"]],"text":"また見ていると、見よ、白い雲があって、その雲の上に人の子のような者が座しており、頭には金の冠をいただき、手には鋭いかまを持っていた。"},{"ref":"Rev.14.15","start":66014015,"end":66014015,"break":"none","ruby":[[10,2,"みつかい"],[13,2,"せいじょ"],[17,1,"で"],[22,1,"くも"],[24,1,"うえ"],[26,1,"ざ"],[31,1,"もの"],[37,2,"おおごえ"],[40,1,"さけ"],[48,1,"い"],[51,1,"か"],[53,1,"と"],[59,1,"ち"],[61,2,"こくもつ"],[64,1,"まった"],[66,1,"みの"],[69,1,"か"],[71,1,"と"],[75,1,"とき"]],"text":"すると、もうひとりの御使が聖所から出てきて、雲の上に座している者にむかって大声で叫んだ、「かまを入れて刈り取りなさい。地の穀物は全く実り、刈り取るべき時がきた」。"},{"ref":"Rev.14.16","start":66014016,"end":66014016,"break":"none","ruby":[[0,1,"くも"],[2,1,"うえ"],[4,1,"ざ"],[9,1,"もの"],[17,1,"ち"],[19,1,"な"],[21,1,"い"],[29,1,"ち"],[34,1,"か"],[36,1,"と"]],"text":"雲の上に座している者は、そのかまを地に投げ入れた。すると、地のものが刈り取られた。"},{"ref":"Rev.14.17","start":66014017,"end":66014017,"break":"paragraph","ruby":[[9,2,"みつかい"],[13,1,"てん"],[15,2,"せいじょ"],[19,1,"で"],[25,1,"かれ"],[29,1,"するど"],[34,1,"も"]],"text":"また、もうひとりの御使が、天の聖所から出てきたが、彼もまた鋭いかまを持っていた。"},{"ref":"Rev.14.18","start":66014018,"end":66014018,"break":"none","ruby":[[10,2,"みつかい"],[14,1,"ひ"],[16,2,"しはい"],[20,2,"けんい"],[23,1,"も"],[28,1,"もの"],[31,2,"さいだん"],[35,1,"で"],[40,1,"するど"],[45,1,"も"],[47,2,"みつかい"],[54,2,"おおごえ"],[57,1,"い"],[64,1,"するど"],[69,1,"ち"],[71,1,"い"],[75,1,"ち"],[84,1,"か"],[86,1,"あつ"],[96,1,"み"],[101,1,"じゅく"]],"text":"さらに、もうひとりの御使で、火を支配する権威を持っている者が、祭壇から出てきて、鋭いかまを持つ御使にむかい、大声で言った、「その鋭いかまを地に入れて、地のぶどうのふさを刈り集めなさい。ぶどうの実がすでに熟しているから」。"},{"ref":"Rev.14.19","start":66014019,"end":66014019,"break":"none","ruby":[[4,2,"みつかい"],[12,1,"ち"],[14,1,"な"],[16,1,"い"],[20,1,"ち"],[26,1,"か"],[28,1,"あつ"],[31,1,"かみ"],[33,1,"はげ"],[36,1,"いか"],[39,1,"おお"],[42,1,"さか"],[46,1,"な"],[48,1,"こ"]],"text":"そこで、御使はそのかまを地に投げ入れて、地のぶどうを刈り集め、神の激しい怒りの大きな酒ぶねに投げ込んだ。"},{"ref":"Rev.14.20","start":66014020,"end":66014020,"break":"none","ruby":[[6,1,"さか"],[10,1,"みやこ"],[12,1,"そと"],[14,1,"ふ"],[23,1,"ち"],[25,1,"さか"],[30,1,"なが"],[32,1,"で"],[35,1,"うま"],[54,1,"ちょう"]],"text":"そして、その酒ぶねが都の外で踏まれた。すると、血が酒ぶねから流れ出て、馬のくつわにとどくほどになり、一千六百丁にわたってひろがった。"}]