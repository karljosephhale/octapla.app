[{"ref":"Acts.12.1","start":44012001,"end":44012001,"break":"paragraph","ruby":[[8,1,"おう"],[10,2,"きょうかい"],[15,1,"もの"],[19,2,"あっぱく"],[22,1,"て"]],"text":"そのころ、ヘロデ王は教会のある者たちに圧迫の手をのばし、"},{"ref":"Acts.12.2","start":44012002,"end":44012002,"break":"none","ruby":[[4,2,"きょうだい"],[14,1,"き"],[16,1,"ころ"]],"text":"ヨハネの兄弟ヤコブをつるぎで切り殺した。"},{"ref":"Acts.12.3","start":44012003,"end":44012003,"break":"none","ruby":[[10,1,"じん"],[14,1,"い"],[22,1,"み"],[33,1,"とら"],[44,3,"じょこうさい"],[48,1,"とき"]],"text":"そして、それがユダヤ人たちの意にかなったのを見て、さらにペテロをも捕えにかかった。それは除酵祭の時のことであった。"},{"ref":"Acts.12.4","start":44012004,"end":44012004,"break":"none","ruby":[[8,1,"とら"],[11,1,"ごく"],[13,1,"とう"],[17,1,"にん"],[19,1,"くみ"],[21,2,"へいそつ"],[24,1,"くみ"],[26,1,"ひ"],[28,1,"わた"],[32,2,"みは"],[43,2,"すぎこし"],[46,1,"まつり"],[52,1,"かれ"],[54,2,"みんしゅう"],[57,1,"まえ"],[59,1,"ひ"],[61,1,"だ"]],"text":"ヘロデはペテロを捕えて獄に投じ、四人一組の兵卒四組に引き渡して、見張りをさせておいた。過越の祭のあとで、彼を民衆の前に引き出すつもりであったのである。"},{"ref":"Acts.12.5","start":44012005,"end":44012005,"break":"none","ruby":[[9,1,"ごく"],[11,1,"い"],[19,2,"きょうかい"],[24,1,"かれ"],[29,2,"ねっしん"],[32,1,"いのり"],[34,1,"かみ"]],"text":"こうして、ペテロは獄に入れられていた。教会では、彼のために熱心な祈が神にささげられた。"},{"ref":"Acts.12.6","start":44012006,"end":44012006,"break":"paragraph","ruby":[[4,1,"かれ"],[6,1,"ひ"],[8,1,"だ"],[18,1,"よる"],[24,2,"にじゅう"],[27,1,"くさり"],[38,2,"へいそつ"],[41,1,"あいだ"],[43,1,"お"],[47,1,"ねむ"],[53,2,"ばんぺい"],[58,2,"とぐち"],[61,1,"ごく"],[63,2,"みは"]],"text":"ヘロデが彼を引き出そうとしていたその夜、ペテロは二重の鎖につながれ、ふたりの兵卒の間に置かれて眠っていた。番兵たちは戸口で獄を見張っていた。"},{"ref":"Acts.12.7","start":44012007,"end":44012007,"break":"none","ruby":[[4,2,"とつぜん"],[7,1,"しゅ"],[9,1,"つかい"],[14,1,"た"],[17,1,"ひかり"],[19,2,"ごくない"],[22,1,"てら"],[29,2,"みつかい"],[38,1,"ばら"],[44,1,"おこ"],[48,1,"はや"],[50,1,"お"],[60,1,"い"],[67,1,"くさり"],[69,1,"かれ"],[71,2,"りょうて"],[79,1,"お"]],"text":"すると、突然、主の使がそばに立ち、光が獄内を照した。そして御使はペテロのわき腹をつついて起し、「早く起きあがりなさい」と言った。すると鎖が彼の両手から、はずれ落ちた。"},{"ref":"Acts.12.8","start":44012008,"end":44012008,"break":"none","ruby":[[0,2,"みつかい"],[4,1,"おび"],[19,1,"い"],[25,1,"かれ"],[41,2,"うわぎ"],[44,1,"き"],[56,1,"い"]],"text":"御使が「帯をしめ、くつをはきなさい」と言ったので、彼はそのとおりにした。それから「上着を着て、ついてきなさい」と言われたので、"},{"ref":"Acts.12.9","start":44012009,"end":44012009,"break":"none","ruby":[[7,1,"で"],[9,1,"い"],[13,1,"かれ"],[16,2,"みつかい"],[23,2,"げんじつ"],[30,1,"かんが"],[38,1,"まぼろし"],[40,1,"み"],[47,1,"おも"]],"text":"ペテロはついて出て行った。彼には御使のしわざが現実のこととは考えられず、ただ幻を見ているように思われた。"},{"ref":"Acts.12.10","start":44012010,"end":44012010,"break":"none","ruby":[[0,1,"かれ"],[3,1,"だい"],[6,1,"だい"],[9,2,"えいしょ"],[12,1,"とお"],[18,1,"まち"],[20,1,"ぬ"],[23,1,"てつ"],[24,1,"もん"],[30,1,"く"],[42,1,"ひら"],[51,1,"で"],[56,2,"つうろ"],[59,1,"すす"],[67,2,"みつかい"],[70,1,"かれ"],[72,1,"はな"],[74,1,"さ"]],"text":"彼らは第一、第二の衛所を通りすぎて、町に抜ける鉄門のところに来ると、それがひとりでに開いたので、そこを出て一つの通路に進んだとたんに、御使は彼を離れ去った。"},{"ref":"Acts.12.11","start":44012011,"end":44012011,"break":"none","ruby":[[2,1,"とき"],[14,1,"い"],[19,1,"いま"],[38,1,"しゅ"],[40,2,"みつかい"],[53,1,"て"],[62,1,"じん"],[66,1,"ま"],[78,1,"わざわい"],[86,1,"すく"],[88,1,"だ"],[91,1,"くだ"]],"text":"その時ペテロはわれにかえって言った、「今はじめて、ほんとうのことがわかった。主が御使をつかわして、ヘロデの手から、またユダヤ人たちの待ちもうけていたあらゆる災から、わたしを救い出して下さったのだ」。"},{"ref":"Acts.12.12","start":44012012,"end":44012012,"break":"paragraph","ruby":[[18,1,"よ"],[28,1,"はは"],[33,1,"いえ"],[35,1,"い"],[41,1,"いえ"],[44,1,"おお"],[48,1,"ひと"],[50,1,"あつ"],[54,1,"いの"]],"text":"ペテロはこうとわかってから、マルコと呼ばれているヨハネの母マリヤの家に行った。その家には大ぜいの人が集まって祈っていた。"},{"ref":"Acts.12.13","start":44012013,"end":44012013,"break":"none","ruby":[[0,1,"かれ"],[2,1,"もん"],[4,1,"と"],[19,2,"じょちゅう"],[22,2,"とりつ"],[26,1,"で"]],"text":"彼が門の戸をたたいたところ、ロダという女中が取次ぎに出てきたが、"},{"ref":"Acts.12.14","start":44012014,"end":44012014,"break":"none","ruby":[[4,1,"こえ"],[12,1,"よろこ"],[19,1,"もん"],[28,1,"いえ"],[30,1,"か"],[32,1,"こ"],[39,2,"かどぐち"],[42,1,"た"],[48,2,"ほうこく"]],"text":"ペテロの声だとわかると、喜びのあまり、門をあけもしないで家に駆け込み、ペテロが門口に立っていると報告した。"},{"ref":"Acts.12.15","start":44012015,"end":44012015,"break":"none","ruby":[[0,2,"ひとびと"],[8,1,"き"],[10,1,"くる"],[17,1,"い"],[22,2,"かのじょ"],[25,2,"じぶん"],[28,1,"い"],[33,2,"まちが"],[41,1,"い"],[43,1,"は"],[50,1,"かれ"],[63,2,"みつかい"],[70,1,"い"]],"text":"人々は「あなたは気が狂っている」と言ったが、彼女は自分の言うことに間違いはないと、言い張った。そこで彼らは「それでは、ペテロの御使だろう」と言った。"},{"ref":"Acts.12.16","start":44012016,"end":44012016,"break":"none","ruby":[[8,1,"もん"],[20,1,"かれ"],[39,1,"み"],[41,1,"おどろ"]],"text":"しかし、ペテロが門をたたきつづけるので、彼らがあけると、そこにペテロがいたのを見て驚いた。"},{"ref":"Acts.12.17","start":44012017,"end":44012017,"break":"none","ruby":[[4,1,"て"],[6,1,"ふ"],[9,1,"かれ"],[12,1,"しず"],[15,1,"しゅ"],[17,1,"ごく"],[20,1,"かれ"],[22,1,"つ"],[24,1,"だ"],[27,1,"くだ"],[31,2,"しだい"],[34,2,"せつめい"],[52,2,"きょうだい"],[57,1,"つた"],[60,1,"くだ"],[65,1,"い"],[67,1,"のこ"],[77,1,"ところ"],[79,1,"で"],[81,1,"い"]],"text":"ペテロは手を振って彼らを静め、主が獄から彼を連れ出して下さった次第を説明し、「このことを、ヤコブやほかの兄弟たちに伝えて下さい」と言い残して、どこかほかの所へ出て行った。"},{"ref":"Acts.12.18","start":44012018,"end":44012018,"break":"paragraph","ruby":[[0,1,"よ"],[2,1,"あ"],[7,2,"へいそつ"],[12,1,"あいだ"],[34,1,"たい"],[38,1,"さわ"],[41,1,"おこ"]],"text":"夜が明けると、兵卒たちの間に、ペテロはいったいどうなったのだろうと、大へんな騒ぎが起った。"},{"ref":"Acts.12.19","start":44012019,"end":44012019,"break":"none","ruby":[[8,1,"さが"],[12,1,"み"],[21,2,"ばんぺい"],[26,1,"と"],[28,1,"しら"],[34,1,"かれ"],[37,2,"しけい"],[40,1,"しょ"],[46,1,"めい"],[68,1,"い"],[75,2,"たいざい"]],"text":"ヘロデはペテロを捜しても見つからないので、番兵たちを取り調べたうえ、彼らを死刑に処するように命じ、そして、ユダヤからカイザリヤにくだって行って、そこに滞在した。"},{"ref":"Acts.12.20","start":44012020,"end":44012020,"break":"paragraph","ruby":[[11,2,"ひとびと"],[19,1,"いか"],[22,1,"ふれ"],[29,2,"いちどう"],[37,1,"おう"],[44,1,"おう"],[46,2,"じじゅう"],[48,1,"かん"],[54,1,"と"],[60,2,"わかい"],[65,2,"いらい"],[70,1,"かれ"],[73,2,"ちほう"],[77,1,"おう"],[79,1,"くに"],[82,2,"しょくりょう"],[85,1,"え"]],"text":"さて、ツロとシドンとの人々は、ヘロデの怒りに触ていたので、一同うちそろって王をおとずれ、王の侍従官ブラストに取りいって、和解かたを依頼した。彼らの地方が、王の国から食糧を得ていたからである。"},{"ref":"Acts.12.21","start":44012021,"end":44012021,"break":"none","ruby":[[0,1,"さだ"],[5,1,"ひ"],[12,1,"おう"],[13,1,"ふく"],[19,2,"おうざ"],[26,1,"かれ"],[33,2,"えんぜつ"]],"text":"定められた日に、ヘロデは王服をまとって王座にすわり、彼らにむかって演説をした。"},{"ref":"Acts.12.22","start":44012022,"end":44012022,"break":"none","ruby":[[0,1,"あつ"],[4,2,"ひとびと"],[12,1,"かみ"],[14,1,"こえ"],[17,2,"にんげん"],[20,1,"こえ"],[27,1,"さけ"]],"text":"集まった人々は、「これは神の声だ、人間の声ではない」と叫びつづけた。"},{"ref":"Acts.12.23","start":44012023,"end":44012023,"break":"none","ruby":[[8,1,"しゅ"],[10,1,"つかい"],[12,1,"かれ"],[14,1,"う"],[18,1,"かみ"],[20,2,"えいこう"],[23,1,"き"],[40,1,"かれ"],[42,1,"むし"],[48,1,"いき"],[50,1,"た"]],"text":"するとたちまち、主の使が彼を打った。神に栄光を帰することをしなかったからである。彼は虫にかまれて息が絶えてしまった。"},{"ref":"Acts.12.24","start":44012024,"end":44012024,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,1,"ことば"],[13,1,"さか"],[21,1,"い"]],"text":"こうして、主の言はますます盛んにひろまって行った。"},{"ref":"Acts.12.25","start":44012025,"end":44012025,"break":"paragraph","ruby":[[13,2,"にんむ"],[16,1,"はた"],[26,1,"よ"],[36,1,"つ"],[47,1,"かえ"]],"text":"バルナバとサウロとは、その任務を果したのち、マルコと呼ばれていたヨハネを連れて、エルサレムから帰ってきた。"}]