[{"ref":"Joel.1.1","start":29001001,"end":29001001,"break":"paragraph","ruby":[[5,1,"こ"],[10,1,"のぞ"],[13,1,"しゅ"],[15,2,"ことば"]],"text":"ペトエルの子ヨエルに臨んだ主の言葉。"},{"ref":"Joel.1.2","start":29001002,"end":29001002,"break":"stanza","breaks":[[12,"line"],[24,"line"],[30,"line"],[52,"line"]],"ruby":[[0,2,"ろうじん"],[9,1,"き"],[17,1,"ち"],[19,1,"す"],[21,1,"もの"],[24,1,"みみ"],[26,1,"かたむ"],[36,1,"よ"],[47,2,"せんぞ"],[50,1,"よ"],[57,1,"こと"]],"text":"老人たちよ、これを聞け。すべてこの地に住む者よ、耳を傾けよ。あなたがたの世、またはあなたがたの先祖の世にこのような事があったか。"},{"ref":"Joel.1.3","start":29001003,"end":29001003,"break":"line","breaks":[[16,"line"],[31,"line"]],"ruby":[[9,1,"こ"],[13,1,"かた"],[16,1,"こ"],[24,1,"こ"],[28,1,"かた"],[33,1,"こ"],[42,1,"のち"],[44,1,"よ"],[46,1,"かた"],[48,1,"つた"]],"text":"これをあなたがたの子たちに語り、子たちはまたその子たちに語り、その子たちはまたこれを後の代に語り伝えよ。"},{"ref":"Joel.1.4","start":29001004,"end":29001004,"break":"stanza","breaks":[[16,"line"],[29,"line"],[43,"line"],[55,"line"]],"ruby":[[2,1,"く"],[9,1,"のこ"],[16,1,"むら"],[26,1,"く"],[29,1,"むら"],[36,1,"のこ"],[52,1,"く"],[61,1,"のこ"],[68,1,"ほろ"],[78,1,"く"]],"text":"かみ食らういなごの残したものは、群がるいなごがこれを食い、群がるいなごの残したものは、とびいなごがこれを食い、とびいなごの残したものは、滅ぼすいなごがこれを食った。"},{"ref":"Joel.1.5","start":29001005,"end":29001005,"break":"line","breaks":[[15,"line"],[25,"line"],[38,"line"]],"ruby":[[0,1,"よ"],[3,1,"もの"],[6,1,"め"],[12,1,"な"],[18,1,"さけ"],[20,1,"の"],[22,1,"もの"],[28,1,"さけ"],[33,1,"な"],[35,1,"さけ"],[41,1,"さけ"],[49,1,"くち"],[52,1,"た"]],"text":"酔える者よ、目をさまして泣け。すべて酒を飲む者よ、うまい酒のゆえに泣き叫べ。うまい酒はあなたがたの口から断たれるからだ。"},{"ref":"Joel.1.6","start":29001006,"end":29001006,"break":"stanza","breaks":[[21,"line"],[38,"line"],[51,"line"]],"ruby":[[3,2,"くにたみ"],[10,1,"くに"],[12,1,"せ"],[23,1,"いきお"],[26,1,"つよ"],[31,1,"かず"],[33,1,"はか"],[40,1,"は"],[45,1,"は"],[51,1,"め"]],"text":"一つの国民がわたしの国に攻めのぼってきた。その勢いは強く、その数は計られず、その歯はししの歯のようで、雌じしのきばをもっている。"},{"ref":"Joel.1.7","start":29001007,"end":29001007,"break":"line","breaks":[[14,"line"],[26,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[9,1,"き"],[11,1,"あら"],[21,1,"き"],[23,1,"お"],[28,1,"かわ"],[36,1,"す"],[42,1,"えだ"],[44,1,"しろ"]],"text":"彼らはわがぶどうの木を荒し、わがいちじくの木を折り、その皮をはだかにして捨てた。その枝は白くなった。"},{"ref":"Joel.1.8","start":29001008,"end":29001008,"break":"stanza","breaks":[[15,"line"]],"ruby":[[6,1,"わか"],[8,1,"とき"],[10,1,"おっと"],[15,2,"あらぬの"],[18,1,"こし"],[31,1,"な"],[33,1,"かな"]],"text":"あなたがたは若い時の夫のために荒布を腰にまとったおとめのように泣き悲しめ。"},{"ref":"Joel.1.9","start":29001009,"end":29001009,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"そさい"],[3,2,"かんさい"],[7,1,"しゅ"],[9,1,"いえ"],[11,1,"た"],[14,1,"しゅ"],[16,1,"つか"],[19,2,"さいし"],[24,1,"なげ"],[26,1,"かな"]],"text":"素祭と灌祭とは主の家に絶え、主に仕える祭司たちは嘆き悲しむ。"},{"ref":"Joel.1.10","start":29001010,"end":29001010,"break":"line","breaks":[[11,"line"],[22,"line"]],"ruby":[[0,1,"はたけ"],[2,1,"あ"],[5,1,"ち"],[7,1,"かな"],[14,2,"こくもつ"],[17,1,"あ"],[22,1,"あたら"],[25,1,"さけ"],[27,1,"つ"],[30,1,"あぶら"],[32,1,"た"]],"text":"畑は荒れ、地は悲しむ。これは穀物が荒れはて、新しい酒は尽き、油も絶えるためである。"},{"ref":"Joel.1.11","start":29001011,"end":29001011,"break":"line","breaks":[[12,"line"],[22,"line"],[34,"line"]],"ruby":[[0,2,"こむぎ"],[5,2,"おおむぎ"],[12,2,"のうふ"],[18,1,"は"],[25,1,"づく"],[31,1,"な"],[34,1,"はたけ"],[36,2,"しゅうかく"],[41,1,"さ"]],"text":"小麦および大麦のために、農夫たちよ、恥じよ、ぶどう作りたちよ、泣け。畑の収穫がうせ去ったからである。"},{"ref":"Joel.1.12","start":29001012,"end":29001012,"break":"line","breaks":[[20,"line"],[44,"line"]],"ruby":[[4,1,"き"],[6,1,"か"],[14,1,"き"],[31,1,"の"],[37,1,"き"],[48,1,"たの"],[52,1,"ひと"],[54,1,"こ"]],"text":"ぶどうの木は枯れ、いちじくの木はしおれ、ざくろ、やし、りんご、野のすべての木はしぼんだ。それゆえ楽しみは人の子らからかれうせた。"},{"ref":"Joel.1.13","start":29001013,"end":29001013,"break":"stanza","breaks":[[21,"line"],[35,"line"],[45,"line"],[61,"line"],[67,"line"]],"ruby":[[0,2,"さいし"],[6,2,"あらぬの"],[9,1,"こし"],[15,1,"な"],[17,1,"かな"],[21,2,"さいだん"],[24,1,"つか"],[27,1,"もの"],[32,1,"な"],[35,1,"かみ"],[37,1,"つか"],[40,1,"もの"],[45,1,"き"],[48,2,"あらぬの"],[55,1,"よる"],[57,1,"す"],[61,2,"そさい"],[64,2,"かんさい"],[73,1,"かみ"],[75,1,"いえ"],[78,1,"しりぞ"]],"text":"祭司たちよ、荒布を腰にまとい、泣き悲しめ。祭壇に仕える者たちよ、泣け。神に仕える者たちよ、来て、荒布をまとい、夜を過ごせ。素祭も灌祭もあなたがたの神の家から退けられたからである。"},{"ref":"Joel.1.14","start":29001014,"end":29001014,"break":"stanza","breaks":[[13,"line"],[28,"line"],[52,"line"]],"ruby":[[6,2,"だんじき"],[9,2,"せいべつ"],[13,1,"せい"],[14,1,"かい"],[16,2,"しょうしゅう"],[20,2,"ちょうろう"],[25,1,"あつ"],[28,1,"くに"],[30,1,"たみ"],[43,1,"かみ"],[45,1,"しゅ"],[47,1,"いえ"],[49,1,"あつ"],[52,1,"しゅ"],[54,1,"む"],[58,1,"さけ"]],"text":"あなたがたは断食を聖別し、聖会を召集し、長老たちを集め、国の民をことごとくあなたがたの神、主の家に集め、主に向かって叫べ。"},{"ref":"Joel.1.15","start":29001015,"end":29001015,"break":"stanza","breaks":[[13,"line"],[20,"line"]],"ruby":[[5,1,"ひ"],[13,1,"しゅ"],[15,1,"ひ"],[17,1,"ちか"],[20,3,"ぜんのうしゃ"],[26,1,"ほろ"],[32,1,"く"]],"text":"ああ、その日はわざわいだ。主の日は近く、全能者からの滅びのように来るからである。"},{"ref":"Joel.1.16","start":29001016,"end":29001016,"break":"line","breaks":[[15,"line"],[25,"line"]],"ruby":[[5,1,"め"],[7,1,"まえ"],[9,2,"しょくもつ"],[12,1,"た"],[20,1,"かみ"],[22,1,"いえ"],[25,1,"よろこ"],[28,1,"たの"],[32,1,"た"]],"text":"われわれの目の前に食物は絶え、われわれの神の家から喜びと楽しみが絶えたではないか。"},{"ref":"Joel.1.17","start":29001017,"end":29001017,"break":"stanza","breaks":[[14,"line"]],"ruby":[[0,1,"たね"],[2,1,"つち"],[4,1,"した"],[6,1,"く"],[9,1,"くら"],[11,1,"あ"],[14,2,"こくもつ"],[23,2,"こくぐら"]],"text":"種は土の下に朽ち、倉は荒れ、穀物がつきたので、穀倉はこわされる。"},{"ref":"Joel.1.18","start":29001018,"end":29001018,"break":"line","breaks":[[13,"line"],[23,"line"],[36,"line"]],"ruby":[[3,2,"かちく"],[9,1,"な"],[13,1,"うし"],[15,1,"む"],[23,1,"かれ"],[27,2,"ぼくそう"],[36,1,"ひつじ"],[38,1,"む"],[41,1,"ほろ"]],"text":"いかに家畜はうめき鳴くか。牛の群れはさまよう。彼らには牧草がないからだ。羊の群れも滅びうせる。"},{"ref":"Joel.1.19","start":29001019,"end":29001019,"break":"stanza","breaks":[[20,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"む"],[15,1,"よ"],[20,1,"ひ"],[22,2,"あらの"],[25,2,"ぼくそう"],[28,1,"や"],[30,1,"ほろ"],[34,1,"ほのお"],[36,1,"の"],[42,1,"き"],[44,1,"や"],[46,1,"つく"]],"text":"主よ、わたしはあなたに向かって呼ばわる。火が荒野の牧草を焼き滅ぼし、炎が野のすべての木を焼き尽したからである。"},{"ref":"Joel.1.20","start":29001020,"end":29001020,"break":"line","breaks":[[19,"line"],[29,"line"]],"ruby":[[0,1,"の"],[2,1,"けもの"],[10,1,"む"],[14,1,"よ"],[19,1,"みず"],[21,1,"なが"],[29,1,"ひ"],[31,2,"あらの"],[34,2,"ぼくそう"],[37,1,"や"],[39,1,"ほろ"]],"text":"野の獣もまたあなたに向かって呼ばわる。水の流れがかれはて、火が荒野の牧草を焼き滅ぼしたからである"}]