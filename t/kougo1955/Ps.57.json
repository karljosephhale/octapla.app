[{"ref":"Ps.57.1","start":19057001,"end":19057001,"break":"paragraph","title":"聖歌隊の指揮者によって、「滅ぼすな」というしらべにあわせてうたわせたダビデのミクタムの歌。これはダビデが洞にはいってサウルの手をのがれたときによんだもの","breaks":[[17,"line"],[31,"line"],[48,"line"],[62,"line"]],"ruby":[[0,1,"かみ"],[35,1,"たましい"],[41,1,"よ"],[43,1,"たの"],[48,1,"ほろ"],[55,1,"す"],[57,1,"さ"],[66,1,"つばさ"],[68,1,"かげ"],[74,1,"さ"],[76,1,"どころ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[13,1,"ほろ"],[43,1,"うた"],[52,1,"ほら"],[62,1,"て"]],"text":"神よ、わたしをあわれんでください。わたしをあわれんでください。わたしの魂はあなたに寄り頼みます。滅びのあらしの過ぎ去るまではあなたの翼の陰をわたしの避け所とします。"},{"ref":"Ps.57.2","start":19057002,"end":19057002,"break":"line","breaks":[[17,"line"],[39,"line"]],"ruby":[[6,1,"たか"],[8,1,"かみ"],[10,1,"よ"],[28,1,"こと"],[37,1,"かみ"],[39,1,"よ"]],"text":"わたしはいと高き神に呼ばわります。わたしのためにすべての事をなしとげられる神に呼ばわります。"},{"ref":"Ps.57.3","start":19057003,"end":19057003,"break":"line","breaks":[[15,"line"],[39,"line"],[58,"line"]],"ruby":[[0,1,"かみ"],[2,1,"てん"],[5,1,"おく"],[12,1,"すく"],[19,1,"ふ"],[24,1,"もの"],[43,1,"かみ"],[58,1,"おく"]],"text":"神は天から送ってわたしを救い、わたしを踏みつける者をはずかしめられます。〔セラすなわち神はそのいつくしみとまこととを送られるのです。"},{"ref":"Ps.57.4","start":19057004,"end":19057004,"break":"line","breaks":[[21,"line"],[30,"line"]],"ruby":[[4,1,"ひと"],[6,1,"こ"],[13,1,"く"],[19,1,"なか"],[21,1,"よこ"],[30,1,"かれ"],[33,1,"は"],[40,1,"や"],[42,1,"かれ"],[45,1,"した"],[47,1,"するど"]],"text":"わたしは人の子らをむさぼり食らうししの中に横たわっています。彼らの歯はほこ、また矢、彼らの舌は鋭いつるぎです。"},{"ref":"Ps.57.5","start":19057005,"end":19057005,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[8,1,"てん"],[12,1,"たか"],[21,1,"ぜん"],[22,1,"ち"],[24,1,"うえ"]],"text":"神よ、みずからを天よりも高くし、みさかえを全地の上にあげてください。"},{"ref":"Ps.57.6","start":19057006,"end":19057006,"break":"line","breaks":[[22,"line"],[36,"line"],[53,"line"]],"ruby":[[0,1,"かれ"],[7,1,"あし"],[9,1,"とら"],[14,1,"あみ"],[16,1,"もう"],[26,1,"たましい"],[36,1,"かれ"],[43,1,"まえ"],[45,1,"あな"],[47,1,"ほ"],[56,1,"かれ"],[65,1,"なか"],[67,1,"おちい"]],"text":"彼らはわたしの足を捕えようと網を設けました。わたしの魂はうなだれました。彼らはわたしの前に穴を掘りました。しかし彼らはみずからその中に陥ったのです。〔セラ"},{"ref":"Ps.57.7","start":19057007,"end":19057007,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[0,1,"かみ"],[7,1,"こころ"],[9,1,"さだ"],[20,1,"こころ"],[22,1,"さだ"],[33,1,"うた"]],"text":"神よ、わたしの心は定まりました。わたしの心は定まりました。わたしは歌い、かつほめたたえます。"},{"ref":"Ps.57.8","start":19057008,"end":19057008,"break":"line","breaks":[[20,"line"]],"ruby":[[2,1,"たましい"],[9,2,"たてごと"],[13,1,"こと"],[29,1,"よ"]],"text":"わが魂よ、さめよ。立琴よ、琴よ、さめよ。わたしはしののめを呼びさまします。"},{"ref":"Ps.57.9","start":19057009,"end":19057009,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[12,1,"たみ"],[14,1,"なか"],[20,2,"かんしゃ"],[29,1,"くに"],[31,1,"なか"]],"text":"主よ、わたしはもろもろの民の中であなたに感謝し、もろもろの国の中であなたをほめたたえます。"},{"ref":"Ps.57.10","start":19057010,"end":19057010,"break":"line","breaks":[[21,"line"]],"ruby":[[10,1,"おお"],[14,1,"てん"],[18,1,"およ"],[29,1,"くも"],[33,1,"およ"]],"text":"あなたのいつくしみは大きく、天にまで及び、あなたのまことは雲にまで及びます。"},{"ref":"Ps.57.11","start":19057011,"end":19057011,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[8,1,"てん"],[12,1,"たか"],[21,1,"ぜん"],[22,1,"ち"],[24,1,"うえ"]],"text":"神よ、みずからを天よりも高くし、みさかえを全地の上にあげてください。"}]