[{"ref":"Gal.2.1","start":48002001,"end":48002001,"break":"paragraph","ruby":[[2,1,"のち"],[5,1,"ねん"],[21,2,"いっしょ"],[30,1,"つ"],[34,1,"ふたた"],[42,1,"のぼ"]],"text":"その後十四年たってから、わたしはバルナバと一緒に、テトスをも連れて、再びエルサレムに上った。"},{"ref":"Gal.2.2","start":48002002,"end":48002002,"break":"none","ruby":[[3,1,"のぼ"],[9,2,"けいじ"],[27,3,"いほうじん"],[31,1,"あいだ"],[33,1,"の"],[35,1,"つた"],[40,2,"ふくいん"],[44,2,"ひとびと"],[47,1,"しめ"],[51,1,"おも"],[55,1,"ひと"],[61,2,"こじん"],[63,1,"てき"],[65,1,"しめ"],[77,1,"げん"],[79,1,"はし"],[90,1,"はし"]],"text":"そこに上ったのは、啓示によってである。そして、わたしが異邦人の間に宣べ伝えている福音を、人々に示し、「重だった人たち」には個人的に示した。それは、わたしが現に走っており、またすでに走ってきたことが、むだにならないためである。"},{"ref":"Gal.2.3","start":48002003,"end":48002003,"break":"none","ruby":[[8,1,"つ"],[24,1,"じん"],[32,2,"かつれい"]],"text":"しかし、わたしが連れていたテトスでさえ、ギリシヤ人であったのに、割礼をしいられなかった。"},{"ref":"Gal.2.4","start":48002004,"end":48002004,"break":"none","ruby":[[4,1,"しの"],[6,1,"こ"],[13,2,"きょうだい"],[23,1,"かれ"],[26,1,"しの"],[28,1,"こ"],[48,1,"も"],[59,2,"じゆう"],[73,2,"どれい"]],"text":"それは、忍び込んできたにせ兄弟らがいたので――彼らが忍び込んできたのは、キリスト・イエスにあって持っているわたしたちの自由をねらって、わたしたちを奴隷にするためであった。"},{"ref":"Gal.2.5","start":48002005,"end":48002005,"break":"none","ruby":[[7,2,"ふくいん"],[10,2,"しんり"],[22,1,"つね"],[35,2,"しゅんじ"],[38,1,"かれ"],[41,2,"きょうよう"],[44,2,"くっぷく"]],"text":"わたしたちは、福音の真理があなたがたのもとに常にとどまっているように、瞬時も彼らの強要に屈服しなかった。"},{"ref":"Gal.2.6","start":48002006,"end":48002006,"break":"none","ruby":[[7,1,"おも"],[11,1,"ひと"],[20,1,"かれ"],[26,1,"ひと"],[45,1,"まった"],[47,2,"もんだい"],[54,1,"かみ"],[56,1,"ひと"],[58,1,"わ"],[60,1,"へだ"],[73,2,"じじつ"],[79,1,"おも"],[83,1,"ひと"],[93,1,"なに"],[95,1,"くわ"]],"text":"そして、かの「重だった人たち」からは――彼らがどんな人であったにしても、それは、わたしには全く問題ではない。神は人を分け隔てなさらないのだから――事実、かの「重だった人たち」は、わたしに何も加えることをしなかった。"},{"ref":"Gal.2.7","start":48002007,"end":48002007,"break":"none","ruby":[[7,1,"かれ"],[15,2,"かつれい"],[18,1,"もの"],[21,2,"ふくいん"],[41,1,"む"],[42,2,"かつれい"],[45,1,"もの"],[48,2,"ふくいん"],[62,1,"みと"]],"text":"それどころか、彼らは、ペテロが割礼の者への福音をゆだねられているように、わたしには無割礼の者への福音がゆだねられていることを認め、"},{"ref":"Gal.2.8","start":48002008,"end":48002008,"break":"none","ruby":[[11,1,"はたら"],[16,2,"かつれい"],[19,1,"もの"],[22,2,"しと"],[25,1,"つとめ"],[40,1,"はたら"],[46,3,"いほうじん"],[55,1,"くだ"]],"text":"（というのは、ペテロに働きかけて割礼の者への使徒の務につかせたかたは、わたしにも働きかけて、異邦人につかわして下さったからである）、"},{"ref":"Gal.2.9","start":48002009,"end":48002009,"break":"none","ruby":[[7,1,"たま"],[11,1,"めぐ"],[14,1,"し"],[18,1,"はしら"],[22,1,"おも"],[54,1,"まじ"],[58,1,"て"],[60,1,"さ"],[62,1,"の"],[76,3,"いほうじん"],[80,1,"い"],[83,1,"かれ"],[86,2,"かつれい"],[89,1,"もの"],[91,1,"い"]],"text":"かつ、わたしに賜わった恵みを知って、柱として重んじられているヤコブとケパとヨハネとは、わたしとバルナバとに、交わりの手を差し伸べた。そこで、わたしたちは異邦人に行き、彼らは割礼の者に行くことになったのである。"},{"ref":"Gal.2.10","start":48002010,"end":48002010,"break":"none","ruby":[[11,1,"まず"],[14,2,"ひとびと"],[46,1,"こと"],[52,1,"おお"],[55,1,"つと"]],"text":"ただ一つ、わたしたちが貧しい人々をかえりみるようにとのことであったが、わたしはもとより、この事のためにも大いに努めてきたのである。"},{"ref":"Gal.2.11","start":48002011,"end":48002011,"break":"paragraph","ruby":[[19,1,"かれ"],[21,2,"ひなん"],[39,1,"めん"],[45,1,"かれ"]],"text":"ところが、ケパがアンテオケにきたとき、彼に非難すべきことがあったので、わたしは面とむかって彼をなじった。"},{"ref":"Gal.2.12","start":48002012,"end":48002012,"break":"none","ruby":[[16,2,"ひとびと"],[19,1,"く"],[25,1,"かれ"],[27,3,"いほうじん"],[31,1,"しょく"],[33,1,"とも"],[42,1,"かれ"],[51,2,"かつれい"],[54,1,"もの"],[58,1,"おそ"],[65,1,"み"],[67,1,"ひ"],[70,1,"はな"],[73,1,"い"]],"text":"というのは、ヤコブのもとからある人々が来るまでは、彼は異邦人と食を共にしていたのに、彼らがきてからは、割礼の者どもを恐れ、しだいに身を引いて離れて行ったからである。"},{"ref":"Gal.2.13","start":48002013,"end":48002013,"break":"none","ruby":[[10,1,"じん"],[14,1,"かれ"],[16,1,"とも"],[18,2,"ぎぜん"],[21,2,"こうい"],[38,2,"ぎぜん"],[41,1,"ひ"],[45,1,"こ"]],"text":"そして、ほかのユダヤ人たちも彼と共に偽善の行為をし、バルナバまでがそのような偽善に引きずり込まれた。"},{"ref":"Gal.2.14","start":48002014,"end":48002014,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ふくいん"],[6,2,"しんり"],[9,1,"したが"],[17,1,"ある"],[25,1,"み"],[32,2,"しゅうじん"],[35,2,"めんぜん"],[41,1,"い"],[54,1,"じん"],[61,2,"じぶん"],[63,2,"じしん"],[69,1,"じん"],[74,2,"せいかつ"],[81,3,"いほうじん"],[88,2,"せいかつ"],[101,3,"いほうじん"],[108,1,"じん"]],"text":"彼らが福音の真理に従ってまっすぐに歩いていないのを見て、わたしは衆人の面前でケパに言った、「あなたは、ユダヤ人であるのに、自分自身はユダヤ人のように生活しないで、異邦人のように生活していながら、どうして異邦人にユダヤ人のようになることをしいるのか」。"},{"ref":"Gal.2.15","start":48002015,"end":48002015,"break":"paragraph","ruby":[[6,1,"うま"],[15,1,"じん"],[21,3,"いほうじん"],[26,2,"つみびと"]],"text":"わたしたちは生れながらのユダヤ人であって、異邦人なる罪人ではないが、"},{"ref":"Gal.2.16","start":48002016,"end":48002016,"break":"none","ruby":[[0,1,"ひと"],[2,1,"ぎ"],[9,2,"りっぽう"],[12,1,"おこな"],[34,1,"しん"],[37,2,"しんこう"],[45,1,"みと"],[64,1,"しん"],[76,2,"りっぽう"],[79,1,"おこな"],[95,1,"しん"],[98,2,"しんこう"],[104,1,"ぎ"],[120,2,"りっぽう"],[123,1,"おこな"],[136,1,"ぎ"]],"text":"人の義とされるのは律法の行いによるのではなく、ただキリスト・イエスを信じる信仰によることを認めて、わたしたちもキリスト・イエスを信じたのである。それは、律法の行いによるのではなく、キリストを信じる信仰によって義とされるためである。なぜなら、律法の行いによっては、だれひとり義とされることがないからである。"},{"ref":"Gal.2.17","start":48002017,"end":48002017,"break":"none","ruby":[[12,1,"ぎ"],[20,1,"もと"],[35,2,"じしん"],[38,2,"つみびと"],[56,1,"つみ"],[58,1,"つか"],[61,1,"もの"],[70,1,"だん"]],"text":"しかし、キリストにあって義とされることを求めることによって、わたしたち自身が罪人であるとされるのなら、キリストは罪に仕える者なのであろうか。断じてそうではない。"},{"ref":"Gal.2.18","start":48002018,"end":48002018,"break":"none","ruby":[[11,1,"う"],[21,1,"ふたた"],[23,1,"た"],[36,2,"じぶん"],[39,3,"いはんしゃ"],[48,2,"ひょうめい"]],"text":"もしわたしが、いったん打ちこわしたものを、再び建てるとすれば、それこそ、自分が違反者であることを表明することになる。"},{"ref":"Gal.2.19","start":48002019,"end":48002019,"break":"none","ruby":[[5,1,"かみ"],[7,1,"い"],[14,2,"りっぽう"],[20,2,"りっぽう"],[23,1,"し"],[36,1,"とも"],[38,3,"じゅうじか"]],"text":"わたしは、神に生きるために、律法によって律法に死んだ。わたしはキリストと共に十字架につけられた。"},{"ref":"Gal.2.20","start":48002020,"end":48002020,"break":"none","ruby":[[0,1,"い"],[33,1,"い"],[55,1,"にく"],[60,1,"い"],[72,1,"あい"],[83,2,"じしん"],[92,1,"かみ"],[94,2,"みこ"],[97,1,"しん"],[100,2,"しんこう"],[107,1,"い"]],"text":"生きているのは、もはや、わたしではない。キリストが、わたしのうちに生きておられるのである。しかし、わたしがいま肉にあって生きているのは、わたしを愛し、わたしのためにご自身をささげられた神の御子を信じる信仰によって、生きているのである。"},{"ref":"Gal.2.21","start":48002021,"end":48002021,"break":"none","ruby":[[5,1,"かみ"],[7,1,"めぐ"],[10,1,"む"],[20,1,"ぎ"],[22,2,"りっぽう"],[28,1,"え"],[42,1,"し"]],"text":"わたしは、神の恵みを無にはしない。もし、義が律法によって得られるとすれば、キリストの死はむだであったことになる。"}]