[{"ref":"Ezra.2.1","start":15002001,"end":15002001,"break":"paragraph","ruby":[[5,1,"おう"],[14,1,"とら"],[25,1,"うつ"],[29,1,"もの"],[34,2,"ほしゅう"],[53,1,"のぼ"],[61,2,"じぶん"],[64,1,"まち"],[66,1,"かえ"],[71,1,"しゅう"],[73,2,"ひとびと"],[76,1,"つぎ"]],"text":"バビロンの王ネブカデネザルに捕えられて、バビロンに移された者のうち、捕囚をゆるされてエルサレムおよびユダに上って、おのおの自分の町に帰ったこの州の人々は次のとおりである。"},{"ref":"Ezra.2.2","start":15002002,"end":15002002,"break":"none","breaks":[[66,"paragraph"]],"ruby":[[0,1,"かれ"],[58,1,"とも"],[60,1,"かえ"],[74,1,"たみ"],[76,2,"にんずう"],[79,1,"つぎ"]],"text":"彼らはゼルバベル、エシュア、ネヘミヤ、セラヤ、レエラヤ、モルデカイ、ビルシャン、ミスパル、ビグワイ、レホム、バアナと共に帰ってきた。そのイスラエルの民の人数は次のとおりである。"},{"ref":"Ezra.2.3","start":15002003,"end":15002003,"break":"none","ruby":[[4,2,"しそん"],[13,1,"にん"]],"text":"パロシの子孫は二千百七十二人、"},{"ref":"Ezra.2.4","start":15002004,"end":15002004,"break":"none","ruby":[[5,2,"しそん"],[13,1,"にん"]],"text":"シパテヤの子孫は三百七十二人、"},{"ref":"Ezra.2.5","start":15002005,"end":15002005,"break":"none","ruby":[[3,2,"しそん"],[11,1,"にん"]],"text":"アラの子孫は七百七十五人、"},{"ref":"Ezra.2.6","start":15002006,"end":15002006,"break":"none","ruby":[[8,2,"しそん"],[23,2,"しそん"],[32,1,"にん"]],"text":"パハテ・モアブの子孫すなわちエシュアとヨアブの子孫は二千八百十二人、"},{"ref":"Ezra.2.7","start":15002007,"end":15002007,"break":"none","ruby":[[4,2,"しそん"],[14,1,"にん"]],"text":"エラムの子孫は一千二百五十四人、"},{"ref":"Ezra.2.8","start":15002008,"end":15002008,"break":"none","ruby":[[4,2,"しそん"],[12,1,"にん"]],"text":"ザットの子孫は九百四十五人、"},{"ref":"Ezra.2.9","start":15002009,"end":15002009,"break":"none","ruby":[[5,2,"しそん"],[12,1,"にん"]],"text":"ザッカイの子孫は七百六十人、"},{"ref":"Ezra.2.10","start":15002010,"end":15002010,"break":"none","ruby":[[3,2,"しそん"],[11,1,"にん"]],"text":"バニの子孫は六百四十二人、"},{"ref":"Ezra.2.11","start":15002011,"end":15002011,"break":"none","ruby":[[4,2,"しそん"],[12,1,"にん"]],"text":"ベバイの子孫は六百二十三人、"},{"ref":"Ezra.2.12","start":15002012,"end":15002012,"break":"none","ruby":[[5,2,"しそん"],[15,1,"にん"]],"text":"アズガデの子孫は一千二百二十二人、"},{"ref":"Ezra.2.13","start":15002013,"end":15002013,"break":"none","ruby":[[6,2,"しそん"],[14,1,"にん"]],"text":"アドニカムの子孫は六百六十六人、"},{"ref":"Ezra.2.14","start":15002014,"end":15002014,"break":"none","ruby":[[5,2,"しそん"],[13,1,"にん"]],"text":"ビグワイの子孫は二千五十六人、"},{"ref":"Ezra.2.15","start":15002015,"end":15002015,"break":"none","ruby":[[4,2,"しそん"],[12,1,"にん"]],"text":"アデンの子孫は四百五十四人、"},{"ref":"Ezra.2.16","start":15002016,"end":15002016,"break":"none","ruby":[[4,2,"しそん"],[15,2,"しそん"],[21,1,"にん"]],"text":"アテルの子孫すなわちヒゼキヤの子孫は九十八人、"},{"ref":"Ezra.2.17","start":15002017,"end":15002017,"break":"none","ruby":[[4,2,"しそん"],[12,1,"にん"]],"text":"ベザイの子孫は三百二十三人、"},{"ref":"Ezra.2.18","start":15002018,"end":15002018,"break":"none","ruby":[[3,2,"しそん"],[9,1,"にん"]],"text":"ヨラの子孫は百十二人、"},{"ref":"Ezra.2.19","start":15002019,"end":15002019,"break":"none","ruby":[[5,2,"しそん"],[13,1,"にん"]],"text":"ハシュムの子孫は二百二十三人、"},{"ref":"Ezra.2.20","start":15002020,"end":15002020,"break":"none","ruby":[[4,2,"しそん"],[10,1,"にん"]],"text":"ギバルの子孫は九十五人、"},{"ref":"Ezra.2.21","start":15002021,"end":15002021,"break":"none","ruby":[[6,2,"しそん"],[13,1,"にん"]],"text":"ベツレヘムの子孫は百二十三人、"},{"ref":"Ezra.2.22","start":15002022,"end":15002022,"break":"none","ruby":[[4,2,"ひとびと"],[10,1,"にん"]],"text":"ネトパの人々は五十六人、"},{"ref":"Ezra.2.23","start":15002023,"end":15002023,"break":"none","ruby":[[5,2,"ひとびと"],[12,1,"にん"]],"text":"アナトテの人々は百二十八人、"},{"ref":"Ezra.2.24","start":15002024,"end":15002024,"break":"none","ruby":[[6,2,"しそん"],[12,1,"にん"]],"text":"アズマウテの子孫は四十二人、"},{"ref":"Ezra.2.25","start":15002025,"end":15002025,"break":"none","ruby":[[20,2,"しそん"],[28,1,"にん"]],"text":"キリアテ・ヤリム、ケピラおよびベエロテの子孫は七百四十三人、"},{"ref":"Ezra.2.26","start":15002026,"end":15002026,"break":"none","ruby":[[8,2,"しそん"],[16,1,"にん"]],"text":"ラマおよびゲバの子孫は六百二十一人、"},{"ref":"Ezra.2.27","start":15002027,"end":15002027,"break":"none","ruby":[[5,2,"ひとびと"],[12,1,"にん"]],"text":"ミクマシの人々は百二十二人、"},{"ref":"Ezra.2.28","start":15002028,"end":15002028,"break":"none","ruby":[[9,2,"ひとびと"],[17,1,"にん"]],"text":"ベテルおよびアイの人々は二百二十三人、"},{"ref":"Ezra.2.29","start":15002029,"end":15002029,"break":"none","ruby":[[3,2,"しそん"],[9,1,"にん"]],"text":"ネボの子孫は五十二人、"},{"ref":"Ezra.2.30","start":15002030,"end":15002030,"break":"none","ruby":[[5,2,"しそん"],[12,1,"にん"]],"text":"マグビシの子孫は百五十六人、"},{"ref":"Ezra.2.31","start":15002031,"end":15002031,"break":"none","ruby":[[0,1,"た"],[6,2,"しそん"],[16,1,"にん"]],"text":"他のエラムの子孫は一千二百五十四人、"},{"ref":"Ezra.2.32","start":15002032,"end":15002032,"break":"none","ruby":[[4,2,"しそん"],[11,1,"にん"]],"text":"ハリムの子孫は三百二十人、"},{"ref":"Ezra.2.33","start":15002033,"end":15002033,"break":"none","ruby":[[12,2,"しそん"],[20,1,"にん"]],"text":"ロド、ハデデおよびオノの子孫は七百二十五人、"},{"ref":"Ezra.2.34","start":15002034,"end":15002034,"break":"none","ruby":[[4,2,"しそん"],[12,1,"にん"]],"text":"エリコの子孫は三百四十五人、"},{"ref":"Ezra.2.35","start":15002035,"end":15002035,"break":"none","ruby":[[4,2,"しそん"],[13,1,"にん"]],"text":"セナアの子孫は三千六百三十人。"},{"ref":"Ezra.2.36","start":15002036,"end":15002036,"break":"paragraph","ruby":[[0,2,"さいし"],[9,1,"いえ"],[15,2,"しそん"],[22,1,"にん"]],"text":"祭司は、エシュアの家のエダヤの子孫九百七十三人、"},{"ref":"Ezra.2.37","start":15002037,"end":15002037,"break":"none","ruby":[[5,2,"しそん"],[12,1,"にん"]],"text":"インメルの子孫一千五十二人、"},{"ref":"Ezra.2.38","start":15002038,"end":15002038,"break":"none","ruby":[[5,2,"しそん"],[14,1,"にん"]],"text":"パシュルの子孫一千二百四十七人、"},{"ref":"Ezra.2.39","start":15002039,"end":15002039,"break":"none","ruby":[[4,2,"しそん"],[10,1,"にん"]],"text":"ハリムの子孫一千十七人。"},{"ref":"Ezra.2.40","start":15002040,"end":15002040,"break":"paragraph","ruby":[[10,2,"しそん"],[27,2,"しそん"],[32,1,"にん"]],"text":"レビびとは、ホダヤの子孫すなわちエシュアとカデミエルの子孫七十四人。"},{"ref":"Ezra.2.41","start":15002041,"end":15002041,"break":"none","ruby":[[0,1,"うた"],[4,1,"もの"],[11,2,"しそん"],[17,1,"にん"]],"text":"歌うたう者は、アサフの子孫百二十八人。"},{"ref":"Ezra.2.42","start":15002042,"end":15002042,"break":"none","ruby":[[0,2,"もんえい"],[3,2,"しそん"],[12,2,"しそん"],[19,2,"しそん"],[27,2,"しそん"],[35,2,"しそん"],[42,2,"しそん"],[50,2,"しそん"],[52,1,"あ"],[60,1,"にん"]],"text":"門衛の子孫は、シャルムの子孫、アテルの子孫、タルモンの子孫、アックブの子孫、ハテタの子孫、ショバイの子孫合わせて百三十九人。"},{"ref":"Ezra.2.43","start":15002043,"end":15002043,"break":"paragraph","ruby":[[0,1,"みや"],[2,1,"つか"],[15,2,"しそん"],[22,2,"しそん"],[30,2,"しそん"]],"text":"宮に仕えるしもべたちは、ヂハの子孫、ハスパの子孫、タバオテの子孫、"},{"ref":"Ezra.2.44","start":15002044,"end":15002044,"break":"none","ruby":[[4,2,"しそん"],[11,2,"しそん"],[18,2,"しそん"]],"text":"ケロスの子孫、シアハの子孫、パドンの子孫、"},{"ref":"Ezra.2.45","start":15002045,"end":15002045,"break":"none","ruby":[[4,2,"しそん"],[11,2,"しそん"],[19,2,"しそん"]],"text":"レバナの子孫、ハガバの子孫、アックブの子孫、"},{"ref":"Ezra.2.46","start":15002046,"end":15002046,"break":"none","ruby":[[4,2,"しそん"],[13,2,"しそん"],[20,2,"しそん"]],"text":"ハガブの子孫、シャルマイの子孫、ハナンの子孫、"},{"ref":"Ezra.2.47","start":15002047,"end":15002047,"break":"none","ruby":[[4,2,"しそん"],[11,2,"しそん"],[18,2,"しそん"]],"text":"ギデルの子孫、ガハルの子孫、レアヤの子孫、"},{"ref":"Ezra.2.48","start":15002048,"end":15002048,"break":"none","ruby":[[4,2,"しそん"],[11,2,"しそん"],[18,2,"しそん"]],"text":"レヂンの子孫、ネコダの子孫、ガザムの子孫、"},{"ref":"Ezra.2.49","start":15002049,"end":15002049,"break":"none","ruby":[[3,2,"しそん"],[10,2,"しそん"],[17,2,"しそん"]],"text":"ウザの子孫、パセアの子孫、ベサイの子孫、"},{"ref":"Ezra.2.50","start":15002050,"end":15002050,"break":"none","ruby":[[4,2,"しそん"],[12,2,"しそん"],[20,2,"しそん"]],"text":"アスナの子孫、メウニムの子孫、ネフシムの子孫、"},{"ref":"Ezra.2.51","start":15002051,"end":15002051,"break":"none","ruby":[[5,2,"しそん"],[12,2,"しそん"],[20,2,"しそん"]],"text":"バクブクの子孫、ハクパの子孫、ハルホルの子孫、"},{"ref":"Ezra.2.52","start":15002052,"end":15002052,"break":"none","ruby":[[5,2,"しそん"],[12,2,"しそん"],[20,2,"しそん"]],"text":"バヅリテの子孫、メヒダの子孫、ハルシャの子孫、"},{"ref":"Ezra.2.53","start":15002053,"end":15002053,"break":"none","ruby":[[5,2,"しそん"],[12,2,"しそん"],[18,2,"しそん"]],"text":"バルコスの子孫、シセラの子孫、テマの子孫、"},{"ref":"Ezra.2.54","start":15002054,"end":15002054,"break":"none","ruby":[[4,2,"しそん"],[11,2,"しそん"]],"text":"ネヂアの子孫、ハテパの子孫である。"},{"ref":"Ezra.2.55","start":15002055,"end":15002055,"break":"paragraph","ruby":[[11,2,"しそん"],[19,2,"しそん"],[29,2,"しそん"],[36,2,"しそん"]],"text":"ソロモンのしもべたちの子孫は、ソタイの子孫、ハッソペレテの子孫、ペリダの子孫、"},{"ref":"Ezra.2.56","start":15002056,"end":15002056,"break":"none","ruby":[[4,2,"しそん"],[12,2,"しそん"],[19,2,"しそん"]],"text":"ヤアラの子孫、ダルコンの子孫、ギデルの子孫、"},{"ref":"Ezra.2.57","start":15002057,"end":15002057,"break":"none","ruby":[[5,2,"しそん"],[13,2,"しそん"],[28,2,"しそん"],[34,2,"しそん"]],"text":"シパテヤの子孫、ハッテルの子孫、ポケレテ・ハッゼバイムの子孫、アミの子孫。"},{"ref":"Ezra.2.58","start":15002058,"end":15002058,"break":"paragraph","ruby":[[0,1,"みや"],[2,1,"つか"],[22,2,"しそん"],[26,1,"あ"],[35,1,"にん"]],"text":"宮に仕えるしもべたちとソロモンのしもべたちの子孫とは合わせて三百九十二人。"},{"ref":"Ezra.2.59","start":15002059,"end":15002059,"break":"paragraph","ruby":[[0,1,"つぎ"],[5,2,"ひとびと"],[37,1,"のぼ"],[40,1,"き"],[42,1,"もの"],[49,1,"かれ"],[54,2,"しぞく"],[59,2,"けっとう"],[63,1,"しめ"],[75,1,"もの"],[82,1,"あき"]],"text":"次にあげる人々はテル・メラ、テル・ハレサ、ケルブ、アダンおよびインメルから上って来た者であったが、彼らはその氏族とその血統とを示して、そのイスラエルの者であることを明らかにすることができなかった。"},{"ref":"Ezra.2.60","start":15002060,"end":15002060,"break":"none","ruby":[[8,2,"しそん"],[15,2,"しそん"],[22,2,"しそん"],[25,1,"あ"],[34,1,"にん"]],"text":"すなわちデラヤの子孫、トビヤの子孫、ネコダの子孫で合わせて六百五十二人。"},{"ref":"Ezra.2.61","start":15002061,"end":15002061,"break":"none","ruby":[[0,2,"さいし"],[3,2,"しそん"],[14,2,"しそん"],[22,2,"しそん"],[31,2,"しそん"],[56,1,"むすめ"],[64,1,"つま"],[75,1,"な"],[77,1,"よ"]],"text":"祭司の子孫のうちにはハバヤの子孫、ハッコヅの子孫、バルジライの子孫があった。バルジライはギレアデびとバルジライの娘たちのうちから妻をめとったので、その名で呼ばれることになった。"},{"ref":"Ezra.2.62","start":15002062,"end":15002062,"break":"none","ruby":[[4,1,"もの"],[6,2,"けいふ"],[9,1,"の"],[12,1,"もの"],[19,2,"じぶん"],[22,1,"な"],[24,1,"たず"],[28,1,"み"],[40,1,"けが"],[43,1,"もの"],[48,2,"さいし"],[51,1,"しょく"],[54,1,"のぞ"]],"text":"これらの者は系譜に載った者たちのうちに自分の名を尋ねたが見いだされなかったので、汚れた者として、祭司の職から除かれた。"},{"ref":"Ezra.2.63","start":15002063,"end":15002063,"break":"none","ruby":[[0,2,"そうとく"],[3,1,"かれ"],[6,1,"つ"],[19,1,"み"],[24,2,"さいし"],[27,1,"おこ"],[35,1,"せい"],[38,1,"もの"],[40,1,"た"],[49,1,"い"]],"text":"総督は彼らに告げて、ウリムとトンミムを身につける祭司の興るまでは、いと聖なる物を食べてはならないと言った。"},{"ref":"Ezra.2.64","start":15002064,"end":15002064,"break":"paragraph","ruby":[[0,2,"かいしゅう"],[3,1,"あ"],[15,1,"にん"]],"text":"会衆は合わせて四万二千三百六十人であった。"},{"ref":"Ezra.2.65","start":15002065,"end":15002065,"break":"none","ruby":[[16,1,"あ"],[27,1,"にん"],[31,1,"うた"],[35,2,"だんじょ"],[39,1,"にん"]],"text":"このほかに、しもべおよびはしため合わせて七千三百三十七人、また歌うたう男女二百人あった。"},{"ref":"Ezra.2.66","start":15002066,"end":15002066,"break":"none","ruby":[[2,1,"うま"],[9,1,"とう"],[13,2,"らば"],[21,1,"とう"]],"text":"その馬は七百三十六頭、その騾馬は二百四十五頭、"},{"ref":"Ezra.2.67","start":15002067,"end":15002067,"break":"none","ruby":[[11,1,"とう"],[24,1,"とう"]],"text":"そのらくだは四百三十五頭、そのろばは六千七百二十頭あった。"},{"ref":"Ezra.2.68","start":15002068,"end":15002068,"break":"paragraph","ruby":[[0,2,"しぞく"],[3,1,"ちょう"],[4,2,"すうにん"],[15,1,"しゅ"],[17,1,"みや"],[19,1,"ところ"],[23,1,"とき"],[25,1,"かみ"],[27,1,"みや"],[32,1,"ところ"],[34,1,"た"],[40,2,"まごころ"],[45,1,"そな"],[47,1,"もの"]],"text":"氏族の長数人はエルサレムにある主の宮の所にきた時、神の宮をもとの所に建てるために真心よりの供え物をささげた。"},{"ref":"Ezra.2.69","start":15002069,"end":15002069,"break":"none","ruby":[[7,1,"ちから"],[9,1,"したが"],[12,2,"こうじ"],[18,1,"くら"],[20,1,"おさ"],[27,1,"きん"],[36,1,"ぎん"],[42,2,"さいし"],[45,2,"いふく"]],"text":"すなわち、その力に従って工事のために倉に納めたものは、金六万一千ダリク、銀五千ミナ、祭司の衣服百かさねであった。"},{"ref":"Ezra.2.70","start":15002070,"end":15002070,"break":"paragraph","ruby":[[0,2,"さいし"],[11,1,"たみ"],[15,1,"もの"],[27,2,"きんこう"],[30,1,"す"],[33,1,"うた"],[37,1,"もの"],[39,2,"もんえい"],[44,1,"みや"],[46,1,"つか"],[57,2,"まちまち"],[60,1,"す"],[63,2,"いっぱん"],[74,2,"じぶん"],[79,2,"まちまち"],[82,1,"す"]],"text":"祭司、レビびと、および民のある者はエルサレムおよびその近郊に住み、歌うたう者、門衛および宮に仕えるしもべたちはその町々に住み、一般のイスラエルびとは自分たちの町々に住んだ。"}]