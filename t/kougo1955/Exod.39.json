[{"ref":"Exod.39.1","start":2039001,"end":2039001,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"あお"],[4,1,"いと"],[6,1,"むらさき"],[7,1,"いと"],[9,1,"ひ"],[10,1,"いと"],[13,2,"せいじょ"],[16,1,"つとめ"],[21,2,"あみもの"],[24,1,"ふく"],[26,1,"つく"],[39,1,"せい"],[42,1,"ふく"],[44,1,"つく"],[48,1,"しゅ"],[54,1,"めい"]],"text":"彼らは青糸、紫糸、緋糸で、聖所の務のための編物の服を作った。またアロンのために聖なる服を作った。主がモーセに命じられたとおりである。"},{"ref":"Exod.39.2","start":2039002,"end":2039002,"break":"paragraph","ruby":[[2,2,"きんし"],[5,1,"あお"],[6,1,"いと"],[8,1,"むらさき"],[9,1,"いと"],[11,1,"ひ"],[12,1,"いと"],[14,2,"あま"],[17,2,"ねんし"],[24,1,"つく"]],"text":"また金糸、青糸、紫糸、緋糸、亜麻の撚糸でエポデを作った。"},{"ref":"Exod.39.3","start":2039003,"end":2039003,"break":"none","ruby":[[2,1,"きん"],[4,1,"う"],[6,1,"の"],[9,1,"いた"],[16,1,"き"],[19,1,"いと"],[23,1,"あお"],[24,1,"いと"],[26,1,"むらさき"],[27,1,"いと"],[29,1,"ひ"],[30,1,"いと"],[32,2,"あま"],[35,2,"ねんし"],[38,1,"まじ"],[42,1,"たく"],[45,2,"さいく"]],"text":"また金を打ち延べて板とし、これを切って糸とし、青糸、紫糸、緋糸、亜麻の撚糸に交えて、巧みな細工とした。"},{"ref":"Exod.39.4","start":2039004,"end":2039004,"break":"none","ruby":[[9,1,"かた"],[13,1,"つく"],[24,2,"りょうはし"]],"text":"また、これがために肩ひもを作ってこれにつけ、その両端でこれにつけた。"},{"ref":"Exod.39.5","start":2039005,"end":2039005,"break":"none","ruby":[[4,1,"うえ"],[14,1,"おび"],[17,1,"おな"],[23,1,"おな"],[29,2,"きんし"],[32,1,"あお"],[33,1,"いと"],[35,1,"むらさき"],[36,1,"いと"],[38,1,"ひ"],[39,1,"いと"],[41,2,"あま"],[44,2,"ねんし"],[47,1,"つく"],[51,1,"しゅ"],[57,1,"めい"]],"text":"エポデの上で、これをつかねる帯は、同じきれで、同じように、金糸、青糸、紫糸、緋糸、亜麻の撚糸で作った。主がモーセに命じられたとおりである。"},{"ref":"Exod.39.6","start":2039006,"end":2039006,"break":"paragraph","ruby":[[3,1,"しま"],[8,2,"さいく"],[13,2,"きんし"],[16,1,"あみ"],[17,2,"ざいく"],[26,1,"いん"],[28,2,"ちょうこく"],[42,1,"こ"],[46,1,"な"],[48,1,"きざ"]],"text":"また、縞めのうを細工して、金糸の編細工にはめ、これに印を彫刻するように、イスラエルの子たちの名を刻み、"},{"ref":"Exod.39.7","start":2039007,"end":2039007,"break":"none","ruby":[[7,1,"かた"],[21,1,"こ"],[25,2,"きねん"],[28,1,"いし"],[33,1,"しゅ"],[39,1,"めい"]],"text":"これをエポデの肩ひもにつけて、イスラエルの子たちの記念の石とした。主がモーセに命じられたとおりである。"},{"ref":"Exod.39.8","start":2039008,"end":2039008,"break":"paragraph","ruby":[[2,2,"むねあて"],[5,1,"たく"],[19,1,"つく"],[25,1,"つく"],[33,2,"きんし"],[36,1,"あお"],[37,1,"いと"],[39,1,"むらさき"],[40,1,"いと"],[42,1,"ひ"],[43,1,"いと"],[45,2,"あま"],[48,2,"ねんし"],[51,1,"つく"]],"text":"また胸当を巧みなわざをもって、エポデの作りのように作った。すなわち金糸、青糸、紫糸、緋糸、亜麻の撚糸で作った。"},{"ref":"Exod.39.9","start":2039009,"end":2039009,"break":"none","ruby":[[0,2,"むねあて"],[6,1,"お"],[10,1,"かく"],[22,1,"お"],[26,1,"なが"],[30,1,"ゆび"],[31,1,"あた"],[36,1,"はば"],[39,1,"ゆび"],[40,1,"あた"]],"text":"胸当は二つに折って四角にした。すなわち二つに折って、長さを一指当りとし、幅も一指当りとした。"},{"ref":"Exod.39.10","start":2039010,"end":2039010,"break":"none","ruby":[[2,1,"なか"],[4,2,"ほうせき"],[7,1,"れつ"],[18,1,"こう"],[19,2,"ぎょくずい"],[22,1,"き"],[27,1,"いし"],[29,2,"すいしょう"],[32,1,"れつ"],[34,1,"だい"],[36,1,"れつ"]],"text":"その中に宝石四列をはめた。すなわち、紅玉髄、貴かんらん石、水晶の列を第一列とし、"},{"ref":"Exod.39.11","start":2039011,"end":2039011,"break":"none","ruby":[[0,1,"だい"],[2,1,"れつ"],[8,1,"いし"],[13,1,"あか"],[14,1,"しま"]],"text":"第二列は、ざくろ石、るり、赤縞めのう、"},{"ref":"Exod.39.12","start":2039012,"end":2039012,"break":"none","ruby":[[0,1,"だい"],[2,1,"れつ"],[4,1,"き"],[5,2,"すいしょう"],[12,1,"むらさき"],[13,2,"すいしょう"]],"text":"第三列は黄水晶、めのう、紫水晶、"},{"ref":"Exod.39.13","start":2039013,"end":2039013,"break":"none","ruby":[[0,1,"だい"],[2,1,"れつ"],[4,1,"き"],[5,2,"へきぎょく"],[8,1,"しま"],[13,2,"へきぎょく"],[24,1,"きん"],[26,1,"あみ"],[27,2,"ざいく"],[30,1,"なか"],[34,1,"こ"]],"text":"第四列は黄碧玉、縞めのう、碧玉であって、これらを金の編細工の中にはめ込んだ。"},{"ref":"Exod.39.14","start":2039014,"end":2039014,"break":"none","ruby":[[2,2,"ほうせき"],[11,1,"こ"],[15,1,"な"],[24,1,"な"],[26,1,"ひと"],[38,1,"いん"],[40,2,"ちょうこく"],[49,2,"ぶぞく"],[57,1,"な"],[59,1,"きざ"]],"text":"その宝石はイスラエルの子たちの名にしたがい、その名と等しく十二とし、おのおの印の彫刻のように、十二部族のためにその名を刻んだ。"},{"ref":"Exod.39.15","start":2039015,"end":2039015,"break":"none","ruby":[[4,2,"ざいく"],[10,2,"じゅんきん"],[17,2,"むねあて"]],"text":"またひも細工にねじた純金のくさりを胸当につけた。"},{"ref":"Exod.39.16","start":2039016,"end":2039016,"break":"none","ruby":[[2,1,"きん"],[7,1,"あみ"],[8,2,"ざいく"],[15,1,"きん"],[17,1,"かん"],[20,1,"つく"],[28,1,"かん"],[30,2,"むねあて"],[33,2,"りょうはし"]],"text":"また金の二つの編細工と、二つの金の環とを作り、その二つの環を胸当の両端につけた。"},{"ref":"Exod.39.17","start":2039017,"end":2039017,"break":"none","ruby":[[3,1,"すじ"],[5,1,"きん"],[10,2,"むねあて"],[13,1,"はし"],[18,1,"かん"]],"text":"かの二筋の金のひもを胸当の端の二つの環につけた。"},{"ref":"Exod.39.18","start":2039018,"end":2039018,"break":"none","ruby":[[7,1,"すじ"],[12,1,"た"],[14,2,"りょうはし"],[23,1,"あみ"],[24,2,"ざいく"],[34,1,"かた"],[41,1,"まえ"]],"text":"ただし、その二筋のひもの他の両端を、かの二つの編細工につけ、エポデの肩ひもにつけて前にくるようにした。"},{"ref":"Exod.39.19","start":2039019,"end":2039019,"break":"none","ruby":[[5,1,"きん"],[7,1,"かん"],[9,1,"つく"],[16,2,"むねあて"],[19,2,"りょうはし"],[34,1,"せっ"],[37,2,"うちがわ"],[40,1,"ふち"]],"text":"また二つの金の環を作って、これを胸当の両端につけた。すなわちエポデに接する内側の縁にこれをつけた。"},{"ref":"Exod.39.20","start":2039020,"end":2039020,"break":"none","ruby":[[2,1,"きん"],[4,1,"かん"],[8,1,"つく"],[22,1,"かた"],[26,1,"した"],[28,2,"ぶぶん"],[34,1,"まえ"],[36,1,"ほう"],[44,1,"め"],[46,1,"ちか"],[53,1,"おび"],[55,1,"うえ"],[57,1,"ほう"]],"text":"また金の環二つを作って、これをエポデの二つの肩ひもの下の部分につけ、前の方で、そのつなぎ目に近く、エポデの帯の上の方にくるようにした。"},{"ref":"Exod.39.21","start":2039021,"end":2039021,"break":"none","ruby":[[0,2,"むねあて"],[3,1,"あお"],[13,1,"かん"],[19,1,"かん"],[21,1,"むす"],[30,1,"おび"],[32,1,"うえ"],[34,1,"ほう"],[49,2,"むねあて"],[57,1,"はな"],[67,1,"しゅ"],[73,1,"めい"]],"text":"胸当は青ひもをもって、その環をエポデの環に結びつけ、エポデの帯の上の方にくるようにした。こうして、胸当がエポデから離れないようにした。主がモーセに命じられたとおりである。"},{"ref":"Exod.39.22","start":2039022,"end":2039022,"break":"paragraph","ruby":[[6,1,"ぞく"],[9,2,"うわふく"],[16,2,"あおじ"],[19,2,"おりもの"],[22,1,"つく"]],"text":"またエポデに属する上服は、すべて青地の織物で作った。"},{"ref":"Exod.39.23","start":2039023,"end":2039023,"break":"none","ruby":[[0,2,"うわふく"],[3,1,"くち"],[9,1,"なか"],[17,1,"くち"],[19,2,"しゅうい"],[34,1,"ふち"]],"text":"上服の口はそのまん中にあって、その口の周囲には、よろいのえりのように縁をつけて、ほころびないようにした。"},{"ref":"Exod.39.24","start":2039024,"end":2039024,"break":"none","ruby":[[0,2,"うわふく"],[7,1,"あお"],[8,1,"いと"],[10,1,"むらさき"],[11,1,"いと"],[13,1,"ひ"],[14,1,"いと"],[16,2,"あま"],[19,2,"ねんし"],[27,1,"つく"]],"text":"上服のすそには青糸、紫糸、緋糸、亜麻の撚糸で、ざくろを作りつけ、"},{"ref":"Exod.39.25","start":2039025,"end":2039025,"break":"none","ruby":[[2,2,"じゅんきん"],[5,1,"すず"],[7,1,"つく"],[12,1,"すず"],[14,2,"うわふく"],[20,2,"しゅうい"],[33,1,"あいだ"]],"text":"また純金で鈴を作り、その鈴を上服のすその周囲の、ざくろとざくろとの間につけた。"},{"ref":"Exod.39.26","start":2039026,"end":2039026,"break":"none","ruby":[[4,1,"すず"],[10,1,"すず"],[17,1,"つとめ"],[19,2,"うわふく"],[25,2,"しゅうい"],[32,1,"しゅ"],[38,1,"めい"]],"text":"すなわち鈴にざくろ、鈴にざくろと、務の上服のすその周囲につけた。主がモーセに命じられたとおりである。"},{"ref":"Exod.39.27","start":2039027,"end":2039027,"break":"paragraph","ruby":[[8,1,"こ"],[16,2,"あま"],[18,1,"いと"],[20,1,"お"],[23,1,"した"],[24,1,"ふく"],[26,1,"つく"]],"text":"またアロンとその子たちのために、亜麻糸で織った下服を作り、"},{"ref":"Exod.39.28","start":2039028,"end":2039028,"break":"none","ruby":[[0,2,"あま"],[2,1,"ぬの"],[4,2,"ぼうし"],[7,1,"つく"],[10,2,"あま"],[12,1,"ぬの"],[14,1,"うるわ"],[17,1,"とう"],[18,1,"ぬの"],[20,1,"つく"],[23,2,"あま"],[26,2,"ねんし"],[29,1,"ぬの"],[32,1,"した"],[36,1,"つく"]],"text":"亜麻布で帽子を作り、亜麻布で麗しい頭布を作り、亜麻の撚糸の布で、下ばきを作り、"},{"ref":"Exod.39.29","start":2039029,"end":2039029,"break":"none","ruby":[[0,2,"あま"],[3,2,"ねんし"],[8,1,"あお"],[9,1,"いと"],[11,1,"むらさき"],[12,1,"いと"],[14,1,"ひ"],[15,1,"いと"],[18,1,"いろ"],[24,1,"お"],[27,1,"おび"],[29,1,"つく"],[33,1,"しゅ"],[39,1,"めい"]],"text":"亜麻の撚糸および青糸、紫糸、緋糸で、色とりどりに織った帯を作った。主がモーセに命じられたとおりである。"},{"ref":"Exod.39.30","start":2039030,"end":2039030,"break":"paragraph","ruby":[[2,2,"じゅんきん"],[9,1,"せい"],[12,1,"かんむり"],[14,1,"まえ"],[15,1,"いた"],[17,1,"つく"],[20,1,"いん"],[22,2,"ちょうこく"],[31,1,"うえ"],[34,1,"しゅ"],[36,1,"せい"],[39,1,"もの"],[44,2,"もじ"],[47,1,"か"]],"text":"また純金をもって、聖なる冠の前板を作り、印の彫刻のように、その上に「主に聖なる者」という文字を書き、"},{"ref":"Exod.39.31","start":2039031,"end":2039031,"break":"none","ruby":[[3,1,"あお"],[14,2,"ぼうし"],[17,1,"うえ"],[19,1,"むす"],[25,1,"しゅ"],[31,1,"めい"]],"text":"これに青ひもをつけて、それを帽子の上に結びつけた。主がモーセに命じられたとおりである。"},{"ref":"Exod.39.32","start":2039032,"end":2039032,"break":"paragraph","ruby":[[4,2,"かいけん"],[7,2,"てんまく"],[11,2,"まくや"],[20,2,"こうじ"],[23,1,"おわ"],[33,2,"ひとびと"],[39,1,"しゅ"],[45,1,"めい"]],"text":"こうして会見の天幕なる幕屋の、もろもろの工事が終った。イスラエルの人々はすべて主がモーセに命じられたようにおこなった。"},{"ref":"Exod.39.33","start":2039033,"end":2039033,"break":"none","ruby":[[0,1,"かれ"],[3,2,"まくや"],[6,2,"てんまく"],[18,1,"うつわ"],[27,1,"たずさ"],[40,1,"こま"],[44,1,"わく"],[48,2,"よこぎ"],[53,1,"はしら"],[57,1,"ざ"]],"text":"彼らは幕屋と天幕およびそのもろもろの器をモーセのもとに携えてきた。すなわち、その鉤、その枠、その横木、その柱、その座、"},{"ref":"Exod.39.34","start":2039034,"end":2039034,"break":"none","ruby":[[3,1,"ぞ"],[6,2,"おひつじ"],[9,1,"かわ"],[20,1,"かわ"],[26,1,"へだ"],[29,2,"たれまく"]],"text":"あかね染めの雄羊の皮のおおい、じゅごんの皮のおおい、隔ての垂幕、"},{"ref":"Exod.39.35","start":2039035,"end":2039035,"break":"none","ruby":[[4,1,"はこ"],[12,3,"しょくざいしょ"]],"text":"あかしの箱と、そのさお、贖罪所、"},{"ref":"Exod.39.36","start":2039036,"end":2039036,"break":"none","ruby":[[0,1,"つくえ"],[10,1,"うつわ"],[12,1,"そな"]],"text":"机と、そのもろもろの器、供えのパン、"},{"ref":"Exod.39.37","start":2039037,"end":2039037,"break":"none","ruby":[[0,2,"じゅんきん"],[3,2,"しょくだい"],[13,1,"ざら"],[19,1,"れつ"],[21,1,"なら"],[28,1,"ざら"],[38,1,"うつわ"],[48,1,"あぶら"]],"text":"純金の燭台と、そのともしび皿、すなわち列に並べるともしび皿と、そのもろもろの器、およびそのともし油、"},{"ref":"Exod.39.38","start":2039038,"end":2039038,"break":"none","ruby":[[0,1,"きん"],[2,2,"さいだん"],[5,1,"そそ"],[7,1,"あぶら"],[9,1,"こう"],[13,2,"くんこう"],[16,2,"まくや"],[19,2,"いりぐち"]],"text":"金の祭壇、注ぎ油、香ばしい薫香、幕屋の入口のとばり、"},{"ref":"Exod.39.39","start":2039039,"end":2039039,"break":"none","ruby":[[0,2,"せいどう"],[3,2,"さいだん"],[8,2,"せいどう"],[11,2,"こうし"],[30,1,"うつわ"],[32,2,"せんばん"],[37,1,"だい"]],"text":"青銅の祭壇、その青銅の格子と、そのさお、およびそのもろもろの器、洗盤とその台、"},{"ref":"Exod.39.40","start":2039040,"end":2039040,"break":"none","ruby":[[0,1,"にわ"],[9,1,"はしら"],[13,1,"ざ"],[15,1,"にわ"],[17,1,"もん"],[30,1,"くぎ"],[34,2,"かいけん"],[37,2,"てんまく"],[40,2,"まくや"],[43,1,"もち"],[51,1,"うつわ"]],"text":"庭のあげばり、その柱とその座、庭の門のとばり、そのひもとその釘、また会見の天幕の幕屋に用いるもろもろの器、"},{"ref":"Exod.39.41","start":2039041,"end":2039041,"break":"none","ruby":[[0,2,"せいじょ"],[3,1,"つとめ"],[7,2,"あみもの"],[10,1,"ふく"],[16,2,"さいし"],[19,1,"つとめ"],[26,2,"さいし"],[32,1,"せい"],[35,1,"ふく"],[41,1,"こ"],[45,1,"ふく"]],"text":"聖所で務をなす編物の服、すなわち祭司の務をなすための祭司アロンの聖なる服およびその子たちの服。"},{"ref":"Exod.39.42","start":2039042,"end":2039042,"break":"none","ruby":[[6,2,"ひとびと"],[13,1,"しゅ"],[19,1,"めい"],[34,2,"こうじ"]],"text":"イスラエルの人々は、すべて主がモーセに命じられたように、そのすべての工事をした。"},{"ref":"Exod.39.43","start":2039043,"end":2039043,"break":"none","ruby":[[10,2,"こうじ"],[13,1,"み"],[17,1,"かれ"],[20,1,"しゅ"],[22,1,"めい"],[49,1,"かれ"],[52,2,"しゅくふく"]],"text":"モーセがそのすべての工事を見ると、彼らは主が命じられたとおりに、それをなしとげていたので、モーセは彼らを祝福した。"}]