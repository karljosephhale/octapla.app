[{"ref":"Josh.14.1","start":6014001,"end":6014001,"break":"paragraph","ruby":[[6,2,"ひとびと"],[14,1,"ち"],[16,1,"う"],[19,1,"し"],[20,1,"ぎょう"],[22,1,"ち"],[25,1,"つぎ"],[39,2,"さいし"],[50,1,"こ"],[65,2,"ひとびと"],[68,2,"ぶぞく"],[71,2,"しゅちょう"],[80,1,"かれ"],[83,1,"わ"]],"text":"イスラエルの人々が、カナンの地で受けた嗣業の地は、次のとおりである。すなわち、祭司エレアザル、ヌンの子ヨシュア、およびイスラエルの人々の部族の首長たちが、これを彼らに分かち、"},{"ref":"Josh.14.2","start":6014002,"end":6014002,"break":"none","ruby":[[0,1,"しゅ"],[9,1,"めい"],[31,2,"ぶぞく"],[35,1,"なか"],[38,2,"ぶぞく"],[43,1,"し"],[44,1,"ぎょう"],[48,1,"あた"]],"text":"主がモーセによって命じられたように、くじによって、これを九つの部族と、半ばの部族とに、嗣業として与えた。"},{"ref":"Josh.14.3","start":6014003,"end":6014003,"break":"none","ruby":[[8,1,"む"],[11,1,"がわ"],[21,1,"た"],[26,2,"ぶぞく"],[30,1,"なか"],[33,2,"ぶぞく"],[38,1,"し"],[39,1,"ぎょう"],[41,1,"あた"],[62,1,"かれ"],[65,1,"なか"],[67,1,"し"],[68,1,"ぎょう"],[70,1,"あた"]],"text":"これはヨルダンの向こう側で、モーセがすでに他の二つの部族と、半ばの部族とに、嗣業を与えていたからである。ただしレビびとには、彼らの中で嗣業を与えず、"},{"ref":"Josh.14.4","start":6014004,"end":6014004,"break":"none","ruby":[[4,2,"しそん"],[22,2,"ぶぞく"],[40,2,"とち"],[43,1,"わ"],[45,1,"まえ"],[47,1,"あた"],[56,1,"す"],[60,2,"まちまち"],[66,2,"かちく"],[69,1,"も"],[71,1,"もの"],[74,1,"お"],[79,2,"ほうぼく"],[81,1,"ち"],[83,1,"あた"]],"text":"ヨセフの子孫が、マナセと、エフライムの二つの部族となったからである。レビびとには土地の分け前を与えず、ただ、その住むべき町々および、家畜と持ち物とを置くための放牧地を与えたばかりであった。"},{"ref":"Josh.14.5","start":6014005,"end":6014005,"break":"none","ruby":[[6,2,"ひとびと"],[10,1,"しゅ"],[16,1,"めい"],[32,1,"ち"],[34,1,"わ"]],"text":"イスラエルの人々は、主がモーセに命じられたようにおこなって、その地を分けた。"},{"ref":"Josh.14.6","start":6014006,"end":6014006,"break":"paragraph","ruby":[[0,1,"とき"],[6,2,"ひとびと"],[19,1,"ところ"],[34,1,"こ"],[45,1,"い"],[50,1,"しゅ"],[75,1,"かみ"],[77,1,"ひと"],[82,1,"い"]],"text":"時に、ユダの人々がギルガルのヨシュアの所にきて、ケニズびとエフンネの子カレブが、ヨシュアに言った、「主がカデシ・バルネアで、あなたとわたしとについて、神の人モーセに言われたことを、あなたはごぞんじです。"},{"ref":"Josh.14.7","start":6014007,"end":6014007,"break":"none","ruby":[[0,1,"しゅ"],[12,1,"ち"],[14,1,"さぐ"],[39,1,"とき"],[47,1,"さい"],[60,2,"じぶん"],[63,1,"しん"],[70,2,"ふくめい"]],"text":"主のしもべモーセが、この地を探るために、わたしをカデシ・バルネアからつかわした時、わたしは四十歳でした。そしてわたしは、自分の信ずるところを復命しました。"},{"ref":"Josh.14.8","start":6014008,"end":6014008,"break":"none","ruby":[[4,1,"とも"],[6,1,"のぼ"],[9,1,"い"],[12,2,"きょうだい"],[18,1,"たみ"],[20,1,"こころ"],[38,1,"まった"],[42,1,"かみ"],[44,1,"しゅ"],[46,1,"したが"]],"text":"しかし、共に上って行った兄弟たちは、民の心をくじいてしまいましたが、わたしは全くわが神、主に従いました。"},{"ref":"Josh.14.9","start":6014009,"end":6014009,"break":"none","ruby":[[2,1,"ひ"],[7,1,"ちか"],[11,1,"い"],[22,1,"あし"],[24,1,"ふ"],[27,1,"ち"],[34,1,"なが"],[40,2,"しそん"],[44,1,"し"],[45,1,"ぎょう"],[58,1,"まった"],[62,1,"かみ"],[64,1,"しゅ"],[66,1,"したが"]],"text":"その日モーセは誓って、言いました、『おまえの足で踏んだ地は、かならず長くおまえと子孫との嗣業となるであろう。おまえが全くわが神、主に従ったからである』。"},{"ref":"Josh.14.10","start":6014010,"end":6014010,"break":"none","ruby":[[0,1,"しゅ"],[4,2,"ことば"],[11,1,"かた"],[15,1,"とき"],[29,2,"あらの"],[32,1,"あゆ"],[38,1,"ねん"],[40,1,"あいだ"],[42,1,"しゅ"],[44,1,"い"],[56,1,"い"],[77,2,"こんにち"],[85,1,"さい"]],"text":"主がこの言葉をモーセに語られた時からこのかた、イスラエルが荒野に歩んだ四十五年の間、主は言われたように、わたしを生きながらえさせてくださいました。わたしは今日すでに八十五歳ですが、"},{"ref":"Josh.14.11","start":6014011,"end":6014011,"break":"none","ruby":[[0,1,"いま"],[18,1,"ひ"],[24,1,"すこ"],[34,1,"いま"],[36,1,"ちから"],[41,1,"とき"],[43,1,"ちから"],[45,1,"おと"],[52,1,"はたら"],[57,1,"たたか"],[61,1,"こた"]],"text":"今もなお、モーセがわたしをつかわした日のように、健やかです。わたしの今の力は、あの時の力に劣らず、どんな働きにも、戦いにも堪えることができます。"},{"ref":"Josh.14.12","start":6014012,"end":6014012,"break":"none","ruby":[[3,1,"しゅ"],[7,1,"ひ"],[8,1,"かた"],[14,2,"さんち"],[21,1,"いま"],[34,1,"ひ"],[39,1,"き"],[61,2,"まちまち"],[64,1,"おお"],[67,2,"けんご"],[76,1,"しゅ"],[82,1,"とも"],[98,1,"しゅ"],[100,1,"い"],[108,1,"かれ"],[111,1,"お"],[113,1,"はら"]],"text":"それで主があの日語られたこの山地を、どうか今、わたしにください。あの日あなたも聞いたように、そこにはアナキびとがいて、その町々は大きく堅固です。しかし、主がわたしと共におられて、わたしはついには、主が言われたように、彼らを追い払うことができるでしょう」。"},{"ref":"Josh.14.13","start":6014013,"end":6014013,"break":"paragraph","ruby":[[13,1,"こ"],[18,2,"しゅくふく"],[27,1,"かれ"],[29,1,"あた"],[32,1,"し"],[33,1,"ぎょう"]],"text":"そこでヨシュアはエフンネの子カレブを祝福し、ヘブロンを彼に与えて嗣業とさせた。"},{"ref":"Josh.14.14","start":6014014,"end":6014014,"break":"none","ruby":[[20,1,"こ"],[25,1,"し"],[26,1,"ぎょう"],[32,2,"こんにち"],[35,1,"いた"],[41,1,"かれ"],[43,1,"まった"],[51,1,"かみ"],[53,1,"しゅ"],[55,1,"したが"]],"text":"こうしてヘブロンは、ケニズびとエフンネの子カレブの嗣業となって、今日に至っている。彼が全くイスラエルの神、主に従ったからである。"},{"ref":"Josh.14.15","start":6014015,"end":6014015,"break":"none","ruby":[[5,1,"な"],[39,1,"もっと"],[41,1,"おお"],[45,1,"ひと"],[57,1,"ち"],[59,2,"せんそう"]],"text":"ヘブロンの名は、もとはキリアテ・アルバといった。アルバは、アナキびとのうちの、最も大いなる人であった。こうしてこの地に戦争はやんだ。"}]