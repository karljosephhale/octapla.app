[{"ref":"2Chr.21.1","start":14021001,"end":14021001,"break":"paragraph","ruby":[[6,2,"せんぞ"],[11,1,"とも"],[13,1,"ねむ"],[16,2,"せんぞ"],[21,1,"とも"],[27,1,"まち"],[29,1,"ほうむ"],[35,1,"こ"],[40,1,"かわ"],[43,1,"おう"]],"text":"ヨシャパテは先祖たちと共に眠り、先祖たちと共にダビデの町に葬られ、その子ヨラムが代って王となった。"},{"ref":"2Chr.21.2","start":14021002,"end":14021002,"break":"none","ruby":[[6,1,"こ"],[12,2,"きょうだい"],[50,1,"みな"],[54,1,"おう"],[61,1,"こ"]],"text":"ヨシャパテの子であるその兄弟たちはアザリヤ、エヒエル、ゼカリヤ、アザリヤ、ミカエルおよびシパテヤで、皆ユダの王ヨシャパテの子たちであった。"},{"ref":"2Chr.21.3","start":14021003,"end":14021003,"break":"none","ruby":[[2,1,"ちち"],[4,1,"かれ"],[7,1,"きん"],[9,1,"ぎん"],[11,2,"ほうもつ"],[14,2,"たまもの"],[17,1,"おお"],[19,1,"あた"],[27,2,"ようがい"],[30,2,"まちまち"],[33,1,"あた"],[42,2,"ちょうし"],[48,1,"くに"],[54,1,"あた"]],"text":"その父は彼らに金、銀、宝物の賜物を多く与え、またユダの要害の町々を与えたが、ヨラムは長子なので、国はヨラムに与えた。"},{"ref":"2Chr.21.4","start":14021004,"end":14021004,"break":"none","ruby":[[6,1,"ちち"],[8,1,"くらい"],[10,1,"のぼ"],[13,1,"つよ"],[18,1,"とき"],[22,2,"きょうだい"],[39,1,"ころ"],[52,2,"すうにん"],[55,1,"ころ"]],"text":"ヨラムはその父の位に登って強くなった時、その兄弟たちをことごとくつるぎにかけて殺し、またユダのつかさたち数人を殺した。"},{"ref":"2Chr.21.5","start":14021005,"end":14021005,"break":"none","ruby":[[4,1,"くらい"],[9,1,"とき"],[13,1,"さい"],[23,1,"ねん"],[25,1,"あいだ"],[26,1,"よ"],[28,1,"おさ"]],"text":"ヨラムは位についた時三十二歳で、エルサレムで八年の間世を治めた。"},{"ref":"2Chr.21.6","start":14021006,"end":14021006,"break":"none","ruby":[[0,1,"かれ"],[6,1,"いえ"],[19,1,"おう"],[23,1,"みち"],[25,1,"あゆ"],[33,1,"むすめ"],[35,1,"つま"],[50,1,"かれ"],[52,1,"しゅ"],[54,1,"め"],[56,1,"まえ"],[58,1,"あく"]],"text":"彼はアハブの家がしたようにイスラエルの王たちの道に歩んだ。アハブの娘を妻としたからである。このように彼は主の目の前に悪をおこなったが、"},{"ref":"2Chr.21.7","start":14021007,"end":14021007,"break":"none","ruby":[[0,1,"しゅ"],[9,1,"むす"],[13,2,"けいやく"],[22,1,"かれ"],[26,2,"しそん"],[39,1,"あた"],[43,2,"やくそく"],[59,1,"いえ"],[61,1,"ほろ"],[67,1,"この"]],"text":"主はさきにダビデと結ばれた契約のゆえに、また彼とその子孫とにながく、ともしびを与えると約束されたことによって、ダビデの家を滅ぼすことを好まれなかった。"},{"ref":"2Chr.21.8","start":14021008,"end":14021008,"break":"paragraph","ruby":[[4,1,"よ"],[18,2,"しはい"],[21,1,"だっ"],[28,1,"おう"],[30,1,"た"]],"text":"ヨラムの世にエドムがそむいて、ユダの支配を脱し、みずから王を立てたので、"},{"ref":"2Chr.21.9","start":14021009,"end":14021009,"break":"none","ruby":[[6,2,"しょうこう"],[18,2,"せんしゃ"],[21,1,"したが"],[24,1,"わた"],[27,1,"い"],[30,1,"よる"],[35,1,"た"],[37,1,"あ"],[42,2,"じぶん"],[45,2,"ほうい"],[59,2,"せんしゃ"],[62,2,"たいちょう"],[67,1,"う"]],"text":"ヨラムはその将校たち、およびすべての戦車を従えて渡って行き、夜のうちに立ち上がって、自分を包囲しているエドムびととその戦車の隊長たちを撃った。"},{"ref":"2Chr.21.10","start":14021010,"end":14021010,"break":"none","ruby":[[16,2,"しはい"],[19,1,"だっ"],[22,2,"こんにち"],[25,1,"いた"],[48,2,"しはい"],[51,1,"だっ"],[59,2,"せんぞ"],[64,1,"かみ"],[66,1,"しゅ"],[68,1,"す"]],"text":"エドムはこのようにそむいてユダの支配を脱し、今日に至っている。そのころリブナもまたそむいてユダの支配を脱した。ヨラムが先祖たちの神、主を捨てたからである。"},{"ref":"2Chr.21.11","start":14021011,"end":14021011,"break":"paragraph","ruby":[[0,1,"かれ"],[7,2,"さんち"],[10,1,"たか"],[12,1,"ところ"],[14,1,"つく"],[24,1,"たみ"],[26,2,"かんいん"],[29,1,"おこな"],[36,1,"まど"]],"text":"彼はまたユダの山地に高き所を造って、エルサレムの民に姦淫を行わせ、ユダを惑わした。"},{"ref":"2Chr.21.12","start":14021012,"end":14021012,"break":"none","ruby":[[2,1,"とき"],[3,3,"よげんしゃ"],[11,1,"つぎ"],[17,1,"つう"],[19,2,"てがみ"],[29,1,"き"],[37,2,"せんぞ"],[43,1,"かみ"],[45,1,"しゅ"],[49,1,"おお"],[60,1,"ちち"],[67,1,"みち"],[69,1,"あゆ"],[78,1,"おう"],[82,1,"みち"],[84,1,"あゆ"]],"text":"その時預言者エリヤから次のような一通の手紙がヨラムのもとに来た、「あなたの先祖ダビデの神、主はこう仰せられる、『あなたは父ヨシャパテの道に歩まず、またユダの王アサの道に歩まないで、"},{"ref":"2Chr.21.13","start":14021013,"end":14021013,"break":"none","ruby":[[6,1,"おう"],[10,1,"みち"],[12,1,"あゆ"],[24,1,"たみ"],[33,1,"いえ"],[41,2,"かんいん"],[44,1,"おこな"],[52,2,"かんいん"],[55,1,"おこな"],[65,1,"ちち"],[67,1,"いえ"],[69,1,"もの"],[86,2,"きょうだい"],[91,1,"ころ"]],"text":"イスラエルの王たちの道に歩み、ユダとエルサレムの民に、かのアハブの家がイスラエルに姦淫を行わせたように、姦淫を行わせ、またあなたの父の家の者で、あなたにまさっているあなたの兄弟たちを殺したゆえ、"},{"ref":"2Chr.21.14","start":14021014,"end":14021014,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"おお"],[6,1,"わざわい"],[15,1,"たみ"],[17,2,"こども"],[20,1,"つま"],[29,2,"しょゆう"],[32,1,"う"]],"text":"主は大いなる災をもってあなたの民と子供と妻たちと、すべての所有を撃たれる。"},{"ref":"2Chr.21.15","start":14021015,"end":14021015,"break":"none","ruby":[[6,2,"ないぞう"],[9,2,"びょうき"],[16,2,"たいびょう"],[25,1,"ひ"],[27,1,"ひ"],[29,1,"おも"],[38,2,"ないぞう"],[41,1,"で"]],"text":"あなたはまた内臓の病気にかかって大病になり、それが日に日に重くなって、ついに内臓が出るようになる』」。"},{"ref":"2Chr.21.16","start":14021016,"end":14021016,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[10,1,"たい"],[21,1,"ちか"],[24,1,"す"],[43,1,"れい"],[45,1,"ふ"],[47,1,"おこ"]],"text":"その時、主はヨラムに対してエチオピヤびとの近くに住んでいるペリシテびととアラビヤびとの霊を振り起されたので、"},{"ref":"2Chr.21.17","start":14021017,"end":14021017,"break":"none","ruby":[[0,1,"かれ"],[6,1,"せ"],[8,1,"のぼ"],[15,1,"おか"],[18,1,"おう"],[20,1,"いえ"],[24,1,"か"],[25,1,"ざい"],[32,1,"うば"],[34,1,"さ"],[43,2,"こども"],[46,1,"つま"],[51,1,"うば"],[53,1,"さ"],[59,1,"すえ"],[61,1,"こ"],[77,1,"のこ"],[80,1,"もの"]],"text":"彼らはユダに攻め上って、これを侵し、王の家にある貨財をことごとく奪い去り、またヨラムの子供と妻たちをも奪い去ったので、末の子エホアハズのほかには、ひとりも残った者がなかった。"},{"ref":"2Chr.21.18","start":14021018,"end":14021018,"break":"paragraph","ruby":[[7,1,"こと"],[9,1,"のち"],[11,1,"しゅ"],[13,1,"かれ"],[15,1,"う"],[18,2,"ないぞう"],[26,2,"びょうき"],[29,1,"おこ"]],"text":"このもろもろの事の後、主は彼を撃って内臓にいえがたい病気を起させられた。"},{"ref":"2Chr.21.19","start":14021019,"end":14021019,"break":"none","ruby":[[0,1,"とき"],[7,1,"ねん"],[9,1,"おわ"],[17,2,"ないぞう"],[20,2,"びょうき"],[26,1,"で"],[29,1,"おも"],[31,2,"びょうく"],[37,1,"し"],[41,1,"たみ"],[43,1,"かれ"],[45,2,"せんぞ"],[51,1,"こう"],[60,1,"かれ"],[65,1,"こう"]],"text":"時がたって、二年の終りになり、その内臓が病気のために出て、重い病苦によって死んだ。民は彼の先祖のために香をたいたように、彼のために香をたかなかった。"},{"ref":"2Chr.21.20","start":14021020,"end":14021020,"break":"none","ruby":[[6,1,"くらい"],[11,1,"とき"],[15,1,"さい"],[19,1,"ねん"],[21,1,"あいだ"],[28,1,"よ"],[30,1,"おさ"],[36,1,"し"],[44,1,"かれ"],[46,1,"お"],[49,1,"もの"],[56,2,"ひとびと"],[59,1,"かれ"],[65,1,"まち"],[67,1,"ほうむ"],[72,1,"おう"],[76,1,"はか"]],"text":"ヨラムはその位についた時三十二歳で、八年の間エルサレムで世を治め、ついに死んだ。ひとりも彼を惜しむ者がなかった。人々は彼をダビデの町に葬ったが、王たちの墓にではなかった。"}]