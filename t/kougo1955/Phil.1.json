[{"ref":"Phil.1.1","start":50001001,"end":50001001,"break":"paragraph","ruby":[[9,1,"しもべ"],[45,2,"せいと"],[54,2,"かんとく"],[59,2,"しつじ"]],"text":"キリスト・イエスの僕たち、パウロとテモテから、ピリピにいる、キリスト・イエスにあるすべての聖徒たち、ならびに監督たちと執事たちへ。"},{"ref":"Phil.1.2","start":50001002,"end":50001002,"break":"paragraph","ruby":[[6,1,"ちち"],[9,1,"かみ"],[11,1,"しゅ"],[23,1,"めぐ"],[26,2,"へいあん"]],"text":"わたしたちの父なる神と主イエス・キリストから、恵みと平安とが、あなたがたにあるように。"},{"ref":"Phil.1.3","start":50001003,"end":50001003,"break":"paragraph","ruby":[[10,1,"おも"],[22,1,"かみ"],[24,2,"かんしゃ"]],"text":"わたしはあなたがたを思うたびごとに、わたしの神に感謝し、"},{"ref":"Phil.1.4","start":50001004,"end":50001004,"break":"none","ruby":[[5,2,"いちどう"],[11,1,"いの"],[19,1,"よろこ"],[25,1,"いの"]],"text":"あなたがた一同のために祈るとき、いつも喜びをもって祈り、"},{"ref":"Phil.1.5","start":50001005,"end":50001005,"break":"none","ruby":[[6,2,"さいしょ"],[9,1,"ひ"],[12,2,"こんにち"],[15,1,"いた"],[20,2,"ふくいん"],[33,2,"かんしゃ"]],"text":"あなたがたが最初の日から今日に至るまで、福音にあずかっていることを感謝している。"},{"ref":"Phil.1.6","start":50001006,"end":50001006,"break":"none","ruby":[[13,1,"よ"],[18,1,"はじ"],[36,1,"ひ"],[43,2,"かんせい"],[47,1,"くだ"],[58,2,"かくしん"]],"text":"そして、あなたがたのうちに良いわざを始められたかたが、キリスト・イエスの日までにそれを完成して下さるにちがいないと、確信している。"},{"ref":"Phil.1.7","start":50001007,"end":50001007,"break":"none","ruby":[[10,2,"いちどう"],[19,1,"かんが"],[24,2,"とうぜん"],[38,1,"ごく"],[40,1,"とら"],[46,1,"とき"],[50,2,"ふくいん"],[53,2,"べんめい"],[56,2,"りっしょう"],[60,1,"とき"],[73,1,"とも"],[75,1,"めぐ"],[82,1,"もの"],[91,1,"こころ"],[93,1,"ふか"],[95,1,"と"]],"text":"わたしが、あなたがた一同のために、そう考えるのは当然である。それは、わたしが獄に捕われている時にも、福音を弁明し立証する時にも、あなたがたをみな、共に恵みにあずかる者として、わたしの心に深く留めているからである。"},{"ref":"Phil.1.8","start":50001008,"end":50001008,"break":"none","ruby":[[13,2,"ねつあい"],[24,1,"ふか"],[31,2,"いちどう"],[34,1,"おも"],[46,2,"しょうめい"],[50,1,"くだ"],[56,1,"かみ"]],"text":"わたしがキリスト・イエスの熱愛をもって、どんなに深くあなたがた一同を思っていることか、それを証明して下さるかたは神である。"},{"ref":"Phil.1.9","start":50001009,"end":50001009,"break":"none","ruby":[[6,1,"いの"],[15,1,"あい"],[18,1,"ふか"],[20,2,"ちしき"],[31,2,"かんかく"],[42,1,"ま"],[44,1,"くわ"]],"text":"わたしはこう祈る。あなたがたの愛が、深い知識において、するどい感覚において、いよいよ増し加わり、"},{"ref":"Phil.1.10","start":50001010,"end":50001010,"break":"none","ruby":[[14,1,"なに"],[16,2,"じゅうよう"],[23,2,"はんべつ"],[38,1,"ひ"],[40,1,"そな"],[44,2,"じゅんしん"],[47,1,"せ"]],"text":"それによって、あなたがたが、何が重要であるかを判別することができ、キリストの日に備えて、純真で責められるところのないものとなり、"},{"ref":"Phil.1.11","start":50001011,"end":50001011,"break":"none","ruby":[[11,1,"ぎ"],[13,1,"み"],[15,1,"み"],[21,1,"かみ"],[23,2,"えいこう"],[36,1,"いた"]],"text":"イエス・キリストによる義の実に満たされて、神の栄光とほまれとをあらわすに至るように。"},{"ref":"Phil.1.12","start":50001012,"end":50001012,"break":"paragraph","ruby":[[3,2,"きょうだい"],[13,1,"み"],[15,1,"おこ"],[18,1,"こと"],[24,2,"ふくいん"],[27,2,"ぜんしん"],[30,2,"やくだ"],[49,1,"し"]],"text":"さて、兄弟たちよ。わたしの身に起った事が、むしろ福音の前進に役立つようになったことを、あなたがたに知ってもらいたい。"},{"ref":"Phil.1.13","start":50001013,"end":50001013,"break":"none","ruby":[[9,1,"ごく"],[11,1,"とら"],[33,2,"へいえい"],[35,2,"ぜんたい"],[48,2,"ひとびと"],[52,1,"あき"]],"text":"すなわち、わたしが獄に捕われているのはキリストのためであることが、兵営全体にもそのほかのすべての人々にも明らかになり、"},{"ref":"Phil.1.14","start":50001014,"end":50001014,"break":"none","ruby":[[3,2,"きょうだい"],[10,1,"おお"],[13,1,"もの"],[20,2,"にゅうごく"],[26,1,"しゅ"],[30,2,"かくしん"],[33,1,"え"],[35,1,"おそ"],[47,2,"ゆうかん"],[51,1,"かみ"],[53,1,"ことば"],[55,1,"かた"]],"text":"そして兄弟たちのうち多くの者は、わたしの入獄によって主にある確信を得、恐れることなく、ますます勇敢に、神の言を語るようになった。"},{"ref":"Phil.1.15","start":50001015,"end":50001015,"break":"none","ruby":[[0,2,"いっぽう"],[9,2,"とうそう"],[11,1,"しん"],[19,1,"の"],[21,1,"つた"],[24,1,"もの"],[29,2,"たほう"],[33,2,"ぜんい"],[41,1,"もの"]],"text":"一方では、ねたみや闘争心からキリストを宣べ伝える者がおり、他方では善意からそうする者がいる。"},{"ref":"Phil.1.16","start":50001016,"end":50001016,"break":"none","ruby":[[0,2,"こうしゃ"],[8,2,"ふくいん"],[11,2,"べんめい"],[18,1,"た"],[28,1,"し"],[31,1,"あい"],[33,1,"こころ"],[40,1,"つた"]],"text":"後者は、わたしが福音を弁明するために立てられていることを知り、愛の心でキリストを伝え、"},{"ref":"Phil.1.17","start":50001017,"end":50001017,"break":"none","ruby":[[0,2,"ぜんしゃ"],[8,2,"にゅうごく"],[11,1,"くる"],[15,1,"さら"],[17,2,"かんなん"],[20,1,"くわ"],[25,1,"おも"],[29,2,"じゅんしん"],[32,1,"こころ"],[40,3,"とうはしん"]],"text":"前者は、わたしの入獄の苦しみに更に患難を加えようと思って、純真な心からではなく、党派心からそうしている。"},{"ref":"Phil.1.18","start":50001018,"end":50001018,"break":"paragraph","ruby":[[10,1,"み"],[22,2,"しんじつ"],[34,1,"よう"],[39,1,"つた"],[65,1,"よろこ"],[74,1,"よろこ"]],"text":"すると、どうなのか。見えからであるにしても、真実からであるにしても、要するに、伝えられているのはキリストなのだから、わたしはそれを喜んでいるし、また喜ぶであろう。"},{"ref":"Phil.1.19","start":50001019,"end":50001019,"break":"none","ruby":[[11,1,"いのり"],[23,1,"れい"],[25,1,"たす"],[35,1,"こと"],[46,1,"すくい"],[53,1,"し"]],"text":"なぜなら、あなたがたの祈と、イエス・キリストの霊の助けとによって、この事がついには、わたしの救となることを知っているからである。"},{"ref":"Phil.1.20","start":50001020,"end":50001020,"break":"none","ruby":[[8,2,"せつじつ"],[11,1,"おも"],[14,1,"ま"],[16,1,"のぞ"],[37,1,"は"],[57,1,"いま"],[60,2,"だいたん"],[63,1,"かた"],[72,1,"い"],[77,1,"し"],[86,1,"み"]],"text":"そこで、わたしが切実な思いで待ち望むことは、わたしが、どんなことがあっても恥じることなく、かえって、いつものように今も、大胆に語ることによって、生きるにも死ぬにも、わたしの身によってキリストがあがめられることである。"},{"ref":"Phil.1.21","start":50001021,"end":50001021,"break":"none","ruby":[[9,1,"い"],[23,1,"し"],[28,1,"えき"]],"text":"わたしにとっては、生きることはキリストであり、死ぬことは益である。"},{"ref":"Phil.1.22","start":50001022,"end":50001022,"break":"none","ruby":[[4,2,"にくたい"],[10,1,"い"],[27,1,"みの"],[29,1,"おお"],[31,1,"はたら"],[47,1,"えら"]],"text":"しかし、肉体において生きていることが、わたしにとっては実り多い働きになるのだとすれば、どちらを選んだらよいか、わたしにはわからない。"},{"ref":"Phil.1.23","start":50001023,"end":50001023,"break":"none","ruby":[[14,1,"あいだ"],[16,1,"いた"],[31,1,"ねが"],[34,1,"い"],[40,1,"よ"],[42,1,"さ"],[50,1,"とも"],[60,1,"じつ"],[65,1,"ほう"],[71,1,"のぞ"]],"text":"わたしは、これら二つのものの間に板ばさみになっている。わたしの願いを言えば、この世を去ってキリストと共にいることであり、実は、その方がはるかに望ましい。"},{"ref":"Phil.1.24","start":50001024,"end":50001024,"break":"none","ruby":[[4,2,"にくたい"],[32,2,"ひつよう"]],"text":"しかし、肉体にとどまっていることは、あなたがたのためには、さらに必要である。"},{"ref":"Phil.1.25","start":50001025,"end":50001025,"break":"none","ruby":[[2,2,"かくしん"],[15,1,"い"],[28,2,"いちどう"],[46,2,"しんこう"],[49,1,"すす"],[55,1,"よろこ"],[58,1,"え"],[64,1,"おも"]],"text":"こう確信しているので、わたしは生きながらえて、あなたがた一同のところにとどまり、あなたがたの信仰を進ませ、その喜びを得させようと思う。"},{"ref":"Phil.1.26","start":50001026,"end":50001026,"break":"none","ruby":[[10,1,"ふたた"],[22,1,"い"],[51,1,"ほこり"],[53,1,"ま"]],"text":"そうなれば、わたしが再びあなたがたのところに行くので、あなたがたはわたしによってキリスト・イエスにある誇を増すことになろう。"},{"ref":"Phil.1.27","start":50001027,"end":50001027,"break":"paragraph","ruby":[[14,2,"ふくいん"],[22,2,"せいかつ"],[37,1,"い"],[46,1,"あ"],[53,1,"はな"],[72,1,"れい"],[77,1,"かた"],[79,1,"た"],[84,1,"こころ"],[89,2,"ふくいん"],[92,2,"しんこう"],[98,1,"ちから"],[100,1,"あ"],[104,1,"たたか"]],"text":"ただ、あなたがたはキリストの福音にふさわしく生活しなさい。そして、わたしが行ってあなたがたに会うにしても、離れているにしても、あなたがたが一つの霊によって堅く立ち、一つ心になって福音の信仰のために力を合わせて戦い、"},{"ref":"Phil.1.28","start":50001028,"end":50001028,"break":"none","ruby":[[3,2,"なにごと"],[11,2,"てきたい"],[15,1,"もの"],[32,2,"ようす"],[36,1,"き"],[50,1,"かれ"],[54,1,"ほろ"],[68,1,"すくい"],[81,1,"かみ"],[84,1,"く"]],"text":"かつ、何事についても、敵対する者どもにろうばいさせられないでいる様子を、聞かせてほしい。このことは、彼らには滅びのしるし、あなたがたには救のしるしであって、それは神から来るのである。"},{"ref":"Phil.1.29","start":50001029,"end":50001029,"break":"none","ruby":[[17,1,"かれ"],[19,1,"しん"],[31,1,"かれ"],[36,1,"くる"],[43,1,"たま"]],"text":"あなたがたはキリストのために、ただ彼を信じることだけではなく、彼のために苦しむことをも賜わっている。"},{"ref":"Phil.1.30","start":50001030,"end":50001030,"break":"none","ruby":[[17,1,"み"],[19,1,"いま"],[29,1,"き"],[36,1,"おな"],[38,2,"くとう"],[42,1,"つづ"]],"text":"あなたがたは、さきにわたしについて見、今またわたしについて聞いているのと同じ苦闘を、続けているのである。"}]