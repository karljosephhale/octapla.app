[{"ref":"Job.19.1","start":18019001,"end":18019001,"break":"paragraph","ruby":[[6,1,"こた"],[9,1,"い"]],"text":"そこでヨブは答えて言った、"},{"ref":"Job.19.2","start":18019002,"end":18019002,"break":"stanza","breaks":[[19,"line"]],"ruby":[[15,1,"なや"],[19,2,"ことば"],[29,1,"う"],[31,1,"くだ"]],"text":"「あなたがたはいつまでわたしを悩まし、言葉をもってわたしを打ち砕くのか。"},{"ref":"Job.19.3","start":18019003,"end":18019003,"break":"line","breaks":[[22,"line"]],"ruby":[[9,2,"とたび"],[26,1,"わる"],[36,1,"は"]],"text":"あなたがたはすでに十度もわたしをはずかしめ、わたしを悪くあしらってもなお恥じないのか。"},{"ref":"Job.19.4","start":18019004,"end":18019004,"break":"line","breaks":[[22,"line"]],"ruby":[[33,2,"じしん"]],"text":"たといわたしが、まことにあやまったとしても、そのあやまちは、わたし自身にとどまる。"},{"ref":"Job.19.5","start":18019005,"end":18019005,"break":"line","breaks":[[9,"line"],[25,"line"]],"ruby":[[17,1,"む"],[21,1,"たか"],[29,1,"はじ"],[31,1,"ろん"]],"text":"もしあなたがたが、まことにわたしに向かって高ぶり、わたしの恥を論じるならば、"},{"ref":"Job.19.6","start":18019006,"end":18019006,"break":"line","breaks":[[12,"line"]],"ruby":[[1,1,"かみ"],[14,1,"あみ"],[20,1,"かこ"],[28,1,"し"]],"text":"『神がわたしをしえたげ、その網でわたしを囲まれたのだ』と知るべきだ。"},{"ref":"Job.19.7","start":18019007,"end":18019007,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"み"],[8,2,"ぼうぎゃく"],[12,1,"さけ"],[16,1,"こた"],[22,1,"たす"],[25,1,"よ"],[27,1,"もと"]],"text":"見よ、わたしが『暴虐』と叫んでも答えられず、助けを呼び求めても、さばきはない。"},{"ref":"Job.19.8","start":18019008,"end":18019008,"break":"line","breaks":[[17,"line"],[32,"line"]],"ruby":[[0,1,"かれ"],[6,1,"みち"],[17,1,"こ"],[36,1,"い"],[38,1,"みち"],[40,1,"くら"],[44,1,"お"]],"text":"彼はわたしの道にかきをめぐらして、越えることのできないようにし、わたしの行く道に暗やみを置かれた。"},{"ref":"Job.19.9","start":18019009,"end":18019009,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[6,1,"さか"],[16,1,"と"],[28,1,"かんむり"],[30,1,"うば"]],"text":"彼はわたしの栄えをわたしからはぎ取り、わたしのこうべから冠を奪い、"},{"ref":"Job.19.10","start":18019010,"end":18019010,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"しほう"],[8,1,"と"],[24,1,"のぞ"],[27,1,"き"],[32,1,"ぬ"],[34,1,"さ"]],"text":"四方からわたしを取りこわして、うせさせ、わたしの望みを木のように抜き去り、"},{"ref":"Job.19.11","start":18019011,"end":18019011,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"む"],[8,1,"いか"],[11,1,"も"],[19,1,"てき"],[28,1,"おも"]],"text":"わたしに向かって怒りを燃やし、わたしを敵のひとりのように思われた。"},{"ref":"Job.19.12","start":18019012,"end":18019012,"break":"line","breaks":[[13,"line"],[23,"line"]],"ruby":[[2,2,"ぐんぜい"],[10,1,"き"],[13,1,"るい"],[15,1,"きず"],[18,1,"せ"],[20,1,"よ"],[27,2,"てんまく"],[34,1,"じん"],[36,1,"は"]],"text":"その軍勢がいっせいに来て、塁を築いて攻め寄せ、わたしの天幕のまわりに陣を張った。"},{"ref":"Job.19.13","start":18019013,"end":18019013,"break":"line","breaks":[[11,"line"],[26,"line"]],"ruby":[[0,1,"かれ"],[6,2,"きょうだい"],[16,1,"とお"],[18,1,"はな"],[30,1,"し"],[32,2,"ひとびと"],[35,1,"まった"],[41,2,"そえん"]],"text":"彼はわたしの兄弟たちをわたしから遠く離れさせられた。わたしを知る人々は全くわたしに疎遠になった。"},{"ref":"Job.19.14","start":18019014,"end":18019014,"break":"line","ruby":[[4,2,"しんるい"],[9,1,"した"],[12,1,"とも"],[18,2,"みす"]],"text":"わたしの親類および親しい友はわたしを見捨て、"},{"ref":"Job.19.15","start":18019015,"end":18019015,"break":"line","breaks":[[17,"line"],[40,"line"]],"ruby":[[4,1,"いえ"],[6,1,"やど"],[8,1,"もの"],[14,1,"わす"],[31,2,"たにん"],[37,1,"おも"],[44,1,"かれ"],[47,1,"め"],[49,2,"たこく"],[51,1,"じん"]],"text":"わたしの家に宿る者はわたしを忘れ、わたしのはしためらはわたしを他人のように思い、わたしは彼らの目に他国人となった。"},{"ref":"Job.19.16","start":18019016,"end":18019016,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"よ"],[13,1,"かれ"],[15,1,"こた"],[23,1,"くち"],[28,1,"かれ"],[30,1,"こ"]],"text":"わたしがしもべを呼んでも、彼は答えず、わたしは口をもって彼に請わなければならない。"},{"ref":"Job.19.17","start":18019017,"end":18019017,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"いき"],[8,1,"つま"],[19,1,"おな"],[21,1,"はら"],[23,1,"こ"]],"text":"わたしの息はわが妻にいとわれ、わたしは同じ腹の子たちにきらわれる。"},{"ref":"Job.19.18","start":18019018,"end":18019018,"break":"line","breaks":[[15,"line"]],"ruby":[[12,1,"あなど"],[19,1,"お"],[21,1,"あ"]],"text":"わらべたちさえもわたしを侮り、わたしが起き上がれば、わたしをあざける。"},{"ref":"Job.19.19","start":18019019,"end":18019019,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"した"],[3,2,"ひとびと"],[6,1,"みな"],[21,1,"あい"],[24,2,"ひとびと"]],"text":"親しい人々は皆わたしをいみきらい、わたしの愛した人々はわたしにそむいた。"},{"ref":"Job.19.20","start":18019020,"end":18019020,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"ほね"],[6,1,"かわ"],[8,1,"にく"],[21,1,"は"],[23,1,"かわ"]],"text":"わたしの骨は皮と肉につき、わたしはわずかに歯の皮をもってのがれた。"},{"ref":"Job.19.21","start":18019021,"end":18019021,"break":"line","breaks":[[23,"line"]],"ruby":[[2,1,"とも"],[23,1,"かみ"],[26,1,"て"],[32,1,"う"]],"text":"わが友よ、わたしをあわれめ、わたしをあわれめ、神のみ手がわたしを打ったからである。"},{"ref":"Job.19.22","start":18019022,"end":18019022,"break":"line","breaks":[[23,"line"]],"ruby":[[11,1,"かみ"],[20,1,"せ"],[27,1,"にく"],[32,2,"まんぞく"]],"text":"あなたがたは、なにゆえ神のようにわたしを責め、わたしの肉をもって満足しないのか。"},{"ref":"Job.19.23","start":18019023,"end":18019023,"break":"line","breaks":[[23,"line"]],"ruby":[[8,2,"ことば"],[12,1,"か"],[31,2,"ことば"],[35,2,"しょもつ"]],"text":"どうか、わたしの言葉が、書きとめられるように。どうか、わたしの言葉が、書物にしるされるように。"},{"ref":"Job.19.24","start":18019024,"end":18019024,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"てつ"],[2,1,"ふで"],[4,1,"なまり"],[14,1,"いわ"],[16,1,"きざ"]],"text":"鉄の筆と鉛とをもって、ながく岩に刻みつけられるように。"},{"ref":"Job.19.25","start":18019025,"end":18019025,"break":"line","breaks":[[7,"line"],[25,"line"]],"ruby":[[4,1,"し"],[15,1,"もの"],[17,1,"い"],[25,1,"のち"],[27,1,"ひ"],[29,1,"かれ"],[31,1,"かなら"],[33,1,"ち"],[35,1,"うえ"],[37,1,"た"]],"text":"わたしは知る、わたしをあがなう者は生きておられる、後の日に彼は必ず地の上に立たれる。"},{"ref":"Job.19.26","start":18019026,"end":18019026,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かわ"],[11,1,"ほろ"],[23,1,"にく"],[25,1,"はな"],[28,1,"かみ"],[30,1,"み"]],"text":"わたしの皮がこのように滅ぼされたのち、わたしは肉を離れて神を見るであろう。"},{"ref":"Job.19.27","start":18019027,"end":18019027,"break":"line","breaks":[[19,"line"],[39,"line"]],"ruby":[[7,2,"みかた"],[12,1,"み"],[23,1,"み"],[25,1,"もの"],[29,2,"いがい"],[43,1,"こころ"],[48,1,"のぞ"]],"text":"しかもわたしの味方として見るであろう。わたしの見る者はこれ以外のものではない。わたしの心はこれを望んでこがれる。"},{"ref":"Job.19.28","start":18019028,"end":18019028,"break":"line","breaks":[[18,"line"],[30,"line"],[50,"line"]],"ruby":[[18,1,"かれ"],[20,1,"せ"],[27,1,"い"],[33,1,"こと"],[35,2,"こんげん"],[38,1,"かれ"],[43,1,"み"],[51,1,"い"]],"text":"あなたがたがもし『われわれはどうして彼を責めようか』と言い、また『事の根源は彼のうちに見いだされる』と言うならば、"},{"ref":"Job.19.29","start":18019029,"end":18019029,"break":"line","breaks":[[8,"line"],[25,"line"],[39,"line"]],"ruby":[[4,1,"おそ"],[8,1,"いか"],[15,1,"ばつ"],[48,1,"し"]],"text":"つるぎを恐れよ、怒りはつるぎの罰をきたらすからだ。これによって、あなたがたは、さばきのあることを知るであろう」。"}]