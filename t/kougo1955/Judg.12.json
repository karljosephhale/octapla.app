[{"ref":"Judg.12.1","start":7012001,"end":7012001,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"あつ"],[17,1,"い"],[24,1,"い"],[35,1,"すす"],[38,1,"い"],[46,2,"ひとびと"],[49,1,"たたか"],[60,1,"まね"],[63,2,"いっしょ"],[66,1,"い"],[86,1,"いえ"],[88,1,"ひ"],[97,2,"いっしょ"],[100,1,"や"]],"text":"エフライムの人々は集まってザポンに行き、エフタに言った、「なぜあなたは進んで行ってアンモンの人々と戦いながら、われわれを招いて一緒に行かせませんでしたか。われわれはあなたの家に火をつけてあなたを一緒に焼いてしまいます」。"},{"ref":"Judg.12.2","start":7012002,"end":7012002,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[23,1,"たみ"],[30,2,"ひとびと"],[33,1,"おお"],[36,1,"あらそ"],[48,1,"よ"],[63,1,"かれ"],[66,1,"て"],[69,1,"すく"]],"text":"エフタは彼らに言った、「かつてわたしとわたしの民がアンモンの人々と大いに争ったとき、あなたがたを呼んだが、あなたがたはわたしを彼らの手から救ってくれませんでした。"},{"ref":"Judg.12.3","start":7012003,"end":7012003,"break":"none","ruby":[[6,1,"すく"],[15,1,"み"],[24,1,"いのち"],[33,2,"ひとびと"],[40,1,"せ"],[43,1,"い"],[49,1,"しゅ"],[51,1,"かれ"],[58,1,"て"],[92,1,"のぼ"],[102,1,"たたか"]],"text":"あなたがたが救ってくれないのを見たから、わたしは命がけでアンモンの人々のところへ攻めて行きますと、主は彼らをわたしの手にわたされたのです。どうしてあなたがたは、きょう、わたしのところに上ってきて、わたしと戦おうとするのですか」。"},{"ref":"Judg.12.4","start":7012004,"end":7012004,"break":"none","ruby":[[12,2,"ひとびと"],[20,1,"あつ"],[29,1,"たたか"],[37,2,"ひとびと"],[46,1,"う"],[48,1,"やぶ"],[97,2,"おちうど"],[102,1,"い"]],"text":"そこでエフタはギレアデの人々をことごとく集めてエフライムと戦い、ギレアデの人々はエフライムを撃ち破った。これはエフライムが「ギレアデびとよ、あなたがたはエフライムとマナセのうちにいるエフライムの落人だ」と言ったからである。"},{"ref":"Judg.12.5","start":7012005,"end":7012005,"break":"none","ruby":[[16,1,"わた"],[23,1,"わた"],[25,1,"ば"],[27,1,"おさ"],[39,2,"おちうど"],[43,1,"わた"],[53,1,"い"],[63,2,"ひとびと"],[83,1,"と"],[88,1,"ひと"],[104,1,"い"]],"text":"そしてギレアデびとはエフライムに渡るヨルダンの渡し場を押えたので、エフライムの落人が「渡らせてください」と言うとき、ギレアデの人々は「あなたはエフライムびとですか」と問い、その人がもし「そうではありません」と言うならば、"},{"ref":"Judg.12.6","start":7012006,"end":7012006,"break":"none","ruby":[[4,1,"ひと"],[16,1,"い"],[27,1,"い"],[32,1,"ひと"],[37,1,"ただ"],[40,2,"はつおん"],[59,1,"い"],[67,1,"ひと"],[69,1,"とら"],[78,1,"わた"],[80,1,"ば"],[82,1,"ころ"],[88,1,"とき"],[97,1,"たお"],[107,1,"にん"]],"text":"またその人に「では『シボレテ』と言ってごらんなさい」と言い、その人がそれを正しく発音することができないで「セボレテ」と言うときは、その人を捕えて、ヨルダンの渡し場で殺した。その時エフライムびとの倒れたものは四万二千人であった。"},{"ref":"Judg.12.7","start":7012007,"end":7012007,"break":"paragraph","ruby":[[5,1,"ねん"],[7,1,"あいだ"],[32,1,"し"],[41,2,"じぶん"],[44,1,"まち"],[46,1,"ほうむ"]],"text":"エフタは六年の間イスラエルをさばいた。ギレアデびとエフタはついに死んで、ギレアデの自分の町に葬られた。"},{"ref":"Judg.12.8","start":7012008,"end":7012008,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"のち"]],"text":"彼の後にベツレヘムのイブザンがイスラエルをさばいた。"},{"ref":"Judg.12.9","start":7012009,"end":7012009,"break":"none","ruby":[[0,1,"かれ"],[4,1,"にん"],[18,1,"にん"],[20,1,"むすめ"],[30,2,"じぶん"],[33,2,"しぞく"],[35,2,"いがい"],[38,1,"もの"],[57,1,"にん"],[59,1,"むすめ"],[70,1,"かれ"],[73,1,"ねん"],[75,1,"あいだ"]],"text":"彼に三十人のむすこがあった。また三十人の娘があったが、それを自分の氏族以外の者にとつがせ、むすこたちのためには三十人の娘をほかからめとった。彼は七年の間イスラエルをさばいた。"},{"ref":"Judg.12.10","start":7012010,"end":7012010,"break":"none","ruby":[[8,1,"し"],[18,1,"ほうむ"]],"text":"イブザンはついに死んで、ベツレヘムに葬られた。"},{"ref":"Judg.12.11","start":7012011,"end":7012011,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"のち"],[25,1,"かれ"],[28,1,"ねん"],[30,1,"あいだ"]],"text":"彼の後にゼブルンびとエロンがイスラエルをさばいた。彼は十年の間イスラエルをさばいた。"},{"ref":"Judg.12.12","start":7012012,"end":7012012,"break":"none","ruby":[[13,1,"し"],[22,1,"ち"],[29,1,"ほうむ"]],"text":"ゼブルンびとエロンはついに死んで、ゼブルンの地のアヤロンに葬られた。"},{"ref":"Judg.12.13","start":7012013,"end":7012013,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"のち"],[14,1,"こ"]],"text":"彼の後にピラトンびとヒレルの子アブドンがイスラエルをさばいた。"},{"ref":"Judg.12.14","start":7012014,"end":7012014,"break":"none","ruby":[[0,1,"かれ"],[4,1,"にん"],[9,1,"およ"],[13,1,"にん"],[15,1,"まご"],[22,1,"とう"],[27,1,"の"],[31,1,"かれ"],[34,1,"ねん"],[36,1,"あいだ"]],"text":"彼に四十人のむすこ及び三十人の孫があり、七十頭のろばに乗った。彼は八年の間イスラエルをさばいた。"},{"ref":"Judg.12.15","start":7012015,"end":7012015,"break":"none","ruby":[[10,1,"こ"],[19,1,"し"],[29,1,"ち"],[38,2,"さんち"],[48,1,"ほうむ"]],"text":"ピラトンびとヒレルの子アブドンはついに死んで、エフライムの地のアマレクびとの山地にあるピラトンに葬られた。"}]