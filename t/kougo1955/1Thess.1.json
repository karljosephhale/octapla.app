[{"ref":"1Thess.1.1","start":52001001,"end":52001001,"break":"paragraph","breaks":[[46,"paragraph"]],"ruby":[[15,1,"ちち"],[18,1,"かみ"],[20,1,"しゅ"],[38,1,"びと"],[42,2,"きょうかい"],[46,1,"めぐ"],[49,2,"へいあん"]],"text":"パウロとシルワノとテモテから、父なる神と主イエス・キリストとにあるテサロニケ人たちの教会へ。恵みと平安とが、あなたがたにあるように。"},{"ref":"1Thess.1.2","start":52001002,"end":52001002,"break":"paragraph","ruby":[[6,1,"いのり"],[8,1,"とき"],[16,1,"おぼ"],[24,2,"いちどう"],[34,1,"かみ"],[36,2,"かんしゃ"]],"text":"わたしたちは祈の時にあなたがたを覚え、あなたがた一同のことを、いつも神に感謝し、"},{"ref":"1Thess.1.3","start":52001003,"end":52001003,"break":"none","ruby":[[6,2,"しんこう"],[9,1,"はたら"],[13,1,"あい"],[15,2,"ろうく"],[25,1,"しゅ"],[35,1,"たい"],[38,1,"のぞ"],[41,2,"にんたい"],[52,1,"ちち"],[55,1,"かみ"],[62,1,"た"],[65,1,"おも"],[67,1,"おこ"]],"text":"あなたがたの信仰の働きと、愛の労苦と、わたしたちの主イエス・キリストに対する望みの忍耐とを、わたしたちの父なる神のみまえに、絶えず思い起している。"},{"ref":"1Thess.1.4","start":52001004,"end":52001004,"break":"none","ruby":[[0,1,"かみ"],[2,1,"あい"],[8,2,"きょうだい"],[27,1,"かみ"],[29,1,"えら"],[38,1,"し"]],"text":"神に愛されている兄弟たちよ。わたしたちは、あなたがたが神に選ばれていることを知っている。"},{"ref":"1Thess.1.5","start":52001005,"end":52001005,"break":"none","ruby":[[11,2,"ふくいん"],[20,1,"つた"],[31,2,"ことば"],[40,1,"ちから"],[42,2,"せいれい"],[45,1,"つよ"],[47,2,"かくしん"],[73,1,"あいだ"],[99,1,"し"]],"text":"なぜなら、わたしたちの福音があなたがたに伝えられたとき、それは言葉だけによらず、力と聖霊と強い確信とによったからである。わたしたちが、あなたがたの間で、みんなのためにどんなことをしたか、あなたがたの知っているとおりである。"},{"ref":"1Thess.1.6","start":52001006,"end":52001006,"break":"none","ruby":[[10,1,"おお"],[13,2,"かんなん"],[16,1,"なか"],[19,2,"せいれい"],[24,1,"よろこ"],[30,2,"みことば"],[33,1,"う"],[44,1,"しゅ"],[50,1,"もの"]],"text":"そしてあなたがたは、多くの患難の中で、聖霊による喜びをもって御言を受けいれ、わたしたちと主とにならう者となり、"},{"ref":"1Thess.1.7","start":52001007,"end":52001007,"break":"none","ruby":[[18,2,"しんじゃ"],[20,2,"ぜんたい"],[23,2,"もはん"]],"text":"こうして、マケドニヤとアカヤとにいる信者全体の模範になった。"},{"ref":"1Thess.1.8","start":52001008,"end":52001008,"break":"none","ruby":[[5,1,"しゅ"],[7,2,"ことば"],[17,1,"で"],[33,1,"ひび"],[49,1,"いた"],[56,1,"かみ"],[58,1,"たい"],[67,2,"しんこう"],[73,1,"い"],[91,1,"なに"],[93,1,"の"],[96,2,"ひつよう"]],"text":"すなわち、主の言葉はあなたがたから出て、ただマケドニヤとアカヤとに響きわたっているばかりではなく、至るところで、神に対するあなたがたの信仰のことが言いひろめられたので、これについては何も述べる必要はないほどである。"},{"ref":"1Thess.1.9","start":52001009,"end":52001009,"break":"none","ruby":[[19,1,"ところ"],[25,1,"い"],[46,2,"ぐうぞう"],[49,1,"す"],[52,1,"かみ"],[54,1,"た"],[56,1,"かえ"],[59,1,"い"],[66,1,"かみ"],[68,1,"つか"]],"text":"わたしたちが、どんなにしてあなたがたの所にはいって行ったか、また、あなたがたが、どんなにして偶像を捨てて神に立ち帰り、生けるまことの神に仕えるようになり、"},{"ref":"1Thess.1.10","start":52001010,"end":52001010,"break":"none","ruby":[[4,2,"しにん"],[7,1,"なか"],[16,1,"かみ"],[18,2,"みこ"],[37,1,"いか"],[41,1,"すく"],[43,1,"だ"],[46,1,"くだ"],[54,1,"てん"],[57,1,"くだ"],[66,1,"ま"],[77,1,"かれ"],[79,2,"じしん"],[82,1,"い"]],"text":"そして、死人の中からよみがえった神の御子、すなわち、わたしたちをきたるべき怒りから救い出して下さるイエスが、天から下ってこられるのを待つようになったかを、彼ら自身が言いひろめているのである。"}]