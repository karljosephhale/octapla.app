[{"ref":"Exod.40.1","start":2040001,"end":2040001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた。"},{"ref":"Exod.40.2","start":2040002,"end":2040002,"break":"none","ruby":[[1,2,"しょうがつ"],[4,2,"がんじつ"],[11,2,"かいけん"],[14,2,"てんまく"],[18,2,"まくや"],[21,1,"た"]],"text":"「正月の元日にあなたは会見の天幕なる幕屋を建てなければならない。"},{"ref":"Exod.40.3","start":2040003,"end":2040003,"break":"none","ruby":[[6,1,"なか"],[12,1,"はこ"],[14,1,"お"],[17,2,"たれまく"],[21,1,"はこ"],[23,1,"へだ"],[25,1,"かく"]],"text":"そして、その中にあかしの箱を置き、垂幕で、箱を隔て隠し、"},{"ref":"Exod.40.4","start":2040004,"end":2040004,"break":"none","ruby":[[3,1,"つくえ"],[5,1,"たずさ"],[7,1,"い"],[13,1,"なら"],[19,1,"なら"],[22,2,"しょくだい"],[25,1,"たずさ"],[27,1,"い"]],"text":"また、机を携え入れ、それに並べるものを並べ、燭台を携え入れて、そのともしびをともさなければならない。"},{"ref":"Exod.40.5","start":2040005,"end":2040005,"break":"none","ruby":[[6,1,"きん"],[8,1,"こう"],[10,2,"さいだん"],[18,1,"はこ"],[20,1,"まえ"],[29,2,"まくや"],[32,2,"いりぐち"]],"text":"あなたはまた金の香の祭壇を、あかしの箱の前にすえ、とばりを幕屋の入口にかけなければならない。"},{"ref":"Exod.40.6","start":2040006,"end":2040006,"break":"none","ruby":[[2,2,"はんさい"],[5,2,"さいだん"],[8,2,"かいけん"],[11,2,"てんまく"],[15,2,"まくや"],[18,2,"いりぐち"],[21,1,"まえ"]],"text":"また燔祭の祭壇を会見の天幕なる幕屋の入口の前にすえ、"},{"ref":"Exod.40.7","start":2040007,"end":2040007,"break":"none","ruby":[[0,2,"せんばん"],[3,2,"かいけん"],[6,2,"てんまく"],[9,2,"さいだん"],[13,1,"あいだ"],[22,1,"みず"],[24,1,"い"]],"text":"洗盤を会見の天幕と祭壇との間にすえて、これに水を入れなければならない。"},{"ref":"Exod.40.8","start":2040008,"end":2040008,"break":"none","ruby":[[2,2,"しゅうい"],[5,1,"にわ"],[7,1,"もう"],[10,1,"にわ"],[12,1,"もん"]],"text":"また周囲に庭を設け、庭の門にとばりをかけなければならない。"},{"ref":"Exod.40.9","start":2040009,"end":2040009,"break":"none","ruby":[[3,1,"そそ"],[5,1,"あぶら"],[11,2,"まくや"],[16,1,"なか"],[25,1,"そそ"],[38,1,"うつわ"],[41,2,"せいべつ"],[61,1,"せい"]],"text":"そして注ぎ油をとって、幕屋とその中のすべてのものに注ぎ、それとそのもろもろの器とを聖別しなければならない、こうして、それは聖となるであろう。"},{"ref":"Exod.40.10","start":2040010,"end":2040010,"break":"none","ruby":[[6,2,"はんさい"],[9,2,"さいだん"],[19,1,"うつわ"],[21,1,"あぶら"],[23,1,"そそ"],[29,2,"さいだん"],[32,2,"せいべつ"],[48,2,"さいだん"],[54,1,"せい"]],"text":"あなたはまた燔祭の祭壇と、そのすべての器に油を注いで、その祭壇を聖別しなければならない。こうして祭壇は、いと聖なるものとなるであろう。"},{"ref":"Exod.40.11","start":2040011,"end":2040011,"break":"none","ruby":[[2,2,"せんばん"],[8,1,"だい"],[11,1,"あぶら"],[13,1,"そそ"],[20,2,"せいべつ"]],"text":"また洗盤と、その台とに油を注いで、これを聖別し、"},{"ref":"Exod.40.12","start":2040012,"end":2040012,"break":"none","ruby":[[6,1,"こ"],[10,2,"かいけん"],[13,2,"まくや"],[16,2,"いりぐち"],[19,1,"つ"],[25,1,"みず"],[27,1,"かれ"],[30,1,"あら"]],"text":"アロンとその子たちを会見の幕屋の入口に連れてきて、水で彼らを洗い、"},{"ref":"Exod.40.13","start":2040013,"end":2040013,"break":"none","ruby":[[4,1,"せい"],[7,1,"ふく"],[9,1,"き"],[15,1,"あぶら"],[17,1,"そそ"],[20,2,"せいべつ"],[24,2,"さいし"],[27,1,"つとめ"]],"text":"アロンに聖なる服を着せ、これに油を注いで聖別し、祭司の務をさせなければならない。"},{"ref":"Exod.40.14","start":2040014,"end":2040014,"break":"none","ruby":[[2,1,"かれ"],[4,1,"こ"],[8,1,"つ"],[17,1,"ふく"],[19,1,"き"]],"text":"また彼の子たちを連れてきて、これに服を着せ、"},{"ref":"Exod.40.15","start":2040015,"end":2040015,"break":"none","ruby":[[2,1,"ちち"],[4,1,"あぶら"],[6,1,"そそ"],[13,1,"かれ"],[17,1,"あぶら"],[19,1,"そそ"],[23,2,"さいし"],[26,1,"つとめ"],[39,1,"かれ"],[42,1,"あぶら"],[52,2,"よよ"],[57,2,"さいし"],[59,1,"しょく"]],"text":"その父に油を注いだように、彼らにも油を注いで、祭司の務をさせなければならない。彼らが油そそがれることは、代々ながく祭司職のためになすべきことである」。"},{"ref":"Exod.40.16","start":2040016,"end":2040016,"break":"paragraph","ruby":[[9,1,"おこな"],[17,1,"しゅ"],[19,1,"かれ"],[21,1,"めい"],[29,1,"おこな"]],"text":"モーセはそのように行った。すなわち主が彼に命じられたように行った。"},{"ref":"Exod.40.17","start":2040017,"end":2040017,"break":"none","ruby":[[0,1,"だい"],[2,1,"ねん"],[4,2,"しょうがつ"],[13,1,"つき"],[15,2,"がんじつ"],[18,2,"まくや"],[21,1,"た"]],"text":"第二年の正月になって、その月の元日に幕屋は建った。"},{"ref":"Exod.40.18","start":2040018,"end":2040018,"break":"none","ruby":[[8,2,"まくや"],[11,1,"た"],[16,1,"ざ"],[23,1,"わく"],[25,1,"た"],[30,2,"よこぎ"],[35,1,"こ"],[40,1,"はしら"],[42,1,"た"]],"text":"すなわちモーセは幕屋を建て、その座をすえ、その枠を立て、その横木をさし込み、その柱を立て、"},{"ref":"Exod.40.19","start":2040019,"end":2040019,"break":"none","ruby":[[0,2,"まくや"],[3,1,"うえ"],[5,2,"てんまく"],[14,1,"うえ"],[16,2,"てんまく"],[27,1,"しゅ"],[33,1,"めい"]],"text":"幕屋の上に天幕をひろげ、その上に天幕のおおいをかけた。主がモーセに命じられたとおりである。"},{"ref":"Exod.40.20","start":2040020,"end":2040020,"break":"none","ruby":[[0,1,"かれ"],[8,1,"いた"],[13,1,"はこ"],[15,1,"おさ"],[21,1,"はこ"],[26,3,"しょくざいしょ"],[30,1,"はこ"],[32,1,"うえ"],[34,1,"お"]],"text":"彼はまたあかしの板をとって箱に納め、さおを箱につけ、贖罪所を箱の上に置き、"},{"ref":"Exod.40.21","start":2040021,"end":2040021,"break":"none","ruby":[[0,1,"はこ"],[2,2,"まくや"],[5,1,"たずさ"],[7,1,"い"],[10,1,"へだ"],[13,2,"たれまく"],[24,1,"はこ"],[26,1,"かく"],[30,1,"しゅ"],[36,1,"めい"]],"text":"箱を幕屋に携え入れ、隔ての垂幕をかけて、あかしの箱を隠した。主がモーセに命じられたとおりである。"},{"ref":"Exod.40.22","start":2040022,"end":2040022,"break":"none","ruby":[[0,1,"かれ"],[4,2,"かいけん"],[7,2,"てんまく"],[11,2,"まくや"],[14,2,"ないぶ"],[17,2,"きたがわ"],[20,2,"たれまく"],[23,1,"そと"],[25,1,"つくえ"]],"text":"彼はまた会見の天幕なる幕屋の内部の北側、垂幕の外に机をすえ、"},{"ref":"Exod.40.23","start":2040023,"end":2040023,"break":"none","ruby":[[2,1,"うえ"],[7,1,"れつ"],[9,1,"なら"],[13,1,"しゅ"],[15,1,"まえ"],[17,1,"そな"],[21,1,"しゅ"],[27,1,"めい"]],"text":"その上にパンを列に並べて、主の前に供えた。主がモーセに命じられたとおりである。"},{"ref":"Exod.40.24","start":2040024,"end":2040024,"break":"none","ruby":[[0,1,"かれ"],[4,2,"かいけん"],[7,2,"てんまく"],[11,2,"まくや"],[14,2,"ないぶ"],[17,2,"みなみがわ"],[21,1,"つくえ"],[26,1,"あ"],[30,2,"しょくだい"]],"text":"彼はまた会見の天幕なる幕屋の内部の南側に、机にむかい合わせて燭台をすえ、"},{"ref":"Exod.40.25","start":2040025,"end":2040025,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"まえ"],[14,1,"しゅ"],[20,1,"めい"]],"text":"主の前にともしびをともした。主がモーセに命じられたとおりである。"},{"ref":"Exod.40.26","start":2040026,"end":2040026,"break":"none","ruby":[[0,1,"かれ"],[2,2,"かいけん"],[5,2,"まくや"],[8,1,"なか"],[10,2,"たれまく"],[13,1,"まえ"],[15,1,"きん"],[17,2,"さいだん"]],"text":"彼は会見の幕屋の中、垂幕の前に金の祭壇をすえ、"},{"ref":"Exod.40.27","start":2040027,"end":2040027,"break":"none","ruby":[[2,1,"うえ"],[4,1,"こう"],[8,2,"くんこう"],[15,1,"しゅ"],[21,1,"めい"]],"text":"その上に香ばしい薫香をたいた。主がモーセに命じられたとおりである。"},{"ref":"Exod.40.28","start":2040028,"end":2040028,"break":"none","ruby":[[0,1,"かれ"],[4,2,"まくや"],[7,2,"いりぐち"]],"text":"彼はまた幕屋の入口にとばりをかけ、"},{"ref":"Exod.40.29","start":2040029,"end":2040029,"break":"none","ruby":[[0,2,"はんさい"],[3,2,"さいだん"],[6,2,"かいけん"],[9,2,"てんまく"],[13,2,"まくや"],[16,2,"いりぐち"],[24,1,"うえ"],[26,2,"はんさい"],[29,2,"そさい"],[37,1,"しゅ"],[43,1,"めい"]],"text":"燔祭の祭壇を会見の天幕なる幕屋の入口にすえ、その上に燔祭と素祭をささげた。主がモーセに命じられたとおりである。"},{"ref":"Exod.40.30","start":2040030,"end":2040030,"break":"none","ruby":[[0,1,"かれ"],[4,2,"かいけん"],[7,2,"てんまく"],[10,2,"さいだん"],[14,1,"あいだ"],[16,2,"せんばん"],[19,1,"お"],[22,1,"あら"],[30,1,"みず"],[32,1,"い"]],"text":"彼はまた会見の天幕と祭壇との間に洗盤を置き、洗うためにそれに水を入れた。"},{"ref":"Exod.40.31","start":2040031,"end":2040031,"break":"none","ruby":[[12,1,"こ"],[20,1,"て"],[22,1,"あし"],[24,1,"あら"]],"text":"モーセとアロンおよびその子たちは、それで手と足を洗った。"},{"ref":"Exod.40.32","start":2040032,"end":2040032,"break":"none","ruby":[[4,2,"かいけん"],[7,2,"てんまく"],[18,2,"さいだん"],[21,1,"ちか"],[30,1,"あら"],[34,1,"しゅ"],[40,1,"めい"]],"text":"すなわち会見の天幕にはいるとき、また祭壇に近づくとき、そこで洗った。主がモーセに命じられたとおりである。"},{"ref":"Exod.40.33","start":2040033,"end":2040033,"break":"none","ruby":[[2,2,"まくや"],[5,2,"さいだん"],[8,2,"しゅうい"],[11,1,"にわ"],[13,1,"もう"],[16,1,"にわ"],[18,1,"もん"],[41,2,"こうじ"],[44,1,"お"]],"text":"また幕屋と祭壇の周囲に庭を設け、庭の門にとばりをかけた。このようにしてモーセはその工事を終えた。"},{"ref":"Exod.40.34","start":2040034,"end":2040034,"break":"paragraph","ruby":[[5,1,"くも"],[7,2,"かいけん"],[10,2,"てんまく"],[17,1,"しゅ"],[19,2,"えいこう"],[22,2,"まくや"],[25,1,"み"]],"text":"そのとき、雲は会見の天幕をおおい、主の栄光が幕屋に満ちた。"},{"ref":"Exod.40.35","start":2040035,"end":2040035,"break":"none","ruby":[[4,2,"かいけん"],[7,2,"まくや"],[24,1,"くも"],[28,1,"うえ"],[35,1,"しゅ"],[37,2,"えいこう"],[40,2,"まくや"],[43,1,"み"]],"text":"モーセは会見の幕屋に、はいることができなかった。雲がその上にとどまり、主の栄光が幕屋に満ちていたからである。"},{"ref":"Exod.40.36","start":2040036,"end":2040036,"break":"none","ruby":[[0,1,"くも"],[2,2,"まくや"],[5,1,"うえ"],[11,1,"とき"],[19,2,"ひとびと"],[22,1,"みち"],[24,1,"すす"],[28,1,"かれ"],[33,2,"たびじ"],[39,1,"つね"]],"text":"雲が幕屋の上からのぼる時、イスラエルの人々は道に進んだ。彼らはその旅路において常にそうした。"},{"ref":"Exod.40.37","start":2040037,"end":2040037,"break":"none","ruby":[[4,1,"くも"],[11,1,"とき"],[19,1,"ひ"],[22,1,"みち"],[24,1,"すす"]],"text":"しかし、雲がのぼらない時は、そののぼる日まで道に進まなかった。"},{"ref":"Exod.40.38","start":2040038,"end":2040038,"break":"none","ruby":[[10,1,"いえ"],[16,1,"もの"],[18,1,"まえ"],[21,1,"ひる"],[23,2,"まくや"],[26,1,"うえ"],[28,1,"しゅ"],[30,1,"くも"],[35,1,"よる"],[37,1,"くも"],[39,1,"なか"],[41,1,"ひ"],[47,1,"かれ"],[50,2,"たびじ"],[56,1,"つね"]],"text":"すなわちイスラエルの家のすべての者の前に、昼は幕屋の上に主の雲があり、夜は雲の中に火があった。彼らの旅路において常にそうであった。"}]