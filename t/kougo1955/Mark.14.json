[{"ref":"Mark.14.1","start":41014001,"end":41014001,"break":"paragraph","ruby":[[3,2,"すぎこし"],[6,2,"じょこう"],[10,1,"まつり"],[13,1,"か"],[14,1,"まえ"],[20,3,"さいしちょう"],[26,2,"りっぽう"],[28,2,"がくしゃ"],[34,2,"さくりゃく"],[44,1,"とら"],[56,1,"ころ"],[60,1,"はか"]],"text":"さて、過越と除酵との祭の二日前になった。祭司長たちや律法学者たちは、策略をもってイエスを捕えたうえ、なんとかして殺そうと計っていた。"},{"ref":"Mark.14.2","start":41014002,"end":41014002,"break":"none","ruby":[[0,1,"かれ"],[5,1,"まつり"],[7,1,"あいだ"],[14,2,"みんしゅう"],[17,1,"さわ"],[20,1,"おこ"],[24,1,"し"],[30,1,"い"]],"text":"彼らは、「祭の間はいけない。民衆が騒ぎを起すかも知れない」と言っていた。"},{"ref":"Mark.14.3","start":41014003,"end":41014003,"break":"paragraph","ruby":[[12,2,"びょうにん"],[18,1,"いえ"],[23,2,"しょくたく"],[40,1,"おんな"],[43,2,"ひじょう"],[46,2,"こうか"],[49,2,"じゅんすい"],[56,2,"こうゆ"],[59,1,"い"],[64,2,"せっこう"],[70,1,"も"],[83,2,"こうゆ"],[90,1,"あたま"],[92,1,"そそ"]],"text":"イエスがベタニヤで、らい病人シモンの家にいて、食卓についておられたとき、ひとりの女が、非常に高価で純粋なナルドの香油が入れてある石膏のつぼを持ってきて、それをこわし、香油をイエスの頭に注ぎかけた。"},{"ref":"Mark.14.4","start":41014004,"end":41014004,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"いきどお"],[12,1,"たがい"],[14,1,"い"],[25,2,"こうゆ"]],"text":"すると、ある人々が憤って互に言った、「なんのために香油をこんなにむだにするのか。"},{"ref":"Mark.14.5","start":41014005,"end":41014005,"break":"none","ruby":[[2,2,"こうゆ"],[10,2,"いじょう"],[15,1,"う"],[19,1,"まず"],[22,1,"ひと"],[26,1,"ほどこ"],[41,1,"おんな"]],"text":"この香油を三百デナリ以上にでも売って、貧しい人たちに施すことができたのに」。そして女をきびしくとがめた。"},{"ref":"Mark.14.6","start":41014006,"end":41014006,"break":"none","ruby":[[7,1,"い"],[29,1,"おんな"],[31,1,"こま"],[44,1,"こと"]],"text":"するとイエスは言われた、「するままにさせておきなさい。なぜ女を困らせるのか。わたしによい事をしてくれたのだ。"},{"ref":"Mark.14.7","start":41014007,"end":41014007,"break":"none","ruby":[[0,1,"まず"],[3,1,"ひと"],[16,2,"いっしょ"],[38,1,"こと"],[63,2,"いっしょ"]],"text":"貧しい人たちはいつもあなたがたと一緒にいるから、したいときにはいつでも、よい事をしてやれる。しかし、わたしはあなたがたといつも一緒にいるわけではない。"},{"ref":"Mark.14.8","start":41014008,"end":41014008,"break":"none","ruby":[[2,1,"おんな"],[7,1,"かぎ"],[10,1,"こと"],[30,1,"あぶら"],[32,1,"そそ"],[41,1,"ほうむ"],[44,2,"ようい"]],"text":"この女はできる限りの事をしたのだ。すなわち、わたしのからだに油を注いで、あらかじめ葬りの用意をしてくれたのである。"},{"ref":"Mark.14.9","start":41014009,"end":41014009,"break":"none","ruby":[[2,1,"き"],[8,1,"ぜん"],[9,2,"せかい"],[18,2,"ふくいん"],[21,1,"の"],[23,1,"つた"],[28,1,"ところ"],[34,1,"おんな"],[38,1,"こと"],[40,2,"きねん"],[45,1,"かた"]],"text":"よく聞きなさい。全世界のどこででも、福音が宣べ伝えられる所では、この女のした事も記念として語られるであろう」。"},{"ref":"Mark.14.10","start":41014010,"end":41014010,"break":"paragraph","ruby":[[6,2,"でし"],[27,3,"さいしちょう"],[33,1,"ひ"],[43,1,"かれ"],[46,1,"ところ"],[48,1,"い"]],"text":"ときに、十二弟子のひとりイスカリオテのユダは、イエスを祭司長たちに引きわたそうとして、彼らの所へ行った。"},{"ref":"Mark.14.11","start":41014011,"end":41014011,"break":"none","ruby":[[0,1,"かれ"],[6,1,"き"],[9,1,"よろこ"],[12,1,"きん"],[14,1,"あた"],[20,2,"やくそく"],[41,1,"ひ"],[49,2,"きかい"]],"text":"彼らはこれを聞いて喜び、金を与えることを約束した。そこでユダは、どうかしてイエスを引きわたそうと、機会をねらっていた。"},{"ref":"Mark.14.12","start":41014012,"end":41014012,"break":"paragraph","ruby":[[0,3,"じょこうさい"],[4,1,"だい"],[6,1,"にち"],[12,2,"すぎこし"],[15,2,"こひつじ"],[21,1,"ひ"],[24,2,"でし"],[33,1,"たず"],[45,2,"すぎこし"],[48,2,"しょくじ"],[54,2,"ようい"],[61,1,"い"]],"text":"除酵祭の第一日、すなわち過越の小羊をほふる日に、弟子たちがイエスに尋ねた、「わたしたちは、過越の食事をなさる用意を、どこへ行ってしたらよいでしょうか」。"},{"ref":"Mark.14.13","start":41014013,"end":41014013,"break":"none","ruby":[[12,2,"でし"],[15,1,"つか"],[18,1,"だ"],[21,1,"い"],[27,2,"しない"],[30,1,"い"],[34,1,"みず"],[38,1,"も"],[43,1,"おとこ"],[45,2,"であ"],[55,1,"ひと"],[60,1,"い"]],"text":"そこで、イエスはふたりの弟子を使いに出して言われた、「市内に行くと、水がめを持っている男に出会うであろう。その人について行きなさい。"},{"ref":"Mark.14.14","start":41014014,"end":41014014,"break":"none","ruby":[[6,1,"ひと"],[12,1,"い"],[14,1,"いえ"],[16,2,"しゅじん"],[19,1,"い"],[26,2,"でし"],[31,2,"いっしょ"],[34,2,"すぎこし"],[37,2,"しょくじ"],[42,2,"ざしき"],[50,2,"せんせい"],[53,1,"い"]],"text":"そして、その人がはいって行く家の主人に言いなさい、『弟子たちと一緒に過越の食事をする座敷はどこか、と先生が言っておられます』。"},{"ref":"Mark.14.15","start":41014015,"end":41014015,"break":"none","ruby":[[5,2,"しゅじん"],[9,1,"せき"],[11,1,"ととの"],[14,2,"ようい"],[20,1,"かい"],[22,2,"ひろま"],[25,1,"み"],[46,2,"ようい"]],"text":"するとその主人は、席を整えて用意された二階の広間を見せてくれるから、そこにわたしたちのために用意をしなさい」。"},{"ref":"Mark.14.16","start":41014016,"end":41014016,"break":"none","ruby":[[0,2,"でし"],[5,1,"で"],[9,2,"しない"],[12,1,"い"],[15,1,"み"],[23,1,"い"],[37,2,"すぎこし"],[40,2,"しょくじ"],[43,2,"ようい"]],"text":"弟子たちは出かけて市内に行って見ると、イエスが言われたとおりであったので、過越の食事の用意をした。"},{"ref":"Mark.14.17","start":41014017,"end":41014017,"break":"paragraph","ruby":[[0,2,"ゆうがた"],[13,2,"でし"],[16,2,"いっしょ"],[22,1,"い"]],"text":"夕方になって、イエスは十二弟子と一緒にそこに行かれた。"},{"ref":"Mark.14.18","start":41014018,"end":41014018,"break":"none","ruby":[[4,2,"いちどう"],[7,1,"せき"],[12,2,"しょくじ"],[21,1,"い"],[27,1,"とく"],[35,1,"い"],[48,1,"なか"],[59,2,"いっしょ"],[62,2,"しょくじ"],[69,1,"もの"],[76,2,"うらぎ"]],"text":"そして、一同が席について食事をしているとき言われた、「特にあなたがたに言っておくが、あなたがたの中のひとりで、わたしと一緒に食事をしている者が、わたしを裏切ろうとしている」。"},{"ref":"Mark.14.19","start":41014019,"end":41014019,"break":"none","ruby":[[0,2,"でし"],[5,2,"しんぱい"],[34,1,"い"],[36,1,"だ"]],"text":"弟子たちは心配して、ひとりびとり「まさか、わたしではないでしょう」と言い出した。"},{"ref":"Mark.14.20","start":41014020,"end":41014020,"break":"none","ruby":[[4,1,"い"],[12,1,"にん"],[14,1,"なか"],[25,2,"いっしょ"],[28,1,"おな"],[30,1,"はち"],[41,1,"もの"]],"text":"イエスは言われた、「十二人の中のひとりで、わたしと一緒に同じ鉢にパンをひたしている者が、それである。"},{"ref":"Mark.14.21","start":41014021,"end":41014021,"break":"none","ruby":[[4,1,"ひと"],[6,1,"こ"],[9,2,"じぶん"],[15,1,"か"],[24,1,"さ"],[27,1,"い"],[34,1,"ひと"],[36,1,"こ"],[38,2,"うらぎ"],[43,1,"ひと"],[56,1,"ひと"],[58,1,"うま"],[64,1,"ほう"],[67,1,"かれ"]],"text":"たしかに人の子は、自分について書いてあるとおりに去って行く。しかし、人の子を裏切るその人は、わざわいである。その人は生れなかった方が、彼のためによかったであろう」。"},{"ref":"Mark.14.22","start":41014022,"end":41014022,"break":"paragraph","ruby":[[0,2,"いちどう"],[3,2,"しょくじ"],[20,1,"と"],[23,2,"しゅくふく"],[33,2,"でし"],[38,1,"あた"],[41,1,"い"],[47,1,"と"]],"text":"一同が食事をしているとき、イエスはパンを取り、祝福してこれをさき、弟子たちに与えて言われた、「取れ、これはわたしのからだである」。"},{"ref":"Mark.14.23","start":41014023,"end":41014023,"break":"none","ruby":[[2,1,"さかずき"],[4,1,"と"],[7,2,"かんしゃ"],[11,1,"かれ"],[14,1,"あた"],[21,2,"いちどう"],[26,1,"さかずき"],[29,1,"の"]],"text":"また杯を取り、感謝して彼らに与えられると、一同はその杯から飲んだ。"},{"ref":"Mark.14.24","start":41014024,"end":41014024,"break":"none","ruby":[[6,1,"い"],[16,1,"おお"],[19,1,"ひと"],[24,1,"なが"],[30,2,"けいやく"],[33,1,"ち"]],"text":"イエスはまた言われた、「これは、多くの人のために流すわたしの契約の血である。"},{"ref":"Mark.14.25","start":41014025,"end":41014025,"break":"none","ruby":[[8,1,"い"],[14,1,"かみ"],[16,1,"くに"],[18,1,"あたら"],[21,1,"の"],[25,1,"ひ"],[34,1,"けっ"],[38,1,"ど"],[45,1,"み"],[48,1,"つく"],[54,1,"の"]],"text":"あなたがたによく言っておく。神の国で新しく飲むその日までは、わたしは決して二度と、ぶどうの実から造ったものを飲むことをしない」。"},{"ref":"Mark.14.26","start":41014026,"end":41014026,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"うた"],[11,1,"のち"],[16,1,"やま"],[18,1,"で"],[22,1,"い"]],"text":"彼らは、さんびを歌った後、オリブ山へ出かけて行った。"},{"ref":"Mark.14.27","start":41014027,"end":41014027,"break":"paragraph","ruby":[[9,2,"でし"],[14,1,"い"],[26,1,"みな"],[46,2,"ひつじかい"],[49,1,"う"],[56,1,"ひつじ"],[58,1,"ち"],[69,1,"か"]],"text":"そのとき、イエスは弟子たちに言われた、「あなたがたは皆、わたしにつまずくであろう。『わたしは羊飼を打つ。そして、羊は散らされるであろう』と書いてあるからである。"},{"ref":"Mark.14.28","start":41014028,"end":41014028,"break":"none","ruby":[[24,1,"さき"],[31,1,"い"]],"text":"しかしわたしは、よみがえってから、あなたがたより先にガリラヤへ行くであろう」。"},{"ref":"Mark.14.29","start":41014029,"end":41014029,"break":"none","ruby":[[11,1,"い"],[24,1,"もの"]],"text":"するとペテロはイエスに言った、「たとい、みんなの者がつまずいても、わたしはつまずきません」。"},{"ref":"Mark.14.30","start":41014030,"end":41014030,"break":"none","ruby":[[4,1,"い"],[16,1,"い"],[26,2,"こんや"],[35,1,"ど"],[36,1,"な"],[38,1,"まえ"],[43,1,"い"],[51,1,"ど"],[56,1,"し"],[61,1,"い"]],"text":"イエスは言われた、「あなたによく言っておく。きょう、今夜、にわとりが二度鳴く前に、そう言うあなたが、三度わたしを知らないと言うだろう」。"},{"ref":"Mark.14.31","start":41014031,"end":41014031,"break":"none","ruby":[[4,1,"ちから"],[9,1,"い"],[21,2,"いっしょ"],[24,1,"し"],[41,1,"し"],[50,1,"けっ"],[53,1,"もう"],[64,1,"もの"],[69,1,"おな"],[77,1,"い"]],"text":"ペテロは力をこめて言った、「たといあなたと一緒に死なねばならなくなっても、あなたを知らないなどとは、決して申しません」。みんなの者もまた、同じようなことを言った。"},{"ref":"Mark.14.32","start":41014032,"end":41014032,"break":"paragraph","ruby":[[3,2,"いちどう"],[14,1,"ところ"],[26,2,"でし"],[31,1,"い"],[41,1,"いの"],[46,1,"あいだ"]],"text":"さて、一同はゲツセマネという所にきた。そしてイエスは弟子たちに言われた、「わたしが祈っている間、ここにすわっていなさい」。"},{"ref":"Mark.14.33","start":41014033,"end":41014033,"break":"none","ruby":[[15,2,"いっしょ"],[18,1,"つ"],[21,1,"い"],[27,1,"おそ"],[36,1,"なや"],[43,1,"かれ"],[46,1,"い"]],"text":"そしてペテロ、ヤコブ、ヨハネを一緒に連れて行かれたが、恐れおののき、また悩みはじめて、彼らに言われた、"},{"ref":"Mark.14.34","start":41014034,"end":41014034,"break":"none","ruby":[[5,1,"かな"],[12,1,"し"],[23,1,"ま"],[29,1,"め"]],"text":"「わたしは悲しみのあまり死ぬほどである。ここに待っていて、目をさましていなさい」。"},{"ref":"Mark.14.35","start":41014035,"end":41014035,"break":"none","ruby":[[3,1,"すこ"],[5,1,"すす"],[8,1,"い"],[11,1,"ち"],[15,1,"ふ"],[30,1,"とき"],[32,1,"す"],[34,1,"さ"],[46,1,"いの"],[55,1,"い"]],"text":"そして少し進んで行き、地にひれ伏し、もしできることなら、この時を過ぎ去らせてくださるようにと祈りつづけ、そして言われた、"},{"ref":"Mark.14.36","start":41014036,"end":41014036,"break":"none","ruby":[[4,1,"ちち"],[32,1,"さかずき"],[39,1,"と"],[57,1,"おも"]],"text":"「アバ、父よ、あなたには、できないことはありません。どうか、この杯をわたしから取りのけてください。しかし、わたしの思いではなく、みこころのままになさってください」。"},{"ref":"Mark.14.37","start":41014037,"end":41014037,"break":"none","ruby":[[15,2,"でし"],[20,1,"ねむ"],[32,1,"い"],[43,1,"ねむ"],[53,1,"とき"],[55,1,"め"]],"text":"それから、きてごらんになると、弟子たちが眠っていたので、ペテロに言われた、「シモンよ、眠っているのか、ひと時も目をさましていることができなかったのか。"},{"ref":"Mark.14.38","start":41014038,"end":41014038,"break":"none","ruby":[[0,2,"ゆうわく"],[3,1,"おちい"],[11,1,"め"],[17,1,"いの"],[25,1,"こころ"],[27,1,"ねっ"],[34,2,"にくたい"],[37,1,"よわ"]],"text":"誘惑に陥らないように、目をさまして祈っていなさい。心は熱しているが、肉体が弱いのである」。"},{"ref":"Mark.14.39","start":41014039,"end":41014039,"break":"none","ruby":[[2,1,"はな"],[5,1,"い"],[8,1,"おな"],[10,2,"ことば"],[13,1,"いの"]],"text":"また離れて行って同じ言葉で祈られた。"},{"ref":"Mark.14.40","start":41014040,"end":41014040,"break":"none","ruby":[[12,1,"かれ"],[17,1,"ねむ"],[25,1,"め"],[27,1,"おも"],[43,1,"かれ"],[49,1,"こた"]],"text":"またきてごらんになると、彼らはまだ眠っていた。その目が重くなっていたのである。そして、彼らはどうお答えしてよいか、わからなかった。"},{"ref":"Mark.14.41","start":41014041,"end":41014041,"break":"none","ruby":[[1,2,"どめ"],[6,1,"い"],[14,1,"ねむ"],[22,1,"やす"],[40,1,"とき"],[45,1,"み"],[48,1,"ひと"],[50,1,"こ"],[52,2,"つみびと"],[56,1,"て"],[58,1,"わた"]],"text":"三度目にきて言われた、「まだ眠っているのか、休んでいるのか。もうそれでよかろう。時がきた。見よ、人の子は罪人らの手に渡されるのだ。"},{"ref":"Mark.14.42","start":41014042,"end":41014042,"break":"none","ruby":[[0,1,"た"],[5,1,"い"],[9,1,"み"],[16,2,"うらぎ"],[19,1,"もの"],[21,1,"ちか"]],"text":"立て、さあ行こう。見よ、わたしを裏切る者が近づいてきた」。"},{"ref":"Mark.14.43","start":41014043,"end":41014043,"break":"paragraph","ruby":[[12,1,"はな"],[25,2,"でし"],[35,1,"すす"],[45,3,"さいしちょう"],[49,2,"りっぽう"],[51,2,"がくしゃ"],[54,2,"ちょうろう"],[60,1,"おく"],[64,2,"ぐんしゅう"],[68,1,"けん"],[70,1,"ぼう"],[73,1,"も"],[76,1,"かれ"]],"text":"そしてすぐ、イエスがまだ話しておられるうちに、十二弟子のひとりのユダが進みよってきた。また祭司長、律法学者、長老たちから送られた群衆も、剣と棒とを持って彼についてきた。"},{"ref":"Mark.14.44","start":41014044,"end":41014044,"break":"none","ruby":[[4,2,"うらぎ"],[7,1,"もの"],[15,1,"かれ"],[18,2,"あいず"],[32,2,"せっぷん"],[36,1,"もの"],[41,1,"ひと"],[46,1,"ひと"],[60,1,"ひ"],[66,1,"い"]],"text":"イエスを裏切る者は、あらかじめ彼らに合図をしておいた、「わたしの接吻する者が、その人だ。その人をつかまえて、まちがいなく引ひっぱって行け」。"},{"ref":"Mark.14.45","start":41014045,"end":41014045,"break":"none","ruby":[[0,1,"かれ"],[2,1,"く"],[12,2,"ちかよ"],[17,2,"せんせい"],[21,1,"い"],[24,2,"せっぷん"]],"text":"彼は来るとすぐ、イエスに近寄り、「先生」と言って接吻した。"},{"ref":"Mark.14.46","start":41014046,"end":41014046,"break":"none","ruby":[[0,2,"ひとびと"],[7,1,"て"]],"text":"人々はイエスに手をかけてつかまえた。"},{"ref":"Mark.14.47","start":41014047,"end":41014047,"break":"none","ruby":[[11,1,"た"],[16,1,"もの"],[23,1,"けん"],[25,1,"ぬ"],[28,3,"だいさいし"],[32,1,"しもべ"],[34,1,"き"],[42,2,"かたみみ"],[45,1,"き"],[47,1,"おと"]],"text":"すると、イエスのそばに立っていた者のひとりが、剣を抜いて大祭司の僕に切りかかり、その片耳を切り落した。"},{"ref":"Mark.14.48","start":41014048,"end":41014048,"break":"none","ruby":[[4,1,"かれ"],[11,1,"い"],[23,2,"ごうとう"],[33,1,"けん"],[35,1,"ぼう"],[37,1,"も"],[44,1,"とら"]],"text":"イエスは彼らにむかって言われた、「あなたがたは強盗にむかうように、剣や棒を持ってわたしを捕えにきたのか。"},{"ref":"Mark.14.49","start":41014049,"end":41014049,"break":"none","ruby":[[4,2,"まいにち"],[12,2,"いっしょ"],[15,1,"みや"],[19,1,"おし"],[45,2,"せいしょ"],[48,2,"ことば"],[51,2,"じょうじゅ"]],"text":"わたしは毎日あなたがたと一緒に宮にいて教えていたのに、わたしをつかまえはしなかった。しかし聖書の言葉は成就されねばならない」。"},{"ref":"Mark.14.50","start":41014050,"end":41014050,"break":"none","ruby":[[0,2,"でし"],[5,1,"みな"],[10,2,"みす"],[14,1,"に"],[16,1,"さ"]],"text":"弟子たちは皆イエスを見捨てて逃げ去った。"},{"ref":"Mark.14.51","start":41014051,"end":41014051,"break":"paragraph","ruby":[[6,2,"わかもの"],[9,1,"み"],[11,3,"あまぬの"],[30,1,"い"],[35,2,"ひとびと"],[38,1,"かれ"]],"text":"ときに、ある若者が身に亜麻布をまとって、イエスのあとについて行ったが、人々が彼をつかまえようとしたので、"},{"ref":"Mark.14.52","start":41014052,"end":41014052,"break":"none","ruby":[[2,3,"あまぬの"],[6,1,"す"],[10,1,"はだか"],[12,1,"に"],[15,1,"い"]],"text":"その亜麻布を捨てて、裸で逃げて行った。"},{"ref":"Mark.14.53","start":41014053,"end":41014053,"break":"paragraph","ruby":[[9,3,"だいさいし"],[17,1,"つ"],[20,1,"い"],[24,3,"さいしちょう"],[28,2,"ちょうろう"],[31,2,"りっぽう"],[33,2,"がくしゃ"],[40,1,"あつ"]],"text":"それから、イエスを大祭司のところに連れて行くと、祭司長、長老、律法学者たちがみな集まってきた。"},{"ref":"Mark.14.54","start":41014054,"end":41014054,"break":"none","ruby":[[4,1,"とお"],[15,1,"い"],[19,3,"だいさいし"],[23,2,"なかにわ"],[30,1,"こ"],[35,2,"したやく"],[48,1,"ひ"]],"text":"ペテロは遠くからイエスについて行って、大祭司の中庭まではいり込み、その下役どもにまじってすわり、火にあたっていた。"},{"ref":"Mark.14.55","start":41014055,"end":41014055,"break":"paragraph","ruby":[[3,3,"さいしちょう"],[9,1,"ぜん"],[10,2,"ぎかい"],[19,2,"しけい"],[32,2,"ふり"],[35,2,"しょうこ"],[38,1,"み"],[48,1,"え"]],"text":"さて、祭司長たちと全議会とは、イエスを死刑にするために、イエスに不利な証拠を見つけようとしたが、得られなかった。"},{"ref":"Mark.14.56","start":41014056,"end":41014056,"break":"none","ruby":[[0,1,"おお"],[3,1,"もの"],[9,1,"たい"],[12,2,"ぎしょう"],[15,1,"た"],[22,2,"しょうげん"],[25,1,"あ"]],"text":"多くの者がイエスに対して偽証を立てたが、その証言が合わなかったからである。"},{"ref":"Mark.14.57","start":41014057,"end":41014057,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"た"],[19,1,"たい"],[22,2,"ぎしょう"],[25,1,"た"],[28,1,"い"]],"text":"ついに、ある人々が立ちあがり、イエスに対して偽証を立てて言った、"},{"ref":"Mark.14.58","start":41014058,"end":41014058,"break":"none","ruby":[[9,1,"ひと"],[16,1,"て"],[18,1,"つく"],[23,2,"しんでん"],[26,1,"う"],[33,1,"か"],[35,1,"のち"],[37,1,"て"],[39,1,"つく"],[44,1,"べつ"],[46,2,"しんでん"],[49,1,"た"],[56,1,"い"],[60,1,"き"]],"text":"「わたしたちはこの人が『わたしは手で造ったこの神殿を打ちこわし、三日の後に手で造られない別の神殿を建てるのだ』と言うのを聞きました」。"},{"ref":"Mark.14.59","start":41014059,"end":41014059,"break":"none","ruby":[[9,2,"しょうげん"],[12,1,"たがい"],[14,1,"あ"]],"text":"しかし、このような証言も互に合わなかった。"},{"ref":"Mark.14.60","start":41014060,"end":41014060,"break":"none","ruby":[[3,3,"だいさいし"],[7,1,"た"],[16,1,"なか"],[18,1,"すす"],[25,1,"き"],[31,1,"い"],[36,1,"なに"],[38,1,"こた"],[49,2,"ひとびと"],[56,1,"たい"],[59,2,"ふり"],[62,2,"しょうげん"],[65,1,"もう"],[67,1,"た"]],"text":"そこで大祭司が立ちあがって、まん中に進み、イエスに聞きただして言った、「何も答えないのか。これらの人々があなたに対して不利な証言を申し立てているが、どうなのか」。"},{"ref":"Mark.14.61","start":41014061,"end":41014061,"break":"none","ruby":[[8,1,"だま"],[14,1,"なに"],[17,1,"こた"],[27,3,"だいさいし"],[31,1,"ふたた"],[33,1,"き"],[39,1,"い"],[53,1,"もの"],[55,1,"こ"]],"text":"しかし、イエスは黙っていて、何もお答えにならなかった。大祭司は再び聞きただして言った、「あなたは、ほむべき者の子、キリストであるか」。"},{"ref":"Mark.14.62","start":41014062,"end":41014062,"break":"none","ruby":[[4,1,"い"],[26,1,"ひと"],[28,1,"こ"],[30,1,"ちから"],[33,1,"もの"],[35,1,"みぎ"],[37,1,"ざ"],[40,1,"てん"],[42,1,"くも"],[44,1,"の"],[47,1,"く"],[51,1,"み"]],"text":"イエスは言われた、「わたしがそれである。あなたがたは人の子が力ある者の右に座し、天の雲に乗って来るのを見るであろう」。"},{"ref":"Mark.14.63","start":41014063,"end":41014063,"break":"none","ruby":[[4,3,"だいさいし"],[10,1,"ころも"],[12,1,"ひ"],[14,1,"さ"],[17,1,"い"],[29,2,"いじょう"],[32,2,"しょうにん"],[35,2,"ひつよう"]],"text":"すると、大祭司はその衣を引き裂いて言った、「どうして、これ以上、証人の必要があろう。"},{"ref":"Mark.14.64","start":41014064,"end":41014064,"break":"none","ruby":[[11,1,"ごと"],[13,1,"き"],[23,2,"いけん"],[35,1,"かれ"],[38,1,"みな"],[44,1,"し"],[46,1,"あた"],[51,2,"だんてい"]],"text":"あなたがたはこのけがし言を聞いた。あなたがたの意見はどうか」。すると、彼らは皆、イエスを死に当るものと断定した。"},{"ref":"Mark.14.65","start":41014065,"end":41014065,"break":"none","ruby":[[6,1,"もの"],[19,2,"めかく"],[35,1,"い"],[44,1,"い"],[53,2,"したやく"],[62,1,"ひ"],[68,1,"て"]],"text":"そして、ある者はイエスにつばきをかけ、目隠しをし、こぶしでたたいて、「言いあててみよ」と言いはじめた。また下役どもはイエスを引きとって、手のひらでたたいた。"},{"ref":"Mark.14.66","start":41014066,"end":41014066,"break":"paragraph","ruby":[[4,1,"した"],[6,2,"なかにわ"],[13,3,"だいさいし"],[17,2,"じょちゅう"]],"text":"ペテロは下で中庭にいたが、大祭司の女中のひとりがきて、"},{"ref":"Mark.14.67","start":41014067,"end":41014067,"break":"none","ruby":[[4,1,"ひ"],[14,1,"み"],[18,1,"かれ"],[20,1,"み"],[35,1,"びと"],[40,2,"いっしょ"],[47,1,"い"]],"text":"ペテロが火にあたっているのを見ると、彼を見つめて、「あなたもあのナザレ人イエスと一緒だった」と言った。"},{"ref":"Mark.14.68","start":41014068,"end":41014068,"break":"none","ruby":[[10,1,"う"],[12,1,"け"],[21,1,"し"],[30,1,"い"],[38,1,"こと"],[48,1,"い"],[52,2,"にわぐち"],[55,1,"ほう"],[57,1,"で"],[59,1,"い"]],"text":"するとペテロはそれを打ち消して、「わたしは知らない。あなたの言うことがなんの事か、わからない」と言って、庭口の方に出て行った。"},{"ref":"Mark.14.69","start":41014069,"end":41014069,"break":"none","ruby":[[5,1,"さき"],[7,2,"じょちゅう"],[10,1,"かれ"],[12,1,"み"],[18,1,"た"],[23,2,"ひとびと"],[34,1,"ひと"],[38,2,"なかま"],[48,1,"い"]],"text":"ところが、先の女中が彼を見て、そばに立っていた人々に、またもや「この人はあの仲間のひとりです」と言いだした。"},{"ref":"Mark.14.70","start":41014070,"end":41014070,"break":"none","ruby":[[4,1,"ふたた"],[9,1,"う"],[11,1,"け"],[25,1,"た"],[30,1,"ひと"],[40,1,"い"],[45,1,"たし"],[52,1,"かれ"],[55,2,"なかま"],[67,1,"びと"]],"text":"ペテロは再びそれを打ち消した。しばらくして、そばに立っていた人たちがまたペテロに言った、「確かにあなたは彼らの仲間だ。あなたもガリラヤ人だから」。"},{"ref":"Mark.14.71","start":41014071,"end":41014071,"break":"none","ruby":[[4,1,"かれ"],[14,1,"はな"],[21,1,"ひと"],[26,1,"なに"],[28,1,"し"],[34,1,"い"],[36,1,"は"],[40,1,"はげ"],[43,1,"ちか"]],"text":"しかし、彼は、「あなたがたの話しているその人のことは何も知らない」と言い張って、激しく誓いはじめた。"},{"ref":"Mark.14.72","start":41014072,"end":41014072,"break":"none","ruby":[[12,2,"どめ"],[15,1,"な"],[31,1,"ど"],[32,1,"な"],[34,1,"まえ"],[38,1,"ど"],[43,1,"し"],[48,1,"い"],[56,1,"い"],[64,2,"ことば"],[67,1,"おも"],[69,1,"だ"],[75,1,"おも"],[81,1,"な"]],"text":"するとすぐ、にわとりが二度目に鳴いた。ペテロは、「にわとりが二度鳴く前に、三度わたしを知らないと言うであろう」と言われたイエスの言葉を思い出し、そして思いかえして泣きつづけた。"}]