[{"ref":"Ps.41.1","start":19041001,"end":19041001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[20,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[10,1,"ひと"],[20,1,"しゅ"],[27,1,"ひと"],[29,1,"なや"],[32,1,"ひ"],[34,1,"すく"],[36,1,"だ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"貧しい者をかえりみる人はさいわいである。主はそのような人を悩みの日に救い出される。"},{"ref":"Ps.41.2","start":19041002,"end":19041002,"break":"line","breaks":[[20,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"まも"],[8,1,"い"],[20,1,"かれ"],[24,1,"ち"],[35,1,"もの"],[37,1,"よ"],[46,1,"かれ"],[50,1,"てき"],[52,2,"よくぼう"]],"text":"主は彼を守って、生きながらえさせられる。彼はこの地にあって、さいわいな者と呼ばれる。あなたは彼をその敵の欲望にわたされない。"},{"ref":"Ps.41.3","start":19041003,"end":19041003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[6,1,"やまい"],[8,1,"とこ"],[21,1,"かれ"],[23,1,"や"],[25,1,"とき"],[29,1,"やまい"]],"text":"主は彼をその病の床でささえられる。あなたは彼の病む時、その病をことごとくいやされる。"},{"ref":"Ps.41.4","start":19041004,"end":19041004,"break":"line","breaks":[[21,"line"],[34,"line"]],"ruby":[[4,1,"い"],[9,1,"しゅ"],[46,1,"つみ"],[48,1,"おか"]],"text":"わたしは言った、「主よ、わたしをあわれみ、わたしをいやしてください。わたしはあなたにむかって罪を犯しました」と。"},{"ref":"Ps.41.5","start":19041005,"end":19041005,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"てき"],[14,1,"い"],[20,1,"かれ"],[22,1,"し"],[27,1,"な"]],"text":"わたしの敵はわたしをそしって言う、「いつ彼は死に、その名がほろびるであろうか」と。"},{"ref":"Ps.41.6","start":19041006,"end":19041006,"break":"line","breaks":[[21,"line"],[41,"line"]],"ruby":[[10,1,"み"],[16,1,"く"],[21,1,"かれ"],[23,1,"いつわ"],[26,1,"かた"],[31,1,"こころ"],[38,1,"あつ"],[41,1,"そと"],[43,1,"で"],[49,1,"い"]],"text":"そのひとりがわたしを見ようとして来るとき、彼は偽りを語り、その心によこしまを集め、外に出てはそれを言いふらす。"},{"ref":"Ps.41.7","start":19041007,"end":19041007,"break":"line","breaks":[[11,"line"],[25,"line"]],"ruby":[[7,1,"にく"],[9,1,"もの"],[18,1,"とも"],[32,1,"わざわい"],[34,1,"おも"]],"text":"すべてわたしを憎む者はわたしについて共にささやき、わたしのために災を思いめぐらす。"},{"ref":"Ps.41.8","start":19041008,"end":19041008,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[7,1,"かれ"],[25,1,"たお"],[27,1,"ふ"],[30,1,"ふたた"],[32,1,"お"]],"text":"彼らは言う、「彼に一つのたたりがつきまとったから、倒れ伏して再び起きあがらないであろう」と。"},{"ref":"Ps.41.9","start":19041009,"end":19041009,"break":"line","breaks":[[13,"line"],[30,"line"]],"ruby":[[4,2,"しんらい"],[8,1,"した"],[11,1,"とも"],[20,1,"た"],[23,1,"した"],[26,1,"とも"]],"text":"わたしの信頼した親しい友、わたしのパンを食べた親しい友さえもわたしにそむいてくびすをあげた。"},{"ref":"Ps.41.10","start":19041010,"end":19041010,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[3,1,"しゅ"],[19,1,"たす"],[21,1,"おこ"],[38,1,"かれ"],[41,1,"むく"],[43,1,"かえ"]],"text":"しかし主よ、わたしをあわれみ、わたしを助け起してください。そうすればわたしは彼らに報い返すことができます。"},{"ref":"Ps.41.11","start":19041011,"end":19041011,"break":"line","breaks":[[23,"line"],[38,"line"]],"ruby":[[4,1,"てき"],[10,1,"う"],[12,1,"か"],[31,1,"よろこ"],[42,1,"し"]],"text":"わたしの敵がわたしに打ち勝てないことによって、あなたがわたしを喜ばれることをわたしは知ります。"},{"ref":"Ps.41.12","start":19041012,"end":19041012,"break":"line","breaks":[[15,"line"]],"ruby":[[8,1,"まった"],[29,1,"まえ"],[31,1,"お"]],"text":"あなたはわたしの全きによって、わたしをささえ、とこしえにみ前に置かれます。"},{"ref":"Ps.41.13","start":19041013,"end":19041013,"break":"line","breaks":[[10,"line"],[29,"line"]],"ruby":[[6,1,"かみ"],[8,1,"しゅ"]],"text":"イスラエルの神、主はとこしえからとこしえまでほむべきかな。アァメン、アァメン。"}]