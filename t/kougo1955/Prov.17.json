[{"ref":"Prov.17.1","start":20017001,"end":20017001,"break":"paragraph","breaks":[[7,"line"],[26,"line"]],"ruby":[[0,2,"へいおん"],[26,1,"あらそ"],[33,2,"しょくもつ"],[36,1,"ゆた"],[39,1,"いえ"]],"text":"平穏であって、ひとかたまりのかわいたパンのあるのは、争いがあって、食物の豊かな家にまさる。"},{"ref":"Prov.17.2","start":20017002,"end":20017002,"break":"line","breaks":[[18,"line"],[34,"line"]],"ruby":[[0,1,"かしこ"],[6,2,"みもち"],[9,1,"わる"],[15,1,"おさ"],[23,2,"きょうだい"],[28,1,"なか"],[34,2,"しさん"],[37,1,"わ"],[39,1,"まえ"],[41,1,"え"]],"text":"賢いしもべは身持の悪いむすこを治め、かつ、その兄弟たちの中にあって、資産の分け前を獲る。"},{"ref":"Prov.17.3","start":20017003,"end":20017003,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ぎん"],[2,1,"こころ"],[12,1,"きん"],[14,1,"こころ"],[20,1,"ろ"],[22,1,"ひと"],[24,1,"こころ"],[26,1,"こころ"],[32,1,"しゅ"]],"text":"銀を試みるものはるつぼ、金を試みるものは炉、人の心を試みるものは主である。"},{"ref":"Prov.17.4","start":20017004,"end":20017004,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あく"],[2,1,"おこな"],[4,1,"もの"],[6,1,"いつわ"],[14,1,"き"],[17,1,"いつわ"],[22,1,"もの"],[24,1,"あ"],[27,1,"した"],[29,1,"みみ"],[31,1,"かたむ"]],"text":"悪を行う者は偽りのくちびるに聞き、偽りをいう者は悪しき舌に耳を傾ける。"},{"ref":"Prov.17.5","start":20017005,"end":20017005,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[9,1,"もの"],[13,1,"つく"],[15,1,"ぬし"],[17,1,"あなど"],[20,1,"ひと"],[22,1,"わざわい"],[24,1,"よろこ"],[26,1,"もの"],[28,1,"ばつ"],[30,1,"まぬか"]],"text":"貧しい者をあざける者はその造り主を侮る、人の災を喜ぶ者は罰を免れない。"},{"ref":"Prov.17.6","start":20017006,"end":20017006,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"まご"],[2,2,"ろうじん"],[5,1,"かんむり"],[10,1,"ちち"],[12,1,"こ"],[14,1,"さか"]],"text":"孫は老人の冠である、父は子の栄えである。"},{"ref":"Prov.17.7","start":20017007,"end":20017007,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[4,2,"ことば"],[7,1,"おろ"],[10,1,"もの"],[13,2,"にあ"],[22,1,"いつわ"],[25,1,"い"],[32,1,"きみ"],[35,1,"もの"],[38,2,"にあ"]],"text":"すぐれた言葉は愚かな者には似合わない、まして偽りを言うくちびるは君たる者には似合わない。"},{"ref":"Prov.17.8","start":20017008,"end":20017008,"break":"line","breaks":[[24,"line"]],"ruby":[[8,1,"おく"],[10,1,"ひと"],[12,1,"め"],[15,2,"こううん"],[18,1,"たま"],[26,1,"む"],[29,1,"ところ"],[35,1,"かれ"],[37,1,"さか"]],"text":"まいないはこれを贈る人の目には幸運の玉のようだ、その向かう所、どこでも彼は栄える。"},{"ref":"Prov.17.9","start":20017009,"end":20017009,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"あい"],[2,1,"お"],[4,1,"もと"],[7,1,"ひと"],[9,1,"ひと"],[20,1,"ひと"],[25,1,"い"],[30,1,"もの"],[32,1,"とも"],[34,1,"はな"]],"text":"愛を追い求める人は人のあやまちをゆるす、人のことを言いふらす者は友を離れさせる。"},{"ref":"Prov.17.10","start":20017010,"end":20017010,"break":"line","breaks":[[17,"line"]],"ruby":[[1,1,"ど"],[3,1,"いまし"],[9,1,"ひと"],[11,1,"てっ"],[18,1,"ど"],[20,1,"こら"],[24,1,"おろ"],[27,1,"ひと"],[29,1,"てっ"],[35,1,"ふか"]],"text":"一度の戒めがさとき人に徹するのは、百度の懲しめが愚かな人に徹するよりも深い。"},{"ref":"Prov.17.11","start":20017011,"end":20017011,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[11,1,"こと"],[15,1,"もと"],[24,1,"かれ"],[26,1,"む"],[31,2,"ざんにん"],[34,2,"ししゃ"]],"text":"悪しき者はただ、そむく事のみを求める、それゆえ、彼に向かっては残忍な使者がつかわされる。"},{"ref":"Prov.17.12","start":20017012,"end":20017012,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"おろ"],[8,1,"こと"],[14,1,"あ"],[20,1,"こ"],[26,1,"め"],[30,1,"あ"]],"text":"愚かな者が愚かな事をするのに会うよりは、子をとられた雌ぐまに会うほうがよい。"},{"ref":"Prov.17.13","start":20017013,"end":20017013,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"あく"],[4,1,"ぜん"],[6,1,"むく"],[9,1,"もの"],[12,1,"あく"],[16,1,"いえ"],[18,1,"はな"]],"text":"悪をもて善に報いる者は、悪がその家を離れることがない。"},{"ref":"Prov.17.14","start":20017014,"end":20017014,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あらそ"],[3,1,"はじ"],[6,1,"みず"],[13,1,"に"],[27,1,"おこ"]],"text":"争いの初めは水がもれるのに似ている、それゆえ、けんかの起らないうちにそれをやめよ。"},{"ref":"Prov.17.15","start":20017015,"end":20017015,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"ただ"],[11,1,"もの"],[13,1,"ただ"],[16,1,"もの"],[18,1,"わる"],[23,1,"もの"],[30,1,"もの"],[35,1,"しゅ"],[37,1,"にく"]],"text":"悪しき者を正しいとする者、正しい者を悪いとする者、この二つの者はともに主に憎まれる。"},{"ref":"Prov.17.16","start":20017016,"end":20017016,"break":"line","breaks":[[15,"line"],[28,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[8,1,"こころ"],[19,2,"ちえ"],[22,1,"か"],[28,1,"て"],[32,2,"だいきん"],[35,1,"も"]],"text":"愚かな者はすでに心がないのに、どうして知恵を買おうとして手にその代金を持っているのか。"},{"ref":"Prov.17.17","start":20017017,"end":20017017,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"とも"],[6,1,"とき"],[9,1,"あい"],[13,2,"きょうだい"],[20,1,"とき"],[25,1,"うま"]],"text":"友はいずれの時にも愛する、兄弟はなやみの時のために生れる。"},{"ref":"Prov.17.18","start":20017018,"end":20017018,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"ちえ"],[5,1,"ひと"],[7,1,"て"],[15,1,"とな"],[17,1,"びと"],[19,1,"まえ"],[21,2,"ほしょう"]],"text":"知恵のない人は手をうって、その隣り人の前で保証をする。"},{"ref":"Prov.17.19","start":20017019,"end":20017019,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"あらそ"],[3,1,"この"],[5,1,"もの"],[7,1,"つみ"],[9,1,"この"],[14,1,"もん"],[16,1,"たか"],[20,1,"もの"],[22,1,"ほろ"],[25,1,"もと"]],"text":"争いを好む者は罪を好む、その門を高くする者は滅びを求める。"},{"ref":"Prov.17.20","start":20017020,"end":20017020,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"まが"],[3,1,"こころ"],[5,1,"もの"],[12,1,"え"],[20,1,"した"],[25,1,"かた"],[27,1,"もの"],[29,1,"わざわい"],[31,1,"おちい"]],"text":"曲った心の者はさいわいを得ない、みだりに舌をもって語る者は災に陥る。"},{"ref":"Prov.17.21","start":20017021,"end":20017021,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おろ"],[3,1,"こ"],[5,1,"う"],[7,1,"もの"],[9,1,"なげ"],[12,1,"え"],[15,1,"おろ"],[17,1,"もの"],[19,1,"ちち"],[21,1,"よろこ"],[24,1,"え"]],"text":"愚かな子を生む者は嘆きを得る、愚か者の父は喜びを得ない。"},{"ref":"Prov.17.22","start":20017022,"end":20017022,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"こころ"],[2,1,"たの"],[6,1,"よ"],[8,1,"くすり"],[18,1,"うれ"],[21,1,"ほね"],[23,1,"か"]],"text":"心の楽しみは良い薬である、たましいの憂いは骨を枯らす。"},{"ref":"Prov.17.23","start":20017023,"end":20017023,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"ひと"],[18,1,"う"],[26,1,"みち"]],"text":"悪しき者は人のふところからまいないを受けて、さばきの道をまげる。"},{"ref":"Prov.17.24","start":20017024,"end":20017024,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"もの"],[7,1,"かお"],[9,2,"ちえ"],[20,1,"おろ"],[23,1,"もの"],[25,1,"め"],[27,1,"ち"],[29,1,"はて"]],"text":"さとき者はその顔を知恵にむける、しかし、愚かな者は目を地の果にそそぐ。"},{"ref":"Prov.17.25","start":20017025,"end":20017025,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おろ"],[3,1,"こ"],[7,1,"ちち"],[9,1,"うれ"],[20,1,"う"],[23,1,"はは"],[25,1,"いた"]],"text":"愚かな子はその父の憂いである、またこれを産んだ母の痛みである。"},{"ref":"Prov.17.26","start":20017026,"end":20017026,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"ばっ"],[15,1,"たっと"],[17,1,"ひと"],[19,1,"う"],[23,1,"わる"]],"text":"正しい人を罰するのはよくない、尊い人を打つのは悪い。"},{"ref":"Prov.17.27","start":20017027,"end":20017027,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ことば"],[3,1,"すく"],[8,1,"もの"],[10,2,"ちしき"],[15,1,"もの"],[17,1,"こころ"],[19,2,"れいせい"],[22,1,"ひと"],[27,1,"ひと"]],"text":"言葉を少なくする者は知識のある者、心の冷静な人はさとき人である。"},{"ref":"Prov.17.28","start":20017028,"end":20017028,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"だま"],[14,2,"ちえ"],[18,1,"もの"],[20,1,"おも"],[31,1,"と"],[36,1,"とき"],[42,1,"もの"],[44,1,"おも"]],"text":"愚かな者も黙っているときは、知恵ある者と思われ、そのくちびるを閉じている時は、さとき者と思われる。"}]