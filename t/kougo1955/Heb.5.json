[{"ref":"Heb.5.1","start":58005001,"end":58005001,"break":"paragraph","ruby":[[0,3,"だいさいし"],[12,2,"にんげん"],[15,1,"なか"],[18,1,"えら"],[23,1,"つみ"],[28,1,"そな"],[30,1,"もの"],[46,2,"ひとびと"],[52,1,"かみ"],[54,1,"つか"],[57,1,"やく"],[59,1,"にん"],[64,1,"もの"]],"text":"大祭司なるものはすべて、人間の中から選ばれて、罪のために供え物といけにえとをささげるように、人々のために神に仕える役に任じられた者である。"},{"ref":"Heb.5.2","start":58005002,"end":58005002,"break":"none","ruby":[[0,1,"かれ"],[2,2,"じぶん"],[4,2,"じしん"],[7,1,"よわ"],[10,1,"み"],[12,1,"お"],[20,2,"むち"],[23,1,"まよ"],[28,2,"ひとびと"],[32,1,"おも"],[43,1,"とも"]],"text":"彼は自分自身、弱さを身に負うているので、無知な迷っている人々を、思いやることができると共に、"},{"ref":"Heb.5.3","start":58005003,"end":58005003,"break":"none","ruby":[[2,1,"よわ"],[9,1,"たみ"],[19,2,"じぶん"],[21,2,"じしん"],[29,1,"つみ"]],"text":"その弱さのゆえに、民のためだけではなく自分自身のためにも、罪についてささげものをしなければならないのである。"},{"ref":"Heb.5.4","start":58005004,"end":58005004,"break":"none","ruby":[[8,2,"えいよ"],[12,1,"つとめ"],[14,2,"じぶん"],[17,1,"え"],[29,2,"ばあい"],[36,1,"かみ"],[38,1,"め"],[44,1,"う"]],"text":"かつ、だれもこの栄誉ある務を自分で得るのではなく、アロンの場合のように、神の召しによって受けるのである。"},{"ref":"Heb.5.5","start":58005005,"end":58005005,"break":"none","breaks":[[30,"stanza"],[44,"line"]],"ruby":[[0,2,"どうよう"],[12,3,"だいさいし"],[16,2,"えいよ"],[19,2,"じぶん"],[22,1,"え"],[42,1,"こ"],[56,1,"う"],[61,1,"い"],[71,1,"う"]],"text":"同様に、キリストもまた、大祭司の栄誉を自分で得たのではなく、「あなたこそは、わたしの子。きょう、わたしはあなたを生んだ」と言われたかたから、お受けになったのである。"},{"ref":"Heb.5.6","start":58005006,"end":58005006,"break":"none","breaks":[[18,"stanza"],[30,"line"]],"ruby":[[6,2,"かしょ"],[11,1,"い"],[26,2,"えいえん"],[37,1,"ひと"],[40,2,"さいし"]],"text":"また、ほかの箇所でこう言われている、「あなたこそは、永遠に、メルキゼデクに等しい祭司である」。"},{"ref":"Heb.5.7","start":58005007,"end":58005007,"break":"none","ruby":[[8,1,"にく"],[10,2,"せいかつ"],[13,1,"とき"],[17,1,"はげ"],[20,1,"さけ"],[23,1,"なみだ"],[31,2,"じぶん"],[34,1,"し"],[37,1,"すく"],[39,1,"ちから"],[47,1,"いのり"],[49,1,"ねが"],[63,1,"ふか"],[65,2,"しんこう"],[71,1,"き"]],"text":"キリストは、その肉の生活の時には、激しい叫びと涙とをもって、ご自分を死から救う力のあるかたに、祈と願いとをささげ、そして、その深い信仰のゆえに聞きいれられたのである。"},{"ref":"Heb.5.8","start":58005008,"end":58005008,"break":"none","ruby":[[0,1,"かれ"],[2,2,"みこ"],[22,1,"くる"],[29,2,"じゅうじゅん"],[32,1,"まな"]],"text":"彼は御子であられたにもかかわらず、さまざまの苦しみによって従順を学び、"},{"ref":"Heb.5.9","start":58005009,"end":58005009,"break":"none","ruby":[[4,1,"まった"],[6,1,"もの"],[14,1,"かれ"],[16,2,"じゅうじゅん"],[25,1,"ひと"],[27,1,"たい"],[31,2,"えいえん"],[34,1,"すくい"],[36,1,"みなもと"]],"text":"そして、全き者とされたので、彼に従順であるすべての人に対して、永遠の救の源となり、"},{"ref":"Heb.5.10","start":58005010,"end":58005010,"break":"none","ruby":[[0,1,"かみ"],[13,1,"ひと"],[16,3,"だいさいし"]],"text":"神によって、メルキゼデクに等しい大祭司と、となえられたのである。"},{"ref":"Heb.5.11","start":58005011,"end":58005011,"break":"paragraph","ruby":[[10,1,"い"],[31,1,"みみ"],[33,1,"にぶ"],[46,1,"と"],[48,1,"あ"]],"text":"このことについては、言いたいことがたくさんあるが、あなたがたの耳が鈍くなっているので、それを説き明かすことはむずかしい。"},{"ref":"Heb.5.12","start":58005012,"end":58005012,"break":"none","ruby":[[7,1,"ひさ"],[10,2,"いぜん"],[17,2,"きょうし"],[34,1,"ど"],[35,1,"かみ"],[37,1,"ことば"],[39,2,"しょほ"],[43,1,"ひと"],[46,1,"て"],[61,2,"しまつ"],[73,1,"かた"],[75,2,"しょくもつ"],[82,1,"ちち"],[84,2,"ひつよう"]],"text":"あなたがたは、久しい以前からすでに教師となっているはずなのに、もう一度神の言の初歩を、人から手ほどきしてもらわねばならない始末である。あなたがたは堅い食物ではなく、乳を必要としている。"},{"ref":"Heb.5.13","start":58005013,"end":58005013,"break":"none","ruby":[[3,1,"ちち"],[5,1,"の"],[10,1,"もの"],[13,1,"おさ"],[15,1,"ご"],[22,1,"ぎ"],[24,2,"ことば"],[27,1,"あじ"]],"text":"すべて乳を飲んでいる者は、幼な子なのだから、義の言葉を味わうことができない。"},{"ref":"Heb.5.14","start":58005014,"end":58005014,"break":"none","ruby":[[4,1,"かた"],[6,2,"しょくもつ"],[10,2,"ぜんあく"],[13,1,"み"],[17,2,"かんかく"],[20,2,"じっさい"],[23,1,"はたら"],[27,2,"くんれん"],[32,2,"せいじん"]],"text":"しかし、堅い食物は、善悪を見わける感覚を実際に働かせて訓練された成人のとるべきものである。"}]