[{"ref":"Deut.16.1","start":5016001,"end":5016001,"break":"paragraph","ruby":[[8,1,"つき"],[10,1,"まも"],[18,1,"かみ"],[20,1,"しゅ"],[25,2,"すぎこし"],[28,1,"まつり"],[30,1,"おこな"],[45,1,"つき"],[52,1,"かみ"],[54,1,"しゅ"],[56,1,"よる"],[58,1,"あいだ"],[70,1,"みちび"],[72,1,"だ"]],"text":"あなたはアビブの月を守って、あなたの神、主のために過越の祭を行わなければならない。アビブの月に、あなたの神、主が夜の間にあなたをエジプトから導き出されたからである。"},{"ref":"Deut.16.2","start":5016002,"end":5016002,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"な"],[6,1,"お"],[11,1,"えら"],[15,2,"ばしょ"],[19,1,"ひつじ"],[23,1,"うし"],[29,1,"かみ"],[31,1,"しゅ"],[33,2,"すぎこし"],[36,2,"ぎせい"]],"text":"主がその名を置くために選ばれる場所で、羊または牛をあなたの神、主に過越の犠牲としてほふらなければならない。"},{"ref":"Deut.16.3","start":5016003,"end":5016003,"break":"none","ruby":[[0,1,"たね"],[2,1,"い"],[11,1,"とも"],[13,1,"た"],[22,2,"なぬか"],[29,1,"たね"],[30,1,"い"],[39,1,"なや"],[49,1,"とも"],[51,1,"た"],[71,1,"くに"],[74,1,"で"],[79,1,"いそ"],[82,1,"で"],[94,1,"よ"],[96,1,"い"],[103,1,"ひ"],[105,1,"あいだ"],[112,1,"くに"],[115,1,"で"],[119,1,"ひ"],[121,1,"つね"],[123,1,"おぼ"]],"text":"種を入れたパンをそれと共に食べてはならない。七日のあいだ、種入れぬパンすなわち悩みのパンを、それと共に食べなければならない。あなたがエジプトの国から出るとき、急いで出たからである。こうして世に生きながらえる日の間、エジプトの国から出てきた日を常に覚えなければならない。"},{"ref":"Deut.16.4","start":5016004,"end":5016004,"break":"none","ruby":[[2,2,"なぬか"],[5,1,"あいだ"],[8,1,"くに"],[10,1,"うち"],[17,1,"だね"],[30,1,"はじ"],[33,1,"ひ"],[35,2,"ゆうぐれ"],[44,1,"にく"],[47,2,"よくあさ"],[51,1,"のこ"]],"text":"その七日の間は、国の内どこにもパン種があってはならない。また初めの日の夕暮にほふるものの肉を、翌朝まで残しておいてはならない。"},{"ref":"Deut.16.5","start":5016005,"end":5016005,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"たま"],[11,1,"まち"],[13,1,"うち"],[16,2,"すぎこし"],[19,2,"ぎせい"]],"text":"あなたの神、主が賜わる町の内で、過越の犠牲をほふってはならない。"},{"ref":"Deut.16.6","start":5016006,"end":5016006,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[12,1,"な"],[14,1,"お"],[19,1,"えら"],[23,2,"ばしょ"],[27,2,"ゆうぐれ"],[30,1,"ひ"],[32,1,"い"],[47,1,"で"],[49,2,"じこく"],[53,2,"すぎこし"],[56,2,"ぎせい"]],"text":"ただあなたの神、主がその名を置くために選ばれる場所で、夕暮の日の入るころ、あなたがエジプトから出た時刻に、過越の犠牲をほふらなければならない。"},{"ref":"Deut.16.7","start":5016007,"end":5016007,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[11,1,"えら"],[15,2,"ばしょ"],[22,1,"や"],[25,1,"た"],[28,1,"あさ"],[33,2,"てんまく"],[36,1,"かえ"]],"text":"そしてあなたの神、主が選ばれる場所で、それを焼いて食べ、朝になって天幕に帰らなければならない。"},{"ref":"Deut.16.8","start":5016008,"end":5016008,"break":"none","ruby":[[1,1,"か"],[6,1,"たね"],[7,1,"い"],[13,1,"た"],[16,2,"なぬか"],[18,1,"め"],[24,1,"かみ"],[26,1,"しゅ"],[31,1,"せい"],[32,1,"かい"],[34,1,"ひら"],[48,2,"しごと"]],"text":"六日のあいだ種入れぬパンを食べ、七日目にあなたの神、主のために聖会を開かなければならない。なんの仕事もしてはならない。"},{"ref":"Deut.16.9","start":5016009,"end":5016009,"break":"paragraph","ruby":[[3,2,"しゅうかん"],[6,1,"かぞ"],[21,2,"こくもつ"],[28,1,"い"],[30,1,"はじ"],[33,1,"とき"],[37,2,"しゅうかん"],[40,1,"かぞ"],[42,1,"はじ"]],"text":"また七週間を数えなければならない。すなわち穀物に、かまを入れ始める時から七週間を数え始めなければならない。"},{"ref":"Deut.16.10","start":5016010,"end":5016010,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[15,1,"しゅう"],[17,1,"まつり"],[19,1,"おこな"],[26,1,"かみ"],[28,1,"しゅ"],[30,1,"たま"],[33,2,"しゅくふく"],[42,1,"ちから"],[44,1,"おう"],[47,2,"じはつ"],[50,1,"そな"],[52,1,"もの"]],"text":"そしてあなたの神、主のために七週の祭を行い、あなたの神、主が賜わる祝福にしたがって、力に応じ、自発の供え物をささげなければならない。"},{"ref":"Deut.16.11","start":5016011,"end":5016011,"break":"none","ruby":[[12,1,"むすめ"],[25,1,"まち"],[27,1,"うち"],[51,2,"きりゅう"],[54,2,"たこく"],[56,1,"じん"],[58,2,"こじ"],[61,2,"かふ"],[64,1,"とも"],[71,1,"かみ"],[73,1,"しゅ"],[77,1,"な"],[79,1,"お"],[84,1,"えら"],[88,2,"ばしょ"],[96,1,"かみ"],[98,1,"しゅ"],[100,1,"まえ"],[102,1,"よろこ"],[104,1,"たの"]],"text":"こうしてあなたはむすこ、娘、しもべ、はしためおよび町の内におるレビびと、ならびにあなたがたのうちにおる寄留の他国人と孤児と寡婦と共に、あなたの神、主がその名を置くために選ばれる場所で、あなたの神、主の前に喜び楽しまなければならない。"},{"ref":"Deut.16.12","start":5016012,"end":5016012,"break":"none","ruby":[[12,2,"どれい"],[21,1,"おぼ"],[28,1,"さだ"],[31,1,"まも"],[33,1,"おこな"]],"text":"あなたはかつてエジプトで奴隷であったことを覚え、これらの定めを守り行わなければならない。"},{"ref":"Deut.16.13","start":5016013,"end":5016013,"break":"paragraph","ruby":[[0,1,"う"],[2,1,"ば"],[5,1,"さか"],[10,2,"とりい"],[19,2,"なぬか"],[25,2,"かりいお"],[28,1,"まつり"],[30,1,"おこな"]],"text":"打ち場と、酒ぶねから取入れをしたとき、七日のあいだ仮庵の祭を行わなければならない。"},{"ref":"Deut.16.14","start":5016014,"end":5016014,"break":"none","ruby":[[2,1,"まつり"],[4,1,"とき"],[16,1,"むすめ"],[29,1,"まち"],[31,1,"うち"],[40,2,"きりゅう"],[43,2,"たこく"],[45,1,"じん"],[47,2,"こじ"],[50,2,"かふ"],[53,1,"とも"],[55,1,"よろこ"],[57,1,"たの"]],"text":"その祭の時には、あなたはむすこ、娘、しもべ、はしためおよび町の内におるレビびと、寄留の他国人、孤児、寡婦と共に喜び楽しまなければならない。"},{"ref":"Deut.16.15","start":5016015,"end":5016015,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"えら"],[6,2,"ばしょ"],[9,2,"なぬか"],[12,1,"あいだ"],[18,1,"かみ"],[20,1,"しゅ"],[25,1,"まつり"],[27,1,"おこな"],[42,1,"かみ"],[44,1,"しゅ"],[50,2,"さんぶつ"],[54,1,"て"],[72,2,"しゅくふく"],[84,1,"おお"],[87,1,"よろこ"],[89,1,"たの"]],"text":"主が選ばれる場所で七日の間、あなたの神、主のために祭を行わなければならない。あなたの神、主はすべての産物と、手のすべてのわざとにおいて、あなたを祝福されるから、あなたは大いに喜び楽しまなければならない。"},{"ref":"Deut.16.16","start":5016016,"end":5016016,"break":"paragraph","ruby":[[7,2,"だんし"],[10,1,"みな"],[15,1,"かみ"],[17,1,"しゅ"],[19,1,"えら"],[23,2,"ばしょ"],[27,1,"ねん"],[30,1,"ど"],[36,1,"たね"],[37,1,"い"],[43,1,"まつり"],[47,1,"しゅう"],[49,1,"まつり"],[52,2,"かりいお"],[55,1,"まつり"],[58,1,"しゅ"],[60,1,"まえ"],[62,1,"で"],[78,1,"て"],[80,1,"しゅ"],[82,1,"まえ"],[84,1,"で"]],"text":"あなたのうちの男子は皆あなたの神、主が選ばれる場所で、年に三度、すなわち種入れぬパンの祭と、七週の祭と、仮庵の祭に、主の前に出なければならない。ただし、から手で主の前に出てはならない。"},{"ref":"Deut.16.17","start":5016017,"end":5016017,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"たま"],[11,2,"しゅくふく"],[23,1,"ちから"],[25,1,"おう"],[32,1,"もの"]],"text":"あなたの神、主が賜わる祝福にしたがい、おのおの力に応じて、ささげ物をしなければならない。"},{"ref":"Deut.16.18","start":5016018,"end":5016018,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"たま"],[15,2,"まちまち"],[18,1,"うち"],[21,2,"ぶぞく"],[45,1,"た"],[59,1,"かれ"],[62,1,"ただ"],[72,1,"たみ"]],"text":"あなたの神、主が賜わるすべての町々の内に、部族にしたがって、さばきびとと、つかさびととを、立てなければならない。そして彼らは正しいさばきをもって民をさばかなければならない。"},{"ref":"Deut.16.19","start":5016019,"end":5016019,"break":"none","ruby":[[8,1,"ま"],[17,1,"ひと"],[23,1,"み"],[33,2,"わいろ"],[36,1,"と"],[45,2,"わいろ"],[48,1,"かしこ"],[50,1,"もの"],[52,1,"め"],[59,1,"ただ"],[62,1,"もの"],[64,2,"じけん"],[67,1,"ま"]],"text":"あなたはさばきを曲げてはならない。人をかたより見てはならない。また賄賂を取ってはならない。賄賂は賢い者の目をくらまし、正しい者の事件を曲げるからである。"},{"ref":"Deut.16.20","start":5016020,"end":5016020,"break":"none","ruby":[[2,2,"こうぎ"],[7,1,"もと"],[27,1,"い"],[39,1,"かみ"],[41,1,"しゅ"],[43,1,"たま"],[46,1,"ち"],[48,2,"しょゆう"]],"text":"ただ公義をのみ求めなければならない。そうすればあなたは生きながらえて、あなたの神、主が賜わる地を所有するにいたるであろう。"},{"ref":"Deut.16.21","start":5016021,"end":5016021,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[11,1,"きず"],[13,2,"さいだん"],[26,2,"もくぞう"],[30,1,"た"]],"text":"あなたの神、主のために築く祭壇のかたわらに、アシラの木像をも立ててはならない。"},{"ref":"Deut.16.22","start":5016022,"end":5016022,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"にく"],[14,1,"はしら"],[16,1,"た"]],"text":"またあなたの神、主が憎まれる柱を立ててはならない。"}]