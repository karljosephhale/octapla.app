[{"ref":"Zech.12.1","start":38012001,"end":38012001,"break":"paragraph","breaks":[[2,"paragraph"]],"ruby":[[0,2,"たくせん"],[12,1,"しゅ"],[14,2,"ことば"],[21,1,"てん"],[26,1,"ち"],[28,1,"もとい"],[33,1,"ひと"],[35,1,"れい"],[39,1,"なか"],[41,1,"つく"],[45,1,"しゅ"],[50,1,"おお"]],"text":"託宣イスラエルについての主の言葉。すなわち天をのべ、地の基をすえ、人の霊をその中に造られた主は、こう仰せられる、"},{"ref":"Zech.12.2","start":38012002,"end":38012002,"break":"none","ruby":[[1,1,"み"],[17,2,"しゅうい"],[26,1,"たみ"],[33,1,"さかずき"],[53,1,"せ"],[55,1,"かこ"],[59,1,"とき"],[65,1,"およ"]],"text":"「見よ、わたしはエルサレムを、その周囲にあるすべての民をよろめかす杯にしようとしている。これはエルサレムの攻め囲まれる時、ユダにも及ぶ。"},{"ref":"Zech.12.3","start":38012003,"end":38012003,"break":"none","ruby":[[2,1,"ひ"],[20,1,"たみ"],[22,1,"たい"],[25,1,"おも"],[27,1,"いし"],[35,1,"も"],[40,1,"もの"],[44,1,"だい"],[45,1,"きず"],[47,1,"う"],[51,1,"ち"],[53,2,"くにぐに"],[56,1,"たみ"],[58,1,"みな"],[59,1,"あつ"],[67,1,"せ"]],"text":"その日には、わたしはエルサレムをすべての民に対して重い石とする。これを持ちあげる者はみな大傷を受ける。地の国々の民は皆集まって、これを攻める。"},{"ref":"Zech.12.4","start":38012004,"end":38012004,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"ひ"],[21,1,"うま"],[23,1,"う"],[26,1,"おどろ"],[32,1,"の"],[34,1,"て"],[36,1,"う"],[39,1,"くる"],[53,1,"たみ"],[55,1,"うま"],[63,1,"う"],[79,1,"いえ"],[81,1,"たい"],[90,1,"め"],[92,1,"ひら"]],"text":"主は言われる、その日には、わたしはすべての馬を撃って驚かせ、その乗り手を撃って狂わせる。しかし、もろもろの民の馬を、ことごとく撃って、めくらとするとき、ユダの家に対しては、わたしの目を開く。"},{"ref":"Zech.12.5","start":38012005,"end":38012005,"break":"none","ruby":[[2,1,"とき"],[6,1,"しょ"],[7,1,"ぞく"],[12,1,"こころ"],[14,1,"なか"],[23,2,"じゅうみん"],[29,1,"かみ"],[31,2,"ばんぐん"],[34,1,"しゅ"],[39,2,"ちからづよ"],[47,1,"い"]],"text":"その時ユダの諸族は、その心の中に『エルサレムの住民は、その神、万軍の主によって力強くなった』と言う。"},{"ref":"Zech.12.6","start":38012006,"end":38012006,"break":"none","ruby":[[2,1,"ひ"],[13,1,"しょ"],[14,1,"ぞく"],[21,1,"なか"],[23,2,"ひざら"],[31,1,"むぎ"],[32,1,"たば"],[34,1,"なか"],[47,1,"かれ"],[50,1,"みぎ"],[52,1,"ひだり"],[57,2,"しゅうい"],[66,1,"たみ"],[69,1,"や"],[71,1,"ほろ"],[92,1,"ところ"],[105,1,"ひと"],[107,1,"す"],[109,1,"ところ"]],"text":"その日には、わたしはユダの諸族を、たきぎの中の火皿のようにし、麦束の中のたいまつのようにする。彼らは右に左に、その周囲にあるすべての民を、焼き滅ぼす。しかしエルサレムはなお、そのもとの所、すなわちエルサレムで、人の住む所となる。"},{"ref":"Zech.12.7","start":38012007,"end":38012007,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,2,"まくや"],[10,1,"すく"],[22,1,"いえ"],[24,2,"こうえい"],[34,2,"じゅうみん"],[37,2,"こうえい"],[45,2,"こうえい"]],"text":"主はまずユダの幕屋を救われる。これはダビデの家の光栄と、エルサレムの住民の光栄とが、ユダの光栄にまさることのないようにするためである。"},{"ref":"Zech.12.8","start":38012008,"end":38012008,"break":"none","ruby":[[2,1,"ひ"],[4,1,"しゅ"],[12,2,"じゅうみん"],[15,1,"まも"],[20,1,"かれ"],[23,1,"なか"],[25,1,"よわ"],[27,1,"もの"],[32,1,"ひ"],[52,1,"いえ"],[54,1,"かみ"],[60,1,"かれ"],[63,1,"さき"],[66,1,"しゅ"],[68,1,"つかい"]],"text":"その日、主はエルサレムの住民を守られる。彼らの中の弱い者も、その日には、ダビデのようになる。またダビデの家は神のように、彼らに先だつ主の使のようになる。"},{"ref":"Zech.12.9","start":38012009,"end":38012009,"break":"none","ruby":[[2,1,"ひ"],[16,1,"せ"],[19,1,"く"],[21,2,"こくみん"],[30,1,"ほろ"],[35,1,"つと"]],"text":"その日には、わたしはエルサレムに攻めて来る国民を、ことごとく滅ぼそうと努める。"},{"ref":"Zech.12.10","start":38012010,"end":38012010,"break":"paragraph","ruby":[[8,1,"いえ"],[18,2,"じゅうみん"],[22,1,"めぐ"],[25,1,"いのり"],[27,1,"れい"],[30,1,"そそ"],[33,1,"かれ"],[38,1,"さ"],[41,1,"もの"],[43,1,"み"],[45,1,"とき"],[50,1,"こ"],[55,1,"なげ"],[60,1,"かれ"],[65,1,"なげ"],[75,1,"かな"],[82,1,"かれ"],[90,1,"かな"]],"text":"わたしはダビデの家およびエルサレムの住民に、恵みと祈の霊とを注ぐ。彼らはその刺した者を見る時、ひとり子のために嘆くように彼のために嘆き、ういごのために悲しむように、彼のためにいたく悲しむ。"},{"ref":"Zech.12.11","start":38012011,"end":38012011,"break":"none","ruby":[[2,1,"ひ"],[12,1,"なげ"],[20,2,"へいや"],[38,1,"なげ"],[44,1,"おお"]],"text":"その日には、エルサレムの嘆きは、メギドの平野にあったハダデ・リンモンのための嘆きのように大きい。"},{"ref":"Zech.12.12","start":38012012,"end":38012012,"break":"none","ruby":[[0,1,"くに"],[5,2,"しぞく"],[11,1,"わか"],[14,1,"なげ"],[25,1,"いえ"],[27,2,"しぞく"],[30,1,"わか"],[33,1,"なげ"],[38,1,"つま"],[42,1,"わか"],[45,1,"なげ"],[52,1,"いえ"],[54,2,"しぞく"],[57,1,"わか"],[60,1,"なげ"],[65,1,"つま"],[69,1,"わか"],[72,1,"なげ"]],"text":"国じゅう、氏族おのおの別れて嘆く。すなわちダビデの家の氏族は別れて嘆き、その妻たちも別れて嘆く。ナタンの家の氏族は別れて嘆き、その妻たちも別れて嘆く。"},{"ref":"Zech.12.13","start":38012013,"end":38012013,"break":"none","ruby":[[3,1,"いえ"],[5,2,"しぞく"],[8,1,"わか"],[11,1,"なげ"],[16,1,"つま"],[20,1,"わか"],[23,1,"なげ"],[30,2,"しぞく"],[33,1,"わか"],[36,1,"なげ"],[41,1,"つま"],[45,1,"わか"],[48,1,"なげ"]],"text":"レビの家の氏族は別れて嘆き、その妻たちも別れて嘆く。シメイの氏族は別れて嘆き、その妻たちも別れて嘆く。"},{"ref":"Zech.12.14","start":38012014,"end":38012014,"break":"none","ruby":[[2,1,"た"],[4,2,"しぞく"],[7,1,"みな"],[8,1,"わか"],[11,1,"なげ"],[16,1,"つま"],[20,1,"わか"],[23,1,"なげ"]],"text":"その他の氏族も皆別れて嘆き、その妻たちも別れて嘆くのである。"}]