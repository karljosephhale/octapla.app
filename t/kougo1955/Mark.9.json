[{"ref":"Mark.9.1","start":41009001,"end":41009001,"break":"paragraph","ruby":[[3,1,"かれ"],[6,1,"い"],[14,1,"き"],[23,1,"かみ"],[25,1,"くに"],[27,1,"ちから"],[32,1,"く"],[36,1,"み"],[42,1,"けっ"],[45,1,"し"],[47,1,"あじ"],[52,1,"もの"],[58,1,"た"],[63,1,"もの"],[65,1,"なか"]],"text":"また、彼らに言われた、「よく聞いておくがよい。神の国が力をもって来るのを見るまでは、決して死を味わわない者が、ここに立っている者の中にいる」。"},{"ref":"Mark.9.2","start":41009002,"end":41009002,"break":"paragraph","ruby":[[0,2,"むいか"],[3,1,"のち"],[26,1,"つ"],[30,1,"たか"],[32,1,"やま"],[34,1,"のぼ"],[44,1,"かれ"],[47,1,"め"],[49,1,"まえ"],[55,1,"すがた"],[57,1,"かわ"]],"text":"六日の後、イエスは、ただペテロ、ヤコブ、ヨハネだけを連れて、高い山に登られた。ところが、彼らの目の前でイエスの姿が変り、"},{"ref":"Mark.9.3","start":41009003,"end":41009003,"break":"none","ruby":[[2,1,"ころも"],[4,2,"まっしろ"],[7,1,"かがや"],[13,1,"ぬの"],[25,1,"しろ"]],"text":"その衣は真白く輝き、どんな布さらしでも、それほどに白くすることはできないくらいになった。"},{"ref":"Mark.9.4","start":41009004,"end":41009004,"break":"none","ruby":[[12,1,"とも"],[14,1,"かれ"],[17,1,"あらわ"],[25,1,"かた"],[27,1,"あ"]],"text":"すると、エリヤがモーセと共に彼らに現れて、イエスと語り合っていた。"},{"ref":"Mark.9.5","start":41009005,"end":41009005,"break":"none","ruby":[[12,1,"い"],[17,2,"せんせい"],[54,2,"こや"],[59,1,"た"]],"text":"ペテロはイエスにむかって言った、「先生、わたしたちがここにいるのは、すばらしいことです。それで、わたしたちは小屋を三つ建てましょう。一つはあなたのために、一つはモーセのために、一つはエリヤのために」。"},{"ref":"Mark.9.6","start":41009006,"end":41009006,"break":"none","ruby":[[2,1,"い"],[12,1,"もの"],[14,2,"ひじょう"],[17,1,"おそ"],[29,1,"なに"],[31,1,"い"]],"text":"そう言ったのは、みんなの者が非常に恐れていたので、ペテロは何を言ってよいか、わからなかったからである。"},{"ref":"Mark.9.7","start":41009007,"end":41009007,"break":"none","ruby":[[4,1,"くも"],[8,1,"おこ"],[11,1,"かれ"],[25,1,"くも"],[27,1,"なか"],[30,1,"こえ"],[44,1,"あい"],[47,1,"こ"],[55,1,"き"]],"text":"すると、雲がわき起って彼らをおおった。そして、その雲の中から声があった、「これはわたしの愛する子である。これに聞け」。"},{"ref":"Mark.9.8","start":41009008,"end":41009008,"break":"none","ruby":[[0,1,"かれ"],[3,1,"いそ"],[6,1,"み"],[19,1,"み"],[32,2,"じぶん"],[37,2,"いっしょ"]],"text":"彼らは急いで見まわしたが、もはやだれも見えず、ただイエスだけが、自分たちと一緒におられた。"},{"ref":"Mark.9.9","start":41009009,"end":41009009,"break":"paragraph","ruby":[[0,2,"いちどう"],[3,1,"やま"],[5,1,"くだ"],[8,1,"く"],[18,1,"ひと"],[20,1,"こ"],[22,2,"しにん"],[25,1,"なか"],[39,1,"み"],[48,1,"はな"],[59,1,"かれ"],[62,1,"めい"]],"text":"一同が山を下って来るとき、イエスは「人の子が死人の中からよみがえるまでは、いま見たことをだれにも話してはならない」と、彼らに命じられた。"},{"ref":"Mark.9.10","start":41009010,"end":41009010,"break":"none","ruby":[[0,1,"かれ"],[5,2,"ことば"],[8,1,"こころ"],[13,2,"しにん"],[16,1,"なか"],[35,1,"たがい"],[37,1,"ろん"],[39,1,"あ"]],"text":"彼らはこの言葉を心にとめ、死人の中からよみがえるとはどういうことかと、互に論じ合った。"},{"ref":"Mark.9.11","start":41009011,"end":41009011,"break":"none","ruby":[[7,1,"たず"],[15,2,"りっぽう"],[17,2,"がくしゃ"],[27,1,"さき"],[29,1,"く"],[35,1,"い"]],"text":"そしてイエスに尋ねた、「なぜ、律法学者たちは、エリヤが先に来るはずだと言っているのですか」。"},{"ref":"Mark.9.12","start":41009012,"end":41009012,"break":"none","ruby":[[4,1,"い"],[10,1,"たし"],[18,1,"さき"],[23,2,"ばんじ"],[26,1,"もと"],[31,1,"あらた"],[39,1,"ひと"],[41,1,"こ"],[47,1,"かれ"],[49,1,"おお"],[52,1,"くる"],[56,1,"う"],[61,1,"は"],[71,1,"か"]],"text":"イエスは言われた、「確かに、エリヤが先にきて、万事を元どおりに改める。しかし、人の子について、彼が多くの苦しみを受け、かつ恥ずかしめられると、書いてあるのはなぜか。"},{"ref":"Mark.9.13","start":41009013,"end":41009013,"break":"none","ruby":[[9,1,"い"],[30,1,"かれ"],[35,1,"か"],[44,2,"ひとびと"],[47,2,"じぶん"],[53,1,"かれ"]],"text":"しかしあなたがたに言っておく、エリヤはすでにきたのだ。そして彼について書いてあるように、人々は自分かってに彼をあしらった」。"},{"ref":"Mark.9.14","start":41009014,"end":41009014,"break":"paragraph","ruby":[[3,1,"かれ"],[9,2,"でし"],[14,1,"ところ"],[18,1,"み"],[22,1,"おお"],[26,2,"ぐんしゅう"],[29,2,"でし"],[34,1,"と"],[36,1,"かこ"],[42,2,"りっぽう"],[44,2,"がくしゃ"],[49,1,"かれ"],[52,1,"ろん"],[54,1,"あ"]],"text":"さて、彼らがほかの弟子たちの所にきて見ると、大ぜいの群衆が弟子たちを取り囲み、そして律法学者たちが彼らと論じ合っていた。"},{"ref":"Mark.9.15","start":41009015,"end":41009015,"break":"none","ruby":[[0,2,"ぐんしゅう"],[12,1,"み"],[17,2,"ひじょう"],[20,1,"おどろ"],[23,1,"か"],[25,1,"よ"]],"text":"群衆はみな、すぐイエスを見つけて、非常に驚き、駆け寄ってきて、あいさつをした。"},{"ref":"Mark.9.16","start":41009016,"end":41009016,"break":"none","ruby":[[4,1,"かれ"],[15,1,"かれ"],[18,1,"なに"],[20,1,"ろん"],[29,1,"たず"]],"text":"イエスが彼らに、「あなたがたは彼らと何を論じているのか」と尋ねられると、"},{"ref":"Mark.9.17","start":41009017,"end":41009017,"break":"none","ruby":[[0,2,"ぐんしゅう"],[7,1,"こた"],[12,2,"せんせい"],[18,1,"れい"],[39,1,"つ"],[42,1,"まい"]],"text":"群衆のひとりが答えた、「先生、おしの霊につかれているわたしのむすこを、こちらに連れて参りました。"},{"ref":"Mark.9.18","start":41009018,"end":41009018,"break":"none","ruby":[[0,1,"れい"],[21,1,"かれ"],[23,1,"ひ"],[25,1,"たお"],[32,1,"かれ"],[37,1,"ふ"],[40,1,"は"],[68,2,"でし"],[76,1,"れい"],[78,1,"お"],[80,1,"だ"],[90,1,"ねが"]],"text":"霊がこのむすこにとりつきますと、どこででも彼を引き倒し、それから彼はあわを吹き、歯をくいしばり、からだをこわばらせてしまいます。それでお弟子たちに、この霊を追い出してくださるように願いましたが、できませんでした」。"},{"ref":"Mark.9.19","start":41009019,"end":41009019,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[21,1,"ふ"],[22,2,"しんこう"],[25,2,"じだい"],[47,2,"いっしょ"],[68,2,"がまん"],[79,1,"こ"],[85,1,"ところ"],[87,1,"つ"]],"text":"イエスは答えて言われた、「ああ、なんという不信仰な時代であろう。いつまで、わたしはあなたがたと一緒におられようか。いつまで、あなたがたに我慢ができようか。その子をわたしの所に連れてきなさい」。"},{"ref":"Mark.9.20","start":41009020,"end":41009020,"break":"none","ruby":[[3,2,"ひとびと"],[9,1,"こ"],[15,1,"つ"],[21,1,"れい"],[27,1,"み"],[30,1,"いな"],[35,1,"こ"],[47,1,"こ"],[49,1,"ち"],[51,1,"たお"],[57,1,"ふ"]],"text":"そこで人々は、その子をみもとに連れてきた。霊がイエスを見るや否や、その子をひきつけさせたので、子は地に倒れ、あわを吹きながらころげまわった。"},{"ref":"Mark.9.21","start":41009021,"end":41009021,"break":"none","ruby":[[8,2,"ちちおや"],[30,1,"たず"],[37,2,"ちちおや"],[40,1,"こた"],[45,1,"おさな"],[47,1,"とき"]],"text":"そこで、イエスが父親に「いつごろから、こんなになったのか」と尋ねられると、父親は答えた、「幼い時からです。"},{"ref":"Mark.9.22","start":41009022,"end":41009022,"break":"none","ruby":[[0,1,"れい"],[9,1,"こ"],[11,1,"ひ"],[13,1,"なか"],[15,1,"みず"],[17,1,"なか"],[19,1,"な"],[21,1,"い"],[25,1,"ころ"],[56,1,"たす"]],"text":"霊はたびたび、この子を火の中、水の中に投げ入れて、殺そうとしました。しかしできますれば、わたしどもをあわれんでお助けください」。"},{"ref":"Mark.9.23","start":41009023,"end":41009023,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[20,1,"い"],[25,1,"しん"],[28,1,"もの"],[35,1,"こと"]],"text":"イエスは彼に言われた、「もしできれば、と言うのか。信ずる者には、どんな事でもできる」。"},{"ref":"Mark.9.24","start":41009024,"end":41009024,"break":"none","ruby":[[2,1,"こ"],[4,2,"ちちおや"],[9,1,"さけ"],[12,1,"い"],[17,1,"しん"],[22,1,"ふ"],[23,2,"しんこう"],[32,1,"たす"]],"text":"その子の父親はすぐ叫んで言った、「信じます。不信仰なわたしを、お助けください」。"},{"ref":"Mark.9.25","start":41009025,"end":41009025,"break":"none","ruby":[[4,2,"ぐんしゅう"],[7,1,"か"],[9,1,"よ"],[12,1,"く"],[28,1,"れい"],[34,1,"い"],[47,1,"れい"],[58,1,"めい"],[64,1,"こ"],[67,1,"で"],[69,1,"い"],[73,1,"ど"],[80,1,"く"]],"text":"イエスは群衆が駆け寄って来るのをごらんになって、けがれた霊をしかって言われた、「おしとつんぼの霊よ、わたしがおまえに命じる。この子から出て行け。二度と、はいって来るな」。"},{"ref":"Mark.9.26","start":41009026,"end":41009026,"break":"none","ruby":[[3,1,"れい"],[5,1,"さけ"],[7,1,"ごえ"],[12,1,"はげ"],[15,1,"ひ"],[22,1,"で"],[24,1,"い"],[30,1,"こ"],[32,2,"しにん"],[44,1,"おお"],[47,1,"ひと"],[50,1,"し"],[56,1,"い"]],"text":"すると霊は叫び声をあげ、激しく引きつけさせて出て行った。その子は死人のようになったので、多くの人は、死んだのだと言った。"},{"ref":"Mark.9.27","start":41009027,"end":41009027,"break":"none","ruby":[[8,1,"て"],[10,1,"と"],[13,1,"おこ"],[21,1,"こ"],[23,1,"た"],[25,1,"あ"]],"text":"しかし、イエスが手を取って起されると、その子は立ち上がった。"},{"ref":"Mark.9.28","start":41009028,"end":41009028,"break":"none","ruby":[[0,1,"いえ"],[10,2,"でし"],[20,1,"たず"],[37,1,"れい"],[39,1,"お"],[41,1,"だ"]],"text":"家にはいられたとき、弟子たちはひそかにお尋ねした、「わたしたちは、どうして霊を追い出せなかったのですか」。"},{"ref":"Mark.9.29","start":41009029,"end":41009029,"break":"none","ruby":[[8,1,"い"],[21,1,"いのり"],[35,1,"お"],[37,1,"だ"]],"text":"すると、イエスは言われた、「このたぐいは、祈によらなければ、どうしても追い出すことはできない」。"},{"ref":"Mark.9.30","start":41009030,"end":41009030,"break":"paragraph","ruby":[[4,1,"かれ"],[10,1,"た"],[12,1,"さ"],[24,1,"い"],[33,1,"ひと"],[35,1,"き"],[42,1,"この"]],"text":"それから彼らはそこを立ち去り、ガリラヤをとおって行ったが、イエスは人に気づかれるのを好まれなかった。"},{"ref":"Mark.9.31","start":41009031,"end":41009031,"break":"none","ruby":[[8,2,"でし"],[13,1,"おし"],[18,1,"ひと"],[20,1,"こ"],[22,2,"ひとびと"],[25,1,"て"],[32,1,"かれ"],[35,1,"ころ"],[39,1,"ころ"],[46,1,"か"],[48,1,"のち"],[61,1,"い"]],"text":"それは、イエスが弟子たちに教えて、「人の子は人々の手にわたされ、彼らに殺され、殺されてから三日の後によみがえるであろう」と言っておられたからである。"},{"ref":"Mark.9.32","start":41009032,"end":41009032,"break":"none","ruby":[[4,1,"かれ"],[11,1,"い"],[18,1,"さと"],[24,1,"たず"],[29,1,"おそ"]],"text":"しかし、彼らはイエスの言われたことを悟らず、また尋ねるのを恐れていた。"},{"ref":"Mark.9.33","start":41009033,"end":41009033,"break":"paragraph","ruby":[[4,1,"かれ"],[19,1,"いえ"],[32,2,"でし"],[37,1,"たず"],[50,2,"とちゅう"],[53,1,"なに"],[55,1,"ろん"]],"text":"それから彼らはカペナウムにきた。そして家におられるとき、イエスは弟子たちに尋ねられた、「あなたがたは途中で何を論じていたのか」。"},{"ref":"Mark.9.34","start":41009034,"end":41009034,"break":"none","ruby":[[0,1,"かれ"],[3,1,"だま"],[12,2,"とちゅう"],[22,1,"えら"],[27,1,"たがい"],[29,1,"ろん"],[31,1,"あ"]],"text":"彼らは黙っていた。それは途中で、だれが一ばん偉いかと、互に論じ合っていたからである。"},{"ref":"Mark.9.35","start":41009035,"end":41009035,"break":"none","ruby":[[14,2,"でし"],[17,1,"よ"],[23,1,"い"],[36,1,"さき"],[42,1,"おも"],[61,1,"つか"],[64,1,"もの"]],"text":"そこで、イエスはすわって十二弟子を呼び、そして言われた、「だれでも一ばん先になろうと思うならば、一ばんあとになり、みんなに仕える者とならねばならない」。"},{"ref":"Mark.9.36","start":41009036,"end":41009036,"break":"none","ruby":[[8,1,"おさ"],[10,1,"ご"],[18,1,"かれ"],[23,1,"なか"],[25,1,"た"],[32,1,"だ"],[35,1,"い"]],"text":"そして、ひとりの幼な子をとりあげて、彼らのまん中に立たせ、それを抱いて言われた。"},{"ref":"Mark.9.37","start":41009037,"end":41009037,"break":"none","ruby":[[11,1,"おさ"],[13,1,"ご"],[24,1,"な"],[29,1,"う"],[34,1,"もの"],[41,1,"う"],[59,1,"う"],[64,1,"もの"],[71,1,"う"],[98,1,"う"]],"text":"「だれでも、このような幼な子のひとりを、わたしの名のゆえに受けいれる者は、わたしを受けいれるのである。そして、わたしを受けいれる者は、わたしを受けいれるのではなく、わたしをおつかわしになったかたを受けいれるのである」。"},{"ref":"Mark.9.38","start":41009038,"end":41009038,"break":"paragraph","ruby":[[8,1,"い"],[13,2,"せんせい"],[28,1,"もの"],[35,1,"な"],[37,1,"つか"],[40,2,"あくれい"],[43,1,"お"],[45,1,"だ"],[52,1,"み"],[60,1,"ひと"]],"text":"ヨハネがイエスに言った、「先生、わたしたちについてこない者が、あなたの名を使って悪霊を追い出しているのを見ましたが、その人はわたしたちについてこなかったので、やめさせました」。"},{"ref":"Mark.9.39","start":41009039,"end":41009039,"break":"none","ruby":[[4,1,"い"],[28,1,"な"],[30,1,"ちから"],[36,1,"おこな"]],"text":"イエスは言われた、「やめさせないがよい。だれでもわたしの名で力あるわざを行いながら、すぐそのあとで、わたしをそしることはできない。"},{"ref":"Mark.9.40","start":41009040,"end":41009040,"break":"none","ruby":[[6,2,"はんたい"],[11,1,"もの"],[20,2,"みかた"]],"text":"わたしたちに反対しない者は、わたしたちの味方である。"},{"ref":"Mark.9.41","start":41009041,"end":41009041,"break":"none","ruby":[[15,1,"もの"],[29,1,"みず"],[30,2,"いっぱい"],[34,1,"の"],[47,1,"い"],[54,1,"けっ"],[59,1,"むく"]],"text":"だれでも、キリストについている者だというので、あなたがたに水一杯でも飲ませてくれるものは、よく言っておくが、決してその報いからもれることはないであろう。"},{"ref":"Mark.9.42","start":41009042,"end":41009042,"break":"none","ruby":[[7,1,"しん"],[14,1,"ちい"],[17,1,"もの"],[29,1,"もの"],[32,1,"おお"],[40,1,"くび"],[47,1,"うみ"],[49,1,"な"],[51,1,"こ"],[55,1,"ほう"]],"text":"また、わたしを信じるこれらの小さい者のひとりをつまずかせる者は、大きなひきうすを首にかけられて海に投げ込まれた方が、はるかによい。"},{"ref":"Mark.9.43","start":41009043,"end":41009043,"break":"none","ruby":[[7,2,"かたて"],[10,1,"つみ"],[12,1,"おか"],[22,1,"き"],[24,1,"す"],[30,2,"りょうて"],[40,2,"じごく"],[43,1,"き"],[47,1,"ひ"],[49,1,"なか"],[51,1,"お"],[53,1,"こ"],[66,1,"いのち"],[68,1,"はい"],[70,1,"ほう"]],"text":"もし、あなたの片手が罪を犯させるなら、それを切り捨てなさい。両手がそろったままで地獄の消えない火の中に落ち込むよりは、かたわになって命に入る方がよい。〔"},{"ref":"Mark.9.44","start":41009044,"end":41009044,"break":"none","ruby":[[0,2,"じごく"],[12,1,"ひ"],[14,1,"き"]],"text":"地獄では、うじがつきず、火も消えることがない。〕"},{"ref":"Mark.9.45","start":41009045,"end":41009045,"break":"none","ruby":[[7,2,"かたあし"],[10,1,"つみ"],[12,1,"おか"],[22,1,"き"],[24,1,"す"],[30,2,"りょうあし"],[40,2,"じごく"],[43,1,"な"],[45,1,"い"],[54,2,"かたあし"],[57,1,"いのち"],[59,1,"はい"],[61,1,"ほう"]],"text":"もし、あなたの片足が罪を犯させるなら、それを切り捨てなさい。両足がそろったままで地獄に投げ入れられるよりは、片足で命に入る方がよい。〔"},{"ref":"Mark.9.46","start":41009046,"end":41009046,"break":"none","ruby":[[0,2,"じごく"],[12,1,"ひ"],[14,1,"き"]],"text":"地獄では、うじがつきず、火も消えることがない。〕"},{"ref":"Mark.9.47","start":41009047,"end":41009047,"break":"none","ruby":[[7,2,"かため"],[10,1,"つみ"],[12,1,"おか"],[22,1,"ぬ"],[24,1,"だ"],[30,1,"りょう"],[31,1,"がん"],[40,2,"じごく"],[43,1,"な"],[45,1,"い"],[54,2,"かため"],[60,1,"かみ"],[62,1,"くに"],[64,1,"はい"],[66,1,"ほう"]],"text":"もし、あなたの片目が罪を犯させるなら、それを抜き出しなさい。両眼がそろったままで地獄に投げ入れられるよりは、片目になって神の国に入る方がよい。"},{"ref":"Mark.9.48","start":41009048,"end":41009048,"break":"none","ruby":[[0,2,"じごく"],[12,1,"ひ"],[14,1,"き"]],"text":"地獄では、うじがつきず、火も消えることがない。"},{"ref":"Mark.9.49","start":41009049,"end":41009049,"break":"none","ruby":[[0,1,"ひと"],[5,1,"ひ"],[7,1,"しお"]],"text":"人はすべて火で塩づけられねばならない。"},{"ref":"Mark.9.50","start":41009050,"end":41009050,"break":"none","ruby":[[0,1,"しお"],[18,1,"しお"],[20,1,"あじ"],[27,1,"なに"],[34,1,"あじ"],[36,1,"と"],[51,2,"じしん"],[54,1,"うち"],[56,1,"しお"],[58,1,"も"],[68,1,"たがい"],[70,1,"やわ"]],"text":"塩はよいものである。しかし、もしその塩の味がぬけたら、何によってその味が取りもどされようか。あなたがた自身の内に塩を持ちなさい。そして、互に和らぎなさい」。"}]