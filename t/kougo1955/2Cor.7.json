[{"ref":"2Cor.7.1","start":47007001,"end":47007001,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[20,2,"やくそく"],[23,1,"あた"],[35,1,"にく"],[37,1,"れい"],[45,1,"けが"],[49,2,"じぶん"],[56,1,"かみ"],[62,1,"まった"],[64,1,"きよ"]],"text":"愛する者たちよ。わたしたちは、このような約束を与えられているのだから、肉と霊とのいっさいの汚れから自分をきよめ、神をおそれて全く清くなろうではないか。"},{"ref":"2Cor.7.2","start":47007002,"end":47007002,"break":"paragraph","ruby":[[10,1,"こころ"],[12,1,"ひら"],[30,2,"ふぎ"],[45,2,"はめつ"],[68,1,"と"]],"text":"どうか、わたしたちに心を開いてほしい。わたしたちは、だれにも不義をしたことがなく、だれをも破滅におとしいれたことがなく、だれからもだまし取ったことがない。"},{"ref":"2Cor.7.3","start":47007003,"end":47007003,"break":"none","ruby":[[5,1,"せ"],[14,1,"い"],[22,1,"まえ"],[25,1,"い"],[42,1,"こころ"],[56,1,"せい"],[57,1,"し"],[59,1,"とも"]],"text":"わたしは、責めるつもりでこう言うのではない。前にも言ったように、あなたがたはわたしの心のうちにいて、わたしたちと生死を共にしているのである。"},{"ref":"2Cor.7.4","start":47007004,"end":47007004,"break":"none","ruby":[[10,1,"おお"],[13,2,"しんらい"],[17,1,"おお"],[20,1,"ほこ"],[36,1,"なぐさ"],[39,1,"う"],[46,2,"かんなん"],[49,1,"なか"],[54,1,"よろこ"],[57,1,"み"]],"text":"わたしはあなたがたを大いに信頼し、大いに誇っている。また、あふれるばかり慰めを受け、あらゆる患難の中にあって喜びに満ちあふれている。"},{"ref":"2Cor.7.5","start":47007005,"end":47007005,"break":"paragraph","ruby":[[9,1,"つ"],[21,1,"み"],[23,1,"すこ"],[26,1,"やす"],[37,2,"かんなん"],[40,1,"あ"],[43,1,"そと"],[46,1,"たたか"],[49,1,"うち"],[52,1,"おそ"]],"text":"さて、マケドニヤに着いたとき、わたしたちの身に少しの休みもなく、さまざまの患難に会い、外には戦い、内には恐れがあった。"},{"ref":"2Cor.7.6","start":47007006,"end":47007006,"break":"none","ruby":[[13,1,"もの"],[15,1,"なぐさ"],[18,1,"かみ"],[25,2,"とうらい"],[38,1,"なぐさ"],[41,1,"くだ"]],"text":"しかるに、うちしおれている者を慰める神は、テトスの到来によって、わたしたちを慰めて下さった。"},{"ref":"2Cor.7.7","start":47007007,"end":47007007,"break":"none","ruby":[[2,1,"かれ"],[4,2,"とうらい"],[17,1,"かれ"],[26,1,"う"],[31,1,"なぐさ"],[38,1,"なぐさ"],[41,1,"くだ"],[61,1,"した"],[69,1,"なげ"],[83,1,"たい"],[86,2,"ねっしん"],[94,1,"し"],[108,1,"よろこ"],[115,1,"ま"],[117,1,"くわ"]],"text":"ただ彼の到来によるばかりではなく、彼があなたがたから受けたその慰めをもって、慰めて下さった。すなわち、あなたがたがわたしを慕っていること、嘆いていること、またわたしに対して熱心であることを知らせてくれたので、わたしの喜びはいよいよ増し加わったのである。"},{"ref":"2Cor.7.8","start":47007008,"end":47007008,"break":"none","ruby":[[10,2,"てがみ"],[19,1,"かな"],[36,1,"く"],[45,2,"てがみ"],[53,1,"あいだ"],[66,1,"かな"],[73,1,"み"],[75,1,"く"]],"text":"そこで、たとい、あの手紙であなたがたを悲しませたとしても、わたしはそれを悔いていない。あの手紙がしばらくの間ではあるが、あなたがたを悲しませたのを見て悔いたとしても、"},{"ref":"2Cor.7.9","start":47007009,"end":47007009,"break":"none","ruby":[[0,1,"いま"],[2,1,"よろこ"],[18,1,"かな"],[29,1,"かな"],[33,1,"く"],[35,1,"あらた"],[39,1,"いた"],[59,1,"かな"],[66,1,"かみ"],[73,1,"そ"],[94,1,"そん"],[95,1,"がい"],[97,1,"う"]],"text":"今は喜んでいる。それは、あなたがたが悲しんだからではなく、悲しんで悔い改めるに至ったからである。あなたがたがそのように悲しんだのは、神のみこころに添うたことであって、わたしたちからはなんの損害も受けなかったのである。"},{"ref":"2Cor.7.10","start":47007010,"end":47007010,"break":"none","ruby":[[0,1,"かみ"],[7,1,"そ"],[10,1,"かな"],[15,1,"く"],[20,1,"すくい"],[22,1,"え"],[26,2,"くいあらた"],[30,1,"みちび"],[35,1,"よ"],[37,1,"かな"],[41,1,"し"]],"text":"神のみこころに添うた悲しみは、悔いのない救を得させる悔改めに導き、この世の悲しみは死をきたらせる。"},{"ref":"2Cor.7.11","start":47007011,"end":47007011,"break":"none","ruby":[[0,1,"み"],[3,1,"かみ"],[10,1,"そ"],[15,1,"かな"],[25,1,"ねつ"],[26,1,"じょう"],[34,1,"おこ"],[45,2,"べんめい"],[48,2,"ぎふん"],[51,1,"おそ"],[54,2,"あいぼ"],[57,2,"ねつい"],[64,2,"しょばつ"],[67,1,"いた"],[83,2,"もんだい"],[95,1,"てん"],[100,2,"けっぱく"],[108,2,"しょうめい"]],"text":"見よ、神のみこころに添うたその悲しみが、どんなにか熱情をあなたがたに起させたことか。また、弁明、義憤、恐れ、愛慕、熱意、それから処罰に至らせたことか。あなたがたはあの問題については、すべての点において潔白であることを証明したのである。"},{"ref":"2Cor.7.12","start":47007012,"end":47007012,"break":"none","ruby":[[14,1,"か"],[23,2,"ふぎ"],[28,1,"ひと"],[35,2,"ふぎ"],[38,1,"う"],[41,1,"ひと"],[56,1,"たい"],[65,1,"ねつ"],[66,1,"じょう"],[69,1,"かみ"],[71,1,"まえ"],[79,1,"あいだ"],[81,1,"あき"]],"text":"だから、わたしがあなたがたに書きおくったのは、不義をした人のためでも、不義を受けた人のためでもなく、わたしたちに対するあなたがたの熱情が、神の前にあなたがたの間で明らかになるためである。"},{"ref":"2Cor.7.13","start":47007013,"end":47007013,"break":"none","ruby":[[14,1,"なぐさ"],[28,1,"なぐさ"],[31,1,"うえ"],[37,1,"よろこ"],[40,1,"くわ"],[57,1,"よろこ"],[61,1,"かれ"],[68,2,"いちどう"],[74,2,"あんしん"]],"text":"こういうわけで、わたしたちは慰められたのである。これらの慰めの上にテトスの喜びが加わって、わたしたちはなおいっそう喜んだ。彼があなたがた一同によって安心させられたからである。"},{"ref":"2Cor.7.14","start":47007014,"end":47007014,"break":"none","ruby":[[8,1,"かれ"],[10,1,"たい"],[22,1,"すこ"],[25,1,"ほこ"],[37,1,"はじ"],[62,2,"しんじつ"],[65,1,"かた"],[76,1,"たい"],[79,1,"ほこ"],[85,2,"しんじつ"]],"text":"そして、わたしは彼に対してあなたがたのことを少しく誇ったが、それはわたしの恥にならないですんだ。あなたがたにいっさいのことを真実に語ったように、テトスに対して誇ったことも真実となってきたのである。"},{"ref":"2Cor.7.15","start":47007015,"end":47007015,"break":"none","ruby":[[2,1,"かれ"],[10,2,"いちどう"],[13,2,"じゅうじゅん"],[29,2,"じぶん"],[32,1,"むか"],[41,1,"おも"],[43,1,"だ"],[51,1,"こころ"],[59,1,"ほう"],[61,1,"よ"]],"text":"また彼は、あなたがた一同が従順であって、おそれおののきつつ自分を迎えてくれたことを思い出して、ますます心をあなたがたの方に寄せている。"},{"ref":"2Cor.7.16","start":47007016,"end":47007016,"break":"none","ruby":[[11,1,"まった"],[13,2,"しんらい"],[24,1,"よろこ"]],"text":"わたしは、あなたがたに全く信頼することができて、喜んでいる。"}]