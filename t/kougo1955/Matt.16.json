[{"ref":"Matt.16.1","start":40016001,"end":40016001,"break":"paragraph","ruby":[[4,1,"びと"],[10,1,"びと"],[13,2,"ちかよ"],[24,1,"こころ"],[27,1,"てん"],[35,1,"み"],[44,1,"い"]],"text":"パリサイ人とサドカイ人とが近寄ってきて、イエスを試み、天からのしるしを見せてもらいたいと言った。"},{"ref":"Matt.16.2","start":40016002,"end":40016002,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[19,2,"ゆうがた"],[27,1,"そら"],[36,1,"はれ"],[40,1,"い"]],"text":"イエスは彼らに言われた、「あなたがたは夕方になると、『空がまっかだから、晴だ』と言い、"},{"ref":"Matt.16.3","start":40016003,"end":40016003,"break":"none","ruby":[[2,1,"あ"],[4,1,"がた"],[8,1,"そら"],[10,1,"くも"],[24,1,"あ"],[29,1,"い"],[38,1,"そら"],[40,2,"もよう"],[43,2,"みわ"],[50,1,"し"],[56,1,"とき"],[62,2,"みわ"]],"text":"また明け方には『空が曇ってまっかだから、きょうは荒れだ』と言う。あなたがたは空の模様を見分けることを知りながら、時のしるしを見分けることができないのか。"},{"ref":"Matt.16.4","start":40016004,"end":40016004,"break":"none","ruby":[[0,2,"じゃあく"],[3,2,"ふぎ"],[6,2,"じだい"],[14,1,"もと"],[41,1,"あた"],[61,1,"かれ"],[67,1,"のこ"],[70,1,"た"],[72,1,"さ"]],"text":"邪悪で不義な時代は、しるしを求める。しかし、ヨナのしるしのほかには、なんのしるしも与えられないであろう」。そして、イエスは彼らをあとに残して立ち去られた。"},{"ref":"Matt.16.5","start":40016005,"end":40016005,"break":"paragraph","ruby":[[0,2,"でし"],[5,1,"む"],[8,1,"ぎし"],[10,1,"い"],[18,1,"も"],[21,1,"く"],[25,1,"わす"]],"text":"弟子たちは向こう岸に行ったが、パンを持って来るのを忘れていた。"},{"ref":"Matt.16.6","start":40016006,"end":40016006,"break":"none","ruby":[[7,1,"い"],[17,1,"びと"],[23,1,"びと"],[28,1,"だね"],[35,2,"けいかい"]],"text":"そこでイエスは言われた、「パリサイ人とサドカイ人とのパン種を、よくよく警戒せよ」。"},{"ref":"Matt.16.7","start":40016007,"end":40016007,"break":"none","ruby":[[0,2,"でし"],[9,2,"じぶん"],[17,1,"も"],[32,1,"い"],[36,1,"たがい"],[38,1,"ろん"],[40,1,"あ"]],"text":"弟子たちは、これは自分たちがパンを持ってこなかったためであろうと言って、互に論じ合った。"},{"ref":"Matt.16.8","start":40016008,"end":40016008,"break":"none","ruby":[[7,1,"し"],[10,1,"い"],[16,2,"しんこう"],[19,1,"うす"],[21,1,"もの"],[37,1,"たがい"],[39,1,"ろん"],[41,1,"あ"]],"text":"イエスはそれと知って言われた、「信仰の薄い者たちよ、なぜパンがないからだと互に論じ合っているのか。"},{"ref":"Matt.16.9","start":40016009,"end":40016009,"break":"none","ruby":[[10,1,"おぼ"],[27,1,"にん"],[29,1,"わ"],[35,1,"いく"],[38,1,"ひろ"]],"text":"まだわからないのか。覚えていないのか。五つのパンを五千人に分けたとき、幾かご拾ったか。"},{"ref":"Matt.16.10","start":40016010,"end":40016010,"break":"none","ruby":[[11,1,"にん"],[13,1,"わ"],[19,1,"いく"],[22,1,"ひろ"]],"text":"また、七つのパンを四千人に分けたとき、幾かご拾ったか。"},{"ref":"Matt.16.11","start":40016011,"end":40016011,"break":"none","ruby":[[4,1,"い"],[28,1,"さと"],[42,1,"びと"],[48,1,"びと"],[53,1,"だね"],[55,2,"けいかい"]],"text":"わたしが言ったのは、パンについてではないことを、どうして悟らないのか。ただ、パリサイ人とサドカイ人とのパン種を警戒しなさい」。"},{"ref":"Matt.16.12","start":40016012,"end":40016012,"break":"none","ruby":[[4,1,"かれ"],[12,2,"けいかい"],[17,1,"い"],[26,1,"だね"],[39,1,"びと"],[45,1,"びと"],[48,1,"おしえ"],[56,1,"さと"]],"text":"そのとき彼らは、イエスが警戒せよと言われたのは、パン種のことではなく、パリサイ人とサドカイ人との教のことであると悟った。"},{"ref":"Matt.16.13","start":40016013,"end":40016013,"break":"paragraph","ruby":[[14,2,"ちほう"],[17,1,"い"],[24,2,"でし"],[29,1,"たず"],[32,1,"い"],[38,2,"ひとびと"],[41,1,"ひと"],[43,1,"こ"],[48,1,"い"]],"text":"イエスがピリポ・カイザリヤの地方に行かれたとき、弟子たちに尋ねて言われた、「人々は人の子をだれと言っているか」。"},{"ref":"Matt.16.14","start":40016014,"end":40016014,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[10,2,"ひとびと"],[24,1,"い"],[38,1,"ひと"],[48,1,"い"],[62,3,"よげんしゃ"],[72,1,"い"],[77,1,"もの"]],"text":"彼らは言った、「ある人々はバプテスマのヨハネだと言っています。しかし、ほかの人たちは、エリヤだと言い、また、エレミヤあるいは預言者のひとりだ、と言っている者もあります」。"},{"ref":"Matt.16.15","start":40016015,"end":40016015,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[34,1,"い"]],"text":"そこでイエスは彼らに言われた、「それでは、あなたがたはわたしをだれと言うか」。"},{"ref":"Matt.16.16","start":40016016,"end":40016016,"break":"none","ruby":[[8,1,"こた"],[11,1,"い"],[22,1,"い"],[25,1,"かみ"],[27,1,"こ"]],"text":"シモン・ペテロが答えて言った、「あなたこそ、生ける神の子キリストです」。"},{"ref":"Matt.16.17","start":40016017,"end":40016017,"break":"none","ruby":[[8,1,"かれ"],[14,1,"い"],[47,1,"こと"],[57,2,"けつにく"],[64,1,"てん"],[73,1,"ちち"]],"text":"すると、イエスは彼にむかって言われた、「バルヨナ・シモン、あなたはさいわいである。あなたにこの事をあらわしたのは、血肉ではなく、天にいますわたしの父である。"},{"ref":"Matt.16.18","start":40016018,"end":40016018,"break":"none","ruby":[[12,1,"い"],[36,1,"いわ"],[38,1,"うえ"],[44,2,"きょうかい"],[47,1,"た"],[52,2,"よみ"],[55,1,"ちから"],[60,1,"う"],[62,1,"か"]],"text":"そこで、わたしもあなたに言う。あなたはペテロである。そして、わたしはこの岩の上にわたしの教会を建てよう。黄泉の力もそれに打ち勝つことはない。"},{"ref":"Matt.16.19","start":40016019,"end":40016019,"break":"none","ruby":[[9,2,"てんごく"],[15,1,"さづ"],[28,2,"ちじょう"],[38,1,"てん"],[50,2,"ちじょう"],[53,1,"と"],[58,1,"てん"],[61,1,"と"]],"text":"わたしは、あなたに天国のかぎを授けよう。そして、あなたが地上でつなぐことは、天でもつながれ、あなたが地上で解くことは天でも解かれるであろう」。"},{"ref":"Matt.16.20","start":40016020,"end":40016020,"break":"none","ruby":[[10,2,"じぶん"],[27,1,"い"],[37,2,"でし"],[42,1,"いまし"]],"text":"そのとき、イエスは、自分がキリストであることをだれにも言ってはいけないと、弟子たちを戒められた。"},{"ref":"Matt.16.21","start":40016021,"end":40016021,"break":"paragraph","ruby":[[2,1,"とき"],[16,2,"じぶん"],[19,1,"かなら"],[27,1,"い"],[30,2,"ちょうろう"],[33,3,"さいしちょう"],[37,2,"りっぽう"],[39,2,"がくしゃ"],[45,1,"おお"],[48,1,"くる"],[52,1,"う"],[55,1,"ころ"],[63,1,"か"],[64,1,"め"],[77,2,"でし"],[82,1,"しめ"]],"text":"この時から、イエス・キリストは、自分が必ずエルサレムに行き、長老、祭司長、律法学者たちから多くの苦しみを受け、殺され、そして三日目によみがえるべきことを、弟子たちに示しはじめられた。"},{"ref":"Matt.16.22","start":40016022,"end":40016022,"break":"none","ruby":[[15,1,"ひ"],[17,1,"よ"],[29,1,"しゅ"],[62,1,"い"]],"text":"すると、ペテロはイエスをわきへ引き寄せて、いさめはじめ、「主よ、とんでもないことです。そんなことがあるはずはございません」と言った。"},{"ref":"Matt.16.23","start":40016023,"end":40016023,"break":"none","ruby":[[4,1,"ふ"],[6,1,"む"],[14,1,"い"],[25,1,"ひ"],[35,2,"じゃま"],[40,1,"もの"],[47,1,"かみ"],[52,1,"おも"],[58,1,"ひと"],[63,1,"おも"]],"text":"イエスは振り向いて、ペテロに言われた、「サタンよ、引きさがれ。わたしの邪魔をする者だ。あなたは神のことを思わないで、人のことを思っている」。"},{"ref":"Matt.16.24","start":40016024,"end":40016024,"break":"none","ruby":[[8,2,"でし"],[13,1,"い"],[34,1,"おも"],[39,2,"じぶん"],[42,1,"す"],[45,2,"じぶん"],[48,3,"じゅうじか"],[52,1,"お"],[60,1,"したが"]],"text":"それからイエスは弟子たちに言われた、「だれでもわたしについてきたいと思うなら、自分を捨て、自分の十字架を負うて、わたしに従ってきなさい。"},{"ref":"Matt.16.25","start":40016025,"end":40016025,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"いのち"],[5,1,"すく"],[9,1,"おも"],[11,1,"もの"],[16,1,"うしな"],[26,2,"じぶん"],[29,1,"いのち"],[31,1,"うしな"],[33,1,"もの"],[39,1,"み"]],"text":"自分の命を救おうと思う者はそれを失い、わたしのために自分の命を失う者は、それを見いだすであろう。"},{"ref":"Matt.16.26","start":40016026,"end":40016026,"break":"none","ruby":[[3,1,"ひと"],[5,1,"ぜん"],[6,2,"せかい"],[15,2,"じぶん"],[18,1,"いのち"],[20,1,"そん"],[28,1,"とく"],[38,1,"ひと"],[43,2,"だいか"],[46,1,"はら"],[52,1,"いのち"],[54,1,"か"]],"text":"たとい人が全世界をもうけても、自分の命を損したら、なんの得になろうか。また、人はどんな代価を払って、その命を買いもどすことができようか。"},{"ref":"Matt.16.27","start":40016027,"end":40016027,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[4,1,"ちち"],[6,2,"えいこう"],[13,2,"みつかい"],[18,1,"したが"],[21,1,"く"],[27,1,"とき"],[31,2,"じっさい"],[39,1,"おう"],[48,1,"むく"]],"text":"人の子は父の栄光のうちに、御使たちを従えて来るが、その時には、実際のおこないに応じて、それぞれに報いるであろう。"},{"ref":"Matt.16.28","start":40016028,"end":40016028,"break":"none","ruby":[[2,1,"き"],[11,1,"ひと"],[13,1,"こ"],[15,2,"みくに"],[18,1,"ちから"],[23,1,"く"],[27,1,"み"],[33,1,"し"],[35,1,"あじ"],[40,1,"もの"],[46,1,"た"],[51,1,"もの"],[53,1,"なか"]],"text":"よく聞いておくがよい、人の子が御国の力をもって来るのを見るまでは、死を味わわない者が、ここに立っている者の中にいる」。"}]