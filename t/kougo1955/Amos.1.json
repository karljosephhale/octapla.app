[{"ref":"Amos.1.1","start":30001001,"end":30001001,"break":"paragraph","ruby":[[4,2,"ぼくしゃ"],[17,2,"ことば"],[26,1,"おう"],[31,1,"よ"],[39,1,"おう"],[44,1,"こ"],[51,1,"よ"],[53,2,"じしん"],[57,1,"ねん"],[58,1,"まえ"],[61,1,"かれ"],[72,1,"しめ"]],"text":"テコアの牧者のひとりであるアモスの言葉。これはユダの王ウジヤの世、イスラエルの王ヨアシの子ヤラベアムの世、地震の二年前に、彼がイスラエルについて示されたものである。"},{"ref":"Amos.1.2","start":30001002,"end":30001002,"break":"stanza","breaks":[[6,"line"],[17,"line"],[31,"line"],[40,"line"]],"ruby":[[0,1,"かれ"],[2,1,"い"],[7,1,"しゅ"],[24,1,"こえ"],[26,1,"だ"],[31,2,"ぼくしゃ"],[34,2,"まきば"],[37,1,"なげ"],[45,1,"いただき"],[47,1,"か"]],"text":"彼は言った、「主はシオンからほえ、エルサレムから声を出される。牧者の牧場は嘆き、カルメルの頂は枯れる」。"},{"ref":"Amos.1.3","start":30001003,"end":30001003,"break":"line","breaks":[[9,"line"],[21,"line"],[31,"line"],[47,"line"],[60,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[38,1,"ばっ"],[50,1,"かれ"],[53,1,"てつ"],[57,1,"いた"],[65,1,"ふ"]],"text":"主はこう言われる、「ダマスコの三つのとが、四つのとがのために、わたしはこれを罰してゆるさない。これは彼らが鉄のすり板で、ギレアデを踏みにじったからである。"},{"ref":"Amos.1.4","start":30001004,"end":30001004,"break":"line","breaks":[[16,"line"]],"ruby":[[9,1,"いえ"],[11,1,"ひ"],[13,1,"おく"],[27,2,"きゅうでん"],[30,1,"や"],[32,1,"ほろ"]],"text":"わたしはハザエルの家に火を送り、ベネハダデのもろもろの宮殿を焼き滅ぼす。"},{"ref":"Amos.1.5","start":30001005,"end":30001005,"break":"line","breaks":[[16,"line"],[29,"line"],[48,"line"],[66,"line"]],"ruby":[[9,1,"かん"],[11,1,"き"],[13,1,"くだ"],[20,1,"たに"],[23,2,"じゅうみん"],[26,1,"た"],[36,1,"おう"],[43,1,"もの"],[45,1,"た"],[52,1,"たみ"],[57,1,"とら"],[62,1,"い"],[66,1,"しゅ"],[68,1,"い"]],"text":"わたしはダマスコの貫の木を砕き、アベンの谷から住民を断ち、ベテエデンから王のつえをとる者を断つ。スリヤの民はキルに捕えられて行く」と主は言われる。"},{"ref":"Amos.1.6","start":30001006,"end":30001006,"break":"stanza","breaks":[[9,"line"],[19,"line"],[29,"line"],[45,"line"],[66,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[36,1,"ばっ"],[48,1,"かれ"],[51,2,"ひとびと"],[59,1,"とら"],[62,1,"い"],[70,1,"わた"]],"text":"主はこう言われる、「ガザの三つのとが、四つのとがのために、わたしはこれを罰してゆるさない。これは彼らが人々をことごとく捕えて行って、エドムに渡したからである。"},{"ref":"Amos.1.7","start":30001007,"end":30001007,"break":"line","breaks":[[16,"line"]],"ruby":[[7,1,"いし"],[11,1,"ひ"],[13,1,"おく"],[23,2,"きゅうでん"],[26,1,"や"],[28,1,"ほろ"]],"text":"わたしはガザの石がきに火を送り、そのもろもろの宮殿を焼き滅ぼす。"},{"ref":"Amos.1.8","start":30001008,"end":30001008,"break":"line","breaks":[[16,"line"],[35,"line"],[55,"line"],[73,"line"]],"ruby":[[10,2,"じゅうみん"],[13,1,"た"],[23,1,"おう"],[30,1,"もの"],[32,1,"た"],[41,1,"て"],[52,1,"う"],[58,1,"のこ"],[68,1,"ほろ"],[73,1,"しゅ"],[76,1,"かみ"],[78,1,"い"]],"text":"わたしはアシドドから住民を断ち、アシケロンから王のつえをとる者を断つ。わたしはまた手をかえしてエクロンを撃つ。そして残ったペリシテびとも滅びる」と主なる神は言われる。"},{"ref":"Amos.1.9","start":30001009,"end":30001009,"break":"stanza","breaks":[[9,"line"],[19,"line"],[29,"line"],[45,"line"],[66,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[36,1,"ばっ"],[48,1,"かれ"],[51,2,"ひとびと"],[63,1,"わた"],[68,2,"きょうだい"],[71,2,"けいやく"],[74,1,"こころ"],[76,1,"と"]],"text":"主はこう言われる、「ツロの三つのとが、四つのとがのために、わたしはこれを罰してゆるさない。これは彼らが人々をことごとくエドムに渡し、また兄弟の契約を心に留めなかったからである。"},{"ref":"Amos.1.10","start":30001010,"end":30001010,"break":"line","breaks":[[21,"line"]],"ruby":[[12,1,"いし"],[16,1,"ひ"],[18,1,"おく"],[28,2,"きゅうでん"],[31,1,"や"],[33,1,"ほろ"]],"text":"それゆえ、わたしはツロの石がきに火を送り、そのもろもろの宮殿を焼き滅ぼす」。"},{"ref":"Amos.1.11","start":30001011,"end":30001011,"break":"stanza","breaks":[[9,"line"],[20,"line"],[30,"line"],[46,"line"],[66,"line"],[78,"line"],[91,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[37,1,"ばっ"],[49,1,"かれ"],[60,2,"きょうだい"],[63,1,"お"],[66,1,"まった"],[73,1,"じょう"],[75,1,"た"],[78,1,"つね"],[80,1,"いか"],[84,1,"ひと"],[88,1,"さ"],[96,1,"いきどお"],[99,1,"たも"]],"text":"主はこう言われる、「エドムの三つのとが、四つのとがのために、わたしはこれを罰してゆるさない。これは彼がつるぎをもってその兄弟を追い、全くあわれみの情を断ち、常に怒って、人をかき裂き、ながくその憤りを保ったからである。"},{"ref":"Amos.1.12","start":30001012,"end":30001012,"break":"line","breaks":[[18,"line"]],"ruby":[[13,1,"ひ"],[15,1,"おく"],[27,2,"きゅうでん"],[30,1,"や"],[32,1,"ほろ"]],"text":"それゆえ、わたしはテマンに火を送り、ボズラのもろもろの宮殿を焼き滅ぼす」。"},{"ref":"Amos.1.13","start":30001013,"end":30001013,"break":"stanza","breaks":[[9,"line"],[24,"line"],[34,"line"],[50,"line"],[68,"line"],[81,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[15,2,"ひとびと"],[41,1,"ばっ"],[53,1,"かれ"],[58,2,"こっきょう"],[61,1,"ひろ"],[79,1,"おんな"],[83,1,"さ"]],"text":"主はこう言われる、「アンモンの人々の三つのとが、四つのとがのために、わたしはこれを罰してゆるさない。これは彼らがその国境を広げるために、ギレアデのはらんでいる女をひき裂いたからである。"},{"ref":"Amos.1.14","start":30001014,"end":30001014,"break":"line","breaks":[[22,"line"],[38,"line"],[59,"line"]],"ruby":[[12,1,"いし"],[16,1,"ひ"],[29,2,"きゅうでん"],[32,1,"や"],[34,1,"ほろ"],[41,1,"たたか"],[44,1,"ひ"],[50,1,"こえ"],[62,1,"かぜ"],[64,1,"ひ"],[67,2,"ぼうふう"]],"text":"それゆえ、わたしはラバの石がきに火をはなち、そのもろもろの宮殿を焼き滅ぼす。これは戦いの日に、ときの声をもってせられ、つむじ風の日に、暴風をもってせられる。"},{"ref":"Amos.1.15","start":30001015,"end":30001015,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おう"],[13,1,"とも"],[15,1,"とら"],[20,1,"い"],[24,1,"しゅ"],[26,1,"い"]],"text":"彼らの王はそのつかさたちと共に捕えられて行く」と主は言われる。"}]