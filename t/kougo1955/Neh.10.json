[{"ref":"Neh.10.1","start":16010001,"end":16010001,"break":"paragraph","ruby":[[0,1,"いん"],[2,1,"お"],[5,1,"もの"],[12,1,"こ"],[16,2,"そうとく"]],"text":"印を押した者はハカリヤの子である総督ネヘミヤ、およびゼデキヤ、"},{"ref":"Neh.10.2","start":16010002,"end":16010002,"break":"none","text":"セラヤ、アザリヤ、エレミヤ、"},{"ref":"Neh.10.3","start":16010003,"end":16010003,"break":"none","text":"パシュル、アマリヤ、マルキヤ、"},{"ref":"Neh.10.4","start":16010004,"end":16010004,"break":"none","text":"ハットシ、シバニヤ、マルク、"},{"ref":"Neh.10.5","start":16010005,"end":16010005,"break":"none","text":"ハリム、メレモテ、オバデヤ、"},{"ref":"Neh.10.6","start":16010006,"end":16010006,"break":"none","text":"ダニエル、ギンネトン、バルク、"},{"ref":"Neh.10.7","start":16010007,"end":16010007,"break":"none","text":"メシュラム、アビヤ、ミヤミン、"},{"ref":"Neh.10.8","start":16010008,"end":16010008,"break":"none","ruby":[[19,2,"さいし"]],"text":"マアジヤ、ビルガイ、シマヤで、これらは祭司である。"},{"ref":"Neh.10.9","start":16010009,"end":16010009,"break":"paragraph","ruby":[[11,1,"こ"],[22,1,"こ"]],"text":"レビびとではアザニヤの子エシュア、ヘナダデの子らのうちのビンヌイ、カデミエル、"},{"ref":"Neh.10.10","start":16010010,"end":16010010,"break":"none","ruby":[[5,2,"きょうだい"]],"text":"およびその兄弟シバニヤ、ホデヤ、ケリタ、ペラヤ、ハナン、"},{"ref":"Neh.10.11","start":16010011,"end":16010011,"break":"none","text":"ミカ、レホブ、ハシャビヤ、"},{"ref":"Neh.10.12","start":16010012,"end":16010012,"break":"none","text":"ザックル、セレビヤ、シバニヤ、"},{"ref":"Neh.10.13","start":16010013,"end":16010013,"break":"none","text":"ホデヤ、バニ、ベニヌである。"},{"ref":"Neh.10.14","start":16010014,"end":16010014,"break":"none","ruby":[[0,1,"たみ"]],"text":"民のかしらではパロシ、パハテ・モアブ、エラム、ザット、バニ、"},{"ref":"Neh.10.15","start":16010015,"end":16010015,"break":"none","text":"ブンニ、アズガデ、ベバイ、"},{"ref":"Neh.10.16","start":16010016,"end":16010016,"break":"none","text":"アドニヤ、ビグワイ、アデン、"},{"ref":"Neh.10.17","start":16010017,"end":16010017,"break":"none","text":"アテル、ヒゼキヤ、アズル、"},{"ref":"Neh.10.18","start":16010018,"end":16010018,"break":"none","text":"ホデヤ、ハシュム、ベザイ、"},{"ref":"Neh.10.19","start":16010019,"end":16010019,"break":"none","text":"ハリフ、アナトテ、ノバイ、"},{"ref":"Neh.10.20","start":16010020,"end":16010020,"break":"none","text":"マグピアシ、メシュラム、ヘジル、"},{"ref":"Neh.10.21","start":16010021,"end":16010021,"break":"none","text":"メシザベル、ザドク、ヤドア、"},{"ref":"Neh.10.22","start":16010022,"end":16010022,"break":"none","text":"ペラテヤ、ハナン、アナニヤ、"},{"ref":"Neh.10.23","start":16010023,"end":16010023,"break":"none","text":"ホセア、ハナニヤ、ハシュブ、"},{"ref":"Neh.10.24","start":16010024,"end":16010024,"break":"none","text":"ハロヘシ、ピルハ、ショベク、"},{"ref":"Neh.10.25","start":16010025,"end":16010025,"break":"none","text":"レホム、ハシャブナ、マアセヤ、"},{"ref":"Neh.10.26","start":16010026,"end":16010026,"break":"none","text":"アヒヤ、ハナン、アナン、"},{"ref":"Neh.10.27","start":16010027,"end":16010027,"break":"none","text":"マルク、ハリム、バアナである。"},{"ref":"Neh.10.28","start":16010028,"end":16010028,"break":"paragraph","ruby":[[2,1,"た"],[4,1,"たみ"],[6,2,"さいし"],[14,1,"もん"],[16,1,"まも"],[18,1,"もの"],[20,1,"うた"],[24,1,"もの"],[26,1,"みや"],[28,1,"つか"],[42,2,"くにぐに"],[45,1,"たみ"],[47,1,"はな"],[50,1,"かみ"],[52,2,"りっぽう"],[55,1,"したが"],[58,1,"もの"],[64,1,"つま"],[70,1,"むすめ"],[76,2,"ちしき"],[79,1,"さと"],[84,1,"もの"]],"text":"その他の民、祭司、レビびと、門を守る者、歌うたう者、宮に仕えるしもべ、ならびにすべて国々の民と離れて神の律法に従った者およびその妻、むすこ、娘などすべて知識と悟りのある者は、"},{"ref":"Neh.10.29","start":16010029,"end":16010029,"break":"none","ruby":[[2,2,"きょうだい"],[7,1,"たっと"],[9,2,"ひとびと"],[14,1,"したが"],[17,1,"かみ"],[29,1,"さづ"],[34,1,"かみ"],[36,2,"りっぽう"],[39,1,"あゆ"],[47,1,"しゅ"],[49,1,"しゅ"],[55,1,"いまし"],[64,1,"さだ"],[68,1,"まも"],[70,1,"おこな"],[80,1,"ちか"],[84,1,"くわ"]],"text":"その兄弟である尊い人々につき従い、神のしもべモーセによって授けられた神の律法に歩み、われわれの主、主のすべての戒めと、おきてと、定めとを守り行うために、のろいと誓いとに加わった。"},{"ref":"Neh.10.30","start":16010030,"end":16010030,"break":"none","ruby":[[7,1,"ち"],[9,1,"たみ"],[17,1,"むすめ"],[19,1,"あた"],[32,1,"かれ"],[35,1,"むすめ"]],"text":"われわれはこの地の民らにわれわれの娘を与えず、われわれのむすこに彼らの娘をめとらない。"},{"ref":"Neh.10.31","start":16010031,"end":16010031,"break":"none","ruby":[[4,1,"ち"],[6,1,"たみ"],[12,2,"しなもの"],[17,2,"こくもつ"],[20,3,"あんそくにち"],[24,1,"たずさ"],[27,1,"き"],[29,1,"う"],[42,3,"あんそくにち"],[48,2,"せいじつ"],[55,1,"か"],[63,1,"ねん"],[67,2,"こうさく"],[77,2,"ふさい"]],"text":"またこの地の民らがたとい品物または穀物を安息日に携えて来て売ろうとしても、われわれは安息日または聖日にはそれを買わない。また七年ごとに耕作をやめ、すべての負債をゆるす。"},{"ref":"Neh.10.32","start":16010032,"end":16010032,"break":"paragraph","ruby":[[11,2,"きてい"],[14,1,"もう"],[23,1,"かみ"],[25,1,"みや"],[27,1,"よう"],[32,2,"ねんねん"],[39,1,"ぶん"],[43,1,"だ"]],"text":"われわれはまたみずから規定を設けて、われわれの神の宮の用のために年々シケルの三分の一を出し、"},{"ref":"Neh.10.33","start":16010033,"end":16010033,"break":"none","ruby":[[0,1,"そな"],[6,3,"じょうそさい"],[10,3,"じょうはんさい"],[17,3,"あんそくにち"],[21,2,"しんげつ"],[26,1,"さだ"],[29,1,"まつり"],[31,1,"そな"],[33,1,"もの"],[38,1,"せい"],[41,1,"もの"],[59,2,"ざいさい"],[70,1,"かみ"],[72,1,"みや"],[85,1,"もち"]],"text":"供えのパン、常素祭、常燔祭のため、安息日、新月および定めの祭の供え物のため、聖なる物のため、イスラエルのあがないをなす罪祭、およびわれわれの神の宮のもろもろのわざのために用いることにした。"},{"ref":"Neh.10.34","start":16010034,"end":16010034,"break":"none","ruby":[[6,2,"さいし"],[16,1,"たみ"],[21,1,"ひ"],[25,2,"りっぽう"],[43,1,"かみ"],[45,1,"しゅ"],[47,2,"さいだん"],[50,1,"うえ"],[60,1,"そな"],[62,1,"もの"],[65,2,"ねんねん"],[67,1,"さだ"],[72,1,"とき"],[74,2,"しぞく"],[88,1,"かみ"],[90,1,"みや"],[92,1,"おさ"],[95,1,"もの"],[97,1,"さだ"]],"text":"またわれわれ祭司、レビびとおよび民はくじを引いて、律法にしるされてあるようにわれわれの神、主の祭壇の上にたくべきたきぎの供え物を、年々定められた時に氏族にしたがって、われわれの神の宮に納める者を定めた。"},{"ref":"Neh.10.35","start":16010035,"end":16010035,"break":"none","ruby":[[7,2,"とち"],[10,1,"はつ"],[17,2,"かくしゅ"],[20,1,"き"],[22,1,"み"],[24,1,"はつ"],[29,2,"ねんねん"],[31,1,"しゅ"],[33,1,"みや"],[35,1,"たずさ"],[43,1,"ちか"]],"text":"またわれわれの土地の初なり、および各種の木の実の初なりを、年々主の宮に携えてくることを誓い、"},{"ref":"Neh.10.36","start":16010036,"end":16010036,"break":"none","ruby":[[2,2,"りっぽう"],[20,1,"こ"],[26,2,"かちく"],[41,1,"うし"],[43,1,"ひつじ"],[55,1,"かみ"],[57,1,"みや"],[59,1,"たずさ"],[70,1,"かみ"],[72,1,"みや"],[74,1,"つか"],[77,2,"さいし"],[80,1,"わた"]],"text":"また律法にしるしてあるように、われわれの子どもおよび家畜のういご、およびわれわれの牛や羊のういごを、われわれの神の宮に携えてきて、われわれの神の宮に仕える祭司に渡し、"},{"ref":"Neh.10.37","start":16010037,"end":16010037,"break":"none","ruby":[[5,2,"むぎこ"],[8,2,"はつもの"],[16,1,"そな"],[18,1,"もの"],[20,2,"かくしゅ"],[23,1,"き"],[25,1,"み"],[30,1,"しゅ"],[34,1,"あぶら"],[36,2,"さいし"],[42,1,"たずさ"],[45,1,"い"],[54,1,"かみ"],[56,1,"みや"],[61,1,"おさ"],[71,2,"とち"],[74,2,"さんぶつ"],[78,1,"ぶん"],[87,1,"あた"],[110,2,"のうさく"],[115,1,"まち"],[124,1,"ぶん"],[128,1,"う"],[132,1,"もの"]],"text":"われわれの麦粉の初物、われわれの供え物、各種の木の実、ぶどう酒および油を祭司のもとに携えて行って、われわれの神の宮のへやに納め、またわれわれの土地の産物の十分の一をレビびとに与えることにした。レビびとはわれわれのすべての農作をなす町において、その十分の一を受くべき者だからである。"},{"ref":"Neh.10.38","start":16010038,"end":16010038,"break":"none","ruby":[[6,1,"ぶん"],[10,1,"う"],[13,1,"とき"],[21,2,"しそん"],[26,2,"さいし"],[37,1,"とも"],[62,1,"ぶん"],[67,1,"ぶん"],[77,1,"かみ"],[79,1,"みや"],[81,1,"たずさ"],[83,1,"のぼ"],[92,1,"くら"],[94,1,"おさ"]],"text":"レビびとが十分の一を受ける時には、アロンの子孫である祭司が、そのレビびとと共にいなければならない。そしてまたレビびとはその十分の一の十分の一を、われわれの神の宮に携え上って、へやまたは倉に納めなければならない。"},{"ref":"Neh.10.39","start":16010039,"end":16010039,"break":"none","ruby":[[10,2,"ひとびと"],[18,2,"しそん"],[21,2,"こくもつ"],[27,1,"しゅ"],[32,1,"あぶら"],[34,1,"そな"],[36,1,"もの"],[38,1,"たずさ"],[41,1,"い"],[45,2,"せいじょ"],[48,2,"うつわもの"],[53,1,"つと"],[58,2,"さいし"],[61,2,"もんえい"],[64,1,"うた"],[68,1,"もの"],[80,1,"おさ"],[106,1,"かみ"],[108,1,"みや"]],"text":"すなわちイスラエルの人々およびレビの子孫は穀物、ぶどう酒、および油の供え物を携えて行って、聖所の器物および勤めをする祭司、門衛、歌うたう者たちのいるへやにこれを納めなければならない。こうしてわれわれは、われわれの神の宮をなおざりにしない。"}]