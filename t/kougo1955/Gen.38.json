[{"ref":"Gen.38.1","start":1038001,"end":1038001,"break":"paragraph","ruby":[[7,2,"きょうだい"],[12,1,"はな"],[15,1,"くだ"],[26,1,"な"],[33,1,"もの"],[35,1,"ところ"],[37,1,"い"]],"text":"そのころユダは兄弟たちを離れて下り、アドラムびとで、名をヒラという者の所へ行った。"},{"ref":"Gen.38.2","start":1038002,"end":1038002,"break":"none","ruby":[[5,1,"ところ"],[8,1,"な"],[22,1,"むすめ"],[24,1,"み"],[36,1,"ところ"]],"text":"ユダはその所で、名をシュアというカナンびとの娘を見て、これをめとり、その所にはいった。"},{"ref":"Gen.38.3","start":1038003,"end":1038003,"break":"none","ruby":[[0,2,"かのじょ"],[8,1,"おとこ"],[10,1,"こ"],[12,1,"う"],[21,1,"な"],[26,1,"な"]],"text":"彼女はみごもって男の子を産んだので、ユダは名をエルと名づけた。"},{"ref":"Gen.38.4","start":1038004,"end":1038004,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"ふたた"],[10,1,"おとこ"],[12,1,"こ"],[14,1,"う"],[17,1,"な"],[23,1,"な"]],"text":"彼女は再びみごもって男の子を産み、名をオナンと名づけた。"},{"ref":"Gen.38.5","start":1038005,"end":1038005,"break":"none","ruby":[[2,1,"かさ"],[6,1,"おとこ"],[8,1,"こ"],[10,1,"う"],[13,1,"な"],[18,1,"な"],[23,2,"かのじょ"],[28,1,"おとこ"],[30,1,"こ"],[32,1,"う"]],"text":"また重ねて、男の子を産み、名をシラと名づけた。彼女はこの男の子を産んだとき、クジブにおった。"},{"ref":"Gen.38.6","start":1038006,"end":1038006,"break":"none","ruby":[[3,2,"ちょうし"],[12,1,"な"],[20,1,"つま"],[22,1,"むか"]],"text":"ユダは長子エルのために、名をタマルという妻を迎えた。"},{"ref":"Gen.38.7","start":1038007,"end":1038007,"break":"none","ruby":[[6,2,"ちょうし"],[11,1,"しゅ"],[13,1,"まえ"],[15,1,"わる"],[17,1,"もの"],[25,1,"しゅ"],[27,1,"かれ"],[29,1,"ころ"]],"text":"しかしユダの長子エルは主の前に悪い者であったので、主は彼を殺された。"},{"ref":"Gen.38.8","start":1038008,"end":1038008,"break":"none","ruby":[[10,1,"い"],[15,1,"あに"],[17,1,"つま"],[19,1,"ところ"],[26,2,"かのじょ"],[33,1,"あに"],[35,2,"こども"],[38,1,"え"]],"text":"そこでユダはオナンに言った、「兄の妻の所にはいって、彼女をめとり、兄に子供を得させなさい」。"},{"ref":"Gen.38.9","start":1038009,"end":1038009,"break":"none","ruby":[[9,1,"こ"],[11,2,"じぶん"],[23,1,"し"],[31,1,"あに"],[33,1,"つま"],[35,1,"ところ"],[41,1,"とき"],[43,1,"あに"],[45,1,"こ"],[47,1,"え"],[55,1,"ち"],[57,1,"も"]],"text":"しかしオナンはその子が自分のものとならないのを知っていたので、兄の妻の所にはいった時、兄に子を得させないために地に洩らした。"},{"ref":"Gen.38.10","start":1038010,"end":1038010,"break":"none","ruby":[[0,1,"かれ"],[4,1,"こと"],[6,1,"しゅ"],[8,1,"まえ"],[10,1,"わる"],[17,1,"しゅ"],[19,1,"かれ"],[22,1,"ころ"]],"text":"彼のした事は主の前に悪かったので、主は彼をも殺された。"},{"ref":"Gen.38.11","start":1038011,"end":1038011,"break":"none","ruby":[[8,1,"こ"],[10,1,"つま"],[15,1,"い"],[24,1,"こ"],[28,2,"せいじん"],[35,2,"かふ"],[46,1,"ちち"],[48,1,"いえ"],[56,1,"かれ"],[64,2,"きょうだい"],[72,1,"し"],[82,1,"おも"],[98,1,"い"],[101,1,"ちち"],[103,1,"いえ"]],"text":"そこでユダはその子の妻タマルに言った、「わたしの子シラが成人するまで、寡婦のままで、あなたの父の家にいなさい」。彼は、シラもまた兄弟たちのように死ぬかもしれないと、思ったからである。それでタマルは行って父の家におった。"},{"ref":"Gen.38.12","start":1038012,"end":1038012,"break":"paragraph","ruby":[[0,1,"ひ"],[9,1,"むすめ"],[13,1,"つま"],[15,1,"し"],[21,1,"のち"],[26,1,"も"],[28,1,"おわ"],[33,1,"とも"],[43,1,"とも"],[49,1,"のぼ"],[52,2,"じぶん"],[55,1,"ひつじ"],[57,1,"け"],[59,1,"き"],[61,1,"もの"],[67,1,"い"]],"text":"日がたってシュアの娘ユダの妻は死んだ。その後、ユダは喪を終ってその友アドラムびとヒラと共にテムナに上り、自分の羊の毛を切る者のところへ行った。"},{"ref":"Gen.38.13","start":1038013,"end":1038013,"break":"none","ruby":[[0,1,"とき"],[7,1,"ひと"],[13,1,"つ"],[27,1,"ひつじ"],[29,1,"け"],[31,1,"き"],[40,1,"のぼ"],[43,1,"く"],[47,1,"い"]],"text":"時に、ひとりの人がタマルに告げて、「あなたのしゅうとが羊の毛を切るためにテムナに上って来る」と言ったので、"},{"ref":"Gen.38.14","start":1038014,"end":1038014,"break":"none","ruby":[[0,2,"かのじょ"],[3,2,"かふ"],[6,2,"いふく"],[9,1,"ぬ"],[14,2,"かずき"],[17,1,"み"],[22,1,"かく"],[30,1,"い"],[32,1,"みち"],[46,2,"いりぐち"],[56,2,"かのじょ"],[62,2,"せいじん"],[69,2,"じぶん"],[74,1,"つま"],[82,1,"し"]],"text":"彼女は寡婦の衣服を脱ぎすて、被衣で身をおおい隠して、テムナへ行く道のかたわらにあるエナイムの入口にすわっていた。彼女はシラが成人したのに、自分がその妻にされないのを知ったからである。"},{"ref":"Gen.38.15","start":1038015,"end":1038015,"break":"none","ruby":[[3,2,"かのじょ"],[6,1,"み"],[11,2,"かのじょ"],[14,1,"かお"],[25,2,"ゆうじょ"],[29,1,"おも"]],"text":"ユダは彼女を見たとき、彼女が顔をおおっていたため、遊女だと思い、"},{"ref":"Gen.38.16","start":1038016,"end":1038016,"break":"none","ruby":[[0,1,"みち"],[7,2,"かのじょ"],[10,1,"む"],[14,1,"い"],[26,1,"ところ"],[38,1,"かれ"],[42,1,"おんな"],[46,1,"こ"],[48,1,"つま"],[55,1,"し"],[67,2,"かのじょ"],[70,1,"い"],[79,1,"ところ"],[87,1,"なに"]],"text":"道のかたわらで彼女に向かって言った、「さあ、あなたの所にはいらせておくれ」。彼はこの女がわが子の妻であることを知らなかったからである。彼女は言った、「わたしの所にはいるため、何をくださいますか」。"},{"ref":"Gen.38.17","start":1038017,"end":1038017,"break":"none","ruby":[[3,1,"い"],[8,1,"む"],[17,1,"こ"],[29,2,"かのじょ"],[32,1,"い"]],"text":"ユダは言った、「群れのうちのやぎの子をあなたにあげよう」。彼女は言った、「それをくださるまで、しるしをわたしにくださいますか」。"},{"ref":"Gen.38.18","start":1038018,"end":1038018,"break":"none","ruby":[[3,1,"い"],[22,2,"かのじょ"],[25,1,"い"],[34,1,"いん"],[36,1,"ひも"],[43,1,"て"],[53,1,"かれ"],[59,1,"あた"],[62,2,"かのじょ"],[65,1,"ところ"],[72,2,"かのじょ"]],"text":"ユダは言った、「どんなしるしをあげようか」。彼女は言った、「あなたの印と紐と、あなたの手にあるつえとを」。彼はこれらを与えて彼女の所にはいった。彼女はユダによってみごもった。"},{"ref":"Gen.38.19","start":1038019,"end":1038019,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"お"],[6,1,"さ"],[9,2,"かずき"],[12,1,"ぬ"],[15,2,"かふ"],[18,2,"いふく"],[21,1,"き"]],"text":"彼女は起きて去り、被衣を脱いで寡婦の衣服を着た。"},{"ref":"Gen.38.20","start":1038020,"end":1038020,"break":"paragraph","ruby":[[8,1,"おんな"],[15,1,"と"],[25,1,"とも"],[33,1,"たく"],[39,1,"こ"],[41,1,"おく"],[51,1,"おんな"],[53,1,"み"]],"text":"やがてユダはその女からしるしを取りもどそうと、その友アドラムびとに託してやぎの子を送ったけれども、その女を見いだせなかった。"},{"ref":"Gen.38.21","start":1038021,"end":1038021,"break":"none","ruby":[[3,1,"かれ"],[7,1,"ところ"],[9,2,"ひとびと"],[12,1,"たず"],[15,1,"い"],[25,1,"みち"],[34,2,"ゆうじょ"],[46,1,"かれ"],[49,1,"い"],[58,2,"ゆうじょ"]],"text":"そこで彼はその所の人々に尋ねて言った、「エナイムで道のかたわらにいた遊女はどこにいますか」。彼らは言った、「ここには遊女はいません」。"},{"ref":"Gen.38.22","start":1038022,"end":1038022,"break":"none","ruby":[[0,1,"かれ"],[8,1,"かえ"],[11,1,"い"],[20,2,"かのじょ"],[23,1,"み"],[38,1,"ところ"],[40,2,"ひとびと"],[49,2,"ゆうじょ"],[57,1,"い"]],"text":"彼はユダのもとに帰って言った、「わたしは彼女を見いだせませんでした。またその所の人々は、『ここには遊女はいない』と言いました」。"},{"ref":"Gen.38.23","start":1038023,"end":1038023,"break":"none","ruby":[[6,1,"い"],[11,1,"おんな"],[13,1,"も"],[27,1,"はじ"],[53,1,"こ"],[55,1,"おく"],[64,2,"かのじょ"],[67,1,"み"]],"text":"そこでユダは言った、「女に持たせておこう。わたしたちは恥をかくといけないから。とにかく、わたしはこのやぎの子を送ったが、あなたは彼女を見いだせなかったのだ」。"},{"ref":"Gen.38.24","start":1038024,"end":1038024,"break":"paragraph","ruby":[[5,1,"がつ"],[16,1,"ひと"],[21,1,"い"],[30,1,"よめ"],[35,2,"かんいん"],[47,2,"かのじょ"],[50,2,"かんいん"],[68,1,"い"],[73,2,"かのじょ"],[76,1,"ひ"],[78,1,"だ"],[81,1,"や"]],"text":"ところが三月ほどたって、ひとりの人がユダに言った、「あなたの嫁タマルは姦淫しました。そのうえ、彼女は姦淫によってみごもりました」。ユダは言った、「彼女を引き出して焼いてしまえ」。"},{"ref":"Gen.38.25","start":1038025,"end":1038025,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"ひ"],[5,1,"だ"],[9,1,"とき"],[18,1,"ひと"],[25,1,"い"],[42,1,"ひと"],[57,2,"かのじょ"],[62,1,"い"],[73,1,"いん"],[76,1,"ひも"],[90,2,"みさだ"]],"text":"彼女は引き出された時、そのしゅうとに人をつかわして言った、「わたしはこれをもっている人によって、みごもりました」。彼女はまた言った、「どうか、この印と、紐と、つえとはだれのものか、見定めてください」。"},{"ref":"Gen.38.26","start":1038026,"end":1038026,"break":"none","ruby":[[6,2,"みさだ"],[10,1,"い"],[15,2,"かのじょ"],[24,1,"ただ"],[32,2,"かのじょ"],[37,1,"こ"],[41,1,"あた"],[54,1,"かれ"],[56,1,"ふたた"],[58,2,"かのじょ"],[61,1,"し"]],"text":"ユダはこれを見定めて言った、「彼女はわたしよりも正しい。わたしが彼女をわが子シラに与えなかったためである」。彼は再び彼女を知らなかった。"},{"ref":"Gen.38.27","start":1038027,"end":1038027,"break":"paragraph","ruby":[[2,2,"かのじょ"],[5,2,"しゅっさん"],[8,1,"とき"],[14,2,"たいない"]],"text":"さて彼女の出産の時がきたが、胎内には、ふたごがあった。"},{"ref":"Gen.38.28","start":1038028,"end":1038028,"break":"none","ruby":[[0,2,"しゅっさん"],[3,1,"とき"],[10,1,"こ"],[12,1,"て"],[14,1,"だ"],[20,2,"さんば"],[31,1,"で"],[35,1,"い"],[38,1,"ひ"],[40,1,"いと"],[42,1,"と"],[48,1,"て"],[50,1,"むす"]],"text":"出産の時に、ひとりの子が手を出したので、産婆は、「これがさきに出た」と言い、緋の糸を取って、その手に結んだ。"},{"ref":"Gen.38.29","start":1038029,"end":1038029,"break":"none","ruby":[[6,1,"こ"],[8,1,"て"],[19,1,"おとうと"],[21,1,"で"],[35,2,"じぶん"],[38,1,"やぶ"],[41,1,"で"],[47,1,"い"],[57,1,"な"],[63,1,"よ"]],"text":"そして、その子が手をひっこめると、その弟が出たので、「どうしてあなたは自分で破って出るのか」と言った。これによって名はペレヅと呼ばれた。"},{"ref":"Gen.38.30","start":1038030,"end":1038030,"break":"none","ruby":[[2,1,"のち"],[4,1,"て"],[6,1,"ひ"],[8,1,"いと"],[12,1,"あに"],[14,1,"で"],[19,1,"な"],[24,1,"よ"]],"text":"その後、手に緋の糸のある兄が出たので、名はゼラと呼ばれた。"}]