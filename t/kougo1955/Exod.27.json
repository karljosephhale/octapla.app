[{"ref":"Exod.27.1","start":2027001,"end":2027001,"break":"paragraph","ruby":[[10,1,"ざい"],[12,2,"さいだん"],[15,1,"つく"],[26,1,"なが"],[34,1,"はば"],[42,1,"かく"],[45,1,"たか"]],"text":"あなたはまたアカシヤ材で祭壇を造らなければならない。長さ五キュビト、幅五キュビトの四角で、高さは三キュビトである。"},{"ref":"Exod.27.2","start":2027002,"end":2027002,"break":"none","ruby":[[6,1,"うえ"],[10,2,"いちぶ"],[18,1,"つの"],[20,1,"つく"],[23,2,"せいどう"],[26,2,"さいだん"]],"text":"その四すみの上にその一部としてそれの角を造り、青銅で祭壇をおおわなければならない。"},{"ref":"Exod.27.3","start":2027003,"end":2027003,"break":"none","ruby":[[2,1,"はい"],[4,1,"と"],[9,2,"じゅうのう"],[12,1,"はち"],[14,1,"にく"],[15,1,"また"],[17,2,"ひざら"],[20,1,"つく"],[25,1,"うつわ"],[29,2,"せいどう"],[32,1,"つく"]],"text":"また灰を取るつぼ、十能、鉢、肉叉、火皿を造り、その器はみな青銅で造らなければならない。"},{"ref":"Exod.27.4","start":2027004,"end":2027004,"break":"none","ruby":[[2,2,"さいだん"],[8,2,"せいどう"],[11,1,"あみ"],[12,2,"ざいく"],[15,2,"こうし"],[18,1,"つく"],[28,1,"あみ"],[30,1,"うえ"],[32,2,"せいどう"],[35,1,"かん"],[39,1,"と"],[41,1,"つ"]],"text":"また祭壇のために青銅の網細工の格子を造り、その四すみで、網の上に青銅の環を四つ取り付けなければならない。"},{"ref":"Exod.27.5","start":2027005,"end":2027005,"break":"none","ruby":[[2,1,"あみ"],[4,2,"さいだん"],[7,2,"でば"],[11,1,"した"],[13,1,"と"],[15,1,"つ"],[21,2,"さいだん"],[24,1,"たか"],[27,1,"なか"],[30,1,"たっ"]],"text":"その網を祭壇の出張りの下に取り付け、これを祭壇の高さの半ばに達するようにしなければならない。"},{"ref":"Exod.27.6","start":2027006,"end":2027006,"break":"none","ruby":[[2,2,"さいだん"],[12,1,"つく"],[31,1,"ざい"],[37,1,"つく"],[40,2,"せいどう"]],"text":"また祭壇のために、さおを造らなければならない。すなわちアカシヤ材で、さおを造り、青銅で、これをおおわなければならない。"},{"ref":"Exod.27.7","start":2027007,"end":2027007,"break":"none","ruby":[[5,1,"かん"],[7,1,"とお"],[13,2,"さいだん"],[16,2,"りょうがわ"]],"text":"そのさおを環に通し、さおを祭壇の両側にして、これをかつがなければならない。"},{"ref":"Exod.27.8","start":2027008,"end":2027008,"break":"none","ruby":[[0,2,"さいだん"],[3,1,"いた"],[5,2,"くうどう"],[8,1,"つく"],[11,1,"やま"],[13,1,"しめ"],[24,1,"つく"]],"text":"祭壇は板で空洞に造り、山で示されたように、これを造らなければならない。"},{"ref":"Exod.27.9","start":2027009,"end":2027009,"break":"paragraph","ruby":[[6,2,"まくや"],[9,1,"にわ"],[11,1,"つく"],[14,2,"りょうがわ"],[18,1,"にわ"],[23,1,"なが"],[31,2,"あま"],[34,2,"ねんし"],[42,1,"もう"],[47,2,"いっぽう"],[50,1,"あ"]],"text":"あなたはまた幕屋の庭を造り、両側では庭のために長さ百キュビトの亜麻の撚糸のあげばりを設け、その一方に当てなければならない。"},{"ref":"Exod.27.10","start":2027010,"end":2027010,"break":"none","ruby":[[2,1,"はしら"],[9,1,"はしら"],[14,1,"ざ"],[16,2,"せいどう"],[23,1,"はしら"],[25,1,"こま"],[27,1,"けた"],[30,1,"ぎん"]],"text":"その柱は二十、その柱の二十の座は青銅にし、その柱の鉤と桁とは銀にしなければならない。"},{"ref":"Exod.27.11","start":2027011,"end":2027011,"break":"none","ruby":[[2,1,"おな"],[5,2,"きたがわ"],[12,1,"なが"],[25,1,"もう"],[38,1,"はしら"],[45,1,"はしら"],[50,1,"ざ"],[52,2,"せいどう"],[59,1,"はしら"],[61,1,"こま"],[63,1,"けた"],[66,1,"ぎん"]],"text":"また同じく北側のために、長さ百キュビトのあげばりを設けなければならない。その柱は二十、その柱の二十の座は青銅にし、その柱の鉤と桁とは銀にしなければならない。"},{"ref":"Exod.27.12","start":2027012,"end":2027012,"break":"none","ruby":[[2,1,"にわ"],[4,2,"にしがわ"],[7,1,"はば"],[24,1,"もう"],[37,1,"はしら"],[43,1,"ざ"]],"text":"また庭の西側の幅のために五十キュビトのあげばりを設けなければならない。その柱は十、その座も十。"},{"ref":"Exod.27.13","start":2027013,"end":2027013,"break":"none","ruby":[[2,2,"ひがしがわ"],[6,1,"にわ"],[8,1,"はば"]],"text":"また東側でも庭の幅を五十キュビトにしなければならない。"},{"ref":"Exod.27.14","start":2027014,"end":2027014,"break":"none","ruby":[[5,2,"いっぽう"],[20,1,"もう"],[33,1,"はしら"],[40,1,"ざ"]],"text":"そしてその一方に十五キュビトのあげばりを設けなければならない。その柱は三つ、その座も三つ。"},{"ref":"Exod.27.15","start":2027015,"end":2027015,"break":"none","ruby":[[2,1,"た"],[4,2,"いっぽう"],[20,1,"もう"],[33,1,"はしら"],[40,1,"ざ"]],"text":"また他の一方にも十五キュビトのあげばりを設けなければならない。その柱は三つ、その座も三つ。"},{"ref":"Exod.27.16","start":2027016,"end":2027016,"break":"none","ruby":[[0,1,"にわ"],[2,1,"もん"],[7,1,"あお"],[8,1,"いと"],[10,1,"むらさき"],[11,1,"いと"],[13,1,"ひ"],[14,1,"いと"],[16,2,"あま"],[19,2,"ねんし"],[23,1,"いろ"],[29,1,"お"],[32,1,"なが"],[45,1,"もう"],[58,1,"はしら"],[65,1,"ざ"]],"text":"庭の門のために青糸、紫糸、緋糸、亜麻の撚糸で、色とりどりに織った長さ二十キュビトのとばりを設けなければならない。その柱は四つ、その座も四つ。"},{"ref":"Exod.27.17","start":2027017,"end":2027017,"break":"none","ruby":[[0,1,"にわ"],[2,2,"しゅうい"],[5,1,"はしら"],[9,1,"ぎん"],[11,1,"けた"],[19,1,"こま"],[21,1,"ぎん"],[25,1,"ざ"],[27,2,"せいどう"]],"text":"庭の周囲の柱はみな銀の桁でつなぎ、その鉤は銀、その座は青銅にしなければならない。"},{"ref":"Exod.27.18","start":2027018,"end":2027018,"break":"none","ruby":[[0,1,"にわ"],[2,1,"なが"],[13,1,"はば"],[24,1,"たか"],[34,2,"あま"],[37,2,"ねんし"],[40,1,"ぬの"],[42,1,"か"],[51,1,"ざ"],[53,2,"せいどう"]],"text":"庭の長さは百キュビト、その幅は五十キュビト、その高さは五キュビトで、亜麻の撚糸の布を掛けめぐらし、その座を青銅にしなければならない。"},{"ref":"Exod.27.19","start":2027019,"end":2027019,"break":"none","ruby":[[3,2,"まくや"],[6,1,"もち"],[14,1,"うつわ"],[25,1,"くぎ"],[29,1,"にわ"],[35,1,"くぎ"],[37,2,"せいどう"],[40,1,"つく"]],"text":"すべて幕屋に用いるもろもろの器、およびそのすべての釘、また庭のすべての釘は青銅で造らなければならない。"},{"ref":"Exod.27.20","start":2027020,"end":2027020,"break":"paragraph","ruby":[[12,2,"ひとびと"],[15,1,"めい"],[27,1,"と"],[30,2,"じゅんすい"],[33,1,"あぶら"],[39,1,"ひ"],[44,1,"も"],[51,1,"た"],[57,1,"ひ"]],"text":"あなたはまたイスラエルの人々に命じて、オリブをつぶして採った純粋の油を、ともし火のために持ってこさせ、絶えずともし火をともさなければならない。"},{"ref":"Exod.27.21","start":2027021,"end":2027021,"break":"none","ruby":[[6,1,"こ"],[12,2,"かいけん"],[15,2,"まくや"],[18,1,"なか"],[24,1,"はこ"],[26,1,"まえ"],[30,2,"たれまく"],[33,1,"そと"],[36,1,"ゆう"],[39,1,"あさ"],[42,1,"しゅ"],[44,1,"まえ"],[52,1,"ひ"],[54,1,"ととの"],[74,2,"ひとびと"],[77,1,"まも"],[81,2,"よよ"],[83,1,"かわ"],[87,1,"さだ"]],"text":"アロンとその子たちとは、会見の幕屋の中のあかしの箱の前にある垂幕の外で、夕から朝まで主の前に、そのともし火を整えなければならない。これはイスラエルの人々の守るべき世々変らざる定めでなければならない。"}]