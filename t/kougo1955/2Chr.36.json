[{"ref":"2Chr.36.1","start":14036001,"end":14036001,"break":"paragraph","ruby":[[0,1,"くに"],[2,1,"たみ"],[8,1,"こ"],[15,1,"た"],[26,1,"ちち"],[28,1,"かわ"],[31,1,"おう"]],"text":"国の民はヨシヤの子エホアハズを立て、エルサレムでその父に代って王とならせた。"},{"ref":"2Chr.36.2","start":14036002,"end":14036002,"break":"none","ruby":[[6,1,"おう"],[11,1,"とき"],[15,1,"さい"],[25,1,"つき"],[27,1,"あいだ"],[29,1,"よ"],[31,1,"おさ"]],"text":"エホアハズは王となった時二十三歳で、エルサレムで三月の間、世を治めたが、"},{"ref":"2Chr.36.3","start":14036003,"end":14036003,"break":"none","ruby":[[5,1,"おう"],[13,1,"かれ"],[15,1,"はい"],[20,1,"ぎん"],[27,1,"きん"],[34,2,"ばっきん"],[37,1,"くに"],[39,1,"か"]],"text":"エジプトの王はエルサレムで彼を廃し、かつ銀百タラント、金一タラントの罰金を国に課した。"},{"ref":"2Chr.36.4","start":14036004,"end":14036004,"break":"none","ruby":[[7,1,"おう"],[9,1,"かれ"],[11,2,"きょうだい"],[28,1,"おう"],[34,1,"な"],[42,1,"あらた"],[47,2,"きょうだい"],[55,1,"とら"],[63,1,"ひ"],[66,1,"い"]],"text":"そしてエジプト王は彼の兄弟エリアキムをユダとエルサレムの王とし、その名をエホヤキムと改め、その兄弟エホアハズを捕えてエジプトへ引いて行った。"},{"ref":"2Chr.36.5","start":14036005,"end":14036005,"break":"paragraph","ruby":[[6,1,"おう"],[11,1,"とき"],[15,1,"さい"],[20,1,"ねん"],[22,1,"あいだ"],[29,1,"よ"],[31,1,"おさ"],[35,1,"かれ"],[39,1,"かみ"],[41,1,"しゅ"],[43,1,"まえ"],[45,1,"あく"],[47,1,"おこな"]],"text":"エホヤキムは王となった時二十五歳で、十一年の間エルサレムで世を治めた。彼はその神、主の前に悪を行った。"},{"ref":"2Chr.36.6","start":14036006,"end":14036006,"break":"none","ruby":[[0,1,"とき"],[8,1,"おう"],[17,1,"かれ"],[19,1,"ところ"],[21,1,"せ"],[23,1,"のぼ"],[26,1,"かれ"],[33,1,"ひ"],[36,1,"い"]],"text":"時に、バビロンの王ネブカデネザルが彼の所に攻め上り、彼をバビロンに引いて行こうとして、かせにつないだ。"},{"ref":"2Chr.36.7","start":14036007,"end":14036007,"break":"none","ruby":[[10,1,"しゅ"],[12,1,"みや"],[14,2,"うつわもの"],[22,1,"はこ"],[25,1,"い"],[38,2,"きゅうでん"]],"text":"ネブカデネザルはまた主の宮の器物をバビロンに運んで行って、バビロンにあるその宮殿にそれをおさめた。"},{"ref":"2Chr.36.8","start":14036008,"end":14036008,"break":"none","ruby":[[8,1,"た"],[10,2,"こうい"],[15,1,"い"],[18,1,"にく"],[22,1,"こと"],[26,1,"かれ"],[32,1,"い"],[35,1,"こと"],[49,1,"れつ"],[50,1,"おう"],[52,1,"しょ"],[64,1,"こ"],[71,1,"かれ"],[73,1,"かわ"],[76,1,"おう"]],"text":"エホヤキムのその他の行為、その行った憎むべき事および彼がひそかに行った事などは、イスラエルとユダの列王の書にしるされている。その子エホヤキンが彼に代って王となった。"},{"ref":"2Chr.36.9","start":14036009,"end":14036009,"break":"paragraph","ruby":[[6,1,"おう"],[11,1,"とき"],[13,1,"さい"],[23,1,"つき"],[26,1,"か"],[28,1,"あいだ"],[30,1,"よ"],[32,1,"おさ"],[35,1,"しゅ"],[37,1,"まえ"],[39,1,"あく"],[41,1,"おこな"]],"text":"エホヤキンは王となった時八歳で、エルサレムで三月と十日の間、世を治め、主の前に悪を行った。"},{"ref":"2Chr.36.10","start":14036010,"end":14036010,"break":"none","ruby":[[0,1,"とし"],[2,1,"あらた"],[5,1,"はる"],[18,1,"おう"],[20,1,"ひと"],[28,1,"かれ"],[30,1,"しゅ"],[32,1,"みや"],[34,1,"たっと"],[36,2,"うつわもの"],[39,1,"とも"],[46,1,"つ"],[49,1,"い"],[55,2,"きょうだい"],[71,1,"おう"]],"text":"年が改まり春になって、ネブカデネザル王は人をつかわして、彼を主の宮の尊い器物と共にバビロンに連れて行かせ、その兄弟ゼデキヤをユダとエルサレムの王とした。"},{"ref":"2Chr.36.11","start":14036011,"end":14036011,"break":"paragraph","ruby":[[5,1,"おう"],[10,1,"とき"],[14,1,"さい"],[19,1,"ねん"],[21,1,"あいだ"],[28,1,"よ"],[30,1,"おさ"]],"text":"ゼデキヤは王となった時二十一歳で、十一年の間エルサレムで世を治めた。"},{"ref":"2Chr.36.12","start":14036012,"end":14036012,"break":"none","ruby":[[0,1,"かれ"],[4,1,"かみ"],[6,1,"しゅ"],[8,1,"まえ"],[10,1,"あく"],[12,1,"おこな"],[15,1,"しゅ"],[17,2,"ことば"],[20,1,"つた"],[23,3,"よげんしゃ"],[31,1,"まえ"],[34,1,"み"]],"text":"彼はその神、主の前に悪を行い、主の言葉を伝える預言者エレミヤの前に、身をひくくしなかった。"},{"ref":"2Chr.36.13","start":14036013,"end":14036013,"break":"none","ruby":[[0,1,"かれ"],[5,1,"かれ"],[7,1,"かみ"],[12,1,"ちか"],[23,1,"おう"],[31,1,"かれ"],[33,2,"ごうじょう"],[39,1,"こころ"],[55,1,"かみ"],[57,1,"しゅ"],[59,1,"た"],[61,1,"かえ"]],"text":"彼はまた、彼に神をさして誓わせたネブカデネザル王にもそむいた。彼は強情で、その心をかたくなにして、イスラエルの神、主に立ち返らなかった。"},{"ref":"2Chr.36.14","start":14036014,"end":14036014,"break":"none","ruby":[[0,2,"さいし"],[11,1,"たみ"],[20,3,"いほうじん"],[29,1,"にく"],[33,2,"こうい"],[47,1,"つみ"],[49,1,"おか"],[52,1,"しゅ"],[60,2,"せいべつ"],[68,1,"しゅ"],[70,1,"みや"],[72,1,"けが"]],"text":"祭司のかしらたちおよび民らもまた、すべて異邦人のもろもろの憎むべき行為にならって、はなはだしく罪を犯し、主がエルサレムに聖別しておかれた主の宮を汚した。"},{"ref":"2Chr.36.15","start":14036015,"end":14036015,"break":"paragraph","ruby":[[2,2,"せんぞ"],[5,1,"かみ"],[7,1,"しゅ"],[11,1,"たみ"],[34,2,"ししゃ"],[37,1,"かれ"]],"text":"その先祖の神、主はその民と、すみかをあわれむがゆえに、しきりに、その使者を彼らにつかわされたが、"},{"ref":"2Chr.36.16","start":14036016,"end":14036016,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,2,"ししゃ"],[17,2,"ことば"],[20,1,"かろ"],[26,3,"よげんしゃ"],[40,1,"しゅ"],[42,1,"いか"],[47,1,"たみ"],[49,1,"む"],[53,1,"おこ"],[59,1,"すく"]],"text":"彼らが神の使者たちをあざけり、その言葉を軽んじ、その預言者たちをののしったので、主の怒りがその民に向かって起り、ついに救うことができないようになった。"},{"ref":"2Chr.36.17","start":14036017,"end":14036017,"break":"paragraph","ruby":[[3,1,"しゅ"],[12,1,"おう"],[14,1,"かれ"],[17,1,"せ"],[28,1,"かれ"],[32,2,"せいじょ"],[35,1,"いえ"],[44,2,"わかもの"],[49,1,"ころ"],[52,2,"わかもの"],[57,2,"しょじょ"],[62,2,"ろうじん"],[71,1,"もの"],[83,1,"しゅ"],[85,1,"かれ"],[93,1,"かれ"],[95,1,"て"],[97,1,"わた"]],"text":"そこで主はカルデヤびとの王を彼らに攻めこさせられたので、彼はその聖所の家でつるぎをもって若者たちを殺し、若者をも、処女をも、老人をも、しらがの者をもあわれまなかった。主は彼らをことごとく彼の手に渡された。"},{"ref":"2Chr.36.18","start":14036018,"end":14036018,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かみ"],[4,1,"みや"],[11,2,"だいしょう"],[14,2,"うつわもの"],[17,1,"しゅ"],[19,1,"みや"],[21,1,"か"],[22,1,"ざい"],[24,1,"おう"],[34,1,"か"],[35,1,"ざい"],[50,1,"たずさ"],[53,1,"い"]],"text":"彼は神の宮のもろもろの大小の器物、主の宮の貨財、王とそのつかさたちの貨財など、すべてこれをバビロンに携えて行き、"},{"ref":"2Chr.36.19","start":14036019,"end":14036019,"break":"none","ruby":[[0,1,"かみ"],[2,1,"みや"],[4,1,"や"],[13,2,"じょうへき"],[25,2,"きゅうでん"],[33,1,"ひ"],[35,1,"や"],[43,1,"たっと"],[45,2,"うつわもの"]],"text":"神の宮を焼き、エルサレムの城壁をくずし、そのうちの宮殿をことごとく火で焼き、そのうちの尊い器物をことごとくこわした。"},{"ref":"2Chr.36.20","start":14036020,"end":14036020,"break":"none","ruby":[[0,1,"かれ"],[12,1,"もの"],[22,1,"とら"],[25,1,"い"],[29,1,"かれ"],[33,1,"こ"],[36,2,"けらい"],[47,1,"くに"],[49,1,"おこ"],[58,1,"お"]],"text":"彼はまたつるぎをのがれた者どもを、バビロンに捕えて行って、彼とその子らの家来となし、ペルシャの国の興るまで、そうして置いた。"},{"ref":"2Chr.36.21","start":14036021,"end":14036021,"break":"none","ruby":[[8,1,"くち"],[13,1,"つた"],[18,1,"しゅ"],[20,2,"ことば"],[23,2,"じょうじゅ"],[38,1,"くに"],[45,2,"あんそく"],[61,1,"あ"],[66,1,"あいだ"],[68,2,"あんそく"],[78,1,"ねん"],[80,1,"み"]],"text":"これはエレミヤの口によって伝えられた主の言葉の成就するためであった。こうして国はついにその安息をうけた。すなわちこれはその荒れている間、安息して、ついに七十年が満ちた。"},{"ref":"2Chr.36.22","start":14036022,"end":14036022,"break":"paragraph","ruby":[[4,1,"おう"],[9,2,"がんねん"],[12,1,"あた"],[15,1,"しゅ"],[22,1,"くち"],[27,1,"つた"],[30,1,"しゅ"],[32,2,"ことば"],[35,2,"じょうじゅ"],[46,1,"おう"],[51,1,"れい"],[53,2,"かんどう"],[61,1,"おう"],[67,2,"くにぢゅう"],[72,1,"しめ"],[80,1,"か"],[82,1,"しめ"],[85,1,"い"]],"text":"ペルシャ王クロスの元年に当り、主はエレミヤの口によって伝えた主の言葉を成就するため、ペルシャ王クロスの霊を感動されたので、王はあまねく国中にふれ示し、またそれを書き示して言った、"},{"ref":"2Chr.36.23","start":14036023,"end":14036023,"break":"none","ruby":[[6,1,"おう"],[13,1,"い"],[17,1,"てん"],[19,1,"かみ"],[21,1,"しゅ"],[23,2,"ちじょう"],[26,2,"くにぐに"],[38,1,"たま"],[43,1,"しゅ"],[45,1,"みや"],[58,1,"た"],[68,1,"めい"],[85,1,"たみ"],[89,1,"もの"],[91,1,"みな"],[95,1,"かみ"],[97,1,"しゅ"],[99,1,"たす"],[102,1,"え"],[104,1,"のぼ"],[107,1,"い"]],"text":"「ペルシャの王クロスはこう言う、『天の神、主は地上の国々をことごとくわたしに賜わって、主の宮をユダにあるエルサレムに建てることをわたしに命じられた。あなたがたのうち、その民である者は皆、その神、主の助けを得て上って行きなさい』」。"}]