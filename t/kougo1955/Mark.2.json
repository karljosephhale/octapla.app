[{"ref":"Mark.2.1","start":41002001,"end":41002001,"break":"paragraph","ruby":[[0,2,"いくにち"],[20,1,"かえ"],[29,1,"いえ"],[42,1,"た"]],"text":"幾日かたって、イエスがまたカペナウムにお帰りになったとき、家におられるといううわさが立ったので、"},{"ref":"Mark.2.2","start":41002002,"end":41002002,"break":"none","ruby":[[0,1,"おお"],[3,2,"ひとびと"],[6,1,"あつ"],[16,2,"とぐち"],[30,1,"な"],[47,2,"みことば"],[50,1,"かれ"],[53,1,"かた"]],"text":"多くの人々が集まってきて、もはや戸口のあたりまでも、すきまが無いほどになった。そして、イエスは御言を彼らに語っておられた。"},{"ref":"Mark.2.3","start":41002003,"end":41002003,"break":"none","ruby":[[4,2,"ひとびと"],[11,2,"ちゅうぶ"],[14,1,"もの"],[17,1,"にん"],[19,1,"ひと"],[21,1,"はこ"],[34,1,"つ"]],"text":"すると、人々がひとりの中風の者を四人の人に運ばせて、イエスのところに連れてきた。"},{"ref":"Mark.2.4","start":41002004,"end":41002004,"break":"none","ruby":[[5,2,"ぐんしゅう"],[11,2,"ちかよ"],[36,2,"やね"],[42,1,"あな"],[48,2,"ちゅうぶ"],[51,1,"もの"],[53,1,"ね"],[60,1,"とこ"]],"text":"ところが、群衆のために近寄ることができないので、イエスのおられるあたりの屋根をはぎ、穴をあけて、中風の者を寝かせたまま、床をつりおろした。"},{"ref":"Mark.2.5","start":41002005,"end":41002005,"break":"none","ruby":[[4,1,"かれ"],[7,2,"しんこう"],[10,1,"み"],[13,2,"ちゅうぶ"],[16,1,"もの"],[20,1,"こ"],[27,1,"つみ"],[36,1,"い"]],"text":"イエスは彼らの信仰を見て、中風の者に、「子よ、あなたの罪はゆるされた」と言われた。"},{"ref":"Mark.2.6","start":41002006,"end":41002006,"break":"none","ruby":[[8,2,"いくにん"],[12,2,"りっぽう"],[14,2,"がくしゃ"],[24,1,"こころ"],[26,1,"なか"],[28,1,"ろん"]],"text":"ところが、そこに幾人かの律法学者がすわっていて、心の中で論じた、"},{"ref":"Mark.2.7","start":41002007,"end":41002007,"break":"none","ruby":[[3,1,"ひと"],[14,1,"い"],[22,1,"かみ"],[31,1,"かみ"],[43,1,"つみ"]],"text":"「この人は、なぜあんなことを言うのか。それは神をけがすことだ。神ひとりのほかに、だれが罪をゆるすことができるか」。"},{"ref":"Mark.2.8","start":41002008,"end":41002008,"break":"none","ruby":[[5,1,"かれ"],[8,2,"ないしん"],[15,1,"ろん"],[23,2,"じぶん"],[26,1,"こころ"],[30,1,"み"],[45,1,"こころ"],[47,1,"なか"],[55,1,"ろん"]],"text":"イエスは、彼らが内心このように論じているのを、自分の心ですぐ見ぬいて、「なぜ、あなたがたは心の中でそんなことを論じているのか。"},{"ref":"Mark.2.9","start":41002009,"end":41002009,"break":"none","ruby":[[0,2,"ちゅうぶ"],[3,1,"もの"],[10,1,"つみ"],[19,1,"い"],[24,1,"お"],[28,1,"とこ"],[30,1,"と"],[35,1,"ある"],[39,1,"い"]],"text":"中風の者に、あなたの罪はゆるされた、と言うのと、起きよ、床を取りあげて歩け、と言うのと、どちらがたやすいか。"},{"ref":"Mark.2.10","start":41002010,"end":41002010,"break":"none","ruby":[[4,1,"ひと"],[6,1,"こ"],[8,2,"ちじょう"],[11,1,"つみ"],[16,2,"けんい"],[42,1,"かれ"],[45,1,"い"],[48,2,"ちゅうぶ"],[51,1,"もの"]],"text":"しかし、人の子は地上で罪をゆるす権威をもっていることが、あなたがたにわかるために」と彼らに言い、中風の者にむかって、"},{"ref":"Mark.2.11","start":41002011,"end":41002011,"break":"none","ruby":[[5,1,"めい"],[9,1,"お"],[13,1,"とこ"],[15,1,"と"],[20,1,"いえ"],[22,1,"かえ"],[26,1,"い"]],"text":"「あなたに命じる。起きよ、床を取りあげて家に帰れ」と言われた。"},{"ref":"Mark.2.12","start":41002012,"end":41002012,"break":"none","ruby":[[3,1,"かれ"],[5,1,"お"],[14,1,"とこ"],[16,1,"と"],[26,1,"まえ"],[28,1,"で"],[30,1,"い"],[36,2,"いちどう"],[39,1,"おお"],[42,1,"おどろ"],[45,1,"かみ"],[56,1,"こと"],[62,1,"ど"],[64,1,"み"],[73,1,"い"]],"text":"すると彼は起きあがり、すぐに床を取りあげて、みんなの前を出て行ったので、一同は大いに驚き、神をあがめて、「こんな事は、まだ一度も見たことがない」と言った。"},{"ref":"Mark.2.13","start":41002013,"end":41002013,"break":"paragraph","ruby":[[6,1,"うみ"],[9,1,"で"],[11,1,"い"],[17,1,"おお"],[20,2,"ひとびと"],[27,1,"あつ"],[36,1,"かれ"],[39,1,"おし"]],"text":"イエスはまた海べに出て行かれると、多くの人々がみもとに集まってきたので、彼らを教えられた。"},{"ref":"Mark.2.14","start":41002014,"end":41002014,"break":"none","ruby":[[2,2,"とちゅう"],[11,1,"こ"],[15,3,"しゅうぜいしょ"],[40,1,"したが"],[49,1,"い"],[57,1,"かれ"],[59,1,"た"],[70,1,"したが"]],"text":"また途中で、アルパヨの子レビが収税所にすわっているのをごらんになって、「わたしに従ってきなさい」と言われた。すると彼は立ちあがって、イエスに従った。"},{"ref":"Mark.2.15","start":41002015,"end":41002015,"break":"none","ruby":[[4,1,"かれ"],[6,1,"いえ"],[9,2,"しょくじ"],[12,1,"せき"],[30,1,"おお"],[33,3,"しゅぜいにん"],[37,2,"つみびと"],[47,2,"でし"],[52,1,"とも"],[56,1,"せき"],[58,1,"つ"],[67,1,"ひと"],[71,1,"おお"],[81,1,"したが"]],"text":"それから彼の家で、食事の席についておられたときのことである。多くの取税人や罪人たちも、イエスや弟子たちと共にその席に着いていた。こんな人たちが大ぜいいて、イエスに従ってきたのである。"},{"ref":"Mark.2.16","start":41002016,"end":41002016,"break":"none","ruby":[[4,1,"は"],[6,2,"りっぽう"],[8,2,"がくしゃ"],[18,2,"つみびと"],[21,3,"しゅぜいにん"],[27,2,"しょくじ"],[30,1,"とも"],[40,1,"み"],[43,2,"でし"],[48,1,"い"],[56,1,"かれ"],[58,3,"しゅぜいにん"],[62,2,"つみびと"],[67,2,"しょくじ"],[70,1,"とも"]],"text":"パリサイ派の律法学者たちは、イエスが罪人や取税人たちと食事を共にしておられるのを見て、弟子たちに言った、「なぜ、彼は取税人や罪人などと食事を共にするのか」。"},{"ref":"Mark.2.17","start":41002017,"end":41002017,"break":"none","ruby":[[7,1,"き"],[10,1,"い"],[16,2,"じょうぶ"],[19,1,"ひと"],[22,2,"いしゃ"],[34,2,"びょうにん"],[49,2,"ぎじん"],[52,1,"まね"],[61,2,"つみびと"],[64,1,"まね"]],"text":"イエスはこれを聞いて言われた、「丈夫な人には医者はいらない。いるのは病人である。わたしがきたのは、義人を招くためではなく、罪人を招くためである」。"},{"ref":"Mark.2.18","start":41002018,"end":41002018,"break":"paragraph","ruby":[[4,2,"でし"],[11,1,"びと"],[15,2,"だんじき"],[26,2,"ひとびと"],[36,1,"い"],[45,2,"でし"],[54,1,"びと"],[56,2,"でし"],[62,2,"だんじき"],[76,2,"でし"],[84,2,"だんじき"]],"text":"ヨハネの弟子とパリサイ人とは、断食をしていた。そこで人々がきて、イエスに言った、「ヨハネの弟子たちとパリサイ人の弟子たちとが断食をしているのに、あなたの弟子たちは、なぜ断食をしないのですか」。"},{"ref":"Mark.2.19","start":41002019,"end":41002019,"break":"none","ruby":[[7,1,"い"],[13,2,"こんれい"],[16,1,"きゃく"],[19,2,"はなむこ"],[22,2,"いっしょ"],[30,2,"だんじき"],[42,2,"はなむこ"],[45,2,"いっしょ"],[50,1,"あいだ"],[53,2,"だんじき"]],"text":"するとイエスは言われた、「婚礼の客は、花婿が一緒にいるのに、断食ができるであろうか。花婿と一緒にいる間は、断食はできない。"},{"ref":"Mark.2.20","start":41002020,"end":41002020,"break":"none","ruby":[[4,2,"はなむこ"],[7,1,"うば"],[9,1,"さ"],[13,1,"ひ"],[15,1,"く"],[20,1,"ひ"],[23,2,"だんじき"]],"text":"しかし、花婿が奪い去られる日が来る。その日には断食をするであろう。"},{"ref":"Mark.2.21","start":41002021,"end":41002021,"break":"none","ruby":[[4,2,"まあたら"],[8,1,"ぬの"],[13,1,"ふる"],[15,2,"きもの"],[18,1,"ぬ"],[35,1,"あたら"],[41,1,"ふる"],[43,2,"きもの"],[46,1,"ひ"],[48,1,"やぶ"],[55,1,"やぶ"]],"text":"だれも、真新しい布ぎれを、古い着物に縫いつけはしない。もしそうすれば、新しいつぎは古い着物を引き破り、そして、破れがもっとひどくなる。"},{"ref":"Mark.2.22","start":41002022,"end":41002022,"break":"none","ruby":[[6,1,"あたら"],[12,1,"しゅ"],[14,1,"ふる"],[16,1,"かわ"],[17,1,"ぶくろ"],[19,1,"い"],[37,1,"しゅ"],[39,1,"かわ"],[40,1,"ぶくろ"],[44,1,"さ"],[54,1,"しゅ"],[56,1,"かわ"],[57,1,"ぶくろ"],[74,1,"あたら"],[80,1,"しゅ"],[82,1,"あたら"],[85,1,"かわ"],[86,1,"ぶくろ"],[88,1,"い"]],"text":"まただれも、新しいぶどう酒を古い皮袋に入れはしない。もしそうすれば、ぶどう酒は皮袋をはり裂き、そして、ぶどう酒も皮袋もむだになってしまう。〔だから、新しいぶどう酒は新しい皮袋に入れるべきである〕」。"},{"ref":"Mark.2.23","start":41002023,"end":41002023,"break":"paragraph","ruby":[[2,3,"あんそくにち"],[11,2,"むぎばたけ"],[14,1,"なか"],[20,1,"い"],[29,2,"でし"],[35,1,"ある"],[40,1,"ほ"]],"text":"ある安息日に、イエスは麦畑の中をとおって行かれた。そのとき弟子たちが、歩きながら穂をつみはじめた。"},{"ref":"Mark.2.24","start":41002024,"end":41002024,"break":"none","ruby":[[8,1,"びと"],[16,1,"い"],[26,1,"かれ"],[32,3,"あんそくにち"]],"text":"すると、パリサイ人たちがイエスに言った、「いったい、彼らはなぜ、安息日にしてはならぬことをするのですか」。"},{"ref":"Mark.2.25","start":41002025,"end":41002025,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[25,1,"とも"],[27,1,"もの"],[32,2,"しょくもつ"],[38,1,"う"],[48,1,"なに"],[56,1,"よ"]],"text":"そこで彼らに言われた、「あなたがたは、ダビデとその供の者たちとが食物がなくて飢えたとき、ダビデが何をしたか、まだ読んだことがないのか。"},{"ref":"Mark.2.26","start":41002026,"end":41002026,"break":"none","ruby":[[5,3,"だいさいし"],[14,1,"とき"],[16,1,"かみ"],[18,1,"いえ"],[25,2,"さいし"],[32,1,"た"],[39,1,"そな"],[46,2,"じぶん"],[49,1,"た"],[54,1,"とも"],[56,1,"もの"],[61,1,"あた"]],"text":"すなわち、大祭司アビアタルの時、神の家にはいって、祭司たちのほか食べてはならぬ供えのパンを、自分も食べ、また供の者たちにも与えたではないか」。"},{"ref":"Mark.2.27","start":41002027,"end":41002027,"break":"none","ruby":[[2,1,"かれ"],[5,1,"い"],[11,3,"あんそくにち"],[15,1,"ひと"],[26,1,"ひと"],[28,3,"あんそくにち"]],"text":"また彼らに言われた、「安息日は人のためにあるもので、人が安息日のためにあるのではない。"},{"ref":"Mark.2.28","start":41002028,"end":41002028,"break":"none","ruby":[[6,1,"ひと"],[8,1,"こ"],[11,3,"あんそくにち"],[18,1,"しゅ"]],"text":"それだから、人の子は、安息日にもまた主なのである」。"}]