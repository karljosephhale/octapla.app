[{"ref":"Rom.12.1","start":45012001,"end":45012001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[14,1,"かみ"],[30,1,"すす"],[45,1,"かみ"],[47,1,"よろこ"],[52,1,"い"],[56,1,"せい"],[59,1,"そな"],[61,1,"もの"],[86,2,"れいてき"],[89,2,"れいはい"]],"text":"兄弟たちよ。そういうわけで、神のあわれみによってあなたがたに勧める。あなたがたのからだを、神に喜ばれる、生きた、聖なる供え物としてささげなさい。それが、あなたがたのなすべき霊的な礼拝である。"},{"ref":"Rom.12.2","start":45012002,"end":45012002,"break":"none","ruby":[[9,1,"よ"],[11,2,"だきょう"],[25,1,"こころ"],[27,1,"あら"],[39,1,"つく"],[46,1,"なに"],[48,1,"かみ"],[50,2,"みむね"],[57,1,"なに"],[59,1,"ぜん"],[65,1,"かみ"],[67,1,"よろこ"],[73,1,"まった"],[87,1,"し"]],"text":"あなたがたは、この世と妥協してはならない。むしろ、心を新たにすることによって、造りかえられ、何が神の御旨であるか、何が善であって、神に喜ばれ、かつ全きことであるかを、わきまえ知るべきである。"},{"ref":"Rom.12.3","start":45012003,"end":45012003,"break":"paragraph","ruby":[[5,2,"じぶん"],[8,1,"あた"],[13,1,"めぐ"],[32,1,"い"],[35,1,"おも"],[39,2,"げんど"],[42,1,"こ"],[45,1,"おも"],[59,1,"かみ"],[61,2,"かくじ"],[64,1,"わ"],[66,1,"あた"],[71,2,"しんこう"],[74,1,"はか"],[83,1,"つつし"],[85,1,"ふか"],[87,1,"おも"]],"text":"わたしは、自分に与えられた恵みによって、あなたがたひとりびとりに言う。思うべき限度を越えて思いあがることなく、むしろ、神が各自に分け与えられた信仰の量りにしたがって、慎み深く思うべきである。"},{"ref":"Rom.12.4","start":45012004,"end":45012004,"break":"none","ruby":[[17,2,"したい"],[28,2,"したい"],[33,1,"おな"],[35,1,"はたら"]],"text":"なぜなら、一つのからだにたくさんの肢体があるが、それらの肢体がみな同じ働きをしてはいないように、"},{"ref":"Rom.12.5","start":45012005,"end":45012005,"break":"none","ruby":[[6,1,"かず"],[8,1,"おお"],[32,2,"かくじ"],[35,1,"たがい"],[37,2,"したい"]],"text":"わたしたちも数は多いが、キリストにあって一つのからだであり、また各自は互に肢体だからである。"},{"ref":"Rom.12.6","start":45012006,"end":45012006,"break":"none","ruby":[[12,1,"あた"],[17,1,"めぐ"],[28,1,"こと"],[32,2,"たまもの"],[35,1,"も"],[49,2,"よげん"],[56,2,"しんこう"],[59,2,"ていど"],[62,1,"おう"],[65,2,"よげん"]],"text":"このように、わたしたちは与えられた恵みによって、それぞれ異なった賜物を持っているので、もし、それが預言であれば、信仰の程度に応じて預言をし、"},{"ref":"Rom.12.7","start":45012007,"end":45012007,"break":"none","ruby":[[0,2,"ほうし"],[6,2,"ほうし"],[13,1,"おし"],[16,1,"もの"],[21,1,"おし"]],"text":"奉仕であれば奉仕をし、また教える者であれば教え、"},{"ref":"Rom.12.8","start":45012008,"end":45012008,"break":"none","ruby":[[0,1,"すす"],[5,1,"もの"],[10,1,"すす"],[13,2,"きふ"],[17,1,"もの"],[19,1,"お"],[24,2,"きふ"],[28,2,"しどう"],[32,1,"もの"],[34,2,"ねっしん"],[37,2,"しどう"],[41,2,"じぜん"],[46,1,"もの"],[48,1,"こころよ"],[50,2,"じぜん"]],"text":"勧めをする者であれば勧め、寄附する者は惜しみなく寄附し、指導する者は熱心に指導し、慈善をする者は快く慈善をすべきである。"},{"ref":"Rom.12.9","start":45012009,"end":45012009,"break":"none","ruby":[[0,1,"あい"],[3,1,"いつわ"],[15,1,"あく"],[17,1,"にく"],[19,1,"しりぞ"],[22,1,"ぜん"],[25,1,"した"],[28,1,"むす"]],"text":"愛には偽りがあってはならない。悪は憎み退け、善には親しみ結び、"},{"ref":"Rom.12.10","start":45012010,"end":45012010,"break":"none","ruby":[[0,2,"きょうだい"],[3,1,"あい"],[8,1,"たがい"],[16,1,"すす"],[19,1,"たがい"],[21,2,"そんけい"],[24,1,"あ"]],"text":"兄弟の愛をもって互にいつくしみ、進んで互に尊敬し合いなさい。"},{"ref":"Rom.12.11","start":45012011,"end":45012011,"break":"none","ruby":[[0,2,"ねっしん"],[11,1,"れい"],[13,1,"も"],[16,1,"しゅ"],[18,1,"つか"]],"text":"熱心で、うむことなく、霊に燃え、主に仕え、"},{"ref":"Rom.12.12","start":45012012,"end":45012012,"break":"none","ruby":[[0,1,"のぞ"],[7,1,"よろこ"],[10,2,"かんなん"],[13,1,"た"],[16,1,"つね"],[18,1,"いの"]],"text":"望みをいだいて喜び、患難に耐え、常に祈りなさい。"},{"ref":"Rom.12.13","start":45012013,"end":45012013,"break":"none","ruby":[[0,1,"まず"],[3,2,"せいと"],[6,1,"たす"],[9,1,"つと"],[12,2,"たびびと"]],"text":"貧しい聖徒を助け、努めて旅人をもてなしなさい。"},{"ref":"Rom.12.14","start":45012014,"end":45012014,"break":"none","ruby":[[6,2,"はくがい"],[10,1,"もの"],[12,2,"しゅくふく"],[19,2,"しゅくふく"]],"text":"あなたがたを迫害する者を祝福しなさい。祝福して、のろってはならない。"},{"ref":"Rom.12.15","start":45012015,"end":45012015,"break":"none","ruby":[[0,1,"よろこ"],[2,1,"もの"],[4,1,"とも"],[6,1,"よろこ"],[9,1,"な"],[11,1,"もの"],[13,1,"とも"],[15,1,"な"]],"text":"喜ぶ者と共に喜び、泣く者と共に泣きなさい。"},{"ref":"Rom.12.16","start":45012016,"end":45012016,"break":"none","ruby":[[0,1,"たがい"],[2,1,"おも"],[13,1,"たか"],[17,1,"おも"],[29,1,"ひく"],[31,1,"もの"],[35,1,"まじ"],[42,2,"じぶん"],[45,2,"ちしゃ"],[49,1,"おも"]],"text":"互に思うことをひとつにし、高ぶった思いをいだかず、かえって低い者たちと交わるがよい。自分が知者だと思いあがってはならない。"},{"ref":"Rom.12.17","start":45012017,"end":45012017,"break":"none","ruby":[[3,1,"たい"],[7,1,"あく"],[12,1,"あく"],[14,1,"むく"],[22,1,"ひと"],[24,1,"たい"],[27,1,"ぜん"],[29,1,"はか"]],"text":"だれに対しても悪をもって悪に報いず、すべての人に対して善を図りなさい。"},{"ref":"Rom.12.18","start":45012018,"end":45012018,"break":"none","ruby":[[10,1,"かぎ"],[16,1,"ひと"],[18,2,"へいわ"],[21,1,"す"]],"text":"あなたがたは、できる限りすべての人と平和に過ごしなさい。"},{"ref":"Rom.12.19","start":45012019,"end":45012019,"break":"none","ruby":[[0,1,"あい"],[3,1,"もの"],[8,2,"じぶん"],[11,2,"ふくしゅう"],[23,1,"かみ"],[25,1,"いか"],[28,1,"まか"],[40,1,"しゅ"],[42,1,"い"],[47,2,"ふくしゅう"],[65,2,"じしん"],[68,2,"ほうふく"],[74,1,"か"]],"text":"愛する者たちよ。自分で復讐をしないで、むしろ、神の怒りに任せなさい。なぜなら、「主が言われる。復讐はわたしのすることである。わたし自身が報復する」と書いてあるからである。"},{"ref":"Rom.12.20","start":45012020,"end":45012020,"break":"none","ruby":[[11,1,"てき"],[13,1,"う"],[19,1,"かれ"],[21,1,"く"],[31,1,"かれ"],[33,1,"の"],[55,1,"かれ"],[57,1,"あたま"],[59,1,"も"],[64,2,"すみび"],[67,1,"つ"]],"text":"むしろ、「もしあなたの敵が飢えるなら、彼に食わせ、かわくなら、彼に飲ませなさい。そうすることによって、あなたは彼の頭に燃えさかる炭火を積むことになるのである」。"},{"ref":"Rom.12.21","start":45012021,"end":45012021,"break":"none","ruby":[[0,1,"あく"],[2,1,"ま"],[16,1,"ぜん"],[21,1,"あく"],[23,1,"か"]],"text":"悪に負けてはいけない。かえって、善をもって悪に勝ちなさい。"}]