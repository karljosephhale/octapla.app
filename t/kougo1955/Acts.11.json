[{"ref":"Acts.11.1","start":44011001,"end":44011001,"break":"paragraph","ruby":[[3,3,"いほうじん"],[9,1,"かみ"],[11,1,"ことば"],[13,1,"う"],[25,2,"しと"],[36,2,"きょうだい"],[41,1,"きこ"]],"text":"さて、異邦人たちも神の言を受けいれたということが、使徒たちやユダヤにいる兄弟たちに聞えてきた。"},{"ref":"Acts.11.2","start":44011002,"end":44011002,"break":"none","ruby":[[13,1,"のぼ"],[19,2,"かつれい"],[22,1,"おも"],[26,1,"もの"],[30,1,"かれ"],[36,1,"い"]],"text":"そこでペテロがエルサレムに上ったとき、割礼を重んじる者たちが彼をとがめて言った、"},{"ref":"Acts.11.3","start":44011003,"end":44011003,"break":"none","ruby":[[6,2,"かつれい"],[11,1,"ひと"],[19,1,"い"],[23,2,"しょくじ"],[26,1,"とも"]],"text":"「あなたは、割礼のない人たちのところに行って、食事を共にしたということだが」。"},{"ref":"Acts.11.4","start":44011004,"end":44011004,"break":"none","ruby":[[7,1,"くち"],[9,1,"ひら"],[13,2,"じゅんじょ"],[15,1,"ただ"],[18,2,"せつめい"],[22,1,"い"]],"text":"そこでペテロは口を開いて、順序正しく説明して言った、"},{"ref":"Acts.11.5","start":44011005,"end":44011005,"break":"none","ruby":[[9,1,"まち"],[11,1,"いの"],[18,3,"ゆめごこち"],[25,1,"まぼろし"],[27,1,"み"],[30,1,"おお"],[33,1,"ぬの"],[38,1,"い"],[40,1,"もの"],[43,1,"よ"],[53,1,"てん"],[56,1,"お"]],"text":"「わたしがヨッパの町で祈っていると、夢心地になって幻を見た。大きな布のような入れ物が、四すみをつるされて、天から降りてきて、わたしのところにとどいた。"},{"ref":"Acts.11.6","start":44011006,"end":44011006,"break":"none","ruby":[[0,2,"ちゅうい"],[4,1,"み"],[12,2,"ちじょう"],[17,1,"あし"],[19,1,"の"],[21,1,"けもの"],[23,1,"は"],[28,1,"そら"],[30,1,"とり"]],"text":"注意して見つめていると、地上の四つ足、野の獣、這うもの、空の鳥などが、はいっていた。"},{"ref":"Acts.11.7","start":44011007,"end":44011007,"break":"none","ruby":[[4,1,"こえ"],[15,1,"た"],[27,1,"た"],[39,1,"い"],[43,1,"きこ"]],"text":"それから声がして、『ペテロよ、立って、それらをほふって食べなさい』と、わたしに言うのが聞えた。"},{"ref":"Acts.11.8","start":44011008,"end":44011008,"break":"none","ruby":[[4,1,"い"],[9,1,"しゅ"],[25,1,"いま"],[30,1,"きよ"],[37,1,"けが"],[43,1,"くち"],[45,1,"い"],[51,2,"いちど"]],"text":"わたしは言った、『主よ、それはできません。わたしは今までに、清くないものや汚れたものを口に入れたことが一度もございません』。"},{"ref":"Acts.11.9","start":44011009,"end":44011009,"break":"none","ruby":[[5,2,"どめ"],[8,1,"てん"],[11,1,"こえ"],[21,1,"かみ"],[31,1,"きよ"],[38,1,"い"]],"text":"すると、二度目に天から声がかかってきた、『神がきよめたものを、清くないなどと言ってはならない』。"},{"ref":"Acts.11.10","start":44011010,"end":44011010,"break":"none","ruby":[[7,1,"ど"],[15,2,"ぜんぶ"],[23,1,"てん"],[25,1,"ひ"],[27,1,"あ"]],"text":"こんなことが三度もあってから、全部のものがまた天に引き上げられてしまった。"},{"ref":"Acts.11.11","start":44011011,"end":44011011,"break":"none","ruby":[[6,1,"とき"],[24,1,"にん"],[26,1,"ひと"],[35,1,"と"],[41,1,"いえ"],[43,1,"つ"]],"text":"ちょうどその時、カイザリヤからつかわされてきた三人の人が、わたしたちの泊まっていた家に着いた。"},{"ref":"Acts.11.12","start":44011012,"end":44011012,"break":"none","ruby":[[0,2,"みたま"],[14,1,"かれ"],[17,1,"とも"],[19,1,"い"],[22,1,"い"],[34,1,"にん"],[36,2,"きょうだい"],[46,2,"いっしょ"],[49,1,"で"],[53,1,"い"],[56,2,"いちどう"],[61,1,"ひと"],[63,1,"いえ"]],"text":"御霊がわたしに、ためらわずに彼らと共に行けと言ったので、ここにいる六人の兄弟たちも、わたしと一緒に出かけて行き、一同がその人の家にはいった。"},{"ref":"Acts.11.13","start":44011013,"end":44011013,"break":"none","ruby":[[3,1,"かれ"],[12,2,"みつかい"],[15,1,"かれ"],[17,1,"いえ"],[19,1,"あらわ"],[28,1,"ひと"],[38,1,"よ"],[46,1,"まね"]],"text":"すると彼はわたしたちに、御使が彼の家に現れて、『ヨッパに人をやって、ペテロと呼ばれるシモンを招きなさい。"},{"ref":"Acts.11.14","start":44011014,"end":44011014,"break":"none","ruby":[[2,1,"ひと"],[13,1,"ぜん"],[14,2,"かぞく"],[18,1,"すく"],[22,2,"ことば"],[25,1,"かた"],[28,1,"くだ"],[37,1,"つ"],[40,2,"しだい"],[44,1,"はな"]],"text":"この人は、あなたとあなたの全家族とが救われる言葉を語って下さるであろう』と告げた次第を、話してくれた。"},{"ref":"Acts.11.15","start":44011015,"end":44011015,"break":"none","ruby":[[7,1,"かた"],[9,1,"だ"],[16,2,"せいれい"],[24,2,"さいしょ"],[32,1,"うえ"],[39,1,"おな"],[45,1,"かれ"],[48,1,"うえ"]],"text":"そこでわたしが語り出したところ、聖霊が、ちょうど最初わたしたちの上にくだったと同じように、彼らの上にくだった。"},{"ref":"Acts.11.16","start":44011016,"end":44011016,"break":"none","ruby":[[2,1,"とき"],[8,1,"しゅ"],[15,1,"みず"],[23,1,"さづ"],[34,2,"せいれい"],[46,1,"う"],[55,1,"おお"],[61,2,"ことば"],[64,1,"おも"],[66,1,"だ"]],"text":"その時わたしは、主が『ヨハネは水でバプテスマを授けたが、あなたがたは聖霊によってバプテスマを受けるであろう』と仰せになった言葉を思い出した。"},{"ref":"Acts.11.17","start":44011017,"end":44011017,"break":"none","ruby":[[12,1,"しゅ"],[22,1,"しん"],[25,1,"とき"],[27,1,"くだ"],[33,1,"おな"],[35,2,"たまもの"],[39,1,"かみ"],[41,1,"かれ"],[46,1,"あた"],[64,1,"もの"],[71,1,"かみ"],[73,1,"さまた"]],"text":"このように、わたしたちが主イエス・キリストを信じた時に下さったのと同じ賜物を、神が彼らにもお与えになったとすれば、わたしのような者が、どうして神を妨げることができようか」。"},{"ref":"Acts.11.18","start":44011018,"end":44011018,"break":"none","ruby":[[0,2,"ひとびと"],[6,1,"き"],[9,1,"だま"],[21,1,"かみ"],[34,1,"かみ"],[37,3,"いほうじん"],[42,1,"いのち"],[47,2,"くいあらた"],[52,1,"あた"],[62,1,"い"]],"text":"人々はこれを聞いて黙ってしまった。それから神をさんびして、「それでは神は、異邦人にも命にいたる悔改めをお与えになったのだ」と言った。"},{"ref":"Acts.11.19","start":44011019,"end":44011019,"break":"paragraph","ruby":[[11,1,"おこ"],[14,2,"はくがい"],[20,1,"ち"],[25,2,"ひとびと"],[45,1,"すす"],[48,1,"い"],[56,1,"じん"],[57,2,"いがい"],[60,1,"もの"],[68,2,"みことば"],[71,1,"かた"]],"text":"さて、ステパノのことで起った迫害のために散らされた人々は、ピニケ、クプロ、アンテオケまでも進んで行ったが、ユダヤ人以外の者には、だれにも御言を語っていなかった。"},{"ref":"Acts.11.20","start":44011020,"end":44011020,"break":"none","ruby":[[7,1,"なか"],[9,2,"すうにん"],[15,1,"びと"],[20,1,"びと"],[31,1,"い"],[40,1,"じん"],[43,1,"よ"],[48,1,"しゅ"],[53,1,"の"],[55,1,"つた"]],"text":"ところが、その中に数人のクプロ人とクレネ人がいて、アンテオケに行ってからギリシヤ人にも呼びかけ、主イエスを宣べ伝えていた。"},{"ref":"Acts.11.21","start":44011021,"end":44011021,"break":"none","ruby":[[4,1,"しゅ"],[7,1,"て"],[9,1,"かれ"],[12,1,"とも"],[20,1,"しん"],[23,1,"しゅ"],[25,2,"きえ"],[32,1,"かず"],[34,1,"おお"]],"text":"そして、主のみ手が彼らと共にあったため、信じて主に帰依するものの数が多かった。"},{"ref":"Acts.11.22","start":44011022,"end":44011022,"break":"paragraph","ruby":[[14,2,"きょうかい"],[17,1,"つた"],[26,2,"きょうかい"]],"text":"このうわさがエルサレムにある教会に伝わってきたので、教会はバルナバをアンテオケにつかわした。"},{"ref":"Acts.11.23","start":44011023,"end":44011023,"break":"none","ruby":[[0,1,"かれ"],[6,1,"つ"],[10,1,"かみ"],[16,1,"み"],[23,1,"しゅ"],[25,1,"たい"],[28,2,"しんこう"],[31,1,"ゆ"],[36,1,"こころ"],[38,1,"も"],[53,1,"もの"],[55,1,"はげ"]],"text":"彼は、そこに着いて、神のめぐみを見てよろこび、主に対する信仰を揺るがない心で持ちつづけるようにと、みんなの者を励ました。"},{"ref":"Acts.11.24","start":44011024,"end":44011024,"break":"none","ruby":[[0,1,"かれ"],[2,2,"せいれい"],[5,2,"しんこう"],[9,1,"み"],[12,2,"りっぱ"],[15,1,"ひと"],[30,1,"しゅ"],[32,1,"くわ"],[35,2,"ひとびと"],[39,1,"おお"]],"text":"彼は聖霊と信仰とに満ちた立派な人であったからである。こうして主に加わる人々が、大ぜいになった。"},{"ref":"Acts.11.25","start":44011025,"end":44011025,"break":"none","ruby":[[12,1,"さが"],[19,1,"で"],[23,1,"い"]],"text":"そこでバルナバはサウロを捜しにタルソへ出かけて行き、"},{"ref":"Acts.11.26","start":44011026,"end":44011026,"break":"none","ruby":[[0,1,"かれ"],[2,1,"み"],[15,1,"つ"],[18,1,"かえ"],[30,1,"ねん"],[37,2,"きょうかい"],[40,1,"あつ"],[46,1,"おお"],[50,2,"ひとびと"],[53,1,"おし"],[65,1,"はじ"],[69,2,"でし"],[81,1,"よ"]],"text":"彼を見つけたうえ、アンテオケに連れて帰った。ふたりは、まる一年、ともどもに教会で集まりをし、大ぜいの人々を教えた。このアンテオケで初めて、弟子たちがクリスチャンと呼ばれるようになった。"},{"ref":"Acts.11.27","start":44011027,"end":44011027,"break":"paragraph","ruby":[[5,3,"よげんしゃ"]],"text":"そのころ、預言者たちがエルサレムからアンテオケにくだってきた。"},{"ref":"Acts.11.28","start":44011028,"end":44011028,"break":"none","ruby":[[2,1,"なか"],[16,1,"もの"],[18,1,"た"],[22,3,"せかいじゅう"],[26,1,"だい"],[31,1,"おこ"],[38,2,"みたま"],[44,2,"よげん"],[52,1,"はた"],[63,1,"てい"],[65,1,"とき"],[67,1,"おこ"]],"text":"その中のひとりであるアガボという者が立って、世界中に大ききんが起るだろうと、御霊によって預言したところ、果してそれがクラウデオ帝の時に起った。"},{"ref":"Acts.11.29","start":44011029,"end":44011029,"break":"none","ruby":[[3,2,"でし"],[14,1,"ちから"],[16,1,"おう"],[24,1,"す"],[29,2,"きょうだい"],[34,2,"えんじょ"],[37,1,"おく"],[42,1,"き"]],"text":"そこで弟子たちは、それぞれの力に応じて、ユダヤに住んでいる兄弟たちに援助を送ることに決めた。"},{"ref":"Acts.11.30","start":44011030,"end":44011030,"break":"none","ruby":[[17,1,"て"],[19,1,"たく"],[23,2,"ちょうろう"],[28,1,"おく"]],"text":"そして、それをバルナバとサウロとの手に託して、長老たちに送りとどけた。"}]