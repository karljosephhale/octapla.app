[{"ref":"Jer.7.1","start":24007001,"end":24007001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"のぞ"],[11,2,"ことば"]],"text":"主からエレミヤに臨んだ言葉はこうである。"},{"ref":"Jer.7.2","start":24007002,"end":24007002,"break":"none","ruby":[[1,1,"しゅ"],[3,1,"いえ"],[5,1,"もん"],[7,1,"た"],[12,1,"ところ"],[17,2,"ことば"],[23,1,"い"],[26,1,"しゅ"],[28,1,"おが"],[36,1,"もん"],[48,1,"ひと"],[51,1,"しゅ"],[53,2,"ことば"],[56,1,"き"]],"text":"「主の家の門に立ち、その所で、この言葉をのべて言え、主を拝むために、この門をはいるユダのすべての人よ、主の言葉を聞け。"},{"ref":"Jer.7.3","start":24007003,"end":24007003,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[15,1,"い"],[26,1,"みち"],[34,1,"おこな"],[37,1,"あらた"],[56,1,"ところ"],[58,1,"す"]],"text":"万軍の主、イスラエルの神はこう言われる、あなたがたの道とあなたがたの行いを改めるならば、わたしはあなたがたをこの所に住まわせる。"},{"ref":"Jer.7.4","start":24007004,"end":24007004,"break":"none","ruby":[[11,1,"しゅ"],[13,2,"しんでん"],[17,1,"しゅ"],[19,2,"しんでん"],[23,1,"しゅ"],[25,2,"しんでん"],[32,1,"いつわ"],[35,2,"ことば"],[38,1,"たの"]],"text":"あなたがたは、『これは主の神殿だ、主の神殿だ、主の神殿だ』という偽りの言葉を頼みとしてはならない。"},{"ref":"Jer.7.5","start":24007005,"end":24007005,"break":"paragraph","ruby":[[16,1,"みち"],[18,1,"おこな"],[21,1,"あらた"],[25,1,"たがい"],[27,2,"こうせい"],[30,1,"おこな"]],"text":"もしあなたがたが、まことに、その道と行いを改めて、互に公正を行い、"},{"ref":"Jer.7.6","start":24007006,"end":24007006,"break":"none","ruby":[[0,2,"きりゅう"],[3,2,"たこく"],[5,1,"じん"],[28,1,"つみ"],[32,1,"ひと"],[34,1,"ち"],[38,1,"ところ"],[40,1,"なが"],[53,2,"かみがみ"],[56,1,"したが"],[59,1,"みずか"],[61,1,"がい"]],"text":"寄留の他国人と、みなしごと、やもめをしえたげることなく、罪のない人の血をこの所に流すことなく、また、ほかの神々に従って自ら害をまねくことをしないならば、"},{"ref":"Jer.7.7","start":24007007,"end":24007007,"break":"none","ruby":[[15,1,"むかし"],[22,2,"せんぞ"],[25,1,"あた"],[30,1,"ち"],[32,2,"えいえん"],[35,1,"す"]],"text":"わたしはあなたがたを、わたしが昔あなたがたの先祖に与えたこの地に永遠に住まわせる。"},{"ref":"Jer.7.8","start":24007008,"end":24007008,"break":"paragraph","ruby":[[0,1,"み"],[9,1,"いつわ"],[12,2,"ことば"],[15,1,"たの"]],"text":"見よ、あなたがたは偽りの言葉を頼みとしているが、それはむだである。"},{"ref":"Jer.7.9","start":24007009,"end":24007009,"break":"none","ruby":[[6,1,"ぬす"],[9,1,"ころ"],[12,2,"かんいん"],[16,1,"いつわ"],[19,1,"ちか"],[26,1,"こう"],[37,2,"いぜん"],[41,1,"し"],[47,1,"た"],[49,2,"かみがみ"],[52,1,"したが"]],"text":"あなたがたは盗み、殺し、姦淫し、偽って誓い、バアルに香をたき、あなたがたが以前には知らなかった他の神々に従いながら、"},{"ref":"Jer.7.10","start":24007010,"end":24007010,"break":"none","ruby":[[4,1,"な"],[18,1,"いえ"],[20,1,"き"],[26,1,"まえ"],[28,1,"た"],[37,1,"すく"],[43,1,"い"],[55,1,"にく"],[62,1,"おこな"]],"text":"わたしの名をもって、となえられるこの家に来てわたしの前に立ち、『われわれは救われた』と言い、しかもすべてこれら憎むべきことを行うのは、どうしたことか。"},{"ref":"Jer.7.11","start":24007011,"end":24007011,"break":"none","ruby":[[4,1,"な"],[18,1,"いえ"],[27,1,"め"],[30,2,"とうぞく"],[33,1,"す"],[35,1,"み"],[44,2,"じしん"],[49,1,"み"],[52,1,"しゅ"],[54,1,"い"]],"text":"わたしの名をもって、となえられるこの家が、あなたがたの目には盗賊の巣と見えるのか。わたし自身、そう見たと主は言われる。"},{"ref":"Jer.7.12","start":24007012,"end":24007012,"break":"none","ruby":[[4,1,"はじ"],[11,1,"な"],[13,1,"お"],[16,2,"ばしょ"],[21,1,"い"],[26,1,"たみ"],[33,1,"あく"],[45,2,"ばしょ"],[48,1,"たい"],[51,1,"おこな"],[57,1,"み"]],"text":"わたしが初めにわたしの名を置いた場所シロへ行き、わが民イスラエルの悪のために、わたしがその場所に対して行ったことを見よ。"},{"ref":"Jer.7.13","start":24007013,"end":24007013,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"いま"],[25,1,"おこな"],[48,1,"かた"],[62,1,"き"],[72,1,"よ"],[79,1,"こた"]],"text":"主は言われる、今あなたがたはこれらのすべてのことを行っている。またわたしはあなたがたに、しきりに語ったけれども、あなたがたは聞かず、あなたがたを呼んだけれども答えなかった。"},{"ref":"Jer.7.14","start":24007014,"end":24007014,"break":"none","ruby":[[11,1,"たい"],[14,1,"おこな"],[25,1,"な"],[39,1,"いえ"],[42,1,"おこな"],[55,1,"たの"],[60,1,"ところ"],[79,2,"せんぞ"],[82,1,"あた"],[87,1,"ところ"],[89,1,"おこな"]],"text":"それゆえわたしはシロに対して行ったように、わたしの名をもって、となえられるこの家にも行う。すなわちあなたがたが頼みとする所、わたしがあなたがたと、あなたがたの先祖に与えたこの所に行う。"},{"ref":"Jer.7.15","start":24007015,"end":24007015,"break":"none","ruby":[[18,2,"きょうだい"],[35,2,"しそん"],[38,1,"す"],[49,1,"まえ"],[59,1,"す"]],"text":"そしてわたしは、あなたがたのすべての兄弟、すなわちエフライムのすべての子孫を捨てたように、わたしの前からあなたがたをも捨てる。"},{"ref":"Jer.7.16","start":24007016,"end":24007016,"break":"paragraph","ruby":[[6,1,"たみ"],[11,1,"いの"],[20,1,"かれ"],[26,1,"なげ"],[29,1,"いの"],[66,1,"もと"],[69,1,"き"]],"text":"あなたはこの民のために祈ってはならない。彼らのために嘆き、祈ってはならない。またわたしに、とりなしをしてはならない。わたしはあなたの求めを聞かない。"},{"ref":"Jer.7.17","start":24007017,"end":24007017,"break":"none","ruby":[[4,1,"かれ"],[10,2,"まちまち"],[31,1,"み"]],"text":"あなたは彼らがユダの町々と、エルサレムのちまたでしていることを見ないのか。"},{"ref":"Jer.7.18","start":24007018,"end":24007018,"break":"none","ruby":[[0,1,"こ"],[10,1,"あつ"],[13,1,"ちち"],[17,1,"ひ"],[22,1,"おんな"],[24,1,"こな"],[32,1,"つく"],[38,2,"てんこう"],[41,1,"そな"],[47,1,"かれ"],[50,1,"た"],[52,2,"かみがみ"],[55,1,"まえ"],[57,1,"さけ"],[59,1,"そそ"],[67,1,"いか"]],"text":"子どもらは、たきぎを集め、父たちは火をたき、女は粉をこね、パンを造ってこれを天后に供える。また彼らは他の神々の前に酒を注いで、わたしを怒らせる。"},{"ref":"Jer.7.19","start":24007019,"end":24007019,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"かれ"],[10,1,"いか"],[23,2,"じぶん"],[27,2,"じしん"],[39,1,"みずか"]],"text":"主は言われる、彼らが怒らせるのはわたしなのか。自分たち自身ではないのか。そして自らうろたえている。"},{"ref":"Jer.7.20","start":24007020,"end":24007020,"break":"none","ruby":[[4,1,"しゅ"],[7,1,"かみ"],[11,1,"い"],[16,1,"み"],[23,1,"いか"],[26,1,"いきどお"],[32,1,"ところ"],[35,1,"ひと"],[37,1,"けもの"],[40,1,"はたけ"],[42,1,"き"],[45,1,"ち"],[47,2,"さんぶつ"],[51,1,"そそ"],[54,1,"いか"],[57,1,"も"],[60,1,"き"]],"text":"それゆえ主なる神はこう言われる、見よ、わたしの怒りと憤りを、この所と、人と獣と、畑の木と、地の産物とに注ぐ。怒りは燃えて消えることがない」。"},{"ref":"Jer.7.21","start":24007021,"end":24007021,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[15,1,"い"],[27,2,"ぎせい"],[30,2,"はんさい"],[33,1,"もの"],[35,1,"あ"],[39,1,"にく"],[41,1,"た"]],"text":"万軍の主、イスラエルの神はこう言われる、「あなたがたの犠牲に燔祭の物を合わせて肉を食べるがよい。"},{"ref":"Jer.7.22","start":24007022,"end":24007022,"break":"none","ruby":[[9,2,"せんぞ"],[17,1,"ち"],[20,1,"みちび"],[22,1,"だ"],[25,1,"ひ"],[32,2,"はんさい"],[35,2,"ぎせい"],[42,1,"かれ"],[45,1,"かた"],[56,1,"めい"]],"text":"それはあなたがたの先祖をエジプトの地から導き出した日に、わたしは燔祭と犠牲とについて彼らに語ったこともなく、また命じたこともないからである。"},{"ref":"Jer.7.23","start":24007023,"end":24007023,"break":"none","ruby":[[8,1,"いまし"],[11,1,"かれ"],[14,1,"あた"],[17,1,"い"],[26,1,"こえ"],[28,1,"き"],[54,1,"かみ"],[69,1,"たみ"],[84,1,"めい"],[91,1,"みち"],[93,1,"あゆ"],[96,1,"さいわい"],[98,1,"え"]],"text":"ただわたしはこの戒めを彼らに与えて言った、『わたしの声に聞きしたがいなさい。そうすれば、わたしはあなたがたの神となり、あなたがたはわたしの民となる。わたしがあなたがたに命じるすべての道を歩んで幸を得なさい』と。"},{"ref":"Jer.7.24","start":24007024,"end":24007024,"break":"none","ruby":[[3,1,"かれ"],[6,1,"き"],[8,1,"したが"],[12,1,"みみ"],[14,1,"かたむ"],[18,2,"じぶん"],[21,1,"わる"],[23,1,"こころ"],[25,1,"はか"],[30,2,"ごうじょう"],[38,1,"あゆ"],[41,1,"わる"]],"text":"しかし彼らは聞き従わず、耳を傾けず、自分の悪い心の計りごとと強情にしたがって歩み、悪くなるばかりで、よくはならなかった。"},{"ref":"Jer.7.25","start":24007025,"end":24007025,"break":"none","ruby":[[6,2,"せんぞ"],[14,1,"ち"],[16,1,"で"],[18,1,"ひ"],[21,2,"こんにち"],[40,3,"よげんしゃ"],[46,2,"ひび"],[48,1,"かれ"]],"text":"あなたがたの先祖がエジプトの地を出た日から今日まで、わたしはわたしのしもべである預言者たちを日々彼らにつかわした。"},{"ref":"Jer.7.26","start":24007026,"end":24007026,"break":"none","ruby":[[3,1,"かれ"],[10,1,"き"],[14,1,"みみ"],[16,1,"かたむ"],[21,2,"ごうじょう"],[27,2,"せんぞ"],[37,1,"あく"],[39,1,"おこな"]],"text":"しかし彼らはわたしに聞かず、耳を傾けないで強情になり、先祖たちにもまさって悪を行った。"},{"ref":"Jer.7.27","start":24007027,"end":24007027,"break":"paragraph","ruby":[[7,1,"かれ"],[16,2,"ことば"],[19,1,"かた"],[23,1,"かれ"],[26,1,"き"],[33,1,"かれ"],[36,1,"よ"],[44,1,"こた"]],"text":"たといあなたが彼らにこのすべての言葉を語っても彼らは聞かない。また彼らを呼んでもあなたに答えない。"},{"ref":"Jer.7.28","start":24007028,"end":24007028,"break":"none","ruby":[[11,1,"かれ"],[14,1,"い"],[31,1,"かみ"],[33,1,"しゅ"],[35,1,"こえ"],[37,1,"き"],[39,1,"したが"],[45,1,"いまし"],[48,1,"う"],[56,2,"こくみん"],[62,2,"しんじつ"],[68,1,"かれ"],[71,1,"くち"],[74,1,"た"]],"text":"それゆえ、あなたはこう彼らに言わなければならない、『これはその神、主の声に聞き従わず、その戒めを受けいれなかった国民である。真実はうせ、彼らの口から絶えた。"},{"ref":"Jer.7.29","start":24007029,"end":24007029,"break":"stanza","breaks":[[15,"line"],[30,"line"],[46,"line"]],"ruby":[[4,1,"かみ"],[6,1,"け"],[8,1,"き"],[11,1,"す"],[15,1,"はだか"],[17,1,"やま"],[19,1,"うえ"],[21,1,"なげ"],[24,1,"こえ"],[30,1,"しゅ"],[34,1,"いか"],[42,1,"よ"],[44,1,"ひと"],[46,1,"しりぞ"],[48,1,"す"]],"text":"あなたの髪の毛を切って捨てよ、裸の山の上に嘆きの声をあげよ。主が、お怒りになっている世の人を退け捨てられたからだ』。"},{"ref":"Jer.7.30","start":24007030,"end":24007030,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[10,1,"たみ"],[16,1,"まえ"],[18,1,"あく"],[20,1,"おこな"],[27,1,"な"],[38,1,"いえ"],[41,1,"にく"],[45,1,"もの"],[47,1,"お"],[53,1,"けが"]],"text":"主は言われる、ユダの民はわたしの前に悪を行い、わたしの名をもってとなえられる家に、憎むべき者を置いてそこを汚した。"},{"ref":"Jer.7.31","start":24007031,"end":24007031,"break":"none","ruby":[[9,1,"たに"],[17,1,"たか"],[19,1,"ところ"],[21,1,"きず"],[28,1,"むすめ"],[30,1,"ひ"],[32,1,"や"],[43,1,"めい"],[62,1,"かんが"]],"text":"またベンヒンノムの谷にあるトペテの高き所を築いて、むすこ娘を火に焼いた。わたしはそれを命じたことはなく、またそのようなことを考えたこともなかった。"},{"ref":"Jer.7.32","start":24007032,"end":24007032,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"み"],[17,1,"ところ"],[33,1,"たに"],[35,1,"よ"],[45,1,"たに"],[47,1,"よ"],[49,1,"ひ"],[51,1,"く"],[60,2,"ばしょ"],[72,1,"ほうむ"]],"text":"主は言われる、それゆえに見よ、その所をトペテ、またはベンヒンノムの谷と呼ばないで、ほふりの谷と呼ぶ日が来る。それはほかに場所がないので、トペテに葬るからである。"},{"ref":"Jer.7.33","start":24007033,"end":24007033,"break":"none","ruby":[[2,1,"たみ"],[4,2,"したい"],[7,1,"そら"],[9,1,"とり"],[11,1,"ち"],[13,1,"けもの"],[15,2,"しょくもつ"],[24,1,"お"],[26,1,"はら"],[28,1,"もの"]],"text":"この民の死体は空の鳥と地の獣の食物となり、これを追い払う者もない。"},{"ref":"Jer.7.34","start":24007034,"end":24007034,"break":"none","ruby":[[11,2,"まちまち"],[25,1,"よろこ"],[28,1,"こえ"],[30,1,"たの"],[34,1,"こえ"],[36,2,"はなむこ"],[39,1,"こえ"],[41,2,"はなよめ"],[44,1,"こえ"],[46,1,"た"],[52,1,"ち"],[54,1,"あ"],[56,1,"は"]],"text":"そのときわたしはユダの町々とエルサレムのちまたに、喜びの声、楽しみの声、花婿の声、花嫁の声を絶やす。この地は荒れ果てるからである。"}]