[{"ref":"Ps.95.1","start":19095001,"end":19095001,"break":"paragraph","breaks":[[16,"line"]],"ruby":[[7,1,"しゅ"],[13,1,"うた"],[20,1,"すくい"],[22,1,"いわ"],[28,1,"よろこ"],[32,1,"こえ"]],"text":"さあ、われらは主にむかって歌い、われらの救の岩にむかって喜ばしい声をあげよう。"},{"ref":"Ps.95.2","start":19095002,"end":19095002,"break":"line","breaks":[[17,"line"],[33,"line"]],"ruby":[[4,2,"かんしゃ"],[12,1,"まえ"],[14,1,"い"],[17,1,"しゅ"],[27,1,"うた"],[33,1,"よろこ"],[37,1,"こえ"]],"text":"われらは感謝をもって、み前に行き、主にむかい、さんびの歌をもって、喜ばしい声をあげよう。"},{"ref":"Ps.95.3","start":19095003,"end":19095003,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おお"],[6,1,"かみ"],[12,1,"かみ"],[18,1,"おお"],[22,1,"おう"]],"text":"主は大いなる神、すべての神にまさって大いなる王だからである。"},{"ref":"Ps.95.4","start":19095004,"end":19095004,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ち"],[2,1,"ふか"],[4,1,"ところ"],[6,1,"しゅ"],[9,1,"て"],[14,2,"やまやま"],[17,1,"いただき"],[21,1,"しゅ"]],"text":"地の深い所は主のみ手にあり、山々の頂もまた主のものである。"},{"ref":"Ps.95.5","start":19095005,"end":19095005,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"うみ"],[2,1,"しゅ"],[7,1,"しゅ"],[12,1,"つく"],[22,1,"て"],[28,1,"ち"],[30,1,"つく"]],"text":"海は主のもの、主はこれを造られた。またそのみ手はかわいた地を造られた。"},{"ref":"Ps.95.6","start":19095006,"end":19095006,"break":"line","breaks":[[15,"line"]],"ruby":[[7,1,"おが"],[12,1,"ふ"],[19,1,"つく"],[21,1,"ぬし"],[23,1,"しゅ"],[26,1,"まえ"]],"text":"さあ、われらは拝み、ひれ伏し、われらの造り主、主のみ前にひざまずこう。"},{"ref":"Ps.95.7","start":19095007,"end":19095007,"break":"line","breaks":[[11,"line"],[31,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"かみ"],[17,1,"まき"],[19,1,"たみ"],[24,1,"て"],[26,1,"ひつじ"],[49,1,"こえ"],[51,1,"き"]],"text":"主はわれらの神であり、われらはその牧の民、そのみ手の羊である。どうか、あなたがたは、きょう、そのみ声を聞くように。"},{"ref":"Ps.95.8","start":19095008,"end":19095008,"break":"line","breaks":[[19,"line"],[36,"line"]],"ruby":[[13,1,"とき"],[21,2,"あらの"],[30,1,"ひ"],[36,1,"こころ"]],"text":"あなたがたは、メリバにいた時のように、また荒野のマッサにいた日のように、心をかたくなにしてはならない。"},{"ref":"Ps.95.9","start":19095009,"end":19095009,"break":"line","breaks":[[15,"line"],[32,"line"]],"ruby":[[2,1,"とき"],[10,2,"せんぞ"],[22,1,"み"],[36,1,"こころ"]],"text":"あの時、あなたがたの先祖たちはわたしのわざを見たにもかかわらず、わたしを試み、わたしをためした。"},{"ref":"Ps.95.10","start":19095010,"end":19095010,"break":"line","breaks":[[22,"line"],[39,"line"]],"ruby":[[6,1,"ねん"],[8,1,"あいだ"],[12,1,"よ"],[18,1,"い"],[23,1,"かれ"],[26,1,"こころ"],[28,1,"あやま"],[33,1,"たみ"],[43,1,"みち"],[45,1,"し"]],"text":"わたしは四十年の間、その代をきらって言った、「彼らは心の誤っている民であって、わたしの道を知らない」と。"},{"ref":"Ps.95.11","start":19095011,"end":19095011,"break":"line","breaks":[[13,"line"]],"ruby":[[9,1,"いきどお"],[13,1,"かれ"],[18,2,"あんそく"],[21,1,"い"],[31,1,"ちか"]],"text":"それゆえ、わたしは憤って、彼らはわが安息に入ることができないと誓った。"}]