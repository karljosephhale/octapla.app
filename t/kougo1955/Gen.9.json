[{"ref":"Gen.9.1","start":1009001,"end":1009001,"break":"paragraph","ruby":[[0,1,"かみ"],[7,1,"こ"],[11,2,"しゅくふく"],[15,1,"かれ"],[18,1,"い"],[24,1,"う"],[32,1,"ち"],[34,1,"み"]],"text":"神はノアとその子らとを祝福して彼らに言われた、「生めよ、ふえよ、地に満ちよ。"},{"ref":"Gen.9.2","start":1009002,"end":1009002,"break":"none","ruby":[[0,1,"ち"],[6,1,"けもの"],[8,1,"そら"],[14,1,"とり"],[16,1,"ち"],[18,1,"は"],[27,1,"うみ"],[33,1,"うお"],[35,1,"おそ"],[49,2,"しはい"],[52,1,"ふく"]],"text":"地のすべての獣、空のすべての鳥、地に這うすべてのもの、海のすべての魚は恐れおののいて、あなたがたの支配に服し、"},{"ref":"Gen.9.3","start":1009003,"end":1009003,"break":"none","ruby":[[3,1,"い"],[6,1,"うご"],[17,2,"しょくもつ"],[30,2,"あおくさ"],[39,1,"あた"],[57,1,"みな"],[64,1,"あた"]],"text":"すべて生きて動くものはあなたがたの食物となるであろう。さきに青草をあなたがたに与えたように、わたしはこれらのものを皆あなたがたに与える。"},{"ref":"Gen.9.4","start":1009004,"end":1009004,"break":"none","ruby":[[3,1,"にく"],[8,1,"いのち"],[12,1,"ち"],[18,1,"た"]],"text":"しかし肉を、その命である血のままで、食べてはならない。"},{"ref":"Gen.9.5","start":1009005,"end":1009005,"break":"none","ruby":[[6,1,"いのち"],[8,1,"ち"],[10,1,"なが"],[21,1,"かなら"],[23,2,"ほうふく"],[36,1,"けもの"],[39,2,"ほうふく"],[44,2,"きょうだい"],[49,1,"ひと"],[57,1,"ひと"],[59,1,"いのち"],[65,2,"ほうふく"]],"text":"あなたがたの命の血を流すものには、わたしは必ず報復するであろう。いかなる獣にも報復する。兄弟である人にも、わたしは人の命のために、報復するであろう。"},{"ref":"Gen.9.6","start":1009006,"end":1009006,"break":"stanza","breaks":[[19,"line"]],"ruby":[[0,1,"ひと"],[2,1,"ち"],[4,1,"なが"],[10,1,"ひと"],[12,1,"ち"],[14,1,"なが"],[19,1,"かみ"],[21,2,"じぶん"],[28,1,"ひと"],[30,1,"つく"]],"text":"人の血を流すものは、人に血を流される、神が自分のかたちに人を造られたゆえに。"},{"ref":"Gen.9.7","start":1009007,"end":1009007,"break":"line","breaks":[[15,"line"]],"ruby":[[7,1,"う"],[15,1,"ち"],[17,1,"むら"],[21,1,"ち"],[23,1,"うえ"]],"text":"あなたがたは、生めよ、ふえよ、地に群がり、地の上にふえよ」。"},{"ref":"Gen.9.8","start":1009008,"end":1009008,"break":"paragraph","ruby":[[0,1,"かみ"],[7,1,"とも"],[11,1,"こ"],[14,1,"い"]],"text":"神はノアおよび共にいる子らに言われた、"},{"ref":"Gen.9.9","start":1009009,"end":1009009,"break":"none","ruby":[[10,1,"およ"],[18,1,"のち"],[20,2,"しそん"],[23,2,"けいやく"],[26,1,"た"]],"text":"「わたしはあなたがた及びあなたがたの後の子孫と契約を立てる。"},{"ref":"Gen.9.10","start":1009010,"end":1009010,"break":"none","ruby":[[8,1,"とも"],[16,1,"い"],[18,1,"もの"],[26,1,"とも"],[30,1,"とり"],[32,2,"かちく"],[35,1,"ち"],[41,1,"けもの"],[51,2,"はこぶね"],[55,1,"で"],[61,1,"ち"],[67,1,"けもの"],[82,2,"けいやく"],[85,1,"た"]],"text":"またあなたがたと共にいるすべての生き物、あなたがたと共にいる鳥、家畜、地のすべての獣、すなわち、すべて箱舟から出たものは、地のすべての獣にいたるまで、わたしはそれと契約を立てよう。"},{"ref":"Gen.9.11","start":1009011,"end":1009011,"break":"none","ruby":[[10,1,"た"],[15,2,"けいやく"],[24,1,"にく"],[27,1,"もの"],[33,2,"こうずい"],[39,1,"ほろ"],[52,1,"ち"],[54,1,"ほろ"],[57,2,"こうずい"],[61,1,"ふたた"],[63,1,"おこ"]],"text":"わたしがあなたがたと立てるこの契約により、すべて肉なる者は、もはや洪水によって滅ぼされることはなく、また地を滅ぼす洪水は、再び起らないであろう」。"},{"ref":"Gen.9.12","start":1009012,"end":1009012,"break":"none","ruby":[[3,1,"かみ"],[5,1,"い"],[24,1,"およ"],[32,1,"とも"],[40,1,"い"],[42,1,"もの"],[45,1,"あいだ"],[47,2,"よよ"],[59,1,"た"],[62,2,"けいやく"]],"text":"さらに神は言われた、「これはわたしと、あなたがた及びあなたがたと共にいるすべての生き物との間に代々かぎりなく、わたしが立てる契約のしるしである。"},{"ref":"Gen.9.13","start":1009013,"end":1009013,"break":"none","ruby":[[9,1,"くも"],[11,1,"なか"],[17,1,"お"],[27,1,"ち"],[30,1,"あいだ"],[32,2,"けいやく"]],"text":"すなわち、わたしは雲の中に、にじを置く。これがわたしと地との間の契約のしるしとなる。"},{"ref":"Gen.9.14","start":1009014,"end":1009014,"break":"none","ruby":[[4,1,"くも"],[6,1,"ち"],[8,1,"うえ"],[10,1,"おこ"],[18,1,"くも"],[20,1,"なか"],[22,1,"あらわ"]],"text":"わたしが雲を地の上に起すとき、にじは雲の中に現れる。"},{"ref":"Gen.9.15","start":1009015,"end":1009015,"break":"none","ruby":[[20,1,"およ"],[25,1,"にく"],[32,1,"い"],[34,1,"もの"],[37,1,"あいだ"],[39,1,"た"],[42,2,"けいやく"],[45,1,"おも"],[53,1,"みず"],[63,1,"にく"],[66,1,"もの"],[68,1,"ほろ"],[71,2,"こうずい"]],"text":"こうして、わたしは、わたしとあなたがた、及びすべて肉なるあらゆる生き物との間に立てた契約を思いおこすゆえ、水はふたたび、すべて肉なる者を滅ぼす洪水とはならない。"},{"ref":"Gen.9.16","start":1009016,"end":1009016,"break":"none","ruby":[[3,1,"くも"],[5,1,"なか"],[7,1,"あらわ"],[20,1,"み"],[23,1,"かみ"],[25,2,"ちじょう"],[33,1,"にく"],[40,1,"い"],[42,1,"もの"],[45,1,"あいだ"],[47,1,"た"],[50,2,"えいえん"],[53,2,"けいやく"],[56,1,"おも"]],"text":"にじが雲の中に現れるとき、わたしはこれを見て、神が地上にあるすべて肉なるあらゆる生き物との間に立てた永遠の契約を思いおこすであろう」。"},{"ref":"Gen.9.17","start":1009017,"end":1009017,"break":"none","ruby":[[3,1,"かみ"],[8,1,"い"],[21,1,"ち"],[28,1,"にく"],[35,1,"あいだ"],[42,1,"た"],[45,2,"けいやく"]],"text":"そして神はノアに言われた、「これがわたしと地にあるすべて肉なるものとの間に、わたしが立てた契約のしるしである」。"},{"ref":"Gen.9.18","start":1009018,"end":1009018,"break":"paragraph","ruby":[[0,2,"はこぶね"],[4,1,"で"],[9,1,"こ"],[33,1,"ちち"]],"text":"箱舟から出たノアの子らはセム、ハム、ヤペテであった。ハムはカナンの父である。"},{"ref":"Gen.9.19","start":1009019,"end":1009019,"break":"none","ruby":[[3,1,"にん"],[8,1,"こ"],[12,1,"ぜん"],[13,1,"ち"],[15,1,"たみ"],[17,1,"かれ"],[21,1,"で"],[24,1,"ひろ"]],"text":"この三人はノアの子らで、全地の民は彼らから出て、広がったのである。"},{"ref":"Gen.9.20","start":1009020,"end":1009020,"break":"paragraph","ruby":[[5,2,"のうふ"],[14,1,"はたけ"],[19,1,"はじ"]],"text":"さてノアは農夫となり、ぶどう畑をつくり始めたが、"},{"ref":"Gen.9.21","start":1009021,"end":1009021,"break":"none","ruby":[[0,1,"かれ"],[5,1,"しゅ"],[7,1,"の"],[10,1,"よ"],[13,2,"てんまく"],[16,1,"なか"],[18,1,"はだか"]],"text":"彼はぶどう酒を飲んで酔い、天幕の中で裸になっていた。"},{"ref":"Gen.9.22","start":1009022,"end":1009022,"break":"none","ruby":[[4,1,"ちち"],[8,1,"ちち"],[10,1,"はだか"],[12,1,"み"],[15,1,"そと"],[23,2,"きょうだい"],[26,1,"つ"]],"text":"カナンの父ハムは父の裸を見て、外にいるふたりの兄弟に告げた。"},{"ref":"Gen.9.23","start":1009023,"end":1009023,"break":"none","ruby":[[8,2,"きもの"],[11,1,"と"],[15,1,"かた"],[23,1,"む"],[26,1,"あゆ"],[28,1,"よ"],[32,1,"ちち"],[34,1,"はだか"],[40,1,"かお"],[46,1,"ちち"],[48,1,"はだか"],[50,1,"み"]],"text":"セムとヤペテとは着物を取って、肩にかけ、うしろ向きに歩み寄って、父の裸をおおい、顔をそむけて父の裸を見なかった。"},{"ref":"Gen.9.24","start":1009024,"end":1009024,"break":"none","ruby":[[6,1,"よ"],[13,1,"すえ"],[15,1,"こ"],[17,1,"かれ"],[21,1,"こと"],[23,1,"し"]],"text":"やがてノアは酔いがさめて、末の子が彼にした事を知ったとき、"},{"ref":"Gen.9.25","start":1009025,"end":1009025,"break":"none","breaks":[[6,"stanza"],[17,"line"],[31,"line"]],"ruby":[[0,1,"かれ"],[2,1,"い"],[17,1,"かれ"],[33,2,"きょうだい"],[38,1,"つか"]],"text":"彼は言った、「カナンはのろわれよ。彼はしもべのしもべとなって、その兄弟たちに仕える」。"},{"ref":"Gen.9.26","start":1009026,"end":1009026,"break":"none","breaks":[[6,"stanza"],[21,"line"]],"ruby":[[2,1,"い"],[10,1,"かみ"],[12,1,"しゅ"]],"text":"また言った、「セムの神、主はほむべきかな、カナンはそのしもべとなれ。"},{"ref":"Gen.9.27","start":1009027,"end":1009027,"break":"line","breaks":[[13,"line"],[32,"line"]],"ruby":[[0,1,"かみ"],[6,1,"おお"],[16,2,"てんまく"],[19,1,"かれ"],[21,1,"す"]],"text":"神はヤペテを大いならしめ、セムの天幕に彼を住まわせられるように。カナンはそのしもべとなれ」。"},{"ref":"Gen.9.28","start":1009028,"end":1009028,"break":"paragraph","ruby":[[3,2,"こうずい"],[6,1,"のち"],[14,1,"ねん"],[15,1,"い"]],"text":"ノアは洪水の後、なお三百五十年生きた。"},{"ref":"Gen.9.29","start":1009029,"end":1009029,"break":"none","ruby":[[3,1,"とし"],[5,1,"あ"],[13,1,"さい"],[22,1,"かれ"],[24,1,"し"]],"text":"ノアの年は合わせて九百五十歳であった。そして彼は死んだ。"}]