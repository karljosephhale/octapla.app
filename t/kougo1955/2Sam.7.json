[{"ref":"2Sam.7.1","start":10007001,"end":10007001,"break":"paragraph","ruby":[[3,1,"おう"],[5,2,"じぶん"],[8,1,"いえ"],[10,1,"す"],[15,1,"しゅ"],[17,2,"しゅうい"],[20,1,"てき"],[27,1,"う"],[29,1,"しりぞ"],[32,1,"かれ"],[34,2,"あんそく"],[37,1,"たま"],[41,1,"とき"]],"text":"さて、王が自分の家に住み、また主が周囲の敵をことごとく打ち退けて彼に安息を賜わった時、"},{"ref":"2Sam.7.2","start":10007002,"end":10007002,"break":"none","ruby":[[0,1,"おう"],[2,3,"よげんしゃ"],[9,1,"い"],[14,1,"み"],[17,1,"いま"],[23,2,"こうはく"],[26,1,"いえ"],[28,1,"す"],[35,1,"かみ"],[37,1,"はこ"],[41,2,"まくや"]],"text":"王は預言者ナタンに言った、「見よ、今わたしは、香柏の家に住んでいるが、神の箱はなお幕屋のうちにある」。"},{"ref":"2Sam.7.3","start":10007003,"end":10007003,"break":"none","ruby":[[4,1,"おう"],[6,1,"い"],[11,1,"しゅ"],[17,1,"とも"],[27,1,"い"],[38,1,"こころ"],[46,1,"おこな"]],"text":"ナタンは王に言った、「主があなたと共におられますから、行って、すべてあなたの心にあるところを行いなさい」。"},{"ref":"2Sam.7.4","start":10007004,"end":10007004,"break":"paragraph","ruby":[[2,1,"よ"],[4,1,"しゅ"],[6,2,"ことば"],[13,1,"のぞ"],[16,1,"い"]],"text":"その夜、主の言葉がナタンに臨んで言った、"},{"ref":"2Sam.7.5","start":10007005,"end":10007005,"break":"none","ruby":[[1,1,"い"],[16,1,"い"],[23,1,"しゅ"],[27,1,"おお"],[41,1,"す"],[43,1,"いえ"],[45,1,"た"]],"text":"「行って、わたしのしもべダビデに言いなさい、『主はこう仰せられる。あなたはわたしの住む家を建てようとするのか。"},{"ref":"2Sam.7.6","start":10007006,"end":10007006,"break":"none","ruby":[[10,2,"ひとびと"],[19,1,"みちび"],[21,1,"だ"],[24,1,"ひ"],[27,2,"こんにち"],[32,1,"いえ"],[34,1,"す"],[39,2,"てんまく"],[48,1,"あゆ"]],"text":"わたしはイスラエルの人々をエジプトから導き出した日から今日まで、家に住まわず、天幕をすまいとして歩んできた。"},{"ref":"2Sam.7.7","start":10007007,"end":10007007,"break":"none","ruby":[[14,2,"ひとびと"],[17,1,"とも"],[19,1,"あゆ"],[26,1,"ところ"],[37,1,"たみ"],[44,1,"ぼく"],[50,1,"めい"],[73,1,"こと"],[94,2,"こうはく"],[97,1,"いえ"],[99,1,"た"],[108,1,"い"]],"text":"わたしがイスラエルのすべての人々と共に歩んだすべての所で、わたしがわたしの民イスラエルを牧することを命じたイスラエルのさばきづかさのひとりに、ひと言でも「どうしてあなたがたはわたしのために香柏の家を建てないのか」と、言ったことがあるであろうか』。"},{"ref":"2Sam.7.8","start":10007008,"end":10007008,"break":"none","ruby":[[5,1,"いま"],[24,1,"い"],[31,2,"ばんぐん"],[34,1,"しゅ"],[38,1,"おお"],[52,2,"まきば"],[57,1,"ひつじ"],[59,1,"したが"],[64,1,"ところ"],[67,1,"と"],[75,1,"たみ"],[82,1,"きみ"]],"text":"それゆえ、今あなたは、わたしのしもべダビデにこう言いなさい、『万軍の主はこう仰せられる。わたしはあなたを牧場から、羊に従っている所から取って、わたしの民イスラエルの君とし、"},{"ref":"2Sam.7.9","start":10007009,"end":10007009,"break":"none","ruby":[[7,1,"い"],[16,1,"とも"],[29,1,"てき"],[35,1,"まえ"],[38,1,"た"],[40,1,"さ"],[50,2,"ちじょう"],[53,1,"おお"],[57,1,"もの"],[59,1,"な"],[64,1,"おお"],[68,1,"な"],[74,1,"え"]],"text":"あなたがどこへ行くにも、あなたと共におり、あなたのすべての敵をあなたの前から断ち去った。わたしはまた地上の大いなる者の名のような大いなる名をあなたに得させよう。"},{"ref":"2Sam.7.10","start":10007010,"end":10007010,"break":"none","ruby":[[7,1,"たみ"],[20,1,"ところ"],[22,1,"さだ"],[26,1,"かれ"],[29,1,"う"],[34,1,"かれ"],[37,2,"じぶん"],[40,1,"ところ"],[42,1,"す"],[46,1,"かさ"],[49,1,"うご"]],"text":"そしてわたしの民イスラエルのために一つの所を定めて、彼らを植えつけ、彼らを自分の所に住ませ、重ねて動くことのないようにするであろう。"},{"ref":"2Sam.7.11","start":10007011,"end":10007011,"break":"none","ruby":[[2,1,"まえ"],[16,1,"たみ"],[23,1,"うえ"],[32,1,"た"],[35,1,"ひ"],[47,2,"あくにん"],[50,1,"かさ"],[56,1,"なや"],[78,1,"てき"],[80,1,"う"],[82,1,"しりぞ"],[90,2,"あんそく"],[93,1,"あた"],[101,1,"しゅ"],[113,1,"いえ"],[115,1,"つく"],[119,1,"おお"]],"text":"また前のように、わたしがわたしの民イスラエルの上にさばきづかさを立てた日からこのかたのように、悪人が重ねてこれを悩ますことはない。わたしはあなたのもろもろの敵を打ち退けて、あなたに安息を与えるであろう。主はまた「あなたのために家を造る」と仰せられる。"},{"ref":"2Sam.7.12","start":10007012,"end":10007012,"break":"none","ruby":[[4,1,"ひ"],[6,1,"み"],[10,2,"せんぞ"],[15,1,"とも"],[17,1,"ねむ"],[19,1,"とき"],[29,1,"み"],[32,1,"で"],[34,1,"こ"],[44,1,"た"],[50,2,"おうこく"],[53,1,"かた"]],"text":"あなたが日が満ちて、先祖たちと共に眠る時、わたしはあなたの身から出る子を、あなたのあとに立てて、その王国を堅くするであろう。"},{"ref":"2Sam.7.13","start":10007013,"end":10007013,"break":"none","ruby":[[0,1,"かれ"],[6,1,"な"],[11,1,"いえ"],[13,1,"た"],[21,1,"なが"],[25,1,"くに"],[27,1,"くらい"],[29,1,"かた"]],"text":"彼はわたしの名のために家を建てる。わたしは長くその国の位を堅くしよう。"},{"ref":"2Sam.7.14","start":10007014,"end":10007014,"break":"none","ruby":[[4,1,"かれ"],[6,1,"ちち"],[11,1,"かれ"],[17,1,"こ"],[28,1,"かれ"],[30,1,"つみ"],[32,1,"おか"],[42,1,"ひと"],[47,1,"ひと"],[49,1,"こ"],[57,1,"かれ"],[59,1,"こ"]],"text":"わたしは彼の父となり、彼はわたしの子となるであろう。もし彼が罪を犯すならば、わたしは人のつえと人の子のむちをもって彼を懲らす。"},{"ref":"2Sam.7.15","start":10007015,"end":10007015,"break":"none","ruby":[[26,1,"まえ"],[29,1,"のぞ"],[37,1,"と"],[39,1,"さ"],[46,1,"かれ"],[50,1,"と"],[52,1,"さ"]],"text":"しかしわたしはわたしのいつくしみを、わたしがあなたの前から除いたサウルから取り去ったように、彼からは取り去らない。"},{"ref":"2Sam.7.16","start":10007016,"end":10007016,"break":"none","ruby":[[4,1,"いえ"],[6,2,"おうこく"],[13,1,"まえ"],[15,1,"なが"],[17,1,"たも"],[28,1,"くらい"],[30,1,"なが"],[32,1,"かと"]],"text":"あなたの家と王国はわたしの前に長く保つであろう。あなたの位は長く堅うせられる』」。"},{"ref":"2Sam.7.17","start":10007017,"end":10007017,"break":"none","ruby":[[11,2,"ことば"],[25,1,"まぼろし"],[34,1,"かた"]],"text":"ナタンはすべてこれらの言葉のように、またすべてこの幻のようにダビデに語った。"},{"ref":"2Sam.7.18","start":10007018,"end":10007018,"break":"paragraph","ruby":[[2,1,"とき"],[6,1,"おう"],[13,1,"しゅ"],[15,1,"まえ"],[17,1,"ざ"],[20,1,"い"],[25,1,"しゅ"],[28,1,"かみ"],[42,1,"いえ"],[44,1,"なに"],[63,1,"みちび"]],"text":"その時ダビデ王は、はいって主の前に座して言った、「主なる神よ、わたしがだれ、わたしの家が何であるので、あなたはこれまでわたしを導かれたのですか。"},{"ref":"2Sam.7.19","start":10007019,"end":10007019,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[15,1,"め"],[18,1,"ちい"],[21,1,"こと"],[25,1,"しゅ"],[28,1,"かみ"],[41,1,"いえ"],[47,1,"のち"],[49,1,"こと"],[51,1,"かた"],[60,2,"よよ"],[66,1,"しめ"]],"text":"主なる神よ、これはなおあなたの目には小さい事です。主なる神よ、あなたはまたしもべの家の、はるか後の事を語って、きたるべき代々のことを示されました。"},{"ref":"2Sam.7.20","start":10007020,"end":10007020,"break":"none","ruby":[[6,1,"うえ"],[14,1,"もう"],[29,1,"しゅ"],[32,1,"かみ"],[43,1,"し"]],"text":"ダビデはこの上なにをあなたに申しあげることができましょう。主なる神よ、あなたはしもべを知っておられるのです。"},{"ref":"2Sam.7.21","start":10007021,"end":10007021,"break":"none","ruby":[[4,2,"やくそく"],[17,1,"こころ"],[19,1,"したが"],[34,1,"おお"],[38,1,"こと"],[40,1,"おこな"],[50,1,"し"]],"text":"あなたの約束のゆえに、またあなたの心に従って、あなたはこのもろもろの大いなる事を行い、しもべにそれを知らせられました。"},{"ref":"2Sam.7.22","start":10007022,"end":10007022,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[10,2,"いだい"],[27,1,"みみ"],[29,1,"き"],[47,1,"もの"],[61,1,"かみ"]],"text":"主なる神よ、あなたは偉大です。それは、われわれがすべて耳に聞いたところによれば、あなたのような者はなく、またあなたのほかに神はないからです。"},{"ref":"2Sam.7.23","start":10007023,"end":10007023,"break":"none","ruby":[[0,1,"ち"],[4,2,"こくみん"],[12,1,"たみ"],[33,1,"かみ"],[35,1,"い"],[39,2,"じぶん"],[50,1,"たみ"],[54,1,"みずか"],[57,1,"な"],[69,1,"かれ"],[75,1,"おお"],[79,1,"おそ"],[91,1,"たみ"],[93,1,"まえ"],[96,1,"くに"],[102,2,"かみがみ"],[106,1,"お"],[108,1,"だ"]],"text":"地のどの国民が、あなたの民イスラエルのようでありましょうか。これは神が行って、自分のためにあがなって民とし、自らの名をあげられたもの、また彼らのために大いなる恐るべきことをなし、その民の前から国びととその神々とを追い出されたものです。"},{"ref":"2Sam.7.24","start":10007024,"end":10007024,"break":"none","ruby":[[7,1,"たみ"],[14,2,"えいえん"],[21,1,"たみ"],[26,2,"じぶん"],[33,1,"さだ"],[41,1,"しゅ"],[48,1,"かれ"],[51,1,"かみ"]],"text":"そしてあなたの民イスラエルを永遠にあなたの民として、自分のために、定められました。主よ、あなたは彼らの神となられたのです。"},{"ref":"2Sam.7.25","start":10007025,"end":10007025,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[6,1,"いま"],[20,1,"いえ"],[26,1,"かた"],[30,2,"ことば"],[33,1,"なが"],[35,1,"かと"],[44,1,"い"]],"text":"主なる神よ、今あなたが、しもべとしもべの家とについて語られた言葉を長く堅うして、あなたの言われたとおりにしてください。"},{"ref":"2Sam.7.26","start":10007026,"end":10007026,"break":"none","ruby":[[10,1,"な"],[25,2,"ばんぐん"],[28,1,"しゅ"],[36,1,"かみ"],[42,1,"い"],[57,1,"いえ"],[64,1,"まえ"],[66,1,"かた"],[68,1,"た"]],"text":"そうすれば、あなたの名はとこしえにあがめられて、『万軍の主はイスラエルの神である』と言われ、あなたのしもべダビデの家は、あなたの前に堅く立つことができましょう。"},{"ref":"2Sam.7.27","start":10007027,"end":10007027,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[11,1,"かみ"],[22,1,"しめ"],[34,1,"いえ"],[36,1,"た"],[42,1,"い"],[60,1,"いのり"],[70,2,"ゆうき"],[73,1,"え"]],"text":"万軍の主、イスラエルの神よ、あなたはしもべに示して、『おまえのために家を建てよう』と言われました。それゆえ、しもべはこの祈をあなたにささげる勇気を得たのです。"},{"ref":"2Sam.7.28","start":10007028,"end":10007028,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[10,1,"かみ"],[21,2,"ことば"],[24,2,"しんじつ"],[35,1,"よ"],[37,1,"こと"],[43,2,"やくそく"]],"text":"主なる神よ、あなたは神にましまし、あなたの言葉は真実です。あなたはこの良き事をしもべに約束されました。"},{"ref":"2Sam.7.29","start":10007029,"end":10007029,"break":"none","ruby":[[3,1,"いま"],[9,1,"いえ"],[11,2,"しゅくふく"],[19,1,"まえ"],[21,1,"なが"],[36,1,"しゅ"],[39,1,"かみ"],[49,1,"い"],[64,2,"しゅくふく"],[75,1,"いえ"],[80,2,"しゅくふく"]],"text":"どうぞ今、しもべの家を祝福し、あなたの前に長くつづかせてくださるように。主なる神よ、あなたがそれを言われたのです。どうぞあなたの祝福によって、しもべの家がながく祝福されますように」。"}]