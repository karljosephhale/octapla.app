[{"ref":"Deut.26.1","start":5026001,"end":5026001,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"し"],[9,1,"ぎょう"],[13,1,"たま"],[16,1,"くに"],[26,2,"しょゆう"],[33,1,"す"],[35,1,"とき"]],"text":"あなたの神、主が嗣業として賜わる国にはいって、それを所有し、そこに住む時は、"},{"ref":"Deut.26.2","start":5026002,"end":5026002,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"たま"],[11,1,"くに"],[17,1,"ち"],[23,1,"み"],[25,2,"はつもの"],[28,1,"と"],[34,1,"い"],[41,1,"かみ"],[43,1,"しゅ"],[47,1,"な"],[49,1,"お"],[54,1,"えら"],[58,1,"ところ"],[60,1,"たずさ"],[63,1,"い"]],"text":"あなたの神、主が賜わる国にできる、地のすべての実の初物を取ってかごに入れ、あなたの神、主がその名を置くために選ばれる所へ携えて行かなければならない。"},{"ref":"Deut.26.3","start":5026003,"end":5026003,"break":"none","ruby":[[5,1,"とき"],[7,2,"さいし"],[10,1,"ところ"],[12,1,"い"],[15,1,"かれ"],[17,1,"い"],[37,1,"かみ"],[39,1,"しゅ"],[45,1,"もう"],[50,1,"しゅ"],[57,1,"あた"],[61,2,"せんぞ"],[66,1,"ちか"],[70,1,"くに"]],"text":"そしてその時の祭司の所へ行って彼に言わなければならない、『きょう、あなたの神、主にわたしは申します。主がわれわれに与えると先祖たちに誓われた国に、わたしははいることができました』。"},{"ref":"Deut.26.4","start":5026004,"end":5026004,"break":"none","ruby":[[4,2,"さいし"],[11,1,"て"],[19,1,"う"],[21,1,"と"],[28,1,"かみ"],[30,1,"しゅ"],[32,2,"さいだん"],[35,1,"まえ"],[37,1,"お"]],"text":"そのとき祭司はあなたの手からそのかごを受け取ってあなたの神、主の祭壇の前に置かなければならない。"},{"ref":"Deut.26.5","start":5026005,"end":5026005,"break":"paragraph","ruby":[[12,1,"かみ"],[14,1,"しゅ"],[16,1,"まえ"],[18,1,"の"],[21,1,"い"],[37,2,"せんぞ"],[64,1,"ひと"],[66,1,"つ"],[74,1,"くだ"],[77,1,"い"],[83,1,"ところ"],[85,2,"きりゅう"],[95,1,"おお"],[99,1,"つよ"],[102,2,"にんずう"],[105,1,"おお"],[107,2,"こくみん"]],"text":"そして、あなたはあなたの神、主の前に述べて言わなければならない、『わたしの先祖は、さすらいの一アラムびとでありましたが、わずかの人を連れてエジプトへ下って行って、その所に寄留し、ついにそこで大きく、強い、人数の多い国民になりました。"},{"ref":"Deut.26.6","start":5026006,"end":5026006,"break":"none","ruby":[[23,1,"なや"],[31,2,"ろうえき"],[34,1,"お"]],"text":"ところがエジプトびとはわれわれをしえたげ、また悩まして、つらい労役を負わせましたが、"},{"ref":"Deut.26.7","start":5026007,"end":5026007,"break":"none","ruby":[[5,2,"せんぞ"],[10,1,"かみ"],[12,1,"しゅ"],[14,1,"さけ"],[20,1,"しゅ"],[27,1,"こえ"],[29,1,"き"],[37,1,"なや"],[41,2,"ほねお"],[52,1,"かえり"]],"text":"われわれが先祖たちの神、主に叫んだので、主はわれわれの声を聞き、われわれの悩みと、骨折りと、しえたげとを顧み、"},{"ref":"Deut.26.8","start":5026008,"end":5026008,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つよ"],[4,1,"て"],[7,1,"の"],[10,1,"うで"],[13,1,"おお"],[17,1,"おそ"],[21,1,"こと"],[29,3,"ふしぎ"],[49,1,"みちび"],[51,1,"だ"]],"text":"主は強い手と、伸べた腕と、大いなる恐るべき事と、しるしと、不思議とをもって、われわれをエジプトから導き出し、"},{"ref":"Deut.26.9","start":5026009,"end":5026009,"break":"none","ruby":[[7,1,"ところ"],[9,1,"つ"],[15,1,"ちち"],[17,1,"みつ"],[19,1,"なが"],[24,1,"ち"],[31,1,"たま"]],"text":"われわれをこの所へ連れてきて、乳と蜜の流れるこの地をわれわれに賜わりました。"},{"ref":"Deut.26.10","start":5026010,"end":5026010,"break":"none","ruby":[[0,1,"しゅ"],[19,1,"たま"],[23,1,"ち"],[25,1,"み"],[27,2,"はつもの"],[33,1,"たずさ"],[56,1,"かみ"],[58,1,"しゅ"],[60,1,"まえ"],[62,1,"お"],[70,1,"かみ"],[72,1,"しゅ"],[74,1,"まえ"],[76,2,"れいはい"]],"text":"主よ、ごらんください。あなたがわたしに賜わった地の実の初物を、いま携えてきました』。そしてあなたはそれをあなたの神、主の前に置いて、あなたの神、主の前に礼拝し、"},{"ref":"Deut.26.11","start":5026011,"end":5026011,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[16,1,"いえ"],[19,1,"たま"],[27,1,"よ"],[29,1,"もの"],[51,2,"きりゅう"],[54,2,"たこく"],[56,1,"じん"],[58,1,"とも"],[60,1,"よろこ"],[62,1,"たの"]],"text":"あなたの神、主があなたとあなたの家とに賜わったすべての良い物をもって、レビびとおよびあなたのなかにいる寄留の他国人と共に喜び楽しまなければならない。"},{"ref":"Deut.26.12","start":5026012,"end":5026012,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"ねん"],[8,1,"ぶん"],[12,1,"おさ"],[15,1,"とし"],[26,2,"さんぶつ"],[30,1,"ぶん"],[34,1,"おさ"],[36,1,"おわ"],[48,2,"きりゅう"],[51,2,"たこく"],[53,1,"じん"],[55,2,"こじ"],[58,2,"かふ"],[62,1,"あた"],[65,1,"まち"],[70,1,"かれ"],[73,1,"あ"],[78,1,"た"],[83,1,"とき"]],"text":"第三年すなわち十分の一を納める年に、あなたがすべての産物の十分の一を納め終って、それをレビびとと寄留の他国人と孤児と寡婦とに与え、町のうちで彼らに飽きるほど食べさせた時、"},{"ref":"Deut.26.13","start":5026013,"end":5026013,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"まえ"],[10,1,"い"],[28,1,"せい"],[31,1,"もの"],[33,1,"いえ"],[36,1,"と"],[38,1,"だ"],[48,2,"きりゅう"],[51,2,"たこく"],[53,1,"じん"],[55,2,"こじ"],[58,2,"かふ"],[65,1,"あた"],[75,1,"めい"],[80,2,"めいれい"],[102,2,"めいれい"],[115,1,"わす"]],"text":"あなたの神、主の前で言わなければならない、『わたしはその聖なる物を家から取り出し、またレビびとと寄留の他国人と孤児と寡婦とにそれを与え、すべてあなたが命じられた命令のとおりにいたしました。わたしはあなたの命令にそむかず、またそれを忘れませんでした。"},{"ref":"Deut.26.14","start":5026014,"end":5026014,"break":"none","ruby":[[6,1,"せい"],[9,1,"もの"],[11,1,"も"],[16,1,"た"],[27,1,"けが"],[30,1,"み"],[35,1,"と"],[37,1,"だ"],[48,2,"しにん"],[54,1,"そな"],[77,1,"かみ"],[79,1,"しゅ"],[81,1,"こえ"],[83,1,"き"],[85,1,"したが"],[99,1,"めい"]],"text":"わたしはその聖なる物を喪のうちで食べたことがなく、また汚れた身でそれを取り出したことがなく、また死人にそれを供えたことがありませんでした。わたしはわたしの神、主の声に聞き従い、すべてあなたがわたしに命じられたとおりにいたしました。"},{"ref":"Deut.26.15","start":5026015,"end":5026015,"break":"none","ruby":[[4,1,"せい"],[13,1,"てん"],[27,1,"たみ"],[44,1,"あた"],[49,1,"ち"],[52,2,"しゅくふく"],[73,2,"せんぞ"],[76,1,"ちか"],[80,1,"ちち"],[82,1,"みつ"],[84,1,"なが"],[87,1,"ち"]],"text":"あなたの聖なるすみかである天からみそなわして、あなたの民イスラエルと、あなたがわれわれに与えられた地とを祝福してください。これはあなたがわれわれの先祖に誓われた乳と蜜の流れる地です』。"},{"ref":"Deut.26.16","start":5026016,"end":5026016,"break":"paragraph","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[16,1,"さだ"],[25,1,"おこな"],[34,1,"めい"],[49,1,"こころ"],[55,2,"せいしん"],[65,1,"まも"],[67,1,"おこな"]],"text":"きょう、あなたの神、主はこれらの定めと、おきてとを行うことをあなたに命じられる。それゆえ、あなたは心をつくし、精神をつくしてそれを守り行わなければならない。"},{"ref":"Deut.26.17","start":5026017,"end":5026017,"break":"none","ruby":[[8,1,"しゅ"],[14,1,"かみ"],[22,1,"みち"],[24,1,"あゆ"],[27,1,"さだ"],[31,1,"いまし"],[40,1,"まも"],[45,1,"こえ"],[47,1,"き"],[49,1,"したが"],[54,2,"めいげん"]],"text":"きょう、あなたは主をあなたの神とし、かつその道に歩み、定めと、戒めと、おきてとを守り、その声に聞き従うことを明言した。"},{"ref":"Deut.26.18","start":5026018,"end":5026018,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"さき"],[8,2,"やくそく"],[25,2,"じぶん"],[28,1,"たから"],[30,1,"たみ"],[51,2,"めいれい"],[54,1,"まも"],[61,2,"めいげん"]],"text":"そして、主は先に約束されたように、きょう、あなたを自分の宝の民とされること、また、あなたがそのすべての命令を守るべきことを明言された。"},{"ref":"Deut.26.19","start":5026019,"end":5026019,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"ほまれ"],[4,1,"よ"],[6,1,"な"],[8,1,"さか"],[16,1,"あた"],[20,1,"しゅ"],[22,1,"つく"],[30,2,"こくみん"],[51,1,"しゅ"],[53,1,"い"],[65,1,"かみ"],[67,1,"しゅ"],[69,1,"せい"],[72,1,"たみ"]],"text":"主は誉と良き名と栄えとをあなたに与えて、主の造られたすべての国民にまさるものとされるであろう。あなたは主が言われたように、あなたの神、主の聖なる民となるであろう」。"}]