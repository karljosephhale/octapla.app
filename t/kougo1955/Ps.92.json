[{"ref":"Ps.92.1","start":19092001,"end":19092001,"break":"paragraph","title":"安息日の歌、さんび","breaks":[[13,"line"]],"ruby":[[2,1,"たか"],[4,1,"もの"],[7,1,"しゅ"],[9,2,"かんしゃ"],[14,1,"な"]],"titleRuby":[[0,3,"あんそくにち"],[4,1,"うた"]],"text":"いと高き者よ、主に感謝し、み名をほめたたえるのは、よいことです。"},{"ref":"Ps.92.2","start":19092002,"end":19092002,"break":"line","breaks":[[20,"line"]],"ruby":[[20,1,"よ"],[22,1,"よ"]],"text":"あしたに、あなたのいつくしみをあらわし、夜な夜な、あなたのまことをあらわすために、"},{"ref":"Ps.92.3","start":19092003,"end":19092003,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"じゅうげん"],[3,2,"がっき"],[6,2,"たてごと"],[9,1,"もち"],[12,1,"こと"],[18,1,"しら"],[21,1,"もち"]],"text":"十弦の楽器と立琴を用い、琴のたえなる調べを用いるのは、よいことです。"},{"ref":"Ps.92.4","start":19092004,"end":19092004,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[18,1,"たの"],[37,1,"て"],[42,1,"よろこ"],[44,1,"うた"]],"text":"主よ、あなたはみわざをもってわたしを楽しませられました。わたしはあなたのみ手のわざを喜び歌います。"},{"ref":"Ps.92.5","start":19092005,"end":19092005,"break":"line","breaks":[[11,"line"],[25,"line"]],"ruby":[[0,1,"しゅ"],[14,1,"おお"],[34,1,"おも"],[41,1,"ふか"]],"text":"主よ、あなたのみわざはいかに大いなることでしょう。あなたのもろもろの思いは、いとも深く、"},{"ref":"Ps.92.6","start":19092006,"end":19092006,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"にぶ"],[2,1,"もの"],[4,1,"し"],[13,1,"おろ"],[16,1,"もの"],[21,1,"さと"]],"text":"鈍い者は知ることができず、愚かな者はこれを悟ることができません。"},{"ref":"Ps.92.7","start":19092007,"end":19092007,"break":"line","breaks":[[19,"line"],[36,"line"]],"ruby":[[4,1,"あ"],[7,1,"もの"],[9,1,"くさ"],[19,2,"ふぎ"],[22,1,"おこな"],[24,1,"もの"],[31,1,"さか"],[36,1,"かれ"],[44,1,"ほろ"],[47,1,"さだ"]],"text":"たとい、悪しき者は草のようにもえいで、不義を行う者はことごとく栄えても、彼らはとこしえに滅びに定められているのです。"},{"ref":"Ps.92.8","start":19092008,"end":19092008,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"しゅ"],[16,1,"たか"],[18,1,"ところ"]],"text":"しかし、主よ、あなたはとこしえに高き所にいらせられます。"},{"ref":"Ps.92.9","start":19092009,"end":19092009,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"てき"],[13,1,"てき"],[15,1,"ほろ"],[18,2,"ふぎ"],[21,1,"おこな"],[23,1,"もの"],[30,1,"ち"]],"text":"主よ、あなたの敵、あなたの敵は滅び、不義を行う者はことごとく散らされるでしょう。"},{"ref":"Ps.92.10","start":19092010,"end":19092010,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[12,1,"つの"],[14,2,"のうし"],[17,1,"つの"],[22,1,"たか"],[27,1,"あたら"],[30,1,"あぶら"],[36,1,"そそ"]],"text":"しかし、あなたはわたしの角を野牛の角のように高くあげ、新しい油をわたしに注がれました。"},{"ref":"Ps.92.11","start":19092011,"end":19092011,"break":"line","breaks":[[15,"line"],[33,"line"]],"ruby":[[4,1,"め"],[8,1,"てき"],[10,2,"ぼつらく"],[13,1,"み"],[19,1,"みみ"],[25,1,"せ"],[28,2,"わるもの"],[33,2,"はめつ"],[36,1,"き"]],"text":"わたしの目はわが敵の没落を見、わたしの耳はわたしを攻める悪者どもの破滅を聞きました。"},{"ref":"Ps.92.12","start":19092012,"end":19092012,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[11,1,"き"],[16,1,"さか"],[24,2,"こうはく"],[30,1,"そだ"]],"text":"正しい者はなつめやしの木のように栄え、レバノンの香柏のように育ちます。"},{"ref":"Ps.92.13","start":19092013,"end":19092013,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[3,1,"しゅ"],[5,1,"いえ"],[7,1,"う"],[16,1,"かみ"],[18,2,"おおにわ"],[21,1,"さか"]],"text":"彼らは主の家に植えられ、われらの神の大庭に栄えます。"},{"ref":"Ps.92.14","start":19092014,"end":19092014,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[3,2,"としお"],[9,1,"み"],[11,1,"むす"],[17,2,"せいき"],[20,1,"み"],[23,2,"あおあお"]],"text":"彼らは年老いてなお実を結び、いつも生気に満ち、青々として、"},{"ref":"Ps.92.15","start":19092015,"end":19092015,"break":"line","breaks":[[15,"line"],[23,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ただ"],[8,1,"しめ"],[15,1,"しゅ"],[19,1,"いわ"],[23,1,"しゅ"],[26,1,"すこ"],[29,2,"ふぎ"]],"text":"主の正しいことを示すでしょう。主はわが岩です。主には少しの不義もありません。"}]