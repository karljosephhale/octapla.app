[{"ref":"Ps.75.1","start":19075001,"end":19075001,"break":"paragraph","title":"聖歌隊の指揮者によって、「滅ぼすな」というしらべにあわせてうたわせたアサフの歌、さんび","breaks":[[17,"line"],[27,"line"],[41,"line"]],"ruby":[[0,1,"かみ"],[11,2,"かんしゃ"],[21,2,"かんしゃ"],[36,1,"な"],[38,1,"よ"],[53,1,"かた"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[13,1,"ほろ"],[38,1,"うた"]],"text":"神よ、われらはあなたに感謝します。われらは感謝します。われらはあなたのみ名を呼び、あなたのくすしきみわざを語ります。"},{"ref":"Ps.75.2","start":19075002,"end":19075002,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"さだ"],[4,1,"とき"],[6,1,"く"],[14,2,"こうへい"]],"text":"定まった時が来れば、わたしは公平をもってさばく。"},{"ref":"Ps.75.3","start":19075003,"end":19075003,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ち"],[8,1,"す"],[26,1,"はしら"],[28,1,"かた"]],"text":"地とすべてこれに住むものがよろめくとき、わたしはその柱を堅くする。〔セラ"},{"ref":"Ps.75.4","start":19075004,"end":19075004,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"ほこ"],[7,1,"もの"],[11,1,"ほこ"],[16,1,"い"],[19,1,"あ"],[22,1,"もの"],[26,1,"つの"]],"text":"わたしは、誇る者には「誇るな」と言い、悪しき者には「角をあげるな、"},{"ref":"Ps.75.5","start":19075005,"end":19075005,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"つの"],[2,1,"たか"],[9,2,"こうまん"],[12,2,"たいど"],[18,1,"かた"],[23,1,"い"]],"text":"角を高くあげるな、高慢な態度をもって語るな」と言う。"},{"ref":"Ps.75.6","start":19075006,"end":19075006,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"あ"],[6,1,"ひがし"],[13,1,"にし"],[22,2,"あらの"]],"text":"上げることは東からでなく、西からでなく、また荒野からでもない。"},{"ref":"Ps.75.7","start":19075007,"end":19075007,"break":"line","breaks":[[17,"line"]],"ruby":[[7,1,"おこな"],[11,1,"かみ"],[17,1,"かみ"],[22,1,"さ"],[28,1,"あ"]],"text":"それはさばきを行われる神であって、神はこれを下げ、かれを上げられる。"},{"ref":"Ps.75.8","start":19075008,"end":19075008,"break":"line","breaks":[[11,"line"],[26,"line"],[39,"line"],[50,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"て"],[5,1,"さかずき"],[13,1,"ま"],[16,1,"さけ"],[26,1,"しゅ"],[31,1,"そそ"],[33,1,"だ"],[39,1,"ち"],[45,1,"あ"],[48,1,"もの"],[53,2,"いってき"],[56,1,"のこ"],[60,1,"の"]],"text":"主の手には杯があって、よく混ぜた酒があわだっている。主がこれを注ぎ出されると、地のすべての悪しき者はこれを一滴も残さずに飲みつくすであろう。"},{"ref":"Ps.75.9","start":19075009,"end":19075009,"break":"line","breaks":[[15,"line"]],"ruby":[[12,1,"よろこ"],[19,1,"かみ"]],"text":"しかしわたしはとこしえに喜び、ヤコブの神をほめうたいます。"},{"ref":"Ps.75.10","start":19075010,"end":19075010,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"つの"],[12,1,"き"],[14,1,"はな"],[19,1,"ただ"],[22,1,"もの"],[24,1,"つの"]],"text":"悪しき者の角はことごとく切り離されるが正しい者の角はあげられるであろう。"}]