[{"ref":"Gal.4.1","start":48004001,"end":48004001,"break":"paragraph","ruby":[[4,1,"い"],[6,2,"いみ"],[16,3,"そうぞくにん"],[20,2,"こども"],[25,1,"あいだ"],[28,1,"ぜん"],[29,2,"ざいさん"],[32,1,"も"],[34,1,"ぬし"],[42,1,"しもべ"],[47,2,"さべつ"]],"text":"わたしの言う意味は、こうである。相続人が子供である間は、全財産の持ち主でありながら、僕となんの差別もなく、"},{"ref":"Gal.4.2","start":48004002,"end":48004002,"break":"none","ruby":[[0,2,"ちちおや"],[3,1,"さだ"],[6,2,"じき"],[12,3,"かんりにん"],[16,3,"こうけんにん"],[20,2,"かんとく"],[23,1,"もと"],[25,1,"お"]],"text":"父親の定めた時期までは、管理人や後見人の監督の下に置かれているのである。"},{"ref":"Gal.4.3","start":48004003,"end":48004003,"break":"none","ruby":[[3,1,"おな"],[13,2,"こども"],[19,1,"とき"],[29,1,"よ"],[36,2,"れいりょく"],[39,1,"もと"],[42,1,"しば"],[48,1,"もの"]],"text":"それと同じく、わたしたちも子供であった時には、いわゆるこの世のもろもろの霊力の下に、縛られていた者であった。"},{"ref":"Gal.4.4","start":48004004,"end":48004004,"break":"none","ruby":[[4,1,"とき"],[6,1,"み"],[10,1,"およ"],[14,1,"かみ"],[16,2,"みこ"],[19,1,"おんな"],[22,1,"うま"],[27,2,"りっぽう"],[30,1,"もと"],[32,1,"うま"]],"text":"しかし、時の満ちるに及んで、神は御子を女から生れさせ、律法の下に生れさせて、おつかわしになった。"},{"ref":"Gal.4.5","start":48004005,"end":48004005,"break":"none","ruby":[[4,2,"りっぽう"],[7,1,"もと"],[11,1,"もの"],[17,1,"だ"],[28,1,"こ"],[31,2,"みぶん"],[34,1,"さづ"]],"text":"それは、律法の下にある者をあがない出すため、わたしたちに子たる身分を授けるためであった。"},{"ref":"Gal.4.6","start":48004006,"end":48004006,"break":"none","ruby":[[12,1,"こ"],[21,1,"かみ"],[29,1,"こころ"],[31,1,"なか"],[38,1,"ちち"],[42,1,"よ"],[44,2,"みこ"],[47,1,"れい"],[49,1,"おく"],[52,1,"くだ"]],"text":"このように、あなたがたは子であるのだから、神はわたしたちの心の中に、「アバ、父よ」と呼ぶ御子の霊を送って下さったのである。"},{"ref":"Gal.4.7","start":48004007,"end":48004007,"break":"none","ruby":[[15,1,"しもべ"],[21,1,"こ"],[26,1,"こ"],[30,2,"いじょう"],[35,1,"かみ"],[39,3,"そうぞくにん"]],"text":"したがって、あなたがたはもはや僕ではなく、子である。子である以上、また神による相続人である。"},{"ref":"Gal.4.8","start":48004008,"end":48004008,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"し"],[8,2,"とうじ"],[18,2,"ほんらい"],[20,1,"かみ"],[24,2,"かみがみ"],[27,2,"どれい"]],"text":"神を知らなかった当時、あなたがたは、本来神ならぬ神々の奴隷になっていた。"},{"ref":"Gal.4.9","start":48004009,"end":48004009,"break":"none","ruby":[[4,1,"いま"],[7,1,"かみ"],[9,1,"し"],[17,1,"いな"],[22,1,"かみ"],[24,1,"し"],[40,2,"むりょく"],[43,2,"ひんじゃく"],[52,2,"れいりょく"],[55,1,"ぎゃく"],[67,1,"あら"],[72,2,"どれい"]],"text":"しかし、今では神を知っているのに、否、むしろ神に知られているのに、どうして、あの無力で貧弱な、もろもろの霊力に逆もどりして、またもや、新たにその奴隷になろうとするのか。"},{"ref":"Gal.4.10","start":48004010,"end":48004010,"break":"none","ruby":[[7,1,"ひ"],[9,1,"つき"],[11,2,"きせつ"],[14,1,"とし"],[18,1,"まも"]],"text":"あなたがたは、日や月や季節や年などを守っている。"},{"ref":"Gal.4.11","start":48004011,"end":48004011,"break":"none","ruby":[[14,2,"どりょく"],[52,2,"しんぱい"]],"text":"わたしは、あなたがたのために努力してきたことが、あるいは、むだになったのではないかと、あなたがたのことが心配でならない。"},{"ref":"Gal.4.12","start":48004012,"end":48004012,"break":"paragraph","ruby":[[0,2,"きょうだい"],[7,1,"ねが"],[60,1,"ど"],[66,1,"たい"],[69,3,"ふつごう"]],"text":"兄弟たちよ。お願いする。どうか、わたしのようになってほしい。わたしも、あなたがたのようになったのだから。あなたがたは、一度もわたしに対して不都合なことをしたことはない。"},{"ref":"Gal.4.13","start":48004013,"end":48004013,"break":"none","ruby":[[6,1,"し"],[15,2,"さいしょ"],[27,2,"ふくいん"],[30,1,"つた"],[40,2,"にくたい"],[43,1,"よわ"]],"text":"あなたがたも知っているとおり、最初わたしがあなたがたに福音を伝えたのは、わたしの肉体が弱っていたためであった。"},{"ref":"Gal.4.14","start":48004014,"end":48004014,"break":"none","ruby":[[8,2,"にくたい"],[21,2,"しれん"],[38,1,"いや"],[63,1,"かみ"],[65,1,"つかい"],[84,1,"むか"]],"text":"そして、わたしの肉体にはあなたがたにとって試錬となるものがあったのに、それを卑しめもせず、またきらいもせず、かえってわたしを、神の使かキリスト・イエスかでもあるように、迎えてくれた。"},{"ref":"Gal.4.15","start":48004015,"end":48004015,"break":"none","ruby":[[2,1,"とき"],[10,2,"かんげき"],[14,1,"いま"],[27,1,"い"],[46,2,"じぶん"],[49,1,"め"],[54,1,"だ"]],"text":"その時のあなたがたの感激は、今どこにあるのか。はっきり言うが、あなたがたは、できることなら、自分の目をえぐり出してでも、わたしにくれたかったのだ。"},{"ref":"Gal.4.16","start":48004016,"end":48004016,"break":"none","ruby":[[6,2,"しんり"],[9,1,"かた"],[26,1,"てき"]],"text":"それだのに、真理を語ったために、わたしはあなたがたの敵になったのか。"},{"ref":"Gal.4.17","start":48004017,"end":48004017,"break":"none","ruby":[[0,1,"かれ"],[9,1,"たい"],[12,2,"ねっしん"],[18,2,"ぜんい"],[31,2,"じぶん"],[35,2,"ねっしん"],[57,1,"ひ"],[59,1,"はな"]],"text":"彼らがあなたがたに対して熱心なのは、善意からではない。むしろ、自分らに熱心にならせるために、あなたがたをわたしから引き離そうとしているのである。"},{"ref":"Gal.4.18","start":48004018,"end":48004018,"break":"none","ruby":[[10,1,"ところ"],[14,1,"とき"],[25,1,"よ"],[33,2,"ねっしん"],[36,1,"した"],[43,1,"よ"]],"text":"わたしがあなたがたの所にいる時だけでなく、いつも、良いことについて熱心に慕われるのは、良いことである。"},{"ref":"Gal.4.19","start":48004019,"end":48004019,"break":"none","ruby":[[7,1,"おさ"],[9,1,"ご"],[20,1,"うち"],[27,1,"かたち"],[55,1,"う"],[58,1,"くる"]],"text":"ああ、わたしの幼な子たちよ。あなたがたの内にキリストの形ができるまでは、わたしは、またもや、あなたがたのために産みの苦しみをする。"},{"ref":"Gal.4.20","start":48004020,"end":48004020,"break":"none","ruby":[[12,1,"いま"],[19,1,"ところ"],[24,2,"ごちょう"],[27,1,"か"],[30,1,"はな"],[52,2,"とほう"]],"text":"できることなら、わたしは今あなたがたの所にいて、語調を変えて話してみたい。わたしは、あなたがたのことで、途方にくれている。"},{"ref":"Gal.4.21","start":48004021,"end":48004021,"break":"paragraph","ruby":[[0,2,"りっぽう"],[3,1,"もと"],[14,1,"おも"],[16,1,"ひと"],[25,1,"こた"],[37,2,"りっぽう"],[40,1,"い"],[46,1,"き"]],"text":"律法の下にとどまっていたいと思う人たちよ。わたしに答えなさい。あなたがたは律法の言うところを聞かないのか。"},{"ref":"Gal.4.22","start":48004022,"end":48004022,"break":"none","ruby":[[23,1,"こ"],[34,1,"おんな"],[35,2,"どれい"],[44,2,"じゆう"],[47,1,"おんな"],[50,1,"うま"]],"text":"そのしるすところによると、アブラハムにふたりの子があったが、ひとりは女奴隷から、ひとりは自由の女から生れた。"},{"ref":"Gal.4.23","start":48004023,"end":48004023,"break":"none","ruby":[[0,1,"おんな"],[1,2,"どれい"],[4,1,"こ"],[6,1,"にく"],[11,1,"うま"],[19,2,"じゆう"],[22,1,"おんな"],[24,1,"こ"],[26,2,"やくそく"],[32,1,"うま"]],"text":"女奴隷の子は肉によって生れたのであり、自由の女の子は約束によって生れたのであった。"},{"ref":"Gal.4.24","start":48004024,"end":48004024,"break":"none","ruby":[[5,2,"ものがたり"],[8,2,"ひゆ"],[25,1,"おんな"],[32,2,"けいやく"],[47,1,"ざん"],[50,1,"で"],[53,2,"どれい"],[58,1,"もの"],[60,1,"う"]],"text":"さて、この物語は比喩としてみられる。すなわち、この女たちは二つの契約をさす。そのひとりはシナイ山から出て、奴隷となる者を産む。ハガルがそれである。"},{"ref":"Gal.4.25","start":48004025,"end":48004025,"break":"none","ruby":[[17,1,"ざん"],[23,1,"いま"],[31,1,"あた"],[42,1,"こ"],[46,1,"とも"],[49,2,"どれい"]],"text":"ハガルといえば、アラビヤではシナイ山のことで、今のエルサレムに当る。なぜなら、それは子たちと共に、奴隷となっているからである。"},{"ref":"Gal.4.26","start":48004026,"end":48004026,"break":"none","ruby":[[4,1,"うえ"],[14,2,"じゆう"],[17,1,"おんな"],[29,1,"はは"]],"text":"しかし、上なるエルサレムは、自由の女であって、わたしたちの母をさす。"},{"ref":"Gal.4.27","start":48004027,"end":48004027,"break":"none","breaks":[[13,"stanza"],[23,"line"],[45,"line"],[65,"line"]],"ruby":[[7,1,"か"],[14,1,"よろこ"],[17,2,"ふにん"],[20,1,"おんな"],[23,1,"こえ"],[28,1,"よろこ"],[31,1,"う"],[34,1,"くる"],[38,1,"し"],[42,1,"おんな"],[48,1,"もの"],[55,1,"おんな"],[57,1,"おお"],[60,1,"こ"],[62,1,"う"],[67,1,"かず"],[70,1,"おっと"],[73,1,"おんな"],[75,1,"こ"],[80,1,"おお"]],"text":"すなわち、こう書いてある、「喜べ、不妊の女よ。声をあげて喜べ、産みの苦しみを知らない女よ。ひとり者となっている女は多くの子を産み、その数は、夫ある女の子らよりも多い」。"},{"ref":"Gal.4.28","start":48004028,"end":48004028,"break":"none","ruby":[[0,2,"きょうだい"],[21,2,"やくそく"],[24,1,"こ"]],"text":"兄弟たちよ。あなたがたは、イサクのように、約束の子である。"},{"ref":"Gal.4.29","start":48004029,"end":48004029,"break":"none","ruby":[[6,2,"とうじ"],[9,1,"にく"],[14,1,"うま"],[17,1,"もの"],[20,1,"れい"],[25,1,"うま"],[28,1,"もの"],[30,2,"はくがい"],[38,1,"いま"],[41,2,"どうよう"]],"text":"しかし、その当時、肉によって生れた者が、霊によって生れた者を迫害したように、今でも同様である。"},{"ref":"Gal.4.30","start":48004030,"end":48004030,"break":"none","ruby":[[4,2,"せいしょ"],[10,1,"い"],[18,1,"おんな"],[19,2,"どれい"],[24,1,"こ"],[27,1,"お"],[29,1,"だ"],[32,1,"おんな"],[33,2,"どれい"],[36,1,"こ"],[39,2,"じゆう"],[42,1,"おんな"],[44,1,"こ"],[46,1,"とも"],[48,2,"そうぞく"]],"text":"しかし、聖書はなんと言っているか。「女奴隷とその子とを追い出せ。女奴隷の子は、自由の女の子と共に相続をしてはならない」とある。"},{"ref":"Gal.4.31","start":48004031,"end":48004031,"break":"none","ruby":[[4,2,"きょうだい"],[16,1,"おんな"],[17,2,"どれい"],[20,1,"こ"],[26,2,"じゆう"],[29,1,"おんな"],[31,1,"こ"]],"text":"だから、兄弟たちよ。わたしたちは女奴隷の子ではなく、自由の女の子なのである。"}]