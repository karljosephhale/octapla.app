[{"ref":"Lev.5.1","start":3005001,"end":3005001,"break":"paragraph","ruby":[[2,1,"ひと"],[4,2,"しょうにん"],[7,1,"た"],[10,1,"ちか"],[13,1,"こえ"],[15,1,"き"],[23,1,"み"],[28,1,"し"],[36,1,"い"],[42,1,"つみ"],[44,1,"おか"],[50,1,"かれ"],[57,1,"お"]],"text":"もし人が証人に立ち、誓いの声を聞きながら、その見たこと、知っていることを言わないで、罪を犯すならば、彼はそのとがを負わなければならない。"},{"ref":"Lev.5.2","start":3005002,"end":3005002,"break":"none","ruby":[[5,1,"ひと"],[7,1,"けが"],[10,2,"やじゅう"],[13,2,"したい"],[16,1,"けが"],[19,2,"かちく"],[22,2,"したい"],[25,1,"けが"],[28,1,"は"],[33,2,"したい"],[41,1,"けが"],[47,1,"ふ"],[59,1,"き"],[67,1,"かれ"],[69,1,"けが"],[82,1,"え"]],"text":"また、もし人が汚れた野獣の死体、汚れた家畜の死体、汚れた這うものの死体など、すべて汚れたものに触れるならば、そのことに気づかなくても、彼は汚れたものとなって、とがを得る。"},{"ref":"Lev.5.3","start":3005003,"end":3005003,"break":"none","ruby":[[5,1,"かれ"],[7,1,"ひと"],[9,1,"けが"],[12,1,"ふ"],[21,1,"ひと"],[23,1,"けが"],[32,1,"けが"],[41,1,"き"],[49,1,"かれ"],[54,1,"し"],[62,1,"とき"],[68,1,"え"]],"text":"また、もし彼が人の汚れに触れるならば、その人の汚れが、どのような汚れであれ、それに気づかなくても、彼がこれを知るようになった時は、とがを得る。"},{"ref":"Lev.5.4","start":3005004,"end":3005004,"break":"none","ruby":[[5,1,"ひと"],[16,1,"ちか"],[19,1,"あく"],[28,1,"ぜん"],[34,1,"い"],[42,1,"ひと"],[44,1,"ちか"],[51,1,"い"],[73,1,"き"],[81,1,"かれ"],[86,1,"し"],[94,1,"とき"],[111,1,"え"]],"text":"また、もし人がみだりにくちびるで誓い、悪をなそう、または善をなそうと言うならば、その人が誓ってみだりに言ったことは、それがどんなことであれ、それに気づかなくても、彼がこれを知るようになった時は、これらの一つについて、とがを得る。"},{"ref":"Lev.5.5","start":3005005,"end":3005005,"break":"none","ruby":[[16,1,"え"],[24,1,"つみ"],[26,1,"おか"],[32,2,"こくはく"]],"text":"もしこれらの一つについて、とがを得たときは、その罪を犯したことを告白し、"},{"ref":"Lev.5.6","start":3005006,"end":3005006,"break":"none","ruby":[[2,1,"おか"],[5,1,"つみ"],[10,1,"つぐな"],[16,1,"めす"],[18,2,"かちく"],[25,1,"めす"],[27,2,"こひつじ"],[32,1,"め"],[36,1,"しゅ"],[41,1,"つ"],[47,2,"ざいさい"],[64,2,"さいし"],[67,1,"かれ"],[72,1,"つみ"]],"text":"その犯した罪のために償いとして、雌の家畜、すなわち雌の小羊または雌やぎを主のもとに連れてきて、罪祭としなければならない。こうして祭司は彼のために罪のあがないをするであろう。"},{"ref":"Lev.5.7","start":3005007,"end":3005007,"break":"paragraph","ruby":[[2,2,"こひつじ"],[5,1,"て"],[12,1,"とき"],[15,1,"やま"],[19,1,"わ"],[22,1,"いえ"],[29,1,"わ"],[33,1,"かれ"],[35,1,"おか"],[38,1,"つみ"],[43,1,"つぐな"],[48,1,"しゅ"],[50,1,"たずさ"],[57,1,"わ"],[59,2,"ざいさい"],[64,1,"わ"],[66,2,"はんさい"]],"text":"もし小羊に手のとどかない時は、山ばと二羽か、家ばとのひな二羽かを、彼が犯した罪のために償いとして主に携えてきて、一羽を罪祭に、一羽を燔祭にしなければならない。"},{"ref":"Lev.5.8","start":3005008,"end":3005008,"break":"none","ruby":[[9,2,"さいし"],[12,1,"たずさ"],[18,2,"さいし"],[23,2,"ざいさい"],[29,1,"さき"],[50,1,"あたま"],[52,1,"くび"],[54,1,"ね"],[61,1,"つ"],[63,1,"やぶ"],[78,1,"き"],[80,1,"はな"]],"text":"すなわち、これらを祭司に携えてきて、祭司はその罪祭のものを先にささげなければならない。すなわち、その頭を首の根のところで、摘み破らなければならない。ただし、切り離してはならない。"},{"ref":"Lev.5.9","start":3005009,"end":3005009,"break":"none","ruby":[[5,2,"ざいさい"],[8,1,"ち"],[10,2,"さいだん"],[13,2,"そくめん"],[16,1,"そそ"],[19,1,"のこ"],[22,1,"ち"],[24,2,"さいだん"],[30,1,"しぼ"],[32,1,"だ"],[46,2,"ざいさい"]],"text":"そしてその罪祭の血を祭壇の側面に注ぎ、残りの血は祭壇のもとに絞り出さなければならない。これは罪祭である。"},{"ref":"Lev.5.10","start":3005010,"end":3005010,"break":"none","ruby":[[2,1,"だい"],[9,1,"さだ"],[17,2,"はんさい"],[35,2,"さいし"],[38,1,"かれ"],[45,1,"おか"],[48,1,"つみ"],[61,1,"かれ"]],"text":"また第二のものは、定めにしたがって燔祭としなければならない。こうして、祭司が彼のためにその犯した罪のあがないをするならば、彼はゆるされるであろう。"},{"ref":"Lev.5.11","start":3005011,"end":3005011,"break":"paragraph","ruby":[[3,1,"わ"],[5,1,"やま"],[12,1,"わ"],[14,1,"いえ"],[23,1,"て"],[25,1,"とど"],[33,1,"かれ"],[35,1,"おか"],[38,1,"つみ"],[44,1,"そな"],[46,1,"もの"],[50,2,"むぎこ"],[53,1,"ぶん"],[59,1,"たずさ"],[68,2,"ざいさい"],[87,1,"うえ"],[89,1,"あぶら"],[104,1,"うえ"],[106,2,"にゅうこう"],[109,1,"そ"],[121,2,"ざいさい"]],"text":"もし二羽の山ばとにも、二羽の家ばとのひなにも、手の届かないときは、彼の犯した罪のために、供え物として麦粉十分の一エパを携えてきて、これを罪祭としなければならない。ただし、その上に油をかけてはならない。またその上に乳香を添えてはならない。これは罪祭だからである。"},{"ref":"Lev.5.12","start":3005012,"end":3005012,"break":"none","ruby":[[0,1,"かれ"],[5,2,"さいし"],[11,1,"たずさ"],[14,1,"い"],[17,2,"さいし"],[20,2,"ひとにぎ"],[24,1,"と"],[28,2,"きねん"],[31,1,"ぶん"],[38,1,"しゅ"],[44,2,"かさい"],[51,2,"さいだん"],[54,1,"うえ"],[56,1,"や"],[70,2,"ざいさい"]],"text":"彼はこれを祭司のもとに携えて行き、祭司は一握りを取って、記念の分とし、これを主にささげる火祭のように、祭壇の上で焼かなければならない。これは罪祭である。"},{"ref":"Lev.5.13","start":3005013,"end":3005013,"break":"none","ruby":[[5,2,"さいし"],[8,1,"かれ"],[18,1,"かれ"],[27,1,"おか"],[30,1,"つみ"],[47,1,"かれ"],[64,1,"のこ"],[67,2,"そさい"],[70,1,"おな"],[74,2,"さいし"],[77,1,"き"]],"text":"こうして、祭司が彼のため、すなわち、彼がこれらの一つを犯した罪のために、あがないをするならば、彼はゆるされるであろう。そしてその残りは素祭と同じく、祭司に帰するであろう』」。"},{"ref":"Lev.5.14","start":3005014,"end":3005014,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.5.15","start":3005015,"end":3005015,"break":"none","ruby":[[3,1,"ひと"],[5,2,"ふせい"],[16,1,"しゅ"],[18,1,"せい"],[21,1,"もの"],[26,1,"つみ"],[28,1,"おか"],[37,1,"つぐな"],[47,1,"ね"],[48,1,"づも"],[56,2,"せいじょ"],[64,1,"ぎん"],[65,1,"すう"],[70,1,"あた"],[72,2,"おひつじ"],[75,1,"まった"],[81,1,"む"],[88,1,"と"],[94,1,"しゅ"],[96,1,"たずさ"],[102,2,"けんさい"]],"text":"「もし人が不正をなし、あやまって主の聖なる物について罪を犯したときは、その償いとして、あなたの値積りにしたがい、聖所のシケルで、銀数シケルに当る雄羊の全きものを、群れのうちから取り、それを主に携えてきて、愆祭としなければならない。"},{"ref":"Lev.5.16","start":3005016,"end":3005016,"break":"none","ruby":[[5,1,"せい"],[8,1,"もの"],[13,1,"おか"],[16,1,"つみ"],[21,1,"つぐな"],[31,1,"ぶん"],[38,1,"くわ"],[42,2,"さいし"],[45,1,"わた"],[60,2,"さいし"],[65,2,"けんさい"],[68,2,"おひつじ"],[75,1,"かれ"],[91,1,"かれ"]],"text":"そしてその聖なる物について犯した罪のために償いをし、またその五分の一をこれに加えて、祭司に渡さなければならない。こうして祭司がその愆祭の雄羊をもって、彼のためにあがないをするならば、彼はゆるされるであろう。"},{"ref":"Lev.5.17","start":3005017,"end":3005017,"break":"paragraph","ruby":[[2,1,"ひと"],[6,1,"つみ"],[8,1,"おか"],[11,1,"しゅ"],[48,1,"し"],[55,1,"かれ"],[57,1,"つみ"],[59,1,"え"],[66,1,"お"]],"text":"また人がもし罪を犯し、主のいましめにそむいて、してはならないことの一つをしたときは、たといそれを知らなくても、彼は罪を得、そのとがを負わなければならない。"},{"ref":"Lev.5.18","start":3005018,"end":3005018,"break":"none","ruby":[[0,1,"かれ"],[6,1,"ね"],[7,1,"づも"],[16,2,"おひつじ"],[19,1,"まった"],[24,1,"む"],[31,1,"と"],[34,2,"けんさい"],[42,2,"さいし"],[48,1,"たずさ"],[66,2,"さいし"],[69,1,"かれ"],[79,1,"かれ"],[81,1,"し"],[95,1,"おか"],[98,2,"かしつ"],[116,1,"かれ"]],"text":"彼はあなたの値積りにしたがって、雄羊の全きものを群れのうちから取り、愆祭としてこれを祭司のもとに携えてこなければならない。こうして、祭司が彼のために、すなわち彼が知らないで、しかもあやまって犯した過失のために、あがないをするならば、彼はゆるされるであろう。"},{"ref":"Lev.5.19","start":3005019,"end":3005019,"break":"none","ruby":[[3,2,"けんさい"],[9,1,"かれ"],[11,1,"たし"],[14,1,"しゅ"],[16,1,"まえ"],[21,1,"え"]],"text":"これは愆祭である。彼は確かに主の前にとがを得たからである」。"}]