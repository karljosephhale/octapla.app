[{"ref":"Josh.5.1","start":6005001,"end":6005001,"break":"paragraph","ruby":[[5,1,"む"],[8,1,"がわ"],[14,1,"にし"],[16,1,"ほう"],[26,1,"おう"],[31,1,"うみ"],[42,1,"おう"],[47,1,"みな"],[49,1,"しゅ"],[57,2,"ひとびと"],[60,1,"まえ"],[68,1,"みず"],[70,1,"ほ"],[77,1,"かれ"],[80,1,"わた"],[87,1,"き"],[97,2,"ひとびと"],[104,1,"こころ"],[106,1,"き"],[109,1,"かれ"],[119,2,"げんき"]],"text":"ヨルダンの向こう側、すなわち西の方におるアモリびとの王たちと、海べにおるカナンびとの王たちとは皆、主がイスラエルの人々の前で、ヨルダンの水を干しからして、彼らを渡らせられたと聞いて、イスラエルの人々のゆえに、心は消え、彼らのうちに、もはや元気もなくなった。"},{"ref":"Josh.5.2","start":6005002,"end":6005002,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[11,1,"い"],[17,3,"ひうちいし"],[21,2,"こがたな"],[24,1,"つく"],[27,1,"かさ"],[38,2,"ひとびと"],[41,2,"かつれい"],[44,1,"おこな"]],"text":"その時、主はヨシュアに言われた、「火打石の小刀を造り、重ねてまたイスラエルの人々に割礼を行いなさい」。"},{"ref":"Josh.5.3","start":6005003,"end":6005003,"break":"none","ruby":[[8,3,"ひうちいし"],[12,2,"こがたな"],[15,1,"つく"],[18,1,"よう"],[19,1,"ひ"],[21,1,"おか"],[30,2,"ひとびと"],[33,2,"かつれい"],[36,1,"おこな"]],"text":"そこでヨシュアは火打石の小刀を造り、陽皮の丘で、イスラエルの人々に割礼を行った。"},{"ref":"Josh.5.4","start":6005004,"end":6005004,"break":"none","ruby":[[5,2,"ひとびと"],[8,2,"かつれい"],[11,1,"おこな"],[14,2,"りゆう"],[29,1,"で"],[33,1,"たみ"],[43,2,"だんし"],[59,1,"みな"],[66,1,"で"],[68,1,"のち"],[70,2,"とちゅう"],[73,2,"あらの"],[76,1,"し"]],"text":"ヨシュアが人々に割礼を行った理由はこうである。エジプトから出てきた民のうちの、すべての男子、すなわち、いくさびとたちは皆、エジプトを出た後、途中、荒野で死んだが、"},{"ref":"Josh.5.5","start":6005005,"end":6005005,"break":"none","ruby":[[2,1,"で"],[6,1,"たみ"],[8,1,"みな"],[10,2,"かつれい"],[13,1,"う"],[16,1,"もの"],[31,1,"で"],[33,1,"のち"],[36,2,"とちゅう"],[39,2,"あらの"],[42,1,"う"],[46,1,"たみ"],[51,2,"かつれい"],[54,1,"う"]],"text":"その出てきた民は皆、割礼を受けた者であった。しかし、エジプトを出た後に、途中、荒野で生まれた民は、みな割礼を受けていなかった。"},{"ref":"Josh.5.6","start":6005006,"end":6005006,"break":"none","ruby":[[6,2,"ひとびと"],[11,1,"ねん"],[13,1,"あいだ"],[15,2,"あらの"],[18,1,"ある"],[32,1,"で"],[36,1,"たみ"],[54,1,"し"],[56,1,"た"],[63,1,"かれ"],[66,1,"しゅ"],[68,1,"こえ"],[70,1,"き"],[72,1,"したが"],[81,1,"しゅ"],[83,1,"かれ"],[86,2,"せんぞ"],[91,1,"ちか"],[100,1,"あた"],[104,1,"おお"],[109,1,"ち"],[111,1,"ちち"],[113,1,"みつ"],[115,1,"なが"],[118,1,"ち"],[121,1,"かれ"],[124,1,"み"],[130,1,"ちか"]],"text":"イスラエルの人々は四十年の間、荒野を歩いていて、そのエジプトから出てきた民、すなわち、いくさびとたちは、みな死に絶えた。これは彼らが主の声に聞き従わなかったので、主は彼らの先祖たちに誓って、われわれに与えると仰せられた地、乳と蜜の流れる地を、彼らに見させないと誓われたからである。"},{"ref":"Josh.5.7","start":6005007,"end":6005007,"break":"none","ruby":[[5,2,"かつれい"],[8,1,"おこな"],[16,2,"ひとびと"],[22,1,"おこ"],[28,1,"こ"],[38,1,"かれ"],[41,2,"とちゅう"],[44,2,"かつれい"],[47,1,"う"],[58,1,"む"],[59,2,"かつれい"],[62,1,"もの"]],"text":"ヨシュアが割礼を行ったのは、この人々についで起されたその子どもたちであった。彼らは途中で割礼を受けていなかったので、無割礼の者であったからである。"},{"ref":"Josh.5.8","start":6005008,"end":6005008,"break":"paragraph","ruby":[[4,1,"たみ"],[6,2,"かつれい"],[9,1,"おこな"],[14,1,"おわ"],[20,1,"たみ"],[22,2,"しゅくえい"],[28,2,"じぶん"],[31,1,"ところ"],[38,1,"きず"],[40,1,"なお"],[44,1,"ま"]],"text":"すべての民に割礼を行うことが終ったので、民は宿営のうちの自分の所にとどまって傷の直るのを待った。"},{"ref":"Josh.5.9","start":6005009,"end":6005009,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[11,1,"い"],[48,1,"さ"],[58,1,"ところ"],[60,1,"な"],[63,2,"こんにち"],[72,1,"よ"]],"text":"その時、主はヨシュアに言われた、「きょう、わたしはエジプトのはずかしめを、あなたがたからころがし去った」。それでその所の名は、今日までギルガルと呼ばれている。"},{"ref":"Josh.5.10","start":6005010,"end":6005010,"break":"paragraph","ruby":[[6,2,"ひとびと"],[14,2,"しゅくえい"],[24,1,"つき"],[28,1,"か"],[30,2,"ゆうぐれ"],[37,2,"へいや"],[40,2,"すぎこし"],[43,1,"まつり"],[45,1,"おこな"]],"text":"イスラエルの人々はギルガルに宿営していたが、その月の十四日の夕暮、エリコの平野で過越の祭を行った。"},{"ref":"Josh.5.11","start":6005011,"end":6005011,"break":"none","ruby":[[3,2,"すぎこし"],[6,1,"まつり"],[8,2,"よくじつ"],[13,1,"ち"],[15,2,"こくもつ"],[22,1,"たね"],[23,1,"い"],[33,1,"むぎ"],[38,1,"ひ"],[40,1,"た"]],"text":"そして過越の祭の翌日、その地の穀物、すなわち種入れぬパンおよびいり麦を、その日に食べたが、"},{"ref":"Josh.5.12","start":6005012,"end":6005012,"break":"none","ruby":[[2,1,"ち"],[4,2,"こくもつ"],[7,1,"た"],[10,2,"よくじつ"],[18,1,"ふ"],[32,2,"ひとびと"],[42,1,"え"],[50,1,"とし"],[56,1,"ち"],[58,2,"さんぶつ"],[61,1,"た"]],"text":"その地の穀物を食べた翌日から、マナの降ることはやみ、イスラエルの人々は、もはやマナを獲なかった。その年はカナンの地の産物を食べた。"},{"ref":"Josh.5.13","start":6005013,"end":6005013,"break":"paragraph","ruby":[[9,1,"ちか"],[17,1,"め"],[19,1,"あ"],[22,1,"み"],[30,1,"ひと"],[32,1,"ぬ"],[34,1,"み"],[40,1,"て"],[42,1,"も"],[49,1,"む"],[53,1,"た"],[68,1,"ひと"],[74,1,"い"],[77,1,"い"],[91,1,"たす"],[108,1,"てき"],[110,1,"たす"]],"text":"ヨシュアがエリコの近くにいたとき、目を上げて見ると、ひとりの人が抜き身のつるぎを手に持ち、こちらに向かって立っていたので、ヨシュアはその人のところへ行って言った、「あなたはわれわれを助けるのですか。それともわれわれの敵を助けるのですか」。"},{"ref":"Josh.5.14","start":6005014,"end":6005014,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[14,1,"しゅ"],[16,2,"ぐんぜい"],[19,1,"しょう"],[23,1,"いま"],[35,1,"ち"],[39,1,"ふ"],[41,1,"はい"],[44,1,"い"],[51,1,"しゅ"],[53,1,"なに"],[59,1,"つ"]],"text":"彼は言った、「いや、わたしは主の軍勢の将として今きたのだ」。ヨシュアは地にひれ伏し拝して言った、「わが主は何をしもべに告げようとされるのですか」。"},{"ref":"Josh.5.15","start":6005015,"end":6005015,"break":"none","ruby":[[3,1,"しゅ"],[5,2,"ぐんぜい"],[8,1,"しょう"],[15,1,"い"],[24,1,"あし"],[29,1,"ぬ"],[39,1,"た"],[44,1,"ところ"],[46,1,"せい"],[49,1,"ところ"]],"text":"すると主の軍勢の将はヨシュアに言った、「あなたの足のくつを脱ぎなさい。あなたが立っている所は聖なる所である」。ヨシュアはそのようにした。"}]