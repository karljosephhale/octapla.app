[{"ref":"Lev.7.1","start":3007001,"end":3007001,"break":"paragraph","ruby":[[0,2,"けんさい"],[7,1,"つぎ"],[21,1,"せい"],[24,1,"もの"]],"text":"愆祭のおきては次のとおりである。それはいと聖なる物である。"},{"ref":"Lev.7.2","start":3007002,"end":3007002,"break":"none","ruby":[[0,2,"けんさい"],[3,2,"はんさい"],[9,2,"ばしょ"],[27,2,"さいし"],[32,1,"ち"],[34,2,"さいだん"],[37,2,"しゅうい"],[40,1,"そそ"]],"text":"愆祭は燔祭をほふる場所でほふらなければならない。そして祭司はその血を祭壇の周囲に注ぎかけ、"},{"ref":"Lev.7.3","start":3007003,"end":3007003,"break":"none","ruby":[[6,2,"しぼう"],[25,1,"あぶら"],[26,1,"お"],[28,2,"ないぞう"],[34,2,"しぼう"]],"text":"そのすべての脂肪をささげなければならない。すなわち脂尾、内臓をおおう脂肪、"},{"ref":"Lev.7.4","start":3007004,"end":3007004,"break":"none","ruby":[[3,2,"じんぞう"],[8,1,"うえ"],[10,1,"こし"],[18,2,"しぼう"],[21,2,"じんぞう"],[24,1,"とも"],[26,1,"と"],[30,2,"かんぞう"],[33,1,"うえ"],[35,2,"しょうよう"]],"text":"二つの腎臓とその上の腰のあたりにある脂肪、腎臓と共に取られる肝臓の上の小葉である。"},{"ref":"Lev.7.5","start":3007005,"end":3007005,"break":"none","ruby":[[0,2,"さいし"],[6,2,"さいだん"],[9,1,"うえ"],[11,1,"や"],[15,1,"しゅ"],[17,2,"かさい"],[33,2,"けんさい"]],"text":"祭司はこれを祭壇の上で焼いて、主に火祭としなければならない。これは愆祭である。"},{"ref":"Lev.7.6","start":3007006,"end":3007006,"break":"none","ruby":[[0,2,"さいし"],[12,2,"だんし"],[19,1,"た"],[32,1,"せい"],[35,1,"ところ"],[37,1,"た"],[53,1,"せい"],[56,1,"もの"]],"text":"祭司たちのうちのすべての男子は、これを食べることができる。これは聖なる所で食べなければならない。これはいと聖なる物である。"},{"ref":"Lev.7.7","start":3007007,"end":3007007,"break":"none","ruby":[[0,2,"ざいさい"],[3,2,"けんさい"],[20,1,"こと"],[41,2,"さいし"],[44,1,"き"]],"text":"罪祭も愆祭も、そのおきては一つであって、異なるところはない。これは、あがないをなす祭司に帰する。"},{"ref":"Lev.7.8","start":3007008,"end":3007008,"break":"none","ruby":[[0,1,"ひと"],[2,1,"たずさ"],[7,2,"はんさい"],[14,2,"さいし"],[19,2,"さいし"],[29,2,"はんさい"],[35,1,"かわ"],[37,1,"き"]],"text":"人が携えてくる燔祭をささげる祭司、その祭司に、そのささげる燔祭のものの皮は帰する。"},{"ref":"Lev.7.9","start":3007009,"end":3007009,"break":"none","ruby":[[3,2,"てんぴ"],[6,1,"や"],[9,2,"そさい"],[17,1,"ふか"],[18,1,"なべ"],[22,2,"ひらなべ"],[25,1,"つく"],[39,2,"さいし"],[42,1,"き"]],"text":"すべて天火で焼いた素祭、またすべて深鍋または平鍋で作ったものは、これをささげる祭司に帰する。"},{"ref":"Lev.7.10","start":3007010,"end":3007010,"break":"none","ruby":[[3,2,"そさい"],[7,1,"あぶら"],[9,1,"ま"],[32,1,"こ"],[40,1,"き"]],"text":"すべて素祭は、油を混ぜたものも、かわいたものも、アロンのすべての子たちにひとしく帰する。"},{"ref":"Lev.7.11","start":3007011,"end":3007011,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,3,"しゅうおんさい"],[11,2,"ぎせい"],[18,1,"つぎ"]],"text":"主にささぐべき酬恩祭の犠牲のおきては次のとおりである。"},{"ref":"Lev.7.12","start":3007012,"end":3007012,"break":"none","ruby":[[5,2,"かんしゃ"],[21,1,"あぶら"],[23,1,"ま"],[26,1,"たね"],[27,1,"い"],[30,2,"かし"],[34,1,"あぶら"],[36,1,"ぬ"],[39,1,"たね"],[40,1,"い"],[43,2,"せんべい"],[49,1,"ま"],[52,2,"むぎこ"],[55,1,"あぶら"],[57,1,"ま"],[60,1,"つく"],[63,2,"かし"],[68,2,"かんしゃ"],[71,2,"ぎせい"],[74,1,"あ"]],"text":"もしこれを感謝のためにささげるのであれば、油を混ぜた種入れぬ菓子と、油を塗った種入れぬ煎餅と、よく混ぜた麦粉に油を混ぜて作った菓子とを、感謝の犠牲に合わせてささげなければならない。"},{"ref":"Lev.7.13","start":3007013,"end":3007013,"break":"none","ruby":[[2,1,"たね"],[4,1,"い"],[10,2,"かし"],[15,2,"かんしゃ"],[21,3,"しゅうおんさい"],[25,2,"ぎせい"],[28,1,"あ"],[32,1,"そな"],[34,1,"もの"]],"text":"また種を入れたパンの菓子をその感謝のための酬恩祭の犠牲に合わせ、供え物としてささげなければならない。"},{"ref":"Lev.7.14","start":3007014,"end":3007014,"break":"none","ruby":[[10,1,"そな"],[12,1,"もの"],[19,2,"かし"],[26,1,"と"],[29,1,"しゅ"],[46,3,"しゅうおんさい"],[50,1,"ち"],[52,1,"そそ"],[57,2,"さいし"],[60,1,"き"]],"text":"すなわちこのすべての供え物のうちから、菓子一つずつを取って主にささげなければならない。これは酬恩祭の血を注ぎかける祭司に帰する。"},{"ref":"Lev.7.15","start":3007015,"end":3007015,"break":"none","ruby":[[2,2,"かんしゃ"],[8,3,"しゅうおんさい"],[12,2,"ぎせい"],[15,1,"にく"],[20,1,"そな"],[22,1,"もの"],[28,1,"ひ"],[33,1,"た"],[44,1,"すこ"],[48,1,"あ"],[51,1,"あさ"],[54,1,"のこ"],[57,1,"お"]],"text":"その感謝のための酬恩祭の犠牲の肉は、その供え物をささげた日のうちに食べなければならない。少しでも明くる朝まで残して置いてはならない。"},{"ref":"Lev.7.16","start":3007016,"end":3007016,"break":"none","ruby":[[6,1,"そな"],[8,1,"もの"],[10,2,"ぎせい"],[15,2,"せいがん"],[18,1,"そな"],[20,1,"もの"],[25,2,"じはつ"],[28,1,"そな"],[30,1,"もの"],[40,2,"ぎせい"],[47,1,"ひ"],[55,1,"た"],[60,1,"のこ"],[65,1,"あ"],[68,1,"ひ"],[70,1,"た"]],"text":"しかし、その供え物の犠牲がもし誓願の供え物、または自発の供え物であるならば、その犠牲をささげた日のうちにそれを食べ、その残りはまた明くる日に食べることができる。"},{"ref":"Lev.7.17","start":3007017,"end":3007017,"break":"none","ruby":[[6,2,"ぎせい"],[9,1,"にく"],[11,1,"のこ"],[15,1,"か"],[16,1,"め"],[19,1,"ひ"],[21,1,"や"],[23,1,"す"]],"text":"ただし、その犠牲の肉の残りは三日目には火で焼き捨てなければならない。"},{"ref":"Lev.7.18","start":3007018,"end":3007018,"break":"none","ruby":[[4,3,"しゅうおんさい"],[8,2,"ぎせい"],[11,1,"にく"],[14,1,"か"],[15,1,"め"],[17,1,"すこ"],[21,1,"た"],[31,1,"う"],[33,1,"い"],[41,1,"そな"],[43,1,"もの"],[45,1,"み"],[55,1,"い"],[59,1,"もの"],[74,1,"た"],[77,1,"もの"],[82,1,"お"]],"text":"もしその酬恩祭の犠牲の肉を三日目に少しでも食べるならば、それは受け入れられず、また供え物と見なされず、かえって忌むべき物となるであろう。そしてそれを食べる者はとがを負わなければならない。"},{"ref":"Lev.7.19","start":3007019,"end":3007019,"break":"paragraph","ruby":[[2,1,"にく"],[6,1,"けが"],[9,1,"もの"],[11,1,"ふ"],[21,1,"た"],[29,1,"ひ"],[31,1,"や"],[33,1,"す"],[44,2,"ぎせい"],[47,1,"にく"],[52,1,"きよ"],[54,1,"もの"],[59,1,"た"]],"text":"その肉がもし汚れた物に触れるならば、それを食べることなく、火で焼き捨てなければならない。犠牲の肉はすべて清い者がこれを食べることができる。"},{"ref":"Lev.7.20","start":3007020,"end":3007020,"break":"none","ruby":[[2,1,"ひと"],[6,1,"み"],[8,1,"けが"],[16,1,"しゅ"],[22,3,"しゅうおんさい"],[26,2,"ぎせい"],[29,1,"にく"],[31,1,"た"],[40,1,"ひと"],[42,1,"たみ"],[48,1,"た"]],"text":"もし人がその身に汚れがあるのに、主にささげた酬恩祭の犠牲の肉を食べるならば、その人は民のうちから断たれるであろう。"},{"ref":"Lev.7.21","start":3007021,"end":3007021,"break":"none","ruby":[[2,1,"ひと"],[9,1,"けが"],[19,1,"ひと"],[21,1,"けが"],[28,1,"けが"],[31,1,"けもの"],[37,1,"けが"],[40,1,"は"],[45,1,"ふ"],[51,1,"しゅ"],[57,3,"しゅうおんさい"],[61,2,"ぎせい"],[64,1,"にく"],[66,1,"た"],[75,1,"ひと"],[77,1,"たみ"],[83,1,"た"]],"text":"また人がもしすべて汚れたもの、すなわち人の汚れ、あるいは汚れた獣、あるいは汚れた這うものに触れながら、主にささげた酬恩祭の犠牲の肉を食べるならば、その人は民のうちから断たれるであろう』」。"},{"ref":"Lev.7.22","start":3007022,"end":3007022,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.7.23","start":3007023,"end":3007023,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[27,1,"うし"],[29,1,"ひつじ"],[34,2,"しぼう"],[37,1,"た"]],"text":"「イスラエルの人々に言いなさい、『あなたがたは、すべて牛、羊、やぎの脂肪を食べてはならない。"},{"ref":"Lev.7.24","start":3007024,"end":3007024,"break":"none","ruby":[[0,2,"しぜん"],[3,1,"し"],[6,1,"けもの"],[8,2,"しぼう"],[13,1,"さ"],[15,1,"ころ"],[19,1,"けもの"],[21,2,"しぼう"],[33,1,"つか"],[47,1,"けっ"],[50,1,"た"]],"text":"自然に死んだ獣の脂肪および裂き殺された獣の脂肪は、さまざまのことに使ってもよい。しかし、それは決して食べてはならない。"},{"ref":"Lev.7.25","start":3007025,"end":3007025,"break":"none","ruby":[[4,2,"かさい"],[9,1,"しゅ"],[15,1,"けもの"],[17,2,"しぼう"],[20,1,"た"],[30,1,"た"],[33,1,"ひと"],[35,1,"たみ"],[41,1,"た"]],"text":"だれでも火祭として主にささげる獣の脂肪を食べるならば、これを食べる人は民のうちから断たれるであろう。"},{"ref":"Lev.7.26","start":3007026,"end":3007026,"break":"none","ruby":[[13,1,"す"],[15,1,"ところ"],[18,1,"とり"],[23,1,"けもの"],[33,1,"ち"],[35,1,"た"]],"text":"またあなたがたはすべてその住む所で、鳥にせよ、獣にせよ、すべてその血を食べてはならない。"},{"ref":"Lev.7.27","start":3007027,"end":3007027,"break":"none","ruby":[[7,1,"ち"],[9,1,"た"],[18,1,"ひと"],[20,1,"たみ"],[26,1,"た"]],"text":"だれでもすべて血を食べるならば、その人は民のうちから断たれるであろう』」。"},{"ref":"Lev.7.28","start":3007028,"end":3007028,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.7.29","start":3007029,"end":3007029,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[17,3,"しゅうおんさい"],[21,2,"ぎせい"],[24,1,"しゅ"],[30,1,"もの"],[35,3,"しゅうおんさい"],[39,2,"ぎせい"],[49,1,"そな"],[51,1,"もの"],[53,1,"しゅ"],[55,1,"たずさ"]],"text":"「イスラエルの人々に言いなさい、『酬恩祭の犠牲を主にささげる者は、その酬恩祭の犠牲のうちから、その供え物を主に携えてこなければならない。"},{"ref":"Lev.7.30","start":3007030,"end":3007030,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"かさい"],[5,1,"て"],[12,1,"たずさ"],[31,2,"しぼう"],[34,1,"むね"],[37,1,"たずさ"],[45,1,"むね"],[47,1,"しゅ"],[49,1,"まえ"],[51,1,"ゆ"],[53,1,"うご"],[58,2,"ようさい"]],"text":"主の火祭は手ずからこれを携えてこなければならない。すなわちその脂肪と胸とを携えてきて、その胸を主の前に揺り動かして、揺祭としなければならない。"},{"ref":"Lev.7.31","start":3007031,"end":3007031,"break":"none","ruby":[[3,2,"さいし"],[8,2,"しぼう"],[11,2,"さいだん"],[14,1,"うえ"],[16,1,"や"],[29,1,"むね"],[37,1,"こ"],[41,1,"き"]],"text":"そして祭司はその脂肪を祭壇の上で焼かなければならない。その胸はアロンとその子たちに帰する。"},{"ref":"Lev.7.32","start":3007032,"end":3007032,"break":"none","ruby":[[6,3,"しゅうおんさい"],[10,2,"ぎせい"],[20,1,"みぎ"],[25,2,"きょさい"],[31,2,"さいし"],[34,1,"あた"]],"text":"あなたがたの酬恩祭の犠牲のうちから、その右のももを挙祭として、祭司に与えなければならない。"},{"ref":"Lev.7.33","start":3007033,"end":3007033,"break":"none","ruby":[[4,1,"こ"],[11,3,"しゅうおんさい"],[15,1,"ち"],[17,2,"しぼう"],[25,1,"もの"],[30,1,"みぎ"],[35,2,"じぶん"],[38,1,"ぶん"],[43,1,"え"]],"text":"アロンの子たちのうち、酬恩祭の血と脂肪とをささげる者は、その右のももを自分の分として、獲るであろう。"},{"ref":"Lev.7.34","start":3007034,"end":3007034,"break":"none","ruby":[[10,2,"ひとびと"],[13,3,"しゅうおんさい"],[17,2,"ぎせい"],[27,2,"ようさい"],[30,1,"むね"],[32,2,"きょさい"],[38,1,"と"],[42,2,"さいし"],[50,1,"こ"],[54,1,"あた"],[66,2,"ひとびと"],[70,2,"えいきゅう"],[73,1,"かれ"],[76,1,"う"],[80,1,"ぶん"]],"text":"わたしはイスラエルの人々の酬恩祭の犠牲のうちから、その揺祭の胸と挙祭のももを取って、祭司アロンとその子たちに与え、これをイスラエルの人々から永久に彼らの受くべき分とする。"},{"ref":"Lev.7.35","start":3007035,"end":3007035,"break":"none","ruby":[[3,1,"しゅ"],[5,2,"かさい"],[17,1,"う"],[20,1,"ぶん"],[25,1,"こ"],[29,1,"う"],[32,1,"ぶん"],[39,2,"さいし"],[42,1,"しょく"],[49,1,"かれ"],[52,1,"しゅ"],[60,1,"ひ"],[62,1,"さだ"]],"text":"これは主の火祭のうちから、アロンの受ける分と、その子たちの受ける分とであって、祭司の職をなすため、彼らが主にささげられた日に定められたのである。"},{"ref":"Lev.7.36","start":3007036,"end":3007036,"break":"none","ruby":[[8,1,"かれ"],[11,1,"あぶら"],[13,1,"そそ"],[15,1,"ひ"],[24,2,"ひとびと"],[27,1,"かれ"],[30,1,"あた"],[37,1,"しゅ"],[39,1,"めい"],[51,2,"よよ"],[53,2,"えいきゅう"],[56,1,"う"],[60,1,"ぶん"]],"text":"すなわち、これは彼らに油を注ぐ日に、イスラエルの人々が彼らに与えるように、主が命じられたものであって、代々永久に受くべき分である』」。"},{"ref":"Lev.7.37","start":3007037,"end":3007037,"break":"paragraph","ruby":[[3,2,"はんさい"],[6,2,"そさい"],[9,2,"ざいさい"],[12,2,"けんさい"],[15,3,"にんしょくさい"],[19,3,"しゅうおんさい"],[23,2,"ぎせい"]],"text":"これは燔祭、素祭、罪祭、愆祭、任職祭、酬恩祭の犠牲のおきてである。"},{"ref":"Lev.7.38","start":3007038,"end":3007038,"break":"none","ruby":[[5,1,"しゅ"],[11,2,"あらの"],[23,2,"ひとびと"],[28,1,"そな"],[30,1,"もの"],[32,1,"しゅ"],[41,1,"めい"],[46,1,"ひ"],[52,1,"さん"],[58,1,"めい"]],"text":"すなわち、主がシナイの荒野においてイスラエルの人々にその供え物を主にささげることを命じられた日に、シナイ山でモーセに命じられたものである。"}]