[{"ref":"Neh.9.1","start":16009001,"end":16009001,"break":"paragraph","ruby":[[2,1,"つき"],[7,1,"か"],[15,2,"ひとびと"],[18,1,"あつ"],[22,2,"だんじき"],[26,2,"あらぬの"],[33,1,"つち"]],"text":"その月の二十四日にイスラエルの人々は集まって断食し、荒布をまとい、土をかぶった。"},{"ref":"Neh.9.2","start":16009002,"end":16009002,"break":"none","ruby":[[9,2,"しそん"],[17,3,"いほうじん"],[21,1,"はな"],[24,1,"た"],[27,2,"じぶん"],[30,1,"つみ"],[32,2,"せんぞ"],[35,2,"ふぎ"]],"text":"そしてイスラエルの子孫は、すべての異邦人を離れ、立って自分の罪と先祖の不義とをざんげした。"},{"ref":"Neh.9.3","start":16009003,"end":16009003,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ところ"],[7,1,"た"],[13,1,"ひ"],[16,1,"ぶん"],[25,1,"かみ"],[27,1,"しゅ"],[29,2,"りっぽう"],[32,1,"しょ"],[34,1,"よ"],[37,1,"た"],[40,1,"ぶん"],[56,1,"かみ"],[58,1,"しゅ"],[60,1,"はい"]],"text":"彼らはその所に立って、その日の四分の一をもってその神、主の律法の書を読み、他の四分の一をもってざんげをなし、その神、主を拝した。"},{"ref":"Neh.9.4","start":16009004,"end":16009004,"break":"none","ruby":[[2,1,"とき"],[44,1,"だい"],[46,1,"うえ"],[48,1,"た"],[51,2,"おおごえ"],[60,1,"かみ"],[62,1,"しゅ"],[64,1,"よ"]],"text":"その時エシュア、バニ、カデミエル、シバニヤ、ブンニ、セレビヤ、バニ、ケナニらはレビびとの台の上に立ち、大声をあげて、その神、主に呼ばわった。"},{"ref":"Neh.9.5","start":16009005,"end":16009005,"break":"none","ruby":[[53,1,"い"],[58,1,"た"],[64,2,"えいえん"],[68,2,"えいえん"],[80,1,"かみ"],[82,1,"しゅ"],[94,1,"たっと"],[97,1,"な"],[113,2,"しゅくふく"],[120,1,"こ"]],"text":"それからまたエシュア、カデミエル、バニ、ハシャブニヤ、セレビヤ、ホデヤ、セバニヤ、ペタヒヤなどのレビびとは言った、「立ちあがって永遠から永遠にいますあなたがたの神、主をほめなさい。あなたの尊いみ名はほむべきかな。これはすべての祝福とさんびを越えるものです」。"},{"ref":"Neh.9.6","start":16009006,"end":16009006,"break":"paragraph","ruby":[[6,1,"い"],[24,1,"しゅ"],[38,1,"てん"],[40,1,"しょ"],[41,1,"てん"],[43,1,"てん"],[48,2,"ばんしょう"],[51,1,"ち"],[55,1,"うえ"],[64,1,"うみ"],[68,1,"なか"],[77,1,"つく"],[88,1,"たも"],[94,1,"てん"],[96,2,"ばんぐん"],[103,1,"はい"]],"text":"またエズラは言った、「あなたは、ただあなたのみ、主でいらせられます。あなたは天と諸天の天と、その万象、地とその上のすべてのもの、海とその中のすべてのものを造り、これをことごとく保たれます。天の万軍はあなたを拝します。"},{"ref":"Neh.9.7","start":16009007,"end":16009007,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"かみ"],[20,1,"むかし"],[26,1,"えら"],[38,1,"みちび"],[40,1,"だ"],[43,1,"かれ"],[53,1,"な"],[55,1,"あた"]],"text":"あなたは主、神でいらせられます。あなたは昔アブラムを選んでカルデヤのウルから導き出し、彼にアブラハムという名を与え、"},{"ref":"Neh.9.8","start":16009008,"end":16009008,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こころ"],[8,1,"まえ"],[10,2,"ちゅうしん"],[15,1,"み"],[20,1,"かれ"],[22,2,"けいやく"],[25,1,"むす"],[30,2,"しそん"],[71,1,"ち"],[73,1,"あた"],[77,1,"い"],[92,2,"やくそく"],[95,2,"じょうじゅ"],[107,1,"ただ"]],"text":"彼の心があなたの前に忠信なのを見られて、彼と契約を結び、その子孫にカナンびと、ヘテびと、アモリびと、ペリジびと、エブスびとおよびギルガシびとの地を与えると言われたが、ついにあなたはその約束を成就されました。あなたは正しくいらせられるからです。"},{"ref":"Neh.9.9","start":16009009,"end":16009009,"break":"paragraph","ruby":[[9,2,"せんぞ"],[17,2,"くなん"],[20,1,"う"],[25,1,"かえり"],[32,2,"こうかい"],[39,1,"よ"],[43,1,"さけ"],[47,1,"き"]],"text":"あなたはわれわれの先祖がエジプトで苦難を受けるのを顧みられ、また紅海のほとりで呼ばわり叫ぶのを聞きいれられ、"},{"ref":"Neh.9.10","start":16009010,"end":16009010,"break":"none","ruby":[[4,3,"ふしぎ"],[24,2,"けらい"],[30,1,"くに"],[36,1,"たみ"],[38,1,"せ"],[46,1,"かれ"],[54,2,"せんぞ"],[57,1,"たい"],[74,1,"し"],[90,1,"な"],[99,2,"こんにち"]],"text":"しるしと不思議とをあらわしてパロと、そのすべての家来と、その国のすべての民を攻められました。彼らがわれわれの先祖に対して、ごうまんにふるまったことを知られたからです。そしてあなたが名をあげられたこと今日のようです。"},{"ref":"Neh.9.11","start":16009011,"end":16009011,"break":"none","ruby":[[6,1,"かれ"],[9,1,"まえ"],[11,1,"うみ"],[13,1,"わ"],[16,1,"かれ"],[24,1,"ち"],[26,1,"ふ"],[29,1,"うみ"],[31,1,"なか"],[33,1,"とお"],[37,1,"かれ"],[40,1,"お"],[42,1,"もの"],[45,1,"いし"],[47,2,"おおみず"],[50,1,"な"],[52,1,"い"],[58,1,"ふち"],[60,1,"な"],[62,1,"い"]],"text":"あなたはまた彼らの前で海を分け、彼らに、かわいた地を踏んで海の中を通らせ、彼らを追う者を、石を大水に投げ入れるように淵に投げ入れ、"},{"ref":"Neh.9.12","start":16009012,"end":16009012,"break":"none","ruby":[[0,1,"ひる"],[2,1,"くも"],[4,1,"はしら"],[9,1,"かれ"],[12,1,"みちび"],[15,1,"よる"],[17,1,"ひ"],[19,1,"はしら"],[26,1,"ゆ"],[30,1,"みち"],[32,1,"てら"]],"text":"昼は雲の柱をもって彼らを導き、夜は火の柱をもってその行くべき道を照されました。"},{"ref":"Neh.9.13","start":16009013,"end":16009013,"break":"none","ruby":[[9,1,"さん"],[11,1,"うえ"],[13,1,"くだ"],[16,1,"てん"],[19,1,"かれ"],[22,1,"かた"],[25,1,"ただ"],[37,2,"りっぽう"],[42,1,"よ"],[48,1,"いまし"],[52,1,"さづ"]],"text":"あなたはまたシナイ山の上に下り、天から彼らと語り、正しいおきてと、まことの律法および良きさだめと戒めとを授け、"},{"ref":"Neh.9.14","start":16009014,"end":16009014,"break":"none","ruby":[[4,1,"せい"],[7,3,"あんそくにち"],[11,1,"かれ"],[14,1,"しめ"],[31,1,"いまし"],[40,2,"りっぽう"],[44,1,"かれ"],[47,1,"めい"]],"text":"あなたの聖なる安息日を彼らに示し、あなたのしもべモーセによって戒めと、さだめと、律法とを彼らに命じ、"},{"ref":"Neh.9.15","start":16009015,"end":16009015,"break":"none","ruby":[[0,1,"てん"],[3,2,"しょくもつ"],[6,1,"あた"],[11,1,"う"],[18,1,"いわ"],[21,1,"みず"],[23,1,"だ"],[32,1,"うるお"],[38,1,"かれ"],[41,1,"あた"],[45,1,"ちか"],[51,1,"くに"],[61,1,"え"],[66,1,"かれ"],[69,1,"めい"]],"text":"天から食物を与えてその飢えをとどめ、岩から水を出してそのかわきを潤し、また、彼らに与えると誓われたその国にはいって、これを獲るように彼らに命じられました。"},{"ref":"Neh.9.16","start":16009016,"end":16009016,"break":"paragraph","ruby":[[3,1,"かれ"],[15,2,"せんぞ"],[38,1,"いまし"],[41,1,"したが"]],"text":"しかし彼ら、すなわちわれわれの先祖はごうまんにふるまい、かたくなで、あなたの戒めに従わず、"},{"ref":"Neh.9.17","start":16009017,"end":16009017,"break":"none","ruby":[[0,1,"したが"],[5,1,"こば"],[12,1,"かれ"],[15,1,"なか"],[17,1,"おこな"],[21,2,"きせき"],[24,1,"こころ"],[54,1,"た"],[63,2,"どれい"],[66,2,"せいかつ"],[69,1,"かえ"],[85,1,"つみ"],[90,1,"かみ"],[92,1,"めぐ"],[104,1,"いか"],[117,1,"ゆた"],[126,1,"かれ"],[129,1,"す"]],"text":"従うことを拒み、あなたが彼らの中で行われた奇跡を心にとめず、かえってかたくなになり、みずからひとりのかしらを立てて、エジプトの奴隷の生活に帰ろうとしました。しかしあなたは罪をゆるす神、恵みあり、あわれみあり、怒ることおそく、いつくしみ豊かにましまして、彼らを捨てられませんでした。"},{"ref":"Neh.9.18","start":16009018,"end":16009018,"break":"none","ruby":[[2,1,"かれ"],[12,2,"いもの"],[15,1,"こ"],[16,1,"うし"],[18,1,"つく"],[38,1,"みちび"],[40,1,"のぼ"],[49,1,"かみ"],[55,1,"い"],[59,1,"おお"],[62,1,"けが"],[64,1,"こと"],[66,1,"おこな"],[69,1,"とき"]],"text":"また彼らがみずから一つの鋳物の子牛を造って、『これはあなたがたをエジプトから導き上ったあなたがたの神である』と言って、大いに汚し事を行った時にも、"},{"ref":"Neh.9.19","start":16009019,"end":16009019,"break":"none","ruby":[[4,1,"おお"],[16,1,"かれ"],[19,2,"あらの"],[22,2,"みす"],[29,1,"ひる"],[31,1,"くも"],[33,1,"はしら"],[35,1,"かれ"],[38,1,"うえ"],[41,1,"はな"],[46,2,"みちみち"],[48,1,"かれ"],[51,1,"みちび"],[54,1,"よる"],[56,1,"ひ"],[58,1,"はしら"],[63,1,"かれ"],[66,1,"ゆ"],[70,1,"みち"],[72,1,"てら"]],"text":"あなたは大いなるあわれみをもって彼らを荒野に見捨てられず、昼は雲の柱を彼らの上から離さないで道々彼らを導き、夜は火の柱をもって彼らの行くべき道を照されました。"},{"ref":"Neh.9.20","start":16009020,"end":16009020,"break":"none","ruby":[[6,1,"よ"],[12,1,"たま"],[16,1,"かれ"],[19,1,"おし"],[29,1,"つね"],[31,1,"かれ"],[34,1,"くち"],[36,1,"あた"],[41,1,"みず"],[43,1,"かれ"],[46,1,"あた"]],"text":"またあなたは良きみたまを賜わって彼らを教え、あなたのマナを常に彼らの口に与え、また水を彼らに与えて、かわきをとどめ、"},{"ref":"Neh.9.21","start":16009021,"end":16009021,"break":"none","ruby":[[2,1,"ねん"],[4,1,"あいだ"],[5,1,"かれ"],[8,2,"あらの"],[11,1,"やしな"],[18,1,"かれ"],[24,1,"か"],[36,2,"いふく"],[39,1,"ふる"],[45,1,"あし"]],"text":"四十年の間彼らを荒野で養われたので、彼らはなんの欠けるところもなく、その衣服も古びず、その足もはれませんでした。"},{"ref":"Neh.9.22","start":16009022,"end":16009022,"break":"none","ruby":[[7,1,"かれ"],[10,2,"しょこく"],[13,2,"しょみん"],[16,1,"あた"],[26,1,"わ"],[29,1,"と"],[38,1,"かれ"],[46,1,"おう"],[51,2,"りょうち"],[62,1,"おう"],[66,2,"りょうち"],[69,1,"え"]],"text":"そしてあなたは彼らに諸国、諸民を与えて、これをすべて分かち取らせられました。彼らはヘシボンの王シホンの領地、およびバシャンの王オグの領地を獲ました。"},{"ref":"Neh.9.23","start":16009023,"end":16009023,"break":"none","ruby":[[2,1,"かれ"],[5,2,"しそん"],[8,1,"ま"],[11,1,"そら"],[13,1,"ほし"],[20,1,"かれ"],[23,2,"せんぞ"],[33,1,"え"],[36,1,"い"],[40,1,"ち"],[42,1,"かれ"],[45,1,"みちび"],[47,1,"い"]],"text":"また彼らの子孫を増して空の星のようにし、彼らの先祖たちに、はいって獲よと言われた地に彼らを導き入れられたので、"},{"ref":"Neh.9.24","start":16009024,"end":16009024,"break":"none","ruby":[[2,2,"しそん"],[12,1,"ち"],[14,1,"え"],[28,1,"ち"],[30,1,"す"],[38,1,"かれ"],[41,1,"まえ"],[43,2,"せいふく"],[49,1,"おう"],[57,1,"ち"],[59,1,"たみ"],[61,1,"かれ"],[64,1,"て"],[66,1,"わた"],[70,1,"い"],[75,1,"あつか"]],"text":"その子孫は、はいってこの地を獲ました。あなたはまた、この地に住むカナンびとを彼らの前に征服し、その王たちおよびその地の民を彼らの手に渡して、意のままに扱わせられました。"},{"ref":"Neh.9.25","start":16009025,"end":16009025,"break":"none","ruby":[[3,1,"かれ"],[6,2,"けんご"],[9,2,"まちまち"],[14,1,"こ"],[17,1,"ち"],[19,1,"と"],[27,1,"よ"],[29,1,"もの"],[31,1,"み"],[34,1,"いえ"],[36,2,"ほりいけ"],[42,1,"はたけ"],[47,1,"はたけ"],[51,1,"おお"],[54,2,"かじゅ"],[57,1,"え"],[59,1,"た"],[62,1,"あ"],[65,1,"こ"],[67,1,"ふと"],[74,1,"おお"],[78,1,"めぐ"],[84,1,"たの"]],"text":"それで彼らは堅固な町々および肥えた地を取り、もろもろの良い物の満ちた家、掘池、ぶどう畑、オリブ畑および多くの果樹を獲、食べて飽き、肥え太り、あなたの大いなる恵みによって楽しみました。"},{"ref":"Neh.9.26","start":16009026,"end":16009026,"break":"paragraph","ruby":[[9,1,"かれ"],[12,1,"ふ"],[13,2,"じゅうじゅん"],[29,2,"りっぽう"],[32,1,"のち"],[34,1,"な"],[36,1,"す"],[39,1,"かれ"],[42,1,"いまし"],[50,1,"た"],[52,1,"かえ"],[60,3,"よげんしゃ"],[66,1,"ころ"],[69,1,"おお"],[72,1,"けが"],[74,1,"こと"],[76,1,"おこな"]],"text":"それにもかかわらず彼らは不従順で、あなたにそむき、あなたの律法を後に投げ捨て、彼らを戒めて、あなたに立ち返らせようとした預言者たちを殺し、大いに汚し事を行いました。"},{"ref":"Neh.9.27","start":16009027,"end":16009027,"break":"none","ruby":[[7,1,"かれ"],[10,1,"てき"],[12,1,"て"],[14,1,"わた"],[17,1,"くる"],[27,1,"かれ"],[32,2,"くなん"],[35,1,"とき"],[41,1,"よ"],[53,1,"てん"],[59,1,"き"],[63,1,"おお"],[75,1,"かれ"],[78,1,"すく"],[80,1,"もの"],[82,1,"あた"],[85,1,"てき"],[87,1,"て"],[90,1,"すく"]],"text":"そこであなたは彼らを敵の手に渡して苦しめられましたが、彼らがその苦難の時にあなたに呼ばわったので、あなたは天からこれを聞かれ、大いなるあわれみをもって彼らに救う者を与え、敵の手から救わせられました。"},{"ref":"Neh.9.28","start":16009028,"end":16009028,"break":"none","ruby":[[4,1,"かれ"],[7,2,"あんそく"],[10,1,"え"],[23,1,"まえ"],[25,2,"あくじ"],[28,1,"おこな"],[38,1,"かれ"],[41,1,"てき"],[43,1,"て"],[45,1,"す"],[47,1,"お"],[54,1,"おさ"],[65,1,"かれ"],[70,1,"た"],[72,1,"かえ"],[79,1,"よ"],[91,1,"てん"],[97,1,"き"],[112,1,"かれ"],[115,1,"すく"],[117,1,"だ"]],"text":"ところが彼らは安息を得るやいなや、またあなたの前に悪事を行ったので、あなたは彼らを敵の手に捨て置いて、これに治めさせられましたが、彼らがまた立ち返ってあなたに呼ばわったので、あなたは天からこれを聞き、あわれみをもってしばしば彼らを救い出し、"},{"ref":"Neh.9.29","start":16009029,"end":16009029,"break":"none","ruby":[[0,1,"かれ"],[3,1,"いまし"],[11,2,"りっぽう"],[14,1,"ひ"],[31,1,"かれ"],[48,1,"いまし"],[51,1,"したが"],[55,1,"ひと"],[60,1,"おこな"],[72,1,"い"],[86,1,"やぶ"],[89,1,"つみ"],[91,1,"おか"],[94,1,"かた"],[111,1,"き"],[113,1,"したが"]],"text":"彼らを戒めて、あなたの律法に引きもどそうとされました。けれども彼らはごうまんにふるまい、あなたの戒めに従わず、人がこれを行うならば、これによって生きるというあなたのおきてを破って罪を犯し、肩をそびやかし、かたくなになって、聞き従おうとはしませんでした。"},{"ref":"Neh.9.30","start":16009030,"end":16009030,"break":"none","ruby":[[8,1,"とし"],[9,1,"ひさ"],[12,1,"かれ"],[15,1,"しの"],[22,3,"よげんしゃ"],[42,1,"かれ"],[45,1,"いまし"],[54,1,"かれ"],[57,1,"みみ"],[59,1,"かたむ"],[68,1,"かれ"],[71,2,"くにぐに"],[74,1,"たみ"],[76,1,"て"],[78,1,"わた"]],"text":"それでもあなたは年久しく彼らを忍び、あなたの預言者たちにより、あなたのみたまをもって彼らを戒められましたが、彼らは耳を傾けなかったので、彼らを国々の民の手に渡されました。"},{"ref":"Neh.9.31","start":16009031,"end":16009031,"break":"none","ruby":[[7,1,"おお"],[19,1,"かれ"],[22,1,"た"],[29,1,"かれ"],[32,1,"す"],[47,1,"めぐ"],[58,1,"かみ"]],"text":"しかしあなたは大いなるあわれみによって彼らを絶やさず、また彼らを捨てられませんでした。あなたは恵みあり、あわれみある神でいらせられるからです。"},{"ref":"Neh.9.32","start":16009032,"end":16009032,"break":"paragraph","ruby":[[10,1,"かみ"],[12,2,"けいやく"],[15,1,"たも"],[24,1,"ほどこ"],[28,1,"おお"],[33,2,"ちからづよ"],[37,1,"おそ"],[41,1,"かみ"],[50,1,"おう"],[54,1,"とき"],[57,2,"こんにち"],[72,1,"おう"],[82,2,"さいし"],[87,3,"よげんしゃ"],[93,2,"せんぞ"],[109,1,"たみ"],[111,1,"のぞ"],[119,2,"くなん"],[122,1,"ちい"],[125,1,"こと"],[127,1,"み"]],"text":"それゆえ、われわれの神、契約を保ち、いつくしみを施される大いにして力強く、恐るべき神よ、アッスリヤの王たちの時から今日まで、われわれとわれわれの王たち、つかさたち、祭司たち、預言者たち、先祖たち、およびあなたのすべての民に臨んだもろもろの苦難を小さい事と見ないでください。"},{"ref":"Neh.9.33","start":16009033,"end":16009033,"break":"none","ruby":[[5,1,"のぞ"],[12,1,"こと"],[22,1,"ただ"],[33,2,"せいじつ"],[39,1,"おこな"],[51,1,"あく"],[53,1,"おこな"]],"text":"われわれに臨んだすべての事について、あなたは正しいのです。あなたは誠実をもって行われたのに、われわれは悪を行ったのです。"},{"ref":"Neh.9.34","start":16009034,"end":16009034,"break":"none","ruby":[[5,1,"おう"],[15,2,"さいし"],[20,2,"せんぞ"],[29,2,"りっぽう"],[32,1,"おこな"],[41,1,"あた"],[47,2,"めいれい"],[50,1,"いまし"],[54,1,"き"],[56,1,"したが"]],"text":"われわれの王たち、つかさたち、祭司たち、先祖たちはあなたの律法を行わず、あなたがお与えになった命令と戒めとに聞き従いませんでした。"},{"ref":"Neh.9.35","start":16009035,"end":16009035,"break":"none","ruby":[[4,1,"かれ"],[11,1,"くに"],[20,1,"くだ"],[24,1,"おお"],[27,1,"めぐ"],[43,1,"あた"],[49,1,"ひろ"],[51,1,"こ"],[54,1,"ち"],[66,1,"つか"],[72,2,"じぶん"],[75,1,"わる"]],"text":"すなわち彼らはおのれの国におり、あなたが下さった大きな恵みのうちにおり、またあなたがお与えになった広い肥えた地におりながら、あなたに仕えず、また自分の悪いわざをやめることをしませんでした。"},{"ref":"Neh.9.36","start":16009036,"end":16009036,"break":"none","ruby":[[5,2,"こんにち"],[7,2,"どれい"],[21,2,"せんぞ"],[24,1,"あた"],[30,1,"み"],[34,1,"よ"],[36,1,"もの"],[39,1,"た"],[49,1,"ち"],[57,2,"どれい"]],"text":"われわれは今日奴隷です。あなたがわれわれの先祖に与えて、その実とその良き物とを食べさせようとされた地で、われわれは奴隷となっているのです。"},{"ref":"Neh.9.37","start":16009037,"end":16009037,"break":"none","ruby":[[5,1,"ち"],[12,1,"つみ"],[27,1,"うえ"],[29,1,"た"],[34,1,"おう"],[41,1,"おお"],[44,2,"さんぶつ"],[47,1,"だ"],[56,1,"かれ"],[64,1,"み"],[73,2,"かちく"],[77,1,"い"],[82,2,"さゆう"],[100,1,"おお"],[104,2,"くなん"]],"text":"そしてこの地はわれわれの罪のゆえに、あなたがわれわれの上に立てられた王たちのために多くの産物を出しています。かつ彼らはわれわれの身をも、われわれの家畜をも意のままに左右することができるので、われわれは大いなる苦難のうちにあるのです」。"},{"ref":"Neh.9.38","start":16009038,"end":16009038,"break":"paragraph","ruby":[[7,1,"こと"],[17,1,"かた"],[19,2,"けいやく"],[22,1,"むす"],[29,2,"きろく"],[50,2,"さいし"],[58,1,"いん"],[60,1,"お"]],"text":"このもろもろの事のためにわれわれは堅い契約を結んで、これを記録し、われわれのつかさたち、レビびとたち祭司たちはこれに印を押した。"}]