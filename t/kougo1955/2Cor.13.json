[{"ref":"2Cor.13.1","start":47013001,"end":47013001,"break":"paragraph","ruby":[[4,1,"いま"],[7,2,"どめ"],[16,1,"ところ"],[18,1,"い"],[31,1,"こと"],[41,1,"にん"],[43,2,"しょうにん"],[46,2,"しょうげん"],[52,2,"かくてい"]],"text":"わたしは今、三度目にあなたがたの所に行こうとしている。すべての事がらは、ふたりか三人の証人の証言によって確定する。"},{"ref":"2Cor.13.2","start":47013002,"end":47013002,"break":"none","ruby":[[5,1,"まえ"],[7,1,"つみ"],[9,1,"おか"],[12,1,"もの"],[18,1,"た"],[24,2,"ひとびと"],[29,2,"どめ"],[32,2,"たいざい"],[40,2,"けいこく"],[49,1,"はな"],[54,1,"いま"],[62,1,"い"],[68,2,"こんど"],[70,1,"い"],[73,1,"とき"],[77,1,"けっ"],[80,2,"ようしゃ"]],"text":"わたしは、前に罪を犯した者たちやその他のすべての人々に、二度目に滞在していたとき警告しておいたが、離れている今またあらかじめ言っておく。今度行った時には、決して容赦はしない。"},{"ref":"2Cor.13.3","start":47013003,"end":47013003,"break":"none","ruby":[[24,1,"かた"],[34,2,"しょうこ"],[37,1,"もと"],[60,1,"たい"],[63,1,"よわ"],[81,1,"つよ"]],"text":"なぜなら、あなたがたが、キリストのわたしにあって語っておられるという証拠を求めているからである。キリストは、あなたがたに対して弱くはなく、あなたがたのうちにあって強い。"},{"ref":"2Cor.13.4","start":47013004,"end":47013004,"break":"none","ruby":[[10,1,"よわ"],[16,3,"じゅうじか"],[27,1,"かみ"],[29,1,"ちから"],[34,1,"い"],[66,1,"よわ"],[68,1,"もの"],[80,1,"たい"],[85,1,"かみ"],[87,1,"ちから"],[98,1,"とも"],[100,1,"い"]],"text":"すなわち、キリストは弱さのゆえに十字架につけられたが、神の力によって生きておられるのである。このように、わたしたちもキリストにあって弱い者であるが、あなたがたに対しては、神の力によって、キリストと共に生きるのである。"},{"ref":"2Cor.13.5","start":47013005,"end":47013005,"break":"none","ruby":[[11,2,"しんこう"],[21,2,"じぶん"],[24,2,"はんせい"],[28,2,"じぶん"],[31,2,"ぎんみ"],[70,1,"さと"],[79,1,"さと"],[100,2,"みす"]],"text":"あなたがたは、はたして信仰があるかどうか、自分を反省し、自分を吟味するがよい。それとも、イエス・キリストがあなたがたのうちにおられることを、悟らないのか。もし悟らなければ、あなたがたは、にせものとして見捨てられる。"},{"ref":"2Cor.13.6","start":47013006,"end":47013006,"break":"none","ruby":[[8,2,"じぶん"],[13,2,"みす"],[19,1,"もの"],[28,1,"し"]],"text":"しかしわたしは、自分たちが見捨てられた者ではないことを、知っていてもらいたい。"},{"ref":"2Cor.13.7","start":47013007,"end":47013007,"break":"none","ruby":[[16,1,"あく"],[19,1,"おこな"],[28,1,"かみ"],[30,1,"いの"],[37,2,"じぶん"],[47,1,"もの"],[54,1,"み"],[73,2,"みす"],[79,1,"もの"],[95,1,"よ"],[97,1,"おこな"]],"text":"わたしたちは、あなたがたがどんな悪をも行わないようにと、神に祈る。それは、自分たちがほんとうの者であることを見せるためではなく、たといわたしたちが見捨てられた者のようになっても、あなたがたに良い行いをしてもらいたいためである。"},{"ref":"2Cor.13.8","start":47013008,"end":47013008,"break":"none","ruby":[[7,2,"しんり"],[10,1,"さか"],[15,1,"なに"],[19,1,"ちから"],[24,2,"しんり"],[32,1,"ちから"]],"text":"わたしたちは、真理に逆らっては何をする力もなく、真理にしたがえば力がある。"},{"ref":"2Cor.13.9","start":47013009,"end":47013009,"break":"none","ruby":[[7,2,"じぶん"],[10,1,"よわ"],[21,1,"つよ"],[29,1,"よろこ"],[38,1,"とく"],[40,1,"いの"],[51,2,"かんぜん"],[54,1,"よ"]],"text":"わたしたちは、自分は弱くても、あなたがたが強ければ、それを喜ぶ。わたしたちが特に祈るのは、あなたがたが完全に良くなってくれることである。"},{"ref":"2Cor.13.10","start":47013010,"end":47013010,"break":"none","ruby":[[8,1,"はな"],[13,2,"いじょう"],[22,1,"か"],[38,1,"ところ"],[40,1,"い"],[46,1,"たお"],[54,1,"たか"],[60,1,"しゅ"],[62,1,"さづ"],[65,1,"くだ"],[69,2,"けんい"],[72,1,"もち"],[80,2,"しょち"],[85,2,"ひつよう"]],"text":"こういうわけで、離れていて以上のようなことを書いたのは、わたしがあなたがたの所に行ったとき、倒すためではなく高めるために主が授けて下さった権威を用いて、きびしい処置をする必要がないようにしたいためである。"},{"ref":"2Cor.13.11","start":47013011,"end":47013011,"break":"paragraph","ruby":[[0,2,"さいご"],[4,2,"きょうだい"],[13,1,"よろこ"],[19,1,"まった"],[21,1,"もの"],[29,1,"たがい"],[31,1,"はげ"],[34,1,"あ"],[40,1,"おも"],[51,2,"へいわ"],[54,1,"す"],[67,1,"あい"],[69,2,"へいわ"],[72,1,"かみ"],[80,1,"とも"],[84,1,"くだ"]],"text":"最後に、兄弟たちよ。いつも喜びなさい。全き者となりなさい。互に励まし合いなさい。思いを一つにしなさい。平和に過ごしなさい。そうすれば、愛と平和の神があなたがたと共にいて下さるであろう。"},{"ref":"2Cor.13.12","start":47013012,"end":47013013,"break":"none","ruby":[[3,2,"せっぷん"],[9,1,"たがい"],[23,2,"せいと"],[27,2,"いちどう"]],"text":"きよい接吻をもって互にあいさつをかわしなさい。聖徒たち一同が、あなたがたによろしく。"},{"ref":"2Cor.13.13","start":47013014,"end":47013014,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"めぐ"],[14,1,"かみ"],[16,1,"あい"],[19,2,"せいれい"],[22,1,"まじ"],[33,2,"いちどう"],[36,1,"とも"]],"text":"主イエス・キリストの恵みと、神の愛と、聖霊の交わりとが、あなたがた一同と共にあるように。"}]