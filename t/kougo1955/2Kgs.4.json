[{"ref":"2Kgs.4.1","start":12004001,"end":12004001,"break":"paragraph","ruby":[[0,3,"よげんしゃ"],[14,1,"つま"],[21,1,"よ"],[26,1,"い"],[45,1,"おっと"],[47,1,"し"],[70,1,"しゅ"],[72,1,"おそ"],[75,1,"もの"],[84,1,"いま"],[86,1,"さい"],[87,1,"しゅ"],[100,2,"こども"],[103,1,"と"],[106,2,"どれい"]],"text":"預言者のともがらの、ひとりの妻がエリシャに呼ばわって言った、「あなたのしもべであるわたしの夫が死にました。ごぞんじのように、あなたのしもべは主を恐れる者でありましたが、今、債主がきて、わたしのふたりの子供を取って奴隷にしようとしているのです」。"},{"ref":"2Kgs.4.2","start":12004002,"end":12004002,"break":"none","ruby":[[5,2,"かのじょ"],[8,1,"い"],[20,1,"なに"],[33,1,"いえ"],[38,1,"もの"],[44,1,"い"],[51,2,"かのじょ"],[54,1,"い"],[63,1,"あぶら"],[74,1,"いえ"],[76,1,"なに"]],"text":"エリシャは彼女に言った、「あなたのために何をしましょうか。あなたの家にどんな物があるか、言いなさい」。彼女は言った、「一びんの油のほかは、はしための家に何もありません」。"},{"ref":"2Kgs.4.3","start":12004003,"end":12004003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[10,1,"い"],[14,1,"となり"],[16,2,"ひとびと"],[20,1,"うつわ"],[22,1,"か"],[31,1,"うつわ"],[33,1,"か"],[39,1,"すこ"]],"text":"彼は言った、「ほかへ行って、隣の人々から器を借りなさい。あいた器を借りなさい。少しばかりではいけません。"},{"ref":"2Kgs.4.4","start":12004004,"end":12004004,"break":"none","ruby":[[3,1,"うち"],[14,2,"こども"],[19,2,"いっしょ"],[22,1,"と"],[24,1,"うち"],[26,1,"と"],[38,1,"うつわ"],[40,1,"あぶら"],[64,1,"と"]],"text":"そして内にはいって、あなたの子供たちと一緒に戸の内に閉じこもり、そのすべての器に油をついで、いっぱいになったとき、一つずつそれを取りのけておきなさい」。"},{"ref":"2Kgs.4.5","start":12004005,"end":12004005,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"かれ"],[5,1,"はな"],[8,1,"さ"],[11,2,"こども"],[16,2,"いっしょ"],[19,1,"と"],[21,1,"うち"],[23,1,"と"],[29,2,"こども"],[34,1,"も"],[37,1,"く"],[39,1,"うつわ"],[41,1,"あぶら"]],"text":"彼女は彼を離れて去り、子供たちと一緒に戸の内に閉じこもり、子供たちの持って来る器に油をついだ。"},{"ref":"2Kgs.4.6","start":12004006,"end":12004006,"break":"none","ruby":[[0,1,"あぶら"],[2,1,"み"],[8,2,"かのじょ"],[11,2,"こども"],[18,1,"うつわ"],[20,1,"も"],[29,1,"い"],[34,2,"こども"],[38,1,"うつわ"],[49,1,"い"],[55,1,"あぶら"]],"text":"油が満ちたとき、彼女は子供に「もっと器を持ってきなさい」と言ったが、子供が「器はもうありません」と言ったので、油はとまった。"},{"ref":"2Kgs.4.7","start":12004007,"end":12004007,"break":"none","ruby":[[3,2,"かのじょ"],[6,1,"かみ"],[8,1,"ひと"],[16,1,"つ"],[22,1,"かれ"],[24,1,"い"],[29,1,"い"],[35,1,"あぶら"],[37,1,"う"],[40,2,"ふさい"],[43,1,"はら"],[58,2,"こども"],[65,1,"のこ"],[68,1,"くら"]],"text":"そこで彼女は神の人のところにきて告げたので、彼は言った、「行って、その油を売って負債を払いなさい。あなたと、あなたの子供たちはその残りで暮すことができます」。"},{"ref":"2Kgs.4.8","start":12004008,"end":12004008,"break":"paragraph","ruby":[[2,1,"ひ"],[13,1,"い"],[25,2,"ゆうふく"],[28,2,"ふじん"],[38,1,"かれ"],[40,2,"しょくじ"],[50,1,"かれ"],[55,1,"とお"],[64,1,"よ"],[67,2,"しょくじ"]],"text":"ある日エリシャはシュネムへ行ったが、そこにひとりの裕福な婦人がいて、しきりに彼に食事をすすめたので、彼はそこを通るごとに、そこに寄って食事をした。"},{"ref":"2Kgs.4.9","start":12004009,"end":12004009,"break":"none","ruby":[[2,1,"おんな"],[4,1,"おっと"],[6,1,"い"],[20,1,"ところ"],[22,1,"とお"],[26,1,"ひと"],[28,1,"たし"],[31,1,"かみ"],[33,1,"せい"],[36,1,"ひと"]],"text":"その女は夫に言った、「いつもわたしたちの所を通るあの人は確かに神の聖なる人です。"},{"ref":"2Kgs.4.10","start":12004010,"end":12004010,"break":"none","ruby":[[6,2,"おくじょう"],[9,1,"かべ"],[16,1,"ちい"],[22,1,"つく"],[28,2,"しんだい"],[31,1,"つくえ"],[36,2,"しょくだい"],[40,1,"かれ"],[45,1,"そな"],[57,1,"かれ"],[65,1,"ところ"],[67,1,"く"]],"text":"わたしたちは屋上に壁のある一つの小さいへやを造り、そこに寝台と机といすと燭台とを彼のために備えましょう。そうすれば彼がわたしたちの所に来るとき、そこに、はいることができます」。"},{"ref":"2Kgs.4.11","start":12004011,"end":12004011,"break":"paragraph","ruby":[[5,1,"ひ"],[29,1,"やす"]],"text":"さて、ある日エリシャはそこにきて、そのへやにはいり、そこに休んだが、"},{"ref":"2Kgs.4.12","start":12004012,"end":12004012,"break":"none","ruby":[[0,1,"かれ"],[19,1,"おんな"],[21,1,"よ"],[30,1,"い"],[34,1,"かれ"],[38,1,"おんな"],[40,1,"よ"],[44,2,"かのじょ"],[54,1,"まえ"],[56,1,"た"]],"text":"彼はそのしもべゲハジに「このシュネムの女を呼んできなさい」と言った。彼がその女を呼ぶと、彼女はきてエリシャの前に立ったので、"},{"ref":"2Kgs.4.13","start":12004013,"end":12004013,"break":"none","ruby":[[9,1,"い"],[14,2,"かのじょ"],[17,1,"い"],[47,1,"こころ"],[49,1,"もち"],[64,1,"なに"],[77,1,"おう"],[81,2,"ぐんぜい"],[84,1,"ちょう"],[90,1,"こと"],[96,1,"たの"],[102,1,"のぞ"],[110,2,"かのじょ"],[113,1,"こた"],[116,1,"い"],[125,2,"じぶん"],[128,1,"たみ"],[133,1,"す"]],"text":"エリシャはゲハジに言った、「彼女に言いなさい、『あなたはこんなにねんごろに、わたしたちのために心を用いられたが、あなたのためには何をしたらよいでしょうか。王または軍勢の長にあなたの事をよろしく頼むことをお望みですか』」。彼女は答えて言った、「わたしは自分の民のうちに住んでいます」。"},{"ref":"2Kgs.4.14","start":12004014,"end":12004014,"break":"none","ruby":[[5,1,"い"],[14,2,"かのじょ"],[20,1,"なに"],[32,1,"い"],[37,2,"かのじょ"],[41,2,"こども"],[49,1,"おっと"],[51,1,"お"]],"text":"エリシャは言った、「それでは彼女のために何をしようか」。ゲハジは言った、「彼女には子供がなく、その夫は老いています」。"},{"ref":"2Kgs.4.15","start":12004015,"end":12004015,"break":"none","ruby":[[9,2,"かのじょ"],[12,1,"よ"],[19,1,"い"],[25,2,"かのじょ"],[28,1,"よ"],[32,1,"き"],[34,2,"とぐち"],[37,1,"た"]],"text":"するとエリシャが「彼女を呼びなさい」と言ったので、彼女を呼ぶと、来て戸口に立った。"},{"ref":"2Kgs.4.16","start":12004016,"end":12004016,"break":"none","ruby":[[5,1,"い"],[10,2,"らいねん"],[13,1,"いま"],[25,1,"こ"],[27,1,"だ"],[35,2,"かのじょ"],[38,1,"い"],[49,1,"しゅ"],[52,1,"かみ"],[54,1,"ひと"],[62,1,"あざむ"]],"text":"エリシャは言った、「来年の今ごろ、あなたはひとりの子を抱くでしょう」。彼女は言った、「いいえ、わが主よ、神の人よ、はしためを欺かないでください」。"},{"ref":"2Kgs.4.17","start":12004017,"end":12004017,"break":"none","ruby":[[3,1,"おんな"],[8,1,"み"],[19,2,"かのじょ"],[22,1,"い"],[29,1,"つぎ"],[31,1,"ねん"],[38,1,"こ"],[40,1,"う"]],"text":"しかし女はついに身ごもって、エリシャが彼女に言ったように、次の年のそのころに子を産んだ。"},{"ref":"2Kgs.4.18","start":12004018,"end":12004018,"break":"paragraph","ruby":[[2,1,"こ"],[4,2,"せいちょう"],[11,1,"ひ"],[13,2,"かりい"],[19,1,"ところ"],[21,1,"で"],[27,1,"ちち"],[32,1,"い"]],"text":"その子が成長して、ある日、刈入れびとの所へ出ていって、父のもとへ行ったが、"},{"ref":"2Kgs.4.19","start":12004019,"end":12004019,"break":"none","ruby":[[0,1,"ちち"],[7,1,"あたま"],[10,1,"あたま"],[14,1,"い"],[20,1,"ちち"],[27,1,"かれ"],[29,1,"はは"],[34,2,"せお"],[45,1,"い"]],"text":"父にむかって「頭が、頭が」と言ったので、父はしもべに「彼を母のもとへ背負っていきなさい」と言った。"},{"ref":"2Kgs.4.20","start":12004020,"end":12004020,"break":"none","ruby":[[0,1,"かれ"],[2,2,"せお"],[6,1,"はは"],[11,1,"い"],[15,1,"ひる"],[18,1,"はは"],[23,1,"うえ"],[36,1,"し"]],"text":"彼を背負って母のもとへ行くと、昼まで母のひざの上にすわっていたが、ついに死んだ。"},{"ref":"2Kgs.4.21","start":12004021,"end":12004021,"break":"none","ruby":[[0,1,"はは"],[2,1,"あ"],[13,1,"かみ"],[15,1,"ひと"],[17,2,"しんだい"],[20,1,"うえ"],[22,1,"お"],[25,1,"と"],[27,1,"と"],[30,1,"で"]],"text":"母は上がっていって、これを神の人の寝台の上に置き、戸を閉じて出てきた。"},{"ref":"2Kgs.4.22","start":12004022,"end":12004022,"break":"none","ruby":[[3,1,"おっと"],[5,1,"よ"],[8,1,"い"],[28,1,"とう"],[42,1,"いそ"],[45,1,"かみ"],[47,1,"ひと"],[49,1,"ところ"],[51,1,"い"],[57,1,"かえ"]],"text":"そして夫を呼んで言った、「どうぞ、しもべひとりと、ろば一頭をわたしにかしてください。急いで神の人の所へ行って、また帰ってきます」。"},{"ref":"2Kgs.4.23","start":12004023,"end":12004023,"break":"none","ruby":[[0,1,"おっと"],[2,1,"い"],[14,1,"かれ"],[16,1,"ところ"],[18,1,"い"],[41,3,"あんそくにち"],[50,2,"かのじょ"],[53,1,"い"]],"text":"夫は言った、「どうしてきょう彼の所へ行こうとするのか。きょうは、ついたちでもなく、安息日でもない」。彼女は言った、「よろしいのです」。"},{"ref":"2Kgs.4.24","start":12004024,"end":12004024,"break":"none","ruby":[[3,2,"かのじょ"],[12,1,"お"],[20,1,"い"],[25,1,"はや"],[27,1,"か"],[39,1,"めい"],[42,1,"とき"],[49,2,"ほちょう"]],"text":"そして彼女はろばにくらを置いて、しもべに言った、「速く駆けさせなさい。わたしが命じる時でなければ、歩調をゆるめてはなりません」。"},{"ref":"2Kgs.4.25","start":12004025,"end":12004025,"break":"none","breaks":[[30,"paragraph"]],"ruby":[[4,2,"かのじょ"],[7,2,"しゅっぱつ"],[15,1,"やま"],[17,1,"い"],[20,1,"かみ"],[22,1,"ひと"],[24,1,"ところ"],[26,1,"い"],[30,1,"かみ"],[32,1,"ひと"],[34,2,"かのじょ"],[37,1,"ちか"],[45,1,"み"],[55,1,"い"],[60,1,"む"],[73,1,"おんな"],[75,1,"く"]],"text":"こうして彼女は出発してカルメル山へ行き、神の人の所へ行った。神の人は彼女の近づいてくるのを見て、しもべゲハジに言った、「向こうから、あのシュネムの女が来る。"},{"ref":"2Kgs.4.26","start":12004026,"end":12004026,"break":"none","ruby":[[2,1,"はし"],[5,1,"い"],[9,2,"かのじょ"],[12,1,"むか"],[15,1,"い"],[26,2,"ぶじ"],[36,1,"おっと"],[38,2,"ぶじ"],[48,2,"こども"],[51,2,"ぶじ"],[59,2,"かのじょ"],[62,1,"こた"],[67,2,"ぶじ"]],"text":"すぐ走って行って、彼女を迎えて言いなさい、『あなたは無事ですか。あなたの夫は無事ですか。あなたの子供は無事ですか』」。彼女は答えた、「無事です」。"},{"ref":"2Kgs.4.27","start":12004027,"end":12004027,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"やま"],[12,1,"かみ"],[14,1,"ひと"],[16,1,"ところ"],[26,1,"あし"],[39,2,"かのじょ"],[42,1,"お"],[49,1,"ちか"],[53,1,"とき"],[55,1,"かみ"],[57,1,"ひと"],[59,1,"い"],[75,2,"かのじょ"],[78,1,"こころ"],[80,1,"くる"],[91,1,"しゅ"],[96,1,"かく"],[107,1,"つ"]],"text":"ところが彼女は山にきて、神の人の所へくるとエリシャの足にすがりついた。ゲハジが彼女を追いのけようと近よった時、神の人は言った、「かまわずにおきなさい。彼女は心に苦しみがあるのだから。主はそれを隠して、まだわたしにお告げにならないのだ」。"},{"ref":"2Kgs.4.28","start":12004028,"end":12004028,"break":"none","ruby":[[3,2,"かのじょ"],[6,1,"い"],[19,1,"こ"],[21,1,"もと"],[32,1,"あざむ"],[42,1,"い"]],"text":"そこで彼女は言った、「わたしがあなたに子を求めましたか。わたしを欺かないでくださいと言ったではありませんか」。"},{"ref":"2Kgs.4.29","start":12004029,"end":12004029,"break":"none","ruby":[[9,1,"い"],[14,1,"こし"],[29,1,"て"],[31,1,"も"],[34,1,"い"],[43,1,"あ"],[72,1,"もの"],[82,1,"こた"],[98,2,"こども"],[101,1,"かお"],[103,1,"うえ"],[105,1,"お"]],"text":"エリシャはゲハジに言った、「腰をひきからげ、わたしのつえを手に持って行きなさい。だれに会っても、あいさつしてはならない。またあなたにあいさつする者があっても、それに答えてはならない。わたしのつえを子供の顔の上に置きなさい」。"},{"ref":"2Kgs.4.30","start":12004030,"end":12004030,"break":"none","ruby":[[0,2,"こども"],[3,1,"はは"],[5,1,"い"],[10,1,"しゅ"],[12,1,"い"],[25,1,"い"],[42,1,"はな"],[60,1,"た"],[66,2,"かのじょ"],[75,1,"い"]],"text":"子供の母は言った、「主は生きておられます。あなたも生きておられます。わたしはあなたを離れません」。そこでエリシャはついに立ちあがって彼女のあとについて行った。"},{"ref":"2Kgs.4.31","start":12004031,"end":12004031,"break":"none","ruby":[[4,1,"かれ"],[7,1,"さき"],[9,1,"い"],[16,2,"こども"],[19,1,"かお"],[21,1,"うえ"],[23,1,"お"],[31,1,"こえ"],[36,1,"い"],[53,1,"かえ"],[63,1,"あ"],[66,1,"かれ"],[68,1,"つ"],[72,2,"こども"],[77,1,"め"],[87,1,"い"]],"text":"ゲハジは彼らの先に行って、つえを子供の顔の上に置いたが、なんの声もなく、生きかえったしるしもなかったので、帰ってきてエリシャに会い、彼に告げて「子供はまだ目をさましません」と言った。"},{"ref":"2Kgs.4.32","start":12004032,"end":12004032,"break":"paragraph","ruby":[[5,1,"いえ"],[11,1,"み"],[15,2,"こども"],[18,1,"し"],[22,2,"しんだい"],[25,1,"うえ"],[27,1,"よこ"]],"text":"エリシャが家にはいって見ると、子供は死んで、寝台の上に横たわっていたので、"},{"ref":"2Kgs.4.33","start":12004033,"end":12004033,"break":"none","ruby":[[0,1,"かれ"],[6,1,"と"],[8,1,"と"],[11,1,"かれ"],[18,1,"うち"],[22,1,"しゅ"],[24,1,"いの"]],"text":"彼ははいって戸を閉じ、彼らふたりだけ内にいて主に祈った。"},{"ref":"2Kgs.4.34","start":12004034,"end":12004034,"break":"none","ruby":[[8,1,"あ"],[12,2,"こども"],[15,1,"うえ"],[17,1,"ふ"],[20,2,"じぶん"],[23,1,"くち"],[25,2,"こども"],[28,1,"くち"],[30,1,"うえ"],[33,2,"じぶん"],[36,1,"め"],[38,2,"こども"],[41,1,"め"],[43,1,"うえ"],[46,2,"じぶん"],[49,2,"りょうて"],[52,2,"こども"],[55,2,"りょうて"],[58,1,"うえ"],[65,1,"み"],[67,2,"こども"],[70,1,"うえ"],[72,1,"の"],[79,2,"こども"],[86,1,"あたた"]],"text":"そしてエリシャが上がって子供の上に伏し、自分の口を子供の口の上に、自分の目を子供の目の上に、自分の両手を子供の両手の上にあて、その身を子供の上に伸ばしたとき、子供のからだは暖かになった。"},{"ref":"2Kgs.4.35","start":12004035,"end":12004035,"break":"none","ruby":[[9,1,"ふたた"],[11,1,"お"],[18,1,"いえ"],[20,1,"なか"],[29,1,"あゆ"],[34,1,"うえ"],[41,1,"み"],[43,2,"こども"],[46,1,"うえ"],[48,1,"の"],[53,2,"こども"],[66,1,"め"],[68,1,"ひら"]],"text":"こうしてエリシャは再び起きあがって、家の中をあちらこちらと歩み、また上がって、その身を子供の上に伸ばすと、子供は七たびくしゃみをして目を開いた。"},{"ref":"2Kgs.4.36","start":12004036,"end":12004036,"break":"none","ruby":[[13,1,"よ"],[25,1,"おんな"],[27,1,"よ"],[31,1,"い"],[37,2,"かのじょ"],[40,1,"よ"],[44,2,"かのじょ"],[59,1,"い"],[68,2,"こども"],[74,1,"い"]],"text":"エリシャはただちにゲハジを呼んで、「あのシュネムの女を呼べ」と言ったので、彼女を呼んだ。彼女がはいってくるとエリシャは言った、「あなたの子供をつれて行きなさい」。"},{"ref":"2Kgs.4.37","start":12004037,"end":12004037,"break":"none","ruby":[[0,2,"かのじょ"],[15,1,"あし"],[19,1,"ふ"],[22,1,"ち"],[24,1,"み"],[36,1,"こ"],[37,1,"とも"],[39,1,"と"],[44,1,"で"]],"text":"彼女ははいってきて、エリシャの足もとに伏し、地に身をかがめた。そしてその子供を取りあげて出ていった。"},{"ref":"2Kgs.4.38","start":12004038,"end":12004038,"break":"paragraph","ruby":[[10,1,"かえ"],[17,1,"ち"],[27,3,"よげんしゃ"],[36,1,"かれ"],[38,1,"まえ"],[40,1,"ざ"],[59,1,"い"],[64,1,"おお"],[74,3,"よげんしゃ"],[86,2,"やさい"],[89,2,"にもの"]],"text":"エリシャはギルガルに帰ったが、その地にききんがあった。預言者のともがらが彼の前に座していたので、エリシャはそのしもべに言った、「大きなかまをすえて、預言者のともがらのために野菜の煮物をつくりなさい」。"},{"ref":"2Kgs.4.39","start":12004039,"end":12004039,"break":"none","ruby":[[0,1,"かれ"],[10,1,"はたけ"],[12,1,"で"],[17,2,"あおもの"],[27,1,"くさ"],[33,1,"み"],[38,1,"の"],[43,1,"つつみ"],[50,2,"にもの"],[56,1,"なか"],[58,1,"き"],[60,1,"こ"],[64,1,"かれ"],[70,1,"なに"],[76,1,"し"]],"text":"彼らのうちのひとりが畑に出ていって青物をつんだが、つる草のあるのを見て、その野うりを一包つんできて、煮物のかまの中に切り込んだ。彼らはそれが何であるかを知らなかったからである。"},{"ref":"2Kgs.4.40","start":12004040,"end":12004040,"break":"none","ruby":[[6,1,"も"],[9,2,"ひとびと"],[12,1,"た"],[23,1,"かれ"],[28,2,"にもの"],[31,1,"た"],[38,1,"とき"],[40,1,"さけ"],[47,1,"かみ"],[49,1,"ひと"],[55,1,"なか"],[62,1,"し"],[76,1,"い"],[80,1,"た"]],"text":"やがてこれを盛って人々に食べさせようとしたが、彼らがその煮物を食べようとした時、叫んで、「ああ神の人よ、かまの中に、たべると死ぬものがはいっています」と言って、食べることができなかったので、"},{"ref":"2Kgs.4.41","start":12004041,"end":12004041,"break":"none","ruby":[[10,1,"こな"],[12,1,"も"],[15,1,"き"],[21,1,"い"],[31,1,"な"],[33,1,"い"],[37,1,"も"],[40,2,"ひとびと"],[43,1,"た"],[52,1,"い"],[59,1,"なか"],[66,2,"どくぶつ"]],"text":"エリシャは「それでは粉を持って来なさい」と言って、それをかまに投げ入れ、「盛って人々に食べさせなさい」と言った。かまの中には、なんの毒物もなくなった。"},{"ref":"2Kgs.4.42","start":12004042,"end":12004042,"break":"paragraph","ruby":[[2,1,"とき"],[15,1,"ひと"],[20,2,"はつほ"],[27,2,"おおむぎ"],[34,1,"こ"],[37,2,"しんこく"],[40,1,"ふくろ"],[43,1,"かみ"],[45,1,"ひと"],[50,1,"も"],[64,2,"ひとびと"],[67,1,"あた"],[70,1,"た"],[79,1,"い"]],"text":"その時、バアル・シャリシャから人がきて、初穂のパンと、大麦のパン二十個と、新穀一袋とを神の人のもとに持ってきたので、エリシャは「人々に与えて食べさせなさい」と言ったが、"},{"ref":"2Kgs.4.43","start":12004043,"end":12004043,"break":"none","ruby":[[2,2,"めしつかい"],[5,1,"い"],[18,1,"にん"],[20,1,"まえ"],[22,1,"そな"],[34,1,"かれ"],[36,1,"い"],[41,2,"ひとびと"],[44,1,"あた"],[47,1,"た"],[55,1,"しゅ"],[59,1,"い"],[65,1,"かれ"],[68,1,"た"],[73,1,"あま"]],"text":"その召使は言った、「どうしてこれを百人の前に供えるのですか」。しかし彼は言った、「人々に与えて食べさせなさい。主はこう言われる、『彼らは食べてなお余すであろう』」。"},{"ref":"2Kgs.4.44","start":12004044,"end":12004044,"break":"none","ruby":[[3,1,"かれ"],[8,1,"かれ"],[11,1,"まえ"],[13,1,"そな"],[19,1,"かれ"],[22,1,"た"],[27,1,"あま"],[31,1,"しゅ"],[33,2,"ことば"]],"text":"そこで彼はそれを彼らの前に供えたので、彼らは食べてなお余した。主の言葉のとおりであった。"}]