[{"ref":"1Chr.2.1","start":13002001,"end":13002001,"break":"paragraph","ruby":[[6,1,"こ"],[9,1,"つぎ"]],"text":"イスラエルの子らは次のとおりである。ルベン、シメオン、レビ、ユダ、イッサカル、ゼブルン、"},{"ref":"1Chr.2.2","start":13002002,"end":13002002,"break":"none","text":"ダン、ヨセフ、ベニヤミン、ナフタリ、ガド、アセル。"},{"ref":"1Chr.2.3","start":13002003,"end":13002003,"break":"none","ruby":[[3,1,"こ"],[22,1,"にん"],[28,1,"おんな"],[41,1,"う"],[44,1,"もの"],[52,2,"ちょうし"],[57,1,"しゅ"],[59,1,"まえ"],[61,1,"あく"],[63,1,"おこな"],[69,1,"しゅ"],[71,1,"かれ"],[73,1,"ころ"]],"text":"ユダの子らはエル、オナン、シラである。この三人はカナンの女バテシュアがユダによって産んだ者である。ユダの長子エルは主の前に悪を行ったので、主は彼を殺された。"},{"ref":"1Chr.2.4","start":13002004,"end":13002004,"break":"none","ruby":[[3,1,"よめ"],[21,1,"う"],[28,1,"こ"],[31,1,"あ"],[36,1,"にん"]],"text":"ユダの嫁タマルはユダによってペレヅとゼラを産んだ。ユダの子らは合わせて五人である。"},{"ref":"1Chr.2.5","start":13002005,"end":13002005,"break":"paragraph","ruby":[[4,1,"こ"]],"text":"ペレヅの子らはヘヅロンとハムル。"},{"ref":"1Chr.2.6","start":13002006,"end":13002006,"break":"none","ruby":[[3,1,"こ"],[27,1,"あ"],[32,1,"にん"]],"text":"ゼラの子らはジムリ、エタン、ヘマン、カルコル、ダラで、合わせて五人である。"},{"ref":"1Chr.2.7","start":13002007,"end":13002007,"break":"none","ruby":[[4,1,"こ"],[14,3,"ほうのうぶつ"],[21,1,"つみ"],[23,1,"おか"],[32,1,"なや"],[36,1,"もの"]],"text":"カルミの子はアカル。アカルは奉納物について罪を犯し、イスラエルを悩ました者である。"},{"ref":"1Chr.2.8","start":13002008,"end":13002008,"break":"none","ruby":[[4,1,"こ"]],"text":"エタンの子はアザリヤである。"},{"ref":"1Chr.2.9","start":13002009,"end":13002009,"break":"paragraph","ruby":[[5,1,"うま"],[8,1,"こ"]],"text":"ヘヅロンに生れた子らはエラメル、ラム、ケルバイである。"},{"ref":"1Chr.2.10","start":13002010,"end":13002010,"break":"none","ruby":[[9,1,"う"],[21,2,"しそん"],[32,1,"う"]],"text":"ラムはアミナダブを生み、アミナダブはユダの子孫のつかさナションを生んだ。"},{"ref":"1Chr.2.11","start":13002011,"end":13002011,"break":"none","ruby":[[9,1,"う"],[20,1,"う"]],"text":"ナションはサルマを生み、サルマはボアズを生み、"},{"ref":"1Chr.2.12","start":13002012,"end":13002012,"break":"none","ruby":[[8,1,"う"],[20,1,"う"]],"text":"ボアズはオベデを生み、オベデはエッサイを生んだ。"},{"ref":"1Chr.2.13","start":13002013,"end":13002013,"break":"none","ruby":[[5,2,"ちょうし"],[12,1,"つぎ"],[20,1,"だい"]],"text":"エッサイは長子エリアブ、次にアビナダブ、第三にシメア、"},{"ref":"1Chr.2.14","start":13002014,"end":13002014,"break":"none","ruby":[[0,1,"だい"],[9,1,"だい"]],"text":"第四にネタンエル、第五にラダイ、"},{"ref":"1Chr.2.15","start":13002015,"end":13002015,"break":"none","ruby":[[0,1,"だい"],[7,1,"だい"],[14,1,"う"]],"text":"第六にオゼム、第七にダビデを生んだ。"},{"ref":"1Chr.2.16","start":13002016,"end":13002016,"break":"none","ruby":[[0,1,"かれ"],[3,2,"しまい"],[23,1,"う"],[26,1,"こ"],[44,1,"にん"]],"text":"彼らの姉妹はゼルヤとアビガイルである。ゼルヤの産んだ子はアビシャイ、ヨアブ、アサヘルの三人である。"},{"ref":"1Chr.2.17","start":13002017,"end":13002017,"break":"none","ruby":[[10,1,"う"],[18,1,"ちち"]],"text":"アビガイルはアマサを産んだ。アマサの父はイシマエルびとエテルである。"},{"ref":"1Chr.2.18","start":13002018,"end":13002018,"break":"paragraph","ruby":[[5,1,"こ"],[12,1,"つま"],[27,1,"こ"],[36,1,"こ"]],"text":"ヘヅロンの子カレブはその妻アズバおよびエリオテによって子をもうけた。その子らはエシル、ショバブ、アルドンである。"},{"ref":"1Chr.2.19","start":13002019,"end":13002019,"break":"none","ruby":[[8,1,"し"],[38,1,"う"]],"text":"カレブはアズバが死んだのでエフラタをめとった。エフラタはカレブによってホルを産んだ。"},{"ref":"1Chr.2.20","start":13002020,"end":13002020,"break":"none","ruby":[[6,1,"う"],[17,1,"う"]],"text":"ホルはウリを生み、ウリはベザレルを生んだ。"},{"ref":"1Chr.2.21","start":13002021,"end":13002021,"break":"paragraph","ruby":[[14,1,"ちち"],[19,1,"むすめ"],[21,1,"ところ"],[28,1,"かれ"],[30,2,"かのじょ"],[42,1,"さい"],[48,2,"かのじょ"],[63,1,"う"]],"text":"そののちヘヅロンはギレアデの父マキルの娘の所にはいった。彼が彼女をめとったときは六十歳であった。彼女はヘヅロンによってセグブを産んだ。"},{"ref":"1Chr.2.22","start":13002022,"end":13002022,"break":"none","ruby":[[8,1,"う"],[21,1,"ち"],[27,1,"まち"]],"text":"セグブはヤイルを生んだ。ヤイルはギレアデの地に二十三の町をもっていた。"},{"ref":"1Chr.2.23","start":13002023,"end":13002023,"break":"none","ruby":[[12,1,"かれ"],[32,2,"むらざと"],[36,1,"あ"],[43,1,"まち"],[45,1,"と"],[60,1,"ちち"],[65,2,"しそん"]],"text":"しかしゲシュルとアラムは彼らからハボテ・ヤイルおよびケナテとその村里など合わせて六十の町を取った。これらはみなギレアデの父マキルの子孫であった。"},{"ref":"1Chr.2.24","start":13002024,"end":13002024,"break":"none","ruby":[[5,1,"し"],[15,1,"ちち"],[21,1,"つま"],[27,1,"ところ"],[34,2,"かのじょ"],[37,1,"かれ"],[43,1,"ちち"],[49,1,"う"]],"text":"ヘヅロンが死んだのち、カレブは父ヘヅロンの妻エフラタの所にはいった。彼女は彼にテコアの父アシュルを産んだ。"},{"ref":"1Chr.2.25","start":13002025,"end":13002025,"break":"paragraph","ruby":[[5,2,"ちょうし"],[12,1,"こ"],[15,2,"ちょうし"],[20,1,"つぎ"]],"text":"ヘヅロンの長子エラメルの子らは長子ラム、次はブナ、オレン、オゼム、アヒヤである。"},{"ref":"1Chr.2.26","start":13002026,"end":13002026,"break":"none","ruby":[[10,1,"つま"],[18,1,"な"],[32,1,"はは"]],"text":"エラメルはまたほかの妻をもっていた。名をアタラといって、オナムの母である。"},{"ref":"1Chr.2.27","start":13002027,"end":13002027,"break":"none","ruby":[[5,2,"ちょうし"],[10,1,"こ"]],"text":"エラメルの長子ラムの子らはマアツ、ヤミン、エケルである。"},{"ref":"1Chr.2.28","start":13002028,"end":13002028,"break":"none","ruby":[[4,1,"こ"],[25,1,"こ"]],"text":"オナムの子らはシャンマイとヤダである。シャンマイの子らはナダブとアビシュルである。"},{"ref":"1Chr.2.29","start":13002029,"end":13002029,"break":"none","ruby":[[6,1,"つま"],[8,1,"な"],[28,1,"う"]],"text":"アビシュルの妻の名はアビハイルといって、アバンとモリデを産んだ。"},{"ref":"1Chr.2.30","start":13002030,"end":13002030,"break":"none","ruby":[[4,1,"こ"],[24,1,"こ"],[30,1,"し"]],"text":"ナダブの子らはセレデとアッパイムである。セレデは子をもたずに死んだ。"},{"ref":"1Chr.2.31","start":13002031,"end":13002031,"break":"none","ruby":[[6,1,"こ"],[14,1,"こ"],[26,1,"こ"]],"text":"アッパイムの子はイシ、イシの子はセシャン、セシャンの子はアヘライである。"},{"ref":"1Chr.2.32","start":13002032,"end":13002032,"break":"none","ruby":[[6,2,"きょうだい"],[11,1,"こ"],[30,1,"こ"],[36,1,"し"]],"text":"シャンマイの兄弟ヤダの子らはエテルとヨナタンである。エテルは子をもたずに死んだ。"},{"ref":"1Chr.2.33","start":13002033,"end":13002033,"break":"none","ruby":[[5,1,"こ"],[18,2,"いじょう"],[26,2,"しそん"]],"text":"ヨナタンの子らはペレテとザザである。以上はエラメルの子孫である。"},{"ref":"1Chr.2.34","start":13002034,"end":13002034,"break":"none","ruby":[[6,1,"おとこ"],[8,1,"こ"],[15,1,"おんな"],[17,1,"こ"],[26,1,"かれ"],[32,1,"よ"],[41,2,"どれい"]],"text":"セシャンには男の子はなく、ただ女の子のみであったが、彼はヤルハと呼ぶエジプトびとの奴隷をもっていたので、"},{"ref":"1Chr.2.35","start":13002035,"end":13002035,"break":"none","ruby":[[5,1,"むすめ"],[7,2,"どれい"],[13,1,"あた"],[18,1,"つま"],[24,2,"かのじょ"],[39,1,"う"]],"text":"セシャンは娘を奴隷ヤルハに与えてその妻とさせた。彼女はヤルハによってアッタイを産んだ。"},{"ref":"1Chr.2.36","start":13002036,"end":13002036,"break":"none","ruby":[[9,1,"う"],[20,1,"う"]],"text":"アッタイはナタンを生み、ナタンはザバデを生み、"},{"ref":"1Chr.2.37","start":13002037,"end":13002037,"break":"none","ruby":[[9,1,"う"],[21,1,"う"]],"text":"ザバデはエフラルを生み、エフラルはオベデを生み、"},{"ref":"1Chr.2.38","start":13002038,"end":13002038,"break":"none","ruby":[[8,1,"う"],[20,1,"う"]],"text":"オベデはエヒウを生み、エヒウはアザリヤを生み、"},{"ref":"1Chr.2.39","start":13002039,"end":13002039,"break":"none","ruby":[[9,1,"う"],[21,1,"う"]],"text":"アザリヤはヘレヅを生み、ヘレヅはエレアサを生み、"},{"ref":"1Chr.2.40","start":13002040,"end":13002040,"break":"none","ruby":[[10,1,"う"],[23,1,"う"]],"text":"エレアサはシスマイを生み、シスマイはシャルムを生み、"},{"ref":"1Chr.2.41","start":13002041,"end":13002041,"break":"none","ruby":[[10,1,"う"],[24,1,"う"]],"text":"シャルムはエカミヤを生み、エカミヤはエリシャマを生んだ。"},{"ref":"1Chr.2.42","start":13002042,"end":13002042,"break":"paragraph","ruby":[[5,2,"きょうだい"],[14,1,"こ"],[17,2,"ちょうし"],[31,1,"ちち"],[41,1,"こ"]],"text":"エラメルの兄弟であるカレブの子らは長子をマレシャといってジフの父である。マレシャの子はヘブロン。"},{"ref":"1Chr.2.43","start":13002043,"end":13002043,"break":"none","ruby":[[5,1,"こ"]],"text":"ヘブロンの子らはコラ、タップア、レケム、シマである。"},{"ref":"1Chr.2.44","start":13002044,"end":13002044,"break":"none","ruby":[[7,1,"う"],[20,1,"ちち"],[37,1,"う"]],"text":"シマはラハムを生んだ。ラハムはヨルカムの父である。またレケムはシャンマイを生んだ。"},{"ref":"1Chr.2.45","start":13002045,"end":13002045,"break":"none","ruby":[[6,1,"こ"],[21,1,"ちち"]],"text":"シャンマイの子はマオン。マオンはベテヅルの父である。"},{"ref":"1Chr.2.46","start":13002046,"end":13002046,"break":"none","ruby":[[21,1,"う"],[33,1,"う"]],"text":"カレブのそばめエパはハラン、モザ、ガゼズを産んだ。ハランはガゼズを生んだ。"},{"ref":"1Chr.2.47","start":13002047,"end":13002047,"break":"none","ruby":[[4,1,"こ"]],"text":"エダイの子らはレゲム、ヨタム、ゲシャン、ペレテ、エパ、シャフである。"},{"ref":"1Chr.2.48","start":13002048,"end":13002048,"break":"none","ruby":[[20,1,"う"]],"text":"カレブのそばめマアカはシベルとテルハナを産み、"},{"ref":"1Chr.2.49","start":13002049,"end":13002049,"break":"none","ruby":[[8,1,"ちち"],[24,1,"ちち"],[28,1,"う"],[36,1,"むすめ"]],"text":"またマデマンナの父シャフおよびマクベナとギベアの父シワを産んだ。カレブの娘はアクサである。"},{"ref":"1Chr.2.50","start":13002050,"end":13002050,"break":"none","breaks":[[15,"paragraph"]],"ruby":[[8,2,"しそん"],[20,2,"ちょうし"],[25,1,"こ"],[37,1,"ちち"]],"text":"これらはカレブの子孫であった。エフラタの長子ホルの子らはキリアテ・ヤリムの父ショバル、"},{"ref":"1Chr.2.51","start":13002051,"end":13002051,"break":"none","ruby":[[6,1,"ちち"],[19,1,"ちち"]],"text":"ベツレヘムの父サルマおよびベテガデルの父ハレフである。"},{"ref":"1Chr.2.52","start":13002052,"end":13002052,"break":"none","ruby":[[9,1,"ちち"],[14,1,"こ"],[28,1,"なか"]],"text":"キリアテ・ヤリムの父ショバル子らはハロエとメヌコテびとの半ばである。"},{"ref":"1Chr.2.53","start":13002053,"end":13002053,"break":"none","ruby":[[9,2,"しぞく"],[60,1,"で"]],"text":"キリアテ・ヤリムの氏族はイテルびと、プテびと、シュマびと、ミシラびとであって、これらからザレアびとおよびエシタオルびとが出た。"},{"ref":"1Chr.2.54","start":13002054,"end":13002054,"break":"none","ruby":[[4,1,"こ"],[38,1,"なか"]],"text":"サルマの子らはベツレヘム、ネトパびと、アタロテ・ベテ・ヨアブ、マナハテびとの半ばおよびゾリびとである。"},{"ref":"1Chr.2.55","start":13002055,"end":13002055,"break":"none","ruby":[[6,1,"す"],[11,2,"しょき"],[14,2,"しぞく"],[54,1,"いえ"],[56,2,"せんぞ"],[63,1,"で"],[65,1,"もの"]],"text":"またヤベヅに住んでいた書記の氏族テラテびと、シメアテびと、スカテびとである。これらはケニびとであってレカブの家の先祖ハマテから出た者である。"}]