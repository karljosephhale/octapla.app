[{"ref":"2Chr.34.1","start":14034001,"end":14034001,"break":"paragraph","ruby":[[5,1,"さい"],[9,1,"おう"],[23,1,"ねん"],[25,1,"あいだ"],[26,1,"よ"],[28,1,"おさ"]],"text":"ヨシヤは八歳のとき王となり、エルサレムで三十一年の間世を治めた。"},{"ref":"2Chr.34.2","start":14034002,"end":14034002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"よ"],[7,1,"み"],[19,1,"ちち"],[24,1,"みち"],[26,1,"あゆ"],[30,1,"みぎ"],[33,1,"ひだり"],[36,1,"まが"]],"text":"彼は主の良しと見られることをなし、その父ダビデの道を歩んで、右にも左にも曲らなかった。"},{"ref":"2Chr.34.3","start":14034003,"end":14034003,"break":"none","ruby":[[0,1,"かれ"],[4,1,"わか"],[12,2,"ちせい"],[15,1,"だい"],[17,1,"ねん"],[19,1,"ちち"],[24,1,"かみ"],[26,1,"もと"],[32,1,"はじ"],[39,1,"ねん"],[42,1,"たか"],[44,1,"ところ"],[49,1,"ぞう"],[51,1,"きざ"],[54,1,"ぞう"],[56,1,"い"],[58,1,"ぞう"],[62,1,"のぞ"],[75,1,"きよ"],[81,1,"はじ"]],"text":"彼はまだ若かったが、その治世の第八年に父ダビデの神を求めることを始め、その十二年には高き所、アシラ像、刻んだ像、鋳た像などを除いて、ユダとエルサレムを清めることを始め、"},{"ref":"2Chr.34.4","start":14034004,"end":14034004,"break":"none","ruby":[[9,2,"さいだん"],[13,2,"じぶん"],[16,1,"まえ"],[18,1,"う"],[27,1,"うえ"],[29,1,"た"],[34,1,"こう"],[36,2,"さいだん"],[39,1,"き"],[41,1,"たお"],[47,1,"ぞう"],[49,1,"きざ"],[52,1,"ぞう"],[54,1,"い"],[56,1,"ぞう"],[58,1,"う"],[60,1,"くだ"],[63,2,"こなごな"],[72,1,"ぞう"],[74,2,"ぎせい"],[81,1,"もの"],[85,1,"はか"],[87,1,"うえ"],[94,1,"ち"]],"text":"もろもろのバアルの祭壇を、自分の前で打ちこわさせ、その上に立っていた香の祭壇を切り倒し、アシラ像、刻んだ像、鋳た像を打ち砕いて粉々にし、これらの像に犠牲をささげた者どもの墓の上にそれをまき散らし、"},{"ref":"2Chr.34.5","start":14034005,"end":14034005,"break":"none","ruby":[[0,2,"さいし"],[4,1,"ほね"],[13,2,"さいだん"],[16,1,"うえ"],[18,1,"や"],[34,1,"きよ"]],"text":"祭司らの骨をそのもろもろの祭壇の上で焼き、こうしてユダとエルサレムを清めた。"},{"ref":"2Chr.34.6","start":14034006,"end":14034006,"break":"none","ruby":[[24,1,"あ"],[27,2,"まちまち"]],"text":"またマナセ、エフライム、シメオンおよびナフタリの荒れた町々にもこのようにし、"},{"ref":"2Chr.34.7","start":14034007,"end":14034007,"break":"none","ruby":[[5,2,"さいだん"],[15,1,"ぞう"],[24,1,"きざ"],[27,1,"ぞう"],[29,2,"こなごな"],[32,1,"う"],[34,1,"くだ"],[42,2,"ぜんこく"],[45,1,"こう"],[47,2,"さいだん"],[55,1,"き"],[57,1,"たお"],[67,1,"かえ"]],"text":"もろもろの祭壇をこわし、アシラ像およびもろもろの刻んだ像を粉々に打ち砕き、イスラエル全国の香の祭壇をことごとく切り倒して、エルサレムに帰った。"},{"ref":"2Chr.34.8","start":14034008,"end":14034008,"break":"paragraph","ruby":[[6,2,"ちせい"],[11,1,"ねん"],[14,1,"くに"],[16,1,"みや"],[19,1,"きよ"],[22,1,"とき"],[26,1,"かみ"],[28,1,"しゅ"],[30,1,"みや"],[32,1,"つくろ"],[44,1,"こ"],[50,1,"まち"],[67,1,"こ"],[68,2,"しかん"]],"text":"ヨシヤはその治世の十八年に、国と宮とを清めた時、その神、主の宮を繕わせようと、アザリヤの子シャパン、町のつかさマアセヤおよびヨアハズの子史官ヨアをつかわした。"},{"ref":"2Chr.34.9","start":14034009,"end":14034009,"break":"none","ruby":[[0,1,"かれ"],[3,1,"だい"],[4,2,"さいし"],[14,1,"い"],[18,1,"かみ"],[20,1,"みや"],[26,1,"かね"],[28,1,"わた"],[35,1,"もん"],[37,1,"まも"],[58,1,"た"],[87,1,"ひと"],[98,2,"じゅうみん"],[101,1,"て"],[104,1,"あつ"]],"text":"彼らは大祭司ヒルキヤのもとへ行って、神の宮にはいった金を渡した。これは門を守るレビびとがマナセ、エフライムおよびその他のすべてのイスラエル、ならびにユダとベニヤミンのすべての人、およびエルサレムの住民の手から集めたものである。"},{"ref":"2Chr.34.10","start":14034010,"end":14034010,"break":"none","ruby":[[0,1,"かれ"],[6,1,"しゅ"],[8,1,"みや"],[10,2,"かんとく"],[14,2,"しょっこう"],[18,1,"て"],[20,1,"わた"],[26,1,"しゅ"],[28,1,"みや"],[30,1,"はたら"],[32,2,"しょっこう"],[40,1,"みや"],[42,1,"つくろ"],[44,1,"なお"],[49,2,"しはら"]],"text":"彼らはこれを主の宮を監督する職工らの手に渡したので、主の宮で働く職工らは、これを宮を繕い直すために支払った。"},{"ref":"2Chr.34.11","start":14034011,"end":14034011,"break":"none","ruby":[[5,2,"だいく"],[10,3,"けんちくしゃ"],[17,1,"わた"],[24,1,"おう"],[28,1,"やぶ"],[31,2,"たてもの"],[38,1,"き"],[40,1,"いし"],[44,2,"ほねぐみ"],[47,2,"ざいもく"],[50,1,"か"],[54,1,"はり"],[55,1,"ざい"],[57,1,"ととの"]],"text":"すなわち、大工および建築者にこれを渡して、ユダの王たちが破った建物のために、切り石および骨組の材木を買わせ、梁材を整えさせた。"},{"ref":"2Chr.34.12","start":14034012,"end":14034012,"break":"none","ruby":[[2,2,"ひとびと"],[5,2,"ちゅうじつ"],[8,2,"しごと"],[16,2,"かんとく"],[18,1,"しゃ"],[24,2,"しそん"],[51,2,"しそん"],[71,2,"こうじ"],[83,2,"がっき"],[86,1,"たく"],[97,1,"ともな"]],"text":"その人々は忠実に仕事をした。その監督者はメラリの子孫であるレビびとヤハテとオバデヤ、およびコハテびとの子孫であるゼカリヤとメシュラムであって、工事をつかさどった。また楽器に巧みなレビびとがこれに伴った。"},{"ref":"2Chr.34.13","start":14034013,"end":14034013,"break":"none","ruby":[[0,1,"かれ"],[5,1,"に"],[7,1,"お"],[9,1,"もの"],[11,2,"かんとく"],[15,2,"さまざま"],[18,2,"しごと"],[21,1,"はたら"],[27,1,"もの"],[38,1,"た"],[45,2,"しょき"],[51,2,"やくにん"],[59,2,"もんえい"]],"text":"彼らはまた荷を負う者を監督し、様々の仕事に働くすべての者をつかさどった。また他のレビびとは書記となり、役人となり、また門衛となった。"},{"ref":"2Chr.34.14","start":14034014,"end":14034014,"break":"paragraph","ruby":[[2,1,"かれ"],[5,1,"しゅ"],[7,1,"みや"],[13,1,"かね"],[15,1,"と"],[20,1,"とき"],[22,2,"さいし"],[33,1,"つた"],[36,1,"しゅ"],[38,2,"りっぽう"],[41,1,"しょ"],[43,2,"はっけん"]],"text":"さて彼らが主の宮にはいった金を取りだした時、祭司ヒルキヤはモーセの伝えた主の律法の書を発見した。"},{"ref":"2Chr.34.15","start":14034015,"end":14034015,"break":"none","ruby":[[8,3,"しょきかん"],[16,1,"い"],[25,1,"しゅ"],[27,1,"みや"],[29,2,"りっぽう"],[32,1,"しょ"],[34,2,"はっけん"],[53,1,"しょ"],[60,1,"わた"]],"text":"そこでヒルキヤは書記官シャパンに言った、「わたしは主の宮で律法の書を発見しました」と。そしてヒルキヤはその書をシャパンに渡した。"},{"ref":"2Chr.34.16","start":14034016,"end":14034016,"break":"none","ruby":[[7,1,"しょ"],[9,1,"おう"],[14,1,"も"],[17,1,"い"],[23,1,"おう"],[25,2,"ふくめい"],[29,1,"い"],[45,1,"こと"]],"text":"シャパンはその書を王のもとに持って行き、さらに王に復命して言った、「しもべらはゆだねられた事をことごとくなし、"},{"ref":"2Chr.34.17","start":14034017,"end":14034017,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"みや"],[7,1,"かね"],[13,2,"かんとく"],[15,1,"しゃ"],[17,1,"て"],[21,2,"しょっこう"],[24,1,"て"],[26,1,"わた"]],"text":"主の宮にあった金をあけて、監督者の手および職工の手に渡しました」。"},{"ref":"2Chr.34.18","start":14034018,"end":14034018,"break":"none","ruby":[[0,3,"しょきかん"],[10,1,"おう"],[12,1,"つ"],[17,2,"さいし"],[31,2,"しょもつ"],[34,1,"わた"],[41,1,"い"],[52,1,"おう"],[54,1,"まえ"],[56,1,"よ"]],"text":"書記官シャパンはまた王に告げて、「祭司ヒルキヤはわたしに一つの書物を渡しました」と言い、シャパンはそれを王の前で読んだ。"},{"ref":"2Chr.34.19","start":14034019,"end":14034019,"break":"none","ruby":[[0,1,"おう"],[4,2,"りっぽう"],[7,2,"ことば"],[10,1,"き"],[13,1,"ころも"],[15,1,"さ"]],"text":"王はその律法の言葉を聞いて衣を裂いた。"},{"ref":"2Chr.34.20","start":14034020,"end":14034020,"break":"none","ruby":[[3,1,"おう"],[17,1,"こ"],[26,1,"こ"],[32,3,"しょきかん"],[40,1,"おう"],[42,2,"けらい"],[49,1,"めい"],[52,1,"い"]],"text":"そして王はヒルキヤおよびシャパンの子アヒカムとミカの子アブドンと書記官シャパンと王の家来アサヤとに命じて言った、"},{"ref":"2Chr.34.21","start":14034021,"end":14034021,"break":"none","ruby":[[7,1,"い"],[13,2,"はっけん"],[18,2,"しょもつ"],[21,2,"ことば"],[46,1,"のこ"],[49,1,"もの"],[54,1,"しゅ"],[56,1,"と"],[67,2,"せんぞ"],[72,1,"しゅ"],[74,2,"ことば"],[77,1,"まも"],[86,2,"しょもつ"],[99,1,"おこな"],[108,1,"しゅ"],[115,1,"おお"],[119,1,"いか"],[122,1,"そそ"]],"text":"「あなたがたは行って、この発見された書物の言葉についてわたしのために、またイスラエルとユダの残りの者のために主に問いなさい。われわれの先祖たちが主の言葉を守らず、すべてこの書物にしるされていることを行わなかったので、主はわれわれに大いなる怒りを注がれるからです」。"},{"ref":"2Chr.34.22","start":14034022,"end":14034022,"break":"paragraph","ruby":[[10,1,"おう"],[17,2,"ひとびと"],[26,1,"つま"],[30,1,"おんな"],[31,3,"よげんしゃ"],[41,1,"い"],[54,1,"こ"],[63,1,"こ"],[66,2,"いしょう"],[69,1,"まも"],[71,1,"もの"],[76,1,"とき"],[89,1,"だい"],[91,1,"く"],[93,1,"す"],[99,1,"かれ"],[108,2,"しゅい"],[111,1,"かた"]],"text":"そこでヒルキヤおよび王のつかわした人々は、シャルムの妻である女預言者ホルダのもとへ行った。シャルムはハスラの子であるトクハテの子で、衣装を守る者である。時にホルダは、エルサレムの第二区に住んでいた。彼らはホルダにその趣意を語ったので、"},{"ref":"2Chr.34.23","start":14034023,"end":14034023,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[18,1,"かみ"],[20,1,"しゅ"],[24,1,"おお"],[47,1,"ひと"],[49,1,"つ"]],"text":"ホルダは彼らに言った、「イスラエルの神、主はこう仰せられます、『あなたがたをわたしにつかわした人に告げなさい。"},{"ref":"2Chr.34.24","start":14034024,"end":14034024,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"おお"],[11,1,"み"],[21,1,"おう"],[23,1,"まえ"],[25,1,"よ"],[28,2,"しょもつ"],[51,1,"わざわい"],[55,1,"ところ"],[61,1,"す"],[63,1,"もの"],[65,1,"くだ"]],"text":"主はこう仰せられます。見よ、わたしはユダの王の前で読んだ書物にしるされているもろもろののろい、すなわち災をこの所と、ここに住む者に下す。"},{"ref":"2Chr.34.25","start":14034025,"end":14034025,"break":"none","ruby":[[0,1,"かれ"],[7,1,"す"],[11,1,"た"],[13,2,"かみがみ"],[16,1,"こう"],[21,2,"じぶん"],[24,1,"て"],[26,1,"つく"],[34,1,"もの"],[44,1,"いか"],[47,1,"ひ"],[49,1,"おこ"],[70,1,"いか"],[76,1,"ところ"],[78,1,"そそ"],[82,1,"き"]],"text":"彼らはわたしを捨てて、他の神々に香をたき、自分の手で造ったもろもろの物をもって、わたしの怒りを引き起そうとしたからである。それゆえ、わたしの怒りは、この所に注がれて消えない。"},{"ref":"2Chr.34.26","start":14034026,"end":14034026,"break":"none","ruby":[[15,1,"しゅ"],[17,1,"と"],[24,1,"おう"],[29,1,"い"],[41,1,"かみ"],[43,1,"しゅ"],[47,1,"おお"],[57,1,"き"],[60,2,"ことば"]],"text":"しかしあなたがたをつかわして、主に問わせるユダの王にはこう言いなさい。イスラエルの神、主はこう仰せられる。あなたが聞いた言葉については、"},{"ref":"2Chr.34.27","start":14034027,"end":14034027,"break":"none","ruby":[[2,1,"ところ"],[8,1,"す"],[10,1,"もの"],[12,1,"せ"],[15,1,"かみ"],[17,2,"ことば"],[25,1,"き"],[28,1,"とき"],[30,1,"こころ"],[32,1,"く"],[35,1,"かみ"],[37,1,"まえ"],[39,1,"み"],[50,1,"まえ"],[58,1,"ころも"],[60,1,"さ"],[68,1,"まえ"],[70,1,"な"],[87,1,"き"],[92,1,"しゅ"],[94,1,"い"]],"text":"この所と、ここに住む者を責める神の言葉を、あなたが聞いた時、心に悔い、神の前に身をひくくし、わたしの前にへりくだり、衣を裂いて、わたしの前に泣いたので、わたしもまた、あなたに聞いた、と主は言われる。"},{"ref":"2Chr.34.28","start":14034028,"end":14034028,"break":"none","ruby":[[0,1,"み"],[11,2,"せんぞ"],[19,1,"あつ"],[27,1,"やす"],[35,1,"はか"],[37,1,"あつ"],[53,1,"ところ"],[59,1,"す"],[61,1,"もの"],[63,1,"くだ"],[70,1,"わざわい"],[72,1,"め"],[74,1,"み"],[85,1,"かれ"],[88,1,"おう"],[90,2,"ふくめい"]],"text":"見よ、わたしはあなたを先祖たちのもとに集める。あなたは安らかにあなたの墓に集められる。あなたはわたしがこの所と、ここに住む者に下すもろもろの災を目に見ることがない』と」。彼らは王に復命した。"},{"ref":"2Chr.34.29","start":14034029,"end":14034029,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"ひと"],[21,2,"ちょうろう"],[29,1,"あつ"]],"text":"そこで王は人をつかわしてユダとエルサレムの長老をことごとく集め、"},{"ref":"2Chr.34.30","start":14034030,"end":14034030,"break":"none","ruby":[[3,1,"おう"],[5,1,"しゅ"],[7,1,"みや"],[9,1,"のぼ"],[12,1,"い"],[23,2,"ひとびと"],[32,2,"じゅうみん"],[35,2,"さいし"],[50,1,"たみ"],[53,1,"お"],[56,1,"もの"],[58,1,"わか"],[60,1,"もの"],[67,1,"かれ"],[69,1,"したが"],[76,1,"おう"],[78,1,"しゅ"],[80,1,"みや"],[82,2,"はっけん"],[86,2,"けいやく"],[89,1,"しょ"],[91,2,"ことば"],[100,1,"かれ"],[103,1,"みみ"],[105,1,"よ"],[107,1,"き"]],"text":"そして王は主の宮に上って行った。ユダのすべての人々、エルサレムの住民、祭司、レビびと、およびすべての民は、老いた者も若い者もことごとく彼に従った。そこで王は主の宮で発見した契約の書の言葉を、ことごとく彼らの耳に読み聞かせ、"},{"ref":"2Chr.34.31","start":14034031,"end":14034031,"break":"none","ruby":[[3,1,"おう"],[5,2,"じぶん"],[8,1,"ところ"],[10,1,"た"],[14,1,"しゅ"],[16,1,"まえ"],[18,2,"けいやく"],[21,1,"た"],[24,1,"しゅ"],[26,1,"したが"],[29,1,"あゆ"],[32,1,"こころ"],[38,2,"せいしん"],[48,1,"いまし"],[56,1,"さだ"],[66,1,"しょ"],[73,2,"けいやく"],[76,2,"ことば"],[79,1,"おこな"],[83,1,"い"]],"text":"そして王は自分の所に立って、主の前に契約を立て、主に従って歩み、心をつくし、精神をつくして、その戒めと、あかしと定めとをまもり、この書にしるされた契約の言葉を行おうと言い、"},{"ref":"2Chr.34.32","start":14034032,"end":14034032,"break":"none","ruby":[[14,2,"ひとびと"],[17,1,"みな"],[21,1,"くわ"],[33,2,"じゅうみん"],[36,2,"せんぞ"],[39,1,"かみ"],[45,1,"かみ"],[47,2,"けいやく"],[55,1,"い"]],"text":"エルサレムおよびベニヤミンの人々を皆これに加わらせた。エルサレムの住民は先祖の神であるその神の契約にしたがって行った。"},{"ref":"2Chr.34.33","start":14034033,"end":14034033,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"ぞく"],[20,1,"ち"],[24,1,"にく"],[36,1,"と"],[38,1,"のぞ"],[53,1,"ひと"],[57,1,"かみ"],[59,1,"しゅ"],[61,1,"つか"],[71,1,"よ"],[75,1,"ひ"],[77,1,"あいだ"],[80,1,"かれ"],[83,2,"せんぞ"],[86,1,"かみ"],[88,1,"しゅ"],[90,1,"したが"],[93,1,"はな"]],"text":"ヨシヤはイスラエルの人々に属するすべての地から、憎むべきものをことごとく取り除き、イスラエルにいるすべての人をその神、主に仕えさせた。ヨシヤが世にある日の間は、彼らは先祖の神、主に従って離れなかった。"}]