[{"ref":"1Chr.24.1","start":13024001,"end":13024001,"break":"paragraph","ruby":[[4,2,"しそん"],[7,1,"くみ"],[9,1,"つぎ"],[26,1,"こ"]],"text":"アロンの子孫の組は次のとおりである。すなわちアロンの子らはナダブ、アビウ、エレアザル、イタマル。"},{"ref":"1Chr.24.2","start":13024002,"end":13024002,"break":"none","ruby":[[10,1,"ちち"],[12,1,"さき"],[16,1,"し"],[19,1,"こ"],[39,2,"さいし"]],"text":"ナダブとアビウはその父に先だって死に、子がなかったので、エレアザルとイタマルが祭司となった。"},{"ref":"1Chr.24.3","start":13024003,"end":13024003,"break":"none","ruby":[[10,2,"しそん"],[21,2,"しそん"],[29,1,"たす"],[35,1,"かれ"],[38,1,"わ"],[47,1,"つと"]],"text":"ダビデはエレアザルの子孫ザドクとイタマルの子孫アヒメレクの助けによって彼らを分けて、それぞれの勤めにつけた。"},{"ref":"1Chr.24.4","start":13024004,"end":13024004,"break":"none","ruby":[[6,2,"しそん"],[18,2,"しそん"],[26,1,"ちょう"],[29,2,"ひとびと"],[32,1,"おお"],[46,2,"しそん"],[49,2,"しぞく"],[52,1,"ちょう"],[58,1,"にん"],[66,2,"しそん"],[69,2,"しぞく"],[72,1,"ちょう"],[76,1,"もの"],[78,1,"にん"],[83,1,"わ"]],"text":"エレアザルの子孫のうちにはイタマルの子孫のうちよりも長たる人々が多かった。それでエレアザルの子孫で氏族の長である十六人と、イタマルの子孫で氏族の長である者八人にこれを分けた。"},{"ref":"1Chr.24.5","start":13024005,"end":13024005,"break":"none","ruby":[[5,1,"かれ"],[8,1,"みな"],[20,1,"わ"],[26,2,"せいじょ"],[36,1,"かみ"],[52,2,"しそん"],[60,2,"しそん"],[64,1,"で"]],"text":"このように彼らは皆ひとしく、くじによって分けられた。聖所のつかさ、および神のつかさは、ともにエレアザルの子孫とイタマルの子孫から出たからである。"},{"ref":"1Chr.24.6","start":13024006,"end":13024006,"break":"none","ruby":[[9,1,"こ"],[13,2,"しょき"],[20,1,"おう"],[28,2,"さいし"],[40,1,"こ"],[47,2,"さいし"],[57,2,"しぞく"],[60,1,"ちょう"],[64,1,"まえ"],[70,1,"か"],[90,2,"しぞく"],[95,1,"と"],[111,1,"と"]],"text":"レビびとネタネルの子である書記シマヤは、王とつかさたちと祭司ザドクとアビヤタルの子アヒメレクと祭司およびレビびとの氏族の長たちの前で、これを書きしるした。すなわちエレアザルのために氏族一つを取れば、イタマルのためにも一つを取った。"},{"ref":"1Chr.24.7","start":13024007,"end":13024007,"break":"paragraph","ruby":[[0,1,"だい"],[11,1,"あた"],[14,1,"だい"],[21,1,"あた"]],"text":"第一のくじはヨアリブに当り、第二はエダヤに当り、"},{"ref":"1Chr.24.8","start":13024008,"end":13024008,"break":"none","ruby":[[0,1,"だい"],[8,1,"だい"]],"text":"第三はハリムに、第四はセオリムに、"},{"ref":"1Chr.24.9","start":13024009,"end":13024009,"break":"none","ruby":[[0,1,"だい"],[9,1,"だい"]],"text":"第五はマルキヤに、第六はミヤミンに、"},{"ref":"1Chr.24.10","start":13024010,"end":13024010,"break":"none","ruby":[[0,1,"だい"],[9,1,"だい"]],"text":"第七はハッコヅに、第八はアビヤに、"},{"ref":"1Chr.24.11","start":13024011,"end":13024011,"break":"none","ruby":[[0,1,"だい"],[9,1,"だい"]],"text":"第九はエシュアに、第十はシカニヤに、"},{"ref":"1Chr.24.12","start":13024012,"end":13024012,"break":"none","ruby":[[0,1,"だい"],[11,1,"だい"]],"text":"第十一はエリアシブに、第十二はヤキムに、"},{"ref":"1Chr.24.13","start":13024013,"end":13024013,"break":"none","ruby":[[0,1,"だい"],[9,1,"だい"]],"text":"第十三はホッパに、第十四はエシバブに、"},{"ref":"1Chr.24.14","start":13024014,"end":13024014,"break":"none","ruby":[[0,1,"だい"],[9,1,"だい"]],"text":"第十五はビルガに、第十六はインメルに、"},{"ref":"1Chr.24.15","start":13024015,"end":13024015,"break":"none","ruby":[[0,1,"だい"],[9,1,"だい"]],"text":"第十七はヘジルに、第十八はハピセツに、"},{"ref":"1Chr.24.16","start":13024016,"end":13024016,"break":"none","ruby":[[0,1,"だい"],[10,1,"だい"]],"text":"第十九はペタヒヤに、第二十はエゼキエルに、"},{"ref":"1Chr.24.17","start":13024017,"end":13024017,"break":"none","ruby":[[0,1,"だい"],[10,1,"だい"]],"text":"第二十一はヤキンに、第二十二はガムルに、"},{"ref":"1Chr.24.18","start":13024018,"end":13024018,"break":"none","ruby":[[0,1,"だい"],[10,1,"だい"],[20,1,"あた"]],"text":"第二十三はデラヤに、第二十四はマアジヤに当った。"},{"ref":"1Chr.24.19","start":13024019,"end":13024019,"break":"none","ruby":[[4,1,"かれ"],[7,2,"せんぞ"],[16,1,"もう"],[21,1,"さだ"],[29,1,"しゅ"],[31,1,"いえ"],[37,1,"つとめ"],[41,2,"じゅんじょ"],[54,1,"かみ"],[56,1,"しゅ"],[58,1,"かれ"],[60,1,"めい"]],"text":"これは、彼らの先祖アロンによって設けられた定めにしたがい、主の家にはいって務をなす順序であって、イスラエルの神、主の彼に命じられたとおりである。"},{"ref":"1Chr.24.20","start":13024020,"end":13024020,"break":"paragraph","ruby":[[8,2,"しそん"],[11,1,"つぎ"],[29,1,"こ"],[48,1,"こ"]],"text":"このほかのレビの子孫は次のとおりである。すなわちアムラムの子らのうちではシュバエル。シュバエルの子らのうちではエデヤ。"},{"ref":"1Chr.24.21","start":13024021,"end":13024021,"break":"none","ruby":[[15,1,"こ"],[22,2,"ちょうし"]],"text":"レハビヤについては、レハビヤの子らのうちでは長子イシア。"},{"ref":"1Chr.24.22","start":13024022,"end":13024022,"break":"none","ruby":[[21,1,"こ"]],"text":"イヅハリびとのうちではシロミテ。シロミテの子らのうちではヤハテ。"},{"ref":"1Chr.24.23","start":13024023,"end":13024023,"break":"none","ruby":[[5,1,"こ"],[8,2,"ちょうし"],[15,1,"つぎ"],[22,1,"だい"],[31,1,"だい"]],"text":"ヘブロンの子らは長子はエリヤ、次はアマリヤ、第三はヤハジエル、第四はエカメアム。"},{"ref":"1Chr.24.24","start":13024024,"end":13024024,"break":"none","ruby":[[5,1,"こ"],[18,1,"こ"]],"text":"ウジエルの子らのうちではミカ。ミカの子らのうちではシャミル。"},{"ref":"1Chr.24.25","start":13024025,"end":13024025,"break":"none","ruby":[[3,2,"きょうだい"],[14,1,"こ"]],"text":"ミカの兄弟はイシア。イシアの子らのうちではゼカリヤ。"},{"ref":"1Chr.24.26","start":13024026,"end":13024026,"break":"none","ruby":[[4,1,"こ"],[18,1,"こ"]],"text":"メラリの子らはマヘリとムシ。ヤジアの子らはベノ。"},{"ref":"1Chr.24.27","start":13024027,"end":13024027,"break":"none","ruby":[[4,2,"しそん"],[12,1,"で"],[14,1,"もの"]],"text":"メラリの子孫のヤジアから出た者はベノ、ショハム、ザックル、イブリ。"},{"ref":"1Chr.24.28","start":13024028,"end":13024028,"break":"none","ruby":[[11,1,"で"],[14,1,"かれ"],[17,1,"こ"]],"text":"マヘリからエレアザルが出た。彼には子がなかった。"},{"ref":"1Chr.24.29","start":13024029,"end":13024029,"break":"none","ruby":[[11,1,"こ"]],"text":"キシについては、キシの子はエラメル。"},{"ref":"1Chr.24.30","start":13024030,"end":13024030,"break":"none","ruby":[[3,1,"こ"],[28,2,"しそん"],[34,2,"しぞく"],[43,1,"もの"]],"text":"ムシの子らはマヘリ、エデル、エリモテ。これらはレビびとの子孫で、その氏族によっていった者である。"},{"ref":"1Chr.24.31","start":13024031,"end":13024031,"break":"none","ruby":[[4,1,"もの"],[8,2,"しぞく"],[11,1,"あに"],[15,1,"おとうと"],[17,2,"どうよう"],[24,1,"おう"],[39,2,"さいし"],[49,2,"しぞく"],[52,1,"ちょう"],[56,1,"まえ"],[63,2,"しそん"],[70,2,"きょうだい"],[81,1,"ひ"]],"text":"これらの者もまた氏族の兄もその弟も同様に、ダビデ王と、ザドクと、アヒメレクと、祭司およびレビびとの氏族の長たちの前で、アロンの子孫であるその兄弟たちのようにくじを引いた。"}]