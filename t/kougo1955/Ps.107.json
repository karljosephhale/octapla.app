[{"ref":"Ps.107.1","start":19107001,"end":19107001,"break":"paragraph","breaks":[[16,"line"]],"ruby":[[1,1,"しゅ"],[3,2,"かんしゃ"],[8,1,"しゅ"],[10,1,"めぐ"],[29,1,"た"]],"text":"「主に感謝せよ、主は恵みふかく、そのいつくしみはとこしえに絶えることがない」と、"},{"ref":"Ps.107.2","start":19107002,"end":19107002,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"もの"],[10,1,"い"],[13,1,"しゅ"],[15,1,"かれ"],[18,1,"なや"]],"text":"主にあがなわれた者は言え。主は彼らを悩みからあがない、"},{"ref":"Ps.107.3","start":19107003,"end":19107003,"break":"line","breaks":[[9,"line"]],"ruby":[[5,1,"くに"],[9,1,"ひがし"],[11,1,"にし"],[13,1,"きた"],[15,1,"みなみ"],[18,1,"かれ"],[21,1,"あつ"]],"text":"もろもろの国から、東、西、北、南から彼らを集められた。"},{"ref":"Ps.107.4","start":19107004,"end":19107004,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ひと"],[6,2,"あらの"],[14,1,"す"],[18,1,"まち"],[23,1,"みち"],[25,1,"み"]],"text":"彼らは人なき荒野にさまよい、住むべき町にいたる道を見いださなかった。"},{"ref":"Ps.107.5","start":19107005,"end":19107005,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[3,1,"う"],[14,1,"たましい"],[16,1,"かれ"],[22,1,"おとろ"]],"text":"彼らは飢え、またかわき、その魂は彼らのうちに衰えた。"},{"ref":"Ps.107.6","start":19107006,"end":19107006,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[5,1,"なや"],[11,1,"しゅ"],[13,1,"よ"],[21,1,"しゅ"],[23,1,"かれ"],[28,1,"なや"],[32,1,"たす"],[34,1,"だ"]],"text":"彼らはその悩みのうちに主に呼ばわったので、主は彼らをその悩みから助け出し、"},{"ref":"Ps.107.7","start":19107007,"end":19107007,"break":"line","ruby":[[0,1,"す"],[4,1,"まち"],[6,1,"い"],[8,1,"つ"],[18,1,"みち"],[20,1,"みちび"]],"text":"住むべき町に行き着くまで、まっすぐな道に導かれた。"},{"ref":"Ps.107.8","start":19107008,"end":19107008,"break":"line","breaks":[[16,"line"],[38,"line"]],"ruby":[[4,1,"かれ"],[7,1,"しゅ"],[16,1,"ひと"],[18,1,"こ"],[38,1,"しゅ"],[40,2,"かんしゃ"]],"text":"どうか、彼らが主のいつくしみと、人の子らになされたくすしきみわざとのために、主に感謝するように。"},{"ref":"Ps.107.9","start":19107009,"end":19107009,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"たましい"],[8,1,"み"],[10,1,"た"],[14,1,"う"],[17,1,"たましい"],[19,1,"よ"],[21,1,"もの"],[23,1,"み"]],"text":"主はかわいた魂を満ち足らせ、飢えた魂を良き物で満たされるからである。"},{"ref":"Ps.107.10","start":19107010,"end":19107010,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"あんこく"],[3,1,"ふか"],[8,1,"なか"],[12,1,"もの"],[14,1,"くる"],[24,1,"しば"],[28,1,"もの"]],"text":"暗黒と深いやみの中にいる者、苦しみと、くろがねに縛られた者、"},{"ref":"Ps.107.11","start":19107011,"end":19107011,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,2,"ことば"],[14,1,"たか"],[16,1,"もの"],[18,1,"すす"],[21,1,"かろ"]],"text":"彼らは神の言葉にそむき、いと高き者の勧めを軽んじたので、"},{"ref":"Ps.107.12","start":19107012,"end":19107012,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おも"],[4,2,"ろうどう"],[10,1,"かれ"],[13,1,"こころ"],[15,1,"ひく"],[21,1,"かれ"],[28,1,"たお"],[33,1,"たす"],[36,1,"もの"]],"text":"主は重い労働をもって彼らの心を低くされた。彼らはつまずき倒れても、助ける者がなかった。"},{"ref":"Ps.107.13","start":19107013,"end":19107013,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[5,1,"なや"],[11,1,"しゅ"],[13,1,"よ"],[21,1,"しゅ"],[23,1,"かれ"],[28,1,"なや"],[32,1,"すく"]],"text":"彼らはその悩みのうちに主に呼ばわったので、主は彼らをその悩みから救い、"},{"ref":"Ps.107.14","start":19107014,"end":19107014,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"あんこく"],[3,1,"ふか"],[9,1,"かれ"],[12,1,"みちび"],[14,1,"だ"]],"text":"暗黒と深いやみから彼らを導き出して、そのかせをこわされた。"},{"ref":"Ps.107.15","start":19107015,"end":19107015,"break":"line","breaks":[[16,"line"],[38,"line"]],"ruby":[[4,1,"かれ"],[7,1,"しゅ"],[16,1,"ひと"],[18,1,"こ"],[38,1,"しゅ"],[40,2,"かんしゃ"]],"text":"どうか、彼らが主のいつくしみと、人の子らになされたくすしきみわざとのために、主に感謝するように。"},{"ref":"Ps.107.16","start":19107016,"end":19107016,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"せいどう"],[13,1,"てつ"],[15,1,"かん"],[17,1,"き"],[19,1,"た"],[21,1,"き"]],"text":"主は青銅のとびらをこわし、鉄の貫の木を断ち切られたからである。"},{"ref":"Ps.107.17","start":19107017,"end":19107017,"break":"line","breaks":[[20,"line"]],"ruby":[[2,1,"もの"],[6,1,"つみ"],[8,1,"けが"],[11,1,"おこな"],[17,1,"や"],[22,2,"ふぎ"],[28,1,"なや"]],"text":"ある者はその罪に汚れた行いによって病み、その不義のゆえに悩んだ。"},{"ref":"Ps.107.18","start":19107018,"end":19107018,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[7,2,"しょくもつ"],[15,1,"し"],[17,1,"もん"],[19,1,"ちか"]],"text":"彼らはすべての食物をきらって、死の門に近づいた。"},{"ref":"Ps.107.19","start":19107019,"end":19107019,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[5,1,"なや"],[11,1,"しゅ"],[13,1,"よ"],[21,1,"しゅ"],[23,1,"かれ"],[28,1,"なや"],[32,1,"すく"]],"text":"彼らはその悩みのうちに主に呼ばわったので、主は彼らをその悩みから救い、"},{"ref":"Ps.107.20","start":19107020,"end":19107020,"break":"line","breaks":[[19,"line"]],"ruby":[[3,2,"ことば"],[12,1,"かれ"],[19,1,"かれ"],[22,1,"ほろ"],[26,1,"たす"],[28,1,"だ"]],"text":"そのみ言葉をつかわして、彼らをいやし、彼らを滅びから助け出された。"},{"ref":"Ps.107.21","start":19107021,"end":19107021,"break":"line","breaks":[[16,"line"],[38,"line"]],"ruby":[[4,1,"かれ"],[7,1,"しゅ"],[16,1,"ひと"],[18,1,"こ"],[38,1,"しゅ"],[40,2,"かんしゃ"]],"text":"どうか、彼らが主のいつくしみと、人の子らになされたくすしきみわざとのために、主に感謝するように。"},{"ref":"Ps.107.22","start":19107022,"end":19107022,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,2,"かんしゃ"],[15,1,"よろこ"],[18,1,"うた"],[30,1,"い"]],"text":"彼らが感謝のいけにえをささげ、喜びの歌をもって、そのみわざを言いあらわすように。"},{"ref":"Ps.107.23","start":19107023,"end":19107023,"break":"line","ruby":[[0,1,"ふね"],[2,1,"うみ"],[8,2,"たいかい"],[11,2,"しょうばい"],[16,1,"もの"]],"text":"舟で海にくだり、大海で商売をする者は、"},{"ref":"Ps.107.24","start":19107024,"end":19107024,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"み"],[10,1,"ふか"],[12,1,"ところ"],[24,1,"み"]],"text":"主のみわざを見、また深い所でそのくすしきみわざを見た。"},{"ref":"Ps.107.25","start":19107025,"end":19107025,"break":"line","ruby":[[0,1,"しゅ"],[2,1,"めい"],[8,2,"ぼうふう"],[11,1,"た"],[15,1,"うみ"],[17,1,"なみ"]],"text":"主が命じられると暴風が起って、海の波をあげた。"},{"ref":"Ps.107.26","start":19107026,"end":19107026,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"てん"],[9,1,"ふち"],[15,1,"なや"],[23,2,"ゆうき"],[26,1,"と"],[28,1,"さ"]],"text":"彼らは天にのぼり、淵にくだり、悩みによってその勇気は溶け去り、"},{"ref":"Ps.107.27","start":19107027,"end":19107027,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"よ"],[3,1,"ひと"],[18,2,"とほう"]],"text":"酔った人のようによろめき、よろめいて途方にくれる。"},{"ref":"Ps.107.28","start":19107028,"end":19107028,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[5,1,"なや"],[11,1,"しゅ"],[13,1,"よ"],[21,1,"しゅ"],[23,1,"かれ"],[28,1,"なや"],[32,1,"すく"],[34,1,"だ"]],"text":"彼らはその悩みのうちに主に呼ばわったので、主は彼らをその悩みから救い出された。"},{"ref":"Ps.107.29","start":19107029,"end":19107029,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"しず"],[13,1,"うみ"],[15,1,"なみ"],[17,1,"おだ"]],"text":"主があらしを静められると、海の波は穏やかになった。"},{"ref":"Ps.107.30","start":19107030,"end":19107030,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"かれ"],[7,1,"なみ"],[9,1,"しず"],[15,1,"よろこ"],[18,1,"しゅ"],[20,1,"かれ"],[25,1,"のぞ"],[27,1,"みなと"],[29,1,"みちび"]],"text":"こうして彼らは波の静まったのを喜び、主は彼らをその望む港へ導かれた。"},{"ref":"Ps.107.31","start":19107031,"end":19107031,"break":"line","breaks":[[16,"line"],[38,"line"]],"ruby":[[4,1,"かれ"],[7,1,"しゅ"],[16,1,"ひと"],[18,1,"こ"],[38,1,"しゅ"],[40,2,"かんしゃ"]],"text":"どうか、彼らが主のいつくしみと、人の子らになされたくすしきみわざとのために、主に感謝するように。"},{"ref":"Ps.107.32","start":19107032,"end":19107032,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[3,1,"たみ"],[5,2,"しゅうかい"],[8,1,"しゅ"],[14,2,"ちょうろう"],[17,2,"かいごう"],[20,1,"しゅ"]],"text":"彼らが民の集会で主をあがめ、長老の会合で主をほめたたえるように。"},{"ref":"Ps.107.33","start":19107033,"end":19107033,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かわ"],[4,1,"の"],[6,1,"かわ"],[10,1,"いずみ"],[16,1,"ち"],[18,1,"かわ"]],"text":"主は川を野に変らせ、泉をかわいた地に変らせ、"},{"ref":"Ps.107.34","start":19107034,"end":19107034,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"こ"],[3,1,"ち"],[8,1,"す"],[10,1,"もの"],[12,1,"あく"],[17,1,"しお"],[18,1,"ち"],[20,1,"かわ"]],"text":"肥えた地をそれに住む者の悪のゆえに塩地に変らせられる。"},{"ref":"Ps.107.35","start":19107035,"end":19107035,"break":"line","ruby":[[0,1,"しゅ"],[2,1,"の"],[4,1,"いけ"],[6,1,"かわ"],[14,1,"ち"],[16,1,"いずみ"],[18,1,"かわ"]],"text":"主は野を池に変らせ、かわいた地を泉に変らせ、"},{"ref":"Ps.107.36","start":19107036,"end":19107036,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"う"],[3,1,"もの"],[8,1,"す"],[20,1,"かれ"],[25,1,"す"],[29,1,"まち"],[31,1,"た"]],"text":"飢えた者をそこに住まわせられる。こうして彼らはその住むべき町を建て、"},{"ref":"Ps.107.37","start":19107037,"end":19107037,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"はたけ"],[2,1,"たね"],[10,1,"はたけ"],[12,1,"もう"],[15,1,"おお"],[18,2,"しゅうかく"],[21,1,"え"]],"text":"畑に種をまき、ぶどう畑を設けて多くの収穫を得た。"},{"ref":"Ps.107.38","start":19107038,"end":19107038,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,2,"しゅくふく"],[12,1,"かれ"],[15,1,"おお"],[23,2,"かちく"],[26,1,"へ"]],"text":"主が彼らを祝福されたので彼らは大いにふえ、その家畜の減るのをゆるされなかった。"},{"ref":"Ps.107.39","start":19107039,"end":19107039,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[9,1,"なや"],[13,1,"かな"],[21,1,"へ"],[26,1,"いや"]],"text":"彼らがしえたげと、悩みと、悲しみとによって減り、かつ卑しめられたとき、"},{"ref":"Ps.107.40","start":19107040,"end":19107040,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"きみ"],[9,1,"あなど"],[16,1,"みち"],[19,1,"あ"],[21,1,"ち"]],"text":"主はもろもろの君に侮りをそそぎ、道なき荒れ地にさまよわせられた。"},{"ref":"Ps.107.41","start":19107041,"end":19107041,"break":"line","breaks":[[21,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"まず"],[8,1,"もの"],[10,1,"なや"],[23,2,"かぞく"],[26,1,"ひつじ"],[28,1,"む"]],"text":"しかし主は貧しい者を悩みのうちからあげて、その家族を羊の群れのようにされた。"},{"ref":"Ps.107.42","start":19107042,"end":19107042,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[8,1,"み"],[10,1,"よろこ"],[18,2,"ふぎ"],[23,1,"くち"],[25,1,"と"]],"text":"正しい者はこれを見て喜び、もろもろの不義はその口を閉じた。"},{"ref":"Ps.107.43","start":19107043,"end":19107043,"break":"line","breaks":[[18,"line"]],"ruby":[[3,1,"かしこ"],[5,1,"もの"],[11,1,"こと"],[13,1,"こころ"],[18,1,"しゅ"]],"text":"すべて賢い者はこれらの事に心をよせ、主のいつくしみをさとるようにせよ。"}]