[{"ref":"Exod.24.1","start":2024001,"end":2024001,"break":"paragraph","ruby":[[7,1,"い"],[39,1,"にん"],[41,2,"ちょうろう"],[46,1,"とも"],[49,1,"しゅ"],[72,1,"とお"],[74,1,"はな"],[77,2,"れいはい"]],"text":"また、モーセに言われた、「あなたはアロン、ナダブ、アビウおよびイスラエルの七十人の長老たちと共に、主のもとにのぼってきなさい。そしてあなたがたは遠く離れて礼拝しなさい。"},{"ref":"Exod.24.2","start":2024002,"end":2024002,"break":"none","ruby":[[9,1,"しゅ"],[11,1,"ちか"],[15,1,"た"],[17,1,"もの"],[19,1,"ちか"],[32,1,"たみ"],[34,1,"かれ"],[36,1,"とも"]],"text":"ただモーセひとりが主に近づき、他の者は近づいてはならない。また、民も彼と共にのぼってはならない」。"},{"ref":"Exod.24.3","start":2024003,"end":2024003,"break":"paragraph","ruby":[[7,1,"しゅ"],[13,2,"ことば"],[26,1,"たみ"],[28,1,"つ"],[32,1,"たみ"],[36,1,"どう"],[37,1,"おん"],[39,1,"こた"],[42,1,"い"],[53,1,"しゅ"],[55,1,"おお"],[60,2,"ことば"],[63,1,"みな"],[65,1,"おこな"]],"text":"モーセはきて、主のすべての言葉と、すべてのおきてとを民に告げた。民はみな同音に答えて言った、「わたしたちは主の仰せられた言葉を皆、行います」。"},{"ref":"Exod.24.4","start":2024004,"end":2024004,"break":"none","ruby":[[7,1,"しゅ"],[9,2,"ことば"],[18,1,"か"],[24,1,"あさ"],[28,1,"お"],[31,1,"やま"],[37,2,"さいだん"],[40,1,"きず"],[51,2,"ぶぞく"],[54,1,"したが"],[60,1,"はしら"],[62,1,"た"]],"text":"そしてモーセは主の言葉を、ことごとく書きしるし、朝はやく起きて山のふもとに祭壇を築き、イスラエルの十二部族に従って十二の柱を建て、"},{"ref":"Exod.24.5","start":2024005,"end":2024005,"break":"none","ruby":[[6,2,"ひとびと"],[12,2,"わかもの"],[23,1,"しゅ"],[25,2,"はんさい"],[36,3,"しゅうおんさい"],[42,2,"おうし"]],"text":"イスラエルの人々のうちの若者たちをつかわして、主に燔祭をささげさせ、また酬恩祭として雄牛をささげさせた。"},{"ref":"Exod.24.6","start":2024006,"end":2024006,"break":"none","ruby":[[2,1,"とき"],[9,1,"ち"],[11,1,"なか"],[14,1,"と"],[18,1,"はち"],[20,1,"い"],[28,1,"ち"],[30,1,"なか"],[33,2,"さいだん"],[36,1,"そそ"]],"text":"その時モーセはその血の半ばを取って、鉢に入れ、また、その血の半ばを祭壇に注ぎかけた。"},{"ref":"Exod.24.7","start":2024007,"end":2024007,"break":"none","ruby":[[3,2,"けいやく"],[6,1,"しょ"],[8,1,"と"],[15,1,"たみ"],[17,1,"よ"],[19,1,"き"],[28,1,"かれ"],[31,1,"こた"],[34,1,"い"],[45,1,"しゅ"],[47,1,"おお"],[55,1,"みな"],[57,2,"じゅうじゅん"],[60,1,"おこな"]],"text":"そして契約の書を取って、これを民に読み聞かせた。すると、彼らは答えて言った、「わたしたちは主が仰せられたことを皆、従順に行います」。"},{"ref":"Exod.24.8","start":2024008,"end":2024008,"break":"none","ruby":[[9,1,"ち"],[11,1,"と"],[15,1,"たみ"],[17,1,"そそ"],[25,1,"い"],[30,1,"み"],[36,1,"しゅ"],[46,2,"ことば"],[49,1,"もとづ"],[59,1,"むす"],[63,2,"けいやく"],[66,1,"ち"]],"text":"そこでモーセはその血を取って、民に注ぎかけ、そして言った、「見よ、これは主がこれらのすべての言葉に基いて、あなたがたと結ばれる契約の血である」。"},{"ref":"Exod.24.9","start":2024009,"end":2024009,"break":"paragraph","ruby":[[30,1,"にん"],[32,2,"ちょうろう"],[37,1,"とも"],[43,1,"い"]],"text":"こうしてモーセはアロン、ナダブ、アビウおよびイスラエルの七十人の長老たちと共にのぼって行った。"},{"ref":"Exod.24.10","start":2024010,"end":2024010,"break":"none","ruby":[[4,1,"かれ"],[13,1,"かみ"],[15,1,"み"],[21,1,"あし"],[23,1,"した"],[32,2,"しきいし"],[38,1,"もの"],[43,1,"す"],[45,1,"わた"]],"text":"そして、彼らがイスラエルの神を見ると、その足の下にはサファイアの敷石のごとき物があり、澄み渡るおおぞらのようであった。"},{"ref":"Exod.24.11","start":2024011,"end":2024011,"break":"none","ruby":[[0,1,"かみ"],[8,2,"ひとびと"],[11,3,"しどうしゃ"],[17,1,"て"],[30,1,"かれ"],[33,1,"かみ"],[35,1,"み"],[38,1,"の"],[40,1,"く"]],"text":"神はイスラエルの人々の指導者たちを手にかけられなかったので、彼らは神を見て、飲み食いした。"},{"ref":"Exod.24.12","start":2024012,"end":2024012,"break":"paragraph","ruby":[[3,1,"しゅ"],[9,1,"い"],[15,1,"やま"],[17,1,"のぼ"],[24,1,"ところ"],[37,1,"かれ"],[40,1,"おし"],[51,2,"りっぽう"],[54,1,"いまし"],[58,1,"か"],[64,1,"いし"],[66,1,"いた"],[72,1,"さづ"]],"text":"ときに主はモーセに言われた、「山に登り、わたしの所にきて、そこにいなさい。彼らを教えるために、わたしが律法と戒めとを書きしるした石の板をあなたに授けるであろう」。"},{"ref":"Exod.24.13","start":2024013,"end":2024013,"break":"none","ruby":[[7,2,"じゅうしゃ"],[14,1,"とも"],[16,1,"た"],[26,1,"かみ"],[28,1,"やま"],[30,1,"のぼ"]],"text":"そこでモーセは従者ヨシュアと共に立ちあがり、モーセは神の山に登った。"},{"ref":"Exod.24.14","start":2024014,"end":2024014,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ちょうろう"],[7,1,"い"],[24,1,"ところ"],[26,1,"かえ"],[29,1,"く"],[37,1,"ま"],[45,1,"み"],[63,1,"とも"],[70,1,"こと"],[73,1,"もの"],[80,1,"かれ"],[83,1,"ところ"],[85,1,"い"]],"text":"彼は長老たちに言った、「わたしたちがあなたがたの所に帰って来るまで、ここで待っていなさい。見よ、アロンとホルとが、あなたがたと共にいるから、事ある者は、だれでも彼らの所へ行きなさい」。"},{"ref":"Exod.24.15","start":2024015,"end":2024015,"break":"paragraph","ruby":[[8,1,"やま"],[10,1,"のぼ"],[15,1,"くも"],[17,1,"やま"]],"text":"こうしてモーセは山に登ったが、雲は山をおおっていた。"},{"ref":"Exod.24.16","start":2024016,"end":2024016,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"えいこう"],[8,1,"さん"],[10,1,"うえ"],[17,1,"くも"],[20,1,"か"],[26,1,"やま"],[36,2,"なぬか"],[38,1,"め"],[40,1,"しゅ"],[42,1,"くも"],[44,1,"なか"],[51,1,"よ"]],"text":"主の栄光がシナイ山の上にとどまり、雲は六日のあいだ、山をおおっていたが、七日目に主は雲の中からモーセを呼ばれた。"},{"ref":"Exod.24.17","start":2024017,"end":2024017,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"えいこう"],[5,1,"やま"],[7,1,"いただき"],[10,1,"も"],[13,1,"ひ"],[24,2,"ひとびと"],[27,1,"め"],[29,1,"み"]],"text":"主の栄光は山の頂で、燃える火のようにイスラエルの人々の目に見えたが、"},{"ref":"Exod.24.18","start":2024018,"end":2024018,"break":"none","ruby":[[4,1,"くも"],[6,1,"なか"],[13,1,"やま"],[15,1,"のぼ"],[28,1,"にち"],[31,1,"や"],[33,1,"やま"]],"text":"モーセは雲の中にはいって、山に登った。そしてモーセは四十日四十夜、山にいた。"}]