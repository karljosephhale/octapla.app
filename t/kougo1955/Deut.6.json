[{"ref":"Deut.6.1","start":5006001,"end":5006001,"break":"paragraph","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[19,1,"おし"],[23,1,"めい"],[28,2,"めいれい"],[32,1,"さだ"],[50,1,"わた"],[53,1,"い"],[56,1,"え"],[58,1,"ち"],[64,1,"おこな"]],"text":"これはあなたがたの神、主があなたがたに教えよと命じられた命令と、定めと、おきてであって、あなたがたは渡って行って獲る地で、これを行わなければならない。"},{"ref":"Deut.6.2","start":5006002,"end":5006002,"break":"none","ruby":[[7,1,"こ"],[9,1,"まご"],[11,1,"とも"],[18,1,"い"],[25,1,"ひ"],[27,1,"あいだ"],[36,1,"かみ"],[38,1,"しゅ"],[40,1,"おそ"],[48,1,"めい"],[56,1,"さだ"],[60,2,"めいれい"],[64,1,"まも"],[77,1,"なが"],[79,1,"いのち"],[81,1,"たも"]],"text":"これはあなたが子や孫と共に、あなたの生きながらえる日の間、つねにあなたの神、主を恐れて、わたしが命じるもろもろの定めと、命令とを守らせるため、またあなたが長く命を保つことのできるためである。"},{"ref":"Deut.6.3","start":5006003,"end":5006003,"break":"none","ruby":[[12,1,"き"],[19,1,"まも"],[21,1,"おこな"],[39,1,"え"],[45,2,"せんぞ"],[48,1,"かみ"],[50,1,"しゅ"],[56,1,"い"],[64,1,"ちち"],[66,1,"みつ"],[68,1,"なが"],[71,1,"くに"],[78,1,"かず"],[80,1,"おお"],[83,1,"ま"]],"text":"それゆえ、イスラエルよ、聞いて、それを守り行え。そうすれば、あなたはさいわいを得、あなたの先祖の神、主があなたに言われたように、乳と蜜の流れる国で、あなたの数は大いに増すであろう。"},{"ref":"Deut.6.4","start":5006004,"end":5006004,"break":"paragraph","ruby":[[6,1,"き"],[14,1,"かみ"],[16,1,"しゅ"],[18,2,"ゆいいつ"],[21,1,"しゅ"]],"text":"イスラエルよ聞け。われわれの神、主は唯一の主である。"},{"ref":"Deut.6.5","start":5006005,"end":5006005,"break":"none","ruby":[[4,1,"こころ"],[10,2,"せいしん"],[17,1,"ちから"],[28,1,"かみ"],[30,1,"しゅ"],[32,1,"あい"]],"text":"あなたは心をつくし、精神をつくし、力をつくして、あなたの神、主を愛さなければならない。"},{"ref":"Deut.6.6","start":5006006,"end":5006006,"break":"none","ruby":[[12,1,"めい"],[19,2,"ことば"],[26,1,"こころ"],[28,1,"と"]],"text":"きょう、わたしがあなたに命じるこれらの言葉をあなたの心に留め、"},{"ref":"Deut.6.7","start":5006007,"end":5006007,"break":"none","ruby":[[0,1,"つと"],[10,1,"こ"],[13,1,"おし"],[20,1,"いえ"],[22,1,"ざ"],[27,1,"とき"],[30,1,"みち"],[32,1,"ある"],[34,1,"とき"],[37,1,"ね"],[39,1,"とき"],[42,1,"お"],[45,1,"とき"],[54,1,"かた"]],"text":"努めてこれをあなたの子らに教え、あなたが家に座している時も、道を歩く時も、寝る時も、起きる時も、これについて語らなければならない。"},{"ref":"Deut.6.8","start":5006008,"end":5006008,"break":"none","ruby":[[13,1,"て"],[28,1,"め"],[30,1,"あいだ"],[32,1,"お"],[35,1,"おぼ"]],"text":"またあなたはこれをあなたの手につけてしるしとし、あなたの目の間に置いて覚えとし、"},{"ref":"Deut.6.9","start":5006009,"end":5006009,"break":"none","ruby":[[6,1,"いえ"],[8,2,"いりぐち"],[11,1,"はしら"],[18,1,"もん"],[21,1,"か"]],"text":"またあなたの家の入口の柱と、あなたの門とに書きしるさなければならない。"},{"ref":"Deut.6.10","start":5006010,"end":5006010,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[13,2,"せんぞ"],[29,1,"む"],[38,1,"あた"],[42,1,"ちか"],[46,1,"ち"],[60,1,"とき"],[66,1,"た"],[74,1,"おお"],[77,1,"うつく"],[80,2,"まちまち"],[83,1,"え"]],"text":"あなたの神、主は、あなたの先祖アブラハム、イサク、ヤコブに向かって、あなたに与えると誓われた地に、あなたをはいらせられる時、あなたが建てたものでない大きな美しい町々を得させ、"},{"ref":"Deut.6.11","start":5006011,"end":5006011,"break":"none","ruby":[[4,1,"み"],[18,1,"よ"],[20,1,"もの"],[22,1,"み"],[26,1,"いえ"],[28,1,"え"],[36,1,"ほ"],[44,1,"ほ"],[46,2,"いど"],[49,1,"え"],[57,1,"う"],[68,1,"はたけ"],[74,1,"はたけ"],[77,1,"え"],[92,1,"た"],[95,1,"あ"]],"text":"あなたが満たしたものでないもろもろの良い物を満たした家を得させ、あなたが掘ったものでない掘り井戸を得させ、あなたが植えたものでないぶどう畑とオリブの畑とを得させられるであろう。あなたは食べて飽きるであろう。"},{"ref":"Deut.6.12","start":5006012,"end":5006012,"break":"none","ruby":[[2,1,"とき"],[12,1,"つつし"],[20,1,"ち"],[22,2,"どれい"],[25,1,"いえ"],[28,1,"みちび"],[30,1,"だ"],[34,1,"しゅ"],[36,1,"わす"]],"text":"その時、あなたはみずから慎み、エジプトの地、奴隷の家から導き出された主を忘れてはならない。"},{"ref":"Deut.6.13","start":5006013,"end":5006013,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"おそ"],[14,1,"つか"],[19,1,"な"],[24,1,"ちか"]],"text":"あなたの神、主を恐れてこれに仕え、その名をさして誓わなければならない。"},{"ref":"Deut.6.14","start":5006014,"end":5006014,"break":"none","ruby":[[6,1,"た"],[8,2,"かみがみ"],[14,2,"しゅうい"],[17,1,"たみ"],[19,2,"かみがみ"],[22,1,"したが"]],"text":"あなたがたは他の神々すなわち周囲の民の神々に従ってはならない。"},{"ref":"Deut.6.15","start":5006015,"end":5006015,"break":"none","ruby":[[15,1,"かみ"],[17,1,"しゅ"],[22,1,"かみ"],[38,1,"む"],[42,1,"いか"],[45,1,"はっ"],[48,1,"ち"],[59,1,"ほろ"],[62,1,"さ"]],"text":"あなたのうちにおられるあなたの神、主はねたむ神であるから、おそらく、あなたに向かって怒りを発し、地のおもてからあなたを滅ぼし去られるであろう。"},{"ref":"Deut.6.16","start":5006016,"end":5006016,"break":"paragraph","ruby":[[22,1,"かみ"],[24,1,"しゅ"],[26,1,"こころ"]],"text":"あなたがたがマッサでしたように、あなたがたの神、主を試みてはならない。"},{"ref":"Deut.6.17","start":5006017,"end":5006017,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[16,1,"めい"],[21,2,"めいれい"],[30,1,"さだ"],[35,1,"つと"],[38,1,"まも"]],"text":"あなたがたの神、主があなたがたに命じられた命令と、あかしと、定めとを、努めて守らなければならない。"},{"ref":"Deut.6.18","start":5006018,"end":5006018,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"み"],[8,1,"ただ"],[14,1,"よ"],[23,1,"おこな"],[49,1,"え"],[53,1,"しゅ"],[59,2,"せんぞ"],[62,1,"ちか"],[69,1,"よ"],[71,1,"ち"],[78,2,"じぶん"]],"text":"あなたは主が見て正しいとし、良いとされることを行わなければならない。そうすれば、あなたはさいわいを得、かつ主があなたの先祖に誓われた、あの良い地にはいって、自分のものとすることができるであろう。"},{"ref":"Deut.6.19","start":5006019,"end":5006019,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"おお"],[17,1,"てき"],[19,1,"みな"],[24,1,"まえ"],[27,1,"お"],[29,1,"はら"]],"text":"また主が仰せられたように、あなたの敵を皆あなたの前から追い払われるであろう。"},{"ref":"Deut.6.20","start":5006020,"end":5006020,"break":"paragraph","ruby":[[0,1,"のち"],[2,1,"ひ"],[12,1,"こ"],[18,1,"と"],[21,1,"い"],[34,1,"かみ"],[36,1,"しゅ"],[44,1,"めい"],[56,1,"さだ"]],"text":"後の日となって、あなたの子があなたに問うて言うであろう、『われわれの神、主があなたがたに命じられたこのあかしと、定めと、おきてとは、なんのためですか』。"},{"ref":"Deut.6.21","start":5006021,"end":5006021,"break":"none","ruby":[[2,1,"とき"],[9,1,"こ"],[11,1,"い"],[36,2,"どれい"],[44,1,"しゅ"],[46,1,"つよ"],[48,1,"て"],[65,1,"みちび"],[67,1,"だ"]],"text":"その時あなたはその子に言わなければならない。『われわれはエジプトでパロの奴隷であったが、主は強い手をもって、われわれをエジプトから導き出された。"},{"ref":"Deut.6.22","start":5006022,"end":5006022,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"め"],[9,1,"まえ"],[12,1,"おお"],[15,1,"おそ"],[23,3,"ふしぎ"],[39,2,"ぜんか"],[43,1,"しめ"]],"text":"主はわれわれの目の前で、大きな恐ろしいしるしと不思議とをエジプトと、パロとその全家とに示され、"},{"ref":"Deut.6.23","start":5006023,"end":5006023,"break":"none","ruby":[[9,1,"みちび"],[11,1,"だ"],[22,2,"せんぞ"],[25,1,"ちか"],[29,1,"ち"],[44,1,"たま"]],"text":"われわれをそこから導き出し、かつてわれわれの先祖に誓われた地にはいらせ、それをわれわれに賜わった。"},{"ref":"Deut.6.24","start":5006024,"end":5006024,"break":"none","ruby":[[3,1,"しゅ"],[11,1,"さだ"],[14,1,"おこな"],[23,1,"めい"],[37,1,"かみ"],[39,1,"しゅ"],[41,1,"おそ"],[64,2,"こんにち"],[71,1,"しゅ"],[78,1,"まも"],[81,1,"いのち"],[83,1,"たも"]],"text":"そして主はこのすべての定めを行えと、われわれに命じられた。これはわれわれの神、主を恐れて、われわれが、つねにさいわいであり、また今日のように、主がわれわれを守って命を保たせるためである。"},{"ref":"Deut.6.25","start":5006025,"end":5006025,"break":"none","ruby":[[8,1,"めい"],[24,2,"めいれい"],[32,1,"かみ"],[34,1,"しゅ"],[36,1,"まえ"],[38,1,"まも"],[41,1,"おこな"],[55,1,"ぎ"]],"text":"もしわれわれが、命じられたとおりに、このすべての命令をわれわれの神、主の前に守って行うならば、それはわれわれの義となるであろう』。"}]