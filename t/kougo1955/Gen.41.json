[{"ref":"Gen.41.1","start":1041001,"end":1041001,"break":"paragraph","ruby":[[1,1,"ねん"],[3,1,"のち"],[7,1,"ゆめ"],[9,1,"み"],[12,1,"ゆめ"],[15,1,"かれ"],[20,1,"かわ"],[26,1,"た"]],"text":"二年の後パロは夢を見た。夢に、彼はナイル川のほとりに立っていた。"},{"ref":"Gen.41.2","start":1041002,"end":1041002,"break":"none","ruby":[[6,1,"かわ"],[9,1,"うつく"],[13,1,"こ"],[15,1,"ふと"],[19,1,"とう"],[21,2,"めうし"],[24,1,"あ"],[30,1,"あし"],[32,1,"く"]],"text":"すると、その川から美しい、肥え太った七頭の雌牛が上がってきて葦を食っていた。"},{"ref":"Gen.41.3","start":1041003,"end":1041003,"break":"none","ruby":[[2,1,"のち"],[6,1,"みにく"],[11,1,"ほそ"],[14,1,"た"],[17,1,"とう"],[19,2,"めうし"],[22,1,"かわ"],[25,1,"あ"],[32,1,"かわ"],[34,1,"きし"],[38,2,"めうし"],[44,1,"た"]],"text":"その後、また醜い、やせ細った他の七頭の雌牛が川から上がってきて、川の岸にいた雌牛のそばに立ち、"},{"ref":"Gen.41.4","start":1041004,"end":1041004,"break":"none","ruby":[[2,1,"みにく"],[7,1,"ほそ"],[10,2,"めうし"],[16,1,"うつく"],[20,1,"こ"],[24,1,"とう"],[26,2,"めうし"],[29,1,"く"],[42,1,"め"],[44,1,"さ"]],"text":"その醜い、やせ細った雌牛が、あの美しい、肥えた七頭の雌牛を食いつくした。ここでパロは目が覚めた。"},{"ref":"Gen.41.5","start":1041005,"end":1041005,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ねむ"],[8,1,"ふたた"],[10,1,"ゆめ"],[12,1,"み"],[15,1,"ゆめ"],[19,1,"ぽん"],[21,1,"くき"],[23,1,"ふと"],[26,1,"よ"],[31,1,"ほ"],[33,1,"で"]],"text":"彼はまた眠って、再び夢を見た。夢に、一本の茎に太った良い七つの穂が出てきた。"},{"ref":"Gen.41.6","start":1041006,"end":1041006,"break":"none","ruby":[[2,1,"のち"],[10,2,"ひがしかぜ"],[13,1,"や"],[19,1,"ほ"],[21,1,"で"]],"text":"その後また、やせて、東風に焼けた七つの穂が出てきて、"},{"ref":"Gen.41.7","start":1041007,"end":1041007,"break":"none","ruby":[[5,1,"ほ"],[10,1,"ふと"],[13,1,"みの"],[19,1,"ほ"],[34,1,"め"],[36,1,"さ"],[44,1,"ゆめ"]],"text":"そのやせた穂が、あの太って実った七つの穂をのみつくした。ここでパロは目が覚めたが、それは夢であった。"},{"ref":"Gen.41.8","start":1041008,"end":1041008,"break":"none","ruby":[[0,1,"あさ"],[9,1,"こころ"],[11,1,"さわ"],[14,1,"ひと"],[31,2,"まじゅつ"],[33,1,"し"],[39,2,"ちしゃ"],[43,1,"よ"],[45,1,"よ"],[48,1,"かれ"],[51,1,"ゆめ"],[53,1,"つ"],[64,1,"と"],[66,1,"あ"],[71,1,"もの"]],"text":"朝になって、パロは心が騒ぎ、人をつかわして、エジプトのすべての魔術師とすべての知者とを呼び寄せ、彼らに夢を告げたが、これをパロに解き明かしうる者がなかった。"},{"ref":"Gen.41.9","start":1041009,"end":1041009,"break":"paragraph","ruby":[[4,2,"きゅうじ"],[6,1,"やく"],[8,1,"ちょう"],[13,1,"つ"],[16,1,"い"],[29,2,"じぶん"],[37,1,"おも"],[39,1,"だ"]],"text":"そのとき給仕役の長はパロに告げて言った、「わたしはきょう、自分のあやまちを思い出しました。"},{"ref":"Gen.41.10","start":1041010,"end":1041010,"break":"none","ruby":[[11,1,"む"],[15,1,"いきどお"],[22,2,"りょうり"],[24,1,"やく"],[26,1,"ちょう"],[29,2,"じえい"],[31,1,"ちょう"],[33,1,"いえ"],[35,3,"かんきんじょ"],[40,1,"い"],[46,1,"とき"]],"text":"かつてパロがしもべらに向かって憤り、わたしと料理役の長とを侍衛長の家の監禁所にお入れになった時、"},{"ref":"Gen.41.11","start":1041011,"end":1041011,"break":"none","ruby":[[4,1,"かれ"],[6,2,"いちや"],[12,1,"ゆめ"],[14,1,"み"],[20,2,"いみ"],[25,1,"ゆめ"],[27,1,"み"]],"text":"わたしも彼も一夜のうちに夢を見、それぞれ意味のある夢を見ましたが、"},{"ref":"Gen.41.12","start":1041012,"end":1041012,"break":"none","ruby":[[3,2,"じえい"],[5,1,"ちょう"],[16,1,"わか"],[29,1,"とも"],[36,1,"かれ"],[38,1,"はな"],[45,1,"かれ"],[52,1,"ゆめ"],[54,1,"と"],[56,1,"あ"],[62,1,"ゆめ"],[72,1,"と"],[74,1,"あ"]],"text":"そこに侍衛長のしもべで、ひとりの若いヘブルびとがわれわれと共にいたので、彼に話したところ、彼はわれわれの夢を解き明かし、その夢によって、それぞれ解き明かしをしました。"},{"ref":"Gen.41.13","start":1041013,"end":1041013,"break":"none","ruby":[[3,1,"かれ"],[5,1,"と"],[7,1,"あ"],[26,1,"しょく"],[28,1,"かえ"],[31,1,"かれ"],[33,1,"き"],[35,1,"か"]],"text":"そして彼が解き明かしたとおりになって、パロはわたしを職に返し、彼を木に掛けられました」。"},{"ref":"Gen.41.14","start":1041014,"end":1041014,"break":"paragraph","ruby":[[6,1,"ひと"],[17,1,"よ"],[21,2,"ひとびと"],[24,1,"いそ"],[27,1,"かれ"],[29,2,"ちか"],[32,2,"ごくや"],[36,1,"だ"],[51,2,"きもの"],[54,2,"きが"],[64,1,"い"]],"text":"そこでパロは人をつかわしてヨセフを呼んだ。人々は急いで彼を地下の獄屋から出した。ヨセフは、ひげをそり、着物を着替えてパロのもとに行った。"},{"ref":"Gen.41.15","start":1041015,"end":1041015,"break":"none","ruby":[[7,1,"い"],[16,1,"ゆめ"],[18,1,"み"],[25,1,"と"],[27,1,"あ"],[30,1,"もの"],[35,1,"き"],[49,1,"ゆめ"],[51,1,"き"],[55,1,"と"],[57,1,"あ"]],"text":"パロはヨセフに言った、「わたしは夢を見たが、これを解き明かす者がない。聞くところによると、あなたは夢を聞いて、解き明かしができるそうだ」。"},{"ref":"Gen.41.16","start":1041016,"end":1041016,"break":"none","ruby":[[7,1,"こた"],[10,1,"い"],[30,1,"かみ"],[35,2,"へいあん"],[39,1,"つ"]],"text":"ヨセフはパロに答えて言った、「いいえ、わたしではありません。神がパロに平安をお告げになりましょう」。"},{"ref":"Gen.41.17","start":1041017,"end":1041017,"break":"none","ruby":[[7,1,"い"],[12,1,"ゆめ"],[18,1,"かわ"],[20,1,"きし"],[22,1,"た"]],"text":"パロはヨセフに言った、「夢にわたしは川の岸に立っていた。"},{"ref":"Gen.41.18","start":1041018,"end":1041018,"break":"none","ruby":[[2,1,"かわ"],[5,1,"こ"],[7,1,"ふと"],[11,1,"うつく"],[15,1,"とう"],[17,2,"めうし"],[20,1,"あ"],[26,1,"あし"],[28,1,"く"]],"text":"その川から肥え太った、美しい七頭の雌牛が上がってきて葦を食っていた。"},{"ref":"Gen.41.19","start":1041019,"end":1041019,"break":"none","ruby":[[2,1,"のち"],[4,1,"よわ"],[7,2,"ひじょう"],[10,1,"みにく"],[15,1,"ほそ"],[18,1,"た"],[21,1,"とう"],[23,2,"めうし"],[28,1,"うえ"],[43,2,"ぜんこく"],[52,1,"みにく"],[59,1,"み"]],"text":"その後、弱く、非常に醜い、やせ細った他の七頭の雌牛がまた上がってきた。わたしはエジプト全国で、このような醜いものをまだ見たことがない。"},{"ref":"Gen.41.20","start":1041020,"end":1041020,"break":"none","ruby":[[9,1,"みにく"],[11,2,"めうし"],[15,1,"はじ"],[19,1,"とう"],[21,1,"こ"],[24,2,"めうし"],[27,1,"く"]],"text":"ところがそのやせた醜い雌牛が、初めの七頭の肥えた雌牛を食いつくしたが、"},{"ref":"Gen.41.21","start":1041021,"end":1041021,"break":"none","ruby":[[0,1,"はら"],[8,1,"はら"],[14,1,"こと"],[16,1,"し"],[23,1,"はじ"],[29,1,"みにく"],[41,1,"め"],[43,1,"さ"]],"text":"腹にはいっても、腹にはいった事が知れず、やはり初めのように醜かった。ここでわたしは目が覚めた。"},{"ref":"Gen.41.22","start":1041022,"end":1041022,"break":"none","ruby":[[6,1,"ゆめ"],[12,1,"ぽん"],[14,1,"くき"],[19,1,"み"],[22,1,"よ"],[24,1,"ほ"],[26,1,"で"]],"text":"わたしはまた夢をみた。一本の茎に七つの実った良い穂が出てきた。"},{"ref":"Gen.41.23","start":1041023,"end":1041023,"break":"none","ruby":[[2,1,"のち"],[6,1,"おとろ"],[10,2,"ひがしかぜ"],[13,1,"や"],[19,1,"ほ"],[21,1,"で"]],"text":"その後、やせ衰えて、東風に焼けた七つの穂が出てきたが、"},{"ref":"Gen.41.24","start":1041024,"end":1041024,"break":"none","ruby":[[5,1,"ほ"],[13,1,"よ"],[15,1,"ほ"],[28,2,"まじゅつ"],[30,1,"し"],[32,1,"はな"],[46,1,"しめ"],[50,1,"もの"]],"text":"そのやせた穂が、あの七つの良い穂をのみつくした。わたしは魔術師に話したが、わたしにそのわけを示しうる者はなかった」。"},{"ref":"Gen.41.25","start":1041025,"end":1041025,"break":"paragraph","ruby":[[7,1,"い"],[15,1,"ゆめ"],[22,1,"かみ"],[40,1,"しめ"]],"text":"ヨセフはパロに言った、「パロの夢は一つです。神がこれからしようとすることをパロに示されたのです。"},{"ref":"Gen.41.26","start":1041026,"end":1041026,"break":"none","ruby":[[1,1,"とう"],[3,1,"よ"],[5,2,"めうし"],[9,1,"ねん"],[16,1,"よ"],[18,1,"ほ"],[21,1,"ねん"],[24,1,"ゆめ"]],"text":"七頭の良い雌牛は七年です。七つの良い穂も七年で、夢は一つです。"},{"ref":"Gen.41.27","start":1041027,"end":1041027,"break":"none","ruby":[[3,1,"つづ"],[7,1,"あ"],[14,1,"とう"],[19,1,"みにく"],[21,2,"めうし"],[25,1,"ねん"],[28,2,"ひがしかぜ"],[31,1,"や"],[34,1,"み"],[36,1,"い"],[43,1,"ほ"],[46,1,"ねん"]],"text":"あとに続いて、上がってきた七頭のやせた醜い雌牛は七年で、東風に焼けた実の入らない七つの穂は七年のききんです。"},{"ref":"Gen.41.28","start":1041028,"end":1041028,"break":"none","ruby":[[7,1,"もう"],[9,1,"あ"],[16,1,"かみ"],[34,1,"しめ"]],"text":"わたしがパロに申し上げたように、神がこれからしようとすることをパロに示されたのです。"},{"ref":"Gen.41.29","start":1041029,"end":1041029,"break":"none","ruby":[[4,2,"ぜんこく"],[8,1,"ねん"],[10,1,"だい"],[11,2,"ほうさく"]],"text":"エジプト全国に七年の大豊作があり、"},{"ref":"Gen.41.30","start":1041030,"end":1041030,"break":"none","ruby":[[2,1,"のち"],[4,1,"ねん"],[10,1,"おこ"],[15,2,"ほうさく"],[25,1,"くに"],[27,1,"わす"],[39,1,"くに"],[41,1,"ほろ"]],"text":"その後七年のききんが起り、その豊作はみなエジプトの国で忘れられて、そのききんは国を滅ぼすでしょう。"},{"ref":"Gen.41.31","start":1041031,"end":1041031,"break":"none","ruby":[[0,1,"のち"],[2,1,"く"],[11,2,"ひじょう"],[14,1,"はげ"],[22,2,"ほうさく"],[25,1,"くに"],[30,2,"きおく"]],"text":"後に来るそのききんが、非常に激しいから、その豊作は国のうちで記憶されなくなるでしょう。"},{"ref":"Gen.41.32","start":1041032,"end":1041032,"break":"none","ruby":[[4,1,"ど"],[5,1,"かさ"],[8,1,"ゆめ"],[10,1,"み"],[19,1,"こと"],[21,1,"かみ"],[26,1,"さだ"],[31,1,"かみ"]],"text":"パロが二度重ねて夢を見られたのは、この事が神によって定められ、神がすみやかにこれをされるからです。"},{"ref":"Gen.41.33","start":1041033,"end":1041033,"break":"none","ruby":[[7,1,"いま"],[15,1,"かしこ"],[17,1,"ひと"],[19,1,"たず"],[21,1,"だ"],[29,1,"くに"],[31,1,"おさ"]],"text":"それゆえパロは今、さとく、かつ賢い人を尋ね出してエジプトの国を治めさせなさい。"},{"ref":"Gen.41.34","start":1041034,"end":1041034,"break":"none","ruby":[[7,2,"くにぢゅう"],[10,2,"かんとく"],[13,1,"お"],[19,1,"ねん"],[21,2,"ほうさく"],[33,1,"くに"],[35,2,"さんぶつ"],[39,1,"ぶん"],[43,1,"と"]],"text":"パロはこうして国中に監督を置き、その七年の豊作のうちに、エジプトの国の産物の五分の一を取り、"},{"ref":"Gen.41.35","start":1041035,"end":1041035,"break":"none","ruby":[[0,1,"つづ"],[3,1,"く"],[5,1,"よ"],[7,2,"ねんねん"],[14,2,"しょくりょう"],[17,1,"かれ"],[20,1,"あつ"],[25,2,"こくもつ"],[28,2,"しょくりょう"],[37,1,"て"],[39,2,"まちまち"],[46,1,"まも"]],"text":"続いて来る良い年々のすべての食糧を彼らに集めさせ、穀物を食糧として、パロの手で町々にたくわえ守らせなさい。"},{"ref":"Gen.41.36","start":1041036,"end":1041036,"break":"none","ruby":[[5,2,"しょくりょう"],[14,1,"くに"],[16,1,"のぞ"],[19,1,"ねん"],[25,1,"そな"],[31,1,"くに"],[46,1,"くに"],[55,1,"ほろ"]],"text":"こうすれば食糧は、エジプトの国に臨む七年のききんに備えて、この国のためにたくわえとなり、この国はききんによって滅びることがないでしょう」。"},{"ref":"Gen.41.37","start":1041037,"end":1041037,"break":"paragraph","ruby":[[2,1,"こと"],[13,2,"けらい"],[18,1,"め"]],"text":"この事はパロとそのすべての家来たちの目にかなった。"},{"ref":"Gen.41.38","start":1041038,"end":1041038,"break":"none","ruby":[[6,2,"けらい"],[11,1,"い"],[21,1,"かみ"],[23,1,"れい"],[32,1,"ひと"],[38,1,"み"],[42,1,"え"]],"text":"そこでパロは家来たちに言った、「われわれは神の霊をもつこのような人を、ほかに見いだし得ようか」。"},{"ref":"Gen.41.39","start":1041039,"end":1041039,"break":"none","ruby":[[9,1,"い"],[14,1,"かみ"],[19,1,"みな"],[24,1,"しめ"],[39,1,"かしこ"],[41,1,"もの"]],"text":"またパロはヨセフに言った、「神がこれを皆あなたに示された。あなたのようにさとく賢い者はない。"},{"ref":"Gen.41.40","start":1041040,"end":1041040,"break":"none","ruby":[[8,1,"いえ"],[10,1,"おさ"],[22,1,"たみ"],[30,2,"ことば"],[33,1,"したが"],[46,1,"おう"],[48,1,"くらい"]],"text":"あなたはわたしの家を治めてください。わたしの民はみなあなたの言葉に従うでしょう。わたしはただ王の位でだけあなたにまさる」。"},{"ref":"Gen.41.41","start":1041041,"end":1041041,"break":"none","ruby":[[3,1,"さら"],[9,1,"い"],[26,2,"ぜんこく"]],"text":"パロは更にヨセフに言った、「わたしはあなたをエジプト全国のつかさとする」。"},{"ref":"Gen.41.42","start":1041042,"end":1041042,"break":"none","ruby":[[6,2,"ゆびわ"],[9,1,"て"],[21,1,"て"],[26,2,"あま"],[28,1,"ぬの"],[30,2,"いふく"],[33,1,"き"],[36,1,"きん"],[38,1,"くさり"]],"text":"そしてパロは指輪を手からはずして、ヨセフの手にはめ、亜麻布の衣服を着せ、金の鎖をくびにかけ、"},{"ref":"Gen.41.43","start":1041043,"end":1041043,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"だい"],[6,1,"くるま"],[8,1,"かれ"],[10,1,"の"],[23,1,"まえ"],[25,1,"よ"],[35,1,"かれ"],[41,2,"ぜんこく"]],"text":"自分の第二の車に彼を乗せ、「ひざまずけ」とその前に呼ばわらせ、こうして彼をエジプト全国のつかさとした。"},{"ref":"Gen.41.44","start":1041044,"end":1041044,"break":"none","ruby":[[10,1,"い"],[29,1,"ゆる"],[40,2,"ぜんこく"],[47,2,"てあし"],[50,1,"あ"]],"text":"ついでパロはヨセフに言った、「わたしはパロである。あなたの許しがなければエジプト全国で、だれも手足を上げることはできない」。"},{"ref":"Gen.41.45","start":1041045,"end":1041045,"break":"none","ruby":[[7,1,"な"],[18,1,"よ"],[24,2,"さいし"],[31,1,"むすめ"],[37,1,"つま"],[41,1,"かれ"],[43,1,"あた"],[56,1,"くに"],[58,1,"めぐ"]],"text":"パロはヨセフの名をザフナテ・パネアと呼び、オンの祭司ポテペラの娘アセナテを妻として彼に与えた。ヨセフはエジプトの国を巡った。"},{"ref":"Gen.41.46","start":1041046,"end":1041046,"break":"paragraph","ruby":[[9,1,"おう"],[13,1,"まえ"],[15,1,"た"],[18,1,"とき"],[22,1,"さい"],[35,1,"まえ"],[37,1,"で"],[44,2,"ぜんこく"],[51,1,"めぐ"]],"text":"ヨセフがエジプトの王パロの前に立った時は三十歳であった。ヨセフはパロの前を出て、エジプト全国をあまねく巡った。"},{"ref":"Gen.41.47","start":1041047,"end":1041047,"break":"none","ruby":[[3,1,"ねん"],[5,2,"ほうさく"],[11,1,"ち"],[13,1,"ゆた"],[16,1,"もの"],[18,1,"さん"]],"text":"さて七年の豊作のうちに地は豊かに物を産した。"},{"ref":"Gen.41.48","start":1041048,"end":1041048,"break":"none","ruby":[[12,1,"くに"],[20,2,"ねんかん"],[23,2,"しょくりょう"],[31,1,"あつ"],[36,2,"しょくりょう"],[39,2,"まちまち"],[42,1,"おさ"],[52,1,"まち"],[54,2,"しゅうい"],[59,1,"はたけ"],[61,2,"しょくりょう"],[66,1,"まち"],[68,1,"なか"],[70,1,"おさ"]],"text":"そこでヨセフはエジプトの国にできたその七年間の食糧をことごとく集め、その食糧を町々に納めさせた。すなわち町の周囲にある畑の食糧をその町の中に納めさせた。"},{"ref":"Gen.41.49","start":1041049,"end":1041049,"break":"none","ruby":[[4,2,"こくもつ"],[7,1,"うみ"],[9,1,"すな"],[15,2,"ひじょう"],[18,1,"おお"],[25,1,"はか"],[40,1,"はか"]],"text":"ヨセフは穀物を海の砂のように、非常に多くたくわえ、量りきれなくなったので、ついに量ることをやめた。"},{"ref":"Gen.41.50","start":1041050,"end":1041050,"break":"paragraph","ruby":[[4,1,"とし"],[6,1,"く"],[8,1,"まえ"],[18,1,"こ"],[20,1,"うま"],[31,2,"さいし"],[38,1,"むすめ"],[44,1,"う"]],"text":"ききんの年の来る前にヨセフにふたりの子が生れた。これらはオンの祭司ポテペラの娘アセナテが産んだのである。"},{"ref":"Gen.41.51","start":1041051,"end":1041051,"break":"none","ruby":[[4,2,"ちょうし"],[7,1,"な"],[13,1,"な"],[17,1,"い"],[22,1,"かみ"],[32,2,"くなん"],[35,1,"ちち"],[37,1,"いえ"],[43,1,"こと"],[45,1,"わす"]],"text":"ヨセフは長子の名をマナセと名づけて言った、「神がわたしにすべての苦難と父の家のすべての事を忘れさせられた」。"},{"ref":"Gen.41.52","start":1041052,"end":1041052,"break":"none","ruby":[[2,1,"つぎ"],[4,1,"こ"],[6,1,"な"],[14,1,"な"],[18,1,"い"],[23,1,"かみ"],[29,1,"なや"],[32,1,"ち"],[34,1,"ゆた"]],"text":"また次の子の名をエフライムと名づけて言った、「神がわたしを悩みの地で豊かにせられた」。"},{"ref":"Gen.41.53","start":1041053,"end":1041053,"break":"paragraph","ruby":[[5,1,"くに"],[11,1,"ねん"],[13,2,"ほうさく"],[16,1,"おわ"]],"text":"エジプトの国にあった七年の豊作が終り、"},{"ref":"Gen.41.54","start":1041054,"end":1041054,"break":"none","ruby":[[4,1,"い"],[11,1,"ねん"],[17,1,"はじ"],[32,1,"くに"],[43,2,"ぜんこく"],[47,2,"しょくもつ"]],"text":"ヨセフの言ったように七年のききんが始まった。そのききんはすべての国にあったが、エジプト全国には食物があった。"},{"ref":"Gen.41.55","start":1041055,"end":1041055,"break":"none","ruby":[[7,2,"ぜんこく"],[10,1,"う"],[13,1,"とき"],[15,1,"たみ"],[20,2,"しょくもつ"],[23,1,"さけ"],[25,1,"もと"],[46,1,"い"],[58,1,"い"],[61,1,"かれ"],[63,1,"い"]],"text":"やがてエジプト全国が飢えた時、民はパロに食物を叫び求めた。そこでパロはすべてのエジプトびとに言った、「ヨセフのもとに行き、彼の言うようにせよ」。"},{"ref":"Gen.41.56","start":1041056,"end":1041056,"break":"none","ruby":[[4,1,"ち"],[6,2,"ぜんめん"],[23,2,"こくぐら"],[26,1,"ひら"],[37,1,"う"],[54,1,"くに"],[56,1,"はげ"]],"text":"ききんが地の全面にあったので、ヨセフはすべての穀倉を開いて、エジプトびとに売った。ききんはますますエジプトの国に激しくなった。"},{"ref":"Gen.41.57","start":1041057,"end":1041057,"break":"none","ruby":[[4,1,"ぜん"],[5,1,"ち"],[7,1,"はげ"],[16,2,"しょこく"],[19,2,"ひとびと"],[34,2,"こくもつ"],[37,1,"か"]],"text":"ききんが全地に激しくなったので、諸国の人々がエジプトのヨセフのもとに穀物を買うためにきた。"}]