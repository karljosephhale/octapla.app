[{"ref":"Deut.22.1","start":5022001,"end":5022001,"break":"paragraph","ruby":[[4,2,"きょうだい"],[7,1,"うし"],[12,1,"ひつじ"],[14,1,"まよ"],[21,1,"み"],[27,2,"みす"],[40,1,"かなら"],[45,2,"きょうだい"],[52,1,"つ"],[55,1,"かえ"]],"text":"あなたの兄弟の牛、または羊の迷っているのを見て、それを見捨てておいてはならない。必ずそれを兄弟のところへ連れて帰らなければならない。"},{"ref":"Deut.22.2","start":5022002,"end":5022002,"break":"none","ruby":[[4,2,"きょうだい"],[7,1,"ちか"],[10,1,"もの"],[15,1,"し"],[19,1,"ひと"],[30,2,"じぶん"],[33,1,"いえ"],[54,2,"きょうだい"],[57,1,"たず"],[62,1,"とき"],[68,1,"かれ"],[70,1,"かえ"]],"text":"もしその兄弟が近くの者でなく、知らない人であるならば、それを自分の家にひいてきて、あなたのところにおき、その兄弟が尋ねてきた時に、それを彼に返さなければならない。"},{"ref":"Deut.22.3","start":5022003,"end":5022003,"break":"none","ruby":[[4,2,"きょうだい"],[10,2,"ばあい"],[26,2,"きもの"],[29,2,"ばあい"],[54,2,"きょうだい"],[57,1,"うしな"],[60,1,"もの"],[62,1,"み"],[66,2,"ばあい"],[85,2,"みす"]],"text":"あなたの兄弟のろばの場合も、そうしなければならない。着物の場合も、そうしなければならない。またすべてあなたの兄弟の失った物を見つけた場合も、そうしなければならない。それを見捨てておくことはできない。"},{"ref":"Deut.22.4","start":5022004,"end":5022004,"break":"none","ruby":[[4,2,"きょうだい"],[12,1,"うし"],[14,1,"みち"],[16,1,"たお"],[23,1,"み"],[26,2,"みす"],[39,1,"かなら"],[44,1,"たす"],[46,1,"おこ"]],"text":"あなたの兄弟のろばまたは牛が道に倒れているのを見て、見捨てておいてはならない。必ずそれを助け起さなければならない。"},{"ref":"Deut.22.5","start":5022005,"end":5022005,"break":"paragraph","ruby":[[0,1,"おんな"],[2,1,"おとこ"],[4,2,"きもの"],[7,1,"き"],[17,1,"おとこ"],[19,1,"おんな"],[21,2,"きもの"],[24,1,"き"],[36,1,"かみ"],[38,1,"しゅ"],[45,1,"こと"],[49,1,"もの"],[51,1,"い"]],"text":"女は男の着物を着てはならない。また男は女の着物を着てはならない。あなたの神、主はそのような事をする者を忌みきらわれるからである。"},{"ref":"Deut.22.6","start":5022006,"end":5022006,"break":"paragraph","ruby":[[6,1,"みち"],[9,1,"き"],[11,1,"うえ"],[16,2,"じめん"],[19,1,"とり"],[21,1,"す"],[27,1,"み"],[33,1,"なか"],[35,1,"ひよこ"],[39,1,"たまご"],[45,1,"はは"],[46,1,"とり"],[50,1,"ひよこ"],[54,1,"たまご"],[56,1,"だ"],[65,1,"はは"],[66,1,"とり"],[68,1,"ひよこ"],[70,2,"いっしょ"],[73,1,"と"]],"text":"もしあなたが道で、木の上、または地面に鳥の巣のあるのを見つけ、その中に雛または卵があって、母鳥がその雛または卵を抱いているならば、母鳥を雛と一緒に取ってはならない。"},{"ref":"Deut.22.7","start":5022007,"end":5022007,"break":"none","ruby":[[0,1,"かなら"],[2,1,"はは"],[3,1,"とり"],[5,1,"さ"],[11,1,"ひよこ"],[15,1,"と"],[40,1,"え"],[42,1,"なが"],[44,1,"い"]],"text":"必ず母鳥を去らせ、ただ雛だけを取らなければならない。そうすればあなたはさいわいを得、長く生きながらえることができるであろう。"},{"ref":"Deut.22.8","start":5022008,"end":5022008,"break":"paragraph","ruby":[[0,1,"あたら"],[3,1,"いえ"],[5,1,"た"],[8,1,"とき"],[11,2,"やね"],[14,2,"らんかん"],[17,1,"もう"],[31,1,"ひと"],[33,2,"やね"],[37,1,"お"],[41,1,"ち"],[50,1,"いえ"],[52,1,"き"]],"text":"新しい家を建てる時は、屋根に欄干を設けなければならない。それは人が屋根から落ちて、血のとがをあなたの家に帰することのないようにするためである。"},{"ref":"Deut.22.9","start":5022009,"end":5022009,"break":"paragraph","ruby":[[3,1,"はたけ"],[6,1,"しゅ"],[8,1,"たね"],[10,1,"ま"],[34,1,"たね"],[37,1,"さん"],[40,1,"もの"],[46,1,"はたけ"],[49,1,"で"],[51,1,"もの"],[56,1,"い"],[60,1,"もの"]],"text":"ぶどう畑に二種の種を混ぜてまいてはならない。そうすればあなたがまいた種から産する物も、ぶどう畑から出る物も、みな忌むべき物となるであろう。"},{"ref":"Deut.22.10","start":5022010,"end":5022010,"break":"none","ruby":[[0,1,"うし"],[7,1,"く"],[9,1,"あ"],[13,1,"たがや"]],"text":"牛と、ろばとを組み合わせて耕してはならない。"},{"ref":"Deut.22.11","start":5022011,"end":5022011,"break":"none","ruby":[[0,2,"ようもう"],[3,2,"あま"],[5,1,"いと"],[7,1,"ま"],[10,1,"お"],[13,2,"きもの"],[16,1,"き"]],"text":"羊毛と亜麻糸を混ぜて織った着物を着てはならない。"},{"ref":"Deut.22.12","start":5022012,"end":5022012,"break":"paragraph","ruby":[[0,1,"み"],[5,2,"うわぎ"]],"text":"身にまとう上着の四すみに、ふさをつけなければならない。"},{"ref":"Deut.22.13","start":5022013,"end":5022013,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"つま"],[10,1,"つま"],[20,1,"のち"],[24,1,"おんな"]],"text":"もし人が妻をめとり、妻のところにはいって後、その女をきらい、"},{"ref":"Deut.22.14","start":5022014,"end":5022014,"break":"none","ruby":[[7,1,"おんな"],[13,1,"ちか"],[17,1,"とき"],[19,2,"かのじょ"],[22,2,"しょじょ"],[25,2,"しょうこ"],[28,1,"み"],[35,1,"い"],[38,2,"きょぎ"],[41,2,"ひなん"],[50,1,"おんな"],[52,2,"あくめい"],[55,1,"お"]],"text":"『わたしはこの女をめとって近づいた時、彼女に処女の証拠を見なかった』と言って虚偽の非難をもって、その女に悪名を負わせるならば、"},{"ref":"Deut.22.15","start":5022015,"end":5022015,"break":"none","ruby":[[2,1,"おんな"],[4,1,"ちち"],[6,1,"はは"],[9,2,"かのじょ"],[12,2,"しょじょ"],[15,2,"しょうこ"],[18,1,"と"],[22,1,"もん"],[26,1,"まち"],[28,2,"ちょうろう"],[33,1,"さ"],[35,1,"だ"]],"text":"その女の父と母は、彼女の処女の証拠を取って、門におる町の長老たちに差し出し、"},{"ref":"Deut.22.16","start":5022016,"end":5022016,"break":"none","ruby":[[3,2,"かのじょ"],[6,1,"ちち"],[8,2,"ちょうろう"],[13,1,"い"],[31,1,"ひと"],[33,1,"むすめ"],[35,1,"あた"],[38,1,"つま"],[49,1,"ひと"],[51,1,"むすめ"]],"text":"そして彼女の父は長老たちに言わなければならない。『わたしはこの人に娘を与えて妻にさせましたが、この人は娘をきらい、"},{"ref":"Deut.22.17","start":5022017,"end":5022017,"break":"none","ruby":[[0,2,"きょぎ"],[3,2,"ひなん"],[19,1,"むすめ"],[21,2,"しょじょ"],[24,2,"しょうこ"],[27,1,"み"],[34,1,"い"],[50,1,"むすめ"],[52,2,"しょじょ"],[55,2,"しょうこ"],[61,1,"い"],[67,2,"ふぼ"],[72,1,"ぬの"],[74,1,"まち"],[76,2,"ちょうろう"],[81,1,"まえ"]],"text":"虚偽の非難をもって、「わたしはあなたの娘に処女の証拠を見なかった」と言います。しかし、これがわたしの娘の処女の証拠です』と言って、その父母はかの布を町の長老たちの前にひろげなければならない。"},{"ref":"Deut.22.18","start":5022018,"end":5022018,"break":"none","ruby":[[2,1,"とき"],[4,1,"まち"],[6,2,"ちょうろう"],[14,1,"ひと"],[16,1,"とら"],[19,1,"う"],[21,1,"こ"]],"text":"その時、町の長老たちは、その人を捕えて撃ち懲らし、"},{"ref":"Deut.22.19","start":5022019,"end":5022019,"break":"none","ruby":[[2,1,"ぎん"],[8,2,"ばっきん"],[11,1,"か"],[17,1,"おんな"],[19,1,"ちち"],[21,1,"あた"],[32,1,"かれ"],[40,2,"しょじょ"],[43,2,"あくめい"],[46,1,"お"],[56,1,"かれ"],[60,1,"おんな"],[62,1,"つま"],[66,2,"いっしょう"],[70,1,"おんな"],[72,1,"だ"]],"text":"また銀百シケルの罰金を課し、それを女の父に与えなければならない。彼はイスラエルの処女に悪名を負わせたからである。彼はその女を妻とし、一生その女を出すことはできない。"},{"ref":"Deut.22.20","start":5022020,"end":5022020,"break":"none","ruby":[[6,2,"ひなん"],[9,2,"しんじつ"],[18,1,"おんな"],[20,2,"しょじょ"],[23,2,"しょうこ"],[26,1,"み"],[31,1,"とき"]],"text":"しかし、この非難が真実であって、その女に処女の証拠が見られない時は、"},{"ref":"Deut.22.21","start":5022021,"end":5022021,"break":"none","ruby":[[2,1,"おんな"],[4,1,"ちち"],[6,1,"いえ"],[8,2,"いりぐち"],[13,1,"だ"],[16,1,"まち"],[18,2,"ひとびと"],[21,2,"かのじょ"],[24,1,"いし"],[26,1,"う"],[28,1,"ころ"],[39,2,"かのじょ"],[42,1,"ちち"],[44,1,"いえ"],[51,1,"こと"],[67,1,"おろ"],[70,1,"こと"],[98,1,"あく"],[100,1,"のぞ"],[102,1,"さ"]],"text":"その女を父の家の入口にひき出し、町の人々は彼女を石で撃ち殺さなければならない。彼女は父の家で、みだらな事をおこない、イスラエルのうちに愚かな事をしたからである。あなたはこうしてあなたがたのうちから悪を除き去らなければならない。"},{"ref":"Deut.22.22","start":5022022,"end":5022022,"break":"paragraph","ruby":[[2,1,"おっと"],[6,1,"おんな"],[8,1,"ね"],[12,1,"おとこ"],[14,1,"み"],[24,1,"おんな"],[26,1,"ね"],[28,1,"おとこ"],[34,1,"おんな"],[36,2,"いっしょ"],[39,1,"ころ"],[56,1,"あく"],[58,1,"のぞ"],[60,1,"さ"]],"text":"もし夫のある女と寝ている男を見つけたならば、その女と寝た男およびその女を一緒に殺し、こうしてイスラエルのうちから悪を除き去らなければならない。"},{"ref":"Deut.22.23","start":5022023,"end":5022023,"break":"paragraph","ruby":[[2,2,"しょじょ"],[7,1,"おんな"],[10,1,"ひと"],[12,2,"こんやく"],[16,1,"のち"],[18,1,"た"],[20,1,"おとこ"],[22,1,"まち"],[24,1,"うち"],[28,1,"おんな"],[30,1,"あ"],[36,1,"おか"]],"text":"もし処女である女が、人と婚約した後、他の男が町の内でその女に会い、これを犯したならば、"},{"ref":"Deut.22.24","start":5022024,"end":5022024,"break":"none","ruby":[[12,1,"まち"],[14,1,"もん"],[18,1,"だ"],[22,1,"いし"],[24,1,"う"],[26,1,"ころ"],[42,1,"おんな"],[44,1,"まち"],[46,1,"うち"],[53,1,"さけ"],[69,1,"おとこ"],[71,2,"りんじん"],[74,1,"つま"],[106,1,"あく"],[108,1,"のぞ"],[110,1,"さ"]],"text":"あなたがたはそのふたりを町の門にひき出して、石で撃ち殺さなければならない。これはその女が町の内におりながら叫ばなかったからであり、またその男は隣人の妻をはずかしめたからである。あなたはこうしてあなたがたのうちから悪を除き去らなければならない。"},{"ref":"Deut.22.25","start":5022025,"end":5022025,"break":"paragraph","ruby":[[4,1,"おとこ"],[7,1,"ひと"],[9,2,"こんやく"],[13,1,"おんな"],[15,1,"の"],[17,1,"あ"],[22,1,"おんな"],[24,1,"とら"],[30,1,"おか"],[39,1,"おとこ"],[43,1,"ころ"]],"text":"しかし、男が、人と婚約した女に野で会い、その女を捕えてこれを犯したならば、その男だけを殺さなければならない。"},{"ref":"Deut.22.26","start":5022026,"end":5022026,"break":"none","ruby":[[2,1,"おんな"],[5,1,"なに"],[15,1,"おんな"],[18,1,"し"],[23,1,"つみ"],[28,1,"ひと"],[32,2,"りんじん"],[35,1,"た"],[45,1,"ころ"],[49,1,"おな"],[51,2,"じけん"]],"text":"その女には何もしてはならない。女には死にあたる罪がない。人がその隣人に立ちむかって、それを殺したと同じ事件だからである。"},{"ref":"Deut.22.27","start":5022027,"end":5022027,"break":"none","ruby":[[3,1,"おとこ"],[5,1,"の"],[7,1,"おんな"],[9,1,"あ"],[15,1,"ひと"],[17,2,"こんやく"],[23,1,"おんな"],[25,1,"さけ"],[33,1,"すく"],[35,1,"もの"]],"text":"これは男が野で女に会ったので、人と婚約したその女が叫んだけれども、救う者がなかったのである。"},{"ref":"Deut.22.28","start":5022028,"end":5022028,"break":"paragraph","ruby":[[2,1,"ひと"],[4,2,"こんやく"],[9,2,"しょじょ"],[14,1,"おんな"],[17,1,"おとこ"],[19,1,"あ"],[25,1,"とら"],[28,1,"おか"],[35,1,"み"]],"text":"まだ人と婚約しない処女である女に、男が会い、これを捕えて犯し、ふたりが見つけられたならば、"},{"ref":"Deut.22.29","start":5022029,"end":5022029,"break":"none","ruby":[[0,1,"おんな"],[2,1,"おか"],[5,1,"おとこ"],[7,1,"おんな"],[9,1,"ちち"],[11,1,"ぎん"],[18,1,"あた"],[22,1,"おんな"],[24,2,"じぶん"],[27,1,"つま"],[39,1,"かれ"],[43,1,"おんな"],[55,2,"いっしょう"],[59,1,"おんな"],[61,1,"だ"]],"text":"女を犯した男は女の父に銀五十シケルを与えて、女を自分の妻としなければならない。彼はその女をはずかしめたゆえに、一生その女を出すことはできない。"},{"ref":"Deut.22.30","start":5022030,"end":5022030,"break":"paragraph","ruby":[[3,1,"ちち"],[5,1,"つま"],[17,1,"ちち"],[19,1,"つま"],[21,1,"ね"]],"text":"だれも父の妻をめとってはならない。父の妻と寝てはならない。"}]