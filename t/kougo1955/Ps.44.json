[{"ref":"Ps.44.1","start":19044001,"end":19044001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたコラの子のマスキールの歌","breaks":[[20,"line"],[32,"line"]],"ruby":[[0,1,"かみ"],[12,2,"せんぞ"],[17,1,"ひ"],[32,1,"かれ"],[39,1,"かた"],[44,1,"みみ"],[46,1,"き"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[19,1,"こ"],[27,1,"うた"]],"text":"神よ、いにしえ、われらの先祖たちの日に、あなたがなされたみわざを彼らがわれらに語ったのを耳で聞きました。"},{"ref":"Ps.44.2","start":19044002,"end":19044002,"break":"line","breaks":[[23,"line"],[40,"line"],[54,"line"]],"ruby":[[9,1,"て"],[20,2,"くにたみ"],[23,1,"お"],[25,1,"はら"],[32,2,"せんぞ"],[37,1,"う"],[47,1,"たみ"],[49,1,"なや"],[58,2,"せんぞ"],[65,1,"ひろ"]],"text":"すなわちあなたはみ手をもって、もろもろの国民を追い払ってわれらの先祖たちを植え、またもろもろの民を悩まして、われらの先祖たちをふえ広がらせられました。"},{"ref":"Ps.44.3","start":19044003,"end":19044003,"break":"line","breaks":[[22,"line"],[46,"line"],[62,"line"],[78,"line"]],"ruby":[[0,1,"かれ"],[3,2,"じぶん"],[13,1,"くに"],[15,1,"え"],[24,2,"じぶん"],[27,1,"うで"],[32,2,"しょうり"],[35,1,"え"],[52,1,"みぎ"],[54,1,"て"],[60,1,"うで"],[67,1,"かお"],[69,1,"ひかり"],[82,1,"かれ"],[85,1,"めぐ"]],"text":"彼らは自分のつるぎによって国を獲たのでなく、また自分の腕によって勝利を得たのでもありません。ただあなたの右の手、あなたの腕、あなたのみ顔の光によるのでした。あなたが彼らを恵まれたからです。"},{"ref":"Ps.44.4","start":19044004,"end":19044004,"break":"line","breaks":[[12,"line"]],"ruby":[[6,1,"おう"],[10,1,"かみ"],[19,2,"しょうり"],[22,1,"さだ"],[27,1,"かた"]],"text":"あなたはわが王、わが神、ヤコブのために勝利を定められる方です。"},{"ref":"Ps.44.5","start":19044005,"end":19044005,"break":"line","breaks":[[20,"line"],[32,"line"]],"ruby":[[15,1,"お"],[17,1,"たお"],[24,1,"た"],[29,1,"もの"],[33,1,"な"],[38,1,"ふ"]],"text":"われらはあなたによって、あだを押し倒し、われらに立ちむかう者を、み名によって踏みにじるのです。"},{"ref":"Ps.44.6","start":19044006,"end":19044006,"break":"line","breaks":[[24,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"ゆみ"],[9,1,"たの"],[28,1,"すく"]],"text":"わたしは自分の弓を頼まず、わたしのつるぎもまた、わたしを救うことができないからです。"},{"ref":"Ps.44.7","start":19044007,"end":19044007,"break":"line","breaks":[[18,"line"]],"ruby":[[15,1,"すく"],[22,1,"にく"],[24,1,"もの"]],"text":"しかしあなたはわれらをあだから救い、われらを憎む者をはずかしめられました。"},{"ref":"Ps.44.8","start":19044008,"end":19044008,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"つね"],[6,1,"かみ"],[11,1,"ほこ"],[24,1,"な"],[26,2,"かんしゃ"]],"text":"われらは常に神によって誇り、とこしえにあなたのみ名に感謝するでしょう。〔セラ"},{"ref":"Ps.44.9","start":19044009,"end":19044009,"break":"line","breaks":[[21,"line"]],"ruby":[[12,1,"す"],[15,1,"はじ"],[17,1,"お"],[25,2,"ぐんぜい"],[28,1,"とも"],[30,1,"で"],[32,1,"い"]],"text":"ところがあなたはわれらを捨てて恥を負わせ、われらの軍勢と共に出て行かれませんでした。"},{"ref":"Ps.44.10","start":19044010,"end":19044010,"break":"line","breaks":[[23,"line"]],"ruby":[[11,1,"まえ"],[14,1,"しりぞ"],[27,1,"てき"],[29,1,"こころ"],[37,1,"うば"]],"text":"あなたがわれらをあだの前から退かせられたので、われらの敵は心のままにかすめ奪いました。"},{"ref":"Ps.44.11","start":19044011,"end":19044011,"break":"line","breaks":[[20,"line"]],"ruby":[[13,1,"ひつじ"],[27,2,"くにたみ"],[33,1,"ち"]],"text":"あなたはわれらをほふられる羊のようにし、またもろもろの国民のなかに散らされました。"},{"ref":"Ps.44.12","start":19044012,"end":19044012,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"きん"],[14,1,"たみ"],[16,1,"う"],[19,1,"かれ"],[25,1,"たか"],[27,1,"あたい"],[29,1,"もと"]],"text":"あなたはわずかの金であなたの民を売り、彼らのために高い価を求められませんでした。"},{"ref":"Ps.44.13","start":19044013,"end":19044013,"break":"line","breaks":[[17,"line"],[32,"line"]],"ruby":[[8,1,"とな"],[10,1,"びと"],[24,1,"もの"],[28,1,"あなど"]],"text":"あなたはわれらを隣り人にそしらせ、われらをめぐる者どもに侮らせ、あざけらせられました。"},{"ref":"Ps.44.14","start":19044014,"end":19044014,"break":"line","breaks":[[23,"line"]],"ruby":[[7,2,"くにたみ"],[17,1,"わら"],[19,1,"ぐさ"],[28,1,"たみ"],[33,1,"わら"],[35,1,"もの"]],"text":"またもろもろの国民のなかにわれらを笑い草とし、もろもろの民のなかに笑い者とされました。"},{"ref":"Ps.44.15","start":19044015,"end":19044015,"break":"line","breaks":[[21,"line"]],"ruby":[[16,1,"まえ"],[21,1,"はじ"],[27,1,"かお"]],"text":"わがはずかしめはひねもすわたしの前にあり、恥はわたしの顔をおおいました。"},{"ref":"Ps.44.16","start":19044016,"end":19044016,"break":"line","breaks":[[21,"line"]],"ruby":[[6,1,"もの"],[13,1,"もの"],[15,2,"ことば"],[21,1,"てき"],[24,1,"うら"],[27,1,"むく"],[30,1,"もの"]],"text":"これはそしる者と、ののしる者の言葉により、敵と、恨みを報いる者のゆえによるのです。"},{"ref":"Ps.44.17","start":19044017,"end":19044017,"break":"line","breaks":[[18,"line"],[30,"line"]],"ruby":[[4,1,"こと"],[6,1,"みな"],[11,1,"のぞ"],[26,1,"わす"],[34,2,"けいやく"]],"text":"これらの事が皆われらに臨みましたが、われらはあなたを忘れず、あなたの契約にそむくことがありませんでした。"},{"ref":"Ps.44.18","start":19044018,"end":19044018,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"こころ"],[18,1,"あゆ"],[25,1,"みち"],[27,1,"はな"]],"text":"われらの心はたじろがず、またわれらの歩みはあなたの道を離れませんでした。"},{"ref":"Ps.44.19","start":19044019,"end":19044019,"break":"line","breaks":[[22,"line"]],"ruby":[[8,2,"やまいぬ"],[11,1,"す"],[13,1,"ところ"],[19,1,"くだ"],[22,1,"くら"]],"text":"それでもあなたは山犬の住む所でわれらを砕き、暗やみをもってわれらをおおわれました。"},{"ref":"Ps.44.20","start":19044020,"end":19044020,"break":"line","breaks":[[17,"line"]],"ruby":[[10,1,"かみ"],[12,1,"な"],[14,1,"わす"],[20,1,"かみ"],[22,1,"て"],[24,1,"の"]],"text":"われらがもしわれらの神の名を忘れ、ほかの神に手を伸べたことがあったならば、"},{"ref":"Ps.44.21","start":19044021,"end":19044021,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かみ"],[5,1,"み"],[19,1,"かみ"],[21,1,"こころ"],[23,2,"ひみつ"],[27,1,"し"]],"text":"神はこれを見あらわされないでしょうか。神は心の秘密をも知っておられるからです。"},{"ref":"Ps.44.22","start":19044022,"end":19044022,"break":"line","breaks":[[24,"line"]],"ruby":[[19,1,"ころ"],[29,1,"ひつじ"]],"text":"ところがわれらはあなたのためにひねもす殺されて、ほふられる羊のようにみなされました。"},{"ref":"Ps.44.23","start":19044023,"end":19044023,"break":"line","breaks":[[25,"line"],[36,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"お"],[13,1,"ねむ"],[25,1,"め"],[45,1,"す"]],"text":"主よ、起きてください。なぜ眠っておられるのですか。目をさましてください。われらをとこしえに捨てないでください。"},{"ref":"Ps.44.24","start":19044024,"end":19044024,"break":"line","breaks":[[18,"line"],[33,"line"]],"ruby":[[7,1,"かお"],[9,1,"かく"],[24,1,"なや"],[34,1,"わす"]],"text":"なぜあなたはみ顔を隠されるのですか。なぜわれらの悩みと、しえたげをお忘れになるのですか。"},{"ref":"Ps.44.25","start":19044025,"end":19044025,"break":"line","breaks":[[21,"line"]],"ruby":[[8,1,"たましい"],[18,1,"ふ"],[29,1,"つち"]],"text":"まことにわれらの魂はかがんで、ちりに伏し、われらのからだは土につきました。"},{"ref":"Ps.44.26","start":19044026,"end":19044026,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[0,1,"お"],[9,1,"たす"]],"text":"起きて、われらをお助けください。あなたのいつくしみのゆえに、われらをあがなってください。"}]