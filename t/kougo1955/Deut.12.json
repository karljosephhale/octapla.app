[{"ref":"Deut.12.1","start":5012001,"end":5012001,"break":"paragraph","ruby":[[7,2,"せんぞ"],[12,1,"かみ"],[14,1,"しゅ"],[16,2,"しょゆう"],[21,1,"たま"],[24,1,"ち"],[33,1,"よ"],[35,1,"い"],[44,1,"あいだ"],[46,1,"まも"],[48,1,"おこな"],[58,1,"さだ"]],"text":"これはあなたの先祖たちの神、主が所有として賜わる地で、あなたがたが世に生きながらえている間、守り行わなければならない定めと、おきてである。"},{"ref":"Deut.12.2","start":5012002,"end":5012002,"break":"none","ruby":[[6,1,"お"],[8,1,"はら"],[10,2,"くにぐに"],[13,1,"たみ"],[18,2,"かみがみ"],[21,1,"つか"],[24,1,"ところ"],[27,1,"たか"],[29,1,"やま"],[37,1,"おか"],[45,1,"あお"],[46,1,"き"],[48,1,"した"]],"text":"あなたがたの追い払う国々の民が、その神々に仕えた所は、高い山にあるものも、丘にあるものも、青木の下にあるものも、ことごとくこわし、"},{"ref":"Deut.12.3","start":5012003,"end":5012003,"break":"none","ruby":[[2,2,"さいだん"],[9,1,"はしら"],[11,1,"くだ"],[17,1,"ぞう"],[19,1,"ひ"],[21,1,"や"],[26,1,"きざ"],[29,2,"かみがみ"],[32,1,"ぞう"],[34,1,"き"],[36,1,"たお"],[42,1,"な"],[46,1,"ところ"],[49,1,"け"],[51,1,"さ"]],"text":"その祭壇をこぼち、柱を砕き、アシラ像を火で焼き、また刻んだ神々の像を切り倒して、その名をその所から消し去らなければならない。"},{"ref":"Deut.12.4","start":5012004,"end":5012004,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"]],"text":"ただし、あなたがたの神、主にはそのようにしてはならない。"},{"ref":"Deut.12.5","start":5012005,"end":5012005,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[12,1,"な"],[14,1,"お"],[26,2,"ぜんぶ"],[28,1,"ぞく"],[34,1,"えら"],[38,2,"ばしょ"],[45,1,"しゅ"],[51,1,"たず"],[53,1,"もと"],[60,1,"い"]],"text":"あなたがたの神、主がその名を置くために、あなたがたの全部族のうちから選ばれる場所、すなわち主のすまいを尋ね求めて、そこに行き、"},{"ref":"Deut.12.6","start":5012006,"end":5012006,"break":"none","ruby":[[6,2,"はんさい"],[10,2,"ぎせい"],[15,1,"ぶん"],[23,1,"もの"],[26,2,"せいがん"],[29,1,"そな"],[31,1,"もの"],[34,2,"じはつ"],[37,1,"そな"],[39,1,"もの"],[43,1,"うし"],[45,1,"ひつじ"],[54,1,"たずさ"],[57,1,"い"]],"text":"あなたがたの燔祭と、犠牲と、十分の一と、ささげ物と、誓願の供え物と、自発の供え物および牛、羊のういごをそこに携えて行って、"},{"ref":"Deut.12.7","start":5012007,"end":5012007,"break":"none","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[13,1,"まえ"],[15,1,"た"],[25,2,"かぞく"],[28,1,"みな"],[30,1,"て"],[32,1,"ろう"],[35,1,"え"],[41,1,"もの"],[43,1,"よろこ"],[45,1,"たの"],[64,1,"かみ"],[66,1,"しゅ"],[68,1,"めぐ"],[74,1,"え"]],"text":"そこであなたがたの神、主の前で食べ、あなたがたも、家族も皆、手を労して獲るすべての物を喜び楽しまなければならない。これはあなたの神、主の恵みによって獲るものだからである。"},{"ref":"Deut.12.8","start":5012008,"end":5012008,"break":"none","ruby":[[29,1,"ただ"],[33,1,"おも"]],"text":"そこでは、われわれがきょうここでしているように、めいめいで正しいと思うようにふるまってはならない。"},{"ref":"Deut.12.9","start":5012009,"end":5012009,"break":"none","ruby":[[15,1,"かみ"],[17,1,"しゅ"],[20,1,"たま"],[23,2,"あんそく"],[26,1,"し"],[27,1,"ぎょう"],[29,1,"ち"]],"text":"あなたがたはまだ、あなたがたの神、主から賜わる安息と嗣業の地に、はいっていないのである。"},{"ref":"Deut.12.10","start":5012010,"end":5012010,"break":"none","ruby":[[15,1,"わた"],[24,1,"かみ"],[26,1,"しゅ"],[28,1,"し"],[29,1,"ぎょう"],[33,1,"たま"],[36,1,"ち"],[38,1,"す"],[49,1,"しゅ"],[57,2,"しゅうい"],[60,1,"てき"],[67,1,"のぞ"],[71,2,"あんそく"],[74,1,"あた"],[83,1,"やす"],[87,1,"す"],[94,1,"とき"]],"text":"しかし、あなたがたがヨルダンを渡り、あなたがたの神、主が嗣業として賜わる地に住むようになり、さらに主があなたがたの周囲の敵をことごとく除いて、安息を与え、あなたがたが安らかに住むようになる時、"},{"ref":"Deut.12.11","start":5012011,"end":5012011,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[12,1,"な"],[14,1,"お"],[23,2,"ばしょ"],[26,1,"えら"],[48,1,"めい"],[51,1,"もの"],[56,1,"たずさ"],[59,1,"い"],[81,2,"はんさい"],[85,2,"ぎせい"],[90,1,"ぶん"],[98,1,"もの"],[108,1,"しゅ"],[110,1,"ちか"],[117,2,"せいがん"],[120,1,"そな"],[122,1,"もの"],[125,1,"たずさ"],[128,1,"い"]],"text":"あなたがたの神、主はその名を置くために、一つの場所を選ばれるであろう。あなたがたはそこにわたしの命じる物をすべて携えて行かなければならない。すなわち、あなたがたの燔祭と、犠牲と、十分の一と、ささげ物およびあなたがたが主に誓ったすべての誓願の供え物とを携えて行かなければならない。"},{"ref":"Deut.12.12","start":5012012,"end":5012012,"break":"none","ruby":[[13,1,"むすめ"],[24,1,"とも"],[32,1,"かみ"],[34,1,"しゅ"],[36,1,"まえ"],[38,1,"よろこ"],[40,1,"たの"],[54,1,"まち"],[56,1,"うち"],[79,1,"かれ"],[90,1,"わ"],[92,1,"まえ"],[97,1,"し"],[98,1,"ぎょう"],[100,1,"も"]],"text":"そしてあなたがたのむすこ、娘、しもべ、はしためと共にあなたがたの神、主の前に喜び楽しまなければならない。また町の内におるレビびととも、そうしなければならない。彼はあなたがたのうちに分け前がなく、嗣業を持たないからである。"},{"ref":"Deut.12.13","start":5012013,"end":5012013,"break":"none","ruby":[[0,1,"つつし"],[14,1,"おも"],[16,2,"ばしょ"],[24,2,"はんさい"]],"text":"慎んで、すべてあなたがよいと思う場所で、みだりに燔祭をささげないようにしなければならない。"},{"ref":"Deut.12.14","start":5012014,"end":5012014,"break":"none","ruby":[[6,2,"ぶぞく"],[16,1,"しゅ"],[18,1,"えら"],[24,2,"ばしょ"],[28,2,"はんさい"],[41,1,"めい"],[48,1,"こと"]],"text":"ただあなたの部族の一つのうちに、主が選ばれるその場所で、燔祭をささげ、またわたしが命じるすべての事をしなければならない。"},{"ref":"Deut.12.15","start":5012015,"end":5012015,"break":"paragraph","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"たま"],[15,1,"めぐ"],[27,1,"こころ"],[29,1,"この"],[31,1,"けもの"],[36,1,"まち"],[40,1,"ころ"],[46,1,"にく"],[48,1,"た"],[68,1,"お"],[72,1,"にく"],[74,2,"どうよう"],[81,1,"けが"],[84,1,"ひと"],[87,1,"きよ"],[89,1,"ひと"],[92,1,"た"]],"text":"しかし、あなたの神、主が賜わる恵みにしたがって、すべて心に好む獣を、どの町ででも殺して、その肉を食べることができる。すなわち、かもしかや雄じかの肉と同様にそれを、汚れた人も、清い人も、食べることができる。"},{"ref":"Deut.12.16","start":5012016,"end":5012016,"break":"none","ruby":[[6,1,"ち"],[8,1,"た"],[17,1,"みず"],[25,1,"ち"],[27,1,"そそ"]],"text":"ただし、その血は食べてはならない。水のようにそれを地に注がなければならない。"},{"ref":"Deut.12.17","start":5012017,"end":5012017,"break":"none","ruby":[[4,2,"こくもつ"],[11,1,"しゅ"],[14,1,"あぶら"],[18,1,"ぶん"],[24,1,"うし"],[26,1,"ひつじ"],[40,1,"た"],[43,2,"せいがん"],[46,1,"そな"],[48,1,"もの"],[51,2,"じはつ"],[54,1,"そな"],[56,1,"もの"],[63,1,"もの"],[66,1,"まち"],[68,1,"うち"],[70,1,"た"]],"text":"あなたの穀物と、ぶどう酒と、油との十分の一および牛、羊のういご、ならびにあなたが立てる誓願の供え物と、自発の供え物およびささげ物は、町の内で食べることはできない。"},{"ref":"Deut.12.18","start":5012018,"end":5012018,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"えら"],[12,2,"ばしょ"],[20,1,"かみ"],[22,1,"しゅ"],[24,1,"まえ"],[29,1,"た"],[52,1,"むすめ"],[66,1,"まち"],[68,1,"うち"],[77,1,"とも"],[82,1,"た"],[85,1,"て"],[87,1,"ろう"],[90,1,"え"],[96,1,"もの"],[103,1,"かみ"],[105,1,"しゅ"],[107,1,"まえ"],[109,1,"よろこ"],[111,1,"たの"]],"text":"あなたの神、主が選ばれる場所で、あなたの神、主の前でそれを食べなければならない。すなわちあなたのむすこ、娘、しもべ、はしため、および町の内におるレビびとと共にそれを食べ、手を労して獲るすべての物を、あなたの神、主の前に喜び楽しまなければならない。"},{"ref":"Deut.12.19","start":5012019,"end":5012019,"break":"none","ruby":[[0,1,"つつし"],[8,1,"よ"],[10,1,"い"],[19,1,"あいだ"],[26,1,"す"]],"text":"慎んで、あなたが世に生きながらえている間、レビびとを捨てないようにしなければならない。"},{"ref":"Deut.12.20","start":5012020,"end":5012020,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,2,"やくそく"],[21,2,"りょういき"],[24,1,"ひろ"],[36,1,"にく"],[38,1,"た"],[43,1,"ねが"],[52,1,"にく"],[54,1,"た"],[60,1,"い"],[69,1,"とき"],[80,1,"にく"],[82,1,"た"]],"text":"あなたの神、主が約束されたように、あなたの領域を広くされるとき、あなたは肉を食べたいと願って、『わたしは肉を食べよう』と言うであろう。その時、あなたはほしいだけ肉を食べることができる。"},{"ref":"Deut.12.21","start":5012021,"end":5012021,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[12,1,"な"],[14,1,"お"],[19,1,"えら"],[23,2,"ばしょ"],[27,1,"とお"],[29,1,"はな"],[42,1,"めい"],[49,1,"しゅ"],[51,1,"たま"],[54,1,"うし"],[56,1,"ひつじ"],[62,1,"もん"],[64,1,"うち"],[72,1,"た"]],"text":"もしあなたの神、主がその名を置くために選ばれる場所が、遠く離れているならば、わたしが命じるように、主が賜わる牛、羊をほふり、門の内で、ほしいだけ食べることができる。"},{"ref":"Deut.12.22","start":5012022,"end":5012022,"break":"none","ruby":[[6,1,"お"],[10,1,"た"],[20,1,"た"],[34,1,"けが"],[37,1,"ひと"],[40,1,"きよ"],[42,1,"ひと"],[44,2,"いちよう"],[50,1,"た"]],"text":"かもしかや、雄じかを食べるように、それを食べることができる。すなわち汚れた人も、清い人も一様にそれを食べることができる。"},{"ref":"Deut.12.23","start":5012023,"end":5012023,"break":"none","ruby":[[2,1,"かた"],[4,1,"つつし"],[10,1,"ち"],[12,1,"た"],[29,1,"ち"],[31,1,"いのち"],[41,1,"いのち"],[43,1,"にく"],[45,2,"いっしょ"],[48,1,"た"]],"text":"ただ堅く慎んで、その血を食べないようにしなければならない。血は命だからである。その命を肉と一緒に食べてはならない。"},{"ref":"Deut.12.24","start":5012024,"end":5012024,"break":"none","ruby":[[7,1,"た"],[16,1,"みず"],[24,1,"ち"],[26,1,"そそ"]],"text":"あなたはそれを食べてはならない。水のようにそれを地に注がなければならない。"},{"ref":"Deut.12.25","start":5012025,"end":5012025,"break":"none","ruby":[[7,1,"た"],[21,1,"しゅ"],[23,1,"ただ"],[27,1,"み"],[31,1,"こと"],[33,1,"おこな"],[44,1,"のち"],[46,2,"しそん"]],"text":"あなたはそれを食べてはならない。こうして、主が正しいと見られる事を行うならば、あなたにも後の子孫にも、さいわいがあるであろう。"},{"ref":"Deut.12.26","start":5012026,"end":5012026,"break":"none","ruby":[[10,1,"せい"],[13,1,"もの"],[16,2,"せいがん"],[19,1,"もの"],[23,1,"しゅ"],[25,1,"えら"],[29,2,"ばしょ"],[32,1,"たずさ"],[35,1,"い"]],"text":"ただあなたのささげる聖なる物と、誓願の物とは、主が選ばれる場所へ携えて行かなければならない。"},{"ref":"Deut.12.27","start":5012027,"end":5012027,"break":"none","ruby":[[3,2,"はんさい"],[10,1,"とき"],[13,1,"にく"],[15,1,"ち"],[22,1,"かみ"],[24,1,"しゅ"],[26,2,"さいだん"],[29,1,"うえ"],[43,2,"ぎせい"],[50,1,"とき"],[53,1,"ち"],[59,1,"かみ"],[61,1,"しゅ"],[63,2,"さいだん"],[72,1,"にく"],[78,1,"た"]],"text":"そして燔祭をささげる時は、肉と血とをあなたの神、主の祭壇の上にささげなければならない。犠牲をささげる時は、血をあなたの神、主の祭壇にそそぎかけ、肉はみずから食べることができる。"},{"ref":"Deut.12.28","start":5012028,"end":5012028,"break":"none","ruby":[[8,1,"めい"],[15,1,"こと"],[23,1,"き"],[26,1,"まも"],[45,1,"かみ"],[47,1,"しゅ"],[49,1,"み"],[51,1,"よ"],[56,1,"ただ"],[63,1,"こと"],[65,1,"おこな"],[76,1,"のち"],[78,2,"しそん"],[83,1,"なが"]],"text":"あなたはわたしが命じるこれらの事を、ことごとく聞いて守らなければならない。こうしてあなたの神、主が見て良いとし、正しいとされる事を行うならば、あなたにも後の子孫にも、長くさいわいがあるであろう。"},{"ref":"Deut.12.29","start":5012029,"end":5012029,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[13,1,"い"],[16,1,"お"],[18,1,"はら"],[24,2,"くにぐに"],[27,1,"たみ"],[34,1,"まえ"],[37,1,"た"],[39,1,"ほろ"],[53,2,"くにぐに"],[56,1,"え"],[61,1,"ち"],[63,1,"す"],[70,1,"とき"]],"text":"あなたの神、主が、あなたの行って追い払おうとする国々の民を、あなたの前から断ち滅ぼされ、あなたがついにその国々を獲て、その地に住むようになる時、"},{"ref":"Deut.12.30","start":5012030,"end":5012030,"break":"none","ruby":[[8,1,"つつし"],[11,1,"かれ"],[18,1,"まえ"],[21,1,"ほろ"],[26,1,"のち"],[28,1,"かれ"],[51,1,"かれ"],[54,2,"かみがみ"],[57,1,"たず"],[59,1,"もと"],[68,2,"くにぐに"],[71,1,"たみ"],[80,2,"かみがみ"],[83,1,"つか"],[103,1,"い"]],"text":"あなたはみずから慎み、彼らがあなたの前から滅ぼされた後、彼らにならって、わなにかかってはならない。また彼らの神々を尋ね求めて、『これらの国々の民はどのようにその神々に仕えたのか、わたしもそのようにしよう』と言ってはならない。"},{"ref":"Deut.12.31","start":5012031,"end":5012031,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"たい"],[26,1,"かれ"],[29,1,"しゅ"],[31,1,"にく"],[40,1,"い"],[44,1,"こと"],[49,2,"かみがみ"],[56,1,"おこな"],[63,1,"むすめ"],[67,1,"ひ"],[69,1,"や"],[73,2,"かみがみ"]],"text":"あなたの神、主に対しては、そのようにしてはならない。彼らは主の憎まれるもろもろの忌むべき事を、その神々にむかって行い、むすこ、娘をさえ火に焼いて、神々にささげたからである。"},{"ref":"Deut.12.32","start":5012032,"end":5012032,"break":"paragraph","ruby":[[10,1,"めい"],[19,1,"こと"],[21,1,"まも"],[24,1,"おこな"],[40,1,"くわ"],[51,1,"へ"]],"text":"あなたがたはわたしが命じるこのすべての事を守って行わなければならない。これにつけ加えてはならない。また減らしてはならない。"}]