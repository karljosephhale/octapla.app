[{"ref":"Isa.41.1","start":23041001,"end":23041001,"break":"paragraph","breaks":[[8,"line"],[21,"line"],[43,"line"]],"ruby":[[0,2,"うみぞ"],[4,2,"くにぐに"],[8,1,"しず"],[18,1,"き"],[26,1,"たみ"],[29,1,"ちから"],[31,1,"あら"],[36,1,"ちか"],[40,1,"かた"],[48,1,"とも"],[54,1,"ざ"],[56,1,"ちか"]],"text":"海沿いの国々よ、静かにして、わたしに聞け。もろもろの民よ、力を新たにし、近づいて語れ。われわれは共にさばきの座に近づこう。"},{"ref":"Isa.41.2","start":23041002,"end":23041002,"break":"line","breaks":[[13,"line"],[32,"line"],[43,"line"],[59,"line"],[79,"line"]],"ruby":[[3,1,"ひがし"],[6,1,"ひと"],[8,1,"おこ"],[13,1,"かれ"],[17,1,"ゆ"],[19,1,"ところ"],[21,2,"しょうり"],[27,1,"むか"],[37,1,"くに"],[39,2,"せいふく"],[48,1,"おう"],[50,1,"あし"],[52,1,"した"],[54,1,"ふ"],[68,1,"かれ"],[81,1,"ゆみ"],[86,1,"ふ"],[88,1,"さ"]],"text":"だれが東から人を起したか。彼はその行く所で勝利をもって迎えられ、もろもろの国を征服し、もろもろの王を足の下に踏みつけ、そのつるぎをもって彼らをちりのようにし、その弓をもって吹き去られる、わらのようにする。"},{"ref":"Isa.41.3","start":23041003,"end":23041003,"break":"line","breaks":[[11,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[6,1,"もの"],[8,1,"お"],[13,1,"あし"],[17,1,"ふ"],[25,1,"みち"],[28,1,"やす"],[32,1,"す"],[35,1,"い"]],"text":"彼はこれらの者を追ってその足のまだ踏んだことのない道を、安らかに過ぎて行く。"},{"ref":"Isa.41.4","start":23041004,"end":23041004,"break":"line","breaks":[[17,"line"],[37,"line"],[51,"line"]],"ruby":[[5,1,"こと"],[7,1,"おこな"],[20,1,"はじ"],[24,2,"よよ"],[27,2,"ひとびと"],[30,1,"よ"],[32,1,"だ"],[37,1,"しゅ"],[44,1,"はじ"],[53,1,"おわ"],[56,1,"とも"]],"text":"だれがこの事を行ったか、なしたか。だれが初めから世々の人々を呼び出したか。主なるわたしは初めであって、また終りと共にあり、わたしがそれだ。"},{"ref":"Isa.41.5","start":23041005,"end":23041005,"break":"paragraph","breaks":[[12,"line"]],"ruby":[[0,2,"うみぞ"],[4,2,"くにぐに"],[7,1,"み"],[9,1,"おそ"],[12,1,"ち"],[14,1,"はて"],[22,1,"ちか"],[26,1,"き"]],"text":"海沿いの国々は見て恐れ、地の果は、おののき、近づいて来た。"},{"ref":"Isa.41.6","start":23041006,"end":23041006,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[9,1,"となり"],[11,1,"たす"],[16,2,"きょうだい"],[21,1,"い"],[25,2,"ゆうき"],[28,1,"だ"]],"text":"彼らはおのおのその隣を助け、その兄弟たちに言う、「勇気を出せよ」と。"},{"ref":"Isa.41.7","start":23041007,"end":23041007,"break":"line","breaks":[[11,"line"],[33,"line"],[54,"line"],[70,"line"]],"ruby":[[0,3,"さいくにん"],[4,2,"かじ"],[7,1,"はげ"],[11,1,"つち"],[16,1,"たい"],[22,1,"もの"],[24,1,"かな"],[25,1,"し"],[28,1,"う"],[30,1,"もの"],[42,1,"い"],[49,1,"よ"],[66,1,"かた"],[70,1,"うご"]],"text":"細工人は鍛冶を励まし、鎚をもって平らかにする者は金敷きを打つ者に、はんだづけについて言う、「それは良い」と。また、くぎをもってそれを堅くし、動くことのないようにする。"},{"ref":"Isa.41.8","start":23041008,"end":23041008,"break":"paragraph","breaks":[[16,"line"],[27,"line"]],"ruby":[[20,1,"えら"],[29,1,"とも"],[36,2,"しそん"]],"text":"しかし、わがしもべイスラエルよ、わたしの選んだヤコブ、わが友アブラハムの子孫よ、"},{"ref":"Isa.41.9","start":23041009,"end":23041009,"break":"line","breaks":[[19,"line"],[36,"line"],[58,"line"]],"ruby":[[4,1,"ち"],[6,1,"はて"],[14,1,"つ"],[19,1,"ち"],[32,1,"め"],[40,1,"い"],[67,1,"えら"],[70,1,"す"]],"text":"わたしは地の果から、あなたを連れてき、地のすみずみから、あなたを召して、あなたに言った、「あなたは、わたしのしもべ、わたしは、あなたを選んで捨てなかった」と。"},{"ref":"Isa.41.10","start":23041010,"end":23041010,"break":"line","breaks":[[22,"line"],[44,"line"],[63,"line"]],"ruby":[[0,1,"おそ"],[17,1,"とも"],[22,1,"おどろ"],[39,1,"かみ"],[52,1,"つよ"],[60,1,"たす"],[65,2,"しょうり"],[68,1,"みぎ"],[70,1,"て"]],"text":"恐れてはならない、わたしはあなたと共にいる。驚いてはならない、わたしはあなたの神である。わたしはあなたを強くし、あなたを助け、わが勝利の右の手をもって、あなたをささえる。"},{"ref":"Isa.41.11","start":23041011,"end":23041011,"break":"line","breaks":[[18,"line"],[30,"line"]],"ruby":[[0,1,"み"],[11,1,"いか"],[13,1,"もの"],[34,1,"あらそ"],[36,1,"もの"],[38,1,"ほろ"],[41,1,"む"],[43,1,"き"]],"text":"見よ、あなたにむかって怒る者はみな、はじて、あわてふためき、あなたと争う者は滅びて無に帰する。"},{"ref":"Isa.41.12","start":23041012,"end":23041012,"break":"line","breaks":[[23,"line"]],"ruby":[[9,1,"あらそ"],[11,1,"もの"],[13,1,"たず"],[17,1,"み"],[27,1,"たたか"],[29,1,"もの"],[31,1,"まった"],[33,1,"き"]],"text":"あなたは、あなたと争う者を尋ねても見いださず、あなたと戦う者は全く消えうせる。"},{"ref":"Isa.41.13","start":23041013,"end":23041013,"break":"line","breaks":[[13,"line"],[31,"line"]],"ruby":[[4,1,"かみ"],[6,1,"しゅ"],[17,1,"みぎ"],[19,1,"て"],[28,1,"い"],[32,1,"おそ"],[49,1,"たす"]],"text":"あなたの神、主なるわたしはあなたの右の手をとってあなたに言う、「恐れてはならない、わたしはあなたを助ける」。"},{"ref":"Isa.41.14","start":23041014,"end":23041014,"break":"line","breaks":[[19,"line"],[38,"line"],[50,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"むし"],[25,2,"ひとびと"],[29,1,"おそ"],[46,1,"たす"],[58,1,"もの"],[66,2,"せいじゃ"]],"text":"主は言われる、「虫にひとしいヤコブよ、イスラエルの人々よ、恐れてはならない。わたしはあなたを助ける。あなたをあがなう者はイスラエルの聖者である。"},{"ref":"Isa.41.15","start":23041015,"end":23041015,"break":"line","breaks":[[17,"line"],[27,"line"],[45,"line"]],"ruby":[[0,1,"み"],[11,1,"するど"],[13,1,"は"],[17,1,"あたら"],[20,1,"だ"],[21,1,"こっ"],[22,1,"き"],[31,1,"やま"],[33,1,"う"],[40,2,"こなごな"],[45,1,"おか"]],"text":"見よ、わたしはあなたを鋭い歯のある新しい打穀機とする。あなたは山を打って、これを粉々にし、丘をもみがらのようにする。"},{"ref":"Isa.41.16","start":23041016,"end":23041016,"break":"line","breaks":[[18,"line"],[32,"line"],[43,"line"]],"ruby":[[8,1,"かぜ"],[13,1,"ま"],[15,1,"さ"],[21,1,"かぜ"],[26,1,"ふ"],[28,1,"ち"],[36,1,"しゅ"],[41,1,"よろこ"],[49,2,"せいじゃ"],[55,1,"ほこ"]],"text":"あなたがあおげば風はこれを巻き去り、つむじ風がこれを吹き散らす。あなたは主によって喜びイスラエルの聖者によって誇る。"},{"ref":"Isa.41.17","start":23041017,"end":23041017,"break":"paragraph","breaks":[[23,"line"],[39,"line"],[53,"line"],[66,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[5,1,"とぼ"],[8,1,"もの"],[11,1,"みず"],[13,1,"もと"],[18,1,"みず"],[25,1,"した"],[31,1,"や"],[39,1,"しゅ"],[46,1,"かれ"],[49,1,"こた"],[59,1,"かみ"],[66,1,"かれ"],[69,1,"す"]],"text":"貧しい者と乏しい者とは水を求めても、水がなく、その舌がかわいて焼けているとき、主なるわたしは彼らに答える、イスラエルの神なるわたしは彼らを捨てることがない。"},{"ref":"Isa.41.18","start":23041018,"end":23041018,"break":"line","breaks":[[13,"line"],[23,"line"]],"ruby":[[4,1,"はだか"],[6,1,"やま"],[8,1,"かわ"],[10,1,"ひら"],[13,1,"たに"],[15,1,"なか"],[17,1,"いずみ"],[23,2,"あらの"],[26,1,"いけ"],[35,1,"ち"],[37,1,"みず"],[39,1,"みなもと"]],"text":"わたしは裸の山に川を開き、谷の中に泉をいだし、荒野を池となし、かわいた地を水の源とする。"},{"ref":"Isa.41.19","start":23041019,"end":23041019,"break":"line","breaks":[[15,"line"],[31,"line"],[46,"line"]],"ruby":[[4,2,"あらの"],[7,2,"こうはく"],[26,1,"き"],[28,1,"う"],[54,1,"お"]],"text":"わたしは荒野に香柏、アカシヤ、ミルトスおよびオリブの木を植え、さばくに、いとすぎ、すずかけ、からまつをともに置く。"},{"ref":"Isa.41.20","start":23041020,"end":23041020,"break":"line","breaks":[[20,"line"],[43,"line"]],"ruby":[[0,2,"ひとびと"],[6,1,"み"],[9,1,"しゅ"],[12,1,"て"],[26,2,"せいじゃ"],[32,2,"そうぞう"],[40,1,"し"],[48,1,"かんが"],[51,1,"とも"],[53,1,"さと"]],"text":"人々はこれを見て、主のみ手がこれをなし、イスラエルの聖者がこれを創造されたことを知り、かつ、よく考えて共に悟る」。"},{"ref":"Isa.41.21","start":23041021,"end":23041021,"break":"paragraph","breaks":[[7,"line"],[22,"line"],[33,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[14,1,"うった"],[17,1,"だ"],[26,1,"おう"],[28,1,"い"],[40,2,"しょうこ"],[43,1,"も"]],"text":"主は言われる、「あなたがたの訴えを出せ」と。ヤコブの王は言われる、「あなたがたの証拠を持ってこい。"},{"ref":"Isa.41.22","start":23041022,"end":23041022,"break":"line","breaks":[[24,"line"],[41,"line"],[61,"line"]],"ruby":[[3,1,"も"],[9,1,"おこ"],[13,1,"こと"],[20,1,"つ"],[27,1,"こと"],[31,1,"なに"],[37,1,"つ"],[48,1,"かんが"],[54,2,"けつまつ"],[57,1,"し"],[70,1,"こと"],[77,1,"き"]],"text":"それを持ってきて、起るべき事をわれわれに告げよ。さきの事どもの何であるかを告げよ。われわれはよく考えて、その結末を知ろう。あるいはきたるべき事をわれわれに聞かせよ。"},{"ref":"Isa.41.23","start":23041023,"end":23041023,"break":"line","breaks":[[19,"line"],[37,"line"],[44,"line"],[60,"line"]],"ruby":[[2,1,"のち"],[8,1,"こと"],[15,1,"つ"],[30,1,"かみ"],[37,1,"し"],[44,1,"さいわい"],[54,1,"わざわい"],[65,1,"おどろ"],[68,1,"きも"]],"text":"この後きたるべき事をわれわれに告げよ。われわれはあなたがたが神であることを知るであろう。幸をくだし、あるいは災をくだせ。われわれは驚いて肝をつぶすであろう。"},{"ref":"Isa.41.24","start":23041024,"end":23041024,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[0,1,"み"],[9,1,"な"],[37,1,"えら"],[39,1,"もの"],[41,1,"にく"],[45,1,"もの"]],"text":"見よ、あなたがたは無きものである。あなたがたのわざはむなしい。あなたがたを選ぶ者は憎むべき者である」。"},{"ref":"Isa.41.25","start":23041025,"end":23041025,"break":"paragraph","breaks":[[18,"line"],[34,"line"],[50,"line"],[60,"line"]],"ruby":[[8,1,"おこ"],[11,1,"きた"],[20,1,"な"],[22,1,"よ"],[24,1,"もの"],[26,1,"ひがし"],[34,1,"かれ"],[45,1,"ふ"],[60,2,"とうき"],[62,1,"し"],[64,2,"ねんど"],[67,1,"ふ"]],"text":"わたしはひとりを起して北からこさせ、わが名を呼ぶ者を東からこさせる。彼はもろもろのつかさを踏みつけてしっくいのようにし、陶器師が粘土を踏むようにする。"},{"ref":"Isa.41.26","start":23041026,"end":23041026,"break":"line","breaks":[[12,"line"],[25,"line"],[43,"line"],[57,"line"],[73,"line"],[86,"line"]],"ruby":[[4,1,"はじ"],[10,1,"こと"],[17,1,"つ"],[19,1,"し"],[39,1,"つ"],[44,1,"かれ"],[46,1,"ただ"],[51,1,"い"],[63,1,"こと"],[65,1,"つ"],[68,1,"もの"],[77,1,"き"],[81,1,"もの"],[96,2,"ことば"],[99,1,"き"],[102,1,"もの"]],"text":"だれか、初めからこの事をわれわれに告げ知らせたか。だれか、あらかじめわれわれに告げて、「彼は正しい」と言わせたか。ひとりもこの事を告げた者はない。ひとりも聞かせた者はない。ひとりもあなたがたの言葉を聞いた者はない。"},{"ref":"Isa.41.27","start":23041027,"end":23041027,"break":"line","breaks":[[19,"line"],[36,"line"]],"ruby":[[15,1,"つ"],[31,1,"つた"],[34,1,"もの"],[42,1,"あた"]],"text":"わたしははじめてこれをシオンに告げた。わたしは、よきおとずれを伝える者をエルサレムに与える。"},{"ref":"Isa.41.28","start":23041028,"end":23041028,"break":"line","breaks":[[19,"line"],[35,"line"]],"ruby":[[8,1,"み"],[19,1,"かれ"],[31,1,"たず"],[35,1,"こた"],[39,3,"じょげんしゃ"]],"text":"しかし、わたしが見ると、ひとりもない。彼らのなかには、わたしが尋ねても答えうる助言者はひとりもない。"},{"ref":"Isa.41.29","start":23041029,"end":23041029,"break":"line","breaks":[[19,"line"],[29,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[8,1,"ひと"],[10,1,"まど"],[13,1,"もの"],[24,1,"な"],[31,1,"い"],[33,1,"ぞう"],[39,1,"かぜ"]],"text":"見よ、彼らはみな人を惑わす者であって、そのわざは無きもの、その鋳た像はむなしき風である。"}]