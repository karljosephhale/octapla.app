[{"ref":"2Sam.21.1","start":10021001,"end":10021001,"break":"paragraph","ruby":[[4,1,"よ"],[7,1,"とし"],[10,1,"とし"],[13,1,"ねん"],[29,1,"しゅ"],[31,1,"たず"],[38,1,"しゅ"],[40,1,"い"],[52,1,"いえ"],[56,1,"ち"],[58,1,"なが"],[61,1,"つみ"],[72,1,"かれ"],[81,1,"ころ"]],"text":"ダビデの世に、年また年と三年、ききんがあったので、ダビデが主に尋ねたところ、主は言われた、「サウルとその家とに、血を流した罪がある。それはかつて彼がギベオンびとを殺したためである」。"},{"ref":"2Sam.21.2","start":10021002,"end":10021002,"break":"none","ruby":[[3,1,"おう"],[12,1,"め"],[31,2,"しそん"],[44,1,"のこ"],[57,2,"ひとびと"],[60,1,"かれ"],[63,1,"ちか"],[66,1,"た"],[72,1,"いのち"],[74,1,"たす"],[95,2,"ひとびと"],[101,2,"ねっしん"],[110,1,"かれ"],[113,1,"ころ"]],"text":"そこで王はギベオンびとを召しよせた。ギベオンびとはイスラエルの子孫ではなく、アモリびとの残りであって、イスラエルの人々は彼らと誓いを立てて、その命を助けた。ところがサウルはイスラエルとユダの人々のために熱心であったので、彼らを殺そうとしたのである。"},{"ref":"2Sam.21.3","start":10021003,"end":10021003,"break":"none","ruby":[[14,1,"い"],[33,1,"なに"],[48,1,"つぐな"],[61,1,"しゅ"],[63,1,"し"],[64,1,"ぎょう"],[66,2,"しゅくふく"]],"text":"それでダビデはギベオンびとに言った、「わたしはあなたがたのために、何をすればよいのですか。どんな償いをすれば、あなたがたは主の嗣業を祝福するのですか」。"},{"ref":"2Sam.21.4","start":10021004,"end":10021004,"break":"none","ruby":[[7,1,"かれ"],[9,1,"い"],[31,1,"いえ"],[34,1,"あいだ"],[36,2,"きんぎん"],[39,2,"もんだい"],[71,1,"ころ"],[91,1,"い"],[109,1,"なに"],[117,1,"い"]],"text":"ギベオンびとは彼に言った、「これはわれわれと、サウルまたはその家との間の金銀の問題ではありません。またイスラエルのうちのひとりでも、われわれが殺そうというのでもありません」。ダビデは言った、「わたしがあなたがたのために何をすればよいと言うのですか」。"},{"ref":"2Sam.21.5","start":10021005,"end":10021005,"break":"none","ruby":[[4,1,"おう"],[6,1,"い"],[16,1,"ほろ"],[20,1,"ひと"],[27,1,"ほろ"],[37,2,"りょういき"],[59,1,"ひと"]],"text":"かれらは王に言った、「われわれを滅ぼした人、われわれを滅ぼしてイスラエルの領域のどこにもおらせないようにと、たくらんだ人、"},{"ref":"2Sam.21.6","start":10021006,"end":10021006,"break":"none","ruby":[[2,1,"ひと"],[4,2,"しそん"],[7,1,"にん"],[9,1,"ひ"],[11,1,"わた"],[24,1,"しゅ"],[26,1,"やま"],[36,1,"かれ"],[39,1,"しゅ"],[41,1,"まえ"],[43,1,"き"],[53,1,"おう"],[55,1,"い"],[60,1,"ひ"],[62,1,"わた"]],"text":"その人の子孫七人を引き渡してください。われわれは主の山にあるギベオンで、彼らを主の前に木にかけましょう」。王は言った、「引き渡しましょう」。"},{"ref":"2Sam.21.7","start":10021007,"end":10021007,"break":"paragraph","ruby":[[3,1,"おう"],[9,1,"こ"],[15,1,"こ"],[25,1,"お"],[30,1,"かれ"],[33,1,"あいだ"],[47,1,"こ"],[54,1,"あいだ"],[57,1,"しゅ"],[62,1,"た"],[65,1,"ちか"]],"text":"しかし王はサウルの子ヨナタンの子であるメピボセテを惜しんだ。彼らの間、すなわちダビデとサウルの子ヨナタンとの間に、主をさして立てた誓いがあったからである。"},{"ref":"2Sam.21.8","start":10021008,"end":10021008,"break":"none","ruby":[[0,1,"おう"],[5,1,"むすめ"],[14,1,"う"],[21,1,"こ"],[40,1,"むすめ"],[56,1,"こ"],[63,1,"う"],[67,1,"にん"],[69,1,"こ"],[71,1,"と"]],"text":"王はアヤの娘リヅパがサウルに産んだふたりの子アルモニとメピボセテ、およびサウルの娘メラブがメホラびとバルジライの子アデリエルに産んだ五人の子を取って、"},{"ref":"2Sam.21.9","start":10021009,"end":10021009,"break":"none","ruby":[[0,1,"かれ"],[10,1,"て"],[12,1,"ひ"],[14,1,"わた"],[27,1,"かれ"],[30,1,"やま"],[32,1,"しゅ"],[34,1,"まえ"],[36,1,"き"],[42,1,"かれ"],[45,1,"にん"],[47,1,"とも"],[49,1,"たお"],[53,1,"かれ"],[56,2,"かりい"],[60,1,"はじ"],[63,1,"ひ"],[69,2,"おおむぎ"],[71,1,"か"],[74,1,"はじ"],[77,1,"ころ"]],"text":"彼らをギベオンびとの手に引き渡したので、ギベオンびとは彼らを山で主の前に木にかけた。彼ら七人は共に倒れた。彼らは刈入れの初めの日、すなわち大麦刈りの初めに殺された。"},{"ref":"2Sam.21.10","start":10021010,"end":10021010,"break":"paragraph","ruby":[[3,1,"むすめ"],[8,2,"あらぬの"],[18,2,"じぶん"],[24,1,"いわ"],[26,1,"うえ"],[28,1,"し"],[31,2,"かりい"],[35,1,"はじ"],[42,2,"ひとびと"],[45,2,"したい"],[48,1,"うえ"],[50,1,"てん"],[53,1,"あめ"],[55,1,"ふ"],[60,1,"ひる"],[62,1,"そら"],[64,1,"とり"],[66,2,"したい"],[69,1,"うえ"],[79,1,"よる"],[81,1,"の"],[83,1,"けもの"],[85,2,"ちかよ"]],"text":"アヤの娘リヅパは荒布をとって、それを自分のために岩の上に敷き、刈入れの初めから、その人々の死体の上に天から雨が降るまで、昼は空の鳥が死体の上にこないようにし、夜は野の獣を近寄らせなかった。"},{"ref":"2Sam.21.11","start":10021011,"end":10021011,"break":"none","ruby":[[3,1,"むすめ"],[29,1,"きこ"]],"text":"アヤの娘でサウルのめかけであったリヅパのしたことがダビデに聞えたので、"},{"ref":"2Sam.21.12","start":10021012,"end":10021012,"break":"none","ruby":[[4,1,"い"],[11,1,"ほね"],[15,1,"こ"],[21,1,"ほね"],[32,2,"ひとびと"],[35,1,"ところ"],[38,1,"と"],[63,1,"ころ"],[66,1,"ひ"],[69,1,"き"],[80,2,"ひろば"],[85,1,"かれ"],[88,1,"ぬす"]],"text":"ダビデは行ってサウルの骨とその子ヨナタンの骨を、ヤベシギレアデの人々の所から取ってきた。これはペリシテびとがサウルをギルボアで殺した日に、木にかけたベテシャンの広場から、彼らが盗んでいたものである。"},{"ref":"2Sam.21.13","start":10021013,"end":10021013,"break":"none","ruby":[[12,1,"ほね"],[17,1,"こ"],[23,1,"ほね"],[25,1,"たずさ"],[28,1,"のぼ"],[34,2,"ひとびと"],[44,1,"もの"],[48,1,"ほね"],[50,1,"あつ"]],"text":"ダビデはそこからサウルの骨と、その子ヨナタンの骨を携えて上った。また人々はそのかけられた者どもの骨を集めた。"},{"ref":"2Sam.21.14","start":10021014,"end":10021014,"break":"none","ruby":[[4,1,"かれ"],[13,1,"こ"],[19,1,"ほね"],[28,1,"ち"],[37,1,"ちち"],[41,1,"はか"],[43,1,"ほうむ"],[49,1,"おう"],[51,1,"めい"],[62,1,"のち"],[64,1,"かみ"],[68,1,"ち"],[74,1,"いのり"],[76,1,"き"]],"text":"こうして彼らはサウルとその子ヨナタンの骨を、ベニヤミンの地のゼラにあるその父キシの墓に葬り、すべて王の命じたようにした。この後、神はその地のために、祈を聞かれた。"},{"ref":"2Sam.21.15","start":10021015,"end":10021015,"break":"paragraph","ruby":[[15,2,"せんそう"],[27,2,"けらい"],[32,1,"とも"],[34,1,"くだ"],[44,1,"たたか"],[53,1,"つか"]],"text":"ペリシテびとはまたイスラエルと戦争をした。ダビデはその家来たちと共に下ってペリシテびとと戦ったが、ダビデは疲れていた。"},{"ref":"2Sam.21.16","start":10021016,"end":10021016,"break":"none","ruby":[[0,1,"とき"],[13,1,"ころ"],[17,1,"おも"],[28,2,"きょじん"],[31,2,"しそん"],[40,2,"せいどう"],[43,1,"おも"],[53,1,"かれ"],[55,1,"あたら"],[62,1,"お"]],"text":"時にイシビベノブはダビデを殺そうと思った。イシビベノブは巨人の子孫で、そのやりは青銅で重さ三百シケルあり、彼は新しいつるぎを帯びていた。"},{"ref":"2Sam.21.17","start":10021017,"end":10021017,"break":"none","ruby":[[7,1,"こ"],[18,1,"たす"],[31,1,"う"],[33,1,"ころ"],[44,2,"じゅうしゃ"],[49,1,"かれ"],[51,1,"ちか"],[54,1,"い"],[68,1,"とも"],[71,1,"かさ"],[74,2,"せんそう"],[77,1,"で"],[105,1,"ひ"],[107,1,"け"]],"text":"しかしゼルヤの子アビシャイはダビデを助けて、そのペリシテびとを撃ち殺した。そこでダビデの従者たちは彼に誓って言った、「あなたはわれわれと共に、重ねて戦争に出てはなりません。さもないと、あなたはイスラエルのともし火を消すでしょう」。"},{"ref":"2Sam.21.18","start":10021018,"end":10021018,"break":"paragraph","ruby":[[2,1,"のち"],[4,1,"ふたた"],[17,1,"たたか"],[24,1,"とき"],[36,2,"きょじん"],[39,2,"しそん"],[48,1,"ころ"]],"text":"この後、再びゴブでペリシテびととの戦いがあった。時にホシャびとシベカイは巨人の子孫のひとりサフを殺した。"},{"ref":"2Sam.21.19","start":10021019,"end":10021019,"break":"none","ruby":[[17,1,"たたか"],[43,1,"こ"],[60,1,"ころ"],[69,1,"え"],[71,1,"はた"],[73,2,"まきぼう"]],"text":"ここにまたゴブで、ペリシテびととの戦いがあったが、そこではベツレヘムびとヤレオレギムの子エルハナンは、ガテびとゴリアテを殺した。そのやりの柄は機の巻棒のようであった。"},{"ref":"2Sam.21.20","start":10021020,"end":10021020,"break":"none","ruby":[[5,1,"ふたた"],[7,1,"たたか"],[22,1,"せ"],[24,1,"たか"],[26,1,"ひと"],[33,1,"て"],[35,1,"ゆび"],[37,1,"あし"],[39,1,"ゆび"],[42,1,"ぽん"],[49,1,"かず"],[51,1,"あ"],[58,1,"ほん"],[64,1,"かれ"],[68,2,"きょじん"],[72,1,"うま"],[75,1,"もの"]],"text":"またガテで再び戦いがあったが、そこにひとりの背の高い人があり、その手の指と足の指は六本ずつで、その数は合わせて二十四本であった。彼もまた巨人から生れた者であった。"},{"ref":"2Sam.21.21","start":10021021,"end":10021021,"break":"none","ruby":[[0,1,"かれ"],[20,2,"きょうだい"],[26,1,"こ"],[32,1,"かれ"],[34,1,"ころ"]],"text":"彼はイスラエルをののしったので、ダビデの兄弟シメアの子ヨナタンが彼を殺した。"},{"ref":"2Sam.21.22","start":10021022,"end":10021022,"break":"none","ruby":[[5,1,"にん"],[10,2,"きょじん"],[14,1,"うま"],[17,1,"もの"],[28,1,"て"],[32,2,"けらい"],[37,1,"て"],[39,1,"たお"]],"text":"これらの四人はガテで巨人から生れた者であったが、ダビデの手とその家来たちの手に倒れた。"}]