[{"ref":"Ps.123.1","start":19123001,"end":19123001,"break":"paragraph","title":"都もうでの歌","breaks":[[12,"line"]],"ruby":[[0,1,"てん"],[2,1,"ざ"],[9,1,"もの"],[24,1,"め"]],"titleRuby":[[0,1,"みやこ"],[5,1,"うた"]],"text":"天に座しておられる者よ、わたしはあなたにむかって目をあげます。"},{"ref":"Ps.123.2","start":19123002,"end":19123002,"break":"line","breaks":[[20,"line"],[41,"line"],[60,"line"]],"ruby":[[0,1,"み"],[9,2,"しゅじん"],[12,1,"て"],[14,1,"め"],[27,2,"しゅふ"],[30,1,"て"],[32,1,"め"],[49,1,"かみ"],[51,1,"しゅ"],[53,1,"め"],[72,1,"ま"]],"text":"見よ、しもべがその主人の手に目をそそぎ、はしためがその主婦の手に目をそそぐように、われらはわれらの神、主に目をそそいで、われらをあわれまれるのを待ちます。"},{"ref":"Ps.123.3","start":19123003,"end":19123003,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[35,1,"あなど"],[38,1,"み"]],"text":"主よ、われらをあわれんでください。われらをあわれんでください。われらに侮りが満ちあふれています。"},{"ref":"Ps.123.4","start":19123004,"end":19123004,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"おも"],[2,1,"わずら"],[7,1,"もの"],[15,1,"たか"],[18,1,"もの"],[20,1,"あなど"],[29,1,"たましい"],[31,1,"み"]],"text":"思い煩いのない者のあざけりと、高ぶる者の侮りとは、われらの魂に満ちあふれています。"}]