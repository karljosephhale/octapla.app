[{"ref":"Acts.25.1","start":44025001,"end":44025001,"break":"paragraph","ruby":[[9,2,"にんち"],[12,1,"つ"],[18,1,"か"],[20,1,"のち"],[35,1,"のぼ"]],"text":"さて、フェストは、任地に着いてから三日の後、カイザリヤからエルサレムに上ったところ、"},{"ref":"Acts.25.2","start":44025002,"end":44025002,"break":"none","ruby":[[0,3,"さいしちょう"],[9,1,"じん"],[11,2,"おもだ"],[15,1,"もの"],[24,1,"うった"],[26,1,"で"]],"text":"祭司長たちやユダヤ人の重立った者たちが、パウロを訴え出て、"},{"ref":"Acts.25.3","start":44025003,"end":44025003,"break":"none","ruby":[[0,1,"かれ"],[8,1,"よ"],[10,1,"だ"],[14,1,"と"],[16,1,"はか"],[32,1,"ねが"],[36,1,"かれ"],[39,2,"とちゅう"],[42,1,"ま"],[44,1,"ぶ"],[49,1,"かれ"],[51,1,"ころ"],[53,1,"かんが"]],"text":"彼をエルサレムに呼び出すよう取り計らっていただきたいと、しきりに願った。彼らは途中で待ち伏せして、彼を殺す考えであった。"},{"ref":"Acts.25.4","start":44025004,"end":44025004,"break":"none","ruby":[[20,2,"かんきん"],[27,2,"じぶん"],[35,1,"かえ"],[46,1,"こた"]],"text":"ところがフェストは、パウロがカイザリヤに監禁してあり、自分もすぐそこへ帰ることになっていると答え、"},{"ref":"Acts.25.5","start":44025005,"end":44025005,"break":"none","ruby":[[3,1,"い"],[15,1,"おとこ"],[17,1,"なに"],[19,3,"ふつごう"],[40,2,"ゆうりょく"],[42,1,"しゃ"],[50,2,"いっしょ"],[53,1,"くだ"],[56,1,"い"],[60,1,"うった"]],"text":"そして言った、「では、もしあの男に何か不都合なことがあるなら、おまえたちのうちの有力者らが、わたしと一緒に下って行って、訴えるがよかろう」。"},{"ref":"Acts.25.6","start":44025006,"end":44025006,"break":"paragraph","ruby":[[6,1,"かれ"],[14,1,"か"],[17,1,"か"],[20,2,"たいざい"],[24,1,"のち"],[32,1,"くだ"],[35,1,"い"],[40,2,"よくじつ"],[43,2,"さいばん"],[46,1,"せき"],[56,1,"ひ"],[58,1,"だ"],[63,1,"めい"]],"text":"フェストは、彼らのあいだに八日か十日ほど滞在した後、カイザリヤに下って行き、その翌日、裁判の席について、パウロを引き出すように命じた。"},{"ref":"Acts.25.7","start":44025007,"end":44025007,"break":"none","ruby":[[4,1,"すがた"],[19,1,"くだ"],[27,1,"じん"],[32,1,"かれ"],[34,1,"と"],[40,1,"かれ"],[42,1,"たい"],[50,1,"おも"],[52,2,"ざいじょう"],[55,1,"もう"],[57,1,"た"],[68,2,"しょうこ"]],"text":"パウロが姿をあらわすと、エルサレムから下ってきたユダヤ人たちが、彼を取りかこみ、彼に対してさまざまの重い罪状を申し立てたが、いずれもその証拠をあげることはできなかった。"},{"ref":"Acts.25.8","start":44025008,"end":44025008,"break":"none","ruby":[[13,1,"じん"],[15,2,"りっぽう"],[18,1,"たい"],[23,1,"みや"],[25,1,"たい"],[37,1,"たい"],[45,1,"つみ"],[47,1,"おか"],[57,2,"べんめい"]],"text":"パウロは「わたしは、ユダヤ人の律法に対しても、宮に対しても、またカイザルに対しても、なんら罪を犯したことはない」と弁明した。"},{"ref":"Acts.25.9","start":44025009,"end":44025009,"break":"none","ruby":[[13,1,"じん"],[15,2,"かんしん"],[18,1,"か"],[22,1,"おも"],[34,1,"い"],[49,1,"のぼ"],[54,2,"じけん"],[57,1,"かん"],[68,2,"さいばん"],[71,1,"う"],[77,2,"しょうち"]],"text":"ところが、フェストはユダヤ人の歓心を買おうと思って、パウロにむかって言った、「おまえはエルサレムに上り、この事件に関し、わたしからそこで裁判を受けることを承知するか」。"},{"ref":"Acts.25.10","start":44025010,"end":44025010,"break":"none","ruby":[[4,1,"い"],[13,1,"いま"],[20,2,"ほうてい"],[23,1,"た"],[36,2,"ほうてい"],[39,2,"さいばん"],[52,2,"しょうち"],[66,1,"じん"],[71,1,"なに"],[73,1,"わる"]],"text":"パウロは言った、「わたしは今、カイザルの法廷に立っています。わたしはこの法廷で裁判されるべきです。よくご承知のとおり、わたしはユダヤ人たちに、何も悪いことをしてはいません。"},{"ref":"Acts.25.11","start":44025011,"end":44025011,"break":"none","ruby":[[6,1,"わる"],[13,1,"し"],[15,1,"あた"],[31,1,"し"],[33,1,"まぬか"],[50,1,"かれ"],[53,1,"うった"],[63,2,"こんきょ"],[80,1,"かれ"],[83,1,"ひ"],[85,1,"わた"],[87,2,"けんり"],[105,2,"じょうそ"]],"text":"もしわたしが悪いことをし、死に当るようなことをしているのなら、死を免れようとはしません。しかし、もし彼らの訴えることに、なんの根拠もないとすれば、だれもわたしを彼らに引き渡す権利はありません。わたしはカイザルに上訴します」。"},{"ref":"Acts.25.12","start":44025012,"end":44025012,"break":"none","ruby":[[9,2,"ばいせき"],[12,1,"もの"],[16,2,"きょうぎ"],[22,1,"こた"],[36,2,"じょうそ"],[39,1,"もう"],[41,1,"で"],[53,1,"い"]],"text":"そこでフェストは、陪席の者たちと協議したうえ答えた、「おまえはカイザルに上訴を申し出た。カイザルのところに行くがよい」。"},{"ref":"Acts.25.13","start":44025013,"end":44025013,"break":"paragraph","ruby":[[0,2,"すうじつ"],[5,1,"のち"],[12,1,"おう"],[26,2,"けいい"],[29,1,"ひょう"]],"text":"数日たった後、アグリッパ王とベルニケとが、フェストに敬意を表するため、カイザリヤにきた。"},{"ref":"Acts.25.14","start":44025014,"end":44025014,"break":"none","ruby":[[8,1,"なに"],[9,2,"にちかん"],[12,2,"たいざい"],[34,1,"おう"],[36,1,"はな"],[39,1,"い"],[53,2,"しゅうじん"],[58,1,"のこ"],[61,1,"い"],[68,1,"おとこ"]],"text":"ふたりは、そこに何日間も滞在していたので、フェストは、パウロのことを王に話して言った、「ここに、ペリクスが囚人として残して行ったひとりの男がいる。"},{"ref":"Acts.25.15","start":44025015,"end":44025015,"break":"none","ruby":[[10,1,"い"],[13,1,"とき"],[17,1,"おとこ"],[23,3,"さいしちょう"],[32,1,"じん"],[34,2,"ちょうろう"],[44,2,"ほうこく"],[48,1,"かれ"],[50,1,"つみ"],[52,1,"さだ"],[59,2,"ようきゅう"]],"text":"わたしがエルサレムに行った時、この男のことを、祭司長たちやユダヤ人の長老たちが、わたしに報告し、彼を罪に定めるようにと要求した。"},{"ref":"Acts.25.16","start":44025016,"end":44025016,"break":"none","ruby":[[8,1,"かれ"],[11,1,"こた"],[16,1,"うった"],[21,1,"もの"],[24,1,"うった"],[27,1,"もの"],[29,1,"まえ"],[31,1,"た"],[35,2,"こくそ"],[38,1,"たい"],[40,2,"べんめい"],[44,2,"きかい"],[47,1,"あた"],[53,1,"まえ"],[58,1,"ひと"],[60,2,"みはな"],[73,1,"じん"],[75,2,"かんれい"]],"text":"そこでわたしは、彼らに答えた、『訴えられた者が、訴えた者の前に立って、告訴に対し弁明する機会を与えられない前に、その人を見放してしまうのは、ローマ人の慣例にはないことである』。"},{"ref":"Acts.25.17","start":44025017,"end":44025017,"break":"none","ruby":[[4,1,"かれ"],[10,1,"あつ"],[16,1,"とき"],[22,1,"とき"],[29,1,"つぎ"],[31,1,"ひ"],[33,2,"さいばん"],[36,1,"せき"],[44,1,"おとこ"],[46,1,"ひ"],[48,1,"だ"]],"text":"それで、彼らがここに集まってきた時、わたしは時をうつさず、次の日に裁判の席について、その男を引き出させた。"},{"ref":"Acts.25.18","start":44025018,"end":44025018,"break":"none","ruby":[[0,1,"うった"],[3,1,"もの"],[7,1,"た"],[9,1,"あ"],[19,2,"すいそく"],[28,2,"あくじ"],[32,1,"かれ"],[37,2,"なにひと"],[40,1,"もう"],[42,1,"た"]],"text":"訴えた者たちは立ち上がったが、わたしが推測していたような悪事は、彼について何一つ申し立てはしなかった。"},{"ref":"Acts.25.19","start":44025019,"end":44025019,"break":"none","ruby":[[3,1,"かれ"],[5,1,"あらそ"],[7,1,"あ"],[15,1,"かれ"],[17,2,"じしん"],[20,2,"しゅうきょう"],[23,1,"かん"],[29,1,"し"],[38,1,"い"],[48,2,"しゅちょう"],[59,1,"もの"],[61,1,"かん"],[64,2,"もんだい"],[67,1,"す"]],"text":"ただ、彼と争い合っているのは、彼ら自身の宗教に関し、また、死んでしまったのに生きているとパウロが主張しているイエスなる者に関する問題に過ぎない。"},{"ref":"Acts.25.20","start":44025020,"end":44025020,"break":"none","ruby":[[4,2,"もんだい"],[10,1,"と"],[12,1,"あつか"],[32,1,"かれ"],[42,1,"い"],[50,2,"もんだい"],[75,1,"たず"]],"text":"これらの問題を、どう取り扱ってよいかわからなかったので、わたしは彼に、『エルサレムに行って、これらの問題について、そこでさばいてもらいたくはないか』と尋ねてみた。"},{"ref":"Acts.25.21","start":44025021,"end":44025021,"break":"none","ruby":[[9,2,"こうてい"],[12,2,"はんけつ"],[15,1,"う"],[18,1,"とき"],[26,2,"じぶん"],[40,1,"い"],[50,1,"かれ"],[52,1,"おく"],[58,1,"とき"],[72,1,"めい"]],"text":"ところがパウロは、皇帝の判決を受ける時まで、このまま自分をとどめておいてほしいと言うので、カイザルに彼を送りとどける時までとどめておくようにと、命じておいた」。"},{"ref":"Acts.25.22","start":44025022,"end":44025022,"break":"none","ruby":[[23,1,"ひと"],[25,1,"い"],[27,1,"ぶん"],[29,1,"き"],[32,1,"み"],[37,1,"い"],[55,1,"かれ"],[58,1,"き"],[73,1,"こた"]],"text":"そこで、アグリッパがフェストに「わたしも、その人の言い分を聞いて見たい」と言ったので、フェストは、「では、あす彼から聞きとるようにしてあげよう」と答えた。"},{"ref":"Acts.25.23","start":44025023,"end":44025023,"break":"paragraph","ruby":[[0,2,"よくじつ"],[16,1,"おお"],[19,2,"いぎ"],[28,3,"せんそつちょう"],[34,1,"し"],[36,2,"おもだ"],[40,1,"ひと"],[44,1,"とも"],[47,3,"いんけんじょ"],[67,1,"めい"],[80,1,"ひ"],[82,1,"だ"]],"text":"翌日、アグリッパとベルニケとは、大いに威儀をととのえて、千卒長たちや市の重立った人たちと共に、引見所にはいってきた。すると、フェストの命によって、パウロがそこに引き出された。"},{"ref":"Acts.25.24","start":44025024,"end":44025024,"break":"none","ruby":[[9,1,"い"],[19,1,"おう"],[26,2,"りんせき"],[29,2,"しょくん"],[43,2,"じんぶつ"],[50,1,"じん"],[75,1,"ち"],[84,2,"いじょう"],[87,1,"い"],[99,1,"さけ"],[107,1,"うった"],[109,1,"で"],[113,1,"もの"]],"text":"そこで、フェストが言った、「アグリッパ王、ならびにご臨席の諸君。ごらんになっているこの人物は、ユダヤ人たちがこぞって、エルサレムにおいても、また、この地においても、これ以上、生かしておくべきでないと叫んで、わたしに訴え出ている者である。"},{"ref":"Acts.25.25","start":44025025,"end":44025025,"break":"none","ruby":[[4,1,"かれ"],[6,1,"し"],[8,1,"あた"],[13,1,"なに"],[26,1,"み"],[34,1,"かれ"],[35,2,"じしん"],[38,2,"こうてい"],[41,2,"じょうそ"],[46,1,"い"],[48,1,"だ"],[54,1,"かれ"],[60,1,"おく"],[65,1,"き"]],"text":"しかし、彼は死に当ることは何もしていないと、わたしは見ているのだが、彼自身が皇帝に上訴すると言い出したので、彼をそちらへ送ることに決めた。"},{"ref":"Acts.25.26","start":44025026,"end":44025026,"break":"none","ruby":[[5,1,"かれ"],[11,2,"しゅくん"],[14,1,"か"],[19,1,"たし"],[25,1,"なに"],[37,1,"かれ"],[39,2,"しょくん"],[42,1,"まえ"],[45,1,"とく"],[53,1,"おう"],[60,1,"まえ"],[62,1,"ひ"],[64,1,"だ"],[68,2,"とりしら"],[77,2,"じょうしょ"],[82,2,"ざいりょう"],[85,1,"え"],[89,1,"おも"]],"text":"ところが、彼について、主君に書きおくる確かなものが何もないので、わたしは、彼を諸君の前に、特に、アグリッパ王よ、あなたの前に引き出して、取調べをしたのち、上書すべき材料を得ようと思う。"},{"ref":"Acts.25.27","start":44025027,"end":44025027,"break":"none","ruby":[[0,2,"しゅうじん"],[3,1,"おく"],[10,2,"こくそ"],[13,2,"りゆう"],[16,1,"しめ"],[27,3,"ふごうり"],[32,1,"おも"]],"text":"囚人を送るのに、その告訴の理由を示さないということは、不合理だと思えるからである」。"}]