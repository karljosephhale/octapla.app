[{"ref":"1Cor.2.1","start":46002001,"end":46002001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[19,1,"ところ"],[21,1,"い"],[27,1,"かみ"],[33,1,"の"],[35,1,"つた"],[45,2,"ことば"],[48,2,"ちえ"],[51,1,"もち"]],"text":"兄弟たちよ。わたしもまた、あなたがたの所に行ったとき、神のあかしを宣べ伝えるのに、すぐれた言葉や知恵を用いなかった。"},{"ref":"1Cor.2.2","start":46002002,"end":46002002,"break":"none","ruby":[[21,3,"じゅうじか"],[34,2,"いがい"],[47,1,"あいだ"],[50,1,"なに"],[52,1,"し"],[58,2,"けっしん"]],"text":"なぜなら、わたしはイエス・キリスト、しかも十字架につけられたキリスト以外のことは、あなたがたの間では何も知るまいと、決心したからである。"},{"ref":"1Cor.2.3","start":46002003,"end":46002003,"break":"none","ruby":[[10,1,"ところ"],[12,1,"い"],[15,1,"とき"],[19,1,"よわ"],[23,1,"おそ"],[29,2,"ふあん"]],"text":"わたしがあなたがたの所に行った時には、弱くかつ恐れ、ひどく不安であった。"},{"ref":"1Cor.2.4","start":46002004,"end":46002004,"break":"none","ruby":[[8,2,"ことば"],[15,2,"せんきょう"],[19,1,"たく"],[22,2,"ちえ"],[25,2,"ことば"],[34,1,"れい"],[36,1,"ちから"],[39,2,"しょうめい"]],"text":"そして、わたしの言葉もわたしの宣教も、巧みな知恵の言葉によらないで、霊と力との証明によったのである。"},{"ref":"1Cor.2.5","start":46002005,"end":46002005,"break":"none","ruby":[[10,2,"しんこう"],[13,1,"ひと"],[15,2,"ちえ"],[24,1,"かみ"],[26,1,"ちから"]],"text":"それは、あなたがたの信仰が人の知恵によらないで、神の力によるものとなるためであった。"},{"ref":"1Cor.2.6","start":46002006,"end":46002006,"break":"paragraph","ruby":[[10,2,"えんじゅく"],[16,1,"もの"],[18,1,"あいだ"],[22,2,"ちえ"],[25,1,"かた"],[30,2,"ちえ"],[36,1,"よ"],[38,1,"もの"],[40,2,"ちえ"],[49,1,"よ"],[51,1,"ほろ"],[53,1,"い"],[55,3,"しはいしゃ"],[61,2,"ちえ"]],"text":"しかしわたしたちは、円熟している者の間では、知恵を語る。この知恵は、この世の者の知恵ではなく、この世の滅び行く支配者たちの知恵でもない。"},{"ref":"1Cor.2.7","start":46002007,"end":46002007,"break":"none","ruby":[[10,1,"かた"],[15,1,"かく"],[19,2,"おくぎ"],[25,1,"かみ"],[27,2,"ちえ"],[36,1,"かみ"],[45,1,"う"],[48,2,"えいこう"],[55,1,"よ"],[57,1,"はじ"],[61,1,"さき"],[70,1,"さだ"]],"text":"むしろ、わたしたちが語るのは、隠された奥義としての神の知恵である。それは神が、わたしたちの受ける栄光のために、世の始まらぬ先から、あらかじめ定めておかれたものである。"},{"ref":"1Cor.2.8","start":46002008,"end":46002008,"break":"none","ruby":[[2,1,"よ"],[4,3,"しはいしゃ"],[16,2,"ちえ"],[19,1,"し"],[24,1,"もの"],[39,1,"し"],[47,2,"えいこう"],[50,1,"しゅ"],[52,3,"じゅうじか"]],"text":"この世の支配者たちのうちで、この知恵を知っていた者は、ひとりもいなかった。もし知っていたなら、栄光の主を十字架につけはしなかったであろう。"},{"ref":"1Cor.2.9","start":46002009,"end":46002009,"break":"none","breaks":[[16,"stanza"],[32,"line"],[50,"line"]],"ruby":[[4,2,"せいしょ"],[7,1,"か"],[17,1,"め"],[21,1,"み"],[24,1,"みみ"],[28,1,"き"],[32,1,"ひと"],[34,1,"こころ"],[36,1,"おも"],[38,1,"うか"],[50,1,"かみ"],[54,2,"じぶん"],[57,1,"あい"],[60,1,"もの"],[67,1,"そな"]],"text":"しかし、聖書に書いてあるとおり、「目がまだ見ず、耳がまだ聞かず、人の心に思い浮びもしなかったことを、神は、ご自分を愛する者たちのために備えられた」のである。"},{"ref":"1Cor.2.10","start":46002010,"end":46002010,"break":"none","ruby":[[7,1,"かみ"],[10,2,"みたま"],[22,2,"けいじ"],[26,1,"くだ"],[35,2,"みたま"],[49,1,"かみ"],[51,1,"ふか"]],"text":"そして、それを神は、御霊によってわたしたちに啓示して下さったのである。御霊はすべてのものをきわめ、神の深みまでもきわめるのだからである。"},{"ref":"1Cor.2.11","start":46002011,"end":46002011,"break":"none","ruby":[[5,2,"にんげん"],[8,1,"おも"],[14,1,"うち"],[18,2,"にんげん"],[21,1,"れい"],[22,2,"いがい"],[29,1,"し"],[40,1,"おな"],[45,1,"かみ"],[47,1,"おも"],[51,1,"かみ"],[53,2,"みたま"],[55,2,"いがい"],[60,1,"し"]],"text":"いったい、人間の思いは、その内にある人間の霊以外に、だれが知っていようか。それと同じように神の思いも、神の御霊以外には、知るものはない。"},{"ref":"1Cor.2.12","start":46002012,"end":46002012,"break":"none","ruby":[[11,1,"う"],[19,1,"よ"],[21,1,"れい"],[27,1,"かみ"],[31,1,"れい"],[43,1,"かみ"],[46,1,"たま"],[50,1,"めぐ"],[53,1,"さと"]],"text":"ところが、わたしたちが受けたのは、この世の霊ではなく、神からの霊である。それによって、神から賜わった恵みを悟るためである。"},{"ref":"1Cor.2.13","start":46002013,"end":46002013,"break":"none","ruby":[[2,2,"たまもの"],[8,1,"かた"],[19,2,"にんげん"],[22,2,"ちえ"],[25,1,"おし"],[28,2,"ことば"],[31,1,"もち"],[37,2,"みたま"],[40,1,"おし"],[43,2,"ことば"],[46,1,"もち"],[49,1,"れい"],[54,1,"れい"],[59,2,"かいしゃく"]],"text":"この賜物について語るにも、わたしたちは人間の知恵が教える言葉を用いないで、御霊の教える言葉を用い、霊によって霊のことを解釈するのである。"},{"ref":"1Cor.2.14","start":46002014,"end":46002014,"break":"none","ruby":[[0,1,"うま"],[6,1,"ひと"],[9,1,"かみ"],[11,2,"みたま"],[14,2,"たまもの"],[17,1,"う"],[27,1,"かれ"],[30,1,"おろ"],[45,2,"みたま"],[51,2,"はんだん"],[64,1,"かれ"],[69,2,"りかい"]],"text":"生れながらの人は、神の御霊の賜物を受けいれない。それは彼には愚かなものだからである。また、御霊によって判断されるべきであるから、彼はそれを理解することができない。"},{"ref":"1Cor.2.15","start":46002015,"end":46002015,"break":"none","ruby":[[4,1,"れい"],[6,1,"ひと"],[16,2,"はんだん"],[22,2,"じぶん"],[24,2,"じしん"],[32,2,"はんだん"]],"text":"しかし、霊の人は、すべてのものを判断するが、自分自身はだれからも判断されることはない。"},{"ref":"1Cor.2.16","start":46002016,"end":46002016,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"おも"],[9,1,"し"],[13,1,"かれ"],[15,1,"おし"],[43,1,"おも"],[46,1,"も"]],"text":"「だれが主の思いを知って、彼を教えることができようか」。しかし、わたしたちはキリストの思いを持っている。"}]