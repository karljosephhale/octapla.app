[{"ref":"1Sam.8.1","start":9008001,"end":9008001,"break":"paragraph","ruby":[[5,2,"としお"],[12,1,"こ"]],"text":"サムエルは年老いて、その子らをイスラエルのさばきづかさとした。"},{"ref":"1Sam.8.2","start":9008002,"end":9008002,"break":"none","ruby":[[0,2,"ちょうし"],[3,1,"な"],[12,1,"つぎ"],[14,1,"こ"],[16,1,"な"],[22,1,"い"],[26,1,"かれ"]],"text":"長子の名はヨエルといい、次の子の名はアビヤと言った。彼らはベエルシバでさばきづかさであった。"},{"ref":"1Sam.8.3","start":9008003,"end":9008003,"break":"none","ruby":[[5,1,"こ"],[8,1,"ちち"],[10,1,"みち"],[12,1,"あゆ"],[18,1,"り"],[29,1,"と"],[37,1,"ま"]],"text":"しかしその子らは父の道を歩まないで、利にむかい、まいないを取って、さばきを曲げた。"},{"ref":"1Sam.8.4","start":9008004,"end":9008004,"break":"paragraph","ruby":[[2,1,"とき"],[10,2,"ちょうろう"],[17,1,"あつ"]],"text":"この時、イスラエルの長老たちはみな集まってラマにおるサムエルのもとにきて、"},{"ref":"1Sam.8.5","start":9008005,"end":9008005,"break":"none","ruby":[[0,1,"い"],[9,2,"としお"],[17,1,"こ"],[25,1,"みち"],[27,1,"あゆ"],[32,1,"いま"],[36,2,"くにぐに"],[51,1,"おう"],[62,1,"た"]],"text":"言った、「あなたは年老い、あなたの子たちはあなたの道を歩まない。今ほかの国々のように、われわれをさばく王を、われわれのために立ててください」。"},{"ref":"1Sam.8.6","start":9008006,"end":9008006,"break":"none","ruby":[[3,1,"かれ"],[16,1,"おう"],[24,1,"あた"],[29,1,"い"],[33,1,"き"],[42,1,"よろこ"],[57,1,"しゅ"],[59,1,"いの"]],"text":"しかし彼らが、「われわれをさばく王を、われわれに与えよ」と言うのを聞いて、サムエルは喜ばなかった。そしてサムエルが主に祈ると、"},{"ref":"1Sam.8.7","start":9008007,"end":9008007,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"い"],[13,1,"たみ"],[23,1,"い"],[25,1,"ところ"],[27,1,"こえ"],[29,1,"き"],[31,1,"したが"],[37,1,"かれ"],[40,1,"す"],[57,1,"す"],[61,1,"かれ"],[64,1,"うえ"],[70,1,"おう"],[77,1,"みと"]],"text":"主はサムエルに言われた、「民が、すべてあなたに言う所の声に聞き従いなさい。彼らが捨てるのはあなたではなく、わたしを捨てて、彼らの上にわたしが王であることを認めないのである。"},{"ref":"1Sam.8.8","start":9008008,"end":9008008,"break":"none","ruby":[[0,1,"かれ"],[14,1,"つ"],[16,1,"のぼ"],[19,1,"ひ"],[33,1,"す"],[39,2,"かみがみ"],[42,1,"つか"],[50,1,"こと"]],"text":"彼らは、わたしがエジプトから連れ上った日から、きょうまで、わたしを捨ててほかの神々に仕え、さまざまの事をわたしにしたように、あなたにもしているのである。"},{"ref":"1Sam.8.9","start":9008009,"end":9008009,"break":"none","ruby":[[0,1,"いま"],[3,1,"こえ"],[5,1,"き"],[7,1,"したが"],[17,1,"ふか"],[19,1,"かれ"],[22,1,"いまし"],[26,1,"かれ"],[29,1,"おさ"],[32,1,"おう"],[39,1,"かれ"],[42,1,"しめ"]],"text":"今その声に聞き従いなさい。ただし、深く彼らを戒めて、彼らを治める王のならわしを彼らに示さなければならない」。"},{"ref":"1Sam.8.10","start":9008010,"end":9008010,"break":"paragraph","ruby":[[5,1,"おう"],[7,1,"た"],[13,1,"もと"],[16,1,"たみ"],[18,1,"しゅ"],[20,2,"ことば"],[28,1,"つ"]],"text":"サムエルは王を立てることを求める民に主の言葉をことごとく告げて、"},{"ref":"1Sam.8.11","start":9008011,"end":9008011,"break":"none","ruby":[[0,1,"い"],[11,1,"おさ"],[14,1,"おう"],[21,1,"つぎ"],[30,1,"かれ"],[42,1,"と"],[46,2,"せんしゃ"],[48,1,"たい"],[50,1,"い"],[53,2,"きへい"],[58,2,"じぶん"],[61,2,"せんしゃ"],[64,1,"まえ"],[66,1,"はし"]],"text":"言った、「あなたがたを治める王のならわしは次のとおりである。彼はあなたがたのむすこを取って、戦車隊に入れ、騎兵とし、自分の戦車の前に走らせるであろう。"},{"ref":"1Sam.8.12","start":9008012,"end":9008012,"break":"none","ruby":[[0,1,"かれ"],[8,1,"にん"],[10,1,"ちょう"],[14,1,"にん"],[16,1,"ちょう"],[18,1,"にん"],[25,1,"ち"],[27,1,"たがや"],[33,2,"さくもつ"],[36,1,"か"],[44,2,"ぶき"],[47,2,"せんしゃ"],[50,2,"そうび"],[53,1,"つく"]],"text":"彼はまたそれを千人の長、五十人の長に任じ、またその地を耕させ、その作物を刈らせ、またその武器と戦車の装備を造らせるであろう。"},{"ref":"1Sam.8.13","start":9008013,"end":9008013,"break":"none","ruby":[[9,1,"むすめ"],[11,1,"と"],[15,1,"こう"],[20,1,"もの"],[24,2,"りょうり"],[29,1,"もの"],[36,1,"や"],[38,1,"もの"]],"text":"また、あなたがたの娘を取って、香をつくる者とし、料理をする者とし、パンを焼く者とするであろう。"},{"ref":"1Sam.8.14","start":9008014,"end":9008014,"break":"none","ruby":[[9,1,"はたけ"],[14,1,"はたけ"],[19,1,"はたけ"],[21,1,"もっと"],[23,1,"よ"],[25,1,"もの"],[27,1,"と"],[33,2,"けらい"],[36,1,"あた"]],"text":"また、あなたがたの畑とぶどう畑とオリブ畑の最も良い物を取って、その家来に与え、"},{"ref":"1Sam.8.15","start":9008015,"end":9008015,"break":"none","ruby":[[6,2,"こくもつ"],[13,1,"はたけ"],[17,1,"ぶん"],[21,1,"と"],[27,2,"やくにん"],[30,2,"けらい"],[33,1,"あた"]],"text":"あなたがたの穀物と、ぶどう畑の、十分の一を取って、その役人と家来に与え、"},{"ref":"1Sam.8.16","start":9008016,"end":9008016,"break":"none","ruby":[[9,2,"だんじょ"],[12,2,"どれい"],[24,1,"もっと"],[26,1,"よ"],[28,1,"うし"],[33,1,"と"],[37,2,"じぶん"],[43,1,"はたら"]],"text":"また、あなたがたの男女の奴隷および、あなたがたの最も良い牛とろばを取って、自分のために働かせ、"},{"ref":"1Sam.8.17","start":9008017,"end":9008017,"break":"none","ruby":[[9,1,"ひつじ"],[12,1,"ぶん"],[16,1,"と"],[28,2,"どれい"]],"text":"また、あなたがたの羊の十分の一を取り、あなたがたは、その奴隷となるであろう。"},{"ref":"1Sam.8.18","start":9008018,"end":9008018,"break":"none","ruby":[[5,1,"ひ"],[12,2,"じぶん"],[18,1,"えら"],[21,1,"おう"],[26,1,"よ"],[38,1,"しゅ"],[42,1,"ひ"],[50,1,"こた"]],"text":"そしてその日あなたがたは自分のために選んだ王のゆえに呼ばわるであろう。しかし主はその日にあなたがたに答えられないであろう」。"},{"ref":"1Sam.8.19","start":9008019,"end":9008019,"break":"paragraph","ruby":[[4,1,"たみ"],[11,1,"こえ"],[13,1,"き"],[15,1,"したが"],[20,1,"こば"],[23,1,"い"],[37,1,"おさ"],[40,1,"おう"]],"text":"ところが民はサムエルの声に聞き従うことを拒んで言った、「いいえ、われわれを治める王がなければならない。"},{"ref":"1Sam.8.20","start":9008020,"end":9008020,"break":"none","ruby":[[5,1,"た"],[7,2,"くにぐに"],[16,1,"おう"],[32,1,"ひき"],[41,1,"たたか"]],"text":"われわれも他の国々のようになり、王がわれわれをさばき、われわれを率いて、われわれの戦いにたたかうのである」。"},{"ref":"1Sam.8.21","start":9008021,"end":9008021,"break":"none","ruby":[[5,1,"たみ"],[7,2,"ことば"],[15,1,"き"],[22,1,"しゅ"],[24,1,"みみ"],[26,1,"つ"]],"text":"サムエルは民の言葉をことごとく聞いて、それを主の耳に告げた。"},{"ref":"1Sam.8.22","start":9008022,"end":9008022,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"い"],[13,1,"かれ"],[16,1,"こえ"],[18,1,"き"],[20,1,"したが"],[23,1,"かれ"],[29,1,"おう"],[31,1,"た"],[47,2,"ひとびと"],[50,1,"い"],[68,1,"まち"],[70,1,"かえ"]],"text":"主はサムエルに言われた、「彼らの声に聞き従い、彼らのために王を立てよ」。サムエルはイスラエルの人々に言った、「あなたがたは、めいめいその町に帰りなさい」。"}]