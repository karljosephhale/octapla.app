[{"ref":"Heb.12.1","start":58012001,"end":58012001,"break":"paragraph","ruby":[[20,1,"おお"],[23,2,"しょうにん"],[26,1,"くも"],[31,1,"かこ"],[49,2,"おもに"],[58,1,"つみ"],[65,1,"す"],[75,2,"さんか"],[80,2,"きょうそう"],[84,1,"た"],[86,1,"しの"],[89,1,"はし"]],"text":"こういうわけで、わたしたちは、このような多くの証人に雲のように囲まれているのであるから、いっさいの重荷と、からみつく罪とをかなぐり捨てて、わたしたちの参加すべき競走を、耐え忍んで走りぬこうではないか。"},{"ref":"Heb.12.2","start":58012002,"end":58012002,"break":"none","ruby":[[0,2,"しんこう"],[3,1,"みちび"],[5,1,"て"],[14,2,"かんせい"],[16,1,"もの"],[24,1,"あお"],[26,1,"み"],[30,1,"はし"],[39,1,"かれ"],[42,2,"じぶん"],[45,1,"まえ"],[53,1,"よろこ"],[60,1,"はじ"],[69,3,"じゅうじか"],[73,1,"しの"],[76,1,"かみ"],[78,2,"みざ"],[81,1,"みぎ"],[83,1,"ざ"],[87,1,"いた"]],"text":"信仰の導き手であり、またその完成者であるイエスを仰ぎ見つつ、走ろうではないか。彼は、自分の前におかれている喜びのゆえに、恥をもいとわないで十字架を忍び、神の御座の右に座するに至ったのである。"},{"ref":"Heb.12.3","start":58012003,"end":58012003,"break":"none","ruby":[[7,1,"よわ"],[9,1,"は"],[12,2,"いき"],[24,2,"つみびと"],[33,2,"はんこう"],[36,1,"た"],[38,1,"しの"],[48,1,"おも"]],"text":"あなたがたは、弱り果てて意気そそうしないために、罪人らのこのような反抗を耐え忍んだかたのことを、思いみるべきである。"},{"ref":"Heb.12.4","start":58012004,"end":58012004,"break":"none","ruby":[[7,1,"つみ"],[9,1,"と"],[11,1,"く"],[14,1,"たたか"],[16,1,"とき"],[20,1,"ち"],[22,1,"なが"],[27,2,"ていこう"]],"text":"あなたがたは、罪と取り組んで戦う時、まだ血を流すほどの抵抗をしたことがない。"},{"ref":"Heb.12.5","start":58012005,"end":58012005,"break":"none","breaks":[[37,"stanza"],[45,"line"],[60,"line"]],"ruby":[[2,1,"こ"],[6,1,"たい"],[19,1,"かた"],[25,1,"すす"],[28,2,"ことば"],[31,1,"わす"],[42,1,"こ"],[45,1,"しゅ"],[47,2,"くんれん"],[50,1,"かろ"],[60,1,"しゅ"],[62,1,"せ"],[70,1,"よわ"],[72,1,"は"]],"text":"また子たちに対するように、あなたがたに語られたこの勧めの言葉を忘れている、「わたしの子よ、主の訓練を軽んじてはいけない。主に責められるとき、弱り果ててはならない。"},{"ref":"Heb.12.6","start":58012006,"end":58012006,"break":"line","breaks":[[11,"line"],[23,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"あい"],[5,1,"もの"],[7,2,"くんれん"],[11,1,"う"],[20,1,"こ"],[25,1,"う"]],"text":"主は愛する者を訓練し、受けいれるすべての子を、むち打たれるのである」。"},{"ref":"Heb.12.7","start":58012007,"end":58012007,"break":"none","ruby":[[6,2,"くんれん"],[11,1,"た"],[13,1,"しの"],[19,1,"かみ"],[28,1,"こ"],[32,1,"と"],[34,1,"あつか"],[51,1,"ちち"],[53,2,"くんれん"],[59,1,"こ"]],"text":"あなたがたは訓練として耐え忍びなさい。神はあなたがたを、子として取り扱っておられるのである。いったい、父に訓練されない子があるだろうか。"},{"ref":"Heb.12.8","start":58012008,"end":58012008,"break":"none","ruby":[[4,1,"う"],[7,2,"くんれん"],[17,1,"あた"],[39,3,"しせいじ"],[52,1,"こ"]],"text":"だれでも受ける訓練が、あなたがたに与えられないとすれば、それこそ、あなたがたは私生子であって、ほんとうの子ではない。"},{"ref":"Heb.12.9","start":58012009,"end":58012009,"break":"none","ruby":[[2,1,"うえ"],[4,2,"にくしん"],[7,1,"ちち"],[15,2,"くんれん"],[24,1,"かれ"],[52,1,"ちち"],[54,2,"ふくじゅう"],[59,1,"しん"],[61,1,"い"]],"text":"その上、肉親の父はわたしたちを訓練するのに、なお彼をうやまうとすれば、なおさら、わたしたちは、たましいの父に服従して、真に生きるべきではないか。"},{"ref":"Heb.12.10","start":58012010,"end":58012010,"break":"none","ruby":[[0,2,"にくしん"],[3,1,"ちち"],[11,1,"あいだ"],[13,2,"じぶん"],[16,1,"かんが"],[19,1,"したが"],[22,2,"くんれん"],[25,1,"あた"],[35,1,"ちち"],[44,1,"えき"]],"text":"肉親の父は、しばらくの間、自分の考えに従って訓練を与えるが、たましいの父は、わたしたちの益のため、そのきよさにあずからせるために、そうされるのである。"},{"ref":"Heb.12.11","start":58012011,"end":58012011,"break":"none","ruby":[[4,2,"くんれん"],[8,2,"とうざ"],[12,1,"よろこ"],[20,1,"おも"],[28,1,"かな"],[34,1,"おも"],[42,1,"のち"],[54,2,"きたえ"],[59,1,"もの"],[62,2,"へいあん"],[65,1,"ぎ"],[67,1,"み"],[69,1,"むす"]],"text":"すべての訓練は、当座は、喜ばしいものとは思われず、むしろ悲しいものと思われる。しかし後になれば、それによって鍛えられる者に、平安な義の実を結ばせるようになる。"},{"ref":"Heb.12.12","start":58012012,"end":58012012,"break":"paragraph","ruby":[[15,1,"て"],[18,1,"よわ"]],"text":"それだから、あなたがたのなえた手と、弱くなっているひざとを、まっすぐにしなさい。"},{"ref":"Heb.12.13","start":58012013,"end":58012013,"break":"none","ruby":[[3,1,"あし"],[10,1,"もの"],[12,1,"ふ"],[40,1,"あし"],[51,1,"みち"]],"text":"また、足のなえている者が踏みはずすことなく、むしろいやされるように、あなたがたの足のために、まっすぐな道をつくりなさい。"},{"ref":"Heb.12.14","start":58012014,"end":58012014,"break":"none","ruby":[[4,1,"ひと"],[6,1,"あい"],[7,1,"わ"],[13,1,"みずか"],[23,1,"つと"],[42,1,"しゅ"],[44,1,"み"]],"text":"すべての人と相和し、また、自らきよくなるように努めなさい。きよくならなければ、だれも主を見ることはできない。"},{"ref":"Heb.12.15","start":58012015,"end":58012015,"break":"none","ruby":[[0,1,"き"],[6,1,"かみ"],[8,1,"めぐ"],[27,1,"にが"],[29,1,"ね"],[33,1,"で"],[42,1,"なや"],[52,1,"おお"],[55,1,"ひと"],[57,1,"けが"]],"text":"気をつけて、神の恵みからもれることがないように、また、苦い根がはえ出て、あなたがたを悩まし、それによって多くの人が汚されることのないようにしなさい。"},{"ref":"Heb.12.16","start":58012016,"end":58012016,"break":"none","ruby":[[3,2,"いっぱい"],[6,1,"しょく"],[11,2,"ちょうし"],[14,2,"けんり"],[17,1,"う"],[28,3,"ふひんこう"],[32,2,"ぞくあく"],[35,1,"もの"]],"text":"また、一杯の食のために長子の権利を売ったエサウのように、不品行な俗悪な者にならないようにしなさい。"},{"ref":"Heb.12.17","start":58012017,"end":58012017,"break":"none","ruby":[[6,1,"し"],[15,1,"かれ"],[19,1,"のち"],[21,2,"しゅくふく"],[24,1,"う"],[26,1,"つ"],[30,1,"ねが"],[38,1,"す"],[47,1,"なみだ"],[49,1,"なが"],[55,1,"もと"],[60,2,"くいあらた"],[64,2,"きかい"],[67,1,"え"]],"text":"あなたがたの知っているように、彼はその後、祝福を受け継ごうと願ったけれども、捨てられてしまい、涙を流してそれを求めたが、悔改めの機会を得なかったのである。"},{"ref":"Heb.12.18","start":58012018,"end":58012018,"break":"paragraph","ruby":[[6,1,"ちか"],[15,1,"て"],[17,1,"ふ"],[26,1,"ひ"],[28,1,"も"],[31,2,"くろくも"],[34,1,"くら"]],"text":"あなたがたが近づいているのは、手で触れることができ、火が燃え、黒雲や暗やみやあらしにつつまれ、"},{"ref":"Heb.12.19","start":58012019,"end":58012019,"break":"none","ruby":[[7,1,"ひびき"],[10,1,"き"],[13,1,"もの"],[19,2,"いじょう"],[22,1,"みみ"],[30,1,"ねが"],[36,2,"ことば"],[45,1,"やま"]],"text":"また、ラッパの響や、聞いた者たちがそれ以上、耳にしたくないと願ったような言葉がひびいてきた山ではない。"},{"ref":"Heb.12.20","start":58012020,"end":58012020,"break":"none","ruby":[[5,1,"かれ"],[19,1,"やま"],[21,1,"ふれ"],[25,1,"いし"],[27,1,"う"],[29,1,"ころ"],[40,2,"めいれい"],[43,2,"ことば"],[47,1,"た"]],"text":"そこでは、彼らは、「けものであっても、山に触たら、石で打ち殺されてしまえ」という命令の言葉に、耐えることができなかったのである。"},{"ref":"Heb.12.21","start":58012021,"end":58012021,"break":"none","ruby":[[2,2,"こうけい"],[5,1,"おそ"],[25,1,"おそ"],[43,1,"い"]],"text":"その光景が恐ろしかったのでモーセさえも、「わたしは恐ろしさのあまり、おののいている」と言ったほどである。"},{"ref":"Heb.12.22","start":58012022,"end":58012022,"break":"none","ruby":[[9,1,"ちか"],[22,1,"やま"],[24,1,"い"],[27,1,"かみ"],[29,1,"みやこ"],[31,1,"てん"],[41,2,"むすう"],[44,2,"てんし"],[47,1,"いわい"],[48,1,"かい"]],"text":"しかしあなたがたが近づいているのは、シオンの山、生ける神の都、天にあるエルサレム、無数の天使の祝会、"},{"ref":"Heb.12.23","start":58012023,"end":58012023,"break":"none","ruby":[[0,1,"てん"],[2,2,"とうろく"],[9,2,"ちょうし"],[14,2,"きょうかい"],[17,2,"ばんみん"],[20,3,"しんぱんしゃ"],[25,1,"かみ"],[27,1,"まっと"],[32,2,"ぎじん"],[35,1,"れい"]],"text":"天に登録されている長子たちの教会、万民の審判者なる神、全うされた義人の霊、"},{"ref":"Heb.12.24","start":58012024,"end":58012024,"break":"none","ruby":[[0,1,"あたら"],[3,2,"けいやく"],[6,3,"ちゅうほしゃ"],[22,1,"ち"],[26,2,"ちからづよ"],[29,1,"かた"],[36,1,"ち"]],"text":"新しい契約の仲保者イエス、ならびに、アベルの血よりも力強く語るそそがれた血である。"},{"ref":"Heb.12.25","start":58012025,"end":58012025,"break":"none","ruby":[[7,1,"かた"],[17,1,"こば"],[28,2,"ちゅうい"],[37,2,"ちじょう"],[40,2,"みむね"],[43,1,"つ"],[46,1,"もの"],[48,1,"こば"],[51,2,"ひとびと"],[55,1,"ばつ"],[73,1,"てん"],[76,1,"つ"],[78,1,"しめ"],[83,1,"しりぞ"]],"text":"あなたがたは、語っておられるかたを拒むことがないように、注意しなさい。もし地上で御旨を告げた者を拒んだ人々が、罰をのがれることができなかったなら、天から告げ示すかたを退けるわたしたちは、なおさらそうなるのではないか。"},{"ref":"Heb.12.26","start":58012026,"end":58012026,"break":"none","ruby":[[2,1,"とき"],[6,1,"み"],[7,1,"こえ"],[9,1,"ち"],[11,1,"ふる"],[19,1,"いま"],[22,2,"やくそく"],[26,1,"い"],[39,1,"ど"],[41,1,"ち"],[48,1,"てん"],[51,1,"ふる"]],"text":"あの時には、御声が地を震わせた。しかし今は、約束して言われた、「わたしはもう一度、地ばかりでなく天をも震わそう」。"},{"ref":"Heb.12.27","start":58012027,"end":58012027,"break":"none","ruby":[[6,1,"ど"],[11,2,"ことば"],[15,1,"ふる"],[23,1,"のこ"],[29,1,"ふる"],[37,1,"つく"],[46,1,"と"],[48,1,"のぞ"],[55,1,"しめ"]],"text":"この「もう一度」という言葉は、震われないものが残るために、震われるものが、造られたものとして取り除かれることを示している。"},{"ref":"Heb.12.28","start":58012028,"end":58012028,"break":"none","ruby":[[12,1,"ふる"],[17,1,"くに"],[19,1,"う"],[29,2,"かんしゃ"],[44,2,"かんしゃ"],[50,1,"おそ"],[57,1,"かみ"],[59,1,"よろこ"],[67,1,"つか"]],"text":"このように、わたしたちは震われない国を受けているのだから、感謝をしようではないか。そして感謝しつつ、恐れかしこみ、神に喜ばれるように、仕えていこう。"},{"ref":"Heb.12.29","start":58012029,"end":58012029,"break":"none","ruby":[[6,1,"かみ"],[9,1,"じつ"],[12,1,"や"],[17,1,"ひ"]],"text":"わたしたちの神は、実に、焼きつくす火である。"}]