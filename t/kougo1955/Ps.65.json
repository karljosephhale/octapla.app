[{"ref":"Ps.65.1","start":19065001,"end":19065001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌、さんび","breaks":[[22,"line"],[33,"line"]],"ruby":[[0,1,"かみ"],[33,1,"ひと"],[39,1,"ちか"],[42,1,"はた"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"神よ、シオンにて、あなたをほめたたえることはふさわしいことである。人はあなたに誓いを果すであろう。"},{"ref":"Ps.65.2","start":19065002,"end":19065003,"break":"line","breaks":[[9,"line"],[30,"line"],[48,"line"]],"ruby":[[0,1,"いのり"],[2,1,"き"],[6,1,"かた"],[13,1,"にく"],[16,1,"もの"],[18,1,"つみ"],[27,1,"く"],[41,1,"う"],[43,1,"か"]],"text":"祈を聞かれる方よ、すべての肉なる者は罪のゆえにあなたに来る。われらのとががわれらに打ち勝つとき、あなたはこれをゆるされる。"},{"ref":"Ps.65.4","start":19065004,"end":19065004,"break":"line","breaks":[[19,"line"],[38,"line"],[57,"line"]],"ruby":[[4,1,"えら"],[12,1,"ちか"],[23,2,"おおにわ"],[26,1,"す"],[28,1,"ひと"],[46,1,"いえ"],[52,1,"せい"],[55,1,"みや"],[57,1,"めぐ"],[63,1,"あ"]],"text":"あなたに選ばれ、あなたに近づけられて、あなたの大庭に住む人はさいわいである。われらはあなたの家、あなたの聖なる宮の恵みによって飽くことができる。"},{"ref":"Ps.65.5","start":19065005,"end":19065005,"break":"line","breaks":[[9,"line"],[33,"line"],[43,"line"]],"ruby":[[4,1,"すくい"],[6,1,"かみ"],[9,1,"ち"],[20,1,"とお"],[22,1,"うみ"],[24,1,"のぞ"],[33,1,"おそ"],[43,1,"すくい"],[52,1,"こた"]],"text":"われらの救の神よ、地のもろもろのはてと、遠き海の望みであるあなたは恐るべきわざにより、救をもってわれらに答えられる。"},{"ref":"Ps.65.6","start":19065006,"end":19065006,"break":"line","breaks":[[10,"line"]],"ruby":[[4,2,"たいのう"],[7,1,"お"],[13,1,"ちから"],[24,1,"やま"],[26,1,"かた"],[28,1,"た"]],"text":"あなたは大能を帯び、そのみ力によって、もろもろの山を堅く立たせられる。"},{"ref":"Ps.65.7","start":19065007,"end":19065007,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"うみ"],[6,1,"ひび"],[9,2,"おおなみ"],[12,1,"ひび"],[20,1,"たみ"],[22,1,"さわ"],[25,1,"しず"]],"text":"あなたは海の響き、大波の響き、もろもろの民の騒ぎを静められる。"},{"ref":"Ps.65.8","start":19065008,"end":19065008,"break":"line","breaks":[[16,"line"],[35,"line"],[49,"line"]],"ruby":[[5,1,"ち"],[10,1,"す"],[12,2,"ひとびと"],[29,1,"み"],[31,1,"おそ"],[39,1,"あさ"],[41,1,"ゆう"],[43,1,"で"],[45,1,"ところ"],[49,1,"よろこ"],[51,1,"うた"]],"text":"それゆえ、地のはてに住む人々も、あなたのもろもろのしるしを見て恐れる。あなたは朝と夕の出る所をして喜び歌わせられる。"},{"ref":"Ps.65.9","start":19065009,"end":19065009,"break":"line","breaks":[[19,"line"],[32,"line"],[44,"line"],[57,"line"]],"ruby":[[4,1,"ち"],[6,1,"のぞ"],[13,1,"みず"],[22,1,"おお"],[25,1,"ゆた"],[32,1,"かみ"],[34,1,"かわ"],[36,1,"みず"],[38,1,"み"],[53,1,"そな"],[57,1,"かれ"],[60,2,"こくもつ"],[63,1,"あた"]],"text":"あなたは地に臨んで、これに水をそそぎ、これを大いに豊かにされる。神の川は水で満ちている。あなたはそのように備えして彼らに穀物を与えられる。"},{"ref":"Ps.65.10","start":19065010,"end":19065010,"break":"line","breaks":[[18,"line"],[42,"line"]],"ruby":[[6,1,"た"],[10,1,"ゆた"],[23,1,"ととの"],[26,2,"ゆうだ"],[36,1,"やわ"],[46,1,"で"],[50,2,"しゅくふく"]],"text":"あなたはその田みぞを豊かにうるおし、そのうねを整え、夕立ちをもってそれを柔らかにし、そのもえ出るのを祝福し、"},{"ref":"Ps.65.11","start":19065011,"end":19065011,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"めぐ"],[10,1,"とし"],[12,1,"かんむり"],[22,1,"みち"]],"text":"またその恵みをもって年の冠とされる。あなたの道にはあぶらがしたたる。"},{"ref":"Ps.65.12","start":19065012,"end":19065012,"break":"line","ruby":[[0,1,"の"],[2,2,"まきば"],[10,2,"こやま"],[13,1,"よろこ"]],"text":"野の牧場はしたたり、小山は喜びをまとい、"},{"ref":"Ps.65.13","start":19065013,"end":19065013,"break":"line","breaks":[[10,"line"],[28,"line"]],"ruby":[[0,2,"まきば"],[3,1,"ひつじ"],[5,1,"む"],[8,1,"き"],[15,1,"たに"],[17,2,"こくもつ"],[28,1,"かれ"],[31,1,"よろこ"],[33,1,"よ"],[38,1,"とも"],[40,1,"うた"]],"text":"牧場は羊の群れを着、もろもろの谷は穀物をもっておおわれ、彼らは喜び呼ばわって共に歌う。"}]