[{"ref":"Neh.7.1","start":16007001,"end":16007001,"break":"paragraph","ruby":[[0,2,"じょうへき"],[3,1,"きず"],[12,1,"もう"],[18,2,"もんえい"],[21,1,"うた"],[25,1,"もの"],[34,2,"にんめい"]],"text":"城壁が築かれて、とびらを設け、さらに門衛、歌うたう者およびレビびとを任命したので、"},{"ref":"Neh.7.2","start":16007002,"end":16007002,"break":"none","ruby":[[9,2,"きょうだい"],[16,1,"しろ"],[26,1,"めい"],[36,1,"おさ"],[42,1,"かれ"],[44,1,"おお"],[47,1,"もの"],[53,2,"ちゅうしん"],[57,1,"かみ"],[59,1,"おそ"],[62,1,"もの"]],"text":"わたしは、わたしの兄弟ハナニと、城のつかさハナニヤに命じて、エルサレムを治めさせた。彼は多くの者にまさって忠信な、神を恐れる者であったからである。"},{"ref":"Neh.7.3","start":16007003,"end":16007003,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[12,1,"ひ"],[14,1,"あつ"],[32,1,"もん"],[34,1,"ひら"],[43,2,"ひとびと"],[46,1,"た"],[49,1,"まも"],[54,1,"あいだ"],[56,1,"もん"],[58,1,"と"],[63,1,"かん"],[65,1,"き"],[67,1,"さ"],[78,2,"じゅうみん"],[81,1,"なか"],[84,2,"ばんぺい"],[87,1,"た"],[98,1,"ところ"],[100,1,"まも"],[111,1,"いえ"],[113,1,"む"],[116,1,"あ"],[118,1,"ところ"],[120,1,"まも"]],"text":"わたしは彼らに言った、「日の暑くなるまではエルサレムのもろもろの門を開いてはならない。人々が立って守っている間に門を閉じさせ、貫の木を差せ。またエルサレムの住民の中から番兵を立てて、おのおのにその所を守らせ、またおのおのの家と向かい合う所を守らせよ」。"},{"ref":"Neh.7.4","start":16007004,"end":16007004,"break":"none","ruby":[[0,1,"まち"],[2,1,"ひろ"],[5,1,"おお"],[14,1,"うち"],[16,1,"たみ"],[18,1,"すく"],[22,2,"いえいえ"],[27,1,"た"]],"text":"町は広くて大きかったが、その内の民は少なく、家々はまだ建てられていなかった。"},{"ref":"Neh.7.5","start":16007005,"end":16007005,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"かみ"],[8,1,"こころ"],[11,1,"たっと"],[13,2,"ひとびと"],[22,1,"たみ"],[24,1,"あつ"],[28,2,"かけい"],[36,2,"めいぼ"],[46,1,"おも"],[49,1,"おこ"],[58,2,"さいしょ"],[61,1,"のぼ"],[64,1,"き"],[66,2,"ひとびと"],[69,2,"けいず"],[72,2,"はっけん"],[78,1,"なか"],[93,1,"み"]],"text":"時に神はわたしの心に、尊い人々、つかさおよび民を集めて、家系によってその名簿をしらべようとの思いを起された。わたしは最初に上って来た人々の系図を発見し、その中にこのようにしるしてあるのを見いだした。"},{"ref":"Neh.7.6","start":16007006,"end":16007006,"break":"paragraph","ruby":[[5,1,"おう"],[14,1,"とら"],[16,1,"うつ"],[19,2,"ほしゅう"],[41,1,"のぼ"],[48,2,"じぶん"],[51,1,"まち"],[53,1,"かえ"],[58,1,"しゅう"],[60,2,"ひとびと"],[63,1,"つぎ"]],"text":"バビロンの王ネブカデネザルが捕え移した捕囚のうち、ゆるされてエルサレムおよびユダに上り、おのおの自分の町に帰ったこの州の人々は次のとおりである。"},{"ref":"Neh.7.7","start":16007007,"end":16007007,"break":"none","breaks":[[80,"paragraph"]],"ruby":[[0,1,"かれ"],[65,2,"いっしょ"],[68,1,"かえ"],[73,1,"もの"],[88,1,"たみ"],[90,2,"にんずう"],[93,1,"つぎ"]],"text":"彼らはゼルバベル、エシュア、ネヘミヤ、アザリヤ、ラアミヤ、ナハマニ、モルデカイ、ビルシャン、ミスペレテ、ビグワイ、ネホム、バアナと一緒に帰ってきた者たちである。そのイスラエルの民の人数は次のとおりである。"},{"ref":"Neh.7.8","start":16007008,"end":16007008,"break":"none","ruby":[[4,2,"しそん"],[13,1,"にん"]],"text":"パロシの子孫は二千百七十二人。"},{"ref":"Neh.7.9","start":16007009,"end":16007009,"break":"none","ruby":[[5,2,"しそん"],[13,1,"にん"]],"text":"シパテヤの子孫は三百七十二人。"},{"ref":"Neh.7.10","start":16007010,"end":16007010,"break":"none","ruby":[[3,2,"しそん"],[11,1,"にん"]],"text":"アラの子孫は六百五十二人。"},{"ref":"Neh.7.11","start":16007011,"end":16007011,"break":"none","ruby":[[8,2,"しそん"],[23,2,"しそん"],[32,1,"にん"]],"text":"パハテ・モアブの子孫すなわちエシュアとヨアブの子孫は二千八百十八人。"},{"ref":"Neh.7.12","start":16007012,"end":16007012,"break":"none","ruby":[[4,2,"しそん"],[14,1,"にん"]],"text":"エラムの子孫は一千二百五十四人。"},{"ref":"Neh.7.13","start":16007013,"end":16007013,"break":"none","ruby":[[4,2,"しそん"],[12,1,"にん"]],"text":"ザットの子孫は八百四十五人。"},{"ref":"Neh.7.14","start":16007014,"end":16007014,"break":"none","ruby":[[5,2,"しそん"],[12,1,"にん"]],"text":"ザッカイの子孫は七百六十人。"},{"ref":"Neh.7.15","start":16007015,"end":16007015,"break":"none","ruby":[[5,2,"しそん"],[13,1,"にん"]],"text":"ビンヌイの子孫は六百四十八人。"},{"ref":"Neh.7.16","start":16007016,"end":16007016,"break":"none","ruby":[[4,2,"しそん"],[12,1,"にん"]],"text":"ベバイの子孫は六百二十八人。"},{"ref":"Neh.7.17","start":16007017,"end":16007017,"break":"none","ruby":[[5,2,"しそん"],[15,1,"にん"]],"text":"アズガデの子孫は二千三百二十二人。"},{"ref":"Neh.7.18","start":16007018,"end":16007018,"break":"none","ruby":[[6,2,"しそん"],[14,1,"にん"]],"text":"アドニカムの子孫は六百六十七人。"},{"ref":"Neh.7.19","start":16007019,"end":16007019,"break":"none","ruby":[[5,2,"しそん"],[13,1,"にん"]],"text":"ビグワイの子孫は二千六十七人。"},{"ref":"Neh.7.20","start":16007020,"end":16007020,"break":"none","ruby":[[4,2,"しそん"],[12,1,"にん"]],"text":"アデンの子孫は六百五十五人。"},{"ref":"Neh.7.21","start":16007021,"end":16007021,"break":"none","ruby":[[5,1,"いえ"],[11,2,"しそん"],[17,1,"にん"]],"text":"ヒゼキヤの家のアテルの子孫は九十八人。"},{"ref":"Neh.7.22","start":16007022,"end":16007022,"break":"none","ruby":[[5,2,"しそん"],[13,1,"にん"]],"text":"ハシュムの子孫は三百二十八人。"},{"ref":"Neh.7.23","start":16007023,"end":16007023,"break":"none","ruby":[[4,2,"しそん"],[12,1,"にん"]],"text":"ベザイの子孫は三百二十四人。"},{"ref":"Neh.7.24","start":16007024,"end":16007024,"break":"none","ruby":[[4,2,"しそん"],[10,1,"にん"]],"text":"ハリフの子孫は百十二人。"},{"ref":"Neh.7.25","start":16007025,"end":16007025,"break":"none","ruby":[[5,2,"しそん"],[11,1,"にん"]],"text":"ギベオンの子孫は九十五人。"},{"ref":"Neh.7.26","start":16007026,"end":16007026,"break":"none","ruby":[[12,2,"ひとびと"],[19,1,"にん"]],"text":"ベツレヘムおよびネトパの人々は百八十八人。"},{"ref":"Neh.7.27","start":16007027,"end":16007027,"break":"none","ruby":[[5,2,"ひとびと"],[12,1,"にん"]],"text":"アナトテの人々は百二十八人。"},{"ref":"Neh.7.28","start":16007028,"end":16007028,"break":"none","ruby":[[9,2,"ひとびと"],[15,1,"にん"]],"text":"ベテ・アズマウテの人々は四十二人。"},{"ref":"Neh.7.29","start":16007029,"end":16007029,"break":"none","ruby":[[20,2,"ひとびと"],[28,1,"にん"]],"text":"キリアテ・ヤリム、ケピラおよびベエロテの人々は七百四十三人。"},{"ref":"Neh.7.30","start":16007030,"end":16007030,"break":"none","ruby":[[8,2,"ひとびと"],[16,1,"にん"]],"text":"ラマおよびゲバの人々は六百二十一人。"},{"ref":"Neh.7.31","start":16007031,"end":16007031,"break":"none","ruby":[[5,2,"ひとびと"],[12,1,"にん"]],"text":"ミクマシの人々は百二十二人。"},{"ref":"Neh.7.32","start":16007032,"end":16007032,"break":"none","ruby":[[9,2,"ひとびと"],[16,1,"にん"]],"text":"ベテルおよびアイの人々は百二十三人。"},{"ref":"Neh.7.33","start":16007033,"end":16007033,"break":"none","ruby":[[6,2,"ひとびと"],[12,1,"にん"]],"text":"ほかのネボの人々は五十二人。"},{"ref":"Neh.7.34","start":16007034,"end":16007034,"break":"none","ruby":[[7,2,"しそん"],[17,1,"にん"]],"text":"ほかのエラムの子孫は一千二百五十四人。"},{"ref":"Neh.7.35","start":16007035,"end":16007035,"break":"none","ruby":[[4,2,"しそん"],[11,1,"にん"]],"text":"ハリムの子孫は三百二十人。"},{"ref":"Neh.7.36","start":16007036,"end":16007036,"break":"none","ruby":[[4,2,"ひとびと"],[12,1,"にん"]],"text":"エリコの人々は三百四十五人。"},{"ref":"Neh.7.37","start":16007037,"end":16007037,"break":"none","ruby":[[12,2,"ひとびと"],[20,1,"にん"]],"text":"ロド、ハデデおよびオノの人々は七百二十一人。"},{"ref":"Neh.7.38","start":16007038,"end":16007038,"break":"none","ruby":[[4,2,"しそん"],[13,1,"にん"]],"text":"セナアの子孫は三千九百三十人。"},{"ref":"Neh.7.39","start":16007039,"end":16007039,"break":"none","ruby":[[0,2,"さいし"],[10,1,"いえ"],[16,2,"しそん"],[24,1,"にん"]],"text":"祭司では、エシュアの家のエダヤの子孫が九百七十三人。"},{"ref":"Neh.7.40","start":16007040,"end":16007040,"break":"none","ruby":[[5,2,"しそん"],[13,1,"にん"]],"text":"インメルの子孫が一千五十二人。"},{"ref":"Neh.7.41","start":16007041,"end":16007041,"break":"none","ruby":[[5,2,"しそん"],[15,1,"にん"]],"text":"パシュルの子孫が一千二百四十七人。"},{"ref":"Neh.7.42","start":16007042,"end":16007042,"break":"none","ruby":[[4,2,"しそん"],[11,1,"にん"]],"text":"ハリムの子孫が一千十七人。"},{"ref":"Neh.7.43","start":16007043,"end":16007043,"break":"paragraph","ruby":[[12,2,"しそん"],[22,2,"しそん"],[34,2,"しそん"],[40,1,"にん"]],"text":"レビびとでは、エシュアの子孫すなわちホデワの子孫のうちのカデミエルの子孫が七十四人。"},{"ref":"Neh.7.44","start":16007044,"end":16007044,"break":"paragraph","ruby":[[0,1,"うた"],[4,1,"もの"],[12,2,"しそん"],[19,1,"にん"]],"text":"歌うたう者では、アサフの子孫が百四十八人。"},{"ref":"Neh.7.45","start":16007045,"end":16007045,"break":"paragraph","ruby":[[0,2,"もんえい"],[10,2,"しそん"],[17,2,"しそん"],[25,2,"しそん"],[33,2,"しそん"],[40,2,"しそん"],[50,2,"しそん"],[52,1,"あ"],[60,1,"にん"]],"text":"門衛では、シャルムの子孫、アテルの子孫、タルモンの子孫、アックブの子孫、ハテタの子孫およびショバイの子孫合わせて百三十八人。"},{"ref":"Neh.7.46","start":16007046,"end":16007046,"break":"paragraph","ruby":[[0,1,"みや"],[2,1,"つか"],[14,2,"しそん"],[21,2,"しそん"],[29,2,"しそん"]],"text":"宮に仕えるしもべでは、ジハの子孫、ハスパの子孫、タバオテの子孫、"},{"ref":"Neh.7.47","start":16007047,"end":16007047,"break":"none","ruby":[[4,2,"しそん"],[10,2,"しそん"],[17,2,"しそん"]],"text":"ケロスの子孫、シアの子孫、パドンの子孫、"},{"ref":"Neh.7.48","start":16007048,"end":16007048,"break":"none","ruby":[[4,2,"しそん"],[11,2,"しそん"],[19,2,"しそん"]],"text":"レバナの子孫、ハガバの子孫、サルマイの子孫、"},{"ref":"Neh.7.49","start":16007049,"end":16007049,"break":"none","ruby":[[4,2,"しそん"],[11,2,"しそん"],[18,2,"しそん"]],"text":"ハナンの子孫、ギデルの子孫、ガハルの子孫、"},{"ref":"Neh.7.50","start":16007050,"end":16007050,"break":"none","ruby":[[4,2,"しそん"],[11,2,"しそん"],[18,2,"しそん"]],"text":"レアヤの子孫、レヂンの子孫、ネコダの子孫、"},{"ref":"Neh.7.51","start":16007051,"end":16007051,"break":"none","ruby":[[4,2,"しそん"],[10,2,"しそん"],[17,2,"しそん"]],"text":"ガザムの子孫、ウザの子孫、パセアの子孫、"},{"ref":"Neh.7.52","start":16007052,"end":16007052,"break":"none","ruby":[[4,2,"しそん"],[12,2,"しそん"],[21,2,"しそん"]],"text":"ベサイの子孫、メウニムの子孫、ネフセシムの子孫、"},{"ref":"Neh.7.53","start":16007053,"end":16007053,"break":"none","ruby":[[5,2,"しそん"],[12,2,"しそん"],[20,2,"しそん"]],"text":"バクブクの子孫、ハクパの子孫、ハルホルの子孫、"},{"ref":"Neh.7.54","start":16007054,"end":16007054,"break":"none","ruby":[[5,2,"しそん"],[12,2,"しそん"],[20,2,"しそん"]],"text":"バヅリテの子孫、メヒダの子孫、ハルシャの子孫、"},{"ref":"Neh.7.55","start":16007055,"end":16007055,"break":"none","ruby":[[5,2,"しそん"],[12,2,"しそん"],[18,2,"しそん"]],"text":"バルコスの子孫、シセラの子孫、テマの子孫、"},{"ref":"Neh.7.56","start":16007056,"end":16007056,"break":"none","ruby":[[4,2,"しそん"],[13,2,"しそん"]],"text":"ネヂアの子孫およびハテパの子孫。"},{"ref":"Neh.7.57","start":16007057,"end":16007057,"break":"paragraph","ruby":[[12,1,"もの"],[16,2,"しそん"],[25,2,"しそん"],[33,2,"しそん"],[40,2,"しそん"]],"text":"ソロモンのしもべであった者たちの子孫では、ソタイの子孫、ソペレテの子孫、ペリダの子孫、"},{"ref":"Neh.7.58","start":16007058,"end":16007058,"break":"none","ruby":[[4,2,"しそん"],[12,2,"しそん"],[19,2,"しそん"]],"text":"ヤアラの子孫、ダルコンの子孫、ギデルの子孫、"},{"ref":"Neh.7.59","start":16007059,"end":16007059,"break":"none","ruby":[[5,2,"しそん"],[13,2,"しそん"],[28,2,"しそん"],[35,2,"しそん"]],"text":"シパテヤの子孫、ハッテルの子孫、ポケレテ・ハッゼバイムの子孫、アモンの子孫。"},{"ref":"Neh.7.60","start":16007060,"end":16007060,"break":"paragraph","ruby":[[0,1,"みや"],[2,1,"つか"],[23,1,"もの"],[27,2,"しそん"],[31,1,"あ"],[35,2,"さんびゃく"],[37,1,"きゅう"],[38,1,"じゅう"],[39,1,"に"],[40,1,"にん"]],"text":"宮に仕えるしもべたちとソロモンのしもべであった者たちの子孫とは合わせて三百九十二人。"},{"ref":"Neh.7.61","start":16007061,"end":16007061,"break":"paragraph","ruby":[[27,1,"のぼ"],[30,1,"き"],[32,1,"もの"],[41,2,"しぞく"],[45,2,"けっとう"],[49,1,"しめ"],[59,1,"もの"],[66,1,"あき"],[84,2,"ひとびと"],[87,1,"つぎ"]],"text":"テルメラ、テルハレサ、ケルブ、アドンおよびインメルから上って来た者があったが、その氏族と、血統とを示して、イスラエルの者であることを明らかにすることができなかった。その人々は次のとおりである。"},{"ref":"Neh.7.62","start":16007062,"end":16007062,"break":"none","ruby":[[8,2,"しそん"],[15,2,"しそん"],[22,2,"しそん"],[29,1,"あ"],[38,1,"にん"]],"text":"すなわちデラヤの子孫、トビヤの子孫、ネコダの子孫であって、合わせて六百四十二人。"},{"ref":"Neh.7.63","start":16007063,"end":16007063,"break":"none","ruby":[[2,2,"さいし"],[12,2,"しそん"],[20,2,"しそん"],[29,2,"しそん"],[53,1,"むすめ"],[61,1,"つま"],[72,1,"な"],[74,1,"よ"]],"text":"また祭司のうちにホバヤの子孫、ハッコヅの子孫、バルジライの子孫がある。バルジライはギレアデびとバルジライの娘たちのうちから妻をめとったので、その名で呼ばれた。"},{"ref":"Neh.7.64","start":16007064,"end":16007064,"break":"none","ruby":[[4,1,"もの"],[8,2,"けいず"],[11,1,"の"],[14,1,"もの"],[20,2,"じぶん"],[23,1,"せき"],[38,1,"けが"],[41,1,"もの"],[45,2,"さいし"],[48,1,"しょく"],[51,1,"のぞ"]],"text":"これらの者はこの系図に載った者のうちに、自分の籍をたずねたが、なかったので、汚れた者として祭司の職から除かれた。"},{"ref":"Neh.7.65","start":16007065,"end":16007065,"break":"none","ruby":[[0,2,"そうとく"],[3,1,"かれ"],[6,1,"つ"],[19,1,"お"],[22,2,"さいし"],[25,1,"おこ"],[33,1,"せい"],[36,1,"もの"],[38,1,"た"],[46,1,"い"]],"text":"総督は彼らに告げて、ウリムとトンミムを帯びる祭司の起るまでは、いと聖なる物を食べてはならぬと言った。"},{"ref":"Neh.7.66","start":16007066,"end":16007066,"break":"paragraph","ruby":[[0,2,"かいしゅう"],[3,1,"あ"],[15,1,"にん"]],"text":"会衆は合わせて四万二千三百六十人であった。"},{"ref":"Neh.7.67","start":16007067,"end":16007067,"break":"none","ruby":[[5,2,"だんじょ"],[8,2,"どれい"],[18,1,"にん"],[20,1,"うた"],[24,1,"もの"],[26,2,"だんじょ"],[28,1,"あ"],[37,1,"にん"]],"text":"このほかに男女の奴隷が七千三百三十七人、歌うたう者が男女合わせて二百四十五人あった。"},{"ref":"Neh.7.68","start":16007068,"end":16007068,"break":"none","ruby":[[2,1,"うま"],[9,1,"とう"],[13,2,"らば"],[21,1,"とう"]],"text":"その馬は七百三十六頭、その騾馬は二百四十五頭、"},{"ref":"Neh.7.69","start":16007069,"end":16007069,"break":"none","ruby":[[11,1,"とう"],[24,1,"とう"]],"text":"そのらくだは四百三十五頭、そのろばは六千七百二十頭であった。"},{"ref":"Neh.7.70","start":16007070,"end":16007070,"break":"paragraph","ruby":[[0,2,"しぞく"],[3,1,"ちょう"],[7,2,"こうじ"],[16,1,"もの"],[20,2,"ひとびと"],[27,2,"そうとく"],[30,1,"きん"],[37,1,"はち"],[41,2,"さいし"],[44,2,"いふく"],[54,1,"くら"],[56,1,"おさ"]],"text":"氏族の長のうち工事のためにささげ物をした人々があった。総督は金一千ダリク、鉢五十、祭司の衣服五百三十かさねを倉に納めた。"},{"ref":"Neh.7.71","start":16007071,"end":16007071,"break":"none","ruby":[[2,2,"しぞく"],[5,1,"ちょう"],[12,2,"ひとびと"],[15,1,"きん"],[22,1,"ぎん"],[30,2,"こうじ"],[36,1,"くら"],[38,1,"おさ"]],"text":"また氏族の長のうちのある人々は金二万ダリク、銀二千二百ミナを工事のために倉に納めた。"},{"ref":"Neh.7.72","start":16007072,"end":16007072,"break":"none","ruby":[[2,1,"た"],[4,1,"たみ"],[6,1,"おさ"],[12,1,"きん"],[19,1,"ぎん"],[25,2,"さいし"],[28,2,"いふく"]],"text":"その他の民の納めたものは金二万ダリク、銀二千ミナ、祭司の衣服六十七かさねであった。"},{"ref":"Neh.7.73","start":16007073,"end":16007073,"break":"paragraph","breaks":[[63,"paragraph"]],"ruby":[[4,2,"さいし"],[12,2,"もんえい"],[15,1,"うた"],[19,1,"もの"],[21,1,"たみ"],[28,2,"ひとびと"],[31,1,"みや"],[33,1,"つか"],[53,1,"みな"],[56,2,"まちまち"],[59,1,"す"],[69,2,"ひとびと"],[74,2,"まちまち"],[77,1,"す"],[81,1,"がつ"]],"text":"こうして祭司、レビびと、門衛、歌うたう者、民のうちのある人々、宮に仕えるしもべたち、およびイスラエルびとは皆その町々に住んだ。イスラエルの人々はその町々に住んで七月になった。"}]