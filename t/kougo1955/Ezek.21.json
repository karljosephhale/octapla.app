[{"ref":"Ezek.21.1","start":26021001,"end":26021001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.21.2","start":26021002,"end":26021002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,1,"かお"],[18,1,"む"],[25,2,"ことば"],[28,2,"せいじょ"],[31,1,"む"],[43,1,"ち"],[45,1,"む"],[49,2,"よげん"]],"text":"「人の子よ、あなたの顔をエルサレムに向け、あなたの言葉を聖所に向けてのべ、イスラエルの地に向かって預言し、"},{"ref":"Ezek.21.3","start":26021003,"end":26021003,"break":"none","ruby":[[6,1,"ち"],[8,1,"い"],[11,1,"しゅ"],[15,1,"い"],[20,1,"み"],[31,1,"せ"],[46,1,"ぬ"],[58,1,"ただ"],[61,1,"もの"],[63,1,"あ"],[66,1,"もの"],[69,1,"た"]],"text":"イスラエルの地に言え。主はこう言われる、見よ、わたしはあなたを攻め、わたしのつるぎをさやから抜き、あなたのうちから、正しい者も悪しき者をも断ってしまう。"},{"ref":"Ezek.21.4","start":26021004,"end":26021004,"break":"none","ruby":[[13,1,"ただ"],[16,1,"もの"],[18,1,"あ"],[21,1,"もの"],[24,1,"た"],[42,1,"ぬ"],[44,1,"で"],[47,1,"みなみ"],[50,1,"きた"],[58,1,"にく"],[61,1,"もの"],[63,1,"せ"]],"text":"わたしがあなたのうちから、正しい者も悪しき者をも断つゆえに、わたしのつるぎはさやから抜け出て、南から北までのすべての肉なる者を攻める。"},{"ref":"Ezek.21.5","start":26021005,"end":26021005,"break":"none","ruby":[[3,1,"にく"],[6,1,"もの"],[9,1,"しゅ"],[27,1,"ぬ"],[29,1,"はな"],[35,1,"し"],[44,1,"ふたた"],[49,1,"おさ"]],"text":"すべて肉なる者は、主なるわたしが、そのつるぎをさやから抜き放ったことを知る。このつるぎは再びさやに納められない。"},{"ref":"Ezek.21.6","start":26021006,"end":26021006,"break":"none","ruby":[[5,1,"ひと"],[7,1,"こ"],[10,1,"なげ"],[13,1,"こころ"],[14,1,"くだ"],[20,1,"なげ"],[23,1,"かれ"],[26,1,"め"],[28,1,"まえ"],[33,1,"なげ"]],"text":"それゆえ、人の子よ、嘆け、心砕けるまでに嘆き、彼らの目の前でいたく嘆け。"},{"ref":"Ezek.21.7","start":26021007,"end":26021007,"break":"none","ruby":[[0,1,"ひと"],[6,1,"む"],[14,1,"なげ"],[20,1,"い"],[28,1,"し"],[41,1,"く"],[44,1,"ひと"],[46,1,"こころ"],[50,1,"と"],[53,1,"て"],[60,1,"れい"],[64,1,"よわ"],[72,1,"みず"],[80,1,"み"],[86,1,"く"],[89,1,"かなら"],[91,2,"じょうじゅ"],[97,1,"い"],[101,1,"しゅ"],[104,1,"かみ"],[106,1,"い"]],"text":"人があなたに向かって、『なぜ嘆くのか』と言うなら、『この知らせのためである。それが来れば人の心はみな溶け、手はみななえ、霊はみな弱り、ひざはみな水のようになる。見よ、それは来る、必ず成就する』と言え」と主なる神は言われる。"},{"ref":"Ezek.21.8","start":26021008,"end":26021008,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.21.9","start":26021009,"end":26021009,"break":"none","breaks":[[22,"stanza"],[29,"line"]],"ruby":[[1,1,"ひと"],[3,1,"こ"],[6,2,"よげん"],[10,1,"い"],[13,1,"しゅ"],[17,1,"い"]],"text":"「人の子よ、預言して言え、主はこう言われる、つるぎがある、とぎ、かつ、みがいたつるぎがある。"},{"ref":"Ezek.21.10","start":26021010,"end":26021010,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"ころ"],[39,1,"よろこ"],[51,1,"こ"],[65,1,"き"],[67,1,"つく"],[74,1,"かろ"]],"text":"殺すためにといであり、いなずまのようにきらめくためにみがいてある。わたしたちは喜ぶことができるか。わが子よ、あなたはつえと、すべて木で作ったものとを軽んじた。"},{"ref":"Ezek.21.11","start":26021011,"end":26021011,"break":"none","ruby":[[6,1,"て"],[18,1,"ころ"],[20,1,"もの"],[22,1,"て"],[24,1,"わた"]],"text":"このつるぎは手にとるために、とがれ、殺す者の手に渡すために、とがれみがかれるのである。"},{"ref":"Ezek.21.12","start":26021012,"end":26021012,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[5,1,"さけ"],[7,1,"なげ"],[17,1,"たみ"],[19,1,"のぞ"],[32,1,"きみ"],[36,1,"のぞ"],[44,1,"かれ"],[49,1,"たみ"],[51,1,"とも"],[75,1,"う"]],"text":"人の子よ、叫び嘆け、このことはわが民に臨み、イスラエルのすべての君たちに臨むからである。彼らはわが民と共につるぎにわたされる。それゆえ、あなたのももを打て。"},{"ref":"Ezek.21.13","start":26021013,"end":26021013,"break":"none","ruby":[[46,1,"しゅ"],[49,1,"かみ"],[51,1,"い"]],"text":"これはためしにすることではない。もしあなたが、つえをあざけったら、どういうことになろうか」と主なる神は言われる。"},{"ref":"Ezek.21.14","start":26021014,"end":26021014,"break":"paragraph","ruby":[[6,1,"ひと"],[8,1,"こ"],[15,2,"よげん"],[19,1,"て"],[21,1,"う"],[32,1,"ど"],[35,1,"ど"],[37,1,"のぞ"],[45,1,"ひと"],[47,1,"ころ"],[53,1,"おお"],[56,1,"ころ"],[66,1,"かれ"],[69,1,"かこ"]],"text":"「それゆえ、人の子よ、あなたは預言し、手を打ちならせ。つるぎを二度も三度も臨ませよ。これは人を殺すつるぎ、大いに殺すつるぎであって、彼らを囲むものである。"},{"ref":"Ezek.21.15","start":26021015,"end":26021015,"break":"none","ruby":[[6,1,"かれ"],[9,1,"こころ"],[11,1,"と"],[14,1,"おお"],[17,1,"もの"],[23,1,"もん"],[25,1,"たお"],[41,1,"かれ"],[44,1,"おく"],[64,1,"ひと"],[66,1,"ころ"]],"text":"これがために彼らの心は溶け、多くの者がすべての門に倒れる。わたしはひらめくつるぎを彼らに送る。ああ、これはいなずまのようになり、人を殺すためにみがかれている。"},{"ref":"Ezek.21.16","start":26021016,"end":26021016,"break":"none","ruby":[[4,1,"は"],[6,1,"む"],[14,1,"みぎ"],[16,1,"ひだり"],[20,1,"たお"]],"text":"あなたの刃の向かうところで、右に左になぎ倒せ。"},{"ref":"Ezek.21.17","start":26021017,"end":26021017,"break":"none","ruby":[[11,1,"て"],[13,1,"う"],[23,1,"いか"],[32,1,"しゅ"],[39,1,"い"]],"text":"わたしもまた、わたしの手を打ちならし、わたしの怒りをしずめると、主なるわたしは言った」。"},{"ref":"Ezek.21.18","start":26021018,"end":26021018,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"]],"text":"主の言葉がまたわたしに臨んだ、"},{"ref":"Ezek.21.19","start":26021019,"end":26021019,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[11,1,"おう"],[17,1,"く"],[26,1,"みち"],[28,1,"そな"],[37,1,"みち"],[42,1,"くに"],[45,1,"で"],[54,1,"みち"],[59,1,"つく"],[65,1,"まち"],[67,1,"む"],[70,1,"みち"],[76,1,"お"]],"text":"「人の子よ、バビロンの王のつるぎが来るために、二つの道を備えよ。この二つの道は一つの国から出ている。あなたは道しるべを作り、これを町に向かう道のはじめに置け。"},{"ref":"Ezek.21.20","start":26021020,"end":26021020,"break":"none","ruby":[[11,2,"ひとびと"],[22,2,"けんご"],[25,1,"しろ"],[27,1,"まち"],[39,1,"く"],[41,1,"みち"],[43,1,"もう"]],"text":"あなたはまたアンモンの人々のラバと、ユダと、堅固な城の町エルサレムとにつるぎの来る道を設けよ。"},{"ref":"Ezek.21.21","start":26021021,"end":26021021,"break":"none","ruby":[[5,1,"おう"],[7,1,"みち"],[9,1,"わか"],[11,1,"め"],[16,1,"みち"],[22,1,"た"],[25,1,"うらな"],[30,1,"や"],[40,1,"と"],[43,1,"きも"],[45,1,"み"]],"text":"バビロンの王は道の分れ目、二つの道のはじめに立って占いをし、矢をふり、テラピムに問い、肝を見る。"},{"ref":"Ezek.21.22","start":26021022,"end":26021022,"break":"none","ruby":[[0,1,"かれ"],[2,1,"みぎ"],[13,1,"うらな"],[16,1,"で"],[23,1,"くち"],[25,1,"ひら"],[28,1,"さけ"],[31,1,"こえ"],[39,1,"つく"],[42,1,"もん"],[44,1,"む"],[48,1,"しろ"],[53,1,"もう"],[56,1,"るい"],[58,1,"きず"],[61,2,"うんてい"],[64,1,"た"],[68,1,"い"]],"text":"彼の右にエルサレムのために占いが出る。すなわち口を開いて叫び、声をあげ、ときを作り、門に向かって城くずしを設け、塁を築き、雲悌を建てよと言う。"},{"ref":"Ezek.21.23","start":26021023,"end":26021023,"break":"none","ruby":[[6,1,"かれ"],[9,1,"め"],[12,1,"いつわ"],[15,1,"うらな"],[18,1,"おも"],[22,1,"かれ"],[25,1,"かた"],[27,1,"ちか"],[37,1,"かれ"],[40,1,"かれ"],[43,1,"とら"],[53,1,"つみ"],[55,1,"おも"],[57,1,"だ"]],"text":"しかしこれは彼らの目には偽りの占いと思われ、彼らは堅き誓いをなした。しかし彼は、彼らを捕えることによって、罪を思い出させる。"},{"ref":"Ezek.21.24","start":26021024,"end":26021024,"break":"paragraph","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[23,1,"つみ"],[25,1,"おぼ"],[32,2,"はんぎゃく"],[35,1,"あらわ"],[40,1,"つみ"],[49,1,"あらわ"],[68,1,"おぼ"],[78,1,"かれ"],[81,1,"て"],[83,1,"とら"]],"text":"それゆえ、主なる神はこう言われる、あなたがたの罪は覚えられ、その反逆は現れ、その罪はすべてのわざに現れる。このようにあなたがたは、すでに覚えられているから、彼らの手に捕えられる。"},{"ref":"Ezek.21.25","start":26021025,"end":26021025,"break":"none","ruby":[[0,1,"けが"],[3,2,"あくにん"],[14,1,"きみ"],[21,1,"おわ"],[24,2,"けいばつ"],[27,1,"とき"],[33,1,"ひ"],[35,1,"く"]],"text":"汚れた悪人であるイスラエルの君よ、あなたの終りの刑罰の時であるその日が来る。"},{"ref":"Ezek.21.26","start":26021026,"end":26021026,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[15,1,"もの"],[17,1,"ぬ"],[20,1,"かんむり"],[22,1,"と"],[24,1,"はな"],[41,1,"のこ"],[46,1,"いや"],[49,1,"もの"],[51,1,"たか"],[56,1,"たか"],[58,1,"もの"],[60,1,"いや"]],"text":"主なる神はこう言われる、かぶり物を脱ぎ、冠を取り離せ。すべてのものは、そのままには残らない。卑しい者は高くされ、高い者は卑しくされる。"},{"ref":"Ezek.21.27","start":26021027,"end":26021027,"break":"none","ruby":[[2,2,"はめつ"],[5,2,"はめつ"],[8,2,"はめつ"],[27,1,"あた"],[30,2,"けんい"],[35,1,"もの"],[37,1,"く"],[39,1,"とき"],[45,2,"あとかた"],[50,1,"のこ"]],"text":"ああ破滅、破滅、破滅、わたしはこれをこさせる。わたしが与える権威をもつ者が来る時まで、その跡形さえも残らない。"},{"ref":"Ezek.21.28","start":26021028,"end":26021028,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[5,2,"よげん"],[9,1,"い"],[12,1,"しゅ"],[15,1,"かみ"],[22,2,"ひとびと"],[39,1,"い"],[57,1,"ころ"],[62,1,"ぬ"]],"text":"人の子よ、預言して言え。主なる神はアンモンの人々と、そのあざけりについて、こう言われる、つるぎがある。このつるぎは殺すために抜かれ、いなずまのようにひかりきらめくようにとがれている。"},{"ref":"Ezek.21.29","start":26021029,"end":26021029,"break":"none","ruby":[[0,1,"かれ"],[7,1,"いつわ"],[10,1,"まぼろし"],[12,1,"しめ"],[15,1,"いつわ"],[18,1,"うらな"],[27,1,"ころ"],[32,1,"あ"],[35,1,"もの"],[37,1,"くび"],[39,1,"うえ"],[41,1,"お"],[46,1,"かれ"],[49,1,"おわ"],[52,2,"けいばつ"],[55,1,"とき"],[61,1,"ひ"]],"text":"彼らがあなたに偽りの幻を示し、偽りを占ったゆえ、これは殺さるべき悪しき者の首の上に置かれる。彼らの終りの刑罰の時であるその日がきている。"},{"ref":"Ezek.21.30","start":26021030,"end":26021030,"break":"none","ruby":[[6,1,"おさ"],[18,1,"つく"],[22,1,"ところ"],[28,1,"うま"],[31,1,"ち"]],"text":"これをさやに納めよ、わたしはあなたの造られた所、あなたの生れた地であなたをさばく。"},{"ref":"Ezek.21.31","start":26021031,"end":26021031,"break":"none","ruby":[[4,1,"いか"],[11,1,"そそ"],[18,1,"いきどお"],[21,1,"ひ"],[27,1,"む"],[30,1,"も"],[34,1,"ほろ"],[40,1,"たく"],[43,2,"ざんにん"],[46,1,"ひと"],[48,1,"て"],[54,1,"わた"]],"text":"わたしの怒りをあなたに注ぎ、わたしの憤りの火をあなたに向けて燃やし、滅ぼすことに巧みな残忍な人の手にあなたを渡す。"},{"ref":"Ezek.21.32","start":26021032,"end":26021032,"break":"none","ruby":[[4,1,"ひ"],[21,1,"ち"],[23,1,"くに"],[25,1,"なか"],[27,1,"なが"],[31,1,"おぼ"],[42,1,"しゅ"],[49,1,"い"]],"text":"あなたは火のための、たきぎとなり、あなたの血は国の中に流され、覚えられることはない、主なるわたしが言う」。"}]