[{"ref":"Num.10.1","start":4010001,"end":4010001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.10.2","start":4010002,"end":4010002,"break":"none","ruby":[[1,1,"ぎん"],[8,1,"ほん"],[21,2,"うちもの"],[23,1,"つく"],[31,2,"かいしゅう"],[34,1,"よ"],[36,1,"あつ"],[41,2,"しゅくえい"],[44,1,"すす"]],"text":"「銀のラッパを二本つくりなさい。すなわち、打物造りとし、それで会衆を呼び集め、また宿営を進ませなさい。"},{"ref":"Num.10.3","start":4010003,"end":4010003,"break":"none","ruby":[[5,1,"ふ"],[11,1,"ぜん"],[12,2,"かいしゅう"],[15,2,"かいけん"],[18,2,"まくや"],[21,2,"いりぐち"],[29,1,"ところ"],[31,1,"あつ"]],"text":"この二つを吹くときは、全会衆が会見の幕屋の入口に、あなたの所に集まってこなければならない。"},{"ref":"Num.10.4","start":4010004,"end":4010004,"break":"none","ruby":[[9,1,"ふ"],[21,2,"しぞく"],[24,1,"ちょう"],[39,1,"ところ"],[41,1,"あつ"]],"text":"もしその一つだけを吹くときは、イスラエルの氏族の長であるつかさたちが、あなたの所に集まってこなければならない。"},{"ref":"Num.10.5","start":4010005,"end":4010005,"break":"none","ruby":[[8,2,"けいほう"],[11,1,"ふ"],[13,1,"な"],[16,1,"とき"],[19,1,"ひがし"],[21,1,"ほう"],[23,2,"しゅくえい"],[27,1,"みち"],[29,1,"すす"]],"text":"またあなたがたが警報を吹き鳴らす時は、東の方の宿営が、道に進まなければならない。"},{"ref":"Num.10.6","start":4010006,"end":4010006,"break":"none","ruby":[[1,2,"どめ"],[4,2,"けいほう"],[7,1,"ふ"],[9,1,"な"],[12,1,"とき"],[15,1,"みなみ"],[17,1,"ほう"],[19,2,"しゅくえい"],[23,1,"みち"],[25,1,"すす"],[39,1,"みち"],[41,1,"すす"],[43,1,"とき"],[46,2,"けいほう"],[49,1,"ふ"],[51,1,"な"]],"text":"二度目の警報を吹き鳴らす時は、南の方の宿営が、道に進まなければならない。すべて道に進む時は、警報を吹き鳴らさなければならない。"},{"ref":"Num.10.7","start":4010007,"end":4010007,"break":"none","ruby":[[2,2,"かいしゅう"],[5,1,"あつ"],[8,1,"とき"],[16,1,"ふ"],[18,1,"な"],[23,2,"けいほう"],[26,1,"ふ"],[28,1,"な"]],"text":"また会衆を集める時にも、ラッパを吹き鳴らすが、警報は吹き鳴らしてはならない。"},{"ref":"Num.10.8","start":4010008,"end":4010008,"break":"none","ruby":[[4,1,"こ"],[8,2,"さいし"],[18,1,"ふ"],[39,2,"よよ"],[44,1,"まも"],[48,1,"さだ"]],"text":"アロンの子である祭司たちが、ラッパを吹かなければならない。これはあなたがたが、代々ながく守るべき定めとしなければならない。"},{"ref":"Num.10.9","start":4010009,"end":4010009,"break":"none","ruby":[[9,1,"くに"],[27,1,"たたか"],[30,1,"で"],[32,1,"とき"],[43,2,"けいほう"],[46,1,"ふ"],[48,1,"な"],[81,1,"かみ"],[83,1,"しゅ"],[85,1,"おぼ"],[97,1,"てき"],[100,1,"すく"]],"text":"また、あなたがたの国で、あなたがたをしえたげるあだとの戦いに出る時は、ラッパをもって、警報を吹き鳴らさなければならない。そうするならば、あなたがたは、あなたがたの神、主に覚えられて、あなたがたの敵から救われるであろう。"},{"ref":"Num.10.10","start":4010010,"end":4010010,"break":"none","ruby":[[9,1,"よろこ"],[12,1,"ひ"],[20,1,"いわ"],[23,1,"とき"],[28,2,"つきづき"],[31,1,"だい"],[33,1,"にち"],[43,2,"はんさい"],[46,3,"しゅうおんさい"],[50,2,"ぎせい"],[58,1,"あた"],[66,1,"ふ"],[68,1,"な"],[94,1,"かみ"],[110,1,"おぼ"],[130,1,"かみ"],[132,1,"しゅ"]],"text":"また、あなたがたの喜びの日、あなたがたの祝いの時、および月々の第一日には、あなたがたの燔祭と酬恩祭の犠牲をささげるに当って、ラッパを吹き鳴らさなければならない。そうするならば、あなたがたの神は、それによって、あなたがたを覚えられるであろう。わたしはあなたがたの神、主である」。"},{"ref":"Num.10.11","start":4010011,"end":4010011,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"ねん"],[5,1,"にがつ"],[6,3,"はつか"],[11,1,"くも"],[17,2,"まくや"],[20,1,"はな"]],"text":"第二年の二月二十日に、雲があかしの幕屋を離れてのぼったので、"},{"ref":"Num.10.12","start":4010012,"end":4010012,"break":"none","ruby":[[6,2,"ひとびと"],[14,2,"あらの"],[17,1,"で"],[22,2,"たびじ"],[25,1,"すす"],[34,2,"あらの"],[37,1,"いた"],[41,1,"くも"]],"text":"イスラエルの人々は、シナイの荒野を出て、その旅路に進んだが、パランの荒野に至って、雲はとどまった。"},{"ref":"Num.10.13","start":4010013,"end":4010013,"break":"none","ruby":[[4,1,"かれ"],[8,1,"しゅ"],[18,1,"めい"],[33,1,"みち"],[35,1,"すす"],[40,1,"はじ"]],"text":"こうして彼らは、主がモーセによって、命じられたところにしたがって、道に進むことを始めた。"},{"ref":"Num.10.14","start":4010014,"end":4010014,"break":"none","ruby":[[0,2,"せんとう"],[8,1,"こ"],[12,2,"しゅくえい"],[15,1,"はた"],[20,2,"ぶたい"],[23,1,"したが"],[26,1,"すす"],[33,2,"ぶたい"],[36,1,"ちょう"],[44,1,"こ"]],"text":"先頭には、ユダの子たちの宿営の旗が、その部隊を従えて進んだ。ユダの部隊の長はアミナダブの子ナション、"},{"ref":"Num.10.15","start":4010015,"end":4010015,"break":"none","ruby":[[6,1,"こ"],[10,2,"ぶぞく"],[13,2,"ぶたい"],[16,1,"ちょう"],[22,1,"こ"]],"text":"イッサカルの子たちの部族の部隊の長はツアルの子ネタニエル、"},{"ref":"Num.10.16","start":4010016,"end":4010016,"break":"none","ruby":[[5,1,"こ"],[9,2,"ぶぞく"],[12,2,"ぶたい"],[15,1,"ちょう"],[21,1,"こ"]],"text":"ゼブルンの子たちの部族の部隊の長はヘロンの子エリアブであった。"},{"ref":"Num.10.17","start":4010017,"end":4010017,"break":"paragraph","ruby":[[3,2,"まくや"],[6,1,"と"],[19,1,"こ"],[30,1,"こ"],[34,2,"まくや"],[37,1,"はこ"],[39,1,"すす"]],"text":"そして幕屋は取りくずされ、ゲルションの子たち、およびメラリの子たちは幕屋を運び進んだ。"},{"ref":"Num.10.18","start":4010018,"end":4010018,"break":"none","ruby":[[0,1,"つぎ"],[6,2,"しゅくえい"],[9,1,"はた"],[14,2,"ぶたい"],[17,1,"したが"],[20,1,"すす"],[28,2,"ぶたい"],[31,1,"ちょう"],[38,1,"こ"]],"text":"次にルベンの宿営の旗が、その部隊を従えて進んだ。ルベンの部隊の長はシデウルの子エリヅル、"},{"ref":"Num.10.19","start":4010019,"end":4010019,"break":"none","ruby":[[5,1,"こ"],[9,2,"ぶぞく"],[12,2,"ぶたい"],[15,1,"ちょう"],[24,1,"こ"]],"text":"シメオンの子たちの部族の部隊の長はツリシャダイの子シルミエル、"},{"ref":"Num.10.20","start":4010020,"end":4010020,"break":"none","ruby":[[3,1,"こ"],[7,2,"ぶぞく"],[10,2,"ぶたい"],[13,1,"ちょう"],[20,1,"こ"]],"text":"ガドの子たちの部族の部隊の長はデウエルの子エリアサフであった。"},{"ref":"Num.10.21","start":4010021,"end":4010021,"break":"paragraph","ruby":[[9,1,"せい"],[12,1,"もの"],[14,1,"はこ"],[16,1,"すす"],[23,1,"つ"],[29,2,"ひとびと"],[32,2,"まくや"],[35,1,"た"],[37,1,"おわ"]],"text":"そしてコハテびとは聖なる物を運び進んだ。これが着くまでに、人々は幕屋を建て終るのである。"},{"ref":"Num.10.22","start":4010022,"end":4010022,"break":"none","ruby":[[0,1,"つぎ"],[8,1,"こ"],[12,2,"しゅくえい"],[15,1,"はた"],[20,2,"ぶたい"],[23,1,"したが"],[26,1,"すす"],[36,2,"ぶたい"],[39,1,"ちょう"],[46,1,"こ"]],"text":"次にエフライムの子たちの宿営の旗が、その部隊を従えて進んだ。エフライムの部隊の長はアミホデの子エリシャマ、"},{"ref":"Num.10.23","start":4010023,"end":4010023,"break":"none","ruby":[[4,1,"こ"],[8,2,"ぶぞく"],[11,2,"ぶたい"],[14,1,"ちょう"],[21,1,"こ"]],"text":"マナセの子たちの部族の部隊の長はパダヅルの子ガマリエル、"},{"ref":"Num.10.24","start":4010024,"end":4010024,"break":"none","ruby":[[6,1,"こ"],[10,2,"ぶぞく"],[13,2,"ぶたい"],[16,1,"ちょう"],[23,1,"こ"]],"text":"ベニヤミンの子たちの部族の部隊の長はギデオニの子アビダンであった。"},{"ref":"Num.10.25","start":4010025,"end":4010025,"break":"paragraph","ruby":[[0,1,"つぎ"],[5,1,"こ"],[9,2,"しゅくえい"],[12,1,"はた"],[17,2,"ぶたい"],[20,1,"したが"],[23,1,"すす"],[29,2,"ぶたい"],[36,2,"しゅくえい"],[51,2,"ぶたい"],[54,1,"ちょう"],[63,1,"こ"]],"text":"次にダンの子たちの宿営の旗が、その部隊を従えて進んだ。この部隊はすべての宿営のしんがりであった。ダンの部隊の長はアミシャダイの子アヒエゼル、"},{"ref":"Num.10.26","start":4010026,"end":4010026,"break":"none","ruby":[[4,1,"こ"],[8,2,"ぶぞく"],[11,2,"ぶたい"],[14,1,"ちょう"],[21,1,"こ"]],"text":"アセルの子たちの部族の部隊の長はオクランの子パギエル、"},{"ref":"Num.10.27","start":4010027,"end":4010027,"break":"none","ruby":[[5,1,"こ"],[9,2,"ぶぞく"],[12,2,"ぶたい"],[15,1,"ちょう"],[21,1,"こ"]],"text":"ナフタリの子たちの部族の部隊の長はエナンの子アヒラであった。"},{"ref":"Num.10.28","start":4010028,"end":4010028,"break":"none","ruby":[[6,2,"ひとびと"],[12,1,"みち"],[14,1,"すす"],[16,1,"とき"],[27,2,"ぶたい"],[30,1,"したが"],[33,1,"すす"]],"text":"イスラエルの人々が、その道に進む時は、このように、その部隊に従って進んだ。"},{"ref":"Num.10.29","start":4010029,"end":4010029,"break":"paragraph","ruby":[[8,1,"つま"],[10,1,"ちち"],[23,1,"こ"],[28,1,"い"],[43,1,"しゅ"],[51,1,"あた"],[55,2,"やくそく"],[60,1,"ところ"],[62,1,"む"],[66,1,"すす"],[77,2,"いっしょ"],[92,2,"こうふく"],[110,1,"しゅ"],[118,2,"こうふく"],[121,2,"やくそく"]],"text":"さて、モーセは、妻の父、ミデヤンびとリウエルの子ホバブに言った、「わたしたちは、かつて主がおまえたちに与えると約束された所に向かって進んでいます。あなたも一緒においでください。あなたが幸福になられるようにいたしましょう。主がイスラエルに幸福を約束されたのですから」。"},{"ref":"Num.10.30","start":4010030,"end":4010030,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[15,1,"い"],[25,1,"くに"],[27,1,"かえ"],[31,2,"しんぞく"],[37,1,"い"]],"text":"彼はモーセに言った、「わたしは行きません。わたしは国に帰って、親族のもとに行きます」。"},{"ref":"Num.10.31","start":4010031,"end":4010031,"break":"none","ruby":[[6,1,"い"],[20,2,"みす"],[42,2,"あらの"],[48,2,"しゅくえい"],[55,2,"ごぞん"],[69,1,"め"]],"text":"モーセはまた言った、「どうかわたしたちを見捨てないでください。あなたは、わたしたちが荒野のどこに宿営すべきかを御存じですから、わたしたちの目となってください。"},{"ref":"Num.10.32","start":4010032,"end":4010032,"break":"none","ruby":[[6,2,"いっしょ"],[19,1,"しゅ"],[27,1,"たま"],[30,2,"こうふく"],[38,1,"およ"]],"text":"もしあなたが一緒においでくださるなら、主がわたしたちに賜わる幸福をあなたにも及ぼしましょう」。"},{"ref":"Num.10.33","start":4010033,"end":4010033,"break":"paragraph","ruby":[[4,1,"かれ"],[7,1,"しゅ"],[9,1,"やま"],[11,1,"さ"],[16,1,"か"],[18,2,"こうてい"],[21,1,"すす"],[25,1,"しゅ"],[27,2,"けいやく"],[30,1,"はこ"],[36,1,"か"],[38,2,"こうてい"],[41,1,"あいだ"],[43,1,"かれ"],[46,2,"さきだ"],[50,1,"い"],[53,1,"かれ"],[59,1,"やす"],[61,1,"ところ"],[63,1,"たず"]],"text":"こうして彼らは主の山を去って、三日の行程を進んだ。主の契約の箱は、その三日の行程の間、彼らに先立って行き、彼らのために休む所を尋ねもとめた。"},{"ref":"Num.10.34","start":4010034,"end":4010034,"break":"none","ruby":[[0,1,"かれ"],[3,2,"しゅくえい"],[6,1,"で"],[9,1,"みち"],[11,1,"すす"],[16,1,"ひる"],[18,1,"しゅ"],[20,1,"くも"],[22,1,"かれ"],[25,1,"うえ"]],"text":"彼らが宿営を出て、道に進むとき、昼は主の雲が彼らの上にあった。"},{"ref":"Num.10.35","start":4010035,"end":4010035,"break":"paragraph","breaks":[[17,"stanza"],[32,"line"],[45,"line"],[56,"line"]],"ruby":[[0,2,"けいやく"],[3,1,"はこ"],[5,1,"すす"],[13,1,"い"],[18,1,"しゅ"],[21,1,"た"],[36,1,"てき"],[38,1,"う"],[40,1,"ち"],[49,1,"にく"],[51,1,"もの"],[60,1,"まえ"],[63,1,"に"],[65,1,"さ"]],"text":"契約の箱の進むときモーセは言った、「主よ、立ちあがってください。あなたの敵は打ち散らされ、あなたを憎む者どもは、あなたの前から逃げ去りますように」。"},{"ref":"Num.10.36","start":4010036,"end":4010036,"break":"none","breaks":[[17,"stanza"],[31,"line"]],"ruby":[[11,1,"かれ"],[13,1,"い"],[18,1,"しゅ"],[21,1,"かえ"],[42,1,"ひと"]],"text":"またそのとどまるとき、彼は言った、「主よ、帰ってきてください、イスラエルのちよろずの人に」。"}]