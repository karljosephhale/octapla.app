[{"ref":"Jer.1.1","start":24001001,"end":24001001,"break":"paragraph","ruby":[[6,1,"ち"],[12,2,"さいし"],[27,1,"こ"],[33,2,"ことば"]],"text":"ベニヤミンの地アナトテの祭司のひとりである、ヒルキヤの子エレミヤの言葉。"},{"ref":"Jer.1.2","start":24001002,"end":24001002,"break":"none","ruby":[[4,1,"こ"],[9,1,"おう"],[14,1,"とき"],[22,2,"ちせい"],[27,1,"ねん"],[30,1,"しゅ"],[32,2,"ことば"],[40,1,"のぞ"]],"text":"アモンの子、ユダの王ヨシヤの時、すなわちその治世の十三年に、主の言葉がエレミヤに臨んだ。"},{"ref":"Jer.1.3","start":24001003,"end":24001003,"break":"none","ruby":[[2,2,"ことば"],[11,1,"こ"],[16,1,"おう"],[23,1,"とき"],[26,1,"のぞ"],[34,1,"こ"],[39,1,"おう"],[47,1,"ねん"],[49,1,"おわ"],[58,1,"ねん"],[61,1,"がつ"],[69,1,"たみ"],[71,1,"とら"],[73,1,"うつ"],[77,1,"とき"],[81,1,"およ"]],"text":"その言葉はまたヨシヤの子、ユダの王エホヤキムの時にも臨んで、ヨシヤの子、ユダの王ゼデキヤの十一年の終り、すなわちその年の五月にエルサレムの民が捕え移された時にまで及んだ。"},{"ref":"Jer.1.4","start":24001004,"end":24001004,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"],[12,1,"い"]],"text":"主の言葉がわたしに臨んで言う、"},{"ref":"Jer.1.5","start":24001005,"end":24001005,"break":"stanza","breaks":[[24,"line"],[31,"line"],[45,"line"],[53,"line"]],"ruby":[[11,1,"はは"],[13,1,"たい"],[28,1,"し"],[37,1,"うま"],[49,2,"せいべつ"],[57,1,"た"],[60,2,"ばんこく"],[63,3,"よげんしゃ"]],"text":"「わたしはあなたをまだ母の胎につくらないさきに、あなたを知り、あなたがまだ生れないさきに、あなたを聖別し、あなたを立てて万国の預言者とした」。"},{"ref":"Jer.1.6","start":24001006,"end":24001006,"break":"none","ruby":[[2,1,"とき"],[7,1,"い"],[15,1,"しゅ"],[18,1,"かみ"],[27,2,"わかもの"],[39,1,"かた"],[45,1,"し"]],"text":"その時わたしは言った、「ああ、主なる神よ、わたしはただ若者にすぎず、どのように語ってよいか知りません」。"},{"ref":"Jer.1.7","start":24001007,"end":24001007,"break":"none","breaks":[[14,"stanza"],[38,"line"],[60,"line"]],"ruby":[[3,1,"しゅ"],[9,1,"い"],[21,2,"わかもの"],[29,1,"い"],[55,1,"ひと"],[57,1,"い"],[64,1,"めい"],[72,1,"かた"]],"text":"しかし主はわたしに言われた、「あなたはただ若者にすぎないと言ってはならない。だれにでも、すべてわたしがつかわす人へ行き、あなたに命じることをみな語らなければならない。"},{"ref":"Jer.1.8","start":24001008,"end":24001008,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おそ"],[20,1,"とも"],[29,1,"すく"],[38,1,"しゅ"],[40,1,"おお"]],"text":"彼らを恐れてはならない、わたしがあなたと共にいて、あなたを救うからである」と主は仰せられる。"},{"ref":"Jer.1.9","start":24001009,"end":24001009,"break":"none","breaks":[[32,"stanza"]],"ruby":[[3,1,"しゅ"],[6,1,"て"],[8,1,"の"],[16,1,"くち"],[21,1,"しゅ"],[27,1,"い"],[33,1,"み"],[40,2,"ことば"],[47,1,"くち"],[49,1,"い"]],"text":"そして主はみ手を伸べて、わたしの口につけ、主はわたしに言われた、「見よ、わたしの言葉をあなたの口に入れた。"},{"ref":"Jer.1.10","start":24001010,"end":24001010,"break":"line","breaks":[[11,"line"],[29,"line"],[49,"line"],[64,"line"]],"ruby":[[0,1,"み"],[15,2,"ばんみん"],[18,1,"うえ"],[21,2,"ばんこく"],[24,1,"うえ"],[26,1,"た"],[38,1,"ぬ"],[53,1,"ほろ"],[61,1,"たお"],[68,1,"た"],[75,1,"う"]],"text":"見よ、わたしはきょう、あなたを万民の上と、万国の上に立て、あなたに、あるいは抜き、あるいはこわし、あるいは滅ぼし、あるいは倒し、あるいは建て、あるいは植えさせる」。"},{"ref":"Jer.1.11","start":24001011,"end":24001011,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"],[14,1,"い"],[28,1,"なに"],[30,1,"み"],[39,1,"こた"],[50,1,"えだ"],[52,1,"み"]],"text":"主の言葉がまたわたしに臨んで言う、「エレミヤよ、あなたは何を見るか」。わたしは答えた、「あめんどうの枝を見ます」。"},{"ref":"Jer.1.12","start":24001012,"end":24001012,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"み"],[27,2,"じぶん"],[30,2,"ことば"],[33,1,"おこな"],[39,2,"みは"]],"text":"主はわたしに言われた、「あなたの見たとおりだ。わたしは自分の言葉を行おうとして見張っているのだ」。"},{"ref":"Jer.1.13","start":24001013,"end":24001013,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[13,1,"のぞ"],[16,1,"い"],[24,1,"なに"],[26,1,"み"],[35,1,"こた"],[40,1,"に"],[42,1,"た"],[50,1,"み"],[54,1,"きた"],[61,1,"む"]],"text":"主の言葉がふたたびわたしに臨んで言う、「あなたは何を見るか」。わたしは答えた、「煮え立っているなべを見ます。北からこちらに向かっています」。"},{"ref":"Jer.1.14","start":24001014,"end":24001014,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"わざわい"],[14,1,"きた"],[17,1,"た"],[23,1,"ち"],[25,1,"す"],[31,1,"もの"],[33,1,"うえ"],[35,1,"のぞ"]],"text":"主はわたしに言われた、「災が北から起って、この地に住むすべての者の上に臨む」。"},{"ref":"Jer.1.15","start":24001015,"end":24001015,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"み"],[15,1,"きた"],[17,2,"くにぐに"],[24,1,"たみ"],[26,1,"よ"],[29,1,"かれ"],[32,1,"き"],[41,1,"もん"],[43,2,"いりぐち"],[47,2,"しゅうい"],[54,2,"じょうへき"],[67,2,"まちまち"],[70,1,"む"],[81,1,"ざ"],[83,1,"もう"]],"text":"主は言われる、「見よ、わたしは北の国々のすべての民を呼ぶ。彼らは来て、エルサレムの門の入口と、周囲のすべての城壁、およびユダのすべての町々に向かって、おのおのその座を設ける。"},{"ref":"Jer.1.16","start":24001016,"end":24001016,"break":"none","ruby":[[5,1,"かれ"],[12,1,"す"],[20,2,"あくじ"],[23,1,"おこな"],[38,1,"かれ"],[41,1,"つ"],[45,1,"かれ"],[48,1,"た"],[50,2,"かみがみ"],[53,1,"こう"],[58,2,"じぶん"],[61,1,"て"],[63,1,"つく"],[66,1,"もの"],[68,1,"はい"]],"text":"わたしは、彼らがわたしを捨てて、すべての悪事を行ったゆえに、わたしのさばきを彼らに告げる。彼らは他の神々に香をたき、自分の手で作った物を拝したのである。"},{"ref":"Jer.1.17","start":24001017,"end":24001017,"break":"none","ruby":[[7,1,"こし"],[9,1,"おび"],[12,1,"た"],[19,1,"めい"],[26,1,"こと"],[28,1,"かれ"],[31,1,"つ"],[35,1,"かれ"],[38,1,"おそ"],[57,1,"かれ"],[60,1,"まえ"]],"text":"しかしあなたは腰に帯して立ち、わたしが命じるすべての事を彼らに告げよ。彼らを恐れてはならない。さもないと、わたしは彼らの前であなたをあわてさせる。"},{"ref":"Jer.1.18","start":24001018,"end":24001018,"break":"none","ruby":[[0,1,"み"],[13,2,"ぜんこく"],[20,1,"おう"],[32,2,"さいし"],[38,1,"ち"],[40,1,"たみ"],[42,1,"まえ"],[49,1,"かた"],[51,1,"しろ"],[53,1,"てつ"],[55,1,"はしら"],[57,2,"せいどう"],[60,2,"じょうへき"]],"text":"見よ、わたしはきょう、この全国と、ユダの王と、そのつかさと、その祭司と、その地の民の前に、あなたを堅き城、鉄の柱、青銅の城壁とする。"},{"ref":"Jer.1.19","start":24001019,"end":24001019,"break":"none","ruby":[[0,1,"かれ"],[7,1,"たたか"],[15,1,"か"],[33,1,"とも"],[42,1,"すく"],[51,1,"しゅ"],[53,1,"い"]],"text":"彼らはあなたと戦うが、あなたに勝つことはできない。わたしがあなたと共にいて、あなたを救うからである」と主は言われる。"}]