[{"ref":"Ps.13.1","start":19013001,"end":19013001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[13,"line"],[33,"line"]],"ruby":[[0,1,"しゅ"],[23,1,"わす"],[39,1,"かお"],[45,1,"かく"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"主よ、いつまでなのですか。とこしえにわたしをお忘れになるのですか。いつまで、み顔をわたしに隠されるのですか。"},{"ref":"Ps.13.2","start":19013002,"end":19013002,"break":"line","breaks":[[23,"line"],[43,"line"]],"ruby":[[9,1,"たましい"],[11,1,"いた"],[14,1,"お"],[21,1,"こころ"],[23,1,"かな"],[47,1,"てき"],[53,1,"うえ"]],"text":"いつまで、わたしは魂に痛みを負い、ひねもす心に悲しみをいだかなければならないのですか。いつまで敵はわたしの上にあがめられるのですか。"},{"ref":"Ps.13.3","start":19013003,"end":19013003,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[2,1,"かみ"],[4,1,"しゅ"],[18,1,"こた"],[25,1,"め"],[27,1,"あき"],[48,1,"し"],[50,1,"ねむ"],[53,1,"おちい"]],"text":"わが神、主よ、みそなわして、わたしに答え、わたしの目を明らかにしてください。さもないと、わたしは死の眠りに陥り、"},{"ref":"Ps.13.4","start":19013004,"end":19013004,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"てき"],[11,1,"てき"],[13,1,"か"],[18,1,"い"],[33,1,"うご"],[44,1,"よろこ"]],"text":"わたしの敵は「わたしは敵に勝った」と言い、わたしのあだは、わたしの動かされることによって喜ぶでしょう。"},{"ref":"Ps.13.5","start":19013005,"end":19013005,"break":"line","breaks":[[21,"line"]],"ruby":[[17,2,"しんらい"],[25,1,"こころ"],[31,1,"すくい"],[33,1,"よろこ"]],"text":"しかしわたしはあなたのいつくしみに信頼し、わたしの心はあなたの救を喜びます。"},{"ref":"Ps.13.6","start":19013006,"end":19013006,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ゆた"],[22,1,"しゅ"],[28,1,"うた"]],"text":"主は豊かにわたしをあしらわれたゆえ、わたしは主にむかって歌います。"}]