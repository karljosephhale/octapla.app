[{"ref":"Ezek.30.1","start":26030001,"end":26030001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.30.2","start":26030002,"end":26030002,"break":"none","breaks":[[25,"stanza"]],"ruby":[[1,1,"ひと"],[3,1,"こ"],[6,2,"よげん"],[10,1,"い"],[13,1,"しゅ"],[16,1,"かみ"],[20,1,"い"],[25,1,"なげ"],[30,1,"ひ"]],"text":"「人の子よ、預言して言え、主なる神はこう言われる、嘆け、その日はわざわいだ。"},{"ref":"Ezek.30.3","start":26030003,"end":26030003,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"ひ"],[4,1,"ちか"],[7,1,"しゅ"],[9,1,"ひ"],[11,1,"ちか"],[17,1,"くも"],[19,1,"ひ"],[21,3,"いほうじん"],[25,1,"ほろ"],[28,1,"とき"]],"text":"その日は近い、主の日は近い。これは雲の日、異邦人の滅びの時である。"},{"ref":"Ezek.30.4","start":26030004,"end":26030004,"break":"line","breaks":[[12,"line"],[28,"line"],[42,"line"]],"ruby":[[9,1,"のぞ"],[17,1,"ころ"],[21,1,"もの"],[23,1,"たお"],[26,1,"とき"],[35,1,"くる"],[44,2,"ざいほう"],[47,1,"うば"],[49,1,"さ"],[55,1,"もとい"],[57,1,"やぶ"]],"text":"つるぎがエジプトに臨む。エジプトで殺される者の倒れる時、エチオピヤには苦しみがあり、その財宝は奪い去られ、その基は破られる。"},{"ref":"Ezek.30.5","start":26030005,"end":26030005,"break":"none","ruby":[[23,2,"どうめい"],[25,1,"くに"],[27,2,"ひとびと"],[31,1,"かれ"],[34,1,"とも"],[40,1,"たお"]],"text":"エチオピヤ、プテ、ルデ、アラビヤ、リビヤおよび同盟国の人々は、彼らと共につるぎに倒れる。"},{"ref":"Ezek.30.6","start":26030006,"end":26030006,"break":"stanza","breaks":[[9,"line"],[22,"line"],[32,"line"],[44,"line"],[63,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[14,1,"たす"],[17,1,"もの"],[19,1,"たお"],[24,1,"ほこ"],[26,1,"ちから"],[44,2,"ひとびと"],[59,1,"たお"],[63,1,"しゅ"],[66,1,"かみ"],[68,1,"い"]],"text":"主はこう言われる、エジプトを助ける者は倒れ、その誇る力はうせる。ミグドルからスエネまで、人々はつるぎによってそのうちに倒れると主なる神が言われる。"},{"ref":"Ezek.30.7","start":26030007,"end":26030007,"break":"line","breaks":[[21,"line"]],"ruby":[[3,1,"あ"],[7,1,"あ"],[12,2,"くにぐに"],[23,2,"まちまち"],[26,1,"あ"],[29,2,"まちまち"]],"text":"それは荒れて、荒れはてた国々のうちにあり、その町々は荒れた町々のうちにある。"},{"ref":"Ezek.30.8","start":26030008,"end":26030008,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[9,1,"ひ"],[11,1,"おく"],[17,1,"たす"],[20,1,"もの"],[22,1,"みな"],[23,1,"ほろ"],[26,1,"とき"],[28,1,"かれ"],[35,1,"しゅ"],[42,1,"し"]],"text":"わたしがエジプトに火を送り、これを助ける者が皆滅びる時、彼らはわたしが主であることを知る。"},{"ref":"Ezek.30.9","start":26030009,"end":26030009,"break":"paragraph","ruby":[[2,1,"ひ"],[4,2,"はやあし"],[7,2,"ししゃ"],[15,1,"で"],[18,2,"なにごと"],[21,1,"し"],[32,1,"おそ"],[48,1,"ほろ"],[51,1,"ひ"],[54,1,"かれ"],[57,1,"くる"],[61,1,"く"],[64,1,"み"],[74,1,"く"]],"text":"その日、早足の使者がわたしから出て、何事も知らぬエチオピヤびとを恐れさせる。そしてかのエジプトの滅びの日に、彼らに苦しみが来る。見よ、これはかならず来る。"},{"ref":"Ezek.30.10","start":26030010,"end":26030010,"break":"stanza","breaks":[[12,"line"],[35,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[21,1,"おう"],[30,1,"て"],[40,1,"とみ"],[42,1,"ほろ"]],"text":"主なる神はこう言われる、わたしはバビロンの王ネブカデレザルの手によってエジプトの富を滅ぼす。"},{"ref":"Ezek.30.11","start":26030011,"end":26030011,"break":"line","breaks":[[20,"line"],[39,"line"],[58,"line"]],"ruby":[[0,1,"かれ"],[2,1,"かれ"],[4,1,"したが"],[8,1,"たみ"],[14,2,"こくみん"],[20,1,"もっと"],[22,1,"おそ"],[26,1,"もの"],[33,1,"ち"],[35,1,"ほろ"],[39,1,"かれ"],[46,1,"ぬ"],[55,1,"せ"],[58,1,"ころ"],[61,1,"もの"],[63,1,"くに"],[65,1,"み"]],"text":"彼と彼に従うその民、すなわち国民のうちの最も恐るべき者がきて、その地を滅ぼす。彼らはつるぎを抜いて、エジプトを攻め、殺した者を国に満たす。"},{"ref":"Ezek.30.12","start":26030012,"end":26030012,"break":"line","breaks":[[13,"line"],[27,"line"],[49,"line"]],"ruby":[[7,1,"がわ"],[15,1,"くに"],[17,1,"あ"],[20,1,"もの"],[22,1,"て"],[24,1,"う"],[27,3,"いほうじん"],[31,1,"て"],[36,1,"くに"],[40,1,"なか"],[46,1,"あら"],[49,1,"しゅ"],[59,1,"い"]],"text":"わたしはナイル川をからし、その国を悪しき者の手に売り、異邦人の手によって国とその中のものとを荒す。主なるわたしはこれを言った。"},{"ref":"Ezek.30.13","start":26030013,"end":26030013,"break":"line","breaks":[[12,"line"],[35,"line"],[57,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[16,2,"ぐうぞう"],[28,2,"ぐうぞう"],[31,1,"ほろ"],[40,1,"くに"],[47,1,"きみ"],[50,1,"もの"],[66,1,"くに"],[68,1,"おそ"],[71,1,"あた"]],"text":"主なる神はこう言われる、わたしは偶像をこわし、メンピスで偶像を滅ぼす。エジプトの国には、もはや君たる者がなくなる。わたしはエジプトの国に恐れを与える。"},{"ref":"Ezek.30.14","start":26030014,"end":26030014,"break":"line","breaks":[[12,"line"],[21,"line"]],"ruby":[[9,1,"あら"],[16,1,"ひ"],[18,1,"はな"]],"text":"わたしはパテロスを荒し、ゾアンに火を放ち、テーベにさばきをおこない、"},{"ref":"Ezek.30.15","start":26030015,"end":26030015,"break":"line","breaks":[[8,"line"],[27,"line"]],"ruby":[[4,1,"いか"],[13,2,"ようがい"],[24,1,"そそ"],[31,2,"ぐんしゅう"],[34,1,"た"]],"text":"わたしの怒りを、エジプトの要害であるペルシゥムに注ぎ、テーベの群衆を断ち、"},{"ref":"Ezek.30.16","start":26030016,"end":26030016,"break":"line","breaks":[[10,"line"],[23,"line"],[33,"line"]],"ruby":[[5,1,"ひ"],[7,1,"くだ"],[19,1,"くる"],[27,1,"う"],[29,1,"やぶ"],[35,2,"じょうへき"],[38,2,"はかい"]],"text":"エジプトに火を下す。ペルシゥムはいたく苦しみ、テーベは打ち破られ、その城壁は破壊され、"},{"ref":"Ezek.30.17","start":26030017,"end":26030017,"break":"line","breaks":[[18,"line"]],"ruby":[[8,2,"わかもの"],[15,1,"たお"],[18,1,"おんな"],[22,1,"とら"],[24,1,"うつ"]],"text":"オンとピベセテの若者はつるぎに倒れ、女たちは捕え移される。"},{"ref":"Ezek.30.18","start":26030018,"end":26030018,"break":"line","breaks":[[16,"line"],[29,"line"],[38,"line"],[47,"line"]],"ruby":[[9,2,"しはい"],[12,1,"くだ"],[14,1,"とき"],[22,1,"ひ"],[24,1,"くら"],[31,1,"ほこ"],[33,1,"ちから"],[35,1,"た"],[38,1,"くも"],[49,1,"むすめ"],[53,1,"とら"],[55,1,"うつ"]],"text":"わたしがエジプトの支配を砕く時、テパネスでは日は暗くなり、その誇る力は絶え、雲はこれをおおい、その娘たちは捕え移される。"},{"ref":"Ezek.30.19","start":26030019,"end":26030019,"break":"line","breaks":[[21,"line"]],"ruby":[[18,1,"おこな"],[25,1,"かれ"],[32,1,"しゅ"],[39,1,"し"]],"text":"このようにわたしはエジプトにさばきを行う。そのとき彼らはわたしが主であることを知る」。"},{"ref":"Ezek.30.20","start":26030020,"end":26030020,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"ねん"],[6,1,"がつ"],[7,2,"なぬか"],[10,1,"しゅ"],[12,2,"ことば"],[19,1,"のぞ"]],"text":"第十一年の一月七日に主の言葉がわたしに臨んだ、"},{"ref":"Ezek.30.21","start":26030021,"end":26030021,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[15,1,"おう"],[19,1,"うで"],[21,1,"お"],[25,1,"み"],[31,1,"つつ"],[48,1,"ほどこ"],[57,1,"つよ"],[67,1,"と"]],"text":"「人の子よ、わたしはエジプトの王パロの腕を折った。見よ、これは包まれず、いやされず、ほうたいをも施されない。それは強くなって、つるぎを執ることができない。"},{"ref":"Ezek.30.22","start":26030022,"end":26030022,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[17,1,"み"],[29,1,"おう"],[33,1,"せ"],[38,1,"つよ"],[40,1,"うで"],[43,1,"お"],[46,1,"うで"],[49,1,"とも"],[51,1,"お"],[56,1,"て"],[63,1,"おと"]],"text":"それゆえ、主なる神はこう言われる、見よ、わたしはエジプトの王パロを攻め、その強い腕と、折れた腕とを共に折り、その手からつるぎを落させる。"},{"ref":"Ezek.30.23","start":26030023,"end":26030023,"break":"none","ruby":[[17,2,"こくみん"],[20,1,"なか"],[22,1,"ち"],[26,2,"くにぐに"],[29,1,"ち"]],"text":"わたしはエジプトびとを、もろもろの国民の中に散らし、国々に散らす。"},{"ref":"Ezek.30.24","start":26030024,"end":26030024,"break":"none","ruby":[[9,1,"おう"],[11,1,"うで"],[13,1,"つよ"],[28,1,"て"],[30,1,"あた"],[44,1,"うで"],[46,1,"お"],[51,1,"かれ"],[53,2,"ふかで"],[56,1,"お"],[59,1,"もの"],[65,1,"かれ"],[67,1,"まえ"]],"text":"わたしはバビロンの王の腕を強くし、わたしのつるぎを、その手に与える。しかしわたしはパロの腕を折るゆえ、彼は深手を負った者のように、彼の前にうめく。"},{"ref":"Ezek.30.25","start":26030025,"end":26030025,"break":"none","ruby":[[9,1,"おう"],[11,1,"うで"],[13,1,"つよ"],[20,1,"うで"],[25,1,"とき"],[27,1,"かれ"],[34,1,"しゅ"],[41,1,"し"],[62,1,"おう"],[64,1,"さづ"],[75,1,"くに"],[77,1,"む"],[81,1,"の"]],"text":"わたしがバビロンの王の腕を強くし、パロの腕がたれる時、彼らはわたしが主であることを知る。わたしがわたしのつるぎを、バビロンの王に授け、これをエジプトの国に向かって伸べさせ、"},{"ref":"Ezek.30.26","start":26030026,"end":26030026,"break":"none","ruby":[[17,2,"こくみん"],[20,1,"なか"],[22,1,"ち"],[26,2,"くにぐに"],[29,1,"ち"],[32,1,"とき"],[34,1,"かれ"],[41,1,"しゅ"],[48,1,"し"]],"text":"わたしがエジプトびとを、もろもろの国民の中に散らし、国々に散らす時、彼らはわたしが主であることを知る」。"}]