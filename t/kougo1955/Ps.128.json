[{"ref":"Ps.128.1","start":19128001,"end":19128001,"break":"paragraph","title":"都もうでの歌","ruby":[[3,1,"しゅ"],[9,1,"しゅ"],[11,1,"みち"],[13,1,"あゆ"],[15,1,"もの"]],"titleRuby":[[0,1,"みやこ"],[5,1,"うた"]],"text":"すべて主をおそれ、主の道に歩む者はさいわいである。"},{"ref":"Ps.128.2","start":19128002,"end":19128002,"break":"line","breaks":[[17,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"て"],[9,2,"きんろう"],[12,1,"み"],[14,1,"た"],[17,2,"こうふく"],[23,1,"やす"]],"text":"あなたは自分の手の勤労の実を食べ、幸福で、かつ安らかであろう。"},{"ref":"Ps.128.3","start":19128003,"end":19128003,"break":"line","breaks":[[12,"line"],[31,"line"],[46,"line"]],"ruby":[[4,1,"つま"],[6,1,"いえ"],[8,1,"おく"],[12,1,"おお"],[15,1,"み"],[17,1,"むす"],[23,1,"き"],[35,2,"こども"],[40,2,"しょくたく"],[43,1,"かこ"],[50,2,"わかぎ"]],"text":"あなたの妻は家の奥にいて多くの実を結ぶぶどうの木のようであり、あなたの子供たちは食卓を囲んでオリブの若木のようである。"},{"ref":"Ps.128.4","start":19128004,"end":19128004,"break":"line","ruby":[[0,1,"み"],[3,1,"しゅ"],[9,1,"ひと"],[17,2,"しゅくふく"],[20,1,"え"]],"text":"見よ、主をおそれる人は、このように祝福を得る。"},{"ref":"Ps.128.5","start":19128005,"end":19128005,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[11,2,"しゅくふく"],[24,1,"よ"],[37,2,"はんえい"],[40,1,"み"]],"text":"主はシオンからあなたを祝福されるように。あなたは世にあるかぎりエルサレムの繁栄を見、"},{"ref":"Ps.128.6","start":19128006,"end":19128006,"break":"line","breaks":[[18,"line"]],"ruby":[[6,1,"こ"],[9,1,"こ"],[11,1,"み"],[28,1,"うえ"],[30,2,"へいあん"]],"text":"またあなたの子らの子を見るであろう。どうぞ、イスラエルの上に平安があるように。"}]