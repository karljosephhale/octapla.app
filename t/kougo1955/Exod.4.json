[{"ref":"Exod.4.1","start":2004001,"end":2004001,"break":"paragraph","ruby":[[4,1,"い"],[13,1,"かれ"],[20,1,"しん"],[30,1,"こえ"],[32,1,"き"],[34,1,"したが"],[39,1,"い"],[47,1,"しゅ"],[53,1,"あらわ"]],"text":"モーセは言った、「しかし、彼らはわたしを信ぜず、またわたしの声に聞き従わないで言うでしょう、『主はあなたに現れなかった』と」。"},{"ref":"Exod.4.2","start":2004002,"end":2004002,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"い"],[14,1,"て"],[21,1,"なに"],[25,1,"かれ"],[27,1,"い"]],"text":"主は彼に言われた、「あなたの手にあるそれは何か」。彼は言った、「つえです」。"},{"ref":"Exod.4.3","start":2004003,"end":2004003,"break":"none","ruby":[[2,1,"い"],[11,1,"ち"],[13,1,"な"],[20,1,"かれ"],[25,1,"ち"],[27,1,"な"],[47,1,"まえ"],[50,1,"み"],[52,1,"さ"]],"text":"また言われた、「それを地に投げなさい」。彼がそれを地に投げると、へびになったので、モーセはその前から身を避けた。"},{"ref":"Exod.4.4","start":2004004,"end":2004004,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"て"],[18,1,"の"],[25,1,"お"],[27,1,"と"],[38,1,"て"],[40,1,"の"],[47,1,"と"],[51,1,"て"]],"text":"主はモーセに言われた、「あなたの手を伸ばして、その尾を取りなさい。――そこで手を伸ばしてそれを取ると、手のなかでつえとなった。――"},{"ref":"Exod.4.5","start":2004005,"end":2004005,"break":"none","ruby":[[4,1,"かれ"],[7,2,"せんぞ"],[12,1,"かみ"],[20,1,"かみ"],[26,1,"かみ"],[32,1,"かみ"],[36,1,"しゅ"],[43,1,"あらわ"],[49,1,"かれ"],[52,1,"しん"]],"text":"これは、彼らの先祖たちの神、アブラハムの神、イサクの神、ヤコブの神である主が、あなたに現れたのを、彼らに信じさせるためである」。"},{"ref":"Exod.4.6","start":2004006,"end":2004006,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"かれ"],[6,1,"い"],[16,1,"て"],[23,1,"い"],[30,1,"かれ"],[32,1,"て"],[39,1,"い"],[45,1,"だ"],[49,1,"て"],[54,1,"びょう"],[61,1,"ゆき"],[66,1,"しろ"]],"text":"主はまた彼に言われた、「あなたの手をふところに入れなさい」。彼が手をふところに入れ、それを出すと、手は、らい病にかかって、雪のように白くなっていた。"},{"ref":"Exod.4.7","start":2004007,"end":2004007,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"て"],[23,1,"かれ"],[25,1,"て"],[45,1,"だ"],[48,1,"み"],[52,2,"かいふく"],[60,1,"にく"]],"text":"主は言われた、「手をふところにもどしなさい」。彼は手をふところにもどし、それをふところから出して見ると、回復して、もとの肉のようになっていた。"},{"ref":"Exod.4.8","start":2004008,"end":2004008,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"かれ"],[17,1,"しん"],[23,1,"はじ"],[30,1,"みと"],[38,1,"のち"],[44,1,"しん"]],"text":"主は言われた、「彼らがもしあなたを信ぜず、また初めのしるしを認めないならば、後のしるしは信じるであろう。"},{"ref":"Exod.4.9","start":2004009,"end":2004009,"break":"none","ruby":[[0,1,"かれ"],[15,1,"しん"],[23,1,"こえ"],[25,1,"き"],[27,1,"したが"],[42,1,"かわ"],[44,1,"みず"],[46,1,"と"],[54,1,"ち"],[56,1,"そそ"],[69,1,"かわ"],[72,1,"と"],[75,1,"みず"],[82,1,"ち"],[84,1,"ち"]],"text":"彼らがもしこの二つのしるしをも信ぜず、あなたの声に聞き従わないならば、あなたはナイル川の水を取って、かわいた地に注ぎなさい。あなたがナイル川から取った水は、かわいた地で血となるであろう」。"},{"ref":"Exod.4.10","start":2004010,"end":2004010,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"い"],[13,1,"しゅ"],[20,2,"いぜん"],[36,1,"かた"],[42,1,"のち"],[45,2,"ことば"],[48,1,"ひと"],[61,1,"くち"],[63,1,"おも"],[66,1,"した"],[68,1,"おも"]],"text":"モーセは主に言った、「ああ主よ、わたしは以前にも、またあなたが、しもべに語られてから後も、言葉の人ではありません。わたしは口も重く、舌も重いのです」。"},{"ref":"Exod.4.11","start":2004011,"end":2004011,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"い"],[13,1,"ひと"],[15,1,"くち"],[17,1,"さづ"],[26,1,"みみ"],[30,1,"め"],[34,1,"め"],[46,1,"しゅ"]],"text":"主は彼に言われた、「だれが人に口を授けたのか。おし、耳しい、目あき、目しいにだれがするのか。主なるわたしではないか。"},{"ref":"Exod.4.12","start":2004012,"end":2004012,"break":"none","ruby":[[4,1,"い"],[18,1,"くち"],[20,1,"とも"],[30,1,"い"],[37,1,"おし"]],"text":"それゆえ行きなさい。わたしはあなたの口と共にあって、あなたの言うべきことを教えるであろう」。"},{"ref":"Exod.4.13","start":2004013,"end":2004013,"break":"none","ruby":[[4,1,"い"],[12,1,"しゅ"],[22,2,"てきとう"],[25,1,"ひと"]],"text":"モーセは言った、「ああ、主よ、どうか、ほかの適当な人をおつかわしください」。"},{"ref":"Exod.4.14","start":2004014,"end":2004014,"break":"none","ruby":[[4,1,"しゅ"],[14,1,"いか"],[17,1,"はっ"],[20,1,"い"],[30,2,"きょうだい"],[52,1,"かれ"],[54,2,"ことば"],[65,1,"し"],[71,1,"み"],[74,1,"かれ"],[80,1,"あ"],[86,1,"で"],[93,1,"かれ"],[99,1,"み"],[101,1,"こころ"],[103,1,"よろこ"]],"text":"そこで、主はモーセにむかって怒りを発して言われた、「あなたの兄弟レビびとアロンがいるではないか。わたしは彼が言葉にすぐれているのを知っている。見よ、彼はあなたに会おうとして出てきている。彼はあなたを見て心に喜ぶであろう。"},{"ref":"Exod.4.15","start":2004015,"end":2004015,"break":"none","ruby":[[4,1,"かれ"],[6,1,"かた"],[9,2,"ことば"],[14,1,"くち"],[16,1,"さづ"],[30,1,"くち"],[32,1,"とも"],[37,1,"かれ"],[39,1,"くち"],[41,1,"とも"],[60,1,"おし"]],"text":"あなたは彼に語って言葉をその口に授けなさい。わたしはあなたの口と共にあり、彼の口と共にあって、あなたがたのなすべきことを教え、"},{"ref":"Exod.4.16","start":2004016,"end":2004016,"break":"none","ruby":[[0,1,"かれ"],[6,1,"かわ"],[9,1,"たみ"],[11,1,"かた"],[18,1,"かれ"],[24,1,"くち"],[33,1,"かれ"],[39,1,"かみ"],[41,1,"かわ"]],"text":"彼はあなたに代って民に語るであろう。彼はあなたの口となり、あなたは彼のために、神に代るであろう。"},{"ref":"Exod.4.17","start":2004017,"end":2004017,"break":"none","ruby":[[9,1,"て"],[11,1,"と"],[25,1,"おこな"]],"text":"あなたはそのつえを手に執り、それをもって、しるしを行いなさい」。"},{"ref":"Exod.4.18","start":2004018,"end":2004018,"break":"paragraph","ruby":[[4,1,"つま"],[6,1,"ちち"],[15,1,"かえ"],[18,1,"かれ"],[20,1,"い"],[40,1,"み"],[44,1,"もの"],[50,1,"かえ"],[54,1,"かれ"],[59,1,"い"],[74,1,"み"],[92,1,"い"],[97,1,"やす"],[101,1,"い"]],"text":"モーセは妻の父エテロのところに帰って彼に言った、「どうかわたしを、エジプトにいる身うちの者のところに帰らせ、彼らがまだ生きながらえているか、どうかを見させてください」。エテロはモーセに言った、「安んじて行きなさい」。"},{"ref":"Exod.4.19","start":2004019,"end":2004019,"break":"none","ruby":[[0,1,"しゅ"],[11,1,"い"],[22,1,"かえ"],[25,1,"い"],[35,1,"いのち"],[37,1,"もと"],[40,2,"ひとびと"],[45,1,"し"]],"text":"主はミデヤンでモーセに言われた、「エジプトに帰って行きなさい。あなたの命を求めた人々はみな死んだ」。"},{"ref":"Exod.4.20","start":2004020,"end":2004020,"break":"none","ruby":[[7,1,"つま"],[9,2,"こども"],[20,1,"の"],[29,1,"ち"],[31,1,"かえ"],[39,1,"て"],[41,1,"かみ"],[46,1,"と"]],"text":"そこでモーセは妻と子供たちをとり、ろばに乗せて、エジプトの地に帰った。モーセは手に神のつえを執った。"},{"ref":"Exod.4.21","start":2004021,"end":2004021,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[21,1,"かえ"],[35,1,"て"],[37,1,"さづ"],[40,3,"ふしぎ"],[50,1,"まえ"],[52,1,"おこな"],[66,1,"かれ"],[68,1,"こころ"],[80,1,"かれ"],[82,1,"たみ"],[84,1,"さ"]],"text":"主はモーセに言われた、「あなたがエジプトに帰ったとき、わたしがあなたの手に授けた不思議を、みなパロの前で行いなさい。しかし、わたしが彼の心をかたくなにするので、彼は民を去らせないであろう。"},{"ref":"Exod.4.22","start":2004022,"end":2004022,"break":"none","ruby":[[7,1,"い"],[14,1,"しゅ"],[18,1,"おお"],[34,1,"こ"],[40,2,"ちょうし"]],"text":"あなたはパロに言いなさい、『主はこう仰せられる。イスラエルはわたしの子、わたしの長子である。"},{"ref":"Exod.4.23","start":2004023,"end":2004023,"break":"none","ruby":[[8,1,"い"],[15,1,"こ"],[17,1,"さ"],[26,1,"つか"],[36,1,"かれ"],[38,1,"さ"],[44,1,"こば"],[58,1,"こ"],[64,2,"ちょうし"],[67,1,"ころ"]],"text":"わたしはあなたに言う。わたしの子を去らせて、わたしに仕えさせなさい。もし彼を去らせるのを拒むならば、わたしはあなたの子、あなたの長子を殺すであろう』と」。"},{"ref":"Exod.4.24","start":2004024,"end":2004024,"break":"paragraph","ruby":[[6,2,"とちゅう"],[9,1,"やど"],[14,1,"とき"],[16,1,"しゅ"],[18,1,"かれ"],[20,1,"あ"],[23,1,"かれ"],[25,1,"ころ"]],"text":"さてモーセが途中で宿っている時、主は彼に会って彼を殺そうとされた。"},{"ref":"Exod.4.25","start":2004025,"end":2004025,"break":"none","ruby":[[2,1,"とき"],[8,2,"ひう"],[11,1,"いし"],[13,2,"こがたな"],[16,1,"と"],[22,1,"おとこ"],[24,1,"こ"],[26,1,"まえ"],[28,1,"かわ"],[30,1,"き"],[40,1,"あし"],[45,1,"い"],[66,1,"ち"],[68,2,"はなむこ"]],"text":"その時チッポラは火打ち石の小刀を取って、その男の子の前の皮を切り、それをモーセの足につけて言った、「あなたはまことに、わたしにとって血の花婿です」。"},{"ref":"Exod.4.26","start":2004026,"end":2004026,"break":"none","ruby":[[4,1,"しゅ"],[18,1,"とき"],[20,1,"ち"],[22,2,"はなむこ"],[33,1,"い"],[38,2,"かつれい"]],"text":"そこで、主はモーセをゆるされた。この時「血の花婿です」とチッポラが言ったのは割礼のゆえである。"},{"ref":"Exod.4.27","start":2004027,"end":2004027,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,2,"あらの"],[15,1,"い"],[22,1,"あ"],[29,1,"かれ"],[31,1,"い"],[34,1,"かみ"],[36,1,"やま"],[42,1,"あ"],[48,1,"くち"]],"text":"主はアロンに言われた、「荒野に行ってモーセに会いなさい」。彼は行って神の山でモーセに会い、これに口づけした。"},{"ref":"Exod.4.28","start":2004028,"end":2004028,"break":"none","ruby":[[4,2,"じぶん"],[13,1,"しゅ"],[19,2,"ことば"],[23,1,"めい"],[40,1,"つ"]],"text":"モーセは自分をつかわされた主のすべての言葉と、命じられたすべてのしるしをアロンに告げた。"},{"ref":"Exod.4.29","start":2004029,"end":2004029,"break":"none","ruby":[[11,1,"い"],[20,2,"ひとびと"],[23,2,"ちょうろう"],[30,1,"あつ"]],"text":"そこでモーセとアロンは行ってイスラエルの人々の長老たちをみな集めた。"},{"ref":"Exod.4.30","start":2004030,"end":2004030,"break":"none","ruby":[[7,1,"しゅ"],[13,1,"かた"],[17,2,"ことば"],[26,1,"つ"],[32,1,"かれ"],[34,1,"たみ"],[36,1,"まえ"],[42,1,"おこな"]],"text":"そしてアロンは主がモーセに語られた言葉を、ことごとく告げた。また彼は民の前でしるしを行ったので、"},{"ref":"Exod.4.31","start":2004031,"end":2004031,"break":"none","ruby":[[0,1,"たみ"],[2,1,"しん"],[6,1,"かれ"],[9,1,"しゅ"],[17,2,"ひとびと"],[20,1,"かえり"],[25,1,"くる"],[29,1,"み"],[35,1,"き"],[38,1,"ふ"],[41,2,"れいはい"]],"text":"民は信じた。彼らは主がイスラエルの人々を顧み、その苦しみを見られたのを聞き、伏して礼拝した。"}]