[{"ref":"Gen.11.1","start":1011001,"end":1011001,"break":"paragraph","ruby":[[0,1,"ぜん"],[1,1,"ち"],[3,1,"おな"],[5,2,"はつおん"],[8,1,"おな"],[10,2,"ことば"]],"text":"全地は同じ発音、同じ言葉であった。"},{"ref":"Gen.11.2","start":1011002,"end":1011002,"break":"none","ruby":[[0,1,"とき"],[2,2,"ひとびと"],[5,1,"ひがし"],[7,1,"うつ"],[14,1,"ち"],[16,2,"へいや"],[19,1,"え"],[25,1,"す"]],"text":"時に人々は東に移り、シナルの地に平野を得て、そこに住んだ。"},{"ref":"Gen.11.3","start":1011003,"end":1011003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"たがい"],[5,1,"い"],[17,1,"つく"],[23,1,"や"],[32,1,"かれ"],[35,1,"いし"],[37,1,"かわ"],[45,1,"え"],[52,1,"かわ"],[63,1,"え"]],"text":"彼らは互に言った、「さあ、れんがを造って、よく焼こう」。こうして彼らは石の代りに、れんがを得、しっくいの代りに、アスファルトを得た。"},{"ref":"Gen.11.4","start":1011004,"end":1011004,"break":"none","ruby":[[0,1,"かれ"],[5,1,"い"],[13,1,"まち"],[15,1,"とう"],[18,1,"た"],[24,1,"いただき"],[26,1,"てん"],[28,1,"とど"],[42,1,"な"],[44,1,"あ"],[48,1,"ぜん"],[49,1,"ち"],[55,1,"ち"],[59,1,"まぬか"]],"text":"彼らはまた言った、「さあ、町と塔とを建てて、その頂を天に届かせよう。そしてわれわれは名を上げて、全地のおもてに散るのを免れよう」。"},{"ref":"Gen.11.5","start":1011005,"end":1011005,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,1,"くだ"],[8,1,"ひと"],[10,1,"こ"],[14,1,"た"],[17,1,"まち"],[19,1,"とう"],[22,1,"み"]],"text":"時に主は下って、人の子たちの建てる町と塔とを見て、"},{"ref":"Gen.11.6","start":1011006,"end":1011006,"break":"none","ruby":[[0,1,"い"],[6,1,"たみ"],[14,1,"おな"],[16,2,"ことば"],[22,1,"かれ"],[30,1,"こと"],[38,1,"かれ"],[47,1,"こと"],[53,2,"なにごと"],[59,1,"え"]],"text":"言われた、「民は一つで、みな同じ言葉である。彼らはすでにこの事をしはじめた。彼らがしようとする事は、もはや何事もとどめ得ないであろう。"},{"ref":"Gen.11.7","start":1011007,"end":1011007,"break":"none","ruby":[[8,1,"くだ"],[11,1,"い"],[18,1,"かれ"],[21,2,"ことば"],[24,1,"みだ"],[27,1,"たがい"],[29,2,"ことば"],[32,1,"つう"]],"text":"さあ、われわれは下って行って、そこで彼らの言葉を乱し、互に言葉が通じないようにしよう」。"},{"ref":"Gen.11.8","start":1011008,"end":1011008,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"かれ"],[13,1,"ぜん"],[14,1,"ち"],[20,1,"ち"],[28,1,"かれ"],[31,1,"まち"],[33,1,"た"]],"text":"こうして主が彼らをそこから全地のおもてに散らされたので、彼らは町を建てるのをやめた。"},{"ref":"Gen.11.9","start":1011009,"end":1011009,"break":"none","ruby":[[8,1,"まち"],[10,1,"な"],[16,1,"よ"],[21,1,"しゅ"],[26,1,"ぜん"],[27,1,"ち"],[29,2,"ことば"],[32,1,"みだ"],[42,1,"しゅ"],[48,1,"かれ"],[51,1,"ぜん"],[52,1,"ち"],[58,1,"ち"]],"text":"これによってその町の名はバベルと呼ばれた。主がそこで全地の言葉を乱されたからである。主はそこから彼らを全地のおもてに散らされた。"},{"ref":"Gen.11.10","start":1011010,"end":1011010,"break":"paragraph","ruby":[[3,2,"けいず"],[6,1,"つぎ"],[19,1,"さい"],[24,2,"こうずい"],[28,1,"ねん"],[30,1,"のち"],[39,1,"う"]],"text":"セムの系図は次のとおりである。セムは百歳になって洪水の二年の後にアルパクサデを生んだ。"},{"ref":"Gen.11.11","start":1011011,"end":1011011,"break":"none","ruby":[[10,1,"う"],[13,1,"のち"],[17,1,"ねん"],[18,1,"い"],[22,2,"だんし"],[25,2,"じょし"],[28,1,"う"]],"text":"セムはアルパクサデを生んで後、五百年生きて、男子と女子を生んだ。"},{"ref":"Gen.11.12","start":1011012,"end":1011012,"break":"paragraph","ruby":[[10,1,"さい"],[18,1,"う"]],"text":"アルパクサデは三十五歳になってシラを生んだ。"},{"ref":"Gen.11.13","start":1011013,"end":1011013,"break":"none","ruby":[[10,1,"う"],[13,1,"のち"],[18,1,"ねん"],[19,1,"い"],[23,2,"だんし"],[26,2,"じょし"],[29,1,"う"]],"text":"アルパクサデはシラを生んで後、四百三年生きて、男子と女子を生んだ。"},{"ref":"Gen.11.14","start":1011014,"end":1011014,"break":"paragraph","ruby":[[5,1,"さい"],[14,1,"う"]],"text":"シラは三十歳になってエベルを生んだ。"},{"ref":"Gen.11.15","start":1011015,"end":1011015,"break":"none","ruby":[[7,1,"う"],[10,1,"のち"],[15,1,"ねん"],[16,1,"い"],[20,2,"だんし"],[23,2,"じょし"],[26,1,"う"]],"text":"シラはエベルを生んで後、四百三年生きて、男子と女子を生んだ。"},{"ref":"Gen.11.16","start":1011016,"end":1011016,"break":"paragraph","ruby":[[7,1,"さい"],[16,1,"う"]],"text":"エベルは三十四歳になってペレグを生んだ。"},{"ref":"Gen.11.17","start":1011017,"end":1011017,"break":"none","ruby":[[8,1,"う"],[11,1,"のち"],[17,1,"ねん"],[18,1,"い"],[22,2,"だんし"],[25,2,"じょし"],[28,1,"う"]],"text":"エベルはペレグを生んで後、四百三十年生きて、男子と女子を生んだ。"},{"ref":"Gen.11.18","start":1011018,"end":1011018,"break":"paragraph","ruby":[[6,1,"さい"],[14,1,"う"]],"text":"ペレグは三十歳になってリウを生んだ。"},{"ref":"Gen.11.19","start":1011019,"end":1011019,"break":"none","ruby":[[7,1,"う"],[10,1,"のち"],[15,1,"ねん"],[16,1,"い"],[20,2,"だんし"],[23,2,"じょし"],[26,1,"う"]],"text":"ペレグはリウを生んで後、二百九年生きて、男子と女子を生んだ。"},{"ref":"Gen.11.20","start":1011020,"end":1011020,"break":"paragraph","ruby":[[6,1,"さい"],[15,1,"う"]],"text":"リウは三十二歳になってセルグを生んだ。"},{"ref":"Gen.11.21","start":1011021,"end":1011021,"break":"none","ruby":[[7,1,"う"],[10,1,"のち"],[15,1,"ねん"],[16,1,"い"],[20,2,"だんし"],[23,2,"じょし"],[26,1,"う"]],"text":"リウはセルグを生んで後、二百七年生きて、男子と女子を生んだ。"},{"ref":"Gen.11.22","start":1011022,"end":1011022,"break":"paragraph","ruby":[[6,1,"さい"],[15,1,"う"]],"text":"セルグは三十歳になってナホルを生んだ。"},{"ref":"Gen.11.23","start":1011023,"end":1011023,"break":"none","ruby":[[8,1,"う"],[11,1,"のち"],[15,1,"ねん"],[16,1,"い"],[20,2,"だんし"],[23,2,"じょし"],[26,1,"う"]],"text":"セルグはナホルを生んで後、二百年生きて、男子と女子を生んだ。"},{"ref":"Gen.11.24","start":1011024,"end":1011024,"break":"paragraph","ruby":[[7,1,"さい"],[15,1,"う"]],"text":"ナホルは二十九歳になってテラを生んだ。"},{"ref":"Gen.11.25","start":1011025,"end":1011025,"break":"none","ruby":[[7,1,"う"],[10,1,"のち"],[15,1,"ねん"],[16,1,"い"],[20,2,"だんし"],[23,2,"じょし"],[26,1,"う"]],"text":"ナホルはテラを生んで後、百十九年生きて、男子と女子を生んだ。"},{"ref":"Gen.11.26","start":1011026,"end":1011026,"break":"paragraph","ruby":[[5,1,"さい"],[25,1,"う"]],"text":"テラは七十歳になってアブラム、ナホルおよびハランを生んだ。"},{"ref":"Gen.11.27","start":1011027,"end":1011027,"break":"paragraph","ruby":[[3,2,"けいず"],[6,1,"つぎ"],[33,1,"う"],[43,1,"う"]],"text":"テラの系図は次のとおりである。テラはアブラム、ナホルおよびハランを生み、ハランはロトを生んだ。"},{"ref":"Gen.11.28","start":1011028,"end":1011028,"break":"none","ruby":[[4,1,"ちち"],[16,1,"うま"],[19,1,"ち"],[29,1,"し"]],"text":"ハランは父テラにさきだって、その生れた地、カルデヤのウルで死んだ。"},{"ref":"Gen.11.29","start":1011029,"end":1011029,"break":"none","ruby":[[9,1,"つま"],[21,1,"つま"],[23,1,"な"],[36,1,"つま"],[38,1,"な"],[51,1,"むすめ"],[64,1,"ちち"],[72,1,"ちち"]],"text":"アブラムとナホルは妻をめとった。アブラムの妻の名はサライといい、ナホルの妻の名はミルカといってハランの娘である。ハランはミルカの父、またイスカの父である。"},{"ref":"Gen.11.30","start":1011030,"end":1011030,"break":"none","ruby":[[10,1,"こ"]],"text":"サライはうまずめで、子がなかった。"},{"ref":"Gen.11.31","start":1011031,"end":1011031,"break":"paragraph","ruby":[[5,1,"こ"],[16,1,"こ"],[20,1,"まご"],[25,1,"こ"],[31,1,"つま"],[35,1,"よめ"],[41,1,"つ"],[49,1,"ち"],[51,1,"い"],[63,1,"で"],[71,1,"つ"],[77,1,"す"]],"text":"テラはその子アブラムと、ハランの子である孫ロトと、子アブラムの妻である嫁サライとを連れて、カナンの地へ行こうとカルデヤのウルを出たが、ハランに着いてそこに住んだ。"},{"ref":"Gen.11.32","start":1011032,"end":1011032,"break":"none","ruby":[[3,1,"とし"],[8,1,"さい"],[21,1,"し"]],"text":"テラの年は二百五歳であった。テラはハランで死んだ。"}]