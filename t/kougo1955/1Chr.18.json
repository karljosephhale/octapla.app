[{"ref":"1Chr.18.1","start":13018001,"end":13018001,"break":"paragraph","ruby":[[2,1,"のち"],[14,1,"う"],[20,2,"せいふく"],[31,1,"て"],[39,2,"むらむら"],[42,1,"と"]],"text":"この後ダビデはペリシテびとを撃ってこれを征服し、ペリシテびとの手からガテとその村々を取った。"},{"ref":"1Chr.18.2","start":13018002,"end":13018002,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"う"],[34,1,"おさ"]],"text":"彼はまたモアブを撃った。モアブびとはダビデのしもべとなって、みつぎを納めた。"},{"ref":"1Chr.18.3","start":13018003,"end":13018003,"break":"paragraph","ruby":[[14,1,"おう"],[25,1,"かわ"],[34,3,"きねんひ"],[38,1,"た"],[45,1,"い"],[50,1,"かれ"],[52,1,"う"]],"text":"ダビデはまた、ハマテのゾバの王ハダデゼルがユフラテ川のほとりに、その記念碑を建てようとして行ったとき彼を撃った。"},{"ref":"1Chr.18.4","start":13018004,"end":13018004,"break":"none","ruby":[[7,1,"かれ"],[10,2,"せんしゃ"],[15,2,"きへい"],[19,1,"にん"],[21,2,"ほへい"],[25,1,"にん"],[27,1,"と"],[38,2,"せんしゃ"],[41,1,"うま"],[43,1,"のこ"],[52,2,"せんしゃ"],[55,1,"うま"],[61,1,"あし"],[63,1,"すじ"],[65,1,"き"]],"text":"そしてダビデは彼から戦車一千、騎兵七千人、歩兵二万人を取った。ダビデは一百の戦車の馬を残して、そのほかの戦車の馬はみなその足の筋を切った。"},{"ref":"1Chr.18.5","start":13018005,"end":13018005,"break":"none","ruby":[[2,1,"とき"],[17,1,"おう"],[24,1,"たす"],[30,1,"き"],[50,1,"にん"],[52,1,"ころ"]],"text":"その時ダマスコのスリヤびとがゾバの王ハダデゼルを助けるために来たので、ダビデはそのスリヤびと二万二千人を殺した。"},{"ref":"1Chr.18.6","start":13018006,"end":13018006,"break":"none","ruby":[[16,2,"しゅび"],[18,1,"たい"],[20,1,"お"],[34,1,"おさ"],[49,1,"しゅ"],[60,1,"い"],[62,1,"ところ"],[64,2,"しょうり"],[67,1,"あた"]],"text":"そしてダビデはダマスコのスリヤに守備隊を置いた。スリヤびとはみつぎを納めてダビデのしもべとなった。主はダビデにすべてその行く所で勝利を与えられた。"},{"ref":"1Chr.18.7","start":13018007,"end":13018007,"break":"none","ruby":[[15,1,"も"],[20,1,"きん"],[22,1,"たて"],[24,1,"うば"],[34,1,"も"]],"text":"ダビデはハダデゼルのしもべらが持っていた金の盾を奪って、エルサレムに持ってきた。"},{"ref":"1Chr.18.8","start":13018008,"end":13018008,"break":"none","ruby":[[8,1,"まち"],[22,2,"ひじょう"],[25,1,"おお"],[28,2,"せいどう"],[31,1,"と"],[43,1,"もち"],[46,2,"せいどう"],[49,1,"うみ"],[51,1,"はしら"],[55,2,"せいどう"],[58,1,"うつわ"],[60,1,"つく"]],"text":"またハダデゼルの町テブハテとクンからダビデは非常に多くの青銅を取った。ソロモンはそれを用いて青銅の海、柱および青銅の器を造った。"},{"ref":"1Chr.18.9","start":13018009,"end":13018009,"break":"paragraph","ruby":[[0,1,"とき"],[6,1,"おう"],[17,1,"おう"],[28,2,"ぐんぜい"],[31,1,"う"],[33,1,"やぶ"],[39,1,"き"]],"text":"時にハマテの王トイはダビデがゾバの王ハダデゼルのすべての軍勢を撃ち破ったことを聞き、"},{"ref":"1Chr.18.10","start":13018010,"end":13018010,"break":"none","ruby":[[2,1,"こ"],[11,1,"おう"],[19,1,"かれ"],[30,1,"しゅく"],[32,1,"の"],[54,1,"たたか"],[57,1,"まじ"],[72,1,"たたか"],[79,1,"う"],[81,1,"やぶ"],[95,1,"きん"],[97,1,"ぎん"],[101,2,"せいどう"],[109,1,"うつわ"],[111,1,"おく"]],"text":"その子ハドラムをダビデ王につかわして、彼にあいさつさせ、かつ祝を述べさせた。ハダデゼルはかつてしばしばトイと戦いを交えたが、ダビデはハダデゼルと戦って、これを撃ち破ったからである。ハドラムは金、銀および青銅のさまざまの器を贈ったので、"},{"ref":"1Chr.18.11","start":13018011,"end":13018011,"break":"none","ruby":[[3,1,"おう"],[21,2,"ひとびと"],[38,1,"しょ"],[39,2,"こくみん"],[46,1,"と"],[51,2,"きんぎん"],[58,1,"しゅ"]],"text":"ダビデ王はこれをエドム、モアブ、アンモンの人々、ペリシテびと、アマクレなどの諸国民のうちから取ってきた金銀とともに、主にささげた。"},{"ref":"1Chr.18.12","start":13018012,"end":13018012,"break":"paragraph","ruby":[[4,1,"こ"],[11,1,"しお"],[13,1,"たに"],[26,1,"う"],[28,1,"ころ"]],"text":"ゼルヤの子アビシャイは塩の谷で、エドムびと一万八千を撃ち殺した。"},{"ref":"1Chr.18.13","start":13018013,"end":13018013,"break":"none","ruby":[[8,2,"しゅび"],[10,1,"たい"],[12,1,"お"],[21,1,"みな"],[34,1,"しゅ"],[45,1,"い"],[47,1,"ところ"],[49,2,"しょうり"],[52,1,"あた"]],"text":"ダビデはエドムに守備隊を置き、エドムびとは皆ダビデのしもべとなった。主はダビデにすべてその行く所で勝利を与えられた。"},{"ref":"1Chr.18.14","start":13018014,"end":13018014,"break":"none","ruby":[[14,1,"ぜん"],[15,1,"ち"],[17,1,"おさ"],[26,1,"たみ"],[28,2,"こうどう"],[31,2,"せいぎ"],[34,1,"おこな"]],"text":"こうしてダビデはイスラエルの全地を治め、そのすべての民に公道と正義を行った。"},{"ref":"1Chr.18.15","start":13018015,"end":13018015,"break":"none","ruby":[[4,1,"こ"],[9,1,"ぐん"],[11,1,"ちょう"],[18,1,"こ"],[25,2,"しかん"]],"text":"ゼルヤの子ヨアブは軍の長、アヒルデの子ヨシャパテは史官、"},{"ref":"1Chr.18.16","start":13018016,"end":13018016,"break":"none","ruby":[[5,1,"こ"],[16,1,"こ"],[23,2,"さいし"],[32,3,"しょきかん"]],"text":"アヒトブの子ザドクとアビヤタルの子アビメレクは祭司、シャウシャは書記官、"},{"ref":"1Chr.18.17","start":13018017,"end":13018017,"break":"none","ruby":[[5,1,"こ"],[22,1,"ちょう"],[28,1,"こ"],[32,1,"おう"],[42,2,"だいじん"]],"text":"エホヤダの子ベナヤはケレテびととペレテびとの長、ダビデの子たちは王のかたわらにはべる大臣であった。"}]