[{"ref":"John.14.1","start":43014001,"end":43014001,"break":"paragraph","ruby":[[8,1,"こころ"],[10,1,"さわ"],[19,1,"かみ"],[21,1,"しん"],[30,1,"しん"]],"text":"「あなたがたは、心を騒がせないがよい。神を信じ、またわたしを信じなさい。"},{"ref":"John.14.2","start":43014002,"end":43014002,"break":"none","ruby":[[4,1,"ちち"],[6,1,"いえ"],[37,1,"い"],[58,2,"ばしょ"],[61,2,"ようい"],[65,1,"い"]],"text":"わたしの父の家には、すまいがたくさんある。もしなかったならば、わたしはそう言っておいたであろう。あなたがたのために、場所を用意しに行くのだから。"},{"ref":"John.14.3","start":43014003,"end":43014003,"break":"none","ruby":[[4,1,"い"],[8,2,"ばしょ"],[11,2,"ようい"],[40,1,"むか"],[51,1,"ところ"]],"text":"そして、行って、場所の用意ができたならば、またきて、あなたがたをわたしのところに迎えよう。わたしのおる所にあなたがたもおらせるためである。"},{"ref":"John.14.4","start":43014004,"end":43014004,"break":"none","ruby":[[7,1,"い"],[14,1,"みち"]],"text":"わたしがどこへ行くのか、その道はあなたがたにわかっている」。"},{"ref":"John.14.5","start":43014005,"end":43014005,"break":"none","ruby":[[8,1,"い"],[13,1,"しゅ"],[48,1,"みち"]],"text":"トマスはイエスに言った、「主よ、どこへおいでになるのか、わたしたちにはわかりません。どうしてその道がわかるでしょう」。"},{"ref":"John.14.6","start":43014006,"end":43014006,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[16,1,"みち"],[21,2,"しんり"],[27,1,"いのち"],[47,1,"ちち"],[53,1,"い"]],"text":"イエスは彼に言われた、「わたしは道であり、真理であり、命である。だれでもわたしによらないでは、父のみもとに行くことはできない。"},{"ref":"John.14.7","start":43014007,"end":43014007,"break":"none","ruby":[[12,1,"し"],[25,1,"ちち"],[28,1,"し"],[40,1,"いま"],[42,1,"ちち"],[44,1,"し"],[55,1,"ちち"],[57,1,"み"]],"text":"もしあなたがたがわたしを知っていたならば、わたしの父をも知ったであろう。しかし、今は父を知っており、またすでに父を見たのである」。"},{"ref":"John.14.8","start":43014008,"end":43014008,"break":"none","ruby":[[8,1,"い"],[13,1,"しゅ"],[22,1,"ちち"],[24,1,"しめ"],[27,1,"くだ"],[35,1,"くだ"],[46,2,"まんぞく"]],"text":"ピリポはイエスに言った、「主よ、わたしたちに父を示して下さい。そうして下されば、わたしたちは満足します」。"},{"ref":"John.14.9","start":43014009,"end":43014009,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[21,1,"なが"],[29,2,"いっしょ"],[55,1,"み"],[57,1,"もの"],[60,1,"ちち"],[62,1,"み"],[80,1,"ちち"],[82,1,"しめ"],[90,1,"い"]],"text":"イエスは彼に言われた、「ピリポよ、こんなに長くあなたがたと一緒にいるのに、わたしがわかっていないのか。わたしを見た者は、父を見たのである。どうして、わたしたちに父を示してほしいと、言うのか。"},{"ref":"John.14.10","start":43014010,"end":43014010,"break":"none","ruby":[[4,1,"ちち"],[9,1,"ちち"],[26,1,"しん"],[43,1,"はな"],[48,2,"ことば"],[52,2,"じぶん"],[56,1,"はな"],[67,1,"ちち"]],"text":"わたしが父におり、父がわたしにおられることをあなたは信じないのか。わたしがあなたがたに話している言葉は、自分から話しているのではない。父がわたしのうちにおられて、みわざをなさっているのである。"},{"ref":"John.14.11","start":43014011,"end":43014011,"break":"none","ruby":[[4,1,"ちち"],[9,1,"ちち"],[22,1,"しん"],[33,1,"しん"],[53,1,"しん"]],"text":"わたしが父におり、父がわたしにおられることを信じなさい。もしそれが信じられないならば、わざそのものによって信じなさい。"},{"ref":"John.14.12","start":43014012,"end":43014012,"break":"none","ruby":[[10,1,"い"],[20,1,"しん"],[23,1,"もの"],[56,1,"おお"],[73,1,"ちち"],[79,1,"い"]],"text":"よくよくあなたがたに言っておく。わたしを信じる者は、またわたしのしているわざをするであろう。そればかりか、もっと大きいわざをするであろう。わたしが父のみもとに行くからである。"},{"ref":"John.14.13","start":43014013,"end":43014013,"break":"none","ruby":[[4,1,"な"],[9,1,"ねが"],[28,1,"ちち"],[30,1,"こ"],[35,2,"えいこう"],[39,1,"う"]],"text":"わたしの名によって願うことは、なんでもかなえてあげよう。父が子によって栄光をお受けになるためである。"},{"ref":"John.14.14","start":43014014,"end":43014014,"break":"none","ruby":[[0,2,"なにごと"],[8,1,"な"],[13,1,"ねが"]],"text":"何事でもわたしの名によって願うならば、わたしはそれをかなえてあげよう。"},{"ref":"John.14.15","start":43014015,"end":43014015,"break":"none","ruby":[[12,1,"あい"],[28,1,"まも"]],"text":"もしあなたがたがわたしを愛するならば、わたしのいましめを守るべきである。"},{"ref":"John.14.16","start":43014016,"end":43014016,"break":"none","ruby":[[4,1,"ちち"],[7,1,"ねが"],[19,1,"ちち"],[21,1,"べつ"],[23,1,"たす"],[25,1,"ぬし"],[27,1,"おく"],[42,1,"とも"],[48,1,"くだ"]],"text":"わたしは父にお願いしよう。そうすれば、父は別に助け主を送って、いつまでもあなたがたと共におらせて下さるであろう。"},{"ref":"John.14.17","start":43014017,"end":43014017,"break":"none","ruby":[[3,2,"しんり"],[6,2,"みたま"],[14,1,"よ"],[19,1,"み"],[27,1,"し"],[41,1,"う"],[61,1,"し"],[81,1,"とも"]],"text":"それは真理の御霊である。この世はそれを見ようともせず、知ろうともしないので、それを受けることができない。あなたがたはそれを知っている。なぜなら、それはあなたがたと共におり、またあなたがたのうちにいるからである。"},{"ref":"John.14.18","start":43014018,"end":43014018,"break":"paragraph","ruby":[[10,1,"す"],[13,2,"こじ"],[31,1,"かえ"],[34,1,"く"]],"text":"わたしはあなたがたを捨てて孤児とはしない。あなたがたのところに帰って来る。"},{"ref":"John.14.19","start":43014019,"end":43014019,"break":"none","ruby":[[10,1,"よ"],[19,1,"み"],[42,1,"み"],[49,1,"い"],[61,1,"い"]],"text":"もうしばらくしたら、世はもはやわたしを見なくなるだろう。しかし、あなたがたはわたしを見る。わたしが生きるので、あなたがたも生きるからである。"},{"ref":"John.14.20","start":43014020,"end":43014020,"break":"none","ruby":[[2,1,"ひ"],[14,1,"ちち"]],"text":"その日には、わたしはわたしの父におり、あなたがたはわたしにおり、また、わたしがあなたがたにおることが、わかるであろう。"},{"ref":"John.14.21","start":43014021,"end":43014021,"break":"none","ruby":[[9,1,"こころ"],[18,1,"まも"],[20,1,"もの"],[27,1,"あい"],[30,1,"もの"],[39,1,"あい"],[42,1,"もの"],[49,1,"ちち"],[51,1,"あい"],[66,1,"ひと"],[68,1,"あい"],[73,1,"ひと"],[78,2,"じしん"]],"text":"わたしのいましめを心にいだいてこれを守る者は、わたしを愛する者である。わたしを愛する者は、わたしの父に愛されるであろう。わたしもその人を愛し、その人にわたし自身をあらわすであろう」。"},{"ref":"John.14.22","start":43014022,"end":43014022,"break":"none","ruby":[[9,1,"ほう"],[18,1,"い"],[23,1,"しゅ"],[30,2,"じしん"],[48,1,"よ"]],"text":"イスカリオテでない方のユダがイエスに言った、「主よ、あなたご自身をわたしたちにあらわそうとして、世にはあらわそうとされないのはなぜですか」。"},{"ref":"John.14.23","start":43014023,"end":43014023,"break":"none","ruby":[[4,1,"かれ"],[6,1,"こた"],[9,1,"い"],[25,1,"あい"],[36,2,"ことば"],[39,1,"まも"],[54,1,"ちち"],[58,1,"ひと"],[60,1,"あい"],[74,1,"ひと"],[80,1,"い"],[86,1,"ひと"],[88,2,"いっしょ"],[91,1,"す"]],"text":"イエスは彼に答えて言われた、「もしだれでもわたしを愛するならば、わたしの言葉を守るであろう。そして、わたしの父はその人を愛し、また、わたしたちはその人のところに行って、その人と一緒に住むであろう。"},{"ref":"John.14.24","start":43014024,"end":43014024,"break":"none","ruby":[[4,1,"あい"],[8,1,"もの"],[14,2,"ことば"],[17,1,"まも"],[28,1,"き"],[33,2,"ことば"],[41,2,"ことば"],[58,1,"ちち"],[60,2,"ことば"]],"text":"わたしを愛さない者はわたしの言葉を守らない。あなたがたが聞いている言葉は、わたしの言葉ではなく、わたしをつかわされた父の言葉である。"},{"ref":"John.14.25","start":43014025,"end":43014025,"break":"paragraph","ruby":[[14,2,"いっしょ"],[19,1,"とき"],[24,1,"かた"]],"text":"これらのことは、あなたがたと一緒にいた時、すでに語ったことである。"},{"ref":"John.14.26","start":43014026,"end":43014026,"break":"none","ruby":[[4,1,"たす"],[6,1,"ぬし"],[13,1,"ちち"],[19,1,"な"],[30,2,"せいれい"],[47,1,"おし"],[56,1,"はな"],[71,1,"おも"],[73,1,"おこ"]],"text":"しかし、助け主、すなわち、父がわたしの名によってつかわされる聖霊は、あなたがたにすべてのことを教え、またわたしが話しておいたことを、ことごとく思い起させるであろう。"},{"ref":"John.14.27","start":43014027,"end":43014027,"break":"none","ruby":[[4,2,"へいあん"],[13,1,"のこ"],[16,1,"い"],[23,2,"へいあん"],[32,1,"あた"],[40,1,"あた"],[46,1,"よ"],[48,1,"あた"],[58,1,"こと"],[68,1,"こころ"],[70,1,"さわ"]],"text":"わたしは平安をあなたがたに残して行く。わたしの平安をあなたがたに与える。わたしが与えるのは、世が与えるようなものとは異なる。あなたがたは心を騒がせるな、またおじけるな。"},{"ref":"John.14.28","start":43014028,"end":43014028,"break":"none","ruby":[[5,1,"さ"],[8,1,"い"],[24,1,"かえ"],[27,1,"く"],[36,1,"い"],[48,1,"き"],[60,1,"あい"],[72,1,"ちち"],[77,1,"い"],[81,1,"よろこ"],[92,1,"ちち"],[99,1,"おお"]],"text":"『わたしは去って行くが、またあなたがたのところに帰って来る』と、わたしが言ったのを、あなたがたは聞いている。もしわたしを愛しているなら、わたしが父のもとに行くのを喜んでくれるであろう。父がわたしより大きいかたであるからである。"},{"ref":"John.14.29","start":43014029,"end":43014029,"break":"none","ruby":[[0,1,"いま"],[11,1,"おこ"],[15,1,"さき"],[23,1,"かた"],[31,1,"こと"],[33,1,"おこ"],[36,1,"とき"],[44,1,"しん"]],"text":"今わたしは、そのことが起らない先にあなたがたに語った。それは、事が起った時にあなたがたが信じるためである。"},{"ref":"John.14.30","start":43014030,"end":43014030,"break":"none","ruby":[[15,1,"おお"],[18,1,"かた"],[25,1,"よ"],[27,1,"きみ"],[29,1,"く"],[40,1,"かれ"],[46,1,"たい"],[53,1,"ちから"]],"text":"わたしはもはや、あなたがたに、多くを語るまい。この世の君が来るからである。だが、彼はわたしに対して、なんの力もない。"},{"ref":"John.14.31","start":43014031,"end":43014031,"break":"none","ruby":[[8,1,"ちち"],[10,1,"あい"],[18,1,"よ"],[20,1,"し"],[30,1,"ちち"],[33,1,"めい"],[46,1,"おこな"],[53,1,"た"],[63,1,"で"],[67,1,"い"]],"text":"しかし、わたしが父を愛していることを世が知るように、わたしは父がお命じになったとおりのことを行うのである。立て。さあ、ここから出かけて行こう。"}]