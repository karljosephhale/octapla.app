[{"ref":"Col.4.1","start":51004001,"end":51004001,"break":"paragraph","ruby":[[0,2,"しゅじん"],[4,1,"もの"],[7,1,"しもべ"],[9,1,"ただ"],[12,2,"こうへい"],[15,1,"あつか"],[28,1,"しゅ"],[30,1,"てん"]],"text":"主人たる者よ、僕を正しく公平に扱いなさい。あなたがたにも主が天にいますことが、わかっているのだから。"},{"ref":"Col.4.2","start":51004002,"end":51004002,"break":"paragraph","ruby":[[0,1,"め"],[7,2,"かんしゃ"],[13,1,"いの"],[20,1,"いの"],[22,1,"つづ"]],"text":"目をさまして、感謝のうちに祈り、ひたすら祈り続けなさい。"},{"ref":"Col.4.3","start":51004003,"end":51004003,"break":"none","ruby":[[0,2,"どうじ"],[14,1,"かみ"],[16,2,"みことば"],[22,1,"もん"],[24,1,"ひら"],[27,1,"くだ"],[43,2,"おくぎ"],[46,1,"かた"],[58,1,"じつ"],[66,1,"ごく"]],"text":"同時にわたしたちのためにも、神が御言のために門を開いて下さって、わたしたちがキリストの奥義を語れるように（わたしは、実は、そのために獄につながれているのである）、"},{"ref":"Col.4.4","start":51004004,"end":51004004,"break":"none","ruby":[[7,1,"かた"],[19,1,"かた"],[26,1,"いの"]],"text":"また、わたしが語るべきことをはっきりと語れるように、祈ってほしい。"},{"ref":"Col.4.5","start":51004005,"end":51004005,"break":"none","ruby":[[0,1,"いま"],[2,1,"とき"],[4,1,"い"],[8,1,"もち"],[14,1,"ひと"],[16,1,"たい"],[19,1,"かしこ"],[21,2,"こうどう"]],"text":"今の時を生かして用い、そとの人に対して賢く行動しなさい。"},{"ref":"Col.4.6","start":51004006,"end":51004006,"break":"none","ruby":[[4,1,"しお"],[6,1,"あじ"],[17,2,"ことば"],[20,1,"つか"],[39,1,"たい"],[44,1,"こた"]],"text":"いつも、塩で味つけられた、やさしい言葉を使いなさい。そうすれば、ひとりびとりに対してどう答えるべきか、わかるであろう。"},{"ref":"Col.4.7","start":51004007,"end":51004007,"break":"paragraph","ruby":[[4,2,"ようす"],[12,1,"しゅ"],[17,1,"とも"],[19,1,"しもべ"],[26,2,"ちゅうじつ"],[29,1,"つか"],[34,1,"あい"],[37,2,"きょうだい"],[58,2,"ほうこく"]],"text":"わたしの様子については、主にあって共に僕であり、また忠実に仕えている愛する兄弟テキコが、あなたがたにいっさいのことを報告するであろう。"},{"ref":"Col.4.8","start":51004008,"end":51004008,"break":"none","ruby":[[4,1,"かれ"],[15,1,"おく"],[26,2,"ようす"],[29,1,"し"],[34,1,"かれ"],[39,1,"こころ"],[41,1,"はげ"],[45,1,"う"]],"text":"わたしが彼をあなたがたのもとに送るのは、わたしたちの様子を知り、また彼によって心に励ましを受けるためなのである。"},{"ref":"Col.4.9","start":51004009,"end":51004009,"break":"none","ruby":[[10,2,"ちゅうじつ"],[13,1,"あい"],[16,2,"きょうだい"],[25,1,"かれ"],[27,1,"とも"],[29,1,"おく"],[32,1,"かれ"],[51,2,"じじょう"],[54,1,"し"]],"text":"あなたがたのひとり、忠実な愛する兄弟オネシモをも、彼と共に送る。彼らはあなたがたに、こちらのいっさいの事情を知らせるであろう。"},{"ref":"Col.4.10","start":51004010,"end":51004010,"break":"paragraph","ruby":[[4,2,"いっしょ"],[7,1,"とら"],[11,1,"み"],[51,1,"い"],[70,1,"かれ"],[81,1,"い"],[86,1,"むか"],[110,1,"う"]],"text":"わたしと一緒に捕われの身となっているアリスタルコと、バルナバのいとこマルコとが、あなたがたによろしくと言っている。このマルコについては、もし彼があなたがたのもとに行くなら、迎えてやるようにとのさしずを、あなたがたはすでに受けているはずである。"},{"ref":"Col.4.11","start":51004011,"end":51004011,"break":"none","ruby":[[7,1,"よ"],[24,2,"かつれい"],[27,1,"もの"],[29,1,"なか"],[35,1,"にん"],[39,1,"かみ"],[41,1,"くに"],[46,1,"はたら"],[48,3,"どうろうしゃ"],[60,1,"なぐさ"],[66,1,"もの"]],"text":"また、ユストと呼ばれているイエスからもよろしく。割礼の者の中で、この三人だけが神の国のために働く同労者であって、わたしの慰めとなった者である。"},{"ref":"Col.4.12","start":51004012,"end":51004012,"break":"none","ruby":[[22,1,"しもべ"],[36,1,"かれ"],[42,1,"いのり"],[53,1,"おぼ"],[62,1,"まった"],[64,1,"ひと"],[69,1,"かみ"],[71,2,"みむね"],[79,2,"かくしん"],[83,1,"た"],[90,2,"ねっしん"],[93,1,"いの"]],"text":"あなたがたのうちのひとり、キリスト・イエスの僕エパフラスから、よろしく。彼はいつも、祈のうちであなたがたを覚え、あなたがたが全き人となり、神の御旨をことごとく確信して立つようにと、熱心に祈っている。"},{"ref":"Col.4.13","start":51004013,"end":51004013,"break":"none","ruby":[[5,1,"かれ"],[31,2,"ひとびと"],[43,2,"しんろう"],[53,2,"しょうげん"]],"text":"わたしは、彼があなたがたのため、またラオデキヤとヒエラポリスの人々のために、ひじょうに心労していることを、証言する。"},{"ref":"Col.4.14","start":51004014,"end":51004014,"break":"none","ruby":[[0,1,"あい"],[3,2,"いしゃ"]],"text":"愛する医者ルカとデマスとが、あなたがたによろしく。"},{"ref":"Col.4.15","start":51004015,"end":51004015,"break":"none","ruby":[[6,2,"きょうだい"],[20,1,"いえ"],[24,2,"きょうかい"]],"text":"ラオデキヤの兄弟たちに、またヌンパとその家にある教会とに、よろしく。"},{"ref":"Col.4.16","start":51004016,"end":51004016,"break":"none","ruby":[[2,2,"てがみ"],[11,1,"ところ"],[13,2,"ろうどく"],[26,2,"きょうかい"],[30,2,"ろうどく"],[39,1,"と"],[41,1,"はか"],[62,1,"く"],[64,2,"てがみ"],[74,2,"ろうどく"]],"text":"この手紙があなたがたの所で朗読されたら、ラオデキヤの教会でも朗読されるように、取り計らってほしい。またラオデキヤからまわって来る手紙を、あなたがたも朗読してほしい。"},{"ref":"Col.4.17","start":51004017,"end":51004017,"break":"none","ruby":[[7,1,"しゅ"],[12,1,"う"],[15,1,"つとめ"],[19,1,"はた"],[26,1,"つた"]],"text":"アルキポに、「主にあって受けた務をよく果すように」と伝えてほしい。"},{"ref":"Col.4.18","start":51004018,"end":51004018,"break":"paragraph","ruby":[[3,2,"じしん"],[7,1,"て"],[18,1,"か"],[25,1,"ごく"],[38,1,"おぼ"],[47,1,"めぐ"],[57,1,"とも"]],"text":"パウロ自身が、手ずからこのあいさつを書く。わたしが獄につながれていることを、覚えていてほしい。恵みが、あなたがたと共にあるように。"}]