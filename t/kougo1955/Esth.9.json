[{"ref":"Esth.9.1","start":17009001,"end":17009001,"break":"paragraph","ruby":[[2,1,"がつ"],[11,1,"つき"],[15,1,"にち"],[17,1,"おう"],[19,2,"めいれい"],[22,1,"みことのり"],[24,1,"おこな"],[28,1,"とき"],[30,1,"ちか"],[44,1,"じん"],[46,1,"てき"],[52,1,"じん"],[54,1,"う"],[56,1,"ふ"],[61,1,"のぞ"],[76,1,"じん"],[78,2,"じぶん"],[83,1,"にく"],[85,1,"もの"],[87,1,"う"],[89,1,"ふ"],[100,1,"ひ"]],"text":"十二月すなわちアダルの月の十三日、王の命令と詔の行われる時が近づいたとき、すなわちユダヤ人の敵が、ユダヤ人を打ち伏せようと望んでいたのに、かえってユダヤ人が自分たちを憎む者を打ち伏せることとなったその日に、"},{"ref":"Esth.9.2","start":17009002,"end":17009002,"break":"none","ruby":[[3,1,"じん"],[12,1,"おう"],[14,2,"かくしゅう"],[19,2,"じぶん"],[24,2,"まちまち"],[27,1,"あつ"],[31,2,"じぶん"],[36,1,"がい"],[38,1,"くわ"],[45,1,"もの"],[47,1,"ころ"],[61,1,"じん"],[63,1,"さか"],[84,1,"たみ"],[89,1,"じん"],[91,1,"おそ"]],"text":"ユダヤ人はアハシュエロス王の各州にある自分たちの町々に集まり、自分たちに害を加えようとする者を殺そうとしたが、だれもユダヤ人に逆らうことのできるものはなかった。すべての民がユダヤ人を恐れたからである。"},{"ref":"Esth.9.3","start":17009003,"end":17009003,"break":"none","ruby":[[0,1,"しょ"],[1,1,"しゅう"],[3,2,"だいじん"],[6,2,"そうとく"],[9,2,"ちじ"],[14,1,"おう"],[16,1,"こと"],[23,1,"もの"],[25,1,"みな"],[29,1,"じん"],[31,1,"たす"],[35,1,"かれ"],[44,1,"おそ"]],"text":"諸州の大臣、総督、知事および王の事をつかさどる者は皆ユダヤ人を助けた。彼らはモルデカイを恐れたからである。"},{"ref":"Esth.9.4","start":17009004,"end":17009004,"break":"none","ruby":[[6,1,"おう"],[8,1,"いえ"],[10,1,"おお"],[14,1,"もの"],[21,2,"めいせい"],[24,2,"かくしゅう"],[27,1,"きこ"],[36,1,"ひと"],[47,2,"せいりょく"],[51,1,"もの"]],"text":"モルデカイは王の家で大いなる者となり、その名声は各州に聞えわたった。この人モルデカイがますます勢力ある者となったからである。"},{"ref":"Esth.9.5","start":17009005,"end":17009005,"break":"none","ruby":[[6,1,"じん"],[19,1,"てき"],[21,1,"う"],[24,1,"ころ"],[27,1,"ほろ"],[31,2,"じぶん"],[36,1,"にく"],[38,1,"もの"],[40,1,"たい"],[42,1,"こころ"],[47,1,"い"]],"text":"そこでユダヤ人はつるぎをもってすべての敵を撃って殺し、滅ぼし、自分たちを憎む者に対し心のままに行った。"},{"ref":"Esth.9.6","start":17009006,"end":17009006,"break":"none","ruby":[[3,1,"じん"],[7,2,"しゅと"],[18,1,"にん"],[20,1,"ころ"],[23,1,"ほろ"]],"text":"ユダヤ人はまた首都スサにおいても五百人を殺し、滅ぼした。"},{"ref":"Esth.9.7","start":17009007,"end":17009007,"break":"none","text":"またパルシャンダタ、ダルポン、アスパタ、"},{"ref":"Esth.9.8","start":17009008,"end":17009008,"break":"none","text":"ポラタ、アダリヤ、アリダタ、"},{"ref":"Esth.9.9","start":17009009,"end":17009009,"break":"none","text":"パルマシタ、アリサイ、アリダイ、ワエザタ、"},{"ref":"Esth.9.10","start":17009010,"end":17009010,"break":"none","ruby":[[10,1,"こ"],[16,1,"じん"],[18,1,"てき"],[27,1,"にん"],[29,1,"こ"],[32,1,"ころ"],[46,1,"もの"],[49,1,"て"]],"text":"すなわちハンメダタの子で、ユダヤ人の敵であるハマンの十人の子をも殺した。しかし、そのぶんどり物には手をかけなかった。"},{"ref":"Esth.9.11","start":17009011,"end":17009011,"break":"paragraph","ruby":[[2,1,"ひ"],[4,2,"しゅと"],[9,1,"ころ"],[13,1,"もの"],[15,1,"かず"],[17,1,"おう"],[19,2,"ほうこく"]],"text":"その日、首都スサで殺された者の数が王に報告されると、"},{"ref":"Esth.9.12","start":17009012,"end":17009012,"break":"none","ruby":[[0,1,"おう"],[2,2,"おうひ"],[9,1,"い"],[17,1,"じん"],[19,2,"しゅと"],[26,1,"にん"],[28,1,"ころ"],[38,1,"にん"],[40,1,"こ"],[42,1,"ころ"],[46,1,"おう"],[50,1,"た"],[52,1,"しょ"],[53,1,"しゅう"],[60,1,"かれ"],[63,1,"ころ"],[79,1,"もと"],[85,1,"なに"],[88,1,"かなら"],[90,1,"き"],[95,1,"さら"],[101,1,"ねが"],[104,1,"なに"],[107,1,"かなら"],[109,1,"き"]],"text":"王は王妃エステルに言った、「ユダヤ人は首都スサで五百人を殺し、またハマンの十人の子を殺した。王のその他の諸州ではどんなに彼らは殺したことであろう。さてあなたの求めることは何か。必ず聞かれる。更にあなたの願いは何か。必ず聞きとどけられる」。"},{"ref":"Esth.9.13","start":17009013,"end":17009013,"break":"none","ruby":[[5,1,"い"],[12,1,"おう"],[35,1,"じん"],[45,1,"みことのり"],[50,1,"おこな"],[71,1,"にん"],[73,1,"こ"],[75,1,"き"],[77,1,"か"]],"text":"エステルは言った、「もし王がよしとされるならば、どうぞスサにいるユダヤ人にあすも、きょうの詔のように行うことをゆるしてください。かつハマンの十人の子を木に掛けさせてください」。"},{"ref":"Esth.9.14","start":17009014,"end":17009014,"break":"none","ruby":[[0,1,"おう"],[7,1,"めい"],[19,1,"みことのり"],[21,1,"で"],[29,1,"にん"],[31,1,"こ"],[33,1,"き"],[35,1,"か"]],"text":"王はそうせよと命じたので、スサにおいて詔が出て、ハマンの十人の子は木に掛けられた。"},{"ref":"Esth.9.15","start":17009015,"end":17009015,"break":"none","ruby":[[4,1,"つき"],[8,1,"か"],[20,1,"じん"],[22,1,"あつ"],[31,1,"にん"],[33,1,"ころ"],[47,1,"もの"],[50,1,"て"]],"text":"アダルの月の十四日にまたスサにいるユダヤ人が集まり、スサで三百人を殺した。しかし、そのぶんどり物には手をかけなかった。"},{"ref":"Esth.9.16","start":17009016,"end":17009016,"break":"paragraph","ruby":[[0,1,"おう"],[2,1,"しょ"],[3,1,"しゅう"],[7,1,"た"],[12,1,"じん"],[16,1,"あつ"],[21,2,"じぶん"],[26,2,"せいめい"],[29,2,"ほご"],[35,1,"てき"],[37,1,"か"],[40,2,"へいあん"],[43,1,"え"],[45,2,"じぶん"],[50,1,"にく"],[52,1,"もの"],[57,1,"にん"],[59,1,"ころ"],[73,1,"もの"],[76,1,"て"]],"text":"王の諸州にいる他のユダヤ人もまた集まって、自分たちの生命を保護し、その敵に勝って平安を得、自分たちを憎む者七万五千人を殺した。しかし、そのぶんどり物には手をかけなかった。"},{"ref":"Esth.9.17","start":17009017,"end":17009017,"break":"none","ruby":[[7,1,"つき"],[11,1,"にち"],[21,1,"か"],[23,1,"やす"],[29,1,"ひ"],[31,2,"しゅえん"],[34,1,"よろこ"],[37,1,"ひ"]],"text":"これはアダルの月の十三日であって、その十四日に休んで、その日を酒宴と喜びの日とした。"},{"ref":"Esth.9.18","start":17009018,"end":17009018,"break":"none","ruby":[[11,1,"じん"],[15,1,"にち"],[19,1,"か"],[21,1,"あつ"],[27,1,"にち"],[29,1,"やす"],[35,1,"ひ"],[37,2,"しゅえん"],[40,1,"よろこ"],[43,1,"ひ"]],"text":"しかしスサにいるユダヤ人は十三日と十四日に集まり、十五日に休んで、その日を酒宴と喜びの日とした。"},{"ref":"Esth.9.19","start":17009019,"end":17009019,"break":"none","ruby":[[4,2,"むらむら"],[10,1,"じん"],[15,2,"じょうへき"],[20,2,"まちまち"],[23,1,"す"],[25,1,"もの"],[31,1,"つき"],[35,1,"か"],[37,1,"よろこ"],[40,1,"ひ"],[42,2,"しゅえん"],[45,1,"ひ"],[47,2,"しゅくじつ"],[52,1,"たがい"],[54,1,"た"],[56,1,"もの"],[58,1,"おく"],[60,1,"ひ"]],"text":"それゆえ村々のユダヤ人すなわち城壁のない町々に住む者はアダルの月の十四日を喜びの日、酒宴の日、祝日とし、互に食べ物を贈る日とした。"},{"ref":"Esth.9.20","start":17009020,"end":17009020,"break":"paragraph","ruby":[[13,1,"か"],[26,1,"おう"],[28,1,"しょ"],[29,1,"しゅう"],[40,1,"じん"],[43,1,"ちか"],[45,1,"もの"],[48,1,"とお"],[50,1,"もの"],[53,1,"しょ"],[55,1,"おく"]],"text":"モルデカイはこれらのことを書きしるしてアハシュエロス王の諸州にいるすべてのユダヤ人に、近い者にも遠い者にも書を送り、"},{"ref":"Esth.9.21","start":17009021,"end":17009021,"break":"none","ruby":[[4,1,"つき"],[8,1,"か"],[12,1,"にち"],[15,2,"ねんねん"],[17,1,"いわ"],[22,1,"めい"]],"text":"アダルの月の十四日と十五日とを年々祝うことを命じた。"},{"ref":"Esth.9.22","start":17009022,"end":17009022,"break":"none","ruby":[[6,2,"りょうじつ"],[12,1,"じん"],[16,1,"てき"],[18,1,"か"],[21,2,"へいあん"],[24,1,"え"],[30,1,"つき"],[32,1,"かれ"],[38,1,"うれ"],[42,1,"よろこ"],[45,1,"かわ"],[48,1,"かな"],[53,2,"しゅくじつ"],[56,1,"かわ"],[66,2,"しゅえん"],[69,1,"よろこ"],[72,1,"ひ"],[77,1,"たがい"],[79,1,"た"],[81,1,"もの"],[83,1,"おく"],[86,1,"まず"],[89,1,"もの"],[91,1,"ほどこ"],[96,1,"ひ"]],"text":"すなわちこの両日にユダヤ人がその敵に勝って平安を得、またこの月は彼らのために憂いから喜びに変り、悲しみから祝日に変ったので、これらを酒宴と喜びの日として、互に食べ物を贈り、貧しい者に施しをする日とせよとさとした。"},{"ref":"Esth.9.23","start":17009023,"end":17009023,"break":"paragraph","ruby":[[6,1,"じん"],[8,1,"かれ"],[14,1,"はじ"],[29,1,"かれ"],[32,1,"か"],[34,1,"おく"],[41,1,"おこな"],[46,2,"やくそく"]],"text":"そこでユダヤ人は彼らがすでに始めたように、またモルデカイが彼らに書き送ったように、行うことを約束した。"},{"ref":"Esth.9.24","start":17009024,"end":17009024,"break":"none","ruby":[[14,1,"こ"],[30,1,"じん"],[32,1,"てき"],[37,1,"じん"],[39,1,"ほろ"],[57,1,"な"],[60,1,"かれ"],[63,1,"た"],[67,1,"ほろ"]],"text":"これはアガグびとハンメダタの子ハマン、すなわちすべてのユダヤ人の敵がユダヤ人を滅ぼそうとはかり、プルすなわちくじを投げて彼らを絶やし、滅ぼそうとしたが、"},{"ref":"Esth.9.25","start":17009025,"end":17009025,"break":"none","ruby":[[5,1,"おう"],[7,1,"まえ"],[14,1,"おう"],[16,1,"しょ"],[18,1,"おく"],[21,1,"めい"],[31,1,"じん"],[33,1,"たい"],[36,1,"くわだ"],[41,1,"わる"],[43,2,"けいかく"],[50,2,"ずじょう"],[53,1,"のぞ"],[57,1,"かれ"],[61,1,"こ"],[64,1,"き"],[66,1,"か"]],"text":"エステルが王の前にきたとき、王は書を送って命じ、ハマンがユダヤ人に対して企てたその悪い計画をハマンの頭上に臨ませ、彼とその子らを木に掛けさせたからである。"},{"ref":"Esth.9.26","start":17009026,"end":17009026,"break":"none","ruby":[[8,2,"りょうじつ"],[14,1,"な"],[25,1,"な"],[35,1,"しょ"],[41,2,"ことば"],[51,1,"こと"],[56,1,"み"],[62,2,"じぶん"],[67,1,"あ"]],"text":"このゆえに、この両日をプルの名にしたがってプリムと名づけた。そしてこの書のすべての言葉により、またこの事について見たところ、自分たちの会ったところによって、"},{"ref":"Esth.9.27","start":17009027,"end":17009027,"break":"none","ruby":[[3,1,"じん"],[5,1,"あい"],[6,1,"さだ"],[9,2,"ねんねん"],[13,1,"か"],[30,1,"さだ"],[35,1,"とき"],[45,2,"りょうじつ"],[48,1,"まも"],[51,2,"じぶん"],[59,2,"しそん"],[67,2,"じぶん"],[76,1,"もの"],[81,1,"おこな"],[83,1,"つづ"],[86,1,"はい"]],"text":"ユダヤ人は相定め、年々その書かれているところにしたがい、その定められた時にしたがって、この両日を守り、自分たちと、その子孫およびすべて自分たちにつらなる者はこれを行い続けて廃することなく、"},{"ref":"Esth.9.28","start":17009028,"end":17009028,"break":"none","ruby":[[2,2,"りょうじつ"],[6,2,"よよ"],[9,2,"いえいえ"],[12,2,"しゅうじゅう"],[15,2,"まちまち"],[21,1,"かなら"],[23,1,"おぼ"],[26,1,"まも"],[43,1,"ひ"],[48,1,"じん"],[53,1,"はい"],[72,2,"きねん"],[77,2,"しそん"],[80,1,"なか"],[82,1,"た"]],"text":"この両日を、代々、家々、州々、町々において必ず覚えて守るべきものとし、これらのプリムの日がユダヤ人のうちに廃せられることのないようにし、またこの記念がその子孫の中に絶えることのないようにした。"},{"ref":"Esth.9.29","start":17009029,"end":17009029,"break":"paragraph","ruby":[[9,1,"むすめ"],[13,2,"おうひ"],[23,1,"じん"],[31,2,"けんい"],[43,1,"だい"],[46,1,"しょ"],[48,1,"か"],[54,1,"たし"]],"text":"さらにアビハイルの娘である王妃エステルとユダヤ人モルデカイは、権威をもってこのプリムの第二の書を書き、それを確かめた。"},{"ref":"Esth.9.30","start":17009030,"end":17009030,"break":"none","ruby":[[11,1,"くに"],[17,1,"しゅう"],[28,1,"じん"],[31,2,"へいわ"],[34,2,"しんじつ"],[37,2,"ことば"],[43,1,"しょ"],[45,1,"おく"]],"text":"そしてアハシュエロスの国の百二十七州にいるすべてのユダヤ人に、平和と真実の言葉をもって書を送り、"},{"ref":"Esth.9.31","start":17009031,"end":17009031,"break":"none","ruby":[[0,2,"だんじき"],[3,1,"かな"],[17,1,"じん"],[24,2,"おうひ"],[38,1,"じん"],[40,1,"めい"],[52,1,"じん"],[60,2,"じぶん"],[67,2,"しそん"],[73,1,"さだ"],[88,1,"ひ"],[92,1,"さだ"],[95,1,"とき"],[97,1,"まも"]],"text":"断食と悲しみのことについて、ユダヤ人モルデカイと王妃エステルが、かつてユダヤ人に命じたように、またユダヤ人たちが、かつて自分たちとその子孫のために定めたように、プリムのこれらの日をその定めた時に守らせた。"},{"ref":"Esth.9.32","start":17009032,"end":17009032,"break":"none","ruby":[[5,2,"めいれい"],[12,1,"かん"],[19,1,"こと"],[21,2,"かくてい"],[31,1,"しょ"]],"text":"エステルの命令はプリムに関するこれらの事を確定した。またこれは書にしるされた。"}]