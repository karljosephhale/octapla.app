[{"ref":"Nah.2.1","start":34002001,"end":34002001,"break":"paragraph","breaks":[[6,"line"],[20,"line"],[32,"line"]],"ruby":[[0,1,"う"],[2,1,"やぶ"],[4,1,"もの"],[10,1,"む"],[14,1,"のぼ"],[17,1,"く"],[20,1,"しろ"],[22,1,"まも"],[25,1,"みち"],[32,1,"こし"],[34,1,"おび"],[38,1,"おお"],[41,1,"ちから"],[43,1,"つよ"]],"text":"撃ち破る者があなたに向かって上って来る。城を守れ、道をうかがえ。腰に帯せよ、大いに力を強くせよ。"},{"ref":"Nah.2.2","start":34002002,"end":34002002,"break":"stanza","breaks":[[14,"line"],[30,"line"],[43,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"さか"],[9,2,"かいふく"],[20,1,"さか"],[34,1,"もの"],[36,1,"かれ"]],"text":"主はヤコブの栄えを回復して、イスラエルの栄えのようにされる。かすめる者が彼らをかすめ、そのぶどうづるを、そこなったからである。"},{"ref":"Nah.2.3","start":34002003,"end":34002003,"break":"stanza","breaks":[[15,"line"],[28,"line"],[47,"line"]],"ruby":[[2,2,"ゆうし"],[5,1,"たて"],[7,1,"あか"],[17,2,"へいし"],[20,1,"くれない"],[22,1,"み"],[28,2,"せんしゃ"],[33,1,"そな"],[36,1,"ひ"],[39,1,"ひ"],[44,1,"かがや"],[47,2,"ぐんば"]],"text":"その勇士の盾は赤くいろどられ、その兵士は紅に身をよろう。戦車はその備えの日に、火のように輝き、軍馬はおどる。"},{"ref":"Nah.2.4","start":34002004,"end":34002004,"break":"line","breaks":[[12,"line"],[21,"line"],[35,"line"]],"ruby":[[0,2,"せんしゃ"],[7,1,"くる"],[9,1,"はし"],[12,2,"おおじ"],[15,1,"と"],[21,1,"かれ"],[32,1,"かがや"],[43,1,"と"]],"text":"戦車はちまたに狂い走り、大路に飛びかける。彼らはたいまつのように輝き、いなずまのように飛びかける。"},{"ref":"Nah.2.5","start":34002005,"end":34002005,"break":"line","breaks":[[9,"line"],[23,"line"]],"ruby":[[0,2,"しょうし"],[4,2,"しょうしゅう"],[9,1,"かれ"],[14,1,"みち"],[20,1,"たお"],[23,2,"じょうへき"],[26,1,"む"],[30,1,"いそ"],[33,1,"い"],[36,2,"おおだて"],[39,1,"そな"]],"text":"将士らは召集され、彼らはその道でつまずき倒れ、城壁に向かって急いで行って大盾を備える。"},{"ref":"Nah.2.6","start":34002006,"end":34002006,"break":"line","breaks":[[8,"line"]],"ruby":[[0,2,"かわがわ"],[3,1,"もん"],[5,1,"ひら"],[8,2,"きゅうでん"]],"text":"川々の門は開け、宮殿はあわてふためく。"},{"ref":"Nah.2.7","start":34002007,"end":34002007,"break":"line","breaks":[[17,"line"],[28,"line"]],"ruby":[[2,2,"おうひ"],[5,1,"はだか"],[11,1,"とら"],[19,2,"じじょ"],[24,1,"かな"],[28,1,"むね"],[30,1,"う"]],"text":"その王妃は裸にされて、捕われゆき、その侍女たちは悲しみ、胸を打って、はとのようにうめく。"},{"ref":"Nah.2.8","start":34002008,"end":34002008,"break":"line","breaks":[[14,"line"],[25,"line"],[44,"line"]],"ruby":[[4,1,"いけ"],[16,1,"みず"],[18,1,"そそ"],[20,1,"だ"],[26,1,"た"],[28,1,"ど"],[32,1,"た"],[34,1,"ど"],[39,1,"よ"]],"text":"ニネベは池のようであったが、その水は注ぎ出された。「立ち止まれ、立ち止まれ」と呼んでも、ふりかえるものもない。"},{"ref":"Nah.2.9","start":34002009,"end":34002009,"break":"line","breaks":[[10,"line"],[19,"line"]],"ruby":[[0,1,"ぎん"],[2,1,"うば"],[5,1,"きん"],[7,1,"うば"],[12,1,"たから"],[14,1,"かぎ"],[24,1,"たっと"],[26,1,"もの"]],"text":"銀を奪え、金を奪え。その宝は限りなく、もろもろの尊い物はおびただしい。"},{"ref":"Nah.2.10","start":34002010,"end":34002010,"break":"stanza","breaks":[[18,"line"],[29,"line"],[42,"line"]],"ruby":[[0,1,"き"],[12,1,"あ"],[18,1,"こころ"],[20,1,"き"],[26,1,"ふる"],[33,1,"こし"],[36,1,"いた"],[46,1,"かお"],[48,1,"いろ"],[50,1,"うしな"]],"text":"消えうせ、むなしくなり、荒れはてた。心は消え、ひざは震え、すべての腰には痛みがあり、すべての顔は色を失った。"},{"ref":"Nah.2.11","start":34002011,"end":34002011,"break":"line","breaks":[[14,"line"],[28,"line"],[45,"line"]],"ruby":[[14,1,"わか"],[19,1,"あな"],[31,1,"お"],[37,2,"えもの"],[40,1,"たずさ"],[42,1,"い"],[47,1,"こ"],[51,1,"とも"],[60,1,"おそ"],[65,1,"もの"]],"text":"ししのすみかはどこであるか。若いししの穴はどこであるか。そこに雄じしはその獲物を携え行き、その子じしと共にいても、これを恐れさせる者はない。"},{"ref":"Nah.2.12","start":34002012,"end":34002012,"break":"line","breaks":[[18,"line"],[33,"line"],[47,"line"]],"ruby":[[0,1,"お"],[6,1,"こ"],[13,1,"ひ"],[15,1,"さ"],[18,1,"め"],[25,2,"えもの"],[28,1,"し"],[30,1,"ころ"],[33,2,"えもの"],[41,1,"あな"],[43,1,"み"],[47,1,"ひ"],[49,1,"さ"],[52,1,"にく"],[63,1,"み"]],"text":"雄じしはその子じしのために引き裂き、雌じしのために獲物を絞め殺し、獲物をもってその穴を満たし、引き裂いた肉をもってそのすみかを満たした。"},{"ref":"Nah.2.13","start":34002013,"end":34002013,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[10,1,"み"],[21,1,"のぞ"],[32,2,"せんしゃ"],[35,1,"や"],[38,1,"けむり"],[51,1,"わか"],[56,1,"ほろ"],[71,2,"えもの"],[74,1,"ち"],[77,1,"た"],[84,2,"ししゃ"],[87,1,"こえ"],[89,1,"かさ"],[92,1,"き"]],"text":"万軍の主は言われる、見よ、わたしはあなたに臨む。わたしはあなたの戦車を焼いて煙にする。つるぎはあなたの若いししを滅ぼす。わたしはまた、あなたの獲物を地から断つ。あなたの使者の声は重ねて聞かれない。"}]