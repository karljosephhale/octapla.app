[{"ref":"Eccl.8.1","start":21008001,"end":21008001,"break":"paragraph","breaks":[[15,"line"],[29,"line"],[44,"line"]],"ruby":[[3,2,"ちしゃ"],[11,1,"え"],[18,1,"こと"],[20,2,"いぎ"],[23,1,"し"],[25,1,"え"],[29,1,"ひと"],[31,2,"ちえ"],[36,1,"ひと"],[38,1,"かお"],[40,1,"かがや"],[48,2,"そぼう"],[51,1,"かお"],[53,1,"か"]],"text":"だれが知者のようになり得よう。だれが事の意義を知り得よう。人の知恵はその人の顔を輝かせ、またその粗暴な顔を変える。"},{"ref":"Eccl.8.2","start":21008002,"end":21008002,"break":"paragraph","ruby":[[0,1,"おう"],[2,1,"めい"],[4,1,"まも"],[10,1,"かみ"],[15,1,"ちか"],[23,1,"おどろ"]],"text":"王の命を守れ。すでに神をさして誓ったことゆえ、驚くな。"},{"ref":"Eccl.8.3","start":21008003,"end":21008003,"break":"none","ruby":[[0,1,"こと"],[2,1,"わる"],[4,1,"とき"],[7,1,"おう"],[9,1,"まえ"],[11,1,"さ"],[20,1,"かれ"],[27,1,"この"]],"text":"事が悪い時は、王の前を去れ、ためらうな。彼はすべてその好むところをなすからである。"},{"ref":"Eccl.8.4","start":21008004,"end":21008004,"break":"none","ruby":[[0,1,"おう"],[2,2,"ことば"],[5,3,"けっていてき"],[15,1,"かれ"],[22,1,"なに"],[30,1,"い"]],"text":"王の言葉は決定的である。だれが彼に「あなたは何をするのか」と言うことができようか。"},{"ref":"Eccl.8.5","start":21008005,"end":21008005,"break":"none","ruby":[[0,2,"めいれい"],[3,1,"まも"],[5,1,"もの"],[7,1,"わざわい"],[14,2,"ちしゃ"],[17,1,"こころ"],[19,1,"とき"],[21,2,"ほうほう"]],"text":"命令を守る者は災にあわない。知者の心は時と方法をわきまえている。"},{"ref":"Eccl.8.6","start":21008006,"end":21008006,"break":"none","ruby":[[0,1,"ひと"],[2,1,"あく"],[4,1,"かれ"],[6,1,"うえ"],[8,1,"おも"],[21,1,"とき"],[23,2,"ほうほう"]],"text":"人の悪が彼の上に重くても、すべてのわざには時と方法がある。"},{"ref":"Eccl.8.7","start":21008007,"end":21008007,"break":"none","ruby":[[0,1,"のち"],[2,1,"おこ"],[4,1,"こと"],[6,1,"し"],[8,1,"もの"],[16,1,"こと"],[18,1,"おこ"],[25,1,"かれ"],[27,1,"つ"],[29,1,"え"]],"text":"後に起る事を知る者はない。どんな事が起るかをだれが彼に告げ得よう。"},{"ref":"Eccl.8.8","start":21008008,"end":21008008,"break":"none","ruby":[[0,1,"かぜ"],[6,1,"ちから"],[10,1,"ひと"],[17,1,"し"],[19,1,"ひ"],[32,1,"たたか"],[36,2,"めんじょ"],[44,1,"あく"],[49,1,"おこな"],[51,1,"もの"],[53,1,"すく"]],"text":"風をとどめる力をもつ人はない。また死の日をつかさどるものはない。戦いには免除はない。また悪はこれを行う者を救うことができない。"},{"ref":"Eccl.8.9","start":21008009,"end":21008009,"break":"none","ruby":[[10,1,"こと"],[12,1,"み"],[17,1,"ひ"],[19,1,"した"],[21,1,"おこな"],[33,1,"こころ"],[35,1,"もち"],[39,1,"とき"],[46,1,"ひと"],[51,1,"ひと"],[53,1,"おさ"],[60,1,"がい"]],"text":"わたしはこのすべての事を見た。また日の下に行われるもろもろのわざに心を用いた。時としてはこの人が、かの人を治めて、これに害をこうむらせることがある。"},{"ref":"Eccl.8.10","start":21008010,"end":21008010,"break":"paragraph","ruby":[[6,2,"あくにん"],[9,1,"ほうむ"],[15,1,"み"],[18,1,"かれ"],[24,2,"せいじょ"],[27,2,"でい"],[35,1,"おこな"],[40,1,"まち"],[53,1,"くう"]],"text":"またわたしは悪人の葬られるのを見た。彼らはいつも聖所に出入りし、それを行ったその町でほめられた。これもまた空である。"},{"ref":"Eccl.8.11","start":21008011,"end":21008011,"break":"none","ruby":[[0,1,"あ"],[6,1,"たい"],[9,2,"はんけつ"],[17,1,"おこな"],[26,1,"ひと"],[28,1,"こ"],[31,1,"こころ"],[37,1,"あく"],[39,1,"おこな"],[44,1,"かたむ"]],"text":"悪しきわざに対する判決がすみやかに行われないために、人の子らの心はもっぱら悪を行うことに傾いている。"},{"ref":"Eccl.8.12","start":21008012,"end":21008012,"break":"none","ruby":[[0,1,"つみ"],[5,1,"ど"],[6,1,"あく"],[14,2,"ながい"],[29,1,"かみ"],[37,1,"まえ"],[39,1,"おそ"],[45,1,"もの"],[48,2,"こうふく"],[61,1,"し"]],"text":"罪びとで百度悪をなして、なお長生きするものがあるけれども、神をかしこみ、み前に恐れをいだく者には幸福があることを、わたしは知っている。"},{"ref":"Eccl.8.13","start":21008013,"end":21008013,"break":"none","ruby":[[3,2,"あくにん"],[7,2,"こうふく"],[17,1,"いのち"],[19,1,"かげ"],[27,1,"なが"],[30,1,"つづ"],[35,1,"かれ"],[37,1,"かみ"],[39,1,"まえ"],[41,1,"おそ"]],"text":"しかし悪人には幸福がない。またその命は影のようであって長くは続かない。彼は神の前に恐れをいだかないからである。"},{"ref":"Eccl.8.14","start":21008014,"end":21008014,"break":"paragraph","ruby":[[0,1,"ち"],[2,1,"うえ"],[4,1,"くう"],[6,1,"こと"],[8,1,"おこな"],[20,2,"ぎじん"],[27,2,"あくにん"],[30,1,"のぞ"],[34,1,"こと"],[39,1,"み"],[41,1,"のぞ"],[43,1,"もの"],[51,2,"あくにん"],[58,2,"ぎじん"],[61,1,"のぞ"],[65,1,"こと"],[70,1,"み"],[72,1,"のぞ"],[74,1,"もの"],[83,1,"い"],[92,1,"くう"]],"text":"地の上に空な事が行われている。すなわち、義人であって、悪人に臨むべき事が、その身に臨む者がある。また、悪人であって、義人に臨むべき事が、その身に臨む者がある。わたしは言った、これもまた空であると。"},{"ref":"Eccl.8.15","start":21008015,"end":21008015,"break":"none","ruby":[[8,2,"かんらく"],[19,1,"ひ"],[21,1,"した"],[25,1,"ひと"],[31,1,"く"],[34,1,"の"],[37,1,"たの"],[45,1,"よ"],[47,1,"こと"],[62,1,"ひ"],[64,1,"した"],[67,1,"かみ"],[69,1,"たま"],[73,1,"いのち"],[75,1,"ひ"],[77,1,"あいだ"],[81,2,"きんろう"],[89,1,"み"],[91,1,"ともな"]],"text":"そこで、わたしは歓楽をたたえる。それは日の下では、人にとって、食い、飲み、楽しむよりほかに良い事はないからである。これこそは日の下で、神が賜わった命の日の間、その勤労によってその身に伴うものである。"},{"ref":"Eccl.8.16","start":21008016,"end":21008016,"break":"paragraph","ruby":[[4,1,"こころ"],[10,2,"ちえ"],[13,1,"し"],[21,2,"ちじょう"],[24,1,"おこな"],[31,1,"ひる"],[33,1,"よる"],[35,1,"ねむ"],[39,1,"きわ"]],"text":"わたしは心をつくして知恵を知ろうとし、また地上に行われるわざを昼も夜も眠らずに窮めようとしたとき、"},{"ref":"Eccl.8.17","start":21008017,"end":21008017,"break":"none","ruby":[[4,1,"かみ"],[14,1,"み"],[18,1,"ひと"],[20,1,"ひ"],[22,1,"した"],[24,1,"おこな"],[31,1,"きわ"],[42,1,"ひと"],[47,1,"たず"],[52,1,"ろう"],[60,1,"きわ"],[77,2,"ちしゃ"],[87,1,"し"],[91,1,"おも"],[99,1,"きわ"]],"text":"わたしは神のもろもろのわざを見たが、人は日の下に行われるわざを窮めることはできない。人はこれを尋ねようと労しても、これを窮めることはできない。また、たとい知者があって、これを知ろうと思っても、これを窮めることはできないのである。"}]