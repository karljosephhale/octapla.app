[{"ref":"Luke.18.1","start":42018001,"end":42018001,"break":"paragraph","ruby":[[7,2,"しつぼう"],[12,1,"つね"],[14,1,"いの"],[22,2,"ひとびと"],[25,1,"たとえ"],[27,1,"おし"]],"text":"また、イエスは失望せずに常に祈るべきことを、人々に譬で教えられた。"},{"ref":"Luke.18.2","start":42018002,"end":42018002,"break":"none","ruby":[[3,1,"まち"],[6,1,"かみ"],[8,1,"おそ"],[12,1,"ひと"],[14,1,"ひと"],[17,1,"おも"],[20,3,"さいばんかん"]],"text":"「ある町に、神を恐れず、人を人とも思わぬ裁判官がいた。"},{"ref":"Luke.18.3","start":42018003,"end":42018003,"break":"none","ruby":[[7,1,"おな"],[9,1,"まち"],[22,1,"かれ"],[43,1,"うった"],[46,1,"もの"],[57,1,"まも"],[66,1,"ねが"]],"text":"ところが、その同じ町にひとりのやもめがいて、彼のもとにたびたびきて、『どうぞ、わたしを訴える者をさばいて、わたしを守ってください』と願いつづけた。"},{"ref":"Luke.18.4","start":42018004,"end":42018004,"break":"none","ruby":[[0,1,"かれ"],[7,1,"あいだ"],[10,1,"い"],[24,1,"こころ"],[29,1,"かんが"],[38,1,"かみ"],[41,1,"おそ"],[45,1,"ひと"],[47,1,"ひと"],[50,1,"おも"]],"text":"彼はしばらくの間きき入れないでいたが、そののち、心のうちで考えた、『わたしは神をも恐れず、人を人とも思わないが、"},{"ref":"Luke.18.5","start":42018005,"end":42018005,"break":"none","ruby":[[10,2,"めんどう"],[19,2,"かのじょ"],[27,2,"さいばん"],[42,1,"た"],[54,1,"なや"]],"text":"このやもめがわたしに面倒をかけるから、彼女のためになる裁判をしてやろう。そうしたら、絶えずやってきてわたしを悩ますことがなくなるだろう』」。"},{"ref":"Luke.18.6","start":42018006,"end":42018006,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"い"],[13,2,"ふぎ"],[16,3,"さいばんかん"],[20,1,"い"],[28,1,"き"]],"text":"そこで主は言われた、「この不義な裁判官の言っていることを聞いたか。"},{"ref":"Luke.18.7","start":42018007,"end":42018007,"break":"none","ruby":[[3,1,"かみ"],[6,2,"にちや"],[8,1,"さけ"],[10,1,"もと"],[13,2,"せんみん"],[20,1,"ただ"],[35,1,"なが"],[37,1,"あいだ"]],"text":"まして神は、日夜叫び求める選民のために、正しいさばきをしてくださらずに長い間そのままにしておかれることがあろうか。"},{"ref":"Luke.18.8","start":42018008,"end":42018008,"break":"none","ruby":[[6,1,"い"],[13,1,"かみ"],[37,1,"ひと"],[39,1,"こ"],[41,1,"く"],[46,2,"ちじょう"],[49,2,"しんこう"],[52,1,"み"]],"text":"あなたがたに言っておくが、神はすみやかにさばいてくださるであろう。しかし、人の子が来るとき、地上に信仰が見られるであろうか」。"},{"ref":"Luke.18.9","start":42018009,"end":42018009,"break":"paragraph","ruby":[[0,2,"じぶん"],[3,2,"ぎじん"],[7,2,"じにん"],[11,2,"たにん"],[14,2,"みさ"],[20,1,"ひと"],[24,1,"たい"],[36,1,"たとえ"],[39,1,"はな"]],"text":"自分を義人だと自任して他人を見下げている人たちに対して、イエスはまたこの譬をお話しになった。"},{"ref":"Luke.18.10","start":42018010,"end":42018010,"break":"none","ruby":[[5,1,"ひと"],[7,1,"いの"],[12,1,"みや"],[14,1,"のぼ"],[28,1,"びと"],[39,3,"しゅぜいにん"]],"text":"「ふたりの人が祈るために宮に上った。そのひとりはパリサイ人であり、もうひとりは取税人であった。"},{"ref":"Luke.18.11","start":42018011,"end":42018011,"break":"none","ruby":[[4,1,"びと"],[6,1,"た"],[16,1,"いの"],[21,1,"かみ"],[31,1,"ひと"],[38,2,"どんよく"],[41,1,"もの"],[43,2,"ふせい"],[46,1,"もの"],[48,2,"かんいん"],[53,1,"もの"],[64,3,"しゅぜいにん"],[71,2,"にんげん"],[80,2,"かんしゃ"]],"text":"パリサイ人は立って、ひとりでこう祈った、『神よ、わたしはほかの人たちのような貪欲な者、不正な者、姦淫をする者ではなく、また、この取税人のような人間でもないことを感謝します。"},{"ref":"Luke.18.12","start":42018012,"end":42018012,"break":"none","ruby":[[5,1,"しゅう"],[8,1,"ど"],[9,2,"だんじき"],[16,1,"ぜん"],[17,2,"しゅうにゅう"],[21,1,"ぶん"]],"text":"わたしは一週に二度断食しており、全収入の十分の一をささげています』。"},{"ref":"Luke.18.13","start":42018013,"end":42018013,"break":"none","ruby":[[5,3,"しゅぜいにん"],[9,1,"とお"],[11,1,"はな"],[14,1,"た"],[17,1,"め"],[19,1,"てん"],[32,1,"むね"],[34,1,"う"],[39,1,"い"],[44,2,"かみさま"],[47,2,"つみびと"]],"text":"ところが、取税人は遠く離れて立ち、目を天にむけようともしないで、胸を打ちながら言った、『神様、罪人のわたしをおゆるしください』と。"},{"ref":"Luke.18.14","start":42018014,"end":42018014,"break":"none","ruby":[[6,1,"い"],[12,1,"かみ"],[14,1,"ぎ"],[19,2,"じぶん"],[22,1,"いえ"],[24,1,"かえ"],[32,3,"しゅぜいにん"],[46,1,"びと"],[59,2,"じぶん"],[62,1,"たか"],[66,1,"もの"],[68,1,"ひく"],[73,2,"じぶん"],[76,1,"ひく"],[80,1,"もの"],[82,1,"たか"]],"text":"あなたがたに言っておく。神に義とされて自分の家に帰ったのは、この取税人であって、あのパリサイ人ではなかった。おおよそ、自分を高くする者は低くされ、自分を低くする者は高くされるであろう」。"},{"ref":"Luke.18.15","start":42018015,"end":42018015,"break":"paragraph","ruby":[[16,2,"ひとびと"],[19,1,"おさ"],[21,1,"ご"],[28,1,"つ"],[39,2,"でし"],[47,1,"み"],[50,1,"かれ"]],"text":"イエスにさわっていただくために、人々が幼な子らをみもとに連れてきた。ところが、弟子たちはそれを見て、彼らをたしなめた。"},{"ref":"Luke.18.16","start":42018016,"end":42018016,"break":"none","ruby":[[7,1,"おさ"],[9,1,"ご"],[12,1,"よ"],[14,1,"よ"],[17,1,"い"],[23,1,"おさ"],[25,1,"ご"],[36,1,"く"],[49,1,"と"],[58,1,"かみ"],[60,1,"くに"],[67,1,"もの"],[69,1,"くに"]],"text":"するとイエスは幼な子らを呼び寄せて言われた、「幼な子らをわたしのところに来るままにしておきなさい、止めてはならない。神の国はこのような者の国である。"},{"ref":"Luke.18.17","start":42018017,"end":42018017,"break":"none","ruby":[[2,1,"き"],[15,1,"おさ"],[17,1,"ご"],[22,1,"かみ"],[24,1,"くに"],[26,1,"う"],[31,1,"もの"],[47,1,"けっ"]],"text":"よく聞いておくがよい。だれでも幼な子のように神の国を受けいれる者でなければ、そこにはいることは決してできない」。"},{"ref":"Luke.18.18","start":42018018,"end":42018018,"break":"paragraph","ruby":[[5,2,"やくにん"],[12,1,"たず"],[19,1,"し"],[22,1,"なに"],[27,2,"えいえん"],[30,2,"せいめい"],[33,1,"う"]],"text":"また、ある役人がイエスに尋ねた、「よき師よ、何をしたら永遠の生命が受けられましょうか」。"},{"ref":"Luke.18.19","start":42018019,"end":42018019,"break":"none","ruby":[[4,1,"い"],[18,1,"もの"],[20,1,"い"],[25,1,"かみ"],[35,1,"もの"]],"text":"イエスは言われた、「なぜわたしをよき者と言うのか。神ひとりのほかによい者はいない。"},{"ref":"Luke.18.20","start":42018020,"end":42018020,"break":"none","ruby":[[9,1,"し"],[22,2,"かんいん"],[28,1,"ころ"],[32,1,"ぬす"],[36,2,"ぎしょう"],[39,1,"た"],[44,1,"ちち"],[46,1,"はは"],[49,1,"うやま"]],"text":"いましめはあなたの知っているとおりである、『姦淫するな、殺すな、盗むな、偽証を立てるな、父と母とを敬え』」。"},{"ref":"Luke.18.21","start":42018021,"end":42018021,"break":"none","ruby":[[3,1,"かれ"],[5,1,"い"],[20,1,"ちい"],[23,1,"とき"],[26,1,"まも"]],"text":"すると彼は言った、「それらのことはみな、小さい時から守っております」。"},{"ref":"Luke.18.22","start":42018022,"end":42018022,"break":"none","ruby":[[7,1,"き"],[10,1,"い"],[22,1,"こと"],[28,1,"のこ"],[34,1,"も"],[44,1,"う"],[46,1,"はら"],[50,1,"まず"],[53,2,"ひとびと"],[56,1,"わ"],[71,1,"てん"],[73,1,"たから"],[75,1,"も"],[92,1,"したが"]],"text":"イエスはこれを聞いて言われた、「あなたのする事がまだ一つ残っている。持っているものをみな売り払って、貧しい人々に分けてやりなさい。そうすれば、天に宝を持つようになろう。そして、わたしに従ってきなさい」。"},{"ref":"Luke.18.23","start":42018023,"end":42018023,"break":"none","ruby":[[0,1,"かれ"],[4,2,"ことば"],[7,1,"き"],[10,2,"ひじょう"],[13,1,"かな"],[18,3,"おおがねもち"]],"text":"彼はこの言葉を聞いて非常に悲しんだ。大金持であったからである。"},{"ref":"Luke.18.24","start":42018024,"end":42018024,"break":"none","ruby":[[4,1,"かれ"],[6,2,"ようす"],[9,1,"み"],[11,1,"い"],[17,2,"ざいさん"],[22,1,"もの"],[24,1,"かみ"],[26,1,"くに"]],"text":"イエスは彼の様子を見て言われた、「財産のある者が神の国にはいるのはなんとむずかしいことであろう。"},{"ref":"Luke.18.25","start":42018025,"end":42018025,"break":"none","ruby":[[0,1,"と"],[5,1,"もの"],[7,1,"かみ"],[9,1,"くに"],[22,1,"はり"],[24,1,"あな"],[26,1,"とお"],[28,1,"ほう"]],"text":"富んでいる者が神の国にはいるよりは、らくだが針の穴を通る方が、もっとやさしい」。"},{"ref":"Luke.18.26","start":42018026,"end":42018026,"break":"none","ruby":[[3,1,"き"],[6,2,"ひとびと"],[19,1,"すく"],[35,1,"たず"]],"text":"これを聞いた人々が、「それでは、だれが救われることができるのですか」と尋ねると、"},{"ref":"Luke.18.27","start":42018027,"end":42018027,"break":"none","ruby":[[4,1,"い"],[10,1,"ひと"],[17,1,"こと"],[20,1,"かみ"]],"text":"イエスは言われた、「人にはできない事も、神にはできる」。"},{"ref":"Luke.18.28","start":42018028,"end":42018028,"break":"none","ruby":[[4,1,"い"],[22,2,"じぶん"],[28,1,"す"],[36,1,"したが"]],"text":"ペテロが言った、「ごらんなさい、わたしたちは自分のものを捨てて、あなたに従いました」。"},{"ref":"Luke.18.29","start":42018029,"end":42018029,"break":"none","ruby":[[4,1,"い"],[12,1,"き"],[25,1,"かみ"],[27,1,"くに"],[33,1,"いえ"],[35,1,"つま"],[37,2,"きょうだい"],[40,2,"りょうしん"],[43,1,"こ"],[45,1,"す"],[48,1,"もの"]],"text":"イエスは言われた、「よく聞いておくがよい。だれでも神の国のために、家、妻、兄弟、両親、子を捨てた者は、"},{"ref":"Luke.18.30","start":42018030,"end":42018030,"break":"none","ruby":[[0,1,"かなら"],[4,2,"じだい"],[10,1,"いく"],[11,1,"ばい"],[14,1,"う"],[25,1,"よ"],[28,2,"えいえん"],[31,2,"せいめい"],[34,1,"う"]],"text":"必ずこの時代ではその幾倍もを受け、また、きたるべき世では永遠の生命を受けるのである」。"},{"ref":"Luke.18.31","start":42018031,"end":42018031,"break":"paragraph","ruby":[[6,2,"でし"],[9,1,"よ"],[11,1,"よ"],[14,1,"い"],[20,1,"み"],[35,1,"のぼ"],[38,1,"い"],[42,1,"ひと"],[44,1,"こ"],[49,3,"よげんしゃ"],[66,2,"じょうじゅ"]],"text":"イエスは十二弟子を呼び寄せて言われた、「見よ、わたしたちはエルサレムへ上って行くが、人の子について預言者たちがしるしたことは、すべて成就するであろう。"},{"ref":"Luke.18.32","start":42018032,"end":42018032,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[4,3,"いほうじん"],[8,1,"ひ"],[27,1,"う"]],"text":"人の子は異邦人に引きわたされ、あざけられ、はずかしめを受け、つばきをかけられ、"},{"ref":"Luke.18.33","start":42018033,"end":42018033,"break":"none","ruby":[[5,1,"う"],[15,1,"ころ"],[23,1,"か"],[24,1,"め"]],"text":"また、むち打たれてから、ついに殺され、そして三日目によみがえるであろう」。"},{"ref":"Luke.18.34","start":42018034,"end":42018034,"break":"none","ruby":[[0,2,"でし"],[14,2,"なにひと"],[27,2,"ことば"],[30,1,"かれ"],[33,1,"かく"],[46,1,"い"],[50,1,"こと"],[52,2,"りかい"]],"text":"弟子たちには、これらのことが何一つわからなかった。この言葉が彼らに隠されていたので、イエスの言われた事が理解できなかった。"},{"ref":"Luke.18.35","start":42018035,"end":42018035,"break":"paragraph","ruby":[[8,1,"ちか"],[18,2,"もうじん"],[21,1,"みち"],[30,1,"もの"]],"text":"イエスがエリコに近づかれたとき、ある盲人が道ばたにすわって、物ごいをしていた。"},{"ref":"Luke.18.36","start":42018036,"end":42018036,"break":"none","ruby":[[0,2,"ぐんしゅう"],[3,1,"とお"],[5,1,"す"],[8,1,"おと"],[10,1,"みみ"],[15,1,"かれ"],[17,2,"なにごと"],[25,1,"たず"]],"text":"群衆が通り過ぎる音を耳にして、彼は何事があるのかと尋ねた。"},{"ref":"Luke.18.37","start":42018037,"end":42018037,"break":"none","ruby":[[14,1,"とお"],[20,1,"き"]],"text":"ところが、ナザレのイエスがお通りなのだと聞かされたので、"},{"ref":"Luke.18.38","start":42018038,"end":42018038,"break":"none","ruby":[[0,1,"こえ"],[11,1,"こ"],[26,1,"くだ"],[31,1,"い"]],"text":"声をあげて、「ダビデの子イエスよ、わたしをあわれんで下さい」と言った。"},{"ref":"Luke.18.39","start":42018039,"end":42018039,"break":"none","ruby":[[0,2,"せんとう"],[3,1,"た"],[5,2,"ひとびと"],[8,1,"かれ"],[14,1,"だま"],[24,1,"かれ"],[30,1,"はげ"],[33,1,"さけ"],[45,1,"こ"],[57,1,"くだ"]],"text":"先頭に立つ人々が彼をしかって黙らせようとしたが、彼はますます激しく叫びつづけた、「ダビデの子よ、わたしをあわれんで下さい」。"},{"ref":"Luke.18.40","start":42018040,"end":42018040,"break":"none","ruby":[[7,1,"た"],[16,1,"もの"],[18,1,"つ"],[21,1,"く"],[29,1,"めい"],[36,1,"かれ"],[38,1,"ちか"]],"text":"そこでイエスは立ちどまって、その者を連れて来るように、とお命じになった。彼が近づいたとき、"},{"ref":"Luke.18.41","start":42018041,"end":42018041,"break":"none","ruby":[[5,1,"なに"],[26,1,"しゅ"],[29,1,"み"],[43,1,"こた"]],"text":"「わたしに何をしてほしいのか」とおたずねになると、「主よ、見えるようになることです」と答えた。"},{"ref":"Luke.18.42","start":42018042,"end":42018042,"break":"none","ruby":[[7,1,"い"],[13,1,"み"],[26,2,"しんこう"],[33,1,"すく"]],"text":"そこでイエスは言われた、「見えるようになれ。あなたの信仰があなたを救った」。"},{"ref":"Luke.18.43","start":42018043,"end":42018043,"break":"none","ruby":[[3,1,"かれ"],[10,1,"み"],[23,1,"かみ"],[35,1,"したが"],[38,1,"い"],[45,1,"み"],[48,2,"ひとびと"],[53,1,"かみ"]],"text":"すると彼は、たちまち見えるようになった。そして神をあがめながらイエスに従って行った。これを見て、人々はみな神をさんびした。"}]