[{"ref":"Josh.7.1","start":6007001,"end":6007001,"break":"paragraph","ruby":[[10,2,"ひとびと"],[13,3,"ほうのうぶつ"],[20,1,"つみ"],[22,1,"おか"],[33,2,"ぶぞく"],[43,1,"こ"],[48,1,"こ"],[56,1,"こ"],[61,3,"ほうのうぶつ"],[65,1,"と"],[76,1,"しゅ"],[84,2,"ひとびと"],[91,1,"いか"],[94,1,"はっ"]],"text":"しかし、イスラエルの人々は奉納物について罪を犯した。すなわちユダの部族のうちの、ゼラの子ザブデの子であるカルミの子アカンが奉納物を取ったのである。それで主はイスラエルの人々にむかって怒りを発せられた。"},{"ref":"Josh.7.2","start":6007002,"end":6007002,"break":"paragraph","ruby":[[10,2,"ひとびと"],[22,1,"ひがし"],[30,1,"ちか"],[38,1,"い"],[49,2,"ひとびと"],[52,1,"い"],[57,1,"のぼ"],[60,1,"い"],[66,1,"ち"],[68,1,"さぐ"],[77,2,"ひとびと"],[80,1,"のぼ"],[83,1,"い"],[90,1,"さぐ"]],"text":"ヨシュアはエリコから人々をつかわし、ベテルの東、ベテアベンの近くにあるアイに行かせようとして、その人々に言った、「上って行って、かの地を探ってきなさい」。人々は上って行って、アイを探ったが、"},{"ref":"Josh.7.3","start":6007003,"end":6007003,"break":"none","ruby":[[8,1,"かえ"],[13,1,"い"],[18,1,"たみ"],[25,1,"い"],[31,1,"およ"],[43,1,"にん"],[45,1,"のぼ"],[53,1,"う"],[60,1,"かれ"],[63,1,"すく"],[72,1,"たみ"],[96,1,"およ"]],"text":"ヨシュアのもとに帰ってきて言った、「民をことごとく行かせるには及びません。ただ二、三千人を上らせて、アイを撃たせなさい。彼らは少ないのですから、民をことごとくあそこへやってほねおりをさせるには及びません」。"},{"ref":"Josh.7.4","start":6007004,"end":6007004,"break":"none","ruby":[[3,1,"たみ"],[14,1,"にん"],[19,1,"のぼ"],[30,2,"ひとびと"],[33,1,"まえ"],[36,1,"に"],[38,1,"だ"]],"text":"そこで民のうち、おおよそ三千人がそこに上ったが、ついにアイの人々の前から逃げ出した。"},{"ref":"Josh.7.5","start":6007005,"end":6007005,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"かれ"],[19,1,"にん"],[21,1,"ころ"],[24,1,"さら"],[26,1,"かれ"],[29,1,"もん"],[31,1,"まえ"],[40,1,"お"],[44,1,"くだ"],[46,1,"ざか"],[48,1,"かれ"],[51,1,"ころ"],[57,1,"たみ"],[59,1,"こころ"],[61,1,"き"],[64,1,"みず"]],"text":"アイの人々は彼らのうち、おおよそ三十六人を殺し、更に彼らを門の前からシバリムまで追って、下り坂で彼らを殺したので、民の心は消えて水のようになった。"},{"ref":"Josh.7.6","start":6007006,"end":6007006,"break":"paragraph","ruby":[[9,2,"いふく"],[12,1,"さ"],[21,2,"ちょうろう"],[26,1,"とも"],[29,1,"しゅ"],[31,1,"はこ"],[33,1,"まえ"],[36,2,"ゆうがた"],[40,1,"ち"],[44,1,"ふ"]],"text":"そのためヨシュアは衣服を裂き、イスラエルの長老たちと共に、主の箱の前で、夕方まで地にひれ伏し、ちりをかぶった。"},{"ref":"Josh.7.7","start":6007007,"end":6007007,"break":"none","ruby":[[5,1,"い"],[13,1,"しゅ"],[16,1,"かみ"],[30,1,"たみ"],[37,1,"わた"],[52,1,"て"],[54,1,"わた"],[57,1,"ほろ"],[79,1,"む"],[84,1,"やす"]],"text":"ヨシュアは言った、「ああ、主なる神よ、あなたはなにゆえ、この民にヨルダンを渡らせ、われわれをアモリびとの手に渡して滅ぼさせられるのですか。われわれはヨルダンの向こうに、安んじてとどまればよかったのです。"},{"ref":"Josh.7.8","start":6007008,"end":6007008,"break":"none","ruby":[[3,1,"しゅ"],[15,1,"てき"],[17,1,"せ"],[22,1,"いま"],[34,1,"なに"],[36,1,"い"],[38,1,"え"]],"text":"ああ、主よ。イスラエルがすでに敵に背をむけた今となって、わたしはまた何を言い得ましょう。"},{"ref":"Josh.7.9","start":6007009,"end":6007009,"break":"none","ruby":[[11,1,"ち"],[13,1,"す"],[26,1,"き"],[35,1,"せ"],[46,1,"な"],[48,1,"ち"],[51,1,"た"],[53,1,"さ"],[76,1,"おお"],[80,1,"な"],[86,1,"なに"]],"text":"カナンびと、およびこの地に住むすべてのものは、これを聞いて、われわれを攻めかこみ、われわれの名を地から断ち去ってしまうでしょう。それであなたは、あなたの大いなる名のために、何をしようとされるのですか」。"},{"ref":"Josh.7.10","start":6007010,"end":6007010,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"い"],[13,1,"た"],[35,1,"ふ"]],"text":"主はヨシュアに言われた、「立ちなさい。あなたはどうして、そのようにひれ伏しているのか。"},{"ref":"Josh.7.11","start":6007011,"end":6007011,"break":"none","ruby":[[6,1,"つみ"],[8,1,"おか"],[15,1,"かれ"],[18,1,"めい"],[24,2,"けいやく"],[27,1,"やぶ"],[31,1,"かれ"],[34,3,"ほうのうぶつ"],[38,1,"と"],[41,1,"ぬす"],[46,1,"いつわ"],[53,2,"じぶん"],[56,3,"しょゆうぶつ"],[63,1,"い"]],"text":"イスラエルは罪を犯し、わたしが彼らに命じておいた契約を破った。彼らは奉納物を取り、盗み、かつ偽って、それを自分の所有物のうちに入れた。"},{"ref":"Josh.7.12","start":6007012,"end":6007012,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"てき"],[14,1,"あた"],[23,1,"てき"],[25,1,"せ"],[31,1,"かれ"],[34,1,"ほろ"],[62,1,"ほろ"],[83,1,"ほろ"],[86,1,"さ"],[109,1,"とも"]],"text":"それでイスラエルの人々は敵に当ることができず、敵に背をむけた。彼らも滅ぼされるべきものとなったからである。あなたがたが、その滅ぼされるべきものを、あなたがたのうちから滅ぼし去るのでなければ、わたしはもはやあなたがたとは共にいないであろう。"},{"ref":"Josh.7.13","start":6007013,"end":6007013,"break":"none","ruby":[[0,1,"た"],[4,1,"たみ"],[6,1,"きよ"],[9,1,"い"],[22,1,"み"],[24,1,"きよ"],[34,1,"そな"],[46,1,"かみ"],[48,1,"しゅ"],[52,1,"おお"],[76,1,"ほろ"],[91,1,"ほろ"],[112,1,"のぞ"],[114,1,"さ"],[120,1,"てき"],[122,1,"あた"]],"text":"立って、民を清めて言いなさい、『あなたがたは身を清めて、あすのために備えなさい。イスラエルの神、主はこう仰せられる、「イスラエルよ、あなたがたのうちに、滅ぼされるべきものがある。その滅ぼされるべきものを、あなたがたのうちから除き去るまでは、敵に当ることはできないであろう」。"},{"ref":"Josh.7.14","start":6007014,"end":6007014,"break":"none","ruby":[[8,1,"あさ"],[16,2,"ぶぞく"],[21,1,"すす"],[23,1,"で"],[36,1,"しゅ"],[41,1,"あ"],[46,2,"ぶぞく"],[50,2,"しぞく"],[55,1,"すす"],[60,1,"しゅ"],[65,1,"あ"],[70,2,"しぞく"],[74,2,"かぞく"],[79,1,"すす"],[84,1,"しゅ"],[89,1,"あ"],[94,2,"かぞく"],[98,1,"おとこ"],[105,1,"すす"],[107,1,"で"]],"text":"それゆえ、あすの朝、あなたがたは部族ごとに進み出なければならない。そして主がくじを当てられる部族は、氏族ごとに進みいで、主がくじを当てられる氏族は、家族ごとに進みいで、主がくじを当てられる家族は、男ひとりびとり進み出なければならない。"},{"ref":"Josh.7.15","start":6007015,"end":6007015,"break":"none","ruby":[[5,1,"ほろ"],[15,1,"も"],[24,1,"あ"],[29,1,"もの"],[34,1,"も"],[36,1,"もの"],[37,2,"ぜんぶ"],[40,1,"とも"],[43,1,"ひ"],[45,1,"や"],[57,1,"しゅ"],[59,2,"けいやく"],[62,1,"やぶ"],[73,1,"おろ"],[79,1,"おこな"]],"text":"そしてその滅ぼされるべきものを持っていて、くじを当てられた者は、その持ち物全部と共に、火で焼かれなければならない。主の契約を破りイスラエルのうちに愚かなことを行ったからである』」。"},{"ref":"Josh.7.16","start":6007016,"end":6007016,"break":"paragraph","ruby":[[9,1,"あさ"],[10,1,"はや"],[12,1,"お"],[21,2,"ぶぞく"],[26,1,"すす"],[28,1,"だ"],[39,2,"ぶぞく"],[45,1,"あた"]],"text":"こうしてヨシュアは朝早く起き、イスラエルを部族ごとに進み出させたところ、ユダの部族がくじに当り、"},{"ref":"Josh.7.17","start":6007017,"end":6007017,"break":"none","ruby":[[8,2,"しぞく"],[11,1,"すす"],[13,1,"だ"],[26,2,"しぞく"],[33,1,"あた"],[42,2,"しぞく"],[45,2,"かぞく"],[50,1,"すす"],[52,1,"だ"],[64,2,"かぞく"],[71,1,"あた"]],"text":"ユダのもろもろの氏族を進み出させたところ、ゼラびとの氏族が、くじに当った。ゼラびとの氏族を家族ごとに進み出させたところ、ザブデの家族が、くじに当った。"},{"ref":"Josh.7.18","start":6007018,"end":6007018,"break":"none","ruby":[[4,2,"かぞく"],[7,1,"おとこ"],[14,1,"すす"],[16,1,"だ"],[31,1,"あた"],[42,2,"ぶぞく"],[52,1,"こ"],[58,1,"こ"],[65,1,"こ"]],"text":"ザブデの家族を男ひとりびとり進み出させたところ、アカンがくじに当った。アカンはユダの部族のうちの、ゼラの子、ザブデの子なるカルミの子である。"},{"ref":"Josh.7.19","start":6007019,"end":6007019,"break":"none","ruby":[[2,1,"とき"],[12,1,"い"],[19,1,"こ"],[28,1,"かみ"],[30,1,"しゅ"],[32,2,"えいこう"],[35,1,"き"],[40,1,"しゅ"],[56,1,"いま"],[61,1,"つ"],[71,1,"かく"]],"text":"その時ヨシュアはアカンに言った、「わが子よ、イスラエルの神、主に栄光を帰し、また主をさんびし、あなたのしたことを今わたしに告げなさい。わたしに隠してはならない」。"},{"ref":"Josh.7.20","start":6007020,"end":6007020,"break":"none","ruby":[[9,1,"こた"],[29,1,"かみ"],[31,1,"しゅ"],[33,1,"たい"],[36,1,"つみ"],[38,1,"おか"]],"text":"アカンはヨシュアに答えた、「ほんとうにわたしはイスラエルの神、主に対して罪を犯しました。わたしがしたのはこうです。"},{"ref":"Josh.7.21","start":6007021,"end":6007021,"break":"none","ruby":[[8,1,"もの"],[18,1,"うつく"],[21,2,"がいとう"],[24,1,"まい"],[26,1,"ぎん"],[34,2,"めかた"],[42,1,"きん"],[44,1,"の"],[46,1,"ぼう"],[48,1,"ぽん"],[54,1,"み"],[66,1,"と"],[76,2,"てんまく"],[79,1,"なか"],[82,1,"ち"],[84,1,"かく"],[92,1,"ぎん"],[96,1,"した"]],"text":"わたしはぶんどり物のうちに、シナルの美しい外套一枚と銀二百シケルと、目方五十シケルの金の延べ棒一本のあるのを見て、ほしくなり、それを取りました。わたしの天幕の中に、地に隠してあります。銀はその下にあります」。"},{"ref":"Josh.7.22","start":6007022,"end":6007022,"break":"paragraph","ruby":[[8,2,"ししゃ"],[19,2,"ししゃ"],[24,2,"てんまく"],[27,1,"はし"],[33,1,"み"],[40,1,"かれ"],[42,2,"てんまく"],[45,1,"かく"],[52,1,"ぎん"],[56,1,"した"]],"text":"そこでヨシュアは使者たちをつかわした。使者たちが天幕に走っていって見ると、それは彼の天幕に隠してあって、銀もその下にあった。"},{"ref":"Josh.7.23","start":6007023,"end":6007023,"break":"none","ruby":[[0,1,"かれ"],[6,2,"てんまく"],[9,1,"なか"],[12,1,"と"],[14,1,"だ"],[33,2,"ひとびと"],[36,1,"ところ"],[38,1,"たずさ"],[49,1,"しゅ"],[51,1,"まえ"],[53,1,"お"]],"text":"彼らはそれを天幕の中から取り出して、ヨシュアとイスラエルのすべての人々の所に携えてきたので、それを主の前に置いた。"},{"ref":"Josh.7.24","start":6007024,"end":6007024,"break":"none","ruby":[[17,1,"とも"],[23,1,"こ"],[28,1,"とら"],[33,1,"ぎん"],[35,2,"がいとう"],[38,1,"きん"],[40,1,"の"],[42,1,"ぼう"],[47,1,"かれ"],[53,1,"むすめ"],[55,1,"うし"],[60,1,"ひつじ"],[62,2,"てんまく"],[67,1,"かれ"],[69,1,"も"],[71,1,"もの"],[78,1,"と"],[86,1,"たに"],[88,1,"ひ"]],"text":"ヨシュアはすべてのイスラエルびとと共に、ゼラの子アカンを捕え、かの銀と外套と金の延べ棒、および彼のむすこ、娘、牛、ろば、羊、天幕など、彼の持ち物をことごとく取って、アコルの谷へ引いていった。"},{"ref":"Josh.7.25","start":6007025,"end":6007025,"break":"none","ruby":[[8,1,"い"],[24,1,"なや"],[31,1,"しゅ"],[42,1,"なや"],[68,1,"いし"],[70,1,"かれ"],[72,1,"う"],[74,1,"ころ"],[79,1,"かれ"],[81,2,"かぞく"],[85,1,"いし"],[87,1,"う"],[89,1,"ころ"],[92,1,"ひ"],[97,1,"や"]],"text":"そしてヨシュアは言った、「なぜあなたはわれわれを悩ましたのか。主は、きょう、あなたを悩まされるであろう」。やがてすべてのイスラエルびとは石で彼を撃ち殺し、また彼の家族をも石で撃ち殺し、火をもって焼いた。"},{"ref":"Josh.7.26","start":6007026,"end":6007026,"break":"none","ruby":[[7,1,"うえ"],[9,2,"いしづか"],[12,1,"おお"],[15,1,"つ"],[17,1,"あ"],[25,2,"こんにち"],[29,1,"のこ"],[38,1,"しゅ"],[40,1,"はげ"],[43,1,"いか"],[64,1,"ところ"],[66,1,"な"],[68,2,"こんにち"],[76,1,"たに"],[78,1,"よ"]],"text":"そしてアカンの上に石塚を大きく積み上げたが、それは今日まで残っている。そして主は激しい怒りをやめられたが、このことによって、その所の名は今日までアコルの谷と呼ばれている。"}]