[{"ref":"Isa.4.1","start":23004001,"end":23004001,"break":"paragraph","ruby":[[2,1,"ひ"],[5,1,"にん"],[7,1,"おんな"],[13,1,"おとこ"],[27,2,"じぶん"],[36,2,"じぶん"],[39,2,"きもの"],[42,1,"き"],[53,1,"な"],[58,1,"よ"],[65,1,"ゆる"],[75,1,"はじ"],[77,1,"と"],[79,1,"のぞ"],[88,1,"い"]],"text":"その日、七人の女がひとりの男にすがって、「わたしたちは自分のパンをたべ、自分の着物を着ます。ただ、あなたの名によって呼ばれることを許して、わたしたちの恥を取り除いてください」と言う。"},{"ref":"Isa.4.2","start":23004002,"end":23004002,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"しゅ"],[6,1,"えだ"],[8,1,"うるわ"],[11,1,"さか"],[14,1,"ち"],[16,2,"さんぶつ"],[25,1,"い"],[27,1,"のこ"],[30,1,"もの"],[32,1,"ほこり"],[36,2,"こうえい"]],"text":"その日、主の枝は麗しく栄え、地の産物はイスラエルの生き残った者の誇、また光栄となる。"},{"ref":"Isa.4.3","start":23004003,"end":23004004,"break":"none","ruby":[[3,1,"しゅ"],[5,2,"しんぱん"],[8,1,"れい"],[10,2,"めつぼう"],[13,1,"れい"],[24,1,"むすめ"],[27,1,"けが"],[30,1,"あら"],[39,1,"ち"],[43,1,"なか"],[46,1,"のぞ"],[48,1,"さ"],[59,1,"のこ"],[61,1,"もの"],[73,1,"もの"],[88,2,"せいめい"],[91,1,"しょ"],[98,1,"もの"],[100,1,"せい"],[103,1,"もの"]],"text":"そして主が審判の霊と滅亡の霊とをもって、シオンの娘らの汚れを洗い、エルサレムの血をその中から除き去られるとき、シオンに残る者、エルサレムにとどまる者、すべてエルサレムにあって、生命の書にしるされた者は聖なる者ととなえられる。"},{"ref":"Isa.4.5","start":23004005,"end":23004005,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[10,1,"やま"],[16,2,"ばしょ"],[27,2,"しゅうかい"],[31,1,"うえ"],[34,1,"ひる"],[36,1,"くも"],[42,1,"よる"],[44,1,"けむり"],[46,1,"も"],[49,1,"ひ"],[51,1,"かがや"],[68,2,"えいこう"],[71,1,"うえ"],[75,2,"てんがい"]],"text":"その時、主はシオンの山のすべての場所と、そのもろもろの集会との上に、昼は雲をつくり、夜は煙と燃える火の輝きとをつくられる。これはすべての栄光の上にある天蓋であり、あずまやであって、"},{"ref":"Isa.4.6","start":23004006,"end":23004006,"break":"none","ruby":[[0,1,"ひる"],[2,1,"あつ"],[8,1,"かげ"],[15,2,"ぼうふう"],[18,1,"あめ"],[20,1,"さ"],[23,1,"かく"],[26,1,"ところ"]],"text":"昼は暑さをふせぐ陰となり、また暴風と雨を避けて隠れる所となる。"}]