[{"ref":"2Kgs.20.1","start":12020001,"end":12020001,"break":"paragraph","ruby":[[10,2,"びょうき"],[16,1,"し"],[29,1,"こ"],[30,3,"よげんしゃ"],[37,1,"かれ"],[45,1,"い"],[50,1,"しゅ"],[54,1,"おお"],[62,1,"いえ"],[64,1,"ひと"],[66,2,"ゆいごん"],[77,1,"し"],[82,1,"い"]],"text":"そのころ、ヒゼキヤは病気になって死にかかっていた。アモツの子預言者イザヤは彼のところにきて言った、「主はこう仰せられます、『家の人に遺言をなさい。あなたは死にます。生きながらえることはできません』」。"},{"ref":"2Kgs.20.2","start":12020002,"end":12020002,"break":"none","ruby":[[8,1,"かお"],[10,1,"かべ"],[12,1,"む"],[15,1,"しゅ"],[17,1,"いの"],[20,1,"い"]],"text":"そこでヒゼキヤは顔を壁に向けて主に祈って言った、"},{"ref":"2Kgs.20.3","start":12020003,"end":12020003,"break":"none","ruby":[[3,1,"しゅ"],[10,2,"しんじつ"],[13,2,"まごころ"],[23,1,"まえ"],[25,1,"あゆ"],[32,1,"め"],[50,1,"おも"],[52,1,"おこ"],[69,1,"はげ"],[72,1,"な"]],"text":"「ああ主よ、わたしが真実を真心をもってあなたの前に歩み、あなたの目にかなうことをおこなったのをどうぞ思い起してください」。そしてヒゼキヤは激しく泣いた。"},{"ref":"2Kgs.20.4","start":12020004,"end":12020004,"break":"none","ruby":[[6,2,"なかにわ"],[9,1,"で"],[15,1,"しゅ"],[17,2,"ことば"],[20,1,"かれ"],[22,1,"のぞ"]],"text":"イザヤがまだ中庭を出ないうちに主の言葉が彼に臨んだ、"},{"ref":"2Kgs.20.5","start":12020005,"end":12020005,"break":"none","ruby":[[1,1,"ひ"],[3,1,"かえ"],[11,1,"たみ"],[13,1,"きみ"],[19,1,"い"],[30,1,"ちち"],[35,1,"かみ"],[37,1,"しゅ"],[41,1,"おお"],[55,1,"いのり"],[57,1,"き"],[64,1,"なみだ"],[66,1,"み"],[69,1,"み"],[85,1,"か"],[86,1,"め"],[93,1,"しゅ"],[95,1,"みや"],[97,1,"のぼ"]],"text":"「引き返して、わたしの民の君ヒゼキヤに言いなさい、『あなたの父ダビデの神、主はこう仰せられる、わたしはあなたの祈を聞き、あなたの涙を見た。見よ、わたしはあなたをいやす。三日目にはあなたは主の宮に上るであろう。"},{"ref":"2Kgs.20.6","start":12020006,"end":12020006,"break":"none","ruby":[[17,1,"ねん"],[18,1,"ま"],[32,1,"まち"],[41,1,"おう"],[43,1,"て"],[46,1,"すく"],[53,1,"な"],[76,1,"まち"],[78,1,"まも"]],"text":"かつ、わたしはあなたのよわいを十五年増す。わたしはあなたと、この町とをアッスリヤの王の手から救い、わたしの名のため、またわたしのしもべダビデのためにこの町を守るであろう』」。"},{"ref":"2Kgs.20.7","start":12020007,"end":12020007,"break":"none","ruby":[[7,1,"い"],[12,1,"ほ"],[26,1,"も"],[35,2,"はれもの"],[51,1,"なお"]],"text":"そしてイザヤは言った、「干しいちじくのひとかたまりを持ってきて、それを腫物につけさせなさい。そうすれば直るでしょう」。"},{"ref":"2Kgs.20.8","start":12020008,"end":12020008,"break":"paragraph","ruby":[[9,1,"い"],[14,1,"しゅ"],[25,1,"こと"],[29,1,"か"],[30,1,"め"],[36,1,"しゅ"],[38,1,"いえ"],[40,1,"のぼ"]],"text":"ヒゼキヤはイザヤに言った、「主がわたしをいやされる事と、三日目にわたしが主の家に上ることについて、どんなしるしがありましょうか」。"},{"ref":"2Kgs.20.9","start":12020009,"end":12020009,"break":"none","ruby":[[4,1,"い"],[9,1,"しゅ"],[11,2,"やくそく"],[19,1,"おこな"],[31,1,"しゅ"],[40,1,"え"],[53,2,"ひかげ"],[57,1,"ど"],[58,1,"すす"],[67,1,"ど"],[68,1,"しりぞ"]],"text":"イザヤは言った、「主が約束されたことを行われることについては、主からこのしるしを得られるでしょう。すなわち日影が十度進むか、あるいは十度退くかです」。"},{"ref":"2Kgs.20.10","start":12020010,"end":12020010,"break":"none","ruby":[[5,1,"こた"],[10,2,"ひかげ"],[14,1,"ど"],[15,1,"すす"],[24,1,"こと"],[31,2,"ひかげ"],[35,1,"ど"],[36,1,"しりぞ"]],"text":"ヒゼキヤは答えた、「日影が十度進むことはたやすい事です。むしろ日影を十度退かせてください」。"},{"ref":"2Kgs.20.11","start":12020011,"end":12020011,"break":"none","ruby":[[3,3,"よげんしゃ"],[10,1,"しゅ"],[12,1,"よ"],[22,1,"ひ"],[23,1,"とき"],[26,1,"うえ"],[28,1,"すす"],[31,2,"ひかげ"],[36,1,"ど"],[37,1,"しりぞ"]],"text":"そこで預言者イザヤが主に呼ばわると、アハズの日時計の上に進んだ日影を、十度退かせられた。"},{"ref":"2Kgs.20.12","start":12020012,"end":12020012,"break":"paragraph","ruby":[[10,1,"こ"],[19,1,"おう"],[30,2,"てがみ"],[33,1,"おく"],[35,1,"もの"],[37,1,"も"],[41,2,"しせつ"],[63,1,"や"],[71,1,"き"]],"text":"そのころ、バラダンの子であるバビロンの王メロダクバラダンは、手紙と贈り物を持たせて使節をヒゼキヤにつかわした。これはヒゼキヤが病んでいることを聞いたからである。"},{"ref":"2Kgs.20.13","start":12020013,"end":12020013,"break":"none","ruby":[[5,1,"かれ"],[8,1,"よろこ"],[10,1,"むか"],[14,2,"ほうもつ"],[17,1,"くら"],[19,2,"きんぎん"],[22,2,"こうりょう"],[25,2,"きちょう"],[28,1,"あぶら"],[32,2,"ぶき"],[34,1,"くら"],[42,2,"そうこ"],[51,1,"もの"],[53,1,"かれ"],[56,1,"み"],[60,1,"いえ"],[64,1,"もの"],[67,1,"くに"],[71,1,"もの"],[79,1,"かれ"],[82,1,"み"],[86,1,"もの"]],"text":"ヒゼキヤは彼らを喜び迎えて、宝物の蔵、金銀、香料、貴重な油および武器倉、ならびにその倉庫にあるすべての物を彼らに見せた。家にある物も、国にある物も、ヒゼキヤが彼らに見せない物は一つもなかった。"},{"ref":"2Kgs.20.14","start":12020014,"end":12020014,"break":"none","ruby":[[2,1,"とき"],[4,3,"よげんしゃ"],[15,1,"おう"],[22,1,"い"],[29,2,"ひとびと"],[32,1,"なに"],[34,1,"い"],[58,1,"い"],[63,1,"かれ"],[66,1,"とお"],[68,1,"くに"]],"text":"その時、預言者イザヤはヒゼキヤ王のもとにきて言った、「あの人々は何を言いましたか。どこからきたのですか」。ヒゼキヤは言った、「彼らは遠い国から、バビロンからきたのです」。"},{"ref":"2Kgs.20.15","start":12020015,"end":12020015,"break":"none","ruby":[[4,1,"い"],[9,1,"かれ"],[16,1,"いえ"],[18,1,"なに"],[20,1,"み"],[32,1,"こた"],[35,1,"い"],[44,1,"いえ"],[48,1,"もの"],[50,1,"みな"],[51,1,"み"],[60,2,"そうこ"],[72,1,"かれ"],[75,1,"み"],[79,1,"もの"]],"text":"イザヤは言った、「彼らはあなたの家で何を見ましたか」。ヒゼキヤは答えて言った、「わたしの家にある物を皆見ました。わたしの倉庫のうちには、わたしが彼らに見せない物は一つもありません」。"},{"ref":"2Kgs.20.16","start":12020016,"end":12020016,"break":"paragraph","ruby":[[12,1,"い"],[17,1,"しゅ"],[19,2,"ことば"],[22,1,"き"]],"text":"そこでイザヤはヒゼキヤに言った、「主の言葉を聞きなさい、"},{"ref":"2Kgs.20.17","start":12020017,"end":12020017,"break":"none","ruby":[[1,1,"しゅ"],[3,1,"い"],[8,1,"み"],[18,1,"いえ"],[22,1,"もの"],[32,2,"せんぞ"],[37,2,"こんにち"],[42,1,"つ"],[49,1,"もの"],[57,1,"はこ"],[59,1,"さ"],[63,1,"ひ"],[65,1,"く"],[68,1,"なに"],[70,1,"のこ"]],"text":"『主は言われる、見よ、すべてあなたの家にある物、および、あなたの先祖たちが今日までに積みたくわえた物の、バビロンに運び去られる日が来る。何も残るものはないであろう。"},{"ref":"2Kgs.20.18","start":12020018,"end":12020018,"break":"none","ruby":[[7,1,"み"],[10,1,"で"],[16,1,"こ"],[20,1,"つ"],[22,1,"さ"],[31,1,"おう"],[33,2,"きゅうでん"],[36,2,"かんがん"]],"text":"また、あなたの身から出るあなたの子たちも連れ去られ、バビロンの王の宮殿で宦官となるであろう』」。"},{"ref":"2Kgs.20.19","start":12020019,"end":12020019,"break":"none","ruby":[[9,1,"い"],[18,1,"い"],[22,1,"しゅ"],[24,2,"ことば"],[27,2,"けっこう"],[33,1,"かれ"],[39,2,"じぶん"],[42,1,"よ"],[50,2,"へいわ"],[53,2,"あんぜん"],[59,1,"よ"],[72,1,"おも"]],"text":"ヒゼキヤはイザヤに言った、「あなたが言われた主の言葉は結構です」。彼は「せめて自分が世にあるあいだ、平和と安全があれば良いことではなかろうか」と思ったからである。"},{"ref":"2Kgs.20.20","start":12020020,"end":12020020,"break":"paragraph","ruby":[[7,1,"た"],[9,2,"じせき"],[14,2,"ぶゆう"],[20,1,"かれ"],[22,3,"ちょすいち"],[26,2,"すいどう"],[29,1,"つく"],[33,1,"まち"],[35,1,"みず"],[37,1,"ひ"],[40,1,"こと"],[46,1,"おう"],[48,3,"れきだいし"],[52,1,"しょ"]],"text":"ヒゼキヤのその他の事績とその武勇および、彼が貯水池と水道を作って、町に水を引いた事は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.20.21","start":12020021,"end":12020021,"break":"none","ruby":[[7,2,"せんぞ"],[12,1,"とも"],[14,1,"ねむ"],[20,1,"こ"],[25,1,"かわ"],[28,1,"おう"]],"text":"ヒゼキヤはその先祖たちと共に眠って、その子マナセが代って王となった。"}]