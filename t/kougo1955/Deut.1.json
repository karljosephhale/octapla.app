[{"ref":"Deut.1.1","start":5001001,"end":5001001,"break":"paragraph","ruby":[[8,1,"む"],[12,2,"あらの"],[39,1,"あいだ"],[45,1,"まえ"],[71,1,"ひと"],[73,1,"つ"],[76,2,"ことば"]],"text":"これはヨルダンの向こうの荒野、パランと、トペル、ラバン、ハゼロテ、デザハブとの間の、スフの前にあるアラバにおいて、モーセがイスラエルのすべての人に告げた言葉である。"},{"ref":"Deut.1.2","start":5001002,"end":5001002,"break":"none","ruby":[[8,1,"やま"],[10,1,"みち"],[12,1,"へ"],[24,1,"たっ"],[32,1,"にち"],[34,1,"みち"]],"text":"ホレブからセイル山の道を経て、カデシ・バルネアに達するには、十一日の道のりである。"},{"ref":"Deut.1.3","start":5001003,"end":5001003,"break":"none","ruby":[[0,1,"だい"],[3,1,"ねん"],[7,1,"がつ"],[14,1,"つき"],[17,1,"にち"],[30,2,"ひとびと"],[38,1,"しゅ"],[40,1,"かれ"],[45,1,"かれ"],[47,1,"さづ"],[52,2,"めいれい"],[61,1,"つ"]],"text":"第四十年の十一月となり、その月の一日に、モーセはイスラエルの人々にむかって、主が彼らのため彼に授けられた命令を、ことごとく告げた。"},{"ref":"Deut.1.4","start":5001004,"end":5001004,"break":"none","ruby":[[12,1,"す"],[23,1,"おう"],[43,1,"す"],[53,1,"おう"],[57,1,"ころ"],[60,1,"のち"]],"text":"これはモーセがヘシボンに住んでいたアモリびとの王シホン、およびアシタロテとエデレイとに住んでいたバシャンの王オグを殺した後であった。"},{"ref":"Deut.1.5","start":5001005,"end":5001005,"break":"none","ruby":[[13,1,"む"],[21,1,"ち"],[31,2,"りっぽう"],[34,2,"せつめい"],[37,1,"あた"],[44,1,"い"]],"text":"すなわちモーセはヨルダンの向こうのモアブの地で、みずから、この律法の説明に当った、そして言った、"},{"ref":"Deut.1.6","start":5001006,"end":5001006,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[23,1,"い"],[38,1,"ひさ"],[44,1,"やま"]],"text":"「われわれの神、主はホレブにおいて、われわれに言われた、『あなたがたはすでに久しく、この山にとどまっていたが、"},{"ref":"Deut.1.7","start":5001007,"end":5001007,"break":"none","ruby":[[0,1,"み"],[7,1,"みち"],[9,1,"すす"],[18,2,"さんち"],[21,1,"い"],[26,2,"きんりん"],[33,1,"ところ"],[39,2,"さんち"],[42,2,"ていち"],[49,1,"うみ"],[58,1,"ち"],[67,1,"い"],[70,2,"おおかわ"],[79,1,"い"]],"text":"身をめぐらして道に進み、アモリびとの山地に行き、その近隣のすべての所、アラバ、山地、低地、ネゲブ、海べ、カナンびとの地、またレバノンに行き、大川ユフラテにまで行きなさい。"},{"ref":"Deut.1.8","start":5001008,"end":5001008,"break":"none","ruby":[[0,1,"み"],[9,1,"ち"],[17,1,"まえ"],[19,1,"お"],[25,1,"ち"],[35,2,"じぶん"],[49,1,"しゅ"],[58,2,"せんぞ"],[74,1,"ちか"],[78,1,"かれ"],[83,1,"のち"],[85,2,"しそん"],[88,1,"あた"],[92,1,"い"],[96,1,"ところ"]],"text":"見よ、わたしはこの地をあなたがたの前に置いた。この地にはいって、それを自分のものとしなさい。これは主が、あなたがたの先祖アブラハム、イサク、ヤコブに誓って、彼らとその後の子孫に与えると言われた所である』。"},{"ref":"Deut.1.9","start":5001009,"end":5001009,"break":"paragraph","ruby":[[2,1,"とき"],[14,1,"い"],[33,1,"お"]],"text":"あの時、わたしはあなたがたに言った、『わたしはひとりであなたがたを負うことができない。"},{"ref":"Deut.1.10","start":5001010,"end":5001010,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[16,1,"おお"],[35,1,"そら"],[37,1,"ほし"],[42,1,"おお"]],"text":"あなたがたの神、主はあなたがたを多くされたので、あなたがたは、きょう、空の星のように多い。"},{"ref":"Deut.1.11","start":5001011,"end":5001011,"break":"none","ruby":[[12,2,"せんぞ"],[15,1,"かみ"],[17,1,"しゅ"],[26,1,"いま"],[32,1,"ばい"],[34,1,"おお"],[46,2,"やくそく"],[61,1,"めぐ"]],"text":"――どうぞ、あなたがたの先祖の神、主があなたがたを、今あるより千倍も多くし、またあなたがたに約束されたように、あなたがたを恵んでくださるように。――"},{"ref":"Deut.1.12","start":5001012,"end":5001012,"break":"none","ruby":[[19,1,"お"],[28,2,"おもに"],[38,1,"あらそ"],[41,2,"しょり"]],"text":"わたしひとりで、どうして、あなたがたを負い、あなたがたの重荷と、あなたがたの争いを処理することができようか。"},{"ref":"Deut.1.13","start":5001013,"end":5001013,"break":"none","ruby":[[11,2,"ぶぞく"],[17,2,"ちえ"],[23,2,"ちしき"],[30,1,"ひと"],[32,1,"し"],[38,2,"ひとびと"],[41,1,"えら"],[43,1,"だ"],[55,2,"ひとびと"]],"text":"あなたがたは、おのおの部族ごとに、知恵があり、知識があって、人に知られている人々を選び出しなさい。わたしはその人々を、あなたがたのかしらとするであろう』。"},{"ref":"Deut.1.14","start":5001014,"end":5001014,"break":"none","ruby":[[2,1,"とき"],[14,1,"こた"],[27,1,"い"],[34,1,"よ"]],"text":"その時、あなたがたはわたしに答えた、『あなたがしようと言われることは良いことです』。"},{"ref":"Deut.1.15","start":5001015,"end":5001015,"break":"none","ruby":[[20,2,"ちえ"],[26,1,"ひと"],[28,1,"し"],[34,2,"ひとびと"],[37,1,"と"],[59,1,"にん"],[61,1,"ちょう"],[64,1,"にん"],[66,1,"ちょう"],[70,1,"にん"],[72,1,"ちょう"],[75,1,"にん"],[77,1,"ちょう"],[90,2,"ぶぞく"]],"text":"そこで、わたしは、あなたがたのうちから、知恵があり、人に知られている人々を取って、あなたがたのかしらとした。すなわち千人の長、百人の長、五十人の長、十人の長とし、また、あなたがたの部族のつかさびととした。"},{"ref":"Deut.1.16","start":5001016,"end":5001016,"break":"none","ruby":[[26,1,"めい"],[29,1,"い"],[41,2,"きょうだい"],[46,1,"あいだ"],[48,1,"うった"],[51,1,"き"],[54,1,"ひと"],[58,2,"きょうだい"],[64,2,"きりゅう"],[67,2,"たこく"],[69,1,"じん"],[72,1,"あいだ"],[75,1,"ただ"]],"text":"また、あのとき、わたしはあなたがたのさばきびとたちに命じて言った、『あなたがたは、兄弟たちの間の訴えを聞き、人とその兄弟、または寄留の他国人との間を、正しくさばかなければならない。"},{"ref":"Deut.1.17","start":5001017,"end":5001017,"break":"none","ruby":[[13,1,"とき"],[15,1,"ひと"],[17,2,"かたよ"],[20,1,"み"],[28,1,"ちい"],[31,1,"もの"],[34,1,"おお"],[38,1,"もの"],[41,1,"き"],[52,1,"ひと"],[54,1,"かお"],[56,1,"おそ"],[69,1,"かみ"],[71,1,"こと"],[85,1,"き"],[95,1,"こと"],[106,1,"も"],[126,1,"き"]],"text":"あなたがたは、さばきをする時、人を片寄り見てはならない。小さい者にも大いなる者にも聞かなければならない。人の顔を恐れてはならない。さばきは神の事だからである。あなたがたで決めるのにむずかしい事は、わたしのところに持ってこなければならない。わたしはそれを聞くであろう』。"},{"ref":"Deut.1.18","start":5001018,"end":5001018,"break":"none","ruby":[[9,1,"とき"],[35,1,"めい"]],"text":"わたしはまた、あの時、あなたがたがしなければならないことを、ことごとく命じた。"},{"ref":"Deut.1.19","start":5001019,"end":5001019,"break":"paragraph","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[9,1,"めい"],[28,2,"しゅったつ"],[39,1,"み"],[44,1,"おお"],[47,1,"おそ"],[51,2,"あらの"],[54,1,"とお"],[63,2,"さんち"],[66,1,"ゆ"],[68,1,"みち"]],"text":"われわれの神、主が命じられたように、われわれは、ホレブを出立して、あなたがたが見た、あの大きな恐ろしい荒野を通り、アモリびとの山地へ行く道によって、カデシ・バルネアにきた。"},{"ref":"Deut.1.20","start":5001020,"end":5001020,"break":"none","ruby":[[2,1,"とき"],[13,1,"い"],[30,1,"かみ"],[32,1,"しゅ"],[35,1,"あた"],[46,2,"さんち"],[49,1,"つ"]],"text":"その時わたしはあなたがたに言った、『あなたがたは、われわれの神、主がお与えになるアモリびとの山地に着いた。"},{"ref":"Deut.1.21","start":5001021,"end":5001021,"break":"none","ruby":[[0,1,"み"],[7,1,"かみ"],[9,1,"しゅ"],[13,1,"ち"],[19,1,"まえ"],[21,1,"お"],[30,2,"せんぞ"],[33,1,"かみ"],[35,1,"しゅ"],[37,1,"つ"],[46,1,"のぼ"],[49,1,"い"],[56,2,"じぶん"],[67,1,"おそ"]],"text":"見よ、あなたの神、主はこの地をあなたの前に置かれた。あなたの先祖の神、主が告げられたように、上って行って、これを自分のものとしなさい。恐れてはならない。おののいてはならない』。"},{"ref":"Deut.1.22","start":5001022,"end":5001022,"break":"none","ruby":[[6,1,"みな"],[11,2,"ちかよ"],[15,1,"い"],[25,1,"ひと"],[38,1,"ち"],[40,1,"さぐ"],[46,1,"みち"],[49,1,"のぼ"],[57,2,"まちまち"],[60,1,"い"],[67,2,"ふくめい"]],"text":"あなたがたは皆わたしに近寄って言った、『われわれは人をさきにつかわして、その地を探らせ、どの道から上るべきか、どの町々に入るべきかを、復命させましょう』。"},{"ref":"Deut.1.23","start":5001023,"end":5001023,"break":"none","ruby":[[5,1,"よ"],[8,1,"おも"],[32,2,"ぶぞく"],[44,1,"にん"],[46,1,"もの"],[48,1,"えら"]],"text":"このことは良いと思ったので、わたしはあなたがたのうち、おのおのの部族から、ひとりずつ十二人の者を選んだ。"},{"ref":"Deut.1.24","start":5001024,"end":5001024,"break":"none","ruby":[[0,1,"かれ"],[3,1,"み"],[11,2,"さんち"],[14,1,"のぼ"],[17,1,"い"],[25,1,"たに"],[27,1,"い"],[33,1,"さぐ"]],"text":"彼らは身をめぐらして、山地に上って行き、エシコルの谷へ行ってそれを探り、"},{"ref":"Deut.1.25","start":5001025,"end":5001025,"break":"none","ruby":[[2,1,"ち"],[9,1,"て"],[11,1,"と"],[24,1,"も"],[27,1,"くだ"],[30,2,"ふくめい"],[34,1,"い"],[44,1,"かみ"],[46,1,"しゅ"],[48,1,"たま"],[51,1,"ち"],[53,1,"よ"],[55,1,"ち"]],"text":"その地のくだものを手に取って、われわれのところに持って下り、復命して言った、『われわれの神、主が賜わる地は良い地です』。"},{"ref":"Deut.1.26","start":5001026,"end":5001026,"break":"paragraph","ruby":[[10,1,"のぼ"],[13,1,"い"],[18,1,"この"],[30,1,"かみ"],[32,1,"しゅ"],[34,2,"めいれい"]],"text":"しかし、あなたがたは上って行くことを好まないで、あなたがたの神、主の命令にそむいた。"},{"ref":"Deut.1.27","start":5001027,"end":5001027,"break":"none","ruby":[[3,2,"てんまく"],[11,1,"い"],[16,1,"しゅ"],[23,1,"にく"],[32,1,"て"],[34,1,"わた"],[37,1,"ほろ"],[49,1,"くに"],[52,1,"みちび"],[54,1,"だ"]],"text":"そして天幕でつぶやいて言った。『主はわれわれを憎んでアモリびとの手に渡し、滅ぼそうとしてエジプトの国から導き出されたのだ。"},{"ref":"Deut.1.28","start":5001028,"end":5001028,"break":"none","ruby":[[8,1,"のぼ"],[11,1,"い"],[16,2,"きょうだい"],[25,1,"たみ"],[34,1,"おお"],[39,1,"せ"],[41,1,"たか"],[44,2,"まちまち"],[47,1,"おお"],[53,1,"いし"],[57,1,"てん"],[59,1,"とど"],[79,2,"しそん"],[84,1,"ところ"],[86,1,"み"],[90,1,"い"],[99,1,"こころ"]],"text":"われわれはどこへ上って行くのか。兄弟たちは、「その民はわれわれよりも大きくて、背も高い。町々は大きく、その石がきは天に届いている。われわれは、またアナクびとの子孫をその所で見た」と言って、われわれの心をくじいた』。"},{"ref":"Deut.1.29","start":5001029,"end":5001029,"break":"none","ruby":[[2,1,"とき"],[14,1,"い"],[19,1,"かれ"],[35,1,"おそ"]],"text":"その時、わたしはあなたがたに言った、『彼らをこわがってはならない。また恐れてはならない。"},{"ref":"Deut.1.30","start":5001030,"end":5001030,"break":"none","ruby":[[0,1,"さき"],[2,1,"た"],[5,1,"い"],[15,1,"かみ"],[17,1,"しゅ"],[34,1,"め"],[36,1,"まえ"],[46,1,"おこな"],[63,1,"たたか"]],"text":"先に立って行かれるあなたがたの神、主はエジプトにおいて、あなたがたの目の前で、すべてのことを行われたように、あなたがたのために戦われるであろう。"},{"ref":"Deut.1.31","start":5001031,"end":5001031,"break":"none","ruby":[[8,2,"あらの"],[16,1,"かみ"],[18,1,"しゅ"],[21,1,"ひと"],[25,1,"こ"],[27,1,"だ"],[37,1,"だ"],[43,1,"み"],[55,1,"ところ"],[57,1,"く"],[64,1,"みち"]],"text":"あなたがたはまた荒野で、あなたの神、主が、人のその子を抱くように、あなたを抱かれるのを見た。あなたがたが、この所に来るまで、その道すがら、いつもそうであった』。"},{"ref":"Deut.1.32","start":5001032,"end":5001032,"break":"none","ruby":[[5,1,"い"],[25,1,"かみ"],[27,1,"しゅ"],[29,1,"しん"]],"text":"このように言っても、あなたがたはなお、あなたがたの神、主を信じなかった。"},{"ref":"Deut.1.33","start":5001033,"end":5001033,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"みちみち"],[10,1,"さき"],[12,1,"た"],[15,1,"い"],[24,2,"しゅくえい"],[28,2,"ばしょ"],[31,1,"さが"],[34,1,"よる"],[36,1,"ひ"],[44,1,"ひる"],[46,1,"くも"],[61,1,"ゆ"],[65,1,"みち"],[67,1,"しめ"]],"text":"主は道々あなたがたの先に立って行き、あなたがたが宿営する場所を捜し、夜は火のうちにあり、昼は雲のうちにあって、あなたがたに行くべき道を示された。"},{"ref":"Deut.1.34","start":5001034,"end":5001034,"break":"paragraph","ruby":[[0,1,"しゅ"],[9,2,"ことば"],[12,1,"き"],[15,1,"いか"],[18,1,"ちか"],[21,1,"い"]],"text":"主は、あなたがたの言葉を聞いて怒り、誓って言われた、"},{"ref":"Deut.1.35","start":5001035,"end":5001035,"break":"none","ruby":[[3,1,"わる"],[5,2,"せだい"],[8,2,"ひとびと"],[27,2,"せんぞ"],[32,1,"あた"],[36,1,"ちか"],[41,1,"よ"],[43,1,"ち"],[45,1,"み"],[47,1,"もの"]],"text":"『この悪い世代の人々のうちには、わたしが、あなたがたの先祖たちに与えると誓ったあの良い地を見る者は、ひとりもないであろう。"},{"ref":"Deut.1.36","start":5001036,"end":5001036,"break":"none","ruby":[[7,1,"こ"],[17,1,"み"],[30,1,"かれ"],[32,1,"ふ"],[35,1,"ち"],[42,1,"かれ"],[46,2,"しそん"],[49,1,"あた"],[57,1,"かれ"],[59,1,"まった"],[61,1,"しゅ"],[63,1,"したが"]],"text":"ただエフンネの子カレブだけはそれを見ることができるであろう。彼が踏んだ地を、わたしは彼とその子孫に与えるであろう。彼が全く主に従ったからである』。"},{"ref":"Deut.1.37","start":5001037,"end":5001037,"break":"none","ruby":[[0,1,"しゅ"],[20,1,"いか"],[23,1,"い"]],"text":"主はまた、あなたがたのゆえに、わたしをも怒って言われた、『おまえもまた、そこにはいることができないであろう。"},{"ref":"Deut.1.38","start":5001038,"end":5001038,"break":"none","ruby":[[4,1,"つか"],[12,1,"こ"],[30,1,"かれ"],[32,1,"ちから"],[37,1,"かれ"],[48,1,"え"]],"text":"おまえに仕えているヌンの子ヨシュアが、そこにはいるであろう。彼を力づけよ。彼はイスラエルにそれを獲させるであろう。"},{"ref":"Deut.1.39","start":5001039,"end":5001039,"break":"none","ruby":[[20,1,"い"],[41,1,"ひ"],[45,2,"ぜんあく"],[60,2,"こども"],[84,1,"かれ"],[87,1,"あた"],[91,1,"かれ"],[97,2,"しょゆう"]],"text":"またあなたがたが、かすめられるであろうと言ったあなたがたのおさなごたち、およびその日にまだ善悪をわきまえないあなたがたの子供たちが、そこにはいるであろう。わたしはそれを彼らに与える。彼らはそれを所有とするであろう。"},{"ref":"Deut.1.40","start":5001040,"end":5001040,"break":"none","ruby":[[6,1,"み"],[13,2,"こうかい"],[16,1,"みち"],[22,2,"あらの"],[25,1,"すす"],[28,1,"い"]],"text":"あなたがたは身をめぐらし、紅海の道によって、荒野に進んで行きなさい』。"},{"ref":"Deut.1.41","start":5001041,"end":5001041,"break":"paragraph","ruby":[[14,1,"こた"],[17,1,"い"],[27,1,"しゅ"],[33,1,"つみ"],[35,1,"おか"],[46,1,"かみ"],[48,1,"しゅ"],[50,1,"めい"],[64,1,"のぼ"],[67,1,"い"],[70,1,"たたか"],[86,2,"ぶき"],[89,1,"み"],[91,1,"お"],[101,2,"さんち"],[104,1,"のぼ"],[107,1,"い"]],"text":"しかし、あなたがたはわたしに答えて言った、『われわれは主にむかって罪を犯しました。われわれの神、主が命じられたように、われわれは上って行って戦いましょう』。そして、おのおの武器を身に帯びて、かるがるしく山地へ上って行こうとした。"},{"ref":"Deut.1.42","start":5001042,"end":5001042,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[10,1,"い"],[16,1,"かれ"],[19,1,"い"],[32,1,"のぼ"],[35,1,"い"],[46,1,"たたか"],[83,1,"てき"],[85,1,"う"],[87,1,"やぶ"]],"text":"その時、主はわたしに言われた、『彼らに言いなさい、「あなたがたは上って行ってはならない。また戦ってはならない。わたしはあなたがたのうちにいない。おそらく、あなたがたは敵に撃ち敗られるであろう」』。"},{"ref":"Deut.1.43","start":5001043,"end":5001043,"break":"none","ruby":[[9,1,"つ"],[21,1,"き"],[26,1,"しゅ"],[28,2,"めいれい"],[41,2,"さんち"],[44,1,"のぼ"],[47,1,"い"]],"text":"このようにわたしが告げたのに、あなたがたは聞かないで主の命令にそむき、ほしいままに山地へ上って行ったが、"},{"ref":"Deut.1.44","start":5001044,"end":5001044,"break":"none","ruby":[[2,2,"さんち"],[5,1,"す"],[23,1,"む"],[27,1,"で"],[35,1,"お"],[47,1,"お"],[56,1,"う"],[58,1,"やぶ"],[68,1,"およ"]],"text":"その山地に住んでいるアモリびとが、あなたがたに向かって出てきて、はちが追うように、あなたがたを追いかけ、セイルで撃ち敗って、ホルマにまで及んだ。"},{"ref":"Deut.1.45","start":5001045,"end":5001045,"break":"none","ruby":[[6,1,"かえ"],[12,1,"しゅ"],[14,1,"まえ"],[16,1,"な"],[21,1,"しゅ"],[29,1,"こえ"],[31,1,"き"],[41,1,"みみ"],[43,1,"かたむ"]],"text":"あなたがたは帰ってきて、主の前で泣いたが、主はあなたがたの声を聞かず、あなたがたに耳を傾けられなかった。"},{"ref":"Deut.1.46","start":5001046,"end":5001046,"break":"none","ruby":[[11,1,"ひ"],[12,1,"ひさ"],[39,2,"にっすう"]],"text":"こうしてあなたがたは、日久しくカデシにとどまった。あなたがたのそこにとどまった日数のとおりである。"}]