[{"ref":"2Pet.3.1","start":61003001,"end":61003001,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[12,1,"いま"],[15,1,"だい"],[18,2,"てがみ"],[27,1,"か"],[37,2,"てがみ"],[43,2,"きおく"],[46,1,"よ"],[48,1,"おこ"],[57,2,"じゅんしん"],[60,1,"こころ"],[62,1,"ふる"],[64,1,"た"]],"text":"愛する者たちよ。わたしは今この第二の手紙をあなたがたに書きおくり、これらの手紙によって記憶を呼び起し、あなたがたの純真な心を奮い立たせようとした。"},{"ref":"2Pet.3.2","start":61003002,"end":61003002,"break":"none","ruby":[[4,1,"せい"],[7,3,"よげんしゃ"],[18,1,"かた"],[21,2,"ことば"],[31,2,"しと"],[36,1,"つた"],[39,1,"しゅ"],[42,2,"すくいぬし"],[45,1,"いまし"],[50,1,"おも"],[52,1,"だ"]],"text":"それは、聖なる預言者たちがあらかじめ語った言葉と、あなたがたの使徒たちが伝えた主なる救主の戒めとを、思い出させるためである。"},{"ref":"2Pet.3.3","start":61003003,"end":61003003,"break":"none","ruby":[[2,1,"つぎ"],[7,1,"し"],[15,1,"おわ"],[18,1,"とき"],[24,1,"もの"],[36,1,"で"],[41,2,"じぶん"],[44,2,"よくじょう"],[50,2,"せいかつ"]],"text":"まず次のことを知るべきである。終りの時にあざける者たちが、あざけりながら出てきて、自分の欲情のままに生活し、"},{"ref":"2Pet.3.4","start":61003004,"end":61003004,"break":"none","ruby":[[1,1,"しゅ"],[3,2,"らいりん"],[6,2,"やくそく"],[17,2,"せんぞ"],[22,1,"ねむ"],[38,2,"てんち"],[40,2,"そうぞう"],[43,1,"はじ"],[56,1,"かわ"],[65,1,"い"]],"text":"「主の来臨の約束はどうなったのか。先祖たちが眠りについてから、すべてのものは天地創造の初めからそのままであって、変ってはいない」と言うであろう。"},{"ref":"2Pet.3.5","start":61003005,"end":61003005,"break":"none","ruby":[[5,1,"かれ"],[13,1,"みと"],[23,1,"ふる"],[25,1,"むかし"],[27,1,"てん"],[29,2,"そんざい"],[33,1,"ち"],[35,1,"かみ"],[37,1,"ことば"],[43,1,"みず"],[54,1,"みず"],[59,1,"な"]],"text":"すなわち、彼らはこのことを認めようとはしない。古い昔に天が存在し、地は神の言によって、水がもとになり、また、水によって成ったのであるが、"},{"ref":"2Pet.3.6","start":61003006,"end":61003006,"break":"none","ruby":[[2,1,"とき"],[4,2,"せかい"],[8,2,"みことば"],[13,1,"みず"],[20,1,"ほろ"]],"text":"その時の世界は、御言により水でおおわれて滅んでしまった。"},{"ref":"2Pet.3.7","start":61003007,"end":61003007,"break":"none","ruby":[[4,1,"いま"],[6,1,"てん"],[8,1,"ち"],[12,1,"おな"],[14,2,"みことば"],[20,2,"ほぞん"],[25,1,"ふ"],[26,2,"しんこう"],[29,2,"ひとびと"],[37,1,"ほろ"],[43,1,"ひ"],[45,1,"ひ"],[47,1,"や"],[51,1,"とき"],[59,1,"たも"]],"text":"しかし、今の天と地とは、同じ御言によって保存され、不信仰な人々がさばかれ、滅ぼさるべき日に火で焼かれる時まで、そのまま保たれているのである。"},{"ref":"2Pet.3.8","start":61003008,"end":61003008,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[10,2,"いちじ"],[13,1,"わす"],[22,1,"しゅ"],[30,1,"にち"],[33,1,"ねん"],[42,1,"ねん"],[45,1,"にち"]],"text":"愛する者たちよ。この一事を忘れてはならない。主にあっては、一日は千年のようであり、千年は一日のようである。"},{"ref":"2Pet.3.9","start":61003009,"end":61003009,"break":"none","ruby":[[2,2,"ひとびと"],[9,1,"おも"],[18,1,"しゅ"],[20,2,"やくそく"],[23,2,"じっこう"],[48,1,"ほろ"],[61,1,"もの"],[63,2,"くいあらた"],[67,1,"いた"],[72,1,"のぞ"],[81,1,"たい"],[87,2,"にんたい"]],"text":"ある人々がおそいと思っているように、主は約束の実行をおそくしておられるのではない。ただ、ひとりも滅びることがなく、すべての者が悔改めに至ることを望み、あなたがたに対してながく忍耐しておられるのである。"},{"ref":"2Pet.3.10","start":61003010,"end":61003010,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"ひ"],[8,2,"ぬすびと"],[14,1,"おそ"],[17,1,"く"],[22,1,"ひ"],[26,1,"てん"],[28,3,"だいおんきょう"],[35,1,"き"],[37,1,"さ"],[40,2,"てんたい"],[43,1,"や"],[50,1,"ち"],[54,1,"うえ"],[56,1,"つく"],[58,1,"だ"],[68,1,"や"]],"text":"しかし、主の日は盗人のように襲って来る。その日には、天は大音響をたてて消え去り、天体は焼けてくずれ、地とその上に造り出されたものも、みな焼きつくされるであろう。"},{"ref":"2Pet.3.11","start":61003011,"end":61003011,"break":"none","ruby":[[15,1,"お"],[28,1,"かみ"],[30,1,"ひ"],[32,2,"とうらい"],[35,2,"ねっしん"],[38,1,"ま"],[40,1,"のぞ"]],"text":"このように、これらはみなくずれ落ちていくものであるから、神の日の到来を熱心に待ち望んでいるあなたがたは、"},{"ref":"2Pet.3.12","start":61003012,"end":61003012,"break":"none","ruby":[[0,2,"きょくりょく"],[6,2,"しんじん"],[8,1,"ぶか"],[10,1,"おこな"],[27,1,"ひ"],[31,1,"てん"],[33,1,"も"],[39,2,"てんたい"],[42,1,"や"]],"text":"極力、きよく信心深い行いをしていなければならない。その日には、天は燃えくずれ、天体は焼けうせてしまう。"},{"ref":"2Pet.3.13","start":61003013,"end":61003013,"break":"none","ruby":[[11,1,"かみ"],[13,2,"やくそく"],[16,1,"したが"],[20,1,"ぎ"],[22,1,"す"],[24,1,"あたら"],[27,1,"てん"],[29,1,"あたら"],[32,1,"ち"],[35,1,"ま"],[37,1,"のぞ"]],"text":"しかし、わたしたちは、神の約束に従って、義の住む新しい天と新しい地とを待ち望んでいる。"},{"ref":"2Pet.3.14","start":61003014,"end":61003014,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[16,1,"ひ"],[18,1,"ま"],[41,1,"やす"],[45,1,"こころ"],[48,1,"かみ"],[54,1,"で"],[61,1,"はげ"]],"text":"愛する者たちよ。それだから、この日を待っているあなたがたは、しみもなくきずもなく、安らかな心で、神のみまえに出られるように励みなさい。"},{"ref":"2Pet.3.15","start":61003015,"end":61003015,"break":"none","ruby":[[9,1,"しゅ"],[11,2,"かんよう"],[14,1,"すくい"],[22,1,"おも"],[40,1,"あい"],[43,2,"きょうだい"],[50,1,"かれ"],[52,1,"あた"],[57,2,"ちえ"],[70,1,"か"]],"text":"また、わたしたちの主の寛容は救のためであると思いなさい。このことは、わたしたちの愛する兄弟パウロが、彼に与えられた知恵によって、あなたがたに書きおくったとおりである。"},{"ref":"2Pet.3.16","start":61003016,"end":61003016,"break":"none","ruby":[[0,1,"かれ"],[5,2,"てがみ"],[16,1,"の"],[24,2,"てがみ"],[27,1,"なか"],[44,2,"かしょ"],[51,2,"むがく"],[54,1,"こころ"],[56,1,"さだ"],[61,1,"もの"],[69,2,"せいしょ"],[84,2,"むり"],[87,2,"かいしゃく"],[96,2,"じぶん"],[99,2,"めつぼう"],[102,1,"まね"]],"text":"彼は、どの手紙にもこれらのことを述べている。その手紙の中には、ところどころ、わかりにくい箇所もあって、無学で心の定まらない者たちは、ほかの聖書についてもしているように、無理な解釈をほどこして、自分の滅亡を招いている。"},{"ref":"2Pet.3.17","start":61003017,"end":61003017,"break":"none","ruby":[[0,1,"あい"],[3,1,"もの"],[25,1,"こころ"],[35,2,"ひどう"],[38,1,"もの"],[40,1,"まど"],[44,1,"さそ"],[46,1,"こ"],[56,2,"じしん"],[59,2,"かくしん"],[62,1,"うしな"],[72,1,"こころ"]],"text":"愛する者たちよ。それだから、あなたがたはかねてから心がけているように、非道の者の惑わしに誘い込まれて、あなたがた自身の確信を失うことのないように心がけなさい。"},{"ref":"2Pet.3.18","start":61003018,"end":61003018,"break":"none","ruby":[[10,1,"しゅ"],[13,2,"すくいぬし"],[24,1,"めぐ"],[27,2,"ちしき"],[39,1,"ゆた"],[48,2,"えいこう"],[52,1,"いま"],[57,2,"えいえん"],[60,1,"ひ"],[62,1,"いた"],[68,1,"しゅ"]],"text":"そして、わたしたちの主また救主イエス・キリストの恵みと知識とにおいて、ますます豊かになりなさい。栄光が、今も、また永遠の日に至るまでも、主にあるように、アァメン。"}]