[{"ref":"Rom.15.1","start":45015001,"end":45015001,"break":"paragraph","ruby":[[5,1,"つよ"],[7,1,"もの"],[10,1,"つよ"],[14,1,"もの"],[18,1,"よわ"],[31,2,"じぶん"],[36,1,"よろこ"]],"text":"わたしたち強い者は、強くない者たちの弱さをになうべきであって、自分だけを喜ばせることをしてはならない。"},{"ref":"Rom.15.2","start":45015002,"end":45015002,"break":"none","ruby":[[13,1,"とな"],[15,1,"ひと"],[17,1,"とく"],[19,1,"たか"],[28,1,"えき"],[30,1,"はか"],[33,1,"かれ"],[36,1,"よろこ"]],"text":"わたしたちひとりびとりは、隣り人の徳を高めるために、その益を図って彼らを喜ばすべきである。"},{"ref":"Rom.15.3","start":45015003,"end":45015003,"break":"none","ruby":[[8,2,"じしん"],[11,1,"よろこ"],[37,1,"もの"],[48,1,"ふ"],[56,1,"か"]],"text":"キリストさえ、ご自身を喜ばせることはなさらなかった。むしろ「あなたをそしる者のそしりが、わたしに降りかかった」と書いてあるとおりであった。"},{"ref":"Rom.15.4","start":45015004,"end":45015004,"break":"none","ruby":[[5,1,"か"],[9,1,"こと"],[23,1,"おしえ"],[28,1,"か"],[41,2,"せいしょ"],[44,1,"あた"],[47,2,"にんたい"],[50,1,"なぐさ"],[58,1,"のぞ"]],"text":"これまでに書かれた事がらは、すべてわたしたちの教のために書かれたのであって、それは聖書の与える忍耐と慰めとによって、望みをいだかせるためである。"},{"ref":"Rom.15.5","start":45015005,"end":45015005,"break":"none","ruby":[[4,2,"にんたい"],[7,1,"なぐさ"],[11,1,"かみ"],[34,1,"たがい"],[36,1,"おな"],[38,1,"おも"]],"text":"どうか、忍耐と慰めとの神が、あなたがたに、キリスト・イエスにならって互に同じ思いをいだかせ、"},{"ref":"Rom.15.6","start":45015006,"end":45015006,"break":"none","ruby":[[5,1,"こころ"],[7,1,"ひと"],[12,1,"こえ"],[14,1,"あ"],[25,1,"しゅ"],[35,1,"ちち"],[38,1,"かみ"],[46,1,"くだ"]],"text":"こうして、心を一つにし、声を合わせて、わたしたちの主イエス・キリストの父なる神をあがめさせて下さるように。"},{"ref":"Rom.15.7","start":45015007,"end":45015007,"break":"paragraph","ruby":[[19,1,"う"],[24,1,"くだ"],[38,1,"たがい"],[40,1,"う"],[46,1,"かみ"],[48,2,"えいこう"]],"text":"こういうわけで、キリストもわたしたちを受けいれて下さったように、あなたがたも互に受けいれて、神の栄光をあらわすべきである。"},{"ref":"Rom.15.8","start":45015008,"end":45015008,"break":"none","ruby":[[4,1,"い"],[12,1,"かみ"],[14,2,"しんじつ"],[17,1,"あき"],[27,2,"かつれい"],[32,1,"もの"],[34,1,"しもべ"],[44,2,"ふそ"],[49,1,"う"],[52,2,"やくそく"],[55,2,"ほしょう"],[60,1,"とも"]],"text":"わたしは言う、キリストは神の真実を明らかにするために、割礼のある者の僕となられた。それは父祖たちの受けた約束を保証すると共に、"},{"ref":"Rom.15.9","start":45015009,"end":45015009,"break":"none","breaks":[[29,"stanza"],[46,"line"],[58,"line"]],"ruby":[[0,3,"いほうじん"],[9,1,"う"],[12,1,"かみ"],[40,3,"いほうじん"],[44,1,"なか"],[61,2,"みな"],[66,1,"うた"],[70,1,"か"]],"text":"異邦人もあわれみを受けて神をあがめるようになるためである、「それゆえ、わたしは、異邦人の中であなたにさんびをささげ、また、御名をほめ歌う」と書いてあるとおりである。"},{"ref":"Rom.15.10","start":45015010,"end":45015010,"break":"paragraph","breaks":[[11,"stanza"]],"ruby":[[5,1,"い"],[12,3,"いほうじん"],[17,1,"しゅ"],[19,1,"たみ"],[21,1,"とも"],[23,1,"よろこ"]],"text":"また、こう言っている、「異邦人よ、主の民と共に喜べ」。"},{"ref":"Rom.15.11","start":45015011,"end":45015011,"break":"none","breaks":[[3,"stanza"],[21,"line"]],"ruby":[[8,3,"いほうじん"],[13,1,"しゅ"],[26,1,"たみ"],[29,1,"しゅ"]],"text":"また、「すべての異邦人よ、主をほめまつれ。もろもろの民よ、主をほめたたえよ」。"},{"ref":"Rom.15.12","start":45015012,"end":45015012,"break":"none","breaks":[[12,"stanza"],[26,"line"],[46,"line"]],"ruby":[[6,1,"い"],[18,1,"ね"],[21,1,"め"],[23,1,"で"],[26,3,"いほうじん"],[30,1,"おさ"],[36,1,"た"],[38,1,"あ"],[41,1,"もの"],[43,1,"く"],[46,3,"いほうじん"],[50,1,"かれ"],[52,1,"のぞ"]],"text":"またイザヤは言っている、「エッサイの根から芽が出て、異邦人を治めるために立ち上がる者が来る。異邦人は彼に望みをおくであろう」。"},{"ref":"Rom.15.13","start":45015013,"end":45015013,"break":"none","ruby":[[4,1,"のぞ"],[7,1,"かみ"],[10,2,"しんこう"],[14,1,"く"],[20,1,"よろこ"],[23,2,"へいあん"],[34,1,"み"],[38,2,"せいれい"],[41,1,"ちから"],[54,1,"のぞ"],[63,1,"くだ"]],"text":"どうか、望みの神が、信仰から来るあらゆる喜びと平安とを、あなたがたに満たし、聖霊の力によって、あなたがたを、望みにあふれさせて下さるように。"},{"ref":"Rom.15.14","start":45015014,"end":45015014,"break":"paragraph","ruby":[[7,2,"きょうだい"],[18,2,"じしん"],[22,2,"ぜんい"],[33,2,"ちえ"],[36,1,"み"],[44,1,"たがい"],[46,2,"くんかい"],[49,1,"あ"],[51,1,"ちから"],[63,1,"かた"],[65,1,"しん"]],"text":"さて、わたしの兄弟たちよ。あなたがた自身が、善意にあふれ、あらゆる知恵に満たされ、そして互に訓戒し合う力のあることを、わたしは堅く信じている。"},{"ref":"Rom.15.15","start":45015015,"end":45015015,"break":"none","ruby":[[14,2,"きおく"],[17,1,"あら"],[36,1,"おも"],[41,1,"か"],[49,1,"かみ"],[56,1,"たま"],[60,1,"めぐ"],[67,1,"か"]],"text":"しかし、わたしはあなたがたの記憶を新たにするために、ところどころ、かなり思いきって書いた。それは、神からわたしに賜わった恵みによって、書いたのである。"},{"ref":"Rom.15.16","start":45015016,"end":45015016,"break":"none","ruby":[[5,1,"めぐ"],[8,1,"う"],[18,3,"いほうじん"],[34,1,"つか"],[37,1,"もの"],[42,1,"かみ"],[44,2,"ふくいん"],[50,2,"さいし"],[53,1,"やく"],[55,1,"つと"],[62,3,"いほうじん"],[67,2,"せいれい"],[80,2,"みむね"],[89,1,"もの"]],"text":"このように恵みを受けたのは、わたしが異邦人のためにキリスト・イエスに仕える者となり、神の福音のために祭司の役を勤め、こうして異邦人を、聖霊によってきよめられた、御旨にかなうささげ物とするためである。"},{"ref":"Rom.15.17","start":45015017,"end":45015017,"break":"none","ruby":[[8,1,"かみ"],[11,2,"ほうし"],[31,1,"ほこ"]],"text":"だから、わたしは神への奉仕については、キリスト・イエスにあって誇りうるのである。"},{"ref":"Rom.15.18","start":45015018,"end":45015018,"break":"none","ruby":[[5,3,"いほうじん"],[9,2,"じゅうじゅん"],[27,1,"もち"],[31,2,"ことば"]],"text":"わたしは、異邦人を従順にするために、キリストがわたしを用いて、言葉とわざ、"},{"ref":"Rom.15.19","start":45015019,"end":45015019,"break":"none","ruby":[[4,3,"ふしぎ"],[9,1,"ちから"],[11,2,"せいれい"],[14,1,"ちから"],[20,1,"はたら"],[24,1,"くだ"],[31,1,"ほか"],[38,1,"なに"],[40,1,"かた"],[45,1,"おも"],[66,1,"はじ"],[70,1,"めぐ"],[81,1,"いた"],[91,2,"ふくいん"],[94,1,"み"]],"text":"しるしと不思議との力、聖霊の力によって、働かせて下さったことの外には、あえて何も語ろうとは思わない。こうして、わたしはエルサレムから始まり、巡りめぐってイルリコに至るまで、キリストの福音を満たしてきた。"},{"ref":"Rom.15.20","start":45015020,"end":45015020,"break":"none","ruby":[[2,1,"さい"],[8,1,"せつ"],[10,1,"のぞ"],[18,2,"たにん"],[21,2,"どだい"],[24,1,"うえ"],[26,1,"た"],[42,2,"みな"],[47,1,"とな"],[55,1,"ところ"],[57,2,"ふくいん"],[60,1,"の"],[62,1,"つた"]],"text":"その際、わたしの切に望んだところは、他人の土台の上に建てることをしないで、キリストの御名がまだ唱えられていない所に福音を宣べ伝えることであった。"},{"ref":"Rom.15.21","start":45015021,"end":45015021,"break":"none","breaks":[[5,"stanza"],[28,"line"]],"ruby":[[6,1,"かれ"],[11,1,"の"],[13,1,"つた"],[23,2,"ひとびと"],[26,1,"み"],[28,1,"き"],[36,2,"ひとびと"],[39,1,"さと"],[47,1,"か"]],"text":"すなわち、「彼のことを宣べ伝えられていなかった人々が見、聞いていなかった人々が悟るであろう」と書いてあるとおりである。"},{"ref":"Rom.15.22","start":45015022,"end":45015022,"break":"paragraph","ruby":[[18,1,"ところ"],[20,1,"い"],[30,1,"さまた"]],"text":"こういうわけで、わたしはあなたがたの所に行くことを、たびたび妨げられてきた。"},{"ref":"Rom.15.23","start":45015023,"end":45015023,"break":"none","ruby":[[3,1,"いま"],[9,2,"ちほう"],[16,1,"はたら"],[18,2,"よち"],[32,1,"おもむ"],[34,2,"ばあい"],[43,1,"ところ"],[45,1,"い"],[51,2,"たねん"],[54,2,"ねつぼう"]],"text":"しかし今では、この地方にはもはや働く余地がなく、かつイスパニヤに赴く場合、あなたがたの所に行くことを、多年、熱望していたので、――"},{"ref":"Rom.15.24","start":45015024,"end":45015024,"break":"none","ruby":[[2,2,"とちゅう"],[10,1,"あ"],[15,2,"いくぶん"],[23,1,"ねが"],[35,1,"み"],[48,1,"おく"],[55,1,"い"],[61,1,"のぞ"]],"text":"その途中あなたがたに会い、まず幾分でもわたしの願いがあなたがたによって満たされたら、あなたがたに送られてそこへ行くことを、望んでいるのである。"},{"ref":"Rom.15.25","start":45015025,"end":45015025,"break":"none","ruby":[[3,1,"いま"],[5,2,"ばあい"],[8,2,"せいと"],[13,1,"つか"],[30,1,"い"]],"text":"しかし今の場合、聖徒たちに仕えるために、わたしはエルサレムに行こうとしている。"},{"ref":"Rom.15.26","start":45015026,"end":45015026,"break":"none","ruby":[[16,2,"ひとびと"],[28,2,"せいと"],[31,1,"なか"],[33,1,"まず"],[36,2,"ひとびと"],[39,2,"えんじょ"],[46,2,"さんせい"]],"text":"なぜなら、マケドニヤとアカヤとの人々は、エルサレムにおる聖徒の中の貧しい人々を援助することに賛成したからである。"},{"ref":"Rom.15.27","start":45015027,"end":45015027,"break":"none","ruby":[[5,1,"かれ"],[8,2,"さんせい"],[16,2,"どうじ"],[20,1,"かれ"],[25,2,"ひとびと"],[28,2,"ふさい"],[42,3,"いほうじん"],[46,1,"かれ"],[49,1,"れい"],[51,1,"もの"],[63,1,"にく"],[65,1,"もの"],[70,1,"かれ"],[73,1,"つか"],[79,2,"とうぜん"]],"text":"たしかに、彼らは賛成した。しかし同時に、彼らはかの人々に負債がある。というのは、もし異邦人が彼らの霊の物にあずかったとすれば、肉の物をもって彼らに仕えるのは、当然だからである。"},{"ref":"Rom.15.28","start":45015028,"end":45015028,"break":"none","ruby":[[10,2,"しごと"],[13,1,"す"],[17,1,"かれ"],[22,1,"み"],[24,2,"てわた"],[28,1,"のち"],[36,1,"ところ"],[49,1,"い"],[53,1,"おも"]],"text":"そこでわたしは、この仕事を済ませて彼らにこの実を手渡した後、あなたがたの所をとおって、イスパニヤに行こうと思う。"},{"ref":"Rom.15.29","start":45015029,"end":45015029,"break":"none","ruby":[[9,1,"ところ"],[11,1,"ゆ"],[13,1,"とき"],[22,1,"み"],[28,2,"しゅくふく"],[34,1,"ゆ"],[40,1,"しん"]],"text":"そしてあなたがたの所に行く時には、キリストの満ちあふれる祝福をもって行くことと、信じている。"},{"ref":"Rom.15.30","start":45015030,"end":45015030,"break":"paragraph","ruby":[[0,2,"きょうだい"],[12,1,"しゅ"],[27,2,"みたま"],[30,1,"あい"],[43,1,"ねが"],[52,1,"とも"],[54,1,"ちから"],[68,1,"かみ"],[70,1,"いの"]],"text":"兄弟たちよ。わたしたちの主イエス・キリストにより、かつ御霊の愛によって、あなたがたにお願いする。どうか、共に力をつくして、わたしのために神に祈ってほしい。"},{"ref":"Rom.15.31","start":45015031,"end":45015031,"break":"none","ruby":[[15,2,"ふしん"],[18,1,"と"],[21,1,"すく"],[34,1,"たい"],[41,2,"ほうし"],[44,2,"せいと"],[49,1,"う"]],"text":"すなわち、わたしがユダヤにおる不信の徒から救われ、そしてエルサレムに対するわたしの奉仕が聖徒たちに受けいれられるものとなるように、"},{"ref":"Rom.15.32","start":45015032,"end":45015032,"break":"none","ruby":[[3,1,"かみ"],[5,2,"みむね"],[11,1,"よろこ"],[23,1,"ところ"],[25,1,"い"],[28,1,"とも"],[34,1,"あ"],[45,1,"いの"]],"text":"また、神の御旨により、喜びをもってあなたがたの所に行き、共になぐさめ合うことができるように祈ってもらいたい。"},{"ref":"Rom.15.33","start":45015033,"end":45015033,"break":"none","ruby":[[4,2,"へいわ"],[7,1,"かみ"],[14,2,"いちどう"],[17,1,"とも"]],"text":"どうか、平和の神があなたがた一同と共にいますように、アァメン。"}]