[{"ref":"Amos.7.1","start":30007001,"end":30007001,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[14,1,"しめ"],[19,1,"み"],[23,1,"ばん"],[24,1,"ぐさ"],[28,1,"で"],[30,1,"はじ"],[33,1,"しゅ"],[40,1,"つく"],[45,1,"み"],[51,1,"ばん"],[52,1,"ぐさ"],[54,1,"おう"],[56,1,"か"],[59,1,"のち"]],"text":"主なる神はこのようにわたしに示された。見よ、二番草のはえ出る初めに主は、いなごを造られた。見よ、その二番草は王の刈った後に、はえたものである。"},{"ref":"Amos.7.2","start":30007002,"end":30007002,"break":"none","breaks":[[26,"stanza"],[46,"line"],[57,"line"]],"ruby":[[6,1,"ち"],[8,2,"あおくさ"],[11,1,"く"],[13,1,"つく"],[16,1,"とき"],[22,1,"い"],[27,1,"しゅ"],[30,1,"かみ"],[50,1,"ちい"],[53,1,"もの"],[61,1,"た"]],"text":"そのいなごが地の青草を食い尽した時、わたしは言った、「主なる神よ、どうぞ、ゆるしてください。ヤコブは小さい者です、どうして立つことができましょう」。"},{"ref":"Amos.7.3","start":30007003,"end":30007003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[10,1,"おも"],[23,1,"おこ"],[29,1,"しゅ"],[31,1,"い"]],"text":"主はこのことについて思いかえされ、「このことは起さない」と主は言われた。"},{"ref":"Amos.7.4","start":30007004,"end":30007004,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[14,1,"しめ"],[19,1,"み"],[22,1,"しゅ"],[25,1,"かみ"],[34,1,"ひ"],[36,1,"よ"],[41,1,"ひ"],[43,2,"おおふち"],[46,1,"や"],[51,1,"ち"],[53,1,"や"]],"text":"主なる神はこのようにわたしに示された。見よ、主なる神はさばきのために火を呼ばれた。火は大淵を焼き、また地を焼こうとした。"},{"ref":"Amos.7.5","start":30007005,"end":30007005,"break":"none","breaks":[[11,"stanza"],[30,"line"],[41,"line"]],"ruby":[[2,1,"とき"],[7,1,"い"],[12,1,"しゅ"],[15,1,"かみ"],[34,1,"ちい"],[37,1,"もの"],[45,1,"た"]],"text":"その時わたしは言った、「主なる神よ、どうぞ、やめてください。ヤコブは小さい者です、どうして立つことができましょう」。"},{"ref":"Amos.7.6","start":30007006,"end":30007006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[10,1,"おも"],[25,1,"おこ"],[31,1,"しゅ"],[34,1,"かみ"],[36,1,"い"]],"text":"主はこのことについて思いかえされ、「このこともまた起さない」と主なる神は言われた。"},{"ref":"Amos.7.7","start":30007007,"end":30007007,"break":"none","ruby":[[2,1,"しゅ"],[8,1,"しめ"],[13,1,"み"],[16,1,"しゅ"],[18,1,"はか"],[26,1,"きず"],[29,1,"いし"],[33,1,"うえ"],[35,1,"た"],[40,1,"て"],[42,1,"はか"]],"text":"また主はわたしに示された。見よ、主は測りなわをもって築いた石がきの上に立ち、その手に測りなわをもっておられた。"},{"ref":"Amos.7.8","start":30007008,"end":30007008,"break":"none","breaks":[[56,"stanza"],[69,"line"],[83,"line"]],"ruby":[[3,1,"しゅ"],[9,1,"い"],[24,1,"なに"],[26,1,"み"],[32,1,"はか"],[42,1,"こた"],[47,1,"しゅ"],[51,1,"い"],[57,1,"み"],[64,1,"はか"],[71,1,"たみ"],[78,1,"なか"],[80,1,"お"],[90,1,"かれ"],[93,2,"みすご"]],"text":"そして主はわたしに言われた、「アモスよ、あなたは何を見るか」。「測りなわ」とわたしが答えると、主はまた言われた、「見よ、わたしは測りなわをわが民イスラエルの中に置く。わたしはもはや彼らを見過しにしない。"},{"ref":"Amos.7.9","start":30007009,"end":30007009,"break":"line","breaks":[[12,"line"],[27,"line"]],"ruby":[[4,1,"たか"],[6,1,"ところ"],[8,1,"あら"],[18,2,"せいじょ"],[21,1,"あ"],[44,1,"いえ"],[46,1,"た"],[48,1,"む"]],"text":"イサクの高き所は荒され、イスラエルの聖所は荒れはてる。わたしはつるぎをもってヤラベアムの家に立ち向かう」。"},{"ref":"Amos.7.10","start":30007010,"end":30007010,"break":"none","ruby":[[0,1,"とき"],[6,2,"さいし"],[20,1,"おう"],[27,1,"ひと"],[34,1,"い"],[44,1,"いえ"],[48,1,"なか"],[68,1,"ち"],[70,1,"かれ"],[77,2,"ことば"],[80,1,"た"]],"text":"時にベテルの祭司アマジヤは、イスラエルの王ヤラベアムに人をつかわして言う、「イスラエルの家のただ中で、アモスはあなたにそむきました。この地は彼のもろもろの言葉に耐えることができません。"},{"ref":"Amos.7.11","start":30007011,"end":30007011,"break":"stanza","breaks":[[16,"line"],[33,"line"],[50,"line"]],"ruby":[[9,1,"い"],[30,1,"し"],[39,1,"かなら"],[41,1,"とら"],[46,1,"い"],[52,1,"くに"],[54,1,"はな"]],"text":"アモスはこのように言っています、『ヤラベアムはつるぎによって死ぬ、イスラエルは必ず捕えられて行って、その国を離れる』と」。"},{"ref":"Amos.7.12","start":30007012,"end":30007012,"break":"none","ruby":[[13,1,"い"],[18,3,"せんけんしゃ"],[23,1,"い"],[29,1,"ち"],[37,1,"ち"],[42,1,"た"],[47,1,"ち"],[49,2,"よげん"]],"text":"それからアマジヤはアモスに言った、「先見者よ、行ってユダの地にのがれ、かの地でパンを食べ、かの地で預言せよ。"},{"ref":"Amos.7.13","start":30007013,"end":30007013,"break":"none","ruby":[[9,1,"ど"],[11,2,"よげん"],[24,1,"おう"],[26,2,"せいじょ"],[29,1,"くに"],[31,1,"みや"]],"text":"しかしベテルでは二度と預言してはならない。ここは王の聖所、国の宮だから」。"},{"ref":"Amos.7.14","start":30007014,"end":30007014,"break":"paragraph","ruby":[[9,1,"こた"],[18,3,"よげんしゃ"],[28,3,"よげんしゃ"],[32,1,"こ"],[42,2,"ぼくしゃ"],[56,1,"くわ"],[58,1,"き"],[60,1,"つく"],[62,1,"もの"]],"text":"アモスはアマジヤに答えた、「わたしは預言者でもなく、また預言者の子でもない。わたしは牧者である。わたしはいちじく桑の木を作る者である。"},{"ref":"Amos.7.15","start":30007015,"end":30007015,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"む"],[9,1,"したが"],[14,1,"ところ"],[21,1,"と"],[25,1,"い"],[31,1,"たみ"],[38,2,"よげん"],[45,1,"しゅ"],[51,1,"い"]],"text":"ところが主は群れに従っている所からわたしを取り、『行って、わが民イスラエルに預言せよ』と、主はわたしに言われた。"},{"ref":"Amos.7.16","start":30007016,"end":30007016,"break":"stanza","breaks":[[14,"line"],[21,"line"],[38,"line"]],"ruby":[[4,1,"いま"],[6,1,"しゅ"],[8,2,"ことば"],[11,1,"き"],[18,1,"い"],[28,1,"む"],[32,2,"よげん"],[42,1,"いえ"],[44,1,"む"],[48,1,"かた"]],"text":"それゆえ今、主の言葉を聞け。あなたは言う、『イスラエルに向かって預言するな、イサクの家に向かって語るな』と。"},{"ref":"Amos.7.17","start":30007017,"end":30007017,"break":"line","breaks":[[14,"line"],[29,"line"],[48,"line"],[65,"line"],[80,"line"],[97,"line"]],"ruby":[[5,1,"しゅ"],[9,1,"い"],[19,1,"つま"],[21,1,"まち"],[23,2,"ゆうじょ"],[37,1,"むすめ"],[45,1,"たお"],[52,1,"ち"],[54,1,"はか"],[59,1,"わ"],[72,1,"けが"],[75,1,"ち"],[77,1,"し"],[86,1,"かなら"],[88,1,"とら"],[93,1,"い"],[99,1,"くに"],[101,1,"はな"]],"text":"それゆえ、主はこう言われる、『あなたの妻は町で遊女となり、あなたのむすこ、娘たちはつるぎに倒れ、あなたの地は測りなわで分かたれる。そしてあなたは汚れた地で死に、イスラエルは必ず捕えられて行って、その国を離れる』」。"}]