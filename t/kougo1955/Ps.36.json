[{"ref":"Ps.36.1","start":19036001,"end":19036001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせた主のしもべダビデの歌","breaks":[[22,"line"]],"ruby":[[3,1,"あ"],[6,1,"もの"],[14,1,"こころ"],[19,1,"い"],[24,1,"め"],[26,1,"まえ"],[28,1,"かみ"],[30,1,"おそ"],[33,1,"おそ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[16,1,"しゅ"],[25,1,"うた"]],"text":"とがは悪しき者にむかい、その心のうちに言う。その目の前に神を恐れる恐れはない。"},{"ref":"Ps.36.2","start":19036002,"end":19036002,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[2,2,"じぶん"],[5,2,"ふぎ"],[20,1,"にく"],[35,1,"め"]],"text":"彼は自分の不義があらわされないため、また憎まれないために、みずからその目でおもねる。"},{"ref":"Ps.36.3","start":19036003,"end":19036003,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"くち"],[4,2,"ことば"],[12,1,"あざむ"],[18,1,"かれ"],[20,2,"ちえ"],[23,1,"え"],[29,1,"ぜん"],[31,1,"おこな"],[33,1,"こと"]],"text":"その口の言葉はよこしまと欺きである。彼は知恵を得ることと、善を行う事とをやめた。"},{"ref":"Ps.36.4","start":19036004,"end":19036004,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[4,1,"とこ"],[6,1,"うえ"],[13,1,"こと"],[24,1,"みち"],[26,1,"み"],[32,1,"あく"]],"text":"彼はその床の上でよこしまな事をたくらみ、よからぬ道に身をおいて、悪をきらわない。"},{"ref":"Ps.36.5","start":19036005,"end":19036005,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[13,1,"てん"],[17,1,"およ"],[28,1,"くも"],[32,1,"およ"]],"text":"主よ、あなたのいつくしみは天にまで及び、あなたのまことは雲にまで及ぶ。"},{"ref":"Ps.36.6","start":19036006,"end":19036006,"break":"line","breaks":[[14,"line"],[31,"line"]],"ruby":[[4,1,"ぎ"],[6,1,"かみ"],[8,1,"やま"],[22,1,"おお"],[25,1,"ふち"],[31,1,"しゅ"],[38,1,"ひと"],[40,1,"けもの"],[43,1,"すく"]],"text":"あなたの義は神の山のごとく、あなたのさばきは大きな淵のようだ。主よ、あなたは人と獣とを救われる。"},{"ref":"Ps.36.7","start":19036007,"end":19036007,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"かみ"],[16,1,"たっと"],[25,1,"ひと"],[27,1,"こ"],[34,1,"つばさ"],[39,1,"さ"],[41,1,"どころ"],[43,1,"え"]],"text":"神よ、あなたのいつくしみはいかに尊いことでしょう。人の子らはあなたの翼のかげに避け所を得、"},{"ref":"Ps.36.8","start":19036008,"end":19036008,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"いえ"],[6,1,"ゆた"],[14,1,"あ"],[16,1,"た"],[26,1,"たの"],[30,1,"かわ"],[32,1,"みず"],[34,1,"かれ"],[37,1,"の"]],"text":"あなたの家の豊かなのによって飽き足りる。あなたはその楽しみの川の水を彼らに飲ませられる。"},{"ref":"Ps.36.9","start":19036009,"end":19036009,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"いずみ"],[24,1,"ひかり"],[29,1,"ひかり"],[31,1,"み"]],"text":"いのちの泉はあなたのもとにあり、われらはあなたの光によって光を見る。"},{"ref":"Ps.36.10","start":19036010,"end":19036010,"break":"line","breaks":[[24,"line"]],"ruby":[[8,1,"し"],[10,1,"もの"],[12,1,"た"],[21,1,"ほどこ"],[24,1,"こころ"],[26,1,"なお"],[28,1,"もの"],[30,1,"た"],[33,1,"すくい"],[35,1,"ほどこ"]],"text":"どうか、あなたを知る者に絶えずいつくしみを施し、心の直き者に絶えず救を施してください。"},{"ref":"Ps.36.11","start":19036011,"end":19036011,"break":"line","breaks":[[14,"line"],[32,"line"]],"ruby":[[0,1,"たか"],[3,1,"もの"],[5,1,"あし"],[11,1,"ふ"],[14,1,"あ"],[17,1,"もの"],[19,1,"て"],[25,1,"お"],[27,1,"だ"]],"text":"高ぶる者の足がわたしを踏み、悪しき者の手がわたしを追い出すことをゆるさないでください。"},{"ref":"Ps.36.12","start":19036012,"end":19036012,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"あく"],[2,1,"おこな"],[4,1,"もの"],[9,1,"たお"],[12,1,"かれ"],[15,1,"う"],[17,1,"ふ"],[23,1,"お"]],"text":"悪を行う者はそこに倒れ、彼らは打ち伏せられて、起きあがることはできない。"}]