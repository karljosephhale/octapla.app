[{"ref":"Heb.4.1","start":58004001,"end":58004001,"break":"paragraph","ruby":[[6,1,"かみ"],[8,2,"あんそく"],[16,2,"やくそく"],[22,2,"そんぞく"],[35,2,"まんいち"],[47,1,"もの"],[56,1,"なか"],[59,1,"で"],[70,2,"ちゅうい"]],"text":"それだから、神の安息にはいるべき約束が、まだ存続しているにかかわらず、万一にも、はいりそこなう者が、あなたがたの中から出ることがないように、注意しようではないか。"},{"ref":"Heb.4.2","start":58004002,"end":58004002,"break":"none","ruby":[[6,1,"かれ"],[9,1,"おな"],[20,2,"ふくいん"],[23,1,"つた"],[41,1,"き"],[44,2,"みことば"],[48,1,"かれ"],[52,2,"むえき"],[63,1,"き"],[66,1,"もの"],[71,2,"しんこう"],[77,1,"むす"]],"text":"というのは、彼らと同じく、わたしたちにも福音が伝えられているのである。しかし、その聞いた御言は、彼らには無益であった。それが、聞いた者たちに、信仰によって結びつけられなかったからである。"},{"ref":"Heb.4.3","start":58004003,"end":58004003,"break":"none","breaks":[[35,"stanza"],[44,"line"]],"ruby":[[10,1,"しん"],[15,1,"もの"],[18,2,"あんそく"],[40,1,"いか"],[44,1,"かれ"],[51,2,"あんそく"],[68,1,"ちか"],[76,1,"い"],[97,1,"よ"],[99,1,"はじ"],[105,1,"あ"]],"text":"ところが、わたしたち信じている者は、安息にはいることができる。それは、「わたしが怒って、彼らをわたしの安息に、はいらせることはしないと、誓ったように」と言われているとおりである。しかも、みわざは世の初めに、でき上がっていた。"},{"ref":"Heb.4.4","start":58004004,"end":58004004,"break":"none","ruby":[[5,2,"せいしょ"],[10,2,"かしょ"],[14,2,"なぬか"],[16,1,"め"],[26,1,"かみ"],[29,2,"なぬか"],[31,1,"め"],[43,1,"やす"],[49,1,"い"]],"text":"すなわち、聖書のある箇所で、七日目のことについて、「神は、七日目にすべてのわざをやめて休まれた」と言われており、"},{"ref":"Heb.4.5","start":58004005,"end":58004005,"break":"none","ruby":[[7,1,"かれ"],[14,2,"あんそく"],[31,1,"い"]],"text":"またここで、「彼らをわたしの安息に、はいらせることはしない」と言われている。"},{"ref":"Heb.4.6","start":58004006,"end":58004006,"break":"none","ruby":[[6,2,"あんそく"],[12,2,"きかい"],[16,2,"ひとびと"],[21,1,"のこ"],[36,1,"はじ"],[39,2,"ふくいん"],[42,1,"つた"],[47,2,"ひとびと"],[51,1,"ふ"],[52,2,"じゅうじゅん"]],"text":"そこで、その安息にはいる機会が、人々になお残されているのであり、しかも、初めに福音を伝えられた人々は、不従順のゆえに、はいることをしなかったのであるから、"},{"ref":"Heb.4.7","start":58004007,"end":58004007,"break":"none","breaks":[[44,"stanza"],[58,"line"]],"ruby":[[0,1,"かみ"],[11,1,"ひ"],[21,1,"さだ"],[24,1,"なが"],[26,1,"とき"],[34,1,"さき"],[36,2,"いんよう"],[50,1,"こえ"],[52,1,"き"],[64,1,"こころ"],[89,1,"い"]],"text":"神は、あらためて、ある日を「きょう」として定め、長く時がたってから、先に引用したとおり、「きょう、み声を聞いたなら、あなたがたの心を、かたくなにしてはいけない」とダビデをとおして言われたのである。"},{"ref":"Heb.4.8","start":58004008,"end":58004008,"break":"none","ruby":[[7,1,"かれ"],[10,1,"やす"],[21,1,"かみ"],[33,1,"ひ"],[41,1,"かた"]],"text":"もしヨシュアが彼らを休ませていたとすれば、神はあとになって、ほかの日のことについて語られたはずはない。"},{"ref":"Heb.4.9","start":58004009,"end":58004009,"break":"none","ruby":[[8,3,"あんそくにち"],[12,1,"やす"],[16,1,"かみ"],[18,1,"たみ"],[25,1,"のこ"]],"text":"こういうわけで、安息日の休みが、神の民のためにまだ残されているのである。"},{"ref":"Heb.4.10","start":58004010,"end":58004010,"break":"none","ruby":[[5,1,"かみ"],[7,2,"あんそく"],[14,1,"もの"],[17,1,"かみ"],[26,1,"やす"],[34,2,"じぶん"],[40,1,"やす"]],"text":"なぜなら、神の安息にはいった者は、神がみわざをやめて休まれたように、自分もわざを休んだからである。"},{"ref":"Heb.4.11","start":58004011,"end":58004011,"break":"none","ruby":[[15,2,"あんそく"],[24,2,"どりょく"],[42,1,"おな"],[47,1,"ふ"],[48,2,"じゅうじゅん"],[51,2,"あくれい"],[59,1,"お"],[62,1,"ゆ"],[64,1,"もの"],[66,1,"で"]],"text":"したがって、わたしたちは、この安息にはいるように努力しようではないか。そうでないと、同じような不従順の悪例にならって、落ちて行く者が出るかもしれない。"},{"ref":"Heb.4.12","start":58004012,"end":58004012,"break":"none","ruby":[[6,1,"かみ"],[8,1,"ことば"],[10,1,"い"],[16,1,"ちから"],[23,1,"は"],[31,1,"するど"],[35,2,"せいしん"],[38,2,"れいこん"],[42,2,"かんせつ"],[45,2,"こつづい"],[49,1,"き"],[51,1,"はな"],[56,1,"さ"],[63,1,"こころ"],[65,1,"おも"],[68,1,"こころざし"],[71,2,"みわ"]],"text":"というのは、神の言は生きていて、力があり、もろ刃のつるぎよりも鋭くて、精神と霊魂と、関節と骨髄とを切り離すまでに刺しとおして、心の思いと志とを見分けることができる。"},{"ref":"Heb.4.13","start":58004013,"end":58004013,"break":"none","ruby":[[4,1,"かみ"],[18,1,"ひ"],[19,2,"ぞうぶつ"],[37,1,"かみ"],[39,1,"め"],[42,1,"はだか"],[63,1,"かみ"],[65,1,"たい"],[75,1,"い"],[77,1,"ひら"]],"text":"そして、神のみまえには、あらわでない被造物はひとつもなく、すべてのものは、神の目には裸であり、あらわにされているのである。この神に対して、わたしたちは言い開きをしなくてはならない。"},{"ref":"Heb.4.14","start":58004014,"end":58004014,"break":"paragraph","ruby":[[16,1,"てん"],[22,1,"い"],[26,3,"だいさいし"],[31,1,"かみ"],[33,1,"こ"],[54,2,"こくはく"],[58,2,"しんこう"],[64,1,"まも"]],"text":"さて、わたしたちには、もろもろの天をとおって行かれた大祭司なる神の子イエスがいますのであるから、わたしたちの告白する信仰をかたく守ろうではないか。"},{"ref":"Heb.4.15","start":58004015,"end":58004015,"break":"none","ruby":[[2,3,"だいさいし"],[13,1,"よわ"],[16,1,"おも"],[37,1,"つみ"],[39,1,"おか"],[65,1,"おな"],[70,2,"しれん"],[73,1,"あ"]],"text":"この大祭司は、わたしたちの弱さを思いやることのできないようなかたではない。罪は犯されなかったが、すべてのことについて、わたしたちと同じように試錬に会われたのである。"},{"ref":"Heb.4.16","start":58004016,"end":58004016,"break":"none","ruby":[[16,1,"う"],[22,1,"めぐ"],[30,2,"じき"],[33,1,"え"],[35,1,"たす"],[38,1,"う"],[53,1,"めぐ"],[56,2,"みざ"],[59,1,"ちか"]],"text":"だから、わたしたちは、あわれみを受け、また、恵みにあずかって時機を得た助けを受けるために、はばかることなく恵みの御座に近づこうではないか。"}]