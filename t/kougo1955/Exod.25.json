[{"ref":"Exod.25.1","start":2025001,"end":2025001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Exod.25.2","start":2025002,"end":2025002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"つ"],[24,1,"もの"],[26,1,"たずさ"],[40,1,"こころ"],[43,1,"よろこ"],[48,1,"もの"],[60,1,"もの"],[62,1,"う"],[64,1,"と"]],"text":"「イスラエルの人々に告げて、わたしのためにささげ物を携えてこさせなさい。すべて、心から喜んでする者から、わたしにささげる物を受け取りなさい。"},{"ref":"Exod.25.3","start":2025003,"end":2025003,"break":"none","ruby":[[6,1,"かれ"],[10,1,"う"],[12,1,"と"],[19,1,"もの"],[31,1,"きん"],[33,1,"ぎん"],[35,2,"せいどう"]],"text":"あなたがたが彼らから受け取るべきささげ物はこれである。すなわち金、銀、青銅、"},{"ref":"Exod.25.4","start":2025004,"end":2025004,"break":"none","ruby":[[0,1,"あお"],[1,1,"いと"],[3,1,"むらさき"],[4,1,"いと"],[6,1,"ひ"],[7,1,"いと"],[9,2,"あま"],[12,2,"ねんし"],[18,2,"けいと"]],"text":"青糸、紫糸、緋糸、亜麻の撚糸、やぎの毛糸、"},{"ref":"Exod.25.5","start":2025005,"end":2025005,"break":"none","ruby":[[3,1,"そめ"],[5,2,"おひつじ"],[8,1,"かわ"],[15,1,"かわ"],[21,1,"ざい"]],"text":"あかね染の雄羊の皮、じゅごんの皮、アカシヤ材、"},{"ref":"Exod.25.6","start":2025006,"end":2025006,"break":"none","ruby":[[3,1,"あぶら"],[5,1,"そそ"],[7,1,"あぶら"],[9,1,"こう"],[13,2,"くんこう"],[19,2,"こうりょう"]],"text":"ともし油、注ぎ油と香ばしい薫香のための香料、"},{"ref":"Exod.25.7","start":2025007,"end":2025007,"break":"none","ruby":[[0,1,"しま"],[9,2,"むねあて"],[15,2,"ほうせき"]],"text":"縞めのう、エポデと胸当にはめる宝石。"},{"ref":"Exod.25.8","start":2025008,"end":2025008,"break":"none","ruby":[[3,1,"かれ"],[13,2,"せいじょ"],[16,1,"つく"],[27,1,"かれ"],[33,1,"す"]],"text":"また、彼らにわたしのために聖所を造らせなさい。わたしが彼らのうちに住むためである。"},{"ref":"Exod.25.9","start":2025009,"end":2025009,"break":"none","ruby":[[7,1,"しめ"],[9,2,"まくや"],[12,1,"かた"],[24,1,"うつわ"],[26,1,"かた"],[28,1,"したが"],[35,1,"つく"]],"text":"すべてあなたに示す幕屋の型および、そのもろもろの器の型に従って、これを造らなければならない。"},{"ref":"Exod.25.10","start":2025010,"end":2025010,"break":"paragraph","ruby":[[0,1,"かれ"],[7,1,"ざい"],[9,1,"はこ"],[11,1,"つく"],[22,1,"なが"],[30,1,"はん"],[32,1,"はば"],[39,1,"はん"],[41,1,"たか"],[49,1,"はん"]],"text":"彼らはアカシヤ材で箱を造らなければならない。長さは二キュビト半、幅は一キュビト半、高さは一キュビト半。"},{"ref":"Exod.25.11","start":2025011,"end":2025011,"break":"none","ruby":[[4,2,"じゅんきん"],[26,2,"ないがい"],[40,1,"うえ"],[42,2,"しゅうい"],[45,1,"きん"],[47,1,"かざ"],[49,1,"ふち"],[51,1,"つく"]],"text":"あなたは純金でこれをおおわなければならない。すなわち内外ともにこれをおおい、その上の周囲に金の飾り縁を造らなければならない。"},{"ref":"Exod.25.12","start":2025012,"end":2025012,"break":"none","ruby":[[2,1,"きん"],[4,1,"かん"],[8,1,"い"],[17,1,"と"],[19,1,"つ"],[37,1,"かん"],[42,1,"がわ"],[48,1,"かん"],[53,1,"がわ"],[55,1,"つ"]],"text":"また金の環四つを鋳て、その四すみに取り付けなければならない。すなわち二つの環をこちら側に、二つの環をあちら側に付けなければならない。"},{"ref":"Exod.25.13","start":2025013,"end":2025013,"break":"none","ruby":[[6,1,"ざい"],[11,1,"つく"],[14,1,"きん"]],"text":"またアカシヤ材のさおを造り、金でこれをおおわなければならない。"},{"ref":"Exod.25.14","start":2025014,"end":2025014,"break":"none","ruby":[[8,1,"はこ"],[10,2,"そくめん"],[13,1,"かん"],[15,1,"とお"],[21,1,"はこ"]],"text":"そしてそのさおを箱の側面の環に通し、それで箱をかつがなければならない。"},{"ref":"Exod.25.15","start":2025015,"end":2025015,"break":"none","ruby":[[3,1,"はこ"],[5,1,"かん"],[7,1,"さ"],[10,1,"お"],[16,1,"ぬ"],[18,1,"はな"]],"text":"さおは箱の環に差して置き、それを抜き放してはならない。"},{"ref":"Exod.25.16","start":2025016,"end":2025016,"break":"none","ruby":[[5,1,"はこ"],[16,1,"あた"],[23,1,"いた"],[25,1,"おさ"]],"text":"そしてその箱に、わたしがあなたに与えるあかしの板を納めなければならない。"},{"ref":"Exod.25.17","start":2025017,"end":2025017,"break":"none","ruby":[[2,2,"じゅんきん"],[5,3,"しょくざいしょ"],[9,1,"つく"],[20,1,"なが"],[28,1,"はん"],[30,1,"はば"],[37,1,"はん"]],"text":"また純金の贖罪所を造らなければならない。長さは二キュビト半、幅は一キュビト半。"},{"ref":"Exod.25.18","start":2025018,"end":2025018,"break":"none","ruby":[[5,1,"きん"],[12,1,"つく"],[26,2,"うちもの"],[28,1,"つく"],[33,3,"しょくざいしょ"],[37,2,"りょうはし"],[40,1,"お"]],"text":"また二つの金のケルビムを造らなければならない。これを打物造りとし、贖罪所の両端に置かなければならない。"},{"ref":"Exod.25.19","start":2025019,"end":2025019,"break":"none","ruby":[[9,1,"はし"],[21,1,"はし"],[23,1,"つく"],[31,3,"しょくざいしょ"],[35,2,"いちぶ"],[42,2,"りょうはし"],[45,1,"つく"]],"text":"一つのケルブをこの端に、一つのケルブをかの端に造り、ケルビムを贖罪所の一部としてその両端に造らなければならない。"},{"ref":"Exod.25.20","start":2025020,"end":2025020,"break":"none","ruby":[[5,1,"つばさ"],[7,1,"たか"],[9,1,"の"],[14,1,"つばさ"],[19,3,"しょくざいしょ"],[27,1,"かお"],[29,1,"たがい"],[34,1,"あ"],[42,1,"かお"],[44,3,"しょくざいしょ"]],"text":"ケルビムは翼を高く伸べ、その翼をもって贖罪所をおおい、顔は互にむかい合い、ケルビムの顔は贖罪所にむかわなければならない。"},{"ref":"Exod.25.21","start":2025021,"end":2025021,"break":"none","ruby":[[4,3,"しょくざいしょ"],[8,1,"はこ"],[10,1,"うえ"],[12,1,"お"],[15,1,"はこ"],[17,1,"なか"],[24,1,"さづ"],[31,1,"いた"],[33,1,"おさ"]],"text":"あなたは贖罪所を箱の上に置き、箱の中にはわたしが授けるあかしの板を納めなければならない。"},{"ref":"Exod.25.22","start":2025022,"end":2025022,"break":"none","ruby":[[2,1,"ところ"],[12,1,"あ"],[15,3,"しょくざいしょ"],[19,1,"うえ"],[27,1,"はこ"],[29,1,"うえ"],[41,1,"あいだ"],[51,2,"ひとびと"],[62,1,"めい"],[74,1,"こと"],[81,1,"かた"]],"text":"その所でわたしはあなたに会い、贖罪所の上から、あかしの箱の上にある二つのケルビムの間から、イスラエルの人々のために、わたしが命じようとするもろもろの事を、あなたに語るであろう。"},{"ref":"Exod.25.23","start":2025023,"end":2025023,"break":"paragraph","ruby":[[10,1,"ざい"],[12,1,"つくえ"],[14,1,"つく"],[25,1,"なが"],[34,1,"はば"],[42,1,"たか"],[50,1,"はん"]],"text":"あなたはまたアカシヤ材の机を造らなければならない。長さは二キュビト、幅は一キュビト、高さは一キュビト半。"},{"ref":"Exod.25.24","start":2025024,"end":2025024,"break":"none","ruby":[[0,2,"じゅんきん"],[10,2,"しゅうい"],[13,1,"きん"],[15,1,"かざ"],[17,1,"ふち"],[19,1,"つく"]],"text":"純金でこれをおおい、周囲に金の飾り縁を造り、"},{"ref":"Exod.25.25","start":2025025,"end":2025025,"break":"none","ruby":[[4,2,"しゅうい"],[7,1,"て"],[8,1,"はば"],[10,1,"さん"],[12,1,"つく"],[17,1,"さん"],[19,2,"しゅうい"],[22,1,"きん"],[24,1,"かざ"],[26,1,"ふち"],[28,1,"つく"]],"text":"またその周囲に手幅の棧を造り、その棧の周囲に金の飾り縁を造らなければならない。"},{"ref":"Exod.25.26","start":2025026,"end":2025026,"break":"none","ruby":[[8,1,"きん"],[10,1,"かん"],[14,1,"つく"],[22,1,"あし"],[28,1,"しょ"],[32,1,"かん"],[34,1,"と"],[36,1,"つ"]],"text":"また、そのために金の環四つを造り、その四つの足のすみ四か所にその環を取り付けなければならない。"},{"ref":"Exod.25.27","start":2025027,"end":2025027,"break":"none","ruby":[[0,1,"かん"],[2,1,"さん"],[7,1,"つ"],[11,1,"つくえ"],[19,1,"い"],[22,1,"ところ"]],"text":"環は棧のわきに付けて、机をかつぐさおを入れる所としなければならない。"},{"ref":"Exod.25.28","start":2025028,"end":2025028,"break":"none","ruby":[[6,1,"ざい"],[11,1,"つく"],[14,1,"きん"],[30,1,"つくえ"]],"text":"またアカシヤ材のさおを造り、金でこれをおおい、それをもって、机をかつがなければならない。"},{"ref":"Exod.25.29","start":2025029,"end":2025029,"break":"none","ruby":[[5,1,"さら"],[7,2,"にゅうこう"],[10,1,"も"],[12,1,"はい"],[16,2,"かんさい"],[19,1,"そそ"],[24,1,"びん"],[26,1,"はち"],[28,1,"つく"],[35,2,"じゅんきん"],[38,1,"つく"]],"text":"また、その皿、乳香を盛る杯および灌祭を注ぐための瓶と鉢を造り、これらは純金で造らなければならない。"},{"ref":"Exod.25.30","start":2025030,"end":2025030,"break":"none","ruby":[[3,1,"つくえ"],[5,1,"うえ"],[8,1,"そな"],[14,1,"お"],[18,1,"つね"],[24,1,"まえ"]],"text":"そして机の上には供えのパンを置いて、常にわたしの前にあるようにしなければならない。"},{"ref":"Exod.25.31","start":2025031,"end":2025031,"break":"paragraph","ruby":[[2,2,"じゅんきん"],[5,2,"しょくだい"],[8,1,"つく"],[19,2,"しょくだい"],[22,2,"うちもの"],[24,1,"つく"],[31,1,"だい"],[33,1,"みき"],[35,1,"がく"],[37,1,"ふし"],[39,1,"はな"],[44,1,"つら"]],"text":"また純金の燭台を造らなければならない。燭台は打物造りとし、その台、幹、萼、節、花を一つに連ならせなければならない。"},{"ref":"Exod.25.32","start":2025032,"end":2025032,"break":"none","ruby":[[5,1,"えだ"],[13,1,"だ"],[17,2,"しょくだい"],[23,1,"えだ"],[27,1,"がわ"],[31,2,"しょくだい"],[37,1,"えだ"],[41,1,"がわ"],[44,1,"だ"]],"text":"また六つの枝をそのわきから出させ、燭台の三つの枝をこの側から、燭台の三つの枝をかの側から出させなければならない。"},{"ref":"Exod.25.33","start":2025033,"end":2025033,"break":"none","ruby":[[6,1,"はな"],[8,1,"かたち"],[15,1,"がく"],[22,1,"ふし"],[24,1,"はな"],[32,1,"えだ"],[46,1,"はな"],[48,1,"かたち"],[55,1,"がく"],[62,1,"ふし"],[64,1,"はな"],[72,1,"えだ"],[81,2,"しょくだい"],[85,1,"で"],[90,1,"えだ"]],"text":"あめんどうの花の形をした三つの萼が、それぞれ節と花をもって一つの枝にあり、また、あめんどうの花の形をした三つの萼が、それぞれ節と花をもってほかの枝にあるようにし、燭台から出る六つの枝を、みなそのようにしなければならない。"},{"ref":"Exod.25.34","start":2025034,"end":2025034,"break":"none","ruby":[[3,2,"しょくだい"],[6,1,"みき"],[16,1,"はな"],[18,1,"かたち"],[25,1,"がく"],[27,1,"つ"],[32,1,"がく"],[39,1,"ふし"],[41,1,"はな"]],"text":"また、燭台の幹には、あめんどうの花の形をした四つの萼を付け、その萼にはそれぞれ節と花をもたせなさい。"},{"ref":"Exod.25.35","start":2025035,"end":2025035,"break":"none","ruby":[[7,1,"えだ"],[9,1,"した"],[14,1,"ふし"],[16,1,"と"],[18,1,"つ"],[21,1,"つぎ"],[26,1,"えだ"],[28,1,"した"],[33,1,"ふし"],[35,1,"と"],[37,1,"つ"],[40,1,"さら"],[42,1,"つぎ"],[47,1,"えだ"],[49,1,"した"],[54,1,"ふし"],[56,1,"と"],[58,1,"つ"],[61,2,"しょくだい"],[64,1,"みき"],[67,1,"で"],[72,1,"えだ"]],"text":"すなわち二つの枝の下に一つの節を取り付け、次の二つの枝の下に一つの節を取り付け、更に次の二つの枝の下に一つの節を取り付け、燭台の幹から出る六つの枝に、みなそのようにしなければならない。"},{"ref":"Exod.25.36","start":2025036,"end":2025036,"break":"none","ruby":[[4,1,"ふし"],[6,1,"えだ"],[11,1,"つら"],[19,2,"じゅんきん"],[22,2,"うちもの"],[24,1,"つく"]],"text":"それらの節と枝を一つに連ね、ことごとく純金の打物造りにしなければならない。"},{"ref":"Exod.25.37","start":2025037,"end":2025037,"break":"none","ruby":[[10,1,"ざら"],[14,1,"つく"],[23,1,"ざら"],[25,1,"ひ"],[34,2,"ぜんぽう"],[37,1,"てら"]],"text":"また、それのともしび皿を七つ造り、そのともしび皿に火をともして、その前方を照させなければならない。"},{"ref":"Exod.25.38","start":2025038,"end":2025038,"break":"none","ruby":[[2,1,"しん"],[3,1,"き"],[10,1,"しん"],[11,1,"と"],[13,1,"ざら"],[15,2,"じゅんきん"],[18,1,"つく"]],"text":"その芯切りばさみと、芯取り皿は純金で造らなければならない。"},{"ref":"Exod.25.39","start":2025039,"end":2025039,"break":"none","ruby":[[4,2,"じゅんきん"],[12,2,"しょくだい"],[25,1,"うつわ"],[28,1,"つく"]],"text":"すなわち純金一タラントで燭台と、これらのもろもろの器とが造られなければならない。"},{"ref":"Exod.25.40","start":2025040,"end":2025040,"break":"none","ruby":[[7,1,"やま"],[9,1,"しめ"],[13,1,"かた"],[15,1,"したが"],[18,2,"ちゅうい"],[25,1,"つく"]],"text":"そしてあなたが山で示された型に従い、注意してこれを造らなければならない。"}]