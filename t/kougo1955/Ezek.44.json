[{"ref":"Ezek.44.1","start":26044001,"end":26044001,"break":"paragraph","ruby":[[5,1,"かれ"],[11,1,"つ"],[15,2,"せいじょ"],[18,1,"ひがし"],[20,1,"む"],[25,1,"そと"],[27,1,"もん"],[29,1,"かえ"],[33,1,"もん"],[35,1,"と"]],"text":"こうして、彼はわたしを連れて、聖所の東に向いている外の門に帰ると、門は閉じてあった。"},{"ref":"Ezek.44.2","start":26044002,"end":26044002,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[13,1,"もん"],[15,1,"と"],[26,1,"ひら"],[58,1,"かみ"],[60,1,"しゅ"],[79,1,"と"]],"text":"彼はわたしに言った、「この門は閉じたままにしておけ、開いてはならない。ここからだれもはいってはならない。イスラエルの神、主が、ここからはいったのだから、これは閉じたままにしておけ。"},{"ref":"Ezek.44.3","start":26044003,"end":26044003,"break":"none","ruby":[[2,1,"きみ"],[5,1,"もの"],[12,1,"うち"],[14,1,"ざ"],[17,1,"しゅ"],[19,1,"まえ"],[24,1,"しょく"],[27,1,"もん"],[29,1,"ろう"],[31,1,"とお"],[44,1,"そと"],[46,1,"で"]],"text":"ただ君たる者だけが、この内に座し、主の前でパンを食し、門の廊を通ってはいり、またそこから外に出よ」。"},{"ref":"Ezek.44.4","start":26044004,"end":26044004,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"つ"],[12,1,"きた"],[14,1,"もん"],[16,1,"みち"],[19,1,"みや"],[21,1,"まえ"],[23,1,"い"],[31,1,"み"],[37,1,"み"],[40,1,"しゅ"],[42,2,"えいこう"],[45,1,"しゅ"],[47,1,"みや"],[49,1,"み"],[59,1,"ふ"]],"text":"彼はまたわたしを連れて、北の門の道から宮の前に行った。わたしが見ていると、見よ、主の栄光が主の宮に満ちた。わたしがひれ伏すと、"},{"ref":"Ezek.44.5","start":26044005,"end":26044005,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"ひと"],[14,1,"こ"],[17,1,"しゅ"],[19,1,"みや"],[36,2,"きてい"],[52,1,"つ"],[59,1,"こと"],[61,1,"こころ"],[66,1,"め"],[68,1,"そそ"],[71,1,"みみ"],[73,1,"かたむ"],[79,1,"みや"],[87,1,"ゆる"],[93,1,"もの"],[96,2,"せいじょ"],[109,1,"もの"],[112,1,"こころ"]],"text":"主はわたしに言われた、「人の子よ、主の宮のすべてのおきてと、そのすべての規定とについて、わたしがあなたに告げるすべての事に心をとめ、目を注ぎ、耳を傾けよ。また宮にはいることを許されている者と、聖所にはいることのできない者とに心せよ。"},{"ref":"Ezek.44.6","start":26044006,"end":26044006,"break":"none","ruby":[[2,2,"はんぎゃく"],[5,1,"いえ"],[15,1,"いえ"],[17,1,"い"],[20,1,"しゅ"],[23,1,"かみ"],[28,1,"い"],[39,1,"いえ"],[44,1,"にく"]],"text":"また反逆の家であるイスラエルの家に言え。主なる神は、こう言われる、イスラエルの家よ、その憎むべきことをやめよ。"},{"ref":"Ezek.44.7","start":26044007,"end":26044007,"break":"none","ruby":[[15,2,"しょくもつ"],[20,2,"しぼう"],[23,1,"ち"],[32,1,"とき"],[34,1,"こころ"],[37,1,"にく"],[41,2,"かつれい"],[44,1,"う"],[48,3,"いほうじん"],[52,1,"い"],[58,2,"せいじょ"],[68,1,"けが"],[80,1,"にく"],[93,2,"けいやく"],[96,1,"やぶ"]],"text":"すなわちあなたがたは、わたしの食物である脂肪と血とがささげられる時、心にも肉にも、割礼を受けない異邦人を入れて、わが聖所におらせ、これを汚した。また、もろもろの憎むべきものをもって、わが契約を破った。"},{"ref":"Ezek.44.8","start":26044008,"end":26044008,"break":"none","ruby":[[9,1,"せい"],[12,1,"もの"],[14,1,"まも"],[16,1,"つとめ"],[18,1,"おこた"],[25,3,"いほうじん"],[29,1,"た"],[35,2,"せいじょ"],[38,1,"つとめ"],[40,1,"まも"]],"text":"あなたがたは、わが聖なる物を守る務を怠り、かえって異邦人を立てて、わが聖所の務を守らせた。"},{"ref":"Ezek.44.9","start":26044009,"end":26044009,"break":"paragraph","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[13,1,"い"],[24,2,"ひとびと"],[36,3,"いほうじん"],[43,1,"こころ"],[45,1,"にく"],[48,2,"かつれい"],[51,1,"う"],[59,1,"もの"],[64,2,"せいじょ"]],"text":"それゆえ、主なる神は、こう言われる、イスラエルの人々のうちにいるすべての異邦人のうち、心と肉とに割礼を受けないすべての者は、わが聖所にはいってはならない。"},{"ref":"Ezek.44.10","start":26044010,"end":26044010,"break":"none","ruby":[[4,1,"ひと"],[16,1,"まよ"],[19,1,"とき"],[21,2,"ぐうぞう"],[24,1,"した"],[32,1,"まよ"],[34,1,"で"],[37,1,"とお"],[39,1,"はな"],[42,1,"もの"],[47,1,"つみ"],[49,1,"お"]],"text":"またレビ人であって、イスラエルが迷った時、偶像を慕い、わたしから迷い出て、遠く離れた者は、その罪を負わなければならない。"},{"ref":"Ezek.44.11","start":26044011,"end":26044011,"break":"none","ruby":[[4,1,"かれ"],[9,2,"せいじょ"],[13,1,"つか"],[15,1,"びと"],[20,1,"みや"],[22,1,"もん"],[24,1,"まも"],[26,1,"もの"],[31,1,"みや"],[33,1,"つか"],[43,1,"たみ"],[49,2,"はんさい"],[54,2,"ぎせい"],[60,1,"ころ"],[63,1,"かれ"],[66,1,"まえ"],[68,1,"た"],[71,1,"つか"]],"text":"すなわち彼らはわが聖所で、仕え人となり、宮の門を守る者となり、宮に仕えるしもべとなり、民のために、燔祭および犠牲のものを殺し、彼らの前に立って仕えなければならない。"},{"ref":"Ezek.44.12","start":26044012,"end":26044012,"break":"none","ruby":[[0,1,"かれ"],[5,2,"ぐうぞう"],[8,1,"まえ"],[10,1,"たみ"],[12,1,"つか"],[21,1,"いえ"],[27,1,"つみ"],[40,1,"しゅ"],[43,1,"かみ"],[45,1,"い"],[54,1,"かれ"],[60,1,"ちか"],[64,1,"かれ"],[69,1,"つみ"],[71,1,"お"]],"text":"彼らはその偶像の前で民に仕え、イスラエルの家にとって、罪のつまずきとなったゆえ、主なる神は言われる、わたしは彼らについて誓った。彼らはその罪を負わなければならない。"},{"ref":"Ezek.44.13","start":26044013,"end":26044013,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ちか"],[11,2,"さいし"],[21,1,"つか"],[38,1,"せい"],[41,1,"もの"],[46,1,"もっと"],[48,1,"せい"],[51,1,"もの"],[54,1,"ちか"],[64,1,"かれ"],[74,1,"にく"],[84,1,"はじ"],[86,1,"お"]],"text":"彼らはわたしに近づき、祭司として、わたしに仕えることはできない。またわたしの聖なる物、および最も聖なる物に、近づいてはならない。彼らはそのおこなった憎むべきことのため、恥を負わなければならない。"},{"ref":"Ezek.44.14","start":26044014,"end":26044014,"break":"none","ruby":[[3,1,"かれ"],[8,1,"みや"],[10,1,"まも"],[12,1,"つとめ"],[24,1,"つとめ"],[27,1,"みや"],[37,1,"こと"],[40,1,"あた"]],"text":"しかし彼らには、宮を守る務をさせ、そのもろもろの務と、宮でなすべきすべての事とに当らせる。"},{"ref":"Ezek.44.15","start":26044015,"end":26044015,"break":"paragraph","ruby":[[7,2,"しそん"],[15,2,"さいし"],[30,2,"ひとびと"],[38,1,"す"],[41,1,"まよ"],[44,1,"とき"],[49,2,"せいじょ"],[52,1,"つとめ"],[54,1,"まも"],[57,1,"もの"],[66,1,"つか"],[72,1,"ちか"],[76,2,"しぼう"],[79,1,"ち"],[98,1,"まえ"],[100,1,"た"],[104,1,"しゅ"],[107,1,"かみ"],[109,1,"い"]],"text":"しかしザドクの子孫であるレビの祭司たち、すなわちイスラエルの人々が、わたしを捨てて迷った時に、わが聖所の務を守った者どもは、わたしに仕えるために近づき、脂肪と血とをわたしにささげるために、わたしの前に立てと、主なる神は言われる。"},{"ref":"Ezek.44.16","start":26044016,"end":26044016,"break":"none","ruby":[[4,1,"かれ"],[9,2,"せいじょ"],[12,1,"い"],[17,1,"だい"],[19,1,"ちか"],[27,1,"つか"],[34,1,"つとめ"],[36,1,"まも"]],"text":"すなわち彼らはわが聖所に入り、わが台に近づいてわたしに仕え、わたしの務を守る。"},{"ref":"Ezek.44.17","start":26044017,"end":26044017,"break":"none","ruby":[[0,1,"かれ"],[3,2,"うちにわ"],[6,1,"もん"],[11,1,"とき"],[14,1,"あさ"],[16,2,"いふく"],[19,1,"き"],[29,2,"うちにわ"],[32,1,"もん"],[36,1,"みや"],[38,1,"うち"],[41,1,"つとめ"],[45,1,"とき"],[48,3,"けおりもの"],[52,1,"み"]],"text":"彼らが内庭の門にはいる時は、麻の衣服を着なければならない。内庭の門および宮の内で、務をなす時は、毛織物を身につけてはならない。"},{"ref":"Ezek.44.18","start":26044018,"end":26044018,"break":"none","ruby":[[2,1,"あたま"],[5,2,"あま"],[7,1,"ぬの"],[9,1,"かんむり"],[14,1,"こし"],[17,2,"あま"],[19,1,"ぬの"],[21,1,"はかま"],[37,1,"あせ"],[39,1,"で"],[44,1,"ころも"],[46,1,"み"]],"text":"また頭には亜麻布の冠をつけ、腰には亜麻布の袴をつけなければならない。ただし汗の出るような衣を身につけてはならない。"},{"ref":"Ezek.44.19","start":26044019,"end":26044019,"break":"none","ruby":[[0,1,"かれ"],[3,1,"そと"],[4,1,"にわ"],[6,1,"で"],[8,1,"とき"],[14,1,"そと"],[15,1,"にわ"],[17,1,"で"],[19,1,"たみ"],[21,1,"せっ"],[24,1,"とき"],[27,1,"つとめ"],[31,1,"とき"],[33,2,"いふく"],[36,1,"ぬ"],[39,1,"せい"],[42,1,"しつ"],[44,1,"お"],[50,2,"いふく"],[53,1,"き"],[68,2,"いふく"],[77,1,"せい"],[83,1,"たみ"]],"text":"彼らは外庭に出る時、すなわち外庭に出て民に接する時は、務をなす時の衣服は脱いで聖なる室に置き、ほかの衣服を着なければならない。これはその衣服をもって、その聖なることを民にうつさないためである。"},{"ref":"Ezek.44.20","start":26044020,"end":26044020,"break":"none","ruby":[[0,1,"かれ"],[5,1,"あたま"],[18,1,"かみ"],[20,1,"なが"],[34,1,"あたま"],[36,1,"かみ"],[38,1,"き"]],"text":"彼らはまた頭をそってはならない。また髪を長くのばしてはならない。その頭の髪は切らなければならない。"},{"ref":"Ezek.44.21","start":26044021,"end":26044021,"break":"none","ruby":[[0,2,"さいし"],[6,2,"うちにわ"],[12,1,"とき"],[15,1,"さけ"],[17,1,"の"]],"text":"祭司はすべて内庭にはいる時は、酒を飲んではならない。"},{"ref":"Ezek.44.22","start":26044022,"end":26044022,"break":"none","ruby":[[2,2,"かふ"],[8,1,"だ"],[12,1,"おんな"],[32,1,"いえ"],[34,2,"けっとう"],[37,2,"しょじょ"],[44,2,"さいし"],[47,1,"つま"]],"text":"また寡婦、および出された女をめとってはならない。ただイスラエルの家の血統の処女、あるいは祭司の妻で、やもめになったものをめとらなければならない。"},{"ref":"Ezek.44.23","start":26044023,"end":26044023,"break":"none","ruby":[[0,1,"かれ"],[5,1,"たみ"],[8,1,"せい"],[10,1,"ぞく"],[13,2,"くべつ"],[16,1,"おし"],[19,1,"けが"],[26,1,"きよ"],[32,2,"くべつ"],[35,1,"しめ"]],"text":"彼らはわが民に、聖と俗との区別を教え、汚れたものと、清いものとの区別を示さなければならない。"},{"ref":"Ezek.44.24","start":26044024,"end":26044024,"break":"none","ruby":[[0,1,"あらそ"],[5,1,"とき"],[15,1,"た"],[45,1,"まつり"],[47,1,"とき"],[50,1,"かれ"],[55,2,"りっぽう"],[58,1,"さだ"],[61,1,"まも"],[66,3,"あんそくにち"],[71,2,"せいべつ"]],"text":"争いのある時は、さばきのために立ち、わがおきてにしたがってさばき、また、わたしのもろもろの祭の時は、彼らはわが律法と定めを守り、わが安息日を、聖別しなければならない。"},{"ref":"Ezek.44.25","start":26044025,"end":26044025,"break":"none","ruby":[[0,2,"しにん"],[3,1,"ちか"],[8,1,"み"],[10,1,"けが"],[21,1,"ちち"],[26,1,"はは"],[38,1,"むすめ"],[43,2,"きょうだい"],[49,1,"おっと"],[55,2,"しまい"],[63,1,"ちか"],[67,1,"み"],[69,1,"けが"],[74,1,"ゆる"]],"text":"死人に近づいて、身を汚してはならない。ただ父のため、母のため、むすこのため、娘のため、兄弟のため、夫をもたない姉妹のためには、近よって身を汚すことも許される。"},{"ref":"Ezek.44.26","start":26044026,"end":26044026,"break":"none","ruby":[[5,1,"ひと"],[8,1,"けが"],[11,1,"のち"],[13,2,"じしん"],[20,2,"なぬか"],[23,2,"きかん"],[26,1,"かぞ"],[35,1,"きよ"]],"text":"このような人は、汚れた後、自身のために、七日の期間を数えよ。そうすれば清まる。"},{"ref":"Ezek.44.27","start":26044027,"end":26044027,"break":"none","ruby":[[0,1,"かれ"],[2,2,"せいじょ"],[5,1,"い"],[8,2,"うちにわ"],[11,1,"い"],[14,2,"せいじょ"],[17,1,"つとめ"],[19,1,"あた"],[21,1,"ひ"],[25,2,"ざいさい"],[41,1,"しゅ"],[44,1,"かみ"],[46,1,"い"]],"text":"彼は聖所に入り、内庭に行き、聖所で務に当る日には、罪祭をささげなければならないと、主なる神は言われる。"},{"ref":"Ezek.44.28","start":26044028,"end":26044028,"break":"paragraph","ruby":[[0,1,"かれ"],[4,1,"し"],[5,1,"ぎょう"],[16,1,"し"],[17,1,"ぎょう"],[34,1,"なか"],[37,1,"かれ"],[40,2,"しょゆう"],[43,1,"あた"],[56,1,"かれ"],[59,2,"しょゆう"]],"text":"彼らには嗣業はない。わたしがその嗣業である。あなたがたはイスラエルの中で、彼らに所有を与えてはならない。わたしが彼らの所有である。"},{"ref":"Ezek.44.29","start":26044029,"end":26044029,"break":"none","ruby":[[0,1,"かれ"],[3,2,"そさい"],[6,2,"ざいさい"],[9,2,"けんさい"],[12,1,"もの"],[14,1,"た"],[36,1,"もの"],[38,1,"かれ"],[41,1,"もの"]],"text":"彼らは素祭、罪祭、愆祭の物を食べる。すべてイスラエルのうちのささげられた物は彼らの物となる。"},{"ref":"Ezek.44.30","start":26044030,"end":26044030,"break":"none","ruby":[[4,1,"もの"],[6,1,"はつ"],[10,2,"はつもの"],[37,1,"もの"],[42,2,"さいし"],[59,2,"むぎこ"],[62,2,"はつもの"],[65,2,"さいし"],[68,1,"あた"],[81,1,"いえ"],[84,2,"しゅくふく"]],"text":"すべての物の初なりの初物、およびすべてあなたがたのささげるもろもろのささげ物は、みな祭司のものとなる。またあなたがたの麦粉の初物は祭司に与えよ。これはあなたがたの家が、祝福されるためである。"},{"ref":"Ezek.44.31","start":26044031,"end":26044031,"break":"none","ruby":[[0,2,"さいし"],[4,1,"とり"],[7,1,"けもの"],[14,2,"しぜん"],[17,1,"し"],[26,1,"さ"],[28,1,"ころ"],[35,1,"た"]],"text":"祭司は、鳥でも獣でも、すべて自然に死んだもの、または裂き殺されたものを食べてはならない。"}]