[{"ref":"2Chr.28.1","start":14028001,"end":14028001,"break":"paragraph","ruby":[[4,1,"おう"],[9,1,"とき"],[12,1,"さい"],[17,1,"ねん"],[19,1,"あいだ"],[26,1,"よ"],[28,1,"おさ"],[35,1,"ちち"],[41,1,"ちが"],[45,1,"しゅ"],[47,1,"よ"],[50,1,"み"],[57,1,"おこな"]],"text":"アハズは王となった時二十歳で、十六年の間エルサレムで世を治めたが、その父ダビデとは違って、主の良しと見られることを行わず、"},{"ref":"2Chr.28.2","start":14028002,"end":14028002,"break":"none","ruby":[[6,1,"おう"],[10,1,"みち"],[12,1,"あゆ"],[29,1,"い"],[31,1,"ぞう"],[33,1,"つく"]],"text":"イスラエルの王たちの道に歩み、またもろもろのバアルのために鋳た像を造り、"},{"ref":"2Chr.28.3","start":14028003,"end":14028003,"break":"none","ruby":[[7,1,"たに"],[9,1,"こう"],[16,1,"こ"],[19,1,"ひ"],[21,1,"や"],[24,1,"そな"],[26,1,"もの"],[33,1,"しゅ"],[41,2,"ひとびと"],[44,1,"まえ"],[47,1,"お"],[49,1,"はら"],[53,3,"いほうじん"],[57,1,"にく"],[61,1,"おこな"]],"text":"ベンヒンノムの谷で香をたき、その子らを火に焼いて供え物とするなど、主がイスラエルの人々の前から追い払われた異邦人の憎むべき行いにならい、"},{"ref":"2Chr.28.4","start":14028004,"end":14028004,"break":"none","ruby":[[2,1,"たか"],[4,1,"ところ"],[6,1,"うえ"],[8,1,"おか"],[10,1,"うえ"],[16,1,"あお"],[17,1,"き"],[19,1,"した"],[21,2,"ぎせい"],[28,1,"こう"]],"text":"また高き所の上、丘の上、すべての青木の下で犠牲をささげ、香をたいた。"},{"ref":"2Chr.28.5","start":14028005,"end":14028005,"break":"paragraph","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[11,1,"かれ"],[17,1,"おう"],[19,1,"て"],[21,1,"わた"],[34,1,"かれ"],[36,1,"う"],[38,1,"やぶ"],[43,1,"たみ"],[45,1,"おお"],[47,2,"ほりょ"],[58,1,"ひ"],[61,1,"い"],[65,1,"かれ"],[75,1,"おう"],[77,1,"て"],[80,1,"わた"],[93,1,"おう"],[95,1,"かれ"],[97,1,"う"],[99,1,"やぶ"],[102,1,"おお"],[105,1,"ころ"]],"text":"それゆえ、その神、主は彼をスリヤの王の手に渡されたので、スリヤびとは彼を撃ち破り、その民を多く捕虜として、ダマスコに引いて行った。彼はまたイスラエルの王の手にも渡されたので、イスラエルの王も彼を撃ち破って大いに殺した。"},{"ref":"2Chr.28.6","start":14028006,"end":14028006,"break":"none","ruby":[[9,1,"こ"],[17,1,"にち"],[25,1,"にん"],[27,1,"ころ"],[31,1,"みな"],[32,2,"ゆうし"],[42,1,"かれ"],[47,2,"せんぞ"],[50,1,"かみ"],[52,1,"しゅ"],[54,1,"す"]],"text":"すなわちレマリヤの子ペカはユダで一日のうちに十二万人を殺した。皆勇士であった。これは彼らがその先祖の神、主を捨てたためである。"},{"ref":"2Chr.28.7","start":14028007,"end":14028007,"break":"none","ruby":[[2,1,"とき"],[10,2,"ゆうし"],[18,1,"もの"],[20,1,"おう"],[22,1,"こ"],[28,2,"くない"],[30,2,"だいじん"],[40,1,"おう"],[42,1,"つ"],[44,1,"ひと"],[50,1,"ころ"]],"text":"その時、エフライムの勇士ジクリという者が王の子マアセヤ、宮内大臣アズリカムおよび王に次ぐ人エルカナを殺した。"},{"ref":"2Chr.28.8","start":14028008,"end":14028008,"break":"paragraph","ruby":[[6,2,"ひとびと"],[14,2,"きょうだい"],[21,2,"ふじん"],[27,2,"だんし"],[30,2,"じょし"],[37,1,"にん"],[39,2,"ほりょ"],[46,1,"おお"],[53,1,"もの"],[64,1,"もの"],[71,1,"も"],[74,1,"い"]],"text":"イスラエルの人々はついにその兄弟のうちから婦人ならびに男子、女子など二十万人を捕虜にし、また多くのぶんどり物をとり、そのぶんどり物をサマリヤに持って行った。"},{"ref":"2Chr.28.9","start":14028009,"end":14028009,"break":"none","ruby":[[2,1,"とき"],[6,1,"な"],[14,1,"しゅ"],[16,3,"よげんしゃ"],[29,1,"かえ"],[32,1,"き"],[34,2,"ぐんぜい"],[37,1,"まえ"],[39,1,"すす"],[41,1,"で"],[43,1,"い"],[48,1,"み"],[57,2,"せんぞ"],[60,1,"かみ"],[62,1,"しゅ"],[67,1,"いか"],[80,1,"て"],[82,1,"わた"],[94,1,"てん"],[96,1,"たっ"],[102,1,"いか"],[111,1,"ころ"]],"text":"その時そこに名をオデデという主の預言者があって、サマリヤに帰って来た軍勢の前に進み出て言った、「見よ、あなたがたの先祖の神、主はユダを怒って、これをあなたがたの手に渡されたが、あなたがたは天に達するほどの怒りをもってこれを殺した。"},{"ref":"2Chr.28.10","start":14028010,"end":14028010,"break":"none","ruby":[[15,1,"いま"],[26,2,"ひとびと"],[29,1,"したが"],[34,2,"じぶん"],[37,2,"だんじょ"],[40,2,"どれい"],[47,1,"おも"],[61,2,"じしん"],[73,1,"かみ"],[75,1,"しゅ"],[77,1,"つみ"],[79,1,"おか"]],"text":"そればかりでなく、あなたがたは今、ユダとエルサレムの人々を従わせて、自分の男女の奴隷にしようと思っている。しかしあなたがた自身もまた、あなたがたの神、主に罪を犯しているではないか。"},{"ref":"2Chr.28.11","start":14028011,"end":14028011,"break":"none","ruby":[[6,1,"き"],[17,2,"きょうだい"],[24,1,"とら"],[27,1,"き"],[29,2,"ほりょ"],[32,1,"はな"],[34,1,"かえ"],[41,1,"しゅ"],[43,1,"はげ"],[46,1,"いか"],[55,1,"うえ"],[57,1,"のぞ"]],"text":"いまわたしに聞き、あなたがたがその兄弟のうちから捕えて来た捕虜を放ち帰らせなさい。主の激しい怒りがあなたがたの上に臨んでいるからです」。"},{"ref":"2Chr.28.12","start":14028012,"end":14028012,"break":"none","ruby":[[15,2,"ひとびと"],[27,1,"こ"],[39,1,"こ"],[50,1,"こ"],[61,1,"こ"],[70,2,"せんそう"],[74,1,"かえ"],[77,1,"もの"],[81,1,"む"],[85,1,"た"]],"text":"そこでエフライムびとのおもなる人々、すなわちヨハナンの子アザリヤ、メシレモテの子ベレキヤ、シャルムの子ヒゼキヤ、ハデライの子アマサらもまた、戦争から帰った者どもに向かって立ちあがり、"},{"ref":"2Chr.28.13","start":14028013,"end":14028013,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[8,2,"ほりょ"],[14,1,"ひ"],[16,1,"い"],[37,1,"しゅ"],[39,1,"たい"],[45,1,"え"],[58,1,"つみ"],[62,1,"ま"],[64,1,"くわ"],[82,1,"おお"],[86,1,"はげ"],[89,1,"いか"],[98,1,"うえ"],[100,1,"のぞ"]],"text":"彼らに言った、「捕虜をここに引き入れてはならない。あなたがたはわたしどもに主に対するとがを得させて、さらにわれわれの罪とがを増し加えようとしている。われわれのとがは大きく、激しい怒りがイスラエルの上に臨んでいるからです」。"},{"ref":"2Chr.28.14","start":14028014,"end":14028014,"break":"none","ruby":[[3,2,"へいそつ"],[10,2,"ほりょ"],[17,1,"もの"],[25,1,"ぜん"],[26,2,"かいしゅう"],[29,1,"まえ"],[31,1,"す"]],"text":"そこで兵卒どもがその捕虜とぶんどり物をつかさたちと全会衆の前に捨てておいたので、"},{"ref":"2Chr.28.15","start":14028015,"end":14028015,"break":"none","ruby":[[0,1,"まえ"],[2,1,"な"],[7,2,"ひとびと"],[10,1,"た"],[13,2,"ほりょ"],[16,1,"う"],[18,1,"と"],[25,1,"もの"],[31,2,"いふく"],[38,1,"はだか"],[40,1,"もの"],[42,1,"き"],[55,1,"く"],[57,1,"の"],[62,1,"あぶら"],[64,1,"そそ"],[72,1,"よわ"],[74,1,"もの"],[76,1,"みな"],[80,1,"の"],[87,1,"かれ"],[94,1,"まち"],[99,1,"つ"],[102,1,"い"],[108,2,"きょうだい"],[113,1,"わた"],[124,1,"かえ"],[127,1,"き"]],"text":"前に名をあげた人々が立って捕虜を受け取り、ぶんどり物のうちから衣服をとって、裸の者に着せ、また、くつをはかせ、食い飲みさせ、油を注ぎなどし、その弱い者を皆ろばに乗せ、こうして彼らをしゅろの町エリコに連れて行って、その兄弟たちに渡し、そしてサマリヤに帰って来た。"},{"ref":"2Chr.28.16","start":14028016,"end":14028016,"break":"paragraph","ruby":[[2,1,"とき"],[6,1,"おう"],[8,1,"ひと"],[16,1,"おう"],[23,1,"たす"],[26,1,"もと"]],"text":"その時アハズ王は人をアッスリヤの王につかわして助けを求めさせた。"},{"ref":"2Chr.28.17","start":14028017,"end":14028017,"break":"none","ruby":[[6,1,"ふたた"],[8,2,"しんにゅう"],[15,1,"う"],[18,1,"たみ"],[20,1,"とら"],[22,1,"さ"]],"text":"エドムびとが再び侵入してユダを撃ち、民を捕え去ったからである。"},{"ref":"2Chr.28.18","start":14028018,"end":14028018,"break":"none","ruby":[[9,2,"へいや"],[12,2,"まちまち"],[24,2,"まちまち"],[27,1,"おか"],[54,2,"むらざと"],[63,2,"むらざと"],[72,2,"むらざと"],[75,1,"と"],[82,1,"す"]],"text":"ペリシテびともまた平野の町々およびユダのネゲブの町々を侵して、ベテシメシ、アヤロン、ゲデロテおよびソコとその村里、テムナとその村里、ギムゾとその村里を取って、そこに住んだ。"},{"ref":"2Chr.28.19","start":14028019,"end":14028019,"break":"none","ruby":[[9,1,"おう"],[18,1,"しゅ"],[23,1,"ひく"],[34,1,"かれ"],[49,1,"おこな"],[52,1,"しゅ"],[54,1,"む"],[58,1,"おお"],[61,1,"つみ"],[63,1,"おか"]],"text":"これはイスラエルの王アハズのゆえに、主がユダを低くされたのであって、彼がユダのうちにみだらなことを行い、主に向かって大いに罪を犯したからである。"},{"ref":"2Chr.28.20","start":14028020,"end":14028020,"break":"none","ruby":[[6,1,"おう"],[18,1,"かれ"],[20,1,"ところ"],[22,1,"き"],[26,1,"かれ"],[28,1,"ちから"],[30,1,"そ"],[40,1,"かれ"],[42,1,"なや"]],"text":"アッスリヤの王テルガデ・ピルネセルは彼の所に来たが、彼に力を添えないで、かえって彼を悩ました。"},{"ref":"2Chr.28.21","start":14028021,"end":14028021,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"みや"],[8,1,"おう"],[10,1,"いえ"],[21,1,"いえ"],[23,1,"もの"],[25,1,"と"],[34,1,"おう"],[36,1,"あた"],[48,1,"たす"]],"text":"アハズは主の宮と王の家、およびつかさたちの家の物を取ってアッスリヤの王に与えたが、それはアハズの助けにはならなかった。"},{"ref":"2Chr.28.22","start":14028022,"end":14028022,"break":"paragraph","ruby":[[5,1,"おう"],[9,1,"なや"],[12,1,"とき"],[23,1,"しゅ"],[25,1,"つみ"],[27,1,"おか"]],"text":"このアハズ王はその悩みの時にあたって、ますます主に罪を犯した。"},{"ref":"2Chr.28.23","start":14028023,"end":14028023,"break":"none","ruby":[[5,1,"かれ"],[7,2,"じぶん"],[10,1,"う"],[18,2,"かみがみ"],[22,2,"ぎせい"],[29,1,"い"],[38,1,"おう"],[42,2,"かみがみ"],[47,1,"おう"],[51,1,"たす"],[64,2,"ぎせい"],[78,1,"かれ"],[85,1,"たす"],[99,1,"かれ"],[115,2,"ぜんこく"],[119,1,"たお"],[121,1,"もの"]],"text":"すなわち、彼は自分を撃ったダマスコの神々に、犠牲をささげて言った、「スリヤの王たちの神々はその王たちを助けるから、わたしもそれに犠牲をささげよう。そうすれば彼らはわたしを助けるであろう」と。しかし、彼らはかえってアハズとイスラエル全国とを倒す者となった。"},{"ref":"2Chr.28.24","start":14028024,"end":14028024,"break":"none","ruby":[[4,1,"かみ"],[6,1,"みや"],[8,2,"うつわもの"],[11,1,"あつ"],[15,1,"かみ"],[17,1,"みや"],[19,2,"うつわもの"],[22,1,"き"],[24,1,"やぶ"],[27,1,"しゅ"],[29,1,"みや"],[31,1,"と"],[33,1,"と"],[51,2,"さいだん"],[54,1,"つく"]],"text":"アハズは神の宮の器物を集めて、神の宮の器物を切り破り、主の宮の戸を閉じ、エルサレムのすべてのすみずみに祭壇を造り、"},{"ref":"2Chr.28.25","start":14028025,"end":14028025,"break":"none","ruby":[[7,2,"まちまち"],[10,1,"たか"],[12,1,"ところ"],[14,1,"つく"],[18,1,"た"],[20,2,"かみがみ"],[23,1,"こう"],[32,2,"せんぞ"],[35,1,"かみ"],[37,1,"しゅ"],[39,1,"いか"],[42,1,"ひ"],[44,1,"おこ"]],"text":"ユダのすべての町々に高き所を造って、他の神々に香をたきなどして、先祖の神、主の怒りを引き起した。"},{"ref":"2Chr.28.26","start":14028026,"end":14028026,"break":"none","ruby":[[6,1,"た"],[8,2,"しじゅう"],[11,2,"こうい"],[22,2,"こうどう"],[35,1,"れつ"],[36,1,"おう"],[38,1,"しょ"]],"text":"アハズのその他の始終の行為およびそのすべての行動は、ユダとイスラエルの列王の書にしるされている。"},{"ref":"2Chr.28.27","start":14028027,"end":14028027,"break":"none","ruby":[[6,2,"せんぞ"],[11,1,"とも"],[13,1,"ねむ"],[25,1,"まち"],[30,1,"ほうむ"],[44,1,"おう"],[48,1,"はか"],[51,1,"も"],[54,1,"い"],[63,1,"こ"],[69,1,"かれ"],[71,1,"かわ"],[74,1,"おう"]],"text":"アハズはその先祖たちと共に眠ったので、エルサレムの町にこれを葬った。しかし、イスラエルの王たちの墓には持って行かなかった。その子ヒゼキヤが彼に代って王となった。"}]