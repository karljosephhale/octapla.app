[{"ref":"Phil.3.1","start":50003001,"end":50003001,"break":"paragraph","ruby":[[0,2,"さいご"],[8,2,"きょうだい"],[14,1,"しゅ"],[19,1,"よろこ"],[28,1,"か"],[33,1,"おな"],[41,1,"く"],[43,1,"かえ"],[56,1,"わず"],[75,2,"あんぜん"]],"text":"最後に、わたしの兄弟たちよ。主にあって喜びなさい。さきに書いたのと同じことをここで繰り返すが、それは、わたしには煩らわしいことではなく、あなたがたには安全なことになる。"},{"ref":"Phil.3.2","start":50003002,"end":50003002,"break":"paragraph","ruby":[[2,1,"いぬ"],[6,2,"けいかい"],[13,1,"わる"],[15,1,"はたら"],[17,1,"びと"],[21,2,"けいかい"],[28,1,"にく"],[30,2,"かつれい"],[33,1,"きず"],[40,1,"ひと"],[44,2,"けいかい"]],"text":"あの犬どもを警戒しなさい。悪い働き人たちを警戒しなさい。肉に割礼の傷をつけている人たちを警戒しなさい。"},{"ref":"Phil.3.3","start":50003003,"end":50003003,"break":"none","ruby":[[0,1,"かみ"],[2,1,"れい"],[7,2,"れいはい"],[21,1,"ほこり"],[25,1,"にく"],[27,1,"たの"],[41,2,"かつれい"],[44,1,"もの"]],"text":"神の霊によって礼拝をし、キリスト・イエスを誇とし、肉を頼みとしないわたしたちこそ、割礼の者である。"},{"ref":"Phil.3.4","start":50003004,"end":50003004,"break":"none","ruby":[[5,1,"にく"],[7,1,"たの"],[17,1,"な"],[32,1,"ひと"],[34,1,"にく"],[36,1,"たの"],[44,1,"い"],[59,1,"たの"]],"text":"もとより、肉の頼みなら、わたしにも無くはない。もし、だれかほかの人が肉を頼みとしていると言うなら、わたしはそれをもっと頼みとしている。"},{"ref":"Phil.3.5","start":50003005,"end":50003005,"break":"none","ruby":[[5,2,"かめ"],[8,2,"かつれい"],[11,1,"う"],[14,1,"もの"],[22,2,"みんぞく"],[25,1,"ぞく"],[28,1,"もの"],[35,1,"ぞく"],[37,2,"しゅっしん"],[43,1,"びと"],[45,1,"なか"],[50,1,"びと"],[52,2,"りっぽう"],[55,1,"うえ"],[62,1,"びと"]],"text":"わたしは八日目に割礼を受けた者、イスラエルの民族に属する者、ベニヤミン族の出身、ヘブル人の中のヘブル人、律法の上ではパリサイ人、"},{"ref":"Phil.3.6","start":50003006,"end":50003006,"break":"none","ruby":[[0,2,"ねっしん"],[3,1,"てん"],[6,2,"きょうかい"],[9,3,"はくがいしゃ"],[13,2,"りっぽう"],[16,1,"ぎ"],[22,1,"お"],[24,1,"ど"],[28,1,"もの"]],"text":"熱心の点では教会の迫害者、律法の義については落ち度のない者である。"},{"ref":"Phil.3.7","start":50003007,"end":50003007,"break":"none","ruby":[[11,1,"えき"],[32,1,"そん"],[34,1,"おも"]],"text":"しかし、わたしにとって益であったこれらのものを、キリストのゆえに損と思うようになった。"},{"ref":"Phil.3.8","start":50003008,"end":50003008,"break":"none","ruby":[[5,1,"さら"],[7,1,"すす"],[15,1,"しゅ"],[25,1,"し"],[27,2,"ちしき"],[30,2,"ぜつだい"],[33,2,"かち"],[48,1,"そん"],[50,1,"おも"],[73,1,"うしな"],[88,1,"ど"],[93,1,"おも"],[112,1,"え"]],"text":"わたしは、更に進んで、わたしの主キリスト・イエスを知る知識の絶大な価値のゆえに、いっさいのものを損と思っている。キリストのゆえに、わたしはすべてを失ったが、それらのものを、ふん土のように思っている。それは、わたしがキリストを得るためであり、"},{"ref":"Phil.3.9","start":50003009,"end":50003009,"break":"none","ruby":[[0,2,"りっぽう"],[5,2,"じぶん"],[8,1,"ぎ"],[19,1,"しん"],[22,2,"しんこう"],[27,1,"ぎ"],[34,2,"しんこう"],[37,1,"もとづ"],[39,1,"かみ"],[43,1,"ぎ"],[45,1,"う"],[57,2,"じぶん"],[60,1,"み"]],"text":"律法による自分の義ではなく、キリストを信じる信仰による義、すなわち、信仰に基く神からの義を受けて、キリストのうちに自分を見いだすようになるためである。"},{"ref":"Phil.3.10","start":50003010,"end":50003010,"break":"none","ruby":[[12,2,"ふっかつ"],[15,1,"ちから"],[18,1,"し"],[23,2,"くなん"],[34,1,"し"]],"text":"すなわち、キリストとその復活の力とを知り、その苦難にあずかって、その死のさまとひとしくなり、"},{"ref":"Phil.3.11","start":50003011,"end":50003011,"break":"none","ruby":[[6,2,"しにん"],[14,2,"ふっかつ"],[17,1,"たっ"]],"text":"なんとかして死人のうちからの復活に達したいのである。"},{"ref":"Phil.3.12","start":50003012,"end":50003012,"break":"none","ruby":[[10,1,"え"],[18,2,"かんぜん"],[21,1,"もの"],[30,1,"い"],[40,1,"とら"],[47,1,"お"],[49,1,"もと"],[78,1,"とら"]],"text":"わたしがすでにそれを得たとか、すでに完全な者になっているとか言うのではなく、ただ捕えようとして追い求めているのである。そうするのは、キリスト・イエスによって捕えられているからである。"},{"ref":"Phil.3.13","start":50003013,"end":50003013,"break":"none","ruby":[[0,2,"きょうだい"],[13,1,"とら"],[18,1,"おも"],[29,2,"いちじ"],[32,1,"つと"],[43,1,"うしろ"],[48,1,"わす"],[51,1,"まえ"],[56,1,"む"],[64,1,"の"]],"text":"兄弟たちよ。わたしはすでに捕えたとは思っていない。ただこの一事を努めている。すなわち、後のものを忘れ、前のものに向かってからだを伸ばしつつ、"},{"ref":"Phil.3.14","start":50003014,"end":50003014,"break":"none","ruby":[[0,2,"もくひょう"],[3,1,"め"],[7,1,"はし"],[22,1,"うえ"],[24,1,"め"],[27,1,"くだ"],[30,1,"かみ"],[32,2,"しょうよ"],[35,1,"え"],[39,1,"つと"]],"text":"目標を目ざして走り、キリスト・イエスにおいて上に召して下さる神の賞与を得ようと努めているのである。"},{"ref":"Phil.3.15","start":50003015,"end":50003015,"break":"none","ruby":[[10,1,"なか"],[12,1,"まった"],[14,1,"ひと"],[24,1,"かんが"],[43,1,"ちが"],[46,1,"かんが"],[49,1,"も"],[57,1,"かみ"],[64,1,"しめ"],[67,1,"くだ"]],"text":"だから、わたしたちの中で全き人たちは、そのように考えるべきである。しかし、あなたがたが違った考えを持っているなら、神はそのことも示して下さるであろう。"},{"ref":"Phil.3.16","start":50003016,"end":50003016,"break":"none","ruby":[[10,1,"たっ"],[12,1,"え"],[18,1,"したが"],[21,1,"すす"]],"text":"ただ、わたしたちは、達し得たところに従って進むべきである。"},{"ref":"Phil.3.17","start":50003017,"end":50003017,"break":"paragraph","ruby":[[0,2,"きょうだい"],[17,1,"もの"],[35,2,"もはん"],[53,1,"ある"],[55,1,"ひと"],[60,1,"め"]],"text":"兄弟たちよ。どうか、わたしにならう者となってほしい。また、あなたがたの模範にされているわたしたちにならって歩く人たちに、目をとめなさい。"},{"ref":"Phil.3.18","start":50003018,"end":50003018,"break":"none","ruby":[[6,1,"い"],[16,3,"じゅうじか"],[20,2,"てきたい"],[24,1,"ある"],[29,1,"もの"],[31,1,"おお"],[44,1,"かれ"],[60,1,"はな"],[65,1,"いま"],[68,1,"なみだ"],[70,1,"なが"],[73,1,"かた"]],"text":"わたしがそう言うのは、キリストの十字架に敵対して歩いている者が多いからである。わたしは、彼らのことをしばしばあなたがたに話したが、今また涙を流して語る。"},{"ref":"Phil.3.19","start":50003019,"end":50003019,"break":"none","ruby":[[0,1,"かれ"],[3,2,"さいご"],[6,1,"ほろ"],[12,1,"かれ"],[15,1,"かみ"],[19,1,"はら"],[21,1,"かれ"],[24,2,"えいこう"],[29,1,"はじ"],[31,1,"かれ"],[34,1,"おも"],[37,2,"ちじょう"]],"text":"彼らの最後は滅びである。彼らの神はその腹、彼らの栄光はその恥、彼らの思いは地上のことである。"},{"ref":"Phil.3.20","start":50003020,"end":50003020,"break":"none","ruby":[[10,2,"こくせき"],[13,1,"てん"],[23,2,"すくいぬし"],[26,1,"しゅ"],[49,1,"ま"],[51,1,"のぞ"]],"text":"しかし、わたしたちの国籍は天にある。そこから、救主、主イエス・キリストのこられるのを、わたしたちは待ち望んでいる。"},{"ref":"Phil.3.21","start":50003021,"end":50003021,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ばんぶつ"],[7,2,"じしん"],[10,1,"したが"],[15,1,"ちから"],[17,1,"はたら"],[30,1,"いや"],[39,2,"じしん"],[42,2,"えいこう"],[49,1,"おな"],[55,1,"か"],[58,1,"くだ"]],"text":"彼は、万物をご自身に従わせうる力の働きによって、わたしたちの卑しいからだを、ご自身の栄光のからだと同じかたちに変えて下さるであろう。"}]