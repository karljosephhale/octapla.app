[{"ref":"Ezra.6.1","start":15006001,"end":15006001,"break":"paragraph","ruby":[[7,1,"おう"],[9,1,"めい"],[11,1,"くだ"],[24,3,"こもんじょ"],[34,2,"しょこ"],[37,1,"しら"]],"text":"そこでダリヨス王は命を下して、バビロンのうちで、古文書をおさめてある書庫を調べさせたところ、"},{"ref":"Ezra.6.2","start":15006002,"end":15006002,"break":"none","breaks":[[40,"paragraph"]],"ruby":[[3,1,"しゅう"],[5,1,"みやこ"],[16,2,"まきもの"],[19,1,"み"],[41,2,"きろく"]],"text":"メデヤ州の都エクバタナで、一つの巻物を見いだした。そのうちにこうしるされてある。「記録。"},{"ref":"Ezra.6.3","start":15006003,"end":15006003,"break":"none","ruby":[[3,1,"おう"],[5,2,"がんねん"],[11,1,"おう"],[13,1,"めい"],[15,1,"くだ"],[28,1,"かみ"],[30,1,"みや"],[37,2,"ぎせい"],[44,2,"はんさい"],[47,1,"そな"],[50,1,"ところ"],[52,1,"みや"],[54,1,"た"],[59,1,"みや"],[61,1,"たか"],[75,1,"はば"]],"text":"クロス王の元年にクロス王は命を下した、『エルサレムにある神の宮については、犠牲をささげ、燔祭を供える所の宮を建て、その宮の高さを六十キュビトにし、その幅を六十キュビトにせよ。"},{"ref":"Ezra.6.4","start":15006004,"end":15006004,"break":"none","ruby":[[0,1,"おお"],[4,1,"いし"],[6,1,"そう"],[9,1,"だん"],[13,1,"き"],[15,1,"そう"],[18,1,"だん"],[25,2,"ひよう"],[28,1,"おう"],[30,1,"いえ"],[33,1,"あた"]],"text":"大いなる石の層を三段にし、木の層を一段にせよ。その費用は王の家から与えられる。"},{"ref":"Ezra.6.5","start":15006005,"end":15006005,"break":"none","ruby":[[17,1,"みや"],[25,1,"うつ"],[28,1,"かみ"],[30,1,"みや"],[32,2,"きんぎん"],[35,2,"うつわもの"],[55,1,"みや"],[60,1,"ところ"],[62,1,"も"],[65,1,"い"],[71,1,"かみ"],[73,1,"みや"],[75,1,"おさ"]],"text":"またネブカデネザルが、エルサレムの宮からバビロンに移した神の宮の金銀の器物は、これをかえして、エルサレムにある宮のもとの所に持って行き、これを神の宮に納めよ』」。"},{"ref":"Ezra.6.6","start":15006006,"end":15006006,"break":"paragraph","ruby":[[4,1,"かわ"],[5,1,"む"],[9,1,"しゅう"],[11,2,"ちじ"],[31,2,"どうりょう"],[36,1,"かわ"],[37,1,"む"],[41,1,"しゅう"],[43,2,"ちじ"],[58,1,"とお"]],"text":"「それで川向こうの州の知事タテナイおよびセタル・ボズナイとその同僚である川向こうの州の知事たちよ、あなたがたはこれに遠ざかり、"},{"ref":"Ezra.6.7","start":15006007,"end":15006007,"break":"none","ruby":[[0,1,"かみ"],[4,1,"みや"],[6,2,"こうじ"],[9,1,"かれ"],[12,1,"まか"],[18,1,"ひと"],[20,2,"ちじ"],[26,1,"ひと"],[28,2,"ちょうろう"],[34,1,"かみ"],[38,1,"みや"],[43,1,"ところ"],[45,1,"た"]],"text":"神のこの宮の工事を彼らに任せ、ユダヤ人の知事とユダヤ人の長老たちに、神のこの宮をもとの所に建てさせよ。"},{"ref":"Ezra.6.8","start":15006008,"end":15006008,"break":"none","ruby":[[6,1,"めい"],[8,1,"くだ"],[11,1,"かみ"],[15,1,"みや"],[17,1,"た"],[40,1,"ひと"],[42,2,"ちょうろう"],[51,1,"こと"],[53,1,"しめ"],[56,1,"おう"],[58,2,"ざいさん"],[65,1,"かわ"],[66,1,"む"],[70,1,"しゅう"],[73,1,"おさ"],[80,1,"なか"],[86,2,"ひよう"],[98,2,"ひとびと"],[101,1,"あた"],[107,2,"こうじ"],[110,1,"とどこお"]],"text":"わたしはまた命を下し、神のこの宮を建てることについて、あなたがたがこれらのユダヤ人の長老たちになすべき事を示す。王の財産、すなわち川向こうの州から納めるみつぎの中から、その費用をじゅうぶんそれらの人々に与えて、その工事を滞らないようにせよ。"},{"ref":"Ezra.6.9","start":15006009,"end":15006009,"break":"none","ruby":[[4,2,"ひつよう"],[16,1,"てん"],[18,1,"かみ"],[24,2,"はんさい"],[27,1,"こ"],[28,1,"うし"],[30,2,"おひつじ"],[35,2,"こひつじ"],[41,1,"むぎ"],[43,1,"しお"],[45,1,"さけ"],[47,1,"あぶら"],[58,2,"さいし"],[63,1,"もと"],[72,2,"ひび"],[74,1,"おこた"],[78,1,"かれ"],[81,1,"あた"]],"text":"またその必要とするもの、すなわち天の神にささげる燔祭の子牛、雄羊および小羊ならびに麦、塩、酒、油などエルサレムにいる祭司たちの求めにしたがって、日々怠りなく彼らに与え、"},{"ref":"Ezra.6.10","start":15006010,"end":15006010,"break":"none","ruby":[[0,1,"かれ"],[8,2,"ぎせい"],[11,1,"てん"],[13,1,"かみ"],[21,1,"おう"],[23,2,"おうじ"],[28,2,"ちょうじゅ"],[31,1,"いの"]],"text":"彼らにこうばしい犠牲を天の神にささげさせ、王と王子たちの長寿を祈らせよ。"},{"ref":"Ezra.6.11","start":15006011,"end":15006011,"break":"none","ruby":[[6,1,"めい"],[8,1,"くだ"],[17,1,"めい"],[20,1,"ところ"],[22,1,"あらた"],[25,1,"もの"],[35,1,"いえ"],[37,1,"はり"],[39,1,"ぬ"],[41,1,"と"],[45,1,"かれ"],[49,1,"うえ"],[61,1,"いえ"],[72,2,"おぶつ"],[75,1,"やま"]],"text":"わたしはまた命を下す。だれでもこの命ずる所を改める者があるならば、その家の梁は抜き取られ、彼はその上にくぎづけにされ、その家はまた、これがために汚物の山とされるであろう。"},{"ref":"Ezra.6.12","start":15006012,"end":15006012,"break":"none","ruby":[[3,1,"あらた"],[10,1,"もの"],[24,1,"かみ"],[28,1,"みや"],[30,1,"ほろ"],[37,1,"て"],[39,1,"だ"],[41,1,"おう"],[46,1,"たみ"],[55,1,"な"],[63,1,"かみ"],[66,1,"ねが"],[73,1,"たお"],[88,1,"めい"],[90,1,"くだ"],[93,1,"こころ"],[99,1,"おこな"]],"text":"これを改めようとする者、あるいはエルサレムにある神のこの宮を滅ぼそうとして手を出す王あるいは民は、かしこにその名をとどめられる神よ、願わくはこれを倒されるように。われダリヨスは命を下す。心してこれを行え」。"},{"ref":"Ezra.6.13","start":15006013,"end":15006013,"break":"paragraph","ruby":[[4,1,"おう"],[8,1,"い"],[10,1,"おく"],[16,1,"かわ"],[17,1,"む"],[21,1,"しゅう"],[23,2,"ちじ"],[43,2,"どうりょう"],[48,1,"こころ"],[54,1,"おこな"]],"text":"ダリヨス王がこう言い送ったので、川向こうの州の知事タテナイおよびセタル・ボズナイとその同僚たちは心してこれを行った。"},{"ref":"Ezra.6.14","start":15006014,"end":15006014,"break":"none","ruby":[[6,1,"ひと"],[8,2,"ちょうろう"],[14,3,"よげんしゃ"],[26,1,"こ"],[32,2,"よげん"],[38,1,"た"],[46,1,"と"],[50,1,"かれ"],[59,1,"かみ"],[61,2,"めいれい"],[84,1,"おう"],[93,1,"めい"],[102,1,"た"],[104,1,"おわ"]],"text":"そしてユダヤ人の長老たちは、預言者ハガイおよびイドの子ゼカリヤの預言によって建て、これをなし遂げた。彼らはイスラエルの神の命令により、またクロス、ダリヨスおよびペルシャ王アルタシャスタの命によって、これを建て終った。"},{"ref":"Ezra.6.15","start":15006015,"end":15006015,"break":"none","ruby":[[2,1,"みや"],[8,1,"おう"],[10,2,"ちせい"],[14,1,"ねん"],[19,1,"つき"],[22,1,"か"],[24,2,"かんせい"]],"text":"この宮はダリヨス王の治世の六年アダルの月の三日に完成した。"},{"ref":"Ezra.6.16","start":15006016,"end":15006016,"break":"paragraph","ruby":[[9,2,"ひとびと"],[12,2,"さいし"],[26,1,"た"],[28,2,"ほしゅう"],[32,1,"かえ"],[35,2,"ひとびと"],[39,1,"よろこ"],[42,1,"かみ"],[46,1,"みや"],[48,2,"ほうけん"],[50,1,"しき"],[52,1,"おこな"]],"text":"そこでイスラエルの人々、祭司たち、レビびとおよびその他の捕囚から帰った人々は、喜んで神のこの宮の奉献式を行った。"},{"ref":"Ezra.6.17","start":15006017,"end":15006017,"break":"none","ruby":[[4,1,"かみ"],[8,1,"みや"],[10,2,"ほうけん"],[12,1,"しき"],[18,2,"おうし"],[22,1,"とう"],[24,2,"おひつじ"],[28,1,"とう"],[30,2,"こひつじ"],[34,1,"とう"],[48,2,"ぶぞく"],[51,1,"かず"],[59,1,"お"],[64,1,"とう"],[86,2,"ざいさい"]],"text":"すなわち神のこの宮の奉献式において、雄牛一百頭、雄羊二百頭、小羊四百頭をささげ、またイスラエルの部族の数にしたがって、雄やぎ十二頭をささげて、すべてのイスラエルびとのための罪祭とした。"},{"ref":"Ezra.6.18","start":15006018,"end":15006018,"break":"none","ruby":[[6,1,"しょ"],[18,2,"さいし"],[21,1,"くみ"],[22,1,"べつ"],[32,1,"はん"],[33,1,"べつ"],[38,1,"た"],[47,1,"かみ"],[49,1,"つか"]],"text":"またモーセの書にしるされてあるように祭司を組別により、レビびとを班別によって立て、エルサレムで神に仕えさせた。"},{"ref":"Ezra.6.19","start":15006019,"end":15006019,"break":"paragraph","ruby":[[4,2,"ほしゅう"],[8,1,"かえ"],[11,1,"き"],[13,2,"ひとびと"],[17,2,"しょうがつ"],[22,1,"か"],[24,2,"すぎこし"],[27,1,"まつり"],[29,1,"おこな"]],"text":"こうして捕囚から帰って来た人々は、正月の十四日に過越の祭を行った。"},{"ref":"Ezra.6.20","start":15006020,"end":15006020,"break":"none","ruby":[[4,2,"さいし"],[14,1,"とも"],[16,1,"み"],[18,1,"きよ"],[21,1,"みな"],[22,1,"きよ"],[30,2,"ほしゅう"],[34,1,"かえ"],[37,1,"き"],[39,2,"ひとびと"],[47,2,"きょうだい"],[52,2,"さいし"],[62,1,"かれ"],[64,2,"じしん"],[70,2,"すぎこし"],[73,2,"こひつじ"]],"text":"すなわち祭司、レビびとたちは共に身を清めて皆清くなり、すべて捕囚から帰って来た人々のため、その兄弟である祭司たちのため、また彼ら自身のために過越の小羊をほふった。"},{"ref":"Ezra.6.21","start":15006021,"end":15006021,"break":"none","ruby":[[3,2,"ほしゅう"],[7,1,"かえ"],[10,1,"き"],[18,2,"ひとびと"],[26,1,"ち"],[28,3,"いほうじん"],[32,1,"けが"],[35,1,"す"],[38,1,"かれ"],[41,1,"つら"],[51,1,"かみ"],[53,1,"しゅ"],[55,1,"はい"],[62,1,"もの"],[70,1,"た"]],"text":"そして捕囚から帰って来たイスラエルの人々、およびその地の異邦人の汚れを捨てて彼らに連なり、イスラエルの神、主を拝しようとする者はすべてこれを食べ、"},{"ref":"Ezra.6.22","start":15006022,"end":15006022,"break":"none","ruby":[[0,1,"よろこ"],[3,2,"なぬか"],[6,1,"あいだ"],[8,1,"たね"],[9,1,"い"],[15,1,"まつり"],[17,1,"おこな"],[24,1,"しゅ"],[26,1,"かれ"],[29,1,"よろこ"],[41,1,"おう"],[43,1,"こころ"],[45,1,"かれ"],[48,1,"む"],[53,1,"かれ"],[61,1,"かみ"],[66,1,"かみ"],[68,1,"みや"],[70,2,"こうじ"],[73,1,"たす"]],"text":"喜んで七日の間、種入れぬパンの祭を行った。これは主が彼らを喜ばせ、またアッスリヤの王の心を彼らに向かわせ、彼にイスラエルの神にいます神の宮の工事を助けさせられたからである。"}]