[{"ref":"Hos.5.1","start":28005001,"end":28005001,"break":"paragraph","breaks":[[12,"line"],[27,"line"],[38,"line"],[51,"line"],[67,"line"]],"ruby":[[0,2,"さいし"],[9,1,"き"],[18,1,"いえ"],[21,1,"こころ"],[27,1,"おう"],[29,1,"いえ"],[32,1,"みみ"],[34,1,"かたむ"],[48,1,"のぞ"],[64,1,"もう"],[71,1,"うえ"],[73,1,"あみ"],[75,1,"は"]],"text":"祭司たちよ、これを聞け、イスラエルの家よ、心をとめよ、王の家よ、耳を傾けよ、さばきはあなたがたに臨む。あなたがたはミヅパにわなを設け、タボルの上に網を張ったからだ。"},{"ref":"Hos.5.2","start":28005002,"end":28005002,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[8,1,"あな"],[10,1,"ふか"],[20,1,"かれ"],[28,1,"こ"]],"text":"彼らはシッテムの穴を深くしたが、わたしは彼らをことごとく懲らしめる。"},{"ref":"Hos.5.3","start":28005003,"end":28005003,"break":"stanza","breaks":[[16,"line"],[35,"line"],[53,"line"]],"ruby":[[10,1,"し"],[26,1,"かく"],[46,1,"いま"],[47,2,"いんこう"],[59,1,"けが"]],"text":"わたしはエフライムを知っている。イスラエルはわたしに隠れることがない。エフライムよ、あなたは今淫行をなし、イスラエルは汚された。"},{"ref":"Hos.5.4","start":28005004,"end":28005004,"break":"line","breaks":[[19,"line"],[37,"line"]],"ruby":[[0,1,"かれ"],[8,1,"かれ"],[11,1,"かみ"],[13,1,"かえ"],[22,2,"いんこう"],[25,1,"れい"],[27,1,"かれ"],[37,1,"しゅ"],[39,1,"し"]],"text":"彼らのおこないは彼らを神に帰らせない。それは淫行の霊が彼らのうちにあって、主を知ることができないからだ。"},{"ref":"Hos.5.5","start":28005005,"end":28005005,"break":"stanza","breaks":[[23,"line"],[42,"line"]],"ruby":[[6,1,"ほこり"],[10,1,"かお"],[12,1,"む"],[16,2,"しょうげん"],[31,2,"ふぎ"],[47,1,"かれ"],[50,1,"とも"]],"text":"イスラエルの誇はその顔に向かって証言している。エフライムはその不義によってつまずき、ユダもまた彼らと共につまずく。"},{"ref":"Hos.5.6","start":28005006,"end":28005006,"break":"line","breaks":[[20,"line"],[37,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ひつじ"],[5,1,"む"],[8,1,"うし"],[10,1,"む"],[13,1,"たずさ"],[16,1,"い"],[20,1,"しゅ"],[22,1,"もと"],[27,1,"しゅ"],[29,1,"あ"],[37,1,"しゅ"],[39,1,"かれ"],[43,1,"はな"],[45,1,"さ"]],"text":"彼らは羊の群れ、牛の群れを携えて行って、主を求めても、主に会うことはない。主は彼らから離れ去られた。"},{"ref":"Hos.5.7","start":28005007,"end":28005007,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[0,1,"かれ"],[3,1,"しゅ"],[9,2,"ていそう"],[12,1,"まも"],[19,1,"もの"],[21,1,"こ"],[23,1,"う"],[27,2,"しんげつ"],[30,1,"かれ"],[35,2,"たはた"],[38,1,"とも"],[40,1,"ほろ"]],"text":"彼らは主にむかって貞操を守らず、ほかの者の子を産んだ。新月は彼らをその田畑と共に滅ぼす。"},{"ref":"Hos.5.8","start":28005008,"end":28005008,"break":"stanza","breaks":[[10,"line"],[21,"line"],[34,"line"]],"ruby":[[4,2,"つのぶえ"],[7,1,"ふ"],[17,1,"な"],[27,1,"よ"],[31,1,"さけ"]],"text":"ギベアで角笛を吹き、ラマでラッパを鳴らし、ベテアベンで呼ばわり叫べ。ベニヤミンよ、おののけ。"},{"ref":"Hos.5.9","start":28005009,"end":28005009,"break":"line","breaks":[[18,"line"],[35,"line"]],"ruby":[[6,2,"けいばつ"],[9,1,"ひ"],[11,1,"あ"],[28,2,"ぶぞく"],[35,1,"かなら"],[37,1,"おこ"],[41,1,"こと"],[43,1,"し"]],"text":"エフライムは刑罰の日に荒れすたれる。わたしはイスラエルの部族のうちに、必ず起るべき事を知らせる。"},{"ref":"Hos.5.10","start":28005010,"end":28005010,"break":"line","breaks":[[20,"line"]],"ruby":[[3,1,"きみ"],[7,1,"さかい"],[9,1,"うつ"],[11,1,"もの"],[26,1,"いか"],[29,1,"みず"],[34,1,"かれ"],[37,1,"うえ"],[39,1,"そそ"]],"text":"ユダの君たちは境を移す者のようになった。わたしはわが怒りを水のように彼らの上に注ぐ。"},{"ref":"Hos.5.11","start":28005011,"end":28005011,"break":"line","breaks":[[11,"line"],[27,"line"]],"ruby":[[6,1,"あま"],[18,1,"したが"],[21,1,"あゆ"],[31,1,"う"],[42,1,"う"]],"text":"エフライムは甘んじて、むなしいものに従って歩んだゆえ、さばきを受けて、しえたげられ、打ちひしがれる。"},{"ref":"Hos.5.12","start":28005012,"end":28005012,"break":"line","breaks":[[24,"line"]],"ruby":[[27,1,"いえ"],[30,1,"くさ"]],"text":"それゆえ、わたしはエフライムには、しみのように、ユダの家には腐れのようになる。"},{"ref":"Hos.5.13","start":28005013,"end":28005013,"break":"stanza","breaks":[[14,"line"],[28,"line"],[43,"line"],[54,"line"],[76,"line"]],"ruby":[[10,1,"やまい"],[12,1,"み"],[21,1,"きず"],[23,1,"み"],[40,1,"い"],[43,2,"だいおう"],[46,1,"ひと"],[57,1,"かれ"],[85,1,"きず"]],"text":"エフライムはおのれの病を見、ユダはおのれの傷を見たとき、エフライムはアッスリヤに行き、大王に人をつかわした。しかし彼はあなたがたをいやすことができない。また、あなたがたの傷をなおすことができない。"},{"ref":"Hos.5.14","start":28005014,"end":28005014,"break":"line","breaks":[[24,"line"],[44,"line"],[63,"line"]],"ruby":[[10,1,"たい"],[27,1,"いえ"],[29,1,"たい"],[33,1,"わか"],[57,1,"さ"],[60,1,"さ"],[67,1,"い"],[74,1,"すく"],[76,1,"もの"]],"text":"わたしはエフライムに対しては、ししのようになり、ユダの家に対しては若きししのようになる。わたしは、わたしこそ、かき裂いて去り、かすめて行くが、だれも救う者はない。"},{"ref":"Hos.5.15","start":28005015,"end":28005015,"break":"stanza","breaks":[[15,"line"],[28,"line"],[41,"line"]],"ruby":[[4,1,"かれ"],[9,1,"つみ"],[11,1,"みと"],[17,1,"かお"],[22,1,"もと"],[32,1,"ところ"],[34,1,"かえ"],[41,1,"かれ"],[44,1,"なや"],[55,1,"たず"],[57,1,"もと"],[60,1,"い"]],"text":"わたしは彼らがその罪を認めて、わが顔をたずね求めるまで、わたしの所に帰っていよう。彼らは悩みによって、わたしを尋ね求めて言う、"}]