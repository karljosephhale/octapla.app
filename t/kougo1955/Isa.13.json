[{"ref":"Isa.13.1","start":23013001,"end":23013001,"break":"paragraph","ruby":[[4,1,"こ"],[9,1,"しめ"],[22,2,"たくせん"]],"text":"アモツの子イザヤに示されたバビロンについての託宣。"},{"ref":"Isa.13.2","start":23013002,"end":23013002,"break":"stanza","breaks":[[17,"line"],[28,"line"]],"ruby":[[6,1,"き"],[10,1,"やま"],[12,1,"はた"],[14,1,"た"],[17,1,"こえ"],[22,1,"かれ"],[25,1,"まね"],[28,1,"て"],[30,1,"ふ"],[33,1,"かれ"],[36,2,"きぞく"],[39,1,"もん"]],"text":"あなたがたは木のない山に旗を立て、声をあげて彼らを招き、手を振って彼らを貴族の門に、はいらせよ。"},{"ref":"Isa.13.3","start":23013003,"end":23013003,"break":"line","breaks":[[18,"line"],[29,"line"]],"ruby":[[6,1,"いか"],[13,1,"おこな"],[18,2,"せいべつ"],[22,1,"もの"],[26,1,"めい"],[31,2,"ゆうし"],[36,1,"か"],[38,1,"ほこ"],[40,1,"もの"],[44,1,"まね"]],"text":"わたしはわが怒りのさばきを行うために聖別した者どもに命じ、わが勇士、わが勝ち誇る者どもを招いた。"},{"ref":"Isa.13.4","start":23013004,"end":23013004,"break":"paragraph","breaks":[[22,"line"],[39,"line"],[57,"line"],[65,"line"]],"ruby":[[0,1,"き"],[3,1,"おお"],[6,1,"たみ"],[11,1,"さわ"],[13,1,"こえ"],[15,2,"やまやま"],[18,1,"きこ"],[22,1,"き"],[30,2,"くにぐに"],[33,1,"よ"],[44,2,"こくみん"],[51,1,"こえ"],[53,1,"きこ"],[60,2,"ばんぐん"],[63,1,"しゅ"],[65,1,"たたか"],[71,2,"ぐんぜい"],[74,1,"あつ"]],"text":"聞け、多くの民のような騒ぎ声が山々に聞える。聞け、もろもろの国々、寄りつどえるもろもろの国民のざわめく声が聞える。これは万軍の主が戦いのために軍勢を集められるのだ。"},{"ref":"Isa.13.5","start":23013005,"end":23013005,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[0,1,"かれ"],[3,1,"とお"],[5,1,"くに"],[9,1,"てん"],[11,1,"はて"],[14,1,"く"],[21,1,"しゅ"],[25,1,"いきどお"],[28,1,"うつわ"],[31,1,"ぜん"],[32,1,"ち"],[34,1,"ほろ"],[40,1,"く"]],"text":"彼らは遠い国から、天の果から来る。これは、主とその憤りの器で、全地を滅ぼすために来るのだ。"},{"ref":"Isa.13.6","start":23013006,"end":23013006,"break":"paragraph","breaks":[[19,"line"]],"ruby":[[6,1,"な"],[8,1,"さけ"],[11,1,"しゅ"],[13,1,"ひ"],[15,1,"ちか"],[19,1,"ほろ"],[22,3,"ぜんのうしゃ"],[27,1,"く"]],"text":"あなたがたは泣き叫べ。主の日が近づき、滅びが全能者から来るからだ。"},{"ref":"Isa.13.7","start":23013007,"end":23013007,"break":"line","breaks":[[14,"line"]],"ruby":[[9,1,"て"],[11,1,"よわ"],[18,1,"ひと"],[20,1,"こころ"],[22,1,"と"],[24,1,"さ"]],"text":"それゆえ、すべての手は弱り、すべての人の心は溶け去る。"},{"ref":"Isa.13.8","start":23013008,"end":23013008,"break":"line","breaks":[[22,"line"],[42,"line"],[54,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おそ"],[10,1,"くる"],[14,1,"なや"],[17,1,"とら"],[22,1,"こ"],[24,1,"う"],[30,1,"おんな"],[38,1,"くる"],[42,1,"たがい"],[44,1,"おどろ"],[47,1,"かお"],[49,1,"み"],[56,1,"かお"],[58,1,"ほのお"]],"text":"彼らは恐れおののき、苦しみと悩みに捕えられ、子を産まんとする女のようにもだえ苦しみ、互に驚き、顔を見あわせ、その顔は炎のようになる。"},{"ref":"Isa.13.9","start":23013009,"end":23013009,"break":"paragraph","breaks":[[10,"line"],[34,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,1,"ひ"],[7,1,"く"],[10,2,"ざんにん"],[14,1,"いきどお"],[17,1,"はげ"],[20,1,"いか"],[29,1,"ち"],[31,1,"あら"],[36,1,"なか"],[39,1,"つみ"],[43,1,"た"],[45,1,"ほろ"],[51,1,"く"]],"text":"見よ、主の日が来る。残忍で、憤りと激しい怒りとをもってこの地を荒し、その中から罪びとを断ち滅ぼすために来る。"},{"ref":"Isa.13.10","start":23013010,"end":23013010,"break":"line","breaks":[[18,"line"],[27,"line"]],"ruby":[[0,1,"てん"],[2,1,"ほし"],[6,2,"せいざ"],[12,1,"ひかり"],[14,1,"はな"],[18,2,"たいよう"],[21,1,"で"],[24,1,"くら"],[27,1,"つき"],[31,1,"ひかり"],[33,1,"かがや"]],"text":"天の星とその星座とはその光を放たず、太陽は出ても暗く、月はその光を輝かさない。"},{"ref":"Isa.13.11","start":23013011,"end":23013011,"break":"line","breaks":[[16,"line"],[31,"line"],[42,"line"]],"ruby":[[6,1,"あく"],[11,1,"よ"],[13,1,"ばっ"],[18,2,"ふぎ"],[24,1,"わる"],[26,1,"もの"],[28,1,"ばっ"],[31,1,"たか"],[34,1,"もの"],[36,1,"ほこり"],[46,1,"もの"],[48,2,"こうまん"],[51,1,"ひく"]],"text":"わたしはその悪のために世を罰し、その不義のために悪い者を罰し、高ぶる者の誇をとどめ、あらぶる者の高慢を低くする。"},{"ref":"Isa.13.12","start":23013012,"end":23013012,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"ひと"],[6,1,"せい"],[7,1,"きん"],[22,1,"すく"]],"text":"わたしは人を精金よりも、オフルのこがねよりも少なくする。"},{"ref":"Isa.13.13","start":23013013,"end":23013013,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[5,2,"ばんぐん"],[8,1,"しゅ"],[10,1,"いきどお"],[18,1,"はげ"],[21,1,"いか"],[24,1,"ひ"],[27,1,"てん"],[29,1,"ふる"],[32,1,"ち"],[34,1,"ゆ"],[36,1,"うご"],[42,1,"ところ"]],"text":"それゆえ、万軍の主の憤りにより、その激しい怒りの日に、天は震い、地は揺り動いて、その所をはなれる。"},{"ref":"Isa.13.14","start":23013014,"end":23013014,"break":"line","breaks":[[17,"line"],[37,"line"],[49,"line"]],"ruby":[[0,1,"かれ"],[3,1,"お"],[21,1,"あつ"],[24,1,"もの"],[28,1,"ひつじ"],[41,2,"じぶん"],[44,1,"たみ"],[46,1,"かえ"],[49,2,"じぶん"],[52,1,"くに"],[54,1,"に"],[57,1,"い"]],"text":"彼らは追われた、かもしかのように、あるいは集める者のない羊のようになって、おのおの自分の民に帰り、自分の国に逃げて行く。"},{"ref":"Isa.13.15","start":23013015,"end":23013015,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"み"],[9,1,"もの"],[11,1,"さ"],[18,1,"とら"],[23,1,"もの"],[32,1,"たお"]],"text":"すべて見いだされる者は刺され、すべて捕えられる者はつるぎによって倒され、"},{"ref":"Isa.13.16","start":23013016,"end":23013016,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[10,1,"め"],[12,1,"まえ"],[14,1,"な"],[16,1,"くだ"],[22,1,"いえ"],[27,1,"うば"],[33,1,"つま"],[35,1,"けが"]],"text":"彼らのみどりごはその目の前で投げ砕かれ、その家はかすめ奪われ、その妻は汚される。"},{"ref":"Isa.13.17","start":23013017,"end":23013017,"break":"paragraph","breaks":[[18,"line"],[37,"line"]],"ruby":[[0,1,"み"],[14,1,"かえり"],[23,1,"よろこ"],[33,1,"おこ"],[37,1,"かれ"]],"text":"見よ、わたしは、しろがねをも顧みず、こがねをも喜ばないメデアびとを起して、彼らにむかわせる。"},{"ref":"Isa.13.18","start":23013018,"end":23013018,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ゆみ"],[5,1,"わか"],[7,1,"もの"],[9,2,"いころ"],[13,1,"はら"],[15,1,"み"],[26,1,"おさ"],[28,1,"ご"],[30,1,"み"],[33,1,"お"]],"text":"彼らの弓は若い者を射殺し、腹の実をあわれむことなく、幼な子を見て、惜しむことがない。"},{"ref":"Isa.13.19","start":23013019,"end":23013019,"break":"line","breaks":[[8,"line"],[28,"line"]],"ruby":[[0,2,"くにぐに"],[3,1,"ほまれ"],[15,1,"ほこり"],[19,1,"うるわ"],[28,1,"かみ"],[30,1,"ほろ"]],"text":"国々の誉であり、カルデヤびとの誇である麗しいバビロンは、神に滅ぼされたソドム、ゴモラのようになる。"},{"ref":"Isa.13.20","start":23013020,"end":23013020,"break":"line","breaks":[[14,"line"],[31,"line"],[48,"line"]],"ruby":[[7,1,"す"],[9,1,"もの"],[11,1,"た"],[14,2,"よよ"],[22,1,"す"],[26,1,"もの"],[41,2,"てんまく"],[44,1,"は"],[48,2,"ひつじかい"],[54,1,"む"],[57,1,"ふ"]],"text":"ここにはながく住む者が絶え、世々にいたるまで住みつく者がなく、アラビヤびともそこに天幕を張らず、羊飼もそこに群れを伏させることがない。"},{"ref":"Isa.13.21","start":23013021,"end":23013021,"break":"line","breaks":[[13,"line"],[25,"line"],[36,"line"]],"ruby":[[3,1,"の"],[5,1,"けもの"],[10,1,"ふ"],[16,1,"けもの"],[20,1,"いえ"],[22,1,"み"],[33,1,"す"],[36,2,"きしん"],[42,1,"おど"]],"text":"ただ、野の獣がそこに伏し、ほえる獣がその家に満ち、だちょうがそこに住み、鬼神がそこに踊る。"},{"ref":"Isa.13.22","start":23013022,"end":23013022,"break":"line","breaks":[[14,"line"],[27,"line"],[38,"line"]],"ruby":[[7,1,"しろ"],[9,1,"なか"],[11,1,"な"],[14,2,"やまいぬ"],[17,1,"たの"],[20,2,"きゅうでん"],[29,1,"とき"],[31,1,"く"],[35,1,"ちか"],[40,1,"ひ"],[42,1,"の"]],"text":"ハイエナはその城の中で鳴き、山犬は楽しい宮殿でほえる。その時の来るのは近い、その日は延びることがない。"}]