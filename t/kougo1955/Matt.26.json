[{"ref":"Matt.26.1","start":40026001,"end":40026001,"break":"paragraph","ruby":[[8,2,"ことば"],[14,1,"かた"],[16,1,"お"],[22,2,"でし"],[27,1,"い"]],"text":"イエスはこれらの言葉をすべて語り終えてから、弟子たちに言われた。"},{"ref":"Matt.26.2","start":40026002,"end":40026002,"break":"none","ruby":[[7,1,"し"],[20,1,"のち"],[23,2,"すぎこし"],[26,1,"まつり"],[32,1,"ひと"],[34,1,"こ"],[36,3,"じゅうじか"],[48,1,"ひ"],[50,1,"わた"]],"text":"「あなたがたが知っているとおり、ふつかの後には過越の祭になるが、人の子は十字架につけられるために引き渡される」。"},{"ref":"Matt.26.3","start":40026003,"end":40026003,"break":"none","ruby":[[5,3,"さいしちょう"],[11,1,"たみ"],[13,2,"ちょうろう"],[25,3,"だいさいし"],[29,2,"なかにわ"],[32,1,"あつ"]],"text":"そのとき、祭司長たちや民の長老たちが、カヤパという大祭司の中庭に集まり、"},{"ref":"Matt.26.4","start":40026004,"end":40026004,"break":"none","ruby":[[0,2,"さくりゃく"],[10,1,"とら"],[13,1,"ころ"],[17,2,"そうだん"]],"text":"策略をもってイエスを捕えて殺そうと相談した。"},{"ref":"Matt.26.5","start":40026005,"end":40026005,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[11,1,"まつり"],[13,1,"あいだ"],[20,2,"みんしゅう"],[23,1,"なか"],[25,1,"さわ"],[28,1,"おこ"],[32,1,"し"]],"text":"しかし彼らは言った、「祭の間はいけない。民衆の中に騒ぎが起るかも知れない」。"},{"ref":"Matt.26.6","start":40026006,"end":40026006,"break":"paragraph","ruby":[[15,2,"びょうにん"],[21,1,"いえ"]],"text":"さて、イエスがベタニヤで、らい病人シモンの家におられたとき、"},{"ref":"Matt.26.7","start":40026007,"end":40026007,"break":"none","ruby":[[4,1,"おんな"],[7,2,"こうか"],[10,2,"こうゆ"],[13,1,"い"],[18,2,"せっこう"],[24,1,"も"],[34,2,"ちかよ"],[38,2,"しょくじ"],[41,1,"せき"],[54,1,"あたま"],[56,2,"こうゆ"],[59,1,"そそ"]],"text":"ひとりの女が、高価な香油が入れてある石膏のつぼを持ってきて、イエスに近寄り、食事の席についておられたイエスの頭に香油を注ぎかけた。"},{"ref":"Matt.26.8","start":40026008,"end":40026008,"break":"none","ruby":[[4,2,"でし"],[12,1,"み"],[14,1,"いきどお"],[17,1,"い"],[33,1,"づかい"]],"text":"すると、弟子たちはこれを見て憤って言った、「なんのためにこんなむだ使をするのか。"},{"ref":"Matt.26.9","start":40026009,"end":40026009,"break":"none","ruby":[[3,1,"たか"],[5,1,"う"],[9,1,"まず"],[12,1,"ひと"],[16,1,"ほどこ"]],"text":"それを高く売って、貧しい人たちに施すことができたのに」。"},{"ref":"Matt.26.10","start":40026010,"end":40026010,"break":"none","ruby":[[7,1,"き"],[10,1,"かれ"],[13,1,"い"],[22,1,"おんな"],[24,1,"こま"],[37,1,"こと"]],"text":"イエスはそれを聞いて彼らに言われた、「なぜ、女を困らせるのか。わたしによい事をしてくれたのだ。"},{"ref":"Matt.26.11","start":40026011,"end":40026011,"break":"none","ruby":[[0,1,"まず"],[3,1,"ひと"],[16,2,"いっしょ"],[30,2,"いっしょ"]],"text":"貧しい人たちはいつもあなたがたと一緒にいるが、わたしはいつも一緒にいるわけではない。"},{"ref":"Matt.26.12","start":40026012,"end":40026012,"break":"none","ruby":[[2,1,"おんな"],[14,2,"こうゆ"],[17,1,"そそ"],[27,1,"ほうむ"],[30,2,"ようい"]],"text":"この女がわたしのからだにこの香油を注いだのは、わたしの葬りの用意をするためである。"},{"ref":"Matt.26.13","start":40026013,"end":40026013,"break":"none","ruby":[[2,1,"き"],[8,1,"ぜん"],[9,2,"せかい"],[20,2,"ふくいん"],[23,1,"の"],[25,1,"つた"],[30,1,"ところ"],[36,1,"おんな"],[40,1,"こと"],[42,2,"きねん"],[47,1,"かた"]],"text":"よく聞きなさい。全世界のどこででも、この福音が宣べ伝えられる所では、この女のした事も記念として語られるであろう」。"},{"ref":"Matt.26.14","start":40026014,"end":40026014,"break":"paragraph","ruby":[[0,1,"とき"],[5,2,"でし"],[23,1,"もの"],[26,3,"さいしちょう"],[36,1,"い"]],"text":"時に、十二弟子のひとりイスカリオテのユダという者が、祭司長たちのところに行って"},{"ref":"Matt.26.15","start":40026015,"end":40026015,"break":"none","ruby":[[0,1,"い"],[5,1,"かれ"],[13,1,"ひ"],[15,1,"わた"],[35,1,"かれ"],[38,2,"ぎんか"],[42,1,"まい"],[44,1,"かれ"],[46,2,"しはら"]],"text":"言った、「彼をあなたがたに引き渡せば、いくらくださいますか」。すると、彼らは銀貨三十枚を彼に支払った。"},{"ref":"Matt.26.16","start":40026016,"end":40026016,"break":"none","ruby":[[2,1,"とき"],[13,1,"ひ"],[21,2,"きかい"]],"text":"その時から、ユダはイエスを引きわたそうと、機会をねらっていた。"},{"ref":"Matt.26.17","start":40026017,"end":40026017,"break":"paragraph","ruby":[[3,3,"じょこうさい"],[7,1,"だい"],[9,1,"にち"],[12,2,"でし"],[26,1,"い"],[31,2,"すぎこし"],[34,2,"しょくじ"],[53,2,"ようい"]],"text":"さて、除酵祭の第一日に、弟子たちはイエスのもとにきて言った、「過越の食事をなさるために、わたしたちはどこに用意をしたらよいでしょうか」。"},{"ref":"Matt.26.18","start":40026018,"end":40026018,"break":"none","ruby":[[4,1,"い"],[10,2,"しない"],[20,1,"はな"],[25,1,"ひと"],[27,1,"ところ"],[29,1,"い"],[32,1,"い"],[39,2,"せんせい"],[47,1,"とき"],[49,1,"ちか"],[58,1,"いえ"],[60,2,"でし"],[65,2,"いっしょ"],[68,2,"すぎこし"],[71,1,"まも"],[76,1,"い"]],"text":"イエスは言われた、「市内にはいり、かねて話してある人の所に行って言いなさい、『先生が、わたしの時が近づいた、あなたの家で弟子たちと一緒に過越を守ろうと、言っておられます』」。"},{"ref":"Matt.26.19","start":40026019,"end":40026019,"break":"none","ruby":[[0,2,"でし"],[9,1,"めい"],[21,2,"すぎこし"],[24,2,"ようい"]],"text":"弟子たちはイエスが命じられたとおりにして、過越の用意をした。"},{"ref":"Matt.26.20","start":40026020,"end":40026020,"break":"paragraph","ruby":[[0,2,"ゆうがた"],[13,2,"でし"],[16,2,"いっしょ"],[19,2,"しょくじ"],[22,1,"せき"]],"text":"夕方になって、イエスは十二弟子と一緒に食事の席につかれた。"},{"ref":"Matt.26.21","start":40026021,"end":40026021,"break":"none","ruby":[[4,2,"いちどう"],[7,2,"しょくじ"],[16,1,"い"],[22,1,"とく"],[30,1,"い"],[55,2,"うらぎ"]],"text":"そして、一同が食事をしているとき言われた、「特にあなたがたに言っておくが、あなたがたのうちのひとりが、わたしを裏切ろうとしている」。"},{"ref":"Matt.26.22","start":40026022,"end":40026022,"break":"none","ruby":[[0,2,"でし"],[5,2,"ひじょう"],[8,2,"しんぱい"],[19,1,"しゅ"],[39,1,"い"],[41,1,"だ"]],"text":"弟子たちは非常に心配して、つぎつぎに「主よ、まさか、わたしではないでしょう」と言い出した。"},{"ref":"Matt.26.23","start":40026023,"end":40026023,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[17,2,"いっしょ"],[20,1,"おな"],[22,1,"はち"],[24,1,"て"],[26,1,"い"],[31,1,"もの"],[38,2,"うらぎ"]],"text":"イエスは答えて言われた、「わたしと一緒に同じ鉢に手を入れている者が、わたしを裏切ろうとしている。"},{"ref":"Matt.26.24","start":40026024,"end":40026024,"break":"none","ruby":[[4,1,"ひと"],[6,1,"こ"],[9,2,"じぶん"],[15,1,"か"],[24,1,"さ"],[27,1,"い"],[34,1,"ひと"],[36,1,"こ"],[38,2,"うらぎ"],[43,1,"ひと"],[56,1,"ひと"],[58,1,"うま"],[64,1,"ほう"],[67,1,"かれ"]],"text":"たしかに人の子は、自分について書いてあるとおりに去って行く。しかし、人の子を裏切るその人は、わざわいである。その人は生れなかった方が、彼のためによかったであろう」。"},{"ref":"Matt.26.25","start":40026025,"end":40026025,"break":"none","ruby":[[4,2,"うらぎ"],[11,1,"こた"],[14,1,"い"],[19,2,"せんせい"],[43,1,"い"]],"text":"イエスを裏切ったユダが答えて言った、「先生、まさか、わたしではないでしょう」。イエスは言われた、「いや、あなただ」。"},{"ref":"Matt.26.26","start":40026026,"end":40026026,"break":"paragraph","ruby":[[0,2,"いちどう"],[3,2,"しょくじ"],[20,1,"と"],[23,2,"しゅくふく"],[33,2,"でし"],[38,1,"あた"],[41,1,"い"],[47,1,"と"],[50,1,"た"]],"text":"一同が食事をしているとき、イエスはパンを取り、祝福してこれをさき、弟子たちに与えて言われた、「取って食べよ、これはわたしのからだである」。"},{"ref":"Matt.26.27","start":40026027,"end":40026027,"break":"none","ruby":[[2,1,"さかずき"],[4,1,"と"],[7,2,"かんしゃ"],[11,1,"かれ"],[14,1,"あた"],[17,1,"い"],[28,1,"さかずき"],[31,1,"の"]],"text":"また杯を取り、感謝して彼らに与えて言われた、「みな、この杯から飲め。"},{"ref":"Matt.26.28","start":40026028,"end":40026028,"break":"none","ruby":[[4,1,"つみ"],[10,1,"え"],[19,1,"おお"],[22,1,"ひと"],[27,1,"なが"],[33,2,"けいやく"],[36,1,"ち"]],"text":"これは、罪のゆるしを得させるようにと、多くの人のために流すわたしの契約の血である。"},{"ref":"Matt.26.29","start":40026029,"end":40026029,"break":"none","ruby":[[6,1,"い"],[16,1,"ちち"],[18,1,"くに"],[26,1,"とも"],[29,1,"あたら"],[32,1,"の"],[36,1,"ひ"],[45,2,"こんご"],[47,1,"けっ"],[55,1,"み"],[58,1,"つく"],[64,1,"の"]],"text":"あなたがたに言っておく。わたしの父の国であなたがたと共に、新しく飲むその日までは、わたしは今後決して、ぶどうの実から造ったものを飲むことをしない」。"},{"ref":"Matt.26.30","start":40026030,"end":40026030,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"うた"],[11,1,"のち"],[16,1,"やま"],[18,1,"で"],[22,1,"い"]],"text":"彼らは、さんびを歌った後、オリブ山へ出かけて行った。"},{"ref":"Matt.26.31","start":40026031,"end":40026031,"break":"paragraph","ruby":[[9,2,"でし"],[14,1,"い"],[20,2,"こんや"],[29,1,"みな"],[48,2,"ひつじかい"],[51,1,"う"],[58,1,"ひつじ"],[60,1,"む"],[63,1,"ち"],[75,1,"か"]],"text":"そのとき、イエスは弟子たちに言われた、「今夜、あなたがたは皆わたしにつまずくであろう。『わたしは羊飼を打つ。そして、羊の群れは散らされるであろう』と、書いてあるからである。"},{"ref":"Matt.26.32","start":40026032,"end":40026032,"break":"none","ruby":[[24,1,"さき"],[31,1,"い"]],"text":"しかしわたしは、よみがえってから、あなたがたより先にガリラヤへ行くであろう」。"},{"ref":"Matt.26.33","start":40026033,"end":40026033,"break":"none","ruby":[[11,1,"こた"],[14,1,"い"],[27,1,"もの"],[44,1,"けっ"]],"text":"するとペテロはイエスに答えて言った、「たとい、みんなの者があなたにつまずいても、わたしは決してつまずきません」。"},{"ref":"Matt.26.34","start":40026034,"end":40026034,"break":"none","ruby":[[4,1,"い"],[16,1,"い"],[22,2,"こんや"],[25,1,"にわとり"],[27,1,"な"],[29,1,"まえ"],[37,1,"ど"],[42,1,"し"],[47,1,"い"]],"text":"イエスは言われた、「よくあなたに言っておく。今夜、鶏が鳴く前に、あなたは三度わたしを知らないと言うだろう」。"},{"ref":"Matt.26.35","start":40026035,"end":40026035,"break":"none","ruby":[[4,1,"い"],[16,2,"いっしょ"],[19,1,"し"],[36,1,"し"],[45,1,"けっ"],[48,1,"もう"],[55,2,"でし"],[62,1,"おな"],[67,1,"い"]],"text":"ペテロは言った、「たといあなたと一緒に死なねばならなくなっても、あなたを知らないなどとは、決して申しません」。弟子たちもみな同じように言った。"},{"ref":"Matt.26.36","start":40026036,"end":40026036,"break":"paragraph","ruby":[[9,1,"かれ"],[12,2,"いっしょ"],[24,1,"ところ"],[26,1,"い"],[34,2,"でし"],[39,1,"い"],[49,1,"む"],[53,1,"い"],[56,1,"いの"],[61,1,"あいだ"]],"text":"それから、イエスは彼らと一緒に、ゲツセマネという所へ行かれた。そして弟子たちに言われた、「わたしが向こうへ行って祈っている間、ここにすわっていなさい」。"},{"ref":"Matt.26.37","start":40026037,"end":40026037,"break":"none","ruby":[[12,1,"こ"],[18,1,"つ"],[21,1,"い"],[27,1,"かな"],[31,1,"もよお"],[35,1,"なや"]],"text":"そしてペテロとゼベダイの子ふたりとを連れて行かれたが、悲しみを催しまた悩みはじめられた。"},{"ref":"Matt.26.38","start":40026038,"end":40026038,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[18,1,"かな"],[25,1,"し"],[36,1,"ま"],[46,2,"いっしょ"],[49,1,"め"]],"text":"そのとき、彼らに言われた、「わたしは悲しみのあまり死ぬほどである。ここに待っていて、わたしと一緒に目をさましていなさい」。"},{"ref":"Matt.26.39","start":40026039,"end":40026039,"break":"none","ruby":[[3,1,"すこ"],[5,1,"すす"],[8,1,"い"],[19,1,"いの"],[22,1,"い"],[30,1,"ちち"],[50,1,"さかずき"],[57,1,"す"],[59,1,"さ"],[76,1,"おも"],[99,1,"くだ"]],"text":"そして少し進んで行き、うつぶしになり、祈って言われた、「わが父よ、もしできることでしたらどうか、この杯をわたしから過ぎ去らせてください。しかし、わたしの思いのままにではなく、みこころのままになさって下さい」。"},{"ref":"Matt.26.40","start":40026040,"end":40026040,"break":"none","ruby":[[5,2,"でし"],[10,1,"ところ"],[22,1,"かれ"],[25,1,"ねむ"],[37,1,"い"],[56,1,"とき"],[62,2,"いっしょ"],[65,1,"め"]],"text":"それから、弟子たちの所にきてごらんになると、彼らが眠っていたので、ペテロに言われた、「あなたがたはそんなに、ひと時もわたしと一緒に目をさましていることが、できなかったのか。"},{"ref":"Matt.26.41","start":40026041,"end":40026041,"break":"none","ruby":[[0,2,"ゆうわく"],[3,1,"おちい"],[11,1,"め"],[17,1,"いの"],[25,1,"こころ"],[27,1,"ねっ"],[34,2,"にくたい"],[37,1,"よわ"]],"text":"誘惑に陥らないように、目をさまして祈っていなさい。心は熱しているが、肉体が弱いのである」。"},{"ref":"Matt.26.42","start":40026042,"end":40026042,"break":"none","ruby":[[3,2,"どめ"],[6,1,"い"],[10,1,"いの"],[13,1,"い"],[21,1,"ちち"],[26,1,"さかずき"],[28,1,"の"],[33,1,"みち"],[52,1,"おこな"]],"text":"また二度目に行って、祈って言われた、「わが父よ、この杯を飲むほかに道がないのでしたら、どうか、みこころが行われますように」。"},{"ref":"Matt.26.43","start":40026043,"end":40026043,"break":"none","ruby":[[12,1,"かれ"],[17,1,"ねむ"],[25,1,"め"],[27,1,"おも"]],"text":"またきてごらんになると、彼らはまた眠っていた。その目が重くなっていたのである。"},{"ref":"Matt.26.44","start":40026044,"end":40026044,"break":"none","ruby":[[3,1,"かれ"],[16,1,"い"],[21,2,"どめ"],[24,1,"おな"],[26,2,"ことば"],[29,1,"いの"]],"text":"それで彼らをそのままにして、また行って、三度目に同じ言葉で祈られた。"},{"ref":"Matt.26.45","start":40026045,"end":40026045,"break":"none","ruby":[[4,2,"でし"],[9,1,"ところ"],[11,1,"かえ"],[17,1,"い"],[25,1,"ねむ"],[33,1,"やす"],[41,1,"み"],[44,1,"とき"],[46,1,"せま"],[50,1,"ひと"],[52,1,"こ"],[54,2,"つみびと"],[58,1,"て"],[60,1,"わた"]],"text":"それから弟子たちの所に帰ってきて、言われた、「まだ眠っているのか、休んでいるのか。見よ、時が迫った。人の子は罪人らの手に渡されるのだ。"},{"ref":"Matt.26.46","start":40026046,"end":40026046,"break":"none","ruby":[[0,1,"た"],[5,1,"い"],[9,1,"み"],[16,2,"うらぎ"],[19,1,"もの"],[21,1,"ちか"]],"text":"立て、さあ行こう。見よ、わたしを裏切る者が近づいてきた」。"},{"ref":"Matt.26.47","start":40026047,"end":40026047,"break":"paragraph","ruby":[[10,1,"はな"],[27,2,"でし"],[42,3,"さいしちょう"],[46,1,"たみ"],[48,2,"ちょうろう"],[54,1,"おく"],[58,1,"おお"],[62,2,"ぐんしゅう"],[66,1,"けん"],[68,1,"ぼう"],[71,1,"も"],[74,1,"かれ"]],"text":"そして、イエスがまだ話しておられるうちに、そこに、十二弟子のひとりのユダがきた。また祭司長、民の長老たちから送られた大ぜいの群衆も、剣と棒とを持って彼についてきた。"},{"ref":"Matt.26.48","start":40026048,"end":40026048,"break":"none","ruby":[[4,2,"うらぎ"],[8,1,"もの"],[16,1,"かれ"],[25,2,"せっぷん"],[29,1,"もの"],[34,1,"ひと"],[39,1,"ひと"],[48,2,"あいず"]],"text":"イエスを裏切った者が、あらかじめ彼らに、「わたしの接吻する者が、その人だ。その人をつかまえろ」と合図をしておいた。"},{"ref":"Matt.26.49","start":40026049,"end":40026049,"break":"none","ruby":[[0,1,"かれ"],[8,2,"ちかよ"],[13,2,"せんせい"],[24,1,"い"],[32,2,"せっぷん"]],"text":"彼はすぐイエスに近寄り、「先生、いかがですか」と言って、イエスに接吻した。"},{"ref":"Matt.26.50","start":40026050,"end":40026050,"break":"none","ruby":[[8,1,"かれ"],[10,1,"い"],[16,1,"とも"],[36,2,"ひとびと"],[39,1,"すす"],[41,1,"よ"],[49,1,"て"]],"text":"しかし、イエスは彼に言われた、「友よ、なんのためにきたのか」。このとき、人々が進み寄って、イエスに手をかけてつかまえた。"},{"ref":"Matt.26.51","start":40026051,"end":40026051,"break":"none","ruby":[[8,2,"いっしょ"],[13,1,"もの"],[20,1,"て"],[22,1,"の"],[26,1,"けん"],[28,1,"ぬ"],[34,3,"だいさいし"],[38,1,"しもべ"],[40,1,"き"],[49,2,"かたみみ"],[52,1,"き"],[54,1,"おと"]],"text":"すると、イエスと一緒にいた者のひとりが、手を伸ばして剣を抜き、そして大祭司の僕に切りかかって、その片耳を切り落した。"},{"ref":"Matt.26.52","start":40026052,"end":40026052,"break":"none","ruby":[[8,1,"かれ"],[10,1,"い"],[20,1,"けん"],[25,1,"ところ"],[34,1,"けん"],[38,1,"もの"],[43,1,"けん"],[45,1,"ほろ"]],"text":"そこで、イエスは彼に言われた、「あなたの剣をもとの所におさめなさい。剣をとる者はみな、剣で滅びる。"},{"ref":"Matt.26.53","start":40026053,"end":40026053,"break":"none","ruby":[[9,1,"ちち"],[11,1,"ねが"],[15,1,"てん"],[17,1,"つかい"],[23,2,"ぐんだん"],[25,2,"いじょう"],[29,1,"いま"],[52,1,"おも"]],"text":"それとも、わたしが父に願って、天の使たちを十二軍団以上も、今つかわしていただくことができないと、あなたは思うのか。"},{"ref":"Matt.26.54","start":40026054,"end":40026054,"break":"none","ruby":[[20,1,"か"],[25,2,"せいしょ"],[28,2,"ことば"],[36,2,"じょうじゅ"]],"text":"しかし、それでは、こうならねばならないと書いてある聖書の言葉は、どうして成就されようか」。"},{"ref":"Matt.26.55","start":40026055,"end":40026055,"break":"none","ruby":[[9,2,"ぐんしゅう"],[12,1,"い"],[24,2,"ごうとう"],[34,1,"けん"],[36,1,"ぼう"],[38,1,"も"],[45,1,"とら"],[57,2,"まいにち"],[60,1,"みや"],[66,1,"おし"]],"text":"そのとき、イエスは群衆に言われた、「あなたがたは強盗にむかうように、剣や棒を持ってわたしを捕えにきたのか。わたしは毎日、宮ですわって教えていたのに、わたしをつかまえはしなかった。"},{"ref":"Matt.26.56","start":40026056,"end":40026056,"break":"none","ruby":[[15,3,"よげんしゃ"],[21,1,"か"],[28,2,"じょうじゅ"],[44,2,"でし"],[49,1,"みな"],[54,2,"みす"],[58,1,"に"],[60,1,"さ"]],"text":"しかし、すべてこうなったのは、預言者たちの書いたことが、成就するためである」。そのとき、弟子たちは皆イエスを見捨てて逃げ去った。"},{"ref":"Matt.26.57","start":40026057,"end":40026057,"break":"paragraph","ruby":[[12,1,"ひと"],[17,3,"だいさいし"],[32,1,"つ"],[35,1,"い"],[43,2,"りっぽう"],[45,2,"がくしゃ"],[48,2,"ちょうろう"],[53,1,"あつ"]],"text":"さて、イエスをつかまえた人たちは、大祭司カヤパのところにイエスを連れて行った。そこには律法学者、長老たちが集まっていた。"},{"ref":"Matt.26.58","start":40026058,"end":40026058,"break":"none","ruby":[[4,1,"とお"],[16,3,"だいさいし"],[20,2,"なかにわ"],[24,1,"い"],[34,1,"み"],[43,1,"なか"],[49,2,"したやく"],[54,2,"いっしょ"]],"text":"ペテロは遠くからイエスについて、大祭司の中庭まで行き、そのなりゆきを見とどけるために、中にはいって下役どもと一緒にすわっていた。"},{"ref":"Matt.26.59","start":40026059,"end":40026059,"break":"none","ruby":[[3,3,"さいしちょう"],[9,1,"ぜん"],[10,2,"ぎかい"],[19,2,"しけい"],[31,2,"ふり"],[34,2,"ぎしょう"],[37,1,"もと"]],"text":"さて、祭司長たちと全議会とは、イエスを死刑にするため、イエスに不利な偽証を求めようとしていた。"},{"ref":"Matt.26.60","start":40026060,"end":40026060,"break":"none","ruby":[[3,1,"おお"],[6,3,"ぎしょうしゃ"],[10,1,"で"],[16,2,"しょうこ"],[31,2,"さいご"],[38,1,"もの"],[40,1,"で"]],"text":"そこで多くの偽証者が出てきたが、証拠があがらなかった。しかし、最後にふたりの者が出てきて"},{"ref":"Matt.26.61","start":40026061,"end":40026061,"break":"none","ruby":[[0,1,"い"],[7,1,"ひと"],[14,1,"かみ"],[16,1,"みや"],[18,1,"う"],[25,1,"か"],[27,1,"のち"],[29,1,"た"],[40,1,"い"]],"text":"言った、「この人は、わたしは神の宮を打ちこわし、三日の後に建てることができる、と言いました」。"},{"ref":"Matt.26.62","start":40026062,"end":40026062,"break":"none","ruby":[[4,3,"だいさいし"],[8,1,"た"],[10,1,"あ"],[18,1,"い"],[23,1,"なに"],[25,1,"こた"],[36,2,"ひとびと"],[43,1,"たい"],[46,2,"ふり"],[49,2,"しょうげん"],[52,1,"もう"],[54,1,"た"]],"text":"すると、大祭司が立ち上がってイエスに言った、「何も答えないのか。これらの人々があなたに対して不利な証言を申し立てているが、どうなのか」。"},{"ref":"Matt.26.63","start":40026063,"end":40026063,"break":"none","ruby":[[8,1,"だま"],[19,3,"だいさいし"],[23,1,"い"],[32,1,"かみ"],[34,1,"こ"],[46,1,"い"],[49,1,"かみ"],[51,1,"ちか"],[59,1,"こた"]],"text":"しかし、イエスは黙っておられた。そこで大祭司は言った、「あなたは神の子キリストなのかどうか、生ける神に誓ってわれわれに答えよ」。"},{"ref":"Matt.26.64","start":40026064,"end":40026064,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[16,1,"い"],[33,1,"い"],[46,1,"ま"],[51,1,"ひと"],[53,1,"こ"],[55,1,"ちから"],[58,1,"もの"],[60,1,"みぎ"],[62,1,"ざ"],[65,1,"てん"],[67,1,"くも"],[69,1,"の"],[72,1,"く"],[76,1,"み"]],"text":"イエスは彼に言われた、「あなたの言うとおりである。しかし、わたしは言っておく。あなたがたは、間もなく、人の子が力ある者の右に座し、天の雲に乗って来るのを見るであろう」。"},{"ref":"Matt.26.65","start":40026065,"end":40026065,"break":"none","ruby":[[4,3,"だいさいし"],[10,1,"ころも"],[12,1,"ひ"],[14,1,"さ"],[17,1,"い"],[22,1,"かれ"],[24,1,"かみ"],[26,1,"けが"],[36,2,"いじょう"],[39,2,"しょうにん"],[42,2,"ひつよう"],[55,1,"いま"],[61,1,"ごと"],[63,1,"き"]],"text":"すると、大祭司はその衣を引き裂いて言った、「彼は神を汚した。どうしてこれ以上、証人の必要があろう。あなたがたは今このけがし言を聞いた。"},{"ref":"Matt.26.66","start":40026066,"end":40026066,"break":"none","ruby":[[6,2,"いけん"],[18,1,"かれ"],[21,1,"こた"],[24,1,"い"],[29,1,"かれ"],[31,1,"し"],[33,1,"あた"]],"text":"あなたがたの意見はどうか」。すると、彼らは答えて言った、「彼は死に当るものだ」。"},{"ref":"Matt.26.67","start":40026067,"end":40026067,"break":"none","ruby":[[5,1,"かれ"],[12,1,"かお"],[26,1,"う"],[33,1,"ひと"],[35,1,"て"],[44,1,"い"]],"text":"それから、彼らはイエスの顔につばきをかけて、こぶしで打ち、またある人は手のひらでたたいて言った、"},{"ref":"Matt.26.68","start":40026068,"end":40026068,"break":"none","ruby":[[7,1,"い"],[15,1,"う"]],"text":"「キリストよ、言いあててみよ、打ったのはだれか」。"},{"ref":"Matt.26.69","start":40026069,"end":40026069,"break":"paragraph","ruby":[[4,1,"そと"],[6,2,"なかにわ"],[23,2,"じょちゅう"],[26,1,"かれ"],[46,1,"びと"],[51,2,"いっしょ"],[58,1,"い"]],"text":"ペテロは外で中庭にすわっていた。するとひとりの女中が彼のところにきて、「あなたもあのガリラヤ人イエスと一緒だった」と言った。"},{"ref":"Matt.26.70","start":40026070,"end":40026070,"break":"none","ruby":[[12,1,"まえ"],[17,1,"う"],[19,1,"け"],[22,1,"い"],[31,1,"なに"],[33,1,"い"]],"text":"するとペテロは、みんなの前でそれを打ち消して言った、「あなたが何を言っているのか、わからない」。"},{"ref":"Matt.26.71","start":40026071,"end":40026071,"break":"none","ruby":[[2,1,"い"],[5,2,"いりぐち"],[8,1,"ほう"],[10,1,"で"],[12,1,"い"],[19,2,"じょちゅう"],[22,1,"かれ"],[24,1,"み"],[32,2,"ひとびと"],[43,1,"ひと"],[48,1,"びと"],[53,2,"いっしょ"],[60,1,"い"]],"text":"そう言って入口の方に出て行くと、ほかの女中が彼を見て、そこにいる人々にむかって、「この人はナザレ人イエスと一緒だった」と言った。"},{"ref":"Matt.26.72","start":40026072,"end":40026072,"break":"none","ruby":[[3,1,"かれ"],[5,1,"ふたた"],[10,1,"う"],[12,1,"け"],[20,1,"ひと"],[22,1,"し"],[28,1,"ちか"],[31,1,"い"]],"text":"そこで彼は再びそれを打ち消して、「そんな人は知らない」と誓って言った。"},{"ref":"Matt.26.73","start":40026073,"end":40026073,"break":"none","ruby":[[10,1,"た"],[15,2,"ひとびと"],[18,2,"ちかよ"],[29,1,"い"],[34,1,"たし"],[41,1,"かれ"],[44,2,"なかま"],[48,2,"ことば"]],"text":"しばらくして、そこに立っていた人々が近寄ってきて、ペテロに言った、「確かにあなたも彼らの仲間だ。言葉づかいであなたのことがわかる」。"},{"ref":"Matt.26.74","start":40026074,"end":40026074,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ひと"],[10,1,"なに"],[12,1,"し"],[18,1,"い"],[22,1,"はげ"],[25,1,"ちか"],[37,1,"にわとり"],[39,1,"な"]],"text":"彼は「その人のことは何も知らない」と言って、激しく誓いはじめた。するとすぐ鶏が鳴いた。"},{"ref":"Matt.26.75","start":40026075,"end":40026075,"break":"none","ruby":[[5,1,"にわとり"],[7,1,"な"],[9,1,"まえ"],[13,1,"ど"],[18,1,"し"],[23,1,"い"],[31,1,"い"],[39,2,"ことば"],[42,1,"おも"],[44,1,"だ"],[47,1,"そと"],[49,1,"で"],[51,1,"はげ"],[54,1,"な"]],"text":"ペテロは「鶏が鳴く前に、三度わたしを知らないと言うであろう」と言われたイエスの言葉を思い出し、外に出て激しく泣いた。"}]