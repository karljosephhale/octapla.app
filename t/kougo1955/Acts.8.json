[{"ref":"Acts.8.1","start":44008001,"end":44008001,"break":"paragraph","breaks":[[22,"paragraph"]],"ruby":[[10,1,"ころ"],[15,2,"さんせい"],[24,1,"ひ"],[32,2,"きょうかい"],[35,1,"たい"],[38,1,"おお"],[39,2,"はくがい"],[42,1,"おこ"],[45,2,"しと"],[47,2,"いがい"],[50,1,"もの"],[68,2,"ちほう"],[71,1,"ち"],[76,1,"い"]],"text":"サウロは、ステパノを殺すことに賛成していた。その日、エルサレムの教会に対して大迫害が起り、使徒以外の者はことごとく、ユダヤとサマリヤとの地方に散らされて行った。"},{"ref":"Acts.8.2","start":44008002,"end":44008002,"break":"none","ruby":[[0,2,"しんこう"],[2,1,"ぶか"],[4,1,"ひと"],[13,1,"ほうむ"],[16,1,"かれ"],[21,1,"むね"],[23,1,"う"],[27,2,"ひじょう"],[30,1,"かな"]],"text":"信仰深い人たちはステパノを葬り、彼のために胸を打って、非常に悲しんだ。"},{"ref":"Acts.8.3","start":44008003,"end":44008003,"break":"none","ruby":[[9,2,"いえいえ"],[12,1,"お"],[14,1,"い"],[18,1,"おとこ"],[20,1,"おんな"],[22,1,"ひ"],[26,1,"だ"],[29,2,"つぎつぎ"],[32,1,"ごく"],[34,1,"わた"],[38,2,"きょうかい"],[41,1,"あら"],[43,1,"まわ"]],"text":"ところが、サウロは家々に押し入って、男や女を引きずり出し、次々に獄に渡して、教会を荒し回った。"},{"ref":"Acts.8.4","start":44008004,"end":44008004,"break":"paragraph","ruby":[[3,1,"ち"],[8,1,"い"],[11,1,"ひと"],[16,2,"みことば"],[19,1,"の"],[21,1,"つた"],[30,1,"ある"]],"text":"さて、散らされて行った人たちは、御言を宣べ伝えながら、めぐり歩いた。"},{"ref":"Acts.8.5","start":44008005,"end":44008005,"break":"none","ruby":[[9,1,"まち"],[11,1,"くだ"],[14,1,"い"],[17,2,"ひとびと"],[25,1,"の"]],"text":"ピリポはサマリヤの町に下って行き、人々にキリストを宣べはじめた。"},{"ref":"Acts.8.6","start":44008006,"end":44008006,"break":"none","ruby":[[0,2,"ぐんしゅう"],[7,1,"はなし"],[9,1,"き"],[14,1,"おこな"],[23,1,"み"],[30,1,"かれ"],[32,1,"かた"],[37,1,"みみ"],[39,1,"かたむ"]],"text":"群衆はピリポの話を聞き、その行っていたしるしを見て、こぞって彼の語ることに耳を傾けた。"},{"ref":"Acts.8.7","start":44008007,"end":44008007,"break":"none","ruby":[[0,1,"けが"],[3,1,"れい"],[9,1,"おお"],[12,2,"ひとびと"],[20,1,"れい"],[22,2,"おおごえ"],[31,1,"で"],[33,1,"い"],[40,1,"おお"],[43,2,"ちゅうぶ"],[53,1,"もの"],[56,1,"あし"],[62,1,"もの"]],"text":"汚れた霊につかれた多くの人々からは、その霊が大声でわめきながら出て行くし、また、多くの中風をわずらっている者や、足のきかない者がいやされたからである。"},{"ref":"Acts.8.8","start":44008008,"end":44008008,"break":"none","ruby":[[6,1,"まち"],[9,2,"ひとびと"],[13,2,"たいへん"]],"text":"それで、この町では人々が、大変なよろこびかたであった。"},{"ref":"Acts.8.9","start":44008009,"end":44008009,"break":"paragraph","ruby":[[5,1,"まち"],[7,2,"いぜん"],[17,1,"ひと"],[22,1,"かれ"],[24,2,"まじゅつ"],[27,1,"おこな"],[35,1,"ひと"],[39,1,"おどろ"],[43,2,"じぶん"],[48,1,"えら"],[50,1,"もの"],[55,1,"い"]],"text":"さて、この町に以前からシモンという人がいた。彼は魔術を行ってサマリヤの人たちを驚かし、自分をさも偉い者のように言いふらしていた。"},{"ref":"Acts.8.10","start":44008010,"end":44008010,"break":"none","ruby":[[4,1,"ちい"],[7,1,"もの"],[10,1,"おお"],[13,1,"もの"],[20,1,"みな"],[22,1,"かれ"],[27,1,"い"],[33,1,"ひと"],[38,2,"たいのう"],[42,1,"よ"],[46,1,"かみ"],[48,1,"ちから"],[54,1,"い"]],"text":"それで、小さい者から大きい者にいたるまで皆、彼について行き、「この人こそは『大能』と呼ばれる神の力である」と言っていた。"},{"ref":"Acts.8.11","start":44008011,"end":44008011,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ひと"],[10,1,"い"],[19,1,"あいだ"],[22,2,"まじゅつ"],[25,1,"おどろ"]],"text":"彼らがこの人について行ったのは、ながい間その魔術に驚かされていたためであった。"},{"ref":"Acts.8.12","start":44008012,"end":44008012,"break":"none","ruby":[[9,1,"かみ"],[11,1,"くに"],[22,1,"な"],[27,1,"の"],[29,1,"つた"],[33,1,"およ"],[37,1,"おとこ"],[39,1,"おんな"],[41,1,"しん"],[56,1,"う"]],"text":"ところが、ピリポが神の国とイエス・キリストの名について宣べ伝えるに及んで、男も女も信じて、ぞくぞくとバプテスマを受けた。"},{"ref":"Acts.8.13","start":44008013,"end":44008013,"break":"none","ruby":[[3,2,"じしん"],[6,1,"しん"],[16,1,"う"],[24,1,"ひ"],[36,1,"い"],[44,2,"かずかず"],[56,2,"きせき"],[59,1,"おこな"],[65,1,"み"],[68,1,"おどろ"]],"text":"シモン自身も信じて、バプテスマを受け、それから、引きつづきピリポについて行った。そして、数々のしるしやめざましい奇跡が行われるのを見て、驚いていた。"},{"ref":"Acts.8.14","start":44008014,"end":44008014,"break":"paragraph","ruby":[[8,2,"しと"],[19,2,"ひとびと"],[23,1,"かみ"],[25,1,"ことば"],[27,1,"う"],[29,1,"い"],[33,1,"き"]],"text":"エルサレムにいる使徒たちは、サマリヤの人々が、神の言を受け入れたと聞いて、ペテロとヨハネとを、そこにつかわした。"},{"ref":"Acts.8.15","start":44008015,"end":44008015,"break":"none","ruby":[[9,1,"くだ"],[12,1,"い"],[20,2,"せいれい"],[23,1,"う"],[31,1,"かれ"],[37,1,"いの"]],"text":"ふたりはサマリヤに下って行って、みんなが聖霊を受けるようにと、彼らのために祈った。"},{"ref":"Acts.8.16","start":44008016,"end":44008016,"break":"none","ruby":[[4,1,"かれ"],[9,1,"しゅ"],[14,1,"な"],[25,1,"う"],[34,2,"せいれい"],[43,1,"くだ"]],"text":"それは、彼らはただ主イエスの名によってバプテスマを受けていただけで、聖霊はまだだれにも下っていなかったからである。"},{"ref":"Acts.8.17","start":44008017,"end":44008017,"break":"none","ruby":[[8,1,"て"],[10,1,"かれ"],[13,1,"うえ"],[22,1,"かれ"],[25,2,"せいれい"],[28,1,"う"]],"text":"そこで、ふたりが手を彼らの上においたところ、彼らは聖霊を受けた。"},{"ref":"Acts.8.18","start":44008018,"end":44008018,"break":"none","ruby":[[5,2,"しと"],[10,1,"て"],[19,2,"みたま"],[22,2,"ひとびと"],[25,1,"さづ"],[32,1,"み"],[35,1,"かね"],[39,1,"だ"]],"text":"シモンは、使徒たちが手をおいたために、御霊が人々に授けられたのを見て、金をさし出し、"},{"ref":"Acts.8.19","start":44008019,"end":44008019,"break":"none","ruby":[[5,1,"て"],[15,2,"せいれい"],[18,1,"さづ"],[29,1,"ちから"],[36,1,"くだ"],[41,1,"い"]],"text":"「わたしが手をおけばだれにでも聖霊が授けられるように、その力をわたしにも下さい」と言った。"},{"ref":"Acts.8.20","start":44008020,"end":44008020,"break":"none","ruby":[[8,1,"かれ"],[10,1,"い"],[19,1,"かね"],[37,1,"かみ"],[39,2,"たまもの"],[43,1,"かね"],[45,1,"え"],[52,1,"おも"]],"text":"そこで、ペテロが彼に言った、「おまえの金は、おまえもろとも、うせてしまえ。神の賜物が、金で得られるなどと思っているのか。"},{"ref":"Acts.8.21","start":44008021,"end":44008021,"break":"none","ruby":[[4,1,"こころ"],[6,1,"かみ"],[8,1,"まえ"],[10,1,"ただ"],[30,1,"こと"]],"text":"おまえの心が神の前に正しくないから、おまえは、とうてい、この事にあずかることができない。"},{"ref":"Acts.8.22","start":44008022,"end":44008022,"break":"none","ruby":[[6,2,"あくじ"],[9,1,"く"],[13,1,"しゅ"],[15,1,"いの"],[30,1,"おも"],[33,1,"こころ"],[50,1,"し"]],"text":"だから、この悪事を悔いて、主に祈れ。そうすればあるいはそんな思いを心にいだいたことが、ゆるされるかも知れない。"},{"ref":"Acts.8.23","start":44008023,"end":44008023,"break":"none","ruby":[[8,1,"にが"],[10,2,"たんじゅう"],[16,2,"ふぎ"],[21,1,"め"]],"text":"おまえには、まだ苦い胆汁があり、不義のなわ目がからみついている。それが、わたしにわかっている」。"},{"ref":"Acts.8.24","start":44008024,"end":44008024,"break":"none","ruby":[[7,1,"き"],[10,1,"い"],[15,1,"おお"],[21,1,"こと"],[28,1,"み"],[30,1,"おこ"],[49,1,"しゅ"],[51,1,"いの"],[54,1,"くだ"]],"text":"シモンはこれを聞いて言った、「仰せのような事が、わたしの身に起らないように、どうぞ、わたしのために主に祈って下さい」。"},{"ref":"Acts.8.25","start":44008025,"end":44008025,"break":"paragraph","ruby":[[0,2,"しと"],[5,2,"ちからづよ"],[17,1,"しゅ"],[19,1,"ことば"],[21,1,"かた"],[24,1,"のち"],[30,1,"ひと"],[32,1,"おお"],[35,2,"むらむら"],[38,2,"ふくいん"],[41,1,"の"],[43,1,"つた"],[53,1,"かえ"]],"text":"使徒たちは力強くあかしをなし、また主の言を語った後、サマリヤ人の多くの村々に福音を宣べ伝えて、エルサレムに帰った。"},{"ref":"Acts.8.26","start":44008026,"end":44008026,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"つかい"],[16,1,"い"],[21,1,"た"],[24,2,"なんぽう"],[27,1,"い"],[40,1,"くだ"],[42,1,"みち"],[44,1,"で"],[56,1,"いま"],[58,1,"あ"]],"text":"しかし、主の使がピリポにむかって言った、「立って南方に行き、エルサレムからガザへ下る道に出なさい」（このガザは、今は荒れはてている）。"},{"ref":"Acts.8.27","start":44008027,"end":44008027,"break":"none","ruby":[[4,1,"かれ"],[6,1,"た"],[9,1,"で"],[28,1,"じん"],[30,2,"じょおう"],[37,2,"こうかん"],[41,2,"じょおう"],[44,2,"ざいほう"],[46,2,"ぜんぶ"],[49,2,"かんり"],[55,2,"かんがん"],[65,1,"じん"],[68,2,"れいはい"],[79,1,"のぼ"]],"text":"そこで、彼は立って出かけた。すると、ちょうど、エチオピヤ人の女王カンダケの高官で、女王の財宝全部を管理していた宦官であるエチオピヤ人が、礼拝のためエルサレムに上り、"},{"ref":"Acts.8.28","start":44008028,"end":44008028,"break":"none","ruby":[[2,2,"きと"],[18,1,"かれ"],[20,2,"じぶん"],[23,2,"ばしゃ"],[26,1,"の"],[30,3,"よげんしゃ"],[37,1,"しょ"],[39,1,"よ"]],"text":"その帰途についていたところであった。彼は自分の馬車に乗って、預言者イザヤの書を読んでいた。"},{"ref":"Acts.8.29","start":44008029,"end":44008029,"break":"none","ruby":[[0,2,"みたま"],[8,1,"すす"],[10,1,"よ"],[16,2,"ばしゃ"],[19,1,"なら"],[22,1,"い"],[29,1,"い"]],"text":"御霊がピリポに「進み寄って、あの馬車に並んで行きなさい」と言った。"},{"ref":"Acts.8.30","start":44008030,"end":44008030,"break":"none","ruby":[[7,1,"か"],[10,1,"い"],[14,3,"よげんしゃ"],[21,1,"しょ"],[23,1,"よ"],[30,1,"ひと"],[32,1,"こえ"],[34,1,"きこ"],[46,1,"よ"],[64,1,"たず"]],"text":"そこでピリポが駆けて行くと、預言者イザヤの書を読んでいるその人の声が聞えたので、「あなたは、読んでいることが、おわかりですか」と尋ねた。"},{"ref":"Acts.8.31","start":44008031,"end":44008031,"break":"none","ruby":[[0,1,"かれ"],[8,1,"て"],[34,1,"こた"],[42,2,"ばしゃ"],[45,1,"の"],[48,2,"いっしょ"]],"text":"彼は「だれかが、手びきをしてくれなければ、どうしてわかりましょう」と答えた。そして、馬車に乗って一緒にすわるようにと、ピリポにすすめた。"},{"ref":"Acts.8.32","start":44008032,"end":44008032,"break":"none","breaks":[[21,"stanza"],[42,"line"],[51,"line"],[68,"line"]],"ruby":[[0,1,"かれ"],[2,1,"よ"],[7,2,"せいしょ"],[10,2,"かしょ"],[22,1,"かれ"],[28,1,"ば"],[30,1,"ひ"],[34,1,"い"],[36,1,"ひつじ"],[45,2,"もくもく"],[51,1,"け"],[53,1,"か"],[55,1,"もの"],[57,1,"まえ"],[59,1,"た"],[61,2,"こひつじ"],[68,1,"くち"],[70,1,"ひら"]],"text":"彼が読んでいた聖書の箇所は、これであった、「彼は、ほふり場に引かれて行く羊のように、また、黙々として、毛を刈る者の前に立つ小羊のように、口を開かない。"},{"ref":"Acts.8.33","start":44008033,"end":44008033,"break":"line","breaks":[[11,"line"],[25,"line"],[48,"line"]],"ruby":[[0,1,"かれ"],[17,1,"おこな"],[29,1,"かれ"],[31,2,"しそん"],[37,1,"かた"],[48,1,"かれ"],[50,1,"いのち"],[52,2,"ちじょう"],[56,1,"と"],[58,1,"さ"]],"text":"彼は、いやしめられて、そのさばきも行われなかった。だれが、彼の子孫のことを語ることができようか、彼の命が地上から取り去られているからには」。"},{"ref":"Acts.8.34","start":44008034,"end":44008034,"break":"none","ruby":[[0,2,"かんがん"],[11,1,"い"],[17,1,"たず"],[27,3,"よげんしゃ"],[37,1,"い"],[47,2,"じぶん"],[67,1,"ひと"]],"text":"宦官はピリポにむかって言った、「お尋ねしますが、ここで預言者はだれのことを言っているのですか。自分のことですか、それとも、だれかほかの人のことですか」。"},{"ref":"Acts.8.35","start":44008035,"end":44008035,"break":"none","ruby":[[7,1,"くち"],[9,1,"ひら"],[14,1,"せい"],[15,1,"く"],[18,1,"と"],[20,1,"おこ"],[31,1,"の"],[33,1,"つた"]],"text":"そこでピリポは口を開き、この聖句から説き起して、イエスのことを宣べ伝えた。"},{"ref":"Acts.8.36","start":44008036,"end":44008036,"break":"none","ruby":[[0,1,"みち"],[2,1,"すす"],[5,1,"い"],[11,1,"みず"],[15,1,"ところ"],[22,2,"かんがん"],[25,1,"い"],[33,1,"みず"],[50,1,"う"]],"text":"道を進んで行くうちに、水のある所にきたので、宦官が言った、「ここに水があります。わたしがバプテスマを受けるのに、なんのさしつかえがありますか」。〔"},{"ref":"Acts.8.37","start":44008037,"end":44008037,"break":"none","ruby":[[3,1,"たい"],[23,1,"しん"],[29,1,"う"],[45,1,"い"],[53,1,"かれ"],[70,1,"かみ"],[72,1,"こ"],[74,1,"しん"],[80,1,"こた"]],"text":"これに対して、ピリポは、「あなたがまごころから信じるなら、受けてさしつかえはありません」と言った。すると、彼は「わたしは、イエス・キリストを神の子と信じます」と答えた。〕"},{"ref":"Acts.8.38","start":44008038,"end":44008038,"break":"none","ruby":[[3,1,"くるま"],[14,2,"かんがん"],[24,1,"みず"],[26,1,"なか"],[28,1,"お"],[31,1,"い"],[38,2,"かんがん"],[47,1,"さづ"]],"text":"そこで車をとめさせ、ピリポと宦官と、ふたりとも、水の中に降りて行き、ピリポが宦官にバプテスマを授けた。"},{"ref":"Acts.8.39","start":44008039,"end":44008039,"break":"none","ruby":[[4,1,"みず"],[7,1,"あ"],[12,1,"しゅ"],[14,1,"れい"],[24,1,"い"],[30,2,"かんがん"],[35,1,"かれ"],[37,1,"み"],[49,2,"かんがん"],[59,1,"たび"]],"text":"ふたりが水から上がると、主の霊がピリポをさらって行ったので、宦官はもう彼を見ることができなかった。宦官はよろこびながら旅をつづけた。"},{"ref":"Acts.8.40","start":44008040,"end":44008040,"break":"none","ruby":[[2,1,"のち"],[12,1,"すがた"],[20,2,"まちまち"],[26,1,"ある"],[36,2,"ふくいん"],[39,1,"の"],[41,1,"つた"],[54,1,"つ"]],"text":"その後、ピリポはアゾトに姿をあらわして、町々をめぐり歩き、いたるところで福音を宣べ伝えて、ついにカイザリヤに着いた。"}]