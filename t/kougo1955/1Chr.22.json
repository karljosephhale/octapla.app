[{"ref":"1Chr.22.1","start":13022001,"end":13022001,"break":"paragraph","ruby":[[7,1,"い"],[12,1,"しゅ"],[15,1,"かみ"],[17,1,"いえ"],[34,2,"はんさい"],[37,2,"さいだん"]],"text":"それでダビデは言った、「主なる神の家はこれである、イスラエルのための燔祭の祭壇はこれである」と。"},{"ref":"1Chr.22.2","start":13022002,"end":13022002,"break":"paragraph","ruby":[[4,1,"めい"],[13,1,"ち"],[17,2,"たこく"],[19,1,"じん"],[21,1,"あつ"],[28,1,"かみ"],[30,1,"いえ"],[32,1,"た"],[37,1,"もち"],[40,1,"いし"],[42,1,"き"],[47,2,"いしく"],[50,1,"さだ"]],"text":"ダビデは命じてイスラエルの地にいる他国人を集めさせ、また神の家を建てるのに用いる石を切るために石工を定めた。"},{"ref":"1Chr.22.3","start":13022003,"end":13022003,"break":"none","ruby":[[6,1,"もん"],[23,1,"もち"],[26,1,"てつ"],[34,1,"そな"],[40,2,"せいどう"],[43,1,"はか"],[60,1,"そな"]],"text":"ダビデはまた門のとびらのくぎ、およびかすがいに用いる鉄をおびただしく備えた。また青銅を量ることもできないほどおびただしく備えた。"},{"ref":"1Chr.22.4","start":13022004,"end":13022004,"break":"none","ruby":[[2,2,"こうはく"],[5,1,"かぞ"],[12,1,"そな"],[28,2,"ひとびと"],[37,2,"こうはく"],[44,1,"ところ"],[46,1,"も"],[49,1,"き"]],"text":"また香柏を数えきれぬほど備えた。これはシドンびととツロの人々がおびただしく香柏をダビデの所に持って来たからである。"},{"ref":"1Chr.22.5","start":13022005,"end":13022005,"break":"none","ruby":[[4,1,"い"],[11,1,"こ"],[17,1,"わか"],[22,2,"けいけん"],[30,1,"しゅ"],[35,1,"た"],[38,1,"いえ"],[44,2,"そうだい"],[48,2,"ばんこく"],[51,1,"な"],[53,1,"え"],[55,1,"さか"],[58,1,"え"],[83,2,"じゅんび"],[102,1,"し"],[104,1,"まえ"],[106,1,"おお"],[109,2,"ぶっし"],[112,2,"じゅんび"]],"text":"ダビデは言った、「わが子ソロモンは若く、かつ経験がない。また主のために建てる家はきわめて壮大で、万国に名を得、栄えを得るものでなければならない。それゆえ、わたしはその準備をしておこう」と。こうしてダビデは死ぬ前に多くの物資を準備した。"},{"ref":"1Chr.22.6","start":13022006,"end":13022006,"break":"paragraph","ruby":[[3,1,"かれ"],[7,1,"こ"],[13,1,"め"],[23,1,"かみ"],[25,1,"しゅ"],[30,1,"いえ"],[32,1,"た"],[38,1,"めい"]],"text":"そして彼はその子ソロモンを召して、イスラエルの神、主のために家を建てることを命じた。"},{"ref":"1Chr.22.7","start":13022007,"end":13022007,"break":"none","ruby":[[13,1,"い"],[20,1,"こ"],[29,1,"かみ"],[31,1,"しゅ"],[33,1,"な"],[38,1,"いえ"],[40,1,"た"],[45,1,"こころざ"]],"text":"すなわちダビデはソロモンに言った、「わが子よ、わたしはわが神、主の名のために家を建てようと志していた。"},{"ref":"1Chr.22.8","start":13022008,"end":13022008,"break":"none","ruby":[[4,1,"しゅ"],[6,2,"ことば"],[13,1,"のぞ"],[16,1,"い"],[26,1,"おお"],[29,1,"ち"],[31,1,"なが"],[34,1,"おお"],[38,2,"せんそう"],[52,1,"まえ"],[54,1,"おお"],[57,1,"ち"],[59,1,"ち"],[61,1,"なが"],[69,1,"な"],[74,1,"いえ"],[76,1,"た"]],"text":"ところが主の言葉がわたしに臨んで言われた、『おまえは多くの血を流し、大いなる戦争をした。おまえはわたしの前で多くの血を地に流したから、わが名のために家を建ててはならない。"},{"ref":"1Chr.22.9","start":13022009,"end":13022009,"break":"none","ruby":[[0,1,"み"],[3,1,"おとこ"],[5,1,"こ"],[11,1,"うま"],[15,1,"かれ"],[17,2,"へいわ"],[20,1,"ひと"],[29,1,"かれ"],[31,2,"へいあん"],[34,1,"あた"],[38,2,"しゅうい"],[46,1,"てき"],[48,1,"わずら"],[61,1,"かれ"],[63,1,"な"],[70,1,"よ"],[74,1,"あ"],[76,1,"よ"],[88,2,"へいあん"],[91,2,"せいおん"],[95,1,"あた"]],"text":"見よ、男の子がおまえに生れる。彼は平和の人である。わたしは彼に平安を与えて、周囲のもろもろの敵に煩わされないようにしよう。彼の名はソロモンと呼ばれ、彼の世にわたしはイスラエルに平安と静穏とを与える。"},{"ref":"1Chr.22.10","start":13022010,"end":13022010,"break":"none","ruby":[[0,1,"かれ"],[4,1,"な"],[9,1,"いえ"],[11,1,"た"],[19,1,"かれ"],[23,1,"こ"],[32,1,"かれ"],[34,1,"ちち"],[43,1,"かれ"],[45,2,"おうい"],[57,1,"うえ"],[59,1,"かた"]],"text":"彼はわが名のために家を建てるであろう。彼はわが子となり、わたしは彼の父となる。わたしは彼の王位をながくイスラエルの上に堅くするであろう』。"},{"ref":"1Chr.22.11","start":13022011,"end":13022011,"break":"none","ruby":[[5,1,"こ"],[11,1,"しゅ"],[17,1,"とも"],[27,1,"さか"],[33,1,"しゅ"],[42,1,"い"],[54,1,"かみ"],[56,1,"しゅ"],[58,1,"いえ"],[60,1,"た"]],"text":"それでわが子よ、どうか主があなたと共にいまし、あなたを栄えさせて、主があなたについて言われたように、あなたの神、主の家を建てさせてくださるように。"},{"ref":"1Chr.22.12","start":13022012,"end":13022012,"break":"none","ruby":[[6,1,"しゅ"],[12,2,"ふんべつ"],[15,2,"ちえ"],[18,1,"たま"],[31,1,"うえ"],[33,1,"た"],[46,1,"かみ"],[48,1,"しゅ"],[50,2,"りっぽう"],[58,1,"まも"]],"text":"ただ、どうか主があなたに分別と知恵を賜い、あなたをイスラエルの上に立たせられるとき、あなたの神、主の律法を、あなたに守らせてくださるように。"},{"ref":"1Chr.22.13","start":13022013,"end":13022013,"break":"none","ruby":[[7,1,"しゅ"],[22,1,"めい"],[27,1,"さだ"],[35,1,"つつし"],[38,1,"まも"],[48,1,"さか"],[56,1,"こころ"],[58,1,"つよ"],[62,1,"いさ"],[65,1,"おそ"]],"text":"あなたがもし、主がイスラエルについてモーセに命じられた定めとおきてとを慎んで守るならば、あなたは栄えるであろう。心を強くし、勇め。恐れてはならない、おののいてはならない。"},{"ref":"1Chr.22.14","start":13022014,"end":13022014,"break":"none","ruby":[[0,1,"み"],[7,2,"くなん"],[16,1,"しゅ"],[18,1,"いえ"],[23,1,"きん"],[31,1,"ぎん"],[39,1,"そな"],[44,2,"せいどう"],[47,1,"てつ"],[49,1,"はか"],[66,1,"そな"],[72,2,"ざいもく"],[75,1,"いし"],[78,1,"そな"],[91,1,"くわ"]],"text":"見よ、わたしは苦難のうちにあって主の家のために金十万タラント、銀百万タラントを備え、また青銅と鉄を量ることもできないほどおびただしく備えた。また材木と石をも備えた。あなたはまたこれに加えなければならない。"},{"ref":"1Chr.22.15","start":13022015,"end":13022015,"break":"none","ruby":[[7,2,"たすう"],[10,2,"しょくにん"],[17,1,"いし"],[19,1,"き"],[21,1,"き"],[23,1,"きざ"],[25,1,"もの"],[27,2,"こうさく"],[30,1,"たく"],[33,2,"かくしゅ"],[36,1,"もの"]],"text":"あなたにはまた多数の職人、すなわち石や木を切り刻む者、工作に巧みな各種の者がある。"},{"ref":"1Chr.22.16","start":13022016,"end":13022016,"break":"none","ruby":[[0,1,"きん"],[2,1,"ぎん"],[4,2,"せいどう"],[7,1,"てつ"],[21,1,"おこな"],[30,1,"しゅ"],[36,1,"とも"]],"text":"金、銀、青銅、鉄もおびただしくある。たって行いなさい。どうか主があなたと共におられるように」。"},{"ref":"1Chr.22.17","start":13022017,"end":13022017,"break":"paragraph","ruby":[[24,1,"こ"],[30,1,"たす"],[36,1,"めい"],[39,1,"い"]],"text":"ダビデはまたイスラエルのすべてのつかさたちにその子ソロモンを助けるように命じて言った、"},{"ref":"1Chr.22.18","start":13022018,"end":13022018,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[30,2,"しほう"],[33,2,"たいへい"],[36,1,"たま"],[46,1,"しゅ"],[50,1,"ち"],[52,1,"たみ"],[58,1,"て"],[70,1,"ち"],[72,1,"しゅ"],[74,1,"まえ"],[78,1,"たみ"],[80,1,"まえ"],[82,1,"ふく"]],"text":"「あなたがたの神、主はあなたがたとともにおられるではないか。四方に泰平を賜わったではないか。主はこの地の民をわたしの手にわたされたので、この地は主の前とその民の前に服している。"},{"ref":"1Chr.22.19","start":13022019,"end":13022019,"break":"none","ruby":[[9,1,"こころ"],[15,2,"せいしん"],[28,1,"かみ"],[30,1,"しゅ"],[32,1,"もと"],[41,1,"しゅ"],[44,1,"かみ"],[46,2,"せいじょ"],[49,1,"た"],[52,1,"しゅ"],[54,1,"な"],[59,1,"た"],[64,1,"いえ"],[67,1,"しゅ"],[69,2,"けいやく"],[72,1,"はこ"],[74,1,"かみ"],[76,1,"せい"],[84,1,"うつわ"],[86,1,"たずさ"],[88,1,"い"]],"text":"それであなたがたは心をつくし、精神をつくしてあなたがたの神、主を求めなさい。たって主なる神の聖所を建て、主の名のために建てるその家に、主の契約の箱と神の聖なるもろもろの器を携え入れなさい」。"}]