[{"ref":"Ps.99.1","start":19099001,"end":19099001,"break":"paragraph","breaks":[[9,"line"],[21,"line"],[36,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おう"],[14,1,"たみ"],[21,1,"しゅ"],[28,1,"うえ"],[30,1,"ざ"],[36,1,"ち"],[38,1,"ふる"]],"text":"主は王となられた。もろもろの民はおののけ。主はケルビムの上に座せられる。地は震えよ。"},{"ref":"Ps.99.2","start":19099002,"end":19099002,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[10,1,"おお"],[14,1,"かみ"],[16,1,"しゅ"],[23,1,"たみ"],[25,1,"うえ"],[27,1,"たか"]],"text":"主はシオンにおられて大いなる神、主はもろもろの民の上に高くいらせられる。"},{"ref":"Ps.99.3","start":19099003,"end":19099003,"break":"line","breaks":[[18,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[7,1,"おお"],[11,1,"おそ"],[16,1,"な"],[29,1,"しゅ"],[31,1,"せい"]],"text":"彼らはあなたの大いなる恐るべきみ名をほめたたえるであろう。主は聖でいらせられる。"},{"ref":"Ps.99.4","start":19099004,"end":19099004,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"たいのう"],[3,1,"おう"],[8,2,"こうぎ"],[11,1,"あい"],[14,1,"もの"],[22,1,"かた"],[24,2,"こうへい"],[27,1,"た"],[34,1,"なか"],[36,1,"せい"],[38,1,"ぎ"],[41,1,"おこな"]],"text":"大能の王であり、公義を愛する者であるあなたは堅く公平を立て、ヤコブの中に正と義とを行われた。"},{"ref":"Ps.99.5","start":19099005,"end":19099005,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[4,1,"かみ"],[6,1,"しゅ"],[14,1,"あし"],[15,1,"だい"],[20,1,"おが"],[26,1,"しゅ"],[28,1,"せい"]],"text":"われらの神、主をあがめ、その足台のもとで拝みまつれ。主は聖でいらせられる。"},{"ref":"Ps.99.6","start":19099006,"end":19099006,"break":"line","breaks":[[20,"line"],[40,"line"]],"ruby":[[2,2,"さいし"],[5,1,"なか"],[23,1,"な"],[25,1,"よ"],[27,1,"もの"],[29,1,"なか"],[40,1,"かれ"],[43,1,"しゅ"],[45,1,"よ"],[51,1,"しゅ"],[53,1,"こた"]],"text":"その祭司の中にモーセとアロンとがあった。そのみ名を呼ぶ者の中にサムエルもあった。彼らが主に呼ばわると、主は答えられた。"},{"ref":"Ps.99.7","start":19099007,"end":19099007,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"くも"],[4,1,"はしら"],[9,1,"かれ"],[12,1,"かた"],[17,1,"かれ"],[27,1,"かれ"],[30,1,"たま"],[34,1,"さだ"],[38,1,"まも"]],"text":"主は雲の柱のうちで彼らに語られた。彼らはそのあかしと、彼らに賜わった定めとを守った。"},{"ref":"Ps.99.8","start":19099008,"end":19099008,"break":"line","breaks":[[22,"line"],[45,"line"]],"ruby":[[4,1,"かみ"],[6,1,"しゅ"],[13,1,"かれ"],[16,1,"こた"],[26,1,"かれ"],[33,1,"あた"],[38,1,"かみ"],[45,1,"あく"],[47,1,"おこな"],[49,1,"もの"],[52,2,"ほうふく"]],"text":"われらの神、主よ、あなたは彼らに答えられた。あなたは彼らにゆるしを与えられた神であったが、悪を行う者には報復された。"},{"ref":"Ps.99.9","start":19099009,"end":19099009,"break":"line","breaks":[[25,"line"]],"ruby":[[4,1,"かみ"],[6,1,"しゅ"],[14,1,"せい"],[17,1,"やま"],[19,1,"おが"],[29,1,"かみ"],[31,1,"しゅ"],[33,1,"せい"]],"text":"われらの神、主をあがめ、その聖なる山で拝みまつれ。われらの神、主は聖でいらせられるからである。"}]