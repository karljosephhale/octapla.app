[{"ref":"Num.25.1","start":4025001,"end":4025001,"break":"paragraph","ruby":[[20,1,"たみ"],[26,1,"むすめ"],[35,1,"こと"],[38,1,"はじ"]],"text":"イスラエルはシッテムにとどまっていたが、民はモアブの娘たちと、みだらな事をし始めた。"},{"ref":"Num.25.2","start":4025002,"end":4025002,"break":"none","ruby":[[2,1,"むすめ"],[6,2,"かみがみ"],[9,2,"ぎせい"],[16,1,"とき"],[18,1,"たみ"],[20,1,"まね"],[24,1,"たみ"],[26,2,"いっしょ"],[32,1,"た"],[35,1,"むすめ"],[39,2,"かみがみ"],[42,1,"おが"]],"text":"その娘たちが神々に犠牲をささげる時に民を招くと、民は一緒にそれを食べ、娘たちの神々を拝んだ。"},{"ref":"Num.25.3","start":4025003,"end":4025003,"break":"none","ruby":[[28,1,"しゅ"],[40,1,"いか"],[43,1,"はっ"]],"text":"イスラエルはこうしてペオルのバアルにつきしたがったので、主はイスラエルにむかって怒りを発せられた。"},{"ref":"Num.25.4","start":4025004,"end":4025004,"break":"none","ruby":[[3,1,"しゅ"],[9,1,"い"],[15,1,"たみ"],[17,2,"しゅりょう"],[25,1,"とら"],[28,1,"ひ"],[37,2,"ひとびと"],[40,1,"しゅ"],[42,1,"まえ"],[44,2,"しょけい"],[56,1,"しゅ"],[58,1,"いか"],[67,1,"はな"]],"text":"そして主はモーセに言われた、「民の首領をことごとく捕え、日のあるうちにその人々を主の前で処刑しなさい。そうすれば主の怒りはイスラエルを離れるであろう」。"},{"ref":"Num.25.5","start":4025005,"end":4025005,"break":"none","ruby":[[22,1,"い"],[38,2,"はいか"],[41,1,"もの"],[63,1,"ころ"]],"text":"モーセはイスラエルのさばきびとたちにむかって言った、「あなたがたはおのおの、配下の者どもでペオルのバアルにつきしたがったものを殺しなさい」。"},{"ref":"Num.25.6","start":4025006,"end":4025006,"break":"paragraph","ruby":[[10,2,"ひとびと"],[13,1,"ぜん"],[14,2,"かいしゅう"],[18,2,"かいけん"],[21,2,"まくや"],[24,2,"いりぐち"],[27,1,"な"],[32,1,"とき"],[34,1,"かれ"],[37,1,"め"],[39,1,"まえ"],[57,2,"きょうだい"],[62,1,"なか"],[74,1,"おんな"],[76,1,"つ"]],"text":"モーセとイスラエルの人々の全会衆とが会見の幕屋の入口で泣いていた時、彼らの目の前で、ひとりのイスラエルびとが、その兄弟たちの中に、ひとりのミデアンの女を連れてきた。"},{"ref":"Num.25.7","start":4025007,"end":4025007,"break":"none","ruby":[[0,2,"さいし"],[6,1,"こ"],[15,1,"こ"],[24,1,"み"],[27,2,"かいしゅう"],[34,1,"た"],[36,1,"あ"],[43,1,"て"],[45,1,"と"]],"text":"祭司アロンの子なるエレアザルの子ピネハスはこれを見て、会衆のうちから立ち上がり、やりを手に執り、"},{"ref":"Num.25.8","start":4025008,"end":4025008,"break":"none","ruby":[[8,1,"ひと"],[10,1,"あと"],[12,1,"お"],[16,1,"おく"],[18,1,"ま"],[20,1,"い"],[31,1,"ひと"],[33,1,"つ"],[40,1,"おんな"],[42,1,"はら"],[44,1,"つ"],[46,1,"とお"],[54,1,"ころ"],[62,2,"えきびょう"],[71,2,"ひとびと"],[74,1,"およ"]],"text":"そのイスラエルの人の後を追って、奥の間に入り、そのイスラエルの人を突き、またその女の腹を突き通して、ふたりを殺した。こうして疫病がイスラエルの人々に及ぶのがやんだ。"},{"ref":"Num.25.9","start":4025009,"end":4025009,"break":"none","ruby":[[6,2,"えきびょう"],[9,1,"し"],[12,1,"もの"],[18,1,"にん"]],"text":"しかし、その疫病で死んだ者は二万四千人であった。"},{"ref":"Num.25.10","start":4025010,"end":4025010,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.25.11","start":4025011,"end":4025011,"break":"none","ruby":[[1,2,"さいし"],[7,1,"こ"],[16,1,"こ"],[22,2,"じぶん"],[36,2,"ふんげき"],[45,2,"ひとびと"],[51,1,"あら"],[59,1,"いか"],[68,1,"と"],[70,1,"さ"],[80,2,"ふんげき"],[91,2,"ひとびと"],[94,1,"ほろ"]],"text":"「祭司アロンの子なるエレアザルの子ピネハスは自分のことのように、わたしの憤激をイスラエルの人々のうちに表わし、わたしの怒りをそのうちから取り去ったので、わたしは憤激して、イスラエルの人々を滅ぼすことをしなかった。"},{"ref":"Num.25.12","start":4025012,"end":4025012,"break":"none","ruby":[[9,1,"い"],[20,2,"へいわ"],[23,2,"けいやく"],[26,1,"かれ"],[28,1,"さづ"]],"text":"このゆえにあなたは言いなさい、『わたしは平和の契約を彼に授ける。"},{"ref":"Num.25.13","start":4025013,"end":4025013,"break":"none","ruby":[[3,1,"かれ"],[7,1,"のち"],[9,2,"しそん"],[12,2,"えいえん"],[15,2,"さいし"],[17,1,"しょく"],[19,2,"けいやく"],[29,1,"かれ"],[33,1,"かみ"],[38,2,"ねっしん"],[51,2,"ひとびと"],[57,1,"つみ"]],"text":"これは彼とその後の子孫に永遠の祭司職の契約となるであろう。彼はその神のために熱心であって、イスラエルの人々のために罪のあがないをしたからである』と」。"},{"ref":"Num.25.14","start":4025014,"end":4025014,"break":"paragraph","ruby":[[5,1,"おんな"],[7,1,"とも"],[9,1,"ころ"],[19,1,"ひと"],[21,1,"な"],[33,1,"こ"],[46,2,"いちぞく"]],"text":"ミデアンの女と共に殺されたイスラエルの人の名はジムリといい、サルの子で、シメオンびとのうちの一族のつかさであった。"},{"ref":"Num.25.15","start":4025015,"end":4025015,"break":"none","ruby":[[4,1,"ころ"],[13,1,"おんな"],[15,1,"な"],[27,1,"むすめ"],[41,1,"たみ"],[43,2,"いちぞく"]],"text":"またその殺されたミデアンの女の名はコズビといい、ツルの娘であった。ツルはミデアンの民の一族のかしらであった。"},{"ref":"Num.25.16","start":4025016,"end":4025016,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.25.17","start":4025017,"end":4025017,"break":"none","ruby":[[8,1,"う"],[10,1,"なや"]],"text":"「ミデアンびとを打ち悩ましなさい。"},{"ref":"Num.25.18","start":4025018,"end":4025018,"break":"none","ruby":[[0,1,"かれ"],[18,1,"なや"],[26,1,"こと"],[29,1,"かれ"],[32,2,"しまい"],[44,1,"むすめ"],[57,1,"こと"],[62,2,"えきびょう"],[65,1,"おこ"],[68,1,"ひ"],[70,1,"ころ"],[74,1,"おんな"],[76,1,"こと"],[89,1,"まど"]],"text":"彼らはたくらみをもって、あなたがたを悩まし、ペオルの事と、彼らの姉妹、ミデアンのつかさの娘コズビ、すなわちペオルの事により、疫病の起った日に殺された女の事とによって、あなたがたを惑わしたからである」。"}]