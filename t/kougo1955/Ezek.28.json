[{"ref":"Ezek.28.1","start":26028001,"end":26028001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.28.2","start":26028002,"end":26028002,"break":"none","breaks":[[26,"stanza"],[39,"line"],[68,"line"],[92,"line"]],"ruby":[[1,1,"ひと"],[3,1,"こ"],[9,1,"きみ"],[11,1,"い"],[14,1,"しゅ"],[17,1,"かみ"],[21,1,"い"],[30,1,"こころ"],[32,1,"たか"],[36,1,"い"],[44,1,"かみ"],[49,2,"かみがみ"],[52,1,"ざ"],[59,1,"うみ"],[61,1,"なか"],[76,2,"じぶん"],[79,1,"かみ"],[84,1,"かしこ"],[87,1,"おも"],[92,1,"ひと"],[98,1,"かみ"]],"text":"「人の子よ、ツロの君に言え、主なる神はこう言われる、あなたは心に高ぶって言う、『わたしは神である、神々の座にすわって、海の中にいる』と。しかし、あなたは自分を神のように賢いと思っても、人であって、神ではない。"},{"ref":"Ezek.28.3","start":26028003,"end":26028003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"み"],[14,1,"かしこ"],[21,2,"ひみつ"],[29,1,"かく"]],"text":"見よ、あなたはダニエルよりも賢く、すべての秘密もあなたには隠れていない。"},{"ref":"Ezek.28.4","start":26028004,"end":26028004,"break":"line","breaks":[[18,"line"]],"ruby":[[4,2,"ちえ"],[7,1,"さと"],[14,1,"とみ"],[16,1,"え"],[18,2,"きんぎん"],[21,1,"くら"]],"text":"あなたは知恵と悟りとによって富を得、金銀を倉にたくわえた。"},{"ref":"Ezek.28.5","start":26028005,"end":26028005,"break":"line","breaks":[[17,"line"],[26,"line"]],"ruby":[[4,1,"おお"],[8,2,"ぼうえき"],[11,2,"ちえ"],[21,1,"とみ"],[23,1,"ま"],[28,1,"とみ"],[37,1,"こころ"],[39,1,"たか"]],"text":"あなたは大いなる貿易の知恵によってあなたの富を増し、その富によってあなたの心は高ぶった。"},{"ref":"Ezek.28.6","start":26028006,"end":26028006,"break":"line","breaks":[[17,"line"]],"ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[21,2,"じぶん"],[24,1,"かみ"],[29,1,"かしこ"],[32,1,"おも"]],"text":"それゆえ、主なる神はこう言われる、あなたは自分を神のように賢いと思っているゆえ、"},{"ref":"Ezek.28.7","start":26028007,"end":26028007,"break":"line","breaks":[[23,"line"],[38,"line"],[49,"line"],[71,"line"]],"ruby":[[0,1,"み"],[13,2,"こくみん"],[16,1,"もっと"],[18,1,"おそ"],[23,3,"いほうじん"],[31,1,"せ"],[38,1,"かれ"],[45,1,"ぬ"],[53,2,"ちえ"],[59,1,"え"],[61,1,"うるわ"],[67,1,"む"],[75,1,"かがや"],[78,1,"けが"]],"text":"見よ、わたしは、もろもろの国民の最も恐れている異邦人をあなたに攻めこさせる。彼らはつるぎを抜いて、あなたが知恵をもって得た麗しいものに向かい、あなたの輝きを汚し、"},{"ref":"Ezek.28.8","start":26028008,"end":26028008,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"あな"],[6,1,"な"],[8,1,"い"],[16,1,"うみ"],[18,1,"なか"],[20,1,"ころ"],[24,1,"もの"],[29,1,"し"],[31,1,"と"]],"text":"あなたを穴に投げ入れる。あなたは海の中で殺された者のような死を遂げる。"},{"ref":"Ezek.28.9","start":26028009,"end":26028009,"break":"line","breaks":[[22,"line"],[43,"line"],[64,"line"]],"ruby":[[12,2,"じぶん"],[15,1,"かみ"],[26,1,"ころ"],[28,2,"ひとびと"],[31,1,"まえ"],[33,1,"い"],[47,2,"じぶん"],[50,1,"きず"],[54,1,"もの"],[56,1,"て"],[64,1,"ひと"],[70,1,"かみ"]],"text":"それでもなおあなたは、『自分は神である』と、あなたを殺す人々の前で言うことができるか。あなたは自分を傷つける者の手にかかっては、人であって、神ではないではないか。"},{"ref":"Ezek.28.10","start":26028010,"end":26028010,"break":"line","breaks":[[13,"line"],[28,"line"],[43,"line"]],"ruby":[[4,3,"いほうじん"],[8,1,"て"],[13,2,"かつれい"],[16,1,"う"],[20,1,"もの"],[22,1,"し"],[24,1,"と"],[35,1,"い"],[43,1,"しゅ"],[46,1,"かみ"],[48,1,"い"]],"text":"あなたは異邦人の手によって割礼を受けない者の死を遂げる。これはわたしが言うのであると、主なる神は言われる」。"},{"ref":"Ezek.28.11","start":26028011,"end":26028011,"break":"paragraph","ruby":[[2,1,"しゅ"],[4,2,"ことば"],[11,1,"のぞ"]],"text":"また主の言葉がわたしに臨んだ、"},{"ref":"Ezek.28.12","start":26028012,"end":26028012,"break":"none","breaks":[[42,"stanza"],[52,"line"]],"ruby":[[1,1,"ひと"],[3,1,"こ"],[9,1,"おう"],[14,1,"かな"],[18,1,"うた"],[27,1,"い"],[30,1,"しゅ"],[33,1,"かみ"],[37,1,"い"],[46,2,"ちえ"],[49,1,"み"],[52,1,"び"],[60,2,"かんぜん"],[63,1,"しるし"]],"text":"「人の子よ、ツロの王のために悲しみの歌をのべて、これに言え。主なる神はこう言われる、あなたは知恵に満ち、美のきわみである完全な印である。"},{"ref":"Ezek.28.13","start":26028013,"end":26028013,"break":"line","breaks":[[15,"line"],[35,"line"],[57,"line"],[66,"line"],[83,"line"],[103,"line"],[118,"line"]],"ruby":[[4,1,"かみ"],[6,1,"その"],[20,2,"ほうせき"],[39,1,"あか"],[44,2,"おうぎょく"],[47,2,"せいぎょく"],[50,1,"き"],[55,1,"せき"],[57,3,"りょくちゅうせき"],[61,1,"しま"],[75,1,"いし"],[90,2,"ぞうがん"],[93,2,"ちょうこく"],[96,1,"きん"],[111,1,"つく"],[115,1,"ひ"],[125,1,"そな"]],"text":"あなたは神の園エデンにあって、もろもろの宝石が、あなたをおおっていた。すなわち赤めのう、黄玉、青玉、貴かんらん石、緑柱石、縞めのう、サファイヤ、ざくろ石、エメラルド。そしてあなたの象眼も彫刻も金でなされた。これらはあなたの造られた日に、あなたのために備えられた。"},{"ref":"Ezek.28.14","start":26028014,"end":26028014,"break":"line","breaks":[[14,"line"],[28,"line"],[42,"line"]],"ruby":[[8,1,"あぶら"],[14,2,"しゅご"],[21,2,"いっしょ"],[24,1,"お"],[32,1,"かみ"],[34,1,"せい"],[37,1,"やま"],[42,1,"ひ"],[44,1,"いし"],[46,1,"あいだ"],[48,1,"ある"]],"text":"わたしはあなたを油そそがれた守護のケルブと一緒に置いた。あなたは神の聖なる山にいて、火の石の間を歩いた。"},{"ref":"Ezek.28.15","start":26028015,"end":26028015,"break":"line","breaks":[[12,"line"],[30,"line"]],"ruby":[[4,1,"つく"],[8,1,"ひ"],[16,1,"なか"],[18,1,"あく"],[20,1,"み"],[26,1,"ひ"],[37,2,"かんぜん"]],"text":"あなたは造られた日から、あなたの中に悪が見いだされた日まではそのおこないが完全であった。"},{"ref":"Ezek.28.16","start":26028016,"end":26028016,"break":"line","breaks":[[14,"line"],[37,"line"],[55,"line"],[68,"line"],[79,"line"]],"ruby":[[4,2,"しょうばい"],[7,1,"さか"],[18,1,"なか"],[20,2,"ぼうぎゃく"],[23,1,"み"],[31,1,"つみ"],[33,1,"おか"],[50,1,"かみ"],[52,1,"やま"],[55,1,"けが"],[63,1,"な"],[65,1,"だ"],[68,2,"しゅご"],[79,1,"ひ"],[81,1,"いし"],[83,1,"あいだ"],[86,1,"お"],[88,1,"だ"]],"text":"あなたの商売が盛んになると、あなたの中に暴虐が満ちて、あなたは罪を犯した。それゆえ、わたしはあなたを神の山から汚れたものとして投げ出し、守護のケルブはあなたを火の石の間から追い出した。"},{"ref":"Ezek.28.17","start":26028017,"end":26028017,"break":"line","breaks":[[19,"line"],[40,"line"],[55,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"うつく"],[14,1,"こころ"],[15,1,"たか"],[21,1,"かがや"],[27,2,"じぶん"],[30,2,"ちえ"],[33,1,"けが"],[48,1,"ち"],[50,1,"な"],[55,1,"おう"],[59,1,"まえ"],[61,1,"お"],[64,1,"み"],[66,1,"もの"]],"text":"あなたは自分の美しさのために心高ぶり、その輝きのために自分の知恵を汚したゆえに、わたしはあなたを地に投げうち、王たちの前に置いて見せ物とした。"},{"ref":"Ezek.28.18","start":26028018,"end":26028018,"break":"line","breaks":[[23,"line"],[36,"line"],[52,"line"],[59,"line"],[73,"line"]],"ruby":[[4,2,"ふせい"],[7,2,"こうえき"],[12,1,"おか"],[15,1,"おお"],[18,1,"つみ"],[27,2,"せいじょ"],[30,1,"けが"],[44,1,"なか"],[47,1,"ひ"],[49,1,"だ"],[56,1,"や"],[63,1,"み"],[69,1,"もの"],[71,1,"まえ"],[77,1,"ち"],[79,1,"うえ"],[81,1,"はい"]],"text":"あなたは不正な交易をして犯した多くの罪によってあなたの聖所を汚したゆえ、わたしはあなたの中から火を出してあなたを焼き、あなたを見るすべての者の前であなたを地の上の灰とした。"},{"ref":"Ezek.28.19","start":26028019,"end":26028019,"break":"line","breaks":[[19,"line"],[29,"line"],[43,"line"]],"ruby":[[5,1,"たみ"],[14,1,"し"],[16,1,"もの"],[18,1,"みな"],[26,1,"おどろ"],[33,1,"おそ"],[37,1,"おわ"],[40,1,"と"],[43,2,"えいえん"]],"text":"もろもろの民のうちであなたを知る者は皆あなたについて驚く。あなたは恐るべき終りを遂げ、永遠にうせはてる」。"},{"ref":"Ezek.28.20","start":26028020,"end":26028020,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.28.21","start":26028021,"end":26028021,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,1,"かお"],[16,1,"む"],[22,1,"む"],[26,2,"よげん"]],"text":"「人の子よ、あなたの顔をシドンに向け、これに向かって預言して、"},{"ref":"Ezek.28.22","start":26028022,"end":26028022,"break":"none","breaks":[[15,"stanza"],[36,"line"],[55,"line"],[75,"line"],[96,"line"]],"ruby":[[0,1,"い"],[3,1,"しゅ"],[6,1,"かみ"],[10,1,"い"],[20,1,"み"],[31,1,"てき"],[47,1,"さか"],[84,1,"せい"],[94,1,"とき"],[96,1,"かれ"],[103,1,"しゅ"],[110,1,"し"]],"text":"言え。主なる神はこう言われる、シドンよ、見よ、わたしはあなたの敵となる、わたしはあなたのうちで栄えをあらわす。わたしがシドンのうちにさばきをおこない、そのうちにわたしの聖なることをあらわす時、彼らはわたしが主であることを知る。"},{"ref":"Ezek.28.23","start":26028023,"end":26028023,"break":"line","breaks":[[13,"line"],[25,"line"],[43,"line"],[58,"line"]],"ruby":[[4,2,"えきびょう"],[10,1,"おく"],[19,2,"りゅうけつ"],[22,1,"おく"],[27,2,"しほう"],[34,1,"のぞ"],[43,1,"ころ"],[47,1,"もの"],[51,1,"なか"],[53,1,"たお"],[56,1,"とき"],[58,1,"かれ"],[65,1,"しゅ"],[72,1,"し"]],"text":"わたしは疫病をこれに送り、そのちまたに流血を送る。その四方からこれに臨むつるぎによって殺される者がその中に倒れる時、彼らはわたしが主であることを知る。"},{"ref":"Ezek.28.24","start":26028024,"end":26028024,"break":"paragraph","ruby":[[6,1,"いえ"],[13,1,"さ"],[25,1,"いや"],[31,2,"しゅうい"],[34,2,"ひとびと"],[42,1,"くる"],[58,1,"かれ"],[65,1,"しゅ"],[72,1,"し"]],"text":"イスラエルの家には、もはや刺すいばらはなく、これを卑しめたその周囲の人々のうちには、苦しめるとげもなくなる。こうして彼らはわたしが主であることを知るようになる。"},{"ref":"Ezek.28.25","start":26028025,"end":26028025,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[22,1,"いえ"],[24,1,"もの"],[29,1,"ち"],[39,1,"たみ"],[41,1,"なか"],[44,1,"あつ"],[52,2,"こくみん"],[55,1,"め"],[57,1,"まえ"],[60,1,"かれ"],[67,1,"せい"],[77,1,"とき"],[79,1,"かれ"],[96,1,"あた"],[99,1,"ち"],[101,1,"す"]],"text":"主なる神はこう言われる、わたしがイスラエルの家の者を、その散らされたもろもろの民の中から集め、もろもろの国民の目の前で、彼らにわたしの聖なることをあらわす時、彼らはわたしが、わがしもべヤコブに与えた地に住むようになる。"},{"ref":"Ezek.28.26","start":26028026,"end":26028026,"break":"none","ruby":[[0,1,"かれ"],[6,1,"やす"],[10,1,"す"],[13,1,"いえ"],[15,1,"た"],[23,1,"はたけ"],[25,1,"つく"],[31,1,"かれ"],[34,1,"いや"],[42,1,"とな"],[44,1,"びと"],[48,1,"たい"],[60,1,"おこな"],[62,1,"とき"],[64,1,"かれ"],[67,1,"やす"],[71,1,"す"],[78,1,"かれ"],[86,1,"かれ"],[89,1,"かみ"],[91,1,"しゅ"],[98,1,"し"]],"text":"彼らはそこに安らかに住み、家を建て、またぶどう畑を作る。かつて彼らを卑しめたすべての隣り人たちに対して、わたしがさばきを行う時、彼らは安らかに住む。こうして彼らは、わたしが彼らの神、主であることを知る」。"}]