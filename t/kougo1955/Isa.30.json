[{"ref":"Isa.30.1","start":23030001,"end":23030001,"break":"paragraph","breaks":[[7,"line"],[21,"line"],[36,"line"],[48,"line"],[61,"line"],[73,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"こ"],[21,1,"かれ"],[24,1,"はか"],[29,1,"おこな"],[48,1,"かれ"],[51,2,"どうめい"],[54,1,"むす"],[63,1,"れい"],[73,1,"つみ"],[75,1,"つみ"],[77,1,"くわ"]],"text":"主は言われる、「そむける子らはわざわいだ、彼らは計りごとを行うけれども、わたしによってではない。彼らは同盟を結ぶけれども、わが霊によってではない、罪に罪を加えるためだ。"},{"ref":"Isa.30.2","start":23030002,"end":23030002,"break":"line","breaks":[[12,"line"],[34,"line"]],"ruby":[[0,1,"かれ"],[5,2,"ことば"],[8,1,"もと"],[17,1,"くだ"],[27,2,"ほご"],[39,1,"かげ"],[41,1,"かく"]],"text":"彼らはわが言葉を求めず、エジプトへ下っていって、パロの保護にたより、エジプトの陰に隠れようとする。"},{"ref":"Isa.30.3","start":23030003,"end":23030003,"break":"line","breaks":[[11,"line"],[26,"line"],[39,"line"]],"ruby":[[8,2,"ほご"],[21,1,"はじ"],[31,1,"かげ"],[33,1,"かく"]],"text":"それゆえ、パロの保護はかえってあなたがたの恥となり、エジプトの陰に隠れることはあなたがたのはずかしめとなる。"},{"ref":"Isa.30.4","start":23030004,"end":23030004,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"かれ"],[6,1,"きみ"],[17,1,"かれ"],[19,2,"ししゃ"],[28,1,"き"]],"text":"たとい、彼の君たちがゾアンにあり、彼の使者たちがハネスに来ても、"},{"ref":"Isa.30.5","start":23030005,"end":23030005,"break":"line","breaks":[[23,"line"],[40,"line"],[63,"line"]],"ruby":[[0,1,"かれ"],[3,1,"みな"],[8,1,"えき"],[18,1,"たみ"],[27,1,"たす"],[34,1,"えき"],[44,1,"はじ"],[57,1,"たみ"],[63,1,"はじ"]],"text":"彼らは皆おのれを益することのできない民により、すなわち助けとならず、益とならず、かえって恥となり、はずかしめとなる民によって、恥をかくからである」。"},{"ref":"Isa.30.6","start":23030006,"end":23030006,"break":"paragraph","breaks":[[13,"line"],[31,"line"],[46,"line"],[70,"line"],[83,"line"]],"ruby":[[4,1,"けもの"],[10,2,"たくせん"],[13,1,"かれ"],[18,1,"とみ"],[20,1,"わか"],[25,1,"せ"],[27,1,"お"],[33,1,"たから"],[39,1,"せ"],[41,1,"お"],[46,1,"め"],[50,1,"お"],[60,1,"と"],[68,1,"で"],[70,1,"なや"],[73,1,"くる"],[77,1,"くに"],[79,1,"とお"],[87,1,"えき"],[97,1,"たみ"],[99,1,"い"]],"text":"ネゲブの獣についての託宣。彼らはその富を若いろばの背に負わせ、その宝をらくだの背に負わせて、雌じし、雄じし、まむしおよび飛びかけるへびの出る悩みと苦しみの国を通って、おのれを益することのできない民に行く。"},{"ref":"Isa.30.7","start":23030007,"end":23030007,"break":"line","breaks":[[22,"line"],[34,"line"]],"ruby":[[7,1,"たす"],[10,2,"むえき"],[35,1,"やす"],[45,1,"よ"]],"text":"そのエジプトの助けは無益であって、むなしい。それゆえ、わたしはこれを「休んでいるラハブ」と呼んだ。"},{"ref":"Isa.30.8","start":23030008,"end":23030008,"break":"paragraph","breaks":[[20,"line"],[26,"line"]],"ruby":[[2,1,"い"],[9,1,"かれ"],[12,1,"まえ"],[14,1,"ふだ"],[20,2,"しょもつ"],[23,1,"の"],[26,1,"のち"],[28,1,"よ"],[30,1,"つた"]],"text":"いま行って、これを彼らの前で札にしるし、書物に載せ、後の世に伝えて、とこしえにあかしとせよ。"},{"ref":"Isa.30.9","start":23030009,"end":23030009,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[7,1,"たみ"],[9,1,"いつわ"],[12,1,"い"],[14,1,"こ"],[17,1,"しゅ"],[19,1,"おしえ"],[21,1,"き"],[28,1,"こ"]],"text":"彼らはそむける民、偽りを言う子ら、主の教を聞こうとしない子らだ。"},{"ref":"Isa.30.10","start":23030010,"end":23030010,"break":"line","breaks":[[20,"line"],[29,"line"],[46,"line"]],"ruby":[[0,1,"かれ"],[3,3,"せんけんしゃ"],[12,1,"み"],[17,1,"い"],[20,3,"よげんしゃ"],[30,1,"ただ"],[33,1,"こと"],[40,2,"よげん"],[46,1,"みみ"],[48,1,"き"],[55,1,"かた"],[58,1,"まよ"],[64,2,"よげん"]],"text":"彼らは先見者にむかって「見るな」と言い、預言者にむかっては「正しい事をわれわれに預言するな、耳に聞きよいことを語れ、迷わしごとを預言せよ。"},{"ref":"Isa.30.11","start":23030011,"end":23030011,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"おおじ"],[3,1,"さ"],[6,2,"こうじ"],[19,2,"せいじゃ"],[25,1,"かた"],[27,1,"き"],[33,1,"い"]],"text":"大路を去り、小路をはなれ、イスラエルの聖者について語り聞かすな」と言う。"},{"ref":"Isa.30.12","start":23030012,"end":23030012,"break":"line","breaks":[[21,"line"],[36,"line"],[51,"line"]],"ruby":[[11,2,"せいじゃ"],[16,1,"い"],[30,2,"ことば"],[33,1,"あなど"],[48,1,"たの"]],"text":"それゆえ、イスラエルの聖者はこう言われる、「あなたがたはこの言葉を侮り、しえたげと、よこしまとを頼み、これにたよるがゆえに、"},{"ref":"Isa.30.13","start":23030013,"end":23030013,"break":"line","breaks":[[12,"line"],[33,"line"],[43,"line"]],"ruby":[[2,2,"ふぎ"],[12,1,"つ"],[14,1,"で"],[20,1,"お"],[27,1,"たか"],[29,1,"いし"],[33,1,"やぶ"],[45,2,"とうかい"],[59,1,"く"]],"text":"この不義はあなたがたには突き出て、くずれ落ちようとする高い石がきの破れのようであって、その倒壊はにわかに、またたくまに来る。"},{"ref":"Isa.30.14","start":23030014,"end":23030014,"break":"line","breaks":[[19,"line"],[31,"line"],[49,"line"],[68,"line"]],"ruby":[[2,1,"やぶ"],[8,2,"とうき"],[10,1,"し"],[12,1,"うつわ"],[14,1,"やぶ"],[19,1,"お"],[26,1,"う"],[28,1,"くだ"],[33,1,"くだ"],[41,1,"ろ"],[44,1,"ひ"],[46,1,"と"],[49,1,"いけ"],[52,1,"みず"],[68,1,"み"]],"text":"その破れることは陶器師の器を破るように惜しむことなく打ち砕き、その砕けのなかには、炉から火を取り、池から水をくめるほどの、ひとかけらさえ見いだされない」。"},{"ref":"Isa.30.15","start":23030015,"end":23030015,"break":"paragraph","breaks":[[21,"line"],[34,"line"],[48,"line"],[69,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[11,2,"せいじゃ"],[16,1,"い"],[28,1,"た"],[30,1,"かえ"],[34,1,"お"],[36,1,"つ"],[44,1,"すく"],[48,1,"おだ"],[54,2,"しんらい"],[63,1,"ちから"],[65,1,"え"],[81,1,"こと"],[83,1,"この"]],"text":"主なる神、イスラエルの聖者はこう言われた、「あなたがたは立ち返って、落ち着いているならば救われ、穏やかにして信頼しているならば力を得る」。しかし、あなたがたはこの事を好まなかった。"},{"ref":"Isa.30.16","start":23030016,"end":23030016,"break":"line","breaks":[[15,"line"],[38,"line"],[61,"line"],[76,"line"]],"ruby":[[11,1,"い"],[16,1,"いな"],[23,1,"うま"],[25,1,"の"],[32,1,"い"],[52,1,"かえ"],[57,1,"い"],[66,1,"はや"],[68,1,"うま"],[70,1,"の"],[87,1,"お"],[89,1,"もの"],[91,1,"はや"]],"text":"かえって、あなたがたは言った、「否、われわれは馬に乗って、とんで行こう」と。それゆえ、あなたがたはとんで帰る。また言った、「われらは速い馬に乗ろう」と。それゆえ、あなたがたを追う者は速い。"},{"ref":"Isa.30.17","start":23030017,"end":23030017,"break":"line","breaks":[[16,"line"],[35,"line"],[45,"line"],[59,"line"]],"ruby":[[4,2,"いかく"],[11,1,"にん"],[13,1,"に"],[17,1,"にん"],[19,2,"いかく"],[31,1,"に"],[37,1,"のこ"],[39,1,"もの"],[45,1,"やま"],[47,1,"いただき"],[51,1,"はた"],[59,1,"おか"],[61,1,"うえ"],[65,1,"はた"]],"text":"ひとりの威嚇によって千人は逃げ、五人の威嚇によってあなたがたは逃げて、その残る者はわずかに山の頂にある旗ざおのように、丘の上にある旗のようになる。"},{"ref":"Isa.30.18","start":23030018,"end":23030018,"break":"paragraph","breaks":[[13,"line"],[26,"line"],[40,"line"],[53,"line"],[67,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"ま"],[19,1,"めぐみ"],[21,1,"ほどこ"],[31,1,"しゅ"],[33,1,"た"],[53,1,"しゅ"],[55,2,"こうへい"],[58,1,"かみ"],[70,1,"しゅ"],[72,1,"ま"],[74,1,"のぞ"],[76,1,"もの"]],"text":"それゆえ、主は待っていて、あなたがたに恵を施される。それゆえ、主は立ちあがって、あなたがたをあわれまれる。主は公平の神でいらせられる。すべて主を待ち望む者はさいわいである。"},{"ref":"Isa.30.19","start":23030019,"end":23030019,"break":"paragraph","ruby":[[13,1,"す"],[15,1,"たみ"],[25,1,"な"],[33,1,"しゅ"],[39,1,"よ"],[43,1,"こえ"],[45,1,"おう"],[49,1,"かなら"],[55,1,"めぐ"],[58,1,"ほどこ"],[63,1,"しゅ"],[68,1,"き"],[75,1,"ただ"],[78,1,"こた"]],"text":"シオンにおり、エルサレムに住む民よ、あなたはもはや泣くことはない。主はあなたの呼ばわる声に応じて、必ずあなたに恵みを施される。主がそれを聞かれるとき、直ちに答えられる。"},{"ref":"Isa.30.20","start":23030020,"end":23030020,"break":"none","ruby":[[3,1,"しゅ"],[11,1,"なや"],[17,1,"くる"],[21,1,"みず"],[23,1,"あた"],[34,1,"し"],[36,1,"ふたた"],[38,1,"かく"],[51,1,"め"],[57,1,"し"],[59,1,"み"]],"text":"たとい主はあなたがたに悩みのパンと苦しみの水を与えられても、あなたの師は再び隠れることはなく、あなたの目はあなたの師を見る。"},{"ref":"Isa.30.21","start":23030021,"end":23030021,"break":"none","ruby":[[7,1,"みぎ"],[9,1,"い"],[16,1,"ひだり"],[18,1,"い"],[20,1,"とき"],[32,1,"みち"],[38,1,"あゆ"],[42,1,"い"],[44,2,"ことば"],[47,1,"みみ"],[49,1,"き"]],"text":"また、あなたが右に行き、あるいは左に行く時、そのうしろで「これは道だ、これに歩め」と言う言葉を耳に聞く。"},{"ref":"Isa.30.22","start":23030022,"end":23030022,"break":"none","ruby":[[2,1,"とき"],[19,1,"きざ"],[22,1,"ぞう"],[29,1,"は"],[32,1,"い"],[34,1,"ぞう"],[37,1,"けが"],[47,1,"もの"],[54,1,"ち"],[63,1,"さ"],[67,1,"い"]],"text":"その時、あなたがたはしろがねをおおった刻んだ像と、こがねを張った鋳た像とを汚し、これをきたない物のようにまき散らして、これに「去れ」と言う。"},{"ref":"Isa.30.23","start":23030023,"end":23030023,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"ち"],[10,1,"たね"],[12,1,"あめ"],[14,1,"あた"],[17,1,"ち"],[19,2,"さんぶつ"],[23,2,"こくもつ"],[43,1,"ゆた"],[51,1,"ひ"],[56,2,"かちく"],[59,1,"ひろ"],[61,2,"まきば"],[64,1,"くさ"],[66,1,"た"]],"text":"主はあなたが地にまく種に雨を与え、地の産物なる穀物をくださる。それはおびただしく、かつ豊かである。その日あなたの家畜は広い牧場で草を食べ、"},{"ref":"Isa.30.24","start":23030024,"end":23030024,"break":"none","ruby":[[0,1,"ち"],[2,1,"たがや"],[4,1,"うし"],[23,1,"わ"],[26,1,"しお"],[28,1,"くわ"],[31,2,"しりょう"],[34,1,"た"]],"text":"地を耕す牛と、ろばは、シャベルと、くまででより分けて塩を加えた飼料を食べる。"},{"ref":"Isa.30.25","start":23030025,"end":23030025,"break":"none","ruby":[[0,1,"おお"],[4,2,"ぎゃくさつ"],[7,1,"ひ"],[13,1,"たお"],[16,1,"とき"],[27,1,"やま"],[34,1,"たか"],[36,1,"おか"],[38,1,"みず"],[40,1,"なが"],[43,1,"かわ"]],"text":"大いなる虐殺の日、やぐらの倒れる時、すべてのそびえたつ山と、すべての高い丘に水の流れる川がある。"},{"ref":"Isa.30.26","start":23030026,"end":23030026,"break":"none","ruby":[[3,1,"しゅ"],[7,1,"たみ"],[9,1,"きず"],[11,1,"つつ"],[16,1,"う"],[20,1,"きず"],[27,1,"ひ"],[31,1,"つき"],[33,1,"ひかり"],[35,1,"ひ"],[37,1,"ひかり"],[45,1,"ひ"],[47,1,"ひかり"],[50,1,"ばい"],[58,1,"ひ"],[60,1,"ひかり"]],"text":"さらに主がその民の傷を包み、その打たれた傷をいやされる日には、月の光は日の光のようになり、日の光は七倍となり、七つの日の光のようにになる。"},{"ref":"Isa.30.27","start":23030027,"end":23030027,"break":"paragraph","breaks":[[12,"line"],[34,"line"],[47,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,1,"な"],[7,1,"とお"],[9,1,"ところ"],[12,1,"も"],[15,1,"いか"],[19,1,"た"],[24,1,"こ"],[26,1,"けむり"],[31,1,"く"],[41,1,"いきどお"],[44,1,"み"],[49,1,"した"],[51,1,"や"],[56,1,"ひ"]],"text":"見よ、主の名は遠い所から燃える怒りと、立ちあがる濃い煙をもって来る。そのくちびるは憤りで満ち、その舌は焼きつくす火のごとく、"},{"ref":"Isa.30.28","start":23030028,"end":23030028,"break":"line","breaks":[[15,"line"],[25,"line"],[46,"line"],[54,"line"]],"ruby":[[2,1,"いき"],[8,1,"くび"],[12,1,"たっ"],[15,1,"なが"],[25,1,"ほろ"],[40,1,"くに"],[48,1,"まど"],[51,2,"たづな"],[59,1,"たみ"],[70,1,"く"]],"text":"その息はあふれて首にまで達する流れのようであって、滅びのふるいをもってもろもろの国をふるい、また惑わす手綱をもろもろの民のあごにつけるために来る。"},{"ref":"Isa.30.29","start":23030029,"end":23030029,"break":"paragraph","ruby":[[7,1,"せい"],[10,1,"まつり"],[12,1,"まも"],[14,1,"よる"],[19,1,"うた"],[27,1,"ふえ"],[33,1,"しゅ"],[35,1,"やま"],[47,1,"いわ"],[50,1,"しゅ"],[56,1,"とき"],[61,1,"こころ"],[63,1,"よろこ"]],"text":"あなたがたは、聖なる祭を守る夜のように歌をうたう。また笛をならして主の山にきたり、イスラエルの岩なる主にまみえる時のように心に喜ぶ。"},{"ref":"Isa.30.30","start":23030030,"end":23030030,"break":"none","ruby":[[0,1,"しゅ"],[4,2,"いげん"],[8,1,"こえ"],[10,1,"き"],[14,1,"はげ"],[17,1,"いか"],[21,1,"や"],[26,1,"ひ"],[28,1,"ほのお"],[31,2,"ごうう"],[35,2,"ぼうふう"],[49,1,"うで"],[51,1,"くだ"],[56,1,"しめ"]],"text":"主はその威厳ある声を聞かせ、激しい怒りと、焼きつくす火の炎と、豪雨と、暴風と、ひょうとをもってその腕の下ることを示される。"},{"ref":"Isa.30.31","start":23030031,"end":23030031,"break":"none","ruby":[[0,1,"しゅ"],[10,1,"う"],[14,1,"とき"],[22,2,"ひとびと"],[25,1,"しゅ"],[27,1,"こえ"],[32,1,"おそ"]],"text":"主がそのむちをもって打たれる時、アッスリヤの人々は主の声によって恐れおののく。"},{"ref":"Isa.30.32","start":23030032,"end":23030032,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"こら"],[9,1,"かれ"],[12,1,"うえ"],[14,1,"くわ"],[22,1,"つづみ"],[24,1,"な"],[28,1,"こと"],[33,1,"しゅ"],[35,1,"うで"],[37,1,"ふ"],[44,1,"かれ"],[47,1,"たたか"]],"text":"主が懲しめのつえを彼らの上に加えられるごとに鼓を鳴らし、琴をひく。主は腕を振りかざして、彼らと戦われる。"},{"ref":"Isa.30.33","start":23030033,"end":23030033,"break":"none","ruby":[[0,1,"や"],[2,1,"ば"],[7,1,"もう"],[16,1,"おう"],[21,1,"ふか"],[23,1,"ひろ"],[25,1,"そな"],[30,1,"ひ"],[32,1,"おお"],[39,1,"つ"],[46,1,"しゅ"],[48,1,"いき"],[53,2,"いおう"],[56,1,"なが"],[62,1,"も"]],"text":"焼き場はすでに設けられた。しかも王のために深く広く備えられ、火と多くのたきぎが積まれてある。主の息はこれを硫黄の流れのように燃やす。"}]