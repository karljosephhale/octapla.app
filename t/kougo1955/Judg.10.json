[{"ref":"Judg.10.1","start":7010001,"end":7010001,"break":"paragraph","ruby":[[6,1,"のち"],[14,1,"ひと"],[20,1,"こ"],[27,1,"こ"],[31,1,"た"],[40,1,"すく"],[44,1,"かれ"],[52,2,"さんち"],[60,1,"す"]],"text":"アビメレクの後、イッサカルの人で、ドドの子であるプワの子トラが起ってイスラエルを救った。彼はエフライムの山地のシャミルに住み、"},{"ref":"Judg.10.2","start":7010002,"end":7010002,"break":"none","ruby":[[3,1,"ねん"],[5,1,"あいだ"],[21,1,"し"],[29,1,"ほうむ"]],"text":"二十三年の間イスラエルをさばいたが、ついに死んでシャミルに葬られた。"},{"ref":"Judg.10.3","start":7010003,"end":7010003,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"のち"],[14,1,"た"],[20,1,"ねん"],[22,1,"あいだ"]],"text":"彼の後にギレアデびとヤイルが起って二十二年の間イスラエルをさばいた。"},{"ref":"Judg.10.4","start":7010004,"end":7010004,"break":"none","ruby":[[0,1,"かれ"],[4,1,"にん"],[6,1,"こ"],[12,1,"かれ"],[17,1,"とう"],[22,1,"の"],[30,1,"まち"],[43,1,"ち"],[45,2,"こんにち"],[58,1,"よ"]],"text":"彼に三十人の子があった。彼らは三十頭のろばに乗り、また三十の町をもっていた。ギレアデの地で今日まで、ハボテ・ヤイルと呼ばれているものがそれである。"},{"ref":"Judg.10.5","start":7010005,"end":7010005,"break":"none","ruby":[[4,1,"し"],[12,1,"ほうむ"]],"text":"ヤイルは死んで、カモンに葬られた。"},{"ref":"Judg.10.6","start":7010006,"end":7010006,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"ふたた"],[11,1,"しゅ"],[13,1,"まえ"],[15,1,"あく"],[17,1,"おこな"],[36,2,"かみがみ"],[43,2,"かみがみ"],[50,2,"かみがみ"],[60,2,"かみがみ"],[70,2,"かみがみ"],[73,1,"つか"],[76,1,"しゅ"],[78,1,"す"],[84,1,"つか"]],"text":"イスラエルの人々は再び主の前に悪を行い、バアルとアシタロテおよびスリヤの神々、シドンの神々、モアブの神々、アンモンびとの神々、ペリシテびとの神々に仕え、主を捨ててこれに仕えなかった。"},{"ref":"Judg.10.7","start":7010007,"end":7010007,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"たい"],[11,1,"いか"],[14,1,"はっ"],[17,1,"かれ"],[27,1,"て"],[38,1,"て"],[40,1,"う"]],"text":"主はイスラエルに対して怒りを発し、彼らをペリシテびとの手およびアンモンびとの手に売りわたされたので、"},{"ref":"Judg.10.8","start":7010008,"end":7010008,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ねん"],[12,2,"ひとびと"],[19,1,"なや"],[28,1,"かれ"],[36,1,"む"],[53,1,"ち"],[71,1,"ねん"],[76,1,"なや"]],"text":"彼らはその年イスラエルの人々をしえたげ悩ました。すなわち彼らはヨルダンの向こうのギレアデにあるアモリびとの地にいたすべてのイスラエルびとを十八年のあいだ悩ました。"},{"ref":"Judg.10.9","start":7010009,"end":7010009,"break":"none","ruby":[[7,2,"ひとびと"],[25,2,"しぞく"],[28,1,"せ"],[39,1,"わた"],[53,2,"ひじょう"],[56,1,"なや"]],"text":"またアンモンの人々がユダとベニヤミンとエフライムの氏族を攻めるためにヨルダンを渡ってきたので、イスラエルは非常に悩まされた。"},{"ref":"Judg.10.10","start":7010010,"end":7010010,"break":"paragraph","ruby":[[9,2,"ひとびと"],[12,1,"しゅ"],[14,1,"よ"],[19,1,"い"],[36,1,"かみ"],[38,1,"す"],[45,1,"つか"],[52,1,"つみ"],[54,1,"おか"]],"text":"そこでイスラエルの人々は主に呼ばわって言った、「わたしたちはわたしたちの神を捨ててバアルに仕え、あなたに罪を犯しました」。"},{"ref":"Judg.10.11","start":7010011,"end":7010011,"break":"none","ruby":[[0,1,"しゅ"],[8,2,"ひとびと"],[11,1,"い"],[58,1,"すく"],[60,1,"だ"]],"text":"主はイスラエルの人々に言われた、「わたしはかつてエジプトびと、アモリびと、アンモンびと、ペリシテびとからあなたがたを救い出したではないか。"},{"ref":"Judg.10.12","start":7010012,"end":7010012,"break":"none","ruby":[[34,1,"とき"],[40,1,"よ"],[54,1,"かれ"],[57,1,"て"],[60,1,"すく"],[62,1,"だ"]],"text":"またシドンびと、アマレクびとおよびマオンびとがあなたがたをしえたげた時、わたしに呼ばわったので、あなたがたを彼らの手から救い出した。"},{"ref":"Judg.10.13","start":7010013,"end":7010013,"break":"none","ruby":[[13,1,"す"],[20,2,"かみがみ"],[23,1,"つか"],[46,1,"すく"]],"text":"しかしあなたがたはわたしを捨てて、ほかの神々に仕えた。それゆえ、わたしはかさねてあなたがたを救わないであろう。"},{"ref":"Judg.10.14","start":7010014,"end":7010014,"break":"none","ruby":[[6,1,"えら"],[9,2,"かみがみ"],[12,1,"い"],[15,1,"よ"],[26,1,"なや"],[29,1,"とき"],[31,1,"かれ"],[40,1,"すく"]],"text":"あなたがたが選んだ神々に行って呼ばわり、あなたがたの悩みの時、彼らにあなたがたを救わせるがよい」。"},{"ref":"Judg.10.15","start":7010015,"end":7010015,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"しゅ"],[11,1,"い"],[22,1,"つみ"],[24,1,"おか"],[38,1,"よ"],[41,1,"おも"],[71,1,"すく"]],"text":"イスラエルの人々は主に言った、「わたしたちは罪を犯しました。なんでもあなたが良いと思われることをしてください。ただどうぞ、きょう、わたしたちを救ってください」。"},{"ref":"Judg.10.16","start":7010016,"end":7010016,"break":"none","ruby":[[4,1,"かれ"],[7,2,"じぶん"],[16,1,"こと"],[19,2,"かみがみ"],[22,1,"と"],[24,1,"のぞ"],[28,1,"しゅ"],[30,1,"つか"],[37,1,"しゅ"],[39,1,"こころ"],[47,1,"なや"],[50,1,"み"],[53,1,"しの"]],"text":"そうして彼らは自分たちのうちから異なる神々を取り除いて、主に仕えた。それで主の心はイスラエルの悩みを見るに忍びなくなった。"},{"ref":"Judg.10.17","start":7010017,"end":7010017,"break":"paragraph","ruby":[[0,1,"とき"],[7,2,"ひとびと"],[10,2,"しょうしゅう"],[20,1,"じん"],[22,1,"と"],[33,2,"ひとびと"],[36,1,"あつ"],[44,1,"じん"],[46,1,"と"]],"text":"時にアンモンの人々は召集されてギレアデに陣を取ったが、イスラエルの人々は集まってミヅパに陣を取った。"},{"ref":"Judg.10.18","start":7010018,"end":7010018,"break":"none","ruby":[[2,1,"とき"],[4,1,"たみ"],[11,1,"きみ"],[16,1,"たがい"],[18,1,"い"],[31,2,"ひとびと"],[34,1,"む"],[38,1,"たたか"],[41,1,"はじ"],[48,1,"ひと"],[59,1,"たみ"]],"text":"その時、民とギレアデの君たちとは互に言った、「だれがアンモンの人々に向かって戦いを始めるか。その人はギレアデのすべての民のかしらとなるであろう」。"}]