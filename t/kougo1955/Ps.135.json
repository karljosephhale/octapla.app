[{"ref":"Ps.135.1","start":19135001,"end":19135001,"break":"paragraph","breaks":[[9,"line"],[21,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"しゅ"],[12,1,"な"],[21,1,"しゅ"]],"text":"主をほめたたえよ、主のみ名をほめたたえよ。主のしもべたちよ、ほめたたえよ。"},{"ref":"Ps.135.2","start":19135002,"end":19135002,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"いえ"],[4,1,"た"],[6,1,"もの"],[12,1,"かみ"],[14,1,"いえ"],[16,2,"おおにわ"],[19,1,"た"],[21,1,"もの"]],"text":"主の家に立つ者、われらの神の家の大庭に立つ者よ、ほめたたえよ。"},{"ref":"Ps.135.3","start":19135003,"end":19135003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"めぐ"],[8,1,"しゅ"],[17,1,"しゅ"],[19,1,"じょう"],[27,1,"な"],[31,1,"うた"]],"text":"主は恵みふかい、主をほめたたえよ。主は情ぶかい、そのみ名をほめ歌え。"},{"ref":"Ps.135.4","start":19135004,"end":19135004,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[12,1,"えら"],[21,1,"えら"],[29,2,"しょゆう"]],"text":"主はおのがためにヤコブを選び、イスラエルを選んで、おのれの所有とされた。"},{"ref":"Ps.135.5","start":19135005,"end":19135005,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"おお"],[18,1,"しゅ"],[24,1,"かみ"],[33,1,"し"]],"text":"わたしは主の大いなることと、われらの主のすべての神にまさることとを知っている。"},{"ref":"Ps.135.6","start":19135006,"end":19135006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[12,1,"こと"],[15,1,"てん"],[18,1,"ち"],[22,1,"うみ"],[29,1,"ふち"],[32,1,"おこな"]],"text":"主はそのみこころにかなう事を、天にも地にも、海にもすべての淵にも行われる。"},{"ref":"Ps.135.7","start":19135007,"end":19135007,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ち"],[8,1,"くも"],[15,1,"あめ"],[25,1,"つく"],[30,1,"くら"],[33,1,"かぜ"],[35,1,"だ"]],"text":"主は地のはてから雲をのぼらせ、雨のためにいなずまを造り、その倉から風を出される。"},{"ref":"Ps.135.8","start":19135008,"end":19135008,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ひと"],[5,1,"けもの"],[22,1,"う"]],"text":"主は人から獣にいたるまで、エジプトのういごを撃たれた。"},{"ref":"Ps.135.9","start":19135009,"end":19135009,"break":"line","breaks":[[15,"line"],[28,"line"]],"ruby":[[6,1,"しゅ"],[12,1,"なか"],[19,3,"ふしぎ"],[24,1,"おく"],[42,1,"のぞ"]],"text":"エジプトよ、主はおまえの中に、しるしと不思議とを送って、パロとそのすべてのしもべとに臨まれた。"},{"ref":"Ps.135.10","start":19135010,"end":19135010,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おお"],[5,2,"くにたみ"],[8,1,"う"],[11,1,"ちから"],[14,1,"おう"],[18,1,"ころ"]],"text":"主は多くの国民を撃ち、力ある王たちを殺された。"},{"ref":"Ps.135.11","start":19135011,"end":19135011,"break":"line","breaks":[[24,"line"]],"ruby":[[10,1,"おう"],[20,1,"おう"],[36,2,"くにぐに"]],"text":"すなわちアモリびとの王シホン、バシャンの王オグ、ならびにカナンのすべての国々である。"},{"ref":"Ps.135.12","start":19135012,"end":19135012,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"ち"],[7,1,"し"],[8,1,"ぎょう"],[14,1,"たみ"],[21,1,"し"],[22,1,"ぎょう"],[26,1,"あた"]],"text":"主は彼らの地を嗣業とし、その民イスラエルに嗣業として与えられた。"},{"ref":"Ps.135.13","start":19135013,"end":19135013,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"な"],[15,1,"た"],[24,1,"しゅ"],[31,2,"めいせい"],[39,1,"およ"]],"text":"主よ、あなたのみ名はとこしえに絶えることがない。主よ、あなたの名声はよろずよに及ぶ。"},{"ref":"Ps.135.14","start":19135014,"end":19135014,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"たみ"]],"text":"主はその民をさばき、そのしもべらにあわれみをかけられるからである。"},{"ref":"Ps.135.15","start":19135015,"end":19135015,"break":"line","breaks":[[22,"line"]],"ruby":[[5,2,"くにたみ"],[8,2,"ぐうぞう"],[22,1,"ひと"],[24,1,"て"]],"text":"もろもろの国民の偶像はしろがねと、こがねで、人の手のわざである。"},{"ref":"Ps.135.16","start":19135016,"end":19135016,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"くち"],[9,1,"かた"],[19,1,"め"],[25,1,"み"]],"text":"それは口があっても語ることができない。目があっても見ることができない。"},{"ref":"Ps.135.17","start":19135017,"end":19135017,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"みみ"],[6,1,"き"],[20,1,"くち"],[23,1,"いき"]],"text":"耳があっても聞くことができない。またその口には息がない。"},{"ref":"Ps.135.18","start":19135018,"end":19135018,"break":"line","breaks":[[21,"line"]],"ruby":[[3,1,"つく"],[5,1,"もの"],[11,2,"しんらい"],[15,1,"もの"],[24,1,"ひと"],[27,1,"もの"]],"text":"これを造る者と、これに信頼する者とはみな、これと等しい者になる。"},{"ref":"Ps.135.19","start":19135019,"end":19135019,"break":"line","breaks":[[15,"line"]],"ruby":[[6,1,"いえ"],[9,1,"しゅ"],[19,1,"いえ"],[22,1,"しゅ"]],"text":"イスラエルの家よ、主をほめよ。アロンの家よ、主をほめよ。"},{"ref":"Ps.135.20","start":19135020,"end":19135020,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"いえ"],[6,1,"しゅ"],[12,1,"しゅ"],[14,1,"おそ"],[17,1,"もの"],[20,1,"しゅ"]],"text":"レビの家よ、主をほめよ。主を恐れる者よ、主をほめまつれ。"},{"ref":"Ps.135.21","start":19135021,"end":19135021,"break":"line","breaks":[[14,"line"],[32,"line"]],"ruby":[[6,1,"す"],[11,1,"しゅ"],[32,1,"しゅ"]],"text":"エルサレムに住まわれる主は、シオンからほめたたえらるべきである。主をほめたたえよ。"}]