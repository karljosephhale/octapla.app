[{"ref":"Luke.13.1","start":42013001,"end":42013001,"break":"paragraph","ruby":[[6,1,"とき"],[10,2,"ひとびと"],[24,1,"びと"],[28,1,"ち"],[30,1,"なが"],[36,1,"かれ"],[39,2,"ぎせい"],[42,1,"ち"],[44,1,"ま"],[55,1,"し"]],"text":"ちょうどその時、ある人々がきて、ピラトがガリラヤ人たちの血を流し、それを彼らの犠牲の血に混ぜたことを、イエスに知らせた。"},{"ref":"Luke.13.2","start":42013002,"end":42013002,"break":"none","ruby":[[7,1,"こた"],[10,1,"い"],[24,1,"びと"],[32,2,"さいなん"],[45,1,"た"],[55,1,"びと"],[56,2,"いじょう"],[59,1,"つみ"],[61,1,"ふか"],[66,1,"おも"]],"text":"そこでイエスは答えて言われた、「それらのガリラヤ人が、そのような災難にあったからといって、他のすべてのガリラヤ人以上に罪が深かったと思うのか。"},{"ref":"Luke.13.3","start":42013003,"end":42013003,"break":"none","ruby":[[6,1,"い"],[23,1,"く"],[25,1,"あらた"],[34,1,"おな"],[39,1,"ほろ"]],"text":"あなたがたに言うが、そうではない。あなたがたも悔い改めなければ、みな同じように滅びるであろう。"},{"ref":"Luke.13.4","start":42013004,"end":42013004,"break":"none","ruby":[[8,1,"とう"],[10,1,"たお"],[18,1,"ころ"],[26,1,"にん"],[35,1,"た"],[37,1,"ぜん"],[38,2,"じゅうみん"],[40,2,"いじょう"],[43,1,"つみ"],[45,2,"ふさい"],[52,1,"おも"]],"text":"また、シロアムの塔が倒れたためにおし殺されたあの十八人は、エルサレムの他の全住民以上に罪の負債があったと思うか。"},{"ref":"Luke.13.5","start":42013005,"end":42013005,"break":"none","ruby":[[6,1,"い"],[23,1,"く"],[25,1,"あらた"],[34,1,"おな"],[39,1,"ほろ"]],"text":"あなたがたに言うが、そうではない。あなたがたも悔い改めなければ、みな同じように滅びるであろう」。"},{"ref":"Luke.13.6","start":42013006,"end":42013006,"break":"paragraph","ruby":[[7,1,"たとえ"],[9,1,"かた"],[17,1,"ひと"],[19,2,"じぶん"],[25,1,"えん"],[32,1,"き"],[34,1,"う"],[37,1,"お"],[43,1,"み"],[45,1,"さが"],[51,1,"み"]],"text":"それから、この譬を語られた、「ある人が自分のぶどう園にいちじくの木を植えて置いたので、実を捜しにきたが見つからなかった。"},{"ref":"Luke.13.7","start":42013007,"end":42013007,"break":"none","ruby":[[3,2,"えんてい"],[6,1,"い"],[16,2,"ねんかん"],[19,1,"み"],[21,1,"もと"],[32,1,"き"],[48,1,"み"],[57,1,"き"],[59,1,"き"],[61,1,"たお"],[75,2,"とち"],[86,1,"お"]],"text":"そこで園丁に言った、『わたしは三年間も実を求めて、このいちじくの木のところにきたのだが、いまだに見あたらない。その木を切り倒してしまえ。なんのために、土地をむだにふさがせて置くのか』。"},{"ref":"Luke.13.8","start":42013008,"end":42013008,"break":"none","ruby":[[3,2,"えんてい"],[6,1,"こた"],[9,1,"い"],[15,3,"しゅじんさま"],[31,1,"お"],[45,1,"ほ"],[48,2,"ひりょう"],[54,1,"み"]],"text":"すると園丁は答えて言った、『ご主人様、ことしも、そのままにして置いてください。そのまわりを掘って肥料をやって見ますから。"},{"ref":"Luke.13.9","start":42013009,"end":42013009,"break":"none","ruby":[[3,2,"らいねん"],[5,1,"み"],[13,2,"けっこう"],[31,1,"き"],[33,1,"たお"]],"text":"それで来年実がなりましたら結構です。もしそれでもだめでしたら、切り倒してください』」。"},{"ref":"Luke.13.10","start":42013010,"end":42013010,"break":"paragraph","ruby":[[0,3,"あんそくにち"],[7,2,"かいどう"],[10,1,"おし"]],"text":"安息日に、ある会堂で教えておられると、"},{"ref":"Luke.13.11","start":42013011,"end":42013011,"break":"none","ruby":[[5,2,"ねんかん"],[8,2,"びょうき"],[11,1,"れい"],[29,1,"の"],[35,1,"まった"],[41,1,"おんな"]],"text":"そこに十八年間も病気の霊につかれ、かがんだままで、からだを伸ばすことの全くできない女がいた。"},{"ref":"Luke.13.12","start":42013012,"end":42013012,"break":"none","ruby":[[6,1,"おんな"],[8,1,"み"],[11,1,"よ"],[17,1,"おんな"],[24,2,"びょうき"],[33,1,"い"]],"text":"イエスはこの女を見て、呼びよせ、「女よ、あなたの病気はなおった」と言って、"},{"ref":"Luke.13.13","start":42013013,"end":42013013,"break":"none","ruby":[[0,1,"て"],[4,1,"うえ"],[6,1,"お"],[14,1,"た"],[38,1,"かみ"]],"text":"手をその上に置かれた。すると立ちどころに、そのからだがまっすぐになり、そして神をたたえはじめた。"},{"ref":"Luke.13.14","start":42013014,"end":42013014,"break":"none","ruby":[[4,3,"かいどうづかさ"],[13,3,"あんそくにち"],[17,2,"びょうき"],[28,1,"いきどお"],[31,2,"ぐんしゅう"],[38,1,"い"],[43,1,"はたら"],[47,1,"ひ"],[49,2,"むいか"],[56,1,"あいだ"],[72,3,"あんそくにち"]],"text":"ところが会堂司は、イエスが安息日に病気をいやされたことを憤り、群衆にむかって言った、「働くべき日は六日ある。その間に、なおしてもらいにきなさい。安息日にはいけない」。"},{"ref":"Luke.13.15","start":42013015,"end":42013015,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"こた"],[8,1,"い"],[14,3,"ぎぜんしゃ"],[32,3,"あんそくにち"],[41,2,"じぶん"],[44,1,"うし"],[49,2,"かちく"],[51,2,"こや"],[55,1,"と"],[59,1,"みず"],[61,1,"の"],[65,1,"ひ"],[67,1,"だ"]],"text":"主はこれに答えて言われた、「偽善者たちよ、あなたがたはだれでも、安息日であっても、自分の牛やろばを家畜小屋から解いて、水を飲ませに引き出してやるではないか。"},{"ref":"Luke.13.16","start":42013016,"end":42013016,"break":"none","ruby":[[7,2,"ねんかん"],[14,1,"しば"],[27,1,"むすめ"],[33,1,"おんな"],[36,3,"あんそくにち"],[47,2,"そくばく"],[51,1,"と"]],"text":"それなら、十八年間もサタンに縛られていた、アブラハムの娘であるこの女を、安息日であっても、その束縛から解いてやるべきではなかったか」。"},{"ref":"Luke.13.17","start":42013017,"end":42013017,"break":"none","ruby":[[2,1,"い"],[13,2,"はんたい"],[19,1,"ひと"],[25,1,"は"],[27,1,"い"],[34,2,"ぐんしゅう"],[63,1,"み"],[65,1,"よろこ"]],"text":"こう言われたので、イエスに反対していた人たちはみな恥じ入った。そして群衆はこぞって、イエスがなされたすべてのすばらしいみわざを見て喜んだ。"},{"ref":"Luke.13.18","start":42013018,"end":42013018,"break":"paragraph","ruby":[[3,1,"い"],[9,1,"かみ"],[11,1,"くに"],[13,1,"なに"],[15,1,"に"],[26,1,"なに"]],"text":"そこで言われた、「神の国は何に似ているか。またそれを何にたとえようか。"},{"ref":"Luke.13.19","start":42013019,"end":42013019,"break":"none","ruby":[[1,1,"つぶ"],[6,1,"だね"],[19,1,"ひと"],[24,1,"と"],[27,1,"にわ"],[33,1,"そだ"],[36,1,"き"],[41,1,"そら"],[43,1,"とり"],[47,1,"えだ"],[49,1,"やど"]],"text":"一粒のからし種のようなものである。ある人がそれを取って庭にまくと、育って木となり、空の鳥もその枝に宿るようになる」。"},{"ref":"Luke.13.20","start":42013020,"end":42013020,"break":"none","ruby":[[2,1,"い"],[8,1,"かみ"],[10,1,"くに"],[12,1,"なに"]],"text":"また言われた、「神の国を何にたとえようか。"},{"ref":"Luke.13.21","start":42013021,"end":42013021,"break":"none","ruby":[[2,1,"だね"],[13,1,"おんな"],[18,1,"と"],[22,1,"と"],[24,1,"こな"],[26,1,"なか"],[28,1,"ま"],[33,2,"ぜんたい"]],"text":"パン種のようなものである。女がそれを取って三斗の粉の中に混ぜると、全体がふくらんでくる」。"},{"ref":"Luke.13.22","start":42013022,"end":42013022,"break":"paragraph","ruby":[[6,1,"おし"],[11,2,"まちまち"],[13,2,"むらむら"],[16,1,"とお"],[18,1,"す"],[28,1,"たび"],[30,1,"つづ"]],"text":"さてイエスは教えながら町々村々を通り過ぎ、エルサレムへと旅を続けられた。"},{"ref":"Luke.13.23","start":42013023,"end":42013023,"break":"none","ruby":[[6,1,"ひと"],[14,1,"しゅ"],[17,1,"すく"],[21,1,"ひと"],[23,1,"すく"],[32,1,"たず"]],"text":"すると、ある人がイエスに、「主よ、救われる人は少ないのですか」と尋ねた。"},{"ref":"Luke.13.24","start":42013024,"end":42013024,"break":"none","ruby":[[7,2,"ひとびと"],[14,1,"い"],[20,1,"せま"],[22,2,"とぐち"],[32,1,"つと"],[38,2,"じじつ"],[55,1,"ひと"],[57,1,"おお"]],"text":"そこでイエスは人々にむかって言われた、「狭い戸口からはいるように努めなさい。事実、はいろうとしても、はいれない人が多いのだから。"},{"ref":"Luke.13.25","start":42013025,"end":42013025,"break":"none","ruby":[[0,1,"いえ"],[2,2,"しゅじん"],[5,1,"た"],[8,1,"と"],[10,1,"と"],[26,1,"そと"],[28,1,"た"],[30,1,"と"],[35,1,"はじ"],[41,3,"しゅじんさま"],[57,1,"い"],[62,2,"しゅじん"],[68,1,"こた"],[85,1,"ひと"],[94,1,"し"],[100,1,"い"]],"text":"家の主人が立って戸を閉じてしまってから、あなたがたが外に立ち戸をたたき始めて、『ご主人様、どうぞあけてください』と言っても、主人はそれに答えて、『あなたがたがどこからきた人なのか、わたしは知らない』と言うであろう。"},{"ref":"Luke.13.26","start":42013026,"end":42013026,"break":"none","ruby":[[17,2,"いっしょ"],[20,1,"の"],[22,1,"く"],[42,2,"おおどお"],[46,1,"おし"],[58,1,"い"],[60,1,"だ"]],"text":"そのとき、『わたしたちはあなたとご一緒に飲み食いしました。また、あなたはわたしたちの大通りで教えてくださいました』と言い出しても、"},{"ref":"Luke.13.27","start":42013027,"end":42013027,"break":"none","ruby":[[0,1,"かれ"],[16,1,"ひと"],[25,1,"し"],[30,2,"あくじ"],[33,1,"はたら"],[35,1,"もの"],[43,1,"い"],[51,1,"い"]],"text":"彼は、『あなたがたがどこからきた人なのか、わたしは知らない。悪事を働く者どもよ、みんな行ってしまえ』と言うであろう。"},{"ref":"Luke.13.28","start":42013028,"end":42013028,"break":"none","ruby":[[25,3,"よげんしゃ"],[32,1,"かみ"],[34,1,"くに"],[45,2,"じぶん"],[50,1,"そと"],[52,1,"な"],[54,1,"だ"],[68,1,"な"],[70,1,"さけ"],[75,1,"は"]],"text":"あなたがたは、アブラハム、イサク、ヤコブやすべての預言者たちが、神の国にはいっているのに、自分たちは外に投げ出されることになれば、そこで泣き叫んだり、歯がみをしたりするであろう。"},{"ref":"Luke.13.29","start":42013029,"end":42013029,"break":"none","ruby":[[4,2,"ひとびと"],[8,1,"ひがし"],[11,1,"にし"],[17,1,"みなみ"],[20,1,"きた"],[26,1,"かみ"],[28,1,"くに"],[30,2,"えんかい"],[33,1,"せき"]],"text":"それから人々が、東から西から、また南から北からきて、神の国で宴会の席につくであろう。"},{"ref":"Luke.13.30","start":42013030,"end":42013030,"break":"none","ruby":[[10,1,"さき"],[23,1,"さき"]],"text":"こうしてあとのもので先になるものがあり、また、先のものであとになるものもある」。"},{"ref":"Luke.13.31","start":42013031,"end":42013031,"break":"paragraph","ruby":[[6,1,"とき"],[14,1,"びと"],[23,2,"ちかよ"],[29,1,"い"],[38,1,"で"],[40,1,"い"],[54,1,"ころ"]],"text":"ちょうどその時、あるパリサイ人たちが、イエスに近寄ってきて言った、「ここから出て行きなさい。ヘロデがあなたを殺そうとしています」。"},{"ref":"Luke.13.32","start":42013032,"end":42013032,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[22,1,"い"],[27,1,"い"],[31,1,"み"],[45,2,"あくれい"],[48,1,"お"],[50,1,"だ"],[56,2,"びょうき"],[67,1,"か"],[68,1,"め"],[73,1,"お"]],"text":"そこで彼らに言われた、「あのきつねのところへ行ってこう言え、『見よ、わたしはきょうもあすも悪霊を追い出し、また、病気をいやし、そして三日目にわざを終えるであろう。"},{"ref":"Luke.13.33","start":42013033,"end":42013033,"break":"none","ruby":[[16,1,"つぎ"],[18,1,"ひ"],[25,1,"すす"],[28,1,"い"],[37,3,"よげんしゃ"],[46,2,"いがい"],[49,1,"ち"],[51,1,"し"],[59,1,"え"]],"text":"しかし、きょうもあすも、またその次の日も、わたしは進んで行かねばならない。預言者がエルサレム以外の地で死ぬことは、あり得ないからである』。"},{"ref":"Luke.13.34","start":42013034,"end":42013034,"break":"none","ruby":[[15,3,"よげんしゃ"],[21,1,"ころ"],[34,2,"ひとびと"],[37,1,"いし"],[39,1,"う"],[41,1,"ころ"],[43,1,"もの"],[55,1,"つばさ"],[57,1,"した"],[62,1,"あつ"],[77,1,"こ"],[80,1,"いく"],[83,1,"あつ"],[109,1,"おう"]],"text":"ああ、エルサレム、エルサレム、預言者たちを殺し、おまえにつかわされた人々を石で打ち殺す者よ。ちょうどめんどりが翼の下にひなを集めるように、わたしはおまえの子らを幾たび集めようとしたことであろう。それだのに、おまえたちは応じようとしなかった。"},{"ref":"Luke.13.35","start":42013035,"end":42013035,"break":"none","breaks":[[31,"stanza"]],"ruby":[[0,1,"み"],[9,1,"いえ"],[11,2,"みす"],[25,1,"い"],[28,1,"お"],[32,1,"しゅ"],[34,1,"な"],[46,2,"しゅくふく"],[58,1,"い"],[60,1,"とき"],[62,1,"く"],[68,1,"ふたた"],[74,1,"あ"]],"text":"見よ、おまえたちの家は見捨てられてしまう。わたしは言って置く、『主の名によってきたるものに、祝福あれ』とおまえたちが言う時の来るまでは、再びわたしに会うことはないであろう」。"}]