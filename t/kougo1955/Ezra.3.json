[{"ref":"Ezra.3.1","start":15003001,"end":15003001,"break":"paragraph","ruby":[[10,2,"ひとびと"],[15,2,"まちまち"],[18,1,"す"],[26,1,"がつ"],[32,1,"たみ"],[47,1,"あつ"]],"text":"こうしてイスラエルの人々はその町々に住んでいたが、七月になって、民はひとりのようにエルサレムに集まった。"},{"ref":"Ezra.3.2","start":15003002,"end":15003002,"break":"none","ruby":[[8,1,"こ"],[16,2,"なかま"],[19,2,"さいし"],[33,1,"こ"],[42,2,"きょうだい"],[47,1,"た"],[57,1,"かみ"],[59,2,"さいだん"],[62,1,"きず"],[69,1,"かみ"],[71,1,"ひと"],[76,2,"りっぽう"],[88,1,"したが"],[94,1,"うえ"],[96,2,"はんさい"]],"text":"そこでヨザダクの子エシュアとその仲間の祭司たち、およびシャルテルの子ゼルバベルとその兄弟たちは立って、イスラエルの神の祭壇を築いた。これは神の人モーセの律法にしるされたところに従って、その上に燔祭をささげるためであった。"},{"ref":"Ezra.3.3","start":15003003,"end":15003003,"break":"none","ruby":[[0,1,"かれ"],[3,2,"くにぐに"],[6,1,"たみ"],[8,1,"おそ"],[16,2,"さいだん"],[22,1,"ところ"],[24,1,"もう"],[33,1,"うえ"],[35,2,"はんさい"],[38,1,"しゅ"],[44,2,"あさゆう"]],"text":"彼らは国々の民を恐れていたので、祭壇をもとの所に設けた。そしてその上で燔祭を主にささげ、朝夕それをささげた。"},{"ref":"Ezra.3.4","start":15003004,"end":15003004,"break":"none","ruby":[[12,1,"したが"],[15,2,"かりほ"],[18,1,"まつり"],[20,1,"おこな"],[27,1,"したが"],[31,2,"まいにち"],[38,1,"かず"],[45,2,"ひび"],[48,2,"はんさい"]],"text":"また、しるされたところに従って仮庵の祭を行い、おきてに従って、毎日ささぐべき数のとおりに、日々の燔祭をささげた。"},{"ref":"Ezra.3.5","start":15003005,"end":15003005,"break":"none","ruby":[[5,1,"のち"],[7,3,"じょうはんさい"],[11,2,"しんげつ"],[14,1,"しゅ"],[19,1,"さだ"],[24,1,"まつり"],[31,1,"そな"],[33,1,"もの"],[37,2,"かくじ"],[40,1,"しゅ"],[46,2,"まごころ"],[51,1,"そな"],[53,1,"もの"]],"text":"そしてその後は常燔祭、新月と主のすべて定められた祭とにささげる供え物および各自が主にささげる真心よりの供え物をささげた。"},{"ref":"Ezra.3.6","start":15003006,"end":15003006,"break":"none","ruby":[[5,1,"がつ"],[7,1,"にち"],[10,2,"はんさい"],[13,1,"しゅ"],[22,1,"はじ"],[27,1,"しゅ"],[29,1,"みや"],[31,2,"きそ"]],"text":"すなわち七月一日から燔祭を主にささげることを始めたが、主の宮の基礎はまだすえられてなかった。"},{"ref":"Ezra.3.7","start":15003007,"end":15003007,"break":"none","ruby":[[3,2,"いしく"],[6,2,"もっこう"],[9,1,"かね"],[11,1,"わた"],[23,2,"ひとびと"],[26,1,"く"],[28,1,"もの"],[30,1,"の"],[32,1,"もの"],[36,1,"あぶら"],[38,1,"あた"],[46,1,"おう"],[52,1,"え"],[54,2,"きょか"],[57,1,"したが"],[71,1,"うみ"],[73,2,"こうはく"],[76,1,"はこ"]],"text":"そこで石工と木工に金を渡し、またシドンとツロの人々に食い物、飲み物および油を与えて、ペルシャ王クロスから得た許可に従って、レバノンからヨッパの海に香柏を運ばせた。"},{"ref":"Ezra.3.8","start":15003008,"end":15003008,"break":"paragraph","ruby":[[8,1,"かみ"],[10,1,"みや"],[12,1,"かえ"],[15,1,"つぎ"],[17,1,"ねん"],[20,1,"がつ"],[29,1,"こ"],[41,1,"こ"],[49,2,"きょうだい"],[54,1,"た"],[56,2,"さいし"],[66,2,"ほしゅう"],[76,1,"かえ"],[79,1,"き"],[85,2,"ひとびと"],[88,1,"とも"],[90,2,"こうじ"],[93,1,"はじ"],[98,1,"さい"],[99,2,"いじょう"],[107,1,"た"],[111,1,"しゅ"],[113,1,"みや"],[115,2,"こうじ"],[118,2,"かんとく"]],"text":"さてエルサレムの神の宮に帰った次の年の二月に、シャルテルの子ゼルバベルとヨザダクの子エシュアはその兄弟である他の祭司、レビびとおよび捕囚からエルサレムに帰って来たすべての人々と共に工事を始め、二十歳以上のレビびとを立てて、主の宮の工事を監督させた。"},{"ref":"Ezra.3.9","start":15003009,"end":15003009,"break":"none","ruby":[[6,2,"しそん"],[18,1,"こ"],[25,2,"きょうだい"],[36,1,"こ"],[39,1,"とも"],[41,1,"た"],[45,1,"かみ"],[47,1,"みや"],[49,2,"こうじ"],[54,1,"もの"],[56,2,"かんとく"],[66,1,"こ"],[76,1,"こ"],[82,2,"きょうだい"],[89,2,"いっしょ"]],"text":"そこでユダの子孫であるエシュアとその子らおよびその兄弟、カデミエルとその子らは共に立って、神の宮で工事をなす者を監督した。ヘナダデの子らおよびレビびとの子らと、その兄弟たちもまた一緒であった。"},{"ref":"Ezra.3.10","start":15003010,"end":15003010,"break":"paragraph","ruby":[[4,3,"けんちくしゃ"],[8,1,"しゅ"],[10,1,"みや"],[12,2,"きそ"],[18,1,"とき"],[20,2,"さいし"],[25,2,"れいふく"],[42,1,"こ"],[66,1,"おう"],[71,2,"しれい"],[74,1,"したが"],[77,1,"しゅ"]],"text":"こうして建築者が主の宮の基礎をすえた時、祭司たちは礼服をつけてラッパをとり、アサフの子らであるレビびとはシンバルをとり、イスラエルの王ダビデの指令に従って主をさんびした。"},{"ref":"Ezra.3.11","start":15003011,"end":15003011,"break":"none","breaks":[[21,"stanza"],[30,"line"],[38,"line"]],"ruby":[[0,1,"かれ"],[3,1,"たがい"],[5,1,"うた"],[10,1,"しゅ"],[17,2,"かんしゃ"],[22,1,"しゅ"],[27,1,"ふか"],[49,1,"た"],[59,1,"い"],[66,1,"たみ"],[70,1,"しゅ"],[80,2,"おおごえ"],[86,1,"さけ"],[90,1,"しゅ"],[92,1,"みや"],[94,2,"きそ"]],"text":"彼らは互に歌いあって主をほめ、かつ感謝し、「主はめぐみ深く、そのいつくしみはとこしえにイスラエルに絶えることがない」と言った。そして民はみな主をさんびするとき、大声をあげて叫んだ。主の宮の基礎がすえられたからである。"},{"ref":"Ezra.3.12","start":15003012,"end":15003012,"break":"none","ruby":[[3,2,"さいし"],[11,2,"しぞく"],[14,1,"ちょう"],[18,1,"おお"],[21,2,"ひとびと"],[31,1,"みや"],[33,1,"み"],[35,2,"ろうじん"],[45,1,"いま"],[48,1,"みや"],[50,2,"きそ"],[60,1,"み"],[62,1,"とき"],[64,2,"おおごえ"],[70,1,"な"],[76,1,"よろこ"],[82,1,"こえ"],[87,1,"さけ"],[89,1,"もの"],[91,1,"おお"]],"text":"しかし祭司、レビびと、氏族の長である多くの人々のうちに、もとの宮を見た老人たちがあったが、今この宮の基礎のすえられるのを見た時、大声をあげて泣いた。また喜びのために声をあげて叫ぶ者も多かった。"},{"ref":"Ezra.3.13","start":15003013,"end":15003013,"break":"none","ruby":[[4,2,"ひとびと"],[7,1,"たみ"],[9,1,"よろこ"],[11,1,"さけ"],[13,1,"こえ"],[16,1,"たみ"],[18,1,"な"],[20,1,"こえ"],[23,1,"き"],[38,1,"たみ"],[40,2,"おおごえ"],[43,1,"さけ"],[51,1,"こえ"],[53,1,"とお"],[57,1,"きこ"]],"text":"それで、人々は民の喜び叫ぶ声と、民の泣く声とを聞きわけることができなかった。民が大声に叫んだので、その声が遠くまで聞えたからである。"}]