[{"ref":"Mark.4.1","start":41004001,"end":41004001,"break":"paragraph","ruby":[[8,1,"うみ"],[11,1,"おし"],[26,2,"ぐんしゅう"],[33,1,"あつ"],[44,1,"ふね"],[46,1,"の"],[56,2,"かいじょう"],[63,2,"ぐんしゅう"],[68,1,"うみ"],[70,1,"そ"],[73,2,"りくち"]],"text":"イエスはまたも、海べで教えはじめられた。おびただしい群衆がみもとに集まったので、イエスは舟に乗ってすわったまま、海上におられ、群衆はみな海に沿って陸地にいた。"},{"ref":"Mark.4.2","start":41004002,"end":41004002,"break":"none","ruby":[[4,1,"たとえ"],[6,1,"おお"],[9,1,"こと"],[11,1,"おし"],[20,1,"おしえ"],[22,1,"なか"],[24,1,"かれ"],[29,1,"い"]],"text":"イエスは譬で多くの事を教えられたが、その教の中で彼らにこう言われた、"},{"ref":"Mark.4.3","start":41004003,"end":41004003,"break":"none","ruby":[[1,1,"き"],[7,1,"たね"],[11,1,"たね"],[16,1,"で"],[18,1,"い"]],"text":"「聞きなさい、種まきが種をまきに出て行った。"},{"ref":"Mark.4.4","start":41004004,"end":41004004,"break":"none","ruby":[[9,1,"みち"],[13,1,"お"],[16,1,"たね"],[26,1,"とり"],[30,1,"た"]],"text":"まいているうちに、道ばたに落ちた種があった。すると、鳥がきて食べてしまった。"},{"ref":"Mark.4.5","start":41004005,"end":41004005,"break":"none","ruby":[[3,1,"たね"],[5,1,"つち"],[7,1,"うす"],[9,2,"いしじ"],[12,1,"お"],[19,1,"つち"],[21,1,"ふか"],[30,1,"め"],[32,1,"だ"]],"text":"ほかの種は土の薄い石地に落ちた。そこは土が深くないので、すぐ芽を出したが、"},{"ref":"Mark.4.6","start":41004006,"end":41004006,"break":"none","ruby":[[0,1,"ひ"],[2,1,"のぼ"],[5,1,"や"],[9,1,"ね"],[16,1,"か"]],"text":"日が上ると焼けて、根がないために枯れてしまった。"},{"ref":"Mark.4.7","start":41004007,"end":41004007,"break":"none","ruby":[[3,1,"たね"],[9,1,"なか"],[11,1,"お"],[23,1,"の"],[38,1,"み"],[40,1,"むす"]],"text":"ほかの種はいばらの中に落ちた。すると、いばらが伸びて、ふさいでしまったので、実を結ばなかった。"},{"ref":"Mark.4.8","start":41004008,"end":41004008,"break":"none","ruby":[[3,1,"たね"],[5,1,"よ"],[7,1,"ち"],[9,1,"お"],[20,1,"そだ"],[28,1,"み"],[30,1,"むす"],[35,1,"ばい"],[39,1,"ばい"],[42,1,"ばい"]],"text":"ほかの種は良い地に落ちた。そしてはえて、育って、ますます実を結び、三十倍、六十倍、百倍にもなった」。"},{"ref":"Mark.4.9","start":41004009,"end":41004009,"break":"none","ruby":[[3,1,"い"],[9,1,"き"],[11,1,"みみ"],[15,1,"もの"],[17,1,"き"]],"text":"そして言われた、「聞く耳のある者は聞くがよい」。"},{"ref":"Mark.4.10","start":41004010,"end":41004010,"break":"paragraph","ruby":[[12,1,"とき"],[19,1,"もの"],[26,2,"でし"],[29,1,"とも"],[36,1,"たとえ"],[41,1,"たず"]],"text":"イエスがひとりになられた時、そばにいた者たちが、十二弟子と共に、これらの譬について尋ねた。"},{"ref":"Mark.4.11","start":41004011,"end":41004011,"break":"none","ruby":[[7,1,"い"],[20,1,"かみ"],[22,1,"くに"],[24,2,"おくぎ"],[27,1,"さづ"],[39,1,"もの"],[49,1,"たとえ"],[51,1,"かた"]],"text":"そこでイエスは言われた、「あなたがたには神の国の奥義が授けられているが、ほかの者たちには、すべてが譬で語られる。"},{"ref":"Mark.4.12","start":41004012,"end":41004012,"break":"paragraph","breaks":[[3,"stanza"],[19,"line"],[31,"line"]],"ruby":[[4,1,"かれ"],[7,1,"み"],[11,1,"み"],[15,1,"みと"],[19,1,"き"],[23,1,"き"],[27,1,"さと"],[31,1,"く"],[33,1,"あらた"]],"text":"それは『彼らは見るには見るが、認めず、聞くには聞くが、悟らず、悔い改めてゆるされることがない』ためである」。"},{"ref":"Mark.4.13","start":41004013,"end":41004013,"break":"none","ruby":[[2,1,"かれ"],[5,1,"い"],[19,1,"たとえ"],[42,1,"たとえ"]],"text":"また彼らに言われた、「あなたがたはこの譬がわからないのか。それでは、どうしてすべての譬がわかるだろうか。"},{"ref":"Mark.4.14","start":41004014,"end":41004014,"break":"none","ruby":[[0,1,"たね"],[4,2,"みことば"]],"text":"種まきは御言をまくのである。"},{"ref":"Mark.4.15","start":41004015,"end":41004015,"break":"none","ruby":[[0,1,"みち"],[4,2,"みことば"],[18,1,"ひと"],[33,2,"みことば"],[36,1,"き"],[50,1,"かれ"],[53,1,"なか"],[59,2,"みことば"],[63,1,"うば"],[66,1,"い"]],"text":"道ばたに御言がまかれたとは、こういう人たちのことである。すなわち、御言を聞くと、すぐにサタンがきて、彼らの中にまかれた御言を、奪って行くのである。"},{"ref":"Mark.4.16","start":41004016,"end":41004016,"break":"none","ruby":[[0,1,"おな"],[6,2,"いしじ"],[22,1,"ひと"],[32,2,"みことば"],[35,1,"き"],[42,1,"よろこ"],[45,1,"う"]],"text":"同じように、石地にまかれたものとは、こういう人たちのことである。御言を聞くと、すぐに喜んで受けるが、"},{"ref":"Mark.4.17","start":41004017,"end":41004017,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"なか"],[5,1,"ね"],[16,1,"つづ"],[29,2,"みことば"],[35,2,"こんなん"],[38,2,"はくがい"],[41,1,"おこ"]],"text":"自分の中に根がないので、しばらく続くだけである。そののち、御言のために困難や迫害が起ってくると、すぐつまずいてしまう。"},{"ref":"Mark.4.18","start":41004018,"end":41004018,"break":"none","ruby":[[7,1,"なか"],[22,1,"ひと"],[32,2,"みことば"],[35,1,"き"]],"text":"また、いばらの中にまかれたものとは、こういう人たちのことである。御言を聞くが、"},{"ref":"Mark.4.19","start":41004019,"end":41004019,"break":"none","ruby":[[0,1,"よ"],[2,1,"こころ"],[8,1,"とみ"],[10,1,"まど"],[17,1,"た"],[23,1,"よく"],[33,2,"みことば"],[42,1,"み"],[44,1,"むす"]],"text":"世の心づかいと、富の惑わしと、その他いろいろな欲とがはいってきて、御言をふさぐので、実を結ばなくなる。"},{"ref":"Mark.4.20","start":41004020,"end":41004020,"break":"none","ruby":[[3,1,"よ"],[5,1,"ち"],[20,1,"ひと"],[30,2,"みことば"],[33,1,"き"],[36,1,"う"],[43,1,"ばい"],[47,1,"ばい"],[50,1,"ばい"],[52,1,"み"],[54,1,"むす"]],"text":"また、良い地にまかれたものとは、こういう人たちのことである。御言を聞いて受けいれ、三十倍、六十倍、百倍の実を結ぶのである」。"},{"ref":"Mark.4.21","start":41004021,"end":41004021,"break":"paragraph","ruby":[[2,1,"かれ"],[5,1,"い"],[14,1,"した"],[16,2,"しんだい"],[19,1,"した"],[21,1,"お"],[31,1,"も"],[44,2,"しょくだい"],[47,1,"うえ"],[49,1,"お"]],"text":"また彼らに言われた、「ますの下や寝台の下に置くために、あかりを持ってくることがあろうか。燭台の上に置くためではないか。"},{"ref":"Mark.4.22","start":41004022,"end":41004022,"break":"none","ruby":[[5,1,"かく"],[15,1,"あらわ"],[25,2,"ひみつ"],[37,1,"あか"],[41,1,"で"]],"text":"なんでも、隠されているもので、現れないものはなく、秘密にされているもので、明るみに出ないものはない。"},{"ref":"Mark.4.23","start":41004023,"end":41004023,"break":"none","ruby":[[0,1,"き"],[2,1,"みみ"],[6,1,"もの"],[8,1,"き"]],"text":"聞く耳のある者は聞くがよい」。"},{"ref":"Mark.4.24","start":41004024,"end":41004024,"break":"none","ruby":[[2,1,"かれ"],[5,1,"い"],[11,1,"き"],[18,2,"ちゅうい"],[31,1,"はか"],[40,2,"じぶん"],[44,1,"はか"],[46,1,"あた"],[53,1,"うえ"],[57,1,"ま"],[59,1,"くわ"]],"text":"また彼らに言われた、「聞くことがらに注意しなさい。あなたがたの量るそのはかりで、自分にも量り与えられ、その上になお増し加えられるであろう。"},{"ref":"Mark.4.25","start":41004025,"end":41004025,"break":"none","ruby":[[5,1,"も"],[10,1,"ひと"],[12,1,"さら"],[14,1,"あた"],[19,1,"も"],[25,1,"ひと"],[28,1,"も"],[38,1,"と"],[40,1,"あ"]],"text":"だれでも、持っている人は更に与えられ、持っていない人は、持っているものまでも取り上げられるであろう」。"},{"ref":"Mark.4.26","start":41004026,"end":41004026,"break":"paragraph","ruby":[[2,1,"い"],[8,1,"かみ"],[10,1,"くに"],[15,1,"ひと"],[17,1,"ち"],[19,1,"たね"]],"text":"また言われた、「神の国は、ある人が地に種をまくようなものである。"},{"ref":"Mark.4.27","start":41004027,"end":41004027,"break":"none","ruby":[[0,2,"よるひる"],[3,2,"ねお"],[10,1,"あいだ"],[13,1,"たね"],[15,1,"め"],[17,1,"だ"],[20,1,"そだ"],[23,1,"い"],[40,1,"ひと"],[42,1,"し"]],"text":"夜昼、寝起きしている間に、種は芽を出して育って行くが、どうしてそうなるのか、その人は知らない。"},{"ref":"Mark.4.28","start":41004028,"end":41004028,"break":"none","ruby":[[0,1,"ち"],[7,1,"み"],[9,1,"むす"],[17,1,"はじ"],[20,1,"め"],[25,1,"ほ"],[30,1,"ほ"],[32,1,"なか"],[34,1,"ゆた"],[37,1,"み"]],"text":"地はおのずから実を結ばせるもので、初めに芽、つぎに穂、つぎに穂の中に豊かな実ができる。"},{"ref":"Mark.4.29","start":41004029,"end":41004029,"break":"none","ruby":[[0,1,"み"],[12,1,"い"],[16,2,"かりい"],[19,1,"とき"]],"text":"実がいると、すぐにかまを入れる。刈入れ時がきたからである」。"},{"ref":"Mark.4.30","start":41004030,"end":41004030,"break":"paragraph","ruby":[[2,1,"い"],[8,1,"かみ"],[10,1,"くに"],[12,1,"なに"],[14,1,"くら"],[26,1,"たとえ"],[28,1,"い"]],"text":"また言われた、「神の国を何に比べようか。また、どんな譬で言いあらわそうか。"},{"ref":"Mark.4.31","start":41004031,"end":41004031,"break":"none","ruby":[[4,1,"つぶ"],[9,1,"たね"],[20,1,"ち"],[26,1,"とき"],[30,2,"ちじょう"],[36,1,"たね"],[40,1,"ちい"]],"text":"それは一粒のからし種のようなものである。地にまかれる時には、地上のどんな種よりも小さいが、"},{"ref":"Mark.4.32","start":41004032,"end":41004032,"break":"none","ruby":[[6,2,"せいちょう"],[13,2,"やさい"],[18,1,"おお"],[24,1,"おお"],[27,1,"えだ"],[29,1,"は"],[34,1,"かげ"],[36,1,"そら"],[38,1,"とり"],[40,1,"やど"]],"text":"まかれると、成長してどんな野菜よりも大きくなり、大きな枝を張り、その陰に空の鳥が宿るほどになる」。"},{"ref":"Mark.4.33","start":41004033,"end":41004033,"break":"paragraph","ruby":[[9,1,"おお"],[12,1,"たとえ"],[15,2,"ひとびと"],[18,1,"き"],[20,1,"ちから"],[28,2,"みことば"],[31,1,"かた"]],"text":"イエスはこのような多くの譬で、人々の聞く力にしたがって、御言を語られた。"},{"ref":"Mark.4.34","start":41004034,"end":41004034,"break":"none","ruby":[[0,1,"たとえ"],[8,1,"かた"],[17,2,"じぶん"],[20,2,"でし"],[38,1,"と"],[40,1,"あ"]],"text":"譬によらないでは語られなかったが、自分の弟子たちには、ひそかにすべてのことを解き明かされた。"},{"ref":"Mark.4.35","start":41004035,"end":41004035,"break":"paragraph","ruby":[[4,1,"ひ"],[6,2,"ゆうがた"],[17,2,"でし"],[24,1,"む"],[27,1,"ぎし"],[29,1,"わた"],[34,1,"い"]],"text":"さてその日、夕方になると、イエスは弟子たちに、「向こう岸へ渡ろう」と言われた。"},{"ref":"Mark.4.36","start":41004036,"end":41004036,"break":"none","ruby":[[4,1,"かれ"],[7,2,"ぐんしゅう"],[13,1,"のこ"],[20,1,"ふね"],[22,1,"の"],[32,1,"の"],[34,1,"だ"],[41,1,"ふね"],[43,2,"いっしょ"],[46,1,"い"]],"text":"そこで、彼らは群衆をあとに残し、イエスが舟に乗っておられるまま、乗り出した。ほかの舟も一緒に行った。"},{"ref":"Mark.4.37","start":41004037,"end":41004037,"break":"none","ruby":[[4,1,"はげ"],[7,2,"とっぷう"],[10,1,"おこ"],[13,1,"なみ"],[15,1,"ふね"],[17,1,"なか"],[19,1,"う"],[21,1,"こ"],[27,1,"ふね"],[29,1,"み"]],"text":"すると、激しい突風が起り、波が舟の中に打ち込んできて、舟に満ちそうになった。"},{"ref":"Mark.4.38","start":41004038,"end":41004038,"break":"none","ruby":[[7,2,"じしん"],[11,1,"とも"],[13,1,"ほう"],[22,1,"ねむ"],[34,2,"でし"],[49,2,"せんせい"],[61,1,"し"],[81,1,"い"]],"text":"ところがイエス自身は、舳の方でまくらをして、眠っておられた。そこで、弟子たちはイエスをおこして、「先生、わたしどもがおぼれ死んでも、おかまいにならないのですか」と言った。"},{"ref":"Mark.4.39","start":41004039,"end":41004039,"break":"none","ruby":[[4,1,"お"],[10,1,"かぜ"],[16,1,"うみ"],[24,1,"しず"],[28,1,"だま"],[32,1,"い"],[38,1,"かぜ"],[44,1,"おお"]],"text":"イエスは起きあがって風をしかり、海にむかって、「静まれ、黙れ」と言われると、風はやんで、大なぎになった。"},{"ref":"Mark.4.40","start":41004040,"end":41004040,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[31,2,"しんこう"]],"text":"イエスは彼らに言われた、「なぜ、そんなにこわがるのか。どうして信仰がないのか」。"},{"ref":"Mark.4.41","start":41004041,"end":41004041,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おそ"],[11,1,"たがい"],[13,1,"い"],[25,1,"ほう"],[33,1,"かぜ"],[35,1,"うみ"],[37,1,"したが"]],"text":"彼らは恐れおののいて、互に言った、「いったい、この方はだれだろう。風も海も従わせるとは」。"}]