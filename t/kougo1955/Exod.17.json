[{"ref":"Exod.17.1","start":2017001,"end":2017001,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"ぜん"],[10,2,"かいしゅう"],[14,1,"しゅ"],[16,1,"いのち"],[18,1,"したが"],[25,2,"あらの"],[28,2,"しゅっぱつ"],[32,2,"たびじ"],[35,1,"かさ"],[44,2,"しゅくえい"],[54,1,"たみ"],[56,1,"の"],[58,1,"みず"]],"text":"イスラエルの人々の全会衆は、主の命に従って、シンの荒野を出発し、旅路を重ねて、レピデムに宿営したが、そこには民の飲む水がなかった。"},{"ref":"Exod.17.2","start":2017002,"end":2017002,"break":"none","ruby":[[4,1,"たみ"],[10,1,"あらそ"],[13,1,"い"],[24,1,"の"],[26,1,"みず"],[38,1,"かれ"],[41,1,"い"],[58,1,"あらそ"],[65,1,"しゅ"],[67,1,"こころ"]],"text":"それで、民はモーセと争って言った、「わたしたちに飲む水をください」。モーセは彼らに言った、「あなたがたはなぜわたしと争うのか、なぜ主を試みるのか」。"},{"ref":"Exod.17.3","start":2017003,"end":2017003,"break":"none","ruby":[[0,1,"たみ"],[4,1,"ところ"],[6,1,"みず"],[21,1,"い"],[44,1,"みちび"],[46,1,"だ"],[57,2,"こども"],[60,2,"かちく"],[63,2,"いっしょ"],[74,1,"し"]],"text":"民はその所で水にかわき、モーセにつぶやいて言った、「あなたはなぜわたしたちをエジプトから導き出して、わたしたちを、子供や家畜と一緒に、かわきによって死なせようとするのですか」。"},{"ref":"Exod.17.4","start":2017004,"end":2017004,"break":"none","ruby":[[8,1,"しゅ"],[10,1,"さけ"],[13,1,"い"],[24,1,"たみ"],[39,1,"かれ"],[43,1,"いま"],[51,1,"いし"],[53,1,"う"],[55,1,"ころ"]],"text":"このときモーセは主に叫んで言った、「わたしはこの民をどうすればよいのでしょう。彼らは、今にも、わたしを石で打ち殺そうとしています」。"},{"ref":"Exod.17.5","start":2017005,"end":2017005,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"たみ"],[18,1,"まえ"],[20,1,"すす"],[22,1,"い"],[31,2,"ちょうろう"],[36,1,"ともな"],[46,1,"かわ"],[48,1,"う"],[55,1,"て"],[57,1,"と"],[60,1,"い"]],"text":"主はモーセに言われた、「あなたは民の前に進み行き、イスラエルの長老たちを伴い、あなたがナイル川を打った、つえを手に取って行きなさい。"},{"ref":"Exod.17.6","start":2017006,"end":2017006,"break":"none","ruby":[[0,1,"み"],[11,1,"いわ"],[13,1,"うえ"],[19,1,"まえ"],[21,1,"た"],[32,1,"いわ"],[34,1,"う"],[40,1,"みず"],[46,1,"で"],[49,1,"たみ"],[54,1,"の"],[74,2,"ちょうろう"],[79,1,"め"],[81,1,"まえ"],[89,1,"おこな"]],"text":"見よ、わたしはホレブの岩の上であなたの前に立つであろう。あなたは岩を打ちなさい。水がそれから出て、民はそれを飲むことができる」。モーセはイスラエルの長老たちの目の前で、そのように行った。"},{"ref":"Exod.17.7","start":2017007,"end":2017007,"break":"none","ruby":[[3,1,"かれ"],[7,1,"ところ"],[9,1,"な"],[21,1,"よ"],[34,2,"ひとびと"],[37,1,"あらそ"],[45,1,"かれ"],[49,1,"しゅ"],[70,1,"い"],[73,1,"しゅ"],[75,1,"こころ"]],"text":"そして彼はその所の名をマッサ、またメリバと呼んだ。これはイスラエルの人々が争ったゆえ、また彼らが「主はわたしたちのうちにおられるかどうか」と言って主を試みたからである。"},{"ref":"Exod.17.8","start":2017008,"end":2017008,"break":"paragraph","ruby":[[22,1,"たたか"]],"text":"ときにアマレクがきて、イスラエルとレピデムで戦った。"},{"ref":"Exod.17.9","start":2017009,"end":2017009,"break":"none","ruby":[[9,1,"い"],[22,1,"ひと"],[24,1,"えら"],[27,1,"で"],[34,1,"たたか"],[46,1,"かみ"],[51,1,"て"],[53,1,"と"],[57,1,"おか"],[59,1,"いただき"],[61,1,"た"]],"text":"モーセはヨシュアに言った、「われわれのために人を選び、出てアマレクと戦いなさい。わたしはあす神のつえを手に取って、丘の頂に立つであろう」。"},{"ref":"Exod.17.10","start":2017010,"end":2017010,"break":"none","ruby":[[9,1,"かれ"],[11,1,"い"],[24,1,"たたか"],[41,1,"おか"],[43,1,"いただき"],[45,1,"のぼ"]],"text":"ヨシュアはモーセが彼に言ったようにし、アマレクと戦った。モーセとアロンおよびホルは丘の頂に登った。"},{"ref":"Exod.17.11","start":2017011,"end":2017011,"break":"none","ruby":[[4,1,"て"],[6,1,"あ"],[18,1,"か"],[21,1,"て"],[23,1,"さ"],[32,1,"か"]],"text":"モーセが手を上げているとイスラエルは勝ち、手を下げるとアマレクが勝った。"},{"ref":"Exod.17.12","start":2017012,"end":2017012,"break":"none","ruby":[[7,1,"て"],[9,1,"おも"],[24,1,"いし"],[26,1,"と"],[34,1,"あし"],[38,1,"お"],[42,1,"かれ"],[46,1,"うえ"],[48,1,"ざ"],[79,1,"て"],[88,1,"かれ"],[90,1,"て"],[92,2,"にちぼつ"]],"text":"しかしモーセの手が重くなったので、アロンとホルが石を取って、モーセの足もとに置くと、彼はその上に座した。そしてひとりはこちらに、ひとりはあちらにいて、モーセの手をささえたので、彼の手は日没までさがらなかった。"},{"ref":"Exod.17.13","start":2017013,"end":2017013,"break":"none","ruby":[[20,1,"たみ"],[22,1,"う"],[24,1,"やぶ"]],"text":"ヨシュアは、つるぎにかけてアマレクとその民を打ち敗った。"},{"ref":"Exod.17.14","start":2017014,"end":2017014,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[15,2,"しょもつ"],[22,2,"きねん"],[35,1,"みみ"],[37,1,"い"],[47,1,"あめ"],[49,1,"した"],[57,2,"きおく"],[60,2,"かんぜん"],[63,1,"け"],[65,1,"さ"]],"text":"主はモーセに言われた、「これを書物にしるして記念とし、それをヨシュアの耳に入れなさい。わたしは天が下からアマレクの記憶を完全に消し去るであろう」。"},{"ref":"Exod.17.15","start":2017015,"end":2017015,"break":"none","ruby":[[7,2,"さいだん"],[10,1,"きず"],[15,1,"な"],[18,1,"しゅ"],[22,1,"はた"],[25,1,"よ"]],"text":"モーセは一つの祭壇を築いてその名を「主はわが旗」と呼んだ。"},{"ref":"Exod.17.16","start":2017016,"end":2017016,"break":"none","breaks":[[11,"stanza"],[26,"line"]],"ruby":[[7,1,"い"],[12,1,"しゅ"],[14,1,"はた"],[20,1,"て"],[22,1,"あ"],[26,1,"しゅ"],[28,2,"よよ"],[35,1,"たたか"]],"text":"そしてモーセは言った、「主の旗にむかって手を上げる、主は世々アマレクと戦われる」。"}]