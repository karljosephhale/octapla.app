[{"ref":"Ruth.1.1","start":8001001,"end":8001001,"break":"paragraph","ruby":[[7,1,"よ"],[9,1,"おさ"],[17,1,"くに"],[19,1,"き"],[33,1,"ひと"],[37,1,"つま"],[43,1,"おとこ"],[45,1,"こ"],[47,1,"つ"],[59,1,"さ"],[66,1,"ち"],[68,1,"い"],[74,2,"たいざい"]],"text":"さばきづかさが世を治めているころ、国に飢きんがあったので、ひとりの人がその妻とふたりの男の子を連れてユダのベツレヘムを去り、モアブの地へ行ってそこに滞在した。"},{"ref":"Ruth.1.2","start":8001002,"end":8001002,"break":"none","ruby":[[2,1,"ひと"],[4,1,"な"],[12,1,"つま"],[14,1,"な"],[24,1,"おとこ"],[26,1,"こ"],[28,1,"な"],[62,1,"かれ"],[69,1,"ち"],[71,1,"い"]],"text":"その人の名はエリメレク、妻の名はナオミ、ふたりの男の子の名はマロンとキリオンといい、ユダのベツレヘムのエフラタびとであった。彼らはモアブの地へ行って、そこにおったが、"},{"ref":"Ruth.1.3","start":8001003,"end":8001003,"break":"none","ruby":[[4,1,"おっと"],[11,1,"し"],[23,1,"おとこ"],[25,1,"こ"],[27,1,"のこ"]],"text":"ナオミの夫エリメレクは死んで、ナオミとふたりの男の子が残された。"},{"ref":"Ruth.1.4","start":8001004,"end":8001004,"break":"none","ruby":[[4,1,"おとこ"],[6,1,"こ"],[16,1,"おんな"],[18,1,"つま"],[20,1,"むか"],[30,1,"な"],[43,1,"な"],[52,1,"かれ"],[59,1,"ねん"],[62,1,"す"]],"text":"ふたりの男の子はそれぞれモアブの女を妻に迎えた。そのひとりの名はオルパといい、ひとりの名はルツといった。彼らはそこに十年ほど住んでいたが、"},{"ref":"Ruth.1.5","start":8001005,"end":8001005,"break":"none","ruby":[[15,1,"し"],[31,1,"こ"],[33,1,"おっと"],[36,1,"さき"]],"text":"マロンとキリオンのふたりもまた死んだ。こうしてナオミはふたりの子と夫とに先だたれた。"},{"ref":"Ruth.1.6","start":8001006,"end":8001006,"break":"paragraph","ruby":[[2,1,"とき"],[12,1,"ち"],[15,1,"しゅ"],[19,1,"たみ"],[21,1,"かえり"],[28,2,"しょくもつ"],[32,1,"あた"],[43,1,"き"],[51,1,"よめ"],[53,1,"とも"],[55,1,"た"],[63,1,"ち"],[71,1,"かえ"]],"text":"その時、ナオミはモアブの地で、主がその民を顧みて、すでに食物をお与えになっていることを聞いたので、その嫁と共に立って、モアブの地からふるさとへ帰ろうとした。"},{"ref":"Ruth.1.7","start":8001007,"end":8001007,"break":"none","ruby":[[3,2,"かのじょ"],[6,1,"いま"],[9,1,"ところ"],[11,2,"しゅったつ"],[18,1,"ち"],[20,1,"かえ"],[29,1,"よめ"],[31,1,"つ"],[34,1,"みち"],[36,1,"すす"]],"text":"そこで彼女は今いる所を出立し、ユダの地へ帰ろうと、ふたりの嫁を連れて道に進んだ。"},{"ref":"Ruth.1.8","start":8001008,"end":8001008,"break":"none","ruby":[[11,1,"よめ"],[13,1,"い"],[29,2,"じぶん"],[32,1,"はは"],[34,1,"いえ"],[36,1,"かえ"],[39,1,"い"],[52,1,"し"],[59,1,"こ"],[65,2,"しんせつ"],[80,1,"しゅ"],[95,1,"たま"]],"text":"しかしナオミはふたりの嫁に言った、「あなたがたは、それぞれ自分の母の家に帰って行きなさい。あなたがたが、死んだふたりの子とわたしに親切をつくしたように、どうぞ、主があなたがたに、いつくしみを賜わりますよう。"},{"ref":"Ruth.1.9","start":8001009,"end":8001009,"break":"none","ruby":[[4,1,"しゅ"],[12,1,"おっと"],[14,1,"あた"],[17,1,"おっと"],[19,1,"いえ"],[26,1,"み"],[28,1,"お"],[30,1,"つ"],[32,1,"どころ"],[34,1,"え"],[47,1,"い"],[55,1,"よめ"],[57,1,"くち"],[65,1,"かれ"],[68,1,"こえ"],[73,1,"な"]],"text":"どうぞ、主があなたがたに夫を与え、夫の家で、それぞれ身の落ち着き所を得させられるように」。こう言って、ふたりの嫁に口づけしたので、彼らは声をあげて泣き、"},{"ref":"Ruth.1.10","start":8001010,"end":8001010,"break":"none","ruby":[[4,1,"い"],[19,2,"いっしょ"],[26,1,"たみ"],[32,1,"かえ"]],"text":"ナオミに言った、「いいえ、わたしたちは一緒にあなたの民のところへ帰ります」。"},{"ref":"Ruth.1.11","start":8001011,"end":8001011,"break":"none","ruby":[[7,1,"い"],[12,1,"むすめ"],[17,1,"かえ"],[20,1,"い"],[35,2,"いっしょ"],[38,1,"い"],[55,1,"おっと"],[59,1,"こ"],[67,2,"たいない"],[73,1,"おも"]],"text":"しかしナオミは言った、「娘たちよ、帰って行きなさい。どうして、わたしと一緒に行こうというのですか。あなたがたの夫となる子がまだわたしの胎内にいると思うのですか。"},{"ref":"Ruth.1.12","start":8001012,"end":8001012,"break":"none","ruby":[[0,1,"むすめ"],[5,1,"かえ"],[8,1,"い"],[18,1,"とし"],[28,1,"おっと"],[49,2,"こんや"],[52,1,"おっと"],[59,1,"こ"],[61,1,"う"],[63,1,"のぞ"]],"text":"娘たちよ、帰って行きなさい。わたしは年をとっているので、夫をもつことはできません。たとい、わたしが今夜、夫をもち、また子を産む望みがあるとしても、"},{"ref":"Ruth.1.13","start":8001013,"end":8001013,"break":"none","ruby":[[12,1,"こ"],[16,2,"せいちょう"],[22,1,"ま"],[48,1,"おっと"],[65,1,"むすめ"],[79,1,"しゅ"],[81,1,"て"],[87,1,"のぞ"],[94,1,"せ"],[117,2,"ひじょう"],[120,1,"こころ"],[122,1,"いた"]],"text":"そのためにあなたがたは、子どもの成長するまで待っているつもりなのですか。あなたがたは、そのために夫をもたずにいるつもりなのですか。娘たちよ、それはいけません。主の手がわたしに臨み、わたしを責められたことで、あなたがたのために、わたしは非常に心を痛めているのです」。"},{"ref":"Ruth.1.14","start":8001014,"end":8001014,"break":"none","ruby":[[0,1,"かれ"],[5,1,"こえ"],[10,1,"な"],[29,1,"くち"],[45,1,"はな"]],"text":"彼らはまた声をあげて泣いた。そしてオルパはそのしゅうとめに口づけしたが、ルツはしゅうとめを離れなかった。"},{"ref":"Ruth.1.15","start":8001015,"end":8001015,"break":"paragraph","ruby":[[7,1,"い"],[23,2,"あいよめ"],[26,2,"じぶん"],[29,1,"たみ"],[31,2,"じぶん"],[34,2,"かみがみ"],[40,1,"かえ"],[43,1,"い"],[53,2,"あいよめ"],[62,1,"かえ"]],"text":"そこでナオミは言った、「ごらんなさい。あなたの相嫁は自分の民と自分の神々のもとへ帰って行きました。あなたも相嫁のあとについて帰りなさい」。"},{"ref":"Ruth.1.16","start":8001016,"end":8001016,"break":"none","ruby":[[6,1,"い"],[15,1,"す"],[22,1,"はな"],[25,1,"かえ"],[34,1,"すす"],[52,1,"い"],[56,1,"ところ"],[58,1,"い"],[67,1,"やど"],[71,1,"ところ"],[73,1,"やど"],[82,1,"たみ"],[88,1,"たみ"],[94,1,"かみ"],[100,1,"かみ"]],"text":"しかしルツは言った、「あなたを捨て、あなたを離れて帰ることをわたしに勧めないでください。わたしはあなたの行かれる所へ行き、またあなたの宿られる所に宿ります。あなたの民はわたしの民、あなたの神はわたしの神です。"},{"ref":"Ruth.1.17","start":8001017,"end":8001017,"break":"none","ruby":[[4,1,"し"],[8,1,"ところ"],[14,1,"し"],[25,1,"ほうむ"],[33,1,"し"],[35,1,"わか"],[49,1,"わか"],[56,1,"しゅ"],[71,1,"ばっ"]],"text":"あなたの死なれる所でわたしも死んで、そのかたわらに葬られます。もし死に別れでなく、わたしがあなたと別れるならば、主よ、どうぞわたしをいくえにも罰してください」。"},{"ref":"Ruth.1.18","start":8001018,"end":8001018,"break":"none","ruby":[[7,2,"じぶん"],[10,2,"いっしょ"],[13,1,"い"],[18,1,"かた"],[20,2,"けっしん"],[28,1,"み"],[37,1,"い"]],"text":"ナオミはルツが自分と一緒に行こうと、固く決心しているのを見たので、そのうえ言うことをやめた。"},{"ref":"Ruth.1.19","start":8001019,"end":8001019,"break":"paragraph","ruby":[[7,1,"たび"],[23,1,"つ"],[27,1,"かれ"],[36,1,"つ"],[42,1,"まち"],[48,1,"かれ"],[54,1,"さわ"],[59,1,"おんな"],[63,1,"い"]],"text":"そしてふたりは旅をつづけて、ついにベツレヘムに着いた。彼らがベツレヘムに着いたとき、町はこぞって彼らのために騒ぎたち、女たちは言った、「これはナオミですか」。"},{"ref":"Ruth.1.20","start":8001020,"end":8001020,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[20,1,"たの"],[25,1,"よ"],[33,1,"くる"],[38,1,"よ"],[50,3,"ぜんのうしゃ"],[61,1,"くる"]],"text":"ナオミは彼らに言った、「わたしをナオミ（楽しみ）と呼ばずに、マラ（苦しみ）と呼んでください。なぜなら全能者がわたしをひどく苦しめられたからです。"},{"ref":"Ruth.1.21","start":8001021,"end":8001021,"break":"none","ruby":[[4,1,"で"],[6,1,"い"],[11,1,"ゆた"],[21,1,"しゅ"],[29,1,"て"],[31,1,"かえ"],[38,1,"しゅ"],[44,1,"なや"],[48,3,"ぜんのうしゃ"],[56,1,"わざわい"],[78,1,"よ"]],"text":"わたしは出て行くときは豊かでありましたが、主はわたしをから手で帰されました。主がわたしを悩まし、全能者がわたしに災をくだされたのに、どうしてわたしをナオミと呼ぶのですか」。"},{"ref":"Ruth.1.22","start":8001022,"end":8001022,"break":"none","ruby":[[13,1,"ち"],[16,1,"かえ"],[19,1,"よめ"],[25,1,"おんな"],[29,2,"いっしょ"],[32,1,"かえ"],[38,2,"おおむぎ"],[40,1,"かり"],[42,1,"はじ"],[51,1,"つ"]],"text":"こうしてナオミは、モアブの地から帰った嫁、モアブの女ルツと一緒に帰ってきて、大麦刈の初めにベツレヘムに着いた。"}]