[{"ref":"Matt.24.1","start":40024001,"end":40024001,"break":"paragraph","ruby":[[4,1,"みや"],[7,1,"で"],[9,1,"い"],[21,2,"でし"],[26,2,"ちかよ"],[33,1,"みや"],[35,2,"たてもの"],[42,2,"ちゅうい"],[45,1,"うなが"]],"text":"イエスが宮から出て行こうとしておられると、弟子たちは近寄ってきて、宮の建物にイエスの注意を促した。"},{"ref":"Matt.24.2","start":40024002,"end":40024002,"break":"none","ruby":[[7,1,"かれ"],[14,1,"い"],[37,1,"み"],[44,1,"い"],[52,1,"いし"],[67,1,"た"],[69,1,"いし"],[71,1,"うえ"],[73,1,"のこ"]],"text":"そこでイエスは彼らにむかって言われた、「あなたがたは、これらすべてのものを見ないか。よく言っておく。その石一つでもくずされずに、そこに他の石の上に残ることもなくなるであろう」。"},{"ref":"Matt.24.3","start":40024003,"end":40024003,"break":"paragraph","ruby":[[5,1,"やま"],[17,2,"でし"],[33,1,"い"],[42,1,"はな"],[58,1,"おこ"],[79,1,"とき"],[82,1,"よ"],[84,1,"おわ"],[92,2,"ぜんちょう"]],"text":"またオリブ山ですわっておられると、弟子たちが、ひそかにみもとにきて言った、「どうぞお話しください。いつ、そんなことが起るのでしょうか。あなたがまたおいでになる時や、世の終りには、どんな前兆がありますか」。"},{"ref":"Matt.24.4","start":40024004,"end":40024004,"break":"none","ruby":[[7,1,"こた"],[10,1,"い"],[16,1,"ひと"],[18,1,"まど"],[27,1,"き"]],"text":"そこでイエスは答えて言われた、「人に惑わされないように気をつけなさい。"},{"ref":"Matt.24.5","start":40024005,"end":40024005,"break":"none","ruby":[[0,1,"おお"],[3,1,"もの"],[9,1,"な"],[11,1,"な"],[15,1,"あらわ"],[18,2,"じぶん"],[27,1,"い"],[31,1,"おお"],[34,1,"ひと"],[36,1,"まど"]],"text":"多くの者がわたしの名を名のって現れ、自分がキリストだと言って、多くの人を惑わすであろう。"},{"ref":"Matt.24.6","start":40024006,"end":40024006,"break":"none","ruby":[[3,2,"せんそう"],[6,2,"せんそう"],[14,1,"き"],[21,2,"ちゅうい"],[43,1,"おこ"],[55,1,"おわ"]],"text":"また、戦争と戦争のうわさとを聞くであろう。注意していなさい、あわててはいけない。それは起らねばならないが、まだ終りではない。"},{"ref":"Matt.24.7","start":40024007,"end":40024007,"break":"none","ruby":[[0,1,"たみ"],[2,1,"たみ"],[5,1,"くに"],[7,1,"くに"],[9,2,"てきたい"],[13,1,"た"],[15,1,"あ"],[35,1,"おこ"],[40,2,"じしん"]],"text":"民は民に、国は国に敵対して立ち上がるであろう。またあちこちに、ききんが起り、また地震があるであろう。"},{"ref":"Matt.24.8","start":40024008,"end":40024008,"break":"none","ruby":[[11,1,"う"],[14,1,"くる"],[18,1,"はじ"]],"text":"しかし、すべてこれらは産みの苦しみの初めである。"},{"ref":"Matt.24.9","start":40024009,"end":40024009,"break":"none","ruby":[[4,2,"ひとびと"],[14,1,"くる"],[24,1,"ころ"],[44,1,"な"],[53,1,"たみ"],[55,1,"にく"]],"text":"そのとき人々は、あなたがたを苦しみにあわせ、また殺すであろう。またあなたがたは、わたしの名のゆえにすべての民に憎まれるであろう。"},{"ref":"Matt.24.10","start":40024010,"end":40024010,"break":"none","ruby":[[5,1,"おお"],[8,1,"ひと"],[17,1,"たがい"],[19,2,"うらぎ"],[23,1,"にく"],[25,1,"あ"]],"text":"そのとき、多くの人がつまずき、また互に裏切り、憎み合うであろう。"},{"ref":"Matt.24.11","start":40024011,"end":40024011,"break":"none","ruby":[[2,1,"おお"],[7,3,"よげんしゃ"],[11,1,"おこ"],[15,1,"おお"],[18,1,"ひと"],[20,1,"まど"]],"text":"また多くのにせ預言者が起って、多くの人を惑わすであろう。"},{"ref":"Matt.24.12","start":40024012,"end":40024012,"break":"none","ruby":[[2,2,"ふほう"],[12,1,"おお"],[15,1,"ひと"],[17,1,"あい"],[19,1,"ひ"]],"text":"また不法がはびこるので、多くの人の愛が冷えるであろう。"},{"ref":"Matt.24.13","start":40024013,"end":40024013,"break":"none","ruby":[[4,2,"さいご"],[8,1,"た"],[10,1,"しの"],[12,1,"もの"],[14,1,"すく"]],"text":"しかし、最後まで耐え忍ぶ者は救われる。"},{"ref":"Matt.24.14","start":40024014,"end":40024014,"break":"none","ruby":[[5,2,"みくに"],[8,2,"ふくいん"],[16,1,"たみ"],[18,1,"たい"],[31,1,"ぜん"],[32,2,"せかい"],[35,1,"の"],[37,1,"つた"],[54,2,"さいご"],[57,1,"く"]],"text":"そしてこの御国の福音は、すべての民に対してあかしをするために、全世界に宣べ伝えられるであろう。そしてそれから最後が来るのである。"},{"ref":"Matt.24.15","start":40024015,"end":40024015,"break":"paragraph","ruby":[[0,3,"よげんしゃ"],[11,1,"い"],[15,1,"あ"],[18,1,"にく"],[22,1,"もの"],[25,1,"せい"],[28,2,"ばしょ"],[31,1,"た"],[35,1,"み"],[41,2,"どくしゃ"],[45,1,"さと"]],"text":"預言者ダニエルによって言われた荒らす憎むべき者が、聖なる場所に立つのを見たならば（読者よ、悟れ）、"},{"ref":"Matt.24.16","start":40024016,"end":40024016,"break":"none","ruby":[[11,2,"ひとびと"],[14,1,"やま"],[16,1,"に"]],"text":"そのとき、ユダヤにいる人々は山へ逃げよ。"},{"ref":"Matt.24.17","start":40024017,"end":40024017,"break":"none","ruby":[[0,2,"おくじょう"],[5,1,"もの"],[8,1,"いえ"],[14,1,"と"],[16,1,"だ"],[22,1,"した"]],"text":"屋上にいる者は、家からものを取り出そうとして下におりるな。"},{"ref":"Matt.24.18","start":40024018,"end":40024018,"break":"none","ruby":[[0,1,"はたけ"],[4,1,"もの"],[7,2,"うわぎ"],[10,1,"と"]],"text":"畑にいる者は、上着を取りにあとへもどるな。"},{"ref":"Matt.24.19","start":40024019,"end":40024019,"break":"none","ruby":[[2,1,"ひ"],[6,2,"みおも"],[9,1,"おんな"],[11,2,"ちの"],[14,1,"ご"],[18,1,"おんな"],[22,2,"ふこう"]],"text":"その日には、身重の女と乳飲み子をもつ女とは、不幸である。"},{"ref":"Matt.24.20","start":40024020,"end":40024020,"break":"none","ruby":[[6,1,"に"],[12,1,"ふゆ"],[16,3,"あんそくにち"],[27,1,"いの"]],"text":"あなたがたの逃げるのが、冬または安息日にならないように祈れ。"},{"ref":"Matt.24.21","start":40024021,"end":40024021,"break":"none","ruby":[[2,1,"とき"],[6,1,"よ"],[8,1,"はじ"],[12,2,"げんざい"],[15,1,"いた"],[25,2,"こんご"],[33,1,"おお"],[36,2,"かんなん"],[39,1,"おこ"]],"text":"その時には、世の初めから現在に至るまで、かつてなく今後もないような大きな患難が起るからである。"},{"ref":"Matt.24.22","start":40024022,"end":40024022,"break":"none","ruby":[[4,2,"きかん"],[7,1,"ちぢ"],[16,1,"すく"],[20,1,"もの"],[37,2,"せんみん"],[47,2,"きかん"],[50,1,"ちぢ"]],"text":"もしその期間が縮められないなら、救われる者はひとりもないであろう。しかし、選民のためには、その期間が縮められるであろう。"},{"ref":"Matt.24.23","start":40024023,"end":40024023,"break":"paragraph","ruby":[[16,1,"み"],[43,1,"い"],[51,1,"しん"]],"text":"そのとき、だれかがあなたがたに『見よ、ここにキリストがいる』、また、『あそこにいる』と言っても、それを信じるな。"},{"ref":"Matt.24.24","start":40024024,"end":40024024,"break":"none","ruby":[[12,3,"よげんしゃ"],[18,1,"おこ"],[22,1,"おお"],[30,2,"きせき"],[34,1,"おこな"],[42,2,"せんみん"],[46,1,"まど"]],"text":"にせキリストたちや、にせ預言者たちが起って、大いなるしるしと奇跡とを行い、できれば、選民をも惑わそうとするであろう。"},{"ref":"Matt.24.25","start":40024025,"end":40024025,"break":"none","ruby":[[0,1,"み"],[9,1,"まえ"],[13,1,"い"]],"text":"見よ、あなたがたに前もって言っておく。"},{"ref":"Matt.24.26","start":40024026,"end":40024026,"break":"none","ruby":[[4,2,"ひとびと"],[8,1,"み"],[11,1,"かれ"],[13,2,"あらの"],[20,1,"い"],[25,1,"で"],[27,1,"い"],[34,1,"み"],[40,1,"なか"],[46,1,"い"],[51,1,"しん"]],"text":"だから、人々が『見よ、彼は荒野にいる』と言っても、出て行くな。また『見よ、へやの中にいる』と言っても、信じるな。"},{"ref":"Matt.24.27","start":40024027,"end":40024027,"break":"none","ruby":[[10,1,"ひがし"],[13,1,"にし"],[19,1,"わた"],[25,1,"ひと"],[27,1,"こ"],[29,1,"あらわ"]],"text":"ちょうど、いなずまが東から西にひらめき渡るように、人の子も現れるであろう。"},{"ref":"Matt.24.28","start":40024028,"end":40024028,"break":"none","ruby":[[0,2,"したい"],[16,1,"あつ"]],"text":"死体のあるところには、はげたかが集まるものである。"},{"ref":"Matt.24.29","start":40024029,"end":40024029,"break":"paragraph","ruby":[[6,1,"とき"],[8,1,"おこ"],[10,2,"かんなん"],[13,1,"のち"],[19,1,"ひ"],[21,1,"くら"],[26,1,"つき"],[30,1,"ひかり"],[32,1,"はな"],[40,1,"ほし"],[42,1,"そら"],[45,1,"お"],[48,2,"てんたい"],[51,1,"ゆ"],[53,1,"うご"]],"text":"しかし、その時に起る患難の後、たちまち日は暗くなり、月はその光を放つことをやめ、星は空から落ち、天体は揺り動かされるであろう。"},{"ref":"Matt.24.30","start":40024030,"end":40024030,"break":"none","ruby":[[5,1,"ひと"],[7,1,"こ"],[13,1,"てん"],[15,1,"あらわ"],[30,1,"ち"],[36,2,"みんぞく"],[39,1,"なげ"],[45,1,"ちから"],[47,1,"おお"],[51,2,"えいこう"],[59,1,"ひと"],[61,1,"こ"],[63,1,"てん"],[65,1,"くも"],[67,1,"の"],[70,1,"く"],[75,2,"ひとびと"],[78,1,"み"]],"text":"そのとき、人の子のしるしが天に現れるであろう。またそのとき、地のすべての民族は嘆き、そして力と大いなる栄光とをもって、人の子が天の雲に乗って来るのを、人々は見るであろう。"},{"ref":"Matt.24.31","start":40024031,"end":40024031,"break":"none","ruby":[[3,1,"かれ"],[5,1,"おお"],[13,1,"おと"],[15,1,"とも"],[17,2,"みつかい"],[28,1,"てん"],[37,1,"いた"],[42,2,"しほう"],[48,2,"せんみん"],[51,1,"よ"],[53,1,"あつ"]],"text":"また、彼は大いなるラッパの音と共に御使たちをつかわして、天のはてからはてに至るまで、四方からその選民を呼び集めるであろう。"},{"ref":"Matt.24.32","start":40024032,"end":40024032,"break":"paragraph","ruby":[[5,1,"き"],[10,1,"たとえ"],[12,1,"まな"],[20,1,"えだ"],[22,1,"やわ"],[29,1,"は"],[31,1,"で"],[40,1,"なつ"],[42,1,"ちか"]],"text":"いちじくの木からこの譬を学びなさい。その枝が柔らかになり、葉が出るようになると、夏の近いことがわかる。"},{"ref":"Matt.24.33","start":40024033,"end":40024033,"break":"none","ruby":[[16,1,"み"],[22,1,"ひと"],[24,1,"こ"],[26,2,"とぐち"],[30,1,"ちか"],[37,1,"し"]],"text":"そのように、すべてこれらのことを見たならば、人の子が戸口まで近づいていると知りなさい。"},{"ref":"Matt.24.34","start":40024034,"end":40024034,"break":"none","ruby":[[2,1,"き"],[15,1,"こと"],[23,1,"おこ"],[31,2,"じだい"],[34,1,"ほろ"]],"text":"よく聞いておきなさい。これらの事が、ことごとく起るまでは、この時代は滅びることがない。"},{"ref":"Matt.24.35","start":40024035,"end":40024035,"break":"none","ruby":[[0,2,"てんち"],[3,1,"ほろ"],[18,2,"ことば"],[21,1,"ほろ"]],"text":"天地は滅びるであろう。しかしわたしの言葉は滅びることがない。"},{"ref":"Matt.24.36","start":40024036,"end":40024036,"break":"none","ruby":[[2,1,"ひ"],[6,1,"とき"],[12,1,"し"],[17,1,"てん"],[19,2,"みつかい"],[27,1,"こ"],[29,1,"し"],[36,1,"ちち"],[40,1,"し"]],"text":"その日、その時は、だれも知らない。天の御使たちも、また子も知らない、ただ父だけが知っておられる。"},{"ref":"Matt.24.37","start":40024037,"end":40024037,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[4,1,"あらわ"],[17,1,"とき"]],"text":"人の子の現れるのも、ちょうどノアの時のようであろう。"},{"ref":"Matt.24.38","start":40024038,"end":40024038,"break":"none","ruby":[[5,2,"こうずい"],[8,1,"で"],[10,1,"まえ"],[15,2,"はこぶね"],[21,1,"ひ"],[25,2,"ひとびと"],[28,1,"く"],[31,1,"の"]],"text":"すなわち、洪水の出る前、ノアが箱舟にはいる日まで、人々は食い、飲み、めとり、とつぎなどしていた。"},{"ref":"Matt.24.39","start":40024039,"end":40024039,"break":"none","ruby":[[3,2,"こうずい"],[6,1,"おそ"],[24,1,"い"],[29,1,"かれ"],[32,1,"き"],[41,1,"ひと"],[43,1,"こ"],[45,1,"あらわ"]],"text":"そして洪水が襲ってきて、いっさいのものをさらって行くまで、彼らは気がつかなかった。人の子の現れるのも、そのようであろう。"},{"ref":"Matt.24.40","start":40024040,"end":40024040,"break":"none","ruby":[[9,1,"もの"],[11,1,"はたけ"],[21,1,"と"],[23,1,"さ"],[31,1,"と"],[33,1,"のこ"]],"text":"そのとき、ふたりの者が畑にいると、ひとりは取り去られ、ひとりは取り残されるであろう。"},{"ref":"Matt.24.41","start":40024041,"end":40024041,"break":"none","ruby":[[4,1,"おんな"],[20,1,"と"],[22,1,"さ"],[30,1,"のこ"]],"text":"ふたりの女がうすをひいていると、ひとりは取り去られ、ひとりは残されるであろう。"},{"ref":"Matt.24.42","start":40024042,"end":40024042,"break":"none","ruby":[[4,1,"め"],[18,1,"ひ"],[26,1,"しゅ"]],"text":"だから、目をさましていなさい。いつの日にあなたがたの主がこられるのか、あなたがたには、わからないからである。"},{"ref":"Matt.24.43","start":40024043,"end":40024043,"break":"none","ruby":[[16,1,"いえ"],[18,2,"しゅじん"],[22,2,"とうぞく"],[29,1,"く"],[41,1,"め"],[50,2,"じぶん"],[53,1,"いえ"],[55,1,"お"],[57,1,"い"],[62,1,"ゆる"]],"text":"このことをわきまえているがよい。家の主人は、盗賊がいつごろ来るかわかっているなら、目をさましていて、自分の家に押し入ることを許さないであろう。"},{"ref":"Matt.24.44","start":40024044,"end":40024044,"break":"none","ruby":[[10,2,"ようい"],[20,1,"おも"],[26,1,"とき"],[28,1,"ひと"],[30,1,"こ"],[32,1,"く"]],"text":"だから、あなたがたも用意をしていなさい。思いがけない時に人の子が来るからである。"},{"ref":"Matt.24.45","start":40024045,"end":40024045,"break":"none","ruby":[[0,2,"しゅじん"],[5,1,"いえ"],[7,1,"しもべ"],[11,1,"うえ"],[13,1,"た"],[17,1,"とき"],[19,1,"おう"],[22,2,"しょくもつ"],[31,2,"ちゅうじつ"],[34,2,"しりょ"],[36,1,"ぶか"],[38,1,"しもべ"]],"text":"主人がその家の僕たちの上に立てて、時に応じて食物をそなえさせる忠実な思慮深い僕は、いったい、だれであろう。"},{"ref":"Matt.24.46","start":40024046,"end":40024046,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"かえ"],[24,1,"み"],[28,1,"しもべ"]],"text":"主人が帰ってきたとき、そのようにつとめているのを見られる僕は、さいわいである。"},{"ref":"Matt.24.47","start":40024047,"end":40024047,"break":"none","ruby":[[2,1,"い"],[9,2,"しゅじん"],[12,1,"かれ"],[14,1,"た"],[17,2,"じぶん"],[20,1,"ぜん"],[21,2,"ざいさん"],[24,2,"かんり"]],"text":"よく言っておくが、主人は彼を立てて自分の全財産を管理させるであろう。"},{"ref":"Matt.24.48","start":40024048,"end":40024048,"break":"none","ruby":[[5,1,"わる"],[7,1,"しもべ"],[13,2,"じぶん"],[16,2,"しゅじん"],[19,1,"かえ"],[26,1,"こころ"],[28,1,"なか"],[30,1,"おも"]],"text":"もしそれが悪い僕であって、自分の主人は帰りがおそいと心の中で思い、"},{"ref":"Matt.24.49","start":40024049,"end":40024049,"break":"none","ruby":[[2,1,"しもべ"],[3,2,"なかま"],[15,2,"さけの"],[18,2,"なかま"],[21,2,"いっしょ"],[24,1,"た"],[28,1,"の"]],"text":"その僕仲間をたたきはじめ、また酒飲み仲間と一緒に食べたり飲んだりしているなら、"},{"ref":"Matt.24.50","start":40024050,"end":40024050,"break":"none","ruby":[[2,1,"しもべ"],[4,2,"しゅじん"],[7,1,"おも"],[13,1,"ひ"],[15,1,"き"],[21,1,"とき"],[23,1,"かえ"]],"text":"その僕の主人は思いがけない日、気がつかない時に帰ってきて、"},{"ref":"Matt.24.51","start":40024051,"end":40024051,"break":"none","ruby":[[0,1,"かれ"],[2,2,"げんばつ"],[5,1,"しょ"],[8,3,"ぎぜんしゃ"],[14,1,"おな"],[16,1,"め"],[27,1,"かれ"],[32,1,"な"],[34,1,"さけ"],[39,1,"は"]],"text":"彼を厳罰に処し、偽善者たちと同じ目にあわせるであろう。彼はそこで泣き叫んだり、歯がみをしたりするであろう。"}]