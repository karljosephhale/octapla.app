[{"ref":"Judg.13.1","start":7013001,"end":7013001,"break":"paragraph","ruby":[[6,2,"ひとびと"],[11,1,"しゅ"],[13,1,"まえ"],[15,1,"あく"],[17,1,"おこな"],[23,1,"しゅ"],[25,1,"かれ"],[30,1,"ねん"],[32,1,"あいだ"],[40,1,"て"]],"text":"イスラエルの人々がまた主の前に悪を行ったので、主は彼らを四十年の間ペリシテびとの手にわたされた。"},{"ref":"Judg.13.2","start":7013002,"end":7013002,"break":"paragraph","ruby":[[8,2,"しぞく"],[11,1,"もの"],[14,1,"な"],[25,1,"ひと"],[33,1,"つま"],[41,1,"こ"],[43,1,"う"]],"text":"ここにダンびとの氏族の者で、名をマノアというゾラの人があった。その妻はうまずめで、子を産んだことがなかった。"},{"ref":"Judg.13.3","start":7013003,"end":7013003,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[6,1,"おんな"],[8,1,"あらわ"],[11,1,"い"],[26,1,"こ"],[28,1,"う"],[48,1,"み"],[53,1,"おとこ"],[55,1,"こ"],[57,1,"う"]],"text":"主の使がその女に現れて言った、「あなたはうまずめで、子を産んだことがありません。しかし、あなたは身ごもって男の子を産むでしょう。"},{"ref":"Judg.13.4","start":7013004,"end":7013004,"break":"none","ruby":[[7,1,"き"],[16,1,"しゅ"],[20,1,"こ"],[22,1,"さけ"],[24,1,"の"],[39,1,"けが"],[45,1,"た"]],"text":"それであなたは気をつけて、ぶどう酒または濃い酒を飲んではなりません。またすべて汚れたものを食べてはなりません。"},{"ref":"Judg.13.5","start":7013005,"end":7013005,"break":"none","ruby":[[4,1,"み"],[9,1,"おとこ"],[11,1,"こ"],[13,1,"う"],[22,1,"あたま"],[41,1,"こ"],[43,1,"うま"],[46,1,"とき"],[49,1,"かみ"],[65,1,"かれ"],[74,1,"て"],[83,1,"すく"],[85,1,"はじ"]],"text":"あなたは身ごもって男の子を産むでしょう。その頭にかみそりをあててはなりません。その子は生れた時から神にささげられたナジルびとです。彼はペリシテびとの手からイスラエルを救い始めるでしょう」。"},{"ref":"Judg.13.6","start":7013006,"end":7013006,"break":"none","ruby":[[5,1,"おんな"],[9,1,"おっと"],[11,1,"い"],[16,1,"かみ"],[18,1,"ひと"],[35,1,"かお"],[40,1,"かみ"],[42,1,"つかい"],[44,1,"かお"],[57,1,"おそ"],[75,1,"ひと"],[86,1,"たず"],[98,1,"ひと"],[104,1,"な"],[106,1,"つ"]],"text":"そこでその女はきて夫に言った、「神の人がわたしのところにきました。その顔かたちは神の使の顔かたちのようで、たいそう恐ろしゅうございました。わたしはその人が、どこからきたのか尋ねませんでしたが、その人もわたしに名を告げませんでした。"},{"ref":"Judg.13.7","start":7013007,"end":7013007,"break":"none","ruby":[[5,1,"ひと"],[16,1,"み"],[21,1,"おとこ"],[23,1,"こ"],[25,1,"う"],[42,1,"しゅ"],[46,1,"こ"],[48,1,"さけ"],[50,1,"の"],[65,1,"けが"],[71,1,"た"],[83,1,"こ"],[85,1,"うま"],[88,1,"とき"],[91,1,"し"],[93,1,"ひ"],[96,1,"かみ"],[113,1,"もう"]],"text":"しかしその人はわたしに『あなたは身ごもって男の子を産むでしょう。それであなたはぶどう酒または濃い酒を飲んではなりません。またすべて汚れたものを食べてはなりません。その子は生れた時から死ぬ日まで神にささげられたナジルびとです』と申しました」。"},{"ref":"Judg.13.8","start":7013008,"end":7013008,"break":"paragraph","ruby":[[7,1,"しゅ"],[9,1,"ねが"],[11,1,"もと"],[14,1,"い"],[22,1,"しゅ"],[42,1,"かみ"],[44,1,"ひと"],[49,1,"ど"],[56,1,"のぞ"],[69,1,"うま"],[72,1,"こ"],[81,1,"おし"]],"text":"そこでマノアは主に願い求めて言った、「ああ、主よ、どうぞ、あなたがさきにつかわされた神の人をもう一度わたしたちに臨ませて、わたしたちがその生れる子になすべきことを教えさせてください」。"},{"ref":"Judg.13.9","start":7013009,"end":7013009,"break":"none","ruby":[[0,1,"かみ"],[6,1,"ねが"],[9,1,"き"],[16,1,"かみ"],[18,1,"つかい"],[20,1,"おんな"],[22,1,"はたけ"],[24,1,"ざ"],[29,1,"とき"],[35,2,"かのじょ"],[38,1,"のぞ"],[45,1,"おっと"],[50,2,"いっしょ"]],"text":"神がマノアの願いを聞かれたので、神の使は女が畑に座していた時、ふたたび彼女に臨んだ。しかし夫マノアは一緒にいなかった。"},{"ref":"Judg.13.10","start":7013010,"end":7013010,"break":"none","ruby":[[0,1,"おんな"],[2,1,"いそ"],[4,1,"はし"],[7,1,"い"],[10,1,"おっと"],[12,1,"い"],[26,1,"のぞ"],[30,1,"ひと"],[38,1,"あらわ"]],"text":"女は急ぎ走って行って夫に言った、「さきごろ、わたしに臨まれた人がまたわたしに現れました」。"},{"ref":"Judg.13.11","start":7013011,"end":7013011,"break":"none","ruby":[[4,1,"た"],[7,1,"つま"],[15,1,"い"],[20,1,"ひと"],[25,1,"い"],[28,1,"い"],[42,1,"おんな"],[45,1,"つ"],[61,1,"ひと"],[63,1,"い"]],"text":"マノアは立って妻のあとについて行き、その人のもとに行って言った、「あなたはかつてこの女にお告げになったおかたですか」。その人は言った、「そうです」。"},{"ref":"Judg.13.12","start":7013012,"end":7013012,"break":"none","ruby":[[4,1,"い"],[13,1,"い"],[20,2,"じじつ"],[31,1,"こ"],[33,1,"そだ"],[35,1,"かた"],[46,1,"こと"]],"text":"マノアは言った、「あなたの言われたことが事実となったとき、その子の育て方およびこれになすべき事はなんでしょうか」。"},{"ref":"Judg.13.13","start":7013013,"end":7013013,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[8,1,"い"],[20,1,"おんな"],[22,1,"い"],[28,1,"みな"],[30,1,"まも"]],"text":"主の使はマノアに言った、「わたしがさきに女に言ったことは皆、守らせなければなりません。"},{"ref":"Judg.13.14","start":7013014,"end":7013014,"break":"none","ruby":[[8,1,"き"],[11,1,"さん"],[20,1,"た"],[35,1,"しゅ"],[37,1,"こ"],[39,1,"さけ"],[41,1,"の"],[56,1,"けが"],[62,1,"た"],[76,2,"かのじょ"],[79,1,"めい"],[85,1,"みな"],[87,1,"まも"]],"text":"すなわちぶどうの木から産するものはすべて食べてはなりません。またぶどう酒と濃い酒を飲んではなりません。またすべて汚れたものを食べてはなりません。わたしが彼女に命じたことは皆、守らせなければなりません」。"},{"ref":"Judg.13.15","start":7013015,"end":7013015,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"つかい"],[8,1,"い"],[28,1,"ひ"],[30,1,"と"],[42,1,"こ"],[46,1,"そな"]],"text":"マノアは主の使に言った、「どうぞ、わたしたちに、あなたを引き留めさせ、あなたのために子やぎを備えさせてください」。"},{"ref":"Judg.13.16","start":7013016,"end":7013016,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[8,1,"い"],[21,1,"ひ"],[23,1,"と"],[36,2,"しょくもつ"],[52,2,"はんさい"],[55,1,"そな"],[69,1,"しゅ"],[86,1,"かれ"],[88,1,"しゅ"],[90,1,"つかい"],[96,1,"し"]],"text":"主の使はマノアに言った、「あなたがわたしを引き留めても、わたしはあなたの食物をたべません。しかしあなたが燔祭を備えようとなさるのであれば、主にそれをささげなさい」。マノアは彼が主の使であるのを知らなかったからである。"},{"ref":"Judg.13.17","start":7013017,"end":7013017,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"つかい"],[8,1,"い"],[17,1,"な"],[32,1,"い"],[39,2,"じじつ"]],"text":"マノアは主の使に言った、「あなたの名はなんといいますか。あなたの言われたことが事実となったとき、わたしたちはあなたをあがめましょう」。"},{"ref":"Judg.13.18","start":7013018,"end":7013018,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,1,"かれ"],[6,1,"い"],[15,1,"な"],[17,3,"ふしぎ"]],"text":"主の使は彼に言った、「わたしの名は不思議です。どうしてあなたはそれをたずねるのですか」。"},{"ref":"Judg.13.19","start":7013019,"end":7013019,"break":"none","ruby":[[7,1,"こ"],[11,2,"そさい"],[18,1,"いわ"],[20,1,"うえ"],[25,1,"しゅ"],[32,1,"しゅ"],[34,3,"ふしぎ"],[50,1,"つま"],[55,1,"み"]],"text":"そこでマノアは子やぎと素祭とをとり、岩の上でそれを主にささげた。主は不思議なことをされ、マノアとその妻はそれを見た。"},{"ref":"Judg.13.20","start":7013020,"end":7013020,"break":"none","ruby":[[4,1,"ほのお"],[6,2,"さいだん"],[10,1,"てん"],[19,1,"しゅ"],[21,1,"つかい"],[23,2,"さいだん"],[26,1,"ほのお"],[45,1,"つま"],[47,1,"み"],[50,1,"ち"],[54,1,"ふ"]],"text":"すなわち炎が祭壇から天にあがったとき、主の使は祭壇の炎のうちにあってのぼった。マノアとその妻は見て、地にひれ伏した。"},{"ref":"Judg.13.21","start":7013021,"end":7013021,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[14,1,"つま"],[16,1,"あらわ"],[25,1,"とき"],[30,1,"かれ"],[32,1,"しゅ"],[34,1,"つかい"],[41,1,"し"]],"text":"主の使はふたたびマノアとその妻に現れなかった。その時マノアは彼が主の使であることを知った。"},{"ref":"Judg.13.22","start":7013022,"end":7013022,"break":"none","ruby":[[4,1,"つま"],[6,1,"む"],[10,1,"い"],[21,1,"かみ"],[23,1,"み"],[31,1,"し"]],"text":"マノアは妻に向かって言った、「わたしたちは神を見たから、きっと死ぬであろう」。"},{"ref":"Judg.13.23","start":7013023,"end":7013023,"break":"none","ruby":[[0,1,"つま"],[2,1,"かれ"],[4,1,"い"],[9,1,"しゅ"],[20,1,"ころ"],[24,1,"おも"],[39,1,"て"],[42,2,"はんさい"],[45,2,"そさい"],[73,1,"こと"],[82,1,"しめ"],[95,1,"いま"],[107,1,"こと"],[110,1,"つ"]],"text":"妻は彼に言った、「主がもし、わたしたちを殺そうと思われたのならば、わたしたちの手から燔祭と素祭をおうけにならなかったでしょう。またこれらのすべての事をわたしたちにお示しになるはずはなく、また今わたしたちにこのような事をお告げにならなかったでしょう」。"},{"ref":"Judg.13.24","start":7013024,"end":7013024,"break":"none","ruby":[[3,1,"おんな"],[5,1,"おとこ"],[7,1,"こ"],[9,1,"う"],[15,1,"な"],[22,1,"よ"],[28,1,"こ"],[30,2,"せいちょう"],[34,1,"しゅ"],[36,1,"かれ"],[38,1,"めぐ"]],"text":"やがて女は男の子を産んで、その名をサムソンと呼んだ。その子は成長し、主は彼を恵まれた。"},{"ref":"Judg.13.25","start":7013025,"end":7013025,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"れい"],[13,1,"あいだ"],[24,1,"はじ"],[27,1,"かれ"],[29,2,"かんどう"]],"text":"主の霊はゾラとエシタオルの間のマハネダンにおいて初めて彼を感動させた。"}]