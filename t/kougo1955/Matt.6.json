[{"ref":"Matt.6.1","start":40006001,"end":40006001,"break":"paragraph","ruby":[[0,2,"じぶん"],[3,1,"ぎ"],[6,1,"み"],[13,1,"ひと"],[15,1,"まえ"],[17,1,"おこな"],[25,2,"ちゅうい"],[42,1,"てん"],[53,1,"ちち"],[56,1,"むく"],[59,1,"う"]],"text":"自分の義を、見られるために人の前で行わないように、注意しなさい。もし、そうしないと、天にいますあなたがたの父から報いを受けることがないであろう。"},{"ref":"Matt.6.2","start":40006002,"end":40006002,"break":"paragraph","ruby":[[4,1,"ほどこ"],[9,1,"とき"],[13,3,"ぎぜんしゃ"],[19,1,"ひと"],[28,2,"かいどう"],[31,1,"まち"],[33,1,"なか"],[41,2,"じぶん"],[44,1,"まえ"],[50,1,"ふ"],[59,1,"い"],[66,1,"かれ"],[71,1,"むく"],[74,1,"う"]],"text":"だから、施しをする時には、偽善者たちが人にほめられるため会堂や町の中でするように、自分の前でラッパを吹きならすな。よく言っておくが、彼らはその報いを受けてしまっている。"},{"ref":"Matt.6.3","start":40006003,"end":40006003,"break":"none","ruby":[[4,1,"ほどこ"],[9,2,"ばあい"],[12,1,"みぎ"],[14,1,"て"],[23,1,"ひだり"],[25,1,"て"],[27,1,"し"]],"text":"あなたは施しをする場合、右の手のしていることを左の手に知らせるな。"},{"ref":"Matt.6.4","start":40006004,"end":40006004,"break":"none","ruby":[[10,1,"ほどこ"],[13,1,"かく"],[28,1,"かく"],[31,1,"こと"],[33,1,"み"],[43,1,"ちち"],[46,1,"むく"]],"text":"それは、あなたのする施しが隠れているためである。すると、隠れた事を見ておられるあなたの父は、報いてくださるであろう。"},{"ref":"Matt.6.5","start":40006005,"end":40006005,"break":"paragraph","ruby":[[2,1,"いの"],[4,1,"とき"],[8,3,"ぎぜんしゃ"],[21,1,"かれ"],[24,1,"ひと"],[26,1,"み"],[34,2,"かいどう"],[37,2,"おおどお"],[44,1,"た"],[47,1,"いの"],[52,1,"この"],[57,1,"い"],[64,1,"かれ"],[69,1,"むく"],[72,1,"う"]],"text":"また祈る時には、偽善者たちのようにするな。彼らは人に見せようとして、会堂や大通りのつじに立って祈ることを好む。よく言っておくが、彼らはその報いを受けてしまっている。"},{"ref":"Matt.6.6","start":40006006,"end":40006006,"break":"none","ruby":[[4,1,"いの"],[6,1,"とき"],[8,2,"じぶん"],[18,1,"と"],[20,1,"と"],[24,1,"かく"],[27,1,"ところ"],[39,1,"ちち"],[41,1,"いの"],[51,1,"かく"],[54,1,"こと"],[56,1,"み"],[66,1,"ちち"],[69,1,"むく"]],"text":"あなたは祈る時、自分のへやにはいり、戸を閉じて、隠れた所においでになるあなたの父に祈りなさい。すると、隠れた事を見ておられるあなたの父は、報いてくださるであろう。"},{"ref":"Matt.6.7","start":40006007,"end":40006007,"break":"none","ruby":[[3,1,"いの"],[5,2,"ばあい"],[8,3,"いほうじん"],[21,1,"いの"],[25,1,"かれ"],[28,2,"ことば"],[33,1,"おお"],[38,1,"き"],[48,1,"おも"]],"text":"また、祈る場合、異邦人のように、くどくどと祈るな。彼らは言葉かずが多ければ、聞きいれられるものと思っている。"},{"ref":"Matt.6.8","start":40006008,"end":40006008,"break":"none","ruby":[[4,1,"かれ"],[20,1,"ちち"],[23,1,"かみ"],[26,1,"もと"],[30,1,"さき"],[40,2,"ひつよう"],[47,1,"ぞん"]],"text":"だから、彼らのまねをするな。あなたがたの父なる神は、求めない先から、あなたがたに必要なものはご存じなのである。"},{"ref":"Matt.6.9","start":40006009,"end":40006009,"break":"none","breaks":[[18,"stanza"],[30,"line"]],"ruby":[[12,1,"いの"],[18,1,"てん"],[27,1,"ちち"],[30,2,"みな"]],"text":"だから、あなたがたはこう祈りなさい、天にいますわれらの父よ、御名があがめられますように。"},{"ref":"Matt.6.10","start":40006010,"end":40006010,"break":"line","breaks":[[10,"line"],[25,"line"]],"ruby":[[0,2,"みくに"],[15,1,"てん"],[17,1,"おこな"],[25,1,"ち"],[28,1,"おこな"]],"text":"御国がきますように。みこころが天に行われるとおり、地にも行われますように。"},{"ref":"Matt.6.11","start":40006011,"end":40006011,"break":"line","breaks":[[14,"line"]],"ruby":[[6,1,"ひ"],[10,2,"しょくもつ"],[19,1,"あた"]],"text":"わたしたちの日ごとの食物を、きょうもお与えください。"},{"ref":"Matt.6.12","start":40006012,"end":40006012,"break":"line","breaks":[[23,"line"]],"ruby":[[6,2,"ふさい"],[11,1,"もの"],[29,2,"ふさい"]],"text":"わたしたちに負債のある者をゆるしましたように、わたしたちの負債をもおゆるしください。"},{"ref":"Matt.6.13","start":40006013,"end":40006013,"break":"line","breaks":[[16,"line"]],"ruby":[[6,1,"こころ"],[9,1,"あ"],[16,1,"あ"],[19,1,"もの"],[23,1,"すく"]],"text":"わたしたちを試みに会わせないで、悪しき者からお救いください。"},{"ref":"Matt.6.14","start":40006014,"end":40006014,"break":"none","ruby":[[11,2,"ひとびと"],[32,1,"てん"],[34,1,"ちち"],[47,1,"くだ"]],"text":"もしも、あなたがたが、人々のあやまちをゆるすならば、あなたがたの天の父も、あなたがたをゆるして下さるであろう。"},{"ref":"Matt.6.15","start":40006015,"end":40006015,"break":"none","ruby":[[2,1,"ひと"],[19,1,"ちち"],[37,1,"くだ"]],"text":"もし人をゆるさないならば、あなたがたの父も、あなたがたのあやまちをゆるして下さらないであろう。"},{"ref":"Matt.6.16","start":40006016,"end":40006016,"break":"paragraph","ruby":[[2,2,"だんじき"],[7,1,"とき"],[11,3,"ぎぜんしゃ"],[21,2,"いんき"],[24,1,"かお"],[32,1,"かれ"],[35,2,"だんじき"],[45,1,"ひと"],[47,1,"み"],[55,2,"じぶん"],[58,1,"かお"],[60,2,"みぐる"],[73,1,"い"],[80,1,"かれ"],[85,1,"むく"],[88,1,"う"]],"text":"また断食をする時には、偽善者がするように、陰気な顔つきをするな。彼らは断食をしていることを人に見せようとして、自分の顔を見苦しくするのである。よく言っておくが、彼らはその報いを受けてしまっている。"},{"ref":"Matt.6.17","start":40006017,"end":40006017,"break":"none","ruby":[[6,2,"だんじき"],[11,1,"とき"],[15,2,"じぶん"],[18,1,"あたま"],[20,1,"あぶら"],[22,1,"ぬ"],[25,1,"かお"],[27,1,"あら"]],"text":"あなたがたは断食をする時には、自分の頭に油を塗り、顔を洗いなさい。"},{"ref":"Matt.6.18","start":40006018,"end":40006018,"break":"none","ruby":[[3,2,"だんじき"],[13,1,"ひと"],[15,1,"し"],[21,1,"かく"],[24,1,"ところ"],[36,1,"ちち"],[38,1,"し"],[52,1,"かく"],[55,1,"こと"],[57,1,"み"],[67,1,"ちち"],[70,1,"むく"],[73,1,"くだ"]],"text":"それは断食をしていることが人に知れないで、隠れた所においでになるあなたの父に知られるためである。すると、隠れた事を見ておられるあなたの父は、報いて下さるであろう。"},{"ref":"Matt.6.19","start":40006019,"end":40006019,"break":"paragraph","ruby":[[6,2,"じぶん"],[13,1,"むし"],[15,1,"く"],[27,2,"ぬすびと"],[31,1,"お"],[33,1,"い"],[36,1,"ぬす"],[38,1,"だ"],[43,2,"ちじょう"],[47,1,"たから"]],"text":"あなたがたは自分のために、虫が食い、さびがつき、また、盗人らが押し入って盗み出すような地上に、宝をたくわえてはならない。"},{"ref":"Matt.6.20","start":40006020,"end":40006020,"break":"none","ruby":[[3,2,"じぶん"],[9,1,"むし"],[11,1,"く"],[25,2,"ぬすびと"],[29,1,"お"],[31,1,"い"],[34,1,"ぬす"],[36,1,"だ"],[43,1,"てん"],[46,1,"たから"]],"text":"むしろ自分のため、虫も食わず、さびもつかず、また、盗人らが押し入って盗み出すこともない天に、宝をたくわえなさい。"},{"ref":"Matt.6.21","start":40006021,"end":40006021,"break":"none","ruby":[[4,1,"たから"],[8,1,"ところ"],[12,1,"こころ"]],"text":"あなたの宝のある所には、心もあるからである。"},{"ref":"Matt.6.22","start":40006022,"end":40006022,"break":"none","ruby":[[0,1,"め"],[21,1,"め"],[23,1,"す"],[30,2,"ぜんしん"],[33,1,"あか"]],"text":"目はからだのあかりである。だから、あなたの目が澄んでおれば、全身も明るいだろう。"},{"ref":"Matt.6.23","start":40006023,"end":40006023,"break":"none","ruby":[[8,1,"め"],[10,1,"わる"],[15,2,"ぜんしん"],[18,1,"くら"],[34,1,"うち"],[37,1,"ひかり"],[39,1,"くら"],[46,1,"くら"]],"text":"しかし、あなたの目が悪ければ、全身も暗いだろう。だから、もしあなたの内なる光が暗ければ、その暗さは、どんなであろう。"},{"ref":"Matt.6.24","start":40006024,"end":40006024,"break":"none","ruby":[[8,2,"しゅじん"],[11,1,"か"],[13,1,"つか"],[24,2,"いっぽう"],[27,1,"にく"],[30,2,"たほう"],[33,1,"あい"],[41,2,"いっぽう"],[44,1,"した"],[48,2,"たほう"],[69,1,"かみ"],[71,1,"とみ"],[74,1,"か"],[76,1,"つか"]],"text":"だれも、ふたりの主人に兼ね仕えることはできない。一方を憎んで他方を愛し、あるいは、一方に親しんで他方をうとんじるからである。あなたがたは、神と富とに兼ね仕えることはできない。"},{"ref":"Matt.6.25","start":40006025,"end":40006025,"break":"paragraph","ruby":[[12,1,"い"],[18,1,"なに"],[20,1,"た"],[26,1,"なに"],[28,1,"の"],[34,2,"じぶん"],[37,1,"いのち"],[42,1,"おも"],[49,1,"なに"],[51,1,"き"],[56,2,"じぶん"],[66,1,"おも"],[74,1,"いのち"],[76,2,"しょくもつ"],[87,2,"きもの"]],"text":"それだから、あなたがたに言っておく。何を食べようか、何を飲もうかと、自分の命のことで思いわずらい、何を着ようかと自分のからだのことで思いわずらうな。命は食物にまさり、からだは着物にまさるではないか。"},{"ref":"Matt.6.26","start":40006026,"end":40006026,"break":"none","ruby":[[0,1,"そら"],[2,1,"とり"],[4,1,"み"],[16,1,"か"],[24,1,"くら"],[26,1,"と"],[50,1,"てん"],[52,1,"ちち"],[54,1,"かれ"],[57,1,"やしな"],[62,1,"くだ"],[72,1,"かれ"],[86,1,"もの"]],"text":"空の鳥を見るがよい。まくことも、刈ることもせず、倉に取りいれることもしない。それだのに、あなたがたの天の父は彼らを養っていて下さる。あなたがたは彼らよりも、はるかにすぐれた者ではないか。"},{"ref":"Matt.6.27","start":40006027,"end":40006027,"break":"none","ruby":[[12,1,"おも"],[24,2,"じぶん"],[27,2,"じゅみょう"],[35,1,"の"]],"text":"あなたがたのうち、だれが思いわずらったからとて、自分の寿命をわずかでも延ばすことができようか。"},{"ref":"Matt.6.28","start":40006028,"end":40006028,"break":"none","ruby":[[6,2,"きもの"],[12,1,"おも"],[21,1,"の"],[23,1,"はな"],[29,1,"そだ"],[36,1,"かんが"],[39,1,"み"],[45,1,"はたら"],[51,1,"つむ"]],"text":"また、なぜ、着物のことで思いわずらうのか。野の花がどうして育っているか、考えて見るがよい。働きもせず、紡ぎもしない。"},{"ref":"Matt.6.29","start":40006029,"end":40006029,"break":"none","ruby":[[10,1,"い"],[14,2,"えいが"],[21,1,"とき"],[33,1,"はな"],[41,2,"きかざ"]],"text":"しかし、あなたがたに言うが、栄華をきわめた時のソロモンでさえ、この花の一つほどにも着飾ってはいなかった。"},{"ref":"Matt.6.30","start":40006030,"end":40006030,"break":"none","ruby":[[4,1,"は"],[13,1,"ろ"],[15,1,"な"],[17,1,"い"],[22,1,"の"],[24,1,"くさ"],[29,1,"かみ"],[36,1,"よそお"],[39,1,"くだ"],[55,2,"いじょう"],[78,2,"しんこう"],[81,1,"うす"],[83,1,"もの"]],"text":"きょうは生えていて、あすは炉に投げ入れられる野の草でさえ、神はこのように装って下さるのなら、あなたがたに、それ以上よくしてくださらないはずがあろうか。ああ、信仰の薄い者たちよ。"},{"ref":"Matt.6.31","start":40006031,"end":40006031,"break":"none","ruby":[[4,1,"なに"],[6,1,"た"],[12,1,"なに"],[14,1,"の"],[23,1,"なに"],[25,1,"き"],[30,1,"い"],[33,1,"おも"]],"text":"だから、何を食べようか、何を飲もうか、あるいは何を着ようかと言って思いわずらうな。"},{"ref":"Matt.6.32","start":40006032,"end":40006032,"break":"none","ruby":[[10,3,"いほうじん"],[14,1,"せつ"],[16,1,"もと"],[33,1,"てん"],[35,1,"ちち"],[57,2,"ひつよう"],[66,1,"ぞん"]],"text":"これらのものはみな、異邦人が切に求めているものである。あなたがたの天の父は、これらのものが、ことごとくあなたがたに必要であることをご存じである。"},{"ref":"Matt.6.33","start":40006033,"end":40006033,"break":"none","ruby":[[2,1,"かみ"],[4,1,"くに"],[6,1,"かみ"],[8,1,"ぎ"],[11,1,"もと"],[34,1,"そ"],[37,1,"あた"]],"text":"まず神の国と神の義とを求めなさい。そうすれば、これらのものは、すべて添えて与えられるであろう。"},{"ref":"Matt.6.34","start":40006034,"end":40006034,"break":"none","ruby":[[10,1,"おも"],[27,2,"じしん"],[30,1,"おも"],[42,1,"にち"],[44,2,"くろう"],[50,1,"ひ"],[52,1,"にち"],[56,2,"じゅうぶん"]],"text":"だから、あすのことを思いわずらうな。あすのことは、あす自身が思いわずらうであろう。一日の苦労は、その日一日だけで十分である。"}]