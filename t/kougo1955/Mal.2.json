[{"ref":"Mal.2.1","start":39002001,"end":39002001,"break":"paragraph","ruby":[[0,2,"さいし"],[6,1,"いま"],[9,2,"めいれい"],[18,1,"あた"]],"text":"祭司たちよ、今この命令があなたがたに与えられる。"},{"ref":"Mal.2.2","start":39002002,"end":39002002,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[18,1,"き"],[20,1,"したが"],[29,1,"こころ"],[31,1,"と"],[37,1,"な"],[39,2,"えいこう"],[42,1,"き"],[60,1,"うえ"],[67,1,"おく"],[78,2,"しゅくふく"],[85,1,"か"],[99,1,"こころ"],[101,1,"と"]],"text":"万軍の主は言われる、あなたがたがもし聞き従わず、またこれを心に留めず、わが名に栄光を帰さないならば、わたしはあなたがたの上に、のろいを送り、またあなたがたの祝福をのろいに変える。あなたがたは、これを心に留めないので、わたしはすでにこれをのろった。"},{"ref":"Mal.2.3","start":39002003,"end":39002003,"break":"none","ruby":[[0,1,"み"],[13,2,"しそん"],[16,1,"せ"],[28,2,"ぎせい"],[31,1,"ふん"],[40,1,"かお"],[42,1,"うえ"],[46,1,"ち"],[60,1,"まえ"],[63,1,"しりぞ"]],"text":"見よ、わたしはあなたがたの子孫を責める。またあなたがたの犠牲の糞を、あなたがたの顔の上にまき散らし、あなたがたをわたしの前から退ける。"},{"ref":"Mal.2.4","start":39002004,"end":39002004,"break":"none","ruby":[[11,2,"めいれい"],[20,1,"あた"],[29,1,"むす"],[34,2,"けいやく"],[38,1,"たも"],[57,1,"し"],[66,2,"ばんぐん"],[69,1,"しゅ"],[71,1,"い"]],"text":"こうしてわたしが、この命令をあなたがたに与えたのは、レビと結んだわが契約が、保たれるためであることを、あなたがたが知るためであると、万軍の主は言われる。"},{"ref":"Mal.2.5","start":39002005,"end":39002005,"break":"none","ruby":[[0,1,"かれ"],[2,1,"むす"],[7,2,"けいやく"],[11,2,"せいめい"],[14,2,"へいあん"],[18,2,"けいやく"],[32,1,"かれ"],[34,1,"あた"],[40,1,"かれ"],[46,1,"おそ"],[57,1,"かれ"],[66,1,"おそ"],[71,1,"な"],[73,1,"まえ"]],"text":"彼と結んだわが契約は、生命と平安との契約であって、わたしがこれを彼に与えたのは、彼にわたしを恐れさせるためである。彼はすでにわたしを恐れ、わが名の前におののいた。"},{"ref":"Mal.2.6","start":39002006,"end":39002006,"break":"none","ruby":[[0,1,"かれ"],[2,1,"くち"],[10,2,"りっぽう"],[25,2,"ふぎ"],[28,1,"み"],[36,1,"かれ"],[38,2,"へいあん"],[41,2,"こうぎ"],[53,1,"とも"],[55,1,"あゆ"],[60,1,"おお"],[63,1,"ひと"],[65,2,"ふぎ"],[69,1,"た"],[71,1,"かえ"]],"text":"彼の口には、まことの律法があり、そのくちびるには、不義が見られなかった。彼は平安と公義とをもって、わたしと共に歩み、また多くの人を不義から立ち返らせた。"},{"ref":"Mal.2.7","start":39002007,"end":39002007,"break":"none","ruby":[[0,2,"さいし"],[8,2,"ちしき"],[11,1,"たも"],[14,2,"ひとびと"],[17,1,"かれ"],[19,1,"くち"],[22,2,"りっぽう"],[25,1,"たず"],[30,2,"とうぜん"],[36,1,"かれ"],[38,2,"ばんぐん"],[41,1,"しゅ"],[43,2,"ししゃ"]],"text":"祭司のくちびるは知識を保ち、人々が彼の口から律法を尋ねるのが当然である。彼は万軍の主の使者だからだ。"},{"ref":"Mal.2.8","start":39002008,"end":39002008,"break":"none","ruby":[[11,1,"みち"],[13,1,"はな"],[16,1,"おお"],[19,1,"ひと"],[21,1,"おし"],[33,2,"けいやく"],[36,1,"やぶ"],[41,2,"ばんぐん"],[44,1,"しゅ"],[46,1,"い"]],"text":"ところが、あなたがたは道を離れ、多くの人を教えてつまずかせ、レビの契約を破ったと、万軍の主は言われる。"},{"ref":"Mal.2.9","start":39002009,"end":39002009,"break":"none","ruby":[[10,1,"みち"],[12,1,"まも"],[16,2,"りっぽう"],[19,1,"おし"],[23,1,"あた"],[27,1,"ひと"],[49,1,"たみ"],[51,1,"まえ"],[53,1,"あなど"],[57,1,"いや"]],"text":"あなたがたはわたしの道を守らず、律法を教えるに当って、人にかたよったがために、あなたがたをすべての民の前に侮られ、卑しめられるようにする」。"},{"ref":"Mal.2.10","start":39002010,"end":39002010,"break":"paragraph","ruby":[[5,1,"ちち"],[7,1,"みな"],[21,1,"つく"],[24,1,"かみ"],[44,2,"せんぞ"],[49,2,"けいやく"],[52,1,"やぶ"],[62,2,"きょうだい"],[65,1,"いつわ"],[68,1,"おこな"]],"text":"われわれの父は皆一つではないか。われわれを造った神は一つではないか。なにゆえ、われわれは先祖たちの契約を破って、おのおのその兄弟に偽りを行うのか。"},{"ref":"Mal.2.11","start":39002011,"end":39002011,"break":"none","ruby":[[3,1,"いつわ"],[6,1,"おこな"],[23,1,"なか"],[26,1,"にく"],[30,1,"こと"],[32,1,"おこな"],[44,1,"しゅ"],[46,1,"あい"],[53,2,"せいじょ"],[56,1,"けが"],[60,1,"た"],[62,1,"かみ"],[64,1,"つか"],[67,1,"おんな"]],"text":"ユダは偽りを行い、イスラエルおよびエルサレムの中には憎むべき事が行われた。すなわちユダは主が愛しておられる聖所を汚して、他の神に仕える女をめとった。"},{"ref":"Mal.2.12","start":39002012,"end":39002012,"break":"none","ruby":[[4,1,"しゅ"],[10,1,"こと"],[12,1,"おこな"],[14,1,"ひと"],[18,2,"しょうげん"],[22,1,"もの"],[25,2,"とうべん"],[29,1,"もの"],[34,2,"ばんぐん"],[37,1,"しゅ"],[42,1,"もの"],[46,1,"もの"],[54,2,"まくや"],[58,1,"た"]],"text":"どうか、主がこうした事を行う人をば、証言する者も、答弁する者も、また万軍の主にささげ物をする者をも、ヤコブの幕屋から断たれるように。"},{"ref":"Mal.2.13","start":39002013,"end":39002013,"break":"paragraph","ruby":[[13,1,"こと"],[22,1,"かみ"],[30,1,"もの"],[49,1,"て"],[53,1,"よろこ"],[56,1,"う"],[72,1,"なみだ"],[75,1,"な"],[81,1,"なげ"],[89,1,"しゅ"],[91,2,"さいだん"]],"text":"あなたがたはまたこのような事をする。すなわち神がもはやささげ物をかえりみず、またこれをあなたがたの手から、喜んで受けられないために、あなたがたは涙と、泣くことと、嘆きとをもって、主の祭壇をおおい、"},{"ref":"Mal.2.14","start":39002014,"end":39002014,"break":"none","ruby":[[3,1,"かみ"],[5,1,"う"],[15,1,"たず"],[22,1,"しゅ"],[33,1,"わか"],[35,1,"とき"],[37,1,"つま"],[40,1,"あいだ"],[43,2,"けいやく"],[46,2,"しょうにん"],[57,2,"かのじょ"],[65,1,"つ"],[67,1,"あ"],[70,2,"けいやく"],[79,1,"つま"],[90,2,"かのじょ"],[93,2,"うらぎ"]],"text":"「なぜ神は受けられないのか」と尋ねる。これは主があなたと、あなたの若い時の妻との間の、契約の証人だったからである。彼女は、あなたの連れ合い、契約によるあなたの妻であるのに、あなたは彼女を裏切った。"},{"ref":"Mal.2.15","start":39002015,"end":39002015,"break":"none","ruby":[[2,1,"かみ"],[13,1,"いのち"],[15,1,"れい"],[17,1,"つく"],[35,1,"かれ"],[37,1,"なに"],[39,1,"のぞ"],[45,1,"かみ"],[47,1,"うやま"],[49,2,"しそん"],[67,1,"つつし"],[73,1,"わか"],[75,1,"とき"],[77,1,"つま"],[79,2,"うらぎ"]],"text":"一つ神は、われわれのために命の霊を造り、これをささえられたではないか。彼は何を望まれるか。神を敬う子孫であるゆえ、あなたがたはみずから慎んで、その若い時の妻を裏切ってはならない。"},{"ref":"Mal.2.16","start":39002016,"end":39002016,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"い"],[20,2,"りえん"],[24,1,"もの"],[26,1,"にく"],[42,1,"ころも"],[47,1,"ひと"],[49,1,"にく"],[53,2,"ばんぐん"],[56,1,"しゅ"],[58,1,"い"],[70,1,"つつし"],[74,2,"うらぎ"]],"text":"イスラエルの神、主は言われる、「わたしは離縁する者を憎み、また、しえたげをもってその衣をおおう人を憎むと、万軍の主は言われる。ゆえにみずから慎んで、裏切ることをしてはならない」。"},{"ref":"Mal.2.17","start":39002017,"end":39002017,"break":"paragraph","ruby":[[6,2,"ことば"],[12,1,"しゅ"],[14,1,"わずら"],[28,1,"い"],[44,1,"かれ"],[46,1,"わずら"],[66,1,"あく"],[68,1,"おこな"],[70,1,"もの"],[72,1,"しゅ"],[74,1,"め"],[76,1,"よ"],[78,1,"み"],[83,1,"かれ"],[85,1,"よろこ"],[91,1,"い"],[101,1,"おこな"],[103,1,"かみ"],[113,1,"い"]],"text":"あなたがたは言葉をもって主を煩わした。しかしあなたがたは言う、「われわれはどんなふうに、彼を煩わしたか」。それはあなたがたが「すべて悪を行う者は主の目に良く見え、かつ彼に喜ばれる」と言い、また「さばきを行う神はどこにあるか」と言うからである。"}]