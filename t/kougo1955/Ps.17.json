[{"ref":"Ps.17.1","start":19017001,"end":19017001,"break":"paragraph","title":"ダビデの祈","breaks":[[25,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"ただ"],[6,1,"うった"],[9,1,"き"],[16,1,"さけ"],[20,1,"こころ"],[25,1,"いつわ"],[36,1,"で"],[42,1,"いのり"],[44,1,"みみ"],[46,1,"かたむ"]],"titleRuby":[[4,1,"いのり"]],"text":"主よ、正しい訴えを聞き、わたしの叫びにみ心をとめ、偽りのないくちびるから出るわたしの祈に耳を傾けてください。"},{"ref":"Ps.17.2","start":19017002,"end":19017002,"break":"line","breaks":[[21,"line"]],"ruby":[[11,2,"せんこく"],[15,1,"まえ"],[18,1,"で"],[25,1,"め"],[27,2,"こうへい"]],"text":"どうかわたしについての宣告がみ前から出て、あなたの目が公平をみられるように。"},{"ref":"Ps.17.3","start":19017003,"end":19017003,"break":"line","breaks":[[23,"line"],[41,"line"],[62,"line"]],"ruby":[[8,1,"こころ"],[14,1,"よる"],[20,1,"のぞ"],[27,1,"こころ"],[44,1,"わる"],[46,1,"おも"],[50,1,"み"],[66,1,"くち"],[68,1,"つみ"],[70,1,"おか"]],"text":"あなたがわたしの心をためし、夜、わたしに臨み、わたしを試みられても、わたしのうちになんの悪い思いをも見いだされないでしょう。わたしの口も罪を犯しません。"},{"ref":"Ps.17.4","start":19017004,"end":19017004,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[0,1,"ひと"],[7,1,"こと"],[22,2,"ことば"],[33,2,"ふほう"],[36,1,"もの"],[38,1,"みち"],[40,1,"さ"]],"text":"人のおこないの事をいえば、あなたのくちびるの言葉によって、わたしは不法な者の道を避けました。"},{"ref":"Ps.17.5","start":19017005,"end":19017005,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"あゆ"],[11,1,"みち"],[13,1,"かた"],[15,1,"た"],[22,1,"あし"]],"text":"わたしの歩みはあなたの道に堅く立ち、わたしの足はすべることがなかったのです。"},{"ref":"Ps.17.6","start":19017006,"end":19017006,"break":"line","breaks":[[18,"line"],[33,"line"],[42,"line"]],"ruby":[[0,1,"かみ"],[11,1,"よ"],[26,1,"こた"],[36,1,"みみ"],[38,1,"かたむ"],[46,1,"の"],[53,1,"き"]],"text":"神よ、わたしはあなたに呼ばわります。あなたはわたしに答えられます。どうか耳を傾けて、わたしの述べることをお聞きください。"},{"ref":"Ps.17.7","start":19017007,"end":19017007,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"よ"],[2,1,"たの"],[4,1,"もの"],[12,1,"みぎ"],[14,1,"て"],[16,1,"すく"],[20,1,"もの"],[33,1,"おどろ"]],"text":"寄り頼む者をそのあだから右の手で救われる者よ、あなたのいつくしみを驚くばかりにあらわし、"},{"ref":"Ps.17.8","start":19017008,"end":19017008,"break":"line","breaks":[[14,"line"]],"ruby":[[11,1,"まも"],[19,1,"かげ"],[25,1,"かく"]],"text":"ひとみのようにわたしを守り、みつばさの陰にわたしを隠し、"},{"ref":"Ps.17.9","start":19017009,"end":19017009,"break":"line","breaks":[[16,"line"]],"ruby":[[9,1,"あ"],[12,1,"もの"],[20,1,"かこ"],[22,1,"おそ"],[26,1,"てき"]],"text":"わたしをしえたげる悪しき者から、わたしを囲む恐ろしい敵から、のがれさせてください。"},{"ref":"Ps.17.10","start":19017010,"end":19017010,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[5,1,"こころ"],[7,1,"と"],[22,1,"くち"],[27,1,"たか"],[31,1,"かた"]],"text":"彼らはその心を閉じて、あわれむことなく、その口をもって高ぶって語るのです。"},{"ref":"Ps.17.11","start":19017011,"end":19017011,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[7,1,"お"],[16,1,"かこ"],[23,1,"ち"],[25,1,"な"],[27,1,"たお"],[34,1,"め"]],"text":"彼らはわたしを追いつめ、わたしを囲み、わたしを地に投げ倒さんと、その目をそそぎます。"},{"ref":"Ps.17.12","start":19017012,"end":19017012,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[5,1,"さ"],[21,1,"かく"],[24,1,"ところ"],[29,1,"ま"],[31,1,"こ"]],"text":"彼らはかき裂かんと、いらだつししのごとく、隠れた所にひそみ待つ子じしのようです。"},{"ref":"Ps.17.13","start":19017013,"end":19017013,"break":"line","breaks":[[19,"line"],[30,"line"],[43,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"た"],[10,1,"かれ"],[13,1,"た"],[19,1,"かれ"],[22,1,"たお"],[37,1,"あ"],[40,1,"もの"],[52,1,"すく"]],"text":"主よ、立ちあがって、彼らに立ちむかい、彼らを倒してください。つるぎをもって悪しき者からわたしのいのちをお救いください。"},{"ref":"Ps.17.14","start":19017014,"end":19017014,"break":"line","breaks":[[25,"line"],[43,"line"],[61,"line"],[79,"line"],[92,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"て"],[9,2,"ひとびと"],[18,1,"すく"],[29,2,"じぶん"],[32,1,"わ"],[34,1,"まえ"],[38,1,"よ"],[40,1,"う"],[47,1,"たから"],[54,1,"はら"],[56,1,"み"],[61,1,"よ"],[63,2,"ひとびと"],[72,1,"すく"],[79,1,"かれ"],[82,1,"おお"],[85,1,"こ"],[87,1,"あ"],[89,1,"た"],[94,1,"とみ"],[96,1,"おさ"],[98,1,"ご"],[100,1,"のこ"]],"text":"主よ、み手をもって人々からわたしをお救いください。すなわち自分の分け前をこの世で受け、あなたの宝をもってその腹を満たされる世の人々からわたしをお救いください。彼らは多くの子に飽き足り、その富を幼な子に残すのです。"},{"ref":"Ps.17.15","start":19017015,"end":19017015,"break":"line","breaks":[[18,"line"]],"ruby":[[7,1,"ぎ"],[14,1,"かお"],[16,1,"み"],[18,1,"め"],[22,1,"とき"],[29,1,"み"],[32,1,"み"],[34,1,"た"]],"text":"しかしわたしは義にあって、み顔を見、目ざめる時、みかたちを見て、満ち足りるでしょう。"}]