[{"ref":"Mal.3.1","start":39003001,"end":39003001,"break":"paragraph","ruby":[[1,1,"み"],[10,2,"ししゃ"],[18,1,"かれ"],[24,1,"まえ"],[26,1,"みち"],[28,1,"そな"],[40,1,"もと"],[43,1,"ところ"],[45,1,"しゅ"],[54,1,"みや"],[56,1,"く"],[59,1,"み"],[68,1,"よろこ"],[70,2,"けいやく"],[73,2,"ししゃ"],[76,1,"く"],[80,2,"ばんぐん"],[83,1,"しゅ"],[85,1,"い"]],"text":"「見よ、わたしはわが使者をつかわす。彼はわたしの前に道を備える。またあなたがたが求める所の主は、たちまちその宮に来る。見よ、あなたがたの喜ぶ契約の使者が来ると、万軍の主が言われる。"},{"ref":"Mal.3.2","start":39003002,"end":39003002,"break":"none","breaks":[[37,"paragraph"]],"ruby":[[2,1,"く"],[4,1,"ひ"],[11,1,"た"],[13,1,"え"],[24,1,"とき"],[31,1,"た"],[33,1,"え"],[37,1,"かれ"],[39,1,"きん"],[46,1,"もの"],[48,1,"ひ"],[56,1,"ぬの"],[61,2,"あく"]],"text":"その来る日には、だれが耐え得よう。そのあらわれる時には、だれが立ち得よう。彼は金をふきわける者の火のようであり、布さらしの灰汁のようである。"},{"ref":"Mal.3.3","start":39003003,"end":39003003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ぎん"],[9,1,"きよ"],[12,1,"もの"],[17,1,"ざ"],[24,2,"しそん"],[27,1,"きよ"],[30,2,"きんぎん"],[36,1,"かれ"],[39,1,"きよ"],[46,1,"かれ"],[49,1,"ぎ"],[58,1,"もの"],[60,1,"しゅ"]],"text":"彼は銀をふきわけて清める者のように座して、レビの子孫を清め、金銀のように彼らを清める。そして彼らは義をもって、ささげ物を主にささげる。"},{"ref":"Mal.3.4","start":39003004,"end":39003004,"break":"none","ruby":[[2,1,"とき"],[16,1,"もの"],[19,1,"むかし"],[21,1,"ひ"],[29,1,"さき"],[31,1,"とし"],[36,1,"しゅ"],[38,1,"よろこ"]],"text":"その時ユダとエルサレムとのささげ物は、昔の日のように、また先の年のように主に喜ばれる。"},{"ref":"Mal.3.5","start":39003005,"end":39003005,"break":"paragraph","ruby":[[13,1,"ちか"],[25,1,"うらな"],[27,1,"もの"],[29,2,"かんいん"],[32,1,"おこな"],[34,1,"もの"],[36,1,"いつわ"],[39,1,"ちか"],[44,1,"もの"],[50,2,"やといにん"],[53,2,"ちんぎん"],[76,2,"きりゅう"],[79,2,"たこく"],[81,1,"じん"],[83,1,"お"],[92,1,"おそ"],[96,1,"もの"],[114,1,"た"],[119,2,"ばんぐん"],[122,1,"しゅ"],[124,1,"い"]],"text":"そしてわたしはあなたがたに近づいて、さばきをなし、占い者、姦淫を行う者、偽りの誓いをなす者にむかい、雇人の賃銀をかすめ、やもめと、みなしごとをしえたげ、寄留の他国人を押しのけ、わたしを恐れない者どもにむかって、すみやかにあかしを立てると、万軍の主は言われる。"},{"ref":"Mal.3.6","start":39003006,"end":39003006,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"かわ"],[24,1,"こ"],[34,1,"ほろ"]],"text":"主なるわたしは変ることがない。それゆえ、ヤコブの子らよ、あなたがたは滅ぼされない。"},{"ref":"Mal.3.7","start":39003007,"end":39003007,"break":"none","ruby":[[9,2,"せんぞ"],[12,1,"ひ"],[18,1,"さだ"],[21,1,"はな"],[28,1,"まも"],[39,1,"かえ"],[52,1,"かえ"],[57,2,"ばんぐん"],[60,1,"しゅ"],[62,1,"い"],[88,1,"かえ"],[94,1,"たず"]],"text":"あなたがたは、その先祖の日から、わが定めを離れて、これを守らなかった。わたしに帰れ、わたしはあなたがたに帰ろうと、万軍の主は言われる。ところが、あなたがたは『われわれはどうして帰ろうか』と尋ねる。"},{"ref":"Mal.3.8","start":39003008,"end":39003008,"break":"none","ruby":[[0,1,"ひと"],[2,1,"かみ"],[4,1,"もの"],[6,1,"ぬす"],[32,1,"もの"],[34,1,"ぬす"],[63,1,"もの"],[65,1,"ぬす"],[74,1,"い"],[78,1,"ぶん"],[86,1,"もの"]],"text":"人は神の物を盗むことをするだろうか。しかしあなたがたは、わたしの物を盗んでいる。あなたがたはまた『どうしてわれわれは、あなたの物を盗んでいるのか』と言う。十分の一と、ささげ物をもってである。"},{"ref":"Mal.3.9","start":39003009,"end":39003009,"break":"none","ruby":[[30,2,"こくみん"],[38,1,"もの"],[40,1,"ぬす"]],"text":"あなたがたは、のろいをもって、のろわれる。あなたがたすべての国民は、わたしの物を盗んでいるからである。"},{"ref":"Mal.3.10","start":39003010,"end":39003010,"break":"none","ruby":[[4,1,"みや"],[6,2,"しょくもつ"],[16,1,"ぶん"],[19,2,"ぜんぶ"],[26,1,"くら"],[28,1,"たずさ"],[46,1,"こころ"],[53,1,"てん"],[55,1,"まど"],[57,1,"ひら"],[65,1,"めぐ"],[75,1,"そそ"],[78,1,"いな"],[81,1,"み"],[87,2,"ばんぐん"],[90,1,"しゅ"],[92,1,"い"]],"text":"わたしの宮に食物のあるように、十分の一全部をわたしの倉に携えてきなさい。これをもってわたしを試み、わたしが天の窓を開いて、あふるる恵みを、あなたがたに注ぐか否かを見なさいと、万軍の主は言われる。"},{"ref":"Mal.3.11","start":39003011,"end":39003011,"break":"none","ruby":[[4,1,"く"],[6,1,"ほろ"],[9,1,"もの"],[32,1,"ち"],[34,2,"さんぶつ"],[38,1,"ほろ"],[63,1,"き"],[68,1,"じゅく"],[71,1,"まえ"],[76,1,"み"],[78,1,"はたけ"],[80,1,"おと"],[95,2,"ばんぐん"],[98,1,"しゅ"],[100,1,"い"]],"text":"わたしは食い滅ぼす者を、あなたがたのためにおさえて、あなたがたの地の産物を、滅ぼさないようにしよう。また、あなたがたのぶどうの木が、その熟する前に、その実を畑に落すことのないようにしようと、万軍の主は言われる。"},{"ref":"Mal.3.12","start":39003012,"end":39003012,"break":"none","ruby":[[4,2,"ばんこく"],[7,1,"ひと"],[16,2,"しゅくふく"],[21,1,"もの"],[38,1,"たの"],[41,1,"ち"],[52,2,"ばんぐん"],[55,1,"しゅ"],[57,1,"い"]],"text":"こうして万国の人は、あなたがたを祝福された者ととなえるであろう。あなたがたは楽しい地となるからであると、万軍の主は言われる。"},{"ref":"Mal.3.13","start":39003013,"end":39003013,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[13,2,"ことば"],[16,1,"はげ"],[26,1,"さか"],[50,1,"さか"],[58,1,"こと"],[60,1,"い"],[66,1,"い"]],"text":"主は言われる、あなたがたは言葉を激しくして、わたしに逆らった。しかもあなたがたは『われわれはあなたに逆らって、どんな事を言ったか』と言う。"},{"ref":"Mal.3.14","start":39003014,"end":39003014,"break":"none","ruby":[[6,1,"い"],[11,1,"かみ"],[13,1,"つか"],[16,1,"こと"],[31,2,"めいれい"],[34,1,"まも"],[39,2,"ばんぐん"],[42,1,"しゅ"],[44,1,"まえ"],[47,1,"かな"],[51,1,"ある"],[64,1,"えき"]],"text":"あなたがたは言った、『神に仕える事はつまらない。われわれがその命令を守り、かつ万軍の主の前に、悲しんで歩いたからといって、なんの益があるか。"},{"ref":"Mal.3.15","start":39003015,"end":39003015,"break":"none","ruby":[[0,1,"いま"],[6,1,"たか"],[9,1,"もの"],[12,2,"しゅくふく"],[17,1,"もの"],[19,1,"おも"],[22,1,"あく"],[24,1,"おこな"],[26,1,"もの"],[28,1,"さか"],[38,1,"かみ"],[40,1,"こころ"],[44,1,"ばっ"]],"text":"今われわれは高ぶる者を、祝福された者と思う。悪を行う者は栄えるばかりでなく、神を試みても罰せられない』」。"},{"ref":"Mal.3.16","start":39003016,"end":39003016,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,1,"おそ"],[10,1,"もの"],[12,1,"たがい"],[14,1,"かた"],[18,1,"しゅ"],[20,1,"みみ"],[22,1,"かたむ"],[28,1,"き"],[36,1,"しゅ"],[38,1,"おそ"],[41,1,"もの"],[48,1,"な"],[50,1,"こころ"],[52,1,"と"],[57,1,"もの"],[63,1,"しゅ"],[65,1,"まえ"],[70,1,"おぼ"],[72,1,"がき"]],"text":"そのとき、主を恐れる者は互に語った。主は耳を傾けてこれを聞かれた。そして主を恐れる者、およびその名を心に留めている者のために、主の前に一つの覚え書がしるされた。"},{"ref":"Mal.3.17","start":39003017,"end":39003017,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[6,1,"い"],[11,1,"かれ"],[18,1,"て"],[20,1,"くだ"],[23,1,"こと"],[25,1,"おこな"],[27,1,"ひ"],[34,1,"もの"],[43,1,"たから"],[50,1,"ひと"],[52,2,"じぶん"],[55,1,"つか"],[58,1,"こ"],[72,1,"かれ"]],"text":"「万軍の主は言われる、彼らはわたしが手を下して事を行う日に、わたしの者となり、わたしの宝となる。また人が自分に仕える子をあわれむように、わたしは彼らをあわれむ。"},{"ref":"Mal.3.18","start":39003018,"end":39003018,"break":"none","ruby":[[2,1,"とき"],[10,1,"ふたた"],[12,2,"ぎじん"],[15,2,"あくにん"],[18,1,"かみ"],[20,1,"つか"],[23,1,"もの"],[26,1,"つか"],[30,1,"もの"],[33,2,"くべつ"],[36,1,"し"]],"text":"その時あなたがたは、再び義人と悪人、神に仕える者と、仕えない者との区別を知るようになる。"}]