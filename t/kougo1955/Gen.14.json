[{"ref":"Gen.14.1","start":1014001,"end":1014001,"break":"paragraph","ruby":[[4,1,"おう"],[16,1,"おう"],[26,1,"おう"],[40,1,"おう"],[45,1,"よ"]],"text":"シナルの王アムラペル、エラサルの王アリオク、エラムの王ケダラオメルおよびゴイムの王テダルの世に、"},{"ref":"Gen.14.2","start":1014002,"end":1014002,"break":"none","ruby":[[4,1,"おう"],[10,1,"おう"],[18,1,"おう"],[28,1,"おう"],[38,1,"おう"],[57,1,"おう"],[59,1,"たたか"]],"text":"これらの王はソドムの王ベラ、ゴモラの王ビルシャ、アデマの王シナブ、ゼボイムの王セメベル、およびベラすなわちゾアルの王と戦った。"},{"ref":"Gen.14.3","start":1014003,"end":1014003,"break":"none","ruby":[[4,1,"にん"],[6,1,"おう"],[10,2,"どうめい"],[18,1,"たに"],[24,1,"しお"],[26,1,"うみ"],[28,1,"む"],[32,1,"い"]],"text":"これら五人の王はみな同盟してシデムの谷、すなわち塩の海に向かって行った。"},{"ref":"Gen.14.4","start":1014004,"end":1014004,"break":"none","ruby":[[4,1,"かれ"],[9,1,"ねん"],[11,1,"あいだ"],[19,1,"つか"],[26,1,"ねん"],[27,1,"め"]],"text":"すなわち彼らは十二年の間ケダラオメルに仕えたが、十三年目にそむいたので、"},{"ref":"Gen.14.5","start":1014005,"end":1014005,"break":"none","ruby":[[2,1,"ねん"],[3,1,"め"],[12,1,"かれ"],[14,2,"れんごう"],[18,1,"おう"],[22,1,"とも"],[72,1,"う"]],"text":"十四年目にケダラオメルは彼と連合した王たちと共にきて、アシタロテ・カルナイムでレパイムびとを、ハムでズジびとを、シャベ・キリアタイムでエミびとを撃ち、"},{"ref":"Gen.14.6","start":1014006,"end":1014006,"break":"none","ruby":[[4,2,"さんち"],[12,1,"う"],[16,2,"あらの"],[32,1,"およ"]],"text":"セイルの山地でホリびとを撃って、荒野のほとりにあるエル・パランに及んだ。"},{"ref":"Gen.14.7","start":1014007,"end":1014007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"ひ"],[5,1,"かえ"],[23,1,"い"],[34,1,"くに"],[41,1,"う"],[55,1,"す"],[64,1,"う"]],"text":"彼らは引き返してエン・ミシパテすなわちカデシへ行って、アマレクびとの国をことごとく撃ち、またハザゾン・タマルに住むアモリびとをも撃った。"},{"ref":"Gen.14.8","start":1014008,"end":1014008,"break":"none","ruby":[[7,1,"おう"],[13,1,"おう"],[19,1,"おう"],[26,1,"おう"],[40,1,"おう"],[42,1,"で"],[48,1,"たに"],[50,1,"かれ"],[53,1,"む"],[57,1,"たたか"],[60,1,"じん"]],"text":"そこでソドムの王、ゴモラの王、アデマの王、ゼボイムの王およびベラすなわちゾアルの王は出てシデムの谷で彼らに向かい、戦いの陣をしいた。"},{"ref":"Gen.14.9","start":1014009,"end":1014009,"break":"none","ruby":[[8,1,"おう"],[20,1,"おう"],[29,1,"おう"],[41,1,"おう"],[48,1,"にん"],[50,1,"おう"],[52,1,"たい"],[56,1,"にん"],[58,1,"おう"]],"text":"すなわちエラムの王ケダラオメル、ゴイムの王テダル、シナルの王アムラペル、エラサルの王アリオクの四人の王に対する五人の王であった。"},{"ref":"Gen.14.10","start":1014010,"end":1014010,"break":"none","ruby":[[4,1,"たに"],[14,1,"あな"],[16,1,"おお"],[27,1,"おう"],[33,1,"おう"],[35,1,"に"],[41,1,"お"],[46,1,"のこ"],[49,1,"もの"],[51,1,"やま"]],"text":"シデムの谷にはアスファルトの穴が多かったので、ソドムの王とゴモラの王は逃げてそこに落ちたが、残りの者は山にのがれた。"},{"ref":"Gen.14.11","start":1014011,"end":1014011,"break":"none","ruby":[[3,1,"かれ"],[14,2,"ざいさん"],[17,2,"しょくりょう"],[26,1,"うば"],[29,1,"さ"]],"text":"そこで彼らはソドムとゴモラの財産と食料とをことごとく奪って去り、"},{"ref":"Gen.14.12","start":1014012,"end":1014012,"break":"none","ruby":[[6,1,"す"],[16,1,"おとうと"],[18,1,"こ"],[24,2,"ざいさん"],[27,1,"うば"],[30,1,"さ"]],"text":"またソドムに住んでいたアブラムの弟の子ロトとその財産を奪って去った。"},{"ref":"Gen.14.13","start":1014013,"end":1014013,"break":"paragraph","ruby":[[0,1,"とき"],[7,1,"ひと"],[26,1,"つ"],[32,1,"とき"],[43,2,"きょうだい"],[52,2,"きょうだい"],[71,1,"き"],[78,1,"す"],[84,1,"かれ"],[92,2,"どうめい"]],"text":"時に、ひとりの人がのがれてきて、ヘブルびとアブラムに告げた。この時アブラムはエシコルの兄弟、またアネルの兄弟であるアモリびとマムレのテレビンの木のかたわらに住んでいた。彼らはアブラムと同盟していた。"},{"ref":"Gen.14.14","start":1014014,"end":1014014,"break":"none","ruby":[[5,2,"みうち"],[8,1,"もの"],[10,2,"ほりょ"],[18,1,"き"],[21,2,"くんれん"],[25,1,"いえ"],[27,1,"こ"],[32,1,"にん"],[34,1,"ひ"],[36,1,"つ"],[43,1,"お"],[46,1,"い"]],"text":"アブラムは身内の者が捕虜になったのを聞き、訓練した家の子三百十八人を引き連れてダンまで追って行き、"},{"ref":"Gen.14.15","start":1014015,"end":1014015,"break":"none","ruby":[[8,1,"わ"],[12,1,"よる"],[17,1,"せ"],[23,1,"う"],[31,1,"きた"],[37,1,"かれ"],[40,1,"お"]],"text":"そのしもべたちを分けて、夜かれらを攻め、これを撃ってダマスコの北、ホバまで彼らを追った。"},{"ref":"Gen.14.16","start":1014016,"end":1014016,"break":"none","ruby":[[3,1,"かれ"],[9,2,"ざいさん"],[12,1,"と"],[14,1,"かえ"],[19,2,"みうち"],[22,1,"もの"],[28,2,"ざいさん"],[33,1,"おんな"],[37,1,"たみ"],[40,1,"と"],[42,1,"かえ"]],"text":"そして彼はすべての財産を取り返し、また身内の者ロトとその財産および女たちと民とを取り返した。"},{"ref":"Gen.14.17","start":1014017,"end":1014017,"break":"paragraph","ruby":[[14,2,"れんごう"],[17,1,"おう"],[21,1,"う"],[23,1,"やぶ"],[26,1,"かえ"],[29,1,"とき"],[35,1,"おう"],[41,1,"たに"],[47,1,"おう"],[49,1,"たに"],[51,1,"で"],[53,1,"かれ"],[55,1,"むか"]],"text":"アブラムがケダラオメルとその連合の王たちを撃ち破って帰った時、ソドムの王はシャベの谷、すなわち王の谷に出て彼を迎えた。"},{"ref":"Gen.14.18","start":1014018,"end":1014018,"break":"none","ruby":[[2,1,"とき"],[8,1,"おう"],[22,1,"しゅ"],[25,1,"も"],[31,1,"かれ"],[35,1,"たか"],[37,1,"かみ"],[39,2,"さいし"]],"text":"その時、サレムの王メルキゼデクはパンとぶどう酒とを持ってきた。彼はいと高き神の祭司である。"},{"ref":"Gen.14.19","start":1014019,"end":1014019,"break":"none","breaks":[[15,"stanza"],[33,"line"]],"ruby":[[0,1,"かれ"],[7,2,"しゅくふく"],[11,1,"い"],[16,1,"ねが"],[20,2,"てんち"],[23,1,"しゅ"],[28,1,"たか"],[30,1,"かみ"],[38,2,"しゅくふく"]],"text":"彼はアブラムを祝福して言った、「願わくは天地の主なるいと高き神が、アブラムを祝福されるように。"},{"ref":"Gen.14.20","start":1014020,"end":1014020,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ねが"],[8,1,"てき"],[14,1,"て"],[16,1,"わた"],[22,1,"たか"],[24,1,"かみ"],[42,1,"かれ"],[48,1,"もの"],[51,1,"ぶん"],[55,1,"おく"]],"text":"願わくはあなたの敵をあなたの手に渡されたいと高き神があがめられるように」。アブラムは彼にすべての物の十分の一を贈った。"},{"ref":"Gen.14.21","start":1014021,"end":1014021,"break":"none","ruby":[[0,1,"とき"],[6,1,"おう"],[13,1,"い"],[23,1,"ひと"],[30,2,"ざいさん"],[37,1,"と"]],"text":"時にソドムの王はアブラムに言った、「わたしには人をください。財産はあなたが取りなさい」。"},{"ref":"Gen.14.22","start":1014022,"end":1014022,"break":"none","ruby":[[9,1,"おう"],[11,1,"い"],[16,2,"てんち"],[19,1,"しゅ"],[24,1,"たか"],[26,1,"かみ"],[28,1,"しゅ"],[30,1,"て"],[40,1,"ちか"]],"text":"アブラムはソドムの王に言った、「天地の主なるいと高き神、主に手をあげて、わたしは誓います。"},{"ref":"Gen.14.23","start":1014023,"end":1014023,"break":"none","ruby":[[4,1,"いと"],[6,1,"ぽん"],[15,1,"ぽん"],[26,1,"なに"],[29,1,"う"],[40,1,"と"],[56,1,"い"]],"text":"わたしは糸一本でも、くつひも一本でも、あなたのものは何にも受けません。アブラムを富ませたのはわたしだと、あなたが言わないように。"},{"ref":"Gen.14.24","start":1014024,"end":1014024,"break":"none","ruby":[[3,2,"わかもの"],[11,1,"た"],[14,1,"もの"],[16,1,"べつ"],[27,1,"とも"],[29,1,"い"],[32,2,"ひとびと"],[51,1,"ぶん"],[53,1,"と"]],"text":"ただし若者たちがすでに食べた物は別です。そしてわたしと共に行った人々アネルとエシコルとマムレとにはその分を取らせなさい」。"}]