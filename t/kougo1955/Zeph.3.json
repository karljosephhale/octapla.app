[{"ref":"Zeph.3.1","start":36003001,"end":36003001,"break":"paragraph","breaks":[[9,"line"]],"ruby":[[14,1,"けが"],[17,2,"ぼうぎゃく"],[20,1,"まち"]],"text":"わざわいなるかな、このそむき汚れた暴虐の町。"},{"ref":"Zeph.3.2","start":36003002,"end":36003002,"break":"line","breaks":[[15,"line"],[25,"line"],[33,"line"]],"ruby":[[6,1,"こえ"],[9,1,"みみ"],[11,1,"かたむ"],[15,1,"こら"],[19,1,"う"],[25,1,"しゅ"],[27,1,"よ"],[29,1,"たの"],[37,1,"かみ"],[39,1,"ちか"]],"text":"これはだれの声にも耳を傾けず、懲しめを受けいれず、主に寄り頼まず、おのれの神に近よらない。"},{"ref":"Zeph.3.3","start":36003003,"end":36003003,"break":"line","breaks":[[19,"line"],[38,"line"]],"ruby":[[2,1,"なか"],[30,1,"よる"],[38,1,"かれ"],[41,1,"あさ"],[44,1,"なに"],[47,1,"のこ"]],"text":"その中にいるつかさたちは、ほえるしし、そのさばきびとたちは、夜のおおかみで、彼らは朝まで何一つ残さない。"},{"ref":"Zeph.3.4","start":36003004,"end":36003004,"break":"line","breaks":[[17,"line"]],"ruby":[[2,3,"よげんしゃ"],[9,2,"ほうじゅう"],[12,1,"いつわ"],[19,2,"さいし"],[24,1,"せい"],[27,1,"もの"],[29,1,"けが"],[32,2,"りっぽう"],[35,1,"やぶ"]],"text":"その預言者たちは、放縦で偽りびと、その祭司たちは聖なる物を汚し、律法を破る。"},{"ref":"Zeph.3.5","start":36003005,"end":36003005,"break":"line","breaks":[[24,"line"],[45,"line"]],"ruby":[[2,1,"なか"],[7,1,"しゅ"],[9,1,"ぎ"],[15,2,"ふぎ"],[18,1,"おこな"],[24,1,"あさ"],[30,2,"こうぎ"],[33,1,"あらわ"],[37,1,"あやま"],[48,2,"ふぎ"],[51,1,"もの"],[53,1,"はじ"],[55,1,"し"]],"text":"その中にいます主は義であって、不義を行われない。朝ごとにその公義を現して、誤ることがない。しかし不義な者は恥を知らない。"},{"ref":"Zeph.3.6","start":36003006,"end":36003006,"break":"line","breaks":[[14,"line"],[26,"line"],[42,"line"],[56,"line"],[68,"line"]],"ruby":[[5,1,"しょ"],[6,2,"こくみん"],[9,1,"ほろ"],[20,1,"あ"],[36,1,"あら"],[46,1,"い"],[48,1,"き"],[51,1,"もの"],[58,2,"まちまち"],[61,1,"あ"],[68,1,"ひと"],[70,1,"すがた"],[75,1,"す"],[77,1,"もの"]],"text":"「わたしは諸国民を滅ぼした。そのやぐらは荒れはてた。わたしはそのちまたを荒したので、ちまたを行き来する者もない。その町々は荒れすたれて、人の姿もなく、住む者もない。"},{"ref":"Zeph.3.7","start":36003007,"end":36003007,"break":"line","breaks":[[8,"line"],[29,"line"],[53,"line"]],"ruby":[[4,1,"い"],[12,1,"かなら"],[18,1,"おそ"],[21,1,"こら"],[25,1,"う"],[36,1,"めい"],[43,1,"こと"],[45,2,"みうしな"],[56,1,"かれ"],[63,2,"じぶん"],[66,2,"ぎょうじょう"],[69,1,"みだ"]],"text":"わたしは言った、『これは必ずわたしを恐れ、懲しめを受ける。これはわたしが命じたすべての事を見失わない』と。しかし彼らはしきりに自分の行状を乱した」。"},{"ref":"Zeph.3.8","start":36003008,"end":36003008,"break":"stanza","breaks":[[7,"line"],[28,"line"],[37,"line"],[53,"line"],[64,"line"],[77,"line"],[95,"line"],[111,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[24,1,"た"],[28,2,"しょうげん"],[32,1,"ひ"],[34,1,"ま"],[41,2,"けつい"],[44,1,"しょ"],[45,2,"こくみん"],[50,1,"あつ"],[58,1,"くに"],[60,1,"あつ"],[66,1,"いきどお"],[71,1,"はげ"],[74,1,"いか"],[84,1,"うえ"],[86,1,"そそ"],[95,1,"ぜん"],[96,1,"ち"],[106,1,"いか"],[109,1,"ひ"],[111,1,"や"],[113,1,"ほろ"]],"text":"主は言われる、「それゆえ、あなたがたは、わたしが立って、証言する日を待て。わたしの決意は諸国民をよせ集め、もろもろの国を集めて、わが憤り、わが激しい怒りをことごとくその上に注ぐことであって、全地は、ねたむわたしの怒りの火に焼き滅ぼされるからである。"},{"ref":"Zeph.3.9","start":36003009,"end":36003009,"break":"line","breaks":[[24,"line"],[38,"line"]],"ruby":[[2,1,"とき"],[12,1,"たみ"],[14,1,"きよ"],[21,1,"あた"],[27,1,"かれ"],[30,1,"しゅ"],[32,1,"な"],[34,1,"よ"],[38,1,"こころ"],[45,1,"しゅ"],[47,1,"つか"]],"text":"その時わたしはもろもろの民に清きくちびるを与え、すべて彼らに主の名を呼ばせ、心を一つにして主に仕えさせる。"},{"ref":"Zeph.3.10","start":36003010,"end":36003010,"break":"line","breaks":[[8,"line"],[20,"line"],[37,"line"]],"ruby":[[4,1,"おが"],[6,1,"もの"],[12,1,"ち"],[16,1,"もの"],[18,1,"むすめ"],[26,2,"かわがわ"],[29,1,"む"],[34,1,"き"],[41,1,"そな"],[43,1,"もの"]],"text":"わたしを拝む者、わたしが散らした者の娘はエチオピヤの川々の向こうから来て、わたしに供え物をささげる。"},{"ref":"Zeph.3.11","start":36003011,"end":36003011,"break":"stanza","breaks":[[6,"line"],[29,"line"],[43,"line"],[59,"line"],[74,"line"]],"ruby":[[2,1,"ひ"],[45,1,"とき"],[59,1,"たか"],[63,1,"ほこ"],[65,1,"もの"],[69,1,"のぞ"],[78,1,"かさ"],[83,1,"せい"],[86,1,"やま"],[89,1,"たか"]],"text":"その日には、あなたはわたしにそむいたすべてのわざのゆえに、はずかしめられることはない。その時わたしはあなたのうちから、高ぶって誇る者どもを除くゆえ、あなたは重ねてわが聖なる山で、高ぶることはない。"},{"ref":"Zeph.3.12","start":36003012,"end":36003012,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[4,2,"にゅうわ"],[14,1,"たみ"],[24,1,"のこ"],[27,1,"かれ"],[30,1,"しゅ"],[32,1,"な"],[34,1,"さ"],[36,1,"どころ"]],"text":"わたしは柔和にしてへりくだる民を、あなたのうちに残す。彼らは主の名を避け所とする。"},{"ref":"Zeph.3.13","start":36003013,"end":36003013,"break":"line","breaks":[[25,"line"],[39,"line"],[54,"line"]],"ruby":[[6,1,"のこ"],[9,1,"もの"],[11,2,"ふぎ"],[14,1,"おこな"],[18,1,"いつわ"],[21,1,"い"],[27,1,"くち"],[30,1,"あざむ"],[33,1,"した"],[35,1,"み"],[44,1,"かれ"],[47,1,"しょく"],[49,1,"え"],[51,1,"ふ"],[54,1,"かれ"],[62,1,"もの"]],"text":"イスラエルの残りの者は不義を行わず、偽りを言わず、その口には欺きの舌を見ない。それゆえ、彼らは食を得て伏し、彼らをおびやかす者はいない」。"},{"ref":"Zeph.3.14","start":36003014,"end":36003014,"break":"stanza","breaks":[[12,"line"],[26,"line"]],"ruby":[[4,1,"むすめ"],[7,1,"よろこ"],[9,1,"うた"],[19,1,"よろこ"],[21,1,"よ"],[32,1,"むすめ"],[35,1,"こころ"],[40,1,"よろこ"],[42,1,"たの"]],"text":"シオンの娘よ、喜び歌え。イスラエルよ、喜び呼ばわれ。エルサレムの娘よ、心のかぎり喜び楽しめ。"},{"ref":"Zeph.3.15","start":36003015,"end":36003015,"break":"line","breaks":[[16,"line"],[29,"line"],[51,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"うった"],[9,1,"もの"],[11,1,"と"],[13,1,"さ"],[20,1,"てき"],[22,1,"お"],[24,1,"はら"],[35,1,"おう"],[38,1,"しゅ"],[58,1,"わざわい"],[60,1,"おそ"]],"text":"主はあなたを訴える者を取り去り、あなたの敵を追い払われた。イスラエルの王なる主はあなたのうちにいます。あなたはもはや災を恐れることはない。"},{"ref":"Zeph.3.16","start":36003016,"end":36003016,"break":"line","breaks":[[20,"line"],[31,"line"]],"ruby":[[2,1,"ひ"],[4,2,"ひとびと"],[13,1,"む"],[17,1,"い"],[26,1,"おそ"],[35,1,"て"],[37,2,"よわよわ"]],"text":"その日、人々はエルサレムに向かって言う、「シオンよ、恐れるな。あなたの手を弱々しくたれるな。"},{"ref":"Zeph.3.17","start":36003017,"end":36003017,"break":"line","breaks":[[19,"line"],[35,"line"],[50,"line"],[65,"line"]],"ruby":[[4,1,"かみ"],[6,1,"しゅ"],[19,2,"ゆうし"],[26,2,"しょうり"],[29,1,"あた"],[35,1,"かれ"],[44,1,"よろこ"],[46,1,"たの"],[52,1,"あい"],[61,1,"あらた"],[65,1,"まつり"],[67,1,"ひ"],[79,1,"よろこ"],[81,1,"よ"]],"text":"あなたの神、主はあなたのうちにいまし、勇士であって、勝利を与えられる。彼はあなたのために喜び楽しみ、その愛によってあなたを新にし、祭の日のようにあなたのために喜び呼ばわられる」。"},{"ref":"Zeph.3.18","start":36003018,"end":36003018,"break":"stanza","breaks":[[18,"line"]],"ruby":[[10,1,"なや"],[13,1,"と"],[15,1,"さ"],[22,1,"はじ"],[24,1,"う"]],"text":"「わたしはあなたから悩みを取り去る。あなたは恥を受けることはない。"},{"ref":"Zeph.3.19","start":36003019,"end":36003019,"break":"line","breaks":[[17,"line"],[30,"line"],[48,"line"],[58,"line"]],"ruby":[[0,1,"み"],[5,1,"とき"],[15,1,"もの"],[26,2,"しょぶん"],[30,1,"あし"],[34,1,"すく"],[37,1,"お"],[43,1,"もの"],[45,1,"あつ"],[48,1,"かれ"],[51,1,"はじ"],[53,1,"ほまれ"],[58,1,"ぜん"],[59,1,"ち"]],"text":"見よ、その時あなたをしえたげる者をわたしはことごとく処分し、足なえを救い、追いやられた者を集め、彼らの恥を誉にかえ、全地にほめられるようにする。"},{"ref":"Zeph.3.20","start":36003020,"end":36003020,"break":"line","breaks":[[20,"line"],[36,"line"],[51,"line"],[67,"line"],[78,"line"],[98,"line"]],"ruby":[[2,1,"とき"],[14,1,"つ"],[30,1,"あつ"],[46,1,"め"],[48,1,"まえ"],[57,2,"こうふく"],[60,2,"かいふく"],[67,1,"ち"],[73,1,"たみ"],[75,1,"なか"],[84,1,"な"],[86,1,"え"],[90,1,"ほまれ"],[92,1,"え"],[98,1,"しゅ"],[100,1,"い"]],"text":"その時、わたしはあなたがたを連れかえる。わたしがあなたがたを集めるとき、わたしがあなたがたの目の前に、あなたがたの幸福を回復するとき、地のすべての民の中で、あなたがたに名を得させ、誉を得させる」と主は言われる。"}]