[{"ref":"2Chr.35.1","start":14035001,"end":14035001,"break":"paragraph","ruby":[[10,1,"しゅ"],[12,2,"すぎこし"],[15,1,"まつり"],[17,1,"おこな"],[25,2,"しょうがつ"],[30,1,"か"],[32,2,"すぎこし"],[35,2,"こひつじ"]],"text":"ヨシヤはエルサレムで主に過越の祭を行った。すなわち正月の十四日に過越の小羊をほふらせ、"},{"ref":"2Chr.35.2","start":14035002,"end":14035002,"break":"none","ruby":[[0,2,"さいし"],[5,2,"しょくむ"],[10,1,"おこな"],[14,1,"かれ"],[17,1,"はげ"],[21,1,"しゅ"],[23,1,"みや"],[25,1,"つとめ"]],"text":"祭司にその職務をとり行わせ、彼らを励まして主の宮の務をさせ、"},{"ref":"2Chr.35.3","start":14035003,"end":14035003,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"せい"],[7,1,"もの"],[24,1,"おし"],[32,1,"い"],[49,1,"おう"],[54,1,"こ"],[60,1,"た"],[63,1,"みや"],[66,1,"せい"],[69,1,"はこ"],[71,1,"お"],[77,1,"ふたた"],[82,1,"かた"],[88,1,"およ"],[99,1,"かみ"],[101,1,"しゅ"],[107,1,"たみ"],[114,1,"つか"]],"text":"また主の聖なる者となってすべてのイスラエルびとを教えるレビびとに言った、「あなたがたはイスラエルの王ダビデの子ソロモンの建てた宮に、聖なる箱を置きなさい。再びこれを肩にになうに及ばない。あなたがたの神、主およびその民イスラエルに仕えなさい。"},{"ref":"2Chr.35.4","start":14035004,"end":14035004,"break":"none","ruby":[[12,1,"おう"],[17,1,"しょ"],[24,1,"こ"],[30,1,"しょ"],[32,1,"もとづ"],[35,2,"しぞく"],[45,1,"はん"],[55,1,"そな"]],"text":"あなたがたはイスラエルの王ダビデの書、およびその子ソロモンの書に基いて氏族にしたがい、その班によって、みずから備えをなし、"},{"ref":"2Chr.35.5","start":14035005,"end":14035005,"break":"none","ruby":[[6,2,"きょうだい"],[11,1,"たみ"],[13,2,"ひとびと"],[16,2,"しぞく"],[19,2,"くぶん"],[27,2,"せいじょ"],[30,1,"た"],[43,2,"しぞく"],[46,1,"ぶん"],[48,1,"か"]],"text":"あなたがたの兄弟である民の人々の氏族の区分にしたがって聖所に立ち、このためにレビびとの氏族の分が欠けることのないようにしなさい。"},{"ref":"2Chr.35.6","start":14035006,"end":14035006,"break":"none","ruby":[[6,2,"すぎこし"],[9,2,"こひつじ"],[16,1,"み"],[18,1,"きよ"],[27,2,"きょうだい"],[33,1,"そな"],[42,1,"つた"],[45,1,"しゅ"],[47,2,"ことば"],[55,1,"おこな"]],"text":"あなたがたは過越の小羊をほふり、身を清め、あなたがたの兄弟のために備えをし、モーセが伝えた主の言葉にしたがって行いなさい」。"},{"ref":"2Chr.35.7","start":14035007,"end":14035007,"break":"paragraph","ruby":[[5,2,"こひつじ"],[10,1,"こ"],[14,1,"たみ"],[16,2,"ひとびと"],[19,1,"おく"],[26,1,"みな"],[29,1,"ところ"],[37,1,"ひと"],[42,2,"すぎこし"],[45,1,"そな"],[47,1,"もの"],[55,1,"かず"],[61,2,"おうし"],[66,1,"おく"],[74,1,"おう"],[76,2,"しょゆう"],[80,1,"だ"]],"text":"ヨシヤは、小羊および子やぎを民の人々に贈った。これは皆その所にいるすべての人のための過越の供え物であって、その数三万、また雄牛三千を贈った。それらは王の所有から出したのである。"},{"ref":"2Chr.35.8","start":14035008,"end":14035008,"break":"none","ruby":[[8,1,"たみ"],[10,2,"さいし"],[19,1,"こころ"],[22,1,"おく"],[28,1,"かみ"],[30,1,"みや"],[52,2,"こひつじ"],[55,1,"こ"],[62,1,"とう"],[64,1,"うし"],[67,1,"とう"],[69,2,"さいし"],[72,1,"あた"],[75,2,"すぎこし"],[78,1,"そな"],[80,1,"もの"]],"text":"そのつかさたちも民と祭司とレビびとに真心から贈った。また神の宮のつかさたちヒルキヤ、ゼカリヤ、エヒエルも小羊と子やぎ二千六百頭、牛三百頭を祭司に与えて過越の供え物とした。"},{"ref":"2Chr.35.9","start":14035009,"end":14035009,"break":"none","ruby":[[7,1,"ちょう"],[11,2,"ひとびと"],[26,2,"きょうだい"],[59,2,"こひつじ"],[62,1,"こ"],[67,1,"とう"],[69,1,"うし"],[72,1,"とう"],[79,1,"おく"],[82,2,"すぎこし"],[85,1,"そな"],[87,1,"もの"]],"text":"またレビびとの長である人々すなわちコナニヤおよびその兄弟シマヤ、ネタンエルならびにハシャビヤ、エイエル、ヨザバデなども小羊と子やぎ五千頭、牛五百頭をレビびとに贈って過越の供え物とした。"},{"ref":"2Chr.35.10","start":14035010,"end":14035010,"break":"paragraph","ruby":[[5,1,"つと"],[11,1,"そな"],[18,1,"おう"],[20,1,"いのち"],[22,1,"したが"],[25,2,"さいし"],[32,1,"も"],[34,1,"ば"],[36,1,"た"],[46,1,"はん"],[48,1,"したが"],[51,1,"つか"]],"text":"このように勤めのことが備わったので、王の命に従って祭司たちはその持ち場に立ち、レビびとはその班に従って仕え、"},{"ref":"2Chr.35.11","start":14035011,"end":14035011,"break":"none","ruby":[[3,2,"すぎこし"],[6,2,"こひつじ"],[17,2,"さいし"],[22,1,"ち"],[24,1,"う"],[26,1,"と"],[29,1,"そそ"],[40,1,"かわ"]],"text":"やがて過越の小羊がほふられたので、祭司はその血を受け取って注いだ。レビびとはその皮をはいだ。"},{"ref":"2Chr.35.12","start":14035012,"end":14035012,"break":"none","ruby":[[4,2,"はんさい"],[7,1,"もの"],[11,1,"わ"],[17,1,"たみ"],[19,2,"ひとびと"],[22,2,"しぞく"],[25,2,"くぶん"],[28,1,"したが"],[31,1,"わた"],[34,1,"しゅ"],[50,1,"しょ"],[66,1,"うし"]],"text":"それから燔祭の物をとり分け、それを民の人々の氏族の区分に従って渡し、主にささげさせた。これはモーセの書にしるされたとおりである。また牛をもこのようにした。"},{"ref":"2Chr.35.13","start":14035013,"end":14035013,"break":"none","ruby":[[3,1,"さだ"],[6,1,"したが"],[9,2,"すぎこし"],[12,2,"こひつじ"],[15,1,"ひ"],[23,1,"た"],[25,1,"せい"],[28,1,"そな"],[30,1,"もの"],[32,1,"ふか"],[39,1,"あさ"],[45,1,"に"],[48,1,"いそ"],[55,1,"たみ"],[57,2,"ひとびと"]],"text":"そして定めに従って過越の小羊を火であぶり、その他の聖なる供え物を深なべ、かま、浅なべなどに煮て、急いですべての民の人々にくばった。"},{"ref":"2Chr.35.14","start":14035014,"end":14035014,"break":"none","ruby":[[2,1,"のち"],[4,1,"かれ"],[7,2,"じぶん"],[14,2,"さいし"],[22,1,"そな"],[32,2,"しそん"],[37,2,"さいし"],[43,2,"はんさい"],[46,2,"しぼう"],[55,1,"いそが"],[60,1,"よる"],[79,2,"じぶん"],[92,2,"しそん"],[97,2,"さいし"],[105,1,"そな"]],"text":"その後、彼らは自分のためと、祭司たちのために備えをした。アロンの子孫である祭司たちは、燔祭と脂肪をささげるのに忙しくて、夜になったからである。それでレビびとは自分たちのためと、アロンの子孫である祭司たちのために備えたのである。"},{"ref":"2Chr.35.15","start":14035015,"end":14035015,"break":"none","ruby":[[4,2,"しそん"],[9,1,"うた"],[13,1,"もの"],[32,1,"おう"],[34,3,"せんけんしゃ"],[42,1,"いのち"],[44,1,"したが"],[49,1,"も"],[51,1,"ば"],[56,2,"もんえい"],[65,1,"もん"],[72,2,"しょくむ"],[75,1,"はな"],[79,1,"およ"],[86,2,"きょうだい"],[96,1,"かれ"],[102,1,"そな"]],"text":"アサフの子孫である歌うたう者たちは、ダビデ、アサフ、ヘマンおよび王の先見者エドトンの命に従ってその持ち場におり、門衛たちはおのおの門にいて、その職務を離れるに及ばなかった。兄弟であるレビびとが彼らのために備えたからである。"},{"ref":"2Chr.35.16","start":14035016,"end":14035016,"break":"paragraph","ruby":[[7,1,"ひ"],[9,1,"しゅ"],[11,1,"つと"],[14,1,"こと"],[21,1,"そな"],[31,1,"おう"],[33,1,"いのち"],[35,1,"したが"],[38,2,"すぎこし"],[41,1,"まつり"],[43,1,"おこな"],[46,1,"しゅ"],[48,2,"さいだん"],[51,2,"はんさい"]],"text":"このようにその日、主の勤めの事がことごとく備わったので、ヨシヤ王の命に従って過越の祭を行い、主の祭壇に燔祭をささげた。"},{"ref":"2Chr.35.17","start":14035017,"end":14035017,"break":"none","ruby":[[3,1,"き"],[13,2,"ひとびと"],[21,2,"すぎこし"],[24,1,"まつり"],[26,1,"おこな"],[31,2,"なぬか"],[34,1,"あいだ"],[36,1,"たね"],[37,1,"い"],[43,1,"まつり"],[45,1,"おこな"]],"text":"ここに来ていたイスラエルの人々は、そのとき過越の祭を行い、また七日の間、種入れぬパンの祭を行った。"},{"ref":"2Chr.35.18","start":14035018,"end":14035018,"break":"none","ruby":[[0,3,"よげんしゃ"],[8,1,"ひ"],[27,2,"すぎこし"],[30,1,"まつり"],[32,1,"おこな"],[51,2,"しょおう"],[64,2,"さいし"],[79,1,"き"],[94,2,"ひとびと"],[106,2,"じゅうみん"],[109,1,"とも"],[111,1,"い"],[117,2,"すぎこし"],[120,1,"まつり"],[122,1,"おこな"],[125,1,"もの"]],"text":"預言者サムエルの日からこのかた、イスラエルでこのような過越の祭を行ったことはなかった。またイスラエルの諸王のうちには、ヨシヤが、祭司、レビびと、ならびにそこに来たユダとイスラエルのすべての人々、およびエルサレムの住民と共に行ったような過越の祭を行った者はひとりもなかった。"},{"ref":"2Chr.35.19","start":14035019,"end":14035019,"break":"none","ruby":[[2,2,"すぎこし"],[5,1,"まつり"],[11,2,"ちせい"],[14,1,"だい"],[17,1,"ねん"],[19,1,"おこな"]],"text":"この過越の祭はヨシヤの治世の第十八年に行われた。"},{"ref":"2Chr.35.20","start":14035020,"end":14035020,"break":"paragraph","ruby":[[9,1,"みや"],[11,1,"ととの"],[14,1,"のち"],[21,1,"おう"],[29,1,"かわ"],[43,1,"たたか"],[48,1,"のぼ"],[63,1,"ふせ"],[67,1,"で"],[69,1,"い"]],"text":"このようにヨシヤが宮を整えた後、エジプトの王ネコはユフラテ川のほとりにあるカルケミシで戦うために上ってきたので、ヨシヤはこれを防ごうと出て行った。"},{"ref":"2Chr.35.21","start":14035021,"end":14035021,"break":"none","ruby":[[6,1,"かれ"],[8,2,"ししゃ"],[16,1,"い"],[24,1,"おう"],[33,1,"たがい"],[35,1,"なに"],[63,1,"せ"],[70,1,"き"],[85,1,"てき"],[87,1,"いえ"],[89,1,"せ"],[96,1,"き"],[102,1,"かみ"],[108,1,"めい"],[111,1,"いそ"],[123,1,"とも"],[129,1,"かみ"],[131,1,"さか"],[150,1,"かみ"],[156,1,"ほろ"]],"text":"しかしネコは彼に使者をつかわして言った、「ユダの王よ、われわれはお互に何のあずかるところがありますか。わたしはきょう、あなたを攻めようとして来たのではありません。わたしの敵の家を攻めようとして来たのです。神がわたしに命じて急がせています。わたしと共におられる神に逆らうことをやめなさい。そうしないと、神はあなたを滅ぼされるでしょう」。"},{"ref":"2Chr.35.22","start":14035022,"end":14035022,"break":"none","ruby":[[7,1,"ひ"],[9,1,"かえ"],[14,1,"この"],[22,1,"かれ"],[24,1,"たたか"],[30,1,"すがた"],[32,1,"か"],[35,1,"かみ"],[37,1,"くち"],[40,1,"で"],[45,2,"ことば"],[48,1,"き"],[54,1,"い"],[61,1,"たに"],[63,1,"たたか"]],"text":"しかしヨシヤは引き返すことを好まず、かえって彼と戦うために、姿を変え、神の口から出たネコの言葉を聞きいれず、行ってメギドの谷で戦ったが、"},{"ref":"2Chr.35.23","start":14035023,"end":14035023,"break":"none","ruby":[[0,2,"しゃしゅ"],[3,1,"もの"],[11,1,"い"],[18,1,"おう"],[22,2,"けらい"],[33,1,"たす"],[35,1,"だ"],[45,1,"きず"],[51,1,"い"]],"text":"射手の者どもがヨシヤを射あてたので、王はその家来たちに、「わたしを助け出せ。わたしはひどく傷ついた」と言った。"},{"ref":"2Chr.35.24","start":14035024,"end":14035024,"break":"none","ruby":[[3,2,"けらい"],[8,1,"かれ"],[10,1,"くるま"],[13,1,"たす"],[15,1,"だ"],[18,1,"おう"],[25,1,"だい"],[28,1,"くるま"],[30,1,"の"],[42,1,"い"],[50,1,"し"],[58,2,"せんぞ"],[61,1,"はか"],[66,1,"ほうむ"],[82,1,"みな"],[90,1,"かな"]],"text":"そこで家来たちは彼を車から助け出し、王のもっていた第二の車に乗せてエルサレムにつれて行ったが、ついに死んだので、その先祖の墓にこれを葬った。そしてユダとエルサレムは皆ヨシヤのために悲しんだ。"},{"ref":"2Chr.35.25","start":14035025,"end":14035025,"break":"none","ruby":[[0,1,"とき"],[14,2,"あいか"],[17,1,"つく"],[21,1,"うた"],[25,1,"おとこ"],[27,1,"うた"],[31,1,"おんな"],[33,2,"こんにち"],[36,1,"いた"],[43,2,"あいか"],[56,1,"の"],[71,1,"れい"],[79,2,"あいか"]],"text":"時にエレミヤはヨシヤのために哀歌を作った。歌うたう男、歌うたう女は今日に至るまで、その哀歌のうちにヨシヤのことを述べ、イスラエルのうちにこれを例とした。これは哀歌のうちにしるされている。"},{"ref":"2Chr.35.26","start":14035026,"end":14035026,"break":"none","ruby":[[6,1,"た"],[8,2,"こうい"],[11,1,"しゅ"],[13,2,"りっぽう"],[21,1,"ところ"],[23,1,"したが"],[26,1,"い"],[29,2,"とっこう"]],"text":"ヨシヤのその他の行為、主の律法にしるされた所に従って行った徳行、"},{"ref":"2Chr.35.27","start":14035027,"end":14035027,"break":"none","ruby":[[5,2,"しじゅう"],[8,1,"おこな"],[23,1,"れつ"],[24,1,"おう"],[26,1,"しょ"]],"text":"およびその始終の行いなどは、イスラエルとユダの列王の書にしるされている。"}]