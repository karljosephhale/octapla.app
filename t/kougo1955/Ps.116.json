[{"ref":"Ps.116.1","start":19116001,"end":19116001,"break":"paragraph","breaks":[[10,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"あい"],[10,1,"しゅ"],[14,1,"こえ"],[19,1,"ねが"],[23,1,"き"]],"text":"わたしは主を愛する。主はわが声と、わが願いとを聞かれたからである。"},{"ref":"Ps.116.2","start":19116002,"end":19116002,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"みみ"],[8,1,"かたむ"],[20,1,"い"],[26,1,"しゅ"],[28,1,"よ"]],"text":"主はわたしに耳を傾けられたので、わたしは生きるかぎり主を呼びまつるであろう。"},{"ref":"Ps.116.3","start":19116003,"end":19116003,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[0,1,"し"],[2,1,"つな"],[8,1,"と"],[10,1,"ま"],[13,2,"よみ"],[16,1,"くる"],[24,1,"とら"],[32,1,"なや"],[35,1,"かな"]],"text":"死の綱がわたしを取り巻き、陰府の苦しみがわたしを捕えた。わたしは悩みと悲しみにあった。"},{"ref":"Ps.116.4","start":19116004,"end":19116004,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"とき"],[7,1,"しゅ"],[10,1,"な"],[12,1,"よ"],[17,1,"しゅ"],[28,1,"すく"]],"text":"その時わたしは主のみ名を呼んだ。「主よ、どうぞわたしをお救いください」と。"},{"ref":"Ps.116.5","start":19116005,"end":19116005,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"めぐ"],[8,1,"ただ"],[21,1,"かみ"],[28,1,"と"]],"text":"主は恵みふかく、正しくいらせられ、われらの神はあわれみに富まれる。"},{"ref":"Ps.116.6","start":19116006,"end":19116006,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"むがく"],[5,1,"もの"],[7,1,"まも"],[16,1,"ひく"],[24,1,"しゅ"],[30,1,"すく"]],"text":"主は無学な者を守られる。わたしが低くされたとき、主はわたしを救われた。"},{"ref":"Ps.116.7","start":19116007,"end":19116007,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"たましい"],[9,2,"へいあん"],[12,1,"かえ"],[18,1,"しゅ"],[20,1,"ゆた"]],"text":"わが魂よ、おまえの平安に帰るがよい。主は豊かにおまえをあしらわれたからである。"},{"ref":"Ps.116.8","start":19116008,"end":19116008,"break":"line","breaks":[[24,"line"]],"ruby":[[8,1,"たましい"],[10,1,"し"],[18,1,"め"],[20,1,"なみだ"],[28,1,"あし"],[36,1,"たす"],[38,1,"だ"]],"text":"あなたはわたしの魂を死から、わたしの目を涙から、わたしの足をつまずきから助け出されました。"},{"ref":"Ps.116.9","start":19116009,"end":19116009,"break":"line","ruby":[[4,1,"い"],[7,1,"もの"],[9,1,"ち"],[12,1,"しゅ"],[15,1,"まえ"],[17,1,"あゆ"]],"text":"わたしは生ける者の地で、主のみ前に歩みます。"},{"ref":"Ps.116.10","start":19116010,"end":19116010,"break":"line","ruby":[[5,1,"おお"],[8,1,"なや"],[13,1,"い"],[16,1,"とき"],[21,1,"しん"]],"text":"「わたしは大いに悩んだ」と言った時にもなお信じた。"},{"ref":"Ps.116.11","start":19116011,"end":19116011,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"おどろ"],[13,1,"い"],[22,1,"ひと"],[24,1,"あて"],[29,1,"もの"]],"text":"わたしは驚きあわてたときに言った、「すべての人は当にならぬ者である」と。"},{"ref":"Ps.116.12","start":19116012,"end":19116012,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"たま"],[13,1,"めぐ"],[24,1,"しゅ"],[26,1,"むく"]],"text":"わたしに賜わったもろもろの恵みについて、どうして主に報いることができようか。"},{"ref":"Ps.116.13","start":19116013,"end":19116013,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"すくい"],[6,1,"さかずき"],[12,1,"しゅ"],[15,1,"な"],[17,1,"よ"]],"text":"わたしは救の杯をあげて、主のみ名を呼ぶ。"},{"ref":"Ps.116.14","start":19116014,"end":19116014,"break":"line","breaks":[[13,"line"]],"ruby":[[8,1,"たみ"],[10,1,"まえ"],[13,1,"しゅ"],[17,1,"ちか"]],"text":"わたしはすべての民の前で、主にわが誓いをつぐなおう。"},{"ref":"Ps.116.15","start":19116015,"end":19116015,"break":"line","ruby":[[0,1,"しゅ"],[2,2,"せいと"],[5,1,"し"],[10,1,"まえ"],[15,1,"たっと"]],"text":"主の聖徒の死はそのみ前において尊い。"},{"ref":"Ps.116.16","start":19116016,"end":19116016,"break":"line","breaks":[[17,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[38,1,"こ"],[54,1,"と"]],"text":"主よ、わたしはあなたのしもべです。わたしはあなたのしもべ、あなたのはしための子です。あなたはわたしのなわめを解かれました。"},{"ref":"Ps.116.17","start":19116017,"end":19116017,"break":"line","breaks":[[21,"line"]],"ruby":[[4,2,"かんしゃ"],[21,1,"しゅ"],[24,1,"な"],[26,1,"よ"]],"text":"わたしは感謝のいけにえをあなたにささげて、主のみ名を呼びます。"},{"ref":"Ps.116.18","start":19116018,"end":19116018,"break":"line","breaks":[[12,"line"]],"ruby":[[8,1,"たみ"],[10,1,"まえ"],[12,1,"しゅ"],[16,1,"ちか"]],"text":"わたしはすべての民の前で主にわが誓いをつぐないます。"},{"ref":"Ps.116.19","start":19116019,"end":19116019,"break":"line","breaks":[[14,"line"],[34,"line"]],"ruby":[[11,1,"なか"],[14,1,"しゅ"],[16,1,"いえ"],[18,2,"おおにわ"],[21,1,"なか"],[34,1,"しゅ"]],"text":"エルサレムよ、あなたの中で、主の家の大庭の中で、これをつぐないます。主をほめたたえよ。"}]