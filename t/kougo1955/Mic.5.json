[{"ref":"Mic.5.1","start":33005001,"end":33005001,"break":"paragraph","breaks":[[16,"line"],[28,"line"]],"ruby":[[0,1,"いま"],[5,1,"かべ"],[16,1,"てき"],[23,1,"せ"],[25,1,"かこ"],[47,1,"う"]],"text":"今あなたは壁でとりまかれている。敵はわれわれを攻め囲み、つえをもってイスラエルのつかさのほおを撃つ。"},{"ref":"Mic.5.2","start":33005002,"end":33005002,"break":"stanza","breaks":[[15,"line"],[35,"line"],[54,"line"],[64,"line"]],"ruby":[[22,2,"しぞく"],[28,1,"ちい"],[31,1,"もの"],[41,1,"おさ"],[44,1,"もの"],[61,1,"で"],[66,1,"で"],[70,1,"むかし"],[79,1,"ひ"]],"text":"しかしベツレヘム・エフラタよ、あなたはユダの氏族のうちで小さい者だが、イスラエルを治める者があなたのうちからわたしのために出る。その出るのは昔から、いにしえの日からである。"},{"ref":"Mic.5.3","start":33005003,"end":33005003,"break":"line","breaks":[[17,"line"],[29,"line"],[44,"line"]],"ruby":[[5,2,"さんぷ"],[8,1,"う"],[13,1,"とき"],[17,1,"しゅ"],[19,1,"かれ"],[22,1,"わた"],[31,1,"のち"],[34,2,"きょうだい"],[39,1,"のこ"],[42,1,"もの"],[50,1,"こ"],[56,1,"かえ"]],"text":"それゆえ、産婦の産みおとす時まで、主は彼らを渡しおかれる。その後その兄弟たちの残れる者はイスラエルの子らのもとに帰る。"},{"ref":"Mic.5.4","start":33005004,"end":33005004,"break":"line","breaks":[[9,"line"],[23,"line"],[34,"line"],[46,"line"],[60,"line"]],"ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"ちから"],[11,1,"かみ"],[13,1,"しゅ"],[15,1,"な"],[17,2,"いこう"],[23,1,"た"],[28,1,"む"],[31,1,"やしな"],[34,1,"かれ"],[37,1,"やす"],[46,1,"いま"],[48,1,"かれ"],[50,1,"おお"],[54,1,"もの"],[60,1,"ち"],[62,1,"はて"],[66,1,"およ"]],"text":"彼は主の力により、その神、主の名の威光により、立ってその群れを養い、彼らを安らかにおらせる。今、彼は大いなる者となって、地の果にまで及ぶからである。"},{"ref":"Mic.5.5","start":33005005,"end":33005005,"break":"stanza","breaks":[[9,"line"],[27,"line"],[40,"line"],[49,"line"]],"ruby":[[3,2,"へいわ"],[22,1,"くに"],[24,1,"き"],[32,2,"とち"],[35,1,"ふ"],[40,1,"しち"],[41,1,"にん"],[43,2,"ぼくしゃ"],[46,1,"おこ"],[50,1,"にん"],[52,1,"きみ"],[54,1,"おこ"],[60,1,"あた"]],"text":"これは平和である。アッスリヤびとがわれわれの国に来て、われわれの土地を踏むとき、七人の牧者を起し、八人の君を起してこれに当らせる。"},{"ref":"Mic.5.6","start":33005006,"end":33005006,"break":"line","breaks":[[21,"line"],[43,"line"],[61,"line"],[75,"line"]],"ruby":[[0,1,"かれ"],[16,1,"ち"],[18,1,"おさ"],[37,1,"ち"],[39,1,"おさ"],[56,1,"ち"],[58,1,"き"],[66,1,"さかい"],[68,1,"ふ"],[70,1,"あら"],[75,1,"かれ"],[93,1,"すく"]],"text":"彼らはつるぎをもってアッスリヤの地を治め、ぬきみのつるぎをもってニムロデの地を治める。アッスリヤびとがわれわれの地に来て、われわれの境を踏み荒すとき、彼らはアッスリヤびとから、われわれを救う。"},{"ref":"Mic.5.7","start":33005007,"end":33005007,"break":"line","breaks":[[24,"line"],[41,"line"],[53,"line"]],"ruby":[[2,1,"とき"],[7,1,"のこ"],[10,1,"もの"],[12,1,"おお"],[15,1,"たみ"],[17,1,"なか"],[24,1,"ひと"],[32,1,"ひと"],[34,1,"こ"],[37,1,"ま"],[41,1,"しゅ"],[47,1,"つゆ"],[53,2,"あおくさ"],[56,1,"うえ"],[58,1,"ふ"],[60,2,"ゆうだ"]],"text":"その時ヤコブの残れる者は多くの民の中にあること、人によらず、また人の子らを待たずに主からくだる露のごとく、青草の上に降る夕立ちのようである。"},{"ref":"Mic.5.8","start":33005008,"end":33005008,"break":"line","breaks":[[19,"line"],[31,"line"],[44,"line"],[62,"line"]],"ruby":[[6,1,"のこ"],[9,1,"もの"],[11,2,"くにぐに"],[14,1,"なか"],[19,1,"おお"],[22,1,"たみ"],[24,1,"なか"],[31,1,"はやし"],[33,1,"けもの"],[35,1,"なか"],[44,1,"ひつじ"],[46,1,"む"],[49,1,"なか"],[51,1,"わか"],[65,1,"す"],[71,1,"ふ"],[76,1,"さ"],[79,1,"すく"],[81,1,"もの"]],"text":"またヤコブの残れる者が国々の中におり、多くの民の中にいること、林の獣の中のししのごとく、羊の群れの中の若いししのようである。それが過ぎるときは踏み、かつ裂いて救う者はない。"},{"ref":"Mic.5.9","start":33005009,"end":33005009,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"て"],[14,1,"うえ"],[25,1,"てき"],[32,1,"た"]],"text":"あなたの手はもろもろのあだの上にあげられ、あなたの敵はことごとく断たれる。"},{"ref":"Mic.5.10","start":33005010,"end":33005010,"break":"stanza","breaks":[[13,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"ひ"],[25,1,"うま"],[27,1,"た"],[31,2,"せんしゃ"]],"text":"主は言われる、その日には、わたしはあなたのうちから馬を絶やし、戦車をこわし、"},{"ref":"Mic.5.11","start":33005011,"end":33005011,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"くに"],[6,2,"まちまち"],[9,1,"た"],[17,1,"しろ"]],"text":"あなたの国の町々を絶やし、あなたの城をことごとくくつがえす。"},{"ref":"Mic.5.12","start":33005012,"end":33005012,"break":"line","breaks":[[16,"line"]],"ruby":[[6,1,"て"],[9,2,"まじゅつ"],[12,1,"た"],[24,1,"うらな"],[26,1,"し"]],"text":"またあなたの手から魔術を絶やす。あなたのうちには占い師がないようになる。"},{"ref":"Mic.5.13","start":33005013,"end":33005013,"break":"line","breaks":[[23,"line"]],"ruby":[[10,2,"ちょうぞう"],[15,1,"いし"],[17,1,"はしら"],[19,1,"た"],[27,1,"かさ"],[30,1,"て"],[32,1,"つく"],[35,1,"もの"],[37,1,"おが"]],"text":"またあなたのうちから彫像および石の柱を絶やす。あなたは重ねて手で作った物を拝むことはない。"},{"ref":"Mic.5.14","start":33005014,"end":33005014,"break":"line","breaks":[[20,"line"]],"ruby":[[13,1,"ぞう"],[15,1,"ぬ"],[17,1,"たお"],[24,2,"まちまち"],[27,1,"ほろ"]],"text":"またあなたのうちからアシラ像を抜き倒し、あなたの町々を滅ぼす。"},{"ref":"Mic.5.15","start":33005015,"end":33005015,"break":"line","breaks":[[17,"line"]],"ruby":[[7,1,"いか"],[10,1,"いきどお"],[19,1,"き"],[21,1,"したが"],[30,2,"くにたみ"],[33,2,"ふくしゅう"]],"text":"そしてわたしは怒りと憤りとをもってその聞き従わないもろもろの国民に復讐する。"}]