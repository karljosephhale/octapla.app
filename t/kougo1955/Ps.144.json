[{"ref":"Ps.144.1","start":19144001,"end":19144001,"break":"paragraph","title":"ダビデの歌","breaks":[[14,"line"],[32,"line"]],"ruby":[[2,1,"いわ"],[5,1,"しゅ"],[14,1,"しゅ"],[27,1,"て"],[29,1,"おし"],[32,1,"たたか"],[39,1,"ゆび"],[41,1,"おし"]],"titleRuby":[[4,1,"うた"]],"text":"わが岩なる主はほむべきかな。主は、いくさすることをわが手に教え、戦うことをわが指に教えられます。"},{"ref":"Ps.144.2","start":19144002,"end":19144002,"break":"line","breaks":[[10,"line"],[23,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"いわ"],[8,1,"しろ"],[12,1,"たか"],[20,2,"すくいぬし"],[25,1,"たて"],[29,1,"よ"],[31,1,"たの"],[33,1,"もの"],[37,1,"しゅ"],[44,1,"たみ"],[50,1,"したが"]],"text":"主はわが岩、わが城、わが高きやぐら、わが救主、わが盾、わが寄り頼む者です。主はもろもろの民をおのれに従わせられます。"},{"ref":"Ps.144.3","start":19144003,"end":19144003,"break":"line","breaks":[[24,"line"],[35,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"ひと"],[5,1,"なに"],[24,1,"ひと"],[26,1,"こ"],[28,1,"なに"]],"text":"主よ、人は何ものなので、あなたはこれをかえりみ、人の子は何ものなので、これをみこころに、とめられるのですか。"},{"ref":"Ps.144.4","start":19144004,"end":19144004,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"ひと"],[2,1,"いき"],[11,1,"ひ"],[13,1,"す"],[17,1,"かげ"]],"text":"人は息にひとしく、その日は過ぎゆく影にひとしいのです。"},{"ref":"Ps.144.5","start":19144005,"end":19144005,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"てん"],[9,1,"た"],[16,1,"やま"],[18,1,"ふ"],[21,1,"けむり"],[23,1,"だ"]],"text":"主よ、あなたの天を垂れてくだり、山に触れて煙を出させてください。"},{"ref":"Ps.144.6","start":19144006,"end":19144006,"break":"line","breaks":[[15,"line"]],"ruby":[[5,1,"はな"],[8,1,"かれ"],[11,1,"ち"],[15,1,"や"],[17,1,"はな"],[20,1,"かれ"],[23,1,"う"],[25,1,"やぶ"]],"text":"いなずまを放って彼らを散らし、矢を放って彼らを打ち敗ってください。"},{"ref":"Ps.144.7","start":19144007,"end":19144007,"break":"line","breaks":[[19,"line"],[31,"line"]],"ruby":[[0,1,"たか"],[2,1,"ところ"],[6,1,"て"],[8,1,"の"],[16,1,"すく"],[19,2,"おおみず"],[24,3,"いほうじん"],[28,1,"て"],[35,1,"たす"],[37,1,"だ"]],"text":"高い所からみ手を伸べて、わたしを救い、大水から、異邦人の手からわたしを助け出してください。"},{"ref":"Ps.144.8","start":19144008,"end":19144008,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[3,1,"くち"],[5,1,"いつわ"],[8,1,"い"],[13,1,"みぎ"],[15,1,"て"],[17,1,"いつわ"],[20,1,"みぎ"],[22,1,"て"]],"text":"彼らの口は偽りを言い、その右の手は偽りの右の手です。"},{"ref":"Ps.144.9","start":19144009,"end":19144009,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かみ"],[7,1,"あたら"],[10,1,"うた"],[20,1,"うた"],[23,2,"じゅうげん"],[26,2,"たてごと"],[39,1,"うた"]],"text":"神よ、わたしは新しい歌をあなたにむかって歌い、十弦の立琴にあわせてあなたをほめ歌います。"},{"ref":"Ps.144.10","start":19144010,"end":19144010,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"おう"],[8,2,"しょうり"],[11,1,"あた"],[23,1,"すく"]],"text":"あなたは王たちに勝利を与え、そのしもべダビデを救われます。"},{"ref":"Ps.144.11","start":19144011,"end":19144011,"break":"line","breaks":[[15,"line"],[32,"line"],[43,"line"]],"ruby":[[4,2,"ざんにん"],[12,1,"すく"],[15,3,"いほうじん"],[19,1,"て"],[22,1,"たす"],[24,1,"だ"],[32,1,"かれ"],[35,1,"くち"],[37,1,"いつわ"],[40,1,"い"],[45,1,"みぎ"],[47,1,"て"],[49,1,"いつわ"],[52,1,"みぎ"],[54,1,"て"]],"text":"わたしを残忍なつるぎから救い、異邦人の手から助け出してください。彼らの口は偽りを言い、その右の手は偽りの右の手です。"},{"ref":"Ps.144.12","start":19144012,"end":19144012,"break":"line","breaks":[[16,"line"],[29,"line"],[49,"line"]],"ruby":[[12,1,"わか"],[14,1,"とき"],[18,1,"そだ"],[21,2,"くさき"],[33,1,"むすめ"],[37,1,"みや"],[39,2,"たてもの"],[45,1,"きざ"],[52,1,"はしら"]],"text":"われらのむすこたちはその若い時、よく育った草木のようです。われらの娘たちは宮の建物のために刻まれたすみの柱のようです。"},{"ref":"Ps.144.13","start":19144013,"end":19144013,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"くら"],[6,1,"み"],[9,2,"さまざま"],[12,1,"もの"],[14,1,"そな"],[21,1,"ひつじ"],[23,1,"の"],[30,1,"こ"],[32,1,"う"]],"text":"われらの倉は満ちて様々の物を備え、われらの羊は野でちよろずの子を産み、"},{"ref":"Ps.144.14","start":19144014,"end":19144014,"break":"line","breaks":[[24,"line"]],"ruby":[[4,2,"かちく"],[12,1,"こ"],[14,1,"う"],[17,1,"あやま"],[33,1,"なや"],[36,1,"さけ"]],"text":"われらの家畜はみごもって子を産むに誤ることなく、われらのちまたには悩みの叫びがありません。"},{"ref":"Ps.144.15","start":19144015,"end":19144015,"break":"line","breaks":[[19,"line"]],"ruby":[[5,2,"しゅくふく"],[10,1,"たみ"],[19,1,"しゅ"],[24,1,"かみ"],[28,1,"たみ"]],"text":"このような祝福をもつ民はさいわいです。主をおのが神とする民はさいわいです。"}]