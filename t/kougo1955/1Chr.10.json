[{"ref":"1Chr.10.1","start":13010001,"end":13010001,"break":"paragraph","ruby":[[15,1,"たたか"],[26,2,"ひとびと"],[36,1,"まえ"],[39,1,"に"],[46,1,"やま"],[48,1,"ころ"],[52,1,"たお"]],"text":"さてペリシテびとはイスラエルと戦ったが、イスラエルの人々がペリシテびとの前から逃げ、ギルボア山で殺されて倒れたので、"},{"ref":"1Chr.10.2","start":13010002,"end":13010002,"break":"none","ruby":[[13,1,"こ"],[20,1,"お"],[27,1,"こ"],[48,1,"ころ"]],"text":"ペリシテびとはサウルとその子たちのあとを追い、サウルの子ヨナタン、アビナダブおよびマルキシュアを殺した。"},{"ref":"1Chr.10.3","start":13010003,"end":13010003,"break":"none","ruby":[[0,1,"たたか"],[3,1,"はげ"],[12,1,"せま"],[15,2,"いて"],[18,1,"もの"],[29,1,"み"],[36,1,"かれ"],[38,2,"て"],[41,1,"もの"],[45,1,"きず"],[47,1,"お"]],"text":"戦いは激しくサウルにおし迫り、射手の者どもがついにサウルを見つけたので、彼は射手の者どもに傷を負わされた。"},{"ref":"1Chr.10.4","start":13010004,"end":13010004,"break":"none","ruby":[[9,2,"ぶき"],[12,1,"と"],[14,1,"もの"],[16,1,"い"],[25,1,"ぬ"],[38,1,"さ"],[51,2,"かつれい"],[55,1,"もの"],[57,1,"き"],[81,2,"ぶき"],[84,1,"と"],[86,1,"もの"],[91,1,"おそ"],[94,1,"き"],[118,1,"うえ"],[120,1,"ふ"]],"text":"そこでサウルはその武器を執る者に言った、「つるぎを抜き、それをもってわたしを刺せ。さもないと、これらの割礼なき者が来て、わたしをはずかしめるであろう」。しかしその武器を執る者がいたく恐れて聞きいれなかったので、サウルはつるぎをとってその上に伏した。"},{"ref":"1Chr.10.5","start":13010005,"end":13010005,"break":"none","ruby":[[0,2,"ぶき"],[3,1,"と"],[5,1,"もの"],[11,1,"し"],[16,1,"み"],[19,2,"じぶん"],[28,1,"うえ"],[30,1,"ふ"],[33,1,"し"]],"text":"武器を執る者はサウルの死んだのを見て、自分もまたつるぎの上に伏して死んだ。"},{"ref":"1Chr.10.6","start":13010006,"end":13010006,"break":"none","ruby":[[9,1,"にん"],[11,1,"こ"],[18,2,"かぞく"],[21,1,"みな"],[25,1,"し"]],"text":"こうしてサウルと三人の子らおよびその家族は皆ともに死んだ。"},{"ref":"1Chr.10.7","start":13010007,"end":13010007,"break":"none","ruby":[[0,1,"たに"],[10,2,"ひとびと"],[13,1,"みな"],[14,1,"かれ"],[17,1,"に"],[22,1,"み"],[32,1,"こ"],[35,1,"し"],[40,1,"み"],[43,2,"まちまち"],[49,1,"に"],[62,1,"き"],[69,1,"す"]],"text":"谷にいたイスラエルの人々は皆彼らの逃げるのを見、またサウルとその子らの死んだのを見て、町々をすてて逃げたので、ペリシテびとが来てそのうちに住んだ。"},{"ref":"1Chr.10.8","start":13010008,"end":13010008,"break":"paragraph","ruby":[[3,1,"ひ"],[11,1,"ころ"],[15,1,"もの"],[21,1,"と"],[26,1,"き"],[35,1,"こ"],[42,1,"やま"],[44,1,"たお"],[51,1,"み"]],"text":"あくる日ペリシテびとは殺された者から、はぎ取るために来て、サウルとその子らのギルボア山に倒れているのを見、"},{"ref":"1Chr.10.9","start":13010009,"end":13010009,"break":"none","ruby":[[9,1,"くび"],[19,1,"と"],[29,1,"くに"],[31,2,"しほう"],[34,1,"ひと"],[44,1,"よ"],[46,1,"し"],[52,2,"ぐうぞう"],[55,1,"たみ"],[57,1,"つ"]],"text":"サウルをはいでその首と、よろいかぶとを取り、ペリシテびとの国の四方に人をつかわして、この良き知らせをその偶像と民に告げさせた。"},{"ref":"1Chr.10.10","start":13010010,"end":13010010,"break":"none","ruby":[[14,1,"かれ"],[17,1,"かみ"],[19,1,"いえ"],[21,1,"お"],[24,1,"くび"],[30,2,"しんでん"]],"text":"そしてサウルのよろいかぶとを彼らの神の家に置き、首をダゴンの神殿にくぎづけにした。"},{"ref":"1Chr.10.11","start":13010011,"end":13010011,"break":"none","ruby":[[12,2,"ひとびと"],[15,1,"みな"],[32,1,"き"]],"text":"しかしヤベシ・ギレアデの人々は皆ペリシテびとがサウルにしたことを聞いたので、"},{"ref":"1Chr.10.12","start":13010012,"end":13010012,"break":"none","ruby":[[0,2,"ゆうし"],[5,1,"みな"],[6,1,"た"],[8,1,"あ"],[22,1,"こ"],[40,1,"も"],[43,1,"き"],[53,1,"き"],[55,1,"した"],[59,1,"ほね"],[61,1,"ほうむ"],[64,2,"なぬか"],[67,1,"あいだ"],[69,2,"だんじき"]],"text":"勇士たちが皆立ち上がり、サウルのからだとその子らのからだをとって、これをヤベシに持って来て、ヤベシのかしの木の下にその骨を葬り、七日の間、断食した。"},{"ref":"1Chr.10.13","start":13010013,"end":13010013,"break":"paragraph","ruby":[[8,1,"しゅ"],[14,1,"おか"],[17,1,"つみ"],[22,1,"し"],[30,1,"かれ"],[32,1,"しゅ"],[34,2,"ことば"],[37,1,"まも"],[43,2,"くちよ"],[47,1,"と"]],"text":"こうしてサウルは主にむかって犯した罪のために死んだ。すなわち彼は主の言葉を守らず、また口寄せに問うことをして、"},{"ref":"1Chr.10.14","start":13010014,"end":13010014,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"と"],[16,1,"しゅ"],[18,1,"かれ"],[20,1,"ころ"],[25,1,"くに"],[27,1,"うつ"],[35,1,"こ"],[40,1,"あた"]],"text":"主に問うことをしなかった。それで主は彼を殺し、その国を移してエッサイの子ダビデに与えられた。"}]