[{"ref":"Jonah.1.1","start":32001001,"end":32001001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"こ"],[15,1,"のぞ"],[18,1,"い"]],"text":"主の言葉がアミッタイの子ヨナに臨んで言った、"},{"ref":"Jonah.1.2","start":32001002,"end":32001002,"break":"none","ruby":[[1,1,"た"],[7,1,"おお"],[10,1,"まち"],[15,1,"い"],[21,1,"む"],[25,1,"よ"],[30,1,"かれ"],[33,1,"あく"],[39,1,"まえ"],[41,1,"のぼ"]],"text":"「立って、あの大きな町ニネベに行き、これに向かって呼ばわれ。彼らの悪がわたしの前に上ってきたからである」。"},{"ref":"Jonah.1.3","start":32001003,"end":32001003,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"まえ"],[10,1,"はな"],[25,1,"た"],[32,1,"くだ"],[35,1,"い"],[53,1,"い"],[55,1,"ふね"],[63,2,"ふなちん"],[66,1,"はら"],[69,1,"しゅ"],[71,1,"まえ"],[73,1,"はな"],[77,2,"ひとびと"],[80,1,"とも"],[87,1,"い"],[91,1,"ふね"],[93,1,"の"]],"text":"しかしヨナは主の前を離れてタルシシへのがれようと、立ってヨッパに下って行った。ところがちょうど、タルシシへ行く船があったので、船賃を払い、主の前を離れて、人々と共にタルシシへ行こうと船に乗った。"},{"ref":"Jonah.1.4","start":32001004,"end":32001004,"break":"paragraph","ruby":[[0,1,"とき"],[3,1,"しゅ"],[5,2,"おおかぜ"],[8,1,"うみ"],[10,1,"うえ"],[12,1,"おこ"],[19,1,"ふね"],[21,1,"やぶ"],[27,1,"はげ"],[30,2,"ぼうふう"],[33,1,"うみ"],[35,1,"うえ"]],"text":"時に、主は大風を海の上に起されたので、船が破れるほどの激しい暴風が海の上にあった。"},{"ref":"Jonah.1.5","start":32001005,"end":32001005,"break":"none","ruby":[[3,2,"すいふ"],[8,1,"おそ"],[16,2,"じぶん"],[19,1,"かみ"],[21,1,"よ"],[23,1,"もと"],[28,1,"ふね"],[30,1,"かる"],[39,1,"なか"],[41,1,"つ"],[43,1,"に"],[45,1,"うみ"],[47,1,"な"],[49,1,"す"],[60,1,"ふね"],[62,1,"おく"],[64,1,"くだ"],[67,1,"ふ"],[70,2,"じゅくすい"]],"text":"それで水夫たちは恐れて、めいめい自分の神を呼び求め、また船を軽くするため、その中の積み荷を海に投げ捨てた。しかし、ヨナは船の奥に下り、伏して熟睡していた。"},{"ref":"Jonah.1.6","start":32001006,"end":32001006,"break":"none","ruby":[[3,2,"せんちょう"],[6,1,"き"],[9,1,"かれ"],[11,1,"い"],[24,1,"ねむ"],[32,1,"お"],[40,1,"かみ"],[42,1,"よ"],[50,1,"かみ"],[62,1,"かえり"],[66,1,"たす"]],"text":"そこで船長は来て、彼に言った、「あなたはどうして眠っているのか。起きて、あなたの神に呼ばわりなさい。神があるいは、われわれを顧みて、助けてくださるだろう」。"},{"ref":"Jonah.1.7","start":32001007,"end":32001007,"break":"paragraph","ruby":[[3,2,"ひとびと"],[6,1,"たがい"],[8,1,"い"],[15,1,"わざわい"],[22,1,"のぞ"],[34,1,"し"],[46,1,"ひ"],[57,1,"かれ"],[64,1,"ひ"],[77,1,"あた"]],"text":"やがて人々は互に言った、「この災がわれわれに臨んだのは、だれのせいか知るために、さあ、くじを引いてみよう」。そして彼らが、くじを引いたところ、くじはヨナに当った。"},{"ref":"Jonah.1.8","start":32001008,"end":32001008,"break":"none","ruby":[[3,2,"ひとびと"],[9,1,"い"],[16,1,"わざわい"],[30,1,"のぞ"],[41,1,"つ"],[51,2,"しょくぎょう"],[54,1,"なに"],[65,1,"き"],[74,1,"くに"],[87,1,"たみ"]],"text":"そこで人々はヨナに言った、「この災がだれのせいで、われわれに臨んだのか、われわれに告げなさい。あなたの職業は何か。あなたはどこから来たのか。あなたの国はどこか。あなたはどこの民か」。"},{"ref":"Jonah.1.9","start":32001009,"end":32001009,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[27,1,"うみ"],[29,1,"りく"],[33,1,"つく"],[39,1,"てん"],[41,1,"かみ"],[43,1,"しゅ"],[45,1,"おそ"],[48,1,"もの"]],"text":"ヨナは彼らに言った、「わたしはヘブルびとです。わたしは海と陸とをお造りになった天の神、主を恐れる者です」。"},{"ref":"Jonah.1.10","start":32001010,"end":32001010,"break":"none","ruby":[[3,2,"ひとびと"],[12,1,"おそ"],[16,1,"かれ"],[18,1,"い"],[31,1,"こと"],[42,2,"ひとびと"],[45,1,"かれ"],[50,1,"かれ"],[53,1,"つ"],[56,1,"こと"],[62,1,"かれ"],[64,1,"しゅ"],[66,1,"まえ"],[68,1,"はな"],[82,1,"こと"],[84,1,"し"]],"text":"そこで人々ははなはだしく恐れて、彼に言った、「あなたはなんたる事をしてくれたのか」。人々は彼がさきに彼らに告げた事によって、彼が主の前を離れて、のがれようとしていた事を知っていたからである。"},{"ref":"Jonah.1.11","start":32001011,"end":32001011,"break":"paragraph","ruby":[[0,2,"ひとびと"],[3,1,"かれ"],[5,1,"い"],[18,1,"うみ"],[20,1,"しず"],[45,1,"うみ"],[51,1,"あ"]],"text":"人々は彼に言った、「われわれのために海が静まるには、あなたをどうしたらよかろうか」。それは海がますます荒れてきたからである。"},{"ref":"Jonah.1.12","start":32001012,"end":32001012,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[15,1,"と"],[18,1,"うみ"],[20,1,"な"],[22,1,"い"],[33,1,"うみ"],[45,1,"しず"],[70,1,"はげ"],[73,2,"ぼうふう"],[82,1,"のぞ"]],"text":"ヨナは彼らに言った、「わたしを取って海に投げ入れなさい。そうしたら海は、あなたがたのために静まるでしょう。わたしにはよくわかっています。この激しい暴風があなたがたに臨んだのは、わたしのせいです」。"},{"ref":"Jonah.1.13","start":32001013,"end":32001013,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"ふね"],[8,1,"りく"],[23,2,"せいこう"],[34,1,"うみ"],[36,1,"かれ"],[39,1,"さか"],[48,1,"あ"]],"text":"しかし人々は船を陸にこぎもどそうとつとめたが、成功しなかった。それは海が彼らに逆らって、いよいよ荒れたからである。"},{"ref":"Jonah.1.14","start":32001014,"end":32001014,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"しゅ"],[8,1,"よ"],[13,1,"い"],[18,1,"しゅ"],[27,1,"ひと"],[29,2,"せいめい"],[41,1,"ほろ"],[54,1,"つみ"],[57,1,"ち"],[65,1,"き"],[75,1,"しゅ"],[82,1,"こころ"],[84,1,"したが"],[92,1,"こと"]],"text":"そこで人々は主に呼ばわって言った、「主よ、どうぞ、この人の生命のために、われわれを滅ぼさないでください。また罪なき血を、われわれに帰しないでください。主よ、これはみ心に従って、なされた事だからです」。"},{"ref":"Jonah.1.15","start":32001015,"end":32001015,"break":"none","ruby":[[3,1,"かれ"],[9,1,"と"],[12,1,"うみ"],[14,1,"な"],[16,1,"い"],[23,1,"うみ"],[25,1,"あ"]],"text":"そして彼らはヨナを取って海に投げ入れた。すると海の荒れるのがやんだ。"},{"ref":"Jonah.1.16","start":32001016,"end":32001016,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"おお"],[9,1,"しゅ"],[11,1,"おそ"],[14,2,"ぎせい"],[17,1,"しゅ"],[24,2,"せいがん"],[27,1,"た"]],"text":"そこで人々は大いに主を恐れ、犠牲を主にささげて、誓願を立てた。"},{"ref":"Jonah.1.17","start":32001017,"end":32001017,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"おお"],[6,1,"うお"],[8,1,"そな"],[26,1,"か"],[28,1,"よ"],[31,1,"うお"],[33,1,"はら"],[35,1,"うち"]],"text":"主は大いなる魚を備えて、ヨナをのませられた。ヨナは三日三夜その魚の腹の中にいた。"}]