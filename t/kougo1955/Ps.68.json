[{"ref":"Ps.68.1","start":19068001,"end":19068001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌、さんび","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[3,1,"た"],[12,1,"てき"],[14,1,"ち"],[18,1,"かみ"],[20,1,"にく"],[22,1,"もの"],[25,1,"まえ"],[28,1,"に"],[30,1,"さ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"神よ、立ちあがって、その敵を散らし、神を憎む者をみ前から逃げ去らせてください。"},{"ref":"Ps.68.2","start":19068002,"end":19068002,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[0,1,"けむり"],[2,1,"お"],[11,1,"かれ"],[14,1,"お"],[22,1,"ひ"],[24,1,"まえ"],[26,1,"と"],[32,1,"あ"],[35,1,"もの"],[37,1,"かみ"],[39,1,"まえ"],[41,1,"ほろ"]],"text":"煙の追いやられるように彼らを追いやり、ろうの火の前に溶けるように悪しき者を神の前に滅ぼしてください。"},{"ref":"Ps.68.3","start":19068003,"end":19068003,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"ただ"],[6,1,"もの"],[8,1,"よろこ"],[12,1,"かみ"],[14,1,"まえ"],[16,1,"よろこ"],[18,1,"おど"],[22,1,"よろこ"],[24,1,"たの"]],"text":"しかし正しい者を喜ばせ、神の前に喜び踊らせ、喜び楽しませてください。"},{"ref":"Ps.68.4","start":19068004,"end":19068004,"break":"line","breaks":[[20,"line"],[39,"line"]],"ruby":[[0,1,"かみ"],[6,1,"うた"],[12,1,"な"],[20,1,"くも"],[22,1,"の"],[26,1,"もの"],[32,2,"うたごえ"],[41,1,"な"],[43,1,"しゅ"],[48,1,"まえ"],[50,1,"よろこ"],[52,1,"おど"]],"text":"神にむかって歌え、そのみ名をほめうたえ。雲に乗られる者にむかって歌声をあげよ。その名は主、そのみ前に喜び踊れ。"},{"ref":"Ps.68.5","start":19068005,"end":19068005,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"せい"],[13,1,"かみ"],[20,1,"ちち"],[26,2,"ほご"],[28,1,"もの"]],"text":"その聖なるすまいにおられる神はみなしごの父、やもめの保護者である。"},{"ref":"Ps.68.6","start":19068006,"end":19068006,"break":"line","breaks":[[18,"line"],[35,"line"]],"ruby":[[0,1,"かみ"],[2,1,"よ"],[7,1,"もの"],[9,1,"す"],[13,1,"いえ"],[15,1,"あた"],[24,1,"と"],[27,2,"こうふく"],[30,1,"みちび"],[41,1,"もの"],[47,1,"ち"],[49,1,"す"]],"text":"神は寄るべなき者に住むべき家を与え、めしゅうどを解いて幸福に導かれる。しかしそむく者はかわいた地に住む。"},{"ref":"Ps.68.7","start":19068007,"end":19068007,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かみ"],[7,1,"たみ"],[9,1,"さき"],[12,1,"で"],[15,2,"あらの"],[18,1,"すす"],[20,1,"い"]],"text":"神よ、あなたが民に先だち出て、荒野を進み行かれたとき、〔セラ"},{"ref":"Ps.68.8","start":19068008,"end":19068008,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[4,1,"しゅ"],[7,1,"かみ"],[9,1,"まえ"],[18,1,"かみ"],[21,1,"かみ"],[23,1,"まえ"],[26,1,"ち"],[28,1,"ふる"],[31,1,"てん"],[33,1,"あめ"],[35,1,"ふ"]],"text":"シナイの主なる神の前に、イスラエルの神なる神の前に、地は震い、天は雨を降らせました。"},{"ref":"Ps.68.9","start":19068009,"end":19068009,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かみ"],[7,1,"ゆた"],[10,1,"あめ"],[12,1,"ふ"],[17,1,"つか"],[19,1,"おとろ"],[26,1,"し"],[27,1,"ぎょう"],[29,1,"ち"],[31,2,"かいふく"]],"text":"神よ、あなたは豊かな雨を降らせて、疲れ衰えたあなたの嗣業の地を回復され、"},{"ref":"Ps.68.10","start":19068010,"end":19068010,"break":"line","breaks":[[22,"line"],[35,"line"]],"ruby":[[4,1,"む"],[17,1,"え"],[22,1,"かみ"],[29,1,"めぐ"],[35,1,"まず"],[38,1,"もの"],[43,1,"そな"]],"text":"あなたの群れは、そのうちにすまいを得ました。神よ、あなたは恵みをもって貧しい者のために備えられました。"},{"ref":"Ps.68.11","start":19068011,"end":19068011,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"めいれい"],[5,1,"くだ"],[15,1,"たずさ"],[18,1,"おんな"],[22,1,"おお"],[26,1,"む"],[29,1,"い"]],"text":"主は命令を下される。おとずれを携えた女たちの大いなる群れは言う、"},{"ref":"Ps.68.12","start":19068012,"end":19068012,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[6,2,"ぐんぜい"],[9,1,"おう"],[13,1,"に"],[15,1,"さ"],[18,1,"に"],[20,1,"さ"],[26,1,"いえ"],[32,1,"おんな"],[36,2,"えもの"],[39,1,"わ"]],"text":"「もろもろの軍勢の王たちは逃げ去り、逃げ去った」と。家にとどまる女たちは獲物を分ける、"},{"ref":"Ps.68.13","start":19068013,"end":19068013,"break":"line","breaks":[[20,"line"],[39,"line"]],"ruby":[[3,1,"かれ"],[6,1,"ひつじ"],[11,1,"なか"],[23,1,"つばさ"],[41,1,"はね"]],"text":"たとい彼らは羊のおりの中にとどまるとも。はとの翼は、しろがねをもっておおわれ、その羽はきらめくこがねをもっておおわれる。"},{"ref":"Ps.68.14","start":19068014,"end":19068014,"break":"line","breaks":[[20,"line"]],"ruby":[[0,3,"ぜんのうしゃ"],[8,1,"おう"],[12,1,"ち"],[25,1,"ゆき"],[27,1,"ふ"]],"text":"全能者がかしこで王たちを散らされたとき、ザルモンに雪が降った。"},{"ref":"Ps.68.15","start":19068015,"end":19068015,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かみ"],[2,1,"やま"],[9,1,"やま"],[11,1,"みね"],[16,1,"やま"],[23,1,"やま"]],"text":"神の山、バシャンの山、峰かさなる山、バシャンの山よ。"},{"ref":"Ps.68.16","start":19068016,"end":19068016,"break":"line","breaks":[[13,"line"],[37,"line"]],"ruby":[[0,1,"みね"],[10,1,"やま"],[13,1,"なに"],[16,1,"かみ"],[23,1,"のぞ"],[27,1,"やま"],[32,1,"み"],[41,1,"しゅ"],[51,1,"す"]],"text":"峰かさなるもろもろの山よ、何ゆえ神がすまいにと望まれた山をねたみ見るのか。まことに主はとこしえにそこに住まわれる。"},{"ref":"Ps.68.17","start":19068017,"end":19068017,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かみ"],[7,1,"ぐるま"],[8,1,"いく"],[9,2,"せんまん"],[21,2,"せいじょ"],[24,1,"こ"]],"text":"主は神のいくさ車幾千万をもって、シナイから聖所に来られた。"},{"ref":"Ps.68.18","start":19068018,"end":19068018,"break":"line","breaks":[[11,"line"],[30,"line"],[47,"line"]],"ruby":[[8,1,"ひき"],[11,2,"ひとびと"],[24,1,"もの"],[30,1,"おく"],[32,1,"もの"],[38,1,"たか"],[40,1,"やま"],[42,1,"のぼ"],[47,1,"しゅ"],[50,1,"かみ"],[55,1,"す"]],"text":"あなたはとりこを率い、人々のうちから、またそむく者のうちから贈り物をうけて、高い山に登られた。主なる神がそこに住まわれるためである。"},{"ref":"Ps.68.19","start":19068019,"end":19068019,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"ひび"],[7,1,"に"],[9,1,"お"],[13,1,"しゅ"],[22,1,"かみ"],[28,1,"すくい"]],"text":"日々にわれらの荷を負われる主はほむべきかな。神はわれらの救である。〔セラ"},{"ref":"Ps.68.20","start":19068020,"end":19068020,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"かみ"],[6,1,"すくい"],[8,1,"かみ"],[13,1,"し"],[19,1,"え"],[23,1,"しゅ"],[26,1,"かみ"]],"text":"われらの神は救の神である。死からのがれ得るのは主なる神による。"},{"ref":"Ps.68.21","start":19068021,"end":19068021,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[0,1,"かみ"],[4,1,"てき"],[10,1,"う"],[12,1,"くだ"],[21,1,"なか"],[23,1,"あゆ"],[25,1,"もの"],[27,2,"けぶか"],[30,1,"あたま"],[37,1,"う"],[39,1,"くだ"]],"text":"神はその敵のこうべを打ち砕き、おのがとがの中に歩む者の毛深い頭のいただきを打ち砕かれる。"},{"ref":"Ps.68.22","start":19068022,"end":19068022,"break":"line","breaks":[[7,"line"],[26,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[18,1,"かれ"],[21,1,"たずさ"],[23,1,"かえ"],[26,1,"うみ"],[28,1,"ふか"],[30,1,"ところ"],[33,1,"かれ"],[36,1,"たずさ"],[38,1,"かえ"]],"text":"主は言われた、「わたしはバシャンから彼らを携え帰り、海の深い所から彼らを携え帰る。"},{"ref":"Ps.68.23","start":19068023,"end":19068023,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[6,1,"あし"],[8,1,"かれ"],[11,1,"ち"],[13,1,"ひた"],[20,1,"いぬ"],[22,1,"した"],[26,1,"わ"],[28,1,"まえ"],[30,1,"てき"],[33,1,"え"]],"text":"あなたはその足を彼らの血に浸し、あなたの犬の舌はその分け前を敵から得るであろう」と。"},{"ref":"Ps.68.24","start":19068024,"end":19068024,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かみ"],[3,2,"ひとびと"],[16,2,"ぎょうれつ"],[19,1,"み"],[24,1,"かみ"],[28,1,"おう"],[31,2,"せいじょ"],[34,1,"すす"],[36,1,"ゆ"],[42,1,"み"]],"text":"神よ、人々はあなたのこうごうしい行列を見た。わが神、わが王の、聖所に進み行かれるのを見た。"},{"ref":"Ps.68.25","start":19068025,"end":19068025,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"うた"],[2,1,"もの"],[4,1,"まえ"],[6,1,"い"],[9,1,"こと"],[13,1,"もの"],[28,1,"あいだ"],[33,1,"て"],[34,1,"つづみ"],[36,1,"う"],[39,1,"い"]],"text":"歌う者は前に行き、琴をひく者はあとになり、おとめらはその間にあって手鼓を打って言う、"},{"ref":"Ps.68.26","start":19068026,"end":19068026,"break":"line","breaks":[[14,"line"]],"ruby":[[1,1,"おお"],[5,2,"しゅうかい"],[8,1,"かみ"],[20,1,"みなもと"],[23,1,"で"],[25,1,"もの"],[28,1,"しゅ"]],"text":"「大いなる集会で神をほめよ。イスラエルの源から出た者よ、主をほめまつれ」と。"},{"ref":"Ps.68.27","start":19068027,"end":19068027,"break":"line","breaks":[[20,"line"],[37,"line"]],"ruby":[[3,1,"かれ"],[6,1,"みちび"],[8,1,"とし"],[9,1,"わか"],[22,1,"む"],[25,1,"なか"],[30,1,"きみ"],[42,1,"きみ"],[51,1,"きみ"]],"text":"そこに彼らを導く年若いベニヤミンがおり、その群れの中にユダの君たちがおり、ゼブルンの君たち、ナフタリの君たちがいる。"},{"ref":"Ps.68.28","start":19068028,"end":19068028,"break":"line","breaks":[[20,"line"],[36,"line"]],"ruby":[[0,1,"かみ"],[7,2,"たいのう"],[10,1,"ふる"],[12,1,"おこ"],[27,1,"こと"],[33,1,"かみ"],[40,1,"ちから"],[43,1,"しめ"]],"text":"神よ、あなたの大能を奮い起してください。われらのために事をなされた神よ、あなたの力をお示しください。"},{"ref":"Ps.68.29","start":19068029,"end":19068029,"break":"line","breaks":[[18,"line"]],"ruby":[[12,1,"みや"],[18,1,"おう"],[26,1,"おく"],[28,1,"もの"]],"text":"エルサレムにあるあなたの宮のために、王たちはあなたに贈り物をささげるでしょう。"},{"ref":"Ps.68.30","start":19068030,"end":19068030,"break":"line","breaks":[[8,"line"],[27,"line"],[37,"line"],[59,"line"]],"ruby":[[0,1,"あし"],[2,1,"なか"],[4,1,"す"],[6,1,"けもの"],[13,1,"たみ"],[15,1,"こ"],[16,1,"うし"],[18,1,"ひき"],[21,2,"おうし"],[24,1,"む"],[40,1,"もの"],[46,1,"もの"],[50,1,"あし"],[52,1,"した"],[54,1,"ふ"],[59,1,"たたか"],[62,1,"この"],[69,1,"たみ"],[71,1,"ち"]],"text":"葦の中に住む獣、もろもろの民の子牛を率いる雄牛の群れをいましめてください。みつぎ物をむさぼる者たちを足の下に踏みつけ、戦いを好むもろもろの民を散らしてください。"},{"ref":"Ps.68.31","start":19068031,"end":19068031,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[0,2,"せいどう"],[9,1,"も"],[23,1,"いそ"],[28,1,"て"],[30,1,"かみ"],[32,1,"の"]],"text":"青銅をエジプトから持ちきたらせ、エチオピヤには急いでその手を神に伸べさせてください。"},{"ref":"Ps.68.32","start":19068032,"end":19068032,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ち"],[7,1,"くに"],[10,1,"かみ"],[16,1,"うた"],[19,1,"しゅ"]],"text":"地のもろもろの国よ、神にむかって歌え、主をほめうたえ。〔セラ"},{"ref":"Ps.68.33","start":19068033,"end":19068033,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[7,1,"てん"],[9,1,"てん"],[11,1,"の"],[15,1,"しゅ"],[27,1,"み"],[30,1,"しゅ"],[33,1,"こえ"],[35,1,"だ"],[38,1,"ちから"],[42,1,"こえ"],[44,1,"だ"]],"text":"いにしえからの天の天に乗られる主にむかってほめうたえ。見よ、主はみ声を出し、力あるみ声を出される。"},{"ref":"Ps.68.34","start":19068034,"end":19068034,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"ちから"],[2,1,"かみ"],[4,1,"き"],[10,2,"いこう"],[19,1,"うえ"],[26,1,"ちから"],[28,1,"くも"],[30,1,"なか"]],"text":"力を神に帰せよ。その威光はイスラエルの上にあり、その力は雲の中にある。"},{"ref":"Ps.68.35","start":19068035,"end":19068035,"break":"line","breaks":[[12,"line"],[36,"line"]],"ruby":[[0,1,"かみ"],[4,2,"せいじょ"],[7,1,"おそ"],[18,1,"かみ"],[22,1,"たみ"],[24,1,"ちから"],[26,1,"いきお"],[30,1,"あた"],[36,1,"かみ"]],"text":"神はその聖所で恐るべく、イスラエルの神はその民に力と勢いとを与えられる。神はほむべきかな。"}]