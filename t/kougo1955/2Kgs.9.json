[{"ref":"2Kgs.9.1","start":12009001,"end":12009001,"break":"paragraph","ruby":[[0,1,"とき"],[2,3,"よげんしゃ"],[10,3,"よげんしゃ"],[23,1,"よ"],[26,1,"い"],[31,1,"こし"],[41,1,"あぶら"],[46,1,"たずさ"],[59,1,"い"]],"text":"時に預言者エリシャは預言者のともがらのひとりを呼んで言った、「腰をひきからげ、この油のびんを携えて、ラモテ・ギレアデへ行きなさい。"},{"ref":"2Kgs.9.2","start":12009002,"end":12009002,"break":"none","ruby":[[3,1,"つ"],[14,1,"こ"],[21,1,"こ"],[29,1,"たず"],[31,1,"だ"],[34,1,"うち"],[40,1,"かれ"],[44,2,"どうりょう"],[53,1,"た"],[58,1,"おく"],[60,1,"あいだ"],[62,1,"つ"],[65,1,"い"]],"text":"そこに着いたならば、ニムシの子ヨシャパテの子であるエヒウを尋ね出し、内にはいって彼をその同僚たちのうちから立たせて、奥の間に連れて行き、"},{"ref":"2Kgs.9.3","start":12009003,"end":12009003,"break":"none","ruby":[[0,1,"あぶら"],[5,1,"と"],[11,1,"あたま"],[13,1,"そそ"],[17,1,"しゅ"],[21,1,"おお"],[35,1,"あぶら"],[37,1,"そそ"],[46,1,"おう"],[52,1,"い"],[58,1,"と"],[63,1,"に"],[65,1,"さ"]],"text":"油のびんを取って、その頭に注ぎ、『主はこう仰せられる、わたしはあなたに油を注いでイスラエルの王とする』と言い、そして戸をあけて逃げ去りなさい。とどまってはならない」。"},{"ref":"2Kgs.9.4","start":12009004,"end":12009004,"break":"paragraph","ruby":[[3,3,"よげんしゃ"],[11,2,"わかもの"],[23,1,"い"]],"text":"そこで預言者であるその若者はラモテ・ギレアデへ行ったが、"},{"ref":"2Kgs.9.5","start":12009005,"end":12009005,"break":"none","ruby":[[0,1,"き"],[2,1,"み"],[6,2,"ぐんぜい"],[9,1,"ちょう"],[13,2,"かいぎ"],[15,1,"ちゅう"],[23,1,"かれ"],[26,2,"しょうぐん"],[38,1,"もう"],[43,1,"こと"],[51,1,"い"],[59,1,"こた"],[84,1,"い"],[90,1,"かれ"],[93,2,"しょうぐん"],[105,1,"い"]],"text":"来て見ると、軍勢の長たちが会議中であったので、彼は「将軍よ、わたしはあなたに申しあげる事があります」と言うと、エヒウが答えて、「われわれすべてのうちの、だれにですか」と言ったので、彼は「将軍よ、あなたにです」と言った。"},{"ref":"2Kgs.9.6","start":12009006,"end":12009006,"break":"none","ruby":[[7,1,"た"],[13,1,"いえ"],[22,2,"わかもの"],[27,1,"あたま"],[29,1,"あぶら"],[31,1,"そそ"],[34,1,"かれ"],[36,1,"い"],[47,1,"かみ"],[49,1,"しゅ"],[53,1,"おお"],[69,1,"あぶら"],[71,1,"そそ"],[75,1,"しゅ"],[77,1,"たみ"],[84,1,"おう"]],"text":"するとエヒウが立ちあがって家にはいったので、若者はその頭に油を注いで彼に言った、「イスラエルの神、主はこう仰せられます、『わたしはあなたに油を注いで、主の民イスラエルの王とする。"},{"ref":"2Kgs.9.7","start":12009007,"end":12009007,"break":"none","ruby":[[4,2,"しゅくん"],[10,1,"いえ"],[12,1,"う"],[14,1,"ほろ"],[47,3,"よげんしゃ"],[53,1,"ち"],[56,1,"しゅ"],[68,1,"ち"],[75,1,"むく"]],"text":"あなたは主君アハブの家を撃ち滅ぼさなければならない。それによってわたしは、わたしのしもべである預言者たちの血と、主のすべてのしもべたちの血をイゼベルに報いる。"},{"ref":"2Kgs.9.8","start":12009008,"end":12009008,"break":"none","ruby":[[4,2,"ぜんか"],[7,1,"ほろ"],[19,1,"ぞく"],[22,1,"おとこ"],[39,1,"もの"],[42,2,"じゆう"],[45,1,"もの"],[57,1,"た"]],"text":"アハブの全家は滅びるであろう。アハブに属する男は、イスラエルにいて、つながれた者も、自由な者も、ことごとくわたしは断ち、"},{"ref":"2Kgs.9.9","start":12009009,"end":12009009,"break":"none","ruby":[[4,1,"いえ"],[10,1,"こ"],[26,1,"こ"],[32,1,"いえ"]],"text":"アハブの家をネバテの子ヤラベアムのようにし、アヒヤの子バアシャの家のようにする。"},{"ref":"2Kgs.9.10","start":12009010,"end":12009010,"break":"none","ruby":[[0,1,"いぬ"],[7,2,"ちいき"],[15,1,"く"],[18,2,"かのじょ"],[21,1,"ほうむ"],[23,1,"もの"],[37,1,"かれ"],[39,1,"と"],[44,1,"に"],[46,1,"さ"]],"text":"犬がイズレルの地域でイゼベルを食い、彼女を葬る者はないであろう』」。そして彼は戸をあけて逃げ去った。"},{"ref":"2Kgs.9.11","start":12009011,"end":12009011,"break":"paragraph","ruby":[[7,2,"しゅくん"],[10,2,"けらい"],[15,1,"ところ"],[17,1,"で"],[19,1,"く"],[23,1,"かれ"],[30,1,"い"],[35,1,"かわ"],[38,1,"こと"],[49,2,"きちが"],[64,1,"ところ"],[78,1,"かれ"],[81,1,"い"],[95,1,"ひと"],[97,1,"し"],[108,1,"い"],[110,1,"こと"],[112,1,"し"]],"text":"やがてエヒウが主君の家来たちの所へ出て来ると、彼らはエヒウに言った、「変った事はありませんか。あの気違いは、なんのためにあなたの所にきたのですか」。エヒウは彼らに言った、「あなたがたは、あの人を知っています。またその言う事も知っています」。"},{"ref":"2Kgs.9.12","start":12009012,"end":12009012,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[11,1,"ちが"],[24,1,"はな"],[40,1,"い"],[45,1,"かれ"],[56,1,"つ"],[59,1,"い"],[66,1,"しゅ"],[70,1,"おお"],[84,1,"あぶら"],[86,1,"そそ"],[96,1,"おう"]],"text":"彼らは言った、「それは違います。どうぞわれわれに話してください」。そこでエヒウは言った、「彼はこうこう、わたしに告げて言いました、『主はこう仰せられる、わたしはあなたに油を注いで、イスラエルの王とする』」。"},{"ref":"2Kgs.9.13","start":12009013,"end":12009013,"break":"none","ruby":[[3,1,"かれ"],[6,1,"いそ"],[14,2,"いふく"],[23,2,"かいだん"],[26,1,"うえ"],[32,1,"した"],[34,1,"し"],[41,1,"ふ"],[49,1,"おう"],[55,1,"い"]],"text":"すると彼らは急いで、おのおの衣服をとり、それを階段の上のエヒウの下に敷き、ラッパを吹いて「エヒウは王である」と言った。"},{"ref":"2Kgs.9.14","start":12009014,"end":12009014,"break":"paragraph","ruby":[[8,1,"こ"],[18,1,"こ"],[48,1,"ひき"],[65,1,"おう"],[71,1,"ふせ"]],"text":"こうしてニムシの子であるヨシャパテの子エヒウはヨラムにそむいた。（ヨラムはイスラエルをことごとく率いて、ラモテ・ギレアデでスリヤの王ハザエルを防いだが、"},{"ref":"2Kgs.9.15","start":12009015,"end":12009015,"break":"none","ruby":[[3,1,"おう"],[9,1,"おう"],[15,1,"たたか"],[18,1,"とき"],[27,1,"お"],[32,1,"きず"],[45,1,"かえ"],[56,1,"い"],[72,2,"ほんしん"],[87,1,"まち"],[90,1,"しの"],[92,1,"で"],[103,1,"つ"]],"text":"ヨラム王はスリヤの王ハザエルと戦った時に、スリヤびとに負わされた傷をいやすため、エズレルに帰っていた。）エヒウは言った、「もしこれがあなたがたの本心であるならば、ひとりもこの町から忍び出て、これをエズレルに告げてはならない」。"},{"ref":"2Kgs.9.16","start":12009016,"end":12009016,"break":"none","ruby":[[7,1,"くるま"],[9,1,"の"],[17,1,"い"],[28,1,"ふ"],[44,1,"おう"],[54,2,"みま"],[60,1,"くだ"]],"text":"そしてエヒウは車に乗ってエズレルへ行った。ヨラムがそこに伏していたからである。またユダの王アハジヤはヨラムを見舞うために下っていた。"},{"ref":"2Kgs.9.17","start":12009017,"end":12009017,"break":"paragraph","ruby":[[16,2,"ものみ"],[19,1,"た"],[30,2,"ぐんしゅう"],[33,1,"く"],[37,1,"み"],[41,2,"ぐんしゅう"],[44,1,"み"],[49,1,"い"],[59,1,"い"],[68,1,"うま"],[70,1,"の"],[81,1,"あ"],[86,2,"へいあん"],[93,1,"い"]],"text":"さてエズレルのやぐらに、ひとりの物見が立っていたが、エヒウの群衆が来るのを見て、「群衆が見える」と言ったので、ヨラムは言った、「ひとりを馬に乗せてつかわし、それに会わせて『平安ですか』と言わせなさい」。"},{"ref":"2Kgs.9.18","start":12009018,"end":12009018,"break":"none","ruby":[[7,1,"うま"],[9,1,"の"],[12,1,"い"],[15,1,"かれ"],[17,1,"あ"],[20,1,"い"],[25,1,"おう"],[29,1,"おお"],[37,2,"へいあん"],[48,1,"い"],[57,2,"へいあん"],[63,2,"かんけい"],[88,2,"ものみ"],[93,1,"つ"],[96,1,"い"],[101,2,"ししゃ"],[104,1,"かれ"],[107,1,"ところ"],[109,1,"い"],[116,1,"かえ"]],"text":"そこでひとりが馬に乗って行き、彼に会って言った、「王はこう仰せられます、『平安ですか』」。エヒウ言った、「あなたは平安となんの関係がありますか。わたしのあとについてきなさい」。物見はまた告げて言った、「使者は彼らの所へ行きましたが、帰ってきません」。"},{"ref":"2Kgs.9.19","start":12009019,"end":12009019,"break":"none","ruby":[[3,1,"ふたた"],[5,1,"ひと"],[7,1,"うま"],[17,1,"かれ"],[20,1,"ところ"],[22,1,"い"],[25,1,"い"],[30,1,"おう"],[34,1,"おお"],[42,2,"へいあん"],[54,1,"こた"],[57,1,"い"],[66,2,"へいあん"],[72,2,"かんけい"]],"text":"そこで再び人を馬でつかわしたので、彼らの所へ行って言った、「王はこう仰せられます、『平安ですか』」。エヒウは答えて言った、「あなたは平安となんの関係がありますか。わたしのあとについてきなさい」。"},{"ref":"2Kgs.9.20","start":12009020,"end":12009020,"break":"none","ruby":[[0,2,"ものみ"],[5,1,"つ"],[8,1,"い"],[13,1,"かれ"],[16,1,"かれ"],[19,1,"ところ"],[21,1,"い"],[27,1,"かえ"],[37,1,"くるま"],[39,2,"そうじゅう"],[46,1,"こ"],[51,2,"そうじゅう"],[57,1,"に"],[60,2,"もうれつ"],[63,1,"いきお"],[66,2,"そうじゅう"],[70,1,"き"]],"text":"物見はまた告げて言った、「彼も、彼らの所へ行きましたが帰ってきません。あの車の操縦はニムシの子エヒウの操縦するのに似て、猛烈な勢いで操縦して来ます」。"},{"ref":"2Kgs.9.21","start":12009021,"end":12009021,"break":"paragraph","ruby":[[8,1,"くるま"],[10,2,"ようい"],[16,1,"い"],[22,1,"くるま"],[24,2,"ようい"],[36,1,"おう"],[45,1,"おう"],[58,1,"くるま"],[60,1,"で"],[62,1,"い"],[74,1,"あ"],[79,1,"で"],[95,2,"じしょ"],[98,1,"かれ"],[100,1,"あ"]],"text":"そこでヨラムが「車を用意せよ」と言ったので、車を用意すると、イスラエルの王ヨラムと、ユダの王アハジヤは、おのおのその車で出て行った。すなわちエヒウに会うために出ていって、エズレルびとナボテの地所で彼に会った。"},{"ref":"2Kgs.9.22","start":12009022,"end":12009022,"break":"none","ruby":[[8,1,"み"],[10,1,"い"],[20,2,"へいあん"],[31,1,"こた"],[40,1,"はは"],[46,2,"かんいん"],[49,2,"まじゅつ"],[58,1,"おお"],[67,2,"へいあん"]],"text":"ヨラムはエヒウを見て言った、「エヒウよ、平安ですか」。エヒウは答えた、「あなたの母イゼベルの姦淫と魔術とが、こんなに多いのに、どうして平安でありえましょうか」。"},{"ref":"2Kgs.9.23","start":12009023,"end":12009023,"break":"none","ruby":[[2,1,"とき"],[7,1,"くるま"],[14,1,"に"],[34,2,"はんぎゃく"],[40,1,"い"]],"text":"その時ヨラムは車をめぐらして逃げ、アハジヤにむかって、「アハジヤよ、反逆です」と言うと、"},{"ref":"2Kgs.9.24","start":12009024,"end":12009024,"break":"none","ruby":[[4,1,"て"],[6,1,"ゆみ"],[19,1,"りょう"],[20,1,"かた"],[22,1,"あいだ"],[24,1,"い"],[29,1,"や"],[31,1,"かれ"],[33,2,"しんぞう"],[36,1,"つらぬ"],[39,1,"かれ"],[41,1,"くるま"],[43,1,"なか"],[45,1,"たお"]],"text":"エヒウは手に弓をひきしぼって、ヨラムの両肩の間を射たので、矢は彼の心臓を貫き、彼は車の中に倒れた。"},{"ref":"2Kgs.9.25","start":12009025,"end":12009025,"break":"none","ruby":[[6,2,"ふくかん"],[13,1,"い"],[18,1,"かれ"],[20,1,"と"],[36,1,"はたけ"],[38,1,"な"],[40,1,"す"],[62,1,"とも"],[64,1,"の"],[68,1,"かれ"],[70,1,"ちち"],[75,1,"したが"],[81,1,"しゅ"],[83,1,"かれ"],[91,2,"よげん"],[100,2,"きおく"]],"text":"エヒウはその副官ビデカルに言った、「彼を取りあげて、エズレルびとナボテの畑に投げ捨てなさい。かつて、わたしとあなたと、ふたり共に乗って、彼の父アハブに従ったとき、主が彼について、この預言をされたことを記憶しなさい。"},{"ref":"2Kgs.9.26","start":12009026,"end":12009026,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"い"],[28,1,"ち"],[33,1,"こ"],[36,1,"ち"],[38,1,"み"],[44,1,"しゅ"],[46,1,"い"],[58,2,"じしょ"],[65,2,"ほうふく"],[76,1,"かれ"],[78,1,"と"],[86,2,"じしょ"],[89,1,"な"],[94,1,"しゅ"],[96,2,"ことば"]],"text":"すなわち主は言われた、『まことに、わたしはきのうナボテの血と、その子らの血を見た』。また主は言われた、『わたしはこの地所であなたに報復する』と。それゆえ彼を取りあげて、その地所に投げすて、主の言葉のようにしなさい」。"},{"ref":"2Kgs.9.27","start":12009027,"end":12009027,"break":"paragraph","ruby":[[3,1,"おう"],[12,1,"み"],[20,1,"ほう"],[22,1,"に"],[36,1,"お"],[40,1,"かれ"],[43,1,"う"],[47,1,"い"],[66,1,"さか"],[68,1,"くるま"],[70,1,"なか"],[72,1,"かれ"],[74,1,"う"],[78,1,"かれ"],[85,1,"に"],[95,1,"し"]],"text":"ユダの王アハジヤはこれを見てベテハガンの方へ逃げたが、エヒウはそのあとを追い、「彼をも撃て」と言ったので、イブレアムのほとりのグルの坂で車の中の彼を撃った。彼はメギドまで逃げていって、そこで死んだ。"},{"ref":"2Kgs.9.28","start":12009028,"end":12009028,"break":"none","ruby":[[2,2,"けらい"],[7,1,"かれ"],[9,1,"くるま"],[11,1,"の"],[20,1,"はこ"],[27,1,"まち"],[29,1,"かれ"],[31,1,"はか"],[35,2,"せんぞ"],[40,1,"とも"],[42,1,"ほうむ"]],"text":"その家来たちは彼を車に載せてエルサレムに運び、ダビデの町で彼の墓にその先祖たちと共に葬った。"},{"ref":"2Kgs.9.29","start":12009029,"end":12009029,"break":"paragraph","ruby":[[4,1,"こ"],[9,1,"だい"],[12,1,"ねん"],[22,1,"おう"]],"text":"アハブの子ヨラムの第十一年にアハジヤはユダの王となったのである。"},{"ref":"2Kgs.9.30","start":12009030,"end":12009030,"break":"paragraph","ruby":[[11,1,"とき"],[21,1,"き"],[27,1,"め"],[29,1,"ぬ"],[32,1,"かみ"],[34,1,"かざ"],[37,1,"まど"],[40,1,"のぞ"],[42,1,"み"]],"text":"エヒウがエズレルにきた時、イゼベルはそれを聞いて、その目を塗り、髪を飾って窓から望み見たが、"},{"ref":"2Kgs.9.31","start":12009031,"end":12009031,"break":"none","ruby":[[4,1,"もん"],[16,2,"しゅくん"],[19,1,"ころ"],[27,2,"ぶじ"],[34,1,"い"]],"text":"エヒウが門にはいってきたので、「主君を殺したジムリよ、無事ですか」と言った。"},{"ref":"2Kgs.9.32","start":12009032,"end":12009032,"break":"none","ruby":[[7,1,"かお"],[12,1,"まど"],[27,2,"みかた"],[31,1,"もの"],[45,1,"い"],[52,1,"にん"],[54,2,"かんがん"],[61,1,"のぞ"],[63,1,"み"]],"text":"するとエヒウは顔をあげて窓にむかい、「だれか、わたしに味方する者があるか。だれかあるか」と言うと、二、三人の宦官がエヒウを望み見たので、"},{"ref":"2Kgs.9.33","start":12009033,"end":12009033,"break":"none","ruby":[[5,2,"かのじょ"],[8,1,"な"],[10,1,"おと"],[14,1,"い"],[18,1,"かれ"],[21,2,"かのじょ"],[24,1,"な"],[26,1,"おと"],[34,1,"ち"],[36,1,"かべ"],[38,1,"うま"],[51,1,"うま"],[53,2,"かのじょ"],[56,1,"ふ"]],"text":"エヒウは「彼女を投げ落せ」と言った。彼らは彼女を投げ落したので、その血が壁と馬とにはねかかった。そして馬は彼女を踏みつけた。"},{"ref":"2Kgs.9.34","start":12009034,"end":12009034,"break":"none","ruby":[[4,1,"うち"],[10,1,"く"],[12,1,"の"],[19,1,"い"],[31,1,"おんな"],[33,1,"み"],[35,2,"かのじょ"],[38,1,"ほうむ"],[44,2,"かのじょ"],[47,1,"おう"],[49,1,"むすめ"]],"text":"エヒウは内にはいって食い飲みし、そして言った、「あののろわれた女を見、彼女を葬りなさい。彼女は王の娘なのだ」。"},{"ref":"2Kgs.9.35","start":12009035,"end":12009035,"break":"none","ruby":[[3,1,"かれ"],[6,2,"かのじょ"],[9,1,"ほうむ"],[15,1,"い"],[18,1,"み"],[22,3,"ずがいこつ"],[27,1,"あし"],[38,1,"なに"]],"text":"しかし彼らが彼女を葬ろうとして行って見ると、頭蓋骨と、足と、たなごころのほか何もなかったので、"},{"ref":"2Kgs.9.36","start":12009036,"end":12009036,"break":"none","ruby":[[0,1,"かえ"],[4,1,"かれ"],[6,1,"つ"],[11,1,"かれ"],[13,1,"い"],[21,1,"しゅ"],[43,1,"つ"],[49,2,"ことば"],[65,1,"ち"],[67,1,"いぬ"],[74,1,"にく"],[76,1,"く"]],"text":"帰って、彼に告げると、彼は言った、「これは主が、そのしもべ、テシベびとエリヤによってお告げになった言葉である。すなわち『エズレルの地で犬がイゼベルの肉を食うであろう。"},{"ref":"2Kgs.9.37","start":12009037,"end":12009037,"break":"none","ruby":[[5,2,"したい"],[13,1,"ち"],[16,2,"ふんど"],[22,1,"の"],[28,1,"す"],[48,1,"い"]],"text":"イゼベルの死体はエズレルの地で、糞土のように野のおもてに捨てられて、だれも、これはイゼベルだ、と言うことができないであろう』」。"}]