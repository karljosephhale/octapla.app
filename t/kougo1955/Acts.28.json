[{"ref":"Acts.28.1","start":44028001,"end":44028001,"break":"paragraph","ruby":[[11,1,"すく"],[30,1,"よ"],[34,1,"しま"]],"text":"わたしたちが、こうして救われてからわかったが、これはマルタと呼ばれる島であった。"},{"ref":"Acts.28.2","start":44028002,"end":44028002,"break":"none","ruby":[[0,2,"とち"],[3,2,"ひとびと"],[13,2,"なみなみ"],[18,2,"しんせつ"],[35,1,"ふ"],[40,1,"あめ"],[42,1,"さむ"],[52,1,"ひ"],[62,2,"いちどう"]],"text":"土地の人々は、わたしたちに並々ならぬ親切をあらわしてくれた。すなわち、降りしきる雨や寒さをしのぐために、火をたいてわたしたち一同をねぎらってくれたのである。"},{"ref":"Acts.28.3","start":44028003,"end":44028003,"break":"none","ruby":[[15,1,"しば"],[21,1,"ひ"],[30,2,"ねっき"],[40,1,"で"],[45,1,"かれ"],[47,1,"て"]],"text":"そのとき、パウロはひとかかえの柴をたばねて火にくべたところ、熱気のためにまむしが出てきて、彼の手にかみついた。"},{"ref":"Acts.28.4","start":44028004,"end":44028004,"break":"none","ruby":[[0,2,"とち"],[3,2,"ひとびと"],[9,1,"い"],[18,1,"て"],[23,1,"さ"],[31,1,"み"],[34,1,"たがい"],[36,1,"い"],[43,1,"ひと"],[49,2,"ひとごろ"],[53,1,"ちが"],[58,1,"うみ"],[73,2,"かみさま"],[76,1,"かれ"],[78,1,"い"]],"text":"土地の人々は、この生きものがパウロの手からぶら下がっているのを見て、互に言った、「この人は、きっと人殺しに違いない。海からはのがれたが、ディケーの神様が彼を生かしてはおかないのだ」。"},{"ref":"Acts.28.5","start":44028005,"end":44028005,"break":"none","ruby":[[13,1,"ひ"],[15,1,"なか"],[17,1,"ふ"],[19,1,"おと"],[26,1,"がい"],[28,1,"こうむ"]],"text":"ところがパウロは、まむしを火の中に振り落して、なんの害も被らなかった。"},{"ref":"Acts.28.6","start":44028006,"end":44028006,"break":"none","ruby":[[0,1,"かれ"],[4,1,"かれ"],[6,1,"ま"],[12,1,"あ"],[26,1,"たお"],[29,1,"し"],[36,2,"ようす"],[51,1,"なが"],[53,1,"あいだ"],[63,1,"かれ"],[65,1,"み"],[70,1,"かわ"],[76,1,"おこ"],[82,1,"み"],[85,1,"かれ"],[88,1,"かんが"],[91,1,"か"],[98,1,"ひと"],[100,2,"かみさま"],[105,1,"い"],[107,1,"だ"]],"text":"彼らは、彼が間もなくはれ上がるか、あるいは、たちまち倒れて死ぬだろうと、様子をうかがっていた。しかし、長い間うかがっていても、彼の身になんの変ったことも起らないのを見て、彼らは考えを変えて、「この人は神様だ」と言い出した。"},{"ref":"Acts.28.7","start":44028007,"end":44028007,"break":"paragraph","ruby":[[5,2,"ばしょ"],[8,1,"ちか"],[12,1,"しま"],[14,2,"しゅちょう"],[24,1,"ひと"],[26,2,"しょゆう"],[28,1,"ち"],[34,1,"かれ"],[46,2,"しょうたい"],[52,1,"か"],[57,2,"しんせつ"]],"text":"さて、その場所の近くに、島の首長、ポプリオという人の所有地があった。彼は、そこにわたしたちを招待して、三日のあいだ親切にもてなしてくれた。"},{"ref":"Acts.28.8","start":44028008,"end":44028008,"break":"none","ruby":[[10,1,"ちち"],[12,2,"せきり"],[20,2,"こうねつ"],[23,1,"とこ"],[41,1,"ひと"],[51,1,"い"],[54,1,"いの"],[57,1,"て"],[59,1,"かれ"],[61,1,"うえ"]],"text":"たまたま、ポプリオの父が赤痢をわずらい、高熱で床についていた。そこでパウロは、その人のところにはいって行って祈り、手を彼の上においていやしてやった。"},{"ref":"Acts.28.9","start":44028009,"end":44028009,"break":"none","ruby":[[14,2,"びょうき"],[21,1,"しま"],[23,1,"ひと"]],"text":"このことがあってから、ほかに病気をしている島の人たちが、ぞくぞくとやってきて、みないやされた。"},{"ref":"Acts.28.10","start":44028010,"end":44028010,"break":"none","ruby":[[0,1,"かれ"],[9,2,"ひじょう"],[12,2,"そんけい"],[16,2,"しゅっぱん"],[19,1,"とき"],[23,2,"ひつよう"],[26,2,"しなじな"],[29,1,"も"]],"text":"彼らはわたしたちを非常に尊敬し、出帆の時には、必要な品々を持ってきてくれた。"},{"ref":"Acts.28.11","start":44028011,"end":44028011,"break":"paragraph","ruby":[[2,1,"げつ"],[6,1,"のち"],[17,1,"しま"],[19,1,"ふゆ"],[34,1,"ふね"],[35,1,"かざ"],[49,1,"ふね"],[52,2,"しゅっぱん"]],"text":"三か月たった後、わたしたちは、この島に冬ごもりをしていたデオスクリの船飾りのあるアレキサンドリヤの舟で、出帆した。"},{"ref":"Acts.28.12","start":44028012,"end":44028012,"break":"none","ruby":[[9,2,"きこう"],[14,1,"か"],[19,2,"ていはく"]],"text":"そして、シラクサに寄港して三日のあいだ停泊し、"},{"ref":"Acts.28.13","start":44028013,"end":44028013,"break":"none","ruby":[[4,1,"すす"],[12,1,"い"],[21,1,"にち"],[26,2,"なんぷう"],[29,1,"ふ"],[36,1,"じょう"],[42,1,"め"],[49,1,"つ"]],"text":"そこから進んでレギオンに行った。それから一日おいて、南風が吹いてきたのに乗じ、ふつか目にポテオリに着いた。"},{"ref":"Acts.28.14","start":44028014,"end":44028014,"break":"none","ruby":[[3,2,"きょうだい"],[8,1,"あ"],[11,1,"すす"],[19,1,"かれ"],[26,3,"なぬかかん"],[30,2,"たいざい"],[53,2,"とうちゃく"]],"text":"そこで兄弟たちに会い、勧められるまま、彼らのところに七日間も滞在した。それからわたしたちは、ついにローマに到着した。"},{"ref":"Acts.28.15","start":44028015,"end":44028015,"break":"none","ruby":[[5,2,"きょうだい"],[20,1,"き"],[43,2,"でむか"],[55,1,"かれ"],[58,1,"あ"],[62,1,"かみ"],[64,2,"かんしゃ"],[67,1,"いさ"],[69,1,"た"]],"text":"ところが、兄弟たちは、わたしたちのことを聞いて、アピオ・ポロおよびトレス・タベルネまで出迎えてくれた。パウロは彼らに会って、神に感謝し勇み立った。"},{"ref":"Acts.28.16","start":44028016,"end":44028016,"break":"paragraph","ruby":[[10,1,"つ"],[13,1,"のち"],[24,2,"ばんぺい"],[36,1,"す"],[41,1,"ゆる"]],"text":"わたしたちがローマに着いた後、パウロは、ひとりの番兵をつけられ、ひとりで住むことを許された。"},{"ref":"Acts.28.17","start":44028017,"end":44028017,"break":"paragraph","ruby":[[1,1,"か"],[13,2,"おもだ"],[20,1,"じん"],[24,1,"まね"],[32,1,"もの"],[34,1,"あつ"],[41,1,"かれ"],[44,1,"い"],[49,2,"きょうだい"],[62,2,"こくみん"],[65,1,"たい"],[74,2,"せんぞ"],[76,2,"でんらい"],[79,2,"かんれい"],[82,1,"たい"],[87,2,"なにひと"],[93,2,"こうい"],[109,2,"しゅうじん"],[117,1,"じん"],[121,1,"て"],[123,1,"ひ"],[125,1,"わた"]],"text":"三日たってから、パウロは、重立ったユダヤ人たちを招いた。みんなの者が集まったとき、彼らに言った、「兄弟たちよ、わたしは、わが国民に対しても、あるいは先祖伝来の慣例に対しても、何一つそむく行為がなかったのに、エルサレムで囚人としてローマ人たちの手に引き渡された。"},{"ref":"Acts.28.18","start":44028018,"end":44028018,"break":"none","ruby":[[0,1,"かれ"],[7,1,"と"],[9,1,"しら"],[12,2,"けっか"],[18,1,"し"],[20,1,"あた"],[22,2,"ざいじょう"],[34,2,"しゃくほう"],[40,1,"おも"]],"text":"彼らはわたしを取り調べた結果、なんら死に当る罪状もないので、わたしを釈放しようと思ったのであるが、"},{"ref":"Acts.28.19","start":44028019,"end":44028019,"break":"none","ruby":[[3,1,"じん"],[10,2,"はんたい"],[24,1,"え"],[32,2,"じょうそ"],[37,1,"いた"],[55,2,"どうほう"],[58,1,"うった"]],"text":"ユダヤ人たちがこれに反対したため、わたしはやむを得ず、カイザルに上訴するに至ったのである。しかしわたしは、わが同胞を訴えようなどとしているのではない。"},{"ref":"Acts.28.20","start":44028020,"end":44028020,"break":"none","ruby":[[14,1,"あ"],[17,1,"かた"],[19,1,"あ"],[24,1,"ねが"],[30,2,"じじつ"],[50,2,"きぼう"],[59,1,"くさり"]],"text":"こういうわけで、あなたがたに会って語り合いたいと願っていた。事実、わたしは、イスラエルのいだいている希望のゆえに、この鎖につながれているのである」。"},{"ref":"Acts.28.21","start":44028021,"end":44028021,"break":"none","ruby":[[3,1,"かれ"],[11,1,"い"],[26,1,"じん"],[43,2,"ぶんしょ"],[46,1,"う"],[48,1,"と"],[59,2,"きょうだい"],[64,1,"なか"],[80,2,"ふり"],[83,2,"ほうこく"],[90,2,"あっこう"],[93,1,"い"],[99,1,"もの"]],"text":"そこで彼らは、パウロに言った、「わたしたちは、ユダヤ人たちから、あなたについて、なんの文書も受け取っていないし、また、兄弟たちの中からここにきて、あなたについて不利な報告をしたり、悪口を言ったりした者もなかった。"},{"ref":"Acts.28.22","start":44028022,"end":44028022,"break":"none","ruby":[[11,1,"かんが"],[20,2,"ちょくせつ"],[27,1,"き"],[32,1,"ただ"],[39,1,"おも"],[45,1,"じつ"],[50,2,"しゅうは"],[65,2,"はんたい"],[80,1,"みみ"]],"text":"わたしたちは、あなたの考えていることを、直接あなたから聞くのが、正しいことだと思っている。実は、この宗派については、いたるところで反対のあることが、わたしたちの耳にもはいっている」。"},{"ref":"Acts.28.23","start":44028023,"end":44028023,"break":"paragraph","ruby":[[4,1,"ひ"],[6,1,"さだ"],[10,1,"おお"],[14,1,"ひと"],[21,1,"やど"],[33,1,"あさ"],[36,1,"ばん"],[44,1,"かた"],[46,1,"つづ"],[49,1,"かみ"],[51,1,"くに"],[67,2,"りっぽう"],[70,3,"よげんしゃ"],[74,1,"しょ"],[76,1,"ひ"],[87,1,"かれ"],[90,2,"せっとく"]],"text":"そこで、日を定めて、大ぜいの人が、パウロの宿につめかけてきたので、朝から晩まで、パウロは語り続け、神の国のことをあかしし、またモーセの律法や預言者の書を引いて、イエスについて彼らの説得につとめた。"},{"ref":"Acts.28.24","start":44028024,"end":44028024,"break":"none","ruby":[[2,1,"もの"],[8,1,"い"],[13,1,"う"],[20,1,"もの"],[22,1,"しん"]],"text":"ある者はパウロの言うことを受けいれ、ある者は信じようともしなかった。"},{"ref":"Acts.28.25","start":44028025,"end":44028025,"break":"none","ruby":[[0,1,"たがい"],[2,2,"いけん"],[5,1,"あ"],[15,1,"もの"],[17,1,"かえ"],[25,1,"とき"],[35,1,"の"],[38,1,"い"],[43,2,"せいれい"],[49,3,"よげんしゃ"],[66,2,"せんぞ"],[69,1,"かた"]],"text":"互に意見が合わなくて、みんなの者が帰ろうとしていた時、パウロはひとこと述べて言った、「聖霊はよくも預言者イザヤによって、あなたがたの先祖に語ったものである。"},{"ref":"Acts.28.26","start":44028026,"end":44028026,"break":"stanza","breaks":[[11,"line"],[33,"line"]],"ruby":[[3,1,"たみ"],[5,1,"い"],[8,1,"い"],[17,1,"き"],[21,1,"き"],[25,1,"けっ"],[28,1,"さと"],[33,1,"み"],[37,1,"み"],[41,1,"けっ"],[44,1,"みと"]],"text":"『この民に行って言え、あなたがたは聞くには聞くが、決して悟らない。見るには見るが、決して認めない。"},{"ref":"Acts.28.27","start":44028027,"end":44028027,"break":"line","breaks":[[11,"line"],[21,"line"],[31,"line"],[43,"line"],[49,"line"],[60,"line"]],"ruby":[[2,1,"たみ"],[4,1,"こころ"],[6,1,"にぶ"],[13,1,"みみ"],[15,1,"きこ"],[23,1,"め"],[25,1,"と"],[35,1,"かれ"],[38,1,"め"],[40,1,"み"],[43,1,"みみ"],[45,1,"き"],[49,1,"こころ"],[51,1,"さと"],[55,1,"く"],[57,1,"あらた"]],"text":"この民の心は鈍くなり、その耳は聞えにくく、その目は閉じている。それは、彼らが目で見ず、耳で聞かず、心で悟らず、悔い改めていやされることがないためである』。"},{"ref":"Acts.28.28","start":44028028,"end":44028028,"break":"none","ruby":[[10,1,"し"],[19,1,"かみ"],[23,1,"すくい"],[25,2,"ことば"],[29,3,"いほうじん"],[33,1,"おく"],[40,1,"かれ"],[47,1,"き"]],"text":"そこで、あなたがたは知っておくがよい。神のこの救の言葉は、異邦人に送られたのだ。彼らは、これに聞きしたがうであろう」。〔"},{"ref":"Acts.28.29","start":44028029,"end":44028029,"break":"none","ruby":[[11,1,"の"],[13,1,"おわ"],[20,1,"じん"],[24,1,"たがい"],[26,1,"ろん"],[28,1,"あ"],[33,1,"かえ"],[36,1,"い"]],"text":"パウロがこれらのことを述べ終ると、ユダヤ人らは、互に論じ合いながら帰って行った。〕"},{"ref":"Acts.28.30","start":44028030,"end":44028030,"break":"paragraph","ruby":[[5,2,"じぶん"],[8,1,"か"],[11,1,"いえ"],[13,1,"まん"],[15,1,"ねん"],[20,1,"す"],[28,1,"く"],[30,2,"ひとびと"],[35,1,"むか"],[37,1,"い"]],"text":"パウロは、自分の借りた家に満二年のあいだ住んで、たずねて来る人々をみな迎え入れ、"},{"ref":"Acts.28.31","start":44028031,"end":44028031,"break":"none","ruby":[[8,1,"さまた"],[19,1,"かみ"],[21,1,"くに"],[23,1,"の"],[25,1,"つた"],[28,1,"しゅ"],[41,1,"おし"]],"text":"はばからず、また妨げられることもなく、神の国を宣べ伝え、主イエス・キリストのことを教えつづけた。"}]