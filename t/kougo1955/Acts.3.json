[{"ref":"Acts.3.1","start":44003001,"end":44003001,"break":"paragraph","ruby":[[13,2,"ごご"],[16,1,"じ"],[18,1,"いのり"],[23,1,"みや"],[25,1,"のぼ"]],"text":"さて、ペテロとヨハネとが、午後三時の祈のときに宮に上ろうとしていると、"},{"ref":"Acts.3.2","start":44003002,"end":44003002,"break":"none","ruby":[[0,1,"うま"],[5,1,"あし"],[11,1,"おとこ"],[25,1,"おとこ"],[28,1,"みや"],[33,1,"く"],[35,2,"ひとびと"],[38,1,"ほどこ"],[46,2,"まいにち"],[50,1,"うつく"],[53,1,"もん"],[56,1,"よ"],[60,1,"みや"],[62,1,"もん"],[69,1,"お"],[75,1,"もの"]],"text":"生れながら足のきかない男が、かかえられてきた。この男は、宮もうでに来る人々に施しをこうため、毎日、「美しの門」と呼ばれる宮の門のところに、置かれていた者である。"},{"ref":"Acts.3.3","start":44003003,"end":44003003,"break":"none","ruby":[[0,1,"かれ"],[13,1,"みや"],[19,1,"い"],[29,1,"み"],[32,1,"ほどこ"]],"text":"彼は、ペテロとヨハネとが、宮にはいって行こうとしているのを見て、施しをこうた。"},{"ref":"Acts.3.4","start":44003004,"end":44003004,"break":"none","ruby":[[9,1,"かれ"],[14,1,"み"],[24,1,"み"],[30,1,"い"]],"text":"ペテロとヨハネとは彼をじっと見て、「わたしたちを見なさい」と言った。"},{"ref":"Acts.3.5","start":44003005,"end":44003005,"break":"none","ruby":[[0,1,"かれ"],[2,1,"なに"],[13,2,"きたい"],[22,2,"ちゅうもく"]],"text":"彼は何かもらえるのだろうと期待して、ふたりに注目していると、"},{"ref":"Acts.3.6","start":44003006,"end":44003006,"break":"none","ruby":[[4,1,"い"],[9,2,"きんぎん"],[17,1,"な"],[41,1,"びと"],[51,1,"な"],[56,1,"ある"]],"text":"ペテロが言った、「金銀はわたしには無い。しかし、わたしにあるものをあげよう。ナザレ人イエス・キリストの名によって歩きなさい」。"},{"ref":"Acts.3.7","start":44003007,"end":44003007,"break":"none","ruby":[[2,1,"い"],[5,1,"かれ"],[7,2,"みぎて"],[10,1,"と"],[13,1,"おこ"],[20,1,"あし"],[30,1,"た"],[36,1,"つよ"]],"text":"こう言って彼の右手を取って起してやると、足と、くるぶしとが、立ちどころに強くなって、"},{"ref":"Acts.3.8","start":44003008,"end":44003008,"break":"none","ruby":[[0,1,"おど"],[6,1,"た"],[9,1,"ある"],[11,1,"だ"],[19,1,"ある"],[21,1,"まわ"],[25,1,"おど"],[31,1,"かみ"],[41,1,"かれ"],[44,1,"とも"],[46,1,"みや"],[52,1,"い"]],"text":"踊りあがって立ち、歩き出した。そして、歩き回ったり踊ったりして神をさんびしながら、彼らと共に宮にはいって行った。"},{"ref":"Acts.3.9","start":44003009,"end":44003009,"break":"none","ruby":[[0,2,"みんしゅう"],[6,1,"かれ"],[8,1,"ある"],[10,1,"まわ"],[15,1,"かみ"],[26,1,"み"]],"text":"民衆はみな、彼が歩き回り、また神をさんびしているのを見、"},{"ref":"Acts.3.10","start":44003010,"end":44003010,"break":"none","ruby":[[3,1,"みや"],[6,1,"うつく"],[9,1,"もん"],[20,1,"ほどこ"],[28,1,"もの"],[33,1,"し"],[36,1,"かれ"],[38,1,"み"],[40,1,"おこ"],[50,1,"おどろ"],[52,1,"あや"]],"text":"これが宮の「美しの門」のそばにすわって、施しをこうていた者であると知り、彼の身に起ったことについて、驚き怪しんだ。"},{"ref":"Acts.3.11","start":44003011,"end":44003011,"break":"paragraph","ruby":[[0,1,"かれ"],[25,2,"ひとびと"],[28,1,"みな"],[32,1,"おどろ"],[42,1,"ろう"],[45,1,"よ"],[49,2,"ちゅうろう"],[54,1,"かれ"],[61,1,"か"],[63,1,"あつ"]],"text":"彼がなおもペテロとヨハネとにつきまとっているとき、人々は皆ひどく驚いて、「ソロモンの廊」と呼ばれる柱廊にいた彼らのところに駆け集まってきた。"},{"ref":"Acts.3.12","start":44003012,"end":44003012,"break":"none","ruby":[[7,1,"み"],[10,2,"ひとびと"],[17,1,"い"],[28,1,"ひと"],[37,1,"こと"],[39,3,"ふしぎ"],[43,1,"おも"],[57,2,"じぶん"],[60,1,"ちから"],[62,2,"しんじん"],[68,1,"ひと"],[70,1,"ある"],[88,1,"み"]],"text":"ペテロはこれを見て、人々にむかって言った、「イスラエルの人たちよ、なぜこの事を不思議に思うのか。また、わたしたちが自分の力や信心で、あの人を歩かせたかのように、なぜわたしたちを見つめているのか。"},{"ref":"Acts.3.13","start":44003013,"end":44003013,"break":"none","ruby":[[14,1,"かみ"],[22,2,"せんぞ"],[25,1,"かみ"],[30,1,"しもべ"],[35,2,"えいこう"],[38,1,"たま"],[61,1,"ひ"],[63,1,"わた"],[76,1,"き"],[87,1,"かれ"],[89,2,"めんぜん"],[92,1,"こば"]],"text":"アブラハム、イサク、ヤコブの神、わたしたちの先祖の神は、その僕イエスに栄光を賜わったのであるが、あなたがたは、このイエスを引き渡し、ピラトがゆるすことに決めていたのに、それを彼の面前で拒んだ。"},{"ref":"Acts.3.14","start":44003014,"end":44003014,"break":"none","ruby":[[9,1,"せい"],[12,1,"ただ"],[18,1,"こば"],[22,2,"ひとごろ"],[26,1,"おとこ"],[34,2,"ようきゅう"]],"text":"あなたがたは、この聖なる正しいかたを拒んで、人殺しの男をゆるすように要求し、"},{"ref":"Acts.3.15","start":44003015,"end":44003015,"break":"none","ruby":[[4,1,"きみ"],[6,1,"ころ"],[18,1,"かみ"],[26,2,"しにん"],[29,1,"なか"],[50,1,"こと"],[52,2,"しょうにん"]],"text":"いのちの君を殺してしまった。しかし、神はこのイエスを死人の中から、よみがえらせた。わたしたちは、その事の証人である。"},{"ref":"Acts.3.16","start":44003016,"end":44003016,"break":"none","ruby":[[8,1,"な"],[14,1,"しん"],[17,2,"しんこう"],[32,1,"み"],[34,1,"し"],[41,1,"ひと"],[44,1,"つよ"],[59,2,"しんこう"],[63,1,"かれ"],[70,2,"いちどう"],[73,1,"まえ"],[81,2,"かんぜん"]],"text":"そして、イエスの名が、それを信じる信仰のゆえに、あなたがたのいま見て知っているこの人を、強くしたのであり、イエスによる信仰が、彼をあなたがた一同の前で、このとおり完全にいやしたのである。"},{"ref":"Acts.3.17","start":44003017,"end":44003017,"break":"paragraph","ruby":[[3,2,"きょうだい"],[15,1,"し"],[24,1,"こと"],[39,3,"しどうしゃ"],[47,2,"どうよう"]],"text":"さて、兄弟たちよ、あなたがたは知らずにあのような事をしたのであり、あなたがたの指導者たちとても同様であったことは、わたしにわかっている。"},{"ref":"Acts.3.18","start":44003018,"end":44003018,"break":"none","ruby":[[0,1,"かみ"],[6,3,"よげんしゃ"],[10,1,"くち"],[22,2,"じゅなん"],[25,2,"よこく"],[43,2,"じょうじゅ"]],"text":"神はあらゆる預言者の口をとおして、キリストの受難を予告しておられたが、それをこのように成就なさったのである。"},{"ref":"Acts.3.19","start":44003019,"end":44003019,"break":"none","ruby":[[4,2,"じぶん"],[7,1,"つみ"],[12,1,"さ"],[23,1,"く"],[25,1,"あらた"],[28,2,"ほんしん"],[31,1,"た"]],"text":"だから、自分の罪をぬぐい去っていただくために、悔い改めて本心に立ちかえりなさい。"},{"ref":"Acts.3.20","start":44003020,"end":44003020,"break":"none","ruby":[[4,1,"しゅ"],[7,1,"まえ"],[10,1,"なぐさ"],[13,1,"とき"],[32,1,"さだ"],[49,1,"かみ"],[56,1,"くだ"]],"text":"それは、主のみ前から慰めの時がきて、あなたがたのためにあらかじめ定めてあったキリストなるイエスを、神がつかわして下さるためである。"},{"ref":"Acts.3.21","start":44003021,"end":44003021,"break":"none","ruby":[[7,1,"かみ"],[9,1,"せい"],[12,3,"よげんしゃ"],[18,1,"くち"],[25,1,"むかし"],[28,2,"よげん"],[36,2,"ばんぶつ"],[38,2,"こうしん"],[41,1,"とき"],[45,1,"てん"]],"text":"このイエスは、神が聖なる預言者たちの口をとおして、昔から預言しておられた万物更新の時まで、天にとどめておかれねばならなかった。"},{"ref":"Acts.3.22","start":44003022,"end":44003022,"break":"none","ruby":[[4,1,"い"],[9,1,"しゅ"],[12,1,"かみ"],[20,1,"た"],[36,2,"きょうだい"],[39,1,"なか"],[47,3,"よげんしゃ"],[52,1,"た"],[64,3,"よげんしゃ"],[74,1,"かた"],[86,1,"き"]],"text":"モーセは言った、『主なる神は、わたしをお立てになったように、あなたがたの兄弟の中から、ひとりの預言者をお立てになるであろう。その預言者があなたがたに語ることには、ことごとく聞きしたがいなさい。"},{"ref":"Acts.3.23","start":44003023,"end":44003023,"break":"none","ruby":[[0,1,"かれ"],[2,1,"き"],[10,1,"もの"],[15,1,"たみ"],[17,1,"なか"],[20,1,"ほろ"],[23,1,"さ"]],"text":"彼に聞きしたがわない者は、みな民の中から滅ぼし去られるであろう』。"},{"ref":"Acts.3.24","start":44003024,"end":44003024,"break":"none","ruby":[[11,1,"のち"],[16,1,"かた"],[22,3,"よげんしゃ"],[31,1,"とき"],[36,2,"よこく"]],"text":"サムエルをはじめ、その後つづいて語ったほどの預言者はみな、この時のことを予告した。"},{"ref":"Acts.3.25","start":44003025,"end":44003025,"break":"none","ruby":[[6,3,"よげんしゃ"],[10,1,"こ"],[15,1,"かみ"],[23,2,"せんぞ"],[28,1,"むす"],[32,2,"けいやく"],[35,1,"こ"],[40,1,"かみ"],[48,1,"たい"],[53,2,"ちじょう"],[56,1,"しょ"],[57,2,"みんぞく"],[65,2,"しそん"],[71,2,"しゅくふく"],[74,1,"う"],[83,1,"おお"]],"text":"あなたがたは預言者の子であり、神があなたがたの先祖たちと結ばれた契約の子である。神はアブラハムに対して、『地上の諸民族は、あなたの子孫によって祝福を受けるであろう』と仰せられた。"},{"ref":"Acts.3.26","start":44003026,"end":44003026,"break":"none","ruby":[[0,1,"かみ"],[16,1,"しもべ"],[18,1,"た"],[47,1,"あく"],[50,1,"た"],[58,2,"しゅくふく"]],"text":"神がまずあなたがたのために、その僕を立てて、おつかわしになったのは、あなたがたひとりびとりを、悪から立ちかえらせて、祝福にあずからせるためなのである」。"}]