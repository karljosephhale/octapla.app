[{"ref":"Zeph.1.1","start":36001001,"end":36001001,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"こ"],[13,1,"よ"],[21,1,"のぞ"],[24,1,"しゅ"],[26,2,"ことば"],[37,1,"こ"],[47,1,"こ"],[59,1,"こ"],[71,1,"こ"]],"text":"ユダの王アモンの子ヨシヤの世に、ゼパニヤに臨んだ主の言葉。ゼパニヤはクシの子、クシはゲダリヤの子、ゲダリヤはアマリヤの子、アマリヤはヒゼキヤの子である。"},{"ref":"Zeph.1.2","start":36001002,"end":36001002,"break":"stanza","breaks":[[7,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"ち"],[26,2,"いっそう"]],"text":"主は言われる、「わたしは地のおもてからすべてのものを一掃する」。"},{"ref":"Zeph.1.3","start":36001003,"end":36001003,"break":"line","breaks":[[7,"line"],[20,"line"],[34,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"ひと"],[14,1,"けもの"],[16,2,"いっそう"],[20,1,"そら"],[22,1,"とり"],[24,1,"うみ"],[26,1,"うお"],[29,2,"いっそう"],[38,2,"あくにん"],[41,1,"たお"],[48,1,"ち"],[55,1,"ひと"],[57,1,"た"],[59,1,"ほろ"]],"text":"主は言われる、「わたしは人も獣も一掃し、空の鳥、海の魚をも一掃する。わたしは悪人を倒す。わたしは地のおもてから人を絶ち滅ぼす」。"},{"ref":"Zeph.1.4","start":36001004,"end":36001004,"break":"line","breaks":[[14,"line"],[30,"line"],[47,"line"]],"ruby":[[18,2,"じゅうみん"],[22,1,"うえ"],[24,1,"て"],[26,1,"の"],[36,1,"ところ"],[43,2,"ざんとう"],[47,2,"ぐうぞう"],[50,2,"さいし"],[53,1,"な"],[56,1,"た"]],"text":"「わたしはユダとエルサレムのすべての住民との上に手を伸べる。わたしはこの所からバアルの残党と、偶像の祭司の名とを断つ。"},{"ref":"Zeph.1.5","start":36001005,"end":36001005,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[2,2,"おくじょう"],[5,1,"てん"],[7,2,"ばんしょう"],[10,1,"おが"],[12,1,"もの"],[14,1,"しゅ"],[16,1,"ちか"],[19,1,"た"],[22,1,"おが"],[38,1,"ちか"],[40,1,"もの"]],"text":"また屋上で天の万象を拝む者、主に誓いを立てて拝みながら、またミルコムをさして誓う者、"},{"ref":"Zeph.1.6","start":36001006,"end":36001006,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"したが"],[10,1,"もの"],[12,1,"しゅ"],[14,1,"もと"],[18,1,"しゅ"],[20,1,"たず"],[24,1,"もの"],[26,1,"た"]],"text":"主にそむいて従わない者、主を求めず、主を尋ねない者を断つ」。"},{"ref":"Zeph.1.7","start":36001007,"end":36001007,"break":"stanza","breaks":[[12,"line"],[20,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"まえ"],[7,2,"ちんもく"],[12,1,"しゅ"],[14,1,"ひ"],[16,1,"ちか"],[20,1,"しゅ"],[25,2,"ぎせい"],[28,1,"そな"],[33,1,"まね"],[36,1,"もの"],[38,2,"せいべつ"]],"text":"主なる神の前に沈黙せよ。主の日は近づき、主はすでに犠牲を備え、その招いた者を聖別されたからである。"},{"ref":"Zeph.1.8","start":36001008,"end":36001008,"break":"line","breaks":[[12,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"ぎせい"],[9,1,"ひ"],[23,1,"おう"],[25,1,"こ"],[35,2,"いほう"],[38,2,"いふく"],[41,1,"き"],[43,1,"もの"],[45,1,"ばっ"]],"text":"主の犠牲をささげる日に、「わたしはつかさたちと王の子たち、およびすべて異邦の衣服を着る者を罰する。"},{"ref":"Zeph.1.9","start":36001009,"end":36001009,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"ひ"],[14,2,"しきい"],[19,1,"こ"],[22,2,"ぼうぎゃく"],[25,1,"あざむ"],[29,2,"じぶん"],[32,2,"しゅくん"],[35,1,"いえ"],[37,1,"み"],[40,1,"もの"],[42,1,"ばっ"]],"text":"その日にわたしはまた、すべて敷居をとび越え、暴虐と欺きとを自分の主君の家に満たす者を罰する」。"},{"ref":"Zeph.1.10","start":36001010,"end":36001010,"break":"stanza","breaks":[[7,"line"],[26,"line"],[41,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[10,1,"ひ"],[13,1,"うお"],[15,1,"もん"],[18,1,"さけ"],[20,1,"ごえ"],[26,1,"だい"],[29,1,"まち"],[35,1,"ごえ"],[46,1,"おか"],[54,1,"ひび"]],"text":"主は言われる、「その日には魚の門から叫び声がおこり、第二の町からうめき声がおこり、もろもろの丘からすさまじい響きがおこる。"},{"ref":"Zeph.1.11","start":36001011,"end":36001011,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[5,1,"いえ"],[7,2,"じゅうみん"],[11,1,"な"],[13,1,"さけ"],[22,1,"たみ"],[24,1,"みな"],[25,1,"ほろ"],[30,1,"ぎん"],[32,1,"はか"],[34,1,"もの"],[36,1,"みな"],[37,1,"た"]],"text":"しっくいの家の住民よ、泣き叫べ。あきないする民は皆滅ぼされ、銀を量る者は皆断たれるからである。"},{"ref":"Zeph.1.12","start":36001012,"end":36001012,"break":"line","breaks":[[17,"line"],[27,"line"],[40,"line"],[46,"line"],[65,"line"]],"ruby":[[2,1,"とき"],[23,1,"たず"],[30,1,"おり"],[32,1,"うえ"],[34,1,"こ"],[36,1,"かた"],[42,1,"こころ"],[44,1,"なか"],[47,1,"しゅ"],[49,1,"よ"],[55,1,"わる"],[65,1,"い"],[67,2,"ひとびと"],[74,1,"ばっ"]],"text":"その時、わたしはともしびをもって、エルサレムを尋ねる。そして滓の上に凝り固まり、その心の中で『主は良いことも、悪いこともしない』と言う人々をわたしは罰する。"},{"ref":"Zeph.1.13","start":36001013,"end":36001013,"break":"line","breaks":[[12,"line"],[23,"line"],[46,"line"]],"ruby":[[0,1,"かれ"],[3,2,"ざいほう"],[12,1,"かれ"],[15,1,"いえ"],[17,1,"あ"],[23,1,"かれ"],[26,1,"いえ"],[28,1,"た"],[36,1,"す"],[49,1,"はたけ"],[51,1,"つく"],[61,1,"しゅ"],[63,1,"の"]],"text":"彼らの財宝はかすめられ、彼らの家は荒れはてる。彼らは家を建てても、それに住むことができない、ぶどう畑を作っても、そのぶどう酒を飲むことができない」。"},{"ref":"Zeph.1.14","start":36001014,"end":36001014,"break":"stanza","breaks":[[11,"line"],[24,"line"],[36,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おお"],[6,1,"ひ"],[8,1,"ちか"],[11,1,"ちか"],[21,1,"く"],[24,1,"しゅ"],[26,1,"ひ"],[28,1,"こえ"],[30,1,"みみ"],[40,2,"ゆうし"],[46,1,"さけ"]],"text":"主の大いなる日は近い、近づいて、すみやかに来る。主の日の声は耳にいたい。そこに、勇士もいたく叫ぶ。"},{"ref":"Zeph.1.15","start":36001015,"end":36001015,"break":"line","breaks":[[9,"line"],[19,"line"],[29,"line"],[37,"line"]],"ruby":[[2,1,"ひ"],[4,1,"いか"],[7,1,"ひ"],[13,1,"くる"],[17,1,"ひ"],[19,1,"あ"],[24,1,"ほろ"],[27,1,"ひ"],[29,1,"くら"],[32,2,"うすぐら"],[35,1,"ひ"],[37,1,"くも"],[39,2,"くろくも"],[42,1,"ひ"]],"text":"その日は怒りの日、なやみと苦しみの日、荒れ、また滅びる日、暗く、薄暗い日、雲と黒雲の日、"},{"ref":"Zeph.1.16","start":36001016,"end":36001016,"break":"line","breaks":[[11,"line"]],"ruby":[[7,1,"こえ"],[9,1,"ひ"],[11,2,"けんご"],[14,1,"まち"],[16,1,"たか"],[22,1,"せ"],[25,1,"ひ"]],"text":"ラッパとときの声の日、堅固な町と高いやぐらを攻める日である。"},{"ref":"Zeph.1.17","start":36001017,"end":36001017,"break":"line","breaks":[[15,"line"],[26,"line"],[45,"line"],[60,"line"]],"ruby":[[4,2,"ひとびと"],[11,1,"くだ"],[15,2,"もうじん"],[21,1,"ある"],[26,1,"かれ"],[29,1,"しゅ"],[31,1,"たい"],[34,1,"つみ"],[36,1,"おか"],[45,1,"かれ"],[48,1,"ち"],[56,1,"なが"],[60,1,"かれ"],[63,1,"にく"],[65,2,"ふんど"],[71,1,"す"]],"text":"わたしは人々になやみを下して、盲人のように歩かせる。彼らが主に対して罪を犯したからである。彼らの血はちりのように流され、彼らの肉は糞土のように捨てられる。"},{"ref":"Zeph.1.18","start":36001018,"end":36001018,"break":"line","breaks":[[8,"line"],[29,"line"],[45,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ぎん"],[5,1,"きん"],[8,1,"しゅ"],[10,1,"いか"],[13,1,"ひ"],[16,1,"かれ"],[19,1,"すく"],[29,1,"ぜん"],[30,1,"ち"],[32,1,"しゅ"],[38,1,"ひ"],[45,1,"しゅ"],[47,1,"ち"],[49,1,"す"],[51,2,"ひとびと"],[58,1,"ほろ"],[61,1,"つく"]],"text":"彼らの銀も金も、主の怒りの日には彼らを救うことができない。全地は主のねたみの火にのまれる。主は地に住む人々をたちまち滅ぼし尽される。"}]