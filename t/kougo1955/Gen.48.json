[{"ref":"Gen.48.1","start":1048001,"end":1048001,"break":"paragraph","ruby":[[4,1,"こと"],[6,1,"のち"],[14,1,"ちち"],[19,2,"びょうき"],[29,1,"つ"],[32,1,"もの"],[40,1,"かれ"],[46,1,"こ"],[59,1,"つ"],[62,1,"い"]],"text":"これらの事の後に、「あなたの父は、いま病気です」とヨセフに告げる者があったので、彼はふたりの子、マナセとエフライムとを連れて行った。"},{"ref":"Gen.48.2","start":1048002,"end":1048002,"break":"none","ruby":[[0,1,"とき"],[2,1,"ひと"],[8,1,"つ"],[17,1,"こ"],[35,1,"い"],[47,1,"つと"],[50,1,"ゆか"],[52,1,"うえ"]],"text":"時に人がヤコブに告げて、「あなたの子ヨセフがあなたのもとにきました」と言ったので、イスラエルは努めて床の上にすわった。"},{"ref":"Gen.48.3","start":1048003,"end":1048003,"break":"none","ruby":[[11,1,"い"],[16,1,"さき"],[18,2,"ぜんのう"],[21,1,"かみ"],[27,1,"ち"],[35,1,"あらわ"],[42,2,"しゅくふく"]],"text":"そしてヤコブはヨセフに言った、「先に全能の神がカナンの地ルズでわたしに現れ、わたしを祝福して、"},{"ref":"Gen.48.4","start":1048004,"end":1048004,"break":"none","ruby":[[0,1,"い"],[14,1,"おお"],[17,1,"こ"],[19,1,"え"],[35,1,"おお"],[38,2,"こくみん"],[50,1,"ち"],[56,1,"のち"],[58,2,"しそん"],[61,1,"あた"],[64,2,"えいきゅう"],[67,2,"しょゆう"]],"text":"言われた、『わたしはおまえに多くの子を得させ、おまえをふやし、おまえを多くの国民としよう。また、この地をおまえの後の子孫に与えて永久の所有とさせる』。"},{"ref":"Gen.48.5","start":1048005,"end":1048005,"break":"none","ruby":[[11,1,"ところ"],[17,1,"く"],[19,1,"まえ"],[27,1,"くに"],[29,1,"うま"],[40,1,"こ"],[48,1,"こ"],[78,1,"おな"],[87,1,"こ"]],"text":"エジプトにいるあなたの所にわたしが来る前に、エジプトの国で生れたあなたのふたりの子はいまわたしの子とします。すなわちエフライムとマナセとはルベンとシメオンと同じようにわたしの子とします。"},{"ref":"Gen.48.6","start":1048006,"end":1048006,"break":"none","ruby":[[3,1,"かれ"],[6,1,"のち"],[12,1,"うま"],[15,1,"こ"],[36,1,"し"],[37,1,"ぎょう"],[41,2,"きょうだい"],[44,1,"な"],[46,1,"よ"]],"text":"ただし彼らの後にあなたに生れた子らはあなたのものとなります。しかし、その嗣業はその兄弟の名で呼ばれるでしょう。"},{"ref":"Gen.48.7","start":1048007,"end":1048007,"break":"none","ruby":[[9,1,"かえ"],[12,1,"く"],[14,2,"とちゅう"],[24,1,"ち"],[26,1,"し"],[33,1,"かな"],[46,1,"い"],[55,1,"へだ"],[82,1,"い"],[84,1,"みち"],[91,2,"かのじょ"],[94,1,"ほうむ"]],"text":"わたしがパダンから帰って来る途中ラケルはカナンの地で死に、わたしは悲しんだ。そこはエフラタに行くまでには、なお隔たりがあった。わたしはエフラタ、すなわちベツレヘムへ行く道のかたわらに彼女を葬った」。"},{"ref":"Gen.48.8","start":1048008,"end":1048008,"break":"paragraph","ruby":[[15,1,"こ"],[18,1,"み"],[20,1,"い"]],"text":"ところで、イスラエルはヨセフの子らを見て言った、「これはだれですか」。"},{"ref":"Gen.48.9","start":1048009,"end":1048009,"break":"none","ruby":[[4,1,"ちち"],[6,1,"い"],[11,1,"かみ"],[25,1,"こ"],[32,1,"ちち"],[34,1,"い"],[39,1,"かれ"],[46,1,"ところ"],[48,1,"つ"],[58,2,"しゅくふく"]],"text":"ヨセフは父に言った、「神がここでわたしにくださった子どもです」。父は言った、「彼らをわたしの所に連れてきて、わたしに祝福させてください」。"},{"ref":"Gen.48.10","start":1048010,"end":1048010,"break":"none","ruby":[[6,1,"め"],[8,2,"ろうれい"],[19,1,"み"],[31,1,"かれ"],[34,1,"ちち"],[36,1,"ところ"],[38,2,"ちかよ"],[46,1,"ちち"],[48,1,"かれ"],[51,1,"くち"],[56,1,"かれ"],[59,1,"だ"]],"text":"イスラエルの目は老齢のゆえに、かすんで見えなかったが、ヨセフが彼らを父の所に近寄らせたので、父は彼らに口づけし、彼らを抱いた。"},{"ref":"Gen.48.11","start":1048011,"end":1048011,"break":"none","ruby":[[13,1,"い"],[22,1,"かお"],[24,1,"み"],[31,1,"おも"],[40,1,"かみ"],[46,1,"こ"],[54,1,"み"]],"text":"そしてイスラエルはヨセフに言った、「あなたの顔が見られようとは思わなかったのに、神はあなたの子らをもわたしに見させてくださった」。"},{"ref":"Gen.48.12","start":1048012,"end":1048012,"break":"none","ruby":[[7,1,"かれ"],[17,1,"あいだ"],[20,1,"と"],[22,1,"だ"],[25,1,"ち"],[27,1,"ふ"],[30,1,"はい"]],"text":"そこでヨセフは彼らをヤコブのひざの間から取り出し、地に伏して拝した。"},{"ref":"Gen.48.13","start":1048013,"end":1048013,"break":"none","ruby":[[10,1,"みぎ"],[12,1,"て"],[14,1,"と"],[23,1,"ひだり"],[25,1,"て"],[27,1,"む"],[36,1,"ひだり"],[38,1,"て"],[40,1,"と"],[49,1,"みぎ"],[51,1,"て"],[53,1,"む"],[62,2,"ちかよ"]],"text":"ヨセフはエフライムを右の手に取ってイスラエルの左の手に向かわせ、マナセを左の手に取ってイスラエルの右の手に向かわせ、ふたりを近寄らせた。"},{"ref":"Gen.48.14","start":1048014,"end":1048014,"break":"none","ruby":[[10,1,"みぎ"],[12,1,"て"],[14,1,"の"],[17,1,"おとうと"],[24,1,"あたま"],[26,1,"お"],[29,1,"ひだり"],[31,1,"て"],[37,1,"あたま"],[39,1,"お"],[47,2,"ちょうし"],[63,1,"て"],[65,1,"お"]],"text":"すると、イスラエルは右の手を伸べて弟エフライムの頭に置き、左の手をマナセの頭に置いた。マナセは長子であるが、ことさらそのように手を置いたのである。"},{"ref":"Gen.48.15","start":1048015,"end":1048015,"break":"none","breaks":[[15,"stanza"],[35,"line"]],"ruby":[[7,2,"しゅくふく"],[11,1,"い"],[18,2,"せんぞ"],[30,1,"つか"],[33,1,"かみ"],[35,1,"うま"],[49,1,"やしな"],[53,1,"かみ"]],"text":"そしてヨセフを祝福して言った、「わが先祖アブラハムとイサクの仕えた神、生れてからきょうまでわたしを養われた神、"},{"ref":"Gen.48.16","start":1048016,"end":1048016,"break":"line","breaks":[[21,"line"],[37,"line"],[59,"line"],[75,"line"]],"ruby":[[4,1,"わざわい"],[18,1,"つかい"],[23,2,"こども"],[28,2,"しゅくふく"],[41,1,"な"],[43,2,"せんぞ"],[55,1,"な"],[59,1,"かれ"],[65,1,"とな"],[77,1,"かれ"],[80,1,"ち"],[82,1,"うえ"]],"text":"すべての災からわたしをあがなわれたみ使よ、この子供たちを祝福してください。またわが名と先祖アブラハムとイサクの名とが、彼らによって唱えられますように、また彼らが地の上にふえひろがりますように」。"},{"ref":"Gen.48.17","start":1048017,"end":1048017,"break":"paragraph","ruby":[[4,1,"ちち"],[6,1,"みぎ"],[8,1,"て"],[16,1,"あたま"],[18,1,"お"],[25,1,"み"],[27,2,"ふまん"],[30,1,"おも"],[33,1,"ちち"],[35,1,"て"],[37,1,"と"],[46,1,"あたま"],[53,1,"あたま"],[55,1,"うつ"]],"text":"ヨセフは父が右の手をエフライムの頭に置いているのを見て不満に思い、父の手を取ってエフライムの頭からマナセの頭へ移そうとした。"},{"ref":"Gen.48.18","start":1048018,"end":1048018,"break":"none","ruby":[[7,1,"ちち"],[9,1,"い"],[14,1,"ちち"],[31,2,"ちょうし"],[38,1,"あたま"],[40,1,"みぎ"],[42,1,"て"],[44,1,"お"]],"text":"そしてヨセフは父に言った、「父よ、そうではありません。こちらが長子です。その頭に右の手を置いてください」。"},{"ref":"Gen.48.19","start":1048019,"end":1048019,"break":"none","ruby":[[0,1,"ちち"],[2,1,"こば"],[5,1,"い"],[17,1,"こ"],[32,1,"かれ"],[39,1,"たみ"],[46,1,"おお"],[50,1,"もの"],[62,1,"おとうと"],[64,1,"かれ"],[68,1,"おお"],[72,1,"もの"],[79,2,"しそん"],[82,1,"おお"],[85,2,"こくみん"]],"text":"父は拒んで言った、「わかっている。子よ、わたしにはわかっている。彼もまた一つの民となり、また大いなる者となるであろう。しかし弟は彼よりも大いなる者となり、その子孫は多くの国民となるであろう」。"},{"ref":"Gen.48.20","start":1048020,"end":1048020,"break":"none","breaks":[[21,"stanza"],[37,"line"],[50,"line"],[67,"line"]],"ruby":[[4,1,"かれ"],[8,1,"ひ"],[10,1,"かれ"],[13,2,"しゅくふく"],[17,1,"い"],[26,1,"さ"],[37,1,"ひと"],[39,2,"しゅくふく"],[43,1,"い"],[51,1,"かみ"],[93,1,"かれ"],[105,1,"さき"],[107,1,"た"]],"text":"こうして彼はこの日、彼らを祝福して言った、「あなたを指して、イスラエルは、人を祝福して言うであろう、『神があなたをエフライムのごとく、またマナセのごとくにせられるように』」。このように、彼はエフライムをマナセの先に立てた。"},{"ref":"Gen.48.21","start":1048021,"end":1048021,"break":"none","ruby":[[12,1,"い"],[24,1,"し"],[33,1,"かみ"],[41,1,"とも"],[54,2,"せんぞ"],[57,1,"くに"],[59,1,"みちび"],[61,1,"かえ"]],"text":"イスラエルはまたヨセフに言った、「わたしはやがて死にます。しかし、神はあなたがたと共におられて、あなたがたを先祖の国に導き返されるであろう。"},{"ref":"Gen.48.22","start":1048022,"end":1048022,"break":"none","ruby":[[9,1,"ぶん"],[11,2,"きょうだい"],[16,1,"おお"],[22,1,"あた"],[37,1,"ゆみ"],[40,1,"も"],[49,1,"て"],[52,1,"と"]],"text":"なおわたしは一つの分を兄弟よりも多くあなたに与える。これはわたしがつるぎと弓とを持ってアモリびとの手から取ったものである」。"}]