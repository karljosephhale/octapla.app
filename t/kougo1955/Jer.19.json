[{"ref":"Jer.19.1","start":24019001,"end":24019001,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"い"],[10,1,"い"],[14,2,"とうき"],[16,1,"し"],[21,1,"か"],[24,1,"たみ"],[26,2,"ちょうろう"],[29,2,"ねんちょう"],[32,2,"さいし"],[38,2,"すうにん"],[41,1,"ともな"]],"text":"主はこう言われる、「行って、陶器師のびんを買い、民の長老と年長の祭司のうちの数人を伴って、"},{"ref":"Jer.19.2","start":24019002,"end":24019002,"break":"none","ruby":[[0,2,"せと"],[5,1,"もん"],[7,2,"いりぐち"],[19,1,"たに"],[21,1,"い"],[26,1,"ところ"],[37,1,"かた"],[39,2,"ことば"]],"text":"瀬戸かけの門の入口にあるベンヒンノムの谷へ行き、その所で、わたしがあなたに語る言葉をのべて、"},{"ref":"Jer.19.3","start":24019003,"end":24019003,"break":"none","ruby":[[0,1,"い"],[10,1,"おう"],[23,1,"す"],[25,1,"もの"],[28,1,"しゅ"],[30,2,"ことば"],[33,1,"き"],[39,2,"ばんぐん"],[42,1,"しゅ"],[50,1,"かみ"],[54,1,"おお"],[60,1,"み"],[67,1,"わざわい"],[71,1,"ところ"],[73,1,"くだ"],[83,1,"わざわい"],[88,1,"き"],[93,1,"みみ"],[95,2,"りょうほう"],[99,1,"な"]],"text":"言いなさい、『ユダの王たち、およびエルサレムに住む者よ、主の言葉を聞きなさい。万軍の主、イスラエルの神はこう仰せられる、見よ、わたしは災をこの所に下す。おおよそ、その災のことを聞くものの耳は両方とも鳴る。"},{"ref":"Jer.19.4","start":24019004,"end":24019004,"break":"none","ruby":[[0,1,"かれ"],[7,1,"す"],[12,1,"ところ"],[14,1,"けが"],[19,1,"ところ"],[22,2,"じぶん"],[25,2,"せんぞ"],[33,1,"おう"],[37,1,"し"],[43,1,"た"],[45,2,"かみがみ"],[48,1,"こう"],[55,1,"つみ"],[59,1,"もの"],[61,1,"ち"],[66,1,"ところ"],[68,1,"み"]],"text":"彼らがわたしを捨て、この所を汚し、この所で、自分も先祖たちもユダの王たちも知らなかった他の神々に香をたき、かつ罪のない者の血を、この所に満たしたからである。"},{"ref":"Jer.19.5","start":24019005,"end":24019005,"break":"none","ruby":[[2,1,"かれ"],[12,1,"たか"],[14,1,"ところ"],[16,1,"きず"],[19,1,"ひ"],[24,2,"じぶん"],[27,1,"こ"],[33,1,"や"],[36,2,"はんさい"],[57,1,"めい"],[67,1,"さだ"],[79,1,"おも"]],"text":"また彼らはバアルのために高き所を築き、火をもって自分の子どもたちを焼き、燔祭としてバアルにささげた。これはわたしの命じたことではなく、定めたことでもなく、また思いもしなかったことである。"},{"ref":"Jer.19.6","start":24019006,"end":24019006,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"み"],[17,1,"ところ"],[32,1,"たに"],[34,1,"よ"],[40,2,"ぎゃくさつ"],[43,1,"たに"],[45,1,"よ"],[47,1,"ひ"]],"text":"主は言われる、それゆえ、見よ、この所をトペテまたはベンヒンノムの谷と呼ばないで、虐殺の谷と呼ぶ日がくる。"},{"ref":"Jer.19.7","start":24019007,"end":24019007,"break":"none","ruby":[[8,1,"ところ"],[19,1,"はか"],[24,1,"う"],[26,1,"やぶ"],[37,1,"かれ"],[42,1,"てき"],[44,1,"まえ"],[53,1,"もと"],[56,1,"もの"],[58,1,"て"],[60,1,"たお"],[69,2,"したい"],[72,1,"そら"],[74,1,"とり"],[76,1,"ち"],[78,1,"けもの"],[80,1,"く"],[82,1,"もの"]],"text":"またわたしはこの所でユダとエルサレムの計りごとを打ち破り、つるぎをもって、彼らをその敵の前と、そのいのちを求める者の手に倒れさせ、またその死体を空の鳥と地の獣の食い物とし、"},{"ref":"Jer.19.8","start":24019008,"end":24019008,"break":"none","ruby":[[5,1,"まち"],[7,1,"あ"],[16,1,"ひと"],[18,2,"したう"],[33,1,"とお"],[35,1,"ひと"],[37,1,"みな"],[45,1,"わざわい"],[47,1,"み"],[49,2,"みぶる"],[54,2,"したう"]],"text":"かつ、この町を荒れすたれさせて、人に舌打ちされるものとする。そこを通る人は皆そのもろもろの災を見て身震いし、舌打ちする。"},{"ref":"Jer.19.9","start":24019009,"end":24019009,"break":"none","ruby":[[2,1,"かれ"],[7,1,"てき"],[11,1,"いのち"],[13,1,"もと"],[16,1,"もの"],[19,1,"かこ"],[23,1,"くる"],[26,1,"なや"],[28,1,"とき"],[34,1,"かれ"],[37,2,"じぶん"],[44,1,"にく"],[46,1,"むすめ"],[48,1,"にく"],[50,1,"た"],[56,1,"かれ"],[61,1,"たがい"],[65,1,"とも"],[67,1,"にく"],[69,1,"た"]],"text":"また彼らがその敵とその命を求める者とに囲まれて苦しみ悩む時、わたしは彼らに自分のむすこの肉、娘の肉を食べさせる。彼らはまた互にその友の肉を食べるようになる』。"},{"ref":"Jer.19.10","start":24019010,"end":24019010,"break":"paragraph","ruby":[[9,2,"いっしょ"],[12,1,"ゆ"],[14,2,"ひとびと"],[17,1,"め"],[19,1,"まえ"],[27,1,"くだ"]],"text":"そこで、あなたは、一緒に行く人々の目の前で、そのびんを砕き、"},{"ref":"Jer.19.11","start":24019011,"end":24019011,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[13,2,"ばんぐん"],[16,1,"しゅ"],[20,1,"おお"],[26,2,"とうき"],[28,1,"し"],[30,1,"うつわ"],[36,1,"くだ"],[72,1,"たみ"],[76,1,"まち"],[79,1,"くだ"],[82,2,"ひとびと"],[88,1,"ほうむ"],[92,2,"ばしょ"],[105,1,"ほうむ"]],"text":"そして彼らに言いなさい、『万軍の主はこう仰せられる、陶器師の器をひとたび砕くならば、もはやもとのようにすることはできない。このようにわたしはこの民とこの町とを砕く。人々はほかに葬るべき場所がないために、トペテに葬るであろう。"},{"ref":"Jer.19.12","start":24019012,"end":24019012,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"おお"],[14,1,"ところ"],[20,1,"す"],[22,1,"もの"],[34,1,"まち"]],"text":"主は仰せられる、わたしはこの所と、ここに住む者とにこのようにし、この町をトペテのようにする。"},{"ref":"Jer.19.13","start":24019013,"end":24019013,"break":"none","ruby":[[6,1,"いえ"],[11,1,"おう"],[15,1,"いえ"],[21,1,"かれ"],[26,2,"おくじょう"],[29,1,"てん"],[31,1,"しゅう"],[32,1,"ぐん"],[34,1,"こう"],[42,2,"かみがみ"],[45,1,"さけ"],[47,1,"そそ"],[50,1,"いえ"],[53,1,"みな"],[58,1,"ところ"],[63,1,"けが"]],"text":"エルサレムの家とユダの王たちの家、すなわち彼らがその屋上で天の衆群に香をたき、ほかの神々に酒を注いだ家は、皆トペテの所のように汚される』」。"},{"ref":"Jer.19.14","start":24019014,"end":24019014,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,1,"かれ"],[14,2,"よげん"],[26,1,"かえ"],[32,1,"しゅ"],[34,1,"いえ"],[36,1,"にわ"],[38,1,"た"],[45,1,"たみ"],[47,1,"い"]],"text":"エレミヤは主が彼をつかわして預言させられたトペテから帰ってきて、主の家の庭に立ち、すべての民に言った、"},{"ref":"Jer.19.15","start":24019015,"end":24019015,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[12,1,"かみ"],[16,1,"おお"],[22,1,"み"],[32,1,"まち"],[40,2,"むらむら"],[48,1,"い"],[56,1,"わざわい"],[58,1,"くだ"],[61,1,"かれ"],[64,2,"ごうじょう"],[72,2,"ことば"],[75,1,"き"],[77,1,"したが"]],"text":"「万軍の主、イスラエルの神はこう仰せられる、見よ、わたしは、この町とそのすべての村々に、わたしの言ったもろもろの災を下す。彼らが強情で、わたしの言葉に聞き従おうとしないからである」。"}]