[{"ref":"2Chr.5.1","start":14005001,"end":14005001,"break":"paragraph","ruby":[[9,1,"しゅ"],[11,1,"みや"],[22,2,"こうじ"],[25,1,"おわ"],[37,1,"ちち"],[46,1,"もの"],[52,2,"きんぎん"],[62,2,"うつわもの"],[65,1,"たずさ"],[68,1,"い"],[71,1,"かみ"],[73,1,"みや"],[75,2,"ほうぞう"],[78,1,"おさ"]],"text":"こうしてソロモンは主の宮のためにしたすべての工事を終った。そしてソロモンは父ダビデがささげた物、すなわち金銀およびもろもろの器物を携えて行って神の宮の宝蔵に納めた。"},{"ref":"2Chr.5.2","start":14005002,"end":14005002,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,2,"けいやく"],[10,1,"はこ"],[16,1,"まち"],[25,1,"のぼ"],[38,2,"ちょうろう"],[48,2,"ぶぞく"],[64,2,"ひとびと"],[67,2,"しぞく"],[70,1,"ちょう"],[80,1,"め"],[82,1,"あつ"]],"text":"ソロモンは主の契約の箱をダビデの町シオンからかつぎ上ろうとして、イスラエルの長老たちと、すべての部族のかしらたちと、イスラエルの人々の氏族の長たちをエルサレムに召し集めた。"},{"ref":"2Chr.5.3","start":14005003,"end":14005003,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"みな"],[11,1,"がつ"],[13,1,"まつり"],[15,1,"おう"],[20,1,"あつ"]],"text":"イスラエルの人々は皆七月の祭に王のもとに集まった。"},{"ref":"2Chr.5.4","start":14005004,"end":14005004,"break":"none","ruby":[[6,2,"ちょうろう"],[11,1,"みな"],[24,1,"はこ"],[26,1,"と"],[28,1,"あ"]],"text":"イスラエルの長老たちが皆きたので、レビびとたちは箱を取り上げた。"},{"ref":"2Chr.5.5","start":14005005,"end":14005005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"はこ"],[6,2,"かいけん"],[9,2,"まくや"],[13,2,"まくや"],[21,1,"せい"],[24,1,"うつわ"],[29,1,"のぼ"],[37,2,"さいし"],[49,1,"もの"],[54,1,"のぼ"]],"text":"彼らは箱と、会見の幕屋と、幕屋にあるすべて聖なる器をかつぎ上った。すなわち祭司とレビびとがこれらの物をかつぎ上った。"},{"ref":"2Chr.5.6","start":14005006,"end":14005006,"break":"none","ruby":[[4,1,"おう"],[8,1,"かれ"],[13,1,"あつ"],[23,2,"かいしゅう"],[26,1,"みな"],[27,1,"はこ"],[29,1,"まえ"],[31,1,"ひつじ"],[33,1,"うし"],[43,1,"かず"],[45,1,"おお"],[49,1,"しら"],[55,1,"かぞ"]],"text":"ソロモン王および彼のもとに集まったイスラエルの会衆は皆箱の前で羊と牛をささげたが、その数が多くて、調べることも数えることもできなかった。"},{"ref":"2Chr.5.7","start":14005007,"end":14005007,"break":"none","ruby":[[4,2,"さいし"],[9,1,"しゅ"],[11,2,"けいやく"],[14,1,"はこ"],[18,2,"ばしょ"],[24,1,"い"],[27,1,"みや"],[29,2,"ほんでん"],[34,3,"しせいじょ"],[46,1,"つばさ"],[48,1,"した"],[50,1,"お"]],"text":"こうして祭司たちは主の契約の箱をその場所にかつぎ入れ、宮の本殿である至聖所のうちのケルビムの翼の下に置いた。"},{"ref":"2Chr.5.8","start":14005008,"end":14005008,"break":"none","ruby":[[5,1,"つばさ"],[7,1,"はこ"],[9,1,"ところ"],[11,1,"うえ"],[13,1,"の"],[26,1,"うえ"],[29,1,"はこ"]],"text":"ケルビムは翼を箱の所の上に伸べていたので、ケルビムは上から箱とそのさおをおおった。"},{"ref":"2Chr.5.9","start":14005009,"end":14005009,"break":"none","ruby":[[3,1,"なが"],[13,1,"はし"],[15,2,"ほんでん"],[18,1,"まえ"],[20,2,"せいじょ"],[24,1,"み"],[31,2,"がいぶ"],[35,1,"み"],[45,2,"こんにち"]],"text":"さおは長かったので、さおの端が本殿の前の聖所から見えた。しかし外部には見えなかった。さおは今日までそこにある。"},{"ref":"2Chr.5.10","start":14005010,"end":14005010,"break":"none","ruby":[[0,1,"はこ"],[2,1,"うち"],[6,1,"まい"],[8,1,"いた"],[12,1,"なに"],[28,2,"ひとびと"],[37,1,"で"],[39,1,"き"],[44,1,"しゅ"],[46,1,"かれ"],[49,2,"けいやく"],[52,1,"むす"],[67,1,"おさ"]],"text":"箱の内には二枚の板のほか何もなかった。これはイスラエルの人々がエジプトから出て来たとき、主が彼らと契約を結ばれ、モーセがホレブでそれを納めたものである。"},{"ref":"2Chr.5.11","start":14005011,"end":14005011,"break":"none","ruby":[[3,2,"さいし"],[8,2,"せいじょ"],[12,1,"で"],[22,2,"さいし"],[27,1,"みな"],[31,1,"くみ"],[33,1,"じゅん"],[40,1,"み"],[42,1,"きよ"]],"text":"そして祭司たちが聖所から出たとき（ここにいた祭司たちは皆、その組の順にかかわらず身を清めた。"},{"ref":"2Chr.5.12","start":14005012,"end":14005012,"break":"none","ruby":[[7,1,"うた"],[11,1,"もの"],[32,1,"かれ"],[35,1,"こ"],[39,2,"きょうだい"],[46,2,"あま"],[48,1,"ぬの"],[50,1,"き"],[58,2,"たてごと"],[62,1,"こと"],[67,2,"さいだん"],[70,1,"ひがし"],[72,1,"た"],[78,1,"にん"],[80,2,"さいし"],[83,1,"かれ"],[86,2,"いっしょ"],[89,1,"た"],[96,1,"ふ"]],"text":"またレビびとの歌うたう者、すなわちアサフ、ヘマン、エドトンおよび彼らの子たちと兄弟たちはみな亜麻布を着、シンバルと、立琴と、琴をとって祭壇の東に立ち、百二十人の祭司は彼らと一緒に立ってラッパを吹いた。"},{"ref":"2Chr.5.13","start":14005013,"end":14005013,"break":"none","breaks":[[77,"stanza"],[85,"line"]],"ruby":[[3,1,"ふ"],[5,1,"もの"],[7,1,"うた"],[11,1,"もの"],[22,1,"こえ"],[24,1,"あ"],[28,1,"しゅ"],[33,2,"かんしゃ"],[42,1,"かれ"],[57,1,"た"],[59,2,"がっき"],[65,1,"こえ"],[72,1,"しゅ"],[78,1,"しゅ"],[80,1,"めぐ"],[97,1,"た"],[107,1,"い"],[113,1,"くも"],[117,1,"みや"],[122,1,"しゅ"],[124,1,"みや"],[126,1,"み"]],"text":"ラッパ吹く者と歌うたう者とは、ひとりのように声を合わせて主をほめ、感謝した）、そして彼らがラッパと、シンバルとその他の楽器をもって声をふりあげ、主をほめて「主は恵みあり、そのあわれみはとこしえに絶えることがない」と言ったとき、雲はその宮すなわち主の宮に満ちた。"},{"ref":"2Chr.5.14","start":14005014,"end":14005014,"break":"none","ruby":[[0,2,"さいし"],[5,1,"くも"],[10,1,"た"],[13,1,"つと"],[28,1,"しゅ"],[30,2,"えいこう"],[33,1,"かみ"],[35,1,"みや"],[37,1,"み"]],"text":"祭司たちは雲のゆえに立って勤めをすることができなかった。主の栄光が神の宮に満ちたからである。"}]