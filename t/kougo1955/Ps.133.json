[{"ref":"Ps.133.1","start":19133001,"end":19133001,"break":"paragraph","title":"ダビデがよんだ都もうでの歌","breaks":[[16,"line"]],"ruby":[[0,1,"み"],[3,2,"きょうだい"],[6,2,"わごう"],[10,1,"とも"],[19,1,"うるわ"],[22,1,"たの"]],"titleRuby":[[7,1,"みやこ"],[12,1,"うた"]],"text":"見よ、兄弟が和合して共におるのはいかに麗しく楽しいことであろう。"},{"ref":"Ps.133.2","start":19133002,"end":19133002,"break":"line","breaks":[[21,"line"],[31,"line"]],"ruby":[[7,1,"そそ"],[11,1,"たっと"],[13,1,"あぶら"],[18,1,"なが"],[28,1,"なが"],[33,1,"ころも"],[40,1,"なが"]],"text":"それはこうべに注がれた尊い油がひげに流れ、アロンのひげに流れ、その衣のえりにまで流れくだるようだ。"},{"ref":"Ps.133.3","start":19133003,"end":19133003,"break":"line","breaks":[[21,"line"],[36,"line"]],"ruby":[[7,1,"つゆ"],[13,1,"やま"],[15,1,"くだ"],[24,1,"しゅ"],[30,2,"しゅくふく"],[33,1,"めい"],[41,1,"いのち"],[43,1,"あた"]],"text":"またヘルモンの露がシオンの山に下るようだ。これは主がかしこに祝福を命じ、とこしえに命を与えられたからである。"}]