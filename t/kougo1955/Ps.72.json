[{"ref":"Ps.72.1","start":19072001,"end":19072001,"break":"paragraph","title":"ソロモンの歌","breaks":[[15,"line"]],"ruby":[[0,1,"かみ"],[7,2,"こうへい"],[10,1,"おう"],[12,1,"あた"],[19,1,"ぎ"],[21,1,"おう"],[23,1,"こ"],[25,1,"あた"]],"titleRuby":[[5,1,"うた"]],"text":"神よ、あなたの公平を王に与え、あなたの義を王の子に与えてください。"},{"ref":"Ps.72.2","start":19072002,"end":19072002,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ぎ"],[11,1,"たみ"],[17,2,"こうへい"],[27,1,"まず"],[30,1,"もの"]],"text":"彼は義をもってあなたの民をさばき、公平をもってあなたの貧しい者をさばくように。"},{"ref":"Ps.72.3","start":19072003,"end":19072003,"break":"line","breaks":[[15,"line"]],"ruby":[[5,1,"やま"],[7,1,"おか"],[10,1,"ぎ"],[15,1,"たみ"],[17,2,"へいわ"],[20,1,"あた"]],"text":"もろもろの山と丘とは義によって民に平和を与えるように。"},{"ref":"Ps.72.4","start":19072004,"end":19072004,"break":"line","breaks":[[16,"line"],[26,"line"]],"ruby":[[0,1,"かれ"],[2,1,"たみ"],[4,1,"まず"],[7,1,"もの"],[9,1,"うった"],[12,2,"べんご"],[16,1,"とぼ"],[19,1,"もの"],[21,1,"すくい"],[23,1,"あた"],[31,1,"もの"],[33,1,"う"],[35,1,"くだ"]],"text":"彼は民の貧しい者の訴えを弁護し、乏しい者に救を与え、しえたげる者を打ち砕くように。"},{"ref":"Ps.72.5","start":19072005,"end":19072005,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ひ"],[4,1,"つき"],[14,2,"よよ"],[16,1,"い"]],"text":"彼は日と月とのあらんかぎり、世々生きながらえるように。"},{"ref":"Ps.72.6","start":19072006,"end":19072006,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[2,1,"か"],[4,1,"と"],[7,2,"まきぐさ"],[10,1,"うえ"],[12,1,"ふ"],[14,1,"あめ"],[20,1,"ち"],[22,1,"うるお"],[24,2,"ゆうだ"],[31,1,"のぞ"]],"text":"彼は刈り取った牧草の上に降る雨のごとく、地を潤す夕立ちのごとく臨むように。"},{"ref":"Ps.72.7","start":19072007,"end":19072007,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"あ"],[2,1,"よ"],[4,1,"ぎ"],[6,1,"さか"],[9,2,"へいわ"],[12,1,"つき"],[20,1,"ゆた"]],"text":"彼の世に義は栄え、平和は月のなくなるまで豊かであるように。"},{"ref":"Ps.72.8","start":19072008,"end":19072008,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[2,1,"うみ"],[5,1,"うみ"],[8,1,"おさ"],[11,1,"かわ"],[14,1,"ち"],[20,1,"おさ"]],"text":"彼は海から海まで治め、川から地のはてまで治めるように。"},{"ref":"Ps.72.9","start":19072009,"end":19072009,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[5,1,"かれ"],[7,1,"まえ"],[13,1,"かれ"],[15,1,"てき"]],"text":"彼のあだは彼の前にかがみ、彼の敵はちりをなめるように。"},{"ref":"Ps.72.10","start":19072010,"end":19072010,"break":"line","breaks":[[21,"line"]],"ruby":[[7,2,"しまじま"],[10,1,"おう"],[18,1,"おさ"],[27,1,"おう"],[31,1,"おく"],[33,1,"もの"],[35,1,"たずさ"],[38,1,"く"]],"text":"タルシシおよび島々の王たちはみつぎを納め、シバとセバの王たちは贈り物を携えて来るように。"},{"ref":"Ps.72.11","start":19072011,"end":19072011,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"おう"],[7,1,"かれ"],[9,1,"まえ"],[13,1,"ふ"],[21,2,"くにたみ"],[24,1,"かれ"],[26,1,"つか"]],"text":"もろもろの王は彼の前にひれ伏し、もろもろの国民は彼に仕えるように。"},{"ref":"Ps.72.12","start":19072012,"end":19072012,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[2,1,"とぼ"],[5,1,"もの"],[9,1,"よ"],[13,1,"とき"],[15,1,"すく"],[18,1,"まず"],[21,1,"もの"],[24,1,"たす"],[28,1,"もの"],[31,1,"すく"]],"text":"彼は乏しい者をその呼ばわる時に救い、貧しい者と、助けなき者とを救う。"},{"ref":"Ps.72.13","start":19072013,"end":19072013,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[2,1,"よわ"],[4,1,"もの"],[6,1,"とぼ"],[9,1,"もの"],[17,1,"とぼ"],[20,1,"もの"],[26,1,"すく"]],"text":"彼は弱い者と乏しい者とをあわれみ、乏しい者のいのちを救い、"},{"ref":"Ps.72.14","start":19072014,"end":19072014,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かれ"],[13,2,"ぼうりょく"],[23,1,"かれ"],[26,1,"ち"],[28,1,"かれ"],[30,1,"め"],[32,1,"たっと"]],"text":"彼らのいのちを、しえたげと暴力とからあがなう。彼らの血は彼の目に尊い。"},{"ref":"Ps.72.15","start":19072015,"end":19072015,"break":"line","breaks":[[9,"line"],[23,"line"],[39,"line"]],"ruby":[[0,1,"かれ"],[2,1,"い"],[12,2,"おうごん"],[15,1,"かれ"],[23,1,"かれ"],[28,1,"た"],[31,1,"いのり"],[43,1,"かれ"],[48,2,"しゅくふく"],[51,1,"もと"]],"text":"彼は生きながらえ、シバの黄金が彼にささげられ、彼のために絶えず祈がささげられ、ひねもす彼のために祝福が求められるように。"},{"ref":"Ps.72.16","start":19072016,"end":19072016,"break":"line","breaks":[[16,"line"],[37,"line"]],"ruby":[[0,1,"くに"],[6,2,"こくもつ"],[9,1,"ゆた"],[18,1,"み"],[28,2,"やまやま"],[31,1,"いただき"],[33,2,"なみう"],[37,2,"ひとびと"],[40,1,"の"],[42,1,"くさ"],[47,2,"まちまち"],[50,1,"さか"]],"text":"国のうちには穀物が豊かにみのり、その実はレバノンのように山々の頂に波打ち、人々は野の草のごとく町々に栄えるように。"},{"ref":"Ps.72.17","start":19072017,"end":19072017,"break":"line","breaks":[[12,"line"],[37,"line"],[50,"line"],[68,"line"]],"ruby":[[0,1,"かれ"],[2,1,"な"],[9,1,"つづ"],[14,2,"めいせい"],[17,1,"ひ"],[22,1,"かぎ"],[25,1,"た"],[37,2,"ひとびと"],[40,1,"かれ"],[45,2,"しゅくふく"],[48,1,"え"],[55,2,"くにたみ"],[58,1,"かれ"],[66,1,"もの"]],"text":"彼の名はとこしえに続き、その名声は日のあらん限り、絶えることのないように。人々は彼によって祝福を得、もろもろの国民は彼をさいわいなる者ととなえるように。"},{"ref":"Ps.72.18","start":19072018,"end":19072018,"break":"line","breaks":[[17,"line"]],"ruby":[[6,1,"かみ"],[8,1,"しゅ"],[19,1,"しゅ"]],"text":"イスラエルの神、主はほむべきかな。ただ主のみ、くすしきみわざをなされる。"},{"ref":"Ps.72.19","start":19072019,"end":19072019,"break":"line","breaks":[[20,"line"],[40,"line"]],"ruby":[[2,2,"こうえい"],[6,1,"な"],[20,1,"ぜん"],[21,1,"ち"],[25,2,"えいこう"],[31,1,"み"]],"text":"その光栄ある名はとこしえにほむべきかな。全地はその栄光をもって満たされるように。アァメン、アァメン。"},{"ref":"Ps.72.20","start":19072020,"end":19072020,"break":"line","ruby":[[5,1,"こ"],[10,1,"いのり"],[12,1,"おわ"]],"text":"エッサイの子ダビデの祈は終った。"}]