[{"ref":"2Sam.13.1","start":10013001,"end":10013001,"break":"paragraph","ruby":[[6,1,"こ"],[14,1,"な"],[22,1,"うつく"],[25,1,"いもうと"],[34,1,"のち"],[39,1,"こ"],[48,1,"こい"]],"text":"さてダビデの子アブサロムには名をタマルという美しい妹があったが、その後ダビデの子アムノンはこれを恋した。"},{"ref":"2Sam.13.2","start":10013002,"end":10013002,"break":"none","ruby":[[5,1,"いもうと"],[13,1,"なや"],[32,2,"しょじょ"],[44,2,"かのじょ"],[47,2,"なにごと"],[60,1,"おも"]],"text":"アムノンは妹タマルのために悩んでついにわずらった。それはタマルが処女であって、アムノンは彼女に何事もすることができないと思ったからである。"},{"ref":"2Sam.13.3","start":10013003,"end":10013003,"break":"none","ruby":[[14,1,"とも"],[22,1,"な"],[36,2,"きょうだい"],[42,1,"こ"],[57,1,"かしこ"],[59,1,"ひと"]],"text":"ところがアムノンにはひとりの友だちがあった。名をヨナダブといい、ダビデの兄弟シメアの子である。ヨナダブはひじょうに賢い人であった。"},{"ref":"2Sam.13.4","start":10013004,"end":10013004,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[12,2,"おうじ"],[25,1,"あさ"],[36,1,"おとろ"],[48,1,"はな"],[63,1,"かれ"],[65,1,"い"],[74,2,"きょうだい"],[82,1,"いもうと"],[87,1,"こい"]],"text":"彼はアムノンに言った、「王子よ、あなたは、どうして朝ごとに、そんなにやせ衰えるのですか。わたしに話さないのですか」。アムノンは彼に言った、「わたしは兄弟アブサロムの妹タマルを恋しているのです」。"},{"ref":"2Sam.13.5","start":10013005,"end":10013005,"break":"none","ruby":[[5,1,"かれ"],[7,1,"い"],[16,1,"やまい"],[18,1,"いつわ"],[21,2,"ねどこ"],[24,1,"よこ"],[34,1,"ちち"],[42,1,"み"],[46,1,"かれ"],[48,1,"い"],[63,1,"いもうと"],[76,1,"ところ"],[78,2,"しょくもつ"],[81,1,"はこ"],[93,2,"かのじょ"],[100,1,"め"],[102,1,"まえ"],[104,2,"しょくもつ"],[112,2,"かのじょ"],[115,1,"て"],[122,1,"た"]],"text":"ヨナダブは彼に言った、「あなたは病と偽り、寝床に横たわって、あなたの父がきてあなたを見るとき彼に言いなさい、『どうぞ、わたしの妹タマルをこさせ、わたしの所に食物を運ばせてください。そして彼女がわたしの目の前で食物をととのえ、彼女の手からわたしが食べることのできるようにさせてください』」。"},{"ref":"2Sam.13.6","start":10013006,"end":10013006,"break":"none","ruby":[[8,1,"よこ"],[13,1,"やまい"],[15,1,"いつわ"],[20,1,"おう"],[24,1,"かれ"],[26,1,"み"],[28,1,"とき"],[35,1,"おう"],[37,1,"い"],[49,1,"いもうと"],[62,1,"め"],[64,1,"まえ"],[69,2,"かし"],[72,1,"つく"],[77,2,"かのじょ"],[80,1,"て"],[87,1,"た"]],"text":"そこでアムノンは横になって病と偽ったが、王がきて彼を見た時、アムノンは王に言った、「どうぞわたしの妹タマルをこさせ、わたしの目の前で二つの菓子を作らせて、彼女の手からわたしが食べることのできるようにしてください」。"},{"ref":"2Sam.13.7","start":10013007,"end":10013007,"break":"paragraph","ruby":[[8,1,"いえ"],[10,1,"ひと"],[17,1,"い"],[27,1,"あに"],[33,1,"いえ"],[35,1,"い"],[39,1,"かれ"],[44,2,"しょくもつ"]],"text":"ダビデはタマルの家に人をつかわして言わせた、「あなたの兄アムノンの家へ行って、彼のために食物をととのえなさい」。"},{"ref":"2Sam.13.8","start":10013008,"end":10013008,"break":"none","ruby":[[9,1,"あに"],[15,1,"いえ"],[17,1,"い"],[29,1,"ね"],[38,1,"こな"],[40,1,"と"],[50,1,"かれ"],[52,1,"め"],[54,1,"まえ"],[57,2,"かし"],[60,1,"つく"],[65,2,"かし"],[68,1,"や"]],"text":"そこでタマルはその兄アムノンの家へ行ったところ、アムノンは寝ていた。タマルは粉を取って、これをこね、彼の目の前で、菓子を作り、その菓子を焼き、"},{"ref":"2Sam.13.9","start":10013009,"end":10013009,"break":"none","ruby":[[3,1,"と"],[6,1,"かれ"],[8,1,"まえ"],[20,1,"かれ"],[22,1,"た"],[28,1,"こば"],[49,1,"はな"],[52,1,"で"],[60,1,"い"],[66,1,"みな"],[68,1,"かれ"],[70,1,"はな"],[73,1,"で"]],"text":"なべを取って彼の前にそれをあけた。しかし彼は食べることを拒んだ。そしてアムノンは、「みな、わたしを離れて出てください」と言ったので、皆、彼を離れて出た。"},{"ref":"2Sam.13.10","start":10013010,"end":10013010,"break":"none","ruby":[[9,1,"い"],[14,2,"しょくもつ"],[17,2,"しんしつ"],[20,1,"も"],[38,1,"て"],[41,1,"た"],[54,2,"じぶん"],[57,1,"つく"],[60,2,"かし"],[67,2,"しんしつ"],[73,1,"あに"],[79,1,"ところ"],[81,1,"も"]],"text":"アムノンはタマルに言った、「食物を寝室に持ってきてください。わたしはあなたの手から食べます」。そこでタマルは自分の作った菓子をとって、寝室にはいり兄アムノンの所へ持っていった。"},{"ref":"2Sam.13.11","start":10013011,"end":10013011,"break":"none","ruby":[[4,1,"かれ"],[6,1,"た"],[15,1,"ちか"],[18,1,"も"],[21,1,"い"],[24,1,"とき"],[26,1,"かれ"],[32,1,"とら"],[35,2,"かのじょ"],[38,1,"い"],[43,1,"いもうと"],[46,1,"き"],[53,1,"ね"]],"text":"タマルが彼に食べさせようとして近くに持って行った時、彼はタマルを捕えて彼女に言った、「妹よ、来て、わたしと寝なさい」。"},{"ref":"2Sam.13.12","start":10013012,"end":10013012,"break":"none","ruby":[[4,1,"い"],[13,1,"あに"],[14,1,"うえ"],[49,1,"おこな"],[58,1,"おろ"]],"text":"タマルは言った、「いいえ、兄上よ、わたしをはずかしめてはなりません。このようなことはイスラエルでは行われません。この愚かなことをしてはなりません。"},{"ref":"2Sam.13.13","start":10013013,"end":10013013,"break":"none","ruby":[[4,1,"はじ"],[13,1,"も"],[16,1,"い"],[38,1,"おろ"],[40,1,"もの"],[61,1,"おう"],[63,1,"はな"],[71,1,"おう"],[81,1,"あた"]],"text":"わたしの恥をわたしはどこへ持って行くことができましょう。あなたはイスラエルの愚か者のひとりとなるでしょう。それゆえ、どうぞ王に話してください。王がわたしをあなたに与えないことはないでしょう」。"},{"ref":"2Sam.13.14","start":10013014,"end":10013014,"break":"none","ruby":[[8,2,"かのじょ"],[11,1,"い"],[16,1,"き"],[30,1,"つよ"],[50,1,"とも"],[52,1,"ね"]],"text":"しかしアムノンは彼女の言うことを聞こうともせず、タマルよりも強かったので、タマルをはずかしめてこれと共に寝た。"},{"ref":"2Sam.13.15","start":10013015,"end":10013015,"break":"paragraph","ruby":[[15,1,"ふか"],[21,1,"にく"],[30,2,"かのじょ"],[33,1,"にく"],[35,1,"にく"],[40,2,"かのじょ"],[43,1,"こい"],[46,1,"こい"],[50,1,"おお"],[61,2,"かのじょ"],[64,1,"い"],[69,1,"た"],[73,1,"い"]],"text":"それからアムノンは、ひじょうに深くタマルを憎むようになった。彼女を憎む憎しみは、彼女を恋した恋よりも大きかった。アムノンは彼女に言った、「立って、行きなさい」。"},{"ref":"2Sam.13.16","start":10013016,"end":10013016,"break":"none","ruby":[[9,1,"い"],[18,1,"あに"],[19,1,"うえ"],[26,1,"かえ"],[47,1,"こと"],[51,1,"おお"],[54,1,"あく"],[67,2,"かのじょ"],[70,1,"い"],[75,1,"き"]],"text":"タマルはアムノンに言った、「いいえ、兄上よ、わたしを返すことは、あなたがさきにわたしになさった事よりも大きい悪です」。しかしアムノンは彼女の言うことを聞こうともせず、"},{"ref":"2Sam.13.17","start":10013017,"end":10013017,"break":"none","ruby":[[0,1,"かれ"],[2,1,"つか"],[7,2,"わかもの"],[10,1,"よ"],[13,1,"い"],[20,1,"おんな"],[26,1,"ところ"],[29,1,"そと"],[34,1,"だ"],[42,1,"と"],[44,1,"と"]],"text":"彼に仕えている若者を呼んで言った、「この女をわたしの所から外におくり出し、そのあとに戸を閉ざすがよい」。"},{"ref":"2Sam.13.18","start":10013018,"end":10013018,"break":"none","ruby":[[2,1,"とき"],[8,1,"なが"],[12,2,"きもの"],[15,1,"き"],[20,1,"むかし"],[22,1,"おう"],[24,1,"ひめ"],[28,2,"しょじょ"],[33,1,"もの"],[40,2,"きもの"],[43,1,"き"],[60,2,"かのじょ"],[63,1,"そと"],[65,1,"だ"],[74,1,"と"],[76,1,"と"]],"text":"この時、タマルは長そでの着物を着ていた。昔、王の姫たちの処女である者はこのような着物を着たからである。アムノンのしもべは彼女を外に出して、そのあとに戸を閉ざした。"},{"ref":"2Sam.13.19","start":10013019,"end":10013019,"break":"none","ruby":[[4,1,"はい"],[6,1,"あたま"],[12,1,"き"],[16,1,"なが"],[20,2,"きもの"],[23,1,"さ"],[26,1,"て"],[28,1,"あたま"],[34,1,"さけ"],[39,1,"さ"],[42,1,"い"]],"text":"タマルは灰を頭にかぶり、着ていた長そでの着物を裂き、手を頭にのせて、叫びながら去って行った。"},{"ref":"2Sam.13.20","start":10013020,"end":10013020,"break":"paragraph","ruby":[[0,1,"あに"],[7,2,"かのじょ"],[10,1,"い"],[15,1,"あに"],[25,2,"いっしょ"],[36,1,"いもうと"],[39,1,"いま"],[41,1,"だま"],[49,1,"かれ"],[55,1,"あに"],[61,1,"こと"],[63,1,"こころ"],[84,1,"あに"],[91,1,"いえ"],[93,1,"さび"],[96,1,"す"]],"text":"兄アブサロムは彼女に言った、「兄アムノンがあなたと一緒にいたのか。しかし妹よ、今は黙っていなさい。彼はあなたの兄です。この事を心にとめなくてよろしい」。こうしてタマルは兄アブサロムの家に寂しく住んでいた。"},{"ref":"2Sam.13.21","start":10013021,"end":10013021,"break":"none","ruby":[[3,1,"おう"],[9,1,"こと"],[16,1,"き"],[25,1,"いか"]],"text":"ダビデ王はこれらの事をことごとく聞いて、ひじょうに怒った。"},{"ref":"2Sam.13.22","start":10013022,"end":10013022,"break":"none","ruby":[[11,1,"よ"],[16,1,"わる"],[21,1,"かた"],[46,1,"いもうと"],[66,1,"かれ"],[68,1,"にく"]],"text":"アブサロムはアムノンに良いことも悪いことも語ることをしなかった。それはアムノンがアブサロムの妹タマルをはずかしめたので、アブサロムが彼を憎んでいたからである。"},{"ref":"2Sam.13.23","start":10013023,"end":10013023,"break":"paragraph","ruby":[[0,1,"まん"],[2,1,"ねん"],[4,1,"のち"],[18,1,"ちか"],[31,1,"ひつじ"],[33,1,"け"],[35,1,"き"],[41,1,"とき"],[43,1,"おう"],[45,1,"こ"],[54,1,"まね"]],"text":"満二年の後、アブサロムはエフライムの近くにあるバアル・ハゾルで羊の毛を切らせていた時、王の子たちをことごとく招いた。"},{"ref":"2Sam.13.24","start":10013024,"end":10013024,"break":"none","ruby":[[9,1,"おう"],[16,1,"い"],[21,1,"み"],[28,1,"ひつじ"],[30,1,"け"],[32,1,"き"],[44,1,"おう"],[46,1,"おう"],[48,2,"けらい"],[58,1,"とも"]],"text":"そしてアブサロムは王のもとにきて言った、「見よ、しもべは羊の毛を切らせております。どうぞ王も王の家来たちも、しもべと共にきてください」。"},{"ref":"2Sam.13.25","start":10013025,"end":10013025,"break":"none","ruby":[[0,1,"おう"],[8,1,"い"],[19,1,"こ"],[27,1,"みな"],[28,1,"い"],[41,2,"おもに"],[68,1,"ねが"],[79,1,"い"],[84,2,"しょうち"],[88,1,"かれ"],[90,2,"しゅくふく"],[93,1,"あた"]],"text":"王はアブサロムに言った、「いいえ、わが子よ、われわれが皆行ってはならない。あなたの重荷になるといけないから」。アブサロムはダビデにしいて願った。しかしダビデは行くことを承知せず彼に祝福を与えた。"},{"ref":"2Sam.13.26","start":10013026,"end":10013026,"break":"none","ruby":[[9,1,"い"],[26,1,"あに"],[37,1,"とも"],[39,1,"い"],[49,1,"おう"],[51,1,"かれ"],[53,1,"い"],[62,1,"かれ"],[68,1,"とも"],[70,1,"い"]],"text":"そこでアブサロムは言った、「それでは、どうぞわたしの兄アムノンをわれわれと共に行かせてください」。王は彼に言った、「どうして彼があなたと共に行かなければならないのか」。"},{"ref":"2Sam.13.27","start":10013027,"end":10013027,"break":"none","ruby":[[9,1,"かれ"],[14,1,"ねが"],[28,1,"おう"],[30,1,"こ"],[34,1,"みな"],[42,1,"とも"],[44,1,"い"]],"text":"しかしアブサロムは彼にしいて願ったので、ついにアムノンと王の子たちを皆、アブサロムと共に行かせた。"},{"ref":"2Sam.13.28","start":10013028,"end":10013028,"break":"none","ruby":[[9,2,"わかもの"],[14,1,"めい"],[17,1,"い"],[27,1,"さけ"],[29,1,"の"],[33,1,"こころ"],[34,1,"たの"],[40,1,"とき"],[42,1,"み"],[64,1,"う"],[68,1,"い"],[70,1,"とき"],[72,1,"かれ"],[74,1,"ころ"],[80,1,"おそ"],[93,1,"めい"],[103,2,"おお"],[112,1,"いさ"]],"text":"そこでアブサロムは若者たちに命じて言った、「アムノンが酒を飲んで、心楽しくなった時を見すまし、わたしがあなたがたに、『アムノンを撃て』と言う時、彼を殺しなさい。恐れることはない。わたしが命じるのではないか。雄々しくしなさい。勇ましくしなさい」。"},{"ref":"2Sam.13.29","start":10013029,"end":10013029,"break":"none","ruby":[[6,2,"わかもの"],[17,1,"めい"],[36,1,"おう"],[38,1,"こ"],[42,1,"みな"],[43,1,"た"],[53,2,"らば"],[56,1,"の"],[59,1,"に"]],"text":"アブサロムの若者たちはアブサロムの命じたようにアムノンにおこなったので、王の子たちは皆立って、おのおのその騾馬に乗って逃げた。"},{"ref":"2Sam.13.30","start":10013030,"end":10013030,"break":"paragraph","ruby":[[0,1,"かれ"],[5,1,"つ"],[20,1,"おう"],[22,1,"こ"],[31,1,"ころ"],[39,1,"のこ"],[44,1,"もの"],[52,1,"し"],[60,1,"たっ"]],"text":"彼らがまだ着かないうちに、「アブサロムは王の子たちをことごとく殺して、ひとりも残っている者がない」という知らせがダビデに達したので、"},{"ref":"2Sam.13.31","start":10013031,"end":10013031,"break":"none","ruby":[[0,1,"おう"],[2,1,"た"],[7,2,"きもの"],[10,1,"さ"],[14,1,"ち"],[16,1,"ふ"],[27,1,"た"],[32,2,"けらい"],[37,1,"みな"],[40,2,"きもの"],[43,1,"さ"]],"text":"王は立ち、その着物を裂いて、地に伏した。そのかたわらに立っていた家来たちも皆その着物を裂いた。"},{"ref":"2Sam.13.32","start":10013032,"end":10013032,"break":"none","ruby":[[7,2,"きょうだい"],[13,1,"こ"],[19,1,"い"],[26,1,"しゅ"],[29,1,"おう"],[31,1,"こ"],[37,2,"わかもの"],[44,1,"ころ"],[51,1,"かんが"],[71,1,"し"],[81,1,"かれ"],[89,1,"いもうと"],[100,1,"ひ"],[110,1,"いのち"],[115,1,"さだ"]],"text":"しかしダビデの兄弟シメアの子ヨナダブは言った、「わが主よ、王の子たちである若者たちがみな殺されたと、お考えになってはなりません。アムノンだけが死んだのです。これは彼がアブサロムの妹タマルをはずかしめた日から、アブサロムの命によって定められていたことなのです。"},{"ref":"2Sam.13.33","start":10013033,"end":10013033,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"おう"],[12,1,"おう"],[14,1,"こ"],[18,1,"みな"],[19,1,"し"],[23,1,"おも"],[29,1,"こと"],[31,1,"こころ"],[52,1,"し"]],"text":"それゆえ、わが主、王よ、王の子たちが皆死んだと思って、この事を心にとめられてはなりません。アムノンだけが死んだのです」。"},{"ref":"2Sam.13.34","start":10013034,"end":10013034,"break":"paragraph","ruby":[[11,1,"とき"],[13,2,"みは"],[21,2,"わかもの"],[24,1,"め"],[29,1,"み"],[33,1,"やま"],[46,1,"みち"],[49,1,"おお"],[52,1,"たみ"],[54,1,"く"],[58,1,"み"]],"text":"アブサロムはのがれた。時に見張りをしていた若者が目をあげて見ると、山のかたわらのホロナイムの道から多くの民の来るのが見えた。"},{"ref":"2Sam.13.35","start":10013035,"end":10013035,"break":"none","ruby":[[5,1,"おう"],[7,1,"い"],[12,1,"み"],[15,1,"おう"],[17,1,"こ"],[30,1,"い"]],"text":"ヨナダブは王に言った、「見よ、王の子たちがきました。しもべの言ったとおりです」。"},{"ref":"2Sam.13.36","start":10013036,"end":10013036,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かた"],[7,1,"おわ"],[10,1,"とき"],[12,1,"おう"],[14,1,"こ"],[20,1,"こえ"],[25,1,"な"],[29,1,"おう"],[33,2,"けらい"],[38,1,"みな"],[40,2,"ひじょう"],[47,1,"な"]],"text":"彼が語ることを終った時、王の子たちはきて声をあげて泣いた。王もその家来たちも皆、非常にはげしく泣いた。"},{"ref":"2Sam.13.37","start":10013037,"end":10013037,"break":"paragraph","ruby":[[19,1,"おう"],[25,1,"こ"],[34,1,"い"],[42,2,"ひび"],[46,1,"こ"],[51,1,"かな"]],"text":"しかしアブサロムはのがれて、ゲシュルの王アミホデの子タルマイのもとに行った。ダビデは日々その子のために悲しんだ。"},{"ref":"2Sam.13.38","start":10013038,"end":10013038,"break":"none","ruby":[[15,1,"い"],[19,1,"ねん"],[21,1,"あいだ"]],"text":"アブサロムはのがれてゲシュルに行き、三年の間そこにいた。"},{"ref":"2Sam.13.39","start":10013039,"end":10013039,"break":"none","ruby":[[0,1,"おう"],[2,1,"こころ"],[11,1,"あ"],[20,1,"のぞ"],[29,1,"し"],[40,1,"かれ"]],"text":"王は心に、アブサロムに会うことを、せつに望んだ。アムノンは死んでしまい、ダビデが彼のことはあきらめていたからである。"}]