[{"ref":"Gen.50.1","start":1050001,"end":1050001,"break":"paragraph","ruby":[[4,1,"ちち"],[6,1,"かお"],[8,1,"ふ"],[11,1,"な"],[14,1,"くち"]],"text":"ヨセフは父の顔に伏して泣き、口づけした。"},{"ref":"Gen.50.2","start":1050002,"end":1050002,"break":"none","ruby":[[7,1,"かれ"],[15,2,"いしゃ"],[21,1,"ちち"],[23,1,"くすり"],[25,1,"ぬ"],[30,1,"めい"],[36,2,"いしゃ"],[47,1,"くすり"],[49,1,"ぬ"]],"text":"そしてヨセフは彼のしもべである医者たちに、父に薬を塗ることを命じたので、医者たちはイスラエルに薬を塗った。"},{"ref":"Gen.50.3","start":1050003,"end":1050003,"break":"none","ruby":[[7,1,"にち"],[9,1,"ついや"],[13,1,"くすり"],[15,1,"ぬ"],[24,1,"ひ"],[25,1,"かず"],[27,1,"よう"],[44,1,"にち"],[46,1,"あいだ"],[48,1,"かれ"],[53,1,"な"]],"text":"このために四十日を費した。薬を塗るにはこれほどの日数を要するのである。エジプトびとは七十日の間、彼のために泣いた。"},{"ref":"Gen.50.4","start":1050004,"end":1050004,"break":"paragraph","ruby":[[0,1,"かれ"],[5,1,"な"],[7,1,"ひ"],[9,1,"す"],[20,1,"いえ"],[22,1,"もの"],[24,1,"い"],[29,1,"いま"],[42,1,"まえ"],[44,1,"めぐ"],[47,1,"え"],[58,1,"つた"]],"text":"彼のために泣く日が過ぎて、ヨセフはパロの家の者に言った、「今もしわたしがあなたがたの前に恵みを得るなら、どうかパロに伝えてください。"},{"ref":"Gen.50.5","start":1050005,"end":1050005,"break":"none","ruby":[[5,1,"ちち"],[11,1,"ちか"],[15,1,"い"],[28,1,"し"],[37,1,"ち"],[44,1,"ほ"],[47,1,"お"],[50,1,"はか"],[52,1,"ほうむ"],[72,1,"のぼ"],[75,1,"い"],[79,1,"ちち"],[81,1,"ほうむ"],[102,1,"かえ"]],"text":"『わたしの父はわたしに誓わせて言いました「わたしはやがて死にます。カナンの地に、わたしが掘って置いた墓に葬ってください」。それで、どうかわたしを上って行かせ、父を葬らせてください。そうすれば、わたしはまた帰ってきます』」。"},{"ref":"Gen.50.6","start":1050006,"end":1050006,"break":"none","ruby":[[3,1,"い"],[12,1,"ちち"],[18,1,"ちか"],[25,1,"のぼ"],[28,1,"い"],[31,1,"かれ"],[33,1,"ほうむ"]],"text":"パロは言った、「あなたの父があなたに誓わせたように上って行って彼を葬りなさい」。"},{"ref":"Gen.50.7","start":1050007,"end":1050007,"break":"none","ruby":[[7,1,"ちち"],[9,1,"ほうむ"],[14,1,"のぼ"],[17,1,"い"],[21,1,"かれ"],[23,1,"とも"],[25,1,"のぼ"],[28,1,"もの"],[38,2,"けらい"],[46,1,"いえ"],[48,2,"ちょうろう"],[58,1,"くに"],[65,2,"ちょうろう"]],"text":"そこでヨセフは父を葬るために上って行った。彼と共に上った者はパロのもろもろの家来たち、パロの家の長老たち、エジプトの国のもろもろの長老たち、"},{"ref":"Gen.50.8","start":1050008,"end":1050008,"break":"none","ruby":[[4,2,"ぜんか"],[9,2,"きょうだい"],[13,1,"およ"],[17,1,"ちち"],[19,2,"かぞく"],[28,2,"こども"],[31,1,"ひつじ"],[33,1,"うし"],[39,1,"ち"],[41,1,"のこ"]],"text":"ヨセフの全家とその兄弟たち及びその父の家族であった。ただ子供と羊と牛はゴセンの地に残した。"},{"ref":"Gen.50.9","start":1050009,"end":1050009,"break":"none","ruby":[[2,2,"せんしゃ"],[5,2,"きへい"],[8,1,"かれ"],[10,1,"とも"],[12,1,"のぼ"],[20,2,"ぎょうれつ"],[27,1,"さか"]],"text":"また戦車と騎兵も彼と共に上ったので、その行列はたいそう盛んであった。"},{"ref":"Gen.50.10","start":1050010,"end":1050010,"break":"none","ruby":[[0,1,"かれ"],[8,1,"む"],[16,1,"う"],[18,1,"ば"],[20,1,"い"],[22,1,"つ"],[29,1,"おお"],[32,1,"なげ"],[35,2,"ひじょう"],[38,1,"かな"],[50,2,"なぬか"],[53,1,"あいだ"],[54,1,"ちち"],[59,1,"なげ"]],"text":"彼らはヨルダンの向こうのアタデの打ち場に行き着いて、そこで大いに嘆き、非常に悲しんだ。そしてヨセフは七日の間父のために嘆いた。"},{"ref":"Gen.50.11","start":1050011,"end":1050011,"break":"none","ruby":[[2,1,"ち"],[4,2,"じゅうみん"],[17,1,"う"],[19,1,"ば"],[21,1,"なげ"],[24,1,"み"],[38,1,"おお"],[42,1,"なげ"],[47,1,"い"],[55,1,"ところ"],[57,1,"な"],[69,1,"よ"],[82,1,"む"]],"text":"その地の住民、カナンびとがアタデの打ち場の嘆きを見て、「これはエジプトびとの大いなる嘆きだ」と言ったので、その所の名はアベル・ミツライムと呼ばれた。これはヨルダンの向こうにある。"},{"ref":"Gen.50.12","start":1050012,"end":1050012,"break":"none","ruby":[[4,1,"こ"],[7,1,"めい"]],"text":"ヤコブの子らは命じられたようにヤコブにおこなった。"},{"ref":"Gen.50.13","start":1050013,"end":1050013,"break":"none","ruby":[[6,1,"こ"],[9,1,"かれ"],[15,1,"ち"],[17,1,"はこ"],[20,1,"い"],[29,1,"はたけ"],[33,1,"あな"],[35,1,"ほうむ"],[43,1,"あな"],[49,1,"ひがし"],[71,1,"はたけ"],[73,1,"とも"],[75,1,"か"],[79,2,"しょゆう"],[82,2,"ぼち"]],"text":"すなわちその子らは彼をカナンの地へ運んで行って、マクペラの畑のほら穴に葬った。このほら穴はマムレの東にあって、アブラハムがヘテびとエフロンから畑と共に買って、所有の墓地としたものである。"},{"ref":"Gen.50.14","start":1050014,"end":1050014,"break":"none","ruby":[[4,1,"ちち"],[6,1,"ほうむ"],[9,1,"のち"],[13,2,"きょうだい"],[17,1,"およ"],[22,1,"ちち"],[24,1,"ほうむ"],[29,2,"いっしょ"],[32,1,"のぼ"],[35,1,"もの"],[37,1,"とも"],[44,1,"かえ"]],"text":"ヨセフは父を葬った後、その兄弟たち及びすべて父を葬るために一緒に上った者と共にエジプトに帰った。"},{"ref":"Gen.50.15","start":1050015,"end":1050015,"break":"paragraph","ruby":[[4,2,"きょうだい"],[9,1,"ちち"],[11,1,"し"],[16,1,"み"],[18,1,"い"],[38,1,"にく"],[47,1,"かれ"],[55,1,"あく"],[58,2,"しかえ"],[64,1,"ちが"]],"text":"ヨセフの兄弟たちは父の死んだのを見て言った、「ヨセフはことによるとわれわれを憎んで、われわれが彼にしたすべての悪に、仕返しするに違いない」。"},{"ref":"Gen.50.16","start":1050016,"end":1050016,"break":"none","ruby":[[3,1,"かれ"],[16,1,"い"],[25,1,"ちち"],[27,1,"し"],[29,1,"まえ"],[31,1,"めい"],[34,1,"い"]],"text":"そこで彼らはことづけしてヨセフに言った、「あなたの父は死ぬ前に命じて言われました、"},{"ref":"Gen.50.17","start":1050017,"end":1050017,"break":"none","ruby":[[11,1,"い"],[22,2,"きょうだい"],[31,1,"あく"],[48,1,"つみ"],[64,1,"いま"],[72,1,"ちち"],[74,1,"かみ"],[76,1,"つか"],[103,2,"ことば"],[106,1,"き"],[109,1,"な"]],"text":"『おまえたちはヨセフに言いなさい、「あなたの兄弟たちはあなたに悪をおこなったが、どうかそのとがと罪をゆるしてやってください」』。今どうかあなたの父の神に仕えるしもべらのとがをゆるしてください」。ヨセフはこの言葉を聞いて泣いた。"},{"ref":"Gen.50.18","start":1050018,"end":1050018,"break":"none","ruby":[[3,2,"きょうだい"],[11,1,"かれ"],[13,1,"まえ"],[15,1,"ふ"],[18,1,"い"]],"text":"やがて兄弟たちもきて、彼の前に伏して言った、「このとおり、わたしたちはあなたのしもべです」。"},{"ref":"Gen.50.19","start":1050019,"end":1050019,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[12,1,"おそ"],[28,1,"かみ"],[30,1,"かわ"]],"text":"ヨセフは彼らに言った、「恐れることはいりません。わたしが神に代ることができましょうか。"},{"ref":"Gen.50.20","start":1050020,"end":1050020,"break":"none","ruby":[[10,1,"たい"],[13,1,"あく"],[22,1,"かみ"],[27,1,"よ"],[30,1,"かわ"],[35,2,"こんにち"],[41,1,"おお"],[44,1,"たみ"],[46,1,"いのち"],[48,1,"すく"],[52,1,"はか"]],"text":"あなたがたはわたしに対して悪をたくらんだが、神はそれを良きに変らせて、今日のように多くの民の命を救おうと計らわれました。"},{"ref":"Gen.50.21","start":1050021,"end":1050021,"break":"none","ruby":[[4,1,"おそ"],[32,2,"こども"],[37,1,"やしな"],[45,1,"かれ"],[47,1,"かれ"],[50,1,"なぐさ"],[54,2,"しんせつ"],[57,1,"かた"]],"text":"それゆえ恐れることはいりません。わたしはあなたがたとあなたがたの子供たちを養いましょう」。彼は彼らを慰めて、親切に語った。"},{"ref":"Gen.50.22","start":1050022,"end":1050022,"break":"paragraph","ruby":[[11,1,"ちち"],[13,2,"かぞく"],[16,1,"とも"],[23,1,"す"],[36,1,"ねん"],[37,1,"い"]],"text":"このようにしてヨセフは父の家族と共にエジプトに住んだ。そしてヨセフは百十年生きながらえた。"},{"ref":"Gen.50.23","start":1050023,"end":1050023,"break":"none","ruby":[[11,1,"だい"],[13,2,"しそん"],[16,1,"み"],[23,1,"こ"],[28,1,"こ"],[31,1,"うま"],[41,1,"うえ"],[43,1,"お"]],"text":"ヨセフはエフライムの三代の子孫を見た。マナセの子マキルの子らも生れてヨセフのひざの上に置かれた。"},{"ref":"Gen.50.24","start":1050024,"end":1050024,"break":"none","ruby":[[4,2,"きょうだい"],[9,1,"い"],[21,1,"し"],[26,1,"かみ"],[28,1,"かなら"],[36,1,"かえり"],[42,1,"くに"],[45,1,"つ"],[47,1,"だ"],[64,1,"ちか"],[68,1,"ち"],[70,1,"みちび"],[72,1,"のぼ"]],"text":"ヨセフは兄弟たちに言った、「わたしはやがて死にます。神は必ずあなたがたを顧みて、この国から連れ出し、アブラハム、イサク、ヤコブに誓われた地に導き上られるでしょう」。"},{"ref":"Gen.50.25","start":1050025,"end":1050025,"break":"none","ruby":[[9,1,"かみ"],[11,1,"かなら"],[19,1,"かえり"],[27,1,"とき"],[39,1,"ほね"],[45,1,"たずさ"],[47,1,"のぼ"],[54,1,"い"],[63,1,"こ"],[66,1,"ちか"]],"text":"さらにヨセフは、「神は必ずあなたがたを顧みられる。その時、あなたがたはわたしの骨をここから携え上りなさい」と言ってイスラエルの子らに誓わせた。"},{"ref":"Gen.50.26","start":1050026,"end":1050026,"break":"none","ruby":[[10,1,"さい"],[12,1,"し"],[16,1,"かれ"],[22,1,"くすり"],[24,1,"ぬ"],[27,1,"かん"],[29,1,"おさ"],[38,1,"お"]],"text":"こうしてヨセフは百十歳で死んだ。彼らはこれに薬を塗り、棺に納めて、エジプトに置いた。"}]