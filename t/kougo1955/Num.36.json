[{"ref":"Num.36.1","start":4036001,"end":4036001,"break":"paragraph","ruby":[[4,2,"しそん"],[7,2,"しぞく"],[17,1,"こ"],[22,1,"こ"],[31,1,"こ"],[34,2,"しぞく"],[56,2,"ひとびと"],[72,1,"まえ"],[74,1,"かた"]],"text":"ヨセフの子孫の氏族のうち、マナセの子マキルの子であるギレアデの子らの氏族のかしらたちがきて、モーセとイスラエルの人々のかしらであるつかさたちとの前で語って、"},{"ref":"Num.36.2","start":4036002,"end":4036002,"break":"none","ruby":[[0,1,"い"],[11,2,"ひとびと"],[17,1,"し"],[18,1,"ぎょう"],[20,1,"ち"],[28,1,"あた"],[34,1,"しゅ"],[40,1,"めい"],[57,2,"きょうだい"],[65,1,"し"],[66,1,"ぎょう"],[71,1,"むすめ"],[75,1,"あた"],[81,1,"しゅ"],[86,1,"めい"]],"text":"言った、「イスラエルの人々に、その嗣業の地をくじによって与えることを主はあなたに命じられ、あなたもまた、われわれの兄弟ゼロペハデの嗣業を、その娘たちに与えるよう、主によって命じられました。"},{"ref":"Num.36.3","start":4036003,"end":4036003,"break":"none","ruby":[[2,1,"むすめ"],[15,2,"ひとびと"],[21,1,"た"],[23,2,"ぶぞく"],[39,2,"かのじょ"],[44,1,"し"],[45,1,"ぎょう"],[53,2,"ふそ"],[56,1,"し"],[57,1,"ぎょう"],[63,1,"す"],[65,1,"のぞ"],[75,2,"ぶぞく"],[78,1,"し"],[79,1,"ぎょう"],[81,1,"くわ"],[103,1,"し"],[104,1,"ぎょう"],[106,1,"ぶん"],[109,1,"す"],[111,1,"のぞ"]],"text":"その娘たちがもし、イスラエルの人々のうちの他の部族のむすこたちにとつぐならば、彼女たちの嗣業は、われわれの父祖の嗣業のうちから取り除かれて、そのとつぐ部族の嗣業に加えられるでしょう。こうしてそれはわれわれの嗣業の分から取り除かれるでしょう。"},{"ref":"Num.36.4","start":4036004,"end":4036004,"break":"none","ruby":[[9,2,"ひとびと"],[16,1,"とし"],[20,1,"とき"],[22,2,"かのじょ"],[27,1,"し"],[28,1,"ぎょう"],[37,2,"ぶぞく"],[40,1,"し"],[41,1,"ぎょう"],[43,1,"くわ"],[57,2,"かのじょ"],[62,1,"し"],[63,1,"ぎょう"],[71,2,"ふそ"],[74,2,"ぶぞく"],[77,1,"し"],[78,1,"ぎょう"],[84,1,"す"],[86,1,"のぞ"]],"text":"そしてイスラエルの人々のヨベルの年がきた時、彼女たちの嗣業は、そのとついだ部族の嗣業に加えられるでしょう。こうして彼女たちの嗣業は、われわれの父祖の部族の嗣業のうちから取り除かれるでしょう」。"},{"ref":"Num.36.5","start":4036005,"end":4036005,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,2,"ことば"],[21,2,"ひとびと"],[24,1,"めい"],[27,1,"い"],[36,2,"しそん"],[39,2,"ぶぞく"],[42,1,"い"],[48,1,"ただ"]],"text":"モーセは主の言葉にしたがって、イスラエルの人々に命じて言った、「ヨセフの子孫の部族の言うところは正しい。"},{"ref":"Num.36.6","start":4036006,"end":4036006,"break":"none","ruby":[[6,1,"むすめ"],[14,1,"しゅ"],[16,1,"めい"],[35,2,"かのじょ"],[42,1,"こころ"],[47,1,"もの"],[62,2,"ふそ"],[65,2,"ぶぞく"],[68,2,"いちぞく"]],"text":"ゼロペハデの娘たちについて、主が命じられたことはこうである。すなわち『彼女たちはその心にかなう者にとついでもよいが、ただその父祖の部族の一族にのみ、とつがなければならない。"},{"ref":"Num.36.7","start":4036007,"end":4036007,"break":"none","ruby":[[11,2,"ひとびと"],[14,1,"し"],[15,1,"ぎょう"],[18,2,"ぶぞく"],[22,2,"ぶぞく"],[25,1,"うつ"],[46,2,"ひとびと"],[56,2,"ふそ"],[59,2,"ぶぞく"],[62,1,"し"],[63,1,"ぎょう"],[68,1,"たも"]],"text":"そうすればイスラエルの人々の嗣業は、部族から部族に移るようなことはないであろう。イスラエルの人々は、おのおのその父祖の部族の嗣業をかたく保つべきだからである。"},{"ref":"Num.36.8","start":4036008,"end":4036008,"break":"none","ruby":[[6,2,"ひとびと"],[9,2,"ぶぞく"],[15,1,"し"],[16,1,"ぎょう"],[23,1,"むすめ"],[30,1,"ちち"],[32,2,"ぶぞく"],[35,1,"ぞく"],[38,2,"いちぞく"],[64,2,"ひとびと"],[74,2,"ふそ"],[77,1,"し"],[78,1,"ぎょう"],[80,1,"たも"]],"text":"イスラエルの人々の部族のうち、嗣業をもっている娘はみな、その父の部族に属する一族にとつがなければならない。そうすればイスラエルの人々は、おのおのその父祖の嗣業を保つことができる。"},{"ref":"Num.36.9","start":4036009,"end":4036009,"break":"none","ruby":[[4,1,"し"],[5,1,"ぎょう"],[10,2,"ぶぞく"],[14,1,"た"],[16,2,"ぶぞく"],[19,1,"うつ"],[35,2,"ひとびと"],[38,2,"ぶぞく"],[47,1,"し"],[48,1,"ぎょう"],[53,1,"たも"]],"text":"こうして嗣業は一つの部族から他の部族に移ることはなかろう。イスラエルの人々の部族はおのおのその嗣業をかたく保つべきだからである』」。"},{"ref":"Num.36.10","start":4036010,"end":4036010,"break":"paragraph","ruby":[[9,1,"むすめ"],[14,1,"しゅ"],[20,1,"めい"]],"text":"そこでゼロペハデの娘たちは、主がモーセに命じられたようにした。"},{"ref":"Num.36.11","start":4036011,"end":4036011,"break":"none","ruby":[[10,1,"むすめ"],[38,1,"ちち"],[40,2,"きょうだい"]],"text":"すなわちゼロペハデの娘たち、マアラ、テルザ、ホグラ、ミルカおよびノアは、その父の兄弟のむすこたちにとついだ。"},{"ref":"Num.36.12","start":4036012,"end":4036012,"break":"none","ruby":[[0,2,"かのじょ"],[9,1,"こ"],[20,2,"いちぞく"],[32,1,"し"],[33,1,"ぎょう"],[37,1,"ちち"],[39,2,"いちぞく"],[42,1,"ぞく"],[45,2,"ぶぞく"]],"text":"彼女たちはヨセフの子マナセのむすこたちの一族にとついだので、その嗣業はその父の一族の属する部族にとどまった。"},{"ref":"Num.36.13","start":4036013,"end":4036013,"break":"paragraph","ruby":[[8,1,"ちか"],[23,2,"へいや"],[27,1,"しゅ"],[42,2,"ひとびと"],[45,1,"めい"],[50,2,"めいれい"]],"text":"これらはエリコに近いヨルダンのほとりのモアブの平野で、主がモーセによってイスラエルの人々に命じられた命令とおきてである。"}]