[{"ref":"Josh.1.1","start":6001001,"end":6001001,"break":"paragraph","ruby":[[0,1,"しゅ"],[9,1,"し"],[12,1,"のち"],[14,1,"しゅ"],[20,2,"じゅうしゃ"],[26,1,"こ"],[32,1,"い"]],"text":"主のしもべモーセが死んだ後、主はモーセの従者、ヌンの子ヨシュアに言われた、"},{"ref":"Josh.1.2","start":6001002,"end":6001002,"break":"none","ruby":[[12,1,"し"],[21,1,"いま"],[33,1,"たみ"],[37,1,"とも"],[39,1,"た"],[50,1,"わた"],[63,2,"ひとびと"],[66,1,"あた"],[69,1,"ち"],[71,1,"い"]],"text":"「わたしのしもべモーセは死んだ。それゆえ、今あなたと、このすべての民とは、共に立って、このヨルダンを渡り、わたしがイスラエルの人々に与える地に行きなさい。"},{"ref":"Josh.1.3","start":6001003,"end":6001003,"break":"none","ruby":[[7,1,"あし"],[9,1,"うら"],[11,1,"ふ"],[13,1,"ところ"],[26,2,"やくそく"],[40,1,"あた"]],"text":"あなたがたが、足の裏で踏む所はみな、わたしがモーセに約束したように、あなたがたに与えるであろう。"},{"ref":"Josh.1.4","start":6001004,"end":6001004,"break":"none","ruby":[[6,2,"りょういき"],[10,2,"あらの"],[19,1,"およ"],[24,2,"おおかわ"],[37,1,"ぜん"],[38,1,"ち"],[44,1,"ひ"],[46,1,"い"],[48,1,"ほう"],[50,2,"たいかい"],[53,1,"たっ"]],"text":"あなたがたの領域は、荒野からレバノンに及び、また大川ユフラテからヘテびとの全地にわたり、日の入る方の大海に達するであろう。"},{"ref":"Josh.1.5","start":6001005,"end":6001005,"break":"none","ruby":[[4,1,"い"],[11,1,"ひ"],[13,1,"あいだ"],[19,1,"あた"],[27,1,"もの"],[50,1,"とも"],[62,1,"とも"],[79,2,"みはな"],[86,2,"みすて"]],"text":"あなたが生きながらえる日の間、あなたに当ることのできる者は、ひとりもないであろう。わたしは、モーセと共にいたように、あなたと共におるであろう。わたしはあなたを見放すことも、見捨ることもしない。"},{"ref":"Josh.1.6","start":6001006,"end":6001006,"break":"none","ruby":[[0,1,"つよ"],[5,2,"おお"],[18,1,"たみ"],[25,1,"かれ"],[28,1,"あた"],[35,2,"せんぞ"],[40,1,"ちか"],[43,1,"ち"],[45,1,"え"]],"text":"強く、また雄々しくあれ。あなたはこの民に、わたしが彼らに与えると、その先祖たちに誓った地を獲させなければならない。"},{"ref":"Josh.1.7","start":6001007,"end":6001007,"break":"none","ruby":[[2,1,"つよ"],[7,2,"おお"],[30,1,"めい"],[33,2,"りっぽう"],[41,1,"まも"],[44,1,"おこな"],[50,1,"はな"],[53,1,"みぎ"],[56,1,"ひだり"],[59,1,"まが"],[78,1,"い"],[85,2,"しょうり"],[88,1,"え"]],"text":"ただ強く、また雄々しくあって、わたしのしもべモーセがあなたに命じた律法をことごとく守って行い、これを離れて右にも左にも曲ってはならない。それはすべてあなたが行くところで、勝利を得るためである。"},{"ref":"Josh.1.8","start":6001008,"end":6001008,"break":"none","ruby":[[2,2,"りっぽう"],[5,1,"しょ"],[11,1,"くち"],[14,1,"はな"],[21,1,"ひる"],[23,1,"よる"],[28,1,"おも"],[52,1,"まも"],[55,1,"おこな"],[78,1,"みち"],[80,1,"さか"],[87,2,"しょうり"],[90,1,"え"]],"text":"この律法の書をあなたの口から離すことなく、昼も夜もそれを思い、そのうちにしるされていることを、ことごとく守って行わなければならない。そうするならば、あなたの道は栄え、あなたは勝利を得るであろう。"},{"ref":"Josh.1.9","start":6001009,"end":6001009,"break":"none","ruby":[[8,1,"めい"],[17,1,"つよ"],[22,2,"おお"],[36,1,"い"],[45,1,"かみ"],[47,1,"しゅ"],[49,1,"とも"],[58,1,"おそ"]],"text":"わたしはあなたに命じたではないか。強く、また雄々しくあれ。あなたがどこへ行くにも、あなたの神、主が共におられるゆえ、恐れてはならない、おののいてはならない」。"},{"ref":"Josh.1.10","start":6001010,"end":6001010,"break":"paragraph","ruby":[[8,1,"たみ"],[16,1,"めい"],[19,1,"い"]],"text":"そこでヨシュアは民のつかさたちに命じて言った、"},{"ref":"Josh.1.11","start":6001011,"end":6001011,"break":"none","ruby":[[1,2,"しゅくえい"],[7,1,"めぐ"],[10,1,"たみ"],[12,1,"めい"],[15,1,"い"],[22,2,"りょうしょく"],[25,1,"そな"],[34,1,"か"],[53,1,"わた"],[63,1,"かみ"],[65,1,"しゅ"],[73,1,"あた"],[76,1,"え"],[85,1,"ち"],[87,1,"え"],[93,1,"すす"],[95,1,"い"]],"text":"「宿営のなかを巡って民に命じて言いなさい、『糧食の備えをしなさい。三日のうちに、あなたがたはこのヨルダンを渡って、あなたがたの神、主があなたがたに与えて獲させようとされる地を獲るために、進み行かなければならないからである』」。"},{"ref":"Josh.1.12","start":6001012,"end":6001012,"break":"paragraph","ruby":[[25,1,"はん"],[26,2,"ぶぞく"],[29,1,"い"]],"text":"ヨシュアはまたルベンびと、ガドびと、およびマナセの半部族に言った、"},{"ref":"Josh.1.13","start":6001013,"end":6001013,"break":"none","ruby":[[1,1,"しゅ"],[16,1,"めい"],[27,1,"かみ"],[29,1,"しゅ"],[40,2,"あんそく"],[43,2,"ばしょ"],[46,1,"そな"],[51,1,"ち"],[59,1,"たま"],[68,1,"い"],[71,2,"ことば"],[74,2,"きおく"]],"text":"「主のしもべモーセがあなたがたに命じて、『あなたがたの神、主はあなたがたのために安息の場所を備え、この地をあなたがたに賜わるであろう』と言った言葉を記憶しなさい。"},{"ref":"Josh.1.14","start":6001014,"end":6001014,"break":"none","ruby":[[6,2,"さいし"],[9,2,"かちく"],[24,1,"あた"],[35,1,"がわ"],[37,1,"ち"],[65,2,"ゆうし"],[70,2,"ぶそう"],[75,2,"きょうだい"],[80,1,"さき"],[82,1,"た"],[85,1,"わた"],[91,1,"たす"]],"text":"あなたがたの妻子と家畜とは、モーセがあなたがたに与えたヨルダンのこちら側の地にとどまらなければならない。しかし、あなたがたのうちの勇士はみな武装して、兄弟たちの先に立って渡り、これを助けなければならない。"},{"ref":"Josh.1.15","start":6001015,"end":6001015,"break":"none","ruby":[[3,1,"しゅ"],[11,1,"たま"],[25,2,"きょうだい"],[31,2,"あんそく"],[34,1,"たま"],[38,1,"かれ"],[47,1,"かみ"],[49,1,"しゅ"],[51,1,"たま"],[54,1,"ち"],[56,1,"え"],[74,1,"しゅ"],[84,1,"あた"],[98,1,"がわ"],[100,1,"ひ"],[102,1,"で"],[104,1,"ほう"],[115,2,"しょゆう"],[118,1,"ち"],[120,1,"かえ"],[127,1,"たも"]],"text":"そして主があなたがたに賜わったように、あなたがたの兄弟たちにも安息を賜わり、彼らもあなたがたの神、主が賜わる地を獲るようになるならば、あなたがたは、主のしもべモーセから与えられた、ヨルダンのこちら側、日の出の方にある、あなたがたの所有の地に帰って、それを保つことができるであろう」。"},{"ref":"Josh.1.16","start":6001016,"end":6001016,"break":"none","ruby":[[0,1,"かれ"],[8,1,"こた"],[22,1,"めい"],[32,1,"おこな"],[47,1,"ところ"],[56,1,"い"]],"text":"彼らはヨシュアに答えた、「あなたがわれわれに命じられたことをみな行います。あなたがつかわされる所へは、どこへでも行きます。"},{"ref":"Josh.1.17","start":6001017,"end":6001017,"break":"none","ruby":[[16,1,"き"],[18,1,"したが"],[29,1,"き"],[31,1,"したが"],[47,1,"かみ"],[49,1,"しゅ"],[55,1,"とも"],[69,1,"とも"]],"text":"われわれはすべてのことをモーセに聞き従ったように、あなたに聞き従います。ただ、どうぞ、あなたの神、主がモーセと共におられたように、あなたと共におられますように。"},{"ref":"Josh.1.18","start":6001018,"end":6001018,"break":"none","ruby":[[12,2,"めいれい"],[23,1,"めい"],[28,2,"ことば"],[31,1,"き"],[33,1,"したが"],[44,1,"い"],[58,1,"つよ"],[63,2,"おお"]],"text":"だれであっても、あなたの命令にそむき、あなたの命じられる言葉に聞き従わないものがあれば、生かしてはおきません。ただ、強く、また雄々しくあってください」。"}]