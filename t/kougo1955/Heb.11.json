[{"ref":"Heb.11.1","start":58011001,"end":58011001,"break":"paragraph","ruby":[[3,2,"しんこう"],[8,1,"のぞ"],[13,1,"こと"],[17,2,"かくしん"],[23,1,"み"],[28,2,"じじつ"],[31,2,"かくにん"]],"text":"さて、信仰とは、望んでいる事がらを確信し、まだ見ていない事実を確認することである。"},{"ref":"Heb.11.2","start":58011002,"end":58011002,"break":"none","ruby":[[0,1,"むかし"],[2,1,"ひと"],[9,2,"しんこう"],[15,2,"しょうさん"]],"text":"昔の人たちは、この信仰のゆえに賞賛された。"},{"ref":"Heb.11.3","start":58011003,"end":58011003,"break":"none","ruby":[[0,2,"しんこう"],[16,1,"よ"],[19,1,"かみ"],[21,2,"ことば"],[24,1,"つく"],[39,1,"み"],[45,1,"あらわ"],[54,1,"で"],[66,1,"さと"]],"text":"信仰によって、わたしたちは、この世界が神の言葉で造られたのであり、したがって、見えるものは現れているものから出てきたのでないことを、悟るのである。"},{"ref":"Heb.11.4","start":58011004,"end":58011004,"break":"none","ruby":[[0,2,"しんこう"],[26,1,"かみ"],[32,2,"しんこう"],[38,1,"ぎ"],[41,1,"もの"],[43,1,"みと"],[49,1,"かみ"],[52,1,"かれ"],[54,1,"そな"],[56,1,"もの"],[70,1,"かれ"],[72,1,"し"],[77,2,"しんこう"],[83,1,"いま"],[87,1,"かた"]],"text":"信仰によって、アベルはカインよりもまさったいけにえを神にささげ、信仰によって義なる者と認められた。神が、彼の供え物をよしとされたからである。彼は死んだが、信仰によって今もなお語っている。"},{"ref":"Heb.11.5","start":58011005,"end":58011005,"break":"none","ruby":[[0,2,"しんこう"],[11,1,"し"],[13,1,"み"],[19,1,"てん"],[21,1,"うつ"],[26,1,"かみ"],[29,1,"うつ"],[38,1,"かれ"],[40,1,"み"],[48,1,"かれ"],[50,1,"うつ"],[54,1,"まえ"],[57,1,"かみ"],[59,1,"よろこ"],[63,1,"もの"]],"text":"信仰によって、エノクは死を見ないように天に移された。神がお移しになったので、彼は見えなくなった。彼が移される前に、神に喜ばれた者と、あかしされていたからである。"},{"ref":"Heb.11.6","start":58011006,"end":58011006,"break":"none","ruby":[[0,2,"しんこう"],[8,1,"かみ"],[10,1,"よろこ"],[27,1,"かみ"],[29,1,"く"],[31,1,"もの"],[34,1,"かみ"],[44,2,"じしん"],[47,1,"もと"],[50,1,"もの"],[52,1,"むく"],[55,1,"くだ"],[63,1,"かなら"],[65,1,"しん"]],"text":"信仰がなくては、神に喜ばれることはできない。なぜなら、神に来る者は、神のいますことと、ご自身を求める者に報いて下さることとを、必ず信じるはずだからである。"},{"ref":"Heb.11.7","start":58011007,"end":58011007,"break":"none","ruby":[[0,2,"しんこう"],[12,1,"み"],[17,1,"こと"],[24,1,"み"],[25,1,"つ"],[28,1,"う"],[31,1,"おそ"],[42,2,"かぞく"],[45,1,"すく"],[50,2,"はこぶね"],[53,1,"つく"],[58,2,"しんこう"],[64,1,"よ"],[66,1,"つみ"],[76,2,"しんこう"],[81,1,"ぎ"],[83,1,"う"],[85,1,"つ"],[87,1,"もの"]],"text":"信仰によって、ノアはまだ見ていない事がらについて御告げを受け、恐れかしこみつつ、その家族を救うために箱舟を造り、その信仰によって世の罪をさばき、そして、信仰による義を受け継ぐ者となった。"},{"ref":"Heb.11.8","start":58011008,"end":58011008,"break":"none","ruby":[[0,2,"しんこう"],[14,1,"う"],[16,1,"つ"],[20,1,"ち"],[22,1,"で"],[24,1,"い"],[28,1,"め"],[36,1,"とき"],[41,1,"したが"],[44,1,"ゆ"],[46,1,"さき"],[48,1,"し"],[53,1,"で"],[55,1,"い"]],"text":"信仰によって、アブラハムは、受け継ぐべき地に出て行けとの召しをこうむった時、それに従い、行く先を知らないで出て行った。"},{"ref":"Heb.11.9","start":58011009,"end":58011009,"break":"none","ruby":[[0,2,"しんこう"],[7,2,"たこく"],[17,2,"やくそく"],[20,1,"ち"],[22,1,"やど"],[25,1,"おな"],[27,2,"やくそく"],[30,1,"つ"],[40,1,"とも"],[43,2,"まくや"],[46,1,"す"]],"text":"信仰によって、他国にいるようにして約束の地に宿り、同じ約束を継ぐイサク、ヤコブと共に、幕屋に住んだ。"},{"ref":"Heb.11.10","start":58011010,"end":58011010,"break":"none","ruby":[[0,1,"かれ"],[7,2,"どだい"],[10,1,"うえ"],[12,1,"た"],[17,1,"みやこ"],[20,1,"ま"],[22,1,"のぞ"],[34,1,"みやこ"],[43,1,"た"],[49,1,"かみ"]],"text":"彼は、ゆるがぬ土台の上に建てられた都を、待ち望んでいたのである。その都をもくろみ、また建てたのは、神である。"},{"ref":"Heb.11.11","start":58011011,"end":58011011,"break":"none","ruby":[[0,2,"しんこう"],[13,2,"としお"],[21,1,"たね"],[23,1,"やど"],[25,1,"ちから"],[27,1,"あた"],[33,2,"やくそく"],[43,2,"しんじつ"],[50,1,"しん"]],"text":"信仰によって、サラもまた、年老いていたが、種を宿す力を与えられた。約束をなさったかたは真実であると、信じていたからである。"},{"ref":"Heb.11.12","start":58011012,"end":58011012,"break":"none","ruby":[[12,1,"し"],[16,2,"どうよう"],[19,1,"ひと"],[23,1,"てん"],[25,1,"ほし"],[31,1,"うみ"],[34,1,"かぞ"],[39,1,"すな"],[51,1,"ひと"],[53,1,"うま"]],"text":"このようにして、ひとりの死んだと同様な人から、天の星のように、海べの数えがたい砂のように、おびただしい人が生れてきたのである。"},{"ref":"Heb.11.13","start":58011013,"end":58011013,"break":"paragraph","ruby":[[4,1,"ひと"],[9,2,"しんこう"],[16,1,"し"],[22,2,"やくそく"],[28,1,"う"],[45,1,"のぞ"],[47,1,"み"],[49,1,"よろこ"],[56,2,"ちじょう"],[60,2,"たびびと"],[65,3,"きりゅうしゃ"],[75,1,"みずか"],[77,1,"い"]],"text":"これらの人はみな、信仰をいだいて死んだ。まだ約束のものは受けていなかったが、はるかにそれを望み見て喜び、そして、地上では旅人であり寄留者であることを、自ら言いあらわした。"},{"ref":"Heb.11.14","start":58011014,"end":58011014,"break":"none","ruby":[[2,1,"い"],[15,1,"かれ"],[23,1,"もと"],[31,1,"しめ"]],"text":"そう言いあらわすことによって、彼らがふるさとを求めていることを示している。"},{"ref":"Heb.11.15","start":58011015,"end":58011015,"break":"none","ruby":[[4,1,"で"],[8,1,"ところ"],[13,1,"かんが"],[21,1,"かえ"],[23,2,"きかい"]],"text":"もしその出てきた所のことを考えていたなら、帰る機会はあったであろう。"},{"ref":"Heb.11.16","start":58011016,"end":58011016,"break":"none","ruby":[[3,2,"じっさい"],[6,1,"かれ"],[9,1,"のぞ"],[20,1,"よ"],[23,1,"てん"],[39,1,"かみ"],[42,1,"かれ"],[45,1,"かみ"],[47,1,"よ"],[56,1,"はじ"],[66,2,"じじつ"],[69,1,"かみ"],[71,1,"かれ"],[78,1,"みやこ"],[80,2,"ようい"]],"text":"しかし実際、彼らが望んでいたのは、もっと良い、天にあるふるさとであった。だから神は、彼らの神と呼ばれても、それを恥とはされなかった。事実、神は彼らのために、都を用意されていたのである。"},{"ref":"Heb.11.17","start":58011017,"end":58011017,"break":"paragraph","ruby":[[0,2,"しんこう"],[14,2,"しれん"],[17,1,"う"],[37,2,"やくそく"],[40,1,"う"],[45,1,"かれ"],[53,1,"こ"]],"text":"信仰によって、アブラハムは、試錬を受けたとき、イサクをささげた。すなわち、約束を受けていた彼が、そのひとり子をささげたのである。"},{"ref":"Heb.11.18","start":58011018,"end":58011018,"break":"none","ruby":[[2,1,"こ"],[15,1,"で"],[17,1,"もの"],[24,2,"しそん"],[27,1,"よ"],[37,1,"い"]],"text":"この子については、「イサクから出る者が、あなたの子孫と呼ばれるであろう」と言われていたのであった。"},{"ref":"Heb.11.19","start":58011019,"end":58011019,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,2,"しにん"],[8,1,"なか"],[11,1,"ひと"],[20,1,"ちから"],[26,1,"しん"],[39,1,"かれ"],[50,1,"い"],[56,1,"わた"]],"text":"彼は、神が死人の中から人をよみがえらせる力がある、と信じていたのである。だから彼は、いわば、イサクを生きかえして渡されたわけである。"},{"ref":"Heb.11.20","start":58011020,"end":58011020,"break":"none","ruby":[[0,2,"しんこう"],[33,2,"しゅくふく"]],"text":"信仰によって、イサクは、きたるべきことについて、ヤコブとエサウとを祝福した。"},{"ref":"Heb.11.21","start":58011021,"end":58011021,"break":"none","ruby":[[0,2,"しんこう"],[11,1,"し"],[22,1,"こ"],[31,2,"しゅくふく"],[53,2,"れいはい"]],"text":"信仰によって、ヤコブは死のまぎわに、ヨセフの子らをひとりびとり祝福し、そしてそのつえのかしらによりかかって礼拝した。"},{"ref":"Heb.11.22","start":58011022,"end":58011022,"break":"none","ruby":[[0,2,"しんこう"],[13,2,"りんじゅう"],[23,1,"こ"],[26,1,"で"],[28,1,"ゆ"],[33,1,"おも"],[36,2,"じぶん"],[39,1,"ほね"]],"text":"信仰によって、ヨセフはその臨終に、イスラエルの子らの出て行くことを思い、自分の骨のことについてさしずした。"},{"ref":"Heb.11.23","start":58011023,"end":58011023,"break":"paragraph","ruby":[[0,2,"しんこう"],[11,1,"うま"],[17,2,"りょうしん"],[23,1,"げつ"],[28,1,"かれ"],[30,1,"かく"],[38,1,"かれ"],[41,2,"こども"],[51,1,"み"],[59,1,"かれ"],[65,1,"おう"],[67,2,"めいれい"],[71,1,"おそ"]],"text":"信仰によって、モーセの生れたとき、両親は、三か月のあいだ彼を隠した。それは、彼らが子供のうるわしいのを見たからである。彼らはまた、王の命令をも恐れなかった。"},{"ref":"Heb.11.24","start":58011024,"end":58011024,"break":"none","ruby":[[0,2,"しんこう"],[12,2,"せいじん"],[22,1,"むすめ"],[24,1,"こ"],[26,1,"い"],[33,1,"こば"]],"text":"信仰によって、モーセは、成人したとき、パロの娘の子と言われることを拒み、"},{"ref":"Heb.11.25","start":58011025,"end":58011025,"break":"none","ruby":[[0,1,"つみ"],[6,2,"かんらく"],[19,1,"かみ"],[21,1,"たみ"],[23,1,"とも"],[25,2,"ぎゃくたい"],[33,1,"えら"]],"text":"罪のはかない歓楽にふけるよりは、むしろ神の民と共に虐待されることを選び、"},{"ref":"Heb.11.26","start":58011026,"end":58011026,"break":"none","ruby":[[8,1,"う"],[21,1,"たから"],[26,1,"とみ"],[28,1,"かんが"],[36,1,"かれ"],[38,1,"むく"],[41,1,"のぞ"],[43,1,"み"]],"text":"キリストのゆえに受けるそしりを、エジプトの宝にまさる富と考えた。それは、彼が報いを望み見ていたからである。"},{"ref":"Heb.11.27","start":58011027,"end":58011027,"break":"none","ruby":[[0,2,"しんこう"],[7,1,"かれ"],[9,1,"おう"],[11,1,"いきどお"],[15,1,"おそ"],[24,1,"た"],[26,1,"さ"],[30,1,"かれ"],[33,1,"み"],[40,1,"み"],[50,1,"しの"]],"text":"信仰によって、彼は王の憤りをも恐れず、エジプトを立ち去った。彼は、見えないかたを見ているようにして、忍びとおした。"},{"ref":"Heb.11.28","start":58011028,"end":58011028,"break":"none","ruby":[[0,2,"しんこう"],[7,1,"ほろ"],[10,1,"もの"],[13,2,"ちょうし"],[17,1,"て"],[19,1,"くだ"],[30,1,"かれ"],[32,2,"すぎこし"],[35,1,"おこな"],[37,1,"ち"],[39,1,"ぬ"]],"text":"信仰によって、滅ぼす者が、長子らに手を下すことのないように、彼は過越を行い血を塗った。"},{"ref":"Heb.11.29","start":58011029,"end":58011029,"break":"none","ruby":[[0,2,"しんこう"],[7,2,"ひとびと"],[10,2,"こうかい"],[17,2,"とち"],[26,1,"わた"],[31,1,"おな"],[36,1,"くわだ"],[43,1,"じん"],[48,1,"し"]],"text":"信仰によって、人々は紅海をかわいた土地をとおるように渡ったが、同じことを企てたエジプト人はおぼれ死んだ。"},{"ref":"Heb.11.30","start":58011030,"end":58011030,"break":"none","ruby":[[0,2,"しんこう"],[11,2,"じょうへき"],[15,2,"なぬか"]],"text":"信仰によって、エリコの城壁は、七日にわたってまわったために、くずれおちた。"},{"ref":"Heb.11.31","start":58011031,"end":58011031,"break":"none","ruby":[[0,2,"しんこう"],[7,2,"ゆうじょ"],[14,1,"さぐ"],[19,1,"もの"],[28,1,"むか"],[34,1,"ふ"],[35,2,"じゅうじゅん"],[38,1,"もの"],[42,2,"いっしょ"],[45,1,"ほろ"]],"text":"信仰によって、遊女ラハブは、探りにきた者たちをおだやかに迎えたので、不従順な者どもと一緒に滅びることはなかった。"},{"ref":"Heb.11.32","start":58011032,"end":58011032,"break":"none","ruby":[[5,1,"なに"],[7,1,"い"],[40,1,"およ"],[42,3,"よげんしゃ"],[51,1,"かた"],[53,1,"だ"],[58,2,"じかん"],[61,1,"た"]],"text":"このほか、何を言おうか。もしギデオン、バラク、サムソン、エフタ、ダビデ、サムエル及び預言者たちについて語り出すなら、時間が足りないであろう。"},{"ref":"Heb.11.33","start":58011033,"end":58011033,"break":"none","ruby":[[0,1,"かれ"],[3,2,"しんこう"],[10,2,"くにぐに"],[13,2,"せいふく"],[17,1,"ぎ"],[19,1,"おこな"],[22,2,"やくそく"],[28,1,"う"],[34,1,"くち"]],"text":"彼らは信仰によって、国々を征服し、義を行い、約束のものを受け、ししの口をふさぎ、"},{"ref":"Heb.11.34","start":58011034,"end":58011034,"break":"none","ruby":[[0,1,"ひ"],[2,1,"いきお"],[5,1,"け"],[12,1,"は"],[18,1,"よわ"],[23,1,"つよ"],[28,1,"たたか"],[31,2,"ゆうしゃ"],[37,2,"たこく"],[40,1,"ぐん"],[42,1,"しりぞ"]],"text":"火の勢いを消し、つるぎの刃をのがれ、弱いものは強くされ、戦いの勇者となり、他国の軍を退かせた。"},{"ref":"Heb.11.35","start":58011035,"end":58011035,"break":"none","ruby":[[0,1,"おんな"],[7,2,"ししゃ"],[28,1,"もの"],[31,1,"さら"],[50,2,"ごうもん"],[53,1,"くる"],[57,1,"あま"],[61,2,"ほうめん"],[69,1,"ねが"]],"text":"女たちは、その死者たちをよみがえらさせてもらった。ほかの者は、更にまさったいのちによみがえるために、拷問の苦しみに甘んじ、放免されることを願わなかった。"},{"ref":"Heb.11.36","start":58011036,"end":58011036,"break":"none","ruby":[[5,1,"もの"],[18,1,"う"],[25,1,"あ"],[30,2,"とうごく"],[40,1,"あ"]],"text":"なおほかの者たちは、あざけられ、むち打たれ、しばり上げられ、投獄されるほどのめに会った。"},{"ref":"Heb.11.37","start":58011037,"end":58011037,"break":"none","ruby":[[5,1,"いし"],[7,1,"う"],[22,1,"ひ"],[30,1,"き"],[32,1,"ころ"],[36,1,"ひつじ"],[38,1,"かわ"],[44,1,"かわ"],[46,1,"き"],[48,1,"ある"],[54,3,"むいちもつ"],[61,1,"なや"],[66,1,"くる"]],"text":"あるいは、石で打たれ、さいなまれ、のこぎりで引かれ、つるぎで切り殺され、羊の皮や、やぎの皮を着て歩きまわり、無一物になり、悩まされ、苦しめられ、"},{"ref":"Heb.11.38","start":58011038,"end":58011038,"break":"none","ruby":[[3,1,"よ"],[5,1,"かれ"],[8,1,"す"],[10,1,"ところ"],[19,2,"あらの"],[22,1,"やま"],[24,1,"なか"],[26,1,"いわ"],[28,1,"あな"],[30,1,"つち"],[32,1,"あな"],[40,1,"つづ"]],"text":"（この世は彼らの住む所ではなかった）、荒野と山の中と岩の穴と土の穴とを、さまよい続けた。"},{"ref":"Heb.11.39","start":58011039,"end":58011039,"break":"paragraph","ruby":[[7,2,"ひとびと"],[13,2,"しんこう"],[27,2,"やくそく"],[33,1,"う"]],"text":"さて、これらの人々はみな、信仰によってあかしされたが、約束のものは受けなかった。"},{"ref":"Heb.11.40","start":58011040,"end":58011040,"break":"none","ruby":[[0,1,"かみ"],[15,1,"よ"],[25,1,"そな"],[28,1,"くだ"],[49,1,"かれ"],[52,1,"まっと"]],"text":"神はわたしたちのために、さらに良いものをあらかじめ備えて下さっているので、わたしたちをほかにしては彼らが全うされることはない。"}]