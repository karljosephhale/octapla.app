[{"ref":"Job.42.1","start":18042001,"end":18042001,"break":"paragraph","ruby":[[6,1,"しゅ"],[8,1,"こた"],[11,1,"い"]],"text":"そこでヨブは主に答えて言った、"},{"ref":"Job.42.2","start":18042002,"end":18042002,"break":"stanza","breaks":[[10,"line"],[28,"line"],[42,"line"]],"ruby":[[5,1,"し"],[18,1,"こと"]],"text":"「わたしは知ります、あなたはすべての事をなすことができ、またいかなるおぼしめしでも、あなたにできないことはないことを。"},{"ref":"Job.42.3","start":18042003,"end":18042003,"break":"line","breaks":[[17,"line"],[26,"line"],[48,"line"]],"ruby":[[1,2,"むち"],[7,1,"かみ"],[9,1,"はか"],[19,1,"もの"],[39,1,"さと"],[43,1,"こと"],[45,1,"い"],[52,1,"し"],[57,1,"はか"],[59,1,"がた"],[61,1,"こと"],[63,1,"の"]],"text":"『無知をもって神の計りごとをおおうこの者はだれか』。それゆえ、わたしはみずから悟らない事を言い、みずから知らない、測り難い事を述べました。"},{"ref":"Job.42.4","start":18042004,"end":18042004,"break":"line","breaks":[[12,"line"]],"ruby":[[1,1,"き"],[8,1,"かた"],[20,1,"たず"],[28,1,"こた"]],"text":"『聞け、わたしは語ろう、わたしはあなたに尋ねる、わたしに答えよ』。"},{"ref":"Job.42.5","start":18042005,"end":18042005,"break":"line","breaks":[[21,"line"]],"ruby":[[8,1,"こと"],[10,1,"みみ"],[12,1,"き"],[21,1,"いま"],[27,1,"め"],[33,2,"はいけん"]],"text":"わたしはあなたの事を耳で聞いていましたが、今はわたしの目であなたを拝見いたします。"},{"ref":"Job.42.6","start":18042006,"end":18042006,"break":"line","breaks":[[14,"line"]],"ruby":[[11,1,"うら"],[16,1,"はい"],[18,1,"なか"],[20,1,"く"]],"text":"それでわたしはみずから恨み、ちり灰の中で悔います」。"},{"ref":"Job.42.7","start":18042007,"end":18042007,"break":"none","breaks":[[33,"paragraph"]],"ruby":[[0,1,"しゅ"],[6,2,"ことば"],[12,1,"かた"],[16,1,"のち"],[28,1,"い"],[38,1,"いか"],[53,1,"とも"],[55,1,"む"],[59,1,"も"],[83,1,"ただ"],[86,1,"こと"],[95,1,"の"]],"text":"主はこれらの言葉をヨブに語られて後、テマンびとエリパズに言われた、「わたしの怒りはあなたとあなたのふたりの友に向かって燃える。あなたがたが、わたしのしもべヨブのように正しい事をわたしについて述べなかったからである。"},{"ref":"Job.42.8","start":18042008,"end":18042008,"break":"none","ruby":[[3,1,"いま"],[11,2,"おうし"],[14,1,"とう"],[16,2,"おひつじ"],[19,1,"とう"],[21,1,"と"],[35,1,"ところ"],[37,1,"い"],[49,2,"はんさい"],[76,1,"いの"],[87,1,"かれ"],[89,1,"いのり"],[91,1,"う"],[107,1,"おろ"],[110,1,"ばっ"],[139,1,"ただ"],[142,1,"こと"],[151,1,"の"]],"text":"それで今、あなたがたは雄牛七頭、雄羊七頭を取って、わたしのしもべヨブの所へ行き、あなたがたのために燔祭をささげよ。わたしのしもべヨブはあなたがたのために祈るであろう。わたしは彼の祈を受けいれるによって、あなたがたの愚かを罰することをしない。あなたがたはわたしのしもべヨブのように正しい事をわたしについて述べなかったからである」。"},{"ref":"Job.42.9","start":18042009,"end":18042009,"break":"paragraph","ruby":[[32,1,"い"],[36,1,"しゅ"],[38,1,"かれ"],[41,1,"めい"],[54,1,"しゅ"],[59,1,"いのり"],[61,1,"う"]],"text":"そこでテマンびとエリパズ、シュヒびとビルダデ、ナアマびとゾパルは行って、主が彼らに命じられたようにしたので、主はヨブの祈を受けいれられた。"},{"ref":"Job.42.10","start":18042010,"end":18042010,"break":"paragraph","ruby":[[5,2,"ゆうじん"],[13,1,"いの"],[19,1,"しゅ"],[24,2,"はんえい"],[37,1,"しゅ"],[46,2,"ざいさん"],[50,1,"ばい"],[52,1,"ま"]],"text":"ヨブがその友人たちのために祈ったとき、主はヨブの繁栄をもとにかえし、そして主はヨブのすべての財産を二倍に増された。"},{"ref":"Job.42.11","start":18042011,"end":18042011,"break":"none","ruby":[[3,1,"かれ"],[9,2,"きょうだい"],[16,2,"しまい"],[22,1,"かれ"],[24,2,"きゅうち"],[27,1,"もの"],[35,1,"かれ"],[40,1,"き"],[43,1,"かれ"],[45,1,"とも"],[49,1,"いえ"],[51,1,"の"],[53,1,"く"],[59,1,"しゅ"],[61,1,"かれ"],[72,1,"わざわい"],[77,1,"かれ"],[84,1,"なぐさ"],[91,1,"ぎん"],[97,1,"きん"],[99,1,"わ"],[103,1,"かれ"],[105,1,"おく"]],"text":"そこで彼のすべての兄弟、すべての姉妹、および彼の旧知の者どもことごとく彼のもとに来て、彼と共にその家で飲み食いし、かつ主が彼にくだされたすべての災について彼をいたわり、慰め、おのおの銀一ケシタと金の輪一つを彼に贈った。"},{"ref":"Job.42.12","start":18042012,"end":18042012,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"おわ"],[8,1,"はじ"],[13,1,"おお"],[15,1,"めぐ"],[20,1,"かれ"],[22,1,"ひつじ"],[27,1,"とう"],[34,1,"とう"],[36,1,"うし"],[43,1,"め"],[48,1,"とう"]],"text":"主はヨブの終りを初めよりも多く恵まれた。彼は羊一万四千頭、らくだ六千頭、牛一千くびき、雌ろば一千頭をもった。"},{"ref":"Job.42.13","start":18042013,"end":18042013,"break":"none","ruby":[[2,1,"かれ"],[4,1,"おとこ"],[6,1,"こ"],[8,1,"にん"],[10,1,"おんな"],[12,1,"こ"],[14,1,"にん"]],"text":"また彼は男の子七人、女の子三人をもった。"},{"ref":"Job.42.14","start":18042014,"end":18042014,"break":"none","ruby":[[0,1,"かれ"],[4,1,"だい"],[7,1,"むすめ"],[13,1,"な"],[17,1,"だい"],[24,1,"な"],[28,1,"だい"],[40,1,"な"]],"text":"彼はその第一の娘をエミマと名づけ、第二をケジアと名づけ、第三をケレン・ハップクと名づけた。"},{"ref":"Job.42.15","start":18042015,"end":18042015,"break":"none","ruby":[[0,2,"ぜんこく"],[9,1,"むすめ"],[14,1,"うつく"],[17,1,"おんな"],[24,1,"ちち"],[28,2,"きょうだい"],[33,2,"どうよう"],[36,1,"し"],[37,1,"ぎょう"],[39,1,"かれ"],[43,1,"あた"]],"text":"全国のうちでヨブの娘たちほど美しい女はなかった。父はその兄弟たちと同様に嗣業を彼らにも与えた。"},{"ref":"Job.42.16","start":18042016,"end":18042016,"break":"none","ruby":[[2,1,"のち"],[10,1,"ねん"],[11,1,"い"],[21,1,"こ"],[25,1,"まご"],[28,1,"だい"],[32,1,"み"]],"text":"この後、ヨブは百四十年生きながらえて、その子とその孫と四代までを見た。"},{"ref":"Job.42.17","start":18042017,"end":18042017,"break":"none","ruby":[[3,2,"としお"],[7,1,"ひ"],[8,1,"み"],[11,1,"し"]],"text":"ヨブは年老い、日満ちて死んだ。"}]