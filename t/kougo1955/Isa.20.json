[{"ref":"Isa.20.1","start":23020001,"end":23020001,"break":"paragraph","ruby":[[6,1,"おう"],[19,2,"さいこう"],[21,2,"しれい"],[23,1,"かん"],[30,1,"き"],[36,1,"せ"],[42,1,"と"],[45,1,"ねん"]],"text":"アッスリヤの王サルゴンからつかわされた最高司令官がアシドドに来て、これを攻め、これを取った年、――"},{"ref":"Isa.20.2","start":23020002,"end":23020002,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[10,1,"こ"],[18,1,"かた"],[21,1,"い"],[34,1,"こし"],[37,2,"あらぬの"],[40,1,"と"],[43,1,"あし"],[49,1,"ぬ"],[70,1,"はだか"],[76,1,"ある"]],"text":"その時に主はアモツの子イザヤによって語って言われた、「さあ、あなたの腰から荒布を解き、足からくつを脱ぎなさい」。そこでイザヤはそのようにし、裸、はだしで歩いた。――"},{"ref":"Isa.20.3","start":23020003,"end":23020003,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[18,1,"ねん"],[20,1,"あいだ"],[22,1,"はだか"],[28,1,"ある"],[42,1,"たい"],[52,1,"まえ"]],"text":"主は言われた、「わがしもべイザヤは三年の間、裸、はだしで歩き、エジプトとエチオピヤに対するしるしとなり、前ぶれとなったが、"},{"ref":"Isa.20.4","start":23020004,"end":23020004,"break":"none","ruby":[[24,1,"とら"],[27,1,"びと"],[37,1,"おう"],[39,1,"ひ"],[41,1,"い"],[48,1,"わか"],[50,1,"もの"],[52,1,"お"],[55,1,"もの"],[59,1,"はだか"],[79,1,"はじ"],[81,1,"しめ"]],"text":"このようにエジプトびとのとりことエチオピヤびとの捕われ人とは、アッスリヤの王に引き行かれて、その若い者も老いた者もみな裸、はだしで、しりをあらわし、エジプトの恥を示す。"},{"ref":"Isa.20.5","start":23020005,"end":23020005,"break":"none","ruby":[[0,1,"かれ"],[5,1,"たの"],[22,1,"ほこり"],[34,1,"おそ"],[39,1,"は"]],"text":"彼らはその頼みとしたエチオピヤのゆえに、その誇としたエジプトのゆえに恐れ、かつ恥じる。"},{"ref":"Isa.20.6","start":23020006,"end":23020006,"break":"none","ruby":[[2,1,"ひ"],[8,1,"うみ"],[11,1,"す"],[13,1,"たみ"],[15,1,"い"],[19,1,"み"],[27,1,"たの"],[32,1,"くに"],[47,1,"い"],[50,1,"たす"],[53,1,"もと"],[61,1,"おう"],[64,1,"すく"],[66,1,"だ"],[74,1,"くに"]],"text":"その日には、この海べに住む民は言う、『見よ、われわれが頼みとした国、すなわちわれわれがのがれて行って助けを求め、アッスリヤ王から救い出されようとした国はすでにこのとおりである。われわれはどうしてのがれることができようか』と。」"}]