[{"ref":"1Cor.14.1","start":46014001,"end":46014001,"break":"paragraph","ruby":[[0,1,"あい"],[2,1,"お"],[4,1,"もと"],[13,1,"れい"],[15,2,"たまもの"],[22,2,"よげん"],[30,2,"ねっしん"],[33,1,"もと"]],"text":"愛を追い求めなさい。また、霊の賜物を、ことに預言することを、熱心に求めなさい。"},{"ref":"1Cor.14.2","start":46014002,"end":46014002,"break":"none","ruby":[[0,2,"いげん"],[3,1,"かた"],[5,1,"もの"],[8,1,"ひと"],[14,1,"かた"],[22,1,"かみ"],[28,1,"かた"],[48,1,"かれ"],[53,1,"れい"],[58,2,"おくぎ"],[61,1,"かた"]],"text":"異言を語る者は、人にむかって語るのではなく、神にむかって語るのである。それはだれにもわからない。彼はただ、霊によって奥義を語っているだけである。"},{"ref":"1Cor.14.3","start":46014003,"end":46014003,"break":"none","ruby":[[3,2,"よげん"],[8,1,"もの"],[11,1,"ひと"],[13,1,"かた"],[18,1,"とく"],[20,1,"たか"],[23,1,"かれ"],[25,1,"はげ"],[29,1,"なぐさ"]],"text":"しかし預言をする者は、人に語ってその徳を高め、彼を励まし、慰めるのである。"},{"ref":"1Cor.14.4","start":46014004,"end":46014004,"break":"none","ruby":[[0,2,"いげん"],[3,1,"かた"],[5,1,"もの"],[7,2,"じぶん"],[12,1,"とく"],[14,1,"たか"],[19,2,"よげん"],[24,1,"もの"],[26,2,"きょうかい"],[29,1,"とく"],[31,1,"たか"]],"text":"異言を語る者は自分だけの徳を高めるが、預言をする者は教会の徳を高める。"},{"ref":"1Cor.14.5","start":46014005,"end":46014005,"break":"none","ruby":[[4,2,"じっさい"],[16,1,"のこ"],[19,2,"いげん"],[22,1,"かた"],[27,1,"のぞ"],[31,1,"とく"],[33,2,"よげん"],[44,2,"きょうかい"],[47,1,"とく"],[49,1,"たか"],[55,2,"いげん"],[58,1,"と"],[62,1,"かぎ"],[65,2,"いげん"],[68,1,"かた"],[70,1,"もの"],[75,2,"よげん"],[80,1,"もの"],[82,1,"ほう"]],"text":"わたしは実際、あなたがたがひとり残らず異言を語ることを望むが、特に預言をしてもらいたい。教会の徳を高めるように異言を解かない限り、異言を語る者よりも、預言をする者の方がまさっている。"},{"ref":"1Cor.14.6","start":46014006,"end":46014006,"break":"paragraph","ruby":[[4,2,"きょうだい"],[23,1,"ところ"],[25,1,"い"],[28,2,"いげん"],[31,1,"かた"],[38,2,"けいじ"],[41,2,"ちしき"],[44,2,"よげん"],[47,1,"おしえ"],[50,1,"かた"],[67,1,"やく"],[69,1,"た"]],"text":"だから、兄弟たちよ。たといわたしがあなたがたの所に行って異言を語るとしても、啓示か知識か預言か教かを語らなければ、あなたがたに、なんの役に立つだろうか。"},{"ref":"1Cor.14.7","start":46014007,"end":46014007,"break":"none","ruby":[[3,1,"ふえ"],[5,2,"たてごと"],[11,2,"がっき"],[20,1,"おと"],[22,2,"へんか"],[30,1,"なに"],[32,1,"ふ"],[40,1,"ひ"],[52,1,"し"]],"text":"また、笛や立琴のような楽器でも、もしその音に変化がなければ、何を吹いているのか、弾いているのか、どうして知ることができようか。"},{"ref":"1Cor.14.8","start":46014008,"end":46014008,"break":"none","ruby":[[15,1,"おと"],[17,1,"だ"],[27,2,"せんとう"],[30,2,"じゅんび"]],"text":"また、もしラッパがはっきりした音を出さないなら、だれが戦闘の準備をするだろうか。"},{"ref":"1Cor.14.9","start":46014009,"end":46014009,"break":"none","ruby":[[3,2,"どうよう"],[15,2,"いげん"],[25,2,"ことば"],[28,1,"かた"],[38,1,"かた"],[56,1,"くう"],[62,1,"かた"]],"text":"それと同様に、もしあなたがたが異言ではっきりしない言葉を語れば、どうしてその語ることがわかるだろうか。それでは、空にむかって語っていることになる。"},{"ref":"1Cor.14.10","start":46014010,"end":46014010,"break":"none","ruby":[[0,1,"よ"],[3,2,"たしゅ"],[5,2,"たよう"],[8,2,"ことば"],[18,2,"いみ"]],"text":"世には多種多様の言葉があるだろうが、意味のないものは一つもない。"},{"ref":"1Cor.14.11","start":46014011,"end":46014011,"break":"none","ruby":[[4,2,"ことば"],[7,2,"いみ"],[18,1,"かた"],[23,1,"ひと"],[34,3,"いこくじん"],[41,1,"かた"],[46,1,"ひと"],[57,3,"いこくじん"]],"text":"もしその言葉の意味がわからないなら、語っている人にとっては、わたしは異国人であり、語っている人も、わたしにとっては異国人である。"},{"ref":"1Cor.14.12","start":46014012,"end":46014012,"break":"none","ruby":[[11,1,"れい"],[13,2,"たまもの"],[16,2,"ねっしん"],[19,1,"もと"],[24,2,"いじょう"],[28,2,"きょうかい"],[31,1,"とく"],[33,1,"たか"],[43,1,"ゆた"],[53,1,"はげ"]],"text":"だから、あなたがたも、霊の賜物を熱心に求めている以上は、教会の徳を高めるために、それを豊かにいただくように励むがよい。"},{"ref":"1Cor.14.13","start":46014013,"end":46014013,"break":"paragraph","ruby":[[13,2,"いげん"],[16,1,"かた"],[18,1,"もの"],[21,2,"じぶん"],[27,1,"と"],[38,1,"いの"]],"text":"このようなわけであるから、異言を語る者は、自分でそれを解くことができるように祈りなさい。"},{"ref":"1Cor.14.14","start":46014014,"end":46014014,"break":"none","ruby":[[6,2,"いげん"],[12,1,"いの"],[21,1,"れい"],[23,1,"いの"],[27,2,"ちせい"],[30,1,"み"],[32,1,"むす"]],"text":"もしわたしが異言をもって祈るなら、わたしの霊は祈るが、知性は実を結ばないからである。"},{"ref":"1Cor.14.15","start":46014015,"end":46014015,"break":"none","ruby":[[18,1,"れい"],[20,1,"いの"],[23,1,"とも"],[26,2,"ちせい"],[30,1,"いのり"],[34,1,"れい"],[40,1,"うた"],[43,1,"とも"],[46,2,"ちせい"],[50,1,"うた"]],"text":"すると、どうしたらよいのか。わたしは霊で祈ると共に、知性でも祈ろう。霊でさんびを歌うと共に、知性でも歌おう。"},{"ref":"1Cor.14.16","start":46014016,"end":46014016,"break":"none","ruby":[[13,1,"れい"],[15,2,"しゅくふく"],[18,2,"ことば"],[21,1,"とな"],[26,3,"しょしんじゃ"],[30,1,"せき"],[34,1,"もの"],[41,2,"かんしゃ"],[44,1,"たい"],[57,1,"い"],[67,1,"なに"],[69,1,"い"],[77,1,"かれ"],[80,1,"つう"]],"text":"そうでないと、もしあなたが霊で祝福の言葉を唱えても、初心者の席にいる者は、あなたの感謝に対して、どうしてアァメンと言えようか。あなたが何を言っているのか、彼には通じない。"},{"ref":"1Cor.14.17","start":46014017,"end":46014017,"break":"none","ruby":[[0,2,"かんしゃ"],[6,2,"けっこう"],[18,1,"ひと"],[20,1,"とく"],[22,1,"たか"]],"text":"感謝するのは結構だが、それで、ほかの人の徳を高めることにはならない。"},{"ref":"1Cor.14.18","start":46014018,"end":46014018,"break":"none","ruby":[[19,1,"おお"],[21,2,"いげん"],[24,1,"かた"],[31,1,"かみ"],[33,2,"かんしゃ"]],"text":"わたしは、あなたがたのうちのだれよりも多く異言が語れることを、神に感謝する。"},{"ref":"1Cor.14.19","start":46014019,"end":46014019,"break":"none","ruby":[[3,2,"きょうかい"],[11,2,"ことば"],[14,2,"いげん"],[17,1,"かた"],[26,1,"ひと"],[31,1,"おし"],[44,2,"ことば"],[47,2,"ちせい"],[53,1,"かた"],[55,1,"ほう"],[57,1,"ねが"]],"text":"しかし教会では、一万の言葉を異言で語るよりも、ほかの人たちをも教えるために、むしろ五つの言葉を知性によって語る方が願わしい。"},{"ref":"1Cor.14.20","start":46014020,"end":46014020,"break":"paragraph","ruby":[[0,2,"きょうだい"],[6,1,"もの"],[8,1,"かんが"],[15,2,"こども"],[27,2,"あくじ"],[34,1,"おさ"],[36,1,"ご"],[46,1,"かんが"]],"text":"兄弟たちよ。物の考えかたでは、子供となってはいけない。悪事については幼な子となるのはよいが、考えかたでは、おとなとなりなさい。"},{"ref":"1Cor.14.21","start":46014021,"end":46014021,"break":"none","ruby":[[0,2,"りっぽう"],[5,1,"か"],[17,2,"いこく"],[20,1,"した"],[22,2,"いこく"],[34,1,"たみ"],[36,1,"かた"],[45,1,"かれ"],[52,1,"みみ"],[54,1,"かたむ"],[60,1,"しゅ"],[62,1,"おお"]],"text":"律法にこう書いてある、「わたしは、異国の舌と異国のくちびるとで、この民に語るが、それでも、彼らはわたしに耳を傾けない、と主が仰せになる」。"},{"ref":"1Cor.14.22","start":46014022,"end":46014022,"break":"none","ruby":[[6,2,"いげん"],[9,2,"しんじゃ"],[18,3,"みしんじゃ"],[33,2,"よげん"],[36,3,"みしんじゃ"],[46,2,"しんじゃ"]],"text":"このように、異言は信者のためではなく未信者のためのしるしであるが、預言は未信者のためではなく信者のためのしるしである。"},{"ref":"1Cor.14.23","start":46014023,"end":46014023,"break":"none","ruby":[[2,1,"ぜん"],[3,2,"きょうかい"],[6,2,"いっしょ"],[9,1,"あつ"],[14,2,"ぜんいん"],[17,2,"いげん"],[20,1,"かた"],[30,3,"しょしんじゃ"],[34,3,"ふしんじゃ"],[47,1,"かれ"],[56,2,"きちが"],[61,1,"い"]],"text":"もし全教会が一緒に集まって、全員が異言を語っているところに、初心者か不信者かがはいってきたら、彼らはあなたがたを気違いだと言うだろう。"},{"ref":"1Cor.14.24","start":46014024,"end":46014024,"break":"none","ruby":[[4,2,"ぜんいん"],[7,2,"よげん"],[19,3,"ふしんじゃ"],[23,3,"しょしんじゃ"],[35,1,"かれ"],[37,2,"りょうしん"],[44,1,"もの"],[46,1,"せ"],[55,1,"もの"]],"text":"しかし、全員が預言をしているところに、不信者か初心者がはいってきたら、彼の良心はみんなの者に責められ、みんなの者にさばかれ、"},{"ref":"1Cor.14.25","start":46014025,"end":46014025,"break":"none","ruby":[[2,1,"こころ"],[4,2,"ひみつ"],[14,2,"けっか"],[19,1,"ふ"],[22,1,"かみ"],[24,1,"おが"],[33,1,"かみ"],[49,2,"こくはく"],[54,1,"いた"]],"text":"その心の秘密があばかれ、その結果、ひれ伏して神を拝み、「まことに、神があなたがたのうちにいます」と告白するに至るであろう。"},{"ref":"1Cor.14.26","start":46014026,"end":46014026,"break":"paragraph","ruby":[[4,2,"きょうだい"],[26,2,"いっしょ"],[29,1,"あつ"],[32,1,"とき"],[34,2,"かくじ"],[41,1,"うた"],[44,1,"おしえ"],[49,2,"けいじ"],[52,1,"つ"],[55,2,"いげん"],[58,1,"かた"],[64,1,"と"],[76,1,"とく"],[78,1,"たか"]],"text":"すると、兄弟たちよ。どうしたらよいのか。あなたがたが一緒に集まる時、各自はさんびを歌い、教をなし、啓示を告げ、異言を語り、それを解くのであるが、すべては徳を高めるためにすべきである。"},{"ref":"1Cor.14.27","start":46014027,"end":46014027,"break":"none","ruby":[[2,2,"いげん"],[5,1,"かた"],[7,1,"もの"],[18,1,"おお"],[22,1,"にん"],[24,1,"もの"],[27,2,"じゅんじゅん"],[30,1,"かた"],[44,1,"と"]],"text":"もし異言を語る者があれば、ふたりか、多くて三人の者が、順々に語り、そして、ひとりがそれを解くべきである。"},{"ref":"1Cor.14.28","start":46014028,"end":46014028,"break":"none","ruby":[[2,1,"と"],[4,1,"もの"],[9,1,"とき"],[13,2,"きょうかい"],[17,1,"だま"],[23,2,"じぶん"],[26,1,"たい"],[30,1,"かみ"],[32,1,"たい"],[35,1,"かた"]],"text":"もし解く者がいない時には、教会では黙っていて、自分に対しまた神に対して語っているべきである。"},{"ref":"1Cor.14.29","start":46014029,"end":46014029,"break":"none","ruby":[[0,2,"よげん"],[5,1,"もの"],[7,2,"ばあい"],[17,1,"にん"],[20,1,"かた"],[26,1,"もの"],[31,2,"ぎんみ"]],"text":"預言をする者の場合にも、ふたりか三人かが語り、ほかの者はそれを吟味すべきである。"},{"ref":"1Cor.14.30","start":46014030,"end":46014030,"break":"none","ruby":[[4,1,"せき"],[8,1,"た"],[10,1,"もの"],[12,2,"けいじ"],[15,1,"う"],[18,2,"ばあい"],[23,1,"はじ"],[26,1,"もの"],[28,1,"だま"]],"text":"しかし、席にいる他の者が啓示を受けた場合には、初めの者は黙るがよい。"},{"ref":"1Cor.14.31","start":46014031,"end":46014031,"break":"none","ruby":[[11,1,"まな"],[17,1,"すす"],[20,1,"う"],[32,1,"のこ"],[35,2,"よげん"]],"text":"あなたがたは、みんなが学びみんなが勧めを受けるために、ひとりずつ残らず預言をすることができるのだから。"},{"ref":"1Cor.14.32","start":46014032,"end":46014032,"break":"none","ruby":[[3,3,"よげんしゃ"],[7,1,"れい"],[9,3,"よげんしゃ"],[13,2,"ふくじゅう"]],"text":"かつ、預言者の霊は預言者に服従するものである。"},{"ref":"1Cor.14.33","start":46014033,"end":46014033,"break":"none","breaks":[[20,"paragraph"]],"ruby":[[0,1,"かみ"],[2,1,"む"],[3,2,"ちつじょ"],[6,1,"かみ"],[12,2,"へいわ"],[15,1,"かみ"],[20,2,"せいと"],[29,2,"きょうかい"],[32,1,"おこな"]],"text":"神は無秩序の神ではなく、平和の神である。聖徒たちのすべての教会で行われているように、"},{"ref":"1Cor.14.34","start":46014034,"end":46014034,"break":"none","ruby":[[0,2,"ふじん"],[5,2,"きょうかい"],[9,1,"だま"],[22,1,"かれ"],[25,1,"かた"],[30,1,"ゆる"],[42,2,"りっぽう"],[45,1,"めい"],[54,2,"ふくじゅう"]],"text":"婦人たちは教会では黙っていなければならない。彼らは語ることが許されていない。だから、律法も命じているように、服従すべきである。"},{"ref":"1Cor.14.35","start":46014035,"end":46014035,"break":"none","ruby":[[2,1,"なに"],[4,1,"まな"],[15,1,"いえ"],[17,2,"じぶん"],[20,1,"おっと"],[22,1,"たず"],[29,2,"きょうかい"],[32,1,"かた"],[37,2,"ふじん"],[44,1,"は"]],"text":"もし何か学びたいことがあれば、家で自分の夫に尋ねるがよい。教会で語るのは、婦人にとっては恥ずべきことである。"},{"ref":"1Cor.14.36","start":46014036,"end":46014036,"break":"none","ruby":[[5,1,"かみ"],[7,1,"ことば"],[20,1,"で"]],"text":"それとも、神の言はあなたがたのところから出たのか。あるいは、あなたがただけにきたのか。"},{"ref":"1Cor.14.37","start":46014037,"end":46014037,"break":"paragraph","ruby":[[4,1,"ひと"],[7,2,"じぶん"],[10,3,"よげんしゃ"],[14,1,"れい"],[16,1,"ひと"],[21,1,"おも"],[39,1,"か"],[48,1,"しゅ"],[50,2,"めいれい"],[54,1,"みと"]],"text":"もしある人が、自分は預言者か霊の人であると思っているなら、わたしがあなたがたに書いていることは、主の命令だと認めるべきである。"},{"ref":"1Cor.14.38","start":46014038,"end":46014038,"break":"none","ruby":[[5,2,"むし"],[9,1,"もの"],[17,1,"ひと"],[21,2,"むし"]],"text":"もしそれを無視する者があれば、その人もまた無視される。"},{"ref":"1Cor.14.39","start":46014039,"end":46014039,"break":"paragraph","ruby":[[4,2,"きょうだい"],[21,2,"よげん"],[28,2,"ねっしん"],[31,1,"もと"],[40,2,"いげん"],[43,1,"かた"],[48,1,"さまた"]],"text":"わたしの兄弟たちよ。このようなわけだから、預言することを熱心に求めなさい。また、異言を語ることを妨げてはならない。"},{"ref":"1Cor.14.40","start":46014040,"end":46014040,"break":"none","ruby":[[11,2,"てきぎ"],[17,2,"ちつじょ"],[20,1,"ただ"],[23,1,"おこな"]],"text":"しかし、すべてのことを適宜に、かつ秩序を正して行うがよい。"}]