[{"ref":"1Sam.10.1","start":9010001,"end":9010001,"break":"paragraph","ruby":[[2,1,"とき"],[8,1,"あぶら"],[13,1,"と"],[21,1,"あたま"],[23,1,"そそ"],[26,1,"かれ"],[28,1,"くち"],[33,1,"い"],[38,1,"しゅ"],[44,1,"あぶら"],[46,1,"そそ"],[52,1,"たみ"],[59,1,"きみ"],[77,1,"しゅ"],[79,1,"たみ"],[81,1,"おさ"],[84,2,"しゅうい"],[87,1,"てき"],[89,1,"て"],[92,1,"かれ"],[95,1,"すく"],[106,1,"しゅ"],[112,1,"あぶら"],[114,1,"そそ"],[120,1,"し"],[121,1,"ぎょう"],[123,1,"きみ"],[136,1,"つぎ"]],"text":"その時サムエルは油のびんを取って、サウルの頭に注ぎ、彼に口づけして言った、「主はあなたに油を注いで、その民イスラエルの君とされたではありませんか。あなたは主の民を治め、周囲の敵の手から彼らを救わなければならない。主があなたに油を注いで、その嗣業の君とされたことの、しるしは次のとおりです。"},{"ref":"1Sam.10.2","start":9010002,"end":9010002,"break":"none","ruby":[[12,1,"はな"],[16,1,"さ"],[19,1,"い"],[30,2,"りょうち"],[43,1,"はか"],[55,1,"ひと"],[57,1,"あ"],[67,1,"かれ"],[74,1,"い"],[84,1,"さが"],[87,1,"い"],[94,1,"み"],[104,2,"ちちうえ"],[119,1,"こと"],[121,2,"しんぱい"],[129,1,"こ"],[142,1,"い"]],"text":"あなたがきょう、わたしを離れて、去って行くとき、ベニヤミンの領地のゼルザにあるラケルの墓のかたわらで、ふたりの人に会うでしょう。そして彼らはあなたに言います、『あなたが捜しに行かれたろばは見つかりました。いま父上は、ろばよりもあなたがたの事を心配して、「わが子のことは、どうしよう」と言っておられます』。"},{"ref":"1Sam.10.3","start":9010003,"end":9010003,"break":"none","ruby":[[11,1,"すす"],[22,1,"き"],[24,1,"ところ"],[26,1,"い"],[37,1,"のぼ"],[40,1,"かみ"],[42,1,"おが"],[49,1,"にん"],[51,1,"もの"],[53,1,"あ"],[65,1,"とう"],[67,1,"こ"],[71,1,"つ"],[84,1,"たずさ"],[95,1,"しゅ"],[101,1,"かわ"],[102,1,"ぶくろ"],[106,1,"たずさ"]],"text":"あなたが、そこからなお進んで、タボルのかしの木の所へ行くと、そこでベテルに上って神を拝もうとする三人の者に会うでしょう。ひとりは三頭の子やぎを連れ、ひとりは三つのパンを携え、ひとりは、ぶどう酒のはいった皮袋一つを携えている。"},{"ref":"1Sam.10.4","start":9010004,"end":9010004,"break":"none","ruby":[[0,1,"かれ"],[37,1,"て"],[40,1,"う"]],"text":"彼らはあなたにあいさつし、二つのパンをくれるでしょう。あなたはそれを、その手から受けなければならない。"},{"ref":"1Sam.10.5","start":9010005,"end":9010005,"break":"none","ruby":[[2,1,"のち"],[8,1,"かみ"],[14,1,"い"],[27,2,"しゅび"],[29,1,"へい"],[33,1,"ところ"],[44,1,"ところ"],[46,1,"い"],[50,1,"まち"],[55,1,"とき"],[57,2,"たてごと"],[60,1,"て"],[61,1,"つづみ"],[63,1,"ふえ"],[65,1,"こと"],[67,1,"と"],[69,2,"ひとびと"],[72,1,"さき"],[74,1,"い"],[79,2,"よげん"],[85,1,"たか"],[87,1,"ところ"],[90,1,"ふ"],[95,2,"いちぐん"],[98,3,"よげんしゃ"],[102,1,"あ"]],"text":"その後、あなたは神のギベアへ行く。そこはペリシテびとの守備兵のいる所である。あなたはその所へ行って、町にはいる時、立琴、手鼓、笛、琴を執る人々を先に行かせて、預言しながら高き所から降りてくる一群の預言者に会うでしょう。"},{"ref":"1Sam.10.6","start":9010006,"end":9010006,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,1,"れい"],[12,1,"うえ"],[19,1,"くだ"],[27,1,"かれ"],[30,2,"いっしょ"],[33,2,"よげん"],[37,1,"かわ"],[40,1,"あたら"],[43,1,"ひと"]],"text":"その時、主の霊があなたの上にもはげしく下って、あなたは彼らと一緒に預言し、変って新しい人となるでしょう。"},{"ref":"1Sam.10.7","start":9010007,"end":9010007,"break":"none","ruby":[[13,1,"み"],[15,1,"た"],[26,2,"てあ"],[43,1,"かみ"],[49,2,"いっしょ"]],"text":"これらのしるしが、あなたの身に起ったならば、あなたは手当たりしだいになんでもしなさい。神があなたと一緒におられるからです。"},{"ref":"1Sam.10.8","start":9010008,"end":9010008,"break":"none","ruby":[[8,2,"さきだ"],[17,1,"くだ"],[39,1,"くだ"],[46,2,"はんさい"],[49,1,"そな"],[52,3,"しゅうおんさい"],[76,1,"い"],[93,1,"こと"],[99,1,"しめ"],[104,2,"なぬか"],[110,1,"ま"]],"text":"あなたはわたしに先立ってギルガルに下らなければならない。わたしはあなたのもとに下っていって、燔祭を供え、酬恩祭をささげるでしょう。わたしがあなたのもとに行って、あなたのしなければならない事をあなたに示すまで、七日のあいだ待たなければならない」。"},{"ref":"1Sam.10.9","start":9010009,"end":9010009,"break":"paragraph","ruby":[[4,1,"せ"],[15,1,"はな"],[21,1,"かみ"],[23,1,"かれ"],[25,1,"あたら"],[28,1,"こころ"],[30,1,"あた"],[44,1,"みな"],[47,1,"ひ"],[49,1,"た"]],"text":"サウルが背をかえしてサムエルを離れたとき、神は彼に新しい心を与えられた。これらのしるしは皆その日に起った。"},{"ref":"1Sam.10.10","start":9010010,"end":9010010,"break":"none","ruby":[[0,1,"かれ"],[9,1,"とき"],[11,3,"よげんしゃ"],[15,2,"いちぐん"],[18,2,"であ"],[26,1,"かみ"],[28,1,"れい"],[39,1,"うえ"],[41,1,"くだ"],[44,1,"かれ"],[46,1,"かれ"],[54,2,"よげん"]],"text":"彼らはギベアにきた時、預言者の一群に出会った。そして神の霊が、はげしくサウルの上に下り、彼は彼らのうちにいて預言した。"},{"ref":"1Sam.10.11","start":9010011,"end":9010011,"break":"none","ruby":[[8,1,"し"],[13,2,"ひとびと"],[23,3,"よげんしゃ"],[29,1,"とも"],[31,2,"よげん"],[37,1,"み"],[39,1,"たがい"],[41,1,"い"],[49,1,"こ"],[51,2,"なにごと"],[54,1,"た"],[66,3,"よげんしゃ"]],"text":"もとからサウルを知っていた人々はみな、サウルが預言者たちと共に預言するのを見て互に言った、「キシの子に何事が起ったのか。サウルもまた預言者たちのうちにいるのか」。"},{"ref":"1Sam.10.12","start":9010012,"end":9010012,"break":"none","ruby":[[2,1,"ところ"],[8,1,"もの"],[10,1,"こた"],[15,1,"かれ"],[18,1,"ちち"],[37,3,"よげんしゃ"]],"text":"その所のひとりの者が答えた、「彼らの父はだれなのか」。それで「サウルもまた預言者たちのうちにいるのか」というのが、ことわざとなった。"},{"ref":"1Sam.10.13","start":9010013,"end":9010013,"break":"none","ruby":[[4,2,"よげん"],[11,1,"お"],[15,1,"たか"],[17,1,"ところ"],[19,1,"い"]],"text":"サウルは預言することを終えて、高き所へ行った。"},{"ref":"1Sam.10.14","start":9010014,"end":9010014,"break":"paragraph","ruby":[[19,1,"い"],[34,1,"い"],[45,1,"い"],[53,1,"さが"],[82,1,"い"]],"text":"サウルのおじが、サウルとそのしもべとに言った、「あなたがたは、どこへ行ったのか」。サウルは言った、「ろばを捜しにいったのですが、どこにもいないので、サムエルのもとに行きました」。"},{"ref":"1Sam.10.15","start":9010015,"end":9010015,"break":"none","ruby":[[7,1,"い"],[24,1,"い"],[32,1,"はな"]],"text":"サウルのおじは言った、「サムエルが、どんなことを言ったか、どうぞ話してください」。"},{"ref":"1Sam.10.16","start":9010016,"end":9010016,"break":"none","ruby":[[7,1,"い"],[15,1,"み"],[33,1,"い"],[48,1,"い"],[51,2,"おうこく"],[65,1,"なに"],[67,1,"つ"]],"text":"サウルはおじに言った、「ろばが見つかったと、はっきり、わたしたちに言いました」。しかしサムエルが言った王国のことについて、おじには何も告げなかった。"},{"ref":"1Sam.10.17","start":9010017,"end":9010017,"break":"paragraph","ruby":[[8,1,"たみ"],[14,1,"しゅ"],[16,1,"まえ"],[18,1,"あつ"]],"text":"さて、サムエルは民をミヅパで主の前に集め、"},{"ref":"1Sam.10.18","start":9010018,"end":9010018,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"い"],[20,1,"かみ"],[22,1,"しゅ"],[26,1,"おお"],[49,1,"みちび"],[51,1,"だ"],[67,1,"て"],[86,2,"おうこく"],[89,1,"て"],[92,1,"すく"],[94,1,"だ"]],"text":"イスラエルの人々に言った、「イスラエルの神、主はこう仰せられる、『わたしはイスラエルをエジプトから導き出し、あなたがたをエジプトびとの手、およびすべてあなたがたをしえたげる王国の手から救い出した』。"},{"ref":"1Sam.10.19","start":9010019,"end":9010019,"break":"none","ruby":[[22,1,"なや"],[25,1,"くる"],[29,1,"なか"],[32,1,"すく"],[42,1,"かみ"],[44,1,"す"],[49,1,"うえ"],[61,1,"うえ"],[63,1,"おう"],[65,1,"た"],[70,1,"い"],[77,1,"いま"],[86,2,"ぶぞく"],[96,2,"しぞく"],[105,1,"しゅ"],[107,1,"まえ"],[109,1,"で"]],"text":"しかしあなたがたは、きょう、あなたがたをその悩みと苦しみの中から救われるあなたがたの神を捨て、その上、『いいえ、われわれの上に王を立てよ』と言う。それゆえ今、あなたがたは、部族にしたがい、また氏族にしたがって、主の前に出なさい」。"},{"ref":"1Sam.10.20","start":9010020,"end":9010020,"break":"paragraph","ruby":[[19,2,"ぶぞく"],[22,1,"よ"],[24,1,"よ"],[27,1,"とき"],[35,2,"ぶぞく"],[42,1,"あた"]],"text":"こうしてサムエルがイスラエルのすべての部族を呼び寄せた時、ベニヤミンの部族が、くじに当った。"},{"ref":"1Sam.10.21","start":9010021,"end":9010021,"break":"none","ruby":[[8,2,"ぶぞく"],[13,2,"しぞく"],[21,1,"よ"],[23,1,"よ"],[26,1,"とき"],[32,2,"しぞく"],[39,1,"あた"],[46,2,"しぞく"],[49,1,"ひと"],[53,1,"よ"],[55,1,"よ"],[58,1,"とき"],[63,1,"こ"],[72,1,"あた"],[79,2,"ひとびと"],[82,1,"かれ"],[84,1,"さが"],[87,1,"とき"],[89,1,"み"]],"text":"またベニヤミンの部族をその氏族にしたがって呼び寄せた時、マテリの氏族が、くじに当り、マテリの氏族を人ごとに呼び寄せた時、キシの子サウルが、くじに当った。しかし人々が彼を捜した時、見つからなかった。"},{"ref":"1Sam.10.22","start":9010022,"end":9010022,"break":"none","ruby":[[5,1,"しゅ"],[10,1,"ひと"],[25,1,"と"],[29,1,"しゅ"],[31,1,"い"],[37,1,"かれ"],[39,2,"にもつ"],[42,1,"あいだ"],[44,1,"かく"]],"text":"そこでまた主に「その人はここにきているのですか」と問うと、主は言われた、「彼は荷物の間に隠れている」。"},{"ref":"1Sam.10.23","start":9010023,"end":9010023,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"はし"],[6,1,"い"],[10,1,"かれ"],[16,1,"つ"],[22,1,"かれ"],[24,1,"たみ"],[26,1,"なか"],[28,1,"た"],[33,1,"かた"],[36,1,"うえ"],[39,1,"たみ"],[43,1,"ひと"],[47,1,"たか"]],"text":"人々は走って行って、彼をそこから連れてきた。彼は民の中に立ったが、肩から上は、民のどの人よりも高かった。"},{"ref":"1Sam.10.24","start":9010024,"end":9010024,"break":"none","ruby":[[9,1,"たみ"],[11,1,"い"],[16,1,"しゅ"],[18,1,"えら"],[22,1,"ひと"],[31,1,"たみ"],[36,1,"かれ"],[41,1,"ひと"],[55,1,"たみ"],[60,1,"おう"],[61,2,"ばんざい"],[65,1,"さけ"]],"text":"サムエルはすべての民に言った、「主が選ばれた人をごらんなさい。民のうちに彼のような人はないではありませんか」。民はみな「王万歳」と叫んだ。"},{"ref":"1Sam.10.25","start":9010025,"end":9010025,"break":"paragraph","ruby":[[2,1,"とき"],[8,2,"おうこく"],[16,1,"たみ"],[18,1,"かた"],[24,1,"しょ"],[31,1,"しゅ"],[33,1,"まえ"],[53,1,"たみ"],[59,1,"いえ"],[61,1,"かえ"]],"text":"その時サムエルは王国のならわしを民に語り、それを書にしるして、主の前におさめた。こうしてサムエルはすべての民をそれぞれ家に帰らせた。"},{"ref":"1Sam.10.26","start":9010026,"end":9010026,"break":"none","ruby":[[12,1,"かれ"],[14,1,"いえ"],[16,1,"かえ"],[23,1,"かみ"],[27,1,"こころ"],[29,1,"うご"],[34,2,"ゆうし"],[39,1,"かれ"],[41,1,"とも"],[43,1,"い"]],"text":"サウルもまたギベアにある彼の家に帰った。そして神にその心を動かされた勇士たちも彼と共に行った。"},{"ref":"1Sam.10.27","start":9010027,"end":9010027,"break":"none","ruby":[[9,2,"ひとびと"],[15,1,"おとこ"],[26,1,"すく"],[37,1,"い"],[41,1,"かれ"],[43,1,"かろ"],[47,1,"おく"],[49,1,"もの"],[64,1,"だま"]],"text":"しかし、よこしまな人々は「この男がどうしてわれわれを救うことができよう」と言って、彼を軽んじ、贈り物をしなかった。しかしサウルは黙っていた。"}]