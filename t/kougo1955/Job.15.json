[{"ref":"Job.15.1","start":18015001,"end":18015001,"break":"paragraph","ruby":[[13,1,"こた"],[16,1,"い"]],"text":"そこでテマンびとエリパズは答えて言った、"},{"ref":"Job.15.2","start":18015002,"end":18015002,"break":"stanza","breaks":[[23,"line"]],"ruby":[[1,2,"ちしゃ"],[8,2,"ちしき"],[14,1,"こた"],[23,2,"ひがしかぜ"],[31,1,"はら"],[33,1,"み"]],"text":"「知者はむなしき知識をもって答えるであろうか。東風をもってその腹を満たすであろうか。"},{"ref":"Job.15.3","start":18015003,"end":18015003,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"やく"],[2,1,"た"],[6,2,"だんわ"],[12,1,"ろん"],[21,2,"むえき"],[24,2,"ことば"],[30,1,"あらそ"]],"text":"役に立たない談話をもって論じるであろうか。無益な言葉をもって争うであろうか。"},{"ref":"Job.15.4","start":18015004,"end":18015004,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"かみ"],[10,1,"おそ"],[16,1,"す"],[19,1,"かみ"],[21,1,"まえ"],[23,1,"いの"],[25,1,"こと"]],"text":"ところがあなたは神を恐れることを捨て、神の前に祈る事をやめている。"},{"ref":"Job.15.5","start":18015005,"end":18015005,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"つみ"],[10,1,"くち"],[12,1,"おし"],[19,2,"わるがしこ"],[22,1,"ひと"],[24,1,"した"],[26,1,"えら"],[28,1,"もち"]],"text":"あなたの罪はあなたの口を教え、あなたは悪賢い人の舌を選び用いる。"},{"ref":"Job.15.6","start":18015006,"end":18015006,"break":"line","breaks":[[19,"line"],[27,"line"]],"ruby":[[4,1,"くち"],[13,1,"つみ"],[15,1,"さだ"],[40,1,"さか"],[44,2,"しょうめい"]],"text":"あなたの口みずからあなたの罪を定める、わたしではない。あなたのくちびるがあなたに逆らって証明する。"},{"ref":"Job.15.7","start":18015007,"end":18015007,"break":"stanza","breaks":[[17,"line"]],"ruby":[[4,2,"さいしょ"],[7,1,"うま"],[10,1,"ひと"],[17,1,"やま"],[21,1,"さき"],[23,1,"うま"]],"text":"あなたは最初に生れた人であるのか。山よりも先に生れたのか。"},{"ref":"Job.15.8","start":18015008,"end":18015008,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"かみ"],[6,2,"かいぎ"],[21,2,"ちえ"],[24,2,"どくせん"]],"text":"あなたは神の会議にあずかったのか。あなたは知恵を独占しているのか。"},{"ref":"Job.15.9","start":18015009,"end":18015009,"break":"line","breaks":[[9,"line"],[22,"line"],[31,"line"]],"ruby":[[4,1,"し"],[14,1,"し"],[26,1,"さと"],[36,1,"さと"]],"text":"あなたが知るものはわれわれも知るではないか。あなたが悟るものはわれわれも悟るではないか。"},{"ref":"Job.15.10","start":18015010,"end":18015010,"break":"line","breaks":[[15,"line"],[25,"line"]],"ruby":[[5,1,"なか"],[12,1,"ひと"],[15,2,"としお"],[19,1,"ひと"],[29,1,"ちち"],[33,2,"としうえ"]],"text":"われわれの中にはしらがの人も、年老いた人もあって、あなたの父よりも年上だ。"},{"ref":"Job.15.11","start":18015011,"end":18015011,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かみ"],[2,1,"なぐさ"],[11,1,"たい"],[18,2,"ことば"],[34,1,"ちい"]],"text":"神の慰めおよびあなたに対するやさしい言葉も、あなたにとって、あまりに小さいというのか。"},{"ref":"Job.15.12","start":18015012,"end":18015012,"break":"line","breaks":[[15,"line"]],"ruby":[[8,1,"こころ"],[10,1,"くる"],[23,1,"め"]],"text":"どうしてあなたの心は狂うのか。どうしてあなたの目はしばたたくのか。"},{"ref":"Job.15.13","start":18015013,"end":18015013,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"かみ"],[10,1,"き"],[22,2,"ことば"],[29,1,"くち"],[32,1,"だ"]],"text":"あなたが神にむかって気をいらだて、このような言葉をあなたの口から出すのはなぜか。"},{"ref":"Job.15.14","start":18015014,"end":18015014,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"ひと"],[6,1,"もの"],[16,1,"きよ"],[24,1,"おんな"],[27,1,"うま"],[30,1,"もの"],[37,1,"ただ"]],"text":"人はいかなる者か、どうしてこれは清くありえよう。女から生れた者は、どうして正しくありえよう。"},{"ref":"Job.15.15","start":18015015,"end":18015015,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[7,1,"せい"],[10,1,"もの"],[14,1,"しん"],[16,1,"お"],[27,1,"てん"],[29,1,"かれ"],[31,1,"め"],[34,1,"きよ"]],"text":"見よ、神はその聖なる者にすら信を置かれない、もろもろの天も彼の目には清くない。"},{"ref":"Job.15.16","start":18015016,"end":18015016,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"にく"],[7,1,"けが"],[10,1,"もの"],[14,2,"ふぎ"],[17,1,"みず"],[22,1,"の"],[24,1,"ひと"]],"text":"まして憎むべき汚れた者、また不義を水のように飲む人においては。"},{"ref":"Job.15.17","start":18015017,"end":18015017,"break":"stanza","breaks":[[18,"line"]],"ruby":[[8,1,"かた"],[12,1,"き"],[22,2,"じぶん"],[25,1,"み"],[27,1,"こと"],[29,1,"の"]],"text":"わたしはあなたに語ろう、聞くがよい。わたしは自分の見た事を述べよう。"},{"ref":"Job.15.18","start":18015018,"end":18015018,"break":"line","breaks":[[18,"line"]],"ruby":[[3,2,"ちしゃ"],[10,2,"せんぞ"],[18,1,"かく"],[20,1,"ところ"],[23,1,"かた"],[25,1,"つた"]],"text":"これは知者たちがその先祖からうけて、隠す所なく語り伝えたものである。"},{"ref":"Job.15.19","start":18015019,"end":18015019,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[7,1,"ち"],[9,1,"さづ"],[15,2,"たこく"],[17,1,"じん"],[21,1,"なか"],[23,1,"い"],[25,1,"き"]],"text":"彼らにのみこの地は授けられて、他国人はその中に行き来したことがなかった。"},{"ref":"Job.15.20","start":18015020,"end":18015020,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あ"],[3,1,"ひと"],[5,2,"いっしょう"],[8,1,"あいだ"],[13,1,"くる"],[17,2,"ざんこく"],[20,1,"ひと"],[23,1,"とし"],[25,1,"かず"],[27,1,"さだ"]],"text":"悪しき人は一生の間、もだえ苦しむ。残酷な人には年の数が定められている。"},{"ref":"Job.15.21","start":18015021,"end":18015021,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"みみ"],[5,1,"おそ"],[9,1,"おと"],[11,1,"きこ"],[14,2,"はんえい"],[17,1,"とき"],[20,1,"ほろ"],[23,1,"もの"],[25,1,"かれ"],[27,1,"のぞ"]],"text":"その耳には恐ろしい音が聞え、繁栄の時にも滅ぼす者が彼に臨む。"},{"ref":"Job.15.22","start":18015022,"end":18015022,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"くら"],[8,1,"かえ"],[14,1,"しん"]],"text":"彼は、暗やみから帰りうるとは信ぜず、つるぎにねらわれる。"},{"ref":"Job.15.23","start":18015023,"end":18015023,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[2,2,"しょくもつ"],[12,1,"い"],[21,1,"くら"],[23,1,"ひ"],[25,2,"てぢか"],[28,1,"そな"],[37,1,"し"]],"text":"彼は食物はどこにあるかと言いつつさまよい、暗き日が手近に備えられてあるのを知る。"},{"ref":"Job.15.24","start":18015024,"end":18015024,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"なや"],[3,1,"くる"],[8,1,"かれ"],[10,1,"おそ"],[15,1,"たたか"],[18,1,"そな"],[23,1,"おう"],[28,1,"かれ"],[30,1,"う"],[32,1,"か"]],"text":"悩みと苦しみとが彼を恐れさせ、戦いの備えをした王のように彼に打ち勝つ。"},{"ref":"Job.15.25","start":18015025,"end":18015025,"break":"line","breaks":[[18,"line"]],"ruby":[[3,1,"かれ"],[5,1,"かみ"],[7,1,"さか"],[13,1,"て"],[15,1,"の"],[18,3,"ぜんのうしゃ"],[22,1,"さか"],[26,2,"こうまん"]],"text":"これは彼が神に逆らってその手を伸べ、全能者に逆らって高慢にふるまい、"},{"ref":"Job.15.26","start":18015026,"end":18015026,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"たて"],[2,1,"あつ"],[4,1,"めん"],[9,2,"ごうじょう"],[13,1,"かれ"],[17,1,"む"]],"text":"盾の厚い面をもって強情に、彼にはせ向かうからだ。"},{"ref":"Job.15.27","start":18015027,"end":18015027,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"かれ"],[4,2,"しぼう"],[12,1,"かお"],[20,1,"こし"],[23,2,"しぼう"],[26,1,"にく"],[28,1,"あつ"]],"text":"また彼は脂肪をもってその顔をおおい、その腰には脂肪の肉を集め、"},{"ref":"Job.15.28","start":18015028,"end":18015028,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"ほろ"],[5,2,"まちまち"],[8,1,"す"],[11,1,"ひと"],[13,1,"す"],[17,1,"いえ"],[19,2,"あらつか"],[24,1,"ところ"]],"text":"滅ぼされた町々に住み、人の住まない家、荒塚となる所におるからだ。"},{"ref":"Job.15.29","start":18015029,"end":18015029,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かれ"],[2,1,"と"],[5,1,"もの"],[13,1,"とみ"],[18,1,"つづ"],[25,1,"ち"],[27,1,"ね"],[29,1,"は"]],"text":"彼は富める者とならず、その富はながく続かない、また地に根を張ることはない。"},{"ref":"Job.15.30","start":18015030,"end":18015030,"break":"line","breaks":[[19,"line"],[30,"line"]],"ruby":[[0,1,"かれ"],[2,1,"くら"],[19,1,"ほのお"],[23,1,"わか"],[24,1,"えだ"],[26,1,"か"],[32,1,"はな"],[34,1,"かぜ"],[36,1,"ふ"],[38,1,"さ"]],"text":"彼は暗やみからのがれることができない。炎はその若枝を枯らし、その花は風に吹き去られる。"},{"ref":"Job.15.31","start":18015031,"end":18015031,"break":"line","breaks":[[12,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[8,1,"あざむ"],[16,1,"こと"],[31,1,"むく"]],"text":"彼をしてみずから欺いて、むなしい事にたよらせてはならない。その報いはむなしいからだ。"},{"ref":"Job.15.32","start":18015032,"end":18015032,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[2,1,"とき"],[7,1,"まえ"],[11,1,"こと"],[15,1,"と"],[20,1,"かれ"],[22,1,"えだ"],[24,1,"みどり"]],"text":"彼の時のこない前にその事がなし遂げられ、彼の枝は緑とならないであろう。"},{"ref":"Job.15.33","start":18015033,"end":18015033,"break":"line","breaks":[[12,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[6,1,"き"],[14,1,"じゅく"],[18,1,"み"],[22,1,"おと"],[35,1,"き"],[43,1,"はな"],[45,1,"おと"]],"text":"彼はぶどうの木のように、その熟さない実をふり落すであろう。またオリブの木のように、その花を落すであろう。"},{"ref":"Job.15.34","start":18015034,"end":18015034,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[2,1,"しん"],[6,1,"もの"],[12,1,"こ"],[23,2,"てんまく"],[26,1,"ひ"],[28,1,"や"],[30,1,"ほろ"]],"text":"神を信じない者のやからは子なく、まいないによる天幕は火で焼き滅ぼされるからだ。"},{"ref":"Job.15.35","start":18015035,"end":18015035,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[3,2,"がいあく"],[10,2,"ふぎ"],[13,1,"う"],[18,1,"はら"],[20,1,"いつわ"]],"text":"彼らは害悪をはらみ、不義を生み、その腹は偽りをつくる」。"}]