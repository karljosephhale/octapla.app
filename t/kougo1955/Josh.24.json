[{"ref":"Josh.24.1","start":6024001,"end":6024001,"break":"paragraph","ruby":[[16,2,"ぶぞく"],[23,1,"あつ"],[32,2,"ちょうろう"],[51,1,"め"],[53,1,"よ"],[57,1,"とも"],[59,1,"かみ"],[61,1,"まえ"],[63,1,"すす"],[65,1,"で"]],"text":"ヨシュアは、イスラエルのすべての部族をシケムに集め、イスラエルの長老、かしら、さばきびと、つかさたちを召し寄せて、共に神の前に進み出た。"},{"ref":"Josh.24.2","start":6024002,"end":6024002,"break":"none","ruby":[[12,1,"たみ"],[14,1,"い"],[25,1,"かみ"],[27,1,"しゅ"],[32,1,"おお"],[45,2,"せんぞ"],[60,1,"ちち"],[66,1,"ちち"],[71,1,"むかし"],[77,1,"かわ"],[79,1,"む"],[83,1,"す"],[92,2,"かみがみ"],[95,1,"つか"]],"text":"そしてヨシュアはすべての民に言った、「イスラエルの神、主は、こう仰せられる、『あなたがたの先祖たち、すなわちアブラハムの父、ナホルの父テラは、昔、ユフラテ川の向こうに住み、みな、ほかの神々に仕えていたが、"},{"ref":"Josh.24.3","start":6024003,"end":6024003,"break":"none","ruby":[[11,2,"せんぞ"],[20,1,"かわ"],[22,1,"む"],[27,1,"つ"],[29,1,"だ"],[37,1,"ぜん"],[38,1,"ち"],[40,1,"みちび"],[42,1,"とお"],[47,2,"しそん"],[50,1,"ま"],[58,1,"かれ"],[64,1,"あた"]],"text":"わたしは、あなたがたの先祖アブラハムを、川の向こうから連れ出して、カナンの全地を導き通り、その子孫を増した。わたしは彼にイサクを与え、"},{"ref":"Josh.24.4","start":6024004,"end":6024004,"break":"none","ruby":[[12,1,"あた"],[24,2,"さんち"],[27,1,"あた"],[31,2,"しょゆう"],[45,1,"こ"],[46,1,"とも"],[55,1,"くだ"]],"text":"イサクにヤコブとエサウを与え、エサウにはセイルの山地を与えて、所有とさせたが、ヤコブとその子供たちはエジプトに下った。"},{"ref":"Josh.24.5","start":6024005,"end":6024005,"break":"none","ruby":[[27,3,"ふしぎ"],[40,1,"わざわい"],[42,1,"くだ"],[47,1,"のち"],[54,1,"みちび"],[56,1,"だ"]],"text":"わたしはモーセとアロンをつかわし、またエジプトのうちに不思議をおこなって、これに災を下し、その後あなたがたを導き出した。"},{"ref":"Josh.24.6","start":6024006,"end":6024006,"break":"none","ruby":[[10,1,"ちち"],[21,1,"みちび"],[23,1,"だ"],[32,1,"うみ"],[47,2,"せんしゃ"],[50,2,"きへい"],[64,1,"ちち"],[68,2,"こうかい"],[71,1,"お"]],"text":"わたしはあなたがたの父たちを、エジプトから導き出し、あなたがたが海にきたとき、エジプトびとは、戦車と騎兵とをもって、あなたがたの父たちを紅海に追ってきた。"},{"ref":"Josh.24.7","start":6024007,"end":6024007,"break":"none","ruby":[[11,1,"ちち"],[15,1,"しゅ"],[17,1,"よ"],[25,1,"しゅ"],[27,1,"くら"],[45,1,"あいだ"],[47,1,"お"],[50,1,"うみ"],[52,1,"かれ"],[55,1,"うえ"],[57,1,"かたむ"],[60,1,"かれ"],[90,1,"め"],[92,1,"み"],[98,1,"なが"],[100,1,"あいだ"],[102,2,"あらの"],[105,1,"す"]],"text":"そのとき、あなたがたの父たちが主に呼ばわったので、主は暗やみをあなたがたとエジプトびととの間に置き、海を彼らの上に傾けて彼らをおおわれた。あなたがたは、わたしがエジプトでしたことを目で見た。そして長い間、荒野に住んでいた。"},{"ref":"Josh.24.8","start":6024008,"end":6024008,"break":"none","ruby":[[11,1,"む"],[14,1,"がわ"],[16,1,"す"],[27,1,"ち"],[36,1,"みちび"],[38,1,"い"],[42,1,"かれ"],[51,1,"たたか"],[61,1,"かれ"],[70,1,"て"],[72,1,"わた"],[76,1,"かれ"],[79,1,"ち"],[81,1,"え"],[85,1,"かれ"],[94,1,"まえ"],[97,1,"ほろ"],[100,1,"さ"]],"text":"わたしはまたヨルダンの向こう側に住んでいたアモリびとの地に、あなたがたを導き入れた。彼らはあなたがたと戦ったので、わたしは彼らをあなたがたの手に渡して、彼らの地を獲させ、彼らをあなたがたの前から滅ぼし去った。"},{"ref":"Josh.24.9","start":6024009,"end":6024009,"break":"none","ruby":[[8,1,"おう"],[14,1,"こ"],[19,1,"た"],[29,1,"てき"],[32,1,"ひと"],[43,1,"こ"],[48,1,"まね"]],"text":"ついで、モアブの王チッポルの子バラクが立って、イスラエルに敵し、人をつかわし、ベオルの子バラムを招き、あなたがたをのろわせようとしたが、"},{"ref":"Josh.24.10","start":6024010,"end":6024010,"break":"none","ruby":[[8,1,"き"],[20,1,"かれ"],[34,2,"しゅくふく"],[47,1,"かれ"],[49,1,"て"],[58,1,"すく"],[60,1,"だ"]],"text":"わたしがバラムに聞こうとしなかったので、彼は、かえって、あなたがたを祝福した。こうしてわたしは彼の手からあなたがたを救い出した。"},{"ref":"Josh.24.11","start":6024011,"end":6024011,"break":"none","ruby":[[15,1,"わた"],[31,2,"ひとびと"],[40,1,"たたか"],[94,1,"たたか"],[103,1,"かれ"],[112,1,"て"],[114,1,"わた"]],"text":"そしてあなたがたは、ヨルダンを渡って、エリコにきたが、エリコの人々はあなたがたと戦い、アモリびと、ペリジびと、カナンびと、ヘテびと、ギルガシびと、ヒビびと、およびエブスびとも、あなたがたと戦ったが、わたしは彼らをあなたがたの手に渡した。"},{"ref":"Josh.24.12","start":6024012,"end":6024012,"break":"none","ruby":[[11,1,"まえ"],[19,1,"おく"],[35,1,"おう"],[44,1,"まえ"],[47,1,"お"],[49,1,"はら"],[76,1,"ゆみ"]],"text":"わたしは、あなたがたの前に、くまばちを送って、あのアモリびとのふたりの王を、あなたがたの前から追い払った。これはあなたがたのつるぎ、または、あなたがたの弓によってではなかった。"},{"ref":"Josh.24.13","start":6024013,"end":6024013,"break":"none","ruby":[[14,2,"じぶん"],[17,1,"ろう"],[23,1,"ち"],[32,1,"あた"],[41,1,"た"],[47,1,"まち"],[56,1,"あた"],[73,1,"ところ"],[75,1,"す"],[89,2,"じぶん"],[92,1,"つく"],[101,1,"はたけ"],[107,1,"はたけ"],[109,1,"み"],[111,1,"た"]],"text":"そしてわたしは、あなたがたが自分で労しなかった地を、あなたがたに与え、あなたがたが建てなかった町を、あなたがたに与えた。そしてあなたがたはいまその所に住んでいる。あなたがたはまた自分で作らなかったぶどう畑と、オリブ畑の実を食べている』。"},{"ref":"Josh.24.14","start":6024014,"end":6024014,"break":"paragraph","ruby":[[14,1,"しゅ"],[16,1,"おそ"],[30,2,"しんじつ"],[38,1,"しゅ"],[40,1,"つか"],[49,2,"せんぞ"],[53,1,"かわ"],[55,1,"む"],[67,1,"つか"],[70,1,"た"],[72,2,"かみがみ"],[75,1,"のぞ"],[77,1,"さ"],[81,1,"しゅ"],[83,1,"つか"]],"text":"それゆえ、いま、あなたがたは主を恐れ、まことと、まごころと、真実とをもって、主に仕え、あなたがたの先祖が、川の向こう、およびエジプトで仕えた他の神々を除き去って、主に仕えなさい。"},{"ref":"Josh.24.15","start":6024015,"end":6024015,"break":"none","ruby":[[8,1,"しゅ"],[10,1,"つか"],[37,2,"せんぞ"],[41,1,"かわ"],[43,1,"む"],[47,1,"つか"],[50,2,"かみがみ"],[67,1,"す"],[69,1,"ち"],[77,2,"かみがみ"],[88,1,"つか"],[91,1,"もの"],[98,1,"えら"],[116,1,"いえ"],[119,1,"とも"],[121,1,"しゅ"],[123,1,"つか"]],"text":"もしあなたがたが主に仕えることを、こころよしとしないのならば、あなたがたの先祖が、川の向こうで仕えた神々でも、または、いまあなたがたの住む地のアモリびとの神々でも、あなたがたの仕える者を、きょう、選びなさい。ただし、わたしとわたしの家とは共に主に仕えます」。"},{"ref":"Josh.24.16","start":6024016,"end":6024016,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"たみ"],[6,1,"こた"],[9,1,"い"],[14,1,"しゅ"],[16,1,"す"],[20,1,"た"],[22,2,"かみがみ"],[25,1,"つか"],[36,1,"けっ"]],"text":"その時、民は答えて言った、「主を捨てて、他の神々に仕えるなど、われわれは決していたしません。"},{"ref":"Josh.24.17","start":6024017,"end":6024017,"break":"none","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[24,2,"せんぞ"],[34,1,"ち"],[36,2,"どれい"],[39,1,"いえ"],[42,1,"みちび"],[44,1,"のぼ"],[54,1,"め"],[56,1,"まえ"],[61,1,"おお"],[69,1,"おこな"],[77,1,"い"],[83,1,"みち"],[85,1,"まも"],[93,1,"とお"],[100,2,"こくみん"],[103,1,"なか"],[110,1,"まも"]],"text":"われわれの神、主がみずからわれわれと、われわれの先祖とを、エジプトの地、奴隷の家から導き上り、またわれわれの目の前で、あの大いなるしるしを行い、われわれの行くすべての道で守り、われわれが通ったすべての国民の中でわれわれを守られたからです。"},{"ref":"Josh.24.18","start":6024018,"end":6024018,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"ち"],[9,1,"す"],[26,1,"たみ"],[34,1,"まえ"],[37,1,"お"],[39,1,"はら"],[56,1,"しゅ"],[58,1,"つか"],[63,1,"しゅ"],[70,1,"かみ"]],"text":"主はまた、この地に住んでいたアモリびとなど、すべての民を、われわれの前から追い払われました。それゆえ、われわれも主に仕えます。主はわれわれの神だからです」。"},{"ref":"Josh.24.19","start":6024019,"end":6024019,"break":"paragraph","ruby":[[9,1,"たみ"],[11,1,"い"],[22,1,"しゅ"],[24,1,"つか"],[39,1,"しゅ"],[41,1,"せい"],[44,1,"かみ"],[52,1,"かみ"],[64,1,"つみ"]],"text":"しかし、ヨシュアは民に言った、「あなたがたは主に仕えることはできないであろう。主は聖なる神であり、ねたむ神であって、あなたがたの罪、あなたがたのとがを、ゆるされないからである。"},{"ref":"Josh.24.20","start":6024020,"end":6024020,"break":"none","ruby":[[8,1,"しゅ"],[10,1,"す"],[14,1,"こと"],[17,2,"かみがみ"],[20,1,"つか"],[38,1,"くだ"],[59,1,"わざわい"],[71,1,"ほろ"]],"text":"もしあなたがたが主を捨てて、異なる神々に仕えるならば、あなたがたにさいわいを下されたのちにも、ひるがえってあなたがたに災をくだし、あなたがたを滅ぼしつくされるであろう」。"},{"ref":"Josh.24.21","start":6024021,"end":6024021,"break":"none","ruby":[[0,1,"たみ"],[7,1,"い"],[21,1,"しゅ"],[23,1,"つか"]],"text":"民はヨシュアに言った、「いいえ、われわれは主に仕えます」。"},{"ref":"Josh.24.22","start":6024022,"end":6024022,"break":"none","ruby":[[8,1,"たみ"],[10,1,"い"],[21,1,"しゅ"],[23,1,"えら"],[27,1,"しゅ"],[29,1,"つか"],[33,1,"い"],[48,2,"しょうにん"],[55,1,"かれ"],[58,1,"い"],[68,2,"しょうにん"]],"text":"そこでヨシュアは民に言った、「あなたがたは主を選んで、主に仕えると言った。あなたがたみずからその証人である」。彼らは言った、「われわれは証人です」。"},{"ref":"Josh.24.23","start":6024023,"end":6024023,"break":"none","ruby":[[7,1,"い"],[30,1,"こと"],[33,2,"かみがみ"],[36,1,"のぞ"],[38,1,"さ"],[47,1,"かみ"],[49,1,"しゅ"],[52,1,"こころ"],[54,1,"かたむ"]],"text":"ヨシュアはまた言った、「それならば、あなたがたのうちにある、異なる神々を除き去り、イスラエルの神、主に、心を傾けなさい」。"},{"ref":"Josh.24.24","start":6024024,"end":6024024,"break":"none","ruby":[[0,1,"たみ"],[7,1,"い"],[17,1,"かみ"],[19,1,"しゅ"],[27,1,"つか"],[32,1,"こえ"],[34,1,"き"]],"text":"民はヨシュアに言った、「われわれの神、主に、われわれは仕え、その声に聞きしたがいます」。"},{"ref":"Josh.24.25","start":6024025,"end":6024025,"break":"none","ruby":[[12,1,"ひ"],[14,1,"たみ"],[16,2,"けいやく"],[31,1,"さだ"],[40,1,"かれ"],[46,1,"もう"]],"text":"こうしてヨシュアは、その日、民と契約をむすび、シケムにおいて、定めと、おきてを、彼らのために設けた。"},{"ref":"Josh.24.26","start":6024026,"end":6024026,"break":"none","ruby":[[9,2,"ことば"],[12,1,"かみ"],[14,2,"りっぽう"],[17,1,"しょ"],[23,1,"おお"],[26,1,"いし"],[28,1,"と"],[34,1,"ところ"],[37,1,"しゅ"],[39,2,"せいじょ"],[47,1,"き"],[49,1,"した"],[54,1,"た"]],"text":"ヨシュアはこれらの言葉を神の律法の書にしるし、大きな石を取って、その所で、主の聖所にあるかしの木の下にそれを立て、"},{"ref":"Josh.24.27","start":6024027,"end":6024027,"break":"none","ruby":[[10,1,"たみ"],[12,1,"い"],[17,1,"み"],[22,1,"いし"],[40,1,"しゅ"],[47,1,"かた"],[55,2,"ことば"],[59,1,"き"],[79,2,"じぶん"],[82,1,"かみ"],[84,1,"す"],[98,1,"いし"]],"text":"ヨシュアは、すべての民に言った、「見よ、この石はわれわれのあかしとなるであろう。主がわれわれに語られたすべての言葉を、聞いたからである。それゆえ、あなたがたが自分の神を捨てることのないために、この石が、あなたがたのあかしとなるであろう」。"},{"ref":"Josh.24.28","start":6024028,"end":6024028,"break":"none","ruby":[[9,1,"たみ"],[18,1,"し"],[19,1,"ぎょう"],[21,1,"ち"],[23,1,"き"],[25,1,"さ"]],"text":"こうしてヨシュアは民を、おのおのその嗣業の地に帰し去らせた。"},{"ref":"Josh.24.29","start":6024029,"end":6024029,"break":"paragraph","ruby":[[4,1,"こと"],[6,1,"のち"],[8,1,"しゅ"],[17,1,"こ"],[25,1,"さい"],[27,1,"し"]],"text":"これらの事の後、主のしもべ、ヌンの子ヨシュアは百十歳で死んだ、"},{"ref":"Josh.24.30","start":6024030,"end":6024030,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"かれ"],[7,1,"し"],[8,1,"ぎょう"],[10,1,"ち"],[23,1,"ほうむ"],[42,2,"さんち"],[49,1,"やま"],[51,1,"きた"]],"text":"人々は彼をその嗣業の地のうちのテムナテ・セラに葬った。テムナテ・セラは、エフライムの山地で、ガアシ山の北にある。"},{"ref":"Josh.24.31","start":6024031,"end":6024031,"break":"paragraph","ruby":[[11,1,"よ"],[15,1,"ひ"],[17,1,"あいだ"],[21,1,"しゅ"],[32,1,"おこな"],[44,1,"し"],[58,1,"い"],[60,1,"のこ"],[63,2,"ちょうろう"],[68,1,"よ"],[72,1,"ひ"],[74,1,"あいだ"],[79,1,"しゅ"],[81,1,"つか"]],"text":"イスラエルはヨシュアの世にある日の間、また主がイスラエルのために行われたもろもろのことを知っていて、ヨシュアのあとに生き残った長老たちが世にある日の間、つねに主に仕えた。"},{"ref":"Josh.24.32","start":6024032,"end":6024032,"break":"paragraph","ruby":[[6,2,"ひとびと"],[16,1,"たずさ"],[18,1,"のぼ"],[25,1,"ほね"],[35,1,"ぎん"],[37,1,"まい"],[44,1,"ちち"],[49,1,"こ"],[53,1,"か"],[55,1,"と"],[65,2,"じしょ"],[68,2,"いちぶ"],[71,1,"ほうむ"],[83,2,"しそん"],[86,1,"し"],[87,1,"ぎょう"]],"text":"イスラエルの人々が、エジプトから携え上ったヨセフの骨は、むかしヤコブが銀百枚で、シケムの父ハモルの子らから買い取ったシケムのうちの地所の一部に葬られた。これはヨセフの子孫の嗣業となった。"},{"ref":"Josh.24.33","start":6024033,"end":6024033,"break":"paragraph","ruby":[[4,1,"こ"],[11,1,"し"],[15,2,"ひとびと"],[18,1,"かれ"],[23,1,"こ"],[29,1,"あた"],[34,1,"まち"],[43,2,"さんち"],[52,1,"ほうむ"]],"text":"アロンの子エレアザルも死んだ。人々は彼を、その子ピネハスに与えられた町で、エフライムの山地にあるギベアに葬った。"}]