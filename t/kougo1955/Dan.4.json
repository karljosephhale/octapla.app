[{"ref":"Dan.4.1","start":27004001,"end":27004001,"break":"paragraph","ruby":[[7,1,"おう"],[9,1,"ぜん"],[10,2,"せかい"],[13,1,"す"],[15,2,"しょみん"],[18,1,"しょ"],[19,1,"ぞく"],[21,2,"しょこく"],[23,1,"ご"],[25,1,"もの"],[27,1,"つ"],[41,2,"へいあん"],[44,1,"ま"]],"text":"ネブカデネザル王は全世界に住む諸民、諸族、諸国語の者に告げる。どうか、あなたがたに平安が増すように。"},{"ref":"Dan.4.2","start":27004002,"end":27004002,"break":"none","ruby":[[2,1,"たか"],[4,1,"かみ"],[14,2,"きせき"],[18,1,"おこな"],[30,1,"し"],[36,1,"おも"]],"text":"いと高き神はわたしにしるしと奇跡とを行われた。わたしはこれを知らせたいと思う。"},{"ref":"Dan.4.3","start":27004003,"end":27004003,"break":"stanza","breaks":[[16,"line"],[32,"line"],[41,"line"]],"ruby":[[9,1,"おお"],[21,2,"きせき"],[34,1,"くに"],[36,2,"えいえん"],[39,1,"くに"],[43,2,"しゅけん"],[46,2,"よよ"],[49,1,"およ"]],"text":"ああ、そのしるしの大いなること、ああ、その奇跡のすばらしいこと、その国は永遠の国、その主権は世々に及ぶ。"},{"ref":"Dan.4.4","start":27004004,"end":27004004,"break":"paragraph","ruby":[[12,1,"や"],[14,1,"やす"],[23,1,"みや"],[28,1,"さか"]],"text":"われネブカデネザルはわが家に安らかにおり、わが宮にあって栄えていたが、"},{"ref":"Dan.4.5","start":27004005,"end":27004005,"break":"none","ruby":[[7,1,"ゆめ"],[9,1,"み"],[17,1,"おそ"],[25,1,"とこ"],[33,1,"こと"],[35,1,"おも"],[44,2,"のうちゅう"],[47,1,"まぼろし"],[52,1,"こころ"],[54,1,"なや"]],"text":"わたしは一つの夢を見て、そのために恐れた。すなわち床にあって、その事を思いめぐらし、わが脳中の幻のために心を悩ました。"},{"ref":"Dan.4.6","start":27004006,"end":27004006,"break":"none","ruby":[[7,2,"めいれい"],[10,1,"くだ"],[18,2,"ちしゃ"],[28,1,"まえ"],[30,1,"め"],[32,1,"よ"],[38,1,"ゆめ"],[40,1,"と"],[42,1,"あ"],[46,1,"しめ"]],"text":"そこでわたしは命令を下し、バビロンの知者をことごとくわが前に召し寄せて、その夢の解き明かしを示させようとした。"},{"ref":"Dan.4.7","start":27004007,"end":27004007,"break":"none","ruby":[[4,2,"はかせ"],[7,1,"ほう"],[8,1,"じゅつ"],[9,1,"し"],[18,1,"うらな"],[20,1,"し"],[35,1,"ゆめ"],[37,1,"かれ"],[40,1,"かた"],[45,1,"かれ"],[50,1,"と"],[52,1,"あ"],[56,1,"しめ"]],"text":"すると、博士、法術士、カルデヤびと、占い師たちがきたので、わたしはその夢を彼らに語ったが、彼らはその解き明かしを示すことができなかった。"},{"ref":"Dan.4.8","start":27004008,"end":27004008,"break":"none","ruby":[[0,2,"さいご"],[12,1,"まえ"],[19,1,"かれ"],[21,1,"な"],[25,1,"かみ"],[27,1,"な"],[48,1,"かれ"],[54,1,"せい"],[57,1,"かみ"],[59,1,"れい"],[73,1,"かれ"],[77,1,"ゆめ"],[79,1,"かた"],[82,1,"い"]],"text":"最後にダニエルがわたしの前にきた、――彼の名はわが神の名にちなんで、ベルテシャザルととなえられ、彼のうちには聖なる神の霊がやどっていた――わたしは彼にその夢を語って言った、"},{"ref":"Dan.4.9","start":27004009,"end":27004009,"break":"none","ruby":[[1,2,"はかせ"],[4,1,"ちょう"],[18,1,"し"],[24,1,"せい"],[27,1,"かみ"],[29,1,"れい"],[50,2,"ひみつ"],[76,1,"み"],[78,1,"ゆめ"],[85,1,"と"],[87,1,"あ"],[95,1,"つ"]],"text":"「博士の長ベルテシャザルよ、わたしは知っている。聖なる神の霊があなたのうちにやどっているから、どんな秘密もあなたにはむずかしいことはない。ここにわたしが見た夢がある。その解き明かしをわたしに告げなさい。"},{"ref":"Dan.4.10","start":27004010,"end":27004010,"break":"none","ruby":[[4,1,"とこ"],[9,1,"み"],[11,2,"のうちゅう"],[14,1,"まぼろし"],[26,1,"み"],[31,1,"ち"],[33,2,"ちゅうおう"],[37,1,"ぽん"],[39,1,"き"],[50,1,"たか"]],"text":"わたしが床にあって見た脳中の幻はこれである。わたしが見たのに、地の中央に一本の木があって、そのたけが高かったが、"},{"ref":"Dan.4.11","start":27004011,"end":27004011,"break":"none","ruby":[[2,1,"き"],[4,2,"せいちょう"],[8,1,"つよ"],[13,1,"てん"],[15,1,"たっ"],[21,1,"たか"],[28,1,"ち"],[30,1,"はて"],[34,1,"み"]],"text":"その木は成長して強くなり、天に達するほどの高さになって、地の果までも見えわたり、"},{"ref":"Dan.4.12","start":27004012,"end":27004012,"break":"none","ruby":[[2,1,"は"],[4,1,"うつく"],[10,1,"み"],[12,1,"ゆた"],[20,1,"もの"],[24,1,"なか"],[27,2,"しょくもつ"],[30,1,"え"],[34,1,"の"],[36,1,"けもの"],[40,1,"かげ"],[46,1,"そら"],[48,1,"とり"],[52,1,"えだ"],[61,1,"にく"],[64,1,"もの"],[72,1,"やしな"]],"text":"その葉は美しく、その実は豊かで、すべての者がその中から食物を獲、また野の獣はその陰にやどり、空の鳥はその枝にすみ、すべての肉なる者はこれによって養われた。"},{"ref":"Dan.4.13","start":27004013,"end":27004013,"break":"paragraph","ruby":[[4,1,"とこ"],[9,1,"み"],[11,2,"のうちゅう"],[14,1,"まぼろし"],[16,1,"なか"],[23,3,"けいごしゃ"],[31,2,"せいじゃ"],[34,1,"てん"],[37,1,"くだ"],[41,1,"み"]],"text":"わたしが床にあって見た脳中の幻の中に、ひとりの警護者、ひとりの聖者の天から下るのを見たが、"},{"ref":"Dan.4.14","start":27004014,"end":27004014,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こえ"],[3,1,"たか"],[5,1,"よ"],[13,1,"い"],[20,1,"き"],[22,1,"き"],[24,1,"たお"],[29,1,"えだ"],[31,1,"き"],[39,1,"は"],[43,1,"おと"],[48,1,"み"],[50,1,"う"],[52,1,"ち"],[56,1,"けもの"],[60,1,"した"],[63,1,"に"],[65,1,"さ"],[69,1,"とり"],[73,1,"えだ"],[76,1,"と"],[78,1,"さ"]],"text":"彼は声高く呼ばわって、こう言った、『この木を切り倒し、その枝を切りはらい、その葉をゆり落し、その実を打ち散らし、獣をその下から逃げ去らせ、鳥をその枝から飛び去らせよ。"},{"ref":"Dan.4.15","start":27004015,"end":27004015,"break":"none","ruby":[[5,1,"ね"],[7,1,"き"],[9,1,"かぶ"],[11,1,"ち"],[13,1,"のこ"],[19,1,"てつ"],[21,2,"せいどう"],[31,1,"の"],[33,2,"わかくさ"],[36,1,"なか"],[41,1,"てん"],[47,1,"つゆ"],[56,1,"ち"],[58,1,"くさ"],[60,1,"なか"],[63,1,"けもの"],[65,1,"とも"],[69,1,"ぶん"]],"text":"ただしその根の切り株を地に残し、それに鉄と青銅のなわをかけて、野の若草の中におき、天からくだる露にぬれさせ、また地の草の中で、獣と共にその分にあずからせよ。"},{"ref":"Dan.4.16","start":27004016,"end":27004016,"break":"none","ruby":[[4,1,"こころ"],[6,1,"かわ"],[9,2,"にんげん"],[12,1,"こころ"],[20,1,"けもの"],[22,1,"こころ"],[24,1,"あた"],[33,1,"とき"],[35,1,"す"]],"text":"またその心は変って人間の心のようでなく、獣の心が与えられて、七つの時を過ごさせよ。"},{"ref":"Dan.4.17","start":27004017,"end":27004017,"break":"none","ruby":[[2,2,"せんげん"],[5,3,"けいごしゃ"],[11,2,"めいれい"],[21,2,"けってい"],[24,2,"せいじゃ"],[29,2,"ことば"],[40,1,"たか"],[42,1,"もの"],[45,2,"にんげん"],[48,1,"くに"],[50,1,"おさ"],[54,2,"じぶん"],[57,1,"い"],[65,1,"ひと"],[67,1,"あた"],[72,1,"ひと"],[77,1,"もっと"],[79,1,"いや"],[82,1,"もの"],[87,1,"うえ"],[89,1,"た"],[97,1,"こと"],[104,1,"もの"],[106,1,"し"]],"text":"この宣言は警護者たちの命令によるもの、この決定は聖者たちの言葉によるもので、いと高き者が、人間の国を治めて、自分の意のままにこれを人に与え、また人のうちの最も卑しい者を、その上に立てられるという事を、すべての者に知らせるためである』と。"},{"ref":"Dan.4.18","start":27004018,"end":27004018,"break":"none","ruby":[[9,1,"おう"],[13,1,"ゆめ"],[15,1,"み"],[33,1,"と"],[35,1,"あ"],[43,1,"つ"],[51,1,"くに"],[53,2,"ちしゃ"],[65,1,"と"],[67,1,"あ"],[76,1,"しめ"],[113,1,"せい"],[116,1,"かみ"],[118,1,"れい"]],"text":"われネブカデネザル王はこの夢を見た。ベルテシャザルよ、あなたはその解き明かしをわたしに告げなさい。わが国の知者たちは、いずれもその解き明かしを、わたしに示すことができなかったけれども、あなたにはそれができる。あなたのうちには、聖なる神の霊がやどっているからだ」。"},{"ref":"Dan.4.19","start":27004019,"end":27004019,"break":"paragraph","ruby":[[2,1,"とき"],[6,1,"な"],[34,1,"おどろ"],[37,1,"おも"],[39,1,"なや"],[45,1,"おう"],[47,1,"かれ"],[49,1,"つ"],[52,1,"い"],[72,1,"ゆめ"],[77,1,"と"],[79,1,"あ"],[87,1,"なや"],[91,1,"およ"],[105,1,"こた"],[108,1,"い"],[115,1,"しゅ"],[124,1,"ゆめ"],[131,1,"にく"],[133,1,"もの"],[145,1,"と"],[147,1,"あ"],[156,1,"てき"],[158,1,"のぞ"]],"text":"その時、その名をベルテシャザルととなえるダニエルは、しばらくのあいだ驚き、思い悩んだので、王は彼に告げて言った、「ベルテシャザルよ、あなたはこの夢と、その解き明かしのために、悩むには及ばない」。ベルテシャザルは答えて言った、「わが主よ、どうか、この夢は、あなたを憎む者にかかわるように。この解き明かしは、あなたの敵に臨むように。"},{"ref":"Dan.4.20","start":27004020,"end":27004020,"break":"none","ruby":[[4,1,"み"],[8,1,"き"],[16,2,"せいちょう"],[20,1,"つよ"],[25,1,"てん"],[27,1,"たっ"],[33,1,"たか"],[40,1,"ち"],[42,1,"はて"],[46,1,"み"]],"text":"あなたが見られた木、すなわちその成長して強くなり、天に達するほどの高さになって、地の果までも見えわたり、"},{"ref":"Dan.4.21","start":27004021,"end":27004021,"break":"none","ruby":[[2,1,"は"],[4,1,"うつく"],[10,1,"み"],[12,1,"ゆた"],[20,1,"もの"],[24,1,"なか"],[27,2,"しょくもつ"],[30,1,"え"],[34,1,"の"],[36,1,"けもの"],[40,1,"かげ"],[46,1,"そら"],[48,1,"とり"],[52,1,"えだ"],[54,1,"す"],[57,1,"き"]],"text":"その葉は美しく、その実は豊かで、すべての者がその中から食物を獲、また野の獣がその陰にやどり、空の鳥がその枝に住んだ木、"},{"ref":"Dan.4.22","start":27004022,"end":27004022,"break":"none","ruby":[[0,1,"おう"],[20,2,"せいちょう"],[24,1,"つよ"],[29,1,"てん"],[31,1,"たっ"],[37,1,"おお"],[47,2,"しゅけん"],[50,1,"ち"],[52,1,"はて"],[56,1,"およ"]],"text":"王よ、それはすなわちあなたです。あなたは成長して強くなり、天に達するほどに大きくなり、あなたの主権は地の果にまで及びました。"},{"ref":"Dan.4.23","start":27004023,"end":27004023,"break":"none","ruby":[[5,1,"おう"],[11,3,"けいごしゃ"],[19,2,"せいじゃ"],[23,1,"てん"],[26,1,"くだ"],[32,1,"い"],[36,1,"み"],[46,1,"き"],[48,1,"き"],[50,1,"たお"],[57,1,"ほろ"],[66,1,"ね"],[68,1,"き"],[70,1,"かぶ"],[72,1,"ち"],[74,1,"のこ"],[80,1,"てつ"],[82,2,"せいどう"],[92,1,"の"],[94,2,"わかくさ"],[97,1,"なか"],[102,1,"てん"],[108,1,"つゆ"],[117,1,"の"],[119,1,"けもの"],[121,1,"とも"],[125,1,"ぶん"],[137,1,"とき"],[139,1,"す"]],"text":"ところが、王はひとりの警護者、ひとりの聖者が、天から下って、こう言うのを見られました、『この木を切り倒して、これを滅ぼせ。ただしその根の切り株を地に残し、それに鉄と青銅のなわをかけて、野の若草の中におき、天からくだる露にぬれさせ、また野の獣と共にその分にあずからせて、七つの時を過ごさせよ』と。"},{"ref":"Dan.4.24","start":27004024,"end":27004024,"break":"none","ruby":[[0,1,"おう"],[5,1,"と"],[7,1,"あ"],[25,1,"たか"],[27,1,"もの"],[29,2,"めいれい"],[38,1,"しゅ"],[41,1,"おう"],[43,1,"のぞ"]],"text":"王よ、その解き明かしはこうです。すなわちこれはいと高き者の命令であって、わが主なる王に臨まんとするものです。"},{"ref":"Dan.4.25","start":27004025,"end":27004025,"break":"none","ruby":[[8,1,"お"],[12,1,"よ"],[14,1,"ひと"],[16,1,"はな"],[19,1,"の"],[21,1,"けもの"],[23,1,"とも"],[28,1,"うし"],[33,1,"くさ"],[35,1,"く"],[38,1,"てん"],[44,1,"つゆ"],[61,1,"とき"],[63,1,"す"],[77,1,"たか"],[79,1,"もの"],[81,2,"にんげん"],[84,1,"くに"],[86,1,"おさ"],[90,2,"じぶん"],[93,1,"い"],[102,1,"ひと"],[104,1,"あた"],[112,1,"し"],[115,1,"いた"]],"text":"すなわちあなたは追われて世の人を離れ、野の獣と共におり、牛のように草を食い、天からくだる露にぬれるでしょう。こうして七つの時が過ぎて、ついにあなたは、いと高き者が人間の国を治めて、自分の意のままに、これを人に与えられることを知るに至るでしょう。"},{"ref":"Dan.4.26","start":27004026,"end":27004026,"break":"none","ruby":[[2,1,"かれ"],[7,1,"き"],[9,1,"ね"],[11,1,"き"],[13,1,"かぶ"],[15,1,"のこ"],[20,1,"めい"],[31,1,"てん"],[37,3,"しはいしゃ"],[49,1,"し"],[52,1,"のち"],[58,1,"くに"],[64,2,"かくほ"]],"text":"また彼らはその木の根の切り株を残しおけと命じたので、あなたが、天はまことの支配者であるということを知った後、あなたの国はあなたに確保されるでしょう。"},{"ref":"Dan.4.27","start":27004027,"end":27004027,"break":"none","ruby":[[4,1,"おう"],[15,2,"かんこく"],[21,1,"ぎ"],[23,1,"い"],[26,1,"つみ"],[28,1,"はな"],[38,1,"もの"],[46,2,"ふぎ"],[49,1,"はな"],[69,2,"はんえい"],[73,1,"なが"],[75,1,"つづ"]],"text":"それゆえ王よ、あなたはわたしの勧告をいれ、義を行って罪を離れ、しえたげられる者をあわれんで、不義を離れなさい。そうすれば、あるいはあなたの繁栄が、長く続くかもしれません」。"},{"ref":"Dan.4.28","start":27004028,"end":27004028,"break":"paragraph","ruby":[[2,1,"こと"],[4,1,"みな"],[12,1,"おう"],[14,1,"のぞ"]],"text":"この事は皆ネブカデネザル王に臨んだ。"},{"ref":"Dan.4.29","start":27004029,"end":27004029,"break":"none","ruby":[[3,1,"げつ"],[5,1,"へ"],[7,1,"のち"],[9,1,"おう"],[16,2,"おうきゅう"],[19,2,"おくじょう"],[22,1,"ある"]],"text":"十二か月を経て後、王がバビロンの王宮の屋上を歩いていたとき、"},{"ref":"Dan.4.30","start":27004030,"end":27004030,"break":"none","ruby":[[0,1,"おう"],[2,1,"みずか"],[4,1,"い"],[11,1,"おお"],[25,1,"おお"],[29,1,"ちから"],[34,1,"た"],[37,2,"おうじょう"],[46,2,"いこう"],[49,1,"かがや"]],"text":"王は自ら言った、「この大いなるバビロンは、わたしの大いなる力をもって建てた王城であって、わが威光を輝かすものではないか」。"},{"ref":"Dan.4.31","start":27004031,"end":27004031,"break":"none","ruby":[[2,2,"ことば"],[7,1,"おう"],[9,1,"くち"],[17,1,"てん"],[20,1,"こえ"],[26,1,"い"],[38,1,"おう"],[45,1,"つ"],[49,1,"くに"],[55,1,"はな"],[57,1,"さ"]],"text":"その言葉がなお王の口にあるうちに、天から声がくだって言った、「ネブカデネザル王よ、あなたに告げる。国はあなたを離れ去った。"},{"ref":"Dan.4.32","start":27004032,"end":27004032,"break":"none","ruby":[[5,1,"お"],[9,1,"よ"],[11,1,"ひと"],[13,1,"はな"],[16,1,"の"],[18,1,"けもの"],[20,1,"とも"],[25,1,"うし"],[30,1,"くさ"],[32,1,"く"],[42,1,"とき"],[44,1,"へ"],[57,1,"たか"],[59,1,"もの"],[61,2,"にんげん"],[64,1,"くに"],[66,1,"おさ"],[70,2,"じぶん"],[73,1,"い"],[82,1,"ひと"],[84,1,"あた"],[92,1,"し"],[95,1,"いた"]],"text":"あなたは、追われて世の人を離れ、野の獣と共におり、牛のように草を食い、こうして七つの時を経て、ついにあなたは、いと高き者が人間の国を治めて、自分の意のままに、これを人に与えられることを知るに至るだろう」。"},{"ref":"Dan.4.33","start":27004033,"end":27004033,"break":"none","ruby":[[2,2,"ことば"],[18,2,"じょうじゅ"],[23,1,"かれ"],[25,1,"お"],[29,1,"よ"],[31,1,"ひと"],[33,1,"はな"],[36,1,"うし"],[41,1,"くさ"],[43,1,"く"],[48,1,"み"],[50,1,"てん"],[56,1,"つゆ"],[66,1,"け"],[72,1,"はね"],[85,1,"とり"]],"text":"この言葉は、ただちにネブカデネザルに成就した。彼は追われて世の人を離れ、牛のように草を食い、その身は天からくだる露にぬれ、ついにその毛は、わしの羽のようになり、そのつめは鳥のつめのようになった。"},{"ref":"Dan.4.34","start":27004034,"end":27004034,"break":"paragraph","breaks":[[89,"stanza"],[100,"line"]],"ruby":[[6,2,"きかん"],[9,1,"み"],[12,1,"のち"],[25,1,"め"],[30,1,"てん"],[32,1,"あお"],[34,1,"み"],[42,2,"りせい"],[45,2,"じぶん"],[48,1,"かえ"],[60,1,"たか"],[62,1,"もの"],[69,2,"えいえん"],[72,1,"い"],[75,1,"もの"],[91,2,"しゅけん"],[94,2,"えいえん"],[97,2,"しゅけん"],[102,1,"くに"],[104,2,"よよ"]],"text":"こうしてその期間が満ちた後、われネブカデネザルは、目をあげて天を仰ぎ見ると、わたしの理性が自分に帰ったので、わたしはいと高き者をほめ、その永遠に生ける者をさんびし、かつあがめた。その主権は永遠の主権、その国は世々かぎりなく、"},{"ref":"Dan.4.35","start":27004035,"end":27004035,"break":"line","breaks":[[20,"line"],[27,"line"],[35,"line"],[51,"line"],[62,"line"]],"ruby":[[0,1,"ち"],[2,1,"す"],[4,1,"たみ"],[9,1,"な"],[11,1,"もの"],[16,1,"おも"],[20,1,"てん"],[22,1,"しゅう"],[23,1,"ぐん"],[27,1,"ち"],[29,1,"す"],[31,1,"たみ"],[35,1,"かれ"],[39,1,"い"],[44,1,"こと"],[46,1,"おこな"],[54,1,"かれ"],[56,1,"て"],[67,1,"なに"],[75,1,"い"],[79,1,"もの"]],"text":"地に住む民はすべて無き者のように思われ、天の衆群にも、地に住む民にも、彼はその意のままに事を行われる。だれも彼の手をおさえて「あなたは何をするのか」と言いうる者はない。"},{"ref":"Dan.4.36","start":27004036,"end":27004036,"break":"none","ruby":[[2,1,"とき"],[7,2,"りせい"],[10,2,"じぶん"],[13,1,"かえ"],[20,1,"くに"],[22,2,"こうえい"],[31,2,"そんげん"],[34,2,"こうき"],[43,1,"かえ"],[49,2,"だいじん"],[54,2,"きぞく"],[65,1,"もと"],[72,1,"くに"],[74,1,"うえ"],[76,1,"かた"],[78,1,"た"],[82,1,"まえ"],[89,1,"おお"],[93,1,"もの"]],"text":"この時わたしの理性は自分に帰り、またわが国の光栄のために、わが尊厳と光輝とが、わたしに帰った。わが大臣、わが貴族らもきて、わたしに求め、わたしは国の上に堅く立って、前にもまさって大いなる者となった。"},{"ref":"Dan.4.37","start":27004037,"end":27004037,"break":"none","ruby":[[13,1,"いま"],[15,1,"てん"],[17,1,"おう"],[47,2,"しんじつ"],[53,1,"みち"],[55,1,"ただ"],[59,1,"たか"],[62,1,"あゆ"],[64,1,"もの"],[66,1,"ひく"]],"text":"そこでわれネブカデネザルは今、天の王をほめたたえ、かつあがめたてまつる。そのみわざはことごとく真実で、その道は正しく、高ぶり歩む者を低くされる。"}]