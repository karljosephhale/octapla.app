[{"ref":"1John.5.1","start":62005001,"end":62005001,"break":"paragraph","ruby":[[17,1,"しん"],[20,1,"もの"],[23,1,"かみ"],[26,1,"うま"],[29,1,"もの"],[37,1,"う"],[40,1,"くだ"],[47,1,"あい"],[50,1,"もの"],[59,1,"うま"],[62,1,"もの"],[65,1,"あい"]],"text":"すべてイエスのキリストであることを信じる者は、神から生れた者である。すべて生んで下さったかたを愛する者は、そのかたから生れた者をも愛するのである。"},{"ref":"1John.5.2","start":62005002,"end":62005002,"break":"none","ruby":[[0,1,"かみ"],[2,1,"あい"],[7,1,"いまし"],[10,1,"おこな"],[27,1,"かみ"],[29,1,"こ"],[33,1,"あい"],[41,1,"し"]],"text":"神を愛してその戒めを行えば、それによってわたしたちは、神の子たちを愛していることを知るのである。"},{"ref":"1John.5.3","start":62005003,"end":62005003,"break":"none","ruby":[[0,1,"かみ"],[2,1,"あい"],[15,1,"いまし"],[18,1,"まも"],[32,1,"いまし"]],"text":"神を愛するとは、すなわち、その戒めを守ることである。そして、その戒めはむずかしいものではない。"},{"ref":"1John.5.4","start":62005004,"end":62005004,"break":"none","ruby":[[8,1,"かみ"],[11,1,"うま"],[14,1,"もの"],[17,1,"よ"],[19,1,"か"],[37,2,"しんこう"],[42,1,"よ"],[44,1,"か"],[49,2,"しょうり"],[52,1,"ちから"]],"text":"なぜなら、すべて神から生れた者は、世に勝つからである。そして、わたしたちの信仰こそ、世に勝たしめた勝利の力である。"},{"ref":"1John.5.5","start":62005005,"end":62005005,"break":"none","ruby":[[0,1,"よ"],[2,1,"か"],[4,1,"もの"],[14,1,"かみ"],[16,1,"こ"],[18,1,"しん"],[21,1,"もの"]],"text":"世に勝つ者はだれか。イエスを神の子と信じる者ではないか。"},{"ref":"1John.5.6","start":62005006,"end":62005006,"break":"none","ruby":[[12,1,"みず"],[14,1,"ち"],[31,1,"みず"],[42,1,"みず"],[44,1,"ち"],[71,2,"みたま"],[77,2,"みたま"],[80,2,"しんり"]],"text":"このイエス・キリストは、水と血とをとおってこられたかたである。水によるだけではなく、水と血とによってこられたのである。そのあかしをするものは、御霊である。御霊は真理だからである。"},{"ref":"1John.5.7","start":62005007,"end":62005007,"break":"none","text":"あかしをするものが、三つある。"},{"ref":"1John.5.8","start":62005008,"end":62005008,"break":"none","ruby":[[0,2,"みたま"],[3,1,"みず"],[5,1,"ち"],[23,2,"いっち"]],"text":"御霊と水と血とである。そして、この三つのものは一致する。"},{"ref":"1John.5.9","start":62005009,"end":62005009,"break":"none","ruby":[[6,2,"にんげん"],[13,1,"う"],[24,1,"かみ"],[40,1,"かみ"],[56,2,"みこ"],[62,1,"た"]],"text":"わたしたちは人間のあかしを受けいれるが、しかし、神のあかしはさらにまさっている。神のあかしというのは、すなわち、御子について立てられたあかしである。"},{"ref":"1John.5.10","start":62005010,"end":62005010,"break":"none","ruby":[[0,1,"かみ"],[2,1,"こ"],[4,1,"しん"],[7,1,"もの"],[10,2,"じぶん"],[22,1,"も"],[28,1,"かみ"],[30,1,"しん"],[34,1,"もの"],[37,1,"かみ"],[39,1,"いつわ"],[41,1,"もの"],[46,1,"かみ"],[48,2,"みこ"],[68,1,"しん"]],"text":"神の子を信じる者は、自分のうちにこのあかしを持っている。神を信じない者は、神を偽り者とする。神が御子についてあかしせられたそのあかしを、信じていないからである。"},{"ref":"1John.5.11","start":62005011,"end":62005011,"break":"none","ruby":[[8,1,"かみ"],[10,2,"えいえん"],[23,1,"たま"],[36,2,"みこ"]],"text":"そのあかしとは、神が永遠のいのちをわたしたちに賜わり、かつ、そのいのちが御子のうちにあるということである。"},{"ref":"1John.5.12","start":62005012,"end":62005012,"break":"none","ruby":[[0,2,"みこ"],[3,1,"も"],[5,1,"もの"],[11,1,"も"],[14,1,"かみ"],[16,2,"みこ"],[19,1,"も"],[23,1,"もの"],[29,1,"も"]],"text":"御子を持つ者はいのちを持ち、神の御子を持たない者はいのちを持っていない。"},{"ref":"1John.5.13","start":62005013,"end":62005013,"break":"paragraph","ruby":[[13,1,"か"],[22,1,"かみ"],[24,1,"こ"],[26,2,"みな"],[29,1,"しん"],[39,2,"えいえん"],[46,1,"も"],[55,1,"さと"]],"text":"これらのことをあなたがたに書きおくったのは、神の子の御名を信じるあなたがたに、永遠のいのちを持っていることを、悟らせるためである。"},{"ref":"1John.5.14","start":62005014,"end":62005014,"break":"none","ruby":[[6,1,"かみ"],[8,1,"たい"],[17,2,"かくしん"],[38,2,"なにごと"],[42,1,"かみ"],[44,2,"みむね"],[47,1,"したが"],[50,1,"ねが"],[52,1,"もと"],[58,1,"かみ"],[63,1,"き"],[68,1,"くだ"]],"text":"わたしたちが神に対していだいている確信は、こうである。すなわち、わたしたちが何事でも神の御旨に従って願い求めるなら、神はそれを聞きいれて下さるということである。"},{"ref":"1John.5.15","start":62005015,"end":62005015,"break":"none","ruby":[[10,1,"ねが"],[12,1,"もと"],[23,1,"き"],[28,1,"くだ"],[37,1,"かみ"],[39,1,"ねが"],[41,1,"もと"],[60,1,"し"]],"text":"そして、わたしたちが願い求めることは、なんでも聞きいれて下さるとわかれば、神に願い求めたことはすでにかなえられたことを、知るのである。"},{"ref":"1John.5.16","start":62005016,"end":62005016,"break":"none","ruby":[[6,1,"し"],[8,1,"いた"],[15,1,"つみ"],[17,1,"おか"],[22,2,"きょうだい"],[25,1,"み"],[29,1,"かみ"],[31,1,"ねが"],[33,1,"もと"],[44,1,"かみ"],[47,1,"し"],[49,1,"いた"],[56,1,"つみ"],[58,1,"おか"],[63,2,"ひとびと"],[72,1,"たま"],[80,1,"し"],[82,1,"いた"],[84,1,"つみ"],[97,1,"ねが"],[99,1,"もと"],[105,1,"い"]],"text":"もしだれかが死に至ることのない罪を犯している兄弟を見たら、神に願い求めなさい。そうすれば神は、死に至ることのない罪を犯している人々には、いのちを賜わるであろう。死に至る罪がある。これについては、願い求めよ、とは言わない。"},{"ref":"1John.5.17","start":62005017,"end":62005017,"break":"none","ruby":[[0,2,"ふぎ"],[7,1,"つみ"],[16,1,"し"],[18,1,"いた"],[25,1,"つみ"]],"text":"不義はすべて、罪である。しかし、死に至ることのない罪もある。"},{"ref":"1John.5.18","start":62005018,"end":62005018,"break":"paragraph","ruby":[[3,1,"かみ"],[6,1,"うま"],[9,1,"もの"],[11,1,"つみ"],[13,1,"おか"],[27,1,"し"],[33,1,"かみ"],[36,1,"うま"],[42,1,"かれ"],[44,1,"まも"],[49,1,"くだ"],[55,1,"あ"],[58,1,"もの"],[60,1,"て"],[62,1,"ふ"]],"text":"すべて神から生れた者は罪を犯さないことを、わたしたちは知っている。神から生れたかたが彼を守っていて下さるので、悪しき者が手を触れるようなことはない。"},{"ref":"1John.5.19","start":62005019,"end":62005019,"break":"none","ruby":[[9,1,"かみ"],[12,1,"で"],[14,1,"もの"],[19,1,"ぜん"],[20,2,"せかい"],[23,1,"あ"],[26,1,"もの"],[28,2,"はいか"],[37,1,"し"]],"text":"また、わたしたちは神から出た者であり、全世界は悪しき者の配下にあることを、知っている。"},{"ref":"1John.5.20","start":62005020,"end":62005020,"break":"none","ruby":[[4,1,"かみ"],[6,1,"こ"],[11,2,"しんじつ"],[17,1,"し"],[19,2,"ちりょく"],[28,1,"さづ"],[31,1,"くだ"],[39,1,"し"],[56,2,"しんじつ"],[65,2,"みこ"],[88,2,"しんじつ"],[91,1,"かみ"],[96,2,"えいえん"]],"text":"さらに、神の子がきて、真実なかたを知る知力をわたしたちに授けて下さったことも、知っている。そして、わたしたちは、真実なかたにおり、御子イエス・キリストにおるのである。このかたは真実な神であり、永遠のいのちである。"},{"ref":"1John.5.21","start":62005021,"end":62005021,"break":"none","ruby":[[0,1,"こ"],[5,1,"き"],[11,2,"ぐうぞう"],[14,1,"さ"]],"text":"子たちよ。気をつけて、偶像を避けなさい。"}]