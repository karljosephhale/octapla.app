[{"ref":"Prov.7.1","start":20007001,"end":20007001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[2,1,"こ"],[9,2,"ことば"],[12,1,"まも"],[19,1,"いまし"],[26,1,"こころ"]],"text":"わが子よ、わたしの言葉を守り、わたしの戒めをあなたの心にたくわえよ。"},{"ref":"Prov.7.2","start":20007002,"end":20007002,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"いまし"],[7,1,"まも"],[10,1,"いのち"],[12,1,"え"],[19,1,"おしえ"],[21,1,"まも"],[30,1,"まも"]],"text":"わたしの戒めを守って命を得よ、わたしの教を守ること、ひとみを守るようにせよ。"},{"ref":"Prov.7.3","start":20007003,"end":20007003,"break":"line","breaks":[[13,"line"]],"ruby":[[7,1,"ゆび"],[20,1,"こころ"],[22,1,"いしぶみ"]],"text":"これをあなたの指にむすび、これをあなたの心の碑にしるせ。"},{"ref":"Prov.7.4","start":20007004,"end":20007004,"break":"line","breaks":[[23,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"む"],[15,2,"しまい"],[20,1,"い"],[23,1,"さと"],[26,1,"む"],[36,1,"とも"],[38,1,"よ"]],"text":"知恵に向かって、「あなたはわが姉妹だ」と言い、悟りに向かっては、あなたの友と呼べ。"},{"ref":"Prov.7.5","start":20007005,"end":20007005,"break":"line","breaks":[[24,"line"]],"ruby":[[13,1,"まも"],[16,2,"ゆうじょ"],[19,1,"まよ"],[24,2,"ことば"],[26,1,"たく"],[34,1,"おんな"],[36,1,"ちか"]],"text":"そうすれば、これはあなたを守って遊女に迷わせず、言葉巧みな、みだらな女に近づかせない。"},{"ref":"Prov.7.6","start":20007006,"end":20007006,"break":"line","breaks":[[13,"line"]],"ruby":[[6,1,"いえ"],[8,1,"まど"],[13,2,"こうし"],[15,1,"まど"],[18,1,"そと"]],"text":"わたしはわが家の窓により、格子窓から外をのぞいて、"},{"ref":"Prov.7.7","start":20007007,"end":20007007,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"しりょ"],[5,1,"もの"],[11,1,"わか"],[13,1,"もの"],[23,2,"ちえ"],[28,2,"わかもの"],[35,1,"み"]],"text":"思慮のない者のうちに、若い者のうちに、ひとりの知恵のない若者のいるのを見た。"},{"ref":"Prov.7.8","start":20007008,"end":20007008,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かれ"],[6,1,"す"],[9,1,"おんな"],[11,1,"いえ"],[13,1,"い"],[15,1,"まが"],[20,1,"ちか"],[26,1,"いえ"],[28,1,"い"],[30,1,"みち"]],"text":"彼はちまたを過ぎ、女の家に行く曲りかどに近づき、その家に行く道を、"},{"ref":"Prov.7.9","start":20007009,"end":20007009,"break":"line","breaks":[[10,"line"]],"ruby":[[12,2,"よなか"],[18,1,"くら"],[22,1,"ある"]],"text":"たそがれに、よいに、また夜中に、また暗やみに歩いていった。"},{"ref":"Prov.7.10","start":20007010,"end":20007010,"break":"line","ruby":[[0,1,"み"],[3,2,"ゆうじょ"],[6,1,"よそお"],[11,2,"いんけん"],[14,1,"おんな"],[16,1,"かれ"],[18,1,"あ"]],"text":"見よ、遊女の装いをした陰険な女が彼に会う。"},{"ref":"Prov.7.11","start":20007011,"end":20007011,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"おんな"],[5,1,"さわ"],[11,1,"つつし"],[18,1,"あし"],[20,2,"じぶん"],[23,1,"いえ"]],"text":"この女は、騒がしくて、慎みなく、その足は自分の家にとどまらず、"},{"ref":"Prov.7.12","start":20007012,"end":20007012,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"とき"],[13,1,"とき"],[15,2,"いちば"],[26,1,"た"],[29,1,"ひと"]],"text":"ある時はちまたにあり、ある時は市場にあり、すみずみに立って人をうかがう。"},{"ref":"Prov.7.13","start":20007013,"end":20007013,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"おんな"],[4,1,"かれ"],[6,1,"とら"],[9,1,"くち"],[14,1,"はじ"],[18,1,"かお"],[20,1,"かれ"],[22,1,"い"]],"text":"この女は彼を捕えて口づけし、恥しらぬ顔で彼に言う、"},{"ref":"Prov.7.14","start":20007014,"end":20007014,"break":"line","breaks":[[24,"line"]],"ruby":[[5,3,"しゅうおんさい"],[30,1,"ちか"],[33,1,"はた"]],"text":"「わたしは酬恩祭をささげなければならなかったが、きょう、その誓いを果しました。"},{"ref":"Prov.7.15","start":20007015,"end":20007015,"break":"line","breaks":[[19,"line"]],"ruby":[[11,1,"むか"],[16,1,"で"],[23,1,"たず"],[30,1,"あ"]],"text":"それでわたしはあなたを迎えようと出て、あなたを尋ね、あなたに会いました。"},{"ref":"Prov.7.16","start":20007016,"end":20007016,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"とこ"],[6,1,"うつく"],[22,1,"ぬの"],[24,1,"し"]],"text":"わたしは床に美しい、しとねと、エジプトのあや布を敷き、"},{"ref":"Prov.7.17","start":20007017,"end":20007017,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"もつやく"],[7,2,"けいひ"],[17,1,"とこ"]],"text":"没薬、ろかい、桂皮をもってわたしの床をにおわせました。"},{"ref":"Prov.7.18","start":20007018,"end":20007018,"break":"line","breaks":[[17,"line"]],"ruby":[[9,1,"よる"],[11,1,"あ"],[17,1,"じょう"],[23,1,"あい"],[29,1,"たの"]],"text":"さあ、わたしたちは夜が明けるまで、情をつくし、愛をかわして楽しみましょう。"},{"ref":"Prov.7.19","start":20007019,"end":20007019,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"おっと"],[2,1,"いえ"],[9,1,"とお"],[12,2,"たびだ"]],"text":"夫は家にいません、遠くへ旅立ち、"},{"ref":"Prov.7.20","start":20007020,"end":20007020,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"て"],[2,1,"かね"],[3,1,"ぶくろ"],[5,1,"も"],[8,1,"で"],[13,2,"まんげつ"],[21,1,"かえ"]],"text":"手に金袋を持って出ました。満月になるまでは帰りません」と。"},{"ref":"Prov.7.21","start":20007021,"end":20007021,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"おんな"],[2,1,"おお"],[12,2,"ことば"],[18,1,"かれ"],[20,1,"まど"],[24,1,"たく"]],"text":"女が多くの、なまめかしい言葉をもって彼を惑わし、巧みなくちびるをもって、いざなうと、"},{"ref":"Prov.7.22","start":20007022,"end":20007022,"break":"line","breaks":[[13,"line"],[31,"line"]],"ruby":[[0,1,"わか"],[2,1,"ひと"],[4,1,"ただ"],[7,1,"おんな"],[9,1,"したが"],[17,1,"うし"],[23,1,"ば"],[25,1,"い"],[31,1,"お"],[41,1,"とら"]],"text":"若い人は直ちに女に従った、あたかも牛が、ほふり場に行くように、雄じかが、すみやかに捕えられ、"},{"ref":"Prov.7.23","start":20007023,"end":20007023,"break":"line","breaks":[[19,"line"],[35,"line"]],"ruby":[[4,1,"や"],[8,2,"ないぞう"],[11,1,"つ"],[13,1,"さ"],[19,1,"とり"],[26,1,"あみ"],[35,1,"かれ"],[37,2,"じぶん"],[40,1,"いのち"],[42,1,"うしな"],[52,1,"し"]],"text":"ついに、矢がその内臓を突き刺すように、鳥がすみやかに網にかかるように、彼は自分が命を失うようになることを知らない。"},{"ref":"Prov.7.24","start":20007024,"end":20007024,"break":"stanza","breaks":[[18,"line"]],"ruby":[[0,2,"こども"],[5,1,"いま"],[10,1,"い"],[15,1,"き"],[20,1,"くち"],[22,2,"ことば"],[25,1,"みみ"],[27,1,"かたむ"]],"text":"子供らよ、今わたしの言うことを聞き、わが口の言葉に耳を傾けよ。"},{"ref":"Prov.7.25","start":20007025,"end":20007025,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"こころ"],[6,2,"かのじょ"],[9,1,"みち"],[11,1,"かたむ"],[24,1,"みち"],[26,1,"まよ"]],"text":"あなたの心を彼女の道に傾けてはならない、またその道に迷ってはならない。"},{"ref":"Prov.7.26","start":20007026,"end":20007026,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"おお"],[6,1,"ひと"],[8,1,"きず"],[12,1,"たお"],[21,2,"かのじょ"],[24,1,"ころ"],[28,1,"もの"],[30,1,"おお"]],"text":"彼女は多くの人を傷つけて倒した、まことに、彼女に殺された者は多い。"},{"ref":"Prov.7.27","start":20007027,"end":20007027,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"いえ"],[4,2,"よみ"],[7,1,"い"],[9,1,"みち"],[15,1,"し"],[20,1,"くだ"],[23,1,"い"]],"text":"その家は陰府へ行く道であって、死のへやへ下って行く。"}]