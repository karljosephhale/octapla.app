[{"ref":"John.12.1","start":43012001,"end":43012001,"break":"paragraph","ruby":[[0,2,"すぎこし"],[3,1,"まつり"],[6,1,"か"],[20,1,"い"],[33,2,"しにん"],[36,1,"なか"],[52,1,"ところ"]],"text":"過越の祭の六日まえに、イエスはベタニヤに行かれた。そこは、イエスが死人の中からよみがえらせたラザロのいた所である。"},{"ref":"John.12.2","start":43012002,"end":43012002,"break":"none","ruby":[[10,2,"ゆうしょく"],[13,2,"ようい"],[23,2,"きゅうじ"],[35,2,"いっしょ"],[38,2,"しょくたく"],[46,1,"もの"],[56,1,"くわ"]],"text":"イエスのためにそこで夕食の用意がされ、マルタは給仕をしていた。イエスと一緒に食卓についていた者のうちに、ラザロも加わっていた。"},{"ref":"John.12.3","start":43012003,"end":43012003,"break":"none","ruby":[[2,1,"とき"],[8,2,"こうか"],[11,2,"じゅんすい"],[18,2,"こうゆ"],[21,1,"きん"],[23,1,"も"],[33,1,"あし"],[38,2,"じぶん"],[41,1,"かみ"],[43,1,"け"],[56,2,"こうゆ"],[63,1,"いえ"]],"text":"その時、マリヤは高価で純粋なナルドの香油一斤を持ってきて、イエスの足にぬり、自分の髪の毛でそれをふいた。すると、香油のかおりが家にいっぱいになった。"},{"ref":"John.12.4","start":43012004,"end":43012004,"break":"none","ruby":[[0,2,"でし"],[12,2,"うらぎ"],[31,1,"い"]],"text":"弟子のひとりで、イエスを裏切ろうとしていたイスカリオテのユダが言った、"},{"ref":"John.12.5","start":43012005,"end":43012005,"break":"none","ruby":[[5,2,"こうゆ"],[14,1,"う"],[18,1,"まず"],[21,1,"ひと"],[26,1,"ほどこ"]],"text":"「なぜこの香油を三百デナリに売って、貧しい人たちに、施さなかったのか」。"},{"ref":"John.12.6","start":43012006,"end":43012006,"break":"none","ruby":[[0,1,"かれ"],[4,1,"い"],[10,1,"まず"],[13,1,"ひと"],[17,1,"たい"],[20,1,"おも"],[35,2,"じぶん"],[38,2,"ぬすびと"],[44,2,"さいふ"],[47,1,"あず"],[56,2,"なかみ"]],"text":"彼がこう言ったのは、貧しい人たちに対する思いやりがあったからではなく、自分が盗人であり、財布を預かっていて、その中身をごまかしていたからであった。"},{"ref":"John.12.7","start":43012007,"end":43012007,"break":"none","ruby":[[4,1,"い"],[12,1,"おんな"],[32,1,"ほうむ"],[35,1,"ひ"]],"text":"イエスは言われた、「この女のするままにさせておきなさい。わたしの葬りの日のために、それをとっておいたのだから。"},{"ref":"John.12.8","start":43012008,"end":43012008,"break":"none","ruby":[[0,1,"まず"],[3,1,"ひと"],[16,1,"とも"],[29,1,"とも"]],"text":"貧しい人たちはいつもあなたがたと共にいるが、わたしはいつも共にいるわけではない」。"},{"ref":"John.12.9","start":43012009,"end":43012009,"break":"none","ruby":[[0,1,"おお"],[7,1,"じん"],[25,1,"し"],[29,1,"お"],[44,1,"あ"],[59,2,"しにん"],[78,1,"み"]],"text":"大ぜいのユダヤ人たちが、そこにイエスのおられるのを知って、押しよせてきた。それはイエスに会うためだけではなく、イエスが死人のなかから、よみがえらせたラザロを見るためでもあった。"},{"ref":"John.12.10","start":43012010,"end":43012010,"break":"none","ruby":[[3,3,"さいしちょう"],[14,1,"ころ"],[18,2,"そうだん"]],"text":"そこで祭司長たちは、ラザロも殺そうと相談した。"},{"ref":"John.12.11","start":43012011,"end":43012011,"break":"none","ruby":[[12,1,"おお"],[18,1,"じん"],[20,1,"かれ"],[23,1,"はな"],[25,1,"さ"],[33,1,"しん"],[37,1,"いた"]],"text":"それは、ラザロのことで、多くのユダヤ人が彼らを離れ去って、イエスを信じるに至ったからである。"},{"ref":"John.12.12","start":43012012,"end":43012012,"break":"paragraph","ruby":[[2,2,"よくじつ"],[5,1,"まつり"],[11,1,"おお"],[15,2,"ぐんしゅう"],[34,1,"き"]],"text":"その翌日、祭にきていた大ぜいの群衆は、イエスがエルサレムにこられると聞いて、"},{"ref":"John.12.13","start":43012013,"end":43012013,"break":"none","breaks":[[27,"stanza"],[32,"line"],[50,"line"]],"ruby":[[4,1,"えだ"],[6,1,"て"],[11,1,"むか"],[14,1,"で"],[16,1,"い"],[23,1,"さけ"],[32,1,"しゅ"],[34,2,"みな"],[43,1,"もの"],[45,2,"しゅくふく"],[56,1,"おう"]],"text":"しゅろの枝を手にとり、迎えに出て行った。そして叫んだ、「ホサナ、主の御名によってきたる者に祝福あれ、イスラエルの王に」。"},{"ref":"John.12.14","start":43012014,"end":43012014,"break":"none","ruby":[[8,1,"こ"],[10,1,"み"],[17,1,"うえ"],[19,1,"の"]],"text":"イエスは、ろばの子を見つけて、その上に乗られた。それは"},{"ref":"John.12.15","start":43012015,"end":43012015,"break":"stanza","breaks":[[13,"line"],[22,"line"]],"ruby":[[5,1,"むすめ"],[8,1,"おそ"],[13,1,"み"],[20,1,"おう"],[25,1,"こ"],[27,1,"の"],[38,1,"か"]],"text":"「シオンの娘よ、恐れるな。見よ、あなたの王がろばの子に乗っておいでになる」と書いてあるとおりであった。"},{"ref":"John.12.16","start":43012016,"end":43012016,"break":"none","ruby":[[0,2,"でし"],[5,1,"はじ"],[14,1,"さと"],[26,2,"えいこう"],[29,1,"う"],[34,1,"とき"],[49,1,"か"],[65,2,"ひとびと"],[72,1,"たい"],[86,1,"おも"],[88,1,"おこ"]],"text":"弟子たちは初めにはこのことを悟らなかったが、イエスが栄光を受けられた時に、このことがイエスについて書かれてあり、またそのとおりに、人々がイエスに対してしたのだということを、思い起した。"},{"ref":"John.12.17","start":43012017,"end":43012017,"break":"none","ruby":[[11,1,"はか"],[14,1,"よ"],[16,1,"だ"],[20,2,"しにん"],[23,1,"なか"],[40,2,"いっしょ"],[45,2,"ぐんしゅう"]],"text":"また、イエスがラザロを墓から呼び出して、死人の中からよみがえらせたとき、イエスと一緒にいた群衆が、そのあかしをした。"},{"ref":"John.12.18","start":43012018,"end":43012018,"break":"none","ruby":[[0,2,"ぐんしゅう"],[7,1,"むか"],[10,1,"で"],[28,1,"おこな"],[36,1,"き"]],"text":"群衆がイエスを迎えに出たのは、イエスがこのようなしるしを行われたことを、聞いていたからである。"},{"ref":"John.12.19","start":43012019,"end":43012019,"break":"none","ruby":[[8,1,"びと"],[12,1,"たがい"],[14,1,"い"],[19,1,"なに"],[30,1,"よ"],[35,1,"かれ"],[40,1,"お"],[43,1,"い"]],"text":"そこで、パリサイ人たちは互に言った、「何をしてもむだだった。世をあげて彼のあとを追って行ったではないか」。"},{"ref":"John.12.20","start":43012020,"end":43012020,"break":"paragraph","ruby":[[0,1,"まつり"],[2,2,"れいはい"],[9,1,"のぼ"],[14,2,"ひとびと"],[21,2,"すうにん"],[28,1,"じん"]],"text":"祭で礼拝するために上ってきた人々のうちに、数人のギリシヤ人がいた。"},{"ref":"John.12.21","start":43012021,"end":43012021,"break":"none","ruby":[[0,1,"かれ"],[13,1,"で"],[29,1,"きみ"],[37,1,"め"],[50,1,"い"],[53,1,"たの"]],"text":"彼らはガリラヤのベツサイダ出であるピリポのところにきて、「君よ、イエスにお目にかかりたいのですが」と言って頼んだ。"},{"ref":"John.12.22","start":43012022,"end":43012022,"break":"none","ruby":[[13,1,"い"],[21,1,"はな"],[41,1,"い"],[44,1,"つた"]],"text":"ピリポはアンデレのところに行ってそのことを話し、アンデレとピリポは、イエスのもとに行って伝えた。"},{"ref":"John.12.23","start":43012023,"end":43012023,"break":"none","ruby":[[8,1,"こた"],[11,1,"い"],[17,1,"ひと"],[19,1,"こ"],[21,2,"えいこう"],[24,1,"う"],[27,1,"とき"]],"text":"すると、イエスは答えて言われた、「人の子が栄光を受ける時がきた。"},{"ref":"John.12.24","start":43012024,"end":43012024,"break":"none","ruby":[[10,1,"い"],[17,1,"つぶ"],[19,1,"むぎ"],[21,1,"ち"],[23,1,"お"],[26,1,"し"],[39,1,"つぶ"],[53,1,"し"],[59,1,"ゆた"],[62,1,"み"],[64,1,"むす"]],"text":"よくよくあなたがたに言っておく。一粒の麦が地に落ちて死ななければ、それはただ一粒のままである。しかし、もし死んだなら、豊かに実を結ぶようになる。"},{"ref":"John.12.25","start":43012025,"end":43012025,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"いのち"],[5,1,"あい"],[8,1,"もの"],[13,1,"うしな"],[18,1,"よ"],[20,2,"じぶん"],[23,1,"いのち"],[25,1,"にく"],[27,1,"もの"],[33,1,"たも"],[36,2,"えいえん"],[39,1,"いのち"],[41,1,"いた"]],"text":"自分の命を愛する者はそれを失い、この世で自分の命を憎む者は、それを保って永遠の命に至るであろう。"},{"ref":"John.12.26","start":43012026,"end":43012026,"break":"none","ruby":[[6,1,"つか"],[13,1,"ひと"],[21,1,"ひと"],[27,1,"したが"],[30,1,"く"],[48,1,"ところ"],[55,1,"つか"],[58,1,"もの"],[76,1,"つか"],[83,1,"ひと"],[91,1,"ひと"],[93,1,"ちち"],[95,1,"おも"],[99,1,"くだ"]],"text":"もしわたしに仕えようとする人があれば、その人はわたしに従って来るがよい。そうすれば、わたしのおる所に、わたしに仕える者もまた、おるであろう。もしわたしに仕えようとする人があれば、その人を父は重んじて下さるであろう。"},{"ref":"John.12.27","start":43012027,"end":43012027,"break":"none","ruby":[[0,1,"いま"],[5,1,"こころ"],[7,1,"さわ"],[20,1,"い"],[25,1,"ちち"],[30,1,"とき"],[38,1,"すく"],[40,1,"くだ"],[60,1,"とき"],[62,1,"いた"]],"text":"今わたしは心が騒いでいる。わたしはなんと言おうか。父よ、この時からわたしをお救い下さい。しかし、わたしはこのために、この時に至ったのです。"},{"ref":"John.12.28","start":43012028,"end":43012028,"break":"none","ruby":[[0,1,"ちち"],[4,1,"な"],[21,1,"てん"],[24,1,"こえ"],[38,2,"えいこう"],[51,1,"さら"]],"text":"父よ、み名があがめられますように」。すると天から声があった、「わたしはすでに栄光をあらわした。そして、更にそれをあらわすであろう」。"},{"ref":"John.12.29","start":43012029,"end":43012029,"break":"none","ruby":[[7,1,"た"],[12,2,"ぐんしゅう"],[18,1,"き"],[23,1,"かみなり"],[32,1,"い"],[38,1,"ひと"],[44,2,"みつかい"],[47,1,"かれ"],[49,1,"はな"],[58,1,"い"]],"text":"すると、そこに立っていた群衆がこれを聞いて、「雷がなったのだ」と言い、ほかの人たちは、「御使が彼に話しかけたのだ」と言った。"},{"ref":"John.12.30","start":43012030,"end":43012030,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[15,1,"こえ"]],"text":"イエスは答えて言われた、「この声があったのは、わたしのためではなく、あなたがたのためである。"},{"ref":"John.12.31","start":43012031,"end":43012031,"break":"none","ruby":[[0,1,"いま"],[4,1,"よ"],[11,1,"とき"],[16,1,"いま"],[21,1,"よ"],[23,1,"きみ"],[25,1,"お"],[27,1,"だ"]],"text":"今はこの世がさばかれる時である。今こそこの世の君は追い出されるであろう。"},{"ref":"John.12.32","start":43012032,"end":43012032,"break":"none","ruby":[[10,1,"ち"],[13,1,"あ"],[18,1,"とき"],[26,1,"ひと"],[36,1,"ひ"]],"text":"そして、わたしがこの地から上げられる時には、すべての人をわたしのところに引きよせるであろう」。"},{"ref":"John.12.33","start":43012033,"end":43012033,"break":"none","ruby":[[6,1,"い"],[10,2,"じぶん"],[16,1,"し"],[18,1,"ほう"],[20,1,"し"],[32,1,"しめ"]],"text":"イエスはこう言って、自分がどんな死に方で死のうとしていたかを、お示しになったのである。"},{"ref":"John.12.34","start":43012034,"end":43012034,"break":"none","ruby":[[3,2,"ぐんしゅう"],[14,1,"い"],[25,2,"りっぽう"],[42,1,"い"],[55,1,"き"],[73,1,"ひと"],[75,1,"こ"],[77,1,"あ"],[89,1,"い"],[100,1,"ひと"],[102,1,"こ"]],"text":"すると群衆はイエスにむかって言った、「わたしたちは律法によって、キリストはいつまでも生きておいでになるのだ、と聞いていました。それだのに、どうして人の子は上げられねばならないと、言われるのですか。その人の子とは、だれのことですか」。"},{"ref":"John.12.35","start":43012035,"end":43012035,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[23,1,"あいだ"],[25,1,"ひかり"],[33,2,"いっしょ"],[42,1,"ひかり"],[46,1,"あいだ"],[48,1,"ある"],[55,1,"お"],[73,1,"なか"],[75,1,"ある"],[77,1,"もの"],[80,2,"じぶん"],[86,1,"い"]],"text":"そこでイエスは彼らに言われた、「もうしばらくの間、光はあなたがたと一緒にここにある。光がある間に歩いて、やみに追いつかれないようにしなさい。やみの中を歩く者は、自分がどこへ行くのかわかっていない。"},{"ref":"John.12.36","start":43012036,"end":43012036,"break":"none","breaks":[[26,"paragraph"]],"ruby":[[0,1,"ひかり"],[4,1,"あいだ"],[7,1,"ひかり"],[9,1,"こ"],[17,1,"ひかり"],[19,1,"しん"],[37,1,"はな"],[46,1,"た"],[48,1,"さ"],[52,1,"かれ"],[56,1,"み"],[59,1,"かく"]],"text":"光のある間に、光の子となるために、光を信じなさい」。イエスはこれらのことを話してから、そこを立ち去って、彼らから身をお隠しになった。"},{"ref":"John.12.37","start":43012037,"end":43012037,"break":"none","ruby":[[5,1,"おお"],[12,1,"かれ"],[15,1,"まえ"],[23,1,"かれ"],[30,1,"しん"]],"text":"このように多くのしるしを彼らの前でなさったが、彼らはイエスを信じなかった。"},{"ref":"John.12.38","start":43012038,"end":43012038,"break":"none","ruby":[[4,3,"よげんしゃ"],[11,1,"つぎ"],[13,2,"ことば"],[16,2,"じょうじゅ"],[27,1,"しゅ"],[36,1,"と"],[46,1,"しん"],[58,1,"しゅ"],[61,1,"うで"],[66,1,"しめ"]],"text":"それは、預言者イザヤの次の言葉が成就するためである、「主よ、わたしたちの説くところを、だれが信じたでしょうか。また、主のみ腕はだれに示されたでしょうか」。"},{"ref":"John.12.39","start":43012039,"end":43012039,"break":"none","ruby":[[8,1,"かれ"],[11,1,"しん"],[34,1,"い"]],"text":"こういうわけで、彼らは信じることができなかった。イザヤはまた、こうも言った、"},{"ref":"John.12.40","start":43012040,"end":43012040,"break":"none","ruby":[[1,1,"かみ"],[3,1,"かれ"],[6,1,"め"],[13,1,"こころ"],[29,1,"かれ"],[32,1,"め"],[34,1,"み"],[37,1,"こころ"],[39,1,"さと"],[43,1,"く"],[45,1,"あらた"]],"text":"「神は彼らの目をくらまし、心をかたくなになさった。それは、彼らが目で見ず、心で悟らず、悔い改めていやされることがないためである」。"},{"ref":"John.12.41","start":43012041,"end":43012041,"break":"none","ruby":[[6,1,"い"],[16,2,"えいこう"],[19,1,"み"],[35,1,"かた"]],"text":"イザヤがこう言ったのは、イエスの栄光を見たからであって、イエスのことを語ったのである。"},{"ref":"John.12.42","start":43012042,"end":43012042,"break":"none","ruby":[[4,2,"やくにん"],[9,1,"なか"],[17,1,"しん"],[20,1,"もの"],[22,1,"おお"],[32,1,"びと"],[40,2,"こくはく"],[49,2,"かいどう"],[53,1,"お"],[55,1,"だ"],[61,1,"おそ"]],"text":"しかし、役人たちの中にも、イエスを信じた者が多かったが、パリサイ人をはばかって、告白はしなかった。会堂から追い出されるのを恐れていたのである。"},{"ref":"John.12.43","start":43012043,"end":43012043,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かみ"],[12,1,"ひと"],[18,1,"この"]],"text":"彼らは神のほまれよりも、人のほまれを好んだからである。"},{"ref":"John.12.44","start":43012044,"end":43012044,"break":"paragraph","ruby":[[4,2,"おおごえ"],[7,1,"い"],[17,1,"しん"],[20,1,"もの"],[27,1,"しん"],[49,1,"しん"]],"text":"イエスは大声で言われた、「わたしを信じる者は、わたしを信じるのではなく、わたしをつかわされたかたを信じるのであり、"},{"ref":"John.12.45","start":43012045,"end":43012045,"break":"none","ruby":[[7,1,"み"],[9,1,"もの"],[25,1,"み"]],"text":"また、わたしを見る者は、わたしをつかわされたかたを見るのである。"},{"ref":"John.12.46","start":43012046,"end":43012046,"break":"none","ruby":[[4,1,"ひかり"],[10,1,"よ"],[23,1,"しん"],[26,1,"もの"]],"text":"わたしは光としてこの世にきた。それは、わたしを信じる者が、やみのうちにとどまらないようになるためである。"},{"ref":"John.12.47","start":43012047,"end":43012047,"break":"none","ruby":[[8,1,"い"],[13,1,"き"],[19,1,"まも"],[23,1,"ひと"],[36,1,"ひと"],[55,1,"よ"],[69,1,"よ"],[71,1,"すく"]],"text":"たとい、わたしの言うことを聞いてそれを守らない人があっても、わたしはその人をさばかない。わたしがきたのは、この世をさばくためではなく、この世を救うためである。"},{"ref":"John.12.48","start":43012048,"end":43012048,"break":"none","ruby":[[4,1,"す"],[12,2,"ことば"],[15,1,"う"],[21,1,"ひと"],[27,1,"ひと"],[42,1,"かた"],[47,2,"ことば"],[51,1,"おわ"],[54,1,"ひ"],[58,1,"ひと"]],"text":"わたしを捨てて、わたしの言葉を受けいれない人には、その人をさばくものがある。わたしの語ったその言葉が、終りの日にその人をさばくであろう。"},{"ref":"John.12.49","start":43012049,"end":43012049,"break":"none","ruby":[[4,2,"じぶん"],[8,1,"かた"],[27,1,"ちち"],[29,2,"じしん"],[37,1,"い"],[44,1,"かた"],[52,1,"めい"]],"text":"わたしは自分から語ったのではなく、わたしをつかわされた父ご自身が、わたしの言うべきこと、語るべきことをお命じになったのである。"},{"ref":"John.12.50","start":43012050,"end":43012050,"break":"none","ruby":[[7,2,"めいれい"],[10,2,"えいえん"],[13,1,"いのち"],[20,1,"し"],[36,1,"かた"],[49,1,"ちち"],[55,1,"おお"],[69,1,"かた"]],"text":"わたしは、この命令が永遠の命であることを知っている。それゆえに、わたしが語っていることは、わたしの父がわたしに仰せになったことを、そのまま語っているのである」。"}]