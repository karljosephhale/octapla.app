[{"ref":"Ps.32.1","start":19032001,"end":19032001,"break":"paragraph","title":"ダビデのマスキールの歌","breaks":[[10,"line"]],"ruby":[[12,1,"つみ"],[17,1,"け"],[21,1,"もの"]],"titleRuby":[[10,1,"うた"]],"text":"そのとががゆるされ、その罪がおおい消される者はさいわいである。"},{"ref":"Ps.32.2","start":19032002,"end":19032002,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[5,2,"ふぎ"],[8,1,"お"],[16,1,"れい"],[18,1,"いつわ"],[23,1,"ひと"]],"text":"主によって不義を負わされず、その霊に偽りのない人はさいわいである。"},{"ref":"Ps.32.3","start":19032003,"end":19032003,"break":"line","breaks":[[22,"line"],[36,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"つみ"],[9,1,"い"],[19,1,"とき"],[26,1,"くる"],[40,1,"ほね"],[45,1,"おとろ"]],"text":"わたしが自分の罪を言いあらわさなかった時は、ひねもす苦しみうめいたので、わたしの骨はふるび衰えた。"},{"ref":"Ps.32.4","start":19032004,"end":19032004,"break":"line","breaks":[[12,"line"],[28,"line"],[51,"line"]],"ruby":[[5,1,"て"],[7,1,"ひる"],[9,1,"よる"],[16,1,"うえ"],[18,1,"おも"],[32,1,"ちから"],[35,1,"なつ"],[53,1,"は"]],"text":"あなたのみ手が昼も夜も、わたしの上に重かったからである。わたしの力は、夏のひでりによってかれるように、かれ果てた。〔セラ"},{"ref":"Ps.32.5","start":19032005,"end":19032005,"break":"line","breaks":[[17,"line"],[30,"line"],[38,"line"],[56,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"つみ"],[13,1,"し"],[17,2,"じぶん"],[20,2,"ふぎ"],[23,1,"かく"],[34,1,"い"],[46,1,"しゅ"],[48,2,"こくはく"],[58,1,"とき"],[67,1,"おか"],[70,1,"つみ"]],"text":"わたしは自分の罪をあなたに知らせ、自分の不義を隠さなかった。わたしは言った、「わたしのとがを主に告白しよう」と。その時あなたはわたしの犯した罪をゆるされた。〔セラ"},{"ref":"Ps.32.6","start":19032006,"end":19032006,"break":"line","breaks":[[22,"line"],[36,"line"]],"ruby":[[9,1,"かみ"],[11,1,"うやま"],[13,1,"もの"],[19,1,"いの"],[22,2,"おおみず"],[25,1,"お"],[27,1,"よ"],[30,1,"なや"],[33,1,"とき"],[38,1,"み"],[40,1,"およ"]],"text":"このゆえに、すべて神を敬う者はあなたに祈る。大水の押し寄せる悩みの時にもその身に及ぶことはない。"},{"ref":"Ps.32.7","start":19032007,"end":19032007,"break":"line","breaks":[[16,"line"],[31,"line"]],"ruby":[[8,1,"かく"],[10,1,"ば"],[20,1,"まも"],[23,1,"なや"],[26,1,"まぬか"],[31,1,"すくい"],[40,1,"かこ"]],"text":"あなたはわたしの隠れ場であって、わたしを守って悩みを免れさせ、救をもってわたしを囲まれる。〔セラ"},{"ref":"Ps.32.8","start":19032008,"end":19032008,"break":"line","breaks":[[24,"line"]],"ruby":[[8,1,"おし"],[15,1,"い"],[19,1,"みち"],[21,1,"しめ"],[28,1,"め"]],"text":"わたしはあなたを教え、あなたの行くべき道を示し、わたしの目をあなたにとめて、さとすであろう。"},{"ref":"Ps.32.9","start":19032009,"end":19032009,"break":"line","breaks":[[24,"line"],[41,"line"],[65,"line"]],"ruby":[[10,1,"うま"],[26,2,"らば"],[41,1,"かれ"],[69,1,"したが"]],"text":"あなたはさとりのない馬のようであってはならない。また騾馬のようであってはならない。彼らはくつわ、たづなをもっておさえられなければ、あなたに従わないであろう。"},{"ref":"Ps.32.10","start":19032010,"end":19032010,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"かな"],[9,1,"おお"],[15,1,"しゅ"],[17,2,"しんらい"],[21,1,"もの"],[29,1,"かこ"]],"text":"悪しき者は悲しみが多い。しかし主に信頼する者はいつくしみで囲まれる。"},{"ref":"Ps.32.11","start":19032011,"end":19032011,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[6,1,"しゅ"],[11,1,"よろこ"],[13,1,"たの"],[20,1,"こころ"],[22,1,"なお"],[24,1,"もの"],[27,1,"よろこ"],[30,1,"こえ"],[32,1,"たか"]],"text":"正しき者よ、主によって喜び楽しめ、すべて心の直き者よ、喜びの声を高くあげよ。"}]