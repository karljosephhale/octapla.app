[{"ref":"Ezek.15.1","start":26015001,"end":26015001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.15.2","start":26015002,"end":26015002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,1,"き"],[12,1,"もり"],[14,1,"き"],[25,1,"えだ"],[31,1,"き"],[39,1,"ところ"]],"text":"「人の子よ、ぶどうの木、森の木のうちにあるぶどうの枝は、ほかの木になんのまさる所があるか。"},{"ref":"Ezek.15.3","start":26015003,"end":26015003,"break":"none","ruby":[[2,1,"き"],[4,1,"なに"],[7,1,"つく"],[12,1,"もち"],[21,1,"ひと"],[26,1,"もち"],[30,2,"うつわもの"],[33,1,"か"],[36,1,"き"],[37,1,"くぎ"],[39,1,"つく"]],"text":"その木は何かを造るために用いられるか。また人はこれを用いて、器物を掛ける木釘を造るだろうか。"},{"ref":"Ezek.15.4","start":26015004,"end":26015004,"break":"none","ruby":[[0,1,"み"],[6,1,"ひ"],[8,1,"な"],[10,1,"い"],[15,1,"も"],[19,1,"ひ"],[23,2,"りょうたん"],[26,1,"や"],[36,1,"なか"],[52,1,"やく"],[54,1,"た"]],"text":"見よ、これは火に投げ入れられて燃える。火がその両端を焼いたとき、またその中ほどがこげたとき、それはなんの役に立つだろうか。"},{"ref":"Ezek.15.5","start":26015005,"end":26015005,"break":"none","ruby":[[0,1,"み"],[6,2,"かんぜん"],[9,1,"とき"],[16,1,"よう"],[27,1,"ひ"],[32,1,"や"],[42,1,"とき"],[49,1,"やく"],[51,1,"た"]],"text":"見よ、これは完全な時でも、なんの用をもなさない。まして火がこれを焼き、これをこがした時には、なんの役に立つだろうか。"},{"ref":"Ezek.15.6","start":26015006,"end":26015006,"break":"none","ruby":[[4,1,"しゅ"],[7,1,"かみ"],[11,1,"い"],[20,1,"もり"],[22,1,"き"],[24,1,"なか"],[30,1,"き"],[33,1,"ひ"],[35,1,"な"],[37,1,"い"],[40,1,"や"],[52,2,"じゅうみん"]],"text":"それゆえ主なる神はこう言われる、わたしが森の木の中のぶどうの木を、火に投げ入れて焼くように、エルサレムの住民をそのようにする。"},{"ref":"Ezek.15.7","start":26015007,"end":26015007,"break":"none","ruby":[[8,1,"かお"],[10,1,"かれ"],[13,1,"む"],[16,1,"せ"],[20,1,"かれ"],[25,1,"ひ"],[34,1,"ひ"],[36,1,"かれ"],[39,1,"や"],[41,1,"つく"],[48,1,"かお"],[50,1,"かれ"],[53,1,"む"],[56,1,"せ"],[59,1,"とき"],[71,1,"しゅ"],[78,1,"し"]],"text":"わたしはわたしの顔を彼らに向けて攻める。彼らがその火からのがれても、火は彼らを焼き尽す。わたしが顔を彼らに向けて攻める時、あなたがたはわたしが主であることを知る。"},{"ref":"Ezek.15.8","start":26015008,"end":26015008,"break":"none","ruby":[[0,1,"かれ"],[21,1,"ち"],[23,1,"あ"],[25,1,"ち"],[31,1,"しゅ"],[34,1,"かみ"],[36,1,"い"]],"text":"彼らが、もとりそむいたゆえに、わたしはこの地を荒れ地とすると、主なる神は言われる」。"}]