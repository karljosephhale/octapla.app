[{"ref":"Song.6.1","start":22006001,"end":22006001,"break":"paragraph","breaks":[[13,"line"],[30,"line"],[49,"line"]],"ruby":[[0,1,"おんな"],[5,1,"もっと"],[7,1,"うつく"],[10,1,"もの"],[17,1,"あい"],[20,1,"もの"],[25,1,"い"],[34,1,"あい"],[37,1,"もの"],[59,2,"いっしょ"]],"text":"女のうちの最も美しい者よ、あなたの愛する者はどこへ行ったか。あなたの愛する者はどこへおもむいたか。わたしたちはあなたと一緒にたずねよう。"},{"ref":"Song.6.2","start":22006002,"end":22006002,"break":"stanza","breaks":[[18,"line"],[38,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[7,1,"その"],[9,1,"なか"],[12,1,"む"],[15,1,"か"],[23,1,"はな"],[25,1,"と"],[30,2,"じぶん"],[33,1,"その"],[35,1,"くだ"],[43,1,"はな"],[45,1,"とこ"],[47,1,"い"]],"text":"わが愛する者は園の中で、群れを飼い、またゆりの花を取るために自分の園に下り、かんばしい花の床へ行きました。"},{"ref":"Song.6.3","start":22006003,"end":22006003,"break":"line","breaks":[[14,"line"],[30,"line"]],"ruby":[[6,1,"あい"],[9,1,"ひと"],[16,1,"あい"],[19,1,"もの"],[30,1,"かれ"],[35,1,"はな"],[37,1,"なか"],[42,1,"む"],[45,1,"か"]],"text":"わたしはわが愛する人のもの、わが愛する者はわたしのものです。彼はゆりの花の中で、その群れを飼っています。"},{"ref":"Song.6.4","start":22006004,"end":22006004,"break":"stanza","breaks":[[25,"line"],[40,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[12,1,"うつく"],[25,1,"うるわ"],[40,1,"おそ"],[46,1,"はた"],[48,1,"た"],[51,2,"ぐんぜい"]],"text":"わが愛する者よ、あなたは美しいことテルザのごとく、麗しいことエルサレムのごとく、恐るべきこと旗を立てた軍勢のようだ。"},{"ref":"Song.6.5","start":22006005,"end":22006005,"break":"line","breaks":[[18,"line"],[32,"line"],[47,"line"]],"ruby":[[4,1,"め"],[10,1,"おそ"],[36,1,"かみ"],[43,1,"やま"],[45,1,"くだ"],[50,1,"む"]],"text":"あなたの目はわたしを恐れさせるゆえ、わたしからそむけてください。あなたの髪はギレアデの山を下るやぎの群れのようだ。"},{"ref":"Song.6.6","start":22006006,"end":22006006,"break":"line","breaks":[[16,"line"],[26,"line"]],"ruby":[[4,1,"は"],[6,1,"あら"],[8,1,"ば"],[11,1,"のぼ"],[16,1,"め"],[17,1,"ひつじ"],[19,1,"む"],[28,2,"ふたご"],[31,1,"う"],[35,2,"いっぴき"],[38,1,"こ"]],"text":"あなたの歯は洗い場から上ってきた雌羊の群れのようだ。みな二子を産んで、一匹も子のないものはない。"},{"ref":"Song.6.7","start":22006007,"end":22006007,"break":"line","breaks":[[20,"line"]],"ruby":[[7,1,"かお"],[24,1,"かた"]],"text":"あなたのほおは顔おおいのうしろにあって、ざくろの片われのようだ。"},{"ref":"Song.6.8","start":22006008,"end":22006008,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"おうひ"],[5,1,"にん"],[13,1,"にん"],[17,1,"かず"]],"text":"王妃は六十人、そばめは八十人、また数しれぬおとめがいる。"},{"ref":"Song.6.9","start":22006009,"end":22006009,"break":"line","breaks":[[17,"line"],[41,"line"],[64,"line"]],"ruby":[[7,1,"まった"],[9,1,"もの"],[17,2,"かのじょ"],[20,1,"はは"],[25,1,"ご"],[27,2,"かのじょ"],[30,1,"う"],[33,1,"もの"],[35,2,"さいあい"],[38,1,"もの"],[47,2,"かのじょ"],[50,1,"み"],[58,1,"もの"],[64,2,"おうひ"],[78,2,"かのじょ"],[81,1,"み"]],"text":"わがはと、わが全き者はただひとり、彼女は母のひとり子、彼女を産んだ者の最愛の者だ。おとめたちは彼女を見て、さいわいな者ととなえ、王妃たち、そばめたちもまた、彼女を見て、ほめた。"},{"ref":"Song.6.10","start":22006010,"end":22006010,"break":"line","breaks":[[14,"line"],[32,"line"]],"ruby":[[11,1,"み"],[14,1,"つき"],[19,1,"うつく"],[23,2,"たいよう"],[29,1,"かがや"],[32,1,"おそ"],[36,1,"こと"],[38,1,"はた"],[40,1,"た"],[43,2,"ぐんぜい"],[49,1,"もの"]],"text":"「このしののめのように見え、月のように美しく、太陽のように輝き、恐るべき事、旗を立てた軍勢のような者はだれか」。"},{"ref":"Song.6.11","start":22006011,"end":22006011,"break":"stanza","breaks":[[20,"line"],[36,"line"]],"ruby":[[4,1,"たに"],[6,1,"はな"],[8,1,"み"],[14,1,"め"],[24,1,"はな"],[26,1,"さ"],[31,1,"み"],[40,1,"その"],[42,1,"くだ"]],"text":"わたしは谷の花を見、ぶどうが芽ざしたか、ざくろの花が咲いたかを見ようと、くるみの園へ下っていった。"},{"ref":"Song.6.12","start":22006012,"end":22006012,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"し"],[16,1,"おも"],[24,1,"くるま"],[26,1,"なか"],[30,1,"きみ"]],"text":"わたしの知らないうちに、わたしの思いは、わたしを車の中のわが君のかたわらにおらせた。"},{"ref":"Song.6.13","start":22006013,"end":22006013,"break":"stanza","breaks":[[14,"line"],[37,"stanza"],[61,"line"]],"ruby":[[0,1,"かえ"],[3,1,"かえ"],[11,1,"おんな"],[14,1,"かえ"],[17,1,"かえ"],[30,1,"み"],[53,1,"おど"],[56,1,"み"],[66,1,"おんな"],[68,1,"み"]],"text":"帰れ、帰れ、シュラムの女よ、帰れ、帰れ、わたしたちはあなたを見たいものだ。あなたがたはどうしてマハナイムの踊りを見るようにシュラムの女を見たいのか。"}]