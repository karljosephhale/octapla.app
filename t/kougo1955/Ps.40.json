[{"ref":"Ps.40.1","start":19040001,"end":19040001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[17,"line"]],"ruby":[[4,1,"た"],[6,1,"しの"],[9,1,"しゅ"],[11,1,"ま"],[13,1,"のぞ"],[17,1,"しゅ"],[19,1,"みみ"],[21,1,"かたむ"],[29,1,"さけ"],[32,1,"き"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"わたしは耐え忍んで主を待ち望んだ。主は耳を傾けて、わたしの叫びを聞かれた。"},{"ref":"Ps.40.2","start":19040002,"end":19040002,"break":"line","breaks":[[24,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ほろ"],[9,1,"あな"],[13,1,"どろ"],[15,1,"ぬま"],[18,1,"ひ"],[28,1,"あし"],[30,1,"いわ"],[32,1,"うえ"],[41,1,"あゆ"]],"text":"主はわたしを滅びの穴から、泥の沼から引きあげて、わたしの足を岩の上におき、わたしの歩みをたしかにされた。"},{"ref":"Ps.40.3","start":19040003,"end":19040003,"break":"line","breaks":[[16,"line"],[32,"line"],[44,"line"],[57,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"あたら"],[5,1,"うた"],[11,1,"くち"],[13,1,"さづ"],[20,1,"かみ"],[30,1,"うた"],[36,1,"くち"],[38,1,"さづ"],[44,1,"おお"],[47,1,"ひと"],[52,1,"み"],[54,1,"おそ"],[59,1,"しゅ"],[61,2,"しんらい"]],"text":"主は新しい歌をわたしの口に授け、われらの神にささげるさんびの歌をわたしの口に授けられた。多くの人はこれを見て恐れ、かつ主に信頼するであろう。"},{"ref":"Ps.40.4","start":19040004,"end":19040004,"break":"line","breaks":[[12,"line"],[22,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"たの"],[10,1,"ひと"],[12,1,"たか"],[15,1,"もの"],[22,1,"いつわ"],[25,1,"かみ"],[27,1,"まよ"],[29,1,"もの"],[36,1,"ひと"]],"text":"主をおのが頼みとする人、高ぶる者にたよらず、偽りの神に迷う者にたよらない人はさいわいである。"},{"ref":"Ps.40.5","start":19040005,"end":19040005,"break":"line","breaks":[[20,"line"],[36,"line"],[47,"line"],[64,"line"]],"ruby":[[2,1,"かみ"],[4,1,"しゅ"],[24,1,"おも"],[32,1,"おお"],[54,1,"かた"],[56,1,"の"],[64,1,"おお"],[67,1,"かぞ"]],"text":"わが神、主よ、あなたのくすしきみわざと、われらを思うみおもいとは多くて、くらべうるものはない。わたしはこれを語り述べようとしても多くて数えることはできない。"},{"ref":"Ps.40.6","start":19040006,"end":19040006,"break":"line","breaks":[[20,"line"],[35,"line"]],"ruby":[[9,1,"そな"],[11,1,"もの"],[14,1,"よろこ"],[28,1,"みみ"],[30,1,"ひら"],[39,2,"はんさい"],[42,2,"ざいさい"],[46,1,"もと"]],"text":"あなたはいけにえと供え物とを喜ばれない。あなたはわたしの耳を開かれた。あなたは燔祭と罪祭とを求められない。"},{"ref":"Ps.40.7","start":19040007,"end":19040007,"break":"line","breaks":[[25,"line"]],"ruby":[[2,1,"とき"],[7,1,"い"],[12,1,"み"],[25,1,"しょ"],[27,1,"まき"]],"text":"その時わたしは言った、「見よ、わたしはまいります。書の巻に、わたしのためにしるされています。"},{"ref":"Ps.40.8","start":19040008,"end":19040008,"break":"line","breaks":[[24,"line"]],"ruby":[[2,1,"かみ"],[14,1,"おこな"],[19,1,"よろこ"],[36,1,"こころ"]],"text":"わが神よ、わたしはみこころを行うことを喜びます。あなたのおきてはわたしの心のうちにあります」と。"},{"ref":"Ps.40.9","start":19040009,"end":19040009,"break":"line","breaks":[[12,"line"],[34,"line"],[55,"line"]],"ruby":[[4,1,"おお"],[8,2,"しゅうかい"],[12,1,"すくい"],[18,1,"よろこ"],[26,1,"つ"],[28,1,"しめ"],[34,1,"み"],[46,1,"と"],[55,1,"しゅ"],[66,1,"ぞん"]],"text":"わたしは大いなる集会で、救についての喜びのおとずれを告げ示しました。見よ、わたしはくちびるを閉じませんでした。主よ、あなたはこれをご存じです。"},{"ref":"Ps.40.10","start":19040010,"end":19040010,"break":"line","breaks":[[21,"line"],[40,"line"],[59,"line"]],"ruby":[[8,1,"すくい"],[10,1,"こころ"],[15,1,"かく"],[29,1,"すくい"],[32,1,"つ"],[34,1,"しめ"],[59,1,"おお"],[63,2,"しゅうかい"],[66,1,"かく"]],"text":"わたしはあなたの救を心のうちに隠しおかず、あなたのまことと救とを告げ示しました。わたしはあなたのいつくしみとまこととを大いなる集会に隠しませんでした。"},{"ref":"Ps.40.11","start":19040011,"end":19040011,"break":"line","breaks":[[21,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[16,1,"お"],[39,1,"つね"],[46,1,"まも"]],"text":"主よ、あなたのあわれみをわたしに惜しまず、あなたのいつくしみとまこととをもって常にわたしをお守りください。"},{"ref":"Ps.40.12","start":19040012,"end":19040012,"break":"line","breaks":[[14,"line"],[31,"line"],[50,"line"],[66,"line"]],"ruby":[[0,1,"かぞ"],[5,1,"わざわい"],[11,1,"かこ"],[18,2,"ふぎ"],[25,1,"お"],[27,1,"せま"],[31,2,"ものみ"],[57,1,"あたま"],[59,1,"け"],[63,1,"おお"],[70,1,"こころ"],[72,1,"き"]],"text":"数えがたい災がわたしを囲み、わたしの不義がわたしに追い迫って、物見ることができないまでになりました。それはわたしの頭の毛よりも多く、わたしの心は消えうせるばかりになりました。"},{"ref":"Ps.40.13","start":19040013,"end":19040013,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[15,1,"すく"],[22,1,"しゅ"],[35,1,"たす"]],"text":"主よ、みこころならばわたしをお救いください。主よ、すみやかにわたしをお助けください。"},{"ref":"Ps.40.14","start":19040014,"end":19040014,"break":"line","breaks":[[21,"line"],[39,"line"],[58,"line"]],"ruby":[[8,1,"うば"],[12,1,"たず"],[14,1,"もと"],[17,1,"もの"],[26,1,"は"],[52,1,"ねが"],[54,1,"もの"],[62,1,"しりぞ"],[66,1,"はじ"],[68,1,"お"]],"text":"わたしのいのちを奪おうと尋ね求める者どもをことごとく恥じあわてさせてください。わたしのそこなわれることを願う者どもをうしろに退かせ、恥を負わせてください。"},{"ref":"Ps.40.15","start":19040015,"end":19040015,"break":"line","breaks":[[24,"line"]],"ruby":[[18,1,"い"],[20,1,"もの"],[24,2,"じぶん"],[27,1,"はじ"],[32,1,"おそ"]],"text":"わたしにむかって「あはぁ、あはぁ」と言う者どもを自分の恥によって恐れおののかせてください。"},{"ref":"Ps.40.16","start":19040016,"end":19040016,"break":"line","breaks":[[18,"line"],[34,"line"],[45,"line"]],"ruby":[[11,1,"たず"],[13,1,"もと"],[16,1,"もの"],[25,1,"よろこ"],[27,1,"たの"],[38,1,"すくい"],[40,1,"あい"],[43,1,"もの"],[45,1,"つね"],[48,1,"しゅ"],[50,1,"おお"]],"text":"しかし、すべてあなたを尋ね求める者はあなたによって喜び楽しむように。あなたの救を愛する者は常に「主は大いなるかな」ととなえるように。"},{"ref":"Ps.40.17","start":19040017,"end":19040017,"break":"line","breaks":[[14,"line"],[32,"line"],[48,"line"]],"ruby":[[4,1,"まず"],[10,1,"とぼ"],[17,1,"しゅ"],[38,1,"たす"],[43,2,"すくいぬし"],[50,1,"かみ"]],"text":"わたしは貧しく、かつ乏しい。しかし主はわたしをかえりみられます。あなたはわが助け、わが救主です。わが神よ、ためらわないでください。"}]