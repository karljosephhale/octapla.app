[{"ref":"Deut.3.1","start":5003001,"end":5003001,"break":"paragraph","ruby":[[8,1,"み"],[21,1,"みち"],[23,1,"のぼ"],[26,1,"い"],[36,1,"おう"],[46,1,"むか"],[48,1,"う"],[57,1,"たみ"],[64,1,"ひき"],[67,1,"で"],[76,1,"たたか"]],"text":"そしてわれわれは身をめぐらして、バシャンの道を上って行ったが、バシャンの王オグは、われわれを迎え撃とうとして、その民をことごとく率い、出てきてエデレイで戦った。"},{"ref":"Deut.3.2","start":5003002,"end":5003002,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[8,1,"い"],[14,1,"かれ"],[16,1,"おそ"],[29,1,"かれ"],[38,1,"たみ"],[43,1,"ち"],[49,1,"て"],[51,1,"わた"],[66,1,"す"],[77,1,"おう"],[88,1,"かれ"]],"text":"時に主はわたしに言われた、『彼を恐れてはならない。わたしは彼と、そのすべての民と、その地をおまえの手に渡している。おまえはヘシボンに住んでいたアモリびとの王シホンにしたように、彼にするであろう』。"},{"ref":"Deut.3.3","start":5003003,"end":5003003,"break":"none","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[18,1,"おう"],[29,1,"たみ"],[37,1,"て"],[39,1,"わた"],[54,1,"う"],[56,1,"ころ"],[65,1,"のこ"]],"text":"こうしてわれわれの神、主はバシャンの王オグと、そのすべての民を、われわれの手に渡されたので、われわれはこれを撃ち殺して、ひとりをも残さなかった。"},{"ref":"Deut.3.4","start":5003004,"end":5003004,"break":"none","ruby":[[2,1,"とき"],[9,1,"かれ"],[11,2,"まちまち"],[20,1,"と"],[29,1,"と"],[35,1,"まち"],[45,1,"と"],[48,1,"まち"],[58,1,"ぜん"],[59,2,"ちほう"],[77,1,"くに"]],"text":"その時、われわれは彼の町々を、ことごとく取った。われわれが取らなかった町は一つもなかった。取った町は六十。アルゴブの全地方であって、バシャンにおけるオグの国である。"},{"ref":"Deut.3.5","start":5003005,"end":5003005,"break":"none","ruby":[[4,1,"みな"],[6,1,"たか"],[8,1,"いし"],[15,1,"もん"],[20,1,"かん"],[22,1,"き"],[26,2,"けんご"],[29,1,"まち"],[40,1,"いし"],[46,1,"まち"],[49,2,"ひじょう"],[52,1,"おお"]],"text":"これらは皆、高い石がきがあり、門があり、貫の木のある堅固な町であった。このほかに石がきのない町は、非常に多かった。"},{"ref":"Deut.3.6","start":5003006,"end":5003006,"break":"none","ruby":[[10,1,"おう"],[25,1,"まった"],[27,1,"ほろ"],[37,1,"まち"],[39,1,"おとこ"],[41,1,"おんな"],[45,2,"こども"],[53,1,"ほろ"]],"text":"われわれはヘシボンの王シホンにしたように、これらを全く滅ぼし、そのすべての町の男、女および子供をことごとく滅ぼした。"},{"ref":"Deut.3.7","start":5003007,"end":5003007,"break":"none","ruby":[[10,2,"かちく"],[16,2,"まちまち"],[25,1,"もの"],[34,1,"え"],[36,2,"じぶん"],[39,1,"もの"]],"text":"ただし、そのすべての家畜と、その町々からのぶんどり物とは、われわれが獲て自分の物とした。"},{"ref":"Deut.3.8","start":5003008,"end":5003008,"break":"none","ruby":[[2,1,"とき"],[13,1,"む"],[16,1,"がわ"],[30,1,"おう"],[32,1,"て"],[40,1,"がわ"],[47,1,"ざん"],[51,1,"ち"],[53,1,"と"]],"text":"その時われわれはヨルダンの向こう側にいるアモリびとのふたりの王の手から、アルノン川からヘルモン山までの地を取った。"},{"ref":"Deut.3.9","start":5003009,"end":5003009,"break":"none","ruby":[[17,1,"よ"],[33,1,"よ"]],"text":"（シドンびとはヘルモンをシリオンと呼び、アモリびとはこれをセニルと呼んでいる。）"},{"ref":"Deut.3.10","start":5003010,"end":5003010,"break":"none","ruby":[[4,2,"こうげん"],[11,1,"まち"],[18,1,"ぜん"],[19,1,"ち"],[26,1,"ぜん"],[27,1,"ち"],[52,1,"くに"],[54,2,"まちまち"],[62,1,"と"]],"text":"すなわち高原のすべての町、ギレアデの全地、バシャンの全地、サルカおよびエデレイまで、バシャンにあるオグの国の町々をことごとく取った。"},{"ref":"Deut.3.11","start":5003011,"end":5003011,"break":"none","ruby":[[6,1,"おう"],[21,3,"せいぞんしゃ"],[29,1,"かれ"],[31,2,"しんだい"],[34,1,"てつ"],[36,2,"しんだい"],[46,1,"いま"],[70,2,"ふつう"],[77,1,"しゃく"],[80,1,"なが"],[82,1,"きゅう"],[88,1,"はば"]],"text":"（バシャンの王オグはレパイムのただひとりの生存者であった。彼の寝台は鉄の寝台であった。これは今なおアンモンびとのラバにあるではないか。これは普通のキュビト尺で、長さ九キュビト、幅四キュビトである。）"},{"ref":"Deut.3.12","start":5003012,"end":5003012,"break":"paragraph","ruby":[[2,1,"とき"],[11,1,"ち"],[13,1,"え"],[27,1,"がわ"],[39,1,"はじ"],[42,1,"ち"],[50,2,"さんち"],[53,1,"なか"],[59,2,"まちまち"],[77,1,"あた"]],"text":"その時われわれは、この地を獲た。そしてわたしはアルノン川のほとりのアロエルから始まる地と、ギレアデの山地の半ばと、その町々とは、ルベンびとと、ガドびととに与えた。"},{"ref":"Deut.3.13","start":5003013,"end":5003013,"break":"none","ruby":[[11,1,"のこ"],[14,1,"ち"],[20,1,"くに"],[30,1,"ぜん"],[31,1,"ち"],[39,1,"はん"],[40,2,"ぶぞく"],[43,1,"あた"],[56,1,"ぜん"],[57,2,"ちほう"],[71,1,"ぜん"],[72,1,"ち"],[79,1,"くに"],[81,1,"とな"]],"text":"わたしはまたギレアデの残りの地と、オグの国であったバシャンの全地とは、マナセの半部族に与えた。すなわちアルゴブの全地方である。（そのバシャンの全地はレパイムの国と唱えられる。"},{"ref":"Deut.3.14","start":5003014,"end":5003014,"break":"none","ruby":[[4,1,"こ"],[15,1,"ぜん"],[16,2,"ちほう"],[19,1,"と"],[37,1,"さかい"],[41,1,"たっ"],[44,2,"じぶん"],[47,1,"な"],[68,1,"な"],[75,1,"な"],[77,2,"こんにち"]],"text":"マナセの子ヤイルは、アルゴブの全地方を取って、ゲシュルびとと、マアカびとの境にまで達し、自分の名にしたがって、バシャンをハボテ・ヤイルと名づけた。この名は今日にまでおよんでいる。）"},{"ref":"Deut.3.15","start":5003015,"end":5003015,"break":"none","ruby":[[16,1,"あた"]],"text":"またわたしはマキルにはギレアデを与えた。"},{"ref":"Deut.3.16","start":5003016,"end":5003016,"break":"none","ruby":[[25,1,"がわ"],[29,1,"あた"],[34,1,"かわ"],[38,1,"なか"],[43,1,"さかい"],[56,1,"さかい"],[63,1,"がわ"],[67,1,"たっ"]],"text":"ルベンびとと、ガドびととには、ギレアデからアルノン川までを与え、その川のまん中をもって境とし、またアンモンびとの境であるヤボク川にまで達せしめた。"},{"ref":"Deut.3.17","start":5003017,"end":5003017,"break":"none","ruby":[[7,1,"さかい"],[23,1,"うみ"],[28,1,"しお"],[30,1,"うみ"],[41,1,"あた"],[45,1,"ひがし"],[47,1,"ほう"],[56,1,"たっ"]],"text":"またヨルダンを境として、キンネレテからアラバの海すなわち塩の海まで、アラバをこれに与えて、東の方ピスガのふもとに達せしめた。"},{"ref":"Deut.3.18","start":5003018,"end":5003018,"break":"paragraph","ruby":[[2,1,"とき"],[13,1,"めい"],[16,1,"い"],[27,1,"かみ"],[29,1,"しゅ"],[33,1,"ち"],[41,1,"あた"],[48,1,"え"],[62,2,"ゆうし"],[67,2,"ぶそう"],[72,2,"きょうだい"],[83,2,"ひとびと"],[86,2,"さきだ"],[91,1,"わた"],[94,1,"い"]],"text":"その時わたしはあなたがたに命じて言った、『あなたがたの神、主はこの地をあなたがたに与えて、これを獲させられるから、あなたがた勇士はみな武装して、兄弟であるイスラエルの人々に先立って、渡って行かなければならない。"},{"ref":"Deut.3.19","start":5003019,"end":5003019,"break":"none","ruby":[[10,1,"つま"],[13,2,"こども"],[17,2,"かちく"],[26,1,"あた"],[29,2,"まちまち"],[56,1,"おお"],[59,2,"かちく"],[62,1,"も"],[69,1,"し"]],"text":"ただし、あなたがたの妻と、子供と、家畜とは、わたしが与えた町々にとどまらなければならない。（わたしはあなたがたが多くの家畜を持っているのを知っている。）"},{"ref":"Deut.3.20","start":5003020,"end":5003020,"break":"none","ruby":[[0,1,"しゅ"],[11,1,"あた"],[26,2,"きょうだい"],[30,2,"あんそく"],[33,1,"あた"],[39,1,"かれ"],[49,1,"む"],[52,1,"がわ"],[61,1,"かみ"],[63,1,"しゅ"],[65,1,"あた"],[70,1,"ち"],[72,1,"え"],[104,1,"あた"],[107,2,"りょうち"],[110,1,"かえ"]],"text":"主がすでにあなたがたに与えられたように、あなたがたの兄弟にも安息を与えられて、彼らもまたヨルダンの向こう側で、あなたがたの神、主が与えられる地を獲るようになったならば、あなたがたはおのおのわたしがあなたがたに与えた領地に帰ることができる』。"},{"ref":"Deut.3.21","start":5003021,"end":5003021,"break":"none","ruby":[[2,1,"とき"],[12,1,"めい"],[15,1,"い"],[24,1,"め"],[32,1,"かみ"],[34,1,"しゅ"],[42,1,"おう"],[44,1,"おこな"],[55,1,"み"],[58,1,"しゅ"],[66,1,"わた"],[69,1,"い"],[76,1,"くに"],[80,1,"おな"],[85,1,"おこな"]],"text":"その時わたしはヨシュアに命じて言った、『あなたの目はあなたがたの神、主がこのふたりの王に行われたすべてのことを見た。主はまたあなたが渡って行くもろもろの国にも、同じように行われるであろう。"},{"ref":"Deut.3.22","start":5003022,"end":5003022,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おそ"],[18,1,"かみ"],[20,1,"しゅ"],[31,1,"たたか"]],"text":"彼らを恐れてはならない。あなたがたの神、主があなたがたのために戦われるからである』。"},{"ref":"Deut.3.23","start":5003023,"end":5003023,"break":"paragraph","ruby":[[2,1,"とき"],[7,1,"しゅ"],[9,1,"ねが"],[12,1,"い"]],"text":"その時わたしは主に願って言った、"},{"ref":"Deut.3.24","start":5003024,"end":5003024,"break":"none","ruby":[[1,1,"しゅ"],[4,1,"かみ"],[11,1,"おお"],[15,1,"こと"],[22,1,"つよ"],[24,1,"て"],[31,1,"いま"],[37,1,"しめ"],[39,1,"はじ"],[47,1,"てん"],[50,1,"ち"],[74,1,"ちから"],[83,1,"かみ"]],"text":"『主なる神よ、あなたの大いなる事と、あなたの強い手とを、たった今、しもべに示し始められました。天にも地にも、あなたのようなわざをなし、あなたのような力あるわざのできる神が、ほかにありましょうか。"},{"ref":"Deut.3.25","start":5003025,"end":5003025,"break":"none","ruby":[[13,1,"わた"],[16,1,"い"],[22,1,"む"],[25,1,"がわ"],[27,1,"よ"],[29,1,"ち"],[33,1,"よ"],[35,2,"さんち"],[46,1,"み"]],"text":"どうぞ、わたしにヨルダンを渡って行かせ、その向こう側の良い地、あの良い山地、およびレバノンを見ることのできるようにしてください』。"},{"ref":"Deut.3.26","start":5003026,"end":5003026,"break":"none","ruby":[[3,1,"しゅ"],[18,1,"いか"],[25,1,"き"],[36,1,"しゅ"],[42,1,"い"],[55,1,"た"],[63,1,"こと"],[70,1,"かさ"],[77,1,"い"]],"text":"しかし主はあなたがたのゆえにわたしを怒り、わたしに聞かれなかった。そして主はわたしに言われた、『おまえはもはや足りている。この事については、重ねてわたしに言ってはならない。"},{"ref":"Deut.3.27","start":5003027,"end":5003027,"break":"none","ruby":[[8,1,"いただき"],[10,1,"のぼ"],[13,1,"め"],[18,1,"にし"],[20,1,"きた"],[22,1,"みなみ"],[24,1,"ひがし"],[26,1,"のぞ"],[28,1,"み"],[42,1,"わた"]],"text":"おまえはピスガの頂に登り、目をあげて西、北、南、東を望み見よ。おまえはこのヨルダンを渡ることができないからである。"},{"ref":"Deut.3.28","start":5003028,"end":5003028,"break":"none","ruby":[[13,1,"めい"],[16,1,"かれ"],[18,1,"はげ"],[22,1,"かれ"],[24,1,"つよ"],[29,1,"かれ"],[33,1,"たみ"],[35,2,"さきだ"],[39,1,"わた"],[42,1,"い"],[45,1,"かれ"],[52,1,"み"],[54,1,"ち"],[56,1,"つ"]],"text":"しかし、おまえはヨシュアに命じ、彼を励まし、彼を強くせよ。彼はこの民に先立って渡って行き、彼らにおまえの見る地を継がせるであろう』。"},{"ref":"Deut.3.29","start":5003029,"end":5003029,"break":"none","ruby":[[15,1,"たい"],[18,1,"たに"]],"text":"こうしてわれわれはベテペオルに対する谷にとどまっていた。"}]