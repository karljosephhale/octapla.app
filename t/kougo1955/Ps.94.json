[{"ref":"Ps.94.1","start":19094001,"end":19094001,"break":"paragraph","breaks":[[13,"line"]],"ruby":[[3,1,"むく"],[8,1,"かみ"],[10,1,"しゅ"],[16,1,"むく"],[21,1,"かみ"],[24,1,"ひかり"],[26,1,"はな"]],"text":"あだを報いられる神、主よ、あだを報いられる神よ、光を放ってください。"},{"ref":"Ps.94.2","start":19094002,"end":19094002,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"ち"],[7,1,"もの"],[10,1,"た"],[13,1,"たか"],[16,1,"もの"],[20,1,"う"],[24,1,"ばつ"],[27,1,"あた"]],"text":"地をさばかれる者よ、立って高ぶる者にその受くべき罰をお与えください。"},{"ref":"Ps.94.3","start":19094003,"end":19094003,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"あ"],[6,1,"もの"],[13,1,"あ"],[16,1,"もの"],[22,1,"か"],[24,1,"ほこ"]],"text":"主よ、悪しき者はいつまで、悪しき者はいつまで勝ち誇るでしょうか。"},{"ref":"Ps.94.4","start":19094004,"end":19094004,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,2,"こうまん"],[6,2,"ことば"],[9,1,"は"],[11,1,"ち"],[18,2,"ふぎ"],[21,1,"おこな"],[23,1,"もの"],[29,1,"たか"]],"text":"彼らは高慢な言葉を吐き散らし、すべて不義を行う者はみずから高ぶります。"},{"ref":"Ps.94.5","start":19094005,"end":19094005,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かれ"],[10,1,"たみ"],[12,1,"う"],[14,1,"くだ"],[21,1,"し"],[22,1,"ぎょう"],[24,1,"くる"]],"text":"主よ、彼らはあなたの民を打ち砕き、あなたの嗣業を苦しめます。"},{"ref":"Ps.94.6","start":19094006,"end":19094006,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[7,1,"たび"],[24,1,"ころ"]],"text":"彼らはやもめと旅びとのいのちをうばい、みなしごを殺します。"},{"ref":"Ps.94.7","start":19094007,"end":19094007,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[9,1,"しゅ"],[11,1,"み"],[19,1,"かみ"],[21,1,"さと"]],"text":"彼らは言います、「主は見ない、ヤコブの神は悟らない」と。"},{"ref":"Ps.94.8","start":19094008,"end":19094008,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"たみ"],[5,1,"にぶ"],[7,1,"もの"],[10,1,"さと"],[13,1,"おろ"],[16,1,"もの"],[21,1,"かしこ"]],"text":"民のうちの鈍き者よ、悟れ。愚かな者よ、いつ賢くなるだろうか。"},{"ref":"Ps.94.9","start":19094009,"end":19094009,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"みみ"],[2,1,"う"],[5,1,"もの"],[7,1,"き"],[20,1,"め"],[22,1,"つく"],[25,1,"もの"],[27,1,"み"]],"text":"耳を植えた者は聞くことをしないだろうか、目を造った者は見ることをしないだろうか。"},{"ref":"Ps.94.10","start":19094010,"end":19094010,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[5,2,"くにたみ"],[8,1,"こ"],[11,1,"もの"],[13,1,"ばっ"],[27,1,"ひと"],[29,1,"おし"],[32,1,"もの"],[34,2,"ちしき"]],"text":"もろもろの国民を懲らす者は罰することをしないだろうか、人を教える者は知識をもたないだろうか。"},{"ref":"Ps.94.11","start":19094011,"end":19094011,"break":"line","ruby":[[0,1,"しゅ"],[2,1,"ひと"],[4,1,"おも"],[15,1,"し"]],"text":"主は人の思いの、むなしいことを知られる。"},{"ref":"Ps.94.12","start":19094012,"end":19094012,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[10,1,"こ"],[15,1,"ひと"],[25,1,"おし"],[30,1,"ひと"]],"text":"主よ、あなたによって懲らされる人、あなたのおきてを教えられる人はさいわいです。"},{"ref":"Ps.94.13","start":19094013,"end":19094013,"break":"line","breaks":[[19,"line"],[35,"line"]],"ruby":[[6,1,"ひと"],[8,1,"わざわい"],[10,1,"ひ"],[19,1,"あ"],[22,1,"もの"],[27,1,"あな"],[29,1,"ほ"],[37,1,"ひと"],[39,2,"へいあん"],[42,1,"あた"]],"text":"あなたはその人を災の日からのがれさせ、悪しき者のために穴が掘られるまでその人に平安を与えられます。"},{"ref":"Ps.94.14","start":19094014,"end":19094014,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"たみ"],[6,1,"す"],[12,1,"し"],[13,1,"ぎょう"],[15,2,"みす"]],"text":"主はその民を捨てず、その嗣業を見捨てられないからです。"},{"ref":"Ps.94.15","start":19094015,"end":19094015,"break":"line","breaks":[[10,"line"]],"ruby":[[4,2,"せいぎ"],[7,1,"かえ"],[13,1,"こころ"],[15,1,"ただ"],[18,1,"もの"],[23,1,"したが"]],"text":"さばきは正義に帰り、すべて心の正しい者はそれに従うでしょう。"},{"ref":"Ps.94.16","start":19094016,"end":19094016,"break":"line","breaks":[[17,"line"],[30,"line"],[44,"line"]],"ruby":[[10,1,"た"],[17,1,"あ"],[20,1,"もの"],[22,1,"せ"],[40,1,"た"],[44,2,"ふぎ"],[47,1,"おこな"],[49,1,"もの"],[51,1,"せ"]],"text":"だれがわたしのために立ちあがって、悪しき者を責めるだろうか。だれがわたしのために立って、不義を行う者を責めるだろうか。"},{"ref":"Ps.94.17","start":19094017,"end":19094017,"break":"line","breaks":[[21,"line"]],"ruby":[[3,1,"しゅ"],[9,1,"たす"],[23,1,"たましい"],[28,1,"おと"],[31,1,"ところ"],[33,1,"す"]],"text":"もしも主がわたしを助けられなかったならば、わが魂はとくに音なき所に住んだであろう。"},{"ref":"Ps.94.18","start":19094018,"end":19094018,"break":"line","breaks":[[21,"line"],[34,"line"]],"ruby":[[8,1,"あし"],[15,1,"おも"],[21,1,"しゅ"]],"text":"しかし「わたしの足がすべる」と思ったとき、主よ、あなたのいつくしみはわたしをささえられました。"},{"ref":"Ps.94.19","start":19094019,"end":19094019,"break":"line","breaks":[[18,"line"]],"ruby":[[7,1,"おも"],[9,1,"わずら"],[12,1,"み"],[22,1,"なぐさ"],[27,1,"たましい"],[29,1,"よろこ"]],"text":"わたしのうちに思い煩いの満ちるとき、あなたの慰めはわが魂を喜ばせます。"},{"ref":"Ps.94.20","start":19094020,"end":19094020,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"さだ"],[6,2,"きがい"],[13,1,"あ"],[16,3,"しはいしゃ"],[24,1,"した"]],"text":"定めをもって危害をたくらむ悪しき支配者はあなたと親しむことができるでしょうか。"},{"ref":"Ps.94.21","start":19094021,"end":19094021,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あい"],[4,1,"むす"],[7,1,"ただ"],[10,1,"ひと"],[12,1,"たましい"],[14,1,"せ"],[17,1,"つみ"],[21,1,"もの"],[23,1,"し"],[25,2,"せんこく"]],"text":"彼らは相結んで正しい人の魂を責め、罪のない者に死を宣告します。"},{"ref":"Ps.94.22","start":19094022,"end":19094022,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"しゅ"],[7,1,"たか"],[18,1,"かみ"],[22,1,"さ"],[24,1,"どころ"],[26,1,"いわ"]],"text":"しかし主はわが高きやぐらとなり、わが神はわが避け所の岩となられました。"},{"ref":"Ps.94.23","start":19094023,"end":19094023,"break":"line","breaks":[[14,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,2,"ふぎ"],[8,1,"かれ"],[11,1,"むく"],[14,1,"かれ"],[19,1,"あく"],[24,1,"ほろ"],[35,1,"かみ"],[37,1,"しゅ"],[39,1,"かれ"],[42,1,"ほろ"]],"text":"主は彼らの不義を彼らに報い、彼らをその悪のゆえに滅ぼされます。われらの神、主は彼らを滅ぼされます。"}]