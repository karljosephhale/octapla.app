[{"ref":"Acts.26.1","start":44026001,"end":44026001,"break":"paragraph","ruby":[[15,2,"じしん"],[21,1,"はな"],[29,1,"い"],[41,1,"て"],[45,1,"の"],[49,2,"べんめい"],[53,1,"はじ"]],"text":"アグリッパはパウロに、「おまえ自身のことを話してもよい」と言った。そこでパウロは、手をさし伸べて、弁明をし始めた。"},{"ref":"Acts.26.2","start":44026002,"end":44026002,"break":"paragraph","ruby":[[6,1,"おう"],[12,1,"じん"],[17,1,"うった"],[28,1,"こと"],[30,1,"かん"],[42,1,"まえ"],[44,2,"べんめい"],[66,1,"おも"]],"text":"「アグリッパ王よ、ユダヤ人たちから訴えられているすべての事に関して、きょう、あなたの前で弁明することになったのは、わたしのしあわせに思うところであります。"},{"ref":"Acts.26.3","start":44026003,"end":44026003,"break":"none","ruby":[[8,1,"じん"],[14,2,"かんれい"],[17,2,"もんだい"],[23,1,"し"],[25,1,"ぬ"],[43,1,"もう"],[49,2,"かんだい"],[53,1,"こころ"],[55,1,"き"]],"text":"あなたは、ユダヤ人のあらゆる慣例や問題を、よく知り抜いておられるかたですから、わたしの申すことを、寛大なお心で聞いていただきたいのです。"},{"ref":"Acts.26.4","start":44026004,"end":44026004,"break":"paragraph","ruby":[[7,1,"わか"],[9,2,"じだい"],[14,1,"はじ"],[18,1,"じ"],[19,2,"こくみん"],[22,1,"なか"],[33,1,"す"],[51,2,"せいかつ"],[60,1,"じん"],[67,1,"し"]],"text":"さて、わたしは若い時代には、初めから自国民の中で、またエルサレムで過ごしたのですが、そのころのわたしの生活ぶりは、ユダヤ人がみんなよく知っているところです。"},{"ref":"Acts.26.5","start":44026005,"end":44026005,"break":"none","ruby":[[0,1,"かれ"],[7,1,"はじ"],[11,1,"し"],[19,2,"しょうげん"],[25,1,"おも"],[47,2,"しゅうきょう"],[50,1,"もっと"],[52,2,"げんかく"],[55,1,"は"],[67,1,"びと"],[72,2,"せいかつ"]],"text":"彼らはわたしを初めから知っているので、証言しようと思えばできるのですが、わたしは、わたしたちの宗教の最も厳格な派にしたがって、パリサイ人としての生活をしていたのです。"},{"ref":"Acts.26.6","start":44026006,"end":44026006,"break":"none","ruby":[[0,1,"いま"],[6,1,"かみ"],[14,2,"せんぞ"],[17,2,"やくそく"],[23,2,"きぼう"],[36,2,"さいばん"],[39,1,"う"]],"text":"今わたしは、神がわたしたちの先祖に約束なさった希望をいだいているために、裁判を受けているのであります。"},{"ref":"Acts.26.7","start":44026007,"end":44026007,"break":"none","ruby":[[9,2,"ぶぞく"],[13,2,"よるひる"],[16,2,"ねっしん"],[19,1,"かみ"],[21,1,"つか"],[27,2,"やくそく"],[30,1,"え"],[34,1,"のぞ"],[43,1,"おう"],[48,2,"きぼう"],[62,1,"じん"],[65,1,"うった"]],"text":"わたしたちの十二の部族は、夜昼、熱心に神に仕えて、その約束を得ようと望んでいるのです。王よ、この希望のために、わたしはユダヤ人から訴えられています。"},{"ref":"Acts.26.8","start":44026008,"end":44026008,"break":"none","ruby":[[0,1,"かみ"],[2,2,"しにん"],[31,1,"しん"],[40,1,"おも"]],"text":"神が死人をよみがえらせるということが、あなたがたには、どうして信じられないことと思えるのでしょうか。"},{"ref":"Acts.26.9","start":44026009,"end":44026009,"break":"paragraph","ruby":[[3,2,"じしん"],[7,2,"いぜん"],[15,1,"びと"],[20,1,"な"],[22,1,"さか"],[26,2,"はんたい"],[29,2,"こうどう"],[38,1,"おも"]],"text":"わたし自身も、以前には、ナザレ人イエスの名に逆らって反対の行動をすべきだと、思っていました。"},{"ref":"Acts.26.10","start":44026010,"end":44026010,"break":"none","ruby":[[17,2,"かんこう"],[21,3,"さいしちょう"],[28,2,"けんげん"],[31,1,"あた"],[37,1,"おお"],[40,2,"せいと"],[45,1,"ごく"],[47,1,"と"],[49,1,"こ"],[52,1,"かれ"],[55,1,"ころ"],[59,1,"とき"],[66,2,"さんせい"],[69,1,"い"],[71,1,"あらわ"]],"text":"そしてわたしは、それをエルサレムで敢行し、祭司長たちから権限を与えられて、多くの聖徒たちを獄に閉じ込め、彼らが殺される時には、それに賛成の意を表しました。"},{"ref":"Acts.26.11","start":44026011,"end":44026011,"break":"none","ruby":[[12,2,"かいどう"],[20,1,"かれ"],[23,1,"ばっ"],[27,2,"むり"],[32,1,"かみ"],[37,2,"ことば"],[40,1,"い"],[48,1,"かれ"],[51,1,"たい"],[57,1,"あ"],[59,1,"くる"],[65,2,"がいこく"],[68,2,"まちまち"],[74,2,"はくがい"],[77,1,"て"],[83,1,"いた"]],"text":"それから、いたるところの会堂で、しばしば彼らを罰して、無理やりに神をけがす言葉を言わせようとし、彼らに対してひどく荒れ狂い、ついに外国の町々にまで、迫害の手をのばすに至りました。"},{"ref":"Acts.26.12","start":44026012,"end":44026012,"break":"paragraph","ruby":[[10,3,"さいしちょう"],[17,2,"けんげん"],[20,2,"いにん"],[24,1,"う"],[33,1,"い"]],"text":"こうして、わたしは、祭司長たちから権限と委任とを受けて、ダマスコに行ったのですが、"},{"ref":"Acts.26.13","start":44026013,"end":44026013,"break":"none","ruby":[[0,1,"おう"],[5,2,"とちゅう"],[8,2,"まひる"],[12,1,"ひかり"],[14,1,"てん"],[20,1,"く"],[24,1,"み"],[33,2,"たいよう"],[42,1,"ひか"],[44,1,"かがや"],[52,3,"どうこうしゃ"],[62,1,"てら"]],"text":"王よ、その途中、真昼に、光が天からさして来るのを見ました。それは、太陽よりも、もっと光り輝いて、わたしと同行者たちとをめぐり照しました。"},{"ref":"Acts.26.14","start":44026014,"end":44026014,"break":"none","ruby":[[8,1,"ち"],[10,1,"たお"],[19,1,"とき"],[23,1,"ご"],[31,1,"よ"],[36,1,"こえ"],[38,1,"き"],[59,2,"はくがい"],[78,1,"きず"],[80,1,"お"]],"text":"わたしたちはみな地に倒れましたが、その時ヘブル語でわたしにこう呼びかける声を聞きました、『サウロ、サウロ、なぜわたしを迫害するのか。とげのあるむちをければ、傷を負うだけである』。"},{"ref":"Acts.26.15","start":44026015,"end":44026015,"break":"none","ruby":[[9,1,"しゅ"],[24,1,"たず"],[29,1,"しゅ"],[31,1,"い"],[46,2,"はくがい"]],"text":"そこで、わたしが『主よ、あなたはどなたですか』と尋ねると、主は言われた、『わたしは、あなたが迫害しているイエスである。"},{"ref":"Acts.26.16","start":44026016,"end":44026016,"break":"none","ruby":[[3,1,"お"],[10,2,"じぶん"],[13,1,"あし"],[15,1,"た"],[29,1,"あらわ"],[43,1,"あ"],[46,1,"こと"],[53,1,"あらわ"],[56,1,"しめ"],[64,1,"こと"],[75,1,"つた"],[78,1,"つとめ"],[85,1,"にん"]],"text":"さあ、起きあがって、自分の足で立ちなさい。わたしがあなたに現れたのは、あなたがわたしに会った事と、あなたに現れて示そうとしている事とをあかしし、これを伝える務に、あなたを任じるためである。"},{"ref":"Acts.26.17","start":44026017,"end":44026017,"break":"none","ruby":[[7,2,"こくみん"],[10,3,"いほうじん"],[15,1,"なか"],[23,1,"すく"],[25,1,"だ"],[37,1,"かれ"]],"text":"わたしは、この国民と異邦人との中から、あなたを救い出し、あらためてあなたを彼らにつかわすが、"},{"ref":"Acts.26.18","start":44026018,"end":44026018,"break":"none","ruby":[[4,1,"かれ"],[7,1,"め"],[9,1,"ひら"],[12,1,"かれ"],[19,1,"ひかり"],[22,2,"あくま"],[25,2,"しはい"],[29,1,"かみ"],[35,1,"かえ"],[42,1,"かれ"],[45,1,"つみ"],[51,1,"え"],[57,1,"しん"],[60,2,"しんこう"],[67,1,"せい"],[68,1,"べつ"],[72,2,"ひとびと"],[75,1,"くわ"]],"text":"それは、彼らの目を開き、彼らをやみから光へ、悪魔の支配から神のみもとへ帰らせ、また、彼らが罪のゆるしを得、わたしを信じる信仰によって、聖別された人々に加わるためである』。"},{"ref":"Acts.26.19","start":44026019,"end":44026019,"break":"paragraph","ruby":[[12,1,"おう"],[19,1,"てん"],[23,2,"けいじ"]],"text":"それですから、アグリッパ王よ、わたしは天よりの啓示にそむかず、"},{"ref":"Acts.26.20","start":44026020,"end":44026020,"break":"none","ruby":[[2,1,"はじ"],[12,2,"ひとびと"],[28,2,"ひとびと"],[37,2,"ぜんど"],[44,3,"いほうじん"],[51,1,"く"],[53,1,"あらた"],[56,1,"かみ"],[58,1,"た"],[60,1,"かえ"],[63,2,"くいあらた"],[75,1,"おこな"],[82,1,"と"],[84,1,"すす"]],"text":"まず初めにダマスコにいる人々に、それからエルサレムにいる人々、さらにユダヤ全土、ならびに異邦人たちに、悔い改めて神に立ち帰り、悔改めにふさわしいわざを行うようにと、説き勧めました。"},{"ref":"Acts.26.21","start":44026021,"end":44026021,"break":"none","ruby":[[9,1,"じん"],[16,1,"みや"],[18,1,"ひ"],[20,1,"とら"],[23,1,"ころ"]],"text":"そのために、ユダヤ人は、わたしを宮で引き捕えて殺そうとしたのです。"},{"ref":"Acts.26.22","start":44026022,"end":44026022,"break":"none","ruby":[[8,2,"こんにち"],[11,1,"いた"],[15,1,"かみ"],[17,2,"かご"],[20,1,"う"],[28,1,"た"],[32,1,"ちい"],[35,1,"もの"],[38,1,"おお"],[41,1,"もの"],[51,3,"よげんしゃ"],[62,2,"こんご"],[64,1,"おこ"],[70,1,"かた"],[81,1,"の"]],"text":"しかし、わたしは今日に至るまで神の加護を受け、このように立って、小さい者にも大きい者にもあかしをなし、預言者たちやモーセが、今後起るべきだと語ったことを、そのまま述べてきました。"},{"ref":"Acts.26.23","start":44026023,"end":44026023,"break":"none","ruby":[[10,2,"くなん"],[13,1,"う"],[22,2,"しにん"],[25,1,"なか"],[28,2,"さいしょ"],[40,2,"こくみん"],[43,3,"いほうじん"],[49,1,"ひかり"],[51,1,"の"],[53,1,"つた"],[57,1,"いた"]],"text":"すなわち、キリストが苦難を受けること、また、死人の中から最初によみがえって、この国民と異邦人とに、光を宣べ伝えるに至ることを、あかししたのです」。"},{"ref":"Acts.26.24","start":44026024,"end":44026024,"break":"none","ruby":[[9,2,"べんめい"],[23,2,"おおごえ"],[26,1,"い"],[40,1,"き"],[42,1,"くる"],[48,2,"はくがく"],[56,1,"くる"]],"text":"パウロがこのように弁明をしていると、フェストは大声で言った、「パウロよ、おまえは気が狂っている。博学が、おまえを狂わせている」。"},{"ref":"Acts.26.25","start":44026025,"end":44026025,"break":"none","ruby":[[4,1,"い"],[13,2,"かっか"],[21,1,"き"],[23,1,"くる"],[41,2,"しんじつ"],[44,2,"ことば"],[47,1,"かた"]],"text":"パウロが言った、「フェスト閣下よ、わたしは気が狂ってはいません。わたしは、まじめな真実の言葉を語っているだけです。"},{"ref":"Acts.26.26","start":44026026,"end":44026026,"break":"none","ruby":[[0,1,"おう"],[11,1,"し"],[21,1,"おう"],[23,1,"たい"],[28,2,"そっちょく"],[31,1,"もう"],[33,1,"あ"],[46,1,"かた"],[50,1,"おこな"],[71,1,"おう"],[73,1,"み"],[85,1,"しん"]],"text":"王はこれらのことをよく知っておられるので、王に対しても、率直に申し上げているのです。それは、片すみで行われたのではないのですから、一つとして、王が見のがされたことはないと信じます。"},{"ref":"Acts.26.27","start":44026027,"end":44026027,"break":"none","ruby":[[5,1,"おう"],[12,3,"よげんしゃ"],[16,1,"しん"],[22,1,"しん"],[30,1,"おも"]],"text":"アグリッパ王よ、あなたは預言者を信じますか。信じておられると思います」。"},{"ref":"Acts.26.28","start":44026028,"end":44026028,"break":"none","ruby":[[10,1,"い"],[19,1,"すこ"],[21,1,"と"]],"text":"アグリッパがパウロに言った、「おまえは少し説いただけで、わたしをクリスチャンにしようとしている」。"},{"ref":"Acts.26.29","start":44026029,"end":44026029,"break":"none","ruby":[[4,1,"い"],[9,1,"と"],[14,1,"すこ"],[22,1,"おお"],[34,1,"かみ"],[36,1,"いの"],[60,2,"ことば"],[63,1,"き"],[66,1,"ひと"],[81,1,"くだ"],[94,1,"くさり"],[96,1,"べつ"]],"text":"パウロが言った、「説くことが少しであろうと、多くであろうと、わたしが神に祈るのは、ただあなただけでなく、きょう、わたしの言葉を聞いた人もみな、わたしのようになって下さることです。このような鎖は別ですが」。"},{"ref":"Acts.26.30","start":44026030,"end":44026030,"break":"paragraph","ruby":[[5,1,"おう"],[7,2,"そうとく"],[18,2,"れっせき"],[21,2,"ひとびと"],[27,1,"た"]],"text":"それから、王も総督もベルニケも、また列席の人々も、みな立ちあがった。"},{"ref":"Acts.26.31","start":44026031,"end":44026031,"break":"none","ruby":[[0,2,"たいじょう"],[7,1,"たがい"],[9,1,"かた"],[11,1,"あ"],[14,1,"い"],[21,1,"ひと"],[24,1,"し"],[26,2,"とうごく"],[29,1,"あた"]],"text":"退場してから、互に語り合って言った、「あの人は、死や投獄に当るようなことをしてはいない」。"},{"ref":"Acts.26.32","start":44026032,"end":44026032,"break":"none","ruby":[[15,1,"い"],[22,1,"ひと"],[30,2,"じょうそ"]],"text":"そして、アグリッパがフェストに言った、「あの人は、カイザルに上訴していなかったら、ゆるされたであろうに」。"}]