[{"ref":"Hos.10.1","start":28010001,"end":28010001,"break":"paragraph","breaks":[[13,"line"],[22,"line"],[37,"line"],[43,"line"],[58,"line"]],"ruby":[[6,1,"み"],[8,1,"むす"],[10,1,"しげ"],[17,1,"き"],[24,1,"み"],[26,1,"おお"],[28,1,"むす"],[37,2,"さいだん"],[40,1,"ま"],[45,1,"ち"],[47,1,"ゆた"],[58,1,"はしら"],[60,1,"ぞう"],[62,1,"うるわ"]],"text":"イスラエルは実を結ぶ茂ったぶどうの木である。その実を多く結ぶにしたがって、祭壇を増し、その地の豊かなるにしたがって、柱の像を麗しくした。"},{"ref":"Hos.10.2","start":28010002,"end":28010002,"break":"line","breaks":[[11,"line"],[31,"line"],[42,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こころ"],[5,1,"いつわ"],[11,1,"いま"],[13,1,"かれ"],[18,1,"つみ"],[20,1,"お"],[31,1,"しゅ"],[35,2,"さいだん"],[44,1,"はしら"],[46,1,"ぞう"],[48,1,"くだ"]],"text":"彼らの心は偽りである。今、彼らはその罪を負わなければならない。主はその祭壇をこわし、その柱の像を砕かれる。"},{"ref":"Hos.10.3","start":28010003,"end":28010003,"break":"stanza","breaks":[[8,"line"],[23,"line"],[34,"line"]],"ruby":[[0,1,"いま"],[2,1,"かれ"],[5,1,"い"],[14,1,"しゅ"],[16,1,"おそ"],[29,1,"おう"],[34,1,"おう"],[44,1,"なに"]],"text":"今、彼らは言う、「われわれは主を恐れないので、われわれには王がない。王はわれわれのために何をなしえようか」と。"},{"ref":"Hos.10.4","start":28010004,"end":28010004,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[7,2,"ことば"],[14,1,"いつわ"],[17,1,"ちか"],[23,2,"けいやく"],[26,1,"むす"],[38,1,"はたけ"],[43,2,"どくそう"],[49,1,"あらわ"]],"text":"彼らはむなしき言葉をいだし、偽りの誓いをもって契約を結ぶ。それゆえ、さばきは畑のうねの毒草のように現れる。"},{"ref":"Hos.10.5","start":28010005,"end":28010005,"break":"line","breaks":[[9,"line"],[26,"line"],[39,"line"],[53,"line"]],"ruby":[[5,2,"じゅうみん"],[15,1,"こ"],[16,1,"うし"],[28,1,"たみ"],[36,1,"なげ"],[41,2,"ぐうぞう"],[44,1,"つか"],[47,2,"さいし"],[55,2,"えいこう"],[66,1,"な"],[68,1,"かな"]],"text":"サマリヤの住民は、ベテアベンの子牛のためにおののき、その民はこれがために嘆き、その偶像に仕える祭司たちは、その栄光のうせたるがために泣き悲しむ。"},{"ref":"Hos.10.6","start":28010006,"end":28010006,"break":"line","breaks":[[16,"line"],[30,"line"],[41,"line"]],"ruby":[[2,1,"こ"],[3,1,"うし"],[11,1,"たずさ"],[16,2,"れいもつ"],[21,2,"だいおう"],[36,1,"はじ"],[51,2,"ぐうぞう"],[54,1,"は"]],"text":"その子牛はアッスリヤに携えられ、礼物として大王にささげられ、エフライムは恥をうけ、イスラエルはおのれの偶像を恥じる。"},{"ref":"Hos.10.7","start":28010007,"end":28010007,"break":"stanza","breaks":[[8,"line"]],"ruby":[[5,1,"おう"],[8,1,"みず"],[14,1,"き"],[15,1,"ぎ"],[21,1,"ほろ"]],"text":"サマリヤの王は、水のおもての木切れのように滅ぼされる。"},{"ref":"Hos.10.8","start":28010008,"end":28010008,"break":"line","breaks":[[21,"line"],[41,"line"],[54,"line"],[68,"line"]],"ruby":[[6,1,"つみ"],[14,1,"たか"],[16,1,"ところ"],[18,1,"ほろ"],[31,2,"さいだん"],[34,1,"うえ"],[38,1,"しげ"],[43,1,"とき"],[44,1,"かれ"],[47,1,"やま"],[49,1,"む"],[65,1,"い"],[68,1,"おか"],[70,1,"む"],[80,1,"うえ"],[82,1,"たお"],[87,1,"い"]],"text":"イスラエルの罪であるアベンの高き所も滅び、いばらとあざみがその祭壇の上にはえ茂る。その時彼らは山に向かって、「われわれをおおえ」と言い、丘に向かって「われわれの上に倒れよ」と言う。"},{"ref":"Hos.10.9","start":28010009,"end":28010009,"break":"stanza","breaks":[[7,"line"],[28,"line"],[41,"line"]],"ruby":[[15,1,"ひ"],[22,1,"つみ"],[24,1,"おか"],[28,1,"かれ"],[33,1,"ところ"],[35,1,"た"],[41,1,"たたか"],[50,1,"かれ"],[53,1,"およ"]],"text":"イスラエルよ、あなたはギベアの日からこのかた罪を犯した。彼らはその所に立っていた。戦いはギベアにおる彼らに及ばないであろうか。"},{"ref":"Hos.10.10","start":28010010,"end":28010010,"break":"line","breaks":[[16,"line"],[25,"line"],[47,"line"]],"ruby":[[4,1,"き"],[11,1,"たみ"],[13,1,"せ"],[19,1,"こ"],[25,1,"かれ"],[33,1,"つみ"],[38,1,"こら"],[52,1,"たみ"],[54,1,"あつ"],[58,1,"かれ"],[61,1,"せ"]],"text":"わたしは来てよこしまな民を攻め、これを懲らしめる。彼らがその二つの罪のために懲しめられるとき、もろもろの民は集まって彼らを攻める。"},{"ref":"Hos.10.11","start":28010011,"end":28010011,"break":"stanza","breaks":[[20,"line"],[31,"line"],[47,"line"],[69,"line"],[75,"line"]],"ruby":[[11,1,"わか"],[13,2,"めうし"],[20,2,"こくもつ"],[23,1,"ふ"],[28,1,"この"],[37,1,"うるわ"],[40,1,"くび"],[42,1,"お"],[72,1,"たがや"],[79,2,"じぶん"]],"text":"エフライムはならされた若い雌牛であって、穀物を踏むことを好む。わたしはその麗しい首を惜しんだ。しかし、わたしはエフライムにくびきをかける。ユダは耕し、ヤコブは自分のために、まぐわをひかねばならない。"},{"ref":"Hos.10.12","start":28010012,"end":28010012,"break":"line","breaks":[[18,"line"],[31,"line"],[43,"line"],[56,"line"],[69,"line"]],"ruby":[[6,2,"じぶん"],[12,2,"せいぎ"],[24,1,"み"],[26,1,"か"],[28,1,"と"],[37,2,"しんでん"],[40,1,"たがや"],[43,1,"いま"],[45,1,"しゅ"],[47,1,"もと"],[51,1,"とき"],[56,1,"しゅ"],[58,1,"き"],[60,1,"すく"],[63,1,"あめ"],[75,1,"ふ"]],"text":"あなたがたは自分のために正義をまき、いつくしみの実を刈り取り、あなたがたの新田を耕せ。今は主を求むべき時である。主は来て救いを雨のように、あなたがたに降りそそがれる。"},{"ref":"Hos.10.13","start":28010013,"end":28010013,"break":"stanza","breaks":[[11,"line"],[20,"line"],[29,"line"],[47,"line"]],"ruby":[[6,1,"あく"],[8,1,"たがや"],[11,2,"ふぎ"],[14,1,"か"],[20,1,"いつわ"],[23,1,"み"],[25,1,"た"],[38,2,"じぶん"],[41,2,"せんしゃ"],[44,1,"たの"],[47,2,"ゆうし"],[50,1,"おお"],[55,1,"たの"]],"text":"あなたがたは悪を耕し、不義を刈りおさめ、偽りの実を食べた。これはあなたがたが自分の戦車を頼み、勇士の多いことを頼んだためである。"},{"ref":"Hos.10.14","start":28010014,"end":28010014,"break":"line","breaks":[[15,"line"],[25,"line"],[36,"line"],[53,"line"],[73,"line"]],"ruby":[[11,1,"たみ"],[13,1,"なか"],[19,1,"さわ"],[22,1,"おこ"],[31,1,"たたか"],[34,1,"ひ"],[44,1,"う"],[46,1,"やぶ"],[59,1,"しろ"],[66,1,"う"],[68,1,"やぶ"],[73,1,"はは"],[78,1,"こ"],[81,1,"とも"],[83,1,"う"],[85,1,"くだ"]],"text":"それゆえ、あなたがたの民の中にいくさの騒ぎが起り、シャルマンが戦いの日にベテ・アルベルを打ち破ったように、あなたがたの城はことごとく打ち破られる。母らはその子らと共に打ち砕かれた。"},{"ref":"Hos.10.15","start":28010015,"end":28010015,"break":"line","breaks":[[9,"line"],[25,"line"],[42,"line"]],"ruby":[[6,1,"いえ"],[15,1,"おお"],[19,1,"あく"],[38,1,"おこな"],[48,1,"おう"],[55,1,"なか"],[57,1,"まった"],[59,1,"ほろ"]],"text":"イスラエルの家よ、あなたがたの大いなる悪のゆえに、このように、あなたがたにも行われ、イスラエルの王は、あらしの中に全く滅ぼされる。"}]