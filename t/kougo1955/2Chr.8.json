[{"ref":"2Chr.8.1","start":14008001,"end":14008001,"break":"paragraph","ruby":[[7,1,"ねん"],[9,1,"へ"],[12,1,"しゅ"],[14,1,"いえ"],[16,2,"じぶん"],[19,1,"いえ"],[22,1,"た"],[24,1,"おわ"]],"text":"ソロモンは二十年を経て、主の家と自分の家とを建て終った。"},{"ref":"2Chr.8.2","start":14008002,"end":14008002,"break":"none","ruby":[[12,1,"おく"],[16,2,"まちまち"],[19,1,"た"],[21,1,"なお"],[34,2,"ひとびと"],[37,1,"す"]],"text":"またソロモンはヒラムから送られた町々を建て直して、そこにイスラエルの人々を住ませた。"},{"ref":"2Chr.8.3","start":14008003,"end":14008003,"break":"paragraph","ruby":[[14,1,"せ"],[21,1,"と"]],"text":"ソロモンはまたハマテ・ゾバを攻めて、これを取った。"},{"ref":"2Chr.8.4","start":14008004,"end":14008004,"break":"none","ruby":[[0,1,"かれ"],[4,2,"あらの"],[12,1,"た"],[20,1,"くら"],[22,1,"まち"],[28,1,"た"]],"text":"彼はまた荒野にタデモルを建て、もろもろの倉の町をハマテに建てた。"},{"ref":"2Chr.8.5","start":14008005,"end":14008005,"break":"none","ruby":[[2,2,"じょうへき"],[5,1,"もん"],[7,1,"かん"],[9,1,"き"],[13,2,"けんご"],[16,1,"まち"],[18,1,"うえ"],[25,1,"した"],[32,1,"た"]],"text":"また城壁、門、貫の木のある堅固な町、上ベテホロンと下ベテホロンを建てた。"},{"ref":"2Chr.8.6","start":14008006,"end":14008006,"break":"none","ruby":[[12,2,"じぶん"],[24,1,"くら"],[26,1,"まち"],[33,2,"せんしゃ"],[36,1,"まち"],[39,2,"きへい"],[42,1,"まち"],[61,2,"じぶん"],[64,1,"おさ"],[67,1,"ぜん"],[68,2,"ちほう"],[71,1,"た"],[76,1,"のぞ"],[88,1,"た"]],"text":"ソロモンはまたバアラテと自分のもっていたすべての倉の町と、すべての戦車の町と、騎兵の町、ならびにエルサレム、レバノンおよび自分の治める全地方に建てようと望んだものを、ことごとく建てた。"},{"ref":"2Chr.8.7","start":14008007,"end":14008007,"break":"none","ruby":[[9,2,"しそん"],[42,1,"のこ"],[45,1,"たみ"]],"text":"すべてイスラエルの子孫でないヘテびと、アモリびと、ペリジびと、ヒビびと、エブスびとの残った民、"},{"ref":"2Chr.8.8","start":14008008,"end":14008008,"break":"none","ruby":[[2,1,"ち"],[7,1,"かれ"],[13,1,"のこ"],[18,2,"しそん"],[31,2,"しそん"],[34,1,"ほろ"],[37,1,"つく"],[43,1,"たみ"],[51,2,"きょうせい"],[53,2,"ちょうぼ"],[61,2,"こんにち"],[64,1,"およ"]],"text":"その地にあって彼らのあとに残ったその子孫、すなわちイスラエルの子孫が滅ぼし尽さなかった民に、ソロモンは強制徴募をおこなって今日に及んでいる。"},{"ref":"2Chr.8.9","start":14008009,"end":14008009,"break":"none","ruby":[[10,2,"ひとびと"],[20,2,"こうじ"],[32,2,"どれい"],[41,1,"かれ"],[44,2,"へいし"],[50,2,"しょうこう"],[56,2,"せんしゃ"],[60,2,"きへい"],[63,1,"ちょう"]],"text":"しかし、イスラエルの人々をソロモンはその工事のためには、ひとりも奴隷としなかった。彼らは兵士となり、将校となり、戦車と、騎兵の長となった。"},{"ref":"2Chr.8.10","start":14008010,"end":14008010,"break":"none","ruby":[[8,1,"おう"],[13,2,"かんり"],[21,1,"にん"],[25,1,"たみ"],[27,1,"おさ"]],"text":"これらはソロモン王のおもな官吏で、二百五十人あり、民を治めた。"},{"ref":"2Chr.8.11","start":14008011,"end":14008011,"break":"paragraph","ruby":[[8,1,"むすめ"],[14,1,"まち"],[17,1,"つ"],[19,1,"のぼ"],[23,2,"かのじょ"],[29,1,"た"],[32,1,"いえ"],[34,1,"い"],[37,1,"い"],[42,1,"しゅ"],[44,1,"はこ"],[46,1,"むか"],[49,1,"ところ"],[51,2,"しんせい"],[63,1,"つま"],[71,1,"おう"],[76,1,"いえ"],[78,1,"す"]],"text":"ソロモンはパロの娘をダビデの町から連れ上って、彼女のために建てた家に入れて言った、「主の箱を迎えた所は神聖であるから、わたしの妻はイスラエルの王ダビデの家に住んではならない」。"},{"ref":"2Chr.8.12","start":14008012,"end":14008012,"break":"paragraph","ruby":[[5,1,"ろう"],[7,1,"まえ"],[9,1,"きず"],[15,1,"しゅ"],[17,2,"さいだん"],[20,1,"うえ"],[22,1,"しゅ"],[24,2,"はんさい"]],"text":"ソロモンは廊の前に築いておいた主の祭壇の上で主に燔祭をささげた。"},{"ref":"2Chr.8.13","start":14008013,"end":14008013,"break":"none","ruby":[[8,2,"めいれい"],[11,1,"したが"],[15,2,"まいにち"],[17,1,"さだ"],[27,3,"あんそくにち"],[31,2,"しんげつ"],[36,1,"ねん"],[39,1,"ど"],[41,1,"まつり"],[47,1,"たね"],[48,1,"い"],[54,1,"まつり"],[57,1,"しゅう"],[59,1,"まつり"],[61,2,"かりいお"],[64,1,"まつり"]],"text":"すなわちモーセの命令に従って、毎日定めのようにささげ、安息日、新月および年に三度の祭、すなわち種入れぬパンの祭、七週の祭、仮庵の祭にこれをささげた。"},{"ref":"2Chr.8.14","start":14008014,"end":14008014,"break":"none","ruby":[[8,1,"ちち"],[17,1,"したが"],[21,2,"さいし"],[24,1,"くみ"],[26,1,"さだ"],[31,1,"しょく"],[33,1,"にん"],[45,1,"つと"],[48,1,"にん"],[52,2,"まいにち"],[54,1,"さだ"],[60,2,"さいし"],[63,1,"まえ"],[69,2,"ほうし"],[77,1,"もん"],[79,1,"まも"],[81,1,"もの"],[86,1,"くみ"],[99,1,"もん"],[101,1,"まも"],[109,1,"かみ"],[111,1,"ひと"],[121,1,"めい"]],"text":"ソロモンは、その父ダビデのおきてに従って、祭司の組を定めてその職に任じ、またレビびとをその勤めに任じて、毎日定めのように祭司の前でさんびと奉仕をさせ、また門を守る者に、その組にしたがって、もろもろの門を守らせた。これは神の人ダビデがこのように命じたからである。"},{"ref":"2Chr.8.15","start":14008015,"end":14008015,"break":"none","ruby":[[0,2,"さいし"],[12,1,"こと"],[19,1,"くら"],[21,1,"こと"],[27,1,"おう"],[29,2,"めいれい"]],"text":"祭司とレビびとはすべての事につき、また倉の事について、王の命令にそむかなかった。"},{"ref":"2Chr.8.16","start":14008016,"end":14008016,"break":"paragraph","ruby":[[11,1,"しゅ"],[13,1,"みや"],[15,1,"もとい"],[20,1,"ひ"],[28,1,"お"],[38,2,"こうじ"],[41,2,"じゅんび"],[55,1,"しゅ"],[57,1,"みや"],[59,2,"かんせい"]],"text":"このようにソロモンは、主の宮の基をすえた日からこれをなし終えたときまで、その工事の準備をことごとくなしたので、主の宮は完成した。"},{"ref":"2Chr.8.17","start":14008017,"end":14008017,"break":"paragraph","ruby":[[13,1,"ち"],[15,1,"うみ"],[35,1,"い"]],"text":"それからソロモンはエドムの地の海べにあるエジオン・ゲベルおよびエロテへ行った。"},{"ref":"2Chr.8.18","start":14008018,"end":14008018,"break":"none","ruby":[[0,1,"とき"],[14,1,"て"],[19,2,"せんだん"],[22,1,"かれ"],[24,1,"おく"],[29,1,"うみ"],[31,1,"こと"],[50,1,"かれ"],[63,1,"とも"],[69,1,"い"],[76,1,"きん"],[86,1,"と"],[97,1,"おう"],[102,1,"たずさ"]],"text":"時にヒラムはそのしもべどもの手によって船団を彼に送り、また海の事になれたしもべどもをつかわしたので、彼らはソロモンのしもべらと共にオフルへ行き、そこから金四百五十タラントを取って、これをソロモン王のもとに携えてきた。"}]