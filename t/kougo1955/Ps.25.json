[{"ref":"Ps.25.1","start":19025001,"end":19025001,"break":"paragraph","title":"ダビデの歌","ruby":[[0,1,"しゅ"],[5,1,"たましい"],[11,1,"あお"],[13,1,"のぞ"]],"titleRuby":[[4,1,"うた"]],"text":"主よ、わが魂はあなたを仰ぎ望みます。"},{"ref":"Ps.25.2","start":19025002,"end":19025002,"break":"line","breaks":[[19,"line"],[34,"line"]],"ruby":[[2,1,"かみ"],[13,2,"しんらい"],[38,1,"てき"],[40,1,"か"],[42,1,"ほこ"]],"text":"わが神よ、わたしはあなたに信頼します。どうか、わたしをはずかしめず、わたしの敵を勝ち誇らせないでください。"},{"ref":"Ps.25.3","start":19025003,"end":19025003,"break":"line","breaks":[[20,"line"]],"ruby":[[7,1,"ま"],[9,1,"のぞ"],[11,1,"もの"],[24,2,"しんぎ"],[30,1,"もの"]],"text":"すべてあなたを待ち望む者をはずかしめず、みだりに信義にそむく者をはずかしめてください。"},{"ref":"Ps.25.4","start":19025004,"end":19025004,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"おおじ"],[14,1,"し"],[22,1,"みち"],[28,1,"おし"]],"text":"主よ、あなたの大路をわたしに知らせ、あなたの道をわたしに教えてください。"},{"ref":"Ps.25.5","start":19025005,"end":19025005,"break":"line","breaks":[[19,"line"],[31,"line"],[43,"line"]],"ruby":[[16,1,"みちび"],[23,1,"おし"],[37,1,"すくい"],[39,1,"かみ"],[55,1,"ま"],[57,1,"のぞ"]],"text":"あなたのまことをもって、わたしを導き、わたしを教えてください。あなたはわが救の神です。わたしはひねもすあなたを待ち望みます。"},{"ref":"Ps.25.6","start":19025006,"end":19025006,"break":"line","breaks":[[20,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[20,1,"おも"],[22,1,"だ"],[39,1,"た"]],"text":"主よ、あなたのあわれみと、いつくしみとを思い出してください。これはいにしえから絶えることがなかったのです。"},{"ref":"Ps.25.7","start":19025007,"end":19025007,"break":"line","breaks":[[15,"line"],[27,"line"],[41,"line"],[57,"line"]],"ruby":[[4,1,"わか"],[6,1,"とき"],[8,1,"つみ"],[15,1,"おも"],[17,1,"だ"],[27,1,"しゅ"],[34,1,"めぐ"],[61,1,"おも"],[63,1,"だ"]],"text":"わたしの若き時の罪と、とがとを思い出さないでください。主よ、あなたの恵みのゆえに、あなたのいつくしみにしたがって、わたしを思い出してください。"},{"ref":"Ps.25.8","start":19025008,"end":19025008,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"めぐ"],[10,1,"ただ"],[25,1,"しゅ"],[27,1,"みち"],[29,1,"つみ"],[33,1,"おし"]],"text":"主は恵みふかく、かつ正しくいらせられる。それゆえ、主は道を罪びとに教え、"},{"ref":"Ps.25.9","start":19025009,"end":19025009,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"もの"],[7,2,"こうぎ"],[10,1,"みちび"],[18,1,"もの"],[22,1,"みち"],[24,1,"おし"]],"text":"へりくだる者を公義に導き、へりくだる者にその道を教えられる。"},{"ref":"Ps.25.10","start":19025010,"end":19025010,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"みち"],[10,2,"けいやく"],[18,1,"まも"],[20,1,"もの"]],"text":"主のすべての道はその契約とあかしとを守る者にはいつくしみであり、まことである。"},{"ref":"Ps.25.11","start":19025011,"end":19025011,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"な"],[14,1,"つみ"],[29,1,"つみ"],[31,1,"おお"]],"text":"主よ、み名のために、わたしの罪をおゆるしください。わたしの罪は大きいのです。"},{"ref":"Ps.25.12","start":19025012,"end":19025012,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[5,1,"ひと"],[11,1,"しゅ"],[15,1,"えら"],[19,1,"みち"],[23,1,"ひと"],[25,1,"おし"]],"text":"主を恐れる人はだれか。主はその選ぶべき道をその人に教えられる。"},{"ref":"Ps.25.13","start":19025013,"end":19025013,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[11,1,"す"],[20,1,"ち"],[22,1,"つ"]],"text":"彼はみずからさいわいに住まい、そのすえは地を継ぐであろう。"},{"ref":"Ps.25.14","start":19025014,"end":19025014,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"した"],[6,1,"しゅ"],[12,1,"もの"],[20,1,"しゅ"],[24,2,"けいやく"],[27,1,"かれ"],[30,1,"し"]],"text":"主の親しみは主をおそれる者のためにあり、主はその契約を彼らに知らせられる。"},{"ref":"Ps.25.15","start":19025015,"end":19025015,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"め"],[6,1,"つね"],[8,1,"しゅ"],[10,1,"む"],[17,1,"しゅ"],[23,1,"あし"],[25,1,"あみ"],[28,1,"と"],[30,1,"だ"]],"text":"わたしの目は常に主に向かっている。主はわたしの足を網から取り出されるからである。"},{"ref":"Ps.25.16","start":19025016,"end":19025016,"break":"line","breaks":[[23,"line"]],"ruby":[[34,1,"くる"]],"text":"わたしをかえりみ、わたしをあわれんでください。わたしはひとりわびしく苦しんでいるのです。"},{"ref":"Ps.25.17","start":19025017,"end":19025017,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"こころ"],[6,1,"なや"],[17,1,"くる"],[22,1,"ひ"],[24,1,"だ"]],"text":"わたしの心の悩みをゆるめ、わたしを苦しみから引き出してください。"},{"ref":"Ps.25.18","start":19025018,"end":19025018,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"くる"],[7,1,"なや"],[23,1,"つみ"]],"text":"わたしの苦しみ悩みをかえりみ、わたしのすべての罪をおゆるしください。"},{"ref":"Ps.25.19","start":19025019,"end":19025019,"break":"line","breaks":[[12,"line"],[24,"line"]],"ruby":[[4,1,"てき"],[9,1,"おお"],[14,1,"はげ"],[17,1,"にく"],[28,1,"にく"]],"text":"わたしの敵がいかに多く、かつ激しい憎しみをもってわたしを憎んでいるかをごらんください。"},{"ref":"Ps.25.20","start":19025020,"end":19025020,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[4,1,"たましい"],[6,1,"まも"],[14,1,"たす"],[46,1,"よ"],[48,1,"たよ"]],"text":"わたしの魂を守り、わたしをお助けください。わたしをはずかしめないでください。わたしはあなたに寄り頼んでいます。"},{"ref":"Ps.25.21","start":19025021,"end":19025021,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[4,2,"せいじつ"],[7,2,"けっぱく"],[16,1,"まも"],[34,1,"ま"],[36,1,"のぞ"]],"text":"どうか、誠実と潔白とが、わたしを守ってくれるように。わたしはあなたを待ち望んでいます。"},{"ref":"Ps.25.22","start":19025022,"end":19025022,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[18,1,"なや"],[22,1,"すく"]],"text":"神よ、イスラエルをあがない、すべての悩みから救いだしてください。"}]