[{"ref":"Job.10.1","start":18010001,"end":18010001,"break":"paragraph","breaks":[[13,"line"],[33,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"いのち"],[17,2,"じぶん"],[20,1,"なげ"],[23,1,"つつ"],[26,1,"い"],[35,1,"たましい"],[37,1,"くる"],[44,1,"かた"]],"text":"わたしは自分の命をいとう。わたしは自分の嘆きを包まず言いあらわし、わが魂の苦しみによって語ろう。"},{"ref":"Job.10.2","start":18010002,"end":18010002,"break":"line","breaks":[[10,"line"],[27,"line"]],"ruby":[[4,1,"かみ"],[6,1,"もう"],[14,1,"つみ"],[17,1,"もの"],[33,1,"あらそ"],[39,1,"し"]],"text":"わたしは神に申そう、わたしを罪ある者とされないように。なぜわたしと争われるかを知らせてほしい。"},{"ref":"Job.10.3","start":18010003,"end":18010003,"break":"line","breaks":[[21,"line"]],"ruby":[[13,1,"て"],[18,1,"す"],[21,2,"あくにん"],[24,2,"けいかく"],[27,1,"てら"],[32,1,"よ"]],"text":"あなたはしえたげをなし、み手のわざを捨て、悪人の計画を照すことを良しとされるのか。"},{"ref":"Job.10.4","start":18010004,"end":18010004,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"も"],[13,1,"にく"],[15,1,"め"],[22,1,"ひと"],[24,1,"み"],[29,1,"み"]],"text":"あなたの持っておられるのは肉の目か、あなたは人が見るように見られるのか。"},{"ref":"Job.10.5","start":18010005,"end":18010005,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"ひ"],[6,1,"ひと"],[8,1,"ひ"],[18,1,"とし"],[20,1,"ひと"],[22,1,"ねん"]],"text":"あなたの日は人の日のごとく、あなたの年は人の年のようであるのか。"},{"ref":"Job.10.6","start":18010006,"end":18010006,"break":"line","breaks":[[18,"line"]],"ruby":[[15,1,"たず"],[22,1,"つみ"],[24,1,"しら"]],"text":"あなたはなにゆえわたしのとがを尋ね、わたしの罪を調べられるのか。"},{"ref":"Job.10.7","start":18010007,"end":18010007,"break":"line","breaks":[[23,"line"]],"ruby":[[8,1,"つみ"],[15,1,"し"],[29,1,"て"],[32,1,"すく"],[34,1,"だ"],[38,1,"もの"]],"text":"あなたはわたしの罪のないことを知っておられる。またあなたの手から救い出しうる者はない。"},{"ref":"Job.10.8","start":18010008,"end":18010008,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"て"],[19,1,"つく"],[27,1,"いま"],[41,1,"ほろ"]],"text":"あなたの手はわたしをかたどり、わたしを作った。ところが今あなたはかえって、わたしを滅ぼされる。"},{"ref":"Job.10.9","start":18010009,"end":18010009,"break":"line","breaks":[[11,"line"],[33,"line"]],"ruby":[[3,1,"おぼ"],[15,1,"つち"],[26,1,"つく"],[30,1,"こと"],[45,1,"かえ"]],"text":"どうぞ覚えてください、あなたは土くれをもってわたしを作られた事を。ところが、わたしをちりに返そうとされるのか。"},{"ref":"Job.10.10","start":18010010,"end":18010010,"break":"line","breaks":[[16,"line"]],"ruby":[[8,1,"ちち"],[13,1,"そそ"],[16,2,"かんらく"],[22,1,"こ"],[24,1,"かた"]],"text":"あなたはわたしを乳のように注ぎ、乾酪のように凝り固まらせたではないか。"},{"ref":"Job.10.11","start":18010011,"end":18010011,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"にく"],[6,1,"かわ"],[13,1,"き"],[16,1,"ほね"],[18,1,"すじ"],[28,1,"あ"]],"text":"あなたは肉と皮とをわたしに着せ、骨と筋とをもってわたしを編み、"},{"ref":"Job.10.12","start":18010012,"end":18010012,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"いのち"],[13,1,"さづ"],[20,1,"かえり"],[25,1,"れい"],[27,1,"まも"]],"text":"命といつくしみとをわたしに授け、わたしを顧みてわが霊を守られた。"},{"ref":"Job.10.13","start":18010013,"end":18010013,"break":"line","breaks":[[23,"line"],[41,"line"]],"ruby":[[11,1,"こと"],[14,1,"こころ"],[16,1,"ひ"],[25,1,"こと"],[31,1,"こころ"],[39,1,"こと"],[45,1,"し"]],"text":"しかしあなたはこれらの事をみ心に秘めおかれた。この事があなたの心のうちにあった事をわたしは知っている。"},{"ref":"Job.10.14","start":18010014,"end":18010014,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[6,1,"つみ"],[8,1,"おか"],[20,1,"め"],[30,1,"つみ"],[33,1,"と"],[35,1,"はな"]],"text":"わたしがもし罪を犯せば、あなたはわたしに目をつけて、わたしを罪から解き放されない。"},{"ref":"Job.10.15","start":18010015,"end":18010015,"break":"line","breaks":[[20,"line"],[33,"line"],[50,"line"]],"ruby":[[6,1,"わる"],[27,1,"ただ"],[37,1,"あたま"],[39,1,"あ"],[54,1,"はじ"],[56,1,"み"],[59,1,"なや"],[62,1,"み"]],"text":"わたしがもし悪ければわたしはわざわいだ。たといわたしが正しくても、わたしは頭を上げることができない。わたしは恥に満ち、悩みを見ているからだ。"},{"ref":"Job.10.16","start":18010016,"end":18010016,"break":"line","breaks":[[9,"line"],[27,"line"]],"ruby":[[2,1,"あたま"],[24,1,"お"],[35,1,"ふたた"],[41,1,"ちから"]],"text":"もし頭をあげれば、あなたは、ししのようにわたしを追い、わたしにむかって再びくすしき力をあらわされる。"},{"ref":"Job.10.17","start":18010017,"end":18010017,"break":"line","breaks":[[19,"line"],[37,"line"]],"ruby":[[4,2,"しょうにん"],[7,1,"い"],[9,1,"か"],[16,1,"せ"],[31,1,"いか"],[34,1,"ま"],[37,1,"あら"],[40,2,"ぐんぜい"],[43,1,"だ"],[50,1,"せ"]],"text":"あなたは証人を入れ替えてわたしを攻め、わたしにむかってあなたの怒りを増し、新たに軍勢を出してわたしを攻められる。"},{"ref":"Job.10.18","start":18010018,"end":18010018,"break":"stanza","breaks":[[21,"line"]],"ruby":[[12,1,"たい"],[15,1,"だ"],[25,1,"いき"],[26,1,"た"],[29,1,"め"],[31,1,"み"]],"text":"なにゆえあなたはわたしを胎から出されたか、わたしは息絶えて目に見られることなく、"},{"ref":"Job.10.19","start":18010019,"end":18010019,"break":"line","breaks":[[10,"line"],[29,"line"]],"ruby":[[0,1,"たい"],[3,1,"はか"],[5,1,"はこ"],[10,1,"はじ"],[18,1,"もの"]],"text":"胎から墓に運ばれて、初めからなかった者のようであったなら、よかったのに。"},{"ref":"Job.10.20","start":18010020,"end":18010020,"break":"line","breaks":[[21,"line"],[36,"line"]],"ruby":[[4,1,"いのち"],[6,1,"ひ"],[32,1,"はな"],[36,1,"すこ"],[39,1,"なぐさ"],[42,1,"え"]],"text":"わたしの命の日はいくばくもないではないか。どうぞ、しばしわたしを離れて、少しく慰めを得させられるように。"},{"ref":"Job.10.21","start":18010021,"end":18010021,"break":"line","breaks":[[20,"line"],[33,"line"]],"ruby":[[4,1,"い"],[8,1,"かえ"],[17,1,"まえ"],[23,1,"え"],[37,1,"くら"],[39,1,"ち"],[41,2,"あんこく"],[44,1,"ち"],[46,1,"い"]],"text":"わたしが行って、帰ることのないその前に、これを得させられるように。わたしは暗き地、暗黒の地へ行く。"},{"ref":"Job.10.22","start":18010022,"end":18010022,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"くら"],[5,1,"ち"],[16,2,"あんこく"],[19,2,"ちつじょ"],[24,1,"ひかり"]],"text":"これは暗き地で、やみにひとしく、暗黒で秩序なく、光もやみのようだ」。"}]