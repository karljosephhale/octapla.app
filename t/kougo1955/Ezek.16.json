[{"ref":"Ezek.16.1","start":26016001,"end":26016001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[5,1,"ふたた"],[11,1,"のぞ"]],"text":"主の言葉が再びわたしに臨んだ、"},{"ref":"Ezek.16.2","start":26016002,"end":26016002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[14,1,"にく"],[18,1,"こと"],[22,1,"しめ"]],"text":"「人の子よ、エルサレムにその憎むべき事どもを示して、"},{"ref":"Ezek.16.3","start":26016003,"end":26016003,"break":"none","ruby":[[0,1,"い"],[3,1,"しゅ"],[6,1,"かみ"],[16,1,"い"],[25,1,"おこ"],[32,1,"うま"],[41,1,"ち"],[50,1,"ちち"],[62,1,"はは"]],"text":"言え。主なる神はエルサレムにこう言われる、あなたの起り、あなたの生れはカナンびとの地である。あなたの父はアモリびと、あなたの母はヘテびとである。"},{"ref":"Ezek.16.4","start":26016004,"end":26016004,"break":"none","ruby":[[4,1,"うま"],[16,1,"うま"],[19,1,"ひ"],[25,1,"お"],[27,1,"き"],[32,1,"みず"],[34,1,"あら"],[36,1,"きよ"],[42,1,"しお"],[52,1,"ぬの"],[54,1,"つつ"]],"text":"あなたの生れについていえば、その生れた日に、へその緒は切られず、水で洗い清められず、塩でこすられず、また布で包まれなかった。"},{"ref":"Ezek.16.5","start":26016005,"end":26016005,"break":"none","ruby":[[12,1,"み"],[14,1,"もの"],[18,1,"じょう"],[43,1,"もの"],[52,1,"うま"],[55,1,"ひ"],[68,2,"のはら"],[71,1,"す"]],"text":"ひとりもあなたをあわれみ見る者なく、情をもってこれらのことの一つをも、あなたにしてやる者もなく、あなたの生れた日に、あなたはきらわれて、野原に捨てられた。"},{"ref":"Ezek.16.6","start":26016006,"end":26016006,"break":"paragraph","ruby":[[13,1,"とお"],[20,1,"ち"],[22,1,"なか"],[36,1,"み"],[38,1,"とき"],[44,1,"ち"],[46,1,"なか"],[54,1,"い"],[59,1,"い"]],"text":"わたしはあなたのかたわらを通り、あなたが血の中にころがりまわっているのを見た時、わたしは血の中にいるあなたに言った、『生きよ、"},{"ref":"Ezek.16.7","start":26016007,"end":26016007,"break":"none","ruby":[[0,1,"の"],[2,1,"き"],[7,1,"そだ"],[20,2,"せいちょう"],[24,1,"おお"],[30,3,"いちにんまえ"],[34,1,"おんな"],[41,1,"ち"],[45,1,"かたち"],[47,1,"ととの"],[50,1,"かみ"],[52,1,"なが"],[59,2,"きもの"],[65,1,"はだか"]],"text":"野の木のように育て』と。すなわちあなたは成長して大きくなり、一人前の女になり、その乳ぶさは形が整い、髪は長くなったが、着物がなく、裸であった。"},{"ref":"Ezek.16.8","start":26016008,"end":26016008,"break":"paragraph","ruby":[[4,1,"ふたた"],[24,1,"み"],[28,1,"み"],[35,1,"あい"],[40,2,"ねんれい"],[43,1,"たっ"],[55,2,"きもの"],[73,1,"はだか"],[86,1,"ちか"],[93,2,"けいやく"],[96,1,"むす"],[119,1,"しゅ"],[122,1,"かみ"],[124,1,"い"]],"text":"わたしは再びあなたのかたわらをとおって、あなたを見たが、見よ、あなたは愛せられる年齢に達していたので、わたしは着物のすそであなたをおおい、あなたの裸をかくし、そしてあなたに誓い、あなたと契約を結んだ。そしてあなたはわたしのものとなったと、主なる神は言われる。"},{"ref":"Ezek.16.9","start":26016009,"end":26016009,"break":"none","ruby":[[7,1,"みず"],[13,1,"あら"],[20,1,"ち"],[22,1,"あら"],[24,1,"おと"],[27,1,"あぶら"],[29,1,"ぬ"]],"text":"そこでわたしは水であなたを洗い、あなたの血を洗い落して油を塗り、"},{"ref":"Ezek.16.10","start":26016010,"end":26016010,"break":"none","ruby":[[0,1,"ぬ"],[2,1,"と"],[6,2,"きもの"],[9,1,"き"],[12,1,"かわ"],[21,1,"ほそ"],[22,1,"ぬの"],[29,1,"きぬ"]],"text":"縫い取りした着物を着せ、皮のくつをはかせ、細布をかぶらせ、絹のきれであなたをおおった。"},{"ref":"Ezek.16.11","start":26016011,"end":26016011,"break":"none","ruby":[[2,1,"かざ"],[4,1,"もの"],[10,1,"かざ"],[13,2,"うでわ"],[20,1,"て"],[25,1,"くさり"],[31,1,"くび"]],"text":"また飾り物であなたを飾り、腕輪をあなたの手にはめ、鎖をあなたの首にかけ、"},{"ref":"Ezek.16.12","start":26016012,"end":26016012,"break":"none","ruby":[[0,1,"はな"],[3,2,"はなわ"],[6,1,"みみ"],[9,2,"みみわ"],[12,1,"あたま"],[15,1,"うつく"],[18,1,"かんむり"],[20,1,"あた"]],"text":"鼻には鼻輪、耳には耳輪、頭には美しい冠を与えた。"},{"ref":"Ezek.16.13","start":26016013,"end":26016013,"break":"none","ruby":[[9,2,"きんぎん"],[12,1,"かざ"],[16,1,"ほそ"],[17,1,"ぬの"],[19,1,"きぬ"],[21,1,"ぬ"],[23,1,"と"],[26,1,"ふく"],[32,1,"ころも"],[36,2,"むぎこ"],[40,1,"みつ"],[43,1,"あぶら"],[46,1,"た"],[54,2,"ひじょう"],[57,1,"うつく"],[63,1,"おう"],[65,2,"ちい"],[68,1,"すす"]],"text":"このようにあなたは金銀で飾られ、細布、絹、縫い取りの服をあなたの衣とし、麦粉と、蜜と、油とを食べた。あなたは非常に美しくなって王の地位に進み、"},{"ref":"Ezek.16.14","start":26016014,"end":26016014,"break":"none","ruby":[[4,1,"うつく"],[16,2,"めいせい"],[19,2,"くにぐに"],[22,1,"ひろ"],[39,1,"ほどこ"],[42,1,"かざ"],[48,1,"まっと"],[60,1,"しゅ"],[63,1,"かみ"],[65,1,"い"]],"text":"あなたの美しさのために、あなたの名声は国々に広まった。これはわたしが、あなたに施した飾りによって全うされたからであると、主なる神は言われる。"},{"ref":"Ezek.16.15","start":26016015,"end":26016015,"break":"paragraph","ruby":[[9,2,"じぶん"],[12,1,"うつく"],[20,2,"じぶん"],[23,2,"めいせい"],[29,2,"かんいん"],[32,1,"おこな"],[43,1,"とお"],[45,1,"もの"],[54,2,"かんいん"],[57,1,"おこな"]],"text":"ところが、あなたは自分の美しさをたのみ、自分の名声によって姦淫を行い、すべてかたわらを通る者と、ほしいままに姦淫を行った。"},{"ref":"Ezek.16.16","start":26016016,"end":26016016,"break":"none","ruby":[[4,2,"じぶん"],[7,1,"ころも"],[13,2,"じぶん"],[25,1,"いろ"],[29,2,"せいじょ"],[32,1,"つく"],[37,1,"うえ"],[39,2,"かんいん"],[42,1,"おこな"]],"text":"あなたは自分の衣をとって、自分のために、はなやかに色どった聖所を造り、その上で姦淫を行っている。こんなことはかつてなかったこと、またあってはならないことである。"},{"ref":"Ezek.16.17","start":26016017,"end":26016017,"break":"none","ruby":[[8,1,"あた"],[11,2,"きんぎん"],[14,1,"うつく"],[17,1,"かざ"],[20,1,"しな"],[25,2,"じぶん"],[31,1,"おとこ"],[33,1,"ぞう"],[35,1,"つく"],[42,2,"かんいん"],[45,1,"おこな"]],"text":"あなたはわたしが与えた金銀の美しい飾りの品をとり、自分のために男の像を造って、これと姦淫を行った。"},{"ref":"Ezek.16.18","start":26016018,"end":26016018,"break":"none","ruby":[[2,1,"ぬ"],[4,1,"と"],[9,2,"じぶん"],[12,1,"ころも"],[17,1,"かれ"],[20,1,"き"],[27,1,"あぶら"],[29,1,"こう"],[34,1,"まえ"],[36,1,"そな"]],"text":"また縫い取りのある自分の衣をとって彼らに着せ、わたしの油と香とをその前に供え、"},{"ref":"Ezek.16.19","start":26016019,"end":26016019,"break":"none","ruby":[[10,1,"あた"],[24,1,"やしな"],[29,2,"むぎこ"],[32,1,"あぶら"],[36,1,"みつ"],[50,1,"かれ"],[53,1,"まえ"],[55,1,"そな"],[60,1,"しゅ"],[63,1,"かみ"],[65,1,"い"]],"text":"またわたしがあなたに与えたパン、わたしがあなたを養うための麦粉、油および蜜を、こうばしきかおりとして彼らの前に供えたと、主なる神は言われる。"},{"ref":"Ezek.16.20","start":26016020,"end":26016020,"break":"none","ruby":[[15,1,"う"],[22,1,"むすめ"],[32,1,"ぞう"],[34,1,"そな"],[37,1,"かれ"],[40,1,"く"],[54,2,"かんいん"],[57,1,"ちい"],[60,1,"こと"]],"text":"あなたはまた、あなたがわたしに産んだむすこ、娘たちをとって、その像に供え、彼らに食わせた。このようなあなたの姦淫は小さい事であろうか。"},{"ref":"Ezek.16.21","start":26016021,"end":26016021,"break":"none","ruby":[[8,1,"こ"],[12,1,"ころ"],[15,1,"ひ"],[17,1,"なか"],[19,1,"とお"],[23,1,"かれ"]],"text":"あなたはわたしの子どもを殺し、火の中を通らせて彼らにささげた。"},{"ref":"Ezek.16.22","start":26016022,"end":26016022,"break":"none","ruby":[[10,1,"にく"],[17,2,"かんいん"],[20,1,"おこな"],[23,1,"あた"],[31,1,"ころも"],[36,1,"はだか"],[39,1,"ち"],[41,1,"なか"],[53,2,"じぶん"],[56,1,"わか"],[58,1,"ひ"],[63,1,"おも"]],"text":"あなたがそのすべての憎むべきことや姦淫を行うに当って、あなたが衣もなく、裸で、血の中にころがりまわっていた自分の若き日のことを思わなかった。"},{"ref":"Ezek.16.23","start":26016023,"end":26016023,"break":"paragraph","ruby":[[9,1,"あく"],[11,1,"おこな"],[14,1,"のち"],[34,1,"しゅ"],[37,1,"かみ"],[39,1,"い"]],"text":"あなたがもろもろの悪を行った後、（あなたはわざわいだ、わざわいだと、主なる神は言われる）"},{"ref":"Ezek.16.24","start":26016024,"end":26016024,"break":"none","ruby":[[4,2,"じぶん"],[10,2,"こうろう"],[13,1,"た"],[16,2,"ひろば"],[19,2,"ひろば"],[22,1,"だい"],[24,1,"つく"]],"text":"あなたは自分のために高楼を建て、広場、広場に台を造り、"},{"ref":"Ezek.16.25","start":26016025,"end":26016025,"break":"none","ruby":[[11,1,"だい"],[13,1,"つく"],[21,1,"うつく"],[25,1,"けが"],[36,1,"とお"],[38,1,"もの"],[40,1,"み"],[47,1,"おお"],[50,2,"かんいん"],[53,1,"おこな"]],"text":"ちまた、ちまたのつじに台を造って、あなたの美しさを汚し、すべてかたわらを通る者に身をまかせて、大いに姦淫を行っている。"},{"ref":"Ezek.16.26","start":26016026,"end":26016026,"break":"none","ruby":[[9,2,"にくよく"],[11,1,"まと"],[13,1,"とな"],[20,2,"ひとびと"],[23,2,"かんいん"],[26,1,"おこな"],[29,1,"おお"],[32,2,"かんいん"],[35,1,"おこな"],[43,1,"いか"]],"text":"あなたはまた、かの肉欲的な隣りエジプトの人々と姦淫を行い、大いに姦淫を行って、わたしを怒らせた。"},{"ref":"Ezek.16.27","start":26016027,"end":26016027,"break":"none","ruby":[[13,1,"て"],[19,1,"うえ"],[21,1,"の"],[29,1,"たま"],[32,1,"ぶん"],[34,1,"へ"],[42,1,"てき"],[57,2,"こうい"],[60,1,"は"],[70,1,"むすめ"],[73,1,"よく"],[83,1,"わた"]],"text":"それゆえ、わたしはわたしの手をあなたの上に伸べて、あなたの賜わる分を減らし、あなたの敵、すなわち、あなたのみだらな行為を恥じるペリシテびとの娘らの欲のままに、あなたを渡した。"},{"ref":"Ezek.16.28","start":26016028,"end":26016028,"break":"none","ruby":[[4,1,"あ"],[22,2,"ひとびと"],[25,2,"かんいん"],[28,1,"おこな"],[33,1,"かれ"],[36,2,"かんいん"],[39,1,"おこな"],[46,1,"あ"]],"text":"あなたは飽くことがないので、またアッスリヤの人々と姦淫を行ったが、彼らと姦淫を行っても、なお飽くことがなかった。"},{"ref":"Ezek.16.29","start":26016029,"end":26016029,"break":"none","ruby":[[11,2,"しょうぎょう"],[13,1,"ち"],[15,1,"おお"],[18,2,"かんいん"],[21,1,"おこな"],[29,2,"かんいん"],[32,1,"おこな"],[39,1,"あ"]],"text":"あなたはまたカルデヤの商業地と大いに姦淫を行ったが、これと姦淫を行っても、なお飽くことがなかった。"},{"ref":"Ezek.16.30","start":26016030,"end":26016030,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[14,1,"こころ"],[20,1,"こ"],[41,1,"こと"],[43,1,"おこな"],[56,2,"かんいん"]],"text":"主なる神は言われる、あなたの心はどんなに恋いわずらうのか。あなたは、これらすべての事を行った。これはあつかましい姦淫のわざである。"},{"ref":"Ezek.16.31","start":26016031,"end":26016031,"break":"none","ruby":[[16,2,"こうろう"],[19,1,"た"],[22,2,"ひろば"],[25,2,"ひろば"],[28,1,"だい"],[30,1,"もう"],[35,1,"あたい"],[51,2,"ゆうじょ"]],"text":"あなたは、ちまた、ちまたのつじに高楼を建て、広場、広場に台を設けたが、価をもらうことをあざけったので、遊女のようではなかった。"},{"ref":"Ezek.16.32","start":26016032,"end":26016032,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"おっと"],[5,1,"か"],[8,2,"たにん"],[11,1,"つう"],[14,2,"かんぷ"]],"text":"自分の夫に替えて他人と通じる姦婦よ。"},{"ref":"Ezek.16.33","start":26016033,"end":26016033,"break":"none","ruby":[[0,1,"ひと"],[6,2,"ゆうじょ"],[9,1,"もの"],[11,1,"あた"],[26,2,"こいびと"],[29,1,"もの"],[31,1,"あた"],[34,1,"かれ"],[48,2,"かんいん"],[56,2,"しほう"],[64,1,"ところ"]],"text":"人はすべての遊女に物を与える。しかしあなたはすべての恋人に物を与え、彼らにまいないして、あなたと姦淫するために、四方からあなたの所にこさせる。"},{"ref":"Ezek.16.34","start":26016034,"end":26016034,"break":"none","ruby":[[9,2,"かんいん"],[12,1,"おこな"],[15,1,"あた"],[19,1,"た"],[21,1,"おんな"],[23,1,"ちが"],[41,2,"かんいん"],[61,1,"あたい"],[63,1,"はら"],[66,2,"あいて"],[73,1,"はら"],[85,1,"ちが"]],"text":"このようにあなたは姦淫を行うに当って、他の女と違っている。すなわち、だれもあなたに姦淫をさせたのではない。あなたはかえって価を払い、相手はあなたに払わない。これがあなたの違うところである。"},{"ref":"Ezek.16.35","start":26016035,"end":26016035,"break":"paragraph","ruby":[[3,2,"ゆうじょ"],[7,1,"しゅ"],[9,2,"ことば"],[12,1,"き"]],"text":"それで遊女よ、主の言葉を聞け。"},{"ref":"Ezek.16.36","start":26016036,"end":26016036,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[18,2,"こいびと"],[21,2,"かんいん"],[30,1,"は"],[33,1,"ところ"],[44,1,"はだか"],[57,2,"ぐうぞう"],[65,1,"かれ"],[76,1,"こ"],[81,1,"ち"]],"text":"主なる神はこう言われる、あなたがその恋人と姦淫して、あなたの恥じる所をあらわし、あなたの裸をあらわし、またすべての偶像と、あなたが彼らにささげたあなたの子どもらの血のゆえに、"},{"ref":"Ezek.16.37","start":26016037,"end":26016037,"break":"none","ruby":[[0,1,"み"],[11,1,"あそ"],[22,2,"こいびと"],[35,1,"こい"],[38,1,"もの"],[48,1,"にく"],[51,1,"もの"],[54,1,"あつ"],[57,2,"しほう"],[61,1,"かれ"],[68,1,"ところ"],[70,1,"あつ"],[78,1,"はだか"],[80,1,"かれ"],[88,1,"かれ"],[95,1,"はだか"],[103,1,"み"]],"text":"見よ、わたしはあなたと遊んだあなたのすべての恋人、およびすべてあなたが恋した者と、すべてあなたが憎んだ者とを集め、四方から彼らをあなたの所に集めて、あなたの裸を彼らにあらわす。彼らはあなたの裸を、ことごとく見る。"},{"ref":"Ezek.16.38","start":26016038,"end":26016038,"break":"none","ruby":[[4,2,"かんいん"],[7,1,"おこな"],[10,1,"おんな"],[13,1,"ち"],[15,1,"なが"],[18,1,"おんな"],[37,1,"いきどお"],[45,1,"ち"],[53,1,"そそ"]],"text":"わたしは姦淫を行った女と、血を流した女がさばかれるように、あなたをさばき、憤りと、ねたみの血とを、あなたに注ぐ。"},{"ref":"Ezek.16.39","start":26016039,"end":26016039,"break":"none","ruby":[[8,2,"こいびと"],[11,1,"て"],[13,1,"わた"],[16,1,"かれ"],[23,2,"こうろう"],[26,1,"たお"],[29,1,"だい"],[39,1,"ころも"],[43,1,"と"],[50,1,"うつく"],[53,1,"かざ"],[56,1,"しな"],[58,1,"うば"],[65,2,"いふく"],[70,1,"はだか"],[71,1,"もの"]],"text":"わたしはあなたを恋人の手に渡す。彼らはあなたの高楼を倒し、台をこわし、あなたの衣をはぎ取り、あなたの美しい飾りの品を奪い、あなたを衣服のない裸者にする。"},{"ref":"Ezek.16.40","start":26016040,"end":26016040,"break":"none","ruby":[[0,1,"かれ"],[3,2,"みんしゅう"],[8,1,"た"],[15,1,"せ"],[18,1,"いし"],[24,1,"う"],[35,1,"き"]],"text":"彼らは民衆をかり立ててあなたを攻め、石であなたを撃ち、つるぎであなたを切り、"},{"ref":"Ezek.16.41","start":26016041,"end":26016041,"break":"none","ruby":[[0,1,"ひ"],[6,1,"いえ"],[8,1,"や"],[11,1,"おお"],[14,1,"おんな"],[18,1,"まえ"],[29,1,"おこな"],[44,2,"いんこう"],[52,1,"かさ"],[55,1,"あたい"],[57,1,"はら"]],"text":"火であなたの家を焼き、多くの女たちの前で、あなたにさばきを行う。こうしてわたしはあなたに淫行をやめさせ、重ねて価を払わせないようにする。"},{"ref":"Ezek.16.42","start":26016042,"end":26016042,"break":"none","ruby":[[7,1,"たい"],[12,1,"いきどお"],[30,1,"はな"],[37,1,"こころ"],[39,1,"やす"],[44,1,"ふたた"],[46,1,"いか"]],"text":"そしてあなたに対するわが憤りをしずめ、わがねたみをあなたから離し、わたしは心を安んじて、再び怒ることをしない。"},{"ref":"Ezek.16.43","start":26016043,"end":26016043,"break":"none","breaks":[[82,"paragraph"]],"ruby":[[8,1,"わか"],[10,1,"ひ"],[12,1,"こと"],[14,1,"おぼ"],[25,1,"こと"],[35,1,"いか"],[42,1,"み"],[53,1,"おこな"],[67,1,"むく"],[72,1,"しゅ"],[75,1,"かみ"],[77,1,"い"],[91,1,"にく"],[95,1,"こと"],[97,1,"くわ"],[107,1,"こと"]],"text":"またあなたはその若き日の事を覚えず、すべてこれらの事をもって、わたしを怒らせたから、見よ、わたしもあなたの行うところをあなたのこうべに報いると、主なる神は言われる。あなたはもろもろの憎むべき事に加えて、このみだらな事をおこなったではないか。"},{"ref":"Ezek.16.44","start":26016044,"end":26016044,"break":"none","ruby":[[0,1,"み"],[11,1,"もち"],[14,1,"もの"],[28,1,"はは"],[34,1,"むすめ"],[47,1,"もち"]],"text":"見よ、すべてことわざを用いる者は、あなたについて、『この母にしてこの娘あり』という、ことわざを用いる。"},{"ref":"Ezek.16.45","start":26016045,"end":26016045,"break":"none","ruby":[[7,1,"おっと"],[9,1,"こ"],[14,1,"す"],[21,1,"はは"],[23,1,"むすめ"],[29,1,"おっと"],[31,1,"こ"],[36,1,"す"],[39,2,"しまい"],[42,1,"も"],[52,1,"はは"],[63,1,"ちち"]],"text":"あなたは、その夫と子どもとを捨てたあなたの母の娘、またその夫と子どもとを捨てた姉妹を持っている。あなたの母はヘテびと、あなたの父はアモリびと、"},{"ref":"Ezek.16.46","start":26016046,"end":26016046,"break":"none","ruby":[[4,1,"あね"],[18,1,"むすめ"],[22,1,"とも"],[29,1,"きた"],[31,1,"す"],[38,1,"いもうと"],[47,1,"むすめ"],[51,1,"とも"],[58,1,"みなみ"],[60,1,"す"]],"text":"あなたの姉はサマリヤ、サマリヤはその娘たちと共に、あなたの北に住み、あなたの妹はソドムで、その娘たちと共に、あなたの南に住んでいる。"},{"ref":"Ezek.16.47","start":26016047,"end":26016047,"break":"none","ruby":[[4,1,"かれ"],[7,1,"みち"],[9,1,"あゆ"],[13,1,"かれ"],[16,1,"にく"],[20,1,"こと"],[22,1,"したが"],[48,1,"かれ"],[56,1,"わる"]],"text":"あなたは彼らの道を歩まず、彼らの憎むべき事に従っていないが、しばらくすると、あなたのおこないは、彼らよりもさらに悪くなる。"},{"ref":"Ezek.16.48","start":26016048,"end":26016048,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[14,1,"い"],[24,1,"いもうと"],[31,1,"むすめ"],[44,1,"むすめ"]],"text":"主なる神は言われる、わたしは生きている。あなたの妹ソドムとその娘たちは、あなたとあなたの娘たちがしたほどのことはしなかった。"},{"ref":"Ezek.16.49","start":26016049,"end":26016049,"break":"none","ruby":[[0,1,"み"],[7,1,"いもうと"],[12,1,"つみ"],[24,2,"かのじょ"],[30,1,"むすめ"],[34,1,"たか"],[38,2,"しょくもつ"],[41,1,"あ"],[44,2,"あんたい"],[47,1,"くら"],[54,1,"かれ"],[58,1,"とぼ"],[61,1,"もの"],[63,1,"まず"],[66,1,"もの"],[68,1,"たす"]],"text":"見よ、あなたの妹ソドムの罪はこれである。すなわち彼女と、その娘たちは高ぶり、食物に飽き、安泰に暮していたが、彼らは、乏しい者と貧しい者を助けなかった。"},{"ref":"Ezek.16.50","start":26016050,"end":26016050,"break":"none","ruby":[[0,1,"かれ"],[3,1,"たか"],[11,1,"まえ"],[13,1,"にく"],[17,1,"こと"],[34,1,"み"],[36,1,"とき"],[38,1,"かれ"],[41,1,"のぞ"]],"text":"彼らは高ぶり、わたしの前に憎むべき事をおこなったので、わたしはそれを見た時、彼らを除いた。"},{"ref":"Ezek.16.51","start":26016051,"end":26016051,"break":"none","ruby":[[9,2,"はんぶん"],[12,1,"つみ"],[14,1,"おか"],[25,1,"かれ"],[30,1,"おお"],[32,1,"にく"],[36,1,"こと"],[57,1,"にく"],[61,1,"こと"],[71,2,"しまい"],[74,1,"ぎ"],[76,1,"み"]],"text":"サマリヤはあなたの半分も罪を犯さなかった。あなたは彼らよりも多く憎むべき事をおこない、あなたのおこなったもろもろの憎むべき事によって、あなたの姉妹を義と見せかけた。"},{"ref":"Ezek.16.52","start":26016052,"end":26016052,"break":"none","ruby":[[6,2,"しまい"],[9,2,"ゆうり"],[29,2,"じぶん"],[38,1,"お"],[56,1,"かれ"],[65,1,"にく"],[74,1,"つみ"],[80,1,"かれ"],[89,1,"ぎ"],[107,1,"はじ"],[109,1,"う"],[118,1,"お"],[138,2,"しまい"],[141,1,"ぎ"],[143,1,"み"]],"text":"あなたはその姉妹を有利にさばいたことによって、あなたもまた自分のはずかしめを負わなければならない。それはあなたが彼らよりも、さらに憎むべきことをした罪によって、彼らはあなたよりも義とされるからである。それであなたも恥を受け、はずかしめを負わなければならない。それはあなたがその姉妹を義と見せかけたからである。"},{"ref":"Ezek.16.53","start":26016053,"end":26016053,"break":"paragraph","ruby":[[4,1,"かれ"],[7,2,"こうふく"],[13,1,"かえ"],[26,1,"むすめ"],[30,2,"こうふく"],[40,1,"むすめ"],[44,2,"こうふく"],[49,1,"かれ"],[52,1,"なか"],[60,2,"こうふく"],[66,1,"かえ"]],"text":"わたしは彼らの幸福をもとに返す。すなわちソドムとその娘たちの幸福、サマリヤとその娘たちの幸福、また彼らの中にいるあなたの幸福をもとに返す。"},{"ref":"Ezek.16.54","start":26016054,"end":26016054,"break":"none","ruby":[[7,2,"じぶん"],[16,1,"お"],[35,1,"こと"],[37,1,"は"],[56,1,"かれ"],[59,1,"なぐさ"]],"text":"これはあなたに自分のはずかしめを負わせるため、またすべてあなたのなした事を恥じさせるためである。こうしてあなたは彼らの慰めとなる。"},{"ref":"Ezek.16.55","start":26016055,"end":26016055,"break":"none","ruby":[[4,2,"しまい"],[13,1,"むすめ"],[24,1,"ところ"],[26,1,"かえ"],[37,1,"むすめ"],[48,1,"ところ"],[50,1,"かえ"],[62,1,"むすめ"],[73,1,"ところ"],[75,1,"かえ"]],"text":"あなたの姉妹ソドムと、その娘たちとは、そのもとの所に帰り、サマリヤと、その娘たちとは、そのもとの所に帰り、あなたと、あなたの娘たちとは、そのもとの所に帰る。"},{"ref":"Ezek.16.56","start":26016056,"end":26016056,"break":"none","ruby":[[4,1,"たか"],[8,1,"ひ"],[15,2,"しまい"],[26,1,"くち"]],"text":"あなたの高ぶりの日に、あなたの姉妹ソドムは、あなたの口に、ことわざとなったではなかったか。"},{"ref":"Ezek.16.57","start":26016057,"end":26016057,"break":"none","ruby":[[8,1,"あく"],[16,1,"とき"],[33,1,"いま"],[39,2,"かのじょ"],[42,2,"どうよう"],[50,1,"むすめ"],[60,2,"しゅうい"],[63,1,"もの"],[68,2,"しほう"],[85,1,"むすめ"]],"text":"すなわちあなたの悪があらわされた時まで、そうではなかったか。しかし今はあなたも彼女と同様に、エドムの娘たちと、すべてその周囲の者、および四方からあなたをあざけるペリシテの娘たちのそしりとなった。"},{"ref":"Ezek.16.58","start":26016058,"end":26016058,"break":"none","ruby":[[12,2,"こうい"],[20,1,"にく"],[24,1,"こと"],[31,1,"み"],[33,1,"お"],[39,1,"しゅ"],[41,1,"い"]],"text":"あなたはあなたのみだらな行為と、あなたの憎むべき事のとがとを、身に負っていると主は言われる。"},{"ref":"Ezek.16.59","start":26016059,"end":26016059,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[12,1,"ちか"],[15,1,"かろ"],[19,2,"けいやく"],[22,1,"やぶ"]],"text":"主なる神はこう言われる、誓いを軽んじ、契約を破ったあなたには、あなたがしたように、わたしもあなたにする。"},{"ref":"Ezek.16.60","start":26016060,"end":26016060,"break":"none","ruby":[[11,1,"わか"],[13,1,"ひ"],[20,1,"むす"],[23,2,"けいやく"],[26,1,"おぼ"],[29,2,"えいえん"],[32,2,"けいやく"],[39,1,"た"]],"text":"しかしわたしはあなたの若き日に、あなたと結んだ契約を覚え、永遠の契約をあなたと立てる。"},{"ref":"Ezek.16.61","start":26016061,"end":26016061,"break":"none","ruby":[[8,1,"あね"],[12,1,"いもうと"],[14,1,"う"],[24,2,"けいやく"],[32,1,"むすめ"],[36,1,"かれ"],[43,1,"あた"],[46,1,"とき"],[52,2,"じぶん"],[60,1,"おも"],[62,1,"だ"],[65,1,"は"]],"text":"わたしがあなたの姉および妹を受け、またあなたとの契約によらずに、娘として彼らをあなたに与える時、あなたは自分のおこないを思い出して恥じる。"},{"ref":"Ezek.16.62","start":26016062,"end":26016062,"break":"none","ruby":[[8,2,"けいやく"],[11,1,"た"],[22,1,"しゅ"],[29,1,"し"]],"text":"わたしはあなたと契約を立て、あなたはわたしが主であることを知るようになる。"},{"ref":"Ezek.16.63","start":26016063,"end":26016063,"break":"none","ruby":[[11,1,"おこな"],[31,1,"とき"],[40,1,"おも"],[42,1,"だ"],[45,1,"は"],[50,1,"はじ"],[55,1,"かさ"],[58,1,"くち"],[60,1,"ひら"],[69,1,"しゅ"],[72,1,"かみ"],[74,1,"い"]],"text":"こうしてすべてあなたの行ったことにつき、わたしがあなたをゆるす時、あなたはそれを思い出して恥じ、その恥のゆえに重ねて口を開くことがないと、主なる神は言われる」。"}]