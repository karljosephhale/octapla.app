[{"ref":"2Chr.27.1","start":14027001,"end":14027001,"break":"paragraph","ruby":[[4,1,"おう"],[9,1,"とき"],[13,1,"さい"],[18,1,"ねん"],[20,1,"あいだ"],[27,1,"よ"],[29,1,"おさ"],[35,1,"はは"],[41,1,"むすめ"],[43,1,"な"]],"text":"ヨタムは王となった時二十五歳で、十六年の間エルサレムで世を治めた。その母はザドクの娘で名をエルシャといった。"},{"ref":"2Chr.27.2","start":14027002,"end":14027002,"break":"none","ruby":[[6,1,"ちち"],[16,1,"しゅ"],[18,1,"よ"],[21,1,"み"],[34,1,"しゅ"],[36,1,"みや"],[48,1,"たみ"],[52,1,"あく"],[54,1,"おこな"]],"text":"ヨタムはその父ウジヤがしたように主の良しと見られることをした。しかし主の宮には、はいらなかった。民はなお悪を行った。"},{"ref":"2Chr.27.3","start":14027003,"end":14027003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"みや"],[6,1,"うえ"],[8,1,"もん"],[10,1,"た"],[17,1,"いし"],[21,1,"おお"],[23,1,"きず"],[25,1,"ま"]],"text":"彼は主の宮の上の門を建て、オペルの石がきを多く築き増し、"},{"ref":"2Chr.27.4","start":14027004,"end":14027004,"break":"none","ruby":[[5,2,"さんち"],[8,2,"すうこ"],[11,1,"まち"],[13,1,"た"],[16,1,"はやし"],[18,1,"あいだ"],[20,1,"しろ"],[26,1,"きず"]],"text":"またユダの山地に数個の町を建て、林の間に城とやぐらを築いた。"},{"ref":"2Chr.27.5","start":14027005,"end":14027005,"break":"none","ruby":[[0,1,"かれ"],[9,1,"おう"],[11,1,"たたか"],[17,1,"か"],[23,1,"ねん"],[29,2,"ひとびと"],[32,1,"ぎん"],[39,2,"こむぎ"],[46,2,"おおむぎ"],[53,1,"かれ"],[55,1,"おく"],[64,2,"ひとびと"],[67,1,"だい"],[69,1,"ねん"],[72,1,"だい"],[74,1,"ねん"],[77,1,"おな"],[82,1,"かれ"],[84,1,"おさ"]],"text":"彼はアンモンびとの王と戦ってこれに勝った。その年アンモンの人々は銀百タラント、小麦一万コル、大麦一万コルを彼に贈った。アンモンの人々は第二年にも第三年にも同じように彼に納めた。"},{"ref":"2Chr.27.6","start":14027006,"end":14027006,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"まえ"],[14,1,"おこな"],[17,1,"かた"],[23,1,"ちから"],[26,1,"もの"]],"text":"ヨタムはその神、主の前にその行いを堅くしたので力ある者となった。"},{"ref":"2Chr.27.7","start":14027007,"end":14027007,"break":"none","ruby":[[6,1,"た"],[8,2,"こうい"],[17,1,"たたか"],[24,1,"おこな"],[39,1,"れつ"],[40,1,"おう"],[42,1,"しょ"]],"text":"ヨタムのその他の行為、そのすべての戦いおよびその行いなどは、イスラエルとユダの列王の書にしるされている。"},{"ref":"2Chr.27.8","start":14027008,"end":14027008,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おう"],[7,1,"とき"],[12,1,"さい"],[17,1,"ねん"],[19,1,"あいだ"],[26,1,"よ"],[28,1,"おさ"]],"text":"彼は王となった時、二十五歳で、十六年の間エルサレムで世を治めた。"},{"ref":"2Chr.27.9","start":14027009,"end":14027009,"break":"none","ruby":[[6,2,"せんぞ"],[9,1,"とも"],[11,1,"ねむ"],[21,1,"まち"],[23,1,"ほうむ"],[29,1,"こ"],[34,1,"かれ"],[36,1,"かわ"],[39,1,"おう"]],"text":"ヨタムはその先祖と共に眠ったので、ダビデの町に葬られ、その子アハズが彼に代って王となった。"}]