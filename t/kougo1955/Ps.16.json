[{"ref":"Ps.16.1","start":19016001,"end":19016001,"break":"paragraph","title":"ダビデのミクタムの歌","breaks":[[15,"line"]],"ruby":[[0,1,"かみ"],[8,1,"まも"],[23,1,"よ"],[25,1,"たの"]],"titleRuby":[[9,1,"うた"]],"text":"神よ、わたしをお守りください。わたしはあなたに寄り頼みます。"},{"ref":"Ps.16.2","start":19016002,"end":19016002,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"い"],[18,1,"しゅ"],[31,1,"さいわい"]],"text":"わたしは主に言う、「あなたはわたしの主、あなたのほかにわたしの幸はない」と。"},{"ref":"Ps.16.3","start":19016003,"end":19016003,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"ち"],[4,2,"せいと"],[15,1,"よろこ"],[21,2,"ひとびと"]],"text":"地にある聖徒は、すべてわたしの喜ぶすぐれた人々である。"},{"ref":"Ps.16.4","start":19016004,"end":19016004,"break":"line","breaks":[[21,"line"],[41,"line"]],"ruby":[[8,1,"かみ"],[10,1,"えら"],[12,1,"もの"],[14,1,"かな"],[18,1,"ま"],[25,1,"かれ"],[32,1,"ち"],[34,2,"かんさい"],[37,1,"そそ"],[43,1,"な"],[45,1,"くち"]],"text":"おおよそ、ほかの神を選ぶ者は悲しみを増す。わたしは彼らのささげる血の灌祭を注がず、その名を口にとなえることをしない。"},{"ref":"Ps.16.5","start":19016005,"end":19016005,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"し"],[7,1,"ぎょう"],[15,1,"さかずき"],[32,1,"わ"],[34,1,"まえ"],[36,1,"まも"]],"text":"主はわたしの嗣業、またわたしの杯にうくべきもの。あなたはわたしの分け前を守られる。"},{"ref":"Ps.16.6","start":19016006,"end":19016006,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"はか"],[13,1,"この"],[17,1,"ところ"],[19,1,"お"],[31,1,"よ"],[33,1,"し"],[34,1,"ぎょう"],[36,1,"え"]],"text":"測りなわは、わたしのために好ましい所に落ちた。まことにわたしは良い嗣業を得た。"},{"ref":"Ps.16.7","start":19016007,"end":19016007,"break":"line","breaks":[[22,"line"]],"ruby":[[14,1,"しゅ"],[22,1,"よる"],[31,1,"こころ"],[37,1,"おし"]],"text":"わたしにさとしをさずけられる主をほめまつる。夜はまた、わたしの心がわたしを教える。"},{"ref":"Ps.16.8","start":19016008,"end":19016008,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[4,1,"つね"],[6,1,"しゅ"],[12,1,"まえ"],[14,1,"お"],[17,1,"しゅ"],[23,1,"みぎ"],[35,1,"うご"]],"text":"わたしは常に主をわたしの前に置く。主がわたしの右にいますゆえ、わたしは動かされることはない。"},{"ref":"Ps.16.9","start":19016009,"end":19016009,"break":"line","breaks":[[25,"line"]],"ruby":[[10,1,"こころ"],[12,1,"たの"],[20,1,"たましい"],[22,1,"よろこ"],[29,1,"み"],[33,1,"やす"]],"text":"このゆえに、わたしの心は楽しみ、わたしの魂は喜ぶ。わたしの身もまた安らかである。"},{"ref":"Ps.16.10","start":19016010,"end":19016010,"break":"line","breaks":[[18,"line"]],"ruby":[[8,2,"よみ"],[11,1,"す"],[22,2,"せいじゃ"],[25,1,"はか"],[27,1,"み"]],"text":"あなたはわたしを陰府に捨ておかれず、あなたの聖者に墓を見させられないからである。"},{"ref":"Ps.16.11","start":19016011,"end":19016011,"break":"line","breaks":[[19,"line"],[38,"line"]],"ruby":[[8,1,"みち"],[14,1,"しめ"],[23,1,"まえ"],[26,1,"み"],[32,1,"よろこ"],[42,1,"みぎ"],[56,1,"たの"]],"text":"あなたはいのちの道をわたしに示される。あなたの前には満ちあふれる喜びがあり、あなたの右には、とこしえにもろもろの楽しみがある。"}]