[{"ref":"Ezek.9.1","start":26009001,"end":26009001,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"かれ"],[8,1,"みみ"],[10,2,"おおごえ"],[13,1,"よ"],[18,1,"い"],[24,1,"まち"],[26,1,"ばっ"],[29,1,"もの"],[38,1,"ほろ"],[41,2,"ぶき"],[46,1,"て"],[48,1,"も"],[51,1,"ちか"]],"text":"時に彼はわたしの耳に大声に呼ばわって言われた、「町を罰する者たちよ、おのおの滅ぼす武器をその手に持って近よれ」と。"},{"ref":"Ezek.9.2","start":26009002,"end":26009002,"break":"none","ruby":[[0,1,"み"],[3,1,"きた"],[5,1,"む"],[8,1,"うえ"],[10,1,"もん"],[12,1,"みち"],[15,1,"で"],[17,1,"く"],[20,1,"にん"],[22,1,"もの"],[34,1,"て"],[36,1,"ほろ"],[39,2,"ぶき"],[42,1,"も"],[45,1,"かれ"],[48,1,"なか"],[54,2,"あま"],[56,1,"ぬの"],[58,1,"き"],[62,1,"こし"],[64,1,"もの"],[66,1,"か"],[68,1,"すみ"],[78,1,"かれ"],[85,1,"き"],[88,2,"せいどう"],[91,2,"さいだん"],[99,1,"た"]],"text":"見よ、北に向かう上の門の道から出て来る六人の者があった。おのおのその手に滅ぼす武器を持ち、彼らの中のひとりは亜麻布を着、その腰に物を書く墨つぼをつけていた。彼らははいって来て、青銅の祭壇のかたわらに立った。"},{"ref":"Ezek.9.3","start":26009003,"end":26009003,"break":"paragraph","ruby":[[9,1,"かみ"],[11,2,"えいこう"],[16,1,"ざ"],[27,1,"た"],[34,1,"みや"],[36,2,"しきい"],[41,1,"いた"],[48,1,"しゅ"],[51,2,"あま"],[53,1,"ぬの"],[55,1,"き"],[60,1,"こし"],[62,1,"もの"],[64,1,"か"],[66,1,"すみ"],[75,1,"もの"],[77,1,"よ"]],"text":"ここにイスラエルの神の栄光がその座しているケルビムから立ちあがって、宮の敷居にまで至った。そして主は、亜麻布を着て、その腰に物を書く墨つぼをつけている者を呼び、"},{"ref":"Ezek.9.4","start":26009004,"end":26009004,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[8,1,"まち"],[10,1,"なか"],[18,1,"なか"],[26,1,"なか"],[28,1,"おこな"],[38,1,"にく"],[45,1,"たい"],[48,1,"なげ"],[50,1,"かな"],[53,2,"ひとびと"],[56,1,"ひたい"]],"text":"彼に言われた、「町の中、エルサレムの中をめぐり、その中で行われているすべての憎むべきことに対して嘆き悲しむ人々の額にしるしをつけよ」。"},{"ref":"Ezek.9.5","start":26009005,"end":26009005,"break":"none","ruby":[[6,1,"き"],[11,1,"ところ"],[13,1,"た"],[15,1,"もの"],[17,1,"い"],[23,1,"かれ"],[28,1,"したが"],[30,1,"まち"],[37,1,"う"],[44,1,"め"],[46,1,"お"],[49,1,"み"]],"text":"またわたしの聞いている所で他の者に言われた、「彼のあとに従い町をめぐって、撃て。あなたの目は惜しみ見るな。またあわれむな。"},{"ref":"Ezek.9.6","start":26009006,"end":26009006,"break":"none","ruby":[[0,4,"ろうにゃくなんにょ"],[10,1,"ころ"],[16,1,"み"],[24,1,"もの"],[27,1,"ふ"],[38,2,"せいじょ"],[42,1,"はじ"],[51,1,"かれ"],[54,1,"みや"],[56,1,"まえ"],[60,2,"ろうじん"],[64,1,"はじ"]],"text":"老若男女をことごとく殺せ。しかし身にしるしのある者には触れるな。まずわたしの聖所から始めよ」。そこで、彼らは宮の前にいた老人から始めた。"},{"ref":"Ezek.9.7","start":26009007,"end":26009007,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,1,"かれ"],[9,1,"い"],[15,1,"みや"],[17,1,"けが"],[20,2,"しにん"],[23,1,"にわ"],[25,1,"み"],[29,1,"い"],[36,1,"かれ"],[39,1,"で"],[41,1,"い"],[45,1,"まち"],[47,1,"なか"],[49,1,"う"]],"text":"この時、主は彼らに言われた、「宮を汚し、死人で庭を満たせ。行け」。そこで彼らは出て行って、町の中で撃った。"},{"ref":"Ezek.9.8","start":26009008,"end":26009008,"break":"none","ruby":[[2,1,"かれ"],[5,2,"ひとびと"],[8,1,"う"],[10,1,"ころ"],[15,1,"とき"],[26,1,"のこ"],[35,1,"ふ"],[39,1,"さけ"],[42,1,"い"],[49,1,"しゅ"],[52,1,"かみ"],[65,1,"うえ"],[67,1,"いか"],[70,1,"そそ"],[83,1,"のこ"],[86,1,"もの"],[94,1,"ほろ"]],"text":"さて彼らが人々を打ち殺していた時、わたしひとりだけが残されたので、ひれ伏して、叫んで言った、「ああ主なる神よ、あなたがエルサレムの上に怒りを注がれるとき、イスラエルの残りの者を、ことごとく滅ぼされるのですか」。"},{"ref":"Ezek.9.9","start":26009009,"end":26009009,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[21,1,"いえ"],[23,1,"つみ"],[25,2,"ひじょう"],[28,1,"おお"],[32,1,"くに"],[34,1,"ち"],[36,1,"み"],[39,1,"まち"],[41,2,"ふぎ"],[44,1,"み"],[50,1,"かれ"],[53,1,"い"],[57,1,"しゅ"],[61,1,"ち"],[63,1,"す"],[69,1,"しゅ"],[71,1,"かえり"]],"text":"主はわたしに言われた、「イスラエルとユダの家の罪は非常に大きい。国は血で満ち、町は不義で満ちている。彼らは言う、『主はこの地を捨てられた。主は顧みられない』。"},{"ref":"Ezek.9.10","start":26009010,"end":26009010,"break":"none","ruby":[[9,1,"め"],[11,1,"かれ"],[14,1,"お"],[17,1,"み"],[29,1,"かれ"],[32,1,"おこな"],[39,1,"かれ"],[46,1,"むく"]],"text":"それゆえ、わたしの目は彼らを惜しみ見ず、またあわれまない。彼らの行うところを、彼らのこうべに報いる」。"},{"ref":"Ezek.9.11","start":26009011,"end":26009011,"break":"paragraph","ruby":[[0,1,"とき"],[5,2,"あま"],[7,1,"ぬの"],[9,1,"き"],[11,1,"もの"],[13,1,"か"],[15,1,"すみ"],[19,1,"こし"],[26,1,"ひと"],[28,2,"ほうこく"],[32,1,"い"],[46,1,"めい"],[55,1,"おこな"]],"text":"時に、かの亜麻布を着、物を書く墨つぼを腰につけていた人が報告して言った、「わたしはあなたがお命じになったように行いました」。"}]