[{"ref":"1Kgs.12.1","start":11012001,"end":11012001,"break":"paragraph","ruby":[[10,1,"い"],[26,1,"かれ"],[28,1,"おう"],[38,1,"い"]],"text":"レハベアムはシケムへ行った。すべてのイスラエルびとが彼を王にしようとシケムへ行ったからである。"},{"ref":"1Kgs.12.2","start":11012002,"end":11012002,"break":"none","ruby":[[4,1,"こ"],[16,1,"さ"],[40,1,"き"],[49,1,"かえ"]],"text":"ネバテの子ヤラベアムはソロモンを避けてエジプトにのがれ、なおそこにいたが、これを聞いてエジプトから帰ったので、"},{"ref":"1Kgs.12.3","start":11012003,"end":11012003,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"ひと"],[10,1,"かれ"],[12,1,"まね"],[31,2,"かいしゅう"],[34,1,"みな"],[41,1,"ところ"],[45,1,"い"]],"text":"人々は人をつかわして彼を招いた。そしてヤラベアムとイスラエルの会衆は皆レハベアムの所にきて言った、"},{"ref":"1Kgs.12.4","start":11012004,"end":11012004,"break":"none","ruby":[[1,2,"ちちうえ"],[13,1,"おも"],[22,1,"いま"],[23,2,"ちちうえ"],[30,2,"しえき"],[34,2,"ちちうえ"],[42,1,"お"],[48,1,"おも"],[55,1,"かる"],[78,1,"つか"]],"text":"「父上はわれわれのくびきを重くされましたが、今父上のきびしい使役と、父上がわれわれに負わせられた重いくびきとを軽くしてください。そうすればわれわれはあなたに仕えます」。"},{"ref":"1Kgs.12.5","start":11012005,"end":11012005,"break":"none","ruby":[[6,1,"かれ"],[9,1,"い"],[14,1,"さ"],[19,1,"か"],[20,1,"す"],[45,1,"たみ"],[47,1,"た"],[49,1,"さ"]],"text":"レハベアムは彼らに言った、「去って、三日過ぎてから、またわたしのところにきなさい」。それで民は立ち去った。"},{"ref":"1Kgs.12.6","start":11012006,"end":11012006,"break":"paragraph","ruby":[[5,1,"おう"],[7,1,"ちち"],[13,2,"ぞんめい"],[15,1,"なか"],[21,1,"つか"],[24,2,"ろうじん"],[29,2,"そうだん"],[33,1,"い"],[40,1,"たみ"],[44,2,"へんとう"],[52,1,"おも"]],"text":"レハベアム王は父ソロモンの存命中ソロモンに仕えた老人たちに相談して言った、「この民にどう返答すればよいと思いますか」。"},{"ref":"1Kgs.12.7","start":11012007,"end":11012007,"break":"none","ruby":[[0,1,"かれ"],[9,1,"い"],[28,1,"たみ"],[37,1,"かれ"],[40,1,"つか"],[43,1,"かれ"],[46,1,"こた"],[57,1,"かた"],[65,1,"かれ"],[68,2,"えいきゅう"]],"text":"彼らはレハベアムに言った、「もし、あなたが、きょう、この民のしもべとなって彼らに仕え、彼らに答えるとき、ねんごろに語られるならば、彼らは永久にあなたのしもべとなるでしょう」。"},{"ref":"1Kgs.12.8","start":11012008,"end":11012008,"break":"none","ruby":[[3,1,"かれ"],[5,2,"ろうじん"],[10,1,"あた"],[13,1,"すす"],[16,1,"す"],[20,2,"じぶん"],[23,2,"いっしょ"],[26,1,"おお"],[32,2,"じぶん"],[35,1,"つか"],[40,2,"わかもの"],[45,2,"そうだん"]],"text":"しかし彼は老人たちが与えた勧めを捨てて、自分と一緒に大きくなって自分に仕えている若者たちに相談して、"},{"ref":"1Kgs.12.9","start":11012009,"end":11012009,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[10,1,"たみ"],[25,1,"ちち"],[32,1,"お"],[40,1,"かる"],[63,2,"へんとう"],[71,1,"おも"]],"text":"彼らに言った、「この民がわたしにむかって『あなたの父がわれわれに負わせたくびきを軽くしてください』というのに、われわれはなんと返答すればよいと思いますか」。"},{"ref":"1Kgs.12.10","start":11012010,"end":11012010,"break":"none","ruby":[[0,1,"かれ"],[2,2,"いっしょ"],[5,1,"おお"],[11,2,"わかもの"],[16,1,"かれ"],[18,1,"い"],[32,2,"ちちうえ"],[44,1,"おも"],[69,1,"かる"],[79,1,"い"],[83,1,"たみ"],[88,1,"い"],[99,2,"こゆび"],[102,1,"ちち"],[104,1,"こし"],[108,1,"ふと"]],"text":"彼と一緒に大きくなった若者たちは彼に言った、「あなたにむかって『父上はわれわれのくびきを重くされましたが、あなたは、それをわれわれのために軽くしてください』と言うこの民に、こう言いなさい、『わたしの小指は父の腰よりも太い。"},{"ref":"1Kgs.12.11","start":11012011,"end":11012011,"break":"none","ruby":[[0,1,"ちち"],[8,1,"おも"],[14,1,"お"],[38,1,"おも"],[44,1,"ちち"],[55,1,"こ"],[78,1,"こ"]],"text":"父はあなたがたに重いくびきを負わせたが、わたしはさらに、あなたがたのくびきを重くしよう。父はむちであなたがたを懲らしたが、わたしはさそりをもってあなたがたを懲らそう』と」。"},{"ref":"1Kgs.12.12","start":11012012,"end":11012012,"break":"paragraph","ruby":[[8,1,"たみ"],[10,1,"みな"],[12,1,"おう"],[16,1,"か"],[17,1,"め"],[19,1,"ふたた"],[29,1,"く"],[36,1,"い"],[45,1,"か"],[46,1,"め"]],"text":"さてヤラベアムと民は皆、王が「三日目に再びわたしのところに来るように」と言ったとおりに、三日目にレハベアムのところにきた。"},{"ref":"1Kgs.12.13","start":11012013,"end":11012013,"break":"none","ruby":[[0,1,"おう"],[2,2,"あらあら"],[6,1,"たみ"],[8,1,"こた"],[11,2,"ろうじん"],[16,1,"あた"],[19,1,"すす"],[22,1,"す"]],"text":"王は荒々しく民に答え、老人たちが与えた勧めを捨てて、"},{"ref":"1Kgs.12.14","start":11012014,"end":11012014,"break":"none","ruby":[[0,2,"わかもの"],[5,1,"すす"],[8,1,"したが"],[11,1,"かれ"],[14,1,"つ"],[17,1,"い"],[22,1,"ちち"],[34,1,"おも"],[58,1,"おも"],[64,1,"ちち"],[75,1,"こ"],[98,1,"こ"]],"text":"若者たちの勧めに従い、彼らに告げて言った、「父はあなたがたのくびきを重くしたが、わたしはあなたがたのくびきを、さらに重くしよう。父はむちであなたがたを懲らしたが、わたしはさそりをもってあなたがたを懲らそう」。"},{"ref":"1Kgs.12.15","start":11012015,"end":11012015,"break":"none","ruby":[[5,1,"おう"],[7,1,"たみ"],[9,1,"い"],[14,1,"き"],[29,1,"しゅ"],[47,1,"こ"],[54,1,"い"],[58,2,"ことば"],[61,2,"じょうじゅ"],[69,1,"しゅ"],[71,2,"しむ"],[77,1,"こと"]],"text":"このように王は民の言うことを聞きいれなかった。これはかつて主がシロびとアヒヤによって、ネバテの子ヤラベアムに言われた言葉を成就するために、主が仕向けられた事であった。"},{"ref":"1Kgs.12.16","start":11012016,"end":11012016,"break":"paragraph","breaks":[[47,"stanza"],[69,"line"],[85,"line"],[104,"line"]],"ruby":[[6,2,"ひとびと"],[9,1,"みな"],[11,1,"おう"],[13,2,"じぶん"],[18,1,"い"],[23,1,"き"],[31,1,"み"],[36,1,"たみ"],[38,1,"おう"],[40,1,"こた"],[43,1,"い"],[60,1,"なに"],[62,1,"ぶん"],[74,1,"こ"],[79,1,"し"],[80,1,"ぎょう"],[98,2,"てんまく"],[101,1,"かえ"],[109,1,"いま"],[110,2,"じぶん"],[113,1,"いえ"],[115,1,"こと"],[117,1,"み"],[132,2,"てんまく"],[135,1,"さ"]],"text":"イスラエルの人々は皆、王が自分たちの言うことを聞きいれないのを見たので、民は王に答えて言った、「われわれはダビデのうちに何の分があろうか、エッサイの子のうちに嗣業がない。イスラエルよ、あなたがたの天幕へ帰れ。ダビデよ、今自分の家の事を見よ」。そしてイスラエルはその天幕へ去っていった。"},{"ref":"1Kgs.12.17","start":11012017,"end":11012017,"break":"none","ruby":[[12,2,"まちまち"],[15,1,"す"],[26,2,"ひとびと"],[29,1,"おさ"]],"text":"しかしレハベアムはユダの町々に住んでいるイスラエルの人々を治めた。"},{"ref":"1Kgs.12.18","start":11012018,"end":11012018,"break":"none","ruby":[[5,1,"おう"],[7,2,"ちょうぼ"],[10,2,"かんとく"],[34,1,"みな"],[36,1,"かれ"],[38,1,"いし"],[40,1,"う"],[42,1,"ころ"],[53,1,"おう"],[55,1,"いそ"],[58,1,"くるま"],[60,1,"の"],[69,1,"に"]],"text":"レハベアム王は徴募の監督であったアドラムをつかわしたが、イスラエルが皆、彼を石で撃ち殺したので、レハベアム王は急いで車に乗り、エルサレムへ逃げた。"},{"ref":"1Kgs.12.19","start":11012019,"end":11012019,"break":"none","ruby":[[14,1,"いえ"],[20,2,"こんにち"],[23,1,"いた"]],"text":"こうしてイスラエルはダビデの家にそむいて今日に至った。"},{"ref":"1Kgs.12.20","start":11012020,"end":11012020,"break":"none","ruby":[[6,1,"みな"],[13,1,"かえ"],[20,1,"き"],[23,1,"ひと"],[30,1,"かれ"],[32,2,"しゅうかい"],[35,1,"まね"],[44,2,"ぜんか"],[47,1,"うえ"],[49,1,"おう"],[57,2,"ぶぞく"],[67,1,"いえ"],[69,1,"したが"],[71,1,"もの"]],"text":"イスラエルは皆ヤラベアムの帰ってきたのを聞き、人をつかわして彼を集会に招き、イスラエルの全家の上に王とした。ユダの部族のほかはダビデの家に従う者がなかった。"},{"ref":"1Kgs.12.21","start":11012021,"end":11012021,"break":"paragraph","ruby":[[5,1,"こ"],[18,1,"き"],[24,2,"ぜんか"],[33,2,"ぶぞく"],[36,1,"もの"],[44,1,"ぬ"],[47,2,"ぐんじん"],[53,1,"あつ"],[56,1,"くに"],[58,1,"と"],[73,1,"いえ"],[75,1,"たたか"]],"text":"ソロモンの子レハベアムはエルサレムに来て、ユダの全家とベニヤミンの部族の者、すなわちえり抜きの軍人十八万を集め、国を取りもどすために、イスラエルの家と戦おうとしたが、"},{"ref":"1Kgs.12.22","start":11012022,"end":11012022,"break":"none","ruby":[[0,1,"かみ"],[2,2,"ことば"],[5,1,"かみ"],[7,1,"ひと"],[12,1,"のぞ"]],"text":"神の言葉が神の人シマヤに臨んだ、"},{"ref":"1Kgs.12.23","start":11012023,"end":11012023,"break":"none","ruby":[[6,1,"こ"],[13,1,"おう"],[32,2,"ぜんか"],[44,1,"たみ"],[46,1,"い"]],"text":"「ソロモンの子であるユダの王レハベアム、およびユダとベニヤミンの全家、ならびにそのほかの民に言いなさい、"},{"ref":"1Kgs.12.24","start":11012024,"end":11012024,"break":"none","ruby":[[1,1,"しゅ"],[5,1,"おお"],[17,1,"のぼ"],[35,2,"きょうだい"],[46,2,"ひとびと"],[49,1,"たたか"],[62,1,"いえ"],[64,1,"かえ"],[72,1,"こと"],[79,1,"で"],[91,1,"かれ"],[94,1,"しゅ"],[96,2,"ことば"],[102,1,"しゅ"],[104,2,"ことば"],[107,1,"したが"],[110,1,"かえ"]],"text":"『主はこう仰せられる。あなたがたは上っていってはならない。あなたがたの兄弟であるイスラエルの人々と戦ってはならない。おのおの家に帰りなさい。この事はわたしから出たのである』」。それで彼らは主の言葉をきき、主の言葉に従って帰っていった。"},{"ref":"1Kgs.12.25","start":11012025,"end":11012025,"break":"paragraph","ruby":[[12,2,"さんち"],[19,1,"た"],[26,1,"す"],[30,1,"かれ"],[38,1,"で"],[45,1,"た"]],"text":"ヤラベアムはエフライムの山地にシケムを建てて、そこに住んだ。彼はまたそこから出てペヌエルを建てた。"},{"ref":"1Kgs.12.26","start":11012026,"end":11012026,"break":"none","ruby":[[11,1,"こころ"],[16,1,"い"],[21,1,"くに"],[23,1,"いま"],[28,1,"いえ"]],"text":"しかしヤラベアムはその心のうちに言った、「国は今ダビデの家にもどるであろう。"},{"ref":"1Kgs.12.27","start":11012027,"end":11012027,"break":"none","ruby":[[4,1,"たみ"],[14,1,"しゅ"],[16,1,"みや"],[18,2,"ぎせい"],[28,1,"のぼ"],[36,1,"たみ"],[38,1,"こころ"],[43,1,"おう"],[47,1,"かれ"],[50,2,"しゅくん"],[58,1,"かえ"],[65,1,"ころ"],[72,1,"おう"],[79,1,"かえ"]],"text":"もしこの民がエルサレムにある主の宮に犠牲をささげるために上るならば、この民の心はユダの王である彼らの主君レハベアムに帰り、わたしを殺して、ユダの王レハベアムに帰るであろう」。"},{"ref":"1Kgs.12.28","start":11012028,"end":11012028,"break":"none","ruby":[[3,1,"おう"],[5,2,"そうだん"],[13,1,"きん"],[15,1,"こ"],[16,1,"うし"],[18,1,"つく"],[21,1,"たみ"],[23,1,"い"],[43,1,"のぼ"],[72,1,"くに"],[75,1,"みちび"],[77,1,"のぼ"],[86,1,"かみ"],[88,1,"み"]],"text":"そこで王は相談して、二つの金の子牛を造り、民に言った、「あなたがたはもはやエルサレムに上るには、およばない。イスラエルよ、あなたがたをエジプトの国から導き上ったあなたがたの神を見よ」。"},{"ref":"1Kgs.12.29","start":11012029,"end":11012029,"break":"none","ruby":[[3,1,"かれ"],[21,1,"お"]],"text":"そして彼は一つをベテルにすえ、一つをダンに置いた。"},{"ref":"1Kgs.12.30","start":11012030,"end":11012030,"break":"none","ruby":[[2,1,"こと"],[4,1,"つみ"],[10,1,"たみ"],[16,1,"い"],[22,2,"れいはい"],[29,1,"い"],[35,2,"れいはい"]],"text":"この事は罪となった。民がベテルへ行って一つを礼拝し、ダンへ行って一つを礼拝したからである。"},{"ref":"1Kgs.12.31","start":11012031,"end":11012031,"break":"none","ruby":[[0,1,"かれ"],[4,1,"たか"],[6,1,"ところ"],[8,1,"いえ"],[10,1,"つく"],[16,2,"しそん"],[21,2,"いっぱん"],[24,1,"たみ"],[26,2,"さいし"],[29,2,"にんめい"]],"text":"彼はまた高き所に家を造り、レビの子孫でない一般の民を祭司に任命した。"},{"ref":"1Kgs.12.32","start":11012032,"end":11012032,"break":"none","ruby":[[11,1,"おこな"],[13,1,"まつり"],[15,1,"おな"],[17,1,"まつり"],[20,1,"がつ"],[24,1,"にち"],[26,1,"さだ"],[32,2,"さいだん"],[35,1,"のぼ"],[39,1,"かれ"],[50,1,"おこな"],[53,1,"かれ"],[55,1,"つく"],[58,1,"こ"],[59,1,"うし"],[61,2,"ぎせい"],[71,2,"じぶん"],[74,1,"つく"],[77,1,"たか"],[79,1,"ところ"],[81,2,"さいし"],[88,1,"た"]],"text":"またヤラベアムはユダで行う祭と同じ祭を八月の十五日に定め、そして祭壇に上った。彼はベテルでそのように行い、彼が造った子牛に犠牲をささげた。また自分の造った高き所の祭司をベテルに立てた。"},{"ref":"1Kgs.12.33","start":11012033,"end":11012033,"break":"none","ruby":[[4,1,"かれ"],[10,1,"つく"],[13,2,"さいだん"],[17,1,"がつ"],[21,1,"にち"],[23,1,"のぼ"],[30,1,"かれ"],[32,2,"じぶん"],[35,2,"かって"],[38,1,"かんが"],[43,1,"つき"],[52,1,"かれ"],[60,2,"ひとびと"],[66,1,"まつり"],[68,1,"さだ"],[71,2,"さいだん"],[74,1,"のぼ"],[77,1,"こう"]],"text":"こうして彼はベテルに造った祭壇に八月の十五日に上った。これは彼が自分で勝手に考えついた月であった。そして彼はイスラエルの人々のために祭を定め、祭壇に上って香をたいた。"}]