[{"ref":"Jer.18.1","start":24018001,"end":24018001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"のぞ"],[11,2,"ことば"]],"text":"主からエレミヤに臨んだ言葉。"},{"ref":"Jer.18.2","start":24018002,"end":24018002,"break":"none","ruby":[[1,1,"た"],[5,2,"とうき"],[7,1,"し"],[9,1,"いえ"],[11,1,"くだ"],[14,1,"い"],[22,1,"ところ"],[36,2,"ことば"],[39,1,"き"]],"text":"「立って、陶器師の家に下って行きなさい。その所でわたしはあなたにわたしの言葉を聞かせよう」。"},{"ref":"Jer.18.3","start":24018003,"end":24018003,"break":"none","ruby":[[4,2,"とうき"],[6,1,"し"],[8,1,"いえ"],[10,1,"くだ"],[13,1,"い"],[17,1,"み"],[20,1,"かれ"],[27,2,"しごと"]],"text":"わたしは陶器師の家へ下って行った。見ると彼は、ろくろで仕事をしていたが、"},{"ref":"Jer.18.4","start":24018004,"end":24018004,"break":"none","ruby":[[0,2,"ねんど"],[3,1,"つく"],[8,1,"うつわ"],[13,1,"ひと"],[15,1,"て"],[17,1,"なか"],[19,2,"しそん"],[26,1,"かれ"],[28,2,"じぶん"],[31,1,"い"],[46,1,"うつわ"],[48,1,"つく"]],"text":"粘土で造っていた器が、その人の手の中で仕損じたので、彼は自分の意のままに、それをもってほかの器を造った。"},{"ref":"Jer.18.5","start":24018005,"end":24018005,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,2,"ことば"],[13,1,"のぞ"]],"text":"その時、主の言葉がわたしに臨んだ、"},{"ref":"Jer.18.6","start":24018006,"end":24018006,"break":"none","ruby":[[1,1,"しゅ"],[3,1,"おお"],[15,1,"いえ"],[20,2,"とうき"],[22,1,"し"],[56,1,"いえ"],[59,2,"とうき"],[61,1,"し"],[63,1,"て"],[65,2,"ねんど"],[84,1,"て"]],"text":"「主は仰せられる、イスラエルの家よ、この陶器師がしたように、わたしもあなたがたにできないのだろうか。イスラエルの家よ、陶器師の手に粘土があるように、あなたがたはわたしの手のうちにある。"},{"ref":"Jer.18.7","start":24018007,"end":24018007,"break":"none","ruby":[[2,1,"とき"],[10,1,"たみ"],[14,1,"くに"],[16,1,"ぬ"],[19,1,"やぶ"],[22,1,"ほろ"]],"text":"ある時には、わたしが民または国を抜く、破る、滅ぼすということがあるが、"},{"ref":"Jer.18.8","start":24018008,"end":24018008,"break":"none","ruby":[[6,1,"い"],[9,1,"くに"],[13,1,"あく"],[15,1,"はな"],[29,1,"わざわい"],[31,1,"くだ"],[40,1,"おも"]],"text":"もしわたしの言った国がその悪を離れるならば、わたしはこれに災を下そうとしたことを思いかえす。"},{"ref":"Jer.18.9","start":24018009,"end":24018009,"break":"none","ruby":[[4,1,"とき"],[12,1,"たみ"],[16,1,"くに"],[18,1,"た"],[22,1,"う"]],"text":"またある時には、わたしが民または国を建てる、植えるということがあるが、"},{"ref":"Jer.18.10","start":24018010,"end":24018010,"break":"none","ruby":[[4,1,"くに"],[10,1,"め"],[12,1,"あく"],[14,1,"み"],[20,1,"おこな"],[27,1,"こえ"],[29,1,"き"],[31,1,"したが"],[45,1,"さいわい"],[47,1,"あた"],[57,1,"おも"]],"text":"もしその国がわたしの目に悪と見えることを行い、わたしの声に聞き従わないなら、わたしはこれに幸を与えようとしたことを思いかえす。"},{"ref":"Jer.18.11","start":24018011,"end":24018011,"break":"none","ruby":[[8,2,"ひとびと"],[17,1,"す"],[19,1,"もの"],[21,1,"い"],[28,1,"しゅ"],[32,1,"おお"],[38,1,"み"],[51,1,"わざわい"],[53,1,"くだ"],[57,2,"くふう"],[67,1,"せ"],[70,1,"はか"],[75,1,"た"],[93,1,"あ"],[96,1,"みち"],[98,1,"はな"],[103,1,"みち"],[105,1,"おこな"],[108,1,"あらた"]],"text":"それゆえ、ユダの人々とエルサレムに住む者に言いなさい、『主はこう仰せられる、見よ、わたしはあなたがたに災を下そうと工夫し、あなたがたを攻める計りごとを立てている。あなたがたはおのおのその悪しき道を離れ、その道と行いを改めなさい』と。"},{"ref":"Jer.18.12","start":24018012,"end":24018012,"break":"paragraph","ruby":[[3,1,"かれ"],[6,1,"い"],[23,2,"じぶん"],[26,1,"はか"],[32,1,"したが"],[41,1,"わる"],[43,2,"ごうじょう"],[46,1,"こころ"],[53,2,"こうどう"]],"text":"しかし彼らは言う、『それはむだです。われわれは自分の図るところに従い、おのおのその悪い強情な心にしたがって行動します』と。"},{"ref":"Jer.18.13","start":24018013,"end":24018013,"break":"stanza","breaks":[[13,"line"],[31,"line"],[48,"line"]],"ruby":[[4,1,"しゅ"],[8,1,"い"],[13,2,"いほう"],[16,1,"たみ"],[23,1,"もの"],[25,1,"たず"],[36,1,"こと"],[38,1,"き"],[41,1,"もの"],[57,1,"おそ"],[61,1,"こと"]],"text":"それゆえ主はこう言われる、異邦の民のうちのある者に尋ねてみよ、このような事を聞いた者があろうか。おとめイスラエルは恐ろしい事をした。"},{"ref":"Jer.18.14","start":24018014,"end":24018014,"break":"line","breaks":[[8,"line"],[25,"line"],[38,"line"]],"ruby":[[5,1,"ゆき"],[17,1,"いわ"],[19,1,"はな"],[25,1,"やま"],[27,1,"みず"],[29,1,"つめ"],[32,1,"かわ"],[34,1,"なが"]],"text":"レバノンの雪が、どうしてシリオンの岩を離れようか。山の水、冷たい川の流れが、どうしてかわいてしまおうか。"},{"ref":"Jer.18.15","start":24018015,"end":24018015,"break":"line","breaks":[[17,"line"],[31,"line"],[47,"line"]],"ruby":[[7,1,"たみ"],[13,1,"わす"],[17,1,"いつわ"],[20,2,"かみがみ"],[23,1,"こう"],[31,1,"かれ"],[36,1,"みち"],[38,1,"ふる"],[40,1,"みち"],[49,2,"こみち"],[52,1,"い"],[55,2,"おおじ"]],"text":"それなのにわが民はわたしを忘れて、偽りの神々に香をたいている。彼らはその道、古い道につまずき、また小道に入り、大路からはなれた。"},{"ref":"Jer.18.16","start":24018016,"end":24018016,"break":"line","breaks":[[14,"line"],[33,"line"]],"ruby":[[0,2,"じぶん"],[3,1,"ち"],[5,1,"あ"],[19,1,"ひと"],[21,2,"したう"],[36,1,"とお"],[38,1,"ひと"],[42,2,"みぶる"],[48,1,"くび"],[50,1,"ふ"]],"text":"自分の地を荒れすたれさせて、いつまでも人に舌打ちされるものとした。そこを通る人はみな身震いして、首を振る。"},{"ref":"Jer.18.17","start":24018017,"end":24018017,"break":"line","breaks":[[24,"line"],[33,"line"]],"ruby":[[4,2,"ひがしかぜ"],[11,1,"かれ"],[16,1,"てき"],[18,1,"まえ"],[20,1,"ち"],[26,1,"ほろ"],[29,1,"ひ"],[37,1,"かれ"],[40,1,"せ"],[42,1,"む"],[45,1,"かお"],[47,1,"む"]],"text":"わたしは東風のように、彼らをその敵の前に散らす。その滅びの日には、わたしは彼らに背を向け、顔を向けない」。"},{"ref":"Jer.18.18","start":24018018,"end":24018018,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"い"],[11,2,"けいりゃく"],[25,1,"たお"],[29,2,"さいし"],[33,2,"りっぽう"],[39,2,"ちえ"],[43,1,"もの"],[46,1,"はか"],[54,3,"よげんしゃ"],[59,2,"ことば"],[73,1,"ほろ"],[93,1,"した"],[98,1,"かれ"],[100,1,"う"],[104,1,"かれ"],[110,2,"ことば"],[114,1,"こころ"],[116,1,"と"]],"text":"彼らは言った、「さあ、計略をめぐらして、エレミヤを倒そう。祭司には律法があり、知恵ある者には計りごとがあり、預言者には言葉があって、これらのものが滅びてしまうことはない。さあ、われわれは舌をもって彼を撃とう。彼のすべての言葉に、心を留めないことにしよう」。"},{"ref":"Jer.18.19","start":24018019,"end":24018019,"break":"paragraph","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"こころ"],[13,1,"と"],[20,1,"うった"],[24,1,"き"]],"text":"主よ、どうぞわたしにみ心を留め、わたしの訴えをお聞きください。"},{"ref":"Jer.18.20","start":24018020,"end":24018020,"break":"line","breaks":[[18,"line"],[38,"line"],[46,"line"],[60,"line"],[71,"line"],[87,"line"]],"ruby":[[0,1,"あく"],[5,1,"ぜん"],[7,1,"むく"],[23,1,"かれ"],[30,1,"いのち"],[32,1,"と"],[38,1,"あな"],[40,1,"ほ"],[54,1,"まえ"],[56,1,"た"],[60,1,"かれ"],[66,1,"よ"],[68,1,"い"],[75,1,"いきどお"],[78,1,"と"],[87,1,"おぼ"]],"text":"悪をもって善に報いるべきでしょうか。しかもなお彼らはわたしの命を取ろうとして穴を掘りました。わたしがあなたの前に立って、彼らのことを良く言い、あなたの憤りを止めようとしたのを覚えてください。"},{"ref":"Jer.18.21","start":24018021,"end":24018021,"break":"line","breaks":[[21,"line"],[38,"line"],[56,"line"],[68,"line"]],"ruby":[[5,1,"かれ"],[8,1,"こ"],[18,1,"わた"],[21,1,"かれ"],[28,1,"は"],[30,1,"わた"],[38,1,"かれ"],[41,1,"つま"],[43,1,"こ"],[45,1,"うしな"],[50,2,"かふ"],[56,1,"おとこ"],[58,2,"えきびょう"],[65,1,"し"],[68,1,"わか"],[70,1,"もの"],[73,2,"せんそう"],[80,1,"ころ"]],"text":"それゆえ、彼らの子どもたちをききんに渡し、彼らをつるぎの刃に渡してください。彼らの妻は子を失い、また寡婦となり、男は疫病にかかって死に、若い者は、戦争でつるぎに殺されますように。"},{"ref":"Jer.18.22","start":24018022,"end":24018022,"break":"line","breaks":[[22,"line"],[40,"line"],[60,"line"],[74,"line"]],"ruby":[[4,1,"てき"],[10,1,"かれ"],[13,1,"のぞ"],[22,1,"かれ"],[25,1,"いえ"],[28,1,"さけ"],[30,1,"ごえ"],[32,1,"きこ"],[40,1,"かれ"],[43,1,"あな"],[45,1,"ほ"],[53,1,"とら"],[72,1,"あし"],[74,1,"とら"]],"text":"あなたが敵をにわかに彼らに臨ませられるとき、彼らの家から叫び声が聞えますように。彼らは穴を掘って、わたしを捕えようとし、わなをつくって、わたしの足を捕えようとしたからです。"},{"ref":"Jer.18.23","start":24018023,"end":24018023,"break":"line","breaks":[[19,"line"],[37,"line"],[49,"line"],[72,"line"],[91,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"かれ"],[14,1,"ころ"],[26,2,"けいりゃく"],[29,1,"みな"],[39,1,"あく"],[51,1,"つみ"],[57,1,"まえ"],[60,1,"け"],[62,1,"さ"],[72,1,"かれ"],[79,1,"まえ"],[81,1,"たお"],[96,1,"いか"],[101,1,"とき"],[103,1,"かれ"],[106,1,"ばっ"]],"text":"主よ、あなたは彼らがわたしを殺すためにめぐらしている計略を皆ごぞんじです。その悪をゆるすことなく、その罪をあなたの前から消し去らないでください。彼らをあなたの前に倒れさせてください。あなたのお怒りになる時に彼らを罰してください。"}]