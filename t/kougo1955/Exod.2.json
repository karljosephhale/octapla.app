[{"ref":"Exod.2.1","start":2002001,"end":2002001,"break":"paragraph","ruby":[[6,1,"いえ"],[12,1,"ひと"],[14,1,"い"],[20,1,"むすめ"]],"text":"さて、レビの家のひとりの人が行ってレビの娘をめとった。"},{"ref":"Exod.2.2","start":2002002,"end":2002002,"break":"none","ruby":[[0,1,"おんな"],[8,1,"おとこ"],[10,1,"こ"],[12,1,"う"],[19,1,"うるわ"],[24,1,"み"],[28,1,"つき"],[33,1,"かく"]],"text":"女はみごもって、男の子を産んだが、その麗しいのを見て、三月のあいだ隠していた。"},{"ref":"Exod.2.3","start":2002003,"end":2002003,"break":"none","ruby":[[6,1,"かく"],[23,1,"あ"],[29,1,"と"],[42,2,"じゅし"],[46,1,"ぬ"],[50,1,"こ"],[54,1,"なか"],[56,1,"い"],[65,1,"かわ"],[67,1,"きし"],[69,1,"あし"],[71,1,"なか"]],"text":"しかし、もう隠しきれなくなったので、パピルスで編んだかごを取り、それにアスファルトと樹脂とを塗って、子をその中に入れ、これをナイル川の岸の葦の中においた。"},{"ref":"Exod.2.4","start":2002004,"end":2002004,"break":"none","ruby":[[2,1,"あね"],[5,1,"かれ"],[14,1,"し"],[19,1,"とお"],[21,1,"はな"],[24,1,"た"]],"text":"その姉は、彼がどうされるかを知ろうと、遠く離れて立っていた。"},{"ref":"Exod.2.5","start":2002005,"end":2002005,"break":"none","ruby":[[6,1,"むすめ"],[8,1,"み"],[10,1,"あら"],[15,1,"かわ"],[17,1,"ふ"],[23,2,"じじょ"],[28,1,"かわ"],[31,1,"ある"],[38,2,"かのじょ"],[42,1,"あし"],[44,1,"なか"],[53,1,"み"],[67,1,"と"]],"text":"ときにパロの娘が身を洗おうと、川に降りてきた。侍女たちは川べを歩いていたが、彼女は、葦の中にかごのあるのを見て、つかえめをやり、それを取ってこさせ、"},{"ref":"Exod.2.6","start":2002006,"end":2002006,"break":"none","ruby":[[3,1,"み"],[6,2,"こども"],[12,1,"み"],[15,1,"おさ"],[17,1,"ご"],[19,1,"な"],[25,2,"かのじょ"],[34,1,"おも"],[37,1,"い"],[51,2,"こども"]],"text":"あけて見ると子供がいた。見よ、幼な子は泣いていた。彼女はかわいそうに思って言った、「これはヘブルびとの子供です」。"},{"ref":"Exod.2.7","start":2002007,"end":2002007,"break":"none","ruby":[[4,1,"おさ"],[6,1,"ご"],[8,1,"あね"],[13,1,"むすめ"],[15,1,"い"],[24,1,"い"],[31,1,"おんな"],[48,1,"こ"],[50,1,"ちち"],[52,1,"の"],[59,1,"よ"]],"text":"そのとき幼な子の姉はパロの娘に言った、「わたしが行ってヘブルの女のうちから、あなたのために、この子に乳を飲ませるうばを呼んでまいりましょうか」。"},{"ref":"Exod.2.8","start":2002008,"end":2002008,"break":"none","ruby":[[3,1,"むすめ"],[6,1,"い"],[17,1,"い"],[21,2,"しょうじょ"],[24,1,"い"],[29,1,"こ"],[31,1,"はは"],[33,1,"よ"]],"text":"パロの娘が「行ってきてください」と言うと、少女は行ってその子の母を呼んできた。"},{"ref":"Exod.2.9","start":2002009,"end":2002009,"break":"none","ruby":[[3,1,"むすめ"],[5,2,"かのじょ"],[8,1,"い"],[15,1,"こ"],[17,1,"つ"],[20,1,"い"],[28,1,"かわ"],[31,1,"ちち"],[33,1,"の"],[48,2,"ほうしゅう"],[59,1,"おんな"],[63,1,"こ"],[65,1,"ひ"],[67,1,"と"],[74,1,"ちち"],[76,1,"あた"]],"text":"パロの娘は彼女に言った、「この子を連れて行って、わたしに代り、乳を飲ませてください。わたしはその報酬をさしあげます」。女はその子を引き取って、これに乳を与えた。"},{"ref":"Exod.2.10","start":2002010,"end":2002010,"break":"none","ruby":[[2,1,"こ"],[4,2,"せいちょう"],[11,2,"かのじょ"],[20,1,"むすめ"],[26,1,"つ"],[29,1,"い"],[36,1,"かれ"],[40,1,"こ"],[46,2,"かのじょ"],[51,1,"な"],[57,1,"な"],[61,1,"い"],[66,1,"みず"],[68,1,"なか"],[75,1,"ひ"],[77,1,"だ"]],"text":"その子が成長したので、彼女はこれをパロの娘のところに連れて行った。そして彼はその子となった。彼女はその名をモーセと名づけて言った、「水の中からわたしが引き出したからです」。"},{"ref":"Exod.2.11","start":2002011,"end":2002011,"break":"paragraph","ruby":[[4,2,"せいちょう"],[8,1,"のち"],[12,1,"ひ"],[17,2,"どうほう"],[20,1,"ところ"],[22,1,"で"],[24,1,"い"],[34,2,"ろうえき"],[37,1,"み"],[40,1,"かれ"],[54,2,"どうほう"],[69,1,"う"],[73,1,"み"]],"text":"モーセが成長して後、ある日のこと、同胞の所に出て行って、そのはげしい労役を見た。彼はひとりのエジプトびとが、同胞のひとりであるヘブルびとを打つのを見たので、"},{"ref":"Exod.2.12","start":2002012,"end":2002012,"break":"none","ruby":[[0,2,"さゆう"],[3,1,"み"],[8,1,"ひと"],[15,1,"み"],[27,1,"う"],[29,1,"ころ"],[35,1,"すな"],[37,1,"なか"],[39,1,"かく"]],"text":"左右を見まわし、人のいないのを見て、そのエジプトびとを打ち殺し、これを砂の中に隠した。"},{"ref":"Exod.2.13","start":2002013,"end":2002013,"break":"none","ruby":[[0,1,"つぎ"],[2,1,"ひ"],[5,1,"で"],[7,1,"い"],[21,1,"たがい"],[23,1,"あらそ"],[30,1,"み"],[32,1,"わる"],[34,1,"ほう"],[36,1,"おとこ"],[38,1,"い"],[54,1,"とも"],[56,1,"う"]],"text":"次の日また出て行って、ふたりのヘブルびとが互に争っているのを見、悪い方の男に言った、「あなたはなぜ、あなたの友を打つのですか」。"},{"ref":"Exod.2.14","start":2002014,"end":2002014,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[14,1,"た"],[29,3,"さいばんにん"],[47,1,"ころ"],[62,1,"ころ"],[66,1,"おも"],[78,1,"おそ"],[87,1,"こと"],[92,1,"し"],[98,1,"おも"]],"text":"彼は言った、「だれがあなたを立てて、われわれのつかさ、また裁判人としたのですか。エジプトびとを殺したように、あなたはわたしを殺そうと思うのですか」。モーセは恐れた。そしてあの事がきっと知れたのだと思った。"},{"ref":"Exod.2.15","start":2002015,"end":2002015,"break":"none","breaks":[[22,"paragraph"]],"ruby":[[5,1,"こと"],[7,1,"き"],[15,1,"ころ"],[32,1,"まえ"],[44,1,"ち"],[46,1,"い"],[49,2,"いど"],[57,1,"ざ"]],"text":"パロはこの事を聞いて、モーセを殺そうとした。しかしモーセはパロの前をのがれて、ミデヤンの地に行き、井戸のかたわらに座していた。"},{"ref":"Exod.2.16","start":2002016,"end":2002016,"break":"none","ruby":[[8,2,"さいし"],[12,1,"にん"],[14,1,"むすめ"],[20,2,"かのじょ"],[27,1,"みず"],[32,2,"すいそう"],[39,1,"ちち"],[41,1,"ひつじ"],[43,1,"む"],[46,1,"の"]],"text":"さて、ミデヤンの祭司に七人の娘があった。彼女たちはきて水をくみ、水槽にみたして父の羊の群れに飲ませようとしたが、"},{"ref":"Exod.2.17","start":2002017,"end":2002017,"break":"none","ruby":[[0,2,"ひつじかい"],[7,2,"かのじょ"],[11,1,"お"],[13,1,"はら"],[23,1,"た"],[25,1,"あ"],[29,2,"かのじょ"],[34,1,"たす"],[39,1,"ひつじ"],[41,1,"む"],[44,1,"みず"],[46,1,"の"]],"text":"羊飼たちがきて彼女らを追い払ったので、モーセは立ち上がって彼女たちを助け、その羊の群れに水を飲ませた。"},{"ref":"Exod.2.18","start":2002018,"end":2002018,"break":"none","ruby":[[0,2,"かのじょ"],[5,1,"ちち"],[15,1,"かえ"],[18,1,"とき"],[20,1,"ちち"],[22,1,"い"],[41,1,"はや"],[43,1,"かえ"]],"text":"彼女たちが父リウエルのところに帰った時、父は言った、「きょうは、どうして、こんなに早く帰ってきたのか」。"},{"ref":"Exod.2.19","start":2002019,"end":2002019,"break":"none","ruby":[[0,2,"かのじょ"],[5,1,"い"],[28,2,"ひつじかい"],[33,1,"て"],[36,1,"たす"],[38,1,"だ"],[46,1,"みず"],[56,1,"ひつじ"],[58,1,"む"],[61,1,"の"]],"text":"彼女たちは言った、「ひとりのエジプトびとが、わたしたちを羊飼たちの手から助け出し、そのうえ、水をたくさんくんで、羊の群れに飲ませてくれたのです」。"},{"ref":"Exod.2.20","start":2002020,"end":2002020,"break":"none","ruby":[[0,1,"かれ"],[2,1,"むすめ"],[6,1,"い"],[41,1,"よ"],[47,2,"しょくじ"]],"text":"彼は娘たちに言った、「そのかたはどこにおられるか。なぜ、そのかたをおいてきたのか。呼んできて、食事をさしあげなさい」。"},{"ref":"Exod.2.21","start":2002021,"end":2002021,"break":"none","ruby":[[6,1,"ひと"],[8,1,"とも"],[15,1,"この"],[21,1,"かれ"],[23,1,"むすめ"],[30,1,"つま"],[38,1,"あた"]],"text":"モーセがこの人と共におることを好んだので、彼は娘のチッポラを妻としてモーセに与えた。"},{"ref":"Exod.2.22","start":2002022,"end":2002022,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"おとこ"],[5,1,"こ"],[7,1,"う"],[19,1,"な"],[27,1,"な"],[37,2,"がいこく"],[40,3,"きりゅうしゃ"],[51,1,"い"]],"text":"彼女が男の子を産んだので、モーセはその名をゲルショムと名づけた。「わたしは外国に寄留者となっている」と言ったからである。"},{"ref":"Exod.2.23","start":2002023,"end":2002023,"break":"paragraph","ruby":[[0,1,"おお"],[3,1,"ひ"],[5,1,"へ"],[13,1,"おう"],[15,1,"し"],[25,2,"ひとびと"],[31,2,"くえき"],[34,1,"つとめ"],[45,1,"さけ"],[52,2,"くえき"],[58,1,"さけ"],[61,1,"かみ"],[63,1,"とど"]],"text":"多くの日を経て、エジプトの王は死んだ。イスラエルの人々は、その苦役の務のゆえにうめき、また叫んだが、その苦役のゆえの叫びは神に届いた。"},{"ref":"Exod.2.24","start":2002024,"end":2002024,"break":"none","ruby":[[0,1,"かみ"],[2,1,"かれ"],[9,1,"き"],[12,1,"かみ"],[29,2,"けいやく"],[32,1,"おぼ"]],"text":"神は彼らのうめきを聞き、神はアブラハム、イサク、ヤコブとの契約を覚え、"},{"ref":"Exod.2.25","start":2002025,"end":2002025,"break":"none","ruby":[[0,1,"かみ"],[8,2,"ひとびと"],[11,1,"かえり"],[14,1,"かみ"],[16,1,"かれ"]],"text":"神はイスラエルの人々を顧み、神は彼らをしろしめされた。"}]