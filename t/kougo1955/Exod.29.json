[{"ref":"Exod.29.1","start":2029001,"end":2029001,"break":"paragraph","ruby":[[4,1,"かれ"],[7,2,"せいべつ"],[11,2,"さいし"],[20,1,"つか"],[29,1,"つぎ"],[31,1,"こと"],[33,1,"かれ"],[50,1,"わか"],[52,2,"おうし"],[55,1,"とう"],[63,2,"おひつじ"],[66,1,"とう"],[69,1,"と"]],"text":"あなたは彼らを聖別し、祭司としてわたしに仕えさせるために、次の事を彼らにしなければならない。すなわち若い雄牛一頭と、きずのない雄羊二頭とを取り、"},{"ref":"Exod.29.2","start":2029002,"end":2029002,"break":"none","ruby":[[2,1,"たね"],[3,1,"い"],[10,1,"あぶら"],[12,1,"ま"],[15,1,"たね"],[16,1,"い"],[19,2,"かし"],[23,1,"あぶら"],[25,1,"ぬ"],[28,1,"たね"],[29,1,"い"],[38,1,"と"],[48,3,"こむぎこ"],[52,1,"つく"]],"text":"また種入れぬパンと、油を混ぜた種入れぬ菓子と、油を塗った種入れぬせんべいとを取りなさい。これらは小麦粉で作らなければならない。"},{"ref":"Exod.29.3","start":2029003,"end":2029003,"break":"none","ruby":[[12,1,"い"],[20,1,"い"],[29,1,"とう"],[31,2,"おうし"],[37,1,"とう"],[39,2,"おひつじ"],[42,1,"とも"],[44,1,"たずさ"]],"text":"そしてこれを一つのかごに入れ、そのかごに入れたまま、かの一頭の雄牛および二頭の雄羊と共に携えてこなければならない。"},{"ref":"Exod.29.4","start":2029004,"end":2029004,"break":"none","ruby":[[12,1,"こ"],[16,2,"かいけん"],[19,2,"まくや"],[22,2,"いりぐち"],[25,1,"つ"],[31,1,"みず"],[33,1,"かれ"],[36,1,"あら"],[38,1,"きよ"]],"text":"あなたはまたアロンとその子たちを会見の幕屋の入口に連れてきて、水で彼らを洗い清め、"},{"ref":"Exod.29.5","start":2029005,"end":2029005,"break":"none","ruby":[[2,2,"いふく"],[5,1,"と"],[8,1,"した"],[9,1,"ふく"],[15,1,"ぞく"],[18,2,"うわふく"],[26,2,"むねあて"],[34,1,"き"],[41,1,"おび"],[43,1,"し"]],"text":"また衣服を取り、下服とエポデに属する上服と、エポデと胸当とをアロンに着せ、エポデの帯を締めさせなければならない。"},{"ref":"Exod.29.6","start":2029006,"end":2029006,"break":"none","ruby":[[3,1,"かれ"],[5,1,"あたま"],[7,2,"ぼうし"],[17,2,"ぼうし"],[20,1,"うえ"],[24,1,"せい"],[27,1,"かんむり"]],"text":"そして彼の頭に帽子をかぶらせ、その帽子の上にかの聖なる冠をいただかせ、"},{"ref":"Exod.29.7","start":2029007,"end":2029007,"break":"none","ruby":[[0,1,"そそ"],[2,1,"あぶら"],[4,1,"と"],[7,1,"かれ"],[9,1,"あたま"],[14,1,"かれ"],[16,1,"あぶら"],[17,1,"そそ"]],"text":"注ぎ油を取って彼の頭にかけ、彼に油注ぎをしなければならない。"},{"ref":"Exod.29.8","start":2029008,"end":2029008,"break":"none","ruby":[[6,1,"かれ"],[8,1,"こ"],[12,1,"つ"],[17,1,"した"],[18,1,"ふく"],[20,1,"き"]],"text":"あなたはまた彼の子たちを連れてきて下服を着せ、"},{"ref":"Exod.29.9","start":2029009,"end":2029009,"break":"none","ruby":[[0,1,"かれ"],[13,1,"こ"],[17,1,"おび"],[19,1,"し"],[41,2,"さいし"],[44,1,"しょく"],[46,2,"えいきゅう"],[49,1,"さだ"],[55,1,"かれ"],[58,1,"き"],[81,1,"こ"],[85,1,"しょく"],[87,1,"にん"]],"text":"彼ら、すなわちアロンとその子たちに帯を締めさせ、ずきんをかぶらせなければならない。祭司の職は永久の定めによって彼らに帰するであろう。あなたはこうして、アロンとその子たちを職に任じなければならない。"},{"ref":"Exod.29.10","start":2029010,"end":2029010,"break":"paragraph","ruby":[[4,2,"かいけん"],[7,2,"まくや"],[10,1,"まえ"],[12,2,"おうし"],[15,1,"ひ"],[27,1,"こ"],[34,2,"おひつじ"],[37,1,"あたま"],[39,1,"て"],[41,1,"お"]],"text":"あなたは会見の幕屋の前に雄牛を引いてきて、アロンとその子たちは、その雄羊の頭に手を置かなければならない。"},{"ref":"Exod.29.11","start":2029011,"end":2029011,"break":"none","ruby":[[3,2,"かいけん"],[6,2,"まくや"],[9,2,"いりぐち"],[13,1,"しゅ"],[15,1,"まえ"],[19,2,"おうし"]],"text":"そして会見の幕屋の入口で、主の前にその雄牛をほふり、"},{"ref":"Exod.29.12","start":2029012,"end":2029012,"break":"none","ruby":[[2,2,"おうし"],[5,1,"ち"],[7,1,"と"],[10,1,"ゆび"],[19,2,"さいだん"],[22,1,"つの"],[29,1,"のこ"],[32,1,"ち"],[34,2,"さいだん"],[37,1,"もとい"],[39,1,"そそ"]],"text":"その雄牛の血を取り、指をもって、これを祭壇の角につけ、その残りの血を祭壇の基に注ぎかけなさい。"},{"ref":"Exod.29.13","start":2029013,"end":2029013,"break":"none","ruby":[[5,2,"ないぞう"],[15,2,"しぼう"],[18,2,"かんぞう"],[21,2,"しょうよう"],[28,2,"じんぞう"],[34,1,"うえ"],[36,2,"しぼう"],[40,1,"と"],[47,2,"さいだん"],[50,1,"うえ"],[52,1,"や"]],"text":"また、その内臓をおおうすべての脂肪と肝臓の小葉と、二つの腎臓と、その上の脂肪とを取って、これを祭壇の上で焼かなければならない。"},{"ref":"Exod.29.14","start":2029014,"end":2029014,"break":"none","ruby":[[6,2,"おうし"],[9,1,"にく"],[11,1,"かわ"],[13,2,"おぶつ"],[18,2,"しゅくえい"],[21,1,"そと"],[23,1,"ひ"],[25,1,"や"],[27,1,"す"],[41,2,"ざいさい"]],"text":"ただし、その雄牛の肉と皮と汚物とは、宿営の外で火で焼き捨てなければならない。これは罪祭である。"},{"ref":"Exod.29.15","start":2029015,"end":2029015,"break":"paragraph","ruby":[[9,2,"おひつじ"],[13,1,"とう"],[15,1,"と"],[27,1,"こ"],[34,2,"おひつじ"],[37,1,"あたま"],[39,1,"て"],[41,1,"お"]],"text":"あなたはまた、かの雄羊の一頭を取り、そしてアロンとその子たちは、その雄羊の頭に手を置かなければならない。"},{"ref":"Exod.29.16","start":2029016,"end":2029016,"break":"none","ruby":[[6,2,"おひつじ"],[15,1,"ち"],[17,1,"と"],[21,2,"さいだん"],[27,2,"そくめん"],[30,1,"そそ"]],"text":"あなたはその雄羊をほふり、その血を取って、祭壇の四つの側面に注ぎかけなければならない。"},{"ref":"Exod.29.17","start":2029017,"end":2029017,"break":"none","ruby":[[4,2,"おひつじ"],[7,1,"き"],[9,1,"さ"],[14,2,"ないぞう"],[20,1,"あし"],[23,1,"あら"],[32,1,"にく"],[34,1,"き"],[40,1,"とう"],[42,1,"とも"],[44,1,"お"]],"text":"またその雄羊を切り裂き、その内臓と、その足とを洗って、これをその肉の切れ、および頭と共に置き、"},{"ref":"Exod.29.18","start":2029018,"end":2029018,"break":"none","ruby":[[2,2,"おひつじ"],[7,2,"さいだん"],[10,1,"うえ"],[12,1,"や"],[26,1,"しゅ"],[32,2,"はんさい"],[46,1,"こう"],[58,1,"しゅ"],[64,2,"かさい"]],"text":"その雄羊をみな祭壇の上で焼かなければならない。これは主にささげる燔祭である。すなわち、これは香ばしいかおりであって、主にささげる火祭である。"},{"ref":"Exod.29.19","start":2029019,"end":2029019,"break":"paragraph","ruby":[[6,2,"おひつじ"],[9,1,"た"],[12,1,"とう"],[14,1,"と"],[23,1,"こ"],[30,2,"おひつじ"],[33,1,"あたま"],[35,1,"て"],[37,1,"お"]],"text":"あなたはまた雄羊の他の一頭を取り、アロンとその子たちは、その雄羊の頭に手を置かなければならない。"},{"ref":"Exod.29.20","start":2029020,"end":2029020,"break":"none","ruby":[[9,2,"おひつじ"],[18,1,"ち"],[20,1,"と"],[28,1,"みぎ"],[30,1,"みみ"],[37,1,"こ"],[41,1,"みぎ"],[43,1,"みみ"],[53,1,"かれ"],[56,1,"みぎ"],[58,1,"て"],[60,2,"おやゆび"],[64,1,"みぎ"],[66,1,"あし"],[68,2,"おやゆび"],[77,1,"のこ"],[80,1,"ち"],[82,2,"さいだん"],[88,2,"そくめん"],[91,1,"そそ"]],"text":"そしてあなたはその雄羊をほふり、その血を取って、アロンの右の耳たぶと、その子たちの右の耳たぶとにつけ、また彼らの右の手の親指と、右の足の親指とにつけ、その残りの血を祭壇の四つの側面に注ぎかけなければならない。"},{"ref":"Exod.29.21","start":2029021,"end":2029021,"break":"none","ruby":[[2,2,"さいだん"],[5,1,"うえ"],[7,1,"ち"],[11,1,"そそ"],[13,1,"あぶら"],[15,1,"と"],[25,2,"いふく"],[33,1,"こ"],[40,1,"こ"],[44,2,"いふく"],[48,1,"そそ"],[59,1,"かれ"],[63,2,"いふく"],[71,1,"こ"],[77,2,"いふく"],[81,2,"せいべつ"]],"text":"また祭壇の上の血および注ぎ油を取って、アロンとその衣服、およびその子たちと、その子たちの衣服とに注がなければならない。彼とその衣服、およびその子らと、その衣服とは聖別されるであろう。"},{"ref":"Exod.29.22","start":2029022,"end":2029022,"break":"paragraph","ruby":[[9,2,"おひつじ"],[12,2,"しぼう"],[15,1,"あぶら"],[16,1,"お"],[18,2,"ないぞう"],[24,2,"しぼう"],[27,2,"かんぞう"],[30,2,"しょうよう"],[36,2,"じんぞう"],[41,1,"うえ"],[43,2,"しぼう"],[49,1,"みぎ"],[54,1,"と"],[68,1,"にん"],[69,1,"しょく"],[71,2,"おひつじ"]],"text":"あなたはまた、その雄羊の脂肪、脂尾、内臓をおおう脂肪、肝臓の小葉、二つの腎臓、その上の脂肪、および右のももを取らなければならない。これは任職の雄羊である。"},{"ref":"Exod.29.23","start":2029023,"end":2029023,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"まえ"],[8,1,"たね"],[9,1,"い"],[18,1,"なか"],[24,1,"こ"],[27,1,"あぶら"],[28,2,"かし"],[31,1,"こ"],[39,1,"こ"],[42,1,"と"]],"text":"また主の前にある種入れぬパンのかごの中からパン一個と、油菓子一個と、せんべい一個とを取り、"},{"ref":"Exod.29.24","start":2029024,"end":2029024,"break":"none","ruby":[[9,1,"て"],[14,1,"こ"],[18,1,"て"],[20,1,"お"],[26,1,"しゅ"],[28,1,"まえ"],[30,1,"ゆ"],[32,1,"うご"],[37,2,"ようさい"]],"text":"これをみなアロンの手と、その子たちの手に置き、これを主の前に揺り動かして、揺祭としなければならない。"},{"ref":"Exod.29.25","start":2029025,"end":2029025,"break":"none","ruby":[[10,1,"かれ"],[13,1,"て"],[16,1,"う"],[18,1,"と"],[21,2,"はんさい"],[24,1,"くわ"],[27,2,"さいだん"],[30,1,"うえ"],[32,1,"や"],[35,1,"しゅ"],[37,1,"まえ"],[39,1,"こう"],[60,1,"しゅ"],[66,2,"かさい"]],"text":"そしてあなたはこれを彼らの手から受け取り、燔祭に加えて祭壇の上で焼き、主の前に香ばしいかおりとしなければならない。これは主にささげる火祭である。"},{"ref":"Exod.29.26","start":2029026,"end":2029026,"break":"paragraph","ruby":[[11,1,"にん"],[12,1,"しょく"],[14,2,"おひつじ"],[17,1,"むね"],[19,1,"と"],[25,1,"しゅ"],[27,1,"まえ"],[29,1,"ゆ"],[31,1,"うご"],[36,2,"ようさい"],[56,1,"う"],[59,1,"ぶん"]],"text":"あなたはまた、アロンの任職の雄羊の胸を取り、これを主の前に揺り動かして、揺祭としなければならない。これはあなたの受ける分となるであろう。"},{"ref":"Exod.29.27","start":2029027,"end":2029027,"break":"none","ruby":[[10,1,"こ"],[14,1,"にん"],[15,1,"しょく"],[17,2,"おひつじ"],[20,1,"むね"],[29,1,"ゆ"],[31,1,"うご"],[35,2,"ようさい"],[38,1,"むね"],[49,2,"せいべつ"]],"text":"あなたはアロンとその子たちの任職の雄羊の胸ともも、すなわち揺り動かした揺祭の胸と、ささげたももとを聖別しなければならない。"},{"ref":"Exod.29.28","start":2029028,"end":2029028,"break":"none","ruby":[[9,2,"ひとびと"],[13,2,"えいきゅう"],[23,1,"こ"],[27,1,"う"],[34,1,"もの"],[46,2,"ひとびと"],[49,3,"しゅうおんさい"],[53,2,"ぎせい"],[56,1,"なか"],[59,1,"う"],[70,1,"しゅ"],[79,1,"もの"]],"text":"これはイスラエルの人々から永久に、アロンとその子たちの受くべきささげ物であって、イスラエルの人々の酬恩祭の犠牲の中から受くべきもの、すなわち主にささげるささげ物である。"},{"ref":"Exod.29.29","start":2029029,"end":2029029,"break":"paragraph","ruby":[[4,1,"せい"],[7,2,"いふく"],[10,1,"かれ"],[12,1,"のち"],[14,2,"しそん"],[17,1,"き"],[25,1,"かれ"],[31,1,"き"],[34,1,"あぶら"],[35,1,"そそ"],[39,1,"しょく"],[41,1,"にん"]],"text":"アロンの聖なる衣服は彼の後の子孫に帰すべきである。彼らはこれを着て、油注がれ、職に任ぜられなければならない。"},{"ref":"Exod.29.30","start":2029030,"end":2029030,"break":"none","ruby":[[2,1,"こ"],[9,1,"かれ"],[11,1,"かわ"],[14,2,"さいし"],[20,2,"せいじょ"],[23,1,"つか"],[29,2,"かいけん"],[32,2,"まくや"],[38,1,"もの"],[41,2,"なぬか"],[44,1,"あいだ"],[48,1,"き"]],"text":"その子たちのうち、彼に代って祭司となり、聖所で仕えるために会見の幕屋にはいる者は、七日の間これを着なければならない。"},{"ref":"Exod.29.31","start":2029031,"end":2029031,"break":"paragraph","ruby":[[4,1,"にん"],[5,1,"しょく"],[7,2,"おひつじ"],[10,1,"と"],[13,1,"せい"],[16,2,"ばしょ"],[21,1,"にく"],[23,1,"に"]],"text":"あなたは任職の雄羊を取り、聖なる場所でその肉を煮なければならない。"},{"ref":"Exod.29.32","start":2029032,"end":2029032,"break":"none","ruby":[[6,1,"こ"],[10,2,"かいけん"],[13,2,"まくや"],[16,2,"いりぐち"],[22,2,"おひつじ"],[25,1,"にく"],[31,1,"なか"],[37,1,"た"]],"text":"アロンとその子たちは会見の幕屋の入口で、その雄羊の肉と、かごの中のパンとを食べなければならない。"},{"ref":"Exod.29.33","start":2029033,"end":2029033,"break":"none","ruby":[[0,1,"かれ"],[3,1,"しょく"],[5,1,"にん"],[8,2,"せいべつ"],[20,1,"もち"],[31,1,"かれ"],[34,1,"た"],[45,1,"た"],[47,1,"ひと"],[52,1,"た"],[64,1,"せい"],[67,1,"もの"]],"text":"彼らを職に任じ、聖別するため、あがないに用いたこれらのものを、彼らは食べなければならない。他の人はこれを食べてはならない。これは聖なる物だからである。"},{"ref":"Exod.29.34","start":2029034,"end":2029034,"break":"none","ruby":[[2,1,"にん"],[3,1,"しょく"],[5,1,"にく"],[17,1,"あさ"],[20,1,"のこ"],[31,1,"のこ"],[34,1,"ひ"],[36,1,"や"],[50,1,"せい"],[53,1,"もの"],[57,1,"た"]],"text":"もし任職の肉、あるいはパンのうち、朝まで残るものがあれば、その残りは火で焼かなければならない。これは聖なる物だから食べてはならない。"},{"ref":"Exod.29.35","start":2029035,"end":2029035,"break":"paragraph","ruby":[[11,1,"めい"],[24,1,"こ"],[42,1,"かれ"],[48,2,"なぬか"],[55,1,"にん"],[56,1,"しょく"],[58,1,"しき"],[60,1,"おこな"]],"text":"あなたはわたしがすべて命じるように、アロンとその子たちにしなければならない。すなわち彼らのために七日のあいだ、任職の式を行わなければならない。"},{"ref":"Exod.29.36","start":2029036,"end":2029036,"break":"none","ruby":[[4,2,"まいにち"],[16,2,"ざいさい"],[19,2,"おうし"],[22,1,"とう"],[38,2,"さいだん"],[52,1,"とき"],[59,2,"ざいさい"],[72,1,"あぶら"],[74,1,"そそ"],[77,2,"せいべつ"]],"text":"あなたは毎日、あがないのために、罪祭の雄牛一頭をささげなければならない。また祭壇のために、あがないをなす時、そのために罪祭をささげ、また、これに油を注いで聖別しなさい。"},{"ref":"Exod.29.37","start":2029037,"end":2029037,"break":"none","ruby":[[4,2,"なぬか"],[7,1,"あいだ"],[9,2,"さいだん"],[27,2,"せいべつ"],[43,2,"さいだん"],[49,1,"せい"],[52,1,"もの"],[60,2,"さいだん"],[63,1,"ふ"],[66,1,"もの"],[68,1,"せい"]],"text":"あなたは七日の間、祭壇のために、あがないをして、これを聖別しなければならない。こうして祭壇は、いと聖なる物となり、すべて祭壇に触れる者は聖となるであろう。"},{"ref":"Exod.29.38","start":2029038,"end":2029038,"break":"paragraph","ruby":[[4,2,"さいだん"],[7,1,"うえ"],[14,1,"もの"],[16,1,"つぎ"],[29,2,"とうさい"],[32,2,"こひつじ"],[35,1,"とう"],[37,2,"まいにち"],[39,1,"た"]],"text":"あなたが祭壇の上にささぐべき物は次のとおりである。すなわち当歳の小羊二頭を毎日絶やすことなくささげなければならない。"},{"ref":"Exod.29.39","start":2029039,"end":2029039,"break":"none","ruby":[[3,1,"とう"],[5,2,"こひつじ"],[8,1,"あさ"],[17,1,"た"],[20,1,"とう"],[22,2,"こひつじ"],[25,1,"ゆう"]],"text":"その一頭の小羊は朝にこれをささげ、他の一頭の小羊は夕にこれをささげなければならない。"},{"ref":"Exod.29.40","start":2029040,"end":2029040,"break":"none","ruby":[[1,1,"とう"],[3,2,"こひつじ"],[12,1,"と"],[15,1,"あぶら"],[21,1,"ぶん"],[28,2,"むぎこ"],[31,1,"ぶん"],[37,1,"そ"],[42,2,"かんさい"],[51,1,"しゅ"],[57,1,"ぶん"],[61,1,"そ"]],"text":"一頭の小羊には、つぶして取った油一ヒンの四分の一をまぜた麦粉十分の一エパを添え、また灌祭として、ぶどう酒一ヒンの四分の一を添えなければならない。"},{"ref":"Exod.29.41","start":2029041,"end":2029041,"break":"none","ruby":[[0,1,"た"],[3,1,"とう"],[5,2,"こひつじ"],[8,1,"ゆう"],[17,1,"あさ"],[19,2,"そさい"],[24,2,"かんさい"],[27,1,"おな"],[35,1,"そ"],[42,1,"こう"],[53,1,"しゅ"],[59,2,"かさい"]],"text":"他の一頭の小羊は夕にこれをささげ、朝の素祭および灌祭と同じものをこれに添えてささげ、香ばしいかおりのために主にささげる火祭としなければならない。"},{"ref":"Exod.29.42","start":2029042,"end":2029042,"break":"none","ruby":[[9,2,"よよ"],[11,2,"かいけん"],[14,2,"まくや"],[17,2,"いりぐち"],[21,1,"しゅ"],[23,1,"まえ"],[25,1,"た"],[38,2,"はんさい"],[50,1,"ところ"],[56,1,"あ"],[63,1,"かた"]],"text":"これはあなたがたが代々会見の幕屋の入口で、主の前に絶やすことなく、ささぐべき燔祭である。わたしはその所であなたに会い、あなたと語るであろう。"},{"ref":"Exod.29.43","start":2029043,"end":2029043,"break":"none","ruby":[[5,1,"ところ"],[17,2,"ひとびと"],[20,1,"あ"],[27,2,"まくや"],[34,2,"えいこう"],[40,2,"せいべつ"]],"text":"また、その所でわたしはイスラエルの人々に会うであろう。幕屋はわたしの栄光によって聖別されるであろう。"},{"ref":"Exod.29.44","start":2029044,"end":2029044,"break":"none","ruby":[[4,2,"かいけん"],[7,2,"まくや"],[10,2,"さいだん"],[14,2,"せいべつ"],[31,1,"こ"],[35,2,"せいべつ"],[39,2,"さいし"],[48,1,"つか"]],"text":"わたしは会見の幕屋と祭壇とを聖別するであろう。またアロンとその子たちを聖別し、祭司としてわたしに仕えさせるであろう。"},{"ref":"Exod.29.45","start":2029045,"end":2029045,"break":"none","ruby":[[10,2,"ひとびと"],[16,1,"す"],[20,1,"かれ"],[23,1,"かみ"]],"text":"わたしはイスラエルの人々のうちに住んで、彼らの神となるであろう。"},{"ref":"Exod.29.46","start":2029046,"end":2029046,"break":"none","ruby":[[4,1,"かれ"],[10,1,"す"],[16,1,"かれ"],[24,1,"くに"],[27,1,"みちび"],[29,1,"だ"],[32,1,"かれ"],[35,1,"かみ"],[37,1,"しゅ"],[44,1,"かれ"],[47,1,"し"],[58,1,"かれ"],[61,1,"かみ"],[63,1,"しゅ"]],"text":"わたしが彼らのうちに住むために、彼らをエジプトの国から導き出した彼らの神、主であることを彼らは知るであろう。わたしは彼らの神、主である。"}]