[{"ref":"Gal.3.1","start":48003001,"end":48003001,"break":"paragraph","ruby":[[3,1,"もの"],[15,1,"びと"],[18,3,"じゅうじか"],[43,1,"め"],[45,1,"まえ"],[47,1,"えが"],[49,1,"だ"],[70,1,"まど"]],"text":"ああ、物わかりのわるいガラテヤ人よ。十字架につけられたイエス・キリストが、あなたがたの目の前に描き出されたのに、いったい、だれがあなたがたを惑わしたのか。"},{"ref":"Gal.3.2","start":48003002,"end":48003002,"break":"none","ruby":[[12,1,"こと"],[21,1,"き"],[34,2,"みたま"],[37,1,"う"],[43,2,"りっぽう"],[46,1,"おこな"],[58,1,"き"],[61,1,"しん"]],"text":"わたしは、ただこの一つの事を、あなたがたに聞いてみたい。あなたがたが御霊を受けたのは、律法を行ったからか、それとも、聞いて信じたからか。"},{"ref":"Gal.3.3","start":48003003,"end":48003003,"break":"none","ruby":[[11,1,"もの"],[22,2,"みたま"],[25,1,"はじ"],[31,1,"いま"],[36,1,"にく"],[38,2,"しあ"]],"text":"あなたがたは、そんなに物わかりがわるいのか。御霊で始めたのに、今になって肉で仕上げるというのか。"},{"ref":"Gal.3.4","start":48003004,"end":48003004,"break":"none","ruby":[[5,1,"おお"],[8,2,"けいけん"]],"text":"あれほどの大きな経験をしたことは、むだであったのか。まさか、むだではあるまい。"},{"ref":"Gal.3.5","start":48003005,"end":48003005,"break":"none","ruby":[[10,2,"みたま"],[13,1,"たま"],[16,1,"ちから"],[28,1,"あいだ"],[37,2,"りっぽう"],[40,1,"おこな"],[52,1,"き"],[55,1,"しん"]],"text":"すると、あなたがたに御霊を賜い、力あるわざをあなたがたの間でなされたのは、律法を行ったからか、それとも、聞いて信じたからか。"},{"ref":"Gal.3.6","start":48003006,"end":48003006,"break":"paragraph","ruby":[[13,1,"かみ"],[15,1,"しん"],[26,1,"かれ"],[28,1,"ぎ"],[30,1,"みと"]],"text":"このように、アブラハムは「神を信じた。それによって、彼は義と認められた」のである。"},{"ref":"Gal.3.7","start":48003007,"end":48003007,"break":"none","ruby":[[4,2,"しんこう"],[9,1,"もの"],[18,1,"こ"],[26,1,"し"]],"text":"だから、信仰による者こそアブラハムの子であることを、知るべきである。"},{"ref":"Gal.3.8","start":48003008,"end":48003008,"break":"none","ruby":[[0,2,"せいしょ"],[4,1,"かみ"],[6,3,"いほうじん"],[10,2,"しんこう"],[16,1,"ぎ"],[30,1,"し"],[54,2,"こくみん"],[57,2,"しゅくふく"],[69,1,"よ"],[71,1,"し"],[76,2,"よこく"]],"text":"聖書は、神が異邦人を信仰によって義とされることを、あらかじめ知って、アブラハムに、「あなたによって、すべての国民は祝福されるであろう」との良い知らせを、予告したのである。"},{"ref":"Gal.3.9","start":48003009,"end":48003009,"break":"none","ruby":[[6,2,"しんこう"],[11,1,"もの"],[14,2,"しんこう"],[17,1,"ひと"],[24,1,"とも"],[27,2,"しゅくふく"],[30,1,"う"]],"text":"このように、信仰による者は、信仰の人アブラハムと共に、祝福を受けるのである。"},{"ref":"Gal.3.10","start":48003010,"end":48003010,"break":"none","ruby":[[5,2,"りっぽう"],[8,1,"おこな"],[13,1,"もの"],[16,1,"みな"],[21,1,"もと"],[27,2,"りっぽう"],[30,1,"しょ"],[32,1,"か"],[45,1,"まも"],[52,1,"おこな"],[56,1,"もの"],[59,1,"みな"],[67,1,"か"]],"text":"いったい、律法の行いによる者は、皆のろいの下にある。「律法の書に書いてあるいっさいのことを守らず、これを行わない者は、皆のろわれる」と書いてあるからである。"},{"ref":"Gal.3.11","start":48003011,"end":48003011,"break":"none","ruby":[[4,2,"りっぽう"],[12,1,"かみ"],[18,1,"ぎ"],[23,1,"もの"],[35,1,"あき"],[48,2,"しんこう"],[53,2,"ぎじん"],[56,1,"い"]],"text":"そこで、律法によっては、神のみまえに義とされる者はひとりもないことが、明らかである。なぜなら、「信仰による義人は生きる」からである。"},{"ref":"Gal.3.12","start":48003012,"end":48003012,"break":"none","ruby":[[0,2,"りっぽう"],[3,2,"しんこう"],[6,1,"もとづ"],[24,2,"りっぽう"],[27,1,"おこな"],[29,1,"もの"],[31,2,"りっぽう"],[37,1,"い"]],"text":"律法は信仰に基いているものではない。かえって、「律法を行う者は律法によって生きる」のである。"},{"ref":"Gal.3.13","start":48003013,"end":48003013,"break":"none","ruby":[[29,2,"りっぽう"],[41,1,"だ"],[44,1,"くだ"],[49,2,"せいしょ"],[54,1,"き"],[61,1,"もの"],[74,1,"か"]],"text":"キリストは、わたしたちのためにのろいとなって、わたしたちを律法ののろいからあがない出して下さった。聖書に、「木にかけられる者は、すべてのろわれる」と書いてある。"},{"ref":"Gal.3.14","start":48003014,"end":48003014,"break":"none","ruby":[[10,1,"う"],[13,2,"しゅくふく"],[29,3,"いほうじん"],[33,1,"およ"],[41,2,"やくそく"],[46,2,"みたま"],[56,2,"しんこう"],[62,1,"う"]],"text":"それは、アブラハムの受けた祝福が、イエス・キリストにあって異邦人に及ぶためであり、約束された御霊を、わたしたちが信仰によって受けるためである。"},{"ref":"Gal.3.15","start":48003015,"end":48003015,"break":"paragraph","ruby":[[0,2,"きょうだい"],[6,1,"よ"],[13,1,"れい"],[18,1,"い"],[22,2,"にんげん"],[25,2,"ゆいごん"],[35,2,"さくせい"],[45,2,"むこう"],[55,1,"つ"],[57,1,"くわ"]],"text":"兄弟たちよ。世のならわしを例にとって言おう。人間の遺言でさえ、いったん作成されたら、これを無効にしたり、これに付け加えたりすることは、だれにもできない。"},{"ref":"Gal.3.16","start":48003016,"end":48003016,"break":"none","ruby":[[3,2,"やくそく"],[13,1,"かれ"],[15,2,"しそん"],[19,1,"たい"],[35,2,"たすう"],[42,2,"しそん"],[50,1,"い"],[67,2,"しそん"],[73,1,"い"]],"text":"さて、約束は、アブラハムと彼の子孫とに対してなされたのである。それは、多数をさして「子孫たちとに」と言わずに、ひとりをさして「あなたの子孫とに」と言っている。これは、キリストのことである。"},{"ref":"Gal.3.17","start":48003017,"end":48003017,"break":"none","ruby":[[4,1,"い"],[6,2,"いみ"],[16,1,"かみ"],[26,1,"た"],[31,2,"けいやく"],[39,1,"ねん"],[41,1,"のち"],[46,2,"りっぽう"],[52,2,"はき"],[60,2,"やくそく"]],"text":"わたしの言う意味は、こうである。神によってあらかじめ立てられた契約が、四百三十年の後にできた律法によって破棄されて、その約束がむなしくなるようなことはない。"},{"ref":"Gal.3.18","start":48003018,"end":48003018,"break":"none","ruby":[[2,2,"そうぞく"],[6,2,"りっぽう"],[9,1,"もとづ"],[24,2,"やくそく"],[27,1,"もとづ"],[41,2,"じじつ"],[44,1,"かみ"],[46,2,"やくそく"],[53,2,"そうぞく"],[56,1,"めぐ"],[65,1,"たま"]],"text":"もし相続が、律法に基いてなされるとすれば、もはや約束に基いたものではない。ところが事実、神は約束によって、相続の恵みをアブラハムに賜わったのである。"},{"ref":"Gal.3.19","start":48003019,"end":48003019,"break":"paragraph","ruby":[[5,2,"りっぽう"],[18,2,"いはん"],[21,1,"うなが"],[30,1,"くわ"],[41,2,"やくそく"],[48,2,"しそん"],[51,1,"く"],[55,2,"そんぞく"],[71,2,"てんし"],[80,3,"ちゅうかいしゃ"],[84,1,"て"],[89,2,"せいてい"]],"text":"それでは、律法はなんであるか。それは違反を促すため、あとから加えられたのであって、約束されていた子孫が来るまで存続するだけのものであり、かつ、天使たちをとおし、仲介者の手によって制定されたものにすぎない。"},{"ref":"Gal.3.20","start":48003020,"end":48003020,"break":"none","ruby":[[0,3,"ちゅうかいしゃ"],[9,2,"いっぽう"],[14,1,"ぞく"],[17,1,"もの"],[27,1,"かみ"]],"text":"仲介者なるものは、一方だけに属する者ではない。しかし、神はひとりである。"},{"ref":"Gal.3.21","start":48003021,"end":48003021,"break":"none","ruby":[[3,2,"りっぽう"],[6,1,"かみ"],[8,2,"やくそく"],[11,1,"あい"],[20,1,"だん"],[32,1,"ひと"],[34,1,"い"],[37,1,"ちから"],[41,2,"りっぽう"],[44,1,"あた"],[56,1,"ぎ"],[62,2,"りっぽう"],[68,2,"じつげん"]],"text":"では、律法は神の約束と相いれないものか。断じてそうではない。もし人を生かす力のある律法が与えられていたとすれば、義はたしかに律法によって実現されたであろう。"},{"ref":"Gal.3.22","start":48003022,"end":48003022,"break":"none","ruby":[[4,2,"やくそく"],[8,1,"しん"],[11,2,"ひとびと"],[23,1,"たい"],[26,2,"しんこう"],[32,1,"あた"],[41,2,"せいしょ"],[48,1,"ひと"],[50,1,"つみ"],[52,1,"もと"],[54,1,"と"],[56,1,"こ"]],"text":"しかし、約束が、信じる人々にイエス・キリストに対する信仰によって与えられるために、聖書はすべての人を罪の下に閉じ込めたのである。"},{"ref":"Gal.3.23","start":48003023,"end":48003023,"break":"paragraph","ruby":[[4,2,"しんこう"],[7,1,"あらわ"],[10,1,"まえ"],[20,2,"りっぽう"],[23,1,"もと"],[25,2,"かんし"],[36,2,"けいじ"],[41,2,"しんこう"],[44,1,"とき"],[47,1,"と"],[49,1,"こ"]],"text":"しかし、信仰が現れる前には、わたしたちは律法の下で監視されており、やがて啓示される信仰の時まで閉じ込められていた。"},{"ref":"Gal.3.24","start":48003024,"end":48003024,"break":"none","ruby":[[7,2,"りっぽう"],[11,2,"しんこう"],[17,1,"ぎ"],[37,1,"つ"],[40,1,"ゆ"],[42,3,"よういくがかり"]],"text":"このようにして律法は、信仰によって義とされるために、わたしたちをキリストに連れて行く養育掛となったのである。"},{"ref":"Gal.3.25","start":48003025,"end":48003025,"break":"none","ruby":[[8,2,"しんこう"],[11,1,"あらわ"],[14,2,"いじょう"],[27,3,"よういくがかり"]],"text":"しかし、いったん信仰が現れた以上、わたしたちは、もはや養育掛のもとにはいない。"},{"ref":"Gal.3.26","start":48003026,"end":48003026,"break":"none","ruby":[[20,2,"しんこう"],[27,1,"かみ"],[29,1,"こ"]],"text":"あなたがたはみな、キリスト・イエスにある信仰によって、神の子なのである。"},{"ref":"Gal.3.27","start":48003027,"end":48003027,"break":"none","ruby":[[5,1,"あ"],[13,1,"う"],[23,1,"みな"],[29,1,"き"]],"text":"キリストに合うバプテスマを受けたあなたがたは、皆キリストを着たのである。"},{"ref":"Gal.3.28","start":48003028,"end":48003028,"break":"none","ruby":[[7,1,"じん"],[13,1,"じん"],[18,2,"どれい"],[21,3,"じゆうじん"],[28,1,"おとこ"],[30,1,"おんな"],[41,1,"みな"]],"text":"もはや、ユダヤ人もギリシヤ人もなく、奴隷も自由人もなく、男も女もない。あなたがたは皆、キリスト・イエスにあって一つだからである。"},{"ref":"Gal.3.29","start":48003029,"end":48003029,"break":"none","ruby":[[27,2,"しそん"],[33,2,"やくそく"],[38,3,"そうぞくにん"]],"text":"もしキリストのものであるなら、あなたがたはアブラハムの子孫であり、約束による相続人なのである。"}]