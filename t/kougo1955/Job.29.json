[{"ref":"Job.29.1","start":18029001,"end":18029001,"break":"paragraph","ruby":[[5,2,"ことば"],[11,1,"い"]],"text":"ヨブはまた言葉をついで言った、"},{"ref":"Job.29.2","start":18029002,"end":18029002,"break":"stanza","breaks":[[22,"line"],[41,"line"]],"ruby":[[3,1,"す"],[6,2,"としつき"],[22,1,"かみ"],[28,1,"まも"],[36,1,"ひ"]],"text":"「ああ過ぎた年月のようであったらよいのだが、神がわたしを守ってくださった日のようであったらよいのだが。"},{"ref":"Job.29.3","start":18029003,"end":18029003,"break":"line","breaks":[[24,"line"]],"ruby":[[2,1,"とき"],[6,1,"かれ"],[17,1,"あたま"],[19,1,"うえ"],[21,1,"かがや"],[24,1,"かれ"],[26,1,"ひかり"],[35,1,"くら"],[39,1,"あゆ"]],"text":"あの時には、彼のともしびがわたしの頭の上に輝き、彼の光によってわたしは暗やみを歩んだ。"},{"ref":"Job.29.4","start":18029004,"end":18029004,"break":"line","breaks":[[23,"line"],[35,"line"]],"ruby":[[4,1,"さか"],[7,1,"とき"],[25,1,"とき"],[29,1,"かみ"],[31,1,"した"],[39,2,"てんまく"],[42,1,"うえ"]],"text":"わたしの盛んな時のようであったならよいのだが。あの時には、神の親しみがわたしの天幕の上にあった。"},{"ref":"Job.29.5","start":18029005,"end":18029005,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"とき"],[6,3,"ぜんのうしゃ"],[16,1,"とも"],[26,2,"こども"],[35,2,"しゅうい"]],"text":"あの時には、全能者がなおわたしと共にいまし、わたしの子供たちもわたしの周囲にいた。"},{"ref":"Job.29.6","start":18029006,"end":18029006,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"とき"],[8,2,"あしあと"],[11,1,"ちち"],[13,1,"あら"],[17,1,"いわ"],[26,1,"あぶら"],[28,1,"なが"],[31,1,"そそ"]],"text":"あの時、わたしの足跡は乳で洗われ、岩もわたしのために油の流れを注ぎだした。"},{"ref":"Job.29.7","start":18029007,"end":18029007,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"とき"],[10,1,"まち"],[12,1,"もん"],[14,1,"で"],[16,1,"い"],[23,1,"ざ"],[25,2,"ひろば"],[28,1,"もう"]],"text":"あの時には、わたしは町の門に出て行き、わたしの座を広場に設けた。"},{"ref":"Job.29.8","start":18029008,"end":18029008,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"わか"],[2,1,"もの"],[8,1,"み"],[15,1,"お"],[18,1,"もの"],[20,1,"み"],[26,1,"た"]],"text":"若い者はわたしを見てしりぞき、老いた者は身をおこして立ち、"},{"ref":"Job.29.9","start":18029009,"end":18029009,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"きみ"],[3,1,"もの"],[5,2,"ものい"],[17,1,"くち"],[19,1,"て"],[21,1,"あ"]],"text":"君たる者も物言うことをやめて、その口に手を当て、"},{"ref":"Job.29.10","start":18029010,"end":18029010,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"たっと"],[2,1,"もの"],[4,1,"こえ"],[13,1,"した"],[15,1,"うえ"]],"text":"尊い者も声をおさめて、その舌を上あごにつけた。"},{"ref":"Job.29.11","start":18029011,"end":18029011,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"みみ"],[2,1,"き"],[5,1,"もの"],[11,2,"しゅくふく"],[16,1,"もの"],[21,1,"め"],[23,1,"み"],[25,1,"もの"]],"text":"耳に聞いた者はわたしを祝福された者となし、目に見た者はこれをあかしした。"},{"ref":"Job.29.12","start":18029012,"end":18029012,"break":"line","breaks":[[17,"line"],[36,"line"]],"ruby":[[3,1,"たす"],[6,1,"もと"],[9,1,"まず"],[12,1,"もの"],[14,1,"すく"],[27,1,"たす"],[30,1,"ひと"],[34,1,"もの"],[36,1,"すく"]],"text":"これは助けを求める貧しい者を救い、また、みなしごおよび助ける人のない者を救ったからである。"},{"ref":"Job.29.13","start":18029013,"end":18029013,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"いま"],[3,1,"ほろ"],[10,1,"もの"],[12,2,"しゅくふく"],[19,1,"き"],[32,1,"こころ"],[36,1,"よろこ"],[38,1,"うた"]],"text":"今にも滅びようとした者の祝福がわたしに来た。わたしはまたやもめの心をして喜び歌わせた。"},{"ref":"Job.29.14","start":18029014,"end":18029014,"break":"line","breaks":[[21,"line"],[35,"line"]],"ruby":[[4,2,"せいぎ"],[7,1,"き"],[9,2,"せいぎ"],[25,2,"こうぎ"],[28,2,"うわぎ"],[37,1,"かんむり"]],"text":"わたしは正義を着、正義はわたしをおおった。わたしの公義は上着のごとく、また冠のようであった。"},{"ref":"Job.29.15","start":18029015,"end":18029015,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"め"],[8,1,"め"],[13,1,"あし"],[17,1,"あし"]],"text":"わたしは目しいの目となり、足なえの足となり、"},{"ref":"Job.29.16","start":18029016,"end":18029016,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[5,1,"ちち"],[10,1,"し"],[14,1,"ひと"],[16,1,"うった"],[19,2,"りゆう"],[22,1,"しら"]],"text":"貧しい者の父となり、知らない人の訴えの理由を調べてやった。"},{"ref":"Job.29.17","start":18029017,"end":18029017,"break":"line","breaks":[[17,"line"]],"ruby":[[6,1,"あ"],[9,1,"もの"],[14,1,"お"],[19,1,"は"],[21,1,"あいだ"],[24,2,"えもの"],[27,1,"ひ"],[29,1,"だ"]],"text":"わたしはまた悪しき者のきばを折り、その歯の間から獲物を引き出した。"},{"ref":"Job.29.18","start":18029018,"end":18029018,"break":"line","breaks":[[12,"line"],[27,"line"]],"ruby":[[2,1,"とき"],[8,1,"い"],[17,2,"じぶん"],[20,1,"す"],[22,1,"なか"],[24,1,"し"],[31,1,"ひ"],[33,1,"すな"],[38,1,"おお"]],"text":"その時、わたしは言った、『わたしは自分の巣の中で死に、わたしの日は砂のように多くなるであろう。"},{"ref":"Job.29.19","start":18029019,"end":18029019,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"ね"],[6,1,"みず"],[17,1,"つゆ"],[19,1,"よ"],[28,1,"えだ"]],"text":"わたしの根は水のほとりにはびこり、露は夜もすがらわたしの枝におくであろう。"},{"ref":"Job.29.20","start":18029020,"end":18029020,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"さか"],[11,1,"とも"],[13,1,"あたら"],[21,1,"ゆみ"],[27,1,"て"],[32,1,"つよ"]],"text":"わたしの栄えはわたしと共に新しく、わたしの弓はわたしの手にいつも強い』と。"},{"ref":"Job.29.21","start":18029021,"end":18029021,"break":"stanza","breaks":[[13,"line"]],"ruby":[[0,2,"ひとびと"],[7,1,"き"],[10,1,"ま"],[13,1,"もく"],[21,1,"おしえ"],[23,1,"したが"]],"text":"人々はわたしに聞いて待ち、黙して、わたしの教に従った。"},{"ref":"Job.29.22","start":18029022,"end":18029022,"break":"line","breaks":[[21,"line"],[33,"line"]],"ruby":[[4,1,"い"],[7,1,"のち"],[9,1,"かれ"],[12,1,"ふたた"],[14,1,"い"],[25,2,"ことば"],[28,1,"かれ"],[31,1,"うえ"],[33,1,"あめ"],[38,1,"ふ"]],"text":"わたしが言った後は彼らは再び言わなかった。わたしの言葉は彼らの上に雨のように降りそそいだ。"},{"ref":"Job.29.23","start":18029023,"end":18029023,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あめ"],[5,1,"ま"],[15,1,"ま"],[17,1,"のぞ"],[20,1,"はる"],[22,1,"あめ"],[24,1,"あお"],[29,1,"くち"],[31,1,"ひら"],[34,1,"あお"]],"text":"彼らは雨を待つように、わたしを待ち望み、春の雨を仰ぐように口を開いて仰いだ。"},{"ref":"Job.29.24","start":18029024,"end":18029024,"break":"line","breaks":[[13,"line"],[30,"line"]],"ruby":[[0,1,"かれ"],[3,2,"きぼう"],[6,1,"うしな"],[9,1,"とき"],[17,1,"かれ"],[30,1,"かれ"],[37,1,"かお"],[39,1,"ひかり"],[41,1,"のぞ"]],"text":"彼らが希望を失った時にも、わたしは彼らにむかってほほえんだ。彼らはわたしの顔の光を除くことができなかった。"},{"ref":"Job.29.25","start":18029025,"end":18029025,"break":"line","breaks":[[15,"line"],[26,"line"],[39,"line"]],"ruby":[[4,1,"かれ"],[10,1,"みち"],[12,1,"えら"],[23,1,"ざ"],[26,2,"ぐんちゅう"],[29,1,"おう"],[39,1,"なげ"],[41,1,"もの"],[43,1,"なぐさ"],[46,1,"ひと"]],"text":"わたしは彼らのために道を選び、そのかしらとして座し、軍中の王のようにしており、嘆く者を慰める人のようであった。"}]