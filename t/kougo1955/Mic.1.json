[{"ref":"Mic.1.1","start":33001001,"end":33001001,"break":"paragraph","ruby":[[3,1,"おう"],[19,1,"よ"],[46,1,"しめ"],[50,1,"しゅ"],[52,2,"ことば"]],"text":"ユダの王ヨタム、アハズおよびヒゼキヤの世に、モレシテびとミカが、サマリヤとエルサレムについて示された主の言葉。"},{"ref":"Mic.1.2","start":33001002,"end":33001002,"break":"stanza","breaks":[[15,"line"],[33,"line"],[52,"line"]],"ruby":[[9,1,"たみ"],[12,1,"き"],[15,1,"ち"],[19,1,"なか"],[21,1,"み"],[24,1,"もの"],[27,1,"みみ"],[29,1,"かたむ"],[33,1,"しゅ"],[36,1,"かみ"],[48,2,"しょうげん"],[52,1,"しゅ"],[56,1,"せい"],[59,1,"みや"],[62,2,"しょうげん"]],"text":"あなたがたすべての民よ、聞け。地とその中に満てる者よ、耳を傾けよ。主なる神はあなたがたにむかって証言し、主はその聖なる宮から証言される。"},{"ref":"Mic.1.3","start":33001003,"end":33001003,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[8,1,"ざ"],[9,1,"しょ"],[12,1,"で"],[18,1,"くだ"],[23,1,"ち"],[25,1,"たか"],[27,1,"ところ"],[29,1,"ふ"]],"text":"見よ、主はそのご座所から出てこられ、下ってきて地の高い所を踏まれる。"},{"ref":"Mic.1.4","start":33001004,"end":33001004,"break":"line","breaks":[[14,"line"],[25,"line"]],"ruby":[[0,1,"やま"],[2,1,"かれ"],[4,1,"した"],[6,1,"と"],[9,1,"たに"],[11,1,"さ"],[14,1,"ひ"],[16,1,"まえ"],[25,1,"さか"],[27,1,"なが"],[30,1,"みず"]],"text":"山は彼の下に溶け、谷は裂け、火の前のろうのごとく、坂に流れる水のようだ。"},{"ref":"Mic.1.5","start":33001005,"end":33001005,"break":"line","breaks":[[15,"line"],[31,"line"],[42,"line"],[52,"line"],[63,"line"]],"ruby":[[21,1,"いえ"],[23,1,"つみ"],[39,1,"なに"],[55,1,"いえ"],[57,1,"つみ"],[60,1,"なに"]],"text":"これはみなヤコブのとがのゆえ、イスラエルの家の罪のゆえである。ヤコブのとがとは何か、サマリヤではないか。ユダの家の罪とは何か、エルサレムではないか。"},{"ref":"Mic.1.6","start":33001006,"end":33001006,"break":"line","breaks":[[22,"line"],[34,"line"],[47,"line"]],"ruby":[[14,1,"の"],[16,2,"いしづか"],[26,1,"う"],[29,1,"ところ"],[38,1,"いし"],[40,1,"たに"],[42,1,"な"],[44,1,"おと"],[49,1,"もとい"]],"text":"このゆえにわたしはサマリヤを野の石塚となし、ぶどうを植える所となし、またその石を谷に投げ落し、その基をあらわにする。"},{"ref":"Mic.1.7","start":33001007,"end":33001007,"break":"line","breaks":[[11,"line"],[26,"line"],[44,"line"],[61,"line"]],"ruby":[[2,2,"ちょうぞう"],[7,1,"くだ"],[13,1,"え"],[15,1,"あたい"],[19,1,"ひ"],[21,1,"や"],[32,2,"ぐうぞう"],[47,2,"ゆうじょ"],[50,1,"あたい"],[53,1,"あつ"],[61,2,"ゆうじょ"],[64,1,"あたい"],[66,1,"かえ"]],"text":"その彫像はみな砕かれ、その獲た価はみな火で焼かれる。わたしはその偶像をことごとくこわす。これは遊女の価から集めたのだから、遊女の価に帰る。"},{"ref":"Mic.1.8","start":33001008,"end":33001008,"break":"line","breaks":[[16,"line"],[28,"line"],[37,"line"]],"ruby":[[10,1,"なげ"],[12,1,"かな"],[20,1,"はだか"],[22,1,"ある"],[28,2,"やまいぬ"],[34,1,"なげ"],[45,1,"かな"],[48,1,"な"]],"text":"わたしはこれがために嘆き悲しみ、はだしと裸で歩きまわり、山犬のように嘆き、だちょうのように悲しみ鳴く。"},{"ref":"Mic.1.9","start":33001009,"end":33001009,"break":"line","breaks":[[21,"line"],[30,"line"]],"ruby":[[5,1,"きず"],[32,1,"たみ"],[34,1,"もん"],[43,1,"およ"]],"text":"サマリヤの傷はいやすことのできないもので、ユダまでひろがり、わが民の門、エルサレムまで及んでいる。"},{"ref":"Mic.1.10","start":33001010,"end":33001010,"break":"stanza","breaks":[[14,"line"]],"ruby":[[3,1,"つ"],[8,1,"な"],[10,1,"さけ"],[25,1,"なか"]],"text":"ガテに告げるな、泣き叫ぶな。ベテレアフラで、ちりの中にころがれ。"},{"ref":"Mic.1.11","start":33001011,"end":33001011,"break":"line","breaks":[[9,"line"],[26,"line"],[41,"line"]],"ruby":[[4,1,"す"],[6,1,"もの"],[9,1,"はだか"],[14,1,"はじ"],[21,1,"すす"],[23,1,"ゆ"],[31,1,"す"],[33,1,"もの"],[35,1,"で"],[47,1,"なげ"],[59,1,"あと"],[61,1,"た"]],"text":"サピルに住む者よ、裸になり、恥をこうむって進み行け。ザアナンに住む者は出てこない。ベテエゼルの嘆きはあなたがたからその跡を断つ。"},{"ref":"Mic.1.12","start":33001012,"end":33001012,"break":"line","breaks":[[21,"line"],[29,"line"]],"ruby":[[4,1,"す"],[6,1,"もの"],[8,1,"き"],[16,1,"さいわい"],[18,1,"ま"],[21,1,"わざわい"],[23,1,"しゅ"],[26,1,"で"],[35,1,"もん"],[37,1,"のぞ"]],"text":"マロテに住む者は気づかわしそうに幸を待つ。災が主から出て、エルサレムの門に臨んだからである。"},{"ref":"Mic.1.13","start":33001013,"end":33001013,"break":"line","breaks":[[9,"line"],[19,"line"],[41,"line"],[51,"line"]],"ruby":[[4,1,"す"],[6,1,"もの"],[9,2,"せんしゃ"],[12,2,"はやうま"],[27,1,"むすめ"],[32,1,"つみ"],[34,1,"はじ"],[60,1,"み"]],"text":"ラキシに住む者よ、戦車に早馬をつなげ。ラキシはシオンの娘にとって罪の初めであった。イスラエルのとがが、あなたがたのうちに見られたからである。"},{"ref":"Mic.1.14","start":33001014,"end":33001014,"break":"line","breaks":[[17,"line"],[28,"line"],[50,"line"]],"ruby":[[17,1,"わか"],[20,1,"おく"],[22,1,"もの"],[24,1,"あた"],[33,2,"いえいえ"],[42,1,"おう"],[50,1,"ひと"],[52,1,"あざむ"]],"text":"それゆえ、あなたはモレセテ・ガテに別れの贈り物を与える。アクジブの家々はイスラエルの王たちにとって、人を欺くものとなる。"},{"ref":"Mic.1.15","start":33001015,"end":33001015,"break":"line","breaks":[[10,"line"],[32,"line"]],"ruby":[[5,1,"す"],[7,1,"もの"],[16,3,"しんりゃくしゃ"],[24,1,"ところ"],[26,1,"つ"],[29,1,"い"],[38,2,"えいこう"],[46,1,"さ"]],"text":"マレシャに住む者よ、わたしはまた侵略者をあなたの所に連れて行く。イスラエルの栄光はアドラムに去るであろう。"},{"ref":"Mic.1.16","start":33001016,"end":33001016,"break":"line","breaks":[[24,"line"],[45,"line"]],"ruby":[[4,1,"よろこ"],[6,1,"こ"],[17,1,"かみ"],[21,1,"おと"],[29,1,"ところ"],[39,1,"おお"],[45,1,"かれ"],[48,1,"とら"],[57,1,"はな"]],"text":"あなたの喜ぶ子らのために、あなたの髪をそり落せ。そのそった所をはげたかのように大きくせよ。彼らは捕えられてあなたを離れるからである。"}]