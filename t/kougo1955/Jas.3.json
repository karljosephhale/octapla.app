[{"ref":"Jas.3.1","start":59003001,"end":59003001,"break":"paragraph","ruby":[[4,2,"きょうだい"],[18,1,"おお"],[21,1,"もの"],[24,2,"きょうし"],[40,2,"きょうし"],[44,1,"た"],[46,1,"ひと"],[64,1,"う"]],"text":"わたしの兄弟たちよ。あなたがたのうち多くの者は、教師にならないがよい。わたしたち教師が、他の人たちよりも、もっときびしいさばきを受けることが、よくわかっているからである。"},{"ref":"Jas.3.2","start":59003002,"end":59003002,"break":"none","ruby":[[6,1,"みな"],[8,1,"おお"],[16,1,"おか"],[27,2,"ことば"],[30,1,"うえ"],[39,1,"ひと"],[49,1,"ひと"],[52,2,"ぜんしん"],[56,1,"せい"],[57,1,"ぎょ"],[66,2,"かんぜん"],[69,1,"ひと"]],"text":"わたしたちは皆、多くのあやまちを犯すものである。もし、言葉の上であやまちのない人があれば、そういう人は、全身をも制御することのできる完全な人である。"},{"ref":"Jas.3.3","start":59003003,"end":59003003,"break":"none","ruby":[[0,1,"うま"],[2,1,"ぎょ"],[11,1,"くち"],[25,2,"ぜんしん"],[28,1,"ひ"]],"text":"馬を御するために、その口にくつわをはめるなら、その全身を引きまわすことができる。"},{"ref":"Jas.3.4","start":59003004,"end":59003004,"break":"none","ruby":[[2,1,"ふね"],[4,1,"み"],[10,2,"せんたい"],[13,2,"ひじょう"],[16,1,"おお"],[22,1,"はげ"],[25,1,"かぜ"],[27,1,"ふ"],[38,1,"ちい"],[47,3,"そうじゅうしゃ"],[51,1,"おも"],[57,2,"うんてん"]],"text":"また船を見るがよい。船体が非常に大きく、また激しい風に吹きまくられても、ごく小さなかじ一つで、操縦者の思いのままに運転される。"},{"ref":"Jas.3.5","start":59003005,"end":59003005,"break":"none","ruby":[[3,1,"おな"],[7,1,"した"],[9,1,"ちい"],[12,2,"きかん"],[22,4,"たいげんそうご"],[29,1,"み"],[34,1,"ちい"],[37,1,"ひ"],[41,2,"ひじょう"],[44,1,"おお"],[47,1,"もり"],[49,1,"も"]],"text":"それと同じく、舌は小さな器官ではあるが、よく大言壮語する。見よ、ごく小さな火でも、非常に大きな森を燃やすではないか。"},{"ref":"Jas.3.6","start":59003006,"end":59003006,"break":"none","ruby":[[0,1,"した"],[2,1,"ひ"],[7,2,"ふぎ"],[10,2,"せかい"],[16,1,"した"],[25,2,"きかん"],[46,2,"ぜんしん"],[49,1,"けが"],[52,2,"せいぞん"],[55,2,"しゃりん"],[58,1,"も"],[62,1,"みずか"],[65,2,"じごく"],[68,1,"ひ"],[70,1,"や"]],"text":"舌は火である。不義の世界である。舌は、わたしたちの器官の一つとしてそなえられたものであるが、全身を汚し、生存の車輪を燃やし、自らは地獄の火で焼かれる。"},{"ref":"Jas.3.7","start":59003007,"end":59003007,"break":"none","ruby":[[4,2,"しゅるい"],[7,1,"けもの"],[9,1,"とり"],[11,1,"は"],[16,1,"うみ"],[18,2,"せいぶつ"],[25,2,"じんるい"],[28,1,"せい"],[37,1,"せい"]],"text":"あらゆる種類の獣、鳥、這うもの、海の生物は、すべて人類に制せられるし、また制せられてきた。"},{"ref":"Jas.3.8","start":59003008,"end":59003008,"break":"none","ruby":[[5,1,"した"],[7,1,"せい"],[11,1,"ひと"],[26,1,"せい"],[31,1,"あく"],[37,1,"し"],[39,1,"どく"],[41,1,"み"]],"text":"ところが、舌を制しうる人は、ひとりもいない。それは、制しにくい悪であって、死の毒に満ちている。"},{"ref":"Jas.3.9","start":59003009,"end":59003009,"break":"none","ruby":[[9,1,"した"],[11,1,"ちち"],[14,1,"しゅ"],[26,1,"おな"],[28,1,"した"],[31,1,"かみ"],[38,1,"つく"],[42,2,"にんげん"]],"text":"わたしたちは、この舌で父なる主をさんびし、また、その同じ舌で、神にかたどって造られた人間をのろっている。"},{"ref":"Jas.3.10","start":59003010,"end":59003010,"break":"none","ruby":[[0,1,"おな"],[2,1,"くち"],[15,1,"で"],[17,1,"く"],[24,2,"きょうだい"],[35,1,"こと"]],"text":"同じ口から、さんびとのろいとが出て来る。わたしの兄弟たちよ。このような事は、あるべきでない。"},{"ref":"Jas.3.11","start":59003011,"end":59003011,"break":"none","ruby":[[0,1,"いずみ"],[3,1,"あま"],[5,1,"みず"],[7,1,"にが"],[9,1,"みず"],[13,1,"おな"],[15,1,"あな"],[20,1,"だ"]],"text":"泉が、甘い水と苦い水とを、同じ穴からふき出すことがあろうか。"},{"ref":"Jas.3.12","start":59003012,"end":59003012,"break":"none","ruby":[[4,2,"きょうだい"],[15,1,"き"],[21,1,"み"],[23,1,"むす"],[30,1,"き"],[37,1,"み"],[39,1,"むす"],[50,2,"しおみず"],[54,1,"あま"],[56,1,"みず"],[58,1,"だ"]],"text":"わたしの兄弟たちよ。いちじくの木がオリブの実を結び、ぶどうの木がいちじくの実を結ぶことができようか。塩水も、甘い水を出すことはできない。"},{"ref":"Jas.3.13","start":59003013,"end":59003013,"break":"paragraph","ruby":[[10,2,"ちえ"],[15,1,"もの"],[22,1,"ひと"],[34,1,"ひと"],[37,2,"ちえ"],[43,2,"にゅうわ"],[46,1,"おこな"],[59,2,"せいかつ"],[65,1,"しめ"]],"text":"あなたがたのうちで、知恵があり物わかりのよい人は、だれであるか。その人は、知恵にかなう柔和な行いをしていることを、よい生活によって示すがよい。"},{"ref":"Jas.3.14","start":59003014,"end":59003014,"break":"none","ruby":[[12,1,"こころ"],[14,1,"なか"],[17,2,"にがにが"],[25,3,"とうはしん"],[39,1,"ほこ"],[41,1,"たか"],[54,2,"しんり"],[61,1,"いつわ"]],"text":"しかし、もしあなたがたの心の中に、苦々しいねたみや党派心をいだいているのなら、誇り高ぶってはならない。また、真理にそむいて偽ってはならない。"},{"ref":"Jas.3.15","start":59003015,"end":59003015,"break":"none","ruby":[[5,2,"ちえ"],[9,1,"うえ"],[12,1,"くだ"],[25,1,"ち"],[32,1,"にく"],[34,1,"ぞく"],[40,2,"あくま"],[42,1,"てき"]],"text":"そのような知恵は、上から下ってきたものではなくて、地につくもの、肉に属するもの、悪魔的なものである。"},{"ref":"Jas.3.16","start":59003016,"end":59003016,"break":"none","ruby":[[4,3,"とうはしん"],[17,2,"こんらん"],[24,1,"い"],[28,2,"こうい"]],"text":"ねたみと党派心とのあるところには、混乱とあらゆる忌むべき行為とがある。"},{"ref":"Jas.3.17","start":59003017,"end":59003017,"break":"none","ruby":[[3,1,"うえ"],[7,2,"ちえ"],[11,1,"だい"],[14,1,"きよ"],[17,1,"つぎ"],[19,2,"へいわ"],[22,2,"かんよう"],[25,2,"おんじゅん"],[36,1,"よ"],[38,1,"み"],[41,1,"み"],[48,1,"み"],[51,1,"いつわ"]],"text":"しかし上からの知恵は、第一に清く、次に平和、寛容、温順であり、あわれみと良い実とに満ち、かたより見ず、偽りがない。"},{"ref":"Jas.3.18","start":59003018,"end":59003018,"break":"none","ruby":[[0,1,"ぎ"],[2,1,"み"],[5,2,"へいわ"],[8,1,"つく"],[10,1,"りだ"],[12,1,"ひと"],[20,2,"へいわ"]],"text":"義の実は、平和を造り出す人たちによって、平和のうちにまかれるものである。"}]