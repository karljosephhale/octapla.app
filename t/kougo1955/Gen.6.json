[{"ref":"Gen.6.1","start":1006001,"end":1006001,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"ち"],[10,1,"はじ"],[14,1,"むすめ"],[18,1,"かれ"],[21,1,"うま"],[24,1,"とき"]],"text":"人が地のおもてにふえ始めて、娘たちが彼らに生れた時、"},{"ref":"Gen.6.2","start":1006002,"end":1006002,"break":"none","ruby":[[0,1,"かみ"],[2,1,"こ"],[6,1,"ひと"],[8,1,"むすめ"],[12,1,"うつく"],[17,1,"み"],[20,2,"じぶん"],[23,1,"この"],[25,1,"もの"],[27,1,"つま"]],"text":"神の子たちは人の娘たちの美しいのを見て、自分の好む者を妻にめとった。"},{"ref":"Gen.6.3","start":1006003,"end":1006003,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"い"],[15,1,"れい"],[20,1,"ひと"],[22,1,"なか"],[31,1,"かれ"],[33,1,"にく"],[46,1,"かれ"],[48,1,"とし"],[53,1,"ねん"]],"text":"そこで主は言われた、「わたしの霊はながく人の中にとどまらない。彼は肉にすぎないのだ。しかし、彼の年は百二十年であろう」。"},{"ref":"Gen.6.4","start":1006004,"end":1006004,"break":"none","ruby":[[9,1,"のち"],[13,1,"ち"],[26,1,"かみ"],[28,1,"こ"],[32,1,"ひと"],[34,1,"むすめ"],[47,1,"むすめ"],[51,1,"う"],[61,1,"かれ"],[64,1,"むかし"],[66,2,"ゆうし"],[72,2,"ゆうめい"],[75,2,"ひとびと"]],"text":"そのころ、またその後にも、地にネピリムがいた。これは神の子たちが人の娘たちのところにはいって、娘たちに産ませたものである。彼らは昔の勇士であり、有名な人々であった。"},{"ref":"Gen.6.5","start":1006005,"end":1006005,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"ひと"],[4,1,"あく"],[6,1,"ち"],[18,1,"こころ"],[20,1,"おも"],[32,1,"わる"],[34,1,"こと"],[43,1,"み"]],"text":"主は人の悪が地にはびこり、すべてその心に思いはかることが、いつも悪い事ばかりであるのを見られた。"},{"ref":"Gen.6.6","start":1006006,"end":1006006,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"ち"],[4,1,"うえ"],[6,1,"ひと"],[8,1,"つく"],[13,1,"く"],[17,1,"こころ"],[19,1,"いた"]],"text":"主は地の上に人を造ったのを悔いて、心を痛め、"},{"ref":"Gen.6.7","start":1006007,"end":1006007,"break":"none","ruby":[[5,2,"そうぞう"],[9,1,"ひと"],[11,1,"ち"],[21,1,"さ"],[25,1,"ひと"],[27,1,"けもの"],[30,1,"は"],[36,1,"そら"],[38,1,"とり"],[52,1,"つく"],[58,1,"く"],[63,1,"い"]],"text":"「わたしが創造した人を地のおもてからぬぐい去ろう。人も獣も、這うものも、空の鳥までも。わたしは、これらを造ったことを悔いる」と言われた。"},{"ref":"Gen.6.8","start":1006008,"end":1006008,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"まえ"],[11,1,"めぐ"],[14,1,"え"]],"text":"しかし、ノアは主の前に恵みを得た。"},{"ref":"Gen.6.9","start":1006009,"end":1006009,"break":"paragraph","ruby":[[3,2,"けいず"],[6,1,"つぎ"],[20,2,"じだい"],[23,2,"ひとびと"],[26,1,"なか"],[28,1,"ただ"],[34,1,"まった"],[36,1,"ひと"],[45,1,"かみ"],[50,1,"あゆ"]],"text":"ノアの系図は次のとおりである。ノアはその時代の人々の中で正しく、かつ全き人であった。ノアは神とともに歩んだ。"},{"ref":"Gen.6.10","start":1006010,"end":1006010,"break":"none","ruby":[[14,1,"にん"],[16,1,"こ"],[18,1,"う"]],"text":"ノアはセム、ハム、ヤペテの三人の子を生んだ。"},{"ref":"Gen.6.11","start":1006011,"end":1006011,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"よ"],[4,1,"かみ"],[6,1,"まえ"],[8,1,"みだ"],[12,2,"ぼうぎゃく"],[15,1,"ち"],[17,1,"み"]],"text":"時に世は神の前に乱れて、暴虐が地に満ちた。"},{"ref":"Gen.6.12","start":1006012,"end":1006012,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ち"],[4,1,"み"],[13,1,"みだ"],[23,1,"ひと"],[25,1,"ち"],[27,1,"うえ"],[31,1,"みち"],[33,1,"みだ"]],"text":"神が地を見られると、それは乱れていた。すべての人が地の上でその道を乱したからである。"},{"ref":"Gen.6.13","start":1006013,"end":1006013,"break":"none","ruby":[[3,1,"かみ"],[8,1,"い"],[23,1,"ひと"],[25,1,"た"],[30,2,"けっしん"],[35,1,"かれ"],[38,1,"ち"],[40,2,"ぼうぎゃく"],[43,1,"み"],[54,1,"かれ"],[57,1,"ち"],[62,1,"ほろ"]],"text":"そこで神はノアに言われた、「わたしは、すべての人を絶やそうと決心した。彼らは地を暴虐で満たしたから、わたしは彼らを地とともに滅ぼそう。"},{"ref":"Gen.6.14","start":1006014,"end":1006014,"break":"none","ruby":[[10,1,"き"],[12,2,"はこぶね"],[15,1,"つく"],[18,2,"はこぶね"],[21,1,"なか"],[26,1,"もう"],[43,1,"ぬ"]],"text":"あなたは、いとすぎの木で箱舟を造り、箱舟の中にへやを設け、アスファルトでそのうちそとを塗りなさい。"},{"ref":"Gen.6.15","start":1006015,"end":1006015,"break":"none","ruby":[[2,1,"つく"],[4,1,"かた"],[6,1,"つぎ"],[19,2,"はこぶね"],[22,1,"なが"],[32,1,"はば"],[41,1,"たか"]],"text":"その造り方は次のとおりである。すなわち箱舟の長さは三百キュビト、幅は五十キュビト、高さは三十キュビトとし、"},{"ref":"Gen.6.16","start":1006016,"end":1006016,"break":"none","ruby":[[0,2,"はこぶね"],[3,2,"やね"],[6,1,"つく"],[9,1,"うえ"],[20,2,"しあ"],[26,2,"はこぶね"],[29,2,"とぐち"],[34,1,"よこ"],[36,1,"もう"],[41,1,"かい"],[44,1,"かい"],[47,1,"かい"],[51,2,"はこぶね"],[54,1,"つく"]],"text":"箱舟に屋根を造り、上へ一キュビトにそれを仕上げ、また箱舟の戸口をその横に設けて、一階と二階と三階のある箱舟を造りなさい。"},{"ref":"Gen.6.17","start":1006017,"end":1006017,"break":"none","ruby":[[4,1,"ち"],[6,1,"うえ"],[8,2,"こうずい"],[11,1,"おく"],[15,1,"いのち"],[17,1,"いき"],[21,1,"にく"],[30,1,"てん"],[32,1,"した"],[35,1,"ほろ"],[38,1,"さ"],[41,1,"ち"],[51,1,"し"],[53,1,"た"]],"text":"わたしは地の上に洪水を送って、命の息のある肉なるものを、みな天の下から滅ぼし去る。地にあるものは、みな死に絶えるであろう。"},{"ref":"Gen.6.18","start":1006018,"end":1006018,"break":"none","ruby":[[12,2,"けいやく"],[15,2,"むすぼ"],[23,1,"こ"],[27,1,"つま"],[30,1,"こ"],[33,1,"つま"],[37,1,"とも"],[39,2,"はこぶね"]],"text":"ただし、わたしはあなたと契約を結ぼう。あなたは子らと、妻と、子らの妻たちと共に箱舟にはいりなさい。"},{"ref":"Gen.6.19","start":1006019,"end":1006019,"break":"none","ruby":[[6,1,"い"],[8,1,"もの"],[14,1,"にく"],[20,1,"なか"],[33,2,"はこぶね"],[36,1,"い"],[44,1,"とも"],[48,1,"いのち"],[50,1,"たも"],[61,1,"おす"],[63,1,"めす"]],"text":"またすべての生き物、すべての肉なるものの中から、それぞれ二つずつを箱舟に入れて、あなたと共にその命を保たせなさい。それらは雄と雌とでなければならない。"},{"ref":"Gen.6.20","start":1006020,"end":1006020,"break":"none","ruby":[[5,1,"とり"],[9,2,"しゅるい"],[16,1,"けもの"],[20,2,"しゅるい"],[30,1,"ち"],[36,1,"は"],[44,2,"しゅるい"],[70,1,"い"],[74,1,"いのち"],[76,1,"たも"]],"text":"すなわち、鳥はその種類にしたがい獣はその種類にしたがい、また地のすべての這うものも、その種類にしたがって、それぞれ二つずつ、あなたのところに入れて、命を保たせなさい。"},{"ref":"Gen.6.21","start":1006021,"end":1006021,"break":"none","ruby":[[7,2,"しょくもつ"],[44,2,"しょくもつ"]],"text":"また、すべての食物となるものをとって、あなたのところにたくわえ、あなたとこれらのものとの食物としなさい」。"},{"ref":"Gen.6.22","start":1006022,"end":1006022,"break":"none","ruby":[[6,1,"かみ"],[8,1,"めい"]],"text":"ノアはすべて神の命じられたようにした。"}]