[{"ref":"Jas.4.1","start":59004001,"end":59004001,"break":"paragraph","ruby":[[6,1,"なか"],[8,1,"たたか"],[11,1,"あらそ"],[24,1,"おこ"],[45,2,"したい"],[48,1,"なか"],[50,2,"あいたたか"],[53,2,"よくじょう"]],"text":"あなたがたの中の戦いや争いは、いったい、どこから起るのか。それはほかではない。あなたがたの肢体の中で相戦う欲情からではないか。"},{"ref":"Jas.4.2","start":59004002,"end":59004002,"break":"none","ruby":[[12,1,"え"],[21,2,"ひとごろ"],[28,2,"ねつぼう"],[33,1,"て"],[35,1,"い"],[49,1,"あらそ"],[51,1,"たたか"],[61,1,"もと"],[67,1,"え"]],"text":"あなたがたは、むさぼるが得られない。そこで人殺しをする。熱望するが手に入れることができない。そこで争い戦う。あなたがたは、求めないから得られないのだ。"},{"ref":"Jas.4.3","start":59004003,"end":59004003,"break":"none","ruby":[[0,1,"もと"],[4,1,"あた"],[13,2,"かいらく"],[19,1,"つか"],[26,1,"わる"],[28,1,"もと"],[30,1,"ほう"]],"text":"求めても与えられないのは、快楽のために使おうとして、悪い求め方をするからだ。"},{"ref":"Jas.4.4","start":59004004,"end":59004004,"break":"none","ruby":[[0,2,"ふてい"],[8,1,"よ"],[10,1,"とも"],[17,1,"かみ"],[20,2,"てきたい"],[29,1,"し"],[39,1,"よ"],[41,1,"とも"],[47,1,"おも"],[49,1,"もの"],[52,1,"みずか"],[55,1,"かみ"],[57,1,"てき"]],"text":"不貞のやからよ。世を友とするのは、神への敵対であることを、知らないか。おおよそ世の友となろうと思う者は、自らを神の敵とするのである。"},{"ref":"Jas.4.5","start":59004005,"end":59004005,"break":"none","ruby":[[6,1,"かみ"],[15,1,"うち"],[17,1,"す"],[22,1,"れい"],[31,1,"あい"],[40,2,"せいしょ"],[43,1,"か"],[55,2,"ことば"],[59,1,"おも"]],"text":"それとも、「神は、わたしたちの内に住まわせた霊を、ねたむほどに愛しておられる」と聖書に書いてあるのは、むなしい言葉だと思うのか。"},{"ref":"Jas.4.6","start":59004006,"end":59004006,"break":"none","ruby":[[3,1,"かみ"],[8,1,"ま"],[11,1,"めぐ"],[14,1,"たま"],[24,1,"かみ"],[26,1,"たか"],[29,1,"もの"],[41,1,"もの"],[43,1,"めぐ"],[46,1,"たま"]],"text":"しかし神は、いや増しに恵みを賜う。であるから、「神は高ぶる者をしりぞけ、へりくだる者に恵みを賜う」とある。"},{"ref":"Jas.4.7","start":59004007,"end":59004007,"break":"none","ruby":[[10,1,"かみ"],[12,1,"したが"],[22,2,"あくま"],[25,1,"た"],[40,1,"かれ"],[49,1,"に"],[51,1,"さ"]],"text":"そういうわけだから、神に従いなさい。そして、悪魔に立ちむかいなさい。そうすれば、彼はあなたがたから逃げ去るであろう。"},{"ref":"Jas.4.8","start":59004008,"end":59004008,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ちか"],[15,1,"かみ"],[23,1,"ちか"],[27,1,"くだ"],[35,2,"つみびと"],[41,1,"て"],[48,2,"ふたごころ"],[51,1,"もの"],[56,1,"こころ"],[58,1,"きよ"]],"text":"神に近づきなさい。そうすれば、神はあなたがたに近づいて下さるであろう。罪人どもよ、手をきよめよ。二心の者どもよ、心を清くせよ。"},{"ref":"Jas.4.9","start":59004009,"end":59004009,"break":"none","ruby":[[0,1,"くる"],[4,1,"かな"],[8,1,"な"],[17,1,"わら"],[20,1,"かな"],[25,1,"よろこ"],[28,1,"うれ"],[31,1,"か"]],"text":"苦しめ、悲しめ、泣け。あなたがたの笑いを悲しみに、喜びを憂いに変えよ。"},{"ref":"Jas.4.10","start":59004010,"end":59004010,"break":"none","ruby":[[0,1,"しゅ"],[18,1,"しゅ"],[27,1,"たか"],[31,1,"くだ"]],"text":"主のみまえにへりくだれ。そうすれば、主は、あなたがたを高くして下さるであろう。"},{"ref":"Jas.4.11","start":59004011,"end":59004011,"break":"paragraph","ruby":[[0,2,"きょうだい"],[6,1,"たがい"],[8,2,"わるぐち"],[11,1,"い"],[13,1,"あ"],[22,2,"きょうだい"],[25,2,"わるぐち"],[28,1,"い"],[33,2,"じぶん"],[36,2,"きょうだい"],[46,1,"もの"],[49,2,"りっぽう"],[56,2,"りっぽう"],[75,2,"りっぽう"],[84,2,"りっぽう"],[87,2,"じっこう"],[89,1,"もの"],[98,3,"しんぱんしゃ"]],"text":"兄弟たちよ。互に悪口を言い合ってはならない。兄弟の悪口を言ったり、自分の兄弟をさばいたりする者は、律法をそしり、律法をさばくやからである。もしあなたが律法をさばくなら、律法の実行者ではなくて、その審判者なのである。"},{"ref":"Jas.4.12","start":59004012,"end":59004012,"break":"none","ruby":[[4,2,"りっぽう"],[6,1,"しゃ"],[10,3,"しんぱんしゃ"],[30,1,"すく"],[35,1,"ほろ"],[54,1,"とな"],[56,1,"ひと"],[71,2,"なにもの"]],"text":"しかし、立法者であり審判者であるかたは、ただひとりであって、救うことも滅ぼすこともできるのである。しかるに、隣り人をさばくあなたは、いったい、何者であるか。"},{"ref":"Jas.4.13","start":59004013,"end":59004013,"break":"paragraph","ruby":[[2,1,"き"],[22,1,"まち"],[24,1,"い"],[32,1,"ねん"],[33,2,"たいざい"],[37,2,"しょうばい"],[42,1,"ひと"],[51,1,"い"],[53,1,"もの"]],"text":"よく聞きなさい。「きょうか、あす、これこれの町へ行き、そこに一か年滞在し、商売をして一もうけしよう」と言う者たちよ。"},{"ref":"Jas.4.14","start":59004014,"end":59004014,"break":"none","ruby":[[17,1,"み"],[54,1,"あいだ"],[65,1,"き"],[67,1,"い"],[69,1,"きり"]],"text":"あなたがたは、あすのこともわからぬ身なのだ。あなたがたのいのちは、どんなものであるか。あなたがたは、しばしの間あらわれて、たちまち消え行く霧にすぎない。"},{"ref":"Jas.4.15","start":59004015,"end":59004015,"break":"none","ruby":[[11,1,"しゅ"],[26,1,"い"],[37,1,"こと"],[40,1,"こと"],[47,1,"い"]],"text":"むしろ、あなたがたは「主のみこころであれば、わたしは生きながらえもし、あの事この事もしよう」と言うべきである。"},{"ref":"Jas.4.16","start":59004016,"end":59004016,"break":"none","ruby":[[11,1,"ほこ"],[13,1,"たか"],[25,2,"こうまん"],[32,1,"あく"]],"text":"ところが、あなたがたは誇り高ぶっている。このような高慢は、すべて悪である。"},{"ref":"Jas.4.17","start":59004017,"end":59004017,"break":"none","ruby":[[0,1,"ひと"],[7,1,"ぜん"],[9,1,"し"],[14,1,"おこな"],[24,1,"かれ"],[29,1,"つみ"]],"text":"人が、なすべき善を知りながら行わなければ、それは彼にとって罪である。"}]