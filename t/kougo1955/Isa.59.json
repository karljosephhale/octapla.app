[{"ref":"Isa.59.1","start":23059001,"end":23059001,"break":"paragraph","breaks":[[11,"line"],[22,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,1,"て"],[7,1,"みじか"],[11,1,"すく"],[13,1,"え"],[24,1,"みみ"],[26,1,"にぶ"],[29,1,"き"],[31,1,"え"]],"text":"見よ、主の手が短くて、救い得ないのではない。その耳が鈍くて聞き得ないのでもない。"},{"ref":"Isa.59.2","start":23059002,"end":23059002,"break":"line","breaks":[[12,"line"],[36,"line"],[46,"line"]],"ruby":[[9,2,"ふぎ"],[25,1,"かみ"],[28,1,"あいだ"],[30,1,"へだ"],[44,1,"つみ"],[46,1,"しゅ"],[48,1,"かお"],[59,1,"き"]],"text":"ただ、あなたがたの不義があなたがたと、あなたがたの神との間を隔てたのだ。またあなたがたの罪が主の顔をおおったために、お聞きにならないのだ。"},{"ref":"Isa.59.3","start":23059003,"end":23059003,"break":"line","breaks":[[13,"line"],[27,"line"],[44,"line"]],"ruby":[[6,1,"て"],[8,1,"ち"],[10,1,"けが"],[19,1,"ゆび"],[21,2,"ふぎ"],[24,1,"けが"],[38,1,"いつわ"],[41,1,"かた"],[50,1,"した"],[52,1,"あく"]],"text":"あなたがたの手は血で汚れ、あなたがたの指は不義で汚れ、あなたがたのくちびるは偽りを語り、あなたがたの舌は悪をささやき、"},{"ref":"Isa.59.4","start":23059004,"end":23059004,"break":"line","breaks":[[13,"line"],[28,"line"],[47,"line"]],"ruby":[[4,2,"せいぎ"],[10,1,"うった"],[13,2,"しんじつ"],[19,2,"ろんそう"],[23,1,"もの"],[28,1,"かれ"],[38,1,"たの"],[41,1,"いつわ"],[44,1,"かた"],[47,2,"がいあく"],[54,2,"ふぎ"],[57,1,"う"]],"text":"ひとりも正義をもって訴え、真実をもって論争する者がない。彼らはむなしきことを頼み、偽りを語り、害悪をはらみ、不義を産む。"},{"ref":"Isa.59.5","start":23059005,"end":23059005,"break":"line","breaks":[[21,"line"],[33,"line"]],"ruby":[[0,1,"かれ"],[7,1,"たまご"],[16,1,"す"],[18,1,"お"],[23,1,"たまご"],[25,1,"た"],[28,1,"もの"],[30,1,"し"],[33,1,"たまご"],[35,1,"ふ"],[40,1,"やぶ"],[43,2,"どくへび"],[46,1,"だ"]],"text":"彼らはまむしの卵をかえし、くもの巣を織る。その卵を食べる者は死ぬ。卵が踏まれると破れて毒蛇を出す。"},{"ref":"Isa.59.6","start":23059006,"end":23059006,"break":"line","breaks":[[14,"line"],[36,"line"],[50,"line"]],"ruby":[[2,1,"お"],[4,1,"もの"],[6,2,"きもの"],[16,1,"つく"],[18,1,"もの"],[23,1,"み"],[36,1,"かれ"],[41,2,"ふぎ"],[50,1,"かれ"],[53,1,"て"],[56,2,"ぼうぎゃく"],[59,1,"おこな"]],"text":"その織る物は着物とならない。その造る物をもって身をおおうことができない。彼のわざは不義のわざであり、彼らの手には暴虐の行いがある。"},{"ref":"Isa.59.7","start":23059007,"end":23059007,"break":"line","breaks":[[10,"line"],[24,"line"],[39,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あし"],[5,1,"あく"],[7,1,"はし"],[10,1,"つみ"],[14,1,"ち"],[16,1,"なが"],[21,1,"はや"],[24,1,"かれ"],[27,1,"おも"],[30,2,"ふぎ"],[33,1,"おも"],[39,2,"こうはい"],[42,2,"めつぼう"],[48,1,"みち"]],"text":"彼らの足は悪に走り、罪のない血を流すことに速い。彼らの思いは不義の思いであり、荒廃と滅亡とがその道にある。"},{"ref":"Isa.59.8","start":23059008,"end":23059008,"break":"line","breaks":[[12,"line"],[25,"line"],[36,"line"]],"ruby":[[0,1,"かれ"],[3,2,"へいわ"],[6,1,"みち"],[8,1,"し"],[14,1,"ゆ"],[16,1,"みち"],[19,2,"こうへい"],[25,1,"かれ"],[30,1,"みち"],[32,1,"ま"],[42,1,"あゆ"],[44,1,"もの"],[46,2,"へいわ"],[49,1,"し"]],"text":"彼らは平和の道を知らず、その行く道には公平がない。彼らはその道を曲げた。すべてこれを歩む者は平和を知らない。"},{"ref":"Isa.59.9","start":23059009,"end":23059009,"break":"paragraph","breaks":[[18,"line"],[33,"line"],[50,"line"]],"ruby":[[5,2,"こうへい"],[8,1,"とお"],[15,1,"はな"],[18,2,"せいぎ"],[26,1,"お"],[38,1,"ひかり"],[40,1,"のぞ"],[45,1,"くら"],[48,1,"み"],[50,1,"かがや"],[53,1,"のぞ"],[61,1,"い"]],"text":"それゆえ、公平は遠くわれわれを離れ、正義はわれわれに追いつかない。われわれは光を望んでも、暗きを見、輝きを望んでも、やみを行く。"},{"ref":"Isa.59.10","start":23059010,"end":23059010,"break":"line","breaks":[[22,"line"],[38,"line"],[56,"line"]],"ruby":[[5,2,"もうじん"],[15,1,"て"],[22,1,"め"],[26,1,"もの"],[31,1,"て"],[38,2,"まひる"],[56,2,"きょうそう"],[59,1,"もの"],[61,1,"なか"],[67,2,"しにん"]],"text":"われわれは盲人のように、かきを手さぐりゆき、目のない者のように手さぐりゆき、真昼でも、たそがれのようにつまずき、強壮な者の中にあっても死人のようだ。"},{"ref":"Isa.59.11","start":23059011,"end":23059011,"break":"line","breaks":[[15,"line"],[28,"line"],[41,"line"]],"ruby":[[5,1,"みな"],[28,2,"こうへい"],[31,1,"のぞ"],[41,1,"すくい"],[43,1,"のぞ"],[48,1,"とお"],[55,1,"はな"],[57,1,"さ"]],"text":"われわれは皆くまのようにほえ、はとのようにいたくうめき、公平を望んでも、きたらず、救を望んでも、遠くわれわれを離れ去る。"},{"ref":"Isa.59.12","start":23059012,"end":23059012,"break":"paragraph","breaks":[[18,"line"],[37,"line"],[51,"line"]],"ruby":[[13,1,"まえ"],[15,1,"おお"],[18,1,"つみ"],[26,1,"うった"],[46,1,"とも"],[51,2,"ふぎ"],[63,1,"し"]],"text":"われわれのとがは、あなたの前に多く、罪は、われわれを訴えて、あかしをなし、とがは、われわれと共にあり、不義は、われわれがこれを知る。"},{"ref":"Isa.59.13","start":23059013,"end":23059013,"break":"line","breaks":[[16,"line"],[31,"line"],[45,"line"]],"ruby":[[10,1,"しゅ"],[16,1,"しりぞ"],[25,1,"かみ"],[27,1,"したが"],[42,1,"かた"],[45,1,"いつわ"],[48,2,"ことば"],[51,1,"こころ"],[61,1,"い"]],"text":"われわれは、そむいて主をいなみ、退いて、われわれの神に従わず、しえたげと、そむきとを語り、偽りの言葉を心にはらんで、それを言いあらわす。"},{"ref":"Isa.59.14","start":23059014,"end":23059014,"break":"line","breaks":[[12,"line"],[22,"line"],[35,"line"]],"ruby":[[0,2,"こうへい"],[7,1,"しりぞ"],[12,2,"せいぎ"],[19,1,"た"],[26,2,"しんじつ"],[29,2,"ひろば"],[32,1,"たお"],[35,2,"しょうじき"]],"text":"公平はうしろに退けられ、正義ははるかに立つ。それは、真実は広場に倒れ、正直は、はいることができないからである。"},{"ref":"Isa.59.15","start":23059015,"end":23059015,"break":"line","breaks":[[9,"line"],[24,"paragraph"],[32,"line"]],"ruby":[[0,2,"しんじつ"],[3,1,"か"],[9,1,"あく"],[11,1,"はな"],[14,1,"もの"],[19,1,"うば"],[24,1,"しゅ"],[29,1,"み"],[32,2,"こうへい"],[42,1,"よろこ"]],"text":"真実は欠けてなく、悪を離れる者はかすめ奪われる。主はこれを見て、公平がなかったことを喜ばれなかった。"},{"ref":"Isa.59.16","start":23059016,"end":23059016,"break":"line","breaks":[[12,"line"],[29,"line"],[51,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ひと"],[8,1,"み"],[12,1,"なか"],[14,1,"た"],[16,1,"もの"],[35,2,"じぶん"],[46,2,"しょうり"],[49,1,"え"],[53,1,"ぎ"]],"text":"主は人のないのを見られ、仲に立つ者のないのをあやしまれた。それゆえ、ご自分のかいなをもって、勝利を得、その義をもって、おのれをささえられた。"},{"ref":"Isa.59.17","start":23059017,"end":23059017,"break":"line","breaks":[[13,"line"],[28,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ぎ"],[4,2,"むねあて"],[13,1,"すくい"],[21,1,"あたま"],[28,2,"ほうふく"],[31,1,"ころも"],[37,2,"きもの"],[42,2,"ねっしん"],[45,2,"がいとう"],[50,1,"み"],[52,1,"つつ"]],"text":"主は義を胸当としてまとい、救のかぶとをその頭にいただき、報復の衣をまとって着物とし、熱心を外套として身を包まれた。"},{"ref":"Isa.59.18","start":23059018,"end":23059018,"break":"line","breaks":[[19,"line"],[29,"line"],[41,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"おこな"],[13,1,"むく"],[26,1,"いか"],[29,1,"てき"],[35,1,"むく"],[41,2,"うみぞ"],[45,2,"くにぐに"],[52,1,"むく"]],"text":"主は彼らの行いにしたがって報いをなし、あだにむかって怒り、敵にむかって報いをなし、海沿いの国々にむかって報いをされる。"},{"ref":"Isa.59.19","start":23059019,"end":23059019,"break":"line","breaks":[[20,"line"],[36,"line"],[47,"line"]],"ruby":[[5,2,"ひとびと"],[8,1,"にし"],[10,1,"ほう"],[13,1,"しゅ"],[15,1,"な"],[17,1,"おそ"],[20,1,"ひ"],[22,1,"で"],[24,1,"ほう"],[29,2,"えいこう"],[32,1,"おそ"],[36,1,"しゅ"],[41,1,"と"],[44,1,"かわ"],[53,1,"お"],[55,1,"なが"]],"text":"こうして、人々は西の方から主の名を恐れ、日の出る方からその栄光を恐れる。主は、せき止めた川を、そのいぶきで押し流すように、こられるからである。"},{"ref":"Isa.59.20","start":23059020,"end":23059020,"break":"line","breaks":[[7,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"しゅ"],[15,1,"もの"],[38,1,"はな"],[41,1,"もの"],[43,1,"いた"]],"text":"主は言われる、「主は、あがなう者としてシオンにきたり、ヤコブのうちの、とがを離れる者に至る」と。"},{"ref":"Isa.59.21","start":23059021,"end":23059021,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"かれ"],[15,1,"た"],[18,2,"けいやく"],[31,1,"うえ"],[37,1,"れい"],[43,1,"くち"],[50,2,"ことば"],[54,1,"いま"],[57,1,"のち"],[68,1,"くち"],[76,1,"こ"],[79,1,"くち"],[87,1,"こ"],[90,1,"こ"],[92,1,"くち"],[95,1,"はな"]],"text":"主は言われる、「わたしが彼らと立てる契約はこれである。あなたの上にあるわが霊、あなたの口においたわが言葉は、今から後とこしえに、あなたの口から、あなたの子らの口から、あなたの子らの子の口から離れることはない」と。"}]