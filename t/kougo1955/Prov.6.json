[{"ref":"Prov.6.1","start":20006001,"end":20006001,"break":"paragraph","breaks":[[11,"line"],[25,"line"]],"ruby":[[2,1,"こ"],[11,1,"とな"],[13,1,"びと"],[18,3,"ほしょうにん"],[25,2,"たにん"],[31,1,"て"],[36,1,"ちか"]],"text":"わが子よ、あなたがもし隣り人のために保証人となり、他人のために手をうって誓ったならば、"},{"ref":"Prov.6.2","start":20006002,"end":20006002,"break":"line","breaks":[[25,"line"]],"ruby":[[11,2,"ことば"],[29,1,"くち"],[31,2,"ことば"],[37,1,"とら"]],"text":"もしあなたのくちびるの言葉によって、わなにかかり、あなたの口の言葉によって捕えられたならば、"},{"ref":"Prov.6.3","start":20006003,"end":20006003,"break":"line","breaks":[[21,"line"],[39,"line"]],"ruby":[[2,1,"こ"],[7,1,"とき"],[18,1,"すく"],[25,1,"とな"],[27,1,"びと"],[29,1,"て"],[31,1,"おちい"],[39,1,"いそ"],[42,1,"い"],[46,1,"とな"],[48,1,"びと"],[54,1,"もと"]],"text":"わが子よ、その時はこうして、おのれを救え、あなたは隣り人の手に陥ったのだから。急いで行って、隣り人にひたすら求めよ。"},{"ref":"Prov.6.4","start":20006004,"end":20006004,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"め"],[6,1,"ねむ"]],"text":"あなたの目を眠らせず、あなたのまぶたを、まどろませず、"},{"ref":"Prov.6.5","start":20006005,"end":20006005,"break":"line","breaks":[[23,"line"],[42,"line"]],"ruby":[[12,1,"て"],[23,1,"とり"],[25,1,"とり"],[27,1,"と"],[29,1,"もの"],[31,1,"て"],[46,1,"すく"]],"text":"かもしかが、かりゅうどの手からのがれるように、鳥が鳥を取る者の手からのがれるように、おのれを救え。"},{"ref":"Prov.6.6","start":20006006,"end":20006006,"break":"stanza","breaks":[[16,"line"]],"ruby":[[3,1,"もの"],[13,1,"い"],[23,1,"み"],[26,2,"ちえ"],[29,1,"え"]],"text":"なまけ者よ、ありのところへ行き、そのすることを見て、知恵を得よ。"},{"ref":"Prov.6.7","start":20006007,"end":20006007,"break":"line","ruby":[[16,1,"おう"]],"text":"ありは、かしらなく、つかさなく、王もないが、"},{"ref":"Prov.6.8","start":20006008,"end":20006008,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"なつ"],[5,2,"しょくもつ"],[12,2,"かりい"],[16,1,"とき"],[22,1,"あつ"]],"text":"夏のうちに食物をそなえ、刈入れの時に、かてを集める。"},{"ref":"Prov.6.9","start":20006009,"end":20006009,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"もの"],[10,1,"ね"],[19,1,"め"],[25,1,"お"]],"text":"なまけ者よ、いつまで寝ているのか、いつ目をさまして起きるのか。"},{"ref":"Prov.6.10","start":20006010,"end":20006010,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"ねむ"],[16,1,"て"],[30,1,"やす"]],"text":"しばらく眠り、しばらくまどろみ、手をこまぬいて、またしばらく休む。"},{"ref":"Prov.6.11","start":20006011,"end":20006011,"break":"line","breaks":[[23,"line"]],"ruby":[[5,1,"まず"],[9,1,"ぬす"],[20,1,"きた"],[23,1,"とぼ"],[40,1,"く"]],"text":"それゆえ、貧しさは盗びとのようにあなたに来り、乏しさは、つわもののようにあなたに来る。"},{"ref":"Prov.6.12","start":20006012,"end":20006012,"break":"line","breaks":[[12,"line"]],"ruby":[[5,1,"ひと"],[7,1,"あ"],[10,1,"ひと"],[12,1,"いつわ"],[15,2,"ことば"],[21,1,"い"]],"text":"よこしまな人、悪しき人は偽りの言葉をもって行きめぐり、"},{"ref":"Prov.6.13","start":20006013,"end":20006013,"break":"line","ruby":[[0,1,"め"],[8,1,"あし"],[10,1,"ふ"],[12,1,"な"],[16,1,"ゆび"],[18,1,"しめ"]],"text":"目でめくばせし、足で踏み鳴らし、指で示し、"},{"ref":"Prov.6.14","start":20006014,"end":20006014,"break":"line","breaks":[[15,"line"]],"ruby":[[5,1,"こころ"],[10,1,"あく"],[12,1,"はか"],[15,1,"た"],[18,1,"あらそ"]],"text":"よこしまな心をもって悪を計り、絶えず争いをおこす。"},{"ref":"Prov.6.15","start":20006015,"end":20006015,"break":"line","breaks":[[17,"line"]],"ruby":[[5,1,"わざわい"],[12,1,"かれ"],[14,1,"のぞ"],[24,1,"う"],[26,1,"やぶ"],[30,1,"たす"]],"text":"それゆえ、災は、にわかに彼に臨み、たちまちにして打ち敗られ、助かることはない。"},{"ref":"Prov.6.16","start":20006016,"end":20006016,"break":"stanza","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"にく"],[14,1,"いな"],[18,1,"こころ"],[21,1,"い"]],"text":"主の憎まれるものが六つある、否、その心に、忌みきらわれるものが七つある。"},{"ref":"Prov.6.17","start":20006017,"end":20006017,"break":"line","breaks":[[17,"line"]],"ruby":[[5,1,"たか"],[8,1,"め"],[10,1,"いつわ"],[13,1,"い"],[15,1,"した"],[17,1,"つみ"],[20,1,"ひと"],[22,1,"ち"],[24,1,"なが"],[26,1,"て"]],"text":"すなわち、高ぶる目、偽りを言う舌、罪なき人の血を流す手、"},{"ref":"Prov.6.18","start":20006018,"end":20006018,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"あ"],[3,1,"はか"],[12,1,"こころ"],[19,1,"あく"],[21,1,"はし"],[23,1,"あし"]],"text":"悪しき計りごとをめぐらす心、すみやかに悪に走る足、"},{"ref":"Prov.6.19","start":20006019,"end":20006019,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"いつわ"],[6,2,"しょうにん"],[11,2,"きょうだい"],[17,1,"あらそ"],[23,1,"ひと"]],"text":"偽りをのべる証人、また兄弟のうちに争いをおこす人がこれである。"},{"ref":"Prov.6.20","start":20006020,"end":20006020,"break":"stanza","breaks":[[17,"line"]],"ruby":[[2,1,"こ"],[9,1,"ちち"],[11,1,"いまし"],[14,1,"まも"],[21,1,"はは"],[23,1,"おしえ"],[25,1,"す"]],"text":"わが子よ、あなたの父の戒めを守り、あなたの母の教を捨てるな。"},{"ref":"Prov.6.21","start":20006021,"end":20006021,"break":"line","breaks":[[16,"line"]],"ruby":[[11,1,"こころ"],[13,1,"むす"],[20,1,"くび"]],"text":"つねに、これをあなたの心に結び、あなたの首のまわりにつけよ。"},{"ref":"Prov.6.22","start":20006022,"end":20006022,"break":"line","breaks":[[20,"line"],[36,"line"]],"ruby":[[8,1,"ある"],[17,1,"みちび"],[24,1,"ね"],[33,1,"まも"],[40,1,"め"],[51,1,"かた"]],"text":"これは、あなたが歩くとき、あなたを導き、あなたが寝るとき、あなたを守り、あなたが目ざめるとき、あなたと語る。"},{"ref":"Prov.6.23","start":20006023,"end":20006023,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"いまし"],[11,1,"おしえ"],[13,1,"ひかり"],[18,2,"きょうくん"],[21,1,"こら"],[25,1,"いのち"],[27,1,"みち"]],"text":"戒めはともしびである、教は光である、教訓の懲しめは命の道である。"},{"ref":"Prov.6.24","start":20006024,"end":20006024,"break":"line","breaks":[[22,"line"]],"ruby":[[8,1,"まも"],[12,1,"わる"],[14,1,"おんな"],[16,1,"ちか"],[26,1,"おんな"],[29,1,"たく"],[32,1,"した"],[34,1,"まど"]],"text":"これは、あなたを守って、悪い女に近づかせず、みだらな女の、巧みな舌に惑わされぬようにする。"},{"ref":"Prov.6.25","start":20006025,"end":20006025,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"うるわ"],[7,1,"こころ"],[9,1,"した"],[24,1,"とら"]],"text":"彼女の麗しさを心に慕ってはならない、そのまぶたに捕えられてはならない。"},{"ref":"Prov.6.26","start":20006026,"end":20006026,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ゆうじょ"],[3,1,"いっ"],[4,1,"かい"],[12,1,"やと"],[25,1,"おんな"],[27,1,"ひと"],[29,1,"たっと"],[31,1,"いのち"],[33,1,"もと"]],"text":"遊女は一塊のパンのために雇われる、しかし、みだらな女は人の尊い命を求める。"},{"ref":"Prov.6.27","start":20006027,"end":20006027,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ひと"],[2,1,"ひ"],[18,2,"きもの"],[21,1,"や"]],"text":"人は火を、そのふところにいだいてその着物が焼かれないであろうか。"},{"ref":"Prov.6.28","start":20006028,"end":20006028,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"ひと"],[5,1,"あつ"],[7,1,"ひ"],[9,1,"ふ"],[15,1,"あし"],[18,1,"や"]],"text":"また人は、熱い火を踏んで、その足が、焼かれないであろうか。"},{"ref":"Prov.6.29","start":20006029,"end":20006029,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"となり"],[4,1,"つま"],[6,2,"ふぎ"],[9,1,"おこな"],[11,1,"もの"],[17,1,"おな"],[24,2,"かのじょ"],[27,1,"ふ"],[30,1,"もの"],[32,1,"ばつ"],[34,1,"まぬか"]],"text":"その隣の妻と不義を行う者も、それと同じだ。すべて彼女に触れる者は罰を免れることはできない。"},{"ref":"Prov.6.30","start":20006030,"end":20006030,"break":"line","breaks":[[10,"line"],[27,"line"]],"ruby":[[0,1,"ぬす"],[4,1,"う"],[12,1,"う"],[15,1,"み"],[21,1,"ぬす"],[27,1,"ひと"],[29,1,"かれ"],[31,1,"かろ"]],"text":"盗びとが飢えたとき、その飢えを満たすために盗むならば、人は彼を軽んじないであろうか。"},{"ref":"Prov.6.31","start":20006031,"end":20006031,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"とら"],[13,1,"ばい"],[15,1,"つぐな"],[20,1,"いえ"],[22,1,"か"],[23,1,"ざい"],[31,1,"だ"]],"text":"もし捕えられたなら、その七倍を償い、その家の貨財を、ことごとく出さなければならない。"},{"ref":"Prov.6.32","start":20006032,"end":20006032,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おんな"],[2,2,"かんいん"],[5,1,"おこな"],[7,1,"もの"],[9,2,"しりょ"],[18,1,"おこな"],[20,1,"もの"],[26,1,"ほろ"]],"text":"女と姦淫を行う者は思慮がない。これを行う者はおのれを滅ぼし、"},{"ref":"Prov.6.33","start":20006033,"end":20006033,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"きず"],[10,1,"う"],[16,1,"はじ"]],"text":"傷と、はずかしめとを受けて、その恥をすすぐことができない。"},{"ref":"Prov.6.34","start":20006034,"end":20006034,"break":"line","breaks":[[19,"line"]],"ruby":[[7,1,"おっと"],[9,1,"はげ"],[12,1,"いか"],[19,1,"うら"],[22,1,"むく"],[28,2,"ようしゃ"]],"text":"ねたみは、その夫を激しく怒らせるゆえ、恨みを報いるとき、容赦することはない。"},{"ref":"Prov.6.35","start":20006035,"end":20006035,"break":"line","breaks":[[16,"line"]],"ruby":[[9,1,"もの"],[12,1,"かえり"],[16,1,"おお"],[19,1,"おく"],[21,1,"もの"],[27,1,"やわ"]],"text":"どのようなあがない物をも顧みず、多くの贈り物をしても、和らがない。"}]