[{"ref":"Dan.5.1","start":27005001,"end":27005001,"break":"paragraph","ruby":[[6,1,"おう"],[11,2,"だいじん"],[15,1,"にん"],[21,1,"さか"],[24,2,"しゅえん"],[27,1,"もう"],[34,1,"にん"],[36,1,"まえ"],[38,1,"さけ"],[40,1,"の"]],"text":"ベルシャザル王は、その大臣一千人のために、盛んな酒宴を設け、その一千人の前で酒を飲んでいた。"},{"ref":"Dan.5.2","start":27005002,"end":27005002,"break":"paragraph","ruby":[[0,1,"さけ"],[2,1,"すす"],[18,1,"ちち"],[33,2,"しんでん"],[37,1,"と"],[42,2,"きんぎん"],[45,1,"うつわ"],[47,1,"も"],[53,1,"めい"],[57,1,"おう"],[61,2,"だいじん"],[69,1,"おう"],[71,1,"つま"],[85,1,"さけ"],[87,1,"の"]],"text":"酒が進んだとき、ベルシャザルは、その父ネブカデネザルがエルサレムの神殿から取ってきた金銀の器を持ってこいと命じた。王とその大臣たち、および王の妻とそばめらが、これをもって酒を飲むためであった。"},{"ref":"Dan.5.3","start":27005003,"end":27005003,"break":"none","ruby":[[3,2,"ひとびと"],[14,1,"かみ"],[16,1,"みや"],[21,2,"しんでん"],[25,1,"と"],[30,2,"きんぎん"],[33,1,"うつわ"],[35,1,"も"],[43,1,"おう"],[47,2,"だいじん"],[55,1,"おう"],[57,1,"つま"],[71,1,"の"]],"text":"そこで人々はそのエルサレムの神の宮すなわち神殿から取ってきた金銀の器を持ってきたので、王とその大臣たち、および王の妻とそばめらは、これをもって飲んだ。"},{"ref":"Dan.5.4","start":27005004,"end":27005004,"break":"none","ruby":[[4,1,"かれ"],[7,1,"さけ"],[9,1,"の"],[13,1,"きん"],[15,1,"ぎん"],[17,2,"せいどう"],[20,1,"てつ"],[22,1,"き"],[24,1,"いし"],[28,2,"かみがみ"]],"text":"すなわち彼らは酒を飲んで、金、銀、青銅、鉄、木、石などの神々をほめたたえた。"},{"ref":"Dan.5.5","start":27005005,"end":27005005,"break":"paragraph","ruby":[[3,2,"とつぜん"],[5,1,"ひと"],[7,1,"て"],[9,1,"ゆび"],[17,2,"しょくだい"],[20,2,"あいたい"],[24,1,"おう"],[26,2,"きゅうでん"],[29,1,"ぬ"],[31,1,"かべ"],[33,1,"もの"],[35,1,"か"],[39,1,"おう"],[43,1,"もの"],[45,1,"か"],[48,1,"て"],[50,1,"さき"],[52,1,"み"]],"text":"すると突然人の手の指があらわれて、燭台と相対する王の宮殿の塗り壁に物を書いた。王はその物を書いた手の先を見た。"},{"ref":"Dan.5.6","start":27005006,"end":27005006,"break":"none","ruby":[[5,1,"おう"],[7,2,"かおいろ"],[10,1,"かわ"],[15,1,"こころ"],[17,1,"おも"],[19,1,"なや"],[22,1,"みだ"],[27,1,"こし"],[40,1,"ふる"],[43,1,"たがい"],[45,1,"う"]],"text":"そのために王の顔色は変り、その心は思い悩んで乱れ、その腰のつがいはゆるみ、ひざは震えて互に打ちあった。"},{"ref":"Dan.5.7","start":27005007,"end":27005007,"break":"none","ruby":[[0,1,"おう"],[2,2,"おおごえ"],[5,1,"よ"],[11,1,"ほう"],[12,1,"じゅつ"],[13,1,"し"],[22,1,"うらな"],[24,1,"し"],[27,1,"め"],[35,1,"おう"],[42,2,"ちしゃ"],[47,1,"つ"],[50,1,"い"],[57,2,"もじ"],[60,1,"よ"],[65,1,"と"],[67,1,"あ"],[75,1,"しめ"],[77,1,"もの"],[80,1,"むらさき"],[82,1,"ころも"],[84,1,"き"],[87,1,"くび"],[89,1,"きん"],[91,1,"くさり"],[99,1,"くに"],[101,1,"だい"]],"text":"王は大声に呼ばわって、法術士、カルデヤびと、占い師らを召してこさせた。王はバビロンの知者たちに告げて言った、「この文字を読み、その解き明かしをわたしに示す者には紫の衣を着せ、首に金の鎖をかけさせて、国の第三のつかさとしよう」と。"},{"ref":"Dan.5.8","start":27005008,"end":27005008,"break":"none","ruby":[[0,1,"おう"],[2,2,"ちしゃ"],[7,1,"みな"],[20,2,"もじ"],[23,1,"よ"],[36,1,"と"],[38,1,"あ"],[42,1,"おう"],[44,1,"しめ"]],"text":"王の知者たちは皆はいってきた。しかしその文字を読むことができず、またその解き明かしを王に示すことができなかったので、"},{"ref":"Dan.5.9","start":27005009,"end":27005009,"break":"none","ruby":[[6,1,"おう"],[8,1,"おお"],[11,1,"おも"],[13,1,"なや"],[19,2,"かおいろ"],[22,1,"かわ"],[25,1,"おう"],[27,2,"だいじん"],[32,2,"とうわく"]],"text":"ベルシャザル王は大いに思い悩んで、その顔色は変り、王の大臣たちも当惑した。"},{"ref":"Dan.5.10","start":27005010,"end":27005010,"break":"paragraph","ruby":[[0,1,"とき"],[2,2,"おうひ"],[5,1,"おう"],[7,2,"だいじん"],[12,2,"ことば"],[15,1,"き"],[21,3,"えんかいじょう"],[35,2,"おうひ"],[38,1,"い"],[43,1,"おう"],[55,1,"い"],[73,1,"こころ"],[75,1,"おも"],[77,1,"なや"],[89,2,"かおいろ"],[92,1,"か"],[97,1,"およ"]],"text":"時に王妃は王と大臣たちの言葉を聞いて、その宴会場にはいってきた。そして王妃は言った、「王よ、どうか、とこしえに生きながらえられますように。あなたは心に思い悩んではなりません。また顔色を変えるには及びません。"},{"ref":"Dan.5.11","start":27005011,"end":27005011,"break":"none","ruby":[[4,1,"くに"],[8,1,"せい"],[11,1,"かみ"],[13,1,"れい"],[25,1,"ひと"],[36,1,"ちち"],[38,1,"よ"],[41,1,"かれ"],[44,2,"めいち"],[47,2,"ふんべつ"],[52,1,"かみ"],[57,2,"ちえ"],[77,1,"ちち"],[85,1,"おう"],[88,1,"かれ"],[90,1,"た"],[94,2,"はかせ"],[97,1,"ほう"],[98,1,"じゅつ"],[99,1,"し"],[108,1,"うらな"],[110,1,"し"],[113,1,"ちょう"]],"text":"あなたの国には、聖なる神の霊のやどっているひとりの人がおります。あなたの父の代に、彼は、明知、分別および神のような知恵のあることをあらわしました。あなたの父ネブカデネザル王は、彼を立てて、博士、法術士、カルデヤびと、占い師らの長とされました。"},{"ref":"Dan.5.12","start":27005012,"end":27005012,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おう"],[15,1,"な"],[17,1,"あた"],[27,1,"もの"],[45,1,"れい"],[47,2,"ちしき"],[50,2,"ふんべつ"],[57,1,"ゆめ"],[59,1,"と"],[65,1,"と"],[68,2,"なんもん"],[71,1,"と"],[89,1,"め"],[95,1,"かれ"],[99,1,"と"],[101,1,"あ"],[105,1,"しめ"]],"text":"彼は、王がベルテシャザルという名を与えたダニエルという者ですが、このダニエルには、すぐれた霊、知識、分別があって、夢を解き、なぞを解き、難問を解くことができます。ゆえにダニエルを召しなさい。彼はその解き明かしを示すでしょう」。"},{"ref":"Dan.5.13","start":27005013,"end":27005013,"break":"paragraph","ruby":[[8,1,"おう"],[10,1,"まえ"],[12,1,"め"],[17,1,"おう"],[24,1,"い"],[36,1,"ちち"],[38,1,"おう"],[55,2,"ほしゅう"]],"text":"そこでダニエルは王の前に召された。王はダニエルに言った、「あなたは、わが父の王が、ユダからひきつれてきたユダの捕囚のひとりなのか。"},{"ref":"Dan.5.14","start":27005014,"end":27005014,"break":"none","ruby":[[0,1,"き"],[19,1,"せい"],[22,1,"かみ"],[24,1,"れい"],[33,2,"めいち"],[36,2,"ふんべつ"],[41,2,"ひぼん"],[44,2,"ちえ"]],"text":"聞くところによると、あなたのうちには、聖なる神の霊がやどっていて、明知、分別および非凡な知恵があるそうだ。"},{"ref":"Dan.5.15","start":27005015,"end":27005015,"break":"none","ruby":[[5,2,"ちしゃ"],[8,1,"ほう"],[9,1,"じゅつ"],[10,1,"し"],[16,1,"まえ"],[18,1,"め"],[26,2,"もじ"],[29,1,"よ"],[35,1,"と"],[37,1,"あ"],[41,1,"しめ"],[51,1,"かれ"],[57,1,"こと"],[59,1,"と"],[61,1,"あ"],[65,1,"しめ"]],"text":"わたしは、知者、法術士らを、わが前に召しよせて、この文字を読ませ、その解き明かしを示させようとしたが、彼らは、この事の解き明かしを示すことができなかった。"},{"ref":"Dan.5.16","start":27005016,"end":27005016,"break":"none","ruby":[[5,1,"き"],[19,1,"と"],[21,1,"あ"],[30,2,"なんもん"],[33,1,"と"],[58,2,"もじ"],[61,1,"よ"],[66,1,"と"],[68,1,"あ"],[76,1,"しめ"],[91,1,"むらさき"],[93,1,"ころも"],[95,1,"き"],[98,1,"きん"],[100,1,"くさり"],[102,1,"くび"],[112,1,"くに"],[114,1,"だい"]],"text":"しかしまた聞くところによると、あなたは解き明かしをなし、かつ難問を解くことができるそうだ。それで、あなたがもし、この文字を読み、その解き明かしをわたしに示すことができたなら、あなたに紫の衣を着せ、金の鎖を首にかけさせて、この国の第三のつかさとしよう」。"},{"ref":"Dan.5.17","start":27005017,"end":27005017,"break":"paragraph","ruby":[[5,1,"おう"],[7,1,"まえ"],[9,1,"こた"],[12,1,"い"],[21,2,"たまもの"],[29,2,"じしん"],[42,1,"おく"],[44,1,"もの"],[47,2,"たにん"],[51,1,"あた"],[67,1,"おう"],[74,2,"もじ"],[77,1,"よ"],[82,1,"と"],[84,1,"あ"],[89,1,"おし"]],"text":"ダニエルは王の前に答えて言った、「あなたの賜物は、あなたご自身にとっておき、あなたの贈り物は、他人にお与えください。それでも、わたしは王のためにその文字を読み、その解き明かしをお知らせいたしましょう。"},{"ref":"Dan.5.18","start":27005018,"end":27005018,"break":"none","ruby":[[0,1,"おう"],[5,1,"たか"],[7,1,"かみ"],[13,1,"ちち"],[22,1,"くに"],[24,2,"けんせい"],[28,2,"こうえい"],[31,2,"そんげん"],[35,1,"たま"]],"text":"王よ、いと高き神はあなたの父ネブカデネザルに国と権勢と、光栄と尊厳とを賜いました。"},{"ref":"Dan.5.19","start":27005019,"end":27005019,"break":"none","ruby":[[0,1,"かれ"],[2,2,"けんせい"],[5,1,"たま"],[16,2,"しょみん"],[19,1,"しょ"],[20,1,"ぞく"],[22,2,"しょこく"],[24,1,"ご"],[26,1,"もの"],[31,1,"かれ"],[33,1,"まえ"],[39,1,"おそ"],[45,1,"かれ"],[47,2,"じぶん"],[50,1,"ほっ"],[53,1,"もの"],[55,1,"ころ"],[58,2,"じぶん"],[61,1,"ほっ"],[64,1,"もの"],[66,1,"い"],[70,2,"じぶん"],[73,1,"ほっ"],[76,1,"もの"],[78,1,"あ"],[81,2,"じぶん"],[84,1,"ほっ"],[87,1,"もの"],[89,1,"くだ"]],"text":"彼に権勢を賜わったことによって、諸民、諸族、諸国語の者はみな、彼の前におののき恐れました。彼は自分の欲する者を殺し、自分の欲する者を生かし、自分の欲する者を上げ、自分の欲する者を下しました。"},{"ref":"Dan.5.20","start":27005020,"end":27005020,"break":"none","ruby":[[3,1,"かれ"],[5,1,"こころ"],[7,1,"たか"],[32,2,"おうい"],[45,2,"こうえい"],[48,1,"うば"]],"text":"しかし彼は心に高ぶり、かたくなになり、ごうまんにふるまったので、王位からしりぞけられ、その光栄を奪われ、"},{"ref":"Dan.5.21","start":27005021,"end":27005021,"break":"none","ruby":[[0,1,"お"],[4,1,"よ"],[6,1,"ひと"],[8,1,"はな"],[13,1,"おも"],[16,1,"けもの"],[30,1,"の"],[34,1,"とも"],[39,1,"うし"],[44,1,"くさ"],[46,1,"く"],[51,1,"み"],[53,1,"てん"],[59,1,"つゆ"],[71,1,"かれ"],[76,1,"たか"],[78,1,"かみ"],[80,2,"にんげん"],[83,1,"くに"],[85,1,"おさ"],[89,2,"じぶん"],[92,1,"い"],[97,1,"ひと"],[99,1,"た"],[111,1,"し"]],"text":"追われて世の人と離れ、その思いは獣のようになり、そのすまいは野ろばと共にあり、牛のように草を食い、その身は天からくだる露にぬれ、こうしてついに彼は、いと高き神が人間の国を治めて、自分の意のままに人を立てられるということを、知るようになりました。"},{"ref":"Dan.5.22","start":27005022,"end":27005022,"break":"none","ruby":[[12,1,"かれ"],[14,1,"こ"],[22,1,"こと"],[29,1,"し"],[39,1,"こころ"],[41,1,"ひく"]],"text":"ベルシャザルよ、あなたは彼の子であって、この事をことごとく知っていながら、なお心を低くせず、"},{"ref":"Dan.5.23","start":27005023,"end":27005023,"break":"none","ruby":[[4,1,"てん"],[6,1,"しゅ"],[17,1,"たか"],[23,1,"みや"],[25,2,"うつわもの"],[32,1,"まえ"],[34,1,"も"],[49,2,"だいじん"],[59,1,"つま"],[74,1,"さけ"],[76,1,"の"],[86,1,"み"],[92,1,"き"],[98,1,"もの"],[100,1,"し"],[109,1,"きん"],[111,1,"ぎん"],[113,2,"せいどう"],[116,1,"てつ"],[118,1,"き"],[120,1,"いし"],[122,2,"かみがみ"],[137,1,"いのち"],[141,1,"て"],[155,1,"みち"],[164,1,"かみ"]],"text":"かえって天の主にむかって、みずから高ぶり、その宮の器物をあなたの前に持ってこさせ、あなたとあなたの大臣たちと、あなたの妻とそばめたちは、それをもって酒を飲み、そしてあなたは見ることも、聞くことも、物を知ることもできない金、銀、青銅、鉄、木、石の神々をほめたたえたが、あなたの命をその手ににぎり、あなたのすべての道をつかさどられる神をあがめようとはしなかった。"},{"ref":"Dan.5.24","start":27005024,"end":27005024,"break":"paragraph","ruby":[[5,1,"かれ"],[7,1,"まえ"],[12,1,"て"],[14,1,"で"],[21,2,"もじ"],[24,1,"か"]],"text":"それゆえ、彼の前からこの手が出てきて、この文字が書きしるされたのです。"},{"ref":"Dan.5.25","start":27005025,"end":27005025,"break":"none","ruby":[[7,2,"もじ"]],"text":"そのしるされた文字はこうです。メネ、メネ、テケル、ウパルシン。"},{"ref":"Dan.5.26","start":27005026,"end":27005026,"break":"none","ruby":[[2,1,"こと"],[4,1,"と"],[6,1,"あ"],[18,1,"かみ"],[24,2,"ちせい"],[27,1,"かぞ"],[36,1,"おわ"],[39,1,"いた"]],"text":"その事の解き明かしはこうです、メネは神があなたの治世を数えて、これをその終りに至らせたことをいうのです。"},{"ref":"Dan.5.27","start":27005027,"end":27005027,"break":"none","ruby":[[13,1,"はか"],[20,1,"りょう"],[22,1,"た"]],"text":"テケルは、あなたがはかりで量られて、その量の足りないことがあらわれたことをいうのです。"},{"ref":"Dan.5.28","start":27005028,"end":27005028,"break":"none","ruby":[[9,1,"くに"],[11,1,"わ"],[26,2,"ひとびと"],[29,1,"あた"]],"text":"ペレスは、あなたの国が分かたれて、メデアとペルシャの人々に与えられることをいうのです」。"},{"ref":"Dan.5.29","start":27005029,"end":27005029,"break":"paragraph","ruby":[[10,1,"めい"],[19,1,"むらさき"],[21,1,"ころも"],[23,1,"き"],[26,1,"きん"],[28,1,"くさり"],[32,1,"くび"],[39,1,"かれ"],[44,2,"ふこく"],[47,1,"はっ"],[51,1,"かれ"],[53,1,"くに"],[55,1,"だい"],[65,1,"い"]],"text":"そこでベルシャザルは命じて、ダニエルに紫の衣を着せ、金の鎖をその首にかけさせ、彼について布告を発して、彼は国の第三のつかさであると言わせた。"},{"ref":"Dan.5.30","start":27005030,"end":27005030,"break":"paragraph","ruby":[[7,1,"おう"],[18,1,"よる"],[23,1,"ころ"]],"text":"カルデヤびとの王ベルシャザルは、その夜のうちに殺され、"},{"ref":"Dan.5.31","start":27005031,"end":27005031,"break":"none","ruby":[[13,1,"くに"],[15,1,"う"],[21,1,"とき"],[35,1,"さい"]],"text":"メデアびとダリヨスが、その国を受けた。この時ダリヨスは、おおよそ六十二歳であった。"}]