[{"ref":"1Kgs.18.1","start":11018001,"end":11018001,"break":"paragraph","ruby":[[0,1,"おお"],[3,1,"ひ"],[5,1,"へ"],[9,1,"ねん"],[10,1,"め"],[12,1,"しゅ"],[14,2,"ことば"],[21,1,"のぞ"],[26,1,"い"],[34,1,"み"],[40,1,"しめ"],[50,1,"あめ"],[52,1,"ち"],[54,1,"ふ"]],"text":"多くの日を経て、三年目に主の言葉がエリヤに臨んだ、「行って、あなたの身をアハブに示しなさい。わたしは雨を地に降らせる」。"},{"ref":"1Kgs.18.2","start":11018002,"end":11018002,"break":"none","ruby":[[6,1,"み"],[12,1,"しめ"],[18,1,"い"],[24,1,"とき"],[35,1,"はげ"]],"text":"エリヤはその身をアハブに示そうとして行った。その時、サマリヤにききんが激しかった。"},{"ref":"1Kgs.18.3","start":11018003,"end":11018003,"break":"none","ruby":[[4,1,"いえ"],[13,1,"め"],[23,1,"ふか"],[25,1,"しゅ"],[27,1,"おそ"],[30,1,"ひと"]],"text":"アハブは家づかさオバデヤを召した。（オバデヤは深く主を恐れる人で、"},{"ref":"1Kgs.18.4","start":11018004,"end":11018004,"break":"none","ruby":[[5,1,"しゅ"],[7,3,"よげんしゃ"],[11,1,"た"],[13,1,"ほろ"],[17,1,"とき"],[25,1,"にん"],[27,3,"よげんしゃ"],[31,1,"すく"],[33,1,"だ"],[38,1,"にん"],[43,1,"あな"],[45,1,"かく"],[51,1,"みず"],[56,1,"かれ"],[59,1,"やしな"]],"text":"イゼベルが主の預言者を断ち滅ぼした時、オバデヤは百人の預言者を救い出して五十人ずつほら穴に隠し、パンと水をもって彼らを養った）。"},{"ref":"1Kgs.18.5","start":11018005,"end":11018005,"break":"none","ruby":[[9,1,"い"],[14,2,"くにぢゅう"],[21,1,"みず"],[23,1,"みなもと"],[30,1,"かわ"],[32,1,"い"],[41,1,"うま"],[43,2,"らば"],[46,1,"い"],[55,1,"くさ"],[77,2,"かちく"],[86,1,"うしな"]],"text":"アハブはオバデヤに言った、「国中のすべての水の源と、すべての川に行ってみるがよい。馬と騾馬を生かしておくための草があるかもしれない。そうすれば、われわれは家畜をいくぶんでも失わずにすむであろう」。"},{"ref":"1Kgs.18.6","start":11018006,"end":11018006,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[5,1,"めぐ"],[7,1,"ち"],[13,1,"わ"],[26,1,"みち"],[28,1,"い"],[40,1,"た"],[42,1,"みち"],[44,1,"おこな"]],"text":"彼らは行き巡る地をふたりで分け、アハブはひとりでこの道を行き、オバデヤはひとりで他の道を行った。"},{"ref":"1Kgs.18.7","start":11018007,"end":11018007,"break":"paragraph","ruby":[[5,1,"みち"],[7,1,"すす"],[12,1,"とき"],[18,1,"かれ"],[20,1,"あ"],[24,1,"かれ"],[30,1,"みと"],[33,1,"ふ"],[36,1,"い"],[43,1,"しゅ"]],"text":"オバデヤが道を進んでいた時、エリヤが彼に会った。彼はエリヤを認めて伏して言った、「わが主エリヤよ、あなたはここにおられるのですか」。"},{"ref":"1Kgs.18.8","start":11018008,"end":11018008,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[16,1,"い"],[24,2,"しゅじん"],[38,1,"つ"]],"text":"エリヤは彼に言った、「そうです。行って、あなたの主人に、エリヤはここにいると告げなさい」。"},{"ref":"1Kgs.18.9","start":11018009,"end":11018009,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[14,1,"つみ"],[32,1,"て"],[38,1,"ころ"]],"text":"彼は言った、「わたしにどんな罪があって、あなたはしもべをアハブの手にわたして殺そうとされるのですか。"},{"ref":"1Kgs.18.10","start":11018010,"end":11018010,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"い"],[21,2,"しゅじん"],[28,1,"たず"],[35,1,"ひと"],[43,1,"たみ"],[48,1,"くに"],[67,1,"い"],[69,1,"とき"],[74,1,"くに"],[78,1,"たみ"],[85,1,"み"],[94,1,"ちか"]],"text":"あなたの神、主は生きておられます。わたしの主人があなたを尋ねるために、人をつかわさない民はなく、国もありません。そしてエリヤはいないと言う時は、その国、その民に、あなたが見つからないという誓いをさせるのです。"},{"ref":"1Kgs.18.11","start":11018011,"end":11018011,"break":"none","ruby":[[4,1,"いま"],[6,1,"い"],[20,2,"しゅじん"],[23,1,"つ"],[28,1,"い"]],"text":"あなたは今『行って、エリヤはここにいると主人に告げよ』と言われます。"},{"ref":"1Kgs.18.12","start":11018012,"end":11018012,"break":"none","ruby":[[11,1,"はな"],[14,1,"い"],[18,1,"しゅ"],[20,1,"れい"],[31,1,"し"],[35,1,"ところ"],[37,1,"つ"],[40,1,"い"],[51,1,"い"],[58,1,"つ"],[61,1,"かれ"],[67,1,"み"],[81,1,"かれ"],[87,1,"ころ"],[102,1,"おさな"],[104,1,"とき"],[107,1,"しゅ"],[109,1,"おそ"],[114,1,"もの"]],"text":"しかしわたしがあなたを離れて行くと、主の霊はあなたを、わたしの知らない所へ連れて行くでしょう。わたしが行ってアハブに告げ、彼があなたを見つけることができなければ、彼はわたしを殺すでしょう。しかし、しもべは幼い時から主を恐れている者です。"},{"ref":"1Kgs.18.13","start":11018013,"end":11018013,"break":"none","ruby":[[5,1,"しゅ"],[7,3,"よげんしゃ"],[11,1,"ころ"],[14,1,"とき"],[23,1,"こと"],[34,1,"しゅ"],[36,3,"よげんしゃ"],[43,1,"にん"],[47,1,"にん"],[52,1,"あな"],[54,1,"かく"],[61,1,"みず"],[66,1,"やしな"],[69,1,"こと"],[74,1,"しゅ"],[76,1,"き"]],"text":"イゼベルが主の預言者を殺した時に、わたしがした事、すなわち、わたしが主の預言者のうち百人を五十人ずつほら穴に隠して、パンと水をもって養った事を、わが主は聞かれませんでしたか。"},{"ref":"1Kgs.18.14","start":11018014,"end":11018014,"break":"none","ruby":[[4,1,"いま"],[10,1,"い"],[24,2,"しゅじん"],[27,1,"つ"],[32,1,"い"],[49,1,"かれ"],[55,1,"ころ"]],"text":"ところが今あなたは『行って、エリヤはここにいると主人に告げよ』と言われます。そのようなことをすれば彼はわたしを殺すでしょう」。"},{"ref":"1Kgs.18.15","start":11018015,"end":11018015,"break":"none","ruby":[[4,1,"い"],[13,1,"つか"],[16,2,"ばんぐん"],[19,1,"しゅ"],[21,1,"い"],[33,1,"かなら"],[44,1,"み"],[46,1,"かれ"],[48,1,"しめ"]],"text":"エリヤは言った、「わたしの仕える万軍の主は生きておられる。わたしは必ず、きょう、わたしの身を彼に示すであろう」。"},{"ref":"1Kgs.18.16","start":11018016,"end":11018016,"break":"none","ruby":[[5,1,"い"],[12,1,"あ"],[15,1,"かれ"],[17,1,"つ"],[31,1,"あ"],[37,1,"い"]],"text":"オバデヤは行ってアハブに会い、彼に告げたので、アハブはエリヤに会おうとして行った。"},{"ref":"1Kgs.18.17","start":11018017,"end":11018017,"break":"paragraph","ruby":[[8,1,"み"],[13,1,"かれ"],[15,1,"い"],[26,1,"なや"],[29,1,"もの"]],"text":"アハブはエリヤを見たとき、彼に言った、「イスラエルを悩ます者よ、あなたはここにいるのですか」。"},{"ref":"1Kgs.18.18","start":11018018,"end":11018018,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こた"],[17,1,"なや"],[38,1,"ちち"],[40,1,"いえ"],[42,1,"なや"],[56,1,"しゅ"],[58,2,"めいれい"],[61,1,"す"],[68,1,"したが"]],"text":"彼は答えた、「わたしがイスラエルを悩ますのではありません。あなたと、あなたの父の家が悩ましたのです。あなたがたが主の命令を捨て、バアルに従ったためです。"},{"ref":"1Kgs.18.19","start":11018019,"end":11018019,"break":"none","ruby":[[3,1,"いま"],[5,1,"ひと"],[22,1,"ひと"],[30,3,"よげんしゃ"],[37,1,"にん"],[47,3,"よげんしゃ"],[52,1,"にん"],[59,2,"しょくたく"],[62,2,"しょくじ"],[66,1,"もの"],[74,1,"やま"],[76,1,"あつ"],[84,1,"ところ"]],"text":"それで今、人をつかわしてイスラエルのすべての人およびバアルの預言者四百五十人、ならびにアシラの預言者四百人、イゼベルの食卓で食事する者たちをカルメル山に集めて、わたしの所にこさせなさい」。"},{"ref":"1Kgs.18.20","start":11018020,"end":11018020,"break":"paragraph","ruby":[[17,1,"ひと"],[19,1,"ひと"],[27,3,"よげんしゃ"],[37,1,"やま"],[39,1,"あつ"]],"text":"そこでアハブはイスラエルのすべての人に人をつかわして、預言者たちをカルメル山に集めた。"},{"ref":"1Kgs.18.21","start":11018021,"end":11018021,"break":"none","ruby":[[12,1,"たみ"],[14,1,"ちか"],[18,1,"い"],[39,1,"あいだ"],[41,1,"まよ"],[51,1,"しゅ"],[53,1,"かみ"],[60,1,"したが"],[73,1,"かみ"],[81,1,"したが"],[88,1,"たみ"],[92,1,"こと"],[94,1,"かれ"],[96,1,"こた"]],"text":"そのときエリヤはすべての民に近づいて言った、「あなたがたはいつまで二つのものの間に迷っているのですか。主が神ならばそれに従いなさい。しかしバアルが神ならば、それに従いなさい」。民はひと言も彼に答えなかった。"},{"ref":"1Kgs.18.22","start":11018022,"end":11018022,"break":"none","ruby":[[4,1,"たみ"],[6,1,"い"],[20,1,"のこ"],[23,1,"しゅ"],[25,3,"よげんしゃ"],[38,3,"よげんしゃ"],[46,1,"にん"]],"text":"エリヤは民に言った、「わたしはただひとり残った主の預言者です。しかしバアルの預言者は四百五十人あります。"},{"ref":"1Kgs.18.23","start":11018023,"end":11018023,"break":"none","ruby":[[6,1,"とう"],[8,1,"うし"],[19,1,"とう"],[21,1,"うし"],[23,1,"かれ"],[26,1,"えら"],[33,1,"き"],[35,1,"さ"],[43,1,"うえ"],[45,1,"の"],[51,1,"ひ"],[69,1,"とう"],[71,1,"うし"],[73,1,"ととの"],[83,1,"うえ"],[85,1,"の"],[88,1,"ひ"]],"text":"われわれに二頭の牛をください。そして一頭の牛を彼らに選ばせ、それを切り裂いて、たきぎの上に載せ、それに火をつけずにおかせなさい。わたしも一頭の牛を整え、それをたきぎの上に載せて火をつけずにおきましょう。"},{"ref":"1Kgs.18.24","start":11018024,"end":11018024,"break":"none","ruby":[[16,1,"かみ"],[18,1,"な"],[20,1,"よ"],[30,1,"しゅ"],[32,1,"な"],[34,1,"よ"],[44,1,"ひ"],[49,1,"こた"],[52,1,"かみ"],[54,1,"かみ"],[63,1,"たみ"],[65,1,"みな"],[66,1,"こた"],[79,1,"い"]],"text":"こうしてあなたがたはあなたがたの神の名を呼びなさい。わたしは主の名を呼びましょう。そして火をもって答える神を神としましょう」。民は皆答えて「それがよかろう」と言った。"},{"ref":"1Kgs.18.25","start":11018025,"end":11018025,"break":"none","ruby":[[11,3,"よげんしゃ"],[17,1,"い"],[28,1,"だい"],[34,1,"はじ"],[38,1,"とう"],[40,1,"うし"],[42,1,"えら"],[49,1,"ととの"],[58,1,"かみ"],[60,1,"な"],[62,1,"よ"],[71,1,"ひ"]],"text":"そこでエリヤはバアルの預言者たちに言った、「あなたがたは大ぜいだから初めに一頭の牛を選んで、それを整え、あなたがたの神の名を呼びなさい。ただし火をつけてはなりません」。"},{"ref":"1Kgs.18.26","start":11018026,"end":11018026,"break":"none","ruby":[[0,1,"かれ"],[3,1,"あた"],[8,1,"うし"],[10,1,"と"],[13,1,"ととの"],[16,1,"あさ"],[19,1,"ひる"],[26,1,"な"],[28,1,"よ"],[37,1,"こた"],[46,1,"い"],[56,1,"こえ"],[63,1,"こた"],[66,1,"もの"],[75,1,"かれ"],[78,2,"じぶん"],[83,1,"つく"],[86,2,"さいだん"],[93,1,"おど"]],"text":"彼らは与えられた牛を取って整え、朝から昼までバアルの名を呼んで「バアルよ、答えてください」と言った。しかしなんの声もなく、また答える者もなかったので、彼らは自分たちの造った祭壇のまわりに踊った。"},{"ref":"1Kgs.18.27","start":11018027,"end":11018027,"break":"none","ruby":[[0,1,"ひる"],[9,1,"かれ"],[17,1,"い"],[22,1,"かれ"],[24,1,"かみ"],[29,2,"おおごえ"],[35,1,"よ"],[41,1,"かれ"],[43,1,"かんが"],[58,1,"い"],[64,1,"たび"],[66,1,"で"],[74,1,"ねむ"],[79,1,"おこ"]],"text":"昼になってエリヤは彼らをあざけって言った、「彼は神だから、大声をあげて呼びなさい。彼は考えにふけっているのか、よそへ行ったのか、旅に出たのか、または眠っていて起されなければならないのか」。"},{"ref":"1Kgs.18.28","start":11018028,"end":11018028,"break":"none","ruby":[[3,1,"かれ"],[6,2,"おおごえ"],[9,1,"よ"],[14,1,"かれ"],[22,1,"したが"],[26,1,"かたな"],[31,1,"み"],[33,1,"きず"],[37,1,"ち"],[41,1,"み"],[43,1,"なが"],[46,1,"いた"]],"text":"そこで彼らは大声に呼ばわり、彼らのならわしに従って、刀とやりで身を傷つけ、血をその身に流すに至った。"},{"ref":"1Kgs.18.29","start":11018029,"end":11018029,"break":"none","ruby":[[4,1,"ひる"],[6,1,"す"],[10,1,"かれ"],[15,1,"さけ"],[17,1,"つづ"],[21,1,"ゆう"],[23,1,"そな"],[25,1,"もの"],[31,1,"とき"],[35,1,"およ"],[45,1,"こえ"],[50,1,"こた"],[53,1,"もの"],[60,1,"かえり"],[63,1,"もの"]],"text":"こうして昼が過ぎても彼らはなお叫び続けて、夕の供え物をささげる時にまで及んだ。しかしなんの声もなく、答える者もなく、また顧みる者もなかった。"},{"ref":"1Kgs.18.30","start":11018030,"end":11018030,"break":"paragraph","ruby":[[2,1,"とき"],[11,1,"たみ"],[22,2,"ちかよ"],[30,1,"い"],[36,1,"たみ"],[38,1,"みな"],[39,1,"かれ"],[41,2,"ちかよ"],[46,1,"かれ"],[54,1,"しゅ"],[56,2,"さいだん"],[59,1,"つくろ"]],"text":"その時エリヤはすべての民にむかって「わたしに近寄りなさい」と言ったので、民は皆彼に近寄った。彼はこわれている主の祭壇を繕った。"},{"ref":"1Kgs.18.31","start":11018031,"end":11018031,"break":"none","ruby":[[7,1,"むかし"],[9,1,"しゅ"],[11,2,"ことば"],[18,1,"のぞ"],[33,1,"な"],[39,1,"い"],[47,1,"こ"],[50,2,"ぶぞく"],[53,1,"かず"],[63,1,"いし"],[65,1,"と"]],"text":"そしてエリヤは昔、主の言葉がヤコブに臨んで、「イスラエルをあなたの名とせよ」と言われたヤコブの子らの部族の数にしたがって十二の石を取り、"},{"ref":"1Kgs.18.32","start":11018032,"end":11018032,"break":"none","ruby":[[2,1,"いし"],[4,1,"しゅ"],[6,1,"な"],[11,2,"さいだん"],[14,1,"きず"],[17,2,"さいだん"],[20,2,"しゅうい"],[23,1,"たね"],[34,1,"おお"],[42,1,"つく"]],"text":"その石で主の名によって祭壇を築き、祭壇の周囲に種二セヤをいれるほどの大きさの、みぞを作った。"},{"ref":"1Kgs.18.33","start":11018033,"end":11018033,"break":"none","ruby":[[7,1,"なら"],[10,1,"うし"],[12,1,"き"],[14,1,"さ"],[21,1,"うえ"],[23,1,"の"],[26,1,"い"],[37,1,"みず"],[39,1,"み"],[46,2,"はんさい"],[53,1,"うえ"],[55,1,"そそ"]],"text":"また、たきぎを並べ、牛を切り裂いてたきぎの上に載せて言った、「四つのかめに水を満たし、それを燔祭とたきぎの上に注げ」。"},{"ref":"1Kgs.18.34","start":11018034,"end":11018034,"break":"none","ruby":[[2,1,"い"],[11,1,"ど"],[17,1,"ど"],[27,1,"い"],[33,1,"ど"],[42,1,"ど"]],"text":"また言った、「それを二度せよ」。二度それをすると、また言った、「三度それをせよ」。三度それをした。"},{"ref":"1Kgs.18.35","start":11018035,"end":11018035,"break":"none","ruby":[[0,1,"みず"],[2,2,"さいだん"],[5,2,"しゅうい"],[8,1,"なが"],[18,1,"みず"],[20,1,"み"]],"text":"水は祭壇の周囲に流れた。またみぞにも水を満たした。"},{"ref":"1Kgs.18.36","start":11018036,"end":11018036,"break":"paragraph","ruby":[[0,1,"ゆう"],[2,1,"そな"],[4,1,"もの"],[10,1,"とき"],[16,3,"よげんしゃ"],[23,2,"ちかよ"],[27,1,"い"],[46,1,"かみ"],[48,1,"しゅ"],[63,1,"かみ"],[90,2,"ことば"],[93,1,"したが"],[102,1,"こと"],[104,1,"おこな"],[111,2,"こんにち"],[113,1,"し"]],"text":"夕の供え物をささげる時になって、預言者エリヤは近寄って言った、「アブラハム、イサク、ヤコブの神、主よ、イスラエルでは、あなたが神であること、わたしがあなたのしもべであって、あなたの言葉に従ってこのすべての事を行ったことを、今日知らせてください。"},{"ref":"1Kgs.18.37","start":11018037,"end":11018037,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"こた"],[19,1,"こた"],[27,1,"しゅ"],[32,1,"たみ"],[38,1,"かみ"],[51,1,"かれ"],[54,1,"こころ"],[56,1,"ひるがえ"],[67,1,"し"]],"text":"主よ、わたしに答えてください、わたしに答えてください。主よ、この民にあなたが神であること、またあなたが彼らの心を翻されたのであることを知らせてください」。"},{"ref":"1Kgs.18.38","start":11018038,"end":11018038,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"ひ"],[8,1,"くだ"],[11,2,"はんさい"],[20,1,"いし"],[27,1,"や"],[38,1,"みず"]],"text":"そのとき主の火が下って燔祭と、たきぎと、石と、ちりとを焼きつくし、またみぞの水をなめつくした。"},{"ref":"1Kgs.18.39","start":11018039,"end":11018039,"break":"none","ruby":[[0,1,"たみ"],[2,1,"みな"],[3,1,"み"],[8,1,"ふ"],[11,1,"い"],[16,1,"しゅ"],[18,1,"かみ"],[23,1,"しゅ"],[25,1,"かみ"]],"text":"民は皆見て、ひれ伏して言った、「主が神である。主が神である」。"},{"ref":"1Kgs.18.40","start":11018040,"end":11018040,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[16,3,"よげんしゃ"],[20,1,"とら"],[30,1,"に"],[44,1,"かれ"],[47,1,"とら"],[57,1,"かれ"],[64,1,"かわ"],[66,1,"つ"],[76,1,"かれ"],[79,1,"ころ"]],"text":"エリヤは彼らに言った、「バアルの預言者を捕えよ。そのひとりも逃がしてはならない」。そこで彼らを捕えたので、エリヤは彼らをキション川に連れくだって、そこで彼らを殺した。"},{"ref":"1Kgs.18.41","start":11018041,"end":11018041,"break":"paragraph","ruby":[[8,1,"い"],[13,2,"おおあめ"],[16,1,"おと"],[23,1,"のぼ"],[26,1,"い"],[30,1,"く"],[32,1,"の"]],"text":"エリヤはアハブに言った、「大雨の音がするから、上って行って、食い飲みしなさい」。"},{"ref":"1Kgs.18.42","start":11018042,"end":11018042,"break":"none","ruby":[[4,1,"く"],[6,1,"の"],[13,1,"のぼ"],[32,1,"いただき"],[34,1,"のぼ"],[37,1,"ち"],[39,1,"ふ"],[42,1,"かお"],[47,1,"あいだ"],[49,1,"い"]],"text":"アハブは食い飲みするために上っていった。しかしエリヤはカルメルの頂に登り、地に伏して顔をひざの間に入れていたが、"},{"ref":"1Kgs.18.43","start":11018043,"end":11018043,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[11,1,"のぼ"],[17,1,"うみ"],[19,1,"ほう"],[21,1,"み"],[27,1,"かれ"],[29,1,"のぼ"],[36,1,"み"],[40,1,"なに"],[49,1,"い"],[63,1,"ど"],[64,1,"い"],[71,1,"い"],[75,1,"ど"],[77,1,"およ"]],"text":"彼はしもべに言った、「上っていって海の方を見なさい」。彼は上っていって、見て、「何もありません」と言ったので、エリヤは「もう一度行きなさい」と言って七度に及んだ。"},{"ref":"1Kgs.18.44","start":11018044,"end":11018044,"break":"none","ruby":[[1,2,"どめ"],[8,1,"い"],[13,1,"うみ"],[16,1,"ひと"],[18,1,"て"],[22,1,"ちい"],[25,1,"くも"],[27,1,"た"],[39,1,"い"],[44,1,"のぼ"],[52,1,"あめ"],[64,1,"くるま"],[66,1,"ととの"],[69,1,"くだ"],[77,1,"い"]],"text":"七度目にしもべは言った、「海から人の手ほどの小さな雲が起っています」。エリヤは言った、「上っていって、『雨にとどめられないように車を整えて下れ』とアハブに言いなさい」。"},{"ref":"1Kgs.18.45","start":11018045,"end":11018045,"break":"none","ruby":[[3,1,"ま"],[8,1,"くも"],[10,1,"かぜ"],[12,1,"おこ"],[15,1,"そら"],[17,1,"くろ"],[22,2,"おおあめ"],[25,1,"ふ"],[35,1,"くるま"],[37,1,"の"],[45,1,"い"]],"text":"すると間もなく、雲と風が起り、空が黒くなって大雨が降ってきた。アハブは車に乗ってエズレルへ行った。"},{"ref":"1Kgs.18.46","start":11018046,"end":11018046,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"て"],[10,1,"のぞ"],[16,1,"かれ"],[18,1,"こし"],[29,2,"いりぐち"],[37,1,"まえ"],[39,1,"はし"]],"text":"また主の手がエリヤに臨んだので、彼は腰をからげ、エズレルの入口までアハブの前に走っていった。"}]