[{"ref":"Heb.13.1","start":58013001,"end":58013001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[2,1,"あい"],[4,1,"つづ"]],"text":"兄弟愛を続けなさい。"},{"ref":"Heb.13.2","start":58013002,"end":58013002,"break":"none","ruby":[[0,2,"たびびと"],[10,1,"わす"],[29,2,"ひとびと"],[33,1,"き"],[39,2,"みつかい"]],"text":"旅人をもてなすことを忘れてはならない。このようにして、ある人々は、気づかないで御使たちをもてなした。"},{"ref":"Heb.13.3","start":58013003,"end":58013003,"break":"none","ruby":[[0,1,"ごく"],[9,1,"ひと"],[14,2,"じぶん"],[17,2,"いっしょ"],[27,2,"こころもち"],[30,1,"おも"],[41,2,"じぶん"],[44,1,"おな"],[46,2,"にくたい"],[51,1,"もの"],[56,1,"くる"],[64,1,"ひと"],[72,1,"こころ"]],"text":"獄につながれている人たちを、自分も一緒につながれている心持で思いやりなさい。また、自分も同じ肉体にある者だから、苦しめられている人たちのことを、心にとめなさい。"},{"ref":"Heb.13.4","start":58013004,"end":58013004,"break":"none","ruby":[[4,1,"ひと"],[7,2,"けっこん"],[10,1,"おも"],[21,2,"ねどこ"],[24,1,"けが"],[33,1,"かみ"],[36,3,"ふひんこう"],[40,1,"もの"],[42,2,"かんいん"],[47,1,"もの"]],"text":"すべての人は、結婚を重んずべきである。また寝床を汚してはならない。神は、不品行な者や姦淫をする者をさばかれる。"},{"ref":"Heb.13.5","start":58013005,"end":58013005,"break":"none","ruby":[[0,2,"きんせん"],[3,1,"あい"],[14,2,"じぶん"],[17,1,"も"],[25,2,"まんぞく"],[32,1,"しゅ"],[41,1,"けっ"],[48,1,"はな"],[56,1,"す"],[62,1,"い"]],"text":"金銭を愛することをしないで、自分の持っているもので満足しなさい。主は、「わたしは、決してあなたを離れず、あなたを捨てない」と言われた。"},{"ref":"Heb.13.6","start":58013006,"end":58013006,"break":"none","breaks":[[21,"stanza"],[35,"line"],[46,"line"]],"ruby":[[17,1,"い"],[22,1,"しゅ"],[28,1,"たす"],[30,1,"ぬし"],[40,1,"おそ"],[46,1,"ひと"],[53,1,"なに"]],"text":"だから、わたしたちは、はばからずに言おう、「主はわたしの助け主である。わたしには恐れはない。人は、わたしに何ができようか」。"},{"ref":"Heb.13.7","start":58013007,"end":58013007,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"ことば"],[10,1,"かた"],[13,3,"しどうしゃ"],[26,1,"おも"],[28,1,"おこ"],[34,1,"かれ"],[37,2,"せいかつ"],[40,2,"さいご"],[43,1,"み"],[48,2,"しんこう"]],"text":"神の言をあなたがたに語った指導者たちのことを、いつも思い起しなさい。彼らの生活の最後を見て、その信仰にならいなさい。"},{"ref":"Heb.13.8","start":58013008,"end":58013008,"break":"none","ruby":[[25,1,"かわ"]],"text":"イエス・キリストは、きのうも、きょうも、いつまでも変ることがない。"},{"ref":"Heb.13.9","start":58013009,"end":58013009,"break":"none","ruby":[[5,1,"ちが"],[8,1,"おしえ"],[14,1,"まよ"],[25,2,"しょくもつ"],[32,1,"めぐ"],[39,1,"こころ"],[41,1,"つよ"],[49,2,"しょくもつ"],[55,1,"ある"],[58,1,"もの"],[61,1,"えき"],[63,1,"え"]],"text":"さまざまな違った教によって、迷わされてはならない。食物によらず、恵みによって、心を強くするがよい。食物によって歩いた者は、益を得ることがなかった。"},{"ref":"Heb.13.10","start":58013010,"end":58013010,"break":"none","ruby":[[10,2,"さいだん"],[16,2,"まくや"],[19,1,"つか"],[24,1,"もの"],[31,2,"さいだん"],[34,2,"しょくもつ"],[40,2,"けんり"]],"text":"わたしたちには一つの祭壇がある。幕屋で仕えている者たちは、その祭壇の食物をたべる権利はない。"},{"ref":"Heb.13.11","start":58013011,"end":58013011,"break":"none","ruby":[[5,3,"だいさいし"],[12,1,"つみ"],[27,1,"ち"],[30,2,"せいじょ"],[36,1,"たずさ"],[39,1,"い"],[52,2,"えいしょ"],[55,1,"そと"],[57,1,"や"]],"text":"なぜなら、大祭司によって罪のためにささげられるけものの血は、聖所のなかに携えて行かれるが、そのからだは、営所の外で焼かれてしまうからである。"},{"ref":"Heb.13.12","start":58013012,"end":58013012,"break":"none","ruby":[[12,2,"じぶん"],[15,1,"ち"],[17,1,"たみ"],[27,1,"もん"],[29,1,"そと"],[31,2,"くなん"],[34,1,"う"]],"text":"だから、イエスもまた、ご自分の血で民をきよめるために、門の外で苦難を受けられたのである。"},{"ref":"Heb.13.13","start":58013013,"end":58013013,"break":"none","ruby":[[13,1,"かれ"],[21,1,"み"],[23,1,"お"],[26,2,"えいしょ"],[29,1,"そと"],[31,1,"で"],[38,1,"い"]],"text":"したがって、わたしたちも、彼のはずかしめを身に負い、営所の外に出て、みもとに行こうではないか。"},{"ref":"Heb.13.14","start":58013014,"end":58013014,"break":"none","ruby":[[2,2,"ちじょう"],[7,2,"えいえん"],[10,1,"みやこ"],[22,1,"みやこ"],[32,1,"もと"]],"text":"この地上には、永遠の都はない。きたらんとする都こそ、わたしたちの求めているものである。"},{"ref":"Heb.13.15","start":58013015,"end":58013015,"break":"none","ruby":[[32,1,"かれ"],[34,2,"みな"],[46,1,"み"],[52,1,"かみ"]],"text":"だから、わたしたちはイエスによって、さんびのいけにえ、すなわち、彼の御名をたたえるくちびるの実を、たえず神にささげようではないか。"},{"ref":"Heb.13.16","start":58013016,"end":58013016,"break":"none","ruby":[[4,1,"ぜん"],[6,1,"おこな"],[11,1,"ほどこ"],[21,1,"わす"],[30,1,"かみ"],[43,1,"よろこ"]],"text":"そして、善を行うことと施しをすることとを、忘れてはいけない。神は、このようないけにえを喜ばれる。"},{"ref":"Heb.13.17","start":58013017,"end":58013017,"break":"none","ruby":[[6,3,"しどうしゃ"],[12,1,"い"],[17,1,"き"],[23,1,"したが"],[29,1,"かれ"],[33,1,"かみ"],[35,1,"い"],[44,1,"もの"],[64,1,"め"],[73,1,"かれ"],[76,1,"なげ"],[82,1,"よろこ"],[113,1,"えき"]],"text":"あなたがたの指導者たちの言うことを聞きいれて、従いなさい。彼らは、神に言いひらきをすべき者として、あなたがたのたましいのために、目をさましている。彼らが嘆かないで、喜んでこのことをするようにしなさい。そうでないと、あなたがたの益にならない。"},{"ref":"Heb.13.18","start":58013018,"end":58013018,"break":"paragraph","ruby":[[10,1,"いの"],[23,1,"あき"],[27,2,"りょうしん"],[30,1,"も"],[36,1,"しん"],[42,2,"なにごと"],[50,1,"ただ"],[53,2,"こうどう"],[59,1,"ねが"]],"text":"わたしたちのために、祈ってほしい。わたしたちは明らかな良心を持っていると信じており、何事についても、正しく行動しようと願っている。"},{"ref":"Heb.13.19","start":58013019,"end":58013019,"break":"none","ruby":[[10,1,"ところ"],[12,1,"はや"],[14,1,"かえ"],[20,1,"いの"],[30,1,"とく"],[33,1,"ねが"]],"text":"わたしがあなたがたの所に早く帰れるため、祈ってくれるように、特にお願いする。"},{"ref":"Heb.13.20","start":58013020,"end":58013020,"break":"paragraph","ruby":[[0,2,"えいえん"],[3,2,"けいやく"],[6,1,"ち"],[10,1,"ひつじ"],[12,3,"だいぼくしゃ"],[22,1,"しゅ"],[28,2,"しにん"],[31,1,"なか"],[34,1,"ひ"],[36,1,"あ"],[41,2,"へいわ"],[44,1,"かみ"]],"text":"永遠の契約の血による羊の大牧者、わたしたちの主イエスを、死人の中から引き上げられた平和の神が、"},{"ref":"Heb.13.21","start":58013021,"end":58013021,"break":"none","ruby":[[32,1,"くだ"],[42,2,"みむね"],[45,1,"おこな"],[55,1,"よ"],[60,1,"そな"],[63,1,"くだ"],[71,1,"ねが"],[74,2,"えいこう"],[78,2,"よよ"],[80,1,"かぎ"],[84,1,"かみ"]],"text":"イエス・キリストによって、みこころにかなうことをわたしたちにして下さり、あなたがたが御旨を行うために、すべての良きものを備えて下さるようにこい願う。栄光が、世々限りなく神にあるように、アァメン。"},{"ref":"Heb.13.22","start":58013022,"end":58013022,"break":"paragraph","ruby":[[0,2,"きょうだい"],[13,1,"すす"],[16,2,"ことば"],[19,1,"う"],[35,1,"て"],[40,1,"か"]],"text":"兄弟たちよ。どうかわたしの勧めの言葉を受けいれてほしい。わたしは、ただ手みじかに書いたのだから。"},{"ref":"Heb.13.23","start":58013023,"end":58013023,"break":"none","ruby":[[6,2,"きょうだい"],[22,1,"し"],[30,1,"かれ"],[32,1,"はや"],[34,1,"く"],[38,1,"かれ"],[40,2,"いっしょ"],[53,1,"あ"]],"text":"わたしたちの兄弟テモテがゆるされたことを、お知らせする。もし彼が早く来れば、彼と一緒にわたしはあなたがたに会えるだろう。"},{"ref":"Heb.13.24","start":58013024,"end":58013024,"break":"paragraph","ruby":[[6,3,"しどうしゃ"],[9,2,"いちどう"],[12,2,"せいと"],[16,2,"いちどう"],[24,1,"つた"],[39,2,"ひとびと"]],"text":"あなたがたの指導者一同と聖徒たち一同に、よろしく伝えてほしい。イタリヤからきた人々から、あなたがたによろしく。"},{"ref":"Heb.13.25","start":58013025,"end":58013025,"break":"paragraph","ruby":[[0,1,"めぐ"],[9,2,"いちどう"]],"text":"恵みが、あなたがた一同にあるように。"}]