[{"ref":"Neh.5.1","start":16005001,"end":16005001,"break":"paragraph","ruby":[[6,1,"たみ"],[10,1,"つま"],[12,1,"とも"],[17,2,"きょうだい"],[25,1,"ひと"],[27,1,"む"],[31,1,"おお"],[34,1,"さけ"],[36,1,"うった"]],"text":"さて、ここに民がその妻と共に、その兄弟であるユダヤ人に向かって大いに叫び訴えることがあった。"},{"ref":"Neh.5.2","start":16005002,"end":16005002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[23,1,"むすめ"],[25,1,"とも"],[27,1,"だい"],[38,2,"こくもつ"],[41,1,"え"],[44,1,"た"],[47,1,"い"]],"text":"すなわち、ある人々は言った、「われわれはむすこ娘と共に大ぜいです。われわれは穀物を得て、食べて生きていかなければなりません」。"},{"ref":"Neh.5.3","start":16005003,"end":16005003,"break":"none","ruby":[[4,2,"ひとびと"],[7,1,"い"],[17,1,"う"],[24,2,"こくもつ"],[27,1,"え"],[31,2,"たはた"],[38,1,"はたけ"],[41,1,"いえ"],[43,2,"ていとう"],[46,1,"い"]],"text":"またある人々は言った、「われわれは飢えのために、穀物を得ようと田畑も、ぶどう畑も、家も抵当に入れています」。"},{"ref":"Neh.5.4","start":16005004,"end":16005004,"break":"none","ruby":[[2,2,"ひとびと"],[5,1,"い"],[15,1,"おう"],[17,2,"ぜいきん"],[29,2,"たはた"],[37,1,"はたけ"],[42,1,"かね"],[44,1,"か"]],"text":"ある人々は言った、「われわれは王の税金のために、われわれの田畑およびぶどう畑をもって金を借りました。"},{"ref":"Neh.5.5","start":16005005,"end":16005005,"break":"none","ruby":[[0,1,"げん"],[7,1,"にく"],[14,2,"きょうだい"],[17,1,"にく"],[19,1,"ひと"],[28,2,"こども"],[31,1,"かれ"],[34,2,"こども"],[37,1,"ひと"],[43,1,"み"],[54,1,"むすめ"],[56,1,"ひと"],[58,2,"どれい"],[80,1,"むすめ"],[90,1,"ひと"],[92,2,"どれい"],[98,1,"もの"],[111,2,"たはた"],[118,1,"はたけ"],[120,2,"たにん"],[144,1,"ちから"]],"text":"現にわれわれの肉はわれわれの兄弟の肉に等しく、われわれの子供も彼らの子供に等しいのに、見よ、われわれはむすこ娘を人の奴隷とするようにしいられています。われわれの娘のうちには、すでに人の奴隷になった者もありますが、われわれの田畑も、ぶどう畑も他人のものになっているので、われわれにはどうする力もありません」。"},{"ref":"Neh.5.6","start":16005006,"end":16005006,"break":"paragraph","ruby":[[4,1,"かれ"],[7,1,"さけ"],[15,2,"ことば"],[18,1,"き"],[21,1,"おお"],[24,1,"いか"]],"text":"わたしは彼らの叫びと、これらの言葉を聞いて大いに怒った。"},{"ref":"Neh.5.7","start":16005007,"end":16005007,"break":"none","ruby":[[8,1,"かんが"],[14,1,"たっと"],[16,2,"ひとびと"],[27,1,"せ"],[30,1,"い"],[47,2,"きょうだい"],[51,2,"りそく"],[68,1,"かれ"],[71,1,"こと"],[76,2,"たいかい"],[79,1,"ひら"]],"text":"わたしはみずから考えたすえ、尊い人々およびつかさたちを責めて言った、「あなたがたはめいめいその兄弟から利息をとっている」。そしてわたしは彼らの事について大会を開き、"},{"ref":"Neh.5.8","start":16005008,"end":16005008,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[13,3,"いほうじん"],[17,1,"う"],[26,2,"きょうだい"],[31,1,"ひと"],[39,1,"ちから"],[62,2,"じぶん"],[65,2,"きょうだい"],[68,1,"う"],[77,1,"かれ"],[85,1,"う"],[93,1,"かれ"],[96,1,"もく"],[101,1,"こと"]],"text":"彼らに言った、「われわれは異邦人に売られたわれわれの兄弟ユダヤ人を、われわれの力にしたがってあがなった。しかるにあなたがたは自分の兄弟を売ろうとするのか。彼らはわれわれに売られるのか」。彼らは黙してひと言もいわなかった。"},{"ref":"Neh.5.9","start":16005009,"end":16005009,"break":"none","ruby":[[6,1,"い"],[19,1,"こと"],[38,1,"てき"],[42,3,"いほうじん"],[64,1,"かみ"],[66,1,"おそ"],[70,1,"こと"]],"text":"わたしはまた言った、「あなたがたのする事はよくない。あなたがたは、われわれの敵である異邦人のそしりをやめさせるために、われわれの神を恐れつつ事をなすべきではないか。"},{"ref":"Neh.5.10","start":16005010,"end":16005010,"break":"none","ruby":[[8,2,"きょうだい"],[24,1,"おな"],[27,1,"かね"],[29,2,"こくもつ"],[33,1,"か"],[47,2,"りそく"]],"text":"わたしもわたしの兄弟たちも、わたしのしもべたちも同じく金と穀物とを貸しているが、われわれはこの利息をやめよう。"},{"ref":"Neh.5.11","start":16005011,"end":16005011,"break":"none","ruby":[[16,1,"かれ"],[19,2,"たはた"],[25,1,"はたけ"],[30,1,"はたけ"],[34,2,"かおく"],[37,1,"かれ"],[40,1,"かえ"],[51,1,"かれ"],[55,1,"と"],[60,2,"きんせん"],[63,2,"こくもつ"],[69,1,"しゅ"],[71,1,"あぶら"],[76,1,"ぶん"],[80,1,"かえ"]],"text":"どうぞ、あなたがたは、きょうにも彼らの田畑、ぶどう畑、オリブ畑および家屋を彼らに返し、またあなたがたが彼らから取っていた金銭、穀物、ぶどう酒、油などの百分の一を返しなさい」。"},{"ref":"Neh.5.12","start":16005012,"end":16005012,"break":"none","ruby":[[3,1,"かれ"],[15,1,"かえ"],[20,1,"かれ"],[24,1,"なに"],[27,2,"ようきゅう"],[38,1,"い"],[48,1,"い"],[59,2,"さいし"],[64,1,"よ"],[67,1,"かれ"],[72,2,"ことば"],[79,1,"おこな"],[84,1,"ちか"],[87,1,"た"]],"text":"すると彼らは「われわれはそれを返します。彼らから何をも要求しません。あなたの言うようにします」と言った。そこでわたしは祭司たちを呼び、彼らにこの言葉のとおりに行うという誓いを立てさせた。"},{"ref":"Neh.5.13","start":16005013,"end":16005013,"break":"none","ruby":[[15,1,"う"],[17,1,"はら"],[20,1,"い"],[27,2,"やくそく"],[30,2,"じっこう"],[35,1,"もの"],[41,1,"かみ"],[48,1,"う"],[50,1,"はら"],[56,1,"いえ"],[62,2,"しごと"],[65,1,"はな"],[78,1,"ひと"],[85,1,"う"],[87,1,"はら"],[102,2,"かいしゅう"],[114,1,"い"],[118,1,"しゅ"],[129,1,"たみ"],[133,2,"やくそく"],[140,1,"い"]],"text":"わたしはまたわたしのふところを打ち払って言った、「この約束を実行しない者を、どうぞ神がこのように打ち払って、その家およびその仕事を離れさせられるように。その人はこのように打ち払われてむなしくなるように」。会衆はみな「アァメン」と言って、主をさんびした。そして民はこの約束のとおりに行った。"},{"ref":"Neh.5.14","start":16005014,"end":16005014,"break":"paragraph","ruby":[[10,1,"ち"],[12,2,"そうとく"],[15,1,"にん"],[20,1,"とき"],[35,1,"おう"],[37,1,"だい"],[40,1,"ねん"],[43,1,"だい"],[47,1,"ねん"],[53,1,"ねん"],[55,1,"あいだ"],[65,2,"きょうだい"],[71,2,"そうとく"],[77,2,"てあ"],[81,1,"う"]],"text":"またわたしは、ユダの地の総督に任ぜられた時から、すなわちアルタシャスタ王の第二十年から第三十二年まで、十二年の間、わたしもわたしの兄弟たちも、総督としての手当てを受けなかった。"},{"ref":"Neh.5.15","start":16005015,"end":16005015,"break":"none","ruby":[[5,2,"いぜん"],[8,2,"そうとく"],[12,1,"たみ"],[14,2,"おもに"],[17,1,"お"],[21,1,"かれ"],[25,1,"ぎん"],[41,1,"しゅ"],[43,1,"と"],[48,1,"かれ"],[57,1,"たみ"],[59,2,"あっぱく"],[71,1,"かみ"],[73,1,"おそ"]],"text":"わたしより以前の総督らは民に重荷を負わせ、彼らから銀四十シケルのほかにパンとぶどう酒を取り、また彼らのしもべたちも民を圧迫した。しかしわたしは神を恐れるので、そのようなことはしなかった。"},{"ref":"Neh.5.16","start":16005016,"end":16005016,"break":"none","ruby":[[11,2,"じょうへき"],[14,2,"こうじ"],[17,1,"み"],[26,2,"とち"],[30,1,"か"],[49,1,"みな"],[53,1,"あつ"],[57,2,"こうじ"]],"text":"わたしはかえって、この城壁の工事に身をゆだね、どんな土地をも買ったことはない。わたしのしもべたちは皆そこに集まって工事をした。"},{"ref":"Neh.5.17","start":16005017,"end":16005017,"break":"none","ruby":[[6,2,"しょくたく"],[13,1,"ひと"],[24,1,"にん"],[40,2,"しゅうい"],[43,3,"いほうじん"],[53,2,"ひとびと"]],"text":"またわたしの食卓にはユダヤ人と、つかさたち百五十人もあり、そのほかに、われわれの周囲の異邦人のうちからきた人々もあった。"},{"ref":"Neh.5.18","start":16005018,"end":16005018,"break":"none","ruby":[[7,1,"にち"],[9,1,"うし"],[11,1,"とう"],[13,1,"こ"],[16,1,"ひつじ"],[18,1,"とう"],[20,1,"そな"],[25,1,"にわとり"],[35,1,"そな"],[39,1,"か"],[51,1,"しゅ"],[53,1,"そな"],[64,1,"たみ"],[66,2,"ろうえき"],[69,1,"おも"],[76,2,"そうとく"],[82,2,"てあ"],[86,1,"もと"]],"text":"これがために一日に牛一頭、肥えた羊六頭を備え、また鶏をもわたしのために備え、十日ごとにたくさんのぶどう酒を備えたが、わたしはこの民の労役が重かったので、総督としての手当てを求めなかった。"},{"ref":"Neh.5.19","start":16005019,"end":16005019,"break":"none","ruby":[[2,1,"かみ"],[11,1,"たみ"],[22,1,"こと"],[24,1,"おぼ"],[33,1,"めぐ"]],"text":"わが神よ、わたしがこの民のためにしたすべての事を覚えて、わたしをお恵みください。"}]