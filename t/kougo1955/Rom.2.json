[{"ref":"Rom.2.1","start":45002001,"end":45002001,"break":"paragraph","ruby":[[10,1,"ひと"],[15,1,"もの"],[23,2,"べんかい"],[26,2,"よち"],[37,2,"たにん"],[50,2,"じぶん"],[52,2,"じしん"],[55,1,"つみ"],[57,1,"さだ"],[71,1,"おな"],[76,1,"おこな"]],"text":"だから、ああ、すべて人をさばく者よ。あなたには弁解の余地がない。あなたは、他人をさばくことによって、自分自身を罪に定めている。さばくあなたも、同じことを行っているからである。"},{"ref":"Rom.2.2","start":45002002,"end":45002002,"break":"none","ruby":[[7,1,"かみ"],[19,1,"こと"],[21,1,"おこな"],[23,1,"もの"],[27,1,"うえ"],[29,1,"ただ"],[32,1,"くだ"],[38,1,"し"]],"text":"わたしたちは、神のさばきが、このような事を行う者どもの上に正しく下ることを、知っている。"},{"ref":"Rom.2.3","start":45002003,"end":45002003,"break":"none","ruby":[[8,1,"こと"],[10,1,"おこな"],[12,1,"もの"],[26,1,"みずか"],[28,1,"おな"],[33,1,"おこな"],[35,1,"ひと"],[43,1,"かみ"],[55,1,"おも"]],"text":"ああ、このような事を行う者どもをさばきながら、しかも自ら同じことを行う人よ。あなたは、神のさばきをのがれうると思うのか。"},{"ref":"Rom.2.4","start":45002004,"end":45002004,"break":"none","ruby":[[5,1,"かみ"],[7,2,"じあい"],[14,2,"くいあらた"],[18,1,"みちび"],[23,1,"し"],[31,2,"じあい"],[34,2,"にんたい"],[37,2,"かんよう"],[41,1,"とみ"],[43,1,"かろ"]],"text":"それとも、神の慈愛があなたを悔改めに導くことも知らないで、その慈愛と忍耐と寛容との富を軽んじるのか。"},{"ref":"Rom.2.5","start":45002005,"end":45002005,"break":"none","ruby":[[10,2,"くいあらた"],[16,1,"こころ"],[27,1,"かみ"],[29,1,"ただ"],[36,1,"あらわ"],[39,1,"いか"],[42,1,"ひ"],[47,1,"かみ"],[49,1,"いか"],[53,2,"じぶん"],[56,1,"み"],[58,1,"つ"]],"text":"あなたのかたくなな、悔改めのない心のゆえに、あなたは、神の正しいさばきの現れる怒りの日のために神の怒りを、自分の身に積んでいるのである。"},{"ref":"Rom.2.6","start":45002006,"end":45002006,"break":"none","ruby":[[0,1,"かみ"],[19,1,"むく"]],"text":"神は、おのおのに、そのわざにしたがって報いられる。"},{"ref":"Rom.2.7","start":45002007,"end":45002007,"break":"none","ruby":[[5,2,"いっぽう"],[10,1,"た"],[12,1,"しの"],[15,1,"ぜん"],[17,1,"おこな"],[21,2,"こうえい"],[28,1,"く"],[35,1,"もと"],[38,1,"ひと"],[41,2,"えいえん"],[48,1,"あた"]],"text":"すなわち、一方では、耐え忍んで善を行って、光栄とほまれと朽ちぬものとを求める人に、永遠のいのちが与えられ、"},{"ref":"Rom.2.8","start":45002008,"end":45002008,"break":"none","ruby":[[0,2,"たほう"],[5,3,"とうはしん"],[13,2,"しんり"],[16,1,"したが"],[21,2,"ふぎ"],[24,1,"したが"],[26,1,"ひと"],[29,1,"いか"],[32,1,"はげ"],[35,1,"いきどお"],[39,1,"くわ"]],"text":"他方では、党派心をいだき、真理に従わないで不義に従う人に、怒りと激しい憤りとが加えられる。"},{"ref":"Rom.2.9","start":45002009,"end":45002009,"break":"none","ruby":[[0,1,"あく"],[2,1,"おこな"],[8,1,"ひと"],[15,1,"じん"],[24,1,"じん"],[28,2,"かんなん"],[31,2,"くのう"],[35,1,"あた"]],"text":"悪を行うすべての人には、ユダヤ人をはじめギリシヤ人にも、患難と苦悩とが与えられ、"},{"ref":"Rom.2.10","start":45002010,"end":45002010,"break":"none","ruby":[[0,1,"ぜん"],[2,1,"おこな"],[8,1,"ひと"],[15,1,"じん"],[24,1,"じん"],[28,2,"こうえい"],[35,2,"へいあん"],[39,1,"あた"]],"text":"善を行うすべての人には、ユダヤ人をはじめギリシヤ人にも、光栄とほまれと平安とが与えられる。"},{"ref":"Rom.2.11","start":45002011,"end":45002011,"break":"none","ruby":[[5,1,"かみ"],[13,1,"み"]],"text":"なぜなら、神には、かたより見ることがないからである。"},{"ref":"Rom.2.12","start":45002012,"end":45002012,"break":"paragraph","ruby":[[6,2,"りっぽう"],[11,1,"つみ"],[13,1,"おか"],[16,1,"もの"],[21,2,"りっぽう"],[26,1,"ほろ"],[29,2,"りっぽう"],[35,1,"つみ"],[37,1,"おか"],[40,1,"もの"],[43,2,"りっぽう"]],"text":"そのわけは、律法なしに罪を犯した者は、また律法なしに滅び、律法のもとで罪を犯した者は、律法によってさばかれる。"},{"ref":"Rom.2.13","start":45002013,"end":45002013,"break":"none","ruby":[[5,2,"りっぽう"],[8,1,"き"],[10,1,"もの"],[13,1,"かみ"],[15,1,"まえ"],[17,1,"ぎ"],[27,2,"りっぽう"],[30,1,"おこな"],[32,1,"もの"],[35,1,"ぎ"]],"text":"なぜなら、律法を聞く者が、神の前に義なるものではなく、律法を行う者が、義とされるからである。"},{"ref":"Rom.2.14","start":45002014,"end":45002014,"break":"none","ruby":[[5,2,"りっぽう"],[8,1,"も"],[12,3,"いほうじん"],[17,2,"しぜん"],[24,2,"りっぽう"],[27,1,"めい"],[30,1,"こと"],[32,1,"おこな"],[40,2,"りっぽう"],[43,1,"も"],[50,1,"かれ"],[57,2,"じぶん"],[59,2,"じしん"],[62,2,"りっぽう"]],"text":"すなわち、律法を持たない異邦人が、自然のままで、律法の命じる事を行うなら、たとい律法を持たなくても、彼らにとっては自分自身が律法なのである。"},{"ref":"Rom.2.15","start":45002015,"end":45002015,"break":"none","ruby":[[0,1,"かれ"],[3,2,"りっぽう"],[6,2,"ようきゅう"],[11,1,"こころ"],[23,1,"あらわ"],[31,1,"かれ"],[34,2,"りょうしん"],[37,1,"とも"],[48,2,"はんだん"],[51,1,"たがい"],[57,1,"うった"],[64,2,"べんめい"],[67,1,"あ"]],"text":"彼らは律法の要求がその心にしるされていることを現し、そのことを彼らの良心も共にあかしをして、その判断が互にあるいは訴え、あるいは弁明し合うのである。"},{"ref":"Rom.2.16","start":45002016,"end":45002016,"break":"none","ruby":[[16,2,"ふくいん"],[23,1,"かみ"],[37,2,"ひとびと"],[40,1,"かく"],[43,1,"こと"],[54,1,"ひ"],[57,1,"あき"]],"text":"そして、これらのことは、わたしの福音によれば、神がキリスト・イエスによって人々の隠れた事がらをさばかれるその日に、明らかにされるであろう。"},{"ref":"Rom.2.17","start":45002017,"end":45002017,"break":"paragraph","ruby":[[7,1,"みずか"],[12,1,"じん"],[14,1,"しょう"],[17,2,"りっぽう"],[20,1,"やす"],[24,1,"かみ"],[26,1,"ほこり"]],"text":"もしあなたが、自らユダヤ人と称し、律法に安んじ、神を誇とし、"},{"ref":"Rom.2.18","start":45002018,"end":45002018,"break":"none","ruby":[[0,2,"みむね"],[3,1,"し"],[6,2,"りっぽう"],[9,1,"おし"]],"text":"御旨を知り、律法に教えられて、なすべきことをわきまえており、"},{"ref":"Rom.2.19","start":45002019,"end":45002020,"break":"none","ruby":[[4,2,"ちしき"],[7,2,"しんり"],[11,2,"りっぽう"],[14,1,"なか"],[16,1,"かたち"],[27,1,"みずか"],[29,2,"もうじん"],[32,2,"てび"],[41,1,"もの"],[43,1,"ひかり"],[45,1,"おろ"],[48,1,"もの"],[50,1,"みちび"],[52,1,"て"],[54,1,"おさ"],[56,1,"ご"],[58,2,"きょうし"],[64,1,"にん"]],"text":"さらに、知識と真理とが律法の中に形をとっているとして、自ら盲人の手引き、やみにおる者の光、愚かな者の導き手、幼な子の教師をもって任じているのなら、"},{"ref":"Rom.2.21","start":45002021,"end":45002021,"break":"none","ruby":[[3,1,"ひと"],[5,1,"おし"],[8,2,"じぶん"],[11,1,"おし"],[18,1,"ぬす"],[22,1,"ひと"],[24,1,"と"],[28,1,"みずか"],[31,1,"ぬす"]],"text":"なぜ、人を教えて自分を教えないのか。盗むなと人に説いて、自らは盗むのか。"},{"ref":"Rom.2.22","start":45002022,"end":45002022,"break":"none","ruby":[[0,2,"かんいん"],[6,1,"い"],[10,1,"みずか"],[13,2,"かんいん"],[20,2,"ぐうぞう"],[23,1,"い"],[32,1,"みずか"],[35,1,"みや"],[37,1,"もの"]],"text":"姦淫するなと言って、自らは姦淫するのか。偶像を忌みきらいながら、自らは宮の物をかすめるのか。"},{"ref":"Rom.2.23","start":45002023,"end":45002023,"break":"none","ruby":[[0,2,"りっぽう"],[3,1,"ほこり"],[10,1,"みずか"],[13,2,"りっぽう"],[16,2,"いはん"],[21,1,"かみ"],[23,1,"あなど"]],"text":"律法を誇としながら、自らは律法に違反して、神を侮っているのか。"},{"ref":"Rom.2.24","start":45002024,"end":45002024,"break":"none","ruby":[[0,2,"せいしょ"],[3,1,"か"],[13,1,"かみ"],[15,2,"みな"],[29,3,"いほうじん"],[33,1,"あいだ"],[35,1,"けが"]],"text":"聖書に書いてあるとおり、「神の御名は、あなたがたのゆえに、異邦人の間で汚されている」。"},{"ref":"Rom.2.25","start":45002025,"end":45002025,"break":"none","ruby":[[7,2,"りっぽう"],[10,1,"おこな"],[20,2,"かつれい"],[23,1,"やく"],[25,1,"た"],[35,2,"りっぽう"],[38,1,"おか"],[47,2,"かつれい"],[50,1,"む"],[51,2,"かつれい"]],"text":"もし、あなたが律法を行うなら、なるほど、割礼は役に立とう。しかし、もし律法を犯すなら、あなたの割礼は無割礼となってしまう。"},{"ref":"Rom.2.26","start":45002026,"end":45002026,"break":"none","ruby":[[6,1,"む"],[7,2,"かつれい"],[10,1,"もの"],[12,2,"りっぽう"],[15,2,"きてい"],[18,1,"まも"],[25,1,"む"],[26,2,"かつれい"],[29,2,"かつれい"],[32,1,"み"]],"text":"だから、もし無割礼の者が律法の規定を守るなら、その無割礼は割礼と見なされるではないか。"},{"ref":"Rom.2.27","start":45002027,"end":45002027,"break":"none","ruby":[[3,1,"うま"],[8,1,"む"],[9,2,"かつれい"],[12,1,"もの"],[17,2,"りっぽう"],[20,1,"まっと"],[24,1,"もの"],[27,2,"りっぽう"],[30,2,"もんじ"],[33,2,"かつれい"],[37,1,"も"],[42,2,"りっぽう"],[45,1,"おか"]],"text":"かつ、生れながら無割礼の者であって律法を全うする者は、律法の文字と割礼とを持ちながら律法を犯しているあなたを、さばくのである。"},{"ref":"Rom.2.28","start":45002028,"end":45002028,"break":"none","ruby":[[6,2,"がいけん"],[8,1,"うえ"],[13,1,"じん"],[18,1,"じん"],[27,2,"がいけん"],[29,1,"うえ"],[31,1,"にく"],[36,2,"かつれい"],[39,2,"かつれい"]],"text":"というのは、外見上のユダヤ人がユダヤ人ではなく、また、外見上の肉における割礼が割礼でもない。"},{"ref":"Rom.2.29","start":45002029,"end":45002029,"break":"none","ruby":[[5,1,"かく"],[11,1,"じん"],[16,1,"じん"],[24,2,"もんじ"],[30,1,"れい"],[34,1,"こころ"],[36,2,"かつれい"],[40,2,"かつれい"],[53,1,"ひと"],[61,1,"かみ"],[64,1,"く"]],"text":"かえって、隠れたユダヤ人がユダヤ人であり、また、文字によらず霊による心の割礼こそ割礼であって、そのほまれは人からではなく、神から来るのである。"}]