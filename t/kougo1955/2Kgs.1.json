[{"ref":"2Kgs.1.1","start":12001001,"end":12001001,"break":"paragraph","ruby":[[4,1,"し"],[7,1,"のち"]],"text":"アハブが死んだ後、モアブはイスラエルにそむいた。"},{"ref":"2Kgs.1.2","start":12001002,"end":12001002,"break":"paragraph","ruby":[[14,2,"たかどの"],[23,1,"お"],[26,2,"びょうき"],[35,2,"ししゃ"],[44,1,"い"],[52,1,"かみ"],[64,2,"びょうき"],[75,1,"たず"],[80,1,"めい"]],"text":"さてアハジヤはサマリヤにある高殿のらんかんから落ちて病気になったので、使者をつかわし、「行ってエクロンの神バアル・ゼブブに、この病気がなおるかどうかを尋ねよ」と命じた。"},{"ref":"2Kgs.1.3","start":12001003,"end":12001003,"break":"none","ruby":[[0,1,"とき"],[3,1,"しゅ"],[5,1,"つかい"],[16,1,"い"],[21,1,"た"],[25,1,"のぼ"],[28,1,"い"],[36,1,"おう"],[38,2,"ししゃ"],[41,1,"あ"],[44,1,"い"],[62,1,"かみ"],[71,1,"たず"],[78,1,"い"],[89,1,"かみ"]],"text":"時に、主の使はテシベびとエリヤに言った、「立って、上って行き、サマリヤの王の使者に会って言いなさい、『あなたがたがエクロンの神バアル・ゼブブに尋ねようとして行くのは、イスラエルに神がないためか』。"},{"ref":"2Kgs.1.4","start":12001004,"end":12001004,"break":"none","ruby":[[4,1,"しゅ"],[8,1,"おお"],[20,1,"のぼ"],[23,2,"しんだい"],[27,1,"お"],[35,1,"かなら"],[37,1,"し"],[53,1,"のぼ"],[56,1,"い"]],"text":"それゆえ主はこう仰せられる、『あなたは、登った寝台から降りることなく、必ず死ぬであろう』」。そこでエリヤは上って行った。"},{"ref":"2Kgs.1.5","start":12001005,"end":12001005,"break":"paragraph","ruby":[[0,2,"ししゃ"],[13,1,"かえ"],[26,1,"かれ"],[29,1,"い"],[36,1,"かえ"]],"text":"使者たちがアハジヤのもとに帰ってきたので、アハジヤは彼らに言った、「なぜ帰ってきたのか」。"},{"ref":"2Kgs.1.6","start":12001006,"end":12001006,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[12,1,"ひと"],[14,1,"のぼ"],[25,1,"あ"],[28,1,"い"],[46,1,"おう"],[48,1,"ところ"],[50,1,"かえ"],[53,1,"い"],[59,1,"しゅ"],[63,1,"おお"],[78,1,"かみ"],[87,1,"たず"],[94,1,"ひと"],[109,1,"かみ"],[128,1,"のぼ"],[131,2,"しんだい"],[135,1,"お"],[143,1,"かなら"],[145,1,"し"]],"text":"彼らは言った、「ひとりの人が上ってきて、われわれに会って言いました、『おまえたちをつかわした王の所へ帰って言いなさい。主はこう仰せられる、あなたがエクロンの神バアル・ゼブブに尋ねようとして人をつかわすのは、イスラエルに神がないためなのか。それゆえあなたは、登った寝台から降りることなく、必ず死ぬであろう』」。"},{"ref":"2Kgs.1.7","start":12001007,"end":12001007,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[13,1,"のぼ"],[25,1,"あ"],[33,1,"こと"],[35,1,"つ"],[38,1,"ひと"],[43,1,"ひと"]],"text":"アハジヤは彼らに言った、「上ってきて、あなたがたに会って、これらの事を告げた人はどんな人であったか」。"},{"ref":"2Kgs.1.8","start":12001008,"end":12001008,"break":"none","ruby":[[0,1,"かれ"],[3,1,"こた"],[10,1,"ひと"],[12,1,"け"],[17,1,"き"],[20,1,"こし"],[22,1,"かわ"],[24,1,"おび"],[26,1,"し"],[35,1,"かれ"],[37,1,"い"],[44,1,"ひと"]],"text":"彼らは答えた、「その人は毛ごろもを着て、腰に皮の帯を締めていました」。彼は言った、「その人はテシべびとエリヤだ」。"},{"ref":"2Kgs.1.9","start":12001009,"end":12001009,"break":"paragraph","ruby":[[3,1,"おう"],[7,1,"にん"],[9,1,"ちょう"],[12,2,"ぶか"],[17,1,"にん"],[19,1,"とも"],[25,1,"ところ"],[33,1,"かれ"],[39,1,"ところ"],[41,1,"のぼ"],[52,1,"やま"],[54,1,"いただき"],[69,1,"い"],[74,1,"かみ"],[76,1,"ひと"],[79,1,"おう"],[86,1,"くだ"],[89,1,"く"],[95,1,"い"]],"text":"そこで王は五十人の長を、部下の五十人と共にエリヤの所へつかわした。彼がエリヤの所へ上っていくと、エリヤは山の頂にすわっていたので、エリヤに言った、「神の人よ、王があなたに、下って来るようにと言われます」。"},{"ref":"2Kgs.1.10","start":12001010,"end":12001010,"break":"none","ruby":[[9,1,"にん"],[11,1,"ちょう"],[13,1,"こた"],[24,1,"かみ"],[26,1,"ひと"],[34,1,"ひ"],[36,1,"てん"],[39,1,"くだ"],[47,2,"ぶか"],[52,1,"にん"],[55,1,"や"],[57,1,"つく"],[70,1,"ひ"],[72,1,"てん"],[75,1,"くだ"],[79,1,"かれ"],[81,2,"ぶか"],[86,1,"にん"],[89,1,"や"],[91,1,"つく"]],"text":"しかしエリヤは五十人の長に答えた、「わたしがもし神の人であるならば、火が天から下って、あなたと部下の五十人とを焼き尽すでしょう」。そのように火が天から下って、彼と部下の五十人とを焼き尽した。"},{"ref":"2Kgs.1.11","start":12001011,"end":12001011,"break":"paragraph","ruby":[[0,1,"おう"],[4,1,"た"],[8,1,"にん"],[10,1,"ちょう"],[13,2,"ぶか"],[18,1,"にん"],[20,1,"とも"],[32,1,"かれ"],[34,1,"のぼ"],[44,1,"い"],[49,1,"かみ"],[51,1,"ひと"],[54,1,"おう"],[58,1,"めい"],[71,1,"くだ"]],"text":"王はまた他の五十人の長を、部下の五十人と共にエリヤにつかわした。彼は上っていってエリヤに言った、「神の人よ、王がこう命じられます、『すみやかに下ってきなさい』」。"},{"ref":"2Kgs.1.12","start":12001012,"end":12001012,"break":"none","ruby":[[7,1,"かれ"],[10,1,"こた"],[21,1,"かみ"],[23,1,"ひと"],[31,1,"ひ"],[33,1,"てん"],[36,1,"くだ"],[44,2,"ぶか"],[49,1,"にん"],[52,1,"や"],[54,1,"つく"],[67,1,"かみ"],[69,1,"ひ"],[71,1,"てん"],[74,1,"くだ"],[78,1,"かれ"],[80,2,"ぶか"],[85,1,"にん"],[88,1,"や"],[90,1,"つく"]],"text":"しかしエリヤは彼らに答えた、「わたしがもし神の人であるならば、火が天から下って、あなたと部下の五十人とを焼き尽すでしょう」。そのように神の火が天から下って、彼と部下の五十人とを焼き尽した。"},{"ref":"2Kgs.1.13","start":12001013,"end":12001013,"break":"paragraph","ruby":[[0,1,"おう"],[4,1,"だい"],[9,1,"にん"],[11,1,"ちょう"],[13,2,"ぶか"],[18,1,"にん"],[20,1,"とも"],[28,1,"だい"],[33,1,"にん"],[35,1,"ちょう"],[37,1,"のぼ"],[48,1,"まえ"],[56,1,"かれ"],[58,1,"ねが"],[61,1,"い"],[66,1,"かみ"],[68,1,"ひと"],[79,1,"いのち"],[96,1,"にん"],[98,1,"いのち"],[104,1,"め"],[106,1,"たっと"]],"text":"王はまた第三の五十人の長を部下の五十人と共につかわした。第三の五十人の長は上っていって、エリヤの前にひざまずき、彼に願って言った、「神の人よ、どうぞ、わたしの命と、あなたのしもべであるこの五十人の命をあなたの目に尊いものとみなしてください。"},{"ref":"2Kgs.1.14","start":12001014,"end":12001014,"break":"none","ruby":[[7,1,"ひ"],[9,1,"てん"],[22,1,"にん"],[24,1,"ちょう"],[32,2,"ぶか"],[37,1,"にん"],[42,1,"や"],[44,1,"つく"],[53,1,"いま"],[58,1,"いのち"],[64,1,"め"],[66,1,"たっと"]],"text":"ごらんなさい、火が天からくだって、さきの五十人の長ふたりと、その部下の五十人ずつとを焼き尽しました。しかし今わたしの命をあなたの目に尊いものとみなしてください」。"},{"ref":"2Kgs.1.15","start":12001015,"end":12001015,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,1,"つかい"],[12,1,"い"],[17,1,"かれ"],[19,1,"とも"],[21,1,"くだ"],[27,1,"かれ"],[29,1,"おそ"],[46,1,"た"],[50,1,"かれ"],[52,1,"とも"],[54,1,"くだ"],[57,1,"おう"],[62,1,"い"]],"text":"その時、主の使はエリヤに言った、「彼と共に下りなさい。彼を恐れてはならない」。そこでエリヤは立って、彼と共に下り、王のもとへ行って、"},{"ref":"2Kgs.1.16","start":12001016,"end":12001016,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[7,1,"しゅ"],[11,1,"おお"],[28,1,"かみ"],[37,1,"たず"],[42,2,"ししゃ"],[64,2,"ことば"],[67,1,"もと"],[71,1,"かみ"],[91,1,"のぼ"],[94,2,"しんだい"],[98,1,"お"],[106,1,"かなら"],[108,1,"し"]],"text":"王に言った、「主はこう仰せられます、『あなたはエクロンの神バアル・ゼブブに尋ねようと使者をつかわしたが、それはイスラエルに、その言葉を求むべき神がないためであるか。それゆえあなたは、登った寝台から降りることなく、必ず死ぬであろう』」。"},{"ref":"2Kgs.1.17","start":12001017,"end":12001017,"break":"paragraph","ruby":[[0,1,"かれ"],[6,1,"い"],[9,1,"しゅ"],[11,2,"ことば"],[18,1,"し"],[23,1,"かれ"],[25,1,"こ"],[36,2,"きょうだい"],[42,1,"かれ"],[44,1,"かわ"],[47,1,"おう"],[59,1,"おう"],[66,1,"こ"],[71,1,"だい"],[73,1,"ねん"]],"text":"彼はエリヤが言った主の言葉のとおりに死んだが、彼に子がなかったので、その兄弟ヨラムが彼に代って王となった。これはユダの王ヨシャパテの子ヨラムの第二年である。"},{"ref":"2Kgs.1.18","start":12001018,"end":12001018,"break":"none","ruby":[[7,1,"た"],[9,2,"じせき"],[19,1,"おう"],[21,3,"れきだいし"],[25,1,"しょ"]],"text":"アハジヤのその他の事績は、イスラエルの王の歴代志の書にしるされているではないか。"}]