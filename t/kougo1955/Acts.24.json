[{"ref":"Acts.24.1","start":44024001,"end":44024001,"break":"paragraph","ruby":[[1,1,"か"],[3,1,"のち"],[5,3,"だいさいし"],[14,2,"ちょうろう"],[16,2,"すうめい"],[27,3,"べんごにん"],[32,1,"つ"],[35,1,"くだ"],[38,2,"そうとく"],[45,1,"うった"],[47,1,"で"]],"text":"五日の後、大祭司アナニヤは、長老数名と、テルトロという弁護人とを連れて下り、総督にパウロを訴え出た。"},{"ref":"Acts.24.2","start":44024002,"end":44024002,"break":"none","breaks":[[25,"paragraph"]],"ruby":[[4,1,"よ"],[6,1,"だ"],[18,2,"ろんこく"],[21,1,"はじ"],[30,2,"かっか"],[40,2,"かっか"],[44,1,"かげ"],[52,2,"へいわ"],[55,1,"たの"],[63,1,"くに"],[67,2,"はいりょ"]],"text":"パウロが呼び出されたので、テルトロは論告を始めた。「ペリクス閣下、わたしたちが、閣下のお陰でじゅうぶんに平和を楽しみ、またこの国が、ご配慮によって、"},{"ref":"Acts.24.3","start":44024003,"end":44024003,"break":"none","ruby":[[4,2,"ほうめん"],[17,2,"かいぜん"],[34,2,"かんしゃ"]],"text":"あらゆる方面に、またいたるところで改善されていることは、わたしたちの感謝してやまないところであります。"},{"ref":"Acts.24.4","start":44024004,"end":44024004,"break":"none","ruby":[[5,2,"めいわく"],[21,1,"の"],[26,2,"てみじか"],[30,1,"もう"],[32,1,"あ"],[43,1,"しの"],[47,1,"き"],[49,1,"と"],[56,1,"ねが"]],"text":"しかし、ご迷惑をかけないように、くどくどと述べずに、手短かに申し上げますから、どうぞ、忍んでお聞き取りのほど、お願いいたします。"},{"ref":"Acts.24.5","start":44024005,"end":44024005,"break":"none","ruby":[[5,1,"おとこ"],[8,2,"えきびょう"],[14,2,"にんげん"],[18,3,"せかいじゅう"],[29,1,"じん"],[31,1,"なか"],[33,1,"さわ"],[36,1,"おこ"],[41,1,"もの"],[52,1,"びと"],[55,2,"いたん"]],"text":"さて、この男は、疫病のような人間で、世界中のすべてのユダヤ人の中に騒ぎを起している者であり、また、ナザレ人らの異端のかしらであります。"},{"ref":"Acts.24.6","start":44024006,"end":44024006,"break":"none","ruby":[[2,1,"もの"],[4,1,"みや"],[8,1,"けが"],[25,1,"かれ"],[27,2,"ほばく"],[40,2,"りっぽう"]],"text":"この者が宮までも汚そうとしていたので、わたしたちは彼を捕縛したのです。〔そして、律法にしたがって、さばこうとしていたところ、"},{"ref":"Acts.24.7","start":44024007,"end":44024007,"break":"none","ruby":[[0,3,"せんそつちょう"],[7,2,"かんしょう"],[12,1,"かれ"],[14,2,"むり"],[23,1,"て"],[26,1,"ひ"],[28,1,"はな"]],"text":"千卒長ルシヤが干渉して、彼を無理にわたしたちの手から引き離してしまい、"},{"ref":"Acts.24.8","start":44024008,"end":44024008,"break":"none","ruby":[[0,1,"かれ"],[2,1,"うった"],[5,1,"ひと"],[11,2,"かっか"],[18,1,"く"],[24,1,"めい"],[35,2,"かっか"],[38,2,"じしん"],[42,1,"しら"],[55,1,"かれ"],[57,1,"うった"],[59,1,"で"],[61,2,"りゆう"],[65,2,"ぜんぶ"]],"text":"彼を訴えた人たちには、閣下のところに来るようにと命じました。〕それで、閣下ご自身でお調べになれば、わたしたちが彼を訴え出た理由が、全部おわかりになるでしょう」。"},{"ref":"Acts.24.9","start":44024009,"end":44024009,"break":"none","ruby":[[3,1,"じん"],[10,1,"うった"],[13,2,"どうちょう"],[18,1,"まった"],[27,1,"い"]],"text":"ユダヤ人たちも、この訴えに同調して、全くそのとおりだと言った。"},{"ref":"Acts.24.10","start":44024010,"end":44024010,"break":"none","breaks":[[33,"paragraph"]],"ruby":[[4,2,"そうとく"],[7,2,"あいず"],[12,2,"はつげん"],[15,1,"うなが"],[25,2,"とうべん"],[29,1,"い"],[34,2,"かっか"],[38,2,"たねん"],[47,2,"こくみん"],[50,2,"さいばん"],[69,2,"しょうち"],[83,1,"よろこ"],[87,2,"じぶん"],[93,2,"べんめい"]],"text":"そこで、総督が合図をして発言を促したので、パウロは答弁して言った。「閣下が、多年にわたり、この国民の裁判をつかさどっておられることを、よく承知していますので、わたしは喜んで、自分のことを弁明いたします。"},{"ref":"Acts.24.11","start":44024011,"end":44024011,"break":"none","ruby":[[1,1,"しら"],[20,2,"れいはい"],[31,1,"のぼ"],[41,1,"にち"]],"text":"お調べになればわかるはずですが、わたしが礼拝をしにエルサレムに上ってから、まだ十二日そこそこにしかなりません。"},{"ref":"Acts.24.12","start":44024012,"end":44024012,"break":"none","ruby":[[4,1,"みや"],[6,1,"うち"],[10,2,"かいどう"],[12,1,"うち"],[20,2,"しない"],[33,2,"そうろん"],[39,2,"ぐんしゅう"],[42,2,"せんどう"],[51,1,"み"]],"text":"そして、宮の内でも、会堂内でも、あるいは市内でも、わたしがだれかと争論したり、群衆を煽動したりするのを見たものはありませんし、"},{"ref":"Acts.24.13","start":44024013,"end":44024013,"break":"none","ruby":[[0,1,"いま"],[5,1,"うった"],[7,1,"で"],[18,2,"かっか"],[21,1,"まえ"],[26,2,"しょうこ"]],"text":"今わたしを訴え出ていることについて、閣下の前に、その証拠をあげうるものはありません。"},{"ref":"Acts.24.14","start":44024014,"end":44024014,"break":"none","ruby":[[9,1,"こと"],[11,1,"みと"],[21,1,"かれ"],[24,2,"いたん"],[32,1,"みち"],[46,2,"せんぞ"],[49,1,"かみ"],[51,1,"つか"],[54,2,"りっぽう"],[57,1,"おし"],[66,3,"よげんしゃ"],[70,1,"しょ"],[72,1,"か"],[86,1,"しん"]],"text":"ただ、わたしはこの事は認めます。わたしは、彼らが異端だとしている道にしたがって、わたしたちの先祖の神に仕え、律法の教えるところ、また預言者の書に書いてあることを、ことごとく信じ、"},{"ref":"Acts.24.15","start":44024015,"end":44024015,"break":"none","ruby":[[3,1,"ただ"],[6,1,"もの"],[8,1,"ただ"],[13,1,"もの"],[26,2,"きぼう"],[30,1,"かみ"],[32,1,"あお"],[48,2,"きぼう"],[52,1,"かれ"],[54,2,"じしん"],[57,1,"も"]],"text":"また、正しい者も正しくない者も、やがてよみがえるとの希望を、神を仰いでいだいているものです。この希望は、彼ら自身も持っているのです。"},{"ref":"Acts.24.16","start":44024016,"end":44024016,"break":"none","ruby":[[7,1,"かみ"],[9,1,"たい"],[13,1,"ひと"],[15,1,"たい"],[19,2,"りょうしん"],[22,1,"せ"],[36,1,"つね"],[38,1,"つと"]],"text":"わたしはまた、神に対しまた人に対して、良心に責められることのないように、常に努めています。"},{"ref":"Acts.24.17","start":44024017,"end":44024017,"break":"none","ruby":[[7,2,"いくねん"],[13,1,"かえ"],[19,2,"どうほう"],[22,1,"ほどこ"],[30,1,"そな"],[32,1,"もの"]],"text":"さてわたしは、幾年ぶりかに帰ってきて、同胞に施しをし、また、供え物をしていました。"},{"ref":"Acts.24.18","start":44024018,"end":44024018,"break":"none","ruby":[[5,1,"かれ"],[12,1,"みや"],[18,1,"おこな"],[25,1,"み"],[34,2,"ぐんしゅう"],[40,2,"そうどう"]],"text":"そのとき、彼らはわたしが宮できよめを行っているのを見ただけであって、群衆もいず、騒動もなかったのです。"},{"ref":"Acts.24.19","start":44024019,"end":44024019,"break":"none","ruby":[[12,2,"すうにん"],[18,1,"じん"],[22,1,"かれ"],[30,1,"たい"],[34,1,"なに"],[39,1,"た"],[57,2,"かっか"],[60,1,"まえ"],[65,1,"うった"]],"text":"ところが、アジヤからきた数人のユダヤ人が――彼らが、わたしに対して、何かとがめ立てをすることがあったなら、よろしく閣下の前にきて、訴えるべきでした。"},{"ref":"Acts.24.20","start":44024020,"end":44024020,"break":"none","ruby":[[5,1,"なに"],[11,2,"ふせい"],[27,2,"ぎかい"],[30,1,"まえ"],[32,1,"た"],[37,1,"とき"],[39,1,"かれ"],[49,2,"してき"]],"text":"あるいは、何かわたしに不正なことがあったなら、わたしが議会の前に立っていた時、彼らみずから、それを指摘すべきでした。"},{"ref":"Acts.24.21","start":44024021,"end":44024021,"break":"none","ruby":[[8,1,"かれ"],[11,1,"なか"],[13,1,"た"],[23,2,"しにん"],[46,1,"まえ"],[52,1,"う"],[61,1,"さけ"]],"text":"ただ、わたしは、彼らの中に立って、『わたしは、死人のよみがえりのことで、きょう、あなたがたの前でさばきを受けているのだ』と叫んだだけのことです」。"},{"ref":"Acts.24.22","start":44024022,"end":44024022,"break":"paragraph","ruby":[[11,1,"みち"],[16,2,"そうとう"],[29,3,"せんそつちょう"],[36,1,"くだ"],[39,1,"く"],[43,1,"ま"],[53,2,"じけん"],[56,2,"はんけつ"],[67,1,"い"],[71,2,"さいばん"],[74,2,"えんき"]],"text":"ここでペリクスは、この道のことを相当わきまえていたので、「千卒長ルシヤが下って来るのを待って、おまえたちの事件を判決することにする」と言って、裁判を延期した。"},{"ref":"Acts.24.23","start":44024023,"end":44024023,"break":"none","ruby":[[3,3,"ひゃくそつちょう"],[12,2,"かんきん"],[23,1,"かれ"],[25,2,"かんだい"],[28,1,"と"],[30,1,"あつか"],[33,2,"ゆうじん"],[37,2,"せわ"],[44,1,"と"],[53,1,"めい"]],"text":"そして百卒長に、パウロを監禁するように、しかし彼を寛大に取り扱い、友人らが世話をするのを止めないようにと、命じた。"},{"ref":"Acts.24.24","start":44024024,"end":44024024,"break":"paragraph","ruby":[[0,2,"すうじつ"],[17,1,"じん"],[21,1,"つま"],[27,2,"いっしょ"],[37,1,"よ"],[39,1,"だ"],[51,1,"たい"],[54,2,"しんこう"],[61,1,"かれ"],[64,1,"き"]],"text":"数日たってから、ペリクスは、ユダヤ人である妻ドルシラと一緒にきて、パウロを呼び出し、キリスト・イエスに対する信仰のことを、彼から聞いた。"},{"ref":"Acts.24.25","start":44024025,"end":44024025,"break":"none","ruby":[[9,2,"せいぎ"],[12,2,"せっせい"],[15,2,"みらい"],[18,2,"しんぱん"],[26,1,"ろん"],[38,2,"ふあん"],[41,1,"かん"],[47,1,"い"],[59,1,"かえ"],[70,2,"きかい"],[73,1,"え"],[77,1,"よ"],[79,1,"だ"]],"text":"そこで、パウロが、正義、節制、未来の審判などについて論じていると、ペリクスは不安を感じてきて、言った、「きょうはこれで帰るがよい。また、よい機会を得たら、呼び出すことにする」。"},{"ref":"Acts.24.26","start":44024026,"end":44024026,"break":"none","ruby":[[0,1,"かれ"],[6,2,"どうじ"],[15,1,"かね"],[22,1,"した"],[41,1,"よ"],[43,1,"だ"],[47,1,"かた"],[49,1,"あ"]],"text":"彼は、それと同時に、パウロから金をもらいたい下ごころがあったので、たびたびパウロを呼び出しては語り合った。"},{"ref":"Acts.24.27","start":44024027,"end":44024027,"break":"paragraph","ruby":[[5,1,"ねん"],[9,1,"とき"],[27,2,"こうたい"],[31,1,"にん"],[46,1,"じん"],[48,2,"かんしん"],[51,1,"か"],[55,1,"おも"],[63,2,"かんきん"]],"text":"さて、二か年たった時、ポルキオ・フェストが、ペリクスと交代して任についた。ペリクスは、ユダヤ人の歓心を買おうと思って、パウロを監禁したままにしておいた。"}]