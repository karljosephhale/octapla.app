[{"ref":"1Cor.3.1","start":46003001,"end":46003001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[18,1,"れい"],[20,1,"ひと"],[22,1,"たい"],[28,1,"はな"],[41,1,"にく"],[43,1,"ぞく"],[46,1,"もの"],[60,1,"おさ"],[62,1,"ご"],[64,1,"はな"],[69,1,"はな"]],"text":"兄弟たちよ。わたしはあなたがたには、霊の人に対するように話すことができず、むしろ、肉に属する者、すなわち、キリストにある幼な子に話すように話した。"},{"ref":"1Cor.3.2","start":46003002,"end":46003002,"break":"none","ruby":[[6,1,"ちち"],[8,1,"の"],[13,1,"かた"],[15,2,"しょくもつ"],[18,1,"あた"],[25,1,"た"],[28,1,"ちから"],[49,1,"いま"],[57,1,"ちから"]],"text":"あなたがたに乳を飲ませて、堅い食物は与えなかった。食べる力が、まだあなたがたになかったからである。今になってもその力がない。"},{"ref":"1Cor.3.3","start":46003003,"end":46003003,"break":"none","ruby":[[9,1,"にく"],[11,1,"ひと"],[25,1,"あいだ"],[32,1,"あらそ"],[46,1,"にく"],[48,1,"ひと"],[54,2,"ふつう"],[57,2,"にんげん"],[63,1,"ある"]],"text":"あなたがたはまだ、肉の人だからである。あなたがたの間に、ねたみや争いがあるのは、あなたがたが肉の人であって、普通の人間のように歩いているためではないか。"},{"ref":"1Cor.3.4","start":46003004,"end":46003004,"break":"none","ruby":[[7,1,"ひと"],[20,1,"い"],[26,1,"ひと"],[39,1,"い"],[55,2,"ふつう"],[58,2,"にんげん"]],"text":"すなわち、ある人は「わたしはパウロに」と言い、ほかの人は「わたしはアポロに」と言っているようでは、あなたがたは普通の人間ではないか。"},{"ref":"1Cor.3.5","start":46003005,"end":46003005,"break":"none","ruby":[[10,2,"なにもの"],[21,2,"なにもの"],[31,2,"しんこう"],[34,1,"みちび"],[37,1,"ひと"],[52,1,"しゅ"],[55,1,"あた"],[60,1,"ぶん"],[62,1,"おう"],[65,1,"つか"]],"text":"アポロは、いったい、何者か。また、パウロは何者か。あなたがたを信仰に導いた人にすぎない。しかもそれぞれ、主から与えられた分に応じて仕えているのである。"},{"ref":"1Cor.3.6","start":46003006,"end":46003006,"break":"none","ruby":[[4,1,"う"],[11,1,"みず"],[21,2,"せいちょう"],[26,1,"くだ"],[32,1,"かみ"]],"text":"わたしは植え、アポロは水をそそいだ。しかし成長させて下さるのは、神である。"},{"ref":"1Cor.3.7","start":46003007,"end":46003007,"break":"none","ruby":[[4,1,"う"],[7,1,"もの"],[9,1,"みず"],[14,1,"もの"],[20,1,"と"],[23,1,"た"],[28,2,"だいじ"],[34,2,"せいちょう"],[39,1,"くだ"],[42,1,"かみ"]],"text":"だから、植える者も水をそそぐ者も、ともに取るに足りない。大事なのは、成長させて下さる神のみである。"},{"ref":"1Cor.3.8","start":46003008,"end":46003008,"break":"none","ruby":[[0,1,"う"],[3,1,"もの"],[5,1,"みず"],[10,1,"もの"],[26,1,"はたら"],[29,1,"おう"],[32,2,"ほうしゅう"],[35,1,"え"]],"text":"植える者と水をそそぐ者とは一つであって、それぞれその働きに応じて報酬を得るであろう。"},{"ref":"1Cor.3.9","start":46003009,"end":46003009,"break":"none","ruby":[[6,1,"かみ"],[8,3,"どうろうしゃ"],[21,1,"かみ"],[23,1,"はたけ"],[28,1,"かみ"],[30,2,"たてもの"]],"text":"わたしたちは神の同労者である。あなたがたは神の畑であり、神の建物である。"},{"ref":"1Cor.3.10","start":46003010,"end":46003010,"break":"paragraph","ruby":[[0,1,"かみ"],[3,1,"たま"],[7,1,"めぐ"],[18,2,"じゅくれん"],[22,2,"けんちく"],[24,1,"し"],[30,2,"どだい"],[40,1,"た"],[42,1,"ひと"],[46,1,"うえ"],[48,1,"いえ"],[50,1,"た"],[69,1,"た"],[78,1,"き"]],"text":"神から賜わった恵みによって、わたしは熟練した建築師のように、土台をすえた。そして他の人がその上に家を建てるのである。しかし、どういうふうに建てるか、それぞれ気をつけるがよい。"},{"ref":"1Cor.3.11","start":46003011,"end":46003011,"break":"none","ruby":[[15,2,"どだい"],[17,2,"いがい"],[45,2,"どだい"]],"text":"なぜなら、すでにすえられている土台以外のものをすえることは、だれにもできない。そして、この土台はイエス・キリストである。"},{"ref":"1Cor.3.12","start":46003012,"end":46003012,"break":"none","ruby":[[2,2,"どだい"],[5,1,"うえ"],[12,1,"きん"],[14,1,"ぎん"],[16,2,"ほうせき"],[19,1,"き"],[21,1,"くさ"],[30,1,"もち"],[33,1,"た"]],"text":"この土台の上に、だれかが金、銀、宝石、木、草、または、わらを用いて建てるならば、"},{"ref":"1Cor.3.13","start":46003013,"end":46003013,"break":"none","ruby":[[5,2,"しごと"],[28,1,"ひ"],[30,1,"ひ"],[32,1,"なか"],[34,1,"あらわ"],[41,1,"あき"],[51,1,"ひ"],[59,2,"しごと"]],"text":"それぞれの仕事は、はっきりとわかってくる。すなわち、かの日は火の中に現れて、それを明らかにし、またその火は、それぞれの仕事がどんなものであるかを、ためすであろう。"},{"ref":"1Cor.3.14","start":46003014,"end":46003014,"break":"none","ruby":[[4,1,"ひと"],[6,1,"た"],[9,2,"しごと"],[22,1,"ひと"],[24,2,"ほうしゅう"],[27,1,"う"]],"text":"もしある人の建てた仕事がそのまま残れば、その人は報酬を受けるが、"},{"ref":"1Cor.3.15","start":46003015,"end":46003015,"break":"none","ruby":[[2,2,"しごと"],[5,1,"や"],[13,2,"そんしつ"],[16,1,"こうむ"],[26,1,"かれ"],[27,2,"じしん"],[31,1,"ひ"],[33,1,"なか"],[41,1,"もの"],[52,1,"すく"]],"text":"その仕事が焼けてしまえば、損失を被るであろう。しかし彼自身は、火の中をくぐってきた者のようにではあるが、救われるであろう。"},{"ref":"1Cor.3.16","start":46003016,"end":46003016,"break":"paragraph","ruby":[[6,1,"かみ"],[8,1,"みや"],[14,1,"かみ"],[16,2,"みたま"],[19,2,"じぶん"],[25,1,"やど"],[33,1,"し"]],"text":"あなたがたは神の宮であって、神の御霊が自分のうちに宿っていることを知らないのか。"},{"ref":"1Cor.3.17","start":46003017,"end":46003017,"break":"none","ruby":[[2,1,"ひと"],[5,1,"かみ"],[7,1,"みや"],[9,2,"はかい"],[16,1,"かみ"],[20,1,"ひと"],[22,1,"ほろ"],[35,1,"かみ"],[37,1,"みや"],[39,1,"せい"],[60,1,"みや"]],"text":"もし人が、神の宮を破壊するなら、神はその人を滅ぼすであろう。なぜなら、神の宮は聖なるものであり、そして、あなたがたはその宮なのだからである。"},{"ref":"1Cor.3.18","start":46003018,"end":46003018,"break":"paragraph","ruby":[[3,2,"じぶん"],[6,1,"あざむ"],[27,2,"じぶん"],[32,1,"よ"],[34,2,"ちしゃ"],[38,1,"おも"],[40,1,"ひと"],[49,1,"ひと"],[51,2,"ちしゃ"],[59,1,"おろ"]],"text":"だれも自分を欺いてはならない。もしあなたがたのうちに、自分がこの世の知者だと思う人がいるなら、その人は知者になるために愚かになるがよい。"},{"ref":"1Cor.3.19","start":46003019,"end":46003019,"break":"none","ruby":[[7,1,"よ"],[9,2,"ちえ"],[13,1,"かみ"],[15,1,"まえ"],[18,1,"おろ"],[31,1,"かみ"],[34,2,"ちしゃ"],[41,3,"わるぢえ"],[48,1,"とら"],[53,1,"か"]],"text":"なぜなら、この世の知恵は、神の前では愚かなものだからである。「神は、知者たちをその悪知恵によって捕える」と書いてあり、"},{"ref":"1Cor.3.20","start":46003020,"end":46003020,"break":"none","ruby":[[0,1,"さら"],[6,1,"しゅ"],[9,2,"ちしゃ"],[14,2,"ろんぎ"],[25,1,"ぞん"],[32,1,"か"]],"text":"更にまた、「主は、知者たちの論議のむなしいことをご存じである」と書いてある。"},{"ref":"1Cor.3.21","start":46003021,"end":46003021,"break":"none","ruby":[[7,2,"にんげん"],[10,1,"ほこ"]],"text":"だから、だれも人間を誇ってはいけない。すべては、あなたがたのものなのである。"},{"ref":"1Cor.3.22","start":46003022,"end":46003022,"break":"none","ruby":[[14,2,"せかい"],[18,1,"せい"],[21,1,"し"],[24,2,"げんざい"],[31,2,"しょうらい"]],"text":"パウロも、アポロも、ケパも、世界も、生も、死も、現在のものも、将来のものも、ことごとく、あなたがたのものである。"},{"ref":"1Cor.3.23","start":46003023,"end":46003023,"break":"none","ruby":[[23,1,"かみ"]],"text":"そして、あなたがたはキリストのもの、キリストは神のものである。"}]