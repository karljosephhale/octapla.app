[{"ref":"Gen.34.1","start":1034001,"end":1034001,"break":"paragraph","ruby":[[7,1,"う"],[10,1,"むすめ"],[16,1,"ち"],[18,1,"おんな"],[22,1,"あ"],[26,1,"で"],[30,1,"い"]],"text":"レアがヤコブに産んだ娘デナはその地の女たちに会おうと出かけて行ったが、"},{"ref":"Gen.34.2","start":1034002,"end":1034002,"break":"none","ruby":[[2,1,"ち"],[16,1,"こ"],[21,2,"かのじょ"],[24,1,"み"],[27,1,"ひ"],[29,1,"い"],[35,1,"ね"]],"text":"その地のつかさ、ヒビびとハモルの子シケムが彼女を見て、引き入れ、これと寝てはずかしめた。"},{"ref":"Gen.34.3","start":1034003,"end":1034003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ふか"],[8,1,"むすめ"],[12,1,"した"],[17,1,"むすめ"],[19,1,"あい"],[28,1,"むすめ"],[30,1,"かた"]],"text":"彼は深くヤコブの娘デナを慕い、この娘を愛して、ねんごろに娘に語った。"},{"ref":"Gen.34.4","start":1034004,"end":1034004,"break":"none","ruby":[[4,1,"ちち"],[9,1,"い"],[16,1,"むすめ"],[22,1,"つま"]],"text":"シケムは父ハモルに言った、「この娘をわたしの妻にめとってください」。"},{"ref":"Gen.34.5","start":1034005,"end":1034005,"break":"none","ruby":[[11,1,"むすめ"],[15,1,"けが"],[21,1,"き"],[31,1,"こ"],[34,2,"かちく"],[37,1,"つ"],[40,1,"の"],[47,1,"かれ"],[50,1,"かえ"],[54,1,"だま"]],"text":"さてヤコブはシケムが、娘デナを汚したことを聞いたけれども、その子らが家畜を連れて野にいたので、彼らの帰るまで黙っていた。"},{"ref":"Gen.34.6","start":1034006,"end":1034006,"break":"none","ruby":[[4,1,"ちち"],[13,1,"はな"],[15,1,"あ"],[24,1,"ところ"],[26,1,"で"]],"text":"シケムの父ハモルはヤコブと話し合おうと、ヤコブの所に出てきた。"},{"ref":"Gen.34.7","start":1034007,"end":1034007,"break":"none","ruby":[[4,1,"こ"],[7,1,"の"],[10,1,"かえ"],[15,1,"こと"],[17,1,"き"],[21,1,"かな"],[27,2,"ひじょう"],[30,1,"いか"],[42,1,"むすめ"],[44,1,"ね"],[53,1,"おろ"],[78,1,"こと"]],"text":"ヤコブの子らは野から帰り、この事を聞いて、悲しみ、かつ非常に怒った。シケムがヤコブの娘と寝て、イスラエルに愚かなことをしたためで、こんなことは、してはならぬ事だからである。"},{"ref":"Gen.34.8","start":1034008,"end":1034008,"break":"paragraph","ruby":[[4,1,"かれ"],[7,1,"かた"],[10,1,"い"],[19,1,"こ"],[30,1,"むすめ"],[32,1,"こころ"],[34,1,"した"],[44,2,"かのじょ"],[47,1,"かれ"],[49,1,"つま"]],"text":"ハモルは彼らと語って言った、「わたしの子シケムはあなたがたの娘を心に慕っています。どうか彼女を彼の妻にください。"},{"ref":"Gen.34.9","start":1034009,"end":1034009,"break":"none","ruby":[[12,2,"こんいん"],[22,1,"むすめ"],[30,1,"あた"],[39,1,"むすめ"]],"text":"あなたがたはわたしたちと婚姻し、あなたがたの娘をわたしたちに与え、わたしたちの娘をあなたがたにめとってください。"},{"ref":"Gen.34.10","start":1034010,"end":1034010,"break":"none","ruby":[[17,2,"いっしょ"],[20,1,"す"],[27,1,"ち"],[35,1,"まえ"],[45,1,"す"],[48,2,"とりひき"],[55,2,"ざいさん"],[58,1,"え"]],"text":"こうしてあなたがたとわたしたちとは一緒に住みましょう。地はあなたがたの前にあります。ここに住んで取引し、ここで財産を獲なさい」。"},{"ref":"Gen.34.11","start":1034011,"end":1034011,"break":"none","ruby":[[9,1,"ちち"],[11,2,"きょうだい"],[17,1,"い"],[28,1,"まえ"],[30,1,"めぐ"],[33,1,"え"],[52,1,"い"]],"text":"シケムはまたデナの父と兄弟たちとに言った、「あなたがたの前に恵みを得させてください。あなたがたがわたしに言われるものは、なんでもさしあげましょう。"},{"ref":"Gen.34.12","start":1034012,"end":1034012,"break":"none","ruby":[[5,2,"ゆいのう"],[7,1,"きん"],[9,1,"おく"],[11,1,"もの"],[15,1,"もと"],[29,1,"い"],[47,1,"むすめ"],[53,1,"つま"]],"text":"たくさんの結納金と贈り物とをお求めになっても、あなたがたの言われるとおりさしあげます。ただこの娘はわたしの妻にください」。"},{"ref":"Gen.34.13","start":1034013,"end":1034013,"break":"paragraph","ruby":[[8,1,"こ"],[15,1,"かれ"],[18,1,"いもうと"],[22,1,"けが"],[34,1,"ちち"],[39,1,"いつわ"],[42,1,"こた"]],"text":"しかし、ヤコブの子らはシケムが彼らの妹デナを汚したので、シケムとその父ハモルに偽って答え、"},{"ref":"Gen.34.14","start":1034014,"end":1034014,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[13,2,"かつれい"],[16,1,"う"],[20,1,"もの"],[22,1,"いもうと"],[26,1,"こと"],[42,1,"はじ"]],"text":"彼らに言った、「われわれは割礼を受けない者に妹をやる事はできません。それはわれわれの恥とするところですから。"},{"ref":"Gen.34.15","start":1034015,"end":1034015,"break":"none","ruby":[[20,2,"どうい"],[36,2,"だんし"],[41,2,"かつれい"],[44,1,"う"]],"text":"ただ、こうなさればわれわれはあなたがたに同意します。もしあなたがたのうち男子がみな割礼を受けて、われわれのようになるなら、"},{"ref":"Gen.34.16","start":1034016,"end":1034016,"break":"none","ruby":[[5,1,"むすめ"],[13,1,"あた"],[22,1,"むすめ"],[51,2,"いっしょ"],[54,1,"す"],[60,1,"たみ"]],"text":"われわれの娘をあなたがたに与え、あなたがたの娘をわれわれにめとりましょう。そしてわれわれはあなたがたと一緒に住んで一つの民となりましょう。"},{"ref":"Gen.34.17","start":1034017,"end":1034017,"break":"none","ruby":[[18,1,"き"],[22,2,"かつれい"],[25,1,"う"],[37,1,"むすめ"],[39,1,"つ"],[42,1,"い"]],"text":"けれども、もしあなたがたがわれわれに聞かず、割礼を受けないなら、われわれは娘を連れて行きます」。"},{"ref":"Gen.34.18","start":1034018,"end":1034018,"break":"paragraph","ruby":[[0,1,"かれ"],[3,2,"ことば"],[14,1,"こ"],[20,1,"こころ"]],"text":"彼らの言葉がハモルとハモルの子シケムとの心にかなったので、"},{"ref":"Gen.34.19","start":1034019,"end":1034019,"break":"none","ruby":[[0,2,"わかもの"],[12,1,"こと"],[17,1,"かれ"],[23,1,"むすめ"],[25,1,"あい"],[36,1,"かれ"],[38,1,"ちち"],[40,1,"いえ"],[46,1,"ばん"],[47,1,"おも"],[53,1,"もの"]],"text":"若者は、ためらわずにこの事をした。彼がヤコブの娘を愛したからである。また彼は父の家のうちで一番重んじられた者であった。"},{"ref":"Gen.34.20","start":1034020,"end":1034020,"break":"none","ruby":[[9,1,"こ"],[15,1,"まち"],[17,1,"もん"],[19,1,"い"],[22,1,"まち"],[24,2,"ひとびと"],[27,1,"かた"],[30,1,"い"]],"text":"そこでハモルとその子シケムとは町の門に行き、町の人々に語って言った、"},{"ref":"Gen.34.21","start":1034021,"end":1034021,"break":"none","ruby":[[3,2,"ひとびと"],[11,1,"した"],[19,1,"ち"],[21,1,"す"],[30,2,"とりひき"],[38,1,"ち"],[40,1,"ひろ"],[43,1,"かれ"],[67,1,"かれ"],[70,1,"むすめ"],[72,1,"つま"],[83,1,"むすめ"],[85,1,"かれ"],[88,1,"あた"]],"text":"「この人々はわれわれと親しいから、この地に住まわせて、ここで取引をさせよう。地は広く、彼らをいれるにじゅうぶんである。そしてわれわれは彼らの娘を妻にめとり、われわれの娘を彼らに与えよう。"},{"ref":"Gen.34.22","start":1034022,"end":1034022,"break":"none","ruby":[[0,1,"かれ"],[3,2,"かつれい"],[6,1,"う"],[25,2,"だんし"],[28,1,"みな"],[30,2,"かつれい"],[33,1,"う"],[43,1,"こと"],[50,2,"ひとびと"],[58,2,"どうい"],[67,2,"いっしょ"],[70,1,"す"],[76,1,"たみ"]],"text":"彼らが割礼を受けているように、もしわれわれのうちの男子が皆、割礼を受けるなら、ただこの事だけで、この人々はわれわれに同意し、われわれと一緒に住んで一つの民となるのだ。"},{"ref":"Gen.34.23","start":1034023,"end":1034023,"break":"none","ruby":[[5,1,"かれ"],[8,2,"かちく"],[11,2,"ざいさん"],[18,1,"けもの"],[45,1,"かれ"],[48,2,"どうい"],[54,1,"かれ"],[62,2,"いっしょ"],[65,1,"す"]],"text":"そうすれば彼らの家畜と財産とすべての獣とは、われわれのものとなるではないか。ただわれわれが彼らに同意すれば、彼らはわれわれと一緒に住むであろう」。"},{"ref":"Gen.34.24","start":1034024,"end":1034024,"break":"none","ruby":[[3,1,"まち"],[5,1,"もん"],[7,2,"でい"],[12,1,"もの"],[22,1,"こ"],[28,1,"き"],[30,1,"したが"],[34,1,"まち"],[36,1,"もん"],[38,2,"でい"],[47,2,"だんし"],[50,2,"かつれい"],[53,1,"う"]],"text":"そこで町の門に出入りする者はみなハモルとその子シケムとに聞き従って、町の門に出入りするすべての男子は割礼を受けた。"},{"ref":"Gen.34.25","start":1034025,"end":1034025,"break":"paragraph","ruby":[[1,1,"か"],[2,1,"め"],[7,1,"かれ"],[10,1,"いた"],[13,1,"おぼ"],[18,1,"とき"],[28,1,"こ"],[37,2,"きょうだい"],[57,1,"と"],[61,2,"ふい"],[64,1,"まち"],[66,1,"おそ"],[69,2,"だんし"],[77,1,"ころ"]],"text":"三日目になって彼らが痛みを覚えている時、ヤコブのふたりの子、すなわちデナの兄弟シメオンとレビとは、おのおのつるぎを取って、不意に町を襲い、男子をことごとく殺し、"},{"ref":"Gen.34.26","start":1034026,"end":1034026,"break":"none","ruby":[[6,1,"は"],[17,1,"こ"],[23,1,"ころ"],[30,1,"いえ"],[36,1,"つ"],[38,1,"だ"]],"text":"またつるぎの刃にかけてハモルとその子シケムとを殺し、シケムの家からデナを連れ出した。"},{"ref":"Gen.34.27","start":1034027,"end":1034027,"break":"none","ruby":[[7,1,"こ"],[10,1,"ころ"],[14,2,"ひとびと"],[20,1,"まち"],[27,1,"かれ"],[30,1,"いもうと"],[32,1,"けが"]],"text":"そしてヤコブの子らは殺された人々をはぎ、町をかすめた。彼らが妹を汚したからである。"},{"ref":"Gen.34.28","start":1034028,"end":1034028,"break":"none","ruby":[[4,1,"ひつじ"],[6,1,"うし"],[10,1,"およ"],[12,1,"まち"],[20,1,"の"]],"text":"すなわち羊、牛、ろば及び町にあるものと、野にあるもの、"},{"ref":"Gen.34.29","start":1034029,"end":1034029,"break":"none","ruby":[[0,1,"なら"],[7,1,"か"],[8,1,"ざい"],[10,1,"うば"],[15,1,"こ"],[16,1,"おんな"],[18,1,"つま"],[22,1,"みな"],[29,1,"いえ"],[31,1,"なか"],[35,1,"もの"]],"text":"並びにすべての貨財を奪い、その子女と妻たちを皆とりこにし、家の中にある物をことごとくかすめた。"},{"ref":"Gen.34.30","start":1034030,"end":1034030,"break":"none","ruby":[[16,1,"い"],[33,1,"ち"],[35,2,"じゅうみん"],[50,1,"い"],[61,2,"めいわく"],[73,2,"にんずう"],[76,1,"すく"],[82,1,"かれ"],[85,1,"あつ"],[93,1,"せ"],[95,1,"う"],[105,2,"かぞく"],[108,1,"ほろ"]],"text":"そこでヤコブはシメオンとレビとに言った、「あなたがたはわたしをこの地の住民、カナンびととペリジびとに忌みきらわせ、わたしに迷惑をかけた。わたしは、人数が少ないから、彼らが集まってわたしを攻め撃つならば、わたしも家族も滅ぼされるであろう」。"},{"ref":"Gen.34.31","start":1034031,"end":1034031,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[14,1,"いもうと"],[16,2,"ゆうじょ"],[22,1,"かれ"],[24,1,"あつか"]],"text":"彼らは言った、「わたしたちの妹を遊女のように彼が扱ってよいのですか」。"}]