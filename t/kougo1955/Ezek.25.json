[{"ref":"Ezek.25.1","start":26025001,"end":26025001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.25.2","start":26025002,"end":26025002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,1,"かお"],[17,2,"ひとびと"],[20,1,"む"],[26,1,"む"],[30,2,"よげん"]],"text":"「人の子よ、あなたの顔をアンモンの人々に向け、これに向かって預言し、"},{"ref":"Ezek.25.3","start":26025003,"end":26025003,"break":"none","ruby":[[5,2,"ひとびと"],[8,1,"い"],[11,1,"しゅ"],[14,1,"かみ"],[16,2,"ことば"],[19,1,"き"],[22,1,"しゅ"],[25,1,"かみ"],[29,1,"い"],[40,2,"せいじょ"],[43,1,"けが"],[47,1,"とき"],[57,1,"ち"],[59,1,"あら"],[63,1,"とき"],[70,1,"いえ"],[72,1,"とら"],[74,1,"うつ"],[78,1,"とき"],[88,2,"きみ"],[94,1,"い"]],"text":"アンモンの人々に言え。主なる神の言葉を聞け。主なる神はこう言われる、あなたはわが聖所の汚された時、またイスラエルの地の荒された時、またユダの家が捕え移された時、ああ、それはよい気味であると言った。"},{"ref":"Ezek.25.4","start":26025004,"end":26025004,"break":"none","ruby":[[14,1,"ひがし"],[16,2,"ひとびと"],[19,1,"わた"],[22,1,"かれ"],[25,2,"しょゆう"],[31,1,"かれ"],[41,2,"じんえい"],[44,1,"もう"],[54,2,"じゅうきょ"],[57,1,"つく"],[69,1,"た"],[76,1,"ちち"],[78,1,"の"]],"text":"それゆえ、わたしはあなたを、東の人々に渡して彼らの所有とする。彼らはあなたのうちに陣営を設け、あなたのうちに住居を造り、あなたのくだものを食べ、あなたの乳を飲む。"},{"ref":"Ezek.25.5","start":26025005,"end":26025005,"break":"none","ruby":[[12,1,"か"],[14,1,"ところ"],[25,2,"まちまち"],[29,1,"ひつじ"],[31,1,"ふ"],[33,1,"ところ"],[52,1,"しゅ"],[59,1,"し"]],"text":"わたしはラバを、らくだを飼う所とし、アンモンびとの町々を、羊の伏す所とする。そしてあなたがたは、わたしが主であることを知るようになる。"},{"ref":"Ezek.25.6","start":26025006,"end":26025006,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[22,1,"ち"],[24,1,"む"],[28,1,"て"],[33,1,"あし"],[35,1,"ふ"],[38,1,"こころ"],[40,2,"あくい"],[43,1,"み"],[47,1,"よろこ"]],"text":"主なる神はこう言われる、あなたはイスラエルの地に向かって手をうち、足を踏み、心に悪意を満たして喜んだ。"},{"ref":"Ezek.25.7","start":26025007,"end":26025007,"break":"none","ruby":[[5,1,"み"],[14,1,"て"],[20,1,"む"],[23,1,"の"],[36,2,"こくみん"],[39,1,"わた"],[42,2,"りゃくだつ"],[59,1,"たみ"],[61,1,"なか"],[64,1,"た"],[67,2,"しょこく"],[70,1,"なか"],[73,1,"ほろ"],[76,1,"た"],[92,1,"しゅ"],[99,1,"し"]],"text":"それゆえ、見よ、わたしはわが手をあなたに向けて伸べ、あなたを、もろもろの国民に渡して略奪にあわせ、あなたを、もろもろの民の中から断ち、諸国の中から滅ぼし絶やす。そしてあなたは、わたしが主であることを知るようになる。"},{"ref":"Ezek.25.8","start":26025008,"end":26025008,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[11,1,"い"],[20,1,"い"],[24,1,"み"],[30,1,"いえ"],[33,1,"た"],[39,2,"こくみん"],[42,2,"どうよう"]],"text":"主なる神はわたしにこう言われる、モアブは言った、見よ、ユダの家は、他のすべての国民と同様であると。"},{"ref":"Ezek.25.9","start":26025009,"end":26025009,"break":"none","ruby":[[13,2,"きょうかい"],[16,2,"まちまち"],[23,1,"くに"],[25,1,"さか"],[51,2,"よこばら"],[54,1,"ひら"]],"text":"それゆえ、わたしはモアブの境界の町々、すなわち国の栄えであるベテエシモテ、バアルメオン、キリアタイムの横腹を開き、"},{"ref":"Ezek.25.10","start":26025010,"end":26025010,"break":"none","ruby":[[8,2,"ひとびと"],[11,1,"とも"],[14,2,"とうほう"],[17,2,"ひとびと"],[20,1,"あた"],[26,2,"しょゆう"],[35,2,"ひとびと"],[43,2,"こくみん"],[46,1,"なか"],[48,2,"きおく"]],"text":"これをアンモンの人々と共に、東方の人々に与えて、その所有とし、モアブの人々をもろもろの国民の中に記憶させない。"},{"ref":"Ezek.25.11","start":26025011,"end":26025011,"break":"none","ruby":[[8,1,"うえ"],[14,1,"おこな"],[22,1,"かれ"],[29,1,"しゅ"],[36,1,"し"]],"text":"わたしはモアブの上にさばきを行う。そのとき、彼らはわたしが主であることを知る。"},{"ref":"Ezek.25.12","start":26025012,"end":26025012,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[16,1,"うら"],[26,1,"いえ"],[28,2,"てきたい"],[35,1,"うら"],[38,1,"かえ"],[48,1,"つみ"],[50,1,"おか"]],"text":"主なる神はこう言われる、エドムは恨みをふくんでユダの家に敵対し、これに恨みを返して、はなはだしく罪を犯した。"},{"ref":"Ezek.25.13","start":26025013,"end":26025013,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[25,1,"うえ"],[27,1,"て"],[29,1,"の"],[35,1,"なか"],[38,1,"ひと"],[40,1,"けもの"],[43,1,"た"],[49,1,"あ"],[51,1,"ち"],[66,2,"ひとびと"],[73,1,"たお"]],"text":"それゆえ、主なる神はこう言われる、わたしはエドムの上に手を伸べて、その中から人と獣とを断ち、これを荒れ地とする。テマンからデダンまで人々はつるぎに倒れる。"},{"ref":"Ezek.25.14","start":26025014,"end":26025014,"break":"none","ruby":[[6,1,"たみ"],[13,1,"て"],[28,1,"むく"],[32,1,"かれ"],[37,1,"いか"],[42,1,"いきどお"],[45,1,"したが"],[52,1,"おこな"],[54,1,"とき"],[60,2,"ひとびと"],[71,1,"かえ"],[76,1,"し"],[85,1,"しゅ"],[88,1,"かみ"],[90,1,"い"]],"text":"わたしはわが民イスラエルの手をもって、エドムにわがあだを報いる。彼らがわが怒り、わが憤りに従ってエドムに行う時、エドムの人々は、わたしがあだを返すことを知るようになると、主なる神は言われる。"},{"ref":"Ezek.25.15","start":26025015,"end":26025015,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[19,1,"うら"],[26,2,"こうどう"],[30,1,"こころ"],[32,2,"あくい"],[41,1,"かえ"],[44,1,"ふか"],[46,2,"てきい"],[53,1,"ほろ"]],"text":"主なる神はこう言われる、ペリシテびとは恨みをふくんで行動し、心に悪意をもってあだを返し、深い敵意をもって、滅ぼすことをした。"},{"ref":"Ezek.25.16","start":26025016,"end":26025016,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[17,1,"み"],[24,1,"て"],[33,1,"うえ"],[35,1,"の"],[44,1,"た"],[47,1,"うみ"],[50,1,"のこ"],[53,1,"もの"],[55,1,"ほろ"]],"text":"それゆえ、主なる神はこう言われる、見よ、わたしは手をペリシテびとの上に伸べ、ケレテびとを断ち、海べの残りの者を滅ぼす。"},{"ref":"Ezek.25.17","start":26025017,"end":26025017,"break":"none","ruby":[[4,1,"いか"],[7,1,"み"],[10,2,"ちょうばつ"],[17,1,"おお"],[21,2,"ふくしゅう"],[24,1,"かれ"],[34,1,"かれ"],[40,1,"かえ"],[42,1,"とき"],[44,1,"かれ"],[51,1,"しゅ"],[58,1,"し"]],"text":"わたしは怒りに満ちた懲罰をもって、大いなる復讐を彼らになす。わたしが彼らにあだを返す時、彼らはわたしが主であることを知るようになる」。"}]