[{"ref":"Ezra.7.1","start":15007001,"end":15007001,"break":"paragraph","ruby":[[4,1,"こと"],[6,1,"のち"],[11,1,"おう"],[20,2,"ちせい"],[29,1,"もの"],[43,1,"こ"],[54,1,"こ"],[66,1,"こ"]],"text":"これらの事の後ペルシャ王アルタシャスタの治世にエズラという者があった。エズラはセラヤの子、セラヤはアザリヤの子、アザリヤはヒルキヤの子、"},{"ref":"Ezra.7.2","start":15007002,"end":15007002,"break":"none","ruby":[[10,1,"こ"],[21,1,"こ"],[32,1,"こ"]],"text":"ヒルキヤはシャルムの子、シャルムはザドクの子、ザドクはアヒトブの子、"},{"ref":"Ezra.7.3","start":15007003,"end":15007003,"break":"none","ruby":[[10,1,"こ"],[22,1,"こ"],[34,1,"こ"]],"text":"アヒトブはアマリヤの子、アマリヤはアザリヤの子、アザリヤはメラヨテの子、"},{"ref":"Ezra.7.4","start":15007004,"end":15007004,"break":"none","ruby":[[10,1,"こ"],[20,1,"こ"],[29,1,"こ"]],"text":"メラヨテはゼラヒヤの子、ゼラヒヤはウジの子、ウジはブッキの子、"},{"ref":"Ezra.7.5","start":15007005,"end":15007005,"break":"none","ruby":[[10,1,"こ"],[23,1,"こ"],[36,1,"こ"],[44,2,"さいし"],[46,1,"ちょう"],[51,1,"こ"]],"text":"ブッキはアビシュアの子、アビシュアはピネハスの子、ピネハスはエレアザルの子、エレアザルは祭司長アロンの子である。"},{"ref":"Ezra.7.6","start":15007006,"end":15007006,"break":"none","ruby":[[12,1,"のぼ"],[15,1,"き"],[18,1,"かれ"],[26,1,"かみ"],[28,1,"しゅ"],[31,1,"さづ"],[41,2,"りっぽう"],[44,2,"せいつう"],[48,2,"がくしゃ"],[57,1,"かみ"],[59,1,"しゅ"],[61,1,"て"],[63,1,"かれ"],[65,1,"うえ"],[75,1,"もと"],[81,1,"おう"],[88,1,"ゆる"]],"text":"このエズラはバビロンから上って来た。彼はイスラエルの神、主がお授けになったモーセの律法に精通した学者であった。その神、主の手が彼の上にあったので、その求めることを王はことごとく許した。"},{"ref":"Ezra.7.7","start":15007007,"end":15007007,"break":"paragraph","ruby":[[7,1,"おう"],[10,1,"ねん"],[20,2,"ひとびと"],[25,2,"さいし"],[33,1,"うた"],[37,1,"もの"],[39,2,"もんえい"],[42,1,"みや"],[44,1,"つか"],[58,1,"のぼ"]],"text":"アルタシャスタ王の七年にまたイスラエルの人々および祭司、レビびと、歌うたう者、門衛、宮に仕えるしもべなどエルサレムに上った。"},{"ref":"Ezra.7.8","start":15007008,"end":15007008,"break":"none","ruby":[[3,1,"おう"],[6,1,"ねん"],[9,1,"がつ"],[21,1,"き"]],"text":"そして王の七年の五月にエズラはエルサレムに来た。"},{"ref":"Ezra.7.9","start":15007009,"end":15007009,"break":"none","ruby":[[4,2,"しょうがつ"],[8,1,"にち"],[15,2,"しゅったつ"],[21,1,"がつ"],[23,1,"にち"],[31,1,"つ"],[37,1,"かみ"],[39,1,"めぐ"],[42,1,"て"],[44,1,"かれ"],[46,1,"うえ"]],"text":"すなわち正月の一日にバビロンを出立して、五月一日にエルサレムに着いた。その神の恵みの手が彼の上にあったからである。"},{"ref":"Ezra.7.10","start":15007010,"end":15007010,"break":"none","ruby":[[4,1,"こころ"],[9,1,"しゅ"],[11,2,"りっぽう"],[14,1,"しら"],[20,1,"おこな"],[34,1,"さだ"],[42,1,"おし"]],"text":"エズラは心をこめて主の律法を調べ、これを行い、かつイスラエルのうちに定めとおきてとを教えた。"},{"ref":"Ezra.7.11","start":15007011,"end":15007011,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"いまし"],[5,2,"ことば"],[17,1,"たま"],[21,1,"さだ"],[24,1,"つう"],[27,2,"がくしゃ"],[31,2,"さいし"],[47,1,"おう"],[49,1,"あた"],[52,2,"てがみ"],[55,1,"うつ"],[59,1,"つぎ"]],"text":"主の戒めの言葉、およびイスラエルに賜わった定めに通じた学者で、祭司であるエズラにアルタシャスタ王の与えた手紙の写しは、次のとおりである。"},{"ref":"Ezra.7.12","start":15007012,"end":15007012,"break":"none","ruby":[[1,2,"しょおう"],[4,1,"おう"],[13,1,"てん"],[15,1,"かみ"],[17,2,"りっぽう"],[20,2,"がくしゃ"],[25,2,"さいし"],[31,1,"おく"],[34,1,"いま"]],"text":"「諸王の王アルタシャスタ、天の神の律法の学者である祭司エズラに送る。今、"},{"ref":"Ezra.7.13","start":15007013,"end":15007013,"break":"none","ruby":[[4,1,"めい"],[6,1,"くだ"],[11,1,"くに"],[24,1,"たみ"],[30,2,"さいし"],[50,1,"い"],[54,1,"のぞ"],[56,1,"もの"],[58,1,"みな"],[64,1,"とも"],[66,1,"い"]],"text":"わたしは命を下す。わが国のうちにいるイスラエルの民およびその祭司、レビびとのうち、すべてエルサレムへ行こうと望む者は皆、あなたと共に行くことができる。"},{"ref":"Ezra.7.14","start":15007014,"end":15007014,"break":"none","ruby":[[5,2,"じぶん"],[8,1,"て"],[16,1,"かみ"],[18,2,"りっぽう"],[21,1,"てら"],[34,2,"じじょう"],[37,1,"しら"],[44,1,"おう"],[49,1,"にん"],[51,1,"ぎ"],[52,1,"かん"]],"text":"あなたは、自分の手にあるあなたの神の律法に照して、ユダとエルサレムの事情を調べるために、王および七人の議官によってつかわされるのである。"},{"ref":"Ezra.7.15","start":15007015,"end":15007015,"break":"none","ruby":[[6,1,"おう"],[12,1,"ぎ"],[13,1,"かん"],[32,1,"かみ"],[34,2,"まごころ"],[42,1,"ぎん"],[44,1,"きん"],[46,1,"たずさ"]],"text":"かつあなたは王およびその議官らが、エルサレムにいますイスラエルの神に真心からささげる銀と金を携え、"},{"ref":"Ezra.7.16","start":15007016,"end":15007016,"break":"none","ruby":[[6,1,"ぜん"],[7,1,"しゅう"],[13,1,"え"],[19,2,"きんぎん"],[25,1,"たみ"],[27,2,"さいし"],[42,1,"かみ"],[44,1,"みや"],[50,2,"まごころ"],[58,1,"そな"],[60,1,"もの"],[62,1,"たずさ"],[65,1,"い"]],"text":"またバビロン全州であなたが獲るすべての金銀、および民と祭司とが、エルサレムにあるその神の宮のために、真心からささげた供え物を携えて行く。"},{"ref":"Ezra.7.17","start":15007017,"end":15007017,"break":"none","ruby":[[9,1,"かね"],[14,2,"おうし"],[17,2,"おひつじ"],[20,2,"こひつじ"],[27,2,"そさい"],[30,2,"かんさい"],[33,2,"しなじな"],[36,1,"き"],[41,1,"か"],[58,1,"かみ"],[60,1,"みや"],[62,2,"さいだん"],[65,1,"うえ"]],"text":"それであなたはその金をもって雄牛、雄羊、小羊およびその素祭と灌祭の品々を気をつけて買い、エルサレムにあるあなたがたの神の宮の祭壇の上に、これをささげなければならない。"},{"ref":"Ezra.7.18","start":15007018,"end":15007018,"break":"none","ruby":[[11,2,"きょうだい"],[19,1,"あま"],[22,2,"きんぎん"],[29,1,"おも"],[33,1,"こと"],[47,1,"かみ"],[50,1,"むね"],[52,1,"したが"],[58,1,"おこな"]],"text":"また、あなたとあなたの兄弟たちが、その余った金銀でしようと思うよい事があるならば、あなたがたの神のみ旨に従ってそれを行え。"},{"ref":"Ezra.7.19","start":15007019,"end":15007019,"break":"none","ruby":[[6,1,"かみ"],[8,1,"みや"],[10,1,"つと"],[12,1,"こと"],[21,1,"あた"],[26,1,"うつわ"],[35,1,"かみ"],[37,1,"まえ"],[39,1,"おさ"]],"text":"またあなたの神の宮の勤め事のためにあなたが与えられた器は、エルサレムの神の前に納めよ。"},{"ref":"Ezra.7.20","start":15007020,"end":15007020,"break":"none","ruby":[[8,1,"かみ"],[10,1,"みや"],[15,1,"もち"],[19,2,"ひつよう"],[32,1,"おう"],[34,1,"くら"],[37,1,"だ"],[40,1,"もち"]],"text":"そのほかあなたの神の宮のために用うべき必要なものがあれば、それを王の倉から出して用いよ。"},{"ref":"Ezra.7.21","start":15007021,"end":15007021,"break":"paragraph","ruby":[[10,1,"おう"],[12,1,"かわ"],[13,1,"む"],[17,1,"しゅう"],[23,1,"くら"],[28,1,"めい"],[30,1,"くだ"],[33,1,"い"],[37,1,"てん"],[39,1,"かみ"],[41,2,"りっぽう"],[44,2,"がくしゃ"],[49,2,"さいし"],[61,1,"もと"],[64,1,"こと"],[73,1,"こころ"],[76,1,"おこな"]],"text":"われ、アルタシャスタ王は川向こうの州のすべての倉づかさに命を下して言う、『天の神の律法の学者である祭司エズラがあなたがたに求める事は、すべてこれを心して行え。"},{"ref":"Ezra.7.22","start":15007022,"end":15007022,"break":"none","ruby":[[4,1,"ぎん"],[14,2,"こむぎ"],[26,1,"しゅ"],[34,1,"あぶら"],[42,1,"しお"],[44,2,"せいげん"],[48,1,"あた"]],"text":"すなわち銀は百タラントまで、小麦は百コルまで、ぶどう酒は百バテまで、油は百バテまで、塩は制限なく与えよ。"},{"ref":"Ezra.7.23","start":15007023,"end":15007023,"break":"none","ruby":[[0,1,"てん"],[2,1,"かみ"],[4,1,"みや"],[10,1,"てん"],[12,1,"かみ"],[14,1,"めい"],[25,1,"ただ"],[31,1,"おこな"],[40,1,"かみ"],[42,1,"いか"],[46,1,"おう"],[48,1,"おう"],[50,1,"こ"],[53,1,"くに"],[55,1,"のぞ"]],"text":"天の神の宮のために、天の神の命じるところは、すべて正しくこれを行え。そうしないと神の怒りが、王と王の子らの国に臨むであろう』。"},{"ref":"Ezra.7.24","start":15007024,"end":15007024,"break":"none","ruby":[[14,1,"つ"],[19,2,"さいし"],[27,1,"うた"],[31,1,"もの"],[33,2,"もんえい"],[36,1,"みや"],[38,1,"つか"],[48,1,"かみ"],[52,1,"みや"],[54,1,"つか"],[67,2,"そぜい"],[70,2,"ぜいきん"],[73,1,"か"]],"text":"われわれは、またあなたがたに告げる、『祭司、レビびと、歌うたう者、門衛、宮に仕えるしもべ、および神のこの宮の仕えびとたちには、みつぎ、租税、税金を課してはならぬ』。"},{"ref":"Ezra.7.25","start":15007025,"end":15007025,"break":"paragraph","ruby":[[13,1,"て"],[17,1,"かみ"],[19,2,"ちえ"],[32,3,"さいばんにん"],[36,1,"た"],[39,1,"かわ"],[40,1,"む"],[44,1,"しゅう"],[50,1,"たみ"],[60,1,"かみ"],[62,2,"りっぽう"],[65,1,"し"],[70,1,"もの"],[97,1,"し"],[101,1,"もの"],[103,1,"おし"]],"text":"エズラよ、あなたはあなたの手にある神の知恵によって、つかさおよび裁判人を立て、川向こうの州のすべての民、すなわちあなたの神の律法を知っている者たちを、ことごとくさばかせよ。あなたがたはまたこれを知らない者を教えよ。"},{"ref":"Ezra.7.26","start":15007026,"end":15007026,"break":"none","ruby":[[4,1,"かみ"],[6,2,"りっぽう"],[11,1,"おう"],[13,2,"りっぽう"],[16,1,"まも"],[20,1,"もの"],[29,1,"つみ"],[31,1,"さだ"],[39,2,"しけい"],[47,2,"ついほう"],[55,2,"ざいさん"],[57,2,"ぼっしゅう"],[65,2,"とうごく"],[68,1,"しょ"]],"text":"あなたの神の律法および王の律法を守らない者を、きびしくその罪に定めて、あるいは死刑に、あるいは追放に、あるいは財産没収に、あるいは投獄に処せよ」。"},{"ref":"Ezra.7.27","start":15007027,"end":15007027,"break":"paragraph","ruby":[[5,2,"せんぞ"],[8,1,"かみ"],[10,1,"しゅ"],[19,1,"しゅ"],[27,1,"おう"],[29,1,"こころ"],[40,1,"しゅ"],[42,1,"みや"],[44,1,"かざ"],[46,1,"こころ"],[48,1,"おこ"]],"text":"われわれの先祖の神、主はほむべきかな。主はこのように、王の心に、エルサレムにある主の宮を飾る心を起させ、"},{"ref":"Ezra.7.28","start":15007028,"end":15007028,"break":"none","ruby":[[2,1,"おう"],[4,1,"まえ"],[9,1,"ぎ"],[10,1,"かん"],[12,1,"まえ"],[14,1,"おう"],[16,2,"だいじん"],[19,1,"まえ"],[26,1,"めぐ"],[29,1,"え"],[42,1,"かみ"],[44,1,"しゅ"],[46,1,"て"],[52,1,"うえ"],[58,1,"ちから"],[60,1,"え"],[72,2,"しゅりょう"],[76,2,"ひとびと"],[79,1,"あつ"],[87,1,"とも"],[89,1,"のぼ"]],"text":"また王の前と、その議官の前と王の大臣の前で、わたしに恵みを得させられた。わたしはわが神、主の手がわたしの上にあるので力を得、イスラエルのうちから首領たる人々を集めて、わたしと共に上らせた。"}]