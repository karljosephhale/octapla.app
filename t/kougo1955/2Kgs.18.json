[{"ref":"2Kgs.18.1","start":12018001,"end":12018001,"break":"paragraph","ruby":[[6,1,"おう"],[10,1,"こ"],[15,1,"だい"],[17,1,"ねん"],[22,1,"おう"],[27,1,"こ"],[33,1,"おう"]],"text":"イスラエルの王エラの子ホセアの第三年にユダの王アハズの子ヒゼキヤが王となった。"},{"ref":"2Kgs.18.2","start":12018002,"end":12018002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おう"],[7,1,"とき"],[11,1,"さい"],[23,1,"ねん"],[25,1,"あいだ"],[27,1,"よ"],[29,1,"おさ"],[35,1,"はは"],[42,1,"むすめ"],[45,1,"な"]],"text":"彼は王となった時二十五歳で、エルサレムで二十九年の間、世を治めた。その母はゼカリヤの娘で、名をアビといった。"},{"ref":"2Kgs.18.3","start":12018003,"end":12018003,"break":"none","ruby":[[8,2,"せんぞ"],[22,1,"しゅ"],[24,1,"め"],[29,1,"こと"],[31,1,"おこな"]],"text":"ヒゼキヤはすべて先祖ダビデがおこなったように主の目にかなう事を行い、"},{"ref":"2Kgs.18.4","start":12018004,"end":12018004,"break":"none","ruby":[[0,1,"たか"],[2,1,"ところ"],[4,1,"のぞ"],[7,2,"せきちゅう"],[17,1,"ぞう"],[19,1,"き"],[21,1,"たお"],[28,1,"つく"],[31,2,"せいどう"],[37,1,"う"],[39,1,"くだ"],[49,2,"ひとびと"],[54,1,"とき"],[62,1,"む"],[66,1,"こう"],[79,2,"ひとびと"],[91,1,"よ"]],"text":"高き所を除き、石柱をこわし、アシラ像を切り倒し、モーセの造った青銅のへびを打ち砕いた。イスラエルの人々はこの時までそのへびに向かって香をたいていたからである。人々はこれをネホシタンと呼んだ。"},{"ref":"2Kgs.18.5","start":12018005,"end":12018005,"break":"none","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[15,2,"しんらい"],[25,1,"かれ"],[31,1,"かれ"],[33,1,"さき"],[44,1,"おう"],[49,1,"かれ"],[51,1,"およ"],[53,1,"もの"]],"text":"ヒゼキヤはイスラエルの神、主に信頼した。そのために彼のあとにも彼の先にも、ユダのすべての王のうちに彼に及ぶ者はなかった。"},{"ref":"2Kgs.18.6","start":12018006,"end":12018006,"break":"none","ruby":[[4,1,"かれ"],[6,1,"かた"],[8,1,"しゅ"],[10,1,"したが"],[13,1,"はな"],[21,1,"しゅ"],[27,1,"めい"],[32,2,"めいれい"],[35,1,"まも"]],"text":"すなわち彼は固く主に従って離れることなく、主がモーセに命じられた命令を守った。"},{"ref":"2Kgs.18.7","start":12018007,"end":12018007,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"とも"],[16,1,"かれ"],[18,1,"で"],[20,1,"たたか"],[26,1,"こう"],[34,1,"かれ"],[42,1,"おう"],[49,1,"かれ"],[51,1,"つか"]],"text":"主が彼と共におられたので、すべて彼が出て戦うところで功をあらわした。彼はアッスリヤの王にそむいて、彼に仕えなかった。"},{"ref":"2Kgs.18.8","start":12018008,"end":12018008,"break":"none","ruby":[[0,1,"かれ"],[9,1,"う"],[11,1,"はい"],[20,2,"りょういき"],[25,1,"たっ"],[28,2,"みはり"],[30,1,"だい"],[33,2,"けんご"],[36,1,"まち"],[40,1,"およ"]],"text":"彼はペリシテびとを撃ち敗って、ガザとその領域にまで達し、見張台から堅固な町にまで及んだ。"},{"ref":"2Kgs.18.9","start":12018009,"end":12018009,"break":"paragraph","ruby":[[4,1,"おう"],[6,1,"だい"],[8,1,"ねん"],[19,1,"おう"],[23,1,"こ"],[28,1,"だい"],[30,1,"ねん"],[39,1,"おう"],[53,1,"せ"],[55,1,"のぼ"],[62,1,"かこ"]],"text":"ヒゼキヤ王の第四年すなわちイスラエルの王エラの子ホセアの第七年に、アッスリヤの王シャルマネセルはサマリヤに攻め上って、これを囲んだが、"},{"ref":"2Kgs.18.10","start":12018010,"end":12018010,"break":"none","ruby":[[1,1,"ねん"],[3,1,"のち"],[10,1,"と"],[19,1,"と"],[30,1,"だい"],[32,1,"ねん"],[44,1,"おう"],[49,1,"だい"],[51,1,"ねん"]],"text":"三年の後ついにこれを取った。サマリヤが取られたのはヒゼキヤの第六年で、それはイスラエルの王ホセアの第九年であった。"},{"ref":"2Kgs.18.11","start":12018011,"end":12018011,"break":"none","ruby":[[6,1,"おう"],[14,2,"ひとびと"],[23,1,"とら"],[38,1,"かわ"],[52,2,"まちまち"],[55,1,"お"]],"text":"アッスリヤの王はイスラエルの人々をアッスリヤに捕えていって、ハラと、ゴザンの川ハボルのほとりと、メデアの町々に置いた。"},{"ref":"2Kgs.18.12","start":12018012,"end":12018012,"break":"none","ruby":[[3,1,"かれ"],[8,1,"かみ"],[10,1,"しゅ"],[12,2,"ことば"],[23,2,"けいやく"],[26,1,"やぶ"],[29,1,"しゅ"],[38,1,"めい"],[45,1,"こと"],[47,1,"みみ"],[49,1,"かたむ"],[55,1,"おこな"]],"text":"これは彼らがその神、主の言葉にしたがわず、その契約を破り、主のしもべモーセの命じたすべての事に耳を傾けず、また行わなかったからである。"},{"ref":"2Kgs.18.13","start":12018013,"end":12018013,"break":"paragraph","ruby":[[4,1,"おう"],[6,1,"だい"],[9,1,"ねん"],[17,1,"おう"],[24,1,"せ"],[26,1,"のぼ"],[36,2,"けんご"],[39,2,"まちまち"],[42,1,"と"]],"text":"ヒゼキヤ王の第十四年にアッスリヤの王セナケリブが攻め上ってユダのすべての堅固な町々を取ったので、"},{"ref":"2Kgs.18.14","start":12018014,"end":12018014,"break":"none","ruby":[[3,1,"おう"],[9,1,"ひと"],[26,1,"おう"],[28,1,"い"],[37,1,"つみ"],[39,1,"おか"],[48,1,"ひ"],[50,1,"あ"],[62,1,"か"],[87,1,"おう"],[89,1,"ぎん"],[97,1,"きん"],[108,1,"おう"],[114,1,"か"]],"text":"ユダの王ヒゼキヤは人をラキシにつかわしてアッスリヤの王に言った、「わたしは罪を犯しました。どうぞ引き上げてください。わたしに課せられることはなんでもいたします」。アッスリヤの王は銀三百タラントと金三十タラントをユダの王ヒゼキヤに課した。"},{"ref":"2Kgs.18.15","start":12018015,"end":12018015,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"みや"],[9,1,"おう"],[11,1,"いえ"],[13,1,"くら"],[18,1,"ぎん"],[25,1,"かれ"],[27,1,"あた"]],"text":"ヒゼキヤは主の宮と王の家の倉とにある銀をことごとく彼に与えた。"},{"ref":"2Kgs.18.16","start":12018016,"end":12018016,"break":"none","ruby":[[2,1,"とき"],[6,1,"おう"],[14,1,"しゅ"],[16,2,"しんでん"],[19,1,"と"],[23,1,"はしら"],[26,2,"じぶん"],[29,1,"き"],[32,1,"きん"],[36,1,"と"],[46,1,"おう"],[48,1,"あた"]],"text":"この時ユダの王ヒゼキヤはまた主の神殿の戸および柱から自分が着せた金をはぎ取って、アッスリヤの王に与えた。"},{"ref":"2Kgs.18.17","start":12018017,"end":12018017,"break":"none","ruby":[[6,1,"おう"],[35,2,"たいぐん"],[38,1,"ひき"],[53,1,"おう"],[64,1,"かれ"],[67,1,"のぼ"],[76,1,"き"],[79,1,"かれ"],[88,1,"つ"],[92,1,"ぬの"],[96,1,"ば"],[98,1,"い"],[100,2,"おおじ"],[103,1,"そ"],[108,1,"うえ"],[110,1,"いけ"],[112,2,"すいどう"],[120,1,"い"],[127,1,"た"]],"text":"アッスリヤの王はまたタルタン、ラブサリスおよびラブシャケを、ラキシから大軍を率いてエルサレムにいるヒゼキヤ王のもとにつかわした。彼らは上ってエルサレムに来た。彼らはエルサレムに着くと、布さらし場に行く大路に沿っている上の池の水道のかたわらへ行って、そこに立った。"},{"ref":"2Kgs.18.18","start":12018018,"end":12018018,"break":"none","ruby":[[3,1,"かれ"],[6,1,"おう"],[8,1,"よ"],[19,1,"こ"],[23,3,"くないきょう"],[32,3,"しょきかん"],[46,1,"こ"],[50,2,"しかん"],[55,1,"かれ"],[62,1,"で"]],"text":"そして彼らが王を呼んだので、ヒルキヤの子である宮内卿エリアキム、書記官セブナ、およびアサフの子である史官ヨアが彼らのところに出てきた。"},{"ref":"2Kgs.18.19","start":12018019,"end":12018019,"break":"paragraph","ruby":[[6,1,"かれ"],[9,1,"い"],[19,1,"い"],[26,2,"だいおう"],[35,1,"おう"],[39,1,"おお"],[49,1,"たの"],[54,1,"もの"],[56,1,"なに"]],"text":"ラブシャケは彼らに言った、「ヒゼキヤに言いなさい、『大王、アッスリヤの王はこう仰せられる。あなたが頼みとする者は何か。"},{"ref":"2Kgs.18.20","start":12018020,"end":12018020,"break":"none","ruby":[[0,2,"くちさき"],[5,2,"ことば"],[8,2,"せんそう"],[13,2,"けいりゃく"],[16,1,"ちから"],[19,1,"かんが"],[29,1,"いま"]],"text":"口先だけの言葉が戦争をする計略と力だと考えるのか。あなたは今だれにたよって、わたしにそむいたのか。"},{"ref":"2Kgs.18.21","start":12018021,"end":12018021,"break":"none","ruby":[[0,1,"いま"],[8,1,"お"],[15,1,"あし"],[25,1,"たの"],[37,1,"ひと"],[44,1,"とき"],[48,1,"ひと"],[50,1,"て"],[52,1,"さ"],[54,1,"とお"],[66,1,"おう"],[73,1,"よ"],[75,1,"たの"],[77,1,"もの"]],"text":"今あなたは、あの折れかけている葦のつえ、エジプトを頼みとしているが、それは人がよりかかる時、その人の手を刺し通すであろう。エジプトの王パロはすべて寄り頼む者にそのようにする。"},{"ref":"2Kgs.18.22","start":12018022,"end":12018022,"break":"none","ruby":[[21,1,"かみ"],[23,1,"しゅ"],[25,1,"たの"],[33,1,"い"],[43,1,"かみ"],[59,1,"つ"],[79,2,"さいだん"],[82,1,"まえ"],[84,2,"れいはい"],[97,1,"い"],[103,1,"たか"],[105,1,"ところ"],[107,2,"さいだん"],[111,1,"のぞ"],[114,1,"もの"]],"text":"しかしあなたがもし「われわれは、われわれの神、主を頼む」とわたしに言うのであれば、その神はヒゼキヤがユダとエルサレムに告げて、「あなたがたはエルサレムで、この祭壇の前に礼拝しなければならない」と言って、その高き所と祭壇とを除いた者ではないか。"},{"ref":"2Kgs.18.23","start":12018023,"end":12018023,"break":"none","ruby":[[7,2,"しゅくん"],[15,1,"おう"],[29,1,"ほう"],[31,1,"の"],[33,1,"ひと"],[45,1,"うま"],[48,1,"とう"],[50,1,"あた"]],"text":"さあ、わたしの主君アッスリヤの王とかけをせよ。もしあなたの方に乗る人があるならば、わたしは馬二千頭を与えよう。"},{"ref":"2Kgs.18.24","start":12018024,"end":12018024,"break":"none","ruby":[[9,1,"たの"],[12,2,"せんしゃ"],[15,2,"きへい"],[18,1,"こ"],[20,1,"もと"],[31,2,"しゅくん"],[34,2,"けらい"],[40,1,"もっと"],[42,1,"ちい"],[46,2,"たいちょう"],[56,2,"げきたい"]],"text":"あなたはエジプトを頼み、戦車と騎兵を請い求めているが、わたしの主君の家来のうちの最も小さい一隊長でさえ、どうして撃退することができようか。"},{"ref":"2Kgs.18.25","start":12018025,"end":12018025,"break":"none","ruby":[[6,1,"ところ"],[8,1,"ほろ"],[14,1,"のぼ"],[22,1,"しゅ"],[24,1,"ゆる"],[39,1,"しゅ"],[47,1,"ち"],[49,1,"せ"],[51,1,"のぼ"],[57,1,"ほろ"],[61,1,"い"]],"text":"わたしがこの所を滅ぼすために上ってきたのは、主の許しなしにしたことであろうか。主がわたしにこの地に攻め上ってこれを滅ぼせと言われたのだ』」。"},{"ref":"2Kgs.18.26","start":12018026,"end":12018026,"break":"paragraph","ruby":[[2,1,"とき"],[8,1,"こ"],[30,1,"い"],[42,1,"ご"],[50,1,"はな"],[76,2,"じょうへき"],[79,1,"うえ"],[83,1,"たみ"],[85,1,"き"],[105,2,"ことば"],[108,1,"はな"]],"text":"その時ヒルキヤの子エリアキムおよびセブナとヨアはラブシャケに言った、「どうぞ、アラム語でしもべどもに話してください。わたしたちは、それがわかるからです。城壁の上にいる民の聞いているところで、わたしたちにユダヤの言葉で話さないでください」。"},{"ref":"2Kgs.18.27","start":12018027,"end":12018027,"break":"none","ruby":[[9,1,"かれ"],[12,1,"い"],[21,2,"しゅくん"],[29,2,"しゅくん"],[42,2,"じょうへき"],[45,1,"うえ"],[47,1,"ざ"],[52,2,"ひとびと"],[59,2,"ことば"],[62,1,"つ"],[84,1,"かれ"],[94,1,"とも"],[96,2,"じぶん"],[99,2,"ふんにょう"],[102,1,"く"],[104,1,"の"],[109,1,"いた"]],"text":"しかしラブシャケは彼らに言った、「わたしの主君は、あなたの主君とあなたにだけでなく、城壁の上に座している人々にも、この言葉を告げるためにわたしをつかわしたのではないか。彼らも、あなたがたと共に自分の糞尿を食い飲みするに至るであろう」。"},{"ref":"2Kgs.18.28","start":12018028,"end":12018028,"break":"paragraph","ruby":[[9,1,"た"],[19,2,"ことば"],[22,2,"おおごえ"],[25,1,"よ"],[30,1,"い"],[35,2,"だいおう"],[44,1,"おう"],[46,2,"ことば"],[49,1,"き"]],"text":"そしてラブシャケは立ちあがり、ユダヤの言葉で大声に呼ばわって言った。「大王、アッスリヤの王の言葉を聞け。"},{"ref":"2Kgs.18.29","start":12018029,"end":12018029,"break":"none","ruby":[[0,1,"おう"],[4,1,"おお"],[22,1,"あざむ"],[32,1,"かれ"],[44,1,"て"],[47,1,"すく"]],"text":"王はこう仰せられる、『あなたがたはヒゼキヤに欺かれてはならない。彼はあなたがたをわたしの手から救いだすことはできない。"},{"ref":"2Kgs.18.30","start":12018030,"end":12018030,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"かなら"],[15,1,"すく"],[17,1,"だ"],[24,1,"まち"],[31,1,"おう"],[33,1,"て"],[35,1,"おちい"],[44,1,"い"],[55,1,"しゅ"],[57,1,"たの"]],"text":"ヒゼキヤが「主は必ずわれわれを救い出される。この町はアッスリヤ王の手に陥ることはない」と言っても、あなたがたは主を頼みとしてはならない』。"},{"ref":"2Kgs.18.31","start":12018031,"end":12018031,"break":"none","ruby":[[11,2,"ことば"],[14,1,"き"],[29,1,"おう"],[33,1,"おお"],[50,2,"わかい"],[59,2,"こうふく"],[79,2,"じぶん"],[86,1,"み"],[88,1,"た"],[95,2,"じぶん"],[103,1,"み"],[105,1,"た"],[112,2,"じぶん"],[115,2,"いど"],[118,1,"みず"],[120,1,"の"]],"text":"あなたがたはヒゼキヤの言葉を聞いてはならない。アッスリヤの王はこう仰せられる、『あなたがたはわたしと和解して、わたしに降服せよ。そうすればあなたがたはおのおの自分のぶどうの実を食べ、おのおの自分のいちじくの実を食べ、おのおの自分の井戸の水を飲むことができるであろう。"},{"ref":"2Kgs.18.32","start":12018032,"end":12018032,"break":"none","ruby":[[7,1,"き"],[19,1,"くに"],[21,1,"つ"],[24,1,"い"],[36,1,"くに"],[41,2,"こくもつ"],[47,1,"しゅ"],[51,1,"ち"],[59,1,"はたけ"],[63,1,"ち"],[69,1,"き"],[71,1,"みつ"],[75,1,"ち"],[86,1,"い"],[99,1,"し"],[113,1,"しゅ"],[120,1,"すく"],[126,1,"い"],[136,1,"まど"],[141,1,"かれ"],[143,1,"き"]],"text":"やがてわたしが来て、あなたがたを一つの国へ連れて行く。それはあなたがたの国のように穀物とぶどう酒のある地、パンとぶどう畑のある地、オリブの木と蜜のある地である。あなたがたは生きながらえることができ、死ぬことはない。ヒゼキヤが「主はわれわれを救われる」と言って、あなたがたを惑わしても彼に聞いてはならない。"},{"ref":"2Kgs.18.33","start":12018033,"end":12018033,"break":"none","ruby":[[0,1,"しょ"],[1,2,"こくみん"],[4,2,"かみがみ"],[12,1,"かみ"],[16,1,"くに"],[24,1,"おう"],[26,1,"て"],[29,1,"すく"]],"text":"諸国民の神々のうち、どの神がその国をアッスリヤの王の手から救ったか。"},{"ref":"2Kgs.18.34","start":12018034,"end":12018034,"break":"none","ruby":[[9,2,"かみがみ"],[35,2,"かみがみ"],[46,1,"かれ"],[58,1,"て"],[61,1,"すく"],[63,1,"だ"]],"text":"ハマテやアルパデの神々はどこにいるのか。セパルワイム、ヘナおよびイワの神々はどこにいるのか。彼らはサマリヤをわたしの手から救い出したか。"},{"ref":"2Kgs.18.35","start":12018035,"end":12018035,"break":"none","ruby":[[0,2,"くにぐに"],[7,2,"かみがみ"],[15,1,"くに"],[21,1,"て"],[24,1,"すく"],[26,1,"だ"],[29,1,"もの"],[36,1,"しゅ"],[52,1,"て"],[55,1,"すく"],[57,1,"だ"]],"text":"国々のすべての神々のうち、その国をわたしの手から救い出した者があったか。主がどうしてエルサレムをわたしの手から救い出すことができよう』」。"},{"ref":"2Kgs.18.36","start":12018036,"end":12018036,"break":"paragraph","ruby":[[3,1,"たみ"],[5,1,"もく"],[11,1,"こと"],[13,1,"かれ"],[15,1,"こた"],[22,1,"おう"],[24,1,"めい"],[28,1,"かれ"],[30,1,"こた"],[40,1,"い"]],"text":"しかし民は黙して、ひと言も彼に答えなかった。王が命じて「彼に答えてはならない」と言っておいたからである。"},{"ref":"2Kgs.18.37","start":12018037,"end":12018037,"break":"none","ruby":[[9,1,"こ"],[13,3,"くないきょう"],[22,3,"しょきかん"],[36,1,"こ"],[40,2,"しかん"],[45,1,"ころも"],[47,1,"さ"],[58,1,"き"],[67,2,"ことば"],[70,1,"かれ"],[72,1,"つ"]],"text":"こうしてヒルキヤの子である宮内卿エリアキム、書記官セブナ、およびアサフの子である史官ヨアは衣を裂き、ヒゼキヤのもとに来て、ラブシャケの言葉を彼に告げた。"}]