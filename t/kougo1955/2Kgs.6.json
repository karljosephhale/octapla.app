[{"ref":"2Kgs.6.1","start":12006001,"end":12006001,"break":"paragraph","ruby":[[2,3,"よげんしゃ"],[16,1,"い"],[31,1,"とも"],[33,1,"す"],[38,1,"ところ"],[40,1,"せま"]],"text":"さて預言者のともがらはエリシャに言った、「わたしたちがあなたと共に住んでいる所は狭くなりましたので、"},{"ref":"2Kgs.6.2","start":12006002,"end":12006002,"break":"none","ruby":[[11,1,"い"],[24,1,"ぽん"],[27,2,"ざいもく"],[30,1,"と"],[42,1,"す"],[44,2,"ばしょ"],[47,1,"つく"],[62,1,"い"],[67,1,"い"]],"text":"わたしたちをヨルダンに行かせ、そこからめいめい一本ずつ材木を取ってきて、わたしたちの住む場所を造らせてください」。エリシャは言った、「行きなさい」。"},{"ref":"2Kgs.6.3","start":12006003,"end":12006003,"break":"none","ruby":[[0,1,"とき"],[23,2,"いっしょ"],[26,1,"い"],[35,1,"い"],[47,1,"い"],[55,1,"こた"]],"text":"時にそのひとりが、「どうぞあなたも、しもべらと一緒に行ってください」と言ったので、エリシャは「行きましょう」と答えた。"},{"ref":"2Kgs.6.4","start":12006004,"end":12006004,"break":"none","ruby":[[8,1,"かれ"],[11,2,"いっしょ"],[14,1,"い"],[18,1,"かれ"],[26,1,"い"],[29,1,"き"],[31,1,"き"],[33,1,"たお"]],"text":"そしてエリシャは彼らと一緒に行った。彼らはヨルダンへ行って木を切り倒したが、"},{"ref":"2Kgs.6.5","start":12006005,"end":12006005,"break":"none","ruby":[[4,2,"ざいもく"],[7,1,"き"],[9,1,"たお"],[20,1,"あたま"],[22,1,"みず"],[24,1,"なか"],[26,1,"お"],[32,1,"かれ"],[34,1,"さけ"],[37,1,"い"],[47,1,"しゅ"],[53,1,"か"]],"text":"ひとりが材木を切り倒しているとき、おのの頭が水の中に落ちたので、彼は叫んで言った。「ああ、わが主よ。これは借りたものです」。"},{"ref":"2Kgs.6.6","start":12006006,"end":12006006,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ひと"],[4,1,"い"],[15,1,"お"],[22,1,"かれ"],[26,2,"ばしょ"],[29,1,"し"],[41,1,"ぽん"],[43,1,"えだ"],[45,1,"き"],[47,1,"おと"],[53,1,"な"],[55,1,"い"],[64,1,"あたま"],[66,1,"うか"]],"text":"神の人は言った、「それはどこに落ちたのか」。彼がその場所を知らせると、エリシャは一本の枝を切り落し、そこに投げ入れて、そのおのの頭を浮ばせ、"},{"ref":"2Kgs.6.7","start":12006007,"end":12006007,"break":"none","ruby":[[4,1,"と"],[11,1,"い"],[19,1,"ひと"],[21,1,"て"],[23,1,"の"],[29,1,"と"]],"text":"「それを取りあげよ」と言ったので、その人は手を伸べてそれを取った。"},{"ref":"2Kgs.6.8","start":12006008,"end":12006008,"break":"paragraph","ruby":[[7,1,"おう"],[15,1,"たたか"],[23,2,"けらい"],[28,2,"ひょうぎ"],[38,1,"ところ"],[44,1,"じん"],[46,1,"は"],[51,1,"い"]],"text":"かつてスリヤの王がイスラエルと戦っていたとき、家来たちと評議して「しかじかの所にわたしの陣を張ろう」と言うと、"},{"ref":"2Kgs.6.9","start":12006009,"end":12006009,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ひと"],[10,1,"おう"],[17,2,"ようじん"],[24,1,"ところ"],[46,1,"くだ"],[56,1,"い"],[58,1,"おく"]],"text":"神の人はイスラエルの王に「あなたは用心して、この所をとおってはなりません。スリヤびとがそこに下ってきますから」と言い送った。"},{"ref":"2Kgs.6.10","start":12006010,"end":12006010,"break":"none","ruby":[[9,1,"おう"],[11,1,"かみ"],[13,1,"ひと"],[15,2,"じぶん"],[18,1,"つ"],[24,1,"ところ"],[26,1,"ひと"],[33,2,"けいかい"],[42,1,"ところ"],[49,1,"ふせ"],[59,1,"かい"]],"text":"それでイスラエルの王は神の人が自分に告げてくれた所に人をつかわし、警戒したので、その所でみずからを防ぎえたことは一、二回にとどまらなかった。"},{"ref":"2Kgs.6.11","start":12006011,"end":12006011,"break":"paragraph","ruby":[[4,1,"おう"],[8,1,"こと"],[13,1,"こころ"],[15,1,"なや"],[19,2,"けらい"],[24,1,"め"],[27,1,"い"],[49,1,"おう"],[51,1,"つう"],[63,1,"つ"],[66,1,"もの"]],"text":"スリヤの王はこの事のために心を悩まし、家来たちを召して言った、「われわれのうち、だれがイスラエルの王と通じているのか、わたしに告げる者はないか」。"},{"ref":"2Kgs.6.12","start":12006012,"end":12006012,"break":"none","ruby":[[4,2,"けらい"],[7,1,"い"],[12,1,"おう"],[16,1,"しゅ"],[22,1,"つう"],[27,1,"もの"],[42,3,"よげんしゃ"],[55,2,"しんしつ"],[58,1,"かた"],[62,2,"ことば"],[72,1,"おう"],[74,1,"つ"]],"text":"ひとりの家来が言った、「王、わが主よ、だれも通じている者はいません。ただイスラエルの預言者エリシャが、あなたが寝室で語られる言葉でもイスラエルの王に告げるのです」。"},{"ref":"2Kgs.6.13","start":12006013,"end":12006013,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[7,1,"かれ"],[15,1,"い"],[18,1,"さが"],[28,1,"ひと"],[33,1,"かれ"],[35,1,"とら"],[41,1,"とき"],[44,1,"かれ"],[54,1,"おう"],[56,1,"つ"],[59,1,"もの"]],"text":"王は言った、「彼がどこにいるか行って捜しなさい。わたしは人をやって彼を捕えよう」。時に「彼はドタンにいる」と王に告げる者があったので、"},{"ref":"2Kgs.6.14","start":12006014,"end":12006014,"break":"none","ruby":[[0,1,"おう"],[5,1,"うま"],[7,2,"せんしゃ"],[12,2,"たいぐん"],[21,1,"かれ"],[24,1,"よる"],[29,1,"き"],[34,1,"まち"],[36,1,"かこ"]],"text":"王はそこに馬と戦車および大軍をつかわした。彼らは夜のうちに来て、その町を囲んだ。"},{"ref":"2Kgs.6.15","start":12006015,"end":12006015,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"ひと"],[4,2,"めしつかい"],[7,1,"あさ"],[8,1,"はや"],[10,1,"お"],[13,1,"で"],[15,1,"み"],[19,2,"ぐんぜい"],[22,1,"うま"],[24,2,"せんしゃ"],[30,1,"まち"],[32,1,"かこ"],[42,2,"わかもの"],[50,1,"い"],[60,1,"しゅ"]],"text":"神の人の召使が朝早く起きて出て見ると、軍勢が馬と戦車をもって町を囲んでいたので、その若者はエリシャに言った、「ああ、わが主よ、わたしたちはどうしましょうか」。"},{"ref":"2Kgs.6.16","start":12006016,"end":12006016,"break":"none","ruby":[[5,1,"い"],[10,1,"おそ"],[24,1,"とも"],[28,1,"もの"],[30,1,"かれ"],[33,1,"とも"],[37,1,"もの"],[41,1,"おお"]],"text":"エリシャは言った、「恐れることはない。われわれと共にいる者は彼らと共にいる者よりも多いのだから」。"},{"ref":"2Kgs.6.17","start":12006017,"end":12006017,"break":"none","ruby":[[8,1,"いの"],[12,1,"しゅ"],[19,1,"かれ"],[21,1,"め"],[23,1,"ひら"],[26,1,"み"],[36,1,"い"],[40,1,"しゅ"],[44,2,"わかもの"],[47,1,"め"],[49,1,"ひら"],[56,1,"かれ"],[58,1,"み"],[62,1,"ひ"],[64,1,"うま"],[66,1,"ひ"],[68,2,"せんしゃ"],[71,1,"やま"],[73,1,"み"]],"text":"そしてエリシャが祈って「主よ、どうぞ、彼の目を開いて見させてください」と言うと、主はその若者の目を開かれたので、彼が見ると、火の馬と火の戦車が山に満ちてエリシャのまわりにあった。"},{"ref":"2Kgs.6.18","start":12006018,"end":12006018,"break":"none","ruby":[[11,1,"ところ"],[13,1,"くだ"],[18,1,"とき"],[25,1,"しゅ"],[27,1,"いの"],[30,1,"い"],[41,2,"ひとびと"],[44,1,"め"],[65,2,"ことば"],[72,1,"かれ"],[75,1,"め"]],"text":"スリヤびとがエリシャの所に下ってきた時、エリシャは主に祈って言った、「どうぞ、この人々の目をくらましてください」。するとエリシャの言葉のとおりに彼らの目をくらまされた。"},{"ref":"2Kgs.6.19","start":12006019,"end":12006019,"break":"none","ruby":[[8,1,"かれ"],[17,1,"みち"],[28,1,"まち"],[63,1,"たず"],[66,1,"ひと"],[68,1,"ところ"],[70,1,"つ"],[73,1,"い"],[81,1,"い"],[85,1,"かれ"],[93,1,"つ"],[96,1,"い"]],"text":"そこでエリシャは彼らに「これはその道ではない。これはその町でもない。わたしについてきなさい。わたしはあなたがたを、あなたがたの尋ねる人の所へ連れて行きましょう」と言って、彼らをサマリヤへ連れて行った。"},{"ref":"2Kgs.6.20","start":12006020,"end":12006020,"break":"paragraph","ruby":[[0,1,"かれ"],[20,1,"い"],[25,1,"しゅ"],[30,2,"ひとびと"],[33,1,"め"],[35,1,"ひら"],[38,1,"み"],[48,1,"しゅ"],[50,1,"かれ"],[53,1,"め"],[55,1,"ひら"],[62,1,"かれ"],[65,1,"み"],[69,1,"み"],[72,1,"かれ"],[83,1,"き"]],"text":"彼らがサマリヤにはいったとき、エリシャは言った、「主よ、この人々の目を開いて見させてください」。主は彼らの目を開かれたので、彼らが見ると、見よ、彼らはサマリヤのうちに来ていた。"},{"ref":"2Kgs.6.21","start":12006021,"end":12006021,"break":"none","ruby":[[6,1,"おう"],[8,1,"かれ"],[11,1,"み"],[19,1,"い"],[26,1,"ちち"],[29,1,"かれ"],[32,1,"う"],[34,1,"ころ"],[42,1,"かれ"],[45,1,"う"],[47,1,"ころ"]],"text":"イスラエルの王は彼らを見て、エリシャに言った、「わが父よ、彼らを撃ち殺しましょうか。彼らを撃ち殺しましょうか」。"},{"ref":"2Kgs.6.22","start":12006022,"end":12006022,"break":"none","ruby":[[5,1,"こた"],[10,1,"う"],[12,1,"ころ"],[29,1,"ゆみ"],[35,2,"ほりょ"],[40,1,"もの"],[44,1,"う"],[46,1,"ころ"],[57,1,"みず"],[59,1,"かれ"],[62,1,"まえ"],[64,1,"そな"],[67,1,"く"],[69,1,"の"],[76,2,"しゅくん"],[82,1,"い"]],"text":"エリシャは答えた、「撃ち殺してはならない。あなたはつるぎと弓をもって、捕虜にした者どもを撃ち殺すでしょうか。パンと水を彼らの前に供えて食い飲みさせ、その主君のもとへ行かせなさい」。"},{"ref":"2Kgs.6.23","start":12006023,"end":12006023,"break":"none","ruby":[[3,1,"おう"],[5,1,"かれ"],[11,1,"さか"],[19,1,"もう"],[23,1,"かれ"],[26,1,"く"],[28,1,"の"],[31,1,"おわ"],[34,1,"かれ"],[37,1,"さ"],[46,2,"しゅくん"],[49,1,"ところ"],[51,1,"かえ"],[59,2,"りゃくだつ"],[61,1,"たい"],[63,1,"ふたた"],[71,1,"ち"]],"text":"そこで王は彼らのために盛んなふるまいを設けた。彼らが食い飲みを終ると彼らを去らせたので、その主君の所へ帰った。スリヤの略奪隊は再びイスラエルの地にこなかった。"},{"ref":"2Kgs.6.24","start":12006024,"end":12006024,"break":"paragraph","ruby":[[2,1,"のち"],[7,1,"おう"],[16,1,"ぜん"],[17,1,"ぐん"],[19,1,"あつ"],[22,1,"のぼ"],[32,1,"せ"],[34,1,"かこ"]],"text":"この後スリヤの王ベネハダデはその全軍を集め、上ってきてサマリヤを攻め囲んだので、"},{"ref":"2Kgs.6.25","start":12006025,"end":12006025,"break":"none","ruby":[[5,1,"はげ"],[12,1,"た"],[20,1,"かれ"],[26,1,"せ"],[28,1,"かこ"],[41,1,"あたま"],[45,1,"ぎん"],[52,1,"う"],[66,1,"ぶん"],[70,1,"ぎん"],[76,1,"う"]],"text":"サマリヤに激しいききんが起った。すなわち彼らがこれを攻め囲んだので、ついに、ろばの頭一つが銀八十シケルで売られ、はとのふん一カブの四分の一が銀五シケルで売られるようになった。"},{"ref":"2Kgs.6.26","start":12006026,"end":12006026,"break":"none","ruby":[[6,1,"おう"],[8,2,"じょうへき"],[11,1,"うえ"],[19,1,"とき"],[25,1,"おんな"],[27,1,"かれ"],[29,1,"よ"],[38,1,"しゅ"],[40,1,"おう"],[43,1,"たす"],[52,1,"い"]],"text":"イスラエルの王が城壁の上をとおっていた時、ひとりの女が彼に呼ばわって、「わが主、王よ、助けてください」と言ったので、"},{"ref":"2Kgs.6.27","start":12006027,"end":12006027,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[9,1,"しゅ"],[15,1,"たす"],[25,1,"なに"],[38,1,"たす"],[49,1,"う"],[51,1,"ば"],[53,1,"もの"],[60,1,"さか"],[64,1,"もの"]],"text":"彼は言った、「もし主があなたを助けられないならば、何をもってわたしがあなたを助けることができよう。打ち場の物をもってか、酒ぶねの物をもってか」。"},{"ref":"2Kgs.6.28","start":12006028,"end":12006028,"break":"none","ruby":[[3,1,"おう"],[5,1,"おんな"],[7,1,"たず"],[12,2,"なにごと"],[21,2,"かのじょ"],[24,1,"こた"],[31,1,"おんな"],[46,1,"こ"],[66,1,"た"],[76,1,"こ"],[78,1,"た"],[86,1,"い"]],"text":"そして王は女に尋ねた、「何事なのですか」。彼女は答えた、「この女はわたしにむかって『あなたの子をください。わたしたちは、きょうそれを食べ、あす、わたしの子を食べましょう』と言いました。"},{"ref":"2Kgs.6.29","start":12006029,"end":12006029,"break":"none","ruby":[[16,1,"こ"],[18,1,"に"],[20,1,"た"],[27,1,"つぎ"],[29,1,"ひ"],[34,2,"かのじょ"],[46,1,"こ"],[62,1,"た"],[70,1,"い"],[76,2,"かのじょ"],[81,1,"こ"],[83,1,"かく"]],"text":"それでわたしたちは、まずわたしの子を煮て食べましたが、次の日わたしが彼女にむかって『あなたの子をください。わたしたちはそれを食べましょう』と言いますと、彼女はその子を隠しました」。"},{"ref":"2Kgs.6.30","start":12006030,"end":12006030,"break":"none","ruby":[[0,1,"おう"],[4,1,"おんな"],[6,2,"ことば"],[9,1,"き"],[13,1,"ころも"],[15,1,"さ"],[20,1,"おう"],[22,2,"じょうへき"],[25,1,"うえ"],[35,1,"たみ"],[37,1,"み"],[43,1,"み"],[45,2,"あらぬの"],[48,1,"つ"]],"text":"王はその女の言葉を聞いて、衣を裂き、――王は城壁の上をとおっていたが、民が見ると、その身に荒布を着けていた――"},{"ref":"2Kgs.6.31","start":12006031,"end":12006031,"break":"none","ruby":[[3,1,"おう"],[5,1,"い"],[18,1,"こ"],[24,1,"くび"],[28,1,"かた"],[30,1,"うえ"],[42,1,"かみ"],[54,1,"ばっ"]],"text":"そして王は言った「きょう、シャパテの子エリシャの首がその肩の上にすわっているならば、神がどんなにでもわたしを罰してくださるように」。"},{"ref":"2Kgs.6.32","start":12006032,"end":12006032,"break":"paragraph","ruby":[[9,1,"いえ"],[11,1,"ざ"],[18,2,"ちょうろう"],[25,1,"かれ"],[27,1,"とも"],[29,1,"ざ"],[33,1,"おう"],[35,2,"じぶん"],[38,1,"ところ"],[41,1,"ひと"],[57,2,"ししゃ"],[62,1,"つ"],[69,2,"ちょうろう"],[74,1,"い"],[88,1,"ひと"],[90,1,"ころ"],[92,1,"もの"],[98,1,"くび"],[100,1,"と"],[106,1,"ひと"],[114,1,"み"],[121,2,"ししゃ"],[130,1,"と"],[132,1,"と"],[136,1,"うち"],[138,1,"い"],[148,1,"かれ"],[157,2,"しゅくん"],[160,2,"あしおと"]],"text":"さてエリシャはその家に座していたが、長老たちもきて彼と共に座した。王は自分の所から人をつかわしたが、エリシャはその使者がまだ着かないうちに長老たちに言った、「あなたがたは、この人を殺す者がわたしの首を取るために、人をつかわすのを見ますか。その使者がきたならば、戸を閉じて、内に入れてはなりません。彼のうしろに、その主君の足音がするではありませんか」。"},{"ref":"2Kgs.6.33","start":12006033,"end":12006033,"break":"none","ruby":[[0,1,"かれ"],[4,1,"かれ"],[7,1,"かた"],[16,1,"おう"],[18,1,"かれ"],[23,1,"くだ"],[28,1,"い"],[35,1,"わざわい"],[37,1,"しゅ"],[40,1,"で"],[56,1,"うえ"],[58,1,"しゅ"],[60,1,"ま"]],"text":"彼がなお彼らと語っているうちに、王は彼のもとに下ってきて言った、「この災は主から出たのです。わたしはどうしてこの上、主を待たなければならないでしょうか」。"}]