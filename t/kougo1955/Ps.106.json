[{"ref":"Ps.106.1","start":19106001,"end":19106001,"break":"paragraph","breaks":[[9,"line"],[24,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"しゅ"],[11,2,"かんしゃ"],[16,1,"しゅ"],[18,1,"めぐ"],[37,1,"た"]],"text":"主をほめたたえよ。主に感謝せよ、主は恵みふかく、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.106.2","start":19106002,"end":19106002,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"しゅ"],[5,2,"たいのう"],[12,1,"かた"],[17,1,"ほまれ"],[24,1,"い"]],"text":"だれが主の大能のみわざを語り、その誉をことごとく言いあらわすことができようか。"},{"ref":"Ps.106.3","start":19106003,"end":19106003,"break":"line","ruby":[[0,2,"こうせい"],[3,1,"まも"],[5,2,"ひとびと"],[8,1,"つね"],[10,2,"せいぎ"],[13,1,"おこな"],[15,1,"ひと"]],"text":"公正を守る人々、常に正義を行う人はさいわいである。"},{"ref":"Ps.106.4","start":19106004,"end":19106004,"break":"line","breaks":[[18,"line"],[30,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"たみ"],[11,1,"めぐ"],[22,1,"おぼ"],[34,1,"かれ"],[37,1,"すく"],[48,1,"たす"]],"text":"主よ、あなたがその民を恵まれるとき、わたしを覚えてください。あなたが彼らを救われるとき、わたしを助けてください。"},{"ref":"Ps.106.5","start":19106005,"end":19106005,"break":"line","breaks":[[25,"line"],[40,"line"]],"ruby":[[14,1,"えら"],[18,1,"もの"],[20,2,"はんえい"],[23,1,"み"],[29,2,"くにたみ"],[32,1,"よろこ"],[44,1,"し"],[45,1,"ぎょう"],[47,1,"とも"],[49,1,"ほこ"]],"text":"そうすれば、わたしはあなたの選ばれた者の繁栄を見、あなたの国民の喜びをよろこび、あなたの嗣業と共に誇ることができるでしょう。"},{"ref":"Ps.106.6","start":19106006,"end":19106006,"break":"line","breaks":[[18,"line"]],"ruby":[[4,2,"せんぞ"],[9,1,"おな"],[12,1,"つみ"],[14,1,"おか"],[22,2,"ふぎ"],[28,1,"あ"],[34,1,"おこな"]],"text":"われらは先祖たちと同じく罪を犯した。われらは不義をなし、悪しきことを行った。"},{"ref":"Ps.106.7","start":19106007,"end":19106007,"break":"line","breaks":[[19,"line"],[37,"line"],[56,"line"]],"ruby":[[4,2,"せんぞ"],[31,1,"こころ"],[33,1,"と"],[47,1,"ゆた"],[52,1,"おも"],[56,2,"こうかい"],[62,1,"たか"],[64,1,"かみ"]],"text":"われらの先祖たちはエジプトにいたとき、あなたのくすしきみわざに心を留めず、あなたのいつくしみの豊かなのを思わず、紅海で、いと高き神にそむいた。"},{"ref":"Ps.106.8","start":19106008,"end":19106008,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"しゅ"],[8,2,"たいのう"],[11,1,"し"],[19,1,"な"],[24,1,"かれ"],[27,1,"すく"]],"text":"けれども主はその大能を知らせようと、み名のために彼らを救われた。"},{"ref":"Ps.106.9","start":19106009,"end":19106009,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"こうかい"],[18,1,"かれ"],[21,1,"みちび"],[24,2,"あらの"],[27,1,"い"],[33,1,"ふち"],[35,1,"とお"]],"text":"主は紅海をしかって、それをかわかし、彼らを導いて荒野を行くように、淵を通らせられた。"},{"ref":"Ps.106.10","start":19106010,"end":19106010,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"かれ"],[12,1,"て"],[15,1,"すく"],[18,1,"てき"],[20,1,"ちから"]],"text":"こうして主は彼らをあだの手から救い、敵の力からあがなわれた。"},{"ref":"Ps.106.11","start":19106011,"end":19106011,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"みず"],[2,1,"かれ"],[24,1,"い"],[26,1,"のこ"],[29,1,"もの"]],"text":"水が彼らのあだをおおったので、そのうち、ひとりも生き残った者はなかった。"},{"ref":"Ps.106.12","start":19106012,"end":19106012,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"かれ"],[10,2,"ことば"],[13,1,"しん"],[18,1,"ほまれ"],[20,1,"うた"]],"text":"このとき彼らはそのみ言葉を信じ、その誉を歌った。"},{"ref":"Ps.106.13","start":19106013,"end":19106013,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"かれ"],[16,1,"わす"],[21,1,"すす"],[24,1,"ま"]],"text":"しかし彼らはまもなくそのみわざを忘れ、その勧めを待たず、"},{"ref":"Ps.106.14","start":19106014,"end":19106014,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"の"],[7,2,"よくぼう"],[10,1,"おこ"],[13,2,"あらの"],[16,1,"かみ"],[18,1,"こころ"]],"text":"野でわがままな欲望を起し、荒野で神を試みた。"},{"ref":"Ps.106.15","start":19106015,"end":19106015,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[7,1,"もと"],[13,1,"あた"],[20,1,"かれ"],[26,2,"びょうき"],[29,1,"おく"],[35,1,"おとろ"]],"text":"主は彼らにその求めるものを与えられたが、彼らのうちに病気を送って、やせ衰えさせられた。"},{"ref":"Ps.106.16","start":19106016,"end":19106016,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ひとびと"],[3,2,"しゅくえい"],[17,1,"しゅ"],[19,2,"せいじゃ"]],"text":"人々が宿営のうちでモーセをねたみ、主の聖者アロンをねたんだとき、"},{"ref":"Ps.106.17","start":19106017,"end":19106017,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ち"],[2,1,"ひら"],[9,1,"の"],[17,2,"なかま"]],"text":"地が開けてダタンを飲み、アビラムの仲間をおおった。"},{"ref":"Ps.106.18","start":19106018,"end":19106018,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ひ"],[6,2,"なかま"],[12,1,"も"],[14,1,"おこ"],[17,1,"ほのお"],[19,1,"あ"],[22,1,"もの"],[24,1,"や"]],"text":"火はまたこの仲間のうちに燃え起り、炎は悪しき者を焼きつくした。"},{"ref":"Ps.106.19","start":19106019,"end":19106019,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[7,1,"こ"],[8,1,"うし"],[10,1,"つく"],[13,2,"いもの"],[16,1,"ぞう"],[18,1,"おが"]],"text":"彼らはホレブで子牛を造り、鋳物の像を拝んだ。"},{"ref":"Ps.106.20","start":19106020,"end":19106020,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,2,"えいこう"],[8,1,"くさ"],[10,1,"く"],[12,1,"うし"],[14,1,"ぞう"],[16,1,"と"],[18,1,"か"]],"text":"彼らは神の栄光を草を食う牛の像と取り替えた。"},{"ref":"Ps.106.21","start":19106021,"end":19106022,"break":"line","breaks":[[18,"line"],[34,"line"],[51,"line"]],"ruby":[[0,1,"かれ"],[9,1,"おお"],[13,1,"こと"],[21,1,"ち"],[34,2,"こうかい"],[41,1,"おそ"],[45,1,"こと"],[51,2,"すくいぬし"],[55,1,"かみ"],[57,1,"わす"]],"text":"彼らは、エジプトで大いなる事をなし、ハムの地でくすしきみわざをなし、紅海のほとりで恐るべき事をなされた救主なる神を忘れた。"},{"ref":"Ps.106.23","start":19106023,"end":19106023,"break":"line","breaks":[[20,"line"],[36,"line"],[48,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"かれ"],[10,1,"ほろ"],[15,1,"い"],[23,1,"しゅ"],[26,1,"えら"],[36,1,"やぶ"],[38,1,"くち"],[40,1,"しゅ"],[43,1,"まえ"],[45,1,"た"],[49,1,"いか"],[52,1,"ひ"],[59,1,"ほろ"],[62,1,"まぬか"]],"text":"それゆえ、主は彼らを滅ぼそうと言われた。しかし主のお選びになったモーセは破れ口で主のみ前に立ち、み怒りを引きかえして、滅びを免れさせた。"},{"ref":"Ps.106.24","start":19106024,"end":19106024,"break":"line","ruby":[[0,1,"かれ"],[3,1,"うるわ"],[6,1,"ち"],[8,1,"あなど"],[11,1,"しゅ"],[13,2,"やくそく"],[16,1,"しん"]],"text":"彼らは麗しい地を侮り、主の約束を信ぜず、"},{"ref":"Ps.106.25","start":19106025,"end":19106025,"break":"line","breaks":[[12,"line"]],"ruby":[[4,2,"てんまく"],[12,1,"しゅ"],[15,1,"こえ"],[17,1,"き"],[19,1,"したが"]],"text":"またその天幕でつぶやき、主のみ声に聞き従わなかった。"},{"ref":"Ps.106.26","start":19106026,"end":19106026,"break":"line","breaks":[[20,"line"]],"ruby":[[5,1,"しゅ"],[8,1,"て"],[14,1,"かれ"],[17,1,"ちか"],[20,1,"かれ"],[23,2,"あらの"],[26,1,"たお"]],"text":"それゆえ、主はみ手をあげて、彼らに誓い、彼らを荒野で倒れさせ、"},{"ref":"Ps.106.27","start":19106027,"end":19106027,"break":"line","breaks":[[25,"line"]],"ruby":[[4,2,"しそん"],[13,2,"くにたみ"],[19,1,"お"],[21,1,"ち"],[30,1,"ち"],[32,1,"かれ"],[37,1,"ち"]],"text":"またその子孫を、もろもろの国民のうちに追い散らし、もろもろの地に彼らをまき散らそうとされた。"},{"ref":"Ps.106.28","start":19106028,"end":19106028,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"かれ"],[13,1,"した"],[17,1,"し"],[20,1,"もの"],[32,1,"た"]],"text":"また彼らはペオルのバアルを慕って、死んだ者にささげた、いけにえを食べた。"},{"ref":"Ps.106.29","start":19106029,"end":19106029,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[13,1,"しゅ"],[15,1,"いか"],[22,1,"かれ"],[28,2,"えきびょう"],[31,1,"おこ"]],"text":"彼らはそのおこないをもって主を怒らせたので、彼らのうちに疫病が起った。"},{"ref":"Ps.106.30","start":19106030,"end":19106030,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"とき"],[8,1,"た"],[11,2,"ちゅうさい"],[21,2,"えきびょう"]],"text":"その時ピネハスが立って仲裁にはいったので、疫病はやんだ。"},{"ref":"Ps.106.31","start":19106031,"end":19106031,"break":"line","breaks":[[18,"line"]],"ruby":[[14,1,"よ"],[23,1,"ぎ"]],"text":"これによってピネハスはよろず代まで、とこしえに義とされた。"},{"ref":"Ps.106.32","start":19106032,"end":19106032,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かれ"],[9,1,"みず"],[15,1,"しゅ"],[17,1,"いか"],[28,1,"かれ"],[34,1,"わざわい"]],"text":"彼らはまたメリバの水のほとりで主を怒らせたので、モーセは彼らのために災にあった。"},{"ref":"Ps.106.33","start":19106033,"end":19106033,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"かれ"],[6,1,"かみ"],[8,1,"れい"],[17,1,"かれ"],[26,2,"けいそつ"],[32,1,"い"]],"text":"これは彼らが神の霊にそむいたとき、彼がそのくちびるで軽率なことを言ったからである。"},{"ref":"Ps.106.34","start":19106034,"end":19106034,"break":"line","ruby":[[0,1,"かれ"],[3,1,"しゅ"],[5,1,"めい"],[15,1,"たみ"],[17,1,"ほろ"]],"text":"彼らは主が命じられたもろもろの民を滅ぼさず、"},{"ref":"Ps.106.35","start":19106035,"end":19106035,"break":"line","breaks":[[16,"line"]],"ruby":[[9,2,"くにたみ"]],"text":"かえってもろもろの国民とまじってそのわざにならい、"},{"ref":"Ps.106.36","start":19106036,"end":19106036,"break":"line","ruby":[[0,2,"じぶん"],[11,2,"ぐうぞう"],[14,1,"つか"]],"text":"自分たちのわなとなった偶像に仕えた。"},{"ref":"Ps.106.37","start":19106037,"end":19106037,"break":"line","ruby":[[0,1,"かれ"],[9,1,"むすめ"],[13,2,"あくれい"]],"text":"彼らはそのむすこ、娘たちを悪霊にささげ、"},{"ref":"Ps.106.38","start":19106038,"end":19106038,"break":"line","breaks":[[21,"line"],[37,"line"]],"ruby":[[0,1,"つみ"],[4,1,"ち"],[14,2,"ぐうぞう"],[27,1,"むすめ"],[31,1,"ち"],[33,1,"なが"],[41,1,"くに"],[43,1,"ち"],[45,1,"けが"]],"text":"罪のない血、すなわちカナンの偶像にささげたそのむすこ、娘たちの血を流した。こうして国は血で汚された。"},{"ref":"Ps.106.39","start":19106039,"end":19106039,"break":"line","breaks":[[23,"line"]],"ruby":[[5,1,"かれ"],[20,1,"けが"],[33,2,"かんいん"]],"text":"このように彼らはそのわざによっておのれを汚し、そのおこないによって姦淫をなした。"},{"ref":"Ps.106.40","start":19106040,"end":19106040,"break":"line","breaks":[[21,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"いか"],[12,1,"たみ"],[18,1,"も"],[23,1,"し"],[24,1,"ぎょう"],[26,1,"にく"]],"text":"それゆえ、主の怒りがその民にむかって燃え、その嗣業を憎んで、"},{"ref":"Ps.106.41","start":19106041,"end":19106041,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[8,2,"くにたみ"],[11,1,"て"],[19,1,"かれ"],[26,1,"にく"],[28,1,"もの"],[30,1,"おさ"]],"text":"彼らをもろもろの国民の手にわたされた。彼らはおのれを憎む者に治められ、"},{"ref":"Ps.106.42","start":19106042,"end":19106042,"break":"line","breaks":[[11,"line"]],"ruby":[[2,1,"てき"],[13,1,"ちから"],[15,1,"した"],[17,2,"せいふく"]],"text":"その敵にしえたげられ、その力の下に征服された。"},{"ref":"Ps.106.43","start":19106043,"end":19106043,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"かれ"],[9,1,"たす"],[16,1,"かれ"],[25,1,"もう"],[34,2,"ふぎ"],[40,1,"ひく"]],"text":"主はしばしば彼らを助けられたが、彼らははかりごとを設けてそむき、その不義によって低くされた。"},{"ref":"Ps.106.44","start":19106044,"end":19106044,"break":"line","breaks":[[25,"line"]],"ruby":[[10,1,"しゅ"],[12,1,"かれ"],[15,1,"さけ"],[18,1,"き"],[27,1,"なや"]],"text":"それにもかかわらず、主は彼らの叫びを聞かれたとき、その悩みをかえりみ、"},{"ref":"Ps.106.45","start":19106045,"end":19106045,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[2,2,"けいやく"],[5,1,"かれ"],[11,1,"おも"],[13,1,"だ"],[24,1,"ゆた"],[37,1,"か"]],"text":"その契約を彼らのために思い出し、そのいつくしみの豊かなるにより、みこころを変えられ、"},{"ref":"Ps.106.46","start":19106046,"end":19106046,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[9,1,"もの"]],"text":"彼らをとりこにした者どもによって、あわれまれるようにされた。"},{"ref":"Ps.106.47","start":19106047,"end":19106047,"break":"line","breaks":[[17,"line"],[37,"line"],[55,"line"]],"ruby":[[4,1,"かみ"],[6,1,"しゅ"],[13,1,"すく"],[22,2,"くにたみ"],[29,1,"あつ"],[45,1,"せい"],[49,1,"な"],[51,2,"かんしゃ"],[59,1,"ほまれ"],[61,1,"ほこ"]],"text":"われらの神、主よ、われらを救って、もろもろの国民のなかから集めてください。われらはあなたの聖なるみ名に感謝し、あなたの誉を誇るでしょう。"},{"ref":"Ps.106.48","start":19106048,"end":19106048,"break":"line","breaks":[[10,"line"],[29,"line"],[47,"line"]],"ruby":[[6,1,"かみ"],[8,1,"しゅ"],[33,1,"たみ"],[47,1,"しゅ"]],"text":"イスラエルの神、主はとこしえからとこしえまでほむべきかな。すべての民は「アァメン」ととなえよ。主をほめたたえよ。"}]