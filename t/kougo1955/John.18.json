[{"ref":"John.18.1","start":43018001,"end":43018001,"break":"paragraph","ruby":[[11,1,"かた"],[13,1,"お"],[17,2,"でし"],[22,2,"いっしょ"],[30,1,"たに"],[32,1,"む"],[36,1,"い"],[45,1,"その"],[55,2,"でし"],[60,2,"いっしょ"],[65,1,"なか"]],"text":"イエスはこれらのことを語り終えて、弟子たちと一緒にケデロンの谷の向こうへ行かれた。そこには園があって、イエスは弟子たちと一緒にその中にはいられた。"},{"ref":"John.18.2","start":43018002,"end":43018002,"break":"none","ruby":[[4,2,"うらぎ"],[14,1,"ところ"],[18,1,"し"],[28,2,"でし"],[41,1,"あつ"]],"text":"イエスを裏切ったユダは、その所をよく知っていた。イエスと弟子たちとがたびたびそこで集まったことがあるからである。"},{"ref":"John.18.3","start":43018003,"end":43018003,"break":"none","ruby":[[6,2,"いったい"],[9,2,"へいそつ"],[12,3,"さいしちょう"],[20,1,"びと"],[24,1,"おく"],[27,2,"したやく"],[32,1,"ひ"],[34,1,"つ"],[46,2,"ぶき"],[49,1,"も"]],"text":"さてユダは、一隊の兵卒と祭司長やパリサイ人たちの送った下役どもを引き連れ、たいまつやあかりや武器を持って、そこへやってきた。"},{"ref":"John.18.4","start":43018004,"end":43018004,"break":"none","ruby":[[8,2,"じぶん"],[11,1,"み"],[13,1,"おこ"],[27,2,"しょうち"],[35,1,"すす"],[37,1,"で"],[39,1,"かれ"],[42,1,"い"],[51,1,"さが"]],"text":"しかしイエスは、自分の身に起ろうとすることをことごとく承知しておられ、進み出て彼らに言われた、「だれを捜しているのか」。"},{"ref":"John.18.5","start":43018005,"end":43018005,"break":"none","ruby":[[0,1,"かれ"],[14,1,"こた"],[22,1,"かれ"],[25,1,"い"],[47,2,"うらぎ"],[55,1,"かれ"],[58,2,"いっしょ"],[61,1,"た"]],"text":"彼らは「ナザレのイエスを」と答えた。イエスは彼らに言われた、「わたしが、それである」。イエスを裏切ったユダも、彼らと一緒に立っていた。"},{"ref":"John.18.6","start":43018006,"end":43018006,"break":"none","ruby":[[4,1,"かれ"],[20,1,"い"],[27,1,"かれ"],[34,1,"ひ"],[40,1,"ち"],[42,1,"たお"]],"text":"イエスが彼らに「わたしが、それである」と言われたとき、彼らはうしろに引きさがって地に倒れた。"},{"ref":"John.18.7","start":43018007,"end":43018007,"break":"none","ruby":[[5,1,"かれ"],[13,1,"さが"],[23,1,"たず"],[30,1,"かれ"],[44,1,"い"]],"text":"そこでまた彼らに、「だれを捜しているのか」とお尋ねになると、彼らは「ナザレのイエスを」と言った。"},{"ref":"John.18.8","start":43018008,"end":43018008,"break":"none","ruby":[[4,1,"こた"],[22,1,"い"],[35,1,"さが"],[46,1,"ひと"],[50,1,"さ"]],"text":"イエスは答えられた、「わたしがそれであると、言ったではないか。わたしを捜しているのなら、この人たちを去らせてもらいたい」。"},{"ref":"John.18.9","start":43018009,"end":43018009,"break":"none","ruby":[[9,1,"あた"],[12,1,"くだ"],[16,1,"ひと"],[20,1,"なか"],[31,1,"うしな"],[43,1,"い"],[47,2,"ことば"],[51,2,"じょうじゅ"]],"text":"それは、「あなたが与えて下さった人たちの中のひとりも、わたしは失わなかった」とイエスの言われた言葉が、成就するためである。"},{"ref":"John.18.10","start":43018010,"end":43018010,"break":"none","ruby":[[8,1,"けん"],[10,1,"も"],[20,1,"ぬ"],[24,3,"だいさいし"],[28,1,"しもべ"],[30,1,"き"],[38,1,"みぎ"],[40,1,"みみ"],[42,1,"き"],[44,1,"おと"],[50,1,"しもべ"],[52,1,"な"]],"text":"シモン・ペテロは剣を持っていたが、それを抜いて、大祭司の僕に切りかかり、その右の耳を切り落した。その僕の名はマルコスであった。"},{"ref":"John.18.11","start":43018011,"end":43018011,"break":"none","ruby":[[12,1,"い"],[18,1,"けん"],[23,1,"おさ"],[29,1,"ちち"],[35,1,"くだ"],[39,1,"さかずき"],[42,1,"の"]],"text":"すると、イエスはペテロに言われた、「剣をさやに納めなさい。父がわたしに下さった杯は、飲むべきではないか」。"},{"ref":"John.18.12","start":43018012,"end":43018012,"break":"paragraph","ruby":[[4,2,"いったい"],[7,2,"へいそつ"],[12,3,"せんそつちょう"],[19,1,"じん"],[21,2,"したやく"],[31,1,"とら"],[34,1,"しば"]],"text":"それから一隊の兵卒やその千卒長やユダヤ人の下役どもが、イエスを捕え、縛りあげて、"},{"ref":"John.18.13","start":43018013,"end":43018013,"break":"none","ruby":[[11,1,"ひ"],[13,1,"つ"],[16,1,"い"],[20,1,"かれ"],[24,1,"とし"],[26,3,"だいさいし"]],"text":"まずアンナスのところに引き連れて行った。彼はその年の大祭司カヤパのしゅうとであった。"},{"ref":"John.18.14","start":43018014,"end":43018014,"break":"none","ruby":[[4,1,"まえ"],[11,1,"ひと"],[13,1,"たみ"],[18,1,"し"],[32,1,"じん"],[34,2,"じょげん"],[38,1,"もの"]],"text":"カヤパは前に、ひとりの人が民のために死ぬのはよいことだと、ユダヤ人に助言した者であった。"},{"ref":"John.18.15","start":43018015,"end":43018015,"break":"paragraph","ruby":[[14,2,"でし"],[26,1,"い"],[32,2,"でし"],[35,3,"だいさいし"],[39,1,"し"],[41,1,"あ"],[54,2,"いっしょ"],[57,3,"だいさいし"],[61,2,"なかにわ"]],"text":"シモン・ペテロともうひとりの弟子とが、イエスについて行った。この弟子は大祭司の知り合いであったので、イエスと一緒に大祭司の中庭にはいった。"},{"ref":"John.18.16","start":43018016,"end":43018016,"break":"none","ruby":[[8,1,"そと"],[10,2,"とぐち"],[13,1,"た"],[22,3,"だいさいし"],[26,1,"し"],[28,1,"あ"],[35,2,"でし"],[39,1,"そと"],[41,1,"で"],[43,1,"い"],[46,2,"もんばん"],[49,1,"おんな"],[51,1,"はな"],[58,1,"うち"],[60,1,"い"]],"text":"しかし、ペテロは外で戸口に立っていた。すると大祭司の知り合いであるその弟子が、外に出て行って門番の女に話し、ペテロを内に入れてやった。"},{"ref":"John.18.17","start":43018017,"end":43018017,"break":"none","ruby":[[6,2,"もんばん"],[9,1,"おんな"],[15,1,"い"],[27,1,"ひと"],[29,2,"でし"],[61,1,"こた"]],"text":"すると、この門番の女がペテロに言った、「あなたも、あの人の弟子のひとりではありませんか」。ペテロは「いや、そうではない」と答えた。"},{"ref":"John.18.18","start":43018018,"end":43018018,"break":"none","ruby":[[0,1,"しもべ"],[2,2,"したやく"],[8,1,"さむ"],[10,1,"とき"],[18,2,"すみび"],[28,1,"た"],[44,1,"かれ"],[47,1,"ま"],[51,1,"た"]],"text":"僕や下役どもは、寒い時であったので、炭火をおこし、そこに立ってあたっていた。ペテロもまた彼らに交じり、立ってあたっていた。"},{"ref":"John.18.19","start":43018019,"end":43018019,"break":"paragraph","ruby":[[0,3,"だいさいし"],[9,2,"でし"],[21,1,"おしえ"],[26,1,"たず"]],"text":"大祭司はイエスに、弟子たちのことやイエスの教のことを尋ねた。"},{"ref":"John.18.20","start":43018020,"end":43018020,"break":"none","ruby":[[4,1,"こた"],[17,1,"よ"],[19,1,"たい"],[22,2,"こうぜん"],[25,1,"かた"],[38,1,"じん"],[40,1,"あつ"],[43,2,"かいどう"],[46,1,"みや"],[52,1,"おし"],[58,2,"なにごと"],[61,1,"かく"],[64,1,"かた"]],"text":"イエスは答えられた、「わたしはこの世に対して公然と語ってきた。すべてのユダヤ人が集まる会堂や宮で、いつも教えていた。何事も隠れて語ったことはない。"},{"ref":"John.18.21","start":43018021,"end":43018021,"break":"none","ruby":[[7,1,"たず"],[17,1,"かれ"],[20,1,"かた"],[30,1,"き"],[33,2,"ひとびと"],[36,1,"たず"],[47,1,"い"],[54,1,"かれ"],[57,1,"し"]],"text":"なぜ、わたしに尋ねるのか。わたしが彼らに語ったことは、それを聞いた人々に尋ねるがよい。わたしの言ったことは、彼らが知っているのだから」。"},{"ref":"John.18.22","start":43018022,"end":43018022,"break":"none","ruby":[[6,1,"い"],[15,1,"た"],[20,2,"したやく"],[29,3,"だいさいし"],[43,1,"こたえ"],[51,1,"い"],[55,2,"ひらて"],[62,1,"う"]],"text":"イエスがこう言われると、そこに立っていた下役のひとりが、「大祭司にむかって、そのような答をするのか」と言って、平手でイエスを打った。"},{"ref":"John.18.23","start":43018023,"end":43018023,"break":"none","ruby":[[4,1,"こた"],[17,1,"なに"],[19,1,"わる"],[24,1,"い"],[33,1,"わる"],[35,2,"りゆう"],[38,1,"い"],[48,1,"ただ"],[54,1,"い"],[67,1,"う"]],"text":"イエスは答えられた、「もしわたしが何か悪いことを言ったのなら、その悪い理由を言いなさい。しかし、正しいことを言ったのなら、なぜわたしを打つのか」。"},{"ref":"John.18.24","start":43018024,"end":43018024,"break":"none","ruby":[[14,1,"しば"],[19,3,"だいさいし"],[30,1,"おく"]],"text":"それからアンナスは、イエスを縛ったまま大祭司カヤパのところへ送った。"},{"ref":"John.18.25","start":43018025,"end":43018025,"break":"none","ruby":[[9,1,"た"],[12,1,"ひ"],[24,2,"ひとびと"],[27,1,"かれ"],[29,1,"い"],[41,1,"ひと"],[43,2,"でし"],[56,1,"かれ"],[63,1,"け"],[79,1,"い"]],"text":"シモン・ペテロは、立って火にあたっていた。すると人々が彼に言った、「あなたも、あの人の弟子のひとりではないか」。彼はそれをうち消して、「いや、そうではない」と言った。"},{"ref":"John.18.26","start":43018026,"end":43018026,"break":"none","ruby":[[0,3,"だいさいし"],[4,1,"しもべ"],[15,1,"みみ"],[17,1,"き"],[24,1,"ひと"],[26,2,"しんぞく"],[29,1,"もの"],[31,1,"い"],[40,1,"その"],[44,1,"ひと"],[46,2,"いっしょ"],[58,1,"み"]],"text":"大祭司の僕のひとりで、ペテロに耳を切りおとされた人の親族の者が言った、「あなたが園であの人と一緒にいるのを、わたしは見たではないか」。"},{"ref":"John.18.27","start":43018027,"end":43018027,"break":"none","ruby":[[9,1,"う"],[11,1,"け"],[22,1,"にわとり"],[24,1,"な"]],"text":"ペテロはまたそれを打ち消した。するとすぐに、鶏が鳴いた。"},{"ref":"John.18.28","start":43018028,"end":43018028,"break":"paragraph","ruby":[[4,2,"ひとびと"],[21,2,"かんてい"],[27,1,"い"],[31,1,"とき"],[33,2,"よあ"],[41,1,"かれ"],[49,1,"う"],[54,2,"すぎこし"],[57,2,"しょくじ"],[67,2,"かんてい"]],"text":"それから人々は、イエスをカヤパのところから官邸につれて行った。時は夜明けであった。彼らは、けがれを受けないで過越の食事ができるように、官邸にはいらなかった。"},{"ref":"John.18.29","start":43018029,"end":43018029,"break":"none","ruby":[[8,1,"かれ"],[15,1,"で"],[19,1,"い"],[33,1,"ひと"],[35,1,"たい"],[41,1,"うった"],[44,1,"おこ"]],"text":"そこで、ピラトは彼らのところに出てきて言った、「あなたがたは、この人に対してどんな訴えを起すのか」。"},{"ref":"John.18.30","start":43018030,"end":43018030,"break":"none","ruby":[[0,1,"かれ"],[7,1,"こた"],[10,1,"い"],[19,1,"ひと"],[21,2,"あくじ"],[39,1,"ひ"],[41,1,"わた"]],"text":"彼らはピラトに答えて言った、「もしこの人が悪事をはたらかなかったなら、あなたに引き渡すようなことはしなかったでしょう」。"},{"ref":"John.18.31","start":43018031,"end":43018031,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[21,1,"かれ"],[23,1,"ひ"],[25,1,"と"],[29,2,"じぶん"],[34,2,"りっぽう"],[48,1,"じん"],[51,1,"かれ"],[53,1,"い"],[66,1,"ひと"],[68,2,"しけい"],[73,2,"けんげん"]],"text":"そこでピラトは彼らに言った、「あなたがたは彼を引き取って、自分たちの律法でさばくがよい」。ユダヤ人らは彼に言った、「わたしたちには、人を死刑にする権限がありません」。"},{"ref":"John.18.32","start":43018032,"end":43018032,"break":"none","ruby":[[5,2,"じしん"],[11,1,"し"],[26,1,"しめ"],[31,1,"い"],[39,2,"ことば"],[43,2,"じょうじゅ"]],"text":"これは、ご自身がどんな死にかたをしようとしているかを示すために言われたイエスの言葉が、成就するためである。"},{"ref":"John.18.33","start":43018033,"end":43018033,"break":"paragraph","ruby":[[9,2,"かんてい"],[20,1,"よ"],[22,1,"だ"],[25,1,"い"],[38,1,"じん"],[40,1,"おう"]],"text":"さて、ピラトはまた官邸にはいり、イエスを呼び出して言った、「あなたは、ユダヤ人の王であるか」。"},{"ref":"John.18.34","start":43018034,"end":43018034,"break":"none","ruby":[[4,1,"こた"],[17,1,"い"],[22,2,"じぶん"],[25,1,"かんが"],[38,2,"ひとびと"],[55,1,"い"]],"text":"イエスは答えられた、「あなたがそう言うのは、自分の考えからか。それともほかの人々が、わたしのことをあなたにそう言ったのか」。"},{"ref":"John.18.35","start":43018035,"end":43018035,"break":"none","ruby":[[4,1,"こた"],[16,1,"じん"],[25,2,"どうぞく"],[28,3,"さいしちょう"],[43,1,"ひ"],[45,1,"わた"],[61,1,"なに"]],"text":"ピラトは答えた、「わたしはユダヤ人なのか。あなたの同族や祭司長たちが、あなたをわたしに引き渡したのだ。あなたは、いったい、何をしたのか」。"},{"ref":"John.18.36","start":43018036,"end":43018036,"break":"none","ruby":[[4,1,"こた"],[15,1,"くに"],[19,1,"よ"],[34,1,"くに"],[38,1,"よ"],[51,1,"したが"],[56,1,"もの"],[68,1,"じん"],[70,1,"わた"],[77,1,"たたか"],[88,2,"じじつ"],[95,1,"くに"],[99,1,"よ"]],"text":"イエスは答えられた、「わたしの国はこの世のものではない。もしわたしの国がこの世のものであれば、わたしに従っている者たちは、わたしをユダヤ人に渡さないように戦ったであろう。しかし事実、わたしの国はこの世のものではない」。"},{"ref":"John.18.37","start":43018037,"end":43018037,"break":"none","ruby":[[11,1,"い"],[25,1,"おう"],[36,1,"こた"],[47,1,"い"],[57,1,"おう"],[66,2,"しんり"],[81,1,"うま"],[94,1,"よ"],[107,2,"しんり"],[112,1,"もの"],[119,1,"こえ"],[121,1,"みみ"],[123,1,"かたむ"]],"text":"そこでピラトはイエスに言った、「それでは、あなたは王なのだな」。イエスは答えられた、「あなたの言うとおり、わたしは王である。わたしは真理についてあかしをするために生れ、また、そのためにこの世にきたのである。だれでも真理につく者は、わたしの声に耳を傾ける」。"},{"ref":"John.18.38","start":43018038,"end":43018038,"break":"none","ruby":[[8,1,"い"],[13,2,"しんり"],[17,1,"なに"],[23,1,"い"],[27,1,"かれ"],[34,1,"じん"],[36,1,"ところ"],[38,1,"で"],[40,1,"い"],[43,1,"かれ"],[46,1,"い"],[59,1,"ひと"],[64,1,"つみ"],[66,1,"み"]],"text":"ピラトはイエスに言った、「真理とは何か」。こう言って、彼はまたユダヤ人の所に出て行き、彼らに言った、「わたしには、この人になんの罪も見いだせない。"},{"ref":"John.18.39","start":43018039,"end":43018039,"break":"none","ruby":[[0,2,"すぎこし"],[3,1,"とき"],[25,1,"ひと"],[27,1,"ゆる"],[69,1,"じん"],[71,1,"おう"],[73,1,"ゆる"]],"text":"過越の時には、わたしがあなたがたのために、ひとりの人を許してやるのが、あなたがたのしきたりになっている。ついては、あなたがたは、このユダヤ人の王を許してもらいたいのか」。"},{"ref":"John.18.40","start":43018040,"end":43018040,"break":"none","ruby":[[3,1,"かれ"],[9,1,"さけ"],[15,1,"ひと"],[27,1,"い"],[37,2,"ごうとう"]],"text":"すると彼らは、また叫んで「その人ではなく、バラバを」と言った。このバラバは強盗であった。"}]