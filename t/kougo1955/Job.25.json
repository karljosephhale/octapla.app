[{"ref":"Job.25.1","start":18025001,"end":18025001,"break":"paragraph","ruby":[[13,1,"こた"],[16,1,"い"]],"text":"そこでシュヒびとビルダデは答えて言った、"},{"ref":"Job.25.2","start":18025002,"end":18025002,"break":"stanza","breaks":[[15,"line"]],"ruby":[[1,2,"たいけん"],[4,1,"おそ"],[8,1,"かみ"],[10,1,"とも"],[15,1,"かれ"],[17,1,"たか"],[19,1,"ところ"],[21,2,"へいわ"],[24,1,"ほどこ"]],"text":"「大権と恐れとは神と共にある。彼は高き所で平和を施される。"},{"ref":"Job.25.3","start":18025003,"end":18025003,"break":"line","breaks":[[16,"line"]],"ruby":[[2,2,"ぐんぜい"],[5,1,"かぞ"],[16,1,"なに"],[17,1,"もの"],[21,1,"ひかり"],[23,1,"よく"]],"text":"その軍勢は数えることができるか。何物かその光に浴さないものがあるか。"},{"ref":"Job.25.4","start":18025004,"end":18025004,"break":"line","breaks":[[23,"line"]],"ruby":[[3,1,"ひと"],[9,1,"かみ"],[11,1,"まえ"],[13,1,"ただ"],[23,1,"おんな"],[26,1,"うま"],[29,1,"もの"],[35,1,"きよ"]],"text":"それで人はどうして神の前に正しくありえようか。女から生れた者がどうして清くありえようか。"},{"ref":"Job.25.5","start":18025005,"end":18025005,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"み"],[3,1,"つき"],[7,1,"かがや"],[11,1,"ほし"],[13,1,"かれ"],[15,1,"め"],[18,1,"きよ"]],"text":"見よ、月さえも輝かず、星も彼の目には清くない。"},{"ref":"Job.25.6","start":18025006,"end":18025006,"break":"line","breaks":[[8,"line"]],"ruby":[[6,1,"ひと"],[8,1,"むし"],[13,1,"ひと"],[15,1,"こ"]],"text":"うじのような人、虫のような人の子はなおさらである」。"}]