[{"ref":"Mark.8.1","start":41008001,"end":41008001,"break":"paragraph","ruby":[[7,1,"おお"],[11,2,"ぐんしゅう"],[14,1,"あつ"],[22,1,"なに"],[24,1,"た"],[41,2,"でし"],[46,1,"よ"],[48,1,"よ"],[51,1,"い"]],"text":"そのころ、また大ぜいの群衆が集まっていたが、何も食べるものがなかったので、イエスは弟子たちを呼び寄せて言われた、"},{"ref":"Mark.8.2","start":41008002,"end":41008002,"break":"none","ruby":[[3,2,"ぐんしゅう"],[18,2,"かかん"],[25,2,"いっしょ"],[33,1,"なに"],[35,1,"た"]],"text":"「この群衆がかわいそうである。もう三日間もわたしと一緒にいるのに、何も食べるものがない。"},{"ref":"Mark.8.3","start":41008003,"end":41008003,"break":"none","ruby":[[3,1,"かれ"],[6,2,"くうふく"],[11,1,"いえ"],[13,1,"かえ"],[20,2,"とちゅう"],[23,1,"よわ"],[25,1,"き"],[44,1,"とお"],[52,1,"もの"]],"text":"もし、彼らを空腹のまま家に帰らせるなら、途中で弱り切ってしまうであろう。それに、なかには遠くからきている者もある」。"},{"ref":"Mark.8.4","start":41008004,"end":41008004,"break":"none","ruby":[[0,2,"でし"],[5,1,"こた"],[13,2,"あらの"],[24,1,"て"],[26,1,"い"],[34,2,"ひとびと"],[42,1,"た"]],"text":"弟子たちは答えた、「こんな荒野で、どこからパンを手に入れて、これらの人々にじゅうぶん食べさせることができましょうか」。"},{"ref":"Mark.8.5","start":41008005,"end":41008005,"break":"none","ruby":[[4,2,"でし"],[22,1,"たず"],[38,1,"こた"]],"text":"イエスが弟子たちに、「パンはいくつあるか」と尋ねられると、「七つあります」と答えた。"},{"ref":"Mark.8.6","start":41008006,"end":41008006,"break":"none","ruby":[[7,2,"ぐんしゅう"],[10,1,"ち"],[18,1,"めい"],[33,1,"と"],[36,2,"かんしゃ"],[46,2,"ひとびと"],[49,1,"くば"],[54,2,"でし"],[59,1,"わた"],[65,2,"でし"],[73,2,"ぐんしゅう"],[76,1,"くば"]],"text":"そこでイエスは群衆に地にすわるように命じられた。そして七つのパンを取り、感謝してこれをさき、人々に配るように弟子たちに渡されると、弟子たちはそれを群衆に配った。"},{"ref":"Mark.8.7","start":41008007,"end":41008007,"break":"none","ruby":[[2,1,"ちい"],[5,1,"うお"],[7,1,"すこ"],[18,2,"しゅくふく"],[27,2,"ひとびと"],[30,1,"くば"],[36,1,"い"]],"text":"また小さい魚が少しばかりあったので、祝福して、それをも人々に配るようにと言われた。"},{"ref":"Mark.8.8","start":41008008,"end":41008008,"break":"none","ruby":[[0,1,"かれ"],[3,1,"た"],[6,2,"まんぷく"],[14,1,"のこ"],[22,1,"あつ"]],"text":"彼らは食べて満腹した。そして残ったパンくずを集めると、七かごになった。"},{"ref":"Mark.8.9","start":41008009,"end":41008009,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"かず"],[10,1,"にん"],[24,1,"かれ"],[27,2,"かいさん"]],"text":"人々の数はおよそ四千人であった。それからイエスは彼らを解散させ、"},{"ref":"Mark.8.10","start":41008010,"end":41008010,"break":"none","ruby":[[2,2,"でし"],[7,1,"とも"],[9,1,"ふね"],[11,1,"の"],[21,2,"ちほう"],[24,1,"い"]],"text":"すぐ弟子たちと共に舟に乗って、ダルマヌタの地方へ行かれた。"},{"ref":"Mark.8.11","start":41008011,"end":41008011,"break":"paragraph","ruby":[[4,1,"びと"],[8,1,"で"],[17,1,"こころ"],[24,2,"ぎろん"],[31,1,"てん"],[39,1,"もと"]],"text":"パリサイ人たちが出てきて、イエスを試みようとして議論をしかけ、天からのしるしを求めた。"},{"ref":"Mark.8.12","start":41008012,"end":41008012,"break":"none","ruby":[[5,1,"こころ"],[7,1,"なか"],[9,1,"ふか"],[11,2,"たんそく"],[15,1,"い"],[24,1,"いま"],[26,2,"じだい"],[33,1,"もと"],[43,1,"い"],[45,1,"き"],[57,1,"いま"],[59,2,"じだい"],[63,1,"けっ"],[66,1,"あた"]],"text":"イエスは、心の中で深く嘆息して言われた、「なぜ、今の時代はしるしを求めるのだろう。よく言い聞かせておくが、しるしは今の時代には決して与えられない」。"},{"ref":"Mark.8.13","start":41008013,"end":41008013,"break":"none","ruby":[[8,1,"かれ"],[14,1,"のこ"],[19,1,"ふね"],[21,1,"の"],[24,1,"む"],[27,1,"ぎし"],[29,1,"い"]],"text":"そして、イエスは彼らをあとに残し、また舟に乗って向こう岸へ行かれた。"},{"ref":"Mark.8.14","start":41008014,"end":41008014,"break":"paragraph","ruby":[[0,2,"でし"],[8,1,"も"],[11,1,"く"],[15,1,"わす"],[23,1,"ふね"],[25,1,"なか"],[34,1,"も"],[36,1,"あ"]],"text":"弟子たちはパンを持って来るのを忘れていたので、舟の中にはパン一つしか持ち合わせがなかった。"},{"ref":"Mark.8.15","start":41008015,"end":41008015,"break":"none","ruby":[[9,1,"かれ"],[12,1,"いまし"],[21,1,"びと"],[25,1,"だね"],[33,1,"だね"],[41,2,"けいかい"],[47,1,"い"]],"text":"そのとき、イエスは彼らを戒めて、「パリサイ人のパン種とヘロデのパン種とを、よくよく警戒せよ」と言われた。"},{"ref":"Mark.8.16","start":41008016,"end":41008016,"break":"none","ruby":[[0,2,"でし"],[9,2,"じぶん"],[17,1,"も"],[31,1,"たがい"],[33,1,"ろん"],[35,1,"あ"]],"text":"弟子たちは、これは自分たちがパンを持っていないためであろうと、互に論じ合った。"},{"ref":"Mark.8.17","start":41008017,"end":41008017,"break":"none","ruby":[[7,1,"し"],[11,1,"かれ"],[14,1,"い"],[32,1,"ろん"],[34,1,"あ"],[52,1,"さと"],[65,1,"こころ"],[67,1,"にぶ"]],"text":"イエスはそれと知って、彼らに言われた、「なぜ、パンがないからだと論じ合っているのか。まだわからないのか、悟らないのか。あなたがたの心は鈍くなっているのか。"},{"ref":"Mark.8.18","start":41008018,"end":41008018,"break":"none","ruby":[[0,1,"め"],[6,1,"み"],[13,1,"みみ"],[19,1,"きこ"],[28,1,"おも"],[30,1,"だ"]],"text":"目があっても見えないのか。耳があっても聞えないのか。まだ思い出さないのか。"},{"ref":"Mark.8.19","start":41008019,"end":41008019,"break":"none","ruby":[[11,1,"にん"],[13,1,"わ"],[19,1,"ひろ"],[21,1,"あつ"],[30,1,"いく"],[42,2,"でし"],[47,1,"こた"]],"text":"五つのパンをさいて五千人に分けたとき、拾い集めたパンくずは、幾つのかごになったか」。弟子たちは答えた、「十二かごです」。"},{"ref":"Mark.8.20","start":41008020,"end":41008020,"break":"none","ruby":[[9,1,"にん"],[11,1,"わ"],[24,1,"いく"],[30,1,"ひろ"],[32,1,"あつ"],[46,1,"こた"]],"text":"「七つのパンを四千人に分けたときには、パンくずを幾つのかごに拾い集めたか」。「七かごです」と答えた。"},{"ref":"Mark.8.21","start":41008021,"end":41008021,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[18,1,"さと"]],"text":"そこでイエスは彼らに言われた、「まだ悟らないのか」。"},{"ref":"Mark.8.22","start":41008022,"end":41008022,"break":"paragraph","ruby":[[6,1,"かれ"],[15,1,"つ"],[22,2,"ひとびと"],[30,2,"もうじん"],[33,1,"つ"],[54,1,"ねが"]],"text":"そのうちに、彼らはベツサイダに着いた。すると人々が、ひとりの盲人を連れてきて、さわってやっていただきたいとお願いした。"},{"ref":"Mark.8.23","start":41008023,"end":41008023,"break":"none","ruby":[[6,2,"もうじん"],[9,1,"て"],[15,1,"むら"],[17,1,"そと"],[19,1,"つ"],[21,1,"だ"],[26,2,"りょうほう"],[29,1,"め"],[38,2,"りょうて"],[41,1,"かれ"],[43,1,"あ"],[48,1,"なに"],[50,1,"み"],[56,1,"たず"]],"text":"イエスはこの盲人の手をとって、村の外に連れ出し、その両方の目につばきをつけ、両手を彼に当てて、「何か見えるか」と尋ねられた。"},{"ref":"Mark.8.24","start":41008024,"end":41008024,"break":"none","ruby":[[3,1,"かれ"],[5,1,"かお"],[7,1,"あ"],[10,1,"い"],[15,1,"ひと"],[17,1,"み"],[22,1,"き"],[27,1,"み"],[32,1,"ある"]],"text":"すると彼は顔を上げて言った、「人が見えます。木のように見えます。歩いているようです」。"},{"ref":"Mark.8.25","start":41008025,"end":41008025,"break":"none","ruby":[[9,1,"ふたた"],[11,1,"め"],[13,1,"うえ"],[15,2,"りょうて"],[18,1,"あ"],[25,2,"もうじん"],[28,1,"み"],[57,1,"み"]],"text":"それから、イエスが再び目の上に両手を当てられると、盲人は見つめているうちに、なおってきて、すべてのものがはっきりと見えだした。"},{"ref":"Mark.8.26","start":41008026,"end":41008026,"break":"none","ruby":[[9,1,"むら"],[22,1,"い"],[26,1,"かれ"],[28,1,"いえ"],[30,1,"かえ"]],"text":"そこでイエスは、「村にはいってはいけない」と言って、彼を家に帰された。"},{"ref":"Mark.8.27","start":41008027,"end":41008027,"break":"paragraph","ruby":[[7,2,"でし"],[22,2,"むらむら"],[25,1,"で"],[35,2,"とちゅう"],[39,2,"でし"],[44,1,"たず"],[47,1,"い"],[53,2,"ひとびと"],[64,1,"い"]],"text":"さて、イエスは弟子たちとピリポ・カイザリヤの村々へ出かけられたが、その途中で、弟子たちに尋ねて言われた、「人々は、わたしをだれと言っているか」。"},{"ref":"Mark.8.28","start":41008028,"end":41008028,"break":"none","ruby":[[0,1,"かれ"],[3,1,"こた"],[6,1,"い"],[23,1,"い"],[38,1,"い"],[44,3,"よげんしゃ"],[53,1,"い"],[58,1,"もの"]],"text":"彼らは答えて言った、「バプテスマのヨハネだと、言っています。また、エリヤだと言い、また、預言者のひとりだと言っている者もあります」。"},{"ref":"Mark.8.29","start":41008029,"end":41008029,"break":"none","ruby":[[7,1,"かれ"],[10,1,"たず"],[35,1,"い"],[44,1,"こた"],[47,1,"い"]],"text":"そこでイエスは彼らに尋ねられた、「それでは、あなたがたはわたしをだれと言うか」。ペテロが答えて言った、「あなたこそキリストです」。"},{"ref":"Mark.8.30","start":41008030,"end":41008030,"break":"none","ruby":[[8,2,"じぶん"],[18,1,"い"],[28,1,"かれ"],[31,1,"いまし"]],"text":"するとイエスは、自分のことをだれにも言ってはいけないと、彼らを戒められた。"},{"ref":"Mark.8.31","start":41008031,"end":41008031,"break":"paragraph","ruby":[[5,1,"ひと"],[7,1,"こ"],[9,1,"かなら"],[11,1,"おお"],[14,1,"くる"],[18,1,"う"],[21,2,"ちょうろう"],[24,3,"さいしちょう"],[28,2,"りっぽう"],[30,2,"がくしゃ"],[35,1,"す"],[42,1,"ころ"],[50,1,"か"],[52,1,"のち"],[65,1,"かれ"],[68,1,"おし"]],"text":"それから、人の子は必ず多くの苦しみを受け、長老、祭司長、律法学者たちに捨てられ、また殺され、そして三日の後によみがえるべきことを、彼らに教えはじめ、"},{"ref":"Mark.8.32","start":41008032,"end":41008032,"break":"none","ruby":[[12,1,"こと"],[14,1,"はな"],[34,1,"ひ"],[36,1,"よ"]],"text":"しかもあからさまに、この事を話された。すると、ペテロはイエスをわきへ引き寄せて、いさめはじめたので、"},{"ref":"Mark.8.33","start":41008033,"end":41008033,"break":"none","ruby":[[4,1,"ふ"],[6,1,"かえ"],[10,2,"でし"],[15,1,"み"],[28,1,"い"],[39,1,"ひ"],[49,1,"かみ"],[54,1,"おも"],[60,1,"ひと"],[65,1,"おも"]],"text":"イエスは振り返って、弟子たちを見ながら、ペテロをしかって言われた、「サタンよ、引きさがれ。あなたは神のことを思わないで、人のことを思っている」。"},{"ref":"Mark.8.34","start":41008034,"end":41008034,"break":"paragraph","ruby":[[4,2,"ぐんしゅう"],[7,2,"でし"],[12,2,"いっしょ"],[15,1,"よ"],[17,1,"よ"],[21,1,"かれ"],[24,1,"い"],[45,1,"おも"],[50,2,"じぶん"],[53,1,"す"],[56,2,"じぶん"],[59,3,"じゅうじか"],[63,1,"お"],[71,1,"したが"]],"text":"それから群衆を弟子たちと一緒に呼び寄せて、彼らに言われた、「だれでもわたしについてきたいと思うなら、自分を捨て、自分の十字架を負うて、わたしに従ってきなさい。"},{"ref":"Mark.8.35","start":41008035,"end":41008035,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"いのち"],[5,1,"すく"],[9,1,"おも"],[11,1,"もの"],[16,1,"うしな"],[28,2,"ふくいん"],[35,2,"じぶん"],[38,1,"いのち"],[40,1,"うしな"],[42,1,"もの"],[48,1,"すく"]],"text":"自分の命を救おうと思う者はそれを失い、わたしのため、また福音のために、自分の命を失う者は、それを救うであろう。"},{"ref":"Mark.8.36","start":41008036,"end":41008036,"break":"none","ruby":[[0,1,"ひと"],[2,1,"ぜん"],[3,2,"せかい"],[12,2,"じぶん"],[15,1,"いのち"],[17,1,"そん"],[25,1,"え"]],"text":"人が全世界をもうけても、自分の命を損したら、なんの得になろうか。"},{"ref":"Mark.8.37","start":41008037,"end":41008037,"break":"none","ruby":[[3,1,"ひと"],[8,2,"だいか"],[11,1,"はら"],[17,1,"いのち"],[19,1,"か"]],"text":"また、人はどんな代価を払って、その命を買いもどすことができようか。"},{"ref":"Mark.8.38","start":41008038,"end":41008038,"break":"none","ruby":[[0,2,"じゃあく"],[3,2,"つみぶか"],[8,2,"じだい"],[23,2,"ことば"],[27,1,"は"],[30,1,"もの"],[32,1,"たい"],[37,1,"ひと"],[39,1,"こ"],[44,1,"ちち"],[46,2,"えいこう"],[52,1,"せい"],[55,2,"みつかい"],[60,1,"とも"],[62,1,"く"],[70,1,"もの"],[72,1,"は"]],"text":"邪悪で罪深いこの時代にあって、わたしとわたしの言葉とを恥じる者に対しては、人の子もまた、父の栄光のうちに聖なる御使たちと共に来るときに、その者を恥じるであろう」。"}]