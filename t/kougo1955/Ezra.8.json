[{"ref":"Ezra.8.1","start":15008001,"end":15008001,"break":"paragraph","ruby":[[7,1,"おう"],[9,2,"ちせい"],[23,2,"いっしょ"],[26,1,"のぼ"],[29,1,"き"],[31,1,"もの"],[33,2,"しぞく"],[36,1,"ちょう"],[43,2,"けいふ"],[46,1,"つぎ"]],"text":"アルタシャスタ王の治世に、バビロンからわたしと一緒に上って来た者の氏族の長、およびその系譜は次のとおりである。"},{"ref":"Ezra.8.2","start":15008002,"end":15008002,"break":"none","ruby":[[5,2,"しそん"],[23,2,"しそん"],[39,2,"しそん"],[51,1,"こ"]],"text":"ピネハスの子孫のうちではゲルショム。イタマルの子孫のうちではダニエル。ダビデの子孫のうちではシカニヤの子ハットシ。"},{"ref":"Ezra.8.3","start":15008003,"end":15008003,"break":"none","ruby":[[4,2,"しそん"],[18,1,"かれ"],[20,1,"とも"],[22,2,"けいふ"],[25,1,"の"],[30,1,"おとこ"],[34,1,"にん"]],"text":"パロシの子孫のうちではゼカリヤおよび彼と共に系譜に載せられた男百五十人。"},{"ref":"Ezra.8.4","start":15008004,"end":15008004,"break":"none","ruby":[[8,2,"しそん"],[20,1,"こ"],[30,1,"かれ"],[32,1,"とも"],[36,1,"おとこ"],[39,1,"にん"]],"text":"パハテ・モアブの子孫のうちではゼラヒヤの子エリヨエナイおよび彼と共にある男二百人。"},{"ref":"Ezra.8.5","start":15008005,"end":15008005,"break":"none","ruby":[[4,2,"しそん"],[17,1,"こ"],[25,1,"かれ"],[27,1,"とも"],[31,1,"おとこ"],[34,1,"にん"]],"text":"ザッツの子孫のうちではヤハジエルの子シカニヤおよび彼と共にある男三百人。"},{"ref":"Ezra.8.6","start":15008006,"end":15008006,"break":"none","ruby":[[4,2,"しそん"],[16,1,"こ"],[23,1,"かれ"],[25,1,"とも"],[29,1,"おとこ"],[32,1,"にん"]],"text":"アデンの子孫のうちではヨナタンの子エベデおよび彼と共にある男五十人。"},{"ref":"Ezra.8.7","start":15008007,"end":15008007,"break":"none","ruby":[[4,2,"しそん"],[16,1,"こ"],[23,1,"かれ"],[25,1,"とも"],[29,1,"おとこ"],[32,1,"にん"]],"text":"エラムの子孫のうちではアタリヤの子エサヤおよび彼と共にある男七十人。"},{"ref":"Ezra.8.8","start":15008008,"end":15008008,"break":"none","ruby":[[5,2,"しそん"],[17,1,"こ"],[25,1,"かれ"],[27,1,"とも"],[31,1,"おとこ"],[34,1,"にん"]],"text":"シパテヤの子孫のうちではミカエルの子ゼバデヤおよび彼と共にある男八十人。"},{"ref":"Ezra.8.9","start":15008009,"end":15008009,"break":"none","ruby":[[4,2,"しそん"],[16,1,"こ"],[24,1,"かれ"],[26,1,"とも"],[30,1,"おとこ"],[35,1,"にん"]],"text":"ヨアブの子孫のうちではエヒエルの子オバデヤおよび彼と共にある男二百十八人。"},{"ref":"Ezra.8.10","start":15008010,"end":15008010,"break":"none","ruby":[[3,2,"しそん"],[15,1,"こ"],[23,1,"かれ"],[25,1,"とも"],[29,1,"おとこ"],[33,1,"にん"]],"text":"バニの子孫のうちではヨシピアの子シロミテおよび彼と共にある男百六十人。"},{"ref":"Ezra.8.11","start":15008011,"end":15008011,"break":"none","ruby":[[4,2,"しそん"],[15,1,"こ"],[23,1,"かれ"],[25,1,"とも"],[29,1,"おとこ"],[33,1,"にん"]],"text":"ベバイの子孫のうちではベバイの子ゼカリヤおよび彼と共にある男二十八人。"},{"ref":"Ezra.8.12","start":15008012,"end":15008012,"break":"none","ruby":[[5,2,"しそん"],[18,1,"こ"],[26,1,"かれ"],[28,1,"とも"],[32,1,"おとこ"],[35,1,"にん"]],"text":"アズガデの子孫のうちではハッカタンの子ヨハナンおよび彼と共にある男百十人。"},{"ref":"Ezra.8.13","start":15008013,"end":15008013,"break":"none","ruby":[[6,2,"しそん"],[13,1,"のち"],[15,1,"き"],[17,1,"もの"],[24,1,"な"],[42,1,"かれ"],[45,1,"とも"],[49,1,"おとこ"],[52,1,"にん"]],"text":"アドニカムの子孫のうちでは後に来た者どもで、その名はエリペレテ、ユエル、シマヤおよび彼らと共にある男六十人。"},{"ref":"Ezra.8.14","start":15008014,"end":15008014,"break":"none","ruby":[[5,2,"しそん"],[23,1,"かれ"],[26,1,"とも"],[30,1,"おとこ"],[33,1,"にん"]],"text":"ビグワイの子孫のうちではウタイとザックルおよび彼らと共にある男七十人である。"},{"ref":"Ezra.8.15","start":15008015,"end":15008015,"break":"paragraph","ruby":[[4,1,"かれ"],[11,1,"なが"],[14,1,"かわ"],[20,1,"あつ"],[27,2,"みっか"],[33,2,"ろえい"],[42,1,"たみ"],[44,2,"さいし"],[48,1,"しら"],[60,2,"しそん"]],"text":"わたしは彼らをアハワに流れる川のほとりに集めて、そこに三日のあいだ露営した。わたしは民と祭司とを調べたが、そこにはレビの子孫はひとりもいなかったので、"},{"ref":"Ezra.8.16","start":15008016,"end":15008016,"break":"none","ruby":[[0,1,"ひと"],[55,1,"くび"],[56,1,"ちょう"],[59,2,"ひとびと"],[62,1,"まね"],[84,2,"けんしき"],[89,2,"ひとびと"],[92,1,"まね"]],"text":"人をつかわしてエリエゼル、アリエル、シマヤ、エルナタン、ヤリブ、エルナタン、ナタン、ゼカリヤ、メシュラムという首長たる人々を招き、またヨヤリブ、およびエルナタンのような見識のある人々を招いた。"},{"ref":"Ezra.8.17","start":15008017,"end":15008017,"break":"none","ruby":[[14,1,"ところ"],[16,2,"しゅちょう"],[24,1,"かれ"],[39,1,"ところ"],[49,2,"きょうだい"],[54,1,"みや"],[56,1,"つか"],[65,1,"つ"],[69,2,"ことば"],[73,1,"かれ"],[76,1,"さづ"],[84,1,"かみ"],[86,1,"みや"],[92,1,"つか"],[94,1,"ひと"],[101,1,"つ"],[104,1,"こ"],[107,1,"い"]],"text":"そしてわたしはカシピアという所の首長イドのもとに彼らをつかわし、カシピアという所にいるイドと、その兄弟である宮に仕えるしもべたちに告ぐべき言葉を、彼らに授け、われわれの神の宮のために、仕え人をわれわれに連れて来いと言った。"},{"ref":"Ezra.8.18","start":15008018,"end":15008018,"break":"none","ruby":[[5,1,"かみ"],[14,1,"たす"],[22,1,"かれ"],[31,1,"こ"],[36,1,"こ"],[42,2,"しそん"],[48,2,"しりょ"],[50,1,"ふか"],[52,1,"ひと"],[67,1,"こ"],[72,2,"きょうだい"],[78,1,"にん"],[86,1,"つ"],[89,1,"き"]],"text":"われわれの神がよくわれわれを助けられたので、彼らはイスラエルの子、レビの子、マヘリの子孫のうちの思慮深い人、すなわちセレビヤおよびその子らとその兄弟たち十八人を、われわれに連れて来、"},{"ref":"Ezra.8.19","start":15008019,"end":15008019,"break":"none","ruby":[[10,1,"かれ"],[12,1,"とも"],[19,2,"しそん"],[28,2,"きょうだい"],[35,1,"こ"],[39,1,"にん"]],"text":"またハシャビヤおよび彼と共に、メラリの子孫のエサヤとその兄弟およびその子ら二十人、"},{"ref":"Ezra.8.20","start":15008020,"end":15008020,"break":"none","ruby":[[3,1,"みや"],[5,1,"つか"],[34,1,"つか"],[42,1,"えら"],[45,1,"みや"],[47,1,"つか"],[57,1,"にん"],[59,1,"つ"],[69,1,"もの"],[71,1,"みな"],[74,1,"な"],[76,1,"い"],[79,2,"きろく"]],"text":"および宮に仕えるしもべ、すなわちダビデとそのつかさたちが、レビびとに仕えさせるために選んだ宮に仕えるしもべ二百二十人を連れてきた。これらの者は皆その名を言って記録された。"},{"ref":"Ezra.8.21","start":15008021,"end":15008021,"break":"paragraph","ruby":[[15,1,"かわ"],[21,2,"だんじき"],[24,2,"ふこく"],[33,1,"かみ"],[35,1,"まえ"],[37,1,"み"],[55,1,"おさな"],[57,1,"もの"],[69,1,"か"],[70,1,"ざい"],[76,1,"ただ"],[79,1,"みち"],[81,1,"しめ"],[88,1,"かみ"],[90,1,"もと"]],"text":"そこでわたしは、かしこのアハワ川のほとりで断食を布告し、われわれの神の前で身をひくくし、われわれと、われわれの幼き者と、われわれのすべての貨財のために、正しい道を示されるように神に求めた。"},{"ref":"Ezra.8.22","start":15008022,"end":15008022,"break":"none","ruby":[[12,1,"おう"],[14,1,"つ"],[24,1,"かみ"],[26,1,"て"],[29,1,"かみ"],[31,1,"もと"],[38,1,"もの"],[40,1,"うえ"],[46,1,"くだ"],[51,2,"いりょく"],[54,1,"いか"],[61,1,"かみ"],[63,1,"す"],[66,1,"もの"],[68,1,"うえ"],[70,1,"くだ"],[74,1,"い"],[84,2,"どうちゅう"],[87,1,"てき"],[89,1,"たい"],[98,1,"まも"],[102,2,"ほへい"],[105,2,"きへい"],[110,1,"おう"],[112,1,"たの"],[117,1,"は"]],"text":"これは、われわれがさきに王に告げて、「われわれの神の手は、神を求めるすべての者の上にやさしく下り、その威力と怒りとはすべて神を捨てる者の上に下る」と言ったので、わたしは道中の敵に対して、われわれを守るべき歩兵と騎兵とを、王に頼むことを恥じたからである。"},{"ref":"Ezra.8.23","start":15008023,"end":15008023,"break":"none","ruby":[[8,2,"だんじき"],[23,1,"かみ"],[25,1,"もと"],[32,1,"かみ"],[36,1,"ねが"],[39,1,"き"]],"text":"そこでわれわれは断食して、このことをわれわれの神に求めたところ、神はその願いを聞きいれられた。"},{"ref":"Ezra.8.24","start":15008024,"end":15008024,"break":"paragraph","ruby":[[9,2,"さいし"],[13,1,"にん"],[33,2,"きょうだい"],[36,1,"にん"],[38,1,"えら"]],"text":"わたしはおもだった祭司十二人すなわちセレビヤ、ハシャビヤおよびその兄弟十人を選び、"},{"ref":"Ezra.8.25","start":15008025,"end":15008025,"break":"none","ruby":[[0,2,"きんぎん"],[5,2,"うつわもの"],[12,1,"おう"],[17,1,"ぎ"],[18,1,"かん"],[23,2,"しょこう"],[31,2,"ざいりゅう"],[48,1,"かみ"],[50,1,"みや"],[59,3,"ほうのうぶつ"],[63,1,"はか"],[66,1,"かれ"],[69,1,"わた"]],"text":"金銀および器物、すなわち王と、その議官と、その諸侯およびすべて在留のイスラエルびとが、われわれの神の宮のためにささげた奉納物を量って彼らに渡した。"},{"ref":"Ezra.8.26","start":15008026,"end":15008026,"break":"none","ruby":[[4,1,"はか"],[7,1,"かれ"],[10,1,"て"],[12,1,"わた"],[19,1,"ぎん"],[29,1,"ぎん"],[31,1,"うつわ"],[38,1,"きん"]],"text":"わたしが量って彼らの手に渡したものは、銀六百五十タラント、銀の器百タラント、金百タラントであった。"},{"ref":"Ezra.8.27","start":15008027,"end":15008027,"break":"none","ruby":[[2,1,"きん"],[4,2,"おおさかずき"],[19,1,"あた"],[24,1,"ひか"],[26,1,"かがや"],[28,2,"せいどう"],[31,1,"うつわ"],[33,1,"こ"],[40,1,"たっと"],[44,1,"きん"]],"text":"また金の大杯が二十あって、一千ダリクに当る。また光り輝く青銅の器二個あって、その尊いこと金のようである。"},{"ref":"Ezra.8.28","start":15008028,"end":15008028,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[21,1,"しゅ"],[23,2,"せいべつ"],[28,1,"もの"],[35,2,"うつわもの"],[38,1,"せい"],[47,2,"きんぎん"],[57,2,"せんぞ"],[60,1,"かみ"],[62,1,"しゅ"],[68,2,"まごころ"],[73,1,"そな"],[75,1,"もの"]],"text":"そしてわたしは彼らに言った、「あなたがたは主に聖別された者である。この器物も聖である。またこの金銀は、あなたがたの先祖の神、主にささげた真心よりの供え物である。"},{"ref":"Ezra.8.29","start":15008029,"end":15008029,"break":"none","ruby":[[13,1,"しゅ"],[15,1,"みや"],[20,1,"なか"],[23,2,"さいし"],[25,1,"ちょう"],[40,2,"しぞく"],[49,1,"まえ"],[55,1,"はか"],[60,2,"みは"],[66,1,"まも"]],"text":"あなたがたはエルサレムで、主の宮のへやの中で、祭司長、レビびとおよびイスラエルの氏族のかしらたちの前で、これを量るまで、見張り、かつ守りなさい」。"},{"ref":"Ezra.8.30","start":15008030,"end":15008030,"break":"none","ruby":[[3,2,"さいし"],[18,2,"きんぎん"],[23,2,"うつわもの"],[40,1,"かみ"],[42,1,"みや"],[44,1,"たずさ"],[47,1,"い"],[54,1,"おも"],[60,1,"う"],[62,1,"と"]],"text":"そこで祭司およびレビびとたちは、その金銀および器物を、エルサレムにあるわれわれの神の宮に携えて行くため、その重さのものを受け取った。"},{"ref":"Ezra.8.31","start":15008031,"end":15008031,"break":"paragraph","ruby":[[5,2,"しょうがつ"],[10,1,"にち"],[16,1,"がわ"],[18,2,"しゅったつ"],[28,1,"む"],[39,1,"かみ"],[41,1,"て"],[49,1,"うえ"],[55,1,"てき"],[57,1,"て"],[61,1,"みち"],[63,1,"ま"],[65,1,"ぶ"],[69,1,"もの"],[71,1,"て"],[80,1,"すく"]],"text":"われわれは正月の十二日に、アハワ川を出立してエルサレムに向かったが、われわれの神の手は、われわれの上にあって、敵の手および道に待ち伏せする者の手から、われわれを救われた。"},{"ref":"Ezra.8.32","start":15008032,"end":15008032,"break":"none","ruby":[[11,1,"つ"],[16,1,"か"]],"text":"われわれはエルサレムに着いて、三日そこにいたが、"},{"ref":"Ezra.8.33","start":15008033,"end":15008033,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[9,1,"かみ"],[11,1,"みや"],[13,1,"うち"],[18,2,"きんぎん"],[23,2,"うつわもの"],[31,1,"こ"],[32,2,"さいし"],[39,1,"て"],[41,1,"はか"],[44,1,"わた"],[53,1,"こ"],[60,1,"かれ"],[62,1,"とも"],[74,1,"こ"],[88,1,"こ"],[104,1,"かれ"],[107,1,"とも"]],"text":"四日目にわれわれの神の宮の内で、その金銀および器物を、ウリヤの子祭司メレモテの手に量って渡した。ピネハスの子エレアザルが彼と共にいた。またエシュアの子ヨザバデ、およびビンヌイの子ノアデヤのふたりのレビびとも、彼らと共にいた。"},{"ref":"Ezra.8.34","start":15008034,"end":15008034,"break":"none","ruby":[[10,1,"かず"],[12,1,"おも"],[16,1,"しら"],[21,1,"おも"],[24,1,"みな"],[25,1,"か"]],"text":"すなわちそのすべての数と重さとを調べ、その重さは皆書きとめられた。"},{"ref":"Ezra.8.35","start":15008035,"end":15008035,"break":"paragraph","ruby":[[4,2,"ほしゅう"],[7,2,"ひとびと"],[10,2,"ほしゅう"],[14,1,"かえ"],[17,1,"き"],[19,1,"もの"],[28,1,"かみ"],[30,2,"はんさい"],[47,2,"ぜんたい"],[53,2,"おうし"],[57,1,"とう"],[59,2,"おひつじ"],[64,1,"とう"],[66,2,"こひつじ"],[71,1,"とう"],[79,2,"ざいさい"],[84,1,"お"],[89,1,"とう"],[103,1,"しゅ"],[109,2,"はんさい"]],"text":"そのとき捕囚の人々で捕囚から帰って来た者は、イスラエルの神に燔祭をささげた。すなわちイスラエル全体のために雄牛十二頭、雄羊九十六頭、小羊七十七頭をささげ、また罪祭として雄やぎ十二頭をささげた。これらはみな、主にささげた燔祭である。"},{"ref":"Ezra.8.36","start":15008036,"end":15008036,"break":"none","ruby":[[0,1,"かれ"],[5,1,"おう"],[7,2,"めいれい"],[9,1,"しょ"],[12,1,"おう"],[14,2,"そうとく"],[22,1,"かわ"],[23,1,"む"],[27,1,"しゅう"],[29,2,"ちじ"],[34,1,"わた"],[40,1,"かれ"],[43,1,"たみ"],[45,1,"かみ"],[47,1,"みや"],[50,2,"えんじょ"]],"text":"彼らはまた王の命令書を、王の総督たち、および川向こうの州の知事たちに渡したので、彼らは民と神の宮とを援助した。"}]