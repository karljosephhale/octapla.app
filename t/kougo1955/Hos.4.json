[{"ref":"Hos.4.1","start":28004001,"end":28004001,"break":"paragraph","breaks":[[10,"line"],[18,"line"],[33,"line"],[50,"line"]],"ruby":[[6,2,"ひとびと"],[10,1,"しゅ"],[12,2,"ことば"],[15,1,"き"],[18,1,"しゅ"],[22,1,"ち"],[24,1,"す"],[26,1,"もの"],[28,1,"あらそ"],[35,1,"ち"],[38,2,"しんじつ"],[44,2,"あいじょう"],[52,1,"かみ"],[54,1,"し"]],"text":"イスラエルの人々よ、主の言葉を聞け。主はこの地に住む者と争われる。この地には真実がなく、愛情がなく、また神を知ることもないからである。"},{"ref":"Hos.4.2","start":28004002,"end":28004002,"break":"line","breaks":[[16,"line"],[30,"line"],[39,"line"]],"ruby":[[7,1,"いつわ"],[11,2,"ひとごろ"],[16,1,"ぬす"],[20,2,"かんいん"],[30,2,"ひとびと"],[33,1,"みな"],[34,1,"あ"],[36,1,"くる"],[39,2,"さつがい"],[42,2,"さつがい"],[45,1,"つづ"]],"text":"ただのろいと、偽りと、人殺しと、盗みと、姦淫することのみで、人々は皆荒れ狂い、殺害に殺害が続いている。"},{"ref":"Hos.4.3","start":28004003,"end":28004003,"break":"line","breaks":[[22,"line"],[35,"line"]],"ruby":[[7,1,"ち"],[9,1,"なげ"],[15,1,"す"],[17,1,"もの"],[22,1,"の"],[24,1,"けもの"],[26,1,"そら"],[28,1,"とり"],[30,1,"とも"],[32,1,"おとろ"],[35,1,"うみ"],[37,1,"うお"],[41,1,"た"]],"text":"それゆえ、この地は嘆き、これに住む者はみな、野の獣も空の鳥も共に衰え、海の魚さえも絶えはてる。"},{"ref":"Hos.4.4","start":28004004,"end":28004004,"break":"stanza","breaks":[[16,"line"],[25,"line"]],"ruby":[[7,1,"あらそ"],[16,1,"せ"],[25,2,"さいし"],[33,1,"あらそ"],[42,1,"あらそ"]],"text":"しかし、だれも争ってはならない、責めてはならない。祭司よ。わたしの争うのは、あなたと争うのだ。"},{"ref":"Hos.4.5","start":28004005,"end":28004005,"break":"line","breaks":[[10,"line"],[28,"line"]],"ruby":[[4,1,"ひる"],[10,3,"よげんしゃ"],[20,1,"とも"],[22,1,"よる"],[36,1,"はは"],[38,1,"ほろ"]],"text":"あなたは昼つまずき、預言者もまたあなたと共に夜つまずく。わたしはあなたの母を滅ぼす。"},{"ref":"Hos.4.6","start":28004006,"end":28004006,"break":"line","breaks":[[20,"line"],[34,"line"],[57,"line"],[77,"line"]],"ruby":[[4,1,"たみ"],[6,2,"ちしき"],[14,1,"ほろ"],[24,2,"ちしき"],[27,1,"す"],[42,1,"す"],[50,2,"さいし"],[65,1,"かみ"],[67,2,"りっぽう"],[70,1,"わす"],[87,1,"こ"],[90,1,"わす"]],"text":"わたしの民は知識がないために滅ぼされる。あなたは知識を捨てたゆえに、わたしもあなたを捨てて、わたしの祭司としない。あなたはあなたの神の律法を忘れたゆえに、わたしもまたあなたの子らを忘れる。"},{"ref":"Hos.4.7","start":28004007,"end":28004007,"break":"stanza","breaks":[[15,"line"],[31,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おお"],[23,1,"つみ"],[25,1,"おか"],[35,1,"かれ"],[38,1,"さか"],[41,1,"はじ"],[43,1,"か"]],"text":"彼らは大きくなるにしたがって、ますますわたしに罪を犯したゆえ、わたしは彼らの栄えを恥に変える。"},{"ref":"Hos.4.8","start":28004008,"end":28004008,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[5,1,"たみ"],[7,1,"つみ"],[9,1,"く"],[18,1,"つみ"],[20,1,"おか"],[28,1,"ねが"]],"text":"彼らはわが民の罪を食いものにし、その罪を犯すことをせつに願っている。"},{"ref":"Hos.4.9","start":28004009,"end":28004009,"break":"line","breaks":[[17,"line"],[35,"line"]],"ruby":[[4,2,"さいし"],[7,1,"たみ"],[9,1,"おな"],[29,1,"かれ"],[32,1,"ばっ"],[45,1,"かれ"],[48,1,"むく"]],"text":"それゆえ祭司も民と同じようになる。わたしはそのわざのために彼らを罰し、そのおこないのために彼らに報いる。"},{"ref":"Hos.4.10","start":28004010,"end":28004010,"break":"line","breaks":[[14,"line"],[33,"line"]],"ruby":[[0,1,"かれ"],[3,1,"た"],[7,1,"あ"],[14,2,"いんこう"],[23,1,"かず"],[25,1,"ま"],[33,1,"かれ"],[36,1,"しゅ"],[38,1,"す"],[42,2,"いんこう"],[45,1,"あい"]],"text":"彼らは食べても飽くことなく、淫行をなしてもその数を増すことがない。彼らは主を捨てて、淫行を愛したからである。"},{"ref":"Hos.4.11","start":28004011,"end":28004011,"break":"stanza","ruby":[[0,1,"さけ"],[2,1,"あたら"],[5,1,"さけ"],[8,2,"しりょ"],[11,1,"うば"]],"text":"酒と新しい酒とは思慮を奪う。"},{"ref":"Hos.4.12","start":28004012,"end":28004012,"break":"line","breaks":[[16,"line"],[31,"line"],[52,"line"]],"ruby":[[2,1,"たみ"],[4,1,"き"],[6,1,"む"],[10,1,"こと"],[12,1,"たず"],[23,1,"かれ"],[26,1,"こと"],[28,1,"しめ"],[34,2,"いんこう"],[37,1,"れい"],[39,1,"かれ"],[42,1,"まよ"],[52,1,"かれ"],[57,1,"かみ"],[59,1,"す"],[62,2,"いんこう"]],"text":"わが民は木に向かって事を尋ねる。またそのつえは彼らに事を示す。これは淫行の霊が彼らを迷わしたからである。彼らはその神を捨てて淫行をなした。"},{"ref":"Hos.4.13","start":28004013,"end":28004013,"break":"line","breaks":[[15,"line"],[28,"line"],[46,"line"],[65,"line"],[84,"line"]],"ruby":[[0,1,"かれ"],[3,2,"やまやま"],[6,1,"いただき"],[8,2,"ぎせい"],[15,1,"おか"],[17,1,"うえ"],[22,1,"き"],[24,1,"やなぎ"],[26,1,"き"],[33,1,"き"],[35,1,"した"],[37,1,"そな"],[39,1,"もの"],[51,2,"こかげ"],[76,1,"むすめ"],[78,2,"いんこう"],[90,1,"よめ"],[92,2,"かんいん"],[95,1,"おこな"]],"text":"彼らは山々の頂で犠牲をささげ、丘の上、かしの木、柳の木、テレビンの木の下で供え物をささげる。これはその木陰がここちよいためである。それゆえ、あなたがたの娘は淫行をなし、あなたがたの嫁は姦淫を行う。"},{"ref":"Hos.4.14","start":28004014,"end":28004014,"break":"line","breaks":[[23,"line"],[45,"line"],[62,"line"],[84,"line"]],"ruby":[[10,1,"むすめ"],[12,2,"いんこう"],[18,1,"ばっ"],[31,1,"よめ"],[33,2,"かんいん"],[36,1,"おこな"],[40,1,"ばっ"],[45,1,"おとこ"],[52,2,"ゆうじょ"],[55,1,"とも"],[57,1,"はな"],[59,1,"さ"],[62,1,"みや"],[64,2,"ゆうじょ"],[67,1,"とも"],[69,2,"ぎせい"],[84,1,"さと"],[89,1,"たみ"],[91,1,"ほろ"]],"text":"わたしはあなたがたの娘が淫行をしても罰しない。またあなたがたの嫁が姦淫を行っても罰しない。男たちみずから遊女と共に離れ去り、宮の遊女と共に犠牲をささげているからである。悟りのない民は滅びる。"},{"ref":"Hos.4.15","start":28004015,"end":28004015,"break":"stanza","breaks":[[19,"line"],[34,"line"],[48,"line"],[64,"line"],[81,"line"]],"ruby":[[11,2,"いんこう"],[22,1,"つみ"],[24,1,"おか"],[39,1,"い"],[67,1,"しゅ"],[69,1,"い"],[78,1,"い"],[81,1,"ちか"]],"text":"イスラエルよ、あなたは淫行をなしても、ユダに罪を犯させてはならない。ギルガルへ行ってはならない。ベテアベンにのぼってはならない。また「主は生きておられる」と言って誓ってはならない。"},{"ref":"Hos.4.16","start":28004016,"end":28004016,"break":"line","breaks":[[21,"line"],[40,"line"]],"ruby":[[6,2,"ごうじょう"],[9,2,"めうし"],[15,2,"ごうじょう"],[21,1,"いま"],[23,1,"しゅ"],[25,2,"こひつじ"],[28,1,"ひろ"],[30,1,"の"],[32,1,"はな"],[40,1,"かれ"],[43,1,"やしな"]],"text":"イスラエルは強情な雌牛のように強情である。今、主は小羊を広い野に放つようにして、彼らを養うことができようか。"},{"ref":"Hos.4.17","start":28004017,"end":28004017,"break":"stanza","breaks":[[17,"line"]],"ruby":[[6,2,"ぐうぞう"],[9,1,"むす"]],"text":"エフライムは偶像に結びつらなった。そのなすにまかせよ。"},{"ref":"Hos.4.18","start":28004018,"end":28004018,"break":"line","breaks":[[13,"line"],[23,"line"]],"ruby":[[0,1,"かれ"],[3,2,"しゅえん"],[13,2,"いんこう"],[23,1,"かれ"],[28,2,"こうえい"],[33,1,"はじ"],[35,1,"あい"]],"text":"彼らは酒宴のとりことなり、淫行にふけっている。彼らはその光栄よりも恥を愛する。"},{"ref":"Hos.4.19","start":28004019,"end":28004019,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かぜ"],[4,1,"つばさ"],[6,1,"かれ"],[9,1,"つつ"],[13,1,"かれ"],[18,2,"さいだん"],[24,1,"はじ"],[26,1,"う"]],"text":"風はその翼に彼らを包んだ。彼らはその祭壇のゆえに恥を受ける。"}]