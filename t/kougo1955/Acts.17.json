[{"ref":"Acts.17.1","start":44017001,"end":44017001,"break":"paragraph","ruby":[[0,2,"いっこう"],[29,1,"い"],[40,1,"じん"],[42,2,"かいどう"]],"text":"一行は、アムピポリスとアポロニヤとをとおって、テサロニケに行った。ここにはユダヤ人の会堂があった。"},{"ref":"Acts.17.2","start":44017002,"end":44017002,"break":"none","ruby":[[4,1,"れい"],[12,2,"かいどう"],[19,1,"い"],[26,3,"あんそくにち"],[34,2,"せいしょ"],[37,1,"もとづ"],[40,1,"かれ"],[43,1,"ろん"]],"text":"パウロは例によって、その会堂にはいって行って、三つの安息日にわたり、聖書に基いて彼らと論じ、"},{"ref":"Acts.17.3","start":44017003,"end":44017003,"break":"none","ruby":[[5,1,"かなら"],[7,2,"くなん"],[10,1,"う"],[16,2,"しにん"],[19,1,"なか"],[45,1,"つた"],[73,2,"せつめい"],[77,2,"ろんしょう"]],"text":"キリストは必ず苦難を受け、そして死人の中からよみがえるべきこと、また「わたしがあなたがたに伝えているこのイエスこそは、キリストである」とのことを、説明もし論証もした。"},{"ref":"Acts.17.4","start":44017004,"end":44017004,"break":"none","ruby":[[2,1,"ひと"],[6,2,"なっとく"],[29,1,"なか"],[33,2,"しんじん"],[35,1,"ぶか"],[41,1,"じん"],[43,2,"たすう"],[48,3,"きふじん"],[54,1,"すく"]],"text":"ある人たちは納得がいって、パウロとシラスにしたがった。その中には、信心深いギリシヤ人が多数あり、貴婦人たちも少なくなかった。"},{"ref":"Acts.17.5","start":44017005,"end":44017005,"break":"none","ruby":[[8,1,"じん"],[21,1,"まち"],[33,1,"もの"],[36,1,"あつ"],[39,2,"ぼうどう"],[42,1,"おこ"],[45,1,"まち"],[47,1,"さわ"],[60,1,"いえ"],[62,1,"おそ"],[69,2,"みんしゅう"],[72,1,"まえ"],[78,1,"だ"],[87,1,"さが"]],"text":"ところが、ユダヤ人たちは、それをねたんで、町をぶらついているならず者らを集めて暴動を起し、町を騒がせた。それからヤソンの家を襲い、ふたりを民衆の前にひっぱり出そうと、しきりに捜した。"},{"ref":"Acts.17.6","start":44017006,"end":44017006,"break":"none","ruby":[[8,1,"み"],[21,2,"きょうだい"],[25,2,"すうにん"],[29,1,"し"],[31,3,"とうきょくしゃ"],[39,1,"ひ"],[44,1,"い"],[47,1,"さけ"],[50,1,"い"],[55,2,"てんか"],[60,1,"まわ"],[67,1,"ひと"],[79,1,"こ"]],"text":"しかし、ふたりが見つからないので、ヤソンと兄弟たち数人を、市の当局者のところに引きずって行き、叫んで言った、「天下をかき回してきたこの人たちが、ここにもはいり込んでいます。"},{"ref":"Acts.17.7","start":44017007,"end":44017007,"break":"none","ruby":[[2,1,"ひと"],[10,2,"じぶん"],[13,1,"いえ"],[15,1,"むか"],[17,1,"い"],[25,2,"れんちゅう"],[36,2,"しょうちょく"],[43,2,"こうどう"],[53,1,"べつ"],[55,1,"おう"],[62,1,"い"]],"text":"その人たちをヤソンが自分の家に迎え入れました。この連中は、みなカイザルの詔勅にそむいて行動し、イエスという別の王がいるなどと言っています」。"},{"ref":"Acts.17.8","start":44017008,"end":44017008,"break":"none","ruby":[[3,1,"き"],[7,2,"ぐんしゅう"],[10,1,"し"],[12,3,"とうきょくしゃ"],[16,2,"ふあん"],[19,1,"かん"]],"text":"これを聞いて、群衆と市の当局者は不安に感じた。"},{"ref":"Acts.17.9","start":44017009,"end":44017009,"break":"none","ruby":[[11,1,"もの"],[17,2,"ほしょう"],[19,1,"きん"],[21,1,"と"],[24,1,"うえ"],[26,1,"かれ"],[29,2,"しゃくほう"]],"text":"そして、ヤソンやほかの者たちから、保証金を取った上、彼らを釈放した。"},{"ref":"Acts.17.10","start":44017010,"end":44017010,"break":"paragraph","ruby":[[4,2,"きょうだい"],[24,1,"よる"],[26,1,"あいだ"],[32,1,"おく"],[34,1,"だ"],[46,2,"とうちゃく"],[55,1,"じん"],[57,2,"かいどう"],[60,1,"い"]],"text":"そこで、兄弟たちはただちに、パウロとシラスとを、夜の間にベレヤへ送り出した。ふたりはベレヤに到着すると、ユダヤ人の会堂に行った。"},{"ref":"Acts.17.11","start":44017011,"end":44017011,"break":"none","ruby":[[8,1,"じん"],[16,1,"もの"],[22,2,"すなお"],[29,1,"こころ"],[32,1,"おしえ"],[34,1,"う"],[39,1,"はた"],[52,1,"し"],[59,2,"ひび"],[61,2,"せいしょ"],[64,1,"しら"]],"text":"ここにいるユダヤ人はテサロニケの者たちよりも素直であって、心から教を受けいれ、果してそのとおりかどうかを知ろうとして、日々聖書を調べていた。"},{"ref":"Acts.17.12","start":44017012,"end":44017012,"break":"none","ruby":[[8,1,"かれ"],[14,1,"おお"],[17,1,"もの"],[19,2,"しんじゃ"],[34,3,"きふじん"],[38,2,"だんし"],[41,1,"しん"],[44,1,"もの"],[47,1,"すく"]],"text":"そういうわけで、彼らのうちの多くの者が信者になった。また、ギリシヤの貴婦人や男子で信じた者も、少なくなかった。"},{"ref":"Acts.17.13","start":44017013,"end":44017013,"break":"none","ruby":[[9,1,"じん"],[23,1,"かみ"],[25,1,"ことば"],[27,1,"つた"],[35,1,"し"],[42,1,"お"],[50,2,"ぐんしゅう"],[53,2,"せんどう"],[57,1,"さわ"]],"text":"テサロニケのユダヤ人たちは、パウロがベレヤでも神の言を伝えていることを知り、そこにも押しかけてきて、群衆を煽動して騒がせた。"},{"ref":"Acts.17.14","start":44017014,"end":44017014,"break":"none","ruby":[[4,2,"きょうだい"],[18,1,"おく"],[20,1,"だ"],[24,1,"うみ"],[28,1,"い"],[45,2,"いのこ"]],"text":"そこで、兄弟たちは、ただちにパウロを送り出して、海べまで行かせ、シラスとテモテとはベレヤに居残った。"},{"ref":"Acts.17.15","start":44017015,"end":44017015,"break":"none","ruby":[[4,2,"あんない"],[8,1,"ひと"],[13,1,"かれ"],[20,1,"つ"],[23,1,"い"],[39,1,"はや"],[41,1,"く"],[52,2,"でんごん"],[55,1,"う"],[59,1,"かえ"]],"text":"パウロを案内した人たちは、彼をアテネまで連れて行き、テモテとシラスとになるべく早く来るようにとのパウロの伝言を受けて、帰った。"},{"ref":"Acts.17.16","start":44017016,"end":44017016,"break":"paragraph","ruby":[[11,1,"かれ"],[14,1,"ま"],[19,1,"あいだ"],[22,2,"しない"],[25,2,"ぐうぞう"],[38,1,"み"],[41,1,"こころ"],[43,1,"いきどお"],[46,1,"かん"]],"text":"さて、パウロはアテネで彼らを待っている間に、市内に偶像がおびただしくあるのを見て、心に憤りを感じた。"},{"ref":"Acts.17.17","start":44017017,"end":44017017,"break":"none","ruby":[[3,1,"かれ"],[6,2,"かいどう"],[13,1,"じん"],[15,2,"しんじん"],[17,1,"ぶか"],[19,1,"ひと"],[23,1,"ろん"],[26,2,"ひろば"],[30,2,"まいにち"],[35,2,"であ"],[38,2,"ひとびと"],[41,2,"あいて"],[44,1,"ろん"]],"text":"そこで彼は、会堂ではユダヤ人や信心深い人たちと論じ、広場では毎日そこで出会う人々を相手に論じた。"},{"ref":"Acts.17.18","start":44017018,"end":44017018,"break":"none","ruby":[[8,1,"は"],[13,1,"は"],[15,3,"てつがくしゃ"],[18,2,"すうにん"],[26,2,"ぎろん"],[29,1,"たたか"],[39,1,"なか"],[43,1,"もの"],[47,1,"い"],[66,1,"なに"],[68,1,"い"],[86,1,"もの"],[96,2,"いこく"],[99,2,"かみがみ"],[102,1,"つた"],[116,1,"い"],[129,2,"ふっかつ"],[134,1,"の"],[136,1,"つた"]],"text":"また、エピクロス派やストア派の哲学者数人も、パウロと議論を戦わせていたが、その中のある者たちが言った、「このおしゃべりは、いったい、何を言おうとしているのか」。また、ほかの者たちは、「あれは、異国の神々を伝えようとしているらしい」と言った。パウロが、イエスと復活とを、宣べ伝えていたからであった。"},{"ref":"Acts.17.19","start":44017019,"end":44017019,"break":"none","ruby":[[4,1,"かれ"],[18,3,"ひょうぎしょ"],[22,1,"つ"],[25,1,"い"],[30,1,"きみ"],[32,1,"かた"],[37,1,"あたら"],[40,1,"おしえ"],[49,1,"し"]],"text":"そこで、彼らはパウロをアレオパゴスの評議所に連れて行って、「君の語っている新しい教がどんなものか、知らせてもらえまいか。"},{"ref":"Acts.17.20","start":44017020,"end":44017020,"break":"none","ruby":[[0,1,"きみ"],[6,1,"めず"],[18,1,"き"],[33,1,"こと"],[37,1,"し"],[42,1,"おも"],[48,1,"い"]],"text":"君がなんだか珍らしいことをわれわれに聞かせているので、それがなんの事なのか知りたいと思うのだ」と言った。"},{"ref":"Acts.17.21","start":44017021,"end":44017021,"break":"none","ruby":[[8,1,"びと"],[13,2,"たいざい"],[19,2,"がいこく"],[21,1,"じん"],[26,1,"なに"],[28,2,"みみあたら"],[35,1,"はな"],[39,1,"き"],[51,1,"とき"],[53,1,"す"]],"text":"いったい、アテネ人もそこに滞在している外国人もみな、何か耳新しいことを話したり聞いたりすることのみに、時を過ごしていたのである。"},{"ref":"Acts.17.22","start":44017022,"end":44017022,"break":"none","breaks":[[30,"paragraph"]],"ruby":[[15,3,"ひょうぎしょ"],[21,1,"なか"],[23,1,"た"],[26,1,"い"],[35,1,"ひと"],[51,1,"てん"],[61,2,"しゅうきょう"],[63,1,"こころ"],[65,1,"と"],[78,1,"み"]],"text":"そこでパウロは、アレオパゴスの評議所のまん中に立って言った。「アテネの人たちよ、あなたがたは、あらゆる点において、すこぶる宗教心に富んでおられると、わたしは見ている。"},{"ref":"Acts.17.23","start":44017023,"end":44017023,"break":"none","ruby":[[0,1,"じつ"],[7,1,"みち"],[9,1,"とお"],[21,1,"おが"],[34,1,"み"],[43,1,"し"],[48,1,"かみ"],[52,1,"きざ"],[56,2,"さいだん"],[63,1,"き"],[79,1,"し"],[83,1,"おが"],[94,1,"し"]],"text":"実は、わたしが道を通りながら、あなたがたの拝むいろいろなものを、よく見ているうちに、『知られない神に』と刻まれた祭壇もあるのに気がついた。そこで、あなたがたが知らずに拝んでいるものを、いま知らせてあげよう。"},{"ref":"Acts.17.24","start":44017024,"end":44017024,"break":"none","ruby":[[2,2,"せかい"],[8,1,"なか"],[12,2,"ばんぶつ"],[16,1,"つく"],[19,1,"かみ"],[22,2,"てんち"],[25,1,"しゅ"],[34,1,"て"],[36,1,"つく"],[39,1,"みや"],[45,1,"す"]],"text":"この世界と、その中にある万物とを造った神は、天地の主であるのだから、手で造った宮などにはお住みにならない。"},{"ref":"Acts.17.25","start":44017025,"end":44017025,"break":"none","ruby":[[3,1,"なに"],[5,2,"ふそく"],[19,1,"ひと"],[21,1,"て"],[26,1,"つか"],[31,2,"ひつよう"],[37,1,"かみ"],[44,2,"ひとびと"],[47,1,"いのち"],[49,1,"いき"],[51,2,"ばんぶつ"],[55,1,"あた"]],"text":"また、何か不足でもしておるかのように、人の手によって仕えられる必要もない。神は、すべての人々に命と息と万物とを与え、"},{"ref":"Acts.17.26","start":44017026,"end":44017026,"break":"none","ruby":[[7,1,"ひと"],[15,2,"みんぞく"],[18,1,"つく"],[20,1,"りだ"],[24,1,"ち"],[26,2,"ぜんめん"],[29,1,"す"],[39,2,"じだい"],[42,2,"くぶん"],[46,2,"こくど"],[49,2,"きょうかい"],[52,1,"さだ"],[55,1,"くだ"]],"text":"また、ひとりの人から、あらゆる民族を造り出して、地の全面に住まわせ、それぞれに時代を区分し、国土の境界を定めて下さったのである。"},{"ref":"Acts.17.27","start":44017027,"end":44017027,"break":"none","ruby":[[5,2,"ひとびと"],[8,2,"ねっしん"],[11,1,"お"],[13,1,"もと"],[16,1,"さが"],[24,1,"かみ"],[26,1,"み"],[36,1,"くだ"],[41,2,"じじつ"],[44,1,"かみ"],[58,1,"とお"],[60,1,"はな"]],"text":"こうして、人々が熱心に追い求めて捜しさえすれば、神を見いだせるようにして下さった。事実、神はわれわれひとりびとりから遠く離れておいでになるのではない。"},{"ref":"Acts.17.28","start":44017028,"end":44017028,"break":"none","breaks":[[48,"stanza"]],"ruby":[[5,1,"かみ"],[10,1,"い"],[13,1,"うご"],[16,2,"そんざい"],[36,2,"しじん"],[41,1,"い"],[55,1,"たし"],[60,2,"しそん"]],"text":"われわれは神のうちに生き、動き、存在しているからである。あなたがたのある詩人たちも言ったように、『われわれも、確かにその子孫である』。"},{"ref":"Acts.17.29","start":44017029,"end":44017029,"break":"none","ruby":[[11,1,"かみ"],[13,2,"しそん"],[23,1,"かみ"],[26,1,"もの"],[29,2,"にんげん"],[32,2,"ぎこう"],[35,2,"くうそう"],[38,1,"きん"],[40,1,"ぎん"],[42,1,"いし"],[46,1,"ほ"],[48,1,"つ"],[54,1,"おな"],[58,1,"み"]],"text":"このように、われわれは神の子孫なのであるから、神たる者を、人間の技巧や空想で金や銀や石などに彫り付けたものと同じと、見なすべきではない。"},{"ref":"Acts.17.30","start":44017030,"end":44017030,"break":"none","ruby":[[0,1,"かみ"],[8,2,"むち"],[11,2,"じだい"],[20,2,"みす"],[32,1,"いま"],[39,1,"ひと"],[45,1,"く"],[47,1,"あらた"],[60,1,"めい"]],"text":"神は、このような無知の時代を、これまでは見過ごしにされていたが、今はどこにおる人でも、みな悔い改めなければならないことを命じておられる。"},{"ref":"Acts.17.31","start":44017031,"end":44017031,"break":"none","ruby":[[0,1,"かみ"],[3,1,"ぎ"],[10,2,"せかい"],[20,1,"ひ"],[22,1,"さだ"],[26,1,"えら"],[43,1,"と"],[64,2,"しにん"],[67,1,"なか"],[79,2,"かくしょう"],[86,1,"ひと"],[88,1,"しめ"]],"text":"神は、義をもってこの世界をさばくためその日を定め、お選びになったかたによってそれをなし遂げようとされている。すなわち、このかたを死人の中からよみがえらせ、その確証をすべての人に示されたのである」。"},{"ref":"Acts.17.32","start":44017032,"end":44017032,"break":"paragraph","ruby":[[0,2,"しにん"],[12,1,"き"],[18,1,"もの"],[24,1,"わら"],[31,1,"もの"],[39,1,"こと"],[51,1,"き"],[60,1,"い"]],"text":"死人のよみがえりのことを聞くと、ある者たちはあざ笑い、またある者たちは、「この事については、いずれまた聞くことにする」と言った。"},{"ref":"Acts.17.33","start":44017033,"end":44017033,"break":"none","ruby":[[9,1,"かれ"],[12,1,"なか"],[15,1,"で"],[17,1,"い"]],"text":"こうして、パウロは彼らの中から出て行った。"},{"ref":"Acts.17.34","start":44017034,"end":44017034,"break":"none","ruby":[[4,1,"かれ"],[11,1,"しん"],[14,1,"もの"],[17,2,"いくにん"],[26,1,"なか"],[37,3,"さいばんにん"],[53,1,"おんな"],[60,1,"た"],[62,2,"ひとびと"]],"text":"しかし、彼にしたがって信じた者も、幾人かあった。その中には、アレオパゴスの裁判人デオヌシオとダマリスという女、また、その他の人々もいた。"}]