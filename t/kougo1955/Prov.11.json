[{"ref":"Prov.11.1","start":20011001,"end":20011001,"break":"paragraph","breaks":[[13,"line"]],"ruby":[[0,1,"いつわ"],[7,1,"しゅ"],[9,1,"にく"],[13,1,"ただ"],[21,1,"かれ"],[23,1,"よろこ"]],"text":"偽りのはかりは主に憎まれ、正しいふんどうは彼に喜ばれる。"},{"ref":"Prov.11.2","start":20011002,"end":20011002,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"たか"],[4,1,"く"],[8,1,"はじ"],[12,1,"く"],[20,1,"もの"],[23,2,"ちえ"]],"text":"高ぶりが来れば、恥もまた来る、へりくだる者には知恵がある。"},{"ref":"Prov.11.3","start":20011003,"end":20011003,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,2,"せいじつ"],[10,1,"ひと"],[12,1,"みちび"],[15,3,"ふしんじつ"],[19,1,"もの"],[28,1,"ひと"],[30,1,"ほろ"]],"text":"正しい者の誠実はその人を導き、不信実な者のよこしまはその人を滅ぼす。"},{"ref":"Prov.11.4","start":20011004,"end":20011004,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"たから"],[2,1,"いか"],[5,1,"ひ"],[7,1,"えき"],[11,2,"せいぎ"],[14,1,"ひと"],[16,1,"すく"],[18,1,"だ"],[22,1,"し"],[24,1,"まぬか"]],"text":"宝は怒りの日に益なく、正義は人を救い出して、死を免れさせる。"},{"ref":"Prov.11.5","start":20011005,"end":20011005,"break":"line","breaks":[[15,"line"],[28,"line"]],"ruby":[[0,2,"せいじつ"],[3,1,"もの"],[8,2,"せいぎ"],[17,1,"みち"],[28,1,"あ"],[31,1,"もの"],[36,1,"あく"],[41,1,"たお"]],"text":"誠実な者は、その正義によって、その道をまっすぐにせられ、悪しき者は、その悪によって倒れる。"},{"ref":"Prov.11.6","start":20011006,"end":20011006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[7,2,"せいぎ"],[13,1,"すく"],[17,3,"ふしんじつ"],[21,1,"もの"],[23,2,"じぶん"],[26,1,"よく"],[31,1,"とら"]],"text":"正しい者はその正義によって救われ、不信実な者は自分の欲によって捕えられる。"},{"ref":"Prov.11.7","start":20011007,"end":20011007,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"し"],[12,1,"のぞ"],[15,1,"た"],[18,3,"ふしんじん"],[22,1,"もの"],[24,1,"のぞ"],[29,1,"た"]],"text":"悪しき者は死ぬとき、その望みは絶え、不信心な者の望みもまた絶える。"},{"ref":"Prov.11.8","start":20011008,"end":20011008,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[6,1,"なや"],[10,1,"すく"],[14,1,"あ"],[17,1,"もの"],[19,1,"かわ"],[25,1,"おちい"]],"text":"正しい者は、悩みから救われ、悪しき者は代ってそれに陥る。"},{"ref":"Prov.11.9","start":20011009,"end":20011009,"break":"line","breaks":[[21,"line"]],"ruby":[[0,3,"ふしんじん"],[4,1,"もの"],[8,1,"くち"],[13,1,"とな"],[15,1,"びと"],[17,1,"ほろ"],[21,1,"ただ"],[24,1,"もの"],[26,2,"ちしき"],[32,1,"すく"]],"text":"不信心な者はその口をもって隣り人を滅ぼす、正しい者は知識によって救われる。"},{"ref":"Prov.11.10","start":20011010,"end":20011010,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[17,1,"まち"],[19,1,"よろこ"],[22,1,"あ"],[25,1,"もの"],[27,1,"ほろ"],[32,1,"よろこ"],[35,1,"こえ"]],"text":"正しい者が、しあわせになれば、その町は喜び、悪しき者が滅びると、喜びの声がおこる。"},{"ref":"Prov.11.11","start":20011011,"end":20011011,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"まち"],[2,1,"ただ"],[5,1,"もの"],[7,2,"しゅくふく"],[14,1,"たか"],[21,1,"あ"],[24,1,"もの"],[26,1,"くち"],[32,1,"ほろ"]],"text":"町は正しい者の祝福によって、高くあげられ、悪しき者の口によって、滅ぼされる。"},{"ref":"Prov.11.12","start":20011012,"end":20011012,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"とな"],[2,1,"びと"],[4,1,"あなど"],[6,1,"もの"],[8,2,"ちえ"],[17,1,"ひと"],[19,1,"くち"]],"text":"隣り人を侮る者は知恵がない、さとき人は口をつぐむ。"},{"ref":"Prov.11.13","start":20011013,"end":20011013,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ひと"],[7,1,"い"],[12,1,"もの"],[14,2,"ひみつ"],[21,1,"こころ"],[23,2,"ちゅうしん"],[27,1,"もの"],[29,1,"こと"],[31,1,"かく"]],"text":"人のよしあしを言いあるく者は秘密をもらす、心の忠信なる者は事を隠す。"},{"ref":"Prov.11.14","start":20011014,"end":20011014,"break":"line","breaks":[[13,"line"]],"ruby":[[0,3,"しどうしゃ"],[8,1,"たみ"],[10,1,"たお"],[13,3,"じょげんしゃ"],[17,1,"おお"],[21,2,"あんぜん"]],"text":"指導者がなければ民は倒れ、助言者が多ければ安全である。"},{"ref":"Prov.11.15","start":20011015,"end":20011015,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"たにん"],[6,2,"ほしょう"],[11,1,"もの"],[13,1,"くる"],[20,2,"ほしょう"],[26,1,"もの"],[28,2,"あんぜん"]],"text":"他人のために保証をする者は苦しみをうけ、保証をきらう者は安全である。"},{"ref":"Prov.11.16","start":20011016,"end":20011016,"break":"line","breaks":[[12,"line"]],"ruby":[[5,1,"おんな"],[8,1,"ほまれ"],[10,1,"え"],[12,2,"きょうぼう"],[15,1,"おとこ"],[17,1,"とみ"],[19,1,"え"]],"text":"しとやかな女は、誉を得、強暴な男は富を得る。"},{"ref":"Prov.11.17","start":20011017,"end":20011017,"break":"line","breaks":[[19,"line"]],"ruby":[[7,1,"もの"],[12,2,"じしん"],[15,1,"えき"],[17,1,"え"],[19,2,"ざんにん"],[22,1,"もの"],[28,1,"み"]],"text":"いつくしみある者はおのれ自身に益を得、残忍な者はおのれの身をそこなう。"},{"ref":"Prov.11.18","start":20011018,"end":20011018,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"え"],[7,1,"むく"],[15,2,"せいぎ"],[18,1,"ま"],[20,1,"もの"],[22,1,"たし"],[25,1,"むく"],[28,1,"え"]],"text":"悪しき者の得る報いはむなしく、正義を播く者は確かな報いを得る。"},{"ref":"Prov.11.19","start":20011019,"end":20011019,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"せいぎ"],[3,1,"かた"],[5,1,"たも"],[7,1,"もの"],[9,1,"いのち"],[11,1,"いた"],[14,1,"あく"],[16,1,"お"],[18,1,"もと"],[21,1,"もの"],[23,1,"し"],[25,1,"まね"]],"text":"正義を堅く保つ者は命に至り、悪を追い求める者は死を招く。"},{"ref":"Prov.11.20","start":20011020,"end":20011020,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"こころ"],[6,1,"もの"],[8,1,"しゅ"],[10,1,"にく"],[19,1,"みち"],[21,1,"あゆ"],[23,1,"もの"],[25,1,"かれ"],[27,1,"よろこ"]],"text":"心のねじけた者は主に憎まれ、まっすぐに道を歩む者は彼に喜ばれる。"},{"ref":"Prov.11.21","start":20011021,"end":20011021,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"たし"],[4,2,"あくにん"],[7,1,"ばつ"],[9,1,"まぬか"],[17,1,"ただ"],[20,1,"ひと"],[22,1,"すくい"],[24,1,"え"]],"text":"確かに、悪人は罰を免れない、しかし正しい人は救を得る。"},{"ref":"Prov.11.22","start":20011022,"end":20011022,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"うつく"],[3,1,"おんな"],[5,1,"つつし"],[13,1,"きん"],[15,1,"わ"],[21,1,"はな"]],"text":"美しい女の慎みがないのは、金の輪の、ぶたの鼻にあるようだ。"},{"ref":"Prov.11.23","start":20011023,"end":20011023,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"ねが"],[12,1,"よ"],[14,2,"けっか"],[17,1,"え"],[19,1,"あ"],[22,1,"もの"],[24,1,"のぞ"],[27,1,"いか"],[30,1,"いた"]],"text":"正しい者の願いは、すべて良い結果を得、悪しき者の望みは怒りに至る。"},{"ref":"Prov.11.24","start":20011024,"end":20011024,"break":"line","breaks":[[18,"line"],[31,"line"]],"ruby":[[0,1,"ほどこ"],[2,1,"ち"],[9,1,"とみ"],[11,1,"ま"],[13,1,"ひと"],[18,1,"あた"],[26,1,"お"],[35,1,"まず"],[40,1,"もの"]],"text":"施し散らして、なお富を増す人があり、与えるべきものを惜しんで、かえって貧しくなる者がある。"},{"ref":"Prov.11.25","start":20011025,"end":20011025,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"ものお"],[7,1,"もの"],[9,1,"と"],[12,1,"ひと"],[14,1,"うるお"],[16,1,"もの"],[18,2,"じぶん"],[21,1,"うるお"]],"text":"物惜しみしない者は富み、人を潤す者は自分も潤される。"},{"ref":"Prov.11.26","start":20011026,"end":20011026,"break":"line","breaks":[[24,"line"]],"ruby":[[0,2,"こくもつ"],[7,1,"こ"],[10,1,"う"],[14,1,"もの"],[16,1,"たみ"],[27,1,"う"],[29,1,"もの"],[36,2,"しゅくふく"]],"text":"穀物を、しまい込んで売らない者は民にのろわれる、それを売る者のこうべには祝福がある。"},{"ref":"Prov.11.27","start":20011027,"end":20011027,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ぜん"],[2,1,"もと"],[5,1,"もの"],[7,1,"めぐ"],[10,1,"え"],[13,1,"あく"],[15,1,"もと"],[18,1,"もの"],[21,1,"あく"],[23,1,"く"]],"text":"善を求める者は恵みを得る、悪を求める者には悪が来る。"},{"ref":"Prov.11.28","start":20011028,"end":20011028,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"じぶん"],[3,1,"とみ"],[5,1,"たの"],[7,1,"もの"],[9,1,"おとろ"],[13,1,"ただ"],[16,1,"もの"],[18,1,"き"],[20,2,"あおば"],[26,1,"さか"]],"text":"自分の富を頼む者は衰える、正しい者は木の青葉のように栄える。"},{"ref":"Prov.11.29","start":20011029,"end":20011029,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"じぶん"],[3,2,"かぞく"],[6,1,"くる"],[10,1,"もの"],[12,1,"かぜ"],[14,2,"しょゆう"],[20,1,"おろ"],[23,1,"もの"],[25,1,"こころ"],[30,1,"もの"]],"text":"自分の家族を苦しめる者は風を所有とする、愚かな者は心のさとき者のしもべとなる。"},{"ref":"Prov.11.30","start":20011030,"end":20011030,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"むす"],[7,1,"み"],[9,1,"いのち"],[11,1,"き"],[16,2,"ふほう"],[19,1,"もの"],[21,1,"ひと"],[23,1,"いのち"]],"text":"正しい者の結ぶ実は命の木である、不法な者は人の命をとる。"},{"ref":"Prov.11.31","start":20011031,"end":20011031,"break":"line","breaks":[[20,"line"]],"ruby":[[2,1,"ただ"],[5,1,"もの"],[9,1,"よ"],[11,1,"ばっ"],[20,1,"あ"],[23,1,"もの"],[25,1,"つみ"]],"text":"もし正しい者がこの世で罰せられるならば、悪しき者と罪びととは、なおさらである。"}]