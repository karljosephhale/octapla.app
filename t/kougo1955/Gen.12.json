[{"ref":"Gen.12.1","start":1012001,"end":1012001,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"しゅ"],[9,1,"い"],[19,1,"くに"],[21,1,"で"],[24,2,"しんぞく"],[27,1,"わか"],[30,1,"ちち"],[32,1,"いえ"],[34,1,"はな"],[41,1,"しめ"],[43,1,"ち"],[45,1,"い"]],"text":"時に主はアブラムに言われた、「あなたは国を出て、親族に別れ、父の家を離れ、わたしが示す地に行きなさい。"},{"ref":"Gen.12.2","start":1012002,"end":1012002,"break":"none","ruby":[[8,1,"おお"],[12,2,"こくみん"],[21,2,"しゅくふく"],[29,1,"な"],[31,1,"おお"],[42,2,"しゅくふく"],[45,1,"もとい"]],"text":"わたしはあなたを大いなる国民とし、あなたを祝福し、あなたの名を大きくしよう。あなたは祝福の基となるであろう。"},{"ref":"Gen.12.3","start":1012003,"end":1012003,"break":"stanza","breaks":[[18,"line"],[35,"line"],[46,"line"]],"ruby":[[4,2,"しゅくふく"],[8,1,"もの"],[14,2,"しゅくふく"],[25,1,"もの"],[35,1,"ち"],[53,2,"しゅくふく"]],"text":"あなたを祝福する者をわたしは祝福し、あなたをのろう者をわたしはのろう。地のすべてのやからは、あなたによって祝福される」。"},{"ref":"Gen.12.4","start":1012004,"end":1012004,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,1,"い"],[16,1,"た"],[23,1,"かれ"],[25,1,"とも"],[27,1,"い"],[40,1,"で"],[47,1,"さい"]],"text":"アブラムは主が言われたようにいで立った。ロトも彼と共に行った。アブラムはハランを出たとき七十五歳であった。"},{"ref":"Gen.12.5","start":1012005,"end":1012005,"break":"none","ruby":[[5,1,"つま"],[11,1,"おとうと"],[13,1,"こ"],[18,1,"あつ"],[25,2,"ざいさん"],[33,1,"え"],[35,2,"ひとびと"],[39,1,"たずさ"],[46,1,"い"],[54,1,"た"],[61,1,"ち"]],"text":"アブラムは妻サライと、弟の子ロトと、集めたすべての財産と、ハランで獲た人々とを携えてカナンに行こうとしていで立ち、カナンの地にきた。"},{"ref":"Gen.12.6","start":1012006,"end":1012006,"break":"none","ruby":[[7,1,"ち"],[9,1,"とお"],[16,1,"ところ"],[26,1,"き"],[31,1,"つ"],[47,1,"ち"]],"text":"アブラムはその地を通ってシケムの所、モレのテレビンの木のもとに着いた。そのころカナンびとがその地にいた。"},{"ref":"Gen.12.7","start":1012007,"end":1012007,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[9,1,"あらわ"],[12,1,"い"],[26,2,"しそん"],[31,1,"ち"],[33,1,"あた"],[44,1,"かれ"],[46,1,"あらわ"],[49,1,"しゅ"],[58,2,"さいだん"],[61,1,"きず"]],"text":"時に主はアブラムに現れて言われた、「わたしはあなたの子孫にこの地を与えます」。アブラムは彼に現れた主のために、そこに祭壇を築いた。"},{"ref":"Gen.12.8","start":1012008,"end":1012008,"break":"none","ruby":[[0,1,"かれ"],[10,1,"ひがし"],[12,1,"やま"],[14,1,"うつ"],[17,2,"てんまく"],[20,1,"は"],[24,1,"にし"],[31,1,"ひがし"],[44,1,"かれ"],[46,1,"しゅ"],[51,2,"さいだん"],[54,1,"きず"],[58,1,"しゅ"],[60,1,"な"],[62,1,"よ"]],"text":"彼はそこからベテルの東の山に移って天幕を張った。西にはベテル、東にはアイがあった。そこに彼は主のために祭壇を築いて、主の名を呼んだ。"},{"ref":"Gen.12.9","start":1012009,"end":1012009,"break":"none","ruby":[[7,1,"すす"],[14,1,"うつ"]],"text":"アブラムはなお進んでネゲブに移った。"},{"ref":"Gen.12.10","start":1012010,"end":1012010,"break":"paragraph","ruby":[[5,1,"ち"],[26,2,"きりゅう"],[36,1,"くだ"],[46,1,"ち"],[48,1,"はげ"]],"text":"さて、その地にききんがあったのでアブラムはエジプトに寄留しようと、そこに下った。ききんがその地に激しかったからである。"},{"ref":"Gen.12.11","start":1012011,"end":1012011,"break":"none","ruby":[[16,1,"ちか"],[23,1,"かれ"],[25,1,"つま"],[30,1,"い"],[43,1,"うつく"],[46,1,"おんな"],[52,1,"し"]],"text":"エジプトにはいろうとして、そこに近づいたとき、彼は妻サライに言った、「わたしはあなたが美しい女であるのを知っています。"},{"ref":"Gen.12.12","start":1012012,"end":1012012,"break":"none","ruby":[[14,1,"み"],[16,1,"とき"],[21,1,"かれ"],[23,1,"つま"],[28,1,"い"],[35,1,"ころ"],[42,1,"い"]],"text":"それでエジプトびとがあなたを見る時、これは彼の妻であると言ってわたしを殺し、あなたを生かしておくでしょう。"},{"ref":"Gen.12.13","start":1012013,"end":1012013,"break":"none","ruby":[[12,1,"いもうと"],[15,1,"い"],[40,2,"ぶじ"],[50,1,"いのち"],[59,1,"たす"]],"text":"どうかあなたは、わたしの妹だと言ってください。そうすればわたしはあなたのおかげで無事であり、わたしの命はあなたによって助かるでしょう」。"},{"ref":"Gen.12.14","start":1012014,"end":1012014,"break":"none","ruby":[[14,1,"とき"],[24,1,"おんな"],[26,1,"み"],[33,1,"うつく"],[36,1,"ひと"]],"text":"アブラムがエジプトにはいった時エジプトびとはこの女を見て、たいそう美しい人であるとし、"},{"ref":"Gen.12.15","start":1012015,"end":1012015,"break":"none","ruby":[[5,2,"こうかん"],[10,2,"かのじょ"],[13,1,"み"],[18,1,"まえ"],[26,1,"おんな"],[31,1,"いえ"],[33,1,"め"],[35,1,"い"]],"text":"またパロの高官たちも彼女を見てパロの前でほめたので、女はパロの家に召し入れられた。"},{"ref":"Gen.12.16","start":1012016,"end":1012016,"break":"none","ruby":[[3,2,"かのじょ"],[14,1,"あつ"],[29,1,"おお"],[32,1,"ひつじ"],[34,1,"うし"],[36,2,"しゆう"],[42,2,"だんじょ"],[45,2,"どれい"],[55,1,"え"]],"text":"パロは彼女のゆえにアブラムを厚くもてなしたので、アブラムは多くの羊、牛、雌雄のろば、男女の奴隷および、らくだを得た。"},{"ref":"Gen.12.17","start":1012017,"end":1012017,"break":"paragraph","ruby":[[4,1,"しゅ"],[11,1,"つま"],[20,1,"はげ"],[23,2,"えきびょう"],[31,1,"いえ"],[33,1,"くだ"]],"text":"ところで主はアブラムの妻サライのゆえに、激しい疫病をパロとその家に下された。"},{"ref":"Gen.12.18","start":1012018,"end":1012018,"break":"none","ruby":[[8,1,"め"],[10,1,"よ"],[13,1,"い"],[31,1,"こと"],[42,2,"かのじょ"],[45,1,"つま"],[55,1,"つ"]],"text":"パロはアブラムを召し寄せて言った、「あなたはわたしになんという事をしたのですか。なぜ彼女が妻であるのをわたしに告げなかったのですか。"},{"ref":"Gen.12.19","start":1012019,"end":1012019,"break":"none","ruby":[[7,2,"かのじょ"],[14,1,"いもうと"],[18,1,"い"],[30,2,"かのじょ"],[33,1,"つま"],[53,1,"つま"],[62,1,"つ"],[65,1,"い"]],"text":"あなたはなぜ、彼女はわたしの妹ですと言ったのですか。わたしは彼女を妻にしようとしていました。さあ、あなたの妻はここにいます。連れて行ってください」。"},{"ref":"Gen.12.20","start":1012020,"end":1012020,"break":"none","ruby":[[3,1,"かれ"],[5,1,"こと"],[10,2,"ひとびと"],[13,1,"めい"],[16,1,"かれ"],[20,1,"つま"],[30,1,"も"],[32,1,"もの"],[34,1,"おく"],[36,1,"さ"]],"text":"パロは彼の事について人々に命じ、彼とその妻およびそのすべての持ち物を送り去らせた。"}]