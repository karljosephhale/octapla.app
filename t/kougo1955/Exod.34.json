[{"ref":"Exod.34.1","start":2034001,"end":2034001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"まえ"],[21,1,"いし"],[23,1,"いた"],[25,1,"まい"],[28,1,"き"],[31,1,"つく"],[45,1,"くだ"],[48,1,"はじ"],[51,1,"いた"],[56,2,"ことば"],[62,1,"いた"],[64,1,"か"]],"text":"主はモーセに言われた、「あなたは前のような石の板二枚を、切って造りなさい。わたしはあなたが砕いた初めの板にあった言葉を、その板に書くであろう。"},{"ref":"Exod.34.2","start":2034002,"end":2034002,"break":"none","ruby":[[4,1,"あさ"],[8,1,"そな"],[13,1,"あさ"],[21,1,"さん"],[23,1,"のぼ"],[27,1,"やま"],[29,1,"いただき"],[35,1,"まえ"],[37,1,"た"]],"text":"あなたは朝までに備えをし、朝のうちにシナイ山に登って、山の頂でわたしの前に立ちなさい。"},{"ref":"Exod.34.3","start":2034003,"end":2034003,"break":"none","ruby":[[7,1,"とも"],[9,1,"のぼ"],[24,1,"やま"],[26,1,"なか"],[38,1,"やま"],[40,1,"まえ"],[42,1,"ひつじ"],[44,1,"うし"],[46,1,"か"]],"text":"だれもあなたと共に登ってはならない。また、だれも山の中にいてはならない。また山の前で羊や牛を飼っていてはならない」。"},{"ref":"Exod.34.4","start":2034004,"end":2034004,"break":"none","ruby":[[7,1,"まえ"],[12,1,"いし"],[14,1,"いた"],[16,1,"まい"],[19,1,"き"],[22,1,"つく"],[25,1,"あさ"],[26,1,"はや"],[28,1,"お"],[32,1,"しゅ"],[34,1,"かれ"],[36,1,"めい"],[47,1,"さん"],[49,1,"のぼ"],[53,1,"かれ"],[57,1,"て"],[59,1,"いし"],[61,1,"いた"],[63,1,"まい"]],"text":"そこでモーセは前のような石の板二枚を、切って造り、朝早く起きて、主が彼に命じられたようにシナイ山に登った。彼はその手に石の板二枚をとった。"},{"ref":"Exod.34.5","start":2034005,"end":2034005,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"くも"],[7,1,"なか"],[12,1,"くだ"],[15,1,"かれ"],[17,1,"とも"],[22,1,"た"],[25,1,"しゅ"],[27,1,"な"],[29,1,"の"]],"text":"ときに主は雲の中にあって下り、彼と共にそこに立って主の名を宣べられた。"},{"ref":"Exod.34.6","start":2034006,"end":2034006,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"まえ"],[6,1,"す"],[9,1,"の"],[16,1,"しゅ"],[18,1,"しゅ"],[27,1,"めぐ"],[32,1,"いか"],[52,1,"ゆた"],[56,1,"かみ"]],"text":"主は彼の前を過ぎて宣べられた。「主、主、あわれみあり、恵みあり、怒ることおそく、いつくしみと、まこととの豊かなる神、"},{"ref":"Exod.34.7","start":2034007,"end":2034007,"break":"none","ruby":[[7,1,"だい"],[11,1,"ほどこ"],[14,1,"あく"],[21,1,"つみ"],[27,1,"もの"],[33,1,"ばつ"],[37,1,"もの"],[40,1,"けっ"],[48,1,"ちち"],[50,1,"つみ"],[52,1,"こ"],[54,1,"むく"],[57,1,"こ"],[59,1,"こ"],[61,1,"むく"],[68,1,"だい"],[74,1,"もの"]],"text":"いつくしみを千代までも施し、悪と、とがと、罪とをゆるす者、しかし、罰すべき者をば決してゆるさず、父の罪を子に報い、子の子に報いて、三、四代におよぼす者」。"},{"ref":"Exod.34.8","start":2034008,"end":2034008,"break":"none","ruby":[[4,1,"いそ"],[6,1,"ち"],[8,1,"ふ"],[11,1,"はい"]],"text":"モーセは急ぎ地に伏して拝し、"},{"ref":"Exod.34.9","start":2034009,"end":2034009,"break":"none","ruby":[[3,1,"い"],[10,1,"しゅ"],[24,1,"まえ"],[26,1,"めぐ"],[29,1,"え"],[41,1,"たみ"],[52,1,"しゅ"],[66,2,"いっしょ"],[69,1,"い"],[86,1,"あく"],[88,1,"つみ"]],"text":"そして言った、「ああ主よ、わたしがもし、あなたの前に恵みを得ますならば、かたくなな民ですけれども、どうか主がわたしたちのうちにあって一緒に行ってください。そしてわたしたちの悪と罪とをゆるし、わたしたちをあなたのものとしてください」。"},{"ref":"Exod.34.10","start":2034010,"end":2034010,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"み"],[15,2,"けいやく"],[18,1,"むす"],[25,1,"ち"],[37,1,"たみ"],[47,1,"おこな"],[56,3,"ふしぎ"],[69,1,"たみ"],[71,1,"まえ"],[73,1,"おこな"],[84,1,"とも"],[86,1,"す"],[88,1,"たみ"],[93,1,"しゅ"],[98,1,"み"],[126,1,"おそ"]],"text":"主は言われた、「見よ、わたしは契約を結ぶ。わたしは地のいずこにも、いかなる民のうちにも、いまだ行われたことのない不思議を、あなたのすべての民の前に行うであろう。あなたが共に住む民はみな、主のわざを見るであろう。わたしがあなたのためになそうとすることは、恐るべきものだからである。"},{"ref":"Exod.34.11","start":2034011,"end":2034011,"break":"paragraph","ruby":[[13,1,"めい"],[19,1,"まも"],[25,1,"み"],[71,1,"まえ"],[74,1,"お"],[76,1,"はら"]],"text":"わたしが、きょう、あなたに命じることを守りなさい。見よ、わたしはアモリびと、カナンびと、ヘテびと、ペリジびと、ヒビびと、エブスびとを、あなたの前から追い払うであろう。"},{"ref":"Exod.34.12","start":2034012,"end":2034012,"break":"none","ruby":[[4,1,"ゆ"],[6,1,"くに"],[8,1,"す"],[13,1,"もの"],[16,2,"けいやく"],[19,1,"むす"],[27,1,"き"],[44,1,"かれ"]],"text":"あなたが行く国に住んでいる者と、契約を結ばないように、気をつけなければならない。おそらく彼らはあなたのうちにあって、わなとなるであろう。"},{"ref":"Exod.34.13","start":2034013,"end":2034013,"break":"none","ruby":[[10,1,"かれ"],[13,2,"さいだん"],[16,1,"たお"],[19,1,"いし"],[21,1,"はしら"],[23,1,"くだ"],[29,1,"ぞう"],[31,1,"き"],[33,1,"たお"]],"text":"むしろあなたがたは、彼らの祭壇を倒し、石の柱を砕き、アシラ像を切り倒さなければならない。"},{"ref":"Exod.34.14","start":2034014,"end":2034014,"break":"none","ruby":[[4,1,"た"],[6,1,"かみ"],[8,1,"おが"],[17,1,"しゅ"],[21,1,"な"],[29,1,"い"],[36,1,"かみ"]],"text":"あなたは他の神を拝んではならない。主はその名を『ねたみ』と言って、ねたむ神だからである。"},{"ref":"Exod.34.15","start":2034015,"end":2034015,"break":"none","ruby":[[10,1,"くに"],[12,1,"す"],[14,1,"もの"],[16,2,"けいやく"],[19,1,"むす"],[22,1,"かれ"],[25,2,"かみがみ"],[28,1,"した"],[31,2,"かんいん"],[34,1,"おこな"],[39,2,"かみがみ"],[42,2,"ぎせい"],[49,1,"まね"],[53,1,"かれ"],[56,2,"ぎせい"],[59,1,"た"]],"text":"おそらくあなたはその国に住む者と契約を結び、彼らの神々を慕って姦淫を行い、その神々に犠牲をささげ、招かれて彼らの犠牲を食べ、"},{"ref":"Exod.34.16","start":2034016,"end":2034016,"break":"none","ruby":[[4,1,"むすめ"],[25,1,"むすめ"],[29,2,"じぶん"],[34,2,"かみがみ"],[37,1,"した"],[40,2,"かんいん"],[43,1,"おこな"],[62,1,"かれ"],[65,2,"かみがみ"],[68,1,"した"],[72,2,"かんいん"],[75,1,"おこな"],[80,1,"いた"]],"text":"またその娘たちを、あなたのむすこたちにめとり、その娘たちが自分たちの神々を慕って姦淫を行い、また、あなたのむすこたちをして、彼らの神々を慕わせ、姦淫を行わせるに至るであろう。"},{"ref":"Exod.34.17","start":2034017,"end":2034017,"break":"paragraph","ruby":[[4,2,"じぶん"],[10,2,"いもの"],[13,2,"かみがみ"],[16,1,"つく"]],"text":"あなたは自分のために鋳物の神々を造ってはならない。"},{"ref":"Exod.34.18","start":2034018,"end":2034018,"break":"paragraph","ruby":[[4,1,"たね"],[5,1,"い"],[11,1,"まつり"],[13,1,"まも"],[37,1,"めい"],[48,1,"つき"],[50,1,"さだ"],[53,1,"とき"],[56,2,"なぬか"],[63,1,"たね"],[64,1,"い"],[70,1,"た"],[89,1,"つき"],[96,1,"で"]],"text":"あなたは種入れぬパンの祭を守らなければならない。すなわち、わたしがあなたに命じたように、アビブの月の定めの時に、七日のあいだ、種入れぬパンを食べなければならない。あなたがアビブの月にエジプトを出たからである。"},{"ref":"Exod.34.19","start":2034019,"end":2034019,"break":"none","ruby":[[3,1,"はじ"],[6,1,"うま"],[9,1,"もの"],[29,2,"かちく"],[36,1,"おす"],[39,1,"うし"],[41,1,"ひつじ"]],"text":"すべて初めに生れる者は、わたしのものである。すべてあなたの家畜のういごの雄は、牛も羊もそうである。"},{"ref":"Exod.34.20","start":2034020,"end":2034020,"break":"none","ruby":[[11,2,"こひつじ"],[41,1,"くび"],[43,1,"お"],[88,1,"て"],[94,1,"まえ"],[96,1,"で"]],"text":"ただし、ろばのういごは小羊であがなわなければならない。もしあがなわないならば、その首を折らなければならない。あなたのむすこのうちのういごは、みなあがなわなければならない。むなし手でわたしの前に出てはならない。"},{"ref":"Exod.34.21","start":2034021,"end":2034021,"break":"paragraph","ruby":[[5,1,"か"],[10,1,"はたら"],[13,2,"なぬか"],[15,1,"め"],[18,1,"やす"],[29,1,"たがや"],[31,1,"どき"],[35,2,"かりい"],[38,1,"どき"],[41,1,"やす"]],"text":"あなたは六日のあいだ働き、七日目には休まなければならない。耕し時にも、刈入れ時にも休まなければならない。"},{"ref":"Exod.34.22","start":2034022,"end":2034022,"break":"none","ruby":[[5,1,"しゅう"],[7,1,"まつり"],[13,2,"こむぎ"],[15,1,"か"],[18,2,"はつほ"],[21,1,"まつり"],[23,1,"おこな"],[36,1,"ねん"],[38,1,"おわ"],[41,1,"と"],[43,1,"い"],[46,1,"まつり"],[48,1,"おこな"]],"text":"あなたは七週の祭、すなわち小麦刈りの初穂の祭を行わなければならない。また年の終りに取り入れの祭を行わなければならない。"},{"ref":"Exod.34.23","start":2034023,"end":2034023,"break":"none","ruby":[[0,1,"ねん"],[3,1,"ど"],[5,2,"だんし"],[10,1,"しゅ"],[13,1,"かみ"],[21,1,"かみ"],[23,1,"まえ"],[25,1,"で"]],"text":"年に三度、男子はみな主なる神、イスラエルの神の前に出なければならない。"},{"ref":"Exod.34.24","start":2034024,"end":2034024,"break":"none","ruby":[[4,2,"くにぐに"],[7,1,"たみ"],[13,1,"まえ"],[16,1,"お"],[18,1,"はら"],[26,1,"さかい"],[28,1,"ひろ"],[41,1,"ねん"],[44,1,"ど"],[54,1,"かみ"],[56,1,"しゅ"],[58,1,"まえ"],[60,1,"で"],[62,1,"とき"],[73,1,"くに"],[75,1,"おか"]],"text":"わたしは国々の民をあなたの前から追い払って、あなたの境を広くするであろう。あなたが年に三度のぼって、あなたの神、主の前に出る時には、だれもあなたの国を侵すことはないであろう。"},{"ref":"Exod.34.25","start":2034025,"end":2034025,"break":"paragraph","ruby":[[4,2,"ぎせい"],[7,1,"ち"],[10,1,"たね"],[12,1,"い"],[18,1,"とも"],[20,1,"そな"],[31,2,"すぎこし"],[34,1,"まつり"],[36,2,"ぎせい"],[40,2,"よくあさ"],[44,1,"のこ"],[47,1,"お"]],"text":"あなたは犠牲の血を、種を入れたパンと共に供えてはならない。また過越の祭の犠牲を、翌朝まで残して置いてはならない。"},{"ref":"Exod.34.26","start":2034026,"end":2034026,"break":"none","ruby":[[4,2,"とち"],[7,2,"はつほ"],[10,1,"もっと"],[12,1,"よ"],[22,1,"かみ"],[24,1,"しゅ"],[26,1,"いえ"],[28,1,"たずさ"],[45,1,"こ"],[51,1,"はは"],[53,1,"ちち"],[55,1,"に"]],"text":"あなたの土地の初穂の最も良いものを、あなたの神、主の家に携えてこなければならない。あなたは子やぎをその母の乳で煮てはならない」。"},{"ref":"Exod.34.27","start":2034027,"end":2034027,"break":"none","ruby":[[2,1,"しゅ"],[8,1,"い"],[18,2,"ことば"],[21,1,"か"],[38,2,"ことば"],[41,1,"もとづ"],[57,2,"けいやく"],[60,1,"むす"]],"text":"また主はモーセに言われた、「これらの言葉を書きしるしなさい。わたしはこれらの言葉に基いて、あなたおよびイスラエルと契約を結んだからである」。"},{"ref":"Exod.34.28","start":2034028,"end":2034028,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"とも"],[11,1,"にち"],[14,1,"や"],[26,1,"た"],[30,1,"みず"],[32,1,"の"],[42,1,"かれ"],[44,2,"けいやく"],[47,2,"ことば"],[50,2,"じっかい"],[53,1,"いた"],[55,1,"うえ"],[57,1,"か"]],"text":"モーセは主と共に、四十日四十夜、そこにいたが、パンも食べず、水も飲まなかった。そして彼は契約の言葉、十誡を板の上に書いた。"},{"ref":"Exod.34.29","start":2034029,"end":2034029,"break":"paragraph","ruby":[[10,1,"いた"],[12,1,"まい"],[14,1,"て"],[22,1,"さん"],[25,1,"くだ"],[32,1,"やま"],[34,1,"くだ"],[48,1,"しゅ"],[50,1,"かた"],[57,1,"かお"],[59,1,"かわ"],[61,1,"ひかり"],[63,1,"はな"],[70,1,"し"]],"text":"モーセはそのあかしの板二枚を手にして、シナイ山から下ったが、その山を下ったとき、モーセは、さきに主と語ったゆえに、顔の皮が光を放っているのを知らなかった。"},{"ref":"Exod.34.30","start":2034030,"end":2034030,"break":"none","ruby":[[10,2,"ひとびと"],[21,1,"み"],[25,1,"かれ"],[27,1,"かお"],[29,1,"かわ"],[31,1,"ひかり"],[33,1,"はな"],[41,1,"かれ"],[44,1,"おそ"],[50,1,"ちか"]],"text":"アロンとイスラエルの人々とがみな、モーセを見ると、彼の顔の皮が光を放っていたので、彼らは恐れてこれに近づかなかった。"},{"ref":"Exod.34.31","start":2034031,"end":2034031,"break":"none","ruby":[[4,1,"かれ"],[7,1,"よ"],[15,2,"かいしゅう"],[35,1,"かえ"],[47,1,"かれ"],[50,1,"かた"]],"text":"モーセは彼らを呼んだ。アロンと会衆のかしらたちとがみな、モーセのもとに帰ってきたので、モーセは彼らと語った。"},{"ref":"Exod.34.32","start":2034032,"end":2034032,"break":"none","ruby":[[2,1,"のち"],[10,2,"ひとびと"],[15,1,"ちか"],[26,1,"しゅ"],[31,1,"さん"],[33,1,"かれ"],[35,1,"かた"],[48,1,"かれ"]],"text":"その後、イスラエルの人々がみな近よったので、モーセは主がシナイ山で彼に語られたことを、ことごとく彼らにさとした。"},{"ref":"Exod.34.33","start":2034033,"end":2034033,"break":"none","ruby":[[4,1,"かれ"],[7,1,"かた"],[9,1,"お"],[12,1,"とき"],[14,1,"かお"],[19,1,"かお"],[21,1,"あ"]],"text":"モーセは彼らと語り終えた時、顔おおいを顔に当てた。"},{"ref":"Exod.34.34","start":2034034,"end":2034034,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"まえ"],[11,1,"い"],[14,1,"しゅ"],[16,1,"かた"],[18,1,"とき"],[21,1,"で"],[25,1,"かお"],[30,1,"と"],[32,1,"のぞ"],[41,1,"で"],[43,1,"く"],[49,1,"めい"],[54,1,"こと"],[62,1,"ひと"],[63,1,"ひと"],[65,1,"つ"]],"text":"しかしモーセは主の前に行って主と語る時は、出るまで顔おおいを取り除いていた。そして出て来ると、その命じられた事をイスラエルの人人に告げた。"},{"ref":"Exod.34.35","start":2034035,"end":2034035,"break":"none","ruby":[[6,2,"ひとびと"],[13,1,"かお"],[15,1,"み"],[23,1,"かお"],[25,1,"かわ"],[27,1,"ひかり"],[29,1,"はな"],[39,1,"い"],[42,1,"しゅ"],[44,1,"かた"],[51,1,"かお"],[56,1,"かお"],[58,1,"あ"]],"text":"イスラエルの人々はモーセの顔を見ると、モーセの顔の皮が光を放っていた。モーセは行って主と語るまで、また顔おおいを顔に当てた。"}]