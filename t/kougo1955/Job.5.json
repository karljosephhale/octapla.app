[{"ref":"Job.5.1","start":18005001,"end":18005001,"break":"paragraph","breaks":[[9,"line"],[25,"line"]],"ruby":[[0,1,"こころ"],[3,1,"よ"],[16,1,"こた"],[19,1,"もの"],[27,2,"せいじゃ"],[34,1,"たの"]],"text":"試みに呼んでみよ、だれかあなたに答える者があるか。どの聖者にあなたは頼もうとするのか。"},{"ref":"Job.5.2","start":18005002,"end":18005002,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"たし"],[4,1,"いきどお"],[7,1,"おろ"],[10,1,"もの"],[12,1,"ころ"],[24,1,"もの"],[26,1,"し"]],"text":"確かに、憤りは愚かな者を殺し、ねたみはあさはかな者を死なせる。"},{"ref":"Job.5.3","start":18005003,"end":18005003,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"おろ"],[7,1,"もの"],[9,1,"ね"],[11,1,"は"],[15,1,"み"]],"text":"わたしは愚かな者の根を張るのを見た、しかしわたしは、にわかにそのすみかをのろった。"},{"ref":"Job.5.4","start":18005004,"end":18005004,"break":"line","breaks":[[11,"line"]],"ruby":[[2,1,"こ"],[5,1,"やす"],[8,1,"え"],[11,1,"まち"],[13,1,"もん"],[27,1,"すく"],[29,1,"もの"]],"text":"その子らは安きを得ず、町の門でしえたげられても、これを救う者がない。"},{"ref":"Job.5.5","start":18005005,"end":18005005,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[2,2,"しゅうかく"],[5,1,"う"],[8,1,"ひと"],[10,1,"た"],[17,1,"なか"],[26,1,"うば"],[36,1,"もの"],[40,2,"ざいさん"],[46,1,"もと"]],"text":"その収穫は飢えた人が食べ、いばらの中からさえ、これを奪う。また、かわいた者はその財産をあえぎ求める。"},{"ref":"Job.5.6","start":18005006,"end":18005006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"くる"],[9,1,"おこ"],[17,1,"なや"],[20,1,"つち"],[23,1,"しょう"]],"text":"苦しみは、ちりから起るものでなく、悩みは土から生じるものでない。"},{"ref":"Job.5.7","start":18005007,"end":18005007,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ひと"],[2,1,"うま"],[5,1,"なや"],[8,1,"う"],[14,1,"ひ"],[16,1,"こ"],[18,1,"うえ"],[20,1,"と"]],"text":"人が生れて悩みを受けるのは、火の子が上に飛ぶにひとしい。"},{"ref":"Job.5.8","start":18005008,"end":18005008,"break":"stanza","breaks":[[19,"line"]],"ruby":[[14,1,"かみ"],[16,1,"もと"],[19,1,"かみ"],[26,1,"こと"]],"text":"しかし、わたしであるならば、神に求め、神に、わたしの事をまかせる。"},{"ref":"Job.5.9","start":18005009,"end":18005009,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[2,1,"おお"],[6,1,"こと"],[15,1,"はか"],[17,1,"し"],[24,3,"ふしぎ"],[32,1,"かぞ"]],"text":"彼は大いなる事をされるかたで、測り知れない、その不思議なみわざは数えがたい。"},{"ref":"Job.5.10","start":18005010,"end":18005010,"break":"line","ruby":[[0,1,"かれ"],[2,1,"ち"],[4,1,"あめ"],[6,1,"ふ"],[10,1,"の"],[12,1,"みず"],[14,1,"おく"]],"text":"彼は地に雨を降らせ、野に水を送られる。"},{"ref":"Job.5.11","start":18005011,"end":18005011,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ひく"],[4,1,"もの"],[6,1,"たか"],[11,1,"かな"],[14,1,"もの"],[16,1,"ひ"],[18,1,"あ"],[22,2,"あんぜん"]],"text":"彼は低い者を高くあげ、悲しむ者を引き上げて、安全にされる。"},{"ref":"Job.5.12","start":18005012,"end":18005012,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[2,2,"わるがしこ"],[5,1,"もの"],[7,1,"はか"],[12,1,"やぶ"],[20,2,"なにごと"],[25,1,"て"],[29,1,"と"]],"text":"彼は悪賢い者の計りごとを敗られる。それで何事もその手になし遂げることはできない。"},{"ref":"Job.5.13","start":18005013,"end":18005013,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[2,1,"かしこ"],[4,1,"もの"],[7,1,"かれ"],[9,2,"じしん"],[12,2,"わるだく"],[19,1,"とら"],[22,1,"まが"],[25,1,"もの"],[27,1,"はか"]],"text":"彼は賢い者を、彼ら自身の悪巧みによって捕え、曲った者の計りごとをくつがえされる。"},{"ref":"Job.5.14","start":18005014,"end":18005014,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ひる"],[9,1,"あ"],[12,2,"まひる"],[17,1,"よる"],[22,2,"てさぐ"]],"text":"彼らは昼も、やみに会い、真昼にも、夜のように手探りする。"},{"ref":"Job.5.15","start":18005015,"end":18005015,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[2,1,"まず"],[5,1,"もの"],[7,1,"かれ"],[10,1,"くち"],[17,1,"すく"],[22,1,"つよ"],[24,1,"もの"],[26,1,"て"],[29,1,"すく"]],"text":"彼は貧しい者を彼らの口のつるぎから救い、また強い者の手から救われる。"},{"ref":"Job.5.16","start":18005016,"end":18005016,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"とぼ"],[7,1,"もの"],[9,1,"のぞ"],[15,2,"ふぎ"],[20,1,"くち"],[22,1,"と"]],"text":"それゆえ乏しい者に望みがあり、不義はその口を閉じる。"},{"ref":"Job.5.17","start":18005017,"end":18005017,"break":"stanza","breaks":[[18,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[5,1,"いまし"],[10,1,"ひと"],[22,3,"ぜんのうしゃ"],[26,1,"こら"],[30,1,"かろ"]],"text":"見よ、神に戒められる人はさいわいだ。それゆえ全能者の懲しめを軽んじてはならない。"},{"ref":"Job.5.18","start":18005018,"end":18005018,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[2,1,"きず"],[8,1,"つつ"],[11,1,"う"],[18,1,"て"]],"text":"彼は傷つけ、また包み、撃ち、またその手をもっていやされる。"},{"ref":"Job.5.19","start":18005019,"end":18005019,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[9,1,"なや"],[13,1,"すく"],[24,1,"わざわい"],[30,1,"ふ"]],"text":"彼はあなたを六つの悩みから救い、七つのうちでも、災はあなたに触れることがない。"},{"ref":"Job.5.20","start":18005020,"end":18005020,"break":"line","breaks":[[18,"line"],[25,"line"]],"ruby":[[4,1,"とき"],[18,1,"し"],[20,1,"まぬか"],[29,1,"とき"],[37,1,"ちから"],[39,1,"まぬか"]],"text":"ききんの時には、あなたをあがなって、死を免れさせ、いくさの時には、つるぎの力を免れさせられる。"},{"ref":"Job.5.21","start":18005021,"end":18005021,"break":"line","breaks":[[19,"line"],[26,"line"]],"ruby":[[4,1,"した"],[11,1,"う"],[15,1,"とき"],[22,1,"かく"],[26,1,"ほろ"],[29,1,"く"],[31,1,"とき"],[35,1,"おそ"]],"text":"あなたは舌をもってむち打たれる時にも、おおい隠され、滅びが来る時でも、恐れることはない。"},{"ref":"Job.5.22","start":18005022,"end":18005022,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"ほろ"],[13,1,"わら"],[16,1,"ち"],[18,1,"けもの"],[21,1,"おそ"]],"text":"あなたは滅びと、ききんとを笑い、地の獣をも恐れることはない。"},{"ref":"Job.5.23","start":18005023,"end":18005023,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"の"],[6,1,"いし"],[8,2,"けいやく"],[11,1,"むす"],[14,1,"の"],[16,1,"けもの"],[22,1,"やわ"]],"text":"あなたは野の石と契約を結び、野の獣はあなたと和らぐからである。"},{"ref":"Job.5.24","start":18005024,"end":18005024,"break":"line","breaks":[[19,"line"]],"ruby":[[4,2,"じぶん"],[7,2,"てんまく"],[10,2,"あんぜん"],[16,1,"し"],[19,2,"じぶん"],[22,2,"かちく"],[28,2,"みまわ"],[34,1,"か"],[37,1,"もの"]],"text":"あなたは自分の天幕の安全なことを知り、自分の家畜のおりを見回っても、欠けた物がなく、"},{"ref":"Job.5.25","start":18005025,"end":18005025,"break":"line","breaks":[[15,"line"]],"ruby":[[7,2,"しそん"],[10,1,"おお"],[20,1,"ち"],[22,1,"くさ"],[31,1,"し"]],"text":"また、あなたの子孫の多くなり、そのすえが地の草のようになるのを知るであろう。"},{"ref":"Job.5.26","start":18005026,"end":18005026,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[4,2,"こうれい"],[7,1,"たっ"],[10,1,"はか"],[12,1,"はい"],[19,1,"むぎ"],[20,1,"たば"],[24,2,"きせつ"],[30,1,"う"],[32,1,"ば"],[34,1,"はこ"]],"text":"あなたは高齢に達して墓に入る、あたかも麦束をその季節になって打ち場に運びあげるようになるであろう。"},{"ref":"Job.5.27","start":18005027,"end":18005027,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"み"],[8,1,"たず"],[14,1,"ところ"],[30,1,"き"],[38,1,"し"]],"text":"見よ、われわれの尋ねきわめた所はこのとおりだ。あなたはこれを聞いて、みずから知るがよい」。"}]