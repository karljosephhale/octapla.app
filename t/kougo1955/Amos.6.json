[{"ref":"Amos.6.1","start":30006001,"end":30006001,"break":"paragraph","breaks":[[10,"line"],[22,"line"],[39,"line"],[57,"line"]],"ruby":[[10,1,"やす"],[20,1,"もの"],[24,2,"あんしん"],[33,1,"やま"],[37,1,"もの"],[39,1,"しょ"],[40,2,"こくみん"],[50,2,"ちょめい"],[53,2,"ひとびと"],[63,1,"いえ"],[67,1,"したが"],[69,1,"もの"]],"text":"「わざわいなるかな、安らかにシオンにいる者、また安心してサマリヤの山にいる者、諸国民のかしらのうちの著名な人々で、イスラエルの家がきて従う者よ。"},{"ref":"Amos.6.2","start":30006002,"end":30006002,"break":"line","breaks":[[10,"line"],[22,"line"],[40,"line"],[57,"line"]],"ruby":[[4,1,"わた"],[7,1,"み"],[14,1,"おお"],[19,1,"い"],[34,1,"くだ"],[37,1,"み"],[40,1,"かれ"],[47,1,"くに"],[57,1,"かれ"],[60,2,"とち"],[69,2,"とち"],[74,1,"おお"]],"text":"カルネに渡って見よ。そこから大ハマテに行き、またペリシテびとのガテに下って見よ。彼らはこれらの国にまさっているか。彼らの土地はあなたがたの土地よりも大きいか。"},{"ref":"Amos.6.3","start":30006003,"end":30006003,"break":"line","breaks":[[14,"line"]],"ruby":[[6,1,"わざわい"],[8,1,"ひ"],[10,1,"とお"],[14,2,"きょうぼう"],[17,1,"ざ"],[19,1,"ちか"]],"text":"あなたがたは災の日を遠ざけ、強暴の座を近づけている。"},{"ref":"Amos.6.4","start":30006004,"end":30006004,"break":"stanza","breaks":[[22,"line"],[34,"line"],[47,"line"]],"ruby":[[13,2,"ぞうげ"],[16,2,"しんだい"],[19,1,"ふ"],[22,1,"なが"],[26,1,"うえ"],[28,1,"み"],[30,1,"の"],[34,1,"む"],[41,2,"こひつじ"],[44,1,"と"],[47,2,"ぎゅうしゃ"],[54,1,"こ"],[55,1,"うし"],[57,1,"と"],[60,1,"た"]],"text":"わざわいなるかな、みずから象牙の寝台に伏し、長いすの上に身を伸ばし、群れのうちから小羊を取り、牛舎のうちから子牛を取って食べ、"},{"ref":"Amos.6.5","start":30006005,"end":30006005,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"こと"],[2,1,"おと"],[4,1,"あ"],[8,1,"うた"],[10,1,"さわ"],[20,2,"がっき"],[23,1,"つく"],[25,1,"だ"]],"text":"琴の音に合わせて歌い騒ぎ、ダビデのように楽器を造り出し、"},{"ref":"Amos.6.6","start":30006006,"end":30006006,"break":"line","breaks":[[10,"line"],[22,"line"]],"ruby":[[0,1,"はち"],[5,1,"さけ"],[7,1,"の"],[13,1,"たっと"],[15,1,"あぶら"],[17,1,"み"],[26,2,"はめつ"],[29,1,"かな"],[34,1,"もの"]],"text":"鉢をもって酒を飲み、いとも尊い油を身にぬり、ヨセフの破滅を悲しまない者たちよ。"},{"ref":"Amos.6.7","start":30006007,"end":30006007,"break":"line","breaks":[[14,"line"],[29,"line"],[44,"line"]],"ruby":[[4,1,"いま"],[6,1,"かれ"],[9,1,"とら"],[14,1,"とら"],[17,1,"びと"],[21,1,"さき"],[23,1,"た"],[26,1,"い"],[34,1,"み"],[36,1,"の"],[40,1,"もの"],[44,1,"さわ"]],"text":"それゆえ今、彼らは捕われて、捕われ人のまっ先に立って行く。そしてかの身を伸ばした者どもの騒ぎはやむであろう」。"},{"ref":"Amos.6.8","start":30006008,"end":30006008,"break":"stanza","breaks":[[17,"line"],[31,"line"],[48,"line"],[61,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[12,1,"ちか"],[18,2,"ばんぐん"],[21,1,"かみ"],[23,1,"しゅ"],[25,1,"い"],[40,1,"ほこり"],[42,1,"い"],[55,2,"きゅうでん"],[58,1,"にく"],[67,1,"まち"],[74,1,"なか"],[78,1,"もの"],[80,1,"わた"]],"text":"主なる神はおのれによって誓われた、(万軍の神、主は言われる、)「わたしはヤコブの誇を忌みきらい、そのもろもろの宮殿を憎む。わたしはこの町とすべてその中にいる者を渡す」。"},{"ref":"Amos.6.9","start":30006009,"end":30006009,"break":"none","ruby":[[3,1,"いえ"],[6,1,"にん"],[8,1,"もの"],[10,1,"のこ"],[17,1,"かれ"],[20,1,"し"]],"text":"一つの家に十人の者が残っていても、彼らは死に、"},{"ref":"Amos.6.10","start":30006010,"end":30006010,"break":"none","ruby":[[5,2,"しんせき"],[15,1,"や"],[17,1,"もの"],[20,1,"ほね"],[22,1,"いえ"],[25,1,"はこ"],[36,1,"と"],[38,1,"あ"],[45,1,"いえ"],[47,1,"おく"],[51,1,"もの"],[53,1,"む"],[65,1,"とも"],[69,1,"もの"],[76,1,"い"],[85,1,"こたえ"],[89,1,"とき"],[93,1,"ひと"],[98,1,"こえ"],[100,1,"だ"],[104,1,"しゅ"],[106,1,"な"],[115,1,"い"]],"text":"そしてその親戚、すなわちこれを焼く者は、骨を家から運びだすために、これを取り上げ、またその家の奥にいる者に向かって、「まだあなたと共にいる者があるか」と言い、「ない」との答がある時、かの人はまた「声を出すな、主の名をとなえるな」と言うであろう。"},{"ref":"Amos.6.11","start":30006011,"end":30006011,"break":"stanza","breaks":[[9,"line"],[25,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,1,"めい"],[9,1,"おお"],[12,1,"いえ"],[14,1,"う"],[25,1,"ちい"],[28,1,"いえ"],[30,1,"う"],[34,1,"き"],[36,1,"ぎ"]],"text":"見よ、主は命じて、大きな家を撃って、みじんとなし、小さな家を撃って、切れ切れとされる。"},{"ref":"Amos.6.12","start":30006012,"end":30006012,"break":"line","breaks":[[13,"line"],[26,"line"],[44,"line"]],"ruby":[[0,1,"うま"],[2,1,"いわ"],[4,1,"うえ"],[6,1,"はし"],[13,1,"ひと"],[15,1,"うし"],[17,1,"うみ"],[19,1,"たがや"],[36,2,"こうどう"],[39,1,"どく"],[41,1,"へん"],[44,2,"せいぎ"],[47,1,"み"],[55,1,"へん"]],"text":"馬は岩の上を走るだろうか。人は牛で海を耕すだろうか。ところがあなたがたは公道を毒に変じ、正義の実をにがよもぎに変じた。"},{"ref":"Amos.6.13","start":30006013,"end":30006013,"break":"line","breaks":[[14,"line"],[25,"line"]],"ruby":[[11,1,"よろこ"],[20,2,"じぶん"],[23,1,"ちから"],[31,1,"え"],[40,1,"い"]],"text":"あなたがたはロデバルを喜び、「われわれは自分の力でカルナイムを得たではないか」と言う。"},{"ref":"Amos.6.14","start":30006014,"end":30006014,"break":"line","breaks":[[17,"line"],[27,"line"],[44,"line"],[56,"line"],[74,"line"]],"ruby":[[5,2,"ばんぐん"],[8,1,"かみ"],[10,1,"しゅ"],[12,1,"い"],[24,1,"いえ"],[27,1,"み"],[37,2,"くにたみ"],[40,1,"おこ"],[50,2,"てきたい"],[56,1,"かれ"],[63,2,"いりぐち"],[71,1,"かわ"],[80,1,"なや"]],"text":"それゆえ、万軍の神、主は言われる、「イスラエルの家よ、見よ、わたしは一つの国民を起して、あなたがたに敵対させる。彼らはハマテの入口からアラバの川まであなたがたを悩ます」。"}]