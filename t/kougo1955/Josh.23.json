[{"ref":"Josh.23.1","start":6023001,"end":6023001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,2,"しゅうい"],[11,1,"てき"],[19,1,"のぞ"],[29,2,"あんそく"],[32,1,"たま"],[39,1,"ひさ"],[50,1,"とし"],[52,1,"すす"],[55,1,"お"]],"text":"主がイスラエルの周囲の敵を、ことごとく除いて、イスラエルに安息を賜わってのち、久しくたち、ヨシュアも年が進んで老いた。"},{"ref":"Josh.23.2","start":6023002,"end":6023002,"break":"none","ruby":[[15,1,"ひと"],[19,2,"ちょうろう"],[42,1,"よ"],[44,1,"あつ"],[47,1,"い"],[56,1,"ねん"],[58,1,"すす"],[61,2,"ろうじん"]],"text":"ヨシュアはイスラエルのすべての人、その長老、かしらたち、さばきびと、つかさびとたちを呼び集めて言った、「わたしは年も進んで老人となった。"},{"ref":"Josh.23.3","start":6023003,"end":6023003,"break":"none","ruby":[[16,1,"かみ"],[18,1,"しゅ"],[28,1,"くに"],[32,1,"おこな"],[43,1,"み"],[55,1,"たたか"],[68,1,"かみ"],[70,1,"しゅ"]],"text":"あなたがたは、すでにあなたがたの神、主が、このもろもろの国びとに行われたすべてのことを見た。あなたがたのために戦われたのは、あなたがたの神、主である。"},{"ref":"Josh.23.4","start":6023004,"end":6023004,"break":"none","ruby":[[0,1,"み"],[14,1,"ひ"],[16,1,"い"],[18,1,"ほう"],[20,2,"たいかい"],[33,1,"のこ"],[38,2,"くにぐに"],[49,1,"ほろ"],[52,1,"さ"],[59,2,"くにぐに"],[76,1,"わ"],[78,1,"あた"],[87,1,"かく"],[88,2,"ぶぞく"],[91,1,"し"],[92,1,"ぎょう"]],"text":"見よ、わたしはヨルダンから、日の入る方、大海までの、このもろもろの残っている国々と、すでにわたしが滅ぼし去ったすべての国々を、くじをもって、あなたがたに分け与え、あなたがたの各部族の嗣業とさせた。"},{"ref":"Josh.23.5","start":6023005,"end":6023005,"break":"none","ruby":[[6,1,"まえ"],[12,2,"こくみん"],[15,1,"う"],[17,1,"はら"],[26,1,"め"],[28,1,"まえ"],[31,1,"お"],[33,1,"はら"],[46,1,"かみ"],[48,1,"しゅ"],[62,1,"かみ"],[64,1,"しゅ"],[66,2,"やくそく"],[81,1,"かれ"],[84,1,"ち"],[86,1,"え"]],"text":"あなたがたの前から、その国民を打ち払い、あなたがたの目の前から追い払われるのは、あなたがたの神、主である。そしてあなたがたの神、主が約束されたように、あなたがたは彼らの地を獲るであろう。"},{"ref":"Josh.23.6","start":6023006,"end":6023006,"break":"none","ruby":[[11,1,"かた"],[13,1,"た"],[21,2,"りっぽう"],[24,1,"しょ"],[42,1,"まも"],[45,1,"おこな"],[59,1,"はな"],[62,1,"みぎ"],[65,1,"ひだり"],[68,1,"まが"]],"text":"それゆえ、あなたがたは堅く立って、モーセの律法の書にしるされていることを、ことごとく守って行わなければならない。それを離れて右にも左にも曲ってはならない。"},{"ref":"Josh.23.7","start":6023007,"end":6023007,"break":"none","ruby":[[9,1,"のこ"],[19,2,"こくみん"],[22,1,"ま"],[32,1,"かれ"],[35,2,"かみがみ"],[38,1,"な"],[40,1,"とな"],[55,1,"ちか"],[69,1,"つか"],[75,1,"おが"]],"text":"あなたがたのうちに残っている、これらの国民と交じってはならない。彼らの神々の名を唱えてはならない。それをさして誓ってはならない。またそれに仕え、それを拝んではならない。"},{"ref":"Josh.23.8","start":6023008,"end":6023008,"break":"none","ruby":[[3,2,"こんにち"],[21,1,"かみ"],[23,1,"しゅ"],[27,1,"したが"]],"text":"ただ、今日までしてきたように、あなたがたの神、主につき従わなければならない。"},{"ref":"Josh.23.9","start":6023009,"end":6023009,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"おお"],[6,1,"つよ"],[8,2,"こくみん"],[18,1,"まえ"],[21,1,"お"],[23,1,"はら"],[35,2,"こんにち"],[40,1,"た"],[42,1,"む"],[51,1,"もの"]],"text":"主が大いなる強き国民を、あなたがたの前から追い払われた。あなたがたには今日まで、立ち向かうことのできる者は、ひとりもなかった。"},{"ref":"Josh.23.10","start":6023010,"end":6023010,"break":"none","ruby":[[12,1,"にん"],[14,1,"お"],[16,1,"はら"],[35,1,"かみ"],[37,1,"しゅ"],[39,2,"やくそく"],[61,1,"たたか"]],"text":"あなたがたのひとりは、千人を追い払うことができるであろう。あなたがたの神、主が約束されたように、みずからあなたがたのために戦われるからである。"},{"ref":"Josh.23.11","start":6023011,"end":6023011,"break":"none","ruby":[[11,1,"ふか"],[13,1,"つつし"],[23,1,"かみ"],[25,1,"しゅ"],[27,1,"あい"]],"text":"それゆえ、あなたがたは深く慎んで、あなたがたの神、主を愛さなければならない。"},{"ref":"Josh.23.12","start":6023012,"end":6023012,"break":"none","ruby":[[23,2,"こくみん"],[27,1,"い"],[29,1,"のこ"],[39,1,"なか"],[45,1,"もの"],[49,1,"した"],[58,2,"こんいん"]],"text":"しかし、あなたがたがもしひるがえって、これらの国民の、生き残って、あなたがたの中にとどまる者どもと親しくなり、これと婚姻し、ゆききするならば、"},{"ref":"Josh.23.13","start":6023013,"end":6023013,"break":"none","ruby":[[10,1,"し"],[27,1,"かみ"],[29,1,"しゅ"],[40,2,"こくみん"],[49,1,"まえ"],[53,1,"お"],[55,1,"はら"],[69,1,"かれ"],[90,1,"あみ"],[117,1,"め"],[143,1,"かみ"],[145,1,"しゅ"],[147,1,"たま"],[153,1,"よ"],[155,1,"ち"],[159,1,"ほろ"]],"text":"あなたがたは、しかと知らなければならない。あなたがたの神、主は、もはや、これらの国民をあなたがたの前から、追い払うことをされないであろう。彼らは、かえって、あなたがたのわなとなり、網となり、あなたがたのわきに、むちとなり、あなたがたの目に、とげとなって、あなたがたはついに、あなたがたの神、主が賜わったこの良い地から、滅びうせるであろう。"},{"ref":"Josh.23.14","start":6023014,"end":6023014,"break":"paragraph","ruby":[[0,1,"み"],[3,2,"こんにち"],[10,1,"よ"],[12,1,"ひと"],[16,1,"い"],[18,1,"みち"],[20,1,"い"],[36,1,"こころ"],[44,1,"きも"],[46,1,"めい"],[49,1,"し"],[64,1,"かみ"],[66,1,"しゅ"],[78,2,"やくそく"],[88,1,"よ"],[97,1,"か"],[116,1,"のぞ"],[123,1,"か"]],"text":"見よ、今日、わたしは世の人のみな行く道を行こうとする。あなたがたがみな、心のうちにまた、肝に銘じて知っているように、あなたがたの神、主が、あなたがたについて約束されたもろもろの良いことで、一つも欠けたものはなかった。みなあなたがたに臨んで、一つも欠けたものはなかった。"},{"ref":"Josh.23.15","start":6023015,"end":6023015,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[23,2,"やくそく"],[34,1,"よ"],[46,1,"のぞ"],[53,1,"しゅ"],[63,1,"わる"],[74,1,"くだ"],[84,1,"かみ"],[86,1,"しゅ"],[88,1,"たま"],[94,1,"よ"],[96,1,"ち"],[110,1,"ほろ"],[113,1,"た"]],"text":"しかし、あなたがたの神、主があなたがたについて約束された、もろもろの良いことが、あなたがたに臨んだように、主はまた、もろもろの悪いことをあなたがたに下して、あなたがたの神、主が賜わったこの良い地から、ついに、あなたがたを滅ぼし断たれるであろう。"},{"ref":"Josh.23.16","start":6023016,"end":6023016,"break":"none","ruby":[[9,1,"かみ"],[11,1,"しゅ"],[13,1,"めい"],[20,2,"けいやく"],[23,1,"おか"],[26,1,"い"],[29,1,"た"],[31,2,"かみがみ"],[34,1,"つか"],[40,1,"おが"],[46,1,"しゅ"],[58,1,"いか"],[61,1,"はっ"],[71,1,"しゅ"],[73,1,"たま"],[77,1,"よ"],[79,1,"ち"],[88,1,"ほろ"]],"text":"もし、あなたがたの神、主が命じられたその契約を犯し、行って他の神々に仕え、それを拝むならば、主はあなたがたにむかって怒りを発し、あなたがたは、主が賜わった良い地から、すみやかに滅びうせるであろう」。"}]