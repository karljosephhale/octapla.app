[{"ref":"Num.18.1","start":4018001,"end":4018001,"break":"paragraph","ruby":[[4,1,"しゅ"],[10,1,"い"],[24,1,"こ"],[35,2,"ふそ"],[38,1,"いえ"],[40,1,"もの"],[43,2,"せいじょ"],[46,1,"かん"],[49,1,"つみ"],[51,1,"お"],[73,1,"こ"],[79,2,"さいし"],[81,1,"しょく"],[83,1,"かん"],[86,1,"つみ"],[88,1,"お"]],"text":"そこで、主はアロンに言われた、「あなたとあなたの子たち、およびあなたの父祖の家の者は、聖所に関する罪を負わなければならない。また、あなたとあなたの子たちとは、祭司職に関する罪を負わなければならない。"},{"ref":"Num.18.2","start":4018002,"end":4018002,"break":"none","ruby":[[11,2,"きょうだい"],[18,2,"ぶぞく"],[21,1,"もの"],[32,2,"ふそ"],[35,2,"ぶぞく"],[38,1,"もの"],[47,1,"ちか"],[56,1,"つら"],[64,1,"つか"],[89,1,"こ"],[95,1,"とも"],[101,2,"まくや"],[104,1,"まえ"],[106,1,"つか"]],"text":"あなたはまた、あなたの兄弟なるレビの部族の者、すなわち、あなたの父祖の部族の者どもを、あなたに近づかせ、あなたに連なり、あなたに仕えさせなければならない。ただし、あなたとあなたの子たちとは、共にあかしの幕屋の前で仕えなければならない。"},{"ref":"Num.18.3","start":4018003,"end":4018003,"break":"none","ruby":[[0,1,"かれ"],[8,1,"つとめ"],[15,2,"まくや"],[18,1,"つとめ"],[21,1,"まも"],[36,2,"せいじょ"],[39,1,"うつわ"],[42,2,"さいだん"],[46,1,"ちか"],[56,1,"かれ"],[66,1,"し"]],"text":"彼らは、あなたの務と、すべての幕屋の務とを守らなければならない。ただし、聖所の器と、祭壇とに近づいてはならない。彼らもあなたがたも、死ぬことのないためである。"},{"ref":"Num.18.4","start":4018004,"end":4018004,"break":"none","ruby":[[0,1,"かれ"],[7,1,"つら"],[12,2,"かいけん"],[15,2,"まくや"],[18,1,"つとめ"],[20,1,"まも"],[23,2,"まくや"],[31,1,"はたら"],[47,1,"もの"],[56,1,"ちか"]],"text":"彼らはあなたに連なって、会見の幕屋の務を守り、幕屋のもろもろの働きをしなければならない。ほかの者は、あなたがたに近づいてはならない。"},{"ref":"Num.18.5","start":4018005,"end":4018005,"break":"none","ruby":[[13,2,"せいじょ"],[16,1,"つとめ"],[19,2,"さいだん"],[22,1,"つとめ"],[25,1,"まも"],[42,1,"しゅ"],[44,1,"はげ"],[47,1,"いか"],[61,2,"ひとびと"],[64,1,"のぞ"]],"text":"このように、あなたがたは、聖所の務と、祭壇の務とを守らなければならない。そうすれば、主の激しい怒りは、かさねてイスラエルの人々に臨まないであろう。"},{"ref":"Num.18.6","start":4018006,"end":4018006,"break":"none","ruby":[[10,2,"きょうだい"],[26,2,"ひとびと"],[33,1,"と"],[36,1,"しゅ"],[45,2,"たまもの"],[57,1,"あた"],[60,2,"かいけん"],[63,2,"まくや"],[66,1,"はたら"]],"text":"わたしはあなたがたの兄弟たるレビびとを、イスラエルの人々のうちから取り、主のために、これを賜物として、あなたがたに与え、会見の幕屋の働きをさせる。"},{"ref":"Num.18.7","start":4018007,"end":4018007,"break":"none","ruby":[[8,1,"こ"],[12,1,"とも"],[14,2,"さいし"],[16,1,"しょく"],[18,1,"まも"],[22,2,"さいだん"],[26,2,"たれまく"],[36,1,"こと"],[38,1,"と"],[40,1,"おこな"],[43,1,"とも"],[45,1,"つと"],[60,2,"さいし"],[63,2,"しょくむ"],[66,2,"たまもの"],[78,1,"あた"],[85,1,"ひと"],[87,1,"ちか"],[90,1,"もの"],[92,1,"ころ"]],"text":"あなたとあなたの子たちは共に祭司職を守って、祭壇と、垂幕のうちのすべての事を執り行い、共に勤めなければならない。わたしは祭司の職務を賜物として、あなたがたに与える。ほかの人で近づく者は殺されるであろう」。"},{"ref":"Num.18.8","start":4018008,"end":4018008,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[24,2,"ひとびと"],[32,1,"せい"],[35,1,"そな"],[37,1,"もの"],[48,1,"もの"],[50,2,"いちぶ"],[57,1,"あた"],[82,1,"こ"],[89,1,"わ"],[91,1,"まえ"],[95,1,"あた"],[98,2,"えいきゅう"],[101,1,"う"],[105,1,"ぶん"]],"text":"主はまたアロンに言われた、「わたしはイスラエルの人々の、すべての聖なる供え物で、わたしにささげる物の一部をあなたに与える。すなわち、わたしはこれをあなたと、あなたの子たちに、その分け前として与え、永久に受くべき分とする。"},{"ref":"Num.18.9","start":4018009,"end":4018009,"break":"none","ruby":[[2,1,"せい"],[5,1,"そな"],[7,1,"もの"],[12,1,"ひ"],[14,1,"や"],[23,1,"き"],[30,1,"つぎ"],[56,1,"そな"],[58,1,"もの"],[60,2,"そさい"],[63,2,"ざいさい"],[66,2,"けんさい"],[74,1,"せい"],[77,1,"もの"],[91,1,"こ"],[95,1,"き"]],"text":"いと聖なる供え物のうち、火で焼かずに、あなたに帰すべきものは次のとおりである。すなわち、わたしにささげるすべての供え物、素祭、罪祭、愆祭はみな、いと聖なる物であって、あなたとあなたの子たちに帰するであろう。"},{"ref":"Num.18.10","start":4018010,"end":4018010,"break":"none","ruby":[[2,1,"せい"],[5,1,"ところ"],[11,1,"た"],[22,2,"だんし"],[31,1,"た"],[48,1,"き"],[52,1,"せい"],[55,1,"もの"]],"text":"いと聖なる所で、それを食べなければならない。男子はみな、それを食べることができる。それはあなたに帰すべき聖なる物である。"},{"ref":"Num.18.11","start":4018011,"end":4018011,"break":"none","ruby":[[6,1,"き"],[30,2,"ひとびと"],[37,1,"そな"],[39,1,"もの"],[47,2,"ようさい"],[73,1,"むすめ"],[75,1,"あた"],[79,2,"えいきゅう"],[82,1,"う"],[86,1,"ぶん"],[95,1,"いえ"],[97,1,"もの"],[102,1,"きよ"],[104,1,"もの"],[112,1,"た"]],"text":"またあなたに帰すべきものはこれである。すなわち、イスラエルの人々のささげる供え物のうち、すべて揺祭とするものであって、これをあなたとあなたのむすこ娘に与えて、永久に受くべき分とする。あなたの家の者のうち、清い者はみな、これを食べることができる。"},{"ref":"Num.18.12","start":4018012,"end":4018012,"break":"none","ruby":[[3,1,"あぶら"],[5,1,"もっと"],[9,1,"もの"],[17,1,"あたら"],[23,1,"しゅ"],[26,2,"こくもつ"],[29,1,"もっと"],[31,1,"よ"],[33,1,"もの"],[37,2,"ひとびと"],[40,1,"しゅ"],[46,2,"はつほ"],[53,1,"あた"]],"text":"すべて油の最もよい物、およびすべて新しいぶどう酒と、穀物の最も良い物など、人々が主にささげる初穂をあなたに与える。"},{"ref":"Num.18.13","start":4018013,"end":4018013,"break":"none","ruby":[[0,1,"くに"],[6,2,"さんぶつ"],[9,2,"はつもの"],[13,2,"ひとびと"],[16,1,"しゅ"],[21,1,"たずさ"],[34,1,"き"],[46,1,"いえ"],[48,1,"もの"],[53,1,"きよ"],[55,1,"もの"],[63,1,"た"]],"text":"国のすべての産物の初物で、人々が主のもとに携えてきたものは、あなたに帰するであろう。あなたの家の者のうち、清い者はみな、これを食べることができる。"},{"ref":"Num.18.14","start":4018014,"end":4018014,"break":"none","ruby":[[9,3,"ほうのうぶつ"],[20,1,"き"]],"text":"イスラエルのうちの奉納物はみな、あなたに帰する。"},{"ref":"Num.18.15","start":4018015,"end":4018015,"break":"none","ruby":[[3,1,"にく"],[6,1,"もの"],[16,1,"しゅ"],[24,1,"もの"],[29,1,"ひと"],[32,1,"けもの"],[40,1,"き"],[48,1,"ひと"],[54,1,"かなら"],[71,1,"けが"],[74,1,"けもの"]],"text":"すべて肉なる者のういごであって、主にささげられる者はみな、人でも獣でも、あなたに帰する。ただし、人のういごは必ずあがなわなければならない。また汚れた獣のういごも、あがなわなければならない。"},{"ref":"Num.18.16","start":4018016,"end":4018016,"break":"none","ruby":[[0,1,"ひと"],[6,2,"せいご"],[10,1,"げつ"],[32,1,"きん"],[38,1,"ね"],[39,1,"づも"],[45,2,"せいじょ"],[58,1,"ぎん"]],"text":"人のういごは生後一か月で、あがなわなければならない。そのあがない金はあなたの値積りにより、聖所のシケルにしたがって、銀五シケルでなければならない。一シケルは二十ゲラである。"},{"ref":"Num.18.17","start":4018017,"end":4018017,"break":"none","ruby":[[4,1,"うし"],[10,1,"ひつじ"],[39,1,"せい"],[50,1,"ち"],[52,2,"さいだん"],[55,1,"そそ"],[62,2,"しぼう"],[65,1,"や"],[68,2,"かさい"],[73,1,"こう"],[84,1,"しゅ"]],"text":"しかし、牛のういご、羊のういご、やぎのういごは、あがなってはならない。これらは聖なるものである。その血を祭壇に注ぎかけ、その脂肪を焼いて火祭とし、香ばしいかおりとして、主にささげなければならない。"},{"ref":"Num.18.18","start":4018018,"end":4018018,"break":"none","ruby":[[2,1,"にく"],[8,1,"き"],[15,2,"ようさい"],[18,1,"むね"],[20,1,"みぎ"],[25,1,"おな"],[33,1,"き"]],"text":"その肉はあなたに帰する。それは揺祭の胸や右のももと同じく、あなたに帰する。"},{"ref":"Num.18.19","start":4018019,"end":4018019,"break":"none","ruby":[[6,2,"ひとびと"],[10,1,"しゅ"],[16,1,"せい"],[19,1,"そな"],[21,1,"もの"],[37,1,"むすめ"],[40,1,"あた"],[44,2,"えいきゅう"],[47,1,"う"],[50,1,"ぶん"],[58,1,"しゅ"],[60,1,"まえ"],[74,2,"しそん"],[78,1,"たい"],[81,2,"えいえん"],[84,1,"かわ"],[87,1,"しお"],[89,2,"けいやく"]],"text":"イスラエルの人々が、主にささげる聖なる供え物はみな、あなたとあなたのむすこ娘とに与えて、永久に受ける分とする。これは主の前にあって、あなたとあなたの子孫とに対し、永遠に変らぬ塩の契約である」。"},{"ref":"Num.18.20","start":4018020,"end":4018020,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"い"],[24,2,"ひとびと"],[27,1,"ち"],[33,1,"し"],[34,1,"ぎょう"],[47,1,"かれ"],[54,1,"なに"],[56,1,"ぶん"],[59,1,"も"],[68,1,"かれ"],[86,1,"ぶん"],[95,1,"し"],[96,1,"ぎょう"]],"text":"主はまたアロンに言われた、「あなたはイスラエルの人々の地のうちに、嗣業をもってはならない。また彼らのうちに、何の分をも持ってはならない。彼らのうちにあって、わたしがあなたの分であり、あなたの嗣業である。"},{"ref":"Num.18.21","start":4018021,"end":4018021,"break":"paragraph","ruby":[[7,2,"しそん"],[25,1,"ぶん"],[29,1,"し"],[30,1,"ぎょう"],[34,1,"あた"],[39,1,"はたら"],[47,2,"かいけん"],[50,2,"まくや"],[53,1,"はたら"],[56,1,"むく"]],"text":"わたしはレビの子孫にはイスラエルにおいて、すべて十分の一を嗣業として与え、その働き、すなわち、会見の幕屋の働きに報いる。"},{"ref":"Num.18.22","start":4018022,"end":4018022,"break":"none","ruby":[[6,2,"ひとびと"],[14,2,"かいけん"],[17,2,"まくや"],[20,1,"ちか"],[30,1,"つみ"],[32,1,"え"],[34,1,"し"]],"text":"イスラエルの人々は、かさねて会見の幕屋に近づいてはならない。罪を得て死なないためである。"},{"ref":"Num.18.23","start":4018023,"end":4018023,"break":"none","ruby":[[7,2,"かいけん"],[10,2,"まくや"],[13,1,"はたら"],[26,1,"かれ"],[31,1,"つみ"],[33,1,"お"],[40,1,"かれ"],[49,2,"ひとびと"],[56,1,"し"],[57,1,"ぎょう"],[59,1,"ち"],[61,1,"も"],[78,2,"よよ"],[83,1,"まも"],[87,1,"さだ"]],"text":"レビびとだけが会見の幕屋の働きをしなければならない。彼らがその罪を負うであろう。彼らがイスラエルの人々のうちに、嗣業の地を持たないことをもって、あなたがたの代々ながく守るべき定めとしなければならない。"},{"ref":"Num.18.24","start":4018024,"end":4018024,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"そな"],[15,1,"もの"],[19,1,"しゅ"],[26,1,"ぶん"],[36,1,"し"],[37,1,"ぎょう"],[41,1,"あた"],[49,1,"かれ"],[58,2,"ひとびと"],[65,1,"し"],[66,1,"ぎょう"],[68,1,"ち"],[70,1,"も"],[85,1,"かれ"],[88,1,"い"]],"text":"わたしはイスラエルの人々が供え物として主にささげる十分の一を、レビびとに嗣業として与えた。それで『彼らはイスラエルの人々のうちに、嗣業の地を持ってはならない』と、わたしは彼らに言ったのである」。"},{"ref":"Num.18.25","start":4018025,"end":4018025,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.18.26","start":4018026,"end":4018026,"break":"none","ruby":[[6,1,"い"],[23,2,"ひとびと"],[27,1,"と"],[31,1,"し"],[32,1,"ぎょう"],[36,1,"あた"],[40,1,"ぶん"],[44,1,"う"],[47,1,"とき"],[58,1,"ぶん"],[63,1,"ぶん"],[68,1,"しゅ"]],"text":"「レビびとに言いなさい、『わたしがイスラエルの人々から取って、嗣業として与える十分の一を受ける時、あなたがたはその十分の一の十分の一を、主にささげなければならない。"},{"ref":"Num.18.27","start":4018027,"end":4018027,"break":"none","ruby":[[9,1,"もの"],[12,1,"う"],[14,1,"ば"],[18,2,"こくもつ"],[22,1,"さか"],[31,1,"しゅ"],[33,1,"おな"],[38,1,"み"]],"text":"あなたがたのささげ物は、打ち場からの穀物や、酒ぶねからのぶどう酒と同じように見なされるであろう。"},{"ref":"Num.18.28","start":4018028,"end":4018028,"break":"none","ruby":[[20,2,"ひとびと"],[24,1,"う"],[32,1,"ぶん"],[36,1,"もの"],[43,1,"しゅ"],[45,1,"そな"],[47,1,"もの"],[53,1,"しゅ"],[61,1,"そな"],[63,1,"もの"],[66,2,"さいし"],[72,1,"あた"]],"text":"そのようにあなたがたもまた、イスラエルの人々から受けるすべての十分の一の物のうちから、主に供え物をささげ、主にささげたその供え物を、祭司アロンに与えなければならない。"},{"ref":"Num.18.29","start":4018029,"end":4018029,"break":"none","ruby":[[6,1,"う"],[14,1,"もの"],[23,1,"よ"],[34,1,"せい"],[37,2,"ぶぶん"],[40,1,"と"],[49,1,"そな"],[51,1,"もの"],[56,1,"しゅ"]],"text":"あなたがたの受けるすべての贈物のうちから、その良いところ、すなわち、聖なる部分を取って、ことごとく供え物として、主にささげなければならない』。"},{"ref":"Num.18.30","start":4018030,"end":4018030,"break":"none","ruby":[[6,1,"かれ"],[9,1,"い"],[29,1,"よ"],[35,1,"と"],[42,1,"とき"],[46,1,"のこ"],[49,2,"ぶぶん"],[59,1,"う"],[61,1,"ば"],[63,2,"さんぶつ"],[67,1,"さか"],[71,2,"さんぶつ"],[74,1,"おな"],[79,1,"み"]],"text":"あなたはまた彼らに言いなさい、『あなたがたが、そのうちから良いところを取ってささげる時、その残りの部分はレビびとには、打ち場の産物や、酒ぶねの産物と同じように見なされるであろう。"},{"ref":"Num.18.31","start":4018031,"end":4018031,"break":"none","ruby":[[13,2,"かぞく"],[24,1,"た"],[34,2,"かいけん"],[37,2,"まくや"],[48,1,"はたら"],[51,2,"ほうしゅう"]],"text":"あなたがたと、あなたがたの家族とは、どこでそれを食べてもよい。これは会見の幕屋であなたがたがする働きの報酬である。"},{"ref":"Num.18.32","start":4018032,"end":4018032,"break":"none","ruby":[[9,1,"よ"],[36,1,"つみ"],[38,1,"お"],[59,2,"ひとびと"],[62,1,"せい"],[65,1,"そな"],[67,1,"もの"],[69,1,"けが"],[78,1,"し"]],"text":"あなたがたが、その良いところをささげるときは、それによって、あなたがたは罪を負わないであろう。あなたがたはイスラエルの人々の聖なる供え物を汚してはならない。死をまぬかれるためである』」。"}]