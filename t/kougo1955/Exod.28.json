[{"ref":"Exod.28.1","start":2028001,"end":2028001,"break":"paragraph","ruby":[[8,2,"ひとびと"],[20,2,"きょうだい"],[28,1,"こ"],[44,1,"こ"],[76,2,"さいし"],[85,1,"つか"]],"text":"またイスラエルの人々のうちから、あなたの兄弟アロンとその子たち、すなわちアロンとアロンの子ナダブ、アビウ、エレアザル、イタマルとをあなたのもとにこさせ、祭司としてわたしに仕えさせ、"},{"ref":"Exod.28.2","start":2028002,"end":2028002,"break":"none","ruby":[[6,2,"きょうだい"],[15,1,"せい"],[18,2,"いふく"],[21,1,"つく"],[25,1,"かれ"],[27,1,"さか"],[30,1,"うるわ"]],"text":"またあなたの兄弟アロンのために聖なる衣服を作って、彼に栄えと麗しきをもたせなければならない。"},{"ref":"Exod.28.3","start":2028003,"end":2028003,"break":"none","ruby":[[7,1,"こころ"],[9,2,"ちえ"],[13,1,"もの"],[24,2,"ちえ"],[27,1,"れい"],[29,1,"み"],[33,1,"もの"],[37,1,"かた"],[45,2,"いふく"],[48,1,"つく"],[56,2,"せいべつ"],[60,2,"さいし"],[69,1,"つか"]],"text":"あなたはすべて心に知恵ある者、すなわち、わたしが知恵の霊を満たした者たちに語って、アロンの衣服を作らせ、アロンを聖別し、祭司としてわたしに仕えさせなければならない。"},{"ref":"Exod.28.4","start":2028004,"end":2028004,"break":"none","ruby":[[0,1,"かれ"],[3,1,"つく"],[7,2,"いふく"],[10,1,"つぎ"],[23,2,"むねあて"],[30,1,"ころも"],[32,2,"いちまつ"],[34,2,"もよう"],[37,1,"ふく"],[39,2,"ぼうし"],[42,1,"おび"],[47,1,"かれ"],[54,2,"きょうだい"],[62,1,"こ"],[70,1,"せい"],[73,2,"いふく"],[76,1,"つく"],[79,2,"さいし"],[88,1,"つか"]],"text":"彼らの作るべき衣服は次のとおりである。すなわち胸当、エポデ、衣、市松模様の服、帽子、帯である。彼らはあなたの兄弟アロンとその子たちとのために聖なる衣服を作り、祭司としてわたしに仕えさせなければならない。"},{"ref":"Exod.28.5","start":2028005,"end":2028005,"break":"paragraph","ruby":[[0,1,"かれ"],[3,2,"きんし"],[6,1,"あお"],[7,1,"いと"],[9,1,"むらさき"],[10,1,"いと"],[12,1,"ひ"],[13,1,"いと"],[15,2,"あま"],[18,2,"ねんし"],[21,1,"う"],[23,1,"と"]],"text":"彼らは金糸、青糸、紫糸、緋糸、亜麻の撚糸を受け取らなければならない。"},{"ref":"Exod.28.6","start":2028006,"end":2028006,"break":"none","ruby":[[3,1,"かれ"],[6,2,"きんし"],[9,1,"あお"],[10,1,"いと"],[12,1,"むらさき"],[13,1,"いと"],[15,1,"ひ"],[16,1,"いと"],[18,2,"あま"],[21,2,"ねんし"],[24,1,"もち"],[27,1,"たく"],[40,1,"つく"]],"text":"そして彼らは金糸、青糸、紫糸、緋糸、亜麻の撚糸を用い、巧みなわざをもってエポデを作らなければならない。"},{"ref":"Exod.28.7","start":2028007,"end":2028007,"break":"none","ruby":[[6,1,"かた"],[10,1,"つ"],[15,2,"りょうはし"],[22,1,"つ"]],"text":"これに二つの肩ひもを付け、その両端を、これに付けなければならない。"},{"ref":"Exod.28.8","start":2028008,"end":2028008,"break":"none","ruby":[[4,1,"うえ"],[14,1,"おび"],[17,1,"おな"],[26,1,"つく"],[33,2,"きんし"],[36,1,"あお"],[37,1,"いと"],[39,1,"むらさき"],[40,1,"いと"],[42,1,"ひ"],[43,1,"いと"],[45,2,"あま"],[48,2,"ねんし"],[51,1,"つく"]],"text":"エポデの上で、これをつかねる帯は、同じきれでエポデの作りのように、金糸、青糸、紫糸、緋糸、亜麻の撚糸で作らなければならない。"},{"ref":"Exod.28.9","start":2028009,"end":2028009,"break":"none","ruby":[[7,1,"しま"],[12,1,"と"],[18,1,"うえ"],[26,1,"こ"],[30,1,"な"],[32,1,"きざ"]],"text":"あなたは二つの縞めのうを取って、その上にイスラエルの子たちの名を刻まなければならない。"},{"ref":"Exod.28.10","start":2028010,"end":2028010,"break":"none","ruby":[[7,1,"な"],[14,1,"いし"],[17,1,"のこ"],[20,1,"な"],[24,1,"た"],[26,1,"いし"],[29,1,"かれ"],[32,1,"うま"],[35,1,"じゅん"],[37,1,"きざ"]],"text":"すなわち、その名六つを一つの石に、残りの名六つを他の石に、彼らの生れた順に刻まなければならない。"},{"ref":"Exod.28.11","start":2028011,"end":2028011,"break":"none","ruby":[[0,2,"ほうせき"],[3,2,"ちょうこく"],[7,1,"ひと"],[9,1,"いん"],[11,2,"ちょうこく"],[25,1,"こ"],[29,1,"な"],[36,1,"いし"],[38,1,"きざ"],[44,1,"きん"],[46,1,"あみ"],[47,2,"ざいく"]],"text":"宝石に彫刻する人が印を彫刻するように、イスラエルの子たちの名をその二つの石に刻み、それを金の編細工にはめ、"},{"ref":"Exod.28.12","start":2028012,"end":2028012,"break":"none","ruby":[[5,1,"いし"],[11,1,"かた"],[25,1,"こ"],[29,2,"きねん"],[32,1,"いし"],[52,1,"しゅ"],[54,1,"まえ"],[58,1,"りょう"],[59,1,"かた"],[61,1,"かれ"],[64,1,"な"],[66,1,"お"],[69,2,"きねん"]],"text":"この二つの石をエポデの肩ひもにつけて、イスラエルの子たちの記念の石としなければならない。こうしてアロンは主の前でその両肩に彼らの名を負うて記念としなければならない。"},{"ref":"Exod.28.13","start":2028013,"end":2028013,"break":"none","ruby":[[6,1,"きん"],[8,1,"あみ"],[9,2,"ざいく"],[12,1,"つく"]],"text":"あなたはまた金の編細工を作らなければならない。"},{"ref":"Exod.28.14","start":2028014,"end":2028014,"break":"none","ruby":[[6,2,"じゅんきん"],[9,1,"くさり"],[14,2,"ざいく"],[20,1,"つく"],[28,1,"くさり"],[32,1,"あみ"],[33,2,"ざいく"]],"text":"そして二つの純金の鎖を、ひも細工にねじて作り、そのひもの鎖をかの編細工につけなければならない。"},{"ref":"Exod.28.15","start":2028015,"end":2028015,"break":"paragraph","ruby":[[10,2,"むねあて"],[13,1,"たく"],[22,1,"つく"],[32,1,"つく"],[38,1,"つく"],[53,2,"きんし"],[56,1,"あお"],[57,1,"いと"],[59,1,"むらさき"],[60,1,"いと"],[62,1,"ひ"],[63,1,"いと"],[65,2,"あま"],[68,2,"ねんし"],[75,1,"つく"]],"text":"あなたはまたさばきの胸当を巧みなわざをもって作り、これをエポデの作りのように作らなければならない。すなわち金糸、青糸、紫糸、緋糸、亜麻の撚糸で、これを作らなければならない。"},{"ref":"Exod.28.16","start":2028016,"end":2028016,"break":"none","ruby":[[6,1,"お"],[10,1,"かく"],[14,1,"なが"],[18,1,"ゆび"],[19,1,"あた"],[22,1,"はば"],[25,1,"ゆび"],[26,1,"あた"]],"text":"これは二つに折って四角にし、長さは一指当り、幅も一指当りとしなければならない。"},{"ref":"Exod.28.17","start":2028017,"end":2028017,"break":"none","ruby":[[4,1,"なか"],[6,2,"ほうせき"],[10,1,"れつ"],[14,1,"こ"],[29,1,"こう"],[30,2,"ぎょくずい"],[33,1,"き"],[38,1,"いし"],[40,2,"すいしょう"],[43,1,"れつ"],[45,1,"だい"],[47,1,"れつ"]],"text":"またその中に宝石を四列にはめ込まなければならない。すなわち紅玉髄、貴かんらん石、水晶の列を第一列とし、"},{"ref":"Exod.28.18","start":2028018,"end":2028018,"break":"none","ruby":[[0,1,"だい"],[1,1,"に"],[2,1,"れつ"],[8,1,"いし"],[13,1,"あか"],[14,1,"しま"]],"text":"第二列は、ざくろ石、るり、赤縞めのう。"},{"ref":"Exod.28.19","start":2028019,"end":2028019,"break":"none","ruby":[[0,1,"だい"],[2,1,"れつ"],[4,1,"き"],[5,2,"すいしょう"],[12,1,"むらさき"],[13,2,"すいしょう"]],"text":"第三列は黄水晶、めのう、紫水晶。"},{"ref":"Exod.28.20","start":2028020,"end":2028020,"break":"none","ruby":[[0,1,"だい"],[2,1,"れつ"],[4,1,"き"],[5,2,"へきぎょく"],[8,1,"しま"],[13,2,"へきぎょく"],[24,1,"きん"],[26,1,"あみ"],[27,2,"ざいく"],[30,1,"なか"],[34,1,"こ"]],"text":"第四列は黄碧玉、縞めのう、碧玉であって、これらを金の編細工の中にはめ込まなければならない。"},{"ref":"Exod.28.21","start":2028021,"end":2028021,"break":"none","ruby":[[2,2,"ほうせき"],[11,1,"こ"],[14,1,"な"],[16,1,"したが"],[21,1,"な"],[36,1,"いん"],[38,2,"ちょうこく"],[47,2,"ぶぞく"],[55,1,"な"],[57,1,"きざ"]],"text":"その宝石はイスラエルの子らの名に従い、その名とひとしく十二とし、おのおの印の彫刻のように十二の部族のためにその名を刻まなければならない。"},{"ref":"Exod.28.22","start":2028022,"end":2028022,"break":"none","ruby":[[4,2,"ざいく"],[10,2,"じゅんきん"],[13,1,"くさり"],[15,2,"むねあて"]],"text":"またひも細工にねじた純金の鎖を胸当につけなければならない。"},{"ref":"Exod.28.23","start":2028023,"end":2028023,"break":"none","ruby":[[3,2,"むねあて"],[9,1,"きん"],[11,1,"かん"],[15,1,"つく"],[18,2,"むねあて"],[21,2,"りょうはし"],[29,1,"かん"]],"text":"また、胸当のために金の環二つを作り、胸当の両端にその二つの環をつけ、"},{"ref":"Exod.28.24","start":2028024,"end":2028024,"break":"none","ruby":[[2,1,"に"],[3,1,"すじ"],[5,1,"きん"],[10,2,"むねあて"],[13,1,"はし"],[18,1,"かん"]],"text":"かの二筋の金のひもを胸当の端の二つの環につけなければならない。"},{"ref":"Exod.28.25","start":2028025,"end":2028025,"break":"none","ruby":[[6,1,"に"],[7,1,"すじ"],[12,1,"た"],[14,2,"りょうはし"],[22,1,"あみ"],[23,2,"ざいく"],[33,1,"かた"],[41,1,"まえ"]],"text":"ただし、その二筋のひもの他の両端をかの二つの編細工につけ、エポデの肩ひもにつけて、前にくるようにしなければならない。"},{"ref":"Exod.28.26","start":2028026,"end":2028026,"break":"none","ruby":[[9,1,"きん"],[11,1,"かん"],[13,1,"つく"],[20,2,"むねあて"],[23,2,"りょうはし"],[45,1,"せっ"],[48,2,"うちがわ"],[51,1,"ふち"]],"text":"あなたはまた二つの金の環を作って、これを胸当の両端につけなければならない。すなわちエポデに接する内側の縁にこれをつけなければならない。"},{"ref":"Exod.28.27","start":2028027,"end":2028027,"break":"none","ruby":[[5,1,"きん"],[7,1,"かん"],[9,1,"つく"],[23,1,"かた"],[27,1,"した"],[29,2,"ぶぶん"],[35,1,"まえ"],[37,1,"ほう"],[45,1,"め"],[47,1,"ちか"],[54,1,"おび"],[56,1,"うえ"],[58,1,"ほう"]],"text":"また二つの金の環を作って、これをエポデの二つの肩ひもの下の部分につけ、前の方で、そのつなぎ目に近く、エポデの帯の上の方にあるようにしなければならない。"},{"ref":"Exod.28.28","start":2028028,"end":2028028,"break":"none","ruby":[[0,2,"むねあて"],[3,1,"あお"],[13,1,"かん"],[19,1,"かん"],[21,1,"むす"],[30,1,"おび"],[32,1,"うえ"],[34,1,"ほう"],[55,2,"むねあて"],[63,1,"はな"]],"text":"胸当は青ひもをもって、その環をエポデの環に結びつけ、エポデの帯の上の方にあるようにしなければならない。こうして胸当がエポデから離れないようにしなければならない。"},{"ref":"Exod.28.29","start":2028029,"end":2028029,"break":"none","ruby":[[4,2,"せいじょ"],[10,1,"とき"],[17,2,"むねあて"],[28,1,"こ"],[32,1,"な"],[36,1,"むね"],[38,1,"お"],[41,1,"しゅ"],[43,1,"まえ"],[45,1,"つね"],[47,1,"おぼ"]],"text":"アロンが聖所にはいる時は、さばきの胸当にあるイスラエルの子たちの名をその胸に置き、主の前に常に覚えとしなければならない。"},{"ref":"Exod.28.30","start":2028030,"end":2028030,"break":"none","ruby":[[8,2,"むねあて"],[20,1,"い"],[28,1,"しゅ"],[30,1,"まえ"],[35,1,"とき"],[39,1,"むね"],[41,1,"うえ"],[66,1,"しゅ"],[68,1,"まえ"],[70,1,"つね"],[78,1,"こ"],[89,1,"むね"],[91,1,"お"]],"text":"あなたはさばきの胸当にウリムとトンミムを入れて、アロンが主の前にいたる時、その胸の上にあるようにしなければならない。こうしてアロンは主の前に常にイスラエルの子たちのさばきを、その胸に置かなければならない。"},{"ref":"Exod.28.31","start":2028031,"end":2028031,"break":"paragraph","ruby":[[11,1,"ぞく"],[14,2,"うわふく"],[20,2,"あおじ"],[23,1,"つく"]],"text":"あなたはまた、エポデに属する上服をすべて青地で作らなければならない。"},{"ref":"Exod.28.32","start":2028032,"end":2028032,"break":"none","ruby":[[0,1,"あたま"],[2,1,"とお"],[4,1,"くち"],[11,1,"なか"],[13,1,"もう"],[18,1,"くち"],[20,2,"しゅうい"],[35,2,"おりもの"],[38,1,"ふち"]],"text":"頭を通す口を、そのまん中に設け、その口の周囲には、よろいのえりのように織物の縁をつけて、ほころびないようにし、"},{"ref":"Exod.28.33","start":2028033,"end":2028033,"break":"none","ruby":[[6,1,"あお"],[7,1,"いと"],[9,1,"むらさき"],[10,1,"いと"],[12,1,"ひ"],[13,1,"いと"],[20,1,"つく"],[28,2,"しゅうい"],[36,2,"しゅうい"],[39,1,"きん"],[41,1,"すず"],[47,2,"あいだあいだ"]],"text":"そのすそには青糸、紫糸、緋糸で、ざくろを作り、そのすその周囲につけ、また周囲に金の鈴をざくろの間々につけなければならない。"},{"ref":"Exod.28.34","start":2028034,"end":2028034,"break":"none","ruby":[[4,1,"きん"],[6,1,"すず"],[14,1,"きん"],[16,1,"すず"],[23,2,"うわふく"],[29,2,"しゅうい"]],"text":"すなわち金の鈴にざくろ、また金の鈴にざくろと、上服のすその周囲につけなければならない。"},{"ref":"Exod.28.35","start":2028035,"end":2028035,"break":"none","ruby":[[4,1,"つとめ"],[6,1,"とき"],[11,1,"き"],[21,1,"かれ"],[23,2,"せいじょ"],[30,1,"しゅ"],[32,1,"まえ"],[37,1,"とき"],[41,1,"で"],[43,1,"とき"],[47,1,"おと"],[49,1,"きこ"],[53,1,"かれ"],[55,1,"し"],[57,1,"まぬか"]],"text":"アロンは務の時、これを着なければならない。彼が聖所にはいって主の前にいたる時、また出る時、その音が聞えて、彼は死を免れるであろう。"},{"ref":"Exod.28.36","start":2028036,"end":2028036,"break":"paragraph","ruby":[[6,2,"じゅんきん"],[9,1,"いた"],[11,1,"つく"],[14,1,"いん"],[16,2,"ちょうこく"],[25,1,"うえ"],[28,1,"しゅ"],[30,1,"せい"],[33,1,"もの"],[36,1,"きざ"]],"text":"あなたはまた純金の板を造り、印の彫刻のように、その上に『主に聖なる者』と刻み、"},{"ref":"Exod.28.37","start":2028037,"end":2028037,"break":"none","ruby":[[3,1,"あお"],[7,2,"ぼうし"],[10,1,"つ"],[16,2,"ぼうし"],[19,1,"まえ"],[21,1,"ほう"],[23,1,"く"]],"text":"これを青ひもで帽子に付け、それが帽子の前の方に来るようにしなければならない。"},{"ref":"Exod.28.38","start":2028038,"end":2028038,"break":"none","ruby":[[7,1,"ひたい"],[25,2,"ひとびと"],[32,1,"せい"],[35,1,"もの"],[41,1,"かれ"],[49,1,"せい"],[52,1,"そな"],[54,1,"もの"],[60,1,"つみ"],[62,1,"せ"],[65,1,"お"],[75,1,"しゅ"],[77,1,"まえ"],[83,1,"う"],[93,1,"つね"],[99,1,"ひたい"]],"text":"これはアロンの額にあり、そしてアロンはイスラエルの人々がささげる聖なる物、すなわち彼らのもろもろの聖なる供え物についての罪の責めを負うであろう。これは主の前にそれらの受けいれられるため、常にアロンの額になければならない。"},{"ref":"Exod.28.39","start":2028039,"end":2028039,"break":"paragraph","ruby":[[4,2,"あま"],[6,1,"いと"],[8,2,"いちまつ"],[10,2,"もよう"],[13,1,"した"],[14,1,"ふく"],[16,1,"お"],[19,2,"あま"],[21,1,"ぬの"],[28,1,"つく"],[34,1,"おび"],[36,1,"いろ"],[42,1,"お"],[45,1,"つく"]],"text":"あなたは亜麻糸で市松模様に下服を織り、亜麻布で、ずきんを作り、また、帯を色とりどりに織って作らなければならない。"},{"ref":"Exod.28.40","start":2028040,"end":2028040,"break":"paragraph","ruby":[[10,1,"こ"],[17,1,"した"],[18,1,"ふく"],[20,1,"つく"],[23,1,"かれ"],[29,1,"おび"],[31,1,"つく"],[34,1,"かれ"],[45,1,"つく"],[49,1,"かれ"],[52,1,"さか"],[55,1,"うるわ"]],"text":"あなたはまたアロンの子たちのために下服を作り、彼らのために帯を作り、彼らのために、ずきんを作って、彼らに栄えと麗しきをもたせなければならない。"},{"ref":"Exod.28.41","start":2028041,"end":2028041,"break":"none","ruby":[[14,2,"きょうだい"],[22,1,"かれ"],[24,1,"とも"],[30,1,"こ"],[34,1,"き"],[37,1,"かれ"],[40,1,"あぶら"],[42,1,"そそ"],[45,1,"かれ"],[48,1,"しょく"],[50,1,"にん"],[53,1,"かれ"],[56,2,"せいべつ"],[60,2,"さいし"],[70,1,"つか"]],"text":"そしてあなたはこれをあなたの兄弟アロンおよび彼と共にいるその子たちに着せ、彼らに油を注ぎ、彼らを職に任じ、彼らを聖別し、祭司として、わたしに仕えさせなければならない。"},{"ref":"Exod.28.42","start":2028042,"end":2028042,"break":"none","ruby":[[3,1,"かれ"],[12,1,"かく"],[14,1,"ところ"],[19,2,"あま"],[21,1,"ぬの"],[28,1,"つく"],[31,1,"こし"],[37,1,"とど"]],"text":"また、彼らのために、その隠し所をおおう亜麻布のしたばきを作り、腰からももに届くようにしなければならない。"},{"ref":"Exod.28.43","start":2028043,"end":2028043,"break":"none","ruby":[[6,1,"こ"],[10,2,"かいけん"],[13,2,"まくや"],[19,1,"とき"],[25,2,"せいじょ"],[28,1,"つとめ"],[35,2,"さいだん"],[38,1,"ちか"],[41,1,"とき"],[47,1,"き"],[63,1,"かれ"],[66,1,"つみ"],[68,1,"え"],[70,1,"し"],[85,1,"かれ"],[87,1,"かれ"],[89,1,"のち"],[91,2,"しそん"],[98,2,"えいきゅう"],[101,1,"さだ"]],"text":"アロンとその子たちは会見の幕屋にはいる時、あるいは聖所で務をするために祭壇に近づく時に、これを着なければならない。そうすれば、彼らは罪を得て死ぬことはないであろう。これは彼と彼の後の子孫とのための永久の定めでなければならない。"}]