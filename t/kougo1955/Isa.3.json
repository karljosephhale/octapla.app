[{"ref":"Isa.3.1","start":23003001,"end":23003001,"break":"paragraph","breaks":[[10,"line"],[20,"line"],[36,"line"],[48,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,2,"ばんぐん"],[8,1,"しゅ"],[27,1,"たの"],[57,1,"みず"],[61,1,"と"],[63,1,"さ"]],"text":"見よ、主、万軍の主はエルサレムとユダからささえとなり、頼みとなるもの――すべてささえとなるパン、すべてささえとなる水――を取り去られる。"},{"ref":"Isa.3.2","start":23003002,"end":23003002,"break":"line","breaks":[[10,"line"],[18,"line"]],"ruby":[[4,2,"ゆうし"],[7,2,"ぐんじん"],[10,3,"さいばんかん"],[14,3,"よげんしゃ"],[18,1,"うらな"],[20,1,"し"],[22,2,"ちょうろう"]],"text":"すなわち勇士と軍人、裁判官と預言者、占い師と長老、"},{"ref":"Isa.3.3","start":23003003,"end":23003003,"break":"line","breaks":[[13,"line"],[23,"line"]],"ruby":[[2,1,"にん"],[4,1,"ちょう"],[6,2,"みぶん"],[9,1,"たか"],[11,1,"ひと"],[13,1,"ぎ"],[14,1,"かん"],[16,1,"たく"],[19,2,"まじゅつ"],[21,1,"し"],[23,2,"ろうれん"],[30,1,"し"],[32,1,"と"],[34,1,"さ"]],"text":"五十人の長と身分の高い人、議官と巧みな魔術師、老練なまじない師を取り去られる。"},{"ref":"Isa.3.4","start":23003004,"end":23003004,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"た"],[11,1,"かれ"],[14,1,"きみ"],[23,1,"かれ"],[26,1,"おさ"]],"text":"わたしはわらべを立てて彼らの君とし、みどりごに彼らを治めさせる。"},{"ref":"Isa.3.5","start":23003005,"end":23003005,"break":"line","breaks":[[10,"line"],[25,"line"],[43,"line"]],"ruby":[[0,1,"たみ"],[2,1,"たがい"],[4,1,"あい"],[10,1,"ひと"],[18,1,"となり"],[25,1,"わか"],[27,1,"もの"],[29,1,"お"],[33,1,"もの"],[39,1,"たか"],[43,1,"いや"],[46,1,"もの"],[48,1,"たっと"],[50,1,"もの"],[56,1,"たか"]],"text":"民は互に相しえたげ、人はおのおのその隣をしえたげ、若い者は老いたる者にむかって高ぶり、卑しい者は尊い者にむかって高ぶる。"},{"ref":"Isa.3.6","start":23003006,"end":23003006,"break":"line","breaks":[[24,"line"],[38,"line"],[54,"line"]],"ruby":[[2,1,"とき"],[4,1,"ひと"],[8,1,"ちち"],[10,1,"いえ"],[13,2,"きょうだい"],[21,1,"い"],[29,2,"がいとう"],[32,1,"も"],[56,1,"あ"],[58,1,"あと"],[64,1,"て"],[66,1,"おさ"]],"text":"その時、人はその父の家で、兄弟をつかまえて言う、「あなたは外套を持っている、わたしたちのつかさびとになって、この荒れ跡をあなたの手で治めてください」と。"},{"ref":"Isa.3.7","start":23003007,"end":23003007,"break":"line","breaks":[[14,"line"],[35,"line"],[57,"line"],[65,"line"]],"ruby":[[2,1,"ひ"],[4,1,"かれ"],[6,1,"こえ"],[11,1,"い"],[22,1,"もの"],[39,1,"いえ"],[48,2,"がいとう"],[61,1,"た"],[65,1,"たみ"]],"text":"その日、彼は声をあげて言う、「わたしはいやす者となることはできません、わたしの家にはパンもなく、外套もありません、わたしを立てて、民のつかさびとにしないでください」。"},{"ref":"Isa.3.8","start":23003008,"end":23003008,"break":"line","breaks":[[19,"line"],[33,"line"]],"ruby":[[3,1,"かれ"],[6,2,"ことば"],[9,1,"おこな"],[13,1,"しゅ"],[21,2,"えいこう"],[24,1,"め"],[47,1,"たお"]],"text":"これは彼らの言葉と行いとが主にそむき、その栄光の目をおかしたので、エルサレムはつまずき、ユダは倒れたからである。"},{"ref":"Isa.3.9","start":23003009,"end":23003009,"break":"line","breaks":[[23,"line"],[44,"line"],[53,"line"]],"ruby":[[0,1,"かれ"],[3,3,"ふこうへい"],[7,1,"かれ"],[14,2,"ふり"],[32,1,"つみ"],[39,1,"かく"],[53,1,"かれ"],[60,1,"あく"],[62,1,"むく"]],"text":"彼らの不公平は彼らにむかって不利なあかしをし、ソドムのようにその罪をあらわして隠さない。わざわいなるかな、彼らはみずから悪の報いをうけた。"},{"ref":"Isa.3.10","start":23003010,"end":23003010,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"い"],[8,1,"かれ"],[20,1,"かれ"],[25,1,"おこな"],[28,1,"み"],[30,1,"た"]],"text":"正しい人に言え、彼らはさいわいであると。彼らはその行いの実を食べるからである。"},{"ref":"Isa.3.11","start":23003011,"end":23003011,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[11,1,"かれ"],[13,1,"わざわい"],[21,1,"て"],[26,1,"こと"],[28,1,"かれ"],[30,1,"むく"]],"text":"悪しき者はわざわいだ、彼は災をうける。その手のなした事が彼に報いられるからである。"},{"ref":"Isa.3.12","start":23003012,"end":23003012,"break":"line","breaks":[[15,"line"],[25,"line"],[41,"line"],[54,"line"]],"ruby":[[2,1,"たみ"],[4,1,"おさ"],[6,1,"ご"],[15,1,"おんな"],[19,1,"おさ"],[30,1,"たみ"],[37,1,"みちび"],[39,1,"もの"],[50,1,"まよ"],[58,1,"い"],[62,1,"みち"],[64,2,"こんらん"]],"text":"わが民は幼な子にしえたげられ、女たちに治められる。ああ、わが民よ、あなたを導く者はかえって、あなたを迷わせ、あなたの行くべき道を混乱させる。"},{"ref":"Isa.3.13","start":23003013,"end":23003013,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[4,1,"あらそ"],[9,1,"た"],[17,1,"たみ"],[25,1,"た"]],"text":"主は言い争うために立ちあがり、その民をさばくために立たれる。"},{"ref":"Isa.3.14","start":23003014,"end":23003014,"break":"line","breaks":[[19,"line"],[38,"line"],[53,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"たみ"],[6,2,"ちょうろう"],[9,1,"きみ"],[30,1,"はたけ"],[32,1,"く"],[34,1,"あら"],[38,1,"まず"],[41,1,"もの"],[50,1,"もの"],[59,1,"いえ"]],"text":"主はその民の長老と君たちとをさばいて、「あなたがたは、ぶどう畑を食い荒した。貧しい者からかすめとった物は、あなたがたの家にある。"},{"ref":"Isa.3.15","start":23003015,"end":23003015,"break":"line","breaks":[[19,"line"],[34,"line"]],"ruby":[[11,1,"たみ"],[13,1,"ふ"],[19,1,"まず"],[22,1,"もの"],[24,1,"かお"],[28,1,"くだ"],[34,2,"ばんぐん"],[37,1,"かみ"],[39,1,"しゅ"],[41,1,"い"]],"text":"なぜ、あなたがたはわが民を踏みにじり、貧しい者の顔をすり砕くのか」と万軍の神、主は言われる。"},{"ref":"Isa.3.16","start":23003016,"end":23003016,"break":"line","breaks":[[7,"line"],[18,"line"],[37,"line"],[50,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"むすめ"],[14,1,"たか"],[18,1,"くび"],[28,1,"め"],[39,1,"ゆ"],[43,1,"き"],[47,1,"ある"],[52,1,"あし"],[59,1,"な"],[61,1,"ひび"]],"text":"主は言われた、シオンの娘らは高ぶり、首をのばしてあるき、目でこびをおくり、その行くとき気どって歩き、その足でりんりんと鳴り響かす。"},{"ref":"Isa.3.17","start":23003017,"end":23003017,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[5,1,"しゅ"],[11,1,"むすめ"],[14,1,"あたま"],[16,1,"う"],[29,1,"かれ"],[32,1,"かく"],[35,1,"ところ"]],"text":"それゆえ、主はシオンの娘らの頭を撃って、かさぶたでおおい、彼らの隠れた所をあらわされる。"},{"ref":"Isa.3.18","start":23003018,"end":23003018,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"しゅ"],[6,1,"かれ"],[9,1,"うつく"],[12,3,"そうしんぐ"],[16,2,"ふくそう"],[27,1,"わ"],[29,1,"かみ"],[33,2,"つきがた"],[36,1,"かざ"]],"text":"その日、主は彼らの美しい装身具と服装すなわち、くるぶし輪、髪ひも、月形の飾り、"},{"ref":"Isa.3.19","start":23003019,"end":23003019,"break":"none","ruby":[[0,2,"みみわ"],[3,2,"うでわ"],[6,1,"かお"]],"text":"耳輪、腕輪、顔おおい、"},{"ref":"Isa.3.20","start":23003020,"end":23003020,"break":"none","ruby":[[0,1,"あたま"],[1,1,"かざ"],[6,1,"かざ"],[9,1,"かざ"],[11,1,"おび"],[13,2,"こうばこ"],[16,1,"まも"],[18,1,"ふくろ"]],"text":"頭飾り、すね飾り、飾り帯、香箱、守り袋、"},{"ref":"Isa.3.21","start":23003021,"end":23003021,"break":"none","ruby":[[0,2,"ゆびわ"],[3,2,"はなわ"]],"text":"指輪、鼻輪、"},{"ref":"Isa.3.22","start":23003022,"end":23003022,"break":"none","ruby":[[0,2,"れいふく"],[3,2,"がいとう"],[6,2,"かたかけ"],[9,1,"て"],[12,1,"ふくろ"]],"text":"礼服、外套、肩掛、手さげ袋、"},{"ref":"Isa.3.23","start":23003023,"end":23003023,"break":"none","ruby":[[0,1,"うす"],[1,1,"おり"],[3,2,"うわぎ"],[6,2,"あま"],[8,1,"ぬの"],[10,2,"きもの"],[13,2,"ぼうし"],[16,2,"かずき"],[21,1,"と"],[23,1,"のぞ"]],"text":"薄織の上着、亜麻布の着物、帽子、被衣などを取り除かれる。"},{"ref":"Isa.3.24","start":23003024,"end":23003024,"break":"stanza","breaks":[[14,"line"],[27,"line"],[46,"line"],[66,"line"]],"ruby":[[0,2,"ほうこう"],[8,2,"あくしゅう"],[14,1,"おび"],[29,1,"あ"],[32,1,"かみ"],[51,1,"ころも"],[58,2,"あらぬの"],[61,1,"ころも"],[66,1,"うつく"],[69,1,"かお"],[76,1,"や"],[78,1,"いん"],[82,1,"かお"]],"text":"芳香はかわって、悪臭となり、帯はかわって、なわとなり、よく編んだ髪はかわって、かぶろとなり、はなやかな衣はかわって、荒布の衣となり、美しい顔はかわって、焼き印された顔となる。"},{"ref":"Isa.3.25","start":23003025,"end":23003025,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"おとこ"],[12,1,"たお"],[19,2,"ゆうし"],[24,1,"たたか"],[27,1,"たお"]],"text":"あなたの男たちはつるぎに倒れ、あなたの勇士たちは戦いに倒れる。"},{"ref":"Isa.3.26","start":23003026,"end":23003026,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"もん"],[6,1,"なげ"],[8,1,"かな"],[16,1,"あ"],[23,1,"ち"],[25,1,"ざ"]],"text":"シオンの門は嘆き悲しみ、シオンは荒れすたれて、地に座する。"}]