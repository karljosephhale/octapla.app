[{"ref":"Job.37.1","start":18037001,"end":18037001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[8,1,"こころ"],[19,1,"ところ"],[24,1,"はな"]],"text":"これがためにわが心もまたわななき、その所からとび離れる。"},{"ref":"Job.37.2","start":18037002,"end":18037002,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"き"],[3,1,"かみ"],[5,1,"こえ"],[17,1,"くち"],[20,1,"で"]],"text":"聞け、神の声のとどろきを、またその口から出るささやきを。"},{"ref":"Job.37.3","start":18037003,"end":18037003,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[5,1,"あめ"],[7,1,"した"],[9,1,"はな"],[14,1,"ひかり"],[16,1,"ち"],[24,1,"いた"]],"text":"彼はこれを天が下に放ち、その光を地のすみずみまで至らせられる。"},{"ref":"Job.37.4","start":18037004,"end":18037004,"break":"line","breaks":[[10,"line"],[31,"line"],[40,"line"]],"ruby":[[2,1,"のち"],[4,1,"こえ"],[10,1,"かれ"],[19,1,"こえ"],[24,1,"な"],[26,1,"わた"],[33,1,"こえ"],[35,1,"きこ"],[38,1,"とき"],[40,1,"かれ"],[47,1,"ひ"]],"text":"その後、声とどろき、彼はそのいかめしい声をもって鳴り渡られる。その声の聞える時、彼はいなずまを引きとめられない。"},{"ref":"Job.37.5","start":18037005,"end":18037005,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[4,1,"おどろ"],[8,1,"こえ"],[13,1,"な"],[15,1,"わた"],[23,1,"さと"],[28,1,"おお"],[32,1,"こと"],[34,1,"おこな"]],"text":"神はその驚くべき声をもって鳴り渡り、われわれの悟りえない大いなる事を行われる。"},{"ref":"Job.37.6","start":18037006,"end":18037006,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ゆき"],[4,1,"む"],[9,1,"ち"],[11,1,"ふ"],[15,1,"めい"],[18,2,"ゆうだち"],[23,1,"あめ"],[25,1,"む"],[30,1,"つよ"],[32,1,"ふ"],[36,1,"めい"]],"text":"彼は雪に向かって『地に降れ』と命じ、夕立および雨に向かって『強く降れ』と命じられる。"},{"ref":"Job.37.7","start":18037007,"end":18037007,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[6,1,"ひと"],[8,1,"て"],[10,1,"ふう"],[23,1,"ひと"],[29,1,"し"]],"text":"彼はすべての人の手を封じられる。これはすべての人にみわざを知らせるためである。"},{"ref":"Job.37.8","start":18037008,"end":18037008,"break":"line","ruby":[[2,1,"とき"],[4,1,"けもの"],[6,1,"あな"],[8,1,"はい"]],"text":"その時、獣は穴に入り、そのほらにとどまる。"},{"ref":"Job.37.9","start":18037009,"end":18037009,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"かぜ"],[12,1,"さむ"],[15,2,"きたかぜ"],[19,1,"く"]],"text":"つむじ風はそのへやから、寒さは北風から来る。"},{"ref":"Job.37.10","start":18037010,"end":18037010,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[9,1,"こおり"],[11,1,"は"],[14,2,"ひろびろ"],[19,1,"みず"],[21,1,"こお"]],"text":"神のいぶきによって氷が張り、広々とした水は凍る。"},{"ref":"Job.37.11","start":18037011,"end":18037011,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[2,1,"こ"],[4,1,"くも"],[6,2,"すいき"],[9,1,"お"],[13,1,"くも"],[22,1,"ち"]],"text":"彼は濃い雲に水気を負わせ、雲はそのいなずまを散らす。"},{"ref":"Job.37.12","start":18037012,"end":18037012,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[3,1,"かれ"],[5,1,"みちび"],[15,1,"かれ"],[17,1,"めい"],[29,2,"せかい"],[36,1,"おこな"]],"text":"これは彼の導きによってめぐる。彼の命じるところをことごとく世界のおもてに行うためである。"},{"ref":"Job.37.13","start":18037013,"end":18037013,"break":"line","breaks":[[20,"line"],[31,"line"]],"ruby":[[0,1,"かみ"],[13,1,"こら"],[26,1,"ち"]],"text":"神がこれらをこさせるのは、懲しめのため、あるいはその地のため、あるいはいつくしみのためである。"},{"ref":"Job.37.14","start":18037014,"end":18037014,"break":"stanza","breaks":[[10,"line"]],"ruby":[[7,1,"き"],[10,1,"た"],[13,1,"かみ"],[23,1,"かんが"]],"text":"ヨブよ、これを聞け、立って神のくすしきみわざを考えよ。"},{"ref":"Job.37.15","start":18037015,"end":18037015,"break":"line","breaks":[[11,"line"],[24,"line"]],"ruby":[[4,1,"し"],[11,1,"かみ"],[20,1,"めい"],[26,1,"くも"],[28,1,"ひかり"],[30,1,"かがや"]],"text":"あなたは知っているか、神がいかにこれらに命じて、その雲の光を輝かされるかを。"},{"ref":"Job.37.16","start":18037016,"end":18037016,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"し"],[11,1,"くも"],[19,2,"ちしき"],[22,1,"まった"],[24,1,"もの"]],"text":"あなたは知っているか、雲のつりあいと、知識の全き者のくすしきみわざを。"},{"ref":"Job.37.17","start":18037017,"end":18037017,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"みなみかぜ"],[6,1,"ち"],[8,1,"おだ"],[14,1,"とき"],[20,2,"きもの"],[23,1,"あつ"]],"text":"南風によって地が穏やかになる時、あなたの着物が熱くなることを。"},{"ref":"Job.37.18","start":18037018,"end":18037018,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"い"],[6,1,"かがみ"],[11,1,"かた"],[13,2,"おおぞら"],[17,1,"かれ"],[22,1,"は"]],"text":"あなたは鋳た鏡のように堅い大空を、彼のように張ることができるか。"},{"ref":"Job.37.19","start":18037019,"end":18037019,"break":"line","breaks":[[22,"line"]],"ruby":[[5,1,"かれ"],[7,1,"い"],[11,1,"こと"],[18,1,"おし"],[27,1,"くら"],[31,2,"ことば"]],"text":"われわれが彼に言うべき事をわれわれに教えよ、われわれは暗くて、言葉をつらねることはできない。"},{"ref":"Job.37.20","start":18037020,"end":18037020,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[4,1,"かた"],[12,1,"かれ"],[14,1,"つ"],[26,1,"ひと"],[28,1,"ほろ"],[36,1,"のぞ"]],"text":"わたしは語ることがあると彼に告げることができようか、人は滅ぼされることを望むであろうか。"},{"ref":"Job.37.21","start":18037021,"end":18037021,"break":"stanza","breaks":[[23,"line"]],"ruby":[[0,1,"ひかり"],[2,1,"そら"],[4,1,"かがや"],[12,1,"かぜ"],[13,1,"す"],[16,1,"そら"],[18,1,"きよ"],[23,2,"ひとびと"],[28,1,"ひかり"],[30,1,"み"]],"text":"光が空に輝いているとき、風過ぎて空を清めると、人々はその光を見ることができない。"},{"ref":"Job.37.22","start":18037022,"end":18037022,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"きた"],[3,2,"おうごん"],[9,1,"かがや"],[17,1,"かみ"],[20,1,"おそ"],[24,2,"いこう"]],"text":"北から黄金のような輝きがでてくる。神には恐るべき威光がある。"},{"ref":"Job.37.23","start":18037023,"end":18037023,"break":"line","breaks":[[6,"line"],[26,"line"],[38,"line"]],"ruby":[[0,3,"ぜんのうしゃ"],[14,1,"み"],[26,1,"かれ"],[28,1,"ちから"],[30,2,"こうぎ"],[38,2,"せいぎ"],[41,1,"み"],[48,1,"ま"]],"text":"全能者は――われわれはこれを見いだすことができない。彼は力と公義とにすぐれ、正義に満ちて、これを曲げることはない。"},{"ref":"Job.37.24","start":18037024,"end":18037024,"break":"line","breaks":[[14,"line"]],"ruby":[[5,2,"ひとびと"],[8,1,"かれ"],[10,1,"おそ"],[14,1,"かれ"],[20,1,"かしこ"],[23,1,"おも"],[25,1,"もの"],[27,1,"かえり"]],"text":"それゆえ、人々は彼を恐れる。彼はみずから賢いと思う者を顧みられない」。"}]