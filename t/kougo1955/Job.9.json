[{"ref":"Job.9.1","start":18009001,"end":18009001,"break":"paragraph","ruby":[[3,1,"こた"],[6,1,"い"]],"text":"ヨブは答えて言った、"},{"ref":"Job.9.2","start":18009002,"end":18009002,"break":"stanza","breaks":[[14,"line"],[31,"line"]],"ruby":[[12,1,"こと"],[25,1,"し"],[34,1,"ひと"],[40,1,"かみ"],[42,1,"まえ"],[44,1,"ただ"]],"text":"「まことにわたしは、その事のそのとおりであることを知っている。しかし人はどうして神の前に正しくありえようか。"},{"ref":"Job.9.3","start":18009003,"end":18009003,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"かれ"],[4,1,"あらそ"],[17,1,"こた"]],"text":"よし彼と争おうとしても、千に一つも答えることができない。"},{"ref":"Job.9.4","start":18009004,"end":18009004,"break":"line","breaks":[[14,"line"],[35,"line"]],"ruby":[[0,1,"かれ"],[2,1,"こころ"],[3,1,"かしこ"],[6,2,"ちからづよ"],[17,1,"かれ"],[35,1,"さか"],[38,1,"もの"]],"text":"彼は心賢く、力強くあられる。だれが彼にむかい、おのれをかたくなにして、栄えた者があるか。"},{"ref":"Job.9.5","start":18009005,"end":18009005,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"やま"],[5,1,"うつ"],[11,1,"やま"],[13,1,"し"],[18,1,"かれ"],[20,1,"いか"]],"text":"彼は、山を移されるが、山は知らない。彼は怒りをもって、これらをくつがえされる。"},{"ref":"Job.9.6","start":18009006,"end":18009006,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ち"],[5,1,"ふる"],[7,1,"うご"],[13,1,"ところ"],[15,1,"はな"],[26,1,"はしら"]],"text":"彼が、地を震い動かしてその所を離れさせられると、その柱はゆらぐ。"},{"ref":"Job.9.7","start":18009007,"end":18009007,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ひ"],[4,1,"めい"],[11,1,"ひ"],[13,1,"で"],[17,1,"かれ"],[21,1,"ほし"],[23,1,"と"]],"text":"彼が日に命じられると、日は出ない。彼はまた星を閉じこめられる。"},{"ref":"Job.9.8","start":18009008,"end":18009008,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[7,1,"てん"],[9,1,"は"],[12,1,"うみ"],[14,1,"なみ"],[16,1,"ふ"]],"text":"彼はただひとり天を張り、海の波を踏まれた。"},{"ref":"Job.9.9","start":18009009,"end":18009009,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"かれ"],[2,2,"ほくと"],[18,1,"みなみ"],[20,2,"みっしつ"],[23,1,"つく"]],"text":"彼は北斗、オリオン、プレアデスおよび南の密室を造られた。"},{"ref":"Job.9.10","start":18009010,"end":18009010,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[2,1,"おお"],[6,1,"こと"],[14,1,"はか"],[20,3,"ふしぎ"],[24,1,"こと"],[32,1,"かず"],[33,1,"し"]],"text":"彼が大いなる事をされることは測りがたく、不思議な事をされることは数知れない。"},{"ref":"Job.9.11","start":18009011,"end":18009011,"break":"line","breaks":[[20,"line"],[30,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[14,1,"とお"],[24,1,"かれ"],[26,1,"み"],[30,1,"かれ"],[32,1,"すす"],[34,1,"い"],[44,1,"かれ"],[46,1,"みと"]],"text":"見よ、彼がわたしのかたわらを通られても、わたしは彼を見ない。彼は進み行かれるが、わたしは彼を認めない。"},{"ref":"Job.9.12","start":18009012,"end":18009012,"break":"line","breaks":[[14,"line"],[30,"line"],[52,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[5,1,"うば"],[7,1,"さ"],[17,1,"かれ"],[33,1,"かれ"],[44,1,"なに"],[52,1,"い"]],"text":"見よ、彼が奪い去られるのに、だれが彼をはばむことができるか。だれが彼にむかって『あなたは何をするのか』と言うことができるか。"},{"ref":"Job.9.13","start":18009013,"end":18009013,"break":"stanza","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[4,1,"いか"],[18,1,"たす"],[21,1,"もの"],[25,1,"かれ"]],"text":"神はその怒りをやめられない。ラハブを助ける者どもは彼のもとにかがんだ。"},{"ref":"Job.9.14","start":18009014,"end":18009014,"break":"line","breaks":[[13,"line"]],"ruby":[[8,1,"かれ"],[10,1,"こた"],[13,2,"ことば"],[16,1,"えら"],[20,1,"かれ"],[22,2,"ぎろん"]],"text":"どうしてわたしは彼に答え、言葉を選んで、彼と議論することができよう。"},{"ref":"Job.9.15","start":18009015,"end":18009015,"break":"line","breaks":[[23,"line"],[34,"line"]],"ruby":[[7,1,"ただ"],[12,1,"こた"],[27,1,"せ"],[32,1,"もの"],[39,1,"こ"]],"text":"たといわたしは正しくても答えることができない。わたしを責められる者にあわれみを請わなければならない。"},{"ref":"Job.9.16","start":18009016,"end":18009016,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[7,1,"よ"],[12,1,"かれ"],[18,1,"こた"],[29,1,"こえ"],[31,1,"みみ"],[33,1,"かたむ"],[40,1,"しん"]],"text":"たといわたしが呼ばわり、彼がわたしに答えられても、わたしの声に耳を傾けられたとは信じない。"},{"ref":"Job.9.17","start":18009017,"end":18009017,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[2,2,"おおかぜ"],[12,1,"う"],[14,1,"くだ"],[26,1,"おお"],[29,1,"きず"],[31,1,"お"]],"text":"彼は大風をもってわたしを撃ち砕き、ゆえなく、わたしに多くの傷を負わせ、"},{"ref":"Job.9.18","start":18009018,"end":18009018,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"いき"],[11,1,"にが"],[13,1,"もの"],[22,1,"み"]],"text":"わたしに息をつかせず、苦い物をもってわたしを満たされる。"},{"ref":"Job.9.19","start":18009019,"end":18009019,"break":"line","breaks":[[16,"line"],[28,"line"]],"ruby":[[0,1,"ちから"],[2,1,"あらそ"],[11,1,"かれ"],[13,1,"み"],[20,1,"こと"],[31,1,"かれ"],[33,1,"よ"],[35,1,"だ"]],"text":"力の争いであるならば、彼を見よ、さばきの事であるならば、だれが彼を呼び出すことができよう。"},{"ref":"Job.9.20","start":18009020,"end":18009020,"break":"line","breaks":[[13,"line"],[31,"line"],[45,"line"]],"ruby":[[7,1,"ただ"],[17,1,"くち"],[23,1,"つみ"],[26,1,"もの"],[38,1,"つみ"],[45,1,"かれ"],[51,1,"まが"],[54,1,"もの"]],"text":"たといわたしは正しくても、わたしの口はわたしを罪ある者とする。たといわたしは罪がなくても、彼はわたしを曲った者とする。"},{"ref":"Job.9.21","start":18009021,"end":18009021,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"つみ"],[16,2,"じぶん"],[19,1,"し"],[28,2,"じぶん"],[31,1,"いのち"]],"text":"わたしは罪がない、しかしわたしは自分を知らない。わたしは自分の命をいとう。"},{"ref":"Job.9.22","start":18009022,"end":18009022,"break":"line","breaks":[[19,"line"],[35,"line"]],"ruby":[[0,1,"みな"],[1,2,"どういつ"],[16,1,"い"],[20,1,"かれ"],[22,1,"つみ"],[26,1,"もの"],[29,1,"あ"],[32,1,"もの"],[35,1,"とも"],[37,1,"ほろ"]],"text":"皆同一である。それゆえ、わたしは言う、『彼は罪のない者と、悪しき者とを共に滅ぼされるのだ』と。"},{"ref":"Job.9.23","start":18009023,"end":18009023,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"わざわい"],[6,1,"ひと"],[8,1,"ころ"],[13,1,"こと"],[19,1,"かれ"],[21,1,"つみ"],[25,1,"もの"],[27,2,"くなん"],[32,1,"わら"]],"text":"災がにわかに人を殺すような事があると、彼は罪のない者の苦難をあざ笑われる。"},{"ref":"Job.9.24","start":18009024,"end":18009024,"break":"line","breaks":[[14,"line"],[30,"line"]],"ruby":[[0,1,"よ"],[2,2,"あくにん"],[5,1,"て"],[7,1,"わた"],[14,1,"かれ"],[18,3,"さいばんにん"],[22,1,"かお"],[32,1,"かれ"]],"text":"世は悪人の手に渡されてある。彼はその裁判人の顔をおおわれる。もし彼でなければ、これはだれのしわざか。"},{"ref":"Job.9.25","start":18009025,"end":18009025,"break":"stanza","breaks":[[14,"line"]],"ruby":[[4,1,"ひ"],[6,2,"ひきゃく"],[11,1,"はや"],[14,1,"と"],[16,1,"さ"],[19,1,"さいわい"],[21,1,"み"]],"text":"わたしの日は飛脚よりも速く、飛び去って幸を見ない。"},{"ref":"Job.9.26","start":18009026,"end":18009026,"break":"line","breaks":[[14,"line"]],"ruby":[[3,1,"はし"],[7,1,"あし"],[8,1,"ぶね"],[18,1,"おそ"]],"text":"これは走ること葦舟のごとく、えじきに襲いかかる、わしのようだ。"},{"ref":"Job.9.27","start":18009027,"end":18009027,"break":"line","breaks":[[16,"line"]],"ruby":[[10,1,"なげ"],[13,1,"わす"],[16,1,"うれ"],[18,1,"がお"],[23,2,"げんき"],[32,1,"い"]],"text":"たといわたしは『わが嘆きを忘れ、憂い顔をかえて元気よくなろう』と言っても、"},{"ref":"Job.9.28","start":18009028,"end":18009028,"break":"line","breaks":[[19,"line"],[39,"line"]],"ruby":[[11,1,"くる"],[15,1,"おそ"],[27,1,"つみ"],[30,1,"もの"],[43,1,"し"]],"text":"わたしはわがもろもろの苦しみを恐れる。あなたがわたしを罪なき者とされないことをわたしは知っているからだ。"},{"ref":"Job.9.29","start":18009029,"end":18009029,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"つみ"],[7,1,"もの"],[25,1,"ろう"],[28,2,"ひつよう"]],"text":"わたしは罪ある者とされている。どうして、いたずらに労する必要があるか。"},{"ref":"Job.9.30","start":18009030,"end":18009030,"break":"line","breaks":[[14,"line"]],"ruby":[[7,1,"ゆき"],[9,1,"み"],[11,1,"あら"],[14,2,"あく"],[17,1,"て"],[19,1,"きよ"]],"text":"たといわたしは雪で身を洗い、灰汁で手を清めても、"},{"ref":"Job.9.31","start":18009031,"end":18009031,"break":"line","breaks":[[23,"line"]],"ruby":[[12,1,"なか"],[14,1,"な"],[16,1,"こ"],[27,2,"きもの"]],"text":"あなたはわたしを、みぞの中に投げ込まれるので、わたしの着物も、わたしをいとうようになる。"},{"ref":"Job.9.32","start":18009032,"end":18009032,"break":"line","breaks":[[17,"line"],[34,"line"]],"ruby":[[0,1,"かみ"],[9,1,"ひと"],[21,1,"かれ"],[23,1,"こた"],[39,1,"とも"],[45,1,"のぞ"]],"text":"神はわたしのように人ではないゆえ、わたしは彼に答えることができない。われわれは共にさばきに臨むことができない。"},{"ref":"Job.9.33","start":18009033,"end":18009033,"break":"line","breaks":[[9,"line"]],"ruby":[[5,1,"あいだ"],[17,1,"うえ"],[19,1,"て"],[21,1,"お"],[25,3,"ちゅうさいしゃ"]],"text":"われわれの間には、われわれふたりの上に手を置くべき仲裁者がない。"},{"ref":"Job.9.34","start":18009034,"end":18009034,"break":"line","breaks":[[20,"line"],[29,"line"]],"ruby":[[3,1,"かれ"],[15,1,"と"],[17,1,"はな"],[22,1,"いか"],[33,1,"おそ"]],"text":"どうか彼がそのつえをわたしから取り離し、その怒りをもって、わたしを恐れさせられないように。"},{"ref":"Job.9.35","start":18009035,"end":18009035,"break":"line","breaks":[[14,"line"],[25,"line"]],"ruby":[[10,1,"かた"],[14,1,"かれ"],[16,1,"おそ"],[38,1,"もの"]],"text":"そうすれば、わたしは語って、彼を恐れることはない。わたしはみずからそのような者ではないからだ。"}]