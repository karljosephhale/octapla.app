[{"ref":"Isa.16.1","start":23016001,"end":23016001,"break":"paragraph","breaks":[[15,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[7,2,"あらの"],[10,1,"みち"],[15,2,"こひつじ"],[22,1,"むすめ"],[24,1,"やま"],[26,1,"おく"],[29,1,"くに"],[35,1,"おさ"]],"text":"彼らはセラから荒野の道によって小羊をシオンの娘の山に送り、国のつかさに納めた。"},{"ref":"Isa.16.2","start":23016002,"end":23016002,"break":"line","breaks":[[16,"line"],[26,"line"]],"ruby":[[4,1,"むすめ"],[12,1,"わた"],[20,1,"とり"],[26,1,"す"],[28,1,"お"]],"text":"モアブの娘らはアルノンの渡しで、さまよう鳥のように、巣を追われたひなのようである。"},{"ref":"Isa.16.3","start":23016003,"end":23016003,"break":"line","breaks":[[13,"line"],[33,"line"],[42,"line"]],"ruby":[[1,1,"あい"],[7,1,"こと"],[9,1,"さだ"],[13,2,"まひる"],[16,1,"なか"],[24,1,"かげ"],[26,1,"よる"],[37,1,"ひと"],[39,1,"かく"],[46,1,"き"],[48,1,"もの"]],"text":"「相はかって、事を定めよ。真昼の中でも、あなたの陰を夜のようにし、さすらい人を隠し、のがれて来た者をわたさず、"},{"ref":"Isa.16.4","start":23016004,"end":23016004,"break":"line","breaks":[[23,"line"],[47,"line"],[67,"line"]],"ruby":[[8,1,"ひと"],[23,1,"かれ"],[26,1,"さ"],[28,1,"どころ"],[34,1,"ほろ"],[37,1,"もの"],[52,1,"もの"],[59,1,"ほろ"],[62,1,"もの"],[64,1,"た"],[67,1,"ふ"],[72,1,"もの"],[74,1,"ち"],[77,1,"た"]],"text":"モアブのさすらい人を、あなたのうちにやどらせ、彼らの避け所となって、滅ぼす者からのがれさせよ。しえたげる者がなくなり、滅ぼす者が絶え、踏みにじる者が地から断たれたとき、"},{"ref":"Isa.16.5","start":23016005,"end":23016005,"break":"line","breaks":[[22,"line"],[33,"line"],[46,"line"],[61,"line"]],"ruby":[[3,2,"ぎょくざ"],[15,1,"かた"],[17,1,"た"],[26,2,"まくや"],[40,2,"こうへい"],[43,1,"もと"],[46,2,"せいぎ"],[49,1,"おこな"],[59,1,"もの"],[61,2,"しんじつ"],[69,1,"うえ"],[71,1,"ざ"]],"text":"一つの玉座がいつくしみによって堅く立てられ、ダビデの幕屋にあって、さばきをなし、公平を求め、正義を行うに、すみやかなる者が真実をもってその上に座する」。"},{"ref":"Isa.16.6","start":23016006,"end":23016006,"break":"paragraph","breaks":[[20,"line"],[36,"line"],[51,"line"],[65,"line"]],"ruby":[[9,1,"たか"],[16,1,"き"],[22,1,"たか"],[43,1,"ほこり"],[46,1,"たか"],[61,1,"き"],[67,2,"じまん"],[70,1,"いつわ"]],"text":"われわれはモアブの高ぶりのことを聞いた、その高ぶることは、はなはだしい。われわれはその誇と、高ぶりと、そのおごりとのことを聞いた、その自慢は偽りである。"},{"ref":"Isa.16.7","start":23016007,"end":23016007,"break":"line","breaks":[[14,"line"],[30,"line"],[40,"line"]],"ruby":[[9,1,"な"],[11,1,"さけ"],[14,1,"たみ"],[25,1,"な"],[27,1,"さけ"],[30,1,"まった"],[32,1,"う"],[47,1,"ほし"],[55,1,"なげ"]],"text":"それゆえ、モアブは泣き叫べ、民はみなモアブのために泣き叫べ。全く撃ちのめされて、キルハレセテの干ぶどうのために嘆け。"},{"ref":"Isa.16.8","start":23016008,"end":23016008,"break":"line","breaks":[[8,"line"],[27,"line"],[38,"line"],[53,"line"],[70,"line"],[80,"line"]],"ruby":[[5,1,"はたけ"],[16,1,"き"],[23,1,"おとろ"],[27,2,"くにぐに"],[35,1,"しゅ"],[40,1,"えだ"],[42,1,"う"],[44,1,"おと"],[55,1,"えだ"],[70,2,"あらの"],[85,1,"ひろ"],[89,1,"うみ"],[91,1,"こ"]],"text":"ヘシボンの畑と、シブマのぶどうの木とは、しぼみ衰えた。国々のもろもろの主が、その枝を打ち落したからである。その枝はさきにはヤゼルまでいたり、荒野にまではびこり、そのつるは広がって海を越えた。"},{"ref":"Isa.16.9","start":23016009,"end":23016009,"break":"line","breaks":[[16,"line"],[32,"line"],[44,"line"],[60,"line"],[74,"line"]],"ruby":[[13,1,"とも"],[24,1,"き"],[29,1,"な"],[48,1,"なみだ"],[57,1,"ひた"],[63,1,"こえ"],[70,2,"かじつ"],[78,2,"しゅうかく"],[81,1,"うえ"]],"text":"それゆえ、わたしはヤゼルと共に、シブマのぶどうの木のために泣く。ヘシボンよ、エレアレよ、わたしは涙をもってあなたを浸す。ときの声が、あなたの果実と、あなたの収穫の上にふりかかってきたからである。"},{"ref":"Isa.16.10","start":23016010,"end":23016010,"break":"line","breaks":[[21,"line"],[34,"line"],[45,"line"],[60,"line"]],"ruby":[[0,1,"よろこ"],[3,1,"たの"],[8,1,"つち"],[9,1,"こ"],[12,1,"はたけ"],[15,1,"と"],[17,1,"さ"],[24,1,"はたけ"],[27,1,"うた"],[34,1,"よろこ"],[36,1,"よ"],[45,1,"さか"],[49,1,"ふ"],[52,1,"さけ"],[54,1,"しぼ"],[56,1,"もの"],[64,2,"しゅうかく"],[67,1,"よろこ"],[69,1,"こえ"]],"text":"喜びと楽しみとは土肥えた畑から取り去られ、ぶどう畑には歌うことなく、喜び呼ばわることなく、酒ぶねを踏んで酒を絞る者なく、ぶどうの収穫を喜ぶ声はやんだ。"},{"ref":"Isa.16.11","start":23016011,"end":23016011,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[7,1,"たましい"],[19,1,"こころ"],[31,1,"こと"],[36,1,"な"]],"text":"それゆえ、わが魂はモアブのために、わが心はキルハレスのために、琴のように鳴りひびく。"},{"ref":"Isa.16.12","start":23016012,"end":23016012,"break":"paragraph","ruby":[[4,1,"たか"],[6,1,"ところ"],[8,1,"で"],[15,1,"つか"],[24,2,"せいじょ"],[29,1,"いの"],[34,2,"こうか"]],"text":"モアブが高き所に出て、おのれを疲れさせ、またその聖所にきて祈っても、効果はない。"},{"ref":"Isa.16.13","start":23016013,"end":23016013,"break":"paragraph","ruby":[[3,1,"しゅ"],[15,1,"かた"],[20,2,"ことば"]],"text":"これは主がさきにモアブについて語られたみ言葉である。"},{"ref":"Isa.16.14","start":23016014,"end":23016014,"break":"none","ruby":[[3,1,"いま"],[5,1,"しゅ"],[7,1,"かた"],[10,1,"い"],[20,1,"さか"],[25,1,"おお"],[29,2,"ぐんしゅう"],[39,2,"やといにん"],[42,2,"ねんき"],[50,1,"ねん"],[62,1,"う"],[65,1,"のこ"],[68,1,"もの"],[74,1,"すく"],[78,1,"ちから"]],"text":"しかし今、主は語って言われる、「モアブの栄えはその大いなる群衆にもかかわらず、雇人の年期とひとしく三年のうちに、はずかしめを受け、残れる者はまことに少なく、力がない」。"}]