[{"ref":"2Chr.18.1","start":14018001,"end":14018001,"break":"paragraph","ruby":[[6,1,"おお"],[10,1,"とみ"],[12,1,"ほまれ"],[22,1,"ふち"],[24,1,"むす"]],"text":"ヨシャパテは大いなる富と誉とをもち、アハブと縁を結んだ。"},{"ref":"2Chr.18.2","start":14018002,"end":14018002,"break":"none","ruby":[[0,1,"かれ"],[2,2,"すうねん"],[5,1,"のち"],[12,1,"くだ"],[30,1,"かれ"],[32,1,"かれ"],[34,1,"したが"],[39,1,"たみ"],[44,1,"ひつじ"],[46,1,"うし"],[48,1,"おお"],[63,2,"いっしょ"],[66,1,"せ"],[68,1,"のぼ"],[73,1,"かれ"]],"text":"彼は数年の後、サマリヤに下って、アハブをおとずれた。アハブは彼と彼に従ってきた民のために羊と牛を多くほふり、ラモテ・ギレアデに一緒に攻め上ることを彼にすすめた。"},{"ref":"2Chr.18.3","start":14018003,"end":14018003,"break":"none","ruby":[[6,1,"おう"],[14,1,"おう"],[21,1,"い"],[34,2,"いっしょ"],[46,1,"せ"],[49,1,"い"],[62,1,"こた"],[84,1,"たみ"],[90,1,"たみ"],[105,2,"いっしょ"],[108,1,"たたか"],[111,1,"のぞ"]],"text":"イスラエルの王アハブはユダの王ヨシャパテに言った、「あなたはわたしと一緒にラモテ・ギレアデに攻めて行きますか」。ヨシャパテは答えた、「わたしはあなたと一つです、わたしの民はあなたの民と一つです。わたしはあなたと一緒に戦いに臨みましょう」。"},{"ref":"2Chr.18.4","start":14018004,"end":14018004,"break":"paragraph","ruby":[[14,1,"おう"],[16,1,"い"],[23,1,"しゅ"],[25,2,"ことば"],[28,1,"もと"]],"text":"ヨシャパテはまたイスラエルの王に言った、「まず主の言葉を求めなさい」。"},{"ref":"2Chr.18.5","start":14018005,"end":14018005,"break":"none","ruby":[[9,1,"おう"],[11,3,"よげんしゃ"],[16,1,"にん"],[18,1,"あつ"],[21,1,"かれ"],[24,1,"い"],[44,1,"たたか"],[47,1,"い"],[57,1,"ひか"],[65,1,"かれ"],[68,1,"い"],[73,1,"のぼ"],[76,1,"い"],[82,1,"かみ"],[87,1,"おう"],[89,1,"て"]],"text":"そこでイスラエルの王は預言者四百人を集めて彼らに言った、「われわれはラモテ・ギレアデに、戦いに行くべきか、あるいは控えるべきか」。彼らは言った、「上って行きなさい。神はそれを王の手にわたされるでしょう」。"},{"ref":"2Chr.18.6","start":14018006,"end":14018006,"break":"none","ruby":[[6,1,"い"],[19,1,"と"],[23,1,"しゅ"],[25,3,"よげんしゃ"]],"text":"ヨシャパテは言った、「ほかにわれわれが問うべき主の預言者はここにいませんか」。"},{"ref":"2Chr.18.7","start":14018007,"end":14018007,"break":"none","ruby":[[6,1,"おう"],[14,1,"い"],[38,1,"ひと"],[43,1,"しゅ"],[45,1,"と"],[56,1,"かれ"],[65,1,"よ"],[67,1,"こと"],[69,2,"よげん"],[79,1,"つね"],[81,1,"わる"],[88,2,"よげん"],[99,1,"かれ"],[101,1,"にく"],[108,1,"もの"],[114,1,"こ"],[128,1,"い"],[133,1,"おう"],[139,1,"い"]],"text":"イスラエルの王はヨシャパテに言った、「ほかになおひとりいます。われわれはこの人によって主に問うことができますが、彼はわたしについて良い事を預言したことがなく、常に悪いことだけを預言するので、わたしは彼を憎みます。その者はイムラの子ミカヤです」。ヨシャパテは言った、「王よ、そうは言わないでください」。"},{"ref":"2Chr.18.8","start":14018008,"end":14018008,"break":"none","ruby":[[9,1,"おう"],[15,2,"やくにん"],[18,1,"よ"],[27,1,"こ"],[32,1,"いそ"],[35,1,"つ"],[44,1,"い"]],"text":"そこでイスラエルの王はひとりの役人を呼んで、「イムラの子ミカヤを急いで連れてきなさい」と言った。"},{"ref":"2Chr.18.9","start":14018009,"end":14018009,"break":"none","ruby":[[8,1,"おう"],[15,1,"おう"],[22,1,"おう"],[24,1,"ころも"],[26,1,"き"],[34,1,"もん"],[36,2,"いりぐち"],[39,2,"ひろば"],[48,2,"ぎょくざ"],[51,1,"ざ"],[54,3,"よげんしゃ"],[60,1,"みな"],[63,1,"まえ"],[65,2,"よげん"]],"text":"さてイスラエルの王およびユダの王ヨシャパテは王の衣を着て、サマリヤの門の入口の広場におのおのその玉座に座し、預言者たちは皆その前で預言していた。"},{"ref":"2Chr.18.10","start":14018010,"end":14018010,"break":"none","ruby":[[5,1,"こ"],[11,1,"てつ"],[13,1,"つの"],[15,1,"つく"],[18,1,"い"],[23,1,"しゅ"],[27,1,"おお"],[43,1,"つの"],[54,1,"つ"],[57,1,"ほろ"],[60,1,"つく"]],"text":"ケナアナの子ゼデキヤは鉄の角を造って言った、「主はこう仰せられます、『あなたはこれらの角をもってスリヤびとを突いて滅ぼし尽しなさい』」。"},{"ref":"2Chr.18.11","start":14018011,"end":14018011,"break":"none","ruby":[[0,3,"よげんしゃ"],[6,1,"みな"],[12,2,"よげん"],[16,1,"い"],[30,1,"のぼ"],[36,2,"しょうり"],[39,1,"え"],[44,1,"しゅ"],[49,1,"おう"],[51,1,"て"]],"text":"預言者たちは皆そのように預言して言った、「ラモテ・ギレアデに上っていって勝利を得なさい。主はそれを王の手にわたされるでしょう」。"},{"ref":"2Chr.18.12","start":14018012,"end":14018012,"break":"paragraph","ruby":[[6,1,"よ"],[9,1,"い"],[12,2,"ししゃ"],[15,1,"かれ"],[17,1,"い"],[22,3,"よげんしゃ"],[28,2,"いっち"],[32,1,"おう"],[34,1,"よ"],[36,1,"こと"],[38,1,"い"],[52,2,"ことば"],[56,1,"かれ"],[63,2,"ことば"],[71,1,"よ"],[73,1,"こと"],[75,1,"い"]],"text":"さてミカヤを呼びに行った使者は彼に言った、「預言者たちは一致して王に良い事を言いました。どうぞ、あなたの言葉も、彼らのひとりの言葉のようにし、良い事を言ってください」。"},{"ref":"2Chr.18.13","start":14018013,"end":14018013,"break":"none","ruby":[[4,1,"い"],[9,1,"しゅ"],[11,1,"い"],[21,1,"かみ"],[23,1,"い"],[34,1,"もう"]],"text":"ミカヤは言った、「主は生きておられる。わが神の言われることをわたしは申します」。"},{"ref":"2Chr.18.14","start":14018014,"end":14018014,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おう"],[4,1,"ところ"],[6,1,"い"],[10,1,"おう"],[12,1,"かれ"],[14,1,"い"],[38,1,"たたか"],[41,1,"い"],[51,1,"ひか"],[59,1,"かれ"],[61,1,"い"],[66,1,"のぼ"],[69,1,"い"],[72,2,"しょうり"],[75,1,"え"],[80,1,"かれ"],[87,1,"て"]],"text":"彼が王の所へ行くと、王は彼に言った、「ミカヤよ、われわれはラモテ・ギレアデに戦いに行くべきか、あるいは控えるべきか」。彼は言った、「上って行って勝利を得なさい。彼らはあなたの手にわたされるでしょう」。"},{"ref":"2Chr.18.15","start":14018015,"end":14018015,"break":"none","ruby":[[3,1,"おう"],[5,1,"かれ"],[7,1,"い"],[12,1,"いく"],[19,1,"ちか"],[29,1,"しゅ"],[31,1,"な"],[39,2,"しんじつ"],[48,1,"つ"]],"text":"しかし王は彼に言った、「幾たびあなたを誓わせたら、あなたは主の名をもって、ただ真実のみをわたしに告げるだろうか」。"},{"ref":"2Chr.18.16","start":14018016,"end":14018016,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[17,1,"みな"],[18,2,"ぼくしゃ"],[23,1,"ひつじ"],[28,1,"やま"],[30,1,"ち"],[37,1,"み"],[45,1,"しゅ"],[52,1,"もの"],[54,2,"しゅじん"],[64,1,"かれ"],[71,1,"やす"],[78,1,"いえ"],[80,1,"かえ"],[86,1,"い"]],"text":"彼は言った、「わたしはイスラエルが皆牧者のない羊のように山に散っているのを見ました。すると主は『これらの者は主人をもっていない。彼らをそれぞれ安らかに、その家に帰らせよ』と言われました」。"},{"ref":"2Chr.18.17","start":14018017,"end":14018017,"break":"none","ruby":[[6,1,"おう"],[14,1,"い"],[28,1,"かれ"],[37,1,"よ"],[39,1,"こと"],[41,2,"よげん"],[48,1,"わる"],[50,1,"こと"],[54,2,"よげん"],[59,1,"つ"]],"text":"イスラエルの王はヨシャパテに言った、「わたしはあなたに、彼はわたしについて良い事を預言せず、ただ悪い事だけを預言すると告げたではありませんか」。"},{"ref":"2Chr.18.18","start":14018018,"end":14018018,"break":"none","ruby":[[4,1,"い"],[14,1,"しゅ"],[16,2,"ことば"],[19,1,"き"],[29,1,"しゅ"],[33,2,"ぎょくざ"],[36,1,"ざ"],[39,1,"てん"],[41,2,"ばんぐん"],[46,2,"みぎひだり"],[49,1,"た"],[56,1,"み"]],"text":"ミカヤは言った、「それだから主の言葉を聞きなさい。わたしは主がその玉座に座し、天の万軍がその右左に立っているのを見たが、"},{"ref":"2Chr.18.19","start":14018019,"end":14018019,"break":"none","ruby":[[0,1,"しゅ"],[13,1,"おう"],[33,1,"のぼ"],[37,1,"かれ"],[39,1,"たお"],[51,1,"い"],[70,1,"い"],[84,1,"い"]],"text":"主は、『だれがイスラエルの王アハブをいざなって、ラモテ・ギレアデに上らせ、彼を倒れさせるであろうか』と言われた。するとひとりは、こうしようと言い、ひとりは、ああしようと言った。"},{"ref":"2Chr.18.20","start":14018020,"end":14018020,"break":"none","ruby":[[2,1,"とき"],[6,1,"れい"],[8,1,"すす"],[10,1,"で"],[13,1,"しゅ"],[15,1,"まえ"],[17,1,"た"],[25,1,"かれ"],[37,1,"い"],[43,1,"しゅ"],[45,1,"かれ"],[48,1,"なに"],[58,1,"い"]],"text":"その時一つの霊が進み出て、主の前に立ち、『わたしが彼をいざないましょう』と言ったので、主は彼に『何をもってするか』と言われた。"},{"ref":"2Chr.18.21","start":14018021,"end":14018021,"break":"none","ruby":[[0,1,"かれ"],[7,1,"で"],[9,1,"い"],[13,1,"いつわ"],[16,1,"い"],[18,1,"れい"],[28,3,"よげんしゃ"],[32,1,"くち"],[34,1,"やど"],[42,1,"い"],[49,1,"しゅ"],[56,1,"かれ"],[69,1,"と"],[77,1,"で"],[79,1,"い"],[91,1,"い"]],"text":"彼は『わたしが出て行って、偽りを言う霊となって、すべての預言者の口に宿りましょう』と言った。そこで主は『おまえは彼をいざなって、それをなし遂げるであろう。出て行って、そうしなさい』と言われた。"},{"ref":"2Chr.18.22","start":14018022,"end":14018022,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"いつわ"],[10,1,"い"],[12,1,"れい"],[16,3,"よげんしゃ"],[22,1,"くち"],[24,1,"い"],[29,1,"しゅ"],[38,1,"わざわい"],[40,1,"つ"]],"text":"それゆえ、主は偽りを言う霊をこの預言者たちの口に入れ、また主はあなたについて災を告げられたのです」。"},{"ref":"2Chr.18.23","start":14018023,"end":14018023,"break":"paragraph","ruby":[[8,1,"こ"],[14,2,"ちかよ"],[25,1,"う"],[28,1,"い"],[33,1,"しゅ"],[35,1,"れい"],[39,1,"みち"],[46,1,"はな"],[49,1,"い"],[57,1,"かた"]],"text":"するとケナアナの子ゼデキヤが近寄ってミカヤのほおを打って言った、「主の霊がどの道からわたしを離れて行って、あなたに語りましたか」。"},{"ref":"2Chr.18.24","start":14018024,"end":14018024,"break":"none","ruby":[[4,1,"い"],[13,1,"おく"],[15,1,"あいだ"],[21,1,"み"],[23,1,"かく"],[25,1,"ひ"],[27,1,"み"]],"text":"ミカヤは言った、「あなたが奥の間にはいって身を隠す日に見るでしょう」。"},{"ref":"2Chr.18.25","start":14018025,"end":14018025,"break":"none","ruby":[[6,1,"おう"],[8,1,"い"],[17,1,"とら"],[20,1,"まち"],[29,1,"おう"],[31,1,"こ"],[36,1,"ところ"],[38,1,"ひ"],[41,1,"い"]],"text":"イスラエルの王は言った、「ミカヤを捕え、町のつかさアモンと王の子ヨアシの所へ引いて行って、"},{"ref":"2Chr.18.26","start":14018026,"end":14018026,"break":"none","ruby":[[0,1,"い"],[7,1,"おう"],[11,1,"い"],[16,1,"もの"],[18,2,"ごくや"],[21,1,"い"],[24,1,"すこ"],[33,1,"みず"],[38,1,"かれ"],[40,1,"やしな"],[47,2,"しょうり"],[50,1,"え"],[52,1,"かえ"],[59,1,"ま"]],"text":"言いなさい、『王はこう言う、この者を獄屋に入れ、少しばかりのパンと水をもって彼を養い、わたしが勝利を得て帰ってくるのを待て』と」。"},{"ref":"2Chr.18.27","start":14018027,"end":14018027,"break":"none","ruby":[[4,1,"い"],[15,2,"しょうり"],[18,1,"え"],[20,1,"かえ"],[26,1,"しゅ"],[35,1,"かた"],[49,1,"かれ"],[51,1,"い"],[65,1,"たみ"],[68,1,"き"]],"text":"ミカヤは言った、「あなたがもし勝利を得て帰るならば、主はわたしによって語られなかったのです」。また彼は言った、「あなたがたすべての民よ、聞きなさい」。"},{"ref":"2Chr.18.28","start":14018028,"end":14018028,"break":"paragraph","ruby":[[10,1,"おう"],[15,1,"おう"],[32,1,"のぼ"]],"text":"こうしてイスラエルの王とユダの王ヨシャパテは、ラモテ・ギレアデに上った。"},{"ref":"2Chr.18.29","start":14018029,"end":14018029,"break":"none","ruby":[[6,1,"おう"],[14,1,"い"],[23,1,"すがた"],[25,1,"か"],[28,1,"たたか"],[31,1,"い"],[45,1,"おう"],[47,1,"ころも"],[49,1,"つ"],[62,1,"おう"],[64,1,"すがた"],[66,1,"か"],[69,1,"たたか"],[72,1,"い"]],"text":"イスラエルの王はヨシャパテに言った、「わたしは姿を変えて戦いに行きましょう。しかしあなたは王の衣を着けなさい」。イスラエルの王は姿を変えて戦いに行った。"},{"ref":"2Chr.18.30","start":14018030,"end":14018030,"break":"none","ruby":[[7,1,"おう"],[12,2,"せんしゃ"],[14,2,"たいちょう"],[19,1,"めい"],[22,1,"い"],[33,1,"ちい"],[36,1,"もの"],[40,1,"おお"],[43,1,"もの"],[46,1,"たたか"],[63,1,"おう"],[67,1,"たたか"]],"text":"さて、スリヤの王は、その戦車隊長たちに命じて言った、「あなたがたは小さい者とも、大きい者とも戦ってはならない。ただイスラエルの王とのみ戦いなさい」。"},{"ref":"2Chr.18.31","start":14018031,"end":14018031,"break":"none","ruby":[[0,2,"せんしゃ"],[2,2,"たいちょう"],[12,1,"み"],[29,1,"おう"],[32,1,"おも"],[38,1,"み"],[40,1,"めぐ"],[47,1,"たたか"],[63,1,"よ"],[71,1,"しゅ"],[76,1,"たす"],[86,1,"かみ"],[88,1,"てき"],[90,1,"かれ"],[93,1,"はな"]],"text":"戦車隊長らはヨシャパテを見たとき、これはきっとイスラエルの王だと思ったので、身を巡らしてこれと戦おうとした。しかしヨシャパテが呼ばわったので、主はこれを助けられた。すなわち神は敵を彼から離れさせられた。"},{"ref":"2Chr.18.32","start":14018032,"end":14018032,"break":"none","ruby":[[0,2,"せんしゃ"],[2,2,"たいちょう"],[6,1,"かれ"],[14,1,"おう"],[20,1,"み"],[25,1,"かれ"],[27,1,"お"],[35,1,"ひ"],[37,1,"かえ"]],"text":"戦車隊長らは彼がイスラエルの王でないのを見たので、彼を追うことをやめて引き返した。"},{"ref":"2Chr.18.33","start":14018033,"end":14018033,"break":"none","ruby":[[8,1,"ひと"],[18,1,"ゆみ"],[20,1,"ひ"],[30,1,"おう"],[32,2,"むねあて"],[41,1,"あいだ"],[43,1,"い"],[48,1,"かれ"],[52,1,"くるま"],[54,2,"ぎょしゃ"],[57,1,"い"],[66,1,"きず"],[68,1,"う"],[74,1,"くるま"],[86,2,"ぐんちゅう"],[90,1,"はこ"],[92,1,"だ"]],"text":"しかし、ひとりの人が、なにごころなく弓を引いて、イスラエルの王の胸当と、くさずりの間を射たので、彼はその車の御者に言った、「わたしは傷を受けたから、車をめぐらして、わたしを軍中から運び出せ」。"},{"ref":"2Chr.18.34","start":14018034,"end":14018034,"break":"none","ruby":[[2,1,"ひ"],[3,1,"たたか"],[6,1,"はげ"],[19,1,"おう"],[21,1,"くるま"],[23,1,"なか"],[25,2,"じぶん"],[32,1,"た"],[35,2,"ゆうぐれ"],[45,1,"む"],[53,1,"ひ"],[55,1,"い"],[63,1,"し"]],"text":"その日戦いは激しくなった。イスラエルの王は車の中に自分をささえて立ち、夕暮までスリヤびとに向かっていたが、日の入るころになって死んだ。"}]