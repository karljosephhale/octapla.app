[{"ref":"Rev.10.1","start":66010001,"end":66010001,"break":"paragraph","ruby":[[11,1,"つよ"],[13,2,"みつかい"],[17,1,"くも"],[19,1,"つつ"],[24,1,"てん"],[27,1,"お"],[30,1,"く"],[34,1,"み"],[39,1,"あたま"],[52,1,"かお"],[54,2,"たいよう"],[63,1,"あし"],[65,1,"ひ"],[67,1,"はしら"]],"text":"わたしは、もうひとりの強い御使が、雲に包まれて、天から降りて来るのを見た。その頭に、にじをいただき、その顔は太陽のようで、その足は火の柱のようであった。"},{"ref":"Rev.10.2","start":66010002,"end":66010002,"break":"none","ruby":[[0,1,"かれ"],[3,1,"ひら"],[7,1,"ちい"],[10,2,"まきもの"],[13,1,"て"],[15,1,"も"],[25,2,"みぎあし"],[28,1,"うみ"],[30,1,"うえ"],[33,2,"ひだりあし"],[36,1,"ち"],[38,1,"うえ"],[40,1,"ふ"]],"text":"彼は、開かれた小さな巻物を手に持っていた。そして、右足を海の上に、左足を地の上に踏みおろして、"},{"ref":"Rev.10.3","start":66010003,"end":66010003,"break":"none","ruby":[[9,2,"おおごえ"],[12,1,"さけ"],[16,1,"かれ"],[18,1,"さけ"],[25,1,"かみなり"],[33,1,"こえ"],[35,1,"はっ"]],"text":"ししがほえるように大声で叫んだ。彼が叫ぶと、七つの雷がおのおのその声を発した。"},{"ref":"Rev.10.4","start":66010004,"end":66010004,"break":"none","ruby":[[3,1,"かみなり"],[5,1,"こえ"],[7,1,"はっ"],[10,1,"とき"],[19,1,"か"],[33,1,"てん"],[36,1,"こえ"],[46,1,"かみなり"],[48,1,"かた"],[54,2,"ふういん"],[62,1,"か"],[70,1,"い"],[74,1,"き"]],"text":"七つの雷が声を発した時、わたしはそれを書きとめようとした。すると、天から声があって、「七つの雷の語ったことを封印せよ。それを書きとめるな」と言うのを聞いた。"},{"ref":"Rev.10.5","start":66010005,"end":66010005,"break":"none","ruby":[[5,1,"うみ"],[7,1,"ち"],[9,1,"うえ"],[11,1,"た"],[22,1,"み"],[26,2,"みつかい"],[30,1,"てん"],[35,2,"みぎて"],[38,1,"あ"]],"text":"それから、海と地の上に立っているのをわたしが見たあの御使は、天にむけて右手を上げ、"},{"ref":"Rev.10.6","start":66010006,"end":66010006,"break":"none","ruby":[[0,1,"てん"],[4,1,"なか"],[11,1,"ち"],[15,1,"なか"],[22,1,"うみ"],[26,1,"なか"],[33,1,"つく"],[36,2,"よよ"],[38,1,"かぎ"],[42,1,"い"],[55,1,"ちか"],[62,1,"とき"]],"text":"天とその中にあるもの、地とその中にあるもの、海とその中にあるものを造り、世々限りなく生きておられるかたをさして誓った、「もう時がない。"},{"ref":"Rev.10.7","start":66010007,"end":66010007,"break":"none","ruby":[[0,1,"だい"],[3,2,"みつかい"],[6,1,"ふ"],[8,1,"な"],[15,1,"おと"],[19,1,"とき"],[23,1,"かみ"],[27,1,"しもべ"],[29,3,"よげんしゃ"],[36,1,"つ"],[46,1,"かみ"],[48,2,"おくぎ"],[51,2,"じょうじゅ"]],"text":"第七の御使が吹き鳴らすラッパの音がする時には、神がその僕、預言者たちにお告げになったとおり、神の奥義は成就される」。"},{"ref":"Rev.10.8","start":66010008,"end":66010008,"break":"none","ruby":[[4,1,"まえ"],[6,1,"てん"],[9,1,"きこ"],[14,1,"こえ"],[23,1,"かた"],[26,1,"い"],[33,1,"い"],[37,1,"うみ"],[39,1,"ち"],[42,1,"うえ"],[44,1,"た"],[49,2,"みつかい"],[52,1,"て"],[54,1,"ひら"],[60,2,"まきもの"],[64,1,"う"],[66,1,"と"]],"text":"すると、前に天から聞えてきた声が、またわたしに語って言った、「さあ行って、海と地との上に立っている御使の手に開かれている巻物を、受け取りなさい」。"},{"ref":"Rev.10.9","start":66010009,"end":66010009,"break":"none","ruby":[[10,2,"みつかい"],[16,1,"い"],[23,1,"ちい"],[26,2,"まきもの"],[29,1,"くだ"],[34,1,"い"],[42,1,"かれ"],[44,1,"い"],[49,1,"と"],[56,1,"た"],[70,1,"はら"],[73,1,"にが"],[77,1,"くち"],[80,1,"みつ"],[85,1,"あま"]],"text":"そこで、わたしはその御使のもとに行って、「その小さな巻物を下さい」と言った。すると、彼は言った、「取って、それを食べてしまいなさい。あなたの腹には苦いが、口には蜜のように甘い」。"},{"ref":"Rev.10.10","start":66010010,"end":66010010,"break":"none","ruby":[[4,2,"みつかい"],[7,1,"て"],[12,1,"ちい"],[15,2,"まきもの"],[18,1,"う"],[20,1,"と"],[23,1,"た"],[39,1,"くち"],[42,1,"みつ"],[47,1,"あま"],[56,1,"た"],[61,1,"はら"],[63,1,"にが"]],"text":"わたしは御使の手からその小さな巻物を受け取って食べてしまった。すると、わたしの口には蜜のように甘かったが、それを食べたら、腹が苦くなった。"},{"ref":"Rev.10.11","start":66010011,"end":66010011,"break":"none","ruby":[[2,1,"とき"],[12,2,"いちど"],[15,1,"おお"],[18,2,"みんぞく"],[21,2,"こくみん"],[24,2,"こくご"],[27,1,"おう"],[35,2,"よげん"],[46,1,"い"],[48,1,"こえ"]],"text":"その時、「あなたは、もう一度、多くの民族、国民、国語、王たちについて、預言せねばならない」と言う声がした。"}]