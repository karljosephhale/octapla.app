[{"ref":"2Sam.19.1","start":10019001,"end":10019001,"break":"paragraph","ruby":[[0,1,"とき"],[6,1,"つ"],[9,1,"もの"],[16,1,"み"],[19,1,"おう"],[30,1,"な"],[32,1,"かな"],[40,1,"い"]],"text":"時にヨアブに告げる者があって、「見よ、王はアブサロムのために泣き悲しんでいる」と言った。"},{"ref":"2Sam.19.2","start":10019002,"end":10019002,"break":"none","ruby":[[6,1,"ひ"],[8,2,"しょうり"],[15,1,"たみ"],[17,1,"かな"],[30,1,"ひ"],[32,1,"たみ"],[36,1,"おう"],[40,1,"こ"],[45,1,"かな"],[53,1,"ひと"],[55,1,"い"],[59,1,"き"]],"text":"こうしてその日の勝利はすべての民の悲しみとなった。それはその日、民が、「王はその子のために悲しんでいる」と人の言うのを聞いたからである。"},{"ref":"2Sam.19.3","start":10019003,"end":10019003,"break":"none","ruby":[[3,1,"たみ"],[7,1,"ひ"],[9,1,"たたか"],[12,1,"に"],[15,1,"は"],[20,1,"たみ"],[38,1,"まち"]],"text":"そして民はその日、戦いに逃げて恥じている民がひそかに、はいるように、ひそかに町にはいった。"},{"ref":"2Sam.19.4","start":10019004,"end":10019004,"break":"none","ruby":[[0,1,"おう"],[2,1,"かお"],[12,1,"おう"],[14,2,"おおごえ"],[17,1,"さけ"],[24,1,"こ"],[40,1,"こ"],[45,1,"こ"],[49,1,"い"]],"text":"王は顔をおおった。そして王は大声に叫んで、「わが子アブサロムよ。アブサロム、わが子よ、わが子よ」と言った。"},{"ref":"2Sam.19.5","start":10019005,"end":10019005,"break":"none","ruby":[[0,1,"とき"],[6,1,"いえ"],[12,1,"おう"],[19,1,"い"],[37,1,"いのち"],[47,1,"むすめ"],[51,1,"いのち"],[60,1,"つま"],[64,1,"いのち"],[73,1,"いのち"],[75,1,"すく"],[82,2,"けらい"],[85,1,"かお"]],"text":"時にヨアブは家にはいり、王のもとにきて言った、「あなたは、きょう、あなたの命と、あなたのむすこ娘たちの命、およびあなたの妻たちの命と、めかけたちの命を救ったすべての家来の顔をはずかしめられました。"},{"ref":"2Sam.19.6","start":10019006,"end":10019006,"break":"none","ruby":[[7,2,"じぶん"],[10,1,"にく"],[12,1,"もの"],[14,1,"あい"],[17,2,"じぶん"],[20,1,"あい"],[23,1,"もの"],[25,1,"にく"],[43,1,"ぐん"],[45,1,"ちょう"],[58,1,"かえり"],[65,1,"しめ"],[80,1,"し"],[95,1,"い"],[106,1,"みな"],[110,1,"し"],[121,1,"め"]],"text":"それはあなたが自分を憎む者を愛し、自分を愛する者を憎まれるからです。あなたは、きょう、軍の長たちをも、しもべたちをも顧みないことを示されました。きょう、わたしは知りました。もし、アブサロムが生きていて、われわれが皆きょう死んでいたら、あなたの目にかなったでしょう。"},{"ref":"2Sam.19.7","start":10019007,"end":10019007,"break":"none","ruby":[[0,1,"いま"],[1,1,"た"],[4,1,"で"],[6,1,"い"],[21,1,"かた"],[33,1,"しゅ"],[38,1,"ちか"],[49,1,"で"],[58,2,"こんや"],[64,1,"とも"],[70,1,"もの"],[90,1,"わか"],[92,1,"とき"],[95,1,"いま"],[109,1,"わざわい"],[121,1,"わる"]],"text":"今立って出て行って、しもべたちにねんごろに語ってください。わたしは主をさして誓います。もしあなたが出られないならば、今夜あなたと共にとどまる者はひとりもないでしょう。これはあなたが若い時から今までにこうむられたすべての災よりも、あなたにとって悪いでしょう」。"},{"ref":"2Sam.19.8","start":10019008,"end":10019008,"break":"none","breaks":[[61,"paragraph"]],"ruby":[[3,1,"おう"],[5,1,"た"],[8,1,"もん"],[13,1,"ざ"],[19,2,"ひとびと"],[26,1,"たみ"],[30,1,"み"],[33,1,"おう"],[35,1,"もん"],[37,1,"ざ"],[44,1,"つ"],[50,1,"たみ"],[54,1,"おう"],[56,1,"まえ"],[75,2,"てんまく"],[78,1,"に"],[80,1,"かえ"]],"text":"そこで王は立って門のうちの座についた。人々はすべての民に、「見よ、王は門に座している」と告げたので、民はみな王の前にきた。さてイスラエルはおのおのその天幕に逃げ帰った。"},{"ref":"2Sam.19.9","start":10019009,"end":10019009,"break":"none","ruby":[[14,2,"ぶぞく"],[17,1,"なか"],[19,1,"たみ"],[23,1,"あらそ"],[26,1,"い"],[31,1,"おう"],[38,1,"てき"],[40,1,"て"],[43,1,"すく"],[45,1,"だ"],[62,1,"て"],[65,1,"たす"],[67,1,"だ"],[75,1,"いま"],[86,1,"くに"],[91,1,"に"]],"text":"そしてイスラエルのもろもろの部族の中で民はみな争って言った、「王はわれわれを敵の手から救い出し、またわれわれをペリシテびとの手から助け出された。しかし今はアブサロムのために国のそとに逃げておられる。"},{"ref":"2Sam.19.10","start":10019010,"end":10019010,"break":"none","ruby":[[7,1,"あぶら"],[9,1,"そそ"],[18,1,"うえ"],[20,1,"た"],[29,1,"たたか"],[32,1,"し"],[54,1,"おう"],[56,1,"みちび"],[68,1,"なに"],[71,1,"い"]],"text":"またわれわれが油を注いで、われわれの上に立てたアブサロムは戦いで死んだ。それであるのに、どうしてあなたがたは王を導きかえることについて、何をも言わないのか」。"},{"ref":"2Sam.19.11","start":10019011,"end":10019011,"break":"paragraph","ruby":[[3,1,"おう"],[5,2,"さいし"],[20,1,"ひと"],[27,1,"い"],[35,2,"ちょうろう"],[40,1,"い"],[47,1,"ぜん"],[54,2,"ことば"],[57,1,"おう"],[59,1,"たっ"],[75,1,"おう"],[79,1,"いえ"],[81,1,"みちび"],[86,2,"さいご"],[89,1,"もの"]],"text":"ダビデ王は祭司たちザドクとアビヤタルとに人をつかわして言った、「ユダの長老たちに言いなさい、『全イスラエルの言葉が王に達したのに、どうしてあなたがたは王をその家に導きかえる最後の者となるのですか。"},{"ref":"2Sam.19.12","start":10019012,"end":10019012,"break":"none","ruby":[[10,2,"きょうだい"],[17,2,"こつにく"],[29,1,"おう"],[31,1,"みちび"],[36,2,"さいご"],[39,1,"もの"]],"text":"あなたがたはわたしの兄弟、わたしの骨肉です。それにどうして王を導きかえる最後の者となるのですか』。"},{"ref":"2Sam.19.13","start":10019013,"end":10019013,"break":"none","ruby":[[6,1,"い"],[21,2,"こつにく"],[36,1,"のち"],[45,1,"か"],[53,1,"ぐん"],[55,1,"ちょう"],[72,1,"かみ"],[74,2,"いくえ"],[82,1,"ばっ"]],"text":"またアマサに言いなさい、『あなたはわたしの骨肉ではありませんか。これから後あなたをヨアブに代えて、わたしの軍の長とします。もしそうしないときは、神が幾重にもわたしを罰してくださるように』」。"},{"ref":"2Sam.19.14","start":10019014,"end":10019014,"break":"none","ruby":[[15,1,"ひと"],[17,1,"こころ"],[27,2,"じぶん"],[30,1,"かたむ"],[38,1,"かれ"],[41,1,"おう"],[57,2,"けらい"],[62,1,"かえ"],[73,1,"い"]],"text":"こうしてダビデはユダのすべての人の心を、ひとりのように自分に傾けさせたので、彼らは王に、「どうぞあなたも、すべての家来たちも帰ってきてください」と言いおくった。"},{"ref":"2Sam.19.15","start":10019015,"end":10019015,"break":"none","ruby":[[3,1,"おう"],[5,1,"かえ"],[16,1,"く"],[23,1,"ひと"],[24,1,"ひと"],[26,1,"おう"],[28,1,"むか"],[41,1,"おう"],[48,1,"わた"]],"text":"そこで王は帰ってきてヨルダンまで来ると、ユダの人人は王を迎えるためギルガルにきて、王にヨルダンを渡らせた。"},{"ref":"2Sam.19.16","start":10019016,"end":10019016,"break":"paragraph","ruby":[[16,1,"こ"],[22,1,"いそ"],[28,2,"ひとびと"],[31,1,"とも"],[33,1,"くだ"],[42,1,"おう"],[44,1,"むか"]],"text":"バホリムのベニヤミンびと、ゲラの子シメイは、急いでユダの人々と共に下ってきて、ダビデ王を迎えた。"},{"ref":"2Sam.19.17","start":10019017,"end":10019017,"break":"none","ruby":[[2,1,"にん"],[12,1,"かれ"],[14,1,"とも"],[25,1,"いえ"],[37,1,"にん"],[46,1,"にん"],[52,1,"したが"],[56,1,"おう"],[58,1,"まえ"],[65,1,"か"],[67,1,"くだ"]],"text":"一千人のベニヤミンびとが彼と共にいた。またサウルの家のしもべヂバもその十五人のむすこと、二十人のしもべを従えて、王の前にヨルダンに駆け下った。"},{"ref":"2Sam.19.18","start":10019018,"end":10019018,"break":"none","ruby":[[3,1,"おう"],[5,2,"かぞく"],[8,1,"わた"],[11,1,"おう"],[13,1,"こころ"],[25,1,"わた"],[27,1,"ば"],[29,1,"わた"],[36,1,"こ"],[46,1,"わた"],[52,1,"とき"],[54,1,"おう"],[56,1,"まえ"],[60,1,"ふ"]],"text":"そして王の家族を渡し、王の心にかなうことをしようと渡し場を渡った。ゲラの子シメイはヨルダンを渡ろうとする時、王の前にひれ伏し、"},{"ref":"2Sam.19.19","start":10019019,"end":10019019,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[12,1,"きみ"],[15,1,"つみ"],[21,1,"き"],[35,1,"きみ"],[37,1,"おう"],[45,1,"で"],[49,1,"ひ"],[61,1,"わる"],[63,1,"こと"],[65,1,"おも"],[67,1,"だ"],[79,1,"おう"],[84,1,"こころ"],[86,1,"と"]],"text":"王に言った、「どうぞわが君が、罪をわたしに帰しられないように。またわが君、王のエルサレムを出られた日に、しもべがおこなった悪い事を思い出されないように。どうぞ王がそれを心に留められないように。"},{"ref":"2Sam.19.20","start":10019020,"end":10019020,"break":"none","ruby":[[4,2,"じぶん"],[7,1,"つみ"],[9,1,"おか"],[15,1,"し"],[27,1,"み"],[42,2,"ぜんか"],[47,1,"さき"],[49,1,"くだ"],[57,1,"しゅ"],[59,1,"おう"],[61,1,"むか"]],"text":"しもべは自分が罪を犯したことを知っています。それゆえ、見よ、わたしはきょう、ヨセフの全家のまっ先に下ってきて、わが主、王を迎えるのです」。"},{"ref":"2Sam.19.21","start":10019021,"end":10019021,"break":"none","ruby":[[4,1,"こ"],[11,1,"こた"],[14,1,"い"],[23,1,"しゅ"],[25,1,"あぶら"],[27,1,"そそ"],[31,1,"もの"],[45,1,"ころ"]],"text":"ゼルヤの子アビシャイは答えて言った、「シメイは主が油を注がれた者をのろったので、そのために殺されるべきではありませんか」。"},{"ref":"2Sam.19.22","start":10019022,"end":10019022,"break":"none","ruby":[[4,1,"い"],[18,1,"こ"],[54,2,"てきたい"],[74,1,"ひと"],[76,1,"ころ"],[79,1,"よ"],[99,1,"おう"],[112,2,"じぶん"],[115,1,"し"]],"text":"ダビデは言った、「あなたがたゼルヤの子たちよ、あなたがたとなにのかかわりがあって、あなたがたはきょうわたしに敵対するのか。きょう、イスラエルのうちで人を殺して良かろうか。わたしが、きょうイスラエルの王となったことを、どうして自分で知らないことがあろうか」。"},{"ref":"2Sam.19.23","start":10019023,"end":10019023,"break":"none","ruby":[[4,1,"おう"],[16,1,"ころ"],[22,1,"い"],[26,1,"おう"],[28,1,"かれ"],[30,1,"ちか"]],"text":"こうして王はシメイに、「あなたを殺さない」と言って、王は彼に誓った。"},{"ref":"2Sam.19.24","start":10019024,"end":10019024,"break":"paragraph","ruby":[[4,1,"こ"],[11,1,"くだ"],[16,1,"おう"],[18,1,"むか"],[22,1,"かれ"],[24,1,"おう"],[26,1,"さ"],[29,1,"ひ"],[32,1,"やす"],[36,1,"かえ"],[38,1,"ひ"],[44,1,"あし"],[46,1,"かざ"],[55,1,"ととの"],[63,2,"きもの"],[66,1,"あら"]],"text":"サウルの子メピボセテは下ってきて王を迎えた。彼は王が去った日から安らかに帰る日まで、その足を飾らず、そのひげを整えず、またその着物を洗わなかった。"},{"ref":"2Sam.19.25","start":10019025,"end":10019025,"break":"none","ruby":[[0,1,"かれ"],[11,1,"おう"],[13,1,"むか"],[16,1,"とき"],[18,1,"おう"],[20,1,"かれ"],[22,1,"い"],[46,1,"とも"],[48,1,"い"]],"text":"彼がエルサレムからきて王を迎えた時、王は彼に言った、「メピボセテよ、あなたはどうしてわたしと共に行かなかったのか」。"},{"ref":"2Sam.19.26","start":10019026,"end":10019026,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こた"],[9,1,"しゅ"],[11,1,"おう"],[18,2,"けらい"],[25,1,"あざむ"],[36,1,"かれ"],[54,1,"お"],[64,1,"の"],[67,1,"おう"],[69,1,"とも"],[71,1,"い"],[75,1,"い"],[86,1,"あし"]],"text":"彼は答えた、「わが主、王よ、わたしの家来がわたしを欺いたのです。しもべは彼に、『わたしのために、ろばにくらを置け。わたしはそれに乗って王と共に行く』と言ったのです。しもべは足なえだからです。"},{"ref":"2Sam.19.27","start":10019027,"end":10019027,"break":"none","ruby":[[4,1,"かれ"],[15,1,"しゅ"],[17,1,"おう"],[19,1,"まえ"],[27,1,"い"],[40,1,"しゅ"],[42,1,"おう"],[44,1,"かみ"],[46,1,"つかい"],[67,1,"よ"],[70,1,"おも"]],"text":"ところが彼はしもべのことをわが主、王の前に、あしざまに言ったのです。しかし、わが主、王は神の使のようでいらせられます。それで、あなたの良いと思われることをしてください。"},{"ref":"2Sam.19.28","start":10019028,"end":10019028,"break":"none","ruby":[[4,1,"ちち"],[6,2,"ぜんか"],[11,1,"しゅ"],[13,1,"おう"],[15,1,"まえ"],[20,1,"し"],[23,1,"ひと"],[45,2,"しょくたく"],[48,2,"しょくじ"],[53,2,"ひとびと"],[59,1,"お"],[73,2,"けんり"],[80,1,"かさ"],[83,1,"おう"],[85,1,"うった"]],"text":"わたしの父の全家はわが主、王の前にはみな死んだ人にすぎないのに、あなたはしもべを、あなたの食卓で食事をする人々のうちに置かれました。わたしになんの権利があって、重ねて王に訴えることができましょう」。"},{"ref":"2Sam.19.29","start":10019029,"end":10019029,"break":"none","ruby":[[0,1,"おう"],[2,1,"かれ"],[4,1,"い"],[20,2,"じぶん"],[26,1,"い"],[37,1,"き"],[53,2,"とち"],[56,1,"わ"]],"text":"王は彼に言った、「あなたはどうしてなおも自分のことを言うのですか。わたしは決めました。あなたとヂバとはその土地を分けなさい」。"},{"ref":"2Sam.19.30","start":10019030,"end":10019030,"break":"none","ruby":[[6,1,"おう"],[8,1,"い"],[15,1,"しゅ"],[17,1,"おう"],[19,1,"やす"],[23,1,"いえ"],[25,1,"かえ"],[35,1,"かれ"],[42,1,"と"]],"text":"メピボセテは王に言った、「わが主、王が安らかに家に帰られたのですから、彼にそれをみな取らせてください」。"},{"ref":"2Sam.19.31","start":10019031,"end":10019031,"break":"paragraph","ruby":[[20,1,"くだ"],[31,1,"おう"],[33,2,"みおく"],[39,1,"おう"],[41,1,"とも"],[48,1,"すす"]],"text":"さてギレアデびとバルジライはロゲリムから下ってきて、ヨルダンで王を見送るため、王と共にヨルダンに進んだ。"},{"ref":"2Sam.19.32","start":10019032,"end":10019032,"break":"none","ruby":[[12,2,"としお"],[16,1,"ひと"],[20,1,"さい"],[26,1,"かれ"],[36,2,"ゆうふく"],[39,1,"ひと"],[47,1,"おう"],[62,1,"あいだ"],[64,1,"おう"],[66,1,"やしな"]],"text":"バルジライは、ひじょうに年老いた人で八十歳であった。彼はまた、ひじょうに裕福な人であったので、王がマハナイムにとどまっている間、王を養った。"},{"ref":"2Sam.19.33","start":10019033,"end":10019033,"break":"none","ruby":[[0,1,"おう"],[8,1,"い"],[17,2,"いっしょ"],[20,1,"わた"],[23,1,"い"],[47,1,"とも"],[53,1,"やしな"]],"text":"王はバルジライに言った、「わたしと一緒に渡って行きなさい。わたしはエルサレムであなたをわたしと共におらせて養いましょう」。"},{"ref":"2Sam.19.34","start":10019034,"end":10019034,"break":"none","ruby":[[6,1,"おう"],[8,1,"い"],[20,1,"なに"],[21,1,"ねん"],[32,1,"おう"],[34,1,"とも"],[42,1,"のぼ"]],"text":"バルジライは王に言った、「わたしは、なお何年いきながらえるので、王と共にエルサレムに上るのですか。"},{"ref":"2Sam.19.35","start":10019035,"end":10019035,"break":"none","ruby":[[4,2,"こんにち"],[8,1,"さい"],[17,1,"よ"],[21,1,"わる"],[43,1,"た"],[49,1,"の"],[54,1,"あじ"],[72,1,"うた"],[74,1,"おとこ"],[76,1,"うた"],[78,1,"おんな"],[80,1,"こえ"],[84,1,"き"],[117,1,"しゅ"],[119,1,"おう"],[121,2,"おもに"]],"text":"わたしは今日八十歳です。わたしに、良いこと悪いことがわきまえられるでしょうか。しもべは食べるもの、飲むものを味わうことができましょうか。わたしは歌う男や歌う女の声をまだ聞くことができましょうか。それであるのに、しもべはどうしてなおわが主、王の重荷となってよろしいでしょうか。"},{"ref":"2Sam.19.36","start":10019036,"end":10019036,"break":"none","ruby":[[4,1,"おう"],[6,1,"とも"],[13,1,"わた"],[19,1,"すこ"],[21,1,"い"],[32,1,"おう"],[39,1,"むく"],[46,1,"むく"]],"text":"しもべは王と共にヨルダンを渡って、ただ少し行きましょう。どうして王はこのような報いをわたしに報いられなければならないのでしょうか。"},{"ref":"2Sam.19.37","start":10019037,"end":10019037,"break":"none","ruby":[[7,1,"かえ"],[20,2,"じぶん"],[23,1,"まち"],[26,2,"ふぼ"],[29,1,"はか"],[31,1,"ちか"],[34,1,"し"],[65,1,"しゅ"],[67,1,"おう"],[69,1,"とも"],[71,1,"かれ"],[73,1,"わた"],[76,1,"い"],[91,1,"よ"],[94,1,"おも"],[98,1,"こと"],[100,1,"かれ"]],"text":"どうぞしもべを帰らせてください。わたしは自分の町で、父母の墓の近くで死にます。ただし、あなたのしもべキムハムがここにおります。わが主、王と共に彼を渡って行かせてください。またあなたが良いと思われる事を彼にしてください」。"},{"ref":"2Sam.19.38","start":10019038,"end":10019038,"break":"none","ruby":[[0,1,"おう"],[2,1,"こた"],[16,1,"とも"],[18,1,"わた"],[21,1,"い"],[36,1,"よ"],[39,1,"おも"],[43,1,"こと"],[45,1,"かれ"],[59,1,"のぞ"]],"text":"王は答えた、「キムハムはわたしと共に渡って行かせます。わたしは、あなたが良いと思われる事を彼にしましょう。またあなたが望まれることはみな、あなたのためにいたします」。"},{"ref":"2Sam.19.39","start":10019039,"end":10019039,"break":"none","ruby":[[4,1,"たみ"],[13,1,"わた"],[17,1,"おう"],[19,1,"わた"],[22,1,"とき"],[30,1,"くち"],[36,2,"しゅくふく"],[43,1,"かれ"],[45,2,"じぶん"],[48,1,"いえ"],[50,1,"かえ"]],"text":"こうして民はみなヨルダンを渡った。王は渡った時、バルジライに口づけして、祝福したので、彼は自分の家に帰っていった。"},{"ref":"2Sam.19.40","start":10019040,"end":10019040,"break":"none","ruby":[[0,1,"おう"],[7,1,"すす"],[16,1,"かれ"],[18,1,"とも"],[20,1,"すす"],[27,1,"たみ"],[31,1,"おう"],[33,1,"おく"],[42,1,"たみ"],[44,1,"なか"]],"text":"王はギルガルに進んだ。キムハムも彼と共に進んだ。ユダの民はみな王を送り、イスラエルの民の半ばもまたそうした。"},{"ref":"2Sam.19.41","start":10019041,"end":10019041,"break":"paragraph","ruby":[[8,2,"ひとびと"],[13,1,"おう"],[15,1,"ところ"],[20,1,"おう"],[22,1,"い"],[32,2,"きょうだい"],[40,2,"ひとびと"],[44,1,"なに"],[52,1,"ぬす"],[54,1,"さ"],[58,1,"おう"],[62,2,"かぞく"],[72,1,"ともな"],[81,2,"じゅうしゃ"],[89,1,"わた"]],"text":"さてイスラエルの人々はみな王の所にきて、王に言った、「われわれの兄弟であるユダの人々は、何ゆえにあなたを盗み去って、王とその家族、およびダビデに伴っているすべての従者にヨルダンを渡らせたのですか」。"},{"ref":"2Sam.19.42","start":10019042,"end":10019042,"break":"none","ruby":[[3,2,"ひとびと"],[14,2,"ひとびと"],[17,1,"こた"],[22,1,"おう"],[29,2,"きんしん"],[49,1,"こと"],[51,1,"いか"],[65,1,"すこ"],[69,1,"おう"],[71,1,"もの"],[73,1,"た"],[85,1,"おう"],[87,1,"なに"],[89,2,"たまもの"],[97,1,"あた"]],"text":"ユダの人々はみなイスラエルの人々に答えた、「王はわれわれの近親だからです。あなたがたはどうしてこの事で怒られるのですか。われわれが少しでも王の物を食べたことがありますか。王が何か賜物をわれわれに与えたことがありますか」。"},{"ref":"2Sam.19.43","start":10019043,"end":10019043,"break":"none","ruby":[[6,2,"ひとびと"],[12,2,"ひとびと"],[15,1,"こた"],[25,1,"おう"],[32,1,"ぶん"],[34,1,"も"],[64,1,"おお"],[67,1,"も"],[97,1,"かろ"],[110,1,"おう"],[112,1,"みちび"],[114,1,"かえ"],[118,2,"さいしょ"],[121,1,"い"],[146,2,"ひとびと"],[149,2,"ことば"],[158,2,"ひとびと"],[161,2,"ことば"],[166,1,"はげ"]],"text":"イスラエルの人々はユダの人々に答えた、「われわれは王のうちに十の分を持っています。またダビデのうちにもわれわれはあなたがたよりも多くを持っています。それであるのに、どうしてあなたがたはわれわれを軽んじたのですか。われらの王を導き帰ろうと最初に言ったのはわれわれではないのですか」。しかしユダの人々の言葉はイスラエルの人々の言葉よりも激しかった。"}]