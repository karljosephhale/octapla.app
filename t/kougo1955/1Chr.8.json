[{"ref":"1Chr.8.1","start":13008001,"end":13008001,"break":"paragraph","ruby":[[6,1,"う"],[9,1,"もの"],[11,2,"ちょうし"],[19,1,"つぎ"],[26,1,"だい"]],"text":"ベニヤミンの生んだ者は長子はベラ、その次はアシベル、第三はアハラ、"},{"ref":"1Chr.8.2","start":13008002,"end":13008002,"break":"none","ruby":[[0,1,"だい"],[6,1,"だい"]],"text":"第四はノハ、第五はラパ。"},{"ref":"1Chr.8.3","start":13008003,"end":13008003,"break":"none","ruby":[[3,1,"こ"]],"text":"ベラの子らはアダル、ゲラ、アビウデ、"},{"ref":"1Chr.8.4","start":13008004,"end":13008004,"break":"none","text":"アビシュア、ナアマン、アホア、"},{"ref":"1Chr.8.5","start":13008005,"end":13008005,"break":"none","text":"ゲラ、シフパム、ヒラム。"},{"ref":"1Chr.8.6","start":13008006,"end":13008006,"break":"none","ruby":[[4,1,"こ"],[7,1,"つぎ"],[24,2,"じゅうみん"],[27,2,"しぞく"],[30,1,"ちょう"],[41,1,"とら"],[43,1,"うつ"]],"text":"エホデの子らは次のとおりである。（これらはゲバの住民の氏族の長であって、マナハテに捕え移されたものである。）"},{"ref":"1Chr.8.7","start":13008007,"end":13008007,"break":"none","ruby":[[35,1,"ちち"]],"text":"すなわちナアマン、アヒヤ、ゲラすなわちヘグラム。ゲラはウザとアヒフデの父であった。"},{"ref":"1Chr.8.8","start":13008008,"end":13008008,"break":"none","ruby":[[7,1,"つま"],[16,2,"りべつ"],[27,1,"くに"],[29,1,"こ"]],"text":"シャハライムは妻ホシムとバアラを離別してのち、モアブの国で子らをもうけた。"},{"ref":"1Chr.8.9","start":13008009,"end":13008009,"break":"none","ruby":[[0,1,"かれ"],[2,1,"つま"],[14,1,"こ"]],"text":"彼が妻ホデシによってもうけた子らはヨバブ、ヂビア、メシャ、マルカム、"},{"ref":"1Chr.8.10","start":13008010,"end":13008010,"break":"none","ruby":[[19,1,"こ"],[25,2,"しぞく"],[28,1,"ちょう"]],"text":"エウヅ、シャキヤ、ミルマ。これらはその子らであって氏族の長である。"},{"ref":"1Chr.8.11","start":13008011,"end":13008011,"break":"none","ruby":[[0,1,"かれ"]],"text":"彼はまたホシムによってアビトブとエルパアルをもうけた。"},{"ref":"1Chr.8.12","start":13008012,"end":13008012,"break":"none","ruby":[[6,1,"こ"],[24,1,"かれ"],[34,2,"むらむら"],[37,1,"た"],[40,1,"もの"]],"text":"エルパアルの子らはエベル、ミシャムおよびセメド。彼はオノとロドとその村々を建てた者である。"},{"ref":"1Chr.8.13","start":13008013,"end":13008013,"break":"none","ruby":[[22,2,"じゅうみん"],[25,2,"しぞく"],[28,1,"ちょう"],[37,2,"じゅうみん"],[40,1,"お"],[42,1,"はら"]],"text":"またベリアとシマがあった。（これはアヤロンの住民の氏族の長であって、ガテの住民を追い払ったものである。）"},{"ref":"1Chr.8.14","start":13008014,"end":13008014,"break":"none","text":"またアヒオ、シャシャク、エレモテ。"},{"ref":"1Chr.8.15","start":13008015,"end":13008015,"break":"none","text":"ゼバデヤ、アラデ、アデル、"},{"ref":"1Chr.8.16","start":13008016,"end":13008016,"break":"none","ruby":[[18,1,"こ"]],"text":"ミカエル、イシパおよびヨハはベリアの子らであった。"},{"ref":"1Chr.8.17","start":13008017,"end":13008017,"break":"none","text":"ゼバデヤ、メシュラム、ヘゼキ、ヘベル、"},{"ref":"1Chr.8.18","start":13008018,"end":13008018,"break":"none","ruby":[[23,1,"こ"]],"text":"イシメライ、エズリアおよびヨバブはエルパアルの子らであった。"},{"ref":"1Chr.8.19","start":13008019,"end":13008019,"break":"none","text":"ヤキン、ジクリ、ザベデ、"},{"ref":"1Chr.8.20","start":13008020,"end":13008020,"break":"none","text":"エリエナイ、チルタイ、エリエル、"},{"ref":"1Chr.8.21","start":13008021,"end":13008021,"break":"none","ruby":[[18,1,"こ"]],"text":"アダヤ、ベラヤおよびシムラテはシマの子らであった。"},{"ref":"1Chr.8.22","start":13008022,"end":13008022,"break":"none","text":"イシパン、ヘベル、エリエル、"},{"ref":"1Chr.8.23","start":13008023,"end":13008023,"break":"none","text":"アブドン、ジクリ、ハナン、"},{"ref":"1Chr.8.24","start":13008024,"end":13008024,"break":"none","text":"ハナニヤ、エラム、アントテヤ、"},{"ref":"1Chr.8.25","start":13008025,"end":13008025,"break":"none","ruby":[[18,1,"こ"]],"text":"イペデヤおよびペヌエルはシャシャクの子らであった。"},{"ref":"1Chr.8.26","start":13008026,"end":13008026,"break":"none","text":"シャムセライ、シハリア、アタリヤ、"},{"ref":"1Chr.8.27","start":13008027,"end":13008027,"break":"none","ruby":[[20,1,"こ"]],"text":"ヤレシャ、エリヤおよびジクリはエロハムの子らであった。"},{"ref":"1Chr.8.28","start":13008028,"end":13008028,"break":"none","ruby":[[4,2,"れきだい"],[7,2,"しぞく"],[10,1,"ちょう"],[31,1,"す"]],"text":"これらは歴代の氏族の長であり、またかしらであって、エルサレムに住んだ。"},{"ref":"1Chr.8.29","start":13008029,"end":13008029,"break":"paragraph","ruby":[[5,1,"ちち"],[16,1,"す"],[21,1,"つま"],[23,1,"な"]],"text":"ギベオンの父エイエルはギベオンに住み、その妻の名はマアカといった。"},{"ref":"1Chr.8.30","start":13008030,"end":13008030,"break":"none","ruby":[[2,2,"ちょうし"],[11,1,"つぎ"]],"text":"その長子はアブドンで、次はツル、キシ、バアル、ナダブ、"},{"ref":"1Chr.8.31","start":13008031,"end":13008031,"break":"none","text":"ゲドル、アヒオ、ザケル、"},{"ref":"1Chr.8.32","start":13008032,"end":13008032,"break":"none","ruby":[[17,1,"う"],[27,2,"きょうだい"],[32,1,"む"],[44,1,"す"]],"text":"およびミクロテ。ミクロテはシメアを生んだ。これらもまた兄弟たちと向かいあってエルサレムに住んだ。"},{"ref":"1Chr.8.33","start":13008033,"end":13008033,"break":"none","ruby":[[6,1,"う"],[16,1,"う"],[47,1,"う"]],"text":"ネルはキシを生み、キシはサウルを生み、サウルはヨナタン、マルキシュア、アビナダブ、エシバアルを生んだ。"},{"ref":"1Chr.8.34","start":13008034,"end":13008034,"break":"none","ruby":[[5,1,"こ"],[25,1,"う"]],"text":"ヨナタンの子はメリバアルで、メリバアルはミカエルを生んだ。"},{"ref":"1Chr.8.35","start":13008035,"end":13008035,"break":"none","ruby":[[3,1,"こ"]],"text":"ミカの子らはピトン、メレク、タレア、アハズである。"},{"ref":"1Chr.8.36","start":13008036,"end":13008036,"break":"none","ruby":[[9,1,"う"],[32,1,"う"],[42,1,"う"]],"text":"アハズはエホアダを生み、エホアダはアレメテ、アズマウテ、ジムリを生み、ジムリはモザを生み、"},{"ref":"1Chr.8.37","start":13008037,"end":13008037,"break":"none","ruby":[[7,1,"う"],[15,1,"こ"],[23,1,"こ"],[35,1,"こ"]],"text":"モザはビネアを生んだ。ビネアの子はラパ、ラパの子はエレアサ、エレアサの子はアゼルである。"},{"ref":"1Chr.8.38","start":13008038,"end":13008038,"break":"none","ruby":[[6,1,"にん"],[8,1,"こ"],[15,1,"な"],[48,1,"みな"],[53,1,"こ"]],"text":"アゼルには六人の子があり、その名はアズリカム、ボケル、イシマエル、シャリヤ、オバデヤ、ハナンで、皆アゼルの子である。"},{"ref":"1Chr.8.39","start":13008039,"end":13008039,"break":"none","ruby":[[2,2,"きょうだい"],[8,1,"こ"],[12,2,"ちょうし"],[19,1,"つぎ"],[25,1,"だい"]],"text":"その兄弟エセクの子らは、長子はウラム、次はエウシ、第三はエリペレテである。"},{"ref":"1Chr.8.40","start":13008040,"end":13008040,"break":"none","ruby":[[4,1,"こ"],[7,1,"だい"],[8,2,"ゆうし"],[14,1,"ゆみ"],[16,1,"い"],[18,1,"もの"],[24,1,"かれ"],[26,1,"おお"],[29,1,"こ"],[31,1,"まご"],[39,1,"にん"],[49,1,"みな"],[56,2,"しそん"]],"text":"ウラムの子らは大勇士で、よく弓を射る者であった。彼は多くの子と孫をもち、百五十人もあった。これらは皆ベニヤミンの子孫である。"}]