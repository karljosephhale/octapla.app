[{"ref":"Ps.73.1","start":19073001,"end":19073001,"break":"paragraph","title":"アサフの歌","breaks":[[11,"line"]],"ruby":[[0,1,"かみ"],[2,1,"ただ"],[5,1,"もの"],[11,1,"こころ"],[13,1,"きよ"],[15,1,"もの"],[26,1,"めぐ"]],"titleRuby":[[4,1,"うた"]],"text":"神は正しい者にむかい、心の清い者にむかって、まことに恵みふかい。"},{"ref":"Ps.73.2","start":19073002,"end":19073002,"break":"line","breaks":[[23,"line"]],"ruby":[[13,1,"あし"],[27,1,"あゆ"]],"text":"しかし、わたしは、わたしの足がつまずくばかり、わたしの歩みがすべるばかりであった。"},{"ref":"Ps.73.3","start":19073003,"end":19073003,"break":"line","breaks":[[21,"line"]],"ruby":[[8,1,"あ"],[11,1,"もの"],[13,1,"さか"],[18,1,"み"],[23,1,"たか"],[26,1,"もの"]],"text":"これはわたしが、悪しき者の栄えるのを見て、その高ぶる者をねたんだからである。"},{"ref":"Ps.73.4","start":19073004,"end":19073004,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[4,1,"くる"],[13,1,"み"]],"text":"彼らには苦しみがなく、その身はすこやかで、つやがあり、"},{"ref":"Ps.73.5","start":19073005,"end":19073005,"break":"line","breaks":[[17,"line"]],"ruby":[[3,2,"ひとびと"],[9,1,"なや"],[20,2,"ひとびと"],[26,1,"う"]],"text":"ほかの人々のように悩むことがなく、ほかの人々のように打たれることはない。"},{"ref":"Ps.73.6","start":19073006,"end":19073006,"break":"line","breaks":[[16,"line"]],"ruby":[[4,2,"こうまん"],[7,1,"かれ"],[10,1,"くび"],[11,1,"かざり"],[16,2,"ぼうりょく"],[19,1,"ころも"],[24,1,"かれ"]],"text":"それゆえ高慢は彼らの首飾となり、暴力は衣のように彼らをおおっている。"},{"ref":"Ps.73.7","start":19073007,"end":19073007,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こ"],[5,1,"ふと"],[11,1,"め"],[20,1,"こころ"],[22,1,"おろ"],[25,1,"おも"],[28,1,"み"]],"text":"彼らは肥え太って、その目はとびいで、その心は愚かな思いに満ちあふれている。"},{"ref":"Ps.73.8","start":19073008,"end":19073008,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[8,2,"あくい"],[14,1,"かた"],[17,1,"たか"],[27,1,"かた"]],"text":"彼らはあざけり、悪意をもって語り、高ぶって、しえたげを語る。"},{"ref":"Ps.73.9","start":19073009,"end":19073009,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[5,1,"くち"],[7,1,"てん"],[14,1,"お"],[19,1,"した"],[21,1,"ち"]],"text":"彼らはその口を天にさからって置き、その舌は地をあるきまわる。"},{"ref":"Ps.73.10","start":19073010,"end":19073010,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"たみ"],[6,1,"こころ"],[8,1,"か"],[11,1,"かれ"],[20,1,"かれ"],[31,1,"みと"]],"text":"それゆえ民は心を変えて彼らをほめたたえ、彼らのうちにあやまちを認めない。"},{"ref":"Ps.73.11","start":19073011,"end":19073011,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[7,1,"かみ"],[13,1,"し"],[15,1,"え"],[22,1,"たか"],[24,1,"もの"],[26,2,"ちしき"]],"text":"彼らは言う、「神はどうして知り得ようか、いと高き者に知識があろうか」と。"},{"ref":"Ps.73.12","start":19073012,"end":19073012,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"み"],[7,1,"あ"],[10,1,"もの"],[17,1,"つね"],[19,1,"やす"],[26,1,"とみ"],[28,1,"ま"],[30,1,"くわ"]],"text":"見よ、これらは悪しき者であるのに、常に安らかで、その富が増し加わる。"},{"ref":"Ps.73.13","start":19073013,"end":19073013,"break":"line","breaks":[[20,"line"]],"ruby":[[14,1,"こころ"],[20,1,"つみ"],[22,1,"おか"],[28,1,"て"],[30,1,"あら"]],"text":"まことに、わたしはいたずらに心をきよめ、罪を犯すことなく手を洗った。"},{"ref":"Ps.73.14","start":19073014,"end":19073014,"break":"line","breaks":[[12,"line"]],"ruby":[[8,1,"う"],[12,1,"あさ"],[16,1,"こら"]],"text":"わたしはひねもす打たれ、朝ごとに懲しめをうけた。"},{"ref":"Ps.73.15","start":19073015,"end":19073015,"break":"line","breaks":[[25,"line"]],"ruby":[[12,1,"こと"],[14,1,"かた"],[19,1,"い"],[33,1,"こ"],[36,1,"よ"],[38,1,"あやま"]],"text":"もしわたしが「このような事を語ろう」と言ったなら、わたしはあなたの子らの代を誤らせたであろう。"},{"ref":"Ps.73.16","start":19073016,"end":19073016,"break":"line","breaks":[[25,"line"]],"ruby":[[11,1,"し"],[15,1,"おも"],[37,2,"しごと"],[43,1,"おも"]],"text":"しかし、わたしがこれを知ろうと思いめぐらしたとき、これはわたしにめんどうな仕事のように思われた。"},{"ref":"Ps.73.17","start":19073017,"end":19073017,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"かみ"],[6,2,"せいじょ"],[9,1,"い"],[13,1,"かれ"],[16,2,"さいご"],[19,1,"さと"],[21,1,"え"]],"text":"わたしが神の聖所に行って、彼らの最後を悟り得たまではそうであった。"},{"ref":"Ps.73.18","start":19073018,"end":19073018,"break":"line","breaks":[[21,"line"]],"ruby":[[8,1,"かれ"],[16,1,"ところ"],[18,1,"お"],[21,1,"かれ"],[24,1,"ほろ"],[27,1,"おちい"]],"text":"まことにあなたは彼らをなめらかな所に置き、彼らを滅びに陥らせられる。"},{"ref":"Ps.73.19","start":19073019,"end":19073019,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"かれ"],[12,1,"ほろ"],[17,1,"おそ"],[23,1,"まった"],[25,2,"いっそう"]],"text":"なんと彼らはまたたくまに滅ぼされ、恐れをもって全く一掃されたことであろう。"},{"ref":"Ps.73.20","start":19073020,"end":19073020,"break":"line","breaks":[[10,"line"],[25,"line"]],"ruby":[[4,1,"め"],[10,1,"かれ"],[13,1,"かげ"],[25,1,"かれ"],[28,1,"ゆめ"],[31,1,"ひと"],[33,1,"め"],[39,1,"とき"]],"text":"あなたが目をさまして彼らの影をかろしめられるとき、彼らは夢みた人の目をさました時のようである。"},{"ref":"Ps.73.21","start":19073021,"end":19073021,"break":"line","ruby":[[4,1,"たましい"],[6,1,"いた"],[13,1,"こころ"],[15,1,"さ"]],"text":"わたしの魂が痛み、わたしの心が刺されたとき、"},{"ref":"Ps.73.22","start":19073022,"end":19073022,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"おろ"],[7,1,"さと"],[17,1,"たい"],[21,1,"けもの"]],"text":"わたしは愚かで悟りがなく、あなたに対しては獣のようであった。"},{"ref":"Ps.73.23","start":19073023,"end":19073023,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"つね"],[14,1,"とも"],[27,1,"みぎ"],[29,1,"て"],[31,1,"たも"]],"text":"けれどもわたしは常にあなたと共にあり、あなたはわたしの右の手を保たれる。"},{"ref":"Ps.73.24","start":19073024,"end":19073024,"break":"line","breaks":[[18,"line"]],"ruby":[[15,1,"みちび"],[20,1,"のち"],[25,1,"う"],[28,2,"えいこう"]],"text":"あなたはさとしをもってわたしを導き、その後わたしを受けて栄光にあずからせられる。"},{"ref":"Ps.73.25","start":19073025,"end":19073025,"break":"line","breaks":[[23,"line"]],"ruby":[[15,1,"てん"],[19,1,"え"],[23,1,"ち"],[33,1,"した"]],"text":"わたしはあなたのほかに、だれを天にもち得よう。地にはあなたのほかに慕うものはない。"},{"ref":"Ps.73.26","start":19073026,"end":19073026,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"み"],[6,1,"こころ"],[9,1,"おとろ"],[16,1,"かみ"],[25,1,"こころ"],[27,1,"ちから"],[31,1,"し"],[32,1,"ぎょう"]],"text":"わが身とわが心とは衰える。しかし神はとこしえにわが心の力、わが嗣業である。"},{"ref":"Ps.73.27","start":19073027,"end":19073027,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"み"],[7,1,"とお"],[9,1,"もの"],[11,1,"ほろ"],[27,1,"もの"],[29,1,"ほろ"]],"text":"見よ、あなたに遠い者は滅びる。あなたは、あなたにそむく者を滅ぼされる。"},{"ref":"Ps.73.28","start":19073028,"end":19073028,"break":"line","breaks":[[24,"line"],[42,"line"]],"ruby":[[3,1,"かみ"],[5,1,"ちか"],[16,1,"よ"],[28,1,"しゅ"],[31,1,"かみ"],[35,1,"さ"],[37,1,"どころ"],[55,1,"の"],[57,1,"つた"]],"text":"しかし神に近くあることはわたしに良いことである。わたしは主なる神をわが避け所として、あなたのもろもろのみわざを宣べ伝えるであろう。"}]