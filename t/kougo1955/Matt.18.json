[{"ref":"Matt.18.1","start":40018001,"end":40018001,"break":"paragraph","ruby":[[5,2,"でし"],[19,1,"い"],[29,2,"てんごく"],[40,1,"えら"]],"text":"そのとき、弟子たちがイエスのもとにきて言った、「いったい、天国ではだれがいちばん偉いのですか」。"},{"ref":"Matt.18.2","start":40018002,"end":40018002,"break":"none","ruby":[[8,1,"おさ"],[10,1,"ご"],[12,1,"よ"],[14,1,"よ"],[17,1,"かれ"],[22,1,"なか"],[24,1,"た"],[28,1,"い"]],"text":"すると、イエスは幼な子を呼び寄せ、彼らのまん中に立たせて言われた、"},{"ref":"Matt.18.3","start":40018003,"end":40018003,"break":"none","ruby":[[3,1,"き"],[9,1,"こころ"],[16,1,"おさ"],[18,1,"ご"],[30,2,"てんごく"]],"text":"「よく聞きなさい。心をいれかえて幼な子のようにならなければ、天国にはいることはできないであろう。"},{"ref":"Matt.18.4","start":40018004,"end":40018004,"break":"none","ruby":[[2,1,"おさ"],[4,1,"ご"],[9,2,"じぶん"],[12,1,"ひく"],[16,1,"もの"],[19,2,"てんごく"],[26,1,"えら"]],"text":"この幼な子のように自分を低くする者が、天国でいちばん偉いのである。"},{"ref":"Matt.18.5","start":40018005,"end":40018005,"break":"none","ruby":[[17,1,"おさ"],[19,1,"ご"],[26,1,"な"],[31,1,"う"],[36,1,"もの"],[43,1,"う"]],"text":"また、だれでも、このようなひとりの幼な子を、わたしの名のゆえに受けいれる者は、わたしを受けいれるのである。"},{"ref":"Matt.18.6","start":40018006,"end":40018006,"break":"none","ruby":[[8,1,"しん"],[15,1,"ちい"],[18,1,"もの"],[30,1,"もの"],[33,1,"おお"],[41,1,"くび"],[48,1,"うみ"],[50,1,"ふか"],[53,1,"しず"],[58,1,"ほう"],[63,1,"ひと"],[65,1,"えき"]],"text":"しかし、わたしを信ずるこれらの小さい者のひとりをつまずかせる者は、大きなひきうすを首にかけられて海の深みに沈められる方が、その人の益になる。"},{"ref":"Matt.18.7","start":40018007,"end":40018007,"break":"none","ruby":[[2,1,"よ"],[5,1,"つみ"],[7,2,"ゆうわく"],[23,1,"つみ"],[25,2,"ゆうわく"],[28,1,"かなら"],[30,1,"く"],[45,1,"ひと"]],"text":"この世は、罪の誘惑があるから、わざわいである。罪の誘惑は必ず来る。しかし、それをきたらせる人は、わざわいである。"},{"ref":"Matt.18.8","start":40018008,"end":40018008,"break":"none","ruby":[[6,2,"かたて"],[11,2,"かたあし"],[15,1,"つみ"],[17,1,"おか"],[27,1,"き"],[30,1,"す"],[36,2,"りょうて"],[39,2,"りょうあし"],[50,2,"えいえん"],[53,1,"ひ"],[55,1,"な"],[57,1,"こ"],[65,2,"かたて"],[68,2,"かたあし"],[74,1,"いのち"],[76,1,"はい"],[78,1,"ほう"]],"text":"もしあなたの片手または片足が、罪を犯させるなら、それを切って捨てなさい。両手、両足がそろったままで、永遠の火に投げ込まれるよりは、片手、片足になって命に入る方がよい。"},{"ref":"Matt.18.9","start":40018009,"end":40018009,"break":"none","ruby":[[6,2,"かため"],[9,1,"つみ"],[11,1,"おか"],[21,1,"ぬ"],[23,1,"だ"],[26,1,"す"],[32,1,"りょう"],[33,1,"がん"],[42,2,"じごく"],[45,1,"ひ"],[47,1,"な"],[49,1,"い"],[58,2,"かため"],[64,1,"いのち"],[66,1,"はい"],[68,1,"ほう"]],"text":"もしあなたの片目が罪を犯させるなら、それを抜き出して捨てなさい。両眼がそろったままで地獄の火に投げ入れられるよりは、片目になって命に入る方がよい。"},{"ref":"Matt.18.10","start":40018010,"end":40018010,"break":"none","ruby":[[11,1,"ちい"],[14,1,"もの"],[21,1,"かろ"],[30,1,"き"],[44,1,"い"],[48,1,"かれ"],[51,2,"みつかい"],[56,1,"てん"],[62,1,"てん"],[71,1,"ちち"],[74,1,"かお"],[79,1,"あお"]],"text":"あなたがたは、これらの小さい者のひとりをも軽んじないように、気をつけなさい。あなたがたに言うが、彼らの御使たちは天にあって、天にいますわたしの父のみ顔をいつも仰いでいるのである。〔"},{"ref":"Matt.18.11","start":40018011,"end":40018011,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[5,1,"ほろ"],[8,1,"もの"],[10,1,"すく"]],"text":"人の子は、滅びる者を救うためにきたのである。〕"},{"ref":"Matt.18.12","start":40018012,"end":40018012,"break":"none","ruby":[[8,1,"おも"],[14,1,"ひと"],[17,1,"ぴき"],[19,1,"ひつじ"],[26,1,"なか"],[29,1,"ぴき"],[31,1,"まよ"],[33,1,"で"],[43,1,"ひき"],[45,1,"やま"],[47,1,"のこ"],[56,1,"まよ"],[58,1,"で"],[62,1,"ひつじ"],[64,1,"さが"],[67,1,"で"]],"text":"あなたがたはどう思うか。ある人に百匹の羊があり、その中の一匹が迷い出たとすれば、九十九匹を山に残しておいて、その迷い出ている羊を捜しに出かけないであろうか。"},{"ref":"Matt.18.13","start":40018013,"end":40018013,"break":"none","ruby":[[5,1,"み"],[14,1,"き"],[20,1,"まよ"],[30,1,"ひき"],[44,1,"ぴき"],[49,1,"よろこ"]],"text":"もしそれを見つけたなら、よく聞きなさい、迷わないでいる九十九匹のためよりも、むしろその一匹のために喜ぶであろう。"},{"ref":"Matt.18.14","start":40018014,"end":40018014,"break":"none","ruby":[[10,1,"ちい"],[13,1,"もの"],[19,1,"ほろ"],[26,1,"てん"],[37,1,"ちち"]],"text":"そのように、これらの小さい者のひとりが滅びることは、天にいますあなたがたの父のみこころではない。"},{"ref":"Matt.18.15","start":40018015,"end":40018015,"break":"paragraph","ruby":[[6,2,"きょうだい"],[9,1,"つみ"],[11,1,"おか"],[16,1,"い"],[20,1,"かれ"],[28,1,"ところ"],[30,2,"ちゅうこく"],[39,1,"き"],[51,2,"きょうだい"],[54,1,"え"]],"text":"もしあなたの兄弟が罪を犯すなら、行って、彼とふたりだけの所で忠告しなさい。もし聞いてくれたら、あなたの兄弟を得たことになる。"},{"ref":"Matt.18.16","start":40018016,"end":40018016,"break":"none","ruby":[[2,1,"き"],[23,2,"いっしょ"],[26,1,"つ"],[29,1,"い"],[46,1,"にん"],[48,2,"しょうにん"],[51,1,"くち"],[66,1,"たし"]],"text":"もし聞いてくれないなら、ほかにひとりふたりを、一緒に連れて行きなさい。それは、ふたりまたは三人の証人の口によって、すべてのことがらが確かめられるためである。"},{"ref":"Matt.18.17","start":40018017,"end":40018017,"break":"none","ruby":[[2,1,"かれ"],[5,1,"い"],[10,1,"き"],[17,2,"きょうかい"],[20,1,"もう"],[22,1,"で"],[29,2,"きょうかい"],[32,1,"い"],[37,1,"き"],[46,1,"ひと"],[48,3,"いほうじん"],[54,3,"しゅぜいにん"],[57,2,"どうよう"],[60,1,"あつか"]],"text":"もし彼らの言うことを聞かないなら、教会に申し出なさい。もし教会の言うことも聞かないなら、その人を異邦人または取税人同様に扱いなさい。"},{"ref":"Matt.18.18","start":40018018,"end":40018018,"break":"none","ruby":[[2,1,"い"],[14,2,"ちじょう"],[24,1,"てん"],[27,1,"みな"],[39,2,"ちじょう"],[42,1,"と"],[48,1,"てん"],[53,1,"と"]],"text":"よく言っておく。あなたがたが地上でつなぐことは、天でも皆つながれ、あなたがたが地上で解くことは、天でもみな解かれるであろう。"},{"ref":"Matt.18.19","start":40018019,"end":40018019,"break":"none","ruby":[[5,1,"い"],[30,1,"ねが"],[32,1,"ごと"],[38,2,"ちじょう"],[41,1,"こころ"],[43,1,"あ"],[50,1,"てん"],[59,1,"ちち"],[68,1,"くだ"]],"text":"また、よく言っておく。もしあなたがたのうちのふたりが、どんな願い事についても地上で心を合わせるなら、天にいますわたしの父はそれをかなえて下さるであろう。"},{"ref":"Matt.18.20","start":40018020,"end":40018020,"break":"none","ruby":[[7,1,"にん"],[14,1,"な"],[19,1,"あつ"],[25,1,"ところ"],[35,1,"なか"]],"text":"ふたりまたは三人が、わたしの名によって集まっている所には、わたしもその中にいるのである」。"},{"ref":"Matt.18.21","start":40018021,"end":40018021,"break":"paragraph","ruby":[[18,1,"い"],[23,1,"しゅ"],[26,2,"きょうだい"],[33,1,"たい"],[36,1,"つみ"],[38,1,"おか"],[41,2,"ばあい"],[44,1,"いく"]],"text":"そのとき、ペテロがイエスのもとにきて言った、「主よ、兄弟がわたしに対して罪を犯した場合、幾たびゆるさねばなりませんか。七たびまでですか」。"},{"ref":"Matt.18.22","start":40018022,"end":40018022,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[23,1,"い"],[34,1,"ばい"]],"text":"イエスは彼に言われた、「わたしは七たびまでとは言わない。七たびを七十倍するまでにしなさい。"},{"ref":"Matt.18.23","start":40018023,"end":40018023,"break":"none","ruby":[[6,2,"てんごく"],[9,1,"おう"],[11,1,"しもべ"],[15,2,"けっさん"]],"text":"それだから、天国は王が僕たちと決算をするようなものだ。"},{"ref":"Matt.18.24","start":40018024,"end":40018024,"break":"none","ruby":[[0,2,"けっさん"],[3,1,"はじ"],[15,2,"ふさい"],[20,1,"もの"],[23,1,"おう"],[29,1,"つ"]],"text":"決算が始まると、一万タラントの負債のある者が、王のところに連れられてきた。"},{"ref":"Matt.18.25","start":40018025,"end":40018025,"break":"none","ruby":[[4,1,"かえ"],[13,2,"しゅじん"],[19,1,"ひと"],[20,2,"じしん"],[25,2,"さいし"],[28,1,"も"],[30,1,"もの"],[31,2,"ぜんぶ"],[35,1,"う"],[38,1,"かえ"],[43,1,"めい"]],"text":"しかし、返せなかったので、主人は、その人自身とその妻子と持ち物全部とを売って返すように命じた。"},{"ref":"Matt.18.26","start":40018026,"end":40018026,"break":"none","ruby":[[6,1,"しもべ"],[10,1,"ふ"],[13,2,"あいがん"],[23,1,"ま"],[30,2,"ぜんぶ"],[33,1,"かえ"]],"text":"そこで、この僕はひれ伏して哀願した、『どうぞお待ちください。全部お返しいたしますから』。"},{"ref":"Matt.18.27","start":40018027,"end":40018027,"break":"none","ruby":[[0,1,"しもべ"],[2,2,"しゅじん"],[9,1,"おも"],[13,1,"かれ"],[21,2,"ふさい"],[24,1,"めん"]],"text":"僕の主人はあわれに思って、彼をゆるし、その負債を免じてやった。"},{"ref":"Matt.18.28","start":40018028,"end":40018028,"break":"none","ruby":[[2,1,"しもべ"],[4,1,"で"],[6,1,"い"],[15,1,"か"],[24,2,"なかま"],[27,2,"であ"],[31,1,"かれ"],[38,1,"くび"],[44,2,"しゃっきん"],[47,1,"かえ"],[51,1,"い"]],"text":"その僕が出て行くと、百デナリを貸しているひとりの仲間に出会い、彼をつかまえ、首をしめて『借金を返せ』と言った。"},{"ref":"Matt.18.29","start":40018029,"end":40018029,"break":"none","ruby":[[5,2,"なかま"],[10,1,"ふ"],[17,1,"ま"],[23,1,"かえ"],[29,1,"い"],[32,1,"たの"]],"text":"そこでこの仲間はひれ伏し、『どうか待ってくれ。返すから』と言って頼んだ。"},{"ref":"Matt.18.30","start":40018030,"end":40018030,"break":"none","ruby":[[3,2,"しょうち"],[11,1,"ひと"],[18,1,"い"],[22,2,"しゃっきん"],[25,1,"かえ"],[29,1,"ごく"],[31,1,"い"]],"text":"しかし承知せずに、その人をひっぱって行って、借金を返すまで獄に入れた。"},{"ref":"Matt.18.31","start":40018031,"end":40018031,"break":"none","ruby":[[2,1,"ひと"],[4,2,"なかま"],[12,2,"ようす"],[15,1,"み"],[18,2,"ひじょう"],[21,1,"こころ"],[27,1,"い"],[39,2,"しゅじん"],[42,1,"はな"]],"text":"その人の仲間たちは、この様子を見て、非常に心をいため、行ってそのことをのこらず主人に話した。"},{"ref":"Matt.18.32","start":40018032,"end":40018032,"break":"none","ruby":[[5,2,"しゅじん"],[8,1,"かれ"],[10,1,"よ"],[15,1,"い"],[20,1,"わる"],[22,1,"しもべ"],[28,1,"ねが"],[38,2,"ふさい"],[41,2,"ぜんぶ"]],"text":"そこでこの主人は彼を呼びつけて言った、『悪い僕、わたしに願ったからこそ、あの負債を全部ゆるしてやったのだ。"},{"ref":"Matt.18.33","start":40018033,"end":40018033,"break":"none","ruby":[[18,2,"なかま"]],"text":"わたしがあわれんでやったように、あの仲間をあわれんでやるべきではなかったか』。"},{"ref":"Matt.18.34","start":40018034,"end":40018034,"break":"none","ruby":[[3,2,"しゅじん"],[6,2,"りっぷく"],[11,2,"ふさい"],[13,2,"ぜんぶ"],[16,1,"かえ"],[25,1,"かれ"],[27,2,"ごくり"],[30,1,"ひ"]],"text":"そして主人は立腹して、負債全部を返してしまうまで、彼を獄吏に引きわたした。"},{"ref":"Matt.18.35","start":40018035,"end":40018035,"break":"none","ruby":[[13,1,"こころ"],[16,2,"きょうだい"],[32,1,"てん"],[34,1,"ちち"],[44,1,"たい"]],"text":"あなたがためいめいも、もし心から兄弟をゆるさないならば、わたしの天の父もまたあなたがたに対して、そのようになさるであろう」。"}]