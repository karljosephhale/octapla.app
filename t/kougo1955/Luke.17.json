[{"ref":"Luke.17.1","start":42017001,"end":42017001,"break":"paragraph","ruby":[[4,2,"でし"],[9,1,"い"],[15,1,"つみ"],[17,2,"ゆうわく"],[20,1,"く"],[25,1,"さ"],[44,1,"もの"]],"text":"イエスは弟子たちに言われた、「罪の誘惑が来ることは避けられない。しかし、それをきたらせる者は、わざわいである。"},{"ref":"Luke.17.2","start":42017002,"end":42017002,"break":"none","ruby":[[4,1,"ちい"],[7,1,"もの"],[13,1,"つみ"],[15,2,"ゆうわく"],[32,1,"くび"],[39,1,"うみ"],[41,1,"な"],[43,1,"い"],[48,1,"ほう"]],"text":"これらの小さい者のひとりを罪に誘惑するよりは、むしろ、ひきうすを首にかけられて海に投げ入れられた方が、ましである。"},{"ref":"Luke.17.3","start":42017003,"end":42017003,"break":"none","ruby":[[7,2,"じぶん"],[10,2,"ちゅうい"],[25,2,"きょうだい"],[28,1,"つみ"],[30,1,"おか"],[35,1,"かれ"],[47,1,"く"],[49,1,"あらた"]],"text":"あなたがたは、自分で注意していなさい。もしあなたの兄弟が罪を犯すなら、彼をいさめなさい。そして悔い改めたら、ゆるしてやりなさい。"},{"ref":"Luke.17.4","start":42017004,"end":42017004,"break":"none","ruby":[[6,1,"たい"],[10,1,"にち"],[13,1,"ど"],[14,1,"つみ"],[16,1,"おか"],[23,1,"ど"],[25,1,"く"],[27,1,"あらた"],[33,1,"い"],[44,1,"かえ"]],"text":"もしあなたに対して一日に七度罪を犯し、そして七度『悔い改めます』と言ってあなたのところへ帰ってくれば、ゆるしてやるがよい」。"},{"ref":"Luke.17.5","start":42017005,"end":42017005,"break":"paragraph","ruby":[[0,2,"しと"],[5,1,"しゅ"],[14,2,"しんこう"],[17,1,"ま"],[26,1,"い"]],"text":"使徒たちは主に「わたしたちの信仰を増してください」と言った。"},{"ref":"Luke.17.6","start":42017006,"end":42017006,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"い"],[17,1,"だね"],[19,1,"つぶ"],[23,2,"しんこう"],[33,1,"くわ"],[35,1,"き"],[39,1,"ぬ"],[41,1,"だ"],[44,1,"うみ"],[46,1,"う"],[51,1,"い"],[61,2,"ことば"]],"text":"そこで主が言われた、「もし、からし種一粒ほどの信仰があるなら、この桑の木に、『抜け出して海に植われ』と言ったとしても、その言葉どおりになるであろう。"},{"ref":"Luke.17.7","start":42017007,"end":42017007,"break":"none","ruby":[[14,2,"こうさく"],[17,2,"ぼくちく"],[23,1,"しもべ"],[33,1,"しもべ"],[35,1,"はたけ"],[38,1,"かえ"],[41,1,"き"],[46,1,"かれ"],[54,2,"しょくたく"],[64,1,"い"]],"text":"あなたがたのうちのだれかに、耕作か牧畜かをする僕があるとする。その僕が畑から帰って来たとき、彼に『すぐきて、食卓につきなさい』と言うだろうか。"},{"ref":"Luke.17.8","start":42017008,"end":42017008,"break":"none","ruby":[[6,2,"ゆうしょく"],[9,2,"ようい"],[24,1,"の"],[26,1,"く"],[35,1,"おび"],[40,2,"きゅうじ"],[54,1,"の"],[56,1,"く"],[67,1,"い"]],"text":"かえって、『夕食の用意をしてくれ。そしてわたしが飲み食いをするあいだ、帯をしめて給仕をしなさい。そのあとで、飲み食いをするがよい』と、言うではないか。"},{"ref":"Luke.17.9","start":42017009,"end":42017009,"break":"none","ruby":[[0,1,"しもべ"],[2,1,"めい"],[19,2,"しゅじん"],[22,1,"かれ"],[24,2,"かんしゃ"]],"text":"僕が命じられたことをしたからといって、主人は彼に感謝するだろうか。"},{"ref":"Luke.17.10","start":42017010,"end":42017010,"break":"none","ruby":[[0,2,"どうよう"],[10,1,"めい"],[18,1,"みな"],[40,1,"しもべ"],[47,1,"こと"],[52,1,"す"],[59,1,"い"]],"text":"同様にあなたがたも、命じられたことを皆してしまったとき、『わたしたちはふつつかな僕です。すべき事をしたに過ぎません』と言いなさい」。"},{"ref":"Luke.17.11","start":42017011,"end":42017011,"break":"paragraph","ruby":[[10,1,"い"],[28,1,"あいだ"],[30,1,"とお"]],"text":"イエスはエルサレムへ行かれるとき、サマリヤとガリラヤとの間を通られた。"},{"ref":"Luke.17.12","start":42017012,"end":42017012,"break":"none","ruby":[[6,1,"むら"],[16,1,"にん"],[20,2,"びょうにん"],[23,2,"であ"],[30,1,"かれ"],[33,1,"とお"],[36,1,"ほう"],[38,1,"た"]],"text":"そして、ある村にはいられると、十人のらい病人に出会われたが、彼らは遠くの方で立ちとどまり、"},{"ref":"Luke.17.13","start":42017013,"end":42017013,"break":"none","ruby":[[0,1,"こえ"],[2,1,"は"],[32,1,"い"]],"text":"声を張りあげて、「イエスさま、わたしたちをあわれんでください」と言った。"},{"ref":"Luke.17.14","start":42017014,"end":42017014,"break":"none","ruby":[[4,1,"かれ"],[16,2,"さいし"],[25,1,"い"],[33,1,"み"],[40,1,"い"],[49,1,"い"],[51,2,"とちゅう"],[54,1,"かれ"]],"text":"イエスは彼らをごらんになって、「祭司たちのところに行って、からだを見せなさい」と言われた。そして、行く途中で彼らはきよめられた。"},{"ref":"Luke.17.15","start":42017015,"end":42017015,"break":"none","ruby":[[10,2,"じぶん"],[21,1,"し"],[24,2,"おおごえ"],[27,1,"かみ"],[37,1,"かえ"]],"text":"そのうちのひとりは、自分がいやされたことを知り、大声で神をほめたたえながら帰ってきて、"},{"ref":"Luke.17.16","start":42017016,"end":42017016,"break":"none","ruby":[[4,1,"あし"],[10,1,"ふ"],[13,2,"かんしゃ"],[25,1,"びと"]],"text":"イエスの足もとにひれ伏して感謝した。これはサマリヤ人であった。"},{"ref":"Luke.17.17","start":42017017,"end":42017017,"break":"none","ruby":[[4,1,"かれ"],[10,1,"い"],[26,1,"にん"],[39,1,"にん"]],"text":"イエスは彼にむかって言われた、「きよめられたのは、十人ではなかったか。ほかの九人は、どこにいるのか。"},{"ref":"Luke.17.18","start":42017018,"end":42017018,"break":"none","ruby":[[0,1,"かみ"],[11,1,"かえ"],[22,2,"たこく"],[24,1,"じん"]],"text":"神をほめたたえるために帰ってきたものは、この他国人のほかにはいないのか」。"},{"ref":"Luke.17.19","start":42017019,"end":42017019,"break":"none","ruby":[[7,1,"ひと"],[9,1,"い"],[15,1,"た"],[18,1,"い"],[28,2,"しんこう"],[35,1,"すく"]],"text":"それから、その人に言われた、「立って行きなさい。あなたの信仰があなたを救ったのだ」。"},{"ref":"Luke.17.20","start":42017020,"end":42017020,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"くに"],[6,1,"く"],[16,1,"びと"],[18,1,"たず"],[28,1,"こた"],[31,1,"い"],[37,1,"かみ"],[39,1,"くに"],[42,1,"み"],[50,1,"く"]],"text":"神の国はいつ来るのかと、パリサイ人が尋ねたので、イエスは答えて言われた、「神の国は、見られるかたちで来るものではない。"},{"ref":"Luke.17.21","start":42017021,"end":42017021,"break":"none","ruby":[[3,1,"み"],[24,1,"い"],[29,1,"かみ"],[31,1,"くに"],[34,1,"じつ"],[44,1,"なか"]],"text":"また『見よ、ここにある』『あそこにある』などとも言えない。神の国は、実にあなたがたのただ中にあるのだ」。"},{"ref":"Luke.17.22","start":42017022,"end":42017022,"break":"paragraph","ruby":[[4,2,"でし"],[9,1,"い"],[22,1,"ひと"],[24,1,"こ"],[26,1,"ひ"],[29,1,"にち"],[32,1,"み"],[36,1,"ねが"],[40,1,"み"],[49,1,"とき"],[51,1,"く"]],"text":"それから弟子たちに言われた、「あなたがたは、人の子の日を一日でも見たいと願っても見ることができない時が来るであろう。"},{"ref":"Luke.17.23","start":42017023,"end":42017023,"break":"none","ruby":[[0,2,"ひとびと"],[11,1,"み"],[20,1,"み"],[28,1,"い"],[42,1,"い"],[46,1,"かれ"],[52,1,"お"]],"text":"人々はあなたがたに、『見よ、あそこに』『見よ、ここに』と言うだろう。しかし、そちらへ行くな、彼らのあとを追うな。"},{"ref":"Luke.17.24","start":42017024,"end":42017024,"break":"none","ruby":[[5,1,"てん"],[7,1,"はし"],[13,1,"で"],[15,1,"てん"],[17,1,"はし"],[24,1,"わた"],[30,1,"ひと"],[32,1,"こ"],[36,1,"ひ"],[39,1,"おな"]],"text":"いなずまが天の端からひかり出て天の端へとひらめき渡るように、人の子もその日には同じようであるだろう。"},{"ref":"Luke.17.25","start":42017025,"end":42017025,"break":"none","ruby":[[4,1,"かれ"],[8,1,"おお"],[11,1,"くる"],[15,1,"う"],[22,2,"じだい"],[25,2,"ひとびと"],[28,1,"す"]],"text":"しかし、彼はまず多くの苦しみを受け、またこの時代の人々に捨てられねばならない。"},{"ref":"Luke.17.26","start":42017026,"end":42017026,"break":"none","ruby":[[7,1,"とき"],[16,1,"ひと"],[18,1,"こ"],[20,1,"とき"],[23,2,"どうよう"],[29,1,"おこ"]],"text":"そして、ノアの時にあったように、人の子の時にも同様なことが起るであろう。"},{"ref":"Luke.17.27","start":42017027,"end":42017027,"break":"none","ruby":[[3,2,"はこぶね"],[9,1,"ひ"],[13,2,"ひとびと"],[16,1,"く"],[19,1,"の"],[40,2,"こうずい"],[43,1,"おそ"],[49,1,"かれ"],[57,1,"ほろ"]],"text":"ノアが箱舟にはいる日まで、人々は食い、飲み、めとり、とつぎなどしていたが、そこへ洪水が襲ってきて、彼らをことごとく滅ぼした。"},{"ref":"Luke.17.28","start":42017028,"end":42017028,"break":"none","ruby":[[3,1,"とき"],[6,1,"おな"],[14,1,"おこ"],[18,2,"ひとびと"],[21,1,"く"],[24,1,"の"],[27,1,"か"],[30,1,"う"],[33,1,"う"],[36,1,"た"]],"text":"ロトの時にも同じようなことが起った。人々は食い、飲み、買い、売り、植え、建てなどしていたが、"},{"ref":"Luke.17.29","start":42017029,"end":42017029,"break":"none","ruby":[[8,1,"で"],[10,1,"い"],[13,1,"ひ"],[16,1,"てん"],[19,1,"ひ"],[21,2,"いおう"],[25,1,"ふ"],[31,1,"かれ"],[39,1,"ほろ"]],"text":"ロトがソドムから出て行った日に、天から火と硫黄とが降ってきて、彼らをことごとく滅ぼした。"},{"ref":"Luke.17.30","start":42017030,"end":42017030,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[4,1,"あらわ"],[7,1,"ひ"],[17,2,"どうよう"]],"text":"人の子が現れる日も、ちょうどそれと同様であろう。"},{"ref":"Luke.17.31","start":42017031,"end":42017031,"break":"none","ruby":[[2,1,"ひ"],[6,2,"おくじょう"],[11,1,"もの"],[14,2,"じぶん"],[17,1,"も"],[19,1,"もの"],[21,1,"いえ"],[23,1,"なか"],[30,1,"と"],[38,1,"はたけ"],[42,1,"もの"],[44,1,"おな"]],"text":"その日には、屋上にいる者は、自分の持ち物が家の中にあっても、取りにおりるな。畑にいる者も同じように、あとへもどるな。"},{"ref":"Luke.17.32","start":42017032,"end":42017032,"break":"none","ruby":[[3,1,"つま"],[8,1,"おも"],[10,1,"だ"]],"text":"ロトの妻のことを思い出しなさい。"},{"ref":"Luke.17.33","start":42017033,"end":42017033,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"いのち"],[5,1,"すく"],[18,1,"うしな"],[24,1,"うしな"],[30,1,"たも"]],"text":"自分の命を救おうとするものは、それを失い、それを失うものは、保つのである。"},{"ref":"Luke.17.34","start":42017034,"end":42017034,"break":"none","ruby":[[6,1,"い"],[14,1,"よ"],[20,1,"おとこ"],[24,2,"ねどこ"],[37,1,"と"],[39,1,"さ"],[43,1,"た"],[49,1,"のこ"]],"text":"あなたがたに言っておく。その夜、ふたりの男が一つ寝床にいるならば、ひとりは取り去られ、他のひとりは残されるであろう。"},{"ref":"Luke.17.35","start":42017035,"end":42017035,"break":"none","ruby":[[4,1,"おんな"],[6,2,"いっしょ"],[25,1,"と"],[27,1,"さ"],[31,1,"た"],[37,1,"のこ"]],"text":"ふたりの女が一緒にうすをひいているならば、ひとりは取り去られ、他のひとりは残されるであろう。〔"},{"ref":"Luke.17.36","start":42017036,"end":42017036,"break":"none","ruby":[[4,1,"おとこ"],[6,1,"はたけ"],[16,1,"と"],[18,1,"さ"],[22,1,"た"],[28,1,"のこ"]],"text":"ふたりの男が畑におれば、ひとりは取り去られ、他のひとりは残されるであろう〕」。"},{"ref":"Luke.17.37","start":42017037,"end":42017037,"break":"none","ruby":[[0,2,"でし"],[6,1,"しゅ"],[23,1,"たず"],[34,1,"い"],[40,2,"したい"],[45,1,"ところ"],[56,1,"あつ"]],"text":"弟子たちは「主よ、それはどこであるのですか」と尋ねた。するとイエスは言われた、「死体のある所には、またはげたかが集まるものである」。"}]