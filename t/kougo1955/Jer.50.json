[{"ref":"Jer.50.1","start":24050001,"end":24050001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,3,"よげんしゃ"],[13,1,"かた"],[29,1,"ち"],[31,1,"こと"],[37,2,"ことば"]],"text":"主が預言者エレミヤによって語られたバビロンとカルデヤびとの地の事についての言葉。"},{"ref":"Jer.50.2","start":24050002,"end":24050002,"break":"stanza","breaks":[[18,"line"],[38,"line"],[59,"line"],[80,"line"]],"ruby":[[1,2,"くにぐに"],[7,1,"つ"],[12,1,"ふ"],[14,1,"しめ"],[18,1,"はた"],[20,1,"た"],[24,1,"かく"],[30,1,"ふ"],[32,1,"しめ"],[35,1,"い"],[44,1,"と"],[64,1,"くだ"],[70,1,"ぞう"],[82,2,"ぐうぞう"],[85,1,"くだ"]],"text":"「国々のうちに告げ、また触れ示せよ、旗を立てて、隠すことなく触れ示して言え、『バビロンは取られ、ベルははずかしめられ、メロダクは砕かれ、その像ははずかしめられ、その偶像は砕かれる』と。"},{"ref":"Jer.50.3","start":24050003,"end":24050003,"break":"paragraph","ruby":[[4,1,"きた"],[6,1,"ほう"],[12,2,"こくみん"],[21,1,"せ"],[26,1,"ち"],[28,1,"あら"],[32,1,"す"],[34,1,"ひと"],[49,1,"ひと"],[51,1,"けもの"],[55,1,"に"],[57,1,"さ"]],"text":"それは、北の方から一つの国民がきて、これを攻め、その地を荒して、住む人もないようにするからである。人も獣もみな逃げ去ってしまう。"},{"ref":"Jer.50.4","start":24050004,"end":24050004,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"ひ"],[12,1,"とき"],[20,1,"たみ"],[25,1,"たみ"],[27,1,"とも"],[29,1,"かえ"],[35,1,"かれ"],[38,1,"なげ"],[43,1,"かえ"],[54,1,"かみ"],[56,1,"しゅ"],[58,1,"もと"]],"text":"主は言われる、その日その時、イスラエルの民とユダの民は共に帰ってくる。彼らは嘆きながら帰ってくる。そしてその神、主を求める。"},{"ref":"Jer.50.5","start":24050005,"end":24050005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かお"],[9,1,"む"],[15,1,"みち"],[17,1,"と"],[30,2,"えいえん"],[33,1,"わす"],[43,2,"けいやく"],[46,1,"むす"],[49,1,"しゅ"],[51,1,"つら"],[57,1,"い"]],"text":"彼らは顔をシオンに向けて、その道を問い、『さあ、われわれは、永遠に忘れられることのない契約を結んで主に連なろう』と言う。"},{"ref":"Jer.50.6","start":24050006,"end":24050006,"break":"paragraph","ruby":[[4,1,"たみ"],[6,1,"まよ"],[9,1,"ひつじ"],[11,1,"む"],[19,2,"ぼくしゃ"],[31,1,"やま"],[33,1,"ふ"],[35,1,"まよ"],[42,1,"やま"],[45,1,"おか"],[48,1,"い"],[56,1,"やす"],[58,1,"ところ"],[60,1,"わす"]],"text":"わたしの民は迷える羊の群れである、その牧者がこれをいざなって、山に踏み迷わせたので、山から丘へと行きめぐり、その休む所を忘れた。"},{"ref":"Jer.50.7","start":24050007,"end":24050007,"break":"none","ruby":[[3,1,"あ"],[5,1,"もの"],[12,1,"た"],[18,1,"てき"],[20,1,"い"],[30,1,"つみ"],[35,1,"かれ"],[50,1,"しゅ"],[52,2,"せんぞ"],[57,2,"きぼう"],[63,1,"しゅ"],[65,1,"たい"],[68,1,"つみ"],[70,1,"おか"]],"text":"これに会う者はみなこれを食べた。その敵は言った、『われわれに罪はない。彼らがそのまことのすみかである主、先祖たちの希望であった主に対して罪を犯したのだ』と。"},{"ref":"Jer.50.8","start":24050008,"end":24050008,"break":"paragraph","ruby":[[9,1,"に"],[20,1,"ち"],[23,1,"で"],[26,1,"む"],[29,1,"まえ"],[31,1,"い"],[33,1,"お"]],"text":"バビロンのうちから逃げよ。カルデヤびとの地から出よ。群れの前に行く雄やぎのようにせよ。"},{"ref":"Jer.50.9","start":24050009,"end":24050009,"break":"none","ruby":[[0,1,"み"],[7,1,"おお"],[10,2,"くにぐに"],[13,1,"おこ"],[15,1,"あつ"],[19,1,"きた"],[21,1,"ち"],[29,1,"せ"],[36,1,"かれ"],[42,1,"む"],[46,1,"せい"],[58,1,"ところ"],[61,1,"と"],[64,1,"かれ"],[67,1,"や"],[73,1,"かえ"],[77,2,"ろうれん"],[80,2,"ゆうし"]],"text":"見よ、わたしは大きい国々を起し集めて、北の地からバビロンに攻めこさせる。彼らはこれに向かって勢ぞろいをし、これをその所から取る。彼らの矢はむなしく帰らない老練な勇士のようである。"},{"ref":"Jer.50.10","start":24050010,"end":24050010,"break":"none","ruby":[[5,1,"ひと"],[21,1,"もの"],[25,1,"あ"],[35,1,"しゅ"],[37,1,"い"]],"text":"カルデヤは人にかすめられる。これをかすめる者はみな飽くことができると、主は言われる。"},{"ref":"Jer.50.11","start":24050011,"end":24050011,"break":"stanza","breaks":[[16,"line"],[28,"line"],[41,"line"]],"ruby":[[4,1,"し"],[5,1,"ぎょう"],[11,1,"もの"],[22,1,"よろこ"],[24,1,"たの"],[28,1,"めす"],[30,1,"こ"],[31,1,"うし"],[36,1,"くさ"],[38,1,"たわむ"],[41,1,"お"],[42,1,"うま"]],"text":"わたしの嗣業をかすめる者どもよ、あなたがたは喜び楽しみ、雌の子牛のように草に戯れ、雄馬のように、いなないているが、"},{"ref":"Jer.50.12","start":24050012,"end":24050012,"break":"line","breaks":[[19,"line"],[37,"line"],[61,"line"]],"ruby":[[6,1,"はは"],[25,1,"う"],[28,1,"もの"],[30,1,"はじ"],[37,1,"み"],[40,2,"かのじょ"],[43,2,"くにぐに"],[49,1,"もっと"],[65,2,"すなはら"],[68,2,"あらの"]],"text":"あなたがたの母はいたくはずかしめられ、あなたがたを産んだ者は恥をこうむる。見よ、彼女は国々のうちの最もあとなるものとなり、かわいた砂原の荒野となる。"},{"ref":"Jer.50.13","start":24050013,"end":24050013,"break":"line","breaks":[[19,"line"],[29,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"いか"],[12,1,"す"],[14,1,"もの"],[19,2,"かんぜん"],[22,1,"あ"],[24,1,"ち"],[39,1,"とお"],[41,1,"もの"],[48,1,"きず"],[50,1,"み"],[52,1,"おどろ"],[59,1,"わら"]],"text":"主の怒りによって、ここに住む者はなく、完全に荒れ地となる。バビロンのかたわらを通る者は、みなその傷を見て驚き、かつあざ笑う。"},{"ref":"Jer.50.14","start":24050014,"end":24050014,"break":"line","breaks":[[15,"line"],[36,"line"],[50,"line"]],"ruby":[[8,1,"ゆみ"],[10,1,"は"],[12,1,"もの"],[20,2,"しゅうい"],[23,1,"せい"],[33,1,"せ"],[36,1,"や"],[38,1,"お"],[47,1,"い"],[50,2,"かのじょ"],[53,1,"しゅ"],[55,1,"つみ"],[57,1,"おか"]],"text":"あなたがたすべて弓を張る者よ、バビロンの周囲に勢ぞろいして、これを攻め、矢を惜しまずに、これを射よ、彼女が主に罪を犯したからだ。"},{"ref":"Jer.50.15","start":24050015,"end":24050015,"break":"line","breaks":[[21,"line"],[40,"line"],[54,"line"],[74,"line"]],"ruby":[[2,2,"しゅうい"],[5,1,"さけ"],[7,1,"ごえ"],[13,2,"かのじょ"],[16,2,"こうふく"],[27,1,"たお"],[32,2,"じょうへき"],[40,1,"しゅ"],[54,2,"かのじょ"],[57,2,"ほうふく"],[62,2,"かのじょ"],[77,1,"おこな"]],"text":"その周囲に叫び声をあげよ、彼女は降伏した。そのとりでは倒れ、その城壁はくずれた、主があだをかえされたからだ。彼女に報復せよ、彼女がおこなったように、これに行え。"},{"ref":"Jer.50.16","start":24050016,"end":24050016,"break":"line","breaks":[[20,"line"],[29,"line"],[42,"line"],[58,"line"]],"ruby":[[0,1,"たね"],[3,1,"もの"],[6,2,"かりい"],[16,1,"と"],[18,1,"もの"],[25,1,"た"],[29,1,"ほろ"],[32,1,"もの"],[38,1,"おそ"],[42,1,"ひと"],[48,2,"じぶん"],[51,1,"たみ"],[53,1,"ところ"],[55,1,"かえ"],[65,1,"に"],[68,1,"い"]],"text":"種まく者と、刈入れどきに、かまを取る者をバビロンに絶やせ。滅ぼす者のつるぎを恐れて、人はおのおの自分の民の所に帰り、そのふるさとに逃げて行く。"},{"ref":"Jer.50.17","start":24050017,"end":24050017,"break":"paragraph","ruby":[[10,1,"お"],[14,1,"ち"],[17,1,"ひつじ"],[22,1,"はじ"],[31,1,"おう"],[36,1,"く"],[42,1,"いま"],[52,1,"おう"],[63,1,"ほね"]],"text":"イスラエルは、ししに追われて散った羊である。初めにアッスリヤの王がこれを食い、そして今はついにバビロンの王ネブカデレザルがその骨をかじった。"},{"ref":"Jer.50.18","start":24050018,"end":24050018,"break":"none","ruby":[[4,2,"ばんぐん"],[7,1,"しゅ"],[15,1,"かみ"],[20,1,"い"],[25,1,"み"],[38,1,"おう"],[40,1,"ばっ"],[52,1,"おう"],[56,1,"くに"],[58,1,"ばつ"],[60,1,"くだ"]],"text":"それゆえ万軍の主、イスラエルの神は、こう言われる、見よ、わたしはアッスリヤの王を罰したように、バビロンの王とその国に罰を下す。"},{"ref":"Jer.50.19","start":24050019,"end":24050019,"break":"none","ruby":[[10,1,"ふたた"],[14,2,"まきば"],[17,1,"かえ"],[22,1,"かれ"],[34,1,"くさ"],[36,1,"た"],[48,1,"やま"],[57,1,"のぞ"],[60,1,"み"]],"text":"わたしはイスラエルを再びその牧場に帰らせる。彼はカルメルとバシャンで草を食べる。またエフライムの山とギレアデでその望みが満たされる。"},{"ref":"Jer.50.20","start":24050020,"end":24050020,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"ひ"],[12,1,"とき"],[25,1,"さが"],[29,2,"みあた"],[37,1,"つみ"],[39,1,"さが"],[53,1,"のこ"],[58,2,"ひとびと"]],"text":"主は言われる、その日その時には、イスラエルのとがを探しても見当らず、ユダの罪を探してもない。それはわたしが残しておく人々を、ゆるすからである。"},{"ref":"Jer.50.21","start":24050021,"end":24050021,"break":"paragraph","breaks":[[7,"line"],[25,"line"],[34,"line"],[46,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"のぼ"],[10,1,"い"],[20,1,"ち"],[22,1,"せ"],[29,1,"たみ"],[31,1,"せ"],[34,1,"かれ"],[37,1,"ころ"],[40,1,"まった"],[42,1,"ほろ"],[56,1,"めい"],[62,1,"みな"],[64,1,"おこな"]],"text":"主は言われる、上って行って、メラタイムの地を攻め、ペコデの民を攻め、彼らを殺して全く滅ぼし、わたしがあなたがたに命じたことを皆、行いなさい。"},{"ref":"Jer.50.22","start":24050022,"end":24050022,"break":"line","ruby":[[2,1,"ち"],[9,1,"さけ"],[13,1,"おお"],[17,1,"ほろ"]],"text":"その地に、いくさの叫びと、大いなる滅びがある。"},{"ref":"Jer.50.23","start":24050023,"end":24050023,"break":"line","breaks":[[20,"line"],[37,"line"]],"ruby":[[3,1,"ぜん"],[4,1,"ち"],[6,1,"くだ"],[9,1,"つち"],[14,1,"お"],[16,1,"くだ"],[31,2,"くにぐに"],[37,1,"おそ"],[41,1,"み"]],"text":"ああ、全地を砕いた鎚はついに折れ砕ける。ああ、バビロンはついに国々のうちの恐るべき見ものとなる。"},{"ref":"Jer.50.24","start":24050024,"end":24050024,"break":"line","breaks":[[6,"line"],[29,"line"],[41,"line"],[58,"line"]],"ruby":[[15,1,"とら"],[51,1,"し"],[62,1,"しゅ"],[64,1,"てき"],[70,1,"たず"],[72,1,"だ"],[76,1,"とら"]],"text":"バビロンよ、わたしは、おまえを捕えるためにわなをかけたが、おまえはそれにかかった。そしておまえはそれを知らなかった。おまえは主に敵したので、尋ね出され、捕えられた。"},{"ref":"Jer.50.25","start":24050025,"end":24050025,"break":"line","breaks":[[10,"line"],[25,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"ぶき"],[5,1,"くら"],[7,1,"ひら"],[12,1,"いか"],[15,2,"ぶき"],[18,1,"と"],[20,1,"だ"],[25,1,"しゅ"],[28,2,"ばんぐん"],[31,1,"かみ"],[41,1,"ち"],[43,1,"こと"],[45,1,"おこな"]],"text":"主は武器の倉を開いてその怒りの武器を取り出された。主なる万軍の神が、カルデヤびとの地に事を行われるからである。"},{"ref":"Jer.50.26","start":24050026,"end":24050026,"break":"line","breaks":[[17,"line"],[25,"line"],[41,"line"]],"ruby":[[4,2,"ほうめん"],[14,1,"せ"],[19,2,"こくぐら"],[22,1,"ひら"],[28,2,"こくもつ"],[31,1,"やま"],[36,1,"つ"],[38,1,"あ"],[41,2,"かんぜん"],[44,1,"ほろ"],[47,1,"つく"],[53,1,"のこ"],[55,1,"もの"]],"text":"あらゆる方面からきて、これを攻め、その穀倉を開き、これを穀物の山のように積み上げ、完全に滅ぼし尽し、そこに残る者のないようにせよ。"},{"ref":"Jer.50.27","start":24050027,"end":24050027,"break":"line","breaks":[[13,"line"],[27,"line"],[40,"line"]],"ruby":[[2,2,"おうし"],[10,1,"ころ"],[20,1,"ば"],[22,1,"くだ"],[42,1,"ひ"],[46,1,"ばつ"],[48,1,"う"],[51,1,"とき"]],"text":"その雄牛をことごとく殺せ、それを、ほふり場に下らせよ。それらのものはわざわいだ、その日、その罰を受ける時がきたからだ。"},{"ref":"Jer.50.28","start":24050028,"end":24050028,"break":"paragraph","ruby":[[0,1,"き"],[9,1,"ち"],[12,1,"に"],[21,1,"もの"],[23,1,"こえ"],[33,1,"かみ"],[35,1,"しゅ"],[37,2,"ほうふく"],[42,1,"みや"],[44,2,"ほうふく"],[47,1,"こと"],[53,1,"つ"],[55,1,"しめ"]],"text":"聞けよ、バビロンの地から逃げ、のがれてきた者の声がする。われわれの神、主の報復、その宮の報復の事をシオンに告げ示す。"},{"ref":"Jer.50.29","start":24050029,"end":24050029,"break":"paragraph","ruby":[[0,1,"ゆみ"],[2,1,"は"],[4,2,"いて"],[12,1,"よ"],[14,1,"あつ"],[23,1,"せ"],[29,2,"しゅうい"],[32,1,"じん"],[34,1,"し"],[41,2,"にが"],[62,1,"むく"],[73,1,"ところ"],[83,1,"おこな"],[86,1,"かれ"],[94,2,"せいじゃ"],[99,1,"しゅ"],[101,1,"む"],[105,2,"こうまん"]],"text":"弓を張る射手をことごとく呼び集めて、バビロンを攻めよ。その周囲に陣を敷け。ひとりも逃がすな。そのしわざにしたがってバビロンに報い、これがおこなった所にしたがってこれに行え。彼がイスラエルの聖者である主に向かって高慢にふるまったからだ。"},{"ref":"Jer.50.30","start":24050030,"end":24050030,"break":"none","ruby":[[7,1,"ひ"],[9,1,"わか"],[11,1,"もの"],[14,2,"ひろば"],[17,1,"たお"],[20,2,"へいし"],[25,1,"た"],[31,1,"しゅ"],[33,1,"い"]],"text":"それゆえ、その日、若い者は、広場に倒れ、兵士はみな絶やされると主は言われる。"},{"ref":"Jer.50.31","start":24050031,"end":24050031,"break":"stanza","breaks":[[13,"line"],[35,"line"]],"ruby":[[0,1,"しゅ"],[3,2,"ばんぐん"],[6,1,"かみ"],[8,1,"い"],[13,1,"たか"],[16,1,"もの"],[19,1,"み"],[30,1,"てき"],[39,1,"ひ"],[49,1,"ばっ"],[52,1,"とき"],[54,1,"き"]],"text":"主なる万軍の神は言われる、高ぶる者よ、見よ、わたしはおまえの敵となる、あなたの日、わたしがおまえを罰する時が来た。"},{"ref":"Jer.50.32","start":24050032,"end":24050032,"break":"line","breaks":[[13,"line"],[26,"line"],[42,"line"]],"ruby":[[0,1,"たか"],[3,1,"もの"],[9,1,"たお"],[16,1,"たす"],[18,1,"おこ"],[32,2,"まちまち"],[35,1,"ひ"],[37,1,"も"],[44,2,"しゅうい"],[47,1,"もの"],[54,1,"や"],[56,1,"つく"]],"text":"高ぶる者はつまずき倒れる、これを助け起すものはない。わたしはその町々に火を燃やして、その周囲の者をことごとく焼き尽す。"},{"ref":"Jer.50.33","start":24050033,"end":24050033,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"い"],[18,1,"たみ"],[23,1,"たみ"],[25,1,"とも"],[37,1,"かれ"],[46,1,"もの"],[50,1,"かれ"],[53,1,"かた"],[55,1,"まも"],[58,2,"しゃくほう"],[65,1,"こば"]],"text":"万軍の主はこう言われる、イスラエルの民とユダの民は共にしえたげられている。彼らをとりこにした者はみな彼らを固く守って釈放することを拒む。"},{"ref":"Jer.50.34","start":24050034,"end":24050034,"break":"none","ruby":[[0,1,"かれ"],[7,1,"もの"],[9,1,"つよ"],[14,1,"な"],[16,2,"ばんぐん"],[19,1,"しゅ"],[26,1,"かれ"],[28,1,"かなら"],[30,1,"かれ"],[33,1,"うった"],[42,1,"ち"],[44,1,"やす"],[47,1,"あた"],[57,1,"す"],[59,1,"もの"],[62,2,"ふあん"],[65,1,"あた"]],"text":"彼らをあがなう者は強く、その名は万軍の主といわれる。彼は必ず彼らの訴えをただし、この地に安きを与えるが、バビロンに住む者には不安を与えられる。"},{"ref":"Jer.50.35","start":24050035,"end":24050035,"break":"stanza","breaks":[[7,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[14,1,"うえ"],[21,1,"す"],[23,1,"もの"],[25,1,"うえ"],[37,2,"ちしゃ"],[42,1,"うえ"],[48,1,"のぞ"]],"text":"主は言われる、カルデヤびとの上とバビロンに住む者の上、そのつかさたち、その知者たちの上につるぎが臨む。"},{"ref":"Jer.50.36","start":24050036,"end":24050036,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"うらな"],[2,1,"し"],[4,1,"うえ"],[10,1,"のぞ"],[13,1,"かれ"],[16,1,"おろ"],[18,1,"もの"],[25,2,"ゆうし"],[28,1,"うえ"],[34,1,"のぞ"],[37,1,"かれ"],[40,1,"ほろ"]],"text":"占い師の上につるぎが臨み、彼らは愚か者となる。その勇士の上につるぎが臨み、彼らは滅ぼされる。"},{"ref":"Jer.50.37","start":24050037,"end":24050037,"break":"line","breaks":[[20,"line"],[41,"line"],[52,"line"]],"ruby":[[2,1,"うま"],[4,1,"うえ"],[9,1,"くるま"],[11,1,"うえ"],[17,1,"のぞ"],[33,1,"やとい"],[34,1,"へい"],[36,1,"うえ"],[38,1,"のぞ"],[41,1,"かれ"],[44,1,"おんな"],[54,2,"ざいほう"],[57,1,"うえ"],[63,1,"のぞ"]],"text":"その馬の上と、その車の上につるぎが臨み、またそのうちにあるすべての雇兵の上に臨み、彼らは女のようになる。その財宝の上につるぎが臨み、それはかすめられる。"},{"ref":"Jer.50.38","start":24050038,"end":24050038,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[2,1,"みず"],[4,1,"うえ"],[11,1,"き"],[27,1,"ち"],[29,2,"ぐうぞう"],[32,1,"ち"],[38,2,"ひとびと"],[41,2,"ぐうぞう"],[44,1,"こころ"],[46,1,"くる"]],"text":"その水の上に、ひでりが来て、それはかわく。それは、この地が偶像の地であって、人々が偶像に心が狂っているからだ。"},{"ref":"Jer.50.39","start":24050039,"end":24050039,"break":"paragraph","ruby":[[5,1,"の"],[7,1,"けもの"],[9,2,"やまいぬ"],[13,1,"とも"],[31,1,"す"],[45,1,"ち"],[47,1,"す"],[49,1,"ひと"],[54,2,"よよ"],[59,1,"す"],[61,1,"ひと"]],"text":"それゆえ、野の獣と山犬とは共にバビロンにおり、だちょうもそこに住む。しかし、いつまでもその地に住む人はなく、世々ここに住む人はない。"},{"ref":"Jer.50.40","start":24050040,"end":24050040,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"かみ"],[20,1,"となり"],[22,2,"まちまち"],[25,1,"ほろ"],[37,1,"す"],[39,1,"ひと"],[47,1,"やど"],[49,1,"ひと"],[51,1,"こ"]],"text":"主は言われる、神がソドムとゴモラと、その隣の町々を滅ぼされたように、そこに住む人はなく、そこに宿る人の子はない。"},{"ref":"Jer.50.41","start":24050041,"end":24050041,"break":"paragraph","breaks":[[16,"line"],[27,"line"]],"ruby":[[0,1,"み"],[6,1,"たみ"],[8,1,"きた"],[10,1,"ほう"],[13,1,"く"],[16,1,"おお"],[20,1,"くに"],[22,1,"おお"],[25,1,"おう"],[27,1,"ち"],[29,1,"はて"],[32,1,"た"],[34,1,"あ"]],"text":"見よ、一つの民が北の方から来る。大いなる国と多くの王が地の果から立ち上がっている。"},{"ref":"Jer.50.42","start":24050042,"end":24050042,"break":"line","breaks":[[12,"line"],[24,"line"],[43,"line"],[59,"line"],[75,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ゆみ"],[9,1,"と"],[12,2,"ざんにん"],[26,1,"ひび"],[29,1,"うみ"],[31,1,"な"],[48,1,"むすめ"],[51,1,"かれ"],[54,1,"うま"],[56,1,"の"],[68,1,"み"],[79,1,"せ"]],"text":"彼らは弓と、やりを取る。残忍で、あわれみがなく、その響きは海の鳴りとどろくようである。バビロンの娘よ、彼らは馬に乗り、いくさびとのように身をよろって、あなたを攻める。"},{"ref":"Jer.50.43","start":24050043,"end":24050043,"break":"line","breaks":[[17,"line"],[35,"line"]],"ruby":[[5,1,"おう"],[13,1,"き"],[19,1,"て"],[21,1,"よわ"],[24,1,"こ"],[26,1,"う"],[28,1,"おんな"],[30,1,"のぞ"],[35,1,"いた"],[38,1,"くる"],[42,1,"せま"]],"text":"バビロンの王はそのうわさを聞いて、その手は弱り、子を産む女に臨むような痛みと苦しみに迫られた。"},{"ref":"Jer.50.44","start":24050044,"end":24050044,"break":"paragraph","ruby":[[0,1,"み"],[11,2,"みつりん"],[15,1,"のぼ"],[26,1,"ひつじ"],[31,1,"おそ"],[46,1,"かれ"],[53,1,"に"],[55,1,"さ"],[67,1,"えら"],[69,1,"もの"],[73,1,"うえ"],[75,1,"た"],[89,1,"もの"],[106,1,"よ"],[122,2,"ぼくしゃ"],[129,1,"まえ"],[131,1,"た"]],"text":"見よ、ししがヨルダンの密林から上ってきて、じょうぶな羊のおりを襲うように、わたしは、たちまち彼らをそこから逃げ去らせる。そしてわたしの選ぶ者をその上に立てる。だれかわたしのような者があるであろうか。だれがわたしを呼びつけることができようか。どの牧者がわたしの前に立つことができようか。"},{"ref":"Jer.50.45","start":24050045,"end":24050045,"break":"none","ruby":[[10,1,"たい"],[13,1,"しゅ"],[15,1,"た"],[18,1,"はか"],[31,1,"ち"],[33,1,"たい"],[42,1,"こと"],[44,1,"き"],[50,1,"かれ"],[53,1,"む"],[59,1,"ちい"],[62,1,"もの"],[69,1,"ひ"],[73,1,"い"],[76,1,"かれ"],[85,1,"かなら"],[89,1,"おわ"],[92,1,"み"],[94,1,"おそ"]],"text":"それゆえ、バビロンに対して主が立てた計りごとと、カルデヤびとの地に対してしようとする事を聞くがよい。彼らの群れのうちの小さい者は、かならず引かれて行く。彼らのおりのものも必ずその終りを見て恐れる。"},{"ref":"Jer.50.46","start":24050046,"end":24050046,"break":"none","ruby":[[5,1,"と"],[11,1,"こえ"],[16,1,"ち"],[18,1,"ふる"],[23,1,"さけ"],[26,2,"くにぐに"],[32,1,"きこ"]],"text":"バビロンが取られたとの声によって地は震い、その叫びは国々のうちに聞える」。"}]