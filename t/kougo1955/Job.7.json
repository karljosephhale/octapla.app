[{"ref":"Job.7.1","start":18007001,"end":18007001,"break":"paragraph","breaks":[[7,"line"],[21,"line"]],"ruby":[[0,2,"ちじょう"],[3,1,"ひと"],[7,1,"はげ"],[10,2,"ろうむ"],[25,1,"ひ"],[27,2,"やといにん"],[30,1,"ひ"]],"text":"地上の人には、激しい労務があるではないか。またその日は雇人の日のようではないか。"},{"ref":"Job.7.2","start":18007002,"end":18007002,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"どれい"],[3,2,"ゆうぐれ"],[6,1,"した"],[12,2,"やといにん"],[17,2,"ちんぎん"],[20,1,"のぞ"]],"text":"奴隷が夕暮を慕うように、雇人がその賃銀を望むように、"},{"ref":"Job.7.3","start":18007003,"end":18007003,"break":"line","breaks":[[17,"line"]],"ruby":[[9,1,"つき"],[11,1,"も"],[17,1,"なや"],[20,1,"よる"],[22,1,"あた"]],"text":"わたしは、むなしい月を持たせられ、悩みの夜を与えられる。"},{"ref":"Job.7.4","start":18007004,"end":18007004,"break":"line","breaks":[[25,"line"]],"ruby":[[4,1,"ね"],[9,1,"い"],[15,1,"お"],[28,1,"よる"],[30,1,"なが"],[33,1,"あかつき"]],"text":"わたしは寝るときに言う、『いつ起きるだろうか』と。しかし夜は長く、暁までころびまわる。"},{"ref":"Job.7.5","start":18007005,"end":18007005,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"にく"],[9,1,"つち"],[22,1,"かわ"],[24,1,"かた"]],"text":"わたしの肉はうじと土くれとをまとい、わたしの皮は固まっては、またくずれる。"},{"ref":"Job.7.6","start":18007006,"end":18007006,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"ひ"],[6,1,"はた"],[12,1,"はや"],[15,1,"のぞ"],[22,1,"き"],[24,1,"さ"]],"text":"わたしの日は機のひよりも速く、望みをもたずに消え去る。"},{"ref":"Job.7.7","start":18007007,"end":18007007,"break":"stanza","breaks":[[21,"line"]],"ruby":[[0,2,"きおく"],[9,1,"いのち"],[11,1,"いき"],[25,1,"め"],[27,1,"ふたた"],[29,1,"さいわい"],[31,1,"み"]],"text":"記憶せよ、わたしの命は息にすぎないことを。わたしの目は再び幸を見ることがない。"},{"ref":"Job.7.8","start":18007008,"end":18007008,"break":"line","breaks":[[11,"line"],[27,"line"],[44,"line"]],"ruby":[[4,1,"み"],[6,1,"もの"],[8,1,"め"],[19,1,"み"],[35,1,"め"],[37,1,"む"]],"text":"わたしを見る者の目は、かさねてわたしを見ることがなく、あなたがわたしに目を向けられても、わたしはいない。"},{"ref":"Job.7.9","start":18007009,"end":18007009,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"くも"],[2,1,"き"],[14,2,"よみ"],[17,1,"くだ"],[19,1,"もの"],[21,1,"あ"],[25,1,"く"]],"text":"雲が消えて、なくなるように、陰府に下る者は上がって来ることがない。"},{"ref":"Job.7.10","start":18007010,"end":18007010,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ふたた"],[6,1,"いえ"],[8,1,"かえ"],[12,1,"かれ"],[14,1,"ところ"],[20,1,"かれ"],[22,1,"みと"]],"text":"彼は再びその家に帰らず、彼の所も、もはや彼を認めない。"},{"ref":"Job.7.11","start":18007011,"end":18007011,"break":"stanza","breaks":[[18,"line"],[34,"line"]],"ruby":[[11,1,"くち"],[22,1,"れい"],[31,1,"かた"],[38,1,"たましい"],[40,1,"くる"],[47,1,"なげ"]],"text":"それゆえ、わたしはわが口をおさえず、わたしの霊のもだえによって語り、わたしの魂の苦しさによって嘆く。"},{"ref":"Job.7.12","start":18007012,"end":18007012,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"うみ"],[11,1,"りゅう"],[26,1,"うえ"],[28,2,"みは"],[32,1,"お"]],"text":"わたしは海であるのか、龍であるのか、あなたはわたしの上に見張りを置かれる。"},{"ref":"Job.7.13","start":18007013,"end":18007013,"break":"line","breaks":[[14,"line"],[32,"line"]],"ruby":[[5,1,"とこ"],[11,1,"なぐさ"],[18,2,"ねどこ"],[23,1,"なげ"],[26,1,"かる"],[36,1,"い"]],"text":"『わたしの床はわたしを慰め、わたしの寝床はわが嘆きを軽くする』とわたしが言うとき、"},{"ref":"Job.7.14","start":18007014,"end":18007014,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"ゆめ"],[13,1,"おどろ"],[17,1,"まぼろし"],[26,1,"おそ"]],"text":"あなたは夢をもってわたしを驚かし、幻をもってわたしを恐れさせられる。"},{"ref":"Job.7.15","start":18007015,"end":18007015,"break":"line","breaks":[[20,"line"]],"ruby":[[9,1,"いき"],[11,1,"と"],[17,1,"ねが"],[22,1,"ほね"],[29,1,"し"],[31,1,"えら"]],"text":"それゆえ、わたしは息の止まることを願い、わが骨よりもむしろ死を選ぶ。"},{"ref":"Job.7.16","start":18007016,"end":18007016,"break":"line","breaks":[[10,"line"],[27,"line"],[41,"line"]],"ruby":[[4,1,"いのち"],[14,1,"なが"],[16,1,"い"],[22,1,"のぞ"],[31,1,"かま"],[45,1,"ひ"],[47,1,"いき"]],"text":"わたしは命をいとう。わたしは長く生きることを望まない。わたしに構わないでください。わたしの日は息にすぎないのだから。"},{"ref":"Job.7.17","start":18007017,"end":18007017,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"ひと"],[2,2,"なにもの"],[15,1,"おお"],[27,1,"こころ"]],"text":"人は何者なので、あなたはこれを大きなものとし、これにみ心をとめ、"},{"ref":"Job.7.18","start":18007018,"end":18007018,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"あさ"],[8,1,"たず"],[11,1,"た"],[13,1,"ま"],[20,1,"こころ"]],"text":"朝ごとに、これを尋ね、絶え間なく、これを試みられるのか。"},{"ref":"Job.7.19","start":18007019,"end":18007019,"break":"line","breaks":[[19,"line"]],"ruby":[[13,1,"め"],[15,1,"はな"],[31,1,"す"]],"text":"いつまで、あなたはわたしに目を離さず、つばをのむまも、わたしを捨てておかれないのか。"},{"ref":"Job.7.20","start":18007020,"end":18007020,"break":"line","breaks":[[22,"line"],[35,"line"],[52,"line"]],"ruby":[[0,1,"ひと"],[2,2,"かんし"],[7,1,"もの"],[14,1,"つみ"],[16,1,"おか"],[26,1,"なに"],[48,1,"まと"],[60,2,"おもに"]],"text":"人を監視される者よ、わたしが罪を犯したとて、あなたに何をなしえようか。なにゆえ、わたしをあなたの的とし、わたしをあなたの重荷とされるのか。"},{"ref":"Job.7.21","start":18007021,"end":18007021,"break":"line","breaks":[[17,"line"],[32,"line"],[47,"line"],[62,"line"]],"ruby":[[21,2,"ふぎ"],[24,1,"のぞ"],[38,1,"つち"],[40,1,"なか"],[42,1,"よこ"],[55,1,"たず"]],"text":"なにゆえ、わたしのとがをゆるさず、わたしの不義を除かれないのか。わたしはいま土の中に横たわる。あなたがわたしを尋ねられても、わたしはいないでしょう」。"}]