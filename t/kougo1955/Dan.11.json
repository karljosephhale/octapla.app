[{"ref":"Dan.11.1","start":27011001,"end":27011001,"break":"paragraph","ruby":[[16,2,"がんねん"],[19,1,"た"],[22,1,"かれ"],[24,1,"つよ"],[27,1,"かれ"],[29,1,"ちから"]],"text":"わたしはまたメデアびとダリヨスの元年に立って彼を強め、彼を力づけたことがあります。"},{"ref":"Dan.11.2","start":27011002,"end":27011002,"break":"paragraph","ruby":[[4,1,"いま"],[9,2,"しんり"],[12,1,"しめ"],[16,1,"み"],[27,1,"にん"],[29,1,"おう"],[31,1,"おこ"],[40,1,"だい"],[43,1,"もの"],[46,1,"た"],[52,1,"もの"],[58,1,"と"],[63,1,"とみ"],[68,1,"つよ"],[76,1,"かれ"],[85,2,"どういん"],[95,1,"くに"],[97,1,"せ"]],"text":"わたしは今あなたに真理を示そう。見よ、ペルシャになお三人の王が起るでしょう。その第四の者は、他のすべての者にまさって富み、その富によって強くなったとき、彼はすべてのものを動員して、ギリシヤの国を攻めます。"},{"ref":"Dan.11.3","start":27011003,"end":27011003,"break":"none","ruby":[[6,1,"いさ"],[10,1,"おう"],[12,1,"おこ"],[15,1,"おお"],[19,2,"けんりょく"],[25,1,"よ"],[27,1,"おさ"],[32,1,"い"],[37,1,"こと"]],"text":"またひとりの勇ましい王が起り、大いなる権力をもって世を治め、その意のままに事をなすでしょう。"},{"ref":"Dan.11.4","start":27011004,"end":27011004,"break":"none","ruby":[[0,1,"かれ"],[2,1,"つよ"],[7,1,"とき"],[11,1,"くに"],[13,1,"やぶ"],[17,1,"てん"],[19,2,"しほう"],[22,1,"わ"],[32,1,"かれ"],[34,2,"しそん"],[37,1,"き"],[43,1,"かれ"],[45,1,"おさ"],[51,2,"けんりょく"],[57,1,"かれ"],[59,1,"くに"],[61,1,"ぬ"],[63,1,"と"],[71,2,"いがい"],[74,1,"もの"],[78,1,"き"]],"text":"彼が強くなった時、その国は破られ、天の四方に分かたれます。それは彼の子孫に帰せず、また彼が治めたほどの権力もなく、彼の国は抜き取られて、これら以外の者どもに帰するでしょう。"},{"ref":"Dan.11.5","start":27011005,"end":27011005,"break":"paragraph","ruby":[[0,1,"みなみ"],[2,1,"おう"],[4,1,"つよ"],[16,2,"しょうぐん"],[24,1,"かれ"],[30,1,"つよ"],[35,2,"けんりょく"],[46,2,"けんりょく"],[50,1,"おお"],[54,2,"けんりょく"]],"text":"南の王は強くなります。しかしその将軍のひとりが、彼にまさって強くなり、権力をふるいます。その権力は、大いなる権力です。"},{"ref":"Dan.11.6","start":27011006,"end":27011006,"break":"none","ruby":[[0,1,"とし"],[2,1,"へ"],[4,1,"のち"],[6,1,"かれ"],[9,2,"えんぐみ"],[15,1,"みなみ"],[17,1,"おう"],[19,1,"むすめ"],[22,1,"きた"],[24,1,"おう"],[29,2,"わしん"],[43,1,"おんな"],[48,1,"うで"],[50,1,"ちから"],[52,1,"たも"],[65,1,"おう"],[70,1,"こ"],[72,1,"た"],[85,1,"おんな"],[90,2,"じゅうしゃ"],[96,1,"こ"],[102,1,"おんな"],[104,1,"え"],[106,1,"もの"]],"text":"年を経て後、彼らは縁組をなし、南の王の娘が、北の王にきて、和親をはかります。しかしその女は、その腕の力を保つことができず、またその王も、その子も立つことができません。その女と、その従者と、その子およびその女を獲た者とは、わたされるでしょう。"},{"ref":"Dan.11.7","start":27011007,"end":27011007,"break":"paragraph","ruby":[[7,1,"おんな"],[9,1,"ね"],[16,1,"め"],[18,1,"おこ"],[21,1,"かれ"],[23,1,"かわ"],[26,1,"きた"],[28,1,"おう"],[30,2,"ぐんぜい"],[42,1,"しろ"],[44,1,"う"],[46,1,"い"],[52,1,"せ"],[55,1,"か"]],"text":"そのころ、この女の根から、一つの芽が起って彼に代り、北の王の軍勢にむかってきて、その城に討ち入り、これを攻めて勝つでしょう。"},{"ref":"Dan.11.8","start":27011008,"end":27011008,"break":"none","ruby":[[0,1,"かれ"],[4,1,"かれ"],[7,2,"かみがみ"],[10,1,"い"],[11,1,"ぞう"],[15,2,"きんぎん"],[18,2,"きちょう"],[21,2,"うつわもの"],[30,1,"たずさ"],[32,1,"さ"],[38,2,"すうねん"],[41,1,"あいだ"],[43,1,"きた"],[45,1,"おう"],[47,1,"う"],[52,1,"ひか"]],"text":"彼はまた彼らの神々、鋳像および金銀の貴重な器物を、エジプトに携え去り、そして数年の間、北の王を討つことを控えます。"},{"ref":"Dan.11.9","start":27011009,"end":27011009,"break":"none","ruby":[[2,1,"のち"],[4,1,"きた"],[6,1,"おう"],[9,1,"みなみ"],[11,1,"おう"],[13,1,"くに"],[15,1,"う"],[17,1,"はい"],[21,2,"じぶん"],[24,1,"くに"],[26,1,"かえ"]],"text":"その後、北の王は、南の王の国に討ち入るが、自分の国に帰るでしょう。"},{"ref":"Dan.11.10","start":27011010,"end":27011010,"break":"paragraph","ruby":[[2,1,"こ"],[7,2,"ふんげき"],[16,2,"たいぐん"],[19,1,"あつ"],[22,1,"すす"],[25,1,"い"],[37,1,"とお"],[39,1,"す"],[46,1,"い"],[52,1,"しろ"],[56,1,"せ"],[58,1,"よ"]],"text":"その子らはまた憤激して、あまたの大軍を集め、進んで行って、みなぎりあふれ、通り過ぎるが、また行って、その城にまで攻め寄せるでしょう。"},{"ref":"Dan.11.11","start":27011011,"end":27011011,"break":"none","ruby":[[3,1,"みなみ"],[5,1,"おう"],[8,1,"おお"],[11,1,"いか"],[14,1,"で"],[18,1,"きた"],[20,1,"おう"],[22,1,"たたか"],[27,1,"かれ"],[29,2,"たいぐん"],[32,1,"おこ"],[41,1,"ぐん"],[43,2,"あいて"],[46,1,"て"]],"text":"そこで南の王は、大いに怒り、出てきて北の王と戦います。彼は大軍を起すけれども、その軍は相手の手にわたされるでしょう。"},{"ref":"Dan.11.12","start":27011012,"end":27011012,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ぐん"],[6,1,"う"],[8,1,"やぶ"],[16,1,"こころ"],[18,1,"たか"],[22,1,"すう"],[23,1,"まん"],[24,1,"にん"],[26,1,"たお"],[35,1,"か"]],"text":"彼がその軍を打ち破ったとき、その心は高ぶり、数万人を倒します。しかし、勝つことはありません。"},{"ref":"Dan.11.13","start":27011013,"end":27011013,"break":"none","ruby":[[3,1,"きた"],[5,1,"おう"],[9,1,"はじ"],[14,1,"おお"],[18,1,"ぐん"],[20,1,"おこ"],[23,2,"すうねん"],[26,1,"のち"],[28,1,"おお"],[32,2,"ぐんぜい"],[35,1,"おお"],[38,2,"ぐんじゅ"],[40,1,"ひん"],[47,1,"せ"],[50,1,"く"]],"text":"それは北の王がまた初めよりも大いなる軍を起し、数年の後、大いなる軍勢と多くの軍需品とをもって、攻めて来るからです。"},{"ref":"Dan.11.14","start":27011014,"end":27011014,"break":"paragraph","ruby":[[4,1,"おお"],[7,1,"もの"],[9,1,"おこ"],[13,1,"みなみ"],[15,1,"おう"],[17,1,"てき"],[28,1,"たみ"],[37,1,"もの"],[44,1,"たか"],[48,1,"こと"],[53,1,"まぼろし"],[55,2,"じょうじゅ"],[64,2,"しっぱい"]],"text":"そのころ多くの者が起って、南の王に敵します。またあなたの民のうちのあらくれ者が、みずから高ぶって事をなし、幻を成就しようとするが失敗するでしょう。"},{"ref":"Dan.11.15","start":27011015,"end":27011015,"break":"none","ruby":[[4,1,"きた"],[6,1,"おう"],[11,1,"るい"],[13,1,"きず"],[16,2,"けんご"],[19,1,"まち"],[21,1,"と"],[25,1,"みなみ"],[27,1,"おう"],[29,1,"ちから"],[35,1,"た"],[37,1,"む"],[53,1,"ぬ"],[56,1,"たみ"],[62,1,"た"],[64,1,"む"],[67,1,"ちから"]],"text":"こうして北の王がきて、塁を築き、堅固な町を取るが、南の王の力は、これに立ち向かうことができず、またそのえり抜きの民も、これに立ち向かう力がありません。"},{"ref":"Dan.11.16","start":27011016,"end":27011016,"break":"none","ruby":[[3,1,"せ"],[6,1,"く"],[8,1,"もの"],[13,1,"こころ"],[18,1,"こと"],[25,1,"まえ"],[27,1,"た"],[29,1,"む"],[38,1,"もの"],[43,1,"かれ"],[45,1,"うるわ"],[48,1,"ち"],[50,1,"た"],[55,1,"ち"],[57,1,"まった"],[59,1,"かれ"],[64,1,"あら"]],"text":"これに攻めて来る者は、その心のままに事をなし、その前に立ち向かうことのできる者はなく、彼は麗しい地に立ち、その地は全く彼のために荒されます。"},{"ref":"Dan.11.17","start":27011017,"end":27011017,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ぜんこく"],[5,1,"ちから"],[10,1,"う"],[12,1,"はい"],[19,1,"かお"],[21,1,"む"],[26,2,"あいて"],[29,2,"なかなお"],[37,1,"むすめ"],[39,1,"あた"],[45,1,"くに"],[47,1,"と"],[61,1,"こと"],[63,1,"な"],[69,1,"かれ"],[71,2,"りえき"]],"text":"彼は全国の力をもって討ち入ろうと、その顔を向けるが、相手と仲直りをし、その娘を与えて、その国を取ろうとします。しかし、その事は成らず、また彼の利益にはならないでしょう。"},{"ref":"Dan.11.18","start":27011018,"end":27011018,"break":"none","ruby":[[2,1,"のち"],[4,1,"かれ"],[6,1,"かお"],[8,2,"うみぞ"],[12,2,"くにぐに"],[15,1,"む"],[21,1,"おお"],[27,1,"と"],[40,2,"たいしょう"],[47,1,"かれ"],[49,1,"あた"],[52,2,"ちじょく"],[61,2,"ちじょく"],[64,1,"かれ"],[66,1,"うえ"],[68,1,"かえ"]],"text":"その後、彼は顔を海沿いの国々に向けて、その多くのものを取ります。しかし、ひとりの大将があって、彼が与えた恥辱をそそぎ、その恥辱を彼の上に返します。"},{"ref":"Dan.11.19","start":27011019,"end":27011019,"break":"none","ruby":[[4,1,"かれ"],[9,1,"かお"],[11,2,"じぶん"],[14,1,"くに"],[16,2,"ようがい"],[19,1,"む"],[24,1,"かれ"],[30,1,"たお"],[33,1,"き"]],"text":"こうして彼は、その顔を自分の国の要害に向けるが、彼はつまずき倒れて消えうせるでしょう。"},{"ref":"Dan.11.20","start":27011020,"end":27011020,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"かわ"],[5,1,"おこ"],[7,1,"もの"],[10,2,"えいこう"],[13,1,"くに"],[15,1,"ひと"],[23,2,"そぜい"],[26,1,"と"],[28,1,"た"],[41,1,"かれ"],[44,1,"いか"],[48,1,"たたか"],[56,2,"すうじつ"],[62,1,"ほろ"]],"text":"彼に代って起る者は、栄光の国に人をつかわして、租税を取り立てさせるでしょう。しかし彼は、怒りにも戦いにもよらず、数日のうちに滅ぼされます。"},{"ref":"Dan.11.21","start":27011021,"end":27011021,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かわ"],[5,1,"おこ"],[7,1,"もの"],[10,1,"いや"],[15,1,"もの"],[21,1,"かれ"],[25,1,"おう"],[27,2,"そんげん"],[30,1,"あた"],[36,1,"かれ"],[38,2,"ふい"],[44,2,"こうげん"],[50,1,"くに"],[52,1,"え"]],"text":"彼に代って起る者は、卑しむべき者であって、彼には、王の尊厳が与えられず、彼は不意にきて、巧言をもって国を獲るでしょう。"},{"ref":"Dan.11.22","start":27011022,"end":27011022,"break":"none","ruby":[[0,2,"こうずい"],[6,2,"ぐんぜい"],[10,1,"かれ"],[12,1,"まえ"],[14,1,"お"],[16,1,"なが"],[20,1,"やぶ"],[24,2,"けいやく"],[27,1,"きみ"],[30,1,"もの"],[34,1,"やぶ"]],"text":"洪水のような軍勢は、彼の前に押し流されて敗られ、契約の君たる者もまた敗られるでしょう。"},{"ref":"Dan.11.23","start":27011023,"end":27011023,"break":"none","ruby":[[0,1,"かれ"],[6,2,"どうめい"],[9,1,"むす"],[12,1,"のち"],[14,1,"いつわ"],[29,1,"たみ"],[34,1,"つよ"]],"text":"彼は、これと同盟を結んで後、偽りのおこないをなし、わずかな民をもって強くなり、"},{"ref":"Dan.11.24","start":27011024,"end":27011024,"break":"none","ruby":[[0,2,"ふい"],[5,1,"しゅう"],[7,1,"もっと"],[9,1,"こ"],[12,1,"ところ"],[14,1,"せ"],[16,1,"い"],[21,1,"ちち"],[26,1,"ちち"],[28,1,"ちち"],[35,1,"こと"],[44,1,"うば"],[47,1,"もの"],[53,1,"もの"],[57,2,"ざいほう"],[61,2,"ひとびと"],[64,1,"なか"],[66,1,"ち"],[74,1,"かれ"],[78,2,"けいりゃく"],[87,2,"けんご"],[90,1,"しろ"],[92,1,"せ"],[104,1,"とき"],[106,1,"いた"]],"text":"不意にその州の最も肥えた所に攻め入り、その父も、その父の父もしなかった事をおこない、その奪った物、かすめた物および財宝を、人々の中に散らすでしょう。彼はまた計略をめぐらして、堅固な城を攻めるが、ただし、それは時の至るまでです。"},{"ref":"Dan.11.25","start":27011025,"end":27011025,"break":"none","ruby":[[0,1,"かれ"],[4,2,"せいりょく"],[7,2,"ゆうき"],[11,1,"ふる"],[13,1,"おこ"],[16,2,"たいぐん"],[19,1,"ひき"],[22,1,"みなみ"],[24,1,"おう"],[26,1,"せ"],[31,1,"みなみ"],[33,1,"おう"],[41,1,"ふる"],[48,1,"おお"],[52,2,"きょうりょく"],[55,2,"ぐんぜい"],[61,1,"たたか"],[70,1,"かれ"],[72,1,"たい"],[76,2,"いんぼう"],[83,1,"もの"],[93,1,"た"],[95,1,"む"]],"text":"彼はその勢力と勇気とを奮い起し、大軍を率いて南の王を攻めます。南の王もまたみずから奮い、はなはだ大いなる強力な軍勢をもって戦います。しかし、彼に対して、陰謀をめぐらす者があるので、これに立ち向かうことができません。"},{"ref":"Dan.11.26","start":27011026,"end":27011026,"break":"none","ruby":[[4,1,"かれ"],[6,2,"しょくもつ"],[9,1,"た"],[12,1,"もの"],[17,1,"かれ"],[19,1,"ほろ"],[31,2,"ぐんぜい"],[34,1,"お"],[36,1,"なが"],[41,1,"おお"],[44,1,"もの"],[46,1,"たお"],[48,1,"し"]],"text":"すなわち彼の食物を食べる者たちが、彼を滅ぼします。そして、その軍勢は押し流されて、多くの者が倒れ死ぬでしょう。"},{"ref":"Dan.11.27","start":27011027,"end":27011027,"break":"none","ruby":[[6,1,"おう"],[9,1,"がい"],[11,1,"あた"],[16,1,"こころ"],[25,2,"しょくたく"],[28,1,"とも"],[30,1,"しょく"],[34,1,"いつわ"],[37,1,"かた"],[44,2,"せいこう"],[51,1,"おわ"],[56,1,"さだ"],[60,1,"とき"],[62,1,"く"]],"text":"このふたりの王は、害を与えようと心にはかり、ひとつ食卓に共に食して、偽りを語るが、それは成功しません。終りはなお定まった時の来るまでこないからです。"},{"ref":"Dan.11.28","start":27011028,"end":27011028,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おお"],[6,2,"ざいほう"],[13,2,"じぶん"],[16,1,"くに"],[18,1,"かえ"],[29,1,"かれ"],[31,1,"こころ"],[33,1,"せい"],[36,2,"けいやく"],[49,1,"こと"],[55,2,"じぶん"],[58,1,"くに"],[60,1,"かえ"]],"text":"彼は大いなる財宝をもって、自分の国に帰るでしょう。しかし、彼の心は聖なる契約にそむき、ほしいままに事をなして、自分の国に帰ります。"},{"ref":"Dan.11.29","start":27011029,"end":27011029,"break":"paragraph","ruby":[[0,1,"さだ"],[4,1,"とき"],[10,1,"かれ"],[14,1,"みなみ"],[16,1,"う"],[18,1,"い"],[29,1,"とき"],[31,1,"まえ"],[33,1,"とき"]],"text":"定まった時になって、彼はまた南に討ち入ります。しかし、この時は前の時のようではありません。"},{"ref":"Dan.11.30","start":27011030,"end":27011030,"break":"none","ruby":[[8,1,"ふね"],[11,1,"かれ"],[13,1,"た"],[15,1,"む"],[19,1,"く"],[24,1,"かれ"],[26,1,"おびや"],[31,1,"かえ"],[34,1,"せい"],[37,2,"けいやく"],[40,1,"たい"],[43,1,"いきどお"],[46,1,"こと"],[48,1,"おこな"],[55,1,"かれ"],[57,1,"かえ"],[64,1,"せい"],[67,2,"けいやく"],[70,1,"す"],[73,1,"もの"],[75,1,"かえり"],[77,1,"もち"]],"text":"それはキッテムの船が、彼に立ち向かって来るので、彼は脅かされて帰り、聖なる契約に対して憤り、事を行うでしょう。彼は帰っていって、聖なる契約を捨てる者を顧み用いるでしょう。"},{"ref":"Dan.11.31","start":27011031,"end":27011031,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ぐんぜい"],[6,1,"おこ"],[10,2,"しんでん"],[13,2,"じょうかく"],[16,1,"けが"],[19,2,"じょうく"],[22,2,"はんさい"],[25,1,"と"],[27,1,"のぞ"],[30,1,"あら"],[32,1,"にく"],[39,1,"た"]],"text":"彼から軍勢が起って、神殿と城郭を汚し、常供の燔祭を取り除き、荒す憎むべきものを立てるでしょう。"},{"ref":"Dan.11.32","start":27011032,"end":27011032,"break":"none","ruby":[[0,1,"かれ"],[2,2,"けいやく"],[5,1,"やぶ"],[7,1,"もの"],[12,2,"こうげん"],[31,2,"じぶん"],[34,1,"かみ"],[36,1,"し"],[38,1,"たみ"],[41,1,"かた"],[43,1,"た"],[46,1,"こと"],[48,1,"おこな"]],"text":"彼は契約を破る者どもを、巧言をもってそそのかし、そむかせるが、自分の神を知る民は、堅く立って事を行います。"},{"ref":"Dan.11.33","start":27011033,"end":27011033,"break":"none","ruby":[[0,1,"たみ"],[5,1,"かしこ"],[7,2,"ひとびと"],[11,1,"おお"],[14,1,"ひと"],[16,1,"さと"],[19,1,"いた"],[30,1,"かれ"],[38,1,"あいだ"],[48,1,"ひ"],[50,1,"や"],[54,1,"とら"],[67,1,"たお"]],"text":"民のうちの賢い人々は、多くの人を悟りに至らせます。それでも、彼らはしばらくの間、やいばにかかり、火に焼かれ、捕われ、かすめられなどして倒れます。"},{"ref":"Dan.11.34","start":27011034,"end":27011034,"break":"none","ruby":[[2,1,"たお"],[8,1,"かれ"],[11,1,"すこ"],[14,1,"たす"],[17,1,"え"],[23,1,"おお"],[26,1,"ひと"],[29,2,"こうげん"],[35,1,"かれ"]],"text":"その倒れるとき、彼らは少しの助けを獲ます。また多くの人が、巧言をもって彼らにくみするでしょう。"},{"ref":"Dan.11.35","start":27011035,"end":27011035,"break":"none","ruby":[[2,1,"かしこ"],[4,1,"もの"],[11,1,"もの"],[14,1,"おわ"],[17,1,"とき"],[21,2,"じぶん"],[24,1,"ね"],[27,1,"きよ"],[30,1,"しろ"],[37,1,"たお"],[45,1,"おわ"],[50,1,"さだ"],[54,1,"とき"],[56,1,"く"]],"text":"また賢い者のうちのある者は、終りの時まで、自分を練り、清め、白くするために倒れるでしょう。終りはなお定まった時の来るまでこないからです。"},{"ref":"Dan.11.36","start":27011036,"end":27011036,"break":"paragraph","ruby":[[2,1,"おう"],[7,1,"こころ"],[12,1,"こと"],[23,1,"かみ"],[25,1,"こ"],[29,2,"じぶん"],[32,1,"たか"],[36,2,"じぶん"],[39,1,"おお"],[44,2,"かみがみ"],[47,1,"かみ"],[50,1,"もの"],[57,1,"おどろ"],[61,1,"こと"],[63,1,"かた"],[66,1,"いきどお"],[71,1,"とき"],[74,1,"さか"],[85,1,"さだ"],[90,1,"こと"],[92,2,"じょうじゅ"]],"text":"この王は、その心のままに事をおこない、すべての神を越えて、自分を高くし、自分を大いにし、神々の神たる者にむかって、驚くべき事を語り、憤りのやむ時まで栄えるでしょう。これは定められた事が成就するからです。"},{"ref":"Dan.11.37","start":27011037,"end":27011037,"break":"none","ruby":[[0,1,"かれ"],[4,2,"せんぞ"],[7,2,"かみがみ"],[10,1,"かえり"],[16,2,"ふじん"],[19,1,"この"],[21,1,"もの"],[28,1,"かみ"],[31,1,"かえり"],[40,1,"かれ"],[51,2,"じぶん"],[54,1,"おお"],[58,1,"もの"]],"text":"彼はその先祖の神々を顧みず、また婦人の好む者も、いかなる神をも顧みないでしょう。彼はすべてにまさって、自分を大いなる者とするからです。"},{"ref":"Dan.11.38","start":27011038,"end":27011038,"break":"none","ruby":[[0,1,"かれ"],[6,1,"もの"],[8,1,"かわ"],[12,2,"ようがい"],[15,1,"かみ"],[21,1,"きん"],[23,1,"ぎん"],[25,2,"ほうせき"],[31,2,"たからもの"],[40,2,"せんぞ"],[45,1,"し"],[51,1,"かみ"]],"text":"彼はこれらの者の代りに、要害の神をあがめ、金、銀、宝石、および宝物をもって、その先祖たちの知らなかった神をあがめ、"},{"ref":"Dan.11.39","start":27011039,"end":27011039,"break":"none","ruby":[[0,2,"いほう"],[3,1,"かみ"],[5,1,"たす"],[12,1,"もっと"],[14,2,"きょうこ"],[17,1,"しろ"],[24,1,"こと"],[36,1,"かれ"],[38,1,"みと"],[41,1,"もの"],[45,2,"えいよ"],[48,1,"ま"],[50,1,"あた"],[56,1,"おお"],[59,1,"ひと"],[61,1,"おさ"],[66,2,"しょうよ"],[71,2,"とち"],[74,1,"わ"],[76,1,"あた"]],"text":"異邦の神の助けによって、最も強固な城にむかって、事をなすでしょう。そして彼を認める者には、栄誉を増し与え、これに多くの人を治めさせ、賞与として土地を分け与えるでしょう。"},{"ref":"Dan.11.40","start":27011040,"end":27011040,"break":"paragraph","ruby":[[0,1,"おわ"],[3,1,"とき"],[9,1,"みなみ"],[11,1,"おう"],[13,1,"かれ"],[15,1,"たたか"],[20,1,"きた"],[22,1,"おう"],[25,2,"せんしゃ"],[28,2,"きへい"],[32,1,"おお"],[35,1,"ふね"],[44,1,"かぜ"],[49,1,"かれ"],[51,1,"せ"],[54,2,"くにぐに"],[73,1,"とお"],[75,1,"す"]],"text":"終りの時になって、南の王は彼と戦います。北の王は、戦車と騎兵と、多くの船をもって、つむじ風のように彼を攻め、国々にはいっていって、みなぎりあふれ、通り過ぎるでしょう。"},{"ref":"Dan.11.41","start":27011041,"end":27011041,"break":"none","ruby":[[0,1,"かれ"],[4,1,"うるわ"],[7,1,"くに"],[17,1,"かれ"],[23,1,"おお"],[26,1,"もの"],[28,1,"ほろ"],[61,1,"もの"],[64,1,"かれ"],[66,1,"て"],[69,1,"すく"]],"text":"彼はまた麗しい国にはいります。また彼によって、多くの者が滅ぼされます。しかし、エドム、モアブ、アンモンびとらのうちのおもな者は、彼の手から救われましょう。"},{"ref":"Dan.11.42","start":27011042,"end":27011042,"break":"none","ruby":[[0,1,"かれ"],[2,2,"くにぐに"],[7,1,"て"],[9,1,"の"],[18,1,"ち"],[20,1,"まぬか"]],"text":"彼は国々にその手を伸ばし、エジプトの地も免れません。"},{"ref":"Dan.11.43","start":27011043,"end":27011043,"break":"none","ruby":[[0,1,"かれ"],[2,2,"きんぎん"],[5,2,"ざいほう"],[18,2,"たからもの"],[21,2,"しはい"],[40,1,"かれ"],[45,1,"したが"]],"text":"彼は金銀の財宝と、エジプトのすべての宝物を支配し、リビヤびと、エチオピヤびとは、彼のあとに従います。"},{"ref":"Dan.11.44","start":27011044,"end":27011044,"break":"none","ruby":[[3,1,"ひがし"],[5,1,"きた"],[9,1,"し"],[13,1,"かれ"],[15,1,"おどろ"],[19,1,"かれ"],[21,1,"おお"],[24,1,"ひと"],[26,1,"ほろ"],[29,1,"た"],[35,1,"おお"],[39,1,"いか"],[45,1,"で"],[47,1,"い"]],"text":"しかし東と北からの知らせが彼を驚かし、彼は多くの人を滅ぼし絶やそうと、大いなる怒りをもって出て行きます。"},{"ref":"Dan.11.45","start":27011045,"end":27011045,"break":"none","ruby":[[0,1,"かれ"],[2,1,"うみ"],[4,1,"うるわ"],[7,2,"せいざん"],[11,1,"あいだ"],[14,2,"てんまく"],[17,2,"きゅうでん"],[20,1,"もう"],[32,1,"かれ"],[39,1,"おわ"],[46,1,"かれ"],[48,1,"たす"],[51,1,"もの"]],"text":"彼は海と麗しい聖山との間に、天幕の宮殿を設けるでしょう。しかし、彼はついにその終りにいたり、彼を助ける者はないでしょう。"}]