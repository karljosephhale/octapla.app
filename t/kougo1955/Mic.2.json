[{"ref":"Mic.2.1","start":33002001,"end":33002001,"break":"paragraph","breaks":[[12,"line"],[26,"line"],[39,"line"]],"ruby":[[2,1,"とこ"],[4,1,"うえ"],[6,2,"ふぎ"],[9,1,"はか"],[12,1,"あく"],[14,1,"おこな"],[16,1,"もの"],[26,1,"かれ"],[31,1,"て"],[33,1,"ちから"],[39,1,"よ"],[41,1,"あ"],[48,1,"おこな"]],"text":"その床の上で不義を計り、悪を行う者はわざわいである。彼らはその手に力あるゆえ、夜が明けるとこれを行う。"},{"ref":"Mic.2.2","start":33002002,"end":33002002,"break":"line","breaks":[[17,"line"],[30,"line"],[47,"line"]],"ruby":[[0,1,"かれ"],[3,2,"たはた"],[14,1,"うば"],[17,1,"いえ"],[27,1,"と"],[30,1,"かれ"],[33,1,"ひと"],[42,1,"いえ"],[44,1,"うば"],[47,1,"ひと"],[56,1,"し"],[57,1,"ぎょう"],[59,1,"うば"]],"text":"彼らは田畑をむさぼってこれを奪い、家をむさぼってこれを取る。彼らは人をしえたげてその家を奪い、人をしえたげてその嗣業を奪う。"},{"ref":"Mic.2.3","start":33002003,"end":33002003,"break":"line","breaks":[[14,"line"],[31,"line"],[40,"line"],[50,"line"],[66,"line"],[87,"line"]],"ruby":[[5,1,"しゅ"],[9,1,"い"],[14,1,"み"],[31,1,"わざわい"],[33,1,"くだ"],[37,1,"はか"],[48,1,"くび"],[74,1,"た"],[77,1,"ある"],[90,1,"わざわい"],[92,1,"とき"]],"text":"それゆえ、主はこう言われる、見よ、わたしはこのやからにむかって災を下そうと計る。あなたがたはその首をこれから、はずすことはできない。また、まっすぐに立って歩くことはできない。これは災の時だからである。"},{"ref":"Mic.2.4","start":33002004,"end":33002004,"break":"line","breaks":[[23,"line"],[38,"line"],[55,"line"],[69,"line"],[90,"line"]],"ruby":[[2,1,"ひ"],[4,2,"ひとびと"],[7,1,"うた"],[9,1,"つく"],[23,1,"かな"],[27,1,"うた"],[32,1,"なげ"],[34,1,"かな"],[49,1,"ほろ"],[57,1,"たみ"],[59,1,"ぶん"],[61,1,"ひと"],[63,1,"あた"],[81,1,"はな"],[95,2,"たはた"],[103,1,"とら"],[106,1,"もの"],[108,1,"あいだ"],[110,1,"わ"],[112,1,"あた"],[119,1,"い"]],"text":"その日、人々は歌を作ってあなたがたをののしり、悲しみの歌をもって嘆き悲しみ、「われわれはことごとく滅ぼされる、わが民の分は人に与えられる。どうしてこれはわたしから離れるのであろう。われわれの田畑はわれわれを捕えた者の間に分け与えられる」と言う。"},{"ref":"Mic.2.5","start":33002005,"end":33002005,"break":"line","breaks":[[14,"line"]],"ruby":[[5,1,"しゅ"],[7,2,"かいしゅう"],[20,1,"はか"],[25,1,"は"],[27,1,"もの"]],"text":"それゆえ、主の会衆のうちにはくじによって測りなわを張る者はひとりもなくなる。"},{"ref":"Mic.2.6","start":33002006,"end":33002006,"break":"stanza","breaks":[[23,"line"],[43,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[13,2,"せっきょう"],[28,1,"こと"],[33,2,"せっきょう"],[53,1,"はじ"]],"text":"彼らは言う、「あなたがたは説教してはならない。そのような事について説教してはならない。そうすればわれわれは恥をこうむることがない」と。"},{"ref":"Mic.2.7","start":33002007,"end":33002007,"break":"line","breaks":[[22,"line"],[34,"line"],[51,"line"],[64,"line"]],"ruby":[[4,1,"いえ"],[13,1,"い"],[22,1,"しゅ"],[24,2,"きみじか"],[27,1,"かた"],[38,1,"しゅ"],[53,2,"ことば"],[56,1,"ただ"],[59,1,"あゆ"],[61,1,"もの"],[64,1,"えき"]],"text":"ヤコブの家よ、そんなことは言えるのだろうか。主は気短な方であろうか。これらは主のみわざなのであろうか。わが言葉は正しく歩む者に、益とならないのであろうか。"},{"ref":"Mic.2.8","start":33002008,"end":33002008,"break":"line","breaks":[[23,"line"],[47,"line"]],"ruby":[[11,1,"た"],[16,1,"たみ"],[18,1,"てき"],[30,1,"し"],[35,1,"やす"],[39,1,"す"],[43,1,"もの"],[47,2,"へいわ"],[50,1,"もの"],[54,2,"うわぎ"],[59,1,"と"]],"text":"ところが、あなたがたは立ってわが民の敵となり、いくさのことを知らずに、安らかに過ぎゆく者から、平和な者から、上着をはぎ取り、"},{"ref":"Mic.2.9","start":33002009,"end":33002009,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"たみ"],[4,1,"おんな"],[10,1,"たの"],[13,1,"いえ"],[16,1,"お"],[18,1,"だ"],[23,1,"こ"],[31,1,"さか"],[39,1,"うば"]],"text":"わが民の女たちをその楽しい家から追い出し、その子どもから、わが栄えをとこしえに奪う。"},{"ref":"Mic.2.10","start":33002010,"end":33002010,"break":"line","breaks":[[6,"line"],[24,"line"],[37,"line"]],"ruby":[[0,1,"た"],[3,1,"さ"],[15,1,"やす"],[17,2,"ばしょ"],[27,1,"けが"],[33,1,"ほろ"],[39,1,"ほろ"],[42,2,"ひさん"],[45,1,"ほろ"]],"text":"立って去れ、これはあなたがたの休み場所ではない。これは汚れのゆえに滅びる。その滅びは悲惨な滅びだ。"},{"ref":"Mic.2.11","start":33002011,"end":33002011,"break":"line","breaks":[[15,"line"],[34,"line"],[51,"line"]],"ruby":[[2,1,"ひと"],[4,1,"かぜ"],[6,1,"あゆ"],[9,1,"いつわ"],[12,1,"い"],[23,1,"しゅ"],[25,1,"こ"],[27,1,"さけ"],[38,2,"せっきょう"],[45,1,"い"],[53,1,"ひと"],[57,1,"たみ"],[59,2,"せっきょう"],[61,1,"しゃ"]],"text":"もし人が風に歩み、偽りを言い、「わたしはぶどう酒と濃き酒とについて、あなたに説教しよう」と言うならば、その人はこの民の説教者となるであろう。"},{"ref":"Mic.2.12","start":33002012,"end":33002012,"break":"stanza","breaks":[[23,"line"],[38,"line"],[54,"line"],[70,"line"]],"ruby":[[9,1,"かなら"],[20,1,"あつ"],[29,1,"のこ"],[32,1,"もの"],[34,1,"あつ"],[48,1,"ひつじ"],[54,2,"まきば"],[57,1,"なか"],[59,1,"む"],[65,1,"とも"],[73,1,"ひと"],[75,1,"おお"],[81,1,"さわ"]],"text":"ヤコブよ、わたしは必ずあなたをことごとく集め、イスラエルの残れる者を集める。わたしはこれをおりの羊のように、牧場の中の群れのように共におく。これは人の多きによって騒がしくなる。"},{"ref":"Mic.2.13","start":33002013,"end":33002013,"break":"line","breaks":[[18,"line"],[42,"line"],[54,"line"]],"ruby":[[0,1,"う"],[2,1,"やぶ"],[4,1,"もの"],[6,1,"かれ"],[9,1,"さき"],[13,1,"のぼ"],[18,1,"かれ"],[21,1,"もん"],[23,1,"う"],[25,1,"やぶ"],[35,1,"そと"],[37,1,"で"],[39,1,"い"],[42,1,"かれ"],[45,1,"おう"],[49,1,"まえ"],[51,1,"すす"],[54,1,"しゅ"],[58,2,"せんとう"],[61,1,"た"]],"text":"打ち破る者は彼らに先だって登りゆき、彼らは門を打ち破り、これをとおって外に出て行く。彼らの王はその前に進み、主はその先頭に立たれる。"}]