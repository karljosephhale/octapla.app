[{"ref":"Prov.18.1","start":20018001,"end":20018001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[0,1,"ひと"],[2,1,"まじ"],[9,1,"もの"],[11,2,"こうじつ"],[14,1,"さが"],[23,1,"かんが"],[26,1,"はげ"],[29,2,"はんたい"]],"text":"人と交わりをしない者は口実を捜し、すべてのよい考えに激しく反対する。"},{"ref":"Prov.18.2","start":20018002,"end":20018002,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"さと"],[10,1,"よろこ"],[16,2,"じぶん"],[19,2,"いけん"],[22,1,"い"],[24,1,"あら"],[30,1,"よろこ"]],"text":"愚かな者は悟ることを喜ばず、ただ自分の意見を言い表わすことを喜ぶ。"},{"ref":"Prov.18.3","start":20018003,"end":20018003,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"く"],[9,1,"いや"],[15,1,"く"],[18,3,"ふめいよ"],[22,1,"く"],[32,1,"とも"]],"text":"悪しき者が来ると、卑しめもまた来る、不名誉が来ると、はずかしめも共にくる。"},{"ref":"Prov.18.4","start":20018004,"end":20018004,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ひと"],[2,1,"くち"],[4,2,"ことば"],[7,1,"ふか"],[9,1,"みず"],[15,2,"ちえ"],[18,1,"いずみ"],[24,1,"なが"],[27,1,"かわ"]],"text":"人の口の言葉は深い水のようだ、知恵の泉は、わいて流れる川である。"},{"ref":"Prov.18.5","start":20018005,"end":20018005,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[15,1,"よ"],[20,1,"ただ"],[23,1,"もの"],[30,1,"あ"],[33,1,"もの"],[40,1,"よ"]],"text":"悪しき者をえこひいきすることは良くない、正しい者をさばいて、悪しき者とすることも良くない。"},{"ref":"Prov.18.6","start":20018006,"end":20018006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[10,1,"あらそ"],[13,1,"おこ"],[18,1,"くち"],[22,1,"う"],[29,1,"まね"]],"text":"愚かな者のくちびるは争いを起し、その口はむち打たれることを招く。"},{"ref":"Prov.18.7","start":20018007,"end":20018007,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"くち"],[7,2,"じぶん"],[10,1,"ほろ"],[23,2,"じぶん"],[26,1,"とら"]],"text":"愚かな者の口は自分の滅びとなり、そのくちびるは自分を捕えるわなとなる。"},{"ref":"Prov.18.8","start":20018008,"end":20018008,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ひと"],[9,1,"もの"],[11,2,"ことば"],[18,2,"しょくもつ"],[25,1,"はら"],[27,1,"おく"]],"text":"人のよしあしをいう者の言葉はおいしい食物のようで、腹の奥にしみこむ。"},{"ref":"Prov.18.9","start":20018009,"end":20018009,"break":"line","ruby":[[2,2,"しごと"],[5,1,"おこた"],[7,1,"もの"],[10,1,"ほろ"],[13,1,"もの"],[15,2,"きょうだい"]],"text":"その仕事を怠る者は、滅ぼす者の兄弟である。"},{"ref":"Prov.18.10","start":20018010,"end":20018010,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"な"],[4,2,"けんご"],[15,1,"ただ"],[18,1,"もの"],[22,1,"なか"],[24,1,"はし"],[29,1,"すくい"],[31,1,"え"]],"text":"主の名は堅固なやぐらのようだ、正しい者はその中に走りこんで救を得る。"},{"ref":"Prov.18.11","start":20018011,"end":20018011,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"と"],[3,1,"もの"],[5,1,"とみ"],[9,1,"かた"],[11,1,"しろ"],[19,1,"たか"],[21,2,"じょうへき"],[27,1,"かれ"],[29,1,"まも"]],"text":"富める者の富はその堅き城である、それは高き城壁のように彼を守る。"},{"ref":"Prov.18.12","start":20018012,"end":20018012,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ひと"],[2,1,"こころ"],[4,1,"たか"],[8,1,"ほろ"],[16,2,"けんそん"],[19,2,"えいよ"]],"text":"人の心の高ぶりは滅びにさきだち、謙遜は栄誉にさきだつ。"},{"ref":"Prov.18.13","start":20018013,"end":20018013,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"こと"],[4,1,"き"],[9,1,"こた"],[12,1,"もの"],[15,1,"おろ"],[21,1,"はじ"]],"text":"事をよく聞かないで答える者は、愚かであって恥をこうむる。"},{"ref":"Prov.18.14","start":20018014,"end":20018014,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"ひと"],[2,1,"こころ"],[4,2,"びょうく"],[8,1,"しの"],[14,1,"こころ"],[16,1,"いた"],[28,1,"た"]],"text":"人の心は病苦をも忍ぶ、しかし心の痛むときは、だれがそれに耐えようか。"},{"ref":"Prov.18.15","start":20018015,"end":20018015,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"もの"],[5,1,"こころ"],[7,2,"ちしき"],[10,1,"え"],[12,2,"ちえ"],[16,1,"もの"],[18,1,"みみ"],[20,2,"ちしき"],[23,1,"もと"]],"text":"さとき者の心は知識を得、知恵ある者の耳は知識を求める。"},{"ref":"Prov.18.16","start":20018016,"end":20018016,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ひと"],[2,1,"おく"],[4,1,"もの"],[9,1,"ひと"],[14,1,"みち"],[22,1,"たっと"],[24,1,"ひと"],[26,1,"まえ"],[28,1,"かれ"],[30,1,"みちび"]],"text":"人の贈り物は、その人のために道をひらき、また尊い人の前に彼を導く。"},{"ref":"Prov.18.17","start":20018017,"end":20018017,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"さき"],[2,1,"うった"],[4,1,"で"],[6,1,"もの"],[8,1,"ただ"],[14,1,"み"],[23,1,"うった"],[28,1,"ひと"],[30,1,"き"],[36,1,"しら"],[40,1,"こと"],[42,1,"あき"]],"text":"先に訴え出る者は正しいように見える、しかしその訴えられた人が来て、それを調べて、事は明らかになる。"},{"ref":"Prov.18.18","start":20018018,"end":20018018,"break":"line","breaks":[[10,"line"]],"ruby":[[3,1,"あらそ"],[12,1,"つよ"],[14,1,"あらそ"],[16,2,"あいて"],[19,1,"あいだ"],[21,2,"けってい"]],"text":"くじは争いをとどめ、かつ強い争い相手の間を決定する。"},{"ref":"Prov.18.19","start":20018019,"end":20018019,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"たす"],[4,2,"きょうだい"],[7,2,"けんご"],[10,1,"しろ"],[19,1,"あらそ"],[27,1,"かん"],[29,1,"き"]],"text":"助けあう兄弟は堅固な城のようだ、しかし争いは、やぐらの貫の木のようだ。"},{"ref":"Prov.18.20","start":20018020,"end":20018020,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ひと"],[2,2,"じぶん"],[5,2,"ことば"],[8,1,"むす"],[10,1,"み"],[16,1,"み"],[18,1,"た"],[28,2,"さんぶつ"],[34,1,"みずか"],[36,1,"あ"]],"text":"人は自分の言葉の結ぶ実によって、満ち足り、そのくちびるの産物によって自ら飽きる。"},{"ref":"Prov.18.21","start":20018021,"end":20018021,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"し"],[2,1,"せい"],[5,1,"した"],[7,2,"しはい"],[16,1,"あい"],[19,1,"もの"],[23,1,"み"],[25,1,"た"]],"text":"死と生とは舌に支配される、これを愛する者はその実を食べる。"},{"ref":"Prov.18.22","start":20018022,"end":20018022,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"つま"],[2,1,"え"],[4,1,"もの"],[7,1,"よ"],[9,1,"もの"],[11,1,"え"],[16,1,"しゅ"],[19,1,"めぐ"],[22,1,"あた"]],"text":"妻を得る者は、良き物を得る、かつ主から恵みを与えられる。"},{"ref":"Prov.18.23","start":20018023,"end":20018023,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[11,1,"こ"],[14,1,"と"],[17,1,"もの"],[24,1,"こたえ"]],"text":"貧しい者は、あわれみを請い、富める者は、はげしい答をする。"},{"ref":"Prov.18.24","start":20018024,"end":20018024,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"よ"],[3,1,"とも"],[7,1,"み"],[12,1,"とも"],[20,2,"きょうだい"],[30,1,"とも"]],"text":"世には友らしい見せかけの友がある、しかし兄弟よりもたのもしい友もある。"}]