[{"ref":"Jer.39.1","start":24039001,"end":24039001,"break":"paragraph","ruby":[[3,1,"おう"],[10,1,"ねん"],[12,1,"がつ"],[19,1,"おう"],[30,1,"ぜん"],[31,1,"ぐん"],[33,1,"ひき"],[42,1,"き"],[47,1,"せ"],[49,1,"かこ"]],"text":"ユダの王ゼデキヤの九年十月、バビロンの王ネブカデレザルはその全軍を率い、エルサレムに来てこれを攻め囲んだが、"},{"ref":"Jer.39.2","start":24039002,"end":24039002,"break":"none","ruby":[[7,1,"ねん"],[9,1,"がつ"],[11,1,"か"],[16,1,"まち"],[18,2,"いっかく"],[21,1,"やぶ"]],"text":"ゼデキヤの十一年四月九日になって町の一角が破れた。"},{"ref":"Jer.39.3","start":24039003,"end":24039003,"break":"none","ruby":[[6,1,"と"],[18,1,"おう"],[84,1,"おう"],[88,1,"た"],[96,1,"みな"],[100,1,"き"],[102,1,"なか"],[104,1,"もん"],[106,1,"ざ"]],"text":"エルサレムが取られたので、バビロンの王のつかさたち、すなわちネルガル・シャレゼル、サムガル・ネボ、ラブサリスのサルセキム、ラブマグのネルガル・シャレゼルおよびバビロンの王のその他のつかさたちは皆ともに来て中の門に座した。"},{"ref":"Jer.39.4","start":24039004,"end":24039004,"break":"none","ruby":[[3,1,"おう"],[13,2,"へいし"],[21,1,"み"],[23,1,"に"],[26,1,"よる"],[32,1,"おう"],[34,2,"ていえん"],[37,1,"みち"],[39,1,"とお"],[46,2,"じょうへき"],[49,1,"あいだ"],[51,1,"もん"],[54,1,"まち"],[56,1,"で"],[63,1,"ほう"],[65,1,"い"]],"text":"ユダの王ゼデキヤとすべての兵士たちはこれを見て逃げ、夜のうちに、王の庭園の道を通って、二つの城壁の間の門から町を出て、アラバの方へ行ったが、"},{"ref":"Jer.39.5","start":24039005,"end":24039005,"break":"none","ruby":[[7,2,"ぐんぜい"],[13,1,"お"],[21,2,"へいち"],[29,1,"お"],[37,1,"とら"],[45,1,"ち"],[57,1,"おう"],[69,1,"ひ"],[72,1,"い"],[78,1,"おう"],[83,1,"かれ"],[85,1,"つみ"]],"text":"カルデヤびとの軍勢はこれを追って、エリコの平地でゼデキヤに追いつき、これを捕えて、ハマテの地リブラにいるバビロンの王ネブカデレザルのもとに引いて行ったので、王はそこで彼の罪をさだめた。"},{"ref":"Jer.39.6","start":24039006,"end":24039006,"break":"none","ruby":[[5,1,"おう"],[17,1,"こ"],[21,1,"かれ"],[23,1,"め"],[25,1,"まえ"],[27,1,"ころ"],[36,1,"おう"],[47,2,"きぞく"],[52,1,"ころ"]],"text":"バビロンの王はリブラで、ゼデキヤの子たちを彼の目の前で殺した。バビロンの王はまたユダのすべての貴族たちを殺した。"},{"ref":"Jer.39.7","start":24039007,"end":24039007,"break":"none","ruby":[[0,1,"おう"],[9,1,"め"],[16,1,"かれ"],[23,1,"ひ"],[26,1,"い"],[32,1,"くさり"]],"text":"王はまたゼデキヤの目をつぶさせ、彼をバビロンに引いて行くために、鎖につないだ。"},{"ref":"Jer.39.8","start":24039008,"end":24039008,"break":"none","ruby":[[9,2,"おうきゅう"],[12,2,"みんか"],[15,1,"ひ"],[17,1,"や"],[26,2,"じょうへき"],[29,2,"はかい"]],"text":"またカルデヤびとは王宮と民家を火で焼き、エルサレムの城壁を破壊した。"},{"ref":"Jer.39.9","start":24039009,"end":24039009,"break":"none","ruby":[[3,2,"じえい"],[6,1,"ちょう"],[14,1,"まち"],[19,1,"のこ"],[24,1,"たみ"],[27,2,"じぶん"],[30,2,"こうふく"],[34,1,"もの"],[41,1,"た"],[43,1,"のこ"],[48,1,"たみ"],[55,1,"とら"],[57,1,"うつ"]],"text":"そして侍衛の長ネブザラダンは町のうちに残っている民と、自分に降伏した者、およびその他の残っている民をバビロンに捕え移した。"},{"ref":"Jer.39.10","start":24039010,"end":24039010,"break":"none","ruby":[[3,2,"じえい"],[6,1,"ちょう"],[15,1,"たみ"],[17,1,"まず"],[20,2,"むさん"],[22,1,"もの"],[27,1,"ち"],[29,1,"のこ"],[32,2,"どうじ"],[38,1,"はたけ"],[40,2,"でんち"],[46,1,"あた"]],"text":"しかし侍衛の長ネブザラダンは、民の貧しい無産者をユダの地に残し、同時にぶどう畑と田地をこれに与えた。"},{"ref":"Jer.39.11","start":24039011,"end":24039011,"break":"paragraph","ruby":[[7,1,"おう"],[21,1,"こと"],[26,2,"じえい"],[29,1,"ちょう"],[37,1,"めい"],[40,1,"い"]],"text":"さてバビロンの王ネブカデレザルはエレミヤの事について侍衛の長ネブザラダンに命じて言った、"},{"ref":"Jer.39.12","start":24039012,"end":24039012,"break":"none","ruby":[[1,1,"かれ"],[8,2,"せわ"],[14,1,"がい"],[16,1,"くわ"],[24,1,"かれ"],[30,1,"い"]],"text":"「彼をとり、よく世話をせよ。害を加えることなく、彼があなたに言うようにしてやりなさい」。"},{"ref":"Jer.39.13","start":24039013,"end":24039013,"break":"none","ruby":[[3,2,"じえい"],[6,1,"ちょう"],[52,1,"おう"]],"text":"そこで侍衛の長ネブザラダン、ラブサリスのネブシャズバン、ラブマグのネルガル・シャレゼル、およびバビロンの王のつかさたちは、"},{"ref":"Jer.39.14","start":24039014,"end":24039014,"break":"none","ruby":[[0,1,"ひと"],[13,2,"かんし"],[16,1,"にわ"],[19,1,"つ"],[31,1,"こ"],[37,1,"こ"],[46,1,"たく"],[50,1,"いえ"],[55,1,"い"],[64,1,"かれ"],[66,1,"たみ"]],"text":"人をつかわして、エレミヤを監視の庭から連れてこさせ、シャパンの子アヒカムの子であるゲダリヤに託して、家につれて行かせた。こうして彼は民のうちにいた。"},{"ref":"Jer.39.15","start":24039015,"end":24039015,"break":"paragraph","ruby":[[5,2,"かんし"],[8,1,"にわ"],[10,1,"と"],[19,1,"とき"],[21,1,"しゅ"],[23,2,"ことば"],[26,1,"かれ"],[28,1,"のぞ"]],"text":"エレミヤが監視の庭に閉じこめられていた時、主の言葉が彼に臨んだ、"},{"ref":"Jer.39.16","start":24039016,"end":24039016,"break":"none","ruby":[[1,1,"い"],[19,1,"つ"],[26,2,"ばんぐん"],[29,1,"しゅ"],[37,1,"かみ"],[41,1,"い"],[50,1,"い"],[53,1,"わざわい"],[61,1,"まち"],[63,1,"くだ"],[66,1,"さいわい"],[71,1,"くだ"],[81,1,"ひ"],[85,1,"こと"],[91,1,"め"],[93,1,"まえ"],[95,2,"じょうじゅ"]],"text":"「行って、エチオピヤびとエベデメレクに告げなさい、『万軍の主、イスラエルの神はこう言われる、わたしの言った災をわたしはこの町に下す、幸をこれに下すのではない。その日、この事があなたの目の前で成就する。"},{"ref":"Jer.39.17","start":24039017,"end":24039017,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"ひ"],[18,1,"すく"],[25,2,"じぶん"],[28,1,"おそ"],[33,2,"ひとびと"],[36,1,"て"],[38,1,"わた"]],"text":"主は言われる、その日わたしはあなたを救う。あなたは自分の恐れている人々の手に渡されることはない。"},{"ref":"Jer.39.18","start":24039018,"end":24039018,"break":"none","ruby":[[4,1,"かなら"],[10,1,"すく"],[17,1,"たお"],[40,1,"いのち"],[50,1,"もの"],[63,1,"よ"],[65,1,"たよ"],[74,1,"しゅ"],[76,1,"い"]],"text":"わたしが必ずあなたを救い、つるぎに倒れることのないようにするからである。あなたの命はあなたのぶんどり物となる。あなたがわたしに寄り頼んだからであると主は言われる』」。"}]