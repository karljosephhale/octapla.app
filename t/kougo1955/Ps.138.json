[{"ref":"Ps.138.1","start":19138001,"end":19138001,"break":"paragraph","title":"ダビデの歌","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"こころ"],[17,2,"かんしゃ"],[26,1,"かみ"],[28,1,"まえ"],[36,1,"うた"]],"titleRuby":[[4,1,"うた"]],"text":"主よ、わたしは心をつくしてあなたに感謝し、もろもろの神の前であなたをほめ歌います。"},{"ref":"Ps.138.2","start":19138002,"end":19138002,"break":"line","breaks":[[22,"line"],[42,"line"],[51,"line"],[65,"line"]],"ruby":[[8,1,"せい"],[11,1,"みや"],[17,1,"ふ"],[19,1,"おが"],[43,1,"な"],[45,2,"かんしゃ"],[58,1,"な"],[62,2,"ことば"],[76,1,"たか"]],"text":"わたしはあなたの聖なる宮にむかって伏し拝み、あなたのいつくしみと、まこととのゆえに、み名に感謝します。あなたはそのみ名と、み言葉をすべてのものにまさって高くされたからです。"},{"ref":"Ps.138.3","start":19138003,"end":19138003,"break":"line","breaks":[[22,"line"]],"ruby":[[8,1,"よ"],[13,1,"ひ"],[19,1,"こた"],[24,1,"たましい"],[26,1,"ちから"],[28,1,"ま"],[30,1,"くわ"]],"text":"あなたはわたしが呼ばわった日にわたしに答え、わが魂の力を増し加えられました。"},{"ref":"Ps.138.4","start":19138004,"end":19138004,"break":"line","breaks":[[24,"line"],[41,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"ち"],[9,1,"おう"],[15,2,"かんしゃ"],[24,1,"かれ"],[31,1,"くち"],[38,2,"ことば"],[41,1,"き"]],"text":"主よ、地のすべての王はあなたに感謝するでしょう。彼らはあなたの口のもろもろの言葉を聞いたからです。"},{"ref":"Ps.138.5","start":19138005,"end":19138005,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[3,1,"しゅ"],[10,1,"みち"],[15,1,"うた"],[22,1,"しゅ"],[24,2,"えいこう"],[27,1,"おお"]],"text":"彼らは主のもろもろの道について歌うでしょう。主の栄光は大きいからです。"},{"ref":"Ps.138.6","start":19138006,"end":19138006,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"たか"],[11,1,"ひく"],[13,1,"もの"],[26,1,"たか"],[29,1,"もの"],[31,1,"とお"],[35,1,"し"]],"text":"主は高くいらせられるが低い者をかえりみられる。しかし高ぶる者を遠くから知られる。"},{"ref":"Ps.138.7","start":19138007,"end":19138007,"break":"line","breaks":[[18,"line"],[30,"line"],[47,"line"]],"ruby":[[7,1,"なや"],[13,1,"ある"],[26,1,"い"],[31,1,"て"],[33,1,"の"],[39,1,"てき"],[41,1,"いか"],[44,1,"ふせ"],[51,1,"みぎ"],[53,1,"て"],[59,1,"すく"]],"text":"たといわたしが悩みのなかを歩いても、あなたはわたしを生かし、み手を伸ばしてわが敵の怒りを防ぎ、あなたの右の手はわたしを救われます。"},{"ref":"Ps.138.8","start":19138008,"end":19138008,"break":"line","breaks":[[23,"line"],[36,"line"],[53,"line"]],"ruby":[[0,1,"しゅ"],[23,1,"しゅ"],[41,1,"た"],[58,1,"て"],[63,1,"す"]],"text":"主はわたしのために、みこころをなしとげられる。主よ、あなたのいつくしみはとこしえに絶えることはありません。あなたのみ手のわざを捨てないでください。"}]