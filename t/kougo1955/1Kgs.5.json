[{"ref":"1Kgs.5.1","start":11005001,"end":11005001,"break":"paragraph","ruby":[[5,1,"おう"],[16,1,"あぶら"],[18,1,"そそ"],[24,1,"ちち"],[26,1,"かわ"],[30,1,"おう"],[37,1,"き"],[41,2,"けらい"],[59,1,"つね"],[65,1,"あい"]],"text":"さてツロの王ヒラムは、ソロモンが油を注がれ、その父に代って、王となったのを聞いて、家来をソロモンにつかわした。ヒラムは常にダビデを愛したからである。"},{"ref":"1Kgs.5.2","start":11005002,"end":11005002,"break":"none","ruby":[[12,1,"ひと"],[19,1,"い"]],"text":"そこでソロモンはヒラムに人をつかわして言った、"},{"ref":"1Kgs.5.3","start":11005003,"end":11005003,"break":"none","ruby":[[5,1,"し"],[13,1,"ちち"],[20,2,"しゅうい"],[26,1,"てき"],[29,1,"たたか"],[36,1,"かれ"],[38,1,"かみ"],[40,1,"しゅ"],[42,1,"な"],[47,1,"みや"],[49,1,"た"],[59,1,"しゅ"],[61,1,"かれ"],[66,1,"あし"],[68,1,"うら"],[70,1,"した"],[72,1,"お"],[78,1,"ま"]],"text":"「あなたの知られるとおり、父ダビデはその周囲にあった敵との戦いのゆえに、彼の神、主の名のために宮を建てることができず、主が彼らをその足の裏の下に置かれるのを待ちました。"},{"ref":"1Kgs.5.4","start":11005004,"end":11005004,"break":"none","ruby":[[4,1,"いま"],[7,1,"かみ"],[9,1,"しゅ"],[15,2,"しほう"],[18,2,"たいへい"],[21,1,"たま"],[26,1,"てき"],[31,1,"わざわい"]],"text":"ところが今わが神、主はわたしに四方の太平を賜わって、敵もなく、災もなくなったので、"},{"ref":"1Kgs.5.5","start":11005005,"end":11005005,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"ちち"],[12,1,"かわ"],[20,1,"くらい"],[35,1,"こ"],[39,1,"ひと"],[43,1,"な"],[48,1,"みや"],[50,1,"た"],[59,1,"い"],[69,1,"かみ"],[71,1,"しゅ"],[73,1,"な"],[78,1,"みや"],[80,1,"た"],[85,1,"おも"]],"text":"主が父ダビデに『おまえに代って、おまえの位に、わたしがつかせるおまえの子、その人がわが名のために宮を建てるであろう』と言われたように、わが神、主の名のために宮を建てようと思います。"},{"ref":"1Kgs.5.6","start":11005006,"end":11005006,"break":"none","ruby":[[9,2,"めいれい"],[12,1,"くだ"],[21,2,"こうはく"],[31,1,"き"],[33,1,"だ"],[62,2,"いっしょ"],[65,1,"はたら"],[103,2,"ちんぎん"],[110,1,"はら"],[119,1,"し"],[146,1,"き"],[148,1,"き"],[151,1,"たく"],[154,1,"ひと"]],"text":"それゆえ、あなたは命令を下して、レバノンの香柏をわたしのために切り出させてください。わたしのしもべたちをあなたのしもべたちと一緒に働かせます。またわたしはすべてあなたのおっしゃるとおり、あなたのしもべたちの賃銀をあなたに払います。あなたの知られるとおり、わたしたちのうちにはシドンびとのように木を切るに巧みな人がないからです」。"},{"ref":"1Kgs.5.7","start":11005007,"end":11005007,"break":"paragraph","ruby":[[9,2,"ことば"],[12,1,"き"],[15,1,"おお"],[18,1,"よろこ"],[26,1,"しゅ"],[36,1,"しゅ"],[46,1,"たみ"],[48,1,"おさ"],[51,1,"かしこ"],[53,1,"こ"],[59,1,"たま"],[65,1,"い"]],"text":"ヒラムはソロモンの言葉を聞いて大いに喜び、「きょう、主はあがむべきかな。主はこのおびただしい民を治める賢い子をダビデに賜わった」と言った。"},{"ref":"1Kgs.5.8","start":11005008,"end":11005008,"break":"none","ruby":[[12,1,"ひと"],[19,1,"い"],[32,1,"もう"],[42,1,"き"],[48,2,"こうはく"],[51,2,"ざいもく"],[60,2,"ざいもく"],[72,1,"のぞ"]],"text":"そしてヒラムはソロモンに人をつかわして言った、「わたしはあなたが申しおくられたことを聞きました。香柏の材木と、いとすぎの材木については、すべてお望みのようにいたします。"},{"ref":"1Kgs.5.9","start":11005009,"end":11005009,"break":"none","ruby":[[19,1,"うみ"],[21,1,"はこ"],[43,1,"く"],[47,2,"かいろ"],[54,2,"しじ"],[59,2,"ばしょ"],[63,1,"おく"],[87,1,"う"],[89,1,"と"],[108,1,"いえ"],[113,2,"しょくもつ"],[116,2,"きょうきゅう"],[125,1,"のぞ"]],"text":"わたしのしもべどもにそれをレバノンから海に運びおろさせましょう。わたしはそれをいかだに組んで、海路、あなたの指示される場所まで送り、そこでそれをくずしましょう。あなたはそれを受け取ってください。また、あなたはわたしの家のために食物を供給して、わたしの望みをかなえてください」。"},{"ref":"1Kgs.5.10","start":11005010,"end":11005010,"break":"none","ruby":[[16,1,"のぞ"],[22,2,"こうはく"],[25,2,"ざいもく"],[34,2,"ざいもく"],[37,1,"あた"]],"text":"こうしてヒラムはソロモンにすべて望みのように香柏の材木と、いとすぎの材木を与えた。"},{"ref":"1Kgs.5.11","start":11005011,"end":11005011,"break":"none","ruby":[[13,1,"いえ"],[15,2,"しょくもつ"],[20,2,"こむぎ"],[27,1,"あた"],[40,1,"と"],[43,1,"あぶら"],[49,1,"あた"],[63,2,"ねんねん"],[69,1,"あた"]],"text":"またソロモンはヒラムにその家の食物として小麦二万コルを与え、またオリブをつぶして取った油二万コルを与えた。このようにソロモンは年々ヒラムに与えた。"},{"ref":"1Kgs.5.12","start":11005012,"end":11005012,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"やくそく"],[15,2,"ちえ"],[18,1,"たま"],[34,1,"あいだ"],[36,2,"へいわ"],[43,1,"かれ"],[49,2,"じょうやく"],[52,1,"むす"]],"text":"主は約束されたようにソロモンに知恵を賜わった。またヒラムとソロモンの間は平和であって、彼らふたりは条約を結んだ。"},{"ref":"1Kgs.5.13","start":11005013,"end":11005013,"break":"paragraph","ruby":[[4,1,"おう"],[12,1,"ぜん"],[13,1,"ち"],[16,3,"きょうせいてき"],[20,3,"ろうどうしゃ"],[24,2,"ちょうぼ"],[31,2,"ちょうぼ"],[33,2,"じんいん"],[38,1,"にん"]],"text":"ソロモン王はイスラエルの全地から強制的に労働者を徴募した。その徴募人員は三万人であった。"},{"ref":"1Kgs.5.14","start":11005014,"end":11005014,"break":"none","ruby":[[5,1,"かれ"],[10,1,"げつ"],[11,2,"こうたい"],[16,1,"にん"],[36,1,"げつ"],[45,1,"げつ"],[46,1,"いえ"],[57,2,"ちょうぼ"],[60,2,"かんとく"]],"text":"ソロモンは彼らを一か月交代に一万人ずつレバノンにつかわした。すなわち一か月レバノンに、二か月家にあり、アドニラムは徴募の監督であった。"},{"ref":"1Kgs.5.15","start":11005015,"end":11005015,"break":"none","ruby":[[8,1,"に"],[10,1,"お"],[12,1,"もの"],[16,1,"にん"],[18,1,"やま"],[20,1,"いし"],[22,1,"き"],[24,1,"もの"],[28,1,"にん"]],"text":"ソロモンにはまた荷を負う者が七万人、山で石を切る者が八万人あった。"},{"ref":"1Kgs.5.16","start":11005016,"end":11005016,"break":"none","ruby":[[9,2,"こうじ"],[12,2,"かんとく"],[16,2,"うわやく"],[19,2,"かんり"],[26,1,"にん"],[31,2,"こうじ"],[34,1,"はたら"],[36,1,"たみ"],[38,2,"かんとく"]],"text":"ほかにソロモンには工事を監督する上役の官吏が三千三百人あって、工事に働く民を監督した。"},{"ref":"1Kgs.5.17","start":11005017,"end":11005017,"break":"none","ruby":[[0,1,"おう"],[2,1,"めい"],[5,1,"おお"],[8,2,"こうか"],[11,1,"いし"],[13,1,"き"],[15,1,"だ"],[19,1,"き"],[21,1,"いし"],[26,1,"みや"],[28,1,"もとい"]],"text":"王は命じて大きい高価な石を切り出させ、切り石をもって宮の基をすえさせた。"},{"ref":"1Kgs.5.18","start":11005018,"end":11005018,"break":"none","ruby":[[9,3,"けんちくしゃ"],[18,3,"けんちくしゃ"],[30,1,"いし"],[32,1,"き"],[35,2,"ざいもく"],[38,1,"いし"],[41,1,"みや"],[43,1,"た"],[49,1,"そな"]],"text":"こうしてソロモンの建築者と、ヒラムの建築者およびゲバルびとは石を切り、材木と石とを宮を建てるために備えた。"}]