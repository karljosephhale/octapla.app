[{"ref":"Heb.6.1","start":58006001,"end":58006001,"break":"paragraph","ruby":[[22,1,"おしえ"],[24,2,"しょほ"],[33,2,"かんせい"],[36,1,"め"],[40,1,"すすむ"],[49,1,"いま"],[53,1,"し"],[56,1,"おこな"],[59,2,"くいあらた"],[63,1,"かみ"],[66,2,"しんこう"]],"text":"そういうわけだから、わたしたちは、キリストの教の初歩をあとにして、完成を目ざして進もうではないか。今さら、死んだ行いの悔改めと神への信仰、"},{"ref":"Heb.6.2","start":58006002,"end":58006002,"break":"none","ruby":[[0,1,"あら"],[9,1,"おしえ"],[11,2,"あんしゅ"],[14,2,"しにん"],[17,2,"ふっかつ"],[20,2,"えいえん"],[30,2,"きほん"],[33,1,"おしえ"],[40,1,"まな"]],"text":"洗いごとについての教と按手、死人の復活と永遠のさばき、などの基本の教をくりかえし学ぶことをやめようではないか。"},{"ref":"Heb.6.3","start":58006003,"end":58006003,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ゆる"],[5,1,"え"]],"text":"神の許しを得て、そうすることにしよう。"},{"ref":"Heb.6.4","start":58006004,"end":58006004,"break":"none","ruby":[[5,1,"ひかり"],[7,1,"う"],[10,1,"てん"],[14,2,"たまもの"],[17,1,"あじ"],[21,2,"せいれい"],[28,1,"もの"]],"text":"いったん、光を受けて天よりの賜物を味わい、聖霊にあずかる者となり、"},{"ref":"Heb.6.5","start":58006005,"end":58006005,"break":"none","ruby":[[3,1,"かみ"],[5,1,"よ"],[8,2,"ことば"],[17,1,"よ"],[19,1,"ちから"],[22,1,"あじ"],[26,1,"もの"]],"text":"また、神の良きみ言葉と、きたるべき世の力とを味わった者たちが、"},{"ref":"Heb.6.6","start":58006006,"end":58006006,"break":"none","ruby":[[4,2,"だらく"],[8,2,"ばあい"],[17,1,"かみ"],[19,2,"みこ"],[23,1,"みずか"],[25,3,"じゅうじか"],[53,2,"くいあらた"],[59,1,"かえ"],[64,3,"ふかのう"]],"text":"そののち堕落した場合には、またもや神の御子を、自ら十字架につけて、さらしものにするわけであるから、ふたたび悔改めにたち帰ることは不可能である。"},{"ref":"Heb.6.7","start":58006007,"end":58006007,"break":"none","ruby":[[5,2,"とち"],[11,1,"うえ"],[17,1,"ふ"],[19,1,"あめ"],[21,1,"す"],[23,1,"こん"],[26,1,"たがや"],[28,2,"ひとびと"],[31,2,"やくだ"],[34,2,"さくもつ"],[37,1,"そだ"],[43,1,"かみ"],[45,2,"しゅくふく"]],"text":"たとえば、土地が、その上にたびたび降る雨を吸い込で、耕す人々に役立つ作物を育てるなら、神の祝福にあずかる。"},{"ref":"Heb.6.8","start":58006008,"end":58006008,"break":"none","ruby":[[23,2,"むよう"],[41,1,"や"]],"text":"しかし、いばらやあざみをはえさせるなら、それは無用になり、やがてのろわれ、ついには焼かれてしまう。"},{"ref":"Heb.6.9","start":58006009,"end":58006009,"break":"paragraph","ruby":[[4,1,"あい"],[7,1,"もの"],[15,1,"い"],[28,1,"すくい"],[34,1,"さら"],[36,1,"よ"],[55,2,"かくしん"]],"text":"しかし、愛する者たちよ。こうは言うものの、わたしたちは、救にかかわる更に良いことがあるのを、あなたがたについて確信している。"},{"ref":"Heb.6.10","start":58006010,"end":58006010,"break":"none","ruby":[[0,1,"かみ"],[2,2,"ふぎ"],[20,1,"はたら"],[33,2,"せいと"],[36,1,"つか"],[39,1,"いま"],[43,1,"つか"],[47,2,"みな"],[53,1,"しめ"],[59,1,"あい"],[63,1,"わす"]],"text":"神は不義なかたではないから、あなたがたの働きや、あなたがたがかつて聖徒に仕え、今もなお仕えて、御名のために示してくれた愛を、お忘れになることはない。"},{"ref":"Heb.6.11","start":58006011,"end":58006011,"break":"none","ruby":[[16,1,"のこ"],[20,2,"さいご"],[24,1,"のぞ"],[27,1,"も"],[38,1,"おな"],[40,2,"ねつい"],[43,1,"しめ"]],"text":"わたしたちは、あなたがたがひとり残らず、最後まで望みを持ちつづけるためにも、同じ熱意を示し、"},{"ref":"Heb.6.12","start":58006012,"end":58006012,"break":"none","ruby":[[0,1,"おこた"],[8,2,"しんこう"],[11,2,"にんたい"],[18,2,"やくそく"],[24,1,"う"],[26,1,"つ"],[28,2,"ひとびと"],[31,2,"みなら"],[34,1,"もの"],[43,1,"ねが"]],"text":"怠ることがなく、信仰と忍耐とをもって約束のものを受け継ぐ人々に見習う者となるように、と願ってやまない。"},{"ref":"Heb.6.13","start":58006013,"end":58006013,"break":"paragraph","ruby":[[3,1,"かみ"],[11,1,"たい"],[14,2,"やくそく"],[25,1,"ちか"],[31,2,"じぶん"],[36,1,"うえ"],[47,2,"じぶん"],[53,1,"ちか"]],"text":"さて、神がアブラハムに対して約束されたとき、さして誓うのに、ご自分よりも上のものがないので、ご自分をさして誓って、"},{"ref":"Heb.6.14","start":58006014,"end":58006014,"break":"none","ruby":[[6,1,"かなら"],[12,2,"しゅくふく"],[16,1,"かなら"],[22,2,"しそん"],[30,1,"い"]],"text":"「わたしは、必ずあなたを祝福し、必ずあなたの子孫をふやす」と言われた。"},{"ref":"Heb.6.15","start":58006015,"end":58006015,"break":"none","ruby":[[14,2,"にんたい"],[16,1,"づよ"],[18,1,"ま"],[24,2,"やくそく"],[30,1,"え"]],"text":"このようにして、アブラハムは忍耐強く待ったので、約束のものを得たのである。"},{"ref":"Heb.6.16","start":58006016,"end":58006016,"break":"none","ruby":[[5,2,"にんげん"],[8,2,"じぶん"],[12,1,"うえ"],[20,1,"ちか"],[33,1,"ちか"],[40,2,"はんたい"],[42,1,"ろん"],[44,1,"ふう"],[47,2,"ほしょう"]],"text":"いったい、人間は自分より上のものをさして誓うのであり、そして、その誓いはすべての反対論を封じる保証となるのである。"},{"ref":"Heb.6.17","start":58006017,"end":58006017,"break":"none","ruby":[[4,1,"かみ"],[7,2,"やくそく"],[13,1,"う"],[15,1,"つ"],[17,2,"ひとびと"],[22,2,"けいかく"],[25,2,"ふへん"],[42,1,"しめ"],[46,1,"おも"],[50,1,"ちか"],[56,2,"ほしょう"]],"text":"そこで、神は、約束のものを受け継ぐ人々に、ご計画の不変であることを、いっそうはっきり示そうと思われ、誓いによって保証されたのである。"},{"ref":"Heb.6.18","start":58006018,"end":58006018,"break":"none","ruby":[[4,1,"いつわ"],[11,1,"え"],[14,1,"かみ"],[16,1,"た"],[24,2,"ふへん"],[27,1,"こと"],[35,1,"まえ"],[43,1,"のぞ"],[46,1,"とら"],[53,1,"よ"],[68,2,"ちからづよ"],[71,1,"はげ"],[75,1,"う"]],"text":"それは、偽ることのあり得ない神に立てられた二つの不変の事がらによって、前におかれている望みを捕えようとして世をのがれてきたわたしたちが、力強い励ましを受けるためである。"},{"ref":"Heb.6.19","start":58006019,"end":58006019,"break":"none","ruby":[[2,1,"のぞ"],[25,2,"あんぜん"],[29,2,"ふどう"],[34,1,"いかり"],[42,1,"まく"],[44,1,"うち"],[50,1,"い"]],"text":"この望みは、わたしたちにとって、いわば、たましいを安全にし不動にする錨であり、かつ「幕の内」にはいり行かせるものである。"},{"ref":"Heb.6.20","start":58006020,"end":58006020,"break":"none","ruby":[[2,1,"まく"],[4,1,"うち"],[12,2,"えいえん"],[22,1,"ひと"],[25,3,"だいさいし"]],"text":"その幕の内に、イエスは、永遠にメルキゼデクに等しい大祭司として、わたしたちのためにさきがけとなって、はいられたのである。"}]