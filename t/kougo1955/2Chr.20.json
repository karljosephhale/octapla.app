[{"ref":"2Chr.20.1","start":14020001,"end":14020001,"break":"paragraph","ruby":[[2,1,"のち"],[31,1,"たたか"],[35,1,"せ"]],"text":"この後モアブびと、アンモンびとおよびメウニびとらがヨシャパテと戦おうと攻めてきた。"},{"ref":"2Chr.20.2","start":14020002,"end":14020002,"break":"none","ruby":[[2,1,"とき"],[5,1,"ひと"],[16,1,"つ"],[19,1,"い"],[24,1,"うみ"],[35,2,"たいぐん"],[42,1,"せ"],[45,1,"き"],[49,1,"み"],[52,1,"かれ"]],"text":"その時ある人がきて、ヨシャパテに告げて言った、「海のかなたのエドムから大軍があなたに攻めて来ます。見よ、彼らはハザゾン・タマル（すなわちエンゲデ）にいます」。"},{"ref":"2Chr.20.3","start":14020003,"end":14020003,"break":"none","ruby":[[9,1,"おそ"],[12,1,"しゅ"],[14,1,"かお"],[16,1,"む"],[19,1,"たす"],[22,1,"もと"],[27,2,"ぜんこく"],[30,2,"だんじき"]],"text":"そこでヨシャパテは恐れ、主に顔を向けて助けを求め、ユダ全国に断食をふれさせた。"},{"ref":"2Chr.20.4","start":14020004,"end":14020004,"break":"none","ruby":[[10,1,"あつ"],[14,1,"しゅ"],[16,1,"たす"],[19,1,"もと"],[34,1,"まち"],[37,2,"ひとびと"],[40,1,"き"],[42,1,"しゅ"],[44,1,"もと"]],"text":"それでユダはこぞって集まり、主の助けを求めた。すなわちユダのすべての町から人々が来て主を求めた。"},{"ref":"2Chr.20.5","start":14020005,"end":14020005,"break":"paragraph","ruby":[[9,1,"しゅ"],[11,1,"みや"],[13,1,"あたら"],[16,1,"にわ"],[18,1,"まえ"],[30,2,"かいしゅう"],[33,1,"なか"],[35,1,"た"]],"text":"そこでヨシャパテは主の宮の新しい庭の前で、ユダとエルサレムの会衆の中に立って、"},{"ref":"2Chr.20.6","start":14020006,"end":14020006,"break":"none","ruby":[[0,1,"い"],[10,2,"せんぞ"],[13,1,"かみ"],[15,1,"しゅ"],[22,1,"てん"],[27,1,"かみ"],[37,3,"いほうじん"],[45,1,"くに"],[47,1,"おさ"],[65,1,"て"],[68,1,"ちから"],[73,1,"いきお"],[84,1,"さか"],[89,1,"もの"]],"text":"言った、「われわれの先祖の神、主よ、あなたは天にいます神ではありませんか。異邦人のすべての国を治められるではありませんか。あなたの手には力があり、勢いがあって、あなたに逆らいうる者はありません。"},{"ref":"2Chr.20.7","start":14020007,"end":14020007,"break":"none","ruby":[[5,1,"かみ"],[14,1,"くに"],[16,1,"たみ"],[22,1,"たみ"],[29,1,"まえ"],[32,1,"お"],[34,1,"はら"],[42,1,"とも"],[49,2,"しそん"],[56,2,"えいえん"],[59,1,"あた"]],"text":"われわれの神よ、あなたはこの国の民をあなたの民イスラエルの前から追い払って、あなたの友アブラハムの子孫に、これを永遠に与えられたではありませんか。"},{"ref":"2Chr.20.8","start":14020008,"end":14020008,"break":"none","ruby":[[0,1,"かれ"],[6,1,"す"],[13,1,"な"],[21,2,"せいじょ"],[24,1,"た"],[27,1,"い"]],"text":"彼らはここに住み、あなたの名のためにここに聖所を建てて言いました、"},{"ref":"2Chr.20.9","start":14020009,"end":14020009,"break":"none","ruby":[[5,2,"しんぱん"],[8,2,"えきびょう"],[17,1,"わざわい"],[24,1,"のぞ"],[26,1,"とき"],[35,1,"みや"],[37,1,"まえ"],[39,1,"た"],[47,1,"まえ"],[54,1,"なや"],[57,1,"なか"],[63,1,"よ"],[78,1,"き"],[81,1,"たす"],[92,1,"な"],[96,1,"みや"]],"text":"『つるぎ、審判、疫病、ききんなどの災がわれわれに臨む時、われわれはこの宮の前に立って、あなたの前におり、その悩みの中であなたに呼ばわります。すると、あなたは聞いて助けられます。あなたの名はこの宮にあるからです』と。"},{"ref":"2Chr.20.10","start":14020010,"end":14020010,"break":"none","ruby":[[0,1,"いま"],[16,1,"やま"],[18,2,"ひとびと"],[28,1,"むかし"],[40,1,"くに"],[43,1,"で"],[47,1,"とき"],[59,1,"かれ"],[62,1,"おか"],[84,1,"かれ"],[87,1,"はな"],[91,1,"ほろ"]],"text":"今アンモン、モアブ、およびセイル山の人々をごらんなさい。昔イスラエルがエジプトの国から出てきた時、あなたはイスラエルに彼らを侵すことをゆるされなかったので、イスラエルは彼らを離れて、滅ぼしませんでした。"},{"ref":"2Chr.20.11","start":14020011,"end":14020011,"break":"none","ruby":[[0,1,"かれ"],[8,1,"むく"],[23,1,"かれ"],[26,1,"き"],[38,1,"たま"],[46,2,"りょうち"],[55,1,"お"],[57,1,"はら"]],"text":"彼らがわれわれに報いるところをごらんください。彼らは来て、あなたがわれわれに賜わったあなたの領地からわれわれを追い払おうとしています。"},{"ref":"2Chr.20.12","start":14020012,"end":14020012,"break":"none","ruby":[[5,1,"かみ"],[12,1,"かれ"],[36,1,"せ"],[39,1,"く"],[41,2,"たいぐん"],[44,1,"あた"],[46,1,"ちから"],[62,1,"し"],[75,1,"あお"],[77,1,"のぞ"]],"text":"われわれの神よ、あなたは彼らをさばかれないのですか。われわれはこのように攻めて来る大軍に当る力がなく、またいかになすべきかを知りません。ただ、あなたを仰ぎ望むのみです」。"},{"ref":"2Chr.20.13","start":14020013,"end":14020013,"break":"paragraph","ruby":[[3,2,"ひとびと"],[8,1,"おさ"],[10,1,"こ"],[14,1,"つま"],[19,2,"こども"],[24,1,"とも"],[26,1,"みな"],[27,1,"しゅ"],[29,1,"まえ"],[31,1,"た"]],"text":"ユダの人々はその幼な子、その妻、および子供たちと共に皆主の前に立っていた。"},{"ref":"2Chr.20.14","start":14020014,"end":14020014,"break":"none","ruby":[[2,1,"とき"],[3,1,"しゅ"],[5,1,"れい"],[7,2,"かいしゅう"],[10,1,"なか"],[16,2,"しそん"],[31,1,"のぞ"],[46,1,"こ"],[57,1,"こ"],[68,1,"こ"],[81,1,"こ"]],"text":"その時主の霊が会衆の中でアサフの子孫であるレビびとヤハジエルに臨んだ。ヤハジエルはゼカリヤの子、ゼカリヤはベナヤの子、ベナヤはエイエルの子、エイエルはマッタニヤの子である。"},{"ref":"2Chr.20.15","start":14020015,"end":14020015,"break":"none","ruby":[[6,1,"い"],[14,2,"ひとびと"],[23,2,"じゅうみん"],[34,1,"おう"],[37,1,"き"],[43,1,"しゅ"],[53,1,"おお"],[62,2,"たいぐん"],[68,1,"おそ"],[97,1,"たたか"],[104,1,"しゅ"],[106,1,"たたか"]],"text":"ヤハジエルは言った、「ユダの人々、エルサレムの住民、およびヨシャパテ王よ、聞きなさい。主はあなたがたにこう仰せられる、『この大軍のために恐れてはならない。おののいてはならない。これはあなたがたの戦いではなく、主の戦いだからである。"},{"ref":"2Chr.20.16","start":14020016,"end":14020016,"break":"none","ruby":[[3,1,"かれ"],[6,1,"ところ"],[8,1,"せ"],[10,1,"くだ"],[16,1,"み"],[19,1,"かれ"],[25,1,"さか"],[28,1,"のぼ"],[31,1,"く"],[45,1,"の"],[47,1,"ひがし"],[49,1,"たに"],[51,1,"たん"],[56,1,"あ"]],"text":"あす、彼らの所へ攻め下りなさい。見よ、彼らはヂヅの坂から上って来る。あなたがたはエルエルの野の東、谷の端でこれに会うであろう。"},{"ref":"2Chr.20.17","start":14020017,"end":14020017,"break":"none","ruby":[[2,1,"たたか"],[13,1,"たたか"],[16,1,"およ"],[39,1,"すす"],[41,1,"で"],[43,1,"た"],[52,1,"とも"],[58,1,"しゅ"],[60,2,"しょうり"],[63,1,"み"],[68,1,"おそ"],[91,1,"かれ"],[94,1,"ところ"],[96,1,"せ"],[99,1,"い"],[105,1,"しゅ"],[113,1,"とも"]],"text":"この戦いには、あなたがたは戦うに及ばない。ユダおよびエルサレムよ、あなたがたは進み出て立ち、あなたがたと共におられる主の勝利を見なさい。恐れてはならない。おののいてはならない。あす、彼らの所に攻めて行きなさい。主はあなたがたと共におられるからである』」。"},{"ref":"2Chr.20.18","start":14020018,"end":14020018,"break":"paragraph","ruby":[[6,1,"ち"],[10,1,"ふ"],[17,2,"ひとびと"],[28,1,"たみ"],[30,1,"しゅ"],[32,1,"まえ"],[34,1,"ふ"],[38,1,"しゅ"],[40,1,"はい"]],"text":"ヨシャパテは地にひれ伏した。ユダの人々およびエルサレムの民も主の前に伏して、主を拝した。"},{"ref":"2Chr.20.19","start":14020019,"end":14020019,"break":"none","ruby":[[2,1,"とき"],[9,2,"しそん"],[20,2,"しそん"],[30,1,"た"],[32,1,"あ"],[36,2,"おおごえ"],[48,1,"かみ"],[50,1,"しゅ"]],"text":"その時コハテびとの子孫、およびコラびとの子孫であるレビびとが立ち上がり、大声をあげてイスラエルの神、主をさんびした。"},{"ref":"2Chr.20.20","start":14020020,"end":14020020,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"あさ"],[4,1,"はや"],[6,1,"お"],[13,1,"の"],[15,1,"で"],[17,1,"い"],[23,1,"で"],[25,1,"い"],[36,1,"た"],[39,1,"い"],[47,2,"ひとびと"],[58,1,"たみ"],[65,1,"き"],[77,1,"かみ"],[79,1,"しゅ"],[81,1,"しん"],[98,1,"かた"],[100,1,"た"],[109,1,"しゅ"],[111,3,"よげんしゃ"],[115,1,"しん"],[132,2,"せいこう"]],"text":"彼らは朝早く起きてテコアの野に出て行った。その出て行くとき、ヨシャパテは立って言った、「ユダの人々およびエルサレムの民よ、わたしに聞きなさい。あなたがたの神、主を信じなさい。そうすればあなたがたは堅く立つことができる。主の預言者を信じなさい。そうすればあなたがたは成功するでしょう」。"},{"ref":"2Chr.20.21","start":14020021,"end":14020021,"break":"none","breaks":[[55,"stanza"],[63,"line"]],"ruby":[[0,1,"かれ"],[4,1,"たみ"],[6,2,"そうだん"],[10,2,"ひとびと"],[13,2,"にんめい"],[17,1,"せい"],[20,1,"かざ"],[23,1,"つ"],[26,2,"ぐんぜい"],[29,1,"まえ"],[31,1,"すす"],[35,1,"しゅ"],[37,1,"む"],[41,1,"うた"],[56,1,"しゅ"],[58,2,"かんしゃ"],[76,1,"た"],[86,1,"い"]],"text":"彼はまた民と相談して人々を任命し、聖なる飾りを着けて軍勢の前に進ませ、主に向かって歌をうたい、かつさんびさせ、「主に感謝せよ、そのいつくしみはとこしえに絶えることがない」と言わせた。"},{"ref":"2Chr.20.22","start":14020022,"end":14020022,"break":"none","ruby":[[3,1,"かれ"],[6,1,"うた"],[16,1,"はじ"],[19,1,"とき"],[21,1,"しゅ"],[23,2,"ふくへい"],[26,1,"もう"],[34,1,"せ"],[51,1,"やま"],[53,2,"ひとびと"],[56,1,"む"],[66,1,"かれ"],[69,1,"う"],[71,1,"やぶ"]],"text":"そして彼らが歌をうたい、さんびし始めた時、主は伏兵を設け、かのユダに攻めてきたアンモン、モアブ、セイル山の人々に向かわせられたので、彼らは打ち敗られた。"},{"ref":"2Chr.20.23","start":14020023,"end":14020023,"break":"none","ruby":[[13,2,"ひとびと"],[16,1,"た"],[18,1,"あ"],[26,1,"やま"],[28,1,"たみ"],[30,1,"てき"],[33,1,"かれ"],[36,1,"ころ"],[39,1,"まった"],[41,1,"ほろ"],[51,1,"たみ"],[53,1,"ころ"],[55,1,"つく"],[58,1,"およ"],[62,1,"かれ"],[69,1,"たがい"],[71,1,"たす"],[74,1,"ほろ"]],"text":"すなわちアンモンとモアブの人々は立ち上がって、セイル山の民に敵し、彼らを殺して全く滅ぼしたが、セイルの民を殺し尽すに及んで、彼らもおのおの互に助けて滅ぼしあった。"},{"ref":"2Chr.20.24","start":14020024,"end":14020024,"break":"paragraph","ruby":[[3,2,"ひとびと"],[6,1,"の"],[8,2,"ものみ"],[14,1,"い"],[20,2,"ぐんしゅう"],[23,1,"み"],[27,1,"ち"],[29,1,"たお"],[32,2,"したい"],[49,1,"もの"]],"text":"ユダの人々は野の物見やぐらへ行って、かの群衆を見たが、地に倒れた死体だけであって、ひとりものがれた者はなかった。"},{"ref":"2Chr.20.25","start":14020025,"end":14020025,"break":"none","ruby":[[11,1,"たみ"],[13,1,"かれ"],[16,1,"もの"],[18,1,"うば"],[23,1,"き"],[25,1,"み"],[29,2,"たすう"],[32,2,"かちく"],[35,2,"ざいほう"],[38,2,"いふく"],[43,2,"ほうせき"],[68,1,"と"],[73,1,"はこ"],[90,1,"と"],[94,1,"か"],[105,1,"もの"],[107,1,"おお"]],"text":"それでヨシャパテとその民は彼らの物を奪うために来て見ると、多数の家畜、財宝、衣服および宝石などおびただしくあったので、おのおのそれをはぎ取ったが、運びきれないほどたくさんで、かすめ取るに三日もかかった。それほど物が多かったのである。"},{"ref":"2Chr.20.26","start":14020026,"end":14020026,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[4,1,"かれ"],[11,1,"たに"],[13,1,"あつ"],[19,1,"ところ"],[21,1,"しゅ"],[23,2,"しゅくふく"],[33,1,"ところ"],[35,1,"な"],[37,2,"こんにち"],[45,1,"たに"],[47,1,"よ"]],"text":"四日目に彼らはベラカの谷に集まり、その所で主を祝福した。それでその所の名を今日までベラカの谷と呼んでいる。"},{"ref":"2Chr.20.27","start":14020027,"end":14020027,"break":"none","ruby":[[12,2,"ひとびと"],[15,1,"みな"],[22,1,"さき"],[24,1,"た"],[27,1,"よろこ"],[36,1,"かえ"],[42,1,"しゅ"],[44,1,"かれ"],[49,1,"てき"],[57,1,"よろこ"],[60,1,"あた"]],"text":"そしてユダとエルサレムの人々は皆ヨシャパテを先に立て、喜んでエルサレムに帰ってきた。主が彼らにその敵のことによって喜びを与えられたからである。"},{"ref":"2Chr.20.28","start":14020028,"end":14020028,"break":"none","ruby":[[4,1,"かれ"],[7,2,"たてごと"],[10,1,"こと"],[27,1,"しゅ"],[29,1,"みや"],[31,1,"き"]],"text":"すなわち彼らは立琴、琴およびラッパをもってエルサレムの主の宮に来た。"},{"ref":"2Chr.20.29","start":14020029,"end":14020029,"break":"none","ruby":[[8,1,"くに"],[10,1,"たみ"],[12,1,"しゅ"],[20,1,"てき"],[22,1,"たたか"],[29,1,"き"],[32,1,"かみ"],[34,1,"おそ"]],"text":"そしてもろもろの国の民は主がイスラエルの敵と戦われたことを聞いて神を恐れた。"},{"ref":"2Chr.20.30","start":14020030,"end":14020030,"break":"none","ruby":[[4,1,"かみ"],[6,2,"しほう"],[9,2,"あんそく"],[12,1,"たま"],[25,1,"くに"],[27,1,"おだ"]],"text":"こうして神が四方に安息を賜わったので、ヨシャパテの国は穏やかであった。"},{"ref":"2Chr.20.31","start":14020031,"end":14020031,"break":"paragraph","ruby":[[14,1,"おさ"],[18,1,"かれ"],[23,1,"さい"],[25,1,"とき"],[27,1,"おう"],[35,1,"ねん"],[37,1,"あいだ"],[44,1,"よ"],[46,1,"おさ"],[50,1,"かれ"],[52,1,"はは"],[54,1,"な"],[67,1,"むすめ"]],"text":"このようにヨシャパテはユダを治めた。彼は三十五歳の時、王となり、二十五年の間エルサレムで世を治めた。彼の母の名はアズバといってシルヒの娘である。"},{"ref":"2Chr.20.32","start":14020032,"end":14020032,"break":"none","ruby":[[6,1,"ちち"],[10,1,"みち"],[12,1,"あゆ"],[18,1,"はな"],[22,1,"しゅ"],[24,1,"め"],[26,1,"ただ"],[30,1,"み"],[37,1,"おこな"]],"text":"ヨシャパテは父アサの道を歩んでそれを離れず、主の目に正しいと見られることを行った。"},{"ref":"2Chr.20.33","start":14020033,"end":14020033,"break":"none","ruby":[[3,1,"たか"],[5,1,"ところ"],[7,1,"のぞ"],[13,1,"たみ"],[17,2,"せんぞ"],[20,1,"かみ"],[22,1,"こころ"],[24,1,"かたむ"]],"text":"しかし高き所は除かず、また民はその先祖の神に心を傾けなかった。"},{"ref":"2Chr.20.34","start":14020034,"end":14020034,"break":"paragraph","ruby":[[8,1,"た"],[10,2,"しじゅう"],[13,2,"こうい"],[21,1,"こ"],[26,1,"しょ"],[39,1,"れつ"],[40,1,"おう"],[42,1,"しょ"],[44,1,"の"]],"text":"ヨシャパテのその他の始終の行為は、ハナニの子エヒウの書にしるされ、イスラエルの列王の書に載せられてある。"},{"ref":"2Chr.20.35","start":14020035,"end":14020035,"break":"paragraph","ruby":[[2,1,"のち"],[6,1,"おう"],[19,1,"おう"],[25,1,"あい"],[26,1,"むす"],[35,1,"あく"],[37,1,"おこな"]],"text":"この後ユダの王ヨシャパテはイスラエルの王アハジヤと相結んだ。アハジヤは悪を行った。"},{"ref":"2Chr.20.36","start":14020036,"end":14020036,"break":"none","ruby":[[11,1,"い"],[13,1,"ふね"],[15,1,"つく"],[25,1,"あい"],[26,1,"むす"],[38,2,"いっしょ"],[41,1,"ふね"],[42,2,"すうせき"],[45,1,"つく"]],"text":"ヨシャパテはタルシシへ行く船を造るためにアハジヤと相結び、エジオン・ゲベルで一緒に船数隻を造った。"},{"ref":"2Chr.20.37","start":14020037,"end":14020037,"break":"none","ruby":[[2,1,"とき"],[12,1,"こ"],[25,1,"む"],[29,2,"よげん"],[43,1,"あい"],[44,1,"むす"],[50,1,"しゅ"],[56,1,"つく"],[59,1,"もの"],[69,1,"い"],[76,1,"ふね"],[78,2,"なんぱ"],[88,1,"い"]],"text":"その時マレシャのドダワの子エリエゼルはヨシャパテに向かって預言し、「あなたはアハジヤと相結んだので、主はあなたの造った物をこわされます」と言ったが、その船は難破して、タルシシへ行くことができなかった。"}]