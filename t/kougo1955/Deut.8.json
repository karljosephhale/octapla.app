[{"ref":"Deut.8.1","start":5008001,"end":5008001,"break":"paragraph","ruby":[[9,1,"めい"],[18,2,"めいれい"],[28,1,"まも"],[31,1,"おこな"],[53,1,"い"],[66,1,"ま"],[69,1,"しゅ"],[77,2,"せんぞ"],[80,1,"ちか"],[84,1,"ち"],[94,2,"じぶん"]],"text":"わたしが、きょう、命じるこのすべての命令を、あなたがたは守って行わなければならない。そうすればあなたがたは生きることができ、かつふえ増し、主があなたがたの先祖に誓われた地にはいって、それを自分のものとすることができるであろう。"},{"ref":"Deut.8.2","start":5008002,"end":5008002,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[12,1,"ねん"],[14,1,"あいだ"],[16,2,"あらの"],[23,1,"みちび"],[33,1,"みち"],[35,1,"おぼ"],[53,1,"くる"],[62,1,"こころ"],[69,1,"こころ"],[74,1,"し"],[83,2,"めいれい"],[86,1,"まも"],[94,1,"し"]],"text":"あなたの神、主がこの四十年の間、荒野であなたを導かれたそのすべての道を覚えなければならない。それはあなたを苦しめて、あなたを試み、あなたの心のうちを知り、あなたがその命令を守るか、どうかを知るためであった。"},{"ref":"Deut.8.3","start":5008003,"end":5008003,"break":"none","ruby":[[3,1,"しゅ"],[9,1,"くる"],[17,1,"う"],[26,1,"し"],[34,2,"せんぞ"],[39,1,"し"],[56,1,"やしな"],[61,1,"ひと"],[69,1,"い"],[73,1,"ひと"],[75,1,"しゅ"],[77,1,"くち"],[80,1,"で"],[93,1,"い"],[103,1,"し"]],"text":"それで主はあなたを苦しめ、あなたを飢えさせ、あなたも知らず、あなたの先祖たちも知らなかったマナをもって、あなたを養われた。人はパンだけでは生きず、人は主の口から出るすべてのことばによって生きることをあなたに知らせるためであった。"},{"ref":"Deut.8.4","start":5008004,"end":5008004,"break":"none","ruby":[[4,1,"ねん"],[6,1,"あいだ"],[12,2,"きもの"],[17,1,"き"],[25,1,"あし"]],"text":"この四十年の間、あなたの着物はすり切れず、あなたの足は、はれなかった。"},{"ref":"Deut.8.5","start":5008005,"end":5008005,"break":"none","ruby":[[6,1,"ひと"],[10,1,"こ"],[12,2,"くんれん"],[24,1,"かみ"],[26,1,"しゅ"],[32,2,"くんれん"],[40,1,"こころ"]],"text":"あなたはまた人がその子を訓練するように、あなたの神、主もあなたを訓練されることを心にとめなければならない。"},{"ref":"Deut.8.6","start":5008006,"end":5008006,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,2,"めいれい"],[11,1,"まも"],[16,1,"みち"],[18,1,"あゆ"],[22,1,"かれ"],[24,1,"おそ"]],"text":"あなたの神、主の命令を守り、その道に歩んで、彼を恐れなければならない。"},{"ref":"Deut.8.7","start":5008007,"end":5008007,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[15,1,"よ"],[17,1,"ち"],[19,1,"みちび"],[21,1,"い"],[35,1,"たに"],[38,1,"やま"],[43,1,"で"],[45,1,"みず"],[47,1,"なが"],[50,1,"いずみ"],[55,1,"ふち"],[59,1,"ち"]],"text":"それはあなたの神、主があなたを良い地に導き入れられるからである。そこは谷にも山にもわき出る水の流れ、泉、および淵のある地、"},{"ref":"Deut.8.8","start":5008008,"end":5008008,"break":"none","ruby":[[0,2,"こむぎ"],[3,2,"おおむぎ"],[14,1,"およ"],[22,1,"ち"],[24,1,"あぶら"],[30,1,"き"],[35,1,"みつ"],[39,1,"ち"]],"text":"小麦、大麦、ぶどう、いちじく及びざくろのある地、油のオリブの木、および蜜のある地、"},{"ref":"Deut.8.9","start":5008009,"end":5008009,"break":"none","ruby":[[4,1,"た"],[7,2,"しょくもつ"],[10,1,"か"],[21,1,"とぼ"],[29,1,"ち"],[36,1,"ち"],[38,1,"いし"],[40,1,"てつ"],[48,1,"やま"],[52,1,"どう"],[54,1,"ほ"],[56,1,"と"]],"text":"あなたが食べる食物に欠けることなく、なんの乏しいこともない地である。その地の石は鉄であって、その山からは銅を掘り取ることができる。"},{"ref":"Deut.8.10","start":5008010,"end":5008010,"break":"none","ruby":[[4,1,"た"],[7,1,"あ"],[14,1,"かみ"],[16,1,"しゅ"],[20,1,"よ"],[22,1,"ち"],[24,1,"たま"],[31,2,"かんしゃ"]],"text":"あなたは食べて飽き、あなたの神、主がその良い地を賜わったことを感謝するであろう。"},{"ref":"Deut.8.11","start":5008011,"end":5008011,"break":"paragraph","ruby":[[13,1,"めい"],[16,1,"しゅ"],[18,2,"めいれい"],[27,1,"さだ"],[31,1,"まも"],[39,1,"かみ"],[41,1,"しゅ"],[43,1,"わす"],[54,1,"つつし"]],"text":"あなたは、きょう、わたしが命じる主の命令と、おきてと、定めとを守らず、あなたの神、主を忘れることのないように慎まなければならない。"},{"ref":"Deut.8.12","start":5008012,"end":5008012,"break":"none","ruby":[[4,1,"た"],[7,1,"あ"],[10,1,"うるわ"],[13,1,"いえ"],[15,1,"た"],[18,1,"す"]],"text":"あなたは食べて飽き、麗しい家を建てて住み、"},{"ref":"Deut.8.13","start":5008013,"end":5008013,"break":"none","ruby":[[2,1,"うし"],[4,1,"ひつじ"],[9,2,"きんぎん"],[12,1,"ま"],[15,1,"も"],[17,1,"もの"],[21,1,"ま"],[23,1,"くわ"]],"text":"また牛や羊がふえ、金銀が増し、持ち物がみな増し加わるとき、"},{"ref":"Deut.8.14","start":5008014,"end":5008014,"break":"none","ruby":[[4,1,"こころ"],[15,1,"かみ"],[17,1,"しゅ"],[19,1,"わす"],[27,1,"しゅ"],[38,1,"ち"],[40,2,"どれい"],[43,1,"いえ"],[46,1,"みちび"],[48,1,"だ"]],"text":"おそらく心にたかぶり、あなたの神、主を忘れるであろう。主はあなたをエジプトの地、奴隷の家から導き出し、"},{"ref":"Deut.8.15","start":5008015,"end":5008015,"break":"none","ruby":[[4,1,"みちび"],[10,1,"おお"],[13,1,"おそ"],[17,2,"あらの"],[24,1,"ひ"],[37,1,"みず"],[46,1,"ち"],[48,1,"とお"],[58,1,"かた"],[60,1,"いわ"],[63,1,"みず"],[65,1,"だ"]],"text":"あなたを導いて、あの大きな恐ろしい荒野、すなわち火のへびや、さそりがいて、水のない、かわいた地を通り、あなたのために堅い岩から水を出し、"},{"ref":"Deut.8.16","start":5008016,"end":5008016,"break":"none","ruby":[[0,2,"せんぞ"],[5,1,"し"],[14,2,"あらの"],[21,1,"た"],[36,1,"くる"],[44,1,"こころ"]],"text":"先祖たちも知らなかったマナを荒野であなたに食べさせられた。それはあなたを苦しめ、あなたを試みて、ついにはあなたをさいわいにするためであった。"},{"ref":"Deut.8.17","start":5008017,"end":5008017,"break":"none","ruby":[[4,1,"こころ"],[10,2,"じぶん"],[13,1,"ちから"],[15,2,"じぶん"],[18,1,"て"],[20,1,"はたら"],[30,1,"とみ"],[32,1,"え"],[36,1,"い"]],"text":"あなたは心のうちに『自分の力と自分の手の働きで、わたしはこの富を得た』と言ってはならない。"},{"ref":"Deut.8.18","start":5008018,"end":5008018,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"おぼ"],[23,1,"しゅ"],[29,2,"せんぞ"],[34,1,"ちか"],[38,2,"けいやく"],[41,2,"こんにち"],[47,1,"おこな"],[57,1,"とみ"],[59,1,"え"],[61,1,"ちから"],[63,1,"あた"]],"text":"あなたはあなたの神、主を覚えなければならない。主はあなたの先祖たちに誓われた契約を今日のように行うために、あなたに富を得る力を与えられるからである。"},{"ref":"Deut.8.19","start":5008019,"end":5008019,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"わす"],[13,1,"た"],[15,2,"かみがみ"],[18,1,"したが"],[24,1,"つか"],[30,1,"おが"],[53,2,"けいこく"],[69,1,"ほろ"]],"text":"もしあなたの神、主を忘れて他の神々に従い、これに仕え、これを拝むならば、――わたしは、きょう、あなたがたに警告する。――あなたがたはきっと滅びるであろう。"},{"ref":"Deut.8.20","start":5008020,"end":5008020,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"まえ"],[11,1,"ほろ"],[14,1,"さ"],[18,2,"くにぐに"],[21,1,"たみ"],[33,1,"ほろ"],[47,1,"かみ"],[49,1,"しゅ"],[51,1,"こえ"],[53,1,"したが"]],"text":"主があなたがたの前から滅ぼし去られる国々の民のように、あなたがたも滅びるであろう。あなたがたの神、主の声に従わないからである。"}]