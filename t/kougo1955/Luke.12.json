[{"ref":"Luke.12.1","start":42012001,"end":42012001,"break":"paragraph","ruby":[[2,1,"あいだ"],[11,2,"ぐんしゅう"],[15,1,"たがい"],[17,1,"ふ"],[19,1,"あ"],[24,1,"むら"],[38,2,"でし"],[43,1,"かた"],[57,1,"びと"],[61,1,"だね"],[67,1,"かれ"],[70,2,"ぎぜん"],[73,1,"き"]],"text":"その間に、おびただしい群衆が、互に踏み合うほどに群がってきたが、イエスはまず弟子たちに語りはじめられた、「パリサイ人のパン種、すなわち彼らの偽善に気をつけなさい。"},{"ref":"Luke.12.2","start":42012002,"end":42012002,"break":"none","ruby":[[12,1,"あらわ"],[24,1,"かく"],[33,1,"し"]],"text":"おおいかぶされたもので、現れてこないものはなく、隠れているもので、知られてこないものはない。"},{"ref":"Luke.12.3","start":42012003,"end":42012003,"break":"none","ruby":[[10,1,"くら"],[14,1,"い"],[27,1,"あか"],[31,1,"き"],[35,2,"みっしつ"],[38,1,"みみ"],[49,2,"やね"],[52,1,"うえ"],[54,1,"い"]],"text":"だから、あなたがたが暗やみで言ったことは、なんでもみな明るみで聞かれ、密室で耳にささやいたことは、屋根の上で言いひろめられるであろう。"},{"ref":"Luke.12.4","start":42012004,"end":42012004,"break":"none","ruby":[[7,1,"とも"],[17,1,"い"],[25,1,"ころ"],[37,2,"いじょう"],[46,1,"もの"],[50,1,"おそ"]],"text":"そこでわたしの友であるあなたがたに言うが、からだを殺しても、そのあとでそれ以上なにもできない者どもを恐れるな。"},{"ref":"Luke.12.5","start":42012005,"end":42012005,"break":"none","ruby":[[0,1,"おそ"],[4,1,"もの"],[13,1,"おし"],[21,1,"ころ"],[28,1,"さら"],[30,2,"じごく"],[33,1,"な"],[35,1,"こ"],[37,2,"けんい"],[45,1,"おそ"],[61,1,"い"],[73,1,"おそ"]],"text":"恐るべき者がだれであるか、教えてあげよう。殺したあとで、更に地獄に投げ込む権威のあるかたを恐れなさい。そうだ、あなたがたに言っておくが、そのかたを恐れなさい。"},{"ref":"Luke.12.6","start":42012006,"end":42012006,"break":"none","ruby":[[1,1,"わ"],[14,1,"う"],[33,1,"わ"],[35,1,"かみ"],[41,1,"わす"]],"text":"五羽のすずめは二アサリオンで売られているではないか。しかも、その一羽も神のみまえで忘れられてはいない。"},{"ref":"Luke.12.7","start":42012007,"end":42012007,"break":"none","ruby":[[2,1,"うえ"],[10,1,"あたま"],[12,1,"け"],[19,1,"かぞ"],[27,1,"おそ"],[42,1,"おお"],[56,1,"もの"]],"text":"その上、あなたがたの頭の毛までも、みな数えられている。恐れることはない。あなたがたは多くのすずめよりも、まさった者である。"},{"ref":"Luke.12.8","start":42012008,"end":42012008,"break":"none","ruby":[[10,1,"い"],[17,1,"ひと"],[19,1,"まえ"],[25,1,"う"],[30,1,"もの"],[33,1,"ひと"],[35,1,"こ"],[37,1,"かみ"],[39,1,"つかい"],[43,1,"まえ"],[45,1,"う"]],"text":"そこで、あなたがたに言う。だれでも人の前でわたしを受けいれる者を、人の子も神の使たちの前で受けいれるであろう。"},{"ref":"Luke.12.9","start":42012009,"end":42012009,"break":"none","ruby":[[4,1,"ひと"],[6,1,"まえ"],[12,1,"こば"],[14,1,"もの"],[17,1,"かみ"],[19,1,"つかい"],[23,1,"まえ"],[25,1,"こば"]],"text":"しかし、人の前でわたしを拒む者は、神の使たちの前で拒まれるであろう。"},{"ref":"Luke.12.10","start":42012010,"end":42012010,"break":"none","ruby":[[3,1,"ひと"],[5,1,"こ"],[7,1,"い"],[9,1,"さか"],[12,1,"もの"],[25,2,"せいれい"],[31,1,"もの"]],"text":"また、人の子に言い逆らう者はゆるされるであろうが、聖霊をけがす者は、ゆるされることはない。"},{"ref":"Luke.12.11","start":42012011,"end":42012011,"break":"none","ruby":[[6,2,"かいどう"],[9,2,"やくにん"],[12,2,"こうかん"],[15,1,"まえ"],[23,1,"い"],[26,2,"ばあい"],[31,1,"なに"],[35,2,"べんめい"],[42,1,"なに"],[44,1,"い"],[49,2,"しんぱい"]],"text":"あなたがたが会堂や役人や高官の前へひっぱられて行った場合には、何をどう弁明しようか、何を言おうかと心配しないがよい。"},{"ref":"Luke.12.12","start":42012012,"end":42012012,"break":"none","ruby":[[0,1,"い"],[8,2,"せいれい"],[13,1,"とき"],[15,1,"おし"]],"text":"言うべきことは、聖霊がその時に教えてくださるからである」。"},{"ref":"Luke.12.13","start":42012013,"end":42012013,"break":"paragraph","ruby":[[0,2,"ぐんしゅう"],[3,1,"なか"],[13,1,"い"],[18,2,"せんせい"],[25,2,"きょうだい"],[29,2,"いさん"],[32,1,"わ"]],"text":"群衆の中のひとりがイエスに言った、「先生、わたしの兄弟に、遺産を分けてくれるようにおっしゃってください」。"},{"ref":"Luke.12.14","start":42012014,"end":42012014,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[8,1,"ひと"],[24,3,"さいばんにん"],[30,2,"ぶんぱい"],[32,1,"にん"],[34,1,"た"]],"text":"彼に言われた、「人よ、だれがわたしをあなたがたの裁判人または分配人に立てたのか」。"},{"ref":"Luke.12.15","start":42012015,"end":42012015,"break":"none","ruby":[[4,2,"ひとびと"],[11,1,"い"],[21,2,"どんよく"],[24,1,"たい"],[31,2,"けいかい"],[46,1,"もの"],[48,1,"も"],[55,1,"ひと"],[62,1,"も"],[64,1,"もの"]],"text":"それから人々にむかって言われた、「あらゆる貪欲に対してよくよく警戒しなさい。たといたくさんの物を持っていても、人のいのちは、持ち物にはよらないのである」。"},{"ref":"Luke.12.16","start":42012016,"end":42012016,"break":"none","ruby":[[6,1,"たとえ"],[8,1,"かた"],[16,2,"かねもち"],[19,1,"はたけ"],[21,2,"ほうさく"]],"text":"そこで一つの譬を語られた、「ある金持の畑が豊作であった。"},{"ref":"Luke.12.17","start":42012017,"end":42012017,"break":"none","ruby":[[3,1,"かれ"],[5,1,"こころ"],[7,1,"なか"],[22,2,"さくもつ"],[31,1,"ところ"],[40,1,"おも"]],"text":"そこで彼は心の中で、『どうしようか、わたしの作物をしまっておく所がないのだが』と思いめぐらして"},{"ref":"Luke.12.18","start":42012018,"end":42012018,"break":"none","ruby":[[0,1,"い"],[15,1,"くら"],[17,1,"と"],[26,1,"おお"],[31,1,"た"],[38,2,"こくもつ"],[41,2,"しょくりょう"],[44,2,"ぜんぶ"],[49,1,"こ"]],"text":"言った、『こうしよう。わたしの倉を取りこわし、もっと大きいのを建てて、そこに穀物や食糧を全部しまい込もう。"},{"ref":"Luke.12.19","start":42012019,"end":42012019,"break":"none","ruby":[[3,2,"じぶん"],[6,1,"たましい"],[8,1,"い"],[23,2,"ながねん"],[25,1,"ぶん"],[27,2,"しょくりょう"],[44,2,"あんしん"],[49,1,"く"],[52,1,"の"],[55,1,"たの"]],"text":"そして自分の魂に言おう。たましいよ、おまえには長年分の食糧がたくさんたくわえてある。さあ安心せよ、食え、飲め、楽しめ』。"},{"ref":"Luke.12.20","start":42012020,"end":42012020,"break":"none","ruby":[[3,1,"かみ"],[5,1,"かれ"],[7,1,"い"],[13,1,"おろ"],[16,1,"もの"],[23,1,"たましい"],[25,2,"こんや"],[32,1,"と"],[34,1,"さ"],[52,2,"ようい"],[56,1,"もの"]],"text":"すると神が彼に言われた、『愚かな者よ、あなたの魂は今夜のうちにも取り去られるであろう。そしたら、あなたが用意した物は、だれのものになるのか』。"},{"ref":"Luke.12.21","start":42012021,"end":42012021,"break":"none","ruby":[[0,2,"じぶん"],[6,1,"たから"],[8,1,"つ"],[11,1,"かみ"],[13,1,"たい"],[16,1,"と"],[20,1,"もの"],[26,1,"おな"]],"text":"自分のために宝を積んで神に対して富まない者は、これと同じである」。"},{"ref":"Luke.12.22","start":42012022,"end":42012022,"break":"paragraph","ruby":[[4,2,"でし"],[9,1,"い"],[27,1,"い"],[33,1,"なに"],[35,1,"た"],[42,1,"いのち"],[47,1,"おも"],[54,1,"なに"],[56,1,"き"],[68,1,"おも"]],"text":"それから弟子たちに言われた、「それだから、あなたがたに言っておく。何を食べようかと、命のことで思いわずらい、何を着ようかとからだのことで思いわずらうな。"},{"ref":"Luke.12.23","start":42012023,"end":42012023,"break":"none","ruby":[[0,1,"いのち"],[2,2,"しょくもつ"],[13,2,"きもの"]],"text":"命は食物にまさり、からだは着物にまさっている。"},{"ref":"Luke.12.24","start":42012024,"end":42012024,"break":"none","ruby":[[7,1,"かんが"],[10,1,"み"],[19,1,"か"],[30,2,"なや"],[35,1,"くら"],[46,1,"かみ"],[48,1,"かれ"],[51,1,"やしな"],[56,1,"くだ"],[66,1,"とり"]],"text":"からすのことを考えて見よ。まくことも、刈ることもせず、また、納屋もなく倉もない。それだのに、神は彼らを養っていて下さる。あなたがたは鳥よりも、はるかにすぐれているではないか。"},{"ref":"Luke.12.25","start":42012025,"end":42012025,"break":"none","ruby":[[12,1,"おも"],[24,2,"じぶん"],[27,2,"じゅみょう"],[35,1,"の"]],"text":"あなたがたのうち、だれが思いわずらったからとて、自分の寿命をわずかでも延ばすことができようか。"},{"ref":"Luke.12.26","start":42012026,"end":42012026,"break":"none","ruby":[[3,1,"ちい"],[6,1,"こと"],[26,1,"おも"]],"text":"そんな小さな事さえできないのに、どうしてほかのことを思いわずらうのか。"},{"ref":"Luke.12.27","start":42012027,"end":42012027,"break":"none","ruby":[[0,1,"の"],[2,1,"はな"],[7,1,"かんが"],[10,1,"み"],[16,1,"つむ"],[22,1,"お"],[39,1,"い"],[43,2,"えいが"],[50,1,"とき"],[62,1,"はな"],[70,2,"きかざ"]],"text":"野の花のことを考えて見るがよい。紡ぎもせず、織りもしない。しかし、あなたがたに言うが、栄華をきわめた時のソロモンでさえ、この花の一つほどにも着飾ってはいなかった。"},{"ref":"Luke.12.28","start":42012028,"end":42012028,"break":"none","ruby":[[4,1,"の"],[13,1,"ろ"],[15,1,"な"],[17,1,"い"],[22,1,"くさ"],[27,1,"かみ"],[34,1,"よそお"],[37,1,"くだ"],[53,2,"いじょう"],[76,2,"しんこう"],[79,1,"うす"],[81,1,"もの"]],"text":"きょうは野にあって、あすは炉に投げ入れられる草でさえ、神はこのように装って下さるのなら、あなたがたに、それ以上よくしてくださらないはずがあろうか。ああ、信仰の薄い者たちよ。"},{"ref":"Luke.12.29","start":42012029,"end":42012029,"break":"none","ruby":[[7,1,"なに"],[9,1,"た"],[12,1,"なに"],[14,1,"の"],[30,1,"き"],[32,1,"つか"]],"text":"あなたがたも、何を食べ、何を飲もうかと、あくせくするな、また気を使うな。"},{"ref":"Luke.12.30","start":42012030,"end":42012030,"break":"none","ruby":[[7,1,"みな"],[11,1,"よ"],[13,3,"いほうじん"],[17,1,"せつ"],[19,1,"もと"],[36,1,"ちち"],[52,2,"ひつよう"],[62,1,"ぞん"]],"text":"これらのものは皆、この世の異邦人が切に求めているものである。あなたがたの父は、これらのものがあなたがたに必要であることを、ご存じである。"},{"ref":"Luke.12.31","start":42012031,"end":42012031,"break":"none","ruby":[[3,2,"みくに"],[6,1,"もと"],[25,1,"そ"],[28,1,"あた"]],"text":"ただ、御国を求めなさい。そうすれば、これらのものは添えて与えられるであろう。"},{"ref":"Luke.12.32","start":42012032,"end":42012032,"break":"none","ruby":[[0,1,"おそ"],[5,1,"ちい"],[8,1,"む"],[12,2,"みくに"],[15,1,"くだ"],[28,1,"ちち"]],"text":"恐れるな、小さい群れよ。御国を下さることは、あなたがたの父のみこころなのである。"},{"ref":"Luke.12.33","start":42012033,"end":42012033,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"も"],[5,1,"もの"],[7,1,"う"],[11,1,"ほどこ"],[17,2,"じぶん"],[23,1,"ふる"],[31,2,"さいふ"],[38,2,"ぬすびと"],[41,2,"ちかよ"],[46,1,"むし"],[48,1,"く"],[50,1,"やぶ"],[54,1,"てん"],[57,1,"つ"],[65,1,"たから"]],"text":"自分の持ち物を売って、施しなさい。自分のために古びることのない財布をつくり、盗人も近寄らず、虫も食い破らない天に、尽きることのない宝をたくわえなさい。"},{"ref":"Luke.12.34","start":42012034,"end":42012034,"break":"none","ruby":[[6,1,"たから"],[10,1,"ところ"],[14,1,"こころ"]],"text":"あなたがたの宝のある所には、心もあるからである。"},{"ref":"Luke.12.35","start":42012035,"end":42012035,"break":"paragraph","ruby":[[0,1,"こし"],[2,1,"おび"]],"text":"腰に帯をしめ、あかりをともしていなさい。"},{"ref":"Luke.12.36","start":42012036,"end":42012036,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"こん"],[4,1,"えん"],[7,1,"かえ"],[12,1,"と"],[30,1,"ま"],[35,1,"ひと"]],"text":"主人が婚宴から帰ってきて戸をたたくとき、すぐあけてあげようと待っている人のようにしていなさい。"},{"ref":"Luke.12.37","start":42012037,"end":42012037,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"かえ"],[11,1,"め"],[13,1,"さま"],[20,1,"み"],[24,1,"しもべ"],[39,1,"い"],[45,2,"しゅじん"],[48,1,"おび"],[53,1,"しもべ"],[57,2,"しょくたく"],[64,1,"すす"],[66,1,"よ"],[69,2,"きゅうじ"]],"text":"主人が帰ってきたとき、目を覚しているのを見られる僕たちは、さいわいである。よく言っておく。主人が帯をしめて僕たちを食卓につかせ、進み寄って給仕をしてくれるであろう。"},{"ref":"Luke.12.38","start":42012038,"end":42012038,"break":"none","ruby":[[0,2,"しゅじん"],[3,2,"よなか"],[12,2,"よあ"],[18,1,"かえ"],[33,1,"み"],[42,1,"ひと"]],"text":"主人が夜中ごろ、あるいは夜明けごろに帰ってきても、そうしているのを見られるなら、その人たちはさいわいである。"},{"ref":"Luke.12.39","start":42012039,"end":42012039,"break":"none","ruby":[[17,1,"いえ"],[19,2,"しゅじん"],[23,2,"とうぞく"],[30,1,"く"],[42,2,"じぶん"],[45,1,"いえ"],[47,1,"お"],[49,1,"い"]],"text":"このことを、わきまえているがよい。家の主人は、盗賊がいつごろ来るかわかっているなら、自分の家に押し入らせはしないであろう。"},{"ref":"Luke.12.40","start":42012040,"end":42012040,"break":"none","ruby":[[6,2,"ようい"],[15,1,"おも"],[21,1,"とき"],[23,1,"ひと"],[25,1,"こ"],[27,1,"く"]],"text":"あなたがたも用意していなさい。思いがけない時に人の子が来るからである」。"},{"ref":"Luke.12.41","start":42012041,"end":42012041,"break":"paragraph","ruby":[[7,1,"い"],[12,1,"しゅ"],[17,1,"たとえ"],[19,1,"はな"],[51,1,"もの"]],"text":"するとペテロが言った、「主よ、この譬を話しておられるのはわたしたちのためなのですか。それとも、みんなの者のためなのですか」。"},{"ref":"Luke.12.42","start":42012042,"end":42012042,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"い"],[11,2,"しゅじん"],[15,2,"めしつかい"],[20,1,"うえ"],[22,1,"た"],[26,1,"とき"],[28,1,"おう"],[31,1,"さだ"],[34,2,"しょくじ"],[43,2,"ちゅうじつ"],[46,2,"しりょ"],[48,1,"ぶか"],[50,2,"かれい"]],"text":"そこで主が言われた、「主人が、召使たちの上に立てて、時に応じて定めの食事をそなえさせる忠実な思慮深い家令は、いったいだれであろう。"},{"ref":"Luke.12.43","start":42012043,"end":42012043,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"かえ"],[24,1,"み"],[28,1,"しもべ"]],"text":"主人が帰ってきたとき、そのようにつとめているのを見られる僕は、さいわいである。"},{"ref":"Luke.12.44","start":42012044,"end":42012044,"break":"none","ruby":[[2,1,"い"],[9,2,"しゅじん"],[14,1,"しもべ"],[16,1,"た"],[19,2,"じぶん"],[22,1,"ぜん"],[23,2,"ざいさん"],[26,2,"かんり"]],"text":"よく言っておくが、主人はその僕を立てて自分の全財産を管理させるであろう。"},{"ref":"Luke.12.45","start":42012045,"end":42012045,"break":"none","ruby":[[8,1,"しもべ"],[11,2,"しゅじん"],[14,1,"かえ"],[21,1,"こころ"],[23,1,"なか"],[25,1,"おも"],[28,2,"だんじょ"],[31,2,"めしつかい"],[36,1,"う"],[45,1,"た"],[50,1,"の"],[56,1,"よ"]],"text":"しかし、もしその僕が、主人の帰りがおそいと心の中で思い、男女の召使たちを打ちたたき、そして食べたり、飲んだりして酔いはじめるならば、"},{"ref":"Luke.12.46","start":42012046,"end":42012046,"break":"none","ruby":[[2,1,"しもべ"],[4,2,"しゅじん"],[7,1,"おも"],[13,1,"ひ"],[15,1,"き"],[21,1,"とき"],[23,1,"かえ"],[26,1,"く"],[37,1,"かれ"],[39,2,"げんばつ"],[42,1,"しょ"],[46,1,"ふ"],[47,2,"ちゅうじつ"],[55,1,"おな"],[57,1,"め"]],"text":"その僕の主人は思いがけない日、気がつかない時に帰って来るであろう。そして、彼を厳罰に処して、不忠実なものたちと同じ目にあわせるであろう。"},{"ref":"Luke.12.47","start":42012047,"end":42012047,"break":"none","ruby":[[0,2,"しゅじん"],[7,1,"し"],[18,1,"したが"],[21,2,"ようい"],[26,1,"つと"],[34,1,"しもべ"],[37,1,"おお"],[41,1,"う"]],"text":"主人のこころを知っていながら、それに従って用意もせず勤めもしなかった僕は、多くむち打たれるであろう。"},{"ref":"Luke.12.48","start":42012048,"end":42012048,"break":"none","ruby":[[4,1,"し"],[8,1,"う"],[20,1,"もの"],[23,1,"う"],[26,1,"ほう"],[28,1,"すく"],[35,1,"おお"],[37,1,"あた"],[42,1,"もの"],[46,1,"おお"],[48,1,"もと"],[53,1,"おお"],[55,1,"まか"],[60,1,"もの"],[64,1,"さら"],[66,1,"おお"],[68,2,"ようきゅう"]],"text":"しかし、知らずに打たれるようなことをした者は、打たれ方が少ないだろう。多く与えられた者からは多く求められ、多く任せられた者からは更に多く要求されるのである。"},{"ref":"Luke.12.49","start":42012049,"end":42012049,"break":"paragraph","ruby":[[5,1,"ひ"],[7,2,"ちじょう"],[10,1,"とう"],[21,1,"ひ"],[26,1,"も"],[43,1,"ねが"]],"text":"わたしは、火を地上に投じるためにきたのだ。火がすでに燃えていたならと、わたしはどんなに願っていることか。"},{"ref":"Luke.12.50","start":42012050,"end":42012050,"break":"none","ruby":[[9,1,"う"],[33,1,"う"],[52,1,"くる"],[55,1,"おも"]],"text":"しかし、わたしには受けねばならないバプテスマがある。そして、それを受けてしまうまでは、わたしはどんなにか苦しい思いをすることであろう。"},{"ref":"Luke.12.51","start":42012051,"end":42012051,"break":"none","ruby":[[11,2,"へいわ"],[16,2,"ちじょう"],[29,1,"おも"],[43,1,"い"],[59,2,"ぶんれつ"]],"text":"あなたがたは、わたしが平和をこの地上にもたらすためにきたと思っているのか。あなたがたに言っておく。そうではない。むしろ分裂である。"},{"ref":"Luke.12.52","start":42012052,"end":42012052,"break":"none","ruby":[[6,1,"いま"],[9,1,"のち"],[12,2,"いっか"],[15,1,"うち"],[18,1,"にん"],[20,1,"あい"],[21,1,"わか"],[26,1,"にん"],[38,1,"にん"],[40,2,"たいりつ"]],"text":"というのは、今から後は、一家の内で五人が相分れて、三人はふたりに、ふたりは三人に対立し、"},{"ref":"Luke.12.53","start":42012053,"end":42012053,"break":"none","ruby":[[2,1,"ちち"],[4,1,"こ"],[7,1,"こ"],[9,1,"ちち"],[12,1,"はは"],[14,1,"むすめ"],[17,1,"むすめ"],[19,1,"はは"],[28,1,"よめ"],[31,1,"よめ"],[40,2,"たいりつ"]],"text":"また父は子に、子は父に、母は娘に、娘は母に、しゅうとめは嫁に、嫁はしゅうとめに、対立するであろう」。"},{"ref":"Luke.12.54","start":42012054,"end":42012054,"break":"paragraph","ruby":[[6,2,"ぐんしゅう"],[9,1,"たい"],[13,1,"い"],[26,1,"くも"],[28,1,"にし"],[30,1,"おこ"],[34,1,"み"],[43,1,"あめ"],[48,1,"く"],[52,1,"い"],[55,1,"はた"]],"text":"イエスはまた群衆に対しても言われた、「あなたがたは、雲が西に起るのを見るとすぐ、にわか雨がやって来る、と言う。果してそのとおりになる。"},{"ref":"Luke.12.55","start":42012055,"end":42012055,"break":"none","ruby":[[4,2,"みなみかぜ"],[7,1,"ふ"],[11,1,"あ"],[21,1,"い"],[24,1,"はた"]],"text":"それから南風が吹くと、暑つくなるだろう、と言う。果してそのとおりになる。"},{"ref":"Luke.12.56","start":42012056,"end":42012056,"break":"none","ruby":[[0,3,"ぎぜんしゃ"],[11,2,"てんち"],[14,2,"もよう"],[17,2,"みわ"],[24,1,"し"],[34,1,"いま"],[36,2,"じだい"],[39,2,"みわ"]],"text":"偽善者よ、あなたがたは天地の模様を見分けることを知りながら、どうして今の時代を見分けることができないのか。"},{"ref":"Luke.12.57","start":42012057,"end":42012057,"break":"none","ruby":[[12,1,"ただ"],[18,2,"じぶん"],[21,2,"はんだん"]],"text":"また、あなたがたは、なぜ正しいことを自分で判断しないのか。"},{"ref":"Luke.12.58","start":42012058,"end":42012058,"break":"none","ruby":[[9,1,"うった"],[12,1,"ひと"],[14,2,"いっしょ"],[17,2,"やくにん"],[24,1,"い"],[31,2,"とちゅう"],[36,1,"ひと"],[38,2,"わかい"],[45,1,"つと"],[61,1,"ひと"],[67,3,"さいばんかん"],[80,1,"い"],[83,3,"さいばんかん"],[91,2,"ごくり"],[94,1,"ひ"],[96,1,"わた"],[99,2,"ごくり"],[106,1,"ごく"],[108,1,"な"],[110,1,"こ"]],"text":"たとえば、あなたを訴える人と一緒に役人のところへ行くときには、途中でその人と和解するように努めるがよい。そうしないと、その人はあなたを裁判官のところへひっぱって行き、裁判官はあなたを獄吏に引き渡し、獄吏はあなたを獄に投げ込むであろう。"},{"ref":"Luke.12.59","start":42012059,"end":42012059,"break":"none","ruby":[[4,1,"い"],[7,1,"お"],[10,2,"さいご"],[20,2,"しはら"],[31,1,"けっ"],[38,1,"で"],[40,1,"く"]],"text":"わたしは言って置く、最後の一レプタまでも支払ってしまうまでは、決してそこから出て来ることはできない」。"}]