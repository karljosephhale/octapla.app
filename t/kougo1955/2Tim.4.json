[{"ref":"2Tim.4.1","start":55004001,"end":55004001,"break":"paragraph","ruby":[[0,1,"かみ"],[7,1,"い"],[12,1,"もの"],[14,1,"し"],[17,1,"もの"],[44,2,"しゅつげん"],[49,2,"みくに"],[53,1,"おも"],[61,1,"めい"]],"text":"神のみまえと、生きている者と死んだ者とをさばくべきキリスト・イエスのみまえで、キリストの出現とその御国とを思い、おごそかに命じる。"},{"ref":"2Tim.4.2","start":55004002,"end":55004002,"break":"none","ruby":[[0,2,"みことば"],[3,1,"の"],[5,1,"つた"],[11,1,"とき"],[13,1,"よ"],[17,1,"わる"],[25,1,"はげ"],[33,2,"かんよう"],[36,1,"こころ"],[40,1,"おし"],[44,1,"せ"],[47,1,"いまし"],[50,1,"すす"]],"text":"御言を宣べ伝えなさい。時が良くても悪くても、それを励み、あくまでも寛容な心でよく教えて、責め、戒め、勧めなさい。"},{"ref":"2Tim.4.3","start":55004003,"end":55004003,"break":"none","ruby":[[0,2,"ひとびと"],[3,2,"けんぜん"],[6,1,"おしえ"],[8,1,"た"],[17,1,"みみ"],[24,1,"はなし"],[36,2,"じぶん"],[38,2,"かって"],[41,1,"この"],[48,2,"きょうし"],[53,1,"よ"],[55,1,"あつ"]],"text":"人々が健全な教に耐えられなくなり、耳ざわりのよい話をしてもらおうとして、自分勝手な好みにまかせて教師たちを寄せ集め、"},{"ref":"2Tim.4.4","start":55004004,"end":55004004,"break":"none","ruby":[[4,2,"しんり"],[9,1,"みみ"],[16,1,"つく"],[18,1,"ばなし"],[20,1,"ほう"],[27,1,"とき"],[29,1,"く"]],"text":"そして、真理からは耳をそむけて、作り話の方にそれていく時が来るであろう。"},{"ref":"2Tim.4.5","start":55004005,"end":55004005,"break":"none","ruby":[[9,2,"なにごと"],[13,1,"つつし"],[16,2,"くなん"],[19,1,"しの"],[22,3,"でんどうしゃ"],[32,2,"じぶん"],[35,1,"つとめ"],[37,1,"まっと"]],"text":"しかし、あなたは、何事にも慎み、苦難を忍び、伝道者のわざをなし、自分の務を全うしなさい。"},{"ref":"2Tim.4.6","start":55004006,"end":55004006,"break":"none","ruby":[[8,2,"じしん"],[11,2,"ぎせい"],[27,1,"よ"],[29,1,"さ"],[33,1,"とき"]],"text":"わたしは、すでに自身を犠牲としてささげている。わたしが世を去るべき時はきた。"},{"ref":"2Tim.4.7","start":55004007,"end":55004007,"break":"none","ruby":[[4,1,"たたか"],[11,1,"たたか"],[16,1,"はし"],[20,2,"こうてい"],[23,1,"はし"],[29,2,"しんこう"],[32,1,"まも"]],"text":"わたしは戦いをりっぱに戦いぬき、走るべき行程を走りつくし、信仰を守りとおした。"},{"ref":"2Tim.4.8","start":55004008,"end":55004008,"break":"none","ruby":[[0,1,"いま"],[3,1,"ぎ"],[5,1,"かんむり"],[11,1,"ま"],[25,1,"ひ"],[29,2,"こうへい"],[32,3,"しんぱんしゃ"],[38,1,"しゅ"],[44,1,"さづ"],[47,1,"くだ"],[66,1,"しゅ"],[68,2,"しゅつげん"],[71,1,"こころ"],[74,1,"ま"],[76,1,"のぞ"],[85,1,"ひと"],[88,1,"さづ"],[91,1,"くだ"]],"text":"今や、義の冠がわたしを待っているばかりである。かの日には、公平な審判者である主が、それを授けて下さるであろう。わたしばかりではなく、主の出現を心から待ち望んでいたすべての人にも授けて下さるであろう。"},{"ref":"2Tim.4.9","start":55004009,"end":55004009,"break":"paragraph","ruby":[[4,1,"ところ"],[7,1,"いそ"],[10,1,"はや"]],"text":"わたしの所に、急いで早くきてほしい。"},{"ref":"2Tim.4.10","start":55004010,"end":55004010,"break":"none","ruby":[[6,1,"よ"],[8,1,"あい"],[15,1,"す"],[24,1,"い"],[54,1,"い"]],"text":"デマスはこの世を愛し、わたしを捨ててテサロニケに行ってしまい、クレスケンスはガラテヤに、テトスはダルマテヤに行った。"},{"ref":"2Tim.4.11","start":55004011,"end":55004011,"break":"none","ruby":[[22,1,"つ"],[26,2,"いっしょ"],[34,1,"かれ"],[40,1,"つとめ"],[45,1,"やく"],[47,1,"た"]],"text":"ただルカだけが、わたしのもとにいる。マルコを連れて、一緒にきなさい。彼はわたしの務のために役に立つから。"},{"ref":"2Tim.4.12","start":55004012,"end":55004012,"break":"none","text":"わたしはテキコをエペソにつかわした。"},{"ref":"2Tim.4.13","start":55004013,"end":55004013,"break":"none","ruby":[[4,1,"く"],[19,1,"ところ"],[21,1,"のこ"],[27,2,"うわぎ"],[30,1,"も"],[41,2,"しょもつ"],[45,1,"とく"],[48,3,"ようひし"],[53,1,"も"]],"text":"あなたが来るときに、トロアスのカルポの所に残しておいた上着を持ってきてほしい。また書物も、特に、羊皮紙のを持ってきてもらいたい。"},{"ref":"2Tim.4.14","start":55004014,"end":55004014,"break":"none","ruby":[[0,4,"どうざいくにん"],[18,1,"おお"],[21,1,"くる"],[26,1,"しゅ"],[34,1,"たい"],[38,1,"かれ"],[40,1,"むく"]],"text":"銅細工人のアレキサンデルが、わたしを大いに苦しめた。主はそのしわざに対して、彼に報いなさるだろう。"},{"ref":"2Tim.4.15","start":55004015,"end":55004015,"break":"none","ruby":[[5,1,"かれ"],[7,2,"けいかい"],[14,1,"かれ"],[23,1,"い"],[28,1,"つよ"],[30,2,"はんたい"]],"text":"あなたも、彼を警戒しなさい。彼は、わたしたちの言うことに強く反対したのだから。"},{"ref":"2Tim.4.16","start":55004016,"end":55004016,"break":"none","ruby":[[4,1,"だい"],[6,1,"かい"],[8,2,"べんめい"],[11,1,"さい"],[19,2,"みかた"],[24,1,"もの"],[39,1,"す"],[42,1,"い"],[50,1,"かれ"],[59,1,"せ"]],"text":"わたしの第一回の弁明の際には、わたしに味方をする者はひとりもなく、みなわたしを捨てて行った。どうか、彼らが、そのために責められることがないように。"},{"ref":"2Tim.4.17","start":55004017,"end":55004017,"break":"none","ruby":[[8,2,"みことば"],[18,1,"の"],[20,1,"つた"],[28,3,"いほうじん"],[32,1,"き"],[40,1,"しゅ"],[46,1,"たす"],[49,1,"ちから"],[53,1,"くだ"],[70,1,"くち"],[73,1,"すく"],[75,1,"だ"]],"text":"しかし、わたしが御言を余すところなく宣べ伝えて、すべての異邦人に聞かせるように、主はわたしを助け、力づけて下さった。そして、わたしは、ししの口から救い出されたのである。"},{"ref":"2Tim.4.18","start":55004018,"end":55004018,"break":"none","ruby":[[0,1,"しゅ"],[11,1,"あく"],[17,1,"たす"],[19,1,"だ"],[22,1,"てん"],[26,2,"みくに"],[29,1,"すく"],[31,1,"い"],[34,1,"くだ"],[42,2,"えいこう"],[45,2,"えいえん"],[49,2,"えいえん"],[56,1,"しゅ"]],"text":"主はわたしを、すべての悪のわざから助け出し、天にある御国に救い入れて下さるであろう。栄光が永遠から永遠にわたって主にあるように、アァメン。"},{"ref":"2Tim.4.19","start":55004019,"end":55004019,"break":"paragraph","ruby":[[19,1,"いえ"],[26,1,"つた"]],"text":"プリスカとアクラとに、またオネシポロの家に、よろしく伝えてほしい。"},{"ref":"2Tim.4.20","start":55004020,"end":55004020,"break":"none","ruby":[[23,2,"びょうき"],[33,1,"のこ"]],"text":"エラストはコリントにとどまっており、トロピモは病気なので、ミレトに残してきた。"},{"ref":"2Tim.4.21","start":55004021,"end":55004021,"break":"none","ruby":[[0,1,"ふゆ"],[4,1,"まえ"],[7,1,"いそ"],[41,2,"きょうだい"]],"text":"冬になる前に、急いできてほしい。ユブロ、プデス、リノス、クラウデヤならびにすべての兄弟たちから、あなたによろしく。"},{"ref":"2Tim.4.22","start":55004022,"end":55004022,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"れい"],[9,1,"とも"],[18,1,"めぐ"],[28,1,"とも"]],"text":"主が、あなたの霊と共にいますように。恵みが、あなたがたと共にあるように。"}]