[{"ref":"Luke.21.1","start":42021001,"end":42021001,"break":"paragraph","ruby":[[4,1,"め"],[10,2,"かねもち"],[19,1,"はこ"],[21,2,"けんきん"],[24,1,"な"],[26,1,"い"],[31,1,"み"]],"text":"イエスは目をあげて、金持たちがさいせん箱に献金を投げ入れるのを見られ、"},{"ref":"Luke.21.2","start":42021002,"end":42021002,"break":"none","ruby":[[5,1,"まず"],[19,1,"い"],[24,1,"み"]],"text":"また、ある貧しいやもめが、レプタ二つを入れるのを見て"},{"ref":"Luke.21.3","start":42021003,"end":42021003,"break":"none","ruby":[[0,1,"い"],[8,1,"き"],[16,1,"まず"],[32,1,"い"]],"text":"言われた、「よく聞きなさい。あの貧しいやもめはだれよりもたくさん入れたのだ。"},{"ref":"Luke.21.4","start":42021004,"end":42021004,"break":"none","ruby":[[4,1,"ひと"],[16,1,"なか"],[19,2,"けんきん"],[22,1,"な"],[24,1,"い"],[31,2,"ふじん"],[37,1,"とぼ"],[40,1,"なか"],[44,1,"も"],[49,2,"せいかつ"],[51,1,"ひ"],[52,2,"ぜんぶ"],[55,1,"い"]],"text":"これらの人たちはみな、ありあまる中から献金を投げ入れたが、あの婦人は、その乏しい中から、持っている生活費全部を入れたからである」。"},{"ref":"Luke.21.5","start":42021005,"end":42021005,"break":"paragraph","ruby":[[2,2,"ひとびと"],[6,2,"みごと"],[9,1,"いし"],[11,3,"ほうのうぶつ"],[16,1,"みや"],[18,1,"かざ"],[27,1,"はな"],[39,1,"い"]],"text":"ある人々が、見事な石と奉納物とで宮が飾られていることを話していたので、イエスは言われた、"},{"ref":"Luke.21.6","start":42021006,"end":42021006,"break":"none","ruby":[[24,1,"いし"],[36,1,"た"],[38,1,"いし"],[40,1,"うえ"],[42,1,"のこ"],[51,1,"ひ"],[54,1,"く"]],"text":"「あなたがたはこれらのものをながめているが、その石一つでもくずされずに、他の石の上に残ることもなくなる日が、来るであろう」。"},{"ref":"Luke.21.7","start":42021007,"end":42021007,"break":"none","ruby":[[3,1,"かれ"],[12,2,"せんせい"],[26,1,"おこ"],[43,1,"おこ"],[48,2,"ばあい"],[56,2,"ぜんちょう"]],"text":"そこで彼らはたずねた、「先生、では、いつそんなことが起るのでしょうか。またそんなことが起るような場合には、どんな前兆がありますか」。"},{"ref":"Luke.21.8","start":42021008,"end":42021008,"break":"none","ruby":[[4,1,"い"],[17,1,"まど"],[26,1,"き"],[34,1,"おお"],[37,1,"もの"],[43,1,"な"],[45,1,"な"],[49,1,"あらわ"],[52,2,"じぶん"],[61,1,"とき"],[63,1,"ちか"],[70,1,"い"],[77,1,"かれ"],[83,1,"い"]],"text":"イエスが言われた、「あなたがたは、惑わされないように気をつけなさい。多くの者がわたしの名を名のって現れ、自分がそれだとか、時が近づいたとか、言うであろう。彼らについて行くな。"},{"ref":"Luke.21.9","start":42021009,"end":42021009,"break":"none","ruby":[[0,2,"せんそう"],[3,2,"そうらん"],[11,1,"き"],[20,1,"おそ"],[34,1,"おこ"],[44,1,"おわ"]],"text":"戦争と騒乱とのうわさを聞くときにも、おじ恐れるな。こうしたことはまず起らねばならないが、終りはすぐにはこない」。"},{"ref":"Luke.21.10","start":42021010,"end":42021010,"break":"paragraph","ruby":[[4,1,"かれ"],[7,1,"い"],[13,1,"たみ"],[15,1,"たみ"],[18,1,"くに"],[20,1,"くに"],[22,2,"てきたい"],[26,1,"た"],[28,1,"あ"]],"text":"それから彼らに言われた、「民は民に、国は国に敵対して立ち上がるであろう。"},{"ref":"Luke.21.11","start":42021011,"end":42021011,"break":"none","ruby":[[2,1,"だい"],[3,2,"じしん"],[14,2,"えきびょう"],[21,1,"おこ"],[28,1,"おそ"],[35,1,"てん"],[39,1,"もの"],[43,2,"ぜんちょう"]],"text":"また大地震があり、あちこちに疫病やききんが起り、いろいろ恐ろしいことや天からの物すごい前兆があるであろう。"},{"ref":"Luke.21.12","start":42021012,"end":42021012,"break":"none","ruby":[[12,3,"できごと"],[18,1,"まえ"],[21,2,"ひとびと"],[30,1,"て"],[35,2,"はくがい"],[40,2,"かいどう"],[43,1,"ごく"],[45,1,"ひ"],[47,1,"わた"],[54,1,"な"],[59,1,"おう"],[61,2,"そうとく"],[64,1,"まえ"],[71,1,"い"]],"text":"しかし、これらのあらゆる出来事のある前に、人々はあなたがたに手をかけて迫害をし、会堂や獄に引き渡し、わたしの名のゆえに王や総督の前にひっぱって行くであろう。"},{"ref":"Luke.21.13","start":42021013,"end":42021013,"break":"none","ruby":[[16,2,"きかい"]],"text":"それは、あなたがたがあかしをする機会となるであろう。"},{"ref":"Luke.21.14","start":42021014,"end":42021014,"break":"none","ruby":[[6,2,"とうべん"],[14,1,"まえ"],[18,1,"かんが"],[28,1,"こころ"],[30,1,"き"]],"text":"だから、どう答弁しようかと、前もって考えておかないことに心を決めなさい。"},{"ref":"Luke.21.15","start":42021015,"end":42021015,"break":"none","ruby":[[4,3,"はんたいしゃ"],[12,2,"こうべん"],[15,2,"ひてい"],[25,2,"ことば"],[28,2,"ちえ"],[37,1,"さづ"]],"text":"あなたの反対者のだれもが抗弁も否定もできないような言葉と知恵とを、わたしが授けるから。"},{"ref":"Luke.21.16","start":42021016,"end":42021016,"break":"none","ruby":[[10,2,"りょうしん"],[13,2,"きょうだい"],[16,2,"しんぞく"],[19,2,"ゆうじん"],[24,2,"うらぎ"],[43,1,"なか"],[45,1,"ころ"]],"text":"しかし、あなたがたは両親、兄弟、親族、友人にさえ裏切られるであろう。また、あなたがたの中で殺されるものもあろう。"},{"ref":"Luke.21.17","start":42021017,"end":42021017,"break":"none","ruby":[[7,1,"な"],[16,1,"ひと"],[18,1,"にく"]],"text":"また、わたしの名のゆえにすべての人に憎まれるであろう。"},{"ref":"Luke.21.18","start":42021018,"end":42021018,"break":"none","ruby":[[10,1,"かみ"],[12,1,"け"],[18,1,"うしな"]],"text":"しかし、あなたがたの髪の毛一すじでも失われることはない。"},{"ref":"Luke.21.19","start":42021019,"end":42021019,"break":"none","ruby":[[6,1,"た"],[8,1,"しの"],[17,2,"じぶん"],[20,1,"たましい"],[24,1,"と"]],"text":"あなたがたは耐え忍ぶことによって、自分の魂をかち取るであろう。"},{"ref":"Luke.21.20","start":42021020,"end":42021020,"break":"paragraph","ruby":[[6,2,"ぐんたい"],[9,2,"ほうい"],[16,1,"み"],[30,2,"めつぼう"],[33,1,"ちか"]],"text":"エルサレムが軍隊に包囲されるのを見たならば、そのときは、その滅亡が近づいたとさとりなさい。"},{"ref":"Luke.21.21","start":42021021,"end":42021021,"break":"none","ruby":[[11,2,"ひとびと"],[14,1,"やま"],[16,1,"に"],[20,2,"しちゅう"],[25,1,"もの"],[32,1,"で"],[34,1,"い"],[49,1,"もの"],[51,2,"しない"]],"text":"そのとき、ユダヤにいる人々は山へ逃げよ。市中にいる者は、そこから出て行くがよい。また、いなかにいる者は市内にはいってはいけない。"},{"ref":"Luke.21.22","start":42021022,"end":42021022,"break":"none","ruby":[[4,2,"せいしょ"],[16,1,"こと"],[18,2,"じつげん"],[22,2,"けいばつ"],[25,1,"ひ"]],"text":"それは、聖書にしるされたすべての事が実現する刑罰の日であるからだ。"},{"ref":"Luke.21.23","start":42021023,"end":42021023,"break":"none","ruby":[[2,1,"ひ"],[6,2,"みおも"],[9,1,"おんな"],[11,2,"ちの"],[14,1,"ご"],[18,1,"おんな"],[22,2,"ふこう"],[28,2,"ちじょう"],[32,1,"おお"],[35,2,"くなん"],[43,1,"たみ"],[47,1,"いか"],[50,1,"のぞ"]],"text":"その日には、身重の女と乳飲み子をもつ女とは、不幸である。地上には大きな苦難があり、この民にはみ怒りが臨み、"},{"ref":"Luke.21.24","start":42021024,"end":42021024,"break":"none","ruby":[[0,1,"かれ"],[7,1,"は"],[9,1,"たお"],[14,1,"とら"],[19,2,"しょこく"],[22,1,"ひ"],[43,3,"いほうじん"],[47,2,"じき"],[50,1,"み"],[56,1,"かれ"],[59,1,"ふ"]],"text":"彼らはつるぎの刃に倒れ、また捕えられて諸国へ引きゆかれるであろう。そしてエルサレムは、異邦人の時期が満ちるまで、彼らに踏みにじられているであろう。"},{"ref":"Luke.21.25","start":42021025,"end":42021025,"break":"none","ruby":[[2,1,"ひ"],[4,1,"つき"],[6,1,"ほし"],[14,1,"あらわ"],[26,2,"ちじょう"],[31,1,"しょ"],[32,2,"こくみん"],[35,1,"なや"],[38,1,"うみ"],[40,2,"おおなみ"],[51,1,"まど"]],"text":"また日と月と星とに、しるしが現れるであろう。そして、地上では、諸国民が悩み、海と大波とのとどろきにおじ惑い、"},{"ref":"Luke.21.26","start":42021026,"end":42021026,"break":"none","ruby":[[0,2,"ひとびと"],[3,2,"せかい"],[6,1,"おこ"],[12,1,"こと"],[14,1,"おも"],[17,2,"きょうふ"],[20,2,"ふあん"],[23,2,"きぜつ"],[37,2,"てんたい"],[40,1,"ゆ"],[42,1,"うご"]],"text":"人々は世界に起ろうとする事を思い、恐怖と不安で気絶するであろう。もろもろの天体が揺り動かされるからである。"},{"ref":"Luke.21.27","start":42021027,"end":42021027,"break":"none","ruby":[[5,1,"おお"],[9,1,"ちから"],[11,2,"えいこう"],[19,1,"ひと"],[21,1,"こ"],[23,1,"くも"],[25,1,"の"],[28,1,"く"],[33,2,"ひとびと"],[36,1,"み"]],"text":"そのとき、大いなる力と栄光とをもって、人の子が雲に乗って来るのを、人々は見るであろう。"},{"ref":"Luke.21.28","start":42021028,"end":42021028,"break":"none","ruby":[[4,1,"こと"],[6,1,"おこ"],[14,1,"み"],[16,1,"おこ"],[18,1,"あたま"],[33,1,"すくい"],[35,1,"ちか"]],"text":"これらの事が起りはじめたら、身を起し頭をもたげなさい。あなたがたの救が近づいているのだから」。"},{"ref":"Luke.21.29","start":42021029,"end":42021029,"break":"paragraph","ruby":[[7,1,"たとえ"],[9,1,"はな"],[20,1,"き"],[29,1,"き"],[31,1,"み"]],"text":"それから一つの譬を話された、「いちじくの木を、またすべての木を見なさい。"},{"ref":"Luke.21.30","start":42021030,"end":42021030,"break":"none","ruby":[[2,1,"め"],[4,1,"だ"],[17,1,"み"],[20,1,"なつ"],[25,1,"ちか"],[29,2,"じぶん"],[32,1,"き"]],"text":"はや芽を出せば、あなたがたはそれを見て、夏がすでに近いと、自分で気づくのである。"},{"ref":"Luke.21.31","start":42021031,"end":42021031,"break":"none","ruby":[[16,1,"こと"],[18,1,"おこ"],[22,1,"み"],[27,1,"かみ"],[29,1,"くに"],[31,1,"ちか"]],"text":"このようにあなたがたも、これらの事が起るのを見たなら、神の国が近いのだとさとりなさい。"},{"ref":"Luke.21.32","start":42021032,"end":42021032,"break":"none","ruby":[[2,1,"き"],[15,1,"こと"],[23,1,"おこ"],[31,2,"じだい"],[34,1,"ほろ"]],"text":"よく聞いておきなさい。これらの事が、ことごとく起るまでは、この時代は滅びることがない。"},{"ref":"Luke.21.33","start":42021033,"end":42021033,"break":"none","ruby":[[0,2,"てんち"],[3,1,"ほろ"],[18,2,"ことば"],[21,1,"けっ"],[24,1,"ほろ"]],"text":"天地は滅びるであろう。しかしわたしの言葉は決して滅びることがない。"},{"ref":"Luke.21.34","start":42021034,"end":42021034,"break":"paragraph","ruby":[[6,2,"ほうじゅう"],[10,2,"でいすい"],[14,1,"よ"],[16,1,"わずら"],[22,1,"こころ"],[24,1,"にぶ"],[33,1,"おも"],[44,1,"ひ"],[58,1,"とら"],[72,2,"ちゅうい"]],"text":"あなたがたが放縦や、泥酔や、世の煩いのために心が鈍っているうちに、思いがけないとき、その日がわなのようにあなたがたを捕えることがないように、よく注意していなさい。"},{"ref":"Luke.21.35","start":42021035,"end":42021035,"break":"none","ruby":[[2,1,"ひ"],[4,1,"ち"],[6,2,"ぜんめん"],[9,1,"す"],[15,1,"ひと"],[17,1,"のぞ"]],"text":"その日は地の全面に住むすべての人に臨むのであるから。"},{"ref":"Luke.21.36","start":42021036,"end":42021036,"break":"none","ruby":[[4,1,"おこ"],[16,1,"こと"],[24,1,"ひと"],[26,1,"こ"],[28,1,"まえ"],[30,1,"た"],[42,1,"た"],[45,1,"め"],[51,1,"いの"]],"text":"これらの起ろうとしているすべての事からのがれて、人の子の前に立つことができるように、絶えず目をさまして祈っていなさい」。"},{"ref":"Luke.21.37","start":42021037,"end":42021037,"break":"paragraph","ruby":[[4,1,"ひる"],[10,1,"みや"],[12,1,"おし"],[15,1,"よる"],[18,1,"で"],[20,1,"い"],[29,1,"やま"],[31,1,"よ"]],"text":"イエスは昼のあいだは宮で教え、夜には出て行ってオリブという山で夜をすごしておられた。"},{"ref":"Luke.21.38","start":42021038,"end":42021038,"break":"none","ruby":[[0,2,"みんしゅう"],[7,1,"おしえ"],[9,1,"き"],[19,1,"あさ"],[20,1,"はや"],[22,1,"みや"],[24,1,"い"],[34,1,"あつ"]],"text":"民衆はみな、み教を聞こうとして、いつも朝早く宮に行き、イエスのもとに集まった。"}]