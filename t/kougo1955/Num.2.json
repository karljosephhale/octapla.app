[{"ref":"Num.2.1","start":4002001,"end":4002001,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"い"]],"text":"主はモーセとアロンに言われた、"},{"ref":"Num.2.2","start":4002002,"end":4002002,"break":"none","ruby":[[7,2,"ひとびと"],[17,2,"ぶたい"],[20,1,"はた"],[28,2,"ふそ"],[31,1,"いえ"],[33,2,"はたじるし"],[41,2,"しゅくえい"],[55,2,"かいけん"],[58,2,"まくや"],[69,1,"む"],[73,2,"しゅくえい"]],"text":"「イスラエルの人々は、おのおのその部隊の旗のもとに、その父祖の家の旗印にしたがって宿営しなければならない。また会見の幕屋のまわりに、それに向かって宿営しなければならない。"},{"ref":"Num.2.3","start":4002003,"end":4002003,"break":"none","ruby":[[5,1,"ひ"],[7,1,"で"],[9,1,"ほう"],[11,1,"ひがし"],[13,2,"しゅくえい"],[24,2,"しゅくえい"],[27,1,"はた"],[31,1,"もの"],[39,2,"ぶたい"],[47,2,"しゅくえい"],[57,1,"こ"],[67,1,"こ"]],"text":"すなわち、日の出る方、東に宿営するものは、ユダの宿営の旗につく者であって、その部隊にしたがって宿営し、アミナダブの子ナションが、ユダの子たちのつかさとなるであろう。"},{"ref":"Num.2.4","start":4002004,"end":4002004,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その部隊、すなわち、数えられた者は七万四千六百人である。"},{"ref":"Num.2.5","start":4002005,"end":4002005,"break":"none","ruby":[[7,2,"しゅくえい"],[11,1,"もの"],[19,2,"ぶぞく"],[27,1,"こ"],[41,1,"こ"]],"text":"そのかたわらに宿営する者はイッサカルの部族で、ツアルの子ネタニエルが、イッサカルの子たちのつかさとなるであろう。"},{"ref":"Num.2.6","start":4002006,"end":4002006,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その部隊、すなわち、数えられた者は五万四千四百人である。"},{"ref":"Num.2.7","start":4002007,"end":4002007,"break":"none","ruby":[[0,1,"つぎ"],[7,2,"ぶぞく"],[15,1,"こ"],[27,1,"こ"]],"text":"次はゼブルンの部族で、ヘロンの子エリアブが、ゼブルンの子たちのつかさとなるであろう。"},{"ref":"Num.2.8","start":4002008,"end":4002008,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その部隊、すなわち、数えられた者は五万七千四百人である。"},{"ref":"Num.2.9","start":4002009,"end":4002009,"break":"none","ruby":[[3,2,"しゅくえい"],[9,2,"ぶたい"],[17,1,"かぞ"],[22,1,"もの"],[25,1,"あ"],[36,1,"にん"],[45,1,"もの"],[50,1,"さき"],[52,1,"すす"]],"text":"ユダの宿営の、その部隊にしたがって数えられた者は、合わせて十八万六千四百人である。これらの者は、まっ先に進まなければならない。"},{"ref":"Num.2.10","start":4002010,"end":4002010,"break":"paragraph","ruby":[[0,1,"みなみ"],[2,1,"ほう"],[10,2,"しゅくえい"],[13,1,"はた"],[17,1,"もの"],[22,2,"ぶたい"],[38,1,"こ"],[49,1,"こ"]],"text":"南の方では、ルベンの宿営の旗につく者が、その部隊にしたがっており、シデウルの子エリヅルが、ルベンの子たちのつかさとなるであろう。"},{"ref":"Num.2.11","start":4002011,"end":4002011,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その部隊、すなわち、数えられた者は四万六千五百人である。"},{"ref":"Num.2.12","start":4002012,"end":4002012,"break":"none","ruby":[[7,2,"しゅくえい"],[11,1,"もの"],[18,2,"ぶぞく"],[29,1,"こ"],[42,1,"こ"]],"text":"そのかたわらに宿営する者はシメオンの部族で、ツリシャダイの子シルミエルが、シメオンの子たちのつかさとなるであろう。"},{"ref":"Num.2.13","start":4002013,"end":4002013,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その部隊、すなわち、数えられた者は五万九千三百人である。"},{"ref":"Num.2.14","start":4002014,"end":4002014,"break":"none","ruby":[[0,1,"つぎ"],[5,2,"ぶぞく"],[14,1,"こ"],[25,1,"こ"]],"text":"次はガドの部族で、デウエルの子エリアサフが、ガドの子たちのつかさとなるであろう。"},{"ref":"Num.2.15","start":4002015,"end":4002015,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[25,1,"にん"]],"text":"その部隊、すなわち、数えられた者は四万五千六百五十人である。"},{"ref":"Num.2.16","start":4002016,"end":4002016,"break":"none","ruby":[[4,2,"しゅくえい"],[10,2,"ぶたい"],[18,1,"かぞ"],[23,1,"もの"],[26,1,"あ"],[39,1,"にん"],[48,1,"もの"],[51,2,"ばんめ"],[54,1,"すす"]],"text":"ルベンの宿営の、その部隊にしたがって数えられた者は、合わせて十五万一千四百五十人である。これらの者は二番目に進まなければならない。"},{"ref":"Num.2.17","start":4002017,"end":4002017,"break":"paragraph","ruby":[[2,1,"つぎ"],[4,2,"かいけん"],[7,2,"まくや"],[16,2,"しゅくえい"],[28,2,"しゅくえい"],[31,2,"ちゅうおう"],[36,1,"すす"],[47,1,"かれ"],[50,2,"しゅくえい"],[56,1,"おな"],[68,2,"いち"],[74,1,"はた"],[81,1,"すす"]],"text":"その次に会見の幕屋を、レビびとの宿営とともに、もろもろの宿営の中央にして進まなければならない。彼らは宿営するのと同じように、おのおのその位置で、その旗にしたがって進まなければならない。"},{"ref":"Num.2.18","start":4002018,"end":4002018,"break":"paragraph","ruby":[[0,1,"にし"],[2,1,"ほう"],[12,2,"しゅくえい"],[15,1,"はた"],[19,1,"もの"],[24,2,"ぶたい"],[40,1,"こ"],[54,1,"こ"]],"text":"西の方では、エフライムの宿営の旗につく者が、その部隊にしたがっており、アミホデの子エリシャマが、エフライムの子たちのつかさとなるであろう。"},{"ref":"Num.2.19","start":4002019,"end":4002019,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[21,1,"にん"]],"text":"その部隊、すなわち、数えられた者は四万五百人である。"},{"ref":"Num.2.20","start":4002020,"end":4002020,"break":"none","ruby":[[11,2,"ぶぞく"],[23,1,"こ"],[35,1,"こ"]],"text":"そのかたわらにマナセの部族がおって、パダヅルの子ガマリエルが、マナセの子たちのつかさとなるであろう。"},{"ref":"Num.2.21","start":4002021,"end":4002021,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その部隊、すなわち、数えられた者は三万二千二百人である。"},{"ref":"Num.2.22","start":4002022,"end":4002022,"break":"none","ruby":[[0,1,"つぎ"],[8,2,"ぶぞく"],[20,1,"こ"],[33,1,"こ"]],"text":"次にベニヤミンの部族がおって、ギデオニの子アビダンが、ベニヤミンの子たちのつかさとなるであろう。"},{"ref":"Num.2.23","start":4002023,"end":4002023,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その部隊、すなわち、数えられた者は三万五千四百人である。"},{"ref":"Num.2.24","start":4002024,"end":4002024,"break":"none","ruby":[[6,2,"しゅくえい"],[12,2,"ぶたい"],[20,1,"かぞ"],[25,1,"もの"],[28,1,"あ"],[37,1,"にん"],[46,1,"もの"],[49,2,"ばんめ"],[52,1,"すす"]],"text":"エフライムの宿営の、その部隊にしたがって数えられた者は、合わせて十万八千百人である。これらの者は三番目に進まなければならない。"},{"ref":"Num.2.25","start":4002025,"end":4002025,"break":"paragraph","ruby":[[0,1,"きた"],[2,1,"ほう"],[9,2,"しゅくえい"],[12,1,"はた"],[16,1,"もの"],[21,2,"ぶたい"],[39,1,"こ"],[50,1,"こ"]],"text":"北の方では、ダンの宿営の旗につく者が、その部隊にしたがっており、アミシャダイの子アヒエゼルが、ダンの子たちのつかさとなるであろう。"},{"ref":"Num.2.26","start":4002026,"end":4002026,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その部隊、すなわち、数えられた者は六万二千七百人である。"},{"ref":"Num.2.27","start":4002027,"end":4002027,"break":"none","ruby":[[7,2,"しゅくえい"],[11,1,"もの"],[18,2,"ぶぞく"],[30,1,"こ"],[41,1,"こ"]],"text":"そのかたわらに宿営する者は、アセルの部族であって、オクランの子パギエルが、アセルの子たちのつかさとなるであろう。"},{"ref":"Num.2.28","start":4002028,"end":4002028,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その部隊、すなわち、数えられた者は四万一千五百人である。"},{"ref":"Num.2.29","start":4002029,"end":4002029,"break":"none","ruby":[[0,1,"つぎ"],[7,2,"ぶぞく"],[18,1,"こ"],[29,1,"こ"]],"text":"次にナフタリの部族がおって、エナンの子アヒラが、ナフタリの子たちのつかさとなるであろう。"},{"ref":"Num.2.30","start":4002030,"end":4002030,"break":"none","ruby":[[2,2,"ぶたい"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その部隊、すなわち、数えられた者は五万三千四百人である。"},{"ref":"Num.2.31","start":4002031,"end":4002031,"break":"none","ruby":[[3,2,"しゅくえい"],[7,1,"かぞ"],[12,1,"もの"],[14,1,"あ"],[25,1,"にん"],[34,1,"もの"],[38,1,"はた"],[46,2,"さいご"],[49,1,"すす"]],"text":"ダンの宿営の、数えられた者は合わせて十五万七千六百人である。これらの者はその旗にしたがって、最後に進まなければならない」。"},{"ref":"Num.2.32","start":4002032,"end":4002032,"break":"paragraph","ruby":[[9,2,"ひとびと"],[15,2,"ふそ"],[18,1,"いえ"],[25,1,"かぞ"],[30,2,"ひとびと"],[41,2,"しゅくえい"],[47,2,"ぶたい"],[55,1,"かぞ"],[60,1,"もの"],[62,1,"あ"],[75,1,"にん"]],"text":"これがイスラエルの人々の、その父祖の家にしたがって数えられた人々である。もろもろの宿営の、その部隊にしたがって数えられた者は合わせて六十万三千五百五十人であった。"},{"ref":"Num.2.33","start":4002033,"end":4002033,"break":"none","ruby":[[15,2,"ひとびと"],[21,1,"かぞ"],[30,1,"しゅ"],[36,1,"めい"]],"text":"しかし、レビびとはイスラエルの人々のうちに数えられなかった。主がモーセに命じられたとおりである。"},{"ref":"Num.2.34","start":4002034,"end":4002034,"break":"paragraph","ruby":[[6,2,"ひとびと"],[13,1,"しゅ"],[19,1,"めい"],[28,1,"おこな"],[33,1,"はた"],[40,2,"しゅくえい"],[50,2,"しぞく"],[53,1,"したが"],[58,2,"ふそ"],[61,1,"いえ"],[63,1,"したが"],[66,1,"すす"]],"text":"イスラエルの人々は、すべて主がモーセに命じられたとおりに行い、その旗にしたがって宿営し、おのおのその氏族に従い、その父祖の家に従って進んだ。"}]