[{"ref":"Acts.21.1","start":44021001,"end":44021001,"break":"paragraph","ruby":[[9,2,"ひとびと"],[12,1,"わか"],[15,2,"ふなで"],[25,2,"ちょっこう"],[29,1,"つぎ"],[31,1,"ひ"],[46,1,"つ"]],"text":"さて、わたしたちは人々と別れて船出してから、コスに直航し、次の日はロドスに、そこからパタラに着いた。"},{"ref":"Acts.21.2","start":44021002,"end":44021002,"break":"none","ruby":[[6,1,"い"],[9,1,"ふね"],[11,1,"み"],[21,1,"の"],[23,1,"こ"],[26,2,"しゅっぱん"]],"text":"ここでピニケ行きの舟を見つけたので、それに乗り込んで出帆した。"},{"ref":"Acts.21.3","start":44021003,"end":44021003,"break":"none","ruby":[[7,1,"み"],[17,2,"ひだりて"],[22,1,"とお"],[31,2,"こうこう"],[41,2,"にゅうこう"],[49,2,"つみに"],[52,2,"りくあ"]],"text":"やがてクプロが見えてきたが、それを左手にして通りすぎ、シリヤへ航行をつづけ、ツロに入港した。ここで積荷が陸上げされることになっていたからである。"},{"ref":"Acts.21.4","start":44021004,"end":44021004,"break":"none","ruby":[[7,2,"でし"],[12,1,"さが"],[14,1,"だ"],[21,3,"なぬかかん"],[24,1,"と"],[33,1,"かれ"],[37,2,"みたま"],[40,1,"しめ"],[43,1,"う"],[54,1,"のぼ"],[57,1,"い"],[74,2,"ちゅうい"]],"text":"わたしたちは、弟子たちを捜し出して、そこに七日間泊まった。ところが彼らは、御霊の示しを受けて、エルサレムには上って行かないようにと、しきりにパウロに注意した。"},{"ref":"Acts.21.5","start":44021005,"end":44021005,"break":"none","ruby":[[4,2,"たいざい"],[6,2,"きかん"],[9,1,"おわ"],[12,1,"とき"],[22,2,"たびだ"],[37,1,"もの"],[40,1,"つま"],[42,2,"こども"],[45,1,"ひ"],[47,1,"つ"],[51,1,"まち"],[64,2,"みおく"],[78,1,"とも"],[80,2,"かいがん"],[89,1,"いの"]],"text":"しかし、滞在期間が終った時、わたしたちはまた旅立つことにしたので、みんなの者は、妻や子供を引き連れて、町はずれまで、わたしたちを見送りにきてくれた。そこで、共に海岸にひざまずいて祈り、"},{"ref":"Acts.21.6","start":44021006,"end":44021006,"break":"none","ruby":[[0,1,"たがい"],[2,1,"わか"],[5,1,"つ"],[20,1,"ふね"],[22,1,"の"],[24,1,"こ"],[27,1,"かれ"],[34,2,"じぶん"],[37,1,"いえ"],[39,1,"かえ"]],"text":"互に別れを告げた。それから、わたしたちは舟に乗り込み、彼らはそれぞれ自分の家に帰った。"},{"ref":"Acts.21.7","start":44021007,"end":44021007,"break":"paragraph","ruby":[[12,2,"こうこう"],[15,1,"おわ"],[23,1,"つ"],[29,2,"きょうだい"],[41,1,"かれ"],[49,1,"にち"],[50,2,"たいざい"]],"text":"わたしたちは、ツロからの航行を終ってトレマイに着き、そこの兄弟たちにあいさつをし、彼らのところに一日滞在した。"},{"ref":"Acts.21.8","start":44021008,"end":44021008,"break":"none","ruby":[[0,2,"よくじつ"],[15,1,"つ"],[21,1,"にん"],[29,3,"でんどうしゃ"],[36,1,"いえ"],[38,1,"い"],[44,1,"と"]],"text":"翌日そこをたって、カイザリヤに着き、かの七人のひとりである伝道者ピリポの家に行き、そこに泊まった。"},{"ref":"Acts.21.9","start":44021009,"end":44021009,"break":"none","ruby":[[2,1,"ひと"],[5,1,"にん"],[7,1,"むすめ"],[18,2,"しょじょ"],[25,2,"よげん"]],"text":"この人に四人の娘があったが、いずれも処女であって、預言をしていた。"},{"ref":"Acts.21.10","start":44021010,"end":44021010,"break":"none","ruby":[[0,2,"いくにち"],[3,2,"たいざい"],[9,1,"あいだ"],[18,3,"よげんしゃ"],[27,1,"くだ"]],"text":"幾日か滞在している間に、アガボという預言者がユダヤから下ってきた。"},{"ref":"Acts.21.11","start":44021011,"end":44021011,"break":"none","ruby":[[21,1,"おび"],[23,1,"と"],[29,2,"じぶん"],[32,2,"てあし"],[35,1,"しば"],[38,1,"い"],[43,2,"せいれい"],[49,1,"つ"],[61,1,"おび"],[63,1,"も"],[65,1,"ぬし"],[71,1,"じん"],[86,1,"しば"],[90,3,"いほうじん"],[94,1,"て"],[96,1,"わた"]],"text":"そして、わたしたちのところにきて、パウロの帯を取り、それで自分の手足を縛って言った、「聖霊がこうお告げになっている、『この帯の持ち主を、ユダヤ人たちがエルサレムでこのように縛って、異邦人の手に渡すであろう』」。"},{"ref":"Acts.21.12","start":44021012,"end":44021012,"break":"none","ruby":[[9,1,"き"],[13,2,"とち"],[16,1,"ひと"],[20,2,"いっしょ"],[34,1,"のぼ"],[37,1,"い"],[50,1,"ねが"],[52,1,"つづ"]],"text":"わたしたちはこれを聞いて、土地の人たちと一緒になって、エルサレムには上って行かないようにと、パウロに願い続けた。"},{"ref":"Acts.21.13","start":44021013,"end":44021013,"break":"none","ruby":[[2,1,"とき"],[7,1,"こた"],[19,1,"な"],[28,1,"こころ"],[59,1,"しゅ"],[64,1,"な"],[77,1,"しば"],[87,1,"し"],[93,2,"かくご"]],"text":"その時パウロは答えた、「あなたがたは、泣いたり、わたしの心をくじいたりして、いったい、どうしようとするのか。わたしは、主イエスの名のためなら、エルサレムで縛られるだけでなく、死ぬことをも覚悟しているのだ」。"},{"ref":"Acts.21.14","start":44021014,"end":44021014,"break":"none","ruby":[[9,2,"かんこく"],[12,1,"き"],[31,1,"しゅ"],[38,1,"おこな"],[48,1,"い"],[57,2,"いじょう"],[60,1,"なに"],[62,1,"い"]],"text":"こうして、パウロが勧告を聞きいれてくれないので、わたしたちは「主のみこころが行われますように」と言っただけで、それ以上、何も言わなかった。"},{"ref":"Acts.21.15","start":44021015,"end":44021015,"break":"paragraph","ruby":[[0,3,"すうじつご"],[10,2,"りょそう"],[13,1,"ととの"],[22,1,"のぼ"],[25,1,"い"]],"text":"数日後、わたしたちは旅装を整えてエルサレムへ上って行った。"},{"ref":"Acts.21.16","start":44021016,"end":44021016,"break":"none","ruby":[[6,2,"でし"],[11,2,"すうにん"],[20,2,"どうこう"],[25,1,"ふる"],[30,2,"でし"],[38,1,"びと"],[44,1,"いえ"],[46,2,"あんない"],[62,1,"いえ"],[64,1,"と"]],"text":"カイザリヤの弟子たちも数人、わたしたちと同行して、古くからの弟子であるクプロ人マナソンの家に案内してくれた。わたしたちはその家に泊まることになっていたのである。"},{"ref":"Acts.21.17","start":44021017,"end":44021017,"break":"paragraph","ruby":[[12,2,"とうちゃく"],[18,2,"きょうだい"],[23,1,"よろこ"],[26,1,"むか"]],"text":"わたしたちがエルサレムに到着すると、兄弟たちは喜んで迎えてくれた。"},{"ref":"Acts.21.18","start":44021018,"end":44021018,"break":"none","ruby":[[0,2,"よくじつ"],[12,1,"つ"],[20,2,"ほうもん"],[24,1,"い"],[31,2,"ちょうろう"],[38,1,"あつ"]],"text":"翌日パウロはわたしたちを連れて、ヤコブを訪問しに行った。そこに長老たちがみな集まっていた。"},{"ref":"Acts.21.19","start":44021019,"end":44021019,"break":"none","ruby":[[4,1,"かれ"],[14,1,"のち"],[16,1,"かみ"],[18,2,"じぶん"],[21,1,"はたら"],[29,3,"いほうじん"],[33,1,"あいだ"],[39,1,"こと"],[43,2,"いちいち"],[45,2,"せつめい"]],"text":"パウロは彼らにあいさつをした後、神が自分の働きをとおして、異邦人の間になさった事どもを一々説明した。"},{"ref":"Acts.21.20","start":44021020,"end":44021020,"break":"none","ruby":[[0,2,"いちどう"],[6,1,"き"],[9,1,"かみ"],[20,1,"かれ"],[22,1,"い"],[27,2,"きょうだい"],[32,2,"しょうち"],[42,1,"じん"],[44,1,"なか"],[46,2,"しんじゃ"],[52,1,"もの"],[55,2,"すうまん"],[70,2,"りっぽう"],[73,2,"ねっしん"],[76,1,"ひと"]],"text":"一同はこれを聞いて神をほめたたえ、そして彼に言った、「兄弟よ、ご承知のように、ユダヤ人の中で信者になった者が、数万にものぼっているが、みんな律法に熱心な人たちである。"},{"ref":"Acts.21.21","start":44021021,"end":44021021,"break":"none","ruby":[[5,1,"かれ"],[8,1,"つた"],[10,1,"き"],[27,3,"いほうじん"],[31,1,"なか"],[38,1,"じん"],[39,2,"いちどう"],[42,1,"たい"],[46,2,"こども"],[49,2,"かつれい"],[52,1,"ほどこ"],[62,2,"かんれい"],[71,1,"い"],[85,1,"おし"]],"text":"ところが、彼らが伝え聞いているところによれば、あなたは異邦人の中にいるユダヤ人一同に対して、子供に割礼を施すな、またユダヤの慣例にしたがうなと言って、モーセにそむくことを教えている、ということである。"},{"ref":"Acts.21.22","start":44021022,"end":44021022,"break":"none","ruby":[[24,1,"かれ"],[30,1,"き"],[32,1,"こ"],[35,1,"ちが"]],"text":"どうしたらよいか。あなたがここにきていることは、彼らもきっと聞き込むに違いない。"},{"ref":"Acts.21.23","start":44021023,"end":44021023,"break":"none","ruby":[[5,1,"いま"],[12,1,"い"],[32,1,"なか"],[35,2,"せいがん"],[38,1,"た"],[43,1,"もの"],[46,1,"にん"]],"text":"ついては、今わたしたちが言うとおりのことをしなさい。わたしたちの中に、誓願を立てている者が四人いる。"},{"ref":"Acts.21.24","start":44021024,"end":44021024,"break":"none","ruby":[[2,1,"ひと"],[6,1,"つ"],[9,1,"い"],[13,1,"かれ"],[16,1,"とも"],[22,1,"おこな"],[27,1,"かれ"],[30,1,"あたま"],[34,2,"ひよう"],[37,1,"ひ"],[39,1,"う"],[74,1,"ね"],[76,1,"は"],[88,2,"りっぽう"],[91,1,"まも"],[95,1,"ただ"],[98,2,"せいかつ"]],"text":"この人たちを連れて行って、彼らと共にきよめを行い、また彼らの頭をそる費用を引き受けてやりなさい。そうすれば、あなたについて、うわさされていることは、根も葉もないことで、あなたは律法を守って、正しい生活をしていることが、みんなにわかるであろう。"},{"ref":"Acts.21.25","start":44021025,"end":44021025,"break":"none","ruby":[[0,3,"いほうじん"],[4,2,"しんじゃ"],[10,1,"ひと"],[19,2,"てがみ"],[23,2,"ぐうぞう"],[26,1,"そな"],[33,1,"ち"],[36,1,"し"],[38,1,"ころ"],[45,3,"ふひんこう"],[51,1,"つつし"],[58,2,"けつぎ"],[69,1,"し"]],"text":"異邦人で信者になった人たちには、すでに手紙で、偶像に供えたものと、血と、絞め殺したものと、不品行とを、慎むようにとの決議が、わたしたちから知らせてある」。"},{"ref":"Acts.21.26","start":44021026,"end":44021026,"break":"none","ruby":[[10,1,"つぎ"],[12,1,"ひ"],[15,1,"にん"],[17,1,"もの"],[19,1,"つ"],[23,1,"かれ"],[26,1,"とも"],[32,1,"う"],[37,1,"みや"],[51,2,"きかん"],[54,1,"おわ"],[68,1,"そな"],[70,1,"もの"],[76,1,"とき"],[78,2,"ほうこく"]],"text":"そこでパウロは、その次の日に四人の者を連れて、彼らと共にきよめを受けてから宮にはいった。そしてきよめの期間が終って、ひとりびとりのために供え物をささげる時を報告しておいた。"},{"ref":"Acts.21.27","start":44021027,"end":44021027,"break":"paragraph","ruby":[[0,2,"なぬか"],[3,2,"きかん"],[6,1,"おわ"],[14,1,"とき"],[26,1,"じん"],[31,1,"みや"],[33,1,"うち"],[39,1,"み"],[44,2,"ぐんしゅう"],[46,2,"ぜんたい"],[49,2,"せんどう"],[60,1,"て"],[65,1,"さけ"],[67,1,"た"]],"text":"七日の期間が終ろうとしていた時、アジヤからきたユダヤ人たちが、宮の内でパウロを見かけて、群衆全体を煽動しはじめ、パウロに手をかけて叫び立てた、"},{"ref":"Acts.21.28","start":44021028,"end":44021028,"break":"none","ruby":[[7,2,"ひとびと"],[11,2,"かせい"],[21,1,"ひと"],[31,1,"たみ"],[33,2,"りっぽう"],[38,2,"ばしょ"],[52,1,"おし"],[60,1,"うえ"],[67,1,"じん"],[69,1,"みや"],[71,1,"うち"],[73,1,"つ"],[75,1,"こ"],[81,2,"しんせい"],[84,2,"ばしょ"],[87,1,"けが"]],"text":"「イスラエルの人々よ、加勢にきてくれ。この人は、いたるところで民と律法とこの場所にそむくことを、みんなに教えている。その上に、ギリシヤ人を宮の内に連れ込んで、この神聖な場所を汚したのだ」。"},{"ref":"Acts.21.29","start":44021029,"end":44021029,"break":"none","ruby":[[0,1,"かれ"],[4,1,"まえ"],[9,1,"びと"],[20,2,"いっしょ"],[23,1,"まち"],[25,1,"ある"],[32,1,"み"],[39,1,"ひと"],[45,1,"みや"],[47,1,"うち"],[49,1,"つ"],[51,1,"こ"],[57,1,"おも"]],"text":"彼らは、前にエペソ人トロピモが、パウロと一緒に町を歩いていたのを見かけて、その人をパウロが宮の内に連れ込んだのだと思ったのである。"},{"ref":"Acts.21.30","start":44021030,"end":44021030,"break":"none","ruby":[[4,1,"し"],[5,2,"ぜんたい"],[8,1,"さわ"],[10,1,"だ"],[13,2,"みんしゅう"],[16,1,"か"],[18,1,"あつ"],[29,1,"とら"],[32,1,"みや"],[34,1,"そと"],[36,1,"ひ"],[40,1,"だ"],[55,1,"みや"],[57,1,"もん"],[59,1,"と"]],"text":"そこで、市全体が騒ぎ出し、民衆が駆け集まってきて、パウロを捕え、宮の外に引きずり出した。そして、すぐそのあとに宮の門が閉ざされた。"},{"ref":"Acts.21.31","start":44021031,"end":44021031,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ころ"],[15,1,"とき"],[23,2,"ぜんたい"],[26,2,"こんらん"],[28,2,"じょうたい"],[31,1,"おちい"],[38,2,"じょうほう"],[42,2,"しゅび"],[44,1,"たい"],[46,3,"せんそつちょう"]],"text":"彼らがパウロを殺そうとしていた時に、エルサレム全体が混乱状態に陥っているとの情報が、守備隊の千卒長にとどいた。"},{"ref":"Acts.21.32","start":44021032,"end":44021032,"break":"none","ruby":[[4,1,"かれ"],[11,2,"へいそつ"],[14,3,"ひゃくそつちょう"],[20,1,"ひき"],[26,1,"ば"],[28,1,"か"],[34,2,"ひとびと"],[37,3,"せんそつちょう"],[41,2,"へいそつ"],[46,1,"み"],[53,1,"う"]],"text":"そこで、彼はさっそく、兵卒や百卒長たちを率いて、その場に駆けつけた。人々は千卒長や兵卒たちを見て、パウロを打ちたたくのをやめた。"},{"ref":"Acts.21.33","start":44021033,"end":44021033,"break":"none","ruby":[[0,3,"せんそつちょう"],[4,2,"ちかよ"],[14,1,"とら"],[17,1,"かれ"],[19,2,"にじゅう"],[22,1,"くさり"],[24,1,"しば"],[32,1,"めい"],[35,1,"うえ"],[41,2,"なにもの"],[47,1,"なに"],[55,1,"たず"]],"text":"千卒長は近寄ってきてパウロを捕え、彼を二重の鎖で縛っておくように命じた上、パウロは何者か、また何をしたのか、と尋ねた。"},{"ref":"Acts.21.34","start":44021034,"end":44021034,"break":"none","ruby":[[4,2,"ぐんしゅう"],[11,1,"ちが"],[17,1,"さけ"],[26,1,"さわ"],[32,1,"たし"],[46,1,"かれ"],[52,2,"へいえい"],[55,1,"つ"],[58,1,"い"],[63,1,"めい"]],"text":"しかし、群衆がそれぞれ違ったことを叫びつづけるため、騒がしくて、確かなことがわからないので、彼はパウロを兵営に連れて行くように命じた。"},{"ref":"Acts.21.35","start":44021035,"end":44021035,"break":"none","ruby":[[4,2,"かいだん"],[13,1,"とき"],[17,2,"ぐんしゅう"],[20,2,"ぼうこう"],[23,1,"さ"],[29,2,"へいそつ"],[39,1,"い"],[44,2,"しまつ"]],"text":"パウロが階段にさしかかった時には、群衆の暴行を避けるため、兵卒たちにかつがれて行くという始末であった。"},{"ref":"Acts.21.36","start":44021036,"end":44021036,"break":"none","ruby":[[0,1,"おお"],[4,2,"みんしゅう"],[21,1,"さけ"]],"text":"大ぜいの民衆が「あれをやっつけてしまえ」と叫びながら、ついてきたからである。"},{"ref":"Acts.21.37","start":44021037,"end":44021037,"break":"paragraph","ruby":[[4,2,"へいえい"],[7,1,"なか"],[9,1,"つ"],[12,1,"い"],[20,1,"とき"],[22,3,"せんそつちょう"],[30,1,"こと"],[36,1,"はな"],[49,1,"たず"],[54,3,"せんそつちょう"],[58,1,"い"],[71,1,"ご"],[73,1,"はな"]],"text":"パウロが兵営の中に連れて行かれようとした時、千卒長に、「ひと言あなたにお話してもよろしいですか」と尋ねると、千卒長が言った、「おまえはギリシヤ語が話せるのか。"},{"ref":"Acts.21.38","start":44021038,"end":44021038,"break":"none","ruby":[[11,1,"さき"],[14,2,"はんらん"],[17,1,"おこ"],[20,1,"のち"],[24,1,"にん"],[26,2,"しかく"],[29,1,"ひ"],[31,1,"つ"],[34,2,"あらの"],[37,1,"に"],[40,1,"い"],[49,1,"じん"]],"text":"では、もしかおまえは、先ごろ反乱を起した後、四千人の刺客を引き連れて荒野へ逃げて行ったあのエジプト人ではないのか」。"},{"ref":"Acts.21.39","start":44021039,"end":44021039,"break":"none","ruby":[[4,1,"こた"],[16,1,"うま"],[22,1,"じん"],[36,2,"とし"],[39,2,"しみん"],[45,1,"ねが"],[51,2,"みんしゅう"],[54,1,"はなし"],[59,1,"くだ"]],"text":"パウロは答えた、「わたしはタルソ生れのユダヤ人で、キリキヤのれっきとした都市の市民です。お願いですが、民衆に話をさせて下さい」。"},{"ref":"Acts.21.40","start":44021040,"end":44021040,"break":"none","ruby":[[0,3,"せんそつちょう"],[4,1,"ゆる"],[17,2,"かいだん"],[20,1,"うえ"],[22,1,"た"],[25,2,"みんしゅう"],[32,1,"て"],[34,1,"ふ"],[42,2,"いちどう"],[49,2,"せいしゅく"],[65,1,"ご"],[67,1,"はな"],[69,1,"だ"]],"text":"千卒長が許してくれたので、パウロは階段の上に立ち、民衆にむかって手を振った。すると、一同がすっかり静粛になったので、パウロはヘブル語で話し出した。"}]