[{"ref":"Zech.14.1","start":38014001,"end":38014001,"break":"paragraph","ruby":[[0,1,"み"],[3,1,"しゅ"],[5,1,"ひ"],[7,1,"く"],[12,1,"とき"],[17,1,"うば"],[21,1,"もの"],[28,1,"なか"],[30,1,"わ"]],"text":"見よ、主の日が来る。その時あなたの奪われた物は、あなたの中で分かたれる。"},{"ref":"Zech.14.2","start":38014002,"end":38014002,"break":"none","ruby":[[4,2,"ばんこく"],[7,1,"たみ"],[9,1,"あつ"],[19,1,"せ"],[21,1,"う"],[26,1,"まち"],[28,1,"と"],[32,1,"いえ"],[40,1,"おんな"],[42,1,"おか"],[46,1,"まち"],[48,1,"なか"],[51,1,"とら"],[56,1,"い"],[62,1,"のこ"],[65,1,"たみ"],[67,1,"まち"],[70,1,"た"]],"text":"わたしは万国の民を集めて、エルサレムを攻め撃たせる。町は取られ、家はかすめられ、女は犯され、町の半ばは捕えられて行く。しかし残りの民は町から断たれることはない。"},{"ref":"Zech.14.3","start":38014003,"end":38014003,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,1,"で"],[15,1,"ひ"],[21,1,"たたか"],[25,1,"とき"],[35,1,"くに"],[39,1,"たたか"]],"text":"その時、主は出てきて、いくさの日にみずから戦われる時のように、それらの国びとと戦われる。"},{"ref":"Zech.14.4","start":38014004,"end":38014004,"break":"none","ruby":[[2,1,"ひ"],[5,1,"かれ"],[7,1,"あし"],[10,1,"ひがし"],[12,1,"ほう"],[19,1,"まえ"],[26,1,"やま"],[28,1,"うえ"],[30,1,"た"],[39,1,"やま"],[42,2,"ひじょう"],[45,1,"ひろ"],[50,1,"たに"],[56,1,"ひがし"],[59,1,"にし"],[64,1,"さ"],[69,1,"やま"],[71,1,"なか"],[74,1,"きた"],[77,1,"なか"],[80,1,"みなみ"],[82,1,"うつ"]],"text":"その日には彼の足が、東の方エルサレムの前にあるオリブ山の上に立つ。そしてオリブ山は、非常に広い一つの谷によって、東から西に二つに裂け、その山の半ばは北に、半ばは南に移り、"},{"ref":"Zech.14.5","start":38014005,"end":38014005,"break":"none","ruby":[[2,1,"やま"],[4,1,"たに"],[12,1,"さ"],[15,1,"やま"],[17,1,"たに"],[27,2,"せっしょく"],[50,1,"おう"],[55,1,"よ"],[58,2,"じしん"],[61,1,"さ"],[64,1,"に"],[70,1,"に"],[85,1,"かみ"],[87,1,"しゅ"],[99,2,"せいじゃ"],[102,1,"とも"]],"text":"わが山の谷はふさがれる。裂けた山の谷が、そのかたわらに接触するからである。そして、あなたがたはユダの王ウジヤの世に、地震を避けて逃げたように逃げる。こうして、あなたがたの神、主はこられる、もろもろの聖者と共にこられる。"},{"ref":"Zech.14.6","start":38014006,"end":38014006,"break":"paragraph","ruby":[[2,1,"ひ"],[6,1,"さむ"],[9,1,"しも"]],"text":"その日には、寒さも霜もない。"},{"ref":"Zech.14.7","start":38014007,"end":38014007,"break":"none","ruby":[[4,1,"なが"],[6,2,"れんぞく"],[10,1,"ひ"],[15,1,"しゅ"],[20,1,"し"],[30,1,"ひる"],[35,1,"よる"],[40,2,"ゆうぐれ"],[48,1,"ひかり"]],"text":"そこには長い連続した日がある（主はこれを知られる）。これには昼もなく、夜もない。夕暮になっても、光があるからである。"},{"ref":"Zech.14.8","start":38014008,"end":38014008,"break":"paragraph","ruby":[[2,1,"ひ"],[6,1,"い"],[9,1,"みず"],[18,1,"なが"],[20,1,"で"],[25,1,"なか"],[28,1,"ひがし"],[30,1,"うみ"],[35,1,"なか"],[38,1,"にし"],[40,1,"うみ"],[42,1,"なが"],[45,1,"なつ"],[47,1,"ふゆ"]],"text":"その日には、生ける水がエルサレムから流れ出て、その半ばは東の海に、その半ばは西の海に流れ、夏も冬もやむことがない。"},{"ref":"Zech.14.9","start":38014009,"end":38014009,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"ぜん"],[3,1,"ち"],[5,1,"おう"],[14,1,"ひ"],[18,1,"しゅ"],[25,1,"な"]],"text":"主は全地の王となられる。その日には、主ひとり、その名一つのみとなる。"},{"ref":"Zech.14.10","start":38014010,"end":38014010,"break":"paragraph","ruby":[[0,1,"ぜん"],[1,1,"ち"],[13,1,"みなみ"],[21,2,"へいち"],[27,1,"かわ"],[39,1,"たか"],[50,1,"ところ"],[63,1,"もん"],[67,1,"さき"],[72,1,"もん"],[74,1,"ところ"],[76,1,"およ"],[79,1,"すみ"],[81,1,"もん"],[83,1,"いた"],[97,1,"おう"],[99,1,"さか"],[105,1,"およ"]],"text":"全地はゲバからエルサレムの南リンモンまで、平地のように変る。しかしエルサレムは高くなって、そのもとの所にとどまり、ベニヤミンの門から、先にあった門の所に及び、隅の門に至り、ハナネルのやぐらから、王の酒ぶねにまで及ぶ。"},{"ref":"Zech.14.11","start":38014011,"end":38014011,"break":"none","ruby":[[2,1,"なか"],[5,1,"ひと"],[7,1,"す"],[26,1,"やす"],[30,1,"た"]],"text":"その中には人が住み、もはやのろいはなく、エルサレムは安らかに立つ。"},{"ref":"Zech.14.12","start":38014012,"end":38014012,"break":"paragraph","ruby":[[6,2,"こうげき"],[15,1,"たみ"],[18,1,"しゅ"],[20,1,"わざわい"],[25,1,"う"],[34,1,"かれ"],[39,1,"あし"],[41,1,"た"],[52,1,"にく"],[54,1,"くさ"],[57,1,"め"],[61,1,"あな"],[63,1,"なか"],[65,1,"くさ"],[68,1,"した"],[72,1,"くち"],[74,1,"なか"],[76,1,"くさ"]],"text":"エルサレムを攻撃したもろもろの民を、主は災をもって撃たれる。すなわち彼らはなお足で立っているうちに、その肉は腐れ、目はその穴の中で腐れ、舌はその口の中で腐れる。"},{"ref":"Zech.14.13","start":38014013,"end":38014013,"break":"none","ruby":[[2,1,"ひ"],[6,1,"しゅ"],[8,1,"かれ"],[11,1,"おお"],[25,1,"かれ"],[34,1,"とな"],[36,1,"びと"],[38,1,"とら"],[41,1,"て"],[48,1,"とな"],[50,1,"びと"],[52,1,"せ"]],"text":"その日には、主は彼らを大いにあわてさせられるので、彼らはおのおのその隣り人を捕え、手をあげてその隣り人を攻める。"},{"ref":"Zech.14.14","start":38014014,"end":38014014,"break":"none","ruby":[[12,1,"てき"],[15,1,"たたか"],[20,2,"しゅうい"],[27,1,"くに"],[31,2,"ざいほう"],[38,2,"きんぎん"],[41,2,"いふく"],[51,1,"おお"],[53,1,"あつ"]],"text":"ユダもまた、エルサレムに敵して戦う。その周囲のすべての国びとの財宝、すなわち金銀、衣服などが、はなはだ多く集められる。"},{"ref":"Zech.14.15","start":38014015,"end":38014015,"break":"none","ruby":[[2,1,"うま"],[4,1,"ら"],[18,2,"じんえい"],[27,2,"かちく"],[34,1,"わざわい"],[39,1,"わざわい"],[41,1,"のぞ"]],"text":"また馬、騾、らくだ、ろば、およびその陣営にあるすべての家畜にも、この災のような災が臨む。"},{"ref":"Zech.14.16","start":38014016,"end":38014016,"break":"paragraph","ruby":[[6,1,"せ"],[9,1,"き"],[16,1,"くに"],[20,1,"のこ"],[23,1,"もの"],[26,1,"みな"],[27,2,"ねんねん"],[29,1,"のぼ"],[32,1,"き"],[35,1,"おう"],[38,2,"ばんぐん"],[41,1,"しゅ"],[43,1,"おが"],[46,2,"かりほ"],[49,1,"まつり"],[51,1,"まも"]],"text":"エルサレムに攻めて来たもろもろの国びとの残った者は、皆年々上って来て、王なる万軍の主を拝み、仮庵の祭を守るようになる。"},{"ref":"Zech.14.17","start":38014017,"end":38014017,"break":"none","ruby":[[0,1,"ち"],[2,1,"しょ"],[3,1,"ぞく"],[8,1,"おう"],[11,2,"ばんぐん"],[14,1,"しゅ"],[16,1,"おが"],[28,1,"のぼ"],[32,1,"もの"],[34,1,"うえ"],[38,1,"あめ"],[40,1,"ふ"]],"text":"地の諸族のうち、王なる万軍の主を拝むために、エルサレムに上らない者の上には、雨が降らない。"},{"ref":"Zech.14.18","start":38014018,"end":38014018,"break":"none","ruby":[[5,2,"ひとびと"],[11,1,"のぼ"],[17,1,"とき"],[21,1,"しゅ"],[23,2,"かりほ"],[26,1,"まつり"],[28,1,"まも"],[34,1,"のぼ"],[44,1,"くに"],[48,1,"う"],[54,1,"わざわい"],[57,1,"かれ"],[60,1,"うえ"],[62,1,"のぞ"]],"text":"エジプトの人々が、もし上ってこない時には、主が仮庵の祭を守るために、上ってこないすべての国びとを撃たれるその災が、彼らの上に臨む。"},{"ref":"Zech.14.19","start":38014019,"end":38014019,"break":"none","ruby":[[11,1,"う"],[14,1,"ばつ"],[22,2,"かりほ"],[25,1,"まつり"],[27,1,"まも"],[32,1,"のぼ"],[38,1,"くに"],[42,1,"う"],[45,1,"ばつ"]],"text":"これが、エジプトびとの受ける罰、およびすべて仮庵の祭を守るために上ってこない国びとの受ける罰である。"},{"ref":"Zech.14.20","start":38014020,"end":38014020,"break":"paragraph","ruby":[[2,1,"ひ"],[6,1,"うま"],[8,1,"すず"],[10,1,"うえ"],[13,1,"しゅ"],[15,1,"せい"],[18,1,"もの"],[32,1,"しゅ"],[34,1,"みや"],[40,2,"さいだん"],[43,1,"まえ"],[45,1,"はち"],[51,1,"せい"],[54,1,"もの"]],"text":"その日には、馬の鈴の上に「主に聖なる者」と、しるすのである。また主の宮のなべは、祭壇の前の鉢のように、聖なる物となる。"},{"ref":"Zech.14.21","start":38014021,"end":38014021,"break":"none","ruby":[[19,2,"ばんぐん"],[22,1,"しゅ"],[24,1,"たい"],[27,1,"せい"],[30,1,"もの"],[38,2,"ぎせい"],[45,1,"もの"],[47,1,"き"],[52,1,"と"],[57,1,"なか"],[59,2,"ぎせい"],[62,1,"にく"],[64,1,"に"],[75,1,"ひ"],[79,2,"ばんぐん"],[82,1,"しゅ"],[84,1,"みや"],[90,2,"しょうにん"]],"text":"エルサレムおよびユダのすべてのなべは、万軍の主に対して聖なる物となり、すべて犠牲をささげる者は来てこれを取り、その中で犠牲の肉を煮ることができる。その日には、万軍の主の宮に、もはや商人はいない。"}]