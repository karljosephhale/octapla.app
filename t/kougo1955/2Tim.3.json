[{"ref":"2Tim.3.1","start":55003001,"end":55003001,"break":"paragraph","ruby":[[9,1,"し"],[21,1,"おわ"],[24,1,"とき"],[28,2,"くなん"],[31,2,"じだい"],[34,1,"く"]],"text":"しかし、このことは知っておかねばならない。終りの時には、苦難の時代が来る。"},{"ref":"2Tim.3.2","start":55003002,"end":55003002,"break":"none","ruby":[[2,1,"とき"],[4,2,"ひとびと"],[7,2,"じぶん"],[10,1,"あい"],[13,1,"もの"],[15,1,"かね"],[17,1,"あい"],[20,1,"もの"],[22,4,"たいげんそうご"],[28,1,"もの"],[30,2,"こうまん"],[33,1,"もの"],[35,1,"かみ"],[40,1,"もの"],[42,1,"おや"],[44,1,"さか"],[47,1,"もの"],[49,1,"おん"],[51,1,"し"],[54,1,"もの"],[56,2,"しんせい"],[59,1,"けが"],[61,1,"もの"]],"text":"その時、人々は自分を愛する者、金を愛する者、大言壮語する者、高慢な者、神をそしる者、親に逆らう者、恩を知らぬ者、神聖を汚す者、"},{"ref":"2Tim.3.3","start":55003003,"end":55003003,"break":"none","ruby":[[0,2,"むじょう"],[3,1,"もの"],[5,2,"ゆうわ"],[10,1,"もの"],[15,1,"もの"],[17,1,"む"],[18,2,"せっせい"],[21,1,"もの"],[23,2,"そぼう"],[26,1,"もの"],[28,1,"ぜん"],[30,1,"この"],[34,1,"もの"]],"text":"無情な者、融和しない者、そしる者、無節制な者、粗暴な者、善を好まない者、"},{"ref":"2Tim.3.4","start":55003004,"end":55003004,"break":"none","ruby":[[0,2,"うらぎ"],[3,1,"もの"],[5,2,"らんぼう"],[7,1,"もの"],[9,2,"こうげん"],[14,1,"もの"],[16,1,"かみ"],[20,2,"かいらく"],[23,1,"あい"],[26,1,"もの"]],"text":"裏切り者、乱暴者、高言をする者、神よりも快楽を愛する者、"},{"ref":"2Tim.3.5","start":55003005,"end":55003005,"break":"none","ruby":[[0,2,"しんじん"],[2,1,"ぶか"],[4,2,"ようす"],[13,1,"じつ"],[15,1,"す"],[18,1,"もの"],[31,2,"ひとびと"],[34,1,"さ"]],"text":"信心深い様子をしながらその実を捨てる者となるであろう。こうした人々を避けなさい。"},{"ref":"2Tim.3.6","start":55003006,"end":55003006,"break":"none","ruby":[[0,1,"かれ"],[3,1,"なか"],[7,1,"ひと"],[9,1,"いえ"],[14,1,"こ"],[26,1,"よく"],[28,1,"こころ"],[30,1,"うば"],[35,1,"おお"],[38,1,"つみ"],[40,1,"つ"],[42,1,"かさ"],[47,1,"おろ"],[50,1,"おんな"],[63,1,"もの"]],"text":"彼らの中には、人の家にもぐり込み、そして、さまざまの欲に心を奪われて、多くの罪を積み重ねている愚かな女どもを、とりこにしている者がある。"},{"ref":"2Tim.3.7","start":55003007,"end":55003007,"break":"none","ruby":[[0,2,"かのじょ"],[6,1,"つね"],[8,1,"まな"],[23,2,"しんり"],[26,2,"ちしき"],[29,1,"たっ"]],"text":"彼女たちは、常に学んではいるが、いつになっても真理の知識に達することができない。"},{"ref":"2Tim.3.8","start":55003008,"end":55003008,"break":"none","ruby":[[19,1,"さか"],[31,2,"ひとびと"],[34,2,"しんり"],[37,1,"さか"],[45,1,"かれ"],[48,2,"ちせい"],[51,1,"くさ"],[55,2,"しんこう"],[58,3,"しっかくしゃ"]],"text":"ちょうど、ヤンネとヤンブレとがモーセに逆らったように、こうした人々も真理に逆らうのである。彼らは知性の腐った、信仰の失格者である。"},{"ref":"2Tim.3.9","start":55003009,"end":55003009,"break":"none","ruby":[[4,1,"かれ"],[11,1,"すす"],[23,1,"かれ"],[26,1,"おろ"],[37,2,"ばあい"],[40,1,"おな"],[46,1,"おお"],[49,1,"ひと"],[51,1,"し"],[54,1,"く"]],"text":"しかし、彼らはそのまま進んでいけるはずがない。彼らの愚かさは、あのふたりの場合と同じように、多くの人に知れて来るであろう。"},{"ref":"2Tim.3.10","start":55003010,"end":55003010,"break":"paragraph","ruby":[[12,1,"おしえ"],[14,1,"あゆ"],[23,2,"しんこう"],[26,2,"かんよう"],[29,1,"あい"],[31,2,"にんたい"]],"text":"しかしあなたは、わたしの教、歩み、こころざし、信仰、寛容、愛、忍耐、"},{"ref":"2Tim.3.11","start":55003011,"end":55003011,"break":"none","ruby":[[26,1,"う"],[29,2,"かずかず"],[32,2,"はくがい"],[35,2,"くなん"],[42,1,"つづ"],[56,2,"はくがい"],[63,1,"た"],[70,1,"しゅ"],[85,1,"すく"],[87,1,"だ"],[90,1,"くだ"]],"text":"それから、わたしがアンテオケ、イコニオム、ルステラで受けた数々の迫害、苦難に、よくも続いてきてくれた。そのひどい迫害にわたしは耐えてきたが、主はそれらいっさいのことから、救い出して下さったのである。"},{"ref":"2Tim.3.12","start":55003012,"end":55003012,"break":"none","ruby":[[17,2,"しんじん"],[19,1,"ぶか"],[21,1,"い"],[28,1,"もの"],[34,2,"はくがい"],[37,1,"う"]],"text":"いったい、キリスト・イエスにあって信心深く生きようとする者は、みな、迫害を受ける。"},{"ref":"2Tim.3.13","start":55003013,"end":55003013,"break":"none","ruby":[[0,2,"あくにん"],[3,2,"さぎ"],[5,1,"し"],[8,1,"ひと"],[10,1,"まど"],[13,1,"ひと"],[15,1,"まど"],[21,1,"あく"],[24,1,"あく"],[27,1,"お"]],"text":"悪人と詐欺師とは人を惑わし人に惑わされて、悪から悪へと落ちていく。"},{"ref":"2Tim.3.14","start":55003014,"end":55003014,"break":"none","ruby":[[9,2,"じぶん"],[12,1,"まな"],[15,2,"かくしん"],[51,1,"まな"],[55,1,"し"]],"text":"しかし、あなたは、自分が学んで確信しているところに、いつもとどまっていなさい。あなたは、それをだれから学んだか知っており、"},{"ref":"2Tim.3.15","start":55003015,"end":55003015,"break":"none","ruby":[[2,1,"おさな"],[4,1,"とき"],[8,2,"せいしょ"],[11,1,"した"],[28,1,"たい"],[31,2,"しんこう"],[37,1,"すくい"],[39,1,"いた"],[41,2,"ちえ"],[49,1,"あた"],[53,2,"しょもつ"],[61,1,"し"]],"text":"また幼い時から、聖書に親しみ、それが、キリスト・イエスに対する信仰によって救に至る知恵を、あなたに与えうる書物であることを知っている。"},{"ref":"2Tim.3.16","start":55003016,"end":55003016,"break":"none","ruby":[[0,2,"せいしょ"],[7,1,"かみ"],[9,1,"れい"],[10,1,"かん"],[12,1,"う"],[15,1,"か"],[26,1,"ひと"],[28,1,"おし"],[31,1,"いまし"],[34,1,"ただ"],[39,1,"ぎ"],[41,1,"みちび"],[45,2,"ゆうえき"]],"text":"聖書は、すべて神の霊感を受けて書かれたものであって、人を教え、戒め、正しくし、義に導くのに有益である。"},{"ref":"2Tim.3.17","start":55003017,"end":55003017,"break":"none","ruby":[[7,1,"かみ"],[9,1,"ひと"],[16,1,"よ"],[21,1,"たい"],[24,2,"じゅうぶん"],[27,2,"じゅんび"],[34,2,"かんぜん"],[44,1,"もの"]],"text":"それによって、神の人が、あらゆる良いわざに対して十分な準備ができて、完全にととのえられた者になるのである。"}]