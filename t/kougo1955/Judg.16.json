[{"ref":"Judg.16.1","start":7016001,"end":7016001,"break":"paragraph","ruby":[[8,1,"い"],[19,2,"ゆうじょ"],[22,1,"み"],[26,1,"おんな"]],"text":"サムソンはガザへ行って、そこでひとりの遊女を見、その女のところにはいった。"},{"ref":"Judg.16.2","start":7016002,"end":7016002,"break":"none","ruby":[[17,2,"ひとびと"],[20,1,"つ"],[35,2,"ひとびと"],[40,1,"ところ"],[42,1,"と"],[44,1,"かこ"],[47,2,"よどお"],[50,1,"まち"],[52,1,"もん"],[54,1,"ま"],[56,1,"ぶ"],[66,1,"あさ"],[69,1,"ま"],[72,1,"かれ"],[74,1,"ころ"],[79,1,"い"],[83,2,"よどお"],[86,1,"しず"]],"text":"「サムソンがここにきた」と、ガザの人々に告げるものがあったので、ガザの人々はその所を取り囲み、夜通し町の門で待ち伏せし、「われわれは朝まで待って彼を殺そう」と言って、夜通し静かにしていた。"},{"ref":"Judg.16.3","start":7016003,"end":7016003,"break":"none","ruby":[[5,2,"よなか"],[9,1,"ね"],[13,2,"よなか"],[16,1,"お"],[20,1,"まち"],[22,1,"もん"],[31,2,"もんちゅう"],[34,1,"て"],[40,1,"かん"],[42,1,"き"],[48,1,"ひ"],[50,1,"ぬ"],[53,1,"かた"],[55,1,"の"],[64,1,"む"],[70,1,"やま"],[72,1,"いただき"],[74,1,"はこ"],[77,1,"い"]],"text":"サムソンは夜中まで寝たが、夜中に起きて、町の門のとびらと二つの門柱に手をかけて、貫の木もろともに引き抜き、肩に載せて、ヘブロンの向かいにある山の頂に運んで行った。"},{"ref":"Judg.16.4","start":7016004,"end":7016004,"break":"paragraph","ruby":[[2,1,"のち"],[13,1,"たに"],[23,1,"おんな"],[25,1,"あい"]],"text":"この後、サムソンはソレクの谷にいるデリラという女を愛した。"},{"ref":"Judg.16.5","start":7016005,"end":7016005,"break":"none","ruby":[[7,1,"きみ"],[13,1,"おんな"],[21,1,"い"],[35,1,"と"],[42,1,"かれ"],[44,2,"だいりき"],[67,1,"かれ"],[69,1,"か"],[73,1,"かれ"],[75,1,"しば"],[77,1,"くる"],[89,1,"み"],[110,1,"ぎん"],[113,1,"まい"]],"text":"ペリシテびとの君たちはその女のところにきて言った、「あなたはサムソンを説きすすめて、彼の大力はどこにあるのか、またわれわれはどうすれば彼に勝って、彼を縛り苦しめることができるかを見つけなさい。そうすればわれわれはおのおの銀千百枚ずつをあなたにさしあげましょう」。"},{"ref":"Judg.16.6","start":7016006,"end":7016006,"break":"none","ruby":[[12,1,"い"],[21,2,"だいりき"],[43,1,"しば"],[46,1,"くる"],[65,1,"き"]],"text":"そこでデリラはサムソンに言った、「あなたの大力はどこにあるのか、またどうすればあなたを縛って苦しめることができるか、どうぞわたしに聞かせてください」。"},{"ref":"Judg.16.7","start":7016007,"end":7016007,"break":"none","ruby":[[5,1,"おんな"],[7,1,"い"],[12,2,"ひとびと"],[28,1,"ほん"],[30,1,"あたら"],[33,2,"ゆみづる"],[43,1,"しば"],[52,1,"よわ"],[60,1,"ひと"]],"text":"サムソンは女に言った、「人々がもし、かわいたことのない七本の新しい弓弦をもってわたしを縛るなら、わたしは弱くなってほかの人のようになるでしょう」。"},{"ref":"Judg.16.8","start":7016008,"end":7016008,"break":"none","ruby":[[10,1,"きみ"],[25,1,"ほん"],[27,1,"あたら"],[30,2,"ゆみづる"],[33,1,"おんな"],[35,1,"も"],[43,1,"おんな"],[56,1,"しば"]],"text":"そこでペリシテびとの君たちが、かわいたことのない七本の新しい弓弦を女に持ってきたので、女はそれをもってサムソンを縛った。"},{"ref":"Judg.16.9","start":7016009,"end":7016009,"break":"none","ruby":[[0,1,"おんな"],[5,1,"おく"],[10,1,"ひと"],[12,1,"しの"],[25,1,"い"],[47,1,"せま"],[65,2,"ゆみづる"],[73,2,"あま"],[75,1,"いと"],[77,1,"ひ"],[82,1,"た"],[89,1,"た"],[91,1,"き"],[99,1,"かれ"],[101,1,"ちから"],[103,2,"ひみつ"],[106,1,"し"]],"text":"女はかねて奥のへやに人を忍ばせておいて、サムソンに言った、「サムソンよ、ペリシテびとがあなたに迫っています」。しかしサムソンはその弓弦を、あたかも亜麻糸が火にあって断たれるように断ち切った。こうして彼の力の秘密は知れなかった。"},{"ref":"Judg.16.10","start":7016010,"end":7016010,"break":"paragraph","ruby":[[9,1,"い"],[22,1,"あざむ"],[29,1,"い"],[44,1,"しば"],[57,1,"いま"],[62,1,"き"]],"text":"デリラはサムソンに言った、「あなたはわたしを欺いて、うそを言いました。どうしたらあなたを縛ることができるか、どうぞ今わたしに聞かせてください」。"},{"ref":"Judg.16.11","start":7016011,"end":7016011,"break":"none","ruby":[[5,1,"おんな"],[7,1,"い"],[14,2,"ひとびと"],[19,1,"もち"],[27,1,"あたら"],[30,1,"つな"],[40,1,"しば"],[45,1,"よわ"],[53,1,"ひと"]],"text":"サムソンは女に言った、「もし人々がまだ用いたことのない新しい綱をもって、わたしを縛るなら、弱くなってほかの人のようになるでしょう」。"},{"ref":"Judg.16.12","start":7016012,"end":7016012,"break":"none","ruby":[[7,1,"あたら"],[10,1,"つな"],[21,1,"かれ"],[23,1,"しば"],[29,1,"かれ"],[31,1,"い"],[53,1,"せま"],[61,1,"とき"],[63,2,"ひとびと"],[66,1,"おく"],[71,1,"しの"],[85,1,"つな"],[87,1,"いと"],[92,1,"うで"],[95,1,"た"],[97,1,"おと"]],"text":"そこでデリラは新しい綱をとり、それをもって彼を縛り、そして彼に言った、「サムソンよ、ペリシテびとがあなたに迫っています」。時に人々は奥のへやに忍んでいたが、サムソンはその綱を糸のように腕から断ち落した。"},{"ref":"Judg.16.13","start":7016013,"end":7016013,"break":"paragraph","ruby":[[12,1,"い"],[21,1,"いま"],[29,1,"あざむ"],[36,1,"い"],[52,1,"しば"],[66,1,"き"],[76,1,"かれ"],[78,1,"おんな"],[80,1,"い"],[96,1,"かみ"],[98,1,"け"],[103,1,"はた"],[105,2,"たていと"],[108,2,"いっしょ"],[111,1,"お"],[121,1,"と"],[134,1,"よわ"],[142,1,"ひと"],[158,1,"かれ"],[160,1,"ねむ"],[175,1,"かみ"],[177,1,"け"],[190,1,"はた"],[192,2,"たていと"],[195,1,"お"],[197,1,"こ"]],"text":"そこでデリラはサムソンに言った、「あなたは今まで、わたしを欺いて、うそを言いましたが、どうしたらあなたを縛ることができるか、わたしに聞かせてください」。彼は女に言った、「あなたがもし、わたしの髪の毛七ふさを機の縦糸と一緒に織って、くぎでそれを留めておくならば、わたしは弱くなってほかの人のようになるでしょう」。そこで彼が眠ったとき、デリラはサムソンの髪の毛、七ふさをとって、それを機の縦糸に織り込み、"},{"ref":"Judg.16.14","start":7016014,"end":7016014,"break":"none","ruby":[[6,1,"と"],[13,1,"かれ"],[15,1,"い"],[37,1,"せま"],[53,1,"め"],[63,1,"はた"],[65,2,"たていと"],[69,1,"ひ"],[71,1,"ぬ"]],"text":"くぎでそれを留めておいて、彼に言った、「サムソンよ、ペリシテびとがあなたに迫っています」。しかしサムソンは目をさまして、くぎと機と縦糸とを引き抜いた。"},{"ref":"Judg.16.15","start":7016015,"end":7016015,"break":"paragraph","ruby":[[3,1,"おんな"],[10,1,"い"],[19,1,"こころ"],[25,1,"はな"],[42,1,"あい"],[47,1,"い"],[66,1,"ど"],[72,1,"あざむ"],[79,2,"だいりき"],[93,1,"つ"]],"text":"そこで女はサムソンに言った、「あなたの心がわたしを離れているのに、どうして『おまえを愛する』と言うことができますか。あなたはすでに三度もわたしを欺き、あなたの大力がどこにあるかをわたしに告げませんでした」。"},{"ref":"Judg.16.16","start":7016016,"end":7016016,"break":"none","ruby":[[0,1,"おんな"],[2,2,"まいにち"],[6,2,"ことば"],[12,1,"かれ"],[14,1,"せま"],[16,1,"うなが"],[22,1,"かれ"],[24,1,"たましい"],[26,1,"し"],[32,1,"くる"]],"text":"女は毎日その言葉をもって彼に迫り促したので、彼の魂は死ぬばかりに苦しんだ。"},{"ref":"Judg.16.17","start":7016017,"end":7016017,"break":"none","ruby":[[0,1,"かれ"],[7,1,"こころ"],[14,1,"う"],[16,1,"あ"],[19,1,"おんな"],[21,1,"い"],[30,1,"あたま"],[38,1,"あ"],[54,1,"うま"],[57,1,"とき"],[60,1,"かみ"],[81,1,"かみ"],[85,1,"おと"],[96,1,"ちから"],[98,1,"さ"],[101,1,"よわ"],[109,1,"ひと"]],"text":"彼はついにその心をことごとく打ち明けて女に言った、「わたしの頭にはかみそりを当てたことがありません。わたしは生れた時から神にささげられたナジルびとだからです。もし髪をそり落されたなら、わたしの力は去って弱くなり、ほかの人のようになるでしょう」。"},{"ref":"Judg.16.18","start":7016018,"end":7016018,"break":"paragraph","ruby":[[11,1,"こころ"],[18,1,"う"],[20,1,"あ"],[25,1,"み"],[27,1,"ひと"],[41,1,"きみ"],[45,1,"よ"],[48,1,"い"],[60,1,"こころ"],[71,1,"う"],[73,1,"あ"],[81,2,"こんど"],[85,1,"のぼ"],[106,1,"きみ"],[111,1,"ぎん"],[113,1,"たずさ"],[116,1,"おんな"],[121,1,"のぼ"]],"text":"デリラはサムソンがその心をことごとく打ち明けたのを見、人をつかわしてペリシテびとの君たちを呼んで言った、「サムソンはその心をことごとくわたしに打ち明けましたから、今度こそ上っておいでなさい」。そこでペリシテびとの君たちは、銀を携えて女のもとに上ってきた。"},{"ref":"Judg.16.19","start":7016019,"end":7016019,"break":"none","ruby":[[0,1,"おんな"],[2,2,"じぶん"],[8,1,"うえ"],[15,1,"ねむ"],[19,1,"ひと"],[21,1,"よ"],[24,1,"かみ"],[26,1,"け"],[34,1,"おと"],[38,1,"かれ"],[40,1,"くる"],[43,1,"はじ"],[50,1,"ちから"],[52,1,"かれ"],[54,1,"さ"]],"text":"女は自分のひざの上にサムソンを眠らせ、人を呼んで髪の毛、七ふさをそり落させ、彼を苦しめ始めたが、その力は彼を去っていた。"},{"ref":"Judg.16.20","start":7016020,"end":7016020,"break":"none","ruby":[[3,1,"おんな"],[23,1,"せま"],[31,1,"い"],[37,1,"かれ"],[39,1,"め"],[45,1,"い"],[61,1,"で"],[63,1,"い"],[77,1,"かれ"],[79,1,"しゅ"],[81,2,"じぶん"],[84,1,"さ"],[91,1,"し"]],"text":"そして女が「サムソンよ、ペリシテびとがあなたに迫っています」と言ったので、彼は目をさまして言った、「わたしはいつものように出て行って、からだをゆすろう」。彼は主が自分を去られたことを知らなかった。"},{"ref":"Judg.16.21","start":7016021,"end":7016021,"break":"none","ruby":[[10,1,"かれ"],[12,1,"とら"],[16,1,"りょう"],[17,1,"め"],[26,1,"ひ"],[29,1,"い"],[33,2,"せいどう"],[36,1,"あし"],[43,1,"かれ"],[59,2,"ごくや"],[62,1,"なか"]],"text":"そこでペリシテびとは彼を捕えて、両眼をえぐり、ガザに引いて行って、青銅の足かせをかけて彼をつないだ。こうしてサムソンは獄屋の中で、うすをひいていたが、"},{"ref":"Judg.16.22","start":7016022,"end":7016022,"break":"none","ruby":[[2,1,"かみ"],[4,1,"け"],[8,1,"おと"],[12,1,"のち"],[18,1,"の"],[20,1,"はじ"]],"text":"その髪の毛はそり落された後、ふたたび伸び始めた。"},{"ref":"Judg.16.23","start":7016023,"end":7016023,"break":"paragraph","ruby":[[9,1,"きみ"],[14,1,"かれ"],[17,1,"かみ"],[22,1,"おお"],[26,2,"ぎせい"],[33,1,"しゅく"],[40,1,"とも"],[42,1,"あつ"],[46,1,"い"],[56,1,"かみ"],[59,1,"てき"],[70,1,"て"]],"text":"さてペリシテびとの君たちは、彼らの神ダゴンに大いなる犠牲をささげて祝をしようと、共に集まって言った、「われわれの神は、敵サムソンをわれわれの手にわたされた」。"},{"ref":"Judg.16.24","start":7016024,"end":7016024,"break":"none","ruby":[[0,1,"たみ"],[7,1,"み"],[10,2,"じぶん"],[15,1,"かみ"],[23,1,"い"],[33,1,"かみ"],[41,1,"くに"],[43,1,"あら"],[51,1,"おお"],[53,1,"ころ"],[56,1,"てき"],[63,1,"て"]],"text":"民はサムソンを見て、自分たちの神をほめたたえて言った、「われわれの神は、われわれの国を荒し、われわれを多く殺した敵をわれわれの手にわたされた」。"},{"ref":"Judg.16.25","start":7016025,"end":7016025,"break":"none","ruby":[[0,1,"かれ"],[5,1,"こころ"],[7,1,"よろこ"],[10,1,"い"],[20,1,"よ"],[32,1,"ざ"],[34,1,"ごと"],[42,1,"かれ"],[45,2,"ごくや"],[54,1,"よ"],[56,1,"だ"],[60,1,"かれ"],[63,1,"まえ"],[65,1,"ざ"],[67,1,"ごと"],[73,1,"かれ"],[81,1,"はしら"],[87,1,"た"]],"text":"彼らはまた心に喜んで言った、「サムソンを呼んで、われわれのために戯れ事をさせよう」。彼らは獄屋からサムソンを呼び出して、彼らの前に戯れ事をさせた。彼らがサムソンを柱のあいだに立たせると、"},{"ref":"Judg.16.26","start":7016026,"end":7016026,"break":"none","ruby":[[5,2,"じぶん"],[8,1,"て"],[15,2,"わかもの"],[18,1,"い"],[27,1,"て"],[29,1,"はな"],[35,1,"いえ"],[43,1,"はしら"],[53,1,"よ"]],"text":"サムソンは自分の手をひいている若者に言った、「わたしの手を放して、この家をささえている柱をさぐらせ、それに寄りかからせてください」。"},{"ref":"Judg.16.27","start":7016027,"end":7016027,"break":"none","ruby":[[2,1,"いえ"],[5,2,"だんじょ"],[8,1,"み"],[18,1,"きみ"],[22,1,"みな"],[31,2,"やね"],[34,1,"うえ"],[39,1,"にん"],[44,2,"だんじょ"],[55,1,"ざ"],[57,1,"ごと"],[63,1,"み"]],"text":"その家には男女が満ち、ペリシテびとの君たちも皆そこにいた。また屋根の上には三千人ばかりの男女がいて、サムソンの戯れ事をするのを見ていた。"},{"ref":"Judg.16.28","start":7016028,"end":7016028,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,1,"よ"],[12,1,"い"],[20,1,"しゅ"],[23,1,"かみ"],[34,1,"おぼ"],[45,1,"かみ"],[54,1,"ど"],[60,1,"つよ"],[72,1,"め"],[92,1,"むく"]],"text":"サムソンは主に呼ばわって言った、「ああ、主なる神よ、どうぞ、わたしを覚えてください。ああ、神よ、どうぞもう一度、わたしを強くして、わたしの二つの目の一つのためにでもペリシテびとにあだを報いさせてください」。"},{"ref":"Judg.16.29","start":7016029,"end":7016029,"break":"none","ruby":[[11,1,"いえ"],[22,1,"なか"],[23,1,"はしら"],[28,1,"みぎ"],[30,1,"て"],[36,1,"ひだり"],[38,1,"て"],[45,1,"み"],[50,1,"よ"]],"text":"そしてサムソンは、その家をささえている二つの中柱の一つを右の手に、一つを左の手にかかえて、身をそれに寄せ、"},{"ref":"Judg.16.30","start":7016030,"end":7016030,"break":"none","ruby":[[12,1,"とも"],[14,1,"し"],[19,1,"い"],[23,1,"ちから"],[28,1,"み"],[36,1,"いえ"],[40,1,"なか"],[44,1,"きみ"],[53,1,"たみ"],[55,1,"うえ"],[57,1,"たお"],[70,1,"し"],[75,1,"ころ"],[82,1,"い"],[90,1,"ころ"],[98,1,"おお"]],"text":"「わたしはペリシテびとと共に死のう」と言って、力をこめて身をかがめると、家はその中にいた君たちと、すべての民の上に倒れた。こうしてサムソンが死ぬときに殺したものは、生きているときに殺したものよりも多かった。"},{"ref":"Judg.16.31","start":7016031,"end":7016031,"break":"none","ruby":[[3,1,"かれ"],[5,2,"みうち"],[8,1,"ひと"],[14,1,"ちち"],[16,2,"かぞく"],[19,1,"もの"],[23,1,"くだ"],[29,1,"かれ"],[31,1,"ひ"],[33,1,"と"],[36,1,"たずさ"],[38,1,"のぼ"],[51,1,"あいだ"],[55,1,"ちち"],[60,1,"はか"],[62,1,"ほうむ"],[85,1,"ねん"]],"text":"やがて彼の身内の人たちおよび父の家族の者がみな下ってきて、彼を引き取り、携え上って、ゾラとエシタオルの間にある父マノアの墓に葬った。サムソンがイスラエルをさばいたのは二十年であった。"}]