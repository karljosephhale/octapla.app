[{"ref":"Job.17.1","start":18017001,"end":18017001,"break":"paragraph","breaks":[[14,"line"]],"ruby":[[2,1,"れい"],[4,1,"やぶ"],[9,1,"ひ"],[11,1,"つ"],[14,1,"はか"],[20,1,"ま"]],"text":"わが霊は破れ、わが日は尽き、墓はわたしを待っている。"},{"ref":"Job.17.2","start":18017002,"end":18017002,"break":"line","breaks":[[23,"line"]],"ruby":[[8,1,"もの"],[25,1,"め"],[27,1,"つね"],[29,1,"かれ"],[32,1,"あなど"],[35,1,"み"]],"text":"まことにあざける者どもはわたしのまわりにあり、わが目は常に彼らの侮りを見る。"},{"ref":"Job.17.3","start":18017003,"end":18017003,"break":"line","breaks":[[20,"line"],[33,"line"]],"ruby":[[7,1,"みずか"],[9,2,"ほしょう"],[33,2,"ほしょう"],[42,1,"もの"]],"text":"どうか、あなた自ら保証となられるように。ほかにだれがわたしのために保証となってくれる者があろうか。"},{"ref":"Job.17.4","start":18017004,"end":18017004,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[4,1,"かれ"],[7,1,"こころ"],[9,1,"と"],[13,1,"さと"],[32,1,"かれ"],[35,2,"しょうり"],[38,1,"え"]],"text":"あなたは彼らの心を閉じて、悟ることのないようにされた。それゆえ、彼らに勝利を得させられるはずはない。"},{"ref":"Job.17.5","start":18017005,"end":18017005,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"わ"],[2,1,"まえ"],[4,1,"え"],[9,1,"とも"],[11,1,"うった"],[20,1,"こ"],[23,1,"め"]],"text":"分け前を得るために友を訴えるものは、その子らの目がつぶれるであろう。"},{"ref":"Job.17.6","start":18017006,"end":18017006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[6,1,"たみ"],[8,1,"わら"],[10,1,"ぐさ"],[20,1,"かお"],[28,1,"もの"]],"text":"彼はわたしを民の笑い草とされた。わたしは顔につばきされる者となる。"},{"ref":"Job.17.7","start":18017007,"end":18017007,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"め"],[4,1,"うれ"],[23,1,"かげ"]],"text":"わが目は憂いによってかすみ、わがからだはすべて影のようだ。"},{"ref":"Job.17.8","start":18017008,"end":18017008,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[8,1,"おどろ"],[11,1,"つみ"],[14,1,"もの"],[16,1,"かみ"],[18,1,"しん"],[21,1,"もの"],[23,1,"たい"],[26,1,"いきどお"]],"text":"正しい者はこれに驚き、罪なき者は神を信ぜぬ者に対して憤る。"},{"ref":"Job.17.9","start":18017009,"end":18017009,"break":"line","breaks":[[20,"line"]],"ruby":[[6,1,"ただ"],[9,1,"もの"],[13,1,"みち"],[15,1,"かた"],[17,1,"たも"],[20,1,"いさぎよ"],[22,1,"て"],[26,1,"もの"],[32,1,"ちから"],[34,1,"え"]],"text":"それでもなお正しい者はその道を堅く保ち、潔い手をもつ者はますます力を得る。"},{"ref":"Job.17.10","start":18017010,"end":18017010,"break":"line","breaks":[[19,"line"]],"ruby":[[10,1,"みな"],[11,1,"ふたた"],[13,1,"く"],[32,1,"かしこ"],[34,1,"もの"],[36,1,"み"]],"text":"しかし、あなたがたは皆再び来るがよい、わたしはあなたがたのうちに賢い者を見ないのだ。"},{"ref":"Job.17.11","start":18017011,"end":18017011,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"ひ"],[4,1,"す"],[6,1,"さ"],[11,1,"はか"],[16,1,"やぶ"],[21,1,"こころ"],[23,1,"ねが"],[26,1,"やぶ"]],"text":"わが日は過ぎ去り、わが計りごとは敗れ、わが心の願いも敗れた。"},{"ref":"Job.17.12","start":18017012,"end":18017012,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[3,1,"よる"],[5,1,"ひる"],[7,1,"か"],[11,1,"かれ"],[14,1,"い"],[18,1,"ひかり"],[20,1,"くら"],[24,1,"ちか"]],"text":"彼らは夜を昼に変える。彼らは言う、『光が暗やみに近づいている』と。"},{"ref":"Job.17.13","start":18017013,"end":18017013,"break":"line","breaks":[[20,"line"]],"ruby":[[6,2,"よみ"],[13,1,"いえ"],[17,1,"のぞ"],[20,1,"くら"],[24,2,"ねどこ"]],"text":"わたしがもし陰府をわたしの家として望み、暗やみに寝床をのべ、"},{"ref":"Job.17.14","start":18017014,"end":18017014,"break":"line","breaks":[[24,"line"],[42,"line"]],"ruby":[[0,1,"あな"],[2,1,"む"],[15,1,"ちち"],[21,1,"い"],[27,1,"む"],[40,1,"はは"],[46,2,"しまい"],[53,1,"い"]],"text":"穴に向かって『あなたはわたしの父である』と言い、うじに向かって『あなたはわたしの母、わたしの姉妹である』と言うならば、"},{"ref":"Job.17.15","start":18017015,"end":18017015,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"のぞ"],[21,1,"のぞ"],[24,1,"み"]],"text":"わたしの望みはどこにあるか、だれがわたしの望みを見ることができようか。"},{"ref":"Job.17.16","start":18017016,"end":18017016,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"くだ"],[6,2,"よみ"],[9,2,"かんもん"],[21,1,"とも"],[26,1,"くだ"]],"text":"これは下って陰府の関門にいたり、われわれは共にちりに下るであろうか」。"}]