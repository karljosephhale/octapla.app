[{"ref":"Job.14.1","start":18014001,"end":18014001,"break":"paragraph","breaks":[[8,"line"]],"ruby":[[0,1,"おんな"],[3,1,"うま"],[6,1,"ひと"],[8,1,"ひ"],[10,1,"みじか"],[13,1,"なや"],[16,1,"み"]],"text":"女から生れる人は日が短く、悩みに満ちている。"},{"ref":"Job.14.2","start":18014002,"end":18014002,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[2,1,"はな"],[7,1,"さ"],[9,1,"で"],[11,1,"か"],[14,1,"かげ"],[19,1,"と"],[21,1,"さ"]],"text":"彼は花のように咲き出て枯れ、影のように飛び去って、とどまらない。"},{"ref":"Job.14.3","start":18014003,"end":18014003,"break":"line","breaks":[[18,"line"]],"ruby":[[9,1,"もの"],[13,1,"め"],[15,1,"ひら"],[22,1,"まえ"],[24,1,"ひ"],[26,1,"だ"]],"text":"あなたはこのような者にさえ目を開き、あなたの前に引き出して、さばかれるであろうか。"},{"ref":"Job.14.4","start":18014004,"end":18014004,"break":"line","breaks":[[18,"line"]],"ruby":[[3,1,"けが"],[13,1,"きよ"],[18,1,"だ"]],"text":"だれが汚れたもののうちから清いものを出すことができようか、ひとりもない。"},{"ref":"Job.14.5","start":18014005,"end":18014005,"break":"line","breaks":[[9,"line"],[24,"line"],[37,"line"]],"ruby":[[2,1,"ひ"],[4,1,"さだ"],[11,1,"つき"],[13,1,"かず"],[19,1,"とも"],[30,1,"かぎ"],[33,1,"さだ"],[37,1,"こ"]],"text":"その日は定められ、その月の数もあなたと共にあり、あなたがその限りを定めて、越えることのできないようにされたのだから、"},{"ref":"Job.14.6","start":18014006,"end":18014006,"break":"line","breaks":[[19,"line"],[33,"line"]],"ruby":[[0,1,"かれ"],[3,1,"め"],[9,1,"て"],[24,1,"かれ"],[26,2,"やといにん"],[35,1,"ひ"],[37,1,"たの"]],"text":"彼から目をはなし、手をひいてください。そうすれば彼は雇人のように、その日を楽しむことができるでしょう。"},{"ref":"Job.14.7","start":18014007,"end":18014007,"break":"stanza","breaks":[[9,"line"],[24,"line"]],"ruby":[[0,1,"き"],[3,1,"のぞ"],[12,1,"き"],[19,1,"め"],[26,1,"わか"],[27,1,"えだ"],[29,1,"た"]],"text":"木には望みがある。たとい切られてもまた芽をだし、その若枝は絶えることがない。"},{"ref":"Job.14.8","start":18014008,"end":18014008,"break":"line","breaks":[[14,"line"]],"ruby":[[5,1,"ね"],[7,1,"ち"],[9,1,"なか"],[11,1,"お"],[16,1,"みき"],[18,1,"つち"],[20,1,"なか"],[22,1,"か"]],"text":"たといその根が地の中に老い、その幹が土の中に枯れても、"},{"ref":"Job.14.9","start":18014009,"end":18014009,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"みず"],[4,1,"うるお"],[10,1,"め"],[15,2,"わかぎ"],[21,1,"えだ"],[23,1,"だ"]],"text":"なお水の潤いにあえば芽をふき、若木のように枝を出す。"},{"ref":"Job.14.10","start":18014010,"end":18014010,"break":"line","breaks":[[14,"line"]],"ruby":[[3,1,"ひと"],[5,1,"し"],[8,1,"き"],[14,1,"いき"],[16,1,"た"]],"text":"しかし人は死ねば消えうせる。息が絶えれば、どこにおるか。"},{"ref":"Job.14.11","start":18014011,"end":18014011,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"みず"],[2,1,"みずうみ"],[5,1,"き"],[8,1,"かわ"]],"text":"水が湖から消え、川がかれて、かわくように、"},{"ref":"Job.14.12","start":18014012,"end":18014012,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[0,1,"ひと"],[2,1,"ふ"],[5,1,"ね"],[9,1,"お"],[13,1,"てん"],[21,1,"め"],[28,1,"ねむ"]],"text":"人は伏して寝、また起きず、天のつきるまで、目ざめず、その眠りからさまされない。"},{"ref":"Job.14.13","start":18014013,"end":18014013,"break":"line","breaks":[[15,"line"],[31,"line"],[44,"line"]],"ruby":[[8,2,"よみ"],[19,1,"いか"],[27,1,"ひそ"],[38,1,"とき"],[40,1,"さだ"],[48,1,"おぼ"]],"text":"どうぞ、わたしを陰府にかくし、あなたの怒りのやむまで、潜ませ、わたしのために時を定めて、わたしを覚えてください。"},{"ref":"Job.14.14","start":18014014,"end":18014014,"break":"line","breaks":[[19,"line"],[33,"line"]],"ruby":[[0,1,"ひと"],[4,1,"し"],[10,1,"い"],[25,2,"ふくえき"],[28,1,"しょ"],[29,1,"にち"],[31,1,"あいだ"],[35,2,"かいほう"],[38,1,"く"],[42,1,"ま"]],"text":"人がもし死ねば、また生きるでしょうか。わたしはわが服役の諸日の間、わが解放の来るまで待つでしょう。"},{"ref":"Job.14.15","start":18014015,"end":18014015,"break":"line","breaks":[[13,"line"],[25,"line"]],"ruby":[[5,1,"およ"],[17,1,"こた"],[30,1,"て"],[35,1,"かえり"]],"text":"あなたがお呼びになるとき、わたしは答えるでしょう。あなたはみ手のわざを顧みられるでしょう。"},{"ref":"Job.14.16","start":18014016,"end":18014016,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"とき"],[11,1,"あゆ"],[14,1,"かぞ"],[21,1,"つみ"],[23,1,"み"]],"text":"その時あなたはわたしの歩みを数え、わたしの罪を見のがされるでしょう。"},{"ref":"Job.14.17","start":18014017,"end":18014017,"break":"line","breaks":[[16,"line"]],"ruby":[[7,1,"ふくろ"],[9,1,"なか"],[11,1,"ふう"],[24,1,"つみ"],[26,1,"ぬ"]],"text":"わたしのとがは袋の中に封じられ、あなたはわたしの罪を塗りかくされるでしょう。"},{"ref":"Job.14.18","start":18014018,"end":18014018,"break":"stanza","breaks":[[12,"line"]],"ruby":[[3,1,"やま"],[5,1,"たお"],[12,1,"いわ"],[16,1,"ところ"],[19,1,"うつ"]],"text":"しかし山は倒れてくずれ、岩もその所から移される。"},{"ref":"Job.14.19","start":18014019,"end":18014019,"break":"line","breaks":[[8,"line"],[21,"line"]],"ruby":[[0,1,"みず"],[2,1,"いし"],[8,2,"おおみず"],[11,1,"ち"],[16,1,"あら"],[18,1,"さ"],[30,1,"ひと"],[32,1,"のぞ"],[35,1,"た"]],"text":"水は石をうがち、大水は地のちりを洗い去る。このようにあなたは人の望みを断たれる。"},{"ref":"Job.14.20","start":18014020,"end":18014020,"break":"line","breaks":[[21,"line"]],"ruby":[[7,1,"かれ"],[9,1,"か"],[13,1,"かれ"],[15,1,"さ"],[17,1,"い"],[21,1,"かれ"],[23,1,"かお"],[28,1,"かわ"],[32,1,"お"]],"text":"あなたはながく彼に勝って、彼を去り行かせ、彼の顔かたちを変らせて追いやられる。"},{"ref":"Job.14.21","start":18014021,"end":18014021,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[2,1,"こ"],[5,1,"たっと"],[12,1,"かれ"],[17,1,"し"],[22,1,"いや"],[33,1,"さと"]],"text":"彼の子らは尊くなっても、彼はそれを知らない、卑しくなっても、それを悟らない。"},{"ref":"Job.14.22","start":18014022,"end":18014022,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"み"],[7,1,"いた"],[10,1,"おぼ"],[20,1,"なげ"]],"text":"ただおのが身に痛みを覚え、おのれのために嘆くのみである」。"}]