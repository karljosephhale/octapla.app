[{"ref":"Prov.20.1","start":20020001,"end":20020001,"break":"paragraph","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"さけ"],[2,1,"ひと"],[8,1,"もの"],[12,1,"こ"],[14,1,"さけ"],[16,1,"ひと"],[21,1,"もの"],[29,1,"まよ"],[34,1,"もの"],[36,2,"むち"]],"text":"酒は人をあざける者とし、濃い酒は人をあばれ者とする、これに迷わされる者は無知である。"},{"ref":"Prov.20.2","start":20020002,"end":20020002,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"おう"],[2,1,"いか"],[16,1,"かれ"],[18,1,"いか"],[22,1,"もの"],[24,2,"じぶん"],[27,1,"いのち"]],"text":"王の怒りは、ししがほえるようだ、彼を怒らせる者は自分の命をそこなう。"},{"ref":"Prov.20.3","start":20020003,"end":20020003,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あらそ"],[3,2,"かんけい"],[11,1,"ひと"],[13,1,"ほまれ"],[21,1,"おろ"],[24,1,"もの"],[26,1,"いか"],[28,1,"あらそ"]],"text":"争いに関係しないことは人の誉である、すべて愚かな者は怒り争う。"},{"ref":"Prov.20.4","start":20020004,"end":20020004,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"もの"],[5,1,"さむ"],[10,1,"たがや"],[19,2,"かりい"],[30,1,"もと"],[34,1,"なに"]],"text":"なまけ者は寒いときに耕さない、それゆえ刈入れのときになって、求めても何もない。"},{"ref":"Prov.20.5","start":20020005,"end":20020005,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ひと"],[2,1,"こころ"],[6,1,"はか"],[11,1,"ふか"],[13,2,"いど"],[16,1,"みず"],[29,1,"ひと"],[36,1,"だ"]],"text":"人の心にある計りごとは深い井戸の水のようだ、しかし、さとき人はこれをくみ出す。"},{"ref":"Prov.20.6","start":20020006,"end":20020006,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"じぶん"],[3,2,"しんじつ"],[9,1,"ひと"],[11,1,"おお"],[21,2,"ちゅうしん"],[24,1,"ひと"],[26,1,"あ"]],"text":"自分は真実だという人が多い、しかし、だれが忠信な人に会うであろうか。"},{"ref":"Prov.20.7","start":20020007,"end":20020007,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"か"],[3,1,"ところ"],[7,1,"ただ"],[10,1,"あゆ"],[12,1,"ひと"],[17,1,"のち"],[19,2,"しそん"]],"text":"欠けた所なく、正しく歩む人――その後の子孫はさいわいである。"},{"ref":"Prov.20.8","start":20020008,"end":20020008,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"ざ"],[9,1,"おう"],[13,1,"め"],[23,1,"あく"]],"text":"さばきの座にすわる王はその目をもって、すべての悪をふるいわける。"},{"ref":"Prov.20.9","start":20020009,"end":20020009,"break":"line","breaks":[[17,"line"]],"ruby":[[8,2,"じぶん"],[11,1,"こころ"],[13,1,"きよ"],[21,1,"つみ"],[23,1,"きよ"]],"text":"だれが「わたしは自分の心を清めた、わたしの罪は清められた」ということができようか。"},{"ref":"Prov.20.10","start":20020010,"end":20020010,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"たがい"],[2,1,"ちが"],[6,1,"しゅ"],[13,1,"しゅ"],[23,1,"しゅ"],[25,1,"にく"]],"text":"互に違った二種のはかり、二種のますは、ひとしく主に憎まれる。"},{"ref":"Prov.20.11","start":20020011,"end":20020011,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"おさ"],[2,1,"ご"],[10,1,"おこな"],[16,1,"みずか"],[19,1,"しめ"],[29,1,"きよ"],[32,1,"ただ"],[37,1,"あらわ"]],"text":"幼な子でさえも、その行いによって自らを示し、そのすることの清いか正しいかを現す。"},{"ref":"Prov.20.12","start":20020012,"end":20020012,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"き"],[2,1,"みみ"],[5,1,"み"],[7,1,"め"],[14,1,"しゅ"],[16,1,"つく"]],"text":"聞く耳と、見る目とは、ともに主が造られたものである。"},{"ref":"Prov.20.13","start":20020013,"end":20020013,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"ねむ"],[3,1,"あい"],[17,1,"まず"],[23,1,"め"],[25,1,"ひら"],[36,1,"あ"]],"text":"眠りを愛してはならない、そうすれば貧しくなる、目を開け、そうすればパンに飽くことができる。"},{"ref":"Prov.20.14","start":20020014,"end":20020014,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"か"],[2,1,"もの"],[6,1,"わる"],[9,1,"わる"],[19,1,"さ"],[22,1,"のち"],[24,1,"かれ"],[26,1,"みずか"],[28,1,"ほこ"]],"text":"買う者は、「悪い、悪い」という、しかし去って後、彼は自ら誇る。"},{"ref":"Prov.20.15","start":20020015,"end":20020015,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"きん"],[5,1,"あたい"],[7,1,"たか"],[9,2,"ほうせき"],[12,1,"おお"],[18,1,"たっと"],[20,1,"うつわ"],[22,2,"ちしき"]],"text":"金もあり、価の高い宝石も多くあるが、尊い器は知識のくちびるである。"},{"ref":"Prov.20.16","start":20020016,"end":20020016,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"ひと"],[5,2,"ほしょう"],[9,1,"もの"],[18,2,"きもの"],[21,1,"と"],[24,2,"たにん"],[30,2,"ほしょう"],[34,1,"もの"],[37,2,"ていとう"],[40,1,"と"]],"text":"人のために保証する者からは、まずその着物を取れ、他人のために保証する者をば抵当に取れ。"},{"ref":"Prov.20.17","start":20020017,"end":20020017,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"あざむ"],[2,1,"と"],[16,1,"のち"],[21,1,"くち"],[23,2,"じゃり"],[26,1,"み"]],"text":"欺き取ったパンはおいしい、しかし後にはその口は砂利で満たされる。"},{"ref":"Prov.20.18","start":20020018,"end":20020018,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"はか"],[5,1,"とも"],[7,1,"ぎ"],[16,1,"な"],[19,1,"たたか"],[33,1,"ぎ"]],"text":"計りごとは共に議することによって成る、戦おうとするならば、まずよく議しなければならない。"},{"ref":"Prov.20.19","start":20020019,"end":20020019,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"ある"],[6,1,"ひと"],[15,1,"もの"],[17,2,"ひみつ"],[29,1,"ひら"],[32,1,"ある"],[34,1,"もの"],[36,1,"まじ"]],"text":"歩きまわって人のよしあしをいう者は秘密をもらす、くちびるを開いて歩く者と交わってはならない。"},{"ref":"Prov.20.20","start":20020020,"end":20020020,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"じぶん"],[3,2,"ふぼ"],[10,1,"もの"],[20,1,"くら"],[24,1,"なか"],[26,1,"き"]],"text":"自分の父母をののしる者は、そのともしびは暗やみの中に消える。"},{"ref":"Prov.20.21","start":20020021,"end":20020021,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"はじ"],[3,1,"いそ"],[6,1,"え"],[8,2,"しさん"],[14,1,"おわ"]],"text":"初めに急いで得た資産は、その終りがさいわいでない。"},{"ref":"Prov.20.22","start":20020022,"end":20020022,"break":"line","breaks":[[21,"line"]],"ruby":[[5,1,"あく"],[7,1,"むく"],[12,1,"い"],[21,1,"しゅ"],[23,1,"ま"],[25,1,"のぞ"],[28,1,"しゅ"],[34,1,"たす"]],"text":"「わたしが悪に報いる」と言ってはならない、主を待ち望め、主はあなたを助けられる。"},{"ref":"Prov.20.23","start":20020023,"end":20020023,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"たがい"],[2,1,"ちが"],[6,1,"しゅ"],[13,1,"しゅ"],[15,1,"にく"],[20,1,"いつわ"],[27,1,"よ"]],"text":"互に違った二種のふんどうは主に憎まれる、偽りのはかりは良くない。"},{"ref":"Prov.20.24","start":20020024,"end":20020024,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[0,1,"ひと"],[2,1,"あゆ"],[5,1,"しゅ"],[10,1,"さだ"],[16,1,"ひと"],[22,1,"みずか"],[26,1,"みち"],[29,1,"あき"]],"text":"人の歩みは主によって定められる、人はどうして自らその道を、明らかにすることができようか。"},{"ref":"Prov.20.25","start":20020025,"end":20020025,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[0,2,"かるがる"],[8,1,"せい"],[14,1,"もの"],[18,1,"い"],[23,1,"ちか"],[26,1,"た"],[29,1,"のち"],[31,1,"かんが"],[40,1,"ひと"]],"text":"軽々しく「これは聖なるささげ物だ」と言い、また誓いを立てて後に考えることは、その人のわなとなる。"},{"ref":"Prov.20.26","start":20020026,"end":20020026,"break":"line","breaks":[[7,"line"],[28,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"おう"],[7,1,"みの"],[15,1,"わ"],[21,2,"あくにん"],[24,1,"ち"],[28,1,"くるま"],[33,2,"だっこく"],[44,1,"ばっ"]],"text":"知恵ある王は、箕をもってあおぎ分けるように悪人を散らし、車をもって脱穀するように、これを罰する。"},{"ref":"Prov.20.27","start":20020027,"end":20020027,"break":"line","ruby":[[0,1,"ひと"],[2,1,"たましい"],[4,1,"しゅ"],[14,1,"ひと"],[16,1,"こころ"],[18,1,"おく"],[20,1,"さぐ"]],"text":"人の魂は主のともしびであり、人の心の奥を探る。"},{"ref":"Prov.20.28","start":20020028,"end":20020028,"break":"line","breaks":[[17,"line"]],"ruby":[[12,1,"おう"],[14,1,"まも"],[19,1,"くらい"],[23,2,"せいぎ"],[29,1,"たも"]],"text":"いつくしみと、まこととは王を守る、その位もまた正義によって保たれる。"},{"ref":"Prov.20.29","start":20020029,"end":20020029,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"わか"],[2,1,"ひと"],[4,1,"さか"],[9,1,"ちから"],[11,2,"ろうじん"],[14,1,"うつく"]],"text":"若い人の栄えはその力、老人の美しさはそのしらがである。"},{"ref":"Prov.20.30","start":20020030,"end":20020030,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"きず"],[6,1,"う"],[9,1,"わる"],[11,1,"ところ"],[13,1,"きよ"],[21,1,"う"],[24,1,"こころ"],[26,1,"そこ"],[30,1,"きよ"]],"text":"傷つくまでに打てば悪い所は清くなり、むちで打てば心の底までも清まる。"}]