[{"ref":"Ezek.14.1","start":26014001,"end":26014001,"break":"paragraph","ruby":[[9,2,"ちょうろう"],[17,2,"ひとびと"],[25,1,"ところ"],[27,1,"き"],[34,1,"まえ"],[36,1,"ざ"]],"text":"ここにイスラエルの長老のうちのある人々が、わたしの所に来て、わたしの前に座した。"},{"ref":"Ezek.14.2","start":26014002,"end":26014002,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,2,"ことば"],[12,1,"のぞ"]],"text":"時に主の言葉が、わたしに臨んだ、"},{"ref":"Ezek.14.3","start":26014003,"end":26014003,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,2,"ひとびと"],[16,2,"ぐうぞう"],[19,1,"こころ"],[21,1,"なか"],[23,1,"も"],[26,1,"つみ"],[28,1,"おと"],[45,1,"かお"],[47,1,"まえ"],[49,1,"お"],[63,1,"かれ"],[66,1,"ねが"]],"text":"「人の子よ、これらの人々は、その偶像を心の中に持ち、罪に落しいれるところのつまずきを、その顔の前に置いている。わたしはどうして彼らの願いをいれることができようか。"},{"ref":"Ezek.14.4","start":26014004,"end":26014004,"break":"none","ruby":[[4,1,"かれ"],[7,1,"つ"],[10,1,"い"],[13,1,"しゅ"],[16,1,"かみ"],[21,1,"い"],[32,1,"いえ"],[34,2,"ひとびと"],[40,2,"ぐうぞう"],[43,1,"こころ"],[45,1,"なか"],[47,1,"も"],[52,1,"かお"],[54,1,"まえ"],[56,1,"つみ"],[58,1,"おと"],[74,1,"お"],[80,3,"よげんしゃ"],[87,1,"く"],[89,1,"もの"],[95,1,"おお"],[98,2,"ぐうぞう"],[105,1,"しゅ"],[120,1,"こたえ"]],"text":"それゆえ彼らに告げて言え、主なる神は、こう言われる、イスラエルの家の人々で、その偶像を心の中に持ち、その顔の前に罪に落しいれるところのつまずくものを置きながら、預言者のもとに来る者には、その多くの偶像のゆえに、主なるわたしは、みずからこれに答をする。"},{"ref":"Ezek.14.5","start":26014005,"end":26014005,"break":"none","ruby":[[5,2,"ぐうぞう"],[19,1,"はな"],[28,1,"いえ"],[30,1,"こころ"],[37,1,"とら"]],"text":"これはその偶像のために、すべてわたしを離れたイスラエルの家の心を、わたしが捕えるためである。"},{"ref":"Ezek.14.6","start":26014006,"end":26014006,"break":"paragraph","ruby":[[10,1,"いえ"],[12,1,"い"],[15,1,"しゅ"],[18,1,"かみ"],[22,1,"い"],[33,1,"く"],[43,2,"ぐうぞう"],[46,1,"す"],[56,1,"かお"],[65,1,"にく"]],"text":"それゆえイスラエルの家に言え、主なる神はこう言われる、あなたがたは悔いて、あなたがたの偶像を捨てよ。あなたがたの顔を、そのすべての憎むべきものからそむけよ。"},{"ref":"Ezek.14.7","start":26014007,"end":26014007,"break":"none","ruby":[[6,1,"いえ"],[8,1,"もの"],[18,1,"やど"],[20,2,"がいこく"],[22,1,"じん"],[34,1,"はな"],[39,1,"こころ"],[41,2,"ぐうぞう"],[44,1,"も"],[49,1,"かお"],[51,1,"まえ"],[53,1,"つみ"],[55,1,"おと"],[69,1,"お"],[75,3,"よげんしゃ"],[79,1,"き"],[82,1,"こころ"],[91,1,"もと"],[98,1,"しゅ"],[114,1,"こたえ"]],"text":"イスラエルの家の者およびイスラエルに宿る外国人のだれでも、わたしから離れ、その心に偶像を持ち、その顔の前に罪に落しいれるところのつまずきを置きながら、預言者に来て、心のままにわたしに求めるときは、主であるわたしは、みずからこれに答をする。"},{"ref":"Ezek.14.8","start":26014008,"end":26014008,"break":"none","ruby":[[8,1,"かお"],[13,1,"ひと"],[15,1,"む"],[18,1,"かれ"],[41,1,"たみ"],[47,1,"た"],[49,1,"ほろ"],[55,1,"とき"],[67,1,"しゅ"],[74,1,"し"]],"text":"わたしはわたしの顔を、その人に向け、彼を、しるし、およびことわざとなし、これをわが民のうちから断ち滅ぼす。その時、あなたがたはわたしが主であることを知るようになる。"},{"ref":"Ezek.14.9","start":26014009,"end":26014009,"break":"none","ruby":[[2,3,"よげんしゃ"],[6,1,"あざむ"],[10,2,"ことば"],[13,1,"だ"],[25,1,"しゅ"],[36,3,"よげんしゃ"],[40,1,"あざむ"],[52,1,"て"],[54,1,"かれ"],[56,1,"うえ"],[58,1,"の"],[63,1,"たみ"],[74,1,"かれ"],[76,1,"ほろ"]],"text":"もし預言者が欺かれて言葉を出すことがあれば、それは主であるわたしが、その預言者を欺いたのである。わたしは手を彼の上に伸べ、わが民イスラエルのうちから彼を滅ぼす。"},{"ref":"Ezek.14.10","start":26014010,"end":26014010,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ばつ"],[7,1,"お"],[12,3,"よげんしゃ"],[16,1,"ばつ"],[19,1,"と"],[21,1,"もと"],[24,1,"もの"],[26,1,"ばつ"],[28,2,"どうよう"]],"text":"彼らはその罰を負う。その預言者の罰は、問い求める者の罰と同様である。"},{"ref":"Ezek.14.11","start":26014011,"end":26014011,"break":"none","ruby":[[9,1,"いえ"],[12,1,"かさ"],[19,1,"はな"],[22,1,"まよ"],[26,1,"かさ"],[47,1,"けが"],[56,1,"かれ"],[61,1,"たみ"],[70,1,"かれ"],[73,1,"かみ"],[84,1,"しゅ"],[87,1,"かみ"],[89,1,"い"]],"text":"これはイスラエルの家が、重ねてわたしを離れて迷わず、重ねてそのもろもろのとがによって、おのれを汚さないため、また彼らがわが民となり、わたしが彼らの神となるためであると、主なる神は言われる」。"},{"ref":"Ezek.14.12","start":26014012,"end":26014012,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[12,1,"のぞ"]],"text":"主の言葉が、またわたしに臨んだ、"},{"ref":"Ezek.14.13","start":26014013,"end":26014013,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[8,1,"くに"],[22,1,"つみ"],[24,1,"おか"],[33,1,"うえ"],[35,1,"て"],[37,1,"の"],[52,1,"くだ"],[62,1,"おく"],[65,1,"ひと"],[67,1,"けもの"],[76,1,"た"],[78,1,"とき"]],"text":"「人の子よ、もし国がわたしに、もとりそむいて罪を犯し、わたしがその上に手を伸べて、そのつえとたのむパンを砕き、これにききんを送り、人と獣とをそのうちから断つ時、"},{"ref":"Ezek.14.14","start":26014014,"end":26014014,"break":"none","ruby":[[18,1,"にん"],[24,1,"かれ"],[29,1,"ぎ"],[37,2,"じぶん"],[40,1,"いのち"],[42,1,"すく"],[53,1,"しゅ"],[56,1,"かみ"],[58,1,"い"]],"text":"たといそこにノア、ダニエル、ヨブの三人がいても、彼らはその義によって、ただ自分の命を救いうるのみであると、主なる神は言われる。"},{"ref":"Ezek.14.15","start":26014015,"end":26014015,"break":"none","ruby":[[6,1,"の"],[8,1,"けもの"],[12,1,"ち"],[14,1,"とお"],[21,1,"あら"],[28,1,"あ"],[30,1,"ち"],[37,1,"けもの"],[45,1,"とお"],[47,1,"もの"]],"text":"もしわたしが野の獣にこの地を通らせ、これを荒させ、これを荒れ地となし、その獣のためにそこを通る者がないようにしたなら、"},{"ref":"Ezek.14.16","start":26014016,"end":26014016,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[14,1,"い"],[27,1,"にん"],[29,1,"もの"],[33,1,"なか"],[44,1,"むすめ"],[46,1,"すく"],[58,2,"じぶん"],[60,2,"じしん"],[63,1,"すく"],[73,1,"ち"],[75,1,"あ"],[77,1,"ち"]],"text":"主なる神は言われる、わたしは生きている、たといこれら三人の者がその中にいても、そのむすこ娘を救うことはできない。ただ自分自身を救いうるのみで、その地は荒れ地となる。"},{"ref":"Ezek.14.17","start":26014017,"end":26014017,"break":"none","ruby":[[18,1,"ち"],[20,1,"のぞ"],[31,1,"ち"],[33,1,"ゆ"],[39,1,"い"],[43,1,"ひと"],[45,1,"けもの"],[52,1,"た"]],"text":"あるいは、わたしがもし、つるぎをその地に臨ませ、つるぎよ、この地を行きめぐれと言って、人と獣とをそこから断つならば、"},{"ref":"Ezek.14.18","start":26014018,"end":26014018,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[14,1,"い"],[27,1,"にん"],[29,1,"もの"],[33,1,"なか"],[44,1,"むすめ"],[46,1,"すく"],[58,2,"じぶん"],[60,2,"じしん"],[63,1,"すく"]],"text":"主なる神は言われる、わたしは生きている、たといこれら三人の者がその中にいても、そのむすこ娘を救うことはできない。ただ自分自身を救いうるのみである。"},{"ref":"Ezek.14.19","start":26014019,"end":26014019,"break":"none","ruby":[[14,1,"ち"],[16,2,"えきびょう"],[19,1,"おく"],[22,1,"ち"],[29,1,"いきどお"],[34,1,"うえ"],[36,1,"そそ"],[39,1,"ひと"],[41,1,"けもの"],[48,1,"た"]],"text":"あるいは、わたしがもし、この地に疫病を送り、血をもってわが憤りをその上に注ぎ、人と獣とをそこから断つならば、"},{"ref":"Ezek.14.20","start":26014020,"end":26014020,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[14,1,"い"],[41,1,"かれ"],[49,1,"むすめ"],[51,1,"すく"],[65,1,"ぎ"],[70,2,"じぶん"],[73,1,"いのち"],[75,1,"すく"]],"text":"主なる神は言われる、わたしは生きている、たといノア、ダニエル、ヨブがそこにいても、彼らはそのむすこ娘を救うことができない。ただその義によって自分の命を救いうるのみである。"},{"ref":"Ezek.14.21","start":26014021,"end":26014021,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[16,1,"ひと"],[18,1,"けもの"],[21,1,"ち"],[24,1,"た"],[40,1,"あ"],[43,1,"けもの"],[46,2,"えきびょう"],[57,1,"ばつ"],[65,1,"おく"],[67,1,"とき"]],"text":"主なる神はこう言われる、わたしが人と獣とを地から断つために、つるぎと、ききんと、悪しき獣と、疫病との四つのきびしい罰をエルサレムに送る時はどうであろうか。"},{"ref":"Ezek.14.22","start":26014022,"end":26014022,"break":"none","ruby":[[15,1,"く"],[23,1,"むすめ"],[27,1,"たす"],[29,1,"だ"],[31,1,"もの"],[36,1,"なか"],[38,1,"のこ"],[52,1,"おこな"],[60,1,"み"],[76,1,"うえ"],[78,1,"あた"],[85,1,"わざわい"],[90,1,"なぐさ"]],"text":"しかし、もしそれがあなたがたに来るとき、むすこ娘たちを助け出す者が、その中に残っていて、あなたがたがその行いと、わざとを見るならば、わたしがエルサレムの上に与えたすべての災について慰められるであろう。"},{"ref":"Ezek.14.23","start":26014023,"end":26014023,"break":"none","ruby":[[14,1,"おこな"],[22,1,"み"],[24,1,"とき"],[26,1,"かれ"],[35,1,"なぐさ"],[51,1,"おこな"],[54,1,"こと"],[74,1,"し"],[83,1,"しゅ"],[86,1,"かみ"],[88,1,"い"]],"text":"すなわち、あなたがたが、その行いと、わざとを見る時、彼らはあなたがたを慰め、あなたがたはわたしがこれに行った事は、すべてゆえなくしたのではないことを知るようになると、主なる神は言われる」。"}]