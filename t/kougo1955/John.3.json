[{"ref":"John.3.1","start":43003001,"end":43003001,"break":"paragraph","ruby":[[4,1,"びと"],[13,1,"な"],[25,1,"じん"],[27,3,"しどうしゃ"]],"text":"パリサイ人のひとりで、その名をニコデモというユダヤ人の指導者があった。"},{"ref":"John.3.2","start":43003002,"end":43003002,"break":"none","ruby":[[2,1,"ひと"],[4,1,"よる"],[14,1,"い"],[19,2,"せんせい"],[32,1,"かみ"],[39,2,"きょうし"],[47,1,"し"],[54,1,"かみ"],[57,2,"いっしょ"]],"text":"この人が夜イエスのもとにきて言った、「先生、わたしたちはあなたが神からこられた教師であることを知っています。神がご一緒でないなら、あなたがなさっておられるようなしるしは、だれにもできはしません」。"},{"ref":"John.3.3","start":43003003,"end":43003003,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[21,1,"い"],[31,1,"あたら"],[34,1,"うま"],[41,1,"かみ"],[43,1,"くに"],[45,1,"み"]],"text":"イエスは答えて言われた、「よくよくあなたに言っておく。だれでも新しく生れなければ、神の国を見ることはできない」。"},{"ref":"John.3.4","start":43003004,"end":43003004,"break":"none","ruby":[[5,1,"い"],[10,1,"ひと"],[12,1,"とし"],[19,1,"うま"],[38,2,"いちど"],[41,1,"はは"],[43,1,"たい"],[49,1,"うま"]],"text":"ニコデモは言った、「人は年をとってから生れることが、どうしてできますか。もう一度、母の胎にはいって生れることができましょうか」。"},{"ref":"John.3.5","start":43003005,"end":43003005,"break":"none","ruby":[[4,1,"こた"],[19,1,"い"],[30,1,"みず"],[32,1,"れい"],[36,1,"うま"],[43,1,"かみ"],[45,1,"くに"]],"text":"イエスは答えられた、「よくよくあなたに言っておく。だれでも、水と霊とから生れなければ、神の国にはいることはできない。"},{"ref":"John.3.6","start":43003006,"end":43003006,"break":"none","ruby":[[0,1,"にく"],[3,1,"うま"],[6,1,"もの"],[8,1,"にく"],[13,1,"れい"],[16,1,"うま"],[19,1,"もの"],[21,1,"れい"]],"text":"肉から生れる者は肉であり、霊から生れる者は霊である。"},{"ref":"John.3.7","start":43003007,"end":43003007,"break":"none","ruby":[[6,1,"あたら"],[9,1,"うま"],[25,1,"い"],[33,3,"ふしぎ"],[37,1,"おも"],[41,1,"およ"]],"text":"あなたがたは新しく生れなければならないと、わたしが言ったからとて、不思議に思うには及ばない。"},{"ref":"John.3.8","start":43003008,"end":43003008,"break":"none","ruby":[[0,1,"かぜ"],[2,1,"おも"],[8,1,"ふ"],[17,1,"おと"],[19,1,"き"],[36,1,"い"],[40,1,"し"],[45,1,"れい"],[48,1,"うま"],[51,1,"もの"],[59,1,"おな"]],"text":"風は思いのままに吹く。あなたはその音を聞くが、それがどこからきて、どこへ行くかは知らない。霊から生れる者もみな、それと同じである」。"},{"ref":"John.3.9","start":43003009,"end":43003009,"break":"none","ruby":[[9,1,"こた"],[12,1,"い"],[30,1,"え"]],"text":"ニコデモはイエスに答えて言った、「どうして、そんなことがあり得ましょうか」。"},{"ref":"John.3.10","start":43003010,"end":43003010,"break":"none","ruby":[[4,1,"かれ"],[6,1,"こた"],[9,1,"い"],[25,2,"きょうし"]],"text":"イエスは彼に答えて言われた、「あなたはイスラエルの教師でありながら、これぐらいのことがわからないのか。"},{"ref":"John.3.11","start":43003011,"end":43003011,"break":"none","ruby":[[4,1,"い"],[16,2,"じぶん"],[19,1,"し"],[27,1,"かた"],[32,2,"じぶん"],[35,1,"み"],[66,1,"う"]],"text":"よくよく言っておく。わたしたちは自分の知っていることを語り、また自分の見たことをあかししているのに、あなたがたはわたしたちのあかしを受けいれない。"},{"ref":"John.3.12","start":43003012,"end":43003012,"break":"none","ruby":[[4,2,"ちじょう"],[10,1,"かた"],[24,1,"しん"],[32,2,"てんじょう"],[38,1,"かた"],[41,2,"ばあい"],[51,1,"しん"]],"text":"わたしが地上のことを語っているのに、あなたがたが信じないならば、天上のことを語った場合、どうしてそれを信じるだろうか。"},{"ref":"John.3.13","start":43003013,"end":43003013,"break":"none","ruby":[[0,1,"てん"],[3,1,"くだ"],[8,1,"もの"],[14,1,"ひと"],[16,1,"こ"],[26,1,"てん"],[28,1,"のぼ"],[31,1,"もの"]],"text":"天から下ってきた者、すなわち人の子のほかには、だれも天に上った者はない。"},{"ref":"John.3.14","start":43003014,"end":43003014,"break":"none","ruby":[[12,2,"あらの"],[18,1,"あ"],[25,1,"ひと"],[27,1,"こ"],[31,1,"あ"]],"text":"そして、ちょうどモーセが荒野でへびを上げたように、人の子もまた上げられなければならない。"},{"ref":"John.3.15","start":43003015,"end":43003015,"break":"none","ruby":[[3,1,"かれ"],[5,1,"しん"],[8,1,"もの"],[14,2,"えいえん"],[17,1,"いのち"],[19,1,"え"]],"text":"それは彼を信じる者が、すべて永遠の命を得るためである」。"},{"ref":"John.3.16","start":43003016,"end":43003016,"break":"paragraph","ruby":[[0,1,"かみ"],[7,1,"こ"],[9,1,"たま"],[19,1,"よ"],[21,1,"あい"],[24,1,"くだ"],[32,2,"みこ"],[35,1,"しん"],[38,1,"もの"],[44,1,"ほろ"],[50,2,"えいえん"],[53,1,"いのち"],[55,1,"え"]],"text":"神はそのひとり子を賜わったほどに、この世を愛して下さった。それは御子を信じる者がひとりも滅びないで、永遠の命を得るためである。"},{"ref":"John.3.17","start":43003017,"end":43003017,"break":"none","ruby":[[0,1,"かみ"],[2,2,"みこ"],[5,1,"よ"],[16,1,"よ"],[28,2,"みこ"],[37,1,"よ"],[39,1,"すく"]],"text":"神が御子を世につかわされたのは、世をさばくためではなく、御子によって、この世が救われるためである。"},{"ref":"John.3.18","start":43003018,"end":43003018,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しん"],[5,1,"もの"],[15,1,"しん"],[19,1,"もの"],[33,1,"かみ"],[38,1,"こ"],[40,1,"な"],[42,1,"しん"]],"text":"彼を信じる者は、さばかれない。信じない者は、すでにさばかれている。神のひとり子の名を信じることをしないからである。"},{"ref":"John.3.19","start":43003019,"end":43003019,"break":"none","ruby":[[11,1,"ひかり"],[15,1,"よ"],[22,2,"ひとびと"],[32,1,"わる"],[38,1,"ひかり"],[45,1,"ほう"],[47,1,"あい"]],"text":"そのさばきというのは、光がこの世にきたのに、人々はそのおこないが悪いために、光よりもやみの方を愛したことである。"},{"ref":"John.3.20","start":43003020,"end":43003020,"break":"none","ruby":[[0,1,"あく"],[2,1,"おこな"],[7,1,"もの"],[11,1,"ひかり"],[13,1,"にく"],[27,1,"あか"],[31,1,"だ"],[37,1,"おそ"],[41,1,"ひかり"]],"text":"悪を行っている者はみな光を憎む。そして、そのおこないが明るみに出されるのを恐れて、光にこようとはしない。"},{"ref":"John.3.21","start":43003021,"end":43003021,"break":"none","ruby":[[4,2,"しんり"],[7,1,"おこな"],[12,1,"もの"],[14,1,"ひかり"],[16,1,"く"],[21,1,"ひと"],[29,1,"かみ"],[45,1,"あき"]],"text":"しかし、真理を行っている者は光に来る。その人のおこないの、神にあってなされたということが、明らかにされるためである。"},{"ref":"John.3.22","start":43003022,"end":43003022,"break":"paragraph","ruby":[[9,2,"でし"],[18,1,"ち"],[20,1,"い"],[23,1,"かれ"],[26,2,"いっしょ"],[32,2,"たいざい"],[43,1,"さづ"]],"text":"こののち、イエスは弟子たちとユダヤの地に行き、彼らと一緒にそこに滞在して、バプテスマを授けておられた。"},{"ref":"John.3.23","start":43003023,"end":43003023,"break":"none","ruby":[[8,1,"ちか"],[22,1,"さづ"],[32,1,"みず"],[47,2,"ひとびと"],[66,1,"う"]],"text":"ヨハネもサリムに近いアイノンで、バプテスマを授けていた。そこには水がたくさんあったからである。人々がぞくぞくとやってきてバプテスマを受けていた。"},{"ref":"John.3.24","start":43003024,"end":43003024,"break":"none","ruby":[[11,1,"ごく"],[13,1,"い"]],"text":"そのとき、ヨハネはまだ獄に入れられてはいなかった。"},{"ref":"John.3.25","start":43003025,"end":43003025,"break":"none","ruby":[[9,2,"でし"],[21,1,"じん"],[24,1,"あいだ"],[34,2,"そうろん"],[37,1,"おこ"]],"text":"ところが、ヨハネの弟子たちとひとりのユダヤ人との間に、きよめのことで争論が起った。"},{"ref":"John.3.26","start":43003026,"end":43003026,"break":"none","ruby":[[3,1,"かれ"],[16,1,"い"],[21,2,"せんせい"],[27,1,"くだ"],[36,1,"む"],[44,2,"いっしょ"],[85,1,"さづ"],[91,1,"みな"],[93,1,"もの"],[105,1,"で"]],"text":"そこで彼らはヨハネのところにきて言った、「先生、ごらん下さい。ヨルダンの向こうであなたと一緒にいたことがあり、そして、あなたがあかしをしておられたあのかたが、バプテスマを授けており、皆の者が、そのかたのところへ出かけています」。"},{"ref":"John.3.27","start":43003027,"end":43003027,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[12,1,"ひと"],[14,1,"てん"],[17,1,"あた"],[26,1,"なに"],[30,1,"う"]],"text":"ヨハネは答えて言った、「人は天から与えられなければ、何ものも受けることはできない。"},{"ref":"John.3.28","start":43003028,"end":43003028,"break":"none","ruby":[[21,1,"さき"],[29,1,"もの"],[35,1,"い"],[57,2,"じしん"]],"text":"『わたしはキリストではなく、そのかたよりも先につかわされた者である』と言ったことをあかししてくれるのは、あなたがた自身である。"},{"ref":"John.3.29","start":43003029,"end":43003029,"break":"none","ruby":[[0,2,"はなよめ"],[5,1,"もの"],[7,2,"はなむこ"],[13,2,"はなむこ"],[16,2,"ゆうじん"],[19,1,"た"],[22,1,"かれ"],[24,1,"こえ"],[26,1,"き"],[31,1,"こえ"],[33,1,"き"],[36,1,"おお"],[39,1,"よろこ"],[49,1,"よろこ"],[56,1,"み"],[58,1,"た"]],"text":"花嫁をもつ者は花婿である。花婿の友人は立って彼の声を聞き、その声を聞いて大いに喜ぶ。こうして、この喜びはわたしに満ち足りている。"},{"ref":"John.3.30","start":43003030,"end":43003030,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かなら"],[4,1,"さか"],[11,1,"おとろ"]],"text":"彼は必ず栄え、わたしは衰える。"},{"ref":"John.3.31","start":43003031,"end":43003031,"break":"paragraph","ruby":[[0,1,"うえ"],[3,1,"く"],[5,1,"もの"],[15,1,"うえ"],[20,1,"ち"],[23,1,"で"],[25,1,"もの"],[28,1,"ち"],[30,1,"ぞく"],[33,1,"もの"],[39,1,"ち"],[44,1,"かた"],[47,1,"てん"],[50,1,"く"],[52,1,"もの"],[62,1,"うえ"]],"text":"上から来る者は、すべてのものの上にある。地から出る者は、地に属する者であって、地のことを語る。天から来る者は、すべてのものの上にある。"},{"ref":"John.3.32","start":43003032,"end":43003032,"break":"none","ruby":[[0,1,"かれ"],[4,1,"み"],[10,1,"き"],[35,1,"う"]],"text":"彼はその見たところ、聞いたところをあかししているが、だれもそのあかしを受けいれない。"},{"ref":"John.3.33","start":43003033,"end":43003033,"break":"none","ruby":[[10,1,"う"],[15,1,"もの"],[18,1,"かみ"],[34,1,"みと"]],"text":"しかし、そのあかしを受けいれる者は、神がまことであることを、たしかに認めたのである。"},{"ref":"John.3.34","start":43003034,"end":43003034,"break":"none","ruby":[[0,1,"かみ"],[15,1,"かみ"],[17,2,"ことば"],[20,1,"かた"],[23,1,"かみ"],[25,2,"せいれい"],[28,1,"かぎ"],[32,1,"たま"]],"text":"神がおつかわしになったかたは、神の言葉を語る。神は聖霊を限りなく賜うからである。"},{"ref":"John.3.35","start":43003035,"end":43003035,"break":"none","ruby":[[0,1,"ちち"],[2,2,"みこ"],[5,1,"あい"],[9,2,"ばんぶつ"],[14,1,"て"],[17,1,"あた"]],"text":"父は御子を愛して、万物をその手にお与えになった。"},{"ref":"John.3.36","start":43003036,"end":43003036,"break":"none","ruby":[[0,2,"みこ"],[3,1,"しん"],[6,1,"もの"],[8,2,"えいえん"],[11,1,"いのち"],[16,2,"みこ"],[19,1,"したが"],[23,1,"もの"],[26,1,"いのち"],[42,1,"かみ"],[44,1,"いか"],[49,1,"うえ"]],"text":"御子を信じる者は永遠の命をもつ。御子に従わない者は、命にあずかることがないばかりか、神の怒りがその上にとどまるのである」。"}]