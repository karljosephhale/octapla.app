[{"ref":"Deut.25.1","start":5025001,"end":5025001,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"ひと"],[5,1,"あいだ"],[7,1,"あらそ"],[9,1,"こと"],[19,1,"もと"],[42,1,"ただ"],[45,1,"もの"],[47,1,"ただ"],[53,1,"わる"],[55,1,"もの"],[57,1,"わる"]],"text":"人と人との間に争い事があって、さばきを求めてきたならば、さばきびとはこれをさばいて、正しい者を正しいとし、悪い者を悪いとしなければならない。"},{"ref":"Deut.25.2","start":5025002,"end":5025002,"break":"none","ruby":[[2,1,"わる"],[4,1,"もの"],[9,1,"う"],[13,1,"もの"],[27,1,"かれ"],[29,1,"ふ"],[33,2,"じぶん"],[36,1,"まえ"],[41,1,"つみ"],[48,1,"かぞ"],[51,1,"かれ"],[55,1,"う"]],"text":"その悪い者が、むち打つべき者であるならば、さばきびとは彼を伏させ、自分の前で、その罪にしたがい、数えて彼をむち打たせなければならない。"},{"ref":"Deut.25.3","start":5025003,"end":5025003,"break":"none","ruby":[[0,1,"かれ"],[4,1,"う"],[11,1,"こ"],[25,1,"こ"],[34,1,"おお"],[39,1,"う"],[49,2,"きょうだい"],[56,1,"め"],[58,1,"まえ"]],"text":"彼をむち打つには四十を越えてはならない。もしそれを越えて、それよりも多くむちを打つときは、あなたの兄弟はあなたの目の前で、はずかしめられることになるであろう。"},{"ref":"Deut.25.4","start":5025004,"end":5025004,"break":"paragraph","ruby":[[0,2,"だっこく"],[5,1,"うし"],[11,1,"か"]],"text":"脱穀をする牛にくつこを掛けてはならない。"},{"ref":"Deut.25.5","start":5025005,"end":5025005,"break":"paragraph","ruby":[[0,2,"きょうだい"],[3,2,"いっしょ"],[6,1,"す"],[21,1,"し"],[24,1,"こ"],[28,1,"とき"],[33,1,"し"],[36,1,"もの"],[38,1,"つま"],[40,1,"で"],[43,2,"たにん"],[58,1,"おっと"],[60,2,"きょうだい"],[63,2,"かのじょ"],[66,1,"ところ"],[76,1,"つま"],[80,1,"おっと"],[82,2,"きょうだい"],[88,1,"みち"],[90,2,"かのじょ"]],"text":"兄弟が一緒に住んでいて、そのうちのひとりが死んで子のない時は、その死んだ者の妻は出て、他人にとついではならない。その夫の兄弟が彼女の所にはいり、めとって妻とし、夫の兄弟としての道を彼女につくさなければならない。"},{"ref":"Deut.25.6","start":5025006,"end":5025006,"break":"none","ruby":[[5,1,"おんな"],[7,1,"はじ"],[10,1,"う"],[12,1,"おとこ"],[14,1,"こ"],[17,1,"し"],[20,2,"きょうだい"],[23,1,"な"],[25,1,"つ"],[31,1,"な"],[42,1,"た"]],"text":"そしてその女が初めに産む男の子に、死んだ兄弟の名を継がせ、その名をイスラエルのうちに絶やさないようにしなければならない。"},{"ref":"Deut.25.7","start":5025007,"end":5025007,"break":"none","ruby":[[5,1,"ひと"],[7,2,"きょうだい"],[10,1,"つま"],[17,1,"この"],[27,2,"きょうだい"],[30,1,"つま"],[32,1,"まち"],[34,1,"もん"],[36,1,"い"],[40,2,"ちょうろう"],[45,1,"い"],[61,1,"おっと"],[63,2,"きょうだい"],[68,2,"きょうだい"],[71,1,"な"],[82,1,"のこ"],[86,1,"こば"],[90,1,"おっと"],[92,2,"きょうだい"],[98,1,"みち"],[106,1,"この"]],"text":"しかしその人が兄弟の妻をめとるのを好まないならば、その兄弟の妻は町の門へ行って、長老たちに言わなければならない、『わたしの夫の兄弟はその兄弟の名をイスラエルのうちに残すのを拒んで、夫の兄弟としての道をつくすことを好みません』。"},{"ref":"Deut.25.8","start":5025008,"end":5025008,"break":"none","ruby":[[4,1,"まち"],[6,2,"ちょうろう"],[11,1,"かれ"],[13,1,"よ"],[15,1,"よ"],[33,1,"かれ"],[35,2,"こしつ"],[45,2,"かのじょ"],[54,1,"この"],[61,1,"い"]],"text":"そのとき町の長老たちは彼を呼び寄せて、さとさなければならない。もし彼が固執して、『わたしは彼女をめとることを好みません』と言うならば、"},{"ref":"Deut.25.9","start":5025009,"end":5025009,"break":"none","ruby":[[2,2,"きょうだい"],[5,1,"つま"],[7,2,"ちょうろう"],[12,1,"め"],[14,1,"まえ"],[17,1,"かれ"],[22,1,"い"],[27,1,"あし"],[32,1,"ぬ"],[38,1,"かお"],[46,1,"こた"],[49,1,"い"],[61,2,"きょうだい"],[64,1,"いえ"],[70,1,"もの"]],"text":"その兄弟の妻は長老たちの目の前で、彼のそばに行き、その足のくつを脱がせ、その顔につばきして、答えて言わなければならない。『兄弟の家をたてない者には、このようにすべきです』。"},{"ref":"Deut.25.10","start":5025010,"end":5025010,"break":"none","ruby":[[3,1,"かれ"],[5,1,"いえ"],[7,1,"な"],[13,1,"ぬ"],[18,1,"もの"],[20,1,"いえ"],[32,1,"よ"]],"text":"そして彼の家の名は、くつを脱がされた者の家と、イスラエルのうちで呼ばれるであろう。"},{"ref":"Deut.25.11","start":5025011,"end":5025011,"break":"paragraph","ruby":[[4,1,"ひと"],[6,1,"たがい"],[8,1,"あらそ"],[20,1,"ひと"],[22,1,"つま"],[25,1,"う"],[27,1,"もの"],[29,1,"て"],[32,1,"おっと"],[34,1,"すく"],[40,1,"ちか"],[44,1,"て"],[46,1,"の"],[52,1,"ひと"],[54,1,"かく"],[56,1,"ところ"]],"text":"ふたりの人が互に争うときに、そのひとりの人の妻が、打つ者の手から夫を救おうとして近づき、手を伸べて、その人の隠し所をつかまえるならば、"},{"ref":"Deut.25.12","start":5025012,"end":5025012,"break":"none","ruby":[[2,1,"おんな"],[4,1,"て"],[6,1,"き"],[8,1,"おと"]],"text":"その女の手を切り落さなければならない。あわれみをかけてはならない。"},{"ref":"Deut.25.13","start":5025013,"end":5025013,"break":"paragraph","ruby":[[4,1,"ふくろ"],[6,2,"だいしょう"],[9,1,"しゅ"],[11,1,"おも"],[13,1,"いし"],[15,1,"い"]],"text":"あなたの袋に大小二種の重り石を入れておいてはならない。"},{"ref":"Deut.25.14","start":5025014,"end":5025014,"break":"none","ruby":[[4,1,"いえ"],[6,2,"だいしょう"],[9,1,"しゅ"]],"text":"あなたの家に大小二種のますをおいてはならない。"},{"ref":"Deut.25.15","start":5025015,"end":5025015,"break":"none","ruby":[[0,2,"ふそく"],[5,1,"ただ"],[8,1,"おも"],[10,1,"いし"],[12,1,"も"],[17,2,"ふそく"],[22,1,"ただ"],[28,1,"も"],[48,1,"かみ"],[50,1,"しゅ"],[52,1,"たま"],[55,1,"ち"],[62,1,"なが"],[64,1,"いのち"],[66,1,"たも"]],"text":"不足のない正しい重り石を持ち、また不足のない正しいますを持たなければならない。そうすればあなたの神、主が賜わる地で、あなたは長く命を保つことができるであろう。"},{"ref":"Deut.25.16","start":5025016,"end":5025016,"break":"none","ruby":[[8,2,"ふせい"],[13,1,"もの"],[20,1,"かみ"],[22,1,"しゅ"],[24,1,"にく"]],"text":"すべてこのような不正をする者を、あなたの神、主が憎まれるからである。"},{"ref":"Deut.25.17","start":5025017,"end":5025017,"break":"paragraph","ruby":[[10,1,"で"],[14,1,"とき"],[16,1,"みち"],[34,2,"きおく"]],"text":"あなたがエジプトから出てきた時、道でアマレクびとがあなたにしたことを記憶しなければならない。"},{"ref":"Deut.25.18","start":5025018,"end":5025018,"break":"none","ruby":[[4,1,"かれ"],[7,1,"みち"],[13,2,"であ"],[23,1,"つか"],[28,1,"とき"],[45,1,"よわ"],[50,1,"もの"],[52,1,"せ"],[54,1,"う"],[63,1,"かれ"],[66,1,"かみ"],[68,1,"おそ"]],"text":"すなわち彼らは道であなたに出会い、あなたがうみ疲れている時、うしろについてきていたすべての弱っている者を攻め撃った。このように彼らは神を恐れなかった。"},{"ref":"Deut.25.19","start":5025019,"end":5025019,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"し"],[13,1,"ぎょう"],[17,1,"たま"],[20,1,"ち"],[27,1,"かみ"],[29,1,"しゅ"],[35,2,"しゅうい"],[42,1,"てき"],[44,2,"せいふく"],[53,2,"あんそく"],[56,1,"あた"],[61,1,"とき"],[72,1,"な"],[74,1,"てん"],[76,1,"した"],[79,1,"け"],[81,1,"さ"],[94,1,"こと"],[96,1,"わす"]],"text":"それで、あなたの神、主が嗣業として賜わる地で、あなたの神、主があなたの周囲のすべての敵を征服して、あなたに安息を与えられる時、あなたはアマレクの名を天の下から消し去らなければならない。この事を忘れてはならない。"}]