[{"ref":"Ps.22.1","start":19022001,"end":19022001,"break":"paragraph","title":"聖歌隊の指揮者によってあけぼののめじかのしらべにあわせてうたわせたダビデの歌","breaks":[[8,"line"],[26,"line"],[43,"line"]],"ruby":[[2,1,"かみ"],[6,1,"かみ"],[16,1,"す"],[30,1,"とお"],[32,1,"はな"],[39,1,"たす"],[47,1,"なげ"],[50,2,"ことば"],[53,1,"き"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[37,1,"うた"]],"text":"わが神、わが神、なにゆえわたしを捨てられるのですか。なにゆえ遠く離れてわたしを助けず、わたしの嘆きの言葉を聞かれないのですか。"},{"ref":"Ps.22.2","start":19022002,"end":19022002,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[2,1,"かみ"],[9,1,"ひる"],[21,1,"こた"],[27,1,"よる"],[34,2,"へいあん"],[37,1,"え"]],"text":"わが神よ、わたしが昼よばわっても、あなたは答えられず、夜よばわっても平安を得ません。"},{"ref":"Ps.22.3","start":19022003,"end":19022003,"break":"line","breaks":[[22,"line"]],"ruby":[[13,1,"うえ"],[15,1,"ざ"],[26,1,"せい"]],"text":"しかしイスラエルのさんびの上に座しておられるあなたは聖なるおかたです。"},{"ref":"Ps.22.4","start":19022004,"end":19022004,"break":"line","breaks":[[20,"line"]],"ruby":[[4,2,"せんぞ"],[13,2,"しんらい"],[20,1,"かれ"],[23,2,"しんらい"],[34,1,"かれ"],[37,1,"たす"]],"text":"われらの先祖たちはあなたに信頼しました。彼らが信頼したので、あなたは彼らを助けられました。"},{"ref":"Ps.22.5","start":19022005,"end":19022005,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[7,1,"よ"],[12,1,"すく"],[20,2,"しんらい"],[24,1,"はじ"]],"text":"彼らはあなたに呼ばわって救われ、あなたに信頼して恥をうけなかったのです。"},{"ref":"Ps.22.6","start":19022006,"end":19022006,"break":"line","breaks":[[20,"line"]],"ruby":[[8,1,"むし"],[14,1,"ひと"],[20,1,"ひと"],[27,1,"たみ"],[29,1,"あなど"]],"text":"しかし、わたしは虫であって、人ではない。人にそしられ、民に侮られる。"},{"ref":"Ps.22.7","start":19022007,"end":19022007,"break":"line","breaks":[[21,"line"]],"ruby":[[7,1,"み"],[9,1,"もの"],[18,1,"あざわら"],[26,1,"つ"],[28,1,"だ"],[35,1,"ふ"],[37,1,"うご"],[41,1,"い"]],"text":"すべてわたしを見る者は、わたしをあざ笑い、くちびるを突き出し、かしらを振り動かして言う、"},{"ref":"Ps.22.8","start":19022008,"end":19022008,"break":"line","breaks":[[22,"line"]],"ruby":[[1,1,"かれ"],[3,1,"しゅ"],[5,1,"み"],[12,1,"しゅ"],[14,1,"かれ"],[16,1,"たす"],[22,1,"しゅ"],[24,1,"かれ"],[26,1,"よろこ"],[33,1,"しゅ"],[35,1,"かれ"],[37,1,"すく"]],"text":"「彼は主に身をゆだねた、主に彼を助けさせよ。主は彼を喜ばれるゆえ、主に彼を救わせよ」と。"},{"ref":"Ps.22.9","start":19022009,"end":19022009,"break":"line","breaks":[[17,"line"]],"ruby":[[12,1,"うま"],[17,1,"はは"],[28,1,"やす"],[32,1,"まも"],[36,1,"かた"]],"text":"しかし、あなたはわたしを生れさせ、母のふところにわたしを安らかに守られた方です。"},{"ref":"Ps.22.10","start":19022010,"end":19022010,"break":"line","breaks":[[24,"line"],[37,"line"]],"ruby":[[4,1,"うま"],[7,1,"とき"],[24,1,"はは"],[26,1,"たい"],[28,1,"で"],[45,1,"かみ"]],"text":"わたしは生れた時から、あなたにゆだねられました。母の胎を出てからこのかた、あなたはわたしの神でいらせられました。"},{"ref":"Ps.22.11","start":19022011,"end":19022011,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"とお"],[6,1,"はな"],[16,1,"なや"],[19,1,"ちか"],[23,1,"たす"],[26,1,"もの"]],"text":"わたしを遠く離れないでください。悩みが近づき、助ける者がないのです。"},{"ref":"Ps.22.12","start":19022012,"end":19022012,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おお"],[3,2,"おうし"],[10,1,"と"],[12,1,"ま"],[20,1,"つよ"],[22,2,"おうし"],[29,1,"かこ"]],"text":"多くの雄牛はわたしを取り巻き、バシャンの強い雄牛はわたしを囲み、"},{"ref":"Ps.22.13","start":19022013,"end":19022013,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"さ"],[25,1,"くち"],[27,1,"ひら"]],"text":"かき裂き、ほえたけるししのように、わたしにむかって口を開く。"},{"ref":"Ps.22.14","start":19022014,"end":19022014,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[4,1,"みず"],[9,1,"そそ"],[11,1,"だ"],[19,1,"ほね"],[34,2,"しんぞう"],[45,1,"むね"],[50,1,"と"]],"text":"わたしは水のように注ぎ出され、わたしの骨はことごとくはずれ、わたしの心臓は、ろうのように、胸のうちで溶けた。"},{"ref":"Ps.22.15","start":19022015,"end":19022015,"break":"line","breaks":[[19,"line"],[31,"line"]],"ruby":[[4,1,"ちから"],[6,2,"とうき"],[9,2,"はへん"],[23,1,"した"],[39,1,"し"],[44,1,"ふ"]],"text":"わたしの力は陶器の破片のようにかわき、わたしの舌はあごにつく。あなたはわたしを死のちりに伏させられる。"},{"ref":"Ps.22.16","start":19022016,"end":19022016,"break":"line","breaks":[[15,"line"],[32,"line"]],"ruby":[[5,1,"いぬ"],[15,1,"あく"],[17,1,"おこな"],[19,1,"もの"],[21,1,"む"],[28,1,"かこ"],[36,1,"て"],[38,1,"あし"],[40,1,"さ"],[42,1,"つらぬ"]],"text":"まことに、犬はわたしをめぐり、悪を行う者の群れがわたしを囲んで、わたしの手と足を刺し貫いた。"},{"ref":"Ps.22.17","start":19022017,"end":19022017,"break":"line","breaks":[[24,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"ほね"],[14,1,"かぞ"],[24,1,"かれ"],[27,1,"め"],[37,1,"み"]],"text":"わたしは自分の骨をことごとく数えることができる。彼らは目をとめて、わたしを見る。"},{"ref":"Ps.22.18","start":19022018,"end":19022018,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"たがい"],[9,2,"いふく"],[12,1,"わ"],[19,2,"きもの"],[24,1,"びき"]],"text":"彼らは互にわたしの衣服を分け、わたしの着物をくじ引にする。"},{"ref":"Ps.22.19","start":19022019,"end":19022019,"break":"line","breaks":[[18,"line"]],"ruby":[[3,1,"しゅ"],[6,1,"とお"],[8,1,"はな"],[20,1,"ちから"],[23,1,"はや"],[25,1,"き"],[32,1,"たす"]],"text":"しかし主よ、遠く離れないでください。わが力よ、速く来てわたしをお助けください。"},{"ref":"Ps.22.20","start":19022020,"end":19022020,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"たましい"],[20,1,"いぬ"],[22,1,"ちから"],[25,1,"たす"],[27,1,"だ"]],"text":"わたしの魂をつるぎから、わたしのいのちを犬の力から助け出してください。"},{"ref":"Ps.22.21","start":19022021,"end":19022021,"break":"line","breaks":[[11,"line"]],"ruby":[[7,1,"くち"],[11,1,"くる"],[16,1,"たましい"],[18,2,"のうし"],[21,1,"つの"],[24,1,"すく"],[26,1,"だ"]],"text":"わたしをししの口から、苦しむわが魂を野牛の角から救い出してください。"},{"ref":"Ps.22.22","start":19022022,"end":19022022,"break":"line","breaks":[[19,"line"]],"ruby":[[9,1,"な"],[11,2,"きょうだい"],[16,1,"つ"],[19,2,"かいしゅう"],[22,1,"なか"]],"text":"わたしはあなたのみ名を兄弟たちに告げ、会衆の中であなたをほめたたえるでしょう。"},{"ref":"Ps.22.23","start":19022023,"end":19022023,"break":"line","breaks":[[17,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[5,1,"もの"],[8,1,"しゅ"],[30,1,"しゅ"],[52,1,"しゅ"]],"text":"主を恐れる者よ、主をほめたたえよ。ヤコブのもろもろのすえよ、主をあがめよ。イスラエルのもろもろのすえよ、主をおじおそれよ。"},{"ref":"Ps.22.24","start":19022024,"end":19022024,"break":"line","breaks":[[22,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"くる"],[5,1,"もの"],[7,1,"くる"],[28,1,"かお"],[30,1,"かく"],[39,1,"さけ"],[44,1,"き"]],"text":"主が苦しむ者の苦しみをかろんじ、いとわれず、またこれにみ顔を隠すことなく、その叫ぶときに聞かれたからである。"},{"ref":"Ps.22.25","start":19022025,"end":19022025,"break":"line","breaks":[[10,"line"],[29,"line"],[43,"line"]],"ruby":[[0,1,"おお"],[4,2,"かいしゅう"],[7,1,"なか"],[23,1,"で"],[33,1,"しゅ"],[35,1,"おそ"],[38,1,"もの"],[40,1,"まえ"],[47,1,"ちか"],[50,1,"はた"]],"text":"大いなる会衆の中で、わたしのさんびはあなたから出るのです。わたしは主を恐れる者の前で、わたしの誓いを果します。"},{"ref":"Ps.22.26","start":19022026,"end":19022026,"break":"line","breaks":[[16,"line"],[38,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[5,1,"た"],[8,1,"あ"],[16,1,"しゅ"],[18,1,"たず"],[20,1,"もと"],[23,1,"もの"],[25,1,"しゅ"],[48,1,"こころ"],[55,1,"い"]],"text":"貧しい者は食べて飽くことができ、主を尋ね求める者は主をほめたたえるでしょう。どうか、あなたがたの心がとこしえに生きるように。"},{"ref":"Ps.22.27","start":19022027,"end":19022027,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[0,1,"ち"],[5,1,"もの"],[9,1,"おも"],[11,1,"だ"],[15,1,"しゅ"],[17,1,"かえ"],[25,1,"くに"],[35,1,"まえ"],[37,1,"ふ"],[39,1,"おが"]],"text":"地のはての者はみな思い出して、主に帰り、もろもろの国のやからはみな、み前に伏し拝むでしょう。"},{"ref":"Ps.22.28","start":19022028,"end":19022028,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"くに"],[2,1,"しゅ"],[11,1,"しゅ"],[18,2,"くにたみ"],[21,1,"す"],[23,1,"おさ"]],"text":"国は主のものであって、主はもろもろの国民を統べ治められます。"},{"ref":"Ps.22.29","start":19022029,"end":19022029,"break":"line","breaks":[[16,"line"],[24,"line"],[42,"line"]],"ruby":[[0,1,"ち"],[2,1,"ほこ"],[4,1,"たか"],[7,1,"もの"],[11,1,"しゅ"],[13,1,"おが"],[19,1,"くだ"],[21,1,"もの"],[28,1,"い"],[39,1,"もの"],[47,1,"まえ"]],"text":"地の誇り高ぶる者はみな主を拝み、ちりに下る者も、おのれを生きながらえさせえない者も、みなそのみ前にひざまずくでしょう。"},{"ref":"Ps.22.30","start":19022030,"end":19022030,"break":"line","breaks":[[10,"line"]],"ruby":[[0,4,"ししそんそん"],[5,1,"しゅ"],[7,1,"つか"],[10,2,"ひとびと"],[13,1,"しゅ"],[23,1,"よ"],[26,1,"かた"],[28,1,"つた"]],"text":"子々孫々、主に仕え、人々は主のことをきたるべき代まで語り伝え、"},{"ref":"Ps.22.31","start":19022031,"end":19022031,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"すくい"],[10,1,"のち"],[12,1,"うま"],[15,1,"たみ"],[19,1,"つた"]],"text":"主がなされたその救を後に生れる民にのべ伝えるでしょう。"}]