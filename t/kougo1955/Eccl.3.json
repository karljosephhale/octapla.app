[{"ref":"Eccl.3.1","start":21003001,"end":21003001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[0,1,"あめ"],[2,1,"した"],[8,1,"こと"],[11,2,"きせつ"],[25,1,"とき"]],"text":"天が下のすべての事には季節があり、すべてのわざには時がある。"},{"ref":"Eccl.3.2","start":21003002,"end":21003002,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"うま"],[4,1,"とき"],[9,1,"し"],[13,1,"とき"],[18,1,"う"],[22,1,"とき"],[27,1,"う"],[33,1,"ぬ"],[36,1,"とき"]],"text":"生るるに時があり、死ぬるに時があり、植えるに時があり、植えたものを抜くに時があり、"},{"ref":"Eccl.3.3","start":21003003,"end":21003003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ころ"],[3,1,"とき"],[12,1,"とき"],[21,1,"とき"],[26,1,"た"],[30,1,"とき"]],"text":"殺すに時があり、いやすに時があり、こわすに時があり、建てるに時があり、"},{"ref":"Eccl.3.4","start":21003004,"end":21003004,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"な"],[3,1,"とき"],[8,1,"わら"],[11,1,"とき"],[16,1,"かな"],[20,1,"とき"],[25,1,"おど"],[28,1,"とき"]],"text":"泣くに時があり、笑うに時があり、悲しむに時があり、踊るに時があり、"},{"ref":"Eccl.3.5","start":21003005,"end":21003005,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"いし"],[2,1,"な"],[6,1,"とき"],[11,1,"いし"],[13,1,"あつ"],[17,1,"とき"],[22,1,"だ"],[25,1,"とき"],[30,1,"だ"],[39,1,"とき"]],"text":"石を投げるに時があり、石を集めるに時があり、抱くに時があり、抱くことをやめるに時があり、"},{"ref":"Eccl.3.6","start":21003006,"end":21003006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"さが"],[3,1,"とき"],[8,1,"うしな"],[11,1,"とき"],[16,1,"たも"],[19,1,"とき"],[24,1,"す"],[28,1,"とき"]],"text":"捜すに時があり、失うに時があり、保つに時があり、捨てるに時があり、"},{"ref":"Eccl.3.7","start":21003007,"end":21003007,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"さ"],[3,1,"とき"],[8,1,"ぬ"],[11,1,"とき"],[16,1,"だま"],[19,1,"とき"],[24,1,"かた"],[27,1,"とき"]],"text":"裂くに時があり、縫うに時があり、黙るに時があり、語るに時があり、"},{"ref":"Eccl.3.8","start":21003008,"end":21003008,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あい"],[4,1,"とき"],[9,1,"にく"],[12,1,"とき"],[17,1,"たたか"],[20,1,"とき"],[25,1,"やわ"],[29,1,"とき"]],"text":"愛するに時があり、憎むに時があり、戦うに時があり、和らぐに時がある。"},{"ref":"Eccl.3.9","start":21003009,"end":21003009,"break":"line","ruby":[[0,1,"はたら"],[2,1,"もの"],[6,1,"ろう"],[18,1,"えき"],[20,1,"え"]],"text":"働く者はその労することにより、なんの益を得るか。"},{"ref":"Eccl.3.10","start":21003010,"end":21003010,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"ひと"],[8,1,"こ"],[11,1,"あた"],[23,2,"しごと"],[26,1,"み"]],"text":"わたしは神が人の子らに与えて、ほねおらせられる仕事を見た。"},{"ref":"Eccl.3.11","start":21003011,"end":21003011,"break":"none","ruby":[[0,1,"かみ"],[9,1,"みな"],[12,1,"とき"],[18,1,"うつく"],[22,1,"かみ"],[26,1,"ひと"],[28,1,"こころ"],[30,2,"えいえん"],[33,1,"おも"],[35,1,"おも"],[38,1,"さづ"],[51,1,"ひと"],[53,1,"かみ"],[62,1,"はじ"],[66,1,"おわ"],[70,1,"み"]],"text":"神のなされることは皆その時にかなって美しい。神はまた人の心に永遠を思う思いを授けられた。それでもなお、人は神のなされるわざを初めから終りまで見きわめることはできない。"},{"ref":"Eccl.3.12","start":21003012,"end":21003012,"break":"none","ruby":[[4,1,"し"],[10,1,"ひと"],[15,1,"い"],[24,1,"あいだ"],[26,1,"たの"],[29,2,"ゆかい"],[32,1,"す"],[40,1,"よ"],[42,1,"こと"]],"text":"わたしは知っている。人にはその生きながらえている間、楽しく愉快に過ごすよりほかに良い事はない。"},{"ref":"Eccl.3.13","start":21003013,"end":21003013,"break":"none","ruby":[[6,1,"ひと"],[8,1,"く"],[10,1,"の"],[20,2,"ろうく"],[26,1,"たの"],[30,1,"え"],[35,1,"かみ"],[37,2,"たまもの"]],"text":"またすべての人が食い飲みし、そのすべての労苦によって楽しみを得ることは神の賜物である。"},{"ref":"Eccl.3.14","start":21003014,"end":21003014,"break":"none","ruby":[[4,1,"し"],[13,1,"かみ"],[18,1,"こと"],[20,2,"えいえん"],[23,1,"かわ"],[34,1,"くわ"],[45,1,"と"],[55,1,"かみ"],[68,2,"ひとびと"],[71,1,"かみ"],[73,1,"まえ"],[75,1,"おそ"]],"text":"わたしは知っている。すべて神がなさる事は永遠に変ることがなく、これに加えることも、これから取ることもできない。神がこのようにされるのは、人々が神の前に恐れをもつようになるためである。"},{"ref":"Eccl.3.15","start":21003015,"end":21003015,"break":"none","ruby":[[0,1,"いま"],[19,1,"のち"],[39,1,"かみ"],[41,1,"お"],[50,1,"たず"],[52,1,"もと"]],"text":"今あるものは、すでにあったものである。後にあるものも、すでにあったものである。神は追いやられたものを尋ね求められる。"},{"ref":"Eccl.3.16","start":21003016,"end":21003016,"break":"paragraph","ruby":[[7,1,"ひ"],[9,1,"した"],[11,1,"み"],[19,1,"おこな"],[21,1,"ところ"],[24,2,"ふせい"],[30,2,"こうぎ"],[33,1,"おこな"],[35,1,"ところ"],[38,2,"ふせい"]],"text":"わたしはまた、日の下を見たが、さばきを行う所にも不正があり、公義を行う所にも不正がある。"},{"ref":"Eccl.3.17","start":21003017,"end":21003017,"break":"none","ruby":[[4,1,"こころ"],[6,1,"い"],[11,1,"かみ"],[13,1,"ただ"],[16,1,"もの"],[18,1,"わる"],[20,1,"もの"],[29,1,"かみ"],[35,1,"こと"],[46,1,"とき"],[48,1,"さだ"]],"text":"わたしは心に言った、「神は正しい者と悪い者とをさばかれる。神はすべての事と、すべてのわざに、時を定められたからである」と。"},{"ref":"Eccl.3.18","start":21003018,"end":21003018,"break":"none","ruby":[[7,1,"ひと"],[9,1,"こ"],[15,1,"こころ"],[17,1,"い"],[22,1,"かみ"],[24,1,"かれ"],[32,1,"かれ"],[35,2,"じぶん"],[40,1,"けもの"],[49,1,"さと"]],"text":"わたしはまた、人の子らについて心に言った、「神は彼らをためして、彼らに自分たちが獣にすぎないことを悟らせられるのである」と。"},{"ref":"Eccl.3.19","start":21003019,"end":21003019,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[5,1,"のぞ"],[11,1,"けもの"],[14,1,"のぞ"],[26,2,"いちよう"],[29,1,"かれ"],[32,1,"のぞ"],[38,1,"し"],[44,1,"かれ"],[46,1,"し"],[53,1,"かれ"],[58,2,"どうよう"],[61,1,"いき"],[69,1,"ひと"],[71,1,"けもの"],[90,1,"くう"]],"text":"人の子らに臨むところは獣にも臨むからである。すなわち一様に彼らに臨み、これの死ぬように、彼も死ぬのである。彼らはみな同様の息をもっている。人は獣にまさるところがない。すべてのものは空だからである。"},{"ref":"Eccl.3.20","start":21003020,"end":21003020,"break":"none","ruby":[[2,1,"ひと"],[4,1,"ところ"],[6,1,"い"],[9,1,"みな"],[14,1,"で"],[17,1,"みな"],[21,1,"かえ"]],"text":"みな一つ所に行く。皆ちりから出て、皆ちりに帰る。"},{"ref":"Eccl.3.21","start":21003021,"end":21003021,"break":"none","ruby":[[3,1,"し"],[7,1,"ひと"],[9,1,"こ"],[12,1,"れい"],[14,1,"うえ"],[20,1,"けもの"],[22,1,"れい"],[24,1,"ち"]],"text":"だれが知るか、人の子らの霊は上にのぼり、獣の霊は地にくだるかを。"},{"ref":"Eccl.3.22","start":21003022,"end":21003022,"break":"none","ruby":[[8,1,"み"],[11,1,"ひと"],[15,1,"はたら"],[21,1,"たの"],[28,1,"こと"],[36,1,"かれ"],[38,1,"ぶん"],[49,1,"かれ"],[60,1,"のち"],[69,1,"み"]],"text":"それで、わたしは見た、人はその働きによって楽しむにこした事はない。これが彼の分だからである。だれが彼をつれていって、その後の、どうなるかを見させることができようか。"}]