[{"ref":"Ps.145.1","start":19145001,"end":19145001,"break":"paragraph","title":"ダビデのさんびの歌","breaks":[[19,"line"]],"ruby":[[2,1,"かみ"],[4,1,"おう"],[19,2,"よよ"],[27,1,"な"]],"titleRuby":[[8,1,"うた"]],"text":"わが神、王よ、わたしはあなたをあがめ、世々かぎりなくみ名をほめまつります。"},{"ref":"Ps.145.2","start":19145002,"end":19145002,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"ひ"],[15,2,"よよ"],[23,1,"な"]],"text":"わたしは日ごとにあなたをほめ、世々かぎりなくみ名をほめたたえます。"},{"ref":"Ps.145.3","start":19145003,"end":19145003,"break":"line","breaks":[[9,"line"],[24,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おお"],[6,1,"かみ"],[9,1,"おお"],[26,1,"おお"],[33,1,"はか"],[35,1,"し"]],"text":"主は大いなる神で、大いにほめたたえらるべきです。その大いなることは測り知ることができません。"},{"ref":"Ps.145.4","start":19145004,"end":19145004,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[2,1,"よ"],[6,1,"よ"],[30,2,"たいのう"],[38,1,"の"],[40,1,"つた"]],"text":"この代はかの代にむかってあなたのみわざをほめたたえ、あなたの大能のはたらきを宣べ伝えるでしょう。"},{"ref":"Ps.145.5","start":19145005,"end":19145005,"break":"line","breaks":[[19,"line"]],"ruby":[[8,2,"いげん"],[11,2,"こうえい"],[15,1,"かがや"],[32,1,"ふか"],[34,1,"おも"]],"text":"わたしはあなたの威厳の光栄ある輝きと、あなたのくすしきみわざとを深く思います。"},{"ref":"Ps.145.6","start":19145006,"end":19145006,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"ひとびと"],[7,1,"おそ"],[16,1,"いきお"],[19,1,"かた"],[30,1,"おお"],[37,1,"の"],[39,1,"つた"]],"text":"人々はあなたの恐るべきはたらきの勢いを語り、わたしはあなたの大いなることを宣べ伝えます。"},{"ref":"Ps.145.7","start":19145007,"end":19145007,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かれ"],[7,1,"ゆた"],[10,1,"めぐ"],[13,1,"おも"],[15,1,"で"],[17,1,"い"],[28,1,"ぎ"],[30,1,"よろこ"],[32,1,"うた"]],"text":"彼らはあなたの豊かな恵みの思い出を言いあらわし、あなたの義を喜び歌うでしょう。"},{"ref":"Ps.145.8","start":19145008,"end":19145008,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"めぐ"],[13,1,"み"],[16,1,"いか"],[29,1,"ゆた"]],"text":"主は恵みふかく、あわれみに満ち、怒ることおそく、いつくしみ豊かです。"},{"ref":"Ps.145.9","start":19145009,"end":19145009,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"めぐ"],[30,1,"うえ"]],"text":"主はすべてのものに恵みがあり、そのあわれみはすべてのみわざの上にあります。"},{"ref":"Ps.145.10","start":19145010,"end":19145010,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[19,2,"かんしゃ"],[27,2,"せいと"]],"text":"主よ、あなたのすべてのみわざはあなたに感謝し、あなたの聖徒はあなたをほめまつるでしょう。"},{"ref":"Ps.145.11","start":19145011,"end":19145011,"break":"line","ruby":[[0,1,"かれ"],[4,1,"くに"],[6,2,"えいこう"],[9,1,"かた"],[17,1,"ちから"],[19,1,"の"]],"text":"彼らはみ国の栄光を語り、あなたのみ力を宣べ、"},{"ref":"Ps.145.12","start":19145012,"end":19145012,"break":"line","breaks":[[13,"line"]],"ruby":[[4,2,"たいのう"],[14,1,"くに"],[16,2,"こうえい"],[20,1,"かがや"],[24,1,"ひと"],[26,1,"こ"],[28,1,"し"]],"text":"あなたの大能のはたらきと、み国の光栄ある輝きとを人の子に知らせるでしょう。"},{"ref":"Ps.145.13","start":19145013,"end":19145013,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[4,1,"くに"],[11,1,"くに"],[30,1,"た"]],"text":"あなたの国はとこしえの国です。あなたのまつりごとはよろずよに絶えることはありません。"},{"ref":"Ps.145.14","start":19145014,"end":19145014,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"たお"],[11,1,"もの"],[23,1,"もの"],[25,1,"た"]],"text":"主はすべて倒れんとする者をささえ、すべてかがむ者を立たせられます。"},{"ref":"Ps.145.15","start":19145015,"end":19145015,"break":"line","breaks":[[22,"line"]],"ruby":[[7,1,"め"],[13,1,"ま"],[15,1,"のぞ"],[26,1,"とき"],[33,1,"かれ"],[36,2,"しょくもつ"],[39,1,"あた"]],"text":"よろずのものの目はあなたを待ち望んでいます。あなたは時にしたがって彼らに食物を与えられます。"},{"ref":"Ps.145.16","start":19145016,"end":19145016,"break":"line","breaks":[[11,"line"]],"ruby":[[5,1,"て"],[7,1,"ひら"],[15,1,"い"],[21,1,"ねが"],[24,1,"あ"]],"text":"あなたはみ手を開いて、すべての生けるものの願いを飽かせられます。"},{"ref":"Ps.145.17","start":19145017,"end":19145017,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"みち"],[10,1,"ただ"],[24,1,"めぐ"]],"text":"主はそのすべての道に正しく、そのすべてのみわざに恵みふかく、"},{"ref":"Ps.145.18","start":19145018,"end":19145018,"break":"line","breaks":[[20,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"よ"],[7,1,"もの"],[9,1,"まこと"],[14,1,"しゅ"],[16,1,"よ"],[18,1,"もの"],[20,1,"しゅ"],[22,1,"ちか"]],"text":"すべて主を呼ぶ者、誠をもって主を呼ぶ者に主は近いのです。"},{"ref":"Ps.145.19","start":19145019,"end":19145019,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"おそ"],[9,1,"もの"],[11,1,"ねが"],[14,1,"み"],[22,1,"さけ"],[25,1,"き"],[31,1,"すく"]],"text":"主はおのれを恐れる者の願いを満たし、またその叫びを聞いてこれを救われます。"},{"ref":"Ps.145.20","start":19145020,"end":19145020,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"あい"],[9,1,"もの"],[14,1,"まも"],[20,1,"あ"],[23,1,"もの"],[30,1,"ほろ"]],"text":"主はおのれを愛する者をすべて守られるが、悪しき者をことごとく滅ぼされます。"},{"ref":"Ps.145.21","start":19145021,"end":19145021,"break":"line","breaks":[[11,"line"],[27,"line"]],"ruby":[[2,1,"くち"],[4,1,"しゅ"],[6,1,"ほまれ"],[8,1,"かた"],[15,1,"にく"],[18,1,"もの"],[20,2,"よよ"],[29,1,"せい"],[33,1,"な"]],"text":"わが口は主の誉を語り、すべての肉なる者は世々かぎりなくその聖なるみ名をほめまつるでしょう。"}]