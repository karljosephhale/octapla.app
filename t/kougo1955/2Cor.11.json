[{"ref":"2Cor.11.1","start":47011001,"end":47011001,"break":"paragraph","ruby":[[4,1,"すこ"],[9,1,"おろ"],[15,1,"い"],[24,1,"しの"],[35,1,"しの"]],"text":"わたしが少しばかり愚かなことを言うのを、どうか、忍んでほしい。もちろん忍んでくれるのだ。"},{"ref":"2Cor.11.2","start":47011002,"end":47011002,"break":"none","ruby":[[4,1,"かみ"],[6,1,"ねつ"],[7,1,"じょう"],[19,2,"ねつあい"],[49,2,"だんし"],[64,2,"こんやく"]],"text":"わたしは神の熱情をもって、あなたがたを熱愛している。あなたがたを、きよいおとめとして、ただひとりの男子キリストにささげるために、婚約させたのである。"},{"ref":"2Cor.11.3","start":47011003,"end":47011003,"break":"none","ruby":[[2,1,"おそ"],[14,2,"わるだく"],[18,2,"ゆうわく"],[33,1,"おも"],[36,1,"けが"],[46,1,"たい"],[49,2,"じゅんじょう"],[52,2,"ていそう"],[56,1,"うしな"]],"text":"ただ恐れるのは、エバがへびの悪巧みで誘惑されたように、あなたがたの思いが汚されて、キリストに対する純情と貞操とを失いはしないかということである。"},{"ref":"2Cor.11.4","start":47011004,"end":47011004,"break":"none","ruby":[[10,1,"ひと"],[21,1,"の"],[23,1,"つた"],[34,1,"こと"],[41,1,"の"],[43,1,"つた"],[57,1,"う"],[65,1,"ちが"],[68,1,"れい"],[70,1,"う"],[78,1,"う"],[88,1,"ちが"],[91,2,"ふくいん"],[94,1,"き"],[96,2,"ばあい"],[112,1,"しの"]],"text":"というのは、もしある人がきて、わたしたちが宣べ伝えもしなかったような異なるイエスを宣べ伝え、あるいは、あなたがたが受けたことのない違った霊を受け、あるいは、受けいれたことのない違った福音を聞く場合に、あなたがたはよくもそれを忍んでいる。"},{"ref":"2Cor.11.5","start":47011005,"end":47011005,"break":"none","ruby":[[0,2,"じじつ"],[10,3,"だいしと"],[21,1,"おと"],[29,1,"おも"]],"text":"事実、わたしは、あの大使徒たちにいささかも劣ってはいないと思う。"},{"ref":"2Cor.11.6","start":47011006,"end":47011006,"break":"none","ruby":[[3,2,"べんぜつ"],[13,2,"ちしき"],[27,1,"こと"],[37,2,"ばあい"],[47,1,"たい"],[53,1,"あき"]],"text":"たとい弁舌はつたなくても、知識はそうでない。わたしは、事ごとに、いろいろの場合に、あなたがたに対してそれを明らかにした。"},{"ref":"2Cor.11.7","start":47011007,"end":47011007,"break":"paragraph","ruby":[[11,1,"たか"],[17,2,"じぶん"],[20,1,"ひく"],[25,1,"かみ"],[27,2,"ふくいん"],[30,1,"あたい"],[40,1,"の"],[42,1,"つた"],[49,1,"つみ"]],"text":"それとも、あなたがたを高めるために自分を低くして、神の福音を価なしにあなたがたに宣べ伝えたことが、罪になるのだろうか。"},{"ref":"2Cor.11.8","start":47011008,"end":47011008,"break":"none","ruby":[[4,1,"た"],[6,1,"しょ"],[7,2,"きょうかい"],[15,1,"い"],[21,1,"え"],[23,1,"かね"],[32,2,"ほうし"]],"text":"わたしは他の諸教会をかすめたと言われながら得た金で、あなたがたに奉仕し、"},{"ref":"2Cor.11.9","start":47011009,"end":47011009,"break":"none","ruby":[[6,1,"ところ"],[10,2,"びんぼう"],[15,1,"とき"],[23,2,"ふたん"],[41,2,"けつぼう"],[54,2,"きょうだい"],[60,1,"おぎな"],[80,1,"こと"],[91,2,"おもに"],[94,1,"お"],[100,1,"つと"],[107,2,"こんご"],[110,1,"つと"]],"text":"あなたがたの所にいて貧乏をした時にも、だれにも負担をかけたことはなかった。わたしの欠乏は、マケドニヤからきた兄弟たちが、補ってくれた。こうして、わたしはすべての事につき、あなたがたに重荷を負わせまいと努めてきたし、今後も努めよう。"},{"ref":"2Cor.11.10","start":47011010,"end":47011010,"break":"none","ruby":[[4,1,"うち"],[13,2,"しんじつ"],[19,1,"い"],[24,1,"ほこり"],[29,2,"ちほう"],[32,1,"ふう"],[44,1,"けっ"]],"text":"わたしの内にあるキリストの真実にかけて言う、この誇がアカヤ地方で封じられるようなことは、決してない。"},{"ref":"2Cor.11.11","start":47011011,"end":47011011,"break":"none","ruby":[[17,1,"あい"],[31,1,"かみ"],[34,1,"ぞん"]],"text":"なぜであるか。わたしがあなたがたを愛していないからか。それは、神がご存じである。"},{"ref":"2Cor.11.12","start":47011012,"end":47011012,"break":"paragraph","ruby":[[9,2,"げんざい"],[18,2,"こんご"],[37,1,"おな"],[42,1,"ほこ"],[46,1,"た"],[48,1,"ば"],[50,1,"え"],[54,2,"きかい"],[63,1,"もの"],[71,2,"きかい"],[74,1,"た"],[76,1,"き"]],"text":"しかし、わたしは、現在していることを今後もしていこう。それは、わたしたちと同じように誇りうる立ち場を得ようと機会をねらっている者どもから、その機会を断ち切ってしまうためである。"},{"ref":"2Cor.11.13","start":47011013,"end":47011013,"break":"none","ruby":[[4,2,"ひとびと"],[9,2,"しと"],[12,1,"ひと"],[17,1,"はたら"],[19,1,"びと"],[30,2,"しと"],[33,2,"ぎそう"]],"text":"こういう人々はにせ使徒、人をだます働き人であって、キリストの使徒に擬装しているにすぎないからである。"},{"ref":"2Cor.11.14","start":47011014,"end":47011014,"break":"none","ruby":[[4,1,"おどろ"],[8,1,"およ"],[17,1,"ひかり"],[19,2,"てんし"],[22,2,"ぎそう"]],"text":"しかし、驚くには及ばない。サタンも光の天使に擬装するのだから。"},{"ref":"2Cor.11.15","start":47011015,"end":47011015,"break":"none","ruby":[[11,1,"て"],[12,1,"した"],[17,1,"ぎ"],[19,3,"ほうししゃ"],[26,2,"ぎそう"],[35,3,"ふしぎ"],[43,1,"かれ"],[46,2,"さいご"],[56,1,"あ"]],"text":"だから、たといサタンの手下どもが、義の奉仕者のように擬装したとしても、不思議ではない。彼らの最期は、そのしわざに合ったものとなろう。"},{"ref":"2Cor.11.16","start":47011016,"end":47011016,"break":"paragraph","ruby":[[0,1,"く"],[2,1,"かえ"],[5,1,"い"],[17,1,"おろ"],[19,1,"もの"],[21,1,"おも"],[34,1,"おも"],[39,1,"おろ"],[41,1,"もの"],[62,1,"すこ"],[64,1,"ほこ"]],"text":"繰り返して言うが、だれも、わたしを愚か者と思わないでほしい。もしそう思うなら、愚か者あつかいにされてもよいから、わたしにも、少し誇らせてほしい。"},{"ref":"2Cor.11.17","start":47011017,"end":47011017,"break":"none","ruby":[[2,1,"い"],[8,1,"しゅ"],[13,1,"い"],[21,1,"おろ"],[23,1,"もの"],[29,2,"じぶん"],[32,1,"ほこり"],[40,1,"しん"],[45,1,"い"]],"text":"いま言うことは、主によって言うのではなく、愚か者のように、自分の誇とするところを信じきって言うのである。"},{"ref":"2Cor.11.18","start":47011018,"end":47011018,"break":"none","ruby":[[0,1,"おお"],[3,1,"ひと"],[5,1,"にく"],[10,1,"ほこ"],[22,1,"ほこ"]],"text":"多くの人が肉によって誇っているから、わたしも誇ろう。"},{"ref":"2Cor.11.19","start":47011019,"end":47011019,"break":"none","ruby":[[6,1,"かしこ"],[8,1,"ひと"],[17,1,"よろこ"],[20,1,"おろ"],[22,1,"もの"],[24,1,"しの"]],"text":"あなたがたは賢い人たちなのだから、喜んで愚か者を忍んでくれるだろう。"},{"ref":"2Cor.11.20","start":47011020,"end":47011020,"break":"none","ruby":[[0,2,"じっさい"],[9,2,"どれい"],[17,1,"く"],[19,1,"たお"],[25,2,"りゃくだつ"],[39,1,"かお"],[51,1,"しの"]],"text":"実際、あなたがたは奴隷にされても、食い倒されても、略奪されても、いばられても、顔をたたかれても、それを忍んでいる。"},{"ref":"2Cor.11.21","start":47011021,"end":47011021,"break":"none","ruby":[[0,1,"い"],[4,1,"は"],[20,1,"よわ"],[31,1,"ひと"],[36,1,"ほこ"],[45,1,"おろ"],[47,1,"もの"],[52,1,"い"],[63,1,"ほこ"]],"text":"言うのも恥ずかしいことだが、わたしたちは弱すぎたのだ。もしある人があえて誇るなら、わたしは愚か者になって言うが、わたしもあえて誇ろう。"},{"ref":"2Cor.11.22","start":47011022,"end":47011022,"break":"none","ruby":[[0,1,"かれ"],[6,1,"びと"],[21,1,"かれ"],[29,1,"びと"],[44,1,"かれ"],[53,2,"しそん"]],"text":"彼らはヘブル人なのか。わたしもそうである。彼らはイスラエル人なのか。わたしもそうである。彼らはアブラハムの子孫なのか。わたしもそうである。"},{"ref":"2Cor.11.23","start":47011023,"end":47011023,"break":"none","ruby":[[0,1,"かれ"],[8,1,"しもべ"],[17,1,"き"],[19,1,"くる"],[28,1,"い"],[35,1,"かれ"],[37,2,"いじょう"],[46,2,"くろう"],[56,1,"おお"],[59,2,"とうごく"],[70,1,"おお"],[75,1,"う"],[94,1,"し"],[96,1,"めん"]],"text":"彼らはキリストの僕なのか。わたしは気が狂ったようになって言う、わたしは彼ら以上にそうである。苦労したことはもっと多く、投獄されたことももっと多く、むち打たれたことは、はるかにおびただしく、死に面したこともしばしばあった。"},{"ref":"2Cor.11.24","start":47011024,"end":47011024,"break":"none","ruby":[[3,1,"じん"],[11,1,"た"],[18,1,"う"],[25,1,"ど"]],"text":"ユダヤ人から四十に一つ足りないむちを受けたことが五度、"},{"ref":"2Cor.11.25","start":47011025,"end":47011025,"break":"none","ruby":[[3,1,"じん"],[8,1,"う"],[16,1,"ど"],[18,1,"いし"],[20,1,"う"],[27,2,"いちど"],[30,2,"なんせん"],[38,1,"ど"],[44,3,"いっちゅうや"],[48,1,"うみ"],[50,1,"うえ"],[52,1,"ただよ"]],"text":"ローマ人にむちで打たれたことが三度、石で打たれたことが一度、難船したことが三度、そして、一昼夜、海の上を漂ったこともある。"},{"ref":"2Cor.11.26","start":47011026,"end":47011026,"break":"none","ruby":[[0,1,"いく"],[4,1,"たび"],[8,1,"かわ"],[10,1,"なん"],[12,2,"とうぞく"],[15,1,"なん"],[17,3,"どうこくみん"],[21,1,"なん"],[23,3,"いほうじん"],[27,1,"なん"],[29,2,"とかい"],[32,1,"なん"],[34,2,"あらの"],[37,1,"なん"],[39,2,"かいじょう"],[42,1,"なん"],[46,2,"きょうだい"],[49,1,"なん"],[51,1,"あ"]],"text":"幾たびも旅をし、川の難、盗賊の難、同国民の難、異邦人の難、都会の難、荒野の難、海上の難、にせ兄弟の難に会い、"},{"ref":"2Cor.11.27","start":47011027,"end":47011027,"break":"none","ruby":[[0,1,"ろう"],[2,1,"くる"],[10,1,"ねむ"],[14,1,"よる"],[16,1,"す"],[20,1,"う"],[30,2,"しょくもつ"],[36,1,"さむ"],[39,1,"こご"],[42,1,"はだか"]],"text":"労し苦しみ、たびたび眠られぬ夜を過ごし、飢えかわき、しばしば食物がなく、寒さに凍え、裸でいたこともあった。"},{"ref":"2Cor.11.28","start":47011028,"end":47011028,"break":"none","ruby":[[7,1,"こと"],[12,1,"ほか"],[15,2,"ひび"],[21,1,"せま"],[24,1,"く"],[26,1,"しょ"],[27,2,"きょうかい"],[30,2,"しんぱい"]],"text":"なおいろいろの事があった外に、日々わたしに迫って来る諸教会の心配ごとがある。"},{"ref":"2Cor.11.29","start":47011029,"end":47011029,"break":"none","ruby":[[4,1,"よわ"],[16,1,"よわ"],[31,1,"つみ"],[33,1,"おか"],[45,1,"こころ"],[47,1,"も"]],"text":"だれかが弱っているのに、わたしも弱らないでおれようか。だれかが罪を犯しているのに、わたしの心が燃えないでおれようか。"},{"ref":"2Cor.11.30","start":47011030,"end":47011030,"break":"none","ruby":[[2,1,"ほこ"],[18,2,"じぶん"],[21,1,"よわ"],[24,1,"ほこ"]],"text":"もし誇らねばならないのなら、わたしは自分の弱さを誇ろう。"},{"ref":"2Cor.11.31","start":47011031,"end":47011031,"break":"none","ruby":[[0,2,"えいえん"],[8,1,"しゅ"],[18,1,"ちち"],[21,1,"かみ"],[28,1,"いつわ"],[31,1,"い"],[42,1,"ぞん"]],"text":"永遠にほむべき、主イエス・キリストの父なる神は、わたしが偽りを言っていないことを、ご存じである。"},{"ref":"2Cor.11.32","start":47011032,"end":47011032,"break":"paragraph","ruby":[[8,1,"おう"],[10,1,"だい"],[11,1,"かん"],[18,1,"とら"],[28,1,"びと"],[30,1,"まち"],[32,2,"かんし"]],"text":"ダマスコでアレタ王の代官が、わたしを捕えるためにダマスコ人の町を監視したことがあったが、"},{"ref":"2Cor.11.33","start":47011033,"end":47011033,"break":"none","ruby":[[2,1,"とき"],[7,1,"まど"],[10,1,"まち"],[12,2,"じょうへき"],[24,1,"お"],[30,1,"かれ"],[32,1,"て"]],"text":"その時わたしは窓から町の城壁づたいに、かごでつり降ろされて、彼の手からのがれた。"}]