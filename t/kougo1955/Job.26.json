[{"ref":"Job.26.1","start":18026001,"end":18026001,"break":"paragraph","ruby":[[6,1,"こた"],[9,1,"い"]],"text":"そこでヨブは答えて言った、"},{"ref":"Job.26.2","start":18026002,"end":18026002,"break":"stanza","breaks":[[24,"line"]],"ruby":[[5,1,"ちから"],[9,1,"もの"],[15,1,"たす"],[24,2,"きりょく"],[29,1,"うで"],[35,1,"すく"]],"text":"「あなたは力のない者をどれほど助けたかしれない。気力のない腕をどれほど救ったかしれない。"},{"ref":"Job.26.3","start":18026003,"end":18026003,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"ちえ"],[5,1,"もの"],[11,1,"おし"],[20,1,"さと"],[27,1,"おお"],[29,1,"しめ"]],"text":"知恵のない者をどれほど教えたかしれない。悟りをどれほど多く示したかしれない。"},{"ref":"Job.26.4","start":18026004,"end":18026004,"break":"line","breaks":[[22,"line"]],"ruby":[[7,1,"たす"],[13,2,"ことば"],[27,1,"で"],[34,1,"れい"]],"text":"あなたはだれの助けによって言葉をだしたのか。あなたから出たのはだれの霊なのか。"},{"ref":"Job.26.5","start":18026005,"end":18026005,"break":"line","ruby":[[0,2,"ぼうれい"],[3,1,"みず"],[9,1,"なか"],[11,1,"す"],[16,1,"した"],[18,1,"ふる"]],"text":"亡霊は水およびその中に住むものの下に震う。"},{"ref":"Job.26.6","start":18026006,"end":18026006,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かみ"],[2,1,"まえ"],[5,2,"よみ"],[8,1,"はだか"],[13,1,"ほろ"],[16,1,"あな"],[21,1,"かく"]],"text":"神の前では陰府も裸である。滅びの穴もおおい隠すものはない。"},{"ref":"Job.26.7","start":18026007,"end":18026007,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[2,1,"きた"],[4,1,"てん"],[6,2,"くうかん"],[9,1,"は"],[12,1,"ち"],[14,1,"なに"],[18,1,"ところ"],[20,1,"か"]],"text":"彼は北の天を空間に張り、地を何もない所に掛けられる。"},{"ref":"Job.26.8","start":18026008,"end":18026008,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[2,1,"みず"],[4,1,"こ"],[6,1,"くも"],[8,1,"なか"],[10,1,"つつ"],[18,1,"した"],[20,1,"くも"],[22,1,"さ"]],"text":"彼は水を濃い雲の中に包まれるが、その下の雲は裂けない。"},{"ref":"Job.26.9","start":18026009,"end":18026009,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[2,1,"つき"],[11,1,"かく"],[15,1,"くも"],[19,1,"うえ"]],"text":"彼は月のおもてをおおい隠して、雲をその上にのべ、"},{"ref":"Job.26.10","start":18026010,"end":18026010,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"みず"],[6,1,"えん"],[8,1,"えが"],[12,1,"ひかり"],[18,1,"さかい"]],"text":"水のおもてに円を描いて、光とやみとの境とされた。"},{"ref":"Job.26.11","start":18026011,"end":18026011,"break":"line","ruby":[[0,1,"かれ"],[2,1,"いまし"],[7,1,"てん"],[9,1,"はしら"],[11,1,"ふる"],[16,1,"おどろ"]],"text":"彼が戒めると、天の柱は震い、かつ驚く。"},{"ref":"Job.26.12","start":18026012,"end":18026012,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[4,1,"ちから"],[9,1,"うみ"],[11,1,"しず"],[16,2,"ちえ"],[26,1,"う"],[28,1,"くだ"]],"text":"彼はその力をもって海を静め、その知恵をもってラハブを打ち砕き、"},{"ref":"Job.26.13","start":18026013,"end":18026013,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"いき"],[7,1,"てん"],[9,1,"は"],[18,1,"て"],[23,1,"に"],[29,1,"つ"],[31,1,"とお"]],"text":"その息をもって天を晴れわたらせ、その手をもって逃げるへびを突き通される。"},{"ref":"Job.26.14","start":18026014,"end":18026014,"break":"line","breaks":[[20,"line"],[34,"line"],[50,"line"],[68,"line"]],"ruby":[[0,1,"み"],[9,1,"かれ"],[11,1,"みち"],[13,1,"はし"],[25,1,"かれ"],[30,1,"き"],[32,1,"ところ"],[56,1,"ちから"],[63,1,"いた"],[71,1,"さと"]],"text":"見よ、これらはただ彼の道の端にすぎない。われわれが彼について聞く所はいかにかすかなささやきであろう。しかし、その力のとどろきに至っては、だれが悟ることができるか」。"}]