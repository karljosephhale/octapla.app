[{"ref":"Rev.6.1","start":66006001,"end":66006001,"break":"paragraph","ruby":[[0,2,"こひつじ"],[8,2,"ふういん"],[14,1,"と"],[17,1,"とき"],[23,1,"み"],[32,1,"い"],[34,1,"もの"],[40,1,"かみなり"],[45,1,"こえ"],[53,1,"よ"],[57,1,"き"]],"text":"小羊がその七つの封印の一つを解いた時、わたしが見ていると、四つの生き物の一つが、雷のような声で「きたれ」と呼ぶのを聞いた。"},{"ref":"Rev.6.2","start":66006002,"end":66006002,"break":"none","ruby":[[3,1,"み"],[9,1,"み"],[12,1,"しろ"],[14,1,"うま"],[16,1,"で"],[28,1,"の"],[33,1,"もの"],[36,1,"ゆみ"],[38,1,"て"],[40,1,"も"],[48,1,"かんむり"],[50,1,"あた"],[56,2,"しょうり"],[59,1,"うえ"],[64,2,"しょうり"],[67,1,"え"],[73,1,"で"]],"text":"そして見ていると、見よ、白い馬が出てきた。そして、それに乗っている者は、弓を手に持っており、また冠を与えられて、勝利の上にもなお勝利を得ようとして出かけた。"},{"ref":"Rev.6.3","start":66006003,"end":66006003,"break":"paragraph","ruby":[[0,2,"こひつじ"],[3,1,"だい"],[6,2,"ふういん"],[9,1,"と"],[12,1,"とき"],[14,1,"だい"],[17,1,"い"],[19,1,"もの"],[27,1,"い"],[36,1,"き"]],"text":"小羊が第二の封印を解いた時、第二の生き物が「きたれ」と言うのを、わたしは聞いた。"},{"ref":"Rev.6.4","start":66006004,"end":66006004,"break":"none","ruby":[[3,2,"こんど"],[7,1,"あか"],[9,1,"うま"],[11,1,"で"],[23,1,"の"],[28,1,"もの"],[31,2,"ひとびと"],[34,1,"たがい"],[36,1,"ころ"],[38,1,"あ"],[49,2,"ちじょう"],[53,2,"へいわ"],[56,1,"うば"],[58,1,"と"],[63,1,"ゆる"],[70,1,"おお"],[77,1,"あた"]],"text":"すると今度は、赤い馬が出てきた。そして、それに乗っている者は、人々が互に殺し合うようになるために、地上から平和を奪い取ることを許され、また、大きなつるぎを与えられた。"},{"ref":"Rev.6.5","start":66006005,"end":66006005,"break":"paragraph","ruby":[[3,1,"だい"],[6,2,"ふういん"],[9,1,"と"],[12,1,"とき"],[14,1,"だい"],[17,1,"い"],[19,1,"もの"],[27,1,"い"],[36,1,"き"],[43,1,"み"],[49,1,"み"],[52,1,"くろ"],[54,1,"うま"],[56,1,"で"],[68,1,"の"],[73,1,"もの"],[80,1,"て"],[82,1,"も"]],"text":"また、第三の封印を解いた時、第三の生き物が「きたれ」と言うのを、わたしは聞いた。そこで見ていると、見よ、黒い馬が出てきた。そして、それに乗っている者は、はかりを手に持っていた。"},{"ref":"Rev.6.6","start":66006006,"end":66006006,"break":"none","ruby":[[11,1,"い"],[13,1,"もの"],[15,1,"あいだ"],[18,1,"で"],[20,1,"く"],[23,1,"おも"],[27,1,"こえ"],[32,1,"い"],[36,1,"き"],[41,2,"こむぎ"],[52,2,"おおむぎ"],[66,1,"ゆ"],[71,1,"しゅ"]],"text":"すると、わたしは四つの生き物の間から出て来ると思われる声が、こう言うのを聞いた、「小麦一ますは一デナリ。大麦三ますも一デナリ。オリブ油とぶどう酒とを、そこなうな」。"},{"ref":"Rev.6.7","start":66006007,"end":66006007,"break":"paragraph","ruby":[[0,2,"こひつじ"],[3,1,"だい"],[6,2,"ふういん"],[9,1,"と"],[12,1,"とき"],[14,1,"だい"],[17,1,"い"],[19,1,"もの"],[27,1,"い"],[29,1,"こえ"],[36,1,"き"]],"text":"小羊が第四の封印を解いた時、第四の生き物が「きたれ」と言う声を、わたしは聞いた。"},{"ref":"Rev.6.8","start":66006008,"end":66006008,"break":"none","ruby":[[3,1,"み"],[9,1,"み"],[12,2,"あおじろ"],[15,1,"うま"],[17,1,"で"],[29,1,"の"],[34,1,"もの"],[36,1,"な"],[39,1,"し"],[42,1,"い"],[48,2,"よみ"],[51,1,"したが"],[57,1,"かれ"],[62,1,"ち"],[65,1,"ぶん"],[69,2,"しはい"],[73,2,"けんい"],[90,1,"し"],[93,1,"ち"],[95,1,"けもの"],[102,1,"ひと"],[104,1,"ころ"],[106,2,"けんい"],[111,1,"あた"]],"text":"そこで見ていると、見よ、青白い馬が出てきた。そして、それに乗っている者の名は「死」と言い、それに黄泉が従っていた。彼らには、地の四分の一を支配する権威、および、つるぎと、ききんと、死と、地の獣らとによって人を殺す権威とが、与えられた。"},{"ref":"Rev.6.9","start":66006009,"end":66006009,"break":"paragraph","ruby":[[0,2,"こひつじ"],[3,1,"だい"],[6,2,"ふういん"],[9,1,"と"],[12,1,"とき"],[14,1,"かみ"],[16,1,"ことば"],[31,1,"た"],[38,1,"ころ"],[42,2,"ひとびと"],[45,2,"れいこん"],[49,2,"さいだん"],[52,1,"した"],[63,1,"み"]],"text":"小羊が第五の封印を解いた時、神の言のゆえに、また、そのあかしを立てたために、殺された人々の霊魂が、祭壇の下にいるのを、わたしは見た。"},{"ref":"Rev.6.10","start":66006010,"end":66006010,"break":"none","ruby":[[0,1,"かれ"],[3,2,"おおごえ"],[6,1,"さけ"],[9,1,"い"],[14,1,"せい"],[23,1,"しゅ"],[48,1,"ち"],[50,1,"す"],[52,1,"もの"],[54,1,"たい"],[64,1,"ち"],[66,2,"ほうふく"]],"text":"彼らは大声で叫んで言った、「聖なる、まことなる主よ。いつまであなたは、さばくことをなさらず、また地に住む者に対して、わたしたちの血の報復をなさらないのですか」。"},{"ref":"Rev.6.11","start":66006011,"end":66006011,"break":"none","ruby":[[4,1,"かれ"],[14,1,"しろ"],[16,1,"ころも"],[18,1,"あた"],[29,1,"かれ"],[32,1,"おな"],[35,1,"ころ"],[43,1,"しもべ"],[44,2,"なかま"],[47,2,"きょうだい"],[52,1,"かず"],[54,1,"み"],[67,1,"あいだ"],[69,1,"やす"],[79,1,"い"],[81,1,"わた"]],"text":"すると、彼らのひとりびとりに白い衣が与えられ、それから、「彼らと同じく殺されようとする僕仲間や兄弟たちの数が満ちるまで、もうしばらくの間、休んでいるように」と言い渡された。"},{"ref":"Rev.6.12","start":66006012,"end":66006012,"break":"paragraph","ruby":[[0,2,"こひつじ"],[3,1,"だい"],[6,2,"ふういん"],[9,1,"と"],[12,1,"とき"],[18,1,"み"],[24,1,"だい"],[25,2,"じしん"],[28,1,"おこ"],[32,2,"たいよう"],[35,2,"けおり"],[38,2,"あらぬの"],[44,1,"くろ"],[49,1,"つき"],[51,2,"ぜんめん"],[54,1,"ち"]],"text":"小羊が第六の封印を解いた時、わたしが見ていると、大地震が起って、太陽は毛織の荒布のように黒くなり、月は全面、血のようになり、"},{"ref":"Rev.6.13","start":66006013,"end":66006013,"break":"none","ruby":[[0,1,"てん"],[2,1,"ほし"],[12,1,"あお"],[14,1,"み"],[16,2,"おおふう"],[19,1,"ゆ"],[23,1,"ふ"],[25,1,"おと"],[33,1,"ち"],[35,1,"お"]],"text":"天の星は、いちじくのまだ青い実が大風に揺られて振り落されるように、地に落ちた。"},{"ref":"Rev.6.14","start":66006014,"end":66006014,"break":"none","ruby":[[0,1,"てん"],[2,2,"まきもの"],[5,1,"ま"],[12,1,"き"],[22,1,"やま"],[24,1,"しま"],[29,2,"ばしょ"],[33,1,"うつ"]],"text":"天は巻物が巻かれるように消えていき、すべての山と島とはその場所から移されてしまった。"},{"ref":"Rev.6.15","start":66006015,"end":66006015,"break":"none","ruby":[[0,1,"ち"],[2,1,"おう"],[6,2,"こうかん"],[9,3,"せんそつちょう"],[13,1,"と"],[16,1,"もの"],[18,2,"ゆうしゃ"],[21,2,"どれい"],[24,3,"じゆうじん"],[34,1,"あな"],[36,1,"やま"],[38,1,"いわ"],[43,1,"み"]],"text":"地の王たち、高官、千卒長、富める者、勇者、奴隷、自由人らはみな、ほら穴や山の岩かげに、身をかくした。"},{"ref":"Rev.6.16","start":66006016,"end":66006016,"break":"none","ruby":[[4,1,"やま"],[6,1,"いわ"],[13,1,"い"],[31,2,"みざ"],[40,2,"みかお"],[43,2,"こひつじ"],[46,1,"いか"]],"text":"そして、山と岩とにむかって言った、「さあ、われわれをおおって、御座にいますかたの御顔と小羊の怒りとから、かくまってくれ。"},{"ref":"Rev.6.17","start":66006017,"end":66006017,"break":"none","ruby":[[0,1,"み"],[1,1,"いか"],[4,1,"おお"],[8,1,"ひ"],[25,1,"まえ"],[27,1,"た"]],"text":"御怒りの大いなる日が、すでにきたのだ。だれが、その前に立つことができようか」。"}]