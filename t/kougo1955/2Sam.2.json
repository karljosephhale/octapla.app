[{"ref":"2Sam.2.1","start":10002001,"end":10002001,"break":"paragraph","ruby":[[2,1,"のち"],[8,1,"しゅ"],[10,1,"と"],[13,1,"い"],[28,1,"まち"],[30,1,"のぼ"],[41,1,"しゅ"],[43,1,"かれ"],[45,1,"い"],[51,1,"のぼ"],[62,1,"い"],[70,1,"のぼ"],[81,1,"しゅ"],[83,1,"い"]],"text":"この後、ダビデは主に問うて言った、「わたしはユダの一つの町に上るべきでしょうか」。主は彼に言われた、「上りなさい」。ダビデは言った、「どこへ上るべきでしょうか」。主は言われた、「ヘブロンへ」。"},{"ref":"2Sam.2.2","start":10002002,"end":10002002,"break":"none","ruby":[[9,1,"ところ"],[11,1,"のぼ"],[15,1,"かれ"],[21,1,"つま"],[28,1,"おんな"],[46,1,"つま"],[57,1,"のぼ"]],"text":"そこでダビデはその所へ上った。彼のふたりの妻、エズレルの女アヒノアムと、カルメルびとナバルの妻であったアビガイルも上った。"},{"ref":"2Sam.2.3","start":10002003,"end":10002003,"break":"none","ruby":[[6,2,"じぶん"],[9,1,"とも"],[13,2,"ひとびと"],[17,1,"みな"],[20,2,"かぞく"],[23,1,"とも"],[25,1,"つ"],[28,1,"のぼ"],[35,1,"かれ"],[43,2,"まちまち"],[46,1,"す"]],"text":"ダビデはまた自分と共にいた人々を、皆その家族と共に連れて上った。そして彼らはヘブロンの町々に住んだ。"},{"ref":"2Sam.2.4","start":10002004,"end":10002004,"break":"none","breaks":[[34,"paragraph"]],"ruby":[[0,1,"とき"],[5,2,"ひとびと"],[13,1,"ところ"],[19,1,"あぶら"],[21,1,"そそ"],[27,1,"いえ"],[29,1,"おう"],[34,2,"ひとびと"],[41,1,"つ"],[50,1,"ほうむ"],[64,2,"ひとびと"],[71,1,"い"]],"text":"時にユダの人々がきて、その所でダビデに油を注ぎ、ユダの家の王とした。人々がダビデに告げて、「サウルを葬ったのはヤベシ・ギレアデの人々である」と言ったので、"},{"ref":"2Sam.2.5","start":10002005,"end":10002005,"break":"none","ruby":[[4,2,"ししゃ"],[16,2,"ひとびと"],[24,1,"かれ"],[27,1,"い"],[39,2,"しゅくん"],[47,2,"ちゅうせい"],[55,1,"かれ"],[57,1,"ほうむ"],[64,1,"しゅ"],[72,2,"しゅくふく"]],"text":"ダビデは使者をヤベシ・ギレアデの人々につかわして彼らに言った、「あなたがたは、主君サウルにこの忠誠をあらわして彼を葬った。どうぞ主があなたがたを祝福されるように。"},{"ref":"2Sam.2.6","start":10002006,"end":10002006,"break":"none","ruby":[[3,1,"しゅ"],[20,2,"しんじつ"],[23,1,"しめ"],[40,1,"こと"],[59,2,"こうい"],[62,1,"しめ"]],"text":"どうぞ主がいまあなたがたに、いつくしみと真実を示されるように。あなたがたが、この事をしたので、わたしもまたあなたがたに好意を示すであろう。"},{"ref":"2Sam.2.7","start":10002007,"end":10002007,"break":"none","ruby":[[0,1,"いま"],[7,1,"て"],[9,1,"つよ"],[13,2,"おお"],[26,2,"しゅくん"],[32,1,"し"],[38,1,"いえ"],[44,1,"あぶら"],[46,1,"そそ"],[50,1,"かれ"],[53,1,"おう"]],"text":"今あなたがたは手を強くし、雄々しくあれ。あなたがたの主君サウルは死に、ユダの家がわたしに油を注いで、彼らの王としたからである」。"},{"ref":"2Sam.2.8","start":10002008,"end":10002008,"break":"paragraph","ruby":[[6,1,"ぐん"],[8,1,"ちょう"],[13,1,"こ"],[27,1,"こ"],[34,1,"と"],[43,1,"つ"],[46,1,"わた"]],"text":"さてサウルの軍の長、ネルの子アブネルは、さきにサウルの子イシボセテを取り、マハナイムに連れて渡り、"},{"ref":"2Sam.2.9","start":10002009,"end":10002009,"break":"none","ruby":[[0,1,"かれ"],[33,1,"ぜん"],[40,1,"おう"]],"text":"彼をギレアデ、アシュルびと、エズレル、エフライム、ベニヤミンおよび全イスラエルの王とした。"},{"ref":"2Sam.2.10","start":10002010,"end":10002010,"break":"none","ruby":[[4,1,"こ"],[17,1,"おう"],[22,1,"とき"],[26,1,"さい"],[33,1,"ねん"],[35,1,"あいだ"],[37,1,"よ"],[39,1,"おさ"],[47,1,"いえ"],[53,1,"したが"]],"text":"サウルの子イシボセテはイスラエルの王となった時、四十歳であって、二年の間、世を治めたが、ユダの家はダビデに従った。"},{"ref":"2Sam.2.11","start":10002011,"end":10002011,"break":"none","ruby":[[14,1,"いえ"],[16,1,"おう"],[21,2,"にっすう"],[25,1,"ねん"],[29,1,"げつ"]],"text":"ダビデがヘブロンにいてユダの家の王であった日数は七年と六か月であった。"},{"ref":"2Sam.2.12","start":10002012,"end":10002012,"break":"paragraph","ruby":[[3,1,"こ"],[16,1,"こ"],[23,2,"けらい"],[34,1,"で"],[41,1,"い"]],"text":"ネルの子アブネル、およびサウルの子イシボセテの家来たちはマハナイムを出てギベオンへ行った。"},{"ref":"2Sam.2.13","start":10002013,"end":10002013,"break":"none","ruby":[[4,1,"こ"],[13,2,"けらい"],[18,1,"で"],[29,1,"いけ"],[34,1,"かれ"],[37,2,"であ"],[41,2,"いっぽう"],[44,1,"いけ"],[49,1,"がわ"],[52,2,"いっぽう"],[55,1,"いけ"],[60,1,"がわ"]],"text":"ゼルヤの子ヨアブとダビデの家来たちも出ていって、ギベオンの池のそばで彼らと出会い、一方は池のこちら側に、一方は池のあちら側にすわった。"},{"ref":"2Sam.2.14","start":10002014,"end":10002014,"break":"none","ruby":[[9,1,"い"],[17,2,"わかもの"],[22,1,"た"],[32,1,"まえ"],[34,2,"しょうぶ"],[47,1,"い"],[52,1,"かれ"],[55,1,"た"]],"text":"アブネルはヨアブに言った、「さあ、若者たちを立たせて、われわれの前で勝負をさせよう」。ヨアブは言った、「彼らを立たせよう」。"},{"ref":"2Sam.2.15","start":10002015,"end":10002015,"break":"none","ruby":[[8,1,"こ"],[29,1,"にん"],[38,2,"けらい"],[44,1,"にん"],[46,1,"かぞ"],[49,1,"だ"],[53,1,"かれ"],[56,1,"た"],[59,1,"すす"]],"text":"こうしてサウルの子イシボセテとベニヤミンびととのために十二人、およびダビデの家来たち十二人を数えて出した。彼らは立って進み、"},{"ref":"2Sam.2.16","start":10002016,"end":10002016,"break":"none","ruby":[[4,2,"あいて"],[7,1,"あたま"],[9,1,"とら"],[16,2,"あいて"],[21,1,"ばら"],[23,1,"さ"],[30,1,"かれ"],[33,1,"とも"],[35,1,"たお"],[46,1,"ところ"],[58,1,"よ"]],"text":"おのおの相手の頭を捕え、つるぎを相手のわき腹に刺し、こうして彼らは共に倒れた。それゆえ、その所はヘルカテ・ハヅリムと呼ばれた。それはギベオンにある。"},{"ref":"2Sam.2.17","start":10002017,"end":10002017,"break":"none","ruby":[[2,1,"ひ"],[4,1,"たたか"],[12,1,"はげ"],[27,2,"ひとびと"],[34,2,"けらい"],[39,1,"まえ"],[41,1,"やぶ"]],"text":"その日、戦いはひじょうに激しく、アブネルとイスラエルの人々はダビデの家来たちの前に敗れた。"},{"ref":"2Sam.2.18","start":10002018,"end":10002018,"break":"paragraph","ruby":[[2,1,"ところ"],[9,1,"にん"],[11,1,"こ"],[40,1,"あし"],[42,1,"はや"],[47,1,"の"]],"text":"その所にゼルヤの三人の子、ヨアブ、アビシャイ、およびアサヘルがいたが、アサヘルは足の早いこと、野のかもしかのようであった。"},{"ref":"2Sam.2.19","start":10002019,"end":10002019,"break":"none","ruby":[[13,1,"お"],[21,1,"い"],[25,1,"みぎ"],[28,1,"ひだり"],[31,1,"まが"],[46,1,"はし"]],"text":"アサヘルはアブネルのあとを追っていったが、行くのに右にも左にも曲ることなく、アブネルのあとに走った。"},{"ref":"2Sam.2.20","start":10002020,"end":10002020,"break":"none","ruby":[[5,1,"うしろ"],[12,1,"い"],[37,1,"こた"]],"text":"アブネルは後をふりむいて言った、「あなたはアサヘルであったか」。アサヘルは答えた、「わたしです」。"},{"ref":"2Sam.2.21","start":10002021,"end":10002021,"break":"none","ruby":[[5,1,"かれ"],[7,1,"い"],[12,1,"みぎ"],[14,1,"ひだり"],[16,1,"まが"],[20,2,"わかもの"],[27,1,"とら"],[36,1,"うば"],[56,1,"お"],[68,1,"む"]],"text":"アブネルは彼に言った、「右か左に曲って、若者のひとりを捕え、そのよろいを奪いなさい」。しかしアサヘルはアブネルを追うことをやめず、ほかに向かおうともしなかった。"},{"ref":"2Sam.2.22","start":10002022,"end":10002022,"break":"none","ruby":[[14,1,"い"],[23,1,"お"],[35,1,"む"],[46,1,"ち"],[48,1,"う"],[50,1,"たお"],[91,1,"あに"],[96,1,"かお"],[98,1,"あ"]],"text":"アブネルはふたたびアサヘルに言った、「わたしを追うことをやめて、ほかに向かいなさい。あなたを地に撃ち倒すことなど、どうしてわたしにできようか。それをすれば、わたしは、どうしてあなたの兄ヨアブに顔を合わせることができようか」。"},{"ref":"2Sam.2.23","start":10002023,"end":10002023,"break":"none","ruby":[[6,1,"かれ"],[12,1,"む"],[18,1,"こば"],[33,1,"いし"],[34,1,"つ"],[37,1,"かれ"],[39,1,"はら"],[41,1,"つ"],[52,2,"せなか"],[55,1,"で"],[58,1,"かれ"],[63,1,"たお"],[69,1,"ば"],[71,1,"し"],[83,1,"たお"],[86,1,"し"],[91,2,"ばしょ"],[94,1,"く"],[96,1,"もの"],[98,1,"みな"],[99,1,"た"]],"text":"それでもなお彼は、ほかに向かうことを拒んだので、アブネルは、やりの石突きで彼の腹を突いたので、やりはその背中に出た。彼はそこに倒れて、その場で死んだ。そしてアサヘルが倒れて死んでいる場所に来る者は皆立ちとどまった。"},{"ref":"2Sam.2.24","start":10002024,"end":10002024,"break":"paragraph","ruby":[[25,1,"お"],[30,1,"かれ"],[38,2,"あらの"],[41,1,"みち"],[50,1,"まえ"],[58,1,"やま"],[62,1,"とき"],[64,1,"ひ"],[66,1,"く"]],"text":"しかしヨアブとアビシャイとは、なおアブネルのあとを追ったが、彼らがギベオンの荒野の道のほとり、ギアの前にあるアンマの山にきた時、日は暮れた。"},{"ref":"2Sam.2.25","start":10002025,"end":10002025,"break":"none","ruby":[[6,2,"ひとびと"],[23,1,"あつ"],[28,1,"たい"],[37,1,"やま"],[39,1,"いただき"],[41,1,"た"]],"text":"ベニヤミンの人々はアブネルのあとについてきて、集まり、一隊となって、一つの山の頂に立った。"},{"ref":"2Sam.2.26","start":10002026,"end":10002026,"break":"none","ruby":[[2,1,"とき"],[12,1,"よ"],[17,1,"い"],[34,1,"ほろ"],[50,2,"けっか"],[53,2,"ひさん"],[58,1,"し"],[69,1,"たみ"],[73,2,"きょうだい"],[76,1,"お"],[85,1,"めい"]],"text":"その時アブネルはヨアブに呼ばわって言った、「いつまでもつるぎをもって滅ぼそうとするのか。あなたはその結果の悲惨なのを知らないのか。いつまで民にその兄弟を追うことをやめよと命じないのか」。"},{"ref":"2Sam.2.27","start":10002027,"end":10002027,"break":"none","ruby":[[4,1,"い"],[9,1,"かみ"],[11,1,"い"],[25,1,"い"],[37,1,"たみ"],[45,2,"きょうだい"],[48,1,"お"],[53,1,"あさ"],[58,1,"さ"]],"text":"ヨアブは言った、「神は生きておられる。もしあなたが言いださなかったならば、民はおのおのその兄弟を追わずに、朝のうちに去っていたであろう」。"},{"ref":"2Sam.2.28","start":10002028,"end":10002028,"break":"none","ruby":[[8,2,"つのぶえ"],[11,1,"ふ"],[17,1,"たみ"],[21,1,"た"],[41,1,"お"],[47,1,"かさ"],[50,1,"たたか"]],"text":"こうしてヨアブは角笛を吹いたので、民はみな立ちとどまって、もはやイスラエルのあとを追わず、また重ねて戦わなかった。"},{"ref":"2Sam.2.29","start":10002029,"end":10002029,"break":"paragraph","ruby":[[7,2,"じゅうしゃ"],[13,1,"よ"],[23,1,"とお"],[26,1,"い"],[34,1,"わた"],[37,1,"ひる"],[40,2,"こうしん"],[43,1,"つづ"],[52,1,"つ"]],"text":"アブネルとその従者たちは、夜もすがら、アラバを通って行き、ヨルダンを渡り、昼まで行進を続けてマハナイムに着いた。"},{"ref":"2Sam.2.30","start":10002030,"end":10002030,"break":"none","ruby":[[9,1,"お"],[17,1,"かえ"],[20,1,"たみ"],[24,1,"あつ"],[33,2,"けらい"],[39,1,"ひと"],[47,2,"みあた"]],"text":"ヨアブはアブネルを追うことをやめて帰り、民をみな集めたが、ダビデの家来たち十九人とアサヘルとが見当らなかった。"},{"ref":"2Sam.2.31","start":10002031,"end":10002031,"break":"none","ruby":[[8,2,"けらい"],[19,2,"じゅうしゃ"],[30,2,"ひとびと"],[36,1,"にん"],[38,1,"う"],[40,1,"ころ"]],"text":"しかし、ダビデの家来たちは、アブネルの従者であるベニヤミンの人々三百六十人を撃ち殺した。"},{"ref":"2Sam.2.32","start":10002032,"end":10002032,"break":"none","ruby":[[0,2,"ひとびと"],[8,1,"と"],[10,1,"あ"],[23,1,"ちち"],[25,1,"はか"],[27,1,"ほうむ"],[37,2,"じゅうしゃ"],[43,1,"よ"],[48,1,"い"],[52,2,"よあ"],[61,1,"つ"]],"text":"人々はアサヘルを取り上げてベツレヘムにあるその父の墓に葬った。ヨアブとその従者たちは、夜もすがら行って、夜明けにヘブロンに着いた。"}]