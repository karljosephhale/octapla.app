[{"ref":"Mark.16.1","start":41016001,"end":41016001,"break":"paragraph","ruby":[[3,3,"あんそくにち"],[7,1,"おわ"],[26,1,"はは"],[37,1,"い"],[44,1,"ぬ"],[50,2,"こうりょう"],[53,1,"か"],[55,1,"もと"]],"text":"さて、安息日が終ったので、マグダラのマリヤとヤコブの母マリヤとサロメとが、行ってイエスに塗るために、香料を買い求めた。"},{"ref":"Mark.16.2","start":41016002,"end":41016002,"break":"none","ruby":[[3,1,"しゅう"],[5,1,"はじ"],[8,1,"ひ"],[11,2,"そうちょう"],[14,1,"ひ"],[16,1,"で"],[20,1,"はか"],[22,1,"い"]],"text":"そして週の初めの日に、早朝、日の出のころ墓に行った。"},{"ref":"Mark.16.3","start":41016003,"end":41016003,"break":"none","ruby":[[4,1,"かれ"],[22,1,"はか"],[24,2,"いりぐち"],[28,1,"いし"],[46,1,"はな"],[48,1,"あ"]],"text":"そして、彼らは「だれが、わたしたちのために、墓の入口から石をころがしてくれるのでしょうか」と話し合っていた。"},{"ref":"Mark.16.4","start":41016004,"end":41016004,"break":"none","ruby":[[5,1,"め"],[10,1,"み"],[14,1,"いし"],[30,1,"いし"],[32,2,"ひじょう"],[35,1,"おお"]],"text":"ところが、目をあげて見ると、石はすでにころがしてあった。この石は非常に大きかった。"},{"ref":"Mark.16.5","start":41016005,"end":41016005,"break":"none","ruby":[[0,1,"はか"],[2,1,"なか"],[9,2,"みぎて"],[12,2,"まっしろ"],[15,1,"なが"],[17,1,"ころも"],[19,1,"き"],[21,2,"わかもの"],[32,1,"み"],[35,2,"ひじょう"],[38,1,"おどろ"]],"text":"墓の中にはいると、右手に真白な長い衣を着た若者がすわっているのを見て、非常に驚いた。"},{"ref":"Mark.16.6","start":41016006,"end":41016006,"break":"none","ruby":[[5,2,"わかもの"],[8,1,"い"],[13,1,"おどろ"],[27,3,"じゅうじか"],[39,1,"びと"],[44,1,"さが"],[88,1,"おさ"],[92,2,"ばしょ"]],"text":"するとこの若者は言った、「驚くことはない。あなたがたは十字架につけられたナザレ人イエスを捜しているのであろうが、イエスはよみがえって、ここにはおられない。ごらんなさい、ここがお納めした場所である。"},{"ref":"Mark.16.7","start":41016007,"end":41016007,"break":"none","ruby":[[0,1,"いま"],[3,2,"でし"],[13,1,"ところ"],[15,1,"い"],[21,1,"つた"],[38,1,"さき"],[45,1,"い"],[60,1,"い"],[72,1,"あ"]],"text":"今から弟子たちとペテロとの所へ行って、こう伝えなさい。イエスはあなたがたより先にガリラヤへ行かれる。かねて、あなたがたに言われたとおり、そこでお会いできるであろう、と」。"},{"ref":"Mark.16.8","start":41016008,"end":41016008,"break":"none","breaks":[[53,"paragraph"]],"ruby":[[0,1,"おんな"],[8,1,"おそ"],[14,1,"はか"],[17,1,"で"],[19,1,"に"],[21,1,"さ"],[29,1,"ひと"],[32,1,"なに"],[34,1,"い"],[41,1,"おそ"]],"text":"女たちはおののき恐れながら、墓から出て逃げ去った。そして、人には何も言わなかった。恐ろしかったからである。〔"},{"ref":"Mark.16.9","start":41016009,"end":41016009,"break":"none","ruby":[[0,1,"しゅう"],[2,1,"はじ"],[5,1,"ひ"],[7,1,"あさ"],[8,1,"はや"],[33,1,"ご"],[34,2,"じしん"],[48,2,"いぜん"],[54,1,"おんな"],[60,2,"あくれい"],[63,1,"お"],[65,1,"だ"]],"text":"週の初めの日の朝早く、イエスはよみがえって、まずマグダラのマリヤに御自身をあらわされた。イエスは以前に、この女から七つの悪霊を追い出されたことがある。"},{"ref":"Mark.16.10","start":41016010,"end":41016010,"break":"none","ruby":[[9,2,"いっしょ"],[14,2,"ひとびと"],[17,1,"な"],[19,1,"かな"],[25,1,"ところ"],[27,1,"い"],[34,1,"し"]],"text":"マリヤは、イエスと一緒にいた人々が泣き悲しんでいる所に行って、それを知らせた。"},{"ref":"Mark.16.11","start":41016011,"end":41016011,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[15,1,"こと"],[18,2,"かのじょ"],[21,1,"ご"],[22,2,"じしん"],[31,1,"こと"],[34,1,"き"],[39,1,"しん"]],"text":"彼らは、イエスが生きておられる事と、彼女に御自身をあらわされた事とを聞いたが、信じなかった。"},{"ref":"Mark.16.12","start":41016012,"end":41016012,"break":"paragraph","ruby":[[2,1,"のち"],[18,1,"ほう"],[20,1,"ある"],[35,1,"すがた"],[37,1,"ご"],[38,2,"じしん"]],"text":"この後、そのうちのふたりが、いなかの方へ歩いていると、イエスはちがった姿で御自身をあらわされた。"},{"ref":"Mark.16.13","start":41016013,"end":41016013,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"ところ"],[15,1,"い"],[18,1,"はな"],[23,1,"かれ"],[28,1,"はなし"],[30,1,"しん"]],"text":"このふたりも、ほかの人々の所に行って話したが、彼らはその話を信じなかった。"},{"ref":"Mark.16.14","start":41016014,"end":41016014,"break":"paragraph","ruby":[[2,1,"のち"],[10,2,"でし"],[13,2,"しょくたく"],[25,1,"あらわ"],[28,1,"かれ"],[31,1,"ふ"],[32,2,"しんこう"],[36,1,"こころ"],[47,1,"せ"],[54,1,"かれ"],[69,1,"み"],[71,2,"ひとびと"],[74,1,"い"],[80,1,"しん"]],"text":"その後、イエスは十一弟子が食卓についているところに現れ、彼らの不信仰と、心のかたくななことをお責めになった。彼らは、よみがえられたイエスを見た人々の言うことを、信じなかったからである。"},{"ref":"Mark.16.15","start":41016015,"end":41016015,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[12,1,"ぜん"],[13,2,"せかい"],[16,1,"で"],[18,1,"い"],[26,1,"つく"],[33,2,"ふくいん"],[36,1,"の"],[38,1,"つた"]],"text":"そして彼らに言われた、「全世界に出て行って、すべての造られたものに福音を宣べ伝えよ。"},{"ref":"Mark.16.16","start":41016016,"end":41016016,"break":"none","ruby":[[0,1,"しん"],[9,1,"う"],[12,1,"もの"],[14,1,"すく"],[23,1,"ふ"],[24,2,"しんこう"],[27,1,"もの"],[29,1,"つみ"],[31,1,"さだ"]],"text":"信じてバプテスマを受ける者は救われる。しかし、不信仰の者は罪に定められる。"},{"ref":"Mark.16.17","start":41016017,"end":41016017,"break":"none","ruby":[[0,1,"しん"],[3,1,"もの"],[16,1,"ともな"],[24,1,"かれ"],[31,1,"な"],[33,2,"あくれい"],[36,1,"お"],[38,1,"だ"],[41,1,"あたら"],[44,2,"ことば"],[47,1,"かた"]],"text":"信じる者には、このようなしるしが伴う。すなわち、彼らはわたしの名で悪霊を追い出し、新しい言葉を語り、"},{"ref":"Mark.16.18","start":41016018,"end":41016018,"break":"none","ruby":[[14,1,"どく"],[16,1,"の"],[21,1,"けっ"],[24,1,"がい"],[26,1,"う"],[31,2,"びょうにん"],[34,1,"て"]],"text":"へびをつかむであろう。また、毒を飲んでも、決して害を受けない。病人に手をおけば、いやされる」。"},{"ref":"Mark.16.19","start":41016019,"end":41016019,"break":"paragraph","ruby":[[0,1,"しゅ"],[5,1,"かれ"],[8,1,"かた"],[10,1,"おわ"],[16,1,"てん"],[23,1,"かみ"],[25,1,"みぎ"]],"text":"主イエスは彼らに語り終ってから、天にあげられ、神の右にすわられた。"},{"ref":"Mark.16.20","start":41016020,"end":41016020,"break":"none","ruby":[[0,2,"でし"],[5,1,"で"],[7,1,"い"],[11,1,"いた"],[13,1,"ところ"],[15,2,"ふくいん"],[18,1,"の"],[20,1,"つた"],[24,1,"しゅ"],[26,1,"かれ"],[29,1,"とも"],[31,1,"はたら"],[34,2,"みことば"],[37,1,"ともな"],[49,1,"たし"],[56,1,"しめ"]],"text":"弟子たちは出て行って、至る所で福音を宣べ伝えた。主も彼らと共に働き、御言に伴うしるしをもって、その確かなことをお示しになった。〕"}]