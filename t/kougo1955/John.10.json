[{"ref":"John.10.1","start":43010001,"end":43010001,"break":"paragraph","ruby":[[10,1,"い"],[16,1,"ひつじ"],[18,1,"かこ"],[27,1,"もん"],[37,1,"ところ"],[45,1,"く"],[47,1,"もの"],[50,2,"ぬすびと"],[56,2,"ごうとう"]],"text":"よくよくあなたがたに言っておく。羊の囲いにはいるのに、門からでなく、ほかの所からのりこえて来る者は、盗人であり、強盗である。"},{"ref":"John.10.2","start":43010002,"end":43010002,"break":"none","ruby":[[0,1,"もん"],[6,1,"もの"],[9,1,"ひつじ"],[11,2,"ひつじかい"]],"text":"門からはいる者は、羊の羊飼である。"},{"ref":"John.10.3","start":43010003,"end":43010003,"break":"none","ruby":[[0,2,"もんばん"],[3,1,"かれ"],[8,1,"もん"],[10,1,"ひら"],[13,1,"ひつじ"],[15,1,"かれ"],[17,1,"こえ"],[19,1,"き"],[25,1,"かれ"],[27,2,"じぶん"],[30,1,"ひつじ"],[32,1,"な"],[37,1,"つ"],[39,1,"だ"]],"text":"門番は彼のために門を開き、羊は彼の声を聞く。そして彼は自分の羊の名をよんで連れ出す。"},{"ref":"John.10.4","start":43010004,"end":43010004,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"ひつじ"],[7,1,"だ"],[15,1,"かれ"],[17,1,"ひつじ"],[19,2,"せんとう"],[22,1,"た"],[25,1,"い"],[28,1,"ひつじ"],[32,1,"こえ"],[34,1,"し"],[42,1,"かれ"],[47,1,"い"]],"text":"自分の羊をみな出してしまうと、彼は羊の先頭に立って行く。羊はその声を知っているので、彼について行くのである。"},{"ref":"John.10.5","start":43010005,"end":43010005,"break":"none","ruby":[[3,1,"ひと"],[10,1,"い"],[15,1,"に"],[17,1,"さ"],[22,1,"ひと"],[24,1,"こえ"],[26,1,"し"]],"text":"ほかの人には、ついて行かないで逃げ去る。その人の声を知らないからである」。"},{"ref":"John.10.6","start":43010006,"end":43010006,"break":"none","ruby":[[4,1,"かれ"],[9,2,"ひゆ"],[12,1,"はな"],[18,1,"かれ"],[21,2,"じぶん"],[27,1,"はな"],[37,1,"なに"]],"text":"イエスは彼らにこの比喩を話されたが、彼らは自分たちにお話しになっているのが何のことだか、わからなかった。"},{"ref":"John.10.7","start":43010007,"end":43010007,"break":"paragraph","ruby":[[10,1,"い"],[26,1,"い"],[36,1,"ひつじ"],[38,1,"もん"]],"text":"そこで、イエスはまた言われた、「よくよくあなたがたに言っておく。わたしは羊の門である。"},{"ref":"John.10.8","start":43010008,"end":43010008,"break":"none","ruby":[[6,1,"まえ"],[10,1,"ひと"],[15,2,"ぬすびと"],[21,2,"ごうとう"],[27,1,"ひつじ"],[29,1,"かれ"],[32,1,"き"],[34,1,"したが"]],"text":"わたしよりも前にきた人は、みな盗人であり、強盗である。羊は彼らに聞き従わなかった。"},{"ref":"John.10.9","start":43010009,"end":43010009,"break":"none","ruby":[[4,1,"もん"],[20,1,"もの"],[22,1,"すく"],[28,2,"でい"],[33,2,"ぼくそう"]],"text":"わたしは門である。わたしをとおってはいる者は救われ、また出入りし、牧草にありつくであろう。"},{"ref":"John.10.10","start":43010010,"end":43010010,"break":"none","ruby":[[0,2,"ぬすびと"],[3,1,"く"],[8,1,"ぬす"],[13,1,"ころ"],[18,1,"ほろ"],[44,1,"ひつじ"],[46,1,"いのち"],[48,1,"え"],[52,1,"ゆた"],[55,1,"え"]],"text":"盗人が来るのは、盗んだり、殺したり、滅ぼしたりするためにほかならない。わたしがきたのは、羊に命を得させ、豊かに得させるためである。"},{"ref":"John.10.11","start":43010011,"end":43010011,"break":"none","ruby":[[6,2,"ひつじかい"],[14,2,"ひつじかい"],[18,1,"ひつじ"],[23,1,"いのち"],[25,1,"す"]],"text":"わたしはよい羊飼である。よい羊飼は、羊のために命を捨てる。"},{"ref":"John.10.12","start":43010012,"end":43010012,"break":"none","ruby":[[0,2,"ひつじかい"],[7,1,"ひつじ"],[9,2,"じぶん"],[18,2,"やといにん"],[27,1,"く"],[31,1,"み"],[35,1,"ひつじ"],[40,1,"に"],[42,1,"さ"],[54,1,"ひつじ"],[56,1,"うば"],[61,1,"お"],[63,1,"ち"]],"text":"羊飼ではなく、羊が自分のものでもない雇人は、おおかみが来るのを見ると、羊をすてて逃げ去る。そして、おおかみは羊を奪い、また追い散らす。"},{"ref":"John.10.13","start":43010013,"end":43010013,"break":"none","ruby":[[0,1,"かれ"],[2,2,"やといにん"],[9,1,"ひつじ"],[14,1,"こころ"]],"text":"彼は雇人であって、羊のことを心にかけていないからである。"},{"ref":"John.10.14","start":43010014,"end":43010014,"break":"none","ruby":[[6,2,"ひつじかい"],[17,1,"ひつじ"],[19,1,"し"],[26,1,"ひつじ"],[35,1,"し"]],"text":"わたしはよい羊飼であって、わたしの羊を知り、わたしの羊はまた、わたしを知っている。"},{"ref":"John.10.15","start":43010015,"end":43010015,"break":"none","ruby":[[8,1,"ちち"],[14,1,"し"],[25,1,"ちち"],[27,1,"し"],[34,1,"おな"],[48,1,"ひつじ"],[53,1,"いのち"],[55,1,"す"]],"text":"それはちょうど、父がわたしを知っておられ、わたしが父を知っているのと同じである。そして、わたしは羊のために命を捨てるのである。"},{"ref":"John.10.16","start":43010016,"end":43010016,"break":"none","ruby":[[10,1,"かこ"],[16,1,"た"],[18,1,"ひつじ"],[27,1,"かれ"],[31,1,"みちび"],[40,1,"かれ"],[48,1,"こえ"],[50,1,"き"],[52,1,"したが"],[69,1,"む"],[76,2,"ひつじかい"]],"text":"わたしにはまた、この囲いにいない他の羊がある。わたしは彼らをも導かねばならない。彼らも、わたしの声に聞き従うであろう。そして、ついに一つの群れ、ひとりの羊飼となるであろう。"},{"ref":"John.10.17","start":43010017,"end":43010017,"break":"none","ruby":[[0,1,"ちち"],[7,2,"じぶん"],[10,1,"いのち"],[12,1,"す"],[22,1,"あい"],[25,1,"くだ"],[33,1,"いのち"],[35,1,"す"],[44,1,"ふたた"],[46,1,"え"]],"text":"父は、わたしが自分の命を捨てるから、わたしを愛して下さるのである。命を捨てるのは、それを再び得るためである。"},{"ref":"John.10.18","start":43010018,"end":43010018,"break":"none","ruby":[[13,1,"と"],[15,1,"さ"],[28,2,"じぶん"],[35,1,"す"],[52,1,"す"],[55,1,"ちから"],[65,1,"う"],[68,1,"ちから"],[80,1,"ちち"],[83,1,"さず"],[87,1,"さだ"]],"text":"だれかが、わたしからそれを取り去るのではない。わたしが、自分からそれを捨てるのである。わたしには、それを捨てる力があり、またそれを受ける力もある。これはわたしの父から授かった定めである」。"},{"ref":"John.10.19","start":43010019,"end":43010019,"break":"paragraph","ruby":[[4,2,"ことば"],[7,1,"かた"],[17,1,"じん"],[19,1,"あいだ"],[24,2,"ぶんそう"],[27,1,"しょう"]],"text":"これらの言葉を語られたため、ユダヤ人の間にまたも分争が生じた。"},{"ref":"John.10.20","start":43010020,"end":43010020,"break":"none","ruby":[[5,1,"おお"],[8,1,"もの"],[10,1,"い"],[15,1,"かれ"],[17,2,"あくれい"],[20,1,"と"],[27,1,"き"],[29,1,"くる"],[48,1,"い"],[53,1,"き"]],"text":"そのうちの多くの者が言った、「彼は悪霊に取りつかれて、気が狂っている。どうして、あなたがたはその言うことを聞くのか」。"},{"ref":"John.10.21","start":43010021,"end":43010021,"break":"none","ruby":[[0,1,"た"],[2,2,"ひとびと"],[5,1,"い"],[13,2,"あくれい"],[16,1,"と"],[22,1,"もの"],[24,2,"ことば"],[31,2,"あくれい"],[34,2,"もうじん"],[37,1,"め"]],"text":"他の人々は言った、「それは悪霊に取りつかれた者の言葉ではない。悪霊は盲人の目をあけることができようか」。"},{"ref":"John.10.22","start":43010022,"end":43010022,"break":"paragraph","ruby":[[11,1,"みや"],[16,1,"まつり"],[18,1,"おこな"],[23,1,"とき"],[25,1,"ふゆ"]],"text":"そのころ、エルサレムで宮きよめの祭が行われた。時は冬であった。"},{"ref":"John.10.23","start":43010023,"end":43010023,"break":"none","ruby":[[5,1,"みや"],[7,1,"なか"],[16,1,"ろう"],[18,1,"ある"]],"text":"イエスは、宮の中にあるソロモンの廊を歩いておられた。"},{"ref":"John.10.24","start":43010024,"end":43010024,"break":"none","ruby":[[6,1,"じん"],[15,1,"と"],[17,1,"かこ"],[20,1,"い"],[35,2,"ふあん"],[69,1,"い"]],"text":"するとユダヤ人たちが、イエスを取り囲んで言った、「いつまでわたしたちを不安のままにしておくのか。あなたがキリストであるなら、そうとはっきり言っていただきたい」。"},{"ref":"John.10.25","start":43010025,"end":43010025,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[18,1,"はな"],[31,1,"しん"],[44,1,"ちち"],[46,1,"な"]],"text":"イエスは彼らに答えられた、「わたしは話したのだが、あなたがたは信じようとしない。わたしの父の名によってしているすべてのわざが、わたしのことをあかししている。"},{"ref":"John.10.26","start":43010026,"end":43010026,"break":"none","ruby":[[6,1,"しん"],[17,1,"ひつじ"]],"text":"あなたがたが信じないのは、わたしの羊でないからである。"},{"ref":"John.10.27","start":43010027,"end":43010027,"break":"none","ruby":[[4,1,"ひつじ"],[10,1,"こえ"],[12,1,"き"],[14,1,"したが"],[21,1,"かれ"],[24,1,"し"],[30,1,"かれ"],[40,1,"く"]],"text":"わたしの羊はわたしの声に聞き従う。わたしは彼らを知っており、彼らはわたしについて来る。"},{"ref":"John.10.28","start":43010028,"end":43010028,"break":"none","ruby":[[5,1,"かれ"],[8,2,"えいえん"],[11,1,"いのち"],[13,1,"あた"],[21,1,"かれ"],[29,1,"ほろ"],[41,1,"かれ"],[48,1,"て"],[51,1,"うば"],[53,1,"さ"],[55,1,"もの"]],"text":"わたしは、彼らに永遠の命を与える。だから、彼らはいつまでも滅びることがなく、また、彼らをわたしの手から奪い去る者はない。"},{"ref":"John.10.29","start":43010029,"end":43010029,"break":"none","ruby":[[4,1,"ちち"],[10,1,"くだ"],[37,1,"ちち"],[40,1,"て"],[47,1,"うば"],[49,1,"と"]],"text":"わたしの父がわたしに下さったものは、すべてにまさるものである。そしてだれも父のみ手から、それを奪い取ることはできない。"},{"ref":"John.10.30","start":43010030,"end":43010030,"break":"none","ruby":[[4,1,"ちち"]],"text":"わたしと父とは一つである」。"},{"ref":"John.10.31","start":43010031,"end":43010031,"break":"none","ruby":[[6,1,"じん"],[15,1,"う"],[17,1,"ころ"],[26,1,"いし"],[28,1,"と"]],"text":"そこでユダヤ人たちは、イエスを打ち殺そうとして、また石を取りあげた。"},{"ref":"John.10.32","start":43010032,"end":43010032,"break":"none","ruby":[[7,1,"かれ"],[10,1,"こた"],[22,1,"ちち"],[26,1,"おお"],[41,1,"しめ"],[47,1,"なか"],[62,1,"いし"],[64,1,"う"],[66,1,"ころ"]],"text":"するとイエスは彼らに答えられた、「わたしは、父による多くのよいわざを、あなたがたに示した。その中のどのわざのために、わたしを石で打ち殺そうとするのか」。"},{"ref":"John.10.33","start":43010033,"end":43010033,"break":"none","ruby":[[3,1,"じん"],[7,1,"こた"],[16,1,"いし"],[18,1,"ころ"],[41,1,"かみ"],[43,1,"けが"],[59,2,"にんげん"],[67,2,"じぶん"],[70,1,"かみ"]],"text":"ユダヤ人たちは答えた、「あなたを石で殺そうとするのは、よいわざをしたからではなく、神を汚したからである。また、あなたは人間であるのに、自分を神としているからである」。"},{"ref":"John.10.34","start":43010034,"end":43010034,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[20,2,"りっぽう"],[29,1,"い"],[38,2,"かみがみ"],[45,1,"か"]],"text":"イエスは彼らに答えられた、「あなたがたの律法に、『わたしは言う、あなたがたは神々である』と書いてあるではないか。"},{"ref":"John.10.35","start":43010035,"end":43010035,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ことば"],[4,1,"たく"],[8,2,"ひとびと"],[12,2,"かみがみ"],[30,2,"せいしょ"],[33,1,"ことば"],[44,1,"え"]],"text":"神の言を託された人々が、神々といわれておるとすれば、（そして聖書の言は、すたることがあり得ない）"},{"ref":"John.10.36","start":43010036,"end":43010036,"break":"none","ruby":[[0,1,"ちち"],[2,1,"せい"],[3,1,"べつ"],[7,1,"よ"],[15,1,"もの"],[23,1,"かみ"],[25,1,"こ"],[31,1,"い"],[48,1,"かみ"],[50,1,"けが"],[52,1,"もの"],[56,1,"い"]],"text":"父が聖別して、世につかわされた者が、『わたしは神の子である』と言ったからとて、どうして『あなたは神を汚す者だ』と言うのか。"},{"ref":"John.10.37","start":43010037,"end":43010037,"break":"none","ruby":[[6,1,"ちち"],[11,1,"おこな"],[24,1,"しん"]],"text":"もしわたしが父のわざを行わないとすれば、わたしを信じなくてもよい。"},{"ref":"John.10.38","start":43010038,"end":43010038,"break":"none","ruby":[[6,1,"おこな"],[21,1,"しん"],[35,1,"しん"],[48,1,"ちち"],[64,1,"ちち"],[71,1,"し"],[74,1,"さと"]],"text":"しかし、もし行っているなら、たといわたしを信じなくても、わたしのわざを信じるがよい。そうすれば、父がわたしにおり、また、わたしが父におることを知って悟るであろう」。"},{"ref":"John.10.39","start":43010039,"end":43010039,"break":"none","ruby":[[4,1,"かれ"],[13,1,"とら"],[26,1,"かれ"],[29,1,"て"],[36,1,"さ"],[39,1,"い"]],"text":"そこで、彼らはまたイエスを捕えようとしたが、イエスは彼らの手をのがれて、去って行かれた。"},{"ref":"John.10.40","start":43010040,"end":43010040,"break":"paragraph","ruby":[[14,1,"む"],[17,1,"ぎし"],[28,1,"はじ"],[37,1,"さづ"],[42,1,"ところ"],[44,1,"い"],[50,2,"たいざい"]],"text":"さて、イエスはまたヨルダンの向こう岸、すなわち、ヨハネが初めにバプテスマを授けていた所に行き、そこに滞在しておられた。"},{"ref":"John.10.41","start":43010041,"end":43010041,"break":"none","ruby":[[0,1,"おお"],[3,2,"ひとびと"],[17,1,"たがい"],[19,1,"い"],[35,1,"おこな"],[55,1,"い"],[62,1,"みな"]],"text":"多くの人々がイエスのところにきて、互に言った、「ヨハネはなんのしるしも行わなかったが、ヨハネがこのかたについて言ったことは、皆ほんとうであった」。"},{"ref":"John.10.42","start":43010042,"end":43010042,"break":"none","ruby":[[7,1,"おお"],[10,1,"もの"],[16,1,"しん"]],"text":"そして、そこで多くの者がイエスを信じた。"}]