[{"ref":"Esth.7.1","start":17007001,"end":17007001,"break":"paragraph","ruby":[[0,1,"おう"],[6,2,"おうひ"],[13,2,"しゅえん"],[16,1,"のぞ"]],"text":"王とハマンは王妃エステルの酒宴に臨んだ。"},{"ref":"Esth.7.2","start":17007002,"end":17007002,"break":"none","ruby":[[5,1,"め"],[7,2,"しゅえん"],[10,1,"おう"],[19,1,"い"],[24,2,"おうひ"],[36,1,"もと"],[42,1,"なに"],[45,1,"かなら"],[47,1,"き"],[56,1,"ねが"],[59,1,"なに"],[62,1,"くに"],[64,1,"なか"],[68,1,"き"]],"text":"このふつか目の酒宴に王はまたエステルに言った、「王妃エステルよ、あなたの求めることは何か。必ず聞かれる。あなたの願いは何か。国の半ばでも聞きとどけられる」。"},{"ref":"Esth.7.3","start":17007003,"end":17007003,"break":"none","ruby":[[0,2,"おうひ"],[7,1,"こた"],[10,1,"い"],[15,1,"おう"],[24,1,"おう"],[26,1,"め"],[28,1,"まえ"],[30,1,"めぐ"],[33,1,"え"],[37,1,"おう"],[55,1,"もと"],[67,1,"いのち"],[73,1,"あた"],[82,1,"ねが"],[94,1,"たみ"],[100,1,"あた"]],"text":"王妃エステルは答えて言った、「王よ、もしわたしが王の目の前に恵みを得、また王がもしよしとされるならば、わたしの求めにしたがってわたしの命をわたしに与え、またわたしの願いにしたがってわたしの民をわたしに与えてください。"},{"ref":"Esth.7.4","start":17007004,"end":17007004,"break":"none","ruby":[[8,1,"たみ"],[10,1,"う"],[14,1,"ほろ"],[19,1,"ころ"],[23,1,"た"],[44,2,"だんじょ"],[47,2,"どれい"],[52,1,"う"],[65,1,"だま"],[81,2,"なんぎ"],[84,1,"おう"],[86,2,"そんしつ"],[90,2,"ひかく"]],"text":"わたしとわたしの民は売られて滅ぼされ、殺され、絶やされようとしています。もしわたしたちが男女の奴隷として売られただけなら、わたしは黙っていたでしょう。わたしたちの難儀は王の損失とは比較にならないからです」。"},{"ref":"Esth.7.5","start":17007005,"end":17007005,"break":"none","ruby":[[7,1,"おう"],[9,2,"おうひ"],[16,1,"い"],[24,1,"こと"],[30,1,"こころ"],[39,1,"もの"]],"text":"アハシュエロス王は王妃エステルに言った、「そんな事をしようと心にたくらんでいる者はだれか。またどこにいるのか」。"},{"ref":"Esth.7.6","start":17007006,"end":17007006,"break":"none","ruby":[[5,1,"い"],[17,1,"てき"],[21,1,"わる"],[37,1,"おう"],[39,2,"おうひ"],[42,1,"まえ"],[44,1,"おそ"]],"text":"エステルは言った、「そのあだ、その敵はこの悪いハマンです」。そこでハマンは王と王妃の前に恐れおののいた。"},{"ref":"Esth.7.7","start":17007007,"end":17007007,"break":"none","ruby":[[0,1,"おう"],[2,1,"いか"],[5,2,"しゅえん"],[8,1,"せき"],[10,1,"た"],[13,2,"きゅうでん"],[16,1,"その"],[18,1,"い"],[27,1,"のこ"],[30,2,"おうひ"],[37,1,"いのち"],[44,1,"かれ"],[46,1,"おう"],[48,2,"じぶん"],[51,1,"がい"],[53,1,"くわ"],[58,1,"さだ"],[63,1,"み"]],"text":"王は怒って酒宴の席を立ち、宮殿の園へ行ったが、ハマンは残って王妃エステルに命ごいをした。彼は王が自分に害を加えようと定めたのを見たからである。"},{"ref":"Esth.7.8","start":17007008,"end":17007008,"break":"none","ruby":[[0,1,"おう"],[2,2,"きゅうでん"],[5,1,"その"],[8,2,"しゅえん"],[11,2,"ばしょ"],[14,1,"かえ"],[28,1,"なが"],[32,1,"うえ"],[38,1,"ふ"],[46,1,"おう"],[48,1,"い"],[53,1,"かれ"],[61,1,"いえ"],[71,1,"まえ"],[73,2,"おうひ"],[92,2,"ことば"],[95,1,"おう"],[97,1,"くち"],[100,1,"で"],[105,2,"ひとびと"],[113,1,"かお"]],"text":"王が宮殿の園から酒宴の場所に帰ってみると、エステルのいた長いすの上にハマンが伏していたので、王は言った、「彼はまたわたしの家で、しかもわたしの前で王妃をはずかしめようとするのか」。この言葉が王の口から出たとき、人々は、ハマンの顔をおおった。"},{"ref":"Esth.7.9","start":17007009,"end":17007009,"break":"none","ruby":[[2,1,"とき"],[4,1,"おう"],[6,1,"つ"],[8,1,"そ"],[17,2,"じじゅう"],[25,1,"おう"],[32,1,"こと"],[34,1,"つ"],[52,2,"ようい"],[56,1,"たか"],[65,1,"き"],[71,1,"いえ"],[73,1,"た"],[81,1,"い"],[87,1,"おう"],[90,1,"かれ"],[95,1,"か"],[100,1,"い"]],"text":"その時、王に付き添っていたひとりの侍従ハルボナが「王のためによい事を告げたあのモルデカイのためにハマンが用意した高さ五十キュビトの木がハマンの家に立っています」と言ったので、王は「彼をそれに掛けよ」と言った。"},{"ref":"Esth.7.10","start":17007010,"end":17007010,"break":"none","ruby":[[3,2,"ひとびと"],[19,1,"そな"],[27,1,"き"],[29,1,"か"],[37,1,"おう"],[39,1,"いか"],[42,1,"やわ"]],"text":"そこで人々はハマンをモルデカイのために備えてあったその木に掛けた。こうして王の怒りは和らいだ。"}]