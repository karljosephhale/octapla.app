[{"ref":"1Chr.27.1","start":13027001,"end":13027001,"break":"paragraph","ruby":[[6,2,"しそん"],[12,2,"しぞく"],[15,1,"ちょう"],[17,1,"せん"],[18,1,"にん"],[20,1,"ちょう"],[23,1,"にん"],[25,1,"ちょう"],[36,1,"ねん"],[42,1,"つき"],[44,1,"あいだ"],[46,1,"つき"],[50,2,"こうたい"],[54,1,"くみ"],[60,1,"こと"],[65,1,"おう"],[67,1,"つか"],[74,1,"かず"],[81,2,"かくくみ"],[87,1,"にん"]],"text":"イスラエルの子孫のうちで氏族の長、千人の長、百人の長、およびつかさたちは年のすべての月の間、月ごとに交替して組のすべての事をなして王に仕えたが、その数にしたがえば各組二万四千人あった。"},{"ref":"1Chr.27.2","start":13027002,"end":13027002,"break":"none","ruby":[[2,1,"だい"],[5,1,"くみ"],[10,2,"しょうがつ"],[13,1,"ぶん"],[21,1,"こ"],[32,1,"ひき"],[38,1,"くみ"],[45,1,"にん"]],"text":"まず第一の組すなわち正月の分はザブデエルの子ヤショベアムがこれを率いた。その組には二万四千人あった。"},{"ref":"1Chr.27.3","start":13027003,"end":13027003,"break":"none","ruby":[[0,1,"かれ"],[6,2,"しそん"],[10,2,"しょうがつ"],[13,2,"ぐんだん"],[20,1,"しょう"]],"text":"彼はペレヅの子孫で、正月の軍団のすべての将たちのかしらであった。"},{"ref":"1Chr.27.4","start":13027004,"end":13027004,"break":"none","ruby":[[1,1,"がつ"],[3,1,"くみ"],[17,1,"ひき"],[23,1,"くみ"],[30,1,"にん"]],"text":"二月の組はアホアびとドダイがこれを率いた。その組には二万四千人あった。"},{"ref":"1Chr.27.5","start":13027005,"end":13027005,"break":"none","ruby":[[1,1,"がつ"],[3,1,"だい"],[6,1,"しょう"],[8,2,"さいし"],[15,1,"こ"],[20,1,"ちょう"],[28,1,"くみ"],[35,1,"にん"]],"text":"三月の第三の将は祭司エホヤダの子ベナヤが長であって、その組には二万四千人あった。"},{"ref":"1Chr.27.6","start":13027006,"end":13027006,"break":"none","ruby":[[10,1,"にん"],[15,2,"ゆうし"],[23,1,"にん"],[25,1,"ひき"],[30,1,"こ"],[39,1,"くみ"]],"text":"このベナヤはかの三十人のうちの勇士であって三十人を率い、その子アミザバデがその組にあった。"},{"ref":"1Chr.27.7","start":13027007,"end":13027007,"break":"none","ruby":[[1,1,"がつ"],[3,1,"だい"],[6,1,"しょう"],[12,2,"きょうだい"],[25,1,"こ"],[34,1,"つ"],[40,1,"くみ"],[47,1,"にん"]],"text":"四月の第四の将はヨアブの兄弟アサヘルであって、その子ゼバデヤがこれに次いだ。その組には二万四千人あった。"},{"ref":"1Chr.27.8","start":13027008,"end":13027008,"break":"none","ruby":[[1,1,"がつ"],[3,1,"だい"],[6,1,"しょう"],[26,1,"くみ"],[33,1,"にん"]],"text":"五月の第五の将はイズラヒびとシャンモテであって、その組には二万四千人あった。"},{"ref":"1Chr.27.9","start":13027009,"end":13027009,"break":"none","ruby":[[1,1,"がつ"],[3,1,"だい"],[6,1,"しょう"],[18,1,"こ"],[28,1,"くみ"],[35,1,"にん"]],"text":"六月の第六の将はテコアびとイッケシの子イラであって、その組には二万四千人あった。"},{"ref":"1Chr.27.10","start":13027010,"end":13027010,"break":"none","ruby":[[1,1,"がつ"],[3,1,"だい"],[6,1,"しょう"],[14,2,"しそん"],[34,1,"くみ"],[41,1,"にん"]],"text":"七月の第七の将はエフライムの子孫であるペロンびとヘレヅであって、その組には二万四千人あった。"},{"ref":"1Chr.27.11","start":13027011,"end":13027011,"break":"none","ruby":[[1,1,"がつ"],[3,1,"だい"],[6,1,"しょう"],[13,2,"しそん"],[34,1,"くみ"],[41,1,"にん"]],"text":"八月の第八の将はゼラびとの子孫であるホシャびとシベカイであって、その組には二万四千人あった。"},{"ref":"1Chr.27.12","start":13027012,"end":13027012,"break":"none","ruby":[[1,1,"がつ"],[3,1,"だい"],[6,1,"しょう"],[14,2,"しそん"],[37,1,"くみ"],[44,1,"にん"]],"text":"九月の第九の将はベニヤミンの子孫であるアナトテびとアビエゼルであって、その組には二万四千人あった。"},{"ref":"1Chr.27.13","start":13027013,"end":13027013,"break":"none","ruby":[[1,1,"がつ"],[3,1,"だい"],[6,1,"しょう"],[13,2,"しそん"],[34,1,"くみ"],[41,1,"にん"]],"text":"十月の第十の将はゼラびとの子孫であるネトパびとマハライであって、その組には二万四千人あった。"},{"ref":"1Chr.27.14","start":13027014,"end":13027014,"break":"none","ruby":[[2,1,"がつ"],[4,1,"だい"],[8,1,"しょう"],[16,2,"しそん"],[37,1,"くみ"],[44,1,"にん"]],"text":"十一月の第十一の将はエフライムの子孫であるピラトンびとベナヤであって、その組には二万四千人あった。"},{"ref":"1Chr.27.15","start":13027015,"end":13027015,"break":"none","ruby":[[2,1,"がつ"],[4,1,"だい"],[8,1,"しょう"],[16,2,"しそん"],[37,1,"くみ"],[44,1,"にん"]],"text":"十二月の第十二の将はオテニエルの子孫であるネトパびとヘルダイであって、その組には二万四千人あった。"},{"ref":"1Chr.27.16","start":13027016,"end":13027016,"break":"paragraph","ruby":[[8,2,"ぶぞく"],[11,1,"おさ"],[14,1,"もの"],[18,1,"つぎ"],[41,1,"こ"],[63,1,"こ"]],"text":"なおイスラエルの部族を治める者たちは次のとおりである。ルベンびとのつかさはヂクリの子エリエゼル。シメオンびとのつかさはマアカの子シパテヤ。"},{"ref":"1Chr.27.17","start":13027017,"end":13027017,"break":"none","ruby":[[14,1,"こ"]],"text":"レビびとのつかさはケムエルの子ハシャビヤ。アロンびとのつかさはザドク。"},{"ref":"1Chr.27.18","start":13027018,"end":13027018,"break":"none","ruby":[[11,2,"きょうだい"],[36,1,"こ"]],"text":"ユダのつかさはダビデの兄弟のひとりエリウ。イッサカルのつかさはミカエルの子オムリ。"},{"ref":"1Chr.27.19","start":13027019,"end":13027019,"break":"none","ruby":[[14,1,"こ"],[35,1,"こ"]],"text":"ゼブルンのつかさはオバデヤの子イシマヤ。ナフタリのつかさはアズリエルの子エレモテ。"},{"ref":"1Chr.27.20","start":13027020,"end":13027020,"break":"none","ruby":[[6,2,"しそん"],[18,1,"こ"],[27,1,"はん"],[28,2,"ぶぞく"],[39,1,"こ"]],"text":"エフライムの子孫のつかさはアザジヤの子ホセア。マナセの半部族のつかさはペダヤの子ヨエル。"},{"ref":"1Chr.27.21","start":13027021,"end":13027021,"break":"none","ruby":[[11,1,"はん"],[12,2,"ぶぞく"],[24,1,"こ"],[43,1,"こ"]],"text":"ギレアデにあるマナセの半部族のつかさはゼカリヤの子イド。ベニヤミンのつかさはアブネルの子ヤシエル。"},{"ref":"1Chr.27.22","start":13027022,"end":13027022,"break":"none","ruby":[[12,1,"こ"],[29,2,"ぶぞく"]],"text":"ダンのつかさはエロハムの子アザリエル。これらはイスラエルの部族のつかさたちであった。"},{"ref":"1Chr.27.23","start":13027023,"end":13027023,"break":"none","ruby":[[9,1,"さい"],[10,2,"いか"],[13,1,"もの"],[15,1,"かぞ"],[22,1,"しゅ"],[33,1,"てん"],[35,1,"ほし"],[40,1,"おお"],[45,1,"い"]],"text":"しかしダビデは二十歳以下の者は数えなかった。主がかつてイスラエルを天の星のように多くすると言われたからである。"},{"ref":"1Chr.27.24","start":13027024,"end":13027024,"break":"none","ruby":[[4,1,"こ"],[9,1,"かぞ"],[11,1,"はじ"],[21,1,"お"],[30,1,"かぞ"],[39,1,"いか"],[48,1,"うえ"],[50,1,"のぞ"],[58,1,"かず"],[63,1,"おう"],[65,3,"れきだいし"],[69,1,"の"]],"text":"ゼルヤの子ヨアブは数え始めたが、これをなし終えなかった。その数えることによって怒りがイスラエルの上に臨んだ。またその数はダビデ王の歴代志に載せなかった。"},{"ref":"1Chr.27.25","start":13027025,"end":13027025,"break":"paragraph","ruby":[[5,1,"こ"],[12,1,"おう"],[14,1,"くら"],[26,1,"こ"],[32,2,"でんや"],[35,2,"まちまち"],[38,2,"むらむら"],[46,1,"とう"],[50,1,"くら"]],"text":"アデエルの子アズマウテは王の倉をつかさどり、ウジヤの子ヨナタンは田野、町々、村々、もろもろの塔にある倉をつかさどり、"},{"ref":"1Chr.27.26","start":13027026,"end":13027026,"break":"none","ruby":[[4,1,"こ"],[9,1,"ち"],[11,1,"たがや"],[13,2,"のうふ"]],"text":"ケルブの子エズリは地を耕す農夫をつかさどり、"},{"ref":"1Chr.27.27","start":13027027,"end":13027027,"break":"none","ruby":[[12,1,"はたけ"],[32,1,"はたけ"],[35,1,"と"],[41,1,"しゅ"],[43,1,"くら"]],"text":"ラマテびとシメイはぶどう畑をつかさどり、シプミびとザブデはぶどう畑から取ったぶどう酒の倉をつかさどり、"},{"ref":"1Chr.27.28","start":13027028,"end":13027028,"break":"none","ruby":[[13,2,"へいや"],[20,1,"き"],[26,1,"くわ"],[28,1,"き"],[40,1,"あぶら"],[42,1,"くら"]],"text":"ゲデルびとバアル・ハナンは平野のオリブの木といちじく桑の木をつかさどり、ヨアシは油の倉をつかさどり、"},{"ref":"1Chr.27.29","start":13027029,"end":13027029,"break":"none","ruby":[[16,1,"か"],[18,1,"うし"],[20,1,"む"],[34,1,"こ"],[45,1,"たに"],[49,1,"うし"],[51,1,"む"]],"text":"シャロンびとシテライはシャロンで飼う牛の群れをつかさどり、アデライの子シャパテはもろもろの谷におる牛の群れをつかさどり、"},{"ref":"1Chr.27.30","start":13027030,"end":13027030,"break":"none","text":"イシマエルびとオビルはらくだをつかさどり、メロノテびとエデヤはろばをつかさどり、"},{"ref":"1Chr.27.31","start":13027031,"end":13027031,"break":"none","ruby":[[9,1,"ひつじ"],[11,1,"む"],[21,1,"かれ"],[24,1,"みな"],[28,1,"おう"],[30,2,"ざいさん"]],"text":"ハガルびとヤジズは羊の群れをつかさどった。彼らは皆ダビデ王の財産のつかさであった。"},{"ref":"1Chr.27.32","start":13027032,"end":13027032,"break":"paragraph","ruby":[[13,1,"ぎ"],[14,1,"かん"],[17,2,"ちえ"],[21,1,"ひと"],[26,2,"がくしゃ"],[35,1,"かれ"],[42,1,"こ"],[48,1,"おう"],[50,1,"こ"],[54,2,"ほさ"]],"text":"またダビデのおじヨナタンは議官で、知恵ある人であり、学者であった。また彼とハクモニの子エヒエルは王の子たちの補佐であった。"},{"ref":"1Chr.27.33","start":13027033,"end":13027033,"break":"none","ruby":[[6,1,"おう"],[8,1,"ぎ"],[9,1,"かん"],[21,1,"おう"],[23,1,"とも"]],"text":"アヒトペルは王の議官。アルキびとホシャイは王の友であった。"},{"ref":"1Chr.27.34","start":13027034,"end":13027034,"break":"none","ruby":[[6,1,"つ"],[8,1,"もの"],[14,1,"こ"],[28,1,"おう"],[30,1,"ぐん"],[32,1,"ちょう"]],"text":"アヒトペルに次ぐ者はベナヤの子エホヤダおよびアビヤタル。王の軍の長はヨアブであった。"}]