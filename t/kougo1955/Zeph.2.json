[{"ref":"Zeph.2.1","start":36002001,"end":36002001,"break":"paragraph","breaks":[[14,"line"]],"ruby":[[6,1,"はじ"],[8,1,"し"],[11,1,"たみ"],[14,1,"とも"],[20,1,"あつ"]],"text":"あなたがた、恥を知らぬ民よ、共につどい、集まれ。"},{"ref":"Zeph.2.2","start":36002002,"end":36002002,"break":"line","breaks":[[22,"line"],[45,"line"]],"ruby":[[13,1,"お"],[19,1,"まえ"],[22,1,"しゅ"],[24,1,"はげ"],[27,1,"いか"],[38,1,"のぞ"],[42,1,"まえ"],[45,1,"しゅ"],[47,1,"いきどお"],[50,1,"ひ"],[60,1,"き"],[63,1,"まえ"]],"text":"すなわち、もみがらのように追いやられる前に、主の激しい怒りがまだあなたがたに臨まない前に、主の憤りの日がまだあなたがたに来ない前に。"},{"ref":"Zeph.2.3","start":36002003,"end":36002003,"break":"line","breaks":[[22,"line"],[28,"line"],[35,"line"],[42,"line"],[61,"line"]],"ruby":[[3,1,"しゅ"],[5,2,"めいれい"],[8,1,"おこな"],[12,1,"ち"],[19,1,"もの"],[22,1,"しゅ"],[24,1,"もと"],[28,2,"せいぎ"],[31,1,"もと"],[35,2,"けんそん"],[38,1,"もと"],[53,1,"しゅ"],[55,1,"いか"],[58,1,"ひ"],[65,1,"かく"]],"text":"すべて主の命令を行うこの地のへりくだる者よ、主を求めよ。正義を求めよ。謙遜を求めよ。そうすればあなたがたは主の怒りの日に、あるいは隠されることがあろう。"},{"ref":"Zeph.2.4","start":36002004,"end":36002004,"break":"line","breaks":[[13,"line"],[24,"line"],[38,"line"]],"ruby":[[8,1,"す"],[19,1,"あ"],[29,2,"まひる"],[32,1,"お"],[34,1,"はら"],[43,1,"ぬ"],[45,1,"さ"]],"text":"ともあれ、ガザは捨てられ、アシケロンは荒れはて、アシドドは真昼に追い払われ、エクロンは抜き去られる。"},{"ref":"Zeph.2.5","start":36002005,"end":36002005,"break":"stanza","breaks":[[9,"line"],[23,"line"],[37,"line"],[51,"line"],[64,"line"]],"ruby":[[9,1,"うみ"],[12,1,"す"],[14,1,"もの"],[20,2,"こくみん"],[30,1,"ち"],[37,1,"しゅ"],[39,2,"ことば"],[48,1,"のぞ"],[59,1,"ほろ"],[64,1,"す"],[66,1,"もの"]],"text":"わざわいなるかな、海べに住む者、ケレテの国民。ペリシテびとの地、カナンよ、主の言葉があなたがたに臨む。わたしはあなたを滅ぼして、住む者がないようにする。"},{"ref":"Zeph.2.6","start":36002006,"end":36002006,"break":"line","breaks":[[14,"line"],[24,"line"]],"ruby":[[0,1,"うみ"],[8,2,"まきば"],[14,2,"ひつじかい"],[17,2,"ぼくそう"],[19,1,"ち"],[26,1,"ひつじ"]],"text":"海べよ、あなたは牧場となり、羊飼の牧草地となり、また羊のおりとなる。"},{"ref":"Zeph.2.7","start":36002007,"end":36002007,"break":"line","breaks":[[17,"line"],[30,"line"],[45,"line"],[58,"line"]],"ruby":[[0,1,"うみ"],[6,1,"いえ"],[8,1,"のこ"],[11,1,"もの"],[13,1,"き"],[17,1,"かれ"],[22,1,"ところ"],[24,1,"む"],[27,1,"やしな"],[30,2,"ゆうぐれ"],[40,1,"いえ"],[42,1,"ふ"],[45,1,"かれ"],[48,1,"かみ"],[50,1,"しゅ"],[52,1,"かれ"],[55,1,"かえり"],[60,2,"こうふく"],[63,2,"かいふく"]],"text":"海べはユダの家の残りの者に帰する。彼らはその所で群れを養い、夕暮にはアシケロンの家に伏す。彼らの神、主が彼らを顧み、その幸福を回復されるからである。"},{"ref":"Zeph.2.8","start":36002008,"end":36002008,"break":"stanza","breaks":[[15,"line"],[33,"line"],[45,"line"]],"ruby":[[20,2,"ひとびと"],[29,1,"き"],[33,1,"かれ"],[38,1,"たみ"],[45,1,"みずか"],[47,1,"ほこ"],[50,1,"かれ"],[53,2,"こっきょう"],[56,1,"おか"]],"text":"「わたしはモアブのあざけりと、アンモンの人々の、ののしりを聞いた。彼らはわが民をあざけり、自ら誇って彼らの国境を侵した。"},{"ref":"Zeph.2.9","start":36002009,"end":36002009,"break":"line","breaks":[[23,"line"],[33,"line"],[49,"line"],[67,"line"],[84,"line"],[94,"line"],[110,"line"]],"ruby":[[5,2,"ばんぐん"],[8,1,"しゅ"],[16,1,"かみ"],[18,1,"い"],[27,1,"い"],[37,1,"かなら"],[54,2,"ひとびと"],[72,1,"しお"],[73,1,"あな"],[79,2,"せんりょう"],[84,2,"えいえん"],[87,1,"あ"],[89,1,"ち"],[96,1,"たみ"],[98,1,"のこ"],[101,1,"もの"],[103,1,"かれ"],[112,2,"くにたみ"],[115,1,"のこ"],[118,1,"もの"],[123,2,"しょゆう"]],"text":"それゆえ、万軍の主、イスラエルの神は言われる、わたしは生きている。モアブは必ずソドムのようになる。アンモンの人々はゴモラのようになる。いらくさと塩穴とがここを占領して、永遠に荒れ地となる。わが民の残りの者は彼らをかすめ、わが国民の残りの者はこれを所有する」。"},{"ref":"Zeph.2.10","start":36002010,"end":36002010,"break":"line","breaks":[[22,"line"],[37,"line"]],"ruby":[[2,1,"こと"],[4,1,"かれ"],[7,1,"のぞ"],[13,1,"たか"],[22,1,"かれ"],[25,2,"ばんぐん"],[28,1,"しゅ"],[30,1,"たみ"],[41,1,"ほこ"]],"text":"この事の彼らに臨むのはその高ぶりによるのだ。彼らが万軍の主の民をあざけり、みずから誇ったからである。"},{"ref":"Zeph.2.11","start":36002011,"end":36002011,"break":"line","breaks":[[19,"line"],[38,"line"],[48,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"たい"],[8,1,"おそ"],[12,1,"もの"],[19,1,"しゅ"],[21,1,"ち"],[27,2,"かみがみ"],[30,1,"う"],[43,1,"くに"],[45,1,"たみ"],[52,2,"じぶん"],[55,1,"ところ"],[58,1,"で"],[60,1,"しゅ"],[62,1,"おが"]],"text":"主は彼らに対して恐るべき者となられる。主は地のすべての神々を飢えさせられる。もろもろの国の民は、おのおの自分の所から出て主を拝む。"},{"ref":"Zeph.2.12","start":36002012,"end":36002012,"break":"stanza","breaks":[[17,"line"]],"ruby":[[26,1,"ころ"]],"text":"エチオピヤびとよ、あなたがたもまたわがつるぎによって殺される。"},{"ref":"Zeph.2.13","start":36002013,"end":36002013,"break":"line","breaks":[[15,"line"],[25,"line"],[33,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"きた"],[6,1,"む"],[10,1,"て"],[12,1,"の"],[21,1,"ほろ"],[29,1,"あら"],[33,2,"あらの"],[44,1,"ち"]],"text":"主はまた北に向かって手を伸べ、アッスリヤを滅ぼし、ニネベを荒して、荒野のような、かわいた地とされる。"},{"ref":"Zeph.2.14","start":36002014,"end":36002014,"break":"line","breaks":[[22,"line"],[43,"line"],[59,"line"],[74,"line"]],"ruby":[[0,2,"かちく"],[3,1,"む"],[11,1,"の"],[13,1,"けもの"],[17,1,"なか"],[19,1,"ふ"],[36,1,"はしら"],[38,1,"いただき"],[40,1,"す"],[51,1,"まど"],[66,2,"しきい"],[69,1,"うえ"],[71,1,"な"],[76,2,"こうはく"],[79,2,"さいく"],[82,1,"はだか"]],"text":"家畜の群れ、もろもろの野の獣はその中に伏し、はげたかや、やまあらしはその柱の頂に住み、ふくろうは、その窓のうちになき、からすは、その敷居の上に鳴く。その香柏の細工が裸にされるからである。"},{"ref":"Zeph.2.15","start":36002015,"end":36002015,"break":"line","breaks":[[19,"line"],[26,"line"],[50,"line"],[59,"line"],[70,"line"],[84,"line"],[94,"line"]],"ruby":[[2,1,"まち"],[4,1,"か"],[6,1,"ほこ"],[10,1,"やす"],[14,1,"お"],[16,1,"つ"],[21,1,"こころ"],[23,1,"なか"],[40,1,"ほか"],[50,1,"い"],[53,1,"まち"],[64,1,"あ"],[70,1,"けもの"],[72,1,"ふ"],[74,1,"ところ"],[87,1,"とお"],[89,1,"す"],[92,1,"もの"],[94,1,"みな"],[101,1,"て"],[103,1,"ふ"]],"text":"この町は勝ち誇って、安らかに落ち着き、その心の中で、「ただわたしだけだ、わたしの外にはだれもない」と言った町であるが、このように荒れはてて、獣の伏す所になってしまった。ここを通り過ぎる者は皆あざけって、手を振る。"}]