[{"ref":"Gen.40.1","start":1040001,"end":1040001,"break":"paragraph","ruby":[[4,1,"こと"],[6,1,"のち"],[12,1,"おう"],[14,2,"きゅうじ"],[16,1,"やく"],[18,2,"りょうり"],[20,1,"やく"],[25,2,"しゅくん"],[31,1,"おう"],[33,1,"つみ"],[35,1,"おか"]],"text":"これらの事の後、エジプト王の給仕役と料理役とがその主君エジプト王に罪を犯した。"},{"ref":"Gen.40.2","start":1040002,"end":1040002,"break":"none","ruby":[[7,2,"やくにん"],[14,2,"きゅうじ"],[16,1,"やく"],[18,1,"ちょう"],[20,2,"りょうり"],[22,1,"やく"],[24,1,"ちょう"],[26,1,"む"],[30,1,"いきどお"]],"text":"パロはふたりの役人、すなわち給仕役の長と料理役の長に向かって憤り、"},{"ref":"Gen.40.3","start":1040003,"end":1040003,"break":"none","ruby":[[0,2,"じえい"],[2,1,"ちょう"],[4,1,"いえ"],[6,3,"かんきんじょ"],[25,2,"ごくや"],[28,1,"い"]],"text":"侍衛長の家の監禁所、すなわちヨセフがつながれている獄屋に入れた。"},{"ref":"Gen.40.4","start":1040004,"end":1040004,"break":"none","ruby":[[0,2,"じえい"],[2,1,"ちょう"],[8,1,"めい"],[11,1,"かれ"],[14,1,"とも"],[27,1,"かれ"],[30,1,"つか"],[38,1,"かれ"],[41,3,"かんきんじょ"],[45,2,"いくにち"],[49,1,"す"]],"text":"侍衛長はヨセフに命じて彼らと共におらせたので、ヨセフは彼らに仕えた。こうして彼らは監禁所で幾日かを過ごした。"},{"ref":"Gen.40.5","start":1040005,"end":1040005,"break":"none","ruby":[[2,2,"ごくや"],[14,1,"おう"],[16,2,"きゅうじ"],[18,1,"やく"],[20,2,"りょうり"],[22,1,"やく"],[28,2,"いちや"],[38,2,"いみ"],[43,1,"ゆめ"],[45,1,"み"]],"text":"さて獄屋につながれたエジプト王の給仕役と料理役のふたりは一夜のうちにそれぞれ意味のある夢を見た。"},{"ref":"Gen.40.6","start":1040006,"end":1040006,"break":"none","ruby":[[4,1,"あさ"],[6,1,"かれ"],[13,1,"い"],[16,1,"み"],[20,1,"かれ"],[23,1,"かな"],[27,1,"しず"]],"text":"ヨセフが朝、彼らのところへ行って見ると、彼らは悲しみに沈んでいた。"},{"ref":"Gen.40.7","start":1040007,"end":1040007,"break":"none","ruby":[[7,2,"じぶん"],[10,2,"いっしょ"],[13,2,"しゅじん"],[16,1,"いえ"],[18,3,"かんきんじょ"],[27,2,"やくにん"],[32,1,"たず"],[35,1,"い"],[55,2,"かおいろ"],[58,1,"わる"]],"text":"そこでヨセフは自分と一緒に主人の家の監禁所にいるパロの役人たちに尋ねて言った、「どうして、きょう、あなたがたの顔色が悪いのですか」。"},{"ref":"Gen.40.8","start":1040008,"end":1040008,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[14,1,"ゆめ"],[16,1,"み"],[22,1,"と"],[28,1,"もの"],[40,1,"かれ"],[43,1,"い"],[48,1,"と"],[53,1,"かみ"],[75,1,"はな"]],"text":"彼らは言った、「わたしたちは夢を見ましたが、解いてくれる者がいません」。ヨセフは彼らに言った、「解くことは神によるのではありませんか。どうぞ、わたしに話してください」。"},{"ref":"Gen.40.9","start":1040009,"end":1040009,"break":"paragraph","ruby":[[0,2,"きゅうじ"],[2,1,"やく"],[4,1,"ちょう"],[8,1,"ゆめ"],[14,1,"はな"],[17,1,"い"],[26,1,"み"],[28,1,"ゆめ"],[35,1,"まえ"],[38,1,"ぽん"],[44,1,"き"]],"text":"給仕役の長はその夢をヨセフに話して言った、「わたしが見た夢で、わたしの前に一本のぶどうの木がありました。"},{"ref":"Gen.40.10","start":1040010,"end":1040010,"break":"none","ruby":[[6,1,"き"],[11,1,"えだ"],[17,1,"め"],[19,1,"だ"],[22,1,"はな"],[24,1,"さ"],[34,1,"じゅく"]],"text":"そのぶどうの木に三つの枝があって、芽を出し、花が咲き、ぶどうのふさが熟しました。"},{"ref":"Gen.40.11","start":1040011,"end":1040011,"break":"none","ruby":[[0,1,"とき"],[6,1,"て"],[12,1,"さかずき"],[28,1,"と"],[37,1,"さかずき"],[45,1,"さかずき"],[50,1,"て"]],"text":"時にわたしの手に、パロの杯があって、わたしはそのぶどうを取り、それをパロの杯にしぼり、その杯をパロの手にささげました」。"},{"ref":"Gen.40.12","start":1040012,"end":1040012,"break":"none","ruby":[[4,1,"い"],[11,1,"と"],[13,1,"あ"],[25,1,"えだ"],[28,1,"か"]],"text":"ヨセフは言った、「その解き明かしはこうです。三つの枝は三日です。"},{"ref":"Gen.40.13","start":1040013,"end":1040013,"break":"none","ruby":[[0,1,"いま"],[4,1,"か"],[16,1,"あたま"],[18,1,"あ"],[26,1,"もと"],[28,2,"やくめ"],[31,1,"かえ"],[45,2,"きゅうじ"],[47,1,"やく"],[51,1,"とき"],[63,1,"て"],[65,1,"さかずき"]],"text":"今から三日のうちにパロはあなたの頭を上げて、あなたを元の役目に返すでしょう。あなたはさきに給仕役だった時にされたように、パロの手に杯をささげられるでしょう。"},{"ref":"Gen.40.14","start":1040014,"end":1040014,"break":"none","ruby":[[23,1,"おぼ"],[36,1,"めぐ"],[39,1,"ほどこ"],[46,1,"こと"],[51,1,"はな"],[57,1,"いえ"],[64,1,"だ"]],"text":"それで、あなたがしあわせになられたら、わたしを覚えていて、どうかわたしに恵みを施し、わたしの事をパロに話して、この家からわたしを出してください。"},{"ref":"Gen.40.15","start":1040015,"end":1040015,"break":"none","ruby":[[5,1,"み"],[13,1,"ち"],[23,1,"もの"],[37,2,"ちか"],[40,2,"ごくや"],[43,1,"い"],[51,1,"こと"]],"text":"わたしは、実はヘブルびとの地からさらわれてきた者です。またここでもわたしは地下の獄屋に入れられるような事はしなかったのです」。"},{"ref":"Gen.40.16","start":1040016,"end":1040016,"break":"paragraph","ruby":[[0,2,"りょうり"],[2,1,"やく"],[4,1,"ちょう"],[8,1,"と"],[10,1,"あ"],[14,1,"よ"],[20,1,"み"],[27,1,"い"],[36,1,"ゆめ"],[38,1,"み"],[42,1,"しろ"],[57,1,"あたま"],[59,1,"うえ"]],"text":"料理役の長はその解き明かしの良かったのを見て、ヨセフに言った、「わたしも夢を見たが、白いパンのかごが三つ、わたしの頭の上にあった。"},{"ref":"Gen.40.17","start":1040017,"end":1040017,"break":"none","ruby":[[1,1,"ばん"],[2,1,"うえ"],[8,2,"りょうり"],[10,1,"やく"],[18,1,"つく"],[26,2,"しょくもつ"],[34,1,"とり"],[40,1,"あたま"],[42,1,"うえ"],[51,1,"た"]],"text":"一番上のかごには料理役がパロのために作ったさまざまの食物があったが、鳥がわたしの頭の上のかごからそれを食べていた」。"},{"ref":"Gen.40.18","start":1040018,"end":1040018,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[14,1,"と"],[16,1,"あ"],[32,1,"か"]],"text":"ヨセフは答えて言った、「その解き明かしはこうです。三つのかごは三日です。"},{"ref":"Gen.40.19","start":1040019,"end":1040019,"break":"none","ruby":[[0,1,"いま"],[4,1,"か"],[16,1,"あたま"],[18,1,"あ"],[20,1,"はな"],[28,1,"き"],[30,1,"か"],[41,1,"とり"],[47,1,"にく"],[49,1,"く"],[51,1,"と"]],"text":"今から三日のうちにパロはあなたの頭を上げ離して、あなたを木に掛けるでしょう。そして鳥があなたの肉を食い取るでしょう」。"},{"ref":"Gen.40.20","start":1040020,"end":1040020,"break":"paragraph","ruby":[[3,1,"か"],[4,1,"め"],[9,2,"たんじょう"],[11,1,"ひ"],[26,2,"けらい"],[37,1,"もう"],[40,2,"けらい"],[46,2,"きゅうじ"],[48,1,"やく"],[50,1,"ちょう"],[52,1,"あたま"],[55,2,"りょうり"],[57,1,"やく"],[59,1,"ちょう"],[61,1,"あたま"],[63,1,"あ"]],"text":"さて三日目はパロの誕生日であったので、パロはすべての家来のためにふるまいを設け、家来のうちの給仕役の長の頭と、料理役の長の頭を上げた。"},{"ref":"Gen.40.21","start":1040021,"end":1040021,"break":"none","ruby":[[7,2,"きゅうじ"],[9,1,"やく"],[11,1,"ちょう"],[13,2,"きゅうじ"],[15,1,"やく"],[17,1,"しょく"],[19,1,"かえ"],[25,1,"かれ"],[30,1,"て"],[32,1,"さかずき"]],"text":"すなわちパロは給仕役の長を給仕役の職に返したので、彼はパロの手に杯をささげた。"},{"ref":"Gen.40.22","start":1040022,"end":1040022,"break":"none","ruby":[[6,2,"りょうり"],[8,1,"やく"],[10,1,"ちょう"],[12,1,"き"],[14,1,"か"],[22,1,"かれ"],[25,1,"と"],[27,1,"あ"]],"text":"しかしパロは料理役の長を木に掛けた。ヨセフが彼らに解き明かしたとおりである。"},{"ref":"Gen.40.23","start":1040023,"end":1040023,"break":"none","ruby":[[5,2,"きゅうじ"],[7,1,"やく"],[9,1,"ちょう"],[15,1,"おも"],[17,1,"だ"],[21,1,"わす"]],"text":"ところが、給仕役の長はヨセフを思い出さず、忘れてしまった。"}]