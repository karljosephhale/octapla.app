[{"ref":"Ezek.32.1","start":26032001,"end":26032001,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"ねん"],[7,1,"がつ"],[9,1,"にち"],[12,1,"しゅ"],[14,2,"ことば"],[21,1,"のぞ"]],"text":"第十二年の十二月一日に、主の言葉がわたしに臨んだ、"},{"ref":"Ezek.32.2","start":26032002,"end":26032002,"break":"none","breaks":[[35,"stanza"],[53,"line"],[66,"line"],[84,"line"],[98,"line"]],"ruby":[[1,1,"ひと"],[3,1,"こ"],[11,1,"おう"],[19,1,"かな"],[23,1,"うた"],[32,1,"い"],[39,2,"じぶん"],[47,2,"こくみん"],[59,1,"かんが"],[70,1,"うみ"],[72,1,"なか"],[74,1,"りゅう"],[79,1,"もの"],[88,1,"かわ"],[90,1,"なか"],[95,1,"お"],[98,1,"あし"],[100,1,"みず"],[107,1,"かわ"],[109,1,"にご"]],"text":"「人の子よ、エジプトの王パロのために、悲しみの歌をのべて、これに言え、あなたは自分をもろもろの国民のうちのししであると考えているが、あなたは海の中の龍のような者である。あなたは川の中に、はね起き、足で水をかきまぜ、川を濁す。"},{"ref":"Ezek.32.3","start":26032003,"end":26032003,"break":"line","breaks":[[12,"line"],[28,"line"],[43,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[16,1,"おお"],[19,1,"たみ"],[21,2,"しゅうだん"],[32,1,"あみ"],[38,1,"な"],[47,1,"あみ"],[49,1,"ひ"]],"text":"主なる神はこう言われる、わたしは多くの民の集団をもって、わたしの網をあなたに投げかけ、あなたを網で引きあげる。"},{"ref":"Ezek.32.4","start":26032004,"end":26032004,"break":"line","breaks":[[15,"line"],[24,"line"],[43,"line"]],"ruby":[[8,1,"ち"],[10,1,"な"],[12,1,"す"],[15,1,"の"],[17,1,"おもて"],[19,1,"な"],[24,1,"そら"],[30,1,"とり"],[36,1,"うえ"],[43,1,"ぜん"],[44,1,"ち"],[46,1,"けもの"],[52,1,"あた"],[55,1,"あ"]],"text":"わたしはあなたを地に投げ捨て、野の面に投げうち、空のすべての鳥をあなたの上にとまらせ、全地の獣にあなたを与えて飽かせる。"},{"ref":"Ezek.32.5","start":26032005,"end":26032005,"break":"line","breaks":[[16,"line"]],"ruby":[[8,1,"にく"],[10,2,"やまやま"],[13,1,"す"],[20,2,"したい"],[23,1,"たに"],[25,1,"み"]],"text":"わたしはあなたの肉を山々に捨て、あなたの死体で谷を満たす。"},{"ref":"Ezek.32.6","start":26032006,"end":26032006,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[8,1,"なが"],[11,1,"ち"],[14,1,"ち"],[16,1,"うるお"],[19,2,"やまやま"],[24,1,"およ"],[28,2,"たにがわ"],[35,2,"したい"],[38,1,"み"]],"text":"わたしはあなたの流れる血で、地を潤し、山々にまで及ぼす。谷川はあなたの死体で満ちる。"},{"ref":"Ezek.32.7","start":26032007,"end":26032007,"break":"line","breaks":[[13,"line"],[25,"line"]],"ruby":[[8,1,"ほろ"],[11,1,"とき"],[13,1,"そら"],[19,1,"ほし"],[21,1,"くら"],[25,1,"くも"],[27,1,"ひ"],[33,1,"つき"],[35,1,"ひかり"],[37,1,"はな"]],"text":"わたしはあなたを滅ぼす時、空をおおい、星を暗くし、雲で日をおおい、月に光を放たせない。"},{"ref":"Ezek.32.8","start":26032008,"end":26032008,"break":"line","breaks":[[11,"line"],[26,"line"],[38,"line"]],"ruby":[[4,1,"そら"],[6,1,"かがや"],[8,1,"ひかり"],[20,1,"うえ"],[22,1,"くら"],[30,1,"くに"],[38,1,"しゅ"],[41,1,"かみ"],[43,1,"い"]],"text":"わたしは空の輝く光を、ことごとくあなたの上に暗くし、あなたの国をやみとすると主なる神は言う。"},{"ref":"Ezek.32.9","start":26032009,"end":26032009,"break":"paragraph","ruby":[[9,2,"こくみん"],[16,1,"し"],[20,2,"くにぐに"],[23,1,"なか"],[30,1,"とら"],[32,1,"うつ"],[34,1,"とき"],[36,1,"おお"],[39,1,"たみ"],[41,1,"こころ"],[43,1,"いた"]],"text":"わたしはもろもろの国民、あなたの知らない国々の中に、あなたを捕え移す時、多くの民の心を痛ませる。"},{"ref":"Ezek.32.10","start":26032010,"end":26032010,"break":"none","ruby":[[12,1,"おお"],[15,1,"たみ"],[17,1,"おどろ"],[24,1,"おう"],[42,1,"かれ"],[45,1,"まえ"],[47,1,"ふ"],[50,1,"とき"],[56,1,"こと"],[67,1,"たお"],[70,1,"ひ"],[74,1,"かれ"],[81,2,"じぶん"],[84,1,"いのち"],[86,1,"おも"],[90,1,"た"],[93,1,"う"],[95,1,"ふる"]],"text":"わたしはあなたについて、多くの民を驚かせる。その王たちは、わたしがわたしのつるぎを、彼らの前に振るう時、あなたの事でおののく。あなたの倒れる日には、彼らはおのおの自分の命を思って、絶えず打ち震える。"},{"ref":"Ezek.32.11","start":26032011,"end":26032011,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[17,1,"おう"],[27,1,"のぞ"]],"text":"主なる神はこう言われる、バビロンの王のつるぎはあなたに臨む。"},{"ref":"Ezek.32.12","start":26032012,"end":26032012,"break":"none","breaks":[[56,"stanza"],[69,"line"]],"ruby":[[8,2,"みんしゅう"],[11,2,"ゆうし"],[18,1,"たお"],[24,1,"かれ"],[27,1,"みな"],[34,2,"こくみん"],[37,1,"なか"],[40,1,"もっと"],[42,1,"おそ"],[49,1,"もの"],[56,1,"かれ"],[64,1,"ほこり"],[66,1,"た"],[74,2,"みんしゅう"],[77,1,"みな"],[78,1,"ほろ"]],"text":"わたしはあなたの民衆を勇士のつるぎに倒れさせる。彼らは皆、もろもろの国民の中で、最も恐れられている者たちである。彼らはエジプトの誇を断つ、エジプトの民衆は皆滅ぼされる。"},{"ref":"Ezek.32.13","start":26032013,"end":26032013,"break":"line","breaks":[[15,"line"],[30,"line"],[43,"line"]],"ruby":[[6,2,"かちく"],[15,1,"おお"],[18,1,"みず"],[26,1,"ほろ"],[30,1,"ひと"],[32,1,"あし"],[34,1,"ふたた"],[39,1,"にご"],[43,2,"かちく"],[53,1,"みだ"]],"text":"わたしはその家畜をことごとく、多くの水のかたわらから滅ぼす。人の足は再びこれを濁さず、家畜のひずめもこれを乱さない。"},{"ref":"Ezek.32.14","start":26032014,"end":26032014,"break":"line","breaks":[[15,"line"],[32,"line"]],"ruby":[[2,1,"とき"],[9,1,"みず"],[11,1,"きよ"],[17,2,"かわがわ"],[20,1,"あぶら"],[25,1,"なが"],[32,1,"しゅ"],[35,1,"かみ"],[37,1,"い"]],"text":"その時わたしはその水を清くし、その川々を油のように流れさせると、主なる神は言う。"},{"ref":"Ezek.32.15","start":26032015,"end":26032015,"break":"line","breaks":[[14,"line"],[38,"line"],[59,"line"]],"ruby":[[9,1,"くに"],[11,1,"あら"],[16,1,"くに"],[18,1,"み"],[30,1,"と"],[32,1,"さ"],[36,1,"とき"],[44,1,"なか"],[46,1,"す"],[48,1,"もの"],[55,1,"う"],[57,1,"とき"],[59,1,"かれ"],[66,1,"しゅ"],[73,1,"し"]],"text":"わたしはエジプトの国を荒し、その国に満ちるものが、ことごとく取り去られる時、わたしがその中に住む者をことごとく撃つ時、彼らはわたしが主であることを知る。"},{"ref":"Ezek.32.16","start":26032016,"end":26032016,"break":"none","ruby":[[3,1,"かな"],[7,1,"うた"],[12,2,"ひとびと"],[18,1,"うた"],[26,1,"くに"],[28,1,"むすめ"],[35,1,"うた"],[54,2,"みんしゅう"],[65,1,"うた"],[73,1,"しゅ"],[76,1,"かみ"],[78,1,"い"]],"text":"これは悲しみの歌である。人々はこれを歌い、もろもろの国の娘たちはこれを歌う。すなわちエジプトと、そのすべての民衆とのために、これを歌うのであると、主なる神は言われる」。"},{"ref":"Ezek.32.17","start":26032017,"end":26032017,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"ねん"],[6,1,"がつ"],[9,1,"にち"],[12,1,"しゅ"],[14,2,"ことば"],[21,1,"のぞ"]],"text":"第十二年の一月十五日に、主の言葉がわたしに臨んだ、"},{"ref":"Ezek.32.18","start":26032018,"end":26032018,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[11,2,"みんしゅう"],[17,1,"なげ"],[23,1,"おお"],[27,2,"くにぐに"],[30,1,"むすめ"],[35,1,"した"],[37,1,"くに"],[39,1,"な"],[41,1,"くだ"],[44,1,"あな"],[46,1,"くだ"],[49,1,"もの"],[55,1,"いた"]],"text":"「人の子よ、エジプトの民衆のために嘆き、これと大いなる国々の娘らとを、下の国に投げ下し、穴に下った者のところに至らせよ。"},{"ref":"Ezek.32.19","start":26032019,"end":26032019,"break":"stanza","breaks":[[18,"line"]],"ruby":[[5,1,"び"],[18,1,"くだ"],[22,2,"かつれい"],[25,1,"う"],[29,1,"もの"],[31,1,"とも"],[33,1,"ふ"]],"text":"『あなたの美はだれにまさっているか。下って、割礼を受けない者と共に伏せよ』。"},{"ref":"Ezek.32.20","start":26032020,"end":26032020,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ころ"],[11,1,"もの"],[16,1,"たお"],[22,2,"みんしゅう"],[28,1,"とも"],[30,1,"ふ"]],"text":"彼らはつるぎに殺される者のうちに倒れる。その民衆はこれと共に伏せる。"},{"ref":"Ezek.32.21","start":26032021,"end":26032021,"break":"none","ruby":[[0,2,"ゆうし"],[3,2,"しゅりょう"],[8,1,"たす"],[10,1,"て"],[12,1,"とも"],[15,2,"よみ"],[18,1,"なか"],[21,1,"かれ"],[24,1,"い"],[28,2,"かつれい"],[31,1,"う"],[35,1,"もの"],[41,1,"ころ"],[45,1,"もの"],[47,1,"くだ"],[50,1,"ふ"]],"text":"勇士の首領はその助け手と共に、陰府の中から彼らに言う、『割礼を受けない者、つるぎに殺された者は下って伏している』と。"},{"ref":"Ezek.32.22","start":26032022,"end":26032022,"break":"paragraph","ruby":[[8,2,"なかま"],[14,1,"ところ"],[21,1,"はか"],[26,1,"かこ"],[29,1,"かれ"],[34,1,"ころ"],[38,1,"もの"],[46,1,"たお"],[49,1,"もの"]],"text":"アッスリヤとその仲間とはその所におり、その墓はこれを囲む。彼らはみな殺された者、またつるぎに倒れた者である。"},{"ref":"Ezek.32.23","start":26032023,"end":26032023,"break":"none","ruby":[[0,1,"かれ"],[3,1,"はか"],[5,1,"あな"],[7,1,"おく"],[9,1,"もう"],[16,2,"なかま"],[21,1,"はか"],[23,2,"しゅうい"],[34,1,"ころ"],[38,1,"もの"],[44,1,"たお"],[47,1,"もの"],[49,1,"い"],[52,1,"もの"],[54,1,"ち"],[56,1,"おそ"],[59,1,"おこ"],[62,1,"もの"]],"text":"彼らの墓は穴の奥に設けられ、その仲間はその墓の周囲にあり、これはみな殺された者、つるぎに倒れた者、生ける者の地に恐れを起した者である。"},{"ref":"Ezek.32.24","start":26032024,"end":26032024,"break":"paragraph","ruby":[[2,1,"ところ"],[13,2,"みんしゅう"],[16,1,"みな"],[20,1,"はか"],[22,2,"しゅうい"],[28,1,"かれ"],[33,1,"ころ"],[37,1,"もの"],[43,1,"たお"],[46,1,"もの"],[48,2,"かつれい"],[51,1,"う"],[57,1,"した"],[59,1,"くに"],[61,1,"くだ"],[64,1,"もの"],[66,1,"い"],[69,1,"もの"],[71,1,"ち"],[74,1,"おそ"],[77,1,"おこ"],[80,1,"もの"],[83,1,"あな"],[85,1,"くだ"],[87,1,"もの"],[89,1,"とも"],[92,1,"はじ"],[94,1,"お"]],"text":"その所にエラムがおり、その民衆は皆、その墓の周囲におる。彼らはみな殺された者、つるぎに倒れた者、割礼を受けないで、下の国に下った者、生ける者の地に、恐れを起した者で、穴に下る者と共に、恥を負うのである。"},{"ref":"Ezek.32.25","start":26032025,"end":26032025,"break":"none","ruby":[[0,1,"かれ"],[9,2,"みんしゅう"],[12,1,"とも"],[15,1,"ころ"],[19,1,"もの"],[21,1,"なか"],[23,1,"とこ"],[25,1,"お"],[30,1,"はか"],[35,1,"かこ"],[41,1,"みな"],[43,2,"かつれい"],[46,1,"う"],[50,1,"もの"],[56,1,"ころ"],[60,1,"もの"],[62,1,"い"],[65,1,"もの"],[67,1,"ち"],[69,1,"おそ"],[72,1,"おこ"],[75,1,"もの"],[78,1,"あな"],[80,1,"くだ"],[82,1,"もの"],[84,1,"とも"],[86,1,"はじ"],[88,1,"お"],[91,1,"かれ"],[94,1,"ころ"],[98,1,"もの"],[100,1,"なか"],[102,1,"お"]],"text":"彼らはそのすべての民衆と共に、殺された者の中に床を置き、その墓はこれを囲む。これは皆、割礼を受けない者、つるぎに殺された者、生ける者の地に恐れを起した者で、穴に下る者と共に恥を負う。彼らは殺された者の中に置かれている。"},{"ref":"Ezek.32.26","start":26032026,"end":26032026,"break":"paragraph","ruby":[[2,1,"ところ"],[19,2,"みんしゅう"],[27,1,"はか"],[32,1,"かこ"],[35,1,"かれ"],[38,1,"みな"],[40,2,"かつれい"],[43,1,"う"],[47,1,"もの"],[54,1,"ころ"],[58,1,"もの"],[63,1,"い"],[66,1,"もの"],[68,1,"ち"],[70,1,"おそ"],[73,1,"おこ"]],"text":"その所にメセクとトバル、およびすべての民衆がおる。その墓はこれを囲む。彼らは皆、割礼を受けない者で、つるぎで殺された者である。生ける者の地に恐れを起したからである。"},{"ref":"Ezek.32.27","start":26032027,"end":26032027,"break":"none","ruby":[[0,1,"かれ"],[3,1,"むかし"],[5,1,"たお"],[8,2,"ゆうし"],[11,1,"とも"],[13,1,"ふ"],[22,2,"ゆうし"],[26,2,"ぶぐ"],[29,1,"も"],[32,2,"よみ"],[35,1,"くだ"],[50,1,"たて"],[52,1,"ほね"],[54,1,"うえ"],[62,2,"ゆうし"],[65,1,"おそ"],[69,1,"い"],[72,1,"もの"],[74,1,"ち"]],"text":"彼らは昔の倒れた勇士と共に伏さない。これらの勇士は、武具を持って陰府に下り、つるぎをまくらとし、その盾は骨の上にある。これは勇士の恐れが、生ける者の地にあったからである。"},{"ref":"Ezek.32.28","start":26032028,"end":26032028,"break":"none","ruby":[[4,2,"かつれい"],[7,1,"う"],[11,1,"もの"],[21,1,"ころ"],[25,1,"もの"],[27,1,"とも"],[29,1,"よこ"]],"text":"あなたは割礼を受けない者のうちに、つるぎで殺された者と共に横たわる。"},{"ref":"Ezek.32.29","start":26032029,"end":26032029,"break":"paragraph","ruby":[[2,1,"ところ"],[10,1,"おう"],[21,1,"きみ"],[28,1,"かれ"],[33,1,"ちから"],[35,1,"も"],[51,1,"ころ"],[55,1,"もの"],[57,1,"とも"],[59,1,"よこ"],[65,2,"かつれい"],[68,1,"う"],[72,1,"もの"],[76,1,"あな"],[78,1,"くだ"],[80,1,"もの"],[82,1,"とも"],[84,1,"ふ"]],"text":"その所にエドムとその王たちと、そのすべての君たちがおる。彼らはその力を持つにもかかわらず、かのつるぎで殺された者と共に横たえられ、割礼を受けない者および穴に下る者と共に伏している。"},{"ref":"Ezek.32.30","start":26032030,"end":26032030,"break":"paragraph","ruby":[[2,1,"ところ"],[4,1,"きた"],[6,1,"きみ"],[19,1,"みな"],[23,1,"かれ"],[26,2,"じぶん"],[29,1,"ちから"],[34,1,"おそ"],[37,1,"おこ"],[43,1,"ころ"],[47,1,"もの"],[49,1,"とも"],[51,1,"はじ"],[53,1,"う"],[57,1,"くだ"],[60,1,"い"],[63,1,"もの"],[68,1,"かれ"],[75,1,"ころ"],[79,1,"もの"],[81,1,"とも"],[84,2,"かつれい"],[87,1,"う"],[91,1,"ふ"],[94,1,"あな"],[96,1,"くだ"],[98,1,"もの"],[100,1,"とも"],[102,1,"はじ"],[104,1,"お"]],"text":"その所に北の君たち、およびシドンびとが皆おる。彼らは自分の力によって恐れを起したので、殺された者と共に恥を受けて、下って行った者である。彼らはつるぎで殺された者と共に、割礼を受けずに伏し、穴に下る者と共に恥を負う。"},{"ref":"Ezek.32.31","start":26032031,"end":26032031,"break":"paragraph","ruby":[[3,1,"かれ"],[6,1,"み"],[8,1,"とき"],[16,2,"みんしゅう"],[22,1,"なぐさ"],[37,2,"ぐんぜい"],[46,1,"ころ"],[52,1,"しゅ"],[55,1,"かみ"],[57,1,"い"]],"text":"パロは彼らを見る時、そのすべての民衆について慰められる。パロとそのすべての軍勢とは、つるぎで殺されると、主なる神は言われる。"},{"ref":"Ezek.32.32","start":26032032,"end":26032032,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[5,1,"もの"],[7,1,"くに"],[9,1,"おそ"],[12,1,"ひろ"],[28,2,"みんしゅう"],[33,2,"かつれい"],[36,1,"う"],[40,1,"もの"],[53,1,"ころ"],[57,1,"もの"],[59,1,"とも"],[61,1,"ふ"],[65,1,"しゅ"],[68,1,"かみ"],[70,1,"い"]],"text":"彼は生ける者の国に恐れを広げた。それゆえ、パロとすべての民衆とは、割礼を受けない者のうちにあって、つるぎで殺された者と共に伏すと、主なる神は言われる」。"}]