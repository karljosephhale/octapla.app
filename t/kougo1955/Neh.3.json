[{"ref":"Neh.3.1","start":16003001,"end":16003001,"break":"paragraph","ruby":[[3,1,"だい"],[4,2,"さいし"],[15,2,"きょうだい"],[20,2,"さいし"],[25,1,"とも"],[27,1,"た"],[30,1,"ひつじ"],[32,1,"もん"],[34,1,"た"],[40,2,"せいべつ"],[50,1,"もう"],[59,2,"せいべつ"],[69,2,"ぼうろう"],[72,1,"およ"],[83,2,"ぼうろう"],[88,1,"およ"]],"text":"かくて大祭司エリアシブは、その兄弟である祭司たちと共に立って羊の門を建て、これを聖別してそのとびらを設け、さらにこれを聖別して、ハンメアの望楼に及ぼし、またハナネルの望楼にまで及ぼした。"},{"ref":"Neh.3.2","start":16003002,"end":16003002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"つぎ"],[9,2,"ひとびと"],[12,1,"た"],[17,1,"つぎ"],[24,1,"こ"],[30,1,"た"]],"text":"彼の次にはエリコの人々が建て、その次にはイムリの子ザックルが建てた。"},{"ref":"Neh.3.3","start":16003003,"end":16003003,"break":"none","ruby":[[0,1,"うお"],[2,1,"もん"],[10,1,"こ"],[13,1,"た"],[18,1,"はり"],[20,1,"お"],[29,2,"よこぎ"],[32,1,"かん"],[34,1,"き"],[37,1,"もう"]],"text":"魚の門はハッセナアの子らが建て、その梁を置き、そのとびらと横木と貫の木とを設けた。"},{"ref":"Neh.3.4","start":16003004,"end":16003004,"break":"none","ruby":[[2,1,"つぎ"],[9,1,"こ"],[14,1,"こ"],[20,2,"しゅうり"],[26,1,"つぎ"],[34,1,"こ"],[40,1,"こ"],[47,2,"しゅうり"],[53,1,"つぎ"],[59,1,"こ"],[64,2,"しゅうり"]],"text":"その次にハッコヅの子ウリヤの子メレモテが修理し、その次にメシザベルの子ベレキヤの子メシュラムが修理し、その次にバアナの子ザドクが修理した。"},{"ref":"Neh.3.5","start":16003005,"end":16003005,"break":"none","ruby":[[2,1,"つぎ"],[11,2,"しゅうり"],[19,2,"きじん"],[26,1,"しゅ"],[28,2,"こうじ"],[31,1,"ふく"]],"text":"その次にテコアびとらが修理したが、その貴人たちはその主の工事に服さなかった。"},{"ref":"Neh.3.6","start":16003006,"end":16003006,"break":"paragraph","ruby":[[0,1,"ふる"],[2,1,"もん"],[8,1,"こ"],[21,1,"こ"],[31,2,"しゅうり"],[37,1,"はり"],[39,1,"お"],[48,2,"よこぎ"],[51,1,"かん"],[53,1,"き"],[56,1,"もう"]],"text":"古い門はパセアの子ヨイアダおよびベソデヤの子メシュラムがこれを修理し、その梁を置き、そのとびらと横木と貫の木とを設けた。"},{"ref":"Neh.3.7","start":16003007,"end":16003007,"break":"none","ruby":[[2,1,"つぎ"],[28,1,"かわ"],[29,1,"む"],[33,1,"しゅう"],[35,2,"ちじ"],[38,3,"ぎょうせいか"],[53,2,"ひとびと"],[56,2,"しゅうり"]],"text":"その次にギベオンびとメラテヤ、メロノテびとヤドン、および川向こうの州の知事の行政下にあるギベオンとミヅパの人々が修理した。"},{"ref":"Neh.3.8","start":16003008,"end":16003008,"break":"none","ruby":[[2,1,"つぎ"],[9,1,"こ"],[17,1,"きん"],[18,3,"ざいくにん"],[22,2,"しゅうり"],[28,1,"つぎ"],[30,3,"せいこうしゃ"],[42,2,"しゅうり"],[51,1,"かれ"],[60,2,"じょうへき"],[63,1,"ひろ"],[65,1,"ところ"],[68,2,"ふっきゅう"]],"text":"その次にハルハヤの子ウジエルなどの金細工人が修理し、その次に製香者のひとりハナニヤが修理した。こうして彼らはエルサレムを城壁の広い所まで復旧した。"},{"ref":"Neh.3.9","start":16003009,"end":16003009,"break":"none","ruby":[[2,1,"つぎ"],[10,1,"はん"],[11,2,"くいき"],[14,2,"ちじ"],[19,1,"こ"],[24,2,"しゅうり"]],"text":"その次にエルサレムの半区域の知事ホルの子レパヤが修理し、"},{"ref":"Neh.3.10","start":16003010,"end":16003010,"break":"none","ruby":[[2,1,"つぎ"],[9,1,"こ"],[14,2,"じぶん"],[17,1,"いえ"],[19,1,"む"],[22,1,"あ"],[27,1,"ところ"],[29,2,"しゅうり"],[35,1,"つぎ"],[45,1,"こ"],[51,2,"しゅうり"]],"text":"その次にハルマフの子エダヤが自分の家と向かい合っている所を修理し、その次にはハシャブニヤの子ハットシが修理した。"},{"ref":"Neh.3.11","start":16003011,"end":16003011,"break":"none","ruby":[[4,1,"こ"],[20,1,"こ"],[26,1,"た"],[28,2,"ぶぶん"],[33,1,"ろ"],[35,2,"ぼうろう"],[38,2,"しゅうり"]],"text":"ハリムの子マルキヤおよびバハテ・モアブの子ハシュブも他の部分および炉の望楼を修理した。"},{"ref":"Neh.3.12","start":16003012,"end":16003012,"break":"none","ruby":[[2,1,"つぎ"],[10,1,"た"],[12,1,"はん"],[13,2,"くいき"],[16,2,"ちじ"],[23,1,"こ"],[31,1,"むすめ"],[35,1,"とも"],[37,2,"しゅうり"]],"text":"その次にエルサレムの他の半区域の知事ハロヘシの子シャルムがその娘たちと共に修理した。"},{"ref":"Neh.3.13","start":16003013,"end":16003013,"break":"paragraph","ruby":[[0,1,"たに"],[2,1,"もん"],[12,1,"たみ"],[14,1,"とも"],[19,2,"しゅうり"],[26,1,"た"],[28,1,"なお"],[38,2,"よこぎ"],[41,1,"かん"],[43,1,"き"],[46,1,"もう"],[51,1,"ふん"],[53,1,"もん"],[56,2,"じょうへき"],[65,2,"しゅうり"]],"text":"谷の門はハヌンがザノアの民と共にこれを修理し、これを建て直して、そのとびらと横木と貫の木とを設け、また糞の門まで城壁一千キュビトを修理した。"},{"ref":"Neh.3.14","start":16003014,"end":16003014,"break":"paragraph","ruby":[[0,1,"ふん"],[2,1,"もん"],[12,2,"くいき"],[15,2,"ちじ"],[21,1,"こ"],[30,2,"しゅうり"],[37,1,"た"],[39,1,"なお"],[49,2,"よこぎ"],[52,1,"かん"],[54,1,"き"],[57,1,"もう"]],"text":"糞の門はベテ・ハケレムの区域の知事レカブの子マルキヤがこれを修理し、これを建て直して、そのとびらと横木と貫の木とを設けた。"},{"ref":"Neh.3.15","start":16003015,"end":16003015,"break":"paragraph","ruby":[[0,1,"いずみ"],[2,1,"もん"],[8,2,"くいき"],[11,2,"ちじ"],[18,1,"こ"],[27,2,"しゅうり"],[34,1,"た"],[36,1,"なお"],[44,1,"ほどこ"],[53,2,"よこぎ"],[56,1,"かん"],[58,1,"き"],[61,1,"もう"],[65,1,"かれ"],[69,1,"おう"],[71,1,"その"],[80,1,"いけ"],[82,1,"そ"],[85,1,"いし"],[89,2,"しゅうり"],[98,1,"まち"],[101,1,"くだ"],[103,2,"かいだん"],[108,1,"およ"]],"text":"泉の門はミヅパの区域の知事コロホゼの子シャルンがこれを修理し、これを建て直して、おおいを施し、そのとびらと横木と貫の木とを設けた。彼はまた王の園のほとりのシラの池に沿った石がきを修理して、ダビデの町から下る階段にまで及んだ。"},{"ref":"Neh.3.16","start":16003016,"end":16003016,"break":"none","ruby":[[2,1,"のち"],[9,1,"はん"],[10,2,"くいき"],[13,2,"ちじ"],[20,1,"こ"],[26,2,"しゅうり"],[35,1,"はか"],[37,1,"む"],[40,1,"あ"],[43,1,"ところ"],[45,1,"およ"],[48,2,"ほりいけ"],[51,2,"ゆうし"],[54,1,"たく"],[58,1,"およ"]],"text":"その後にベテズルの半区域の知事アズブクの子ネヘミヤが修理して、ダビデの墓と向かい合った所に及び、掘池と勇士の宅にまで及んだ。"},{"ref":"Neh.3.17","start":16003017,"end":16003017,"break":"none","ruby":[[2,1,"のち"],[7,1,"こ"],[19,2,"しゅうり"],[25,1,"つぎ"],[31,1,"はん"],[32,2,"くいき"],[35,2,"ちじ"],[45,2,"くいき"],[51,2,"しゅうり"]],"text":"その後にバニの子レホムなどのレビびとが修理し、その次にケイラの半区域の知事ハシャビヤがその区域のために修理した。"},{"ref":"Neh.3.18","start":16003018,"end":16003018,"break":"none","ruby":[[2,1,"のち"],[8,1,"はん"],[9,2,"くいき"],[12,2,"ちじ"],[19,1,"こ"],[27,2,"きょうだい"],[32,2,"しゅうり"]],"text":"その後にケイラの半区域の知事ヘナダデの子バワイなどその兄弟たちが修理し、"},{"ref":"Neh.3.19","start":16003019,"end":16003019,"break":"none","ruby":[[2,1,"つぎ"],[9,1,"こ"],[15,2,"ちじ"],[25,2,"じょうへき"],[28,1,"まが"],[35,2,"ぶき"],[37,1,"くら"],[39,1,"のぼ"],[41,1,"ところ"],[43,1,"む"],[46,1,"あ"],[49,1,"た"],[51,2,"ぶぶん"],[54,2,"しゅうり"]],"text":"その次にエシュアの子でミヅパの知事であるエゼルが、城壁の曲りかどにある武器倉に上る所と向かい合った他の部分を修理し、"},{"ref":"Neh.3.20","start":16003020,"end":16003020,"break":"none","ruby":[[2,1,"のち"],[8,1,"こ"],[14,1,"ちから"],[20,2,"じょうへき"],[23,1,"まが"],[29,1,"だい"],[30,2,"さいし"],[38,1,"いえ"],[40,1,"もん"],[44,1,"た"],[46,2,"ぶぶん"],[49,2,"しゅうり"]],"text":"その後にザバイの子バルクが、力をつくして城壁の曲りかどから大祭司エリアシブの家の門までの他の部分を修理し、"},{"ref":"Neh.3.21","start":16003021,"end":16003021,"break":"none","ruby":[[2,1,"のち"],[9,1,"こ"],[14,1,"こ"],[27,1,"いえ"],[29,1,"もん"],[38,1,"いえ"],[40,1,"たん"],[44,1,"た"],[46,2,"ぶぶん"],[49,2,"しゅうり"]],"text":"その後にハッコヅの子ウリヤの子メレモテが、エリアシブの家の門からエリアシブの家の端までの他の部分を修理し、"},{"ref":"Neh.3.22","start":16003022,"end":16003022,"break":"none","ruby":[[0,1,"かれ"],[2,1,"のち"],[4,2,"ていち"],[7,2,"ひとびと"],[12,2,"さいし"],[17,2,"しゅうり"]],"text":"彼の後に低地の人々である祭司たちが修理し、"},{"ref":"Neh.3.23","start":16003023,"end":16003023,"break":"none","ruby":[[2,1,"のち"],[18,2,"じぶん"],[23,1,"いえ"],[25,1,"む"],[28,1,"あ"],[33,1,"ところ"],[35,2,"しゅうり"],[41,1,"のち"],[48,1,"こ"],[54,1,"こ"],[61,2,"じぶん"],[64,1,"いえ"],[66,2,"ふきん"],[69,2,"しゅうり"]],"text":"その後にベニヤミンおよびハシュブが、自分たちの家と向かい合っている所を修理し、その後にアナニヤの子マアセヤの子アザリヤが、自分の家の附近を修理し、"},{"ref":"Neh.3.24","start":16003024,"end":16003024,"break":"none","ruby":[[2,1,"のち"],[9,1,"こ"],[21,1,"いえ"],[24,2,"じょうへき"],[27,1,"まが"],[40,1,"た"],[42,2,"ぶぶん"],[45,2,"しゅうり"]],"text":"その後にヘナダデの子ビンヌイが、アザリヤの家から城壁の曲りかど、およびすみまでの他の部分を修理した。"},{"ref":"Neh.3.25","start":16003025,"end":16003025,"break":"none","ruby":[[4,1,"こ"],[10,2,"じょうへき"],[13,1,"まが"],[18,1,"む"],[21,1,"あ"],[26,1,"ところ"],[31,2,"かんし"],[34,1,"にわ"],[36,1,"ちか"],[38,1,"おう"],[40,1,"うえ"],[42,1,"いえ"],[45,1,"つ"],[47,1,"で"],[51,2,"ぼうろう"],[54,1,"む"],[57,1,"あ"],[62,1,"ところ"],[64,2,"しゅうり"],[71,1,"のち"],[77,1,"こ"]],"text":"ウザイの子パラルは、城壁の曲りかどと向かい合っている所、および監視の庭に近い王の上の家から突き出ている望楼と向かい合っている所を修理した。その後にパロシの子ペダヤ、"},{"ref":"Neh.3.26","start":16003026,"end":16003026,"break":"none","ruby":[[7,1,"す"],[12,1,"みや"],[14,1,"つか"],[24,1,"ひがし"],[26,1,"ほう"],[28,1,"みず"],[30,1,"もん"],[32,1,"む"],[35,1,"あ"],[40,1,"ところ"],[45,1,"つ"],[47,1,"で"],[51,2,"ぼうろう"],[54,1,"む"],[57,1,"あ"],[62,1,"ところ"],[65,2,"しゅうり"]],"text":"およびオペルに住んでいる宮に仕えるしもべたちが、東の方の水の門と向かい合っている所、および突き出ている望楼と向かい合っている所まで修理した。"},{"ref":"Neh.3.27","start":16003027,"end":16003027,"break":"none","ruby":[[2,1,"のち"],[11,1,"つ"],[13,1,"で"],[17,1,"だい"],[18,2,"ぼうろう"],[21,1,"む"],[24,1,"あ"],[29,1,"た"],[31,2,"ぶぶん"],[34,2,"しゅうり"],[42,2,"じょうへき"],[47,1,"およ"]],"text":"その後にテコアびとが、突き出ている大望楼と向かい合っている他の部分を修理し、オペルの城壁にまで及んだ。"},{"ref":"Neh.3.28","start":16003028,"end":16003028,"break":"paragraph","ruby":[[0,1,"うま"],[2,1,"もん"],[5,1,"うえ"],[7,1,"ほう"],[9,2,"さいし"],[19,2,"じぶん"],[22,1,"いえ"],[24,1,"む"],[27,1,"あ"],[32,1,"ところ"],[34,2,"しゅうり"]],"text":"馬の門から上の方は祭司たちが、おのおの自分の家と向かい合っている所を修理した。"},{"ref":"Neh.3.29","start":16003029,"end":16003029,"break":"none","ruby":[[2,1,"のち"],[9,1,"こ"],[15,2,"じぶん"],[18,1,"いえ"],[20,1,"む"],[23,1,"あ"],[28,1,"ところ"],[30,2,"しゅうり"],[36,1,"のち"],[43,1,"こ"],[50,1,"ひがし"],[52,1,"もん"],[54,1,"まも"],[56,1,"もの"],[58,2,"しゅうり"]],"text":"その後にインメルの子ザドクが、自分の家と向かい合っている所を修理し、その後にシカニヤの子シマヤという東の門を守る者が修理し、"},{"ref":"Neh.3.30","start":16003030,"end":16003030,"break":"none","ruby":[[2,1,"のち"],[9,1,"こ"],[21,1,"だい"],[24,1,"こ"],[29,1,"た"],[31,2,"ぶぶん"],[34,2,"しゅうり"],[40,1,"のち"],[47,1,"こ"],[55,2,"じぶん"],[61,1,"む"],[64,1,"あ"],[69,1,"ところ"],[71,2,"しゅうり"]],"text":"その後にシレミヤの子ハナニヤおよびザラフの第六の子ハヌンが他の部分を修理し、その後にベレキヤの子メシュラムが、自分のへやと向かい合っている所を修理した。"},{"ref":"Neh.3.31","start":16003031,"end":16003031,"break":"none","ruby":[[2,1,"のち"],[4,1,"きん"],[5,3,"ざいくにん"],[19,1,"もの"],[22,2,"しょうしゅう"],[25,1,"もん"],[27,1,"む"],[30,1,"あ"],[35,1,"ところ"],[37,2,"しゅうり"],[46,1,"かい"],[51,1,"いた"],[54,1,"みや"],[56,1,"つか"],[67,2,"しょうにん"],[70,1,"いえ"],[74,1,"およ"]],"text":"その後に金細工人のひとりマルキヤという者が、召集の門と向かい合っている所を修理して、すみの二階のへやに至り、宮に仕えるしもべたちおよび商人の家にまで及んだ。"},{"ref":"Neh.3.32","start":16003032,"end":16003032,"break":"none","ruby":[[6,1,"かい"],[11,1,"ひつじ"],[13,1,"もん"],[15,1,"あいだ"],[17,1,"きん"],[18,3,"ざいくにん"],[22,2,"しょうにん"],[30,2,"しゅうり"]],"text":"またすみの二階のへやと羊の門の間は金細工人と商人たちがこれを修理した。"}]