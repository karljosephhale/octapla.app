[{"ref":"1Kgs.3.1","start":11003001,"end":11003001,"break":"paragraph","ruby":[[4,1,"おう"],[11,1,"おう"],[15,1,"ふち"],[17,1,"むす"],[23,1,"むすめ"],[33,1,"まち"],[35,1,"つ"],[41,2,"じぶん"],[44,1,"いえ"],[47,1,"しゅ"],[49,1,"みや"],[58,2,"しゅうい"],[61,2,"じょうへき"],[64,1,"た"],[66,1,"おわ"]],"text":"ソロモン王はエジプトの王パロと縁を結び、パロの娘をめとってダビデの町に連れてきて、自分の家と、主の宮と、エルサレムの周囲の城壁を建て終るまでそこにおらせた。"},{"ref":"1Kgs.3.2","start":11003002,"end":11003002,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"な"],[13,1,"た"],[16,1,"みや"],[25,1,"たみ"],[27,1,"たか"],[29,1,"ところ"],[31,2,"ぎせい"]],"text":"そのころまで主の名のために建てた宮がなかったので、民は高き所で犠牲をささげていた。"},{"ref":"1Kgs.3.3","start":11003003,"end":11003003,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,1,"あい"],[10,1,"ちち"],[15,1,"さだ"],[18,1,"あゆ"],[25,1,"かれ"],[27,1,"たか"],[29,1,"ところ"],[31,2,"ぎせい"],[38,1,"こう"]],"text":"ソロモンは主を愛し、父ダビデの定めに歩んだが、ただ彼は高き所で犠牲をささげ、香をたいた。"},{"ref":"1Kgs.3.4","start":11003004,"end":11003004,"break":"none","ruby":[[2,1,"ひ"],[4,1,"おう"],[11,1,"い"],[18,2,"ぎせい"],[33,2,"しゅよう"],[36,1,"たか"],[38,1,"ところ"],[57,2,"はんさい"],[62,2,"さいだん"]],"text":"ある日、王はギベオンへ行って、そこで犠牲をささげようとした。それが主要な高き所であったからである。ソロモンは一千の燔祭をその祭壇にささげた。"},{"ref":"1Kgs.3.5","start":11003005,"end":11003005,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"よ"],[9,1,"ゆめ"],[16,1,"あらわ"],[19,1,"い"],[29,1,"なに"],[31,1,"あた"],[37,1,"もと"]],"text":"ギベオンで主は夜の夢にソロモンに現れて言われた、「あなたに何を与えようか、求めなさい」。"},{"ref":"1Kgs.3.6","start":11003006,"end":11003006,"break":"none","ruby":[[5,1,"い"],[24,1,"ちち"],[33,1,"たい"],[36,2,"せいじつ"],[39,2,"こうぎ"],[42,2,"まごころ"],[54,1,"まえ"],[56,1,"あゆ"],[66,1,"おお"],[76,1,"かれ"],[78,1,"しめ"],[91,1,"かれ"],[99,1,"おお"],[115,2,"こんにち"],[118,1,"かれ"],[120,1,"くらい"],[122,1,"ざ"],[125,1,"こ"],[127,1,"さづ"]],"text":"ソロモンは言った、「あなたのしもべであるわたしの父ダビデがあなたに対して誠実と公義と真心とをもって、あなたの前に歩んだので、あなたは大いなるいつくしみを彼に示されました。またあなたは彼のために、この大いなるいつくしみをたくわえて、今日、彼の位に座する子を授けられました。"},{"ref":"1Kgs.3.7","start":11003007,"end":11003007,"break":"none","ruby":[[2,1,"かみ"],[4,1,"しゅ"],[22,1,"ちち"],[27,1,"かわ"],[30,1,"おう"],[49,1,"ちい"],[52,2,"こども"],[59,2,"でい"],[67,1,"し"]],"text":"わが神、主よ、あなたはこのしもべを、わたしの父ダビデに代って王とならせられました。しかし、わたしは小さい子供であって、出入りすることを知りません。"},{"ref":"1Kgs.3.8","start":11003008,"end":11003008,"break":"none","ruby":[[11,1,"えら"],[20,1,"たみ"],[28,1,"かず"],[30,1,"おお"],[34,1,"かぞ"],[41,1,"しら"],[60,1,"たみ"],[62,1,"なか"]],"text":"かつ、しもべはあなたが選ばれた、あなたの民、すなわちその数が多くて、数えることも、調べることもできないほどのおびただしい民の中におります。"},{"ref":"1Kgs.3.9","start":11003009,"end":11003009,"break":"none","ruby":[[5,1,"き"],[10,1,"こころ"],[16,1,"あた"],[24,1,"たみ"],[35,2,"ぜんあく"],[46,1,"え"],[65,1,"おお"],[69,1,"たみ"]],"text":"それゆえ、聞きわける心をしもべに与えて、あなたの民をさばかせ、わたしに善悪をわきまえることを得させてください。だれが、あなたのこの大いなる民をさばくことができましょう」。"},{"ref":"1Kgs.3.10","start":11003010,"end":11003010,"break":"paragraph","ruby":[[7,1,"こと"],[9,1,"もと"],[20,1,"しゅ"]],"text":"ソロモンはこの事を求めたので、そのことが主のみこころにかなった。"},{"ref":"1Kgs.3.11","start":11003011,"end":11003011,"break":"none","ruby":[[3,1,"かみ"],[5,1,"かれ"],[7,1,"い"],[19,1,"こと"],[21,1,"もと"],[25,2,"じぶん"],[31,2,"ちょうめい"],[34,1,"もと"],[40,2,"じぶん"],[46,1,"とみ"],[48,1,"もと"],[54,2,"じぶん"],[57,1,"てき"],[59,1,"いのち"],[62,1,"もと"],[68,1,"うった"],[76,2,"ちえ"],[79,1,"もと"]],"text":"そこで神は彼に言われた、「あなたはこの事を求めて、自分のために長命を求めず、また自分のために富を求めず、また自分の敵の命をも求めず、ただ訴えをききわける知恵を求めたゆえに、"},{"ref":"1Kgs.3.12","start":11003012,"end":11003012,"break":"none","ruby":[[0,1,"み"],[11,2,"ことば"],[20,1,"かしこ"],[23,2,"えいめい"],[26,1,"こころ"],[28,1,"あた"],[36,1,"さき"],[43,1,"なら"],[45,1,"もの"],[54,1,"のち"],[61,1,"なら"],[63,1,"もの"],[65,1,"おこ"]],"text":"見よ、わたしはあなたの言葉にしたがって、賢い、英明な心を与える。あなたの先にはあなたに並ぶ者がなく、あなたの後にもあなたに並ぶ者は起らないであろう。"},{"ref":"1Kgs.3.13","start":11003013,"end":11003013,"break":"none","ruby":[[10,1,"もと"],[21,1,"とみ"],[23,1,"ほまれ"],[30,1,"あた"],[38,1,"い"],[47,1,"おう"],[58,1,"なら"],[60,1,"もの"]],"text":"わたしはまたあなたの求めないもの、すなわち富と誉をもあなたに与える。あなたの生きているかぎり、王たちのうちにあなたに並ぶ者はないであろう。"},{"ref":"1Kgs.3.14","start":11003014,"end":11003014,"break":"none","ruby":[[11,1,"ちち"],[16,1,"あゆ"],[27,1,"みち"],[29,1,"あゆ"],[37,1,"さだ"],[40,2,"めいれい"],[44,1,"まも"],[58,1,"ひ"],[60,1,"なが"]],"text":"もしあなたが、あなたの父ダビデの歩んだように、わたしの道に歩んで、わたしの定めと命令とを守るならば、わたしはあなたの日を長くするであろう」。"},{"ref":"1Kgs.3.15","start":11003015,"end":11003015,"break":"paragraph","ruby":[[5,1,"め"],[18,1,"ゆめ"],[27,1,"かれ"],[35,1,"い"],[38,1,"しゅ"],[40,2,"けいやく"],[43,1,"はこ"],[45,1,"まえ"],[47,1,"た"],[50,2,"はんさい"],[53,3,"しゅうおんさい"],[65,2,"けらい"],[71,2,"しゅくえん"],[74,1,"もう"]],"text":"ソロモンが目をさましてみると、それは夢であった。そこで彼はエルサレムへ行き、主の契約の箱の前に立って燔祭と酬恩祭をささげ、すべての家来のために祝宴を設けた。"},{"ref":"1Kgs.3.16","start":11003016,"end":11003016,"break":"paragraph","ruby":[[7,2,"ゆうじょ"],[10,1,"おう"],[19,1,"おう"],[21,1,"まえ"],[23,1,"た"]],"text":"さて、ふたりの遊女が王のところにきて、王の前に立った。"},{"ref":"1Kgs.3.17","start":11003017,"end":11003017,"break":"none","ruby":[[4,1,"おんな"],[6,1,"い"],[16,1,"しゅ"],[21,1,"おんな"],[32,1,"いえ"],[34,1,"す"],[48,1,"おんな"],[50,2,"いっしょ"],[53,1,"いえ"],[57,1,"とき"],[59,1,"こ"],[61,1,"う"]],"text":"ひとりの女は言った、「ああ、わが主よ、この女とわたしとはひとつの家に住んでいますが、わたしはこの女と一緒に家にいる時、子を産みました。"},{"ref":"1Kgs.3.18","start":11003018,"end":11003018,"break":"none","ruby":[[8,1,"う"],[11,1,"のち"],[14,1,"か"],[15,1,"め"],[19,1,"おんな"],[23,1,"こ"],[25,1,"う"],[40,2,"いっしょ"],[49,1,"いえ"],[64,1,"とも"],[68,1,"もの"]],"text":"ところがわたしの産んだ後、三日目にこの女もまた子を産みました。そしてわたしたちは一緒にいましたが、家にはほかにだれもわたしたちと共にいた者はなく、ただわたしたちふたりだけでした。"},{"ref":"1Kgs.3.19","start":11003019,"end":11003019,"break":"none","ruby":[[6,1,"おんな"],[8,2,"じぶん"],[11,1,"こ"],[13,1,"うえ"],[15,1,"ふ"],[21,1,"よる"],[28,1,"こ"],[30,1,"し"]],"text":"ところがこの女は自分の子の上に伏したので、夜のうちにその子は死にました。"},{"ref":"1Kgs.3.20","start":11003020,"end":11003020,"break":"none","ruby":[[0,2,"かのじょ"],[3,2,"よなか"],[6,1,"お"],[15,1,"ねむ"],[20,1,"あいだ"],[27,1,"こ"],[39,1,"と"],[43,2,"じぶん"],[51,1,"ね"],[55,2,"じぶん"],[58,1,"し"],[61,1,"こ"],[72,1,"ね"]],"text":"彼女は夜中に起きて、はしための眠っている間に、わたしの子をわたしのかたわらから取って、自分のふところに寝かせ、自分の死んだ子をわたしのふところに寝かせました。"},{"ref":"1Kgs.3.21","start":11003021,"end":11003021,"break":"none","ruby":[[4,1,"あさ"],[6,1,"こ"],[8,1,"ちち"],[10,1,"の"],[18,1,"お"],[21,1,"み"],[24,1,"し"],[35,1,"あさ"],[42,1,"み"],[53,1,"う"],[56,1,"こ"]],"text":"わたしは朝、子に乳を飲ませようとして起きて見ると死んでいました。しかし朝になってよく見ると、それはわたしが産んだ子ではありませんでした」。"},{"ref":"1Kgs.3.22","start":11003022,"end":11003022,"break":"none","ruby":[[3,1,"おんな"],[5,1,"い"],[14,1,"い"],[25,1,"こ"],[29,1,"し"],[38,1,"こ"],[43,1,"はじ"],[46,1,"おんな"],[48,1,"い"],[57,1,"し"],[66,1,"こ"],[70,1,"い"],[81,1,"こ"],[86,1,"かれ"],[94,1,"おう"],[96,1,"まえ"],[98,1,"い"],[100,1,"あ"]],"text":"ほかの女は言った、「いいえ、生きているのがわたしの子です。死んだのはあなたの子です」。初めの女は言った、「いいえ、死んだのがあなたの子です。生きているのはわたしの子です」。彼らはこのように王の前に言い合った。"},{"ref":"1Kgs.3.23","start":11003023,"end":11003023,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"おう"],[6,1,"い"],[18,1,"い"],[29,1,"こ"],[32,1,"し"],[41,1,"こ"],[45,1,"い"],[59,1,"し"],[68,1,"こ"],[71,1,"い"],[82,1,"こ"],[86,1,"い"]],"text":"この時、王は言った、「ひとりは『この生きているのがわたしの子で、死んだのがあなたの子だ』と言い、またひとりは『いいえ、死んだのがあなたの子で、生きているのはわたしの子だ』と言う」。"},{"ref":"1Kgs.3.24","start":11003024,"end":11003024,"break":"none","ruby":[[3,1,"おう"],[6,1,"かたな"],[8,1,"も"],[17,1,"い"],[23,1,"かたな"],[25,1,"おう"],[27,1,"まえ"],[29,1,"も"]],"text":"そこで王は「刀を持ってきなさい」と言ったので、刀を王の前に持ってきた。"},{"ref":"1Kgs.3.25","start":11003025,"end":11003025,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[7,1,"い"],[12,1,"こ"],[17,1,"わ"],[21,2,"はんぶん"],[29,2,"はんぶん"],[36,1,"あた"]],"text":"王は言った、「生きている子を二つに分けて、半分をこちらに、半分をあちらに与えよ」。"},{"ref":"1Kgs.3.26","start":11003026,"end":11003026,"break":"none","ruby":[[3,1,"い"],[8,1,"こ"],[10,1,"はは"],[14,1,"おんな"],[19,1,"こ"],[24,1,"こころ"],[36,1,"おう"],[38,1,"い"],[48,1,"しゅ"],[51,1,"い"],[56,1,"こ"],[58,2,"かのじょ"],[61,1,"あた"],[69,1,"けっ"],[75,1,"ころ"],[96,1,"い"],[126,1,"わ"]],"text":"すると生きている子の母である女は、その子のために心がやけるようになって、王に言った、「ああ、わが主よ、生きている子を彼女に与えてください。決してそれを殺さないでください」。しかしほかのひとりは言った、「それをわたしのものにも、あなたのものにもしないで、分けてください」。"},{"ref":"1Kgs.3.27","start":11003027,"end":11003027,"break":"none","ruby":[[3,1,"おう"],[5,1,"こた"],[8,1,"い"],[13,1,"い"],[18,1,"こ"],[20,1,"はじ"],[23,1,"おんな"],[25,1,"あた"],[29,1,"けっ"],[32,1,"ころ"],[41,2,"かのじょ"],[46,1,"はは"]],"text":"すると王は答えて言った、「生きている子を初めの女に与えよ。決して殺してはならない。彼女はその母なのだ」。"},{"ref":"1Kgs.3.28","start":11003028,"end":11003028,"break":"none","ruby":[[6,1,"みな"],[7,1,"おう"],[9,1,"あた"],[12,2,"はんけつ"],[15,1,"き"],[18,1,"おう"],[20,1,"おそ"],[24,1,"かみ"],[26,2,"ちえ"],[29,1,"かれ"],[46,1,"み"]],"text":"イスラエルは皆王が与えた判決を聞いて王を恐れた。神の知恵が彼のうちにあって、さばきをするのを見たからである。"}]