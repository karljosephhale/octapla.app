[{"ref":"Job.41.1","start":18041001,"end":18041001,"break":"paragraph","breaks":[[8,"line"],[23,"line"]],"ruby":[[6,1,"ばり"],[13,1,"だ"],[23,1,"いと"],[27,1,"した"],[29,1,"おさ"]],"text":"あなたはつり針でわにをつり出すことができるか。糸でその舌を押えることができるか。"},{"ref":"Job.41.2","start":18041002,"end":18041002,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"あし"],[11,1,"はな"],[13,1,"とお"],[25,1,"ばり"],[32,1,"つ"],[34,1,"とお"]],"text":"あなたは葦のなわをその鼻に通すことができるか。つり針でそのあごを突き通すことができるか。"},{"ref":"Job.41.3","start":18041003,"end":18041003,"break":"line","breaks":[[23,"line"]],"ruby":[[12,1,"ねが"],[14,1,"もと"],[23,1,"やわ"],[27,2,"ことば"],[34,1,"かた"]],"text":"これはしきりに、あなたに願い求めるであろうか。柔らかな言葉をあなたに語るであろうか。"},{"ref":"Job.41.4","start":18041004,"end":18041004,"break":"line","breaks":[[18,"line"],[40,"line"]],"ruby":[[7,2,"けいやく"],[10,1,"むす"],[25,1,"と"]],"text":"これはあなたと契約を結ぶであろうか。あなたはこれを取って、ながくあなたのしもべとすることができるであろうか。"},{"ref":"Job.41.5","start":18041005,"end":18041005,"break":"line","breaks":[[18,"line"],[34,"line"]],"ruby":[[4,1,"とり"],[6,1,"たわむ"],[15,1,"たわむ"]],"text":"あなたは鳥と戯れるようにこれと戯れ、またあなたのおとめたちのために、これをつないでおくことができるであろうか。"},{"ref":"Job.41.6","start":18041006,"end":18041006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"しょうにん"],[3,2,"なかま"],[9,2,"しょうひん"],[15,2,"こうり"],[17,2,"しょうにん"],[20,1,"あいだ"],[22,1,"わ"]],"text":"商人の仲間はこれを商品として、小売商人の間に分けるであろうか。"},{"ref":"Job.41.7","start":18041007,"end":18041007,"break":"line","breaks":[[16,"line"]],"ruby":[[10,1,"かわ"],[12,1,"み"],[21,1,"あたま"],[23,1,"つ"],[25,1,"とお"]],"text":"あなたは、もりでその皮を満たし、やすでその頭を突き通すことができるか。"},{"ref":"Job.41.8","start":18041008,"end":18041008,"break":"line","breaks":[[14,"line"],[27,"line"]],"ruby":[[4,1,"て"],[9,1,"うえ"],[11,1,"お"],[18,1,"たたか"],[21,1,"おも"],[23,1,"だ"],[27,1,"ふたた"]],"text":"あなたの手をこれの上に置け、あなたは戦いを思い出して、再びこれをしないであろう。"},{"ref":"Job.41.9","start":18041009,"end":18041009,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"み"],[5,1,"のぞ"],[18,1,"み"],[22,1,"たお"]],"text":"見よ、その望みはむなしくなり、これを見てすら倒れる。"},{"ref":"Job.41.10","start":18041010,"end":18041010,"break":"line","breaks":[[23,"line"]],"ruby":[[6,1,"げき"],[9,2,"ゆうき"],[14,1,"もの"],[34,1,"まえ"],[36,1,"た"]],"text":"あえてこれを激する勇気のある者はひとりもない。それで、だれがわたしの前に立つことができるか。"},{"ref":"Job.41.11","start":18041011,"end":18041011,"break":"line","breaks":[[15,"line"],[28,"line"]],"ruby":[[3,1,"さき"],[9,1,"あた"],[22,1,"むく"],[28,1,"あめ"],[30,1,"した"]],"text":"だれが先にわたしに与えたので、わたしはこれに報いるのか。天が下にあるものは、ことごとくわたしのものだ。"},{"ref":"Job.41.12","start":18041012,"end":18041012,"break":"stanza","breaks":[[19,"line"],[30,"line"]],"ruby":[[7,2,"ぜんしん"],[13,1,"いちじる"],[16,1,"ちから"],[21,1,"うつく"],[24,2,"こうぞう"],[30,1,"だま"]],"text":"わたしはこれが全身と、その著しい力と、その美しい構造について黙っていることはできない。"},{"ref":"Job.41.13","start":18041013,"end":18041013,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[5,2,"うわぎ"],[23,2,"ふたえ"],[30,1,"あいだ"]],"text":"だれがその上着をはぐことができるか。だれがその二重のよろいの間にはいることができるか。"},{"ref":"Job.41.14","start":18041014,"end":18041014,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"かお"],[7,1,"と"],[9,1,"ひら"],[25,1,"は"],[27,1,"おそ"]],"text":"だれがその顔の戸を開くことができるか。そのまわりの歯は恐ろしい。"},{"ref":"Job.41.15","start":18041015,"end":18041015,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"せ"],[4,1,"たて"],[6,1,"れつ"],[16,1,"かた"],[18,1,"と"],[24,2,"みっぷう"]],"text":"その背は盾の列でできていて、その堅く閉じたさまは密封したように、"},{"ref":"Job.41.16","start":18041016,"end":18041016,"break":"line","breaks":[[8,"line"]],"ruby":[[0,2,"そうご"],[3,2,"みっせつ"],[8,1,"かぜ"],[12,1,"あいだ"]],"text":"相互に密接して、風もその間に、はいることができず、"},{"ref":"Job.41.17","start":18041017,"end":18041017,"break":"line","breaks":[[7,"line"]],"ruby":[[0,1,"たがい"],[2,2,"あいつら"],[7,1,"かた"],[9,1,"つ"],[12,1,"はな"]],"text":"互に相連なり、固く着いて離すことができない。"},{"ref":"Job.41.18","start":18041018,"end":18041018,"break":"line","breaks":[[16,"line"]],"ruby":[[11,1,"ひかり"],[13,1,"はっ"],[18,1,"め"],[29,1,"に"]],"text":"これが、くしゃみすれば光を発し、その目はあけぼののまぶたに似ている。"},{"ref":"Job.41.19","start":18041019,"end":18041019,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"くち"],[12,1,"も"],[17,2,"ひばな"]],"text":"その口からは、たいまつが燃えいで、火花をいだす。"},{"ref":"Job.41.20","start":18041020,"end":18041020,"break":"line","breaks":[[15,"line"],[33,"line"]],"ruby":[[2,1,"はな"],[4,1,"あな"],[8,1,"けむり"],[10,1,"で"],[19,1,"に"],[21,1,"た"],[26,2,"みずけむり"],[33,1,"も"],[36,1,"あし"],[38,1,"けむり"]],"text":"その鼻の穴からは煙が出てきて、さながら煮え立つなべの水煙のごとく、燃える葦の煙のようだ。"},{"ref":"Job.41.21","start":18041021,"end":18041021,"break":"line","breaks":[[11,"line"]],"ruby":[[2,1,"いき"],[4,2,"すみび"],[13,1,"くち"],[17,1,"ほのお"],[19,1,"で"]],"text":"その息は炭火をおこし、その口からは炎が出る。"},{"ref":"Job.41.22","start":18041022,"end":18041022,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"くび"],[5,1,"ちから"],[7,1,"やど"],[13,1,"おそ"],[21,1,"まえ"],[23,1,"おど"]],"text":"その首には力が宿っていて、恐ろしさが、その前に踊っている。"},{"ref":"Job.41.23","start":18041023,"end":18041023,"break":"line","breaks":[[13,"line"]],"ruby":[[2,2,"にくへん"],[5,2,"みっせつ"],[8,2,"あいつら"],[13,1,"かた"],[15,1,"み"],[17,1,"つ"],[20,1,"うご"]],"text":"その肉片は密接に相連なり、固く身に着いて動かすことができない。"},{"ref":"Job.41.24","start":18041024,"end":18041024,"break":"line","breaks":[[13,"line"]],"ruby":[[2,2,"しんぞう"],[5,1,"いし"],[10,1,"かた"],[16,1,"した"],[17,1,"いし"],[22,1,"かた"]],"text":"その心臓は石のように堅く、うすの下石のように堅い。"},{"ref":"Job.41.25","start":18041025,"end":18041025,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"み"],[4,1,"おこ"],[9,2,"ゆうし"],[12,1,"おそ"],[17,2,"しょうげき"],[26,1,"まど"]],"text":"その身を起すときは勇士も恐れ、その衝撃によってあわて惑う。"},{"ref":"Job.41.26","start":18041026,"end":18041026,"break":"line","breaks":[[17,"line"]],"ruby":[[7,1,"う"],[21,1,"や"],[27,1,"よう"]],"text":"つるぎがこれを撃っても、きかない、やりも、矢も、もりも用をなさない。"},{"ref":"Job.41.27","start":18041027,"end":18041027,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"てつ"],[5,1,"み"],[17,2,"せいどう"],[20,1,"み"],[24,1,"く"],[26,1,"き"]],"text":"これは鉄を見ること、わらのように、青銅を見ること朽ち木のようである。"},{"ref":"Job.41.28","start":18041028,"end":18041028,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ゆみや"],[6,2,"にが"],[17,1,"いし"],[18,1,"な"],[21,1,"いし"]],"text":"弓矢もこれを逃がすことができない。石投げの石もこれには、わらくずとなる。"},{"ref":"Job.41.29","start":18041029,"end":18041029,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"ぼう"],[17,1,"な"],[22,1,"ひび"],[31,1,"わら"]],"text":"こん棒もわらくずのようにみなされ、投げやりの響きを、これはあざ笑う。"},{"ref":"Job.41.30","start":18041030,"end":18041030,"break":"line","breaks":[[19,"line"]],"ruby":[[2,2,"かふく"],[5,1,"するど"],[19,1,"むぎ"],[22,1,"いた"],[29,1,"み"],[31,1,"どろ"],[33,1,"うえ"],[35,1,"の"]],"text":"その下腹は鋭いかわらのかけらのようで、麦こき板のようにその身を泥の上に伸ばす。"},{"ref":"Job.41.31","start":18041031,"end":18041031,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"ふち"],[12,1,"わ"],[19,1,"うみ"],[21,2,"こうゆ"]],"text":"これは淵をかなえのように沸きかえらせ、海を香油のなべのようにする。"},{"ref":"Job.41.32","start":18041032,"end":18041032,"break":"line","breaks":[[16,"line"]],"ruby":[[3,2,"じぶん"],[9,1,"ひか"],[11,1,"みち"],[13,1,"のこ"],[16,1,"ふち"],[25,1,"おも"]],"text":"これは自分のあとに光る道を残し、淵をしらがのように思わせる。"},{"ref":"Job.41.33","start":18041033,"end":18041033,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ち"],[2,1,"うえ"],[8,1,"なら"],[18,1,"おそ"],[23,1,"もの"],[25,1,"つく"]],"text":"地の上にはこれと並ぶものなく、これは恐れのない者に造られた。"},{"ref":"Job.41.34","start":18041034,"end":18041034,"break":"line","breaks":[[16,"line"]],"ruby":[[7,1,"たか"],[9,1,"もの"],[20,1,"ほこ"],[22,1,"たか"],[25,1,"もの"],[27,1,"おう"]],"text":"これはすべての高き者をさげすみ、すべての誇り高ぶる者の王である」。"}]