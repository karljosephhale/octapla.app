[{"ref":"Ps.103.1","start":19103001,"end":19103001,"break":"paragraph","title":"ダビデの歌","breaks":[[14,"line"],[28,"line"]],"ruby":[[8,1,"しゅ"],[30,1,"せい"],[34,1,"な"]],"titleRuby":[[4,1,"うた"]],"text":"わがたましいよ、主をほめよ。わがうちなるすべてのものよ、その聖なるみ名をほめよ。"},{"ref":"Ps.103.2","start":19103002,"end":19103002,"break":"line","breaks":[[14,"line"]],"ruby":[[8,1,"しゅ"],[24,1,"こころ"]],"text":"わがたましいよ、主をほめよ。そのすべてのめぐみを心にとめよ。"},{"ref":"Ps.103.3","start":19103003,"end":19103003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[10,2,"ふぎ"],[25,1,"やまい"]],"text":"主はあなたのすべての不義をゆるし、あなたのすべての病をいやし、"},{"ref":"Ps.103.4","start":19103004,"end":19103004,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"はか"]],"text":"あなたのいのちを墓からあがないいだし、いつくしみと、あわれみとをあなたにこうむらせ、"},{"ref":"Ps.103.5","start":19103005,"end":19103005,"break":"line","breaks":[[15,"line"],[35,"line"]],"ruby":[[4,1,"い"],[15,1,"よ"],[17,1,"もの"],[26,1,"あ"],[28,1,"た"],[43,2,"わかがえ"],[54,1,"あら"]],"text":"あなたの生きながらえるかぎり、良き物をもってあなたを飽き足らせられる。こうしてあなたは若返って、わしのように新たになる。"},{"ref":"Ps.103.6","start":19103006,"end":19103006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[12,1,"もの"],[17,2,"せいぎ"],[20,2,"こうせい"],[24,1,"おこな"]],"text":"主はすべてしえたげられる者のために正義と公正とを行われる。"},{"ref":"Ps.103.7","start":19103007,"end":19103007,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"みち"],[12,1,"し"],[30,2,"ひとびと"],[33,1,"し"]],"text":"主はおのれの道をモーセに知らせ、おのれのしわざをイスラエルの人々に知らせられた。"},{"ref":"Ps.103.8","start":19103008,"end":19103008,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"と"],[17,1,"いか"],[21,1,"おそ"],[29,1,"ゆた"]],"text":"主はあわれみに富み、めぐみふかく、怒ること遅く、いつくしみ豊かでいらせられる。"},{"ref":"Ps.103.9","start":19103009,"end":19103009,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"つね"],[4,1,"せ"],[21,1,"いか"]],"text":"主は常に責めることをせず、また、とこしえに怒りをいだかれない。"},{"ref":"Ps.103.10","start":19103010,"end":19103010,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"つみ"],[27,2,"ふぎ"],[35,1,"むく"]],"text":"主はわれらの罪にしたがってわれらをあしらわず、われらの不義にしたがって報いられない。"},{"ref":"Ps.103.11","start":19103011,"end":19103011,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"てん"],[2,1,"ち"],[6,1,"たか"],[12,1,"しゅ"],[18,1,"おそ"],[21,1,"もの"],[23,1,"たま"],[32,1,"おお"]],"text":"天が地よりも高いように、主がおのれを恐れる者に賜わるいつくしみは大きい、"},{"ref":"Ps.103.12","start":19103012,"end":19103012,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"ひがし"],[2,1,"にし"],[5,1,"とお"],[11,1,"しゅ"],[25,1,"とお"]],"text":"東が西から遠いように、主はわれらのとがをわれらから遠ざけられる。"},{"ref":"Ps.103.13","start":19103013,"end":19103013,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ちち"],[4,1,"こ"],[5,1,"ども"],[15,1,"しゅ"],[21,1,"おそ"],[24,1,"もの"]],"text":"父がその子供をあわれむように、主はおのれを恐れる者をあわれまれる。"},{"ref":"Ps.103.14","start":19103014,"end":19103014,"break":"line","breaks":[[16,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"つく"],[13,1,"し"],[28,1,"おぼ"]],"text":"主はわれらの造られたさまを知り、われらのちりであることを覚えていられるからである。"},{"ref":"Ps.103.15","start":19103015,"end":19103015,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ひと"],[9,1,"くさ"],[17,1,"さか"],[20,1,"の"],[22,1,"はな"]],"text":"人は、そのよわいは草のごとく、その栄えは野の花にひとしい。"},{"ref":"Ps.103.16","start":19103016,"end":19103016,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かぜ"],[4,1,"うえ"],[6,1,"す"],[14,1,"あと"],[20,2,"ばしょ"],[34,1,"し"]],"text":"風がその上を過ぎると、うせて跡なく、その場所にきいても、もはやそれを知らない。"},{"ref":"Ps.103.17","start":19103017,"end":19103017,"break":"line","breaks":[[25,"line"]],"ruby":[[3,1,"しゅ"],[25,1,"しゅ"],[27,1,"おそ"],[30,1,"もの"],[32,1,"うえ"],[39,1,"ぎ"],[41,1,"こ"],[44,1,"こ"],[46,1,"およ"]],"text":"しかし主のいつくしみは、とこしえからとこしえまで、主を恐れる者の上にあり、その義は子らの子に及び、"},{"ref":"Ps.103.18","start":19103018,"end":19103018,"break":"line","breaks":[[8,"line"]],"ruby":[[2,2,"けいやく"],[5,1,"まも"],[10,2,"めいれい"],[13,1,"こころ"],[18,1,"おこな"],[20,1,"もの"],[24,1,"およ"]],"text":"その契約を守り、その命令を心にとめて行う者にまで及ぶ。"},{"ref":"Ps.103.19","start":19103019,"end":19103019,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[4,2,"ぎょくざ"],[7,1,"てん"],[9,1,"かた"],[28,1,"もの"],[30,1,"す"],[32,1,"おさ"]],"text":"主はその玉座を天に堅くすえられ、そのまつりごとはすべての物を統べ治める。"},{"ref":"Ps.103.20","start":19103020,"end":19103020,"break":"line","breaks":[[7,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"つかい"],[10,2,"ことば"],[13,1,"こえ"],[15,1,"き"],[22,1,"おこな"],[24,2,"ゆうし"],[30,1,"しゅ"]],"text":"主の使たちよ、そのみ言葉の声を聞いて、これを行う勇士たちよ、主をほめまつれ。"},{"ref":"Ps.103.21","start":19103021,"end":19103021,"break":"line","breaks":[[10,"line"]],"ruby":[[6,2,"ばんぐん"],[17,1,"おこな"],[26,1,"しゅ"]],"text":"そのすべての万軍よ、そのみこころを行うしもべたちよ、主をほめよ。"},{"ref":"Ps.103.22","start":19103022,"end":19103022,"break":"line","breaks":[[13,"line"],[32,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"つく"],[10,1,"もの"],[21,1,"した"],[29,1,"ところ"],[32,1,"しゅ"],[46,1,"しゅ"]],"text":"主が造られたすべての物よ、そのまつりごとの下にあるすべての所で、主をほめよ。わがたましいよ、主をほめよ。"}]