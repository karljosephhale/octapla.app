[{"ref":"1Chr.4.1","start":13004001,"end":13004001,"break":"paragraph","ruby":[[3,1,"こ"]],"text":"ユダの子らはペレヅ、ヘヅロン、カルミ、ホル、ショバルである。"},{"ref":"1Chr.4.2","start":13004002,"end":13004002,"break":"none","ruby":[[5,1,"こ"],[14,1,"う"],[30,1,"う"],[44,2,"いちぞく"]],"text":"ショバルの子レアヤはヤハテを生み、ヤハテはアホマイとラハデを生んだ。これらはザレアびとの一族である。"},{"ref":"1Chr.4.3","start":13004003,"end":13004003,"break":"none","ruby":[[4,1,"こ"],[23,1,"かれ"],[26,2,"しまい"],[29,1,"な"]],"text":"エタムの子らはエズレル、イシマおよびイデバシ、彼らの姉妹の名はハゼレルポニである。"},{"ref":"1Chr.4.4","start":13004004,"end":13004004,"break":"none","ruby":[[4,1,"ちち"],[15,1,"ちち"],[34,1,"ちち"],[40,2,"ちょうし"],[45,1,"こ"]],"text":"ゲドルの父はペヌエル、ホシャの父はエゼルである。これらはベツレヘムの父エフラタの長子ホルの子らである。"},{"ref":"1Chr.4.5","start":13004005,"end":13004005,"break":"none","ruby":[[4,1,"ちち"],[15,1,"つま"]],"text":"テコアの父アシュルにはふたりの妻ヘラとナアラとがあった。"},{"ref":"1Chr.4.6","start":13004006,"end":13004006,"break":"none","ruby":[[33,1,"う"],[45,1,"こ"]],"text":"ナアラはアシュルによってアホザム、ヘペル、テメニおよびアハシタリを産んだ。これらはナアラの子である。"},{"ref":"1Chr.4.7","start":13004007,"end":13004007,"break":"none","ruby":[[3,1,"こ"]],"text":"ヘラの子らはゼレテ、エゾアル、エテナンである。"},{"ref":"1Chr.4.8","start":13004008,"end":13004008,"break":"none","ruby":[[11,1,"う"],[21,1,"こ"],[28,2,"しぞく"],[31,1,"かれ"],[34,1,"で"]],"text":"コヅはアヌブとゾベバを生んだ。またハルムの子アハルヘルの氏族も彼から出た。"},{"ref":"1Chr.4.9","start":13004009,"end":13004009,"break":"none","ruby":[[6,2,"きょうだい"],[12,1,"もっと"],[14,1,"たっと"],[18,1,"もの"],[26,1,"はは"],[33,1,"くる"],[39,1,"こ"],[41,1,"う"],[48,1,"い"],[53,1,"な"],[59,1,"な"]],"text":"ヤベヅはその兄弟のうちで最も尊ばれた者であった。その母が「わたしは苦しんでこの子を産んだから」と言ってその名をヤベヅと名づけたのである。"},{"ref":"1Chr.4.10","start":13004010,"end":13004010,"break":"none","ruby":[[10,1,"かみ"],[12,1,"よ"],[17,1,"い"],[30,1,"ゆた"],[37,1,"めぐ"],[44,2,"こっきょう"],[47,1,"ひろ"],[54,1,"て"],[71,1,"わざわい"],[74,1,"まぬか"],[79,1,"くる"],[96,1,"かみ"],[98,1,"かれ"],[100,1,"もと"]],"text":"ヤベヅはイスラエルの神に呼ばわって言った、「どうか、あなたが豊かにわたしを恵み、わたしの国境を広げ、あなたの手がわたしとともにあって、わたしを災から免れさせ、苦しみをうけさせられないように」。神は彼の求めるところをゆるされた。"},{"ref":"1Chr.4.11","start":13004011,"end":13004011,"break":"none","ruby":[[4,2,"きょうだい"],[14,1,"う"],[27,1,"ちち"]],"text":"シュワの兄弟ケルブはメヒルを生んだ。メヒルはエシトンの父、"},{"ref":"1Chr.4.12","start":13004012,"end":13004012,"break":"none","ruby":[[22,1,"ちち"],[28,1,"う"],[39,2,"ひとびと"]],"text":"エシトンはベテラパ、パセアおよびイルナハシの父テヒンナを生んだ。これらはレカの人々である。"},{"ref":"1Chr.4.13","start":13004013,"end":13004013,"break":"none","ruby":[[4,1,"こ"],[23,1,"こ"]],"text":"ケナズの子らはオテニエルとセラヤ。オテニエルの子らはハタテとメオノタイ。"},{"ref":"1Chr.4.14","start":13004014,"end":13004014,"break":"none","ruby":[[10,1,"う"],[23,1,"ちち"],[28,1,"う"],[32,1,"かれ"],[35,2,"こうじん"],[49,1,"よ"]],"text":"メオノタイはオフラを生み、セラヤはゲハラシムの父ヨアブを生んだ。彼らは工人であったのでゲハラシムと呼ばれたのである。"},{"ref":"1Chr.4.15","start":13004015,"end":13004015,"break":"none","ruby":[[5,1,"こ"],[10,1,"こ"],[28,1,"こ"]],"text":"エフンネの子カレブの子らはイル、エラおよびナアム。エラの子はケナズ。"},{"ref":"1Chr.4.16","start":13004016,"end":13004016,"break":"none","ruby":[[6,1,"こ"]],"text":"エハレレルの子らはジフ、ジバ、テリア、アサレルである。"},{"ref":"1Chr.4.17","start":13004017,"end":13004017,"break":"none","ruby":[[4,1,"こ"],[23,1,"つぎ"],[39,1,"むすめ"],[44,1,"こ"],[54,2,"かのじょ"],[79,1,"う"],[93,1,"ちち"]],"text":"エズラの子らはエテル、メレデ、エペル、ヤロン。次のものはメレデがめとったパロの娘ビテヤの子らである。すなわち彼女はみごもってミリアム、シャンマイおよびイシバを産んだ。イシバはエシテモアの父である。"},{"ref":"1Chr.4.18","start":13004018,"end":13004018,"break":"none","ruby":[[0,1,"かれ"],[2,1,"つま"],[7,1,"ひと"],[14,1,"ちち"],[22,1,"ちち"],[31,1,"ちち"],[38,1,"う"]],"text":"彼の妻はユダヤ人で、ゲドルの父エレデとソコの父ヘベルとザノアの父エクテエルを産んだ。"},{"ref":"1Chr.4.19","start":13004019,"end":13004019,"break":"none","ruby":[[4,2,"しまい"],[13,1,"つま"],[15,1,"こ"],[27,1,"ちち"]],"text":"ナハムの姉妹であるホデヤの妻の子らはガルムびとケイラの父およびマアカびとエシテモアである。"},{"ref":"1Chr.4.20","start":13004020,"end":13004020,"break":"none","ruby":[[4,1,"こ"],[32,1,"こ"]],"text":"シモンの子らはアムノン、リンナ、ベネハナン、テロンである。イシの子らはゾヘテとベネゾヘテである。"},{"ref":"1Chr.4.21","start":13004021,"end":13004021,"break":"none","ruby":[[3,1,"こ"],[7,1,"こ"],[13,1,"ちち"],[22,1,"ちち"],[35,3,"あまぬの"],[38,1,"おり"],[40,1,"いえ"],[42,2,"いちぞく"]],"text":"ユダの子シラの子らはレカの父エル、マレシャの父ラダおよびベテアシベアの亜麻布織の家の一族、"},{"ref":"1Chr.4.22","start":13004022,"end":13004022,"break":"none","ruby":[[8,1,"おさ"],[15,1,"かえ"],[26,2,"ひとびと"],[44,2,"きろく"],[47,1,"ふる"]],"text":"ならびにモアブを治めてレヘムに帰ったヨキム、コゼバの人々、ヨアシおよびサラフである。その記録は古い。"},{"ref":"1Chr.4.23","start":13004023,"end":13004023,"break":"none","ruby":[[4,1,"もの"],[6,2,"とうき"],[9,1,"つく"],[11,1,"ひと"],[25,1,"す"],[28,1,"おう"],[30,1,"よう"],[37,1,"おう"],[46,1,"す"]],"text":"これらの者は陶器を造る人で、ネタイムおよびゲデラに住み、王の用をするため、王とともに、そこに住んだ。"},{"ref":"1Chr.4.24","start":13004024,"end":13004024,"break":"paragraph","ruby":[[5,1,"こ"]],"text":"シメオンの子らはネムエル、ヤミン、ヤリブ、ゼラ、シャウル。"},{"ref":"1Chr.4.25","start":13004025,"end":13004025,"break":"none","ruby":[[5,1,"こ"],[14,1,"こ"],[23,1,"こ"]],"text":"シャウルの子はシャルム、その子はミブサム、その子はミシマ。"},{"ref":"1Chr.4.26","start":13004026,"end":13004026,"break":"none","ruby":[[4,2,"しそん"],[10,1,"こ"],[19,1,"こ"],[28,1,"こ"]],"text":"ミシマの子孫は、その子はハムエル、その子はザックル、その子はシメイ。"},{"ref":"1Chr.4.27","start":13004027,"end":13004027,"break":"none","ruby":[[5,1,"おとこ"],[7,1,"こ"],[10,1,"にん"],[12,1,"おんな"],[14,1,"こ"],[16,1,"にん"],[24,2,"きょうだい"],[30,1,"おお"],[33,1,"こ"],[44,2,"しぞく"],[47,1,"もの"],[55,2,"しそん"]],"text":"シメイには男の子十六人、女の子六人あったが、その兄弟たちには多くの子はなかった。またその氏族の者はすべてユダの子孫ほどにはふえなかった。"},{"ref":"1Chr.4.28","start":13004028,"end":13004028,"break":"none","ruby":[[0,1,"かれ"],[3,1,"す"],[6,1,"ところ"]],"text":"彼らの住んだ所はベエルシバ、モラダ、ハザル・シュアル、"},{"ref":"1Chr.4.29","start":13004029,"end":13004029,"break":"none","text":"ビルハ、エゼム、トラデ、"},{"ref":"1Chr.4.30","start":13004030,"end":13004030,"break":"none","text":"ベトエル、ホルマ、チクラグ、"},{"ref":"1Chr.4.31","start":13004031,"end":13004031,"break":"none","ruby":[[43,1,"よ"],[45,1,"いた"],[49,1,"かれ"],[52,1,"まち"]],"text":"ベテ・マルカボテ、ハザル・スシム、ベテ・ビリ、およびシャライムである。これらはダビデの世に至るまで彼らの町であった。"},{"ref":"1Chr.4.32","start":13004032,"end":13004032,"break":"none","ruby":[[2,2,"むらざと"],[30,1,"まち"]],"text":"その村里はエタム、アイン、リンモン、トケン、アシャンの五つの町である。"},{"ref":"1Chr.4.33","start":13004033,"end":13004033,"break":"none","ruby":[[6,2,"まちまち"],[9,2,"しゅうい"],[12,1,"おお"],[15,1,"むら"],[31,1,"かれ"],[38,2,"いじょう"],[46,1,"かれ"],[53,2,"けいず"]],"text":"またこれらの町々の周囲に多くの村があって、バアルまでおよんだ。彼らのすみかは以上のとおりで、彼らはおのおの系図をもっていた。"},{"ref":"1Chr.4.34","start":13004034,"end":13004034,"break":"none","ruby":[[16,1,"こ"]],"text":"メショバブ、ヤムレク、アマジヤの子ヨシャ、"},{"ref":"1Chr.4.35","start":13004035,"end":13004035,"break":"none","ruby":[[16,1,"まご"],[23,1,"こ"]],"text":"ヨエル、アシエルのひこ、セラヤの孫、ヨシビアの子エヒウ。"},{"ref":"1Chr.4.36","start":13004036,"end":13004036,"break":"none","text":"エリオエナイ、ヤコバ、エショハヤ、アサヤ、アデエル、エシミエル、ベナヤ、"},{"ref":"1Chr.4.37","start":13004037,"end":13004037,"break":"none","ruby":[[6,1,"こ"],[17,1,"こ"],[27,1,"こ"],[37,1,"こ"],[47,1,"こ"]],"text":"およびシピの子ジザ。シピはアロンの子、アロンはエダヤの子、エダヤはシムリの子、シムリはシマヤの子である。"},{"ref":"1Chr.4.38","start":13004038,"end":13004038,"break":"none","ruby":[[3,1,"な"],[8,1,"もの"],[14,2,"しぞく"],[17,1,"ちょう"],[27,2,"しぞく"],[30,1,"おお"],[35,1,"ひろ"]],"text":"ここに名をあげた者どもはその氏族の長であって、それらの氏族は大いにふえ広がった。"},{"ref":"1Chr.4.39","start":13004039,"end":13004039,"break":"none","ruby":[[0,1,"かれ"],[3,1,"む"],[9,2,"まきば"],[12,1,"もと"],[19,2,"いりぐち"],[22,1,"い"],[25,1,"たに"],[27,1,"ひがし"],[29,1,"ほう"],[32,1,"すす"]],"text":"彼らは群れのために牧場を求めてゲドルの入口に行き、谷の東の方まで進み、"},{"ref":"1Chr.4.40","start":13004040,"end":13004040,"break":"none","ruby":[[3,1,"ゆた"],[6,1,"よ"],[8,2,"まきば"],[11,1,"み"],[19,1,"ち"],[21,1,"ひろ"],[23,1,"おだ"],[28,1,"やす"],[38,1,"ち"],[40,1,"まえ"],[42,2,"じゅうみん"]],"text":"ついに豊かな良い牧場を見いだした。その地は広く穏やかで、安らかであった。その地の前の住民はハムびとであったからである。"},{"ref":"1Chr.4.41","start":13004041,"end":13004041,"break":"none","ruby":[[4,1,"な"],[10,1,"もの"],[17,1,"おう"],[23,1,"よ"],[25,1,"い"],[29,1,"かれ"],[32,2,"てんまく"],[47,1,"う"],[49,1,"やぶ"],[52,1,"かれ"],[60,1,"ほろ"],[64,2,"こんにち"],[67,1,"いた"],[78,1,"む"],[84,2,"まきば"],[93,1,"かれ"],[99,1,"す"]],"text":"これらの名をしるした者どもはユダの王ヒゼキヤの世に行って、彼らの天幕と、そこにいたメウニびとを撃ち破り、彼らをことごとく滅ぼして今日に至っている。そこには、群れのための牧場があったので、彼らはそこに住んだ。"},{"ref":"1Chr.4.42","start":13004042,"end":13004042,"break":"none","ruby":[[14,1,"にん"],[19,1,"こ"],[49,1,"やま"],[51,1,"い"]],"text":"またシメオンびとのうちの五百人はイシの子らペラテヤ、ネアリヤ、レパヤ、ウジエルをかしらとしてセイル山に行き、"},{"ref":"1Chr.4.43","start":13004043,"end":13004043,"break":"none","ruby":[[12,1,"のこ"],[17,1,"もの"],[19,1,"う"],[21,1,"ほろ"],[26,2,"こんにち"],[33,1,"す"]],"text":"アマレクびとで、のがれて残っていた者を撃ち滅ぼして、今日までそこに住んでいる。"}]