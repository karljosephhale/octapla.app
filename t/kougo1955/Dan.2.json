[{"ref":"Dan.2.1","start":27002001,"end":27002001,"break":"paragraph","ruby":[[8,2,"ちせい"],[11,1,"だい"],[13,1,"ねん"],[24,1,"ゆめ"],[26,1,"み"],[33,1,"こころ"],[35,1,"おも"],[37,1,"なや"],[40,1,"ねむ"]],"text":"ネブカデネザルの治世の第二年に、ネブカデネザルは夢を見、そのために心に思い悩んで眠ることができなかった。"},{"ref":"Dan.2.2","start":27002002,"end":27002002,"break":"none","ruby":[[3,1,"おう"],[5,1,"めい"],[8,1,"おう"],[15,1,"ゆめ"],[17,1,"と"],[24,2,"はかせ"],[27,1,"ほう"],[28,1,"じゅつ"],[29,1,"し"],[31,2,"まじゅつ"],[33,1,"し"],[42,1,"め"],[49,1,"かれ"],[54,1,"おう"],[56,1,"まえ"],[58,1,"た"]],"text":"そこで王は命じて王のためにその夢を解かせようと、博士、法術士、魔術士、カルデヤびとを召させたので、彼らはきて王の前に立った。"},{"ref":"Dan.2.3","start":27002003,"end":27002003,"break":"none","ruby":[[0,1,"おう"],[2,1,"かれ"],[15,1,"ゆめ"],[17,1,"み"],[23,1,"ゆめ"],[25,1,"し"],[29,1,"こころ"],[31,1,"おも"],[33,1,"なや"],[40,1,"い"]],"text":"王は彼らにむかって、「わたしは夢を見たが、その夢を知ろうと心に思い悩んでいる」と言ったので、"},{"ref":"Dan.2.4","start":27002004,"end":27002004,"break":"none","ruby":[[11,1,"ご"],[13,1,"おう"],[15,1,"い"],[20,1,"おう"],[28,1,"い"],[52,1,"ゆめ"],[55,1,"はな"],[70,1,"と"],[72,1,"あ"],[76,1,"もう"]],"text":"カルデヤびとらはアラム語で王に言った、「王よ、とこしえに生きながらえられますように。どうぞしもべらにその夢をお話しください。わたしたちはその解き明かしを申しあげましょう」。"},{"ref":"Dan.2.5","start":27002005,"end":27002005,"break":"none","ruby":[[0,1,"おう"],[2,1,"こた"],[12,1,"い"],[21,1,"い"],[26,1,"かなら"],[28,1,"おこな"],[41,1,"ゆめ"],[46,1,"と"],[48,1,"あ"],[57,1,"しめ"],[71,1,"み"],[73,1,"き"],[75,1,"さ"],[85,1,"いえ"],[87,1,"ほろ"]],"text":"王は答えてカルデヤびとに言った、「わたしの言うことは必ず行う。あなたがたがもしその夢と、その解き明かしを、わたしに示さないならば、あなたがたの身は切り裂かれ、あなたがたの家は滅ぼされる。"},{"ref":"Dan.2.6","start":27002006,"end":27002006,"break":"none","ruby":[[6,1,"ゆめ"],[10,1,"と"],[12,1,"あ"],[17,1,"しめ"],[23,1,"おく"],[25,1,"もの"],[27,2,"ほうしゅう"],[30,1,"おお"],[34,2,"えいよ"],[44,1,"う"],[57,1,"ゆめ"],[61,1,"と"],[63,1,"あ"],[73,1,"しめ"]],"text":"しかし、その夢とその解き明かしとを示すならば、贈り物と報酬と大いなる栄誉とを、わたしから受けるだろう。それゆえその夢とその解き明かしとを、わたしに示しなさい」。"},{"ref":"Dan.2.7","start":27002007,"end":27002007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"ふたた"],[5,1,"こた"],[8,1,"い"],[13,1,"おう"],[23,1,"ゆめ"],[26,1,"はな"],[46,1,"と"],[48,1,"あ"],[52,1,"しめ"]],"text":"彼らは再び答えて言った、「王よ、しもべらにその夢をお話しください。そうすればわたしたちはその解き明かしを示しましょう」。"},{"ref":"Dan.2.8","start":27002008,"end":27002008,"break":"none","ruby":[[0,1,"おう"],[2,1,"こた"],[5,1,"い"],[20,1,"い"],[27,1,"かなら"],[29,1,"おこな"],[34,2,"しょうち"],[43,1,"とき"],[45,1,"の"],[61,1,"たし"],[64,1,"し"]],"text":"王は答えて言った、「あなたがたはわたしが言ったことは、必ず行うことを承知しているので、時を延ばそうとしているのを、わたしは確かに知っている。"},{"ref":"Dan.2.9","start":27002009,"end":27002009,"break":"none","ruby":[[4,1,"ゆめ"],[10,1,"しめ"],[24,1,"う"],[27,2,"けいばつ"],[46,2,"いっち"],[51,1,"いつわ"],[55,1,"あざむ"],[58,2,"ことば"],[65,1,"まえ"],[67,1,"の"],[71,1,"とき"],[73,1,"かわ"],[77,1,"ま"],[92,1,"ゆめ"],[98,1,"しめ"],[122,1,"と"],[124,1,"あ"],[130,1,"しめ"],[137,1,"し"]],"text":"もしその夢をわたしに示さないならば、あなたがたの受ける刑罰はただ一つあるのみだ。あなたがたは一致して、偽りと、欺きの言葉をわたしの前に述べて、時の変るのを待とうとしているのだ。まずその夢をわたしに示しなさい。そうすれば、わたしはあなたがたがその解き明かしをも、示しうることを知るだろう」。"},{"ref":"Dan.2.10","start":27002010,"end":27002010,"break":"none","ruby":[[8,1,"おう"],[10,1,"まえ"],[12,1,"こた"],[15,1,"い"],[20,1,"よ"],[22,1,"なか"],[25,1,"おう"],[29,2,"ようきゅう"],[32,1,"おう"],[36,1,"もの"],[51,1,"おお"],[55,1,"ちから"],[58,1,"おう"],[67,1,"こと"],[70,2,"はかせ"],[73,1,"ほう"],[74,1,"じゅつ"],[75,1,"し"],[84,1,"たず"],[87,1,"もの"]],"text":"カルデヤびとらは王の前に答えて言った、「世の中には王のその要求に応じうる者はひとりもありません。どんな大いなる力ある王でも、このような事を、博士、法術士、カルデヤびとに尋ねた者はありませんでした。"},{"ref":"Dan.2.11","start":27002011,"end":27002011,"break":"none","ruby":[[0,1,"おう"],[2,1,"たず"],[7,1,"こと"],[14,1,"こと"],[20,1,"にく"],[23,1,"もの"],[25,1,"とも"],[32,2,"かみがみ"],[35,1,"のぞ"],[40,1,"おう"],[42,1,"まえ"],[47,1,"しめ"],[51,1,"もの"]],"text":"王の尋ねられる事はむずかしい事であって、肉なる者と共におられない神々を除いては、王の前にこれを示しうる者はないでしょう」。"},{"ref":"Dan.2.12","start":27002012,"end":27002012,"break":"paragraph","ruby":[[6,1,"おう"],[8,1,"いか"],[13,1,"おお"],[16,1,"いきどお"],[24,2,"ちしゃ"],[30,1,"ほろ"],[34,1,"めい"]],"text":"これによって王は怒り、かつ大いに憤り、バビロンの知者をすべて滅ぼせと命じた。"},{"ref":"Dan.2.13","start":27002013,"end":27002013,"break":"none","ruby":[[2,2,"めいれい"],[5,1,"はっ"],[13,2,"ちしゃ"],[17,1,"ころ"],[37,2,"どうりょう"],[41,1,"ころ"],[45,1,"もと"]],"text":"この命令が発せられたので、知者らは殺されることになった。またダニエルとその同僚をも殺そうと求めた。"},{"ref":"Dan.2.14","start":27002014,"end":27002014,"break":"none","ruby":[[3,1,"おう"],[5,2,"じえい"],[8,1,"ちょう"],[20,2,"ちしゃ"],[24,1,"ころ"],[28,1,"で"],[40,2,"しりょ"],[43,2,"ちえ"],[53,2,"おうとう"]],"text":"そして王の侍衛の長アリオクが、バビロンの知者らを殺そうと出てきたので、ダニエルは思慮と知恵とをもってこれに応答した。"},{"ref":"Dan.2.15","start":27002015,"end":27002015,"break":"none","ruby":[[4,1,"おう"],[6,2,"こうかん"],[18,1,"おう"],[28,2,"めいれい"],[31,1,"だ"],[41,1,"い"],[52,1,"こと"],[59,1,"つ"],[61,1,"し"]],"text":"すなわち王の高官アリオクに「どうして王はそんなにきびしい命令を出されたのですか」と言った。アリオクがその事をダニエルに告げ知らせると、"},{"ref":"Dan.2.16","start":27002016,"end":27002016,"break":"none","ruby":[[5,1,"おう"],[21,1,"と"],[23,1,"あ"],[27,1,"しめ"],[38,1,"とき"],[40,1,"あた"],[47,1,"おう"],[49,1,"ねが"]],"text":"ダニエルは王のところへはいっていって、その解き明かしを示すために、しばらくの時を与えられるよう王に願った。"},{"ref":"Dan.2.17","start":27002017,"end":27002017,"break":"paragraph","ruby":[[9,1,"いえ"],[11,1,"かえ"],[14,2,"どうりょう"],[37,1,"こと"],[39,1,"つ"],[41,1,"し"]],"text":"それからダニエルは家に帰り、同僚のハナニヤ、ミシャエルおよびアザリヤにこの事を告げ知らせ、"},{"ref":"Dan.2.18","start":27002018,"end":27002018,"break":"none","ruby":[[0,1,"とも"],[4,2,"ひみつ"],[10,1,"てん"],[12,1,"かみ"],[19,1,"こ"],[29,2,"どうりょう"],[34,1,"た"],[41,2,"ちしゃ"],[44,1,"とも"],[46,1,"ほろ"],[59,1,"もと"]],"text":"共にこの秘密について天の神のあわれみを請い、ダニエルとその同僚とが、他のバビロンの知者と共に滅ぼされることのないように求めた。"},{"ref":"Dan.2.19","start":27002019,"end":27002019,"break":"none","ruby":[[3,1,"よる"],[5,1,"まぼろし"],[12,2,"ひみつ"],[20,1,"しめ"],[32,1,"てん"],[34,1,"かみ"]],"text":"ついに夜の幻のうちにこの秘密がダニエルに示されたので、ダニエルは天の神をほめたたえた。"},{"ref":"Dan.2.20","start":27002020,"end":27002020,"break":"paragraph","breaks":[[9,"stanza"],[33,"line"]],"ruby":[[5,1,"い"],[10,1,"かみ"],[13,1,"な"],[15,2,"えいえん"],[19,2,"えいえん"],[22,1,"いた"],[33,2,"ちえ"],[36,2,"けんのう"],[40,1,"かみ"]],"text":"ダニエルは言った、「神のみ名は永遠より永遠に至るまでほむべきかな、知恵と権能とは神のものである。"},{"ref":"Dan.2.21","start":27002021,"end":27002021,"break":"line","breaks":[[11,"line"],[21,"line"],[30,"line"]],"ruby":[[0,1,"かみ"],[2,1,"とき"],[4,2,"きせつ"],[8,1,"へん"],[11,1,"おう"],[13,1,"はい"],[16,1,"おう"],[18,1,"た"],[21,2,"ちしゃ"],[24,2,"ちえ"],[27,1,"あた"],[30,2,"けんじゃ"],[33,2,"ちしき"],[36,1,"さづ"]],"text":"神は時と季節とを変じ、王を廃し、王を立て、知者に知恵を与え、賢者に知識を授けられる。"},{"ref":"Dan.2.22","start":27002022,"end":27002022,"break":"line","breaks":[[15,"line"],[26,"line"]],"ruby":[[0,1,"かみ"],[2,2,"しんみょう"],[5,2,"ひみつ"],[8,1,"こと"],[15,2,"あんこく"],[23,1,"し"],[26,1,"ひかり"],[29,2,"じしん"],[35,1,"やど"]],"text":"神は深妙、秘密の事をあらわし、暗黒にあるものを知り、光をご自身のうちに宿す。"},{"ref":"Dan.2.23","start":27002023,"end":27002023,"break":"line","breaks":[[10,"line"],[27,"line"],[56,"line"],[76,"line"]],"ruby":[[2,2,"せんぞ"],[7,1,"かみ"],[18,2,"ちえ"],[21,1,"ちから"],[24,1,"たま"],[27,1,"いま"],[37,1,"こ"],[39,1,"もと"],[53,1,"しめ"],[56,1,"おう"],[58,1,"もと"],[69,1,"しめ"],[84,2,"かんしゃ"]],"text":"わが先祖たちの神よ、あなたはわたしに知恵と力とを賜い、今われわれがあなたに請い求めたところのものをわたしに示し、王の求めたことをわれわれに示されたので、わたしはあなたに感謝し、あなたをさんびします」。"},{"ref":"Dan.2.24","start":27002024,"end":27002024,"break":"paragraph","ruby":[[9,1,"おう"],[16,2,"ちしゃ"],[21,1,"ほろ"],[27,1,"めい"],[41,1,"い"],[45,1,"かれ"],[49,1,"い"],[59,2,"ちしゃ"],[64,1,"ほろ"],[79,1,"おう"],[81,1,"まえ"],[83,1,"つ"],[86,1,"い"],[100,1,"と"],[102,1,"あ"],[106,1,"おう"],[108,1,"しめ"]],"text":"そこでダニエルは、王がバビロンの知者たちを滅ぼすことを命じておいたアリオクのもとへ行って、彼にこう言った、「バビロンの知者たちを滅ぼしてはなりません。わたしを王の前に連れて行ってください。わたしはその解き明かしを王に示します」。"},{"ref":"Dan.2.25","start":27002025,"end":27002025,"break":"paragraph","ruby":[[5,1,"いそ"],[13,1,"おう"],[15,1,"まえ"],[17,1,"つ"],[20,1,"い"],[23,1,"おう"],[27,1,"い"],[36,1,"とら"],[38,1,"うつ"],[41,1,"もの"],[43,1,"なか"],[48,1,"と"],[50,1,"あ"],[54,1,"おう"],[57,1,"おし"],[73,1,"ひと"],[75,1,"み"]],"text":"アリオクは急いでダニエルを王の前に連れて行き、王にこう言った、「ユダから捕え移した者の中に、その解き明かしを王にお知らせすることのできる、ひとりの人を見つけました」。"},{"ref":"Dan.2.26","start":27002026,"end":27002026,"break":"none","ruby":[[0,1,"おう"],[2,1,"こた"],[16,1,"な"],[23,1,"い"],[36,1,"み"],[38,1,"ゆめ"],[43,1,"と"],[45,1,"あ"],[54,1,"し"]],"text":"王は答えて、ベルテシャザルという名のダニエルに言った、「あなたはわたしが見た夢と、その解き明かしとをわたしに知らせることができるのか」。"},{"ref":"Dan.2.27","start":27002027,"end":27002027,"break":"none","ruby":[[5,1,"おう"],[7,1,"こた"],[10,1,"い"],[15,1,"おう"],[17,1,"もと"],[22,2,"ひみつ"],[26,2,"ちしゃ"],[29,1,"ほう"],[30,1,"じゅつ"],[31,1,"し"],[33,2,"はかせ"],[36,1,"うらな"],[38,1,"し"],[45,1,"おう"],[47,1,"しめ"]],"text":"ダニエルは王に答えて言った、「王が求められる秘密は、知者、法術士、博士、占い師など、これを王に示すことはできません。"},{"ref":"Dan.2.28","start":27002028,"end":27002028,"break":"none","ruby":[[3,2,"ひみつ"],[14,1,"かみ"],[16,1,"てん"],[24,1,"かれ"],[26,1,"のち"],[28,1,"ひ"],[30,1,"おこ"],[34,1,"こと"],[44,1,"おう"],[46,1,"し"],[59,1,"ゆめ"],[66,1,"とこ"],[71,1,"み"],[73,2,"のうちゅう"],[76,1,"まぼろし"]],"text":"しかし秘密をあらわすひとりの神が天におられます。彼は後の日に起るべき事を、ネブカデネザル王に知らされたのです。あなたの夢と、あなたが床にあって見た脳中の幻はこれです。"},{"ref":"Dan.2.29","start":27002029,"end":27002029,"break":"none","ruby":[[0,1,"おう"],[7,1,"とこ"],[18,1,"のち"],[22,1,"こと"],[30,1,"おも"],[39,2,"ひみつ"],[52,2,"しょうらい"],[57,1,"こと"],[59,1,"おこ"],[68,1,"し"]],"text":"王よ、あなたが床におられたとき、この後どんな事があろうかと、思いまわされたが、秘密をあらわされるかたが、将来どんな事が起るかを、あなたに知らされたのです。"},{"ref":"Dan.2.30","start":27002030,"end":27002030,"break":"none","ruby":[[2,2,"ひみつ"],[22,1,"い"],[25,1,"もの"],[36,2,"ちえ"],[52,1,"と"],[54,1,"あ"],[59,1,"おう"],[62,1,"おし"],[78,1,"こころ"],[80,1,"おも"],[89,1,"し"]],"text":"この秘密をわたしにあらわされたのは、すべての生ける者にまさって、わたしに知恵があるためではなく、ただその解き明かしを、王にお知らせすることによって、あなたが心に思われたことを、お知りになるためです。"},{"ref":"Dan.2.31","start":27002031,"end":27002031,"break":"paragraph","ruby":[[0,1,"おう"],[10,1,"おお"],[14,1,"ぞう"],[21,1,"まえ"],[23,1,"た"],[30,1,"み"],[39,1,"ぞう"],[41,1,"おお"],[45,2,"ひじょう"],[48,1,"ひか"],[50,1,"かがや"],[54,1,"おそ"],[58,2,"がいかん"]],"text":"王よ、あなたは一つの大いなる像が、あなたの前に立っているのを見られました。その像は大きく、非常に光り輝いて、恐ろしい外観をもっていました。"},{"ref":"Dan.2.32","start":27002032,"end":27002032,"break":"none","ruby":[[2,1,"ぞう"],[4,1,"あたま"],[6,2,"じゅんきん"],[9,1,"むね"],[11,1,"りょう"],[12,1,"うで"],[15,1,"ぎん"],[17,1,"はら"],[24,2,"せいどう"]],"text":"その像の頭は純金、胸と両腕とは銀、腹と、ももとは青銅、"},{"ref":"Dan.2.33","start":27002033,"end":27002033,"break":"none","ruby":[[3,1,"てつ"],[5,1,"あし"],[7,2,"いちぶ"],[10,1,"てつ"],[12,2,"いちぶ"],[15,2,"ねんど"]],"text":"すねは鉄、足の一部は鉄、一部は粘土です。"},{"ref":"Dan.2.34","start":27002034,"end":27002034,"break":"none","ruby":[[4,1,"み"],[16,1,"いし"],[18,2,"ひとで"],[25,1,"き"],[27,1,"だ"],[34,1,"ぞう"],[36,1,"てつ"],[38,2,"ねんど"],[42,1,"あし"],[44,1,"う"],[50,1,"くだ"]],"text":"あなたが見ておられたとき、一つの石が人手によらずに切り出されて、その像の鉄と粘土との足を撃ち、これを砕きました。"},{"ref":"Dan.2.35","start":27002035,"end":27002035,"break":"none","ruby":[[4,1,"てつ"],[7,2,"ねんど"],[11,2,"せいどう"],[15,1,"ぎん"],[18,1,"きん"],[23,1,"とも"],[25,1,"くだ"],[29,1,"なつ"],[31,1,"う"],[33,1,"ば"],[46,1,"かぜ"],[48,1,"ふ"],[50,1,"はら"],[74,1,"ぞう"],[76,1,"う"],[79,1,"いし"],[82,1,"おお"],[85,1,"やま"],[90,1,"ぜん"],[91,1,"ち"],[93,1,"み"]],"text":"こうして鉄と、粘土と、青銅と、銀と、金とはみな共に砕けて、夏の打ち場のもみがらのようになり、風に吹き払われて、あとかたもなくなりました。ところがその像を撃った石は、大きな山となって全地に満ちました。"},{"ref":"Dan.2.36","start":27002036,"end":27002036,"break":"paragraph","ruby":[[5,1,"ゆめ"],[9,1,"いま"],[18,1,"と"],[20,1,"あ"],[25,1,"おう"],[27,1,"まえ"],[29,1,"もう"]],"text":"これがその夢です。今わたしたちはその解き明かしを、王の前に申しあげましょう。"},{"ref":"Dan.2.37","start":27002037,"end":27002037,"break":"none","ruby":[[0,1,"おう"],[7,2,"しょおう"],[10,1,"おう"],[16,1,"てん"],[18,1,"かみ"],[24,1,"くに"],[26,1,"ちから"],[28,1,"いきお"],[31,1,"さか"],[35,1,"たま"]],"text":"王よ、あなたは諸王の王であって、天の神はあなたに国と力と勢いと栄えとを賜い、"},{"ref":"Dan.2.38","start":27002038,"end":27002038,"break":"none","ruby":[[2,1,"ひと"],[4,1,"こ"],[7,1,"の"],[9,1,"けもの"],[11,1,"そら"],[13,1,"とり"],[25,1,"みな"],[33,1,"て"],[35,1,"あた"],[44,1,"おさ"],[60,1,"きん"],[62,1,"あたま"]],"text":"また人の子ら、野の獣、空の鳥はどこにいるものでも、皆これをあなたの手に与えて、ことごとく治めさせられました。あなたはあの金の頭です。"},{"ref":"Dan.2.39","start":27002039,"end":27002039,"break":"none","ruby":[[4,1,"のち"],[10,1,"おと"],[15,1,"くに"],[17,1,"おこ"],[24,1,"だい"],[27,2,"せいどう"],[30,1,"くに"],[32,1,"おこ"],[36,1,"ぜん"],[37,2,"せかい"],[40,1,"おさ"]],"text":"あなたの後にあなたに劣る一つの国が起ります。また第三に青銅の国が起って、全世界を治めるようになります。"},{"ref":"Dan.2.40","start":27002040,"end":27002040,"break":"none","ruby":[[0,1,"だい"],[3,1,"くに"],[5,1,"てつ"],[10,1,"つよ"],[17,1,"てつ"],[25,1,"もの"],[30,1,"くだ"],[37,1,"てつ"],[48,1,"う"],[50,1,"くだ"],[58,1,"くに"],[63,1,"くだ"]],"text":"第四の国は鉄のように強いでしょう。鉄はよくすべての物をこわし砕くからです。鉄がこれらをことごとく打ち砕くように、その国はこわし砕くでしょう。"},{"ref":"Dan.2.41","start":27002041,"end":27002041,"break":"none","ruby":[[6,1,"あし"],[8,1,"あし"],[10,1,"ゆび"],[12,1,"み"],[22,2,"いちぶ"],[25,2,"とうき"],[27,1,"し"],[29,2,"ねんど"],[32,2,"いちぶ"],[35,1,"てつ"],[46,2,"ぶんれつ"],[50,1,"くに"],[64,1,"てつ"],[66,2,"ねんど"],[70,1,"ま"],[76,1,"み"],[86,1,"くに"],[89,1,"てつ"],[91,1,"つよ"]],"text":"あなたはその足と足の指を見られましたが、その一部は陶器師の粘土、一部は鉄であったので、それは分裂した国をさします。しかしあなたが鉄と粘土との混じったのを見られたように、その国には鉄の強さがあるでしょう。"},{"ref":"Dan.2.42","start":27002042,"end":27002042,"break":"none","ruby":[[2,1,"あし"],[4,1,"ゆび"],[6,2,"いちぶ"],[9,1,"てつ"],[11,2,"いちぶ"],[14,2,"ねんど"],[26,1,"くに"],[28,2,"いちぶ"],[31,1,"つよ"],[34,2,"いちぶ"]],"text":"その足の指の一部は鉄、一部は粘土であったように、その国は一部は強く、一部はもろいでしょう。"},{"ref":"Dan.2.43","start":27002043,"end":27002043,"break":"none","ruby":[[4,1,"てつ"],[6,2,"ねんど"],[10,1,"ま"],[16,1,"み"],[28,2,"こんいん"],[35,1,"たがい"],[37,3,"まざる"],[48,1,"てつ"],[50,2,"ねんど"],[54,2,"あいま"],[70,2,"そうごう"]],"text":"あなたが鉄と粘土との混じったのを見られたように、それらは婚姻によって、互に混ざるでしょう。しかし鉄と粘土とは相混じらないように、かれとこれと相合することはありません。"},{"ref":"Dan.2.44","start":27002044,"end":27002044,"break":"none","ruby":[[4,1,"おう"],[8,1,"よ"],[11,1,"てん"],[13,1,"かみ"],[18,1,"くに"],[20,1,"た"],[35,1,"ほろ"],[46,2,"しゅけん"],[49,1,"た"],[51,1,"たみ"],[72,1,"くに"],[74,1,"う"],[76,1,"やぶ"],[79,1,"ほろ"],[92,1,"くに"],[94,1,"た"],[97,2,"えいえん"],[100,1,"いた"]],"text":"それらの王たちの世に、天の神は一つの国を立てられます。これはいつまでも滅びることがなく、その主権は他の民にわたされず、かえってこれらのもろもろの国を打ち破って滅ぼすでしょう。そしてこの国は立って永遠に至るのです。"},{"ref":"Dan.2.45","start":27002045,"end":27002045,"break":"none","ruby":[[3,1,"いし"],[5,2,"ひとで"],[12,1,"やま"],[15,1,"き"],[17,1,"だ"],[23,1,"いし"],[25,1,"てつ"],[28,2,"せいどう"],[32,2,"ねんど"],[36,1,"ぎん"],[39,1,"きん"],[42,1,"う"],[44,1,"くだ"],[54,1,"み"],[62,1,"こと"],[66,1,"おお"],[70,1,"かみ"],[74,1,"のち"],[76,1,"おこ"],[84,1,"おう"],[86,1,"し"],[97,1,"ゆめ"],[109,1,"と"],[111,1,"あ"],[115,1,"たし"]],"text":"一つの石が人手によらずに山から切り出され、その石が鉄と、青銅と、粘土と、銀と、金とを打ち砕いたのを、あなたが見られたのはこの事です。大いなる神がこの後に起るべきことを、王に知らされたのです。その夢はまことであって、この解き明かしは確かです」。"},{"ref":"Dan.2.46","start":27002046,"end":27002046,"break":"paragraph","ruby":[[10,1,"おう"],[14,1,"ふ"],[23,1,"はい"],[26,1,"そな"],[28,1,"もの"],[30,2,"くんこう"],[35,1,"かれ"],[44,1,"めい"]],"text":"そこでネブカデネザル王はひれ伏して、ダニエルを拝し、供え物と薫香とを、彼にささげることを命じた。"},{"ref":"Dan.2.47","start":27002047,"end":27002047,"break":"none","ruby":[[3,1,"おう"],[10,1,"こた"],[13,1,"い"],[24,2,"ひみつ"],[39,1,"み"],[54,1,"かみ"],[56,2,"かみがみ"],[59,1,"かみ"],[61,1,"おう"],[65,1,"しゅ"],[71,2,"ひみつ"]],"text":"そして王はダニエルに答えて言った、「あなたがこの秘密をあらわすことができたのを見ると、まことに、あなたがたの神は神々の神、王たちの主であって、秘密をあらわされるかただ」。"},{"ref":"Dan.2.48","start":27002048,"end":27002048,"break":"none","ruby":[[4,1,"おう"],[11,1,"たか"],[13,1,"くらい"],[15,1,"さづ"],[18,1,"おお"],[21,1,"おお"],[25,1,"おく"],[27,1,"もの"],[29,1,"あた"],[33,1,"かれ"],[39,1,"ぜん"],[40,1,"しゅう"],[42,2,"そうとく"],[54,2,"ちしゃ"],[59,2,"とうかつ"],[63,1,"もの"],[65,1,"ちょう"]],"text":"こうして王はダニエルに高い位を授け、多くの大いなる贈り物を与えて、彼をバビロン全州の総督とし、またバビロンの知者たちを統轄する者の長とした。"},{"ref":"Dan.2.49","start":27002049,"end":27002049,"break":"none","ruby":[[0,1,"おう"],[9,1,"ねが"],[33,2,"にんめい"],[42,1,"しゅう"],[44,2,"じむ"],[63,1,"おう"],[65,1,"みや"]],"text":"王はまたダニエルの願いによって、シャデラクとメシャクとアベデネゴを任命して、バビロン州の事務をつかさどらせた。ただしダニエルは王の宮にとどまっていた。"}]