[{"ref":"Ps.19.1","start":19019001,"end":19019001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[17,"line"]],"ruby":[[5,1,"てん"],[7,1,"かみ"],[9,2,"えいこう"],[17,2,"おおぞら"],[21,1,"て"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"もろもろの天は神の栄光をあらわし、大空はみ手のわざをしめす。"},{"ref":"Ps.19.2","start":19019002,"end":19019002,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"ひ"],[4,2,"ことば"],[9,1,"ひ"],[17,1,"よ"],[19,2,"ちしき"],[24,1,"よ"]],"text":"この日は言葉をかの日につたえ、この夜は知識をかの夜につげる。"},{"ref":"Ps.19.3","start":19019003,"end":19019003,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"はな"],[7,1,"かた"],[16,1,"こえ"],[18,1,"きこ"]],"text":"話すことなく、語ることなく、その声も聞えないのに、"},{"ref":"Ps.19.4","start":19019004,"end":19019004,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[2,1,"ひび"],[5,1,"ぜん"],[6,1,"ち"],[15,2,"ことば"],[18,2,"せかい"],[26,1,"およ"],[29,1,"かみ"],[31,1,"ひ"],[36,2,"まくや"],[39,1,"てん"],[41,1,"もう"]],"text":"その響きは全地にあまねく、その言葉は世界のはてにまで及ぶ。神は日のために幕屋を天に設けられた。"},{"ref":"Ps.19.5","start":19019005,"end":19019005,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ひ"],[2,2,"はなむこ"],[7,1,"いわい"],[13,1,"で"],[23,2,"ゆうし"],[26,1,"きそ"],[28,1,"はし"],[36,1,"みち"],[38,1,"よろこ"],[40,1,"はし"]],"text":"日は花婿がその祝のへやから出てくるように、また勇士が競い走るように、その道を喜び走る。"},{"ref":"Ps.19.6","start":19019006,"end":19019006,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[3,1,"てん"],[14,1,"てん"],[26,1,"い"],[31,1,"あたた"]],"text":"それは天のはてからのぼって、天のはてにまで、めぐって行く。その暖まりをこうむらないものはない。"},{"ref":"Ps.19.7","start":19019007,"end":19019007,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[6,2,"かんぜん"],[13,1,"たましい"],[15,1,"い"],[22,1,"しゅ"],[28,1,"たし"],[35,2,"むがく"],[38,1,"もの"],[40,1,"かしこ"]],"text":"主のおきては完全であって、魂を生きかえらせ、主のあかしは確かであって、無学な者を賢くする。"},{"ref":"Ps.19.8","start":19019008,"end":19019008,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ただ"],[11,1,"こころ"],[13,1,"よろこ"],[17,1,"しゅ"],[19,1,"いまし"],[29,1,"まなこ"],[31,1,"あき"]],"text":"主のさとしは正しくて、心を喜ばせ、主の戒めはまじりなくて、眼を明らかにする。"},{"ref":"Ps.19.9","start":19019009,"end":19019009,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[5,1,"みち"],[7,1,"きよ"],[17,1,"た"],[26,1,"しゅ"],[32,2,"しんじつ"],[44,1,"ただ"]],"text":"主を恐れる道は清らかで、とこしえに絶えることがなく、主のさばきは真実であって、ことごとく正しい。"},{"ref":"Ps.19.10","start":19019010,"end":19019010,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"きん"],[9,1,"おお"],[12,2,"じゅんきん"],[17,1,"した"],[24,1,"みつ"],[29,1,"はち"],[31,1,"す"],[40,1,"あま"]],"text":"これらは金よりも、多くの純金よりも慕わしく、また蜜よりも、蜂の巣のしたたりよりも甘い。"},{"ref":"Ps.19.11","start":19019011,"end":19019011,"break":"line","breaks":[[23,"line"]],"ruby":[[16,1,"いまし"],[27,1,"まも"],[31,1,"おお"],[35,1,"むく"]],"text":"あなたのしもべは、これらによって戒めをうける。これらを守れば、大いなる報いがある。"},{"ref":"Ps.19.12","start":19019012,"end":19019012,"break":"line","breaks":[[24,"line"]],"ruby":[[3,2,"じぶん"],[11,1,"し"],[32,1,"かく"],[39,1,"と"],[41,1,"はな"]],"text":"だれが自分のあやまちを知ることができましようか。どうか、わたしを隠れたとがから解き放ってください。"},{"ref":"Ps.19.13","start":19019013,"end":19019013,"break":"line","breaks":[[17,"line"],[27,"line"],[50,"line"],[73,"line"]],"ruby":[[11,1,"ひ"],[17,2,"こい"],[20,1,"つみ"],[22,1,"おか"],[30,2,"しはい"],[67,1,"もの"],[73,1,"おお"],[80,1,"まぬか"]],"text":"また、あなたのしもべを引きとめて、故意の罪を犯させず、これに支配されることのないようにしてください。そうすれば、わたしはあやまちのない者となって、大いなるとがを免れることができるでしょう。"},{"ref":"Ps.19.14","start":19019014,"end":19019014,"break":"line","breaks":[[17,"line"],[36,"line"]],"ruby":[[2,1,"いわ"],[14,1,"しゅ"],[25,1,"くち"],[27,2,"ことば"],[31,1,"こころ"],[33,1,"おも"],[40,1,"まえ"],[42,1,"よろこ"]],"text":"わが岩、わがあがないぬしなる主よ、どうか、わたしの口の言葉と、心の思いがあなたの前に喜ばれますように。"}]