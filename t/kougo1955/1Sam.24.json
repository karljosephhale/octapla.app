[{"ref":"1Sam.24.1","start":9024001,"end":9024001,"break":"paragraph","ruby":[[11,1,"お"],[19,1,"かえ"],[27,2,"ひとびと"],[30,1,"かれ"],[32,1,"つ"],[35,1,"い"],[49,1,"の"]],"text":"サウルがペリシテびとを追うことをやめて帰ってきたとき、人々は彼に告げて言った、「ダビデはエンゲデの野にいます」。"},{"ref":"1Sam.24.2","start":9024002,"end":9024002,"break":"none","ruby":[[8,1,"ぜん"],[16,1,"えら"],[22,1,"ひと"],[24,1,"ひき"],[33,2,"じゅうしゃ"],[39,1,"さが"],[48,1,"いわ"],[51,1,"まえ"],[53,1,"で"]],"text":"そこでサウルは、全イスラエルから選んだ三千の人を率い、ダビデとその従者たちとを捜すため、「やぎの岩」の前へ出かけた。"},{"ref":"1Sam.24.3","start":9024003,"end":9024003,"break":"none","ruby":[[0,2,"とちゅう"],[3,1,"ひつじ"],[8,1,"ところ"],[20,1,"あな"],[29,1,"あし"],[40,1,"なか"],[49,1,"とき"],[57,2,"じゅうしゃ"],[65,1,"あな"],[67,1,"おく"]],"text":"途中、羊のおりの所にきたが、そこに、ほら穴があり、サウルは足をおおうために、その中にはいった。その時、ダビデとその従者たちは、ほら穴の奥にいた。"},{"ref":"1Sam.24.4","start":9024004,"end":9024004,"break":"none","ruby":[[4,2,"じゅうしゃ"],[9,1,"かれ"],[11,1,"い"],[16,1,"しゅ"],[22,1,"つ"],[35,1,"てき"],[41,1,"て"],[43,1,"わた"],[50,2,"じぶん"],[53,1,"よ"],[56,1,"おも"],[61,1,"かれ"],[73,1,"い"],[77,1,"ひ"],[93,1,"た"],[106,2,"うわぎ"],[112,1,"き"]],"text":"ダビデの従者たちは彼に言った、「主があなたに告げて、『わたしはあなたの敵をあなたの手に渡す。あなたは自分の良いと思うことを彼にすることができる』と言われた日がきたのです」。そこでダビデは立って、ひそかに、サウルの上着のすそを切った。"},{"ref":"1Sam.24.5","start":9024005,"end":9024005,"break":"none","ruby":[[3,1,"のち"],[17,2,"うわぎ"],[23,1,"き"],[30,1,"こころ"],[32,1,"せ"],[35,1,"かん"]],"text":"しかし後になって、ダビデはサウルの上着のすそを切ったことに、心の責めを感じた。"},{"ref":"1Sam.24.6","start":9024006,"end":9024006,"break":"none","ruby":[[4,2,"じゅうしゃ"],[9,1,"い"],[14,1,"しゅ"],[16,1,"あぶら"],[18,1,"そそ"],[24,1,"きみ"],[33,1,"こと"],[39,1,"しゅ"],[41,1,"きん"],[47,1,"かれ"],[49,1,"しゅ"],[51,1,"あぶら"],[53,1,"そそ"],[57,1,"もの"],[64,1,"かれ"],[66,1,"てき"],[74,1,"て"],[81,1,"よ"]],"text":"ダビデは従者たちに言った、「主が油を注がれたわが君に、わたしがこの事をするのを主は禁じられる。彼は主が油を注がれた者であるから、彼に敵して、わたしの手をのべるのは良くない」。"},{"ref":"1Sam.24.7","start":9024007,"end":9024007,"break":"none","ruby":[[8,2,"ことば"],[14,2,"じゅうしゃ"],[19,1,"さ"],[21,1,"と"],[28,1,"う"],[33,1,"ゆる"],[44,1,"た"],[50,1,"あな"],[52,1,"さ"],[55,1,"みち"],[57,1,"すす"]],"text":"ダビデはこれらの言葉をもって従者たちを差し止め、サウルを撃つことを許さなかった。サウルは立って、ほら穴を去り、道を進んだ。"},{"ref":"1Sam.24.8","start":9024008,"end":9024008,"break":"paragraph","ruby":[[13,1,"た"],[18,1,"あな"],[20,1,"で"],[32,1,"よ"],[41,1,"きみ"],[43,1,"おう"],[47,1,"い"],[61,1,"む"],[64,1,"とき"],[70,1,"ち"],[74,1,"ふ"],[77,1,"はい"]],"text":"ダビデもまた、そのあとから立ち、ほら穴を出て、サウルのうしろから呼ばわって、「わが君、王よ」と言った。サウルがうしろをふり向いた時、ダビデは地にひれ伏して拝した。"},{"ref":"1Sam.24.9","start":9024009,"end":9024009,"break":"none","ruby":[[11,1,"い"],[34,1,"がい"],[47,2,"ひとびと"],[50,2,"ことば"],[53,1,"き"]],"text":"そしてダビデはサウルに言った、「どうして、あなたは『ダビデがあなたを害しようとしている』という人々の言葉を聞かれるのですか。"},{"ref":"1Sam.24.10","start":9024010,"end":9024010,"break":"none","ruby":[[7,1,"ひ"],[9,2,"じぶん"],[12,1,"め"],[15,1,"しゅ"],[27,1,"あな"],[29,1,"なか"],[35,1,"て"],[37,1,"わた"],[53,2,"ひとびと"],[64,1,"ころ"],[69,1,"すす"],[81,1,"ころ"],[93,1,"きみ"],[95,1,"しゅ"],[97,1,"あぶら"],[99,1,"そそ"],[103,1,"かた"],[113,1,"てき"],[116,1,"て"],[133,1,"い"]],"text":"あなたは、この日、自分の目で、主があなたをきょう、ほら穴の中でわたしの手に渡されたのをごらんになりました。人々はわたしにあなたを殺すことを勧めたのですが、わたしは殺しませんでした。『わが君は主が油を注がれた方であるから、これに敵して手をのべることはしない』とわたしは言いました。"},{"ref":"1Sam.24.11","start":9024011,"end":9024011,"break":"none","ruby":[[2,1,"ちち"],[16,2,"うわぎ"],[27,1,"て"],[42,2,"うわぎ"],[48,1,"き"],[59,1,"ころ"],[81,1,"て"],[83,1,"あく"],[94,1,"み"],[96,1,"し"],[113,1,"いのち"],[115,1,"と"],[139,1,"たい"],[142,1,"つみ"]],"text":"わが父よ、ごらんなさい。あなたの上着のすそは、わたしの手にあります。わたしがあなたの上着のすそを切り、しかも、あなたを殺さなかったことによって、あなたは、わたしの手に悪も、とがもないことを見て知られるでしょう。あなたはわたしの命を取ろうと、ねらっておられますが、わたしはあなたに対して罪をおかしたことはないのです。"},{"ref":"1Sam.24.12","start":9024012,"end":9024012,"break":"none","ruby":[[3,1,"しゅ"],[13,1,"あいだ"],[27,1,"しゅ"],[41,1,"むく"],[63,1,"て"]],"text":"どうぞ主がわたしとあなたの間をさばかれますように。また主がわたしのために、あなたに報いられますように。しかし、わたしはあなたに手をくだすことをしないでしょう。"},{"ref":"1Sam.24.13","start":9024013,"end":9024013,"break":"none","ruby":[[0,1,"むかし"],[9,1,"い"],[19,1,"あく"],[21,2,"あくにん"],[25,1,"で"],[41,1,"て"]],"text":"昔から、ことわざに言っているように、『悪は悪人から出る』。しかし、わたしはあなたに手をくだすことをしないでしょう。"},{"ref":"1Sam.24.14","start":9024014,"end":9024014,"break":"none","ruby":[[6,1,"おう"],[12,1,"お"],[15,1,"で"],[34,1,"お"],[46,1,"し"],[49,1,"いぬ"],[51,1,"お"],[63,1,"ぴき"],[65,1,"のみ"],[67,1,"お"]],"text":"イスラエルの王は、だれを追って出てこられたのですか。あなたは、だれを追っておられるのですか。死んだ犬を追っておられるのです。一匹の蚤を追っておられるのです。"},{"ref":"1Sam.24.15","start":9024015,"end":9024015,"break":"none","ruby":[[3,1,"しゅ"],[23,1,"あいだ"],[31,1,"み"],[38,1,"うった"],[41,1,"き"],[52,1,"て"],[55,1,"すく"],[57,1,"だ"]],"text":"どうぞ主がさばきびととなって、わたしとあなたの間をさばき、かつ見て、わたしの訴えを聞き、わたしをあなたの手から救い出してくださるように」。"},{"ref":"1Sam.24.16","start":9024016,"end":9024016,"break":"paragraph","ruby":[[8,2,"ことば"],[15,1,"かた"],[17,1,"おわ"],[27,1,"い"],[34,1,"こ"],[48,1,"こえ"],[62,1,"こえ"],[67,1,"な"]],"text":"ダビデがこれらの言葉をサウルに語り終ったとき、サウルは言った、「わが子ダビデよ、これは、あなたの声であるか」。そしてサウルは声をあげて泣いた。"},{"ref":"1Sam.24.17","start":9024017,"end":9024017,"break":"none","ruby":[[10,1,"い"],[25,1,"ただ"],[37,1,"あく"],[39,1,"むく"],[53,1,"ぜん"],[55,1,"むく"]],"text":"サウルはまたダビデに言った、「あなたはわたしよりも正しい。わたしがあなたに悪を報いたのに、あなたはわたしに善を報いる。"},{"ref":"1Sam.24.18","start":9024018,"end":9024018,"break":"none","ruby":[[11,1,"よ"],[24,1,"あき"],[37,1,"しゅ"],[47,1,"て"],[65,1,"ころ"]],"text":"きょう、あなたはいかに良くわたしをあつかったかを明らかにしました。すなわち主がわたしをあなたの手にわたされたのに、あなたはわたしを殺さなかったのです。"},{"ref":"1Sam.24.19","start":9024019,"end":9024019,"break":"none","ruby":[[0,1,"ひと"],[2,1,"てき"],[4,1,"あ"],[10,1,"てき"],[12,2,"ぶじ"],[15,1,"さ"],[40,1,"こと"],[49,1,"しゅ"],[55,1,"よ"],[57,1,"むく"],[60,1,"あた"]],"text":"人は敵に会ったとき、敵を無事に去らせるでしょうか。あなたが、きょう、わたしにした事のゆえに、どうぞ主があなたに良い報いを与えられるように。"},{"ref":"1Sam.24.20","start":9024020,"end":9024020,"break":"none","ruby":[[0,1,"いま"],[14,1,"おう"],[21,1,"し"],[35,2,"おうこく"],[43,1,"て"],[48,1,"かた"],[50,1,"た"],[55,1,"し"]],"text":"今わたしは、あなたがかならず王となることを知りました。またイスラエルの王国が、あなたの手によって堅く立つことを知りました。"},{"ref":"1Sam.24.21","start":9024021,"end":9024021,"break":"none","ruby":[[21,2,"しそん"],[24,1,"た"],[34,1,"ちち"],[36,1,"いえ"],[44,1,"な"],[46,1,"ほろ"],[49,1,"さ"],[57,1,"しゅ"],[67,1,"ちか"]],"text":"それゆえ、あなたはわたしのあとに、わたしの子孫を断たず、またわたしの父の家から、わたしの名を滅ぼし去らないと、いま主をさして、わたしに誓ってください」。"},{"ref":"1Sam.24.22","start":9024022,"end":9024022,"break":"none","ruby":[[17,1,"ちか"],[28,1,"いえ"],[30,1,"かえ"],[39,2,"じゅうしゃ"],[44,2,"ようがい"],[51,1,"い"]],"text":"そこでダビデはサウルに、そのように誓った。そしてサウルは家に帰り、ダビデとその従者たちは要害にのぼって行った。"}]