[{"ref":"Judg.21.1","start":7021001,"end":7021001,"break":"paragraph","ruby":[[9,2,"ひとびと"],[31,1,"むすめ"],[41,1,"つま"],[45,1,"あた"],[48,1,"もの"],[60,1,"い"],[63,1,"ちか"]],"text":"かつてイスラエルの人々はミヅパで、「われわれのうちひとりもその娘をベニヤミンびとの妻として与える者があってはならない」と言って誓ったので、"},{"ref":"Judg.21.2","start":7021002,"end":7021002,"break":"none","ruby":[[0,1,"たみ"],[6,1,"い"],[13,2,"ゆうぐれ"],[17,1,"かみ"],[19,1,"まえ"],[21,1,"ざ"],[24,1,"こえ"],[29,1,"はげ"],[32,1,"な"]],"text":"民はベテルに行って、そこで夕暮まで神の前に座し、声をあげて激しく泣いて、"},{"ref":"Judg.21.3","start":7021003,"end":7021003,"break":"none","ruby":[[0,1,"い"],[11,1,"かみ"],[13,1,"しゅ"],[31,1,"こと"],[33,1,"た"],[37,2,"こんにち"],[48,2,"ぶぞく"],[51,1,"か"]],"text":"言った、「イスラエルの神、主よ、どうしてイスラエルにこのような事が起って、今日イスラエルに一つの部族が欠けるようになったのですか」。"},{"ref":"Judg.21.4","start":7021004,"end":7021004,"break":"none","ruby":[[0,2,"よくじつ"],[3,1,"たみ"],[5,1,"はや"],[7,1,"お"],[14,2,"さいだん"],[17,1,"きず"],[20,2,"はんさい"],[23,3,"しゅうおんさい"]],"text":"翌日、民は早く起きて、そこに祭壇を築き、燔祭と酬恩祭をささげた。"},{"ref":"Judg.21.5","start":7021005,"end":7021005,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"い"],[27,2,"ぶぞく"],[33,2,"しゅうかい"],[36,1,"のぼ"],[40,1,"しゅ"],[45,1,"い"],[51,1,"もの"],[61,1,"かれ"],[73,1,"しゅ"],[78,1,"い"],[82,1,"もの"],[90,1,"おお"],[94,1,"ちか"],[97,1,"た"],[104,1,"ひと"],[106,1,"かなら"],[108,1,"ころ"],[121,1,"い"]],"text":"そしてイスラエルの人々は言った、「イスラエルのすべての部族のうちで集会に上って、主のもとに行かなかった者はだれか」。これは彼らがミヅパにのぼって、主のもとに行かない者のことについて大いなる誓いを立てて、「その人は必ず殺されなければならない」と言ったからである。"},{"ref":"Judg.21.6","start":7021006,"end":7021006,"break":"none","ruby":[[9,2,"ひとびと"],[12,2,"きょうだい"],[25,1,"い"],[30,2,"こんにち"],[41,2,"ぶぞく"],[44,1,"た"]],"text":"しかしイスラエルの人々は兄弟ベニヤミンをあわれんで言った、「今日イスラエルに一つの部族が絶えた。"},{"ref":"Judg.21.7","start":7021007,"end":7021007,"break":"none","ruby":[[5,1,"しゅ"],[16,1,"むすめ"],[18,1,"かれ"],[21,1,"つま"],[25,1,"あた"],[30,1,"ちか"],[38,1,"のこ"],[41,1,"もの"],[45,1,"つま"]],"text":"われわれは主をさして、われわれの娘を彼らに妻として与えないと誓ったので、かの残った者どもに妻をめとらせるにはどうしたらよいであろうか」。"},{"ref":"Judg.21.8","start":7021008,"end":7021008,"break":"paragraph","ruby":[[0,1,"かれ"],[5,1,"い"],[16,2,"ぶぞく"],[31,1,"しゅ"],[36,1,"い"],[46,2,"ぶぞく"],[70,2,"じんえい"],[75,2,"しゅうかい"],[78,1,"のぞ"],[81,1,"もの"]],"text":"彼らはまた言った、「イスラエルの部族のうちで、ミヅパにのぼって主のもとに行かなかったのはどの部族か」。ところがヤベシ・ギレアデからはひとりも陣営にきて集会に臨んだ者がなかった。"},{"ref":"Judg.21.9","start":7021009,"end":7021009,"break":"none","ruby":[[4,1,"たみ"],[6,1,"あつ"],[9,1,"み"],[22,2,"じゅうみん"]],"text":"すなわち民を集めて見ると、ヤベシ・ギレアデの住民はひとりもそこにいなかった。"},{"ref":"Judg.21.10","start":7021010,"end":7021010,"break":"none","ruby":[[3,2,"かいしゅう"],[6,2,"ゆうし"],[12,1,"にん"],[26,1,"めい"],[29,1,"い"],[43,1,"い"],[49,2,"じゅうみん"],[53,1,"おんな"],[55,2,"こども"],[68,1,"う"]],"text":"そこで会衆は勇士一万二千人をかしこにつかわし、これに命じて言った、「ヤベシ・ギレアデに行って、その住民を、女、子供もろともつるぎをもって撃て。"},{"ref":"Judg.21.11","start":7021011,"end":7021011,"break":"none","ruby":[[22,1,"おとこ"],[26,1,"おとこ"],[28,1,"ね"],[30,1,"おんな"],[37,1,"ほろ"]],"text":"そしてこのようにしなければならない。すなわち男および男と寝た女はことごとく滅ぼさなければならない」。"},{"ref":"Judg.21.12","start":7021012,"end":7021012,"break":"none","ruby":[[4,1,"かれ"],[16,2,"じゅうみん"],[24,1,"にん"],[26,1,"わか"],[28,2,"しょじょ"],[31,1,"え"],[39,1,"おとこ"],[41,1,"ね"],[49,1,"おとこ"],[51,1,"し"],[55,1,"もの"],[60,1,"かれ"],[70,1,"ち"],[77,2,"じんえい"],[80,1,"つ"]],"text":"こうして彼らはヤベシ・ギレアデの住民のうちで四百人の若い処女を獲た。これはまだ男と寝たことがなく、男を知らない者である。彼らはこれをカナンの地にあるシロの陣営に連れてきた。"},{"ref":"Judg.21.13","start":7021013,"end":7021013,"break":"paragraph","ruby":[[3,1,"ぜん"],[4,2,"かいしゅう"],[7,1,"ひと"],[20,1,"いわ"],[30,2,"ひとびと"],[33,2,"へいわ"],[36,1,"つ"]],"text":"そこで全会衆は人をつかわして、リンモンの岩におるベニヤミンの人々に平和を告げた。"},{"ref":"Judg.21.14","start":7021014,"end":7021014,"break":"none","ruby":[[6,2,"ひとびと"],[11,1,"とき"],[13,1,"かえ"],[21,1,"かれ"],[33,1,"おんな"],[39,1,"い"],[46,1,"おんな"],[51,1,"あた"],[58,1,"た"]],"text":"ベニヤミンの人々がその時、帰ってきたので、彼らはヤベシ・ギレアデの女のうちから生かしておいた女をこれに与えたが、なお足りなかった。"},{"ref":"Judg.21.15","start":7021015,"end":7021015,"break":"none","ruby":[[4,1,"たみ"],[7,1,"しゅ"],[15,2,"ぶぞく"],[21,2,"けっかん"]],"text":"こうして民は、主がイスラエルの部族のうちに欠陥をつくられたことのために、ベニヤミンをあわれんだ。"},{"ref":"Judg.21.16","start":7021016,"end":7021016,"break":"paragraph","ruby":[[0,2,"かいしゅう"],[3,2,"ちょうろう"],[8,1,"い"],[19,1,"おんな"],[21,1,"た"],[29,1,"のこ"],[32,1,"もの"],[36,1,"つま"]],"text":"会衆の長老たちは言った、「ベニヤミンの女が絶えたので、かの残りの者どもに妻をめとらせるにはどうしたらよいでしょうか」。"},{"ref":"Judg.21.17","start":7021017,"end":7021017,"break":"none","ruby":[[0,1,"かれ"],[5,1,"い"],[20,2,"ぶぞく"],[23,1,"き"],[41,1,"のこ"],[44,1,"もの"]],"text":"彼らはまた言った、「イスラエルから一つの部族が消えうせないためにベニヤミンのうちの残りの者どもに、あとつぎがなければならない。"},{"ref":"Judg.21.18","start":7021018,"end":7021018,"break":"none","ruby":[[9,1,"むすめ"],[11,1,"かれ"],[14,1,"つま"],[16,1,"あた"],[33,2,"ひとびと"],[43,1,"つま"],[45,1,"あた"],[48,1,"もの"],[57,1,"い"],[60,1,"ちか"]],"text":"しかし、われわれの娘を彼らの妻に与えることはできない。イスラエルの人々が『ベニヤミンに妻を与える者はのろわれる』と言って誓ったからである」。"},{"ref":"Judg.21.19","start":7021019,"end":7021019,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[11,2,"ねんねん"],[16,1,"しゅ"],[18,1,"まつり"],[31,1,"きた"],[49,2,"おおじ"],[52,1,"ひがし"],[58,1,"みなみ"]],"text":"それで彼らは言った、「年々シロに主の祭がある」。シロはベテルの北にあって、ベテルからシケムにのぼる大路の東、レバナの南にある。"},{"ref":"Judg.21.20","start":7021020,"end":7021020,"break":"none","ruby":[[3,1,"かれ"],[12,2,"ひとびと"],[15,1,"めい"],[18,1,"い"],[29,1,"い"],[36,1,"はたけ"],[38,1,"ま"],[40,1,"ぶ"]],"text":"そして彼らはベニヤミンの人々に命じて言った、「あなたがたは行って、ぶどう畑に待ち伏せして、"},{"ref":"Judg.21.21","start":7021021,"end":7021021,"break":"none","ruby":[[13,1,"むすめ"],[17,1,"おど"],[20,1,"おど"],[23,1,"で"],[34,1,"はたけ"],[37,1,"で"],[43,1,"むすめ"],[56,2,"じぶん"],[59,1,"つま"],[71,1,"ち"],[73,1,"つ"],[76,1,"い"]],"text":"うかがいなさい。もしシロの娘たちが踊りを踊りに出てきたならば、ぶどう畑から出て、シロの娘たちのうちから、めいめい自分の妻をとって、ベニヤミンの地に連れて行きなさい。"},{"ref":"Judg.21.22","start":7021022,"end":7021022,"break":"none","ruby":[[4,1,"ちち"],[9,2,"きょうだい"],[20,1,"うった"],[32,1,"かれ"],[45,1,"かれ"],[57,2,"せんそう"],[69,1,"かれ"],[76,1,"つま"],[97,1,"かれ"],[100,1,"あた"],[113,1,"あた"],[126,1,"つみ"],[128,1,"おか"],[143,1,"い"]],"text":"もしその父あるいは兄弟がきて、われわれに訴えるならば、われわれは彼らに、『われわれのために彼らをゆるしてください。戦争のときにわれわれは、彼らおのおのに妻をとってやらなかったし、またあなたがたも彼らに与えなかったからです。もし与えたならば、あなたがたは罪を犯したことになるからでした』と言いましょう」。"},{"ref":"Judg.21.23","start":7021023,"end":7021023,"break":"none","ruby":[[6,2,"ひとびと"],[14,1,"おこな"],[17,1,"おど"],[22,1,"もの"],[30,2,"じぶん"],[35,1,"かず"],[42,1,"つま"],[44,1,"と"],[50,1,"つ"],[53,2,"りょうち"],[56,1,"かえ"],[59,2,"まちまち"],[62,1,"た"],[72,1,"す"]],"text":"ベニヤミンの人々はそのように行い、踊っている者どものうちから自分たちの数にしたがって妻を取り、それを連れて領地に帰り、町々を建てなおして、そこに住んだ。"},{"ref":"Judg.21.24","start":7021024,"end":7021024,"break":"none","ruby":[[10,2,"ひとびと"],[16,1,"とき"],[20,1,"さ"],[30,2,"ぶぞく"],[35,2,"しぞく"],[38,1,"かえ"],[49,1,"た"],[59,1,"し"],[60,1,"ぎょう"],[62,1,"ち"],[64,1,"かえ"]],"text":"こうしてイスラエルの人々は、その時そこを去って、おのおのその部族および氏族に帰った。すなわちそこを立って、おのおのその嗣業の地に帰った。"},{"ref":"Judg.21.25","start":7021025,"end":7021025,"break":"paragraph","ruby":[[12,1,"おう"],[25,2,"じぶん"],[28,1,"め"],[30,1,"ただ"],[34,1,"み"]],"text":"そのころ、イスラエルには王がなかったので、おのおの自分の目に正しいと見るところをおこなった。"}]