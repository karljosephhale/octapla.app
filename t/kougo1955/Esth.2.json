[{"ref":"Esth.2.1","start":17002001,"end":17002001,"break":"paragraph","ruby":[[7,1,"のち"],[16,1,"おう"],[18,1,"いか"],[24,1,"おう"],[32,2,"かのじょ"],[42,2,"かのじょ"],[45,1,"たい"],[48,1,"さだ"],[54,1,"おも"],[56,1,"おこ"]],"text":"これらのことの後、アハシュエロス王の怒りがとけ、王はワシテおよび彼女のしたこと、また彼女に対して定めたことを思い起した。"},{"ref":"Esth.2.2","start":17002002,"end":17002002,"break":"none","ruby":[[0,1,"とき"],[2,1,"おう"],[4,1,"つか"],[7,2,"じしん"],[12,1,"い"],[17,1,"うつく"],[20,1,"わか"],[22,2,"しょじょ"],[27,1,"おう"],[32,1,"たず"],[34,1,"もと"]],"text":"時に王に仕える侍臣たちは言った、「美しい若い処女たちを王のために尋ね求めましょう。"},{"ref":"Esth.2.3","start":17002003,"end":17002003,"break":"none","ruby":[[3,1,"おう"],[7,1,"くに"],[9,2,"かくしゅう"],[15,2,"やくにん"],[18,1,"えら"],[21,1,"うつく"],[24,1,"わか"],[26,2,"しょじょ"],[34,2,"しゅと"],[41,2,"ふじん"],[44,2,"きょしつ"],[47,1,"あつ"],[52,2,"ふじん"],[60,1,"おう"],[62,2,"じじゅう"],[68,2,"かんり"],[78,2,"けしょう"],[84,2,"しなじな"],[87,1,"かれ"],[90,1,"あた"]],"text":"どうぞ王はこの国の各州において役人を選び、美しい若い処女をことごとく首都スサにある婦人の居室に集めさせ、婦人をつかさどる王の侍従ヘガイの管理のもとにおいて、化粧のための品々を彼らに与えてください。"},{"ref":"Esth.2.4","start":17002004,"end":17002004,"break":"none","ruby":[[4,2,"ぎょい"],[22,1,"かわ"],[25,2,"おうひ"],[36,1,"おう"],[40,1,"こと"],[52,1,"い"]],"text":"こうして御意にかなうおとめをとって、ワシテの代りに王妃としてください」。王はこの事をよしとし、そのように行った。"},{"ref":"Esth.2.5","start":17002005,"end":17002005,"break":"paragraph","ruby":[[2,2,"しゅと"],[14,1,"じん"],[19,1,"な"],[40,1,"まご"],[46,1,"こ"]],"text":"さて首都スサにひとりのユダヤ人がいた。名をモルデカイといい、キシのひこ、シメイの孫、ヤイルの子で、ベニヤミンびとであった。"},{"ref":"Esth.2.6","start":17002006,"end":17002006,"break":"none","ruby":[[0,1,"かれ"],[7,1,"おう"],[16,1,"とら"],[25,1,"おう"],[31,1,"とも"],[33,1,"とら"],[41,2,"ほりょ"],[56,1,"とら"],[58,1,"うつ"],[62,1,"もの"]],"text":"彼はバビロンの王ネブカデネザルが捕えていったユダの王エコニヤと共に捕えられていった捕虜のひとりで、エルサレムから捕え移された者である。"},{"ref":"Esth.2.7","start":17002007,"end":17002007,"break":"none","ruby":[[0,1,"かれ"],[7,1,"むすめ"],[21,1,"やしな"],[23,1,"そだ"],[27,2,"かのじょ"],[31,1,"ちち"],[33,1,"はは"],[51,1,"うつく"],[67,2,"ふぼ"],[70,2,"しご"],[79,2,"かのじょ"],[82,1,"ひ"],[87,2,"じぶん"],[90,1,"むすめ"]],"text":"彼はそのおじの娘ハダッサすなわちエステルを養い育てた。彼女には父も母もなかったからである。このおとめは美しく、かわいらしかったが、その父母の死後、モルデカイは彼女を引きとって自分の娘としたのである。"},{"ref":"Esth.2.8","start":17002008,"end":17002008,"break":"none","ruby":[[0,1,"おう"],[2,2,"めいれい"],[5,1,"みことのり"],[7,1,"つた"],[12,1,"おお"],[19,2,"しゅと"],[24,1,"あつ"],[34,2,"かんり"],[54,2,"おうきゅう"],[57,1,"たずさ"],[59,1,"ゆ"],[63,2,"ふじん"],[75,2,"かんり"]],"text":"王の命令と詔が伝えられ、多くのおとめが首都スサに集められて、ヘガイの管理のもとにおかれたとき、エステルもまた王宮に携え行かれ、婦人をつかさどるヘガイの管理のもとにおかれた。"},{"ref":"Esth.2.9","start":17002009,"end":17002009,"break":"none","ruby":[[10,1,"こころ"],[25,1,"え"],[41,2,"かのじょ"],[44,2,"けしょう"],[47,2,"しなじな"],[52,2,"しょくもつ"],[55,1,"わ"],[57,1,"まえ"],[59,1,"あた"],[64,2,"きゅうちゅう"],[69,1,"にん"],[75,2,"じじょ"],[78,1,"えら"],[81,2,"かのじょ"],[84,1,"つ"],[86,1,"そ"],[90,2,"かのじょ"],[95,2,"じじょ"],[100,2,"ふじん"],[103,2,"きょしつ"],[109,1,"もっと"],[111,1,"よ"],[113,1,"ところ"],[115,1,"うつ"]],"text":"このおとめはヘガイの心にかなって、そのいつくしみを得た。すなわちヘガイはすみやかに彼女に化粧の品々および食物の分け前を与え、また宮中から七人のすぐれた侍女を選んで彼女に付き添わせ、彼女とその侍女たちを婦人の居室のうちの最も良い所に移した。"},{"ref":"Esth.2.10","start":17002010,"end":17002010,"break":"none","ruby":[[5,2,"じぶん"],[8,1,"たみ"],[15,2,"じぶん"],[18,2,"どうぞく"],[25,1,"ひと"],[27,1,"し"],[44,1,"し"],[49,2,"かのじょ"],[52,1,"めい"]],"text":"エステルは自分の民のことをも、自分の同族のことをも人に知らせなかった。モルデカイがこれを知らすなと彼女に命じたからである。"},{"ref":"Esth.2.11","start":17002011,"end":17002011,"break":"none","ruby":[[11,2,"ようす"],[16,2,"かのじょ"],[27,1,"し"],[32,2,"まいにち"],[34,2,"ふじん"],[37,2,"きょしつ"],[40,1,"にわ"],[42,1,"まえ"],[44,1,"ある"]],"text":"モルデカイはエステルの様子および彼女がどうしているかを知ろうと、毎日婦人の居室の庭の前を歩いた。"},{"ref":"Esth.2.12","start":17002012,"end":17002012,"break":"paragraph","ruby":[[10,2,"ふじん"],[16,2,"きてい"],[27,1,"げつ"],[29,1,"へ"],[31,1,"のち"],[33,2,"じゅんばん"],[43,1,"おう"],[45,1,"ところ"],[47,1,"い"],[58,1,"かれ"],[61,2,"けしょう"],[64,2,"きかん"],[70,2,"もつやく"],[73,1,"あぶら"],[75,1,"もち"],[82,1,"げつ"],[84,2,"こうりょう"],[89,2,"ふじん"],[92,2,"けしょう"],[95,1,"つか"],[97,2,"しなじな"],[100,1,"もち"],[107,1,"げつ"],[109,1,"さだ"]],"text":"おとめたちはおのおの婦人のための規定にしたがって十二か月を経て後、順番にアハシュエロス王の所へ行くのであった。これは彼らの化粧の期間として、没薬の油を用いること六か月、香料および婦人の化粧に使う品々を用いること六か月が定められていたからである。"},{"ref":"Esth.2.13","start":17002013,"end":17002013,"break":"none","ruby":[[8,1,"おう"],[10,1,"ところ"],[12,1,"い"],[27,2,"ふじん"],[30,2,"きょしつ"],[33,1,"で"],[35,2,"おうきゅう"],[38,1,"い"],[40,1,"とき"],[49,1,"のぞ"],[51,1,"もの"],[53,1,"あた"]],"text":"こうしておとめは王の所へ行くのであった。そしておとめが婦人の居室を出て王宮へ行く時には、すべてその望む物が与えられた。"},{"ref":"Esth.2.14","start":17002014,"end":17002014,"break":"none","ruby":[[3,2,"ゆうがた"],[5,1,"い"],[12,1,"あさ"],[13,1,"だい"],[16,2,"ふじん"],[19,2,"きょしつ"],[22,1,"かえ"],[36,1,"おう"],[38,2,"じじゅう"],[46,2,"かんり"],[49,1,"うつ"],[54,1,"おう"],[58,1,"おんな"],[60,1,"よろこ"],[63,1,"な"],[67,1,"め"],[76,1,"ふたた"],[78,1,"おう"],[80,1,"ところ"],[82,1,"い"]],"text":"そして夕方行って、あくる朝第二の婦人の居室に帰り、そばめたちをつかさどる王の侍従シャシガズの管理に移された。王がその女を喜び、名ざして召すのでなければ、再び王の所へ行くことはなかった。"},{"ref":"Esth.2.15","start":17002015,"end":17002015,"break":"paragraph","ruby":[[16,1,"むすめ"],[28,1,"ひ"],[33,2,"じぶん"],[36,1,"むすめ"],[45,1,"おう"],[47,1,"ところ"],[49,1,"ゆ"],[51,2,"じゅんばん"],[59,2,"かのじょ"],[62,2,"ふじん"],[70,1,"おう"],[72,2,"じじゅう"],[78,1,"すす"],[81,1,"もの"],[85,1,"なに"],[88,1,"もと"],[103,2,"かのじょ"],[106,1,"み"],[108,1,"もの"],[110,1,"よろこ"]],"text":"さてモルデカイのおじアビハイルの娘、すなわちモルデカイが引きとって自分の娘としたエステルが王の所へ行く順番となったが、彼女は婦人をつかさどる王の侍従ヘガイが勧めた物のほか何をも求めなかった。エステルはすべて彼女を見る者に喜ばれた。"},{"ref":"Esth.2.16","start":17002016,"end":17002016,"break":"none","ruby":[[12,1,"おう"],[14,1,"め"],[18,2,"おうきゅう"],[21,1,"い"],[29,2,"ちせい"],[32,1,"だい"],[34,1,"ねん"],[37,1,"がつ"],[47,1,"つき"]],"text":"エステルがアハシュエロス王に召されて王宮へ行ったのは、その治世の第七年の十月、すなわちテベテの月であった。"},{"ref":"Esth.2.17","start":17002017,"end":17002017,"break":"none","ruby":[[0,1,"おう"],[6,2,"ふじん"],[18,1,"あい"],[24,2,"かのじょ"],[31,2,"しょじょ"],[38,1,"おう"],[40,1,"まえ"],[42,1,"めぐ"],[52,1,"え"],[55,1,"おう"],[60,2,"おうひ"],[63,1,"かんむり"],[65,2,"かのじょ"],[68,1,"あたま"],[80,1,"かわ"],[83,2,"おうひ"]],"text":"王はすべての婦人にまさってエステルを愛したので、彼女はすべての処女にまさって王の前に恵みといつくしみとを得た。王はついに王妃の冠を彼女の頭にいただかせ、ワシテに代って王妃とした。"},{"ref":"Esth.2.18","start":17002018,"end":17002018,"break":"none","ruby":[[3,1,"おう"],[5,1,"おお"],[9,2,"しゅえん"],[12,1,"もよお"],[20,2,"だいじん"],[23,2,"じしん"],[37,2,"しゅえん"],[48,1,"しょ"],[49,1,"しゅう"],[51,2,"めんぜい"],[54,1,"おこな"],[57,1,"おう"],[59,1,"おお"],[62,2,"どりょう"],[70,1,"おく"],[72,1,"もの"],[74,1,"あた"]],"text":"そして王は大いなる酒宴を催して、すべての大臣と侍臣をもてなした。エステルの酒宴がこれである。また諸州に免税を行い、王の大きな度量にしたがって贈り物を与えた。"},{"ref":"Esth.2.19","start":17002019,"end":17002019,"break":"paragraph","ruby":[[1,2,"どめ"],[4,2,"しょじょ"],[9,1,"あつ"],[23,1,"おう"],[25,1,"もん"]],"text":"二度目に処女たちが集められたとき、モルデカイは王の門にすわっていた。"},{"ref":"Esth.2.20","start":17002020,"end":17002020,"break":"none","ruby":[[11,1,"めい"],[20,2,"じぶん"],[23,2,"どうぞく"],[30,2,"じぶん"],[33,1,"たみ"],[39,1,"ひと"],[41,1,"し"],[60,2,"ことば"],[63,1,"したが"],[68,1,"かれ"],[70,1,"やしな"],[72,1,"そだ"],[77,1,"とき"],[79,1,"すこ"],[82,1,"かわ"]],"text":"エステルはモルデカイが命じたように、まだ自分の同族のことをも自分の民のことをも人に知らせなかった。エステルはモルデカイの言葉に従うこと、彼に養い育てられた時と少しも変らなかった。"},{"ref":"Esth.2.21","start":17002021,"end":17002021,"break":"none","ruby":[[11,1,"おう"],[13,1,"もん"],[21,1,"とき"],[23,1,"おう"],[25,2,"じじゅう"],[29,1,"おう"],[34,1,"と"],[36,1,"まも"],[38,1,"もの"],[56,1,"いか"],[69,1,"おう"],[71,1,"ころ"]],"text":"そのころ、モルデカイが王の門にすわっていた時、王の侍従で、王のへやの戸を守る者のうちのビグタンとテレシのふたりが怒りのあまりアハシュエロス王を殺そうとねらっていたが、"},{"ref":"Esth.2.22","start":17002022,"end":17002022,"break":"none","ruby":[[2,1,"こと"],[10,1,"し"],[16,1,"かれ"],[21,2,"おうひ"],[28,1,"つ"],[45,1,"な"],[50,1,"おう"],[52,1,"つ"]],"text":"その事がモルデカイに知れたので、彼はこれを王妃エステルに告げ、エステルはこれをモルデカイの名をもって王に告げた。"},{"ref":"Esth.2.23","start":17002023,"end":17002023,"break":"none","ruby":[[2,1,"こと"],[4,1,"しら"],[13,2,"そうい"],[28,1,"かれ"],[34,1,"き"],[44,1,"こと"],[46,1,"おう"],[48,1,"まえ"],[50,2,"にっし"],[53,1,"しょ"]],"text":"その事が調べられて、それに相違ないことがあらわれたので、彼らふたりは木にかけられた。この事は王の前で日誌の書にかきしるされた。"}]