[{"ref":"Ezek.39.1","start":26039001,"end":26039001,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[8,1,"む"],[12,2,"よげん"],[16,1,"い"],[19,1,"しゅ"],[22,1,"かみ"],[26,1,"い"],[39,2,"おおぎみ"],[48,1,"み"],[59,1,"てき"]],"text":"人の子よ、ゴグに向かって預言して言え。主なる神はこう言われる、メセクとトバルの大君であるゴグよ、見よ、わたしはあなたの敵となる。"},{"ref":"Ezek.39.2","start":26039002,"end":26039002,"break":"none","ruby":[[8,1,"ひ"],[18,1,"お"],[23,1,"きた"],[25,1,"はて"],[28,1,"のぼ"],[38,2,"やまやま"],[41,1,"みちび"]],"text":"わたしはあなたを引きもどし、あなたを押しやり、北の果から上らせ、イスラエルの山々に導き、"},{"ref":"Ezek.39.3","start":26039003,"end":26039003,"break":"none","ruby":[[4,1,"ひだり"],[6,1,"て"],[9,1,"ゆみ"],[11,1,"う"],[13,1,"おと"],[16,1,"みぎ"],[18,1,"て"],[21,1,"や"],[23,1,"おと"]],"text":"あなたの左の手から弓を打ち落し、右の手から矢を落させる。"},{"ref":"Ezek.39.4","start":26039004,"end":26039004,"break":"none","ruby":[[12,2,"ぐんたい"],[21,1,"とも"],[25,1,"たみ"],[36,2,"やまやま"],[39,1,"たお"],[52,2,"しょしゅ"],[55,2,"もうきん"],[58,2,"やじゅう"],[62,1,"あた"],[65,1,"く"]],"text":"あなたとあなたのすべての軍隊およびあなたと共にいる民たちは、イスラエルの山々に倒れる。わたしはあなたを、諸種の猛禽と野獣とに与えて食わせる。"},{"ref":"Ezek.39.5","start":26039005,"end":26039005,"break":"none","ruby":[[4,1,"の"],[6,1,"おもて"],[8,1,"たお"],[19,1,"い"],[29,1,"しゅ"],[32,1,"かみ"],[34,1,"い"]],"text":"あなたは野の面に倒れる。わたしがこれを言ったからであると、主なる神は言われる。"},{"ref":"Ezek.39.6","start":26039006,"end":26039006,"break":"none","ruby":[[8,2,"うみぞ"],[12,2,"くにぐに"],[15,1,"やす"],[19,1,"す"],[21,1,"もの"],[23,1,"たい"],[26,1,"ひ"],[28,1,"おく"],[31,1,"かれ"],[38,1,"しゅ"],[45,1,"さと"]],"text":"わたしはゴグと、海沿いの国々に安らかに住む者に対して火を送り、彼らにわたしが主であることを悟らせる。"},{"ref":"Ezek.39.7","start":26039007,"end":26039007,"break":"paragraph","ruby":[[6,1,"せい"],[9,1,"な"],[14,1,"たみ"],[24,1,"し"],[28,1,"かさ"],[33,1,"せい"],[36,1,"な"],[38,1,"けが"],[44,1,"しょ"],[45,2,"こくみん"],[52,1,"しゅ"],[60,2,"せいじゃ"],[68,1,"さと"]],"text":"わたしはわが聖なる名を、わが民イスラエルのうちに知らせ、重ねてわが聖なる名を汚させない。諸国民はわたしが主、イスラエルの聖者であることを悟る。"},{"ref":"Ezek.39.8","start":26039008,"end":26039008,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[10,1,"み"],[16,1,"く"],[19,1,"かなら"],[21,2,"じょうじゅ"],[33,1,"い"],[36,1,"ひ"]],"text":"主なる神は言われる、見よ、これは来る、必ず成就する。これはわたしが言った日である。"},{"ref":"Ezek.39.9","start":26039009,"end":26039009,"break":"none","ruby":[[6,2,"まちまち"],[9,1,"す"],[11,1,"もの"],[13,1,"で"],[15,1,"き"],[18,2,"ぶき"],[24,2,"おおだて"],[27,2,"こだて"],[30,1,"ゆみ"],[32,1,"や"],[34,1,"て"],[46,1,"も"],[50,1,"や"],[54,1,"ねん"],[56,1,"あいだ"],[60,1,"ひ"],[62,1,"も"]],"text":"イスラエルの町々に住む者は出て来て、武器すなわち大盾、小盾、弓、矢、手やり、およびやりなどを燃やし、焼き、七年の間これを火に燃やす。"},{"ref":"Ezek.39.10","start":26039010,"end":26039010,"break":"none","ruby":[[0,1,"かれ"],[3,1,"の"],[6,1,"き"],[8,1,"と"],[12,1,"もり"],[15,1,"き"],[17,1,"き"],[21,2,"ぶき"],[24,1,"ひ"],[26,1,"も"],[30,2,"じぶん"],[37,1,"もの"],[43,2,"じぶん"],[46,1,"もの"],[48,1,"うば"],[51,1,"もの"],[53,1,"うば"],[57,1,"しゅ"],[60,1,"かみ"],[62,1,"い"]],"text":"彼らは野から木を取らず、森から木を切らず、武器で火を燃やし、自分をかすめた者をかすめ、自分の物を奪った者を奪うと、主なる神は言われる。"},{"ref":"Ezek.39.11","start":26039011,"end":26039011,"break":"paragraph","ruby":[[2,1,"ひ"],[18,2,"ぼち"],[24,1,"あた"],[31,1,"たび"],[35,1,"たに"],[40,1,"うみ"],[42,1,"ひがし"],[50,1,"たび"],[54,1,"さまた"],[66,2,"みんしゅう"],[69,1,"う"],[88,1,"たに"],[90,1,"な"]],"text":"その日、わたしはイスラエルのうちに、墓地をゴグに与える。これは旅びとの谷にあって海の東にある。これは旅びとを妨げる。そこにゴグとその民衆を埋めるからである。これをハモン・ゴグの谷と名づける。"},{"ref":"Ezek.39.12","start":26039012,"end":26039012,"break":"none","ruby":[[6,1,"いえ"],[11,1,"う"],[15,1,"ち"],[17,1,"きよ"],[25,1,"げつ"],[27,1,"ついや"]],"text":"イスラエルの家はこれを埋めて、地を清めるために七か月を費す。"},{"ref":"Ezek.39.13","start":26039013,"end":26039013,"break":"none","ruby":[[0,1,"くに"],[6,1,"たみ"],[11,1,"う"],[20,1,"な"],[22,1,"たか"],[31,1,"さか"],[34,1,"あらわ"],[36,1,"ひ"],[42,1,"しゅ"],[45,1,"かみ"],[47,1,"い"]],"text":"国のすべての民はこれを埋め、これによって名を高める。これはわが栄えを現す日であると、主なる神は言われる。"},{"ref":"Ezek.39.14","start":26039014,"end":26039014,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ひとびと"],[6,1,"えら"],[10,1,"た"],[13,1,"くに"],[15,1,"なか"],[17,1,"ゆ"],[24,1,"ち"],[30,1,"のこ"],[35,1,"もの"],[37,1,"う"],[44,1,"きよ"],[52,1,"げつ"],[54,1,"おわ"],[57,1,"かれ"],[60,1,"たず"]],"text":"彼らは人々を選んで、絶えず国の中を行きめぐらせ、地のおもてに残っている者を埋めて、これを清めさせる。七か月の終りに彼らは尋ねる。"},{"ref":"Ezek.39.15","start":26039015,"end":26039015,"break":"none","ruby":[[0,1,"くに"],[2,1,"ゆ"],[7,1,"もの"],[9,1,"ゆ"],[16,1,"ひと"],[18,1,"ほね"],[20,1,"み"],[22,1,"とき"],[24,2,"しにん"],[27,1,"う"],[30,1,"もの"],[43,1,"たに"],[45,1,"う"],[59,1,"しるべ"],[61,1,"た"],[64,1,"お"]],"text":"国を行きめぐる者が行きめぐって、人の骨を見る時、死人を埋める者が、これをハモン・ゴグの谷に埋めるまで、そのかたわらに、標を建てて置く。"},{"ref":"Ezek.39.16","start":26039016,"end":26039016,"break":"none","ruby":[[5,1,"まち"],[18,1,"かれ"],[23,1,"くに"],[25,1,"きよ"]],"text":"（ハモナの町もそこにある。）こうして彼らはその国を清める。"},{"ref":"Ezek.39.17","start":26039017,"end":26039017,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[12,1,"ひと"],[14,1,"こ"],[17,2,"しょしゅ"],[20,1,"とり"],[22,1,"の"],[24,1,"けもの"],[27,1,"い"],[32,1,"あつ"],[52,1,"そな"],[55,2,"ぎせい"],[68,2,"やまやま"],[71,1,"うえ"],[76,1,"おお"],[80,2,"ぎせい"],[84,2,"しほう"],[88,1,"あつ"],[94,1,"にく"],[96,1,"く"],[101,1,"ち"],[103,1,"の"]],"text":"主なる神はこう言われる、人の子よ、諸種の鳥と野の獣とに言え、みな集まってこい。わたしがおまえたちのために供えた犠牲、すなわちイスラエルの山々の上にある、大いなる犠牲に、四方から集まり、その肉を食い、その血を飲め。"},{"ref":"Ezek.39.18","start":26039018,"end":26039018,"break":"none","ruby":[[6,2,"ゆうし"],[9,1,"にく"],[11,1,"く"],[14,1,"ち"],[16,1,"きみ"],[20,1,"ち"],[22,1,"の"],[25,2,"おひつじ"],[28,2,"こひつじ"],[31,1,"お"],[35,2,"おうし"],[47,1,"こ"],[50,1,"けもの"],[52,1,"く"]],"text":"おまえたちは勇士の肉を食い、地の君たちの血を飲め。雄羊、小羊、雄やぎ、雄牛などすべてバシャンの肥えた獣を食え。"},{"ref":"Ezek.39.19","start":26039019,"end":26039019,"break":"none","ruby":[[13,1,"そな"],[16,2,"ぎせい"],[20,1,"あ"],[27,2,"しぼう"],[30,1,"た"],[33,1,"よ"],[37,1,"ち"],[39,1,"の"]],"text":"わたしがおまえたちのために供えた犠牲は、飽きるまでその脂肪を食べ、酔うまで血を飲め。"},{"ref":"Ezek.39.20","start":26039020,"end":26039020,"break":"none","ruby":[[8,2,"しょくたく"],[14,1,"うま"],[17,2,"きしゅ"],[21,2,"ゆうし"],[30,2,"せんし"],[34,1,"あ"],[39,1,"た"],[44,1,"しゅ"],[47,1,"かみ"],[49,1,"い"]],"text":"おまえたちはわが食卓について馬と、騎手と、勇士と、もろもろの戦士とを飽きるほど食べると、主なる神は言われる。"},{"ref":"Ezek.39.21","start":26039021,"end":26039021,"break":"paragraph","ruby":[[6,2,"えいこう"],[9,1,"しょ"],[10,2,"こくみん"],[13,1,"しめ"],[20,2,"こくみん"],[27,1,"おこな"],[39,1,"かれ"],[42,1,"うえ"],[44,1,"くわ"],[47,1,"て"],[50,1,"み"]],"text":"わたしはわが栄光を諸国民に示す。すべての国民はわたしが行ったさばきと、わたしが彼らの上に加えた手とを見る。"},{"ref":"Ezek.39.22","start":26039022,"end":26039022,"break":"none","ruby":[[2,1,"ひ"],[5,1,"のち"],[13,1,"いえ"],[19,1,"かれ"],[22,1,"かみ"],[24,1,"しゅ"],[31,1,"さと"]],"text":"この日から後、イスラエルの家はわたしが彼らの神、主であることを悟るようになる。"},{"ref":"Ezek.39.23","start":26039023,"end":26039023,"break":"none","ruby":[[2,1,"しょ"],[3,2,"こくみん"],[12,1,"いえ"],[17,1,"あく"],[22,1,"とら"],[24,1,"うつ"],[31,1,"さと"],[34,1,"かれ"],[54,1,"かお"],[56,1,"かれ"],[59,1,"かく"],[62,1,"かれ"],[67,1,"てき"],[69,1,"て"],[71,1,"わた"],[78,1,"かれ"],[81,1,"みな"],[86,1,"たお"]],"text":"また諸国民はイスラエルの家が、その悪によって捕え移されたことを悟る。彼らがわたしにそむいたので、わたしはわが顔を彼らに隠し、彼らをその敵の手に渡した。それで彼らは皆つるぎに倒れた。"},{"ref":"Ezek.39.24","start":26039024,"end":26039024,"break":"none","ruby":[[4,1,"かれ"],[7,1,"けが"],[15,1,"したが"],[19,1,"かれ"],[22,1,"あつか"],[29,1,"かお"],[31,1,"かれ"],[34,1,"かく"]],"text":"わたしは彼らの汚れと、とがとに従って、彼らを扱い、わたしの顔を彼らに隠した。"},{"ref":"Ezek.39.25","start":26039025,"end":26039025,"break":"paragraph","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[27,2,"こうふく"],[33,1,"かえ"],[42,2,"ぜんか"],[52,1,"せい"],[55,1,"な"],[65,1,"おこ"]],"text":"それゆえ、主なる神はこう言われる、いまわたしはヤコブの幸福をもとに返し、イスラエルの全家をあわれみ、わが聖なる名のために、ねたみを起す。"},{"ref":"Ezek.39.26","start":26039026,"end":26039026,"break":"none","ruby":[[0,1,"かれ"],[6,1,"くに"],[8,1,"やす"],[12,1,"す"],[21,1,"おそ"],[26,1,"もの"],[36,1,"とき"],[38,2,"じぶん"],[41,1,"はじ"],[48,1,"む"],[55,2,"はんぎゃく"],[59,1,"わす"]],"text":"彼らは、その国に安らかに住み、だれもこれを恐れさせる者がないようになった時、自分の恥と、わたしに向かってなした反逆とを忘れる。"},{"ref":"Ezek.39.27","start":26039027,"end":26039027,"break":"none","ruby":[[4,1,"かれ"],[7,1,"しょ"],[8,2,"こくみん"],[11,1,"なか"],[14,1,"かえ"],[20,1,"てき"],[22,1,"くに"],[25,1,"よ"],[27,1,"あつ"],[30,1,"かれ"],[41,1,"せい"],[48,1,"おお"],[51,2,"こくみん"],[54,1,"まえ"],[56,1,"しめ"],[58,1,"とき"]],"text":"わたしが彼らを諸国民の中から帰らせ、その敵の国から呼び集め、彼らによって、わたしの聖なることを、多くの国民の前に示す時、"},{"ref":"Ezek.39.28","start":26039028,"end":26039028,"break":"none","ruby":[[0,1,"かれ"],[8,1,"かれ"],[11,1,"かみ"],[13,1,"しゅ"],[20,1,"さと"],[30,1,"かれ"],[33,1,"しょ"],[34,2,"こくみん"],[40,1,"うつ"],[50,1,"くに"],[52,1,"よ"],[54,1,"あつ"],[75,2,"くにぐに"],[81,1,"のこ"]],"text":"彼らは、わたしが彼らの神、主であることを悟る。これはわたしが彼らを諸国民のうちに移し、またこれをその国に呼び集めたからである。わたしはそのひとりをも、国々のうちに残すことをしない。"},{"ref":"Ezek.39.29","start":26039029,"end":26039029,"break":"none","ruby":[[7,1,"れい"],[15,1,"いえ"],[17,1,"そそ"],[19,1,"とき"],[21,1,"かさ"],[26,1,"かお"],[28,1,"かれ"],[31,1,"かく"],[37,1,"しゅ"],[40,1,"かみ"],[42,1,"い"]],"text":"わたしは、わが霊をイスラエルの家に注ぐ時、重ねてわが顔を彼らに隠さないと、主なる神は言われる」。"}]