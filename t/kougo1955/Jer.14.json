[{"ref":"Jer.14.1","start":24014001,"end":24014001,"break":"paragraph","ruby":[[4,1,"こと"],[14,1,"のぞ"],[17,1,"しゅ"],[19,2,"ことば"]],"text":"ひでりの事についてエレミヤに臨んだ主の言葉。"},{"ref":"Jer.14.2","start":24014002,"end":24014002,"break":"stanza","breaks":[[8,"line"],[18,"line"],[28,"line"]],"ruby":[[4,1,"かな"],[10,2,"まちまち"],[13,1,"もん"],[15,1,"かたむ"],[18,1,"たみ"],[20,1,"ち"],[22,1,"ざ"],[25,1,"なげ"],[34,1,"さけ"]],"text":"「ユダは悲しみ、その町々の門は傾き、民は地に座して嘆き、エルサレムの叫びはあがる。"},{"ref":"Jer.14.3","start":24014003,"end":24014003,"break":"line","breaks":[[23,"line"],[43,"line"],[55,"line"]],"ruby":[[2,1,"きみ"],[16,1,"みず"],[23,1,"かれ"],[26,2,"いど"],[29,1,"ところ"],[35,1,"みず"],[37,1,"み"],[47,1,"うつわ"],[52,1,"かえ"],[55,1,"は"],[60,2,"とうわく"],[67,1,"あたま"]],"text":"その君たちは、しもべをつかわして水をくませる。彼らが井戸の所にきても、水は見つからず、むなしい器をもって帰り、恥じ、かつ当惑して、その頭をおおう。"},{"ref":"Jer.14.4","start":24014004,"end":24014004,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ち"],[2,1,"あめ"],[4,1,"ふ"],[8,1,"つち"],[15,1,"わ"],[21,2,"のうふ"],[24,1,"は"],[30,1,"あたま"]],"text":"地に雨が降らず、土が、かわいて割れたため、農夫は恥じて、その頭をおおう。"},{"ref":"Jer.14.5","start":24014005,"end":24014005,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"の"],[4,1,"め"],[11,1,"こ"],[13,1,"う"],[20,1,"す"],[24,1,"くさ"]],"text":"野にいる雌じかでさえも子を産んで、これを捨てる。草がないからである。"},{"ref":"Jer.14.6","start":24014006,"end":24014006,"break":"line","breaks":[[15,"line"],[25,"line"]],"ruby":[[0,1,"の"],[7,1,"やま"],[9,1,"うえ"],[11,1,"た"],[15,2,"やまいぬ"],[25,1,"くさ"],[35,1,"め"]],"text":"野ろばは、はげ山の上に立って、山犬のようにあえぎ、草のないために、その目はくらむ。"},{"ref":"Jer.14.7","start":24014007,"end":24014007,"break":"stanza","breaks":[[18,"line"],[28,"line"],[48,"line"],[61,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"つみ"],[15,1,"うった"],[18,2,"ふり"],[21,2,"しょうげん"],[32,1,"な"],[38,1,"こと"],[53,2,"はいしん"],[56,1,"かず"],[58,1,"おお"],[65,1,"む"],[69,1,"つみ"],[71,1,"おか"]],"text":"主よ、われわれの罪がわれわれを訴えて不利な証言をしても、あなたの名のために、事をなしてください。われわれの背信の数は多く、あなたに向かって罪を犯しました。"},{"ref":"Jer.14.8","start":24014008,"end":24014008,"break":"line","breaks":[[13,"line"],[22,"line"],[45,"line"],[67,"line"]],"ruby":[[6,1,"のぞ"],[10,1,"しゅ"],[13,1,"なや"],[16,1,"とき"],[18,2,"すくいぬし"],[31,1,"ち"],[33,1,"す"],[35,2,"いほう"],[38,1,"ひと"],[47,2,"いちや"],[50,1,"やど"],[56,1,"た"],[58,1,"よ"],[60,1,"たび"]],"text":"イスラエルの望みなる主よ、悩みの時の救主よ、なぜ、あなたはこの地に住む異邦の人のようにし、また一夜の宿りのために立ち寄る旅びとのようになさらねばならないのですか。"},{"ref":"Jer.14.9","start":24014009,"end":24014009,"break":"line","breaks":[[22,"line"],[37,"line"],[51,"line"],[74,"line"],[96,"line"]],"ruby":[[15,1,"ひと"],[24,1,"ひと"],[26,1,"すく"],[31,2,"ゆうし"],[51,1,"しゅ"],[81,1,"な"],[86,1,"よ"],[92,1,"もの"],[101,2,"みす"]],"text":"なぜ、あなたは、うろたえている人のようにし、また人を救いえない勇士のようになさらねばならないのですか。主よ、あなたはわれわれのうちにいらせられます。われわれは、み名によって呼ばれている者です。われわれを見捨てないでください」。"},{"ref":"Jer.14.10","start":24014010,"end":24014010,"break":"paragraph","breaks":[[16,"stanza"],[34,"line"],[53,"line"],[62,"line"]],"ruby":[[2,1,"たみ"],[7,1,"しゅ"],[11,1,"い"],[17,1,"かれ"],[25,1,"この"],[36,1,"あし"],[53,1,"しゅ"],[55,1,"かれ"],[58,1,"よろこ"],[69,1,"おぼ"],[74,1,"つみ"],[76,1,"ばっ"]],"text":"この民について主はこう言われる、「彼らはこのように好んで、さまよい、その足をとどめることをしなかったので、主は彼らを喜ばず、いまそのとがを覚え、その罪を罰するのだ」。"},{"ref":"Jer.14.11","start":24014011,"end":24014011,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[14,1,"たみ"],[19,1,"めぐ"],[22,1,"いの"]],"text":"主はわたしに言われた、「この民のために恵みを祈ってはならない。"},{"ref":"Jer.14.12","start":24014012,"end":24014012,"break":"none","ruby":[[0,1,"かれ"],[3,2,"だんじき"],[13,1,"かれ"],[16,1,"よ"],[20,1,"き"],[25,2,"はんさい"],[28,2,"そさい"],[44,1,"う"],[66,2,"えきびょう"],[73,1,"かれ"],[76,1,"ほろ"]],"text":"彼らが断食しても、わたしは彼らの呼ぶのを聞かない。燔祭と素祭をささげても、わたしはそれを受けない。かえって、つるぎと、ききん、および疫病をもって、彼らを滅ぼしてしまう」。"},{"ref":"Jer.14.13","start":24014013,"end":24014013,"break":"paragraph","ruby":[[4,1,"い"],[12,1,"しゅ"],[15,1,"かみ"],[18,3,"よげんしゃ"],[26,1,"たみ"],[28,1,"む"],[44,1,"み"],[66,1,"ところ"],[68,1,"たし"],[71,2,"へいあん"],[80,1,"あた"],[85,1,"い"]],"text":"わたしは言った、「ああ、主なる神よ、預言者たちはこの民に向かい、『あなたがたは、つるぎを見ることはない。ききんもこない。わたしはこの所に確かな平安をあなたがたに与える』と言っています」。"},{"ref":"Jer.14.14","start":24014014,"end":24014014,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,3,"よげんしゃ"],[21,1,"な"],[26,1,"いつわ"],[29,2,"よげん"],[41,1,"かれ"],[55,1,"かれ"],[58,1,"めい"],[67,1,"はな"],[76,1,"かれ"],[79,1,"いつわ"],[82,2,"もくし"],[86,1,"やく"],[88,1,"た"],[92,1,"うらな"],[98,2,"じぶん"],[101,1,"こころ"],[109,1,"あざむ"],[118,2,"よげん"]],"text":"主はわたしに言われた、「預言者らはわたしの名によって偽りの預言をしている。わたしは彼らをつかわさなかった。また彼らに命じたこともなく、話したこともない。彼らは偽りの黙示と、役に立たない占い、および自分の心でつくりあげた欺きをあなたがたに預言しているのだ。"},{"ref":"Jer.14.15","start":24014015,"end":24014015,"break":"none","ruby":[[22,1,"な"],[27,2,"よげん"],[44,1,"ち"],[51,1,"い"],[58,3,"よげんしゃ"],[66,1,"しゅ"],[70,1,"おお"],[78,3,"よげんしゃ"],[92,1,"ほろ"]],"text":"それゆえ、わたしがつかわさないのに、わたしの名によって預言して、『つるぎとききんは、この地にこない』と言っているあの預言者について、主はこう仰せられる、この預言者らは、つるぎとききんに滅ぼされる。"},{"ref":"Jer.14.16","start":24014016,"end":24014016,"break":"none","ruby":[[2,1,"かれ"],[5,2,"よげん"],[8,1,"き"],[10,1,"たみ"],[36,1,"な"],[38,1,"す"],[50,1,"ほうむ"],[52,1,"もの"],[57,1,"かれ"],[62,1,"つま"],[72,1,"むすめ"],[74,2,"どうよう"],[84,1,"かれ"],[87,1,"あく"],[91,1,"うえ"],[93,1,"そそ"]],"text":"また彼らの預言を聞く民は、ききんとつるぎとによって、エルサレムのちまたに投げ捨てられる。だれもこれを葬る者はない。彼らとその妻、およびそのむすこ娘も同様である。わたしが彼らの悪をその上に注ぐからである。"},{"ref":"Jer.14.17","start":24014017,"end":24014017,"break":"paragraph","breaks":[[11,"stanza"],[30,"line"],[47,"line"]],"ruby":[[2,2,"ことば"],[5,1,"かれ"],[8,1,"かた"],[16,1,"め"],[18,1,"よる"],[20,1,"ひる"],[22,1,"た"],[25,1,"なみだ"],[27,1,"なが"],[32,1,"たみ"],[34,1,"むすめ"],[42,1,"おお"],[45,1,"きず"],[47,1,"おも"],[49,2,"だげき"],[55,1,"ほろ"]],"text":"この言葉を彼らに語れ、『わたしの目は夜も昼も絶えず涙を流す。わが民の娘であるおとめが大きな傷と重い打撃によって滅ぼされるからである。"},{"ref":"Jer.14.18","start":24014018,"end":24014018,"break":"line","breaks":[[12,"line"],[25,"line"],[46,"line"],[65,"line"]],"ruby":[[4,1,"で"],[6,1,"はたけ"],[8,1,"い"],[16,1,"ころ"],[20,1,"もの"],[25,1,"まち"],[36,1,"や"],[41,1,"もの"],[46,3,"よげんしゃ"],[50,2,"さいし"],[53,1,"とも"],[57,1,"ち"],[65,1,"し"]],"text":"わたしが出て畑に行くと、つるぎで殺された者がある。町にはいると、ききんで病んでいる者がある。預言者も祭司も共にその地にさまよって、知るところがない』」。"},{"ref":"Jer.14.19","start":24014019,"end":24014019,"break":"paragraph","breaks":[[21,"line"],[41,"line"],[76,"line"],[99,"line"]],"ruby":[[11,1,"す"],[25,1,"こころ"],[50,1,"う"],[81,2,"へいあん"],[84,1,"のぞ"],[89,1,"よ"],[91,1,"こと"],[104,1,"とき"],[106,1,"のぞ"],[115,2,"きょうふ"],[118,1,"き"]],"text":"あなたはまったくユダを捨てられたのですか。あなたの心はシオンをきらわれるのですか。あなたはわれわれを撃ったのに、どうしていやしてはくださらないのですか。われわれは平安を望んだが、良い事はこなかった。いやされる時を望んだが、かえって恐怖が来た。"},{"ref":"Jer.14.20","start":24014020,"end":24014020,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[8,2,"じぶん"],[11,1,"あく"],[14,2,"せんぞ"],[21,1,"みと"],[37,1,"つみ"],[39,1,"おか"]],"text":"主よ、われわれは自分の悪と、先祖のとがとを認めています。われわれはあなたに罪を犯しました。"},{"ref":"Jer.14.21","start":24014021,"end":24014021,"break":"line","breaks":[[22,"line"],[33,"line"],[46,"line"],[69,"line"]],"ruby":[[1,1,"な"],[12,1,"す"],[26,1,"さか"],[31,1,"くらい"],[56,1,"た"],[62,2,"けいやく"],[65,1,"おぼ"],[72,1,"やぶ"]],"text":"み名のために、われわれを捨てないでください。あなたの栄えあるみ位をはずかしめないでください。あなたがわれわれにお立てになった契約を覚えて、それを破らないでください。"},{"ref":"Jer.14.22","start":24014022,"end":24014022,"break":"line","breaks":[[13,"line"],[30,"line"],[51,"line"],[61,"line"],[83,"line"],[100,"line"]],"ruby":[[0,2,"いほう"],[3,1,"いつわ"],[6,2,"かみがみ"],[13,1,"あめ"],[15,1,"ふ"],[20,1,"もの"],[30,1,"てん"],[32,2,"じぶん"],[35,2,"ゆうだ"],[39,1,"ふ"],[56,1,"かみ"],[58,1,"しゅ"],[73,1,"かた"],[88,1,"ま"],[90,1,"のぞ"]],"text":"異邦の偽りの神々のうちに、雨を降らせうる者があるであろうか。天が自分で夕立ちを降らすことができようか。われわれの神、主よ、あなたこそ、これをなさる方ではありませんか。われわれの待ち望むのはあなたです。あなたがこれらすべてのことをなさるからです。"}]