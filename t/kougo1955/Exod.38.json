[{"ref":"Exod.38.1","start":2038001,"end":2038001,"break":"paragraph","ruby":[[6,1,"ざい"],[8,2,"はんさい"],[11,2,"さいだん"],[14,1,"つく"],[18,1,"なが"],[26,1,"はば"],[34,1,"かく"],[37,1,"たか"]],"text":"またアカシヤ材で燔祭の祭壇を造った。長さ五キュビト、幅五キュビトの四角で、高さは三キュビトである。"},{"ref":"Exod.38.2","start":2038002,"end":2038002,"break":"none","ruby":[[6,1,"うえ"],[11,2,"いちぶ"],[19,1,"つの"],[21,1,"つく"],[24,2,"せいどう"],[27,2,"さいだん"]],"text":"その四すみの上に、その一部とし、それの角を造り、青銅で祭壇をおおった。"},{"ref":"Exod.38.3","start":2038003,"end":2038003,"break":"none","ruby":[[2,2,"さいだん"],[10,1,"うつわ"],[20,2,"じゅうのう"],[23,1,"はち"],[25,1,"にく"],[26,1,"また"],[28,2,"ひざら"],[31,1,"つく"],[41,1,"うつわ"],[43,2,"せいどう"],[46,1,"つく"]],"text":"また祭壇のもろもろの器、すなわち、つぼ、十能、鉢、肉叉、火皿を造った。そのすべての器を青銅で造った。"},{"ref":"Exod.38.4","start":2038004,"end":2038004,"break":"none","ruby":[[2,2,"さいだん"],[9,2,"せいどう"],[12,1,"あみ"],[13,2,"ざいく"],[16,2,"こうし"],[19,1,"つく"],[25,2,"さいだん"],[28,2,"でば"],[32,1,"した"],[34,1,"と"],[40,2,"さいだん"],[43,1,"たか"],[46,1,"なか"],[49,1,"たっ"]],"text":"また祭壇のために、青銅の網細工の格子を造り、これを祭壇の出張りの下に取りつけて、祭壇の高さの半ばに達するようにした。"},{"ref":"Exod.38.5","start":2038005,"end":2038005,"break":"none","ruby":[[2,2,"せいどう"],[5,2,"こうし"],[16,1,"かん"],[20,1,"い"],[26,1,"とお"],[28,1,"ところ"]],"text":"また青銅の格子の四すみのために、環四つを鋳て、さおを通す所とした。"},{"ref":"Exod.38.6","start":2038006,"end":2038006,"break":"none","ruby":[[4,1,"ざい"],[12,1,"つく"],[15,2,"せいどう"]],"text":"アカシヤ材で、そのさおを造り、青銅でこれをおおい、"},{"ref":"Exod.38.7","start":2038007,"end":2038007,"break":"none","ruby":[[5,2,"さいだん"],[8,2,"りょうがわ"],[13,1,"かん"],[15,1,"とお"],[31,2,"さいだん"],[34,1,"いた"],[40,2,"くうどう"],[43,1,"つく"]],"text":"そのさおを祭壇の両側にある環に通して、それをかつぐようにした。祭壇は板をもって、空洞に造った。"},{"ref":"Exod.38.8","start":2038008,"end":2038008,"break":"paragraph","ruby":[[2,2,"せんばん"],[8,1,"だい"],[10,2,"せいどう"],[13,1,"つく"],[21,2,"かいけん"],[24,2,"まくや"],[27,2,"いりぐち"],[30,1,"つとめ"],[34,1,"おんな"],[38,1,"かがみ"],[43,1,"つく"]],"text":"また洗盤と、その台を青銅で造った。すなわち会見の幕屋の入口で務をなす女たちの鏡をもって造った。"},{"ref":"Exod.38.9","start":2038009,"end":2038009,"break":"paragraph","ruby":[[2,1,"にわ"],[4,1,"つく"],[10,2,"みなみがわ"],[22,2,"あま"],[25,2,"ねんし"],[28,1,"にわ"],[35,1,"もう"]],"text":"また庭を造った。その南側のために百キュビトの亜麻の撚糸の庭のあげばりを設けた。"},{"ref":"Exod.38.10","start":2038010,"end":2038010,"break":"none","ruby":[[2,1,"はしら"],[9,1,"はしら"],[14,1,"ざ"],[16,2,"せいどう"],[22,1,"はしら"],[24,1,"こま"],[26,1,"けた"],[28,1,"ぎん"]],"text":"その柱は二十、その柱の二十の座は青銅で、その柱の鉤と桁は銀とした。"},{"ref":"Exod.38.11","start":2038011,"end":2038011,"break":"none","ruby":[[2,2,"きたがわ"],[20,1,"もう"],[26,1,"はしら"],[32,1,"はしら"],[37,1,"ざ"],[39,2,"せいどう"],[45,1,"はしら"],[47,1,"こま"],[49,1,"けた"],[51,1,"ぎん"]],"text":"また北側のためにも百キュビトのあげばりを設けた。その柱二十、その柱の二十の座は青銅で、その柱の鉤と桁は銀とした。"},{"ref":"Exod.38.12","start":2038012,"end":2038012,"break":"none","ruby":[[2,2,"にしがわ"],[21,1,"もう"],[27,1,"はしら"],[33,1,"ざ"],[40,1,"はしら"],[42,1,"こま"],[44,1,"けた"],[46,1,"ぎん"]],"text":"また西側のために、五十キュビトのあげばりを設けた。その柱は十、その座も十で、その柱の鉤と桁は銀とした。"},{"ref":"Exod.38.13","start":2038013,"end":2038013,"break":"none","ruby":[[2,2,"ひがしがわ"],[22,1,"もう"]],"text":"また東側のためにも、五十キュビトのあげばりを設けた。"},{"ref":"Exod.38.14","start":2038014,"end":2038014,"break":"none","ruby":[[2,2,"いっぽう"],[17,1,"もう"],[23,1,"はしら"],[30,1,"ざ"]],"text":"その一方に十五キュビトのあげばりを設けた。その柱は三つ、その座も三つ。"},{"ref":"Exod.38.15","start":2038015,"end":2038015,"break":"none","ruby":[[2,1,"た"],[4,2,"いっぽう"],[9,1,"おな"],[21,1,"にわ"],[23,1,"もん"],[47,1,"もう"],[53,1,"はしら"],[60,1,"ざ"]],"text":"また他の一方にも、同じようにした。すなわち庭の門のこなたかなたともに、十五キュビトのあげばりを設けた。その柱は三つ、その座も三つ。"},{"ref":"Exod.38.16","start":2038016,"end":2038016,"break":"none","ruby":[[0,1,"にわ"],[2,2,"しゅうい"],[12,2,"あま"],[15,2,"ねんし"]],"text":"庭の周囲のあげばりはみな亜麻の撚糸である。"},{"ref":"Exod.38.17","start":2038017,"end":2038017,"break":"none","ruby":[[0,1,"はしら"],[2,1,"ざ"],[4,2,"せいどう"],[7,1,"はしら"],[9,1,"こま"],[11,1,"けた"],[14,1,"ぎん"],[16,1,"はしら"],[18,1,"あたま"],[24,1,"ぎん"],[29,1,"にわ"],[31,1,"はしら"],[35,1,"ぎん"],[37,1,"けた"],[39,1,"つら"]],"text":"柱の座は青銅、柱の鉤と桁とは銀、柱の頭のおおいも銀である。庭の柱はみな銀の桁で連ねた。"},{"ref":"Exod.38.18","start":2038018,"end":2038018,"break":"none","ruby":[[0,1,"にわ"],[2,1,"もん"],[8,1,"あお"],[9,1,"いと"],[11,1,"むらさき"],[12,1,"いと"],[14,1,"ひ"],[15,1,"いと"],[17,2,"あま"],[20,2,"ねんし"],[24,1,"いろ"],[30,1,"お"],[40,1,"なが"],[50,1,"はば"],[53,1,"たか"],[63,1,"にわ"],[70,1,"ひと"]],"text":"庭の門のとばりは青糸、紫糸、緋糸、亜麻の撚糸で、色とりどりに織ったものであった。長さは二十キュビト、幅なる高さは五キュビトで、庭のあげばりと等しかった。"},{"ref":"Exod.38.19","start":2038019,"end":2038019,"break":"none","ruby":[[2,1,"はしら"],[9,1,"ざ"],[18,2,"せいどう"],[23,1,"こま"],[25,1,"ぎん"],[27,1,"はしら"],[29,1,"あたま"],[35,1,"けた"],[37,1,"ぎん"]],"text":"その柱は四つ、その座も四つで、ともに青銅。その鉤は銀、柱の頭のおおいと桁は銀である。"},{"ref":"Exod.38.20","start":2038020,"end":2038020,"break":"none","ruby":[[4,2,"まくや"],[12,2,"しゅうい"],[15,1,"にわ"],[17,1,"くぎ"],[21,2,"せいどう"]],"text":"ただし、幕屋および、その周囲の庭の釘はみな青銅であった。"},{"ref":"Exod.38.21","start":2038021,"end":2038021,"break":"paragraph","ruby":[[0,2,"まくや"],[11,2,"まくや"],[14,1,"もち"],[17,1,"もの"],[19,2,"そうけい"],[22,1,"つぎ"],[39,1,"いのち"],[41,1,"したが"],[44,2,"さいし"],[50,1,"こ"],[61,1,"もち"],[64,1,"はか"]],"text":"幕屋、すなわちあかしの幕屋に用いた物の総計は次のとおりである。すなわちモーセの命に従い、祭司アロンの子イタマルがレビびとを用いて量ったものである。"},{"ref":"Exod.38.22","start":2038022,"end":2038022,"break":"none","ruby":[[3,2,"ぶぞく"],[6,1,"ぞく"],[12,1,"こ"],[18,1,"こ"],[25,1,"しゅ"],[31,1,"めい"],[36,1,"こと"]],"text":"ユダの部族に属するホルの子なるウリの子ベザレルは、主がモーセに命じられた事をことごとくした。"},{"ref":"Exod.38.23","start":2038023,"end":2038023,"break":"none","ruby":[[3,2,"ぶぞく"],[6,1,"ぞく"],[15,1,"こ"],[22,1,"かれ"],[24,1,"とも"],[29,2,"ちょうこく"],[32,1,"う"],[34,1,"おり"],[41,1,"あお"],[42,1,"いと"],[44,1,"むらさき"],[45,1,"いと"],[47,1,"ひ"],[48,1,"いと"],[50,2,"あま"],[52,1,"いと"],[55,2,"ぬいと"],[61,1,"もの"]],"text":"ダンの部族に属するアヒサマクの子アホリアブは彼と共にあって彫刻、浮き織をなし、また青糸、紫糸、緋糸、亜麻糸で、縫取りをする者であった。"},{"ref":"Exod.38.24","start":2038024,"end":2038024,"break":"paragraph","ruby":[[0,2,"せいじょ"],[8,2,"こうさく"],[11,1,"もち"],[18,1,"きん"],[28,1,"もの"],[31,1,"きん"],[33,2,"せいじょ"]],"text":"聖所のもろもろの工作に用いたすべての金、すなわち、ささげ物なる金は聖所のシケルで、二十九タラント七百三十シケルであった。"},{"ref":"Exod.38.25","start":2038025,"end":2038025,"break":"none","ruby":[[0,2,"かいしゅう"],[6,1,"かぞ"],[11,1,"もの"],[17,1,"ぎん"],[19,2,"せいじょ"]],"text":"会衆のうちの数えられた者のささげた銀は聖所のシケルで、百タラント千七百七十五シケルであった。"},{"ref":"Exod.38.26","start":2038026,"end":2038026,"break":"none","ruby":[[6,1,"あた"],[16,2,"せいじょ"],[23,1,"はん"],[37,1,"さい"],[38,2,"いじょう"],[41,1,"かぞ"],[46,1,"もの"],[57,1,"にん"]],"text":"これはひとり当り一ベカ、すなわち聖所のシケルの半シケルであって、すべて二十歳以上で数えられた者が六十万三千五百五十人であったからである。"},{"ref":"Exod.38.27","start":2038027,"end":2038027,"break":"none","ruby":[[0,2,"せいじょ"],[3,1,"ざ"],[5,2,"たれまく"],[8,1,"ざ"],[11,1,"い"],[16,1,"もち"],[19,1,"ぎん"],[36,1,"ざ"],[47,1,"ざ"]],"text":"聖所の座と垂幕の座とを鋳るために用いた銀は百タラントであった。すなわち百座につき百タラント、一座につき一タラントである。"},{"ref":"Exod.38.28","start":2038028,"end":2038028,"break":"none","ruby":[[12,1,"はしら"],[14,1,"こま"],[16,1,"つく"],[21,1,"はしら"],[23,1,"あたま"],[29,1,"はしら"],[34,1,"けた"],[36,1,"つく"]],"text":"また千七百七十五シケルで柱の鉤を造り、また柱の頭をおおい、柱のために桁を造った。"},{"ref":"Exod.38.29","start":2038029,"end":2038029,"break":"none","ruby":[[3,1,"もの"],[6,2,"せいどう"]],"text":"ささげ物なる青銅は七十タラント二千四百シケルであった。"},{"ref":"Exod.38.30","start":2038030,"end":2038030,"break":"none","ruby":[[3,1,"もち"],[6,2,"かいけん"],[9,2,"まくや"],[12,2,"いりぐち"],[15,1,"ざ"],[17,2,"せいどう"],[20,2,"さいだん"],[29,2,"せいどう"],[32,2,"こうし"],[38,2,"さいだん"],[46,1,"うつわ"],[48,1,"つく"]],"text":"これを用いて会見の幕屋の入口の座、青銅の祭壇と、それにつく青銅の格子、および祭壇のもろもろの器を造った。"},{"ref":"Exod.38.31","start":2038031,"end":2038031,"break":"none","ruby":[[2,1,"にわ"],[4,2,"しゅうい"],[7,1,"ざ"],[9,1,"にわ"],[11,1,"もん"],[13,1,"ざ"],[18,2,"まくや"],[26,1,"くぎ"],[29,1,"にわ"],[31,2,"しゅうい"],[39,1,"くぎ"],[41,1,"つく"]],"text":"また庭の周囲の座、庭の門の座、および幕屋のもろもろの釘と、庭の周囲のもろもろの釘を造った。"}]