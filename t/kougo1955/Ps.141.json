[{"ref":"Ps.141.1","start":19141001,"end":19141001,"break":"paragraph","title":"ダビデの歌","breaks":[[18,"line"],[35,"line"],[50,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"よ"],[28,1,"たす"],[43,1,"よ"],[52,1,"こえ"],[54,1,"みみ"],[56,1,"かたむ"]],"titleRuby":[[4,1,"うた"]],"text":"主よ、わたしはあなたに呼ばわります。すみやかにわたしをお助けください。わたしがあなたに呼ばわるとき、わが声に耳を傾けてください。"},{"ref":"Ps.141.2","start":19141002,"end":19141002,"break":"line","breaks":[[24,"line"],[34,"line"]],"ruby":[[4,1,"いのり"],[8,1,"まえ"],[14,2,"くんこう"],[31,1,"て"],[34,1,"ゆう"],[37,1,"そな"],[39,1,"もの"]],"text":"わたしの祈を、み前にささげる薫香のようにみなし、わたしのあげる手を、夕べの供え物のようにみなしてください。"},{"ref":"Ps.141.3","start":19141003,"end":19141003,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"くち"],[7,2,"かどもり"],[10,1,"お"],[21,1,"と"],[23,1,"まも"]],"text":"主よ、わが口に門守を置いて、わがくちびるの戸を守ってください。"},{"ref":"Ps.141.4","start":19141004,"end":19141004,"break":"line","breaks":[[15,"line"],[25,"line"],[44,"line"]],"ruby":[[0,1,"あ"],[3,1,"こと"],[7,1,"こころ"],[9,1,"かたむ"],[15,2,"ふぎ"],[18,1,"おこな"],[20,2,"ひとびと"],[23,1,"とも"],[25,1,"あ"],[46,1,"かれ"],[52,1,"もの"],[54,1,"た"]],"text":"悪しき事にわが心を傾けさせず、不義を行う人々と共に悪しきわざにあずからせないでください。また彼らのうまき物を食べさせないでください。"},{"ref":"Ps.141.5","start":19141005,"end":19141005,"break":"line","breaks":[[22,"line"],[36,"line"],[52,"line"],[64,"line"],[80,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[18,1,"う"],[26,1,"せ"],[39,1,"あ"],[42,1,"もの"],[44,1,"あぶら"],[66,1,"いのり"],[68,1,"た"],[71,1,"かれ"],[74,1,"あ"],[80,1,"てき"]],"text":"正しい者にいつくしみをもってわたしを打たせ、わたしを責めさせてください。しかし悪しき者の油をわがこうべにそそがせないでください。わが祈は絶えず彼らの悪しきわざに敵しているからです。"},{"ref":"Ps.141.6","start":19141006,"end":19141006,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[7,1,"つみ"],[9,1,"さだ"],[12,1,"もの"],[22,1,"しゅ"],[25,2,"ことば"],[36,1,"まな"]],"text":"彼らはおのれを罪に定める者にわたされるとき、主のみ言葉のまことなることを学ぶでしょう。"},{"ref":"Ps.141.7","start":19141007,"end":19141007,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ひと"],[2,1,"いわ"],[4,1,"さ"],[7,1,"ち"],[9,1,"うえ"],[11,1,"う"],[13,1,"くだ"],[19,1,"かれ"],[22,1,"ほね"],[24,2,"よみ"],[27,1,"くち"],[31,1,"ち"]],"text":"人が岩を裂いて地の上に打ち砕くように、彼らの骨は陰府の口にまき散らされるでしょう。"},{"ref":"Ps.141.8","start":19141008,"end":19141008,"break":"line","breaks":[[25,"line"],[40,"line"],[55,"line"]],"ruby":[[3,1,"しゅ"],[6,1,"かみ"],[11,1,"め"],[17,1,"む"],[33,1,"よ"],[35,1,"たの"],[44,1,"たす"],[55,1,"す"]],"text":"しかし主なる神よ、わが目はあなたに向かっています。わたしはあなたに寄り頼みます。わたしを助けるものもないままに捨ておかないでください。"},{"ref":"Ps.141.9","start":19141009,"end":19141009,"break":"line","breaks":[[8,"line"],[25,"line"]],"ruby":[[4,1,"まも"],[8,1,"かれ"],[18,1,"もう"],[25,1,"あく"],[27,1,"おこな"],[29,1,"もの"]],"text":"わたしを守って、彼らがわたしのために設けたわなと、悪を行う者のわなとをのがれさせてください。"},{"ref":"Ps.141.10","start":19141010,"end":19141010,"break":"line","breaks":[[13,"line"]],"ruby":[[9,2,"どうじ"],[13,1,"あ"],[16,1,"もの"],[22,1,"あみ"],[24,1,"おちい"]],"text":"わたしがのがれると同時に、悪しき者をおのれの網に陥らせてください。"}]