[{"ref":"Zech.10.1","start":38010001,"end":38010001,"break":"paragraph","breaks":[[13,"line"],[23,"line"],[42,"line"]],"ruby":[[6,1,"はる"],[8,1,"あめ"],[10,1,"とき"],[13,1,"あめ"],[15,1,"しゅ"],[17,1,"こ"],[19,1,"もと"],[23,1,"しゅ"],[30,1,"つく"],[33,2,"おおあめ"],[36,2,"ひとびと"],[39,1,"たま"],[42,1,"の"],[44,2,"あおくさ"],[52,1,"たま"]],"text":"あなたがたは春の雨の時に、雨を主に請い求めよ。主はいなずまを造り、大雨を人々に賜い、野の青草をおのおのに賜わる。"},{"ref":"Zech.10.2","start":38010002,"end":38010002,"break":"line","breaks":[[14,"line"],[23,"line"],[36,"line"],[47,"line"],[65,"line"]],"ruby":[[11,1,"い"],[14,1,"うらな"],[16,1,"し"],[18,1,"いつわ"],[21,1,"み"],[23,2,"ゆめみ"],[26,1,"もの"],[28,1,"いつわ"],[31,1,"ゆめ"],[33,1,"かた"],[40,1,"なぐさ"],[43,1,"あた"],[53,1,"たみ"],[55,1,"ひつじ"],[65,2,"ぼくしゃ"],[73,1,"なや"]],"text":"テラピムは、たわごとを言い、占い師は偽りを見、夢見る者は偽りの夢を語り、むなしい慰めを与える。このゆえに、民は羊のようにさまよい、牧者がないために悩む。"},{"ref":"Zech.10.3","start":38010003,"end":38010003,"break":"stanza","breaks":[[16,"line"],[28,"line"],[51,"line"]],"ruby":[[3,1,"いか"],[6,2,"ぼくしゃ"],[13,1,"も"],[20,1,"お"],[24,1,"ばっ"],[28,2,"ばんぐん"],[31,1,"しゅ"],[36,1,"む"],[39,1,"ひつじ"],[46,1,"いえ"],[48,1,"かえり"],[58,2,"ぐんば"]],"text":"「わが怒りは牧者にむかって燃え、わたしは雄やぎを罰する。万軍の主が、その群れの羊であるユダの家を顧み、これをみごとな軍馬のようにされるからである。"},{"ref":"Zech.10.4","start":38010004,"end":38010004,"break":"line","breaks":[[9,"line"],[20,"line"],[31,"line"]],"ruby":[[0,1,"すみ"],[1,1,"いし"],[3,1,"かれ"],[7,1,"で"],[9,2,"てんまく"],[12,1,"くい"],[14,1,"かれ"],[18,1,"で"],[23,1,"ゆみ"],[25,1,"かれ"],[29,1,"で"],[31,3,"しはいしゃ"],[35,1,"みな"],[36,1,"かれ"],[39,1,"なか"],[42,1,"で"]],"text":"隅石は彼らから出、天幕の杭も彼らから出、いくさ弓も彼らから出、支配者も皆彼らの中から出る。"},{"ref":"Zech.10.5","start":38010005,"end":38010005,"break":"line","breaks":[[17,"line"],[33,"line"],[53,"line"]],"ruby":[[0,1,"かれ"],[3,1,"たたか"],[5,1,"とき"],[7,2,"ゆうし"],[17,1,"みち"],[21,1,"どろ"],[23,1,"なか"],[25,1,"てき"],[27,1,"ふ"],[33,1,"しゅ"],[35,1,"かれ"],[38,1,"とも"],[47,1,"かれ"],[50,1,"たたか"],[53,1,"うま"],[55,1,"の"],[57,1,"もの"],[61,1,"こま"]],"text":"彼らが戦う時は勇士のようになって、道ばたの泥の中に敵を踏みにじる。主が彼らと共におられるゆえに彼らは戦い、馬に乗る者どもを困らせる。"},{"ref":"Zech.10.6","start":38010006,"end":38010006,"break":"line","breaks":[[22,"line"],[43,"line"],[66,"line"],[81,"line"]],"ruby":[[7,1,"いえ"],[9,1,"つよ"],[17,1,"いえ"],[19,1,"すく"],[26,1,"かれ"],[35,1,"かれ"],[38,1,"つ"],[40,1,"かえ"],[43,1,"かれ"],[50,1,"す"],[70,1,"かれ"],[73,1,"かみ"],[75,1,"しゅ"],[81,1,"かれ"],[84,1,"こた"]],"text":"わたしはユダの家を強くし、ヨセフの家を救う。わたしは彼らをあわれんで、彼らを連れ帰る。彼らはわたしに捨てられたことのないようになる。わたしは彼らの神、主であって、彼らに答えるからである。"},{"ref":"Zech.10.7","start":38010007,"end":38010007,"break":"line","breaks":[[17,"line"],[32,"line"],[46,"line"]],"ruby":[[8,2,"ゆうし"],[19,1,"こころ"],[21,1,"さけ"],[23,1,"の"],[29,1,"よろこ"],[34,1,"こ"],[35,1,"とも"],[41,1,"み"],[43,1,"よろこ"],[48,1,"こころ"],[50,1,"しゅ"],[55,1,"たの"]],"text":"エフライムびとは勇士のようになり、その心は酒を飲んだように喜ぶ。その子供らはこれを見て喜び、その心は主によって楽しむ。"},{"ref":"Zech.10.8","start":38010008,"end":38010008,"break":"line","breaks":[[24,"line"],[42,"line"]],"ruby":[[4,1,"かれ"],[7,1,"む"],[11,2,"くちぶえ"],[14,1,"ふ"],[17,1,"かれ"],[20,1,"あつ"],[28,1,"かれ"],[42,1,"かれ"],[45,1,"むかし"],[50,2,"かずおお"]],"text":"わたしは彼らに向かい、口笛を吹いて彼らを集める、わたしが彼らをあがなったからである。彼らは昔のように数多くなる。"},{"ref":"Zech.10.9","start":38010009,"end":38010009,"break":"line","breaks":[[19,"line"],[37,"line"]],"ruby":[[4,1,"かれ"],[7,2,"くにぐに"],[10,1,"たみ"],[12,1,"なか"],[14,1,"ち"],[22,1,"かれ"],[25,1,"とお"],[27,2,"くにぐに"],[34,1,"おぼ"],[39,2,"こども"],[43,1,"とも"],[45,1,"い"],[52,1,"かえ"]],"text":"わたしは彼らを国々の民の中に散らした。しかし彼らは遠い国々でわたしを覚え、その子供らと共に生きながらえて帰ってくる。"},{"ref":"Zech.10.10","start":38010010,"end":38010010,"break":"line","breaks":[[20,"line"],[34,"line"],[52,"line"],[61,"line"]],"ruby":[[4,1,"かれ"],[12,1,"くに"],[15,1,"つ"],[17,1,"かえ"],[27,1,"かれ"],[30,1,"あつ"],[43,1,"ち"],[52,1,"かれ"],[55,1,"つ"],[58,1,"い"],[61,1,"かれ"],[66,1,"ところ"],[73,1,"おお"]],"text":"わたしは彼らをエジプトの国から連れ帰り、アッスリヤから彼らを集める。わたしはギレアデの地およびレバノンに彼らを連れて行く。彼らはいる所もないほどに多くなる。"},{"ref":"Zech.10.11","start":38010011,"end":38010011,"break":"line","breaks":[[13,"line"],[21,"line"],[36,"line"],[51,"line"]],"ruby":[[0,1,"かれ"],[8,1,"うみ"],[10,1,"とお"],[13,1,"うみ"],[15,1,"なみ"],[17,1,"う"],[25,1,"ふち"],[42,1,"たか"],[46,1,"ひく"],[59,1,"うつ"],[61,1,"さ"]],"text":"彼らはエジプトの海を通る。海の波は撃たれ、ナイルの淵はことごとくかれた。アッスリヤの高ぶりは低くされ、エジプトのつえは移り去る。"},{"ref":"Zech.10.12","start":38010012,"end":38010012,"break":"line","breaks":[[17,"line"],[28,"line"]],"ruby":[[4,1,"かれ"],[7,1,"しゅ"],[12,1,"つよ"],[17,1,"かれ"],[20,1,"しゅ"],[22,1,"な"],[24,1,"ほこ"],[28,1,"しゅ"],[30,1,"い"]],"text":"わたしは彼らを主によって強くする。彼らは主の名を誇る」と主は言われる。"}]