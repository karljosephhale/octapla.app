[{"ref":"2Sam.11.1","start":10011001,"end":10011001,"break":"paragraph","ruby":[[0,1,"はる"],[6,1,"おう"],[10,1,"たたか"],[13,1,"で"],[16,1,"およ"],[30,2,"じぶん"],[33,1,"とも"],[37,2,"けらい"],[42,1,"なら"],[51,1,"ぜん"],[52,1,"ぐん"],[60,1,"かれ"],[68,2,"ひとびと"],[71,1,"ほろ"],[78,2,"ほうい"]],"text":"春になって、王たちが戦いに出るに及んで、ダビデはヨアブおよび自分と共にいる家来たち、並びにイスラエルの全軍をつかわした。彼らはアンモンの人々を滅ぼし、ラバを包囲した。しかしダビデはエルサレムにとどまっていた。"},{"ref":"2Sam.11.2","start":10011002,"end":10011002,"break":"paragraph","ruby":[[5,1,"ひ"],[7,2,"ゆうぐれ"],[14,1,"ゆか"],[17,1,"お"],[19,1,"で"],[22,1,"おう"],[24,1,"いえ"],[26,2,"おくじょう"],[29,1,"ある"],[36,2,"おくじょう"],[45,1,"おんな"],[51,1,"あら"],[58,1,"み"],[63,1,"おんな"],[65,2,"ひじょう"],[68,1,"うつく"]],"text":"さて、ある日の夕暮、ダビデは床から起き出て、王の家の屋上を歩いていたが、屋上から、ひとりの女がからだを洗っているのを見た。その女は非常に美しかった。"},{"ref":"2Sam.11.3","start":10011003,"end":10011003,"break":"none","ruby":[[4,1,"ひと"],[13,1,"おんな"],[18,1,"さぐ"],[26,1,"ひと"],[28,1,"い"],[41,1,"むすめ"],[52,1,"つま"]],"text":"ダビデは人をつかわしてその女のことを探らせたが、ある人は言った、「これはエリアムの娘で、ヘテびとウリヤの妻バテシバではありませんか」。"},{"ref":"2Sam.11.4","start":10011004,"end":10011004,"break":"none","ruby":[[7,2,"ししゃ"],[18,1,"おんな"],[20,1,"つ"],[26,1,"おんな"],[28,1,"かれ"],[30,1,"ところ"],[35,1,"かれ"],[39,1,"おんな"],[41,1,"ね"],[45,1,"おんな"],[47,1,"み"],[49,1,"けが"],[52,1,"きよ"],[67,1,"おんな"],[71,1,"いえ"],[73,1,"かえ"]],"text":"そこでダビデは使者をつかわして、その女を連れてきた。女は彼の所にきて、彼はその女と寝た。（女は身の汚れを清めていたのである。）こうして女はその家に帰った。"},{"ref":"2Sam.11.5","start":10011005,"end":10011005,"break":"none","ruby":[[0,1,"おんな"],[2,2,"にんしん"],[9,1,"ひと"],[20,1,"つ"],[23,1,"い"],[32,1,"こ"]],"text":"女は妊娠したので、人をつかわしてダビデに告げて言った、「わたしは子をはらみました」。"},{"ref":"2Sam.11.6","start":10011006,"end":10011006,"break":"paragraph","ruby":[[25,1,"ところ"],[33,1,"い"],[54,1,"ところ"]],"text":"そこでダビデはヨアブに、「ヘテびとウリヤをわたしの所につかわせ」と言ってやったので、ヨアブはウリヤをダビデの所につかわした。"},{"ref":"2Sam.11.7","start":10011007,"end":10011007,"break":"none","ruby":[[8,1,"ところ"],[32,1,"たみ"],[42,1,"たたか"]],"text":"ウリヤがダビデの所にきたので、ダビデは、ヨアブはどうしているか、民はどうしているか、戦いはうまくいっているかとたずねた。"},{"ref":"2Sam.11.8","start":10011008,"end":10011008,"break":"none","ruby":[[11,1,"い"],[20,1,"いえ"],[22,1,"い"],[26,1,"あし"],[28,1,"あら"],[39,1,"おう"],[41,1,"いえ"],[43,1,"で"],[50,1,"おう"],[52,1,"おく"],[54,1,"もの"],[56,1,"かれ"],[58,1,"のち"],[60,1,"したが"]],"text":"そしてダビデはウリヤに言った、「あなたの家に行って、足を洗いなさい」。ウリヤは王の家を出ていったが、王の贈り物が彼の後に従った。"},{"ref":"2Sam.11.9","start":10011009,"end":10011009,"break":"none","ruby":[[7,1,"おう"],[9,1,"いえ"],[11,2,"いりぐち"],[14,2,"しゅくん"],[17,2,"けらい"],[22,1,"とも"],[24,1,"ね"],[27,2,"じぶん"],[30,1,"いえ"],[32,1,"かえ"]],"text":"しかしウリヤは王の家の入口で主君の家来たちと共に寝て、自分の家に帰らなかった。"},{"ref":"2Sam.11.10","start":10011010,"end":10011010,"break":"none","ruby":[[0,2,"ひとびと"],[13,2,"じぶん"],[16,1,"いえ"],[18,1,"かえ"],[28,1,"つ"],[42,1,"い"],[47,1,"たび"],[50,1,"かえ"],[66,1,"いえ"],[68,1,"かえ"]],"text":"人々がダビデに、「ウリヤは自分の家に帰りませんでした」と告げたので、ダビデはウリヤに言った、「旅から帰ってきたのではないか。どうして家に帰らなかったのか」。"},{"ref":"2Sam.11.11","start":10011011,"end":10011011,"break":"none","ruby":[[8,1,"い"],[13,1,"かみ"],[15,1,"はこ"],[29,2,"こや"],[32,1,"なか"],[34,1,"す"],[41,2,"しゅじん"],[50,2,"しゅくん"],[53,2,"けらい"],[58,1,"の"],[64,1,"じん"],[66,1,"と"],[82,1,"いえ"],[84,1,"かえ"],[87,1,"く"],[89,1,"の"],[93,1,"つま"],[95,1,"ね"],[111,1,"い"],[124,1,"たましい"],[126,1,"い"],[139,1,"こと"]],"text":"ウリヤはダビデに言った、「神の箱も、イスラエルも、ユダも、小屋の中に住み、わたしの主人ヨアブと、わが主君の家来たちが野のおもてに陣を取っているのに、わたしはどうして家に帰って食い飲みし、妻と寝ることができましょう。あなたは生きておられます。あなたの魂は生きています。わたしはこの事をいたしません」。"},{"ref":"2Sam.11.12","start":10011012,"end":10011012,"break":"none","ruby":[[8,1,"い"],[40,1,"さ"],[58,1,"ひ"],[60,1,"つぎ"],[62,1,"ひ"]],"text":"ダビデはウリヤに言った、「きょうも、ここにとどまりなさい。わたしはあす、あなたを去らせましょう」。そこでウリヤはその日と次の日エルサレムにとどまった。"},{"ref":"2Sam.11.13","start":10011013,"end":10011013,"break":"none","ruby":[[4,1,"かれ"],[6,1,"まね"],[9,2,"じぶん"],[12,1,"まえ"],[14,1,"く"],[16,1,"の"],[21,1,"かれ"],[23,1,"よ"],[28,2,"ゆうぐれ"],[34,1,"かれ"],[36,1,"で"],[44,1,"ゆか"],[47,2,"しゅくん"],[50,2,"けらい"],[55,1,"とも"],[57,1,"ね"],[63,2,"じぶん"],[66,1,"いえ"],[69,1,"くだ"],[72,1,"い"]],"text":"ダビデは彼を招いて自分の前で食い飲みさせ、彼を酔わせた。夕暮になって彼は出ていって、その床に、主君の家来たちと共に寝た。そして自分の家には下って行かなかった。"},{"ref":"2Sam.11.14","start":10011014,"end":10011014,"break":"paragraph","ruby":[[0,1,"あさ"],[16,2,"てがみ"],[19,1,"か"],[26,1,"て"],[28,1,"たく"],[34,1,"おく"]],"text":"朝になってダビデはヨアブにあてた手紙を書き、ウリヤの手に託してそれを送った。"},{"ref":"2Sam.11.15","start":10011015,"end":10011015,"break":"none","ruby":[[0,1,"かれ"],[4,2,"てがみ"],[19,1,"はげ"],[22,1,"たたか"],[25,3,"さいぜんせん"],[29,1,"だ"],[32,1,"かれ"],[34,1,"うしろ"],[37,1,"しりぞ"],[41,1,"かれ"],[43,2,"うちじに"],[50,1,"か"]],"text":"彼はその手紙に、「あなたがたはウリヤを激しい戦いの最前線に出し、彼の後から退いて、彼を討死させよ」と書いた。"},{"ref":"2Sam.11.16","start":10011016,"end":10011016,"break":"none","ruby":[[4,1,"まち"],[6,1,"かこ"],[14,2,"ゆうし"],[22,1,"し"],[27,2,"ばしょ"],[34,1,"お"]],"text":"ヨアブは町を囲んでいたので、勇士たちがいると知っていた場所にウリヤを置いた。"},{"ref":"2Sam.11.17","start":10011017,"end":10011017,"break":"none","ruby":[[0,1,"まち"],[2,2,"ひとびと"],[5,1,"で"],[13,1,"たたか"],[19,1,"たみ"],[28,2,"けらい"],[35,1,"たお"],[52,1,"し"]],"text":"町の人々が出てきてヨアブと戦ったので、民のうち、ダビデの家来たちにも、倒れるものがあり、ヘテびとウリヤも死んだ。"},{"ref":"2Sam.11.18","start":10011018,"end":10011018,"break":"none","ruby":[[4,1,"ひと"],[11,1,"たたか"],[25,1,"つ"]],"text":"ヨアブは人をつかわして戦いのことをつぶさにダビデに告げた。"},{"ref":"2Sam.11.19","start":10011019,"end":10011019,"break":"none","ruby":[[6,2,"ししゃ"],[9,1,"めい"],[12,1,"い"],[21,1,"たたか"],[31,1,"おう"],[33,1,"かた"],[35,1,"おわ"]],"text":"ヨアブはその使者に命じて言った、「あなたが戦いのことをつぶさに王に語り終ったとき、"},{"ref":"2Sam.11.20","start":10011020,"end":10011020,"break":"none","ruby":[[2,1,"おう"],[4,1,"いか"],[7,1,"おこ"],[20,1,"たたか"],[30,1,"まち"],[32,1,"ちか"],[39,1,"かれ"],[42,2,"じょうへき"],[45,1,"うえ"],[48,1,"い"],[52,1,"し"]],"text":"もし王が怒りを起して、『あなたがたはなぜ戦おうとしてそんなに町に近づいたのか。彼らが城壁の上から射るのを知らなかったのか。"},{"ref":"2Sam.11.21","start":10011021,"end":10011021,"break":"none","ruby":[[6,1,"こ"],[13,1,"う"],[26,1,"おんな"],[28,2,"じょうへき"],[31,1,"うえ"],[34,1,"いし"],[38,2,"うわいし"],[41,1,"な"],[44,1,"かれ"],[50,1,"ころ"],[74,2,"じょうへき"],[77,1,"ちか"],[85,1,"い"],[95,1,"とき"],[120,1,"し"],[127,1,"い"]],"text":"エルベセテの子アビメレクを撃ったのはだれか。ひとりの女が城壁の上から石うすの上石を投げて彼をテベツで殺したのではなかったか。あなたがたはなぜそんなに城壁に近づいたのか』と言われたならば、その時あなたは、『あなたのしもべ、ヘテびとウリヤもまた死にました』と言いなさい」。"},{"ref":"2Sam.11.22","start":10011022,"end":10011022,"break":"paragraph","ruby":[[4,2,"ししゃ"],[7,1,"い"],[24,1,"い"],[39,1,"つ"]],"text":"こうして使者は行き、ダビデのもとにきて、ヨアブが言いつかわしたことをことごとく告げた。"},{"ref":"2Sam.11.23","start":10011023,"end":10011023,"break":"none","ruby":[[0,2,"ししゃ"],[7,1,"い"],[12,1,"てき"],[21,2,"ゆうり"],[24,2,"いち"],[27,1,"し"],[30,1,"で"],[39,1,"の"],[41,1,"せ"],[53,1,"まち"],[55,2,"いりぐち"],[59,1,"かれ"],[62,1,"お"],[64,1,"かえ"]],"text":"使者はダビデに言った、「敵はわれわれよりも有利な位置を占め、出てきてわれわれを野で攻めましたが、われわれは町の入口まで彼らを追い返しました。"},{"ref":"2Sam.11.24","start":10011024,"end":10011024,"break":"none","ruby":[[2,1,"とき"],[4,2,"しゃしゅ"],[9,2,"じょうへき"],[17,2,"けらい"],[22,1,"い"],[29,1,"おう"],[31,2,"けらい"],[36,1,"もの"],[38,1,"し"],[48,2,"けらい"],[58,1,"し"]],"text":"その時、射手どもは城壁からあなたの家来たちを射ましたので、王の家来のある者は死に、また、あなたの家来ヘテびとウリヤも死にました」。"},{"ref":"2Sam.11.25","start":10011025,"end":10011025,"break":"none","ruby":[[4,2,"ししゃ"],[7,1,"い"],[22,1,"い"],[31,1,"こと"],[33,2,"しんぱい"],[51,1,"かれ"],[54,1,"おな"],[57,1,"ほろ"],[66,1,"つよ"],[68,1,"まち"],[70,1,"せ"],[73,1,"たたか"],[79,1,"せ"],[81,1,"おと"],[96,1,"はげ"]],"text":"ダビデは使者に言った、「あなたはヨアブにこう言いなさい、『この事で心配することはない。つるぎはこれをも彼をも同じく滅ぼすからである。強く町を攻めて戦い、それを攻め落しなさい』と。そしてヨアブを励ましなさい」。"},{"ref":"2Sam.11.26","start":10011026,"end":10011026,"break":"paragraph","ruby":[[4,1,"つま"],[6,1,"おっと"],[11,1,"し"],[17,1,"き"],[21,1,"おっと"],[26,1,"かな"]],"text":"ウリヤの妻は夫ウリヤが死んだことを聞いて、夫のために悲しんだ。"},{"ref":"2Sam.11.27","start":10011027,"end":10011027,"break":"none","ruby":[[2,1,"も"],[4,1,"す"],[7,1,"とき"],[13,1,"ひと"],[20,2,"かのじょ"],[23,2,"じぶん"],[26,1,"いえ"],[28,1,"め"],[30,1,"い"],[34,2,"かのじょ"],[37,1,"かれ"],[39,1,"つま"],[44,1,"おとこ"],[46,1,"こ"],[48,1,"う"],[63,1,"こと"],[65,1,"しゅ"],[67,1,"いか"]],"text":"その喪が過ぎた時、ダビデは人をつかわして彼女を自分の家に召し入れた。彼女は彼の妻となって男の子を産んだ。しかしダビデがしたこの事は主を怒らせた。"}]