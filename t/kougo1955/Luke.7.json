[{"ref":"Luke.7.1","start":42007001,"end":42007001,"break":"paragraph","ruby":[[8,2,"ことば"],[16,2,"ひとびと"],[19,1,"き"],[36,1,"かえ"]],"text":"イエスはこれらの言葉をことごとく人々に聞かせてしまったのち、カペナウムに帰ってこられた。"},{"ref":"Luke.7.2","start":42007002,"end":42007002,"break":"none","ruby":[[7,3,"ひゃくそつちょう"],[11,1,"たの"],[18,1,"しもべ"],[21,2,"びょうき"],[27,1,"し"]],"text":"ところが、ある百卒長の頼みにしていた僕が、病気になって死にかかっていた。"},{"ref":"Luke.7.3","start":42007003,"end":42007003,"break":"none","ruby":[[2,3,"ひゃくそつちょう"],[13,1,"き"],[20,1,"じん"],[22,2,"ちょうろう"],[40,2,"じぶん"],[43,1,"しもべ"],[45,1,"たす"],[60,1,"ねが"]],"text":"この百卒長はイエスのことを聞いて、ユダヤ人の長老たちをイエスのところにつかわし、自分の僕を助けにきてくださるようにと、お願いした。"},{"ref":"Luke.7.4","start":42007004,"end":42007004,"break":"none","ruby":[[0,1,"かれ"],[14,2,"ねっしん"],[17,1,"ねが"],[20,1,"い"],[27,1,"ひと"]],"text":"彼らはイエスのところにきて、熱心に願って言った、「あの人はそうしていただくねうちがございます。"},{"ref":"Luke.7.5","start":42007005,"end":42007005,"break":"none","ruby":[[6,2,"こくみん"],[9,1,"あい"],[21,2,"かいどう"],[24,1,"た"]],"text":"わたしたちの国民を愛し、わたしたちのために会堂を建ててくれたのです」。"},{"ref":"Luke.7.6","start":42007006,"end":42007006,"break":"none","ruby":[[8,1,"かれ"],[11,1,"つ"],[17,1,"で"],[32,1,"いえ"],[37,1,"とお"],[53,3,"ひゃくそつちょう"],[57,1,"とも"],[61,1,"おく"],[68,1,"い"],[74,1,"しゅ"],[82,2,"そくろう"],[99,2,"やね"],[102,1,"した"],[109,1,"い"],[113,2,"しかく"]],"text":"そこで、イエスは彼らと連れだってお出かけになった。ところが、その家からほど遠くないあたりまでこられたとき、百卒長は友だちを送ってイエスに言わせた、「主よ、どうぞ、ご足労くださいませんように。わたしの屋根の下にあなたをお入れする資格は、わたしにはございません。"},{"ref":"Luke.7.7","start":42007007,"end":42007007,"break":"none","ruby":[[7,2,"じぶん"],[11,1,"むか"],[25,1,"おも"],[38,2,"ことば"],[41,1,"くだ"],[53,1,"しもべ"]],"text":"それですから、自分でお迎えにあがるねうちさえないと思っていたのです。ただ、お言葉を下さい。そして、わたしの僕をなおしてください。"},{"ref":"Luke.7.8","start":42007008,"end":42007008,"break":"none","ruby":[[4,2,"けんい"],[7,1,"した"],[9,1,"ふく"],[14,1,"もの"],[23,1,"した"],[26,2,"へいそつ"],[38,1,"もの"],[41,1,"い"],[45,1,"い"],[48,1,"い"],[54,1,"もの"],[61,1,"い"],[72,1,"しもべ"],[82,1,"い"]],"text":"わたしも権威の下に服している者ですが、わたしの下にも兵卒がいまして、ひとりの者に『行け』と言えば行き、ほかの者に『こい』と言えばきますし、また、僕に『これをせよ』と言えば、してくれるのです」。"},{"ref":"Luke.7.9","start":42007009,"end":42007009,"break":"none","ruby":[[7,1,"き"],[10,2,"ひじょう"],[13,2,"かんしん"],[23,2,"ぐんしゅう"],[26,1,"ほう"],[28,1,"ふ"],[30,1,"む"],[33,1,"い"],[45,1,"い"],[57,2,"しんこう"],[67,1,"なか"],[70,1,"み"]],"text":"イエスはこれを聞いて非常に感心され、ついてきた群衆の方に振り向いて言われた、「あなたがたに言っておくが、これほどの信仰は、イスラエルの中でも見たことがない」。"},{"ref":"Luke.7.10","start":42007010,"end":42007010,"break":"none","ruby":[[0,1,"つかい"],[4,1,"もの"],[8,1,"いえ"],[10,1,"かえ"],[17,1,"しもべ"],[19,2,"げんき"]],"text":"使にきた者たちが家に帰ってみると、僕は元気になっていた。"},{"ref":"Luke.7.11","start":42007011,"end":42007011,"break":"paragraph","ruby":[[5,1,"ま"],[16,1,"まち"],[27,2,"でし"],[32,1,"おお"],[36,2,"ぐんしゅう"],[39,2,"いっしょ"],[42,1,"い"]],"text":"そののち、間もなく、ナインという町へおいでになったが、弟子たちや大ぜいの群衆も一緒に行った。"},{"ref":"Luke.7.12","start":42007012,"end":42007012,"break":"none","ruby":[[0,1,"まち"],[2,1,"もん"],[4,1,"ちか"],[35,1,"もの"],[37,1,"し"],[43,1,"ほうむ"],[46,1,"だ"],[56,1,"おお"],[60,1,"まち"],[62,1,"ひと"],[69,1,"はは"]],"text":"町の門に近づかれると、ちょうど、あるやもめにとってひとりむすこであった者が死んだので、葬りに出すところであった。大ぜいの町の人たちが、その母につきそっていた。"},{"ref":"Luke.7.13","start":42007013,"end":42007013,"break":"none","ruby":[[0,1,"しゅ"],[4,2,"ふじん"],[7,1,"み"],[9,1,"ふか"],[11,2,"どうじょう"],[14,1,"よ"],[20,1,"な"],[31,1,"い"]],"text":"主はこの婦人を見て深い同情を寄せられ、「泣かないでいなさい」と言われた。"},{"ref":"Luke.7.14","start":42007014,"end":42007014,"break":"none","ruby":[[3,2,"ちかよ"],[7,1,"かん"],[9,1,"て"],[24,1,"もの"],[28,1,"た"],[30,1,"ど"],[38,2,"わかもの"],[45,1,"お"],[52,1,"い"]],"text":"そして近寄って棺に手をかけられると、かついでいる者たちが立ち止まったので、「若者よ、さあ、起きなさい」と言われた。"},{"ref":"Luke.7.15","start":42007015,"end":42007015,"break":"none","ruby":[[4,2,"しにん"],[7,1,"お"],[9,1,"あ"],[13,1,"もの"],[15,1,"い"],[17,1,"だ"],[25,1,"かれ"],[29,1,"はは"],[32,1,"わた"]],"text":"すると、死人が起き上がって物を言い出した。イエスは彼をその母にお渡しになった。"},{"ref":"Luke.7.16","start":42007016,"end":42007016,"break":"none","ruby":[[0,2,"ひとびと"],[5,1,"おそ"],[13,1,"だい"],[14,3,"よげんしゃ"],[24,1,"あいだ"],[26,1,"あらわ"],[35,1,"かみ"],[39,1,"たみ"],[41,1,"かえり"],[51,1,"い"],[55,1,"かみ"]],"text":"人々はみな恐れをいだき、「大預言者がわたしたちの間に現れた」、また、「神はその民を顧みてくださった」と言って、神をほめたたえた。"},{"ref":"Luke.7.17","start":42007017,"end":42007017,"break":"none","ruby":[[10,1,"はなし"],[16,2,"ぜんど"],[23,2,"ふきん"],[29,1,"ところ"]],"text":"イエスについてのこの話は、ユダヤ全土およびその附近のいたる所にひろまった。"},{"ref":"Luke.7.18","start":42007018,"end":42007018,"break":"paragraph","ruby":[[4,2,"でし"],[17,2,"ぜんぶ"],[19,1,"かれ"],[21,2,"ほうこく"],[33,2,"でし"],[36,1,"なか"],[43,1,"もの"],[45,1,"よ"]],"text":"ヨハネの弟子たちは、これらのことを全部彼に報告した。するとヨハネは弟子の中からふたりの者を呼んで、"},{"ref":"Luke.7.19","start":42007019,"end":42007019,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"おく"],[40,1,"ま"],[51,1,"たず"]],"text":"主のもとに送り、「『きたるべきかた』はあなたなのですか。それとも、ほかにだれかを待つべきでしょうか」と尋ねさせた。"},{"ref":"Luke.7.20","start":42007020,"end":42007020,"break":"none","ruby":[[6,1,"ひと"],[19,1,"い"],[42,1,"つかい"],[78,1,"ま"],[93,1,"たず"]],"text":"そこで、この人たちがイエスのもとにきて言った、「わたしたちはバプテスマのヨハネからの使ですが、『きたるべきかた』はあなたなのですか、それとも、ほかにだれかを待つべきでしょうか、とヨハネが尋ねています」。"},{"ref":"Luke.7.21","start":42007021,"end":42007021,"break":"none","ruby":[[14,2,"びょうく"],[17,2,"あくれい"],[21,1,"なや"],[23,2,"ひとびと"],[32,1,"おお"],[35,2,"もうじん"],[38,1,"み"]],"text":"そのとき、イエスはさまざまの病苦と悪霊とに悩む人々をいやし、また多くの盲人を見えるようにしておられたが、"},{"ref":"Luke.7.22","start":42007022,"end":42007022,"break":"none","ruby":[[0,1,"こた"],[3,1,"い"],[9,1,"い"],[19,2,"みき"],[32,2,"ほうこく"],[39,2,"もうじん"],[42,1,"み"],[45,1,"あし"],[49,1,"ある"],[54,2,"びょうにん"],[62,1,"みみ"],[66,1,"きこ"],[69,2,"しにん"],[72,1,"い"],[78,1,"まず"],[81,2,"ひとびと"],[84,2,"ふくいん"],[87,1,"き"]],"text":"答えて言われた、「行って、あなたがたが見聞きしたことを、ヨハネに報告しなさい。盲人は見え、足なえは歩き、らい病人はきよまり、耳しいは聞え、死人は生きかえり、貧しい人々は福音を聞かされている。"},{"ref":"Luke.7.23","start":42007023,"end":42007023,"break":"none","ruby":[[10,1,"もの"]],"text":"わたしにつまずかない者は、さいわいである」。"},{"ref":"Luke.7.24","start":42007024,"end":42007024,"break":"paragraph","ruby":[[4,1,"つかい"],[6,1,"い"],[25,2,"ぐんしゅう"],[28,1,"かた"],[45,1,"なに"],[47,1,"み"],[49,2,"あらの"],[52,1,"で"],[59,1,"かぜ"],[61,1,"ゆ"],[64,1,"あし"]],"text":"ヨハネの使が行ってしまうと、イエスはヨハネのことを群衆に語りはじめられた、「あなたがたは、何を見に荒野に出てきたのか。風に揺らぐ葦であるか。"},{"ref":"Luke.7.25","start":42007025,"end":42007025,"break":"none","ruby":[[3,1,"なに"],[5,1,"み"],[7,1,"で"],[14,1,"やわ"],[18,2,"きもの"],[25,1,"ひと"],[34,1,"つ"],[45,1,"くら"],[50,2,"ひとびと"],[55,2,"きゅうでん"]],"text":"では、何を見に出てきたのか。柔らかい着物をまとった人か。きらびやかに着かざって、ぜいたくに暮している人々なら、宮殿にいる。"},{"ref":"Luke.7.26","start":42007026,"end":42007026,"break":"none","ruby":[[3,1,"なに"],[5,1,"み"],[7,1,"で"],[14,3,"よげんしゃ"],[29,1,"い"],[33,3,"よげんしゃ"],[36,2,"いじょう"],[39,1,"もの"]],"text":"では、何を見に出てきたのか。預言者か。そうだ、あなたがたに言うが、預言者以上の者である。"},{"ref":"Luke.7.27","start":42007027,"end":42007027,"break":"stanza","breaks":[[21,"line"]],"ruby":[[1,1,"み"],[8,1,"つかい"],[14,1,"さき"],[25,1,"まえ"],[28,1,"みち"],[30,1,"ととの"],[41,1,"か"],[51,1,"ひと"]],"text":"『見よ、わたしは使をあなたの先につかわし、あなたの前に、道を整えさせるであろう』と書いてあるのは、この人のことである。"},{"ref":"Luke.7.28","start":42007028,"end":42007028,"break":"none","ruby":[[6,1,"い"],[12,1,"おんな"],[14,1,"う"],[17,1,"もの"],[19,1,"なか"],[27,1,"おお"],[30,2,"じんぶつ"],[41,1,"かみ"],[43,1,"くに"],[45,1,"もっと"],[47,1,"ちい"],[50,1,"もの"],[53,1,"かれ"],[57,1,"おお"]],"text":"あなたがたに言っておく。女の産んだ者の中で、ヨハネより大きい人物はいない。しかし、神の国で最も小さい者も、彼よりは大きい。"},{"ref":"Luke.7.29","start":42007029,"end":42007029,"break":"none","ruby":[[4,1,"き"],[7,2,"みんしゅう"],[10,1,"みな"],[14,3,"しゅぜいにん"],[31,1,"う"],[34,1,"かみ"],[36,1,"ただ"],[42,1,"みと"]],"text":"（これを聞いた民衆は皆、また取税人たちも、ヨハネのバプテスマを受けて神の正しいことを認めた。"},{"ref":"Luke.7.30","start":42007030,"end":42007030,"break":"none","ruby":[[8,1,"びと"],[10,2,"りっぽう"],[12,2,"がくしゃ"],[18,1,"かれ"],[27,1,"う"],[33,2,"じぶん"],[38,1,"たい"],[41,1,"かみ"],[48,1,"む"]],"text":"しかし、パリサイ人と律法学者たちとは彼からバプテスマを受けないで、自分たちに対する神のみこころを無にした。）"},{"ref":"Luke.7.31","start":42007031,"end":42007031,"break":"none","ruby":[[3,1,"いま"],[5,2,"じだい"],[8,2,"ひとびと"],[11,1,"なに"],[13,1,"くら"],[19,1,"かれ"],[22,1,"なに"],[24,1,"に"]],"text":"だから今の時代の人々を何に比べようか。彼らは何に似ているか。"},{"ref":"Luke.7.32","start":42007032,"end":42007032,"break":"none","breaks":[[23,"stanza"],[38,"line"],[54,"line"],[65,"line"]],"ruby":[[3,2,"こども"],[8,2,"ひろば"],[16,1,"たがい"],[18,1,"よ"],[30,1,"ふえ"],[32,1,"ふ"],[44,1,"おど"],[54,1,"とむら"],[57,1,"うた"],[59,1,"うた"],[65,1,"な"],[76,1,"い"],[80,1,"に"]],"text":"それは子供たちが広場にすわって、互に呼びかけ、『わたしたちが笛を吹いたのに、あなたたちは踊ってくれなかった。弔いの歌を歌ったのに、泣いてくれなかった』と言うのに似ている。"},{"ref":"Luke.7.33","start":42007033,"end":42007033,"break":"none","ruby":[[21,1,"た"],[31,1,"しゅ"],[33,1,"の"],[53,2,"あくれい"],[66,1,"い"]],"text":"なぜなら、バプテスマのヨハネがきて、パンを食べることも、ぶどう酒を飲むこともしないと、あなたがたは、あれは悪霊につかれているのだ、と言い、"},{"ref":"Luke.7.34","start":42007034,"end":42007034,"break":"none","ruby":[[2,1,"ひと"],[4,1,"こ"],[8,1,"た"],[12,1,"の"],[22,1,"み"],[28,1,"しょく"],[34,1,"もの"],[36,2,"おおざけ"],[39,1,"の"],[41,1,"もの"],[45,3,"しゅぜいにん"],[49,2,"つみびと"],[52,2,"なかま"],[57,1,"い"]],"text":"また人の子がきて食べたり飲んだりしていると、見よ、あれは食をむさぼる者、大酒を飲む者、また取税人、罪人の仲間だ、と言う。"},{"ref":"Luke.7.35","start":42007035,"end":42007035,"break":"none","ruby":[[4,2,"ちえ"],[7,1,"ただ"],[20,1,"こ"],[22,2,"しょうめい"]],"text":"しかし、知恵の正しいことは、そのすべての子が証明する」。"},{"ref":"Luke.7.36","start":42007036,"end":42007036,"break":"paragraph","ruby":[[6,1,"びと"],[13,2,"しょくじ"],[16,1,"とも"],[22,1,"もう"],[24,1,"で"],[35,1,"びと"],[37,1,"いえ"],[43,2,"しょくたく"],[46,1,"つ"]],"text":"あるパリサイ人がイエスに、食事を共にしたいと申し出たので、そのパリサイ人の家にはいって食卓に着かれた。"},{"ref":"Luke.7.37","start":42007037,"end":42007037,"break":"none","ruby":[[10,1,"まち"],[12,1,"つみ"],[14,1,"おんな"],[27,1,"びと"],[29,1,"いえ"],[31,2,"しょくたく"],[34,1,"つ"],[44,1,"き"],[48,2,"こうゆ"],[51,1,"い"],[56,2,"せっこう"],[62,1,"も"]],"text":"するとそのとき、その町で罪の女であったものが、パリサイ人の家で食卓に着いておられることを聞いて、香油が入れてある石膏のつぼを持ってきて、"},{"ref":"Luke.7.38","start":42007038,"end":42007038,"break":"none","ruby":[[0,1,"な"],[16,1,"あし"],[20,1,"よ"],[25,1,"なみだ"],[31,1,"あし"],[37,2,"じぶん"],[40,1,"かみ"],[42,1,"け"],[54,1,"あし"],[56,2,"せっぷん"],[61,2,"こうゆ"],[64,1,"ぬ"]],"text":"泣きながら、イエスのうしろでその足もとに寄り、まず涙でイエスの足をぬらし、自分の髪の毛でぬぐい、そして、その足に接吻して、香油を塗った。"},{"ref":"Luke.7.39","start":42007039,"end":42007039,"break":"none","ruby":[[4,1,"まね"],[11,1,"びと"],[16,1,"み"],[19,1,"こころ"],[21,1,"なか"],[23,1,"い"],[32,1,"ひと"],[34,3,"よげんしゃ"],[43,2,"じぶん"],[52,1,"おんな"],[62,1,"おんな"],[74,1,"つみ"],[76,1,"おんな"]],"text":"イエスを招いたパリサイ人がそれを見て、心の中で言った、「もしこの人が預言者であるなら、自分にさわっている女がだれだか、どんな女かわかるはずだ。それは罪の女なのだから」。"},{"ref":"Luke.7.40","start":42007040,"end":42007040,"break":"none","ruby":[[7,1,"かれ"],[13,1,"い"],[27,1,"い"],[36,1,"かれ"],[39,2,"せんせい"],[54,1,"い"]],"text":"そこでイエスは彼にむかって言われた、「シモン、あなたに言うことがある」。彼は「先生、おっしゃってください」と言った。"},{"ref":"Luke.7.41","start":42007041,"end":42007041,"break":"none","ruby":[[4,1,"い"],[12,2,"かねか"],[16,1,"かね"],[21,1,"ひと"],[52,1,"か"]],"text":"イエスが言われた、「ある金貸しに金をかりた人がふたりいたが、ひとりは五百デナリ、もうひとりは五十デナリを借りていた。"},{"ref":"Luke.7.42","start":42007042,"end":42007042,"break":"none","ruby":[[5,1,"かえ"],[19,1,"かれ"],[24,1,"とも"],[47,1,"かれ"],[49,1,"おお"],[51,1,"あい"]],"text":"ところが、返すことができなかったので、彼はふたり共ゆるしてやった。このふたりのうちで、どちらが彼を多く愛するだろうか」。"},{"ref":"Luke.7.43","start":42007043,"end":42007043,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[12,1,"おお"],[26,1,"おも"],[36,1,"い"],[46,2,"はんだん"],[49,1,"ただ"]],"text":"シモンが答えて言った、「多くゆるしてもらったほうだと思います」。イエスが言われた、「あなたの判断は正しい」。"},{"ref":"Luke.7.44","start":42007044,"end":42007044,"break":"none","ruby":[[4,1,"おんな"],[6,1,"ほう"],[8,1,"ふ"],[10,1,"む"],[18,1,"い"],[26,1,"おんな"],[28,1,"み"],[41,1,"いえ"],[49,1,"とき"],[56,1,"あし"],[58,1,"あら"],[60,1,"みず"],[76,1,"おんな"],[78,1,"なみだ"],[84,1,"あし"],[90,1,"かみ"],[92,1,"け"]],"text":"それから女の方に振り向いて、シモンに言われた、「この女を見ないか。わたしがあなたの家にはいってきた時に、あなたは足を洗う水をくれなかった。ところが、この女は涙でわたしの足をぬらし、髪の毛でふいてくれた。"},{"ref":"Luke.7.45","start":42007045,"end":42007045,"break":"none","ruby":[[8,2,"せっぷん"],[21,2,"かのじょ"],[28,1,"いえ"],[34,1,"とき"],[42,1,"あし"],[44,2,"せっぷん"]],"text":"あなたはわたしに接吻をしてくれなかったが、彼女はわたしが家にはいった時から、わたしの足に接吻をしてやまなかった。"},{"ref":"Luke.7.46","start":42007046,"end":42007046,"break":"none","ruby":[[8,1,"あたま"],[10,1,"あぶら"],[12,1,"ぬ"],[23,2,"かのじょ"],[30,1,"あし"],[32,2,"こうゆ"],[35,1,"ぬ"]],"text":"あなたはわたしの頭に油を塗ってくれなかったが、彼女はわたしの足に香油を塗ってくれた。"},{"ref":"Luke.7.47","start":42007047,"end":42007047,"break":"none","ruby":[[7,1,"い"],[13,1,"おんな"],[15,1,"おお"],[17,1,"あい"],[25,1,"おお"],[28,1,"つみ"],[42,1,"すこ"],[51,1,"もの"],[54,1,"すこ"],[60,1,"あい"]],"text":"それであなたに言うが、この女は多く愛したから、その多くの罪はゆるされているのである。少しだけゆるされた者は、少しだけしか愛さない」。"},{"ref":"Luke.7.48","start":42007048,"end":42007048,"break":"none","ruby":[[3,1,"おんな"],[11,1,"つみ"],[20,1,"い"]],"text":"そして女に、「あなたの罪はゆるされた」と言われた。"},{"ref":"Luke.7.49","start":42007049,"end":42007049,"break":"none","ruby":[[3,2,"どうせき"],[6,1,"もの"],[10,1,"こころ"],[12,1,"なか"],[14,1,"い"],[22,1,"つみ"],[35,1,"ひと"],[43,2,"なにもの"]],"text":"すると同席の者たちが心の中で言いはじめた、「罪をゆるすことさえするこの人は、いったい、何者だろう」。"},{"ref":"Luke.7.50","start":42007050,"end":42007050,"break":"none","ruby":[[8,1,"おんな"],[14,1,"い"],[24,2,"しんこう"],[31,1,"すく"],[38,2,"あんしん"],[42,1,"い"]],"text":"しかし、イエスは女にむかって言われた、「あなたの信仰があなたを救ったのです。安心して行きなさい」。"}]