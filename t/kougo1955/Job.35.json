[{"ref":"Job.35.1","start":18035001,"end":18035001,"break":"paragraph","ruby":[[6,1,"こた"],[9,1,"い"]],"text":"エリフはまた答えて言った、"},{"ref":"Job.35.2","start":18035002,"end":18035002,"break":"stanza","breaks":[[17,"line"]],"ruby":[[8,1,"ただ"],[12,1,"おも"],[22,1,"かみ"],[24,1,"まえ"],[26,2,"じぶん"],[29,1,"ただ"],[34,1,"い"]],"text":"「あなたはこれを正しいと思うのか、あなたは『神の前に自分は正しい』と言うのか。"},{"ref":"Job.35.3","start":18035003,"end":18035003,"break":"line","breaks":[[24,"line"],[35,"line"]],"ruby":[[4,1,"い"],[18,1,"えき"],[24,1,"つみ"],[26,1,"おか"]],"text":"あなたは言う、『これはわたしになんの益があるか、罪を犯したのとくらべてなんのまさるところがあるか』と。"},{"ref":"Job.35.4","start":18035004,"end":18035004,"break":"line","breaks":[[11,"line"]],"ruby":[[15,1,"とも"],[23,2,"ゆうじん"],[28,1,"こた"]],"text":"わたしはあなたおよび、あなたと共にいるあなたの友人たちに答えよう。"},{"ref":"Job.35.5","start":18035005,"end":18035005,"break":"line","breaks":[[7,"line"]],"ruby":[[0,1,"てん"],[2,1,"あお"],[4,1,"み"],[11,1,"うえ"],[14,1,"たか"],[16,1,"そら"],[18,1,"のぞ"],[20,1,"み"]],"text":"天を仰ぎ見よ、あなたの上なる高き空を望み見よ。"},{"ref":"Job.35.6","start":18035006,"end":18035006,"break":"line","breaks":[[11,"line"],[26,"line"]],"ruby":[[4,1,"つみ"],[6,1,"おか"],[11,1,"かれ"],[33,1,"おお"],[38,1,"かれ"],[40,1,"なに"],[44,1,"え"]],"text":"あなたが罪を犯しても、彼になんのさしさわりがあるか。あなたのとがが多くても、彼に何をなし得ようか。"},{"ref":"Job.35.7","start":18035007,"end":18035007,"break":"line","breaks":[[23,"line"]],"ruby":[[6,1,"ただ"],[12,1,"かれ"],[14,1,"なに"],[16,1,"あた"],[18,1,"え"],[23,1,"かれ"],[29,1,"て"],[32,1,"なに"],[34,1,"う"]],"text":"またあなたは正しくても、彼に何を与え得ようか。彼はあなたの手から何を受けられるであろうか。"},{"ref":"Job.35.8","start":18035008,"end":18035008,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"あく"],[15,1,"ひと"],[26,1,"ぎ"],[30,1,"ひと"],[32,1,"こ"]],"text":"あなたの悪はただあなたのような人にかかわり、あなたの義はただ人の子にかかわるのみだ。"},{"ref":"Job.35.9","start":18035009,"end":18035009,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"おお"],[10,1,"さけ"],[13,1,"ちから"],[16,1,"もの"],[18,1,"うで"],[23,1,"よ"],[27,2,"ひとびと"]],"text":"しえたげの多いために叫び、力ある者の腕のゆえに呼ばわる人々がある。"},{"ref":"Job.35.10","start":18035010,"end":18035010,"break":"line","breaks":[[17,"line"],[36,"line"]],"ruby":[[10,1,"い"],[12,1,"もの"],[20,1,"つく"],[22,1,"ぬし"],[25,1,"かみ"],[36,1,"かれ"],[38,1,"よ"],[40,1,"ま"],[42,1,"うた"],[44,1,"あた"]],"text":"しかし、ひとりとして言う者はない、『わが造り主なる神はどこにおられるか、彼は夜の間に歌を与え、"},{"ref":"Job.35.11","start":18035011,"end":18035011,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ち"],[2,1,"けもの"],[6,1,"おお"],[14,1,"おし"],[17,1,"そら"],[19,1,"とり"],[29,1,"かしこ"],[34,1,"かた"]],"text":"地の獣よりも多く、われわれを教え、空の鳥よりも、われわれを賢くされる方である』と。"},{"ref":"Job.35.12","start":18035012,"end":18035012,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[3,1,"さけ"],[7,1,"こた"],[16,1,"あ"],[19,1,"もの"],[21,1,"たか"]],"text":"彼らが叫んでも答えられないのは、悪しき者の高ぶりによる。"},{"ref":"Job.35.13","start":18035013,"end":18035013,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かみ"],[10,1,"さけ"],[13,1,"き"],[21,3,"ぜんのうしゃ"],[28,1,"かえり"]],"text":"まことに神はむなしい叫びを聞かれない。また全能者はこれを顧みられない。"},{"ref":"Job.35.14","start":18035014,"end":18035014,"break":"line","breaks":[[20,"line"],[31,"line"]],"ruby":[[4,1,"かれ"],[6,1,"み"],[10,1,"い"],[12,1,"とき"],[24,1,"かみ"],[26,1,"まえ"],[35,1,"かれ"],[37,1,"ま"]],"text":"あなたが彼を見ないと言う時はなおさらだ。さばきは神の前にある。あなたは彼を待つべきである。"},{"ref":"Job.35.15","start":18035015,"end":18035015,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"いま"],[1,1,"かれ"],[3,1,"いか"],[9,1,"ばっ"],[13,1,"つみ"],[17,1,"ふか"],[19,1,"こころ"]],"text":"今彼が怒りをもって罰せず、罪とがを深く心にとめられないゆえに"},{"ref":"Job.35.16","start":18035016,"end":18035016,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"くち"],[5,1,"ひら"],[12,1,"こと"],[14,1,"の"],[17,2,"むち"],[20,2,"ことば"]],"text":"ヨブは口を開いてむなしい事を述べ、無知の言葉をしげくする」。"}]