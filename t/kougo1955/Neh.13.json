[{"ref":"Neh.13.1","start":16013001,"end":16013001,"break":"paragraph","ruby":[[2,1,"ひ"],[7,1,"しょ"],[9,1,"よ"],[12,1,"たみ"],[14,1,"き"],[22,1,"なか"],[46,1,"かみ"],[48,1,"かい"],[70,1,"み"]],"text":"その日モーセの書を読んで民に聞かせたが、その中にアンモンびと、およびモアブびとは、いつまでも神の会に、はいってはならないとしるされているのを見いだした。"},{"ref":"Neh.13.2","start":16013002,"end":16013002,"break":"none","ruby":[[3,1,"かれ"],[13,1,"みず"],[24,2,"ひとびと"],[27,1,"むか"],[50,1,"やと"],[67,1,"かみ"],[75,1,"か"],[78,2,"しゅくふく"]],"text":"これは彼らがかつて、パンと水をもってイスラエルの人々を迎えず、かえってこれをのろわせるためにバラムを雇ったからである。しかしわれわれの神はそののろいを変えて祝福とされた。"},{"ref":"Neh.13.3","start":16013003,"end":16013003,"break":"none","ruby":[[0,2,"ひとびと"],[5,2,"りっぽう"],[8,1,"き"],[11,1,"とき"],[13,2,"こんけつ"],[16,1,"たみ"],[30,1,"わ"],[32,1,"はな"]],"text":"人々はこの律法を聞いた時、混血の民をことごとくイスラエルから分け離した。"},{"ref":"Neh.13.4","start":16013004,"end":16013004,"break":"paragraph","ruby":[[4,1,"さき"],[11,1,"かみ"],[13,1,"みや"],[26,2,"さいし"],[39,2,"えんぐみ"]],"text":"これより先、われわれの神の宮のへやをつかさどっていた祭司エリアシブは、トビヤと縁組したので、"},{"ref":"Neh.13.5","start":16013005,"end":16013005,"break":"none","ruby":[[7,1,"おお"],[13,1,"そな"],[25,2,"そさい"],[28,1,"もの"],[30,2,"にゅうこう"],[33,2,"うつわもの"],[38,2,"きてい"],[49,1,"うた"],[53,1,"もの"],[57,1,"もん"],[59,1,"まも"],[61,1,"もの"],[65,1,"あた"],[68,2,"こくもつ"],[74,1,"しゅ"],[76,1,"あぶら"],[79,1,"ぶん"],[87,2,"さいし"],[96,1,"もの"],[98,1,"お"],[101,1,"ところ"]],"text":"トビヤのために大きなへやを備えた。そのへやはもと、素祭の物、乳香、器物および規定によってレビびと、歌うたう者および門を守る者たちに与える穀物、ぶどう酒、油の十分の一、ならびに祭司のためのささげ物を置いた所である。"},{"ref":"Neh.13.6","start":16013006,"end":16013006,"break":"none","ruby":[[2,2,"とうじ"],[30,1,"おう"],[42,1,"ねん"],[44,1,"おう"],[46,1,"ところ"],[48,1,"い"],[60,1,"おう"],[66,1,"こ"]],"text":"その当時、わたしはエルサレムにいなかった。わたしはバビロンの王アルタシャスタの三十二年に王の所へ行ったが、しばらくたって王にいとまを請い、"},{"ref":"Neh.13.7","start":16013007,"end":16013007,"break":"none","ruby":[[6,1,"き"],[24,2,"あくじ"],[31,1,"かれ"],[36,1,"かみ"],[38,1,"みや"],[40,1,"にわ"],[48,1,"そな"],[54,2,"はっけん"]],"text":"エルサレムに来て、エリアシブがトビヤのためにした悪事、すなわち彼のために神の宮の庭に一つのへやを備えたことを発見した。"},{"ref":"Neh.13.8","start":16013008,"end":16013008,"break":"none","ruby":[[4,2,"ひじょう"],[7,1,"いか"],[14,1,"いえ"],[16,2,"うつわもの"],[30,1,"な"]],"text":"わたしは非常に怒り、トビヤの家の器物をことごとくそのへやから投げだし、"},{"ref":"Neh.13.9","start":16013009,"end":16013009,"break":"none","ruby":[[0,1,"めい"],[11,1,"きよ"],[19,1,"かみ"],[21,1,"みや"],[23,2,"うつわもの"],[28,2,"そさい"],[31,2,"にゅうこう"],[36,1,"ふたた"],[41,1,"たずさ"],[43,1,"い"]],"text":"命じて、すべてのへやを清めさせ、そして神の宮の器物および素祭、乳香などを再びそこに携え入れた。"},{"ref":"Neh.13.10","start":16013010,"end":16013010,"break":"paragraph","ruby":[[13,1,"う"],[17,1,"ぶん"],[19,1,"あた"],[32,1,"し"],[44,1,"つとめ"],[55,1,"うた"],[59,1,"もの"],[68,2,"じぶん"],[71,1,"はたけ"],[73,1,"に"],[75,1,"かえ"]],"text":"わたしはまたレビびとがその受くべき分を与えられていなかったことを知った。これがためにその務をなすレビびとおよび歌うたう者たちは、おのおの自分の畑に逃げ帰った。"},{"ref":"Neh.13.11","start":16013011,"end":16013011,"break":"none","ruby":[[13,1,"せ"],[16,1,"い"],[23,1,"かみ"],[25,1,"みや"],[27,1,"す"],[44,1,"まね"],[46,1,"あつ"],[52,1,"も"],[54,1,"ば"],[56,2,"ふっき"]],"text":"それでわたしはつかさたちを責めて言った、「なぜ神の宮を捨てさせたのか」。そしてレビびとを招き集めて、その持ち場に復帰させた。"},{"ref":"Neh.13.12","start":16013012,"end":16013012,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"みな"],[11,2,"こくもつ"],[17,1,"しゅ"],[19,1,"あぶら"],[22,1,"ぶん"],[26,1,"くら"],[28,1,"たずさ"]],"text":"そこでユダの人々は皆、穀物、ぶどう酒、油の十分の一を倉に携えてきた。"},{"ref":"Neh.13.13","start":16013013,"end":16013013,"break":"none","ruby":[[4,2,"さいし"],[11,2,"がくしゃ"],[27,1,"くら"],[43,1,"こ"],[49,1,"こ"],[56,2,"じょしゅ"],[61,1,"くら"],[71,1,"かれ"],[74,2,"ちゅうじつ"],[77,1,"もの"],[79,1,"おも"],[89,1,"かれ"],[92,2,"にんむ"],[95,2,"きょうだい"],[100,2,"ぶんぱい"],[104,1,"こと"]],"text":"わたしは祭司シレミヤ、学者ザドクおよびレビびとペダヤを倉のつかさとし、またマッタニヤの子ザックルの子ハナンをその助手として倉をつかさどらせた。彼らは忠実な者と思われたからである。彼らの任務は兄弟たちに分配する事であった。"},{"ref":"Neh.13.14","start":16013014,"end":16013014,"break":"none","ruby":[[2,1,"かみ"],[7,1,"こと"],[16,1,"おぼ"],[26,1,"かみ"],[28,1,"みや"],[32,1,"つと"],[42,1,"い"],[45,1,"よ"],[53,1,"さ"]],"text":"わが神よ、この事のためにわたしを覚えてください。わが神の宮とその勤めのためにわたしが行った良きわざをぬぐい去らないでください。"},{"ref":"Neh.13.15","start":16013015,"end":16013015,"break":"paragraph","ruby":[[14,3,"あんそくにち"],[18,1,"さか"],[22,1,"ふ"],[24,1,"もの"],[26,1,"むぎ"],[27,1,"たば"],[29,1,"も"],[38,1,"お"],[41,1,"もの"],[48,1,"しゅ"],[66,1,"に"],[68,3,"あんそくにち"],[78,1,"はこ"],[80,1,"い"],[83,1,"もの"],[85,1,"み"],[94,1,"かれ"],[97,2,"しょくもつ"],[100,1,"う"],[107,1,"ひ"],[109,1,"かれ"],[112,1,"いまし"]],"text":"そのころわたしはユダのうちで安息日に酒ぶねを踏む者、麦束を持ってきて、ろばに負わす者、またぶどう酒、ぶどう、いちじくおよびさまざまの荷を安息日にエルサレムに運び入れる者を見たので、わたしは彼らが食物を売っていたその日に彼らを戒めた。"},{"ref":"Neh.13.16","start":16013016,"end":16013016,"break":"none","ruby":[[3,1,"す"],[11,2,"ひとびと"],[16,1,"うお"],[25,2,"しなもの"],[28,1,"も"],[34,3,"あんそくにち"],[41,2,"ひとびと"],[44,1,"う"],[53,2,"しょうばい"]],"text":"そこに住んでいたツロの人々もまた魚およびさまざまの品物を持ってきて、安息日にユダの人々に売り、エルサレムで商売した。"},{"ref":"Neh.13.17","start":16013017,"end":16013017,"break":"none","ruby":[[10,1,"たっと"],[12,2,"ひとびと"],[15,1,"せ"],[18,1,"い"],[33,2,"あくじ"],[36,1,"い"],[40,3,"あんそくにち"],[44,1,"けが"]],"text":"そこでわたしはユダの尊い人々を責めて言った、「あなたがたはなぜこの悪事を行って、安息日を汚すのか。"},{"ref":"Neh.13.18","start":16013018,"end":16013018,"break":"none","ruby":[[6,2,"せんぞ"],[15,1,"い"],[26,1,"かみ"],[34,1,"わざわい"],[44,1,"まち"],[46,1,"くだ"],[66,3,"あんそくにち"],[70,1,"けが"],[77,1,"おお"],[81,1,"いか"],[90,1,"うえ"],[92,1,"まね"]],"text":"あなたがたの先祖も、このように行ったので、われわれの神はこのすべての災を、われわれとこの町に下されたではないか。ところがあなたがたは安息日を汚して、さらに大いなる怒りをイスラエルの上に招くのである」。"},{"ref":"Neh.13.19","start":16013019,"end":16013019,"break":"paragraph","ruby":[[3,3,"あんそくにち"],[7,1,"まえ"],[21,1,"もん"],[23,1,"くら"],[27,1,"はじ"],[30,1,"とき"],[36,1,"めい"],[45,1,"と"],[50,3,"あんそくにち"],[54,1,"おわ"],[61,1,"ひら"],[70,1,"めい"],[80,2,"すうにん"],[83,1,"もん"],[85,1,"お"],[89,3,"あんそくにち"],[93,1,"に"],[95,1,"たずさ"],[97,1,"い"]],"text":"そこで安息日の前に、エルサレムのもろもろの門が暗くなり始めた時、わたしは命じてそのとびらを閉じさせ、安息日が終るまでこれを開いてはならないと命じ、わたしのしもべ数人を門に置いて、安息日に荷を携え入れさせないようにした。"},{"ref":"Neh.13.20","start":16013020,"end":16013020,"break":"none","ruby":[[7,2,"しょうにん"],[17,2,"しなもの"],[20,1,"う"],[22,1,"もの"],[29,1,"かい"],[36,1,"そと"],[38,1,"やど"]],"text":"これがために、商人およびさまざまの品物を売る者どもは一、二回エルサレムの外に宿った。"},{"ref":"Neh.13.21","start":16013021,"end":16013021,"break":"none","ruby":[[4,1,"かれ"],[7,1,"いまし"],[10,1,"い"],[23,2,"じょうへき"],[26,1,"まえ"],[28,1,"やど"],[41,1,"かさ"],[68,1,"しょ"],[69,1,"ばっ"],[79,2,"いらい"],[82,1,"かれ"],[85,3,"あんそくにち"]],"text":"わたしは彼らを戒めて言った、「あなたがたはなぜ城壁の前に宿るのか。もしあなたがたが重ねてそのようなことをするならば、わたしはあなたがたを処罰する」と。そのとき以来、彼らは安息日にはこなかった。"},{"ref":"Neh.13.22","start":16013022,"end":16013022,"break":"none","ruby":[[11,1,"めい"],[17,1,"み"],[19,1,"きよ"],[24,1,"き"],[26,1,"もん"],[28,1,"まも"],[33,3,"あんそくにち"],[37,2,"せいべつ"],[44,1,"かみ"],[62,1,"おぼ"],[69,1,"おお"]],"text":"わたしはまたレビびとに命じて、その身を清めさせ、来て門を守らせて、安息日を聖別した。わが神よ、わたしのためにまた、このことを覚え、あなたの大いなるいつくしみをもって、わたしをあわれんでください。"},{"ref":"Neh.13.23","start":16013023,"end":16013023,"break":"paragraph","ruby":[[25,1,"おんな"],[34,1,"ひと"],[36,1,"み"]],"text":"そのころまた、わたしはアシドド、アンモン、モアブの女をめとったユダヤ人を見た。"},{"ref":"Neh.13.24","start":16013024,"end":16013024,"break":"none","ruby":[[0,1,"かれ"],[3,2,"こども"],[6,2,"はんぶん"],[14,2,"ことば"],[17,1,"かた"],[25,2,"ことば"],[28,1,"かた"],[43,2,"ははおや"],[46,1,"で"],[48,1,"たみ"],[50,2,"ことば"],[53,1,"かた"]],"text":"彼らの子供の半分はアシドドの言葉を語って、ユダヤの言葉を語ることができず、おのおのその母親の出た民の言葉を語った。"},{"ref":"Neh.13.25","start":16013025,"end":16013025,"break":"none","ruby":[[4,1,"かれ"],[7,1,"せ"],[22,2,"すうにん"],[25,1,"う"],[31,1,"け"],[33,1,"ぬ"],[36,1,"かみ"],[38,1,"な"],[43,1,"ちか"],[47,1,"い"],[58,1,"かれ"],[65,2,"じぶん"],[68,1,"むすめ"],[70,1,"あた"],[99,2,"じしん"],[105,1,"かれ"],[108,1,"むすめ"]],"text":"わたしは彼らを責め、またののしり、そのうちの数人を撃って、その毛を抜き、神の名をさして誓わせて言った、「あなたがたは彼らのむすこに自分の娘を与えてはならない。またあなたがたのむすこ、またはあなたがた自身のために彼らの娘をめとってはならない。"},{"ref":"Neh.13.26","start":16013026,"end":16013026,"break":"none","ruby":[[6,1,"おう"],[22,1,"つみ"],[24,1,"おか"],[33,1,"かれ"],[38,1,"おう"],[40,1,"おお"],[43,2,"こくみん"],[53,1,"かみ"],[55,1,"あい"],[60,1,"もの"],[65,1,"かみ"],[67,1,"かれ"],[74,2,"ぜんこく"],[77,1,"おう"],[88,2,"いほう"],[91,1,"おんな"],[95,1,"かれ"],[97,1,"つみ"],[99,1,"おか"]],"text":"イスラエルの王ソロモンはこれらのことによって罪を犯したではないか。彼のような王は多くの国民のうちにもなく、神に愛せられた者である。神は彼をイスラエル全国の王とせられた。ところが異邦の女たちは彼に罪を犯させた。"},{"ref":"Neh.13.27","start":16013027,"end":16013027,"break":"none","ruby":[[10,2,"いほう"],[13,1,"おんな"],[25,1,"おお"],[29,1,"あく"],[31,1,"い"],[40,1,"かみ"],[42,1,"つみ"],[44,1,"おか"],[54,1,"き"],[56,1,"なが"]],"text":"それゆえあなたがたが異邦の女をめとり、このすべての大いなる悪を行って、われわれの神に罪を犯すのを、われわれは聞き流しにしておけようか」。"},{"ref":"Neh.13.28","start":16013028,"end":16013028,"break":"paragraph","ruby":[[0,1,"だい"],[1,2,"さいし"],[9,1,"こ"],[19,1,"こ"],[32,1,"むこ"],[44,1,"かれ"],[55,1,"お"],[57,1,"だ"]],"text":"大祭司エリアシブの子ヨイアダのひとりの子はホロニびとサンバラテの婿であったので、わたしは彼をわたしのところから追い出した。"},{"ref":"Neh.13.29","start":16013029,"end":16013029,"break":"none","ruby":[[2,1,"かみ"],[5,1,"かれ"],[11,1,"おぼ"],[19,1,"かれ"],[22,2,"さいし"],[25,1,"しょく"],[27,1,"けが"],[32,2,"さいし"],[42,2,"けいやく"],[45,1,"けが"]],"text":"わが神よ、彼らのことを覚えてください。彼らは祭司の職を汚し、また祭司およびレビびとの契約を汚しました。"},{"ref":"Neh.13.30","start":16013030,"end":16013030,"break":"paragraph","ruby":[[10,1,"かれ"],[13,1,"きよ"],[17,2,"いほう"],[28,1,"す"],[33,2,"さいし"],[43,1,"つとめ"],[45,1,"さだ"]],"text":"このように、わたしは彼らを清めて、異邦のものをことごとく捨てさせ、祭司およびレビびとの務を定めて、おのおのそのわざにつかせた。"},{"ref":"Neh.13.31","start":16013031,"end":16013031,"break":"none","ruby":[[2,1,"さだ"],[7,1,"とき"],[14,1,"そな"],[16,1,"もの"],[26,2,"はつもの"],[38,1,"かみ"],[45,1,"おぼ"],[53,1,"めぐ"]],"text":"また定められた時に、たきぎの供え物をささげさせ、また初物をささげさせた。わが神よ、わたしを覚え、わたしをお恵みください。"}]