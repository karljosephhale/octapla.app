[{"ref":"Job.18.1","start":18018001,"end":18018001,"break":"paragraph","ruby":[[13,1,"こた"],[16,1,"い"]],"text":"そこでシュヒびとビルダデは答えて言った、"},{"ref":"Job.18.2","start":18018002,"end":18018002,"break":"stanza","breaks":[[21,"line"],[33,"line"]],"ruby":[[9,2,"ことば"],[15,1,"もう"],[27,1,"さと"],[42,1,"ろん"]],"text":"「あなたはいつまで言葉にわなを設けるのか。あなたはまず悟るがよい、それからわれわれは論じよう。"},{"ref":"Job.18.3","start":18018003,"end":18018003,"break":"line","breaks":[[20,"line"]],"ruby":[[8,1,"けもの"],[13,1,"おも"],[27,1,"め"],[29,1,"おろ"],[32,1,"もの"],[34,1,"み"]],"text":"なぜ、われわれは獣のように思われるのか。なぜ、あなたの目に愚かな者と見えるのか。"},{"ref":"Job.18.4","start":18018004,"end":18018004,"break":"line","breaks":[[13,"line"],[32,"line"]],"ruby":[[0,1,"いか"],[6,1,"み"],[8,1,"さ"],[10,1,"もの"],[20,1,"ち"],[22,1,"す"],[32,1,"いわ"],[36,1,"ところ"],[39,1,"うつ"]],"text":"怒っておのが身を裂く者よ、あなたのために地は捨てられるだろうか。岩はその所から移されるだろうか。"},{"ref":"Job.18.5","start":18018005,"end":18018005,"break":"stanza","breaks":[[10,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"ひかり"],[7,1,"き"],[12,1,"ひ"],[14,1,"ほのお"],[16,1,"ひかり"],[18,1,"はな"]],"text":"悪しき者の光は消え、その火の炎は光を放たず、"},{"ref":"Job.18.6","start":18018006,"end":18018006,"break":"line","breaks":[[13,"line"]],"ruby":[[2,2,"てんまく"],[8,1,"ひかり"],[10,1,"くら"],[13,1,"かれ"],[15,1,"うえ"],[22,1,"き"]],"text":"その天幕のうちの光は暗く、彼の上のともしびは消える。"},{"ref":"Job.18.7","start":18018007,"end":18018007,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"ちから"],[5,1,"あゆ"],[16,1,"はか"],[21,1,"かれ"],[23,1,"たお"]],"text":"その力ある歩みはせばめられ、その計りごとは彼を倒す。"},{"ref":"Job.18.8","start":18018008,"end":18018008,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[2,2,"じぶん"],[5,1,"あし"],[7,1,"あみ"],[15,1,"おと"],[17,1,"あな"],[19,1,"うえ"],[21,1,"あゆ"]],"text":"彼は自分の足で網にかかり、また落し穴の上を歩む。"},{"ref":"Job.18.9","start":18018009,"end":18018009,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"かれ"],[9,1,"とら"],[12,1,"あみ"],[16,1,"かれ"],[18,1,"とら"]],"text":"わなは彼のかかとを捕え、網わなは彼を捕える。"},{"ref":"Job.18.10","start":18018010,"end":18018010,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"わ"],[4,1,"かれ"],[6,1,"とら"],[12,1,"ち"],[14,1,"かく"],[18,1,"は"],[20,1,"あみ"],[22,1,"かれ"],[24,1,"とら"],[30,1,"みち"],[32,1,"もう"]],"text":"輪なわは彼を捕えるために地に隠され、張り網は彼を捕えるために道に設けられる。"},{"ref":"Job.18.11","start":18018011,"end":18018011,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"おそ"],[4,1,"こと"],[6,2,"しほう"],[12,1,"かれ"],[14,1,"おそ"],[21,1,"あゆ"],[29,1,"かれ"],[31,1,"お"]],"text":"恐ろしい事が四方にあって彼を恐れさせ、その歩みにしたがって彼を追う。"},{"ref":"Job.18.12","start":18018012,"end":18018012,"break":"line","breaks":[[7,"line"]],"ruby":[[2,1,"ちから"],[4,1,"う"],[7,1,"わざわい"],[9,1,"かれ"],[19,1,"そな"]],"text":"その力は飢え、災は彼をつまずかすために備わっている。"},{"ref":"Job.18.13","start":18018013,"end":18018013,"break":"line","breaks":[[17,"line"]],"ruby":[[2,2,"ひふ"],[5,1,"やまい"],[10,1,"く"],[17,1,"し"],[23,1,"かれ"],[25,2,"てあし"],[28,1,"く"]],"text":"その皮膚は病によって食いつくされ、死のういごは彼の手足を食いつくす。"},{"ref":"Job.18.14","start":18018014,"end":18018014,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[4,1,"たの"],[6,1,"ところ"],[8,2,"てんまく"],[12,1,"ひ"],[14,1,"はな"],[19,1,"おそ"],[22,1,"おう"],[27,1,"お"]],"text":"彼はその頼む所の天幕から引き離されて、恐れの王のもとに追いやられる。"},{"ref":"Job.18.15","start":18018015,"end":18018015,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ぞく"],[6,1,"もの"],[8,1,"かれ"],[10,2,"てんまく"],[13,1,"す"],[16,2,"いおう"],[19,1,"かれ"],[25,1,"うえ"],[29,1,"ち"]],"text":"彼に属さない者が彼の天幕に住み、硫黄が彼のすまいの上にまき散らされる。"},{"ref":"Job.18.16","start":18018016,"end":18018016,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"した"],[5,1,"ね"],[7,1,"か"],[10,1,"うえ"],[15,1,"えだ"],[17,1,"き"]],"text":"下ではその根が枯れ、上ではその枝が切られる。"},{"ref":"Job.18.17","start":18018017,"end":18018017,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[2,2,"かたみ"],[5,1,"ち"],[8,1,"ほろ"],[11,1,"かれ"],[13,1,"な"],[19,1,"き"]],"text":"彼の形見は地から滅び、彼の名はちまたに消える。"},{"ref":"Job.18.18","start":18018018,"end":18018018,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ひかり"],[8,1,"お"],[14,1,"よ"],[16,1,"なか"],[19,1,"お"],[21,1,"だ"]],"text":"彼は光からやみに追いやられ、世の中から追い出される。"},{"ref":"Job.18.19","start":18018019,"end":18018019,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[4,1,"たみ"],[6,1,"なか"],[8,1,"こ"],[13,1,"まご"],[18,1,"かれ"],[30,1,"い"],[32,1,"のこ"],[34,1,"もの"]],"text":"彼はその民の中に子もなく、孫もなく、彼のすみかには、ひとりも生き残る者はない。"},{"ref":"Job.18.20","start":18018020,"end":18018020,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"にし"],[2,1,"もの"],[4,1,"かれ"],[6,1,"ひ"],[11,1,"おどろ"],[14,1,"ひがし"],[16,1,"もの"],[20,1,"おそ"]],"text":"西の者は彼の日について驚き、東の者はおじ恐れる。"},{"ref":"Job.18.21","start":18018021,"end":18018021,"break":"line","breaks":[[22,"line"]],"ruby":[[5,1,"あ"],[8,1,"もの"],[22,1,"かみ"],[24,1,"し"],[28,1,"もの"],[30,1,"ところ"]],"text":"まことに、悪しき者のすまいはこのようであり、神を知らない者の所はこのようである」。"}]