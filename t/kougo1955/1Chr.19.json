[{"ref":"1Chr.19.1","start":13019001,"end":13019001,"break":"paragraph","ruby":[[2,1,"のち"],[8,2,"ひとびと"],[11,1,"おう"],[16,1,"し"],[22,1,"こ"],[27,1,"かわ"],[30,1,"おう"]],"text":"この後アンモンの人々の王ナハシが死んで、その子がこれに代って王となった。"},{"ref":"1Chr.19.2","start":13019002,"end":13019002,"break":"none","ruby":[[8,1,"い"],[21,1,"こ"],[27,1,"かれ"],[29,1,"ちち"],[35,1,"めぐ"],[38,1,"ほどこ"],[45,1,"めぐ"],[48,1,"ほどこ"],[60,1,"かれ"],[64,1,"ちち"],[69,1,"なぐさ"],[76,2,"ししゃ"],[99,1,"なぐさ"],[109,2,"ひとびと"],[112,1,"ち"],[114,1,"き"]],"text":"そのときダビデは言った、「わたしはナハシの子ハヌンに、彼の父がわたしに恵みを施したように、恵みを施そう」。そしてダビデは彼をその父のゆえに慰めようとして使者をつかわした。ダビデのしもべたちはハヌンを慰めるためアンモンの人々の地に来たが、"},{"ref":"1Chr.19.3","start":13019003,"end":13019003,"break":"none","ruby":[[5,2,"ひとびと"],[18,1,"い"],[27,1,"なぐさ"],[30,1,"もの"],[55,1,"かれ"],[61,1,"ちち"],[63,1,"たっと"],[68,1,"おも"],[75,1,"かれ"],[83,1,"き"],[90,1,"くに"],[97,1,"さぐ"],[100,1,"ほろ"]],"text":"アンモンの人々のつかさたちはハヌンに言った、「ダビデが慰める者をあなたのもとにつかわしたことによって、あなたは彼があなたの父を尊ぶのだと思われますか。彼のしもべたちが来たのは、この国をうかがい、探って滅ぼすためではありませんか」。"},{"ref":"1Chr.19.4","start":13019004,"end":13019004,"break":"none","ruby":[[17,1,"とら"],[28,1,"おと"],[33,2,"きもの"],[36,1,"なか"],[41,1,"た"],[43,1,"き"],[46,1,"こし"],[48,1,"ところ"],[54,1,"かれ"],[57,1,"かえ"]],"text":"そこでハヌンはダビデのしもべたちを捕えて、そのひげをそり落し、その着物を中ほどから断ち切って腰の所までにして彼らを帰してやった。"},{"ref":"1Chr.19.5","start":13019005,"end":13019005,"break":"none","ruby":[[2,2,"ひとびと"],[5,1,"き"],[10,1,"ひと"],[24,1,"つ"],[30,1,"かれ"],[32,1,"ひと"],[40,1,"かれ"],[43,1,"むか"],[51,2,"ひとびと"],[54,2,"ひじょう"],[57,1,"は"],[69,1,"おう"],[71,1,"い"],[96,1,"のち"],[97,1,"かえ"]],"text":"ある人々が来て、この人たちのされたことをダビデに告げたので、彼は人をつかわして、彼らを迎えさせた。その人々が非常に恥じたからである。そこで王は言った、「ひげがのびるまでエリコにとどまって、その後帰りなさい」。"},{"ref":"1Chr.19.6","start":13019006,"end":13019006,"break":"paragraph","ruby":[[5,2,"ひとびと"],[8,2,"じぶん"],[17,1,"にく"],[45,2,"ひとびと"],[48,1,"ぎん"],[55,1,"おく"],[80,2,"せんしゃ"],[83,2,"きへい"],[86,1,"やと"],[88,1,"い"]],"text":"アンモンの人々は自分たちがダビデに憎まれることをしたとわかったので、ハヌンおよびアンモンの人々は銀千タラントを送ってメソポタミヤとアラム・マアカ、およびゾバから戦車と騎兵を雇い入れた。"},{"ref":"1Chr.19.7","start":13019007,"end":13019007,"break":"none","ruby":[[4,2,"せんしゃ"],[17,1,"おう"],[21,2,"ぐんたい"],[24,1,"やと"],[26,1,"い"],[32,1,"かれ"],[35,1,"き"],[41,1,"まえ"],[43,1,"じん"],[45,1,"は"],[57,2,"ひとびと"],[60,2,"まちまち"],[64,1,"よ"],[66,1,"あつ"],[71,1,"たたか"],[74,2,"しゅつどう"]],"text":"すなわち戦車三万二千およびマアカの王とその軍隊を雇い入れたので、彼らは来てメデバの前に陣を張った。そこでアンモンの人々は町々から寄り集まって、戦いに出動した。"},{"ref":"1Chr.19.8","start":13019008,"end":13019008,"break":"none","ruby":[[7,1,"き"],[14,2,"ゆうし"],[17,1,"ぜん"],[18,1,"ぐん"]],"text":"ダビデはこれを聞いてヨアブと勇士の全軍をつかわしたので、"},{"ref":"1Chr.19.9","start":13019009,"end":13019009,"break":"none","ruby":[[5,2,"ひとびと"],[8,1,"で"],[10,1,"き"],[12,1,"まち"],[14,2,"いりぐち"],[17,1,"たたか"],[20,1,"そな"],[28,1,"たす"],[31,1,"き"],[33,1,"おう"],[37,1,"べつ"],[39,1,"の"]],"text":"アンモンの人々は出て来て町の入口に戦いの備えをした。また助けに来た王たちは別に野にいた。"},{"ref":"1Chr.19.10","start":13019010,"end":13019010,"break":"paragraph","ruby":[[0,1,"とき"],[6,1,"たたか"],[9,2,"ぜんご"],[13,2,"じぶん"],[16,1,"む"],[24,1,"み"],[35,1,"ぬ"],[38,2,"へいし"],[45,1,"えら"],[58,1,"たい"],[61,1,"そな"]],"text":"時にヨアブは戦いが前後から自分に向かっているのを見て、イスラエルのえり抜きの兵士のうちから選んで、これをスリヤびとに対して備え、"},{"ref":"1Chr.19.11","start":13019011,"end":13019011,"break":"none","ruby":[[5,1,"たみ"],[7,2,"じぶん"],[10,2,"きょうだい"],[18,1,"て"],[30,2,"ひとびと"],[33,1,"たい"],[36,1,"そな"]],"text":"そのほかの民を自分の兄弟アビシャイの手にわたして、アンモンの人々に対して備えさせ、"},{"ref":"1Chr.19.12","start":13019012,"end":13019012,"break":"none","ruby":[[3,1,"い"],[20,1,"て"],[32,1,"たす"],[47,2,"ひとびと"],[54,1,"て"],[66,1,"たす"]],"text":"そして言った、「もしスリヤびとがわたしに手ごわいときは、わたしを助けてください。もしアンモンの人々があなたに手ごわいときは、あなたを助けましょう。"},{"ref":"1Chr.19.13","start":13019013,"end":13019013,"break":"none","ruby":[[0,1,"いさ"],[16,1,"たみ"],[27,1,"かみ"],[29,2,"まちまち"],[36,1,"いさ"],[50,1,"しゅ"],[52,1,"よ"],[55,1,"おも"]],"text":"勇ましくしてください。われわれの民のためと、われわれの神の町々のために、勇ましくしましょう。どうか、主が良いと思われることをされるように」。"},{"ref":"1Chr.19.14","start":13019014,"end":13019014,"break":"none","ruby":[[8,2,"じぶん"],[11,2,"いっしょ"],[16,1,"たみ"],[18,1,"とも"],[26,1,"む"],[30,1,"たたか"],[36,1,"ちか"],[49,1,"かれ"],[51,1,"まえ"],[54,1,"に"]],"text":"こうしてヨアブが自分と一緒にいる民と共にスリヤびとに向かって戦おうとして近づいたとき、スリヤびとは彼の前から逃げた。"},{"ref":"1Chr.19.15","start":13019015,"end":13019015,"break":"none","ruby":[[5,2,"ひとびと"],[14,1,"に"],[19,1,"み"],[22,1,"かれ"],[31,2,"きょうだい"],[39,1,"まえ"],[42,1,"に"],[45,1,"まち"],[65,1,"かえ"]],"text":"アンモンの人々はスリヤびとの逃げるのを見て、彼らもまたヨアブの兄弟アビシャイの前から逃げて町にはいった。そこでヨアブはエルサレムに帰った。"},{"ref":"1Chr.19.16","start":13019016,"end":13019016,"break":"paragraph","ruby":[[9,2,"じぶん"],[20,1,"まえ"],[22,1,"う"],[24,1,"やぶ"],[30,1,"み"],[33,2,"ししゃ"],[47,1,"ぐん"],[49,1,"ちょう"],[55,1,"ひき"],[62,1,"かわ"],[64,1,"む"],[67,1,"がわ"],[77,1,"ひ"],[79,1,"だ"]],"text":"しかしスリヤびとは自分たちがイスラエルの前に打ち敗られたのを見て、使者をつかわし、ハダデゼルの軍の長ショパクの率いるユフラテ川の向こう側にいるスリヤびとを引き出した。"},{"ref":"1Chr.19.17","start":13019017,"end":13019017,"break":"none","ruby":[[2,1,"こと"],[8,1,"きこ"],[14,1,"かれ"],[27,1,"あつ"],[35,1,"わた"],[38,1,"かれ"],[41,1,"ところ"],[43,1,"き"],[49,1,"む"],[53,1,"たたか"],[56,1,"そな"],[77,1,"たい"],[80,1,"たたか"],[83,1,"そな"],[91,1,"かれ"],[97,1,"たたか"]],"text":"この事がダビデに聞えたので、彼はイスラエルをことごとく集め、ヨルダンを渡り、彼らの所に来て、これに向かって戦いの備えをした。ダビデがこのようにスリヤびとに対して戦いの備えをしたとき、彼はダビデと戦った。"},{"ref":"1Chr.19.18","start":13019018,"end":13019018,"break":"none","ruby":[[15,1,"まえ"],[18,1,"に"],[34,2,"せんしゃ"],[37,1,"へい"],[41,2,"ほへい"],[46,1,"ころ"],[51,1,"ぐん"],[53,1,"ちょう"],[60,1,"ころ"]],"text":"しかしスリヤびとがイスラエルの前から逃げたので、ダビデはスリヤびとの戦車の兵七千、歩兵四万を殺し、また軍の長ショパクをも殺した。"},{"ref":"1Chr.19.19","start":13019019,"end":13019019,"break":"none","ruby":[[12,2,"みかた"],[15,1,"もの"],[23,1,"う"],[25,1,"やぶ"],[31,1,"み"],[38,1,"わ"],[40,1,"こう"],[43,1,"かれ"],[45,1,"つか"],[55,1,"ふたた"],[64,1,"たす"]],"text":"ハダデゼルのしもべたちは味方の者がイスラエルに打ち敗られたのを見て、ダビデと和を講じ、彼に仕えた。スリヤびとは再びアンモンびとを助けることをしなかった。"}]