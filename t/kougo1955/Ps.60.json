[{"ref":"Ps.60.1","start":19060001,"end":19060001,"break":"paragraph","title":"聖歌隊の指揮者によって、「あかしのゆり」というしらべにあわせて教のためにうたわせたダビデのミクタムの歌。これはダビデが、アラムナハライムおよびアラムゾバと戦ったとき、ヨアブがその帰りに、塩の谷でエドムびと一万二千人を殺したときによんだもの","breaks":[[14,"line"],[27,"line"],[38,"line"]],"ruby":[[0,1,"かみ"],[11,1,"す"],[18,1,"う"],[20,1,"やぶ"],[31,1,"いきどお"],[38,1,"ふたた"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[31,1,"おしえ"],[50,1,"うた"],[77,1,"たたか"],[89,1,"かえ"],[93,1,"しお"],[95,1,"たに"],[106,1,"にん"],[108,1,"ころ"]],"text":"神よ、あなたはわれらを捨て、われらを打ち破られました。あなたは憤られました。再びわれらをかえしてください。"},{"ref":"Ps.60.2","start":19060002,"end":19060002,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[4,1,"くに"],[6,1,"ふる"],[13,1,"さ"],[22,1,"やぶ"],[34,1,"くに"],[36,1,"ゆ"],[38,1,"うご"]],"text":"あなたは国を震わせ、これを裂かれました。その破れをいやしてください。国が揺れ動くのです。"},{"ref":"Ps.60.3","start":19060003,"end":19060003,"break":"line","breaks":[[18,"line"]],"ruby":[[6,1,"たみ"],[8,1,"た"],[13,1,"こと"],[18,1,"ひと"],[25,1,"さけ"],[31,1,"の"]],"text":"あなたはその民に耐えがたい事をさせ、人をよろめかす酒をわれらに飲ませられました。"},{"ref":"Ps.60.4","start":19060004,"end":19060004,"break":"line","breaks":[[22,"line"],[34,"line"]],"ruby":[[4,1,"ゆみ"],[6,1,"まえ"],[13,1,"もの"],[15,1,"ふたた"],[17,1,"あつ"],[26,1,"おそ"],[29,1,"もの"],[37,1,"はた"],[39,1,"た"]],"text":"あなたは弓の前からのがれた者を再び集めようとあなたを恐れる者のために一つの旗を立てられました。〔セラ"},{"ref":"Ps.60.5","start":19060005,"end":19060005,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[4,1,"あい"],[8,1,"もの"],[10,1,"たす"],[13,1,"え"],[19,1,"みぎ"],[21,1,"て"],[26,2,"しょうり"],[29,1,"あた"],[36,1,"こた"]],"text":"あなたの愛される者が助けを得るために、右の手をもって勝利を与え、われらに答えてください。"},{"ref":"Ps.60.6","start":19060006,"end":19060006,"break":"line","breaks":[[12,"line"],[35,"line"]],"ruby":[[0,1,"かみ"],[4,2,"せいじょ"],[7,1,"い"],[17,1,"おお"],[21,1,"よろこ"],[31,1,"わ"],[39,1,"たに"],[41,1,"わ"],[44,1,"あた"]],"text":"神はその聖所で言われた、「わたしは大いなる喜びをもってシケムを分かち、スコテの谷を分かち与えよう。"},{"ref":"Ps.60.7","start":19060007,"end":19060007,"break":"line","breaks":[[12,"line"],[26,"line"],[40,"line"]],"text":"ギレアデはわたしのもの、マナセもわたしのものである。エフライムはわたしのかぶと、ユダはわたしのつえである。"},{"ref":"Ps.60.8","start":19060008,"end":19060008,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[8,1,"あし"],[25,1,"な"]],"text":"モアブはわたしの足だらい、エドムにはわたしのくつを投げる。ペリシテについては、かちどきをあげる」と。"},{"ref":"Ps.60.9","start":19060009,"end":19060009,"break":"line","breaks":[[22,"line"]],"ruby":[[7,2,"けんご"],[10,1,"まち"],[12,1,"いた"],[33,1,"みちび"]],"text":"だれがわたしを堅固な町に至らせるでしょうか。だれがわたしをエドムに導くでしょうか。"},{"ref":"Ps.60.10","start":19060010,"end":19060010,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"かみ"],[11,1,"す"],[25,1,"かみ"],[36,2,"ぐんぜい"],[39,1,"とも"],[41,1,"で"],[43,1,"い"]],"text":"神よ、あなたはわれらを捨てられたではありませんか。神よ、あなたはわれらの軍勢と共に出て行かれません。"},{"ref":"Ps.60.11","start":19060011,"end":19060011,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"たす"],[7,1,"あた"],[24,1,"ひと"],[26,1,"たす"]],"text":"われらに助けを与えて、あだにむかわせてください。人の助けはむなしいのです。"},{"ref":"Ps.60.12","start":19060012,"end":19060012,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"かみ"],[9,1,"いさ"],[13,1,"はたら"],[25,1,"ふ"],[30,1,"もの"],[32,1,"かみ"]],"text":"われらは神によって勇ましく働きます。われらのあだを踏みにじる者は神だからです。"}]