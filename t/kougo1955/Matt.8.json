[{"ref":"Matt.8.1","start":40008001,"end":40008001,"break":"paragraph","ruby":[[4,1,"やま"],[7,1,"お"],[20,2,"ぐんしゅう"]],"text":"イエスが山をお降りになると、おびただしい群衆がついてきた。"},{"ref":"Matt.8.2","start":40008002,"end":40008002,"break":"none","ruby":[[15,2,"びょうにん"],[31,1,"ふ"],[34,1,"い"],[39,1,"しゅ"]],"text":"すると、そのとき、ひとりのらい病人がイエスのところにきて、ひれ伏して言った、「主よ、みこころでしたら、きよめていただけるのですが」。"},{"ref":"Matt.8.3","start":40008003,"end":40008003,"break":"none","ruby":[[4,1,"て"],[6,1,"の"],[11,1,"かれ"],[34,1,"い"],[45,1,"びょう"],[47,1,"ただ"]],"text":"イエスは手を伸ばして、彼にさわり、「そうしてあげよう、きよくなれ」と言われた。すると、らい病は直ちにきよめられた。"},{"ref":"Matt.8.4","start":40008004,"end":40008004,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[16,1,"はな"],[24,2,"ちゅうい"],[33,1,"い"],[37,2,"じぶん"],[44,2,"さいし"],[47,1,"み"],[59,1,"めい"],[62,1,"そな"],[64,1,"もの"],[71,2,"ひとびと"],[74,2,"しょうめい"]],"text":"イエスは彼に言われた、「だれにも話さないように、注意しなさい。ただ行って、自分のからだを祭司に見せ、それから、モーセが命じた供え物をささげて、人々に証明しなさい」。"},{"ref":"Matt.8.5","start":40008005,"end":40008005,"break":"paragraph","ruby":[[13,1,"かえ"],[25,3,"ひゃくそつちょう"],[35,1,"うった"],[38,1,"い"]],"text":"さて、イエスがカペナウムに帰ってこられたとき、ある百卒長がみもとにきて訴えて言った、"},{"ref":"Matt.8.6","start":40008006,"end":40008006,"break":"none","ruby":[[1,1,"しゅ"],[8,1,"しもべ"],[10,2,"ちゅうぶ"],[16,1,"くる"],[21,1,"いえ"],[23,1,"ね"]],"text":"「主よ、わたしの僕が中風でひどく苦しんで、家に寝ています」。"},{"ref":"Matt.8.7","start":40008007,"end":40008007,"break":"none","ruby":[[4,1,"かれ"],[12,1,"い"],[25,1,"い"]],"text":"イエスは彼に、「わたしが行ってなおしてあげよう」と言われた。"},{"ref":"Matt.8.8","start":40008008,"end":40008008,"break":"none","ruby":[[3,3,"ひゃくそつちょう"],[7,1,"こた"],[10,1,"い"],[15,1,"しゅ"],[22,2,"やね"],[25,1,"した"],[32,1,"い"],[36,2,"しかく"],[56,2,"ことば"],[59,1,"くだ"],[68,1,"しもべ"]],"text":"そこで百卒長は答えて言った、「主よ、わたしの屋根の下にあなたをお入れする資格は、わたしにはございません。ただ、お言葉を下さい。そうすれば僕はなおります。"},{"ref":"Matt.8.9","start":40008009,"end":40008009,"break":"none","ruby":[[4,2,"けんい"],[7,1,"した"],[11,1,"もの"],[20,1,"した"],[23,2,"へいそつ"],[35,1,"もの"],[38,1,"い"],[42,1,"い"],[45,1,"い"],[51,1,"もの"],[58,1,"い"],[69,1,"しもべ"],[79,1,"い"]],"text":"わたしも権威の下にある者ですが、わたしの下にも兵卒がいまして、ひとりの者に『行け』と言えば行き、ほかの者に『こい』と言えばきますし、また、僕に『これをせよ』と言えば、してくれるのです」。"},{"ref":"Matt.8.10","start":40008010,"end":40008010,"break":"none","ruby":[[7,1,"き"],[10,2,"ひじょう"],[13,2,"かんしん"],[23,2,"ひとびと"],[26,1,"い"],[34,1,"き"],[45,1,"ひと"],[47,1,"なか"],[56,2,"しんこう"],[59,1,"み"]],"text":"イエスはこれを聞いて非常に感心され、ついてきた人々に言われた、「よく聞きなさい。イスラエル人の中にも、これほどの信仰を見たことがない。"},{"ref":"Matt.8.11","start":40008011,"end":40008011,"break":"none","ruby":[[9,1,"い"],[13,1,"おお"],[16,1,"ひと"],[18,1,"ひがし"],[21,1,"にし"],[27,2,"てんごく"],[45,1,"とも"],[47,2,"えんかい"],[50,1,"せき"]],"text":"なお、あなたがたに言うが、多くの人が東から西からきて、天国で、アブラハム、イサク、ヤコブと共に宴会の席につくが、"},{"ref":"Matt.8.12","start":40008012,"end":40008012,"break":"none","ruby":[[2,1,"くに"],[4,1,"こ"],[7,1,"そと"],[12,1,"お"],[14,1,"だ"],[21,1,"な"],[23,1,"さけ"],[28,1,"は"]],"text":"この国の子らは外のやみに追い出され、そこで泣き叫んだり、歯がみをしたりするであろう」。"},{"ref":"Matt.8.13","start":40008013,"end":40008013,"break":"none","ruby":[[8,3,"ひゃくそつちょう"],[13,1,"い"],[20,1,"しん"],[34,1,"い"],[49,1,"とき"],[52,1,"しもべ"]],"text":"それからイエスは百卒長に「行け、あなたの信じたとおりになるように」と言われた。すると、ちょうどその時に、僕はいやされた。"},{"ref":"Matt.8.14","start":40008014,"end":40008014,"break":"paragraph","ruby":[[13,1,"いえ"],[19,1,"い"],[31,2,"ねつびょう"],[35,1,"とこ"]],"text":"それから、イエスはペテロの家にはいって行かれ、そのしゅうとめが熱病で、床についているのをごらんになった。"},{"ref":"Matt.8.15","start":40008015,"end":40008015,"break":"none","ruby":[[6,1,"て"],[15,1,"ねつ"],[17,1,"ひ"],[24,1,"おんな"],[26,1,"お"]],"text":"そこで、その手にさわられると、熱が引いた。そして女は起きあがってイエスをもてなした。"},{"ref":"Matt.8.16","start":40008016,"end":40008016,"break":"none","ruby":[[0,2,"ゆうぐれ"],[7,2,"ひとびと"],[10,2,"あくれい"],[17,1,"もの"],[19,1,"おお"],[27,1,"つ"],[40,2,"ことば"],[46,1,"れい"],[50,1,"お"],[52,1,"だ"],[55,2,"びょうにん"]],"text":"夕暮になると、人々は悪霊につかれた者を大ぜい、みもとに連れてきたので、イエスはみ言葉をもって霊どもを追い出し、病人をことごとくおいやしになった。"},{"ref":"Matt.8.17","start":40008017,"end":40008017,"break":"none","ruby":[[4,3,"よげんしゃ"],[15,1,"かれ"],[29,1,"み"],[31,1,"う"],[40,1,"やまい"],[42,1,"お"],[47,1,"い"],[51,2,"ことば"],[54,2,"じょうじゅ"]],"text":"これは、預言者イザヤによって「彼は、わたしたちのわずらいを身に受け、わたしたちの病を負うた」と言われた言葉が成就するためである。"},{"ref":"Matt.8.18","start":40008018,"end":40008018,"break":"paragraph","ruby":[[5,2,"ぐんしゅう"],[8,2,"じぶん"],[15,1,"むら"],[23,1,"み"],[26,1,"む"],[29,1,"ぎし"],[31,1,"い"],[37,2,"でし"],[43,1,"めい"]],"text":"イエスは、群衆が自分のまわりに群がっているのを見て、向こう岸に行くようにと弟子たちにお命じになった。"},{"ref":"Matt.8.19","start":40008019,"end":40008019,"break":"none","ruby":[[7,2,"りっぽう"],[9,2,"がくしゃ"],[12,1,"ちか"],[18,1,"い"],[23,2,"せんせい"],[36,1,"ところ"],[45,1,"したが"]],"text":"するとひとりの律法学者が近づいてきて言った、「先生、あなたがおいでになる所なら、どこへでも従ってまいります」。"},{"ref":"Matt.8.20","start":40008020,"end":40008020,"break":"none","ruby":[[6,1,"ひと"],[8,1,"い"],[19,1,"あな"],[24,1,"そら"],[26,1,"とり"],[29,1,"す"],[38,1,"ひと"],[40,1,"こ"],[48,1,"ところ"]],"text":"イエスはその人に言われた、「きつねには穴があり、空の鳥には巣がある。しかし、人の子にはまくらする所がない」。"},{"ref":"Matt.8.21","start":40008021,"end":40008021,"break":"none","ruby":[[2,2,"でし"],[9,1,"い"],[14,1,"しゅ"],[20,1,"ちち"],[22,1,"ほうむ"],[25,1,"い"],[29,1,"くだ"]],"text":"また弟子のひとりが言った、「主よ、まず、父を葬りに行かせて下さい」。"},{"ref":"Matt.8.22","start":40008022,"end":40008022,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[16,1,"したが"],[30,2,"しにん"],[33,1,"ほうむ"],[39,2,"しにん"],[42,1,"まか"]],"text":"イエスは彼に言われた、「わたしに従ってきなさい。そして、その死人を葬ることは、死人に任せておくがよい」。"},{"ref":"Matt.8.23","start":40008023,"end":40008023,"break":"paragraph","ruby":[[9,1,"ふね"],[11,1,"の"],[13,1,"こ"],[19,2,"でし"],[24,1,"したが"]],"text":"それから、イエスが舟に乗り込まれると、弟子たちも従った。"},{"ref":"Matt.8.24","start":40008024,"end":40008024,"break":"none","ruby":[[3,2,"とつぜん"],[6,2,"かいじょう"],[9,1,"はげ"],[12,2,"ぼうふう"],[15,1,"おこ"],[19,1,"ふね"],[21,1,"なみ"],[42,1,"ねむ"]],"text":"すると突然、海上に激しい暴風が起って、舟は波にのまれそうになった。ところが、イエスは眠っておられた。"},{"ref":"Matt.8.25","start":40008025,"end":40008025,"break":"none","ruby":[[3,2,"でし"],[12,1,"よ"],[21,1,"おこ"],[25,1,"しゅ"],[29,1,"たす"],[42,1,"し"],[50,1,"い"]],"text":"そこで弟子たちはみそばに寄ってきてイエスを起し、「主よ、お助けください、わたしたちは死にそうです」と言った。"},{"ref":"Matt.8.26","start":40008026,"end":40008026,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[25,2,"しんこう"],[28,1,"うす"],[30,1,"もの"],[40,1,"お"],[47,1,"かぜ"],[49,1,"うみ"],[61,1,"おお"]],"text":"するとイエスは彼らに言われた、「なぜこわがるのか、信仰の薄い者たちよ」。それから起きあがって、風と海とをおしかりになると、大なぎになった。"},{"ref":"Matt.8.27","start":40008027,"end":40008027,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おどろ"],[6,1,"い"],[20,1,"ひと"],[27,1,"かぜ"],[29,1,"うみ"],[31,1,"したが"]],"text":"彼らは驚いて言った、「このかたはどういう人なのだろう。風も海も従わせるとは」。"},{"ref":"Matt.8.28","start":40008028,"end":40008028,"break":"paragraph","ruby":[[5,1,"む"],[8,1,"ぎし"],[13,1,"びと"],[15,1,"ち"],[17,1,"つ"],[23,2,"あくれい"],[34,1,"もの"],[37,2,"はかば"],[41,1,"で"],[49,2,"であ"],[54,1,"かれ"],[57,1,"て"],[59,1,"お"],[63,2,"らんぼう"],[65,1,"もの"],[73,1,"へん"],[75,1,"みち"],[77,1,"とお"]],"text":"それから、向こう岸、ガダラ人の地に着かれると、悪霊につかれたふたりの者が、墓場から出てきてイエスに出会った。彼らは手に負えない乱暴者で、だれもその辺の道を通ることができないほどであった。"},{"ref":"Matt.8.29","start":40008029,"end":40008029,"break":"none","ruby":[[3,2,"とつぜん"],[6,1,"かれ"],[9,1,"さけ"],[12,1,"い"],[17,1,"かみ"],[19,1,"こ"],[35,1,"かか"],[49,1,"とき"],[69,1,"くる"]],"text":"すると突然、彼らは叫んで言った、「神の子よ、あなたはわたしどもとなんの係わりがあるのです。まだその時ではないのに、ここにきて、わたしどもを苦しめるのですか」。"},{"ref":"Matt.8.30","start":40008030,"end":40008030,"break":"none","ruby":[[10,1,"はな"],[13,1,"ところ"],[22,1,"ぶた"],[24,1,"む"],[27,1,"か"]],"text":"さて、そこからはるか離れた所に、おびただしい豚の群れが飼ってあった。"},{"ref":"Matt.8.31","start":40008031,"end":40008031,"break":"none","ruby":[[0,2,"あくれい"],[9,1,"ねが"],[12,1,"い"],[25,1,"お"],[27,1,"だ"],[37,1,"ぶた"],[39,1,"む"],[42,1,"なか"],[49,1,"くだ"]],"text":"悪霊どもはイエスに願って言った、「もしわたしどもを追い出されるのなら、あの豚の群れの中につかわして下さい」。"},{"ref":"Matt.8.32","start":40008032,"end":40008032,"break":"none","ruby":[[9,1,"い"],[13,1,"い"],[19,1,"かれ"],[22,1,"で"],[24,1,"い"],[28,1,"ぶた"],[30,1,"なか"],[35,1,"こ"],[45,1,"む"],[47,2,"ぜんたい"],[55,1,"うみ"],[61,1,"う"],[64,1,"か"],[66,1,"くだ"],[69,1,"みず"],[71,1,"なか"],[73,1,"し"]],"text":"そこで、イエスが「行け」と言われると、彼らは出て行って、豚の中へはいり込んだ。すると、その群れ全体が、がけから海へなだれを打って駆け下り、水の中で死んでしまった。"},{"ref":"Matt.8.33","start":40008033,"end":40008033,"break":"none","ruby":[[0,1,"か"],[2,1,"もの"],[6,1,"に"],[9,1,"まち"],[11,1,"い"],[14,2,"あくれい"],[21,1,"もの"],[35,1,"し"]],"text":"飼う者たちは逃げて町に行き、悪霊につかれた者たちのことなど、いっさいを知らせた。"},{"ref":"Matt.8.34","start":40008034,"end":40008034,"break":"none","ruby":[[4,2,"まちじゅう"],[7,1,"もの"],[13,1,"あ"],[16,1,"で"],[29,1,"あ"],[35,2,"ちほう"],[39,1,"さ"],[50,1,"たの"]],"text":"すると、町中の者がイエスに会いに出てきた。そして、イエスに会うと、この地方から去ってくださるようにと頼んだ。"}]