[{"ref":"Ezek.35.1","start":26035001,"end":26035001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.35.2","start":26035002,"end":26035002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,1,"かお"],[15,1,"やま"],[17,1,"む"],[23,1,"たい"],[26,2,"よげん"]],"text":"「人の子よ、あなたの顔をセイル山に向け、これに対して預言し、"},{"ref":"Ezek.35.3","start":26035003,"end":26035003,"break":"none","ruby":[[3,1,"い"],[6,1,"しゅ"],[9,1,"かみ"],[13,1,"い"],[21,1,"やま"],[24,1,"み"],[35,1,"てき"],[43,1,"て"],[49,1,"む"],[53,1,"の"],[60,1,"まった"],[62,1,"あら"]],"text":"これに言え。主なる神はこう言われる、セイル山よ、見よ、わたしはあなたを敵とし、わたしの手をあなたに向かって伸べ、あなたを全く荒し、"},{"ref":"Ezek.35.4","start":26035004,"end":26035004,"break":"none","ruby":[[4,2,"まちまち"],[7,1,"ほろ"],[15,1,"あ"],[28,1,"しゅ"],[35,1,"さと"]],"text":"あなたの町々を滅ぼす。あなたは荒れはてる。そしてわたしが主であることを悟る。"},{"ref":"Ezek.35.5","start":26035005,"end":26035005,"break":"none","ruby":[[4,1,"かぎ"],[8,2,"てきい"],[22,2,"ひとびと"],[27,1,"わざわい"],[29,1,"とき"],[31,1,"おわ"],[34,2,"けいばつ"],[37,1,"とき"],[44,1,"て"],[46,1,"わた"]],"text":"あなたは限りない敵意をいだいて、イスラエルの人々をその災の時、終りの刑罰の時に、つるぎの手に渡した。"},{"ref":"Ezek.35.6","start":26035006,"end":26035006,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[10,1,"い"],[19,1,"い"],[33,1,"ち"],[39,1,"ち"],[45,1,"お"],[56,1,"ち"],[66,1,"ち"],[72,1,"お"]],"text":"それゆえ、主なる神は言われる、わたしは生きている。わたしはあなたを血にわたす。血はあなたを追いかける。あなたには血のとががあるゆえ、血はあなたを追いかける"},{"ref":"Ezek.35.7","start":26035007,"end":26035007,"break":"none","ruby":[[7,1,"やま"],[9,1,"まった"],[11,1,"あら"],[17,1,"ゆ"],[19,1,"き"],[22,1,"もの"],[24,1,"た"]],"text":"わたしはセイル山を全く荒し、そこに行き来する者を断ち、"},{"ref":"Ezek.35.8","start":26035008,"end":26035008,"break":"none","ruby":[[2,2,"やまやま"],[5,1,"ころ"],[9,1,"もの"],[11,1,"み"],[19,1,"ころ"],[23,1,"もの"],[35,1,"おか"],[42,1,"たに"],[51,1,"ち"],[53,1,"たお"]],"text":"その山々を殺された者で満たす。つるぎで殺された者が、あなたのもろもろの丘、もろもろの谷、もろもろのくぼ地に倒れる。"},{"ref":"Ezek.35.9","start":26035009,"end":26035009,"break":"none","ruby":[[9,2,"えいえん"],[12,1,"あ"],[14,1,"ち"],[22,2,"まちまち"],[26,1,"す"],[28,1,"もの"],[49,1,"しゅ"],[56,1,"さと"]],"text":"わたしはあなたを、永遠の荒れ地とし、あなたの町々には住む者がなくなる。そしてあなたがたは、わたしが主であることを悟る。"},{"ref":"Ezek.35.10","start":26035010,"end":26035010,"break":"paragraph","ruby":[[4,1,"い"],[14,2,"こくみん"],[20,1,"くに"],[37,1,"え"],[46,1,"しゅ"]],"text":"あなたは言う、『これら二つの国民、二つの国はわたしのもの、われわれはこれを獲よう』と。しかし主はそこにおられる。"},{"ref":"Ezek.35.11","start":26035011,"end":26035011,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[10,1,"い"],[19,1,"い"],[29,1,"かれ"],[32,1,"にく"],[36,1,"かれ"],[39,1,"しめ"],[42,1,"いか"],[64,1,"あつか"],[78,1,"とき"],[83,2,"じしん"],[90,1,"しめ"]],"text":"それゆえ、主なる神は言われる、わたしは生きている。あなたが彼らを憎んで、彼らに示した怒りと、ねたみにしたがって、わたしはあなたを扱う。わたしがあなたをさばく時、わたし自身をあなたに示す。"},{"ref":"Ezek.35.12","start":26035012,"end":26035012,"break":"none","ruby":[[10,2,"やまやま"],[13,1,"む"],[22,1,"あ"],[33,1,"しょく"],[39,1,"い"],[52,1,"しゅ"],[59,1,"き"],[69,1,"さと"]],"text":"あなたがイスラエルの山々に向かって、『これは荒れはてて、われわれの食となる』と言ったもろもろのそしりを、主なるわたしが聞いたことをあなたは悟る。"},{"ref":"Ezek.35.13","start":26035013,"end":26035013,"break":"none","ruby":[[11,1,"たい"],[14,1,"くち"],[19,1,"ほこ"],[28,1,"たい"],[38,2,"ことば"],[41,1,"おお"],[53,1,"き"]],"text":"あなたがたは、わたしに対して口をもって誇り、またわたしに対して、あなたがたの言葉を多くした。わたしはそれを聞いた。"},{"ref":"Ezek.35.14","start":26035014,"end":26035014,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[12,1,"ぜん"],[13,1,"ち"],[15,1,"よろこ"],[30,1,"あ"],[32,1,"ち"]],"text":"主なる神はこう言われる、全地の喜びのために、わたしはあなたを荒れ地とする。"},{"ref":"Ezek.35.15","start":26035015,"end":26035015,"break":"none","ruby":[[11,1,"いえ"],[13,1,"し"],[14,1,"ぎょう"],[16,1,"あ"],[21,1,"よろこ"],[48,1,"やま"],[55,1,"あ"],[57,1,"ち"],[81,1,"かれ"],[89,1,"しゅ"],[96,1,"さと"]],"text":"あなたが、イスラエルの家の嗣業の荒れるのを喜んだように、わたしはあなたに、そのようにする。セイル山よ、あなたは荒れ地となる。エドムもすべてそのようになる。そのとき彼らは、わたしが主であることを悟るようになる。"}]