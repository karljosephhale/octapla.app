[{"ref":"2Sam.12.1","start":10012001,"end":10012001,"break":"paragraph","ruby":[[0,1,"しゅ"],[19,1,"かれ"],[25,1,"ところ"],[29,1,"い"],[36,1,"まち"],[42,1,"ひと"],[52,1,"と"],[59,1,"まず"]],"text":"主はナタンをダビデにつかわされたので、彼はダビデの所にきて言った、「ある町にふたりの人があって、ひとりは富み、ひとりは貧しかった。"},{"ref":"2Sam.12.2","start":10012002,"end":10012002,"break":"none","ruby":[[0,1,"と"],[5,1,"ひと"],[7,2,"ひじょう"],[10,1,"おお"],[13,1,"ひつじ"],[15,1,"うし"],[17,1,"も"]],"text":"富んでいる人は非常に多くの羊と牛を持っていたが、"},{"ref":"2Sam.12.3","start":10012003,"end":10012003,"break":"none","ruby":[[0,1,"まず"],[3,1,"ひと"],[5,2,"じぶん"],[8,1,"か"],[12,1,"とう"],[14,1,"ちい"],[17,1,"めす"],[19,2,"こひつじ"],[25,1,"なに"],[27,1,"も"],[36,1,"かれ"],[41,1,"そだ"],[49,2,"こひつじ"],[52,1,"かれ"],[56,1,"かれ"],[58,2,"こども"],[63,1,"とも"],[65,2,"せいちょう"],[69,1,"かれ"],[71,2,"しょくもつ"],[74,1,"た"],[77,1,"かれ"],[83,1,"の"],[86,1,"かれ"],[93,1,"ね"],[96,1,"かれ"],[102,1,"むすめ"]],"text":"貧しい人は自分が買った一頭の小さい雌の小羊のほかは何も持っていなかった。彼がそれを育てたので、その小羊は彼および彼の子供たちと共に成長し、彼の食物を食べ、彼のわんから飲み、彼のふところで寝て、彼にとっては娘のようであった。"},{"ref":"2Sam.12.4","start":10012004,"end":10012004,"break":"none","ruby":[[0,1,"とき"],[7,1,"たび"],[14,1,"と"],[19,1,"ひと"],[28,2,"じぶん"],[31,1,"ひつじ"],[35,1,"うし"],[42,1,"いっとう"],[44,1,"と"],[48,2,"じぶん"],[51,1,"ところ"],[55,1,"たび"],[62,2,"ちょうり"],[69,1,"お"],[75,1,"まず"],[78,1,"ひと"],[80,2,"こひつじ"],[83,1,"と"],[90,2,"じぶん"],[93,1,"ところ"],[97,1,"ひと"],[102,2,"ちょうり"]],"text":"時に、ひとりの旅びとが、その富んでいる人のもとにきたが、自分の羊または牛のうちから一頭を取って、自分の所にきた旅びとのために調理することを惜しみ、その貧しい人の小羊を取って、これを自分の所にきた人のために調理した」。"},{"ref":"2Sam.12.5","start":10012005,"end":10012005,"break":"none","ruby":[[6,1,"ひと"],[8,1,"こと"],[15,1,"いか"],[22,1,"い"],[27,1,"しゅ"],[29,1,"い"],[39,1,"こと"],[45,1,"ひと"],[47,1,"し"]],"text":"ダビデはその人の事をひじょうに怒ってナタンに言った、「主は生きておられる。この事をしたその人は死ぬべきである。"},{"ref":"2Sam.12.6","start":10012006,"end":10012006,"break":"none","ruby":[[4,1,"ひと"],[8,1,"こと"],[30,2,"こひつじ"],[34,1,"ばい"],[38,1,"つぐな"]],"text":"かつその人はこの事をしたため、またあわれまなかったため、その小羊を四倍にして償わなければならない」。"},{"ref":"2Sam.12.7","start":10012007,"end":10012007,"break":"paragraph","ruby":[[8,1,"い"],[19,1,"ひと"],[29,1,"かみ"],[31,1,"しゅ"],[35,1,"おお"],[50,1,"あぶら"],[52,1,"そそ"],[61,1,"おう"],[73,1,"て"],[76,1,"すく"]],"text":"ナタンはダビデに言った、「あなたがその人です。イスラエルの神、主はこう仰せられる、『わたしはあなたに油を注いでイスラエルの王とし、あなたをサウルの手から救いだし、"},{"ref":"2Sam.12.8","start":10012008,"end":10012008,"break":"none","ruby":[[4,2,"しゅじん"],[7,1,"いえ"],[9,1,"あた"],[12,2,"しゅじん"],[15,1,"つま"],[28,1,"あた"],[42,1,"いえ"],[48,1,"あた"],[54,1,"すく"],[70,1,"おお"],[80,1,"ま"],[82,1,"くわ"]],"text":"あなたに主人の家を与え、主人の妻たちをあなたのふところに与え、またイスラエルとユダの家をあなたに与えた。もし少なかったならば、わたしはもっと多くのものをあなたに増し加えたであろう。"},{"ref":"2Sam.12.9","start":10012009,"end":10012009,"break":"none","ruby":[[8,1,"しゅ"],[10,2,"ことば"],[13,1,"かろ"],[19,1,"め"],[21,1,"まえ"],[23,2,"あくじ"],[55,1,"ころ"],[60,1,"つま"],[65,2,"じぶん"],[68,1,"つま"],[82,2,"ひとびと"],[92,1,"かれ"],[94,1,"ころ"]],"text":"どうしてあなたは主の言葉を軽んじ、その目の前に悪事をおこなったのですか。あなたはつるぎをもってヘテびとウリヤを殺し、その妻をとって自分の妻とした。すなわちアンモンの人々のつるぎをもって彼を殺した。"},{"ref":"2Sam.12.10","start":10012010,"end":10012010,"break":"none","ruby":[[8,1,"かろ"],[20,1,"つま"],[25,2,"じぶん"],[28,1,"つま"],[48,1,"いえ"],[50,1,"はな"]],"text":"あなたがわたしを軽んじてヘテびとウリヤの妻をとり、自分の妻としたので、つるぎはいつまでもあなたの家を離れないであろう』。"},{"ref":"2Sam.12.11","start":10012011,"end":10012011,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"おお"],[11,1,"み"],[22,1,"いえ"],[29,1,"うえ"],[31,1,"わざわい"],[33,1,"おこ"],[48,1,"め"],[50,1,"まえ"],[56,1,"つま"],[60,1,"と"],[64,1,"となり"],[68,1,"あた"],[78,1,"ひと"],[82,2,"たいよう"],[85,1,"まえ"],[87,1,"つま"],[91,2,"いっしょ"],[94,1,"ね"]],"text":"主はこう仰せられる、『見よ、わたしはあなたの家からあなたの上に災を起すであろう。わたしはあなたの目の前であなたの妻たちを取って、隣びとに与えるであろう。その人はこの太陽の前で妻たちと一緒に寝るであろう。"},{"ref":"2Sam.12.12","start":10012012,"end":10012012,"break":"none","ruby":[[19,1,"ぜん"],[26,1,"まえ"],[29,2,"たいよう"],[32,1,"まえ"],[36,1,"こと"]],"text":"あなたはひそかにそれをしたが、わたしは全イスラエルの前と、太陽の前にこの事をするのである』」。"},{"ref":"2Sam.12.13","start":10012013,"end":10012013,"break":"none","ruby":[[8,1,"い"],[17,1,"しゅ"],[19,1,"つみ"],[37,1,"い"],[42,1,"しゅ"],[50,1,"つみ"],[52,1,"のぞ"],[63,1,"し"]],"text":"ダビデはナタンに言った、「わたしは主に罪をおかしました」。ナタンはダビデに言った、「主もまたあなたの罪を除かれました。あなたは死ぬことはないでしょう。"},{"ref":"2Sam.12.14","start":10012014,"end":10012014,"break":"none","ruby":[[9,1,"おこな"],[15,1,"おお"],[18,1,"しゅ"],[20,1,"あなど"],[30,1,"うま"],[33,2,"こども"],[40,1,"し"]],"text":"しかしあなたはこの行いによって大いに主を侮ったので、あなたに生れる子供はかならず死ぬでしょう」。"},{"ref":"2Sam.12.15","start":10012015,"end":10012015,"break":"none","breaks":[[14,"paragraph"]],"ruby":[[8,1,"いえ"],[10,1,"かえ"],[16,1,"しゅ"],[23,1,"つま"],[29,1,"う"],[32,1,"こ"],[34,1,"う"],[41,2,"びょうき"]],"text":"こうしてナタンは家に帰った。さて主は、ウリヤの妻がダビデに産んだ子を撃たれたので、病気になった。"},{"ref":"2Sam.12.16","start":10012016,"end":10012016,"break":"none","ruby":[[6,1,"こ"],[11,1,"かみ"],[13,2,"たんがん"],[26,2,"だんじき"],[37,2,"しゅうや"],[39,1,"ち"],[41,1,"ふ"]],"text":"ダビデはその子のために神に嘆願した。すなわちダビデは断食して、へやにはいり終夜地に伏した。"},{"ref":"2Sam.12.17","start":10012017,"end":10012017,"break":"none","ruby":[[4,1,"いえ"],[6,2,"ちょうろう"],[12,1,"かれ"],[19,1,"た"],[22,1,"かれ"],[24,1,"ち"],[27,1,"おこ"],[35,1,"かれ"],[37,1,"お"],[48,1,"かれ"],[51,2,"いっしょ"],[54,2,"しょくじ"]],"text":"ダビデの家の長老たちは、彼のかたわらに立って彼を地から起そうとしたが、彼は起きようとはせず、また彼らと一緒に食事をしなかった。"},{"ref":"2Sam.12.18","start":10012018,"end":10012018,"break":"none","ruby":[[0,2,"なぬか"],[2,1,"め"],[6,1,"こ"],[8,1,"し"],[16,2,"けらい"],[23,1,"こ"],[25,1,"し"],[35,1,"つ"],[40,1,"おそ"],[47,1,"かれ"],[52,1,"み"],[55,1,"こ"],[59,1,"い"],[64,1,"あいだ"],[72,1,"かれ"],[74,1,"かた"],[79,1,"かれ"],[83,2,"ことば"],[86,1,"き"],[99,1,"かれ"],[103,1,"こ"],[105,1,"し"],[111,1,"つ"],[123,1,"かれ"],[125,1,"みずか"],[128,1,"がい"],[133,1,"し"],[139,1,"おも"]],"text":"七日目にその子は死んだ。ダビデの家来たちはその子が死んだことをダビデに告げるのを恐れた。それは彼らが、「見よ、子のなお生きている間に、われわれが彼に語ったのに彼はその言葉を聞きいれなかった。どうして彼にその子の死んだことを告げることができようか。彼は自らを害するかも知れない」と思ったからである。"},{"ref":"2Sam.12.19","start":10012019,"end":10012019,"break":"none","ruby":[[8,2,"けらい"],[13,1,"たがい"],[19,1,"あ"],[23,1,"み"],[28,1,"こ"],[30,1,"し"],[35,1,"さと"],[38,2,"けらい"],[43,1,"い"],[48,1,"こ"],[50,1,"し"],[57,1,"かれ"],[60,1,"い"],[65,1,"し"]],"text":"しかしダビデは、家来たちが互にささやき合うのを見て、その子の死んだのを悟り、家来たちに言った、「子は死んだのか」。彼らは言った、「死なれました」。"},{"ref":"2Sam.12.20","start":10012020,"end":10012020,"break":"none","ruby":[[8,1,"ち"],[11,1,"お"],[13,1,"あ"],[17,1,"み"],[19,1,"あら"],[22,1,"あぶら"],[29,2,"きもの"],[32,1,"か"],[36,1,"しゅ"],[38,1,"いえ"],[44,1,"はい"],[52,2,"じぶん"],[55,1,"いえ"],[57,1,"い"],[60,1,"もと"],[63,2,"じぶん"],[69,2,"しょくもつ"],[72,1,"そな"],[77,1,"た"]],"text":"そこで、ダビデは地から起き上がり、身を洗い、油をぬり、その着物を替えて、主の家にはいって拝した。そののち自分の家に行き、求めて自分のために食物を備えさせて食べた。"},{"ref":"2Sam.12.21","start":10012021,"end":10012021,"break":"none","ruby":[[0,2,"けらい"],[5,1,"かれ"],[7,1,"い"],[22,1,"こと"],[36,1,"こ"],[38,1,"い"],[43,1,"あいだ"],[47,1,"こ"],[52,2,"だんじき"],[56,1,"な"],[66,1,"こ"],[68,1,"し"],[76,1,"お"],[79,2,"しょくじ"]],"text":"家来たちは彼に言った、「あなたのなさったこの事はなんでしょうか。あなたは子の生きている間はその子のために断食して泣かれました。しかし子が死ぬと、あなたは起きて食事をなさいました」。"},{"ref":"2Sam.12.22","start":10012022,"end":10012022,"break":"none","ruby":[[4,1,"い"],[9,1,"こ"],[11,1,"い"],[16,1,"あいだ"],[23,2,"だんじき"],[27,1,"な"],[34,1,"しゅ"],[48,1,"こ"],[50,1,"い"],[60,1,"し"],[66,1,"おも"]],"text":"ダビデは言った、「子の生きている間に、わたしが断食して泣いたのは、『主がわたしをあわれんで、この子を生かしてくださるかも知れない』と思ったからです。"},{"ref":"2Sam.12.23","start":10012023,"end":10012023,"break":"none","ruby":[[3,1,"いま"],[5,1,"し"],[19,2,"だんじき"],[40,1,"ふたた"],[42,1,"かれ"],[62,1,"かれ"],[64,1,"ところ"],[66,1,"い"],[74,1,"かれ"],[80,1,"ところ"],[82,1,"かえ"]],"text":"しかし今は死んだので、わたしはどうして断食しなければならないでしょうか。わたしは再び彼をかえらせることができますか。わたしは彼の所に行くでしょうが、彼はわたしの所に帰ってこないでしょう」。"},{"ref":"2Sam.12.24","start":10012024,"end":10012024,"break":"paragraph","ruby":[[4,1,"つま"],[10,1,"なぐさ"],[13,2,"かのじょ"],[16,1,"ところ"],[23,2,"かのじょ"],[26,1,"とも"],[28,1,"ね"],[33,2,"かのじょ"],[36,1,"おとこ"],[38,1,"こ"],[40,1,"う"],[50,1,"な"],[57,1,"な"],[62,1,"しゅ"],[67,1,"あい"]],"text":"ダビデは妻バテシバを慰め、彼女の所にはいって、彼女と共に寝たので、彼女は男の子を産んだ。ダビデはその名をソロモンと名づけた。主はこれを愛された。"},{"ref":"2Sam.12.25","start":10012025,"end":10012025,"break":"none","ruby":[[3,3,"よげんしゃ"],[15,1,"めい"],[20,1,"な"],[27,1,"よ"]],"text":"そして預言者ナタンをつかわし、命じてその名をエデデアと呼ばせられた。"},{"ref":"2Sam.12.26","start":10012026,"end":10012026,"break":"paragraph","ruby":[[11,2,"ひとびと"],[17,1,"せ"],[20,1,"おう"],[22,1,"まち"],[24,1,"と"]],"text":"さてヨアブはアンモンの人々のラバを攻めて王の町を取った。"},{"ref":"2Sam.12.27","start":10012027,"end":10012027,"break":"none","ruby":[[4,2,"ししゃ"],[16,1,"い"],[28,1,"せ"],[31,1,"みず"],[33,1,"まち"],[35,1,"と"]],"text":"ヨアブは使者をダビデにつかわして言った、「わたしはラバを攻めて水の町を取りました。"},{"ref":"2Sam.12.28","start":10012028,"end":10012028,"break":"none","ruby":[[4,1,"いま"],[6,1,"のこ"],[9,1,"たみ"],[11,1,"あつ"],[16,1,"まち"],[18,1,"む"],[22,1,"じん"],[30,1,"と"],[42,1,"まち"],[44,1,"と"],[48,1,"ひと"],[54,1,"な"],[63,1,"よ"]],"text":"あなたは今、残りの民を集め、この町に向かって陣をしき、これを取りなさい。わたしがこの町を取って、人がわたしの名をもって、これを呼ぶようにならないためです」。"},{"ref":"2Sam.12.29","start":10012029,"end":10012029,"break":"none","ruby":[[7,1,"たみ"],[14,1,"あつ"],[20,1,"い"],[23,1,"せ"],[29,1,"と"]],"text":"そこでダビデは民をことごとく集めてラバへ行き、攻めてこれを取った。"},{"ref":"2Sam.12.30","start":10012030,"end":10012030,"break":"none","ruby":[[7,1,"かれ"],[10,1,"おう"],[12,1,"かんむり"],[16,1,"あたま"],[19,1,"と"],[29,1,"きん"],[31,1,"おも"],[44,2,"ほうせき"],[60,1,"あたま"],[62,1,"お"],[72,1,"まち"],[79,1,"もの"],[81,2,"ひじょう"],[84,1,"おお"],[86,1,"も"],[88,1,"だ"]],"text":"そしてダビデは彼らの王の冠をその頭から取りはなした。それは金で重さは一タラントであった。宝石がはめてあり、それをダビデの頭に置いた。ダビデはその町からぶんどり物を非常に多く持ち出した。"},{"ref":"2Sam.12.31","start":10012031,"end":10012031,"break":"none","ruby":[[11,1,"たみ"],[13,1,"ひ"],[15,1,"だ"],[19,1,"かれ"],[28,1,"てつ"],[35,1,"てつ"],[40,1,"つか"],[42,2,"しごと"],[55,1,"つく"],[58,2,"ろうえき"],[66,1,"かれ"],[73,2,"ひとびと"],[80,1,"まち"],[97,1,"たみ"],[100,1,"みな"],[107,1,"かえ"]],"text":"またダビデはそのうちの民を引き出して、彼らをのこぎりや、鉄のつるはし、鉄のおのを使う仕事につかせ、また、れんが造りの労役につかせた。彼はアンモンの人々のすべての町にこのようにした。そしてダビデと民とは皆エルサレムに帰った。"}]