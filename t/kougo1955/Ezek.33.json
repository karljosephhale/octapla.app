[{"ref":"Ezek.33.1","start":26033001,"end":26033001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.33.2","start":26033002,"end":26033002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[10,1,"たみ"],[12,2,"ひとびと"],[15,1,"かた"],[18,1,"い"],[32,1,"くに"],[34,1,"のぞ"],[38,1,"とき"],[42,1,"くに"],[44,1,"たみ"],[46,1,"かれ"],[57,1,"えら"],[64,2,"じぶん"],[69,2,"みまも"],[72,1,"もの"]],"text":"「人の子よ、あなたの民の人々に語って言え、わたしがつるぎを一つの国に臨ませる時、その国の民が彼らのうちからひとりを選んで、これを自分たちの見守る者とする。"},{"ref":"Ezek.33.3","start":26033003,"end":26033003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"くに"],[8,1,"のぞ"],[12,1,"み"],[19,1,"ふ"],[22,1,"たみ"],[24,1,"いまし"]],"text":"彼は国につるぎが臨むのを見て、ラッパを吹き、民を戒める。"},{"ref":"Ezek.33.4","start":26033004,"end":26033004,"break":"none","ruby":[[3,1,"ひと"],[9,1,"おと"],[11,1,"き"],[20,2,"けいかい"],[32,1,"き"],[37,1,"ひと"],[39,1,"ころ"],[47,1,"ち"],[49,1,"かれ"],[55,1,"き"]],"text":"しかし人がラッパの音を聞いても、みずから警戒せず、ついにつるぎが来て、その人を殺したなら、その血は彼のこうべに帰する。"},{"ref":"Ezek.33.5","start":26033005,"end":26033005,"break":"none","ruby":[[0,1,"かれ"],[6,1,"おと"],[8,1,"き"],[16,2,"けいかい"],[32,1,"ち"],[34,1,"かれ"],[35,2,"じしん"],[38,1,"き"],[47,1,"ひと"],[54,2,"けいかい"],[63,1,"いのち"],[65,1,"すく"]],"text":"彼はラッパの音を聞いて、みずから警戒しなかったのであるから、その血は彼自身に帰する。しかしその人が、みずから警戒したなら、その命は救われる。"},{"ref":"Ezek.33.6","start":26033006,"end":26033006,"break":"none","ruby":[[3,2,"みまも"],[6,1,"もの"],[13,1,"のぞ"],[17,1,"み"],[25,1,"ふ"],[33,1,"たみ"],[40,2,"けいかい"],[56,1,"のぞ"],[59,1,"かれ"],[62,1,"なか"],[68,1,"うしな"],[76,1,"ひと"],[79,2,"じぶん"],[82,1,"つみ"],[87,1,"ころ"],[99,1,"ち"],[101,2,"せきにん"],[105,2,"みまも"],[108,1,"もの"],[110,1,"て"],[112,1,"もと"]],"text":"しかし見守る者が、つるぎの臨むのを見ても、ラッパを吹かず、そのため民が、みずから警戒しないでいるうちに、つるぎが臨み、彼らの中のひとりを失うならば、その人は、自分の罪のために殺されるが、わたしはその血の責任を、見守る者の手に求める。"},{"ref":"Ezek.33.7","start":26033007,"end":26033007,"break":"paragraph","ruby":[[5,1,"ひと"],[7,1,"こ"],[18,1,"た"],[28,1,"いえ"],[30,2,"みまも"],[33,1,"もの"],[46,1,"くち"],[49,2,"ことば"],[52,1,"き"],[59,1,"かわ"],[62,1,"かれ"],[65,1,"いまし"]],"text":"それゆえ、人の子よ、わたしはあなたを立てて、イスラエルの家を見守る者とする。あなたはわたしの口から言葉を聞き、わたしに代って彼らを戒めよ。"},{"ref":"Ezek.33.8","start":26033008,"end":26033008,"break":"none","ruby":[[4,2,"あくにん"],[7,1,"む"],[12,2,"あくにん"],[20,1,"かなら"],[22,1,"し"],[25,1,"い"],[27,1,"とき"],[33,2,"あくにん"],[36,1,"いまし"],[42,1,"みち"],[45,1,"はな"],[53,1,"かた"],[61,2,"あくにん"],[64,2,"じぶん"],[67,1,"つみ"],[72,1,"し"],[84,1,"ち"],[91,1,"て"],[93,1,"もと"]],"text":"わたしが悪人に向かって、悪人よ、あなたは必ず死ぬと言う時、あなたが悪人を戒めて、その道から離れさせるように語らなかったら、悪人は自分の罪によって死ぬ。しかしわたしはその血を、あなたの手に求める。"},{"ref":"Ezek.33.9","start":26033009,"end":26033009,"break":"none","ruby":[[7,2,"あくにん"],[13,1,"みち"],[15,1,"はな"],[21,1,"いまし"],[28,2,"あくにん"],[33,1,"みち"],[35,1,"はな"],[42,1,"かれ"],[44,2,"じぶん"],[47,1,"つみ"],[52,1,"し"],[62,1,"いのち"],[64,1,"すく"]],"text":"しかしあなたが悪人に、その道を離れるように戒めても、その悪人がその道を離れないなら、彼は自分の罪によって死ぬ。しかしあなたの命は救われる。"},{"ref":"Ezek.33.10","start":26033010,"end":26033010,"break":"paragraph","ruby":[[5,1,"ひと"],[7,1,"こ"],[16,1,"いえ"],[18,1,"い"],[29,1,"い"],[43,1,"つみ"],[50,1,"うえ"],[62,1,"なか"],[67,1,"おとろ"],[77,1,"い"]],"text":"それゆえ、人の子よ、イスラエルの家に言え、あなたがたはこう言った、『われわれのとがと、罪はわれわれの上にある。われわれはその中にあって衰えはてる。どうして生きることができようか』と。"},{"ref":"Ezek.33.11","start":26033011,"end":26033011,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[10,1,"しゅ"],[13,1,"かみ"],[15,1,"い"],[24,1,"い"],[34,2,"あくにん"],[37,1,"し"],[39,1,"よろこ"],[47,2,"あくにん"],[53,1,"みち"],[55,1,"はな"],[58,1,"い"],[63,1,"よろこ"],[72,1,"こころ"],[74,1,"ひるがえ"],[77,1,"こころ"],[79,1,"ひるがえ"],[84,1,"あ"],[87,1,"みち"],[89,1,"はな"],[99,1,"いえ"],[110,1,"し"]],"text":"あなたは彼らに言え、主なる神は言われる、わたしは生きている。わたしは悪人の死を喜ばない。むしろ悪人が、その道を離れて生きるのを喜ぶ。あなたがたは心を翻せ、心を翻してその悪しき道を離れよ。イスラエルの家よ、あなたはどうして死んでよかろうか。"},{"ref":"Ezek.33.12","start":26033012,"end":26033012,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[9,1,"たみ"],[11,2,"ひとびと"],[14,1,"い"],[17,2,"ぎじん"],[20,1,"ぎ"],[23,1,"かれ"],[25,1,"つみ"],[27,1,"おか"],[29,1,"とき"],[33,1,"かれ"],[35,1,"すく"],[40,2,"あくにん"],[43,1,"あく"],[46,1,"かれ"],[50,1,"あく"],[52,1,"はな"],[55,1,"とき"],[59,1,"あく"],[64,1,"たお"],[73,2,"ぎじん"],[76,1,"かれ"],[78,1,"つみ"],[80,1,"おか"],[82,1,"とき"],[86,1,"ぎ"],[91,1,"い"]],"text":"人の子よ、あなたの民の人々に言え、義人の義は、彼が罪を犯す時には、彼を救わない。悪人の悪は、彼がその悪を離れる時、その悪のために倒れることはない。義人は彼が罪を犯す時、その義のために生きることはできない。"},{"ref":"Ezek.33.13","start":26033013,"end":26033013,"break":"none","ruby":[[4,2,"ぎじん"],[8,1,"かれ"],[10,1,"かなら"],[12,1,"い"],[16,1,"い"],[23,1,"かれ"],[25,2,"じぶん"],[28,1,"ぎ"],[35,1,"つみ"],[37,1,"おか"],[42,1,"かれ"],[48,1,"ぎ"],[50,1,"おぼ"],[57,1,"かれ"],[63,1,"おか"],[66,1,"つみ"],[71,1,"し"]],"text":"わたしが義人に、彼は必ず生きると言っても、もし彼が自分の義をたのんで、罪を犯すなら、彼のすべての義は覚えられない。彼はみずから犯した罪のために死ぬ。"},{"ref":"Ezek.33.14","start":26033014,"end":26033014,"break":"none","ruby":[[7,2,"あくにん"],[15,1,"かなら"],[17,1,"し"],[21,1,"い"],[28,1,"かれ"],[32,1,"つみ"],[34,1,"はな"],[37,2,"こうどう"],[40,2,"せいぎ"],[44,1,"おこな"]],"text":"また、わたしが悪人に『あなたは必ず死ぬ』と言っても、もし彼がその罪を離れ、公道と正義とを行うならば、"},{"ref":"Ezek.33.15","start":26033015,"end":26033015,"break":"none","ruby":[[6,2,"あくにん"],[9,2,"しちもつ"],[12,1,"かえ"],[15,1,"うば"],[18,1,"もの"],[24,1,"いのち"],[26,1,"さだ"],[29,1,"あゆ"],[32,1,"あく"],[34,1,"おこな"],[42,1,"かれ"],[44,1,"かなら"],[46,1,"い"],[50,1,"けっ"],[53,1,"し"]],"text":"すなわちその悪人が質物を返し、奪った物をもどし、命の定めに歩み、悪を行わないならば、彼は必ず生きる。決して死なない。"},{"ref":"Ezek.33.16","start":26033016,"end":26033016,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おか"],[9,1,"つみ"],[11,1,"かれ"],[13,1,"たい"],[16,1,"おぼ"],[23,1,"かれ"],[25,2,"こうどう"],[28,2,"せいぎ"],[32,1,"おこな"],[42,1,"かなら"],[44,1,"い"]],"text":"彼の犯したすべての罪は彼に対して覚えられない。彼は公道と正義とを行ったのであるから、必ず生きる。"},{"ref":"Ezek.33.17","start":26033017,"end":26033017,"break":"paragraph","ruby":[[4,1,"たみ"],[6,2,"ひとびと"],[10,1,"しゅ"],[12,1,"みち"],[14,2,"こうへい"],[21,1,"い"],[27,1,"かれ"],[30,1,"みち"],[33,2,"こうへい"]],"text":"あなたの民の人々は『主の道は公平でない』と言う。しかし彼らの道こそ公平でないのである。"},{"ref":"Ezek.33.18","start":26033018,"end":26033018,"break":"none","ruby":[[0,2,"ぎじん"],[5,1,"ぎ"],[7,1,"はな"],[11,1,"つみ"],[13,1,"おか"],[19,1,"かれ"],[27,1,"し"]],"text":"義人がその義を離れて、罪を犯すならば、彼はこれがために死ぬ。"},{"ref":"Ezek.33.19","start":26033019,"end":26033019,"break":"none","ruby":[[0,2,"あくにん"],[5,1,"あく"],[7,1,"はな"],[11,2,"こうどう"],[14,2,"せいぎ"],[18,1,"おこな"],[24,1,"かれ"],[32,1,"い"]],"text":"悪人がその悪を離れて、公道と正義とを行うならば、彼はこれによって生きる。"},{"ref":"Ezek.33.20","start":26033020,"end":26033020,"break":"none","ruby":[[15,1,"しゅ"],[17,1,"みち"],[19,2,"こうへい"],[26,1,"い"],[35,1,"いえ"],[42,2,"かくじ"]],"text":"それであるのに、あなたがたは『主の道は公平でない』と言う。イスラエルの家よ、わたしは各自のおこないにしたがって、あなたがたをさばく」。"},{"ref":"Ezek.33.21","start":26033021,"end":26033021,"break":"paragraph","ruby":[[6,1,"とら"],[8,1,"うつ"],[12,1,"のち"],[18,1,"だい"],[21,1,"ねん"],[24,1,"がつ"],[26,1,"か"],[40,1,"き"],[42,1,"もの"],[52,1,"き"],[54,1,"い"],[59,1,"まち"],[61,1,"う"],[63,1,"やぶ"]],"text":"わたしたちが捕え移された後、すなわち第十二年の十月五日に、エルサレムからのがれて来た者が、わたしのもとに来て言った、「町は打ち破られた」と。"},{"ref":"Ezek.33.22","start":26033022,"end":26033022,"break":"none","ruby":[[2,1,"もの"],[4,1,"き"],[6,1,"まえ"],[8,1,"よる"],[10,1,"しゅ"],[12,1,"て"],[18,1,"のぞ"],[22,1,"つぎ"],[24,1,"あさ"],[28,1,"ひと"],[37,1,"き"],[42,1,"しゅ"],[48,1,"くち"],[50,1,"ひら"],[59,1,"くち"],[61,1,"ひら"],[74,2,"ちんもく"]],"text":"その者が来た前の夜、主の手がわたしに臨んだ。次の朝、その人がわたしのもとに来たころ、主はわたしの口を開かれた。わたしの口が開けたので、もはやわたしは沈黙しなかった。"},{"ref":"Ezek.33.23","start":26033023,"end":26033023,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.33.24","start":26033024,"end":26033024,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[12,1,"ち"],[17,1,"あ"],[19,1,"あと"],[21,2,"じゅうみん"],[26,1,"かた"],[28,1,"つづ"],[31,1,"い"],[52,1,"ち"],[54,2,"しょゆう"],[68,1,"かず"],[70,1,"おお"],[75,1,"ち"],[82,2,"しょゆう"],[87,1,"あた"]],"text":"「人の子よ、イスラエルの地の、かの荒れ跡の住民らは、語り続けて言う、『アブラハムはただひとりで、なおこの地を所有した。しかしわたしたちの数は多い。この地はわれわれの所有として与えられている』と。"},{"ref":"Ezek.33.25","start":26033025,"end":26033025,"break":"none","ruby":[[9,1,"かれ"],[12,1,"い"],[15,1,"しゅ"],[18,1,"かみ"],[22,1,"い"],[33,1,"にく"],[35,1,"ち"],[43,1,"た"],[49,2,"ぐうぞう"],[52,1,"あお"],[55,1,"ち"],[57,1,"なが"],[67,1,"ち"],[69,2,"しょゆう"]],"text":"それゆえ、あなたは彼らに言え、主なる神はこう言われる、あなたがたは肉を血のついたままで食べ、おのが偶像を仰ぎ、血を流していて、なおこの地を所有することができるか。"},{"ref":"Ezek.33.26","start":26033026,"end":26033026,"break":"none","ruby":[[14,1,"にく"],[18,1,"こと"],[29,1,"とな"],[31,1,"びと"],[33,1,"つま"],[35,1,"けが"],[43,1,"ち"],[45,2,"しょゆう"]],"text":"あなたがたはつるぎをたのみ、憎むべき事をおこない、おのおの隣り人の妻を汚して、なおこの地を所有することができるか。"},{"ref":"Ezek.33.27","start":26033027,"end":26033027,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[13,1,"しゅ"],[16,1,"かみ"],[20,1,"い"],[29,1,"い"],[37,1,"あ"],[39,1,"あと"],[43,1,"もの"],[45,1,"かなら"],[51,1,"たお"],[59,1,"の"],[61,1,"おもて"],[65,1,"もの"],[68,1,"けもの"],[70,1,"あた"],[73,1,"く"],[77,2,"ようがい"],[82,1,"あな"],[87,1,"もの"],[89,2,"えきびょう"],[92,1,"し"]],"text":"あなたは彼らに言いなさい。主なる神はこう言われる、わたしは生きている。かの荒れ跡にいる者は必ずつるぎに倒れる。わたしは野の面にいる者を、獣に与えて食わせ、要害とほら穴とにいる者は疫病で死ぬ。"},{"ref":"Ezek.33.28","start":26033028,"end":26033028,"break":"none","ruby":[[6,1,"くに"],[8,1,"まった"],[10,1,"あら"],[13,1,"かれ"],[15,1,"ほこ"],[17,1,"ちから"],[28,2,"やまやま"],[31,1,"あ"],[34,1,"とお"],[36,1,"もの"]],"text":"わたしはこの国を全く荒す。彼の誇る力はうせ、イスラエルの山々は荒れて通る者もなくなる。"},{"ref":"Ezek.33.29","start":26033029,"end":26033029,"break":"none","ruby":[[0,1,"かれ"],[12,1,"にく"],[29,1,"くに"],[31,1,"まった"],[33,1,"あら"],[35,1,"とき"],[37,1,"かれ"],[44,1,"しゅ"],[51,1,"さと"]],"text":"彼らがおこなったすべての憎むべきことのために、わたしがこの国を全く荒す時、彼らはわたしが主であることを悟る。"},{"ref":"Ezek.33.30","start":26033030,"end":26033030,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[9,1,"たみ"],[11,2,"ひとびと"],[23,1,"いえ"],[25,2,"いりぐち"],[33,1,"こと"],[35,1,"ろん"],[42,1,"かた"],[47,1,"い"],[63,2,"ことば"],[66,1,"しゅ"],[69,1,"で"],[73,1,"き"]],"text":"人の子よ、あなたの民の人々は、かきのかたわら、家の入口で、あなたの事を論じ、たがいに語りあって言う、『さあ、われわれは、どんな言葉が主から出るかを聞こう』と。"},{"ref":"Ezek.33.31","start":26033031,"end":26033031,"break":"none","ruby":[[0,1,"かれ"],[3,1,"たみ"],[5,1,"く"],[14,1,"ところ"],[16,1,"き"],[22,1,"たみ"],[31,1,"まえ"],[33,1,"ざ"],[41,2,"ことば"],[44,1,"き"],[50,1,"かれ"],[56,1,"おこな"],[61,2,"かれら"],[64,2,"くちさき"],[68,1,"おお"],[71,1,"あい"],[73,1,"あらわ"],[79,1,"こころ"],[81,1,"り"]],"text":"彼らは民が来るようにあなたの所に来、わたしの民のようにあなたの前に座して、あなたの言葉を聞く。しかし彼らはそれを行わない。彼等は口先では多くの愛を現すが、その心は利におもむいている。"},{"ref":"Ezek.33.32","start":26033032,"end":26033032,"break":"none","ruby":[[0,1,"み"],[7,1,"かれ"],[12,1,"うつく"],[15,1,"こえ"],[17,1,"あい"],[19,1,"うた"],[24,1,"もの"],[32,2,"がっき"],[37,1,"そう"],[40,1,"もの"],[45,1,"おも"],[50,1,"かれ"],[57,2,"ことば"],[60,1,"き"],[67,1,"おこな"]],"text":"見よ、あなたは彼らには、美しい声で愛の歌をうたう者のように、また楽器をよく奏する者のように思われる。彼らはあなたの言葉は聞くが、それを行おうとはしない。"},{"ref":"Ezek.33.33","start":26033033,"end":26033033,"break":"none","ruby":[[2,1,"こと"],[4,1,"おこ"],[6,1,"とき"],[12,1,"かなら"],[14,1,"おこ"],[22,1,"かれ"],[25,1,"なか"],[31,3,"よげんしゃ"],[40,1,"かれ"],[43,1,"さと"]],"text":"この事が起る時――これは必ず起る――そのとき彼らの中にひとりの預言者がいたことを彼らは悟る」。"}]