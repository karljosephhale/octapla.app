[{"ref":"Ps.14.1","start":19014001,"end":19014001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[20,"line"],[37,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"こころ"],[11,1,"かみ"],[17,1,"い"],[20,1,"かれ"],[23,1,"くさ"],[28,1,"にく"],[32,1,"こと"],[37,1,"ぜん"],[39,1,"おこな"],[41,1,"もの"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"愚かな者は心のうちに「神はない」と言う。彼らは腐れはて、憎むべき事をなし、善を行う者はない。"},{"ref":"Ps.14.2","start":19014002,"end":19014002,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"てん"],[5,1,"ひと"],[7,1,"こ"],[10,1,"み"],[16,1,"かしこ"],[18,1,"もの"],[20,1,"かみ"],[25,1,"もと"],[28,1,"もの"],[37,1,"み"]],"text":"主は天から人の子らを見おろして、賢い者、神をたずね求める者があるかないかを見られた。"},{"ref":"Ps.14.3","start":19014003,"end":19014003,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[5,1,"まよ"],[14,1,"くさ"],[18,1,"ぜん"],[20,1,"おこな"],[22,1,"もの"]],"text":"彼らはみな迷い、みなひとしく腐れた。善を行う者はない、ひとりもない。"},{"ref":"Ps.14.4","start":19014004,"end":19014004,"break":"line","breaks":[[17,"line"],[34,"line"]],"ruby":[[3,1,"あく"],[5,1,"おこな"],[7,1,"もの"],[9,1,"さと"],[17,1,"かれ"],[20,1,"もの"],[21,1,"く"],[28,1,"たみ"],[36,1,"しゅ"],[38,1,"よ"]],"text":"すべて悪を行う者は悟りがないのか。彼らは物食うようにわが民をくらい、また主を呼ぶことをしない。"},{"ref":"Ps.14.5","start":19014005,"end":19014005,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"とき"],[4,1,"かれ"],[7,1,"おお"],[10,1,"おそ"],[14,1,"かみ"],[16,1,"ただ"],[19,1,"もの"],[25,1,"とも"]],"text":"その時、彼らは大いに恐れた。神は正しい者のやからと共におられるからである。"},{"ref":"Ps.14.6","start":19014006,"end":19014006,"break":"line","breaks":[[14,"line"],[25,"line"]],"ruby":[[6,1,"まず"],[9,1,"もの"],[11,2,"けいかく"],[28,1,"しゅ"],[30,1,"かれ"],[32,1,"さ"],[34,1,"どころ"]],"text":"あなたがたは貧しい者の計画をはずかしめようとする。しかし主は彼の避け所である。"},{"ref":"Ps.14.7","start":19014007,"end":19014007,"break":"line","breaks":[[23,"line"],[40,"line"]],"ruby":[[15,1,"すくい"],[17,1,"で"],[23,1,"しゅ"],[27,1,"たみ"],[29,2,"はんえい"],[32,2,"かいふく"],[44,1,"よろこ"],[53,1,"たの"]],"text":"どうか、シオンからイスラエルの救が出るように。主がその民の繁栄を回復されるとき、ヤコブは喜び、イスラエルは楽しむであろう。"}]