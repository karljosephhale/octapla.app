[{"ref":"2Cor.2.1","start":47002001,"end":47002001,"break":"paragraph","ruby":[[14,1,"ところ"],[16,1,"ふたた"],[18,1,"かな"],[25,1,"ゆ"],[35,2,"けっしん"]],"text":"そこでわたしは、あなたがたの所に再び悲しみをもって行くことはすまいと、決心したのである。"},{"ref":"2Cor.2.2","start":47002002,"end":47002002,"break":"none","ruby":[[8,1,"かな"],[22,1,"かな"],[31,1,"ひと"],[32,2,"いがい"],[43,1,"よろこ"]],"text":"もしあなたがたを悲しませるとすれば、わたしが悲しませているその人以外に、だれがわたしを喜ばせてくれるのか。"},{"ref":"2Cor.2.3","start":47002003,"end":47002003,"break":"none","ruby":[[5,1,"こと"],[7,1,"か"],[17,1,"ゆ"],[19,1,"とき"],[25,1,"よろこ"],[35,2,"ひとびと"],[40,1,"かな"],[43,1,"おも"],[63,2,"じしん"],[66,1,"よろこ"],[74,2,"ぜんたい"],[77,1,"よろこ"],[98,2,"かくしん"]],"text":"このような事を書いたのは、わたしが行く時、わたしを喜ばせてくれるはずの人々から、悲しい思いをさせられたくないためである。わたし自身の喜びはあなたがた全体の喜びであることを、あなたがたすべてについて確信しているからである。"},{"ref":"2Cor.2.4","start":47002004,"end":47002004,"break":"none","ruby":[[4,1,"おお"],[7,2,"かんなん"],[10,1,"こころ"],[12,1,"うれ"],[15,1,"なか"],[19,1,"おお"],[22,1,"なみだ"],[33,1,"か"],[50,1,"かな"],[68,1,"たい"],[89,1,"あい"],[92,1,"し"]],"text":"わたしは大きな患難と心の憂いの中から、多くの涙をもってあなたがたに書きおくった。それは、あなたがたを悲しませるためではなく、あなたがたに対してあふれるばかりにいだいているわたしの愛を、知ってもらうためであった。"},{"ref":"2Cor.2.5","start":47002005,"end":47002005,"break":"paragraph","ruby":[[10,1,"ひと"],[12,1,"かな"],[29,1,"かな"],[40,1,"ひか"],[42,1,"め"],[44,1,"い"],[50,2,"ていど"],[58,2,"いちどう"],[61,1,"かな"]],"text":"しかし、もしだれかが人を悲しませたとすれば、それはわたしを悲しませたのではなく、控え目に言うが、ある程度、あなたがた一同を悲しませたのである。"},{"ref":"2Cor.2.6","start":47002006,"end":47002006,"break":"none","ruby":[[2,1,"ひと"],[9,2,"たすう"],[12,1,"もの"],[15,1,"う"],[20,2,"しょばつ"],[25,2,"じゅうぶん"]],"text":"その人にとっては、多数の者から受けたあの処罰でもう十分なのだから、"},{"ref":"2Cor.2.7","start":47002007,"end":47002007,"break":"none","ruby":[[9,1,"かれ"],[17,1,"なぐさ"],[37,1,"ひと"],[43,1,"ぶか"],[45,1,"かな"],[49,1,"しず"],[53,1,"し"]],"text":"あなたがたはむしろ彼をゆるし、また慰めてやるべきである。そうしないと、その人はますます深い悲しみに沈むかも知れない。"},{"ref":"2Cor.2.8","start":47002008,"end":47002008,"break":"none","ruby":[[8,1,"かれ"],[10,1,"たい"],[13,1,"あい"],[15,1,"しめ"],[27,1,"すす"]],"text":"そこでわたしは、彼に対して愛を示すように、あなたがたに勧める。"},{"ref":"2Cor.2.9","start":47002009,"end":47002009,"break":"none","ruby":[[4,1,"か"],[23,1,"こと"],[28,2,"じゅうじゅん"]],"text":"わたしが書きおくったのも、あなたがたがすべての事について従順であるかどうかを、ためすためにほかならなかった。"},{"ref":"2Cor.2.10","start":47002010,"end":47002010,"break":"none","ruby":[[9,1,"なに"],[18,1,"ひと"],[47,1,"なに"]],"text":"もしあなたがたが、何かのことについて人をゆるすなら、わたしもまたゆるそう。そして、もしわたしが何かのことでゆるしたとすれば、それは、あなたがたのためにキリストのみまえでゆるしたのである。"},{"ref":"2Cor.2.11","start":47002011,"end":47002011,"break":"none","ruby":[[11,1,"あざむ"],[33,1,"かれ"],[35,2,"さくりゃく"],[38,1,"し"]],"text":"そうするのは、サタンに欺かれることのないためである。わたしたちは、彼の策略を知らないわけではない。"},{"ref":"2Cor.2.12","start":47002012,"end":47002012,"break":"paragraph","ruby":[[8,2,"ふくいん"],[19,1,"い"],[32,1,"しゅ"],[34,1,"もん"],[36,1,"ひら"]],"text":"さて、キリストの福音のためにトロアスに行ったとき、わたしのために主の門が開かれたにもかかわらず、"},{"ref":"2Cor.2.13","start":47002013,"end":47002013,"break":"none","ruby":[[0,2,"きょうだい"],[6,1,"あ"],[19,1,"き"],[21,1,"き"],[26,2,"ひとびと"],[29,1,"わか"],[39,1,"で"],[43,1,"い"]],"text":"兄弟テトスに会えなかったので、わたしは気が気でなく、人々に別れて、マケドニヤに出かけて行った。"},{"ref":"2Cor.2.14","start":47002014,"end":47002014,"break":"none","ruby":[[5,1,"かみ"],[7,2,"かんしゃ"],[15,1,"かみ"],[31,2,"がいせん"],[34,1,"ともな"],[36,1,"ゆ"],[54,1,"し"],[56,2,"ちしき"],[64,1,"いた"],[66,1,"ところ"],[68,1,"はな"],[71,1,"くだ"]],"text":"しかるに、神は感謝すべきかな。神はいつもわたしたちをキリストの凱旋に伴い行き、わたしたちをとおしてキリストを知る知識のかおりを、至る所に放って下さるのである。"},{"ref":"2Cor.2.15","start":47002015,"end":47002015,"break":"none","ruby":[[7,1,"すく"],[11,1,"もの"],[17,1,"ほろ"],[20,1,"もの"],[27,1,"かみ"],[29,1,"たい"]],"text":"わたしたちは、救われる者にとっても滅びる者にとっても、神に対するキリストのかおりである。"},{"ref":"2Cor.2.16","start":47002016,"end":47002016,"break":"none","ruby":[[0,2,"こうしゃ"],[8,1,"し"],[11,1,"し"],[13,1,"いた"],[24,2,"ぜんしゃ"],[41,1,"いた"],[62,2,"にんむ"],[69,1,"た"],[71,1,"え"]],"text":"後者にとっては、死から死に至らせるかおりであり、前者にとっては、いのちからいのちに至らせるかおりである。いったい、このような任務に、だれが耐え得ようか。"},{"ref":"2Cor.2.17","start":47002017,"end":47002017,"break":"none","ruby":[[11,1,"おお"],[14,1,"ひと"],[19,1,"かみ"],[21,1,"ことば"],[23,2,"うりもの"],[29,2,"まごころ"],[36,1,"かみ"],[44,1,"もの"],[48,1,"かみ"],[63,1,"かた"]],"text":"しかし、わたしたちは、多くの人のように神の言を売物にせず、真心をこめて、神につかわされた者として神のみまえで、キリストにあって語るのである。"}]