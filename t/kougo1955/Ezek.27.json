[{"ref":"Ezek.27.1","start":26027001,"end":26027001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.27.2","start":26027002,"end":26027002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[12,1,"かな"],[16,1,"うた"]],"text":"「人の子よ、ツロのために悲しみの歌をのべ、"},{"ref":"Ezek.27.3","start":26027003,"end":26027003,"break":"none","breaks":[[47,"stanza"],[59,"line"]],"ruby":[[0,1,"うみ"],[2,2,"いりぐち"],[5,1,"す"],[9,1,"おお"],[12,2,"うみぞ"],[16,2,"くにぐに"],[19,1,"たみ"],[21,2,"しょうにん"],[29,1,"たい"],[32,1,"い"],[35,1,"しゅ"],[38,1,"かみ"],[42,1,"い"],[55,1,"い"],[64,1,"び"],[66,2,"かんぜん"]],"text":"海の入口に住んで、多くの海沿いの国々の民の商人であるツロに対して言え、主なる神はこう言われる、ツロよ、あなたは言った、『わたしの美は完全である』と。"},{"ref":"Ezek.27.4","start":26027004,"end":26027004,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"さかい"],[6,1,"うみ"],[8,1,"なか"],[17,2,"けんせつ"],[19,1,"しゃ"],[25,1,"び"],[27,2,"かんぜん"]],"text":"あなたの境は海の中にあり、あなたの建設者はあなたの美を完全にした。"},{"ref":"Ezek.27.5","start":26027005,"end":26027005,"break":"line","breaks":[[12,"line"],[25,"line"],[38,"line"]],"ruby":[[0,2,"ひとびと"],[10,1,"き"],[19,2,"ふないた"],[22,1,"つく"],[31,2,"こうはく"],[45,2,"ほばしら"],[48,1,"つく"]],"text":"人々はセニルのもみの木であなたのために船板を造り、レバノンから香柏をとって、あなたのために帆柱を造り、"},{"ref":"Ezek.27.6","start":26027006,"end":26027006,"break":"line","breaks":[[11,"line"],[24,"line"],[44,"line"]],"ruby":[[8,1,"き"],[21,1,"つく"],[28,1,"しま"],[31,1,"く"],[33,1,"まつ"],[35,1,"き"],[37,2,"ぞうげ"],[51,2,"かんぱん"],[54,1,"つく"]],"text":"バシャンのかしの木で、あなたのためにかいを造り、クプロの島から来る松の木に象牙をはめて、あなたのために甲板を造った。"},{"ref":"Ezek.27.7","start":26027007,"end":26027007,"break":"line","breaks":[[22,"line"],[33,"line"],[52,"line"]],"ruby":[[4,1,"ほ"],[12,1,"く"],[16,1,"ぬの"],[26,1,"はた"],[28,1,"もち"],[46,2,"かいがん"],[50,1,"く"],[52,1,"あお"],[54,1,"むらさき"],[56,1,"ぬの"]],"text":"あなたの帆はエジプトから来るあや布であって、あなたの旗に用いられ、あなたのおおいはエリシャの海岸から来る青と紫の布である。"},{"ref":"Ezek.27.8","start":26027008,"end":26027008,"break":"line","breaks":[[9,"line"],[21,"line"],[31,"line"]],"ruby":[[6,1,"て"],[18,2,"じゅうみん"],[40,2,"じゅくれん"],[47,2,"ひとびと"]],"text":"あなたのこぎ手は、シドンとアルワデの住民、あなたのかじとりは、あなたのうちにいる熟練なゼメルの人々である。"},{"ref":"Ezek.27.9","start":26027009,"end":26027009,"break":"line","breaks":[[21,"line"],[36,"line"],[52,"line"]],"ruby":[[4,2,"ろうじん"],[14,2,"じゅくれん"],[17,2,"ひとびと"],[30,1,"も"],[33,1,"つくろ"],[36,1,"うみ"],[42,1,"ふね"],[48,2,"せんいん"],[66,2,"しょうひん"],[69,2,"こうえき"]],"text":"ゲバルの老人たち、およびその熟練な人々は、あなたのうちにいて漏りを繕い、海のすべての船およびその船員らはあなたのうちにいて、あなたの商品を交易する。"},{"ref":"Ezek.27.10","start":26027010,"end":26027010,"break":"paragraph","ruby":[[4,1,"ひと"],[20,1,"ぐん"],[22,1,"くわ"],[31,2,"せんし"],[37,1,"かれ"],[48,1,"たて"],[54,1,"か"],[61,1,"かがや"]],"text":"ペルシャ人、ルデびと、プテびとはあなたの軍に加わって、あなたの戦士となる。彼らはあなたのうちに、盾とかぶとを掛け、あなたに輝きをそえた。"},{"ref":"Ezek.27.11","start":26027011,"end":26027011,"break":"none","ruby":[[9,2,"ひとびと"],[17,2,"しゅうい"],[20,2,"じょうへき"],[23,1,"うえ"],[32,2,"ひとびと"],[44,1,"なか"],[49,1,"かれ"],[57,2,"しゅうい"],[60,2,"じょうへき"],[65,1,"たて"],[67,1,"か"],[75,2,"びかん"],[78,1,"まっと"]],"text":"アルワデとヘレクの人々は、あなたの周囲の城壁の上にあり、ガマデの人々は、あなたのやぐらの中にあり、彼らは、あなたの周囲の城壁にその盾を掛けて、あなたの美観を全うした。"},{"ref":"Ezek.27.12","start":26027012,"end":26027012,"break":"paragraph","ruby":[[10,2,"かもつ"],[13,1,"と"],[28,2,"こうえき"],[34,1,"ぎん"],[36,1,"てつ"],[41,1,"なまり"],[47,2,"しょうひん"],[50,2,"こうかん"]],"text":"あなたはそのすべての貨物に富むゆえに、タルシシはあなたと交易をなし、銀、鉄、すず、鉛をあなたの商品と交換した。"},{"ref":"Ezek.27.13","start":26027013,"end":26027013,"break":"none","ruby":[[19,2,"とりひき"],[23,1,"かれ"],[26,2,"じんしん"],[29,2,"せいどう"],[32,1,"うつわ"],[40,2,"しょうひん"],[43,2,"こうかん"]],"text":"ヤワン、トバル、およびメセクはあなたと取引し、彼らは人身と青銅の器とを、あなたの商品と交換した。"},{"ref":"Ezek.27.14","start":26027014,"end":26027014,"break":"none","ruby":[[8,1,"うま"],[10,2,"ぐんば"],[16,2,"らば"],[23,2,"しょうひん"],[26,2,"こうかん"]],"text":"ベテ・トガルマは馬、軍馬、および騾馬をあなたの商品と交換した。"},{"ref":"Ezek.27.15","start":26027015,"end":26027015,"break":"none","ruby":[[3,1,"とう"],[5,2,"ひとびと"],[12,2,"とりひき"],[16,1,"おお"],[19,2,"うみぞ"],[23,2,"くにぐに"],[31,2,"しじょう"],[37,2,"ぞうげ"],[40,1,"くろ"],[56,1,"も"]],"text":"ローヅ島の人々はあなたと取引し、多くの海沿いの国々は、あなたの市場となり、象牙と黒たんとを、みつぎとしてあなたに持ってきた。"},{"ref":"Ezek.27.16","start":26027016,"end":26027016,"break":"none","ruby":[[4,2,"せいひん"],[7,1,"おお"],[20,2,"しょうばい"],[24,1,"かれ"],[27,2,"あかだま"],[30,1,"むらさき"],[32,1,"ぬ"],[34,1,"と"],[37,1,"ぬの"],[39,1,"ほそ"],[40,1,"ぬの"],[58,2,"しょうひん"],[61,2,"こうかん"]],"text":"あなたの製品が多いので、エドムはあなたと商売し、彼らは赤玉、紫、縫い取りの布、細布、さんご、めのうをもって、あなたの商品と交換した。"},{"ref":"Ezek.27.17","start":26027017,"end":26027017,"break":"none","ruby":[[9,1,"ち"],[16,2,"とりひき"],[20,1,"むぎ"],[31,1,"みつ"],[33,1,"あぶら"],[38,2,"にゅうこう"],[49,2,"しょうひん"],[52,2,"こうかん"]],"text":"ユダとイスラエルの地は、あなたと取引し、麦、オリブ、いちじく、蜜、油、および乳香をもって、あなたの商品と交換した。"},{"ref":"Ezek.27.18","start":26027018,"end":26027018,"break":"none","ruby":[[4,2,"せいひん"],[7,1,"おお"],[14,1,"とみ"],[16,1,"おお"],[30,2,"とりひき"],[39,1,"さけ"],[46,2,"ようもう"]],"text":"あなたの製品が多く、あなたの富が多いので、ダマスコはあなたと取引し、ヘルボンの酒と、さらした羊毛と、"},{"ref":"Ezek.27.19","start":26027019,"end":26027019,"break":"none","ruby":[[4,1,"さけ"],[14,2,"しょうひん"],[17,2,"こうかん"],[21,2,"せんてつ"],[24,2,"にっけい"],[27,2,"しょうぶ"],[38,2,"しょうひん"],[41,2,"こうえき"]],"text":"ウザルの酒をもって、あなたの商品と交換し、銑鉄、肉桂、菖蒲をもって、あなたの商品と交易した。"},{"ref":"Ezek.27.20","start":26027020,"end":26027020,"break":"none","ruby":[[4,2,"のりもの"],[7,1,"くら"],[8,1,"しき"],[18,2,"とりひき"]],"text":"デダンは乗物の鞍敷をもって、あなたと取引した。"},{"ref":"Ezek.27.21","start":26027021,"end":26027021,"break":"none","ruby":[[18,1,"きみ"],[22,2,"こひつじ"],[25,2,"おひつじ"],[39,2,"とりひき"],[47,1,"もの"],[53,2,"こうえき"]],"text":"アラビヤびと、およびケダルのすべての君たちは小羊、雄羊、やぎをもって、あなたと取引し、これらの物をあなたと交易した。"},{"ref":"Ezek.27.22","start":26027022,"end":26027022,"break":"none","ruby":[[7,2,"しょうにん"],[15,2,"とりひき"],[24,1,"たっと"],[26,2,"こうりょう"],[35,2,"ほうせき"],[38,1,"きん"],[49,2,"しょうひん"],[52,2,"こうかん"]],"text":"シバとラアマの商人は、あなたと取引し、もろもろの尊い香料と、もろもろの宝石と金とをもって、あなたの商品と交換した。"},{"ref":"Ezek.27.23","start":26027023,"end":26027023,"break":"none","ruby":[[27,2,"とりひき"]],"text":"ハラン、カンネ、エデン、アッスリヤ、キルマデはあなたと取引した。"},{"ref":"Ezek.27.24","start":26027024,"end":26027024,"break":"none","ruby":[[0,1,"かれ"],[9,2,"いふく"],[13,1,"あお"],[15,1,"ぬ"],[17,1,"と"],[21,1,"ぬの"],[27,1,"むす"],[38,2,"しきもの"],[51,2,"とりひき"]],"text":"彼らは、はなやかな衣服と、青く縫い取りした布と、ひもで結んで、じょうぶにした敷物などをもって、あなたと取引した。"},{"ref":"Ezek.27.25","start":26027025,"end":26027025,"break":"none","breaks":[[22,"stanza"]],"ruby":[[5,1,"ふね"],[11,2,"しょうひん"],[14,1,"はこ"],[26,1,"うみ"],[28,1,"なか"],[32,1,"み"],[34,1,"た"],[40,1,"さか"]],"text":"タルシシの船はあなたの商品を運んでまわった。あなたは海の中にいて満ち足り、いたく栄えた。"},{"ref":"Ezek.27.26","start":26027026,"end":26027026,"break":"line","breaks":[[21,"line"]],"ruby":[[6,1,"て"],[13,2,"たいかい"],[16,1,"なか"],[18,1,"すす"],[21,1,"うみ"],[23,1,"なか"],[25,2,"ひがしかぜ"],[32,1,"ふね"],[34,1,"やぶ"]],"text":"あなたのこぎ手らはあなたを大海の中に進め、海の中で東風があなたの船を破った。"},{"ref":"Ezek.27.27","start":26027027,"end":26027027,"break":"line","breaks":[[21,"line"],[37,"line"],[59,"line"],[74,"line"],[91,"line"]],"ruby":[[4,2,"ざいほう"],[11,2,"かもつ"],[18,2,"しょうひん"],[25,2,"せんいん"],[34,1,"と"],[41,1,"も"],[44,1,"つくろ"],[46,1,"もの"],[52,2,"しょうひん"],[55,1,"あきな"],[57,1,"もの"],[63,1,"なか"],[71,2,"ぐんじん"],[78,1,"なか"],[86,2,"なかま"],[89,1,"みな"],[95,2,"はめつ"],[98,1,"ひ"],[100,1,"うみ"],[102,1,"なか"],[104,1,"しず"]],"text":"あなたの財宝、あなたの貨物、あなたの商品、あなたの船員、あなたのかじ取り、あなたの漏りを繕う者、あなたの商品を商う者、あなたの中にいるすべての軍人、あなたの中にいるすべての仲間は皆、あなたの破滅の日に海の中に沈む。"},{"ref":"Ezek.27.28","start":26027028,"end":26027028,"break":"line","ruby":[[6,1,"と"],[9,1,"さけ"],[11,1,"ごえ"],[14,2,"きんごう"],[17,1,"ふる"]],"text":"あなたのかじ取りの叫び声に、近郷は震い、"},{"ref":"Ezek.27.29","start":26027029,"end":26027029,"break":"line","breaks":[[17,"line"]],"ruby":[[8,1,"もの"],[10,1,"ふね"],[17,2,"せんいん"],[22,1,"うみ"],[30,1,"と"],[33,1,"うみ"],[36,1,"た"]],"text":"すべてかいをとる者は船からくだる。船員および海のすべてのかじ取りは海べに立ち、"},{"ref":"Ezek.27.30","start":26027030,"end":26027030,"break":"line","breaks":[[22,"line"]],"ruby":[[7,1,"こえ"],[12,1,"な"],[19,1,"さけ"],[33,1,"はい"],[35,1,"なか"]],"text":"あなたのために声をあげて泣き、はげしく叫び、ちりをこうべにかぶり、灰の中にまろび、"},{"ref":"Ezek.27.31","start":26027031,"end":26027031,"break":"line","breaks":[[19,"line"]],"ruby":[[7,1,"かみ"],[12,2,"あらぬの"],[26,1,"こころ"],[28,1,"いた"],[31,1,"な"],[38,1,"なげ"]],"text":"あなたのために髪をそり、荒布をまとい、あなたのために心を痛めて泣き、はげしく嘆く。"},{"ref":"Ezek.27.32","start":26027032,"end":26027032,"break":"line","breaks":[[24,"line"],[34,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かな"],[15,1,"かな"],[19,1,"うた"],[28,1,"とむら"],[31,1,"い"],[44,1,"うみ"],[46,1,"なか"],[48,1,"ほろ"]],"text":"彼らは悲しんで、あなたのために悲しみの歌をのべ、あなたを弔って言う、『だれかツロのように海の中で滅びたものがあるか。"},{"ref":"Ezek.27.33","start":26027033,"end":26027033,"break":"line","breaks":[[16,"line"],[29,"line"],[47,"line"]],"ruby":[[4,2,"しょうひん"],[7,1,"うみ"],[9,1,"こ"],[14,1,"とき"],[20,1,"おお"],[23,1,"たみ"],[25,1,"あ"],[33,1,"おお"],[36,2,"ざいほう"],[39,2,"しょうひん"],[47,1,"ち"],[49,1,"おう"],[53,1,"と"]],"text":"あなたの商品が海を越えてきた時、あなたは多くの民を飽かせ、あなたの多くの財宝と商品とをもって、地の王たちを富ませた。"},{"ref":"Ezek.27.34","start":26027034,"end":26027034,"break":"line","breaks":[[18,"line"],[39,"line"]],"ruby":[[0,1,"いま"],[5,1,"うみ"],[7,2,"はせん"],[11,1,"ふか"],[13,1,"みず"],[15,1,"しず"],[22,2,"しょうひん"],[34,2,"せんいん"],[43,1,"とも"],[45,1,"しず"]],"text":"今あなたは海で破船し、深い水に沈み、あなたの商品と、あなたのすべての船員とは、あなたと共に沈んだ。"},{"ref":"Ezek.27.35","start":26027035,"end":26027035,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"うみぞ"],[4,2,"くにぐに"],[7,1,"す"],[9,1,"もの"],[11,1,"みな"],[19,1,"おどろ"],[24,1,"おう"],[28,1,"おお"],[31,1,"おそ"],[36,1,"かお"],[38,1,"ふる"]],"text":"海沿いの国々に住む者は皆あなたについて驚き、その王たちは大いに恐れてその顔を震わす。"},{"ref":"Ezek.27.36","start":26027036,"end":26027036,"break":"line","breaks":[[22,"line"],[36,"line"]],"ruby":[[5,1,"たみ"],[7,1,"なか"],[9,2,"しょうにん"],[26,1,"おそ"],[30,1,"おわ"],[33,1,"と"],[36,2,"えいえん"]],"text":"もろもろの民の中の商人らはあなたをあざける。あなたは恐るべき終りを遂げ、永遠にうせはてる』」。"}]