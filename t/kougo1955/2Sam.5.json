[{"ref":"2Sam.5.1","start":10005001,"end":10005001,"break":"paragraph","ruby":[[10,2,"ぶぞく"],[29,1,"い"],[44,2,"こつにく"]],"text":"イスラエルのすべての部族はヘブロンにいるダビデのもとにきて言った、「われわれは、あなたの骨肉です。"},{"ref":"2Sam.5.2","start":10005002,"end":10005002,"break":"none","ruby":[[0,1,"さき"],[11,1,"おう"],[16,1,"とき"],[30,1,"ひき"],[33,2,"でい"],[45,1,"しゅ"],[61,1,"たみ"],[68,1,"ぼく"],[88,1,"きみ"],[98,1,"い"]],"text":"先にサウルがわれわれの王であった時にも、あなたはイスラエルを率いて出入りされました。そして主はあなたに、『あなたはわたしの民イスラエルを牧するであろう。またあなたはイスラエルの君となるであろう』と言われました」。"},{"ref":"2Sam.5.3","start":10005003,"end":10005003,"break":"none","ruby":[[11,2,"ちょうろう"],[16,1,"みな"],[25,1,"おう"],[38,1,"おう"],[45,1,"しゅ"],[47,1,"まえ"],[49,1,"かれ"],[52,2,"けいやく"],[55,1,"むす"],[62,1,"かれ"],[69,1,"あぶら"],[71,1,"そそ"],[80,1,"おう"]],"text":"このようにイスラエルの長老たちが皆、ヘブロンにいる王のもとにきたので、ダビデ王はヘブロンで主の前に彼らと契約を結んだ。そして彼らはダビデに油を注いでイスラエルの王とした。"},{"ref":"2Sam.5.4","start":10005004,"end":10005004,"break":"none","ruby":[[4,1,"おう"],[13,1,"さい"],[18,1,"ねん"],[20,1,"あいだ"],[22,1,"よ"],[24,1,"おさ"]],"text":"ダビデは王となったとき三十歳で、四十年の間、世を治めた。"},{"ref":"2Sam.5.5","start":10005005,"end":10005005,"break":"none","ruby":[[10,1,"ねん"],[13,1,"げつ"],[17,1,"おさ"],[31,1,"ねん"],[33,1,"ぜん"],[43,1,"おさ"]],"text":"すなわちヘブロンで七年六か月ユダを治め、またエルサレムで三十三年、全イスラエルとユダを治めた。"},{"ref":"2Sam.5.6","start":10005006,"end":10005006,"break":"paragraph","ruby":[[0,1,"おう"],[4,2,"じゅうしゃ"],[16,1,"い"],[22,1,"ち"],[24,2,"じゅうみん"],[32,1,"せ"],[46,1,"い"],[63,1,"せ"],[65,1,"い"],[84,1,"あし"],[94,1,"お"],[96,1,"はら"],[104,1,"かれ"],[115,1,"せ"],[117,1,"い"],[128,1,"おも"]],"text":"王とその従者たちとはエルサレムへ行って、その地の住民エブスびとを攻めた。エブスびとはダビデに言った、「あなたはけっして、ここに攻め入ることはできない。かえって、めしいや足なえでも、あなたを追い払うであろう」。彼らが「ダビデはここに攻め入ることはできない」と思ったからである。"},{"ref":"2Sam.5.7","start":10005007,"end":10005007,"break":"none","ruby":[[12,2,"ようがい"],[15,1,"と"],[26,1,"まち"]],"text":"ところがダビデはシオンの要害を取った。これがダビデの町である。"},{"ref":"2Sam.5.8","start":10005008,"end":10005008,"break":"none","ruby":[[2,1,"ひ"],[19,1,"う"],[25,1,"ひと"],[28,1,"みず"],[32,1,"あ"],[35,2,"たてあな"],[38,1,"のぼ"],[41,1,"い"],[49,1,"こころ"],[51,1,"にく"],[56,1,"あし"],[64,1,"う"],[68,1,"い"],[77,2,"ひとびと"],[86,1,"あし"],[91,1,"みや"],[104,1,"い"]],"text":"その日ダビデは、「だれでもエブスびとを撃とうとする人は、水をくみ上げる縦穴を上って行って、ダビデが心に憎んでいる足なえやめしいを撃て」と言った。それゆえに人々は、「めしいや足なえは、宮にはいってはならない」と言いならわしている。"},{"ref":"2Sam.5.9","start":10005009,"end":10005009,"break":"none","ruby":[[6,2,"ようがい"],[9,1,"す"],[20,1,"まち"],[22,1,"な"],[37,1,"うち"],[39,2,"しゅうい"],[42,2,"じょうへき"],[45,1,"きず"]],"text":"ダビデはその要害に住んで、これをダビデの町と名づけた。またダビデはミロから内の周囲に城壁を築いた。"},{"ref":"2Sam.5.10","start":10005010,"end":10005010,"break":"none","ruby":[[12,1,"おお"],[16,1,"もの"],[23,2,"ばんぐん"],[26,1,"かみ"],[28,1,"しゅ"],[30,1,"かれ"],[32,1,"とも"]],"text":"こうしてダビデはますます大いなる者となり、かつ万軍の神、主が彼と共におられた。"},{"ref":"2Sam.5.11","start":10005011,"end":10005011,"break":"paragraph","ruby":[[3,1,"おう"],[12,2,"ししゃ"],[21,2,"こうはく"],[26,2,"だいく"],[29,2,"いしく"],[32,1,"おく"],[36,1,"かれ"],[46,1,"いえ"],[48,1,"た"]],"text":"ツロの王ヒラムはダビデに使者をつかわして、香柏および大工と石工を送った。彼らはダビデのために家を建てた。"},{"ref":"2Sam.5.12","start":10005012,"end":10005012,"break":"none","ruby":[[7,1,"しゅ"],[9,2,"じぶん"],[12,1,"かた"],[14,1,"た"],[23,1,"おう"],[31,1,"しゅ"],[35,1,"たみ"],[47,2,"おうこく"],[50,1,"おこ"],[57,1,"さと"]],"text":"そしてダビデは主が自分を堅く立ててイスラエルの王とされたこと、主がその民イスラエルのためにその王国を興されたことを悟った。"},{"ref":"2Sam.5.13","start":10005013,"end":10005013,"break":"paragraph","ruby":[[12,1,"のち"],[23,1,"つま"],[29,1,"い"],[39,1,"むすめ"],[47,1,"うま"]],"text":"ダビデはヘブロンからきて後、さらにエルサレムで妻とそばめを入れたので、むすこと娘がまたダビデに生れた。"},{"ref":"2Sam.5.14","start":10005014,"end":10005014,"break":"none","ruby":[[6,1,"かれ"],[8,1,"うま"],[11,1,"もの"],[13,1,"な"],[15,1,"つぎ"]],"text":"エルサレムで彼に生れた者の名は次のとおりである。シャンムア、ショバブ、ナタン、ソロモン、"},{"ref":"2Sam.5.15","start":10005015,"end":10005015,"break":"none","text":"イブハル、エリシュア、ネペグ、ヤピア、"},{"ref":"2Sam.5.16","start":10005016,"end":10005016,"break":"none","text":"エリシャマ、エリアダ、およびエリペレテ。"},{"ref":"2Sam.5.17","start":10005017,"end":10005017,"break":"paragraph","ruby":[[14,1,"あぶら"],[16,1,"そそ"],[26,1,"おう"],[34,1,"き"],[39,1,"のぼ"],[48,1,"さが"],[60,1,"き"],[63,2,"ようがい"],[66,1,"くだ"],[69,1,"い"]],"text":"さてペリシテびとは、ダビデが油を注がれてイスラエルの王になったことを聞き、みな上ってきてダビデを捜したが、ダビデはそれを聞いて要害に下って行った。"},{"ref":"2Sam.5.18","start":10005018,"end":10005018,"break":"none","ruby":[[15,1,"たに"],[17,1,"ひろ"]],"text":"ペリシテびとはきて、レパイムの谷に広がっていた。"},{"ref":"2Sam.5.19","start":10005019,"end":10005019,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"と"],[9,1,"い"],[21,1,"む"],[25,1,"のぼ"],[39,1,"かれ"],[46,1,"て"],[48,1,"わた"],[59,1,"しゅ"],[65,1,"い"],[71,1,"のぼ"],[96,1,"て"],[98,1,"わた"]],"text":"ダビデは主に問うて言った、「ペリシテびとに向かって上るべきでしょうか。あなたは彼らをわたしの手に渡されるでしょうか」。主はダビデに言われた、「上るがよい。わたしはかならずペリシテびとをあなたの手に渡すであろう」。"},{"ref":"2Sam.5.20","start":10005020,"end":10005020,"break":"none","ruby":[[16,1,"い"],[20,1,"かれ"],[25,1,"ところ"],[27,1,"う"],[29,1,"やぶ"],[35,1,"い"],[40,1,"しゅ"],[43,1,"やぶ"],[45,1,"で"],[47,1,"みず"],[53,1,"てき"],[59,1,"まえ"],[61,1,"やぶ"],[74,1,"ところ"],[76,1,"な"],[87,1,"よ"]],"text":"そこでダビデはバアル・ペラジムへ行って、彼らをその所で撃ち破り、そして言った、「主は、破り出る水のように、敵をわたしの前に破られた」。それゆえにその所の名はバアル・ペラジムと呼ばれている。"},{"ref":"2Sam.5.21","start":10005021,"end":10005021,"break":"none","ruby":[[9,1,"ところ"],[11,1,"かれ"],[14,2,"ぐうぞう"],[17,1,"す"],[20,1,"い"],[32,2,"じゅうしゃ"],[40,1,"はこ"],[42,1,"さ"]],"text":"ペリシテびとはその所に彼らの偶像を捨てて行ったので、ダビデとその従者たちはそれを運び去った。"},{"ref":"2Sam.5.22","start":10005022,"end":10005022,"break":"paragraph","ruby":[[12,1,"のぼ"],[23,1,"たに"],[25,1,"ひろ"]],"text":"ペリシテびとが、ふたたび上ってきて、レパイムの谷に広がったので、"},{"ref":"2Sam.5.23","start":10005023,"end":10005023,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"と"],[11,1,"しゅ"],[13,1,"い"],[19,1,"のぼ"],[28,1,"かれ"],[35,1,"まわ"],[43,1,"き"],[45,1,"まえ"],[48,1,"かれ"],[51,1,"おそ"]],"text":"ダビデは主に問うたが、主は言われた、「上ってはならない。彼らのうしろに回り、バルサムの木の前から彼らを襲いなさい。"},{"ref":"2Sam.5.24","start":10005024,"end":10005024,"break":"none","ruby":[[5,1,"き"],[7,1,"うえ"],[9,2,"こうしん"],[12,1,"おと"],[14,1,"きこ"],[25,1,"ふる"],[27,1,"た"],[40,1,"とき"],[42,1,"しゅ"],[48,1,"まえ"],[50,1,"で"],[60,2,"ぐんぜい"],[63,1,"う"]],"text":"バルサムの木の上に行進の音が聞えたならば、あなたは奮い立たなければならない。その時、主があなたの前に出て、ペリシテびとの軍勢を撃たれるからである」。"},{"ref":"2Sam.5.25","start":10005025,"end":10005025,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"めい"],[25,1,"う"],[36,1,"およ"]],"text":"ダビデは、主が命じられたようにして、ペリシテびとを撃ち、ゲバからゲゼルに及んだ。"}]