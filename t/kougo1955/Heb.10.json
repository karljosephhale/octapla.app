[{"ref":"Heb.10.1","start":58010001,"end":58010001,"break":"paragraph","ruby":[[5,2,"りっぽう"],[13,1,"よ"],[18,1,"かげ"],[33,1,"しん"],[54,1,"とし"],[58,1,"ひ"],[69,1,"おな"],[88,1,"ちか"],[92,1,"く"],[94,1,"もの"],[99,1,"まっと"]],"text":"いったい、律法はきたるべき良いことの影をやどすにすぎず、そのものの真のかたちをそなえているものではないから、年ごとに引きつづきささげられる同じようないけにえによっても、みまえに近づいて来る者たちを、全うすることはできないのである。"},{"ref":"Heb.10.2","start":58010002,"end":58010002,"break":"none","ruby":[[10,2,"ぎしき"],[18,1,"もの"],[24,1,"ど"],[31,2,"いじょう"],[37,1,"つみ"],[39,2,"じかく"],[56,1,"もの"]],"text":"もしできたとすれば、儀式にたずさわる者たちは、一度きよめられた以上、もはや罪の自覚がなくなるのであるから、ささげ物をすることがやんだはずではあるまいか。"},{"ref":"Heb.10.3","start":58010003,"end":58010003,"break":"none","ruby":[[3,2,"じっさい"],[7,1,"とし"],[20,1,"つみ"],[22,1,"おも"],[24,1,"で"],[32,1,"く"]],"text":"しかし実際は、年ごとに、いけにえによって罪の思い出がよみがえって来るのである。"},{"ref":"Heb.10.4","start":58010004,"end":58010004,"break":"none","ruby":[[5,1,"お"],[6,1,"うし"],[13,1,"ち"],[16,1,"つみ"],[18,1,"のぞ"],[20,1,"さ"]],"text":"なぜなら、雄牛ややぎなどの血は、罪を除き去ることができないからである。"},{"ref":"Heb.10.5","start":58010005,"end":58010005,"break":"none","breaks":[[32,"stanza"],[55,"line"]],"ruby":[[13,1,"よ"],[22,1,"つぎ"],[27,1,"い"],[46,1,"もの"],[48,1,"のぞ"],[67,1,"そな"],[70,1,"くだ"]],"text":"それだから、キリストがこの世にこられたとき、次のように言われた、「あなたは、いけにえやささげ物を望まれないで、わたしのために、からだを備えて下さった。"},{"ref":"Heb.10.6","start":58010006,"end":58010006,"break":"line","ruby":[[4,2,"はんさい"],[7,2,"ざいさい"],[10,1,"この"]],"text":"あなたは燔祭や罪祭を好まれなかった。"},{"ref":"Heb.10.7","start":58010007,"end":58010007,"break":"line","breaks":[[12,"line"],[23,"line"],[38,"line"]],"ruby":[[2,1,"とき"],[8,1,"い"],[13,1,"かみ"],[23,2,"まきもの"],[26,2,"しょもつ"],[29,1,"か"],[38,1,"み"],[41,2,"みむね"],[44,1,"おこな"]],"text":"その時、わたしは言った、『神よ、わたしにつき、巻物の書物に書いてあるとおり、見よ、御旨を行うためにまいりました』」。"},{"ref":"Heb.10.8","start":58010008,"end":58010008,"break":"paragraph","ruby":[[4,1,"はじ"],[22,1,"もの"],[24,2,"はんさい"],[27,2,"ざいさい"],[36,2,"りっぽう"],[39,1,"したが"],[52,1,"のぞ"],[57,1,"この"]],"text":"ここで、初めに、「あなたは、いけにえとささげ物と燔祭と罪祭と（すなわち、律法に従ってささげられるもの）を望まれず、好まれもしなかった」とあり、"},{"ref":"Heb.10.9","start":58010009,"end":58010009,"break":"none","ruby":[[0,1,"つぎ"],[4,1,"み"],[11,2,"みむね"],[14,1,"おこな"],[35,1,"かれ"],[38,1,"のち"],[43,1,"た"],[50,1,"はじ"],[56,2,"はいし"]],"text":"次に、「見よ、わたしは御旨を行うためにまいりました」とある。すなわち、彼は、後のものを立てるために、初めのものを廃止されたのである。"},{"ref":"Heb.10.10","start":58010010,"end":58010010,"break":"none","ruby":[[2,2,"みむね"],[5,1,"もとづ"],[10,1,"ど"]],"text":"この御旨に基きただ一度イエス・キリストのからだがささげられたことによって、わたしたちはきよめられたのである。"},{"ref":"Heb.10.11","start":58010011,"end":58010011,"break":"paragraph","ruby":[[9,2,"さいし"],[12,1,"た"],[15,1,"ひ"],[19,2,"ぎしき"],[22,1,"おこな"],[29,1,"おな"],[49,1,"けっ"],[52,1,"つみ"],[54,1,"のぞ"],[56,1,"さ"]],"text":"こうして、すべての祭司は立って日ごとに儀式を行い、たびたび同じようないけにえをささげるが、それらは決して罪を除き去ることはできない。"},{"ref":"Heb.10.12","start":58010012,"end":58010012,"break":"none","ruby":[[10,1,"おお"],[13,1,"つみ"],[21,2,"えいえん"],[33,1,"のち"],[35,1,"かみ"],[37,1,"みぎ"],[39,1,"ざ"]],"text":"しかるに、キリストは多くの罪のために一つの永遠のいけにえをささげた後、神の右に座し、"},{"ref":"Heb.10.13","start":58010013,"end":58010013,"break":"none","ruby":[[5,1,"てき"],[9,1,"あし"],[10,1,"だい"],[19,1,"ま"]],"text":"それから、敵をその足台とするときまで、待っておられる。"},{"ref":"Heb.10.14","start":58010014,"end":58010014,"break":"none","ruby":[[0,1,"かれ"],[8,1,"もの"],[20,1,"もの"],[24,2,"えいえん"],[27,1,"まっと"]],"text":"彼は一つのささげ物によって、きよめられた者たちを永遠に全うされたのである。"},{"ref":"Heb.10.15","start":58010015,"end":58010015,"break":"none","ruby":[[0,2,"せいれい"]],"text":"聖霊もまた、わたしたちにあかしをして、"},{"ref":"Heb.10.16","start":58010016,"end":58010016,"break":"stanza","breaks":[[14,"line"],[37,"line"],[44,"line"],[59,"line"]],"ruby":[[10,1,"ひ"],[12,1,"のち"],[14,1,"かれ"],[17,1,"たい"],[20,1,"た"],[27,2,"けいやく"],[37,1,"しゅ"],[39,1,"い"],[48,2,"りっぽう"],[51,1,"かれ"],[54,1,"こころ"],[56,1,"あた"],[59,1,"かれ"],[62,1,"おも"],[68,1,"か"],[76,1,"い"]],"text":"「わたしが、それらの日の後、彼らに対して立てようとする契約はこれであると、主が言われる。わたしの律法を彼らの心に与え、彼らの思いのうちに書きつけよう」と言い、"},{"ref":"Heb.10.17","start":58010017,"end":58010017,"break":"none","ruby":[[9,1,"かれ"],[12,1,"つみ"],[14,1,"かれ"],[17,2,"ふほう"],[22,1,"おも"],[24,1,"だ"],[34,1,"の"]],"text":"さらに、「もはや、彼らの罪と彼らの不法とを、思い出すことはしない」と述べている。"},{"ref":"Heb.10.18","start":58010018,"end":58010018,"break":"none","ruby":[[7,1,"たい"],[16,2,"いじょう"],[19,1,"つみ"],[27,1,"もの"],[35,1,"え"]],"text":"これらのことに対するゆるしがある以上、罪のためのささげ物は、もはやあり得ない。"},{"ref":"Heb.10.19","start":58010019,"end":58010019,"break":"paragraph","ruby":[[0,2,"きょうだい"],[24,1,"ち"],[38,2,"せいじょ"]],"text":"兄弟たちよ。こういうわけで、わたしたちはイエスの血によって、はばかることなく聖所にはいることができ、"},{"ref":"Heb.10.20","start":58010020,"end":58010020,"break":"none","ruby":[[0,1,"かれ"],[2,2,"にくたい"],[6,1,"まく"],[21,1,"ひら"],[24,1,"くだ"],[28,1,"あたら"],[31,1,"い"],[34,1,"みち"],[45,1,"ゆ"]],"text":"彼の肉体なる幕をとおり、わたしたちのために開いて下さった新しい生きた道をとおって、はいって行くことができるのであり、"},{"ref":"Heb.10.21","start":58010021,"end":58010021,"break":"none","ruby":[[4,1,"かみ"],[6,1,"いえ"],[8,1,"おさ"],[11,1,"おお"],[15,2,"さいし"]],"text":"さらに、神の家を治める大いなる祭司があるのだから、"},{"ref":"Heb.10.22","start":58010022,"end":58010022,"break":"none","ruby":[[0,1,"こころ"],[7,2,"りょうしん"],[14,1,"さ"],[21,1,"きよ"],[23,1,"みず"],[25,1,"あら"],[37,2,"しんこう"],[40,2,"かくしん"],[43,1,"み"],[54,1,"ちか"]],"text":"心はすすがれて良心のとがめを去り、からだは清い水で洗われ、まごころをもって信仰の確信に満たされつつ、みまえに近づこうではないか。"},{"ref":"Heb.10.23","start":58010023,"end":58010023,"break":"none","ruby":[[3,2,"やくそく"],[8,1,"くだ"],[14,2,"ちゅうじつ"],[31,2,"こくはく"],[35,1,"のぞ"],[39,1,"うご"],[50,1,"も"],[52,1,"つづ"]],"text":"また、約束をして下さったのは忠実なかたであるから、わたしたちの告白する望みを、動くことなくしっかりと持ち続け、"},{"ref":"Heb.10.24","start":58010024,"end":58010024,"break":"none","ruby":[[0,1,"あい"],[2,2,"ぜんこう"],[6,1,"はげ"],[11,1,"たがい"],[13,1,"つと"]],"text":"愛と善行とを励むように互に努め、"},{"ref":"Heb.10.25","start":58010025,"end":58010025,"break":"none","ruby":[[2,1,"ひと"],[17,2,"しゅうかい"],[30,1,"たがい"],[32,1,"はげ"],[38,1,"ひ"],[40,1,"ちか"],[48,1,"み"]],"text":"ある人たちがいつもしているように、集会をやめることはしないで互に励まし、かの日が近づいているのを見て、ますます、そうしようではないか。"},{"ref":"Heb.10.26","start":58010026,"end":58010026,"break":"paragraph","ruby":[[9,2,"しんり"],[12,2,"ちしき"],[15,1,"う"],[30,1,"つみ"],[32,1,"おか"],[41,1,"つみ"],[57,1,"え"]],"text":"もしわたしたちが、真理の知識を受けたのちにもなお、ことさらに罪を犯しつづけるなら、罪のためのいけにえは、もはやあり得ない。"},{"ref":"Heb.10.27","start":58010027,"end":58010027,"break":"none","ruby":[[8,1,"さか"],[11,1,"もの"],[15,1,"や"],[20,1,"はげ"],[23,1,"ひ"],[27,1,"おそ"],[31,1,"ま"]],"text":"ただ、さばきと、逆らう者たちを焼きつくす激しい火とを、恐れつつ待つことだけがある。"},{"ref":"Heb.10.28","start":58010028,"end":58010028,"break":"none","ruby":[[4,2,"りっぽう"],[7,2,"むし"],[11,1,"もの"],[19,1,"う"],[32,1,"ひと"],[34,2,"しょうげん"],[37,1,"もとづ"],[40,2,"しけい"],[43,1,"しょ"]],"text":"モーセの律法を無視する者が、あわれみを受けることなしに、二、三の人の証言に基いて死刑に処せられるとすれば、"},{"ref":"Heb.10.29","start":58010029,"end":58010029,"break":"none","ruby":[[0,1,"かみ"],[2,1,"こ"],[4,1,"ふ"],[9,2,"じぶん"],[18,2,"けいやく"],[21,1,"ち"],[23,1,"けが"],[34,1,"めぐ"],[37,2,"みたま"],[40,1,"あなど"],[42,1,"もの"],[50,1,"おも"],[52,2,"けいばつ"],[55,1,"あたい"]],"text":"神の子を踏みつけ、自分がきよめられた契約の血を汚れたものとし、さらに恵みの御霊を侮る者は、どんなにか重い刑罰に価することであろう。"},{"ref":"Heb.10.30","start":58010030,"end":58010030,"break":"none","ruby":[[1,2,"ふくしゅう"],[19,2,"じしん"],[22,2,"ほうふく"],[28,1,"い"],[35,1,"しゅ"],[39,1,"たみ"],[48,1,"い"],[62,1,"し"]],"text":"「復讐はわたしのすることである。わたし自身が報復する」と言われ、また「主はその民をさばかれる」と言われたかたを、わたしたちは知っている。"},{"ref":"Heb.10.31","start":58010031,"end":58010031,"break":"none","ruby":[[0,1,"い"],[3,1,"かみ"],[6,1,"て"],[11,1,"お"],[17,1,"おそ"]],"text":"生ける神のみ手のうちに落ちるのは、恐ろしいことである。"},{"ref":"Heb.10.32","start":58010032,"end":58010032,"break":"paragraph","ruby":[[7,1,"ひかり"],[9,1,"てら"],[16,1,"くる"],[19,1,"おお"],[22,1,"たたか"],[27,1,"た"],[30,1,"はじ"],[40,1,"おも"],[42,1,"だ"]],"text":"あなたがたは、光に照されたのち、苦しい大きな戦いによく耐えた初めのころのことを、思い出してほしい。"},{"ref":"Heb.10.33","start":58010033,"end":58010033,"break":"none","ruby":[[4,1,"くる"],[10,1,"み"],[12,1,"もの"],[31,1,"あ"],[34,2,"ひとびと"],[37,2,"なかま"]],"text":"そしられ苦しめられて見せ物にされたこともあれば、このようなめに会った人々の仲間にされたこともあった。"},{"ref":"Heb.10.34","start":58010034,"end":58010034,"break":"none","ruby":[[3,1,"ごく"],[5,1,"い"],[10,2,"ひとびと"],[13,1,"おも"],[28,2,"えいえん"],[31,1,"たから"],[33,1,"も"],[41,1,"し"],[45,2,"じぶん"],[48,2,"ざいさん"],[51,1,"うば"],[56,1,"よろこ"],[62,1,"しの"]],"text":"さらに獄に入れられた人々を思いやり、また、もっとまさった永遠の宝を持っていることを知って、自分の財産が奪われても喜んでそれを忍んだ。"},{"ref":"Heb.10.35","start":58010035,"end":58010035,"break":"none","ruby":[[10,2,"じぶん"],[13,1,"も"],[18,2,"かくしん"],[21,2,"ほうき"],[33,2,"かくしん"],[37,1,"おお"],[40,1,"むく"],[43,1,"ともな"]],"text":"だから、あなたがたは自分の持っている確信を放棄してはいけない。その確信には大きな報いが伴っているのである。"},{"ref":"Heb.10.36","start":58010036,"end":58010036,"break":"none","ruby":[[0,1,"かみ"],[2,2,"みむね"],[5,1,"おこな"],[8,2,"やくそく"],[14,1,"う"],[26,2,"ひつよう"],[32,2,"にんたい"]],"text":"神の御旨を行って約束のものを受けるため、あなたがたに必要なのは、忍耐である。"},{"ref":"Heb.10.37","start":58010037,"end":58010037,"break":"stanza","breaks":[[11,"line"],[26,"line"]],"ruby":[[20,1,"み"],[26,1,"おそ"]],"text":"「もうしばらくすれば、きたるべきかたがお見えになる。遅くなることはない。"},{"ref":"Heb.10.38","start":58010038,"end":58010038,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[2,2,"ぎじん"],[6,2,"しんこう"],[12,1,"い"],[18,2,"しんこう"],[21,1,"す"],[39,1,"よろこ"]],"text":"わが義人は、信仰によって生きる。もし信仰を捨てるなら、わたしのたましいはこれを喜ばない」。"},{"ref":"Heb.10.39","start":58010039,"end":58010039,"break":"paragraph","ruby":[[10,2,"しんこう"],[13,1,"す"],[16,1,"ほろ"],[19,1,"もの"],[25,2,"しんこう"],[28,1,"た"],[36,1,"え"],[38,1,"もの"]],"text":"しかしわたしたちは、信仰を捨てて滅びる者ではなく、信仰に立って、いのちを得る者である。"}]