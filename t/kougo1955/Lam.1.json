[{"ref":"Lam.1.1","start":25001001,"end":25001001,"break":"paragraph","breaks":[[8,"line"],[21,"line"],[42,"line"],[64,"line"],[82,"line"]],"ruby":[[8,1,"たみ"],[10,1,"み"],[19,1,"みやこ"],[21,2,"くにぐに"],[24,1,"たみ"],[29,1,"おお"],[33,1,"もの"],[40,1,"まち"],[42,1,"いま"],[44,1,"さび"],[50,1,"ざ"],[69,1,"まち"],[74,2,"じょおう"],[80,1,"もの"],[82,1,"いま"],[84,2,"どれい"]],"text":"ああ、むかしは、民の満ちみちていたこの都、国々の民のうちで大いなる者であったこの町、今は寂しいさまで座し、やもめのようになった。もろもろの町のうちで女王であった者、今は奴隷となった。"},{"ref":"Lam.1.2","start":25001002,"end":25001002,"break":"line","breaks":[[17,"line"],[31,"line"],[47,"line"],[62,"line"]],"ruby":[[3,1,"よ"],[11,1,"な"],[13,1,"かな"],[23,1,"なみだ"],[25,1,"なが"],[37,1,"あい"],[40,1,"もの"],[50,1,"なぐさ"],[53,1,"もの"],[68,1,"とも"],[80,1,"てき"]],"text":"これは夜もすがらいたく泣き悲しみ、そのほおには涙が流れている。そのすべての愛する者のうちには、これを慰める者はひとりもなく、そのすべての友はこれにそむいて、その敵となった。"},{"ref":"Lam.1.3","start":25001003,"end":25001003,"break":"line","breaks":[[10,"line"],[30,"line"],[54,"line"],[72,"line"]],"ruby":[[3,1,"なや"],[12,1,"はげ"],[15,2,"くえき"],[26,1,"い"],[35,2,"くにたみ"],[41,1,"す"],[48,2,"あんそく"],[51,1,"え"],[57,1,"お"],[59,1,"もの"],[63,1,"お"],[72,1,"なや"]],"text":"ユダは悩みのゆえに、また激しい苦役のゆえに、のがれて行って、もろもろの国民のうちに住んでいるが、安息を得ず、これを追う者がみな追いついてみると、悩みのうちにあった。"},{"ref":"Lam.1.4","start":25001004,"end":25001004,"break":"line","breaks":[[24,"line"],[36,"line"],[46,"line"],[61,"line"]],"ruby":[[4,1,"みち"],[6,1,"まつり"],[8,1,"のぼ"],[13,1,"もの"],[20,1,"かな"],[26,1,"もん"],[33,1,"あ"],[38,2,"さいし"],[43,1,"なげ"],[54,1,"ひ"],[58,1,"い"],[72,1,"くる"]],"text":"シオンの道は祭に上ってくる者のないために悲しみ、その門はことごとく荒れ、その祭司たちは嘆き、そのおとめたちは引かれて行き、シオンはみずからいたく苦しむ。"},{"ref":"Lam.1.5","start":25001005,"end":25001005,"break":"line","breaks":[[22,"line"],[32,"line"],[48,"line"]],"ruby":[[14,1,"てき"],[16,1,"さか"],[27,1,"おお"],[32,1,"しゅ"],[37,1,"なや"],[50,1,"おさ"],[52,1,"ご"],[56,1,"とら"],[64,1,"まえ"],[66,1,"い"]],"text":"そのあだはかしらとなり、その敵は栄えている。そのとがが多いので、主がこれを悩まされたからである。その幼な子たちは捕われて、あだの前に行った。"},{"ref":"Lam.1.6","start":25001006,"end":25001006,"break":"line","breaks":[[22,"line"],[44,"line"]],"ruby":[[4,1,"むすめ"],[6,2,"えいが"],[14,2,"かのじょ"],[17,1,"はな"],[19,1,"さ"],[24,1,"きみ"],[28,2,"ぼくそう"],[31,1,"え"],[44,2,"じぶん"],[47,1,"お"],[49,1,"もの"],[51,1,"まえ"],[53,1,"ちから"],[56,1,"に"],[58,1,"さ"]],"text":"シオンの娘の栄華はことごとく彼女を離れ去り、その君たちは牧草を得ない、しかのようになり、自分を追う者の前に力なく逃げ去った。"},{"ref":"Lam.1.7","start":25001007,"end":25001007,"break":"line","breaks":[[18,"line"],[38,"line"],[50,"line"],[65,"line"]],"ruby":[[8,1,"なや"],[11,1,"くる"],[15,1,"ひ"],[18,1,"むかし"],[21,1,"も"],[31,1,"たから"],[33,1,"おも"],[35,1,"だ"],[40,1,"たみ"],[45,1,"て"],[47,1,"おちい"],[56,1,"たす"],[59,1,"もの"],[63,1,"とき"],[71,1,"み"],[76,1,"ほろ"],[81,1,"わら"]],"text":"エルサレムはその悩みと苦しみの日に、昔から持っていたもろもろの宝を思い出す。その民があだの手に陥り、だれもこれを助ける者のない時、あだはこれを見て、その滅びをあざ笑った。"},{"ref":"Lam.1.8","start":25001008,"end":25001008,"break":"line","breaks":[[21,"line"],[31,"line"],[49,"line"],[57,"line"]],"ruby":[[13,1,"つみ"],[15,1,"おか"],[21,1,"けが"],[34,1,"たっと"],[37,1,"もの"],[39,1,"みな"],[42,1,"はだか"],[44,1,"み"],[52,1,"いや"],[66,1,"なげ"],[69,1,"かお"]],"text":"エルサレムは、はなはだしく罪を犯したので、汚れたものとなった。これを尊んだ者も皆その裸を見たので、これを卑しめる。これもまたみずから嘆き、顔をそむける。"},{"ref":"Lam.1.9","start":25001009,"end":25001009,"break":"line","breaks":[[15,"line"],[30,"line"],[49,"line"],[64,"line"],[81,"line"]],"ruby":[[2,1,"けが"],[7,1,"ころも"],[20,1,"おわ"],[23,1,"おも"],[38,1,"おどろ"],[44,1,"お"],[52,1,"なぐさ"],[55,1,"もの"],[65,1,"しゅ"],[70,1,"なや"],[73,1,"かえり"],[81,1,"てき"],[83,1,"か"],[85,1,"ほこ"]],"text":"その汚れはその衣のすそにあり、これはその終りを思わなかった。それゆえ、これは驚くばかりに落ちぶれ、これを慰める者はひとりもない。「主よ、わが悩みを顧みてください、敵は勝ち誇っていますから」。"},{"ref":"Lam.1.10","start":25001010,"end":25001010,"break":"line","breaks":[[22,"line"],[42,"line"],[60,"line"]],"ruby":[[0,1,"てき"],[2,1,"て"],[4,1,"の"],[10,2,"ざいほう"],[18,1,"うば"],[29,3,"いほうじん"],[38,2,"こうかい"],[52,1,"めい"],[60,1,"かれ"],[65,2,"せいじょ"],[77,1,"み"]],"text":"敵は手を伸べて、その財宝をことごとく奪った。あなたがさきに異邦人らはあなたの公会に、はいってはならないと命じられたのに、彼らがその聖所にはいるのをシオンは見た。"},{"ref":"Lam.1.11","start":25001011,"end":25001011,"break":"line","breaks":[[15,"line"],[37,"line"],[48,"line"]],"ruby":[[2,1,"たみ"],[6,1,"なげ"],[9,2,"しょくもつ"],[12,1,"もと"],[17,1,"いのち"],[27,2,"ざいほう"],[30,2,"しょくもつ"],[38,1,"しゅ"],[52,1,"いや"],[60,1,"かえり"]],"text":"その民はみな嘆いて食物を求め、その命をささえるために、財宝を食物にかえた。「主よ、みそなわして、わたしの卑しめられるのを顧みてください」。"},{"ref":"Lam.1.12","start":25001012,"end":25001012,"break":"line","breaks":[[10,"line"],[27,"line"],[48,"line"],[69,"line"]],"ruby":[[4,2,"みちゆ"],[7,1,"ひと"],[20,1,"おも"],[27,1,"しゅ"],[31,1,"はげ"],[34,1,"いか"],[37,1,"ひ"],[43,1,"なや"],[57,1,"くる"],[64,1,"くる"],[71,1,"よ"],[80,1,"たず"],[83,1,"み"]],"text":"「すべて道行く人よ、あなたがたはなんとも思わないのか。主がその激しい怒りの日にわたしを悩まして、わたしにくだされた苦しみのような苦しみが、また世にあるだろうか、尋ねて見よ。"},{"ref":"Lam.1.13","start":25001013,"end":25001013,"break":"line","breaks":[[10,"line"],[21,"line"],[33,"line"],[43,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"うえ"],[5,1,"ひ"],[7,1,"おく"],[15,1,"ほね"],[21,1,"あみ"],[23,1,"は"],[28,1,"あし"],[30,1,"とら"],[37,1,"ひ"],[39,1,"かえ"],[47,1,"こころ"],[55,1,"や"],[57,1,"おとろ"]],"text":"主は上から火を送り、それをわが骨にくだし、網を張ってわが足を捕え、わたしを引き返させ、ひねもす心わびしく、かつ病み衰えさせられた。"},{"ref":"Lam.1.14","start":25001014,"end":25001014,"break":"line","breaks":[[15,"line"],[26,"line"],[41,"line"],[51,"line"],[65,"line"]],"ruby":[[26,1,"しゅ"],[29,1,"て"],[33,1,"かた"],[35,1,"し"],[45,1,"くび"],[55,1,"ちから"],[57,1,"おとろ"],[65,1,"しゅ"],[72,1,"た"],[77,1,"とく"],[80,1,"もの"],[82,1,"て"],[84,1,"わた"]],"text":"わたしのとがは、つかねられて、一つのくびきとせられ、主のみ手により固く締められて、わたしの首におかれ、わたしの力を衰えさせられた。主はわたしを、立ちむかい得ざる者の手に渡された。"},{"ref":"Lam.1.15","start":25001015,"end":25001015,"break":"line","breaks":[[22,"line"],[37,"line"],[52,"line"],[64,"line"]],"ruby":[[0,1,"しゅ"],[15,2,"ゆうし"],[18,2,"むし"],[22,1,"せい"],[23,1,"かい"],[25,2,"しょうしゅう"],[34,1,"せ"],[39,1,"わか"],[41,2,"ひとびと"],[44,1,"う"],[46,1,"ほろ"],[52,1,"しゅ"],[54,1,"さか"],[58,1,"ふ"],[67,1,"むすめ"],[74,1,"ふ"]],"text":"主はわたしのうちにあるすべての勇士を無視し、聖会を召集して、わたしを攻め、わが若き人々を打ち滅ぼされた。主は酒ぶねを踏むように、ユダの娘なるおとめを踏みつけられた。"},{"ref":"Lam.1.16","start":25001016,"end":25001016,"break":"line","breaks":[[16,"line"],[29,"line"],[49,"line"],[65,"line"],[79,"line"]],"ruby":[[10,1,"な"],[12,1,"かな"],[20,1,"め"],[22,1,"なみだ"],[33,1,"なぐさ"],[36,1,"もの"],[42,2,"ゆうき"],[47,1,"もの"],[54,1,"とお"],[56,1,"はな"],[67,1,"こ"],[70,1,"てき"],[72,1,"か"],[83,1,"もの"]],"text":"このために、わたしは泣き悲しみ、わたしの目は涙であふれる。わたしを慰める者、わたしを勇気づける者がわたしから遠く離れたからである。わが子らは敵が勝ったために、わびしい者となった」。"},{"ref":"Lam.1.17","start":25001017,"end":25001017,"break":"line","breaks":[[12,"line"],[27,"line"],[42,"line"],[61,"line"],[76,"line"]],"ruby":[[4,1,"て"],[6,1,"の"],[15,1,"なぐさ"],[18,1,"もの"],[36,1,"しゅ"],[38,1,"めい"],[44,2,"しゅうい"],[47,1,"もの"],[67,1,"かれ"],[70,1,"なか"],[76,1,"けが"],[79,1,"もの"]],"text":"シオンは手を伸ばしても、これを慰める者はひとりもない。ヤコブについては、主は命じて、その周囲の者を、これがあだとせられた。エルサレムは彼らの中にあって、汚れた物のようになった。"},{"ref":"Lam.1.18","start":25001018,"end":25001018,"break":"line","breaks":[[7,"line"],[21,"line"],[31,"line"],[41,"line"]],"ruby":[[1,1,"しゅ"],[3,1,"ただ"],[13,2,"ことば"],[25,1,"たみ"],[28,1,"き"],[33,1,"くる"],[37,1,"かえり"],[51,2,"わこうど"],[55,1,"とら"],[59,1,"い"]],"text":"「主は正しい、わたしは、み言葉にそむいた。すべての民よ、聞け、わが苦しみを顧みよ。わがおとめらも、わが若人らも捕われて行った。"},{"ref":"Lam.1.19","start":25001019,"end":25001019,"break":"line","breaks":[[16,"line"],[27,"line"],[51,"line"]],"ruby":[[6,1,"あい"],[9,1,"もの"],[11,1,"よ"],[16,1,"かれ"],[23,1,"あざむ"],[29,2,"さいし"],[34,2,"ちょうろう"],[42,1,"いのち"],[51,2,"しょくもつ"],[54,1,"もと"],[59,1,"あいだ"],[62,1,"まち"],[67,1,"いき"],[68,1,"た"]],"text":"わたしはわが愛する者を呼んだが、彼らはわたしを欺いた。わが祭司および長老たちは、その命をささえようと、食物を求めている間に、町のうちで息絶えた。"},{"ref":"Lam.1.20","start":25001020,"end":25001020,"break":"line","breaks":[[11,"line"],[31,"line"],[50,"line"],[70,"line"],[88,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かえり"],[15,1,"なや"],[33,2,"しんぞう"],[40,1,"うち"],[42,2,"てんとう"],[70,1,"そと"],[83,1,"こ"],[85,1,"うば"],[88,1,"いえ"],[90,1,"うち"],[93,1,"し"]],"text":"主よ、顧みてください、わたしは悩み、わがはらわたはわきかえり、わが心臓はわたしの内に転倒しています。わたしは、はなはだしくそむいたからです。外にはつるぎがあって、わが子を奪い、家の内には死のようなものがある。"},{"ref":"Lam.1.21","start":25001021,"end":25001021,"break":"line","breaks":[[20,"line"],[36,"line"],[51,"line"],[68,"line"],[90,"line"]],"ruby":[[8,1,"なげ"],[12,1,"き"],[24,1,"なぐさ"],[27,1,"もの"],[36,1,"てき"],[44,1,"なや"],[47,1,"き"],[64,1,"よろこ"],[75,1,"つ"],[77,1,"し"],[83,1,"ひ"],[90,1,"かれ"]],"text":"わたしがどんなに嘆くかを聞いてください。わたしを慰める者はひとりもなく、敵はみなわたしの悩みを聞いて、あなたがこれをなされたのを喜んだ。あなたがさきに告げ知らせたその日をきたらせ、彼らをも、わたしのようにしてください。"},{"ref":"Lam.1.22","start":25001022,"end":25001022,"break":"line","breaks":[[21,"line"],[38,"line"],[62,"line"],[70,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あく"],[14,1,"まえ"],[42,1,"おこな"],[50,1,"かれ"],[54,1,"おこな"],[64,1,"なげ"],[67,1,"おお"],[72,1,"こころ"],[74,1,"よわ"]],"text":"彼らの悪をことごとくあなたの前にあらわし、さきにわがもろもろのとがのために、わたしに行われたように、彼らにも行ってください。わが嘆きは多く、わが心は弱りはてているからです」。"}]