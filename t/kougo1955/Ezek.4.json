[{"ref":"Ezek.4.1","start":26004001,"end":26004001,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[6,1,"まい"],[12,1,"と"],[20,1,"まえ"],[22,1,"お"],[27,1,"うえ"],[35,1,"まち"],[37,1,"えが"]],"text":"人の子よ、一枚のかわらを取って、あなたの前に置き、その上にエルサレムの町を描きなさい。"},{"ref":"Ezek.4.2","start":26004002,"end":26004002,"break":"none","ruby":[[6,1,"と"],[8,1,"かこ"],[18,2,"うんてい"],[21,1,"もう"],[24,1,"るい"],[26,1,"きず"],[29,1,"じん"],[31,1,"は"],[36,1,"まわ"],[39,1,"しろ"],[44,1,"そな"],[50,1,"せ"]],"text":"そしてこれを取り囲み、これにむかって雲梯を設け、塁を築き、陣を張り、その回りに城くずしを備えてこれを攻めなさい。"},{"ref":"Ezek.4.3","start":26004003,"end":26004003,"break":"none","ruby":[[2,1,"てつ"],[4,1,"いた"],[16,1,"まち"],[18,1,"あいだ"],[20,1,"お"],[23,1,"てつ"],[25,1,"かべ"],[34,1,"かお"],[39,1,"む"],[45,1,"まち"],[52,1,"かこ"],[58,2,"ほうい"],[61,1,"お"],[63,1,"すす"],[78,1,"いえ"]],"text":"また鉄の板をとり、それをあなたと町の間に置いて鉄の壁となし、あなたの顔をこれに向けなさい。町をこのように囲んで、その包囲を押し進めなさい。これがイスラエルの家のしるしである。"},{"ref":"Ezek.4.4","start":26004004,"end":26004004,"break":"paragraph","ruby":[[6,2,"じぶん"],[9,1,"ひだり"],[10,1,"わき"],[12,1,"した"],[16,1,"ね"],[29,1,"うえ"],[37,1,"いえ"],[39,1,"ばつ"],[41,1,"お"],[55,1,"ね"],[59,1,"ひ"],[61,1,"あいだ"],[63,1,"かれ"],[66,1,"ばつ"],[68,1,"お"]],"text":"あなたはまた自分の左脇を下にして寝なさい。わたしはあなたの上にイスラエルの家の罰を置く。あなたはこのようにして寝ている日の間、彼らの罰を負わなければならない。"},{"ref":"Ezek.4.5","start":26004005,"end":26004005,"break":"none","ruby":[[4,1,"かれ"],[7,1,"ばつ"],[9,2,"ねんすう"],[12,1,"ひと"],[17,1,"ひ"],[18,1,"かず"],[28,1,"にち"],[37,1,"さだ"],[43,1,"かん"],[54,1,"いえ"],[56,1,"ばつ"],[58,1,"お"]],"text":"わたしは彼らの罰の年数に等しいその日数、すなわち三百九十日をあなたのために定める。その間あなたはイスラエルの家の罰を負わなければならない。"},{"ref":"Ezek.4.6","start":26004006,"end":26004006,"break":"none","ruby":[[6,2,"きかん"],[9,1,"おわ"],[17,1,"みぎ"],[18,1,"わき"],[20,1,"した"],[24,1,"ね"],[30,1,"いえ"],[32,1,"ばつ"],[34,1,"お"],[50,1,"にち"],[53,1,"ねん"],[59,1,"にち"],[68,1,"さだ"]],"text":"あなたはその期間を終ったなら、また右脇を下にして寝て、ユダの家の罰を負わなければならない。わたしは一日を一年として四十日をあなたのために定める。"},{"ref":"Ezek.4.7","start":26004007,"end":26004007,"break":"none","ruby":[[4,2,"じぶん"],[7,1,"かお"],[15,2,"ほうい"],[18,1,"ほう"],[20,1,"む"],[23,1,"うで"],[30,1,"まち"],[32,1,"む"],[36,2,"よげん"]],"text":"あなたは自分の顔をエルサレムの包囲の方に向け、腕をあらわし、町に向かって預言しなければならない。"},{"ref":"Ezek.4.8","start":26004008,"end":26004008,"break":"none","ruby":[[0,1,"み"],[23,2,"ほうい"],[26,2,"きかん"],[29,1,"おわ"],[34,2,"さゆう"],[37,1,"うご"]],"text":"見よ、わたしはあなたに、なわをかけて、あなたの包囲の期間の終るまで、左右に動くことができないようにする。"},{"ref":"Ezek.4.9","start":26004009,"end":26004009,"break":"paragraph","ruby":[[6,2,"こむぎ"],[9,2,"おおむぎ"],[12,1,"まめ"],[17,1,"まめ"],[25,1,"むぎ"],[27,1,"と"],[34,1,"うつわ"],[36,1,"い"],[45,1,"つく"],[52,1,"よこ"],[57,1,"ね"],[59,1,"ひ"],[61,1,"かず"],[71,1,"にち"],[73,1,"あいだ"],[77,1,"た"]],"text":"あなたはまた小麦、大麦、豆、レンズ豆、あわ、はだか麦を取って、一つの器に入れ、これでパンを造り、あなたが横になって寝る日の数、すなわち三百九十日の間これを食べなければならない。"},{"ref":"Ezek.4.10","start":26004010,"end":26004010,"break":"none","ruby":[[4,1,"た"],[7,2,"しょくもつ"],[10,1,"はか"],[14,1,"にち"],[30,1,"にち"],[33,1,"ど"],[37,1,"た"]],"text":"あなたが食べる食物は量って一日に二十シケルである。あなたは一日に一度これを食べなければならない。"},{"ref":"Ezek.4.11","start":26004011,"end":26004011,"break":"none","ruby":[[2,1,"みず"],[4,1,"はか"],[12,1,"ぶん"],[17,1,"にち"],[20,1,"ど"],[21,1,"の"]],"text":"また水を量って一ヒンの六分の一を一日に一度飲まなければならない。"},{"ref":"Ezek.4.12","start":26004012,"end":26004012,"break":"none","ruby":[[4,2,"おおむぎ"],[7,2,"かし"],[18,1,"た"],[28,1,"かれ"],[31,1,"め"],[33,1,"まえ"],[38,1,"ひと"],[40,1,"ふん"],[42,1,"や"]],"text":"あなたは大麦の菓子のようにしてこれを食べなさい。すなわち彼らの目の前でこれを人の糞で焼かなければならない」。"},{"ref":"Ezek.4.13","start":26004013,"end":26004013,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"い"],[22,1,"たみ"],[28,1,"お"],[36,2,"くにぐに"],[39,1,"なか"],[41,1,"けが"],[47,1,"た"]],"text":"そして主は言われた、「このようにイスラエルの民はわたしが追いやろうとする国々の中で汚れたパンを食べなければならない」。"},{"ref":"Ezek.4.14","start":26004014,"end":26004014,"break":"none","ruby":[[7,1,"い"],[15,1,"しゅ"],[18,1,"かみ"],[25,2,"じぶん"],[28,1,"けが"],[44,1,"おさな"],[46,1,"とき"],[49,2,"こんにち"],[54,2,"しぜん"],[57,1,"し"],[64,2,"やじゅう"],[67,1,"さ"],[69,1,"ころ"],[76,1,"た"],[90,1,"けが"],[93,1,"にく"],[99,1,"くち"]],"text":"そこでわたしは言った、「ああ、主なる神よ、わたしは自分を汚したことはありません。わたしは幼い時から今日まで、自然に死んだものや、野獣に裂き殺されたものを食べたことはありません。また汚れた肉がわたしの口にはいったことはありません」。"},{"ref":"Ezek.4.15","start":26004015,"end":26004015,"break":"none","ruby":[[3,1,"かれ"],[9,1,"い"],[15,1,"み"],[22,1,"うし"],[24,1,"ふん"],[29,1,"ひと"],[31,1,"ふん"],[33,1,"か"],[54,2,"じぶん"],[60,1,"ととの"]],"text":"すると彼はわたしに言われた、「見よ、わたしは牛の糞をもって人の糞に換えることをあなたにゆるす。あなたはそれで自分のパンを整えなさい」。"},{"ref":"Ezek.4.16","start":26004016,"end":26004016,"break":"none","ruby":[[6,1,"い"],[12,1,"ひと"],[14,1,"こ"],[17,1,"み"],[30,1,"ひと"],[40,1,"う"],[42,1,"くだ"],[45,1,"かれ"],[51,1,"はか"],[55,1,"おそ"],[60,1,"た"],[65,1,"みず"],[67,1,"はか"],[70,1,"おどろ"],[75,1,"の"]],"text":"またわたしに言われた、「人の子よ、見よ、わたしはエルサレムで人のつえとするパンを打ち砕く。彼らはパンを量って、恐れながら食べ、また水を量って驚きながら飲む。"},{"ref":"Ezek.4.17","start":26004017,"end":26004017,"break":"none","ruby":[[3,1,"かれ"],[9,1,"みず"],[12,1,"とぼ"],[17,1,"たがい"],[19,1,"おどろ"],[22,1,"かお"],[24,2,"みあ"],[31,1,"ばつ"],[36,1,"おとろ"]],"text":"これは彼らをパンと水とに乏しくし、互に驚いて顔を見合わせ、その罰のために衰えさせるためである。"}]