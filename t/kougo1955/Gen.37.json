[{"ref":"Gen.37.1","start":1037001,"end":1037001,"break":"paragraph","ruby":[[4,1,"ちち"],[6,2,"きりゅう"],[9,1,"ち"],[19,1,"ち"],[21,1,"す"]],"text":"ヤコブは父の寄留の地、すなわちカナンの地に住んだ。"},{"ref":"Gen.37.2","start":1037002,"end":1037002,"break":"none","breaks":[[16,"paragraph"]],"ruby":[[4,2,"しそん"],[7,1,"つぎ"],[22,1,"さい"],[24,1,"とき"],[26,2,"きょうだい"],[31,1,"とも"],[33,1,"ひつじ"],[35,1,"む"],[38,1,"か"],[44,1,"かれ"],[48,2,"こども"],[52,1,"ちち"],[54,1,"つま"],[66,1,"こ"],[69,1,"とも"],[79,1,"かれ"],[82,1,"わる"],[88,1,"ちち"],[90,1,"つ"]],"text":"ヤコブの子孫は次のとおりである。ヨセフは十七歳の時、兄弟たちと共に羊の群れを飼っていた。彼はまだ子供で、父の妻たちビルハとジルパとの子らと共にいたが、ヨセフは彼らの悪いうわさを父に告げた。"},{"ref":"Gen.37.3","start":1037003,"end":1037003,"break":"none","ruby":[[4,2,"としよ"],[7,1,"こ"],[21,1,"た"],[25,1,"こ"],[29,1,"かれ"],[31,1,"あい"],[35,1,"かれ"],[40,1,"なが"],[44,2,"きもの"]],"text":"ヨセフは年寄り子であったから、イスラエルは他のどの子よりも彼を愛して、彼のために長そでの着物をつくった。"},{"ref":"Gen.37.4","start":1037004,"end":1037004,"break":"none","ruby":[[0,2,"きょうだい"],[5,1,"ちち"],[9,2,"きょうだい"],[14,1,"かれ"],[16,1,"あい"],[21,1,"み"],[24,1,"かれ"],[26,1,"にく"],[29,1,"おだ"],[33,1,"かれ"],[35,1,"かた"]],"text":"兄弟たちは父がどの兄弟よりも彼を愛するのを見て、彼を憎み、穏やかに彼に語ることができなかった。"},{"ref":"Gen.37.5","start":1037005,"end":1037005,"break":"paragraph","ruby":[[2,1,"とき"],[8,1,"ゆめ"],[10,1,"み"],[16,2,"きょうだい"],[21,1,"はな"],[27,1,"かれ"],[35,1,"かれ"],[37,1,"にく"]],"text":"ある時、ヨセフは夢を見て、それを兄弟たちに話したので、彼らは、ますます彼を憎んだ。"},{"ref":"Gen.37.6","start":1037006,"end":1037006,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[19,1,"み"],[21,1,"ゆめ"],[23,1,"き"]],"text":"ヨセフは彼らに言った、「どうぞわたしが見た夢を聞いてください。"},{"ref":"Gen.37.7","start":1037007,"end":1037007,"break":"none","ruby":[[6,1,"はたけ"],[8,1,"なか"],[10,1,"たば"],[12,1,"ゆ"],[25,1,"たば"],[27,1,"お"],[30,1,"た"],[40,1,"たば"],[53,1,"たば"],[55,1,"おが"]],"text":"わたしたちが畑の中で束を結わえていたとき、わたしの束が起きて立つと、あなたがたの束がまわりにきて、わたしの束を拝みました」。"},{"ref":"Gen.37.8","start":1037008,"end":1037008,"break":"none","ruby":[[3,2,"きょうだい"],[8,1,"かれ"],[10,1,"む"],[31,1,"おう"],[42,2,"じっさい"],[50,1,"おさ"],[57,1,"い"],[61,1,"かれ"],[63,1,"ゆめ"],[67,2,"ことば"],[77,1,"かれ"],[79,1,"にく"]],"text":"すると兄弟たちは彼に向かって、「あなたはほんとうにわたしたちの王になるのか。あなたは実際わたしたちを治めるのか」と言って、彼の夢とその言葉のゆえにますます彼を憎んだ。"},{"ref":"Gen.37.9","start":1037009,"end":1037009,"break":"none","ruby":[[9,1,"ゆめ"],[11,1,"み"],[17,2,"きょうだい"],[22,1,"かた"],[25,1,"い"],[36,1,"ゆめ"],[38,1,"み"],[43,1,"ひ"],[45,1,"つき"],[50,1,"ほし"],[57,1,"おが"]],"text":"ヨセフはまた一つの夢を見て、それを兄弟たちに語って言った、「わたしはまた夢を見ました。日と月と十一の星とがわたしを拝みました」。"},{"ref":"Gen.37.10","start":1037010,"end":1037010,"break":"none","ruby":[[0,1,"かれ"],[5,1,"ちち"],[7,2,"きょうだい"],[12,1,"かた"],[18,1,"ちち"],[20,1,"かれ"],[26,1,"い"],[35,1,"み"],[39,1,"ゆめ"],[61,1,"はは"],[64,2,"きょうだい"],[70,1,"い"],[73,1,"ち"],[75,1,"ふ"],[82,1,"おが"]],"text":"彼はこれを父と兄弟たちに語ったので、父は彼をとがめて言った、「あなたが見たその夢はどういうのか。ほんとうにわたしとあなたの母と、兄弟たちとが行って地に伏し、あなたを拝むのか」。"},{"ref":"Gen.37.11","start":1037011,"end":1037011,"break":"none","ruby":[[0,2,"きょうだい"],[5,1,"かれ"],[15,1,"ちち"],[19,2,"ことば"],[22,1,"こころ"]],"text":"兄弟たちは彼をねたんだ。しかし父はこの言葉を心にとめた。"},{"ref":"Gen.37.12","start":1037012,"end":1037012,"break":"paragraph","ruby":[[2,2,"きょうだい"],[11,1,"い"],[15,1,"ちち"],[17,1,"ひつじ"],[19,1,"む"],[22,1,"か"]],"text":"さて兄弟たちがシケムに行って、父の羊の群れを飼っていたとき、"},{"ref":"Gen.37.13","start":1037013,"end":1037013,"break":"none","ruby":[[10,1,"い"],[19,2,"きょうだい"],[28,1,"ひつじ"],[30,1,"か"],[48,1,"かれ"],[51,1,"ところ"],[64,1,"ちち"],[66,1,"い"],[74,1,"い"]],"text":"イスラエルはヨセフに言った、「あなたの兄弟たちはシケムで羊を飼っているではないか。さあ、あなたを彼らの所へつかわそう」。ヨセフは父に言った、「はい、行きます」。"},{"ref":"Gen.37.14","start":1037014,"end":1037014,"break":"none","ruby":[[0,1,"ちち"],[2,1,"かれ"],[4,1,"い"],[13,1,"い"],[21,2,"きょうだい"],[26,2,"ぶじ"],[35,1,"む"],[38,2,"ぶじ"],[44,1,"み"],[53,1,"し"],[63,1,"ちち"],[65,1,"かれ"],[72,1,"たに"],[83,1,"かれ"],[89,1,"い"]],"text":"父は彼に言った、「どうか、行って、あなたの兄弟たちは無事であるか、また群れは無事であるか見てきて、わたしに知らせてください」。父が彼をヘブロンの谷からつかわしたので、彼はシケムに行った。"},{"ref":"Gen.37.15","start":1037015,"end":1037015,"break":"none","ruby":[[4,1,"ひと"],[6,1,"かれ"],[8,1,"あ"],[11,1,"かれ"],[13,1,"の"],[27,1,"ひと"],[29,1,"かれ"],[31,1,"たず"],[34,1,"い"],[43,1,"なに"],[45,1,"さが"]],"text":"ひとりの人が彼に会い、彼が野をさまよっていたので、その人は彼に尋ねて言った、「あなたは何を捜しているのですか」。"},{"ref":"Gen.37.16","start":1037016,"end":1037016,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,2,"きょうだい"],[12,1,"さが"],[21,1,"かれ"],[28,1,"ひつじ"],[30,1,"か"],[45,1,"し"]],"text":"彼は言った、「兄弟たちを捜しているのです。彼らが、どこで羊を飼っているのか、どうぞわたしに知らせてください」。"},{"ref":"Gen.37.17","start":1037017,"end":1037017,"break":"none","ruby":[[2,1,"ひと"],[4,1,"い"],[9,1,"かれ"],[15,1,"さ"],[21,1,"かれ"],[29,1,"い"],[34,1,"い"],[42,1,"き"],[56,2,"きょうだい"],[64,1,"お"],[67,1,"い"],[75,1,"かれ"],[78,1,"あ"]],"text":"その人は言った、「彼らはここを去りました。彼らが『ドタンへ行こう』と言うのをわたしは聞きました」。そこでヨセフは兄弟たちのあとを追って行って、ドタンで彼らに会った。"},{"ref":"Gen.37.18","start":1037018,"end":1037018,"break":"none","ruby":[[4,1,"かれ"],[7,1,"ちか"],[16,1,"かれ"],[27,1,"み"],[33,1,"ころ"],[37,1,"はか"]],"text":"ヨセフが彼らに近づかないうちに、彼らははるかにヨセフを見て、これを殺そうと計り、"},{"ref":"Gen.37.19","start":1037019,"end":1037019,"break":"none","ruby":[[0,1,"たがい"],[2,1,"い"],[9,2,"ゆめみ"],[12,1,"もの"],[17,1,"く"]],"text":"互に言った、「あの夢見る者がやって来る。"},{"ref":"Gen.37.20","start":1037020,"end":1037020,"break":"none","ruby":[[3,1,"かれ"],[5,1,"ころ"],[8,1,"あな"],[10,1,"な"],[12,1,"い"],[15,1,"わる"],[17,1,"けもの"],[19,1,"かれ"],[21,1,"く"],[25,1,"い"],[32,1,"かれ"],[34,1,"ゆめ"],[41,1,"み"]],"text":"さあ、彼を殺して穴に投げ入れ、悪い獣が彼を食ったと言おう。そして彼の夢がどうなるか見よう」。"},{"ref":"Gen.37.21","start":1037021,"end":1037021,"break":"none","ruby":[[7,1,"き"],[15,1,"かれ"],[18,1,"て"],[21,1,"すく"],[23,1,"だ"],[29,1,"い"],[39,1,"かれ"],[41,1,"いのち"],[43,1,"と"]],"text":"ルベンはこれを聞いて、ヨセフを彼らの手から救い出そうとして言った、「われわれは彼の命を取ってはならない」。"},{"ref":"Gen.37.22","start":1037022,"end":1037022,"break":"none","ruby":[[6,1,"かれ"],[9,1,"い"],[14,1,"ち"],[16,1,"なが"],[25,1,"かれ"],[27,2,"あらの"],[32,1,"あな"],[34,1,"な"],[36,1,"い"],[41,1,"かれ"],[43,1,"て"],[63,1,"かれ"],[66,1,"て"],[69,1,"すく"],[74,1,"ちち"],[76,1,"かえ"]],"text":"ルベンはまた彼らに言った、「血を流してはいけない。彼を荒野のこの穴に投げ入れよう。彼に手をくだしてはならない」。これはヨセフを彼らの手から救いだして父に返すためであった。"},{"ref":"Gen.37.23","start":1037023,"end":1037023,"break":"none","ruby":[[7,2,"きょうだい"],[15,1,"い"],[19,1,"かれ"],[26,2,"きもの"],[29,1,"かれ"],[31,1,"き"],[35,1,"なが"],[39,2,"きもの"]],"text":"さて、ヨセフが兄弟たちのもとへ行くと、彼らはヨセフの着物、彼が着ていた長そでの着物をはぎとり、"},{"ref":"Gen.37.24","start":1037024,"end":1037024,"break":"none","ruby":[[0,1,"かれ"],[2,1,"とら"],[5,1,"あな"],[7,1,"な"],[9,1,"い"],[15,1,"あな"],[23,1,"なか"],[25,1,"みず"]],"text":"彼を捕えて穴に投げ入れた。その穴はからで、その中に水はなかった。"},{"ref":"Gen.37.25","start":1037025,"end":1037025,"break":"paragraph","ruby":[[4,1,"かれ"],[14,1,"た"],[18,1,"とき"],[20,1,"かれ"],[23,1,"め"],[28,1,"み"],[40,2,"たいしょう"],[48,2,"こうりょう"],[52,2,"にゅうこう"],[62,1,"お"],[71,1,"くだ"],[73,1,"い"]],"text":"こうして彼らはすわってパンを食べた。時に彼らが目をあげて見ると、イシマエルびとの隊商が、らくだに香料と、乳香と、もつやくとを負わせてエジプトへ下り行こうとギレアデからやってきた。"},{"ref":"Gen.37.26","start":1037026,"end":1037026,"break":"none","ruby":[[6,2,"きょうだい"],[11,1,"い"],[21,1,"おとうと"],[23,1,"ころ"],[28,1,"ち"],[30,1,"かく"],[33,1,"なに"],[35,1,"えき"]],"text":"そこでユダは兄弟たちに言った、「われわれが弟を殺し、その血を隠して何の益があろう。"},{"ref":"Gen.37.27","start":1037027,"end":1037027,"break":"none","ruby":[[8,1,"かれ"],[18,1,"う"],[22,1,"かれ"],[29,2,"きょうだい"],[37,1,"にく"],[38,1,"み"],[43,1,"かれ"],[45,1,"て"],[47,1,"くだ"],[57,2,"きょうだい"],[65,1,"き"],[67,1,"い"]],"text":"さあ、われわれは彼をイシマエルびとに売ろう。彼はわれわれの兄弟、われわれの肉身だから、彼に手を下してはならない」。兄弟たちはこれを聞き入れた。"},{"ref":"Gen.37.28","start":1037028,"end":1037028,"break":"none","ruby":[[0,1,"とき"],[9,2,"しょうにん"],[14,1,"とお"],[23,1,"かれ"],[30,1,"あな"],[33,1,"ひ"],[35,1,"あ"],[38,1,"ぎん"],[57,1,"う"],[61,1,"かれ"],[73,1,"つ"],[76,1,"い"]],"text":"時にミデアンびとの商人たちが通りかかったので、彼らはヨセフを穴から引き上げ、銀二十シケルでヨセフをイシマエルびとに売った。彼らはヨセフをエジプトへ連れて行った。"},{"ref":"Gen.37.29","start":1037029,"end":1037029,"break":"paragraph","ruby":[[6,1,"あな"],[8,1,"かえ"],[11,1,"み"],[19,1,"あな"],[21,1,"なか"],[31,1,"かれ"],[33,2,"いふく"],[36,1,"さ"]],"text":"さてルベンは穴に帰って見たが、ヨセフが穴の中にいなかったので、彼は衣服を裂き、"},{"ref":"Gen.37.30","start":1037030,"end":1037030,"break":"none","ruby":[[0,2,"きょうだい"],[8,1,"かえ"],[11,1,"い"],[18,1,"こ"],[34,1,"い"]],"text":"兄弟たちのもとに帰って言った、「あの子はいない。ああ、わたしはどこへ行くことができよう」。"},{"ref":"Gen.37.31","start":1037031,"end":1037031,"break":"none","ruby":[[0,1,"かれ"],[7,2,"きもの"],[10,1,"と"],[13,1,"お"],[17,1,"ころ"],[21,2,"きもの"],[26,1,"ち"],[28,1,"ひた"]],"text":"彼らはヨセフの着物を取り、雄やぎを殺して、着物をその血に浸し、"},{"ref":"Gen.37.32","start":1037032,"end":1037032,"break":"none","ruby":[[2,1,"なが"],[6,2,"きもの"],[9,1,"ちち"],[11,1,"も"],[13,1,"かえ"],[16,1,"い"],[30,1,"み"],[45,1,"こ"],[47,2,"きもの"],[54,1,"み"]],"text":"その長そでの着物を父に持ち帰って言った、「わたしたちはこれを見つけましたが、これはあなたの子の着物か、どうか見さだめてください」。"},{"ref":"Gen.37.33","start":1037033,"end":1037033,"break":"none","ruby":[[0,1,"ちち"],[5,1,"み"],[10,1,"い"],[17,1,"こ"],[19,2,"きもの"],[23,1,"わる"],[25,1,"けもの"],[27,1,"かれ"],[29,1,"く"],[35,1,"たし"],[44,1,"さ"]],"text":"父はこれを見さだめて言った、「わが子の着物だ。悪い獣が彼を食ったのだ。確かにヨセフはかみ裂かれたのだ」。"},{"ref":"Gen.37.34","start":1037034,"end":1037034,"break":"none","ruby":[[7,2,"いふく"],[10,1,"さ"],[13,2,"あらぬの"],[16,1,"こし"],[23,1,"なが"],[25,1,"あいだ"],[28,1,"こ"],[33,1,"なげ"]],"text":"そこでヤコブは衣服を裂き、荒布を腰にまとって、長い間その子のために嘆いた。"},{"ref":"Gen.37.35","start":1037035,"end":1037035,"break":"none","ruby":[[0,1,"こ"],[3,1,"むすめ"],[7,1,"みな"],[8,1,"た"],[11,1,"かれ"],[13,1,"なぐさ"],[22,1,"かれ"],[24,1,"なぐさ"],[31,1,"こば"],[34,1,"い"],[46,1,"なげ"],[51,2,"よみ"],[54,1,"くだ"],[60,1,"こ"],[65,1,"い"],[74,1,"ちち"],[76,1,"かれ"],[81,1,"な"]],"text":"子らと娘らとは皆立って彼を慰めようとしたが、彼は慰められるのを拒んで言った、「いや、わたしは嘆きながら陰府に下って、わが子のもとへ行こう」。こうして父は彼のために泣いた。"},{"ref":"Gen.37.36","start":1037036,"end":1037036,"break":"none","ruby":[[21,2,"やくにん"],[24,2,"じえい"],[26,1,"ちょう"],[36,1,"う"]],"text":"さて、かのミデアンびとらはエジプトでパロの役人、侍衛長ポテパルにヨセフを売った。"}]