[{"ref":"1Chr.16.1","start":13016001,"end":13016001,"break":"paragraph","ruby":[[0,2,"ひとびと"],[3,1,"かみ"],[5,1,"はこ"],[9,1,"い"],[22,1,"は"],[25,2,"まくや"],[31,1,"お"],[37,2,"はんさい"],[40,3,"しゅうおんさい"],[44,1,"かみ"],[46,1,"まえ"]],"text":"人々は神の箱をかき入れて、ダビデがそのために張った幕屋のうちに置き、そして燔祭と酬恩祭を神の前にささげた。"},{"ref":"1Chr.16.2","start":13016002,"end":13016002,"break":"none","ruby":[[4,2,"はんさい"],[7,3,"しゅうおんさい"],[14,1,"お"],[20,1,"しゅ"],[22,1,"な"],[27,1,"たみ"],[29,2,"しゅくふく"]],"text":"ダビデは燔祭と酬恩祭をささげ終えたとき、主の名をもって民を祝福し、"},{"ref":"1Chr.16.3","start":13016003,"end":13016003,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"おとこ"],[12,1,"おんな"],[24,1,"にく"],[26,1,"き"],[29,1,"ほし"],[39,1,"わ"],[41,1,"あた"]],"text":"イスラエルの人々に男にも女にもおのおのパン一つ、肉一切れ、干ぶどう一かたまりを分け与えた。"},{"ref":"1Chr.16.4","start":13016004,"end":13016004,"break":"paragraph","ruby":[[15,1,"しゅ"],[17,1,"はこ"],[19,1,"まえ"],[21,1,"つか"],[24,1,"もの"],[26,1,"た"],[36,1,"かみ"],[38,1,"しゅ"],[44,2,"かんしゃ"]],"text":"ダビデはまたレビびとのうちから主の箱の前に仕える者を立てて、イスラエルの神、主をあがめ、感謝し、ほめたたえさせた。"},{"ref":"1Chr.16.5","start":13016005,"end":13016005,"break":"none","ruby":[[0,2,"がくちょう"],[9,1,"つぎ"],[61,1,"かれ"],[64,2,"たてごと"],[67,1,"こと"],[69,1,"だん"],[81,1,"う"],[83,1,"な"]],"text":"楽長はアサフ、その次はゼカリヤ、エイエル、セミラモテ、エヒエル、マッタテヤ、エリアブ、ベナヤ、オベデ・エドム、エイエルで、彼らは立琴と琴を弾じ、アサフはシンバルを打ち鳴らし、"},{"ref":"1Chr.16.6","start":13016006,"end":13016006,"break":"none","ruby":[[0,2,"さいし"],[12,1,"かみ"],[14,2,"けいやく"],[17,1,"はこ"],[19,1,"まえ"],[28,1,"ふ"]],"text":"祭司ベナヤとヤハジエルは神の契約の箱の前でつねにラッパを吹いた。"},{"ref":"1Chr.16.7","start":13016007,"end":13016007,"break":"paragraph","ruby":[[2,1,"ひ"],[7,1,"はじ"],[14,1,"かれ"],[16,2,"きょうだい"],[21,1,"た"],[25,1,"しゅ"],[27,2,"かんしゃ"]],"text":"その日ダビデは初めてアサフと彼の兄弟たちを立てて、主に感謝をささげさせた。"},{"ref":"1Chr.16.8","start":13016008,"end":13016008,"break":"stanza","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"かんしゃ"],[9,1,"な"],[11,1,"よ"],[25,1,"たみ"],[27,1,"なか"],[29,1,"し"]],"text":"主に感謝し、そのみ名を呼び、そのみわざをもろもろの民の中に知らせよ。"},{"ref":"1Chr.16.9","start":13016009,"end":13016009,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"うた"],[9,1,"しゅ"],[13,1,"うた"],[31,1,"かた"]],"text":"主にむかって歌え、主をほめ歌え。そのもろもろのくすしきみわざを語れ。"},{"ref":"1Chr.16.10","start":13016010,"end":13016010,"break":"line","breaks":[[11,"line"]],"ruby":[[2,1,"せい"],[6,1,"な"],[8,1,"ほこ"],[14,1,"しゅ"],[16,1,"もと"],[19,1,"もの"],[21,1,"こころ"],[23,1,"よろこ"]],"text":"その聖なるみ名を誇れ。どうか主を求める者の心が喜ぶように。"},{"ref":"1Chr.16.11","start":13016011,"end":13016011,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"ちから"],[8,1,"もと"],[18,1,"かお"]],"text":"主とそのみ力とを求めよ。つねにそのみ顔をたずねよ。"},{"ref":"1Chr.16.12","start":13016012,"end":13016013,"break":"line","breaks":[[15,"line"],[29,"line"],[50,"line"]],"ruby":[[17,1,"えら"],[25,1,"こ"],[29,1,"しゅ"],[46,2,"きせき"],[53,1,"くち"],[60,1,"こころ"]],"text":"そのしもべアブラハムのすえよ、その選ばれたヤコブの子らよ。主のなされたくすしきみわざと、その奇跡と、そのみ口のさばきとを心にとめよ。"},{"ref":"1Chr.16.14","start":13016014,"end":13016014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[7,1,"かみ"],[9,1,"しゅ"],[21,1,"ぜん"],[22,1,"ち"]],"text":"彼はわれわれの神、主にいます。そのさばきは全地にある。"},{"ref":"1Chr.16.15","start":13016015,"end":13016015,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[9,2,"けいやく"],[31,1,"めい"],[37,2,"ことば"]],"text":"主はとこしえにその契約をみこころにとめられる。これはよろずよに命じられたみ言葉であって、"},{"ref":"1Chr.16.16","start":13016016,"end":13016016,"break":"line","breaks":[[13,"line"]],"ruby":[[6,1,"むす"],[10,2,"けいやく"],[17,1,"ちか"],[21,2,"やくそく"]],"text":"アブラハムと結ばれた契約、イサクに誓われた約束である。"},{"ref":"1Chr.16.17","start":13016017,"end":13016017,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"かた"],[7,1,"た"],[17,1,"さだ"],[36,2,"けいやく"]],"text":"主はこれを堅く立ててヤコブのために定めとし、イスラエルのためにとこしえの契約として、"},{"ref":"1Chr.16.18","start":13016018,"end":13016018,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"い"],[14,1,"ち"],[16,1,"あた"],[26,1,"う"],[29,1,"し"],[30,1,"ぎょう"],[32,1,"わ"],[34,1,"まえ"]],"text":"言われた、「あなたにカナンの地を与えて、あなたがたの受ける嗣業の分け前とする」と。"},{"ref":"1Chr.16.19","start":13016019,"end":13016019,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"とき"],[4,1,"かれ"],[7,1,"かず"],[9,1,"すく"],[14,1,"かぞ"],[18,1,"た"],[24,1,"くに"],[26,1,"たび"]],"text":"その時、彼らの数は少なくて、数えるに足らず、かの国で旅びととなり、"},{"ref":"1Chr.16.20","start":13016020,"end":13016020,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"くに"],[3,1,"くに"],[5,1,"い"],[10,1,"くに"],[16,1,"たみ"],[18,1,"い"]],"text":"国から国へ行き、この国からほかの民へ行った。"},{"ref":"1Chr.16.21","start":13016021,"end":13016021,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ひと"],[4,1,"かれ"],[20,1,"かれ"],[26,1,"おう"],[30,1,"こら"]],"text":"主は人の彼らをしえたげるのをゆるされず、彼らのために王たちを懲しめて、"},{"ref":"1Chr.16.22","start":13016022,"end":13016022,"break":"line","breaks":[[18,"line"],[28,"line"]],"ruby":[[0,1,"い"],[8,1,"あぶら"],[14,1,"もの"],[30,3,"よげんしゃ"],[36,1,"がい"],[38,1,"くわ"]],"text":"言われた、「わが油そそがれた者たちにさわってはならない。わが預言者たちに害を加えてはならない」と。"},{"ref":"1Chr.16.23","start":13016023,"end":13016023,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ぜん"],[1,1,"ち"],[4,1,"しゅ"],[6,1,"む"],[10,1,"うた"],[13,1,"ひ"],[19,1,"すくい"],[21,1,"の"],[23,1,"つた"]],"text":"全地よ、主に向かって歌え。日ごとにその救を宣べ伝えよ。"},{"ref":"1Chr.16.24","start":13016024,"end":13016024,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"くに"],[7,1,"なか"],[11,2,"えいこう"],[24,1,"たみ"],[26,1,"なか"]],"text":"もろもろの国の中にその栄光をあらわし、もろもろの民の中にくすしきみわざをあらわせ。"},{"ref":"1Chr.16.25","start":13016025,"end":13016025,"break":"line","breaks":[[14,"line"],[25,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おお"],[23,1,"もの"],[30,1,"かみ"],[37,1,"おそ"],[41,1,"もの"]],"text":"主は大いなるかたにいまして、いとほめたたうべき者、もろもろの神にまさって、恐るべき者だからである。"},{"ref":"1Chr.16.26","start":13016026,"end":13016026,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"たみ"],[11,1,"かみ"],[21,1,"しゅ"],[23,1,"てん"],[25,1,"つく"]],"text":"もろもろの民のすべての神はむなしい。しかし主は天を造られた。"},{"ref":"1Chr.16.27","start":13016027,"end":13016027,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ほまれ"],[2,2,"いげん"],[9,1,"まえ"],[14,1,"ちから"],[16,1,"よろこ"],[22,2,"せいじょ"]],"text":"誉と威厳とはそのみ前にあり、力と喜びとはその聖所にある。"},{"ref":"1Chr.16.28","start":13016028,"end":13016028,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"たみ"],[12,1,"しゅ"],[14,1,"き"],[18,2,"えいこう"],[21,1,"ちから"],[24,1,"しゅ"],[26,1,"き"]],"text":"もろもろの民のやからよ、主に帰せよ、栄光と力とを主に帰せよ。"},{"ref":"1Chr.16.29","start":13016029,"end":13016029,"break":"line","breaks":[[19,"line"],[35,"line"]],"ruby":[[3,1,"な"],[10,2,"えいこう"],[13,1,"しゅ"],[15,1,"き"],[19,1,"そな"],[21,1,"もの"],[23,1,"たずさ"],[26,1,"しゅ"],[29,1,"まえ"],[35,1,"せい"],[38,1,"よそお"],[43,1,"しゅ"],[45,1,"おが"]],"text":"そのみ名にふさわしい栄光を主に帰せよ。供え物を携えて主のみ前にきたれ。聖なる装いをして主を拝め。"},{"ref":"1Chr.16.30","start":13016030,"end":13016030,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ぜん"],[1,1,"ち"],[7,1,"まえ"],[14,2,"せかい"],[17,1,"かた"],[19,1,"た"],[23,1,"うご"]],"text":"全地よ、そのみ前におののけ。世界は堅く立って、動かされることはない。"},{"ref":"1Chr.16.31","start":13016031,"end":13016031,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"てん"],[2,1,"よろこ"],[5,1,"ち"],[17,2,"くにたみ"],[20,1,"なか"],[22,1,"い"],[26,1,"しゅ"],[28,1,"おう"]],"text":"天は喜び、地はたのしみ、もろもろの国民の中に言え、「主は王であられる」と。"},{"ref":"1Chr.16.32","start":13016032,"end":13016032,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"うみ"],[4,1,"なか"],[6,1,"み"],[13,1,"な"],[20,2,"たはた"],[25,1,"なか"],[31,1,"もの"],[33,1,"よろこ"]],"text":"海とその中に満つるものとは鳴りどよめき、田畑とその中のすべての物は喜べ。"},{"ref":"1Chr.16.33","start":13016033,"end":13016033,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"はやし"],[11,1,"き"],[13,1,"しゅ"],[16,1,"まえ"],[18,1,"よろこ"],[20,1,"うた"],[23,1,"しゅ"],[25,1,"ち"]],"text":"そのとき林のもろもろの木も主のみ前に喜び歌う。主は地をさばくためにこられるからである。"},{"ref":"1Chr.16.34","start":13016034,"end":13016034,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"かんしゃ"],[7,1,"しゅ"],[9,1,"めぐ"],[28,1,"た"]],"text":"主に感謝せよ、主は恵みふかく、そのいつくしみはとこしえに絶えることがない。"},{"ref":"1Chr.16.35","start":13016035,"end":13016035,"break":"line","breaks":[[24,"line"],[35,"line"],[51,"line"],[70,"line"]],"ruby":[[2,1,"い"],[11,1,"すくい"],[13,1,"かみ"],[21,1,"すく"],[29,2,"くにたみ"],[32,1,"なか"],[40,1,"あつ"],[44,1,"すく"],[60,1,"せい"],[64,1,"な"],[66,2,"かんしゃ"],[74,1,"ほまれ"],[76,1,"ほこ"]],"text":"また言え、「われわれの救の神よ、われわれを救い、もろもろの国民の中からわれわれを集めてお救いください。そうすればあなたの聖なるみ名に感謝し、あなたの誉を誇るでしょう。"},{"ref":"1Chr.16.36","start":13016036,"end":13016036,"break":"line","breaks":[[11,"line"]],"ruby":[[6,1,"かみ"],[8,1,"しゅ"],[34,1,"とき"],[39,1,"たみ"],[48,1,"い"],[51,1,"しゅ"]],"text":"イスラエルの神、主は、とこしえからとこしえまでほむべきかな」と。その時すべての民は「アァメン」と言って主をほめたたえた。"},{"ref":"1Chr.16.37","start":13016037,"end":13016037,"break":"paragraph","ruby":[[10,2,"きょうだい"],[15,1,"しゅ"],[17,2,"けいやく"],[20,1,"はこ"],[22,1,"まえ"],[30,1,"つね"],[32,1,"はこ"],[34,1,"まえ"],[36,1,"つか"],[39,2,"ひび"],[45,1,"おこな"]],"text":"ダビデはアサフとその兄弟たちを主の契約の箱の前にとめおいて、常に箱の前に仕え、日々のわざを行わせた。"},{"ref":"1Chr.16.38","start":13016038,"end":13016038,"break":"none","ruby":[[10,2,"きょうだい"],[15,1,"あ"],[22,1,"にん"],[34,1,"こ"],[48,2,"かどもり"]],"text":"オベデ・エドムとその兄弟たちは合わせて六十八人である。またエドトンの子オベデ・エドムおよびホサは門守であった。"},{"ref":"1Chr.16.39","start":13016039,"end":13016039,"break":"none","ruby":[[0,2,"さいし"],[8,2,"きょうだい"],[13,2,"さいし"],[25,1,"たか"],[27,1,"ところ"],[29,1,"しゅ"],[31,2,"まくや"],[34,1,"まえ"],[36,1,"つか"]],"text":"祭司ザドクとその兄弟である祭司たちはギベオンにある高き所で主の幕屋の前に仕え、"},{"ref":"1Chr.16.40","start":13016040,"end":13016040,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"めい"],[13,2,"りっぽう"],[33,2,"はんさい"],[36,1,"だん"],[38,1,"うえ"],[40,2,"あさゆう"],[45,2,"はんさい"],[48,1,"しゅ"]],"text":"主がイスラエルに命じられた律法にしるされたすべてのことにしたがって燔祭の壇の上に朝夕たえず燔祭を主にささげた。"},{"ref":"1Chr.16.41","start":13016041,"end":13016041,"break":"none","ruby":[[2,1,"かれ"],[22,1,"えら"],[26,1,"な"],[33,1,"もの"],[40,1,"しゅ"],[48,2,"よよ"],[50,1,"かぎ"],[60,1,"しゅ"],[62,2,"かんしゃ"]],"text":"また彼らとともにヘマン、エドトンおよびほかの選ばれて名をしるされた者どもがいて、主のいつくしみの世々限りなきことについて主に感謝した。"},{"ref":"1Chr.16.42","start":13016042,"end":13016042,"break":"none","ruby":[[15,1,"かれ"],[37,1,"た"],[39,2,"せいか"],[45,2,"がっき"],[51,2,"おんがく"],[54,1,"そう"],[62,1,"こ"],[65,1,"もん"],[67,1,"まも"]],"text":"すなわちヘマンおよびエドトンは彼らとともにいて、ラッパ、シンバルおよびその他の聖歌のための楽器をとって音楽を奏し、エドトンの子らは門を守った。"},{"ref":"1Chr.16.43","start":13016043,"end":13016043,"break":"paragraph","ruby":[[4,1,"たみ"],[6,1,"みな"],[11,1,"いえ"],[13,1,"かえ"],[22,2,"かぞく"],[25,2,"しゅくふく"],[32,1,"かえ"],[35,1,"い"]],"text":"こうして民は皆おのおの家に帰り、ダビデはその家族を祝福するために帰って行った。"}]