[{"ref":"Job.27.1","start":18027001,"end":18027001,"break":"paragraph","ruby":[[5,2,"ことば"],[11,1,"い"]],"text":"ヨブはまた言葉をついで言った、"},{"ref":"Job.27.2","start":18027002,"end":18027002,"break":"stanza","breaks":[[11,"line"],[26,"line"]],"ruby":[[1,1,"かみ"],[3,1,"い"],[11,1,"かれ"],[17,1,"ぎ"],[19,1,"うば"],[21,1,"さ"],[26,3,"ぜんのうしゃ"],[34,1,"たましい"],[36,1,"なや"]],"text":"「神は生きておられる。彼はわたしの義を奪い去られた。全能者はわたしの魂を悩まされた。"},{"ref":"Job.27.3","start":18027003,"end":18027003,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"いき"],[16,1,"かみ"],[18,1,"いき"],[24,1,"はな"],[28,1,"あいだ"]],"text":"わたしの息がわたしのうちにあり、神の息がわたしの鼻にある間、"},{"ref":"Job.27.4","start":18027004,"end":18027004,"break":"line","breaks":[[17,"line"]],"ruby":[[9,2,"ふぎ"],[12,1,"い"],[21,1,"した"],[23,1,"いつわ"],[26,1,"かた"]],"text":"わたしのくちびるは不義を言わない、わたしの舌は偽りを語らない。"},{"ref":"Job.27.5","start":18027005,"end":18027005,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"だん"],[14,1,"ただ"],[19,1,"みと"],[28,1,"し"],[33,2,"けっぱく"],[36,2,"しゅちょう"]],"text":"わたしは断じて、あなたがたを正しいとは認めない。わたしは死ぬまで、潔白を主張してやめない。"},{"ref":"Job.27.6","start":18027006,"end":18027006,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"かた"],[8,1,"ぎ"],[10,1,"たも"],[13,1,"す"],[22,1,"いま"],[26,1,"にち"],[28,1,"こころ"],[30,1,"せ"],[35,1,"こと"]],"text":"わたしは堅くわが義を保って捨てない。わたしは今まで一日も心に責められた事がない。"},{"ref":"Job.27.7","start":18027007,"end":18027007,"break":"stanza","breaks":[[19,"line"],[28,"line"]],"ruby":[[8,1,"てき"],[10,2,"あくにん"],[23,1,"さか"],[26,1,"もの"],[28,2,"ふぎ"],[32,1,"もの"]],"text":"どうか、わたしの敵は悪人のようになり、わたしに逆らう者は不義なる者のようになるように。"},{"ref":"Job.27.8","start":18027008,"end":18027008,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[4,1,"た"],[9,1,"たましい"],[11,1,"ぬ"],[20,1,"かみ"],[22,1,"しん"],[26,1,"もの"],[31,1,"のぞ"]],"text":"神が彼を断ち、その魂を抜きとられるとき、神を信じない者になんの望みがあろう。"},{"ref":"Job.27.9","start":18027009,"end":18027009,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"わざわい"],[2,1,"かれ"],[4,1,"のぞ"],[9,1,"かみ"],[13,1,"さけ"],[16,1,"き"]],"text":"災が彼に臨むとき、神はその叫びを聞かれるであろうか。"},{"ref":"Job.27.10","start":18027010,"end":18027010,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[2,3,"ぜんのうしゃ"],[6,1,"よろこ"],[14,1,"つね"],[16,1,"かみ"],[18,1,"よ"]],"text":"彼は全能者を喜ぶであろうか、常に神を呼ぶであろうか。"},{"ref":"Job.27.11","start":18027011,"end":18027011,"break":"stanza","breaks":[[21,"line"]],"ruby":[[4,1,"かみ"],[7,1,"て"],[18,1,"おし"],[21,3,"ぜんのうしゃ"],[25,1,"とも"],[32,1,"かく"]],"text":"わたしは神のみ手についてあなたがたに教え、全能者と共にあるものを隠すことをしない。"},{"ref":"Job.27.12","start":18027012,"end":18027012,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"み"],[9,1,"みな"],[17,1,"み"],[34,1,"もの"]],"text":"見よ、あなたがたは皆みずからこれを見た、それなのに、どうしてむなしい者となったのか。"},{"ref":"Job.27.13","start":18027013,"end":18027013,"break":"stanza","breaks":[[14,"line"]],"ruby":[[3,2,"あくにん"],[6,1,"かみ"],[9,1,"う"],[12,1,"ぶん"],[14,3,"あっせいしゃ"],[18,3,"ぜんのうしゃ"],[23,1,"う"],[26,1,"し"],[27,1,"ぎょう"]],"text":"これは悪人の神から受ける分、圧制者の全能者から受ける嗣業である。"},{"ref":"Job.27.14","start":18027014,"end":18027014,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"こ"],[13,1,"わた"],[19,2,"しそん"],[22,2,"しょくもつ"],[25,1,"あ"]],"text":"その子らがふえればつるぎに渡され、その子孫は食物に飽きることがない。"},{"ref":"Job.27.15","start":18027015,"end":18027015,"break":"line","breaks":[[20,"line"]],"ruby":[[2,1,"い"],[4,1,"のこ"],[7,1,"もの"],[9,2,"えきびょう"],[12,1,"し"],[15,1,"う"],[27,1,"な"],[29,1,"かな"]],"text":"その生き残った者は疫病で死んで埋められ、そのやもめらは泣き悲しむことをしない。"},{"ref":"Job.27.16","start":18027016,"end":18027016,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"かれ"],[5,1,"ぎん"],[13,1,"つ"],[16,2,"いふく"],[19,1,"つち"],[24,1,"そな"]],"text":"たとい彼は銀をちりのように積み、衣服を土のように備えても、"},{"ref":"Job.27.17","start":18027017,"end":18027017,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"そな"],[8,1,"ただ"],[11,1,"ひと"],[16,1,"き"],[20,1,"ぎん"],[22,1,"つみ"],[25,1,"もの"],[27,1,"わ"],[30,1,"と"]],"text":"その備えるものは正しい人がこれを着、その銀は罪なき者が分かち取るであろう。"},{"ref":"Job.27.18","start":18027018,"end":18027018,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[2,1,"た"],[5,1,"いえ"],[11,1,"す"],[19,2,"ばんにん"],[22,1,"つく"],[24,2,"こや"]],"text":"彼の建てる家は、くもの巣のようであり、番人の造る小屋のようである。"},{"ref":"Job.27.19","start":18027019,"end":18027019,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[2,1,"と"],[5,1,"み"],[7,1,"ね"],[11,1,"ふたた"],[13,1,"と"],[21,1,"め"],[23,1,"ひら"],[28,1,"とみ"]],"text":"彼は富める身で寝ても、再び富むことがなく、目を開けばその富はない。"},{"ref":"Job.27.20","start":18027020,"end":18027020,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"おそ"],[4,1,"こと"],[6,2,"おおみず"],[12,1,"かれ"],[14,1,"おそ"],[17,1,"よる"],[22,1,"かぜ"],[24,1,"かれ"],[26,1,"うば"],[28,1,"さ"]],"text":"恐ろしい事が大水のように彼を襲い、夜はつむじ風が彼を奪い去る。"},{"ref":"Job.27.21","start":18027021,"end":18027021,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"ひがしかぜ"],[3,1,"かれ"],[5,1,"あ"],[10,1,"かれ"],[12,1,"さ"],[15,1,"かれ"],[19,1,"ところ"],[22,1,"ふ"],[24,1,"はら"]],"text":"東風が彼を揚げると、彼は去り、彼をその所から吹き払う。"},{"ref":"Job.27.22","start":18027022,"end":18027022,"break":"line","breaks":[[20,"line"]],"ruby":[[3,1,"かれ"],[5,1,"な"],[20,1,"かれ"],[24,1,"ちから"]],"text":"それは彼を投げつけて、あわれむことなく、彼はその力からのがれようと、もがく。"},{"ref":"Job.27.23","start":18027023,"end":18027023,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"かれ"],[5,1,"む"],[9,1,"て"],[11,1,"な"],[19,1,"わら"],[25,1,"ところ"],[28,1,"で"],[30,1,"い"]],"text":"それは彼に向かって手を鳴らし、あざけり笑って、その所から出て行かせる。"}]