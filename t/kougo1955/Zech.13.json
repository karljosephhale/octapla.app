[{"ref":"Zech.13.1","start":38013001,"end":38013001,"break":"paragraph","ruby":[[2,1,"ひ"],[6,1,"つみ"],[8,1,"けが"],[12,1,"きよ"],[15,1,"ひと"],[18,1,"いずみ"],[25,1,"いえ"],[33,2,"じゅうみん"],[40,1,"ひら"]],"text":"その日には、罪と汚れとを清める一つの泉が、ダビデの家とエルサレムの住民とのために開かれる。"},{"ref":"Zech.13.2","start":38013002,"end":38013002,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[12,1,"ひ"],[20,1,"ち"],[23,2,"ぐうぞう"],[26,1,"な"],[28,1,"と"],[30,1,"のぞ"],[33,1,"かさ"],[36,1,"ひと"],[38,1,"おぼ"],[60,3,"よげんしゃ"],[66,1,"けが"],[69,1,"れい"],[72,1,"ち"],[75,1,"さ"]],"text":"万軍の主は言われる、その日には、わたしは地から偶像の名を取り除き、重ねて人に覚えられることのないようにする。わたしはまた預言者および汚れの霊を、地から去らせる。"},{"ref":"Zech.13.3","start":38013003,"end":38013003,"break":"none","ruby":[[3,1,"ひと"],[5,2,"こんご"],[7,2,"よげん"],[17,1,"う"],[20,2,"ふぼ"],[36,1,"しゅ"],[38,1,"な"],[43,1,"いつわ"],[46,1,"かた"],[51,1,"い"],[65,1,"い"],[70,1,"う"],[73,2,"ふぼ"],[76,1,"かれ"],[78,2,"よげん"],[84,1,"とき"],[86,1,"かれ"],[88,1,"さ"]],"text":"もし、人が今後預言するならば、その産みの父母はこれにむかって、『あなたは主の名をもって偽りを語るゆえ、生きていることができない』と言い、その産みの父母は彼が預言している時、彼を刺すであろう。"},{"ref":"Zech.13.4","start":38013004,"end":38013004,"break":"none","ruby":[[2,1,"ひ"],[6,3,"よげんしゃ"],[12,1,"みな"],[13,2,"よげん"],[17,1,"とき"],[21,1,"まぼろし"],[23,1,"は"],[29,1,"ひと"],[31,1,"あざむ"],[36,1,"け"],[38,2,"うわぎ"],[41,1,"き"]],"text":"その日には、預言者たちは皆預言する時、その幻を恥じる。また人を欺くための毛の上着を着ない。"},{"ref":"Zech.13.5","start":38013005,"end":38013005,"break":"none","ruby":[[8,3,"よげんしゃ"],[20,2,"とち"],[23,1,"たがや"],[25,1,"もの"],[28,1,"わか"],[30,1,"とき"],[33,2,"とち"],[36,1,"も"],[43,1,"い"]],"text":"そして『わたしは預言者ではない、わたしは土地を耕す者だ。若い時から土地を持っている』と言う。"},{"ref":"Zech.13.6","start":38013006,"end":38013006,"break":"none","ruby":[[3,1,"ひと"],[5,1,"かれ"],[12,2,"せなか"],[15,1,"きず"],[17,1,"なに"],[21,1,"たず"],[36,1,"とも"],[40,1,"いえ"],[42,1,"う"],[45,1,"きず"],[50,1,"かれ"],[52,1,"い"]],"text":"もし、人が彼に『あなたの背中の傷は何か』と尋ねるならば、『これはわたしの友だちの家で受けた傷だ』と、彼は言うであろう」。"},{"ref":"Zech.13.7","start":38013007,"end":38013007,"break":"paragraph","breaks":[[10,"stanza"],[31,"line"],[45,"line"],[58,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[16,1,"た"],[18,1,"あ"],[24,2,"ぼくしゃ"],[27,1,"せ"],[35,1,"つぎ"],[37,1,"た"],[39,1,"ひと"],[41,1,"せ"],[45,2,"ぼくしゃ"],[48,1,"う"],[53,1,"ひつじ"],[55,1,"ち"],[62,1,"て"],[69,1,"ちい"],[72,1,"もの"],[76,1,"せ"]],"text":"万軍の主は言われる、「つるぎよ、立ち上がってわが牧者を攻めよ。わたしの次に立つ人を攻めよ。牧者を撃て、その羊は散る。わたしは手をかえして、小さい者どもを攻める。"},{"ref":"Zech.13.8","start":38013008,"end":38013008,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"ぜん"],[8,1,"ち"],[10,1,"ひと"],[13,1,"ぶん"],[17,1,"た"],[21,1,"し"],[25,1,"ぶん"],[29,1,"い"],[31,1,"のこ"]],"text":"主は言われる、全地の人の三分の二は断たれて死に、三分の一は生き残る。"},{"ref":"Zech.13.9","start":38013009,"end":38013009,"break":"line","breaks":[[18,"line"],[37,"line"],[55,"line"],[78,"line"]],"ruby":[[7,1,"ぶん"],[11,1,"ひ"],[13,1,"なか"],[15,1,"い"],[18,1,"ぎん"],[22,1,"わ"],[34,1,"わ"],[37,1,"きん"],[39,2,"せいれん"],[50,2,"せいれん"],[55,1,"かれ"],[62,1,"な"],[64,1,"よ"],[71,1,"かれ"],[74,1,"こた"],[83,1,"かれ"],[88,1,"たみ"],[94,1,"い"],[97,1,"かれ"],[101,1,"しゅ"],[105,1,"かみ"],[111,1,"い"]],"text":"わたしはこの三分の一を火の中に入れ、銀をふき分けるように、これをふき分け、金を精錬するように、これを精錬する。彼らはわたしの名を呼び、わたしは彼らに答える。わたしは『彼らはわが民である』と言い、彼らは『主はわが神である』と言う」。"}]