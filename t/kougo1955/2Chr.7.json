[{"ref":"2Chr.7.1","start":14007001,"end":14007001,"break":"paragraph","ruby":[[5,1,"いの"],[7,1,"おわ"],[13,1,"てん"],[16,1,"ひ"],[18,1,"くだ"],[21,2,"はんさい"],[24,2,"ぎせい"],[27,1,"や"],[30,1,"しゅ"],[32,2,"えいこう"],[35,1,"みや"],[37,1,"み"]],"text":"ソロモンが祈り終ったとき、天から火が下って燔祭と犠牲を焼き、主の栄光が宮に満ちた。"},{"ref":"2Chr.7.2","start":14007002,"end":14007002,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"えいこう"],[5,1,"しゅ"],[7,1,"みや"],[9,1,"み"],[15,2,"さいし"],[20,1,"しゅ"],[22,1,"みや"]],"text":"主の栄光が主の宮に満ちたので、祭司たちは主の宮に、はいることができなかった。"},{"ref":"2Chr.7.3","start":14007003,"end":14007003,"break":"none","breaks":[[62,"stanza"],[71,"line"]],"ruby":[[6,2,"ひとびと"],[11,1,"ひ"],[13,1,"くだ"],[18,1,"み"],[22,1,"しゅ"],[24,2,"えいこう"],[27,1,"みや"],[29,1,"のぞ"],[34,1,"み"],[37,2,"しきいし"],[40,1,"うえ"],[42,1,"ち"],[46,1,"ふ"],[49,1,"はい"],[52,1,"しゅ"],[54,2,"かんしゃ"],[58,1,"い"],[63,1,"しゅ"],[65,1,"めぐ"],[84,1,"た"]],"text":"イスラエルの人々はみな火が下ったのを見、また主の栄光が宮に臨んだのを見て、敷石の上で地にひれ伏して拝し、主に感謝して言った、「主は恵みふかく、そのいつくしみはとこしえに絶えることがない」。"},{"ref":"2Chr.7.4","start":14007004,"end":14007004,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"たみ"],[7,1,"みな"],[8,1,"しゅ"],[10,1,"まえ"],[12,2,"ぎせい"]],"text":"そして王と民は皆主の前に犠牲をささげた。"},{"ref":"2Chr.7.5","start":14007005,"end":14007005,"break":"none","ruby":[[4,1,"おう"],[10,2,"ぎせい"],[14,1,"うし"],[19,1,"とう"],[21,1,"ひつじ"],[25,1,"とう"],[35,1,"おう"],[37,1,"たみ"],[39,1,"みな"],[40,1,"かみ"],[42,1,"みや"]],"text":"ソロモン王のささげた犠牲は、牛二万二千頭、羊十二万頭であった。こうして王と民は皆神の宮をささげた。"},{"ref":"2Chr.7.6","start":14007006,"end":14007006,"break":"none","ruby":[[0,2,"さいし"],[5,1,"も"],[7,1,"ば"],[9,1,"た"],[17,1,"しゅ"],[19,2,"がっき"],[25,1,"た"],[31,2,"がっき"],[37,1,"おう"],[39,1,"しゅ"],[41,2,"かんしゃ"],[48,1,"つく"],[59,1,"かれ"],[62,1,"て"],[93,1,"た"],[115,2,"さいし"],[118,1,"かれ"],[121,1,"まえ"],[127,1,"ふ"],[142,1,"た"]],"text":"祭司はその持ち場に立ち、レビびとも主の楽器をとって立った。その楽器はダビデ王が主に感謝するために造ったもので、ダビデが彼らの手によってさんびをささげるとき、「そのいつくしみは、とこしえに絶えることがない」ととなえさせたものである。祭司は彼らの前でラッパを吹き、すべてのイスラエルびとは立っていた。"},{"ref":"2Chr.7.7","start":14007007,"end":14007007,"break":"paragraph","ruby":[[7,1,"しゅ"],[9,1,"みや"],[11,1,"まえ"],[15,1,"にわ"],[17,1,"なか"],[19,2,"せいべつ"],[25,1,"ところ"],[28,2,"はんさい"],[31,3,"しゅうおんさい"],[52,1,"つく"],[55,2,"せいどう"],[58,2,"さいだん"],[64,2,"はんさい"],[67,2,"そさい"],[75,1,"の"],[79,1,"た"]],"text":"ソロモンはまた主の宮の前にある庭の中を聖別し、その所で、燔祭と酬恩祭のあぶらをささげた。これはソロモンが造った青銅の祭壇が、その燔祭と素祭とあぶらとを載せるに足りなかったからである。"},{"ref":"2Chr.7.8","start":14007008,"end":14007008,"break":"paragraph","ruby":[[2,1,"とき"],[8,2,"なぬか"],[11,1,"あいだ"],[12,1,"まつり"],[14,1,"おこな"],[22,2,"いりぐち"],[31,1,"かわ"],[33,1,"いた"],[50,1,"かれ"],[52,1,"とも"],[57,2,"ひじょう"],[60,1,"おお"],[63,2,"かいしゅう"]],"text":"その時ソロモンは七日の間祭を行った。ハマテの入口からエジプトの川に至るまでのすべてのイスラエルびとが彼と共にあり、非常に大きな会衆であった。"},{"ref":"2Chr.7.9","start":14007009,"end":14007009,"break":"none","ruby":[[4,1,"か"],[5,1,"め"],[7,1,"せい"],[8,1,"かい"],[10,1,"ひら"],[14,1,"かれ"],[17,2,"なぬか"],[20,1,"あいだ"],[22,2,"さいだん"],[24,2,"ほうけん"],[27,1,"れい"],[29,1,"おこな"],[32,2,"なぬか"],[35,1,"あいだ"],[36,1,"まつり"],[38,1,"おこな"]],"text":"そして八日目に聖会を開いた。彼らは七日の間、祭壇奉献の礼を行い、七日の間祭を行ったが、"},{"ref":"2Chr.7.10","start":14007010,"end":14007010,"break":"none","ruby":[[1,1,"がつ"],[5,1,"にち"],[7,1,"いた"],[15,1,"たみ"],[19,2,"てんまく"],[22,1,"かえ"],[27,1,"みな"],[28,1,"しゅ"],[43,1,"たみ"],[50,1,"ほどこ"],[54,1,"めぐ"],[60,1,"よろこ"],[65,1,"こころ"],[67,1,"たの"],[71,1,"さ"]],"text":"七月二十三日に至ってソロモンは民をその天幕に帰らせた。皆主がダビデ、ソロモンおよびその民イスラエルに施された恵みのために喜び、かつ心に楽しんで去った。"},{"ref":"2Chr.7.11","start":14007011,"end":14007011,"break":"paragraph","ruby":[[9,1,"しゅ"],[11,1,"いえ"],[13,1,"おう"],[15,1,"いえ"],[18,1,"つく"],[20,1,"お"],[28,1,"かれ"],[30,1,"しゅ"],[32,1,"いえ"],[34,2,"じぶん"],[37,1,"いえ"],[47,2,"けいかく"],[55,1,"こと"],[57,2,"しゅび"],[63,1,"と"]],"text":"こうしてソロモンは主の家と王の家とを造り終えた。すなわち彼は主の家と自分の家について、しようと計画したすべての事を首尾よくなし遂げた。"},{"ref":"2Chr.7.12","start":14007012,"end":14007012,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,1,"よる"],[10,1,"あらわ"],[13,1,"い"],[27,1,"いのり"],[29,1,"き"],[34,1,"ところ"],[43,1,"えら"],[47,2,"ぎせい"],[54,1,"いえ"]],"text":"時に主は夜ソロモンに現れて言われた、「わたしはあなたの祈を聞き、この所をわたしのために選んで、犠牲をささげる家とした。"},{"ref":"2Chr.7.13","start":14007013,"end":14007013,"break":"none","ruby":[[4,1,"てん"],[6,1,"と"],[9,1,"あめ"],[26,1,"めい"],[29,1,"ち"],[31,1,"もの"],[33,1,"く"],[40,2,"えきびょう"],[43,1,"たみ"],[45,1,"なか"],[47,1,"おく"]],"text":"わたしが天を閉じて雨をなくし、またはわたしがいなごに命じて地の物を食わせ、または疫病を民の中に送るとき、"},{"ref":"2Chr.7.14","start":14007014,"end":14007014,"break":"none","ruby":[[4,1,"な"],[19,1,"たみ"],[30,1,"いの"],[38,1,"かお"],[40,1,"もと"],[45,1,"わる"],[47,1,"みち"],[49,1,"はな"],[60,1,"てん"],[63,1,"き"],[69,1,"つみ"],[77,1,"ち"]],"text":"わたしの名をもってとなえられるわたしの民が、もしへりくだり、祈って、わたしの顔を求め、その悪い道を離れるならば、わたしは天から聞いて、その罪をゆるし、その地をいやす。"},{"ref":"2Chr.7.15","start":14007015,"end":14007015,"break":"none","ruby":[[0,1,"いま"],[3,1,"ところ"],[11,1,"いのり"],[17,1,"め"],[19,1,"ひら"],[22,1,"みみ"],[24,1,"かたむ"]],"text":"今この所にささげられる祈にわたしの目を開き、耳を傾ける。"},{"ref":"2Chr.7.16","start":14007016,"end":14007016,"break":"none","ruby":[[0,1,"いま"],[9,1,"な"],[27,1,"みや"],[29,1,"えら"],[34,2,"せいべつ"],[43,1,"め"],[49,1,"こころ"],[51,1,"つね"]],"text":"今わたしはわたしの名をながくここにとどめるために、この宮を選び、かつ聖別した。わたしの目とわたしの心は常にここにある。"},{"ref":"2Chr.7.17","start":14007017,"end":14007017,"break":"none","ruby":[[6,1,"ちち"],[11,1,"あゆ"],[21,1,"まえ"],[23,1,"あゆ"],[30,1,"めい"],[40,1,"い"],[48,1,"さだ"],[56,1,"まも"]],"text":"あなたがもし父ダビデの歩んだようにわたしの前に歩み、わたしが命じたとおりにすべて行って、わたしの定めとおきてとを守るならば、"},{"ref":"2Chr.7.18","start":14007018,"end":14007018,"break":"none","ruby":[[8,1,"ちち"],[13,2,"けいやく"],[24,1,"おさ"],[27,1,"ひと"],[33,1,"か"],[43,1,"い"],[55,1,"おう"],[57,1,"くらい"],[59,1,"かた"]],"text":"わたしはあなたの父ダビデに契約して『イスラエルを治める人はあなたに欠けることがない』と言ったとおりに、あなたの王の位を堅くする。"},{"ref":"2Chr.7.19","start":14007019,"end":14007019,"break":"paragraph","ruby":[[12,1,"ひるがえ"],[26,1,"まえ"],[28,1,"お"],[31,1,"さだ"],[34,1,"いまし"],[38,1,"す"],[41,1,"い"],[44,1,"た"],[46,2,"かみがみ"],[49,1,"つか"],[55,1,"おが"]],"text":"しかし、あなたがたがもし翻って、わたしがあなたがたの前に置いた定めと戒めとを捨て、行って他の神々に仕え、それを拝むならば、"},{"ref":"2Chr.7.20","start":14007020,"end":14007020,"break":"none","ruby":[[14,1,"あた"],[17,1,"ち"],[20,1,"ぬ"],[22,1,"さ"],[31,1,"な"],[36,2,"せいべつ"],[42,1,"みや"],[48,1,"まえ"],[51,1,"な"],[53,1,"す"],[62,1,"たみ"],[74,1,"わら"],[76,1,"ぐさ"]],"text":"わたしはあなたがたをわたしの与えた地から抜き去り、またわたしの名のために聖別したこの宮をわたしの前から投げ捨てて、もろもろの民のうちにことわざとし、笑い草とする。"},{"ref":"2Chr.7.21","start":14007021,"end":14007021,"break":"none","ruby":[[4,1,"みや"],[6,1,"たか"],[25,1,"す"],[28,1,"もの"],[30,1,"みな"],[31,1,"おどろ"],[36,1,"なに"],[39,1,"しゅ"],[43,1,"ち"],[48,1,"みや"],[63,1,"い"]],"text":"またこの宮は高いけれども、ついには、そのかたわらを過ぎる者は皆驚いて、『何ゆえ主はこの地と、この宮とにこのようにされたのか』と言うであろう。"},{"ref":"2Chr.7.22","start":14007022,"end":14007022,"break":"none","ruby":[[2,1,"とき"],[4,2,"ひとびと"],[7,1,"こた"],[11,1,"かれ"],[16,2,"せんぞ"],[26,1,"ち"],[29,1,"みちび"],[31,1,"だ"],[34,1,"かれ"],[37,1,"かみ"],[39,1,"しゅ"],[41,1,"す"],[45,1,"た"],[47,2,"かみがみ"],[52,1,"したが"],[58,1,"おが"],[64,1,"つか"],[71,1,"しゅ"],[79,1,"わざわい"],[81,1,"かれ"],[84,1,"うえ"],[86,1,"くだ"],[95,1,"い"]],"text":"その時、人々は答えて『彼らはその先祖たちをエジプトの地から導き出した彼らの神、主を捨てて、他の神々につき従い、それを拝み、それに仕えたために、主はこのすべての災を彼らの上に下したのである』と言うであろう」。"}]