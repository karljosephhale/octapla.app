[{"ref":"Ps.38.1","start":19038001,"end":19038001,"break":"paragraph","title":"記念のためにうたったダビデの歌","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"いきどお"],[17,1,"せ"],[21,1,"はげ"],[24,1,"いか"],[34,1,"こ"]],"titleRuby":[[0,2,"きねん"],[14,1,"うた"]],"text":"主よ、あなたの憤りをもってわたしを責めず、激しい怒りをもってわたしを懲らさないでください。"},{"ref":"Ps.38.2","start":19038002,"end":19038002,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"や"],[10,1,"つ"],[12,1,"さ"],[20,1,"て"],[26,1,"うえ"]],"text":"あなたの矢がわたしに突き刺さり、あなたの手がわたしの上にくだりました。"},{"ref":"Ps.38.3","start":19038003,"end":19038003,"break":"line","breaks":[[11,"line"],[26,"line"],[36,"line"]],"ruby":[[4,1,"いか"],[15,1,"にく"],[18,1,"まった"],[30,1,"つみ"],[40,1,"ほね"],[43,1,"すこ"]],"text":"あなたの怒りによって、わたしの肉には全きところなく、わたしの罪によって、わたしの骨には健やかなところはありません。"},{"ref":"Ps.38.4","start":19038004,"end":19038004,"break":"line","breaks":[[16,"line"]],"ruby":[[4,2,"ふぎ"],[11,1,"あたま"],[13,1,"こ"],[16,2,"おもに"],[22,1,"おも"],[25,1,"お"]],"text":"わたしの不義はわたしの頭を越え、重荷のように重くて負うことができません。"},{"ref":"Ps.38.5","start":19038005,"end":19038005,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"おろ"],[15,1,"きず"],[17,2,"あくしゅう"],[20,1,"はな"],[23,1,"くさ"]],"text":"わたしの愚かによって、わたしの傷は悪臭を放ち、腐れただれました。"},{"ref":"Ps.38.6","start":19038006,"end":19038006,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"お"],[23,1,"かな"],[27,1,"ある"]],"text":"わたしは折れかがんで、いたくうなだれ、ひねもす悲しんで歩くのです。"},{"ref":"Ps.38.7","start":19038007,"end":19038007,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"こし"],[11,1,"や"],[18,1,"にく"],[21,1,"まった"]],"text":"わたしの腰はことごとく焼け、わたしの肉には全きところがありません。"},{"ref":"Ps.38.8","start":19038008,"end":19038008,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"おとろ"],[12,1,"う"],[23,1,"こころ"],[25,1,"はげ"],[28,1,"さわ"],[37,1,"さけ"]],"text":"わたしは衰えはて、いたく打ちひしがれ、わたしの心の激しい騒ぎによってうめき叫びます。"},{"ref":"Ps.38.9","start":19038009,"end":19038009,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"ねが"],[18,1,"し"],[26,1,"なげ"],[33,1,"かく"]],"text":"主よ、わたしのすべての願いはあなたに知られ、わたしの嘆きはあなたに隠れることはありません。"},{"ref":"Ps.38.10","start":19038010,"end":19038010,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"むね"],[6,1,"はげ"],[9,1,"う"],[16,1,"ちから"],[18,1,"おとろ"],[25,1,"め"],[27,1,"ひかり"],[36,1,"はな"],[38,1,"さ"]],"text":"わたしの胸は激しく打ち、わたしの力は衰え、わたしの目の光もまた、わたしを離れ去りました。"},{"ref":"Ps.38.11","start":19038011,"end":19038011,"break":"line","breaks":[[11,"line"],[25,"line"]],"ruby":[[2,1,"とも"],[15,1,"わざわい"],[17,1,"み"],[19,1,"はな"],[22,1,"た"],[27,2,"しんぞく"],[32,1,"とお"],[34,1,"はな"],[37,1,"た"]],"text":"わが友、わがともがらはわたしの災を見て離れて立ち、わが親族もまた遠く離れて立っています。"},{"ref":"Ps.38.12","start":19038012,"end":19038012,"break":"line","breaks":[[19,"line"],[42,"line"]],"ruby":[[8,1,"もと"],[11,1,"もの"],[16,1,"もう"],[31,1,"もの"],[33,1,"ほろ"],[39,1,"かた"],[46,1,"あざむ"]],"text":"わたしのいのちを求める者はわなを設け、わたしをそこなおうとする者は滅ぼすことを語り、ひねもす欺くことをはかるのです。"},{"ref":"Ps.38.13","start":19038013,"end":19038013,"break":"line","breaks":[[18,"line"]],"ruby":[[7,1,"みみ"],[14,1,"き"],[24,1,"くち"],[26,1,"ひら"]],"text":"しかしわたしは耳しいのように聞かず、おしのように口を開きません。"},{"ref":"Ps.38.14","start":19038014,"end":19038014,"break":"line","breaks":[[19,"line"]],"ruby":[[9,1,"き"],[13,1,"ひと"],[19,2,"ぎろん"],[22,1,"くち"],[27,1,"ひと"]],"text":"まことに、わたしは聞かない人のごとく、議論を口にしない人のようです。"},{"ref":"Ps.38.15","start":19038015,"end":19038015,"break":"line","breaks":[[22,"line"],[29,"line"]],"ruby":[[4,1,"しゅ"],[15,1,"ま"],[17,1,"のぞ"],[24,1,"かみ"],[26,1,"しゅ"],[38,1,"こた"]],"text":"しかし、主よ、わたしはあなたを待ち望みます。わが神、主よ、あなたこそわたしに答えられるのです。"},{"ref":"Ps.38.16","start":19038016,"end":19038016,"break":"line","breaks":[[20,"line"],[34,"line"],[49,"line"]],"ruby":[[4,1,"いの"],[12,1,"あし"],[28,1,"たか"],[31,1,"かれ"],[44,1,"よろこ"]],"text":"わたしは祈ります、「わが足のすべるとき、わたしにむかって高ぶる彼らにわたしのことによって喜ぶことをゆるさないでください」と。"},{"ref":"Ps.38.17","start":19038017,"end":19038017,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"たお"],[18,1,"くる"],[22,1,"つね"],[28,1,"とも"]],"text":"わたしは倒れるばかりになり、わたしの苦しみは常にわたしと共にあります。"},{"ref":"Ps.38.18","start":19038018,"end":19038018,"break":"line","breaks":[[19,"line"]],"ruby":[[9,2,"ふぎ"],[12,1,"い"],[21,1,"つみ"],[26,1,"かな"]],"text":"わたしは、みずから不義を言いあらわし、わが罪のために悲しみます。"},{"ref":"Ps.38.19","start":19038019,"end":19038019,"break":"line","breaks":[[17,"line"]],"ruby":[[9,1,"てき"],[12,1,"もの"],[14,1,"つよ"],[17,1,"いつわ"],[24,1,"にく"],[26,1,"もの"],[28,1,"おお"]],"text":"ゆえなく、わたしに敵する者は強く、偽ってわたしを憎む者は多いのです。"},{"ref":"Ps.38.20","start":19038020,"end":19038020,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"あく"],[5,1,"ぜん"],[7,1,"むく"],[10,1,"もの"],[19,1,"こと"],[21,1,"したが"]],"text":"悪をもって善に報いる者は、わたしがよい事に従うがゆえに、わがあだとなります。"},{"ref":"Ps.38.21","start":19038021,"end":19038021,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"す"],[19,1,"かみ"],[26,1,"とお"]],"text":"主よ、わたしを捨てないでください。わが神よ、わたしに遠ざからないでください。"},{"ref":"Ps.38.22","start":19038022,"end":19038022,"break":"line","breaks":[[7,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"すくい"],[17,1,"たす"]],"text":"主、わが救よ、すみやかにわたしをお助けください。"}]