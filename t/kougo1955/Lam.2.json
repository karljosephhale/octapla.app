[{"ref":"Lam.2.1","start":25002001,"end":25002001,"break":"paragraph","breaks":[[11,"line"],[29,"line"],[50,"line"],[58,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"いか"],[8,1,"おこ"],[11,2,"くろくも"],[21,1,"むすめ"],[29,1,"しゅ"],[37,2,"えいこう"],[40,1,"てん"],[43,1,"ち"],[45,1,"な"],[47,1,"おと"],[52,1,"いか"],[55,1,"ひ"],[62,1,"あし"],[63,1,"だい"],[65,1,"こころ"]],"text":"ああ、主は怒りを起し、黒雲をもってシオンの娘をおおわれた。主はイスラエルの栄光を天から地に投げ落し、その怒りの日に、おのれの足台を心にとめられなかった。"},{"ref":"Lam.2.2","start":25002002,"end":25002002,"break":"line","breaks":[[14,"line"],[25,"line"],[47,"line"],[56,"line"]],"ruby":[[0,1,"しゅ"],[14,1,"ほろ"],[27,1,"いか"],[37,1,"むすめ"],[50,1,"ち"],[52,1,"たお"],[58,1,"くに"]],"text":"主はヤコブのすべてのすまいを滅ぼして、あわれまず、その怒りによって、ユダの娘のとりでをこわし、これを地に倒して、その国とそのつかさたちをはずかしめられた。"},{"ref":"Lam.2.3","start":25002003,"end":25002003,"break":"line","breaks":[[12,"line"],[27,"line"],[46,"line"],[63,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"はげ"],[5,1,"いか"],[22,1,"ちから"],[24,1,"た"],[27,1,"てき"],[29,1,"まえ"],[36,1,"みぎ"],[38,1,"て"],[40,1,"ひ"],[46,2,"しゅうい"],[49,1,"や"],[54,1,"も"],[57,1,"ひ"],[67,1,"や"]],"text":"主は激しい怒りをもって、イスラエルのすべての力を断ち、敵の前で、おのれの右の手を引きもどし、周囲を焼きつくす燃える火のように、ヤコブを焼かれた。"},{"ref":"Lam.2.4","start":25002004,"end":25002004,"break":"line","breaks":[[12,"line"],[28,"line"],[51,"line"],[59,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"てき"],[7,1,"ゆみ"],[9,1,"は"],[18,1,"みぎ"],[20,1,"て"],[22,1,"の"],[25,1,"た"],[32,1,"むすめ"],[34,2,"てんまく"],[44,1,"め"],[46,1,"ほこ"],[48,1,"もの"],[56,1,"ころ"],[59,1,"ひ"],[66,1,"いか"],[69,1,"そそ"]],"text":"主は敵のように弓を張り、あだのように右の手を伸べて立ち、シオンの娘の天幕におるわれわれの目に誇る者を、ことごとく殺し、火のようにその怒りを注がれた。"},{"ref":"Lam.2.5","start":25002005,"end":25002005,"break":"line","breaks":[[21,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"てき"],[17,1,"ほろ"],[27,2,"きゅうでん"],[30,1,"ほろ"],[47,1,"むすめ"],[49,1,"うえ"],[51,1,"うれ"],[54,1,"かな"],[59,1,"ま"],[61,1,"くわ"]],"text":"主は敵のようになって、イスラエルを滅ぼし、そのすべての宮殿を滅ぼし、そのとりでをこわし、ユダの娘の上に憂いと悲しみとを増し加えられた。"},{"ref":"Lam.2.6","start":25002006,"end":25002006,"break":"line","breaks":[[20,"line"],[33,"line"],[51,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"その"],[4,2,"こや"],[14,2,"まくや"],[17,1,"たお"],[22,1,"まつり"],[24,2,"ばしょ"],[33,1,"しゅ"],[35,1,"まつり"],[37,3,"あんそくにち"],[46,1,"わす"],[51,1,"はげ"],[54,1,"いか"],[61,1,"おう"],[63,2,"さいし"],[67,1,"す"]],"text":"主は園の小屋のようにおのれの幕屋を倒し、その祭の場所をこわされた。主は祭と安息日とをシオンに忘れさせ、激しい怒りによって、王と祭司とを捨てられた。"},{"ref":"Lam.2.7","start":25002007,"end":25002007,"break":"line","breaks":[[20,"line"],[41,"line"]],"ruby":[[0,1,"しゅ"],[4,2,"さいだん"],[7,1,"い"],[12,2,"せいじょ"],[25,2,"きゅうでん"],[28,1,"いし"],[32,1,"てき"],[34,1,"て"],[36,1,"わた"],[41,1,"かれ"],[44,1,"まつり"],[46,1,"ひ"],[52,1,"しゅ"],[54,1,"みや"],[56,1,"こえ"]],"text":"主はその祭壇を忌み、その聖所をきらって、もろもろの宮殿の石がきを敵の手に渡された。彼らは祭の日のように、主の宮で声をあげた。"},{"ref":"Lam.2.8","start":25002008,"end":25002008,"break":"line","breaks":[[17,"line"],[29,"line"],[44,"line"],[60,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"むすめ"],[8,2,"じょうへき"],[11,2,"はかい"],[17,1,"おも"],[19,1,"さだ"],[26,1,"は"],[29,1,"う"],[38,1,"て"],[44,2,"じょうへき"],[47,1,"いし"],[52,1,"かな"],[64,1,"とも"],[66,1,"おとろ"]],"text":"主はシオンの娘の城壁を破壊しようと思い定めて、なわを張り、打ちこわして、その手をひかず、城壁と石がきとを悲しませられた。これらは共に衰える。"},{"ref":"Lam.2.9","start":25002009,"end":25002009,"break":"line","breaks":[[11,"line"],[27,"line"],[48,"line"],[57,"line"]],"ruby":[[2,1,"もん"],[4,1,"ち"],[11,1,"しゅ"],[15,1,"かん"],[17,1,"き"],[22,1,"くだ"],[29,1,"おう"],[31,1,"きみ"],[40,2,"くにたみ"],[43,1,"なか"],[51,2,"りっぽう"],[61,3,"よげんしゃ"],[65,1,"しゅ"],[68,1,"まぼろし"],[70,1,"え"]],"text":"その門は地にうずもれ、主はその貫の木をこわし砕かれた。その王と君たちはもろもろの国民の中におり、もはや律法はなく、またその預言者は主から幻を得ない。"},{"ref":"Lam.2.10","start":25002010,"end":25002010,"break":"line","breaks":[[19,"line"],[38,"line"]],"ruby":[[4,1,"むすめ"],[6,2,"ちょうろう"],[11,1,"ち"],[13,1,"ざ"],[16,1,"もく"],[19,1,"あたま"],[28,1,"み"],[30,2,"あらぬの"],[54,1,"ち"]],"text":"シオンの娘の長老たちは地に座して黙し、頭にちりをかぶり、身に荒布をまとった。エルサレムのおとめたちはこうべを地にたれた。"},{"ref":"Lam.2.11","start":25002011,"end":25002011,"break":"line","breaks":[[13,"line"],[26,"line"],[43,"line"],[52,"line"],[67,"line"]],"ruby":[[2,1,"め"],[4,1,"なみだ"],[28,1,"きも"],[32,1,"たみ"],[34,1,"むすめ"],[36,1,"ほろ"],[43,1,"ち"],[45,1,"そそ"],[47,1,"だ"],[52,1,"おさ"],[54,1,"こ"],[56,1,"ち"],[59,1,"ご"],[61,1,"まち"],[67,1,"いき"],[69,1,"た"]],"text":"わが目は涙のためにつぶれ、わがはらわたはわきかえり、わが肝はわが民の娘の滅びのために、地に注ぎ出される。幼な子や乳のみ子が町のちまたに息も絶えようとしているからである。"},{"ref":"Lam.2.12","start":25002012,"end":25002012,"break":"line","breaks":[[19,"line"],[31,"line"],[55,"line"],[72,"line"]],"ruby":[[0,1,"かれ"],[4,1,"きず"],[8,1,"もの"],[13,1,"まち"],[19,1,"いき"],[21,1,"た"],[33,1,"はは"],[42,1,"いのち"],[44,1,"そそ"],[46,1,"だ"],[55,1,"はは"],[69,1,"しゅ"],[82,1,"さけ"]],"text":"彼らが、傷ついた者のように町のちまたで息も絶えようとするとき、その母のふところにその命を注ぎ出そうとするとき、母にむかって、「パンとぶどう酒とはどこにありますか」と叫ぶ。"},{"ref":"Lam.2.13","start":25002013,"end":25002013,"break":"line","breaks":[[22,"line"],[40,"line"],[52,"line"],[71,"line"],[87,"line"],[103,"line"]],"ruby":[[6,1,"むすめ"],[13,1,"なに"],[19,1,"い"],[22,1,"なに"],[28,1,"くら"],[44,1,"むすめ"],[56,1,"なに"],[75,1,"なぐさ"],[91,1,"やぶ"],[94,1,"うみ"],[99,1,"おお"]],"text":"エルサレムの娘よ、わたしは何をあなたに言い、何にあなたを比べることができようか。シオンの娘なるおとめよ、わたしは何をもってあなたになぞらえて、あなたを慰めることができようか。あなたの破れは海のように大きい、だれがあなたをいやすことができようか。"},{"ref":"Lam.2.14","start":25002014,"end":25002014,"break":"line","breaks":[[17,"line"],[29,"line"],[44,"line"],[59,"line"]],"ruby":[[4,3,"よげんしゃ"],[17,1,"ひと"],[19,1,"あざむ"],[21,1,"いつわ"],[24,1,"まぼろし"],[26,1,"み"],[29,1,"かれ"],[36,2,"ふぎ"],[44,1,"とら"],[48,1,"まぬか"],[66,1,"ひと"],[68,1,"まよ"],[71,1,"いつわ"],[74,2,"たくせん"],[77,1,"み"]],"text":"あなたの預言者たちはあなたのために人を欺く偽りの幻を見た。彼らはあなたの不義をあらわして捕われを免れさせようとはせず、あなたのために人を迷わす偽りの託宣を見た。"},{"ref":"Lam.2.15","start":25002015,"end":25002015,"break":"line","breaks":[[22,"line"],[40,"line"],[50,"line"],[65,"line"]],"ruby":[[3,2,"みちゆ"],[6,1,"ひと"],[17,1,"て"],[19,1,"う"],[28,1,"むすめ"],[37,1,"わら"],[42,1,"あたま"],[44,1,"ふ"],[47,1,"い"],[51,1,"うるわ"],[59,1,"ぜん"],[60,1,"ち"],[62,1,"よろこ"],[71,1,"まち"]],"text":"すべて道行く人は、あなたにむかって手を打ち、エルサレムの娘にむかって、あざ笑い、かつ頭を振って言う、「麗しさのきわみ、全地の喜びととなえられた町はこれなのか」と。"},{"ref":"Lam.2.16","start":25002016,"end":25002016,"break":"line","breaks":[[21,"line"],[34,"line"],[48,"line"],[65,"line"]],"ruby":[[9,1,"てき"],[23,1,"わら"],[26,1,"は"],[31,1,"い"],[43,1,"ほろ"],[59,1,"のぞ"],[62,1,"ひ"],[65,1,"いま"],[80,1,"み"]],"text":"あなたのもろもろの敵は、あなたをののしり、あざ笑い、歯がみして言う、「われわれはこれを滅ぼした、ああ、これはわれわれが望んだ日だ、今われわれはこれにあい、これを見た」と。"},{"ref":"Lam.2.17","start":25002017,"end":25002017,"break":"line","breaks":[[15,"line"],[28,"line"],[45,"line"],[60,"line"],[73,"line"]],"ruby":[[0,1,"しゅ"],[4,2,"けいかく"],[12,1,"おこな"],[15,2,"けいこく"],[25,1,"と"],[34,1,"めい"],[45,1,"ほろ"],[67,1,"てき"],[69,1,"よろこ"],[80,1,"ちから"],[82,1,"たか"]],"text":"主はその計画されたことを行い、警告されたことをなし遂げ、いにしえから命じておかれたように、滅ぼして、あわれむことをせず、あなたについて敵を喜ばせ、あなたのあだの力を高められた。"},{"ref":"Lam.2.18","start":25002018,"end":25002018,"break":"line","breaks":[[19,"line"],[33,"line"],[47,"line"]],"ruby":[[4,1,"むすめ"],[7,1,"こえ"],[8,1,"たか"],[12,1,"しゅ"],[14,1,"よ"],[19,1,"よる"],[21,1,"ひる"],[23,1,"かわ"],[28,1,"なみだ"],[30,1,"なが"],[37,1,"やす"],[55,1,"やす"]],"text":"シオンの娘よ、声高らかに主に呼ばわれ、夜も昼も川のように涙を流せ。みずから安んじることをせず、あなたのひとみを休ませるな。"},{"ref":"Lam.2.19","start":25002019,"end":25002019,"break":"line","breaks":[[11,"line"],[31,"line"],[40,"line"],[59,"line"]],"ruby":[[0,1,"よる"],[2,2,"しょこう"],[5,1,"お"],[8,1,"さけ"],[11,1,"しゅ"],[13,1,"まえ"],[19,1,"こころ"],[21,1,"みず"],[26,1,"そそ"],[28,1,"だ"],[31,1,"まち"],[37,1,"う"],[40,1,"いき"],[42,1,"た"],[49,1,"おさ"],[51,1,"こ"],[53,1,"いのち"],[59,1,"しゅ"],[65,2,"りょうて"]],"text":"夜、初更に起きて叫べ。主の前にあなたの心を水のように注ぎ出せ。町のかどで、飢えて息も絶えようとする幼な子の命のために、主にむかって両手をあげよ。"},{"ref":"Lam.2.20","start":25002020,"end":25002020,"break":"line","breaks":[[18,"line"],[29,"line"],[43,"line"],[53,"line"],[74,"line"]],"ruby":[[0,1,"しゅ"],[10,1,"かえり"],[34,1,"おこな"],[43,1,"おんな"],[45,2,"じぶん"],[48,1,"う"],[51,1,"こ"],[55,2,"だいじ"],[58,1,"そだ"],[61,1,"おさ"],[63,1,"ご"],[65,1,"た"],[74,2,"さいし"],[77,3,"よげんしゃ"],[81,1,"しゅ"],[83,2,"せいじょ"],[86,1,"ころ"]],"text":"主よ、みそなわして、顧みてください。あなたはだれにむかってこのように行われたのですか。女は自分の産んだ子、その大事に育てた幼な子を食べるでしょうか。祭司と預言者が主の聖所で殺されていいでしょうか。"},{"ref":"Lam.2.21","start":25002021,"end":25002021,"break":"line","breaks":[[17,"line"],[28,"line"],[41,"line"],[59,"line"]],"ruby":[[0,1,"お"],[3,1,"わか"],[14,1,"ふ"],[24,2,"わこうど"],[32,1,"たお"],[48,1,"いか"],[51,1,"ひ"],[56,1,"ころ"]],"text":"老いも若きも、ちまたのちりに伏し、わがおとめも、若人も、つるぎで倒されてしまった。あなたは、その怒りの日にこれを殺し、これをほふって、あわれむことをされなかった。"},{"ref":"Lam.2.22","start":25002022,"end":25002022,"break":"line","breaks":[[16,"line"],[35,"line"],[44,"line"],[60,"line"],[73,"line"]],"ruby":[[9,1,"おそ"],[16,1,"まつり"],[18,1,"ひ"],[23,2,"しほう"],[27,1,"よ"],[29,1,"あつ"],[35,1,"しゅ"],[37,1,"いか"],[40,1,"ひ"],[48,1,"もの"],[50,1,"のこ"],[53,1,"もの"],[68,1,"そだ"],[71,1,"もの"],[77,1,"てき"],[79,1,"ほろ"],[82,1,"つく"]],"text":"あなたは、わたしの恐れるものを、祭の日のように四方から呼び集められた。主の怒りの日には、のがれた者も残った者もなかった。わたしが、いだき育てた者をわたしの敵は滅ぼし尽した。"}]