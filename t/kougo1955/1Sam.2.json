[{"ref":"1Sam.2.1","start":9002001,"end":9002001,"break":"paragraph","breaks":[[11,"stanza"],[26,"line"],[43,"line"],[56,"line"]],"ruby":[[4,1,"いの"],[7,1,"い"],[16,1,"こころ"],[18,1,"しゅ"],[23,1,"よろこ"],[30,1,"ちから"],[32,1,"しゅ"],[37,1,"つよ"],[47,1,"くち"],[49,1,"てき"],[53,1,"わら"],[60,1,"すくい"],[69,1,"たの"]],"text":"ハンナは祈って言った、「わたしの心は主によって喜び、わたしの力は主によって強められた、わたしの口は敵をあざ笑う、あなたの救によってわたしは楽しむからである。"},{"ref":"1Sam.2.2","start":9002002,"end":9002002,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"せい"],[34,1,"かみ"],[39,1,"いわ"]],"text":"主のように聖なるものはない、あなたのほかには、だれもない、われわれの神のような岩はない。"},{"ref":"1Sam.2.3","start":9002003,"end":9002003,"break":"line","breaks":[[21,"line"],[40,"line"],[54,"line"]],"ruby":[[6,1,"かさ"],[9,2,"こうまん"],[12,1,"かた"],[26,2,"ことば"],[29,1,"くち"],[40,1,"しゅ"],[46,1,"し"],[48,1,"かみ"],[64,1,"しゅ"],[69,1,"はか"]],"text":"あなたがたは重ねて高慢に語ってはならない、たかぶりの言葉を口にすることをやめよ。主はすべてを知る神であって、もろもろのおこないは主によって量られる。"},{"ref":"1Sam.2.4","start":9002004,"end":9002004,"break":"line","breaks":[[8,"line"]],"ruby":[[0,2,"ゆうし"],[3,1,"ゆみ"],[5,1,"お"],[8,1,"よわ"],[10,1,"もの"],[12,1,"ちから"],[14,1,"お"]],"text":"勇士の弓は折れ、弱き者は力を帯びる。"},{"ref":"1Sam.2.5","start":9002005,"end":9002005,"break":"line","breaks":[[16,"line"],[35,"line"],[48,"line"]],"ruby":[[0,1,"あ"],[2,1,"た"],[5,1,"もの"],[7,1,"しょく"],[12,1,"やと"],[16,1,"う"],[26,1,"う"],[41,1,"にん"],[43,1,"こ"],[45,1,"う"],[48,1,"おお"],[51,1,"こ"],[55,1,"おんな"],[57,2,"こどく"]],"text":"飽き足りた者は食のために雇われ、飢えたものは、もはや飢えることがない。うまずめは七人の子を産み、多くの子をもつ女は孤独となる。"},{"ref":"1Sam.2.6","start":9002006,"end":9002006,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ころ"],[7,1,"い"],[11,2,"よみ"],[20,1,"うえ"]],"text":"主は殺し、また生かし、陰府にくだし、また上げられる。"},{"ref":"1Sam.2.7","start":9002007,"end":9002007,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"まず"],[9,1,"と"],[13,1,"ひく"],[19,1,"たか"]],"text":"主は貧しくし、また富ませ、低くし、また高くされる。"},{"ref":"1Sam.2.8","start":9002008,"end":9002008,"break":"line","breaks":[[20,"line"],[40,"line"],[50,"line"],[62,"line"],[75,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[13,1,"た"],[20,1,"とぼ"],[23,1,"もの"],[34,1,"ひ"],[36,1,"あ"],[40,2,"おうこう"],[43,1,"とも"],[50,2,"えいよ"],[53,1,"くらい"],[55,1,"つ"],[62,1,"ち"],[64,1,"はしら"],[66,1,"しゅ"],[77,1,"はしら"],[79,1,"うえ"],[82,2,"せかい"]],"text":"貧しい者を、ちりのなかから立ちあがらせ、乏しい者を、あくたのなかから引き上げて、王侯と共にすわらせ、栄誉の位を継がせられる。地の柱は主のものであって、その柱の上に、世界をすえられたからである。"},{"ref":"1Sam.2.9","start":9002009,"end":9002009,"break":"line","breaks":[[16,"line"],[36,"line"]],"ruby":[[0,1,"しゅ"],[4,2,"せいと"],[9,1,"あし"],[11,1,"まも"],[19,1,"わる"],[26,2,"あんこく"],[32,1,"ほろ"],[36,1,"ひと"],[38,1,"ちから"],[43,1,"か"]],"text":"主はその聖徒たちの足を守られる、しかし悪いものどもは暗黒のうちに滅びる。人は力をもって勝つことができないからである。"},{"ref":"1Sam.2.10","start":9002010,"end":9002010,"break":"line","breaks":[[19,"line"],[39,"line"],[57,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"あらそ"],[7,2,"こなごな"],[10,1,"くだ"],[19,1,"しゅ"],[21,1,"かれ"],[28,1,"てん"],[31,1,"かみなり"],[39,1,"ち"],[50,1,"おう"],[52,1,"ちから"],[54,1,"あた"],[57,1,"あぶら"],[63,1,"もの"],[65,1,"ちから"],[67,1,"つよ"]],"text":"主と争うものは粉々に砕かれるであろう、主は彼らにむかって天から雷をとどろかし、地のはてまでもさばき、王に力を与え、油そそがれた者の力を強くされるであろう」。"},{"ref":"1Sam.2.11","start":9002011,"end":9002011,"break":"paragraph","ruby":[[10,1,"いえ"],[12,1,"かえ"],[17,1,"おさ"],[19,1,"こ"],[21,2,"さいし"],[26,1,"まえ"],[30,1,"しゅ"],[32,1,"つか"]],"text":"エルカナはラマにある家に帰ったが、幼な子は祭司エリの前にいて主に仕えた。"},{"ref":"1Sam.2.12","start":9002012,"end":9002012,"break":"paragraph","ruby":[[6,1,"こ"],[15,2,"ひとびと"],[19,1,"しゅ"],[21,1,"おそ"]],"text":"さて、エリの子らは、よこしまな人々で、主を恐れなかった。"},{"ref":"1Sam.2.13","start":9002013,"end":9002013,"break":"none","ruby":[[0,1,"たみ"],[5,1,"もの"],[11,2,"さいし"],[25,1,"ひと"],[27,2,"ぎせい"],[34,1,"とき"],[38,1,"にく"],[40,1,"に"],[42,1,"あいだ"],[45,2,"さいし"],[58,1,"にく"],[59,1,"さ"],[62,1,"て"],[64,1,"も"]],"text":"民のささげ物についての祭司のならわしはこうである。人が犠牲をささげる時、その肉を煮る間に、祭司のしもべは、みつまたの肉刺しを手に持ってきて、"},{"ref":"1Sam.2.14","start":9002014,"end":9002014,"break":"none","ruby":[[23,1,"はち"],[25,1,"つ"],[30,1,"にく"],[31,1,"さ"],[34,1,"ひ"],[36,1,"あ"],[42,2,"さいし"],[47,2,"じぶん"],[56,1,"かれ"],[66,1,"く"],[78,1,"ひと"]],"text":"それをかま、またはなべ、またはおおがま、または鉢に突きいれ、肉刺しの引き上げるものは祭司がみな自分のものとした。彼らはシロで、そこに来るすべてのイスラエルの人に、このようにした。"},{"ref":"1Sam.2.15","start":9002015,"end":9002015,"break":"none","ruby":[[0,2,"ひとびと"],[3,2,"しぼう"],[6,1,"や"],[8,1,"まえ"],[14,2,"さいし"],[24,2,"ぎせい"],[31,1,"ひと"],[33,1,"い"],[42,2,"さいし"],[48,1,"や"],[50,1,"にく"],[52,1,"あた"],[56,2,"さいし"],[64,1,"に"],[66,1,"にく"],[68,1,"う"],[73,1,"なま"],[75,1,"にく"]],"text":"人々が脂肪を焼く前にもまた、祭司のしもべがきて、犠牲をささげる人に言うのであった、「祭司のために焼く肉を与えよ。祭司はあなたから煮た肉を受けない。生の肉がよい」。"},{"ref":"1Sam.2.16","start":9002016,"end":9002016,"break":"none","ruby":[[2,1,"ひと"],[8,2,"しぼう"],[11,1,"や"],[21,1,"のち"],[27,1,"と"],[36,1,"い"],[49,1,"いま"],[67,1,"ちから"],[75,1,"と"],[80,1,"い"]],"text":"その人が、「まず脂肪を焼かせましょう。その後ほしいだけ取ってください」と言うと、しもべは、「いや、今もらいたい。くれないなら、わたしは力づくで、それを取ろう」と言う。"},{"ref":"1Sam.2.17","start":9002017,"end":9002017,"break":"none","ruby":[[8,2,"わかもの"],[13,1,"つみ"],[16,1,"しゅ"],[18,1,"まえ"],[20,2,"ひじょう"],[23,1,"おお"],[31,2,"ひとびと"],[34,1,"しゅ"],[36,1,"そな"],[38,1,"もの"],[40,1,"かろ"]],"text":"このように、その若者たちの罪は、主の前に非常に大きかった。この人々が主の供え物を軽んじたからである。"},{"ref":"1Sam.2.18","start":9002018,"end":9002018,"break":"paragraph","ruby":[[7,1,"おさな"],[10,1,"み"],[12,2,"あま"],[14,1,"ぬの"],[20,1,"つ"],[24,1,"しゅ"],[26,1,"まえ"],[28,1,"つか"]],"text":"サムエルはまだ幼く、身に亜麻布のエポデを着けて、主の前に仕えていた。"},{"ref":"1Sam.2.19","start":9002019,"end":9002019,"break":"none","ruby":[[0,1,"はは"],[2,1,"かれ"],[7,1,"ちい"],[10,2,"うわぎ"],[13,1,"つく"],[16,1,"とし"],[21,1,"おっと"],[23,1,"とも"],[27,1,"とし"],[29,2,"ぎせい"],[39,1,"のぼ"],[41,1,"とき"],[46,1,"も"]],"text":"母は彼のために小さい上着を作り、年ごとに、夫と共にその年の犠牲をささげるために上る時、それを持ってきた。"},{"ref":"1Sam.2.20","start":9002020,"end":9002020,"break":"none","ruby":[[13,1,"つま"],[15,2,"しゅくふく"],[19,1,"い"],[26,1,"おんな"],[28,1,"しゅ"],[34,1,"もの"],[41,1,"しゅ"],[45,1,"おんな"],[54,1,"こ"],[56,1,"あた"],[69,1,"かれ"],[74,1,"いえ"],[76,1,"かえ"],[80,1,"つね"]],"text":"エリはいつもエルカナとその妻を祝福して言った、「この女が主にささげた者のかわりに、主がこの女によってあなたに子を与えられるように」。そして彼らはその家に帰るのを常とした。"},{"ref":"1Sam.2.21","start":9002021,"end":9002021,"break":"paragraph","ruby":[[4,1,"しゅ"],[10,1,"かえり"],[29,1,"にん"],[31,1,"おとこ"],[33,1,"こ"],[39,1,"おんな"],[41,1,"こ"],[43,1,"う"],[55,1,"しゅ"],[57,1,"まえ"],[59,1,"そだ"]],"text":"こうして主がハンナを顧みられたので、ハンナはみごもって、三人の男の子とふたりの女の子を産んだ。わらべサムエルは主の前で育った。"},{"ref":"1Sam.2.22","start":9002022,"end":9002022,"break":"paragraph","ruby":[[8,1,"とし"],[19,1,"こ"],[28,2,"ひとびと"],[41,1,"き"],[46,2,"かいけん"],[49,2,"まくや"],[52,2,"いりぐち"],[55,1,"つと"],[60,1,"おんな"],[64,1,"ね"],[69,1,"き"]],"text":"エリはひじょうに年をとった。そしてその子らがイスラエルの人々にしたいろいろのことを聞き、また会見の幕屋の入口で勤めていた女たちと寝たことを聞いて、"},{"ref":"1Sam.2.23","start":9002023,"end":9002023,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[36,1,"たみ"],[46,1,"わる"],[56,1,"き"]],"text":"彼らに言った、「なにゆえ、そのようなことをするのか。わたしはこのすべての民から、あなたがたの悪いおこないのことを聞く。"},{"ref":"1Sam.2.24","start":9002024,"end":9002024,"break":"none","ruby":[[2,1,"こ"],[18,1,"き"],[21,1,"しゅ"],[23,1,"たみ"],[25,1,"い"],[33,2,"ふうせつ"],[36,1,"よ"]],"text":"わが子らよ、それはいけない。わたしの聞く、主の民の言いふらしている風説は良くない。"},{"ref":"1Sam.2.25","start":9002025,"end":9002025,"break":"none","ruby":[[2,1,"ひと"],[4,1,"ひと"],[6,1,"たい"],[9,1,"つみ"],[11,1,"おか"],[17,1,"かみ"],[19,2,"ちゅうさい"],[32,1,"ひと"],[34,1,"しゅ"],[36,1,"たい"],[39,1,"つみ"],[41,1,"おか"],[73,1,"かれ"],[76,1,"ちち"],[78,1,"い"],[83,1,"みみ"],[85,1,"かたむ"],[97,1,"しゅ"],[99,1,"かれ"],[102,1,"ころ"]],"text":"もし人が人に対して罪を犯すならば、神が仲裁されるであろう。しかし人が主に対して罪を犯すならば、だれが、そのとりなしをすることができようか」。しかし彼らは父の言うことに耳を傾けようともしなかった。主が彼らを殺そうとされたからである。"},{"ref":"1Sam.2.26","start":9002026,"end":9002026,"break":"paragraph","ruby":[[8,1,"そだ"],[14,1,"しゅ"],[18,2,"ひとびと"],[27,1,"あい"]],"text":"わらべサムエルは育っていき、主にも、人々にも、ますます愛せられた。"},{"ref":"1Sam.2.27","start":9002027,"end":9002027,"break":"paragraph","ruby":[[9,1,"かみ"],[11,1,"ひと"],[22,1,"い"],[27,1,"しゅ"],[31,1,"おお"],[42,2,"せんぞ"],[45,1,"いえ"],[55,1,"いえ"],[57,2,"どれい"],[72,2,"せんぞ"],[75,1,"いえ"],[77,1,"みずか"],[80,1,"あらわ"]],"text":"このとき、ひとりの神の人が、エリのもとにきて言った、「主はかく仰せられる、『あなたの先祖の家がエジプトでパロの家の奴隷であったとき、わたしはその先祖の家に自らを現した。"},{"ref":"1Sam.2.28","start":9002028,"end":9002028,"break":"none","ruby":[[13,2,"ぶぞく"],[23,1,"えら"],[25,1,"だ"],[33,2,"さいし"],[42,2,"さいだん"],[45,1,"のぼ"],[49,1,"こう"],[59,1,"まえ"],[65,1,"つ"],[79,2,"ひとびと"],[82,2,"かさい"],[94,2,"せんぞ"],[97,1,"いえ"],[99,1,"あた"]],"text":"そしてイスラエルのすべての部族のうちからそれを選び出して、わたしの祭司とし、わたしの祭壇に上って、香をたかせ、わたしの前でエポデを着けさせ、また、イスラエルの人々の火祭をことごとくあなたの先祖の家に与えた。"},{"ref":"1Sam.2.29","start":9002029,"end":9002029,"break":"none","ruby":[[18,1,"めい"],[21,2,"ぎせい"],[24,1,"そな"],[26,1,"もの"],[33,1,"め"],[38,1,"み"],[56,2,"じぶん"],[59,1,"こ"],[62,1,"たっと"],[69,1,"たみ"],[85,1,"そな"],[87,1,"もの"],[90,1,"もっと"],[92,1,"よ"],[94,2,"ぶぶん"],[100,2,"じぶん"],[103,1,"こ"]],"text":"それにどうしてあなたがたは、わたしが命じた犠牲と供え物をむさぼりの目をもって見るのか。またなにゆえ、わたしよりも自分の子らを尊び、わたしの民イスラエルのささげるもろもろの供え物の、最も良き部分をもって自分を肥やすのか』。"},{"ref":"1Sam.2.30","start":9002030,"end":9002030,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[14,1,"おお"],[34,1,"いえ"],[40,1,"ちち"],[42,1,"いえ"],[46,2,"えいきゅう"],[53,1,"まえ"],[55,1,"あゆ"],[63,1,"い"],[71,1,"いま"],[73,1,"しゅ"],[75,1,"おお"],[82,1,"けっ"],[96,1,"たっと"],[98,1,"もの"],[105,1,"たっと"],[112,1,"いや"],[116,1,"もの"],[119,1,"かろ"]],"text":"それゆえイスラエルの神、主は仰せられる、『わたしはかつて、「あなたの家とあなたの父の家とは、永久にわたしの前に歩むであろう」と言った』。しかし今、主は仰せられる、『決してそうはしない。わたしを尊ぶ者を、わたしは尊び、わたしを卑しめる者は、軽んぜられるであろう。"},{"ref":"1Sam.2.31","start":9002031,"end":9002031,"break":"none","ruby":[[0,1,"み"],[3,1,"ひ"],[5,1,"く"],[14,1,"ひ"],[24,1,"ちから"],[31,1,"ちち"],[33,1,"いえ"],[35,1,"ちから"],[37,1,"た"],[44,1,"いえ"],[46,2,"としお"],[50,1,"もの"]],"text":"見よ、日が来るであろう。その日、わたしはあなたの力と、あなたの父の家の力を断ち、あなたの家に年老いた者をなくするであろう。"},{"ref":"1Sam.2.32","start":9002032,"end":9002032,"break":"none","ruby":[[9,1,"わざわい"],[24,1,"あた"],[34,2,"はんえい"],[41,1,"み"],[52,1,"いえ"],[55,2,"えいきゅう"],[58,2,"としお"],[62,1,"もの"]],"text":"そのとき、あなたは災のうちにあって、イスラエルに与えられるもろもろの繁栄を、ねたみ見るであろう。あなたの家には永久に年老いた者がいなくなるであろう。"},{"ref":"1Sam.2.33","start":9002033,"end":9002033,"break":"none","ruby":[[7,2,"いちぞく"],[19,2,"さいだん"],[23,1,"た"],[32,1,"かれ"],[34,1,"のこ"],[40,1,"め"],[42,1,"な"],[48,1,"こころ"],[50,1,"いた"],[64,1,"いえ"],[66,1,"うま"],[68,1,"で"],[80,1,"し"]],"text":"しかしあなたの一族のひとりを、わたしの祭壇から断たないであろう。彼は残されてその目を泣きはらし、心を痛めるであろう。またあなたの家に生れ出るものは、みなつるぎに死ぬであろう。"},{"ref":"1Sam.2.34","start":9002034,"end":9002034,"break":"none","ruby":[[8,1,"こ"],[18,1,"み"],[20,1,"おこ"],[56,1,"とも"],[58,1,"おな"],[60,1,"ひ"],[62,1,"し"]],"text":"あなたのふたりの子ホフニとピネハスの身に起ることが、あなたのためにそのしるしとなるであろう。すなわちそのふたりは共に同じ日に死ぬであろう。"},{"ref":"1Sam.2.35","start":9002035,"end":9002035,"break":"none","ruby":[[4,2,"じぶん"],[15,2,"ちゅうじつ"],[18,2,"さいし"],[21,1,"おこ"],[26,1,"ひと"],[32,1,"こころ"],[34,1,"おも"],[38,1,"したが"],[41,1,"おこな"],[54,1,"いえ"],[56,2,"かくりつ"],[64,1,"ひと"],[70,1,"あぶら"],[75,1,"もの"],[77,1,"まえ"],[82,1,"あゆ"]],"text":"わたしは自分のために、ひとりの忠実な祭司を起す。その人はわたしの心と思いとに従って行うであろう。わたしはその家を確立しよう。その人はわたしが油そそいだ者の前につねに歩むであろう。"},{"ref":"1Sam.2.36","start":9002036,"end":9002036,"break":"none","ruby":[[7,1,"いえ"],[9,1,"い"],[11,1,"のこ"],[16,2,"ひとびと"],[24,1,"かれ"],[27,1,"まい"],[29,1,"ぎん"],[32,1,"こ"],[37,1,"こ"],[39,1,"もと"],[51,2,"さいし"],[54,1,"しょく"],[59,1,"にん"],[62,2,"ひとくち"],[69,1,"た"],[89,1,"い"]],"text":"そしてあなたの家で生き残っている人々はみなきて、彼に一枚の銀と一個のパンを請い求め、「どうぞ、わたしを祭司の職の一つに任じ、一口のパンでも食べることができるようにしてください」と言うであろう』」。"}]