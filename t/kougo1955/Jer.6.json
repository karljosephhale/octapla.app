[{"ref":"Jer.6.1","start":24006001,"end":24006001,"break":"paragraph","breaks":[[10,"line"],[24,"line"],[35,"line"],[51,"line"]],"ruby":[[6,2,"ひとびと"],[16,1,"なか"],[19,2,"ひなん"],[32,1,"ふ"],[42,2,"あいず"],[45,1,"ひ"],[51,1,"きた"],[54,1,"わざわい"],[56,1,"のぞ"],[59,1,"おお"],[63,1,"ほろ"],[66,1,"く"]],"text":"ベニヤミンの人々よ、エルサレムの中から避難せよ。テコアでラッパを吹き、ベテハケレムに合図の火をあげよ。北から災が臨み、大いなる滅びが来るからである。"},{"ref":"Jer.6.2","start":24006002,"end":24006002,"break":"line","ruby":[[4,1,"うつく"],[17,1,"むすめ"],[19,1,"ほろ"]],"text":"わたしは美しい、たおやかなシオンの娘を滅ぼす。"},{"ref":"Jer.6.3","start":24006003,"end":24006003,"break":"line","breaks":[[18,"line"],[36,"line"]],"ruby":[[0,2,"ぼくしゃ"],[8,1,"む"],[15,1,"き"],[18,2,"かのじょ"],[21,1,"せ"],[24,2,"かのじょ"],[27,2,"しゅうい"],[30,2,"てんまく"],[33,1,"は"],[36,1,"む"],[45,1,"ところ"],[47,1,"くさ"],[49,1,"く"]],"text":"牧者たちは、その群れをひきいて来て、彼女を攻め、彼女の周囲に天幕を張る。群れはおのおのその所で草を食う。"},{"ref":"Jer.6.4","start":24006004,"end":24006004,"break":"line","breaks":[[14,"line"],[32,"line"],[49,"line"]],"ruby":[[1,1,"たたか"],[4,1,"はじ"],[7,2,"かのじょ"],[10,1,"せ"],[14,1,"た"],[22,2,"まひる"],[25,2,"こうげき"],[42,1,"ひ"],[46,1,"かたむ"],[49,2,"ゆうひ"],[52,1,"かげ"],[54,1,"なが"]],"text":"「戦いを始め、彼女を攻めよ。立て、われわれは真昼に攻撃しよう」。「わざわいなるかな、日ははや傾き、夕日の影は長くなった」。"},{"ref":"Jer.6.5","start":24006005,"end":24006005,"break":"line","breaks":[[19,"line"]],"ruby":[[1,1,"た"],[9,1,"よる"],[11,1,"あいだ"],[13,2,"こうげき"],[22,2,"かのじょ"],[30,2,"きゅうでん"],[33,2,"はかい"]],"text":"「立て、われわれは夜の間に攻撃しよう、そして彼女のもろもろの宮殿を破壊しよう」。"},{"ref":"Jer.6.6","start":24006006,"end":24006006,"break":"stanza","breaks":[[12,"line"],[29,"line"],[44,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"い"],[19,2,"かのじょ"],[22,1,"き"],[24,1,"き"],[26,1,"たお"],[39,1,"るい"],[41,1,"きず"],[47,1,"ばつ"],[51,1,"まち"],[64,2,"あっせい"]],"text":"万軍の主はこう言われる、「あなたがたは彼女の木を切り倒し、エルサレムにむかって塁を築け。これは罰すべき町である、そのうちにはただ圧制だけがある。"},{"ref":"Jer.6.7","start":24006007,"end":24006007,"break":"line","breaks":[[13,"line"],[29,"line"],[46,"line"]],"ruby":[[0,2,"いど"],[3,1,"あたら"],[6,1,"みず"],[13,2,"かのじょ"],[18,1,"あく"],[20,1,"つね"],[26,1,"なが"],[35,2,"ぼうぎゃく"],[38,2,"はめつ"],[42,1,"きこ"],[50,1,"まえ"],[52,1,"やまい"],[54,1,"きず"],[57,1,"た"]],"text":"井戸に新しい水がわくように彼女はその悪を常にあらたに流す。そのうちには暴虐と破滅とが聞える。わたしの前に病と傷とが絶えない。"},{"ref":"Jer.6.8","start":24006008,"end":24006008,"break":"line","breaks":[[16,"line"],[34,"line"]],"ruby":[[7,1,"いまし"],[10,1,"う"],[31,1,"はな"],[38,1,"あ"],[40,1,"ち"],[44,1,"す"],[46,1,"ひと"],[50,1,"ち"]],"text":"エルサレムよ、戒めを受けいれよ。さもないと、わたしはあなたから離れ、あなたを荒れ地とし、住む人のない地とする」。"},{"ref":"Jer.6.9","start":24006009,"end":24006009,"break":"stanza","breaks":[[12,"line"],[28,"line"],[48,"line"],[62,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"い"],[17,1,"のこ"],[20,1,"つ"],[34,1,"のこ"],[37,1,"たみ"],[43,1,"つ"],[45,1,"と"],[52,1,"つ"],[56,1,"ひと"],[66,1,"て"],[74,1,"えだ"],[76,1,"の"]],"text":"万軍の主はこう言われる、「ぶどうの残りを摘みとるように、イスラエルの残りの民をのこらず摘み取れ。ぶどうを摘みとる人のように、あなたの手をふたたびその枝に伸ばせ」。"},{"ref":"Jer.6.10","start":24006010,"end":24006010,"break":"line","breaks":[[24,"line"],[48,"line"]],"ruby":[[7,1,"かた"],[13,1,"いまし"],[17,1,"き"],[24,1,"み"],[27,1,"かれ"],[30,1,"みみ"],[32,1,"と"],[38,1,"き"],[48,1,"み"],[51,1,"かれ"],[54,1,"しゅ"],[56,2,"ことば"],[67,1,"よろこ"]],"text":"わたしはだれに語り、だれを戒めて、聞かせようか。見よ、彼らの耳は閉ざされて、聞くことができない。見よ、彼らは主の言葉をあざけり、それを喜ばない。"},{"ref":"Jer.6.11","start":24006011,"end":24006011,"break":"line","breaks":[[20,"line"],[37,"line"],[52,"line"],[68,"line"],[79,"line"]],"ruby":[[9,1,"み"],[12,1,"しゅ"],[14,1,"いか"],[17,1,"み"],[23,1,"しの"],[47,2,"こども"],[52,1,"あつ"],[58,1,"わか"],[60,2,"ひとびと"],[64,1,"も"],[68,1,"おっと"],[70,1,"つま"],[73,1,"お"],[76,1,"ひと"],[79,1,"とし"],[86,1,"すす"],[89,1,"ひと"],[91,1,"とら"]],"text":"それゆえ、わたしの身には主の怒りが満ち、それを忍ぶのに、うみつかれている。「それをちまたにいる子供らと、集まっている若い人々とに漏らせ。夫も妻も、老いた人も、年のひじょうに進んだ人も捕えられ、"},{"ref":"Jer.6.12","start":24006012,"end":24006012,"break":"line","breaks":[[18,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[3,1,"いえ"],[5,1,"はたけ"],[7,1,"つま"],[10,1,"とも"],[12,2,"たにん"],[15,1,"わた"],[22,1,"て"],[24,1,"の"],[31,1,"ち"],[33,1,"す"],[35,1,"もの"],[37,1,"う"],[46,1,"しゅ"],[48,1,"い"]],"text":"彼らの家と畑と妻とは共に他人に渡る。わたしが手を伸ばして、この地に住む者を撃つからである」と主は言われる。"},{"ref":"Jer.6.13","start":24006013,"end":24006013,"break":"line","breaks":[[21,"line"],[33,"line"],[49,"line"]],"ruby":[[4,1,"かれ"],[8,1,"ちい"],[11,1,"もの"],[14,1,"おお"],[17,1,"もの"],[23,2,"ふせい"],[26,1,"り"],[35,3,"よげんしゃ"],[40,2,"さいし"],[51,1,"いつわ"],[54,1,"おこな"]],"text":"「それは彼らが、小さい者から大きい者まで、みな不正な利をむさぼり、また預言者から祭司にいたるまで、みな偽りを行っているからだ。"},{"ref":"Jer.6.14","start":24006014,"end":24006014,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[4,2,"てがる"],[11,1,"たみ"],[13,1,"きず"],[19,2,"へいあん"],[27,2,"へいあん"],[30,2,"へいあん"],[34,1,"い"]],"text":"彼らは、手軽にわたしの民の傷をいやし、平安がないのに『平安、平安』と言っている。"},{"ref":"Jer.6.15","start":24006015,"end":24006015,"break":"line","breaks":[[22,"line"],[37,"line"],[52,"line"],[70,"line"],[83,"line"]],"ruby":[[0,1,"かれ"],[3,1,"にく"],[13,1,"は"],[26,1,"は"],[33,1,"おも"],[39,1,"は"],[45,1,"し"],[56,1,"かれ"],[59,1,"たお"],[62,1,"もの"],[64,1,"とも"],[66,1,"たお"],[74,1,"かれ"],[77,1,"ばっ"],[83,1,"かれ"],[86,1,"たお"],[91,1,"しゅ"],[93,1,"い"]],"text":"彼らは憎むべきことをして、恥じたであろうか。すこしも恥ずかしいとは思わず、また恥じることを知らなかった。それゆえ彼らは倒れる者と共に倒れる。わたしが彼らを罰するとき、彼らは倒れる」と主は言われる。"},{"ref":"Jer.6.16","start":24006016,"end":24006016,"break":"stanza","breaks":[[9,"line"],[29,"line"],[39,"line"],[58,"line"],[79,"line"],[89,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[19,1,"みち"],[21,1,"た"],[27,1,"み"],[34,1,"みち"],[39,1,"よ"],[41,1,"みち"],[47,1,"たず"],[53,1,"みち"],[55,1,"あゆ"],[67,1,"たましい"],[73,2,"あんそく"],[76,1,"え"],[82,1,"かれ"],[85,1,"こた"],[97,1,"みち"],[99,1,"あゆ"],[105,1,"い"]],"text":"主はこう言われる、「あなたがたはわかれ道に立って、よく見、いにしえの道につき、良い道がどれかを尋ねて、その道に歩み、そしてあなたがたの魂のために、安息を得よ。しかし彼らは答えて、『われわれはその道に歩まない』と言った。"},{"ref":"Jer.6.17","start":24006017,"end":24006017,"break":"line","breaks":[[20,"line"],[38,"line"],[48,"line"]],"ruby":[[10,1,"うえ"],[12,2,"みはり"],[17,1,"た"],[25,1,"おと"],[27,1,"き"],[34,1,"い"],[41,1,"かれ"],[44,1,"こた"],[54,1,"き"],[67,1,"い"]],"text":"わたしはあなたがたの上に見張びとを立て、『ラッパの音に気をつけよ』と言った。しかし彼らは答えて、『われわれは気をつけることはしない』と言った。"},{"ref":"Jer.6.18","start":24006018,"end":24006018,"break":"line","breaks":[[13,"line"]],"ruby":[[4,2,"くにぐに"],[7,1,"たみ"],[10,1,"き"],[13,2,"かいしゅう"],[17,1,"かれ"],[28,1,"おこ"],[32,1,"し"]],"text":"それゆえ国々の民よ、聞け。会衆よ、彼らにどのようなことが起るかを知れ。"},{"ref":"Jer.6.19","start":24006019,"end":24006019,"break":"line","breaks":[[23,"line"],[39,"line"],[55,"line"]],"ruby":[[0,1,"ち"],[3,1,"き"],[6,1,"み"],[15,1,"たみ"],[17,1,"わざわい"],[26,1,"かれ"],[34,1,"み"],[39,1,"かれ"],[46,2,"ことば"],[49,1,"き"],[63,1,"す"]],"text":"地よ、聞け。見よ、わたしはこの民に災をくだす。それは彼らのたくらみの実である。彼らがわたしの言葉に気をつけず、わたしのおきてを捨てたからである。"},{"ref":"Jer.6.20","start":24006020,"end":24006020,"break":"line","breaks":[[16,"line"],[36,"line"],[57,"line"]],"ruby":[[9,1,"ところ"],[11,2,"にゅうこう"],[14,1,"き"],[16,1,"とお"],[18,1,"くに"],[22,2,"しょうぶ"],[25,1,"く"],[42,2,"はんさい"],[50,1,"よろこ"],[63,2,"ぎせい"]],"text":"シバから、わたしの所に乳香が来、遠い国から、菖蒲が来るのはなんのためか。あなたがたの燔祭はわたしには喜ばしくなく、あなたがたの犠牲もうれしくはない。"},{"ref":"Jer.6.21","start":24006021,"end":24006021,"break":"line","breaks":[[13,"line"],[36,"line"],[53,"line"]],"ruby":[[4,1,"しゅ"],[8,1,"い"],[14,1,"み"],[23,1,"たみ"],[25,1,"まえ"],[31,1,"いし"],[33,1,"お"],[36,2,"ひとびと"],[39,1,"ちち"],[41,1,"こ"],[43,1,"とも"],[53,1,"とな"],[55,1,"びと"],[59,1,"とも"],[61,1,"ほろ"]],"text":"それゆえ主はこう言われる、『見よ、わたしはこの民の前につまずく石を置く、人々は父も子も共にそれにつまずき、隣り人もその友も滅びる』」。"},{"ref":"Jer.6.22","start":24006022,"end":24006022,"break":"stanza","breaks":[[9,"line"],[23,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[10,1,"み"],[13,1,"たみ"],[15,1,"きた"],[17,1,"くに"],[20,1,"く"],[23,1,"おお"],[27,2,"こくみん"],[30,1,"ち"],[32,1,"はて"],[35,1,"おこ"]],"text":"主はこう言われる、「見よ、民が北の国から来る、大いなる国民が地の果から興る。"},{"ref":"Jer.6.23","start":24006023,"end":24006023,"break":"line","breaks":[[11,"line"],[26,"line"],[38,"line"],[53,"line"],[68,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ゆみ"],[11,1,"かれ"],[14,2,"ざんにん"],[26,1,"うみ"],[31,1,"ひび"],[34,1,"た"],[42,1,"むすめ"],[45,1,"かれ"],[48,1,"うま"],[50,1,"の"],[56,1,"ひと"],[61,1,"み"],[72,1,"せ"]],"text":"彼らは弓とやりをとる。彼らは残忍で、あわれみがなく、海のような響きを立てる。シオンの娘よ、彼らは馬に乗り、いくさ人のように身をよろって、あなたを攻める」。"},{"ref":"Jer.6.24","start":24006024,"end":24006024,"break":"line","breaks":[[15,"line"],[31,"line"]],"ruby":[[11,1,"き"],[15,1,"て"],[17,1,"よわ"],[20,1,"こ"],[22,1,"う"],[24,1,"おんな"],[26,1,"のぞ"],[31,1,"なや"],[34,1,"くる"],[39,1,"とら"]],"text":"われわれはそのうわさを聞いて、手は弱り、子を産む女に臨むような悩みと苦しみとに捕えられた。"},{"ref":"Jer.6.25","start":24006025,"end":24006025,"break":"line","breaks":[[10,"line"],[23,"line"]],"ruby":[[0,1,"はたけ"],[2,1,"で"],[12,1,"みち"],[14,1,"ある"],[23,1,"てき"],[29,1,"も"],[32,1,"おそ"],[35,2,"しほう"]],"text":"畑に出てはならない、また道を歩いてはならない。敵はつるぎを持ち、恐れが四方にあるからだ。"},{"ref":"Jer.6.26","start":24006026,"end":24006026,"break":"line","breaks":[[16,"line"],[24,"line"],[48,"line"]],"ruby":[[2,1,"たみ"],[4,1,"むすめ"],[7,2,"あらぬの"],[10,1,"み"],[16,1,"はい"],[18,1,"なか"],[27,1,"こ"],[29,1,"うしな"],[32,1,"とき"],[38,1,"かな"],[45,1,"なげ"],[48,1,"ほろ"],[51,1,"もの"],[63,1,"おそ"]],"text":"わが民の娘よ、荒布を身にまとい、灰の中にまろび、ひとり子を失った時のように、悲しみ、いたく嘆け。滅ぼす者が、にわかにわれわれを襲うからだ。"},{"ref":"Jer.6.27","start":24006027,"end":24006027,"break":"stanza","breaks":[[18,"line"],[31,"line"],[43,"line"]],"ruby":[[9,1,"たみ"],[14,1,"た"],[21,1,"もの"],[23,1,"こころ"],[26,1,"もの"],[35,1,"かれ"],[38,1,"みち"],[40,1,"し"]],"text":"「わたしはあなたを民のうちに立てて、ためす者、試みる者とした。あなたが彼らの道を知り、それをためすことができるようにするためである。"},{"ref":"Jer.6.28","start":24006028,"end":24006028,"break":"line","breaks":[[17,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[6,2,"ごうじょう"],[9,3,"はんぎゃくしゃ"],[17,1,"ある"],[23,1,"ひと"],[29,1,"かれ"],[32,2,"せいどう"],[35,1,"てつ"],[43,1,"いや"],[49,1,"おこな"]],"text":"彼らはみな、強情な反逆者であって、歩きまわって人をそしる。彼らは青銅や鉄であって、みな卑しいことを行う。"},{"ref":"Jer.6.29","start":24006029,"end":24006029,"break":"line","breaks":[[10,"line"],[20,"line"],[31,"line"]],"ruby":[[4,1,"はげ"],[7,1,"ふ"],[10,1,"なまり"],[12,1,"ひ"],[17,1,"つ"],[20,2,"せいれん"],[28,1,"すす"],[31,1,"あ"],[34,1,"もの"],[38,1,"のぞ"]],"text":"ふいごは激しく吹き、鉛は火にとけて尽き、精錬はいたずらに進む。悪しき者がまだ除かれないからである。"},{"ref":"Jer.6.30","start":24006030,"end":24006030,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"す"],[13,1,"かれ"],[16,1,"す"],[21,1,"ぎん"],[23,1,"よ"]],"text":"主が彼らを捨てられたので、彼らは捨てられた銀と呼ばれる」。"}]