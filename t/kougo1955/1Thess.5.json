[{"ref":"1Thess.5.1","start":52005001,"end":52005001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[8,2,"じき"],[11,2,"ばあい"],[20,1,"か"],[25,2,"ひつよう"]],"text":"兄弟たちよ。その時期と場合とについては、書きおくる必要はない。"},{"ref":"1Thess.5.2","start":52005002,"end":52005002,"break":"none","ruby":[[5,2,"じしん"],[10,1,"し"],[19,1,"しゅ"],[21,1,"ひ"],[23,2,"ぬすびと"],[26,1,"よる"],[32,1,"く"]],"text":"あなたがた自身がよく知っているとおり、主の日は盗人が夜くるように来る。"},{"ref":"1Thess.5.3","start":52005003,"end":52005003,"break":"none","ruby":[[0,2,"ひとびと"],[3,2,"へいわ"],[6,2,"ぶじ"],[10,1,"い"],[17,2,"やさき"],[25,2,"にんぷ"],[28,1,"う"],[31,1,"くる"],[35,1,"のぞ"],[41,2,"とつじょ"],[46,1,"ほろ"],[49,1,"かれ"],[56,1,"く"],[74,1,"けっ"]],"text":"人々が平和だ無事だと言っているその矢先に、ちょうど妊婦に産みの苦しみが臨むように、突如として滅びが彼らをおそって来る。そして、それからのがれることは決してできない。"},{"ref":"1Thess.5.4","start":52005004,"end":52005004,"break":"none","ruby":[[3,2,"きょうだい"],[15,1,"くら"],[19,1,"なか"],[31,1,"ひ"],[34,2,"ぬすびと"],[46,1,"ふ"],[47,1,"い"],[49,1,"おそ"]],"text":"しかし兄弟たちよ。あなたがたは暗やみの中にいないのだから、その日が、盗人のようにあなたがたを不意に襲うことはないであろう。"},{"ref":"1Thess.5.5","start":52005005,"end":52005005,"break":"none","ruby":[[8,1,"ひかり"],[10,1,"こ"],[15,1,"ひる"],[17,1,"こ"],[31,1,"よる"],[33,1,"もの"],[39,1,"もの"]],"text":"あなたがたはみな光の子であり、昼の子なのである。わたしたちは、夜の者でもやみの者でもない。"},{"ref":"1Thess.5.6","start":52005006,"end":52005006,"break":"none","ruby":[[7,2,"ひとびと"],[13,1,"ねむ"],[21,1,"め"],[27,1,"つつし"]],"text":"だから、ほかの人々のように眠っていないで、目をさまして慎んでいよう。"},{"ref":"1Thess.5.7","start":52005007,"end":52005007,"break":"none","ruby":[[0,1,"ねむ"],[2,1,"もの"],[4,1,"よる"],[5,1,"ねむ"],[8,1,"よ"],[10,1,"もの"],[12,1,"よる"],[13,1,"よ"]],"text":"眠る者は夜眠り、酔う者は夜酔うのである。"},{"ref":"1Thess.5.8","start":52005008,"end":52005008,"break":"none","ruby":[[10,1,"ひる"],[12,1,"もの"],[19,2,"しんこう"],[22,1,"あい"],[25,2,"むねあて"],[28,1,"み"],[33,1,"すくい"],[35,1,"のぞ"],[47,1,"つつし"]],"text":"しかし、わたしたちは昼の者なのだから、信仰と愛との胸当を身につけ、救の望みのかぶとをかぶって、慎んでいよう。"},{"ref":"1Thess.5.9","start":52005009,"end":52005009,"break":"none","ruby":[[0,1,"かみ"],[9,1,"いか"],[19,1,"さだ"],[36,1,"しゅ"],[49,1,"すくい"],[51,1,"え"],[56,1,"さだ"]],"text":"神は、わたしたちを怒りにあわせるように定められたのではなく、わたしたちの主イエス・キリストによって救を得るように定められたのである。"},{"ref":"1Thess.5.10","start":52005010,"end":52005010,"break":"none","ruby":[[14,1,"し"],[27,1,"ねむ"],[40,1,"しゅ"],[42,1,"とも"],[44,1,"い"]],"text":"キリストがわたしたちのために死なれたのは、さめていても眠っていても、わたしたちが主と共に生きるためである。"},{"ref":"1Thess.5.11","start":52005011,"end":52005011,"break":"none","ruby":[[11,1,"いま"],[20,1,"たがい"],[22,1,"なぐさ"],[24,1,"あ"],[27,2,"そうご"],[30,1,"とく"],[32,1,"たか"]],"text":"だから、あなたがたは、今しているように、互に慰め合い、相互の徳を高めなさい。"},{"ref":"1Thess.5.12","start":52005012,"end":52005012,"break":"paragraph","ruby":[[0,2,"きょうだい"],[13,1,"ねが"],[28,1,"あいだ"],[30,1,"ろう"],[33,1,"しゅ"],[44,2,"しどう"],[50,2,"くんかい"],[56,2,"ひとびと"],[59,1,"おも"]],"text":"兄弟たちよ。わたしたちはお願いする。どうか、あなたがたの間で労し、主にあってあなたがたを指導し、かつ訓戒している人々を重んじ、"},{"ref":"1Thess.5.13","start":52005013,"end":52005013,"break":"none","ruby":[[0,1,"かれ"],[3,1,"はたら"],[6,1,"おも"],[10,1,"とく"],[12,1,"あい"],[14,1,"うやま"],[20,1,"たがい"],[22,2,"へいわ"],[25,1,"す"]],"text":"彼らの働きを思って、特に愛し敬いなさい。互に平和に過ごしなさい。"},{"ref":"1Thess.5.14","start":52005014,"end":52005014,"break":"none","ruby":[[0,2,"きょうだい"],[13,1,"すす"],[18,2,"たいだ"],[21,1,"もの"],[23,1,"いまし"],[26,2,"しょうしん"],[29,1,"もの"],[31,1,"はげ"],[35,1,"よわ"],[37,1,"もの"],[39,1,"たす"],[46,1,"ひと"],[48,1,"たい"],[51,2,"かんよう"]],"text":"兄弟たちよ。あなたがたにお勧めする。怠惰な者を戒め、小心な者を励まし、弱い者を助け、すべての人に対して寛容でありなさい。"},{"ref":"1Thess.5.15","start":52005015,"end":52005015,"break":"none","ruby":[[3,1,"あく"],[8,1,"あく"],[10,1,"むく"],[17,1,"こころ"],[22,1,"たがい"],[31,1,"たい"],[38,1,"ぜん"],[40,1,"お"],[42,1,"もと"]],"text":"だれも悪をもって悪に報いないように心がけ、お互に、またみんなに対して、いつも善を追い求めなさい。"},{"ref":"1Thess.5.16","start":52005016,"end":52005016,"break":"none","ruby":[[3,1,"よろこ"]],"text":"いつも喜んでいなさい。"},{"ref":"1Thess.5.17","start":52005017,"end":52005017,"break":"none","ruby":[[0,1,"た"],[3,1,"いの"]],"text":"絶えず祈りなさい。"},{"ref":"1Thess.5.18","start":52005018,"end":52005018,"break":"none","ruby":[[4,1,"こと"],[10,2,"かんしゃ"],[34,1,"かみ"],[42,1,"もと"]],"text":"すべての事について、感謝しなさい。これが、キリスト・イエスにあって、神があなたがたに求めておられることである。"},{"ref":"1Thess.5.19","start":52005019,"end":52005019,"break":"none","ruby":[[0,2,"みたま"],[3,1,"け"]],"text":"御霊を消してはいけない。"},{"ref":"1Thess.5.20","start":52005020,"end":52005020,"break":"none","ruby":[[0,2,"よげん"],[3,1,"かろ"]],"text":"預言を軽んじてはならない。"},{"ref":"1Thess.5.21","start":52005021,"end":52005021,"break":"none","ruby":[[7,2,"しきべつ"],[12,1,"よ"],[17,1,"まも"]],"text":"すべてのものを識別して、良いものを守り、"},{"ref":"1Thess.5.22","start":52005022,"end":52005022,"break":"none","ruby":[[4,2,"しゅるい"],[7,1,"あく"],[10,1,"とお"]],"text":"あらゆる種類の悪から遠ざかりなさい。"},{"ref":"1Thess.5.23","start":52005023,"end":52005023,"break":"paragraph","ruby":[[4,2,"へいわ"],[7,1,"かみ"],[9,2,"じしん"],[19,1,"まった"],[25,1,"くだ"],[41,1,"れい"],[43,1,"こころ"],[50,2,"かんぜん"],[53,1,"まも"],[63,1,"しゅ"],[73,2,"らいりん"],[80,1,"せ"],[91,1,"もの"],[95,1,"くだ"]],"text":"どうか、平和の神ご自身が、あなたがたを全くきよめて下さるように。また、あなたがたの霊と心とからだとを完全に守って、わたしたちの主イエス・キリストの来臨のときに、責められるところのない者にして下さるように。"},{"ref":"1Thess.5.24","start":52005024,"end":52005024,"break":"none","ruby":[[6,1,"め"],[13,2,"しんじつ"],[30,1,"くだ"]],"text":"あなたがたを召されたかたは真実であられるから、このことをして下さるであろう。"},{"ref":"1Thess.5.25","start":52005025,"end":52005025,"break":"paragraph","ruby":[[0,2,"きょうだい"],[17,1,"いの"]],"text":"兄弟たちよ。わたしたちのためにも、祈ってほしい。"},{"ref":"1Thess.5.26","start":52005026,"end":52005026,"break":"paragraph","ruby":[[4,2,"きょうだい"],[13,2,"せっぷん"],[24,1,"つた"]],"text":"すべての兄弟たちに、きよい接吻をもって、よろしく伝えてほしい。"},{"ref":"1Thess.5.27","start":52005027,"end":52005027,"break":"none","ruby":[[4,1,"しゅ"],[9,1,"めい"],[15,2,"てがみ"],[23,2,"きょうだい"],[26,1,"よ"],[28,1,"き"]],"text":"わたしは主によって命じる。この手紙を、みんなの兄弟に読み聞かせなさい。"},{"ref":"1Thess.5.28","start":52005028,"end":52005028,"break":"paragraph","ruby":[[6,1,"しゅ"],[16,1,"めぐ"],[26,1,"とも"]],"text":"わたしたちの主イエス・キリストの恵みが、あなたがたと共にあるように。"}]