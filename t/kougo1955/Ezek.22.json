[{"ref":"Ezek.22.1","start":26022001,"end":26022001,"break":"paragraph","ruby":[[2,1,"しゅ"],[4,2,"ことば"],[11,1,"のぞ"],[14,1,"い"]],"text":"また主の言葉がわたしに臨んで言った、"},{"ref":"Ezek.22.2","start":26022002,"end":26022002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[16,1,"ち"],[18,1,"なが"],[22,1,"まち"],[36,1,"まち"],[45,1,"にく"],[49,1,"こと"],[51,1,"しめ"]],"text":"「人の子よ、あなたはさばくのか。血を流すこの町をさばくのか。それならこの町にそのもろもろの憎むべき事を示して、"},{"ref":"Ezek.22.3","start":26022003,"end":26022003,"break":"none","ruby":[[0,1,"い"],[3,1,"しゅ"],[6,1,"かみ"],[10,1,"い"],[15,2,"じぶん"],[21,1,"ち"],[23,1,"なが"],[29,2,"けいばつ"],[32,1,"とき"],[38,2,"ぐうぞう"],[41,1,"つく"],[46,1,"み"],[48,1,"けが"],[50,1,"まち"]],"text":"言え。主なる神はこう言われる、自分のうちに血を流して、その刑罰の時をまねき、偶像を造ってその身を汚す町よ、"},{"ref":"Ezek.22.4","start":26022004,"end":26022004,"break":"none","ruby":[[6,1,"なが"],[9,1,"ち"],[14,1,"つみ"],[16,1,"え"],[20,1,"つく"],[23,2,"ぐうぞう"],[29,1,"けが"],[36,1,"ひ"],[38,1,"ちか"],[47,1,"ねん"],[49,1,"さだ"],[52,1,"とき"],[74,2,"こくみん"],[85,2,"ばんこく"],[88,2,"ものわら"]],"text":"あなたはその流した血によって罪を得、その造った偶像によって汚れ、あなたの日を近づかせ、あなたの年の定めの時はきた。それゆえわたしはあなたをもろもろの国民のあざけりとなし、万国の物笑いとする。"},{"ref":"Ezek.22.5","start":26022005,"end":26022005,"break":"none","ruby":[[4,1,"ちか"],[6,1,"もの"],[9,1,"とお"],[11,1,"もの"],[14,1,"けが"],[18,2,"こんらん"],[21,1,"み"]],"text":"あなたに近い者も、遠い者も、汚れと、混乱に満ちているあなたをあざける。"},{"ref":"Ezek.22.6","start":26022006,"end":26022006,"break":"paragraph","ruby":[[0,1,"み"],[16,1,"きみ"],[27,1,"ちから"],[35,1,"ち"],[37,1,"なが"]],"text":"見よ、あなたのうちのイスラエルの君たちは、おのおのその力にしたがって、血を流そうとしている。"},{"ref":"Ezek.22.7","start":26022007,"end":26022007,"break":"none","ruby":[[0,2,"ふぼ"],[10,1,"いや"],[16,3,"きりゅうしゃ"],[27,2,"ぎゃくたい"],[51,1,"なや"]],"text":"父母はあなたのうちで卑しめられ、寄留者はあなたのうちで虐待をうけ、みなしごと、やもめとはあなたのうちで悩まされている。"},{"ref":"Ezek.22.8","start":26022008,"end":26022008,"break":"none","ruby":[[8,1,"せい"],[14,1,"いや"],[22,3,"あんそくにち"],[26,1,"けが"]],"text":"あなたはわたしの聖なるものを卑しめ、わたしの安息日を汚した。"},{"ref":"Ezek.22.9","start":26022009,"end":26022009,"break":"none","ruby":[[0,1,"ひと"],[7,1,"ち"],[9,1,"なが"],[15,1,"もの"],[28,2,"ひとびと"],[39,1,"やま"],[41,1,"うえ"],[43,2,"しょくじ"]],"text":"人をののしって血を流そうとする者は、あなたのうちにおり、人々はあなたのうちで、山の上で食事をし、あなたのうちで、みだらなおこないをし、"},{"ref":"Ezek.22.10","start":26022010,"end":26022010,"break":"none","ruby":[[8,1,"ちち"],[10,1,"はだか"],[12,1,"あらわ"],[23,1,"けが"],[31,1,"おんな"],[33,1,"おか"]],"text":"あなたのうちで、父の裸を現し、あなたのうちで、汚れのうちにある女を犯す。"},{"ref":"Ezek.22.11","start":26022011,"end":26022011,"break":"none","ruby":[[12,1,"となり"],[14,1,"つま"],[16,1,"にく"],[20,1,"こと"],[22,1,"おこな"],[24,1,"もの"],[29,2,"いんこう"],[38,1,"よめ"],[40,1,"けが"],[42,1,"もの"],[47,2,"じぶん"],[50,1,"ちち"],[52,1,"むすめ"],[56,2,"じぶん"],[59,2,"しまい"],[62,1,"おか"],[64,1,"もの"]],"text":"またあなたのうちに、その隣の妻と憎むべき事を行う者があり、淫行をもって、その嫁を汚す者があり、自分の父の娘である自分の姉妹を犯す者があり、"},{"ref":"Ezek.22.12","start":26022012,"end":26022012,"break":"none","ruby":[[2,1,"ち"],[4,1,"なが"],[24,1,"と"],[26,1,"もの"],[35,2,"りそく"],[38,2,"こうり"],[42,1,"と"],[58,1,"とな"],[60,1,"びと"],[76,1,"わす"],[85,1,"しゅ"],[88,1,"かみ"],[90,1,"い"]],"text":"また血を流そうとして、あなたのうちで、まいないを取る者がある。あなたは利息と高利とを取り、しえたげによって、あなたの隣り人のものをかすめ、そしてわたしを忘れてしまったと、主なる神は言われる。"},{"ref":"Ezek.22.13","start":26022013,"end":26022013,"break":"paragraph","ruby":[[4,1,"み"],[11,1,"え"],[13,2,"ふせい"],[16,1,"り"],[18,1,"こと"],[32,2,"りゅうけつ"],[35,1,"こと"],[37,1,"たい"],[45,1,"て"],[47,1,"う"]],"text":"それゆえ見よ、あなたが得た不正の利の事、およびあなたのうちにある流血の事に対して、わたしは手を打ちならす。"},{"ref":"Ezek.22.14","start":26022014,"end":26022014,"break":"none","ruby":[[8,1,"せ"],[11,1,"ひ"],[19,2,"ゆうき"],[26,1,"た"],[28,1,"え"],[39,1,"て"],[41,1,"つよ"],[45,1,"え"],[50,1,"しゅ"],[60,2,"せんげん"]],"text":"わたしがあなたを攻める日には、あなたの勇気は、これに耐え得ようか。またあなたの手は強くあり得ようか。主なるわたしはこれを宣言し、これをなす。"},{"ref":"Ezek.22.15","start":26022015,"end":26022015,"break":"none","ruby":[[14,2,"こくみん"],[20,1,"ち"],[24,2,"くにぐに"],[27,1,"あいだ"],[40,1,"けが"],[43,1,"のぞ"]],"text":"わたしはあなたを、もろもろの国民のうちに散らし、国々の間にまき、そしてあなたから汚れを除く。"},{"ref":"Ezek.22.16","start":26022016,"end":26022016,"break":"none","ruby":[[17,2,"こくみん"],[20,1,"まえ"],[22,1,"けが"],[38,1,"しゅ"],[45,1,"し"]],"text":"わたしはあなたによって、もろもろの国民の前に汚される。そしてあなたはわたしが主であることを知る」。"},{"ref":"Ezek.22.17","start":26022017,"end":26022017,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"]],"text":"主の言葉がまたわたしに臨んだ、"},{"ref":"Ezek.22.18","start":26022018,"end":26022018,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[12,1,"いえ"],[18,1,"たい"],[31,1,"かれ"],[37,1,"ろ"],[39,1,"なか"],[41,1,"ぎん"],[43,2,"せいどう"],[49,1,"てつ"],[51,1,"なまり"]],"text":"「人の子よ、イスラエルの家はわたしに対して、かなかすとなった。彼らはすべて炉の中の銀、青銅、すず、鉄、鉛のかなかすとなった。"},{"ref":"Ezek.22.19","start":26022019,"end":26022019,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[23,1,"みな"],[35,1,"み"],[54,1,"なか"],[56,1,"あつ"]],"text":"それゆえ、主なる神はこう言われる、あなたがたは皆かなかすとなったゆえ、見よ、わたしはあなたがたをエルサレムの中に集める。"},{"ref":"Ezek.22.20","start":26022020,"end":26022020,"break":"none","ruby":[[0,1,"ひと"],[2,1,"ぎん"],[4,2,"せいどう"],[7,1,"てつ"],[9,1,"なまり"],[16,1,"ろ"],[18,1,"なか"],[20,1,"あつ"],[26,1,"ひ"],[28,1,"ふ"],[33,1,"と"],[44,1,"いか"],[47,1,"いきどお"],[61,1,"あつ"],[63,1,"い"],[66,1,"と"]],"text":"人が銀、青銅、鉄、鉛、すずなどを炉の中に集め、これに火を吹きかけて溶かすように、わたしは怒りと憤りとをもって、あなたがたを集め入れて溶かす。"},{"ref":"Ezek.22.21","start":26022021,"end":26022021,"break":"none","ruby":[[15,1,"あつ"],[22,1,"いか"],[25,1,"ひ"],[34,1,"ふ"],[48,1,"なか"],[50,1,"と"]],"text":"すなわち、わたしはあなたがたを集め、わたしの怒りの火を、あなたがたに吹きかける。あなたがたはその中で溶ける。"},{"ref":"Ezek.22.22","start":26022022,"end":26022022,"break":"none","ruby":[[0,1,"ぎん"],[2,1,"ろ"],[4,1,"なか"],[6,1,"と"],[21,1,"なか"],[23,1,"と"],[36,1,"しゅ"],[50,1,"うえ"],[57,1,"いか"],[60,1,"そそ"],[66,1,"し"]],"text":"銀が炉の中で溶けるように、あなたがたもその中で溶ける。そしてあなたがたは主なるわたしが、あなたがたの上に、わたしの怒りを注いだことを知るようになる」。"},{"ref":"Ezek.22.23","start":26022023,"end":26022023,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"]],"text":"主の言葉がまたわたしに臨んだ、"},{"ref":"Ezek.22.24","start":26022024,"end":26022024,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[9,1,"い"],[16,1,"いか"],[19,1,"ひ"],[21,1,"きよ"],[29,1,"あめ"],[31,1,"ふ"],[35,1,"ち"]],"text":"「人の子よ、これに言え、あなたは怒りの日に清められず、また雨の降らない地である。"},{"ref":"Ezek.22.25","start":26022025,"end":26022025,"break":"none","ruby":[[2,1,"なか"],[4,1,"きみ"],[9,2,"えもの"],[12,1,"さ"],[23,1,"もの"],[26,1,"かれ"],[29,2,"ひとびと"],[32,1,"ほろ"],[36,1,"たから"],[38,1,"たっと"],[40,1,"もの"],[43,1,"と"],[56,1,"かず"]],"text":"その中の君たちは、獲物を裂くほえるししのような者で、彼らは人々を滅ぼし、宝と尊い物とを取り、そのうちに、やもめの数をふやす。"},{"ref":"Ezek.22.26","start":26022026,"end":26022026,"break":"none","ruby":[[2,2,"さいし"],[9,2,"りっぽう"],[12,1,"おか"],[15,1,"せい"],[18,1,"もの"],[20,1,"けが"],[24,1,"かれ"],[27,1,"せい"],[30,1,"もの"],[32,1,"けが"],[35,1,"もの"],[38,2,"くべつ"],[43,1,"きよ"],[47,1,"もの"],[49,1,"きよ"],[51,1,"もの"],[54,1,"ちが"],[57,1,"おし"],[63,3,"あんそくにち"],[67,2,"むし"],[79,1,"かれ"],[82,1,"あいだ"],[84,1,"けが"]],"text":"その祭司たちはわが律法を犯し、聖なる物を汚した。彼らは聖なる物と汚れた物とを区別せず、清くない物と清い物との違いを教えず、わが安息日を無視し、こうしてわたしは彼らの間に汚されている。"},{"ref":"Ezek.22.27","start":26022027,"end":26022027,"break":"none","ruby":[[2,1,"なか"],[6,1,"きみ"],[11,2,"えもの"],[14,1,"さ"],[25,1,"ち"],[27,1,"なが"],[30,2,"ふせい"],[33,1,"り"],[35,1,"え"],[40,2,"ひとびと"],[43,1,"ほろ"]],"text":"その中にいる君たちは、獲物を裂くおおかみのようで、血を流し、不正の利を得るために人々を滅ぼす。"},{"ref":"Ezek.22.28","start":26022028,"end":26022028,"break":"none","ruby":[[2,3,"よげんしゃ"],[9,1,"みず"],[18,1,"ぬ"],[21,1,"いつわ"],[24,1,"まぼろし"],[26,1,"み"],[28,1,"かれ"],[31,1,"いつわ"],[34,1,"うらな"],[37,1,"しゅ"],[39,1,"かた"],[46,1,"しゅ"],[49,1,"かみ"],[53,1,"い"],[59,1,"い"]],"text":"その預言者たちは、水しっくいでこれを塗り、偽りの幻を見、彼らに偽りを占い、主が語らないのに『主なる神はこう言われる』と言う。"},{"ref":"Ezek.22.29","start":26022029,"end":26022029,"break":"none","ruby":[[0,1,"くに"],[2,1,"たみ"],[9,1,"おこな"],[12,1,"うば"],[20,1,"とぼ"],[23,1,"もの"],[25,1,"まず"],[28,1,"もの"],[35,2,"ふほう"],[38,2,"たこく"],[40,1,"じん"]],"text":"国の民はしえたげを行い、奪うことをなし、乏しい者と貧しい者とをかすめ、不法に他国人をしえたぐ。"},{"ref":"Ezek.22.30","start":26022030,"end":26022030,"break":"none","ruby":[[5,1,"くに"],[10,1,"いし"],[14,1,"きず"],[21,1,"まえ"],[27,1,"やぶ"],[29,1,"くち"],[31,1,"た"],[41,1,"ほろ"],[52,1,"もの"],[55,1,"かれ"],[61,1,"たず"],[65,1,"え"]],"text":"わたしは、国のために石がきを築き、わたしの前にあって、破れ口に立ち、わたしにこれを滅ぼさせないようにする者を、彼らのうちに尋ねたが得られなかった。"},{"ref":"Ezek.22.31","start":26022031,"end":26022031,"break":"none","ruby":[[11,1,"いか"],[14,1,"かれ"],[17,1,"うえ"],[19,1,"そそ"],[24,1,"いきどお"],[27,1,"ひ"],[32,1,"かれ"],[35,1,"ほろ"],[39,1,"かれ"],[54,1,"むく"],[59,1,"しゅ"],[62,1,"かみ"],[64,1,"い"]],"text":"それゆえ、わたしはわが怒りを彼らの上に注ぎ、わが憤りの火をもって彼らを滅ぼし、彼らのおこないを、そのこうべに報いたと、主なる神は言われる」。"}]