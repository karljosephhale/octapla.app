[{"ref":"Deut.24.1","start":5024001,"end":5024001,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"つま"],[9,2,"けっこん"],[19,1,"おんな"],[21,1,"は"],[32,1,"み"],[35,1,"この"],[46,2,"りえん"],[48,1,"じょう"],[50,1,"か"],[53,2,"かのじょ"],[56,1,"て"],[58,1,"わた"],[61,1,"いえ"],[63,1,"さ"]],"text":"人が妻をめとって、結婚したのちに、その女に恥ずべきことのあるのを見て、好まなくなったならば、離縁状を書いて彼女の手に渡し、家を去らせなければならない。"},{"ref":"Deut.24.2","start":5024002,"end":5024002,"break":"none","ruby":[[0,1,"おんな"],[4,1,"いえ"],[6,1,"で"],[11,1,"い"],[18,1,"ひと"]],"text":"女がその家を出てのち、行って、ほかの人にとつぎ、"},{"ref":"Deut.24.3","start":5024003,"end":5024003,"break":"none","ruby":[[0,1,"のち"],[2,1,"おっと"],[4,2,"かのじょ"],[12,2,"りえん"],[14,1,"じょう"],[16,1,"か"],[21,1,"て"],[23,1,"わた"],[26,1,"いえ"],[28,1,"さ"],[37,1,"つま"],[43,1,"のち"],[45,1,"おっと"],[47,1,"し"]],"text":"後の夫も彼女をきらって、離縁状を書き、その手に渡して家を去らせるか、または妻にめとった後の夫が死んだときは、"},{"ref":"Deut.24.4","start":5024004,"end":5024004,"break":"none","ruby":[[0,2,"かのじょ"],[6,1,"み"],[8,1,"けが"],[19,2,"かのじょ"],[22,1,"さ"],[26,1,"さき"],[28,1,"おっと"],[35,2,"かのじょ"],[38,1,"つま"],[54,1,"しゅ"],[56,1,"まえ"],[58,1,"にく"],[62,1,"こと"],[74,1,"かみ"],[76,1,"しゅ"],[78,1,"し"],[79,1,"ぎょう"],[87,1,"あた"],[92,1,"ち"],[94,1,"つみ"],[96,1,"お"]],"text":"彼女はすでに身を汚したのちであるから、彼女を去らせた先の夫は、ふたたび彼女を妻にめとることはできない。これは主の前に憎むべき事だからである。あなたの神、主が嗣業としてあなたに与えられる地に罪を負わせてはならない。"},{"ref":"Deut.24.5","start":5024005,"end":5024005,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"あら"],[5,1,"つま"],[11,1,"とき"],[14,2,"せんそう"],[17,1,"だ"],[28,1,"なに"],[30,1,"つとめ"],[35,1,"お"],[47,1,"ひと"],[50,1,"ねん"],[52,1,"あいだ"],[54,2,"そくばく"],[58,1,"いえ"],[69,1,"つま"],[71,1,"なぐさ"]],"text":"人が新たに妻をめとった時は、戦争に出してはならない。また何の務もこれに負わせてはならない。その人は一年の間、束縛なく家にいて、そのめとった妻を慰めなければならない。"},{"ref":"Deut.24.6","start":5024006,"end":5024006,"break":"paragraph","ruby":[[10,2,"うわいし"],[13,1,"しつ"],[27,1,"いのち"],[35,1,"しつ"]],"text":"ひきうす、またはその上石を質にとってはならない。これは命をつなぐものを質にとることだからである。"},{"ref":"Deut.24.7","start":5024007,"end":5024007,"break":"paragraph","ruby":[[6,2,"ひとびと"],[12,2,"どうほう"],[29,2,"どれい"],[46,1,"う"],[48,1,"もの"],[50,1,"み"],[66,1,"もの"],[68,1,"ころ"],[82,1,"あく"],[84,1,"のぞ"],[86,1,"さ"]],"text":"イスラエルの人々のうちの同胞のひとりをかどわかして、これを奴隷のようにあしらい、またはこれを売る者を見つけたならば、そのかどわかした者を殺して、あなたがたのうちから悪を除き去らなければならない。"},{"ref":"Deut.24.8","start":5024008,"end":5024008,"break":"paragraph","ruby":[[2,1,"びょう"],[4,1,"た"],[7,1,"とき"],[9,1,"き"],[24,2,"さいし"],[27,1,"おし"],[36,1,"まも"],[39,1,"おこな"],[58,1,"かれ"],[61,1,"めい"],[77,1,"まも"],[80,1,"おこな"]],"text":"らい病の起った時は気をつけて、すべてレビびとたる祭司が教えることを、よく守って行わなければならない。すなわちわたしが彼らに命じたように、あなたがたはそれを守って行わなければならない。"},{"ref":"Deut.24.9","start":5024009,"end":5024009,"break":"none","ruby":[[12,1,"で"],[19,1,"みち"],[25,1,"かみ"],[27,1,"しゅ"],[40,2,"きおく"]],"text":"あなたがたがエジプトから出てきたとき、道であなたの神、主がミリアムにされたことを記憶しなければならない。"},{"ref":"Deut.24.10","start":5024010,"end":5024010,"break":"paragraph","ruby":[[4,2,"りんじん"],[7,1,"もの"],[9,1,"か"],[15,2,"じぶん"],[20,1,"いえ"],[27,2,"しちもの"],[30,1,"と"]],"text":"あなたが隣人に物を貸すときは、自分でその家にはいって、質物を取ってはならない。"},{"ref":"Deut.24.11","start":5024011,"end":5024011,"break":"none","ruby":[[4,1,"そと"],[6,1,"た"],[12,1,"か"],[15,1,"ひと"],[17,2,"しちもの"],[20,1,"そと"],[32,1,"も"],[34,1,"だ"]],"text":"あなたは外に立っていて、借りた人が質物を外にいるあなたのところへ持ち出さなければならない。"},{"ref":"Deut.24.12","start":5024012,"end":5024012,"break":"none","ruby":[[4,1,"ひと"],[6,1,"まず"],[9,1,"ひと"],[13,1,"とき"],[22,2,"しちもの"],[25,1,"と"],[30,1,"ね"]],"text":"もしその人が貧しい人である時は、あなたはその質物を留めおいて寝てはならない。"},{"ref":"Deut.24.13","start":5024013,"end":5024013,"break":"none","ruby":[[2,2,"しちもの"],[5,1,"ひ"],[7,1,"い"],[13,1,"かなら"],[15,1,"かえ"],[31,1,"かれ"],[33,2,"じぶん"],[36,2,"うわぎ"],[42,1,"ね"],[55,2,"しゅくふく"],[71,1,"かみ"],[73,1,"しゅ"],[75,1,"まえ"],[81,1,"ぎ"]],"text":"その質物は日の入るまでに、必ず返さなければならない。そうすれば彼は自分の上着をかけて寝ることができて、あなたを祝福するであろう。それはあなたの神、主の前にあなたの義となるであろう。"},{"ref":"Deut.24.14","start":5024014,"end":5024014,"break":"paragraph","ruby":[[0,1,"まず"],[3,1,"とぼ"],[6,2,"やといにん"],[10,2,"どうほう"],[23,1,"くに"],[26,1,"まち"],[31,2,"きりゅう"],[37,2,"たこく"],[39,1,"じん"],[47,2,"ぎゃくたい"]],"text":"貧しく乏しい雇人は、同胞であれ、またはあなたの国で、町のうちに寄留している他国人であれ、それを虐待してはならない。"},{"ref":"Deut.24.15","start":5024015,"end":5024015,"break":"none","ruby":[[0,2,"ちんぎん"],[5,1,"ひ"],[10,1,"はら"],[16,1,"ひ"],[18,1,"い"],[22,1,"の"],[32,1,"かれ"],[34,1,"まず"],[37,1,"もの"],[42,1,"こころ"],[65,1,"かれ"],[71,1,"しゅ"],[73,1,"うった"],[81,1,"つみ"],[83,1,"え"]],"text":"賃銀はその日のうちに払い、それを日の入るまで延ばしてはならない。彼は貧しい者で、その心をこれにかけているからである。そうしなければ彼はあなたを主に訴えて、あなたは罪を得るであろう。"},{"ref":"Deut.24.16","start":5024016,"end":5024016,"break":"paragraph","ruby":[[0,1,"ちち"],[2,1,"こ"],[7,1,"ころ"],[17,1,"こ"],[19,1,"ちち"],[24,1,"ころ"],[38,2,"じぶん"],[41,1,"つみ"],[46,1,"ころ"]],"text":"父は子のゆえに殺さるべきではない。子は父のゆえに殺さるべきではない。おのおの自分の罪のゆえに殺さるべきである。"},{"ref":"Deut.24.17","start":5024017,"end":5024017,"break":"paragraph","ruby":[[0,2,"きりゅう"],[3,2,"たこく"],[5,1,"じん"],[9,2,"こじ"],[16,1,"ま"],[25,2,"かふ"],[28,2,"きもの"],[31,1,"しつ"],[33,1,"と"]],"text":"寄留の他国人または孤児のさばきを曲げてはならない。寡婦の着物を質に取ってはならない。"},{"ref":"Deut.24.18","start":5024018,"end":5024018,"break":"none","ruby":[[12,2,"どれい"],[24,1,"かみ"],[26,1,"しゅ"],[36,1,"すく"],[38,1,"だ"],[45,2,"きおく"],[70,1,"こと"],[75,1,"めい"]],"text":"あなたはかつてエジプトで奴隷であったが、あなたの神、主がそこからあなたを救い出されたことを記憶しなければならない。それでわたしはあなたにこの事をせよと命じるのである。"},{"ref":"Deut.24.19","start":5024019,"end":5024019,"break":"paragraph","ruby":[[4,1,"はたけ"],[6,2,"こくもつ"],[9,1,"か"],[11,1,"とき"],[17,2,"ひとたば"],[20,1,"はたけ"],[24,1,"わす"],[34,1,"と"],[37,1,"ひ"],[39,1,"かえ"],[51,2,"きりゅう"],[54,2,"たこく"],[56,1,"じん"],[58,2,"こじ"],[61,2,"かふ"],[64,1,"と"],[85,1,"かみ"],[87,1,"しゅ"],[98,1,"こと"],[108,2,"しゅくふく"]],"text":"あなたが畑で穀物を刈る時、もしその一束を畑におき忘れたならば、それを取りに引き返してはならない。それは寄留の他国人と孤児と寡婦に取らせなければならない。そうすればあなたの神、主はすべてあなたがする事において、あなたを祝福されるであろう。"},{"ref":"Deut.24.20","start":5024020,"end":5024020,"break":"none","ruby":[[8,1,"み"],[12,1,"おと"],[24,1,"えだ"],[26,1,"さが"],[38,2,"きりゅう"],[41,2,"たこく"],[43,1,"じん"],[45,2,"こじ"],[48,2,"かふ"],[51,1,"と"]],"text":"あなたがオリブの実をうち落すときは、ふたたびその枝を捜してはならない。それを寄留の他国人と孤児と寡婦に取らせなければならない。"},{"ref":"Deut.24.21","start":5024021,"end":5024021,"break":"none","ruby":[[5,1,"はたけ"],[11,1,"つ"],[13,1,"と"],[21,1,"のこ"],[32,1,"さが"],[44,2,"きりゅう"],[47,2,"たこく"],[49,1,"じん"],[51,2,"こじ"],[54,2,"かふ"],[57,1,"と"]],"text":"またぶどう畑のぶどうを摘み取るときは、その残ったものを、ふたたび捜してはならない。それを寄留の他国人と孤児と寡婦に取らせなければならない。"},{"ref":"Deut.24.22","start":5024022,"end":5024022,"break":"none","ruby":[[12,1,"くに"],[14,2,"どれい"],[23,2,"きおく"],[48,1,"こと"],[53,1,"めい"]],"text":"あなたはかつてエジプトの国で奴隷であったことを記憶しなければならない。それでわたしはあなたにこの事をせよと命じるのである。"}]