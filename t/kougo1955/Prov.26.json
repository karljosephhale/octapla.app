[{"ref":"Prov.26.1","start":20026001,"end":20026001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[0,1,"ほまれ"],[2,1,"おろ"],[5,1,"もの"],[17,1,"なつ"],[19,1,"ゆき"],[21,1,"ふ"],[24,2,"かりい"],[28,1,"とき"],[30,1,"あめ"],[32,1,"ふ"]],"text":"誉が愚かな者にふさわしくないのは、夏に雪が降り、刈入れの時に雨が降るようなものだ。"},{"ref":"Prov.26.2","start":20026002,"end":20026002,"break":"line","breaks":[[21,"line"]],"ruby":[[11,1,"と"],[21,1,"と"],[37,1,"と"]],"text":"いわれのないのろいは、飛びまわるすずめや、飛びかけるつばめのようなもので、止まらない。"},{"ref":"Prov.26.3","start":20026003,"end":20026003,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"うま"],[26,1,"おろ"],[29,1,"もの"],[31,1,"せ"]],"text":"馬のためにはむちがあり、ろばのためにはくつわがあり、愚かな者の背のためにはつえがある。"},{"ref":"Prov.26.4","start":20026004,"end":20026004,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[7,1,"おろ"],[16,1,"こたえ"],[22,2,"じぶん"],[25,1,"かれ"],[27,1,"おな"]],"text":"愚かな者にその愚かさにしたがって答をするな、自分も彼と同じようにならないためだ。"},{"ref":"Prov.26.5","start":20026005,"end":20026005,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[7,1,"おろ"],[16,1,"こたえ"],[21,1,"かれ"],[23,2,"じぶん"],[26,1,"め"],[28,1,"みずか"],[31,2,"ちえ"],[35,1,"もの"],[37,1,"み"]],"text":"愚かな者にその愚かさにしたがって答をせよ、彼が自分の目に自らを知恵ある者と見ないためだ。"},{"ref":"Prov.26.6","start":20026006,"end":20026006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"たく"],[8,1,"こと"],[10,1,"い"],[12,1,"おく"],[14,1,"もの"],[17,2,"じぶん"],[20,1,"あし"],[22,1,"き"],[24,1,"さ"],[27,1,"み"],[29,1,"がい"]],"text":"愚かな者に託して事を言い送る者は、自分の足を切り去り、身に害をうける。"},{"ref":"Prov.26.7","start":20026007,"end":20026007,"break":"line","breaks":[[12,"line"]],"ruby":[[5,1,"あし"],[7,1,"よう"],[12,1,"おろ"],[15,1,"もの"],[17,1,"くち"],[20,2,"しんげん"]],"text":"あしなえの足は用がない、愚かな者の口には箴言もそれにひとしい。"},{"ref":"Prov.26.8","start":20026008,"end":20026008,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ほまれ"],[2,1,"おろ"],[5,1,"もの"],[7,1,"あた"],[13,1,"いし"],[15,1,"いし"],[16,1,"な"]],"text":"誉を愚かな者に与えるのは、石を石投げにつなぐようだ。"},{"ref":"Prov.26.9","start":20026009,"end":20026009,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"くち"],[7,2,"しんげん"],[15,1,"よ"],[18,1,"もの"],[29,1,"て"],[31,1,"ふ"],[33,1,"あ"]],"text":"愚かな者の口に箴言があるのは、酔った者が、とげのあるつえを手で振り上げるようだ。"},{"ref":"Prov.26.10","start":20026010,"end":20026010,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"とお"],[6,1,"おろ"],[8,1,"もの"],[11,1,"よ"],[14,1,"もの"],[16,1,"やと"],[18,1,"もの"],[25,1,"ひと"],[27,1,"きず"],[31,2,"いて"]],"text":"通りがかりの愚か者や、酔った者を雇う者は、すべての人を傷つける射手のようだ。"},{"ref":"Prov.26.11","start":20026011,"end":20026011,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"いぬ"],[2,1,"かえ"],[5,1,"き"],[9,1,"は"],[12,1,"もの"],[14,1,"た"],[21,1,"おろ"],[24,1,"もの"],[28,1,"おろ"],[34,1,"かえ"]],"text":"犬が帰って来てその吐いた物を食べるように、愚かな者はその愚かさをくり返す。"},{"ref":"Prov.26.12","start":20026012,"end":20026012,"break":"line","breaks":[[19,"line"],[27,"line"]],"ruby":[[0,2,"じぶん"],[3,1,"め"],[5,1,"みずか"],[8,2,"ちえ"],[12,1,"もの"],[16,1,"ひと"],[23,1,"み"],[27,1,"かれ"],[35,1,"おろ"],[38,1,"ひと"],[40,1,"のぞ"]],"text":"自分の目に自らを知恵ある者とする人を、あなたは見るか、彼よりもかえって愚かな人に望みがある。"},{"ref":"Prov.26.13","start":20026013,"end":20026013,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"もの"],[7,1,"みち"]],"text":"なまけ者は、「道にししがいる、ちまたにししがいる」という。"},{"ref":"Prov.26.14","start":20026014,"end":20026014,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"と"],[12,1,"まわ"],[21,1,"もの"],[25,2,"ねどこ"],[28,2,"ねがえ"]],"text":"戸がちょうつがいによって回るように、なまけ者はその寝床で寝返りをする。"},{"ref":"Prov.26.15","start":20026015,"end":20026015,"break":"line","breaks":[[14,"line"]],"ruby":[[3,1,"もの"],[5,1,"て"],[7,1,"さら"],[9,1,"い"],[17,1,"くち"],[19,1,"も"]],"text":"なまけ者は手を皿に入れても、それを口に持ってゆくことをいとう。"},{"ref":"Prov.26.16","start":20026016,"end":20026016,"break":"line","breaks":[[11,"line"],[30,"line"]],"ruby":[[3,1,"もの"],[5,2,"じぶん"],[8,1,"め"],[11,1,"よ"],[13,1,"こた"],[23,1,"にん"],[25,1,"もの"],[30,1,"みずか"],[33,2,"ちえ"]],"text":"なまけ者は自分の目に、良く答えることのできる七人の者よりも、自らを知恵ありとする。"},{"ref":"Prov.26.17","start":20026017,"end":20026017,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"じぶん"],[3,2,"かんけい"],[8,1,"あらそ"],[16,1,"もの"],[19,1,"とお"],[24,1,"いぬ"],[26,1,"みみ"],[32,1,"もの"]],"text":"自分に関係のない争いにたずさわる者は、通りすぎる犬の耳をとらえる者のようだ。"},{"ref":"Prov.26.18","start":20026018,"end":20026019,"break":"line","breaks":[[8,"line"],[27,"line"],[41,"line"]],"ruby":[[0,1,"とな"],[2,1,"びと"],[4,1,"あざむ"],[15,1,"たわむ"],[24,1,"もの"],[27,1,"も"],[29,1,"ぎ"],[33,1,"や"],[38,1,"し"],[41,1,"な"],[46,2,"きちが"]],"text":"隣り人を欺いて、「わたしはただ戯れにした」という者は、燃え木または矢、または死を、投げつける気違いのようだ。"},{"ref":"Prov.26.20","start":20026020,"end":20026020,"break":"line","breaks":[[13,"line"]],"ruby":[[8,1,"ひ"],[10,1,"き"],[13,1,"ひと"],[20,1,"い"],[22,1,"もの"],[28,1,"あらそ"]],"text":"たきぎがなければ火は消え、人のよしあしを言う者がなければ争いはやむ。"},{"ref":"Prov.26.21","start":20026021,"end":20026021,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"ひ"],[4,1,"すみ"],[9,1,"ひ"],[22,1,"あらそ"],[25,1,"この"],[27,1,"ひと"],[29,1,"あらそ"],[32,1,"ひ"]],"text":"おき火に炭をつぎ、火にたきぎをくべるように、争いを好む人は争いの火をおこす。"},{"ref":"Prov.26.22","start":20026022,"end":20026022,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ひと"],[9,1,"もの"],[11,2,"ことば"],[18,2,"しょくもつ"],[25,1,"はら"],[27,1,"おく"]],"text":"人のよしあしをいう者の言葉はおいしい食物のようで、腹の奥にしみこむ。"},{"ref":"Prov.26.23","start":20026023,"end":20026023,"break":"line","breaks":[[21,"line"]],"ruby":[[15,1,"こころ"],[17,1,"わる"],[21,1,"うえ"],[29,1,"つち"],[31,1,"うつわ"]],"text":"くちびるはなめらかであっても、心の悪いのは上ぐすりをかけた土の器のようだ。"},{"ref":"Prov.26.24","start":20026024,"end":20026024,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"にく"],[2,1,"もの"],[12,1,"みずか"],[14,1,"かざ"],[21,1,"こころ"],[27,1,"いつわ"]],"text":"憎む者はくちびるをもって自ら飾るけれども、心のうちには偽りをいだく。"},{"ref":"Prov.26.25","start":20026025,"end":20026025,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かれ"],[2,1,"こえ"],[9,1,"かた"],[14,1,"しん"],[25,1,"こころ"],[30,1,"にく"]],"text":"彼が声をやわらげて語っても、信じてはならない。その心に七つの憎むべきものがあるからだ。"},{"ref":"Prov.26.26","start":20026026,"end":20026026,"break":"line","breaks":[[21,"line"]],"ruby":[[3,1,"いつわ"],[11,1,"にく"],[21,1,"かれ"],[23,1,"あく"],[25,2,"かいしゅう"],[28,1,"なか"],[30,1,"あらわ"]],"text":"たとい偽りをもってその憎しみをかくしても、彼の悪は会衆の中に現れる。"},{"ref":"Prov.26.27","start":20026027,"end":20026027,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"あな"],[2,1,"ほ"],[4,1,"もの"],[6,1,"みずか"],[10,1,"なか"],[12,1,"おちい"],[15,1,"いし"],[24,1,"もの"],[26,1,"うえ"],[31,1,"いし"]],"text":"穴を掘る者は自らその中に陥る、石をまろばしあげる者の上に、その石はまろびかえる。"},{"ref":"Prov.26.28","start":20026028,"end":20026028,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"いつわ"],[3,1,"した"],[5,2,"じぶん"],[8,1,"きず"],[12,1,"もの"],[14,1,"にく"],[21,1,"くち"],[23,1,"ほろ"]],"text":"偽りの舌は自分が傷つけた者を憎み、へつらう口は滅びをきたらせる。"}]