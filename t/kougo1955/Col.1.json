[{"ref":"Col.1.1","start":51001001,"end":51001001,"break":"paragraph","ruby":[[0,1,"かみ"],[2,2,"みむね"],[16,2,"しと"],[22,2,"きょうだい"]],"text":"神の御旨によるキリスト・イエスの使徒パウロと兄弟テモテから、"},{"ref":"Col.1.2","start":51001002,"end":51001002,"break":"none","breaks":[[29,"paragraph"]],"ruby":[[15,2,"せいと"],[20,2,"ちゅうじつ"],[23,2,"きょうだい"],[35,1,"ちち"],[38,1,"かみ"],[42,1,"めぐ"],[45,2,"へいあん"]],"text":"コロサイにいる、キリストにある聖徒たち、忠実な兄弟たちへ。わたしたちの父なる神から、恵みと平安とが、あなたがたにあるように。"},{"ref":"Col.1.3","start":51001003,"end":51001003,"break":"paragraph","ruby":[[19,1,"いの"],[28,1,"しゅ"],[38,1,"ちち"],[41,1,"かみ"],[43,2,"かんしゃ"]],"text":"わたしたちは、いつもあなたがたのために祈り、わたしたちの主イエス・キリストの父なる神に感謝している。"},{"ref":"Col.1.4","start":51001004,"end":51001004,"break":"none","ruby":[[13,1,"たい"],[22,2,"しんこう"],[30,2,"せいと"],[33,1,"たい"],[48,1,"あい"],[52,1,"みみ"]],"text":"これは、キリスト・イエスに対するあなたがたの信仰と、すべての聖徒に対していだいているあなたがたの愛とを、耳にしたからである。"},{"ref":"Col.1.5","start":51001005,"end":51001005,"break":"none","ruby":[[2,1,"あい"],[14,1,"てん"],[25,1,"のぞ"],[28,1,"もとづ"],[38,1,"のぞ"],[67,1,"つた"],[72,2,"ふくいん"],[75,2,"しんり"],[78,2,"ことば"],[84,1,"き"]],"text":"この愛は、あなたがたのために天にたくわえられている望みに基くものであり、その望みについては、あなたがたはすでに、あなたがたのところまで伝えられた福音の真理の言葉によって聞いている。"},{"ref":"Col.1.6","start":51001006,"end":51001006,"break":"none","ruby":[[6,2,"ふくいん"],[10,3,"せかいじゅう"],[16,1,"ところ"],[42,1,"き"],[45,1,"かみ"],[47,1,"めぐ"],[50,1,"し"],[55,2,"いらい"],[58,1,"み"],[60,1,"むす"],[63,2,"せいちょう"]],"text":"そして、この福音は、世界中いたる所でそうであるように、あなたがたのところでも、これを聞いて神の恵みを知ったとき以来、実を結んで成長しているのである。"},{"ref":"Col.1.7","start":51001007,"end":51001007,"break":"none","ruby":[[8,2,"ふくいん"],[18,1,"おな"],[20,1,"しもべ"],[25,1,"あい"],[35,1,"まな"],[44,1,"かれ"],[60,2,"ちゅうじつ"],[63,3,"ほうししゃ"]],"text":"あなたがたはこの福音を、わたしたちと同じ僕である、愛するエペフラスから学んだのであった。彼はあなたがたのためのキリストの忠実な奉仕者であって、"},{"ref":"Col.1.8","start":51001008,"end":51001008,"break":"none","ruby":[[6,2,"みたま"],[18,1,"あい"],[27,1,"し"]],"text":"あなたがたが御霊によっていだいている愛を、わたしたちに知らせてくれたのである。"},{"ref":"Col.1.9","start":51001009,"end":51001009,"break":"paragraph","ruby":[[12,1,"こと"],[14,1,"みみ"],[18,2,"いらい"],[27,1,"た"],[39,1,"いの"],[41,1,"もと"],[59,2,"れいてき"],[62,2,"ちえ"],[65,3,"りかいりょく"],[74,1,"かみ"],[76,2,"みむね"],[79,1,"ふか"],[81,1,"し"]],"text":"そういうわけで、これらの事を耳にして以来、わたしたちも絶えずあなたがたのために祈り求めているのは、あなたがたがあらゆる霊的な知恵と理解力とをもって、神の御旨を深く知り、"},{"ref":"Col.1.10","start":51001010,"end":51001010,"break":"none","ruby":[[0,1,"しゅ"],[11,2,"せいかつ"],[16,1,"しん"],[18,1,"しゅ"],[20,1,"よろこ"],[28,1,"よ"],[33,1,"おこな"],[36,1,"み"],[38,1,"むす"],[41,1,"かみ"],[43,1,"し"],[45,2,"ちしき"],[52,1,"ま"],[54,1,"くわ"],[58,1,"いた"]],"text":"主のみこころにかなった生活をして真に主を喜ばせ、あらゆる良いわざを行って実を結び、神を知る知識をいよいよ増し加えるに至ることである。"},{"ref":"Col.1.11","start":51001011,"end":51001011,"break":"none","ruby":[[0,1,"さら"],[4,1,"いの"],[16,1,"かみ"],[18,2,"えいこう"],[21,1,"いきお"],[29,1,"たま"],[36,1,"ちから"],[41,1,"つよ"],[46,2,"なにごと"],[49,1,"よろこ"],[52,1,"た"],[56,1,"しの"]],"text":"更にまた祈るのは、あなたがたが、神の栄光の勢いにしたがって賜わるすべての力によって強くされ、何事も喜んで耐えかつ忍び、"},{"ref":"Col.1.12","start":51001012,"end":51001012,"break":"none","ruby":[[0,1,"ひかり"],[7,2,"せいと"],[12,2,"とっけん"],[20,1,"た"],[22,1,"もの"],[28,1,"くだ"],[32,1,"ちち"],[35,1,"かみ"],[38,2,"かんしゃ"]],"text":"光のうちにある聖徒たちの特権にあずかるに足る者とならせて下さった父なる神に、感謝することである。"},{"ref":"Col.1.13","start":51001013,"end":51001013,"break":"none","ruby":[[0,1,"かみ"],[12,1,"ちから"],[15,1,"すく"],[17,1,"だ"],[23,1,"あい"],[26,2,"みこ"],[29,3,"しはいか"],[33,1,"うつ"],[36,1,"くだ"]],"text":"神は、わたしたちをやみの力から救い出して、その愛する御子の支配下に移して下さった。"},{"ref":"Col.1.14","start":51001014,"end":51001014,"break":"none","ruby":[[9,2,"みこ"],[25,1,"つみ"],[31,1,"う"]],"text":"わたしたちは、この御子によってあがない、すなわち、罪のゆるしを受けているのである。"},{"ref":"Col.1.15","start":51001015,"end":51001015,"break":"paragraph","ruby":[[0,2,"みこ"],[4,1,"み"],[8,1,"かみ"],[22,1,"つく"],[29,1,"さき"],[33,1,"うま"]],"text":"御子は、見えない神のかたちであって、すべての造られたものに先だって生れたかたである。"},{"ref":"Col.1.16","start":51001016,"end":51001016,"break":"none","ruby":[[0,2,"ばんぶつ"],[4,1,"てん"],[11,1,"ち"],[19,1,"み"],[25,1,"み"],[33,1,"くらい"],[35,2,"しゅけん"],[39,2,"しはい"],[42,2,"けんい"],[48,2,"みこ"],[54,1,"つく"],[76,2,"みこ"],[82,1,"つく"],[86,2,"みこ"],[92,1,"つく"]],"text":"万物は、天にあるものも地にあるものも、見えるものも見えないものも、位も主権も、支配も権威も、みな御子にあって造られたからである。これらいっさいのものは、御子によって造られ、御子のために造られたのである。"},{"ref":"Col.1.17","start":51001017,"end":51001017,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ばんぶつ"],[7,1,"さき"],[12,2,"ばんぶつ"],[15,1,"かれ"],[20,1,"な"],[22,1,"た"]],"text":"彼は万物よりも先にあり、万物は彼にあって成り立っている。"},{"ref":"Col.1.18","start":51001018,"end":51001018,"break":"none","ruby":[[3,1,"みずか"],[14,2,"きょうかい"],[24,1,"かれ"],[26,1,"はじ"],[29,1,"もの"],[34,2,"しにん"],[37,1,"なか"],[40,2,"さいしょ"],[43,1,"うま"],[57,2,"じしん"],[70,1,"だい"],[73,1,"もの"]],"text":"そして自らは、そのからだなる教会のかしらである。彼は初めの者であり、死人の中から最初に生れたかたである。それは、ご自身がすべてのことにおいて第一の者となるためである。"},{"ref":"Col.1.19","start":51001019,"end":51001019,"break":"none","ruby":[[0,1,"かみ"],[3,2,"みむね"],[10,2,"みこ"],[20,1,"み"],[25,1,"とく"],[27,1,"やど"]],"text":"神は、御旨によって、御子のうちにすべての満ちみちた徳を宿らせ、"},{"ref":"Col.1.20","start":51001020,"end":51001020,"break":"none","ruby":[[6,3,"じゅうじか"],[10,1,"ち"],[15,2,"へいわ"],[22,2,"ばんぶつ"],[30,1,"ち"],[37,1,"てん"],[51,1,"かれ"],[57,2,"じぶん"],[60,2,"わかい"],[65,1,"くだ"]],"text":"そして、その十字架の血によって平和をつくり、万物、すなわち、地にあるもの、天にあるものを、ことごとく、彼によってご自分と和解させて下さったのである。"},{"ref":"Col.1.21","start":51001021,"end":51001021,"break":"paragraph","ruby":[[11,1,"わる"],[13,1,"おこな"],[18,1,"かみ"],[21,1,"はな"],[24,1,"こころ"],[26,1,"なか"],[28,1,"かみ"],[30,2,"てきたい"]],"text":"あなたがたも、かつては悪い行いをして神から離れ、心の中で神に敵対していた。"},{"ref":"Col.1.22","start":51001022,"end":51001022,"break":"none","ruby":[[3,1,"いま"],[7,2,"みこ"],[12,1,"にく"],[23,1,"し"],[36,1,"かみ"],[38,2,"わかい"],[49,1,"せい"],[53,1,"きず"],[58,1,"せ"],[69,1,"もの"],[78,1,"た"],[82,1,"くだ"]],"text":"しかし今では、御子はその肉のからだにより、その死をとおして、あなたがたを神と和解させ、あなたがたを聖なる、傷のない、責められるところのない者として、みまえに立たせて下さったのである。"},{"ref":"Col.1.23","start":51001023,"end":51001023,"break":"none","ruby":[[25,2,"しんこう"],[38,1,"き"],[43,2,"ふくいん"],[46,1,"のぞ"],[50,1,"うつ"],[52,1,"い"],[71,2,"ふくいん"],[75,1,"てん"],[77,1,"した"],[85,1,"つく"],[92,1,"たい"],[95,1,"の"],[97,1,"つた"],[118,2,"ほうし"]],"text":"ただし、あなたがたは、ゆるぐことがなく、しっかりと信仰にふみとどまり、すでに聞いている福音の望みから移り行くことのないようにすべきである。この福音は、天の下にあるすべての造られたものに対して宣べ伝えられたものであって、それにこのパウロが奉仕しているのである。"},{"ref":"Col.1.24","start":51001024,"end":51001024,"break":"paragraph","ruby":[[0,1,"いま"],[15,2,"くなん"],[18,1,"よろこ"],[21,1,"う"],[37,2,"きょうかい"],[49,1,"くる"],[55,1,"た"],[68,2,"にくたい"],[74,1,"おぎな"]],"text":"今わたしは、あなたがたのための苦難を喜んで受けており、キリストのからだなる教会のために、キリストの苦しみのなお足りないところを、わたしの肉体をもって補っている。"},{"ref":"Col.1.25","start":51001025,"end":51001025,"break":"none","ruby":[[5,1,"かみ"],[7,1,"ことば"],[9,1,"つ"],[15,1,"つとめ"],[27,1,"かみ"],[30,1,"あた"],[44,2,"きょうかい"],[47,2,"ほうし"],[51,1,"もの"]],"text":"わたしは、神の言を告げひろめる務を、あなたがたのために神から与えられているが、そのために教会に奉仕する者になっているのである。"},{"ref":"Col.1.26","start":51001026,"end":51001026,"break":"none","ruby":[[2,1,"ことば"],[4,2,"おくぎ"],[8,2,"よよ"],[17,1,"よ"],[20,1,"かく"],[28,1,"いま"],[30,1,"かみ"],[32,2,"せいと"],[37,1,"あき"]],"text":"その言の奥義は、代々にわたってこの世から隠されていたが、今や神の聖徒たちに明らかにされたのである。"},{"ref":"Col.1.27","start":51001027,"end":51001027,"break":"none","ruby":[[0,1,"かみ"],[2,1,"かれ"],[6,3,"いほうじん"],[10,1,"う"],[16,2,"おくぎ"],[23,2,"えいこう"],[26,1,"と"],[37,1,"し"],[53,2,"おくぎ"],[77,2,"えいこう"],[80,1,"のぞ"]],"text":"神は彼らに、異邦人の受くべきこの奥義が、いかに栄光に富んだものであるかを、知らせようとされたのである。この奥義は、あなたがたのうちにいますキリストであり、栄光の望みである。"},{"ref":"Col.1.28","start":51001028,"end":51001028,"break":"none","ruby":[[13,1,"の"],[15,1,"つた"],[18,2,"ちえ"],[29,1,"ひと"],[31,2,"くんかい"],[42,1,"ひと"],[44,1,"おし"],[54,1,"かれ"],[65,1,"まった"],[67,1,"もの"],[71,1,"た"]],"text":"わたしたちはこのキリストを宣べ伝え、知恵をつくしてすべての人を訓戒し、また、すべての人を教えている。それは、彼らがキリストにあって全き者として立つようになるためである。"},{"ref":"Col.1.29","start":51001029,"end":51001029,"break":"none","ruby":[[17,2,"ちからづよ"],[20,1,"はたら"],[30,1,"ちから"],[35,2,"くとう"],[41,2,"どりょく"]],"text":"わたしはこのために、わたしのうちに力強く働いておられるかたの力により、苦闘しながら努力しているのである。"}]