[{"ref":"Gen.29.1","start":1029001,"end":1029001,"break":"paragraph","ruby":[[6,1,"たび"],[8,1,"つづ"],[11,1,"ひがし"],[13,1,"たみ"],[15,1,"ち"],[17,1,"い"]],"text":"ヤコブはその旅を続けて東の民の地へ行った。"},{"ref":"Gen.29.2","start":1029002,"end":1029002,"break":"none","ruby":[[0,1,"み"],[3,1,"の"],[8,2,"いど"],[22,1,"ひつじ"],[27,1,"む"],[30,1,"ふ"],[36,2,"ひとびと"],[41,2,"いど"],[45,1,"む"],[48,1,"みず"],[50,1,"の"],[61,2,"いど"],[64,1,"くち"],[67,1,"おお"],[70,1,"いし"]],"text":"見ると野に一つの井戸があって、そのかたわらに羊の三つの群れが伏していた。人々はその井戸から群れに水を飲ませるのであったが、井戸の口には大きな石があった。"},{"ref":"Gen.29.3","start":1029003,"end":1029003,"break":"none","ruby":[[0,1,"む"],[3,1,"みな"],[7,1,"あつ"],[12,2,"ひとびと"],[15,2,"いど"],[18,1,"くち"],[21,1,"いし"],[28,1,"ひつじ"],[30,1,"みず"],[32,1,"の"],[38,1,"いし"],[42,2,"いど"],[45,1,"くち"],[47,1,"もと"],[53,1,"かえ"]],"text":"群れが皆そこに集まると、人々は井戸の口から石をころがして羊に水を飲ませ、その石をまた井戸の口の元のところに返しておくのである。"},{"ref":"Gen.29.4","start":1029004,"end":1029004,"break":"paragraph","ruby":[[4,2,"ひとびと"],[7,1,"い"],[12,2,"きょうだい"],[38,1,"かれ"],[41,1,"い"]],"text":"ヤコブは人々に言った、「兄弟たちよ、あなたがたはどこからこられたのですか」。彼らは言った、「わたしたちはハランからです」。"},{"ref":"Gen.29.5","start":1029005,"end":1029005,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[22,1,"こ"],[27,1,"し"],[36,1,"かれ"],[39,1,"い"],[44,1,"し"]],"text":"ヤコブは彼らに言った、「あなたがたはナホルの子ラバンを知っていますか」。彼らは言った、「知っています」。"},{"ref":"Gen.29.6","start":1029006,"end":1029006,"break":"none","ruby":[[6,1,"かれ"],[9,1,"い"],[14,1,"かれ"],[16,2,"ぶじ"],[23,1,"かれ"],[26,1,"い"],[31,2,"ぶじ"],[36,2,"ごらん"],[42,1,"かれ"],[44,1,"むすめ"],[51,1,"ひつじ"],[53,2,"いっしょ"]],"text":"ヤコブはまた彼らに言った、「彼は無事ですか」。彼らは言った、「無事です。御覧なさい。彼の娘ラケルはいま羊と一緒にここへきます」。"},{"ref":"Gen.29.7","start":1029007,"end":1029007,"break":"none","ruby":[[4,1,"い"],[9,1,"ひ"],[13,1,"たか"],[17,2,"かちく"],[20,1,"あつ"],[23,1,"とき"],[35,1,"ひつじ"],[37,1,"みず"],[39,1,"の"],[48,1,"い"],[51,1,"か"]],"text":"ヤコブは言った、「日はまだ高いし、家畜を集める時でもない。あなたがたは羊に水を飲ませてから、また行って飼いなさい」。"},{"ref":"Gen.29.8","start":1029008,"end":1029008,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[25,1,"む"],[30,1,"あつ"],[34,1,"うえ"],[37,2,"いど"],[40,1,"くち"],[43,1,"いし"],[54,1,"ひつじ"],[56,1,"みず"],[58,1,"の"]],"text":"彼らは言った、「わたしたちはそれはできないのです。群れがみな集まった上で、井戸の口から石をころがし、それから羊に水を飲ませるのです」。"},{"ref":"Gen.29.9","start":1029009,"end":1029009,"break":"paragraph","ruby":[[6,1,"かれ"],[9,1,"かた"],[14,1,"とき"],[21,1,"ちち"],[23,1,"ひつじ"],[25,2,"いっしょ"],[31,2,"かのじょ"],[34,1,"ひつじ"],[36,1,"か"]],"text":"ヤコブがなお彼らと語っている時に、ラケルは父の羊と一緒にきた。彼女は羊を飼っていたからである。"},{"ref":"Gen.29.10","start":1029010,"end":1029010,"break":"none","ruby":[[4,1,"はは"],[6,1,"あに"],[11,1,"むすめ"],[16,1,"はは"],[18,1,"あに"],[23,1,"ひつじ"],[26,1,"み"],[36,1,"すす"],[38,1,"よ"],[41,2,"いど"],[44,1,"くち"],[47,1,"いし"],[54,1,"はは"],[56,1,"あに"],[61,1,"ひつじ"],[63,1,"みず"],[65,1,"の"]],"text":"ヤコブは母の兄ラバンの娘ラケルと母の兄ラバンの羊とを見た。そしてヤコブは進み寄って井戸の口から石をころがし、母の兄ラバンの羊に水を飲ませた。"},{"ref":"Gen.29.11","start":1029011,"end":1029011,"break":"none","ruby":[[8,1,"くち"],[13,1,"こえ"],[18,1,"な"]],"text":"ヤコブはラケルに口づけし、声をあげて泣いた。"},{"ref":"Gen.29.12","start":1029012,"end":1029012,"break":"none","ruby":[[9,2,"じぶん"],[16,1,"ちち"],[28,1,"こ"],[35,1,"つ"],[41,2,"かのじょ"],[44,1,"はし"],[47,1,"い"],[50,1,"ちち"],[52,1,"はな"]],"text":"ヤコブはラケルに、自分がラケルの父のおいであり、リベカの子であることを告げたので、彼女は走って行って父に話した。"},{"ref":"Gen.29.13","start":1029013,"end":1029013,"break":"paragraph","ruby":[[4,1,"いもうと"],[6,1,"こ"],[16,1,"し"],[20,1,"き"],[26,1,"はし"],[29,1,"い"],[36,1,"むか"],[42,1,"だ"],[45,1,"くち"],[50,1,"いえ"],[52,1,"つ"],[69,1,"こと"],[75,1,"はな"]],"text":"ラバンは妹の子ヤコブがきたという知らせを聞くとすぐ、走って行ってヤコブを迎え、これを抱いて口づけし、家に連れてきた。そこでヤコブはすべての事をラバンに話した。"},{"ref":"Gen.29.14","start":1029014,"end":1029014,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[24,2,"こつにく"],[36,1,"げつ"],[38,1,"あいだ"],[39,1,"かれ"],[41,1,"とも"]],"text":"ラバンは彼に言った、「あなたはほんとうにわたしの骨肉です」。ヤコブは一か月の間彼と共にいた。"},{"ref":"Gen.29.15","start":1029015,"end":1029015,"break":"paragraph","ruby":[[0,1,"とき"],[10,1,"い"],[43,1,"はたら"],[58,2,"ほうしゅう"],[61,1,"のぞ"],[71,1,"い"]],"text":"時にラバンはヤコブに言った、「あなたはわたしのおいだからといって、ただでわたしのために働くこともないでしょう。どんな報酬を望みますか、わたしに言ってください」。"},{"ref":"Gen.29.16","start":1029016,"end":1029016,"break":"none","ruby":[[11,1,"むすめ"],[17,1,"あね"],[19,1,"な"],[27,1,"いもうと"],[29,1,"な"]],"text":"さてラバンにはふたりの娘があった。姉の名はレアといい、妹の名はラケルといった。"},{"ref":"Gen.29.17","start":1029017,"end":1029017,"break":"none","ruby":[[3,1,"め"],[5,1,"よわ"],[15,1,"うつく"],[19,1,"あい"]],"text":"レアは目が弱かったが、ラケルは美しくて愛らしかった。"},{"ref":"Gen.29.18","start":1029018,"end":1029018,"break":"none","ruby":[[8,1,"あい"],[24,1,"いもうと"],[25,1,"むすめ"],[34,1,"ねん"],[39,1,"つか"],[47,1,"い"]],"text":"ヤコブはラケルを愛したので、「わたしは、あなたの妹娘ラケルのために七年あなたに仕えましょう」と言った。"},{"ref":"Gen.29.19","start":1029019,"end":1029019,"break":"none","ruby":[[4,1,"い"],[9,2,"かのじょ"],[12,2,"たにん"],[26,1,"ほう"],[35,2,"いっしょ"]],"text":"ラバンは言った、「彼女を他人にやるよりもあなたにやる方がよい。わたしと一緒にいなさい」。"},{"ref":"Gen.29.20","start":1029020,"end":1029020,"break":"none","ruby":[[10,1,"ねん"],[12,1,"あいだ"],[20,1,"はたら"],[25,2,"かのじょ"],[28,1,"あい"],[36,2,"すうじつ"],[42,1,"おも"]],"text":"こうして、ヤコブは七年の間ラケルのために働いたが、彼女を愛したので、ただ数日のように思われた。"},{"ref":"Gen.29.21","start":1029021,"end":1029021,"break":"paragraph","ruby":[[8,1,"い"],[13,2,"きじつ"],[16,1,"み"],[26,1,"つま"],[28,1,"あた"],[32,1,"つま"],[34,1,"ところ"]],"text":"ヤコブはラバンに言った、「期日が満ちたから、わたしの妻を与えて、妻の所にはいらせてください」。"},{"ref":"Gen.29.22","start":1029022,"end":1029022,"break":"none","ruby":[[9,1,"ところ"],[11,2,"ひとびと"],[16,1,"あつ"],[25,1,"もう"]],"text":"そこでラバンはその所の人々をみな集めて、ふるまいを設けた。"},{"ref":"Gen.29.23","start":1029023,"end":1029023,"break":"none","ruby":[[0,2,"ゆうぐれ"],[9,1,"むすめ"],[20,1,"つ"],[32,2,"かのじょ"],[35,1,"ところ"]],"text":"夕暮となったとき、娘レアをヤコブのもとに連れてきたので、ヤコブは彼女の所にはいった。"},{"ref":"Gen.29.24","start":1029024,"end":1029024,"break":"none","ruby":[[6,2,"じぶん"],[17,1,"むすめ"],[28,1,"あた"]],"text":"ラバンはまた自分のつかえめジルパを娘レアにつかえめとして与えた。"},{"ref":"Gen.29.25","start":1029025,"end":1029025,"break":"none","ruby":[[0,1,"あさ"],[6,1,"み"],[30,1,"い"],[46,1,"こと"],[71,1,"はたら"],[96,1,"あざむ"]],"text":"朝になって、見ると、それはレアであったので、ヤコブはラバンに言った、「あなたはどうしてこんな事をわたしにされたのですか。わたしはラケルのために働いたのではありませんか。どうしてあなたはわたしを欺いたのですか」。"},{"ref":"Gen.29.26","start":1029026,"end":1029026,"break":"none","ruby":[[4,1,"い"],[9,1,"いもうと"],[11,1,"あね"],[14,1,"さき"],[21,1,"こと"],[28,1,"くに"]],"text":"ラバンは言った、「妹を姉より先にとつがせる事はわれわれの国ではしません。"},{"ref":"Gen.29.27","start":1029027,"end":1029027,"break":"none","ruby":[[4,1,"むすめ"],[10,1,"しゅう"],[11,1,"かん"],[13,1,"す"],[27,1,"むすめ"],[47,1,"さら"],[50,1,"ねん"],[55,1,"つか"]],"text":"まずこの娘のために一週間を過ごしなさい。そうすればあの娘もあなたにあげよう。あなたは、そのため更に七年わたしに仕えなければならない」。"},{"ref":"Gen.29.28","start":1029028,"end":1029028,"break":"none","ruby":[[16,1,"しゅう"],[17,1,"かん"],[19,1,"おわ"],[29,1,"むすめ"],[35,1,"つま"],[39,1,"かれ"],[41,1,"あた"]],"text":"ヤコブはそのとおりにして、その一週間が終ったので、ラバンは娘ラケルをも妻として彼に与えた。"},{"ref":"Gen.29.29","start":1029029,"end":1029029,"break":"none","ruby":[[6,2,"じぶん"],[17,1,"むすめ"],[29,1,"あた"]],"text":"ラバンはまた自分のつかえめビルハを娘ラケルにつかえめとして与えた。"},{"ref":"Gen.29.30","start":1029030,"end":1029030,"break":"none","ruby":[[10,1,"ところ"],[17,1,"かれ"],[28,1,"あい"],[32,1,"さら"],[35,1,"ねん"],[40,1,"つか"]],"text":"ヤコブはまたラケルの所にはいった。彼はレアよりもラケルを愛して、更に七年ラバンに仕えた。"},{"ref":"Gen.29.31","start":1029031,"end":1029031,"break":"paragraph","ruby":[[0,1,"しゅ"],[12,1,"み"],[17,1,"たい"],[19,1,"ひら"]],"text":"主はレアがきらわれるのを見て、その胎を開かれたが、ラケルは、みごもらなかった。"},{"ref":"Gen.29.32","start":1029032,"end":1029032,"break":"none","ruby":[[9,1,"こ"],[11,1,"う"],[14,1,"な"],[20,1,"な"],[25,1,"い"],[30,1,"しゅ"],[36,1,"なや"],[39,1,"かえり"],[47,1,"いま"],[49,1,"おっと"],[55,1,"あい"]],"text":"レアは、みごもって子を産み、名をルベンと名づけて、言った、「主がわたしの悩みを顧みられたから、今は夫もわたしを愛するだろう」。"},{"ref":"Gen.29.33","start":1029033,"end":1029033,"break":"none","ruby":[[0,2,"かのじょ"],[11,1,"こ"],[13,1,"う"],[17,1,"しゅ"],[23,1,"きら"],[30,1,"き"],[43,1,"こ"],[46,1,"たま"],[52,1,"い"],[56,1,"な"],[63,1,"な"]],"text":"彼女はまた、みごもって子を産み、「主はわたしが嫌われるのをお聞きになって、わたしにこの子をも賜わった」と言って、名をシメオンと名づけた。"},{"ref":"Gen.29.34","start":1029034,"end":1029034,"break":"none","ruby":[[0,2,"かのじょ"],[11,1,"こ"],[13,1,"う"],[21,1,"かれ"],[24,1,"にん"],[26,1,"こ"],[28,1,"う"],[40,1,"おっと"],[46,1,"した"],[54,1,"い"],[58,1,"な"],[63,1,"な"]],"text":"彼女はまた、みごもって子を産み、「わたしは彼に三人の子を産んだから、こんどこそは夫もわたしに親しむだろう」と言って、名をレビと名づけた。"},{"ref":"Gen.29.35","start":1029035,"end":1029035,"break":"none","ruby":[[0,2,"かのじょ"],[11,1,"こ"],[13,1,"う"],[21,1,"いま"],[23,1,"しゅ"],[33,1,"い"],[36,1,"な"],[41,1,"な"],[49,2,"かのじょ"],[53,1,"こ"],[55,1,"う"]],"text":"彼女はまた、みごもって子を産み、「わたしは今、主をほめたたえる」と言って名をユダと名づけた。そこで彼女の、子を産むことはやんだ。"}]