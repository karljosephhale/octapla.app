[{"ref":"1Sam.1.1","start":9001001,"end":9001001,"break":"paragraph","ruby":[[6,2,"さんち"],[27,1,"な"],[29,1,"ひと"],[49,1,"こ"],[64,1,"こ"],[73,1,"こ"],[81,1,"こ"]],"text":"エフライムの山地のラマタイム・ゾピムに、エルカナという名の人があった。エフライムびとで、エロハムの子であった。エロハムはエリウの子、エリウはトフの子、トフはツフの子である。"},{"ref":"1Sam.1.2","start":9001002,"end":9001002,"break":"none","ruby":[[11,1,"つま"],[21,1,"な"],[34,1,"な"],[51,1,"こ"],[65,1,"こ"]],"text":"エルカナには、ふたりの妻があって、ひとりの名はハンナといい、ひとりの名はペニンナといった。ペニンナには子どもがあったが、ハンナには子どもがなかった。"},{"ref":"1Sam.1.3","start":9001003,"end":9001003,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"とし"],[11,1,"まち"],[17,1,"のぼ"],[24,2,"ばんぐん"],[27,1,"しゅ"],[29,1,"はい"],[32,1,"しゅ"],[34,2,"ぎせい"],[43,1,"つね"],[60,1,"こ"],[75,1,"しゅ"],[77,1,"つか"],[80,2,"さいし"]],"text":"この人は年ごとに、その町からシロに上っていって、万軍の主を拝し、主に犠牲をささげるのを常とした。シロには、エリのふたりの子、ホフニとピネハスとがいて、主に仕える祭司であった。"},{"ref":"1Sam.1.4","start":9001004,"end":9001004,"break":"none","ruby":[[6,2,"ぎせい"],[13,1,"ひ"],[15,1,"つま"],[26,1,"むすめ"],[34,1,"わ"],[36,1,"まえ"],[38,1,"あた"]],"text":"エルカナは、犠牲をささげる日、妻ペニンナとそのむすこ娘にはみな、その分け前を与えた。"},{"ref":"1Sam.1.5","start":9001005,"end":9001005,"break":"none","ruby":[[9,1,"あい"],[16,2,"かのじょ"],[26,1,"わ"],[28,1,"まえ"],[30,1,"あた"],[40,1,"しゅ"],[44,1,"たい"],[46,1,"と"]],"text":"エルカナはハンナを愛していたが、彼女には、ただ一つの分け前を与えるだけであった。主がその胎を閉ざされたからである。"},{"ref":"1Sam.1.6","start":9001006,"end":9001006,"break":"none","ruby":[[2,2,"かのじょ"],[5,1,"にく"],[10,1,"た"],[12,1,"つま"],[18,2,"かのじょ"],[21,1,"なや"],[26,1,"しゅ"],[30,1,"たい"],[32,1,"と"],[40,1,"うら"]],"text":"また彼女を憎んでいる他の妻は、ひどく彼女を悩まして、主がその胎を閉ざされたことを恨ませようとした。"},{"ref":"1Sam.1.7","start":9001007,"end":9001007,"break":"none","ruby":[[4,1,"とし"],[6,1,"く"],[9,1,"とし"],[11,1,"あ"],[20,1,"しゅ"],[22,1,"みや"],[24,1,"のぼ"],[35,2,"かのじょ"],[38,1,"なや"],[49,1,"な"],[52,1,"た"]],"text":"こうして年は暮れ、年は明けたが、ハンナが主の宮に上るごとに、ペニンナは彼女を悩ましたので、ハンナは泣いて食べることもしなかった。"},{"ref":"1Sam.1.8","start":9001008,"end":9001008,"break":"none","ruby":[[0,1,"おっと"],[6,2,"かのじょ"],[9,1,"い"],[21,1,"な"],[28,1,"た"],[39,1,"こころ"],[41,1,"かな"],[59,1,"にん"],[61,1,"こ"]],"text":"夫エルカナは彼女に言った、「ハンナよ、なぜ泣くのか。なぜ食べないのか。どうして心に悲しむのか。わたしはあなたにとって十人の子どもよりもまさっているではないか」。"},{"ref":"1Sam.1.9","start":9001009,"end":9001009,"break":"paragraph","ruby":[[3,1,"かれ"],[6,1,"の"],[8,1,"く"],[19,1,"た"],[28,1,"とき"],[30,2,"さいし"],[35,1,"しゅ"],[37,2,"しんでん"],[40,1,"はしら"],[47,1,"ざ"]],"text":"シロで彼らが飲み食いしたのち、ハンナは立ちあがった。その時、祭司エリは主の神殿の柱のかたわらの座にすわっていた。"},{"ref":"1Sam.1.10","start":9001010,"end":9001010,"break":"none","ruby":[[4,1,"こころ"],[6,1,"ふか"],[8,1,"かな"],[12,1,"しゅ"],[14,1,"いの"],[22,1,"な"]],"text":"ハンナは心に深く悲しみ、主に祈って、はげしく泣いた。"},{"ref":"1Sam.1.11","start":9001011,"end":9001011,"break":"none","ruby":[[3,1,"ちか"],[6,1,"た"],[9,1,"い"],[14,2,"ばんぐん"],[17,1,"しゅ"],[30,1,"なや"],[42,1,"おぼ"],[50,1,"わす"],[60,1,"おとこ"],[62,1,"こ"],[64,1,"たま"],[78,1,"こ"],[80,2,"いっしょう"],[86,1,"しゅ"],[99,1,"あたま"]],"text":"そして誓いを立てて言った、「万軍の主よ、まことに、はしための悩みをかえりみ、わたしを覚え、はしためを忘れずに、はしために男の子を賜わりますなら、わたしはその子を一生のあいだ主にささげ、かみそりをその頭にあてません」。"},{"ref":"1Sam.1.12","start":9001012,"end":9001012,"break":"paragraph","ruby":[[0,2,"かのじょ"],[3,1,"しゅ"],[5,1,"まえ"],[7,1,"なが"],[9,1,"いの"],[20,2,"かのじょ"],[23,1,"くち"],[25,1,"め"]],"text":"彼女が主の前で長く祈っていたので、エリは彼女の口に目をとめた。"},{"ref":"1Sam.1.13","start":9001013,"end":9001013,"break":"none","ruby":[[4,1,"こころ"],[9,1,"もの"],[11,1,"い"],[24,1,"うご"],[30,1,"こえ"],[32,1,"きこ"],[47,1,"よ"],[55,1,"おも"]],"text":"ハンナは心のうちで物を言っていたので、くちびるが動くだけで、声は聞えなかった。それゆえエリは、酔っているのだと思って、"},{"ref":"1Sam.1.14","start":9001014,"end":9001014,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"い"],[12,1,"よ"],[20,1,"よ"]],"text":"彼女に言った、「いつまで酔っているのか。酔いをさましなさい」。"},{"ref":"1Sam.1.15","start":9001015,"end":9001015,"break":"none","ruby":[[7,1,"こた"],[18,1,"しゅ"],[25,2,"ふこう"],[28,1,"おんな"],[35,1,"しゅ"],[37,1,"こ"],[39,1,"さけ"],[41,1,"の"],[55,1,"しゅ"],[57,1,"まえ"],[59,1,"こころ"],[61,1,"そそ"],[63,1,"だ"]],"text":"しかしハンナは答えた、「いいえ、わが主よ。わたしは不幸な女です。ぶどう酒も濃い酒も飲んだのではありません。ただ主の前に心を注ぎ出していたのです。"},{"ref":"1Sam.1.16","start":9001016,"end":9001016,"break":"none","ruby":[[6,1,"わる"],[8,1,"おんな"],[10,1,"おも"],[20,1,"つも"],[22,1,"うれ"],[25,1,"なや"],[36,1,"いま"],[39,1,"もの"],[41,1,"い"]],"text":"はしためを、悪い女と思わないでください。積る憂いと悩みのゆえに、わたしは今まで物を言っていたのです」。"},{"ref":"1Sam.1.17","start":9001017,"end":9001017,"break":"none","ruby":[[6,1,"こた"],[11,2,"あんしん"],[15,1,"い"],[30,1,"かみ"],[36,1,"もと"],[39,1,"ねが"],[42,1,"き"]],"text":"そこでエリは答えた、「安心して行きなさい。どうかイスラエルの神があなたの求める願いを聞きとどけられるように」。"},{"ref":"1Sam.1.18","start":9001018,"end":9001018,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"い"],[23,1,"まえ"],[25,1,"めぐ"],[28,1,"え"],[45,1,"おんな"],[47,1,"さ"],[50,2,"しょくじ"],[56,1,"かお"],[62,1,"かな"]],"text":"彼女は言った、「どうぞ、はしためにも、あなたの前に恵みを得させてください」。こうして、その女は去って食事し、その顔は、もはや悲しげではなくなった。"},{"ref":"1Sam.1.19","start":9001019,"end":9001019,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"あさ"],[4,1,"はや"],[6,1,"お"],[10,1,"しゅ"],[12,1,"まえ"],[14,2,"れいはい"],[27,1,"いえ"],[29,1,"かえ"],[32,1,"い"],[41,1,"つま"],[46,1,"し"],[49,1,"しゅ"],[51,2,"かのじょ"],[54,1,"かえり"]],"text":"彼らは朝早く起きて、主の前に礼拝し、そして、ラマにある家に帰って行った。エルカナは妻ハンナを知り、主が彼女を顧みられたので、"},{"ref":"1Sam.1.20","start":9001020,"end":9001020,"break":"none","ruby":[[0,2,"かのじょ"],[10,1,"とき"],[12,1,"めぐ"],[18,1,"おとこ"],[20,1,"こ"],[22,1,"う"],[32,1,"こ"],[34,1,"しゅ"],[36,1,"もと"],[50,1,"な"],[57,1,"な"]],"text":"彼女はみごもり、その時が巡ってきて、男の子を産み、「わたしがこの子を主に求めたからだ」といって、その名をサムエルと名づけた。"},{"ref":"1Sam.1.21","start":9001021,"end":9001021,"break":"paragraph","ruby":[[6,1,"ひと"],[10,2,"かぞく"],[16,1,"のぼ"],[23,1,"とし"],[27,2,"ぎせい"],[31,1,"ちか"],[34,1,"そな"],[36,1,"もの"]],"text":"エルカナその人とその家族とはみな上っていって、年ごとの犠牲と、誓いの供え物とをささげた。"},{"ref":"1Sam.1.22","start":9001022,"end":9001022,"break":"none","ruby":[[7,1,"のぼ"],[10,1,"い"],[14,1,"おっと"],[16,1,"い"],[27,1,"こ"],[29,2,"ちばな"],[37,1,"しゅ"],[39,1,"まえ"],[41,1,"つ"]],"text":"しかしハンナは上って行かず、夫に言った、「わたしはこの子が乳離れしてから、主の前に連れていって、いつまでも、そこにおらせましょう」。"},{"ref":"1Sam.1.23","start":9001023,"end":9001023,"break":"none","ruby":[[0,1,"おっと"],[6,2,"かのじょ"],[9,1,"い"],[18,1,"よ"],[21,1,"おも"],[31,1,"こ"],[33,2,"ちばな"],[40,1,"ま"],[51,1,"しゅ"],[55,1,"い"],[62,2,"じつげん"],[81,1,"おんな"],[91,1,"こ"],[93,1,"ちち"],[99,2,"ちばな"],[106,1,"ま"]],"text":"夫エルカナは彼女に言った、「あなたが良いと思うようにして、この子の乳離れするまで待ちなさい。ただどうか主がその言われたことを実現してくださるように」。こうしてその女はとどまって、その子に乳をのませ、乳離れするのを待っていたが、"},{"ref":"1Sam.1.24","start":9001024,"end":9001024,"break":"none","ruby":[[0,2,"ちばな"],[5,1,"とき"],[8,1,"さい"],[10,2,"おうし"],[13,1,"とう"],[15,2,"むぎこ"],[24,1,"しゅ"],[30,1,"かわ"],[31,1,"ぶくろ"],[35,1,"と"],[40,1,"こ"],[42,1,"つ"],[51,1,"しゅ"],[53,1,"みや"],[55,1,"い"],[61,1,"こ"],[65,1,"おさな"]],"text":"乳離れした時、三歳の雄牛一頭、麦粉一エパ、ぶどう酒のはいった皮袋一つを取り、その子を連れて、シロにある主の宮に行った。その子はなお幼かった。"},{"ref":"1Sam.1.25","start":9001025,"end":9001025,"break":"none","ruby":[[3,1,"かれ"],[8,1,"うし"],[10,1,"ころ"],[13,2,"こども"],[22,1,"つ"],[25,1,"い"]],"text":"そして彼らはその牛を殺し、子供をエリのもとへ連れて行った。"},{"ref":"1Sam.1.26","start":9001026,"end":9001026,"break":"none","ruby":[[4,1,"い"],[11,1,"きみ"],[18,1,"い"],[38,1,"た"],[46,1,"まえ"],[49,1,"しゅ"],[51,1,"いの"],[54,1,"おんな"]],"text":"ハンナは言った、「わが君よ、あなたは生きておられます。わたしは、かつてここに立って、あなたの前で、主に祈った女です。"},{"ref":"1Sam.1.27","start":9001027,"end":9001027,"break":"none","ruby":[[2,1,"こ"],[4,1,"あた"],[17,1,"いの"],[24,1,"しゅ"],[30,1,"もと"],[33,1,"ねが"],[36,1,"き"]],"text":"この子を与えてくださいと、わたしは祈りましたが、主はわたしの求めた願いを聞きとどけられました。"},{"ref":"1Sam.1.28","start":9001028,"end":9001028,"break":"none","breaks":[[43,"paragraph"]],"ruby":[[11,1,"こ"],[13,1,"しゅ"],[23,1,"こ"],[25,2,"いっしょう"],[31,1,"しゅ"],[46,1,"かれ"],[52,1,"しゅ"],[54,2,"れいはい"]],"text":"それゆえ、わたしもこの子を主にささげます。この子は一生のあいだ主にささげたものです」。そして彼らはそこで主を礼拝した。"}]