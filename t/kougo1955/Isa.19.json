[{"ref":"Isa.19.1","start":23019001,"end":23019001,"break":"paragraph","breaks":[[12,"stanza"],[35,"line"],[59,"line"]],"ruby":[[9,2,"たくせん"],[12,1,"み"],[15,1,"しゅ"],[17,1,"はや"],[19,1,"くも"],[21,1,"の"],[30,1,"こ"],[45,2,"ぐうぞう"],[50,1,"まえ"],[52,1,"ふる"],[66,1,"こころ"],[68,1,"かれ"],[74,1,"と"],[76,1,"さ"]],"text":"エジプトについての託宣。見よ、主は速い雲に乗って、エジプトに来られる。エジプトのもろもろの偶像は、み前に震えおののき、エジプトびとの心は彼らのうちに溶け去る。"},{"ref":"Isa.19.2","start":23019002,"end":23019002,"break":"line","breaks":[[18,"line"],[31,"line"],[49,"line"],[60,"line"]],"ruby":[[11,1,"ふる"],[25,1,"さか"],[31,1,"かれ"],[40,2,"きょうだい"],[43,1,"てき"],[46,1,"たたか"],[55,1,"となり"],[57,1,"てき"],[60,1,"まち"],[62,1,"まち"],[64,1,"せ"],[67,1,"くに"],[69,1,"くに"],[71,1,"せ"]],"text":"わたしはエジプトびとを奮いたたせて、エジプトびとに逆らわせる。彼らはおのおのその兄弟に敵して戦い、おのおのその隣に敵し、町は町を攻め、国は国を攻める。"},{"ref":"Isa.19.3","start":23019003,"end":23019003,"break":"line","breaks":[[10,"line"],[27,"line"],[41,"line"],[53,"line"]],"ruby":[[7,1,"たましい"],[10,1,"かれ"],[33,1,"はか"],[38,1,"やぶ"],[41,1,"かれ"],[44,2,"ぐうぞう"],[49,2,"まじゅつ"],[51,1,"し"],[53,2,"みこ"],[58,3,"まほうつかい"],[62,1,"たず"],[64,1,"もと"]],"text":"エジプトびとの魂は、彼らのうちにうせて、むなしくなる。わたしはその計りごとを破る。彼らは偶像および魔術師、巫子および魔法使に尋ね求める。"},{"ref":"Isa.19.4","start":23019004,"end":23019004,"break":"line","breaks":[[23,"line"],[37,"line"]],"ruby":[[15,2,"しゅじん"],[18,1,"て"],[20,1,"わた"],[23,2,"あらあら"],[27,1,"おう"],[29,1,"かれ"],[32,1,"おさ"],[37,1,"しゅ"],[39,2,"ばんぐん"],[42,1,"しゅ"],[44,1,"い"]],"text":"わたしはエジプトびとをきびしい主人の手に渡す、荒々しい王が彼らを治めると、主、万軍の主は言われる。"},{"ref":"Isa.19.5","start":23019005,"end":23019005,"break":"paragraph","ruby":[[4,1,"みず"],[9,1,"かわ"]],"text":"ナイルの水はつき、川はかれてかわく。"},{"ref":"Isa.19.6","start":23019006,"end":23019006,"break":"line","breaks":[[16,"line"],[38,"line"]],"ruby":[[4,2,"うんが"],[7,1,"くさ"],[13,1,"はな"],[25,2,"しりゅう"],[31,1,"へ"],[38,1,"あし"],[44,1,"か"]],"text":"またその運河は臭いにおいを放ち、エジプトのナイルの支流はややに減ってかわき、葦とよしとは枯れはてる。"},{"ref":"Isa.19.7","start":23019007,"end":23019007,"break":"line","breaks":[[22,"line"],[43,"line"]],"ruby":[[12,1,"きし"],[15,1,"はだか"],[17,1,"ところ"],[33,1,"もの"],[40,1,"か"],[43,1,"ち"],[51,1,"さ"]],"text":"ナイルのほとり、ナイルの岸には裸の所があり、ナイルのほとりにまいた物はことごとく枯れ、散らされて、うせ去る。"},{"ref":"Isa.19.8","start":23019008,"end":23019008,"break":"line","breaks":[[6,"line"],[25,"line"]],"ruby":[[0,2,"ぎょふ"],[3,1,"なげ"],[19,1,"もの"],[21,1,"かな"],[25,1,"あみ"],[27,1,"みず"],[35,1,"もの"],[37,1,"おとろ"]],"text":"漁夫は嘆き、すべてナイルにつりをたれる者は悲しみ、網を水のおもてにうつ者は衰える。"},{"ref":"Isa.19.9","start":23019009,"end":23019009,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ね"],[3,1,"あさ"],[5,1,"もの"],[7,1,"つく"],[9,1,"もの"],[12,2,"しろぬの"],[15,1,"お"],[17,1,"もの"],[19,1,"は"]],"text":"練った麻で物を造る者と、白布を織る者は恥じる。"},{"ref":"Isa.19.10","start":23019010,"end":23019010,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"くに"],[2,1,"はしら"],[5,1,"もの"],[7,1,"くだ"],[14,1,"やと"],[18,1,"はたら"],[20,1,"もの"],[22,1,"なげ"],[24,1,"かな"]],"text":"国の柱たる者は砕かれ、すべて雇われて働く者は嘆き悲しむ。"},{"ref":"Isa.19.11","start":23019011,"end":23019011,"break":"line","breaks":[[16,"line"],[36,"line"],[53,"line"],[76,"line"]],"ruby":[[4,1,"きみ"],[8,1,"まった"],[10,1,"おろ"],[19,1,"かしこ"],[21,1,"ぎ"],[22,1,"かん"],[25,1,"おろ"],[28,1,"はか"],[58,1,"かしこ"],[60,1,"もの"],[62,1,"こ"],[69,1,"おう"],[71,1,"こ"],[76,1,"い"]],"text":"ゾアンの君たちは全く愚かであり、パロの賢い議官らは愚かな計りごとをなす。あなたがたはどうしてパロにむかって「わたしは賢い者の子、いにしえの王の子です」と言うことができようか。"},{"ref":"Isa.19.12","start":23019012,"end":23019012,"break":"line","breaks":[[15,"line"],[21,"line"],[42,"line"]],"ruby":[[4,1,"かしこ"],[6,1,"もの"],[15,1,"かれ"],[21,2,"ばんぐん"],[24,1,"しゅ"],[34,1,"さだ"],[46,1,"つ"],[48,1,"し"]],"text":"あなたの賢い者はどこにおるか。彼らをして、万軍の主がエジプトについて定められたことをあなたに告げ知らしめよ。"},{"ref":"Isa.19.13","start":23019013,"end":23019013,"break":"line","breaks":[[14,"line"],[27,"line"],[49,"line"]],"ruby":[[4,1,"きみ"],[8,1,"おろ"],[19,1,"きみ"],[23,1,"あざむ"],[37,2,"ぶぞく"],[40,1,"すみ"],[42,1,"いし"],[45,1,"かれ"],[58,1,"まよ"]],"text":"ゾアンの君たちは愚かとなり、メンピスの君たちは欺かれ、エジプトのもろもろの部族の隅の石たる彼らは、かえってエジプトを迷わせた。"},{"ref":"Isa.19.14","start":23019014,"end":23019014,"break":"line","breaks":[[19,"line"],[30,"line"],[44,"line"],[59,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"まが"],[5,1,"こころ"],[7,1,"かれ"],[13,1,"ま"],[19,1,"かれ"],[35,1,"おこな"],[40,1,"まよ"],[48,1,"よ"],[51,1,"ひと"],[53,1,"もの"],[54,1,"は"]],"text":"主は曲った心を彼らのうちに混ぜられた。彼らはエジプトをして、すべてその行うことに迷わせ、あたかも酔った人の物吐くときによろめくようにさせた。"},{"ref":"Isa.19.15","start":23019015,"end":23019015,"break":"line","breaks":[[17,"line"],[28,"line"]],"ruby":[[5,1,"たい"],[10,1,"あたま"],[15,1,"お"],[21,1,"えだ"],[26,1,"あし"],[28,1,"とも"]],"text":"エジプトに対しては、頭あるいは尾、しゅろの枝あるいは葦が共になしうるわざはない。"},{"ref":"Isa.19.16","start":23019016,"end":23019016,"break":"paragraph","ruby":[[2,1,"ひ"],[11,1,"おんな"],[19,2,"ばんぐん"],[22,1,"しゅ"],[24,1,"かれ"],[27,1,"うえ"],[29,1,"ふ"],[31,1,"うご"],[37,1,"て"],[39,1,"まえ"],[41,1,"おそ"]],"text":"その日、エジプトびとは女のようになり、万軍の主の彼らの上に振り動かされるみ手の前に恐れおののく。"},{"ref":"Isa.19.17","start":23019017,"end":23019017,"break":"none","ruby":[[3,1,"ち"],[13,1,"おそ"],[24,1,"かた"],[26,1,"つ"],[32,1,"き"],[44,2,"ばんぐん"],[47,1,"しゅ"],[60,1,"さだ"],[65,1,"はか"],[73,1,"おそ"]],"text":"ユダの地は、エジプトびとに恐れられ、ユダについて語り告げることを聞くエジプトびとはみな、万軍の主がエジプトびとにむかって定められた計りごとのゆえに恐れる。"},{"ref":"Isa.19.18","start":23019018,"end":23019018,"break":"paragraph","ruby":[[2,1,"ひ"],[9,1,"ち"],[15,1,"くに"],[20,1,"かた"],[25,2,"ばんぐん"],[28,1,"しゅ"],[30,1,"ちか"],[33,1,"た"],[39,1,"まち"],[46,1,"なか"],[51,2,"たいよう"],[54,1,"まち"]],"text":"その日、エジプトの地にカナンの国ことばを語り、また万軍の主に誓いを立てる五つの町があり、その中の一つは太陽の町ととなえられる。"},{"ref":"Isa.19.19","start":23019019,"end":23019019,"break":"paragraph","ruby":[[2,1,"ひ"],[9,1,"くに"],[11,1,"なか"],[13,1,"しゅ"],[21,2,"さいだん"],[29,1,"さかい"],[31,1,"しゅ"],[39,1,"はしら"]],"text":"その日、エジプトの国の中に主をまつる一つの祭壇があり、その境に主をまつる一つの柱がある。"},{"ref":"Isa.19.20","start":23019020,"end":23019020,"break":"none","ruby":[[8,1,"くに"],[10,2,"ばんぐん"],[13,1,"しゅ"],[30,1,"かれ"],[38,1,"もの"],[44,1,"しゅ"],[46,1,"さけ"],[48,1,"もと"],[54,1,"しゅ"],[56,1,"すく"],[58,1,"もの"],[66,1,"かれ"],[69,1,"まも"],[71,1,"たす"]],"text":"これはエジプトの国で万軍の主に、しるしとなり、あかしとなる。彼らがしえたげる者のゆえに、主に叫び求めるとき、主は救う者をつかわして、彼らを守り助けられる。"},{"ref":"Isa.19.21","start":23019021,"end":23019021,"break":"none","ruby":[[0,1,"しゅ"],[3,2,"じぶん"],[13,1,"し"],[22,1,"ひ"],[31,1,"しゅ"],[33,1,"し"],[36,2,"ぎせい"],[39,1,"そな"],[41,1,"もの"],[47,1,"しゅ"],[49,1,"つか"],[52,1,"しゅ"],[54,2,"せいがん"],[63,1,"はた"]],"text":"主はご自分をエジプトびとに知らせられる。その日、エジプトびとは主を知り、犠牲と供え物とをもって主に仕え、主に誓願をたててこれを果す。"},{"ref":"Isa.19.22","start":23019022,"end":23019022,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"う"],[12,1,"しゅ"],[17,1,"う"],[35,1,"かれ"],[38,1,"しゅ"],[40,1,"かえ"],[43,1,"しゅ"],[45,1,"かれ"],[48,1,"ねが"],[55,1,"かれ"]],"text":"主はエジプトを撃たれる。主はこれを撃たれるが、またいやされる。それゆえ彼らは主に帰る。主は彼らの願いをいれて、彼らをいやされる。"},{"ref":"Isa.19.23","start":23019023,"end":23019023,"break":"paragraph","ruby":[[2,1,"ひ"],[16,1,"かよ"],[18,2,"おおじ"],[52,1,"い"],[70,1,"とも"],[72,1,"しゅ"],[74,1,"つか"]],"text":"その日、エジプトからアッスリヤに通う大路があって、アッスリヤびとはエジプトに、エジプトびとはアッスリヤに行き、エジプトびとはアッスリヤびとと共に主に仕える。"},{"ref":"Isa.19.24","start":23019024,"end":23019024,"break":"paragraph","ruby":[[2,1,"ひ"],[21,1,"とも"],[25,1,"あい"],[26,1,"なら"],[29,1,"ぜん"],[30,1,"ち"],[35,2,"しゅくふく"]],"text":"その日、イスラエルはエジプトとアッスリヤと共に三つ相並び、全地のうちで祝福をうけるものとなる。"},{"ref":"Isa.19.25","start":23019025,"end":23019025,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[9,2,"しゅくふく"],[13,1,"い"],[30,1,"たみ"],[40,1,"て"],[54,1,"し"],[55,1,"ぎょう"]],"text":"万軍の主は、これを祝福して言われる、「さいわいなるかな、わが民なるエジプト、わが手のわざなるアッスリヤ、わが嗣業なるイスラエル」と。"}]