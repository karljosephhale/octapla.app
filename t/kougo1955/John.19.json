[{"ref":"John.19.1","start":43019001,"end":43019001,"break":"paragraph","ruby":[[12,1,"とら"],[18,1,"う"]],"text":"そこでピラトは、イエスを捕え、むちで打たせた。"},{"ref":"John.19.2","start":43019002,"end":43019002,"break":"none","ruby":[[0,2,"へいそつ"],[10,1,"かんむり"],[20,1,"あたま"],[27,1,"むらさき"],[29,2,"うわぎ"],[32,1,"き"]],"text":"兵卒たちは、いばらで冠をあんで、イエスの頭にかぶらせ、紫の上着を着せ、"},{"ref":"John.19.3","start":43019003,"end":43019003,"break":"none","ruby":[[7,1,"まえ"],[9,1,"すす"],[11,1,"で"],[18,1,"じん"],[20,1,"おう"],[28,1,"い"],[35,2,"ひらて"],[42,1,"う"]],"text":"それから、その前に進み出て、「ユダヤ人の王、ばんざい」と言った。そして平手でイエスを打ちつづけた。"},{"ref":"John.19.4","start":43019004,"end":43019004,"break":"none","ruby":[[10,1,"で"],[12,1,"い"],[18,1,"じん"],[22,1,"い"],[27,1,"み"],[36,1,"ひと"],[44,1,"まえ"],[46,1,"ひ"],[48,1,"だ"],[57,1,"ひと"],[62,1,"つみ"],[64,1,"み"],[80,1,"し"]],"text":"するとピラトは、また出て行ってユダヤ人たちに言った、「見よ、わたしはこの人をあなたがたの前に引き出すが、それはこの人になんの罪も見いだせないことを、あなたがたに知ってもらうためである」。"},{"ref":"John.19.5","start":43019005,"end":43019005,"break":"none","ruby":[[8,1,"かんむり"],[14,1,"むらさき"],[16,2,"うわぎ"],[19,1,"き"],[24,1,"そと"],[26,1,"で"],[36,1,"かれ"],[39,1,"い"],[44,1,"み"],[49,1,"ひと"]],"text":"イエスはいばらの冠をかぶり、紫の上着を着たままで外へ出られると、ピラトは彼らに言った、「見よ、この人だ」。"},{"ref":"John.19.6","start":43019006,"end":43019006,"break":"none","ruby":[[0,3,"さいしちょう"],[6,2,"したやく"],[15,1,"み"],[19,1,"さけ"],[23,3,"じゅうじか"],[31,3,"じゅうじか"],[40,1,"い"],[48,1,"かれ"],[51,1,"い"],[65,1,"ひと"],[67,1,"ひ"],[69,1,"と"],[72,3,"じゅうじか"],[88,1,"かれ"],[94,1,"つみ"],[96,1,"み"]],"text":"祭司長たちや下役どもはイエスを見ると、叫んで「十字架につけよ、十字架につけよ」と言った。ピラトは彼らに言った、「あなたがたが、この人を引き取って十字架につけるがよい。わたしは、彼にはなんの罪も見いだせない」。"},{"ref":"John.19.7","start":43019007,"end":43019007,"break":"none","ruby":[[3,1,"じん"],[7,1,"かれ"],[9,1,"こた"],[21,2,"りっぽう"],[31,2,"りっぽう"],[38,1,"かれ"],[40,2,"じぶん"],[43,1,"かみ"],[45,1,"こ"],[54,2,"しざい"],[57,1,"あた"],[59,1,"もの"]],"text":"ユダヤ人たちは彼に答えた、「わたしたちには律法があります。その律法によれば、彼は自分を神の子としたのだから、死罪に当る者です」。"},{"ref":"John.19.8","start":43019008,"end":43019008,"break":"none","ruby":[[6,2,"ことば"],[9,1,"き"]],"text":"ピラトがこの言葉を聞いたとき、ますますおそれ、"},{"ref":"John.19.9","start":43019009,"end":43019009,"break":"none","ruby":[[3,1,"ど"],[4,2,"かんてい"],[15,1,"い"],[51,1,"こたえ"]],"text":"もう一度官邸にはいってイエスに言った、「あなたは、もともと、どこからきたのか」。しかし、イエスはなんの答もなさらなかった。"},{"ref":"John.19.10","start":43019010,"end":43019010,"break":"none","ruby":[[7,1,"い"],[12,1,"なに"],[14,1,"こた"],[31,1,"ゆる"],[33,2,"けんい"],[41,3,"じゅうじか"],[48,2,"けんい"],[57,1,"し"]],"text":"そこでピラトは言った、「何も答えないのか。わたしには、あなたを許す権威があり、また十字架につける権威があることを、知らないのか」。"},{"ref":"John.19.11","start":43019011,"end":43019011,"break":"none","ruby":[[4,1,"こた"],[16,1,"うえ"],[19,1,"たま"],[33,1,"たい"],[39,2,"けんい"],[57,1,"ひ"],[59,1,"わた"],[62,1,"もの"],[64,1,"つみ"],[70,1,"おお"]],"text":"イエスは答えられた、「あなたは、上から賜わるのでなければ、わたしに対してなんの権威もない。だから、わたしをあなたに引き渡した者の罪は、もっと大きい」。"},{"ref":"John.19.12","start":43019012,"end":43019012,"break":"none","ruby":[[3,1,"き"],[15,1,"ゆる"],[19,1,"つと"],[29,1,"じん"],[33,1,"さけ"],[36,1,"い"],[45,1,"ひと"],[47,1,"ゆる"],[62,2,"みかた"],[72,2,"じぶん"],[75,1,"おう"],[94,1,"もの"]],"text":"これを聞いて、ピラトはイエスを許そうと努めた。しかしユダヤ人たちが叫んで言った、「もしこの人を許したなら、あなたはカイザルの味方ではありません。自分を王とするものはすべて、カイザルにそむく者です」。"},{"ref":"John.19.13","start":43019013,"end":43019013,"break":"none","ruby":[[8,2,"ことば"],[11,1,"き"],[19,1,"そと"],[21,1,"ひ"],[23,1,"だ"],[26,1,"い"],[29,2,"しきいし"],[35,1,"ご"],[45,2,"ばしょ"],[48,2,"さいばん"],[51,1,"せき"]],"text":"ピラトはこれらの言葉を聞いて、イエスを外へ引き出して行き、敷石（ヘブル語ではガバタ）という場所で裁判の席についた。"},{"ref":"John.19.14","start":43019014,"end":43019014,"break":"none","ruby":[[2,1,"ひ"],[4,2,"すぎこし"],[7,2,"じゅんび"],[10,1,"ひ"],[16,1,"とき"],[18,1,"ひる"],[22,1,"じ"],[37,1,"じん"],[40,1,"い"],[45,1,"み"],[57,1,"おう"]],"text":"その日は過越の準備の日であって、時は昼の十二時ころであった。ピラトはユダヤ人らに言った、「見よ、これがあなたがたの王だ」。"},{"ref":"John.19.15","start":43019015,"end":43019015,"break":"none","ruby":[[3,1,"かれ"],[6,1,"さけ"],[11,1,"ころ"],[14,1,"ころ"],[17,1,"かれ"],[19,3,"じゅうじか"],[32,1,"かれ"],[35,1,"い"],[46,1,"おう"],[53,3,"じゅうじか"],[64,3,"さいしちょう"],[70,1,"こた"],[87,2,"いがい"],[90,1,"おう"]],"text":"すると彼らは叫んだ、「殺せ、殺せ、彼を十字架につけよ」。ピラトは彼らに言った、「あなたがたの王を、わたしが十字架につけるのか」。祭司長たちは答えた、「わたしたちには、カイザル以外に王はありません」。"},{"ref":"John.19.16","start":43019016,"end":43019016,"break":"none","breaks":[[34,"paragraph"]],"ruby":[[8,3,"じゅうじか"],[25,1,"かれ"],[28,1,"ひ"],[30,1,"わた"],[34,1,"かれ"],[41,1,"ひ"],[43,1,"と"]],"text":"そこでピラトは、十字架につけさせるために、イエスを彼らに引き渡した。彼らはイエスを引き取った。"},{"ref":"John.19.17","start":43019017,"end":43019017,"break":"none","ruby":[[8,3,"じゅうじか"],[12,2,"せお"],[26,1,"ご"],[37,2,"ばしょ"],[40,1,"で"],[42,1,"い"]],"text":"イエスはみずから十字架を背負って、されこうべ（ヘブル語ではゴルゴダ）という場所に出て行かれた。"},{"ref":"John.19.18","start":43019018,"end":43019018,"break":"none","ruby":[[0,1,"かれ"],[11,3,"じゅうじか"],[25,1,"なか"],[37,1,"もの"],[39,2,"りょうがわ"],[47,2,"いっしょ"],[50,3,"じゅうじか"]],"text":"彼らはそこで、イエスを十字架につけた。イエスをまん中にして、ほかのふたりの者を両側に、イエスと一緒に十字架につけた。"},{"ref":"John.19.19","start":43019019,"end":43019019,"break":"none","ruby":[[4,2,"ざいじょう"],[6,1,"が"],[9,1,"か"],[13,3,"じゅうじか"],[17,1,"うえ"],[33,1,"じん"],[35,1,"おう"],[46,1,"か"]],"text":"ピラトは罪状書きを書いて、十字架の上にかけさせた。それには「ユダヤ人の王、ナザレのイエス」と書いてあった。"},{"ref":"John.19.20","start":43019020,"end":43019020,"break":"none","ruby":[[4,3,"じゅうじか"],[13,2,"ばしょ"],[16,1,"みやこ"],[18,1,"ちか"],[25,1,"おお"],[31,1,"じん"],[35,2,"ざいじょう"],[37,1,"が"],[40,1,"よ"],[60,2,"こくご"],[63,1,"か"]],"text":"イエスが十字架につけられた場所は都に近かったので、多くのユダヤ人がこの罪状書きを読んだ。それはヘブル、ローマ、ギリシヤの国語で書いてあった。"},{"ref":"John.19.21","start":43019021,"end":43019021,"break":"none","ruby":[[3,1,"じん"],[5,3,"さいしちょう"],[15,1,"い"],[24,1,"じん"],[26,1,"おう"],[29,1,"か"],[37,1,"ひと"],[42,1,"じん"],[44,1,"おう"],[46,1,"じ"],[47,1,"しょう"],[54,1,"か"]],"text":"ユダヤ人の祭司長たちがピラトに言った、「『ユダヤ人の王』と書かずに、『この人はユダヤ人の王と自称していた』と書いてほしい」。"},{"ref":"John.19.22","start":43019022,"end":43019022,"break":"none","ruby":[[4,1,"こた"],[13,1,"か"],[20,1,"か"]],"text":"ピラトは答えた、「わたしが書いたことは、書いたままにしておけ」。"},{"ref":"John.19.23","start":43019023,"end":43019023,"break":"paragraph","ruby":[[3,2,"へいそつ"],[12,3,"じゅうじか"],[24,2,"うわぎ"],[33,1,"わ"],[46,1,"と"],[52,2,"したぎ"],[55,1,"て"],[57,1,"と"],[68,1,"ぬ"],[70,1,"め"],[75,1,"うえ"],[77,1,"ほう"],[80,2,"ぜんぶ"],[85,1,"お"]],"text":"さて、兵卒たちはイエスを十字架につけてから、その上着をとって四つに分け、おのおの、その一つを取った。また下着を手に取ってみたが、それには縫い目がなく、上の方から全部一つに織ったものであった。"},{"ref":"John.19.24","start":43019024,"end":43019024,"break":"none","ruby":[[3,1,"かれ"],[6,1,"たがい"],[8,1,"い"],[16,1,"さ"],[35,1,"ひ"],[45,1,"かれ"],[48,1,"たがい"],[54,2,"うわぎ"],[57,1,"わ"],[59,1,"あ"],[66,1,"ころも"],[78,2,"せいしょ"],[81,2,"じょうじゅ"],[89,2,"へいそつ"]],"text":"そこで彼らは互に言った、「それを裂かないで、だれのものになるか、くじを引こう」。これは、「彼らは互にわたしの上着を分け合い、わたしの衣をくじ引にした」という聖書が成就するためで、兵卒たちはそのようにしたのである。"},{"ref":"John.19.25","start":43019025,"end":43019025,"break":"none","ruby":[[7,3,"じゅうじか"],[20,1,"はは"],[23,1,"はは"],[25,2,"しまい"],[33,1,"つま"]],"text":"さて、イエスの十字架のそばには、イエスの母と、母の姉妹と、クロパの妻マリヤと、マグダラのマリヤとが、たたずんでいた。"},{"ref":"John.19.26","start":43019026,"end":43019026,"break":"none","ruby":[[7,1,"はは"],[9,3,"あいでし"],[17,1,"た"],[32,1,"はは"],[40,2,"ふじん"],[58,1,"こ"]],"text":"イエスは、その母と愛弟子とがそばに立っているのをごらんになって、母にいわれた、「婦人よ、ごらんなさい。これはあなたの子です」。"},{"ref":"John.19.27","start":43019027,"end":43019027,"break":"none","ruby":[[6,2,"でし"],[9,1,"い"],[29,1,"はは"],[38,2,"いらい"],[43,2,"でし"],[50,1,"はは"],[52,2,"じぶん"],[55,1,"いえ"],[57,1,"ひ"]],"text":"それからこの弟子に言われた、「ごらんなさい。これはあなたの母です」。そのとき以来、この弟子はイエスの母を自分の家に引きとった。"},{"ref":"John.19.28","start":43019028,"end":43019028,"break":"paragraph","ruby":[[9,1,"いま"],[11,2,"ばんじ"],[14,1,"おわ"],[20,1,"し"],[35,1,"い"],[44,2,"せいしょ"],[47,1,"まっと"]],"text":"そののち、イエスは今や万事が終ったことを知って、「わたしは、かわく」と言われた。それは、聖書が全うされるためであった。"},{"ref":"John.19.29","start":43019029,"end":43019029,"break":"none","ruby":[[4,1,"す"],[9,1,"しゅ"],[15,1,"い"],[20,1,"うつわ"],[31,2,"ひとびと"],[40,1,"しゅ"],[42,1,"ふく"],[46,2,"かいめん"],[53,1,"くき"],[55,1,"むす"],[65,1,"くち"],[71,1,"だ"]],"text":"そこに、酢いぶどう酒がいっぱい入れてある器がおいてあったので、人々は、このぶどう酒を含ませた海綿をヒソプの茎に結びつけて、イエスの口もとにさし出した。"},{"ref":"John.19.30","start":43019030,"end":43019030,"break":"none","ruby":[[13,1,"しゅ"],[15,1,"う"],[24,1,"おわ"],[29,1,"い"],[33,1,"くび"],[38,1,"いき"]],"text":"すると、イエスはそのぶどう酒を受けて、「すべてが終った」と言われ、首をたれて息をひきとられた。"},{"ref":"John.19.31","start":43019031,"end":43019031,"break":"paragraph","ruby":[[5,1,"じん"],[12,1,"ひ"],[14,2,"じゅんび"],[17,1,"ひ"],[25,3,"あんそくにち"],[29,2,"したい"],[32,3,"じゅうじか"],[36,1,"うえ"],[38,1,"のこ"],[48,1,"とく"],[52,3,"あんそくにち"],[56,2,"だいじ"],[59,1,"ひ"],[72,1,"ねが"],[76,1,"あし"],[78,1,"お"],[81,1,"うえ"],[84,2,"したい"],[87,1,"と"]],"text":"さてユダヤ人たちは、その日が準備の日であったので、安息日に死体を十字架の上に残しておくまいと、（特にその安息日は大事な日であったから）、ピラトに願って、足を折った上で、死体を取りおろすことにした。"},{"ref":"John.19.32","start":43019032,"end":43019032,"break":"none","ruby":[[3,2,"へいそつ"],[14,2,"いっしょ"],[17,3,"じゅうじか"],[26,1,"はじ"],[29,1,"もの"],[38,1,"もの"],[41,1,"あし"],[43,1,"お"]],"text":"そこで兵卒らがきて、イエスと一緒に十字架につけられた初めの者と、もうひとりの者との足を折った。"},{"ref":"John.19.33","start":43019033,"end":43019033,"break":"none","ruby":[[4,1,"かれ"],[17,1,"とき"],[25,1,"し"],[34,1,"み"],[39,1,"あし"],[41,1,"お"]],"text":"しかし、彼らがイエスのところにきた時、イエスはもう死んでおられたのを見て、その足を折ることはしなかった。"},{"ref":"John.19.34","start":43019034,"end":43019034,"break":"none","ruby":[[8,2,"へいそつ"],[19,1,"つ"],[27,1,"ち"],[29,1,"みず"],[32,1,"なが"],[34,1,"で"]],"text":"しかし、ひとりの兵卒がやりでそのわきを突きさすと、すぐ血と水とが流れ出た。"},{"ref":"John.19.35","start":43019035,"end":43019035,"break":"none","ruby":[[3,1,"み"],[5,1,"もの"],[24,2,"しんじつ"],[32,1,"ひと"],[35,2,"じぶん"],[38,2,"しんじつ"],[41,1,"かた"],[49,1,"し"],[65,1,"しん"]],"text":"それを見た者があかしをした。そして、そのあかしは真実である。その人は、自分が真実を語っていることを知っている。それは、あなたがたも信ずるようになるためである。"},{"ref":"John.19.36","start":43019036,"end":43019036,"break":"none","ruby":[[7,1,"おこ"],[16,1,"ほね"],[31,2,"せいしょ"],[34,2,"ことば"],[38,2,"じょうじゅ"]],"text":"これらのことが起ったのは、「その骨はくだかれないであろう」との聖書の言葉が、成就するためである。"},{"ref":"John.19.37","start":43019037,"end":43019037,"break":"none","ruby":[[2,2,"せいしょ"],[14,1,"かれ"],[17,2,"じぶん"],[20,1,"さ"],[22,1,"とお"],[25,1,"もの"],[27,1,"み"]],"text":"また聖書のほかのところに、「彼らは自分が刺し通した者を見るであろう」とある。"},{"ref":"John.19.38","start":43019038,"end":43019038,"break":"paragraph","ruby":[[8,1,"じん"],[24,2,"でし"],[42,1,"ひと"],[49,2,"したい"],[52,1,"と"],[65,1,"ねが"],[67,1,"で"],[77,1,"ゆる"],[83,1,"かれ"],[89,2,"したい"],[92,1,"と"],[98,1,"い"]],"text":"そののち、ユダヤ人をはばかって、ひそかにイエスの弟子となったアリマタヤのヨセフという人が、イエスの死体を取りおろしたいと、ピラトに願い出た。ピラトはそれを許したので、彼はイエスの死体を取りおろしに行った。"},{"ref":"John.19.39","start":43019039,"end":43019039,"break":"none","ruby":[[3,1,"まえ"],[6,1,"よる"],[16,1,"い"],[25,2,"もつやく"],[28,2,"ぢんこう"],[39,1,"きん"],[42,1,"も"]],"text":"また、前に、夜、イエスのみもとに行ったニコデモも、没薬と沈香とをまぜたものを百斤ほど持ってきた。"},{"ref":"John.19.40","start":43019040,"end":43019040,"break":"none","ruby":[[0,1,"かれ"],[8,2,"したい"],[11,1,"と"],[20,1,"じん"],[22,2,"まいそう"],[25,2,"しゅうかん"],[34,2,"こうりょう"],[37,1,"い"],[40,3,"あまぬの"],[44,1,"ま"]],"text":"彼らは、イエスの死体を取りおろし、ユダヤ人の埋葬の習慣にしたがって、香料を入れて亜麻布で巻いた。"},{"ref":"John.19.41","start":43019041,"end":43019041,"break":"none","ruby":[[4,3,"じゅうじか"],[13,1,"ところ"],[20,1,"その"],[34,1,"ほうむ"],[43,1,"あたら"],[46,1,"はか"]],"text":"イエスが十字架にかけられた所には、一つの園があり、そこにはまだだれも葬られたことのない新しい墓があった。"},{"ref":"John.19.42","start":43019042,"end":43019042,"break":"none","ruby":[[2,1,"ひ"],[7,1,"じん"],[9,2,"じゅんび"],[12,1,"ひ"],[22,1,"はか"],[24,1,"ちか"],[40,1,"おさ"]],"text":"その日はユダヤ人の準備の日であったので、その墓が近くにあったため、イエスをそこに納めた。"}]