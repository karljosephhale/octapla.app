[{"ref":"Num.1.1","start":4001001,"end":4001001,"break":"paragraph","ruby":[[5,1,"くに"],[7,1,"で"],[9,1,"つぎ"],[11,1,"とし"],[14,1,"がつ"],[16,1,"にち"],[19,1,"しゅ"],[25,2,"あらの"],[32,2,"かいけん"],[35,2,"まくや"],[43,1,"い"]],"text":"エジプトの国を出た次の年の二月一日に、主はシナイの荒野において、会見の幕屋で、モーセに言われた、"},{"ref":"Num.1.2","start":4001002,"end":4001002,"break":"none","ruby":[[14,2,"ひとびと"],[17,1,"ぜん"],[18,2,"かいしゅう"],[24,2,"しぞく"],[32,2,"ふそ"],[35,1,"いえ"],[40,2,"ちょうさ"],[50,2,"だんし"],[53,1,"な"],[55,1,"かず"],[64,1,"かぞ"],[70,2,"そうすう"],[73,1,"え"]],"text":"「あなたがたは、イスラエルの人々の全会衆を、その氏族により、その父祖の家によって調査し、そのすべての男子の名の数を、ひとりびとり数えて、その総数を得なさい。"},{"ref":"Num.1.3","start":4001003,"end":4001003,"break":"none","ruby":[[13,2,"せんそう"],[16,1,"で"],[26,1,"さい"],[27,2,"いじょう"],[30,1,"もの"],[45,2,"ぶたい"],[53,1,"かぞ"]],"text":"イスラエルのうちで、すべて戦争に出ることのできる二十歳以上の者を、あなたとアロンとは、その部隊にしたがって数えなければならない。"},{"ref":"Num.1.4","start":4001004,"end":4001004,"break":"none","ruby":[[7,2,"ぶぞく"],[15,2,"ふそ"],[18,1,"いえ"],[20,1,"ちょう"],[32,1,"だ"],[42,2,"きょうりょく"]],"text":"また、すべての部族は、おのおの父祖の家の長たるものを、ひとりずつ出して、あなたがたと協力させなければならない。"},{"ref":"Num.1.5","start":4001005,"end":4001005,"break":"none","ruby":[[11,2,"きょうりょく"],[16,2,"ひとびと"],[19,1,"な"],[22,1,"つぎ"],[42,1,"こ"]],"text":"すなわち、あなたがたに協力すべき人々の名は、次のとおりである。ルベンからはシデウルの子エリヅル。"},{"ref":"Num.1.6","start":4001006,"end":4001006,"break":"none","ruby":[[14,1,"こ"]],"text":"シメオンからはツリシャダイの子シルミエル。"},{"ref":"Num.1.7","start":4001007,"end":4001007,"break":"none","ruby":[[11,1,"こ"]],"text":"ユダからはアミナダブの子ナション。"},{"ref":"Num.1.8","start":4001008,"end":4001008,"break":"none","ruby":[[12,1,"こ"]],"text":"イッサカルからはツアルの子ネタニエル。"},{"ref":"Num.1.9","start":4001009,"end":4001009,"break":"none","ruby":[[11,1,"こ"]],"text":"ゼブルンからはヘロンの子エリアブ。"},{"ref":"Num.1.10","start":4001010,"end":4001010,"break":"none","ruby":[[4,1,"こ"],[24,1,"こ"],[42,1,"こ"]],"text":"ヨセフの子たちのうち、エフライムからはアミホデの子エリシャマ、マナセからはパダヅルの子ガマリエル。"},{"ref":"Num.1.11","start":4001011,"end":4001011,"break":"none","ruby":[[13,1,"こ"]],"text":"ベニヤミンからはギデオニの子アビダン。"},{"ref":"Num.1.12","start":4001012,"end":4001012,"break":"none","ruby":[[12,1,"こ"]],"text":"ダンからはアミシャダイの子アヒエゼル。"},{"ref":"Num.1.13","start":4001013,"end":4001013,"break":"none","ruby":[[11,1,"こ"]],"text":"アセルからはオクランの子パギエル。"},{"ref":"Num.1.14","start":4001014,"end":4001014,"break":"none","ruby":[[10,1,"こ"]],"text":"ガドからはデウエルの子エリアサフ。"},{"ref":"Num.1.15","start":4001015,"end":4001015,"break":"none","ruby":[[11,1,"こ"]],"text":"ナフタリからはエナンの子アヒラ」。"},{"ref":"Num.1.16","start":4001016,"end":4001016,"break":"none","ruby":[[4,2,"かいしゅう"],[11,1,"えら"],[13,1,"だ"],[17,2,"ひとびと"],[23,2,"ふそ"],[26,2,"ぶぞく"],[43,2,"しぞく"]],"text":"これらは会衆のうちから選び出された人々で、その父祖の部族のつかさたち、またイスラエルの氏族のかしらたちである。"},{"ref":"Num.1.17","start":4001017,"end":4001017,"break":"paragraph","ruby":[[17,1,"な"],[19,1,"かか"],[22,2,"ひとびと"],[25,1,"ひ"],[27,1,"つ"]],"text":"こうして、モーセとアロンが、ここに名を掲げた人々を引き連れて、"},{"ref":"Num.1.18","start":4001018,"end":4001018,"break":"none","ruby":[[1,1,"がつ"],[3,1,"にち"],[5,2,"かいしゅう"],[13,1,"あつ"],[19,1,"かれ"],[24,2,"しぞく"],[32,2,"ふそ"],[35,1,"いえ"],[42,1,"な"],[44,1,"かず"],[53,1,"さい"],[54,2,"いじょう"],[67,2,"とうろく"]],"text":"二月一日に会衆をことごとく集めたので、彼らはその氏族により、その父祖の家により、その名の数にしたがって二十歳以上のものが、ひとりびとり登録した。"},{"ref":"Num.1.19","start":4001019,"end":4001019,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"めい"],[19,2,"あらの"],[22,1,"かれ"],[25,1,"かぞ"]],"text":"主が命じられたように、モーセはシナイの荒野で彼らを数えた。"},{"ref":"Num.1.20","start":4001020,"end":4001020,"break":"paragraph","ruby":[[11,2,"ちょうし"],[17,1,"こ"],[22,1,"うま"],[31,2,"しぞく"],[39,2,"ふそ"],[42,1,"いえ"],[47,1,"しら"],[53,2,"せんそう"],[56,1,"で"],[66,1,"さい"],[67,2,"いじょう"],[70,2,"だんし"],[73,1,"な"],[75,1,"かず"],[84,1,"え"]],"text":"すなわち、イスラエルの長子ルベンの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の男子の名の数を、ひとりびとり得たが、"},{"ref":"Num.1.21","start":4001021,"end":4001021,"break":"none","ruby":[[4,2,"ぶぞく"],[11,1,"かぞ"],[25,1,"にん"]],"text":"ルベンの部族のうちで、数えられたものは四万六千五百人であった。"},{"ref":"Num.1.22","start":4001022,"end":4001022,"break":"paragraph","ruby":[[7,1,"こ"],[12,1,"うま"],[21,2,"しぞく"],[29,2,"ふそ"],[32,1,"いえ"],[37,1,"しら"],[43,2,"せんそう"],[46,1,"で"],[56,1,"さい"],[57,2,"いじょう"],[60,2,"だんし"],[63,1,"な"],[65,1,"かず"],[74,1,"え"]],"text":"またシメオンの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の男子の名の数を、ひとりびとり得たが、"},{"ref":"Num.1.23","start":4001023,"end":4001023,"break":"none","ruby":[[5,2,"ぶぞく"],[12,1,"かぞ"],[26,1,"にん"]],"text":"シメオンの部族のうちで、数えられたものは五万九千三百人であった。"},{"ref":"Num.1.24","start":4001024,"end":4001024,"break":"paragraph","ruby":[[5,1,"こ"],[10,1,"うま"],[19,2,"しぞく"],[27,2,"ふそ"],[30,1,"いえ"],[35,1,"しら"],[41,2,"せんそう"],[44,1,"で"],[54,1,"さい"],[55,2,"いじょう"],[58,1,"もの"],[60,1,"な"],[62,1,"かず"],[64,1,"え"]],"text":"またガドの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の者の名の数を得たが、"},{"ref":"Num.1.25","start":4001025,"end":4001025,"break":"none","ruby":[[3,2,"ぶぞく"],[10,1,"かぞ"],[26,1,"にん"]],"text":"ガドの部族のうちで、数えられたものは四万五千六百五十人であった。"},{"ref":"Num.1.26","start":4001026,"end":4001026,"break":"paragraph","ruby":[[3,1,"こ"],[8,1,"うま"],[17,2,"しぞく"],[25,2,"ふそ"],[28,1,"いえ"],[33,1,"しら"],[39,2,"せんそう"],[42,1,"で"],[52,1,"さい"],[53,2,"いじょう"],[56,1,"もの"],[58,1,"な"],[60,1,"かず"],[62,1,"え"]],"text":"ユダの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の者の名の数を得たが、"},{"ref":"Num.1.27","start":4001027,"end":4001027,"break":"none","ruby":[[3,2,"ぶぞく"],[10,1,"かぞ"],[24,1,"にん"]],"text":"ユダの部族のうちで、数えられたものは七万四千六百人であった。"},{"ref":"Num.1.28","start":4001028,"end":4001028,"break":"paragraph","ruby":[[6,1,"こ"],[11,1,"うま"],[20,2,"しぞく"],[28,2,"ふそ"],[31,1,"いえ"],[36,1,"しら"],[42,2,"せんそう"],[45,1,"で"],[55,1,"さい"],[56,2,"いじょう"],[59,1,"もの"],[61,1,"な"],[63,1,"かず"],[65,1,"え"]],"text":"イッサカルの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の者の名の数を得たが、"},{"ref":"Num.1.29","start":4001029,"end":4001029,"break":"none","ruby":[[6,2,"ぶぞく"],[13,1,"かぞ"],[27,1,"にん"]],"text":"イッサカルの部族のうちで、数えられたものは五万四千四百人であった。"},{"ref":"Num.1.30","start":4001030,"end":4001030,"break":"paragraph","ruby":[[5,1,"こ"],[10,1,"うま"],[19,2,"しぞく"],[27,2,"ふそ"],[30,1,"いえ"],[35,1,"しら"],[41,2,"せんそう"],[44,1,"で"],[54,1,"さい"],[55,2,"いじょう"],[58,1,"もの"],[60,1,"な"],[62,1,"かず"],[64,1,"え"]],"text":"ゼブルンの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の者の名の数を得たが、"},{"ref":"Num.1.31","start":4001031,"end":4001031,"break":"none","ruby":[[5,2,"ぶぞく"],[12,1,"かぞ"],[26,1,"にん"]],"text":"ゼブルンの部族のうちで、数えられたものは五万七千四百人であった。"},{"ref":"Num.1.32","start":4001032,"end":4001032,"break":"paragraph","ruby":[[4,1,"こ"],[17,1,"こ"],[22,1,"うま"],[31,2,"しぞく"],[39,2,"ふそ"],[42,1,"いえ"],[47,1,"しら"],[53,2,"せんそう"],[56,1,"で"],[66,1,"さい"],[67,2,"いじょう"],[70,1,"もの"],[72,1,"な"],[74,1,"かず"],[76,1,"え"]],"text":"ヨセフの子たちのうち、エフライムの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の者の名の数を得たが、"},{"ref":"Num.1.33","start":4001033,"end":4001033,"break":"none","ruby":[[6,2,"ぶぞく"],[13,1,"かぞ"],[25,1,"にん"]],"text":"エフライムの部族のうちで、数えられたものは四万五百人であった。"},{"ref":"Num.1.34","start":4001034,"end":4001034,"break":"paragraph","ruby":[[4,1,"こ"],[9,1,"うま"],[18,2,"しぞく"],[26,2,"ふそ"],[29,1,"いえ"],[34,1,"しら"],[40,2,"せんそう"],[43,1,"で"],[53,1,"さい"],[54,2,"いじょう"],[57,1,"もの"],[59,1,"な"],[61,1,"かず"],[63,1,"え"]],"text":"マナセの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の者の名の数を得たが、"},{"ref":"Num.1.35","start":4001035,"end":4001035,"break":"none","ruby":[[4,2,"ぶぞく"],[11,1,"かぞ"],[25,1,"にん"]],"text":"マナセの部族のうちで、数えられたものは三万二千二百人であった。"},{"ref":"Num.1.36","start":4001036,"end":4001036,"break":"paragraph","ruby":[[6,1,"こ"],[11,1,"うま"],[20,2,"しぞく"],[28,2,"ふそ"],[31,1,"いえ"],[36,1,"しら"],[42,2,"せんそう"],[45,1,"で"],[55,1,"さい"],[56,2,"いじょう"],[59,1,"もの"],[61,1,"な"],[63,1,"かず"],[65,1,"え"]],"text":"ベニヤミンの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の者の名の数を得たが、"},{"ref":"Num.1.37","start":4001037,"end":4001037,"break":"none","ruby":[[6,2,"ぶぞく"],[13,1,"かぞ"],[27,1,"にん"]],"text":"ベニヤミンの部族のうちで、数えられたものは三万五千四百人であった。"},{"ref":"Num.1.38","start":4001038,"end":4001038,"break":"paragraph","ruby":[[3,1,"こ"],[8,1,"うま"],[17,2,"しぞく"],[25,2,"ふそ"],[28,1,"いえ"],[33,1,"しら"],[39,2,"せんそう"],[42,1,"で"],[52,1,"さい"],[53,2,"いじょう"],[56,1,"もの"],[58,1,"な"],[60,1,"かず"],[62,1,"え"]],"text":"ダンの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の者の名の数を得たが、"},{"ref":"Num.1.39","start":4001039,"end":4001039,"break":"none","ruby":[[3,2,"ぶぞく"],[10,1,"かぞ"],[24,1,"にん"]],"text":"ダンの部族のうちで、数えられたものは六万二千七百人であった。"},{"ref":"Num.1.40","start":4001040,"end":4001040,"break":"paragraph","ruby":[[4,1,"こ"],[9,1,"うま"],[18,2,"しぞく"],[26,2,"ふそ"],[29,1,"いえ"],[34,1,"しら"],[40,2,"せんそう"],[43,1,"で"],[53,1,"さい"],[54,2,"いじょう"],[57,1,"もの"],[59,1,"な"],[61,1,"かず"],[63,1,"え"]],"text":"アセルの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の者の名の数を得たが、"},{"ref":"Num.1.41","start":4001041,"end":4001041,"break":"none","ruby":[[4,2,"ぶぞく"],[11,1,"かぞ"],[25,1,"にん"]],"text":"アセルの部族のうちで、数えられたものは四万一千五百人であった。"},{"ref":"Num.1.42","start":4001042,"end":4001042,"break":"paragraph","ruby":[[5,1,"こ"],[10,1,"うま"],[19,2,"しぞく"],[27,2,"ふそ"],[30,1,"いえ"],[35,1,"しら"],[41,2,"せんそう"],[44,1,"で"],[54,1,"さい"],[55,2,"いじょう"],[58,1,"もの"],[60,1,"な"],[62,1,"かず"],[64,1,"え"]],"text":"ナフタリの子たちから生れたものを、その氏族により、その父祖の家によって調べ、すべて戦争に出ることのできる二十歳以上の者の名の数を得たが、"},{"ref":"Num.1.43","start":4001043,"end":4001043,"break":"none","ruby":[[5,2,"ぶぞく"],[12,1,"かぞ"],[27,1,"にん"]],"text":"ナフタリの部族のうちで、数えられたものは、五万三千四百人であった。"},{"ref":"Num.1.44","start":4001044,"end":4001044,"break":"paragraph","ruby":[[4,1,"かぞ"],[9,2,"ひとびと"],[37,1,"かぞ"],[40,2,"ひとびと"],[56,1,"にん"],[68,2,"ふそ"],[71,1,"いえ"],[76,1,"で"]],"text":"これらが数えられた人々であって、モーセとアロンとイスラエルのつかさたちとが数えた人々である。そのつかさたちは十二人であって、おのおのその父祖の家のために出たものである。"},{"ref":"Num.1.45","start":4001045,"end":4001045,"break":"none","ruby":[[9,2,"ひとびと"],[17,2,"ふそ"],[20,1,"いえ"],[27,1,"かぞ"],[32,1,"もの"],[47,2,"せんそう"],[50,1,"で"],[60,1,"さい"],[61,2,"いじょう"],[64,1,"もの"]],"text":"そしてイスラエルの人々のうち、その父祖の家にしたがって数えられた者は、すべてイスラエルのうち、戦争に出ることのできる二十歳以上の者であって、"},{"ref":"Num.1.46","start":4001046,"end":4001046,"break":"none","ruby":[[2,1,"かぞ"],[7,1,"もの"],[9,1,"あ"],[22,1,"にん"]],"text":"その数えられた者は合わせて六十万三千五百五十人であった。"},{"ref":"Num.1.47","start":4001047,"end":4001047,"break":"paragraph","ruby":[[12,2,"ふそ"],[15,2,"ぶぞく"],[29,1,"かぞ"]],"text":"しかし、レビびとは、その父祖の部族にしたがって、そのうちに数えられなかった。"},{"ref":"Num.1.48","start":4001048,"end":4001048,"break":"none","ruby":[[5,1,"しゅ"],[11,1,"い"]],"text":"すなわち、主はモーセに言われた、"},{"ref":"Num.1.49","start":4001049,"end":4001049,"break":"none","ruby":[[8,2,"ぶぞく"],[13,1,"かぞ"],[26,2,"そうすう"],[35,2,"ひとびと"],[41,1,"かぞ"]],"text":"「あなたはレビの部族だけは数えてはならない。またその総数をイスラエルの人々のうちに数えあげてはならない。"},{"ref":"Num.1.50","start":4001050,"end":4001050,"break":"none","ruby":[[14,2,"まくや"],[25,1,"うつわ"],[31,2,"ふぞく"],[40,1,"もの"],[42,2,"かんり"],[50,1,"かれ"],[53,2,"まくや"],[64,1,"うつわ"],[67,1,"も"],[69,1,"はこ"],[77,1,"つとめ"],[81,2,"まくや"],[88,2,"しゅくえい"]],"text":"あなたはレビびとに、あかしの幕屋と、そのもろもろの器と、それに附属するもろもろの物を管理させなさい。彼らは幕屋と、そのもろもろの器とを持ち運び、またそこで務をし、幕屋のまわりに宿営しなければならない。"},{"ref":"Num.1.51","start":4001051,"end":4001051,"break":"none","ruby":[[0,2,"まくや"],[3,1,"すす"],[5,1,"とき"],[16,1,"と"],[22,2,"まくや"],[25,1,"は"],[27,1,"とき"],[38,1,"く"],[40,1,"た"],[54,1,"ひと"],[59,1,"ちか"],[62,1,"とき"],[64,1,"ころ"]],"text":"幕屋が進む時は、レビびとがこれを取りくずし、幕屋を張る時は、レビびとがこれを組み立てなければならない。ほかの人がこれに近づく時は殺されるであろう。"},{"ref":"Num.1.52","start":4001052,"end":4001052,"break":"none","ruby":[[6,2,"ひとびと"],[11,2,"ぶたい"],[26,2,"しゅくえい"],[36,1,"はた"],[43,2,"てんまく"],[46,1,"は"]],"text":"イスラエルの人々はその部隊にしたがって、おのおのその宿営に、おのおのその旗のもとにその天幕を張らなければならない。"},{"ref":"Num.1.53","start":4001053,"end":4001053,"break":"none","ruby":[[14,2,"まくや"],[21,2,"しゅくえい"],[39,1,"しゅ"],[41,1,"いか"],[50,2,"ひとびと"],[53,2,"かいしゅう"],[56,1,"うえ"],[58,1,"のぞ"],[80,2,"まくや"],[83,1,"つとめ"],[85,1,"まも"]],"text":"しかし、レビびとは、あかしの幕屋のまわりに宿営しなければならない。そうすれば、主の怒りはイスラエルの人々の会衆の上に臨むことがないであろう。レビびとは、あかしの幕屋の務を守らなければならない」。"},{"ref":"Num.1.54","start":4001054,"end":4001054,"break":"none","ruby":[[6,2,"ひとびと"],[20,1,"しゅ"],[26,1,"めい"],[34,1,"おこな"]],"text":"イスラエルの人々はこのようにして、すべて主がモーセに命じられたように行った。"}]