[{"ref":"Prov.4.1","start":20004001,"end":20004001,"break":"paragraph","breaks":[[12,"line"]],"ruby":[[0,2,"こども"],[5,1,"ちち"],[7,1,"おしえ"],[9,1,"き"],[12,1,"さと"],[15,1,"え"],[20,1,"みみ"],[22,1,"かたむ"]],"text":"子供らよ、父の教を聞き、悟りを得るために耳を傾けよ。"},{"ref":"Prov.4.2","start":20004002,"end":20004002,"break":"line","breaks":[[22,"line"]],"ruby":[[5,1,"よ"],[7,2,"きょうくん"],[26,1,"おしえ"],[28,1,"す"]],"text":"わたしは、良い教訓を、あなたがたにさずける。わたしの教を捨ててはならない。"},{"ref":"Prov.4.3","start":20004003,"end":20004003,"break":"line","breaks":[[14,"line"]],"ruby":[[6,1,"ちち"],[9,1,"こ"],[16,1,"はは"],[18,1,"め"],[29,1,"こ"]],"text":"わたしもわが父には子であり、わが母の目には、ひとりのいとし子であった。"},{"ref":"Prov.4.4","start":20004004,"end":20004004,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[0,1,"ちち"],[6,1,"おし"],[9,1,"い"],[18,2,"ことば"],[22,1,"こころ"],[24,1,"と"],[31,1,"いまし"],[34,1,"まも"],[38,1,"いのち"],[40,1,"え"]],"text":"父はわたしを教えて言った、「わたしの言葉を、心に留め、わたしの戒めを守って、命を得よ。"},{"ref":"Prov.4.5","start":20004005,"end":20004005,"break":"line","breaks":[[11,"line"],[30,"line"]],"ruby":[[3,1,"わす"],[15,1,"くち"],[17,2,"ことば"],[30,2,"ちえ"],[33,1,"え"],[36,1,"さと"],[39,1,"え"]],"text":"それを忘れることなく、またわが口の言葉にそむいてはならない、知恵を得よ、悟りを得よ。"},{"ref":"Prov.4.6","start":20004006,"end":20004006,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"す"],[15,1,"まも"],[21,1,"あい"],[32,1,"たも"]],"text":"知恵を捨てるな、それはあなたを守る。それを愛せよ、それはあなたを保つ。"},{"ref":"Prov.4.7","start":20004007,"end":20004007,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"はじ"],[12,2,"ちえ"],[15,1,"え"],[22,1,"なに"],[24,1,"え"],[31,1,"さと"],[34,1,"え"]],"text":"知恵の初めはこれである、知恵を得よ、あなたが何を得るにしても、悟りを得よ。"},{"ref":"Prov.4.8","start":20004008,"end":20004008,"break":"line","breaks":[[25,"line"]],"ruby":[[3,1,"たっと"],[19,1,"たか"],[44,1,"たっと"]],"text":"それを尊べ、そうすれば、それはあなたを高くあげる、もしそれをいだくならば、それはあなたを尊くする。"},{"ref":"Prov.4.9","start":20004009,"end":20004009,"break":"line","breaks":[[18,"line"]],"ruby":[[7,1,"あたま"],[9,1,"うるわ"],[12,1,"かざ"],[15,1,"お"],[18,1,"さか"],[21,1,"かんむり"],[27,1,"あた"]],"text":"それはあなたの頭に麗しい飾りを置き、栄えの冠をあなたに与える」。"},{"ref":"Prov.4.10","start":20004010,"end":20004010,"break":"stanza","breaks":[[21,"line"]],"ruby":[[2,1,"こ"],[5,1,"き"],[12,2,"ことば"],[31,1,"いのち"],[33,1,"とし"],[35,1,"おお"]],"text":"わが子よ、聞け、わたしの言葉をうけいれよ、そうすれば、あなたの命の年は多くなる。"},{"ref":"Prov.4.11","start":20004011,"end":20004011,"break":"line","breaks":[[16,"line"]],"ruby":[[4,2,"ちえ"],[7,1,"みち"],[13,1,"おし"],[16,1,"ただ"],[19,2,"みちすじ"],[26,1,"みちび"]],"text":"わたしは知恵の道をあなたに教え、正しい道筋にあなたを導いた。"},{"ref":"Prov.4.12","start":20004012,"end":20004012,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"ある"],[11,1,"あゆ"],[14,1,"さまた"],[20,1,"はし"],[22,1,"とき"]],"text":"あなたが歩くとき、その歩みは妨げられず、走る時にも、つまずくことはない。"},{"ref":"Prov.4.13","start":20004013,"end":20004013,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"きょうくん"],[11,1,"はな"],[23,1,"まも"],[33,1,"いのち"]],"text":"教訓をかたくとらえて、離してはならない、それを守れ、それはあなたの命である。"},{"ref":"Prov.4.14","start":20004014,"end":20004014,"break":"line","breaks":[[20,"line"]],"ruby":[[5,1,"もの"],[7,1,"みち"],[20,1,"あ"],[23,1,"もの"],[25,1,"みち"],[27,1,"あゆ"]],"text":"よこしまな者の道に、はいってはならない、悪しき者の道を歩んではならない。"},{"ref":"Prov.4.15","start":20004015,"end":20004015,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"さ"],[7,1,"とお"],[19,1,"はな"],[22,1,"すす"]],"text":"それを避けよ、通ってはならない、それを離れて進め。"},{"ref":"Prov.4.16","start":20004016,"end":20004016,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あく"],[5,1,"おこな"],[11,1,"ねむ"],[20,1,"ひと"],[32,1,"ね"]],"text":"彼らは悪を行わなければ眠ることができず、人をつまずかせなければ、寝ることができず、"},{"ref":"Prov.4.17","start":20004017,"end":20004017,"break":"line","ruby":[[0,2,"ふせい"],[6,1,"く"],[10,2,"ぼうぎゃく"],[13,1,"さけ"],[15,1,"の"]],"text":"不正のパンを食らい、暴虐の酒を飲むからである。"},{"ref":"Prov.4.18","start":20004018,"end":20004018,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"みち"],[8,2,"よあ"],[12,1,"ひかり"],[22,1,"かがや"],[25,1,"ま"],[28,2,"まひる"]],"text":"正しい者の道は、夜明けの光のようだ、いよいよ輝きを増して真昼となる。"},{"ref":"Prov.4.19","start":20004019,"end":20004019,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"あ"],[3,1,"ひと"],[5,1,"みち"],[7,1,"くら"],[15,1,"かれ"],[18,1,"なに"],[26,1,"し"]],"text":"悪しき人の道は暗やみのようだ、彼らは何につまずくかを知らない。"},{"ref":"Prov.4.20","start":20004020,"end":20004020,"break":"stanza","breaks":[[17,"line"]],"ruby":[[2,1,"こ"],[9,2,"ことば"],[12,1,"こころ"],[21,1,"かた"],[26,1,"みみ"],[28,1,"かたむ"]],"text":"わが子よ、わたしの言葉に心をとめ、わたしの語ることに耳を傾けよ。"},{"ref":"Prov.4.21","start":20004021,"end":20004021,"break":"line","breaks":[[15,"line"]],"ruby":[[8,1,"め"],[11,1,"はな"],[19,1,"こころ"],[24,1,"まも"]],"text":"それを、あなたの目から離さず、あなたの心のうちに守れ。"},{"ref":"Prov.4.22","start":20004022,"end":20004022,"break":"line","breaks":[[16,"line"]],"ruby":[[7,1,"え"],[9,1,"もの"],[11,1,"いのち"],[20,2,"ぜんしん"],[23,1,"すこ"]],"text":"それは、これを得る者の命であり、またその全身を健やかにするからである。"},{"ref":"Prov.4.23","start":20004023,"end":20004023,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"ゆだん"],[13,1,"こころ"],[15,1,"まも"],[18,1,"いのち"],[20,1,"いずみ"],[27,1,"なが"],[29,1,"で"]],"text":"油断することなく、あなたの心を守れ、命の泉は、これから流れ出るからである。"},{"ref":"Prov.4.24","start":20004024,"end":20004024,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"まが"],[3,2,"ことば"],[11,1,"す"],[21,2,"だんわ"],[29,1,"とお"]],"text":"曲った言葉をあなたから捨てさり、よこしまな談話をあなたから遠ざけよ。"},{"ref":"Prov.4.25","start":20004025,"end":20004025,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"め"],[12,2,"しょうめん"],[15,1,"み"],[29,1,"まえ"],[37,1,"み"]],"text":"あなたの目は、まっすぐに正面を見、あなたのまぶたはあなたの前を、まっすぐに見よ。"},{"ref":"Prov.4.26","start":20004026,"end":20004026,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"あし"],[6,1,"みち"],[8,1,"き"],[28,1,"みち"],[30,2,"あんぜん"]],"text":"あなたの足の道に気をつけよ、そうすれば、あなたのすべての道は安全である。"},{"ref":"Prov.4.27","start":20004027,"end":20004027,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"みぎ"],[3,1,"ひだり"],[6,1,"まよ"],[8,1,"で"],[20,1,"あし"],[22,1,"あく"],[25,1,"はな"]],"text":"右にも左にも迷い出てはならない、あなたの足を悪から離れさせよ。"}]