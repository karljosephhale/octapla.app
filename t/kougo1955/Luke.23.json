[{"ref":"Luke.23.1","start":42023001,"end":42023001,"break":"paragraph","ruby":[[0,2,"ぐんしゅう"],[5,1,"た"],[24,1,"つ"],[27,1,"い"]],"text":"群衆はみな立ちあがって、イエスをピラトのところへ連れて行った。"},{"ref":"Luke.23.2","start":42023002,"end":42023002,"break":"none","ruby":[[3,1,"うった"],[5,1,"で"],[7,1,"い"],[21,1,"ひと"],[23,2,"こくみん"],[26,1,"まど"],[30,1,"みつぎ"],[37,1,"おさ"],[43,1,"きん"],[48,2,"じぶん"],[52,1,"おう"],[72,2,"もくげき"]],"text":"そして訴え出て言った、「わたしたちは、この人が国民を惑わし、貢をカイザルに納めることを禁じ、また自分こそ王なるキリストだと、となえているところを目撃しました」。"},{"ref":"Luke.23.3","start":42023003,"end":42023003,"break":"none","ruby":[[8,1,"たず"],[20,1,"じん"],[22,1,"おう"],[45,1,"こた"]],"text":"ピラトはイエスに尋ねた、「あなたがユダヤ人の王であるか」。イエスは「そのとおりである」とお答えになった。"},{"ref":"Luke.23.4","start":42023004,"end":42023004,"break":"none","ruby":[[7,3,"さいしちょう"],[13,2,"ぐんしゅう"],[21,1,"い"],[32,1,"ひと"],[37,1,"つみ"]],"text":"そこでピラトは祭司長たちと群衆とにむかって言った、「わたしはこの人になんの罪もみとめない」。"},{"ref":"Luke.23.5","start":42023005,"end":42023005,"break":"none","ruby":[[4,1,"かれ"],[12,1,"い"],[26,1,"かれ"],[41,1,"ところ"],[48,2,"ぜんこく"],[55,1,"おし"],[58,2,"みんしゅう"],[61,2,"せんどう"]],"text":"ところが彼らは、ますます言いつのってやまなかった、「彼は、ガリラヤからはじめてこの所まで、ユダヤ全国にわたって教え、民衆を煽動しているのです」。"},{"ref":"Luke.23.6","start":42023006,"end":42023006,"break":"none","ruby":[[7,1,"き"],[13,1,"ひと"],[19,1,"びと"],[22,1,"たず"]],"text":"ピラトはこれを聞いて、この人はガリラヤ人かと尋ね、"},{"ref":"Luke.23.7","start":42023007,"end":42023007,"break":"none","ruby":[[7,3,"しはいか"],[19,1,"たし"],[62,1,"おく"]],"text":"そしてヘロデの支配下のものであることを確かめたので、ちょうどこのころ、ヘロデがエルサレムにいたのをさいわい、そちらへイエスを送りとどけた。"},{"ref":"Luke.23.8","start":42023008,"end":42023008,"break":"none","ruby":[[8,1,"み"],[10,2,"ひじょう"],[13,1,"よろこ"],[31,1,"き"],[39,1,"あ"],[42,1,"み"],[46,1,"なが"],[51,1,"おも"],[64,1,"なに"],[66,2,"きせき"],[69,1,"おこな"],[73,1,"み"],[77,1,"のぞ"]],"text":"ヘロデはイエスを見て非常に喜んだ。それは、かねてイエスのことを聞いていたので、会って見たいと長いあいだ思っていたし、またイエスが何か奇跡を行うのを見たいと望んでいたからである。"},{"ref":"Luke.23.9","start":42023009,"end":42023009,"break":"none","ruby":[[9,2,"しつもん"],[12,1,"こころ"],[21,1,"なに"],[24,1,"こた"]],"text":"それで、いろいろと質問を試みたが、イエスは何もお答えにならなかった。"},{"ref":"Luke.23.10","start":42023010,"end":42023010,"break":"none","ruby":[[0,3,"さいしちょう"],[6,2,"りっぽう"],[8,2,"がくしゃ"],[14,1,"た"],[18,1,"はげ"],[21,2,"ごちょう"],[28,1,"うった"]],"text":"祭司長たちと律法学者たちとは立って、激しい語調でイエスを訴えた。"},{"ref":"Luke.23.11","start":42023011,"end":42023011,"break":"none","ruby":[[8,2,"へいそつ"],[13,2,"いっしょ"],[24,2,"ぶじょく"],[29,2,"ちょうろう"],[45,2,"きもの"],[48,1,"き"],[55,1,"おく"]],"text":"またヘロデはその兵卒どもと一緒になって、イエスを侮辱したり嘲弄したりしたあげく、はなやかな着物を着せてピラトへ送りかえした。"},{"ref":"Luke.23.12","start":42023012,"end":42023012,"break":"none","ruby":[[9,2,"いぜん"],[12,1,"たがい"],[14,2,"てきし"],[24,1,"ひ"],[26,1,"した"],[29,1,"なか"]],"text":"ヘロデとピラトとは以前は互に敵視していたが、この日に親しい仲になった。"},{"ref":"Luke.23.13","start":42023013,"end":42023013,"break":"paragraph","ruby":[[5,3,"さいしちょう"],[11,2,"やくにん"],[16,2,"みんしゅう"],[21,1,"よ"],[23,1,"あつ"],[26,1,"い"]],"text":"ピラトは、祭司長たちと役人たちと民衆とを、呼び集めて言った、"},{"ref":"Luke.23.14","start":42023014,"end":42023014,"break":"none","ruby":[[10,1,"ひと"],[12,2,"みんしゅう"],[15,1,"まど"],[31,1,"つ"],[45,2,"めんぜん"],[54,1,"うった"],[56,1,"で"],[63,1,"つみ"],[68,1,"ひと"],[70,1,"すこ"]],"text":"「おまえたちは、この人を民衆を惑わすものとしてわたしのところに連れてきたので、おまえたちの面前でしらべたが、訴え出ているような罪は、この人に少しもみとめられなかった。"},{"ref":"Luke.23.15","start":42023015,"end":42023015,"break":"none","ruby":[[14,1,"げん"],[16,1,"かれ"],[27,1,"おく"],[38,1,"ひと"],[43,1,"し"],[45,1,"あた"]],"text":"ヘロデもまたみとめなかった。現に彼はイエスをわれわれに送りかえしてきた。この人はなんら死に当るようなことはしていないのである。"},{"ref":"Luke.23.16","start":42023016,"end":42023016,"break":"none","ruby":[[4,1,"かれ"],[8,1,"う"]],"text":"だから、彼をむち打ってから、ゆるしてやることにしよう」。〔"},{"ref":"Luke.23.17","start":42023017,"end":42023017,"break":"none","ruby":[[0,1,"まつり"],[12,2,"しゅうじん"]],"text":"祭ごとにピラトがひとりの囚人をゆるしてやることになっていた。〕"},{"ref":"Luke.23.18","start":42023018,"end":42023018,"break":"none","ruby":[[5,1,"かれ"],[13,1,"さけ"],[16,1,"い"],[23,1,"ひと"],[25,1,"ころ"]],"text":"ところが、彼らはいっせいに叫んで言った、「その人を殺せ。バラバをゆるしてくれ」。"},{"ref":"Luke.23.19","start":42023019,"end":42023019,"break":"none","ruby":[[7,1,"みやこ"],[9,1,"おこ"],[12,2,"ぼうどう"],[15,2,"さつじん"],[23,1,"ごく"],[25,1,"とう"],[32,1,"もの"]],"text":"このバラバは、都で起った暴動と殺人とのかどで、獄に投ぜられていた者である。"},{"ref":"Luke.23.20","start":42023020,"end":42023020,"break":"none","ruby":[[17,1,"おも"],[24,1,"ど"],[29,1,"よ"]],"text":"ピラトはイエスをゆるしてやりたいと思って、もう一度かれらに呼びかけた。"},{"ref":"Luke.23.21","start":42023021,"end":42023021,"break":"none","ruby":[[3,1,"かれ"],[14,3,"じゅうじか"],[22,1,"かれ"],[24,3,"じゅうじか"],[33,1,"い"]],"text":"しかし彼らは、わめきたてて「十字架につけよ、彼を十字架につけよ」と言いつづけた。"},{"ref":"Luke.23.22","start":42023022,"end":42023022,"break":"none","ruby":[[5,2,"どめ"],[8,1,"かれ"],[15,1,"い"],[25,1,"ひと"],[36,2,"あくじ"],[44,1,"かれ"],[47,1,"し"],[49,1,"あた"],[51,1,"つみ"],[53,1,"まった"],[71,1,"う"],[76,1,"かれ"]],"text":"ピラトは三度目に彼らにむかって言った、「では、この人は、いったい、どんな悪事をしたのか。彼には死に当る罪は全くみとめられなかった。だから、むち打ってから彼をゆるしてやることにしよう」。"},{"ref":"Luke.23.23","start":42023023,"end":42023023,"break":"none","ruby":[[5,1,"かれ"],[8,2,"おおごえ"],[14,1,"つ"],[16,1,"よ"],[23,3,"じゅうじか"],[33,2,"ようきゅう"],[44,1,"こえ"],[46,1,"か"]],"text":"ところが、彼らは大声をあげて詰め寄り、イエスを十字架につけるように要求した。そして、その声が勝った。"},{"ref":"Luke.23.24","start":42023024,"end":42023024,"break":"none","ruby":[[7,1,"かれ"],[10,1,"ねが"],[21,2,"けってい"]],"text":"ピラトはついに彼らの願いどおりにすることに決定した。"},{"ref":"Luke.23.25","start":42023025,"end":42023025,"break":"none","ruby":[[4,2,"ぼうどう"],[7,2,"さつじん"],[14,1,"ごく"],[16,1,"とう"],[21,1,"もの"],[23,1,"ほう"],[26,1,"かれ"],[29,2,"ようきゅう"],[32,1,"おう"],[46,1,"ほう"],[48,1,"かれ"],[51,1,"ひ"],[53,1,"わた"],[59,1,"い"]],"text":"そして、暴動と殺人とのかどで獄に投ぜられた者の方を、彼らの要求に応じてゆるしてやり、イエスの方は彼らに引き渡して、その意のままにまかせた。"},{"ref":"Luke.23.26","start":42023026,"end":42023026,"break":"paragraph","ruby":[[0,1,"かれ"],[12,2,"とちゅう"],[24,1,"びと"],[26,2,"こうがい"],[30,1,"で"],[36,1,"とら"],[39,3,"じゅうじか"],[43,1,"お"],[62,1,"い"]],"text":"彼らがイエスをひいてゆく途中、シモンというクレネ人が郊外から出てきたのを捕えて十字架を負わせ、それをになってイエスのあとから行かせた。"},{"ref":"Luke.23.27","start":42023027,"end":42023027,"break":"paragraph","ruby":[[0,1,"おお"],[4,2,"みんしゅう"],[8,1,"かな"],[11,1,"なげ"],[18,1,"おんな"],[22,1,"む"],[31,1,"したが"],[34,1,"い"]],"text":"大ぜいの民衆と、悲しみ嘆いてやまない女たちの群れとが、イエスに従って行った。"},{"ref":"Luke.23.28","start":42023028,"end":42023028,"break":"none","ruby":[[4,1,"おんな"],[8,1,"ほう"],[10,1,"ふ"],[15,1,"い"],[27,1,"むすめ"],[39,1,"な"],[52,2,"じしん"],[60,2,"じぶん"],[63,2,"こども"],[71,1,"な"]],"text":"イエスは女たちの方に振りむいて言われた、「エルサレムの娘たちよ、わたしのために泣くな。むしろ、あなたがた自身のため、また自分の子供たちのために泣くがよい。"},{"ref":"Luke.23.29","start":42023029,"end":42023029,"break":"none","ruby":[[1,2,"ふにん"],[4,1,"おんな"],[6,1,"こ"],[8,1,"う"],[14,1,"たい"],[25,2,"ちぶさ"],[37,1,"い"],[39,1,"ひ"],[45,1,"く"]],"text":"『不妊の女と子を産まなかった胎と、ふくませなかった乳房とは、さいわいだ』と言う日が、いまに来る。"},{"ref":"Luke.23.30","start":42023030,"end":42023030,"break":"none","ruby":[[5,2,"ひとびと"],[8,1,"やま"],[20,1,"うえ"],[22,1,"たお"],[28,1,"い"],[33,1,"おか"],[53,1,"い"],[55,1,"だ"]],"text":"そのとき、人々は山にむかって、われわれの上に倒れかかれと言い、また丘にむかって、われわれにおおいかぶされと言い出すであろう。"},{"ref":"Luke.23.31","start":42023031,"end":42023031,"break":"none","ruby":[[3,2,"なまき"],[17,2,"かれき"]],"text":"もし、生木でさえもそうされるなら、枯木はどうされることであろう」。"},{"ref":"Luke.23.32","start":42023032,"end":42023032,"break":"paragraph","ruby":[[7,1,"とも"],[9,1,"けい"],[11,1,"う"],[25,2,"はんざい"],[27,1,"にん"],[29,1,"ひ"]],"text":"さて、イエスと共に刑を受けるために、ほかにふたりの犯罪人も引かれていった。"},{"ref":"Luke.23.33","start":42023033,"end":42023033,"break":"none","ruby":[[6,1,"よ"],[12,1,"ところ"],[14,1,"つ"],[18,2,"ひとびと"],[28,3,"じゅうじか"],[35,2,"はんざい"],[37,1,"にん"],[46,1,"みぎ"],[53,1,"ひだり"],[56,3,"じゅうじか"]],"text":"されこうべと呼ばれている所に着くと、人々はそこでイエスを十字架につけ、犯罪人たちも、ひとりは右に、ひとりは左に、十字架につけた。"},{"ref":"Luke.23.34","start":42023034,"end":42023034,"break":"none","ruby":[[9,1,"い"],[15,1,"ちち"],[18,1,"かれ"],[30,1,"かれ"],[33,1,"なに"],[54,2,"ひとびと"],[61,2,"きもの"],[66,1,"ひ"],[69,1,"わ"],[71,1,"あ"]],"text":"そのとき、イエスは言われた、「父よ、彼らをおゆるしください。彼らは何をしているのか、わからずにいるのです」。人々はイエスの着物をくじ引きで分け合った。"},{"ref":"Luke.23.35","start":42023035,"end":42023035,"break":"none","ruby":[[0,2,"みんしゅう"],[3,1,"た"],[6,1,"み"],[11,2,"やくにん"],[18,1,"わら"],[21,1,"い"],[26,1,"かれ"],[28,2,"たにん"],[31,1,"すく"],[37,1,"かれ"],[39,1,"かみ"],[46,1,"えら"],[50,1,"もの"],[57,2,"じぶん"],[59,2,"じしん"],[62,1,"すく"]],"text":"民衆は立って見ていた。役人たちもあざ笑って言った、「彼は他人を救った。もし彼が神のキリスト、選ばれた者であるなら、自分自身を救うがよい」。"},{"ref":"Luke.23.36","start":42023036,"end":42023036,"break":"none","ruby":[[0,2,"へいそつ"],[14,2,"ちかよ"],[20,1,"す"],[25,1,"しゅ"],[29,1,"だ"],[32,1,"い"]],"text":"兵卒どももイエスをののしり、近寄ってきて酢いぶどう酒をさし出して言った、"},{"ref":"Luke.23.37","start":42023037,"end":42023037,"break":"none","ruby":[[8,1,"じん"],[10,1,"おう"],[14,2,"じぶん"],[17,1,"すく"]],"text":"「あなたがユダヤ人の王なら、自分を救いなさい」。"},{"ref":"Luke.23.38","start":42023038,"end":42023038,"break":"none","ruby":[[4,1,"うえ"],[15,1,"じん"],[17,1,"おう"],[20,1,"か"],[23,1,"ふだ"]],"text":"イエスの上には、「これはユダヤ人の王」と書いた札がかけてあった。"},{"ref":"Luke.23.39","start":42023039,"end":42023039,"break":"paragraph","ruby":[[0,3,"じゅうじか"],[9,2,"はんざい"],[11,1,"にん"],[38,2,"じぶん"],[41,1,"すく"],[51,1,"すく"],[63,2,"わるくち"],[66,1,"い"]],"text":"十字架にかけられた犯罪人のひとりが、「あなたはキリストではないか。それなら、自分を救い、またわれわれも救ってみよ」と、イエスに悪口を言いつづけた。"},{"ref":"Luke.23.40","start":42023040,"end":42023040,"break":"none","ruby":[[15,1,"い"],[24,1,"おな"],[26,1,"けい"],[28,1,"う"],[36,1,"かみ"],[38,1,"おそ"]],"text":"もうひとりは、それをたしなめて言った、「おまえは同じ刑を受けていながら、神を恐れないのか。"},{"ref":"Luke.23.41","start":42023041,"end":42023041,"break":"none","ruby":[[1,1,"たがい"],[3,2,"じぶん"],[9,1,"こと"],[15,1,"う"],[32,2,"とうぜん"],[45,1,"なに"],[47,1,"わる"]],"text":"お互は自分のやった事のむくいを受けているのだから、こうなったのは当然だ。しかし、このかたは何も悪いことをしたのではない」。"},{"ref":"Luke.23.42","start":42023042,"end":42023042,"break":"none","ruby":[[3,1,"い"],[17,2,"みくに"],[20,2,"けんい"],[32,1,"とき"],[40,1,"おも"],[42,1,"だ"]],"text":"そして言った、「イエスよ、あなたが御国の権威をもっておいでになる時には、わたしを思い出してください」。"},{"ref":"Luke.23.43","start":42023043,"end":42023043,"break":"none","ruby":[[4,1,"い"],[12,1,"い"],[31,2,"いっしょ"]],"text":"イエスは言われた、「よく言っておくが、あなたはきょう、わたしと一緒にパラダイスにいるであろう」。"},{"ref":"Luke.23.44","start":42023044,"end":42023044,"break":"paragraph","ruby":[[0,1,"とき"],[4,1,"ひる"],[8,1,"じ"],[17,2,"たいよう"],[20,1,"ひかり"],[22,1,"うしな"],[25,1,"ぜん"],[26,1,"ち"],[28,1,"くら"],[35,1,"じ"],[37,1,"およ"]],"text":"時はもう昼の十二時ごろであったが、太陽は光を失い、全地は暗くなって、三時に及んだ。"},{"ref":"Luke.23.45","start":42023045,"end":42023045,"break":"none","ruby":[[3,2,"せいじょ"],[6,1,"まく"],[10,1,"なか"],[13,1,"さ"]],"text":"そして聖所の幕がまん中から裂けた。"},{"ref":"Luke.23.46","start":42023046,"end":42023046,"break":"none","ruby":[[9,1,"こえ"],[10,1,"たか"],[12,1,"さけ"],[15,1,"い"],[21,1,"ちち"],[28,1,"れい"],[31,1,"て"],[42,1,"い"],[48,1,"いき"],[50,1,"ひ"]],"text":"そのとき、イエスは声高く叫んで言われた、「父よ、わたしの霊をみ手にゆだねます」。こう言ってついに息を引きとられた。"},{"ref":"Luke.23.47","start":42023047,"end":42023047,"break":"none","ruby":[[0,3,"ひゃくそつちょう"],[6,2,"ありさま"],[9,1,"み"],[12,1,"かみ"],[27,1,"ひと"],[29,1,"ただ"],[32,1,"ひと"],[39,1,"い"]],"text":"百卒長はこの有様を見て、神をあがめ、「ほんとうに、この人は正しい人であった」と言った。"},{"ref":"Luke.23.48","start":42023048,"end":42023048,"break":"none","ruby":[[2,2,"こうけい"],[5,1,"み"],[7,1,"あつ"],[13,2,"ぐんしゅう"],[21,3,"できごと"],[25,1,"み"],[30,1,"むね"],[32,1,"う"],[37,1,"かえ"],[40,1,"い"]],"text":"この光景を見に集まってきた群衆も、これらの出来事を見て、みな胸を打ちながら帰って行った。"},{"ref":"Luke.23.49","start":42023049,"end":42023049,"break":"none","ruby":[[7,1,"し"],[12,1,"もの"],[21,1,"したが"],[26,1,"おんな"],[31,1,"とお"],[33,1,"ところ"],[35,1,"た"],[46,1,"み"]],"text":"すべてイエスを知っていた者や、ガリラヤから従ってきた女たちも、遠い所に立って、これらのことを見ていた。"},{"ref":"Luke.23.50","start":42023050,"end":42023050,"break":"paragraph","ruby":[[10,2,"ぎいん"],[17,2,"ぜんりょう"],[20,1,"ただ"],[23,1,"ひと"]],"text":"ここに、ヨセフという議員がいたが、善良で正しい人であった。"},{"ref":"Luke.23.51","start":42023051,"end":42023051,"break":"none","ruby":[[2,1,"ひと"],[8,1,"まち"],[15,2,"しゅっしん"],[19,1,"かみ"],[21,1,"くに"],[23,1,"ま"],[25,1,"のぞ"],[31,1,"かれ"],[33,2,"ぎかい"],[36,2,"ぎけつ"],[39,2,"こうどう"],[43,2,"さんせい"]],"text":"この人はユダヤの町アリマタヤの出身で、神の国を待ち望んでいた。彼は議会の議決や行動には賛成していなかった。"},{"ref":"Luke.23.52","start":42023052,"end":42023052,"break":"none","ruby":[[2,1,"ひと"],[12,1,"い"],[24,2,"ひきと"],[27,1,"かた"],[29,1,"ねが"],[31,1,"で"]],"text":"この人がピラトのところへ行って、イエスのからだの引取り方を願い出て、"},{"ref":"Luke.23.53","start":42023053,"end":42023053,"break":"none","ruby":[[3,1,"と"],[9,3,"あまぬの"],[13,1,"つつ"],[21,1,"ほうむ"],[30,1,"いわ"],[32,1,"ほ"],[35,1,"つく"],[38,1,"はか"],[40,1,"おさ"]],"text":"それを取りおろして亜麻布に包み、まだだれも葬ったことのない、岩を掘って造った墓に納めた。"},{"ref":"Luke.23.54","start":42023054,"end":42023054,"break":"none","ruby":[[2,1,"ひ"],[4,2,"じゅんび"],[7,1,"ひ"],[13,3,"あんそくにち"],[17,1,"はじ"]],"text":"この日は準備の日であって、安息日が始まりかけていた。"},{"ref":"Luke.23.55","start":42023055,"end":42023055,"break":"none","ruby":[[4,2,"いっしょ"],[15,1,"おんな"],[31,1,"はか"],[33,1,"み"],[45,1,"おさ"],[50,2,"ようす"],[53,1,"み"]],"text":"イエスと一緒にガリラヤからきた女たちは、あとについてきて、その墓を見、またイエスのからだが納められる様子を見とどけた。"},{"ref":"Luke.23.56","start":42023056,"end":42023056,"break":"none","breaks":[[19,"paragraph"]],"ruby":[[3,1,"かえ"],[7,2,"こうりょう"],[10,2,"こうゆ"],[14,2,"ようい"],[27,1,"したが"],[30,3,"あんそくにち"],[34,1,"やす"]],"text":"そして帰って、香料と香油とを用意した。それからおきてに従って安息日を休んだ。"}]