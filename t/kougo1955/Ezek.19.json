[{"ref":"Ezek.19.1","start":26019001,"end":26019001,"break":"paragraph","ruby":[[10,1,"きみ"],[17,1,"かな"],[21,1,"うた"]],"text":"あなたはイスラエルの君たちのために悲しみの歌をのべて"},{"ref":"Ezek.19.2","start":26019002,"end":26019002,"break":"none","breaks":[[3,"stanza"],[19,"line"],[32,"line"]],"ruby":[[0,1,"い"],[7,1,"はは"],[22,1,"め"],[32,2,"かのじょ"],[35,1,"わか"],[43,1,"ふ"],[46,1,"こ"],[50,1,"やしな"]],"text":"言え、あなたの母はししのうちにあって、どんな雌じしであったろう。彼女は若いししのうちに伏して子じしを養った。"},{"ref":"Ezek.19.3","start":26019003,"end":26019003,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"こ"],[10,1,"そだ"],[18,1,"わか"],[27,2,"えもの"],[35,1,"まな"],[38,1,"ひと"],[40,1,"た"]],"text":"彼女は子じしの一つを育てたが、それは若いししとなって、獲物をとることを学び、人を食べた。"},{"ref":"Ezek.19.4","start":26019004,"end":26019004,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[0,2,"くにぐに"],[3,1,"ひと"],[5,1,"かれ"],[7,1,"たい"],[10,1,"さけ"],[12,1,"ごえ"],[17,1,"おと"],[19,1,"あな"],[24,1,"とら"],[38,1,"ち"],[40,1,"ひ"],[43,1,"い"]],"text":"国々の人は彼に対して叫び声をあげ、落し穴でこれを捕え、かぎでこれをエジプトの地に引いて行った。"},{"ref":"Ezek.19.5","start":26019005,"end":26019005,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[0,1,"め"],[4,2,"じぶん"],[7,1,"おも"],[10,1,"やぶ"],[15,1,"のぞ"],[18,1,"うしな"],[23,1,"み"],[31,1,"こ"],[42,1,"わか"],[44,1,"こ"]],"text":"雌じしは自分の思いが破れ、その望みを失ったのを見たので、ほかの子じしをとって、これを若い子じしとした。"},{"ref":"Ezek.19.6","start":26019006,"end":26019006,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[8,1,"ゆ"],[10,1,"き"],[13,1,"わか"],[22,2,"えもの"],[30,1,"まな"],[33,1,"ひと"],[35,1,"た"]],"text":"彼はししのうちに行き来し、若いししとなって、獲物をとることを学び、人を食べた。"},{"ref":"Ezek.19.7","start":26019007,"end":26019007,"break":"line","breaks":[[20,"line"],[31,"line"]],"ruby":[[0,1,"かれ"],[4,2,"ようがい"],[7,1,"あら"],[12,2,"まちまち"],[15,1,"ほろ"],[25,1,"こえ"],[33,1,"ち"],[37,1,"なか"],[39,1,"み"],[46,1,"みな"],[47,1,"おそ"]],"text":"彼はその要害を荒し、その町々を滅ぼした。そのほえる声によって、その地とその中に満ちるものとは皆恐れた。"},{"ref":"Ezek.19.8","start":26019008,"end":26019008,"break":"line","breaks":[[22,"line"]],"ruby":[[3,2,"くにぐに"],[6,1,"ひと"],[8,1,"かれ"],[10,1,"たい"],[13,2,"しほう"],[19,1,"もう"],[22,1,"かれ"],[24,1,"あみ"],[26,1,"う"],[31,1,"おと"],[33,1,"あな"],[35,1,"かれ"],[37,1,"とら"]],"text":"そこで国々の人は彼に対して四方にわなを設け、彼に網を打ちかけ、落し穴で彼を捕えた。"},{"ref":"Ezek.19.9","start":26019009,"end":26019009,"break":"line","breaks":[[19,"line"],[38,"line"],[50,"line"],[65,"line"]],"ruby":[[0,1,"かれ"],[16,1,"い"],[27,1,"おう"],[32,1,"つ"],[35,1,"い"],[44,1,"なか"],[46,1,"い"],[50,1,"ふたた"],[54,1,"こえ"],[62,2,"やまやま"],[65,1,"きこ"]],"text":"彼らはかぎをもって、これをかごに入れ、これをバビロンの王のもとに連れて行き、これをおりの中に入れて、再びその声をイスラエルの山々に聞えさせないようにした。"},{"ref":"Ezek.19.10","start":26019010,"end":26019010,"break":"line","breaks":[[19,"line"],[34,"line"]],"ruby":[[4,1,"はは"],[6,1,"みず"],[12,1,"うつ"],[14,1,"う"],[22,1,"はたけ"],[28,1,"き"],[34,1,"みず"],[36,1,"おお"],[41,1,"みの"],[47,1,"えだ"]],"text":"あなたの母は水のほとりに移し植えられたぶどう畑のぶどうの木のようで、水が多いために実りがよく、枝がはびこった。"},{"ref":"Ezek.19.11","start":26019011,"end":26019011,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[2,1,"つよ"],[4,1,"みき"],[6,1,"きみ"],[9,1,"もの"],[21,1,"しげ"],[24,1,"なか"],[26,1,"たか"],[32,1,"おお"],[35,1,"えだ"],[40,1,"たか"],[42,1,"み"]],"text":"その強い幹は君たる者のつえとなった。それは茂みの中に高くそびえ、多くの枝をつけて高く見えた。"},{"ref":"Ezek.19.12","start":26019012,"end":26019012,"break":"line","breaks":[[21,"line"],[39,"line"],[59,"line"]],"ruby":[[9,1,"き"],[11,1,"いきどお"],[17,1,"ぬ"],[21,1,"ち"],[23,1,"な"],[29,2,"ひがしかぜ"],[35,1,"か"],[41,1,"み"],[45,1,"と"],[51,1,"つよ"],[53,1,"みき"],[55,1,"か"],[59,1,"ひ"],[61,1,"や"],[63,1,"ほろ"]],"text":"しかしこのぶどうの木は憤りによって抜かれ、地に投げうたれ、東風がそれを枯らし、その実はもぎ取られ、その強い幹は枯れて、火に焼き滅ぼされた。"},{"ref":"Ezek.19.13","start":26019013,"end":26019013,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"いま"],[4,2,"あらの"],[13,1,"みず"],[17,1,"ち"],[19,1,"うつ"],[21,1,"う"]],"text":"今これは荒野に、かわいた、水のない地に移し植えられ、"},{"ref":"Ezek.19.14","start":26019014,"end":26019014,"break":"line","breaks":[[24,"line"],[37,"line"],[50,"line"]],"ruby":[[0,1,"ひ"],[4,1,"みき"],[7,1,"で"],[12,1,"えだ"],[14,1,"み"],[17,1,"ほろ"],[24,1,"つよ"],[26,1,"みき"],[29,1,"きみ"],[32,1,"もの"],[53,1,"かな"],[57,2,"ことば"],[62,1,"かな"],[66,1,"うた"]],"text":"火がその幹から出て、その枝と実とを滅ぼしたので、強い幹で、君たる者のつえとなるべきものはそこにない。これが悲しみの言葉、また悲しみの歌となった。"}]