[{"ref":"Eccl.2.1","start":21002001,"end":21002001,"break":"paragraph","ruby":[[4,2,"じぶん"],[7,1,"こころ"],[9,1,"い"],[17,2,"かいらく"],[28,1,"こころ"],[37,2,"ゆかい"],[40,1,"す"],[58,1,"くう"]],"text":"わたしは自分の心に言った、「さあ、快楽をもって、おまえを試みよう。おまえは愉快に過ごすがよい」と。しかし、これもまた空であった。"},{"ref":"Eccl.2.2","start":21002002,"end":21002002,"break":"none","ruby":[[4,1,"わら"],[10,1,"い"],[18,2,"きょうき"],[28,2,"かいらく"],[34,1,"い"],[42,1,"なに"]],"text":"わたしは笑いについて言った、「これは狂気である」と。また快楽について言った、「これは何をするのか」と。"},{"ref":"Eccl.2.3","start":21002003,"end":21002003,"break":"none","ruby":[[4,1,"こころ"],[6,2,"ちえ"],[16,1,"みちび"],[27,1,"さけ"],[32,2,"じぶん"],[35,2,"にくたい"],[38,2,"げんき"],[45,1,"こころ"],[52,1,"ひと"],[54,1,"こ"],[56,1,"あめ"],[58,1,"した"],[62,1,"みじか"],[64,2,"いっしょう"],[67,1,"あいだ"],[72,1,"こと"],[77,1,"よ"],[82,1,"み"],[91,1,"おろ"],[94,1,"こと"],[100,1,"こころ"]],"text":"わたしの心は知恵をもってわたしを導いているが、わたしは酒をもって自分の肉体を元気づけようと試みた。また、人の子は天が下でその短い一生の間、どんな事をしたら良いかを、見きわめるまでは、愚かな事をしようと試みた。"},{"ref":"Eccl.2.4","start":21002004,"end":21002004,"break":"none","ruby":[[4,1,"おお"],[7,2,"じぎょう"],[17,2,"じぶん"],[23,1,"いえ"],[25,1,"た"],[31,1,"ばたけ"],[33,1,"もう"]],"text":"わたしは大きな事業をした。わたしは自分のために家を建て、ぶどう畑を設け、"},{"ref":"Eccl.2.5","start":21002005,"end":21002005,"break":"none","ruby":[[0,1,"その"],[2,1,"にわ"],[13,1,"み"],[17,1,"き"],[22,1,"う"]],"text":"園と庭をつくり、またすべて実のなる木をそこに植え、"},{"ref":"Eccl.2.6","start":21002006,"end":21002006,"break":"none","ruby":[[0,1,"いけ"],[7,1,"き"],[11,1,"しげ"],[13,1,"はやし"],[20,1,"みず"],[22,1,"そそ"]],"text":"池をつくって、木のおい茂る林に、そこから水を注がせた。"},{"ref":"Eccl.2.7","start":21002007,"end":21002007,"break":"none","ruby":[[4,2,"だんじょ"],[7,2,"どれい"],[10,1,"か"],[20,1,"いえ"],[22,1,"うま"],[25,2,"どれい"],[28,1,"も"],[46,1,"さき"],[61,1,"おお"],[64,1,"うし"],[66,1,"ひつじ"],[68,2,"ざいさん"],[71,1,"も"]],"text":"わたしは男女の奴隷を買った。またわたしの家で生れた奴隷を持っていた。わたしはまた、わたしより先にエルサレムにいただれよりも多くの牛や羊の財産を持っていた。"},{"ref":"Eccl.2.8","start":21002008,"end":21002008,"break":"none","ruby":[[6,1,"ぎん"],[8,1,"きん"],[10,1,"あつ"],[13,1,"おう"],[17,2,"くにぐに"],[20,2,"ざいほう"],[23,1,"あつ"],[33,1,"うた"],[37,1,"おとこ"],[39,1,"うた"],[43,1,"おんな"],[45,1,"え"],[50,1,"ひと"],[52,1,"こ"],[54,1,"たの"],[64,1,"おお"],[66,1,"え"]],"text":"わたしはまた銀と金を集め、王たちと国々の財宝を集めた。またわたしは歌うたう男、歌うたう女を得た。また人の子の楽しみとするそばめを多く得た。"},{"ref":"Eccl.2.9","start":21002009,"end":21002009,"break":"paragraph","ruby":[[9,1,"おお"],[13,1,"もの"],[23,1,"さき"],[37,1,"もの"],[42,1,"おお"],[46,1,"もの"],[56,2,"ちえ"],[66,1,"はな"]],"text":"こうして、わたしは大いなる者となり、わたしより先にエルサレムにいたすべての者よりも、大いなる者となった。わたしの知恵もまた、わたしを離れなかった。"},{"ref":"Eccl.2.10","start":21002010,"end":21002010,"break":"none","ruby":[[8,1,"め"],[10,1,"この"],[15,2,"えんりょ"],[24,1,"こころ"],[26,1,"よろこ"],[31,1,"こば"],[42,1,"こころ"],[52,2,"ろうく"],[59,2,"かいらく"],[62,1,"え"],[84,2,"ろうく"],[90,1,"え"],[92,1,"むく"]],"text":"なんでもわたしの目の好むものは遠慮せず、わたしの心の喜ぶものは拒まなかった。わたしの心がわたしのすべての労苦によって、快楽を得たからである。そしてこれはわたしのすべての労苦によって得た報いであった。"},{"ref":"Eccl.2.11","start":21002011,"end":21002011,"break":"none","ruby":[[10,1,"て"],[19,1,"こと"],[30,1,"よう"],[33,2,"ろうく"],[36,1,"かえり"],[42,1,"み"],[45,1,"みな"],[47,1,"くう"],[53,1,"かぜ"],[55,1,"とら"],[68,1,"ひ"],[70,1,"した"],[73,1,"えき"]],"text":"そこで、わたしはわが手のなしたすべての事、およびそれをなすに要した労苦を顧みたとき、見よ、皆、空であって、風を捕えるようなものであった。日の下には益となるものはないのである。"},{"ref":"Eccl.2.12","start":21002012,"end":21002012,"break":"paragraph","ruby":[[7,1,"み"],[15,2,"ちえ"],[19,2,"きょうき"],[23,2,"ぐち"],[27,1,"み"],[35,1,"おう"],[37,1,"のち"],[39,1,"く"],[41,1,"ひと"],[43,1,"なに"],[47,1,"え"],[55,1,"かれ"],[60,1,"こと"]],"text":"わたしはまた、身をめぐらして、知恵と、狂気と、愚痴とを見た。そもそも、王の後に来る人は何をなし得ようか。すでに彼がなした事にすぎないのだ。"},{"ref":"Eccl.2.13","start":21002013,"end":21002013,"break":"none","ruby":[[0,1,"ひかり"],[2,1,"くら"],[12,2,"ちえ"],[15,2,"ぐち"],[28,1,"み"]],"text":"光が暗きにまさるように、知恵が愚痴にまさるのを、わたしは見た。"},{"ref":"Eccl.2.14","start":21002014,"end":21002014,"break":"none","ruby":[[0,2,"ちしゃ"],[3,1,"め"],[8,1,"あたま"],[16,2,"ぐしゃ"],[19,1,"くら"],[23,1,"あゆ"],[36,2,"どういつ"],[39,2,"うんめい"],[42,1,"かれ"],[49,1,"のぞ"],[54,1,"し"]],"text":"知者の目は、その頭にある。しかし愚者は暗やみを歩む。けれどもわたしはなお同一の運命が彼らのすべてに臨むことを知っている。"},{"ref":"Eccl.2.15","start":21002015,"end":21002015,"break":"none","ruby":[[4,1,"こころ"],[6,1,"い"],[11,2,"ぐしゃ"],[14,1,"のぞ"],[16,1,"こと"],[23,1,"のぞ"],[39,1,"かしこ"],[55,1,"こころ"],[57,1,"い"],[67,1,"くう"]],"text":"わたしは心に言った、「愚者に臨む事はわたしにも臨むのだ。それでどうしてわたしは賢いことがあろう」。わたしはまた心に言った、「これもまた空である」と。"},{"ref":"Eccl.2.16","start":21002016,"end":21002016,"break":"none","ruby":[[5,2,"ちしゃ"],[8,2,"ぐしゃ"],[11,2,"どうよう"],[14,1,"なが"],[16,1,"おぼ"],[33,1,"ひ"],[36,1,"みな"],[37,1,"わす"],[50,2,"ちしゃ"],[53,2,"ぐしゃ"],[56,1,"おな"],[61,1,"し"]],"text":"そもそも、知者も愚者も同様に長く覚えられるものではない。きたるべき日には皆忘れられてしまうのである。知者が愚者と同じように死ぬのは、どうしたことであろう。"},{"ref":"Eccl.2.17","start":21002017,"end":21002017,"break":"none","ruby":[[8,1,"い"],[19,1,"ひ"],[21,1,"した"],[23,1,"おこな"],[35,1,"あ"],[38,1,"み"],[47,1,"みな"],[48,1,"くう"],[54,1,"かぜ"],[56,1,"とら"]],"text":"そこで、わたしは生きることをいとった。日の下に行われるわざは、わたしに悪しく見えたからである。皆空であって、風を捕えるようである。"},{"ref":"Eccl.2.18","start":21002018,"end":21002018,"break":"paragraph","ruby":[[4,1,"ひ"],[6,1,"した"],[8,1,"ろう"],[15,2,"ろうく"],[18,1,"にく"],[26,1,"のち"],[28,1,"く"],[30,1,"ひと"],[35,1,"のこ"]],"text":"わたしは日の下で労したすべての労苦を憎んだ。わたしの後に来る人にこれを残さなければならないからである。"},{"ref":"Eccl.2.19","start":21002019,"end":21002019,"break":"none","ruby":[[6,1,"ひと"],[8,2,"ちしゃ"],[18,2,"ぐしゃ"],[29,1,"し"],[31,1,"え"],[45,1,"ひと"],[48,1,"ひ"],[50,1,"した"],[56,1,"ろう"],[61,2,"ちえ"],[64,1,"はたら"],[75,2,"ろうく"],[96,1,"くう"]],"text":"そして、その人が知者であるか、または愚者であるかは、だれが知り得よう。そうであるのに、その人が、日の下でわたしが労し、かつ知恵を働かしてなしたすべての労苦をつかさどることになるのだ。これもまた空である。"},{"ref":"Eccl.2.20","start":21002020,"end":21002020,"break":"none","ruby":[[9,1,"かえ"],[15,1,"ひ"],[17,1,"した"],[23,1,"ろう"],[30,2,"ろうく"],[37,1,"のぞ"],[40,1,"うしな"]],"text":"それでわたしはふり返ってみて、日の下でわたしが労したすべての労苦について、望みを失った。"},{"ref":"Eccl.2.21","start":21002021,"end":21002021,"break":"none","ruby":[[0,1,"いま"],[4,1,"ひと"],[10,2,"ちえ"],[13,2,"ちしき"],[16,2,"さいのう"],[22,1,"ろう"],[33,1,"ろう"],[37,1,"ひと"],[44,1,"のこ"],[50,2,"しょゆう"],[71,1,"くう"],[77,1,"おお"],[80,1,"わる"]],"text":"今ここに人があって、知恵と知識と才能をもって労しても、これがために労しない人に、すべてを残して、その所有とさせなければならないのだ。これもまた空であって、大いに悪い。"},{"ref":"Eccl.2.22","start":21002022,"end":21002022,"break":"none","ruby":[[5,1,"ひと"],[7,1,"ひ"],[9,1,"した"],[11,1,"ろう"],[18,2,"ろうく"],[24,1,"こころ"],[35,1,"え"]],"text":"そもそも、人は日の下で労するすべての労苦と、その心づかいによってなんの得るところがあるか。"},{"ref":"Eccl.2.23","start":21002023,"end":21002023,"break":"none","ruby":[[6,1,"ひ"],[10,1,"うれ"],[24,1,"くる"],[30,1,"こころ"],[32,1,"よ"],[34,1,"ま"],[36,1,"やす"],[50,1,"くう"]],"text":"そのすべての日はただ憂いのみであって、そのわざは苦しく、その心は夜の間も休まることがない。これもまた空である。"},{"ref":"Eccl.2.24","start":21002024,"end":21002024,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"く"],[4,1,"の"],[10,2,"ろうく"],[16,1,"え"],[21,1,"こころ"],[23,1,"たの"],[30,1,"よ"],[32,1,"こと"],[42,1,"かみ"],[44,1,"て"],[47,1,"で"],[57,1,"み"]],"text":"人は食い飲みし、その労苦によって得たもので心を楽しませるより良い事はない。これもまた神の手から出ることを、わたしは見た。"},{"ref":"Eccl.2.25","start":21002025,"end":21002025,"break":"none","ruby":[[3,1,"かみ"],[5,1,"はな"],[9,1,"く"],[14,1,"たの"],[23,1,"もの"]],"text":"だれが神を離れて、食い、かつ楽しむことのできる者があろう。"},{"ref":"Eccl.2.26","start":21002026,"end":21002026,"break":"none","ruby":[[0,1,"かみ"],[5,1,"こころ"],[10,1,"ひと"],[13,2,"ちえ"],[16,2,"ちしき"],[19,1,"よろこ"],[31,1,"つみ"],[36,2,"しごと"],[39,1,"あた"],[42,1,"あつ"],[49,1,"つ"],[63,1,"かみ"],[65,1,"こころ"],[70,1,"もの"],[75,1,"たま"],[89,1,"くう"],[95,1,"かぜ"],[97,1,"とら"]],"text":"神は、その心にかなう人に、知恵と知識と喜びとをくださる。しかし罪びとには仕事を与えて集めることと、積むことをさせられる。これは神の心にかなう者にそれを賜わるためである。これもまた空であって、風を捕えるようである。"}]