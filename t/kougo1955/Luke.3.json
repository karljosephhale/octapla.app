[{"ref":"Luke.3.1","start":42003001,"end":42003001,"break":"paragraph","ruby":[[0,2,"こうてい"],[6,2,"ざいい"],[9,1,"だい"],[12,1,"ねん"],[27,2,"そうとく"],[39,2,"りょうしゅ"],[44,2,"きょうだい"],[60,2,"ちほう"],[63,2,"りょうしゅ"],[76,2,"りょうしゅ"]],"text":"皇帝テベリオ在位の第十五年、ポンテオ・ピラトがユダヤの総督、ヘロデがガリラヤの領主、その兄弟ピリポがイツリヤ・テラコニテ地方の領主、ルサニヤがアビレネの領主、"},{"ref":"Luke.3.2","start":42003002,"end":42003002,"break":"none","ruby":[[10,3,"だいさいし"],[20,1,"かみ"],[22,1,"ことば"],[24,2,"あらの"],[32,1,"こ"],[37,1,"のぞ"]],"text":"アンナスとカヤパとが大祭司であったとき、神の言が荒野でザカリヤの子ヨハネに臨んだ。"},{"ref":"Luke.3.3","start":42003003,"end":42003003,"break":"none","ruby":[[0,1,"かれ"],[11,1,"ぜん"],[12,2,"ちほう"],[15,1,"い"],[19,1,"つみ"],[25,1,"え"],[29,2,"くいあらた"],[39,1,"の"],[41,1,"つた"]],"text":"彼はヨルダンのほとりの全地方に行って、罪のゆるしを得させる悔改めのバプテスマを宣べ伝えた。"},{"ref":"Luke.3.4","start":42003004,"end":42003004,"break":"none","breaks":[[32,"stanza"],[47,"line"],[56,"line"]],"ruby":[[4,3,"よげんしゃ"],[11,2,"ことば"],[14,1,"しょ"],[16,1,"か"],[33,2,"あらの"],[36,1,"よ"],[40,1,"もの"],[42,1,"こえ"],[48,1,"しゅ"],[50,1,"みち"],[52,1,"そな"],[58,1,"みち"],[59,1,"すじ"]],"text":"それは、預言者イザヤの言葉の書に書いてあるとおりである。すなわち「荒野で呼ばわる者の声がする、『主の道を備えよ、その道筋をまっすぐにせよ』。"},{"ref":"Luke.3.5","start":42003005,"end":42003005,"break":"line","breaks":[[11,"line"],[27,"line"],[40,"line"]],"ruby":[[4,1,"たに"],[6,1,"う"],[15,1,"やま"],[17,1,"おか"],[21,1,"たい"],[27,1,"まが"],[43,1,"みち"]],"text":"すべての谷は埋められ、すべての山と丘とは、平らにされ、曲ったところはまっすぐに、わるい道はならされ、"},{"ref":"Luke.3.6","start":42003006,"end":42003006,"break":"line","ruby":[[0,1,"ひと"],[4,1,"かみ"],[6,1,"すくい"],[8,1,"み"]],"text":"人はみな神の救を見るであろう」。"},{"ref":"Luke.3.7","start":42003007,"end":42003007,"break":"none","ruby":[[8,1,"かれ"],[17,1,"う"],[24,1,"で"],[28,2,"ぐんしゅう"],[35,1,"い"],[44,1,"こ"],[48,1,"せま"],[55,1,"かみ"],[57,1,"いか"],[79,1,"おし"]],"text":"さて、ヨハネは、彼からバプテスマを受けようとして出てきた群衆にむかって言った、「まむしの子らよ、迫ってきている神の怒りから、のがれられると、おまえたちにだれが教えたのか。"},{"ref":"Luke.3.8","start":42003008,"end":42003008,"break":"none","ruby":[[4,2,"くいあらた"],[13,1,"み"],[15,1,"むす"],[18,2,"じぶん"],[23,1,"ちち"],[38,1,"こころ"],[40,1,"なか"],[42,1,"おも"],[56,1,"い"],[62,1,"かみ"],[68,1,"いし"],[82,1,"こ"],[84,1,"おこ"]],"text":"だから、悔改めにふさわしい実を結べ。自分たちの父にはアブラハムがあるなどと、心の中で思ってもみるな。おまえたちに言っておく。神はこれらの石ころからでも、アブラハムの子を起すことができるのだ。"},{"ref":"Luke.3.9","start":42003009,"end":42003009,"break":"none","ruby":[[0,1,"おの"],[5,1,"き"],[7,1,"ね"],[11,1,"お"],[22,1,"よ"],[24,1,"み"],[26,1,"むす"],[30,1,"き"],[37,1,"き"],[42,1,"ひ"],[44,1,"なか"],[46,1,"な"],[48,1,"こ"]],"text":"斧がすでに木の根もとに置かれている。だから、良い実を結ばない木はことごとく切られて、火の中に投げ込まれるのだ」。"},{"ref":"Luke.3.10","start":42003010,"end":42003010,"break":"none","ruby":[[3,2,"ぐんしゅう"],[6,1,"かれ"],[21,1,"なに"],[34,1,"たず"]],"text":"そこで群衆が彼に、「それでは、わたしたちは何をすればよいのですか」と尋ねた。"},{"ref":"Luke.3.11","start":42003011,"end":42003011,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こた"],[5,1,"い"],[10,2,"したぎ"],[14,1,"まい"],[20,1,"もの"],[23,1,"も"],[27,1,"もの"],[29,1,"わ"],[38,2,"しょくもつ"],[41,1,"も"],[46,1,"もの"],[48,2,"どうよう"]],"text":"彼は答えて言った、「下着を二枚もっている者は、持たない者に分けてやりなさい。食物を持っている者も同様にしなさい」。"},{"ref":"Luke.3.12","start":42003012,"end":42003012,"break":"none","ruby":[[0,3,"しゅぜいにん"],[10,1,"う"],[16,1,"かれ"],[18,1,"い"],[23,2,"せんせい"],[32,1,"なに"]],"text":"取税人もバプテスマを受けにきて、彼に言った、「先生、わたしたちは何をすればよいのですか」。"},{"ref":"Luke.3.13","start":42003013,"end":42003013,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[16,2,"いじょう"],[19,1,"と"],[21,1,"た"]],"text":"彼らに言った、「きまっているもの以上に取り立ててはいけない」。"},{"ref":"Luke.3.14","start":42003014,"end":42003014,"break":"none","ruby":[[0,2,"へいそつ"],[9,1,"い"],[23,1,"なに"],[36,1,"かれ"],[38,1,"い"],[43,1,"ひと"],[55,1,"と"],[67,2,"じぶん"],[70,2,"きゅうよ"],[73,2,"まんぞく"]],"text":"兵卒たちもたずねて言った、「では、わたしたちは何をすればよいのですか」。彼は言った、「人をおどかしたり、だまし取ったりしてはいけない。自分の給与で満足していなさい」。"},{"ref":"Luke.3.15","start":42003015,"end":42003015,"break":"paragraph","ruby":[[0,2,"みんしゅう"],[3,2,"すくいぬし"],[6,1,"ま"],[8,1,"のぞ"],[18,1,"こころ"],[20,1,"なか"],[38,1,"ひと"],[50,1,"かんが"]],"text":"民衆は救主を待ち望んでいたので、みな心の中でヨハネのことを、もしかしたらこの人がそれではなかろうかと考えていた。"},{"ref":"Luke.3.16","start":42003016,"end":42003016,"break":"none","ruby":[[11,1,"もの"],[17,1,"い"],[26,1,"みず"],[40,1,"さづ"],[51,1,"ちから"],[80,1,"と"],[82,1,"ね"],[95,2,"せいれい"],[98,1,"ひ"],[117,1,"さづ"]],"text":"そこでヨハネはみんなの者にむかって言った、「わたしは水でおまえたちにバプテスマを授けるが、わたしよりも力のあるかたが、おいでになる。わたしには、そのくつのひもを解く値うちもない。このかたは、聖霊と火とによっておまえたちにバプテスマをお授けになるであろう。"},{"ref":"Luke.3.17","start":42003017,"end":42003017,"break":"none","ruby":[[3,1,"み"],[5,1,"て"],[7,1,"も"],[11,1,"う"],[13,1,"ば"],[15,1,"むぎ"],[20,1,"わ"],[23,1,"むぎ"],[25,1,"くら"],[27,1,"おさ"],[33,1,"き"],[37,1,"ひ"],[39,1,"や"],[41,1,"す"]],"text":"また、箕を手に持って、打ち場の麦をふるい分け、麦は倉に納め、からは消えない火で焼き捨てるであろう」。"},{"ref":"Luke.3.18","start":42003018,"end":42003018,"break":"paragraph","ruby":[[20,1,"すす"],[26,2,"みんしゅう"],[29,1,"おしえ"],[31,1,"と"]],"text":"こうしてヨハネはほかにもなお、さまざまの勧めをして、民衆に教を説いた。"},{"ref":"Luke.3.19","start":42003019,"end":42003019,"break":"none","ruby":[[4,2,"りょうしゅ"],[11,2,"きょうだい"],[14,1,"つま"],[26,2,"じぶん"],[35,2,"あくじ"],[47,2,"ひなん"]],"text":"ところが領主ヘロデは、兄弟の妻ヘロデヤのことで、また自分がしたあらゆる悪事について、ヨハネから非難されていたので、"},{"ref":"Luke.3.20","start":42003020,"end":42003020,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ごく"],[4,1,"と"],[6,1,"こ"],[15,2,"あくじ"],[18,1,"うえ"],[27,2,"あくじ"],[30,1,"かさ"]],"text":"彼を獄に閉じ込めて、いろいろな悪事の上に、もう一つこの悪事を重ねた。"},{"ref":"Luke.3.21","start":42003021,"end":42003021,"break":"paragraph","ruby":[[3,2,"みんしゅう"],[14,1,"う"],[30,1,"う"],[33,1,"いの"],[42,1,"てん"],[44,1,"ひら"]],"text":"さて、民衆がみなバプテスマを受けたとき、イエスもバプテスマを受けて祈っておられると、天が開けて、"},{"ref":"Luke.3.22","start":42003022,"end":42003022,"break":"none","ruby":[[0,2,"せいれい"],[9,1,"すがた"],[18,1,"うえ"],[20,1,"くだ"],[26,1,"てん"],[29,1,"こえ"],[43,1,"あい"],[46,1,"こ"],[52,1,"こころ"],[57,1,"もの"]],"text":"聖霊がはとのような姿をとってイエスの上に下り、そして天から声がした、「あなたはわたしの愛する子、わたしの心にかなう者である」。"},{"ref":"Luke.3.23","start":42003023,"end":42003023,"break":"paragraph","ruby":[[4,2,"せんきょう"],[16,1,"とし"],[22,1,"さい"],[24,1,"とき"],[30,2,"ひとびと"],[33,1,"かんが"],[44,1,"こ"],[57,1,"こ"]],"text":"イエスが宣教をはじめられたのは、年およそ三十歳の時であって、人々の考えによれば、ヨセフの子であった。ヨセフはヘリの子、"},{"ref":"Luke.3.24","start":42003024,"end":42003024,"break":"none","text":"それから、さかのぼって、マタテ、レビ、メルキ、ヤンナイ、ヨセフ、"},{"ref":"Luke.3.25","start":42003025,"end":42003025,"break":"none","text":"マタテヤ、アモス、ナホム、エスリ、ナンガイ、"},{"ref":"Luke.3.26","start":42003026,"end":42003026,"break":"none","text":"マハテ、マタテヤ、シメイ、ヨセク、ヨダ、"},{"ref":"Luke.3.27","start":42003027,"end":42003027,"break":"none","text":"ヨハナン、レサ、ゾロバベル、サラテル、ネリ、"},{"ref":"Luke.3.28","start":42003028,"end":42003028,"break":"none","text":"メルキ、アデイ、コサム、エルマダム、エル、"},{"ref":"Luke.3.29","start":42003029,"end":42003029,"break":"none","text":"ヨシュア、エリエゼル、ヨリム、マタテ、レビ、"},{"ref":"Luke.3.30","start":42003030,"end":42003030,"break":"none","text":"シメオン、ユダ、ヨセフ、ヨナム、エリヤキム、"},{"ref":"Luke.3.31","start":42003031,"end":42003031,"break":"none","text":"メレヤ、メナ、マタタ、ナタン、ダビデ、"},{"ref":"Luke.3.32","start":42003032,"end":42003032,"break":"none","text":"エッサイ、オベデ、ボアズ、サラ、ナアソン、"},{"ref":"Luke.3.33","start":42003033,"end":42003033,"break":"none","text":"アミナダブ、アデミン、アルニ、エスロン、パレス、ユダ、"},{"ref":"Luke.3.34","start":42003034,"end":42003034,"break":"none","text":"ヤコブ、イサク、アブラハム、テラ、ナホル、"},{"ref":"Luke.3.35","start":42003035,"end":42003035,"break":"none","text":"セルグ、レウ、ペレグ、エベル、サラ、"},{"ref":"Luke.3.36","start":42003036,"end":42003036,"break":"none","text":"カイナン、アルパクサデ、セム、ノア、ラメク、"},{"ref":"Luke.3.37","start":42003037,"end":42003037,"break":"none","text":"メトセラ、エノク、ヤレデ、マハラレル、カイナン、"},{"ref":"Luke.3.38","start":42003038,"end":42003038,"break":"none","ruby":[[14,1,"かみ"]],"text":"エノス、セツ、アダム、そして神にいたる。"}]