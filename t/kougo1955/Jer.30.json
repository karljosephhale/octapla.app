[{"ref":"Jer.30.1","start":24030001,"end":24030001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"のぞ"],[11,2,"ことば"]],"text":"主からエレミヤに臨んだ言葉。"},{"ref":"Jer.30.2","start":24030002,"end":24030002,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[13,1,"おお"],[27,1,"かた"],[30,2,"ことば"],[39,2,"しょもつ"]],"text":"「イスラエルの神、主はこう仰せられる、わたしがあなたに語った言葉を、ことごとく書物にしるしなさい。"},{"ref":"Jer.30.3","start":24030003,"end":24030003,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"み"],[16,1,"たみ"],[26,2,"はんえい"],[29,2,"かいふく"],[33,1,"ひ"],[35,1,"く"],[38,1,"しゅ"],[43,1,"い"],[52,1,"かれ"],[58,2,"せんぞ"],[61,1,"あた"],[64,1,"ち"],[66,1,"かえ"],[70,1,"かれ"],[76,1,"たも"]],"text":"主は言われる、見よ、わたしがわが民イスラエルとユダの繁栄を回復する日が来る。主がこれを言われる。わたしは彼らを、その先祖に与えた地に帰らせ、彼らにこれを保たせる」。"},{"ref":"Jer.30.4","start":24030004,"end":24030004,"break":"paragraph","ruby":[[3,1,"しゅ"],[17,1,"い"],[21,2,"ことば"]],"text":"これは主がイスラエルとユダについて言われた言葉である。"},{"ref":"Jer.30.5","start":24030005,"end":24030005,"break":"stanza","breaks":[[11,"line"],[27,"line"]],"ruby":[[1,1,"しゅ"],[5,1,"おお"],[21,1,"こえ"],[23,1,"き"],[27,1,"おそ"],[33,2,"へいあん"]],"text":"「主はこう仰せられる、われわれはおののきの声を聞いた。恐れがあり、平安はない。"},{"ref":"Jer.30.6","start":24030006,"end":24030006,"break":"line","breaks":[[16,"line"],[33,"line"],[50,"line"]],"ruby":[[0,1,"こ"],[2,1,"う"],[4,1,"おとこ"],[10,1,"たず"],[20,1,"おとこ"],[24,1,"こ"],[26,1,"う"],[28,1,"おんな"],[33,1,"て"],[35,1,"こし"],[45,1,"み"],[55,1,"ひと"],[57,2,"かおいろ"],[60,1,"あお"],[62,1,"かわ"]],"text":"子を産む男があるか、尋ねてみよ。どうして男がみな子を産む女のように手を腰におくのをわたしは見るのか。なぜ、どの人の顔色も青く変っているのか。"},{"ref":"Jer.30.7","start":24030007,"end":24030007,"break":"line","breaks":[[20,"line"],[33,"line"],[48,"line"]],"ruby":[[0,1,"かな"],[8,1,"ひ"],[10,1,"おお"],[14,1,"ひ"],[23,1,"くら"],[28,1,"ひ"],[40,1,"なや"],[43,1,"とき"],[51,1,"かれ"],[57,1,"すく"],[59,1,"だ"]],"text":"悲しいかな、その日は大いなる日であって、それに比べるべき日はない。それはヤコブの悩みの時である。しかし彼はそれから救い出される。"},{"ref":"Jer.30.8","start":24030008,"end":24030008,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"おお"],[13,1,"ひ"],[18,1,"かれ"],[21,1,"くび"],[30,1,"くだ"],[32,1,"はな"],[35,1,"かれ"],[38,2,"そくばく"],[41,1,"と"],[44,2,"いほう"],[47,1,"ひと"],[53,1,"かれ"],[56,2,"しえき"]],"text":"万軍の主は仰せられる、その日わたしは彼らの首からそのくびきを砕き離し、彼らの束縛を解く。異邦の人はもはや、彼らを使役することをしない。"},{"ref":"Jer.30.9","start":24030009,"end":24030009,"break":"none","ruby":[[0,1,"かれ"],[5,1,"かみ"],[7,1,"しゅ"],[14,1,"かれ"],[20,1,"た"],[25,1,"おう"],[30,1,"つか"]],"text":"彼らはその神、主と、わたしが彼らのために立てるその王ダビデに仕える。"},{"ref":"Jer.30.10","start":24030010,"end":24030010,"break":"stanza","breaks":[[8,"line"],[27,"line"],[42,"line"],[65,"line"],[76,"line"],[94,"line"],[115,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おお"],[18,1,"おそ"],[34,1,"おどろ"],[42,1,"み"],[53,1,"すく"],[57,1,"とお"],[69,2,"しそん"],[72,1,"すく"],[78,1,"とら"],[80,1,"うつ"],[84,1,"ち"],[98,1,"かえ"],[104,1,"おだ"],[108,1,"やす"],[115,1,"かれ"],[117,1,"おそ"],[122,1,"もの"]],"text":"主は仰せられる、わがしもべヤコブよ、恐れることはない、イスラエルよ、驚くことはない。見よ、わたしがあなたを救って、遠くからかえし、あなたの子孫を救って、その捕え移された地からかえすからだ。ヤコブは帰ってきて、穏やかに安らかにおり、彼を恐れさせる者はない。"},{"ref":"Jer.30.11","start":24030011,"end":24030011,"break":"line","breaks":[[7,"line"],[27,"line"],[42,"line"],[53,"line"],[73,"line"],[95,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[15,1,"とも"],[24,1,"すく"],[35,1,"ち"],[39,2,"くにぐに"],[47,1,"ほろ"],[50,1,"つく"],[61,1,"ほろ"],[64,1,"つく"],[77,1,"ただ"],[80,1,"みち"],[82,1,"したが"],[89,1,"こ"],[95,1,"けっ"],[98,1,"ばっ"]],"text":"主は言われる、わたしはあなたと共にいて、あなたを救う。わたしはあなたを散らした国々をことごとく滅ぼし尽す。しかし、あなたを滅ぼし尽すことはしない。わたしは正しい道に従ってあなたを懲らしめる。決して罰しないではおかない。"},{"ref":"Jer.30.12","start":24030012,"end":24030012,"break":"stanza","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"おお"],[14,1,"いた"],[25,1,"きず"],[27,1,"おも"]],"text":"主はこう仰せられる、あなたの痛みはいえず、あなたの傷は重い。"},{"ref":"Jer.30.13","start":24030013,"end":24030013,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[4,1,"うった"],[7,2,"しじ"],[11,1,"もの"],[20,1,"きず"],[25,1,"くすり"]],"text":"あなたの訴えを支持する者はなく、あなたの傷をつつむ薬はなく、あなたをいやすものもない。"},{"ref":"Jer.30.14","start":24030014,"end":24030014,"break":"line","breaks":[[17,"line"],[30,"line"],[44,"line"],[59,"line"],[78,"line"]],"ruby":[[4,1,"あい"],[7,1,"もの"],[9,1,"みな"],[14,1,"わす"],[21,1,"こと"],[23,1,"こころ"],[25,1,"と"],[41,1,"おお"],[48,1,"つみ"],[66,1,"う"],[75,1,"う"],[78,2,"ざんにん"],[81,1,"てき"],[86,1,"こ"]],"text":"あなたの愛する者は皆あなたを忘れてあなたの事を心に留めない。それは、あなたのとがが多く、あなたの罪がはなはだしいので、わたしがあだを撃つようにあなたを撃ち、残忍な敵のように懲らしたからだ。"},{"ref":"Jer.30.15","start":24030015,"end":24030015,"break":"line","breaks":[[17,"line"],[33,"line"],[43,"line"],[58,"line"]],"ruby":[[7,1,"きず"],[12,1,"さけ"],[21,1,"なや"],[40,1,"おお"],[47,1,"つみ"],[62,1,"こと"]],"text":"なぜ、あなたの傷のために叫ぶのか、あなたの悩みはいえることはない。あなたのとがが多く、あなたの罪がはなはだしいので、これらの事をわたしはあなたにしたのである。"},{"ref":"Jer.30.16","start":24030016,"end":24030016,"break":"line","breaks":[[18,"line"],[25,"line"],[37,"line"],[50,"line"],[67,"line"]],"ruby":[[11,1,"く"],[13,1,"ほろ"],[16,1,"もの"],[18,1,"く"],[20,1,"ほろ"],[34,1,"もの"],[40,1,"のこ"],[44,1,"とら"],[46,1,"うつ"],[58,1,"もの"],[74,1,"もの"],[76,1,"うば"],[78,1,"もの"],[80,1,"うば"],[84,1,"もの"]],"text":"しかし、すべてあなたを食い滅ぼす者は食い滅ぼされ、あなたをしえたげる者は、ひとり残らず、捕え移され、あなたをかすめる者は、かすめられ、すべてあなたの物を奪う者は奪われる者となる。"},{"ref":"Jer.30.17","start":24030017,"end":24030017,"break":"line","breaks":[[7,"line"],[23,"line"],[33,"line"],[53,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[15,2,"けんこう"],[18,2,"かいふく"],[27,1,"きず"],[37,1,"ひと"],[43,1,"す"],[48,1,"もの"],[57,1,"こころ"],[59,1,"と"]],"text":"主は言われる、わたしはあなたの健康を回復させ、あなたの傷をいやす。それは、人があなたを捨てられた者とよび、『だれも心に留めないシオン』というからである。"},{"ref":"Jer.30.18","start":24030018,"end":24030018,"break":"stanza","breaks":[[10,"line"],[31,"line"],[45,"line"],[59,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"おお"],[10,1,"み"],[21,2,"てんまく"],[24,1,"ふたた"],[26,1,"さか"],[42,1,"ほどこ"],[45,1,"まち"],[50,1,"おか"],[52,1,"た"],[59,2,"きゅうでん"],[64,1,"た"],[69,1,"ところ"],[71,1,"た"]],"text":"主はこう仰せられる、見よ、わたしはヤコブの天幕を再び栄えさせ、そのすまいにあわれみを施す。町は、その丘に建てなおされ、宮殿はもと立っていた所に立つ。"},{"ref":"Jer.30.19","start":24030019,"end":24030019,"break":"line","breaks":[[21,"line"],[43,"line"],[57,"line"]],"ruby":[[0,2,"かんしゃ"],[3,1,"うた"],[5,1,"よろこ"],[7,1,"もの"],[9,1,"こえ"],[15,1,"なか"],[18,1,"で"],[25,1,"かれ"],[28,1,"ま"],[33,1,"かれ"],[36,1,"すく"],[45,1,"かれ"],[48,1,"たっと"],[57,1,"いや"]],"text":"感謝の歌と喜ぶ者の声とが、その中から出る。わたしが彼らを増すゆえ、彼らは少なくはなく、また彼らを尊ばれしめるゆえ、卑しめられることはない。"},{"ref":"Jer.30.20","start":24030020,"end":24030020,"break":"line","breaks":[[17,"line"],[33,"line"]],"ruby":[[2,1,"こ"],[19,2,"かいしゅう"],[26,1,"まえ"],[28,1,"かた"],[30,1,"た"],[36,1,"かれ"],[44,1,"もの"],[50,1,"ばっ"]],"text":"その子らは、いにしえのようになり、その会衆はわたしの前に堅く立つ。すべて彼らをしえたげる者をわたしは罰する。"},{"ref":"Jer.30.21","start":24030021,"end":24030021,"break":"line","breaks":[[19,"line"],[35,"line"],[59,"line"],[70,"line"],[84,"line"]],"ruby":[[2,1,"きみ"],[4,1,"かれ"],[6,2,"じしん"],[32,1,"で"],[39,1,"かれ"],[45,1,"ちか"],[49,1,"かれ"],[55,1,"ちか"],[62,2,"じぶん"],[65,1,"いのち"],[74,1,"ちか"],[77,1,"もの"],[84,1,"しゅ"],[86,1,"い"]],"text":"その君は彼ら自身のうちのひとりであり、そのつかさは、そのうちから出る。わたしは彼をわたしに近づけ、彼はわたしに近づく。だれか自分の命をかけてわたしに近づく者があろうかと主は言われる。"},{"ref":"Jer.30.22","start":24030022,"end":24030022,"break":"line","breaks":[[16,"line"]],"ruby":[[11,1,"たみ"],[26,1,"かみ"]],"text":"あなたがたは、わたしの民となり、わたしはあなたがたの神となる」。"},{"ref":"Jer.30.23","start":24030023,"end":24030023,"break":"stanza","breaks":[[11,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,2,"ぼうふう"],[11,1,"いきどお"],[18,1,"かぜ"],[20,1,"で"],[23,2,"あくにん"]],"text":"見よ、主の暴風がくる。憤りと、つむじ風が出て、悪人のこうべをうつ。"},{"ref":"Jer.30.24","start":24030024,"end":24030024,"break":"line","breaks":[[9,"line"],[26,"line"],[43,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"はげ"],[5,1,"いか"],[10,1,"こころ"],[12,1,"おも"],[14,1,"さだ"],[22,1,"おこな"],[29,1,"と"],[35,1,"しりぞ"],[43,1,"すえ"],[45,1,"ひ"],[56,1,"さと"]],"text":"主の激しい怒りは、み心に思い定められたことを行って、これを遂げるまで、退くことはない。末の日にあなたがたはこれを悟るのである。"}]