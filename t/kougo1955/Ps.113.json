[{"ref":"Ps.113.1","start":19113001,"end":19113001,"break":"paragraph","breaks":[[9,"line"],[25,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"しゅ"],[25,1,"しゅ"],[28,1,"な"]],"text":"主をほめたたえよ。主のしもべたちよ、ほめたたえよ。主のみ名をほめたたえよ。"},{"ref":"Ps.113.2","start":19113002,"end":19113002,"break":"line","ruby":[[0,1,"いま"],[9,1,"いた"],[13,1,"しゅ"],[16,1,"な"]],"text":"今より、とこしえに至るまで主のみ名はほむべきかな。"},{"ref":"Ps.113.3","start":19113003,"end":19113003,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ひ"],[10,1,"ひ"],[12,1,"い"],[20,1,"しゅ"],[23,1,"な"]],"text":"日のいずるところから日の入るところまで、主のみ名はほめたたえられる。"},{"ref":"Ps.113.4","start":19113004,"end":19113004,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"くにたみ"],[10,1,"うえ"],[12,1,"たか"],[22,2,"えいこう"],[25,1,"てん"],[29,1,"たか"]],"text":"主はもろもろの国民の上に高くいらせられ、その栄光は天よりも高い。"},{"ref":"Ps.113.5","start":19113005,"end":19113005,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かみ"],[6,1,"しゅ"],[13,1,"もの"],[19,1,"しゅ"],[21,1,"たか"],[23,1,"ところ"],[25,1,"ざ"]],"text":"われらの神、主にくらぶべき者はだれか。主は高き所に座し、"},{"ref":"Ps.113.6","start":19113006,"end":19113006,"break":"line","ruby":[[0,1,"とお"],[2,1,"てん"],[4,1,"ち"],[7,1,"み"]],"text":"遠く天と地とを見おろされる。"},{"ref":"Ps.113.7","start":19113007,"end":19113007,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"まず"],[5,1,"もの"],[14,1,"とぼ"],[17,1,"もの"]],"text":"主は貧しい者をちりからあげ、乏しい者をあくたからあげて、"},{"ref":"Ps.113.8","start":19113008,"end":19113008,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"きみ"],[9,1,"とも"],[18,1,"たみ"],[20,1,"きみ"],[24,1,"とも"]],"text":"もろもろの君たちと共にすわらせ、その民の君たちと共にすわらせられる。"},{"ref":"Ps.113.9","start":19113009,"end":19113009,"break":"line","breaks":[[15,"line"],[33,"line"]],"ruby":[[2,1,"こ"],[4,1,"う"],[7,1,"おんな"],[9,2,"かてい"],[12,1,"あた"],[15,1,"おお"],[18,2,"こども"],[23,1,"よろこ"],[27,1,"はは"],[33,1,"しゅ"]],"text":"また子を産まぬ女に家庭を与え、多くの子供たちの喜ばしい母とされる。主をほめたたえよ。"}]