[{"ref":"Job.12.1","start":18012001,"end":18012001,"break":"paragraph","ruby":[[6,1,"こた"],[9,1,"い"]],"text":"そこでヨブは答えて言った、"},{"ref":"Job.12.2","start":18012002,"end":18012002,"break":"stanza","breaks":[[19,"line"]],"ruby":[[14,1,"ひと"],[19,2,"ちえ"],[28,1,"とも"],[30,1,"し"]],"text":"「まことに、あなたがたのみ、人である、知恵はあなたがたと共に死ぬであろう。"},{"ref":"Job.12.3","start":18012003,"end":18012003,"break":"line","breaks":[[23,"line"],[38,"line"]],"ruby":[[14,2,"どうよう"],[17,1,"さと"],[33,1,"おと"],[46,1,"こと"],[48,1,"し"]],"text":"しかしわたしも、あなたがたと同様に悟りをもつ。わたしはあなたがたに劣らない。だれがこのような事を知らないだろうか。"},{"ref":"Job.12.4","start":18012004,"end":18012004,"break":"line","breaks":[[23,"line"],[37,"line"]],"ruby":[[4,1,"かみ"],[6,1,"よ"],[12,1,"き"],[16,1,"もの"],[25,1,"とも"],[27,2,"ものわら"],[37,1,"ただ"],[40,1,"まった"],[42,1,"ひと"],[44,2,"ものわら"]],"text":"わたしは神に呼ばわって、聞かれた者であるのに、その友の物笑いとなっている。正しく全き人は物笑いとなる。"},{"ref":"Job.12.5","start":18012005,"end":18012005,"break":"line","breaks":[[11,"line"],[26,"line"]],"ruby":[[0,1,"やす"],[4,1,"もの"],[6,1,"おも"],[11,2,"ふこう"],[14,1,"もの"],[16,1,"たい"],[19,1,"あなど"],[26,1,"あし"],[31,1,"もの"],[33,1,"ま"]],"text":"安らかな者の思いには、不幸な者に対する侮りがあって、足のすべる者を待っている。"},{"ref":"Job.12.6","start":18012006,"end":18012006,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[3,1,"うば"],[5,1,"もの"],[7,2,"てんまく"],[10,1,"さか"],[13,1,"かみ"],[15,1,"いか"],[18,1,"もの"],[20,1,"やす"],[27,2,"じぶん"],[30,1,"て"],[32,1,"かみ"],[34,1,"たずさ"],[39,1,"もの"],[41,2,"どうよう"]],"text":"かすめ奪う者の天幕は栄え、神を怒らす者は安らかである。自分の手に神を携えている者も同様だ。"},{"ref":"Job.12.7","start":18012007,"end":18012007,"break":"stanza","breaks":[[11,"line"],[22,"line"],[32,"line"]],"ruby":[[3,1,"けもの"],[5,1,"と"],[18,1,"おし"],[22,1,"そら"],[24,1,"とり"],[26,1,"と"],[39,1,"つ"]],"text":"しかし獣に問うてみよ、それはあなたに教える。空の鳥に問うてみよ、それはあなたに告げる。"},{"ref":"Job.12.8","start":18012008,"end":18012008,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[4,1,"ち"],[6,1,"くさ"],[8,1,"き"],[10,1,"と"],[16,1,"かれ"],[23,1,"おし"],[27,1,"うみ"],[29,1,"うお"],[37,1,"しめ"]],"text":"あるいは地の草や木に問うてみよ、彼らはあなたに教える。海の魚もまたあなたに示す。"},{"ref":"Job.12.9","start":18012009,"end":18012009,"break":"line","breaks":[[17,"line"]],"ruby":[[17,1,"しゅ"],[19,1,"て"],[30,1,"し"],[33,1,"もの"]],"text":"これらすべてのもののうち、いずれか主の手がこれをなしたことを知らぬ者があろうか。"},{"ref":"Job.12.10","start":18012010,"end":18012010,"break":"line","breaks":[[10,"line"]],"ruby":[[4,1,"い"],[6,1,"もの"],[8,1,"いのち"],[17,1,"ひと"],[19,1,"いき"],[21,1,"かれ"],[23,1,"て"]],"text":"すべての生き物の命、およびすべての人の息は彼の手のうちにある。"},{"ref":"Job.12.11","start":18012011,"end":18012011,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"くち"],[2,2,"しょくもつ"],[5,1,"あじ"],[12,1,"みみ"],[14,2,"ことば"]],"text":"口が食物を味わうように、耳は言葉をわきまえないであろうか。"},{"ref":"Job.12.12","start":18012012,"end":18012012,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"お"],[3,1,"もの"],[6,2,"ちえ"],[12,1,"いのち"],[14,1,"なが"],[16,1,"もの"],[19,1,"さと"]],"text":"老いた者には知恵があり、命の長い者には悟りがある。"},{"ref":"Job.12.13","start":18012013,"end":18012013,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"ちから"],[5,1,"かみ"],[7,1,"とも"],[12,2,"しんりょ"],[15,1,"さと"],[18,1,"かれ"]],"text":"知恵と力は神と共にあり、深慮と悟りも彼のものである。"},{"ref":"Job.12.14","start":18012014,"end":18012014,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[2,2,"はかい"],[8,1,"ふたた"],[10,1,"た"],[21,1,"かれ"],[23,1,"ひと"],[25,1,"と"],[27,1,"こ"],[32,1,"ひら"],[34,1,"だ"]],"text":"彼が破壊すれば、再び建てることができない。彼が人を閉じ込めれば、開き出すことができない。"},{"ref":"Job.12.15","start":18012015,"end":18012015,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[2,1,"みず"],[4,1,"と"],[15,1,"かれ"],[17,1,"みず"],[19,1,"だ"],[23,1,"ち"]],"text":"彼が水を止めれば、それはかれ、彼が水を出せば、地をくつがえす。"},{"ref":"Job.12.16","start":18012016,"end":18012016,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ちから"],[2,1,"ふか"],[4,2,"ちえ"],[7,1,"かれ"],[9,1,"とも"],[14,1,"まど"],[19,1,"もの"],[21,1,"まど"],[24,1,"もの"],[26,1,"かれ"]],"text":"力と深き知恵は彼と共にあり、惑わされる者も惑わす者も彼のものである。"},{"ref":"Job.12.17","start":18012017,"end":18012017,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ぎ"],[3,1,"し"],[7,1,"はだか"],[11,1,"つ"],[13,1,"い"],[23,1,"おろ"]],"text":"彼は議士たちを裸にして連れ行き、さばきびとらを愚かにし、"},{"ref":"Job.12.18","start":18012018,"end":18012018,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"おう"],[8,1,"と"],[11,1,"かれ"],[14,1,"こし"],[16,2,"こしおび"],[19,1,"ま"]],"text":"王たちのきずなを解き、彼らの腰に腰帯を巻き、"},{"ref":"Job.12.19","start":18012019,"end":18012019,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"さいし"],[5,1,"はだか"],[9,1,"つ"],[11,1,"い"],[14,1,"ちから"],[17,1,"もの"],[19,1,"ほろ"]],"text":"祭司たちを裸にして連れ行き、力ある者を滅ぼし、"},{"ref":"Job.12.20","start":18012020,"end":18012020,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"たの"],[6,1,"もの"],[10,2,"ことば"],[13,1,"うば"],[16,2,"ちょうろう"],[21,2,"ふんべつ"],[24,1,"と"],[26,1,"さ"]],"text":"みずから頼む者たちの言葉を奪い、長老たちの分別を取り去り、"},{"ref":"Job.12.21","start":18012021,"end":18012021,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"きみ"],[4,1,"うえ"],[6,1,"あなど"],[9,1,"そそ"],[12,1,"つよ"],[14,1,"もの"],[18,1,"おび"],[20,1,"と"]],"text":"君たちの上に侮りを注ぎ、強い者たちの帯を解き、"},{"ref":"Job.12.22","start":18012022,"end":18012022,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"くら"],[4,1,"なか"],[7,1,"かく"],[10,1,"こと"],[19,2,"あんこく"],[22,1,"ひかり"],[24,1,"ひ"],[26,1,"だ"]],"text":"暗やみの中から隠れた事どもをあらわし、暗黒を光に引き出し、"},{"ref":"Job.12.23","start":18012023,"end":18012023,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"くにぐに"],[3,1,"おお"],[13,1,"ほろ"],[17,2,"くにぐに"],[20,1,"ひろ"],[26,1,"とら"],[28,1,"い"]],"text":"国々を大きくし、またこれを滅ぼし、国々を広くし、また捕え行き、"},{"ref":"Job.12.24","start":18012024,"end":18012024,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ち"],[2,1,"たみ"],[4,1,"ちょう"],[8,1,"さと"],[11,1,"うば"],[14,1,"かれ"],[17,1,"みち"],[20,2,"あらの"]],"text":"地の民の長たちの悟りを奪い、彼らを道なき荒野にさまよわせ、"},{"ref":"Job.12.25","start":18012025,"end":18012025,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ひかり"],[3,1,"くら"],[7,2,"てさぐ"],[13,1,"よ"],[16,1,"もの"]],"text":"光なき暗やみに手探りさせ、酔うた者のようによろめかせる。"}]