[{"ref":"2Kgs.12.1","start":12012001,"end":12012001,"break":"paragraph","ruby":[[8,1,"だい"],[10,1,"ねん"],[12,1,"くらい"],[25,1,"ねん"],[27,1,"あいだ"],[29,1,"よ"],[31,1,"おさ"],[37,1,"はは"],[45,2,"しゅっしん"],[49,1,"な"]],"text":"ヨアシはエヒウの第七年に位につき、エルサレムで四十年の間、世を治めた。その母はベエルシバの出身で、名をヂビアといった。"},{"ref":"2Kgs.12.2","start":12012002,"end":12012002,"break":"none","ruby":[[4,2,"いっしょう"],[7,1,"あいだ"],[9,1,"しゅ"],[11,1,"め"],[16,1,"こと"],[24,2,"さいし"],[31,1,"かれ"],[33,1,"おし"]],"text":"ヨアシは一生の間、主の目にかなう事をおこなった。祭司エホヤダが彼を教えたからである。"},{"ref":"2Kgs.12.3","start":12012003,"end":12012003,"break":"none","ruby":[[3,1,"たか"],[5,1,"ところ"],[7,1,"のぞ"],[16,1,"たみ"],[22,1,"たか"],[24,1,"ところ"],[26,2,"ぎせい"],[33,1,"こう"]],"text":"しかし高き所は除かなかったので、民はなおその高き所で犠牲をささげ、香をたいた。"},{"ref":"2Kgs.12.4","start":12012004,"end":12012004,"break":"paragraph","ruby":[[4,2,"さいし"],[9,1,"い"],[17,1,"しゅ"],[19,1,"みや"],[21,2,"せいべつ"],[29,1,"ぎん"],[40,1,"か"],[46,2,"わりあて"],[54,2,"ひとびと"],[57,1,"だ"],[59,1,"ぎん"],[64,2,"ひとびと"],[67,1,"こころ"],[70,1,"ねが"],[73,1,"しゅ"],[75,1,"みや"],[77,1,"も"],[82,1,"ぎん"]],"text":"ヨアシは祭司たちに言った、「すべて主の宮に聖別してささげる銀、すなわちおのおのが課せられて、割当にしたがって人々の出す銀、および人々が心から願って主の宮の持ってくる銀は、"},{"ref":"2Kgs.12.5","start":12012005,"end":12012005,"break":"none","ruby":[[3,2,"さいし"],[14,1,"し"],[16,1,"ひと"],[19,1,"う"],[21,1,"と"],[28,1,"しゅ"],[30,1,"みや"],[32,1,"やぶ"],[35,1,"み"],[38,1,"とき"],[49,1,"やぶ"],[52,1,"つくろ"]],"text":"これを祭司たちがおのおのその知る人から受け取り、どこでも主の宮に破れの見える時は、それをもってその破れを繕わなければならない」。"},{"ref":"2Kgs.12.6","start":12012006,"end":12012006,"break":"none","ruby":[[7,1,"おう"],[12,1,"ねん"],[14,1,"いた"],[19,2,"さいし"],[24,1,"しゅ"],[26,1,"みや"],[28,1,"やぶ"],[31,1,"つくろ"]],"text":"ところがヨアシ王の二十三年に至るまで、祭司たちは主の宮の破れを繕わなかった。"},{"ref":"2Kgs.12.7","start":12012007,"end":12012007,"break":"none","ruby":[[7,1,"おう"],[9,2,"さいし"],[18,1,"た"],[20,2,"さいし"],[25,1,"め"],[28,1,"い"],[42,1,"しゅ"],[44,1,"みや"],[46,1,"やぶ"],[49,1,"つくろ"],[65,2,"ちじん"],[69,1,"ぎん"],[71,1,"う"],[80,1,"しゅ"],[82,1,"みや"],[84,1,"やぶ"],[87,1,"つくろ"],[95,1,"わた"]],"text":"それで、ヨアシ王は祭司エホヤダおよび他の祭司たちを召して言った、「なぜ、あなたがたは主の宮の破れを繕わないのか。あなたがたはもはや知人から銀を受けてはならない。主の宮の破れを繕うためにそれを渡しなさい」。"},{"ref":"2Kgs.12.8","start":12012008,"end":12012008,"break":"none","ruby":[[0,2,"さいし"],[5,1,"かさ"],[8,1,"たみ"],[11,1,"ぎん"],[13,1,"う"],[17,1,"こと"],[20,1,"しゅ"],[22,1,"みや"],[24,1,"やぶ"],[27,1,"つくろ"],[31,1,"こと"],[34,2,"どうい"]],"text":"祭司たちは重ねて民から銀を受けない事と、主の宮の破れを繕わない事とに同意した。"},{"ref":"2Kgs.12.9","start":12012009,"end":12012009,"break":"paragraph","ruby":[[3,2,"さいし"],[13,1,"はこ"],[15,1,"と"],[23,1,"あな"],[32,1,"しゅ"],[34,1,"みや"],[36,2,"いりぐち"],[39,2,"みぎがわ"],[42,2,"さいだん"],[50,1,"お"],[57,1,"もん"],[59,1,"まも"],[61,2,"さいし"],[66,1,"しゅ"],[68,1,"みや"],[76,1,"ぎん"],[85,1,"なか"],[87,1,"い"]],"text":"そこで祭司エホヤダは一つの箱を取り、そのふたに穴をあけて、それを主の宮の入口の右側、祭壇のかたわらに置いた。そして門を守る祭司たちは主の宮にはいってくる銀をことごとくその中に入れた。"},{"ref":"2Kgs.12.10","start":12012010,"end":12012010,"break":"none","ruby":[[6,1,"はこ"],[8,1,"なか"],[10,1,"ぎん"],[12,1,"おお"],[19,1,"み"],[23,1,"おう"],[25,3,"しょきかん"],[29,1,"だい"],[30,2,"さいし"],[33,1,"のぼ"],[39,1,"しゅ"],[41,1,"みや"],[45,1,"ぎん"],[47,1,"かぞ"],[50,1,"ふくろ"],[52,1,"つ"]],"text":"こうしてその箱の中に銀が多くなったのを見ると、王の書記官と大祭司が上ってきて、主の宮にある銀を数えて袋に詰めた。"},{"ref":"2Kgs.12.11","start":12012011,"end":12012011,"break":"none","ruby":[[5,1,"かぞ"],[8,1,"ぎん"],[11,2,"こうじ"],[19,1,"しゅ"],[21,1,"みや"],[23,2,"かんとく"],[25,1,"もの"],[27,1,"て"],[36,1,"かれ"],[42,1,"しゅ"],[44,1,"みや"],[46,1,"はたら"],[48,2,"もっこう"],[51,2,"けんちく"],[53,1,"し"],[55,1,"はら"]],"text":"そしてその数えた銀を、工事をつかさどる主の宮の監督者の手にわたしたので、彼らはそれを主の宮に働く木工と建築師に払い、"},{"ref":"2Kgs.12.12","start":12012012,"end":12012012,"break":"none","ruby":[[0,2,"いしく"],[5,1,"いし"],[6,1,"き"],[9,1,"はら"],[20,1,"しゅ"],[22,1,"みや"],[24,1,"やぶ"],[27,1,"つくろ"],[29,2,"ざいもく"],[32,1,"き"],[34,1,"いし"],[36,1,"か"],[39,1,"しゅ"],[41,1,"みや"],[43,1,"つくろ"],[48,1,"もち"],[55,1,"もの"],[60,1,"ついや"]],"text":"石工および石切りに払い、またそれをもって主の宮の破れを繕う材木と切り石を買い、主の宮を繕うために用いるすべての物のために費した。"},{"ref":"2Kgs.12.13","start":12012013,"end":12012013,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"みや"],[16,1,"ぎん"],[21,1,"しゅ"],[23,1,"みや"],[28,1,"ぎん"],[34,2,"しんき"],[41,1,"はち"],[47,1,"きん"],[49,1,"うつわ"],[51,1,"ぎん"],[53,1,"うつわ"],[57,1,"つく"]],"text":"ただし、主の宮にはいってくるその銀をもって主の宮のために銀のたらい、心切りばさみ、鉢、ラッパ、金の器、銀の器などを造ることはしなかった。"},{"ref":"2Kgs.12.14","start":12012014,"end":12012014,"break":"none","ruby":[[5,2,"こうじ"],[10,1,"もの"],[12,1,"わた"],[19,1,"しゅ"],[21,1,"みや"],[23,1,"つくろ"]],"text":"ただこれを工事をする者に渡して、それで主の宮を繕わせた。"},{"ref":"2Kgs.12.15","start":12012015,"end":12012015,"break":"none","ruby":[[4,1,"ぎん"],[6,1,"わた"],[9,2,"こうじ"],[14,1,"もの"],[16,1,"はら"],[20,2,"ひとびと"],[23,2,"けいさん"],[36,1,"かれ"],[39,2,"しょうじき"],[42,1,"こと"]],"text":"またその銀を渡して工事をする者に払わせた人々と計算することはしなかった。彼らは正直に事をおこなったからである。"},{"ref":"2Kgs.12.16","start":12012016,"end":12012016,"break":"none","ruby":[[0,2,"けんさい"],[3,1,"ぎん"],[5,2,"ざいさい"],[8,1,"ぎん"],[10,1,"しゅ"],[12,1,"みや"],[22,2,"さいし"],[25,1,"き"]],"text":"愆祭の銀と罪祭の銀は主の宮に、はいらないで、祭司に帰した。"},{"ref":"2Kgs.12.17","start":12012017,"end":12012017,"break":"paragraph","ruby":[[9,1,"おう"],[15,1,"のぼ"],[24,1,"せ"],[30,1,"と"],[48,1,"せ"],[50,1,"のぼ"],[59,1,"かお"],[61,1,"む"]],"text":"そのころ、スリヤの王ハザエルが上ってきて、ガテを攻めてこれを取った。そしてハザエルがエルサレムに攻め上ろうとして、その顔を向けたとき、"},{"ref":"2Kgs.12.18","start":12012018,"end":12012018,"break":"none","ruby":[[3,1,"おう"],[10,2,"せんぞ"],[16,1,"おう"],[32,2,"せいべつ"],[44,1,"もの"],[52,2,"じしん"],[55,2,"せいべつ"],[63,1,"もの"],[69,1,"しゅ"],[71,1,"みや"],[73,1,"くら"],[76,1,"しゅ"],[78,1,"みや"],[82,1,"きん"],[89,1,"と"],[96,1,"おう"],[103,1,"おく"],[120,1,"はな"],[122,1,"さ"]],"text":"ユダの王ヨアシはその先祖、ユダの王ヨシャパテ、ヨラム、アハジヤが聖別してささげたすべての物、およびヨアシ自身が聖別してささげた物、ならびに主の宮の倉と、主の宮にある金をことごとく取って、スリヤ王のハザエルに贈ったので、ハザエルはエルサレムを離れ去った。"},{"ref":"2Kgs.12.19","start":12012019,"end":12012019,"break":"paragraph","ruby":[[6,1,"た"],[8,2,"じせき"],[13,1,"かれ"],[21,1,"こと"],[27,1,"おう"],[29,3,"れきだいし"],[33,1,"しょ"]],"text":"ヨアシのその他の事績および彼がしたすべての事は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.12.20","start":12012020,"end":12012020,"break":"none","ruby":[[4,2,"けらい"],[9,1,"た"],[12,2,"ととう"],[15,1,"むす"],[21,1,"くだ"],[23,1,"みち"],[30,1,"いえ"],[36,1,"ころ"]],"text":"ヨアシの家来たちは立って徒党を結び、シラに下る道にあるミロの家でヨアシを殺した。"},{"ref":"2Kgs.12.21","start":12012021,"end":12012021,"break":"none","ruby":[[6,2,"けらい"],[13,1,"こ"],[25,1,"こ"],[31,1,"かれ"],[33,1,"う"],[36,1,"ころ"],[39,1,"かれ"],[43,2,"せんぞ"],[46,1,"おな"],[54,1,"まち"],[56,1,"ほうむ"],[62,1,"こ"],[68,1,"かわ"],[71,1,"おう"]],"text":"すなわちその家来シメアテの子ヨザカルと、ショメルの子ヨザバデが彼を撃って殺し、彼をその先祖と同じく、ダビデの町に葬った。その子アマジヤが代って王となった。"}]