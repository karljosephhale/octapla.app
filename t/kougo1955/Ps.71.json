[{"ref":"Ps.71.1","start":19071001,"end":19071001,"break":"paragraph","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"よ"],[13,1,"たの"]],"text":"主よ、わたしはあなたに寄り頼む。とこしえにわたしをはずかしめないでください。"},{"ref":"Ps.71.2","start":19071002,"end":19071002,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[4,1,"ぎ"],[13,1,"たす"],[20,1,"すく"],[22,1,"だ"],[34,1,"みみ"],[36,1,"かたむ"],[45,1,"すく"]],"text":"あなたの義をもってわたしを助け、わたしを救い出してください。あなたの耳を傾けて、わたしをお救いください。"},{"ref":"Ps.71.3","start":19071003,"end":19071003,"break":"line","breaks":[[16,"line"],[35,"line"]],"ruby":[[11,1,"いわ"],[20,1,"すく"],[22,2,"けんご"],[25,1,"しろ"],[41,1,"いわ"],[45,1,"しろ"]],"text":"わたしのためにのがれの岩となり、わたしを救う堅固な城となってください。あなたはわが岩、わが城だからです。"},{"ref":"Ps.71.4","start":19071004,"end":19071004,"break":"line","breaks":[[20,"line"],[33,"line"]],"ruby":[[2,1,"かみ"],[5,1,"あ"],[8,1,"もの"],[10,1,"て"],[17,1,"すく"],[20,2,"ふぎ"],[23,2,"ざんにん"],[26,1,"ひと"],[28,2,"しはい"],[37,1,"すく"],[39,1,"だ"]],"text":"わが神よ、悪しき者の手からわたしを救い、不義、残忍な人の支配から、わたしを救い出してください。"},{"ref":"Ps.71.5","start":19071005,"end":19071005,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[14,1,"わか"],[16,1,"とき"],[24,1,"のぞ"],[31,1,"たの"]],"text":"主なる神よ、あなたはわたしの若い時からのわたしの望み、わたしの頼みです。"},{"ref":"Ps.71.6","start":19071006,"end":19071006,"break":"line","breaks":[[23,"line"],[47,"line"]],"ruby":[[4,1,"うま"],[15,1,"よ"],[17,1,"たの"],[31,1,"はは"],[33,1,"たい"],[36,1,"と"],[38,1,"だ"],[51,1,"つね"]],"text":"わたしは生れるときからあなたに寄り頼みました。あなたはわたしを母の胎から取り出されたかたです。わたしは常にあなたをほめたたえます。"},{"ref":"Ps.71.7","start":19071007,"end":19071007,"break":"line","breaks":[[9,"line"],[25,"line"]],"ruby":[[4,1,"おお"],[7,1,"ひと"],[9,1,"あや"],[17,1,"もの"],[36,2,"けんご"],[39,1,"さ"],[41,1,"どころ"]],"text":"わたしは多くの人に怪しまれるような者となりました。しかしあなたはわたしの堅固な避け所です。"},{"ref":"Ps.71.8","start":19071008,"end":19071008,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"くち"],[24,2,"しょうえい"],[31,1,"み"]],"text":"わたしの口はひねもす、あなたをたたえるさんびと、頌栄とをもって満たされています。"},{"ref":"Ps.71.9","start":19071009,"end":19071009,"break":"line","breaks":[[25,"line"]],"ruby":[[4,2,"としお"],[8,1,"とき"],[14,2,"みはな"],[29,1,"ちから"],[30,1,"おとろ"],[33,1,"とき"],[39,2,"みす"]],"text":"わたしが年老いた時、わたしを見離さないでください。わたしが力衰えた時、わたしを見捨てないでください。"},{"ref":"Ps.71.10","start":19071010,"end":19071010,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"てき"],[13,1,"かた"],[28,1,"もの"],[30,1,"とも"]],"text":"わたしの敵はわたしについて語り、わたしのいのちをうかがう者は共にはかって、"},{"ref":"Ps.71.11","start":19071011,"end":19071011,"break":"line","breaks":[[21,"line"]],"ruby":[[1,1,"かみ"],[3,1,"かれ"],[5,2,"みす"],[10,1,"かれ"],[12,1,"たす"],[15,1,"もの"],[21,1,"かれ"],[23,1,"お"],[26,1,"とら"],[31,1,"い"]],"text":"「神は彼を見捨てた。彼を助ける者がないから彼を追って捕えよ」と言います。"},{"ref":"Ps.71.12","start":19071012,"end":19071012,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かみ"],[7,1,"とお"],[21,1,"かみ"],[29,1,"き"],[35,1,"たす"]],"text":"神よ、わたしに遠ざからないでください。わが神よ、すみやかに来てわたしを助けてください。"},{"ref":"Ps.71.13","start":19071013,"end":19071013,"break":"line","breaks":[[24,"line"],[39,"line"]],"ruby":[[8,1,"もの"],[10,1,"は"],[15,1,"ほろ"],[36,1,"もの"]],"text":"わたしにあだする者を恥じさせ、滅ぼしてください。わたしをそこなわんとする者を、そしりと、はずかしめとをもっておおってください。"},{"ref":"Ps.71.14","start":19071014,"end":19071014,"break":"line","breaks":[[18,"line"]],"ruby":[[7,1,"た"],[10,1,"のぞ"]],"text":"しかしわたしは絶えず望みをいだいて、いよいよあなたをほめたたえるでしょう。"},{"ref":"Ps.71.15","start":19071015,"end":19071015,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[4,1,"くち"],[14,1,"ぎ"],[21,1,"すくい"],[24,1,"かた"],[37,1,"かず"],[39,1,"し"]],"text":"わたしの口はひねもすあなたの義と、あなたの救とを語るでしょう。わたしはその数を知らないからです。"},{"ref":"Ps.71.16","start":19071016,"end":19071016,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"しゅ"],[7,1,"かみ"],[9,2,"たいのう"],[16,1,"たずさ"],[27,1,"ぎ"]],"text":"わたしは主なる神の大能のみわざを携えゆき、ただあなたの義のみを、ほめたたえるでしょう。"},{"ref":"Ps.71.17","start":19071017,"end":19071017,"break":"line","breaks":[[24,"line"],[31,"line"]],"ruby":[[0,1,"かみ"],[11,1,"わか"],[13,1,"とき"],[16,1,"おし"],[43,1,"の"],[45,1,"つた"]],"text":"神よ、あなたはわたしを若い時から教えられました。わたしはなお、あなたのくすしきみわざを宣べ伝えます。"},{"ref":"Ps.71.18","start":19071018,"end":19071018,"break":"line","breaks":[[21,"line"],[40,"line"]],"ruby":[[0,1,"かみ"],[7,2,"としお"],[25,1,"ちから"],[38,1,"よ"],[40,1,"の"],[42,1,"つた"],[52,2,"みす"]],"text":"神よ、わたしが年老いて、しらがとなるとも、あなたの力をきたらんとするすべての代に宣べ伝えるまで、わたしを見捨てないでください。"},{"ref":"Ps.71.19","start":19071019,"end":19071019,"break":"line","breaks":[[22,"line"],[39,"line"]],"ruby":[[0,1,"かみ"],[7,2,"たいのう"],[10,1,"ぎ"],[13,1,"たか"],[15,1,"てん"],[19,1,"およ"],[26,1,"おお"],[30,1,"こと"],[39,1,"かみ"],[49,1,"ひと"],[52,1,"もの"]],"text":"神よ、あなたの大能と義とは高い天にまで及ぶ。あなたは大いなる事をなされました。神よ、だれかあなたに等しい者があるでしょうか。"},{"ref":"Ps.71.20","start":19071020,"end":19071020,"break":"line","breaks":[[16,"line"],[35,"line"]],"ruby":[[8,1,"おお"],[11,1,"おも"],[13,1,"なや"],[25,1,"ふたた"],[31,1,"い"],[35,1,"ち"],[37,1,"ふか"],[39,1,"ところ"],[42,1,"ひ"]],"text":"あなたはわたしを多くの重い悩みにあわされましたが、再びわたしを生かし、地の深い所から引きあげられるでしょう。"},{"ref":"Ps.71.21","start":19071021,"end":19071021,"break":"line","breaks":[[13,"line"]],"ruby":[[8,1,"ほまれ"],[10,1,"ま"],[13,1,"ふたた"],[19,1,"なぐさ"]],"text":"あなたはわたしの誉を増し、再びわたしを慰められるでしょう。"},{"ref":"Ps.71.22","start":19071022,"end":19071022,"break":"line","breaks":[[17,"line"],[39,"line"],[49,"line"]],"ruby":[[2,1,"かみ"],[11,2,"たてごと"],[45,2,"せいじゃ"],[53,1,"こと"],[64,1,"うた"]],"text":"わが神よ、わたしはまた立琴をもってあなたと、あなたのまこととをほめたたえます。イスラエルの聖者よ、わたしは琴をもってあなたをほめ歌います。"},{"ref":"Ps.71.23","start":19071023,"end":19071023,"break":"line","breaks":[[19,"line"],[33,"line"],[49,"line"]],"ruby":[[14,1,"うた"],[26,1,"よろこ"],[28,1,"よ"],[45,1,"たましい"],[49,1,"よろこ"],[51,1,"よ"]],"text":"わたしがあなたにむかってほめ歌うとき、わがくちびるは喜び呼ばわり、あなたがあがなわれたわが魂もまた喜び呼ばわるでしょう。"},{"ref":"Ps.71.24","start":19071024,"end":19071024,"break":"line","breaks":[[12,"line"],[25,"line"],[39,"line"]],"ruby":[[4,1,"した"],[16,1,"ぎ"],[18,1,"かた"],[37,1,"もの"],[39,1,"は"]],"text":"わたしの舌もまたひねもすあなたの義を語るでしょう。わたしをそこなわんとした者が恥じあわてたからです。"}]