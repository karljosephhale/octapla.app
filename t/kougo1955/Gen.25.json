[{"ref":"Gen.25.1","start":1025001,"end":1025001,"break":"paragraph","ruby":[[6,1,"ふたた"],[8,1,"つま"],[15,1,"な"]],"text":"アブラハムは再び妻をめとった。名をケトラという。"},{"ref":"Gen.25.2","start":1025002,"end":1025002,"break":"none","ruby":[[0,2,"かのじょ"],[34,1,"う"]],"text":"彼女はジムラン、ヨクシャン、メダン、ミデアン、イシバクおよびシュワを産んだ。"},{"ref":"Gen.25.3","start":1025003,"end":1025003,"break":"none","ruby":[[6,1,"こ"],[19,2,"しそん"]],"text":"ヨクシャンの子はシバとデダン。デダンの子孫はアシュリびと、レトシびと、レウミびとである。"},{"ref":"Gen.25.4","start":1025004,"end":1025004,"break":"none","ruby":[[5,2,"しそん"],[36,1,"みな"],[41,2,"しそん"]],"text":"ミデアンの子孫はエパ、エペル、ヘノク、アビダ、エルダアであって、これらは皆ケトラの子孫であった。"},{"ref":"Gen.25.5","start":1025005,"end":1025005,"break":"none","ruby":[[8,2,"しょゆう"],[20,1,"あた"]],"text":"アブラハムはその所有をことごとくイサクに与えた。"},{"ref":"Gen.25.6","start":1025006,"end":1025006,"break":"none","ruby":[[10,1,"こ"],[20,1,"もの"],[22,1,"あた"],[27,1,"い"],[32,1,"あいだ"],[34,1,"かれ"],[39,1,"こ"],[45,1,"はな"],[49,1,"ひがし"],[51,1,"ほう"],[53,1,"ひがし"],[55,1,"くに"],[57,1,"うつ"]],"text":"またそのそばめたちの子らにもアブラハムは物を与え、なお生きている間に彼らをその子イサクから離して、東の方、東の国に移らせた。"},{"ref":"Gen.25.7","start":1025007,"end":1025007,"break":"paragraph","ruby":[[6,1,"い"],[13,1,"とし"],[19,1,"ねん"]],"text":"アブラハムの生きながらえた年は百七十五年である。"},{"ref":"Gen.25.8","start":1025008,"end":1025008,"break":"none","ruby":[[6,2,"こうれい"],[9,1,"たっ"],[12,2,"ろうじん"],[18,1,"とし"],[20,1,"み"],[23,1,"いき"],[24,1,"た"],[27,1,"し"],[32,1,"たみ"],[34,1,"くわ"]],"text":"アブラハムは高齢に達し、老人となり、年が満ちて息絶え、死んでその民に加えられた。"},{"ref":"Gen.25.9","start":1025009,"end":1025009,"break":"none","ruby":[[2,1,"こ"],[13,1,"かれ"],[23,1,"こ"],[29,1,"はたけ"],[40,1,"あな"],[42,1,"ほうむ"],[53,1,"む"]],"text":"その子イサクとイシマエルは彼をヘテびとゾハルの子エフロンの畑にあるマクペラのほら穴に葬った。これはマムレの向かいにあり、"},{"ref":"Gen.25.10","start":1025010,"end":1025010,"break":"none","ruby":[[9,2,"ひとびと"],[14,1,"か"],[16,1,"と"],[19,1,"はたけ"],[36,1,"つま"],[40,1,"ほうむ"]],"text":"アブラハムがヘテの人々から、買い取った畑であって、そこにアブラハムとその妻サラが葬られた。"},{"ref":"Gen.25.11","start":1025011,"end":1025011,"break":"none","ruby":[[6,1,"し"],[9,1,"のち"],[11,1,"かみ"],[15,1,"こ"],[20,2,"しゅくふく"],[45,1,"す"]],"text":"アブラハムが死んだ後、神はその子イサクを祝福された。イサクはベエル・ラハイ・ロイのほとりに住んだ。"},{"ref":"Gen.25.12","start":1025012,"end":1025012,"break":"paragraph","ruby":[[23,1,"う"],[32,1,"こ"],[39,2,"けいず"],[42,1,"つぎ"]],"text":"サラのつかえめエジプトびとハガルがアブラハムに産んだアブラハムの子イシマエルの系図は次のとおりである。"},{"ref":"Gen.25.13","start":1025013,"end":1025013,"break":"none","ruby":[[6,1,"こ"],[9,1,"な"],[11,2,"せだい"],[22,1,"な"],[27,1,"つぎ"],[46,2,"ちょうし"],[54,1,"つぎ"]],"text":"イシマエルの子らの名を世代にしたがって、その名をいえば次のとおりである。すなわちイシマエルの長子はネバヨテ、次はケダル、アデビエル、ミブサム、"},{"ref":"Gen.25.14","start":1025014,"end":1025014,"break":"none","text":"ミシマ、ドマ、マッサ、"},{"ref":"Gen.25.15","start":1025015,"end":1025015,"break":"none","text":"ハダデ、テマ、エトル、ネフシ、ケデマ。"},{"ref":"Gen.25.16","start":1025016,"end":1025016,"break":"none","ruby":[[9,1,"こ"],[15,1,"むら"],[17,2,"しゅくえい"],[23,1,"な"],[31,2,"しぞく"],[38,1,"にん"],[40,1,"きみ"]],"text":"これはイシマエルの子らであり、村と宿営とによる名であって、その氏族による十二人の君たちである。"},{"ref":"Gen.25.17","start":1025017,"end":1025017,"break":"none","ruby":[[14,1,"ねん"],[19,1,"かれ"],[21,1,"いき"],[22,1,"た"],[25,1,"し"],[30,1,"たみ"],[32,1,"くわ"]],"text":"イシマエルのよわいは百三十七年である。彼は息絶えて死に、その民に加えられた。"},{"ref":"Gen.25.18","start":1025018,"end":1025018,"break":"none","ruby":[[6,1,"こ"],[19,1,"ひがし"],[27,1,"あいだ"],[29,1,"す"],[38,1,"およ"],[52,2,"きょうだい"],[55,1,"ひがし"],[57,1,"す"]],"text":"イシマエルの子らはハビラからエジプトの東、シュルまでの間に住んで、アシュルに及んだ。イシマエルはすべての兄弟の東に住んだ。"},{"ref":"Gen.25.19","start":1025019,"end":1025019,"break":"paragraph","ruby":[[6,1,"こ"],[11,2,"けいず"],[14,1,"つぎ"],[29,1,"こ"]],"text":"アブラハムの子イサクの系図は次のとおりである。アブラハムの子はイサクであって、"},{"ref":"Gen.25.20","start":1025020,"end":1025020,"break":"none","ruby":[[6,1,"さい"],[8,1,"とき"],[27,1,"むすめ"],[39,1,"いもうと"],[44,1,"つま"]],"text":"イサクは四十歳の時、パダンアラムのアラムびとベトエルの娘で、アラムびとラバンの妹リベカを妻にめとった。"},{"ref":"Gen.25.21","start":1025021,"end":1025021,"break":"none","ruby":[[4,1,"つま"],[6,1,"こ"],[8,1,"う"],[17,1,"つま"],[22,1,"しゅ"],[24,1,"いの"],[26,1,"ねが"],[30,1,"しゅ"],[34,1,"ねが"],[37,1,"き"],[41,1,"つま"]],"text":"イサクは妻が子を産まなかったので、妻のために主に祈り願った。主はその願いを聞かれ、妻リベカはみごもった。"},{"ref":"Gen.25.22","start":1025022,"end":1025022,"break":"none","ruby":[[6,1,"こ"],[9,2,"たいない"],[12,1,"お"],[14,1,"あ"],[24,1,"い"],[51,2,"かのじょ"],[54,1,"い"],[57,1,"しゅ"],[59,1,"たず"]],"text":"ところがその子らが胎内で押し合ったので、リベカは言った、「こんなことでは、わたしはどうなるでしょう」。彼女は行って主に尋ねた。"},{"ref":"Gen.25.23","start":1025023,"end":1025023,"break":"none","breaks":[[10,"stanza"],[27,"line"],[45,"line"],[59,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"かのじょ"],[5,1,"い"],[14,2,"こくみん"],[21,2,"たいない"],[30,1,"たみ"],[36,1,"はら"],[39,1,"わか"],[42,1,"で"],[48,1,"たみ"],[50,1,"た"],[52,1,"たみ"],[56,1,"つよ"],[59,1,"あに"],[61,1,"おとうと"],[63,1,"つか"]],"text":"主は彼女に言われた、「二つの国民があなたの胎内にあり、二つの民があなたの腹から別れて出る。一つの民は他の民よりも強く、兄は弟に仕えるであろう」。"},{"ref":"Gen.25.24","start":1025024,"end":1025024,"break":"none","ruby":[[0,2,"かのじょ"],[3,2,"しゅっさん"],[6,1,"ひ"],[13,2,"たいない"]],"text":"彼女の出産の日がきたとき、胎内にはふたごがあった。"},{"ref":"Gen.25.25","start":1025025,"end":1025025,"break":"none","ruby":[[3,1,"で"],[7,1,"あか"],[10,2,"ぜんしん"],[12,1,"け"],[27,1,"な"],[33,1,"な"]],"text":"さきに出たのは赤くて全身毛ごろものようであった。それで名をエサウと名づけた。"},{"ref":"Gen.25.26","start":1025026,"end":1025026,"break":"none","ruby":[[2,1,"のち"],[4,1,"おとうと"],[6,1,"で"],[11,1,"て"],[31,1,"な"],[37,1,"な"],[46,1,"かれ"],[49,1,"う"],[52,1,"とき"],[60,1,"さい"]],"text":"その後に弟が出た。その手はエサウのかかとをつかんでいた。それで名をヤコブと名づけた。リベカが彼らを産んだ時、イサクは六十歳であった。"},{"ref":"Gen.25.27","start":1025027,"end":1025027,"break":"paragraph","ruby":[[4,1,"こ"],[7,2,"せいちょう"],[15,1,"たく"],[18,3,"しゅりょうしゃ"],[25,1,"の"],[27,1,"ひと"],[38,1,"おだ"],[42,1,"ひと"],[45,2,"てんまく"],[48,1,"す"]],"text":"さてその子らは成長し、エサウは巧みな狩猟者となり、野の人となったが、ヤコブは穏やかな人で、天幕に住んでいた。"},{"ref":"Gen.25.28","start":1025028,"end":1025028,"break":"none","ruby":[[8,1,"にく"],[10,1,"す"],[22,1,"あい"],[35,1,"あい"]],"text":"イサクは、しかの肉が好きだったので、エサウを愛したが、リベカはヤコブを愛した。"},{"ref":"Gen.25.29","start":1025029,"end":1025029,"break":"paragraph","ruby":[[2,1,"ひ"],[13,1,"に"],[17,1,"とき"],[23,1,"う"],[25,1,"つか"],[28,1,"の"],[31,1,"かえ"]],"text":"ある日ヤコブが、あつものを煮ていた時、エサウは飢え疲れて野から帰ってきた。"},{"ref":"Gen.25.30","start":1025030,"end":1025030,"break":"none","ruby":[[8,1,"い"],[17,1,"う"],[19,1,"つか"],[24,1,"ねが"],[28,1,"あか"],[35,1,"あか"],[44,1,"た"],[53,1,"かれ"],[55,1,"な"],[61,1,"よ"]],"text":"エサウはヤコブに言った、「わたしは飢え疲れた。お願いだ。赤いもの、その赤いものをわたしに食べさせてくれ」。彼が名をエドムと呼ばれたのはこのためである。"},{"ref":"Gen.25.31","start":1025031,"end":1025031,"break":"none","ruby":[[4,1,"い"],[15,2,"ちょうし"],[18,2,"とっけん"],[25,1,"う"]],"text":"ヤコブは言った、「まずあなたの長子の特権をわたしに売りなさい」。"},{"ref":"Gen.25.32","start":1025032,"end":1025032,"break":"none","ruby":[[4,1,"い"],[13,1,"し"],[19,2,"ちょうし"],[22,2,"とっけん"],[30,1,"なに"]],"text":"エサウは言った、「わたしは死にそうだ。長子の特権などわたしに何になろう」。"},{"ref":"Gen.25.33","start":1025033,"end":1025033,"break":"none","ruby":[[6,1,"い"],[17,1,"ちか"],[24,1,"かれ"],[26,1,"ちか"],[29,2,"ちょうし"],[32,2,"とっけん"],[39,1,"う"]],"text":"ヤコブはまた言った、「まずわたしに誓いなさい」。彼は誓って長子の特権をヤコブに売った。"},{"ref":"Gen.25.34","start":1025034,"end":1025034,"break":"none","ruby":[[13,1,"まめ"],[25,1,"あた"],[31,1,"かれ"],[33,1,"の"],[35,1,"く"],[40,1,"た"],[42,1,"さ"],[57,2,"ちょうし"],[60,2,"とっけん"],[63,1,"かろ"]],"text":"そこでヤコブはパンとレンズ豆のあつものとをエサウに与えたので、彼は飲み食いして、立ち去った。このようにしてエサウは長子の特権を軽んじた。"}]