[{"ref":"Lev.15.1","start":3015001,"end":3015001,"break":"paragraph","ruby":[[0,1,"しゅ"],[13,1,"い"]],"text":"主はまた、モーセとアロンに言われた、"},{"ref":"Lev.15.2","start":3015002,"end":3015002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[23,1,"にく"],[25,2,"りゅうしゅつ"],[34,2,"りゅうしゅつ"],[37,1,"けが"]],"text":"「イスラエルの人々に言いなさい、『だれでもその肉に流出があれば、その流出は汚れである。"},{"ref":"Lev.15.3","start":3015003,"end":3015003,"break":"none","ruby":[[2,2,"りゅうしゅつ"],[7,1,"けが"],[10,1,"つぎ"],[26,1,"にく"],[28,2,"りゅうしゅつ"],[31,1,"つづ"],[45,1,"にく"],[47,2,"りゅうしゅつ"],[50,1,"と"],[58,1,"とも"],[60,1,"けが"]],"text":"その流出による汚れは次のとおりである。すなわち、その肉の流出が続いていても、あるいは、その肉の流出が止まっていても、共に汚れである。"},{"ref":"Lev.15.4","start":3015004,"end":3015004,"break":"none","ruby":[[0,2,"りゅうしゅつ"],[4,1,"もの"],[6,1,"ね"],[8,1,"とこ"],[13,1,"けが"],[21,1,"ひと"],[27,1,"もの"],[32,1,"けが"]],"text":"流出ある者の寝た床はすべて汚れる。またその人のすわった物はすべて汚れるであろう。"},{"ref":"Lev.15.5","start":3015005,"end":3015005,"break":"none","ruby":[[2,1,"とこ"],[4,1,"ふ"],[7,1,"もの"],[12,2,"いふく"],[15,1,"あら"],[18,1,"みず"],[20,1,"み"],[34,1,"かれ"],[36,1,"ゆう"],[39,1,"けが"]],"text":"その床に触れる者は、その衣服を洗い、水に身をすすがなければならない。彼は夕まで汚れるであろう。"},{"ref":"Lev.15.6","start":3015006,"end":3015006,"break":"none","ruby":[[0,2,"りゅうしゅつ"],[4,1,"もの"],[10,1,"もの"],[12,1,"うえ"],[17,1,"もの"],[22,2,"いふく"],[25,1,"あら"],[28,1,"みず"],[30,1,"み"],[44,1,"かれ"],[46,1,"ゆう"],[49,1,"けが"]],"text":"流出ある者のすわった物の上にすわる者は、その衣服を洗い、水に身をすすがなければならない。彼は夕まで汚れるであろう。"},{"ref":"Lev.15.7","start":3015007,"end":3015007,"break":"none","ruby":[[0,2,"りゅうしゅつ"],[4,1,"もの"],[6,1,"にく"],[8,1,"ふ"],[11,1,"もの"],[13,2,"いふく"],[16,1,"あら"],[19,1,"みず"],[21,1,"み"],[35,1,"かれ"],[37,1,"ゆう"],[40,1,"けが"]],"text":"流出ある者の肉に触れる者は衣服を洗い、水に身をすすがなければならない。彼は夕まで汚れるであろう。"},{"ref":"Lev.15.8","start":3015008,"end":3015008,"break":"none","ruby":[[0,2,"りゅうしゅつ"],[4,1,"もの"],[11,1,"きよ"],[13,1,"もの"],[25,1,"ひと"],[27,2,"いふく"],[30,1,"あら"],[33,1,"みず"],[35,1,"み"],[49,1,"かれ"],[51,1,"ゆう"],[54,1,"けが"]],"text":"流出ある者のつばきが、清い者にかかったならば、その人は衣服を洗い、水に身をすすがなければならない。彼は夕まで汚れるであろう。"},{"ref":"Lev.15.9","start":3015009,"end":3015009,"break":"none","ruby":[[0,2,"りゅうしゅつ"],[4,1,"もの"],[6,1,"の"],[9,1,"くら"],[14,1,"けが"]],"text":"流出ある者の乗った鞍はすべて汚れる。"},{"ref":"Lev.15.10","start":3015010,"end":3015010,"break":"none","ruby":[[2,1,"かれ"],[4,1,"した"],[9,1,"もの"],[11,1,"ふ"],[14,1,"もの"],[20,1,"ゆう"],[23,1,"けが"],[37,1,"もの"],[39,1,"はこ"],[41,1,"もの"],[46,2,"いふく"],[49,1,"あら"],[52,1,"みず"],[54,1,"み"],[68,1,"かれ"],[70,1,"ゆう"],[73,1,"けが"]],"text":"また彼の下になった物に触れる者は、すべて夕まで汚れるであろう。またそれらの物を運ぶ者は、その衣服を洗い、水に身をすすがなければならない。彼は夕まで汚れるであろう。"},{"ref":"Lev.15.11","start":3015011,"end":3015011,"break":"none","ruby":[[0,2,"りゅうしゅつ"],[4,1,"もの"],[7,1,"みず"],[9,1,"て"],[11,1,"あら"],[15,1,"ひと"],[17,1,"ふ"],[26,1,"ひと"],[28,2,"いふく"],[31,1,"あら"],[34,1,"みず"],[36,1,"み"],[50,1,"かれ"],[52,1,"ゆう"],[55,1,"けが"]],"text":"流出ある者が、水で手を洗わずに人に触れるならば、その人は衣服を洗い、水に身をすすがなければならない。彼は夕まで汚れるであろう。"},{"ref":"Lev.15.12","start":3015012,"end":3015012,"break":"none","ruby":[[0,2,"りゅうしゅつ"],[4,1,"もの"],[6,1,"ふ"],[9,1,"つち"],[11,1,"うつわ"],[13,1,"くだ"],[24,1,"き"],[26,1,"うつわ"],[31,1,"みず"],[33,1,"あら"]],"text":"流出ある者が触れた土の器は砕かなければならない。木の器はすべて水で洗わなければならない。"},{"ref":"Lev.15.13","start":3015013,"end":3015013,"break":"paragraph","ruby":[[0,2,"りゅうしゅつ"],[4,1,"もの"],[6,2,"りゅうしゅつ"],[12,1,"きよ"],[20,1,"きよ"],[26,2,"なぬか"],[29,1,"かぞ"],[34,2,"いふく"],[37,1,"あら"],[40,1,"なが"],[42,1,"みず"],[44,1,"み"],[62,1,"きよ"]],"text":"流出ある者の流出がやんで清くなるならば、清めのために七日を数え、その衣服を洗い、流れ水に身をすすがなければならない。そうして清くなるであろう。"},{"ref":"Lev.15.14","start":3015014,"end":3015014,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[5,1,"やま"],[9,1,"わ"],[14,1,"いえ"],[21,1,"わ"],[23,1,"と"],[27,2,"かいけん"],[30,2,"まくや"],[33,2,"いりぐち"],[36,1,"い"],[39,1,"しゅ"],[41,1,"まえ"],[43,1,"で"],[49,2,"さいし"],[52,1,"わた"]],"text":"八日目に、山ばと二羽、または家ばとのひな二羽を取って、会見の幕屋の入口に行き、主の前に出て、それを祭司に渡さなければならない。"},{"ref":"Lev.15.15","start":3015015,"end":3015015,"break":"none","ruby":[[0,2,"さいし"],[8,2,"ざいさい"],[13,1,"た"],[18,2,"はんさい"],[39,2,"さいし"],[44,1,"ひと"],[51,2,"りゅうしゅつ"],[57,1,"しゅ"],[59,1,"まえ"]],"text":"祭司はその一つを罪祭とし、他の一つを燔祭としてささげなければならない。こうして祭司はその人のため、その流出のために主の前に、あがないをするであろう。"},{"ref":"Lev.15.16","start":3015016,"end":3015016,"break":"paragraph","ruby":[[0,1,"ひと"],[4,1,"せい"],[6,1,"も"],[18,2,"ぜんしん"],[21,1,"みず"],[35,1,"かれ"],[37,1,"ゆう"],[40,1,"けが"]],"text":"人がもし精を漏らすことがあれば、その全身を水にすすがなければならない。彼は夕まで汚れるであろう。"},{"ref":"Lev.15.17","start":3015017,"end":3015017,"break":"none","ruby":[[3,1,"せい"],[8,2,"いふく"],[13,1,"かわ"],[15,1,"つく"],[18,1,"もの"],[20,1,"みず"],[22,1,"あら"],[36,1,"ゆう"],[39,1,"けが"]],"text":"すべて精のついた衣服および皮で作った物は水で洗わなければならない。これは夕まで汚れるであろう。"},{"ref":"Lev.15.18","start":3015018,"end":3015018,"break":"none","ruby":[[0,1,"おとこ"],[4,1,"おんな"],[6,1,"ね"],[8,1,"せい"],[10,1,"も"],[20,1,"かれ"],[23,1,"とも"],[25,1,"みず"],[27,1,"み"],[41,1,"かれ"],[44,1,"ゆう"],[47,1,"けが"]],"text":"男がもし女と寝て精を漏らすことがあれば、彼らは共に水に身をすすがなければならない。彼らは夕まで汚れるであろう。"},{"ref":"Lev.15.19","start":3015019,"end":3015019,"break":"paragraph","ruby":[[2,1,"おんな"],[4,2,"りゅうしゅつ"],[13,1,"み"],[15,2,"りゅうしゅつ"],[20,1,"ち"],[30,1,"おんな"],[32,2,"なぬか"],[38,2,"ふじょう"],[49,1,"おんな"],[51,1,"ふ"],[54,1,"もの"],[56,1,"ゆう"],[59,1,"けが"]],"text":"また女に流出があって、その身の流出がもし血であるならば、その女は七日のあいだ不浄である。すべてその女に触れる者は夕まで汚れるであろう。"},{"ref":"Lev.15.20","start":3015020,"end":3015020,"break":"none","ruby":[[2,2,"ふじょう"],[5,1,"あいだ"],[10,1,"おんな"],[12,1,"ね"],[14,1,"もの"],[19,1,"けが"],[27,1,"おんな"],[33,1,"もの"],[39,1,"けが"]],"text":"その不浄の間に、その女の寝た物はすべて汚れる。またその女のすわった物も、すべて汚れるであろう。"},{"ref":"Lev.15.21","start":3015021,"end":3015021,"break":"none","ruby":[[5,1,"おんな"],[7,1,"とこ"],[9,1,"ふ"],[12,1,"もの"],[17,2,"いふく"],[20,1,"あら"],[23,1,"みず"],[25,1,"み"],[39,1,"かれ"],[41,1,"ゆう"],[44,1,"けが"]],"text":"すべてその女の床に触れる者は、その衣服を洗い、水に身をすすがなければならない。彼は夕まで汚れるであろう。"},{"ref":"Lev.15.22","start":3015022,"end":3015022,"break":"none","ruby":[[5,1,"おんな"],[11,1,"もの"],[13,1,"ふ"],[16,1,"もの"],[18,1,"みな"],[21,2,"いふく"],[24,1,"あら"],[27,1,"みず"],[29,1,"み"],[43,1,"かれ"],[45,1,"ゆう"],[48,1,"けが"]],"text":"すべてその女のすわった物に触れる者は皆その衣服を洗い、水に身をすすがなければならない。彼は夕まで汚れるであろう。"},{"ref":"Lev.15.23","start":3015023,"end":3015023,"break":"none","ruby":[[4,1,"おんな"],[6,1,"とこ"],[8,1,"うえ"],[16,1,"もの"],[18,1,"うえ"],[22,1,"とき"],[27,1,"ふ"],[36,1,"ひと"],[38,1,"ゆう"],[41,1,"けが"]],"text":"またその女が床の上、またはすわる物の上におる時、それに触れるならば、その人は夕まで汚れるであろう。"},{"ref":"Lev.15.24","start":3015024,"end":3015024,"break":"none","ruby":[[0,1,"おとこ"],[7,1,"おんな"],[9,1,"ね"],[14,2,"ふじょう"],[17,1,"み"],[26,1,"かれ"],[28,2,"なぬか"],[34,1,"けが"],[44,1,"かれ"],[46,1,"ね"],[48,1,"とこ"],[53,1,"けが"]],"text":"男がもし、その女と寝て、その不浄を身にうけるならば、彼は七日のあいだ汚れるであろう。また彼の寝た床はすべて汚れるであろう。"},{"ref":"Lev.15.25","start":3015025,"end":3015025,"break":"paragraph","ruby":[[0,1,"おんな"],[7,2,"ふじょう"],[10,1,"とき"],[16,1,"おお"],[19,1,"ひ"],[25,1,"ち"],[27,2,"りゅうしゅつ"],[40,2,"ふじょう"],[43,1,"とき"],[45,1,"こ"],[48,2,"りゅうしゅつ"],[57,1,"けが"],[60,2,"りゅうしゅつ"],[63,1,"ひ"],[65,1,"あいだ"],[73,2,"ふじょう"],[76,1,"とき"],[78,1,"おな"],[86,1,"おんな"],[88,1,"けが"],[91,1,"もの"]],"text":"女にもし、その不浄の時のほかに、多くの日にわたって血の流出があるか、あるいはその不浄の時を越して流出があれば、その汚れの流出の日の間は、すべてその不浄の時と同じように、その女は汚れた者である。"},{"ref":"Lev.15.26","start":3015026,"end":3015026,"break":"none","ruby":[[2,2,"りゅうしゅつ"],[5,1,"ひ"],[7,1,"あいだ"],[12,1,"おんな"],[14,1,"ね"],[16,1,"とこ"],[24,1,"おんな"],[26,2,"ふじょう"],[29,1,"とき"],[31,1,"とこ"],[33,1,"おな"],[46,1,"おんな"],[52,1,"もの"],[55,2,"ふじょう"],[58,1,"けが"],[64,1,"けが"]],"text":"その流出の日の間に、その女の寝た床は、すべてその女の不浄の時の床と同じようになる。すべてその女のすわった物は、不浄の汚れのように汚れるであろう。"},{"ref":"Lev.15.27","start":3015027,"end":3015027,"break":"none","ruby":[[7,1,"もの"],[9,1,"ふ"],[12,1,"ひと"],[14,1,"けが"],[20,2,"いふく"],[23,1,"あら"],[26,1,"みず"],[28,1,"み"],[42,1,"かれ"],[44,1,"ゆう"],[47,1,"けが"]],"text":"すべてこれらの物に触れる人は汚れる。その衣服を洗い、水に身をすすがなければならない。彼は夕まで汚れるであろう。"},{"ref":"Lev.15.28","start":3015028,"end":3015028,"break":"none","ruby":[[6,1,"おんな"],[8,2,"りゅうしゅつ"],[15,1,"きよ"],[23,2,"じぶん"],[32,2,"なぬか"],[35,1,"かぞ"],[49,1,"のち"],[51,1,"きよ"]],"text":"しかし、その女の流出がやんで、清くなるならば、自分のために、なお七日を数えなければならない。そして後、清くなるであろう。"},{"ref":"Lev.15.29","start":3015029,"end":3015029,"break":"none","ruby":[[2,1,"おんな"],[5,1,"か"],[6,1,"め"],[8,1,"やま"],[12,1,"わ"],[17,1,"いえ"],[24,1,"わ"],[26,2,"じぶん"],[32,1,"と"],[38,2,"かいけん"],[41,2,"まくや"],[44,2,"いりぐち"],[49,2,"さいし"],[55,1,"たずさ"],[58,1,"い"]],"text":"その女は八日目に山ばと二羽、または家ばとのひな二羽を自分のために取り、それを会見の幕屋の入口におる祭司のもとに携えて行かなければならない。"},{"ref":"Lev.15.30","start":3015030,"end":3015030,"break":"none","ruby":[[0,2,"さいし"],[8,2,"ざいさい"],[13,1,"た"],[18,2,"はんさい"],[39,2,"さいし"],[44,1,"おんな"],[51,1,"けが"],[54,2,"りゅうしゅつ"],[60,1,"しゅ"],[62,1,"まえ"]],"text":"祭司はその一つを罪祭とし、他の一つを燔祭としてささげなければならない。こうして祭司はその女のため、その汚れの流出のために主の前に、あがないをするであろう。"},{"ref":"Lev.15.31","start":3015031,"end":3015031,"break":"paragraph","ruby":[[20,2,"ひとびと"],[23,1,"けが"],[27,1,"はな"],[41,1,"かれ"],[53,2,"まくや"],[56,1,"かれ"],[59,1,"けが"],[64,1,"けが"],[70,1,"し"]],"text":"このようにしてあなたがたは、イスラエルの人々を汚れから離さなければならない。これは彼らのうちにあるわたしの幕屋を彼らが汚し、その汚れのために死ぬことのないためである』」。"},{"ref":"Lev.15.32","start":3015032,"end":3015032,"break":"paragraph","ruby":[[3,2,"りゅうしゅつ"],[7,1,"もの"],[9,1,"せい"],[11,1,"も"],[15,1,"けが"],[18,1,"もの"]],"text":"これは流出ある者、精を漏らして汚れる者、"},{"ref":"Lev.15.33","start":3015033,"end":3015033,"break":"none","ruby":[[0,2,"ふじょう"],[7,1,"おんな"],[13,1,"おとこ"],[18,1,"おんな"],[20,2,"りゅうしゅつ"],[24,1,"もの"],[29,2,"ふじょう"],[32,1,"おんな"],[34,1,"ね"],[36,1,"もの"],[38,1,"かん"]],"text":"不浄をわずらう女、ならびに男あるいは女の流出ある者、および不浄の女と寝る者に関するおきてである。"}]