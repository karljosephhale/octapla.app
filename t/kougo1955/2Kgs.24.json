[{"ref":"2Kgs.24.1","start":12024001,"end":12024001,"break":"paragraph","ruby":[[6,1,"よ"],[13,1,"おう"],[22,1,"のぼ"],[36,1,"かれ"],[38,2,"れいぞく"],[43,1,"ねん"],[45,1,"へ"],[52,1,"ひるがえ"],[55,1,"かれ"]],"text":"エホヤキムの世にバビロンの王ネブカデネザルが上ってきたので、エホヤキムは彼に隷属して三年を経たが、ついに翻って彼にそむいた。"},{"ref":"2Kgs.24.2","start":12024002,"end":12024002,"break":"none","ruby":[[0,1,"しゅ"],[9,2,"りゃくだつ"],[11,1,"たい"],[19,2,"りゃくだつ"],[21,1,"たい"],[29,2,"りゃくだつ"],[31,1,"たい"],[40,2,"りゃくだつ"],[42,1,"たい"],[55,1,"せ"],[68,1,"せ"],[74,1,"ほろ"],[80,1,"かれ"],[90,1,"しゅ"],[100,3,"よげんしゃ"],[109,1,"かた"],[113,2,"ことば"]],"text":"主はカルデヤびとの略奪隊、スリヤびとの略奪隊、モアブびとの略奪隊、アンモンびとの略奪隊をつかわしてエホヤキムを攻められた。すなわちユダを攻め、これを滅ぼすために彼らをつかわされた。主がそのしもべである預言者たちによって語られた言葉のとおりである。"},{"ref":"2Kgs.24.3","start":12024003,"end":12024003,"break":"none","ruby":[[3,1,"まった"],[5,1,"しゅ"],[7,1,"いのち"],[15,1,"のぞ"],[25,1,"しゅ"],[27,1,"め"],[29,1,"まえ"],[32,1,"はら"],[34,1,"のぞ"],[61,1,"つみ"]],"text":"これは全く主の命によってユダに臨んだもので、ユダを主の目の前から払い除くためであった。すなわちマナセがすべておこなったその罪のため、"},{"ref":"2Kgs.24.4","start":12024004,"end":12024004,"break":"none","ruby":[[2,1,"かれ"],[4,1,"つみ"],[7,1,"ひと"],[9,1,"ち"],[11,1,"なが"],[14,1,"つみ"],[17,1,"ひと"],[19,1,"ち"],[27,1,"み"],[38,1,"しゅ"],[42,1,"つみ"]],"text":"また彼が罪なき人の血を流し、罪なき人の血をエルサレムに満たしたためであって、主はその罪をゆるそうとはされなかった。"},{"ref":"2Kgs.24.5","start":12024005,"end":12024005,"break":"none","ruby":[[8,1,"た"],[10,2,"じせき"],[14,1,"かれ"],[25,1,"こと"],[31,1,"おう"],[33,3,"れきだいし"],[37,1,"しょ"]],"text":"エホヤキムのその他の事績と、彼がおこなったすべての事は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.24.6","start":12024006,"end":12024006,"break":"none","ruby":[[6,2,"せんぞ"],[14,1,"ねむ"],[19,1,"こ"],[26,1,"かわ"],[29,1,"おう"]],"text":"エホヤキムは先祖たちとともに眠り、その子エホヤキンが代って王となった。"},{"ref":"2Kgs.24.7","start":12024007,"end":12024007,"break":"none","ruby":[[5,1,"おう"],[7,1,"ふたた"],[11,1,"くに"],[14,1,"で"],[27,1,"おう"],[34,1,"かわ"],[41,1,"かわ"],[53,1,"おう"],[55,1,"ぞく"],[61,1,"と"]],"text":"エジプトの王は再びその国から出てこなかった。バビロンの王がエジプトの川からユフラテ川まで、すべてエジプトの王に属するものを取ったからである。"},{"ref":"2Kgs.24.8","start":12024008,"end":12024008,"break":"paragraph","ruby":[[6,1,"おう"],[11,1,"とき"],[14,1,"さい"],[25,1,"げつ"],[27,1,"あいだ"],[29,1,"よ"],[31,1,"おさ"],[35,1,"はは"],[49,1,"むすめ"],[52,1,"な"]],"text":"エホヤキンは王となった時十八歳で、エルサレムで三か月の間、世を治めた。母はエルサレムのエルナタンの娘で、名をネホシタといった。"},{"ref":"2Kgs.24.9","start":12024009,"end":12024009,"break":"none","ruby":[[11,1,"ちち"],[21,1,"しゅ"],[23,1,"め"],[25,1,"まえ"],[27,1,"あく"],[29,1,"おこな"]],"text":"エホヤキンはすべてその父がおこなったように主の目の前に悪を行った。"},{"ref":"2Kgs.24.10","start":12024010,"end":12024010,"break":"paragraph","ruby":[[10,1,"おう"],[19,2,"けらい"],[30,1,"せ"],[32,1,"のぼ"],[36,1,"まち"],[38,1,"かこ"]],"text":"そのころ、バビロンの王ネブカデネザルの家来たちはエルサレムに攻め上って、町を囲んだ。"},{"ref":"2Kgs.24.11","start":12024011,"end":12024011,"break":"none","ruby":[[2,2,"けらい"],[7,1,"まち"],[9,1,"かこ"],[22,1,"おう"],[33,1,"まち"],[35,1,"せ"]],"text":"その家来たちが町を囲んでいたとき、バビロンの王ネブカデネザルもまた町に攻めてきた。"},{"ref":"2Kgs.24.12","start":12024012,"end":12024012,"break":"none","ruby":[[3,1,"おう"],[12,1,"はは"],[16,2,"けらい"],[30,2,"じじゅう"],[35,1,"とも"],[37,1,"で"],[45,1,"おう"],[47,2,"こうふく"],[59,1,"おう"],[61,1,"かれ"],[63,2,"ほりょ"],[80,2,"ちせい"],[83,1,"だい"],[85,1,"ねん"]],"text":"ユダの王エホヤキンはその母、その家来、そのつかさたち、および侍従たちと共に出て、バビロンの王に降服したので、バビロンの王は彼を捕虜とした。これはネブカデネザルの治世の第八年であった。"},{"ref":"2Kgs.24.13","start":12024013,"end":12024013,"break":"none","ruby":[[0,1,"かれ"],[4,1,"しゅ"],[6,1,"みや"],[13,2,"ほうもつ"],[18,1,"おう"],[20,1,"いえ"],[22,2,"ほうもつ"],[30,1,"も"],[32,1,"だ"],[41,1,"おう"],[47,1,"つく"],[50,1,"しゅ"],[52,2,"しんでん"],[55,1,"お"],[63,1,"きん"],[65,1,"うつわ"],[67,1,"き"],[74,1,"しゅ"],[76,1,"い"]],"text":"彼はまた主の宮のもろもろの宝物および王の家の宝物をことごとく持ち出し、イスラエルの王ソロモンが造って主の神殿に置いたもろもろの金の器を切りこわした。主が言われたとおりである。"},{"ref":"2Kgs.24.14","start":12024014,"end":12024014,"break":"none","ruby":[[0,1,"かれ"],[14,2,"しみん"],[32,2,"ゆうし"],[43,2,"もっこう"],[46,2,"かじ"],[50,1,"にん"],[52,1,"とら"],[55,1,"い"],[59,1,"のこ"],[62,1,"もの"],[64,1,"くに"],[66,1,"たみ"],[68,1,"まず"],[71,1,"もの"]],"text":"彼はまたエルサレムのすべての市民、およびすべてのつかさとすべての勇士、ならびにすべての木工と鍛冶一万人を捕えて行った。残った者は国の民の貧しい者のみであった。"},{"ref":"2Kgs.24.15","start":12024015,"end":12024015,"break":"none","ruby":[[3,1,"かれ"],[16,1,"とら"],[19,1,"い"],[24,1,"おう"],[26,1,"はは"],[28,1,"おう"],[30,1,"つま"],[37,2,"じじゅう"],[40,1,"くに"],[48,2,"ひとびと"],[65,1,"とら"],[68,1,"い"]],"text":"さらに彼はエホヤキンをバビロンに捕えて行き、また王の母、王の妻たち、および侍従と国のうちのおもな人々をも、エルサレムからバビロンへ捕えて行った。"},{"ref":"2Kgs.24.16","start":12024016,"end":12024016,"break":"none","ruby":[[7,1,"おう"],[12,2,"ゆうかん"],[15,1,"もの"],[18,1,"にん"],[20,2,"もっこう"],[23,2,"かじ"],[27,1,"にん"],[32,1,"つよ"],[35,1,"よ"],[37,1,"たたか"],[39,1,"もの"],[43,1,"とら"],[51,1,"つ"],[54,1,"い"]],"text":"またバビロンの王はすべて勇敢な者七千人、木工と鍛冶一千人ならびに強くて良く戦う者をみな捕えてバビロンへ連れて行った。"},{"ref":"2Kgs.24.17","start":12024017,"end":12024017,"break":"none","ruby":[[8,1,"おう"],[16,1,"ちち"],[18,2,"きょうだい"],[26,1,"おう"],[36,1,"か"],[39,1,"な"],[46,1,"あらた"]],"text":"そしてバビロンの王はエホヤキンの父の兄弟マッタニヤを王としてエホヤキンに代え、名をゼデキヤと改めた。"},{"ref":"2Kgs.24.18","start":12024018,"end":12024018,"break":"paragraph","ruby":[[8,1,"さい"],[10,1,"おう"],[23,1,"ねん"],[25,1,"あいだ"],[27,1,"よ"],[29,1,"おさ"],[33,1,"はは"],[44,1,"むすめ"],[47,1,"な"]],"text":"ゼデキヤは二十一歳で王となり、エルサレムで十一年の間、世を治めた。母はリブナのエレミヤの娘で、名をハムタルといった。"},{"ref":"2Kgs.24.19","start":12024019,"end":12024019,"break":"none","ruby":[[22,1,"しゅ"],[24,1,"め"],[26,1,"まえ"],[28,1,"あく"],[30,1,"おこな"]],"text":"ゼデキヤはすべてエホヤキムがおこなったように主の目の前に悪を行った。"},{"ref":"2Kgs.24.20","start":12024020,"end":12024020,"break":"none","breaks":[[51,"paragraph"]],"ruby":[[14,1,"こと"],[16,1,"た"],[21,1,"しゅ"],[23,1,"いか"],[31,1,"しゅ"],[36,1,"かれ"],[40,1,"まえ"],[43,1,"はら"],[63,1,"おう"]],"text":"エルサレムとユダにこのような事の起ったのは主の怒りによるので、主はついに彼らをみ前から払いすてられた。さてゼデキヤはバビロンの王にそむいた。"}]