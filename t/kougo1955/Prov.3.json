[{"ref":"Prov.3.1","start":20003001,"end":20003001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[2,1,"こ"],[9,1,"おしえ"],[11,1,"わす"],[19,1,"いまし"],[22,1,"こころ"]],"text":"わが子よ、わたしの教を忘れず、わたしの戒めを心にとめよ。"},{"ref":"Prov.3.2","start":20003002,"end":20003002,"break":"line","breaks":[[19,"line"]],"ruby":[[13,1,"ひ"],[15,1,"なが"],[19,1,"いのち"],[21,1,"とし"],[23,1,"の"],[30,2,"へいあん"],[33,1,"ま"],[35,1,"くわ"]],"text":"そうすれば、これはあなたの日を長くし、命の年を延べ、あなたに平安を増し加える。"},{"ref":"Prov.3.3","start":20003003,"end":20003003,"break":"line","breaks":[[21,"line"]],"ruby":[[12,1,"す"],[28,1,"くび"],[30,1,"むす"],[33,1,"こころ"],[35,1,"ひ"]],"text":"いつくしみと、まこととを捨ててはならない、それをあなたの首に結び、心の碑にしるせ。"},{"ref":"Prov.3.4","start":20003004,"end":20003004,"break":"line","breaks":[[17,"line"]],"ruby":[[10,1,"かみ"],[12,1,"ひと"],[15,1,"まえ"],[17,1,"めぐ"],[21,1,"ほまれ"],[24,1,"え"]],"text":"そうすれば、あなたは神と人との前に恵みと、誉とを得る。"},{"ref":"Prov.3.5","start":20003005,"end":20003005,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"こころ"],[6,1,"しゅ"],[8,2,"しんらい"],[13,2,"じぶん"],[16,2,"ちしき"]],"text":"心をつくして主に信頼せよ、自分の知識にたよってはならない。"},{"ref":"Prov.3.6","start":20003006,"end":20003006,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"みち"],[6,1,"しゅ"],[8,1,"みと"],[18,1,"しゅ"],[24,1,"みち"]],"text":"すべての道で主を認めよ、そうすれば、主はあなたの道をまっすぐにされる。"},{"ref":"Prov.3.7","start":20003007,"end":20003007,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"じぶん"],[3,1,"み"],[5,1,"かしこ"],[8,1,"おも"],[17,1,"しゅ"],[19,1,"おそ"],[23,1,"あく"],[25,1,"はな"]],"text":"自分を見て賢いと思ってはならない、主を恐れて、悪を離れよ。"},{"ref":"Prov.3.8","start":20003008,"end":20003008,"break":"line","breaks":[[18,"line"]],"ruby":[[10,1,"み"],[12,1,"すこ"],[22,1,"ほね"],[24,2,"げんき"],[27,1,"あた"]],"text":"そうすれば、あなたの身を健やかにし、あなたの骨に元気を与える。"},{"ref":"Prov.3.9","start":20003009,"end":20003009,"break":"line","breaks":[[8,"line"]],"ruby":[[4,2,"ざいさん"],[12,2,"さんぶつ"],[15,1,"はつ"],[22,1,"しゅ"]],"text":"あなたの財産と、すべての産物の初なりをもって主をあがめよ。"},{"ref":"Prov.3.10","start":20003010,"end":20003010,"break":"line","breaks":[[18,"line"]],"ruby":[[10,1,"くら"],[12,1,"み"],[15,1,"あま"],[22,1,"さか"],[26,1,"あたら"],[29,1,"さけ"]],"text":"そうすれば、あなたの倉は満ちて余り、あなたの酒ぶねは新しい酒であふれる。"},{"ref":"Prov.3.11","start":20003011,"end":20003011,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"こ"],[5,1,"しゅ"],[7,1,"こら"],[11,1,"かろ"],[23,1,"いまし"]],"text":"わが子よ、主の懲しめを軽んじてはならない、その戒めをきらってはならない。"},{"ref":"Prov.3.12","start":20003012,"end":20003012,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"あい"],[6,1,"もの"],[9,1,"いまし"],[24,1,"ちち"],[28,1,"あい"],[31,1,"こ"],[33,1,"いまし"]],"text":"主は、愛する者を、戒められるからである、あたかも父がその愛する子を戒めるように。"},{"ref":"Prov.3.13","start":20003013,"end":20003013,"break":"stanza","breaks":[[10,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"もと"],[6,1,"え"],[8,1,"ひと"],[10,1,"さと"],[13,1,"え"],[15,1,"ひと"]],"text":"知恵を求めて得る人、悟りを得る人はさいわいである。"},{"ref":"Prov.3.14","start":20003014,"end":20003014,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,2,"ちえ"],[6,1,"え"],[12,1,"ぎん"],[17,1,"え"],[28,2,"りえき"],[31,1,"せい"],[32,1,"きん"],[36,1,"よ"]],"text":"知恵によって得るものは、銀によって得るものにまさり、その利益は精金よりも良いからである。"},{"ref":"Prov.3.15","start":20003015,"end":20003015,"break":"line","breaks":[[11,"line"]],"ruby":[[0,2,"ちえ"],[3,2,"ほうせき"],[8,1,"たっと"],[15,1,"のぞ"],[17,1,"なに"],[18,1,"もの"],[24,1,"くら"],[28,1,"た"]],"text":"知恵は宝石よりも尊く、あなたの望む何物も、これと比べるに足りない。"},{"ref":"Prov.3.16","start":20003016,"end":20003016,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"みぎ"],[4,1,"て"],[7,2,"ちょうじゅ"],[13,1,"ひだり"],[15,1,"て"],[18,1,"とみ"],[21,1,"ほまれ"]],"text":"その右の手には長寿があり、左の手には富と、誉がある。"},{"ref":"Prov.3.17","start":20003017,"end":20003017,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"みち"],[4,1,"たの"],[7,1,"みち"],[14,1,"みち"],[15,1,"すじ"],[19,2,"へいあん"]],"text":"その道は楽しい道であり、その道筋はみな平安である。"},{"ref":"Prov.3.18","start":20003018,"end":20003018,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"ちえ"],[7,1,"とら"],[10,1,"もの"],[13,1,"いのち"],[15,1,"き"],[27,1,"とら"],[30,1,"ひと"]],"text":"知恵は、これを捕える者には命の木である、これをしっかり捕える人はさいわいである。"},{"ref":"Prov.3.19","start":20003019,"end":20003019,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"ちえ"],[8,1,"ち"],[10,1,"もとい"],[15,1,"さと"],[21,1,"てん"],[23,1,"さだ"]],"text":"主は知恵をもって地の基をすえ、悟りをもって天を定められた。"},{"ref":"Prov.3.20","start":20003020,"end":20003020,"break":"line","ruby":[[2,2,"ちしき"],[8,1,"うみ"],[15,1,"くも"],[17,1,"つゆ"]],"text":"その知識によって海はわきいで、雲は露をそそぐ。"},{"ref":"Prov.3.21","start":20003021,"end":20003021,"break":"stanza","breaks":[[20,"line"]],"ruby":[[2,1,"こ"],[5,1,"たし"],[8,2,"ちえ"],[12,1,"つつし"],[16,1,"まも"],[27,1,"め"],[30,1,"はな"]],"text":"わが子よ、確かな知恵と、慎みとを守って、それをあなたの目から離してはならない。"},{"ref":"Prov.3.22","start":20003022,"end":20003022,"break":"line","breaks":[[13,"line"]],"ruby":[[7,1,"たましい"],[9,1,"いのち"],[17,1,"くび"],[19,1,"かざ"]],"text":"それはあなたの魂の命となりあなたの首の飾りとなる。"},{"ref":"Prov.3.23","start":20003023,"end":20003023,"break":"line","breaks":[[21,"line"]],"ruby":[[9,1,"やす"],[13,2,"じぶん"],[16,1,"みち"],[18,1,"い"],[25,1,"あし"]],"text":"こうして、あなたは安らかに自分の道を行き、あなたの足はつまずくことがない。"},{"ref":"Prov.3.24","start":20003024,"end":20003024,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"ざ"],[12,1,"おそ"],[21,1,"ふ"],[30,1,"ねむ"]],"text":"あなたは座しているとき、恐れることはなく、伏すとき、あなたの眠りはここちよい。"},{"ref":"Prov.3.25","start":20003025,"end":20003025,"break":"line","breaks":[[21,"line"]],"ruby":[[8,1,"おこ"],[10,2,"きょうふ"],[13,1,"おそ"],[21,1,"あ"],[24,1,"もの"],[26,1,"ほろ"],[29,1,"き"],[36,1,"おそ"]],"text":"あなたはにわかに起る恐怖を恐れることなく、悪しき者の滅びが来ても、それを恐れることはない。"},{"ref":"Prov.3.26","start":20003026,"end":20003026,"break":"line","breaks":[[19,"line"],[29,"line"]],"ruby":[[4,1,"しゅ"],[10,2,"しんらい"],[14,1,"もの"],[23,1,"あし"],[25,1,"まも"],[32,1,"とら"]],"text":"これは、主があなたの信頼する者であり、あなたの足を守って、わなに捕われさせられないからである。"},{"ref":"Prov.3.27","start":20003027,"end":20003027,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[4,1,"て"],[6,1,"ぜん"],[10,1,"ちから"],[25,1,"ひと"],[34,1,"ひか"]],"text":"あなたの手に善をなす力があるならば、これをなすべき人になすことをさし控えてはならない。"},{"ref":"Prov.3.28","start":20003028,"end":20003028,"break":"line","breaks":[[23,"line"],[35,"line"]],"ruby":[[4,1,"もの"],[6,1,"も"],[11,1,"とき"],[15,1,"とな"],[17,1,"びと"],[19,1,"む"],[24,1,"さ"],[30,1,"き"],[47,1,"い"]],"text":"あなたが物を持っている時、その隣り人に向かい、「去って、また来なさい。あす、それをあげよう」と言ってはならない。"},{"ref":"Prov.3.29","start":20003029,"end":20003029,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"とな"],[6,1,"びと"],[13,1,"やす"],[17,1,"す"],[22,1,"とき"],[27,1,"む"],[32,1,"あく"],[34,1,"はか"]],"text":"あなたの隣り人がかたわらに安らかに住んでいる時、これに向かって、悪を計ってはならない。"},{"ref":"Prov.3.30","start":20003030,"end":20003030,"break":"line","breaks":[[20,"line"]],"ruby":[[2,1,"ひと"],[8,1,"あく"],[10,1,"おこな"],[28,1,"あらそ"]],"text":"もし人があなたに悪を行ったのでなければ、ゆえなく、これと争ってはならない。"},{"ref":"Prov.3.31","start":20003031,"end":20003031,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ぼうぎゃく"],[3,1,"ひと"],[23,1,"みち"],[25,1,"えら"]],"text":"暴虐な人を、うらやんではならない、そのすべての道を選んではならない。"},{"ref":"Prov.3.32","start":20003032,"end":20003032,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"もの"],[7,1,"しゅ"],[9,1,"にく"],[23,1,"ただ"],[26,1,"もの"],[28,1,"しゅ"],[30,2,"しんにん"]],"text":"よこしまな者は主に憎まれるからである、しかし、正しい者は主に信任される。"},{"ref":"Prov.3.33","start":20003033,"end":20003033,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"あ"],[10,1,"もの"],[12,1,"いえ"],[21,1,"ただ"],[24,1,"ひと"],[30,1,"しゅ"],[32,1,"めぐ"]],"text":"主の、のろいは悪しき者の家にある、しかし、正しい人のすまいは主に恵まれる。"},{"ref":"Prov.3.34","start":20003034,"end":20003034,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[6,1,"もの"],[18,1,"もの"],[20,1,"めぐ"],[23,1,"あた"]],"text":"彼はあざける者をあざけり、へりくだる者に恵みを与えられる。"},{"ref":"Prov.3.35","start":20003035,"end":20003035,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[7,1,"ほまれ"],[9,1,"え"],[16,1,"おろ"],[19,1,"もの"],[27,1,"え"]],"text":"知恵ある者は、誉を得る、しかし、愚かな者ははずかしめを得る。"}]