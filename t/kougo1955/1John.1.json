[{"ref":"1John.1.1","start":62001001,"end":62001001,"break":"paragraph","ruby":[[0,1,"はじ"],[16,1,"き"],[22,1,"め"],[24,1,"み"],[31,1,"み"],[33,1,"て"],[51,1,"ことば"]],"text":"初めからあったもの、わたしたちが聞いたもの、目で見たもの、よく見て手でさわったもの、すなわち、いのちの言について――"},{"ref":"1John.1.2","start":62001002,"end":62001002,"break":"none","ruby":[[6,1,"あらわ"],[14,2,"えいえん"],[27,1,"み"],[47,1,"つ"],[49,1,"し"],[60,2,"えいえん"],[68,1,"ちち"],[70,1,"とも"],[78,1,"いま"],[86,1,"あらわ"]],"text":"このいのちが現れたので、この永遠のいのちをわたしたちは見て、そのあかしをし、かつ、あなたがたに告げ知らせるのである。この永遠のいのちは、父と共にいましたが、今やわたしたちに現れたものである――"},{"ref":"1John.1.3","start":62001003,"end":62001003,"break":"none","ruby":[[11,1,"み"],[16,1,"き"],[30,1,"つ"],[32,1,"し"],[54,1,"まじ"],[79,1,"まじ"],[85,1,"ちち"],[90,2,"みこ"],[102,1,"まじ"]],"text":"すなわち、わたしたちが見たもの、聞いたものを、あなたがたにも告げ知らせる。それは、あなたがたも、わたしたちの交わりにあずかるようになるためである。わたしたちの交わりとは、父ならびに御子イエス・キリストとの交わりのことである。"},{"ref":"1John.1.4","start":62001004,"end":62001004,"break":"none","ruby":[[3,1,"か"],[17,1,"よろこ"],[20,1,"み"]],"text":"これを書きおくるのは、わたしたちの喜びが満ちあふれるためである。"},{"ref":"1John.1.5","start":62001005,"end":62001005,"break":"paragraph","ruby":[[11,1,"き"],[21,1,"つた"],[36,1,"かみ"],[38,1,"ひかり"],[44,1,"かみ"],[47,1,"すこ"],[50,1,"くら"]],"text":"わたしたちがイエスから聞いて、あなたがたに伝えるおとずれは、こうである。神は光であって、神には少しの暗いところもない。"},{"ref":"1John.1.6","start":62001006,"end":62001006,"break":"none","ruby":[[0,1,"かみ"],[2,1,"まじ"],[11,1,"い"],[23,1,"なか"],[25,1,"ある"],[39,1,"いつわ"],[50,2,"しんり"],[53,1,"おこな"]],"text":"神と交わりをしていると言いながら、もし、やみの中を歩いているなら、わたしたちは偽っているのであって、真理を行っているのではない。"},{"ref":"1John.1.7","start":62001007,"end":62001007,"break":"none","ruby":[[4,1,"かみ"],[6,1,"ひかり"],[8,1,"なか"],[23,1,"ひかり"],[25,1,"なか"],[27,1,"ある"],[39,1,"たがい"],[41,1,"まじ"],[52,2,"みこ"],[58,1,"ち"],[65,1,"つみ"]],"text":"しかし、神が光の中にいますように、わたしたちも光の中を歩くならば、わたしたちは互に交わりをもち、そして、御子イエスの血が、すべての罪からわたしたちをきよめるのである。"},{"ref":"1John.1.8","start":62001008,"end":62001008,"break":"none","ruby":[[3,1,"つみ"],[8,1,"い"],[16,2,"じぶん"],[19,1,"あざむ"],[28,2,"しんり"]],"text":"もし、罪がないと言うなら、それは自分を欺くことであって、真理はわたしたちのうちにない。"},{"ref":"1John.1.9","start":62001009,"end":62001009,"break":"none","ruby":[[9,2,"じぶん"],[12,1,"つみ"],[14,2,"こくはく"],[22,1,"かみ"],[24,2,"しんじつ"],[27,1,"ただ"],[40,1,"つみ"],[50,2,"ふぎ"],[64,1,"くだ"]],"text":"もし、わたしたちが自分の罪を告白するならば、神は真実で正しいかたであるから、その罪をゆるし、すべての不義からわたしたちをきよめて下さる。"},{"ref":"1John.1.10","start":62001010,"end":62001010,"break":"none","ruby":[[3,1,"つみ"],[5,1,"おか"],[14,1,"い"],[22,1,"かみ"],[24,1,"いつわ"],[26,1,"もの"],[36,1,"かみ"],[38,1,"ことば"]],"text":"もし、罪を犯したことがないと言うなら、それは神を偽り者とするのであって、神の言はわたしたちのうちにない。"}]