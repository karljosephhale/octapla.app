[{"ref":"Neh.6.1","start":16006001,"end":16006001,"break":"paragraph","ruby":[[24,1,"た"],[31,1,"てき"],[38,2,"じょうへき"],[41,1,"きず"],[43,1,"おわ"],[50,1,"やぶ"],[53,1,"のこ"],[58,1,"き"],[68,1,"とき"],[73,1,"もん"]],"text":"サンバラテ、トビヤ、アラビヤびとガシムおよびその他のわれわれの敵は、わたしが城壁を築き終って、一つの破れも残らないと聞いた。（しかしその時にはまだ門のとびらをつけていなかったのである。）"},{"ref":"Neh.6.2","start":16006002,"end":16006002,"break":"none","ruby":[[17,2,"ししゃ"],[25,1,"い"],[41,2,"へいや"],[49,1,"むら"],[51,2,"かいけん"],[59,1,"かれ"],[66,2,"きがい"],[69,1,"くわ"],[74,1,"かんが"]],"text":"そこでサンバラテとガシムはわたしに使者をつかわして言った、「さあ、われわれはオノの平野にある一つの村で会見しよう」と。彼らはわたしに危害を加えようと考えていたのである。"},{"ref":"Neh.6.3","start":16006003,"end":16006003,"break":"none","ruby":[[7,1,"かれ"],[10,2,"ししゃ"],[18,1,"い"],[28,1,"おお"],[32,2,"こうじ"],[41,1,"くだ"],[44,1,"い"],[60,2,"こうじ"],[75,1,"ところ"],[77,1,"くだ"],[80,1,"い"],[85,1,"かん"],[87,2,"こうじ"]],"text":"それでわたしは彼らに使者をつかわして言わせた、「わたしは大いなる工事をしているから下って行くことはできない。どうしてこの工事をさしおいて、あなたがたの所へ下って行き、その間、工事をやめることができようか」。"},{"ref":"Neh.6.4","start":16006004,"end":16006004,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ど"],[16,1,"ひと"],[29,1,"おな"],[34,1,"かれ"],[37,1,"こた"]],"text":"彼らは四度までこのようにわたしに人をつかわしたが、わたしは同じように彼らに答えた。"},{"ref":"Neh.6.5","start":16006005,"end":16006005,"break":"none","ruby":[[12,2,"どめ"],[21,1,"まえ"],[38,1,"て"],[41,2,"かいふう"],[44,2,"てがみ"],[47,1,"たずさ"]],"text":"ところが、サンバラテは五度目にそのしもべを前のようにわたしにつかわした。その手には開封の手紙を携えていた。"},{"ref":"Neh.6.6","start":16006006,"end":16006006,"break":"none","ruby":[[2,1,"なか"],[4,1,"つぎ"],[18,1,"しょ"],[19,2,"こくみん"],[22,1,"あいだ"],[24,1,"い"],[26,1,"つた"],[37,1,"い"],[51,1,"ひと"],[53,1,"とも"],[55,2,"はんらん"],[58,1,"くわだ"],[67,2,"じょうへき"],[70,1,"きず"],[80,1,"い"],[94,1,"かれ"],[97,1,"おう"]],"text":"その中に次のようにしるしてあった、「諸国民の間に言い伝えられ、またガシムも言っているが、あなたはユダヤ人と共に反乱を企て、これがために城壁を築いている。またその言うところによれば、あなたは彼らの王になろうとしている。"},{"ref":"Neh.6.7","start":16006007,"end":16006007,"break":"none","ruby":[[6,3,"よげんしゃ"],[10,1,"た"],[29,1,"つた"],[38,1,"おう"],[44,1,"い"],[59,2,"ことば"],[65,1,"おう"],[67,1,"きこ"],[80,1,"いま"],[93,1,"とも"],[95,2,"そうだん"]],"text":"またあなたは預言者を立てて、あなたのことをエルサレムにのべ伝えさせ、『ユダに王がある』と言わせているが、そのことはこの言葉のとおり王に聞えるでしょう。それゆえ、今おいでなさい。われわれは共に相談しましょう」。"},{"ref":"Neh.6.8","start":16006008,"end":16006008,"break":"none","ruby":[[7,1,"かれ"],[9,1,"ひと"],[16,1,"い"],[26,1,"い"],[48,2,"じぶん"],[51,1,"こころ"],[54,1,"つく"],[56,1,"だ"]],"text":"そこでわたしは彼に人をつかわして言わせた、「あなたの言うようなことはしていません。あなたはそれを自分の心から造り出したのです」と。"},{"ref":"Neh.6.9","start":16006009,"end":16006009,"break":"none","ruby":[[0,1,"かれ"],[6,1,"かれ"],[9,1,"て"],[11,1,"よわ"],[14,2,"こうじ"],[27,2,"こうじ"],[30,2,"じょうじゅ"],[40,1,"かんが"],[64,1,"かみ"],[76,1,"て"],[78,1,"つよ"]],"text":"彼らはみな「彼らの手が弱って工事をやめるようになれば、工事は成就しないだろう」と考えて、われわれをおどそうとしたのである。しかし神よ、どうぞいまわたしの手を強めてください。"},{"ref":"Neh.6.10","start":16006010,"end":16006010,"break":"paragraph","ruby":[[12,1,"こ"],[17,1,"こ"],[22,1,"いえ"],[24,1,"い"],[31,1,"かれ"],[33,1,"と"],[41,1,"い"],[51,1,"かみ"],[53,1,"みや"],[58,2,"しんでん"],[61,1,"なか"],[63,2,"かいごう"],[67,2,"しんでん"],[70,1,"と"],[72,1,"と"],[82,1,"かれ"],[89,1,"ころ"],[95,1,"く"],[105,1,"よる"],[114,1,"ころ"],[120,1,"く"]],"text":"さてわたしはメヘタベルの子デラヤの子シマヤの家に行ったところ、彼は閉じこもっていて言った、「われわれは神の宮すなわち神殿の中で会合し、神殿の戸を閉じておきましょう。彼らはあなたを殺そうとして来るからです。きっと夜のうちにあなたを殺そうとして来るでしょう」。"},{"ref":"Neh.6.11","start":16006011,"end":16006011,"break":"none","ruby":[[4,1,"い"],[16,1,"もの"],[22,1,"に"],[36,1,"もの"],[41,2,"しんでん"],[48,1,"いのち"],[50,1,"まっと"]],"text":"わたしは言った、「わたしのような者がどうして逃げられよう。わたしのような者でだれが神殿にはいって命を全うすることができよう。わたしははいらない」。"},{"ref":"Neh.6.12","start":16006012,"end":16006012,"break":"none","ruby":[[4,1,"さと"],[8,1,"かみ"],[10,1,"かれ"],[24,1,"かれ"],[36,2,"よげん"],[39,1,"つた"],[55,1,"かれ"],[57,2,"ばいしゅう"]],"text":"わたしは悟った。神が彼をつかわされたのではない。彼がわたしにむかってこの預言を伝えたのは、トビヤとサンバラテが彼を買収したためである。"},{"ref":"Neh.6.13","start":16006013,"end":16006013,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ばいしゅう"],[11,1,"こと"],[27,1,"おそ"],[45,1,"つみ"],[47,1,"おか"],[55,2,"あくめい"],[61,2,"ぶじょく"]],"text":"彼が買収されたのはこの事のためである。すなわちわたしを恐れさせ、わたしにこのようにさせて、罪を犯させ、わたしに悪名をきせて侮辱するためであった。"},{"ref":"Neh.6.14","start":16006014,"end":16006014,"break":"none","ruby":[[2,1,"かみ"],[17,1,"おんな"],[18,3,"よげんしゃ"],[31,1,"た"],[33,3,"よげんしゃ"],[46,1,"おそ"],[55,1,"もの"],[64,1,"かれ"],[67,1,"い"],[77,1,"むく"]],"text":"わが神よ、トビヤ、サンバラテおよび女預言者ノアデヤならびにその他の預言者など、すべてわたしを恐れさせようとする者たちをおぼえて、彼らが行ったこれらのわざに報いてください。"},{"ref":"Neh.6.15","start":16006015,"end":16006015,"break":"paragraph","ruby":[[4,2,"じょうへき"],[10,1,"にち"],[12,1,"へ"],[19,1,"つき"],[24,1,"にち"],[26,2,"かんせい"]],"text":"こうして城壁は五十二日を経て、エルルの月の二十五日に完成した。"},{"ref":"Neh.6.16","start":16006016,"end":16006016,"break":"none","ruby":[[5,1,"てき"],[7,1,"みな"],[11,1,"き"],[14,1,"とき"],[21,2,"しゅうい"],[24,3,"いほうじん"],[30,1,"おそ"],[33,1,"おお"],[36,2,"めんぼく"],[39,1,"うしな"],[43,1,"かれ"],[48,2,"こうじ"],[57,1,"かみ"],[59,1,"たす"],[65,2,"じょうじゅ"],[72,1,"さと"]],"text":"われわれの敵が皆これを聞いた時、われわれの周囲の異邦人はみな恐れ、大いに面目を失った。彼らはこの工事が、われわれの神の助けによって成就したことを悟ったからである。"},{"ref":"Neh.6.17","start":16006017,"end":16006017,"break":"none","ruby":[[10,1,"たっと"],[12,2,"ひとびと"],[15,1,"おお"],[18,2,"てがみ"],[25,1,"おく"],[33,2,"てがみ"],[38,1,"かれ"]],"text":"またそのころ、ユダの尊い人々は多くの手紙をトビヤに送った。トビヤの手紙もまた彼らにきた。"},{"ref":"Neh.6.18","start":16006018,"end":16006018,"break":"none","ruby":[[7,1,"こ"],[13,1,"むこ"],[27,1,"おお"],[30,1,"もの"],[32,1,"かれ"],[34,1,"ちか"],[37,1,"た"],[52,1,"こ"],[63,1,"こ"],[70,1,"むすめ"],[72,1,"つま"]],"text":"トビヤはアラの子シカニヤの婿であったので、ユダのうちの多くの者が彼と誓いを立てていたからである。トビヤの子ヨハナンもベレキヤの子メシュラムの娘を妻にめとった。"},{"ref":"Neh.6.19","start":16006019,"end":16006019,"break":"none","ruby":[[0,1,"かれ"],[9,2,"ぜんこう"],[16,1,"まえ"],[18,1,"かた"],[27,2,"ことば"],[30,1,"かれ"],[32,1,"つた"],[44,2,"てがみ"],[47,1,"おく"],[55,1,"おそ"]],"text":"彼らはまたトビヤの善行をわたしの前に語り、またわたしの言葉を彼に伝えた。トビヤはたびたび手紙を送って、わたしを恐れさせようとした。"}]