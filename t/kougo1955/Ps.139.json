[{"ref":"Ps.139.1","start":19139001,"end":19139001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"さぐ"],[18,1,"し"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"主よ、あなたはわたしを探り、わたしを知りつくされました。"},{"ref":"Ps.139.2","start":19139002,"end":19139002,"break":"line","breaks":[[19,"line"]],"ruby":[[12,1,"た"],[16,1,"し"],[19,1,"とお"],[25,1,"おも"]],"text":"あなたはわがすわるをも、立つをも知り、遠くからわが思いをわきまえられます。"},{"ref":"Ps.139.3","start":19139003,"end":19139003,"break":"line","breaks":[[20,"line"]],"ruby":[[6,1,"あゆ"],[11,1,"ふ"],[15,1,"さぐ"],[17,1,"だ"],[27,1,"みち"],[34,1,"し"]],"text":"あなたはわが歩むをも、伏すをも探り出し、わがもろもろの道をことごとく知っておられます。"},{"ref":"Ps.139.4","start":19139004,"end":19139004,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"した"],[6,2,"いちごん"],[14,1,"しゅ"],[29,1,"し"]],"text":"わたしの舌に一言もないのに、主よ、あなたはことごとくそれを知られます。"},{"ref":"Ps.139.5","start":19139005,"end":19139005,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"うしろ"],[8,1,"まえ"],[15,1,"かこ"],[22,1,"うえ"],[25,1,"て"]],"text":"あなたは後から、前からわたしを囲み、わたしの上にみ手をおかれます。"},{"ref":"Ps.139.6","start":19139006,"end":19139006,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[5,2,"ちしき"],[12,3,"ふしぎ"],[22,1,"おも"],[25,1,"およ"],[34,1,"たか"],[37,1,"たっ"]],"text":"このような知識はあまりに不思議で、わたしには思いも及びません。これは高くて達することはできません。"},{"ref":"Ps.139.7","start":19139007,"end":19139007,"break":"line","breaks":[[11,"line"],[27,"line"],[38,"line"]],"ruby":[[7,1,"い"],[19,1,"はな"],[34,1,"い"],[43,1,"まえ"]],"text":"わたしはどこへ行って、あなたのみたまを離れましょうか。わたしはどこへ行って、あなたのみ前をのがれましょうか。"},{"ref":"Ps.139.8","start":19139008,"end":19139008,"break":"line","breaks":[[25,"line"],[39,"line"]],"ruby":[[4,1,"てん"],[29,2,"よみ"],[32,1,"とこ"],[34,1,"もう"]],"text":"わたしが天にのぼっても、あなたはそこにおられます。わたしが陰府に床を設けても、あなたはそこにおられます。"},{"ref":"Ps.139.9","start":19139009,"end":19139009,"break":"line","ruby":[[9,1,"つばさ"],[14,1,"うみ"],[19,1,"す"]],"text":"わたしがあけぼのの翼をかって海のはてに住んでも、"},{"ref":"Ps.139.10","start":19139010,"end":19139010,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"て"],[9,1,"ところ"],[15,1,"みちび"],[22,1,"みぎ"],[25,1,"て"]],"text":"あなたのみ手はその所でわたしを導き、あなたの右のみ手はわたしをささえられます。"},{"ref":"Ps.139.11","start":19139011,"end":19139011,"break":"line","breaks":[[12,"line"]],"ruby":[[16,1,"かこ"],[18,1,"ひかり"],[20,1,"よる"],[30,1,"い"]],"text":"「やみはわたしをおおい、わたしを囲む光は夜となれ」とわたしが言っても、"},{"ref":"Ps.139.12","start":19139012,"end":19139012,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[9,1,"くら"],[15,1,"よる"],[17,1,"ひる"],[22,1,"かがや"],[36,1,"ひかり"],[38,1,"こと"]],"text":"あなたには、やみも暗くはなく、夜も昼のように輝きます。あなたには、やみも光も異なることはありません。"},{"ref":"Ps.139.13","start":19139013,"end":19139013,"break":"line","breaks":[[13,"line"]],"ruby":[[6,2,"ないぞう"],[15,1,"はは"],[17,2,"たいない"],[24,1,"く"],[26,1,"た"]],"text":"あなたはわが内臓をつくり、わが母の胎内でわたしを組み立てられました。"},{"ref":"Ps.139.14","start":19139014,"end":19139014,"break":"line","breaks":[[16,"line"],[36,"line"],[49,"line"]],"ruby":[[20,1,"おそれ"],[29,1,"かた"],[53,1,"もっと"],[61,1,"し"]],"text":"わたしはあなたをほめたたえます。あなたは恐るべく、くすしき方だからです。あなたのみわざはくすしく、あなたは最もよくわたしを知っておられます。"},{"ref":"Ps.139.15","start":19139015,"end":19139015,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[4,1,"かく"],[7,1,"ところ"],[9,1,"つく"],[13,1,"ち"],[15,1,"ふか"],[17,1,"ところ"],[22,1,"あわ"],[33,1,"ほね"],[39,1,"かく"]],"text":"わたしが隠れた所で造られ、地の深い所でつづり合されたとき、わたしの骨はあなたに隠れることがなかった。"},{"ref":"Ps.139.16","start":19139016,"end":19139016,"break":"line","breaks":[[7,"line"],[29,"line"],[49,"line"],[61,"line"]],"ruby":[[4,1,"め"],[24,1,"み"],[47,1,"ひ"],[52,1,"にち"],[63,1,"ひ"],[74,1,"しょ"]],"text":"あなたの目は、まだできあがらないわたしのからだを見られた。わたしのためにつくられたわがよわいの日のまだ一日もなかったとき、その日はことごとくあなたの書にしるされた。"},{"ref":"Ps.139.17","start":19139017,"end":19139017,"break":"line","breaks":[[17,"line"],[33,"line"]],"ruby":[[0,1,"かみ"],[13,1,"おも"],[24,1,"たっと"],[35,2,"ぜんたい"],[41,2,"こうだい"]],"text":"神よ、あなたのもろもろのみ思いは、なんとわたしに尊いことでしょう。その全体はなんと広大なことでしょう。"},{"ref":"Ps.139.18","start":19139018,"end":19139018,"break":"line","breaks":[[16,"line"],[27,"line"],[38,"line"]],"ruby":[[7,1,"かぞ"],[18,1,"かず"],[20,1,"すな"],[24,1,"おお"],[31,1,"め"],[48,1,"とも"]],"text":"わたしがこれを数えようとすれば、その数は砂よりも多い。わたしが目ざめるとき、わたしはなおあなたと共にいます。"},{"ref":"Ps.139.19","start":19139019,"end":19139019,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かみ"],[6,1,"あ"],[9,1,"もの"],[11,1,"ころ"],[19,1,"ち"],[21,1,"なが"],[23,1,"もの"],[30,1,"はな"],[32,1,"さ"]],"text":"神よ、どうか悪しき者を殺してください。血を流す者をわたしから離れ去らせてください。"},{"ref":"Ps.139.20","start":19139020,"end":19139020,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,2,"てきい"],[22,1,"さか"],[26,1,"たか"],[30,1,"あく"],[32,1,"おこな"],[34,2,"ひとびと"]],"text":"彼らは敵意をもってあなたをあなどり、あなたに逆らって高ぶり、悪を行う人々です。"},{"ref":"Ps.139.21","start":19139021,"end":19139021,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"にく"],[13,1,"もの"],[15,1,"にく"],[22,1,"さか"],[26,1,"おこ"],[28,1,"た"],[30,1,"もの"]],"text":"主よ、わたしはあなたを憎む者を憎み、あなたに逆らって起り立つ者をいとうではありませんか。"},{"ref":"Ps.139.22","start":19139022,"end":19139022,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"まった"],[6,1,"かれ"],[9,1,"にく"],[12,1,"かれ"],[19,1,"てき"],[21,1,"おも"]],"text":"わたしは全く彼らを憎み、彼らをわたしの敵と思います。"},{"ref":"Ps.139.23","start":19139023,"end":19139023,"break":"line","breaks":[[22,"line"],[40,"line"]],"ruby":[[0,1,"かみ"],[11,1,"さぐ"],[17,1,"こころ"],[19,1,"し"],[26,1,"こころ"],[37,1,"おも"],[40,1,"し"]],"text":"神よ、どうか、わたしを探って、わが心を知り、わたしを試みて、わがもろもろの思いを知ってください。"},{"ref":"Ps.139.24","start":19139024,"end":19139024,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"あ"],[7,1,"みち"],[16,1,"み"],[28,1,"みち"],[30,1,"みちび"]],"text":"わたしに悪しき道のあるかないかを見て、わたしをとこしえの道に導いてください。"}]