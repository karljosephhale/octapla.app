[{"ref":"2Cor.10.1","start":47010001,"end":47010001,"break":"paragraph","ruby":[[10,1,"あいだ"],[14,1,"めん"],[16,1,"む"],[28,1,"はな"],[35,1,"き"],[37,1,"つよ"],[54,1,"やさ"],[58,2,"かんだい"],[72,1,"すす"]],"text":"さて、「あなたがたの間にいて面と向かってはおとなしいが、離れていると、気が強くなる」このパウロが、キリストの優しさ、寛大さをもって、あなたがたに勧める。"},{"ref":"2Cor.10.2","start":47010002,"end":47010002,"break":"none","ruby":[[6,1,"にく"],[8,1,"したが"],[11,1,"ある"],[21,1,"おも"],[26,2,"ひとびと"],[29,1,"たい"],[38,2,"ゆうかん"],[41,2,"こうどう"],[59,1,"ところ"],[72,1,"おも"]],"text":"わたしたちを肉に従って歩いているかのように思っている人々に対しては、わたしは勇敢に行動するつもりであるが、あなたがたの所では、どうか、そのような思いきったことをしないですむようでありたい。"},{"ref":"2Cor.10.3","start":47010003,"end":47010003,"break":"none","ruby":[[7,1,"にく"],[12,1,"ある"],[20,1,"にく"],[22,1,"したが"],[25,1,"たたか"]],"text":"わたしたちは、肉にあって歩いてはいるが、肉に従って戦っているのではない。"},{"ref":"2Cor.10.4","start":47010004,"end":47010004,"break":"none","ruby":[[6,1,"たたか"],[9,2,"ぶき"],[13,1,"にく"],[22,1,"かみ"],[28,2,"ようさい"],[32,2,"はかい"],[39,1,"ちから"],[59,2,"ぎろん"],[62,1,"やぶ"]],"text":"わたしたちの戦いの武器は、肉のものではなく、神のためには要塞をも破壊するほどの力あるものである。わたしたちはさまざまな議論を破り、"},{"ref":"2Cor.10.5","start":47010005,"end":47010005,"break":"none","ruby":[[0,1,"かみ"],[2,2,"ちえ"],[5,1,"さか"],[9,1,"た"],[18,3,"しょうがいぶつ"],[22,1,"う"],[32,1,"おも"],[46,2,"ふくじゅう"]],"text":"神の知恵に逆らって立てられたあらゆる障害物を打ちこわし、すべての思いをとりこにしてキリストに服従させ、"},{"ref":"2Cor.10.6","start":47010006,"end":47010006,"break":"none","ruby":[[10,2,"かんぜん"],[13,2,"ふくじゅう"],[17,1,"とき"],[22,1,"ふ"],[23,2,"じゅうじゅん"],[26,1,"もの"],[28,2,"しょばつ"],[35,2,"ようい"]],"text":"そして、あなたがたが完全に服従した時、すべて不従順な者を処罰しようと、用意しているのである。"},{"ref":"2Cor.10.7","start":47010007,"end":47010007,"break":"paragraph","ruby":[[11,1,"こと"],[15,1,"み"],[24,1,"ひと"],[32,1,"ぞく"],[35,1,"もの"],[38,2,"じにん"],[49,1,"ひと"],[53,2,"いちど"],[57,2,"はんせい"],[68,1,"ひと"],[75,1,"ぞく"],[78,1,"もの"]],"text":"あなたがたは、うわべの事だけを見ている。もしある人が、キリストに属する者だと自任しているなら、その人はもう一度よく反省すべきである。その人がキリストに属する者であるように、わたしたちもそうである。"},{"ref":"2Cor.10.8","start":47010008,"end":47010008,"break":"none","ruby":[[10,1,"たお"],[18,1,"たか"],[24,1,"しゅ"],[33,1,"たま"],[37,2,"けんい"],[50,1,"ほこ"],[60,1,"はじ"]],"text":"たとい、あなたがたを倒すためではなく高めるために主からわたしたちに賜わった権威について、わたしがやや誇りすぎたとしても、恥にはなるまい。"},{"ref":"2Cor.10.9","start":47010009,"end":47010009,"break":"none","ruby":[[8,2,"てがみ"],[27,1,"おも"]],"text":"ただ、わたしは、手紙であなたがたをおどしているのだと、思われたくはない。"},{"ref":"2Cor.10.10","start":47010010,"end":47010010,"break":"none","ruby":[[0,1,"ひと"],[2,1,"い"],[6,1,"かれ"],[8,2,"てがみ"],[11,2,"おもみ"],[17,2,"ちからづよ"],[22,1,"あ"],[25,1,"み"],[28,2,"がいけん"],[31,1,"よわ"],[36,1,"はなし"]],"text":"人は言う、「彼の手紙は重味があって力強いが、会って見ると外見は弱々しく、話はつまらない」。"},{"ref":"2Cor.10.11","start":47010011,"end":47010011,"break":"none","ruby":[[4,1,"ひと"],[6,2,"こころえ"],[22,1,"はな"],[27,1,"か"],[32,2,"てがみ"],[35,2,"ことば"],[42,2,"いっしょ"],[47,1,"とき"],[50,1,"おな"]],"text":"そういう人は心得ているがよい。わたしたちは、離れていて書きおくる手紙の言葉どおりに、一緒にいる時でも同じようにふるまうのである。"},{"ref":"2Cor.10.12","start":47010012,"end":47010012,"break":"none","ruby":[[7,2,"じこ"],[9,2,"すいせん"],[17,2,"ひとびと"],[20,2,"じぶん"],[23,1,"どう"],[24,1,"れつ"],[30,2,"ひかく"],[40,1,"かれ"],[43,2,"なかま"],[45,2,"どうし"],[48,1,"たがい"],[53,1,"あ"],[58,1,"たがい"],[60,1,"くら"],[62,1,"あ"],[72,2,"ちえ"]],"text":"わたしたちは、自己推薦をするような人々と自分を同列においたり比較したりはしない。彼らは仲間同志で互にはかり合ったり、互に比べ合ったりしているが、知恵のないしわざである。"},{"ref":"2Cor.10.13","start":47010013,"end":47010013,"break":"none","ruby":[[10,2,"げんど"],[16,1,"ほこ"],[32,1,"かみ"],[34,1,"わ"],[36,1,"あ"],[39,1,"くだ"],[43,2,"ちいき"],[46,3,"げんどない"],[50,1,"ほこ"],[64,2,"げんど"],[79,1,"ところ"],[82,1,"い"]],"text":"しかし、わたしたちは限度をこえて誇るようなことはしない。むしろ、神が割り当てて下さった地域の限度内で誇るにすぎない。わたしはその限度にしたがって、あなたがたの所まで行ったのである。"},{"ref":"2Cor.10.14","start":47010014,"end":47010014,"break":"none","ruby":[[13,1,"ところ"],[16,1,"い"],[20,1,"もの"],[33,1,"て"],[35,1,"の"],[47,2,"じじつ"],[56,2,"さいしょ"],[64,2,"ふくいん"],[67,1,"たずさ"],[77,1,"ところ"],[81,1,"い"]],"text":"わたしたちは、あなたがたの所まで行けない者であるかのように、むりに手を延ばしているのではない。事実、わたしたちが最初にキリストの福音を携えて、あなたがたの所までも行ったのである。"},{"ref":"2Cor.10.15","start":47010015,"end":47010015,"break":"none","ruby":[[6,2,"げんど"],[13,2,"たにん"],[16,1,"はたら"],[19,1,"ほこ"],[40,2,"しんこう"],[43,2,"せいちょう"],[58,1,"はたら"],[61,2,"はんい"],[70,1,"なか"],[76,1,"おお"],[84,1,"のぞ"]],"text":"わたしたちは限度をこえて、他人の働きを誇るようなことはしない。ただ、あなたがたの信仰が成長するにつれて、わたしたちの働きの範囲があなたがたの中でますます大きくなることを望んでいる。"},{"ref":"2Cor.10.16","start":47010016,"end":47010016,"break":"none","ruby":[[14,1,"ひと"],[16,2,"ちいき"],[31,1,"ほこ"],[46,1,"こ"],[57,2,"ふくいん"],[60,1,"の"],[62,1,"つた"]],"text":"こうして、わたしたちはほかの人の地域ですでになされていることを誇ることはせずに、あなたがたを越えたさきざきにまで、福音を宣べ伝えたい。"},{"ref":"2Cor.10.17","start":47010017,"end":47010017,"break":"none","ruby":[[0,1,"ほこ"],[2,1,"もの"],[4,1,"しゅ"],[6,1,"ほこ"]],"text":"誇る者は主を誇るべきである。"},{"ref":"2Cor.10.18","start":47010018,"end":47010018,"break":"none","ruby":[[0,2,"じぶん"],[3,2,"じぶん"],[6,2,"すいせん"],[10,1,"ひと"],[16,1,"しゅ"],[18,2,"すいせん"],[23,1,"ひと"],[27,1,"たし"],[30,1,"ひと"]],"text":"自分で自分を推薦する人ではなく、主に推薦される人こそ、確かな人なのである。"}]