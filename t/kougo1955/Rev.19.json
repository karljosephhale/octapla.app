[{"ref":"Rev.19.1","start":66019001,"end":66019001,"break":"paragraph","breaks":[[29,"stanza"],[44,"line"]],"ruby":[[2,1,"のち"],[8,1,"てん"],[10,2,"たいぐん"],[14,2,"おおごえ"],[17,1,"とな"],[23,1,"こえ"],[25,1,"き"],[35,1,"すくい"],[37,2,"えいこう"],[40,1,"ちから"],[48,1,"かみ"]],"text":"この後、わたしは天の大群衆が大声で唱えるような声を聞いた、「ハレルヤ、救と栄光と力とは、われらの神のものであり、"},{"ref":"Rev.19.2","start":66019002,"end":66019002,"break":"line","breaks":[[14,"line"],[33,"line"],[44,"line"]],"ruby":[[7,2,"しんじつ"],[10,1,"ただ"],[14,1,"かみ"],[17,2,"かんいん"],[20,1,"ち"],[22,1,"けが"],[25,1,"だい"],[26,2,"いんぷ"],[33,1,"かみ"],[35,1,"しもべ"],[39,1,"ち"],[41,2,"ほうふく"],[44,2,"かのじょ"]],"text":"そのさばきは、真実で正しい。神は、姦淫で地を汚した大淫婦をさばき、神の僕たちの血の報復を彼女になさったからである」。"},{"ref":"Rev.19.3","start":66019003,"end":66019003,"break":"paragraph","ruby":[[0,1,"ふたた"],[2,1,"こえ"],[14,2,"かのじょ"],[17,1,"や"],[21,1,"ひ"],[23,1,"けむり"],[26,2,"よよ"],[28,1,"かぎ"],[32,1,"た"],[39,1,"い"]],"text":"再び声があって、「ハレルヤ、彼女が焼かれる火の煙は、世々限りなく立ちのぼる」と言った。"},{"ref":"Rev.19.4","start":66019004,"end":66019004,"break":"none","ruby":[[7,1,"にん"],[9,2,"ちょうろう"],[15,1,"い"],[17,1,"もの"],[22,1,"ふ"],[25,2,"みざ"],[31,1,"かみ"],[33,1,"はい"],[36,1,"い"]],"text":"すると、二十四人の長老と四つの生き物とがひれ伏し、御座にいます神を拝して言った、「アァメン、ハレルヤ」。"},{"ref":"Rev.19.5","start":66019005,"end":66019005,"break":"none","breaks":[[16,"stanza"],[39,"line"],[51,"line"]],"ruby":[[2,1,"とき"],[4,2,"みざ"],[8,1,"こえ"],[10,1,"で"],[12,1,"い"],[21,1,"かみ"],[23,1,"しもべ"],[28,1,"かみ"],[34,1,"もの"],[39,1,"ちい"],[42,1,"もの"],[44,1,"おお"],[48,1,"もの"],[51,1,"とも"],[58,1,"かみ"]],"text":"その時、御座から声が出て言った、「すべての神の僕たちよ、神をおそれる者たちよ。小さき者も大いなる者も、共に、われらの神をさんびせよ」。"},{"ref":"Rev.19.6","start":66019006,"end":66019006,"break":"none","breaks":[[47,"stanza"],[69,"line"]],"ruby":[[7,1,"だい"],[8,2,"ぐんしゅう"],[11,1,"こえ"],[13,1,"おお"],[16,1,"みず"],[18,1,"おと"],[22,1,"はげ"],[25,2,"らいめい"],[34,1,"き"],[43,1,"い"],[53,3,"ぜんのうしゃ"],[59,1,"しゅ"],[66,1,"かみ"],[69,1,"おう"],[72,3,"しはいしゃ"]],"text":"わたしはまた、大群衆の声、多くの水の音、また激しい雷鳴のようなものを聞いた。それはこう言った、「ハレルヤ、全能者にして主なるわれらの神は、王なる支配者であられる。"},{"ref":"Rev.19.7","start":66019007,"end":66019007,"break":"line","breaks":[[22,"line"],[33,"line"]],"ruby":[[6,1,"よろこ"],[8,1,"たの"],[12,1,"かみ"],[22,2,"こひつじ"],[25,2,"こんいん"],[28,1,"とき"],[33,2,"はなよめ"],[38,2,"ようい"]],"text":"わたしたちは喜び楽しみ、神をあがめまつろう。小羊の婚姻の時がきて、花嫁はその用意をしたからである。"},{"ref":"Rev.19.8","start":66019008,"end":66019008,"break":"line","breaks":[[9,"line"],[29,"line"]],"ruby":[[0,2,"かのじょ"],[4,1,"ひか"],[6,1,"かがや"],[9,1,"けが"],[14,2,"あさぬの"],[17,1,"ころも"],[19,1,"き"],[24,1,"ゆる"],[31,2,"あさぬの"],[34,1,"ころも"],[37,2,"せいと"],[42,1,"ただ"],[45,1,"おこな"]],"text":"彼女は、光り輝く、汚れのない麻布の衣を着ることを許された。この麻布の衣は、聖徒たちの正しい行いである」。"},{"ref":"Rev.19.9","start":66019009,"end":66019009,"break":"paragraph","ruby":[[5,2,"みつかい"],[12,1,"い"],[17,1,"か"],[23,2,"こひつじ"],[26,1,"こん"],[27,1,"えん"],[29,1,"まね"],[33,1,"もの"],[51,1,"い"],[61,1,"かみ"],[63,2,"しんじつ"],[66,2,"ことば"]],"text":"それから、御使はわたしに言った、「書きしるせ。小羊の婚宴に招かれた者は、さいわいである」。またわたしに言った、「これらは、神の真実の言葉である」。"},{"ref":"Rev.19.10","start":66019010,"end":66019010,"break":"none","ruby":[[8,1,"かれ"],[10,1,"あし"],[16,1,"ふ"],[20,1,"かれ"],[22,1,"はい"],[33,1,"かれ"],[35,1,"い"],[65,1,"おな"],[67,1,"しもべ"],[68,2,"なかま"],[92,2,"きょうだい"],[97,1,"おな"],[99,1,"しもべ"],[100,2,"なかま"],[108,1,"かみ"],[112,1,"はい"],[131,2,"よげん"],[134,1,"れい"]],"text":"そこで、わたしは彼の足もとにひれ伏して、彼を拝そうとした。すると、彼は言った、「そのようなことをしてはいけない。わたしは、あなたと同じ僕仲間であり、またイエスのあかしびとであるあなたの兄弟たちと同じ僕仲間である。ただ神だけを拝しなさい。イエスのあかしは、すなわち預言の霊である」。"},{"ref":"Rev.19.11","start":66019011,"end":66019011,"break":"paragraph","ruby":[[6,1,"み"],[12,1,"てん"],[14,1,"ひら"],[18,1,"み"],[24,1,"しろ"],[26,1,"うま"],[34,1,"の"],[44,2,"ちゅうじつ"],[47,2,"しんじつ"],[50,1,"もの"],[53,1,"よ"],[57,1,"ぎ"],[69,1,"たたか"]],"text":"またわたしが見ていると、天が開かれ、見よ、そこに白い馬がいた。それに乗っているかたは、「忠実で真実な者」と呼ばれ、義によってさばき、また、戦うかたである。"},{"ref":"Rev.19.12","start":66019012,"end":66019012,"break":"none","ruby":[[2,1,"め"],[4,1,"も"],[7,1,"ほのお"],[14,1,"あたま"],[17,1,"おお"],[20,1,"かんむり"],[29,1,"かれ"],[30,2,"いがい"],[37,1,"し"],[41,1,"な"],[45,1,"み"]],"text":"その目は燃える炎であり、その頭には多くの冠があった。また、彼以外にはだれも知らない名がその身にしるされていた。"},{"ref":"Rev.19.13","start":66019013,"end":66019013,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ちぞ"],[6,1,"ころも"],[14,1,"な"],[17,1,"かみ"],[19,1,"ことば"],[22,1,"よ"]],"text":"彼は血染めの衣をまとい、その名は「神の言」と呼ばれた。"},{"ref":"Rev.19.14","start":66019014,"end":66019014,"break":"none","ruby":[[4,1,"てん"],[6,2,"ぐんぜい"],[10,2,"じゅんぱく"],[14,1,"けが"],[19,2,"あさぬの"],[22,1,"ころも"],[24,1,"き"],[27,1,"しろ"],[29,1,"うま"],[31,1,"の"],[34,1,"かれ"],[36,1,"したが"]],"text":"そして、天の軍勢が、純白で、汚れのない麻布の衣を着て、白い馬に乗り、彼に従った。"},{"ref":"Rev.19.15","start":66019015,"end":66019015,"break":"none","ruby":[[2,1,"くち"],[7,1,"しょ"],[8,2,"こくみん"],[11,1,"う"],[17,1,"するど"],[23,1,"で"],[28,1,"かれ"],[31,1,"てつ"],[39,1,"しょ"],[40,2,"こくみん"],[43,2,"おさめ"],[49,3,"ぜんのうしゃ"],[54,1,"かみ"],[56,1,"はげ"],[59,1,"いか"],[62,1,"さか"],[66,1,"ふ"]],"text":"その口からは、諸国民を打つために、鋭いつるぎが出ていた。彼は、鉄のつえをもって諸国民を治め、また、全能者なる神の激しい怒りの酒ぶねを踏む。"},{"ref":"Rev.19.16","start":66019016,"end":66019016,"break":"none","ruby":[[2,2,"きもの"],[15,1,"おう"],[17,1,"おう"],[19,1,"しゅ"],[21,1,"しゅ"],[26,1,"な"]],"text":"その着物にも、そのももにも、「王の王、主の主」という名がしるされていた。"},{"ref":"Rev.19.17","start":66019017,"end":66019017,"break":"paragraph","ruby":[[2,1,"み"],[12,2,"みつかい"],[15,2,"たいよう"],[18,1,"なか"],[20,1,"た"],[26,1,"かれ"],[29,2,"なかぞら"],[32,1,"と"],[41,1,"とり"],[48,2,"おおごえ"],[51,1,"さけ"],[59,1,"かみ"],[61,1,"だい"],[62,2,"えんかい"],[65,1,"あつ"]],"text":"また見ていると、ひとりの御使が太陽の中に立っていた。彼は、中空を飛んでいるすべての鳥にむかって、大声で叫んだ、「さあ、神の大宴会に集まってこい。"},{"ref":"Rev.19.18","start":66019018,"end":66019018,"break":"none","ruby":[[4,1,"おう"],[8,1,"にく"],[10,2,"しょうぐん"],[13,1,"にく"],[15,2,"ゆうしゃ"],[18,1,"にく"],[20,1,"うま"],[22,1,"にく"],[24,1,"うま"],[26,1,"の"],[31,1,"もの"],[33,1,"にく"],[42,3,"じゆうじん"],[46,2,"どれい"],[50,1,"にく"],[52,1,"ちい"],[55,1,"もの"],[57,1,"おお"],[61,1,"もの"],[64,1,"にく"]],"text":"そして、王たちの肉、将軍の肉、勇者の肉、馬の肉、馬に乗っている者の肉、また、すべての自由人と奴隷との肉、小さき者と大いなる者との肉をくらえ」。"},{"ref":"Rev.19.19","start":66019019,"end":66019019,"break":"paragraph","ruby":[[2,1,"み"],[8,1,"けもの"],[10,1,"ち"],[12,1,"おう"],[16,1,"かれ"],[19,2,"ぐんぜい"],[23,1,"あつ"],[27,1,"うま"],[29,1,"の"],[39,2,"ぐんぜい"],[43,1,"たい"],[47,1,"たたか"]],"text":"なお見ていると、獣と地の王たちと彼らの軍勢とが集まり、馬に乗っているかたとその軍勢とに対して、戦いをいどんだ。"},{"ref":"Rev.19.20","start":66019020,"end":66019020,"break":"none","ruby":[[4,1,"けもの"],[6,1,"とら"],[16,1,"けもの"],[18,1,"まえ"],[24,1,"おこな"],[28,1,"けもの"],[30,2,"こくいん"],[33,1,"う"],[36,1,"もの"],[40,1,"ぞう"],[42,1,"おが"],[44,1,"もの"],[47,1,"まど"],[53,3,"よげんしゃ"],[58,1,"けもの"],[60,1,"とも"],[62,1,"とら"],[74,2,"りょうしゃ"],[79,1,"い"],[85,2,"いおう"],[88,1,"も"],[93,1,"ひ"],[95,1,"いけ"],[97,1,"な"],[99,1,"こ"]],"text":"しかし、獣は捕えられ、また、この獣の前でしるしを行って、獣の刻印を受けた者とその像を拝む者とを惑わしたにせ預言者も、獣と共に捕えられた。そして、この両者とも、生きながら、硫黄の燃えている火の池に投げ込まれた。"},{"ref":"Rev.19.21","start":66019021,"end":66019021,"break":"none","ruby":[[2,2,"いがい"],[5,1,"もの"],[10,1,"うま"],[12,1,"の"],[22,1,"くち"],[25,1,"で"],[31,1,"き"],[33,1,"ころ"],[39,1,"にく"],[46,1,"とり"],[48,1,"あ"],[53,1,"た"]],"text":"それ以外の者たちは、馬に乗っておられるかたの口から出るつるぎで切り殺され、その肉を、すべての鳥が飽きるまで食べた。"}]