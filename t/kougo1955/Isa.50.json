[{"ref":"Isa.50.1","start":23050001,"end":23050001,"break":"paragraph","breaks":[[9,"line"],[33,"line"],[40,"line"],[63,"line"],[85,"line"],[94,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[20,1,"はは"],[22,1,"さ"],[28,2,"りえん"],[30,1,"じょう"],[46,1,"さい"],[47,1,"しゅ"],[55,1,"う"],[63,1,"み"],[75,2,"ふぎ"],[81,1,"う"],[91,1,"はは"],[106,1,"だ"]],"text":"主はこう言われる、「わたしがあなたがたの母を去らせたその離縁状は、どこにあるか。わたしはどの債主にあなたがたを売りわたしたか。見よ、あなたがたは、その不義のために売られ、あなたがたの母は、あなたがたのとがのために出されたのだ。"},{"ref":"Isa.50.2","start":23050002,"end":23050002,"break":"line","breaks":[[9,"line"],[22,"line"],[32,"line"],[49,"line"],[59,"line"],[73,"line"],[88,"line"],[105,"line"],[113,"line"],[127,"line"]],"ruby":[[4,1,"き"],[26,1,"よ"],[38,1,"こた"],[41,1,"もの"],[53,1,"て"],[55,1,"みじか"],[77,1,"すく"],[79,1,"ちから"],[81,1,"も"],[88,1,"み"],[100,1,"うみ"],[105,1,"かわ"],[107,2,"あらの"],[115,1,"なか"],[117,1,"うお"],[119,1,"みず"],[130,1,"し"],[133,2,"あくしゅう"],[136,1,"はな"]],"text":"わたしが来たとき、なぜひとりもいなかったか。わたしが呼んだとき、なぜひとりも答える者がなかったか。わたしの手が短くて、あがなうことができないのか。わたしは救う力を持たないのか。見よ、わたしが、しかると海はかれ、川は荒野となり、その中の魚は水がないために、かわき死んで悪臭を放つ。"},{"ref":"Isa.50.3","start":23050003,"end":23050003,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"くろ"],[6,1,"ころも"],[8,1,"てん"],[10,1,"き"],[13,2,"あらぬの"]],"text":"わたしは黒い衣を天に着せ、荒布をもってそのおおいとする」。"},{"ref":"Isa.50.4","start":23050004,"end":23050004,"break":"paragraph","breaks":[[22,"line"],[43,"line"],[64,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"おしえ"],[10,1,"もの"],[12,1,"した"],[18,1,"あた"],[22,1,"つか"],[25,1,"もの"],[27,2,"ことば"],[33,1,"たす"],[39,1,"し"],[45,1,"あさ"],[57,1,"みみ"],[64,1,"おしえ"],[69,1,"もの"],[74,1,"き"]],"text":"主なる神は教をうけた者の舌をわたしに与えて、疲れた者を言葉をもって助けることを知らせ、また朝ごとにさまし、わたしの耳をさまして、教をうけた者のように聞かせられる。"},{"ref":"Isa.50.5","start":23050005,"end":23050005,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[9,1,"みみ"],[11,1,"ひら"],[30,1,"しりぞ"]],"text":"主なる神はわたしの耳を開かれた。わたしは、そむくことをせず、退くことをしなかった。"},{"ref":"Isa.50.6","start":23050006,"end":23050006,"break":"line","breaks":[[19,"line"],[42,"line"],[56,"line"]],"ruby":[[4,1,"う"],[6,1,"もの"],[13,1,"せ"],[26,1,"ぬ"],[28,1,"もの"],[42,1,"はじ"],[49,1,"さ"],[56,1,"かお"]],"text":"わたしを打つ者に、わたしの背をまかせ、わたしのひげを抜く者に、わたしのほおをまかせ、恥とつばきとを避けるために、顔をかくさなかった。"},{"ref":"Isa.50.7","start":23050007,"end":23050007,"break":"line","breaks":[[18,"line"],[38,"line"],[59,"line"]],"ruby":[[3,1,"しゅ"],[6,1,"かみ"],[12,1,"たす"],[27,1,"は"],[47,1,"かお"],[49,3,"ひうちいし"],[63,1,"けっ"],[78,1,"し"]],"text":"しかし主なる神はわたしを助けられる。それゆえ、わたしは恥じることがなかった。それゆえ、わたしは顔を火打石のようにした。わたしは決してはずかしめられないことを知る。"},{"ref":"Isa.50.8","start":23050008,"end":23050008,"break":"line","breaks":[[17,"line"],[31,"line"],[42,"line"],[53,"line"]],"ruby":[[4,1,"ぎ"],[8,1,"もの"],[10,1,"ちか"],[24,1,"あらそ"],[36,1,"とも"],[38,1,"た"],[57,1,"ところ"],[59,1,"ちか"]],"text":"わたしを義とする者が近くおられる。だれがわたしと争うだろうか、われわれは共に立とう。わたしのあだはだれか、わたしの所へ近くこさせよ。"},{"ref":"Isa.50.9","start":23050009,"end":23050009,"break":"line","breaks":[[18,"line"],[35,"line"],[51,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[6,1,"かみ"],[12,1,"たす"],[25,1,"つみ"],[27,1,"さだ"],[35,1,"み"],[38,1,"かれ"],[41,1,"みな"],[42,1,"ころも"],[57,1,"く"]],"text":"見よ、主なる神はわたしを助けられる。だれがわたしを罪に定めるだろうか。見よ、彼らは皆衣のようにふるび、しみのために食いつくされる。"},{"ref":"Isa.50.10","start":23050010,"end":23050010,"break":"paragraph","breaks":[[13,"line"],[26,"line"],[50,"line"]],"ruby":[[8,1,"しゅ"],[10,1,"おそ"],[19,1,"こえ"],[21,1,"き"],[23,1,"したが"],[26,1,"くら"],[28,1,"なか"],[30,1,"ある"],[33,1,"ひかり"],[35,1,"え"],[43,1,"しゅ"],[45,1,"な"],[47,1,"たの"],[54,1,"かみ"],[59,1,"もの"]],"text":"あなたがたのうち主を恐れ、そのしもべの声に聞き従い、暗い中を歩いて光を得なくても、なお主の名を頼み、おのれの神にたよる者はだれか。"},{"ref":"Isa.50.11","start":23050011,"end":23050011,"break":"line","breaks":[[20,"line"],[32,"line"],[51,"line"],[72,"line"]],"ruby":[[0,1,"み"],[3,1,"ひ"],[5,1,"も"],[17,1,"もの"],[20,1,"みな"],[23,1,"ひ"],[25,1,"ほのお"],[27,1,"なか"],[29,1,"あゆ"],[36,1,"も"],[46,1,"なか"],[48,1,"あゆ"],[65,1,"て"],[68,1,"う"],[72,1,"くる"],[79,1,"ふ"],[81,1,"たお"]],"text":"見よ、火を燃やし、たいまつをともす者よ、皆その火の炎の中を歩め、またその燃やした、たいまつの中を歩め。あなたがたは、これをわたしの手から受けて、苦しみのうちに伏し倒れる。"}]