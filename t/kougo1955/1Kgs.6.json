[{"ref":"1Kgs.6.1","start":11006001,"end":11006001,"break":"paragraph","ruby":[[6,2,"ひとびと"],[14,1,"ち"],[16,1,"で"],[18,1,"のち"],[23,1,"ねん"],[36,1,"おう"],[41,1,"だい"],[43,1,"ねん"],[48,1,"つき"],[54,1,"がつ"],[62,1,"しゅ"],[67,1,"みや"],[69,1,"た"],[75,1,"はじ"]],"text":"イスラエルの人々がエジプトの地を出て後四百八十年、ソロモンがイスラエルの王となって第四年のジフの月すなわち二月に、ソロモンは主のために宮を建てることを始めた。"},{"ref":"1Kgs.6.2","start":11006002,"end":11006002,"break":"none","ruby":[[4,1,"おう"],[6,1,"しゅ"],[11,1,"た"],[14,1,"みや"],[16,1,"なが"],[25,1,"はば"],[33,1,"たか"]],"text":"ソロモン王が主のために建てた宮は長さ六十キュビト、幅二十キュビト、高さ三十キュビトであった。"},{"ref":"1Kgs.6.3","start":11006003,"end":11006003,"break":"none","ruby":[[0,1,"みや"],[2,2,"はいでん"],[5,1,"まえ"],[7,1,"ろう"],[9,1,"みや"],[11,1,"はば"],[18,1,"なが"],[29,1,"はば"],[31,1,"みや"],[33,1,"まえ"]],"text":"宮の拝殿の前の廊は宮の幅にしたがって長さ二十キュビト、その幅は宮の前で十キュビトであった。"},{"ref":"1Kgs.6.4","start":11006004,"end":11006004,"break":"none","ruby":[[0,1,"かれ"],[2,1,"みや"],[5,2,"うちがわ"],[8,1,"ひろ"],[10,1,"わく"],[12,1,"まど"],[14,1,"つく"]],"text":"彼は宮に、内側の広い枠の窓を造った。"},{"ref":"1Kgs.6.5","start":11006005,"end":11006005,"break":"none","ruby":[[2,1,"みや"],[4,1,"かべ"],[9,2,"しゅうい"],[12,2,"わきや"],[15,1,"もう"],[18,1,"みや"],[20,1,"かべ"],[25,2,"はいでん"],[28,2,"ほんでん"],[31,1,"かべ"],[33,2,"しゅうい"],[36,1,"た"],[43,1,"みや"],[45,2,"しゅうい"],[48,2,"わきま"]],"text":"また宮の壁につけて周囲に脇屋を設け、宮の壁すなわち拝殿と本殿の壁の周囲に建てめぐらし、宮の周囲に脇間があるようにした。"},{"ref":"1Kgs.6.6","start":11006006,"end":11006006,"break":"none","ruby":[[0,1,"した"],[2,2,"わきま"],[5,1,"ひろ"],[13,1,"なか"],[15,1,"ひろ"],[23,1,"だい"],[27,1,"ひろ"],[39,1,"みや"],[41,2,"そとがわ"],[45,1,"かべ"],[47,1,"だん"],[49,1,"つく"],[53,1,"はり"],[55,1,"みや"],[57,1,"かべ"],[59,1,"なか"],[61,1,"さ"],[63,1,"こ"]],"text":"下の脇間は広さ五キュビト、中の広さ六キュビト、第三のは広さ七キュビトであった。宮の外側には壁に段を造って、梁を宮の壁の中に差し込まないようにした。"},{"ref":"1Kgs.6.7","start":11006007,"end":11006007,"break":"paragraph","ruby":[[0,1,"みや"],[2,1,"た"],[5,1,"とき"],[8,1,"いし"],[9,1,"き"],[11,1,"ば"],[13,1,"き"],[15,1,"ととの"],[18,1,"いし"],[23,1,"つく"],[29,1,"た"],[34,1,"あいだ"],[36,1,"みや"],[53,1,"た"],[55,2,"てっき"],[60,1,"おと"],[62,1,"きこ"]],"text":"宮は建てる時に、石切り場で切り整えた石をもって造ったので、建てている間は宮のうちには、つちも、おのも、その他の鉄器もその音が聞えなかった。"},{"ref":"1Kgs.6.8","start":11006008,"end":11006008,"break":"paragraph","ruby":[[0,1,"した"],[2,2,"わきま"],[5,2,"いりぐち"],[8,1,"みや"],[10,2,"みぎがわ"],[16,1,"まわ"],[18,2,"かいだん"],[24,1,"なか"],[26,2,"わきま"],[30,1,"なか"],[32,2,"わきま"],[36,1,"だい"],[39,2,"わきま"]],"text":"下の脇間の入口は宮の右側にあり、回り階段によって中の脇間に、中の脇間から第三の脇間にのぼった。"},{"ref":"1Kgs.6.9","start":11006009,"end":11006009,"break":"none","ruby":[[4,1,"かれ"],[6,1,"みや"],[8,1,"た"],[10,1,"おわ"],[13,2,"こうはく"],[20,1,"いた"],[25,1,"みや"],[27,2,"てんじょう"],[30,1,"つく"]],"text":"こうして彼は宮を建て終り、香柏のたるきと板をもって宮の天井を造った。"},{"ref":"1Kgs.6.10","start":11006010,"end":11006010,"break":"none","ruby":[[2,1,"みや"],[12,1,"たか"],[20,2,"わきま"],[25,2,"わきや"],[28,1,"た"],[35,2,"こうはく"],[38,2,"ざいもく"],[44,1,"みや"],[46,2,"せつぞく"]],"text":"また宮につけて、おのおの高さ五キュビトの脇間のある脇屋を建てめぐらし、香柏の材木をもって宮に接続させた。"},{"ref":"1Kgs.6.11","start":11006011,"end":11006011,"break":"paragraph","ruby":[[3,1,"しゅ"],[5,2,"ことば"],[13,1,"のぞ"]],"text":"そこで主の言葉がソロモンに臨んだ、"},{"ref":"1Kgs.6.12","start":11006012,"end":11006012,"break":"none","ruby":[[5,1,"た"],[10,1,"みや"],[27,1,"さだ"],[30,1,"あゆ"],[37,1,"おこな"],[44,1,"いまし"],[47,1,"まも"],[53,1,"したが"],[56,1,"あゆ"],[70,1,"ちち"],[75,2,"やくそく"],[82,2,"じょうじゅ"]],"text":"「あなたが建てるこの宮については、もしあなたがわたしの定めに歩み、おきてを行い、すべての戒めを守り、それに従って歩むならば、わたしはあなたの父ダビデに約束したことを成就する。"},{"ref":"1Kgs.6.13","start":11006013,"end":11006013,"break":"none","ruby":[[13,2,"ひとびと"],[19,1,"す"],[26,1,"たみ"],[33,1,"す"]],"text":"そしてわたしはイスラエルの人々のうちに住み、わたしの民イスラエルを捨てることはない」。"},{"ref":"1Kgs.6.14","start":11006014,"end":11006014,"break":"paragraph","ruby":[[9,1,"みや"],[11,1,"た"],[13,1,"おわ"]],"text":"こうしてソロモンは宮を建て終った。"},{"ref":"1Kgs.6.15","start":11006015,"end":11006015,"break":"none","ruby":[[0,1,"かれ"],[2,2,"こうはく"],[5,1,"いた"],[10,1,"みや"],[12,1,"かべ"],[14,2,"うちがわ"],[17,1,"は"],[25,1,"みや"],[27,1,"ゆか"],[30,2,"てんじょう"],[38,2,"こうはく"],[41,1,"いた"],[43,1,"は"],[55,1,"いた"],[60,1,"みや"],[62,1,"ゆか"],[64,1,"は"]],"text":"彼は香柏の板をもって宮の壁の内側を張った。すなわち宮の床から天井のたるきまで香柏の板で張った。また、いとすぎの板をもって宮の床を張った。"},{"ref":"1Kgs.6.16","start":11006016,"end":11006016,"break":"none","ruby":[[2,1,"みや"],[4,1,"おく"],[13,1,"しつ"],[15,1,"ゆか"],[18,2,"てんじょう"],[26,2,"こうはく"],[29,1,"いた"],[34,1,"つく"],[42,1,"みや"],[44,1,"うち"],[46,3,"しせいじょ"],[53,2,"ほんどう"],[56,1,"つく"]],"text":"また宮の奥に二十キュビトの室を床から天井のたるきまで香柏の板をもって造った。すなわち宮の内に至聖所としての本堂を造った。"},{"ref":"1Kgs.6.17","start":11006017,"end":11006017,"break":"none","ruby":[[0,1,"みや"],[5,2,"ほんでん"],[8,1,"まえ"],[12,2,"はいでん"],[15,1,"なが"]],"text":"宮すなわち本殿の前にある拝殿は長さ四十キュビトであった。"},{"ref":"1Kgs.6.18","start":11006018,"end":11006018,"break":"none","ruby":[[0,1,"みや"],[2,1,"うち"],[3,1,"がわ"],[5,2,"こうはく"],[8,1,"いた"],[15,1,"かたち"],[18,1,"さ"],[21,1,"はな"],[23,2,"うきぼり"],[35,2,"こうはく"],[38,1,"いた"],[41,1,"いし"],[43,1,"み"]],"text":"宮の内側の香柏の板は、ひさごの形と、咲いた花を浮彫りにしたもので、みな香柏の板で、石は見えなかった。"},{"ref":"1Kgs.6.19","start":11006019,"end":11006019,"break":"none","ruby":[[3,1,"しゅ"],[5,2,"けいやく"],[8,1,"はこ"],[10,1,"お"],[16,1,"みや"],[18,1,"うち"],[20,1,"おく"],[22,2,"ほんでん"],[25,1,"もう"]],"text":"そして主の契約の箱を置くために、宮の内の奥に本殿を設けた。"},{"ref":"1Kgs.6.20","start":11006020,"end":11006020,"break":"none","ruby":[[0,2,"ほんでん"],[3,1,"なが"],[12,1,"はば"],[20,1,"たか"],[33,2,"じゅんきん"],[46,2,"こうはく"],[49,2,"さいだん"],[52,1,"つく"]],"text":"本殿は長さ二十キュビト、幅二十キュビト、高さ二十キュビトであって、純金でこれをおおった。また香柏の祭壇を造った。"},{"ref":"1Kgs.6.21","start":11006021,"end":11006021,"break":"none","ruby":[[5,2,"じゅんきん"],[11,1,"みや"],[13,1,"うち"],[14,1,"がわ"],[20,2,"ほんでん"],[23,1,"まえ"],[25,1,"きん"],[27,1,"くさり"],[32,1,"へだ"],[35,1,"つく"],[38,1,"きん"]],"text":"ソロモンは純金をもって宮の内側をおおい、本殿の前に金の鎖をもって隔てを造り、金をもってこれをおおった。"},{"ref":"1Kgs.6.22","start":11006022,"end":11006022,"break":"none","ruby":[[2,1,"きん"],[7,1,"のこ"],[10,1,"みや"],[19,1,"みや"],[21,1,"かざ"],[31,1,"お"],[37,2,"ほんでん"],[40,1,"ぞく"],[43,2,"さいだん"],[51,1,"きん"]],"text":"また金をもって残らず宮をおおい、ついに宮を飾ることをことごとく終えた。また本殿に属する祭壇をことごとく金でおおった。"},{"ref":"1Kgs.6.23","start":11006023,"end":11006023,"break":"paragraph","ruby":[[0,2,"ほんでん"],[10,1,"き"],[23,1,"つく"],[29,1,"たか"]],"text":"本殿のうちにオリブの木をもって二つのケルビムを造った。その高さはおのおの十キュビト。"},{"ref":"1Kgs.6.24","start":11006024,"end":11006024,"break":"none","ruby":[[9,1,"つばさ"],[11,1,"なが"],[28,1,"た"],[30,1,"つばさ"],[32,1,"なが"],[48,1,"つばさ"],[50,1,"はし"],[53,1,"た"],[55,1,"つばさ"],[57,1,"はし"]],"text":"そのケルブの一つの翼の長さは五キュビト、またそのケルブの他の翼の長さも五キュビトであった。一つの翼の端から他の翼の端までは十キュビトあった。"},{"ref":"1Kgs.6.25","start":11006025,"end":11006025,"break":"none","ruby":[[0,1,"た"],[24,1,"おな"],[26,2,"すんぽう"],[29,1,"おな"],[31,1,"かたち"]],"text":"他のケルブも十キュビトであって、二つのケルビムは同じ寸法、同じ形であった。"},{"ref":"1Kgs.6.26","start":11006026,"end":11006026,"break":"none","ruby":[[6,1,"たか"],[21,1,"たか"],[24,1,"おな"]],"text":"このケルブの高さは十キュビト、かのケルブの高さも同じであった。"},{"ref":"1Kgs.6.27","start":11006027,"end":11006027,"break":"none","ruby":[[5,1,"みや"],[10,1,"おく"],[26,1,"つばさ"],[28,1,"の"],[42,1,"つばさ"],[46,1,"かべ"],[48,1,"たっ"],[57,1,"つばさ"],[61,1,"かべ"],[63,1,"たっ"],[66,1,"た"],[71,1,"つばさ"],[73,1,"みや"],[75,1,"なか"],[77,1,"たがい"],[79,1,"ふ"],[81,1,"あ"]],"text":"ソロモンは宮のうちの奥にケルビムをすえた。ケルビムの翼を伸ばしたところ、このケルブの翼はこの壁に達し、かのケルブの翼はかの壁に達し、他の二つの翼は宮の中で互に触れ合った。"},{"ref":"1Kgs.6.28","start":11006028,"end":11006028,"break":"none","ruby":[[0,1,"かれ"],[2,1,"きん"]],"text":"彼は金をもってそのケルビムをおおった。"},{"ref":"1Kgs.6.29","start":11006029,"end":11006029,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"みや"],[4,2,"しゅうい"],[7,1,"かべ"],[10,2,"ないがい"],[13,1,"しつ"],[16,1,"みな"],[27,1,"き"],[30,1,"さ"],[33,1,"はな"],[35,1,"かたち"],[37,1,"ほ"],[39,1,"もの"],[41,1,"きざ"]],"text":"彼は宮の周囲の壁に、内外の室とも皆ケルビムと、しゅろの木と、咲いた花の形の彫り物を刻み、"},{"ref":"1Kgs.6.30","start":11006030,"end":11006030,"break":"none","ruby":[[0,1,"みや"],[2,1,"ゆか"],[5,2,"ないがい"],[8,1,"しつ"],[11,1,"きん"]],"text":"宮の床は、内外の室とも金でおおった。"},{"ref":"1Kgs.6.31","start":11006031,"end":11006031,"break":"paragraph","ruby":[[0,2,"ほんでん"],[3,2,"いりぐち"],[11,1,"き"],[17,1,"つく"],[27,1,"うえ"],[33,1,"わき"],[34,1,"ばしら"],[38,1,"へん"],[39,1,"けい"]],"text":"本殿の入口にはオリブの木のとびらを造った。そのとびらの上のかまちと脇柱とで五辺形をなしていた。"},{"ref":"1Kgs.6.32","start":11006032,"end":11006032,"break":"none","ruby":[[13,1,"き"],[26,1,"うえ"],[38,1,"き"],[41,1,"さ"],[44,1,"はな"],[46,1,"かたち"],[48,1,"きざ"],[51,1,"きん"],[75,1,"き"],[77,1,"うえ"],[79,1,"きん"],[81,1,"き"]],"text":"その二つのとびらもオリブの木であって、ソロモンはその上にケルビムと、しゅろの木と、咲いた花の形を刻み、金をもっておおった。すなわちケルビムと、しゅろの木の上に金を着せた。"},{"ref":"1Kgs.6.33","start":11006033,"end":11006033,"break":"paragraph","ruby":[[11,2,"はいでん"],[14,2,"いりぐち"],[24,1,"き"],[26,2,"しかく"],[29,1,"かたち"],[31,1,"わき"],[32,1,"ばしら"],[34,1,"つく"]],"text":"こうしてソロモンはまた拝殿の入口のためにオリブの木で四角の形に脇柱を造った。"},{"ref":"1Kgs.6.34","start":11006034,"end":11006034,"break":"none","ruby":[[31,1,"お"],[33,1,"と"],[38,1,"た"],[50,1,"お"],[52,1,"と"]],"text":"その二つのとびらはいとすぎであって、一つのとびらは二つにたたむ折り戸であり、他のとびらも二つにたたむ折り戸であった。"},{"ref":"1Kgs.6.35","start":11006035,"end":11006035,"break":"none","ruby":[[7,1,"うえ"],[19,1,"き"],[22,1,"さ"],[25,1,"はな"],[27,1,"きざ"],[30,1,"きん"],[35,1,"ほ"],[37,1,"もの"],[39,1,"うえ"],[41,1,"かたち"]],"text":"ソロモンはその上にケルビムと、しゅろの木と、咲いた花を刻み、金をもって彫り物の上を形どおりにおおった。"},{"ref":"1Kgs.6.36","start":11006036,"end":11006036,"break":"none","ruby":[[2,1,"き"],[4,1,"いし"],[11,2,"こうはく"],[14,2,"かくざい"],[26,2,"うちにわ"],[29,1,"つく"]],"text":"また切り石三かさねと、香柏の角材ひとかさねとをもって内庭を造った。"},{"ref":"1Kgs.6.37","start":11006037,"end":11006037,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"ねん"],[7,1,"つき"],[9,1,"しゅ"],[11,1,"みや"],[13,1,"もとい"]],"text":"第四年のジフの月に主の宮の基をすえ、"},{"ref":"1Kgs.6.38","start":11006038,"end":11006038,"break":"none","ruby":[[0,1,"だい"],[3,1,"ねん"],[8,1,"つき"],[14,1,"がつ"],[17,1,"みや"],[23,2,"ぶぶん"],[26,2,"せっけい"],[32,2,"かんせい"],[45,1,"た"],[51,1,"ねん"],[53,1,"よう"]],"text":"第十一年のブルの月すなわち八月に、宮のすべての部分が設計どおりに完成した。ソロモンはこれを建てるのに七年を要した。"}]