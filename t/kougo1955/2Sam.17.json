[{"ref":"2Sam.17.1","start":10017001,"end":10017001,"break":"paragraph","ruby":[[0,1,"とき"],[14,1,"い"],[28,1,"ひと"],[30,1,"えら"],[32,1,"だ"],[45,1,"た"],[49,2,"こんや"],[58,1,"お"]],"text":"時にアヒトペルはアブサロムに言った、「わたしに一万二千の人を選び出させてください。わたしは立って、今夜ダビデのあとを追い、"},{"ref":"2Sam.17.2","start":10017002,"end":10017002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"つか"],[5,1,"て"],[7,1,"よわ"],[18,1,"おそ"],[22,1,"かれ"],[37,1,"かれ"],[39,1,"とも"],[43,1,"たみ"],[47,1,"に"],[57,1,"おう"],[62,1,"う"],[64,1,"と"]],"text":"彼が疲れて手が弱くなっているところを襲って、彼をあわてさせましょう。そして彼と共にいる民がみな逃げるとき、わたしは王ひとりを撃ち取り、"},{"ref":"2Sam.17.3","start":10017003,"end":10017003,"break":"none","ruby":[[4,1,"たみ"],[6,2,"はなよめ"],[11,1,"おっと"],[16,1,"かえ"],[25,1,"かえ"],[37,1,"もと"],[52,1,"いのち"],[60,1,"たみ"],[64,1,"おだ"]],"text":"すべての民を花嫁がその夫のもとに帰るようにあなたに帰らせましょう。あなたが求めておられるのはただひとりの命だけですから、民はみな穏やかになるでしょう」。"},{"ref":"2Sam.17.4","start":10017004,"end":10017004,"break":"none","ruby":[[2,2,"ことば"],[21,2,"ちょうろう"],[24,1,"こころ"]],"text":"この言葉はアブサロムとイスラエルのすべての長老の心にかなった。"},{"ref":"2Sam.17.5","start":10017005,"end":10017005,"break":"paragraph","ruby":[[9,1,"い"],[25,1,"よ"],[38,1,"かれ"],[40,1,"い"],[45,1,"き"]],"text":"そこでアブサロムは言った、「アルキびとホシャイをも呼びよせなさい。われわれは彼の言うことを聞きましょう」。"},{"ref":"2Sam.17.6","start":10017006,"end":10017006,"break":"none","ruby":[[16,1,"とき"],[24,1,"かれ"],[26,1,"い"],[42,1,"い"],[51,1,"かれ"],[53,2,"ことば"],[59,1,"おこな"],[75,1,"い"]],"text":"ホシャイがアブサロムのもとにきた時、アブサロムは彼に言った、「アヒトペルはこのように言った。われわれは彼の言葉のように行うべきか。いけないのであれば、言いなさい」。"},{"ref":"2Sam.17.7","start":10017007,"end":10017007,"break":"none","ruby":[[11,1,"い"],[26,1,"さづ"],[29,1,"はか"],[34,1,"よ"]],"text":"ホシャイはアブサロムに言った、「このたびアヒトペルが授けた計りごとは良くありません」。"},{"ref":"2Sam.17.8","start":10017008,"end":10017008,"break":"none","ruby":[[7,1,"い"],[25,1,"ちち"],[29,2,"じゅうしゃ"],[35,2,"ゆうし"],[42,1,"うえ"],[43,1,"かれ"],[47,1,"の"],[49,1,"こ"],[51,1,"うば"],[55,1,"くま"],[64,1,"いか"],[78,1,"ちち"],[90,1,"たみ"],[92,1,"とも"],[94,1,"やど"]],"text":"ホシャイはまた言った、「ごぞんじのように、あなたの父とその従者たちとは勇士です。その上彼らは、野で子を奪われた熊のように、ひどく怒っています。また、あなたの父はいくさびとですから、民と共に宿らないでしょう。"},{"ref":"2Sam.17.9","start":10017009,"end":10017009,"break":"none","ruby":[[0,1,"かれ"],[2,1,"いま"],[5,1,"あな"],[7,1,"なか"],[16,1,"ところ"],[28,1,"たみ"],[33,1,"いく"],[34,1,"ひと"],[37,2,"てはじ"],[41,1,"たお"],[51,1,"き"],[53,1,"もの"],[67,1,"したが"],[69,1,"たみ"],[74,3,"せんししゃ"],[83,1,"い"]],"text":"彼は今でも穴の中か、どこかほかの所にかくれています。もし民のうちの幾人かが手始めに倒れるならば、それを聞く者はだれでも、『アブサロムに従う民のうちに戦死者があった』と言うでしょう。"},{"ref":"2Sam.17.10","start":10017010,"end":10017010,"break":"none","ruby":[[9,1,"こころ"],[14,1,"こころ"],[18,1,"いさ"],[22,1,"ひと"],[29,1,"おそ"],[32,1,"き"],[34,1,"さ"],[58,1,"ひと"],[65,1,"ちち"],[67,2,"ゆうし"],[77,1,"かれ"],[79,1,"とも"],[83,1,"もの"],[86,1,"いさ"],[90,2,"ひとびと"],[98,1,"し"]],"text":"そうすれば、ししの心のような心のある勇ましい人であっても、恐れて消え去ってしまうでしょう。それはイスラエルのすべての人が、あなたの父の勇士であること、また彼と共にいる者が、勇ましい人々であることを知っているからです。"},{"ref":"2Sam.17.11","start":10017011,"end":10017011,"break":"none","ruby":[[8,1,"はか"],[32,1,"うみ"],[35,1,"すな"],[40,1,"おお"],[49,1,"あつ"],[60,1,"たたか"],[63,1,"のぞ"]],"text":"ところでわたしの計りごとは、イスラエルをダンからベエルシバまで、海べの砂のように多くあなたのもとに集めて、あなたみずから戦いに臨むことです。"},{"ref":"2Sam.17.12","start":10017012,"end":10017012,"break":"none","ruby":[[9,1,"かれ"],[11,1,"み"],[15,2,"ばしょ"],[18,1,"かれ"],[20,1,"おそ"],[26,1,"ち"],[34,1,"かれ"],[36,1,"うえ"],[38,1,"くだ"],[44,1,"かれ"],[48,1,"かれ"],[50,1,"とも"],[58,1,"ひと"],[64,1,"のこ"]],"text":"こうしてわれわれは彼の見つかる場所で彼を襲い、つゆが地におりるように彼の上に下る。そして彼および彼と共にいるすべての人をひとりも残さないでしょう。"},{"ref":"2Sam.17.13","start":10017013,"end":10017013,"break":"none","ruby":[[2,1,"かれ"],[9,1,"まち"],[11,1,"しりぞ"],[17,1,"ぜん"],[26,1,"まち"],[42,1,"たに"],[44,1,"ひ"],[46,1,"たお"],[56,2,"こいし"],[59,1,"み"]],"text":"もし彼がいずれかの町に退くならば、全イスラエルはその町になわをかけ、われわれはそれを谷に引き倒して、そこに一つの小石も見られないようにするでしょう」。"},{"ref":"2Sam.17.14","start":10017014,"end":10017014,"break":"none","ruby":[[12,2,"ひとびと"],[29,1,"はか"],[41,1,"はか"],[52,1,"い"],[59,1,"しゅ"],[67,1,"わざわい"],[69,1,"くだ"],[82,1,"よ"],[84,1,"はか"],[89,1,"やぶ"],[94,1,"さだ"]],"text":"アブサロムとイスラエルの人々はみな、「アルキびとホシャイの計りごとは、アヒトペルの計りごとよりもよい」と言った。それは主がアブサロムに災を下そうとして、アヒトペルの良い計りごとを破ることを定められたからである。"},{"ref":"2Sam.17.15","start":10017015,"end":10017015,"break":"paragraph","ruby":[[8,2,"さいし"],[24,1,"い"],[47,2,"ちょうろう"],[59,1,"はか"],[77,1,"はか"]],"text":"そこでホシャイは祭司たち、ザドクとアビヤタルとに言った、「アヒトペルはアブサロムとイスラエルの長老たちのためにこういう計りごとをした。またわたしはこういう計りごとをした。"},{"ref":"2Sam.17.16","start":10017016,"end":10017016,"break":"none","ruby":[[16,1,"ひと"],[27,1,"つ"],[31,2,"こんや"],[34,2,"あらの"],[37,1,"わた"],[39,1,"ば"],[41,1,"やど"],[47,1,"かなら"],[49,1,"わた"],[52,1,"い"],[63,1,"おう"],[67,1,"とも"],[71,1,"たみ"],[76,1,"ほろ"],[87,1,"い"]],"text":"それゆえ、あなたがたはすみやかに人をつかわしてダビデに告げ、『今夜、荒野の渡し場に宿らないで、必ず渡って行きなさい。さもないと王および共にいる民はみな、滅ぼされるでしょう』と言いなさい」。"},{"ref":"2Sam.17.17","start":10017017,"end":10017017,"break":"none","ruby":[[0,1,"とき"],[20,1,"ま"],[35,1,"い"],[38,1,"かれ"],[41,1,"つ"],[44,1,"かれ"],[47,1,"い"],[53,1,"おう"],[55,1,"つ"],[60,1,"つね"],[69,1,"かれ"],[72,1,"まち"],[79,1,"み"]],"text":"時に、ヨナタンとアヒマアズはエンロゲルで待っていた。ひとりのつかえめが行って彼らに告げ、彼らは行ってダビデ王に告げるのが常であった。それは彼らが町にはいるのを見られないようにするためである。"},{"ref":"2Sam.17.18","start":10017018,"end":10017018,"break":"none","ruby":[[8,2,"わかもの"],[11,1,"かれ"],[14,1,"み"],[22,1,"つ"],[28,1,"かれ"],[34,1,"いそ"],[37,1,"さ"],[52,1,"ひと"],[54,1,"いえ"],[61,1,"ひと"],[63,1,"にわ"],[65,2,"いど"],[72,1,"かれ"],[77,1,"なか"],[79,1,"くだ"]],"text":"ところがひとりの若者が彼らを見てアブサロムに告げたので、彼らふたりは急いで去り、バホリムの、あるひとりの人の家にきた。その人の庭に井戸があって、彼らはその中に下ったので、"},{"ref":"2Sam.17.19","start":10017019,"end":10017019,"break":"none","ruby":[[0,1,"おんな"],[6,1,"と"],[11,2,"いど"],[14,1,"くち"],[16,1,"うえ"],[22,1,"むぎ"],[26,1,"うえ"],[30,1,"ち"],[41,1,"こと"],[43,1,"なに"],[45,1,"し"]],"text":"女はおおいを取ってきて井戸の口の上にひろげ、麦をその上にまき散らした。それゆえその事は何も知れなかった。"},{"ref":"2Sam.17.20","start":10017020,"end":10017020,"break":"none","ruby":[[14,1,"おんな"],[16,1,"いえ"],[20,1,"い"],[45,1,"おんな"],[47,1,"かれ"],[50,1,"い"],[57,2,"ひとびと"],[60,2,"おがわ"],[63,1,"わた"],[66,1,"い"],[73,1,"かれ"],[76,1,"たず"],[80,2,"みあた"],[95,1,"かえ"]],"text":"アブサロムのしもべたちはその女の家にきて言った、「アヒマアズとヨナタンはどこにいますか」。女は彼らに言った、「あの人々は小川を渡って行きました」。彼らは尋ねたが見当らなかったのでエルサレムに帰った。"},{"ref":"2Sam.17.21","start":10017021,"end":10017021,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"さ"],[6,1,"のち"],[8,2,"ひとびと"],[11,2,"いど"],[15,1,"のぼ"],[18,1,"い"],[24,1,"おう"],[26,1,"つ"],[34,1,"かれ"],[41,1,"い"],[46,1,"た"],[55,1,"かわ"],[57,1,"わた"],[75,1,"たい"],[82,1,"はか"]],"text":"彼らが去った後、人々は井戸から上り、行ってダビデ王に告げた。すなわち彼らはダビデに言った、「立って、すみやかに川を渡りなさい。アヒトペルがあなたがたに対してこういう計りごとをしたからです」。"},{"ref":"2Sam.17.22","start":10017022,"end":10017022,"break":"none","ruby":[[7,1,"た"],[11,1,"とも"],[19,1,"たみ"],[21,2,"いっしょ"],[29,1,"わた"],[33,2,"よあ"],[44,1,"わた"],[48,1,"もの"]],"text":"そこでダビデは立って、共にいるすべての民と一緒にヨルダンを渡った。夜明けには、ヨルダンを渡らない者はひとりもなかった。"},{"ref":"2Sam.17.23","start":10017023,"end":10017023,"break":"paragraph","ruby":[[7,2,"じぶん"],[10,1,"はか"],[15,1,"おこな"],[22,1,"み"],[31,1,"お"],[34,1,"た"],[37,2,"じぶん"],[40,1,"まち"],[42,1,"い"],[47,1,"いえ"],[49,1,"かえ"],[56,1,"いえ"],[58,1,"ひと"],[60,2,"ゆいごん"],[72,1,"し"],[77,1,"ちち"],[79,1,"はか"],[81,1,"ほうむ"]],"text":"アヒトペルは、自分の計りごとが行われないのを見て、ろばにくらを置き、立って自分の町に行き、その家に帰った。そして家の人に遺言してみずからくびれて死に、その父の墓に葬られた。"},{"ref":"2Sam.17.24","start":10017024,"end":10017024,"break":"paragraph","ruby":[[21,2,"じぶん"],[24,1,"とも"],[38,2,"ひとびと"],[41,2,"いっしょ"],[49,1,"わた"]],"text":"ダビデはマハナイムにきた。またアブサロムは自分と共にいるイスラエルのすべての人々と一緒にヨルダンを渡った。"},{"ref":"2Sam.17.25","start":10017025,"end":10017025,"break":"none","ruby":[[14,1,"かわ"],[17,1,"ぐん"],[19,1,"ちょう"],[34,1,"むすめ"],[40,1,"はは"],[45,1,"いもうと"],[66,1,"な"],[74,1,"ひと"],[76,1,"こ"]],"text":"アブサロムはアマサをヨアブの代りに軍の長とした。アマサはかのナハシの娘でヨアブの母ゼルヤの妹であるアビガルをめとったイシマエルびと、名はイトラという人の子である。"},{"ref":"2Sam.17.26","start":10017026,"end":10017026,"break":"none","ruby":[[20,1,"ち"],[22,2,"じんど"]],"text":"そしてイスラエルとアブサロムはギレアデの地に陣取った。"},{"ref":"2Sam.17.27","start":10017027,"end":10017027,"break":"paragraph","ruby":[[12,1,"とき"],[19,2,"ひとびと"],[32,1,"こ"],[50,1,"こ"]],"text":"ダビデがマハナイムにきた時、アンモンの人々のうちのラバのナハシの子ショビと、ロ・デバルのアンミエルの子マキル、およびロゲリムのギレアデびとバルジライは、"},{"ref":"2Sam.17.28","start":10017028,"end":10017028,"break":"none","ruby":[[0,2,"ねどこ"],[3,1,"はち"],[5,2,"どき"],[8,2,"こむぎ"],[11,2,"おおむぎ"],[14,1,"こな"],[18,1,"むぎ"],[20,1,"まめ"],[25,1,"まめ"]],"text":"寝床と鉢、土器、小麦、大麦、粉、いり麦、豆、レンズ豆、"},{"ref":"2Sam.17.29","start":10017029,"end":10017029,"break":"none","ruby":[[0,1,"みつ"],[2,2,"ぎょうにゅう"],[5,1,"ひつじ"],[7,2,"かんらく"],[16,1,"とも"],[20,1,"たみ"],[22,1,"た"],[28,1,"も"],[37,1,"かれ"],[42,1,"たみ"],[44,2,"あらの"],[47,1,"う"],[49,1,"つか"],[59,1,"おも"]],"text":"蜜、凝乳、羊、乾酪をダビデおよび共にいる民が食べるために持ってきた。それは彼らが、「民は荒野で飢え疲れかわいている」と思ったからである。"}]