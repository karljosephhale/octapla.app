[{"ref":"2Chr.24.1","start":14024001,"end":14024001,"break":"paragraph","ruby":[[4,1,"くらい"],[9,1,"とき"],[11,1,"さい"],[22,1,"ねん"],[24,1,"あいだ"],[26,1,"よ"],[28,1,"おさ"],[32,1,"かれ"],[34,1,"はは"],[43,1,"で"],[45,1,"もの"],[47,1,"な"]],"text":"ヨアシは位についた時七歳で、エルサレムで四十年の間、世を治めた。彼の母はベエルシバから出た者で名をヂビアといった。"},{"ref":"2Chr.24.2","start":14024002,"end":14024002,"break":"none","ruby":[[4,2,"さいし"],[11,1,"よ"],[15,1,"ひ"],[17,1,"あいだ"],[19,1,"つね"],[21,1,"しゅ"],[23,1,"よ"],[26,1,"み"],[33,1,"おこな"]],"text":"ヨアシは祭司エホヤダの世にある日の間は常に主の良しと見られることを行った。"},{"ref":"2Chr.24.3","start":14024003,"end":14024003,"break":"none","ruby":[[5,1,"かれ"],[14,1,"つま"],[20,1,"かれ"],[22,2,"だんし"],[25,2,"じょし"],[28,1,"うま"]],"text":"エホヤダは彼のためにふたりの妻をめとり、彼に男子と女子が生れた。"},{"ref":"2Chr.24.4","start":14024004,"end":14024004,"break":"paragraph","ruby":[[2,1,"のち"],[7,1,"しゅ"],[9,1,"みや"],[11,2,"しゅうぜん"],[17,1,"こころざ"]],"text":"この後ヨアシは主の宮を修繕しようと志して、"},{"ref":"2Chr.24.5","start":14024005,"end":14024005,"break":"none","ruby":[[0,2,"さいし"],[8,1,"あつ"],[11,1,"い"],[19,2,"まちまち"],[22,1,"い"],[32,1,"かみ"],[34,1,"みや"],[36,2,"ねんねん"],[38,2,"しゅうぜん"],[42,2,"しきん"],[58,1,"あつ"],[66,1,"こと"],[68,1,"いそ"],[89,1,"いそ"]],"text":"祭司とレビびとを集めて言った、「ユダの町々へ行って、あなたがたの神の宮を年々修繕する資金をすべてのイスラエルびとから集めなさい。その事を急いでしなさい」。ところがレビびとはこれを急いでしなかった。"},{"ref":"2Chr.24.6","start":14024006,"end":14024006,"break":"none","ruby":[[3,1,"おう"],[16,1,"め"],[19,1,"い"],[35,1,"もと"],[39,1,"しゅ"],[52,2,"まくや"],[64,2,"かいしゅう"],[67,1,"か"],[70,2,"ぜいきん"],[83,1,"と"],[85,1,"た"]],"text":"それで王はかしらであるエホヤダを召して言った、「あなたはなぜレビびとに求めて、主のしもべモーセがあかしの幕屋のためにイスラエルの会衆に課した税金をユダとエルサレムから取り立てさせないのか」。"},{"ref":"2Chr.24.7","start":14024007,"end":14024007,"break":"none","ruby":[[2,1,"わる"],[4,1,"おんな"],[10,1,"こ"],[13,1,"かみ"],[15,1,"みや"],[17,2,"しんにゅう"],[21,1,"しゅ"],[23,1,"みや"],[30,3,"ほうのうぶつ"],[44,1,"もち"]],"text":"かの悪い女アタリヤの子らが神の宮に侵入して主の宮のもろもろの奉納物をとり、バアルのために用いたからである。"},{"ref":"2Chr.24.8","start":14024008,"end":14024008,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"めい"],[9,1,"こ"],[11,1,"はこ"],[13,1,"つく"],[20,1,"しゅ"],[22,1,"みや"],[24,1,"もん"],[26,1,"そと"],[28,1,"お"]],"text":"そこで王は命じて一個の箱を造らせ、これを主の宮の門の外に置き、"},{"ref":"2Chr.24.9","start":14024009,"end":14024009,"break":"none","ruby":[[13,1,"かみ"],[22,2,"あらの"],[31,1,"か"],[34,2,"ぜいきん"],[37,1,"しゅ"],[42,1,"も"]],"text":"ユダとエルサレムにふれて、神のしもべモーセが荒野でイスラエルに課した税金を主のために持ってこさせた。"},{"ref":"2Chr.24.10","start":14024010,"end":14024010,"break":"none","ruby":[[16,1,"たみ"],[18,1,"みな"],[19,1,"よろこ"],[24,2,"ぜいきん"],[27,1,"も"],[30,1,"き"],[35,1,"はこ"],[37,1,"な"],[39,1,"い"],[48,1,"はこ"]],"text":"すべてのつかさたちおよびすべての民は皆喜んでその税金を持って来て、その箱に投げ入れたので、ついに箱はいっぱいになった。"},{"ref":"2Chr.24.11","start":14024011,"end":14024011,"break":"none","ruby":[[7,1,"はこ"],[9,1,"きん"],[11,1,"おお"],[17,1,"み"],[20,1,"おう"],[22,2,"やくにん"],[25,1,"ところ"],[27,1,"も"],[30,1,"い"],[34,1,"おう"],[36,2,"しょき"],[39,2,"さいし"],[41,1,"ちょう"],[43,2,"したやく"],[47,1,"き"],[52,1,"はこ"],[54,1,"かたむ"],[60,1,"と"],[66,1,"ところ"],[68,1,"かえ"],[72,1,"かれ"],[75,2,"ひび"],[84,1,"きん"],[92,1,"あつ"]],"text":"レビびとはその箱に金が多くあるのを見て、王の役人の所へ持って行くと、王の書記と祭司長の下役とが来て、その箱を傾け、これを取ってもとの所に返した。彼らは日々このようにして金をおびただしく集めた。"},{"ref":"2Chr.24.12","start":14024012,"end":14024012,"break":"none","ruby":[[0,1,"おう"],[10,1,"しゅ"],[12,1,"みや"],[14,2,"こうじ"],[19,1,"もの"],[21,1,"わた"],[24,2,"いしく"],[29,2,"もっこう"],[32,1,"やと"],[36,1,"しゅ"],[38,1,"みや"],[40,2,"しゅうぜん"],[47,2,"てっこう"],[52,2,"せいどう"],[54,1,"こう"],[56,1,"やと"],[60,1,"しゅ"],[62,1,"みや"],[64,2,"しゅうふく"]],"text":"王とエホヤダはこれを主の宮の工事をなす者に渡し、石工および木工を雇って、主の宮を修繕させ、また鉄工および青銅工を雇って、主の宮を修復させた。"},{"ref":"2Chr.24.13","start":14024013,"end":14024013,"break":"none","ruby":[[0,2,"こうじん"],[5,1,"はたら"],[11,2,"しゅうふく"],[14,2,"こうじ"],[17,1,"かれ"],[20,1,"て"],[30,1,"かみ"],[32,1,"みや"],[38,2,"じょうたい"],[41,1,"ふく"],[47,2,"けんご"]],"text":"工人たちは働いたので、修復の工事は彼らの手によってはかどり、神の宮を、もとの状態に復し、これを堅固にした。"},{"ref":"2Chr.24.14","start":14024014,"end":14024014,"break":"none","ruby":[[5,1,"おわ"],[11,1,"あま"],[14,1,"きん"],[16,1,"おう"],[23,1,"まえ"],[25,1,"も"],[28,1,"き"],[39,1,"しゅ"],[41,1,"みや"],[46,2,"うつわもの"],[49,1,"つく"],[57,1,"つと"],[60,1,"うつわ"],[62,2,"はんさい"],[65,1,"うつわ"],[67,1,"こう"],[69,1,"さら"],[74,2,"きんぎん"],[77,1,"うつわ"],[79,1,"つく"],[88,1,"よ"],[92,1,"ひ"],[94,1,"あいだ"],[97,1,"た"],[100,1,"しゅ"],[102,1,"みや"],[104,2,"はんさい"]],"text":"それをなし終ったとき、余った金を王とエホヤダの前に持って来たので、それをもって主の宮のために器物を造った。すなわち勤めの器、燔祭の器、香の皿、および金銀の器を造った。エホヤダの世にある日の間は、絶えず主の宮で燔祭をささげた。"},{"ref":"2Chr.24.15","start":14024015,"end":14024015,"break":"paragraph","ruby":[[8,2,"としお"],[12,1,"ひ"],[14,1,"み"],[17,1,"し"],[23,1,"し"],[26,1,"とき"],[31,1,"さい"]],"text":"しかしエホヤダは年老い、日が満ちて死んだ。その死んだ時は百三十歳であった。"},{"ref":"2Chr.24.16","start":14024016,"end":14024016,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"かれ"],[9,1,"まち"],[11,1,"おう"],[15,1,"なか"],[17,1,"ほうむ"],[21,1,"かれ"],[32,1,"かみ"],[36,1,"みや"],[39,1,"よ"],[41,1,"こと"],[43,1,"おこな"]],"text":"人々は彼をダビデの町で王たちの中に葬った。彼はイスラエルにおいて神とその宮とに良い事を行ったからである。"},{"ref":"2Chr.24.17","start":14024017,"end":14024017,"break":"paragraph","ruby":[[5,1,"し"],[8,1,"のち"],[19,1,"き"],[28,1,"おう"],[30,2,"けいい"],[33,1,"あらわ"],[37,1,"おう"],[39,1,"かれ"],[42,1,"き"],[44,1,"したが"]],"text":"エホヤダの死んだ後、ユダのつかさたちが来て、うやうやしく王に敬意を表した。王は彼らに聞き従った。"},{"ref":"2Chr.24.18","start":14024018,"end":14024018,"break":"none","ruby":[[0,1,"かれ"],[5,2,"せんぞ"],[8,1,"かみ"],[10,1,"しゅ"],[12,1,"みや"],[14,1,"す"],[21,1,"ぞう"],[25,2,"ぐうぞう"],[28,1,"つか"],[43,1,"いか"],[55,1,"のぞ"]],"text":"彼らはその先祖の神、主の宮を捨てて、アシラ像および偶像に仕えたので、そのとがのために、怒りがユダとエルサレムに臨んだ。"},{"ref":"2Chr.24.19","start":14024019,"end":14024019,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[6,2,"じぶん"],[9,1,"ひ"],[11,1,"かえ"],[18,3,"よげんしゃ"],[29,1,"かれ"],[47,1,"みみ"],[49,1,"かたむ"]],"text":"主は彼らをご自分に引き返そうとして、預言者たちをつかわし、彼らにむかってあかしをさせられたが、耳を傾けなかった。"},{"ref":"2Chr.24.20","start":14024020,"end":14024020,"break":"paragraph","ruby":[[3,1,"かみ"],[5,1,"れい"],[7,2,"さいし"],[14,1,"こ"],[20,1,"のぞ"],[26,1,"かれ"],[28,1,"たみ"],[30,1,"まえ"],[32,1,"た"],[34,1,"あ"],[38,1,"い"],[43,1,"かみ"],[47,1,"おお"],[60,1,"しゅ"],[62,1,"いまし"],[65,1,"おか"],[69,1,"わざわい"],[71,1,"まね"],[92,1,"しゅ"],[94,1,"す"],[101,1,"しゅ"],[109,1,"す"]],"text":"そこで神の霊が祭司エホヤダの子ゼカリヤに臨んだので、彼は民の前に立ち上がって言った、「神はこう仰せられる、『あなたがたが主の戒めを犯して、災を招くのはどういうわけであるか。あなたがたが主を捨てたために、主もあなたがたを捨てられたのである』」。"},{"ref":"2Chr.24.21","start":14024021,"end":14024021,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"かれ"],[8,1,"がい"],[13,1,"はか"],[16,1,"おう"],[18,1,"いのち"],[24,1,"いし"],[29,1,"かれ"],[31,1,"しゅ"],[33,1,"みや"],[35,1,"にわ"],[37,1,"う"],[39,1,"ころ"]],"text":"しかし人々は彼を害しようと計り、王の命によって、石をもって彼を主の宮の庭で撃ち殺した。"},{"ref":"2Chr.24.22","start":14024022,"end":14024022,"break":"none","ruby":[[8,1,"おう"],[15,1,"ちち"],[21,2,"じぶん"],[24,1,"ほどこ"],[27,1,"めぐ"],[30,1,"おも"],[36,1,"こ"],[38,1,"ころ"],[47,1,"し"],[49,1,"とき"],[55,1,"しゅ"],[66,1,"ばっ"],[76,1,"い"]],"text":"このようにヨアシ王はゼカリヤの父エホヤダが自分に施した恵みを思わず、その子を殺した。ゼカリヤは死ぬ時、「どうぞ主がこれをみそなわして罰せられるように」と言った。"},{"ref":"2Chr.24.23","start":14024023,"end":14024023,"break":"paragraph","ruby":[[0,1,"ねん"],[2,1,"おわ"],[13,2,"ぐんぜい"],[24,1,"せ"],[26,1,"のぼ"],[38,1,"き"],[41,1,"たみ"],[54,1,"たみ"],[60,1,"ほろ"],[70,1,"もの"],[72,1,"みな"],[78,1,"おう"],[80,1,"おく"]],"text":"年の終りになって、スリヤの軍勢はヨアシにむかって攻め上り、ユダとエルサレムに来て、民のつかさたちをことごとく民のうちから滅ぼし、そのぶんどり物を皆ダマスコの王に送った。"},{"ref":"2Chr.24.24","start":14024024,"end":14024024,"break":"none","ruby":[[2,1,"とき"],[7,2,"ぐんぜい"],[10,2,"しょうすう"],[13,1,"き"],[21,1,"しゅ"],[23,2,"たいぐん"],[26,1,"かれ"],[29,1,"て"],[31,1,"わた"],[39,1,"かれ"],[44,2,"せんぞ"],[47,1,"かみ"],[49,1,"しゅ"],[51,1,"す"],[65,1,"かれ"],[72,1,"ばっ"]],"text":"この時スリヤの軍勢は少数で来たのであるが、主は大軍を彼らの手に渡された。これは彼らがその先祖の神、主を捨てたためである。このように彼らはヨアシを罰した。"},{"ref":"2Chr.24.25","start":14024025,"end":14024025,"break":"paragraph","ruby":[[3,1,"ぐん"],[9,1,"だい"],[10,1,"きず"],[12,1,"お"],[16,1,"す"],[18,1,"さ"],[27,2,"けらい"],[32,2,"さいし"],[39,1,"こ"],[41,1,"ち"],[47,1,"とう"],[49,1,"むす"],[52,1,"かれ"],[58,1,"かれ"],[60,1,"とこ"],[62,1,"うえ"],[64,1,"ころ"],[68,1,"し"],[73,2,"ひとびと"],[76,1,"かれ"],[82,1,"まち"],[84,1,"ほうむ"],[89,1,"おう"],[91,1,"はか"],[94,1,"ほうむ"]],"text":"スリヤ軍はヨアシに大傷を負わせて捨て去ったが、ヨアシの家来たちは祭司エホヤダの子の血のために、党を結んで彼にそむき、彼を床の上に殺して、死なせた。人々は彼をダビデの町に葬ったが、王の墓には葬らなかった。"},{"ref":"2Chr.24.26","start":14024026,"end":14024026,"break":"none","ruby":[[0,1,"とう"],[2,1,"むす"],[5,1,"かれ"],[11,1,"もの"],[19,1,"おんな"],[25,1,"こ"],[36,1,"おんな"],[42,1,"こ"]],"text":"党を結んで彼にそむいた者は、アンモンの女シメアテの子ザバデおよびモアブの女シムリテの子ヨザバデであった。"},{"ref":"2Chr.24.27","start":14024027,"end":14024027,"break":"none","ruby":[[4,1,"こ"],[14,1,"たい"],[17,1,"おお"],[20,2,"よげん"],[25,1,"かみ"],[27,1,"みや"],[29,2,"しゅうり"],[32,1,"こと"],[37,1,"れつ"],[38,1,"おう"],[40,1,"しょ"],[42,2,"ちゅうしゃく"],[57,1,"こ"],[63,1,"かれ"],[65,1,"かわ"],[68,1,"おう"]],"text":"ヨアシの子らのこと、ヨアシに対する多くの預言および神の宮の修理の事などは、列王の書の注釈にしるされている。ヨアシの子アマジヤが彼に代って王となった。"}]