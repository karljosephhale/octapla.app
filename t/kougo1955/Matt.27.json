[{"ref":"Matt.27.1","start":40027001,"end":40027001,"break":"paragraph","ruby":[[0,1,"よ"],[2,1,"あ"],[7,3,"さいしちょう"],[13,1,"たみ"],[15,2,"ちょうろう"],[19,2,"いちどう"],[27,1,"ころ"],[33,2,"きょうぎ"],[40,1,"うえ"]],"text":"夜が明けると、祭司長たち、民の長老たち一同は、イエスを殺そうとして協議をこらした上、"},{"ref":"Matt.27.2","start":40027002,"end":40027002,"break":"none","ruby":[[4,1,"しば"],[7,1,"ひ"],[9,1,"だ"],[12,2,"そうとく"],[18,1,"わた"]],"text":"イエスを縛って引き出し、総督ピラトに渡した。"},{"ref":"Matt.27.3","start":40027003,"end":40027003,"break":"paragraph","ruby":[[9,2,"うらぎ"],[21,1,"つみ"],[23,1,"さだ"],[30,1,"み"],[32,2,"こうかい"],[36,2,"ぎんか"],[40,1,"まい"],[42,3,"さいしちょう"],[46,2,"ちょうろう"],[51,1,"かえ"]],"text":"そのとき、イエスを裏切ったユダは、イエスが罪に定められたのを見て後悔し、銀貨三十枚を祭司長、長老たちに返して"},{"ref":"Matt.27.4","start":40027004,"end":40027004,"break":"none","ruby":[[0,1,"い"],[9,1,"つみ"],[13,1,"ひと"],[15,1,"ち"],[17,1,"う"],[28,1,"つみ"],[30,1,"おか"],[40,1,"かれ"],[43,1,"い"],[57,1,"し"],[64,2,"じぶん"],[67,2,"しまつ"]],"text":"言った、「わたしは罪のない人の血を売るようなことをして、罪を犯しました」。しかし彼らは言った、「それは、われわれの知ったことか。自分で始末するがよい」。"},{"ref":"Matt.27.5","start":40027005,"end":40027005,"break":"none","ruby":[[4,1,"かれ"],[6,2,"ぎんか"],[9,2,"せいじょ"],[12,1,"な"],[14,1,"こ"],[17,1,"で"],[19,1,"い"],[22,1,"くび"],[27,1,"し"]],"text":"そこで、彼は銀貨を聖所に投げ込んで出て行き、首をつって死んだ。"},{"ref":"Matt.27.6","start":40027006,"end":40027006,"break":"none","ruby":[[0,3,"さいしちょう"],[9,2,"ぎんか"],[12,1,"ひろ"],[17,1,"い"],[25,1,"ち"],[27,2,"だいか"],[33,1,"みや"],[35,2,"きんこ"],[38,1,"い"]],"text":"祭司長たちは、その銀貨を拾いあげて言った、「これは血の代価だから、宮の金庫に入れるのはよくない」。"},{"ref":"Matt.27.7","start":40027007,"end":40027007,"break":"none","ruby":[[3,1,"かれ"],[6,2,"きょうぎ"],[9,1,"うえ"],[11,2,"がいこく"],[13,1,"ひと"],[15,2,"ぼち"],[26,1,"かね"],[28,2,"とうき"],[30,1,"し"],[32,1,"はたけ"],[34,1,"か"]],"text":"そこで彼らは協議の上、外国人の墓地にするために、その金で陶器師の畑を買った。"},{"ref":"Matt.27.8","start":40027008,"end":40027008,"break":"none","ruby":[[8,1,"はたけ"],[10,2,"きょう"],[14,1,"ち"],[16,1,"はたけ"],[18,1,"よ"]],"text":"そのために、この畑は今日まで血の畑と呼ばれている。"},{"ref":"Matt.27.9","start":40027009,"end":40027009,"break":"none","ruby":[[4,3,"よげんしゃ"],[15,1,"い"],[19,2,"ことば"],[23,2,"じょうじゅ"],[38,1,"かれ"],[42,1,"ね"],[63,1,"こ"],[66,1,"ね"],[74,2,"だいか"],[77,2,"ぎんか"],[82,1,"と"]],"text":"こうして預言者エレミヤによって言われた言葉が、成就したのである。すなわち、「彼らは、値をつけられたもの、すなわち、イスラエルの子らが値をつけたものの代価、銀貨三十を取って、"},{"ref":"Matt.27.10","start":40027010,"end":40027010,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"めい"],[13,2,"とうき"],[15,1,"し"],[17,1,"はたけ"],[19,2,"だいか"],[27,1,"かね"],[29,1,"あた"]],"text":"主がお命じになったように、陶器師の畑の代価として、その金を与えた」。"},{"ref":"Matt.27.11","start":40027011,"end":40027011,"break":"paragraph","ruby":[[7,2,"そうとく"],[10,1,"まえ"],[12,1,"た"],[20,2,"そうとく"],[27,1,"たず"],[30,1,"い"],[42,1,"じん"],[44,1,"おう"],[66,1,"い"]],"text":"さて、イエスは総督の前に立たれた。すると総督はイエスに尋ねて言った、「あなたがユダヤ人の王であるか」。イエスは「そのとおりである」と言われた。"},{"ref":"Matt.27.12","start":40027012,"end":40027012,"break":"none","ruby":[[4,3,"さいしちょう"],[8,2,"ちょうろう"],[13,1,"うった"],[18,1,"あいだ"],[26,1,"こと"],[29,1,"こた"]],"text":"しかし、祭司長、長老たちが訴えている間、イエスはひと言もお答えにならなかった。"},{"ref":"Matt.27.13","start":40027013,"end":40027013,"break":"none","ruby":[[7,1,"い"],[18,2,"つぎつぎ"],[26,2,"ふり"],[29,2,"しょうげん"],[32,1,"た"],[45,1,"きこ"]],"text":"するとピラトは言った、「あんなにまで次々に、あなたに不利な証言を立てているのが、あなたには聞えないのか」。"},{"ref":"Matt.27.14","start":40027014,"end":40027014,"break":"none","ruby":[[4,2,"そうとく"],[7,2,"ひじょう"],[10,3,"ふしぎ"],[14,1,"おも"],[25,1,"なに"],[27,1,"い"],[35,1,"こと"],[38,1,"こた"]],"text":"しかし、総督が非常に不思議に思ったほどに、イエスは何を言われても、ひと言もお答えにならなかった。"},{"ref":"Matt.27.15","start":40027015,"end":40027015,"break":"none","ruby":[[3,1,"まつり"],[11,2,"そうとく"],[14,2,"ぐんしゅう"],[17,1,"ねが"],[19,1,"で"],[21,2,"しゅうじん"],[34,2,"かんれい"]],"text":"さて、祭のたびごとに、総督は群衆が願い出る囚人ひとりを、ゆるしてやる慣例になっていた。"},{"ref":"Matt.27.16","start":40027016,"end":40027016,"break":"none","ruby":[[10,2,"ひょうばん"],[13,2,"しゅうじん"]],"text":"ときに、バラバという評判の囚人がいた。"},{"ref":"Matt.27.17","start":40027017,"end":40027017,"break":"none","ruby":[[4,1,"かれ"],[7,1,"あつ"],[18,1,"い"]],"text":"それで、彼らが集まったとき、ピラトは言った、「おまえたちは、だれをゆるしてほしいのか。バラバか、それとも、キリストといわれるイエスか」。"},{"ref":"Matt.27.18","start":40027018,"end":40027018,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ひ"]],"text":"彼らがイエスを引きわたしたのは、ねたみのためであることが、ピラトにはよくわかっていたからである。"},{"ref":"Matt.27.19","start":40027019,"end":40027019,"break":"none","ruby":[[7,2,"さいばん"],[10,1,"せき"],[22,1,"つま"],[24,1,"ひと"],[26,1,"かれ"],[40,2,"ぎじん"],[44,2,"かんけい"],[62,1,"ゆめ"],[67,1,"ひと"],[76,1,"くる"],[86,1,"い"]],"text":"また、ピラトが裁判の席についていたとき、その妻が人を彼のもとにつかわして、「あの義人には関係しないでください。わたしはきょう夢で、あの人のためにさんざん苦しみましたから」と言わせた。"},{"ref":"Matt.27.20","start":40027020,"end":40027020,"break":"none","ruby":[[4,3,"さいしちょう"],[8,2,"ちょうろう"],[27,1,"ころ"],[38,2,"ぐんしゅう"],[41,1,"と"],[43,1,"ふ"]],"text":"しかし、祭司長、長老たちは、バラバをゆるして、イエスを殺してもらうようにと、群衆を説き伏せた。"},{"ref":"Matt.27.21","start":40027021,"end":40027021,"break":"none","ruby":[[0,2,"そうとく"],[3,1,"かれ"],[10,1,"い"],[37,1,"かれ"],[45,1,"ほう"],[49,1,"い"]],"text":"総督は彼らにむかって言った、「ふたりのうち、どちらをゆるしてほしいのか」。彼らは「バラバの方を」と言った。"},{"ref":"Matt.27.22","start":40027022,"end":40027022,"break":"none","ruby":[[4,1,"い"],[37,1,"かれ"],[46,3,"じゅうじか"],[55,1,"い"]],"text":"ピラトは言った、「それではキリストといわれるイエスは、どうしたらよいか」。彼らはいっせいに「十字架につけよ」と言った。"},{"ref":"Matt.27.23","start":40027023,"end":40027023,"break":"none","ruby":[[8,1,"い"],[15,1,"ひと"],[26,2,"あくじ"],[38,1,"かれ"],[45,1,"はげ"],[48,1,"さけ"],[53,3,"じゅうじか"],[62,1,"い"]],"text":"しかし、ピラトは言った、「あの人は、いったい、どんな悪事をしたのか」。すると彼らはいっそう激しく叫んで、「十字架につけよ」と言った。"},{"ref":"Matt.27.24","start":40027024,"end":40027024,"break":"none","ruby":[[4,1,"て"],[18,2,"ぼうどう"],[28,1,"み"],[31,1,"みず"],[33,1,"と"],[36,2,"ぐんしゅう"],[39,1,"まえ"],[41,1,"て"],[43,1,"あら"],[46,1,"い"],[53,1,"ひと"],[55,1,"ち"],[66,2,"せきにん"],[78,2,"じぶん"],[81,2,"しまつ"]],"text":"ピラトは手のつけようがなく、かえって暴動になりそうなのを見て、水を取り、群衆の前で手を洗って言った、「この人の血について、わたしには責任がない。おまえたちが自分で始末をするがよい」。"},{"ref":"Matt.27.25","start":40027025,"end":40027025,"break":"none","ruby":[[4,2,"みんしゅう"],[6,2,"ぜんたい"],[9,1,"こた"],[12,1,"い"],[19,1,"ち"],[21,2,"せきにん"],[35,2,"しそん"],[38,1,"うえ"]],"text":"すると、民衆全体が答えて言った、「その血の責任は、われわれとわれわれの子孫の上にかかってもよい」。"},{"ref":"Matt.27.26","start":40027026,"end":40027026,"break":"none","ruby":[[25,1,"う"],[31,3,"じゅうじか"],[41,1,"ひ"]],"text":"そこで、ピラトはバラバをゆるしてやり、イエスをむち打ったのち、十字架につけるために引きわたした。"},{"ref":"Matt.27.27","start":40027027,"end":40027027,"break":"paragraph","ruby":[[4,2,"そうとく"],[7,2,"へいし"],[17,2,"かんてい"],[20,1,"つ"],[23,1,"い"],[27,1,"ぜん"],[28,2,"ぶたい"],[39,1,"あつ"]],"text":"それから総督の兵士たちは、イエスを官邸に連れて行って、全部隊をイエスのまわりに集めた。"},{"ref":"Matt.27.28","start":40027028,"end":40027028,"break":"none","ruby":[[5,2,"うわぎ"],[13,1,"あか"],[15,2,"がいとう"],[18,1,"き"]],"text":"そしてその上着をぬがせて、赤い外套を着せ、"},{"ref":"Matt.27.29","start":40027029,"end":40027029,"break":"none","ruby":[[7,1,"かんむり"],[9,1,"あ"],[14,1,"あたま"],[21,1,"みぎ"],[23,1,"て"],[26,1,"あし"],[28,1,"ぼう"],[30,1,"も"],[40,1,"まえ"],[48,2,"ちょうろう"],[57,1,"じん"],[59,1,"おう"],[67,1,"い"]],"text":"また、いばらで冠を編んでその頭にかぶらせ、右の手には葦の棒を持たせ、それからその前にひざまずき、嘲弄して、「ユダヤ人の王、ばんざい」と言った。"},{"ref":"Matt.27.30","start":40027030,"end":40027030,"break":"none","ruby":[[14,1,"あし"],[16,1,"ぼう"],[18,1,"と"],[25,1,"あたま"]],"text":"また、イエスにつばきをかけ、葦の棒を取りあげてその頭をたたいた。"},{"ref":"Matt.27.31","start":40027031,"end":40027031,"break":"none","ruby":[[8,2,"ちょうろう"],[16,2,"がいとう"],[21,1,"と"],[24,1,"もと"],[26,2,"うわぎ"],[29,1,"き"],[36,3,"じゅうじか"],[46,1,"ひ"],[48,1,"だ"]],"text":"こうしてイエスを嘲弄したあげく、外套をはぎ取って元の上着を着せ、それから十字架につけるために引き出した。"},{"ref":"Matt.27.32","start":40027032,"end":40027032,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"で"],[5,1,"い"],[15,1,"な"],[20,1,"びと"],[22,2,"であ"],[33,3,"じゅうじか"],[37,2,"むり"],[40,1,"お"]],"text":"彼らが出て行くと、シモンという名のクレネ人に出会ったので、イエスの十字架を無理に負わせた。"},{"ref":"Matt.27.33","start":40027033,"end":40027033,"break":"none","ruby":[[20,1,"ば"],[25,1,"ところ"]],"text":"そして、ゴルゴタ、すなわち、されこうべの場、という所にきたとき、"},{"ref":"Matt.27.34","start":40027034,"end":40027034,"break":"none","ruby":[[0,1,"かれ"],[13,1,"しゅ"],[15,1,"の"],[39,1,"の"]],"text":"彼らはにがみをまぜたぶどう酒を飲ませようとしたが、イエスはそれをなめただけで、飲もうとされなかった。"},{"ref":"Matt.27.35","start":40027035,"end":40027035,"break":"none","ruby":[[0,1,"かれ"],[7,3,"じゅうじか"],[20,1,"ひ"],[26,2,"きもの"],[29,1,"わ"]],"text":"彼らはイエスを十字架につけてから、くじを引いて、その着物を分け、"},{"ref":"Matt.27.36","start":40027036,"end":40027036,"break":"none","ruby":[[11,1,"ばん"]],"text":"そこにすわってイエスの番をしていた。"},{"ref":"Matt.27.37","start":40027037,"end":40027037,"break":"none","ruby":[[5,1,"あたま"],[7,1,"うえ"],[9,1,"ほう"],[19,1,"じん"],[21,1,"おう"],[27,1,"か"],[30,2,"ざいじょう"],[32,1,"が"]],"text":"そしてその頭の上の方に、「これはユダヤ人の王イエス」と書いた罪状書きをかかげた。"},{"ref":"Matt.27.38","start":40027038,"end":40027038,"break":"none","ruby":[[0,2,"どうじ"],[8,2,"ごうとう"],[15,2,"いっしょ"],[23,1,"みぎ"],[30,1,"ひだり"],[33,3,"じゅうじか"]],"text":"同時に、ふたりの強盗がイエスと一緒に、ひとりは右に、ひとりは左に、十字架につけられた。"},{"ref":"Matt.27.39","start":40027039,"end":40027039,"break":"none","ruby":[[3,1,"とお"],[9,1,"もの"],[14,1,"あたま"],[16,1,"ふ"]],"text":"そこを通りかかった者たちは、頭を振りながら、イエスをののしって"},{"ref":"Matt.27.40","start":40027040,"end":40027040,"break":"none","ruby":[[0,1,"い"],[5,2,"しんでん"],[8,1,"う"],[15,1,"か"],[20,1,"た"],[23,1,"もの"],[28,1,"かみ"],[30,1,"こ"],[34,2,"じぶん"],[37,1,"すく"],[43,3,"じゅうじか"]],"text":"言った、「神殿を打ちこわして三日のうちに建てる者よ。もし神の子なら、自分を救え。そして十字架からおりてこい」。"},{"ref":"Matt.27.41","start":40027041,"end":40027041,"break":"none","ruby":[[0,3,"さいしちょう"],[6,1,"おな"],[12,2,"りっぽう"],[14,2,"がくしゃ"],[17,2,"ちょうろう"],[22,2,"いっしょ"],[29,2,"ちょうろう"],[33,1,"い"]],"text":"祭司長たちも同じように、律法学者、長老たちと一緒になって、嘲弄して言った、"},{"ref":"Matt.27.42","start":40027042,"end":40027042,"break":"none","ruby":[[1,2,"たにん"],[4,1,"すく"],[9,2,"じぶん"],[11,2,"じしん"],[14,1,"すく"],[33,1,"おう"],[40,3,"じゅうじか"],[56,1,"しん"]],"text":"「他人を救ったが、自分自身を救うことができない。あれがイスラエルの王なのだ。いま十字架からおりてみよ。そうしたら信じよう。"},{"ref":"Matt.27.43","start":40027043,"end":40027043,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かみ"],[12,1,"かみ"],[24,1,"いま"],[26,1,"すく"],[36,2,"じぶん"],[39,1,"かみ"],[41,1,"こ"],[44,1,"い"]],"text":"彼は神にたよっているが、神のおぼしめしがあれば、今、救ってもらうがよい。自分は神の子だと言っていたのだから」。"},{"ref":"Matt.27.44","start":40027044,"end":40027044,"break":"none","ruby":[[0,2,"いっしょ"],[3,3,"じゅうじか"],[12,2,"ごうとう"],[20,1,"おな"]],"text":"一緒に十字架につけられた強盗どもまでも、同じようにイエスをののしった。"},{"ref":"Matt.27.45","start":40027045,"end":40027045,"break":"paragraph","ruby":[[3,1,"ひる"],[7,1,"じ"],[10,2,"ちじょう"],[13,2,"ぜんめん"],[16,1,"くら"],[23,1,"じ"],[25,1,"およ"]],"text":"さて、昼の十二時から地上の全面が暗くなって、三時に及んだ。"},{"ref":"Matt.27.46","start":40027046,"end":40027046,"break":"none","ruby":[[4,1,"じ"],[13,2,"おおごえ"],[16,1,"さけ"],[37,1,"い"],[48,1,"かみ"],[52,1,"かみ"],[63,2,"みす"],[78,2,"いみ"]],"text":"そして三時ごろに、イエスは大声で叫んで、「エリ、エリ、レマ、サバクタニ」と言われた。それは「わが神、わが神、どうしてわたしをお見捨てになったのですか」という意味である。"},{"ref":"Matt.27.47","start":40027047,"end":40027047,"break":"none","ruby":[[7,1,"た"],[14,2,"ひとびと"],[21,1,"き"],[24,1,"い"],[36,1,"よ"]],"text":"すると、そこに立っていたある人々が、これを聞いて言った、「あれはエリヤを呼んでいるのだ」。"},{"ref":"Matt.27.48","start":40027048,"end":40027048,"break":"none","ruby":[[6,1,"かれ"],[16,1,"はし"],[18,1,"よ"],[22,2,"かいめん"],[25,1,"と"],[31,1,"す"],[36,1,"しゅ"],[38,1,"ふく"],[42,1,"あし"],[44,1,"ぼう"],[53,1,"の"]],"text":"するとすぐ、彼らのうちのひとりが走り寄って、海綿を取り、それに酢いぶどう酒を含ませて葦の棒につけ、イエスに飲ませようとした。"},{"ref":"Matt.27.49","start":40027049,"end":40027049,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"い"],[11,1,"ま"],[18,1,"かれ"],[20,1,"すく"],[23,1,"く"],[30,1,"み"]],"text":"ほかの人々は言った、「待て、エリヤが彼を救いに来るかどうか、見ていよう」。"},{"ref":"Matt.27.50","start":40027050,"end":40027050,"break":"none","ruby":[[6,2,"いちど"],[8,2,"おおごえ"],[11,1,"さけ"],[18,1,"いき"]],"text":"イエスはもう一度大声で叫んで、ついに息をひきとられた。"},{"ref":"Matt.27.51","start":40027051,"end":40027051,"break":"none","ruby":[[3,1,"み"],[6,2,"しんでん"],[9,1,"まく"],[11,1,"うえ"],[14,1,"した"],[17,2,"まっぷた"],[21,1,"さ"],[27,2,"じしん"],[33,1,"いわ"],[35,1,"さ"]],"text":"すると見よ、神殿の幕が上から下まで真二つに裂けた。また地震があり、岩が裂け、"},{"ref":"Matt.27.52","start":40027052,"end":40027052,"break":"none","ruby":[[2,1,"はか"],[4,1,"あ"],[7,1,"ねむ"],[12,1,"おお"],[15,2,"せいと"],[20,2,"したい"],[23,1,"い"],[25,1,"かえ"]],"text":"また墓が開け、眠っている多くの聖徒たちの死体が生き返った。"},{"ref":"Matt.27.53","start":40027053,"end":40027053,"break":"none","ruby":[[7,2,"ふっかつ"],[13,1,"はか"],[16,1,"で"],[21,1,"せい"],[24,1,"みやこ"],[30,1,"おお"],[33,1,"ひと"],[35,1,"あらわ"]],"text":"そしてイエスの復活ののち、墓から出てきて、聖なる都にはいり、多くの人に現れた。"},{"ref":"Matt.27.54","start":40027054,"end":40027054,"break":"none","ruby":[[0,3,"ひゃくそつちょう"],[7,1,"かれ"],[9,2,"いっしょ"],[16,1,"ばん"],[22,2,"ひとびと"],[26,2,"じしん"],[40,1,"み"],[42,2,"ひじょう"],[45,1,"おそ"],[56,1,"ひと"],[58,1,"かみ"],[60,1,"こ"],[67,1,"い"]],"text":"百卒長、および彼と一緒にイエスの番をしていた人々は、地震や、いろいろのできごとを見て非常に恐れ、「まことに、この人は神の子であった」と言った。"},{"ref":"Matt.27.55","start":40027055,"end":40027055,"break":"none","ruby":[[7,1,"とお"],[10,1,"ほう"],[13,1,"み"],[17,1,"おんな"],[21,1,"おお"],[26,1,"かれ"],[33,1,"つか"],[43,1,"したが"],[48,1,"ひと"]],"text":"また、そこには遠くの方から見ている女たちも多くいた。彼らはイエスに仕えて、ガリラヤから従ってきた人たちであった。"},{"ref":"Matt.27.56","start":40027056,"end":40027056,"break":"none","ruby":[[2,1,"なか"],[24,1,"はは"],[36,1,"こ"],[40,1,"はは"]],"text":"その中には、マグダラのマリヤ、ヤコブとヨセフとの母マリヤ、またゼベダイの子たちの母がいた。"},{"ref":"Matt.27.57","start":40027057,"end":40027057,"break":"paragraph","ruby":[[0,2,"ゆうがた"],[15,2,"かねもち"],[25,1,"な"],[27,1,"ひと"],[32,1,"かれ"],[40,2,"でし"]],"text":"夕方になってから、アリマタヤの金持で、ヨセフという名の人がきた。彼もまたイエスの弟子であった。"},{"ref":"Matt.27.58","start":40027058,"end":40027058,"break":"none","ruby":[[2,1,"ひと"],[8,1,"ところ"],[10,1,"い"],[22,2,"ひきと"],[28,1,"ねが"],[43,1,"わた"],[48,1,"めい"]],"text":"この人がピラトの所へ行って、イエスのからだの引取りかたを願った。そこで、ピラトはそれを渡すように命じた。"},{"ref":"Matt.27.59","start":40027059,"end":40027059,"break":"none","ruby":[[4,2,"したい"],[7,1,"う"],[9,1,"と"],[17,3,"あまぬの"],[21,1,"つつ"]],"text":"ヨセフは死体を受け取って、きれいな亜麻布に包み、"},{"ref":"Matt.27.60","start":40027060,"end":40027060,"break":"none","ruby":[[0,1,"いわ"],[2,1,"ほ"],[5,1,"つく"],[8,1,"かれ"],[10,1,"あたら"],[13,1,"はか"],[15,1,"おさ"],[21,1,"はか"],[23,2,"いりぐち"],[26,1,"おお"],[29,1,"いし"],[40,1,"かえ"]],"text":"岩を掘って造った彼の新しい墓に納め、そして墓の入口に大きい石をころがしておいて、帰った。"},{"ref":"Matt.27.61","start":40027061,"end":40027061,"break":"none","ruby":[[18,1,"はか"]],"text":"マグダラのマリヤとほかのマリヤとが、墓にむかってそこにすわっていた。"},{"ref":"Matt.27.62","start":40027062,"end":40027062,"break":"paragraph","ruby":[[3,1,"ひ"],[5,2,"じゅんび"],[8,1,"ひ"],[10,2,"よくじつ"],[20,1,"ひ"],[23,3,"さいしちょう"],[31,1,"びと"],[43,1,"あつ"],[47,1,"い"]],"text":"あくる日は準備の日の翌日であったが、その日に、祭司長、パリサイ人たちは、ピラトのもとに集まって言った、"},{"ref":"Matt.27.63","start":40027063,"end":40027063,"break":"none","ruby":[[1,2,"ちょうかん"],[6,1,"いつわ"],[8,1,"もの"],[12,1,"い"],[22,1,"か"],[24,1,"のち"],[26,2,"じぶん"],[36,1,"い"],[42,1,"おも"],[44,1,"だ"]],"text":"「長官、あの偽り者がまだ生きていたとき、『三日の後に自分はよみがえる』と言ったのを、思い出しました。"},{"ref":"Matt.27.64","start":40027064,"end":40027064,"break":"none","ruby":[[6,1,"か"],[7,1,"め"],[10,1,"はか"],[12,1,"ばん"],[26,1,"くだ"],[37,2,"でし"],[44,1,"かれ"],[46,1,"ぬす"],[48,1,"だ"],[56,2,"しにん"],[59,1,"なか"],[72,2,"みんしゅう"],[75,1,"い"],[82,1,"し"],[98,1,"まえ"]],"text":"ですから、三日目まで墓の番をするように、さしずをして下さい。そうしないと、弟子たちがきて彼を盗み出し、『イエスは死人の中から、よみがえった』と、民衆に言いふらすかも知れません。そうなると、みんなが前よりも、もっとひどくだまされることになりましょう」。"},{"ref":"Matt.27.65","start":40027065,"end":40027065,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[12,2,"ばんにん"],[20,1,"い"],[26,1,"かぎ"],[29,1,"ばん"]],"text":"ピラトは彼らに言った、「番人がいるから、行ってできる限り、番をさせるがよい」。"},{"ref":"Matt.27.66","start":40027066,"end":40027066,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[10,1,"いし"],[12,2,"ふういん"],[17,2,"ばんにん"],[20,1,"お"],[23,1,"はか"],[25,1,"ばん"]],"text":"そこで、彼らは行って石に封印をし、番人を置いて墓の番をさせた。"}]