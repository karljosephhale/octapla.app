[{"ref":"Ps.1.1","start":19001001,"end":19001001,"break":"paragraph","breaks":[[15,"line"],[25,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[11,1,"あゆ"],[15,1,"つみ"],[19,1,"みち"],[21,1,"た"],[29,1,"もの"],[31,1,"ざ"],[37,1,"ひと"]],"text":"悪しき者のはかりごとに歩まず、罪びとの道に立たず、あざける者の座にすわらぬ人はさいわいである。"},{"ref":"Ps.1.2","start":19001002,"end":19001002,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"ひと"],[7,1,"しゅ"],[18,1,"ひる"],[20,1,"よる"],[28,1,"おも"]],"text":"このような人は主のおきてをよろこび、昼も夜もそのおきてを思う。"},{"ref":"Ps.1.3","start":19001003,"end":19001003,"break":"line","breaks":[[21,"line"],[31,"line"],[44,"line"]],"ruby":[[5,1,"ひと"],[7,1,"なが"],[14,1,"う"],[19,1,"き"],[21,1,"とき"],[23,1,"く"],[26,1,"み"],[28,1,"むす"],[33,1,"は"],[52,1,"みな"],[53,1,"さか"]],"text":"このような人は流れのほとりに植えられた木の時が来ると実を結び、その葉もしぼまないように、そのなすところは皆栄える。"},{"ref":"Ps.1.4","start":19001004,"end":19001004,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[11,1,"かぜ"],[13,1,"ふ"],[15,1,"さ"]],"text":"悪しき者はそうでない、風の吹き去るもみがらのようだ。"},{"ref":"Ps.1.5","start":19001005,"end":19001005,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"あ"],[8,1,"もの"],[14,1,"た"],[19,1,"つみ"],[23,1,"ただ"],[26,1,"もの"],[32,1,"た"]],"text":"それゆえ、悪しき者はさばきに耐えない。罪びとは正しい者のつどいに立つことができない。"},{"ref":"Ps.1.6","start":19001006,"end":19001006,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ただ"],[5,1,"もの"],[7,1,"みち"],[9,1,"し"],[18,1,"あ"],[21,1,"もの"],[23,1,"みち"],[25,1,"ほろ"]],"text":"主は正しい者の道を知られる。しかし、悪しき者の道は滅びる。"}]