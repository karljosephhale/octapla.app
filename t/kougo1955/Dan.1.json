[{"ref":"Dan.1.1","start":27001001,"end":27001001,"break":"paragraph","ruby":[[3,1,"おう"],[10,2,"ちせい"],[13,1,"だい"],[15,1,"ねん"],[22,1,"おう"],[43,1,"せ"],[45,1,"かこ"]],"text":"ユダの王エホヤキムの治世の第三年にバビロンの王ネブカデネザルはエルサレムにきて、これを攻め囲んだ。"},{"ref":"Dan.1.2","start":27001002,"end":27001002,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"おう"],[13,1,"かみ"],[15,1,"みや"],[17,2,"きぐ"],[20,2,"いちぶ"],[25,1,"かれ"],[27,1,"て"],[37,1,"かれ"],[46,1,"ち"],[48,2,"じぶん"],[51,1,"かみ"],[53,1,"みや"],[55,1,"たずさ"],[62,2,"きぐ"],[65,2,"じぶん"],[68,1,"かみ"],[70,1,"くら"],[72,1,"おさ"]],"text":"主はユダの王エホヤキムと、神の宮の器具の一部とを、彼の手にわたされたので、彼はこれをシナルの地の自分の神の宮に携えゆき、その器具を自分の神の蔵に納めた。"},{"ref":"Dan.1.3","start":27001003,"end":27001003,"break":"none","ruby":[[0,1,"とき"],[2,1,"おう"],[4,2,"かんがん"],[7,1,"ちょう"],[21,2,"ひとびと"],[24,1,"なか"],[28,1,"おう"],[30,2,"けっとう"],[33,1,"もの"],[36,2,"きぞく"],[40,1,"もの"],[41,2,"すうにん"],[46,1,"つ"],[49,1,"く"],[54,1,"めい"]],"text":"時に王は宦官の長アシペナズに、イスラエルの人々の中から、王の血統の者と、貴族たる者数人とを、連れて来るように命じた。"},{"ref":"Dan.1.4","start":27001004,"end":27001004,"break":"none","ruby":[[4,1,"み"],[6,1,"きず"],[11,2,"ようし"],[14,1,"うつく"],[22,2,"ちえ"],[29,2,"ちしき"],[36,2,"しりょ"],[38,1,"ふか"],[41,1,"おう"],[43,1,"みや"],[45,1,"つか"],[49,1,"た"],[51,2,"わかもの"],[54,1,"つ"],[71,2,"ぶんがく"],[74,2,"げんご"],[78,1,"まな"]],"text":"すなわち身に傷がなく、容姿が美しく、すべての知恵にさとく、知識があって、思慮深く、王の宮に仕えるに足る若者を連れてこさせ、これにカルデヤびとの文学と言語とを学ばせようとした。"},{"ref":"Dan.1.5","start":27001005,"end":27001005,"break":"none","ruby":[[3,1,"おう"],[5,1,"おう"],[7,1,"た"],[10,2,"しょくもつ"],[14,1,"おう"],[16,1,"の"],[18,1,"さけ"],[20,1,"なか"],[24,2,"ひび"],[27,1,"ぶん"],[29,1,"かれ"],[32,1,"あた"],[37,1,"ねん"],[42,1,"かれ"],[45,1,"やしな"],[47,1,"そだ"],[52,1,"のち"],[54,1,"かれ"],[59,1,"おう"],[61,1,"まえ"]],"text":"そして王は王の食べる食物と、王の飲む酒の中から、日々の分を彼らに与えて、三年のあいだ彼らを養い育て、その後、彼らをして王の前に、はべらせようとした。"},{"ref":"Dan.1.6","start":27001006,"end":27001006,"break":"none","ruby":[[0,1,"かれ"],[10,2,"ぶぞく"]],"text":"彼らのうちに、ユダの部族のダニエル、ハナニヤ、ミシャエル、アザリヤがあった。"},{"ref":"Dan.1.7","start":27001007,"end":27001007,"break":"none","ruby":[[0,2,"かんがん"],[3,1,"ちょう"],[5,1,"かれ"],[8,1,"な"],[10,1,"あた"],[27,1,"な"],[42,1,"な"],[57,1,"な"],[72,1,"な"]],"text":"宦官の長は彼らに名を与えて、ダニエルをベルテシャザルと名づけ、ハナニヤをシャデラクと名づけ、ミシャエルをメシャクと名づけ、アザリヤをアベデネゴと名づけた。"},{"ref":"Dan.1.8","start":27001008,"end":27001008,"break":"paragraph","ruby":[[5,1,"おう"],[7,2,"しょくもつ"],[11,1,"おう"],[13,1,"の"],[15,1,"さけ"],[22,2,"じぶん"],[25,1,"けが"],[31,1,"こころ"],[33,1,"おも"],[35,1,"さだ"],[41,2,"じぶん"],[44,1,"けが"],[57,2,"かんがん"],[60,1,"ちょう"],[62,1,"もと"]],"text":"ダニエルは王の食物と、王の飲む酒とをもって、自分を汚すまいと、心に思い定めたので、自分を汚させることのないように、宦官の長に求めた。"},{"ref":"Dan.1.9","start":27001009,"end":27001009,"break":"none","ruby":[[0,1,"かみ"],[10,2,"かんがん"],[13,1,"ちょう"],[15,1,"まえ"],[18,1,"めぐ"],[27,1,"え"]],"text":"神はダニエルをして、宦官の長の前に、恵みとあわれみとを得させられたので、"},{"ref":"Dan.1.10","start":27001010,"end":27001010,"break":"none","ruby":[[0,2,"かんがん"],[3,1,"ちょう"],[10,1,"い"],[17,1,"しゅ"],[20,1,"おう"],[29,1,"た"],[31,1,"もの"],[34,1,"の"],[36,1,"もの"],[39,1,"さだ"],[57,2,"けんこう"],[60,2,"じょうたい"],[64,3,"どうねんぱい"],[68,2,"わかもの"],[75,1,"わる"],[79,1,"おう"],[81,1,"み"],[88,1,"おそ"],[119,1,"おう"],[121,1,"まえ"],[123,1,"あやう"]],"text":"宦官の長はダニエルに言った、「わが主なる王は、あなたがたの食べ物と、飲み物とを定められたので、わたしはあなたがたの健康の状態が、同年輩の若者たちよりも悪いと、王が見られることを恐れるのです。そうすればあなたがたのために、わたしのこうべが、王の前に危くなるでしょう」。"},{"ref":"Dan.1.11","start":27001011,"end":27001011,"break":"none","ruby":[[8,2,"かんがん"],[11,1,"ちょう"],[36,1,"うえ"],[38,1,"た"],[41,2,"かれい"],[44,1,"い"]],"text":"そこでダニエルは宦官の長がダニエル、ハナニヤ、ミシャエルおよびアザリヤの上に立てた家令に言った、"},{"ref":"Dan.1.12","start":27001012,"end":27001012,"break":"none","ruby":[[11,1,"か"],[13,1,"あいだ"],[31,2,"やさい"],[34,1,"あた"],[37,1,"た"],[42,1,"みず"],[44,1,"の"]],"text":"「どうぞ、しもべらを十日の間ためしてください。わたしたちにただ野菜を与えて食べさせ、水を飲ませ、"},{"ref":"Dan.1.13","start":27001013,"end":27001013,"break":"none","ruby":[[9,2,"かおいろ"],[13,1,"おう"],[15,2,"しょくもつ"],[18,1,"た"],[21,2,"わかもの"],[24,2,"かおいろ"],[32,1,"み"],[39,1,"み"],[56,1,"あつか"]],"text":"そしてわたしたちの顔色と、王の食物を食べる若者の顔色とをくらべて見て、あなたの見るところにしたがって、しもべらを扱ってください」。"},{"ref":"Dan.1.14","start":27001014,"end":27001014,"break":"none","ruby":[[0,2,"かれい"],[5,1,"こと"],[10,1,"かれ"],[13,1,"い"],[19,1,"き"],[25,1,"か"],[27,1,"あいだ"],[29,1,"かれ"]],"text":"家令はこの事について彼らの言うところを聞きいれ、十日の間、彼らをためした。"},{"ref":"Dan.1.15","start":27001015,"end":27001015,"break":"none","ruby":[[1,1,"か"],[3,1,"おわ"],[13,1,"かれ"],[16,2,"かおいろ"],[19,1,"おう"],[21,2,"しょくもつ"],[24,1,"た"],[31,2,"わかもの"],[36,1,"うつく"],[42,1,"にく"],[44,1,"こ"],[46,1,"ふと"]],"text":"十日の終りになってみると、彼らの顔色は王の食物を食べたすべての若者よりも美しく、また肉も肥え太っていた。"},{"ref":"Dan.1.16","start":27001016,"end":27001016,"break":"none","ruby":[[3,2,"かれい"],[6,1,"かれ"],[9,2,"しょくもつ"],[13,1,"かれ"],[16,1,"の"],[20,1,"さけ"],[23,1,"のぞ"],[27,1,"かれ"],[30,2,"やさい"],[33,1,"あた"]],"text":"それで家令は彼らの食物と、彼らの飲むべき酒とを除いて、彼らに野菜を与えた。"},{"ref":"Dan.1.17","start":27001017,"end":27001017,"break":"paragraph","ruby":[[3,1,"にん"],[5,1,"もの"],[9,1,"かみ"],[11,2,"ちしき"],[14,1,"あた"],[21,2,"ぶんがく"],[24,2,"ちえ"],[30,1,"もの"],[47,1,"まぼろし"],[49,1,"ゆめ"],[52,2,"りかい"]],"text":"この四人の者には、神は知識を与え、すべての文学と知恵にさとい者とされた。ダニエルはまたすべての幻と夢とを理解した。"},{"ref":"Dan.1.18","start":27001018,"end":27001018,"break":"none","ruby":[[3,1,"おう"],[5,1,"めい"],[12,2,"わかもの"],[15,1,"め"],[17,1,"い"],[23,2,"にっすう"],[26,1,"す"],[32,2,"かんがん"],[35,1,"まち"],[37,1,"かれ"],[48,1,"まえ"],[50,1,"つ"]],"text":"さて、王が命じたところの若者を召し入れるまでの日数が過ぎたので、宦官の町は彼らをネブカデネザルの前に連れていった。"},{"ref":"Dan.1.19","start":27001019,"end":27001019,"break":"none","ruby":[[0,1,"おう"],[2,1,"かれ"],[5,1,"かた"],[12,1,"かれ"],[18,1,"なか"],[45,1,"もの"],[54,1,"かれ"],[57,1,"おう"],[59,1,"まえ"]],"text":"王が彼らと語ってみると、彼らすべての中にはダニエル、ハナニヤ、ミシャエル、アザリヤにならぶ者がなかったので、彼らは王の前にはべることとなった。"},{"ref":"Dan.1.20","start":27001020,"end":27001020,"break":"none","ruby":[[0,1,"おう"],[2,1,"かれ"],[10,1,"こと"],[12,1,"たず"],[19,1,"かれ"],[22,2,"ちえ"],[25,2,"りかい"],[32,2,"ぜんこく"],[35,2,"はかせ"],[38,1,"ほう"],[39,1,"じゅつ"],[40,1,"し"],[48,1,"ばい"]],"text":"王が彼らにさまざまの事を尋ねてみると、彼らは知恵と理解において、全国の博士、法術士にまさること十倍であった。"},{"ref":"Dan.1.21","start":27001021,"end":27001021,"break":"none","ruby":[[8,1,"おう"],[10,2,"がんねん"],[14,1,"つか"]],"text":"ダニエルはクロス王の元年まで仕えていた。"}]