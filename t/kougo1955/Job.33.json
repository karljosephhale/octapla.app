[{"ref":"Job.33.1","start":18033001,"end":18033001,"break":"paragraph","breaks":[[21,"line"]],"ruby":[[8,1,"いま"],[13,1,"い"],[18,1,"き"],[29,2,"ことば"],[32,1,"みみ"],[34,1,"かたむ"]],"text":"だから、ヨブよ、今わたしの言うことを聞け、わたしのすべての言葉に耳を傾けよ。"},{"ref":"Job.33.2","start":18033002,"end":18033002,"break":"line","ruby":[[0,1,"み"],[7,1,"くち"],[9,1,"ひら"],[12,1,"くち"],[14,1,"なか"],[16,1,"した"],[18,2,"ものい"]],"text":"見よ、わたしは口を開き、口の中の舌は物言う。"},{"ref":"Job.33.3","start":18033003,"end":18033003,"break":"line","breaks":[[18,"line"]],"ruby":[[4,2,"ことば"],[9,1,"こころ"],[11,1,"ただ"],[15,1,"かた"],[27,2,"しんじつ"],[35,2,"ちしき"],[38,1,"かた"]],"text":"わたしの言葉はわが心の正しきを語り、わたしのくちびるは真実をもってその知識を語る。"},{"ref":"Job.33.4","start":18033004,"end":18033004,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かみ"],[2,1,"れい"],[8,1,"つく"],[11,3,"ぜんのうしゃ"],[15,1,"いき"],[21,1,"い"]],"text":"神の霊はわたしを造り、全能者の息はわたしを生かす。"},{"ref":"Job.33.5","start":18033005,"end":18033005,"break":"line","breaks":[[20,"line"]],"ruby":[[16,1,"こた"],[24,1,"まえ"],[26,2,"ことば"],[29,1,"ととの"],[33,1,"た"]],"text":"あなたがもしできるなら、わたしに答えよ、わたしの前に言葉を整えて、立て。"},{"ref":"Job.33.6","start":18033006,"end":18033006,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[5,1,"たい"],[18,2,"どうよう"],[30,1,"つち"],[33,1,"と"],[36,1,"つく"],[40,1,"もの"]],"text":"見よ、神に対しては、わたしもあなたと同様であり、わたしもまた土から取って造られた者だ。"},{"ref":"Job.33.7","start":18033007,"end":18033007,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"み"],[7,2,"いげん"],[14,1,"おそ"],[25,1,"いきお"],[32,1,"あっ"]],"text":"見よ、わたしの威厳はあなたを恐れさせない、わたしの勢いはあなたを圧しない。"},{"ref":"Job.33.8","start":18033008,"end":18033008,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"たし"],[12,1,"き"],[18,1,"い"],[30,2,"ことば"],[33,1,"こえ"],[35,1,"き"]],"text":"確かに、あなたはわたしの聞くところで言った、わたしはあなたの言葉の声を聞いた。"},{"ref":"Job.33.9","start":18033009,"end":18033009,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"い"],[28,1,"きよ"],[31,2,"ふぎ"]],"text":"あなたは言う、『わたしはいさぎよく、とがはない。わたしは清く、不義はない。"},{"ref":"Job.33.10","start":18033010,"end":18033010,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[9,1,"せ"],[12,2,"こうじつ"],[15,1,"み"],[23,2,"じぶん"],[26,1,"てき"]],"text":"見よ、彼はわたしを攻める口実を見つけ、わたしを自分の敵とみなし、"},{"ref":"Job.33.11","start":18033011,"end":18033011,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"あし"],[20,1,"おこな"],[23,1,"め"]],"text":"わたしの足をかせにはめ、わたしのすべての行いに目をとめられる』と。"},{"ref":"Job.33.12","start":18033012,"end":18033012,"break":"stanza","breaks":[[15,"line"],[32,"line"]],"ruby":[[0,1,"み"],[11,1,"こた"],[21,1,"こと"],[26,1,"ただ"],[32,1,"かみ"],[34,1,"ひと"],[38,1,"おお"],[42,1,"もの"]],"text":"見よ、わたしはあなたに答える、あなたはこの事において正しくない。神は人よりも大いなる者だ。"},{"ref":"Job.33.13","start":18033013,"end":18033013,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[5,1,"かれ"],[11,2,"ことば"],[14,1,"すこ"],[17,1,"こた"],[29,1,"かれ"],[31,1,"む"],[35,1,"い"],[37,1,"あらそ"]],"text":"あなたが『彼はわたしの言葉に少しも答えられない』といって、彼に向かって言い争うのは、どういうわけであるか。"},{"ref":"Job.33.14","start":18033014,"end":18033014,"break":"line","breaks":[[15,"line"],[34,"line"]],"ruby":[[0,1,"かみ"],[5,2,"ほうほう"],[11,1,"かた"],[20,2,"ほうほう"],[26,1,"かた"],[34,1,"ひと"],[39,1,"さと"]],"text":"神は一つの方法によって語られ、また二つの方法によって語られるのだが、人はそれを悟らないのだ。"},{"ref":"Job.33.15","start":18033015,"end":18033015,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"ひとびと"],[3,2,"じゅくすい"],[13,1,"とこ"],[22,1,"ゆめ"],[27,1,"よる"],[29,1,"まぼろし"]],"text":"人々が熟睡するとき、または床にまどろむとき、夢あるいは夜の幻のうちで、"},{"ref":"Job.33.16","start":18033016,"end":18033016,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"かれ"],[2,2,"ひとびと"],[5,1,"みみ"],[7,1,"ひら"],[10,2,"けいこく"],[16,1,"かれ"],[19,1,"おそ"]],"text":"彼は人々の耳を開き、警告をもって彼らを恐れさせ、"},{"ref":"Job.33.17","start":18033017,"end":18033017,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"ひと"],[8,1,"あ"],[14,1,"はな"],[19,1,"たか"],[23,1,"ひと"],[26,1,"のぞ"]],"text":"こうして人にその悪しきわざを離れさせ、高ぶりを人から除き、"},{"ref":"Job.33.18","start":18033018,"end":18033018,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"たましい"],[4,1,"まも"],[8,1,"はか"],[10,1,"いた"],[17,1,"いのち"],[19,1,"まも"],[27,1,"ほろ"]],"text":"その魂を守って、墓に至らせず、その命を守って、つるぎに滅びないようにされる。"},{"ref":"Job.33.19","start":18033019,"end":18033019,"break":"stanza","breaks":[[21,"line"]],"ruby":[[0,1,"ひと"],[6,1,"とこ"],[8,1,"うえ"],[10,1,"いた"],[16,1,"こ"],[23,1,"ほね"],[25,1,"たたか"],[28,1,"た"]],"text":"人はまたその床の上で痛みによって懲らされ、その骨に戦いが絶えることなく、"},{"ref":"Job.33.20","start":18033020,"end":18033020,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"いのち"],[5,2,"しょくもつ"],[14,2,"しょくよく"],[22,2,"しょくもつ"]],"text":"その命は、食物をいとい、その食欲は、おいしい食物をきらう。"},{"ref":"Job.33.21","start":18033021,"end":18033021,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"にく"],[6,1,"お"],[9,1,"み"],[15,1,"ほね"],[17,1,"み"]],"text":"その肉はやせ落ちて見えず、その骨は見えなかったものまでもあらわになり、"},{"ref":"Job.33.22","start":18033022,"end":18033022,"break":"line","ruby":[[2,1,"たましい"],[4,1,"はか"],[6,1,"ちか"],[12,1,"いのち"],[14,1,"ほろ"],[17,1,"もの"],[19,1,"ちか"]],"text":"その魂は墓に近づき、その命は滅ぼす者に近づく。"},{"ref":"Job.33.23","start":18033023,"end":18033023,"break":"line","breaks":[[20,"line"],[39,"line"]],"ruby":[[5,1,"かれ"],[14,2,"てんし"],[33,2,"ちゅうほ"],[39,1,"ひと"],[43,1,"ただ"],[46,1,"みち"],[48,1,"しめ"]],"text":"もしそこに彼のためにひとりの天使があり、千のうちのひとりであって、仲保となり、人にその正しい道を示すならば、"},{"ref":"Job.33.24","start":18033024,"end":18033024,"break":"line","breaks":[[14,"line"],[34,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[9,1,"い"],[15,1,"かれ"],[17,1,"すく"],[21,1,"はか"],[23,1,"くだ"],[28,1,"まぬか"],[48,1,"え"]],"text":"神は彼をあわれんで言われる、『彼を救って、墓に下ることを免れさせよ、わたしはすでにあがないしろを得た。"},{"ref":"Job.33.25","start":18033025,"end":18033025,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[2,1,"にく"],[4,1,"おさ"],[6,1,"ご"],[8,1,"にく"],[22,1,"かれ"],[24,1,"わか"],[26,1,"とき"],[28,2,"げんき"],[31,1,"かえ"]],"text":"彼の肉を幼な子の肉よりもみずみずしくならせ、彼を若い時の元気に帰らせよ』と。"},{"ref":"Job.33.26","start":18033026,"end":18033026,"break":"line","breaks":[[21,"line"],[36,"line"]],"ruby":[[2,1,"とき"],[4,1,"かれ"],[6,1,"かみ"],[8,1,"いの"],[14,1,"かみ"],[16,1,"かれ"],[18,1,"かえり"],[21,1,"よろこ"],[29,1,"まえ"],[38,1,"すくい"],[40,1,"ひと"],[42,1,"つ"],[44,1,"し"]],"text":"その時、彼が神に祈るならば、神は彼を顧み、喜びをもって、み前にいたらせ、その救を人に告げ知らせられる。"},{"ref":"Job.33.27","start":18033027,"end":18033027,"break":"line","breaks":[[13,"line"],[32,"line"]],"ruby":[[0,1,"かれ"],[2,2,"ひとびと"],[5,1,"まえ"],[7,1,"うた"],[10,1,"い"],[18,1,"つみ"],[20,1,"おか"],[23,1,"ただ"],[26,1,"こと"],[28,1,"ま"],[39,2,"ほうふく"]],"text":"彼は人々の前に歌って言う、『わたしは罪を犯し、正しい事を曲げた。しかしわたしに報復がなかった。"},{"ref":"Job.33.28","start":18033028,"end":18033028,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[0,1,"かれ"],[6,1,"たましい"],[14,1,"はか"],[16,1,"くだ"],[30,1,"いのち"],[32,1,"ひかり"],[34,1,"み"]],"text":"彼はわたしの魂をあがなって、墓に下らせられなかった。わたしの命は光を見ることができる』と。"},{"ref":"Job.33.29","start":18033029,"end":18033029,"break":"stanza","breaks":[[14,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[12,1,"こと"],[22,1,"ひと"],[24,1,"おこな"]],"text":"見よ、神はこれらすべての事をふたたび、みたび人に行い、"},{"ref":"Job.33.30","start":18033030,"end":18033030,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"たましい"],[4,1,"はか"],[7,1,"ひ"],[9,1,"かえ"],[12,1,"かれ"],[14,1,"いのち"],[16,1,"ひかり"],[18,1,"み"]],"text":"その魂を墓から引き返し、彼に命の光を見させられる。"},{"ref":"Job.33.31","start":18033031,"end":18033031,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"みみ"],[6,1,"かたむ"],[13,1,"き"],[16,1,"もく"],[24,1,"かた"]],"text":"ヨブよ、耳を傾けてわたしに聞け、黙せよ、わたしは語ろう。"},{"ref":"Job.33.32","start":18033032,"end":18033032,"break":"line","breaks":[[18,"line"],[26,"line"],[46,"line"]],"ruby":[[6,1,"い"],[22,1,"こた"],[26,1,"かた"],[37,1,"ただ"],[40,1,"もの"],[46,1,"のぞ"]],"text":"あなたがもし言うべきことがあるなら、わたしに答えよ、語れ、わたしはあなたを正しい者にしようと望むからだ。"},{"ref":"Job.33.33","start":18033033,"end":18033033,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"かた"],[16,1,"き"],[19,1,"もく"],[31,2,"ちえ"],[34,1,"おし"]],"text":"もし語ることがないなら、わたしに聞け、黙せよ、わたしはあなたに知恵を教えよう」。"}]