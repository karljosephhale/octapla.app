[{"ref":"Amos.2.1","start":30002001,"end":30002001,"break":"paragraph","breaks":[[9,"line"],[20,"line"],[30,"line"],[46,"line"],[62,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[37,1,"ばっ"],[49,1,"かれ"],[55,1,"おう"],[57,1,"ほね"],[59,1,"や"],[62,1,"はい"]],"text":"主はこう言われる、「モアブの三つのとが、四つのとがのために、わたしはこれを罰してゆるさない。これは彼がエドムの王の骨を焼いて灰にしたからである。"},{"ref":"Amos.2.2","start":30002002,"end":30002002,"break":"line","breaks":[[18,"line"],[37,"line"],[51,"line"]],"ruby":[[13,1,"ひ"],[15,1,"おく"],[28,2,"きゅうでん"],[31,1,"や"],[33,1,"ほろ"],[41,1,"さわ"],[48,1,"こえ"],[55,1,"おと"],[57,1,"なか"],[59,1,"し"]],"text":"それゆえ、わたしはモアブに火を送り、ケリオテのもろもろの宮殿を焼き滅ぼす。モアブは騒ぎと、ときの声と、ラッパの音の中に死ぬ。"},{"ref":"Amos.2.3","start":30002003,"end":30002003,"break":"line","breaks":[[18,"line"],[36,"line"]],"ruby":[[11,3,"しはいしゃ"],[15,1,"た"],[28,1,"かれ"],[30,1,"とも"],[32,1,"ころ"],[36,1,"しゅ"],[38,1,"い"]],"text":"わたしはそのうちから、支配者を断ち、そのすべてのつかさを彼と共に殺す」と主は言われる。"},{"ref":"Amos.2.4","start":30002004,"end":30002004,"break":"stanza","breaks":[[9,"line"],[19,"line"],[29,"line"],[45,"line"],[68,"line"],[80,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[36,1,"ばっ"],[48,1,"かれ"],[51,1,"しゅ"],[53,2,"りっぽう"],[56,1,"す"],[61,1,"さだ"],[64,1,"まも"],[70,2,"せんぞ"],[75,1,"したが"],[77,1,"ある"],[80,1,"いつわ"],[83,1,"もの"],[85,1,"まど"]],"text":"主はこう言われる、「ユダの三つのとが、四つのとがのために、わたしはこれを罰してゆるさない。これは彼らが主の律法を捨て、その定めを守らず、その先祖たちが従い歩いた偽りの物に惑わされたからである。"},{"ref":"Amos.2.5","start":30002005,"end":30002005,"break":"line","breaks":[[17,"line"]],"ruby":[[12,1,"ひ"],[14,1,"おく"],[28,2,"きゅうでん"],[31,1,"や"],[33,1,"ほろ"]],"text":"それゆえ、わたしはユダに火を送り、エルサレムのもろもろの宮殿を焼き滅ぼす」。"},{"ref":"Amos.2.6","start":30002006,"end":30002006,"break":"stanza","breaks":[[9,"line"],[22,"line"],[32,"line"],[48,"line"],[67,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[39,1,"ばっ"],[51,1,"かれ"],[54,1,"ただ"],[57,1,"もの"],[59,1,"かね"],[64,1,"う"],[67,1,"まず"],[70,1,"もの"],[75,1,"そく"],[80,1,"う"]],"text":"主はこう言われる、「イスラエルの三つのとが、四つのとがのために、わたしはこれを罰してゆるさない。これは彼らが正しい者を金のために売り、貧しい者をくつ一足のために売るからである。"},{"ref":"Amos.2.7","start":30002007,"end":30002007,"break":"line","breaks":[[19,"line"],[29,"line"],[50,"line"]],"ruby":[[0,1,"かれ"],[3,1,"よわ"],[5,1,"もの"],[7,1,"あたま"],[9,1,"ち"],[14,1,"ふ"],[19,1,"くる"],[22,1,"もの"],[24,1,"みち"],[31,2,"ふし"],[40,1,"おんな"],[46,1,"い"],[52,1,"せい"],[55,1,"な"],[57,1,"けが"]],"text":"彼らは弱い者の頭を地のちりに踏みつけ、苦しむ者の道をまげ、また父子ともにひとりの女のところへ行って、わが聖なる名を汚す。"},{"ref":"Amos.2.8","start":30002008,"end":30002008,"break":"line","breaks":[[15,"line"],[34,"line"]],"ruby":[[0,1,"かれ"],[7,2,"さいだん"],[15,1,"しち"],[17,1,"と"],[20,2,"いふく"],[23,1,"し"],[29,1,"うえ"],[31,1,"ふ"],[34,2,"ばっきん"],[40,1,"え"],[42,1,"さけ"],[47,1,"かみ"],[49,1,"いえ"],[51,1,"の"]],"text":"彼らはすべての祭壇のかたわらに質に取った衣服を敷いて、その上に伏し、罰金をもって得た酒を、その神の家で飲む。"},{"ref":"Amos.2.9","start":30002009,"end":30002009,"break":"stanza","breaks":[[13,"line"],[24,"line"],[41,"line"],[61,"line"]],"ruby":[[13,1,"かれ"],[16,1,"まえ"],[19,1,"ほろ"],[29,1,"たか"],[34,2,"こうはく"],[43,1,"つよ"],[51,1,"き"],[67,1,"うえ"],[69,1,"み"],[72,1,"した"],[74,1,"ね"],[77,1,"ほろ"]],"text":"さきにわたしはアモリびとを彼らの前から滅ぼした。これはその高きこと、香柏のごとく、その強きこと、かしの木のようであったが、わたしはその上の実と、下の根とを滅ぼした。"},{"ref":"Amos.2.10","start":30002010,"end":30002010,"break":"line","breaks":[[13,"line"],[26,"line"],[46,"line"]],"ruby":[[18,1,"ち"],[21,1,"つ"],[23,1,"のぼ"],[28,1,"ねん"],[33,2,"あらの"],[43,1,"みちび"],[52,1,"ち"],[54,1,"え"]],"text":"わたしはまた、あなたがたをエジプトの地から連れ上り、四十年のあいだ荒野で、あなたがたを導き、アモリびとの地を獲させた。"},{"ref":"Amos.2.11","start":30002011,"end":30002011,"break":"line","breaks":[[17,"line"],[24,"line"],[47,"line"],[66,"line"]],"ruby":[[10,1,"こ"],[17,3,"よげんしゃ"],[21,1,"おこ"],[30,2,"わかもの"],[43,1,"おこ"],[53,2,"ひとびと"],[66,1,"しゅ"],[68,1,"い"]],"text":"わたしはあなたがたの子らのうちから預言者を起し、あなたがたの若者のうちからナジルびとを起した。イスラエルの人々よ、そうではないか」と主は言われる。"},{"ref":"Amos.2.12","start":30002012,"end":30002012,"break":"line","breaks":[[23,"line"]],"ruby":[[17,1,"さけ"],[19,1,"の"],[23,3,"よげんしゃ"],[27,1,"めい"],[31,2,"よげん"],[38,1,"い"]],"text":"「ところがあなたがたはナジルびとに酒を飲ませ、預言者に命じて『預言するな』と言う。"},{"ref":"Amos.2.13","start":30002013,"end":30002013,"break":"line","breaks":[[19,"line"],[28,"line"]],"ruby":[[0,1,"み"],[7,1,"むぎ"],[8,1,"たば"],[14,1,"つ"],[17,1,"くるま"],[19,1,"もの"],[21,1,"あっ"],[36,1,"ところ"],[38,1,"あっ"]],"text":"見よ、わたしは麦束をいっぱい積んだ車が物を圧するように、あなたがたをその所で圧する。"},{"ref":"Amos.2.14","start":30002014,"end":30002014,"break":"line","breaks":[[13,"line"],[31,"line"]],"ruby":[[0,1,"はや"],[2,1,"はし"],[4,1,"もの"],[6,1,"に"],[8,1,"ば"],[10,1,"うしな"],[13,1,"つよ"],[15,1,"もの"],[19,1,"ちから"],[31,2,"ゆうし"],[36,1,"いのち"],[38,1,"すく"]],"text":"速く走る者も逃げ場を失い、強い者もその力をふるうことができず、勇士もその命を救うことができない。"},{"ref":"Amos.2.15","start":30002015,"end":30002015,"break":"line","breaks":[[15,"line"],[32,"line"]],"ruby":[[0,1,"ゆみ"],[4,1,"もの"],[6,1,"た"],[15,2,"あしばや"],[18,1,"もの"],[20,2,"じぶん"],[23,1,"すく"],[32,1,"うま"],[34,1,"の"],[36,1,"もの"],[40,1,"いのち"],[42,1,"すく"]],"text":"弓をとる者も立つことができず、足早の者も自分を救うことができず、馬に乗る者もその命を救うことができない。"},{"ref":"Amos.2.16","start":30002016,"end":30002016,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[0,2,"ゆうし"],[6,2,"おお"],[10,1,"こころ"],[12,1,"もの"],[16,1,"ひ"],[19,1,"はだか"],[21,1,"に"],[26,1,"しゅ"],[28,1,"い"]],"text":"勇士のうちの雄々しい心の者もその日には裸で逃げる」と主は言われる。"}]