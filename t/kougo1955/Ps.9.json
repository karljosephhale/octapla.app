[{"ref":"Ps.9.1","start":19009001,"end":19009001,"break":"paragraph","title":"聖歌隊の指揮者によってムツラベンのしらべにあわせてうたわせたダビデの歌","breaks":[[16,"line"],[28,"line"]],"ruby":[[4,1,"こころ"],[10,1,"しゅ"],[12,2,"かんしゃ"],[33,1,"の"],[35,1,"つた"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[34,1,"うた"]],"text":"わたしは心をつくして主に感謝し、あなたのくすしきみわざをことごとく宣べ伝えます。"},{"ref":"Ps.9.2","start":19009002,"end":19009002,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[2,1,"たか"],[4,1,"もの"],[18,1,"よろこ"],[22,1,"たの"],[30,1,"な"],[34,1,"うた"]],"text":"いと高き者よ、あなたによってわたしは喜びかつ楽しみ、あなたの名をほめ歌います。"},{"ref":"Ps.9.3","start":19009003,"end":19009003,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"てき"],[6,1,"しりぞ"],[15,1,"たお"],[22,1,"まえ"],[24,1,"ほろ"]],"text":"わたしの敵は退くとき、つまずき倒れてあなたの前に滅びました。"},{"ref":"Ps.9.4","start":19009004,"end":19009004,"break":"line","breaks":[[14,"line"],[25,"line"],[37,"line"]],"ruby":[[8,1,"ただ"],[11,1,"うった"],[14,1,"たす"],[16,1,"まも"],[33,1,"ざ"],[37,1,"ただ"]],"text":"あなたがわたしの正しい訴えを助け守られたからです。あなたはみくらに座して、正しいさばきをされました。"},{"ref":"Ps.9.5","start":19009005,"end":19009005,"break":"line","breaks":[[15,"line"],[24,"line"]],"ruby":[[9,2,"くにたみ"],[12,1,"せ"],[15,1,"あ"],[18,1,"もの"],[20,1,"ほろ"],[24,2,"えいきゅう"],[27,1,"かれ"],[30,1,"な"],[32,1,"け"],[34,1,"さ"]],"text":"あなたはもろもろの国民を責め、悪しき者を滅ぼし、永久に彼らの名を消し去られました。"},{"ref":"Ps.9.6","start":19009006,"end":19009006,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[0,1,"てき"],[2,1,"た"],[13,1,"ほろ"],[20,1,"ほろ"],[30,1,"まち"],[34,2,"きおく"],[38,1,"き"]],"text":"敵は絶えはてて、とこしえに滅び、あなたが滅ぼされたもろもろの町はその記憶さえ消えうせました。"},{"ref":"Ps.9.7","start":19009007,"end":19009007,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"しゅ"],[12,1,"くらい"],[14,1,"ざ"],[29,1,"もう"]],"text":"しかし主はとこしえに、み位に座し、さばきのために、みくらを設けられました。"},{"ref":"Ps.9.8","start":19009008,"end":19009008,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"せいぎ"],[8,2,"せかい"],[15,2,"こうへい"],[26,1,"たみ"]],"text":"主は正義をもって世界をさばき、公平をもってもろもろの民をさばかれます。"},{"ref":"Ps.9.9","start":19009009,"end":19009009,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"もの"],[19,1,"とき"]],"text":"主はしえたげられる者のとりで、なやみの時のとりでです。"},{"ref":"Ps.9.10","start":19009010,"end":19009010,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[1,1,"な"],[3,1,"し"],[5,1,"もの"],[11,1,"よ"],[13,1,"たの"],[18,1,"しゅ"],[25,1,"たず"],[27,1,"もと"],[30,1,"もの"],[36,1,"す"]],"text":"み名を知る者はあなたに寄り頼みます。主よ、あなたを尋ね求める者をあなたは捨てられたことがないからです。"},{"ref":"Ps.9.11","start":19009011,"end":19009011,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"す"],[9,1,"しゅ"],[32,1,"たみ"],[37,1,"の"],[39,1,"つた"]],"text":"シオンに住まわれる主にむかってほめうたい、そのみわざをもろもろの民のなかに宣べ伝えよ。"},{"ref":"Ps.9.12","start":19009012,"end":19009012,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"ち"],[2,1,"なが"],[4,1,"もの"],[9,1,"むく"],[14,1,"しゅ"],[16,1,"かれ"],[19,1,"こころ"],[24,1,"くる"],[27,1,"もの"],[29,1,"さけ"],[33,1,"わす"]],"text":"血を流す者にあだを報いられる主は彼らを心にとめ、苦しむ者の叫びをお忘れにならないからです。"},{"ref":"Ps.9.13","start":19009013,"end":19009013,"break":"line","breaks":[[17,"line"],[36,"line"],[51,"line"]],"ruby":[[0,1,"しゅ"],[17,1,"し"],[19,1,"もん"],[26,1,"ひ"],[33,1,"しゅ"],[40,1,"もの"],[46,1,"なや"]],"text":"主よ、わたしをあわれんでください。死の門からわたしを引きあげられる主よ、あだする者のわたしを悩ますのをみそなわしてください。"},{"ref":"Ps.9.14","start":19009014,"end":19009014,"break":"line","breaks":[[23,"line"],[32,"line"]],"ruby":[[18,1,"ほまれ"],[20,1,"の"],[27,1,"むすめ"],[29,1,"もん"],[36,1,"すくい"],[38,1,"よろこ"]],"text":"そうすれば、わたしはあなたのすべての誉を述べ、シオンの娘の門で、あなたの救を喜ぶことができましょう。"},{"ref":"Ps.9.15","start":19009015,"end":19009015,"break":"line","breaks":[[19,"line"]],"ruby":[[5,2,"くにたみ"],[8,2,"じぶん"],[11,1,"つく"],[14,1,"あな"],[16,1,"おちい"],[19,1,"かく"],[21,1,"もう"],[24,1,"あみ"],[26,2,"じぶん"],[29,1,"あし"],[31,1,"とら"]],"text":"もろもろの国民は自分の作った穴に陥り、隠し設けた網に自分の足を捕えられる。"},{"ref":"Ps.9.16","start":19009016,"end":19009016,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"し"],[15,1,"おこな"],[20,1,"あ"],[23,1,"もの"],[25,2,"じぶん"],[28,1,"て"],[30,1,"つく"],[36,1,"とら"]],"text":"主はみずからを知らせ、さばきを行われた。悪しき者は自分の手で作ったわなに捕えられる。〔ヒガヨン、セラ"},{"ref":"Ps.9.17","start":19009017,"end":19009017,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[7,1,"かみ"],[9,1,"わす"],[17,2,"くにたみ"],[20,2,"よみ"],[23,1,"さ"],[26,1,"い"]],"text":"悪しき者、また神を忘れるもろもろの国民は陰府へ去って行く。"},{"ref":"Ps.9.18","start":19009018,"end":19009018,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[5,1,"つね"],[7,1,"わす"],[18,1,"くる"],[21,1,"もの"],[23,1,"のぞ"],[31,1,"ほろ"]],"text":"貧しい者は常に忘れられるのではない。苦しむ者の望みはとこしえに滅びるのではない。"},{"ref":"Ps.9.19","start":19009019,"end":19009019,"break":"line","breaks":[[14,"line"],[33,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"た"],[14,1,"ひと"],[16,2,"しょうり"],[19,1,"え"],[29,2,"くにたみ"],[34,1,"まえ"],[40,1,"う"]],"text":"主よ、立ちあがってください。人に勝利を得させず、もろもろの国民に、み前でさばきを受けさせてください。"},{"ref":"Ps.9.20","start":19009020,"end":19009020,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かれ"],[6,1,"おそ"],[9,1,"おこ"],[18,2,"くにたみ"],[21,2,"じぶん"],[27,1,"ひと"],[34,1,"し"]],"text":"主よ、彼らに恐れを起させ、もろもろの国民に自分がただ、人であることを知らせてください。〔セラ"}]