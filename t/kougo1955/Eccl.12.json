[{"ref":"Eccl.12.1","start":21012001,"end":21012001,"break":"paragraph","ruby":[[4,1,"わか"],[6,1,"ひ"],[13,1,"つく"],[15,1,"ぬし"],[17,1,"おぼ"],[21,1,"あ"],[24,1,"ひ"],[30,1,"とし"],[32,1,"よ"],[45,1,"たの"],[53,1,"い"],[62,1,"まえ"]],"text":"あなたの若い日に、あなたの造り主を覚えよ。悪しき日がきたり、年が寄って、「わたしにはなんの楽しみもない」と言うようにならない前に、"},{"ref":"Eccl.12.2","start":21012002,"end":21012002,"break":"none","ruby":[[2,1,"ひ"],[4,1,"ひかり"],[7,1,"つき"],[9,1,"ほし"],[11,1,"くら"],[17,1,"まえ"],[20,1,"あめ"],[22,1,"のち"],[26,1,"くも"],[28,1,"かえ"]],"text":"また日や光や、月や星の暗くならない前に、雨の後にまた雲が帰らないうちに、そのようにせよ。"},{"ref":"Eccl.12.3","start":21012003,"end":21012003,"break":"none","ruby":[[2,1,"ひ"],[8,1,"いえ"],[10,1,"まも"],[12,1,"もの"],[14,1,"ふる"],[17,1,"ちから"],[20,1,"ひと"],[31,1,"おんな"],[33,1,"すく"],[39,1,"やす"],[42,1,"まど"],[48,1,"もの"],[50,1,"め"]],"text":"その日になると、家を守る者は震え、力ある人はかがみ、ひきこなす女は少ないために休み、窓からのぞく者の目はかすみ、"},{"ref":"Eccl.12.4","start":21012004,"end":21012004,"break":"none","ruby":[[0,1,"まち"],[2,1,"もん"],[4,1,"と"],[12,1,"とき"],[18,1,"おと"],[20,1,"ひく"],[25,1,"ひと"],[27,1,"とり"],[29,1,"こえ"],[34,1,"お"],[40,1,"うた"],[42,1,"むすめ"],[46,1,"みな"],[48,1,"ひく"]],"text":"町の門は閉ざされる。その時ひきこなす音は低くなり、人は鳥の声によって起きあがり、歌の娘たちは皆、低くされる。"},{"ref":"Eccl.12.5","start":21012005,"end":21012005,"break":"none","ruby":[[0,1,"かれ"],[5,1,"たか"],[10,1,"おそ"],[14,1,"おそ"],[21,1,"みち"],[32,1,"はな"],[33,1,"さ"],[42,1,"み"],[48,1,"ある"],[53,2,"よくぼう"],[56,1,"おとろ"],[59,1,"ひと"],[61,2,"えいえん"],[64,1,"いえ"],[66,1,"い"],[75,1,"な"],[77,1,"ひと"],[84,1,"ある"]],"text":"彼らはまた高いものを恐れる。恐ろしいものが道にあり、あめんどうは花咲き、いなごはその身をひきずり歩き、その欲望は衰え、人が永遠の家に行こうとするので、泣く人が、ちまたを歩きまわる。"},{"ref":"Eccl.12.6","start":21012006,"end":21012006,"break":"none","ruby":[[2,1,"のち"],[4,1,"ぎん"],[9,1,"き"],[12,1,"きん"],[14,1,"さら"],[16,1,"くだ"],[19,1,"みず"],[23,1,"いずみ"],[30,1,"やぶ"],[33,1,"くるま"],[35,2,"いど"],[43,1,"くだ"]],"text":"その後、銀のひもは切れ、金の皿は砕け、水がめは泉のかたわらで破れ、車は井戸のかたわらで砕ける。"},{"ref":"Eccl.12.7","start":21012007,"end":21012007,"break":"none","ruby":[[10,1,"つち"],[12,1,"かえ"],[15,1,"れい"],[20,1,"さづ"],[23,1,"かみ"],[25,1,"かえ"]],"text":"ちりは、もとのように土に帰り、霊はこれを授けた神に帰る。"},{"ref":"Eccl.12.8","start":21012008,"end":21012008,"break":"none","ruby":[[0,3,"でんどうしゃ"],[4,1,"い"],[8,1,"くう"],[10,1,"くう"],[17,1,"くう"]],"text":"伝道者は言う、「空の空、いっさいは空である」と。"},{"ref":"Eccl.12.9","start":21012009,"end":21012009,"break":"paragraph","ruby":[[3,3,"でんどうしゃ"],[7,2,"ちえ"],[16,2,"ちしき"],[19,1,"たみ"],[21,1,"おし"],[25,1,"かれ"],[29,1,"かんが"],[32,1,"たず"],[42,2,"しんげん"]],"text":"さらに伝道者は知恵があるゆえに、知識を民に教えた。彼はよく考え、尋ねきわめ、あまたの箴言をまとめた。"},{"ref":"Eccl.12.10","start":21012010,"end":21012010,"break":"none","ruby":[[0,3,"でんどうしゃ"],[4,1,"うるわ"],[7,2,"ことば"],[10,1,"え"],[21,1,"かれ"],[23,2,"しんじつ"],[26,2,"ことば"],[29,1,"ただ"],[32,1,"か"]],"text":"伝道者は麗しい言葉を得ようとつとめた。また彼は真実の言葉を正しく書きしるした。"},{"ref":"Eccl.12.11","start":21012011,"end":21012011,"break":"paragraph","ruby":[[0,2,"ちしゃ"],[3,2,"ことば"],[6,1,"つ"],[8,1,"ぼう"],[20,1,"う"],[23,1,"くぎ"],[39,2,"ぼくしゃ"],[43,1,"で"],[45,2,"ことば"],[48,1,"あつ"]],"text":"知者の言葉は突き棒のようであり、またよく打った釘のようなものであって、ひとりの牧者から出た言葉が集められたものである。"},{"ref":"Eccl.12.12","start":21012012,"end":21012012,"break":"none","ruby":[[2,1,"こ"],[8,2,"いがい"],[11,1,"こと"],[14,1,"こころ"],[16,1,"もち"],[20,1,"おお"],[23,1,"しょ"],[25,1,"つく"],[28,2,"さいげん"],[34,1,"おお"],[36,1,"まな"],[43,1,"つか"]],"text":"わが子よ、これら以外の事にも心を用いよ。多くの書を作れば際限がない。多く学べばからだが疲れる。"},{"ref":"Eccl.12.13","start":21012013,"end":21012013,"break":"paragraph","ruby":[[0,1,"こと"],[2,1,"き"],[5,1,"ところ"],[11,1,"い"],[21,1,"かみ"],[23,1,"おそ"],[28,2,"めいれい"],[31,1,"まも"],[41,1,"ひと"],[43,2,"ほんぶん"]],"text":"事の帰する所は、すべて言われた。すなわち、神を恐れ、その命令を守れ。これはすべての人の本分である。"},{"ref":"Eccl.12.14","start":21012014,"end":21012014,"break":"none","ruby":[[0,1,"かみ"],[17,1,"かく"],[20,1,"こと"],[22,2,"ぜんあく"]],"text":"神はすべてのわざ、ならびにすべての隠れた事を善悪ともにさばかれるからである。"}]