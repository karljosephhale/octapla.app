[{"ref":"Lev.9.1","start":3009001,"end":3009001,"break":"paragraph","ruby":[[1,1,"か"],[2,1,"め"],[18,1,"こ"],[31,2,"ちょうろう"],[36,1,"よ"],[38,1,"よ"]],"text":"八日目になって、モーセはアロンとその子たち、およびイスラエルの長老たちを呼び寄せ、"},{"ref":"Lev.9.2","start":3009002,"end":3009002,"break":"none","ruby":[[4,1,"い"],[13,1,"おす"],[15,1,"こ"],[16,1,"うし"],[18,1,"まった"],[23,2,"ざいさい"],[29,1,"と"],[34,2,"おひつじ"],[37,1,"まった"],[42,2,"はんさい"],[48,1,"と"],[52,1,"しゅ"],[54,1,"まえ"]],"text":"アロンに言った、「あなたは雄の子牛の全きものを罪祭のために取り、また雄羊の全きものを燔祭のために取って、主の前にささげなさい。"},{"ref":"Lev.9.3","start":3009003,"end":3009003,"break":"none","ruby":[[12,2,"ひとびと"],[15,1,"い"],[28,1,"お"],[32,2,"ざいさい"],[38,1,"と"],[44,1,"さい"],[46,1,"まった"],[48,1,"こ"],[49,1,"うし"],[51,2,"こひつじ"],[55,2,"はんさい"],[61,1,"と"]],"text":"あなたはまたイスラエルの人々に言いなさい、『あなたがたは雄やぎを罪祭のために取り、また一歳の全き子牛と小羊とを燔祭のために取りなさい、"},{"ref":"Lev.9.4","start":3009004,"end":3009004,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"まえ"],[10,3,"しゅうおんさい"],[17,2,"おうし"],[20,2,"おひつじ"],[24,1,"と"],[29,1,"あぶら"],[31,1,"ま"],[34,2,"そさい"],[37,1,"と"],[43,1,"しゅ"],[54,1,"あらわ"]],"text":"また主の前にささげる酬恩祭のために雄牛と雄羊とを取り、また油を混ぜた素祭を取りなさい。主がきょうあなたがたに現れたもうからである』」。"},{"ref":"Lev.9.5","start":3009005,"end":3009005,"break":"none","ruby":[[0,1,"かれ"],[7,1,"めい"],[13,2,"かいけん"],[16,2,"まくや"],[19,1,"まえ"],[21,1,"たずさ"],[27,2,"かいしゅう"],[32,1,"ちか"],[36,1,"しゅ"],[38,1,"まえ"],[40,1,"た"]],"text":"彼らはモーセが命じたものを会見の幕屋の前に携えてきた。会衆がみな近づいて主の前に立ったので、"},{"ref":"Lev.9.6","start":3009006,"end":3009006,"break":"none","ruby":[[4,1,"い"],[12,1,"しゅ"],[24,1,"めい"],[39,1,"しゅ"],[41,2,"えいこう"],[50,1,"あらわ"]],"text":"モーセは言った、「これは主があなたがたに、せよと命じられたことである。こうして主の栄光はあなたがたに現れるであろう」。"},{"ref":"Lev.9.7","start":3009007,"end":3009007,"break":"none","ruby":[[10,1,"い"],[19,2,"さいだん"],[22,1,"ちか"],[30,2,"ざいさい"],[33,2,"はんさい"],[50,1,"たみ"],[64,1,"たみ"],[66,1,"そな"],[68,1,"もの"],[75,1,"かれ"],[91,1,"しゅ"],[94,1,"めい"]],"text":"モーセはまたアロンに言った、「あなたは祭壇に近づき、あなたの罪祭と燔祭をささげて、あなたのため、また民のためにあがないをし、また民の供え物をささげて、彼らのためにあがないをし、すべて主がお命じになったようにしなさい」。"},{"ref":"Lev.9.8","start":3009008,"end":3009008,"break":"paragraph","ruby":[[7,2,"さいだん"],[10,1,"ちか"],[14,2,"じぶん"],[20,2,"ざいさい"],[23,1,"こ"],[24,1,"うし"]],"text":"そこでアロンは祭壇に近づき、自分のための罪祭の子牛をほふった。"},{"ref":"Lev.9.9","start":3009009,"end":3009009,"break":"none","ruby":[[7,1,"こ"],[14,1,"ち"],[16,1,"かれ"],[21,1,"たずさ"],[29,1,"かれ"],[31,1,"ゆび"],[35,1,"ち"],[37,1,"ひた"],[43,2,"さいだん"],[46,1,"つの"],[51,1,"のこ"],[54,1,"ち"],[56,2,"さいだん"],[62,1,"そそ"]],"text":"そしてアロンの子たちは、その血を彼のもとに携えてきたので、彼は指をその血に浸し、それを祭壇の角につけ、残りの血を祭壇のもとに注ぎ、"},{"ref":"Lev.9.10","start":3009010,"end":3009010,"break":"none","ruby":[[2,2,"ざいさい"],[5,2,"しぼう"],[8,2,"じんぞう"],[11,2,"かんぞう"],[14,2,"しょうよう"],[18,2,"さいだん"],[21,1,"うえ"],[23,1,"や"],[27,1,"しゅ"],[33,1,"めい"]],"text":"また罪祭の脂肪と腎臓と肝臓の小葉とを祭壇の上で焼いた。主がモーセに命じられたとおりである。"},{"ref":"Lev.9.11","start":3009011,"end":3009011,"break":"none","ruby":[[4,1,"にく"],[6,1,"かわ"],[9,2,"しゅくえい"],[12,1,"そと"],[14,1,"ひ"],[19,1,"や"],[21,1,"す"]],"text":"またその肉と皮とは宿営の外で火をもって焼き捨てた。"},{"ref":"Lev.9.12","start":3009012,"end":3009012,"break":"paragraph","ruby":[[0,1,"かれ"],[4,2,"はんさい"],[7,1,"けもの"],[17,1,"こ"],[23,1,"ち"],[25,1,"かれ"],[27,1,"わた"],[36,2,"さいだん"],[39,2,"しゅうい"],[42,1,"そそ"]],"text":"彼はまた燔祭の獣をほふり、アロンの子たちがその血を彼に渡したので、これを祭壇の周囲に注ぎかけた。"},{"ref":"Lev.9.13","start":3009013,"end":3009013,"break":"none","ruby":[[0,1,"かれ"],[5,2,"はんさい"],[18,1,"き"],[20,1,"わ"],[26,1,"あたま"],[29,1,"かれ"],[31,1,"わた"],[37,1,"かれ"],[42,2,"さいだん"],[45,1,"うえ"],[47,1,"や"]],"text":"彼らがまた燔祭のもの、すなわち、その切り分けたものと頭とを彼に渡したので、彼はこれを祭壇の上で焼いた。"},{"ref":"Lev.9.14","start":3009014,"end":3009014,"break":"none","ruby":[[4,2,"ないぞう"],[7,1,"あし"],[10,1,"あら"],[13,2,"さいだん"],[16,1,"うえ"],[18,2,"はんさい"],[21,1,"とも"],[26,1,"や"]],"text":"またその内臓と足とを洗い、祭壇の上で燔祭と共にこれを焼いた。"},{"ref":"Lev.9.15","start":3009015,"end":3009015,"break":"paragraph","ruby":[[0,1,"かれ"],[4,1,"たみ"],[6,1,"そな"],[8,1,"もの"],[20,1,"たみ"],[25,2,"ざいさい"],[31,1,"と"],[41,1,"まえ"],[49,1,"つみ"]],"text":"彼はまた民の供え物をささげた。すなわち、民のための罪祭のやぎを取ってこれをほふり、前のようにこれを罪のためにささげた。"},{"ref":"Lev.9.16","start":3009016,"end":3009016,"break":"none","ruby":[[2,2,"はんさい"],[18,1,"さだ"]],"text":"また燔祭をささげた。すなわち、これを定めのようにささげた。"},{"ref":"Lev.9.17","start":3009017,"end":3009017,"break":"none","ruby":[[2,2,"そさい"],[15,2,"ひとにぎ"],[19,1,"と"],[22,1,"あさ"],[24,2,"はんさい"],[27,1,"くわ"],[34,2,"さいだん"],[37,1,"うえ"],[39,1,"や"]],"text":"また素祭をささげ、そのうちから一握りを取り、朝の燔祭に加えて、これを祭壇の上で焼いた。"},{"ref":"Lev.9.18","start":3009018,"end":3009018,"break":"paragraph","ruby":[[0,1,"かれ"],[4,1,"たみ"],[13,3,"しゅうおんさい"],[17,2,"ぎせい"],[20,2,"おうし"],[23,2,"おひつじ"],[35,1,"こ"],[42,1,"ち"],[44,1,"かれ"],[46,1,"わた"],[52,1,"かれ"],[57,2,"さいだん"],[60,2,"しゅうい"],[63,1,"そそ"]],"text":"彼はまた民のためにささげる酬恩祭の犠牲の雄牛と雄羊とをほふり、アロンの子たちが、その血を彼に渡したので、彼はこれを祭壇の周囲に注ぎかけた。"},{"ref":"Lev.9.19","start":3009019,"end":3009019,"break":"none","ruby":[[4,2,"おうし"],[7,2,"おひつじ"],[11,2,"しぼう"],[19,1,"あぶら"],[20,1,"お"],[22,2,"ないぞう"],[31,2,"じんぞう"],[34,2,"かんぞう"],[37,2,"しょうよう"]],"text":"またその雄牛と雄羊との脂肪、すなわち、脂尾、内臓をおおうもの、腎臓、肝臓の小葉。"},{"ref":"Lev.9.20","start":3009020,"end":3009020,"break":"none","ruby":[[4,2,"しぼう"],[7,1,"かれ"],[12,1,"むね"],[14,1,"うえ"],[16,1,"の"],[19,1,"たずさ"],[27,1,"かれ"],[31,2,"しぼう"],[34,2,"さいだん"],[37,1,"うえ"],[39,1,"や"]],"text":"これらの脂肪を彼らはその胸の上に載せて携えてきたので、彼はその脂肪を祭壇の上で焼いた。"},{"ref":"Lev.9.21","start":3009021,"end":3009021,"break":"none","ruby":[[2,1,"むね"],[4,1,"みぎ"],[15,1,"しゅ"],[17,1,"まえ"],[19,1,"ゆ"],[21,1,"うご"],[25,2,"ようさい"],[35,1,"めい"]],"text":"その胸と右のももとは、アロンが主の前に揺り動かして揺祭とした。モーセが命じたとおりである。"},{"ref":"Lev.9.22","start":3009022,"end":3009022,"break":"paragraph","ruby":[[4,1,"たみ"],[10,1,"て"],[16,1,"かれ"],[19,2,"しゅくふく"],[23,2,"ざいさい"],[26,2,"はんさい"],[29,3,"しゅうおんさい"],[36,1,"おわ"],[39,1,"ふ"]],"text":"アロンは民にむかって手をあげて、彼らを祝福し、罪祭、燔祭、酬恩祭をささげ終って降りた。"},{"ref":"Lev.9.23","start":3009023,"end":3009023,"break":"none","ruby":[[8,2,"かいけん"],[11,2,"まくや"],[14,1,"い"],[19,1,"で"],[23,1,"たみ"],[25,2,"しゅくふく"],[33,1,"しゅ"],[35,2,"えいこう"],[42,1,"たみ"],[44,1,"あらわ"]],"text":"モーセとアロンは会見の幕屋に入り、また出てきて民を祝福した。そして主の栄光はすべての民に現れ、"},{"ref":"Lev.9.24","start":3009024,"end":3009024,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"まえ"],[5,1,"ひ"],[7,1,"で"],[10,2,"さいだん"],[13,1,"うえ"],[15,2,"はんさい"],[18,2,"しぼう"],[22,1,"や"],[29,1,"たみ"],[37,1,"み"],[39,1,"よろこ"],[51,1,"ふ"]],"text":"主の前から火が出て、祭壇の上の燔祭と脂肪とを焼きつくした。民はみな、これを見て喜びよばわり、そしてひれ伏した。"}]