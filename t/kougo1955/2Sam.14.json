[{"ref":"2Sam.14.1","start":10014001,"end":10014001,"break":"paragraph","ruby":[[4,1,"こ"],[9,1,"おう"],[11,1,"こころ"],[19,1,"む"],[27,1,"し"]],"text":"ゼルヤの子ヨアブは王の心がアブサロムに向かっているのを知った。"},{"ref":"2Sam.14.2","start":10014002,"end":10014002,"break":"none","ruby":[[11,1,"ひと"],[27,1,"かしこ"],[29,1,"おんな"],[31,1,"つ"],[40,1,"おんな"],[42,1,"い"],[51,1,"かな"],[60,1,"ひと"],[68,2,"もふく"],[71,1,"き"],[73,1,"あぶら"],[75,1,"み"],[77,1,"ぬ"],[81,1,"し"],[84,1,"ひと"],[89,1,"なが"],[94,1,"かな"],[100,1,"おんな"]],"text":"そこでヨアブはテコアに人をつかわして、そこからひとりの賢い女を連れてこさせ、その女に言った、「あなたは悲しみのうちにある人をよそおって、喪服を着、油を身に塗らず、死んだ人のために長いあいだ悲しんでいる女のように、よそおって、"},{"ref":"2Sam.14.3","start":10014003,"end":10014003,"break":"none","ruby":[[0,1,"おう"],[5,1,"い"],[13,1,"かれ"],[15,1,"かた"],[32,2,"ことば"],[35,2,"かのじょ"],[38,1,"くち"],[40,1,"さづ"]],"text":"王のもとに行き、しかじかと彼に語りなさい」。こうしてヨアブはその言葉を彼女の口に授けた。"},{"ref":"2Sam.14.4","start":10014004,"end":10014004,"break":"paragraph","ruby":[[4,1,"おんな"],[6,1,"おう"],[11,1,"い"],[14,1,"ち"],[16,1,"ふ"],[19,1,"はい"],[23,1,"おう"],[27,1,"たす"],[35,1,"い"]],"text":"テコアの女は王のもとに行き、地に伏して拝し、「王よ、お助けください」と言った。"},{"ref":"2Sam.14.5","start":10014005,"end":10014005,"break":"none","ruby":[[0,1,"おう"],[2,1,"おんな"],[4,1,"い"],[17,1,"おんな"],[19,1,"い"],[32,2,"かふ"],[41,1,"おっと"],[43,1,"し"]],"text":"王は女に言った、「どうしたのか」。女は言った、「まことにわたしは寡婦でありまして、夫は死にました。"},{"ref":"2Sam.14.6","start":10014006,"end":10014006,"break":"none","ruby":[[10,1,"こ"],[21,1,"の"],[23,1,"あらそ"],[33,1,"かれ"],[36,1,"ひ"],[38,1,"わ"],[41,1,"もの"],[57,1,"た"],[59,1,"もの"],[61,1,"う"],[64,1,"ころ"]],"text":"つかえめにはふたりの子どもがあり、ふたりは野で争いましたが、だれも彼らを引き分ける者がなかったので、ひとりはついに他の者を撃って殺しました。"},{"ref":"2Sam.14.7","start":10014007,"end":10014007,"break":"none","ruby":[[3,2,"ぜんか"],[5,1,"ぞく"],[12,1,"さか"],[15,1,"た"],[20,2,"きょうだい"],[23,1,"う"],[25,1,"ころ"],[28,1,"もの"],[30,1,"ひ"],[32,1,"わ"],[44,1,"かれ"],[46,1,"ころ"],[51,2,"きょうだい"],[54,1,"いのち"],[59,1,"かれ"],[61,1,"ころ"],[66,1,"い"],[69,1,"かれ"],[72,2,"よつぎ"],[76,1,"ころ"],[89,1,"かれ"],[92,1,"のこ"],[101,2,"すみび"],[104,1,"け"],[112,1,"おっと"],[114,1,"な"],[118,1,"あと"],[119,1,"つぎ"],[123,1,"ち"]],"text":"すると全家族がつかえめに逆らい立って、『兄弟を撃ち殺した者を引き渡たすがよい。われわれは彼が殺したその兄弟の命のために彼を殺そう』と言い、彼らは世継をも殺そうとしました。こうして彼らは残っているわたしの炭火を消して、わたしの夫の名をも、跡継をも、地のおもてにとどめないようにしようとしています」。"},{"ref":"2Sam.14.8","start":10014008,"end":10014008,"break":"paragraph","ruby":[[0,1,"おう"],[2,1,"おんな"],[4,1,"い"],[9,1,"いえ"],[11,1,"かえ"],[31,2,"めいれい"],[34,1,"くだ"]],"text":"王は女に言った、「家に帰りなさい。わたしはあなたのことについて命令を下します」。"},{"ref":"2Sam.14.9","start":10014009,"end":10014009,"break":"none","ruby":[[4,1,"おんな"],[6,1,"おう"],[8,1,"い"],[15,1,"しゅ"],[17,1,"おう"],[28,1,"ちち"],[30,1,"いえ"],[34,1,"つみ"],[36,1,"き"],[47,1,"おう"],[49,1,"おう"],[51,1,"くらい"],[54,1,"つみ"]],"text":"テコアの女は王に言った、「わが主、王よ、わたしとわたしの父の家にその罪を帰してください。どうぞ王と王の位には罪がありませんように」。"},{"ref":"2Sam.14.10","start":10014010,"end":10014010,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[13,1,"なに"],[15,1,"い"],[17,1,"もの"],[27,1,"ところ"],[29,1,"つ"],[45,1,"ひと"],[47,1,"かさ"],[54,1,"ふ"]],"text":"王は言った、「もしあなたに何か言う者があれば、わたしの所に連れてきなさい。そうすれば、その人は重ねてあなたに触れることはないでしょう」。"},{"ref":"2Sam.14.11","start":10014011,"end":10014011,"break":"none","ruby":[[0,1,"おんな"],[2,1,"い"],[10,1,"おう"],[17,1,"かみ"],[19,1,"しゅ"],[26,1,"ち"],[28,2,"ほうふく"],[33,1,"もの"],[35,1,"かさ"],[38,1,"ほろ"],[52,1,"こ"],[54,1,"ころ"],[74,1,"おう"],[76,1,"い"],[81,1,"しゅ"],[83,1,"い"],[95,1,"こ"],[97,1,"かみ"],[99,1,"け"],[101,1,"すじ"],[103,1,"ち"],[105,1,"お"]],"text":"女は言った、「どうぞ王が、あなたの神、主をおぼえて、血の報復をする者に重ねて滅ぼすことをさせず、わたしの子の殺されることのないようにしてください」。王は言った、「主は生きておられる。あなたの子の髪の毛一筋も地に落ちることはないでしょう」。"},{"ref":"2Sam.14.12","start":10014012,"end":10014012,"break":"paragraph","ruby":[[0,1,"おんな"],[2,1,"い"],[18,1,"こと"],[22,1,"しゅ"],[24,1,"おう"],[26,1,"い"],[40,1,"い"],[45,1,"い"]],"text":"女は言った、「どうぞ、つかえめにひと言、わが主、王に言わせてください」。ダビデは言った、「言いなさい」。"},{"ref":"2Sam.14.13","start":10014013,"end":10014013,"break":"none","ruby":[[0,1,"おんな"],[2,1,"い"],[22,1,"かみ"],[24,1,"たみ"],[26,1,"む"],[35,1,"こと"],[37,1,"はか"],[46,1,"おう"],[48,1,"いま"],[51,1,"こと"],[53,1,"い"],[63,2,"じぶん"],[66,1,"つみ"],[69,1,"もの"],[81,1,"おう"],[83,2,"ついほう"],[88,1,"もの"],[90,1,"かえ"]],"text":"女は言った、「あなたは、それならばどうして、神の民に向かってこのような事を図られたのですか。王は今この事を言われたことによって自分を罪ある者とされています。それは王が追放された者を帰らせられないからです。"},{"ref":"2Sam.14.14","start":10014014,"end":10014014,"break":"none","ruby":[[8,1,"し"],[20,1,"ち"],[26,1,"みず"],[28,1,"ふたた"],[30,1,"あつ"],[42,1,"おな"],[50,1,"かみ"],[53,2,"ついほう"],[58,1,"もの"],[60,1,"す"],[74,1,"もう"],[77,1,"ひと"],[79,1,"いのち"],[81,1,"と"]],"text":"わたしたちはみな死ななければなりません。地にこぼれた水の再び集めることのできないのと同じです。しかし神は、追放された者が捨てられないように、てだてを設ける人の命を取ることはなさいません。"},{"ref":"2Sam.14.15","start":10014015,"end":10014015,"break":"none","ruby":[[6,1,"こと"],[8,1,"おう"],[12,1,"しゅ"],[14,1,"い"],[20,1,"き"],[29,1,"たみ"],[31,1,"おそ"],[47,1,"おも"],[55,1,"おう"],[57,1,"もう"],[59,1,"あ"],[64,1,"おう"],[72,1,"ねが"]],"text":"わたしがこの事を王、わが主に言おうとして来たのは、わたしが民を恐れたからです。つかえめは、こう思ったのです、『王に申し上げよう。王は、はしための願いのようにしてくださるかもしれない。"},{"ref":"2Sam.14.16","start":10014016,"end":10014016,"break":"none","ruby":[[0,1,"おう"],[2,1,"き"],[18,1,"こ"],[20,1,"とも"],[22,1,"ほろ"],[26,1,"かみ"],[28,1,"し"],[29,1,"ぎょう"],[32,1,"はな"],[41,1,"ひと"],[43,1,"て"],[52,1,"すく"],[54,1,"だ"]],"text":"王は聞いてくださる。わたしとわたしの子を共に滅ぼして神の嗣業から離れさせようとする人の手から、はしためを救い出してくださるのだから』。"},{"ref":"2Sam.14.17","start":10014017,"end":10014017,"break":"none","ruby":[[10,1,"おも"],[18,1,"おう"],[22,1,"しゅ"],[24,2,"ことば"],[31,2,"あんしん"],[46,1,"おう"],[50,1,"しゅ"],[52,1,"かみ"],[54,1,"つかい"],[59,1,"ぜん"],[61,1,"あく"],[63,1,"き"],[82,1,"かみ"],[84,1,"しゅ"],[90,1,"とも"]],"text":"つかえめはまた、こう思ったのです、『王、わが主の言葉はわたしを安心させるであろう』と。それは王、わが主は神の使のように善と悪を聞きわけられるからです。どうぞあなたの神、主があなたと共におられますように」。"},{"ref":"2Sam.14.18","start":10014018,"end":10014018,"break":"paragraph","ruby":[[0,1,"おう"],[2,1,"おんな"],[4,1,"こた"],[7,1,"い"],[16,1,"と"],[21,1,"かく"],[24,1,"こた"],[33,1,"おんな"],[35,1,"い"],[40,1,"おう"],[44,1,"しゅ"],[50,1,"い"]],"text":"王は女に答えて言った、「わたしが問うことに隠さず答えてください」。女は言った、「王、わが主よ、どうぞ言ってください」。"},{"ref":"2Sam.14.19","start":10014019,"end":10014019,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[13,1,"こと"],[23,1,"て"],[29,1,"とも"],[38,1,"おんな"],[40,1,"こた"],[53,1,"い"],[62,1,"おう"],[66,1,"しゅ"],[72,1,"おう"],[76,1,"しゅ"],[78,1,"い"],[82,1,"こと"],[85,1,"ひと"],[87,1,"みぎ"],[90,1,"ひだり"],[93,1,"まが"],[108,1,"めい"],[127,1,"かれ"],[134,1,"くち"],[141,2,"ことば"],[149,1,"さづ"]],"text":"王は言った、「このすべての事において、ヨアブの手があなたと共にありますか」。女は答えた、「あなたはたしかに生きておられます。王、わが主よ、すべて王、わが主の言われた事から人は右にも左にも曲ることはできません。わたしに命じたのは、あなたのしもべヨアブです。彼がつかえめの口に、これらの言葉をことごとく授けたのです。"},{"ref":"2Sam.14.20","start":10014020,"end":10014020,"break":"none","ruby":[[0,1,"こと"],[7,1,"か"],[26,1,"こと"],[36,1,"きみ"],[39,1,"かみ"],[41,1,"つかい"],[43,2,"ちえ"],[49,2,"ちえ"],[56,1,"ち"],[58,1,"うえ"],[67,1,"し"]],"text":"事のなりゆきを変えるため、あなたのしもべヨアブがこの事をしたのです。わが君には神の使の知恵のような知恵があって、地の上のすべてのことを知っておられます」。"},{"ref":"2Sam.14.21","start":10014021,"end":10014021,"break":"paragraph","ruby":[[3,1,"おう"],[9,1,"い"],[16,1,"こと"],[18,1,"ゆる"],[21,1,"い"],[25,2,"わかもの"],[33,1,"つ"],[35,1,"かえ"]],"text":"そこで王はヨアブに言った、「この事を許す。行って、若者アブサロムを連れ帰るがよい」。"},{"ref":"2Sam.14.22","start":10014022,"end":10014022,"break":"none","ruby":[[4,1,"ち"],[8,1,"ふ"],[11,1,"はい"],[14,1,"おう"],[16,2,"しゅくふく"],[28,1,"い"],[35,1,"しゅ"],[37,1,"おう"],[40,1,"おう"],[46,1,"ねが"],[49,1,"ゆる"],[68,1,"まえ"],[70,1,"めぐ"],[73,1,"え"],[78,1,"し"]],"text":"ヨアブは地にひれ伏して拝し、王を祝福した。そしてヨアブは言った、「わが主、王よ、王がしもべの願いを許されたので、きょうしもべは、あなたの前に恵みを得たことを知りました」。"},{"ref":"2Sam.14.23","start":10014023,"end":10014023,"break":"none","ruby":[[7,1,"た"],[15,1,"い"],[30,1,"つ"]],"text":"そこでヨアブは立ってゲシュルに行き、アブサロムをエルサレムに連れてきた。"},{"ref":"2Sam.14.24","start":10014024,"end":10014024,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[7,1,"かれ"],[9,2,"じぶん"],[12,1,"いえ"],[14,1,"ひ"],[29,1,"かお"],[31,1,"み"],[50,2,"じぶん"],[53,1,"いえ"],[55,1,"ひ"],[61,1,"おう"],[63,1,"かお"],[65,1,"み"]],"text":"王は言った、「彼を自分の家に引きこもらせるがよい。わたしの顔を見てはならない」。こうしてアブサロムは自分の家に引きこもり、王の顔を見なかった。"},{"ref":"2Sam.14.25","start":10014025,"end":10014025,"break":"paragraph","ruby":[[2,1,"ぜん"],[22,1,"うつく"],[33,1,"ひと"],[42,1,"あし"],[44,1,"うら"],[47,1,"あたま"],[49,1,"いただき"],[52,1,"かれ"],[55,1,"きず"]],"text":"さて全イスラエルのうちにアブサロムのように、美しさのためほめられた人はなかった。その足の裏から頭の頂まで彼には傷がなかった。"},{"ref":"2Sam.14.26","start":10014026,"end":10014026,"break":"none","ruby":[[8,1,"あたま"],[10,1,"か"],[12,1,"とき"],[16,1,"かみ"],[18,1,"け"],[26,1,"おう"],[41,2,"まいねん"],[44,1,"おわ"],[50,1,"か"],[54,1,"つね"],[62,1,"おも"],[68,1,"かれ"],[73,1,"か"]],"text":"アブサロムがその頭を刈る時、その髪の毛をはかったが、王のはかりで二百シケルあった。毎年の終りにそれを刈るのを常とした。それが重くなると、彼はそれを刈ったのである。"},{"ref":"2Sam.14.27","start":10014027,"end":10014027,"break":"none","ruby":[[7,1,"にん"],[20,1,"な"],[26,1,"むすめ"],[28,1,"うま"],[36,1,"うつく"],[39,1,"おんな"]],"text":"アブサロムに三人のむすこと、タマルという名のひとりの娘が生れた。タマルは美しい女であった。"},{"ref":"2Sam.14.28","start":10014028,"end":10014028,"break":"paragraph","ruby":[[10,1,"まん"],[12,1,"ねん"],[14,1,"あいだ"],[21,1,"す"],[26,1,"おう"],[28,1,"かお"],[30,1,"み"]],"text":"こうしてアブサロムは満二年の間エルサレムに住んだが、王の顔を見なかった。"},{"ref":"2Sam.14.29","start":10014029,"end":10014029,"break":"none","ruby":[[13,1,"おう"],[31,1,"ところ"],[33,1,"ひと"],[46,1,"かれ"],[48,1,"ところ"],[61,1,"かれ"],[63,1,"ふたた"],[65,1,"ひと"]],"text":"そこでアブサロムはヨアブを王のもとにつかわそうとして、ヨアブの所に人をつかわしたが、ヨアブは彼の所にこようとはしなかった。彼は再び人をつかわしたがヨアブはこようとはしなかった。"},{"ref":"2Sam.14.30","start":10014030,"end":10014030,"break":"none","ruby":[[11,2,"けらい"],[14,1,"い"],[23,1,"はたけ"],[29,1,"はたけ"],[31,1,"となり"],[40,2,"おおむぎ"],[46,1,"い"],[52,1,"ひ"],[54,1,"はな"],[67,2,"けらい"],[74,1,"はたけ"],[76,1,"ひ"],[78,1,"はな"]],"text":"そこでアブサロムはその家来に言った、「ヨアブの畑はわたしの畑の隣にあって、そこに大麦がある。行ってそれに火を放ちなさい」。アブサロムの家来たちはその畑に火を放った。"},{"ref":"2Sam.14.31","start":10014031,"end":10014031,"break":"none","ruby":[[4,1,"た"],[13,1,"いえ"],[17,1,"かれ"],[19,1,"い"],[32,2,"けらい"],[41,1,"はたけ"],[43,1,"ひ"],[45,1,"はな"]],"text":"ヨアブは立ってアブサロムの家にきて彼に言った、「どうしてあなたの家来たちはわたしの畑に火を放ったのですか」。"},{"ref":"2Sam.14.32","start":10014032,"end":10014032,"break":"none","ruby":[[10,1,"い"],[23,1,"ひと"],[34,1,"く"],[40,1,"い"],[51,1,"おう"],[96,1,"よ"],[107,1,"い"],[123,1,"いま"],[128,1,"おう"],[130,1,"かお"],[132,1,"み"],[147,1,"つみ"],[153,1,"おう"],[159,1,"ころ"]],"text":"アブサロムはヨアブに言った、「わたしはあなたに人をつかわして、ここへ来るようにと言ったのです。あなたを王のもとにつかわし、『なんのためにわたしはゲシュルからきたのですか。なおあそこにいたならば良かったでしょうに』と言わせようとしたのです。それゆえ今わたしに王の顔を見させてください。もしわたしに罪があるなら王にわたしを殺させてください」。"},{"ref":"2Sam.14.33","start":10014033,"end":10014033,"break":"none","ruby":[[7,1,"おう"],[12,1,"い"],[15,1,"つ"],[21,1,"おう"],[29,1,"め"],[35,1,"かれ"],[37,1,"おう"],[45,1,"おう"],[47,1,"まえ"],[49,1,"ち"],[53,1,"ふ"],[56,1,"はい"],[60,1,"おう"],[68,1,"くち"]],"text":"そこでヨアブは王のもとへ行って告げたので、王はアブサロムを召しよせた。彼は王のもとにきて、王の前に地にひれ伏して拝した。王はアブサロムに口づけした。"}]