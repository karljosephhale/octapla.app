[{"ref":"Amos.3.1","start":30003001,"end":30003001,"break":"paragraph","breaks":[[10,"line"],[29,"line"],[46,"line"]],"ruby":[[6,2,"ひとびと"],[10,1,"しゅ"],[18,1,"む"],[22,1,"い"],[38,1,"ち"],[41,1,"みちび"],[43,1,"のぼ"],[46,2,"ぜんか"],[49,1,"む"],[53,1,"い"],[58,2,"ことば"],[61,1,"き"]],"text":"イスラエルの人々よ、主があなたがたに向かって言われたこと、わたしがエジプトの地から導き上った全家に向かって言ったこの言葉を聞け。"},{"ref":"Amos.3.2","start":30003002,"end":30003002,"break":"line","breaks":[[16,"line"],[35,"line"],[50,"line"]],"ruby":[[1,1,"ち"],[31,1,"し"],[55,1,"つみ"],[66,1,"ばっ"]],"text":"「地のもろもろのやからのうちで、わたしはただ、あなたがただけを知った。それゆえ、わたしはあなたがたのもろもろの罪のため、あなたがたを罰する。"},{"ref":"Amos.3.3","start":30003003,"end":30003003,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"もの"],[8,2,"やくそく"],[18,2,"いっしょ"],[21,1,"ある"]],"text":"ふたりの者がもし約束しなかったなら、一緒に歩くだろうか。"},{"ref":"Amos.3.4","start":30003004,"end":30003004,"break":"line","breaks":[[15,"line"],[27,"line"],[46,"line"]],"ruby":[[5,2,"えもの"],[15,1,"はやし"],[17,1,"なか"],[27,1,"わか"],[34,1,"もの"],[48,1,"あな"],[51,1,"こえ"],[53,1,"だ"]],"text":"ししがもし獲物がなかったなら、林の中でほえるだろうか。若いししがもし物をつかまなかったなら、その穴から声を出すだろうか。"},{"ref":"Amos.3.5","start":30003005,"end":30003005,"break":"line","breaks":[[12,"line"],[29,"line"],[45,"line"]],"ruby":[[12,1,"とり"],[14,1,"ち"],[16,1,"は"],[19,1,"あみ"],[29,1,"あみ"],[33,1,"なに"],[45,1,"ち"]],"text":"もしわながなかったなら、鳥は地に張った網にかかるだろうか。網にもし何もかからなかったなら、地からとびあがるだろうか。"},{"ref":"Amos.3.6","start":30003006,"end":30003006,"break":"line","breaks":[[12,"line"],[23,"line"],[36,"line"]],"ruby":[[0,1,"まち"],[6,1,"な"],[12,1,"たみ"],[14,1,"おどろ"],[23,1,"しゅ"],[36,1,"まち"],[38,1,"わざわい"],[40,1,"おこ"]],"text":"町でラッパが鳴ったなら、民は驚かないだろうか。主がなされるのでなければ、町に災が起るだろうか。"},{"ref":"Amos.3.7","start":30003007,"end":30003007,"break":"line","breaks":[[9,"line"],[28,"line"]],"ruby":[[4,1,"しゅ"],[7,1,"かみ"],[17,3,"よげんしゃ"],[23,1,"かく"],[26,1,"こと"],[28,1,"しめ"],[35,2,"なにごと"]],"text":"まことに主なる神はそのしもべである預言者にその隠れた事を示さないでは、何事をもなされない。"},{"ref":"Amos.3.8","start":30003008,"end":30003008,"break":"line","breaks":[[7,"line"],[21,"line"],[31,"line"]],"ruby":[[10,1,"おそ"],[21,1,"しゅ"],[24,1,"かみ"],[26,1,"かた"],[34,2,"よげん"]],"text":"ししがほえる、だれが恐れないでいられよう。主なる神が語られる、だれが預言しないでいられよう」。"},{"ref":"Amos.3.9","start":30003009,"end":30003009,"break":"stanza","breaks":[[16,"line"],[39,"line"],[52,"line"],[67,"line"]],"ruby":[[13,2,"きゅうでん"],[21,1,"ち"],[30,2,"きゅうでん"],[33,1,"の"],[36,1,"い"],[45,2,"やまやま"],[48,1,"あつ"],[59,1,"おお"],[63,1,"さわ"],[69,1,"なか"],[71,1,"おこな"],[75,2,"ぼうぎゃく"],[79,1,"み"]],"text":"アッスリヤにあるもろもろの宮殿、エジプトの地にあるもろもろの宮殿に宣べて言え、「サマリヤの山々に集まり、そのうちにある大いなる騒ぎと、その中で行われる暴虐とを見よ」と。"},{"ref":"Amos.3.10","start":30003010,"end":30003010,"break":"line","breaks":[[7,"line"],[23,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"かれ"],[11,2,"せいぎ"],[14,1,"おこな"],[19,1,"し"],[27,1,"と"],[30,1,"もの"],[32,1,"うば"],[34,1,"と"],[37,1,"もの"],[47,2,"きゅうでん"]],"text":"主は言われる、「彼らは正義を行うことを知らず、しえたげ取った物と奪い取った物とをそのもろもろの宮殿にたくわえている」。"},{"ref":"Amos.3.11","start":30003011,"end":30003011,"break":"line","breaks":[[16,"line"],[29,"line"],[46,"line"]],"ruby":[[4,1,"しゅ"],[7,1,"かみ"],[11,1,"い"],[17,1,"てき"],[24,1,"くに"],[26,1,"かこ"],[33,2,"ぼうび"],[41,1,"と"],[43,1,"のぞ"],[55,2,"きゅうでん"]],"text":"それゆえ主なる神はこう言われる、「敵がきて、この国を囲み、あなたの防備をあなたから取り除き、あなたのもろもろの宮殿はかすめられる」。"},{"ref":"Amos.3.12","start":30003012,"end":30003012,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"い"],[10,2,"ひつじかい"],[16,1,"くち"],[20,1,"ひつじ"],[22,2,"りょうあし"],[29,2,"かたみみ"],[32,1,"と"],[34,1,"かえ"],[45,1,"す"],[53,2,"ひとびと"],[57,1,"なが"],[65,2,"しんだい"],[68,2,"いちぶ"],[71,1,"たずさ"],[74,1,"すく"]],"text":"主はこう言われる、「羊飼がししの口から、羊の両足、あるいは片耳を取り返すように、サマリヤに住むイスラエルの人々も、長いすのすみや、寝台の一部を携えて救われるであろう」。"},{"ref":"Amos.3.13","start":30003013,"end":30003013,"break":"stanza","breaks":[[15,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"かみ"],[5,1,"しゅ"],[8,1,"かみ"],[10,1,"い"],[16,1,"き"],[26,1,"いえ"],[28,2,"しょうげん"]],"text":"万軍の神、主なる神は言われる、「聞け、そしてヤコブの家に証言せよ。"},{"ref":"Amos.3.14","start":30003014,"end":30003014,"break":"line","breaks":[[23,"line"],[34,"line"]],"ruby":[[18,1,"ばっ"],[21,1,"ひ"],[27,2,"さいだん"],[30,1,"ばっ"],[36,2,"さいだん"],[39,1,"つの"],[41,1,"お"],[45,1,"ち"],[47,1,"お"]],"text":"わたしはイスラエルのもろもろのとがを罰する日にベテルの祭壇を罰する。その祭壇の角は折れて、地に落ちる。"},{"ref":"Amos.3.15","start":30003015,"end":30003015,"break":"line","breaks":[[18,"line"],[39,"line"]],"ruby":[[6,1,"ふゆ"],[8,1,"いえ"],[10,1,"なつ"],[12,1,"いえ"],[15,1,"う"],[18,2,"ぞうげ"],[21,1,"いえ"],[23,1,"ほろ"],[26,1,"おお"],[30,1,"いえ"],[32,1,"き"],[39,1,"しゅ"],[41,1,"い"]],"text":"わたしはまた冬の家と夏の家とを撃つ、象牙の家は滅び、大いなる家は消えうせる」と主は言われる。"}]