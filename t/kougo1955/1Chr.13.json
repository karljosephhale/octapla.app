[{"ref":"1Chr.13.1","start":13013001,"end":13013001,"break":"paragraph","ruby":[[8,1,"にん"],[10,1,"ちょう"],[13,1,"にん"],[15,1,"ちょう"],[19,1,"しょ"],[20,1,"しょう"],[22,1,"あい"]],"text":"ここにダビデは千人の長、百人の長などの諸将と相はかり、"},{"ref":"1Chr.13.2","start":13013002,"end":13013002,"break":"none","ruby":[[13,1,"ぜん"],[14,2,"かいしゅう"],[17,1,"い"],[46,1,"かみ"],[48,1,"しゅ"],[53,1,"ゆる"],[73,2,"かくち"],[76,1,"のこ"],[86,2,"きょうだい"],[93,2,"ほうぼく"],[95,1,"ち"],[97,1,"つ"],[102,2,"まちまち"],[107,2,"さいし"],[116,1,"つかい"],[128,1,"ところ"],[130,1,"よ"],[132,1,"あつ"]],"text":"そしてダビデはイスラエルの全会衆に言った、「もし、このことをあなたがたがよしとし、われわれの神、主がこれを許されるならば、われわれは、イスラエルの各地に残っているわれわれの兄弟ならびに、放牧地の付いている町々にいる祭司とレビびとに、使をつかわし、われわれの所に呼び集めましょう。"},{"ref":"1Chr.13.3","start":13013003,"end":13013003,"break":"none","ruby":[[2,1,"かみ"],[4,1,"はこ"],[11,1,"ところ"],[13,1,"うつ"],[29,1,"よ"]],"text":"また神の箱をわれわれの所に移しましょう。われわれはサウルの世にはこれをおろそかにしたからです」。"},{"ref":"1Chr.13.4","start":13013004,"end":13013004,"break":"none","ruby":[[0,2,"かいしゅう"],[3,2,"いちどう"],[15,1,"い"],[28,1,"たみ"],[30,1,"め"],[32,1,"ただ"]],"text":"会衆は一同「そうしましょう」と言った。このことがすべての民の目に正しかったからである。"},{"ref":"1Chr.13.5","start":13013005,"end":13013005,"break":"paragraph","ruby":[[17,1,"かみ"],[19,1,"はこ"],[21,1,"はこ"],[43,2,"いりぐち"],[59,1,"よ"],[61,1,"あつ"]],"text":"そこでダビデはキリアテ・ヤリムから神の箱を運んでくるため、エジプトのシホルからハマテの入口までのイスラエルをことごとく呼び集めた。"},{"ref":"1Chr.13.6","start":13013006,"end":13013006,"break":"none","ruby":[[36,1,"のぼ"],[44,1,"うえ"],[46,1,"ざ"],[53,1,"しゅ"],[55,1,"な"],[60,1,"よ"],[66,1,"かみ"],[68,1,"はこ"],[76,1,"のぼ"]],"text":"そしてダビデとすべてのイスラエルはバアラすなわちユダのキリアテ・ヤリムに上り、ケルビムの上に座しておられる主の名をもって呼ばれている神の箱をそこからかき上ろうと、"},{"ref":"1Chr.13.7","start":13013007,"end":13013007,"break":"none","ruby":[[0,1,"かみ"],[2,1,"はこ"],[4,1,"あたら"],[7,1,"くるま"],[19,1,"いえ"],[36,1,"くるま"],[38,1,"ぎょ"]],"text":"神の箱を新しい車にのせて、アビナダブの家からひきだし、ウザとアヒヨがその車を御した。"},{"ref":"1Chr.13.8","start":13013008,"end":13013008,"break":"none","ruby":[[16,1,"うた"],[18,1,"こと"],[20,2,"たてごと"],[24,1,"て"],[25,1,"つづみ"],[42,1,"ちから"],[48,1,"かみ"],[50,1,"まえ"],[52,1,"おど"]],"text":"ダビデおよびすべてのイスラエルは歌と琴と立琴と、手鼓と、シンバルと、ラッパをもって、力をきわめて神の前に踊った。"},{"ref":"1Chr.13.9","start":13013009,"end":13013009,"break":"paragraph","ruby":[[0,1,"かれ"],[7,1,"う"],[9,1,"ば"],[11,1,"き"],[13,1,"とき"],[18,1,"て"],[20,1,"の"],[23,1,"はこ"],[25,1,"おさ"],[29,1,"うし"]],"text":"彼らがキドンの打ち場に来た時、ウザは手を伸べて箱を押えた。牛がつまずいたからである。"},{"ref":"1Chr.13.10","start":13013010,"end":13013010,"break":"none","ruby":[[3,1,"て"],[5,1,"はこ"],[17,1,"しゅ"],[19,1,"かれ"],[21,1,"む"],[25,1,"いか"],[28,1,"はっ"],[31,1,"かれ"],[33,1,"う"],[40,1,"かれ"],[44,1,"ところ"],[46,1,"かみ"],[48,1,"まえ"],[50,1,"し"]],"text":"ウザが手を箱につけたことによって、主は彼に向かって怒りを発し、彼を撃たれたので、彼はその所で神の前に死んだ。"},{"ref":"1Chr.13.11","start":13013011,"end":13013011,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"う"],[16,1,"いか"],[22,1,"ところ"],[24,2,"こんにち"],[35,1,"よ"]],"text":"主がウザを撃たれたので、ダビデは怒った。その所は今日までペレヅ・ウザと呼ばれている。"},{"ref":"1Chr.13.12","start":13013012,"end":13013012,"break":"none","ruby":[[2,1,"ひ"],[7,1,"かみ"],[9,1,"おそ"],[12,1,"い"],[21,1,"かみ"],[23,1,"はこ"],[30,1,"ところ"],[35,1,"い"]],"text":"その日ダビデは神を恐れて言った、「どうして神の箱を、わたしの所へかいて行けようか」。"},{"ref":"1Chr.13.13","start":13013013,"end":13013013,"break":"none","ruby":[[9,1,"はこ"],[11,2,"じぶん"],[14,1,"ところ"],[19,1,"まち"],[22,1,"うつ"],[29,1,"てん"],[44,1,"いえ"],[46,1,"はこ"]],"text":"それでダビデはその箱を自分の所ダビデの町へは移さず、これを転じてガテびとオベデ・エドムの家に運ばせた。"},{"ref":"1Chr.13.14","start":13013014,"end":13013014,"break":"none","ruby":[[0,1,"かみ"],[2,1,"はこ"],[6,1,"げつ"],[8,1,"あいだ"],[18,1,"いえ"],[23,2,"かぞく"],[35,1,"しゅ"],[45,2,"かぞく"],[54,1,"も"],[56,1,"もの"],[58,2,"しゅくふく"]],"text":"神の箱は三か月の間、オベデ・エドムの家に、その家族とともにとどまった。主はオベデ・エドムの家族とそのすべての持ち物を祝福された。"}]