[{"ref":"Isa.58.1","start":23058001,"end":23058001,"break":"paragraph","breaks":[[16,"line"],[32,"line"],[44,"line"]],"ruby":[[1,1,"おお"],[4,1,"よ"],[9,1,"こえ"],[11,1,"お"],[20,1,"こえ"],[34,1,"たみ"],[41,1,"つ"],[48,1,"いえ"],[52,1,"つみ"],[54,1,"つ"],[56,1,"しめ"]],"text":"「大いに呼ばわって声を惜しむな。あなたの声をラッパのようにあげ、わが民にそのとがを告げ、ヤコブの家にその罪を告げ示せ。"},{"ref":"Isa.58.2","start":23058002,"end":23058002,"break":"line","breaks":[[14,"line"],[36,"line"],[48,"line"],[65,"line"]],"ruby":[[0,1,"かれ"],[3,2,"ひび"],[9,1,"たず"],[11,1,"もと"],[14,1,"ぎ"],[16,1,"おこな"],[19,1,"かみ"],[25,1,"す"],[29,2,"くにたみ"],[38,1,"みち"],[40,1,"し"],[45,1,"よろこ"],[48,1,"かれ"],[51,1,"ただ"],[62,1,"もと"],[65,1,"かみ"],[67,1,"ちか"],[73,1,"よろこ"]],"text":"彼らは日々わたしを尋ね求め、義を行い、神のおきてを捨てない国民のように、わが道を知ることを喜ぶ。彼らは正しいさばきをわたしに求め、神に近づくことを喜ぶ。"},{"ref":"Isa.58.3","start":23058003,"end":23058003,"break":"line","breaks":[[6,"line"],[19,"line"],[33,"line"],[49,"line"],[63,"line"],[79,"line"],[89,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[12,2,"だんじき"],[42,1,"くる"],[63,1,"み"],[72,2,"だんじき"],[75,1,"ひ"],[82,1,"たの"],[86,1,"もと"],[91,1,"はたら"],[93,1,"ひと"]],"text":"彼らは言う、『われわれが断食したのに、なぜ、ごらんにならないのか。われわれがおのれを苦しめたのに、なぜ、ごぞんじないのか』と。見よ、あなたがたの断食の日には、おのが楽しみを求め、その働き人をことごとくしえたげる。"},{"ref":"Isa.58.4","start":23058004,"end":23058004,"break":"line","breaks":[[16,"line"],[30,"line"],[49,"line"],[65,"line"]],"ruby":[[0,1,"み"],[10,1,"しょく"],[18,1,"あらそ"],[32,1,"あく"],[41,1,"ひと"],[43,1,"う"],[61,2,"だんじき"],[67,1,"こえ"],[69,1,"うえ"],[71,1,"きこ"]],"text":"見よ、あなたがたの断食するのは、ただ争いと、いさかいのため、また悪のこぶしをもって人を打つためだ。きょう、あなたがたのなす断食は、その声を上に聞えさせるものではない。"},{"ref":"Isa.58.5","start":23058005,"end":23058005,"break":"line","breaks":[[23,"line"],[40,"line"],[54,"line"],[74,"line"],[89,"line"]],"ruby":[[13,1,"えら"],[15,2,"だんじき"],[23,1,"ひと"],[29,1,"くる"],[33,1,"ひ"],[46,1,"あし"],[51,1,"ふ"],[54,2,"あらぬの"],[57,1,"はい"],[62,1,"した"],[64,1,"し"],[82,2,"だんじき"],[89,1,"しゅ"],[91,1,"う"],[98,1,"ひ"]],"text":"このようなものは、わたしの選ぶ断食であろうか。人がおのれを苦しめる日であろうか。そのこうべを葦のように伏せ、荒布と灰とをその下に敷くことであろうか。あなたは、これを断食ととなえ、主に受けいれられる日と、となえるであろうか。"},{"ref":"Isa.58.6","start":23058006,"end":23058006,"break":"paragraph","breaks":[[14,"line"],[33,"line"],[48,"line"]],"ruby":[[4,1,"えら"],[10,2,"だんじき"],[14,1,"あく"],[30,1,"と"],[40,1,"もの"],[42,1,"はな"],[44,1,"さ"],[56,1,"お"],[61,1,"こと"]],"text":"わたしが選ぶところの断食は、悪のなわをほどき、くびきのひもを解き、しえたげられる者を放ち去らせ、すべてのくびきを折るなどの事ではないか。"},{"ref":"Isa.58.7","start":23058007,"end":23058007,"break":"line","breaks":[[20,"line"],[40,"line"],[53,"line"]],"ruby":[[2,1,"う"],[5,1,"もの"],[15,1,"わ"],[17,1,"あた"],[25,1,"まず"],[28,1,"もの"],[35,1,"いえ"],[37,1,"い"],[40,1,"はだか"],[42,1,"もの"],[44,1,"み"],[50,1,"き"],[53,2,"じぶん"],[56,2,"こつにく"],[59,1,"み"],[61,1,"かく"],[68,1,"こと"]],"text":"また飢えた者に、あなたのパンを分け与え、さすらえる貧しい者を、あなたの家に入れ、裸の者を見て、これを着せ、自分の骨肉に身を隠さないなどの事ではないか。"},{"ref":"Isa.58.8","start":23058008,"end":23058008,"break":"line","breaks":[[24,"line"],[39,"line"],[54,"line"]],"ruby":[[10,1,"ひかり"],[12,1,"あかつき"],[21,1,"で"],[43,1,"ぎ"],[49,1,"まえ"],[51,1,"い"],[54,1,"しゅ"],[56,2,"えいこう"]],"text":"そうすれば、あなたの光が暁のようにあらわれ出て、あなたは、すみやかにいやされ、あなたの義はあなたの前に行き、主の栄光はあなたのしんがりとなる。"},{"ref":"Isa.58.9","start":23058009,"end":23058009,"break":"line","breaks":[[19,"line"],[28,"line"],[45,"line"],[62,"line"]],"ruby":[[7,1,"よ"],[12,1,"しゅ"],[14,1,"こた"],[23,1,"さけ"],[40,1,"い"],[52,1,"なか"],[59,1,"のぞ"],[62,1,"ゆび"],[69,1,"わる"],[71,1,"こと"],[73,1,"かた"],[78,1,"のぞ"]],"text":"また、あなたが呼ぶとき、主は答えられ、あなたが叫ぶとき、『わたしはここにおる』と言われる。もし、あなたの中からくびきを除き、指をさすこと、悪い事を語ることを除き、"},{"ref":"Isa.58.10","start":23058010,"end":23058010,"break":"line","breaks":[[15,"line"],[33,"line"],[45,"line"]],"ruby":[[0,1,"う"],[3,1,"もの"],[12,1,"ほどこ"],[15,1,"くる"],[18,1,"もの"],[20,1,"ねが"],[23,1,"み"],[25,1,"た"],[37,1,"ひかり"],[39,1,"くら"],[42,1,"かがや"],[52,2,"まひる"]],"text":"飢えた者にあなたのパンを施し、苦しむ者の願いを満ち足らせるならば、あなたの光は暗きに輝き、あなたのやみは真昼のようになる。"},{"ref":"Isa.58.11","start":23058011,"end":23058011,"break":"line","breaks":[[11,"line"],[31,"line"],[43,"line"],[56,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"つね"],[8,1,"みちび"],[11,1,"よ"],[13,1,"もの"],[22,1,"ねが"],[25,1,"み"],[27,1,"た"],[35,1,"ほね"],[37,1,"つよ"],[47,1,"うるお"],[50,1,"その"],[56,1,"みず"],[58,1,"た"],[62,1,"いずみ"]],"text":"主は常にあなたを導き、良き物をもってあなたの願いを満ち足らせ、あなたの骨を強くされる。あなたは潤った園のように、水の絶えない泉のようになる。"},{"ref":"Isa.58.12","start":23058012,"end":23058012,"break":"line","breaks":[[22,"line"],[37,"line"],[55,"line"],[73,"line"]],"ruby":[[4,1,"こ"],[7,1,"ひさ"],[10,1,"あ"],[17,1,"ところ"],[19,1,"おこ"],[26,2,"よよ"],[32,1,"もとい"],[34,1,"た"],[37,1,"ひと"],[44,1,"やぶ"],[47,1,"つくろ"],[49,1,"もの"],[52,1,"よ"],[56,2,"しがい"],[59,1,"つくろ"],[62,1,"す"],[66,1,"ところ"],[70,1,"もの"],[73,1,"よ"]],"text":"あなたの子らは久しく荒れすたれたる所を興し、あなたは代々やぶれた基を立て、人はあなたを『破れを繕う者』と呼び、『市街を繕って住むべき所となす者』と呼ぶようになる。"},{"ref":"Isa.58.13","start":23058013,"end":23058013,"break":"paragraph","breaks":[[16,"line"],[33,"line"],[45,"line"],[60,"line"],[76,"line"],[87,"line"]],"ruby":[[2,3,"あんそくにち"],[10,1,"あし"],[18,2,"せいじつ"],[25,1,"たの"],[33,3,"あんそくにち"],[37,1,"よろこ"],[40,1,"ひ"],[42,1,"よ"],[45,1,"しゅ"],[47,2,"せいじつ"],[50,1,"たっと"],[54,1,"ひ"],[63,1,"たっと"],[70,1,"みち"],[72,1,"おこな"],[79,1,"たの"],[83,1,"もと"],[91,2,"ことば"],[94,1,"かた"]],"text":"もし安息日にあなたの足をとどめ、わが聖日にあなたの楽しみをなさず、安息日を喜びの日と呼び、主の聖日を尊ぶべき日ととなえ、これを尊んで、おのが道を行わず、おのが楽しみを求めず、むなしい言葉を語らないならば、"},{"ref":"Isa.58.14","start":23058014,"end":23058014,"break":"line","breaks":[[17,"line"],[38,"line"],[55,"line"],[63,"line"]],"ruby":[[2,1,"とき"],[7,1,"しゅ"],[12,1,"よろこ"],[15,1,"え"],[26,1,"ち"],[28,1,"たか"],[30,1,"ところ"],[32,1,"の"],[34,1,"とお"],[42,2,"せんぞ"],[48,1,"し"],[49,1,"ぎょう"],[59,1,"やしな"],[66,1,"しゅ"],[68,1,"くち"],[71,1,"かた"]],"text":"その時あなたは主によって喜びを得、わたしは、あなたに地の高い所を乗り通らせ、あなたの先祖ヤコブの嗣業をもって、あなたを養う」。これは主の口から語られたものである。"}]