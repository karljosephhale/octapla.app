[{"ref":"1Kgs.19.1","start":11019001,"end":11019001,"break":"paragraph","ruby":[[14,1,"こと"],[18,1,"かれ"],[24,3,"よげんしゃ"],[28,1,"かたな"],[30,1,"ころ"],[41,1,"つ"]],"text":"アハブはエリヤのしたすべての事、また彼がすべての預言者を刀で殺したことをイゼベルに告げたので、"},{"ref":"1Kgs.19.2","start":11019002,"end":11019002,"break":"none","ruby":[[5,2,"ししゃ"],[17,1,"い"],[32,1,"いま"],[40,1,"いのち"],[44,2,"ひとびと"],[51,1,"いのち"],[65,2,"かみがみ"],[79,1,"ばっ"]],"text":"イゼベルは使者をエリヤにつかわして言った、「もしわたしが、あすの今ごろ、あなたの命をあの人々のひとりの命のようにしていないならば、神々がどんなにでも、わたしを罰してくださるように」。"},{"ref":"1Kgs.19.3","start":11019003,"end":11019003,"break":"none","ruby":[[7,1,"おそ"],[11,2,"じぶん"],[14,1,"いのち"],[16,1,"すく"],[21,1,"た"],[24,1,"に"],[30,1,"ぞく"],[39,1,"い"],[50,1,"のこ"]],"text":"そこでエリヤは恐れて、自分の命を救うために立って逃げ、ユダに属するベエルシバへ行って、しもべをそこに残し、"},{"ref":"1Kgs.19.4","start":11019004,"end":11019004,"break":"none","ruby":[[0,2,"じぶん"],[4,1,"にち"],[6,1,"みち"],[11,2,"あらの"],[18,1,"い"],[26,1,"き"],[28,1,"した"],[30,1,"ざ"],[33,2,"じぶん"],[36,1,"し"],[38,1,"もと"],[41,1,"い"],[46,1,"しゅ"],[61,1,"いま"],[66,1,"いのち"],[68,1,"と"],[80,2,"せんぞ"],[86,1,"もの"]],"text":"自分は一日の道のりほど荒野にはいって行って、れだまの木の下に座し、自分の死を求めて言った、「主よ、もはや、じゅうぶんです。今わたしの命を取ってください。わたしは先祖にまさる者ではありません」。"},{"ref":"1Kgs.19.5","start":11019005,"end":11019005,"break":"none","ruby":[[0,1,"かれ"],[6,1,"き"],[8,1,"した"],[10,1,"ふ"],[13,1,"ねむ"],[18,1,"てん"],[20,1,"つかい"],[22,1,"かれ"],[29,1,"お"],[32,1,"た"],[39,1,"い"]],"text":"彼はれだまの木の下に伏して眠ったが、天の使が彼にさわり、「起きて食べなさい」と言ったので、"},{"ref":"1Kgs.19.6","start":11019006,"end":11019006,"break":"none","ruby":[[0,1,"お"],[3,1,"み"],[7,1,"とう"],[13,1,"や"],[15,1,"いし"],[17,1,"うえ"],[19,1,"や"],[25,1,"こ"],[32,1,"みず"],[38,1,"かれ"],[40,1,"た"],[45,1,"の"],[50,1,"ね"]],"text":"起きて見ると、頭のそばに、焼け石の上で焼いたパン一個と、一びんの水があった。彼は食べ、かつ飲んでまた寝た。"},{"ref":"1Kgs.19.7","start":11019007,"end":11019007,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,1,"ふたた"],[9,1,"かれ"],[15,1,"い"],[20,1,"お"],[23,1,"た"],[29,1,"みち"],[31,1,"とお"],[34,1,"た"]],"text":"主の使は再びきて、彼にさわって言った、「起きて食べなさい。道が遠くて耐えられないでしょうから」。"},{"ref":"1Kgs.19.8","start":11019008,"end":11019008,"break":"none","ruby":[[0,1,"かれ"],[2,1,"お"],[5,1,"た"],[10,1,"の"],[15,2,"しょくもつ"],[18,1,"ちから"],[24,1,"にち"],[27,1,"や"],[28,1,"い"],[32,1,"かみ"],[34,1,"やま"],[39,1,"つ"]],"text":"彼は起きて食べ、かつ飲み、その食物で力づいて四十日四十夜行って、神の山ホレブに着いた。"},{"ref":"1Kgs.19.9","start":11019009,"end":11019009,"break":"paragraph","ruby":[[2,1,"ところ"],[4,1,"かれ"],[8,1,"あな"],[18,1,"やど"],[23,1,"しゅ"],[25,2,"ことば"],[28,1,"かれ"],[30,1,"のぞ"],[34,1,"かれ"],[36,1,"い"],[54,1,"なに"]],"text":"その所で彼はほら穴にはいって、そこに宿ったが、主の言葉が彼に臨んで、彼に言われた、「エリヤよ、あなたはここで何をしているのか」。"},{"ref":"1Kgs.19.10","start":11019010,"end":11019010,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[11,2,"ばんぐん"],[14,1,"かみ"],[16,1,"しゅ"],[21,2,"ひじょう"],[24,2,"ねっしん"],[39,2,"ひとびと"],[46,2,"けいやく"],[49,1,"す"],[56,2,"さいだん"],[63,1,"かたな"],[72,3,"よげんしゃ"],[78,1,"ころ"],[92,1,"のこ"],[99,1,"かれ"],[106,1,"いのち"],[108,1,"と"]],"text":"彼は言った、「わたしは万軍の神、主のために非常に熱心でありました。イスラエルの人々はあなたの契約を捨て、あなたの祭壇をこわし、刀をもってあなたの預言者たちを殺したのです。ただわたしだけ残りましたが、彼らはわたしの命を取ろうとしています」。"},{"ref":"1Kgs.19.11","start":11019011,"end":11019011,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"で"],[11,1,"やま"],[13,1,"うえ"],[15,1,"しゅ"],[17,1,"まえ"],[20,1,"た"],[29,1,"とき"],[30,1,"しゅ"],[32,1,"とお"],[34,1,"す"],[39,1,"しゅ"],[41,1,"まえ"],[43,1,"おお"],[46,1,"つよ"],[48,1,"かぜ"],[50,1,"ふ"],[53,1,"やま"],[55,1,"さ"],[58,1,"いわ"],[60,1,"くだ"],[67,1,"しゅ"],[69,1,"かぜ"],[71,1,"なか"],[81,1,"かぜ"],[83,1,"のち"],[85,2,"じしん"],[93,2,"じしん"],[96,1,"なか"],[99,1,"しゅ"]],"text":"主は言われた、「出て、山の上で主の前に、立ちなさい」。その時主は通り過ぎられ、主の前に大きな強い風が吹き、山を裂き、岩を砕いた。しかし主は風の中におられなかった。風の後に地震があったが、地震の中にも主はおられなかった。"},{"ref":"1Kgs.19.12","start":11019012,"end":11019012,"break":"none","ruby":[[0,2,"じしん"],[3,1,"のち"],[5,1,"ひ"],[12,1,"ひ"],[14,1,"なか"],[17,1,"しゅ"],[27,1,"ひ"],[29,1,"のち"],[31,1,"しず"],[34,1,"ほそ"],[36,1,"こえ"],[38,1,"きこ"]],"text":"地震の後に火があったが、火の中にも主はおられなかった。火の後に静かな細い声が聞えた。"},{"ref":"1Kgs.19.13","start":11019013,"end":11019013,"break":"none","ruby":[[7,1,"き"],[10,1,"かお"],[12,2,"がいとう"],[15,1,"つつ"],[18,1,"で"],[22,1,"あな"],[24,1,"くち"],[26,1,"た"],[30,1,"かれ"],[32,1,"かた"],[34,1,"こえ"],[36,1,"きこ"],[53,1,"なに"]],"text":"エリヤはそれを聞いて顔を外套に包み、出てほら穴の口に立つと、彼に語る声が聞えた、「エリヤよ、あなたはここで何をしているのか」。"},{"ref":"1Kgs.19.14","start":11019014,"end":11019014,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[11,2,"ばんぐん"],[14,1,"かみ"],[16,1,"しゅ"],[21,2,"ひじょう"],[24,2,"ねっしん"],[39,2,"ひとびと"],[46,2,"けいやく"],[49,1,"す"],[56,2,"さいだん"],[63,1,"かたな"],[69,3,"よげんしゃ"],[75,1,"ころ"],[90,1,"のこ"],[97,1,"かれ"],[104,1,"いのち"],[106,1,"と"]],"text":"彼は言った、「わたしは万軍の神、主のために非常に熱心でありました。イスラエルの人々はあなたの契約を捨て、あなたの祭壇をこわし、刀であなたの預言者たちを殺したからです。ただわたしだけ残りましたが、彼らはわたしの命を取ろうとしています」。"},{"ref":"1Kgs.19.15","start":11019015,"end":11019015,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"い"],[14,1,"みち"],[16,1,"かえ"],[19,1,"い"],[28,2,"あらの"],[41,1,"つ"],[50,1,"あぶら"],[52,1,"そそ"],[59,1,"おう"]],"text":"主は彼に言われた、「あなたの道を帰って行って、ダマスコの荒野におもむき、ダマスコに着いて、ハザエルに油を注ぎ、スリヤの王としなさい。"},{"ref":"1Kgs.19.16","start":11019016,"end":11019016,"break":"none","ruby":[[6,1,"こ"],[11,1,"あぶら"],[13,1,"そそ"],[22,1,"おう"],[43,1,"こ"],[49,1,"あぶら"],[51,1,"そそ"],[59,1,"かわ"],[62,3,"よげんしゃ"]],"text":"またニムシの子エヒウに油を注いでイスラエルの王としなさい。またアベルメホラのシャパテの子エリシャに油を注いで、あなたに代って預言者としなさい。"},{"ref":"1Kgs.19.17","start":11019017,"end":11019017,"break":"none","ruby":[[13,1,"もの"],[19,1,"ころ"],[34,1,"もの"],[41,1,"ころ"]],"text":"ハザエルのつるぎをのがれる者をエヒウが殺し、エヒウのつるぎをのがれる者をエリシャが殺すであろう。"},{"ref":"1Kgs.19.18","start":11019018,"end":11019018,"break":"none","ruby":[[18,1,"にん"],[20,1,"のこ"],[27,1,"みな"],[43,1,"くち"],[49,1,"もの"]],"text":"また、わたしはイスラエルのうちに七千人を残すであろう。皆バアルにひざをかがめず、それに口づけしない者である」。"},{"ref":"1Kgs.19.19","start":11019019,"end":11019019,"break":"paragraph","ruby":[[9,1,"さ"],[12,1,"い"],[21,1,"こ"],[27,1,"あ"],[31,1,"かれ"],[39,1,"うし"],[41,1,"まえ"],[43,1,"い"],[47,2,"じぶん"],[52,2,"ばんめ"],[59,1,"とも"],[63,1,"たがや"],[73,1,"かれ"],[80,1,"とお"],[82,1,"す"],[85,2,"がいとう"],[88,1,"かれ"],[90,1,"うえ"]],"text":"さてエリヤはそこを去って行って、シャパテの子エリシャに会った。彼は十二くびきの牛を前に行かせ、自分は十二番目のくびきと共にいて耕していた。エリヤは彼のかたわらを通り過ぎて外套を彼の上にかけた。"},{"ref":"1Kgs.19.20","start":11019020,"end":11019020,"break":"none","ruby":[[5,1,"うし"],[7,1,"す"],[17,1,"はし"],[22,1,"い"],[31,2,"ふぼ"],[34,1,"くち"],[48,1,"のち"],[53,1,"したが"],[65,1,"かれ"],[67,1,"い"],[72,1,"い"],[88,1,"なに"]],"text":"エリシャは牛を捨て、エリヤのあとに走ってきて言った、「わたしの父母に口づけさせてください。そして後あなたに従いましょう」。エリヤは彼に言った、「行ってきなさい。わたしはあなたに何をしましたか」。"},{"ref":"1Kgs.19.21","start":11019021,"end":11019021,"break":"none","ruby":[[5,1,"かれ"],[7,1,"はな"],[10,1,"かえ"],[19,1,"うし"],[21,1,"と"],[24,1,"ころ"],[27,1,"うし"],[33,1,"も"],[39,1,"にく"],[41,1,"に"],[46,1,"たみ"],[48,1,"あた"],[51,1,"た"],[56,1,"た"],[59,1,"い"],[66,1,"したが"],[69,1,"かれ"],[71,1,"つか"]],"text":"エリシャは彼を離れて帰り、ひとくびきの牛を取って殺し、牛のくびきを燃やしてその肉を煮、それを民に与えて食べさせ、立って行ってエリヤに従い、彼に仕えた。"}]