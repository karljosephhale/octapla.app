[{"ref":"Gen.44.1","start":1044001,"end":1044001,"break":"paragraph","ruby":[[6,1,"いえ"],[11,1,"めい"],[14,1,"い"],[21,2,"ひとびと"],[24,1,"ふくろ"],[27,1,"はこ"],[32,1,"おお"],[35,2,"しょくりょう"],[38,1,"み"],[47,1,"ぎん"],[49,1,"ふくろ"],[51,1,"くち"],[53,1,"い"]],"text":"さてヨセフは家づかさに命じて言った、「この人々の袋に、運べるだけ多くの食糧を満たし、めいめいの銀を袋の口に入れておきなさい。"},{"ref":"Gen.44.2","start":1044002,"end":1044002,"break":"none","ruby":[[6,1,"さかずき"],[8,1,"ぎん"],[10,1,"さかずき"],[14,2,"としした"],[17,1,"もの"],[19,1,"ふくろ"],[21,1,"くち"],[24,2,"こくもつ"],[27,2,"だいきん"],[30,1,"とも"],[32,1,"い"],[42,1,"いえ"],[51,2,"ことば"]],"text":"またわたしの杯、銀の杯をあの年下の者の袋の口に、穀物の代金と共に入れておきなさい」。家づかさはヨセフの言葉のとおりにした。"},{"ref":"Gen.44.3","start":1044003,"end":1044003,"break":"none","ruby":[[0,1,"よ"],[2,1,"あ"],[9,2,"ひとびと"],[17,1,"おく"],[19,1,"だ"]],"text":"夜が明けると、その人々と、ろばとは送り出されたが、"},{"ref":"Gen.44.4","start":1044004,"end":1044004,"break":"none","ruby":[[0,1,"まち"],[2,1,"で"],[7,1,"とお"],[10,1,"い"],[22,1,"いえ"],[27,1,"い"],[32,1,"た"],[38,2,"ひとびと"],[44,1,"お"],[50,1,"お"],[56,1,"かれ"],[59,1,"い"],[74,1,"あく"],[79,1,"ぜん"],[81,1,"むく"],[95,1,"ぎん"],[97,1,"さかずき"],[99,1,"ぬす"]],"text":"町を出て、まだ遠くへ行かないうちに、ヨセフは家づかさに言った、「立って、あの人々のあとを追いなさい。追いついて、彼らに言いなさい、『あなたがたはなぜ悪をもって善に報いるのですか。なぜわたしの銀の杯を盗んだのですか。"},{"ref":"Gen.44.5","start":1044005,"end":1044005,"break":"none","ruby":[[7,2,"しゅじん"],[10,1,"の"],[12,1,"とき"],[14,1,"つか"],[22,1,"うらな"],[25,1,"もち"],[47,1,"こと"],[49,1,"わる"]],"text":"これはわたしの主人が飲む時に使い、またいつも占いに用いるものではありませんか。あなたがたのした事は悪いことです』」。"},{"ref":"Gen.44.6","start":1044006,"end":1044006,"break":"paragraph","ruby":[[0,1,"いえ"],[5,1,"かれ"],[8,1,"お"],[18,2,"ことば"],[21,1,"かれ"],[24,1,"つ"]],"text":"家づかさが彼らに追いついて、これらの言葉を彼らに告げたとき、"},{"ref":"Gen.44.7","start":1044007,"end":1044007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[10,1,"しゅ"],[25,1,"い"],[39,1,"けっ"]],"text":"彼らは言った、「わが主は、どうしてそのようなことを言われるのですか。しもべらは決してそのようなことはいたしません。"},{"ref":"Gen.44.8","start":1044008,"end":1044008,"break":"none","ruby":[[0,1,"ふくろ"],[2,1,"くち"],[4,1,"み"],[8,1,"ぎん"],[17,1,"ち"],[24,1,"ところ"],[26,1,"も"],[28,1,"かえ"],[46,1,"ご"],[47,2,"しゅじん"],[50,1,"いえ"],[53,1,"ぎん"],[55,1,"きん"],[57,1,"ぬす"]],"text":"袋の口で見つけた銀でさえ、カナンの地からあなたの所に持ち帰ったほどです。どうして、われわれは御主人の家から銀や金を盗みましょう。"},{"ref":"Gen.44.9","start":1044009,"end":1044009,"break":"none","ruby":[[11,1,"ところ"],[16,1,"み"],[25,1,"もの"],[27,1,"し"],[39,1,"しゅ"],[41,2,"どれい"]],"text":"しもべらのうちのだれの所でそれが見つかっても、その者は死に、またわれわれはわが主の奴隷となりましょう」。"},{"ref":"Gen.44.10","start":1044010,"end":1044010,"break":"none","ruby":[[0,1,"いえ"],[5,1,"い"],[20,2,"ことば"],[30,1,"さかずき"],[32,1,"み"],[37,1,"もの"],[43,2,"どれい"],[60,1,"もの"],[62,2,"むざい"]],"text":"家づかさは言った、「それではあなたがたの言葉のようにしよう。杯の見つかった者はわたしの奴隷とならなければならない。ほかの者は無罪です」。"},{"ref":"Gen.44.11","start":1044011,"end":1044011,"break":"none","ruby":[[3,1,"かれ"],[11,1,"いそ"],[14,1,"ふくろ"],[16,1,"ち"],[30,1,"ふくろ"],[32,1,"ひら"]],"text":"そこで彼らは、めいめい急いで袋を地におろし、ひとりひとりその袋を開いた。"},{"ref":"Gen.44.12","start":1044012,"end":1044012,"break":"none","ruby":[[0,1,"いえ"],[5,2,"としうえ"],[9,1,"さが"],[11,1,"はじ"],[14,2,"としした"],[17,1,"おわ"],[22,1,"さかずき"],[30,1,"ふくろ"],[32,1,"なか"]],"text":"家づかさは年上から捜し始めて年下に終ったが、杯はベニヤミンの袋の中にあった。"},{"ref":"Gen.44.13","start":1044013,"end":1044013,"break":"none","ruby":[[3,1,"かれ"],[6,2,"いふく"],[9,1,"さ"],[20,1,"に"],[22,1,"お"],[26,1,"まち"],[28,1,"ひ"],[30,1,"かえ"]],"text":"そこで彼らは衣服を裂き、おのおの、ろばに荷を負わせて町に引き返した。"},{"ref":"Gen.44.14","start":1044014,"end":1044014,"break":"paragraph","ruby":[[3,2,"きょうだい"],[14,1,"いえ"],[36,1,"かれ"],[41,1,"まえ"],[43,1,"ち"],[47,1,"ふ"]],"text":"ユダと兄弟たちとは、ヨセフの家にはいったが、ヨセフがなおそこにいたので、彼らはその前で地にひれ伏した。"},{"ref":"Gen.44.15","start":1044015,"end":1044015,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[24,2,"なにごと"],[37,1,"ひと"],[40,1,"かなら"],[42,1,"うらな"],[44,1,"あ"],[50,1,"し"]],"text":"ヨセフは彼らに言った、「あなたがたのこのしわざは何事ですか。わたしのような人は、必ず占い当てることを知らないのですか」。"},{"ref":"Gen.44.16","start":1044016,"end":1044016,"break":"none","ruby":[[3,1,"い"],[15,1,"しゅ"],[17,1,"なに"],[19,1,"い"],[22,1,"なに"],[24,1,"の"],[26,1,"え"],[41,1,"み"],[43,2,"けっぱく"],[50,1,"え"],[56,1,"かみ"],[63,1,"つみ"],[79,1,"さかずき"],[81,1,"も"],[86,1,"もの"],[89,1,"とも"],[93,1,"しゅ"],[95,2,"どれい"]],"text":"ユダは言った、「われわれはわが主に何を言い、何を述べ得ましょう。どうしてわれわれは身の潔白をあらわし得ましょう。神がしもべらの罪をあばかれました。われわれと、杯を持っていた者とは共にわが主の奴隷となりましょう」。"},{"ref":"Gen.44.17","start":1044017,"end":1044017,"break":"none","ruby":[[4,1,"い"],[13,1,"けっ"],[28,1,"さかずき"],[30,1,"も"],[35,1,"もの"],[43,2,"どれい"],[60,1,"もの"],[62,2,"あんぜん"],[65,1,"ちち"],[70,1,"のぼ"],[73,1,"い"]],"text":"ヨセフは言った、「わたしは決してそのようなことはしない。杯を持っている者だけがわたしの奴隷とならなければならない。ほかの者は安全に父のもとへ上って行きなさい」。"},{"ref":"Gen.44.18","start":1044018,"end":1044018,"break":"paragraph","ruby":[[2,1,"とき"],[6,1,"かれ"],[8,1,"ちか"],[12,1,"い"],[22,1,"しゅ"],[30,1,"しゅ"],[32,1,"みみ"],[38,1,"い"]],"text":"この時ユダは彼に近づいて言った、「ああ、わが主よ、どうぞわが主の耳にひとこと言わせてください。しもべをおこらないでください。あなたはパロのようなかたです。"},{"ref":"Gen.44.19","start":1044019,"end":1044019,"break":"none","ruby":[[2,1,"しゅ"],[9,1,"たず"],[14,1,"ちち"],[22,1,"おとうと"],[29,1,"い"]],"text":"わが主はしもべらに尋ねて、『父があるか、また弟があるか』と言われたので、"},{"ref":"Gen.44.20","start":1044020,"end":1044020,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"い"],[22,2,"ろうれい"],[25,1,"ちち"],[32,2,"としよ"],[35,1,"こ"],[37,1,"おとうと"],[46,1,"あに"],[48,1,"し"],[52,1,"おな"],[54,1,"はは"],[56,1,"こ"],[58,1,"のこ"],[76,1,"ちち"],[81,1,"あい"]],"text":"われわれはわが主に言いました、『われわれには老齢の父があり、また年寄り子の弟があります。その兄は死んで、同じ母の子で残っているのは、ただこれだけですから父はこれを愛しています』。"},{"ref":"Gen.44.21","start":1044021,"end":1044021,"break":"none","ruby":[[2,1,"とき"],[12,1,"い"],[22,1,"もの"],[28,1,"ところ"],[30,1,"つ"],[44,1,"め"],[46,1,"かれ"],[48,1,"み"]],"text":"その時あなたはしもべらに言われました、『その者をわたしの所へ連れてきなさい。わたしはこの目で彼を見よう』。"},{"ref":"Gen.44.22","start":1044022,"end":1044022,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"い"],[18,1,"こ"],[19,1,"とも"],[21,1,"ちち"],[23,1,"はな"],[37,1,"ちち"],[39,1,"はな"],[43,1,"ちち"],[45,1,"し"]],"text":"われわれはわが主に言いました。『その子供は父を離れることができません。もし父を離れたら父は死ぬでしょう』。"},{"ref":"Gen.44.23","start":1044023,"end":1044023,"break":"none","ruby":[[13,1,"い"],[21,1,"すえ"],[23,1,"おとうと"],[25,2,"いっしょ"],[28,1,"くだ"],[43,1,"ふたた"],[49,1,"かお"],[51,1,"み"]],"text":"しかし、あなたはしもべらに言われました、『末の弟が一緒に下ってこなければ、おまえたちは再びわたしの顔を見ることはできない』。"},{"ref":"Gen.44.24","start":1044024,"end":1044024,"break":"none","ruby":[[13,1,"ちち"],[18,1,"のぼ"],[24,1,"しゅ"],[26,2,"ことば"],[29,1,"かれ"],[31,1,"つ"]],"text":"それであなたのしもべである父のもとに上って、わが主の言葉を彼に告げました。"},{"ref":"Gen.44.25","start":1044025,"end":1044025,"break":"none","ruby":[[5,1,"ちち"],[14,1,"ふたた"],[16,1,"い"],[28,1,"すこ"],[31,2,"しょくりょう"],[34,1,"か"],[44,1,"い"]],"text":"ところで、父が『おまえたちは再び行って、われわれのために少しの食糧を買ってくるように』と言ったので、"},{"ref":"Gen.44.26","start":1044026,"end":1044026,"break":"none","ruby":[[5,1,"い"],[17,1,"くだ"],[20,1,"い"],[28,1,"すえ"],[30,1,"おとうと"],[32,2,"いっしょ"],[38,1,"い"],[45,1,"すえ"],[47,1,"おとうと"],[49,2,"いっしょ"],[59,1,"ひと"],[61,1,"かお"],[63,1,"み"]],"text":"われわれは言いました、『われわれは下って行けません。もし末の弟が一緒であれば行きましょう。末の弟が一緒でなければ、あの人の顔を見ることができません』。"},{"ref":"Gen.44.27","start":1044027,"end":1044027,"break":"none","ruby":[[10,1,"ちち"],[12,1,"い"],[25,1,"し"],[34,1,"つま"],[44,1,"こ"],[46,1,"う"]],"text":"あなたのしもべである父は言いました、『おまえたちの知っているとおり、妻はわたしにふたりの子を産んだ。"},{"ref":"Gen.44.28","start":1044028,"end":1044028,"break":"none","ruby":[[4,1,"そと"],[6,1,"で"],[13,1,"さ"],[15,1,"ころ"],[22,1,"おも"],[29,1,"いま"],[35,1,"かれ"],[37,1,"み"]],"text":"ひとりは外へ出たが、きっと裂き殺されたのだと思う。わたしは今になっても彼を見ない。"},{"ref":"Gen.44.29","start":1044029,"end":1044029,"break":"none","ruby":[[10,1,"こ"],[18,1,"と"],[21,1,"い"],[25,1,"かれ"],[27,1,"わざわい"],[29,1,"あ"],[48,1,"かな"],[52,2,"よみ"],[55,1,"くだ"]],"text":"もしおまえたちがこの子をもわたしから取って行って、彼が災に会えば、おまえたちは、しらがのわたしを悲しんで陰府に下らせるであろう』。"},{"ref":"Gen.44.30","start":1044030,"end":1044030,"break":"none","ruby":[[14,1,"ちち"],[19,1,"かえ"],[22,1,"い"],[31,2,"こども"],[34,2,"いっしょ"],[53,1,"ちち"],[55,1,"たましい"],[57,2,"こども"],[60,1,"たましい"],[62,1,"むす"]],"text":"わたしがあなたのしもべである父のもとに帰って行くとき、もしこの子供が一緒にいなかったら、どうなるでしょう。父の魂は子供の魂に結ばれているのです。"},{"ref":"Gen.44.31","start":1044031,"end":1044031,"break":"none","ruby":[[2,2,"こども"],[10,2,"いっしょ"],[18,1,"み"],[22,1,"ちち"],[24,1,"し"],[56,1,"ちち"],[58,1,"かな"],[62,2,"よみ"],[65,1,"くだ"]],"text":"この子供がわれわれと一緒にいないのを見たら、父は死ぬでしょう。そうすればしもべらは、あなたのしもべであるしらがの父を悲しんで陰府に下らせることになるでしょう。"},{"ref":"Gen.44.32","start":1044032,"end":1044032,"break":"none","ruby":[[4,1,"ちち"],[8,2,"こども"],[11,1,"み"],[13,1,"う"],[15,1,"あ"],[27,1,"こ"],[36,1,"つ"],[38,1,"かえ"],[50,1,"ちち"],[52,1,"たい"],[55,2,"えいきゅう"],[58,1,"つみ"],[60,1,"お"],[68,1,"い"]],"text":"しもべは父にこの子供の身を請け合って『もしわたしがこの子をあなたのもとに連れ帰らなかったら、わたしは父に対して永久に罪を負いましょう』と言ったのです。"},{"ref":"Gen.44.33","start":1044033,"end":1044033,"break":"none","ruby":[[10,2,"こども"],[13,1,"かわ"],[19,1,"しゅ"],[21,2,"どれい"],[34,2,"こども"],[37,2,"きょうだい"],[42,2,"いっしょ"],[45,1,"のぼ"],[47,1,"い"]],"text":"どうか、しもべをこの子供の代りに、わが主の奴隷としてとどまらせ、この子供を兄弟たちと一緒に上り行かせてください、"},{"ref":"Gen.44.34","start":1044034,"end":1044034,"break":"none","ruby":[[2,2,"こども"],[5,1,"つ"],[18,1,"ちち"],[23,1,"のぼ"],[25,1,"い"],[37,1,"ちち"],[39,1,"わざわい"],[41,1,"あ"],[45,1,"み"],[48,1,"しの"]],"text":"この子供を連れずに、どうしてわたしは父のもとに上り行くことができましょう。父が災に会うのを見るに忍びません」。"}]