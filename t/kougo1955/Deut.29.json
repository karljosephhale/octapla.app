[{"ref":"Deut.29.1","start":5029001,"end":5029001,"break":"paragraph","ruby":[[3,1,"しゅ"],[9,1,"めい"],[17,1,"ち"],[25,2,"ひとびと"],[28,1,"むす"],[34,2,"けいやく"],[37,2,"ことば"],[48,1,"かれ"],[51,1,"むす"],[55,2,"けいやく"]],"text":"これは主がモーセに命じて、モアブの地でイスラエルの人々と結ばせられた契約の言葉であって、ホレブで彼らと結ばれた契約のほかのものである。"},{"ref":"Deut.29.2","start":5029002,"end":5029002,"break":"paragraph","ruby":[[14,1,"ひと"],[16,1,"よ"],[18,1,"あつ"],[21,1,"い"],[32,1,"しゅ"],[39,1,"ち"],[52,2,"けらい"],[58,1,"ぜん"],[59,1,"ち"],[70,1,"こと"],[77,1,"み"]],"text":"モーセはイスラエルのすべての人を呼び集めて言った、「あなたがたは主がエジプトの地で、パロと、そのすべての家来と、その全地とにせられたすべての事をまのあたり見た。"},{"ref":"Deut.29.3","start":5029003,"end":5029003,"break":"none","ruby":[[6,1,"おお"],[9,1,"こころ"],[18,1,"おお"],[21,3,"ふしぎ"],[31,1,"み"]],"text":"すなわちその大きな試みと、しるしと、大きな不思議とをまのあたり見たのである。"},{"ref":"Deut.29.4","start":5029004,"end":5029004,"break":"none","ruby":[[4,2,"こんにち"],[8,1,"しゅ"],[16,1,"こころ"],[18,1,"さと"],[23,1,"め"],[25,1,"み"],[30,1,"みみ"],[32,1,"き"]],"text":"しかし、今日まで主はあなたがたの心に悟らせず、目に見させず、耳に聞かせられなかった。"},{"ref":"Deut.29.5","start":5029005,"end":5029005,"break":"none","ruby":[[6,1,"ねん"],[8,1,"あいだ"],[16,1,"みちび"],[19,2,"あらの"],[22,1,"とお"],[34,1,"み"],[39,2,"きもの"],[42,1,"ふる"],[46,1,"あし"],[51,1,"ふる"]],"text":"わたしは四十年の間、あなたがたを導いて荒野を通らせたが、あなたがたの身につけた着物は古びず、足のくつは古びなかった。"},{"ref":"Deut.29.6","start":5029006,"end":5029006,"break":"none","ruby":[[11,1,"た"],[18,1,"しゅ"],[20,1,"こ"],[22,1,"さけ"],[24,1,"の"],[52,1,"かみ"],[54,1,"しゅ"],[61,1,"し"],[64,1,"いた"]],"text":"あなたがたはまたパンも食べず、ぶどう酒も濃い酒も飲まなかった。こうしてあなたがたは、わたしがあなたがたの神、主であることを知るに至った。"},{"ref":"Deut.29.7","start":5029007,"end":5029007,"break":"none","ruby":[[8,1,"ところ"],[20,1,"おう"],[31,1,"おう"],[40,1,"むか"],[43,1,"たたか"],[53,1,"かれ"],[56,1,"う"],[58,1,"やぶ"]],"text":"あなたがたがこの所にきたとき、ヘシボンの王シホンと、バシャンの王オグがわれわれを迎えて戦ったが、われわれは彼らを撃ち敗って、"},{"ref":"Deut.29.8","start":5029008,"end":5029008,"break":"none","ruby":[[2,1,"ち"],[4,1,"と"],[29,1,"なか"],[34,1,"し"],[35,1,"ぎょう"],[39,1,"あた"]],"text":"その地を取り、これをルベンびとと、ガドびとと、マナセびとの半ばとに、嗣業として与えた。"},{"ref":"Deut.29.9","start":5029009,"end":5029009,"break":"none","ruby":[[13,2,"けいやく"],[16,2,"ことば"],[19,1,"まも"],[26,1,"おこな"],[54,1,"こと"],[56,1,"さか"]],"text":"それゆえ、あなたがたはこの契約の言葉を守って、それを行わなければならない。そうすればあなたがたのするすべての事は栄えるであろう。"},{"ref":"Deut.29.10","start":5029010,"end":5029010,"break":"paragraph","ruby":[[6,1,"みな"],[18,1,"かみ"],[20,1,"しゅ"],[22,1,"まえ"],[24,1,"た"],[40,2,"ぶぞく"],[49,2,"ちょうろう"],[72,2,"ひとびと"]],"text":"あなたがたは皆、きょう、あなたがたの神、主の前に立っている。すなわちあなたがたの部族のかしらたち、長老たち、つかさたちなど、イスラエルのすべての人々、"},{"ref":"Deut.29.11","start":5029011,"end":5029011,"break":"none","ruby":[[6,1,"ちい"],[9,1,"もの"],[14,1,"つま"],[19,2,"しゅくえい"],[25,2,"きりゅう"],[31,2,"たこく"],[33,1,"じん"],[48,1,"わ"],[50,1,"もの"],[53,1,"みず"],[57,1,"もの"],[62,1,"しゅ"],[64,1,"まえ"],[66,1,"た"]],"text":"あなたがたの小さい者たちも、妻たちも、宿営のうちに寄留している他国人も、あなたのために、たきぎを割る者も、水をくむ者も、みな主の前に立って、"},{"ref":"Deut.29.12","start":5029012,"end":5029012,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[17,1,"むす"],[25,1,"かみ"],[27,1,"しゅ"],[29,2,"けいやく"],[32,1,"ちか"]],"text":"あなたの神、主が、きょう、あなたと結ばれるあなたの神、主の契約と誓いとに、はいろうとしている。"},{"ref":"Deut.29.13","start":5029013,"end":5029013,"break":"none","ruby":[[3,1,"しゅ"],[12,2,"やくそく"],[27,2,"せんぞ"],[43,1,"ちか"],[59,1,"た"],[62,2,"じぶん"],[65,1,"たみ"],[79,1,"かみ"]],"text":"これは主がさきにあなたに約束されたように、またあなたの先祖アブラハム、イサク、ヤコブに誓われたように、きょう、あなたを立てて自分の民とし、またみずからあなたの神となられるためである。"},{"ref":"Deut.29.14","start":5029014,"end":5029014,"break":"none","ruby":[[17,2,"けいやく"],[20,1,"ちか"],[24,1,"むす"]],"text":"わたしはただあなたがたとだけ、この契約と誓いとを結ぶのではない。"},{"ref":"Deut.29.15","start":5029015,"end":5029015,"break":"none","ruby":[[13,1,"かみ"],[15,1,"しゅ"],[17,1,"まえ"],[24,1,"とも"],[26,1,"た"],[31,1,"もの"],[49,1,"とも"],[54,1,"もの"],[57,1,"むす"]],"text":"きょう、ここで、われわれの神、主の前にわれわれと共に立っている者ならびに、きょう、ここにわれわれと共にいない者とも結ぶのである。"},{"ref":"Deut.29.16","start":5029016,"end":5029016,"break":"paragraph","ruby":[[15,1,"くに"],[17,1,"す"],[29,2,"くにぐに"],[32,1,"たみ"],[34,1,"なか"],[36,1,"とお"],[52,1,"し"]],"text":"われわれがどのようにエジプトの国に住んでいたか、どのように国々の民の中を通ってきたか、それはあなたがたが知っている。"},{"ref":"Deut.29.17","start":5029017,"end":5029017,"break":"none","ruby":[[8,1,"き"],[10,1,"いし"],[12,1,"ぎん"],[14,1,"きん"],[16,1,"つく"],[19,1,"にく"],[23,1,"もの"],[25,2,"ぐうぞう"],[30,1,"かれ"],[40,1,"み"]],"text":"またあなたがたは木や石や銀や金で造った憎むべき物と偶像とが、彼らのうちにあるのを見た。"},{"ref":"Deut.29.18","start":5029018,"end":5029018,"break":"none","ruby":[[21,1,"こころ"],[28,1,"かみ"],[30,1,"しゅ"],[32,1,"はな"],[39,2,"こくみん"],[42,2,"かみがみ"],[45,1,"い"],[48,1,"つか"],[51,1,"おとこ"],[53,1,"おんな"],[55,2,"しぞく"],[58,2,"ぶぞく"],[82,2,"どくそう"],[92,1,"しょう"],[95,1,"ね"]],"text":"それゆえ、あなたがたのうちに、きょう、その心にわれわれの神、主を離れてそれらの国民の神々に行って仕える男や女、氏族や部族があってはならない。またあなたがたのうちに、毒草や、にがよもぎを生ずる根があってはならない。"},{"ref":"Deut.29.19","start":5029019,"end":5029019,"break":"none","ruby":[[5,1,"ひと"],[9,1,"ちか"],[12,2,"ことば"],[15,1,"き"],[20,1,"こころ"],[22,2,"じぶん"],[25,2,"しゅくふく"],[30,1,"こころ"],[39,1,"あゆ"],[48,2,"へいあん"],[55,1,"い"],[67,1,"うるお"],[70,1,"もの"],[77,1,"もの"],[83,1,"ほろ"]],"text":"そのような人はこの誓いの言葉を聞いても、心に自分を祝福して『心をかたくなにして歩んでもわたしには平安がある』と言うであろう。そうすれば潤った者も、かわいた者もひとしく滅びるであろう。"},{"ref":"Deut.29.20","start":5029020,"end":5029020,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"ひと"],[15,1,"この"],[25,1,"しゅ"],[29,1,"ひと"],[31,1,"いか"],[38,1,"はっ"],[43,2,"しょもつ"],[59,1,"かれ"],[61,1,"うえ"],[63,1,"くわ"],[66,1,"しゅ"],[73,1,"ひと"],[75,1,"な"],[77,1,"てん"],[79,1,"した"],[82,1,"け"],[84,1,"さ"]],"text":"主はそのような人をゆるすことを好まれない。かえって主はその人に怒りとねたみを発し、この書物にしるされたすべてののろいを彼の上に加え、主はついにその人の名を天の下から消し去られるであろう。"},{"ref":"Deut.29.21","start":5029021,"end":5029021,"break":"none","ruby":[[0,1,"しゅ"],[12,2,"ぶぞく"],[21,1,"ひと"],[23,1,"く"],[24,1,"べっ"],[27,1,"わざわい"],[35,2,"りっぽう"],[38,1,"しょ"],[45,2,"けいやく"],[48,1,"なか"]],"text":"主はイスラエルのすべての部族のうちからその人を区別して災をくだし、この律法の書にしるされた契約の中のもろもろののろいのようにされるであろう。"},{"ref":"Deut.29.22","start":5029022,"end":5029022,"break":"none","ruby":[[0,1,"のち"],[2,1,"よ"],[4,1,"ひと"],[19,1,"おこ"],[27,2,"しそん"],[32,1,"とお"],[34,1,"くに"],[37,1,"く"],[39,2,"がいこく"],[41,1,"じん"],[46,1,"ち"],[48,1,"わざわい"],[50,1,"み"],[52,1,"しゅ"],[56,1,"ち"],[63,2,"びょうき"],[66,1,"み"],[68,1,"い"]],"text":"後の代の人、すなわちあなたがたののちに起るあなたがたの子孫および遠い国から来る外国人は、この地の災を見、主がこの地にくだされた病気を見て言うであろう。"},{"ref":"Deut.29.23","start":5029023,"end":5029023,"break":"none","ruby":[[2,1,"ぜん"],[3,1,"ち"],[5,2,"いおう"],[11,1,"しお"],[16,1,"や"],[18,1,"つち"],[24,1,"たね"],[31,1,"み"],[33,1,"むす"],[40,1,"くさ"],[42,1,"しょう"],[53,1,"しゅ"],[55,1,"いか"],[58,1,"いきどお"],[64,1,"ほろ"],[86,2,"はめつ"]],"text":"――全地は硫黄となり、塩となり、焼け土となって、種もまかれず、実も結ばず、なんの草も生じなくなって、むかし主が怒りと憤りをもって滅ぼされたソドム、ゴモラ、アデマ、ゼボイムの破滅のようである。――"},{"ref":"Deut.29.24","start":5029024,"end":5029024,"break":"none","ruby":[[10,2,"こくみん"],[13,1,"い"],[24,1,"しゅ"],[28,1,"ち"],[46,1,"はげ"],[49,1,"おお"],[53,1,"いか"],[56,1,"なに"]],"text":"すなわち、もろもろの国民は言うであろう、『なぜ、主はこの地にこのようなことをされたのか。この激しい大いなる怒りは何ゆえか』。"},{"ref":"Deut.29.25","start":5029025,"end":5029025,"break":"none","ruby":[[4,2,"ひとびと"],[7,1,"い"],[15,1,"かれ"],[20,2,"せんぞ"],[23,1,"かみ"],[25,1,"しゅ"],[32,1,"くに"],[35,1,"かれ"],[38,1,"みちび"],[40,1,"だ"],[43,1,"かれ"],[46,1,"むす"],[50,2,"けいやく"]],"text":"そのとき人々は言うであろう、『彼らはその先祖の神、主がエジプトの国から彼らを導き出して彼らと結ばれた契約をすて、"},{"ref":"Deut.29.26","start":5029026,"end":5029026,"break":"none","ruby":[[0,1,"い"],[3,1,"かれ"],[6,1,"し"],[13,1,"さず"],[22,2,"かみがみ"],[25,1,"つか"],[32,1,"おが"]],"text":"行って彼らの知らない、また授からない、ほかの神々に仕えて、それを拝んだからである。"},{"ref":"Deut.29.27","start":5029027,"end":5029027,"break":"none","ruby":[[4,1,"しゅ"],[8,1,"ち"],[14,1,"いか"],[17,1,"はっ"],[22,2,"しょもつ"]],"text":"それゆえ主はこの地にむかって怒りを発し、この書物にしるされたもろもろののろいをこれにくだし、"},{"ref":"Deut.29.28","start":5029028,"end":5029028,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"いか"],[13,1,"いか"],[16,1,"おお"],[20,1,"いきどお"],[27,1,"かれ"],[32,1,"ち"],[35,1,"ぬ"],[37,1,"と"],[44,1,"くに"],[46,1,"な"],[53,2,"こんにち"],[55,1,"み"]],"text":"そして主は怒りと、はげしい怒りと大いなる憤りとをもって彼らをこの地から抜き取って、ほかの国に投げやられた。今日見るとおりである』。"},{"ref":"Deut.29.29","start":5029029,"end":5029029,"break":"paragraph","ruby":[[0,1,"かく"],[3,1,"こと"],[10,1,"かみ"],[12,1,"しゅ"],[14,1,"ぞく"],[26,1,"あら"],[34,1,"なが"],[46,2,"しそん"],[49,1,"ぞく"],[59,2,"りっぽう"],[66,2,"ことば"],[69,1,"おこな"]],"text":"隠れた事はわれわれの神、主に属するものである。しかし表わされたことは長くわれわれとわれわれの子孫に属し、われわれにこの律法のすべての言葉を行わせるのである。"}]