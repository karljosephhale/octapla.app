[{"ref":"Acts.13.1","start":44013001,"end":44013001,"break":"paragraph","ruby":[[11,2,"きょうかい"],[25,1,"よ"],[37,1,"びと"],[42,2,"りょうしゅ"],[48,3,"ちきょうだい"],[65,3,"よげんしゃ"],[69,2,"きょうし"]],"text":"さて、アンテオケにある教会には、バルナバ、ニゲルと呼ばれるシメオン、クレネ人ルキオ、領主ヘロデの乳兄弟マナエン、およびサウロなどの預言者や教師がいた。"},{"ref":"Acts.13.2","start":44013002,"end":44013002,"break":"none","ruby":[[0,2,"いちどう"],[3,1,"しゅ"],[5,2,"れいはい"],[12,2,"だんじき"],[21,2,"せいれい"],[46,1,"せい"],[47,1,"べつ"],[51,1,"かれ"],[54,1,"さづ"],[60,2,"しごと"],[63,1,"あた"],[71,1,"つ"]],"text":"一同が主に礼拝をささげ、断食をしていると、聖霊が「さあ、バルナバとサウロとを、わたしのために聖別して、彼らに授けておいた仕事に当らせなさい」と告げた。"},{"ref":"Acts.13.3","start":44013003,"end":44013003,"break":"none","ruby":[[3,2,"いちどう"],[7,2,"だんじき"],[10,1,"いのり"],[16,1,"て"],[22,1,"うえ"],[27,1,"のち"],[29,2,"しゅっぱつ"]],"text":"そこで一同は、断食と祈とをして、手をふたりの上においた後、出発させた。"},{"ref":"Acts.13.4","start":44013004,"end":44013004,"break":"paragraph","ruby":[[4,2,"せいれい"],[7,1,"おく"],[9,1,"だ"],[27,1,"ふね"],[33,1,"わた"]],"text":"ふたりは聖霊に送り出されて、セルキヤにくだり、そこから舟でクプロに渡った。"},{"ref":"Acts.13.5","start":44013005,"end":44013005,"break":"none","ruby":[[8,1,"つ"],[15,1,"じん"],[17,1,"しょ"],[18,2,"かいどう"],[21,1,"かみ"],[23,1,"ことば"],[25,1,"の"],[32,1,"かれ"],[39,1,"たす"],[41,1,"て"],[45,1,"つ"]],"text":"そしてサラミスに着くと、ユダヤ人の諸会堂で神の言を宣べはじめた。彼らはヨハネを助け手として連れていた。"},{"ref":"Acts.13.6","start":44013006,"end":44013006,"break":"none","ruby":[[0,1,"しま"],[1,2,"ぜんたい"],[4,2,"じゅんかい"],[14,1,"い"],[27,1,"じん"],[29,2,"まじゅつ"],[31,1,"し"],[43,3,"よげんしゃ"],[47,2,"であ"]],"text":"島全体を巡回して、パポスまで行ったところ、そこでユダヤ人の魔術師、バルイエスというにせ預言者に出会った。"},{"ref":"Acts.13.7","start":44013007,"end":44013007,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ちほう"],[4,2,"そうとく"],[19,2,"でい"],[30,2,"そうとく"],[33,2,"けんめい"],[36,1,"ひと"],[52,1,"まね"],[56,1,"かみ"],[58,1,"ことば"],[60,1,"き"]],"text":"彼は地方総督セルギオ・パウロのところに出入りをしていた。この総督は賢明な人であって、バルナバとサウロとを招いて、神の言を聞こうとした。"},{"ref":"Acts.13.8","start":44013008,"end":44013008,"break":"none","ruby":[[4,2,"まじゅつ"],[6,1,"し"],[11,1,"かれ"],[13,1,"な"],[16,2,"まじゅつ"],[18,1,"し"],[22,1,"い"],[26,2,"そうとく"],[29,2,"しんこう"],[49,2,"じゃま"]],"text":"ところが魔術師エルマ（彼の名は「魔術師」との意）は、総督を信仰からそらそうとして、しきりにふたりの邪魔をした。"},{"ref":"Acts.13.9","start":44013009,"end":44013009,"break":"none","ruby":[[7,1,"な"],[14,2,"せいれい"],[17,1,"み"],[22,1,"かれ"]],"text":"サウロ、またの名はパウロ、は聖霊に満たされ、彼をにらみつけて"},{"ref":"Acts.13.10","start":44013010,"end":44013010,"break":"none","ruby":[[0,1,"い"],[12,1,"いつわ"],[15,2,"じゃあく"],[26,2,"あくま"],[29,1,"こ"],[35,1,"ただ"],[41,1,"てき"],[44,1,"しゅ"],[51,1,"みち"],[53,1,"ま"],[59,1,"や"]],"text":"言った、「ああ、あらゆる偽りと邪悪とでかたまっている悪魔の子よ、すべて正しいものの敵よ。主のまっすぐな道を曲げることを止めないのか。"},{"ref":"Acts.13.11","start":44013011,"end":44013011,"break":"none","ruby":[[0,1,"み"],[3,1,"しゅ"],[6,1,"て"],[12,1,"うえ"],[14,1,"およ"],[24,1,"めくら"],[30,2,"とうぶん"],[33,1,"ひ"],[35,1,"ひかり"],[37,1,"み"],[60,1,"かれ"],[69,1,"かれ"],[71,1,"て"],[80,1,"て"],[82,1,"ひ"],[88,1,"ひと"],[90,1,"さが"]],"text":"見よ、主のみ手がおまえの上に及んでいる。おまえは盲になって、当分、日の光が見えなくなるのだ」。たちまち、かすみとやみとが彼にかかったため、彼は手さぐりしながら、手を引いてくれる人を捜しまわった。"},{"ref":"Acts.13.12","start":44013012,"end":44013012,"break":"none","ruby":[[0,2,"そうとく"],[5,3,"できごと"],[9,1,"み"],[12,1,"しゅ"],[14,1,"おしえ"],[20,1,"おどろ"],[26,1,"しん"]],"text":"総督はこの出来事を見て、主の教にすっかり驚き、そして信じた。"},{"ref":"Acts.13.13","start":44013013,"end":44013013,"break":"paragraph","ruby":[[6,2,"いっこう"],[15,2,"ふなで"],[30,1,"わた"],[41,2,"いっこう"],[45,1,"み"],[47,1,"ひ"],[57,1,"かえ"]],"text":"パウロとその一行は、パポスから船出して、パンフリヤのペルガに渡った。ここでヨハネは一行から身を引いて、エルサレムに帰ってしまった。"},{"ref":"Acts.13.14","start":44013014,"end":44013014,"break":"none","ruby":[[16,1,"すす"],[31,1,"い"],[34,3,"あんそくにち"],[38,2,"かいどう"],[45,1,"せき"],[47,1,"つ"]],"text":"しかしふたりは、ペルガからさらに進んで、ピシデヤのアンテオケに行き、安息日に会堂にはいって席に着いた。"},{"ref":"Acts.13.15","start":44013015,"end":44013015,"break":"none","ruby":[[0,2,"りっぽう"],[3,2,"よげん"],[5,1,"しょ"],[7,2,"ろうどく"],[16,3,"かいどうづかさ"],[22,1,"かれ"],[29,1,"ひと"],[38,2,"きょうだい"],[62,2,"ひとびと"],[65,1,"なに"],[67,2,"しょうれい"],[70,2,"ことば"],[84,1,"はな"],[86,1,"くだ"],[91,1,"い"]],"text":"律法と預言書の朗読があったのち、会堂司たちが彼らのところに人をつかわして、「兄弟たちよ、もしあなたがたのうち、どなたか、この人々に何か奨励の言葉がありましたら、どうぞお話し下さい」と言わせた。"},{"ref":"Acts.13.16","start":44013016,"end":44013016,"break":"none","breaks":[[24,"paragraph"]],"ruby":[[7,1,"た"],[13,1,"て"],[15,1,"ふ"],[20,1,"い"],[31,1,"ひと"],[39,1,"かみ"],[41,1,"うやま"],[50,1,"き"],[52,1,"くだ"]],"text":"そこでパウロが立ちあがり、手を振りながら言った。「イスラエルの人たち、ならびに神を敬うかたがたよ、お聞き下さい。"},{"ref":"Acts.13.17","start":44013017,"end":44013017,"break":"none","ruby":[[2,1,"たみ"],[9,1,"かみ"],[18,2,"せんぞ"],[21,1,"えら"],[29,1,"ち"],[31,2,"たいざい"],[33,1,"ちゅう"],[37,1,"たみ"],[39,1,"おお"],[49,1,"うで"],[51,1,"たか"],[55,1,"あ"],[59,1,"かれ"],[64,1,"ち"],[67,1,"みちび"],[69,1,"だ"]],"text":"この民イスラエルの神は、わたしたちの先祖を選び、エジプトの地に滞在中、この民を大いなるものとし、み腕を高くさし上げて、彼らをその地から導き出された。"},{"ref":"Acts.13.18","start":44013018,"end":44013018,"break":"none","ruby":[[3,1,"やく"],[6,1,"ねん"],[13,2,"あらの"],[16,1,"かれ"]],"text":"そして約四十年にわたって、荒野で彼らをはぐくみ、"},{"ref":"Acts.13.19","start":44013019,"end":44013019,"break":"none","ruby":[[4,1,"ち"],[10,1,"い"],[11,2,"みんぞく"],[14,1,"う"],[16,1,"ほろ"],[22,1,"ち"],[24,1,"かれ"],[27,1,"ゆず"],[29,1,"あた"]],"text":"カナンの地では七つの異民族を打ち滅ぼし、その地を彼らに譲り与えられた。"},{"ref":"Acts.13.20","start":44013020,"end":44013020,"break":"none","ruby":[[7,1,"やく"],[12,1,"ねん"],[14,2,"ねんげつ"],[24,1,"のち"],[26,1,"かみ"],[31,1,"ひと"],[44,3,"よげんしゃ"],[52,1,"とき"],[54,1,"およ"]],"text":"それらのことが約四百五十年の年月にわたった。その後、神はさばき人たちをおつかわしになり、預言者サムエルの時に及んだ。"},{"ref":"Acts.13.21","start":44013021,"end":44013021,"break":"none","ruby":[[2,1,"とき"],[4,2,"ひとびと"],[7,1,"おう"],[9,2,"ようきゅう"],[16,1,"かみ"],[23,1,"ぞく"],[25,1,"ひと"],[30,1,"こ"],[37,2,"ねんかん"],[40,1,"かれ"]],"text":"その時、人々が王を要求したので、神はベニヤミン族の人、キスの子サウロを四十年間、彼らにおつかわしになった。"},{"ref":"Acts.13.22","start":44013022,"end":44013022,"break":"none","ruby":[[4,1,"かみ"],[10,1,"しりぞ"],[17,1,"た"],[20,1,"おう"],[27,1,"かれ"],[49,1,"こ"],[54,1,"み"],[59,1,"かれ"],[65,1,"こころ"],[71,1,"ひと"],[78,1,"おも"],[90,2,"じっこう"],[103,1,"い"]],"text":"それから神はサウロを退け、ダビデを立てて王とされたが、彼についてあかしをして、『わたしはエッサイの子ダビデを見つけた。彼はわたしの心にかなった人で、わたしの思うところを、ことごとく実行してくれるであろう』と言われた。"},{"ref":"Acts.13.23","start":44013023,"end":44013023,"break":"none","ruby":[[0,1,"かみ"],[2,2,"やくそく"],[17,2,"しそん"],[20,1,"なか"],[23,2,"すくいぬし"],[35,1,"おく"]],"text":"神は約束にしたがって、このダビデの子孫の中から救主イエスをイスラエルに送られたが、"},{"ref":"Acts.13.24","start":44013024,"end":44013024,"break":"none","ruby":[[6,1,"まえ"],[23,1,"たみ"],[25,2,"くいあらた"],[41,1,"の"],[43,1,"つた"]],"text":"そのこられる前に、ヨハネがイスラエルのすべての民に悔改めのバプテスマを、あらかじめ宣べ伝えていた。"},{"ref":"Acts.13.25","start":44013025,"end":44013025,"break":"none","ruby":[[6,2,"いっしょう"],[9,2,"こうてい"],[12,1,"おわ"],[19,1,"あた"],[22,1,"い"],[38,1,"かんが"],[46,1,"もの"],[64,1,"く"],[81,1,"ぬ"],[88,1,"ね"]],"text":"ヨハネはその一生の行程を終ろうとするに当って言った、『わたしは、あなたがたが考えているような者ではない。しかし、わたしのあとから来るかたがいる。わたしはそのくつを脱がせてあげる値うちもない』。"},{"ref":"Acts.13.26","start":44013026,"end":44013026,"break":"none","ruby":[[0,2,"きょうだい"],[11,2,"しそん"],[23,1,"みな"],[27,1,"なか"],[29,1,"かみ"],[31,1,"うやま"],[33,1,"ひと"],[40,1,"すくい"],[42,2,"ことば"],[51,1,"おく"]],"text":"兄弟たち、アブラハムの子孫のかたがた、ならびに皆さんの中の神を敬う人たちよ。この救の言葉はわたしたちに送られたのである。"},{"ref":"Acts.13.27","start":44013027,"end":44013027,"break":"none","ruby":[[6,1,"す"],[8,2,"ひとびと"],[13,3,"しどうしゃ"],[24,1,"みと"],[28,1,"けい"],[30,1,"しょ"],[40,3,"あんそくにち"],[46,1,"よ"],[48,3,"よげんしゃ"],[52,2,"ことば"],[55,2,"じょうじゅ"]],"text":"エルサレムに住む人々やその指導者たちは、イエスを認めずに刑に処し、それによって、安息日ごとに読む預言者の言葉が成就した。"},{"ref":"Acts.13.28","start":44013028,"end":44013028,"break":"none","ruby":[[6,1,"し"],[8,1,"あた"],[10,2,"りゆう"],[13,1,"み"],[28,2,"きょうよう"],[36,1,"ころ"]],"text":"また、なんら死に当る理由が見いだせなかったのに、ピラトに強要してイエスを殺してしまった。"},{"ref":"Acts.13.29","start":44013029,"end":44013029,"break":"none","ruby":[[11,1,"か"],[20,1,"みな"],[23,1,"と"],[29,2,"ひとびと"],[36,1,"き"],[39,1,"と"],[45,1,"はか"],[47,1,"ほうむ"]],"text":"そして、イエスについて書いてあることを、皆なし遂げてから、人々はイエスを木から取りおろして墓に葬った。"},{"ref":"Acts.13.30","start":44013030,"end":44013030,"break":"none","ruby":[[4,1,"かみ"],[10,2,"しにん"],[13,1,"なか"]],"text":"しかし、神はイエスを死人の中から、よみがえらせたのである。"},{"ref":"Acts.13.31","start":44013031,"end":44013031,"break":"none","ruby":[[17,2,"いっしょ"],[20,1,"のぼ"],[23,1,"ひと"],[28,2,"いくにち"],[35,1,"あらわ"],[42,1,"かれ"],[45,1,"いま"],[48,2,"ひとびと"],[51,1,"たい"],[58,2,"しょうにん"]],"text":"イエスは、ガリラヤからエルサレムへ一緒に上った人たちに、幾日ものあいだ現れ、そして、彼らは今や、人々に対してイエスの証人となっている。"},{"ref":"Acts.13.32","start":44013032,"end":44013032,"break":"none","ruby":[[7,1,"かみ"],[9,2,"せんぞ"],[14,1,"たい"],[21,2,"やくそく"],[28,1,"の"],[30,1,"つた"]],"text":"わたしたちは、神が先祖たちに対してなされた約束を、ここに宣べ伝えているのである。"},{"ref":"Acts.13.33","start":44013033,"end":44013033,"break":"none","ruby":[[0,1,"かみ"],[20,2,"しそん"],[25,2,"やくそく"],[30,1,"はた"],[40,2,"しへん"],[43,1,"だい"],[45,1,"へん"],[61,1,"こ"],[75,1,"う"],[80,1,"か"]],"text":"神は、イエスをよみがえらせて、わたしたち子孫にこの約束を、お果しになった。それは詩篇の第二篇にも、『あなたこそは、わたしの子。きょう、わたしはあなたを生んだ』と書いてあるとおりである。"},{"ref":"Acts.13.34","start":44013034,"end":44013034,"break":"none","ruby":[[3,1,"かみ"],[9,2,"しにん"],[12,1,"なか"],[28,1,"く"],[30,1,"は"],[62,2,"やくそく"],[66,1,"たし"],[69,1,"せい"],[72,2,"しゅくふく"],[82,1,"さづ"],[88,1,"い"]],"text":"また、神がイエスを死人の中からよみがえらせて、いつまでも朽ち果てることのないものとされたことについては、『わたしは、ダビデに約束した確かな聖なる祝福を、あなたがたに授けよう』と言われた。"},{"ref":"Acts.13.35","start":44013035,"end":44013035,"break":"none","ruby":[[7,2,"かしょ"],[13,1,"い"],[26,2,"せいじゃ"],[29,1,"く"],[31,1,"は"],[42,1,"ゆる"]],"text":"だから、ほかの箇所でもこう言っておられる、『あなたの聖者が朽ち果てるようなことは、お許しにならないであろう』。"},{"ref":"Acts.13.36","start":44013036,"end":44013036,"break":"none","ruby":[[0,2,"じじつ"],[10,2,"じだい"],[13,2,"ひとびと"],[16,1,"かみ"],[19,1,"むね"],[26,1,"つか"],[34,1,"ねむ"],[40,2,"せんぞ"],[45,1,"なか"],[47,1,"くわ"],[56,1,"く"],[58,1,"は"]],"text":"事実、ダビデは、その時代の人々に神のみ旨にしたがって仕えたが、やがて眠りにつき、先祖たちの中に加えられて、ついに朽ち果ててしまった。"},{"ref":"Acts.13.37","start":44013037,"end":44013037,"break":"none","ruby":[[4,1,"かみ"],[17,1,"く"],[19,1,"は"]],"text":"しかし、神がよみがえらせたかたは、朽ち果てることがなかったのである。"},{"ref":"Acts.13.38","start":44013038,"end":44013038,"break":"none","ruby":[[4,2,"きょうだい"],[12,1,"こと"],[14,2,"しょうち"],[37,1,"つみ"],[43,2,"ふくいん"],[47,1,"いま"],[55,1,"の"],[57,1,"つた"],[73,2,"りっぽう"],[77,1,"ぎ"],[95,1,"こと"]],"text":"だから、兄弟たちよ、この事を承知しておくがよい。すなわち、このイエスによる罪のゆるしの福音が、今やあなたがたに宣べ伝えられている。そして、モーセの律法では義とされることができなかったすべての事についても、"},{"ref":"Acts.13.39","start":44013039,"end":44013039,"break":"none","ruby":[[0,1,"しん"],[3,1,"もの"],[17,1,"ぎ"]],"text":"信じる者はもれなく、イエスによって義とされるのである。"},{"ref":"Acts.13.40","start":44013040,"end":44013040,"break":"none","ruby":[[3,3,"よげんしゃ"],[9,1,"しょ"],[16,1,"つぎ"],[31,1,"み"],[33,1,"おこ"],[40,1,"き"]],"text":"だから預言者たちの書にかいてある次のようなことが、あなたがたの身に起らないように気をつけなさい。"},{"ref":"Acts.13.41","start":44013041,"end":44013041,"break":"stanza","breaks":[[22,"line"],[44,"line"],[64,"line"]],"ruby":[[1,1,"み"],[4,1,"あなど"],[6,1,"もの"],[11,1,"おどろ"],[17,1,"ほろ"],[19,1,"さ"],[33,2,"じだい"],[39,1,"こと"],[48,1,"ひと"],[54,2,"せつめい"],[58,1,"き"],[74,1,"しん"],[81,1,"こと"]],"text":"『見よ、侮る者たちよ。驚け、そして滅び去れ。わたしは、あなたがたの時代に一つの事をする。それは、人がどんなに説明して聞かせても、あなたがたのとうてい信じないような事なのである』」。"},{"ref":"Acts.13.42","start":44013042,"end":44013042,"break":"paragraph","ruby":[[4,2,"かいどう"],[7,1,"で"],[9,1,"とき"],[11,2,"ひとびと"],[14,1,"つぎ"],[16,3,"あんそくにち"],[25,1,"おな"],[27,1,"はなし"],[43,1,"ねが"]],"text":"ふたりが会堂を出る時、人々は次の安息日にも、これと同じ話をしてくれるようにと、しきりに願った。"},{"ref":"Acts.13.43","start":44013043,"end":44013043,"break":"none","ruby":[[3,2,"しゅうかい"],[6,1,"おわ"],[13,1,"おお"],[20,1,"じん"],[22,2,"しんじん"],[24,1,"ぶか"],[26,3,"かいしゅうしゃ"],[56,1,"かれ"],[59,1,"ひ"],[64,1,"かみ"],[82,1,"と"]],"text":"そして集会が終ってからも、大ぜいのユダヤ人や信心深い改宗者たちが、パウロとバルナバとについてきたので、ふたりは、彼らが引きつづき神のめぐみにとどまっているようにと、説きすすめた。"},{"ref":"Acts.13.44","start":44013044,"end":44013044,"break":"paragraph","ruby":[[0,1,"つぎ"],[2,3,"あんそくにち"],[12,2,"ぜんし"],[19,1,"かみ"],[21,1,"ことば"],[23,1,"き"],[26,1,"あつ"]],"text":"次の安息日には、ほとんど全市をあげて、神の言を聞きに集まってきた。"},{"ref":"Acts.13.45","start":44013045,"end":44013045,"break":"none","ruby":[[6,1,"じん"],[13,2,"ぐんしゅう"],[16,1,"み"],[23,1,"おも"],[30,1,"かた"],[35,1,"くち"],[40,2,"はんたい"]],"text":"するとユダヤ人たちは、その群衆を見てねたましく思い、パウロの語ることに口ぎたなく反対した。"},{"ref":"Acts.13.46","start":44013046,"end":44013046,"break":"none","ruby":[[10,2,"だいたん"],[13,1,"かた"],[18,1,"かみ"],[20,1,"ことば"],[32,1,"かた"],[34,1,"つた"],[62,1,"しりぞ"],[65,2,"じぶん"],[67,2,"じしん"],[70,2,"えいえん"],[73,1,"いのち"],[82,1,"もの"],[106,2,"ほうこう"],[113,3,"いほうじん"],[119,1,"ほう"],[121,1,"い"]],"text":"パウロとバルナバとは大胆に語った、「神の言は、まず、あなたがたに語り伝えられなければならなかった。しかし、あなたがたはそれを退け、自分自身を永遠の命にふさわしからぬ者にしてしまったから、さあ、わたしたちはこれから方向をかえて、異邦人たちの方に行くのだ。"},{"ref":"Acts.13.47","start":44013047,"end":44013047,"break":"none","breaks":[[19,"stanza"],[41,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"めい"],[29,1,"た"],[32,3,"いほうじん"],[36,1,"ひかり"],[45,1,"ち"],[47,1,"はて"],[51,1,"すくい"]],"text":"主はわたしたちに、こう命じておられる、『わたしは、あなたを立てて異邦人の光とした。あなたが地の果までも救をもたらすためである』」。"},{"ref":"Acts.13.48","start":44013048,"end":44013048,"break":"none","ruby":[[0,3,"いほうじん"],[9,1,"き"],[17,1,"しゅ"],[19,2,"みことば"],[39,2,"えいえん"],[42,1,"いのち"],[51,1,"さだ"],[58,1,"もの"],[63,1,"しん"]],"text":"異邦人たちはこれを聞いてよろこび、主の御言をほめたたえてやまなかった。そして、永遠の命にあずかるように定められていた者は、みな信じた。"},{"ref":"Acts.13.49","start":44013049,"end":44013049,"break":"none","ruby":[[5,1,"しゅ"],[7,2,"みことば"],[12,2,"ちほう"],[14,2,"ぜんたい"],[22,1,"い"]],"text":"こうして、主の御言はこの地方全体にひろまって行った。"},{"ref":"Acts.13.50","start":44013050,"end":44013050,"break":"none","ruby":[[8,1,"じん"],[13,2,"しんじん"],[15,1,"ぶか"],[17,3,"きふじん"],[23,1,"まち"],[25,2,"ゆうりょく"],[27,1,"しゃ"],[31,2,"せんどう"],[45,2,"はくがい"],[56,2,"ちほう"],[60,1,"お"],[62,1,"だ"]],"text":"ところが、ユダヤ人たちは、信心深い貴婦人たちや町の有力者たちを煽動して、パウロとバルナバを迫害させ、ふたりをその地方から追い出させた。"},{"ref":"Acts.13.51","start":44013051,"end":44013051,"break":"none","ruby":[[5,1,"かれ"],[8,1,"む"],[11,1,"あし"],[16,1,"はら"],[18,1,"おと"],[28,1,"い"]],"text":"ふたりは、彼らに向けて足のちりを払い落して、イコニオムへ行った。"},{"ref":"Acts.13.52","start":44013052,"end":44013052,"break":"none","ruby":[[0,2,"でし"],[10,1,"よろこ"],[13,2,"せいれい"],[17,1,"み"]],"text":"弟子たちは、ますます喜びと聖霊とに満たされていた。"}]