[{"ref":"Jer.11.1","start":24011001,"end":24011001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"のぞ"],[11,2,"ことば"],[14,1,"い"]],"text":"主からエレミヤに臨んだ言葉は言う、"},{"ref":"Jer.11.2","start":24011002,"end":24011002,"break":"none","ruby":[[3,2,"けいやく"],[6,2,"ことば"],[9,1,"き"],[15,2,"ひとびと"],[24,1,"す"],[26,1,"もの"],[28,1,"つ"]],"text":"「この契約の言葉を聞き、ユダの人々とエルサレムに住む者に告げよ。"},{"ref":"Jer.11.3","start":24011003,"end":24011003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[12,1,"かみ"],[14,1,"しゅ"],[18,1,"おお"],[26,2,"けいやく"],[29,2,"ことば"],[32,1,"したが"],[36,1,"ひと"]],"text":"彼らに言え、イスラエルの神、主はこう仰せられる、この契約の言葉に従わない人は、のろわれる。"},{"ref":"Jer.11.4","start":24011004,"end":24011004,"break":"none","ruby":[[2,2,"けいやく"],[16,2,"せんぞ"],[24,1,"ち"],[26,1,"てつ"],[32,1,"なか"],[35,1,"みちび"],[37,1,"だ"],[40,1,"とき"],[43,1,"かれ"],[46,1,"めい"],[66,1,"とき"],[71,1,"かれ"],[74,1,"い"],[82,1,"こえ"],[84,1,"き"],[93,1,"めい"],[103,1,"おこな"],[119,1,"たみ"],[134,1,"かみ"]],"text":"この契約は、わたしがあなたがたの先祖をエジプトの地、鉄のかまどの中から導き出した時に、彼らに命じたところのものである。すなわち、その時わたしは彼らに言った、わたしの声を聞き、あなたがたに命じるすべてのことを行うならば、あなたがたはわたしの民となり、わたしはあなたがたの神となる。"},{"ref":"Jer.11.5","start":24011005,"end":24011005,"break":"none","ruby":[[14,2,"せんぞ"],[18,1,"ちち"],[20,1,"みつ"],[23,1,"なが"],[26,1,"ち"],[28,1,"あた"],[32,1,"ちか"],[41,1,"と"],[50,2,"こんにち"],[63,1,"とき"],[70,1,"しゅ"],[73,1,"おお"],[83,1,"こた"]],"text":"そして、わたしがあなたがたの先祖に、乳と蜜との流れる地を与えると誓ったことを、なし遂げると。すなわち今日のとおりである」。その時わたしは、「主よ、仰せのとおりです」と答えた。"},{"ref":"Jer.11.6","start":24011006,"end":24011006,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[18,2,"ことば"],[25,2,"まちまち"],[39,1,"つ"],[41,1,"しめ"],[46,2,"けいやく"],[49,2,"ことば"],[52,1,"き"],[58,1,"おこな"],[62,1,"い"]],"text":"主はわたしに言われた、「このすべての言葉を、ユダの町々と、エルサレムのちまたに告げ示し、この契約の言葉を聞き、これを行え、と言いなさい。"},{"ref":"Jer.11.7","start":24011007,"end":24011007,"break":"none","ruby":[[11,2,"せんぞ"],[19,1,"ち"],[22,1,"みちび"],[24,1,"だ"],[27,1,"とき"],[30,2,"こんにち"],[44,1,"かれ"],[47,1,"いまし"],[50,1,"た"],[53,1,"いまし"],[61,1,"こえ"],[63,1,"き"],[65,1,"したが"],[71,1,"い"]],"text":"わたしは、あなたがたの先祖をエジプトの地から導き出した時から今日にいたるまで、おごそかに彼らを戒め、絶えず戒めて、わたしの声に聞き従うようにと言った。"},{"ref":"Jer.11.8","start":24011008,"end":24011008,"break":"none","ruby":[[3,1,"かれ"],[6,1,"したが"],[12,1,"みみ"],[14,1,"かたむ"],[22,2,"じぶん"],[25,1,"わる"],[27,2,"ごうじょう"],[30,1,"こころ"],[32,1,"したが"],[35,1,"あゆ"],[50,2,"けいやく"],[53,2,"ことば"],[59,1,"かれ"],[62,1,"せ"],[73,1,"かれ"],[76,1,"おこな"],[79,1,"めい"],[84,1,"おこな"]],"text":"しかし彼らは従わず、その耳を傾けず、おのおの自分の悪い強情な心に従って歩んだ。それゆえ、わたしはこの契約の言葉をもって彼らを責めた。これはわたしが彼らに行えと命じたが、行わなかったものである」。"},{"ref":"Jer.11.9","start":24011009,"end":24011009,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[17,2,"ひとびと"],[26,1,"す"],[28,1,"もの"],[33,2,"はんぎゃく"],[36,1,"こと"]],"text":"主はまたわたしに言われた、「ユダの人々とエルサレムに住む者のうちに反逆の事がある。"},{"ref":"Jer.11.10","start":24011010,"end":24011010,"break":"none","ruby":[[0,1,"かれ"],[8,2,"ことば"],[11,1,"き"],[16,1,"こば"],[21,2,"せんぞ"],[26,1,"つみ"],[28,1,"た"],[30,1,"かえ"],[38,2,"かみがみ"],[41,1,"したが"],[47,1,"つか"],[57,1,"いえ"],[62,1,"いえ"],[72,2,"せんぞ"],[77,1,"むす"],[80,2,"けいやく"],[83,1,"やぶ"]],"text":"彼らは、わたしの言葉を聞くことを拒んだその先祖たちの罪に立ち返り、またほかの神々に従ってそれに仕えた。イスラエルの家とユダの家とは、わたしがその先祖たちと結んだ契約を破った。"},{"ref":"Jer.11.11","start":24011011,"end":24011011,"break":"none","ruby":[[4,1,"しゅ"],[8,1,"い"],[13,1,"み"],[20,1,"わざわい"],[22,1,"かれ"],[25,1,"うえ"],[27,1,"くだ"],[30,1,"かれ"],[36,1,"まぬか"],[47,1,"かれ"],[54,1,"よ"],[63,1,"き"]],"text":"それゆえ主はこう言われる、見よ、わたしは災を彼らの上に下す。彼らはそれを免れることはできない。彼らがわたしを呼んでも、わたしは聞かない。"},{"ref":"Jer.11.12","start":24011012,"end":24011012,"break":"none","ruby":[[3,2,"まちまち"],[12,1,"す"],[14,1,"もの"],[17,1,"い"],[21,2,"じぶん"],[29,1,"こう"],[36,2,"かみがみ"],[39,1,"よ"],[41,1,"もと"],[51,1,"かれ"],[54,1,"わざわい"],[56,1,"とき"],[59,1,"けっ"],[62,1,"かれ"],[65,1,"すく"]],"text":"ユダの町々とエルサレムに住む者は、行って、自分たちがそれに香をたいている神々に呼び求めるが、これらは、彼らの災の時にも決して彼らを救うことはできない。"},{"ref":"Jer.11.13","start":24011013,"end":24011013,"break":"none","ruby":[[8,2,"かみがみ"],[16,1,"まち"],[18,1,"かず"],[21,1,"おお"],[45,1,"かず"],[49,2,"さいだん"],[52,1,"は"],[56,1,"もの"],[61,1,"た"],[73,1,"こう"],[80,2,"さいだん"]],"text":"ユダよ、あなたの神々は、あなたの町の数ほど多くなった。またあなたがたはエルサレムのちまたの数ほどの祭壇を恥ずべき者のために立てた。すなわちバアルに香をたくための祭壇である。"},{"ref":"Jer.11.14","start":24011014,"end":24011014,"break":"paragraph","ruby":[[7,1,"たみ"],[12,1,"いの"],[23,1,"かれ"],[29,1,"な"],[36,1,"いの"],[38,1,"もと"],[47,1,"かれ"],[52,1,"わざわい"],[54,1,"とき"],[61,1,"よ"],[72,1,"かれ"],[75,1,"き"]],"text":"それゆえ、この民のために祈ってはならない。また彼らのために泣き、あるいは祈り求めてはならない。彼らがその災の時に、わたしに呼ばわっても、わたしは彼らに聞くことをしないからだ。"},{"ref":"Jer.11.15","start":24011015,"end":24011015,"break":"none","ruby":[[2,1,"あい"],[5,1,"もの"],[12,1,"いえ"],[14,1,"なに"],[27,2,"あくじ"],[30,1,"おこな"],[34,2,"せいがん"],[37,2,"ぎせい"],[40,1,"にく"],[47,1,"わざわい"],[49,1,"まぬか"],[73,1,"よろこ"]],"text":"わが愛する者は、わたしの家で何をするのか。すでにこれは悪事を行った。誓願と犠牲の肉とがあなたに災を免れさせることができるであろうか。それであなたは喜ぶことができるであろうか。"},{"ref":"Jer.11.16","start":24011016,"end":24011016,"break":"none","ruby":[[0,1,"しゅ"],[12,1,"よ"],[14,1,"み"],[18,1,"うつく"],[21,2,"あおあお"],[30,1,"き"],[33,1,"よ"],[39,1,"はげ"],[42,2,"ぼうふう"],[50,1,"とも"],[53,1,"しゅ"],[58,1,"ひ"],[65,1,"えだ"],[67,1,"や"],[69,1,"はら"]],"text":"主はあなたを、かつては『良い実のなる美しい青々としたオリブの木』と呼ばれたが、激しい暴風のとどろきと共に、主はそれに火をかけ、その枝を焼き払われるのである。"},{"ref":"Jer.11.17","start":24011017,"end":24011017,"break":"none","ruby":[[4,1,"う"],[7,2,"ばんぐん"],[10,1,"しゅ"],[17,1,"む"],[21,1,"わざわい"],[23,1,"い"],[25,1,"わた"],[39,1,"いえ"],[44,1,"いえ"],[47,1,"あく"],[49,1,"おこな"],[56,1,"こう"],[66,1,"いか"]],"text":"あなたを植えた万軍の主は、あなたに向かって災を言い渡された。これはイスラエルの家とユダの家とが悪を行い、バアルに香をたいて、わたしを怒らせたからである」。"},{"ref":"Jer.11.18","start":24011018,"end":24011018,"break":"paragraph","breaks":[[14,"line"],[25,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"し"],[21,1,"し"],[27,1,"とき"],[33,1,"かれ"],[36,1,"あ"],[46,1,"しめ"]],"text":"主が知らせてくださったので、わたしはそれを知った。その時、あなたは彼らの悪しきわざをわたしに示された。"},{"ref":"Jer.11.19","start":24011019,"end":24011019,"break":"line","breaks":[[8,"line"],[28,"line"],[41,"line"],[62,"line"],[85,"line"],[99,"line"]],"ruby":[[13,1,"い"],[21,2,"こひつじ"],[28,1,"かれ"],[35,1,"がい"],[41,1,"はか"],[55,1,"し"],[62,1,"かれ"],[65,1,"い"],[72,1,"き"],[76,1,"み"],[78,1,"とも"],[80,1,"ほろ"],[85,1,"い"],[88,1,"もの"],[90,1,"ち"],[93,1,"かれ"],[95,1,"た"],[101,1,"な"],[103,1,"ひと"],[105,1,"わす"]],"text":"しかしわたしは、ほふられに行く、おとなしい小羊のようで、彼らがわたしを害しようと、計りごとをめぐらしているのを知らなかった。彼らは言う、「さあ、木とその実を共に滅ぼそう。生ける者の地から彼を絶って、その名を人に忘れさせよう」。"},{"ref":"Jer.11.20","start":24011020,"end":24011020,"break":"line","breaks":[[9,"line"],[26,"line"],[48,"line"]],"ruby":[[0,1,"ただ"],[9,1,"ひと"],[11,1,"こころ"],[13,1,"おも"],[16,1,"さぐ"],[20,2,"ばんぐん"],[23,1,"しゅ"],[30,2,"じぶん"],[33,1,"うった"],[41,1,"まか"],[52,1,"かれ"],[65,1,"み"]],"text":"正しいさばきをし、人の心と思いを探られる万軍の主よ、わたしは自分の訴えをあなたにお任せしました。あなたが彼らにあだをかえされるのを見させてください。"},{"ref":"Jer.11.21","start":24011021,"end":24011021,"break":"paragraph","ruby":[[4,1,"しゅ"],[11,2,"ひとびと"],[19,1,"い"],[24,1,"かれ"],[31,1,"いのち"],[33,1,"と"],[37,1,"もと"],[40,1,"い"],[44,1,"しゅ"],[46,1,"な"],[51,2,"よげん"],[79,1,"て"],[85,1,"し"]],"text":"それゆえ主はアナトテの人々についてこう言われる、彼らはあなたの命を取ろうと求めて言う、「主の名によって預言してはならない。それをするならば、あなたはわれわれの手にかかって死ぬであろう」。"},{"ref":"Jer.11.22","start":24011022,"end":24011022,"break":"none","ruby":[[3,2,"ばんぐん"],[6,1,"しゅ"],[10,1,"い"],[16,1,"み"],[23,1,"かれ"],[26,1,"ばっ"],[30,1,"わか"],[32,1,"ひと"],[38,1,"し"],[41,1,"かれ"],[47,1,"むすめ"],[54,1,"し"]],"text":"それで万軍の主はこう言われる、「見よ、わたしは彼らを罰する。若い人はつるぎで死に、彼らのむすこ娘は、ききんで死に、"},{"ref":"Jer.11.23","start":24011023,"end":24011023,"break":"none","ruby":[[3,1,"のこ"],[5,1,"もの"],[19,2,"ひとびと"],[22,1,"わざわい"],[24,1,"くだ"],[27,1,"かれ"],[30,1,"ばっ"],[33,1,"とし"]],"text":"だれも残る者はない。わたしがアナトテの人々に災を下し、彼らを罰する年をこさせるからである」。"}]