[{"ref":"Gen.10.1","start":1010001,"end":1010001,"break":"paragraph","ruby":[[3,1,"こ"],[14,2,"けいず"],[17,1,"つぎ"],[26,2,"こうずい"],[29,1,"のち"],[31,1,"かれ"],[34,1,"こ"],[36,1,"うま"]],"text":"ノアの子セム、ハム、ヤペテの系図は次のとおりである。洪水の後、彼らに子が生れた。"},{"ref":"Gen.10.2","start":1010002,"end":1010002,"break":"none","ruby":[[4,2,"しそん"]],"text":"ヤペテの子孫はゴメル、マゴグ、マダイ、ヤワン、トバル、メセク、テラスであった。"},{"ref":"Gen.10.3","start":1010003,"end":1010003,"break":"none","ruby":[[4,2,"しそん"]],"text":"ゴメルの子孫はアシケナズ、リパテ、トガルマ。"},{"ref":"Gen.10.4","start":1010004,"end":1010004,"break":"none","ruby":[[4,2,"しそん"]],"text":"ヤワンの子孫はエリシャ、タルシシ、キッテム、ドダニムであった。"},{"ref":"Gen.10.5","start":1010005,"end":1010005,"break":"none","ruby":[[5,2,"うみぞ"],[9,1,"ち"],[11,2,"こくみん"],[14,1,"わか"],[24,2,"とち"],[32,2,"げんご"],[42,2,"しぞく"],[53,2,"くにぐに"],[56,1,"す"]],"text":"これらから海沿いの地の国民が分れて、おのおのその土地におり、その言語にしたがい、その氏族にしたがって、その国々に住んだ。"},{"ref":"Gen.10.6","start":1010006,"end":1010006,"break":"paragraph","ruby":[[3,2,"しそん"]],"text":"ハムの子孫はクシ、ミツライム、プテ、カナンであった。"},{"ref":"Gen.10.7","start":1010007,"end":1010007,"break":"none","ruby":[[3,2,"しそん"],[33,2,"しそん"]],"text":"クシの子孫はセバ、ハビラ、サブタ、ラアマ、サブテカであり、ラアマの子孫はシバとデダンであった。"},{"ref":"Gen.10.8","start":1010008,"end":1010008,"break":"none","ruby":[[3,1,"こ"],[21,1,"よ"],[23,3,"けんりょくしゃ"],[30,2,"さいしょ"],[33,1,"ひと"]],"text":"クシの子はニムロデであって、このニムロデは世の権力者となった最初の人である。"},{"ref":"Gen.10.9","start":1010009,"end":1010009,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"まえ"],[6,1,"ちから"],[9,3,"しゅりょうしゃ"],[22,1,"しゅ"],[24,1,"まえ"],[26,1,"ちから"],[29,3,"しゅりょうしゃ"],[49,1,"た"]],"text":"彼は主の前に力ある狩猟者であった。これから「主の前に力ある狩猟者ニムロデのごとし」ということわざが起った。"},{"ref":"Gen.10.10","start":1010010,"end":1010010,"break":"none","ruby":[[0,1,"かれ"],[2,1,"くに"],[4,2,"さいしょ"],[10,1,"ち"]],"text":"彼の国は最初シナルの地にあるバベル、エレク、アカデ、カルネであった。"},{"ref":"Gen.10.11","start":1010011,"end":1010011,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ち"],[13,1,"で"]],"text":"彼はその地からアッスリヤに出て、ニネベ、レホボテイリ、カラ、"},{"ref":"Gen.10.12","start":1010012,"end":1010012,"break":"none","ruby":[[11,1,"あいだ"],[15,1,"おお"],[19,1,"まち"],[24,1,"た"]],"text":"およびニネベとカラとの間にある大いなる町レセンを建てた。"},{"ref":"Gen.10.13","start":1010013,"end":1010013,"break":"none","ruby":[[9,1,"ぞく"],[14,1,"ぞく"],[19,1,"ぞく"],[24,1,"ぞく"]],"text":"ミツライムからルデ族、アナミ族、レハビ族、ナフト族、"},{"ref":"Gen.10.14","start":1010014,"end":1010014,"break":"none","ruby":[[4,1,"ぞく"],[9,1,"ぞく"],[15,1,"ぞく"],[17,1,"で"],[24,1,"ぞく"],[31,1,"ぞく"],[33,1,"で"]],"text":"パテロス族、カスル族、カフトリ族が出た。カフトリ族からペリシテ族が出た。"},{"ref":"Gen.10.15","start":1010015,"end":1010015,"break":"paragraph","ruby":[[7,2,"ちょうし"],[13,1,"で"],[21,1,"で"]],"text":"カナンからその長子シドンが出て、またヘテが出た。"},{"ref":"Gen.10.16","start":1010016,"end":1010016,"break":"none","ruby":[[2,1,"た"]],"text":"その他エブスびと、アモリびと、ギルガシびと、"},{"ref":"Gen.10.17","start":1010017,"end":1010017,"break":"none","text":"ヒビびと、アルキびと、セニびと、"},{"ref":"Gen.10.18","start":1010018,"end":1010018,"break":"none","ruby":[[19,1,"で"],[22,1,"のち"],[33,2,"しぞく"]],"text":"アルワデびと、ゼマリびと、ハマテびとが出た。後になってカナンびとの氏族がひろがった。"},{"ref":"Gen.10.19","start":1010019,"end":1010019,"break":"none","ruby":[[6,1,"さかい"],[17,1,"へ"],[22,1,"いた"],[42,1,"へ"],[49,1,"およ"]],"text":"カナンびとの境はシドンからゲラルを経てガザに至り、ソドム、ゴモラ、アデマ、ゼボイムを経て、レシャに及んだ。"},{"ref":"Gen.10.20","start":1010020,"end":1010020,"break":"none","ruby":[[7,2,"しそん"],[16,2,"しぞく"],[21,2,"げんご"],[33,2,"とち"],[39,2,"くにぐに"]],"text":"これらはハムの子孫であって、その氏族とその言語とにしたがって、その土地と、その国々にいた。"},{"ref":"Gen.10.21","start":1010021,"end":1010021,"break":"paragraph","ruby":[[4,1,"こ"],[6,1,"うま"],[21,2,"しそん"],[24,2,"せんぞ"],[35,1,"あに"]],"text":"セムにも子が生れた。セムはエベルのすべての子孫の先祖であって、ヤペテの兄であった。"},{"ref":"Gen.10.22","start":1010022,"end":1010022,"break":"none","ruby":[[3,2,"しそん"]],"text":"セムの子孫はエラム、アシュル、アルパクサデ、ルデ、アラムであった。"},{"ref":"Gen.10.23","start":1010023,"end":1010023,"break":"none","ruby":[[4,2,"しそん"]],"text":"アラムの子孫はウヅ、ホル、ゲテル、マシであった。"},{"ref":"Gen.10.24","start":1010024,"end":1010024,"break":"none","ruby":[[7,1,"こ"],[15,1,"こ"]],"text":"アルパクサデの子はシラ、シラの子はエベルである。"},{"ref":"Gen.10.25","start":1010025,"end":1010025,"break":"none","ruby":[[8,1,"こ"],[10,1,"うま"],[20,1,"な"],[33,1,"かれ"],[35,1,"よ"],[37,1,"ち"],[39,1,"たみ"],[41,1,"わか"],[52,1,"おとうと"],[54,1,"な"]],"text":"エベルにふたりの子が生れた。そのひとりの名をペレグといった。これは彼の代に地の民が分れたからである。その弟の名をヨクタンといった。"},{"ref":"Gen.10.26","start":1010026,"end":1010026,"break":"none","text":"ヨクタンにアルモダデ、シャレフ、ハザルマウテ、エラ、"},{"ref":"Gen.10.27","start":1010027,"end":1010027,"break":"none","text":"ハドラム、ウザル、デクラ、"},{"ref":"Gen.10.28","start":1010028,"end":1010028,"break":"none","text":"オバル、アビマエル、シバ、"},{"ref":"Gen.10.29","start":1010029,"end":1010029,"break":"none","ruby":[[12,1,"うま"],[20,1,"みな"],[26,1,"こ"]],"text":"オフル、ハビラ、ヨバブが生れた。これらは皆ヨクタンの子であった。"},{"ref":"Gen.10.30","start":1010030,"end":1010030,"break":"none","ruby":[[0,1,"かれ"],[3,1,"す"],[6,1,"ところ"],[13,1,"ひがし"],[15,2,"さんち"],[21,1,"およ"]],"text":"彼らが住んだ所はメシャから東の山地セパルに及んだ。"},{"ref":"Gen.10.31","start":1010031,"end":1010031,"break":"none","ruby":[[7,2,"しそん"],[16,2,"しぞく"],[21,2,"げんご"],[33,2,"とち"],[39,2,"くにぐに"]],"text":"これらはセムの子孫であって、その氏族とその言語とにしたがって、その土地と、その国々にいた。"},{"ref":"Gen.10.32","start":1010032,"end":1010032,"break":"paragraph","ruby":[[7,1,"こ"],[10,2,"しぞく"],[17,2,"けっとう"],[25,2,"くにぐに"],[28,1,"す"],[35,2,"こうずい"],[38,1,"のち"],[45,2,"ちじょう"],[48,1,"しょ"],[49,2,"こくみん"],[52,1,"わか"]],"text":"これらはノアの子らの氏族であって、血統にしたがって国々に住んでいたが、洪水の後、これらから地上の諸国民が分れたのである。"}]