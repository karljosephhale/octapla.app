[{"ref":"Titus.3.1","start":56003001,"end":56003001,"break":"paragraph","ruby":[[4,1,"かれ"],[7,1,"すす"],[11,3,"しはいしゃ"],[15,2,"けんい"],[19,1,"もの"],[21,1,"ふく"],[27,1,"したが"],[34,1,"よ"],[41,2,"ようい"]],"text":"あなたは彼らに勧めて、支配者、権威ある者に服し、これに従い、いつでも良いわざをする用意があり、"},{"ref":"Titus.3.2","start":56003002,"end":56003002,"break":"none","ruby":[[9,1,"あらそ"],[13,2,"かんよう"],[24,1,"ひと"],[26,1,"たい"],[34,2,"にゅうわ"],[37,2,"たいど"],[40,1,"しめ"],[48,1,"おも"],[50,1,"だ"]],"text":"だれをもそしらず、争わず、寛容であって、すべての人に対してどこまでも柔和な態度を示すべきことを、思い出させなさい。"},{"ref":"Titus.3.3","start":56003003,"end":56003003,"break":"none","ruby":[[6,2,"いぜん"],[11,3,"むふんべつ"],[16,1,"ふ"],[17,2,"じゅうじゅん"],[21,1,"まよ"],[26,1,"もの"],[37,2,"じょうよく"],[40,2,"かいらく"],[44,2,"どれい"],[50,2,"あくい"],[58,1,"ひ"],[60,1,"す"],[64,1,"ひと"],[66,1,"にく"],[70,1,"たがい"],[72,1,"にく"],[74,1,"あ"]],"text":"わたしたちも以前には、無分別で、不従順な、迷っていた者であって、さまざまの情欲と快楽との奴隷になり、悪意とねたみとで日を過ごし、人に憎まれ、互に憎み合っていた。"},{"ref":"Titus.3.4","start":56003004,"end":56003004,"break":"none","ruby":[[11,2,"すくいぬし"],[15,1,"かみ"],[17,2,"じひ"],[20,2,"はくあい"],[24,1,"あらわ"]],"text":"ところが、わたしたちの救主なる神の慈悲と博愛とが現れたとき、"},{"ref":"Titus.3.5","start":56003005,"end":56003005,"break":"none","ruby":[[6,1,"おこな"],[9,1,"ぎ"],[24,1,"かみ"],[35,2,"さいせい"],[38,1,"あら"],[41,1,"う"],[44,2,"せいれい"],[49,1,"あら"],[62,1,"すく"]],"text":"わたしたちの行った義のわざによってではなく、ただ神のあわれみによって、再生の洗いを受け、聖霊により新たにされて、わたしたちは救われたのである。"},{"ref":"Titus.3.6","start":56003006,"end":56003006,"break":"none","ruby":[[2,2,"せいれい"],[12,2,"すくいぬし"],[34,1,"うえ"],[36,1,"ゆた"],[39,1,"そそ"]],"text":"この聖霊は、わたしたちの救主イエス・キリストをとおして、わたしたちの上に豊かに注がれた。"},{"ref":"Titus.3.7","start":56003007,"end":56003007,"break":"none","ruby":[[16,1,"めぐ"],[22,1,"ぎ"],[27,2,"えいえん"],[34,1,"のぞ"],[43,2,"みくに"],[48,1,"もの"]],"text":"これは、わたしたちが、キリストの恵みによって義とされ、永遠のいのちを望むことによって、御国をつぐ者となるためである。"},{"ref":"Titus.3.8","start":56003008,"end":56003008,"break":"none","ruby":[[2,2,"ことば"],[5,2,"かくじつ"],[27,2,"しゅちょう"],[33,1,"ねが"],[43,1,"かみ"],[45,1,"しん"],[50,1,"もの"],[55,1,"つと"],[58,1,"よ"],[63,1,"はげ"],[68,1,"こころ"],[86,1,"よ"],[95,2,"ひとびと"],[98,1,"えき"]],"text":"この言葉は確実である。わたしは、あなたがそれらのことを主張するのを願っている。それは、神を信じている者たちが、努めて良いわざを励むことを心がけるようになるためである。これは良いことであって、人々の益となる。"},{"ref":"Titus.3.9","start":56003009,"end":56003009,"break":"none","ruby":[[4,1,"おろ"],[7,2,"ぎろん"],[11,2,"けいず"],[15,1,"あらそ"],[19,2,"りっぽう"],[26,2,"ろんそう"],[31,1,"さ"],[41,2,"むえき"],[45,2,"くうきょ"]],"text":"しかし、愚かな議論と、系図と、争いと、律法についての論争とを、避けなさい。それらは無益かつ空虚なことである。"},{"ref":"Titus.3.10","start":56003010,"end":56003010,"break":"none","ruby":[[0,3,"いたんしゃ"],[8,1,"ど"],[10,2,"くんかい"],[13,1,"くわ"],[16,1,"うえ"],[18,1,"しりぞ"]],"text":"異端者は、一、二度、訓戒を加えた上で退けなさい。"},{"ref":"Titus.3.11","start":56003011,"end":56003011,"break":"none","ruby":[[9,1,"ひと"],[14,2,"じゃどう"],[17,1,"おちい"],[20,1,"みずか"],[22,1,"あく"],[24,1,"し"],[30,1,"つみ"],[32,1,"おか"]],"text":"たしかに、こういう人たちは、邪道に陥り、自ら悪と知りつつも、罪を犯しているからである。"},{"ref":"Titus.3.12","start":56003012,"end":56003012,"break":"paragraph","ruby":[[23,1,"おく"],[29,1,"いそ"],[43,1,"ところ"],[58,1,"ふゆ"],[60,1,"す"]],"text":"わたしがアルテマスかテキコかをあなたのところに送ったなら、急いでニコポリにいるわたしの所にきなさい。わたしは、そこで冬を過ごすことにした。"},{"ref":"Titus.3.13","start":56003013,"end":56003013,"break":"none","ruby":[[0,3,"ほうがくしゃ"],[14,1,"いそ"],[17,1,"たび"],[23,3,"ふじゆう"]],"text":"法学者ゼナスと、アポロとを、急いで旅につかせ、不自由のないようにしてあげなさい。"},{"ref":"Titus.3.14","start":56003014,"end":56003014,"break":"none","ruby":[[6,2,"なかま"],[12,1,"せま"],[15,2,"ひつよう"],[18,1,"そな"],[22,1,"つと"],[25,1,"よ"],[30,1,"はげ"],[33,1,"み"],[35,1,"むす"],[38,1,"もの"],[48,1,"こころ"]],"text":"わたしたちの仲間も、さし迫った必要に備えて、努めて良いわざを励み、実を結ばぬ者とならないように、心がけるべきである。"},{"ref":"Titus.3.15","start":56003015,"end":56003015,"break":"paragraph","breaks":[[46,"paragraph"]],"ruby":[[4,1,"とも"],[8,2,"いちどう"],[11,1,"もの"],[30,1,"あい"],[35,2,"しんと"],[46,1,"めぐ"],[55,2,"いちどう"],[58,1,"とも"]],"text":"わたしと共にいる一同の者から、あなたによろしく。わたしたちを愛している信徒たちに、よろしく。恵みが、あなたがた一同と共にあるように。"}]