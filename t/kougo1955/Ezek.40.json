[{"ref":"Ezek.40.1","start":26040001,"end":26040001,"break":"paragraph","ruby":[[5,1,"とら"],[7,1,"うつ"],[16,1,"ねん"],[18,1,"みやこ"],[20,1,"う"],[22,1,"やぶ"],[26,1,"のち"],[29,1,"ねん"],[33,1,"ねん"],[35,1,"はじ"],[38,1,"つき"],[41,1,"か"],[45,1,"ひ"],[47,1,"しゅ"],[49,1,"て"],[55,1,"のぞ"],[64,1,"ところ"],[66,1,"たずさ"],[69,1,"い"]],"text":"われわれが捕え移されてから二十五年、都が打ち破られて後十四年、その年の初めの月の十日、その日に主の手がわたしに臨み、わたしをかの所に携えて行った。"},{"ref":"Ezek.40.2","start":26040002,"end":26040002,"break":"none","ruby":[[4,1,"かみ"],[6,1,"まぼろし"],[22,1,"ち"],[24,1,"たずさ"],[27,1,"い"],[31,2,"ひじょう"],[34,1,"たか"],[36,1,"やま"],[38,1,"うえ"],[48,1,"やま"],[50,1,"うえ"],[57,2,"あいたい"],[65,1,"まち"],[70,2,"たてもの"]],"text":"すなわち神は幻のうちに、わたしをイスラエルの地に携えて行って、非常に高い山の上におろされた。その山の上に、わたしと相対して、一つの町のような建物があった。"},{"ref":"Ezek.40.3","start":26040003,"end":26040003,"break":"none","ruby":[[0,1,"かみ"],[9,1,"たずさ"],[12,1,"い"],[18,1,"み"],[25,1,"ひと"],[32,1,"すがた"],[34,2,"せいどう"],[37,1,"かたち"],[43,1,"て"],[45,1,"あさ"],[51,1,"はか"],[57,1,"も"],[60,1,"もん"],[62,1,"た"]],"text":"神がわたしをそこに携えて行かれると、見よ、ひとりの人がいた。その姿は青銅の形のようで、手に麻のなわと、測りざおとを持って門に立っていた。"},{"ref":"Ezek.40.4","start":26040004,"end":26040004,"break":"none","ruby":[[2,1,"ひと"],[8,1,"い"],[13,1,"ひと"],[15,1,"こ"],[18,1,"め"],[20,1,"み"],[22,1,"みみ"],[24,1,"き"],[35,1,"しめ"],[42,1,"こと"],[44,1,"こころ"],[57,1,"たずさ"],[60,1,"き"],[72,1,"しめ"],[84,1,"み"],[101,1,"いえ"],[103,1,"つ"]],"text":"その人はわたしに言った、「人の子よ、目で見、耳で聞き、わたしがあなたに示す、すべての事を心にとめよ。あなたをここに携えて来たのは、これをあなたに示すためである。あなたの見ることを、ことごとくイスラエルの家に告げよ」。"},{"ref":"Ezek.40.5","start":26040005,"end":26040005,"break":"paragraph","ruby":[[0,1,"み"],[3,1,"みや"],[5,1,"そと"],[7,2,"しゅうい"],[19,1,"ひと"],[21,1,"て"],[29,1,"はか"],[56,1,"ひと"],[57,1,"て"],[58,1,"はば"],[64,1,"かれ"],[72,1,"あつ"],[75,1,"はか"],[85,1,"たか"]],"text":"見よ、宮の外の周囲に、かきがあり、その人の手に六キュビトの測りざおがあった。そのキュビトは、おのおの一キュビトと一手幅とである。彼が、そのかきの厚さを測ると、一さおあり、高さも一さおあった。"},{"ref":"Ezek.40.6","start":26040006,"end":26040006,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ひがし"],[3,1,"む"],[6,1,"もん"],[8,1,"い"],[13,2,"かいだん"],[16,1,"のぼ"],[20,1,"もん"],[22,2,"しきい"],[25,1,"はか"],[31,1,"あつ"]],"text":"彼が東向きの門に行き、その階段を上って、門の敷居を測ると、その厚さは一さおあり、"},{"ref":"Ezek.40.7","start":26040007,"end":26040007,"break":"none","ruby":[[2,1,"つ"],[4,1,"しょ"],[6,1,"なが"],[12,1,"はば"],[17,1,"つ"],[19,1,"しょ"],[22,1,"つ"],[24,1,"しょ"],[27,1,"あいだ"],[37,1,"うち"],[39,1,"もん"],[41,1,"ろう"],[48,1,"もん"],[50,2,"しきい"]],"text":"その詰め所は長さ一さお、幅一さお、詰め所と、詰め所との間は五キュビトあり、内の門の廊のかたわらの門の敷居は一さおあった。"},{"ref":"Ezek.40.8","start":26040008,"end":26040008,"break":"none","ruby":[[0,1,"もん"],[2,1,"ろう"],[4,1,"はか"]],"text":"門の廊を測ると八キュビトあり、"},{"ref":"Ezek.40.9","start":26040009,"end":26040009,"break":"none","ruby":[[2,1,"わき"],[3,1,"ばしら"],[11,1,"もん"],[13,1,"ろう"],[15,2,"うちがわ"]],"text":"その脇柱は二キュビト、門の廊は内側にあった。"},{"ref":"Ezek.40.10","start":26040010,"end":26040010,"break":"none","ruby":[[0,1,"ひがし"],[1,1,"む"],[4,1,"もん"],[6,1,"つ"],[8,1,"しょ"],[31,1,"おな"],[33,2,"すんぽう"],[39,1,"わき"],[40,1,"ばしら"],[54,1,"おな"],[56,2,"すんぽう"]],"text":"東向きの門の詰め所は、こなたに三つ、かなたに三つあり、三つとも同じ寸法である。脇柱もまた、こなたかなたともに同じ寸法である。"},{"ref":"Ezek.40.11","start":26040011,"end":26040011,"break":"none","ruby":[[0,1,"もん"],[2,2,"いりぐち"],[5,1,"ひろ"],[8,1,"はか"],[19,1,"もん"],[21,1,"なが"]],"text":"門の入口の広さを測ると十キュビトあり、門の長さは十三キュビトあった。"},{"ref":"Ezek.40.12","start":26040012,"end":26040012,"break":"none","ruby":[[0,1,"つ"],[2,1,"しょ"],[4,1,"まえ"],[6,1,"さかい"],[18,1,"さかい"],[27,1,"つ"],[29,1,"しょ"]],"text":"詰め所の前の境は一キュビト、かなたの境も一キュビトで、詰め所は、こなたかなたともに六キュビトあった。"},{"ref":"Ezek.40.13","start":26040013,"end":26040013,"break":"none","ruby":[[0,1,"かれ"],[6,1,"つ"],[8,1,"しょ"],[10,1,"うら"],[16,1,"つ"],[18,1,"しょ"],[20,1,"うら"],[24,1,"もん"],[26,1,"はか"],[30,2,"いりぐち"],[34,2,"いりぐち"]],"text":"彼がまたこの詰め所の裏から、かの詰め所の裏まで、門を測ると、入口から入口まで二十五キュビトあった。"},{"ref":"Ezek.40.14","start":26040014,"end":26040014,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ろう"],[6,1,"はか"],[18,1,"もん"],[20,1,"ろう"],[22,2,"しゅうい"],[29,1,"にわ"]],"text":"彼がまた廊を測ると二十キュビトあり、門の廊の周囲は、すべて庭である。"},{"ref":"Ezek.40.15","start":26040015,"end":26040015,"break":"none","ruby":[[0,2,"いりぐち"],[3,1,"もん"],[5,1,"まえ"],[8,1,"うち"],[10,1,"もん"],[12,1,"ろう"],[14,1,"まえ"]],"text":"入口の門の前から内の門の廊の前まで五十キュビトあり、"},{"ref":"Ezek.40.16","start":26040016,"end":26040016,"break":"none","ruby":[[0,1,"つ"],[2,1,"しょ"],[5,1,"もん"],[7,2,"うちがわ"],[10,2,"しゅうい"],[13,1,"わき"],[14,1,"ばしら"],[17,1,"まど"],[22,1,"ろう"],[24,2,"うちがわ"],[27,2,"しゅうい"],[32,2,"どうよう"],[35,1,"まど"],[40,1,"わき"],[41,1,"ばしら"]],"text":"詰め所と、門の内側の周囲の脇柱とに窓があり、廊の内側の周囲にも、同様に窓があり、脇柱には、しゅろがあった。"},{"ref":"Ezek.40.17","start":26040017,"end":26040017,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"そと"],[9,1,"にわ"],[11,1,"たずさ"],[13,1,"い"],[18,1,"み"],[21,1,"にわ"],[23,2,"しゅうい"],[26,1,"もう"],[29,1,"しつ"],[32,2,"しきいし"],[39,2,"しきいし"],[42,1,"うえ"],[47,1,"しつ"]],"text":"彼がまたわたしを外庭に携え入れると、見よ、庭の周囲に設けた室と、敷石とがあり、敷石の上に三十の室があった。"},{"ref":"Ezek.40.18","start":26040018,"end":26040018,"break":"none","ruby":[[0,2,"しきいし"],[3,1,"もん"],[11,1,"もん"],[13,1,"おな"],[15,1,"なが"],[22,1,"した"],[24,2,"しきいし"]],"text":"敷石は門のわきにあり、門と同じ長さで、これは下の敷石である。"},{"ref":"Ezek.40.19","start":26040019,"end":26040019,"break":"none","ruby":[[0,1,"かれ"],[2,1,"した"],[4,1,"もん"],[6,1,"うち"],[8,1,"まえ"],[12,2,"うちにわ"],[15,1,"そと"],[17,1,"まえ"],[21,2,"きょり"],[24,1,"はか"]],"text":"彼が下の門の内の前から、内庭の外の前までの距離を測ると、百キュビトあった。"},{"ref":"Ezek.40.20","start":26040020,"end":26040020,"break":"paragraph","ruby":[[2,1,"かれ"],[8,1,"さき"],[12,1,"きた"],[14,1,"い"],[18,1,"み"],[24,1,"そと"],[25,1,"にわ"],[27,1,"ぞく"],[30,1,"きた"],[31,1,"む"],[34,1,"もん"],[40,1,"かれ"],[44,1,"なが"],[47,1,"はば"],[50,1,"はか"]],"text":"また彼はわたしに先だって北へ行った。見よ、そこに外庭に属する北向きの門があった。彼はその長さと幅とを測った。"},{"ref":"Ezek.40.21","start":26040021,"end":26040021,"break":"none","ruby":[[2,1,"つ"],[4,1,"しょ"],[25,1,"わき"],[26,1,"ばしら"],[28,1,"ろう"],[39,1,"はじ"],[42,1,"もん"],[44,1,"おな"],[46,2,"すんぽう"],[50,1,"なが"],[60,1,"はば"]],"text":"その詰め所が、こなたに三つ、かなたに三つあり、また脇柱と廊とがあった。これらは初めの門と同じ寸法で、長さは五十キュビト、幅は二十五キュビトである。"},{"ref":"Ezek.40.22","start":26040022,"end":26040022,"break":"none","ruby":[[2,1,"まど"],[5,1,"ろう"],[14,1,"ひがし"],[15,1,"む"],[18,1,"もん"],[25,1,"おな"],[27,2,"すんぽう"],[37,1,"だん"],[39,2,"かいだん"],[42,1,"へ"],[48,1,"のぼ"],[52,1,"ろう"],[54,2,"うちがわ"]],"text":"その窓と、廊と、しゅろとは、東向きの門にあるものと同じ寸法である。そして七段の階段を経て、それに上ると、廊は内側にあった。"},{"ref":"Ezek.40.23","start":26040023,"end":26040023,"break":"none","ruby":[[0,2,"うちにわ"],[3,1,"もん"],[5,1,"きた"],[7,1,"ひがし"],[9,1,"もん"],[11,1,"む"],[18,1,"かれ"],[20,1,"もん"],[23,1,"もん"],[27,1,"はか"]],"text":"内庭の門は北と東の門に向かっていた。彼が門から門までを測ると、百キュビトあった。"},{"ref":"Ezek.40.24","start":26040024,"end":26040024,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"みなみ"],[10,1,"い"],[16,1,"み"],[19,1,"みなみ"],[20,1,"む"],[23,1,"もん"],[31,1,"わき"],[32,1,"ばしら"],[34,1,"ろう"],[36,1,"はか"],[40,1,"ほか"],[42,1,"おな"],[44,2,"すんぽう"]],"text":"彼がまたわたしを南へ行かせると、見よ、南向きの門があった。その脇柱と廊を測ると、他と同じ寸法であった。"},{"ref":"Ezek.40.25","start":26040025,"end":26040025,"break":"none","ruby":[[6,1,"ろう"],[8,2,"しゅうい"],[13,1,"た"],[15,1,"まど"],[20,1,"まど"],[28,1,"なが"],[38,1,"はば"]],"text":"これと、その廊の周囲とに、他の窓のような窓があって、その長さは五十キュビト、幅は二十五キュビトあった。"},{"ref":"Ezek.40.26","start":26040026,"end":26040026,"break":"none","ruby":[[3,1,"のぼ"],[8,1,"だん"],[10,2,"かいだん"],[18,1,"ろう"],[20,2,"うちがわ"],[29,1,"わき"],[30,1,"ばしら"],[32,1,"うえ"]],"text":"これを上るのに七段の階段があり、その廊は内側にあった。その脇柱の上には、こなたに一つ、かなたに一つのしゅろがあった。"},{"ref":"Ezek.40.27","start":26040027,"end":26040027,"break":"none","ruby":[[0,2,"うちにわ"],[4,1,"みなみ"],[5,1,"む"],[8,1,"もん"],[13,1,"もん"],[16,1,"もん"],[19,1,"みなみ"],[21,1,"ほう"],[23,1,"はか"]],"text":"内庭には南向きの門があり、門から門まで南の方へ測ると、百キュビトあった。"},{"ref":"Ezek.40.28","start":26040028,"end":26040028,"break":"paragraph","ruby":[[0,1,"かれ"],[6,1,"みなみ"],[8,1,"もん"],[11,2,"うちにわ"],[19,1,"みなみ"],[21,1,"もん"],[23,1,"はか"],[34,1,"おな"],[36,2,"すんぽう"]],"text":"彼がわたしを南の門から内庭にはいらせ、南の門を測ると、さきのものと、同じ寸法であった。"},{"ref":"Ezek.40.29","start":26040029,"end":26040029,"break":"none","ruby":[[2,1,"つ"],[4,1,"しょ"],[7,1,"わき"],[8,1,"ばしら"],[11,1,"ろう"],[15,1,"た"],[20,1,"おな"],[22,2,"すんぽう"],[28,1,"もん"],[31,1,"ろう"],[33,2,"しゅうい"],[38,1,"まど"],[43,1,"もん"],[45,1,"なが"],[55,1,"はば"]],"text":"その詰め所と、脇柱と、廊とは、他のものと同じ寸法で、その門と、廊の周囲とには窓があり、門の長さは五十キュビト、幅は二十五キュビトであった。"},{"ref":"Ezek.40.30","start":26040030,"end":26040030,"break":"none","ruby":[[0,2,"しゅうい"],[3,1,"ろう"],[11,1,"なが"],[22,1,"はば"]],"text":"周囲に廊があって、その長さは二十五キュビト、幅は五キュビトである。"},{"ref":"Ezek.40.31","start":26040031,"end":26040031,"break":"none","ruby":[[2,1,"ろう"],[4,1,"そと"],[5,1,"にわ"],[7,1,"めん"],[11,1,"わき"],[12,1,"ばしら"],[14,1,"うえ"],[25,2,"かいだん"],[29,1,"だん"]],"text":"その廊は外庭に面して、脇柱の上にしゅろがあり、その階段は八段であった。"},{"ref":"Ezek.40.32","start":26040032,"end":26040032,"break":"paragraph","ruby":[[0,1,"かれ"],[8,2,"うちにわ"],[11,1,"ひがし"],[13,1,"ほう"],[15,1,"たずさ"],[18,1,"い"],[22,1,"もん"],[24,1,"はか"],[31,1,"ほか"],[33,1,"おな"],[35,2,"すんぽう"]],"text":"彼はまたわたしを内庭の東の方に携えて行って、門を測った。それは他と同じ寸法であった。"},{"ref":"Ezek.40.33","start":26040033,"end":26040033,"break":"none","ruby":[[2,1,"つ"],[4,1,"しょ"],[7,1,"わき"],[8,1,"ばしら"],[11,1,"ろう"],[15,1,"ほか"],[17,1,"おな"],[19,2,"すんぽう"],[25,1,"もん"],[30,1,"ろう"],[32,2,"しゅうい"],[36,1,"まど"],[41,1,"もん"],[43,1,"なが"],[53,1,"はば"]],"text":"その詰め所と、脇柱と、廊とは、他と同じ寸法で、その門と、その廊の周囲とに窓があり、門の長さは五十キュビト、幅は二十五キュビトである。"},{"ref":"Ezek.40.34","start":26040034,"end":26040034,"break":"none","ruby":[[2,1,"ろう"],[4,1,"そと"],[5,1,"にわ"],[7,1,"めん"],[12,1,"わき"],[13,1,"ばしら"],[15,1,"うえ"],[36,2,"かいだん"],[40,1,"だん"]],"text":"その廊は外庭に面し、その脇柱の上には、こなたかなたに、しゅろがあり、その階段は八段であった。"},{"ref":"Ezek.40.35","start":26040035,"end":26040035,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"きた"],[10,1,"もん"],[12,1,"たずさ"],[15,1,"い"],[22,1,"はか"],[29,1,"ほか"],[31,1,"おな"],[33,2,"すんぽう"]],"text":"彼がまたわたしを北の門に携えて行って、これを測ると、それは他と同じ寸法であった。"},{"ref":"Ezek.40.36","start":26040036,"end":26040036,"break":"none","ruby":[[2,1,"つ"],[4,1,"しょ"],[7,1,"わき"],[8,1,"ばしら"],[11,1,"ろう"],[15,1,"ほか"],[17,1,"おな"],[19,2,"すんぽう"],[25,2,"しゅうい"],[28,1,"まど"],[33,1,"もん"],[35,1,"なが"],[45,1,"はば"]],"text":"その詰め所と、脇柱と、廊とは、他と同じ寸法で、その周囲に窓があり、門の長さは五十キュビト、幅は二十五キュビトである。"},{"ref":"Ezek.40.37","start":26040037,"end":26040037,"break":"none","ruby":[[2,1,"ろう"],[4,1,"そと"],[5,1,"にわ"],[7,1,"めん"],[12,1,"わき"],[13,1,"ばしら"],[15,1,"うえ"],[36,2,"かいだん"],[40,1,"だん"]],"text":"その廊は外庭に面し、その脇柱の上には、こなたかなたに、しゅろがあり、その階段は八段であった。"},{"ref":"Ezek.40.38","start":26040038,"end":26040038,"break":"paragraph","ruby":[[0,1,"もん"],[2,1,"ろう"],[4,1,"と"],[8,1,"しつ"],[17,2,"はんさい"],[20,1,"もの"],[22,1,"あら"],[24,1,"ところ"]],"text":"門の廊に戸のある室があって、そこは燔祭の物を洗う所である。"},{"ref":"Ezek.40.39","start":26040039,"end":26040039,"break":"none","ruby":[[0,1,"もん"],[2,1,"ろう"],[12,1,"だい"],[21,1,"だい"],[28,1,"うえ"],[31,2,"はんさい"],[34,2,"ざいさい"],[37,2,"けんさい"],[40,1,"もの"]],"text":"門の廊に、こなたに二つの台、かなたに二つの台があり、その上で、燔祭、罪祭、愆祭の物をほふるのであった。"},{"ref":"Ezek.40.40","start":26040040,"end":26040040,"break":"none","ruby":[[0,1,"きた"],[2,1,"もん"],[4,2,"いりぐち"],[9,1,"ろう"],[11,1,"そと"],[13,2,"かたがわ"],[20,1,"だい"],[25,1,"もん"],[27,1,"ろう"],[29,1,"た"],[31,1,"がわ"],[38,1,"だい"]],"text":"北の門の入口にある廊の外の片側に、二つの台があり、門の廊の他の側にも、二つの台があり、"},{"ref":"Ezek.40.41","start":26040041,"end":26040041,"break":"none","ruby":[[0,1,"もん"],[7,2,"うちがわ"],[13,1,"だい"],[15,2,"そとがわ"],[21,1,"だい"],[27,1,"あ"],[34,1,"だい"],[41,1,"うえ"],[44,2,"ぎせい"],[47,1,"もの"]],"text":"門のかたわら、内側に四つの台、外側に四つの台があって、合わせて八つの台である。その上で、犠牲の物をほふるのである。"},{"ref":"Ezek.40.42","start":26040042,"end":26040042,"break":"none","ruby":[[5,2,"はんさい"],[14,1,"き"],[16,1,"いし"],[18,1,"だい"],[25,1,"なが"],[33,1,"はん"],[35,1,"はば"],[42,1,"はん"],[44,1,"たか"],[55,1,"うえ"],[57,2,"はんさい"],[62,2,"ぎせい"],[68,1,"うつわ"],[70,1,"お"]],"text":"そこにまた燔祭のために四つの切り石の台があり、その長さは一キュビト半、幅は一キュビト半、高さは一キュビト、その上に燔祭および犠牲をほふる器を置くのである。"},{"ref":"Ezek.40.43","start":26040043,"end":26040043,"break":"none","ruby":[[0,1,"うち"],[2,2,"しゅうい"],[6,1,"ひと"],[7,1,"て"],[8,1,"はば"],[10,1,"お"],[12,1,"くぎ"],[14,1,"う"],[23,1,"そな"],[25,1,"もの"],[27,1,"にく"],[30,1,"だい"],[32,1,"うえ"],[34,1,"お"]],"text":"内の周囲に、一手幅の折り釘が打ちつけてあって、供え物の肉は、台の上に置かれるのである。"},{"ref":"Ezek.40.44","start":26040044,"end":26040044,"break":"paragraph","ruby":[[0,1,"かれ"],[9,1,"そと"],[12,2,"うちにわ"],[15,1,"つ"],[23,1,"み"],[26,2,"うちにわ"],[32,1,"しつ"],[40,1,"きた"],[42,1,"もん"],[52,1,"みなみ"],[54,1,"む"],[61,1,"みなみ"],[63,1,"もん"],[74,1,"きた"],[76,1,"む"]],"text":"彼はまたわたしを、外から内庭に連れてはいった。見よ、内庭に二つの室があり、一つは北の門のかたわらにあって南に向かい、一つは南の門のかたわらにあって、北に向かっていた。"},{"ref":"Ezek.40.45","start":26040045,"end":26040045,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[12,1,"みなみ"],[13,1,"む"],[16,1,"しつ"],[19,1,"みや"],[21,1,"まも"],[23,2,"さいし"]],"text":"彼はわたしに言った、この南向きの室は、宮を守る祭司のためのもの、"},{"ref":"Ezek.40.46","start":26040046,"end":26040046,"break":"none","ruby":[[2,1,"きた"],[3,1,"む"],[6,1,"しつ"],[9,2,"さいだん"],[12,1,"まも"],[14,2,"さいし"],[28,1,"ひと"],[36,2,"しそん"],[46,2,"しそん"],[53,1,"しゅ"],[55,1,"ちか"],[57,1,"つか"],[60,1,"もの"]],"text":"また北向きの室は、祭壇を守る祭司のためのものである。その人たちは、レビの子孫のうちのザドクの子孫であって、主に近く仕える者たちである。"},{"ref":"Ezek.40.47","start":26040047,"end":26040047,"break":"none","ruby":[[3,1,"かれ"],[5,1,"にわ"],[7,1,"はか"],[13,1,"なが"],[22,1,"はば"],[31,1,"かく"],[36,1,"みや"],[38,1,"まえ"],[41,2,"さいだん"]],"text":"そして彼が庭を測ると、その長さは百キュビト、幅も百キュビトで四角である。宮の前には祭壇があった。"},{"ref":"Ezek.40.48","start":26040048,"end":26040048,"break":"paragraph","ruby":[[0,1,"かれ"],[6,1,"みや"],[8,1,"ろう"],[10,1,"つ"],[13,1,"い"],[17,1,"ろう"],[19,1,"わき"],[20,1,"ばしら"],[22,1,"はか"],[49,1,"もん"],[51,1,"はば"],[63,1,"もん"],[65,1,"かべ"]],"text":"彼がわたしを宮の廊に連れて行って、廊の脇柱を測ると、こなたも五キュビト、かなたも五キュビトであり、門の幅は十四キュビトである。門の壁は、こなたも三キュビト、かなたも三キュビトである。"},{"ref":"Ezek.40.49","start":26040049,"end":26040049,"break":"none","ruby":[[0,1,"ろう"],[2,1,"なが"],[12,1,"はば"],[26,2,"かいだん"],[32,1,"のぼ"],[39,1,"わき"],[40,1,"ばしら"],[42,1,"そ"],[60,1,"はしら"]],"text":"廊の長さは二十キュビト、幅は十二キュビトであり、十の階段によって上るのである。脇柱に沿って、こなたに一つ、かなたに一つの柱があった。"}]