[{"ref":"Ezek.8.1","start":26008001,"end":26008001,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"ねん"],[5,1,"がつ"],[7,1,"か"],[17,1,"いえ"],[19,1,"ざ"],[25,2,"ちょうろう"],[34,1,"まえ"],[36,1,"ざ"],[44,1,"しゅ"],[47,1,"かみ"],[49,1,"て"],[55,1,"うえ"],[57,1,"くだ"]],"text":"第六年の六月五日にわたしがわたしの家に座し、ユダの長老たちがわたしの前に座していたとき、主なる神の手がわたしの上に下った。"},{"ref":"Ezek.8.2","start":26008002,"end":26008002,"break":"none","ruby":[[4,1,"み"],[10,1,"み"],[13,1,"ひと"],[18,1,"かたち"],[26,1,"こし"],[32,1,"ところ"],[35,1,"した"],[37,1,"ひ"],[42,1,"み"],[45,1,"こし"],[48,1,"うえ"],[50,1,"ひか"],[52,2,"せいどう"],[58,1,"かがや"],[61,1,"み"]],"text":"わたしは見ていると、見よ、人のような形があって、その腰とみられる所から下は火のように見え、腰から上は光る青銅のように輝いて見えた。"},{"ref":"Ezek.8.3","start":26008003,"end":26008003,"break":"none","ruby":[[0,1,"かれ"],[2,1,"て"],[10,1,"の"],[18,1,"かみ"],[20,1,"け"],[30,1,"れい"],[36,1,"てん"],[38,1,"ち"],[40,1,"あいだ"],[42,1,"ひ"],[47,1,"かみ"],[49,1,"まぼろし"],[64,1,"たずさ"],[67,1,"い"],[70,1,"きた"],[72,1,"む"],[76,2,"うちにわ"],[79,1,"もん"],[81,2,"いりぐち"],[84,1,"いた"],[100,1,"おこ"],[106,2,"ぐうぞう"]],"text":"彼は手のようなものを伸べて、わたしの髪の毛をつかんだ。そして霊がわたしを天と地の間に引きあげ、神の幻のうちにわたしをエルサレムに携えて行き、北に向かった内庭の門の入口に至らせた。そこには、ねたみをひき起すねたみの偶像があった。"},{"ref":"Ezek.8.4","start":26008004,"end":26008004,"break":"none","ruby":[[0,1,"み"],[13,2,"へいや"],[16,1,"み"],[18,1,"まぼろし"],[29,1,"かみ"],[31,2,"えいこう"]],"text":"見よ、そこに、わたしがかの平野で見た幻のようなイスラエルの神の栄光があらわれた。"},{"ref":"Ezek.8.5","start":26008005,"end":26008005,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"かれ"],[8,1,"い"],[14,1,"ひと"],[16,1,"こ"],[19,1,"め"],[24,1,"きた"],[26,1,"ほう"],[40,1,"め"],[45,1,"きた"],[47,1,"ほう"],[54,1,"み"],[57,2,"さいだん"],[60,1,"もん"],[62,1,"きた"],[71,2,"いりぐち"],[81,2,"ぐうぞう"]],"text":"時に彼はわたしに言われた、「人の子よ、目をあげて北の方をのぞめ」。そこでわたしが目をあげて北の方をのぞむと、見よ、祭壇の門の北にあたって、その入口に、このねたみの偶像があった。"},{"ref":"Ezek.8.6","start":26008006,"end":26008006,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[14,1,"ひと"],[16,1,"こ"],[23,1,"かれ"],[43,1,"いえ"],[52,1,"おお"],[56,1,"にく"],[63,1,"み"],[74,2,"せいじょ"],[78,1,"とお"],[99,1,"おお"],[103,1,"にく"],[110,1,"み"]],"text":"彼はまたわたしに言われた、「人の子よ、あなたは彼らのしていること、すなわちイスラエルの家がここでしている大いなる憎むべきことを見るか。これはわたしを聖所から遠ざけるものである。しかしあなたは、さらに大いなる憎むべきことを見るだろう」。"},{"ref":"Ezek.8.7","start":26008007,"end":26008007,"break":"paragraph","ruby":[[3,1,"かれ"],[9,1,"にわ"],[11,1,"もん"],[13,1,"い"],[22,1,"み"],[26,1,"み"],[29,1,"かべ"],[34,1,"あな"]],"text":"そして彼はわたしを庭の門に行かせた。わたしが見ると、見よ、壁に一つの穴があった。"},{"ref":"Ezek.8.8","start":26008008,"end":26008008,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[12,1,"ひと"],[14,1,"こ"],[17,1,"かべ"],[19,1,"あな"],[33,1,"かべ"],[35,1,"あな"],[42,1,"み"],[48,1,"と"]],"text":"彼はわたしに言われた、「人の子よ、壁に穴をあけよ」。そこでわたしが壁に穴をあけると、見よ、一つの戸があった。"},{"ref":"Ezek.8.9","start":26008009,"end":26008009,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[17,1,"かれ"],[25,1,"ところ"],[27,1,"あ"],[30,1,"にく"],[37,1,"み"]],"text":"彼はわたしに言われた、「はいって、彼らがここでなす所の悪しき憎むべきことを見よ」。"},{"ref":"Ezek.8.10","start":26008010,"end":26008010,"break":"none","ruby":[[11,1,"み"],[20,1,"は"],[26,1,"にく"],[30,1,"けもの"],[32,1,"かたち"],[43,1,"いえ"],[50,2,"ぐうぞう"],[58,1,"かべ"],[60,1,"えが"]],"text":"そこでわたしがはいって見ると、もろもろの這うものと、憎むべき獣の形、およびイスラエルの家のもろもろの偶像が、まわりの壁に描いてあった。"},{"ref":"Ezek.8.11","start":26008011,"end":26008011,"break":"none","ruby":[[8,1,"いえ"],[10,2,"ちょうろう"],[14,1,"にん"],[19,1,"まえ"],[21,1,"た"],[32,1,"こ"],[39,1,"かれ"],[42,1,"なか"],[44,1,"た"],[54,1,"て"],[56,2,"こうろ"],[59,1,"も"],[67,1,"こう"],[69,1,"けむり"],[71,1,"くも"]],"text":"またイスラエルの家の長老七十人が、その前に立っていた。シャパンの子ヤザニヤも、彼らの中に立っていた。おのおの手に香炉を持ち、そしてその香の煙が雲のようにのぼった。"},{"ref":"Ezek.8.12","start":26008012,"end":26008012,"break":"none","ruby":[[0,1,"とき"],[2,1,"かれ"],[8,1,"い"],[14,1,"ひと"],[16,1,"こ"],[25,1,"いえ"],[27,2,"ちょうろう"],[32,1,"くら"],[34,1,"ところ"],[36,1,"おこな"],[38,1,"こと"],[50,2,"ぐうぞう"],[53,1,"しつ"],[55,1,"おこな"],[57,1,"こと"],[59,1,"み"],[63,1,"かれ"],[66,1,"い"],[70,1,"しゅ"],[77,1,"み"],[83,1,"しゅ"],[87,1,"ち"],[89,1,"す"]],"text":"時に彼はわたしに言われた、「人の子よ、イスラエルの家の長老たちが暗い所で行う事、すなわちおのおのその偶像の室で行う事を見るか。彼らは言う、『主はわれわれを見られない。主はこの地を捨てられた』と」。"},{"ref":"Ezek.8.13","start":26008013,"end":26008013,"break":"none","ruby":[[6,1,"い"],[19,1,"かれ"],[24,1,"おお"],[28,1,"にく"],[35,1,"み"]],"text":"またわたしに言われた、「あなたはさらに彼らがなす大いなる憎むべきことを見る」。"},{"ref":"Ezek.8.14","start":26008014,"end":26008014,"break":"paragraph","ruby":[[3,1,"かれ"],[9,1,"つ"],[12,1,"しゅ"],[14,1,"いえ"],[16,1,"きた"],[18,1,"もん"],[20,2,"いりぐち"],[23,1,"い"],[27,1,"み"],[33,1,"おんな"],[50,1,"な"]],"text":"そして彼はわたしを連れて主の家の北の門の入口に行った。見よ、そこに女たちがすわって、タンムズのために泣いていた。"},{"ref":"Ezek.8.15","start":26008015,"end":26008015,"break":"none","ruby":[[2,1,"とき"],[4,1,"かれ"],[10,1,"い"],[16,1,"ひと"],[18,1,"こ"],[28,1,"み"],[40,1,"おお"],[44,1,"にく"],[51,1,"み"]],"text":"その時、彼はわたしに言われた、「人の子よ、あなたはこれを見たか。これよりもさらに大いなる憎むべきことを見るだろう」。"},{"ref":"Ezek.8.16","start":26008016,"end":26008016,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"つ"],[12,1,"しゅ"],[14,1,"いえ"],[16,2,"うちにわ"],[24,1,"み"],[27,1,"しゅ"],[29,1,"みや"],[31,2,"いりぐち"],[35,1,"ろう"],[37,2,"さいだん"],[41,1,"あいだ"],[46,1,"にん"],[51,1,"ひと"],[54,1,"しゅ"],[56,1,"みや"],[60,2,"せなか"],[63,1,"む"],[66,1,"かお"],[68,1,"ひがし"],[70,1,"む"],[73,1,"ひがし"],[75,1,"む"],[79,2,"たいよう"],[82,1,"おが"]],"text":"彼はまたわたしを連れて、主の家の内庭にはいった。見よ、主の宮の入口に、廊と祭壇との間に二十五人ばかりの人が、主の宮にその背中を向け、顔を東に向け、東に向かって太陽を拝んでいた。"},{"ref":"Ezek.8.17","start":26008017,"end":26008017,"break":"none","ruby":[[0,1,"とき"],[2,1,"かれ"],[8,1,"い"],[14,1,"ひと"],[16,1,"こ"],[26,1,"み"],[33,1,"いえ"],[39,1,"かれ"],[53,1,"にく"],[60,1,"かる"],[69,1,"かれ"],[74,1,"ち"],[76,2,"ぼうぎゃく"],[79,1,"み"],[90,1,"いか"],[95,1,"み"],[98,1,"かれ"],[103,1,"はな"],[105,1,"き"],[107,1,"えだ"],[109,1,"お"]],"text":"時に彼はわたしに言われた、「人の子よ、あなたはこれを見たか。ユダの家にとって、彼らがここでしているこれらの憎むべきわざは軽いことであるか。彼らはこの地を暴虐で満たし、さらにわたしを怒らせる。見よ、彼らはその鼻に木の枝を置く。"},{"ref":"Ezek.8.18","start":26008018,"end":26008018,"break":"none","ruby":[[9,1,"いきどお"],[12,1,"こと"],[14,1,"おこな"],[21,1,"め"],[23,1,"かれ"],[26,1,"お"],[29,1,"み"],[44,1,"かれ"],[51,1,"みみ"],[53,2,"おおごえ"],[56,1,"よ"],[67,1,"かれ"],[70,1,"い"],[75,1,"き"]],"text":"それゆえ、わたしも憤って事を行う。わたしの目は彼らを惜しみ見ず、またあわれまない。たとい彼らがわたしの耳に大声で呼ばわっても、わたしは彼らの言うことを聞かない」。"}]