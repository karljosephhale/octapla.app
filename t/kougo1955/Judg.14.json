[{"ref":"Judg.14.1","start":7014001,"end":7014001,"break":"paragraph","ruby":[[9,1,"くだ"],[12,1,"い"],[22,1,"むすめ"],[29,1,"す"],[35,1,"おんな"],[37,1,"み"]],"text":"サムソンはテムナに下って行き、ペリシテびとの娘で、テムナに住むひとりの女を見た。"},{"ref":"Judg.14.2","start":7014002,"end":7014002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かえ"],[7,2,"ふぼ"],[10,1,"い"],[26,1,"むすめ"],[33,1,"す"],[39,1,"おんな"],[41,1,"み"],[46,2,"かのじょ"],[57,1,"つま"]],"text":"彼は帰ってきて父母に言った、「わたしはペリシテびとの娘で、テムナに住むひとりの女を見ました。彼女をめとってわたしの妻にしてください」。"},{"ref":"Judg.14.3","start":7014003,"end":7014003,"break":"none","ruby":[[0,2,"ふぼ"],[3,1,"い"],[12,1,"い"],[16,2,"かつれい"],[34,1,"つま"],[36,1,"むか"],[46,2,"みうち"],[49,1,"むすめ"],[71,1,"たみ"],[76,1,"おんな"],[97,1,"ちち"],[99,1,"い"],[104,2,"かのじょ"],[120,2,"かのじょ"],[127,1,"こころ"]],"text":"父母は言った、「あなたが行って、割礼をうけないペリシテびとのうちから妻を迎えようとするのは、身内の娘たちのうちに、あるいはわたしたちのすべての民のうちに女がないためなのですか」。しかしサムソンは父に言った、「彼女をわたしにめとってください。彼女はわたしの心にかないますから」。"},{"ref":"Judg.14.4","start":7014004,"end":7014004,"break":"paragraph","ruby":[[0,2,"ふぼ"],[5,1,"こと"],[7,1,"しゅ"],[10,1,"で"],[20,1,"し"],[39,1,"せ"],[78,1,"おさ"]],"text":"父母はこの事が主から出たものであることを知らなかった。サムソンはペリシテびとを攻めようと、おりをうかがっていたからである。そのころペリシテびとはイスラエルを治めていた。"},{"ref":"Judg.14.5","start":7014005,"end":7014005,"break":"paragraph","ruby":[[8,2,"ふぼ"],[11,1,"とも"],[17,1,"くだ"],[20,1,"い"],[24,1,"かれ"],[33,1,"はたけ"],[35,1,"つ"],[40,1,"とう"],[42,1,"わか"],[53,1,"かれ"],[55,1,"む"]],"text":"かくてサムソンは父母と共にテムナに下って行った。彼がテムナのぶどう畑に着くと、一頭の若いししがほえたけって彼に向かってきた。"},{"ref":"Judg.14.6","start":7014006,"end":7014006,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,1,"れい"],[6,1,"はげ"],[9,1,"かれ"],[11,1,"のぞ"],[17,1,"かれ"],[23,1,"こ"],[27,1,"さ"],[37,1,"さ"],[42,1,"て"],[48,2,"ぶき"],[51,1,"も"],[75,1,"ちち"],[78,1,"はは"],[81,1,"つ"]],"text":"時に主の霊が激しく彼に臨んだので、彼はあたかも子やぎを裂くようにそのししを裂いたが、手にはなんの武器も持っていなかった。しかしサムソンはそのしたことを父にも母にも告げなかった。"},{"ref":"Judg.14.7","start":7014007,"end":7014007,"break":"none","ruby":[[5,1,"くだ"],[8,1,"い"],[11,1,"おんな"],[13,1,"はな"],[15,1,"あ"],[20,1,"おんな"],[27,1,"こころ"]],"text":"サムソンは下って行って女と話し合ったが、女はサムソンの心にかなった。"},{"ref":"Judg.14.8","start":7014008,"end":7014008,"break":"none","ruby":[[0,1,"ひ"],[5,1,"のち"],[12,2,"かのじょ"],[22,1,"かえ"],[27,1,"みち"],[29,1,"てん"],[43,1,"み"],[58,1,"む"],[62,1,"みつ"]],"text":"日がたって後、サムソンは彼女をめとろうとして帰ったが、道を転じて、かのししのしかばねを見ると、ししのからだに、はちの群れと、蜜があった。"},{"ref":"Judg.14.9","start":7014009,"end":7014009,"break":"none","ruby":[[0,1,"かれ"],[11,1,"て"],[16,1,"ある"],[21,1,"た"],[24,2,"ふぼ"],[30,1,"かえ"],[34,1,"かれ"],[37,1,"あた"],[43,1,"かれ"],[49,1,"た"],[67,1,"みつ"],[78,1,"かれ"],[81,1,"つ"]],"text":"彼はそれをかきあつめ、手にとって歩きながら食べ、父母のもとに帰って、彼らに与えたので、彼らもそれを食べた。しかし、ししのからだからその蜜をかきあつめたことは彼らに告げなかった。"},{"ref":"Judg.14.10","start":7014010,"end":7014010,"break":"paragraph","ruby":[[3,1,"ちち"],[5,1,"くだ"],[9,1,"おんな"],[14,1,"い"],[33,1,"もう"],[44,2,"はなむこ"]],"text":"そこで父が下って、女のもとに行ったので、サムソンはそこにふるまいを設けた。そうすることは花婿のならわしであったからである。"},{"ref":"Judg.14.11","start":7014011,"end":7014011,"break":"none","ruby":[[0,2,"ひとびと"],[8,1,"み"],[14,1,"にん"],[16,1,"きゃく"],[18,1,"つ"],[24,2,"どうせき"]],"text":"人々はサムソンを見ると、三十人の客を連れてきて、同席させた。"},{"ref":"Judg.14.12","start":7014012,"end":7014012,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[29,1,"だ"],[44,2,"なぬか"],[58,1,"と"],[66,1,"つ"],[88,2,"あま"],[91,2,"きもの"],[97,1,"は"],[99,1,"ぎ"]],"text":"サムソンは彼らに言った、「わたしはあなたがたに一つのなぞを出しましょう。あなたがたがもし七日のふるまいのうちにそれを解いて、わたしに告げることができたなら、わたしはあなたがたに亜麻の着物三十と、晴れ着三十をさしあげましょう。"},{"ref":"Judg.14.13","start":7014013,"end":7014013,"break":"none","ruby":[[17,1,"つ"],[30,2,"あま"],[33,2,"きもの"],[38,1,"は"],[40,1,"ぎ"],[61,1,"かれ"],[69,1,"い"],[77,1,"だ"],[92,1,"き"]],"text":"しかしあなたがたが、それをわたしに告げることができなければ、亜麻の着物三十と晴れ着三十をわたしにくれなければなりません」。彼らはサムソンに言った、「なぞを出しなさい。わたしたちはそれを聞きましょう」。"},{"ref":"Judg.14.14","start":7014014,"end":7014014,"break":"none","breaks":[[12,"stanza"],[25,"line"]],"ruby":[[5,1,"かれ"],[8,1,"い"],[13,1,"く"],[16,1,"もの"],[19,1,"く"],[21,1,"もの"],[23,1,"で"],[25,1,"つよ"],[27,1,"もの"],[30,1,"あま"],[32,1,"もの"],[34,1,"で"],[38,1,"かれ"],[42,1,"か"],[50,1,"と"]],"text":"サムソンは彼らに言った、「食らう者から食い物が出、強い者から甘い物が出た」。彼らは三日のあいだなぞを解くことができなかった。"},{"ref":"Judg.14.15","start":7014015,"end":7014015,"break":"paragraph","ruby":[[1,1,"か"],[2,1,"め"],[8,1,"かれ"],[16,1,"つま"],[18,1,"い"],[27,1,"おっと"],[29,1,"と"],[45,1,"あ"],[72,1,"ひ"],[85,1,"ちち"],[87,1,"いえ"],[89,1,"や"],[108,1,"もの"],[110,1,"と"],[122,1,"まね"]],"text":"四日目になって、彼らはサムソンの妻に言った、「あなたの夫を説きすすめて、なぞをわたしたちに明かすようにしてください。そうしなければ、わたしたちは火をつけてあなたとあなたの父の家を焼いてしまいます。あなたはわたしたちの物を取るために、わたしたちを招いたのですか」。"},{"ref":"Judg.14.16","start":7014016,"end":7014016,"break":"none","ruby":[[8,1,"つま"],[15,1,"まえ"],[17,1,"な"],[20,1,"い"],[35,1,"にく"],[41,1,"あい"],[58,1,"くに"],[60,2,"ひとびと"],[66,1,"だ"],[77,1,"と"],[79,1,"あ"],[95,2,"かのじょ"],[98,1,"い"],[107,2,"じぶん"],[110,1,"ちち"],[113,1,"はは"],[116,1,"と"],[118,1,"あ"],[134,1,"と"],[136,1,"あ"]],"text":"そこでサムソンの妻はサムソンの前に泣いて言った、「あなたはただわたしを憎むだけで、愛してくれません。あなたはわたしの国の人々になぞを出して、それをわたしに解き明かしませんでした」。サムソンは彼女に言った、「わたしは自分の父にも母にも解き明かさなかった。どうしてあなたに解き明かせよう」。"},{"ref":"Judg.14.17","start":7014017,"end":7014017,"break":"none","ruby":[[0,2,"かのじょ"],[3,2,"なぬか"],[11,1,"あいだ"],[13,1,"かれ"],[15,1,"まえ"],[17,1,"な"],[24,2,"なぬか"],[26,1,"め"],[40,2,"かのじょ"],[43,1,"と"],[45,1,"あ"],[53,1,"かれ"],[55,1,"せま"],[67,2,"かのじょ"],[73,2,"じぶん"],[76,1,"くに"],[78,2,"ひとびと"]],"text":"彼女は七日のふるまいの間、彼の前に泣いていたが、七日目になって、サムソンはついに彼女に解き明かした。ひどく彼に迫ったからである。そこで彼女はなぞを自分の国の人々にあかした。"},{"ref":"Judg.14.18","start":7014018,"end":7014018,"break":"none","breaks":[[29,"stanza"],[44,"line"],[72,"stanza"],[91,"line"]],"ruby":[[0,2,"なぬか"],[2,1,"め"],[8,1,"ひ"],[10,1,"ぼっ"],[13,1,"まえ"],[15,1,"まち"],[17,2,"ひとびと"],[25,1,"い"],[30,1,"みつ"],[33,1,"あま"],[38,1,"なに"],[48,1,"つよ"],[53,1,"なに"],[65,1,"かれ"],[68,1,"い"],[77,1,"わか"],[79,2,"めうし"],[82,1,"たがや"],[98,1,"と"]],"text":"七日目になって、日の没する前に町の人々はサムソンに言った、「蜜より甘いものに何があろう。ししより強いものに何があろう」。サムソンは彼らに言った、「わたしの若い雌牛で耕さなかったなら、わたしのなぞは解けなかった」。"},{"ref":"Judg.14.19","start":7014019,"end":7014019,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,1,"れい"],[8,1,"はげ"],[16,1,"のぞ"],[33,1,"くだ"],[36,1,"い"],[42,1,"まち"],[44,1,"もの"],[47,1,"にん"],[49,1,"ころ"],[52,1,"かれ"],[58,1,"と"],[67,1,"と"],[70,2,"ひとびと"],[76,1,"は"],[78,1,"ぎ"],[80,1,"あた"],[83,1,"はげ"],[86,1,"いか"],[89,1,"ちち"],[91,1,"いえ"],[93,1,"かえ"]],"text":"この時、主の霊が激しくサムソンに臨んだので、サムソンはアシケロンに下って行って、その町の者三十人を殺し、彼らからはぎ取って、かのなぞを解いた人々に、その晴れ着を与え、激しく怒って父の家に帰った。"},{"ref":"Judg.14.20","start":7014020,"end":7014020,"break":"none","ruby":[[5,1,"つま"],[7,2,"はなむこ"],[9,3,"つきそいにん"],[16,1,"きゃく"],[18,1,"つま"]],"text":"サムソンの妻は花婿付添人であった客の妻となった。"}]