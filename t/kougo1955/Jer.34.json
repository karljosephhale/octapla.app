[{"ref":"Jer.34.1","start":24034001,"end":24034001,"break":"paragraph","ruby":[[5,1,"おう"],[16,1,"ぜん"],[17,1,"ぐん"],[20,1,"かれ"],[22,1,"したが"],[27,1,"ち"],[33,1,"くに"],[35,2,"ひとびと"],[46,1,"たみ"],[48,1,"ひき"],[60,2,"まちまち"],[63,1,"せ"],[66,1,"たたか"],[71,1,"とき"],[74,1,"しゅ"],[82,1,"のぞ"],[85,2,"ことば"]],"text":"バビロンの王ネブカデレザルがその全軍と、彼に従っている地のすべての国の人々、およびもろもろの民を率いて、エルサレムとその町々を攻めて戦っていた時に、主からエレミヤに臨んだ言葉、"},{"ref":"Jer.34.2","start":24034002,"end":24034002,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[13,1,"い"],[18,1,"い"],[24,1,"おう"],[30,1,"つ"],[33,1,"い"],[40,1,"しゅ"],[44,1,"い"],[49,1,"み"],[58,1,"まち"],[65,1,"おう"],[67,1,"て"],[69,1,"わた"],[72,1,"かれ"],[74,1,"ひ"],[79,1,"や"]],"text":"「イスラエルの神、主はこう言われる、行ってユダの王ゼデキヤに告げて言いなさい、『主はこう言われる、見よ、わたしはこの町をバビロンの王の手に渡す。彼は火でこれを焼く。"},{"ref":"Jer.34.3","start":24034003,"end":24034003,"break":"none","ruby":[[6,1,"て"],[20,1,"かなら"],[22,1,"とら"],[29,1,"て"],[31,1,"わた"],[50,1,"おう"],[52,1,"み"],[54,1,"かお"],[56,1,"かお"],[58,1,"あ"],[62,1,"かれ"],[64,1,"かた"],[76,1,"い"]],"text":"あなたはその手をのがれることはできない、必ず捕えられてその手に渡される。あなたはまのあたりバビロンの王を見、顔と顔を合わせて彼と語る。それからバビロンへ行く』。"},{"ref":"Jer.34.4","start":24034004,"end":24034004,"break":"none","ruby":[[6,1,"おう"],[13,1,"しゅ"],[15,2,"ことば"],[18,1,"き"],[24,1,"しゅ"],[30,1,"こと"],[37,1,"い"],[51,1,"し"]],"text":"しかしユダの王ゼデキヤよ、主の言葉を聞きなさい。主はあなたの事についてこう言われる、『あなたはつるぎで死ぬことはない。"},{"ref":"Jer.34.5","start":24034005,"end":24034005,"break":"none","ruby":[[4,1,"やす"],[8,1,"し"],[11,1,"たみ"],[17,2,"せんぞ"],[26,1,"さき"],[28,1,"おう"],[35,1,"こう"],[52,1,"こう"],[66,1,"なげ"],[73,2,"しゅくん"],[78,1,"い"],[88,2,"ことば"],[98,1,"しゅ"],[100,1,"い"]],"text":"あなたは安らかに死ぬ。民はあなたの先祖であるあなたの先の王たちのために香をたいたように、あなたのためにも香をたき、またあなたのために嘆いて「ああ、主君よ」と言う』。わたしがこの言葉をいうのであると主は言われる」。"},{"ref":"Jer.34.6","start":24034006,"end":24034006,"break":"paragraph","ruby":[[3,3,"よげんしゃ"],[13,2,"ことば"],[30,1,"おう"],[36,1,"つ"]],"text":"そこで預言者エレミヤはこの言葉をことごとくエルサレムでユダの王ゼデキヤに告げた。"},{"ref":"Jer.34.7","start":24034007,"end":24034007,"break":"none","ruby":[[2,1,"とき"],[8,1,"おう"],[10,2,"ぐんぜい"],[22,1,"のこ"],[34,1,"まち"],[48,1,"せ"],[51,1,"たたか"],[63,2,"まちまち"],[74,2,"けんご"],[77,1,"まち"],[81,1,"のこ"]],"text":"その時バビロンの王の軍勢はエルサレム、および残っているユダのすべての町、すなわちラキシとアゼカを攻めて戦っていた。それはユダの町々のうちに、これらの堅固な町がなお残っていたからである。"},{"ref":"Jer.34.8","start":24034008,"end":24034008,"break":"paragraph","ruby":[[4,1,"おう"],[18,1,"たみ"],[20,2,"けいやく"],[23,1,"た"],[27,1,"かれ"],[30,2,"しゃくほう"],[36,1,"つ"],[38,1,"しめ"],[41,1,"のち"],[44,1,"しゅ"],[52,1,"のぞ"],[55,2,"ことば"]],"text":"ゼデキヤ王がエルサレムにいるすべての民と契約を立てて、彼らに釈放のことを告げ示した後に、主からエレミヤに臨んだ言葉。"},{"ref":"Jer.34.9","start":24034009,"end":24034009,"break":"none","ruby":[[2,2,"けいやく"],[9,1,"ひと"],[25,2,"だんじょ"],[28,2,"どれい"],[31,2,"かいほう"],[37,2,"きょうだい"],[45,1,"ひと"],[47,2,"どれい"],[56,1,"さだ"]],"text":"その契約はすなわち人がおのおのそのヘブルびとである男女の奴隷を解放し、その兄弟であるユダヤ人を奴隷としないことを定めたものであった。"},{"ref":"Jer.34.10","start":24034010,"end":24034010,"break":"none","ruby":[[2,2,"けいやく"],[18,1,"たみ"],[20,1,"ひと"],[28,2,"だんじょ"],[31,2,"どれい"],[34,2,"かいほう"],[38,1,"ふたた"],[43,2,"どれい"],[55,1,"き"],[57,1,"したが"],[64,2,"かいほう"]],"text":"この契約をしたつかさたちと、すべての民は人がおのおのその男女の奴隷を解放し、再びこれを奴隷としないということに聞き従って、これを解放したが、"},{"ref":"Jer.34.11","start":24034011,"end":24034011,"break":"none","ruby":[[0,1,"のち"],[2,1,"こころ"],[4,1,"ひるがえ"],[7,2,"かいほう"],[11,2,"だんじょ"],[14,2,"どれい"],[24,1,"ふたた"],[29,1,"したが"],[33,2,"どれい"]],"text":"後に心を翻し、解放した男女の奴隷をひきかえさせ、再びこれを従わせて奴隷とした。"},{"ref":"Jer.34.12","start":24034012,"end":24034012,"break":"none","ruby":[[3,1,"しゅ"],[5,2,"ことば"],[8,1,"しゅ"],[16,1,"のぞ"]],"text":"そこで主の言葉が主からエレミヤに臨んだ、"},{"ref":"Jer.34.13","start":24034013,"end":24034013,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[13,1,"い"],[28,2,"せんぞ"],[36,1,"ち"],[40,2,"どれい"],[46,1,"いえ"],[49,1,"みちび"],[51,1,"だ"],[54,1,"とき"],[56,1,"かれ"],[59,2,"けいやく"],[62,1,"た"],[65,1,"い"]],"text":"「イスラエルの神、主はこう言われる、わたしはあなたがたの先祖をエジプトの地、その奴隷であった家から導き出した時、彼らと契約を立てて言った、"},{"ref":"Jer.34.14","start":24034014,"end":24034014,"break":"none","ruby":[[7,2,"きょうだい"],[25,1,"み"],[27,1,"う"],[31,1,"ねん"],[33,1,"あいだ"],[40,1,"つか"],[43,1,"もの"],[47,1,"ねん"],[49,1,"おわ"],[66,2,"かいほう"],[84,1,"かれ"],[86,2,"かいほう"],[97,1,"つか"],[127,2,"せんぞ"],[136,1,"き"],[138,1,"したが"],[146,1,"みみ"],[148,1,"かたむ"]],"text":"『あなたがたの兄弟であるヘブルびとで、あなたがたに身を売り、六年の間あなたがたに仕えた者は、六年の終りに、あなたがたおのおのがこれを解放しなければならない。あなたがたは彼を解放して、あなたがたに仕えることをやめさせなければならない』。ところがあなたがたの先祖たちはわたしに聞き従わず、またその耳を傾けなかった。"},{"ref":"Jer.34.15","start":24034015,"end":24034015,"break":"none","ruby":[[9,2,"こんにち"],[12,1,"こころ"],[14,1,"あらた"],[23,1,"とな"],[25,1,"びと"],[27,2,"しゃくほう"],[33,1,"つ"],[35,1,"しめ"],[43,1,"み"],[45,1,"ただ"],[54,1,"おこな"],[63,1,"な"],[74,1,"いえ"],[81,1,"まえ"],[83,2,"けいやく"],[86,1,"た"]],"text":"しかしあなたがたは今日、心を改め、おのおのその隣り人に釈放のことを告げ示して、わたしの見て正しいとすることを行い、かつわたしの名をもってとなえられる家で、わたしの前に契約を立てた。"},{"ref":"Jer.34.16","start":24034016,"end":24034016,"break":"none","ruby":[[10,1,"ふたた"],[12,1,"こころ"],[14,1,"ひるがえ"],[22,1,"な"],[24,1,"けが"],[31,2,"だんじょ"],[34,2,"どれい"],[39,1,"ねが"],[45,2,"かいほう"],[58,1,"ふたた"],[63,1,"したが"],[74,2,"どれい"]],"text":"ところがあなたがたは再び心を翻して、わたしの名を汚し、おのおの男女の奴隷をその願いのままに解放したのをひきかえさせ、再びこれを従わせて、あなたがたの奴隷とした。"},{"ref":"Jer.34.17","start":24034017,"end":24034017,"break":"none","ruby":[[6,1,"しゅ"],[10,1,"おお"],[26,1,"き"],[28,1,"したが"],[38,2,"きょうだい"],[43,1,"となり"],[45,2,"しゃくほう"],[51,1,"つ"],[53,1,"しめ"],[62,1,"み"],[78,2,"しゃくほう"],[81,1,"つ"],[83,1,"しめ"],[98,2,"えきびょう"],[107,1,"わた"],[110,1,"しゅ"],[112,1,"い"],[127,1,"ち"],[134,1,"くに"],[136,1,"い"]],"text":"それゆえに、主はこう仰せられる、あなたがたがわたしに聞き従わず、おのおのその兄弟とその隣に釈放のことを告げ示さなかったので、見よ、わたしはあなたがたのために釈放を告げ示して、あなたがたをつるぎと、疫病と、ききんとに渡すと主は言われる。わたしはあなたがたを地のもろもろの国に忌みきらわれるものとする。"},{"ref":"Jer.34.18","start":24034018,"end":24034018,"break":"none","ruby":[[4,2,"けいやく"],[7,1,"やぶ"],[14,1,"まえ"],[16,1,"た"],[19,2,"けいやく"],[22,1,"さだ"],[25,1,"したが"],[29,2,"ひとびと"],[37,1,"かれ"],[43,1,"さ"],[52,1,"あいだ"],[54,1,"とお"],[57,1,"こ"],[58,1,"うし"]],"text":"わたしの契約を破り、わたしの前に立てた契約の定めに従わない人々を、わたしは彼らが二つに裂いて、その二つの間を通った子牛のようにする。――"},{"ref":"Jer.34.19","start":24034019,"end":24034019,"break":"none","ruby":[[7,1,"わ"],[10,1,"こ"],[11,1,"うし"],[13,1,"あいだ"],[15,1,"とお"],[39,2,"かんがん"],[42,2,"さいし"],[48,1,"ち"],[54,1,"たみ"]],"text":"すなわち二つに分けた子牛の間を通ったユダのつかさたち、エルサレムのつかさたちと宦官と祭司と、この地のすべての民を、"},{"ref":"Jer.34.20","start":24034020,"end":24034020,"break":"none","ruby":[[6,1,"てき"],[8,1,"て"],[13,1,"いのち"],[15,1,"もと"],[18,1,"もの"],[20,1,"て"],[22,1,"わた"],[27,2,"したい"],[30,1,"そら"],[32,1,"とり"],[34,1,"の"],[36,1,"けもの"],[38,2,"しょくもつ"]],"text":"わたしはその敵の手と、その命を求める者の手に渡す。その死体は空の鳥と野の獣の食物となる。"},{"ref":"Jer.34.21","start":24034021,"end":24034021,"break":"none","ruby":[[9,1,"おう"],[26,1,"てき"],[28,1,"て"],[32,1,"いのち"],[34,1,"もと"],[37,1,"もの"],[39,1,"て"],[47,1,"はな"],[50,1,"さ"],[58,1,"おう"],[60,2,"ぐんぜい"],[63,1,"て"],[65,1,"わた"]],"text":"わたしはまたユダの王ゼデキヤと、そのつかさたちをその敵の手、その命を求める者の手、あなたがたを離れて去ったバビロンの王の軍勢の手に渡す。"},{"ref":"Jer.34.22","start":24034022,"end":24034022,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"み"],[14,1,"かれ"],[17,1,"めい"],[23,1,"まち"],[25,1,"ひ"],[36,1,"かれ"],[41,1,"まち"],[43,1,"せ"],[46,1,"たたか"],[52,1,"と"],[55,1,"ひ"],[57,1,"はな"],[60,1,"や"],[62,1,"はら"],[72,2,"まちまち"],[75,1,"す"],[77,1,"ひと"],[81,1,"あ"],[83,1,"ち"]],"text":"主は言われる、見よ、わたしは彼らに命じて、この町に引きかえしてこさせる。彼らはこの町を攻めて戦い、これを取り、火を放って焼き払う。わたしはユダの町々を住む人のない荒れ地とする」。"}]