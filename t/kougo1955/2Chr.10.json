[{"ref":"2Chr.10.1","start":14010001,"end":14010001,"break":"paragraph","ruby":[[10,1,"い"],[26,1,"かれ"],[28,1,"おう"],[38,1,"い"]],"text":"レハベアムはシケムへ行った。すべてのイスラエルびとが彼を王にしようとシケムへ行ったからである。"},{"ref":"2Chr.10.2","start":14010002,"end":14010002,"break":"none","ruby":[[4,1,"こ"],[17,1,"さ"],[36,1,"き"],[45,1,"かえ"]],"text":"ネバテの子ヤラベアムは、ソロモンを避けてエジプトにのがれていたが、これを聞いてエジプトから帰ったので、"},{"ref":"2Chr.10.3","start":14010003,"end":14010003,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"ひと"],[10,1,"かれ"],[12,1,"まね"],[35,1,"き"],[44,1,"い"]],"text":"人々は人をつかわして彼を招いた。そこでヤラベアムとすべてのイスラエルは来て、レハベアムに言った、"},{"ref":"2Chr.10.4","start":14010004,"end":14010004,"break":"none","ruby":[[5,1,"ちち"],[17,1,"おも"],[25,1,"いま"],[30,1,"ちち"],[36,2,"しえき"],[44,1,"ちち"],[52,1,"お"],[56,1,"おも"],[62,1,"かる"],[86,1,"つか"]],"text":"「あなたの父は、われわれのくびきを重くしましたが、今あなたの父のきびしい使役と、あなたの父が、われわれに負わせた重いくびきを軽くしてください。そうすればわたしたちはあなたに仕えましょう」。"},{"ref":"2Chr.10.5","start":14010005,"end":14010005,"break":"none","ruby":[[6,1,"かれ"],[9,1,"こた"],[15,1,"か"],[17,1,"のち"],[25,1,"ところ"],[27,1,"き"],[36,1,"たみ"],[38,1,"さ"]],"text":"レハベアムは彼らに答えた、「三日の後、またわたしの所に来なさい」。それで民は去った。"},{"ref":"2Chr.10.6","start":14010006,"end":14010006,"break":"paragraph","ruby":[[5,1,"おう"],[7,1,"ちち"],[13,2,"ぞんめい"],[15,1,"ちゅう"],[21,1,"つか"],[24,2,"ちょうろう"],[29,2,"そうだん"],[33,1,"い"],[46,1,"たみ"],[50,2,"へんとう"],[58,1,"おも"]],"text":"レハベアム王は父ソロモンの存命中ソロモンに仕えた長老たちに相談して言った、「あなたがたはこの民にどう返答すればよいと思いますか」。"},{"ref":"2Chr.10.7","start":14010007,"end":14010007,"break":"none","ruby":[[0,1,"かれ"],[9,1,"い"],[22,1,"たみ"],[24,2,"しんせつ"],[32,1,"かれ"],[35,1,"よろこ"],[44,1,"かた"],[51,1,"かれ"],[54,1,"なが"]],"text":"彼らはレハベアムに言った、「あなたがもしこの民を親切にあつかい、彼らを喜ばせ、ねんごろに語られるならば彼らは長くあなたのしもべとなるでしょう」。"},{"ref":"2Chr.10.8","start":14010008,"end":14010008,"break":"none","ruby":[[3,1,"かれ"],[5,2,"ちょうろう"],[10,1,"あた"],[13,1,"すす"],[20,2,"じぶん"],[23,2,"いっしょ"],[26,1,"おお"],[32,2,"じぶん"],[35,1,"つか"],[40,2,"わかもの"],[45,2,"そうだん"]],"text":"しかし彼は長老たちが与えた勧めをすてて、自分と一緒に大きくなって自分に仕えている若者たちに相談して、"},{"ref":"2Chr.10.9","start":14010009,"end":14010009,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[17,1,"たみ"],[23,1,"む"],[33,2,"ちちうえ"],[42,1,"お"],[50,1,"かる"],[60,1,"い"],[73,2,"へんとう"],[81,1,"おも"]],"text":"彼らに言った、「あなたがたは、この民がわたしに向かって、『あなたの父上が、われわれに負わせたくびきを軽くしてください』と言うのに、われわれはなんと返答すればよいと思いますか」。"},{"ref":"2Chr.10.10","start":14010010,"end":14010010,"break":"none","ruby":[[0,1,"かれ"],[2,2,"いっしょ"],[5,1,"おお"],[11,2,"わかもの"],[16,1,"かれ"],[18,1,"い"],[27,1,"む"],[37,1,"ちち"],[49,1,"おも"],[71,1,"かる"],[81,1,"い"],[86,1,"たみ"],[91,1,"い"],[102,2,"こゆび"],[105,1,"ちち"],[107,1,"こし"],[111,1,"ふと"]],"text":"彼と一緒に大きくなった若者たちは彼に言った、「あなたに向かって、『あなたの父は、われわれのくびきを重くしたが、あなたは、それをわれわれのために軽くしてください』と言ったこの民に、こう言いなさい、『わたしの小指は父の腰よりも太い、"},{"ref":"2Chr.10.11","start":14010011,"end":14010011,"break":"none","ruby":[[0,1,"ちち"],[8,1,"おも"],[14,1,"お"],[38,1,"おも"],[44,1,"ちち"],[55,1,"こ"],[75,1,"こ"]],"text":"父はあなたがたに重いくびきを負わせたが、わたしはさらに、あなたがたのくびきを重くしよう。父はむちであなたがたを懲らしたが、わたしはさそりであなたがたを懲らそう』」。"},{"ref":"2Chr.10.12","start":14010012,"end":14010012,"break":"paragraph","ruby":[[8,1,"たみ"],[10,1,"みな"],[12,1,"おう"],[16,1,"か"],[17,1,"め"],[27,1,"き"],[33,1,"い"],[42,1,"か"],[43,1,"め"],[55,1,"い"]],"text":"さてヤラベアムと民は皆、王が「三日目にわたしのところに来なさい」と言ったとおりに、三日目にレハベアムのところへ行った。"},{"ref":"2Chr.10.13","start":14010013,"end":14010013,"break":"none","ruby":[[0,1,"おう"],[2,2,"あらあら"],[6,1,"かれ"],[9,1,"こた"],[22,1,"おう"],[24,2,"ちょうろう"],[29,1,"すす"]],"text":"王は荒々しく彼らに答えた。すなわちレハベアム王は長老たちの勧めをすて、"},{"ref":"2Chr.10.14","start":14010014,"end":14010014,"break":"none","ruby":[[0,2,"わかもの"],[5,1,"すす"],[8,1,"したが"],[11,1,"かれ"],[14,1,"つ"],[17,1,"い"],[22,1,"ちち"],[34,1,"おも"],[44,1,"さら"],[49,1,"おも"],[55,1,"ちち"],[66,1,"こ"],[86,1,"こ"]],"text":"若者たちの勧めに従い、彼らに告げて言った、「父はあなたがたのくびきを重くしたが、わたしは更にこれを重くしよう。父はむちであなたがたを懲らしたが、わたしはさそりであなたがたを懲らそう」。"},{"ref":"2Chr.10.15","start":14010015,"end":14010015,"break":"none","ruby":[[5,1,"おう"],[7,1,"たみ"],[9,1,"い"],[14,1,"き"],[26,1,"しゅ"],[48,1,"こ"],[55,1,"い"],[59,2,"ことば"],[62,2,"じょうじゅ"],[70,1,"かみ"]],"text":"このように王は民の言うことを聞きいれなかった。これは主が、かつてシロびとアヒヤによって、ネバテの子ヤラベアムに言われた言葉を成就するために、神がなされたのであった。"},{"ref":"2Chr.10.16","start":14010016,"end":14010016,"break":"paragraph","breaks":[[47,"stanza"],[69,"line"],[90,"line"],[108,"line"]],"ruby":[[6,2,"ひとびと"],[9,1,"みな"],[11,1,"おう"],[13,2,"じぶん"],[18,1,"い"],[23,1,"き"],[31,1,"み"],[36,1,"たみ"],[38,1,"おう"],[40,1,"こた"],[43,1,"い"],[60,1,"なに"],[62,1,"ぶん"],[79,1,"こ"],[84,1,"し"],[85,1,"ぎょう"],[102,2,"てんまく"],[105,1,"かえ"],[113,1,"いま"],[118,1,"いえ"],[120,1,"み"],[133,1,"みな"],[134,1,"かれ"],[137,2,"てんまく"],[140,1,"さ"],[143,1,"い"]],"text":"イスラエルの人々は皆、王が自分たちの言うことを聞きいれないのを見たので、民は王に答えて言った、「われわれはダビデのうちに何の分があろうか。われわれはエッサイの子のうちに嗣業がない。イスラエルよ、めいめいの天幕に帰れ。ダビデよ、今あなたの家を見よ」。そしてイスラエルは皆彼らの天幕へ去って行った。"},{"ref":"2Chr.10.17","start":14010017,"end":14010017,"break":"none","ruby":[[12,2,"まちまち"],[15,1,"す"],[26,2,"ひとびと"],[29,1,"おさ"]],"text":"しかしレハベアムはユダの町々に住んでいるイスラエルの人々を治めた。"},{"ref":"2Chr.10.18","start":14010018,"end":14010018,"break":"none","ruby":[[5,1,"おう"],[7,2,"ちょうぼ"],[9,1,"にん"],[11,2,"かんとく"],[35,2,"ひとびと"],[38,1,"いし"],[40,1,"かれ"],[42,1,"う"],[44,1,"ころ"],[55,1,"おう"],[57,1,"いそ"],[60,1,"くるま"],[62,1,"の"],[71,1,"に"]],"text":"レハベアム王は徴募人の監督であったアドラムをつかわしたが、イスラエルの人々が石で彼を撃ち殺したので、レハベアム王は急いで車に乗り、エルサレムに逃げた。"},{"ref":"2Chr.10.19","start":14010019,"end":14010019,"break":"none","ruby":[[14,1,"いえ"],[20,2,"こんにち"],[23,1,"いた"]],"text":"こうしてイスラエルはダビデの家にそむいて今日に至った。"}]