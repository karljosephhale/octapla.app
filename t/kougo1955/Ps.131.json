[{"ref":"Ps.131.1","start":19131001,"end":19131001,"break":"paragraph","title":"ダビデがよんだ都もうでの歌","breaks":[[21,"line"],[39,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"こころ"],[14,1,"め"],[16,1,"たか"],[27,1,"ちから"],[29,1,"およ"],[33,1,"おお"],[37,1,"こと"],[47,2,"かんけい"]],"titleRuby":[[7,1,"みやこ"],[12,1,"うた"]],"text":"主よ、わが心はおごらず、わが目は高ぶらず、わたしはわが力の及ばない大いなる事とくすしきわざとに関係いたしません。"},{"ref":"Ps.131.2","start":19131002,"end":19131002,"break":"line","breaks":[[16,"line"],[35,"line"],[57,"line"]],"ruby":[[5,2,"ちばな"],[18,1,"はは"],[25,1,"やす"],[41,1,"たましい"],[43,1,"しず"],[48,1,"やす"],[59,1,"たましい"],[61,2,"ちばな"],[75,1,"やす"]],"text":"かえって、乳離れしたみどりごが、その母のふところに安らかにあるように、わたしはわが魂を静め、かつ安らかにしました。わが魂は乳離れしたみどりごのように、安らかです。"},{"ref":"Ps.131.3","start":19131003,"end":19131003,"break":"line","breaks":[[15,"line"]],"ruby":[[7,1,"いま"],[15,1,"しゅ"],[20,1,"のぞ"]],"text":"イスラエルよ、今からとこしえに主によって望みをいだけ。"}]