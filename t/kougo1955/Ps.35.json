[{"ref":"Ps.35.1","start":19035001,"end":19035001,"break":"paragraph","title":"ダビデの歌","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"あらそ"],[9,1,"もの"],[20,1,"たたか"],[22,1,"もの"],[24,1,"たたか"]],"titleRuby":[[4,1,"うた"]],"text":"主よ、わたしと争う者とあらそい、わたしと戦う者と戦ってください。"},{"ref":"Ps.35.2","start":19035002,"end":19035002,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"たて"],[2,2,"おおだて"],[6,1,"と"],[14,1,"たす"],[20,1,"た"]],"text":"盾と大盾とを執って、わたしを助けるために立ちあがってください。"},{"ref":"Ps.35.3","start":19035003,"end":19035003,"break":"line","breaks":[[13,"line"],[29,"line"],[45,"line"]],"ruby":[[3,1,"な"],[9,1,"ぬ"],[17,1,"お"],[19,1,"せま"],[21,1,"もの"],[23,1,"た"],[38,1,"すくい"],[49,1,"い"]],"text":"やりと投げやりとを抜いて、わたしに追い迫る者に立ちむかい、「わたしはおまえの救である」と、わたしに言ってください。"},{"ref":"Ps.35.4","start":19035004,"end":19035004,"break":"line","breaks":[[15,"line"],[26,"line"],[45,"line"]],"ruby":[[8,1,"いのち"],[10,1,"もと"],[13,1,"もの"],[34,1,"あく"],[40,1,"もの"],[42,1,"しりぞ"]],"text":"どうか、わたしの命を求める者をはずかしめ、いやしめ、わたしにむかって悪をたくらむ者を退け、あわてふためかせてください。"},{"ref":"Ps.35.5","start":19035005,"end":19035005,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かぜ"],[5,1,"まえ"],[17,1,"しゅ"],[19,1,"つかい"],[21,1,"かれ"],[24,1,"お"]],"text":"彼らを風の前のもみがらのようにし、主の使に彼らを追いやらせてください。"},{"ref":"Ps.35.6","start":19035006,"end":19035006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"みち"],[5,1,"くら"],[15,1,"しゅ"],[17,1,"つかい"],[19,1,"かれ"],[22,1,"お"],[24,1,"い"]],"text":"彼らの道を暗く、なめらかにし、主の使に彼らを追い行かせてください。"},{"ref":"Ps.35.7","start":19035007,"end":19035007,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[14,1,"あみ"],[16,1,"かく"],[30,1,"あな"],[32,1,"ほ"]],"text":"彼らはゆえなくわたしのために網を隠し、ゆえなくわたしのために穴を掘ったからです。"},{"ref":"Ps.35.8","start":19035008,"end":19035008,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[0,2,"ふい"],[3,1,"ほろ"],[6,1,"かれ"],[9,1,"のぞ"],[17,1,"かく"],[20,1,"あみ"],[28,1,"かれ"],[31,1,"ほろ"],[34,1,"おちい"]],"text":"不意に滅びを彼らに臨ませ、みずから隠した網にとらえられ、彼らを滅びに陥らせてください。"},{"ref":"Ps.35.9","start":19035009,"end":19035009,"break":"line","breaks":[[16,"line"]],"ruby":[[6,1,"たましい"],[8,1,"しゅ"],[13,1,"よろこ"],[18,1,"すくい"],[23,1,"たの"]],"text":"そのときわが魂は主によって喜び、その救をもって楽しむでしょう。"},{"ref":"Ps.35.10","start":19035010,"end":19035010,"break":"line","breaks":[[18,"line"],[43,"line"],[61,"line"],[71,"line"]],"ruby":[[4,1,"ほね"],[11,1,"い"],[19,1,"しゅ"],[34,1,"もの"],[47,1,"よわ"],[49,1,"もの"],[51,1,"つよ"],[53,1,"もの"],[56,1,"たす"],[58,1,"だ"],[61,1,"よわ"],[63,1,"もの"],[65,1,"まず"],[68,1,"もの"],[74,1,"うば"],[76,1,"もの"],[79,1,"たす"],[81,1,"だ"],[85,1,"かた"]],"text":"わたしの骨はことごとく言うでしょう、「主よ、だれかあなたにたぐうべき者がありましょう。あなたは弱い者を強い者から助け出し、弱い者と貧しい者を、かすめ奪う者から助け出される方です」と。"},{"ref":"Ps.35.11","start":19035011,"end":19035011,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"あくい"],[5,2,"しょうにん"],[8,1,"おこ"],[16,1,"し"],[20,1,"こと"],[26,1,"たず"]],"text":"悪意のある証人が起って、わたしの知らない事をわたしに尋ねる。"},{"ref":"Ps.35.12","start":19035012,"end":19035012,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"あく"],[12,1,"ぜん"],[14,1,"むく"],[19,1,"たましい"],[21,1,"よ"],[26,1,"もの"]],"text":"彼らは悪をもってわたしの善に報い、わが魂を寄るべなき者とした。"},{"ref":"Ps.35.13","start":19035013,"end":19035013,"break":"line","breaks":[[17,"line"],[37,"line"]],"ruby":[[8,1,"かれ"],[11,1,"や"],[17,2,"あらぬの"],[24,2,"だんじき"],[30,1,"み"],[32,1,"くる"],[41,1,"むね"],[50,1,"いの"]],"text":"しかし、わたしは彼らが病んだとき、荒布をまとい、断食してわが身を苦しめた。わたしは胸にこうべをたれて祈った、"},{"ref":"Ps.35.14","start":19035014,"end":19035014,"break":"line","breaks":[[17,"line"],[27,"line"],[41,"line"]],"ruby":[[7,1,"とも"],[11,2,"きょうだい"],[17,1,"かな"],[31,1,"はは"],[36,1,"もの"],[41,1,"かな"],[49,1,"ある"]],"text":"ちょうど、わが友、わが兄弟のために悲しんだかのように。わたしは母をいたむ者のように悲しみうなだれて歩きまわった。"},{"ref":"Ps.35.15","start":19035015,"end":19035015,"break":"line","breaks":[[23,"line"],[38,"line"],[51,"line"]],"ruby":[[3,1,"かれ"],[17,1,"よろこ"],[26,1,"あつ"],[34,1,"せ"],[42,1,"し"],[46,2,"たこく"],[49,1,"もの"]],"text":"しかし彼らはわたしのつまずくとき、喜びつどい、ともに集まってわたしを責めた。わたしの知らない他国の者はわたしをののしってやめなかった。"},{"ref":"Ps.35.16","start":19035016,"end":19035016,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[11,2,"ことば"],[30,1,"は"]],"text":"彼らはますます、けがす言葉をもってあざけり、わたしにむかって歯をかみならした。"},{"ref":"Ps.35.17","start":19035017,"end":19035017,"break":"line","breaks":[[22,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[26,1,"かれ"],[29,2,"はかい"],[42,1,"わか"],[48,1,"すく"],[50,1,"だ"]],"text":"主よ、いつまであなたはながめておられますか、わたしを彼らの破壊から、わたしのいのちを若きししから救い出してください。"},{"ref":"Ps.35.18","start":19035018,"end":19035018,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"おお"],[12,1,"なか"],[19,2,"かんしゃ"],[23,1,"おお"],[26,1,"たみ"],[28,1,"なか"]],"text":"わたしは大いなるつどいの中で、あなたに感謝し、多くの民の中で、あなたをほめたたえるでしょう。"},{"ref":"Ps.35.19","start":19035019,"end":19035019,"break":"line","breaks":[[16,"line"],[38,"line"],[53,"line"]],"ruby":[[0,1,"いつわ"],[7,1,"てき"],[12,1,"もの"],[23,1,"よろこ"],[28,1,"ゆる"],[47,1,"にく"],[49,1,"もの"],[57,1,"め"],[66,1,"ゆる"]],"text":"偽ってわたしの敵となった者どものわたしについて喜ぶことを許さないでください。ゆえなく、わたしを憎む者どものたがいに目くばせすることを許さないでください。"},{"ref":"Ps.35.20","start":19035020,"end":19035020,"break":"line","breaks":[[10,"line"],[27,"line"]],"ruby":[[0,1,"かれ"],[3,2,"へいわ"],[6,1,"かた"],[10,1,"くに"],[15,1,"おだ"],[19,1,"す"],[21,1,"もの"],[27,1,"あざむ"],[30,2,"ことば"]],"text":"彼らは平和を語らず、国のうちに穏やかに住む者にむかって欺きの言葉をたくらむからです。"},{"ref":"Ps.35.21","start":19035021,"end":19035021,"break":"line","breaks":[[19,"line"],[41,"line"]],"ruby":[[0,1,"かれ"],[11,1,"くち"],[32,1,"め"],[37,1,"み"],[41,1,"い"]],"text":"彼らはわたしにむかって口をあけひろげ、「あはぁ、あはぁ、われらの目はそれを見た」と言います。"},{"ref":"Ps.35.22","start":19035022,"end":19035022,"break":"line","breaks":[[17,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[10,1,"み"],[28,1,"しゅ"],[35,1,"とお"]],"text":"主よ、あなたはこれを見られました。もださないでください。主よ、わたしに遠ざからないでください。"},{"ref":"Ps.35.23","start":19035023,"end":19035023,"break":"line","breaks":[[9,"line"],[31,"line"]],"ruby":[[2,1,"かみ"],[6,1,"しゅ"],[20,1,"うった"],[26,1,"ふる"],[31,1,"め"]],"text":"わが神、わが主よ、わがさばきのため、わが訴えのために奮いたち、目をさましてください。"},{"ref":"Ps.35.24","start":19035024,"end":19035024,"break":"line","breaks":[[7,"line"],[26,"line"]],"ruby":[[2,1,"かみ"],[4,1,"しゅ"],[11,1,"ぎ"],[30,1,"こと"],[35,1,"かれ"],[38,1,"よろこ"]],"text":"わが神、主よ、あなたの義にしたがってわたしをさばき、わたしの事について彼らを喜ばせないでください。"},{"ref":"Ps.35.25","start":19035025,"end":19035025,"break":"line","breaks":[[11,"line"],[33,"line"],[44,"line"],[65,"line"]],"ruby":[[0,1,"かれ"],[5,1,"こころ"],[20,1,"ねが"],[26,1,"たっ"],[33,1,"い"],[46,1,"かれ"],[54,1,"かれ"],[56,1,"ほろ"],[65,1,"い"]],"text":"彼らにその心のうちで、「あはぁ、われらの願ったことが達せられた」と言わせないでください。また彼らに「われらは彼を滅ぼしつくした」と言わせないでください。"},{"ref":"Ps.35.26","start":19035026,"end":19035026,"break":"line","breaks":[[12,"line"],[32,"line"],[50,"line"]],"ruby":[[4,1,"わざわい"],[6,1,"よろこ"],[8,1,"もの"],[15,1,"は"],[40,1,"ほこ"],[46,1,"もの"],[50,1,"はじ"],[60,1,"き"]],"text":"わたしの災を喜ぶ者どもをともに恥じ、あわてふためかせてください。わたしにむかって誇りたかぶる者どもに恥と、はずかしめとを着せてください。"},{"ref":"Ps.35.27","start":19035027,"end":19035027,"break":"line","breaks":[[11,"line"],[23,"line"],[47,"line"]],"ruby":[[4,1,"ぎ"],[6,1,"よろこ"],[8,1,"もの"],[11,1,"よろこ"],[14,1,"こえ"],[19,1,"よろこ"],[30,2,"こうふく"],[33,1,"よろこ"],[37,1,"しゅ"],[39,1,"おお"],[50,1,"い"]],"text":"わたしの義を喜ぶ者をば喜びの声をあげて喜ばせ、「そのしもべの幸福を喜ばれる主は大いなるかな」とつねに言わせてください。"},{"ref":"Ps.35.28","start":19035028,"end":19035028,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"した"],[14,1,"ぎ"],[21,1,"ほまれ"],[24,1,"かた"]],"text":"わたしの舌はひねもすあなたの義と、あなたの誉とを語るでしょう。"}]