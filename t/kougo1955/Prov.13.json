[{"ref":"Prov.13.1","start":20013001,"end":20013001,"break":"paragraph","breaks":[[14,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"こ"],[6,1,"ちち"],[8,2,"きょうくん"],[18,1,"もの"],[21,1,"こら"]],"text":"知恵ある子は父の教訓をきく、あざける者は、懲しめをきかない。"},{"ref":"Prov.13.2","start":20013002,"end":20013002,"break":"line","breaks":[[21,"line"]],"ruby":[[0,2,"ぜんりょう"],[3,1,"ひと"],[7,1,"くち"],[9,1,"み"],[15,2,"こうふく"],[18,1,"え"],[21,3,"ふしんじつ"],[25,1,"もの"],[27,1,"ねが"],[31,2,"ぼうぎゃく"]],"text":"善良な人はその口の実によって、幸福を得る、不信実な者の願いは、暴虐である。"},{"ref":"Prov.13.3","start":20013003,"end":20013003,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"くち"],[2,1,"まも"],[4,1,"もの"],[8,1,"いのち"],[10,1,"まも"],[18,1,"おお"],[21,1,"ひら"],[23,1,"もの"],[26,1,"ほろ"],[29,1,"く"]],"text":"口を守る者はその命を守る、くちびるを大きく開く者には滅びが来る。"},{"ref":"Prov.13.4","start":20013004,"end":20013004,"break":"line","breaks":[[21,"line"]],"ruby":[[3,1,"もの"],[5,1,"こころ"],[8,1,"ねが"],[10,1,"もと"],[15,1,"なに"],[17,1,"え"],[24,1,"つと"],[26,1,"はたら"],[28,1,"もの"],[30,1,"こころ"],[32,1,"ゆた"],[35,1,"み"]],"text":"なまけ者の心は、願い求めても、何も得ない、しかし勤め働く者の心は豊かに満たされる。"},{"ref":"Prov.13.5","start":20013005,"end":20013005,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"いつわ"],[8,1,"にく"],[14,1,"あ"],[17,1,"ひと"],[19,1,"は"],[24,1,"い"]],"text":"正しい人は偽りを憎む、しかし悪しき人は恥ずべく、忌まわしくふるまう。"},{"ref":"Prov.13.6","start":20013006,"end":20013006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"せいぎ"],[3,1,"みち"],[9,1,"あゆ"],[11,1,"もの"],[13,1,"まも"],[16,1,"つみ"],[18,1,"あ"],[21,1,"もの"],[23,1,"たお"]],"text":"正義は道をまっすぐ歩む者を守り、罪は悪しき者を倒す。"},{"ref":"Prov.13.7","start":20013007,"end":20013007,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"と"],[6,1,"いつわ"],[10,1,"なに"],[12,1,"も"],[16,1,"もの"],[21,1,"まず"],[25,1,"いつわ"],[29,1,"おお"],[32,1,"とみ"],[34,1,"も"],[36,1,"もの"]],"text":"富んでいると偽って、何も持たない者がいる、貧しいと偽って、多くの富を持つ者がいる。"},{"ref":"Prov.13.8","start":20013008,"end":20013008,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ひと"],[2,1,"とみ"],[6,1,"いのち"],[16,1,"まず"],[19,1,"もの"],[28,1,"とみ"]],"text":"人の富はその命をあがなう、しかし貧しい者にはあがなうべき富がない。"},{"ref":"Prov.13.9","start":20013009,"end":20013009,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"ひかり"],[7,1,"かがや"],[10,1,"あ"],[13,1,"もの"],[20,1,"け"]],"text":"正しい者の光は輝き、悪しき者のともしびは消される。"},{"ref":"Prov.13.10","start":20013010,"end":20013010,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"たか"],[6,1,"あらそ"],[9,1,"しょう"],[13,2,"かんこく"],[18,1,"もの"],[20,2,"ちえ"]],"text":"高ぶりはただ争いを生じる、勧告をきく者は知恵がある。"},{"ref":"Prov.13.11","start":20013011,"end":20013011,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"いそ"],[3,1,"え"],[5,1,"とみ"],[7,1,"へ"],[10,1,"すこ"],[19,1,"もの"],[24,1,"ま"]],"text":"急いで得た富は減る、少しずつたくわえる者はそれを増すことができる。"},{"ref":"Prov.13.12","start":20013012,"end":20013012,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"のぞ"],[3,1,"え"],[8,1,"なが"],[15,1,"こころ"],[17,1,"なや"],[21,1,"ねが"],[31,1,"いのち"],[33,1,"き"],[35,1,"え"]],"text":"望みを得ることが長びくときは、心を悩ます、願いがかなうときは、命の木を得たようだ。"},{"ref":"Prov.13.13","start":20013013,"end":20013013,"break":"line","breaks":[[15,"line"]],"ruby":[[1,2,"ことば"],[4,1,"かろ"],[8,1,"もの"],[10,1,"ほろ"],[15,1,"いまし"],[18,1,"おも"],[22,1,"もの"],[24,1,"むく"],[27,1,"え"]],"text":"み言葉を軽んじる者は滅ぼされ、戒めを重んじる者は報いを得る。"},{"ref":"Prov.13.14","start":20013014,"end":20013014,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"ひと"],[6,1,"おしえ"],[8,1,"いのち"],[10,1,"いずみ"],[21,1,"し"]],"text":"知恵ある人の教は命の泉である、これによって死のわなをのがれることができる。"},{"ref":"Prov.13.15","start":20013015,"end":20013015,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"ぜんりょう"],[3,1,"かしこ"],[5,1,"もの"],[7,1,"めぐ"],[10,1,"え"],[17,3,"ふしんじつ"],[21,1,"もの"],[23,1,"みち"],[25,1,"ほろ"]],"text":"善良な賢い者は恵みを得る、しかし、不信実な者の道は滅びである。"},{"ref":"Prov.13.16","start":20013016,"end":20013016,"break":"line","breaks":[[23,"line"]],"ruby":[[8,1,"もの"],[10,2,"ちしき"],[16,1,"こと"],[23,1,"おろ"],[26,1,"もの"],[28,2,"じぶん"],[31,1,"ぐ"],[33,1,"み"]],"text":"おおよそ、さとき者は知識によって事をおこない、愚かな者は自分の愚を見せびらかす。"},{"ref":"Prov.13.17","start":20013017,"end":20013017,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あ"],[3,2,"ししゃ"],[6,1,"ひと"],[8,1,"わざわい"],[20,2,"ちゅうじつ"],[23,2,"ししゃ"],[26,1,"ひと"],[28,1,"すく"]],"text":"悪しき使者は人を災におとしいれる、しかし忠実な使者は人を救う。"},{"ref":"Prov.13.18","start":20013018,"end":20013018,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"びんぼう"],[11,2,"きょうくん"],[14,1,"す"],[17,1,"もの"],[19,1,"く"],[25,1,"いまし"],[28,1,"まも"],[30,1,"もの"],[32,1,"たっと"]],"text":"貧乏と、はずかしめとは教訓を捨てる者に来る、しかし戒めを守る者は尊ばれる。"},{"ref":"Prov.13.19","start":20013019,"end":20013019,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ねが"],[8,1,"こころ"],[10,1,"たの"],[14,1,"おろ"],[17,1,"もの"],[19,1,"あく"],[21,1,"す"]],"text":"願いがかなえば、心は楽しい、愚かな者は悪を捨てることをきらう。"},{"ref":"Prov.13.20","start":20013020,"end":20013020,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[9,1,"あゆ"],[11,1,"もの"],[13,2,"ちえ"],[16,1,"え"],[19,1,"おろ"],[22,1,"もの"],[24,1,"とも"],[28,1,"もの"],[30,1,"がい"]],"text":"知恵ある者とともに歩む者は知恵を得る。愚かな者の友となる者は害をうける。"},{"ref":"Prov.13.21","start":20013021,"end":20013021,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"わざわい"],[2,1,"つみ"],[6,1,"お"],[9,1,"ただ"],[12,1,"もの"],[14,1,"よ"],[16,1,"むく"],[19,1,"う"]],"text":"災は罪びとを追い、正しい者は良い報いを受ける。"},{"ref":"Prov.13.22","start":20013022,"end":20013022,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ぜんりょう"],[3,1,"ひと"],[7,1,"し"],[8,1,"ぎょう"],[10,2,"しそん"],[20,1,"つみ"],[24,1,"とみ"],[26,1,"ただ"],[29,1,"ひと"]],"text":"善良な人はその嗣業を子孫にのこす、しかし罪びとの富は正しい人のためにたくわえられる。"},{"ref":"Prov.13.23","start":20013023,"end":20013023,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"まず"],[3,1,"ひと"],[5,2,"しんでん"],[8,1,"おお"],[11,2,"しょくりょう"],[14,1,"さん"],[21,2,"ふせい"],[27,1,"お"],[29,1,"なが"]],"text":"貧しい人の新田は多くの食糧を産する、しかし不正によれば押し流される。"},{"ref":"Prov.13.24","start":20013024,"end":20013024,"break":"line","breaks":[[20,"line"]],"ruby":[[3,1,"くわ"],[7,1,"もの"],[11,1,"こ"],[13,1,"にく"],[20,1,"こ"],[22,1,"あい"],[25,1,"もの"],[35,1,"こ"]],"text":"むちを加えない者はその子を憎むのである、子を愛する者は、つとめてこれを懲らしめる。"},{"ref":"Prov.13.25","start":20013025,"end":20013025,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"た"],[10,2,"しょくよく"],[13,1,"み"],[20,1,"あ"],[23,1,"もの"],[25,1,"はら"],[27,1,"み"]],"text":"正しい者は食べてその食欲を満たす、しかし悪しき者の腹は満たされない。"}]