[{"ref":"Job.24.1","start":18024001,"end":18024001,"break":"paragraph","breaks":[[15,"line"],[26,"line"]],"ruby":[[5,3,"ぜんのうしゃ"],[13,1,"とき"],[15,1,"さだ"],[31,1,"かれ"],[33,1,"し"],[35,1,"もの"],[39,1,"ひ"],[41,1,"み"]],"text":"なにゆえ、全能者はさばきの時を定めておかれないのか。なにゆえ、彼を知る者がその日を見ないのか。"},{"ref":"Job.24.2","start":18024002,"end":18024002,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"よ"],[3,2,"じざかい"],[6,1,"うつ"],[8,1,"もの"],[10,1,"む"],[13,1,"うば"],[19,1,"か"],[21,1,"もの"]],"text":"世には地境を移す者、群れを奪ってそれを飼う者、"},{"ref":"Job.24.3","start":18024003,"end":18024003,"break":"line","breaks":[[14,"line"]],"ruby":[[8,1,"お"],[12,1,"もの"],[18,1,"うし"],[20,1,"しち"],[22,1,"と"],[24,1,"もの"]],"text":"みなしごのろばを追いやる者、やもめの牛を質に取る者、"},{"ref":"Job.24.4","start":18024004,"end":18024004,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[5,1,"みち"],[8,1,"お"],[13,1,"もの"],[18,1,"よ"],[20,1,"よわ"],[22,1,"もの"],[24,1,"みな"],[25,1,"かれ"],[31,1,"み"]],"text":"貧しい者を道から押しのける者がある。世の弱い者は皆彼らをさけて身をかくす。"},{"ref":"Job.24.5","start":18024005,"end":18024005,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[6,2,"あらの"],[11,1,"の"],[18,1,"で"],[20,1,"はたら"],[23,1,"の"],[25,2,"えもの"],[28,1,"もと"],[34,1,"こ"],[37,2,"しょくもつ"]],"text":"見よ、彼らは荒野におる野ろばのように出て働き、野で獲物を求めて、その子らの食物とする。"},{"ref":"Job.24.6","start":18024006,"end":18024006,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[3,1,"はたけ"],[11,1,"か"],[16,2,"あくにん"],[22,1,"はたけ"],[24,1,"ひろ"],[26,1,"あつ"]],"text":"彼らは畑でそのまぐさを刈り、また悪人のぶどう畑で拾い集める。"},{"ref":"Job.24.7","start":18024007,"end":18024007,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"き"],[5,1,"もの"],[10,1,"はだか"],[12,1,"よる"],[14,1,"す"],[18,1,"さむ"],[21,1,"み"],[28,1,"もの"]],"text":"彼らは着る物がなく、裸で夜を過ごし、寒さに身をおおうべき物もない。"},{"ref":"Job.24.8","start":18024008,"end":18024008,"break":"line","ruby":[[0,1,"かれ"],[3,1,"やま"],[5,1,"あめ"],[13,1,"ば"],[17,1,"いわ"]],"text":"彼らは山の雨にぬれ、しのぎ場もなく岩にすがる。"},{"ref":"Job.24.9","start":18024009,"end":18024009,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"はは"],[16,1,"うば"],[19,1,"まず"],[22,1,"もの"],[24,1,"おさ"],[26,1,"ご"],[28,1,"しち"],[32,1,"もの"]],"text":"（みなしごをその母のふところから奪い、貧しい者の幼な子を質にとる者がある。）"},{"ref":"Job.24.10","start":18024010,"end":18024010,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"き"],[5,1,"もの"],[10,1,"はだか"],[12,1,"ある"],[15,1,"う"],[19,1,"むぎ"],[20,1,"たば"],[22,1,"はこ"]],"text":"彼らは着る物がなく、裸で歩き、飢えつつ麦束を運び、"},{"ref":"Job.24.11","start":18024011,"end":18024011,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"あくにん"],[8,1,"き"],[10,1,"なか"],[12,1,"あぶら"],[18,1,"さか"],[22,1,"ふ"],[31,1,"おぼ"]],"text":"悪人のオリブ並み木の中で油をしぼり、酒ぶねを踏んでも、かわきを覚える。"},{"ref":"Job.24.12","start":18024012,"end":18024012,"break":"line","breaks":[[14,"line"],[31,"line"]],"ruby":[[0,1,"まち"],[2,1,"なか"],[5,1,"し"],[11,1,"おこ"],[14,1,"きず"],[18,1,"もの"],[20,1,"たましい"],[22,1,"たす"],[25,1,"よ"],[27,1,"もと"],[34,1,"かみ"],[36,1,"かれ"],[39,1,"いのり"],[41,1,"かえり"]],"text":"町の中から死のうめきが起り、傷ついた者の魂が助けを呼び求める。しかし神は彼らの祈を顧みられない。"},{"ref":"Job.24.13","start":18024013,"end":18024013,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ひかり"],[5,1,"もの"],[12,1,"かれ"],[15,1,"ひかり"],[17,1,"みち"],[19,1,"し"],[23,1,"ひかり"],[25,1,"みち"]],"text":"光にそむく者たちがある。彼らは光の道を知らず、光の道にとどまらない。"},{"ref":"Job.24.14","start":18024014,"end":18024014,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[0,1,"ひと"],[2,1,"ころ"],[4,1,"もの"],[6,1,"くら"],[11,1,"お"],[13,1,"で"],[15,1,"よわ"],[17,1,"もの"],[19,1,"まず"],[22,1,"もの"],[24,1,"ころ"],[27,1,"よる"],[29,1,"ぬす"]],"text":"人を殺す者は暗いうちに起き出て弱い者と貧しい者を殺し、夜は盗びととなる。"},{"ref":"Job.24.15","start":18024015,"end":18024015,"break":"line","breaks":[[17,"line"],[38,"line"]],"ruby":[[0,2,"かんいん"],[4,1,"もの"],[6,1,"め"],[13,1,"ま"],[25,1,"み"],[35,1,"い"],[38,1,"かお"],[43,1,"もの"],[45,1,"あ"]],"text":"姦淫する者の目はたそがれを待って、『だれもわたしを見ていないだろう』と言い、顔におおう物を当てる。"},{"ref":"Job.24.16","start":18024016,"end":18024016,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[3,1,"くら"],[7,1,"いえ"],[13,1,"ひる"],[15,1,"と"],[21,1,"ひかり"],[23,1,"し"]],"text":"彼らは暗やみで家をうがち、昼は閉じこもって光を知らない。"},{"ref":"Job.24.17","start":18024017,"end":18024017,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[4,2,"あんこく"],[7,1,"あさ"],[12,1,"かれ"],[15,2,"あんこく"],[18,1,"おそ"],[21,1,"とも"]],"text":"彼らには暗黒は朝である。彼らは暗黒の恐れを友とするからだ。"},{"ref":"Job.24.18","start":18024018,"end":18024018,"break":"stanza","breaks":[[9,"line"],[29,"line"],[43,"line"],[54,"line"]],"ruby":[[6,1,"い"],[10,1,"かれ"],[13,1,"みず"],[24,1,"なが"],[26,1,"さ"],[31,1,"う"],[34,1,"ぶん"],[36,1,"ち"],[43,1,"さか"],[47,1,"ふ"],[49,1,"もの"],[54,1,"かれ"],[60,1,"はたけ"],[62,1,"みち"],[64,1,"い"]],"text":"あなたがたは言う、『彼らは水のおもてにすみやかに流れ去り、その受ける分は地でのろわれ、酒ぶねを踏む者はだれも彼らのぶどう畑の道に行かない。"},{"ref":"Job.24.19","start":18024019,"end":18024019,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"あつ"],[7,1,"ゆき"],[8,1,"みず"],[10,1,"うば"],[12,1,"さ"],[15,2,"よみ"],[18,1,"つみ"],[20,1,"おか"],[23,1,"もの"],[25,1,"たい"],[33,2,"どうよう"]],"text":"ひでりと熱さは雪水を奪い去る、陰府が罪を犯した者に対するも、これと同様だ。"},{"ref":"Job.24.20","start":18024020,"end":18024020,"break":"line","breaks":[[11,"line"],[26,"line"]],"ruby":[[0,1,"まち"],[2,2,"ひろば"],[5,1,"かれ"],[8,1,"わす"],[11,1,"かれ"],[14,1,"な"],[16,1,"おぼ"],[26,2,"ふぎ"],[29,1,"き"],[31,1,"お"],[38,1,"お"]],"text":"町の広場は彼らを忘れ、彼らの名は覚えられることなく、不義は木の折られるように折られる』と。"},{"ref":"Job.24.21","start":18024021,"end":18024021,"break":"stanza","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こ"],[5,1,"う"]],"text":"彼らは子を産まぬうまずめをくらい、やもめをあわれむことをしない。"},{"ref":"Job.24.22","start":18024022,"end":18024022,"break":"line","breaks":[[13,"line"],[30,"line"]],"ruby":[[3,1,"かみ"],[7,1,"ちから"],[13,1,"つよ"],[15,2,"ひとびと"],[18,1,"い"],[30,1,"かれ"],[33,1,"い"],[36,1,"のぞ"],[41,1,"とき"],[44,1,"お"]],"text":"しかし神はその力をもって、強い人々を生きながらえさせられる。彼らは生きる望みのない時にも起きあがる。"},{"ref":"Job.24.23","start":18024023,"end":18024023,"break":"line","breaks":[[16,"line"],[26,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[5,2,"あんぜん"],[8,1,"あた"],[16,1,"かれ"],[19,1,"やす"],[26,1,"かみ"],[28,1,"め"],[30,1,"かれ"],[33,1,"みち"],[35,1,"うえ"]],"text":"神が彼らに安全を与えられるので、彼らは安らかである。神の目は彼らの道の上にある。"},{"ref":"Job.24.24","start":18024024,"end":18024024,"break":"line","breaks":[[18,"line"],[35,"line"]],"ruby":[[0,1,"かれ"],[6,1,"たか"],[27,1,"か"],[30,1,"き"],[35,1,"むぎ"],[37,2,"ほさき"],[43,1,"き"],[45,1,"と"]],"text":"彼らはしばし高められて、いなくなり、ぜにあおいのように枯れて消えうせ、麦の穂先のように切り取られる。"},{"ref":"Job.24.25","start":18024025,"end":18024025,"break":"line","breaks":[[11,"line"],[27,"line"]],"ruby":[[20,1,"いつわ"],[23,2,"しょうめい"],[29,2,"ことば"],[39,1,"しめ"]],"text":"もし、そうでないなら、だれがわたしにその偽りを証明し、わが言葉のむなしいことを示しうるだろうか」。"}]