[{"ref":"Jer.2.1","start":24002001,"end":24002001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"],[12,1,"い"]],"text":"主の言葉がわたしに臨んで言う、"},{"ref":"Jer.2.2","start":24002002,"end":24002002,"break":"none","breaks":[[30,"stanza"],[45,"line"],[52,"line"],[63,"line"]],"ruby":[[1,1,"い"],[11,1,"す"],[13,1,"もの"],[15,1,"みみ"],[17,1,"つ"],[21,1,"しゅ"],[25,1,"い"],[38,1,"わか"],[40,1,"とき"],[42,2,"じゅんじょう"],[45,2,"はなよめ"],[48,1,"とき"],[50,1,"あい"],[52,2,"あらの"],[57,1,"たね"],[61,1,"ち"],[67,1,"したが"],[73,1,"おぼ"]],"text":"「行って、エルサレムに住む者の耳に告げよ、主はこう言われる、わたしはあなたの若い時の純情、花嫁の時の愛、荒野なる、種まかぬ地でわたしに従ったことを覚えている。"},{"ref":"Jer.2.3","start":24002003,"end":24002003,"break":"line","breaks":[[19,"line"],[31,"line"],[47,"line"]],"ruby":[[6,1,"しゅ"],[11,2,"せいべつ"],[21,2,"かりい"],[25,2,"はつほ"],[37,1,"た"],[40,1,"もの"],[42,1,"つみ"],[47,1,"わざわい"],[53,1,"しゅ"],[55,1,"い"]],"text":"イスラエルは主のために聖別されたもの、その刈入れの初穂である。すべてこれを食べる者は罪せられ、災にあう」と主は言われる。"},{"ref":"Jer.2.4","start":24002004,"end":24002004,"break":"paragraph","ruby":[[4,1,"いえ"],[12,1,"いえ"],[23,1,"しゅ"],[25,2,"ことば"],[28,1,"き"]],"text":"ヤコブの家とイスラエルの家のすべてのやからよ、主の言葉を聞け。"},{"ref":"Jer.2.5","start":24002005,"end":24002005,"break":"none","breaks":[[9,"stanza"],[20,"line"],[38,"line"],[48,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[16,2,"せんぞ"],[27,1,"わる"],[29,1,"こと"],[35,1,"み"],[43,1,"とお"],[55,1,"したが"]],"text":"主はこう言われる、「あなたがたの先祖は、わたしになんの悪い事があるのを見て、わたしから遠ざかり、むなしいものに従って、むなしくなったのか。"},{"ref":"Jer.2.6","start":24002006,"end":24002006,"break":"line","breaks":[[10,"line"],[29,"line"],[43,"line"],[54,"line"],[69,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[21,1,"ち"],[24,1,"みちび"],[26,1,"だ"],[29,2,"あらの"],[34,1,"あな"],[36,1,"おお"],[38,1,"あ"],[41,1,"ち"],[47,1,"こ"],[49,2,"あんこく"],[52,1,"ち"],[54,1,"ひと"],[56,1,"とお"],[61,1,"ひと"],[63,1,"す"],[67,1,"ち"],[69,1,"とお"],[73,1,"しゅ"]],"text":"彼らは言わなかった、『われわれをエジプトの地より導き出し、荒野なる、穴の多い荒れた地、かわいた濃い暗黒の地、人の通らない、人の住まない地を通らせた主はどこにおられるか』と。"},{"ref":"Jer.2.7","start":24002007,"end":24002007,"break":"line","breaks":[[21,"line"],[35,"line"],[52,"line"],[61,"line"]],"ruby":[[10,1,"みちび"],[13,1,"ゆた"],[16,1,"ち"],[18,1,"い"],[23,1,"み"],[25,1,"よ"],[27,1,"もの"],[29,1,"た"],[56,1,"ち"],[58,1,"けが"],[65,1,"し"],[66,1,"ぎょう"],[68,1,"にく"]],"text":"わたしはあなたがたを導いて豊かな地に入れ、その実と良い物を食べさせた。しかしあなたがたはここにはいって、わたしの地を汚し、わたしの嗣業を憎むべきものとした。"},{"ref":"Jer.2.8","start":24002008,"end":24002008,"break":"line","breaks":[[6,"line"],[26,"line"],[43,"line"],[57,"line"],[74,"line"]],"ruby":[[0,2,"さいし"],[7,1,"しゅ"],[19,1,"い"],[26,2,"りっぽう"],[29,1,"あつか"],[31,1,"もの"],[39,1,"し"],[57,3,"よげんしゃ"],[70,2,"よげん"],[74,1,"えき"],[77,1,"もの"],[79,1,"したが"],[82,1,"い"]],"text":"祭司たちは、『主はどこにおられるか』と言わなかった。律法を扱う者たちはわたしを知らず、つかさたちはわたしにそむき、預言者たちはバアルによって預言し、益なき者に従って行った。"},{"ref":"Jer.2.9","start":24002009,"end":24002009,"break":"stanza","breaks":[[21,"line"]],"ruby":[[18,1,"あらそ"],[29,2,"しそん"],[32,1,"あらそ"],[36,1,"しゅ"],[38,1,"い"]],"text":"それゆえ、わたしはなお、あなたがたと争う、またあなたがたの子孫と争う」と主は言われる。"},{"ref":"Jer.2.10","start":24002010,"end":24002010,"break":"line","breaks":[[20,"line"],[34,"line"],[50,"line"]],"ruby":[[11,2,"しまじま"],[14,1,"わた"],[22,1,"ひと"]],"text":"「あなたがたはクプロの島々に渡ってみよ、また人をケダルにつかわして、このようなことがかつてあったかをつまびらかに、しらべてみよ。"},{"ref":"Jer.2.11","start":24002011,"end":24002011,"break":"line","breaks":[[23,"line"],[39,"line"]],"ruby":[[2,1,"かみ"],[4,1,"かみ"],[9,1,"もの"],[11,1,"と"],[13,1,"か"],[16,1,"くに"],[32,1,"たみ"],[36,2,"えいこう"],[39,1,"えき"],[45,1,"と"],[47,1,"か"]],"text":"その神を神ではない者に取り替えた国があろうか。ところが、わたしの民はその栄光を益なきものと取り替えた。"},{"ref":"Jer.2.12","start":24002012,"end":24002012,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"てん"],[5,1,"こと"],[7,1,"し"],[10,1,"おどろ"],[21,1,"おそ"],[26,1,"しゅ"],[28,1,"い"]],"text":"天よ、この事を知って驚け、おののけ、いたく恐れよ」と主は言われる。"},{"ref":"Jer.2.13","start":24002013,"end":24002013,"break":"line","breaks":[[11,"line"],[28,"line"],[49,"line"],[60,"line"],[73,"line"]],"ruby":[[9,1,"たみ"],[14,1,"あ"],[17,1,"こと"],[19,1,"おこな"],[32,1,"い"],[35,1,"みず"],[37,1,"みなもと"],[45,1,"す"],[49,2,"じぶん"],[52,1,"みず"],[56,1,"ほ"],[68,1,"みず"],[73,1,"みず"],[75,1,"い"]],"text":"「それは、わたしの民が二つの悪しき事を行ったからである。すなわち生ける水の源であるわたしを捨てて、自分で水ためを掘った。それは、こわれた水ためで、水を入れておくことのできないものだ。"},{"ref":"Jer.2.14","start":24002014,"end":24002014,"break":"stanza","breaks":[[13,"line"],[26,"line"]],"ruby":[[6,2,"どれい"],[13,1,"いえ"],[15,1,"うま"],[32,1,"とら"],[36,1,"み"]],"text":"イスラエルは奴隷であるか、家に生れたしもべであるか。それならなぜ捕われの身となったのか。"},{"ref":"Jer.2.15","start":24002015,"end":24002015,"break":"line","breaks":[[12,"line"],[30,"line"]],"ruby":[[3,1,"かれ"],[5,1,"む"],[14,1,"こえ"],[16,1,"たか"],[22,1,"かれ"],[24,1,"ち"],[26,1,"あら"],[32,2,"まちまち"],[35,1,"ほろ"],[38,1,"す"],[40,1,"ひと"]],"text":"ししは彼に向かってほえ、その声を高くあげて、彼の地を荒した。その町々は滅びて住む人もない。"},{"ref":"Jer.2.16","start":24002016,"end":24002016,"break":"line","breaks":[[16,"line"]],"ruby":[[10,2,"ひとびと"],[24,1,"かんむり"],[26,1,"くだ"]],"text":"メンピスとタパネスの人々もまた、あなたのかしらの冠を砕いた。"},{"ref":"Jer.2.17","start":24002017,"end":24002017,"break":"line","breaks":[[20,"line"],[32,"line"]],"ruby":[[4,1,"かみ"],[6,1,"しゅ"],[12,1,"みち"],[14,1,"みちび"],[18,1,"とき"],[24,1,"しゅ"],[26,1,"す"],[34,1,"こと"],[40,1,"およ"]],"text":"あなたの神、主があなたを道に導かれた時、あなたは主を捨てたので、この事があなたに及んだのではないか。"},{"ref":"Jer.2.18","start":24002018,"end":24002018,"break":"line","breaks":[[17,"line"],[32,"line"],[48,"line"]],"ruby":[[8,1,"みず"],[10,1,"の"],[22,1,"い"],[26,1,"なに"],[39,1,"みず"],[41,1,"の"],[54,1,"い"],[58,1,"なに"]],"text":"あなたがナイルの水を飲もうとして、エジプトへ行くのは何のためか。またユフラテの水を飲もうとして、アッスリヤへ行くのは何のためか。"},{"ref":"Jer.2.19","start":24002019,"end":24002019,"break":"line","breaks":[[15,"line"],[30,"line"],[49,"line"],[71,"line"],[94,"line"]],"ruby":[[4,2,"あくじ"],[11,1,"こら"],[19,2,"はいしん"],[26,1,"せ"],[39,1,"かみ"],[41,1,"しゅ"],[43,1,"す"],[49,1,"あ"],[54,1,"にが"],[63,1,"み"],[65,1,"し"],[75,1,"おそ"],[94,2,"ばんぐん"],[97,1,"かみ"],[99,1,"しゅ"],[101,1,"い"]],"text":"あなたの悪事はあなたを懲しめ、あなたの背信はあなたを責める。あなたが、あなたの神、主を捨てることの悪しくかつ苦いことであるのを見て知るがよい。わたしを恐れることがあなたのうちにないのだ」と万軍の神、主は言われる。"},{"ref":"Jer.2.20","start":24002020,"end":24002020,"break":"stanza","breaks":[[21,"line"],[34,"line"],[54,"line"],[69,"line"],[79,"line"]],"ruby":[[5,1,"ひさ"],[8,2,"いぜん"],[11,2,"じぶん"],[18,1,"お"],[21,2,"じぶん"],[28,1,"た"],[30,1,"き"],[39,1,"つか"],[50,1,"い"],[62,1,"たか"],[64,1,"おか"],[66,1,"うえ"],[73,1,"あお"],[74,1,"き"],[76,1,"した"],[79,2,"ゆうじょ"],[85,1,"み"]],"text":"「あなたは久しい以前に自分のくびきを折り、自分のなわめを断ち切って、『わたしは仕えることをしない』と言った。そして、すべての高い丘の上と、すべての青木の下で、遊女のように身をかがめた。"},{"ref":"Jer.2.21","start":24002021,"end":24002021,"break":"line","breaks":[[17,"line"],[35,"line"],[47,"line"]],"ruby":[[13,1,"よ"],[15,1,"たね"],[25,1,"き"],[29,1,"う"],[43,1,"かわ"],[47,1,"わる"],[49,1,"の"],[54,1,"き"]],"text":"わたしはあなたを、まったく良い種のすぐれたぶどうの木として植えたのに、どうしてあなたは変って、悪い野ぶどうの木となったのか。"},{"ref":"Jer.2.22","start":24002022,"end":24002022,"break":"line","breaks":[[15,"line"],[28,"line"],[50,"line"]],"ruby":[[10,1,"みずか"],[12,1,"あら"],[17,1,"おお"],[20,2,"あく"],[23,1,"もち"],[32,1,"あく"],[34,1,"けが"],[44,1,"まえ"],[50,1,"しゅ"],[53,1,"かみ"],[55,1,"い"]],"text":"たといソーダをもって自ら洗い、また多くの灰汁を用いても、あなたの悪の汚れは、なおわたしの前にある」と主なる神は言われる。"},{"ref":"Jer.2.23","start":24002023,"end":24002023,"break":"line","breaks":[[22,"line"],[45,"line"],[63,"line"],[78,"line"],[97,"line"]],"ruby":[[15,1,"けが"],[26,1,"したが"],[34,1,"い"],[45,1,"たに"],[47,1,"なか"],[54,1,"おこな"],[57,1,"み"],[72,1,"し"],[82,1,"ぎょ"],[87,1,"わか"],[99,1,"みち"],[101,1,"ゆ"]],"text":"「どうしてあなたは、『わたしは汚れていない、バアルに従わなかった』と言うことができようか。谷の中でのあなたの行いを見るがよい。あなたのしたことを知るがよい。あなたは御しがたい若いらくだであって、その道を行きつもどりつする。"},{"ref":"Jer.2.24","start":24002024,"end":24002024,"break":"line","breaks":[[19,"line"],[33,"line"],[54,"line"],[76,"line"]],"ruby":[[4,2,"あらの"],[7,1,"な"],[10,1,"の"],[12,1,"め"],[21,2,"よくじょう"],[27,1,"かぜ"],[35,2,"よくじょう"],[60,1,"たず"],[63,1,"もの"],[65,1,"く"],[66,1,"ろう"],[78,1,"つき"],[86,1,"あ"]],"text":"あなたは荒野に慣れた野の雌ろばである、その欲情のために風にあえぐ。その欲情をだれがとどめることができようか。すべてこれを尋ねる者は苦労するにおよばない、その月であればこれに会うことができる。"},{"ref":"Jer.2.25","start":24002025,"end":24002025,"break":"line","breaks":[[19,"line"],[34,"line"],[55,"line"],[70,"line"]],"ruby":[[4,1,"あし"],[43,1,"い"],[59,1,"こと"],[62,1,"くに"],[64,1,"もの"],[66,1,"あい"],[73,1,"したが"],[76,1,"い"]],"text":"あなたの足が、はだしにならないように、のどが、かわかないようにせよ。ところが、あなたは言った、『それはだめだ、わたしは異なる国の者を愛して、それに従って行こう』と。"},{"ref":"Jer.2.26","start":24002026,"end":24002026,"break":"stanza","breaks":[[23,"line"],[42,"line"],[57,"line"]],"ruby":[[0,1,"ぬす"],[4,1,"とら"],[16,1,"う"],[29,1,"いえ"],[38,1,"う"],[42,1,"かれ"],[47,1,"おう"],[59,2,"さいし"],[65,3,"よげんしゃ"]],"text":"盗びとが捕えられて、はずかしめを受けるように、イスラエルの家は、はずかしめを受ける。彼らはその王も、そのつかさも、その祭司も、その預言者もみなそのとおりである。"},{"ref":"Jer.2.27","start":24002027,"end":24002027,"break":"line","breaks":[[10,"line"],[27,"line"],[36,"line"],[58,"line"],[71,"line"],[84,"line"],[97,"line"]],"ruby":[[0,1,"かれ"],[3,1,"き"],[5,1,"む"],[19,1,"ちち"],[24,1,"い"],[29,1,"いし"],[31,1,"む"],[45,1,"う"],[55,1,"い"],[58,1,"かれ"],[61,1,"せ"],[67,1,"む"],[73,1,"かお"],[79,1,"む"],[87,1,"かれ"],[90,1,"わざわい"],[94,1,"とき"],[98,1,"た"],[107,1,"すく"],[114,1,"い"]],"text":"彼らは木に向かって、『あなたはわたしの父です』と言い、また石に向かって、『あなたはわたしを生んでくださった』と言う。彼らは背をわたしに向けて、その顔をわたしに向けない。しかし彼らが災にあう時は、『立って、われわれを救いたまえ』と言う。"},{"ref":"Jer.2.28","start":24002028,"end":24002028,"break":"line","breaks":[[16,"line"],[24,"line"],[34,"line"],[49,"line"],[59,"line"],[71,"line"]],"ruby":[[4,2,"じぶん"],[10,1,"つく"],[13,2,"かみがみ"],[28,1,"わざわい"],[32,1,"とき"],[36,1,"かれ"],[43,1,"すく"],[49,1,"た"],[67,2,"かみがみ"],[75,1,"まち"],[77,1,"かず"],[80,1,"おお"]],"text":"あなたが自分のために造った神々はどこにいるのか。あなたが災にあう時、もし彼らがあなたを救えるなら、立ってもらうがよい。ユダよ、あなたの神々は、あなたの町の数ほど多いからである。"},{"ref":"Jer.2.29","start":24002029,"end":24002029,"break":"line","breaks":[[18,"line"],[37,"line"]],"ruby":[[13,1,"あらそ"],[24,1,"みな"],[37,1,"しゅ"],[39,1,"い"]],"text":"あなたがたは、なぜわたしと争うのか。あなたがたは皆わたしにそむいている」と主は言われる。"},{"ref":"Jer.2.30","start":24002030,"end":24002030,"break":"line","breaks":[[17,"line"],[29,"line"],[39,"line"],[50,"line"]],"ruby":[[11,1,"こ"],[17,1,"う"],[29,1,"かれ"],[32,1,"いまし"],[35,1,"う"],[62,3,"よげんしゃ"],[68,1,"ほろ"]],"text":"「わたしがあなたがたの子どもたちを打ったのはむだであった。彼らは戒めを受けず、あなたがたのつるぎは、たけりたつししのように、預言者たちを滅ぼした。"},{"ref":"Jer.2.31","start":24002031,"end":24002031,"break":"line","breaks":[[13,"line"],[21,"line"],[35,"line"],[47,"line"],[61,"line"],[84,"line"]],"ruby":[[7,2,"せだい"],[10,1,"ひと"],[13,1,"しゅ"],[15,2,"ことば"],[18,1,"き"],[35,2,"あらの"],[47,2,"あんこく"],[50,1,"ち"],[72,1,"たみ"],[80,2,"じゆう"],[96,1,"い"],[102,1,"い"]],"text":"あなたがたこの世代の人よ、主の言葉を聞け。わたしはイスラエルにとって、荒野であったであろうか。暗黒の地であったであろうか。それならなぜ、わたしの民は『われわれは自由だ、もはやあなたのところへは行かない』と言うのか。"},{"ref":"Jer.2.32","start":24002032,"end":24002032,"break":"line","breaks":[[22,"line"],[41,"line"],[53,"line"]],"ruby":[[6,1,"かざ"],[8,1,"もの"],[10,1,"わす"],[22,2,"はなよめ"],[27,1,"おび"],[29,1,"わす"],[50,1,"たみ"],[57,1,"わす"],[60,1,"ひ"],[62,1,"かぞ"]],"text":"おとめはその飾り物を忘れることができようか。花嫁はその帯を忘れることができようか。ところが、わたしの民の、わたしを忘れた日は数えがたい。"},{"ref":"Jer.2.33","start":24002033,"end":24002033,"break":"stanza","breaks":[[11,"line"],[28,"line"]],"ruby":[[4,2,"こいびと"],[7,1,"たず"],[15,1,"たく"],[20,1,"ほう"],[22,1,"あし"],[24,1,"む"],[32,1,"わる"],[34,1,"おんな"],[42,1,"みち"],[44,1,"まな"]],"text":"あなたは恋人を尋ねて、いかにも巧みにその方に足を向ける。それゆえ悪い女さえ、あなたの道を学んだ。"},{"ref":"Jer.2.34","start":24002034,"end":24002034,"break":"line","breaks":[[14,"line"],[33,"line"],[54,"line"]],"ruby":[[7,2,"きもの"],[14,1,"つみ"],[18,1,"まず"],[21,1,"ひと"],[23,1,"いのち"],[25,1,"ち"],[37,1,"かれ"],[40,1,"お"],[42,1,"い"],[46,1,"み"],[65,1,"こと"]],"text":"また、あなたの着物のすそには罪のない貧しい人の命の血がついている。あなたは彼らが押し入るのを見たのではない。しかも、すべてこれらの事にもかかわらず、"},{"ref":"Jer.2.35","start":24002035,"end":24002035,"break":"line","breaks":[[23,"line"],[40,"line"],[59,"line"]],"ruby":[[4,1,"い"],[12,1,"つみ"],[17,1,"かれ"],[19,1,"いか"],[23,1,"けっ"],[30,1,"のぞ"],[49,1,"つみ"],[51,1,"おか"],[59,1,"い"]],"text":"あなたは言う、『わたしは罪がない。彼の怒りは、決してわたしに臨むことがない』と。あなたが『わたしは罪を犯さなかった』と言うことによって、わたしはあなたをさばく。"},{"ref":"Jer.2.36","start":24002036,"end":24002036,"break":"line","breaks":[[16,"line"],[30,"line"],[54,"line"]],"ruby":[[6,2,"かるがる"],[18,1,"みち"],[20,1,"か"],[47,1,"う"],[69,1,"う"]],"text":"あなたはなぜ軽々しくさまよって、その道を変えようとするのか。あなたはアッスリヤに、はずかしめを受けたように、エジプトにもまた、はずかしめを受ける。"},{"ref":"Jer.2.37","start":24002037,"end":24002037,"break":"line","breaks":[[24,"line"],[47,"line"]],"ruby":[[6,2,"りょうて"],[9,1,"あたま"],[11,1,"お"],[19,1,"で"],[21,1,"く"],[24,1,"しゅ"],[30,1,"たの"],[35,1,"もの"],[39,1,"す"],[51,1,"かれ"],[57,1,"さか"]],"text":"あなたはまた両手を頭に置いて、そこから出て来る。主があなたの頼みとする者どもを捨てられたので、あなたは彼らによって栄えることがないからだ。"}]