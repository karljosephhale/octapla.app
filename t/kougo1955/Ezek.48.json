[{"ref":"Ezek.48.1","start":26048001,"end":26048001,"break":"paragraph","ruby":[[6,2,"ぶぞく"],[9,1,"な"],[11,1,"つぎ"],[20,1,"きた"],[22,1,"はて"],[30,1,"みち"],[32,1,"へ"],[39,2,"いりぐち"],[42,1,"いた"],[49,2,"あいたい"],[58,1,"きた"],[60,1,"さかい"],[72,1,"およ"],[75,1,"ひがし"],[77,1,"ほう"],[80,1,"にし"],[82,1,"ほう"],[87,2,"ちほう"],[96,1,"ぶん"]],"text":"イスラエルの部族の名は次のとおりである。北の果からヘテロンの道を経て、ハマテの入口に至り、ハマテに相対するダマスコの北の境にあるハザル・エノンに及び、東の方から西の方へのびる地方、これがダンの分である。"},{"ref":"Ezek.48.2","start":26048002,"end":26048002,"break":"none","ruby":[[3,2,"りょうち"],[6,1,"そ"],[10,1,"ひがし"],[12,1,"ほう"],[15,1,"にし"],[17,1,"ほう"],[22,2,"ちほう"],[32,1,"ぶん"]],"text":"ダンの領地に沿って、東の方から西の方へのびる地方、これがアセルの分である。"},{"ref":"Ezek.48.3","start":26048003,"end":26048003,"break":"none","ruby":[[4,2,"りょうち"],[7,1,"そ"],[11,1,"ひがし"],[13,1,"ほう"],[16,1,"にし"],[18,1,"ほう"],[23,2,"ちほう"],[34,1,"ぶん"]],"text":"アセルの領地に沿って、東の方から西の方へのびる地方、これがナフタリの分である。"},{"ref":"Ezek.48.4","start":26048004,"end":26048004,"break":"none","ruby":[[5,2,"りょうち"],[8,1,"そ"],[12,1,"ひがし"],[14,1,"ほう"],[17,1,"にし"],[19,1,"ほう"],[24,2,"ちほう"],[34,1,"ぶん"]],"text":"ナフタリの領地に沿って、東の方から西の方へのびる地方、これがマナセの分である。"},{"ref":"Ezek.48.5","start":26048005,"end":26048005,"break":"none","ruby":[[4,2,"りょうち"],[7,1,"そ"],[11,1,"ひがし"],[13,1,"ほう"],[16,1,"にし"],[18,1,"ほう"],[23,2,"ちほう"],[35,1,"ぶん"]],"text":"マナセの領地に沿って、東の方から西の方へのびる地方、これがエフライムの分である。"},{"ref":"Ezek.48.6","start":26048006,"end":26048006,"break":"none","ruby":[[6,2,"りょうち"],[9,1,"そ"],[13,1,"ひがし"],[15,1,"ほう"],[18,1,"にし"],[20,1,"ほう"],[25,2,"ちほう"],[35,1,"ぶん"]],"text":"エフライムの領地に沿って、東の方から西の方へのびる地方、これがルベンの分である。"},{"ref":"Ezek.48.7","start":26048007,"end":26048007,"break":"none","ruby":[[4,2,"りょうち"],[7,1,"そ"],[11,1,"ひがし"],[13,1,"ほう"],[16,1,"にし"],[18,1,"ほう"],[23,2,"ちほう"],[32,1,"ぶん"]],"text":"ルベンの領地に沿って、東の方から西の方へのびる地方、これがユダの分である。"},{"ref":"Ezek.48.8","start":26048008,"end":26048008,"break":"paragraph","ruby":[[3,2,"りょうち"],[6,1,"そ"],[10,1,"ひがし"],[12,1,"ほう"],[15,1,"にし"],[17,1,"ほう"],[22,2,"ちほう"],[36,2,"けんのう"],[38,1,"ち"],[45,1,"はば"],[58,1,"ひがし"],[60,1,"ほう"],[63,1,"にし"],[65,1,"ほう"],[70,1,"なが"],[74,2,"ぶぞく"],[80,1,"ぶん"],[82,1,"おな"],[86,2,"せいじょ"],[91,1,"なか"]],"text":"ユダの領地に沿って、東の方から西の方へのびる地方は、あなたがたのささげる献納地とせよ。その幅は二万五千キュビト、その東の方から西の方へのびる長さは、部族の一つの分に同じで、聖所はその中にある。"},{"ref":"Ezek.48.9","start":26048009,"end":26048009,"break":"none","ruby":[[10,1,"しゅ"],[16,2,"けんのう"],[18,1,"ち"],[20,1,"なが"],[31,1,"はば"]],"text":"すなわちあなたがたの主にささげる献納地は長さ二万五千キュビト、幅二万キュビトとである。"},{"ref":"Ezek.48.10","start":26048010,"end":26048010,"break":"none","ruby":[[3,2,"さいし"],[7,1,"せい"],[10,2,"けんのう"],[12,1,"ち"],[21,2,"さいし"],[24,1,"ぶん"],[27,1,"きた"],[38,1,"にし"],[40,1,"はば"],[48,1,"ひがし"],[50,1,"はば"],[58,1,"みなみ"],[60,1,"なが"],[74,1,"しゅ"],[76,2,"せいじょ"],[81,1,"なか"]],"text":"これが祭司への聖なる献納地である。すなわち祭司の分は、北は二万五千キュビト、西は幅一万キュビト、東は幅一万キュビト、南は長さ二万五千キュビトである。主の聖所はその中にある。"},{"ref":"Ezek.48.11","start":26048011,"end":26048011,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"まよ"],[14,1,"で"],[16,1,"とき"],[23,1,"まよ"],[29,1,"まよ"],[40,1,"つとめ"],[42,1,"まも"],[44,1,"とお"],[51,2,"しそん"],[59,2,"せいべつ"],[64,2,"さいし"],[67,1,"ぞく"]],"text":"これはイスラエルの人々が迷い出た時、レビびとが迷ったように迷ったことはなく、わが務を守り通したザドクの子孫のうちから、聖別された祭司に属する。"},{"ref":"Ezek.48.12","start":26048012,"end":26048012,"break":"none","ruby":[[10,1,"さかい"],[12,1,"そ"],[18,1,"せい"],[21,1,"ち"],[27,1,"せい"],[30,2,"けんのう"],[32,1,"ち"],[35,2,"とくべつ"],[38,1,"ぶん"],[42,1,"かれ"],[45,1,"き"],[46,1,"ぞく"]],"text":"このようにレビびとの境に沿って、いと聖なる地、すなわち聖なる献納地が、特別な分として彼らに帰属する。"},{"ref":"Ezek.48.13","start":26048013,"end":26048013,"break":"none","ruby":[[5,1,"ぶん"],[7,2,"さいし"],[10,2,"しょゆう"],[12,1,"ち"],[14,1,"さかい"],[16,1,"そ"],[20,1,"なが"],[31,1,"はば"],[50,1,"なが"],[61,1,"はば"]],"text":"レビびとの分は祭司の所有地の境に沿って、長さ二万五千キュビト、幅一万キュビト、すなわち、そのすべての長さ二万五千キュビト、幅二万キュビトである。"},{"ref":"Ezek.48.14","start":26048014,"end":26048014,"break":"none","ruby":[[0,1,"かれ"],[6,1,"う"],[17,2,"こうかん"],[31,2,"だいじ"],[34,1,"ぶん"],[36,1,"て"],[50,1,"しゅ"],[52,1,"ぞく"],[55,1,"せい"],[58,1,"もの"]],"text":"彼らはこれを売ってはならない、また交換してはならない、またその大事な分を手ばなしてはならない。これは主に属する聖なる物だからである。"},{"ref":"Ezek.48.15","start":26048015,"end":26048015,"break":"paragraph","ruby":[[2,1,"のこ"],[5,1,"ち"],[10,1,"はば"],[18,1,"なが"],[29,1,"まち"],[43,2,"こうがい"],[49,3,"いっぱんじん"],[53,2,"じしょ"],[59,1,"まち"],[63,1,"なか"],[65,1,"お"]],"text":"その残りの地すなわち幅五千キュビト、長さ二万五千キュビトは町のため、すみかのため、また郊外のための一般人の地所とせよ。町はその中に置け。"},{"ref":"Ezek.48.16","start":26048016,"end":26048016,"break":"none","ruby":[[0,3,"いっぱんじん"],[4,2,"じしょ"],[7,1,"ひろ"],[10,1,"つぎ"],[23,1,"きた"],[25,1,"ほう"],[35,1,"みなみ"],[37,1,"ほう"],[47,1,"ひがし"],[49,1,"ほう"],[59,1,"にし"],[61,1,"ほう"]],"text":"一般人の地所の広さは次のとおりである。すなわち北の方四千五百キュビト、南の方四千五百キュビト、東の方四千五百キュビト、西の方四千五百キュビトである。"},{"ref":"Ezek.48.17","start":26048017,"end":26048017,"break":"none","ruby":[[0,1,"まち"],[2,2,"こうがい"],[5,1,"ふく"],[8,2,"こうがい"],[11,1,"きた"],[21,1,"みなみ"],[31,1,"ひがし"],[41,1,"にし"]],"text":"町は郊外を含む。郊外は北二百五十キュビト、南二百五十キュビト、東二百五十キュビト、西二百五十キュビトである。"},{"ref":"Ezek.48.18","start":26048018,"end":26048018,"break":"none","ruby":[[0,1,"せい"],[3,2,"けんのう"],[5,1,"ち"],[7,1,"そ"],[12,1,"のこ"],[15,1,"ち"],[17,1,"なが"],[20,1,"ひがし"],[29,1,"にし"],[44,1,"せい"],[47,2,"けんのう"],[49,1,"ち"],[51,1,"そ"],[59,2,"さんぶつ"],[62,1,"まち"],[64,1,"はたら"],[66,1,"ひと"],[68,2,"しょくもつ"]],"text":"聖なる献納地に沿っている残りの地の長さは東へ一万キュビト、西へ一万キュビトである。これは聖なる献納地に沿っており、その産物は町の働き人の食物となる。"},{"ref":"Ezek.48.19","start":26048019,"end":26048019,"break":"none","ruby":[[0,1,"まち"],[2,1,"はたら"],[4,1,"ひと"],[17,2,"ぶぞく"],[21,1,"で"],[27,2,"こうさく"]],"text":"町の働き人は、イスラエルのすべての部族から出て、これを耕作するのである。"},{"ref":"Ezek.48.20","start":26048020,"end":26048020,"break":"none","ruby":[[10,2,"けんのう"],[12,1,"ち"],[14,2,"ぜんたい"],[25,2,"しほう"],[34,1,"まち"],[36,2,"しょゆう"],[38,1,"ち"],[40,1,"とも"],[42,1,"せい"],[45,2,"けんのう"],[47,1,"ち"]],"text":"あなたがたがささげる献納地の全体は二万五千キュビト四方である。これは町の所有地と共に聖なる献納地である。"},{"ref":"Ezek.48.21","start":26048021,"end":26048021,"break":"paragraph","ruby":[[0,1,"せい"],[3,2,"けんのう"],[5,1,"ち"],[7,1,"まち"],[9,2,"しょゆう"],[11,1,"ち"],[22,1,"のこ"],[25,1,"ち"],[28,1,"きみ"],[31,1,"もの"],[33,1,"ぞく"],[40,1,"せい"],[43,2,"けんのう"],[45,1,"ち"],[56,1,"めん"],[59,1,"ひがし"],[61,1,"さかい"],[63,1,"いた"],[66,1,"にし"],[79,1,"めん"],[82,1,"にし"],[84,1,"さかい"],[86,1,"いた"],[89,2,"ぶぞく"],[92,1,"ぶん"],[94,1,"そ"],[100,1,"きみ"],[103,1,"もの"],[105,1,"ぞく"],[109,1,"せい"],[112,2,"けんのう"],[114,1,"ち"],[117,1,"みや"],[119,2,"せいじょ"],[126,1,"なか"]],"text":"聖なる献納地と町の所有地との、こなたかなたの残りの地は、君たる者に属する。これは聖なる献納地の二万五千キュビトに面して東の境に至り、西はその二万五千キュビトに面して西の境に至り、部族の分に沿うもので、君たる者に属する。聖なる献納地と、宮の聖所とは、その中にある。"},{"ref":"Ezek.48.22","start":26048022,"end":26048022,"break":"none","ruby":[[0,1,"まち"],[2,2,"しょゆう"],[4,1,"ち"],[7,1,"きみ"],[10,1,"もの"],[12,1,"ぞく"],[15,2,"ぶぶん"],[18,1,"なか"],[26,1,"きみ"],[29,1,"もの"],[31,1,"ぶん"],[37,2,"りょうち"],[47,2,"りょうち"],[51,1,"あいだ"]],"text":"町の所有地は、君たる者に属する部分の中にあり、そして君たる者の分は、ユダの領地と、ベニヤミンの領地との間にある。"},{"ref":"Ezek.48.23","start":26048023,"end":26048023,"break":"paragraph","ruby":[[2,1,"のこ"],[5,2,"ぶぞく"],[9,1,"ひがし"],[11,1,"ほう"],[14,1,"にし"],[16,1,"ほう"],[18,1,"いた"],[20,2,"ちほう"],[32,1,"ぶん"]],"text":"なお残りの部族では東の方から西の方に至る地方、これがベニヤミンの分である。"},{"ref":"Ezek.48.24","start":26048024,"end":26048024,"break":"none","ruby":[[6,2,"りょうち"],[9,1,"そ"],[13,1,"ひがし"],[15,1,"ほう"],[18,1,"にし"],[20,1,"ほう"],[22,1,"いた"],[24,2,"ちほう"],[35,1,"ぶん"]],"text":"ベニヤミンの領地に沿って、東の方から西の方に至る地方、これがシメオンの分である。"},{"ref":"Ezek.48.25","start":26048025,"end":26048025,"break":"none","ruby":[[5,2,"りょうち"],[8,1,"そ"],[12,1,"ひがし"],[14,1,"ほう"],[17,1,"にし"],[19,1,"ほう"],[21,1,"いた"],[23,2,"ちほう"],[35,1,"ぶん"]],"text":"シメオンの領地に沿って、東の方から西の方に至る地方、これがイッサカルの分である。"},{"ref":"Ezek.48.26","start":26048026,"end":26048026,"break":"none","ruby":[[6,2,"りょうち"],[9,1,"そ"],[13,1,"ひがし"],[15,1,"ほう"],[18,1,"にし"],[20,1,"ほう"],[22,1,"いた"],[24,2,"ちほう"],[35,1,"ぶん"]],"text":"イッサカルの領地に沿って、東の方から西の方に至る地方、これがゼブルンの分である。"},{"ref":"Ezek.48.27","start":26048027,"end":26048027,"break":"none","ruby":[[5,2,"りょうち"],[8,1,"そ"],[12,1,"ひがし"],[14,1,"ほう"],[17,1,"にし"],[19,1,"ほう"],[21,1,"いた"],[23,2,"ちほう"],[32,1,"ぶん"]],"text":"ゼブルンの領地に沿って、東の方から西の方に至る地方、これがガドの分である。"},{"ref":"Ezek.48.28","start":26048028,"end":26048028,"break":"none","ruby":[[0,1,"みなみ"],[2,1,"ほう"],[7,2,"りょうち"],[10,1,"そ"],[28,1,"みず"],[30,1,"いた"],[42,1,"かわ"],[44,1,"そ"],[47,2,"たいかい"],[50,1,"いた"]],"text":"南の方はガドの領地に沿って、タマルからメリボテ・カデシの水に至り、そこからエジプトの川に沿って大海に至る。"},{"ref":"Ezek.48.29","start":26048029,"end":26048029,"break":"none","ruby":[[22,2,"ぶぞく"],[28,1,"わ"],[32,1,"し"],[33,1,"ぎょう"],[38,1,"ち"],[46,1,"かれ"],[49,1,"ぶん"],[55,1,"しゅ"],[58,1,"かみ"],[60,1,"い"]],"text":"これはあなたがたが、くじをもってイスラエルの部族のうちに分けて、嗣業とすべき地である。これが彼らの分であると、主なる神は言われる。"},{"ref":"Ezek.48.30","start":26048030,"end":26048030,"break":"paragraph","ruby":[[0,1,"まち"],[2,2,"でぐち"],[5,1,"つぎ"],[14,1,"きた"],[16,1,"ほう"],[18,1,"なが"]],"text":"町の出口は次のとおりである。北の方の長さは四千五百キュビトである。"},{"ref":"Ezek.48.31","start":26048031,"end":26048031,"break":"none","ruby":[[0,1,"まち"],[2,1,"もん"],[10,2,"ぶぞく"],[13,1,"な"],[23,1,"もん"],[39,1,"もん"],[44,1,"もん"],[49,1,"もん"]],"text":"町の門はイスラエルの部族の名にしたがい、三つの門になっている。すなわちルベンの門、ユダの門、レビの門である。"},{"ref":"Ezek.48.32","start":26048032,"end":26048032,"break":"none","ruby":[[0,1,"ひがし"],[2,1,"ほう"],[20,1,"もん"],[33,1,"もん"],[41,1,"もん"],[46,1,"もん"]],"text":"東の方は四千五百キュビトであって、三つの門がある。すなわちヨセフの門、ベニヤミンの門、ダンの門である。"},{"ref":"Ezek.48.33","start":26048033,"end":26048033,"break":"none","ruby":[[0,1,"みなみ"],[2,1,"ほう"],[20,1,"もん"],[34,1,"もん"],[42,1,"もん"],[49,1,"もん"]],"text":"南の方は四千五百キュビトであって、三つの門がある。すなわちシメオンの門、イッサカルの門、ゼブルンの門である。"},{"ref":"Ezek.48.34","start":26048034,"end":26048034,"break":"none","ruby":[[0,1,"にし"],[2,1,"ほう"],[20,1,"もん"],[32,1,"もん"],[38,1,"もん"],[45,1,"もん"]],"text":"西の方は四千五百キュビトであって、三つの門がある。すなわちガドの門、アセルの門、ナフタリの門である。"},{"ref":"Ezek.48.35","start":26048035,"end":26048035,"break":"none","ruby":[[0,1,"まち"],[2,2,"しゅうい"],[18,1,"ひ"],[21,1,"のち"],[25,1,"まち"],[27,1,"な"],[30,1,"しゅ"],[39,1,"よ"]],"text":"町の周囲は一万八千キュビトあり、この日から後、この町の名は『主そこにいます』と呼ばれる」。"}]