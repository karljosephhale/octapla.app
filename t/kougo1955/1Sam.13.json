[{"ref":"1Sam.13.1","start":9013001,"end":9013001,"break":"paragraph","ruby":[[6,1,"さい"],[8,1,"おう"],[10,1,"くらい"],[16,1,"ねん"],[23,1,"おさ"]],"text":"サウルは三十歳で王の位につき、二年イスラエルを治めた。"},{"ref":"1Sam.13.2","start":9013002,"end":9013002,"break":"paragraph","ruby":[[16,1,"えら"],[27,1,"とも"],[41,2,"さんち"],[55,1,"とも"],[76,1,"た"],[78,1,"たみ"],[88,2,"てんまく"],[91,1,"かえ"]],"text":"さてサウルはイスラエルびと三千を選んだ。二千はサウルと共にミクマシ、およびベテルの山地におり、一千はヨナタンと共にベニヤミンのギベアにいた。サウルはその他の民を、おのおの、その天幕に帰らせた。"},{"ref":"1Sam.13.3","start":9013003,"end":9013003,"break":"none","ruby":[[18,2,"しゅび"],[20,1,"へい"],[22,1,"やぶ"],[38,1,"き"],[50,2,"くにぢゅう"],[58,2,"つのぶえ"],[61,1,"ふ"],[67,1,"い"],[80,1,"き"]],"text":"ヨナタンは、ゲバにあるペリシテびとの守備兵を敗った。ペリシテびとはそのことを聞いた。そこで、サウルは国中に、あまねく角笛を吹きならして言わせた、「ヘブルびとよ、聞け」。"},{"ref":"1Sam.13.4","start":9013004,"end":9013004,"break":"none","ruby":[[6,1,"ひと"],[8,1,"みな"],[21,2,"しゅび"],[23,1,"へい"],[25,1,"やぶ"],[47,1,"にく"],[60,1,"き"],[68,1,"たみ"],[70,1,"め"],[87,1,"あつ"]],"text":"イスラエルの人は皆、サウルがペリシテびとの守備兵を敗ったこと、そしてイスラエルがペリシテびとに憎まれるようになったことを聞いた。こうして民は召されて、ギルガルのサウルのもとに集まった。"},{"ref":"1Sam.13.5","start":9013005,"end":9013005,"break":"paragraph","ruby":[[13,1,"たたか"],[18,1,"あつ"],[23,2,"せんしゃ"],[28,2,"きへい"],[33,1,"たみ"],[35,1,"はま"],[38,1,"すな"],[43,1,"おお"],[48,1,"かれ"],[51,1,"のぼ"],[63,1,"ひがし"],[70,1,"じん"],[72,1,"は"]],"text":"ペリシテびとはイスラエルと戦うために集まった。戦車三千、騎兵六千、民は浜べの砂のように多かった。彼らは上ってきて、ベテアベンの東のミクマシに陣を張った。"},{"ref":"1Sam.13.6","start":9013006,"end":9013006,"break":"none","ruby":[[12,2,"あっぱく"],[17,2,"みかた"],[20,1,"あやう"],[27,1,"み"],[32,1,"あな"],[35,2,"たてあな"],[39,1,"いわ"],[42,1,"はか"],[47,1,"いけ"],[49,1,"み"],[51,1,"かく"]],"text":"イスラエルびとは、ひどく圧迫され、味方が危くなったのを見て、ほら穴に、縦穴に、岩に、墓に、ため池に身を隠した。"},{"ref":"1Sam.13.7","start":9013007,"end":9013007,"break":"none","ruby":[[16,1,"わた"],[28,1,"ち"],[30,1,"い"],[51,1,"たみ"],[62,1,"かれ"],[64,1,"したが"]],"text":"また、あるヘブルびとはヨルダンを渡って、ガドとギレアデの地へ行った。しかしサウルはなおギルガルにいて、民はみな、ふるえながら彼に従った。"},{"ref":"1Sam.13.8","start":9013008,"end":9013008,"break":"paragraph","ruby":[[10,1,"さだ"],[17,2,"なぬか"],[23,1,"ま"],[46,1,"たみ"],[48,1,"かれ"],[50,1,"はな"],[53,1,"ち"],[56,1,"い"]],"text":"サウルは、サムエルが定めたように、七日のあいだ待ったが、サムエルがギルガルにこなかったので、民は彼を離れて散って行った。"},{"ref":"1Sam.13.9","start":9013009,"end":9013009,"break":"none","ruby":[[7,1,"い"],[12,2,"はんさい"],[15,3,"しゅうおんさい"],[23,1,"ところ"],[25,1,"も"],[38,1,"かれ"],[40,2,"はんさい"]],"text":"そこでサウルは言った、「燔祭と酬恩祭をわたしの所に持ってきなさい」。こうして彼は燔祭をささげた。"},{"ref":"1Sam.13.10","start":9013010,"end":9013010,"break":"none","ruby":[[2,2,"はんさい"],[8,1,"おわ"],[34,1,"かれ"],[36,1,"むか"],[39,1,"で"]],"text":"その燔祭をささげ終ると、サムエルがきた。サウルはあいさつをしようと、彼を迎えに出た。"},{"ref":"1Sam.13.11","start":9013011,"end":9013011,"break":"none","ruby":[[2,1,"とき"],[8,1,"い"],[17,1,"なに"],[31,1,"い"],[36,1,"たみ"],[42,1,"はな"],[45,1,"ち"],[48,1,"い"],[55,1,"さだ"],[59,1,"ひ"],[84,1,"あつ"],[90,1,"み"]],"text":"その時サムエルは言った、「あなたは何をしたのですか」。サウルは言った、「民はわたしを離れて散って行き、あなたは定まった日のうちにこられないのに、ペリシテびとがミクマシに集まったのを見たので、"},{"ref":"1Sam.13.12","start":9013012,"end":9013012,"break":"none","ruby":[[12,1,"いま"],[21,1,"くだ"],[31,1,"おそ"],[35,1,"し"],[48,1,"しゅ"],[50,1,"めぐ"],[53,1,"もと"],[65,1,"おも"],[71,1,"え"],[73,2,"はんさい"]],"text":"わたしは、ペリシテびとが今にも、ギルガルに下ってきて、わたしを襲うかも知れないのに、わたしはまだ主の恵みを求めることをしていないと思い、やむを得ず燔祭をささげました」。"},{"ref":"1Sam.13.13","start":9013013,"end":9013013,"break":"none","ruby":[[9,1,"い"],[18,1,"おろ"],[36,1,"かみ"],[38,1,"しゅ"],[40,1,"めい"],[45,2,"めいれい"],[48,1,"まも"],[57,1,"まも"],[64,1,"しゅ"],[66,1,"いま"],[71,2,"おうこく"],[74,1,"なが"],[82,1,"うえ"],[84,2,"かくほ"]],"text":"サムエルはサウルに言った、「あなたは愚かなことをした。あなたは、あなたの神、主の命じられた命令を守らなかった。もし守ったならば、主は今あなたの王国を長くイスラエルの上に確保されたであろう。"},{"ref":"1Sam.13.14","start":9013014,"end":9013014,"break":"none","ruby":[[3,1,"いま"],[10,2,"おうこく"],[13,1,"つづ"],[22,1,"しゅ"],[24,2,"じぶん"],[27,1,"こころ"],[32,1,"ひと"],[34,1,"もと"],[40,1,"ひと"],[42,1,"たみ"],[44,1,"きみ"],[51,1,"めい"],[61,1,"しゅ"],[63,1,"めい"],[68,1,"こと"],[70,1,"まも"]],"text":"しかし今は、あなたの王国は続かないであろう。主は自分の心にかなう人を求めて、その人に民の君となることを命じられた。あなたが主の命じられた事を守らなかったからである」。"},{"ref":"1Sam.13.15","start":9013015,"end":9013015,"break":"none","breaks":[[36,"paragraph"]],"ruby":[[9,1,"た"],[29,1,"のぼ"],[40,1,"とも"],[44,1,"たみ"],[46,1,"かぞ"],[59,1,"にん"]],"text":"こうしてサムエルは立って、ギルガルからベニヤミンのギベアに上っていった。サウルは共にいる民を数えてみたが、おおよそ六百人あった。"},{"ref":"1Sam.13.16","start":9013016,"end":9013016,"break":"none","ruby":[[6,1,"こ"],[17,1,"とも"],[21,1,"たみ"],[48,1,"じん"],[50,1,"は"]],"text":"サウルとその子ヨナタン、ならびに、共にいる民は、ベニヤミンのゲバにおり、ペリシテびとはミクマシに陣を張っていた。"},{"ref":"1Sam.13.17","start":9013017,"end":9013017,"break":"none","ruby":[[10,1,"じん"],[16,2,"ぶたい"],[23,2,"りゃくだつ"],[25,1,"たい"],[27,1,"で"],[33,1,"ぶ"],[34,1,"たい"],[40,1,"ほう"],[42,1,"む"],[52,1,"ち"],[54,1,"い"]],"text":"そしてペリシテびとの陣から三つの部隊にわかれた略奪隊が出てきて、一部隊はオフラの方に向かって、シュアルの地に行き、"},{"ref":"1Sam.13.18","start":9013018,"end":9013018,"break":"none","ruby":[[1,1,"ぶ"],[2,1,"たい"],[10,1,"ほう"],[12,1,"む"],[17,1,"ぶ"],[18,1,"たい"],[20,2,"あらの"],[23,1,"ほう"],[30,1,"たに"],[32,1,"み"],[36,1,"さかい"],[38,1,"ほう"],[40,1,"む"]],"text":"一部隊はベテホロンの方に向かい、一部隊は荒野の方のゼボイムの谷を見おろす境の方に向かった。"},{"ref":"1Sam.13.19","start":9013019,"end":9013019,"break":"paragraph","ruby":[[11,1,"ち"],[18,2,"てっこう"],[49,1,"つく"],[59,1,"い"]],"text":"そのころ、イスラエルの地にはどこにも鉄工がいなかった。ペリシテびとが「ヘブルびとはつるぎも、やりも造ってはならない」と言ったからである。"},{"ref":"1Sam.13.20","start":9013020,"end":9013020,"break":"none","ruby":[[9,1,"ひと"],[11,1,"みな"],[29,1,"は"],[45,1,"ところ"],[47,1,"くだ"],[50,1,"い"]],"text":"ただしイスラエルの人は皆、そのすきざき、くわ、おの、かまに刃をつけるときは、ペリシテびとの所へ下って行った。"},{"ref":"1Sam.13.21","start":9013021,"end":9013021,"break":"none","ruby":[[12,2,"りょうきん"],[25,1,"は"],[41,1,"なお"],[46,1,"ぶん"]],"text":"すきざきと、くわのための料金は一ピムであり、おのに刃をつけるのと、とげのあるむちを直すのは三分の一シケルであった。"},{"ref":"1Sam.13.22","start":9013022,"end":9013022,"break":"none","ruby":[[5,1,"たたか"],[8,1,"ひ"],[23,1,"とも"],[27,1,"たみ"],[29,1,"て"],[51,1,"こ"],[61,1,"も"]],"text":"それでこの戦いの日には、サウルおよびヨナタンと共にいた民の手には、つるぎもやりもなく、ただサウルとその子ヨナタンとがそれを持っていた。"},{"ref":"1Sam.13.23","start":9013023,"end":9013023,"break":"none","ruby":[[7,2,"せんじん"],[15,1,"わた"],[18,1,"すす"],[20,1,"で"]],"text":"ペリシテびとの先陣はミクマシの渡りに進み出た。"}]