[{"ref":"Num.31.1","start":4031001,"end":4031001,"break":"paragraph","ruby":[[2,1,"しゅ"],[8,1,"い"]],"text":"さて主はモーセに言われた、"},{"ref":"Num.31.2","start":4031002,"end":4031002,"break":"none","ruby":[[14,2,"ひとびと"],[20,1,"むく"],[28,1,"のち"],[38,1,"たみ"],[40,1,"くわ"]],"text":"「ミデアンびとにイスラエルの人々のあだを報いなさい。その後、あなたはあなたの民に加えられるであろう」。"},{"ref":"Num.31.3","start":4031003,"end":4031003,"break":"none","ruby":[[4,1,"たみ"],[6,1,"い"],[21,1,"ひと"],[23,1,"えら"],[26,1,"たたか"],[32,2,"ぶそう"],[44,1,"せ"],[48,1,"しゅ"],[59,2,"ふくしゅう"]],"text":"モーセは民に言った、「あなたがたのうちから人を選んで戦いのために武装させ、ミデアンびとを攻めて、主のためミデアンびとに復讐しなさい。"},{"ref":"Num.31.4","start":4031004,"end":4031004,"break":"none","ruby":[[14,2,"ぶぞく"],[19,2,"ぶぞく"],[25,1,"にん"],[29,1,"たたか"],[32,1,"おく"],[34,1,"だ"]],"text":"すなわちイスラエルのすべての部族から、部族ごとに千人ずつを戦いに送り出さなければならない」。"},{"ref":"Num.31.5","start":4031005,"end":4031005,"break":"none","ruby":[[9,2,"ぶぞく"],[16,2,"ぶぞく"],[22,1,"にん"],[26,1,"えら"],[33,1,"にん"],[35,1,"え"],[38,1,"たたか"],[44,2,"ぶそう"]],"text":"そこでイスラエルの部族のうちから部族ごとに千人ずつを選び、一万二千人を得て、戦いのために武装させた。"},{"ref":"Num.31.6","start":4031006,"end":4031006,"break":"none","ruby":[[4,1,"かく"],[5,2,"ぶぞく"],[10,1,"にん"],[14,1,"たたか"],[24,2,"さいし"],[32,1,"こ"],[39,1,"せい"],[42,1,"うつわ"],[44,1,"ふ"],[46,1,"な"],[54,1,"と"],[59,1,"とも"],[61,1,"たたか"]],"text":"モーセは各部族から千人ずつを戦いにつかわし、また祭司エレアザルの子ピネハスに、聖なる器と吹き鳴らすラッパとを執らせて、共に戦いにつかわした。"},{"ref":"Num.31.7","start":4031007,"end":4031007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"しゅ"],[9,1,"めい"],[24,1,"たたか"],[30,2,"だんし"],[35,1,"ころ"]],"text":"彼らは主がモーセに命じられたようにミデアンびとと戦って、その男子をみな殺した。"},{"ref":"Num.31.8","start":4031008,"end":4031008,"break":"none","ruby":[[2,1,"ころ"],[5,1,"もの"],[17,1,"おう"],[19,1,"にん"],[21,1,"ころ"],[27,1,"な"],[54,1,"こ"],[68,1,"ころ"]],"text":"その殺した者のほかにまたミデアンの王五人を殺した。その名はエビ、レケム、ツル、フル、レバである。またベオルの子バラムをも、つるぎにかけて殺した。"},{"ref":"Num.31.9","start":4031009,"end":4031009,"break":"none","ruby":[[8,2,"ひとびと"],[16,1,"おんな"],[22,1,"こ"],[23,1,"とも"],[27,2,"ほりょ"],[34,2,"かちく"],[38,1,"ひつじ"],[40,1,"む"],[44,1,"か"],[45,1,"ざい"],[53,1,"うば"],[55,1,"と"]],"text":"またイスラエルの人々はミデアンの女たちとその子供たちを捕虜にし、その家畜と、羊の群れと、貨財とをことごとく奪い取り、"},{"ref":"Num.31.10","start":4031010,"end":4031010,"break":"none","ruby":[[8,2,"まちまち"],[14,2,"ぶらく"],[24,1,"ひ"],[26,1,"や"]],"text":"そのすまいのある町々と、その部落とを、ことごとく火で焼いた。"},{"ref":"Num.31.11","start":4031011,"end":4031011,"break":"none","ruby":[[4,1,"かれ"],[10,1,"うば"],[25,1,"ひと"],[28,2,"かちく"],[32,1,"と"]],"text":"こうして彼らはすべて奪ったものと、かすめたものとは人をも家畜をも取り、"},{"ref":"Num.31.12","start":4031012,"end":4031012,"break":"none","ruby":[[2,1,"なま"],[7,1,"もの"],[18,1,"うば"],[25,1,"たずさ"],[33,1,"ちか"],[48,2,"へいや"],[51,2,"しゅくえい"],[60,2,"さいし"],[74,2,"ひとびと"],[77,2,"かいしゅう"]],"text":"その生けどった者と、かすめたものと、奪ったものとを携えて、エリコに近いヨルダンのほとりのモアブの平野の宿営におるモーセと祭司エレアザルとイスラエルの人々の会衆のもとへもどってきた。"},{"ref":"Num.31.13","start":4031013,"end":4031013,"break":"paragraph","ruby":[[7,2,"さいし"],[15,2,"かいしゅう"],[26,2,"しゅくえい"],[29,1,"そと"],[31,1,"で"],[33,1,"むか"]],"text":"ときにモーセと祭司エレアザルと会衆のつかさたちはみな宿営の外に出て迎えたが、"},{"ref":"Num.31.14","start":4031014,"end":4031014,"break":"none","ruby":[[4,2,"ぐんぜい"],[7,1,"しょう"],[15,2,"せんじょう"],[19,1,"かえ"],[25,1,"にん"],[27,1,"ちょう"],[33,1,"にん"],[35,1,"ちょう"],[39,1,"たい"],[42,1,"いか"]],"text":"モーセは軍勢の将たち、すなわち戦場から帰ってきた千人の長たちと、百人の長たちに対して怒った。"},{"ref":"Num.31.15","start":4031015,"end":4031015,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[18,1,"おんな"],[24,1,"い"]],"text":"モーセは彼らに言った、「あなたがたは女たちをみな生かしておいたのか。"},{"ref":"Num.31.16","start":4031016,"end":4031016,"break":"none","ruby":[[0,1,"かれ"],[23,2,"ひとびと"],[34,1,"しゅ"],[36,1,"つみ"],[38,1,"おか"],[45,1,"しゅ"],[47,2,"かいしゅう"],[53,2,"えきびょう"],[56,1,"おこ"],[59,1,"いた"]],"text":"彼らはバラムのはかりごとによって、イスラエルの人々に、ペオルのことで主に罪を犯させ、ついに主の会衆のうちに疫病を起すに至った。"},{"ref":"Num.31.17","start":4031017,"end":4031017,"break":"none","ruby":[[3,1,"いま"],[7,2,"こども"],[15,1,"おとこ"],[17,1,"こ"],[21,1,"ころ"],[26,1,"おとこ"],[28,1,"ね"],[31,1,"おとこ"],[33,1,"し"],[36,1,"おんな"],[40,1,"ころ"]],"text":"それで今、この子供たちのうちの男の子をみな殺し、また男と寝て、男を知った女をみな殺しなさい。"},{"ref":"Num.31.18","start":4031018,"end":4031018,"break":"none","ruby":[[6,1,"おとこ"],[8,1,"ね"],[11,1,"おとこ"],[13,1,"し"],[17,1,"むすめ"],[31,1,"い"]],"text":"ただし、まだ男と寝ず、男を知らない娘はすべてあなたがたのために生かしておきなさい。"},{"ref":"Num.31.19","start":4031019,"end":4031019,"break":"none","ruby":[[9,2,"なぬか"],[15,2,"しゅくえい"],[18,1,"そと"],[39,1,"ひと"],[41,1,"ころ"],[44,1,"もの"],[52,1,"ころ"],[56,1,"もの"],[58,1,"ふ"],[61,1,"もの"],[69,2,"じしん"],[79,2,"ほりょ"],[82,1,"とも"],[86,1,"か"],[87,1,"め"],[89,2,"なぬか"],[91,1,"め"],[94,1,"み"],[96,1,"きよ"]],"text":"そしてあなたがたは七日のあいだ宿営の外にとどまりなさい。あなたがたのうちすべて人を殺した者、およびすべて殺された者に触れた者は、あなたがた自身も、あなたがたの捕虜も共に、三日目と七日目とに身を清めなければならない。"},{"ref":"Num.31.20","start":4031020,"end":4031020,"break":"none","ruby":[[6,2,"いふく"],[14,1,"かわ"],[16,1,"うつわ"],[25,1,"け"],[27,1,"つく"],[38,1,"き"],[40,1,"うつわ"],[43,1,"きよ"]],"text":"またすべての衣服と、すべての皮の器と、すべてやぎの毛で作ったものと、すべての木の器とを清めなければならない」。"},{"ref":"Num.31.21","start":4031021,"end":4031021,"break":"paragraph","ruby":[[0,2,"さいし"],[8,1,"たたか"],[11,1,"で"],[21,1,"い"],[29,1,"しゅ"],[35,1,"めい"],[40,2,"りっぽう"],[43,1,"さだ"]],"text":"祭司エレアザルは戦いに出たいくさびとたちに言った、「これは主がモーセに命じられた律法の定めである。"},{"ref":"Num.31.22","start":4031022,"end":4031022,"break":"none","ruby":[[0,1,"きん"],[2,1,"ぎん"],[4,2,"せいどう"],[7,1,"てつ"],[12,1,"なまり"]],"text":"金、銀、青銅、鉄、すず、鉛など、"},{"ref":"Num.31.23","start":4031023,"end":4031023,"break":"none","ruby":[[3,1,"ひ"],[5,1,"た"],[8,1,"もの"],[10,1,"ひ"],[12,1,"なか"],[14,1,"とお"],[30,1,"きよ"],[43,1,"うえ"],[45,1,"けが"],[48,1,"きよ"],[51,1,"みず"],[54,1,"きよ"],[72,1,"ひ"],[74,1,"た"],[81,1,"みず"],[83,1,"なか"],[85,1,"とお"]],"text":"すべて火に耐える物は火の中を通さなければならない。そうすれば清くなるであろう。なおその上、汚れを清める水で、清めなければならない。しかし、すべて火に耐えないものは水の中を通さなければならない。"},{"ref":"Num.31.24","start":4031024,"end":4031024,"break":"none","ruby":[[6,2,"なぬか"],[8,1,"め"],[10,2,"いふく"],[13,1,"あら"],[27,1,"きよ"],[34,1,"のち"],[35,2,"しゅくえい"]],"text":"あなたがたは七日目に衣服を洗わなければならない。そして清くなり、その後宿営にはいることができる」。"},{"ref":"Num.31.25","start":4031025,"end":4031025,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.31.26","start":4031026,"end":4031026,"break":"none","ruby":[[5,2,"さいし"],[15,2,"かいしゅう"],[18,2,"しぞく"],[30,1,"なま"],[35,1,"ひと"],[37,2,"かちく"],[40,2,"えもの"],[43,2,"そうすう"],[46,1,"しら"]],"text":"「あなたと祭司エレアザルおよび会衆の氏族のかしらたちは、その生けどった人と家畜の獲物の総数を調べ、"},{"ref":"Num.31.27","start":4031027,"end":4031027,"break":"none","ruby":[[2,2,"えもの"],[5,1,"たたか"],[8,1,"で"],[10,2,"ゆうし"],[14,1,"ぜん"],[15,2,"かいしゅう"],[19,2,"せっぱん"]],"text":"その獲物を戦いに出た勇士と、全会衆とに折半しなさい。"},{"ref":"Num.31.28","start":4031028,"end":4031028,"break":"none","ruby":[[3,1,"たたか"],[6,1,"で"],[15,1,"ひと"],[19,1,"うし"],[30,1,"ひつじ"],[45,1,"と"],[54,1,"しゅ"]],"text":"そして戦いに出たいくさびとに、人または牛、またはろば、または羊を、おのおの五百ごとに一つを取り、みつぎとして主にささげさせなさい。"},{"ref":"Num.31.29","start":4031029,"end":4031029,"break":"none","ruby":[[4,1,"かれ"],[7,1,"う"],[10,2,"はんぶん"],[21,1,"と"],[24,1,"しゅ"],[30,1,"もの"],[34,2,"さいし"],[42,1,"わた"]],"text":"すなわち彼らが受ける半分のなかから、それを取り、主にささげる物として祭司エレアザルに渡しなさい。"},{"ref":"Num.31.30","start":4031030,"end":4031030,"break":"none","ruby":[[8,2,"ひとびと"],[11,1,"う"],[14,2,"はんぶん"],[24,1,"え"],[26,1,"ひと"],[30,1,"うし"],[41,1,"ひつじ"],[45,2,"かちく"],[61,1,"と"],[64,1,"しゅ"],[66,2,"まくや"],[69,1,"つとめ"],[78,1,"あた"]],"text":"またイスラエルの人々が受ける半分のなかから、その獲た人または牛、またはろば、または羊などの家畜を、おのおの五十ごとに一つを取り、主の幕屋の務をするレビびとに与えなさい」。"},{"ref":"Num.31.31","start":4031031,"end":4031031,"break":"none","ruby":[[4,2,"さいし"],[13,1,"しゅ"],[19,1,"めい"],[28,1,"い"]],"text":"モーセと祭司エレアザルとは主がモーセに命じられたとおりに行った。"},{"ref":"Num.31.32","start":4031032,"end":4031032,"break":"paragraph","ruby":[[5,2,"えもの"],[21,1,"うば"],[23,1,"と"],[29,1,"のこ"],[32,1,"ひつじ"]],"text":"そこでその獲物、すなわち、いくさびとたちが奪い取ったものの残りは羊六十七万五千、"},{"ref":"Num.31.33","start":4031033,"end":4031033,"break":"none","ruby":[[0,1,"うし"]],"text":"牛七万二千、"},{"ref":"Num.31.34","start":4031034,"end":4031034,"break":"none","text":"ろば六万一千、"},{"ref":"Num.31.35","start":4031035,"end":4031035,"break":"none","ruby":[[0,1,"ひと"],[11,1,"おとこ"],[13,1,"ね"],[16,1,"おとこ"],[18,1,"し"],[22,1,"おんな"]],"text":"人三万二千、これはみな男と寝ず、男を知らない女であった。"},{"ref":"Num.31.36","start":4031036,"end":4031036,"break":"none","ruby":[[5,2,"はんぶん"],[12,1,"たたか"],[15,1,"で"],[17,1,"もの"],[19,1,"ぶん"],[21,1,"ひつじ"]],"text":"そしてその半分、すなわち戦いに出た者の分は羊三十三万七千五百、"},{"ref":"Num.31.37","start":4031037,"end":4031037,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"ひつじ"]],"text":"主にみつぎとした羊は六百七十五。"},{"ref":"Num.31.38","start":4031038,"end":4031038,"break":"none","ruby":[[0,1,"うし"],[13,1,"しゅ"]],"text":"牛は三万六千、そのうちから主にみつぎとしたものは七十二。"},{"ref":"Num.31.39","start":4031039,"end":4031039,"break":"none","ruby":[[14,1,"しゅ"]],"text":"ろばは三万五百、そのうちから主にみつぎとしたものは六十一。"},{"ref":"Num.31.40","start":4031040,"end":4031040,"break":"none","ruby":[[0,1,"ひと"],[13,1,"しゅ"],[27,1,"にん"]],"text":"人は一万六千、そのうちから主にみつぎとしたものは三十二人であった。"},{"ref":"Num.31.41","start":4031041,"end":4031041,"break":"none","ruby":[[10,1,"しゅ"],[16,1,"もの"],[20,2,"さいし"],[28,1,"わた"],[32,1,"しゅ"],[38,1,"めい"]],"text":"モーセはそのみつぎを主にささげる物として祭司エレアザルに渡した。主がモーセに命じられたとおりである。"},{"ref":"Num.31.42","start":4031042,"end":4031042,"break":"paragraph","ruby":[[4,1,"たたか"],[7,1,"で"],[9,2,"ひとびと"],[13,1,"べつ"],[21,2,"ひとびと"],[24,1,"あた"],[27,2,"はんぶん"]],"text":"モーセが戦いに出た人々とは別にイスラエルの人々に与えた半分、"},{"ref":"Num.31.43","start":4031043,"end":4031043,"break":"none","ruby":[[4,2,"かいしゅう"],[7,1,"う"],[10,2,"はんぶん"],[13,1,"ひつじ"]],"text":"すなわち会衆の受けた半分は羊三十三万七千五百、"},{"ref":"Num.31.44","start":4031044,"end":4031044,"break":"none","ruby":[[0,1,"うし"]],"text":"牛三万六千、"},{"ref":"Num.31.45","start":4031045,"end":4031045,"break":"none","text":"ろば三万五百、"},{"ref":"Num.31.46","start":4031046,"end":4031046,"break":"none","ruby":[[0,1,"ひと"]],"text":"人一万六千であって、"},{"ref":"Num.31.47","start":4031047,"end":4031047,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"う"],[16,2,"はんぶん"],[24,1,"ひと"],[28,1,"けもの"],[42,1,"と"],[46,1,"しゅ"],[48,2,"まくや"],[51,1,"つとめ"],[60,1,"あた"],[64,1,"しゅ"],[70,1,"めい"]],"text":"モーセはイスラエルの人々の受けた半分のなかから、人および獣をおのおの五十ごとに一つを取って、主の幕屋の務をするレビびとに与えた。主がモーセに命じられたとおりである。"},{"ref":"Num.31.48","start":4031048,"end":4031048,"break":"paragraph","ruby":[[0,1,"とき"],[2,2,"ぐんぜい"],[5,1,"しょう"],[20,1,"にん"],[22,1,"ちょう"],[27,1,"にん"],[29,1,"ちょう"]],"text":"時に軍勢の将であったものども、すなわち千人の長たちと百人の長たちとがモーセのところにきて、"},{"ref":"Num.31.49","start":4031049,"end":4031049,"break":"none","ruby":[[4,1,"い"],[15,2,"しき"],[17,1,"か"],[25,1,"かぞ"],[44,1,"か"],[47,1,"もの"]],"text":"モーセに言った、「しもべらは、指揮下のいくさびとを数えましたが、われわれのうち、ひとりも欠けた者はありませんでした。"},{"ref":"Num.31.50","start":4031050,"end":4031050,"break":"none","ruby":[[14,1,"て"],[16,1,"い"],[19,1,"きん"],[21,1,"かざ"],[23,1,"もの"],[29,1,"うで"],[30,1,"かざ"],[33,2,"うでわ"],[36,2,"ゆびわ"],[39,2,"みみわ"],[42,2,"くびかざ"],[48,1,"しゅ"],[50,1,"たずさ"],[55,1,"そな"],[57,1,"もの"],[61,1,"しゅ"],[63,1,"まえ"],[70,1,"いのち"],[81,1,"おも"]],"text":"それで、われわれは、おのおの手に入れた金の飾り物、すなわち腕飾り、腕輪、指輪、耳輪、首飾りなどを主に携えてきて供え物とし、主の前にわれわれの命のあがないをしようと思います」。"},{"ref":"Num.31.51","start":4031051,"end":4031051,"break":"none","ruby":[[4,2,"さいし"],[14,1,"かれ"],[18,2,"さいく"],[21,1,"ほどこ"],[24,1,"きん"],[26,1,"かざ"],[28,1,"もの"],[30,1,"う"],[32,1,"と"]],"text":"モーセと祭司エレアザルとは、彼らから細工を施した金の飾り物を受け取った。"},{"ref":"Num.31.52","start":4031052,"end":4031052,"break":"none","ruby":[[1,1,"にん"],[3,1,"ちょう"],[8,1,"にん"],[10,1,"ちょう"],[16,1,"しゅ"],[26,1,"きん"],[28,1,"あ"]],"text":"千人の長たちと百人の長たちとが、主にささげものとした金は合わせて一万六千七百五十シケル。"},{"ref":"Num.31.53","start":4031053,"end":4031053,"break":"none","ruby":[[11,2,"じぶん"],[18,1,"もの"],[20,1,"え"]],"text":"いくさびとは、おのおの自分のぶんどり物を獲た。"},{"ref":"Num.31.54","start":4031054,"end":4031054,"break":"none","ruby":[[4,2,"さいし"],[15,1,"にん"],[17,1,"ちょう"],[22,1,"にん"],[24,1,"ちょう"],[33,1,"きん"],[35,1,"う"],[37,1,"と"],[43,1,"たずさ"],[46,2,"かいけん"],[49,2,"まくや"],[52,1,"い"],[55,1,"しゅ"],[57,1,"まえ"],[59,1,"お"],[68,2,"ひとびと"],[74,2,"きねん"]],"text":"モーセと祭司エレアザルとは、千人の長たちと百人の長たちとから、その金を受け取り、それを携えて会見の幕屋に入り、主の前に置いてイスラエルの人々のために記念とした。"}]