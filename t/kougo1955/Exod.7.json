[{"ref":"Exod.7.1","start":2007001,"end":2007001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"み"],[26,1,"たい"],[29,1,"かみ"],[44,2,"きょうだい"],[54,3,"よげんしゃ"]],"text":"主はモーセに言われた、「見よ、わたしはあなたをパロに対して神のごときものとする。あなたの兄弟アロンはあなたの預言者となるであろう。"},{"ref":"Exod.7.2","start":2007002,"end":2007002,"break":"none","ruby":[[8,1,"めい"],[20,1,"かれ"],[22,1,"つ"],[40,2,"きょうだい"],[49,1,"つ"],[59,2,"ひとびと"],[64,1,"くに"],[67,1,"さ"]],"text":"あなたはわたしが命じることを、ことごとく彼に告げなければならない。そしてあなたの兄弟アロンはパロに告げて、イスラエルの人々をその国から去らせるようにさせなければならない。"},{"ref":"Exod.7.3","start":2007003,"end":2007003,"break":"none","ruby":[[11,1,"こころ"],[31,3,"ふしぎ"],[40,1,"くに"],[42,1,"おお"],[44,1,"おこな"]],"text":"しかし、わたしはパロの心をかたくなにするので、わたしのしるしと不思議をエジプトの国に多く行っても、"},{"ref":"Exod.7.4","start":2007004,"end":2007004,"break":"none","ruby":[[9,1,"い"],[14,1,"き"],[30,1,"て"],[37,1,"うえ"],[39,1,"くわ"],[42,1,"おお"],[59,2,"ぐんだん"],[66,1,"たみ"],[73,2,"ひとびと"],[82,1,"くに"],[85,1,"みちび"],[87,1,"だ"]],"text":"パロはあなたがたの言うことを聞かないであろう。それでわたしは手をエジプトの上に加え、大いなるさばきをくだして、わたしの軍団、わたしの民イスラエルの人々を、エジプトの国から導き出すであろう。"},{"ref":"Exod.7.5","start":2007005,"end":2007005,"break":"none","ruby":[[4,1,"て"],[11,1,"うえ"],[15,1,"の"],[25,2,"ひとびと"],[28,1,"かれ"],[35,1,"みちび"],[37,1,"だ"],[39,1,"とき"],[52,1,"しゅ"],[59,1,"し"]],"text":"わたしが手をエジプトの上にさし伸べて、イスラエルの人々を彼らのうちから導き出す時、エジプトびとはわたしが主であることを知るようになるであろう」。"},{"ref":"Exod.7.6","start":2007006,"end":2007006,"break":"none","ruby":[[13,1,"おこな"],[21,1,"しゅ"],[23,1,"かれ"],[26,1,"めい"],[34,1,"おこな"]],"text":"モーセとアロンはそのように行った。すなわち主が彼らに命じられたように行った。"},{"ref":"Exod.7.7","start":2007007,"end":2007007,"break":"none","ruby":[[0,1,"かれ"],[6,1,"かた"],[9,1,"とき"],[17,1,"さい"],[26,1,"さい"]],"text":"彼らがパロと語った時、モーセは八十歳、アロンは八十三歳であった。"},{"ref":"Exod.7.8","start":2007008,"end":2007008,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"い"]],"text":"主はモーセとアロンに言われた、"},{"ref":"Exod.7.9","start":2007009,"end":2007009,"break":"none","ruby":[[12,3,"ふしぎ"],[21,2,"しょうこ"],[24,1,"しめ"],[28,1,"い"],[30,1,"とき"],[40,1,"い"],[54,1,"と"],[61,1,"まえ"],[63,1,"な"]],"text":"「パロがあなたがたに、『不思議をおこなって証拠を示せ』と言う時、あなたはアロンに言いなさい、『あなたのつえを取って、パロの前に投げなさい』と。するとそれはへびになるであろう」。"},{"ref":"Exod.7.10","start":2007010,"end":2007010,"break":"none","ruby":[[19,1,"い"],[22,1,"しゅ"],[24,1,"めい"],[58,2,"けらい"],[63,1,"まえ"],[65,1,"な"]],"text":"それで、モーセとアロンはパロのところに行き、主の命じられたとおりにおこなった。すなわちアロンはそのつえを、パロとその家来たちの前に投げると、それはへびになった。"},{"ref":"Exod.7.11","start":2007011,"end":2007011,"break":"none","ruby":[[8,2,"ちしゃ"],[11,3,"まほうつかい"],[15,1,"め"],[17,1,"よ"],[30,2,"まじゅつ"],[32,1,"し"],[40,2,"ひじゅつ"],[46,1,"おな"],[51,1,"おこな"]],"text":"そこでパロもまた知者と魔法使を召し寄せた。これらのエジプトの魔術師らもまた、その秘術をもって同じように行った。"},{"ref":"Exod.7.12","start":2007012,"end":2007012,"break":"none","ruby":[[4,1,"かれ"],[17,1,"な"],[44,1,"かれ"]],"text":"すなわち彼らは、おのおのそのつえを投げたが、それらはへびになった。しかし、アロンのつえは彼らのつえを、のみつくした。"},{"ref":"Exod.7.13","start":2007013,"end":2007013,"break":"none","ruby":[[8,1,"こころ"],[19,1,"しゅ"],[21,1,"い"],[29,1,"かれ"],[32,1,"い"],[37,1,"き"]],"text":"けれども、パロの心はかたくなになって、主の言われたように、彼らの言うことを聞かなかった。"},{"ref":"Exod.7.14","start":2007014,"end":2007014,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[15,1,"こころ"],[23,1,"かれ"],[25,1,"たみ"],[27,1,"さ"],[34,1,"こば"]],"text":"主はモーセに言われた、「パロの心はかたくなで、彼は民を去らせることを拒んでいる。"},{"ref":"Exod.7.15","start":2007015,"end":2007015,"break":"none","ruby":[[8,1,"あさ"],[17,1,"い"],[23,1,"み"],[26,1,"かれ"],[28,1,"みず"],[34,1,"で"],[47,1,"かわ"],[55,1,"て"],[57,1,"と"],[63,1,"かわ"],[65,1,"きし"],[67,1,"た"],[70,1,"かれ"],[72,1,"あ"]],"text":"あなたは、あすの朝、パロのところに行きなさい。見よ、彼は水のところに出ている。あなたは、へびに変ったあのつえを手に執り、ナイル川の岸に立って彼に会い、"},{"ref":"Exod.7.16","start":2007016,"end":2007016,"break":"none","ruby":[[3,1,"かれ"],[5,1,"い"],[18,1,"かみ"],[20,1,"しゅ"],[35,1,"い"],[46,1,"たみ"],[48,1,"さ"],[52,2,"あらの"],[60,1,"つか"],[75,1,"いま"],[84,1,"き"]],"text":"そして彼に言いなさい、『ヘブルびとの神、主がわたしをあなたにつかわして言われます、「わたしの民を去らせ、荒野で、わたしに仕えるようにさせよ」と。しかし今もなお、あなたが聞きいれようとされないので、"},{"ref":"Exod.7.17","start":2007017,"end":2007017,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"おお"],[22,1,"しゅ"],[34,1,"し"],[41,1,"み"],[48,1,"て"],[58,1,"かわ"],[60,1,"みず"],[62,1,"う"],[69,1,"ち"],[71,1,"かわ"]],"text":"主はこう仰せられます、「これによってわたしが主であることを、あなたは知るでしょう。見よ、わたしが手にあるつえでナイル川の水を打つと、それは血に変るであろう。"},{"ref":"Exod.7.18","start":2007018,"end":2007018,"break":"none","ruby":[[3,1,"かわ"],[5,1,"うお"],[7,1,"し"],[10,1,"かわ"],[12,1,"くさ"],[24,1,"かわ"],[26,1,"みず"],[28,1,"の"]],"text":"そして川の魚は死に、川は臭くなり、エジプトびとは川の水を飲むことをいとうであろう」』と」。"},{"ref":"Exod.7.19","start":2007019,"end":2007019,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"い"],[22,1,"い"],[36,1,"と"],[40,1,"て"],[47,1,"みず"],[49,1,"うえ"],[51,1,"かわ"],[53,1,"うえ"],[55,1,"なが"],[58,1,"うえ"],[60,1,"いけ"],[62,1,"うえ"],[72,1,"みず"],[77,1,"うえ"],[81,1,"の"],[88,1,"ち"],[101,2,"ぜんこく"],[109,1,"き"],[111,1,"うつわ"],[113,1,"いし"],[115,1,"うつわ"],[119,1,"ち"]],"text":"主はまたモーセに言われた、「あなたはアロンに言いなさい、『あなたのつえを執って、手をエジプトの水の上、川の上、流れの上、池の上、またそのすべての水たまりの上にさし伸べて、それを血にならせなさい。エジプト全国にわたって、木の器、石の器にも、血があるようになるでしょう』と」。"},{"ref":"Exod.7.20","start":2007020,"end":2007020,"break":"paragraph","ruby":[[8,1,"しゅ"],[10,1,"めい"],[29,1,"かれ"],[36,2,"けらい"],[41,1,"め"],[43,1,"まえ"],[55,1,"かわ"],[57,1,"みず"],[59,1,"う"],[63,1,"かわ"],[65,1,"みず"],[73,1,"ち"],[75,1,"かわ"]],"text":"モーセとアロンは主の命じられたようにおこなった。すなわち、彼はパロとその家来たちの目の前で、つえをあげてナイル川の水を打つと、川の水は、ことごとく血に変った。"},{"ref":"Exod.7.21","start":2007021,"end":2007021,"break":"none","ruby":[[3,1,"かわ"],[5,1,"うお"],[7,1,"し"],[10,1,"かわ"],[12,1,"くさ"],[24,1,"かわ"],[26,1,"みず"],[28,1,"の"],[48,2,"ぜんこく"],[55,1,"ち"]],"text":"それで川の魚は死に、川は臭くなり、エジプトびとは川の水を飲むことができなくなった。そしてエジプト全国にわたって血があった。"},{"ref":"Exod.7.22","start":2007022,"end":2007022,"break":"none","ruby":[[5,2,"まじゅつ"],[7,1,"し"],[10,2,"ひじゅつ"],[16,1,"おな"],[31,1,"しゅ"],[33,1,"い"],[44,1,"こころ"],[54,1,"かれ"],[57,1,"い"],[62,1,"き"]],"text":"エジプトの魔術師らも秘術をもって同じようにおこなった。しかし、主の言われたように、パロの心はかたくなになり、彼らの言うことを聞かなかった。"},{"ref":"Exod.7.23","start":2007023,"end":2007023,"break":"none","ruby":[[3,1,"み"],[10,1,"いえ"],[12,1,"い"],[23,1,"こころ"],[25,1,"と"]],"text":"パロは身をめぐらして家に入り、またこのことをも心に留めなかった。"},{"ref":"Exod.7.24","start":2007024,"end":2007024,"break":"none","ruby":[[14,1,"かわ"],[16,1,"みず"],[18,1,"の"],[27,1,"の"],[29,1,"みず"],[31,1,"え"],[36,1,"かわ"],[42,1,"ほ"]],"text":"すべてのエジプトびとはナイル川の水が飲めなかったので、飲む水を得ようと、川のまわりを掘った。"},{"ref":"Exod.7.25","start":2007025,"end":2007025,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"かわ"],[7,1,"う"],[13,2,"なぬか"],[16,1,"へ"]],"text":"主がナイル川を打たれてのち七日を経た。"}]