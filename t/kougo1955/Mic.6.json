[{"ref":"Mic.6.1","start":33006001,"end":33006001,"break":"paragraph","breaks":[[6,"line"],[18,"line"],[40,"line"]],"ruby":[[6,1,"しゅ"],[8,1,"い"],[15,1,"き"],[18,1,"た"],[30,1,"やま"],[32,1,"まえ"],[34,1,"うった"],[45,1,"おか"],[51,1,"こえ"],[53,1,"き"]],"text":"あなたがたは主の言われることを聞き、立ちあがって、もろもろの山の前に訴えをのべ、もろもろの丘にあなたの声を聞かせよ。"},{"ref":"Mic.6.2","start":33006002,"end":33006002,"break":"line","breaks":[[19,"line"],[29,"line"],[40,"line"]],"ruby":[[5,1,"やま"],[8,1,"ち"],[10,1,"かわ"],[16,1,"もとい"],[19,1,"しゅ"],[21,1,"い"],[23,1,"あらそ"],[26,1,"き"],[29,1,"しゅ"],[33,1,"たみ"],[35,1,"い"],[37,1,"あらそ"],[46,2,"ろんそう"]],"text":"もろもろの山よ、地の変ることなき基よ、主の言い争いを聞け。主はその民と言い争い、イスラエルと論争されるからである。"},{"ref":"Mic.6.3","start":33006003,"end":33006003,"break":"stanza","breaks":[[21,"line"],[37,"line"]],"ruby":[[3,1,"たみ"],[14,1,"なに"],[21,1,"なに"],[30,1,"つか"],[41,1,"こた"]],"text":"「わが民よ、わたしはあなたに何をなしたか、何によってあなたを疲れさせたか、わたしに答えよ。"},{"ref":"Mic.6.4","start":33006004,"end":33006004,"break":"line","breaks":[[22,"line"],[39,"line"]],"ruby":[[9,1,"くに"],[16,1,"みちび"],[22,2,"どれい"],[25,1,"いえ"],[36,1,"だ"],[64,1,"さき"]],"text":"わたしはエジプトの国からあなたを導きのぼり、奴隷の家からあなたをあがない出し、モーセ、アロンおよびミリアムをつかわして、あなたに先だたせた。"},{"ref":"Mic.6.5","start":33006005,"end":33006005,"break":"line","breaks":[[21,"line"],[37,"line"],[53,"line"],[65,"line"],[84,"line"]],"ruby":[[2,1,"たみ"],[9,1,"おう"],[19,1,"こと"],[25,1,"こ"],[30,1,"かれ"],[32,1,"こた"],[35,1,"こと"],[48,1,"いた"],[53,1,"おこ"],[56,1,"こと"],[60,1,"おも"],[62,1,"おこ"],[75,1,"しゅ"],[77,2,"せいぎ"],[84,1,"し"]],"text":"わが民よ、モアブの王バラクがたくらんだ事、ベオルの子バラムが彼に答えた事、シッテムからギルガルに至るまでに起った事どもを思い起せ。そうすれば、あなたは主の正義のみわざを知るであろう」。"},{"ref":"Mic.6.6","start":33006006,"end":33006006,"break":"stanza","breaks":[[18,"line"],[28,"line"],[42,"line"]],"ruby":[[5,1,"なに"],[10,1,"しゅ"],[13,1,"まえ"],[15,1,"い"],[18,1,"たか"],[20,1,"かみ"],[22,1,"はい"],[28,2,"はんさい"],[33,2,"とうさい"],[36,1,"こ"],[37,1,"うし"],[45,1,"まえ"],[47,1,"ゆ"]],"text":"「わたしは何をもって主のみ前に行き、高き神を拝すべきか。燔祭および当歳の子牛をもってそのみ前に行くべきか。"},{"ref":"Mic.6.7","start":33006007,"end":33006007,"break":"line","breaks":[[8,"line"],[22,"line"],[42,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"すう"],[3,1,"せん"],[5,2,"おひつじ"],[8,1,"まん"],[9,1,"りゅう"],[11,1,"あぶら"],[13,1,"よろこ"],[32,2,"ちょうし"],[44,1,"たましい"],[46,1,"つみ"],[53,1,"み"],[55,1,"こ"]],"text":"主は数千の雄羊、万流の油を喜ばれるだろうか。わがとがのためにわが長子をささぐべきか。わが魂の罪のためにわが身の子をささぐべきか」。"},{"ref":"Mic.6.8","start":33006008,"end":33006008,"break":"line","breaks":[[19,"line"],[29,"line"],[44,"line"],[63,"line"]],"ruby":[[0,1,"ひと"],[3,1,"かれ"],[10,1,"こと"],[23,1,"つ"],[29,1,"しゅ"],[35,1,"もと"],[46,2,"こうぎ"],[60,1,"あい"],[73,1,"かみ"],[75,1,"とも"],[77,1,"あゆ"]],"text":"人よ、彼はさきによい事のなんであるかをあなたに告げられた。主のあなたに求められることは、ただ公義をおこない、いつくしみを愛し、へりくだってあなたの神と共に歩むことではないか。"},{"ref":"Mic.6.9","start":33006009,"end":33006009,"break":"stanza","breaks":[[16,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"こえ"],[4,1,"まち"],[10,1,"よ"],[16,1,"まった"],[18,2,"ちえ"],[25,1,"な"],[27,1,"おそ"],[38,2,"ぶぞく"],[43,1,"まち"],[45,2,"かいしゅう"],[49,1,"き"]],"text":"主の声が町にむかって呼ばわる――全き知恵はあなたの名を恐れることである――「部族および町の会衆よ、聞け。"},{"ref":"Mic.6.10","start":33006010,"end":33006010,"break":"line","breaks":[[17,"line"]],"ruby":[[4,2,"あくにん"],[7,1,"いえ"],[11,2,"ふぎ"],[14,2,"ざいほう"],[22,2,"ふせい"],[25,1,"ます"],[27,1,"わす"],[29,1,"え"]],"text":"わたしは悪人の家にある不義の財宝、のろうべき不正な枡を忘れ得ようか。"},{"ref":"Mic.6.11","start":33006011,"end":33006011,"break":"line","breaks":[[10,"line"],[27,"line"]],"ruby":[[0,2,"ふせい"],[7,1,"もち"],[10,1,"いつわ"],[17,1,"い"],[20,1,"ふくろ"],[22,1,"もち"],[25,1,"ひと"],[31,1,"つみ"]],"text":"不正なはかりを用い、偽りのおもしを入れた袋を用いる人をわたしは罪なしとするだろうか。"},{"ref":"Mic.6.12","start":33006012,"end":33006012,"break":"line","breaks":[[18,"line"],[31,"line"]],"ruby":[[7,1,"と"],[10,1,"ひと"],[12,2,"ぼうぎゃく"],[15,1,"み"],[22,2,"じゅうみん"],[25,1,"いつわ"],[28,1,"い"],[33,1,"した"],[35,1,"くち"],[37,1,"あざむ"]],"text":"あなたのうちの富める人は暴虐で満ち、あなたの住民は偽りを言い、その舌は口で欺くことをなす。"},{"ref":"Mic.6.13","start":33006013,"end":33006013,"break":"line","breaks":[[16,"line"]],"ruby":[[13,1,"う"],[22,1,"つみ"],[27,1,"ほろ"],[33,1,"はじ"]],"text":"それゆえ、わたしはあなたを撃ち、あなたをその罪のために滅ぼすことを始めた。"},{"ref":"Mic.6.14","start":33006014,"end":33006014,"break":"line","breaks":[[17,"line"],[31,"line"],[50,"line"]],"ruby":[[4,1,"た"],[9,1,"あ"],[21,1,"はら"],[35,1,"うつ"],[40,1,"すく"],[54,1,"すく"],[56,1,"もの"]],"text":"あなたは食べても、飽くことがなく、あなたの腹はいつもひもじい。あなたは移しても、救うことができない。あなたが救う者を、わたしはつるぎにわたす。"},{"ref":"Mic.6.15","start":33006015,"end":33006015,"break":"line","breaks":[[19,"line"],[44,"line"]],"ruby":[[4,1,"たね"],[11,1,"か"],[23,1,"み"],[25,1,"ふ"],[32,1,"み"],[34,1,"あぶら"],[36,1,"ぬ"],[48,1,"ふ"],[55,1,"さけ"],[57,1,"の"]],"text":"あなたは種をまいても、刈ることがなく、オリブの実を踏んでも、その身に油を塗ることがなく、ぶどうを踏んでも、その酒を飲むことがない。"},{"ref":"Mic.6.16","start":33006016,"end":33006016,"break":"line","breaks":[[14,"line"],[32,"line"],[47,"line"],[61,"line"],[78,"line"]],"ruby":[[8,1,"さだ"],[11,1,"まも"],[18,1,"いえ"],[32,1,"かれ"],[35,1,"はか"],[40,1,"したが"],[43,1,"あゆ"],[58,1,"あら"],[63,2,"じゅうみん"],[66,1,"わら"],[68,1,"もの"],[84,1,"たみ"],[92,1,"お"]],"text":"あなたはオムリの定めを守り、アハブの家のすべてのわざをおこない、彼らの計りごとに従って歩んだ。これはわたしがあなたを荒し、その住民を笑い物とするためである。あなたがたは民のはずかしめを負わねばならぬ」。"}]