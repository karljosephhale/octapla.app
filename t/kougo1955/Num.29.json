[{"ref":"Num.29.1","start":4029001,"end":4029001,"break":"paragraph","ruby":[[1,1,"がつ"],[7,1,"つき"],[9,1,"だい"],[11,1,"にち"],[13,1,"せい"],[14,1,"かい"],[16,1,"ひら"],[30,2,"ろうえき"],[55,1,"ふ"],[57,1,"ひ"]],"text":"七月には、その月の第一日に聖会を開かなければならない。なんの労役をもしてはならない。これはあなたがたがラッパを吹く日である。"},{"ref":"Num.29.2","start":4029002,"end":4029002,"break":"none","ruby":[[6,2,"はんさい"],[14,1,"しゅ"],[16,1,"こう"],[38,1,"わか"],[40,2,"おうし"],[43,1,"とう"],[45,2,"おひつじ"],[48,1,"とう"],[51,1,"さい"],[53,1,"おす"],[55,1,"まった"],[57,2,"こひつじ"],[60,1,"とう"]],"text":"あなたがたは燔祭をささげて、主に香ばしいかおりとしなければならない。すなわち若い雄牛一頭、雄羊一頭、一歳の雄の全き小羊七頭をささげなければならない。"},{"ref":"Num.29.3","start":4029003,"end":4029003,"break":"none","ruby":[[2,2,"そさい"],[6,1,"あぶら"],[8,1,"ま"],[11,2,"むぎこ"],[30,2,"おうし"],[33,1,"とう"],[43,1,"ぶん"],[47,2,"おひつじ"],[50,1,"とう"],[56,1,"ぶん"]],"text":"その素祭には油を混ぜた麦粉をささげなければならない。すなわち雄牛一頭について一エパの十分の三、雄羊一頭について十分の二をささげ、"},{"ref":"Num.29.4","start":4029004,"end":4029004,"break":"none","ruby":[[3,1,"とう"],[5,2,"こひつじ"],[10,1,"とう"],[15,1,"ぶん"]],"text":"また七頭の小羊には一頭ごとに十分の一をささげなければならない。"},{"ref":"Num.29.5","start":4029005,"end":4029005,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[26,1,"つみ"]],"text":"また雄やぎ一頭を罪祭としてささげ、あなたがたのために罪のあがないをしなければならない。"},{"ref":"Num.29.6","start":4029006,"end":4029006,"break":"none","ruby":[[3,2,"しんげつ"],[6,2,"はんさい"],[11,2,"そさい"],[14,3,"じょうはんさい"],[20,2,"そさい"],[26,2,"かんさい"],[46,1,"さだ"],[54,1,"こう"],[65,1,"しゅ"],[67,2,"かさい"]],"text":"これは新月の燔祭とその素祭、常燔祭とその素祭、および灌祭のほかのものであって、これらのものの定めにしたがい、香ばしいかおりとして、主に火祭としなければならない。"},{"ref":"Num.29.7","start":4029007,"end":4029007,"break":"paragraph","ruby":[[5,1,"がつ"],[8,1,"か"],[10,1,"せい"],[11,1,"かい"],[13,1,"ひら"],[24,1,"み"],[26,1,"なや"],[41,2,"しごと"]],"text":"またその七月の十日に聖会を開き、かつあなたがたの身を悩まさなければならない。なんの仕事もしてはならない。"},{"ref":"Num.29.8","start":4029008,"end":4029008,"break":"none","ruby":[[6,1,"しゅ"],[8,2,"はんさい"],[16,1,"こう"],[38,1,"わか"],[40,2,"おうし"],[43,1,"とう"],[45,2,"おひつじ"],[48,1,"とう"],[51,1,"さい"],[53,1,"おす"],[55,2,"こひつじ"],[58,1,"とう"],[78,1,"まった"]],"text":"あなたがたは主に燔祭をささげて、香ばしいかおりとしなければならない。すなわち若い雄牛一頭、雄羊一頭、一歳の雄の小羊七頭をささげなければならない。これらはみな全きものでなければならない。"},{"ref":"Num.29.9","start":4029009,"end":4029009,"break":"none","ruby":[[2,2,"そさい"],[6,1,"あぶら"],[8,1,"ま"],[11,2,"むぎこ"],[30,2,"おうし"],[33,1,"とう"],[42,1,"ぶん"],[46,2,"おひつじ"],[49,1,"とう"],[54,1,"ぶん"]],"text":"その素祭には油を混ぜた麦粉をささげなければならない。すなわち雄牛一頭につき一エパの十分の三、雄羊一頭につき十分の二をささげ、"},{"ref":"Num.29.10","start":4029010,"end":4029010,"break":"none","ruby":[[3,1,"とう"],[5,2,"こひつじ"],[10,1,"とう"],[15,1,"ぶん"]],"text":"また七頭の小羊には一頭ごとに十分の一をささげなければならない。"},{"ref":"Num.29.11","start":4029011,"end":4029011,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[29,2,"しょくざい"],[32,2,"ざいさい"],[35,3,"じょうはんさい"],[41,2,"そさい"],[47,2,"かんさい"]],"text":"また雄やぎ一頭を罪祭としてささげなければならない。これらは贖罪の罪祭と常燔祭とその素祭、および灌祭のほかのものである。"},{"ref":"Num.29.12","start":4029012,"end":4029012,"break":"paragraph","ruby":[[1,1,"がつ"],[5,1,"にち"],[7,1,"せい"],[8,1,"かい"],[10,1,"ひら"],[24,2,"ろうえき"],[35,2,"なぬか"],[41,1,"しゅ"],[46,1,"まつり"]],"text":"七月の十五日に聖会を開かなければならない。なんの労役もしてはならない。七日のあいだ主のために祭をしなければならない。"},{"ref":"Num.29.13","start":4029013,"end":4029013,"break":"none","ruby":[[6,2,"はんさい"],[14,1,"しゅ"],[16,1,"こう"],[24,2,"かさい"],[41,1,"わか"],[43,2,"おうし"],[47,1,"とう"],[49,2,"おひつじ"],[52,1,"とう"],[55,1,"さい"],[57,1,"おす"],[59,2,"こひつじ"],[63,1,"とう"],[83,1,"まった"]],"text":"あなたがたは燔祭をささげて、主に香ばしいかおりの火祭としなければならない。すなわち若い雄牛十三頭、雄羊二頭、一歳の雄の小羊十四頭をささげなければならない。これらはみな全きものでなければならない。"},{"ref":"Num.29.14","start":4029014,"end":4029014,"break":"none","ruby":[[2,2,"そさい"],[6,1,"あぶら"],[8,1,"ま"],[11,2,"むぎこ"],[32,1,"とう"],[34,2,"おうし"],[39,1,"とう"],[44,1,"ぶん"],[51,1,"とう"],[53,2,"おひつじ"],[58,1,"とう"],[63,1,"ぶん"]],"text":"その素祭には油を混ぜた麦粉をささげなければならない。すなわち十三頭の雄牛には一頭ごとに十分の三、その二頭の雄羊には一頭ごとに十分の二をささげ、"},{"ref":"Num.29.15","start":4029015,"end":4029015,"break":"none","ruby":[[4,1,"とう"],[6,2,"こひつじ"],[11,1,"とう"],[16,1,"ぶん"]],"text":"その十四頭の小羊には一頭ごとに十分の一をささげなければならない。"},{"ref":"Num.29.16","start":4029016,"end":4029016,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[29,3,"じょうはんさい"],[35,2,"そさい"],[40,2,"かんさい"]],"text":"また雄やぎ一頭を罪祭としてささげなければならない。これらは常燔祭とその素祭および灌祭のほかのものである。"},{"ref":"Num.29.17","start":4029017,"end":4029017,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"にち"],[5,1,"わか"],[7,2,"おうし"],[11,1,"とう"],[13,2,"おひつじ"],[16,1,"とう"],[19,1,"さい"],[21,1,"おす"],[23,1,"まった"],[25,2,"こひつじ"],[29,1,"とう"]],"text":"第二日には若い雄牛十二頭、雄羊二頭、一歳の雄の全き小羊十四頭をささげなければならない。"},{"ref":"Num.29.18","start":4029018,"end":4029018,"break":"none","ruby":[[2,2,"おうし"],[5,2,"おひつじ"],[8,2,"こひつじ"],[15,2,"そさい"],[18,2,"かんさい"],[24,1,"かず"],[32,1,"さだ"]],"text":"その雄牛と雄羊と小羊とのための素祭と灌祭とはその数にしたがって、定めのようにささげなければならない。"},{"ref":"Num.29.19","start":4029019,"end":4029019,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[29,3,"じょうはんさい"],[35,2,"そさい"],[40,2,"かんさい"]],"text":"また雄やぎ一頭を罪祭としてささげなければならない。これらは常燔祭とその素祭および灌祭のほかのものである。"},{"ref":"Num.29.20","start":4029020,"end":4029020,"break":"none","ruby":[[0,1,"だい"],[2,1,"にち"],[5,2,"おうし"],[9,1,"とう"],[11,2,"おひつじ"],[14,1,"とう"],[17,1,"さい"],[19,1,"おす"],[21,1,"まった"],[23,2,"こひつじ"],[27,1,"とう"]],"text":"第三日には雄牛十一頭、雄羊二頭、一歳の雄の全き小羊十四頭をささげなければならない。"},{"ref":"Num.29.21","start":4029021,"end":4029021,"break":"none","ruby":[[2,2,"おうし"],[5,2,"おひつじ"],[8,2,"こひつじ"],[15,2,"そさい"],[18,2,"かんさい"],[25,1,"かず"],[32,1,"さだ"]],"text":"その雄牛と雄羊と小羊とのための素祭と灌祭とは、その数にしたがって定めのようにささげなければならない。"},{"ref":"Num.29.22","start":4029022,"end":4029022,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[29,3,"じょうはんさい"],[35,2,"そさい"],[40,2,"かんさい"]],"text":"また雄やぎ一頭を罪祭としてささげなければならない。これらは常燔祭とその素祭および灌祭のほかのものである。"},{"ref":"Num.29.23","start":4029023,"end":4029023,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"にち"],[5,2,"おうし"],[8,1,"とう"],[10,2,"おひつじ"],[13,1,"とう"],[16,1,"さい"],[18,1,"おす"],[20,1,"まった"],[22,2,"こひつじ"],[26,1,"とう"]],"text":"第四日には雄牛十頭、雄羊二頭、一歳の雄の全き小羊十四頭をささげなければならない。"},{"ref":"Num.29.24","start":4029024,"end":4029024,"break":"none","ruby":[[2,2,"おうし"],[5,2,"おひつじ"],[8,2,"こひつじ"],[15,2,"そさい"],[18,2,"かんさい"],[25,1,"かず"],[32,1,"さだ"]],"text":"その雄牛と雄羊と小羊とのための素祭と灌祭とは、その数にしたがって定めのようにささげなければならない。"},{"ref":"Num.29.25","start":4029025,"end":4029025,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[29,3,"じょうはんさい"],[35,2,"そさい"],[40,2,"かんさい"]],"text":"また雄やぎ一頭を罪祭としてささげなければならない。これらは常燔祭とその素祭および灌祭のほかのものである。"},{"ref":"Num.29.26","start":4029026,"end":4029026,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"にち"],[5,2,"おうし"],[8,1,"とう"],[10,2,"おひつじ"],[13,1,"とう"],[16,1,"さい"],[18,1,"おす"],[20,1,"まった"],[22,2,"こひつじ"],[26,1,"とう"]],"text":"第五日には雄牛九頭、雄羊二頭、一歳の雄の全き小羊十四頭をささげなければならない。"},{"ref":"Num.29.27","start":4029027,"end":4029027,"break":"none","ruby":[[2,2,"おうし"],[5,2,"おひつじ"],[8,2,"こひつじ"],[15,2,"そさい"],[18,2,"かんさい"],[25,1,"かず"],[32,1,"さだ"]],"text":"その雄牛と雄羊と小羊とのための素祭と灌祭とは、その数にしたがって定めのようにささげなければならない。"},{"ref":"Num.29.28","start":4029028,"end":4029028,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[29,3,"じょうはんさい"],[35,2,"そさい"],[40,2,"かんさい"]],"text":"また雄やぎ一頭を罪祭としてささげなければならない。これらは常燔祭とその素祭および灌祭のほかのものである。"},{"ref":"Num.29.29","start":4029029,"end":4029029,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"にち"],[5,2,"おうし"],[8,1,"とう"],[10,2,"おひつじ"],[13,1,"とう"],[16,1,"さい"],[18,1,"おす"],[20,1,"まった"],[22,2,"こひつじ"],[26,1,"とう"]],"text":"第六日には雄牛八頭、雄羊二頭、一歳の雄の全き小羊十四頭をささげなければならない。"},{"ref":"Num.29.30","start":4029030,"end":4029030,"break":"none","ruby":[[2,2,"おうし"],[5,2,"おひつじ"],[8,2,"こひつじ"],[15,2,"そさい"],[18,2,"かんさい"],[25,1,"かず"],[32,1,"さだ"]],"text":"その雄牛と雄羊と小羊とのための素祭と灌祭とは、その数にしたがって定めのようにささげなければならない。"},{"ref":"Num.29.31","start":4029031,"end":4029031,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[29,3,"じょうはんさい"],[35,2,"そさい"],[40,2,"かんさい"]],"text":"また雄やぎ一頭を罪祭としてささげなければならない。これらは常燔祭とその素祭および灌祭のほかのものである。"},{"ref":"Num.29.32","start":4029032,"end":4029032,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"にち"],[5,2,"おうし"],[8,1,"とう"],[10,2,"おひつじ"],[13,1,"とう"],[16,1,"さい"],[18,1,"おす"],[20,1,"まった"],[22,2,"こひつじ"],[26,1,"とう"]],"text":"第七日には雄牛七頭、雄羊二頭、一歳の雄の全き小羊十四頭をささげなければならない。"},{"ref":"Num.29.33","start":4029033,"end":4029033,"break":"none","ruby":[[2,2,"おうし"],[5,2,"おひつじ"],[8,2,"こひつじ"],[15,2,"そさい"],[18,2,"かんさい"],[25,1,"かず"],[32,1,"さだ"]],"text":"その雄牛と雄羊と小羊とのための素祭と灌祭とは、その数にしたがって定めのようにささげなければならない。"},{"ref":"Num.29.34","start":4029034,"end":4029034,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[29,3,"じょうはんさい"],[35,2,"そさい"],[40,2,"かんさい"]],"text":"また雄やぎ一頭を罪祭としてささげなければならない。これらは常燔祭とその素祭および灌祭のほかのものである。"},{"ref":"Num.29.35","start":4029035,"end":4029035,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"か"],[7,2,"しゅうかい"],[10,1,"ひら"],[24,2,"ろうえき"]],"text":"第八日にはまた集会を開かなければならない。なんの労役をもしてはならない。"},{"ref":"Num.29.36","start":4029036,"end":4029036,"break":"none","ruby":[[6,2,"はんさい"],[13,1,"しゅ"],[15,1,"こう"],[23,2,"かさい"],[40,2,"おうし"],[43,1,"とう"],[45,2,"おひつじ"],[48,1,"とう"],[51,1,"さい"],[53,1,"おす"],[55,1,"まった"],[57,2,"こひつじ"],[60,1,"とう"]],"text":"あなたがたは燔祭をささげて主に香ばしいかおりの火祭としなければならない。すなわち雄牛一頭、雄羊一頭、一歳の雄の全き小羊七頭をささげなければならない。"},{"ref":"Num.29.37","start":4029037,"end":4029037,"break":"none","ruby":[[2,2,"おうし"],[5,2,"おひつじ"],[8,2,"こひつじ"],[15,2,"そさい"],[18,2,"かんさい"],[25,1,"かず"],[32,1,"さだ"]],"text":"その雄牛と雄羊と小羊とのための素祭と灌祭とは、その数にしたがって定めのようにささげなければならない。"},{"ref":"Num.29.38","start":4029038,"end":4029038,"break":"none","ruby":[[2,1,"お"],[6,1,"とう"],[8,2,"ざいさい"],[29,3,"じょうはんさい"],[35,2,"そさい"],[40,2,"かんさい"]],"text":"また雄やぎ一頭を罪祭としてささげなければならない。これらは常燔祭とその素祭および灌祭のほかのものである。"},{"ref":"Num.29.39","start":4029039,"end":4029039,"break":"paragraph","ruby":[[6,1,"さだ"],[9,1,"まつり"],[11,1,"とき"],[21,1,"しゅ"],[45,2,"せいがん"],[51,2,"じはつ"],[54,1,"そな"],[56,1,"もの"],[64,2,"はんさい"],[67,2,"そさい"],[70,2,"かんさい"],[75,3,"しゅうおんさい"]],"text":"あなたがたは定めの祭の時に、これらのものを主にささげなければならない。これらはあなたがたの誓願、または自発の供え物としてささげる燔祭、素祭、灌祭および酬恩祭のほかのものである』」。"},{"ref":"Num.29.40","start":4029040,"end":4029040,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"めい"],[11,1,"こと"],[24,2,"ひとびと"],[27,1,"つ"]],"text":"モーセは主が命じられた事をことごとくイスラエルの人々に告げた。"}]