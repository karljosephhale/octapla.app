[{"ref":"Judg.18.1","start":7018001,"end":7018001,"break":"paragraph","ruby":[[11,1,"おう"],[27,2,"ぶぞく"],[36,2,"ぶぞく"],[48,1,"ひ"],[53,1,"し"],[54,1,"ぎょう"],[56,1,"ち"],[58,1,"え"],[65,2,"じぶん"],[70,1,"す"],[74,1,"し"],[75,1,"ぎょう"],[77,1,"ち"],[79,1,"もと"]],"text":"そのころイスラエルには王がなかった。そのころダンびとの部族はイスラエルの部族のうちにあって、その日までまだ嗣業の地を得なかったので自分たちの住むべき嗣業の地を求めていた。"},{"ref":"Judg.18.2","start":7018002,"end":7018002,"break":"none","ruby":[[6,2,"ひとびと"],[9,2,"じぶん"],[12,2,"ぶぞく"],[15,2,"そうぜい"],[23,2,"ゆうしゃ"],[26,1,"にん"],[43,2,"とち"],[50,1,"さぐ"],[59,1,"かれ"],[62,1,"い"],[67,1,"い"],[70,2,"とち"],[73,1,"さぐ"],[82,1,"かれ"],[91,2,"さんち"],[94,1,"い"],[100,1,"いえ"],[102,1,"つ"],[109,1,"やど"]],"text":"それでダンの人々は自分の部族の総勢のうちから、勇者五人をゾラとエシタオルからつかわして土地をうかがい探らせた。すなわち彼らに言った、「行って土地を探ってきなさい」。彼らはエフライムの山地に行き、ミカの家に着いて、そこに宿ろうとした。"},{"ref":"Judg.18.3","start":7018003,"end":7018003,"break":"none","ruby":[[0,1,"かれ"],[6,1,"いえ"],[8,1,"ちか"],[22,2,"わかもの"],[25,1,"こえ"],[27,1,"き"],[35,1,"み"],[49,1,"かれ"],[51,1,"い"],[66,1,"つ"],[83,1,"なに"],[100,1,"よう"]],"text":"彼らがミカの家に近づいたとき、レビびとである若者の声を聞きわけたので、身をめぐらしてそこにはいって彼に言った、「だれがあなたをここに連れてきたのですか。あなたはここで何をしているのですか。ここになんの用があるのですか」。"},{"ref":"Judg.18.4","start":7018004,"end":7018004,"break":"none","ruby":[[0,2,"わかもの"],[3,1,"かれ"],[6,1,"い"],[28,1,"やと"],[40,2,"さいし"]],"text":"若者は彼らに言った、「ミカが、かようかようにしてわたしを雇ったので、わたしはその祭司となったのです」。"},{"ref":"Judg.18.5","start":7018005,"end":7018005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[12,1,"かみ"],[14,1,"うかが"],[23,1,"い"],[25,1,"みち"],[39,1,"し"]],"text":"彼らは言った、「どうぞ、神に伺って、われわれが行く道にしあわせがあるかどうかを知らせてください」。"},{"ref":"Judg.18.6","start":7018006,"end":7018006,"break":"none","ruby":[[2,2,"さいし"],[5,1,"かれ"],[8,1,"い"],[13,2,"あんしん"],[17,1,"い"],[29,1,"い"],[31,1,"みち"],[33,1,"しゅ"],[35,2,"みまも"]],"text":"その祭司は彼らに言った、「安心して行きなさい。あなたがたが行く道は主が見守っておられます」。"},{"ref":"Judg.18.7","start":7018007,"end":7018007,"break":"paragraph","ruby":[[4,1,"にん"],[6,1,"もの"],[8,1,"さ"],[15,1,"い"],[23,1,"たみ"],[25,1,"み"],[29,1,"かれ"],[32,1,"やす"],[36,1,"す"],[42,1,"おだ"],[46,1,"やす"],[67,1,"くに"],[75,1,"か"],[84,1,"とみ"],[86,1,"も"],[97,1,"とお"],[99,1,"はな"],[108,1,"たみ"],[110,1,"まじ"]],"text":"そこで五人の者は去ってライシに行き、そこにいる民を見ると、彼らは安らかに住まい、その穏やかで安らかなことシドンびとのようであって、この国には一つとして欠けたものがなく、富を持ち、またシドンびとと遠く離れており、ほかの民と交わることがなかった。"},{"ref":"Judg.18.8","start":7018008,"end":7018008,"break":"none","ruby":[[3,1,"かれ"],[17,2,"きょうだい"],[25,1,"かえ"],[32,2,"きょうだい"],[37,1,"かれ"],[40,1,"い"]],"text":"かくて彼らがゾラとエシタオルにおる兄弟たちのもとに帰ってくると、兄弟たちは彼らに言った、「いかがでしたか」。"},{"ref":"Judg.18.9","start":7018009,"end":7018009,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[8,1,"た"],[11,1,"かれ"],[18,1,"せ"],[20,1,"のぼ"],[34,1,"ち"],[36,1,"み"],[40,2,"ひじょう"],[43,1,"ゆた"],[74,1,"すす"],[77,1,"い"],[83,1,"ち"],[85,1,"と"]],"text":"彼らは言った、「立って彼らのところに攻め上りましょう。われわれはかの地を見たが、非常に豊かです。あなたがたはなぜじっとしているのですか。ためらわずに進んで行って、かの地を取りなさい。"},{"ref":"Judg.18.10","start":7018010,"end":7018010,"break":"none","ruby":[[6,1,"い"],[10,1,"やす"],[16,1,"たみ"],[18,1,"ところ"],[20,1,"い"],[29,1,"ち"],[31,1,"ひろ"],[34,1,"かみ"],[45,1,"て"],[47,1,"たま"],[58,1,"ち"],[69,1,"か"]],"text":"あなたがたが行けば、安らかにおる民の所に行くでしょう。その地は広く、神はそれをあなたがたの手に賜わるのです。そこには地にあるもの一つとして欠けているものはありません」。"},{"ref":"Judg.18.11","start":7018011,"end":7018011,"break":"paragraph","ruby":[[6,2,"しぞく"],[13,1,"にん"],[15,2,"ぶき"],[18,1,"お"],[31,2,"しゅっぱつ"]],"text":"そこでダンの氏族のもの六百人が武器を帯びて、ゾラとエシタオルを出発し、"},{"ref":"Judg.18.12","start":7018012,"end":7018012,"break":"none","ruby":[[0,1,"のぼ"],[3,1,"い"],[18,1,"じん"],[20,1,"は"],[32,1,"ところ"],[34,2,"こんにち"],[44,1,"よ"],[61,1,"にし"]],"text":"上って行ってユダのキリアテ・ヤリムに陣を張った。このゆえに、その所は今日までマハネダンと呼ばれる。それはキリアテ・ヤリムの西にある。"},{"ref":"Judg.18.13","start":7018013,"end":7018013,"break":"none","ruby":[[0,1,"かれ"],[13,2,"さんち"],[16,1,"すす"],[22,1,"いえ"],[24,1,"つ"]],"text":"彼らはそこからエフライムの山地に進み、ミカの家に着いた。"},{"ref":"Judg.18.14","start":7018014,"end":7018014,"break":"paragraph","ruby":[[6,1,"くに"],[13,1,"い"],[17,1,"にん"],[19,1,"もの"],[23,2,"きょうだい"],[28,1,"い"],[43,1,"いえ"],[54,1,"きざ"],[57,1,"ぞう"],[59,1,"い"],[61,1,"ぞう"],[67,1,"し"],[84,1,"いま"],[93,1,"き"]],"text":"かのライシの国をうかがいに行った五人の者はその兄弟たちに言った、「あなたがたはこれらの家にエポデとテラピムと刻んだ像と鋳た像のあるのを知っていますか。それであなたがたは今、なすべきことを決めなさい」。"},{"ref":"Judg.18.15","start":7018015,"end":7018015,"break":"none","ruby":[[3,1,"かれ"],[8,1,"ほう"],[10,1,"み"],[25,2,"わかもの"],[28,1,"いえ"],[36,1,"いえ"],[38,1,"い"],[42,1,"かれ"],[44,2,"あんぴ"],[47,1,"と"]],"text":"そこで彼らはその方へ身をめぐらして、かのレビびとの若者の家すなわちミカの家に行って、彼に安否を問うた。"},{"ref":"Judg.18.16","start":7018016,"end":7018016,"break":"none","ruby":[[3,2,"ぶき"],[6,1,"お"],[11,1,"にん"],[16,2,"ひとびと"],[19,1,"もん"],[21,2,"いりぐち"],[24,1,"た"]],"text":"しかし武器を帯びた六百人のダンの人々は門の入口に立っていた。"},{"ref":"Judg.18.17","start":7018017,"end":7018017,"break":"none","ruby":[[2,2,"とち"],[10,1,"い"],[14,1,"にん"],[16,1,"もの"],[18,1,"のぼ"],[21,1,"い"],[32,1,"きざ"],[35,1,"ぞう"],[46,1,"い"],[48,1,"ぞう"],[51,1,"と"],[56,2,"さいし"],[59,2,"ぶき"],[62,1,"お"],[67,1,"にん"],[69,1,"もの"],[71,1,"とも"],[73,1,"もん"],[75,2,"いりぐち"],[78,1,"た"]],"text":"かの土地をうかがいに行った五人の者は上って行って、そこにはいり、刻んだ像とエポデとテラピムと鋳た像とを取ったが、祭司は武器を帯びた六百人の者と共に門の入口に立っていた。"},{"ref":"Judg.18.18","start":7018018,"end":7018018,"break":"none","ruby":[[0,1,"かれ"],[6,1,"いえ"],[12,1,"きざ"],[15,1,"ぞう"],[26,1,"い"],[28,1,"ぞう"],[31,1,"と"],[34,1,"とき"],[36,2,"さいし"],[39,1,"かれ"],[42,1,"い"],[53,1,"なに"]],"text":"彼らがミカの家にはいって刻んだ像とエポデとテラピムと鋳た像とを取った時、祭司は彼らに言った、「あなたがたは何をなさいますか」。"},{"ref":"Judg.18.19","start":7018019,"end":7018019,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[8,1,"だま"],[18,1,"て"],[20,1,"くち"],[31,2,"いっしょ"],[45,1,"ちち"],[48,2,"さいし"],[62,1,"いえ"],[64,2,"さいし"],[78,1,"いち"],[79,2,"ぶぞく"],[82,1,"いち"],[83,2,"しぞく"],[86,2,"さいし"]],"text":"彼らは言った、「黙りなさい。あなたの手を口にあてて、われわれと一緒にきて、われわれのために父とも祭司ともなりなさい。ひとりの家の祭司であるのと、イスラエルの一部族、一氏族の祭司であるのと、どちらがよいですか」。"},{"ref":"Judg.18.20","start":7018020,"end":7018020,"break":"none","ruby":[[0,2,"さいし"],[3,1,"よろこ"],[16,1,"きざ"],[19,1,"ぞう"],[22,1,"と"],[25,1,"たみ"],[30,1,"くわ"]],"text":"祭司は喜んで、エポデとテラピムと刻んだ像とを取り、民のなかに加わった。"},{"ref":"Judg.18.21","start":7018021,"end":7018021,"break":"paragraph","ruby":[[3,1,"かれ"],[6,1,"み"],[13,1,"さ"],[18,1,"こ"],[19,1,"とも"],[23,2,"かちく"],[26,1,"か"],[27,1,"ざい"],[35,1,"すす"]],"text":"かくて彼らは身をめぐらして去り、その子供たちと家畜と貨財をさきにたてて進んだが、"},{"ref":"Judg.18.22","start":7018022,"end":7018022,"break":"none","ruby":[[3,1,"いえ"],[9,1,"はな"],[18,1,"いえ"],[20,1,"ちか"],[22,1,"いえ"],[24,2,"ひとびと"],[27,1,"あつ"],[33,2,"ひとびと"],[36,1,"お"]],"text":"ミカの家をはるかに離れたとき、ミカは家に近い家の人々を集め、ダンの人々に追いつき、"},{"ref":"Judg.18.23","start":7018023,"end":7018023,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"よ"],[12,1,"かれ"],[17,1,"む"],[23,1,"い"],[37,2,"なかま"],[40,1,"つ"]],"text":"ダンの人々を呼んだので、彼らはふり向いてミカに言った、「あなたがそのように仲間を連れてきたのは、どうしたのですか」。"},{"ref":"Judg.18.24","start":7018024,"end":7018024,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[18,1,"つく"],[21,2,"かみがみ"],[26,2,"さいし"],[29,1,"うば"],[31,1,"さ"],[41,1,"なに"],[43,1,"のこ"],[65,1,"む"],[80,1,"い"],[86,2,"なにごと"]],"text":"彼は言った、「あなたがたが、わたしの造った神々および祭司を奪い去ったので、わたしに何が残っていますか。しかるにあなたがたがわたしに向かって『どうしたのですか』と言われるとは何事ですか」。"},{"ref":"Judg.18.25","start":7018025,"end":7018025,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"かれ"],[8,1,"い"],[17,1,"おお"],[20,1,"こえ"],[22,1,"だ"],[30,1,"き"],[32,1,"あら"],[34,2,"れんちゅう"],[41,1,"う"],[52,2,"じぶん"],[55,1,"いのち"],[57,2,"かぞく"],[60,1,"いのち"],[62,1,"うしな"]],"text":"ダンの人々は彼に言った、「あなたは大きな声を出さないがよい。気の荒い連中があなたに撃ちかかって、あなたは自分の命と家族の命を失うようになるでしょう」。"},{"ref":"Judg.18.26","start":7018026,"end":7018026,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"さ"],[13,1,"い"],[21,1,"かれ"],[24,1,"つよ"],[28,1,"み"],[39,2,"じぶん"],[42,1,"いえ"],[44,1,"かえ"]],"text":"こうしてダンの人々は去って行ったが、ミカは彼らの強いのを見て、くびすをかえして自分の家に帰った。"},{"ref":"Judg.18.27","start":7018027,"end":7018027,"break":"paragraph","ruby":[[2,1,"かれ"],[8,1,"つく"],[11,1,"もの"],[17,1,"とも"],[21,2,"さいし"],[25,1,"うば"],[37,1,"おだ"],[42,1,"やす"],[46,1,"たみ"],[52,1,"い"],[63,1,"かれ"],[66,1,"う"],[69,1,"ひ"],[76,1,"まち"],[78,1,"や"]],"text":"さて彼らはミカが造った物と、ミカと共にいた祭司とを奪ってライシにおもむき、穏やかで、安らかな民のところへ行って、つるぎをもって彼らを撃ち、火をつけてその町を焼いたが、"},{"ref":"Judg.18.28","start":7018028,"end":7018028,"break":"none","ruby":[[4,1,"とお"],[6,1,"はな"],[15,1,"たみ"],[18,1,"まじ"],[32,1,"すく"],[44,1,"まち"],[52,1,"ぞく"],[55,1,"たに"],[61,1,"かれ"],[64,1,"まち"],[66,1,"た"],[75,1,"す"]],"text":"シドンを遠く離れており、ほかの民との交わりがなかったので、それを救うものがなかった。その町はベテレホブに属する谷にあった。彼らは町を建てなおしてそこに住み、"},{"ref":"Judg.18.29","start":7018029,"end":7018029,"break":"none","ruby":[[6,1,"うま"],[9,2,"せんぞ"],[14,1,"な"],[24,1,"まち"],[26,1,"な"],[31,1,"な"],[38,1,"まち"],[40,1,"な"]],"text":"イスラエルに生れた先祖ダンの名にしたがって、その町の名をダンと名づけた。その町の名はもとはライシであった。"},{"ref":"Judg.18.30","start":7018030,"end":7018030,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"きざ"],[12,1,"ぞう"],[14,2,"じぶん"],[22,2,"あんち"],[30,1,"まご"],[41,1,"こ"],[49,2,"しそん"],[57,2,"ぶぞく"],[60,2,"さいし"],[67,1,"くに"],[69,2,"ほしゅう"],[74,1,"ひ"],[78,1,"およ"]],"text":"そしてダンの人々は刻んだ像を自分たちのために安置し、モーセの孫すなわちゲルショムの子ヨナタンとその子孫がダンびとの部族の祭司となって、国が捕囚となる日にまで及んだ。"},{"ref":"Judg.18.31","start":7018031,"end":7018031,"break":"none","ruby":[[0,1,"かみ"],[2,1,"いえ"],[14,1,"つね"],[16,1,"かれ"],[22,1,"つく"],[27,1,"きざ"],[30,1,"ぞう"],[32,1,"かざ"],[35,1,"お"]],"text":"神の家がシロにあったあいだ、常に彼らはミカが造ったその刻んだ像を飾って置いた。"}]