[{"ref":"Exod.21.1","start":2021001,"end":2021001,"break":"paragraph","ruby":[[7,1,"かれ"],[10,1,"まえ"],[12,1,"しめ"]],"text":"これはあなたが彼らの前に示すべきおきてである。"},{"ref":"Exod.21.2","start":2021002,"end":2021002,"break":"none","ruby":[[12,2,"どれい"],[15,1,"か"],[17,1,"とき"],[21,1,"ねん"],[26,1,"つか"],[32,1,"ねん"],[33,1,"め"],[36,2,"むしょう"],[39,2,"じゆう"],[42,1,"み"],[46,1,"さ"]],"text":"あなたがヘブルびとである奴隷を買う時は、六年のあいだ仕えさせ、七年目には無償で自由の身として去らせなければならない。"},{"ref":"Exod.21.3","start":2021003,"end":2021003,"break":"none","ruby":[[0,1,"かれ"],[4,2,"どくしん"],[13,2,"どくしん"],[16,1,"さ"],[29,1,"つま"],[31,1,"も"],[42,1,"つま"],[44,1,"かれ"],[46,1,"とも"],[48,1,"さ"]],"text":"彼がもし独身できたならば、独身で去らなければならない。もし妻を持っていたならば、その妻は彼と共に去らなければならない。"},{"ref":"Exod.21.4","start":2021004,"end":2021004,"break":"none","ruby":[[4,2,"しゅじん"],[7,1,"かれ"],[9,1,"つま"],[11,1,"あた"],[15,1,"かれ"],[17,1,"おとこ"],[19,1,"こ"],[22,1,"おんな"],[24,1,"こ"],[26,1,"う"],[33,1,"つま"],[37,1,"こ"],[38,1,"とも"],[40,2,"しゅじん"],[49,1,"かれ"],[51,2,"どくしん"],[54,1,"さ"]],"text":"もしその主人が彼に妻を与えて、彼に男の子また女の子を産んだならば、妻とその子供は主人のものとなり、彼は独身で去らなければならない。"},{"ref":"Exod.21.5","start":2021005,"end":2021005,"break":"none","ruby":[[0,2,"どれい"],[15,2,"しゅじん"],[23,1,"つま"],[25,2,"こども"],[28,1,"あい"],[37,2,"じゆう"],[40,1,"み"],[45,1,"さ"],[50,1,"この"],[57,2,"めいげん"]],"text":"奴隷がもし『わたしは、わたしの主人と、わたしの妻と子供を愛します。わたしは自由の身となって去ることを好みません』と明言するならば、"},{"ref":"Exod.21.6","start":2021006,"end":2021006,"break":"none","ruby":[[2,2,"しゅじん"],[5,1,"かれ"],[7,1,"かみ"],[12,1,"つ"],[15,1,"い"],[18,1,"と"],[23,1,"はしら"],[29,1,"つ"],[32,1,"い"],[36,2,"しゅじん"],[43,1,"かれ"],[45,1,"みみ"],[47,1,"さ"],[49,1,"とお"],[65,1,"かれ"],[75,1,"つか"]],"text":"その主人は彼を神のもとに連れて行き、戸あるいは柱のところに連れて行って、主人は、きりで彼の耳を刺し通さなければならない。そうすれば彼はいつまでもこれに仕えるであろう。"},{"ref":"Exod.21.7","start":2021007,"end":2021007,"break":"paragraph","ruby":[[2,1,"ひと"],[6,1,"むすめ"],[8,1,"おんな"],[9,2,"どれい"],[14,1,"う"],[22,1,"むすめ"],[24,1,"おとこ"],[25,2,"どれい"],[28,1,"さ"],[33,1,"さ"]],"text":"もし人がその娘を女奴隷として売るならば、その娘は男奴隷が去るように去ってはならない。"},{"ref":"Exod.21.8","start":2021008,"end":2021008,"break":"none","ruby":[[0,2,"かのじょ"],[5,2,"かのじょ"],[8,2,"じぶん"],[14,1,"さだ"],[17,2,"しゅじん"],[20,1,"き"],[26,1,"とき"],[31,2,"しゅじん"],[34,2,"かのじょ"],[51,1,"ゆる"],[62,1,"かれ"],[67,1,"あざむ"],[80,2,"たこく"],[83,1,"たみ"],[85,1,"う"],[87,2,"けんり"]],"text":"彼女がもし彼女を自分のものと定めた主人の気にいらない時は、その主人は彼女が、あがなわれることを、これに許さなければならない。彼はこれを欺いたのであるから、これを他国の民に売る権利はない。"},{"ref":"Exod.21.9","start":2021009,"end":2021009,"break":"none","ruby":[[0,1,"かれ"],[4,2,"かのじょ"],[7,2,"じぶん"],[10,1,"こ"],[15,1,"さだ"],[25,1,"むすめ"],[30,1,"あつか"]],"text":"彼がもし彼女を自分の子のものと定めるならば、これを娘のように扱わなければならない。"},{"ref":"Exod.21.10","start":2021010,"end":2021010,"break":"none","ruby":[[0,1,"かれ"],[10,1,"おんな"],[23,1,"まえ"],[25,1,"おんな"],[27,2,"しょくもつ"],[30,2,"いふく"],[33,1,"あた"],[42,2,"ふうふ"],[45,1,"みち"],[48,1,"た"]],"text":"彼が、たとい、ほかに女をめとることがあっても、前の女に食物と衣服を与えることと、その夫婦の道とを絶えさせてはならない。"},{"ref":"Exod.21.11","start":2021011,"end":2021011,"break":"none","ruby":[[0,1,"かれ"],[9,1,"おこな"],[17,2,"かのじょ"],[20,1,"かね"],[22,1,"つぐな"],[26,1,"さ"]],"text":"彼がもしこの三つを行わないならば、彼女は金を償わずに去ることができる。"},{"ref":"Exod.21.12","start":2021012,"end":2021012,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"う"],[5,1,"し"],[9,1,"もの"],[12,1,"かなら"],[14,1,"ころ"]],"text":"人を撃って死なせた者は、必ず殺されなければならない。"},{"ref":"Exod.21.13","start":2021013,"end":2021013,"break":"none","ruby":[[4,1,"ひと"],[18,1,"かみ"],[20,1,"かれ"],[22,1,"て"],[24,1,"ひと"],[36,1,"とき"],[53,1,"ところ"],[55,1,"さだ"],[60,1,"かれ"],[64,1,"ところ"]],"text":"しかし、人がたくむことをしないのに、神が彼の手に人をわたされることのある時は、わたしはあなたのために一つの所を定めよう。彼はその所へのがれることができる。"},{"ref":"Exod.21.14","start":2021014,"end":2021014,"break":"none","ruby":[[3,1,"ひと"],[15,2,"りんじん"],[18,1,"あざむ"],[21,1,"ころ"],[23,1,"とき"],[28,1,"もの"],[34,2,"さいだん"],[41,1,"とら"],[44,1,"い"],[47,1,"ころ"]],"text":"しかし人がもし、ことさらにその隣人を欺いて殺す時は、その者をわたしの祭壇からでも、捕えて行って殺さなければならない。"},{"ref":"Exod.21.15","start":2021015,"end":2021015,"break":"paragraph","ruby":[[0,2,"じぶん"],[3,1,"ちち"],[7,1,"はは"],[9,1,"う"],[11,1,"もの"],[14,1,"かなら"],[16,1,"ころ"]],"text":"自分の父または母を撃つ者は、必ず殺されなければならない。"},{"ref":"Exod.21.16","start":2021016,"end":2021016,"break":"paragraph","ruby":[[0,1,"ひと"],[8,1,"もの"],[14,1,"う"],[23,1,"かれ"],[25,1,"て"],[32,1,"かなら"],[34,1,"ころ"]],"text":"人をかどわかした者は、これを売っていても、なお彼の手にあっても、必ず殺されなければならない。"},{"ref":"Exod.21.17","start":2021017,"end":2021017,"break":"paragraph","ruby":[[0,2,"じぶん"],[3,1,"ちち"],[7,1,"はは"],[12,1,"もの"],[15,1,"かなら"],[17,1,"ころ"]],"text":"自分の父または母をのろう者は、必ず殺されなければならない。"},{"ref":"Exod.21.18","start":2021018,"end":2021018,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"たがい"],[4,1,"あらそ"],[13,1,"いし"],[22,2,"あいて"],[25,1,"う"],[28,1,"とき"],[33,1,"し"],[38,1,"とこ"]],"text":"人が互に争い、そのひとりが石または、こぶしで相手を撃った時、これが死なないで床につき、"},{"ref":"Exod.21.19","start":2021019,"end":2021019,"break":"none","ruby":[[0,1,"ふたた"],[2,1,"お"],[16,1,"そと"],[18,1,"ある"],[32,1,"う"],[35,1,"もの"],[52,2,"しごと"],[55,1,"やす"],[58,2,"そんしつ"],[61,1,"つぐな"],[74,2,"ちりょう"]],"text":"再び起きあがって、つえにすがり、外を歩くようになるならば、これを撃った者は、ゆるされるであろう。ただその仕事を休んだ損失を償い、かつこれにじゅうぶん治療させなければならない。"},{"ref":"Exod.21.20","start":2021020,"end":2021020,"break":"paragraph","ruby":[[2,1,"ひと"],[11,2,"じぶん"],[14,1,"おとこ"],[15,2,"どれい"],[20,1,"おんな"],[21,2,"どれい"],[24,1,"う"],[29,1,"て"],[31,1,"した"],[33,1,"し"],[39,1,"かなら"],[41,1,"ばっ"]],"text":"もし人がつえをもって、自分の男奴隷または女奴隷を撃ち、その手の下に死ぬならば、必ず罰せられなければならない。"},{"ref":"Exod.21.21","start":2021021,"end":2021021,"break":"none","ruby":[[4,1,"かれ"],[9,1,"にち"],[15,1,"い"],[17,1,"の"],[26,1,"ひと"],[28,1,"ばっ"],[35,2,"どれい"],[38,1,"かれ"],[40,2,"ざいさん"]],"text":"しかし、彼がもし一日か、ふつか生き延びるならば、その人は罰せられない。奴隷は彼の財産だからである。"},{"ref":"Exod.21.22","start":2021022,"end":2021022,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"たがい"],[6,1,"あらそ"],[10,1,"み"],[15,1,"おんな"],[17,1,"う"],[23,2,"りゅうざん"],[35,1,"がい"],[42,1,"かれ"],[44,1,"かなら"],[48,1,"おんな"],[50,1,"おっと"],[52,1,"もと"],[55,2,"ばっきん"],[58,1,"か"],[63,3,"さいばんにん"],[67,1,"さだ"],[74,2,"しはら"]],"text":"もし人が互に争って、身ごもった女を撃ち、これに流産させるならば、ほかの害がなくとも、彼は必ずその女の夫の求める罰金を課せられ、裁判人の定めるとおりに支払わなければならない。"},{"ref":"Exod.21.23","start":2021023,"end":2021023,"break":"none","ruby":[[7,1,"がい"],[11,1,"とき"],[14,1,"いのち"],[17,1,"いのち"]],"text":"しかし、ほかの害がある時は、命には命、"},{"ref":"Exod.21.24","start":2021024,"end":2021024,"break":"none","ruby":[[0,1,"め"],[3,1,"め"],[5,1,"は"],[8,1,"は"],[10,1,"て"],[13,1,"て"],[15,1,"あし"],[18,1,"あし"]],"text":"目には目、歯には歯、手には手、足には足、"},{"ref":"Exod.21.25","start":2021025,"end":2021025,"break":"none","ruby":[[0,1,"や"],[2,1,"きず"],[5,1,"や"],[7,1,"きず"],[9,1,"きず"],[12,1,"きず"],[14,1,"う"],[16,1,"きず"],[19,1,"う"],[21,1,"きず"],[26,1,"つぐな"]],"text":"焼き傷には焼き傷、傷には傷、打ち傷には打ち傷をもって償わなければならない。"},{"ref":"Exod.21.26","start":2021026,"end":2021026,"break":"paragraph","ruby":[[2,1,"ひと"],[4,2,"じぶん"],[7,1,"おとこ"],[8,2,"どれい"],[11,2,"かため"],[17,1,"おんな"],[18,2,"どれい"],[21,2,"かため"],[24,1,"う"],[39,1,"め"],[47,2,"じゆう"],[50,1,"み"],[54,1,"さ"]],"text":"もし人が自分の男奴隷の片目、または女奴隷の片目を撃ち、これをつぶすならば、その目のためにこれを自由の身として去らせなければならない。"},{"ref":"Exod.21.27","start":2021027,"end":2021027,"break":"none","ruby":[[7,1,"おとこ"],[8,2,"どれい"],[12,1,"ぽん"],[14,1,"は"],[21,1,"おんな"],[22,2,"どれい"],[26,1,"ぽん"],[28,1,"は"],[30,1,"う"],[32,1,"おと"],[40,1,"は"],[48,2,"じゆう"],[51,1,"み"],[55,1,"さ"]],"text":"また、もしその男奴隷の一本の歯、またはその女奴隷の一本の歯を撃ち落すならば、その歯のためにこれを自由の身として去らせなければならない。"},{"ref":"Exod.21.28","start":2021028,"end":2021028,"break":"paragraph","ruby":[[2,1,"うし"],[4,1,"おとこ"],[8,1,"おんな"],[10,1,"つ"],[13,1,"ころ"],[21,1,"うし"],[23,1,"かなら"],[25,1,"いし"],[27,1,"う"],[29,1,"ころ"],[43,1,"にく"],[45,1,"た"],[60,1,"うし"],[62,1,"も"],[64,1,"ぬし"],[66,1,"つみ"]],"text":"もし牛が男または女を突いて殺すならば、その牛は必ず石で撃ち殺されなければならない。その肉は食べてはならない。しかし、その牛の持ち主は罪がない。"},{"ref":"Exod.21.29","start":2021029,"end":2021029,"break":"none","ruby":[[0,1,"うし"],[4,2,"いぜん"],[8,1,"つ"],[10,1,"くせ"],[18,1,"も"],[20,1,"ぬし"],[22,2,"ちゅうい"],[32,1,"まも"],[44,1,"おとこ"],[48,1,"おんな"],[50,1,"ころ"],[59,1,"うし"],[61,1,"いし"],[63,1,"う"],[65,1,"ころ"],[71,1,"も"],[73,1,"ぬし"],[77,1,"ころ"]],"text":"牛がもし以前から突く癖があって、その持ち主が注意されても、これを守りおかなかったために、男または女を殺したならば、その牛は石で撃ち殺され、その持ち主もまた殺されなければならない。"},{"ref":"Exod.21.30","start":2021030,"end":2021030,"break":"none","ruby":[[0,1,"かれ"],[10,1,"かね"],[12,1,"か"],[24,1,"か"],[36,1,"いのち"],[38,1,"つぐな"],[41,2,"しはら"]],"text":"彼がもし、あがないの金を課せられたならば、すべて課せられたほどのものを、命の償いに支払わなければならない。"},{"ref":"Exod.21.31","start":2021031,"end":2021031,"break":"none","ruby":[[0,1,"おとこ"],[2,1,"こ"],[4,1,"つ"],[9,1,"おんな"],[11,1,"こ"],[13,1,"つ"],[20,1,"さだ"],[23,1,"したが"],[26,2,"しょち"]],"text":"男の子を突いても、女の子を突いても、この定めに従って処置されなければならない。"},{"ref":"Exod.21.32","start":2021032,"end":2021032,"break":"none","ruby":[[0,1,"うし"],[4,1,"おとこ"],[5,2,"どれい"],[10,1,"おんな"],[11,2,"どれい"],[14,1,"つ"],[22,2,"しゅじん"],[25,1,"ぎん"],[32,2,"しはら"],[48,1,"うし"],[50,1,"いし"],[52,1,"う"],[54,1,"ころ"]],"text":"牛がもし男奴隷または女奴隷を突くならば、その主人に銀三十シケルを支払わなければならない。またその牛は石で撃ち殺されなければならない。"},{"ref":"Exod.21.33","start":2021033,"end":2021033,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"あな"],[12,1,"お"],[19,1,"あな"],[21,1,"ほ"],[38,1,"うし"],[49,1,"お"],[51,1,"こ"]],"text":"もし人が穴をあけたままに置き、あるいは穴を掘ってこれにおおいをしないために、牛または、ろばがこれに落ち込むことがあれば、"},{"ref":"Exod.21.34","start":2021034,"end":2021034,"break":"none","ruby":[[0,1,"あな"],[2,1,"も"],[4,1,"ぬし"],[9,1,"つぐな"],[12,1,"かね"],[16,1,"も"],[18,1,"ぬし"],[20,2,"しはら"],[38,1,"し"],[41,1,"けもの"],[43,1,"かれ"]],"text":"穴の持ち主はこれを償い、金をその持ち主に支払わなければならない。しかし、その死んだ獣は彼のものとなるであろう。"},{"ref":"Exod.21.35","start":2021035,"end":2021035,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"うし"],[9,2,"たにん"],[12,1,"うし"],[14,1,"つ"],[17,1,"ころ"],[23,1,"かれ"],[28,1,"い"],[33,1,"うし"],[35,1,"う"],[41,1,"あたい"],[43,1,"わ"],[50,1,"し"],[57,1,"わ"]],"text":"ある人の牛が、もし他人の牛を突いて殺すならば、彼らはその生きている牛を売って、その価を分け、またその死んだものをも分けなければならない。"},{"ref":"Exod.21.36","start":2021036,"end":2021036,"break":"none","ruby":[[6,1,"うし"],[8,2,"いぜん"],[12,1,"つ"],[14,1,"くせ"],[21,1,"し"],[32,1,"も"],[34,1,"ぬし"],[39,1,"まも"],[53,1,"ひと"],[55,1,"かなら"],[59,1,"うし"],[64,1,"うし"],[69,1,"つぐな"],[86,1,"し"],[89,1,"けもの"],[91,1,"かれ"]],"text":"あるいはその牛が以前から突く癖のあることが知られているのに、その持ち主がこれを守りおかなかったならば、その人は必ずその牛のために牛をもって償わなければならない。しかし、その死んだ獣は彼のものとなるであろう。"}]