[{"ref":"Luke.22.1","start":42022001,"end":42022001,"break":"paragraph","ruby":[[3,2,"すぎこし"],[12,3,"じょこうさい"],[16,1,"ちか"]],"text":"さて、過越といわれている除酵祭が近づいた。"},{"ref":"Luke.22.2","start":42022002,"end":42022002,"break":"none","ruby":[[0,3,"さいしちょう"],[6,2,"りっぽう"],[8,2,"がくしゃ"],[23,1,"ころ"],[27,1,"はか"],[33,2,"みんしゅう"],[36,1,"おそ"]],"text":"祭司長たちや律法学者たちは、どうかしてイエスを殺そうと計っていた。民衆を恐れていたからである。"},{"ref":"Luke.22.3","start":42022003,"end":42022003,"break":"paragraph","ruby":[[7,2,"でし"],[22,1,"よ"]],"text":"そのとき、十二弟子のひとりで、イスカリオテと呼ばれていたユダに、サタンがはいった。"},{"ref":"Luke.22.4","start":42022004,"end":42022004,"break":"none","ruby":[[5,1,"かれ"],[7,3,"さいしちょう"],[13,2,"みやもり"],[25,1,"い"],[37,1,"かれ"],[40,1,"わた"],[48,2,"ほうほう"],[54,2,"きょうぎ"]],"text":"すなわち、彼は祭司長たちや宮守がしらたちのところへ行って、どうしてイエスを彼らに渡そうかと、その方法について協議した。"},{"ref":"Luke.22.5","start":42022005,"end":42022005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"よろこ"],[10,1,"かね"],[12,1,"あた"],[15,2,"とりき"]],"text":"彼らは喜んで、ユダに金を与える取決めをした。"},{"ref":"Luke.22.6","start":42022006,"end":42022006,"break":"none","ruby":[[6,2,"しょうだく"],[15,2,"ぐんしゅう"],[28,1,"ひ"],[30,1,"わた"],[35,2,"きかい"]],"text":"ユダはそれを承諾した。そして、群衆のいないときにイエスを引き渡そうと、機会をねらっていた。"},{"ref":"Luke.22.7","start":42022007,"end":42022007,"break":"paragraph","ruby":[[3,2,"すぎこし"],[6,2,"こひつじ"],[14,3,"じょこうさい"],[18,1,"ひ"]],"text":"さて、過越の小羊をほふるべき除酵祭の日がきたので、"},{"ref":"Luke.22.8","start":42022008,"end":42022008,"break":"none","ruby":[[13,1,"つか"],[16,1,"だ"],[19,1,"い"],[25,1,"い"],[29,2,"すぎこし"],[32,2,"しょくじ"],[41,2,"じゅんび"]],"text":"イエスはペテロとヨハネとを使いに出して言われた、「行って、過越の食事ができるように準備をしなさい」。"},{"ref":"Luke.22.9","start":42022009,"end":42022009,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[11,2,"じゅんび"]],"text":"彼らは言った、「どこに準備をしたらよいのですか」。"},{"ref":"Luke.22.10","start":42022010,"end":42022010,"break":"none","ruby":[[4,1,"い"],[10,2,"しない"],[19,1,"みず"],[23,1,"も"],[28,1,"おとこ"],[30,2,"であ"],[40,1,"ひと"],[45,1,"いえ"],[51,1,"い"]],"text":"イエスは言われた、「市内にはいったら、水がめを持っている男に出会うであろう。その人がはいる家までついて行って、"},{"ref":"Luke.22.11","start":42022011,"end":42022011,"break":"none","ruby":[[2,1,"いえ"],[4,2,"しゅじん"],[7,1,"い"],[14,2,"でし"],[19,2,"いっしょ"],[22,2,"すぎこし"],[25,2,"しょくじ"],[30,2,"ざしき"],[38,2,"せんせい"],[41,1,"い"]],"text":"その家の主人に言いなさい、『弟子たちと一緒に過越の食事をする座敷はどこか、と先生が言っておられます』。"},{"ref":"Luke.22.12","start":42022012,"end":42022012,"break":"none","ruby":[[6,2,"しゅじん"],[9,1,"せき"],[11,1,"ととの"],[17,1,"かい"],[19,2,"ひろま"],[22,1,"み"],[34,2,"ようい"]],"text":"すると、その主人は席の整えられた二階の広間を見せてくれるから、そこに用意をしなさい」。"},{"ref":"Luke.22.13","start":42022013,"end":42022013,"break":"none","ruby":[[0,2,"でし"],[5,1,"で"],[7,1,"い"],[18,1,"い"],[32,2,"すぎこし"],[35,2,"しょくじ"],[38,2,"ようい"]],"text":"弟子たちは出て行ってみると、イエスが言われたとおりであったので、過越の食事の用意をした。"},{"ref":"Luke.22.14","start":42022014,"end":42022014,"break":"paragraph","ruby":[[0,2,"じかん"],[13,2,"しょくたく"],[20,2,"しと"],[25,1,"とも"],[27,1,"せき"]],"text":"時間になったので、イエスは食卓につかれ、使徒たちも共に席についた。"},{"ref":"Luke.22.15","start":42022015,"end":42022015,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[17,1,"くる"],[21,1,"う"],[24,1,"まえ"],[35,2,"すぎこし"],[38,2,"しょくじ"],[46,1,"せつ"],[48,1,"のぞ"]],"text":"イエスは彼らに言われた、「わたしは苦しみを受ける前に、あなたがたとこの過越の食事をしようと、切に望んでいた。"},{"ref":"Luke.22.16","start":42022016,"end":42022016,"break":"none","ruby":[[6,1,"い"],[9,1,"お"],[13,1,"かみ"],[15,1,"くに"],[17,2,"すぎこし"],[20,2,"じょうじゅ"],[24,1,"とき"],[34,1,"ど"],[39,2,"すぎこし"],[42,2,"しょくじ"]],"text":"あなたがたに言って置くが、神の国で過越が成就する時までは、わたしは二度と、この過越の食事をすることはない」。"},{"ref":"Luke.22.17","start":42022017,"end":42022017,"break":"none","ruby":[[3,1,"さかずき"],[5,1,"と"],[8,2,"かんしゃ"],[12,1,"い"],[21,1,"と"],[25,1,"たがい"],[27,1,"わ"],[30,1,"の"]],"text":"そして杯を取り、感謝して言われた、「これを取って、互に分けて飲め。"},{"ref":"Luke.22.18","start":42022018,"end":42022018,"break":"none","ruby":[[6,1,"い"],[13,1,"いま"],[18,1,"かみ"],[20,1,"くに"],[22,1,"く"],[36,1,"み"],[39,1,"つく"],[50,1,"の"]],"text":"あなたがたに言っておくが、今からのち神の国が来るまでは、わたしはぶどうの実から造ったものを、いっさい飲まない」。"},{"ref":"Luke.22.19","start":42022019,"end":42022019,"break":"none","ruby":[[5,1,"と"],[8,2,"かんしゃ"],[18,2,"でし"],[23,1,"あた"],[26,1,"い"],[45,1,"あた"],[63,2,"きねん"],[75,1,"おこな"]],"text":"またパンを取り、感謝してこれをさき、弟子たちに与えて言われた、「これは、あなたがたのために与えるわたしのからだである。わたしを記念するため、このように行いなさい」。"},{"ref":"Luke.22.20","start":42022020,"end":42022020,"break":"none","ruby":[[0,2,"しょくじ"],[6,1,"さかずき"],[8,1,"おな"],[10,1,"よう"],[14,1,"い"],[22,1,"さかずき"],[34,1,"なが"],[40,1,"ち"],[42,1,"た"],[47,1,"あたら"],[50,2,"けいやく"]],"text":"食事ののち、杯も同じ様にして言われた、「この杯は、あなたがたのために流すわたしの血で立てられる新しい契約である。"},{"ref":"Luke.22.21","start":42022021,"end":42022021,"break":"none","ruby":[[12,2,"うらぎ"],[15,1,"もの"],[22,2,"いっしょ"],[25,2,"しょくたく"],[28,1,"て"],[30,1,"お"]],"text":"しかし、そこに、わたしを裏切る者が、わたしと一緒に食卓に手を置いている。"},{"ref":"Luke.22.22","start":42022022,"end":42022022,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[4,1,"さだ"],[14,1,"さ"],[17,1,"い"],[23,1,"ひと"],[25,1,"こ"],[27,2,"うらぎ"],[32,1,"ひと"]],"text":"人の子は定められたとおりに、去って行く。しかし人の子を裏切るその人は、わざわいである」。"},{"ref":"Luke.22.23","start":42022023,"end":42022023,"break":"none","ruby":[[0,2,"でし"],[6,2,"じぶん"],[21,1,"こと"],[37,1,"たがい"],[39,1,"ろん"]],"text":"弟子たちは、自分たちのうちのだれが、そんな事をしようとしているのだろうと、互に論じはじめた。"},{"ref":"Luke.22.24","start":42022024,"end":42022024,"break":"paragraph","ruby":[[5,2,"じぶん"],[10,1,"なか"],[19,1,"えら"],[26,1,"い"],[30,2,"そうろん"],[33,1,"かれ"],[36,1,"あいだ"],[39,1,"おこ"]],"text":"それから、自分たちの中でだれがいちばん偉いだろうかと言って、争論が彼らの間に、起った。"},{"ref":"Luke.22.25","start":42022025,"end":42022025,"break":"none","ruby":[[7,1,"い"],[13,2,"いほう"],[16,1,"おう"],[22,1,"たみ"],[24,1,"うえ"],[26,2,"くんりん"],[33,2,"けんりょく"],[42,1,"もの"],[46,2,"おんじん"],[49,1,"よ"]],"text":"そこでイエスが言われた、「異邦の王たちはその民の上に君臨し、また、権力をふるっている者たちは恩人と呼ばれる。"},{"ref":"Luke.22.26","start":42022026,"end":42022026,"break":"none","ruby":[[34,1,"なか"],[40,1,"えら"],[42,1,"ひと"],[48,1,"わか"],[50,1,"もの"],[56,2,"しどう"],[60,1,"ひと"],[62,1,"つか"],[65,1,"もの"]],"text":"しかし、あなたがたは、そうであってはならない。かえって、あなたがたの中でいちばん偉い人はいちばん若い者のように、指導する人は仕える者のようになるべきである。"},{"ref":"Luke.22.27","start":42022027,"end":42022027,"break":"none","ruby":[[0,2,"しょくたく"],[5,1,"ひと"],[7,2,"きゅうじ"],[11,1,"もの"],[18,1,"えら"],[23,2,"しょくたく"],[28,1,"ひと"],[30,1,"ほう"],[51,1,"なか"],[54,2,"きゅうじ"],[59,1,"もの"]],"text":"食卓につく人と給仕する者と、どちらが偉いのか。食卓につく人の方ではないか。しかし、わたしはあなたがたの中で、給仕をする者のようにしている。"},{"ref":"Luke.22.28","start":42022028,"end":42022028,"break":"none","ruby":[[11,2,"しれん"],[22,2,"いっしょ"],[25,2,"さいご"],[29,1,"しの"],[35,1,"ひと"]],"text":"あなたがたは、わたしの試錬のあいだ、わたしと一緒に最後まで忍んでくれた人たちである。"},{"ref":"Luke.22.29","start":42022029,"end":42022029,"break":"none","ruby":[[8,1,"ちち"],[10,1,"くに"],[12,2,"しはい"]],"text":"それで、わたしの父が国の支配をわたしにゆだねてくださったように、わたしもそれをあなたがたにゆだね、"},{"ref":"Luke.22.30","start":42022030,"end":42022030,"break":"none","ruby":[[4,1,"くに"],[6,2,"しょくたく"],[12,1,"の"],[14,1,"く"],[22,1,"くらい"],[24,1,"ざ"],[36,2,"ぶぞく"]],"text":"わたしの国で食卓について飲み食いをさせ、また位に座してイスラエルの十二の部族をさばかせるであろう。"},{"ref":"Luke.22.31","start":42022031,"end":42022031,"break":"none","ruby":[[8,1,"み"],[21,1,"むぎ"],[36,1,"ねが"],[39,1,"ゆる"]],"text":"シモン、シモン、見よ、サタンはあなたがたを麦のようにふるいにかけることを願って許された。"},{"ref":"Luke.22.32","start":42022032,"end":42022032,"break":"none","ruby":[[12,2,"しんこう"],[32,1,"いの"],[44,1,"た"],[46,1,"なお"],[54,2,"きょうだい"],[59,1,"ちから"]],"text":"しかし、わたしはあなたの信仰がなくならないように、あなたのために祈った。それで、あなたが立ち直ったときには、兄弟たちを力づけてやりなさい」。"},{"ref":"Luke.22.33","start":42022033,"end":42022033,"break":"none","ruby":[[4,1,"い"],[9,1,"しゅ"],[16,1,"ごく"],[23,1,"し"],[25,1,"いた"],[36,2,"いっしょ"],[39,1,"い"],[41,2,"かくご"]],"text":"シモンが言った、「主よ、わたしは獄にでも、また死に至るまでも、あなたとご一緒に行く覚悟です」。"},{"ref":"Luke.22.34","start":42022034,"end":42022034,"break":"none","ruby":[[7,1,"い"],[22,1,"い"],[32,1,"にわとり"],[34,1,"な"],[45,1,"ど"],[50,1,"し"],[55,1,"い"]],"text":"するとイエスが言われた、「ペテロよ、あなたに言っておく。きょう、鶏が鳴くまでに、あなたは三度わたしを知らないと言うだろう」。"},{"ref":"Luke.22.35","start":42022035,"end":42022035,"break":"paragraph","ruby":[[3,1,"かれ"],[6,1,"い"],[16,2,"さいふ"],[19,1,"ふくろ"],[24,1,"も"],[43,1,"なに"],[58,1,"かれ"],[67,1,"なに"],[79,1,"こた"]],"text":"そして彼らに言われた、「わたしが財布も袋もくつも持たせずにあなたがたをつかわしたとき、何かこまったことがあったか」。彼らは、「いいえ、何もありませんでした」と答えた。"},{"ref":"Luke.22.36","start":42022036,"end":42022036,"break":"none","ruby":[[3,1,"い"],[12,1,"いま"],[15,2,"さいふ"],[27,1,"も"],[30,1,"い"],[33,1,"ふくろ"],[35,2,"どうよう"],[38,1,"も"],[41,1,"い"],[53,1,"もの"],[56,2,"じぶん"],[59,2,"うわぎ"],[62,1,"う"],[69,1,"か"]],"text":"そこで言われた、「しかし今は、財布のあるものは、それを持って行け。袋も同様に持って行け。また、つるぎのない者は、自分の上着を売って、それを買うがよい。"},{"ref":"Luke.22.37","start":42022037,"end":42022037,"break":"none","ruby":[[6,1,"い"],[11,1,"かれ"],[13,2,"つみびと"],[20,1,"かぞ"],[41,1,"み"],[43,1,"な"],[64,1,"かか"],[70,2,"じょうじゅ"]],"text":"あなたがたに言うが、『彼は罪人のひとりに数えられた』としるしてあることは、わたしの身に成しとげられねばならない。そうだ、わたしに係わることは成就している」。"},{"ref":"Luke.22.38","start":42022038,"end":42022038,"break":"none","ruby":[[0,2,"でし"],[5,1,"い"],[10,1,"しゅ"],[28,1,"ふ"],[41,1,"い"]],"text":"弟子たちが言った、「主よ、ごらんなさい、ここにつるぎが二振りございます」。イエスは言われた、「それでよい」。"},{"ref":"Luke.22.39","start":42022039,"end":42022039,"break":"paragraph","ruby":[[4,1,"で"],[17,1,"やま"],[19,1,"い"],[25,2,"でし"],[30,1,"したが"],[33,1,"い"]],"text":"イエスは出て、いつものようにオリブ山に行かれると、弟子たちも従って行った。"},{"ref":"Luke.22.40","start":42022040,"end":42022040,"break":"none","ruby":[[4,2,"ばしょ"],[7,1,"つ"],[13,1,"かれ"],[16,1,"い"],[22,2,"ゆうわく"],[25,1,"おちい"],[32,1,"いの"]],"text":"いつもの場所に着いてから、彼らに言われた、「誘惑に陥らないように祈りなさい」。"},{"ref":"Luke.22.41","start":42022041,"end":42022041,"break":"none","ruby":[[4,2,"じぶん"],[8,1,"いし"],[10,1,"な"],[18,1,"はな"],[25,1,"しりぞ"],[35,1,"いの"],[38,1,"い"]],"text":"そしてご自分は、石を投げてとどくほど離れたところへ退き、ひざまずいて、祈って言われた、"},{"ref":"Luke.22.42","start":42022042,"end":42022042,"break":"none","ruby":[[1,1,"ちち"],[18,1,"さかずき"],[25,1,"と"],[43,1,"おも"],[55,1,"な"]],"text":"「父よ、みこころならば、どうぞ、この杯をわたしから取りのけてください。しかし、わたしの思いではなく、みこころが成るようにしてください」。"},{"ref":"Luke.22.43","start":42022043,"end":42022043,"break":"none","ruby":[[5,2,"みつかい"],[8,1,"てん"],[20,1,"ちから"]],"text":"そのとき、御使が天からあらわれてイエスを力づけた。"},{"ref":"Luke.22.44","start":42022044,"end":42022044,"break":"none","ruby":[[4,1,"くる"],[16,1,"せつ"],[18,1,"いの"],[29,1,"あせ"],[31,1,"ち"],[41,1,"ち"],[43,1,"お"]],"text":"イエスは苦しみもだえて、ますます切に祈られた。そして、その汗が血のしたたりのように地に落ちた。"},{"ref":"Luke.22.45","start":42022045,"end":42022045,"break":"none","ruby":[[0,1,"いのり"],[2,1,"お"],[5,1,"た"],[11,2,"でし"],[20,1,"い"],[26,1,"かれ"],[29,1,"かな"],[35,2,"ねい"]],"text":"祈を終えて立ちあがり、弟子たちのところへ行かれると、彼らが悲しみのはて寝入っているのをごらんになって"},{"ref":"Luke.22.46","start":42022046,"end":42022046,"break":"none","ruby":[[0,1,"い"],[8,1,"ねむ"],[16,2,"ゆうわく"],[19,1,"おちい"],[27,1,"お"],[30,1,"いの"]],"text":"言われた、「なぜ眠っているのか。誘惑に陥らないように、起きて祈っていなさい」。"},{"ref":"Luke.22.47","start":42022047,"end":42022047,"break":"paragraph","ruby":[[8,1,"い"],[22,2,"ぐんしゅう"],[25,1,"あらわ"],[30,2,"でし"],[42,1,"もの"],[44,2,"せんとう"],[47,1,"た"],[55,2,"せっぷん"],[63,1,"ちか"]],"text":"イエスがまだそう言っておられるうちに、そこに群衆が現れ、十二弟子のひとりでユダという者が先頭に立って、イエスに接吻しようとして近づいてきた。"},{"ref":"Luke.22.48","start":42022048,"end":42022048,"break":"none","ruby":[[7,1,"い"],[20,2,"せっぷん"],[26,1,"ひと"],[28,1,"こ"],[30,2,"うらぎ"]],"text":"そこでイエスは言われた、「ユダ、あなたは接吻をもって人の子を裏切るのか」。"},{"ref":"Luke.22.49","start":42022049,"end":42022049,"break":"none","ruby":[[9,1,"ひと"],[14,1,"こと"],[21,1,"み"],[25,1,"しゅ"],[32,1,"き"],[46,1,"い"]],"text":"イエスのそばにいた人たちは、事のなりゆきを見て、「主よ、つるぎで切りつけてやりましょうか」と言って、"},{"ref":"Luke.22.50","start":42022050,"end":42022050,"break":"none","ruby":[[10,3,"さいしちょう"],[14,1,"しもべ"],[16,1,"き"],[23,1,"みぎ"],[25,1,"みみ"],[27,1,"き"],[29,1,"おと"]],"text":"そのうちのひとりが、祭司長の僕に切りつけ、その右の耳を切り落した。"},{"ref":"Luke.22.51","start":42022051,"end":42022051,"break":"none","ruby":[[7,1,"たい"],[10,1,"い"],[34,1,"しもべ"],[36,1,"みみ"],[38,1,"て"],[40,1,"ふれ"]],"text":"イエスはこれに対して言われた、「それだけでやめなさい」。そして、その僕の耳に手を触て、おいやしになった。"},{"ref":"Luke.22.52","start":42022052,"end":42022052,"break":"none","ruby":[[5,2,"じぶん"],[12,1,"く"],[14,3,"さいしちょう"],[18,2,"みやもり"],[24,2,"ちょうろう"],[29,1,"たい"],[32,1,"い"],[45,2,"ごうとう"],[54,1,"けん"],[56,1,"ぼう"],[58,1,"も"],[61,1,"で"]],"text":"それから、自分にむかって来る祭司長、宮守がしら、長老たちに対して言われた、「あなたがたは、強盗にむかうように剣や棒を持って出てきたのか。"},{"ref":"Luke.22.53","start":42022053,"end":42022053,"break":"none","ruby":[[0,2,"まいにち"],[8,2,"いっしょ"],[11,1,"みや"],[15,1,"とき"],[23,1,"て"],[35,1,"いま"],[43,1,"とき"],[51,2,"しはい"],[54,1,"とき"]],"text":"毎日あなたがたと一緒に宮にいた時には、わたしに手をかけなかった。だが、今はあなたがたの時、また、やみの支配の時である」。"},{"ref":"Luke.22.54","start":42022054,"end":42022054,"break":"paragraph","ruby":[[4,2,"ひとびと"],[11,1,"とら"],[19,3,"だいさいし"],[23,2,"ていたく"],[29,1,"い"],[37,1,"とお"],[44,1,"い"]],"text":"それから人々はイエスを捕え、ひっぱって大祭司の邸宅へつれて行った。ペテロは遠くからついて行った。"},{"ref":"Luke.22.55","start":42022055,"end":42022055,"break":"none","ruby":[[0,2,"ひとびと"],[3,2,"なかにわ"],[8,1,"なか"],[10,1,"ひ"],[16,2,"いっしょ"],[34,1,"なか"]],"text":"人々は中庭のまん中に火をたいて、一緒にすわっていたので、ペテロもその中にすわった。"},{"ref":"Luke.22.56","start":42022056,"end":42022056,"break":"none","ruby":[[6,2,"じょちゅう"],[10,1,"かれ"],[12,1,"ひ"],[25,1,"み"],[27,1,"かれ"],[29,1,"み"],[37,1,"ひと"],[43,2,"いっしょ"],[52,1,"い"]],"text":"すると、ある女中が、彼が火のそばにすわっているのを見、彼を見つめて、「この人もイエスと一緒にいました」と言った。"},{"ref":"Luke.22.57","start":42022057,"end":42022057,"break":"none","ruby":[[7,1,"う"],[9,1,"け"],[20,1,"ひと"],[22,1,"し"],[28,1,"い"]],"text":"ペテロはそれを打ち消して、「わたしはその人を知らない」と言った。"},{"ref":"Luke.22.58","start":42022058,"end":42022058,"break":"none","ruby":[[10,1,"ひと"],[16,1,"み"],[18,1,"い"],[29,2,"なかま"],[45,1,"い"]],"text":"しばらくして、ほかの人がペテロを見て言った、「あなたもあの仲間のひとりだ」。するとペテロは言った、「いや、それはちがう」。"},{"ref":"Luke.22.59","start":42022059,"end":42022059,"break":"none","ruby":[[0,1,"やく"],[2,2,"じかん"],[15,1,"もの"],[17,1,"い"],[19,1,"は"],[30,1,"ひと"],[36,2,"いっしょ"],[44,1,"ひと"],[50,1,"びと"]],"text":"約一時間たってから、またほかの者が言い張った、「たしかにこの人もイエスと一緒だった。この人もガリラヤ人なのだから」。"},{"ref":"Luke.22.60","start":42022060,"end":42022060,"break":"none","ruby":[[4,1,"い"],[13,1,"い"],[37,1,"かれ"],[41,1,"い"],[43,1,"おわ"],[55,1,"にわとり"],[57,1,"な"]],"text":"ペテロは言った、「あなたの言っていることは、わたしにわからない」。すると、彼がまだ言い終らぬうちに、たちまち、鶏が鳴いた。"},{"ref":"Luke.22.61","start":42022061,"end":42022061,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"ふ"],[11,1,"み"],[32,1,"にわとり"],[34,1,"な"],[36,1,"まえ"],[40,1,"ど"],[45,1,"し"],[50,1,"い"],[58,1,"い"],[62,1,"しゅ"],[65,2,"ことば"],[68,1,"おも"],[70,1,"だ"]],"text":"主は振りむいてペテロを見つめられた。そのときペテロは、「きょう、鶏が鳴く前に、三度わたしを知らないと言うであろう」と言われた主のお言葉を思い出した。"},{"ref":"Luke.22.62","start":42022062,"end":42022062,"break":"none","ruby":[[3,1,"そと"],[5,1,"で"],[8,1,"はげ"],[11,1,"な"]],"text":"そして外へ出て、激しく泣いた。"},{"ref":"Luke.22.63","start":42022063,"end":42022063,"break":"paragraph","ruby":[[4,2,"かんし"],[10,1,"ひと"],[19,2,"ちょうろう"],[23,1,"う"]],"text":"イエスを監視していた人たちは、イエスを嘲弄し、打ちたたき、"},{"ref":"Luke.22.64","start":42022064,"end":42022064,"break":"none","ruby":[[0,1,"め"],[9,1,"い"],[17,1,"う"]],"text":"目かくしをして、「言いあててみよ。打ったのは、だれか」ときいたりした。"},{"ref":"Luke.22.65","start":42022065,"end":42022065,"break":"none","ruby":[[10,1,"こと"],[12,1,"い"],[20,2,"ぐろう"]],"text":"そのほか、いろいろな事を言って、イエスを愚弄した。"},{"ref":"Luke.22.66","start":42022066,"end":42022066,"break":"paragraph","ruby":[[0,1,"よ"],[2,1,"あ"],[8,2,"じんみん"],[11,2,"ちょうろう"],[14,3,"さいしちょう"],[20,2,"りっぽう"],[22,2,"がくしゃ"],[27,1,"あつ"],[35,2,"ぎかい"],[38,1,"ひ"],[40,1,"だ"],[43,1,"い"]],"text":"夜が明けたとき、人民の長老、祭司長たち、律法学者たちが集まり、イエスを議会に引き出して言った、"},{"ref":"Luke.22.67","start":42022067,"end":42022067,"break":"none","ruby":[[14,1,"い"],[28,1,"い"],[38,1,"い"],[49,1,"しん"]],"text":"「あなたがキリストなら、そう言ってもらいたい」。イエスは言われた、「わたしが言っても、あなたがたは信じないだろう。"},{"ref":"Luke.22.68","start":42022068,"end":42022068,"break":"none","ruby":[[13,1,"こた"]],"text":"また、わたしがたずねても、答えないだろう。"},{"ref":"Luke.22.69","start":42022069,"end":42022069,"break":"none","ruby":[[4,1,"ひと"],[6,1,"こ"],[8,1,"いま"],[14,2,"ぜんのう"],[17,1,"かみ"],[19,1,"みぎ"],[21,1,"ざ"]],"text":"しかし、人の子は今からのち、全能の神の右に座するであろう」。"},{"ref":"Luke.22.70","start":42022070,"end":42022070,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[15,1,"かみ"],[17,1,"こ"],[27,1,"い"],[39,1,"い"]],"text":"彼らは言った、「では、あなたは神の子なのか」。イエスは言われた、「あなたがたの言うとおりである」。"},{"ref":"Luke.22.71","start":42022071,"end":42022071,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[13,2,"いじょう"],[19,2,"しょうこ"],[31,2,"ちょくせつ"],[33,1,"かれ"],[35,1,"くち"],[38,1,"き"]],"text":"すると彼らは言った、「これ以上、なんの証拠がいるか。われわれは直接彼の口から聞いたのだから」。"}]