[{"ref":"Ezra.10.1","start":15010001,"end":15010001,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"みや"],[8,1,"まえ"],[10,1,"な"],[12,1,"ふ"],[15,1,"いの"],[27,1,"とき"],[29,1,"おとこ"],[31,1,"おんな"],[35,2,"こども"],[38,1,"おお"],[42,2,"ぐんしゅう"],[55,1,"かれ"],[60,1,"あつ"],[67,1,"たみ"],[72,1,"な"],[74,1,"かな"]],"text":"エズラが神の宮の前に泣き伏して祈り、かつざんげしていた時、男、女および子供の大いなる群集がイスラエルのうちから彼のもとに集まってきた。民はいたく泣き悲しんだ。"},{"ref":"Ezra.10.2","start":15010002,"end":15010002,"break":"none","ruby":[[0,1,"とき"],[6,2,"しそん"],[17,1,"こ"],[28,1,"つ"],[31,1,"い"],[41,1,"かみ"],[47,1,"つみ"],[49,1,"おか"],[54,1,"ち"],[56,1,"たみ"],[59,2,"いほう"],[62,1,"おんな"],[91,1,"いま"],[94,1,"のぞ"]],"text":"時にエラムの子孫のうちのエヒエルの子シカニヤが、エズラに告げて言った、「われわれは神にむかって罪を犯し、この地の民から異邦の女をめとりました。しかし、このことについてはイスラエルに、今なお望みがあります。"},{"ref":"Ezra.10.3","start":15010003,"end":15010003,"break":"none","ruby":[[10,1,"しゅ"],[12,1,"おしえ"],[20,1,"かみ"],[22,2,"めいれい"],[29,2,"ひとびと"],[32,1,"おしえ"],[35,1,"したが"],[43,1,"つま"],[50,1,"こ"],[51,1,"とも"],[61,1,"お"],[63,1,"だ"],[68,2,"けいやく"],[77,1,"かみ"],[79,1,"た"],[89,2,"りっぽう"],[92,1,"したが"],[98,1,"おこな"]],"text":"それでわれわれはわが主の教と、われわれの神の命令におののく人々の教とに従って、これらの妻ならびにその子供たちを、ことごとく追い出すという契約を、われわれの神に立てましょう。そして律法に従ってこれを行いましょう。"},{"ref":"Ezra.10.4","start":15010004,"end":15010004,"break":"none","ruby":[[0,1,"た"],[13,1,"こと"],[19,2,"しごと"],[33,1,"たす"],[38,1,"こころ"],[40,1,"つよ"],[47,1,"おこな"]],"text":"立ちあがってください、この事はあなたの仕事です。われわれはあなたを助けます。心を強くしてこれを行いなさい」。"},{"ref":"Ezra.10.5","start":15010005,"end":15010005,"break":"none","ruby":[[4,1,"た"],[13,2,"さいし"],[38,2,"ことば"],[44,1,"おこな"],[49,1,"ちか"],[56,1,"かれ"],[59,1,"ちか"]],"text":"エズラは立って、おもだった祭司、レビびとおよびすべてのイスラエルびとに、この言葉のように行うことを誓わせたので、彼らは誓った。"},{"ref":"Ezra.10.6","start":15010006,"end":15010006,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"みや"],[8,1,"まえ"],[11,1,"で"],[20,1,"こ"],[38,1,"い"],[42,1,"かれ"],[47,1,"た"],[51,1,"みず"],[53,1,"の"],[57,1,"よる"],[59,1,"す"],[67,1,"かれ"],[70,2,"ほしゅう"],[74,1,"かえ"],[77,2,"ひとびと"],[83,1,"なげ"]],"text":"エズラは神の宮の前から出て、エリアシブの子ヨハナンのへやにはいったが、そこへ行っても彼はパンも食べず、水も飲まずに夜を過ごした。これは彼が、捕囚から帰った人々のとがを嘆いたからである。"},{"ref":"Ezra.10.7","start":15010007,"end":15010007,"break":"none","ruby":[[18,2,"ふこく"],[21,1,"だ"],[24,2,"ほしゅう"],[28,1,"かえ"],[35,1,"もの"],[37,1,"つ"],[47,1,"あつ"],[52,1,"こと"]],"text":"そしてユダおよびエルサレムにあまねく布告を出し、捕囚から帰ったすべての者に告げて、エルサレムに集まるべき事と、"},{"ref":"Ezra.10.8","start":15010008,"end":15010008,"break":"none","ruby":[[6,2,"ちょうろう"],[15,1,"したが"],[20,1,"か"],[28,1,"もの"],[36,2,"ざいさん"],[44,2,"ぼっしゅう"],[51,1,"ひと"],[52,2,"じしん"],[55,1,"とら"],[58,1,"びと"],[60,1,"かい"],[63,2,"はもん"],[69,1,"い"]],"text":"つかさおよび長老たちのさとしに従って、三日のうちにこない者はだれでもその財産はことごとく没収され、その人自身は捕われ人の会から破門されると言った。"},{"ref":"Ezra.10.9","start":15010009,"end":15010009,"break":"paragraph","ruby":[[12,2,"ひとびと"],[15,1,"みな"],[17,1,"か"],[28,1,"あつ"],[37,1,"がつ"],[39,3,"はつか"],[51,1,"たみ"],[53,1,"かみ"],[55,1,"みや"],[57,1,"まえ"],[59,2,"ひろば"],[62,1,"ざ"],[76,2,"おおあめ"],[82,1,"ふる"]],"text":"そこでユダとベニヤミンの人々は皆三日のうちにエルサレムに集まった。これは九月の二十日であった。すべての民は神の宮の前の広場に座して、このことのため、また大雨のために震えおののいていた。"},{"ref":"Ezra.10.10","start":15010010,"end":15010010,"break":"none","ruby":[[0,1,"とき"],[2,2,"さいし"],[8,1,"た"],[11,1,"かれ"],[14,1,"い"],[25,1,"つみ"],[27,1,"おか"],[30,2,"いほう"],[33,1,"おんな"],[49,1,"ま"]],"text":"時に祭司エズラは立って彼らに言った、「あなたがたは罪を犯し、異邦の女をめとって、イスラエルのとがを増した。"},{"ref":"Ezra.10.11","start":15010011,"end":15010011,"break":"none","ruby":[[3,1,"いま"],[11,2,"せんぞ"],[14,1,"かみ"],[16,1,"しゅ"],[27,1,"むね"],[29,1,"おこな"],[43,1,"ち"],[45,1,"たみ"],[49,2,"いほう"],[52,1,"おんな"],[54,1,"はな"]],"text":"それで今、あなたがたの先祖の神、主にざんげして、そのみ旨を行いなさい。あなたがたはこの地の民および異邦の女と離れなさい」。"},{"ref":"Ezra.10.12","start":15010012,"end":15010012,"break":"none","ruby":[[3,2,"かいしゅう"],[6,1,"みな"],[7,2,"おおごえ"],[13,1,"こた"],[22,1,"い"],[35,1,"かなら"],[37,1,"おこな"]],"text":"すると会衆は皆大声をあげて答えた、「あなたの言われたとおり、われわれは必ず行います。"},{"ref":"Ezra.10.13","start":15010013,"end":15010013,"break":"none","ruby":[[3,1,"たみ"],[5,1,"おお"],[10,2,"おおあめ"],[13,2,"きせつ"],[20,1,"そと"],[22,1,"た"],[42,1,"にち"],[48,2,"しごと"],[65,1,"こと"],[70,1,"おお"],[73,1,"つみ"],[75,1,"おか"]],"text":"しかし民は多く、また大雨の季節ですから、外に立っていることはできません。またこれは一日やふつかの仕事ではありません。われわれはこの事について大いに罪を犯したからです。"},{"ref":"Ezra.10.14","start":15010014,"end":15010014,"break":"none","ruby":[[18,1,"ぜん"],[19,2,"かいしゅう"],[25,1,"た"],[38,1,"まち"],[40,1,"うち"],[45,2,"いほう"],[48,1,"おんな"],[54,1,"もの"],[64,1,"さだ"],[67,1,"とき"],[83,1,"まち"],[85,2,"ちょうろう"],[90,3,"さいばんにん"],[98,2,"いっしょ"],[115,1,"こと"],[124,1,"かみ"],[126,1,"はげ"],[129,1,"いか"],[141,1,"はな"]],"text":"それでどうぞ、われわれのつかさたちは全会衆のために立ってください。われわれの町の内に、もし異邦の女をめとった者があるならば、みな定めの時にこさせなさい。またおのおのの町の長老および裁判人も、それと一緒にこさせなさい。そうすればこの事によるわれわれの神の激しい怒りは、ついにわれわれを離れるでしょう」。"},{"ref":"Ezra.10.15","start":15010015,"end":15010015,"break":"none","ruby":[[9,1,"こ"],[21,1,"こ"],[30,2,"はんたい"],[56,1,"かれ"],[59,2,"しじ"]],"text":"ところがアサヘルの子ヨナタンおよびテクワの子ヤハジアはこれに反対した。そしてメシュラムおよびレビびとシャベタイは彼らを支持した。"},{"ref":"Ezra.10.16","start":15010016,"end":15010016,"break":"paragraph","ruby":[[3,2,"ほしゅう"],[7,1,"かえ"],[10,1,"き"],[12,2,"ひとびと"],[20,1,"い"],[28,2,"さいし"],[35,2,"しぞく"],[38,1,"ちょう"],[44,2,"しぞく"],[58,1,"な"],[63,1,"えら"],[67,1,"かれ"],[71,1,"がつ"],[74,1,"にち"],[77,1,"ざ"],[82,1,"こと"],[84,1,"しら"]],"text":"そこで捕囚から帰って来た人々はこのように行った。すなわち祭司エズラは、氏族の長たちをその氏族にしたがい、おのおのその名をさして選んだ。彼らは十月の一日から座してこの事を調べ、"},{"ref":"Ezra.10.17","start":15010017,"end":15010017,"break":"none","ruby":[[0,2,"しょうがつ"],[4,1,"にち"],[10,2,"いほう"],[13,1,"おんな"],[19,2,"ひとびと"],[27,1,"しら"],[29,1,"おわ"]],"text":"正月の一日になって、異邦の女をめとった人々をことごとく調べ終った。"},{"ref":"Ezra.10.18","start":15010018,"end":15010018,"break":"paragraph","ruby":[[0,2,"さいし"],[3,2,"しそん"],[9,2,"いほう"],[12,1,"おんな"],[18,1,"こと"],[25,1,"もの"],[33,1,"こ"],[39,1,"こ"],[47,2,"きょうだい"]],"text":"祭司の子孫のうちで異邦の女をめとった事のあらわれた者は、ヨザダクの子エシュアの子ら、およびその兄弟たちのうちではマアセヤ、エリエゼル、ヤリブ、ゲダリヤであった。"},{"ref":"Ezra.10.19","start":15010019,"end":15010019,"break":"none","ruby":[[0,1,"かれ"],[5,1,"つま"],[7,2,"りえん"],[15,1,"ちか"],[24,1,"つみ"],[26,1,"おか"],[43,2,"おひつじ"],[46,1,"とう"]],"text":"彼らはその妻を離縁しようという誓いをなし、すでに罪を犯したというので、そのとがのために雄羊一頭をささげた。"},{"ref":"Ezra.10.20","start":15010020,"end":15010020,"break":"none","ruby":[[5,1,"こ"]],"text":"インメルの子らのうちではハナニおよびゼバデヤ。"},{"ref":"Ezra.10.21","start":15010021,"end":15010021,"break":"none","ruby":[[4,1,"こ"]],"text":"ハリムの子らのうちではマアセヤ、エリヤ、シマヤ、エヒエル、ウジヤ。"},{"ref":"Ezra.10.22","start":15010022,"end":15010022,"break":"none","ruby":[[5,1,"こ"]],"text":"パシュルの子らのうちではエリオエナイ、マアセヤ、イシマエル、ネタンエル、ヨザバデ、エラサ。"},{"ref":"Ezra.10.23","start":15010023,"end":15010023,"break":"paragraph","text":"レビびとのうちではヨザバテ、シメイ、ケラヤ（すなわちケリタ）、ペタヒヤ、ユダ、エリエゼル。"},{"ref":"Ezra.10.24","start":15010024,"end":15010024,"break":"none","ruby":[[0,1,"うた"],[4,1,"もの"],[16,2,"もんえい"]],"text":"歌うたう者のうちではエリアシブ。門衛のうちではシャルム、テレム、ウリ。"},{"ref":"Ezra.10.25","start":15010025,"end":15010025,"break":"paragraph","ruby":[[13,1,"こ"]],"text":"イスラエルのうち、パロシの子らのうちではラミヤ、エジア、マルキヤ、ミヤミン、エレアザル、ハシャビヤ、ベナヤ。"},{"ref":"Ezra.10.26","start":15010026,"end":15010026,"break":"none","ruby":[[4,1,"こ"]],"text":"エラムの子らのうちではマッタニヤ、ゼカリヤ、エヒエル、アブデ、エレモテ、エリヤ。"},{"ref":"Ezra.10.27","start":15010027,"end":15010027,"break":"none","ruby":[[4,1,"こ"]],"text":"ザットの子らのうちではエリオエナイ、エリアシブ、マッタニヤ、エレモテ、ザバデ、アジザ。"},{"ref":"Ezra.10.28","start":15010028,"end":15010028,"break":"none","ruby":[[4,1,"こ"]],"text":"ベバイの子らのうちではヨハナン、ハナニヤ、ザバイ、アテライ。"},{"ref":"Ezra.10.29","start":15010029,"end":15010029,"break":"none","ruby":[[3,1,"こ"]],"text":"バニの子らのうちではメシュラム、マルク、アダヤ、ヤシュブ、シヤル、エレモテ。"},{"ref":"Ezra.10.30","start":15010030,"end":15010030,"break":"none","ruby":[[8,1,"こ"]],"text":"パハテ・モアブの子らのうちではアデナ、ケラル、ベナヤ、マアセヤ、マッタニヤ、ベザレル、ビンヌイ、マナセ。"},{"ref":"Ezra.10.31","start":15010031,"end":15010031,"break":"none","ruby":[[4,1,"こ"]],"text":"ハリムの子らのうちではエリエゼル、イシヤ、マルキヤ、シマヤ、シメオン、"},{"ref":"Ezra.10.32","start":15010032,"end":15010032,"break":"none","text":"ベニヤミン、マルク、シマリヤ。"},{"ref":"Ezra.10.33","start":15010033,"end":15010033,"break":"none","ruby":[[5,1,"こ"]],"text":"ハシュムの子らのうちではマッテナイ、マッタタ、ザバデ、エリパレテ、エレマイ、マナセ、シメイ。"},{"ref":"Ezra.10.34","start":15010034,"end":15010034,"break":"none","ruby":[[3,1,"こ"]],"text":"バニの子らのうちではマアダイ、アムラム、ウエル、"},{"ref":"Ezra.10.35","start":15010035,"end":15010035,"break":"none","text":"ベナヤ、ベデヤ、ケルヒ、"},{"ref":"Ezra.10.36","start":15010036,"end":15010036,"break":"none","text":"ワニア、メレモテ、エリアシブ、"},{"ref":"Ezra.10.37","start":15010037,"end":15010037,"break":"none","text":"マッタニヤ、マッテナイ、ヤアス。"},{"ref":"Ezra.10.38","start":15010038,"end":15010038,"break":"none","ruby":[[5,1,"こ"]],"text":"ビンヌイの子らのうちではシメイ、"},{"ref":"Ezra.10.39","start":15010039,"end":15010039,"break":"none","text":"シレミヤ、ナタン、アダヤ、"},{"ref":"Ezra.10.40","start":15010040,"end":15010040,"break":"none","text":"マクナデバイ、シャシャイ、シャライ、"},{"ref":"Ezra.10.41","start":15010041,"end":15010041,"break":"none","text":"アザリエル、シレミヤ、シマリヤ、"},{"ref":"Ezra.10.42","start":15010042,"end":15010042,"break":"none","text":"シャルム、アマリヤ、ヨセフ。"},{"ref":"Ezra.10.43","start":15010043,"end":15010043,"break":"none","ruby":[[3,1,"こ"]],"text":"ネボの子らではエイエル、マッタテヤ、ザバデ、ゼビナ、ヤッダイ、ヨエル、ベナヤ。"},{"ref":"Ezra.10.44","start":15010044,"end":15010044,"break":"none","ruby":[[4,1,"もの"],[6,1,"みな"],[7,2,"いほう"],[10,1,"おんな"],[16,1,"もの"],[21,1,"かれ"],[26,1,"おんな"],[32,1,"こ"],[33,1,"とも"],[35,1,"とも"],[37,2,"りえん"]],"text":"これらの者は皆異邦の女をめとった者である。彼らはその女たちをその子供と共に離縁した。"}]