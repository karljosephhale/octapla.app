[{"ref":"Num.24.1","start":4024001,"end":4024001,"break":"paragraph","ruby":[[10,2,"しゅくふく"],[17,1,"しゅ"],[19,1,"こころ"],[26,1,"み"],[31,2,"こんど"],[41,1,"い"],[44,2,"まじゅつ"],[47,1,"もと"],[56,1,"かお"],[58,2,"あらの"]],"text":"バラムはイスラエルを祝福することが主の心にかなうのを見たので、今度はいつものように行って魔術を求めることをせず、顔を荒野にむけ、"},{"ref":"Num.24.2","start":4024002,"end":4024002,"break":"none","ruby":[[0,1,"め"],[2,1,"あ"],[16,2,"ぶぞく"],[24,2,"しゅくえい"],[32,1,"み"],[37,1,"とき"],[39,1,"かみ"],[41,1,"れい"],[43,1,"のぞ"]],"text":"目を上げて、イスラエルがそれぞれ部族にしたがって宿営しているのを見た。その時、神の霊が臨んだので、"},{"ref":"Num.24.3","start":4024003,"end":4024003,"break":"none","breaks":[[11,"stanza"],[24,"line"]],"ruby":[[0,1,"かれ"],[4,2,"たくせん"],[7,1,"の"],[16,1,"こ"],[21,2,"ことば"],[24,1,"め"],[26,1,"と"],[29,1,"ひと"],[31,2,"ことば"]],"text":"彼はこの託宣を述べた。「ベオルの子バラムの言葉、目を閉じた人の言葉、"},{"ref":"Num.24.4","start":4024004,"end":4024004,"break":"line","breaks":[[9,"line"],[19,"line"]],"ruby":[[0,1,"かみ"],[2,2,"ことば"],[5,1,"き"],[7,1,"もの"],[9,3,"ぜんのうしゃ"],[13,1,"まぼろし"],[15,1,"み"],[17,1,"もの"],[19,1,"たお"],[21,1,"ふ"],[25,1,"め"],[27,1,"ひら"],[31,1,"もの"],[33,2,"ことば"]],"text":"神の言葉を聞く者、全能者の幻を見る者、倒れ伏して、目の開かれた者の言葉。"},{"ref":"Num.24.5","start":4024005,"end":4024005,"break":"line","breaks":[[16,"line"]],"ruby":[[9,2,"てんまく"],[12,1,"うるわ"],[32,1,"うるわ"]],"text":"ヤコブよ、あなたの天幕は麗しい、イスラエルよ、あなたのすまいは、麗しい。"},{"ref":"Num.24.6","start":4024006,"end":4024006,"break":"line","breaks":[[15,"line"],[23,"line"],[37,"line"]],"ruby":[[3,1,"とお"],[9,2,"たにだに"],[15,1,"かわ"],[18,1,"その"],[23,1,"しゅ"],[25,1,"う"],[30,2,"ぢんこう"],[32,1,"じゅ"],[37,1,"なが"],[44,2,"こうはく"]],"text":"それは遠くひろがる谷々のよう、川べの園のよう、主が植えられた沈香樹のよう、流れのほとりの香柏のようだ。"},{"ref":"Num.24.7","start":4024007,"end":4024007,"break":"line","breaks":[[13,"line"],[30,"line"],[46,"line"]],"ruby":[[0,1,"みず"],[2,1,"かれ"],[13,1,"かれ"],[16,1,"たね"],[18,1,"みず"],[20,1,"うるお"],[23,1,"そだ"],[30,1,"かれ"],[33,1,"おう"],[41,1,"たか"],[46,1,"かれ"],[49,1,"くに"]],"text":"水は彼らのかめからあふれ、彼らの種は水の潤いに育つであろう。彼らの王はアガグよりも高くなり、彼らの国はあがめられるであろう。"},{"ref":"Num.24.8","start":4024008,"end":4024008,"break":"line","breaks":[[18,"line"],[30,"line"],[45,"line"],[52,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[11,1,"みちび"],[13,1,"だ"],[18,1,"かれ"],[21,2,"やぎゅう"],[24,1,"つの"],[30,1,"かれ"],[33,1,"てき"],[36,2,"くにぐに"],[39,1,"たみ"],[41,1,"ほろ"],[47,1,"ほね"],[49,1,"くだ"],[52,1,"や"],[57,1,"つ"],[59,1,"とお"]],"text":"神は彼らをエジプトから導き出された、彼らは野牛の角のようだ。彼らは敵なる国々の民を滅ぼし、その骨を砕き、矢をもって突き通すであろう。"},{"ref":"Num.24.9","start":4024009,"end":4024009,"break":"line","breaks":[[16,"line"],[29,"line"],[41,"line"],[56,"line"]],"ruby":[[0,1,"かれ"],[3,1,"お"],[10,1,"み"],[16,1,"め"],[23,1,"ふ"],[32,1,"かれ"],[35,1,"おこ"],[45,2,"しゅくふく"],[49,1,"もの"],[51,2,"しゅくふく"],[63,1,"もの"]],"text":"彼らは雄じしのように身をかがめ、雌じしのように伏している。だれが彼らを起しえよう。あなたを祝福する者は祝福され、あなたをのろう者はのろわれるであろう」。"},{"ref":"Num.24.10","start":4024010,"end":4024010,"break":"paragraph","ruby":[[15,1,"いか"],[18,1,"はっ"],[21,1,"て"],[23,1,"う"],[25,1,"な"],[41,1,"い"],[46,1,"てき"],[54,1,"まね"],[69,1,"ど"],[73,1,"かれ"],[76,2,"しゅくふく"]],"text":"そこでバラクはバラムにむかって怒りを発し、手を打ち鳴らした。そしてバラクはバラムに言った、「敵をのろうために招いたのに、あなたはかえって三度までも彼らを祝福した。"},{"ref":"Num.24.11","start":4024011,"end":4024011,"break":"none","ruby":[[3,1,"いま"],[8,1,"いそ"],[11,2,"じぶん"],[18,1,"かえ"],[34,1,"おお"],[37,2,"ゆうぐう"],[43,1,"おも"],[51,1,"しゅ"],[55,2,"ゆうぐう"],[62,1,"え"]],"text":"それで今あなたは急いで自分のところへ帰ってください。わたしはあなたを大いに優遇しようと思った。しかし、主はその優遇をあなたに得させないようにされました」。"},{"ref":"Num.24.12","start":4024012,"end":4024012,"break":"none","ruby":[[8,1,"い"],[27,2,"ししゃ"],[32,1,"い"]],"text":"バラムはバラクに言った、「わたしはあなたがつかわされた使者たちに言ったではありませんか、"},{"ref":"Num.24.13","start":4024013,"end":4024013,"break":"none","ruby":[[10,1,"いえ"],[12,1,"み"],[18,2,"きんぎん"],[25,1,"あた"],[32,1,"しゅ"],[34,2,"ことば"],[37,1,"こ"],[40,1,"こころ"],[45,1,"ぜん"],[47,1,"あく"],[49,1,"おこな"],[64,1,"しゅ"],[66,1,"い"],[73,1,"の"]],"text":"『たといバラクがその家に満ちるほどの金銀をわたしに与えようとも、主の言葉を越えて心のままに善も悪も行うことはできません。わたしは主の言われることを述べるだけです』。"},{"ref":"Num.24.14","start":4024014,"end":4024014,"break":"none","ruby":[[4,1,"いま"],[9,1,"たみ"],[15,1,"かえ"],[18,1,"い"],[32,1,"たみ"],[34,1,"のち"],[36,1,"ひ"],[42,1,"たみ"],[55,1,"おし"]],"text":"わたしは今わたしの民のところへ帰って行きます。それでわたしはこの民が後の日にあなたの民にどんなことをするかをお知らせしましょう」。"},{"ref":"Num.24.15","start":4024015,"end":4024015,"break":"none","breaks":[[12,"stanza"],[25,"line"]],"ruby":[[5,2,"たくせん"],[8,1,"の"],[17,1,"こ"],[22,2,"ことば"],[25,1,"め"],[27,1,"と"],[30,1,"ひと"],[32,2,"ことば"]],"text":"そしてこの託宣を述べた。「ベオルの子バラムの言葉、目を閉じた人の言葉。"},{"ref":"Num.24.16","start":4024016,"end":4024016,"break":"line","breaks":[[9,"line"],[22,"line"],[30,"line"]],"ruby":[[0,1,"かみ"],[2,2,"ことば"],[5,1,"き"],[7,1,"もの"],[11,1,"たか"],[13,1,"もの"],[15,2,"ちしき"],[20,1,"もの"],[22,3,"ぜんのうしゃ"],[26,1,"まぼろし"],[28,1,"み"],[30,1,"たお"],[32,1,"ふ"],[36,1,"め"],[38,1,"ひら"],[42,1,"もの"],[44,2,"ことば"]],"text":"神の言葉を聞く者、いと高き者の知識をもつ者、全能者の幻を見、倒れ伏して、目の開かれた者の言葉。"},{"ref":"Num.24.17","start":4024017,"end":4024017,"break":"line","breaks":[[18,"line"],[39,"line"],[51,"line"],[67,"line"],[77,"line"]],"ruby":[[4,1,"かれ"],[6,1,"み"],[12,1,"いま"],[22,1,"かれ"],[24,1,"のぞ"],[26,1,"み"],[32,1,"ちか"],[47,1,"ほし"],[49,1,"で"],[59,1,"ぽん"],[64,1,"おこ"],[84,1,"こ"],[87,2,"のうてん"],[90,1,"う"]],"text":"わたしは彼を見る、しかし今ではない。わたしは彼を望み見る、しかし近くではない。ヤコブから一つの星が出、イスラエルから一本のつえが起り、モアブのこめかみと、セツのすべての子らの脳天を撃つであろう。"},{"ref":"Num.24.18","start":4024018,"end":4024018,"break":"line","breaks":[[12,"line"],[28,"line"]],"ruby":[[0,1,"てき"],[6,2,"りょうち"],[18,2,"りょうち"],[37,2,"しょうり"],[40,1,"え"]],"text":"敵のエドムは領地となり、セイルもまた領地となるであろう。そしてイスラエルは勝利を得るであろう。"},{"ref":"Num.24.19","start":4024019,"end":4024019,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"けん"],[2,1,"と"],[4,1,"もの"],[11,1,"で"],[13,1,"い"],[15,1,"のこ"],[18,1,"もの"],[20,1,"まち"],[23,1,"た"],[25,1,"ほろ"]],"text":"権を執る者がヤコブから出、生き残った者を町から断ち滅ぼすであろう」。"},{"ref":"Num.24.20","start":4024020,"end":4024020,"break":"none","breaks":[[25,"stanza"],[44,"line"]],"ruby":[[11,1,"のぞ"],[13,1,"み"],[18,2,"たくせん"],[21,1,"の"],[31,1,"しょ"],[32,2,"こくみん"],[38,2,"さいしょ"],[51,1,"ほろ"],[53,1,"さ"]],"text":"バラムはまたアマレクを望み見て、この託宣を述べた。「アマレクは諸国民のうちの最初のもの、しかし、ついに滅び去るであろう」。"},{"ref":"Num.24.21","start":4024021,"end":4024021,"break":"none","breaks":[[20,"stanza"],[32,"line"]],"ruby":[[7,1,"のぞ"],[9,1,"み"],[13,2,"たくせん"],[16,1,"の"],[22,1,"まえ"],[28,2,"けんご"],[32,1,"いわ"],[36,1,"まえ"],[38,1,"す"]],"text":"またケニびとを望み見てこの託宣を述べた。「お前のすみかは堅固だ、岩に、お前は巣をつくっている。"},{"ref":"Num.24.22","start":4024022,"end":4024022,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"ほろ"],[28,1,"まえ"],[30,2,"ほりょ"]],"text":"しかし、カインは滅ぼされるであろう。アシュルはいつまでお前を捕虜とするであろうか」。"},{"ref":"Num.24.23","start":4024023,"end":4024023,"break":"none","breaks":[[13,"stanza"],[27,"line"]],"ruby":[[0,1,"かれ"],[6,2,"たくせん"],[9,1,"の"],[17,1,"かみ"],[19,1,"さだ"],[24,2,"いじょう"],[30,1,"い"],[32,1,"の"]],"text":"彼はまたこの託宣を述べた。「ああ、神が定められた以上、だれが生き延びることができよう。"},{"ref":"Num.24.24","start":4024024,"end":4024024,"break":"line","breaks":[[14,"line"],[26,"line"],[41,"line"]],"ruby":[[5,2,"かいがん"],[9,1,"ふね"],[19,1,"せ"],[30,1,"せ"],[44,1,"かれ"],[51,1,"ほろ"],[53,1,"さ"]],"text":"キッテムの海岸から舟がきて、アシュルを攻めなやまし、エベルを攻めなやますであろう。そして彼もまたついに滅び去るであろう」。"},{"ref":"Num.24.25","start":4024025,"end":4024025,"break":"none","ruby":[[8,1,"た"],[10,1,"あ"],[15,2,"じぶん"],[22,1,"かえ"],[35,1,"た"],[37,1,"さ"]],"text":"こうしてバラムは立ち上がって、自分のところへ帰っていった。バラクもまた立ち去った。"}]