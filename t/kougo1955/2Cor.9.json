[{"ref":"2Cor.9.1","start":47009001,"end":47009001,"break":"paragraph","ruby":[[0,2,"せいと"],[5,1,"たい"],[8,2,"えんじょ"],[27,1,"か"],[32,2,"ひつよう"]],"text":"聖徒たちに対する援助については、いまさら、あなたがたに書きおくる必要はない。"},{"ref":"2Cor.9.2","start":47009002,"end":47009002,"break":"none","ruby":[[11,2,"こうい"],[14,1,"し"],[41,2,"ひとびと"],[44,1,"ほこ"],[53,2,"さくねん"],[55,2,"いらい"],[61,2,"じゅんび"],[71,1,"い"],[85,2,"ねっしん"],[89,1,"おお"],[92,1,"ひと"],[94,2,"ふんき"]],"text":"わたしは、あなたがたの好意を知っており、そのために、あなたがたのことをマケドニヤの人々に誇って、アカヤでは昨年以来、すでに準備をしているのだと言った。そして、あなたがたの熱心は、多くの人を奮起させたのである。"},{"ref":"2Cor.9.3","start":47009003,"end":47009003,"break":"none","ruby":[[4,2,"きょうだい"],[9,1,"おく"],[34,1,"ほこ"],[43,2,"ばあい"],[59,1,"い"],[65,2,"じゅんび"]],"text":"わたしが兄弟たちを送ることにしたのは、あなたがたについてわたしたちの誇ったことが、この場合むなしくならないで、わたしが言ったとおり準備していてもらいたいからである。"},{"ref":"2Cor.9.4","start":47009004,"end":47009004,"break":"none","ruby":[[7,2,"まんいち"],[14,1,"びと"],[20,2,"いっしょ"],[23,1,"い"],[27,2,"じゅんび"],[38,1,"み"],[64,1,"しん"],[75,1,"はじ"]],"text":"そうでないと、万一マケドニヤ人がわたしと一緒に行って、準備ができていないのを見たら、あなたがたはもちろん、わたしたちも、かように信じきっていただけに、恥をかくことになろう。"},{"ref":"2Cor.9.5","start":47009005,"end":47009005,"break":"none","ruby":[[8,2,"きょうだい"],[13,1,"うなが"],[23,1,"ところ"],[25,1,"さき"],[27,1,"い"],[31,2,"いぜん"],[39,2,"やくそく"],[45,1,"おく"],[47,1,"もの"],[49,2,"じゅんび"],[60,2,"ひつよう"],[64,1,"おも"],[82,1,"こころ"],[87,2,"ようい"]],"text":"だから、わたしは兄弟たちを促して、あなたがたの所へ先に行かせ、以前あなたがたが約束していた贈り物の準備をさせておくことが必要だと思った。それをしぶりながらではなく、心をこめて用意していてほしい。"},{"ref":"2Cor.9.6","start":47009006,"end":47009006,"break":"paragraph","ruby":[[4,1,"かんが"],[13,1,"すこ"],[21,1,"もの"],[24,1,"すこ"],[28,1,"か"],[30,1,"と"],[34,1,"ゆた"],[39,1,"もの"],[42,1,"ゆた"],[45,1,"か"],[47,1,"と"]],"text":"わたしの考えはこうである。少ししかまかない者は、少ししか刈り取らず、豊かにまく者は、豊かに刈り取ることになる。"},{"ref":"2Cor.9.7","start":47009007,"end":47009007,"break":"none","ruby":[[0,2,"かくじ"],[3,1,"お"],[6,1,"こころ"],[26,1,"みずか"],[28,1,"こころ"],[30,1,"き"],[44,1,"かみ"],[46,1,"よろこ"],[49,1,"ほどこ"],[51,1,"ひと"],[53,1,"あい"],[56,1,"くだ"]],"text":"各自は惜しむ心からでなく、また、しいられてでもなく、自ら心で決めたとおりにすべきである。神は喜んで施す人を愛して下さるのである。"},{"ref":"2Cor.9.8","start":47009008,"end":47009008,"break":"none","ruby":[[0,1,"かみ"],[12,1,"めぐ"],[15,1,"ゆた"],[18,1,"あた"],[27,1,"つね"],[36,1,"み"],[38,1,"た"],[46,1,"よ"],[51,1,"と"],[55,1,"ちから"]],"text":"神はあなたがたにあらゆる恵みを豊かに与え、あなたがたを常にすべてのことに満ち足らせ、すべての良いわざに富ませる力のあるかたなのである。"},{"ref":"2Cor.9.9","start":47009009,"end":47009009,"break":"stanza","breaks":[[18,"line"]],"ruby":[[1,1,"かれ"],[3,1,"まず"],[6,1,"ひと"],[10,1,"ち"],[14,1,"あた"],[20,1,"ぎ"],[22,2,"えいえん"],[25,1,"つづ"],[33,1,"か"]],"text":"「彼は貧しい人たちに散らして与えた。その義は永遠に続くであろう」と書いてあるとおりである。"},{"ref":"2Cor.9.10","start":47009010,"end":47009010,"break":"none","ruby":[[0,1,"たね"],[3,1,"ひと"],[5,1,"たね"],[7,1,"た"],[17,1,"そな"],[20,1,"くだ"],[34,1,"たね"],[36,1,"そな"],[55,1,"ぎ"],[57,1,"み"],[59,1,"ま"],[62,1,"くだ"]],"text":"種まく人に種と食べるためのパンとを備えて下さるかたは、あなたがたにも種を備え、それをふやし、そしてあなたがたの義の実を増して下さるのである。"},{"ref":"2Cor.9.11","start":47009011,"end":47009011,"break":"none","ruby":[[18,1,"ゆた"],[25,1,"お"],[30,1,"ほどこ"],[35,1,"ほどこ"],[44,1,"て"],[49,1,"おこな"],[53,1,"かみ"],[55,2,"かんしゃ"],[60,1,"いた"]],"text":"こうして、あなたがたはすべてのことに豊かになって、惜しみなく施し、その施しはわたしたちの手によって行われ、神に感謝するに至るのである。"},{"ref":"2Cor.9.12","start":47009012,"end":47009012,"break":"none","ruby":[[7,2,"えんじょ"],[10,1,"はたら"],[14,2,"せいと"],[19,2,"けつぼう"],[22,1,"おぎな"],[31,1,"かみ"],[33,1,"たい"],[36,1,"おお"],[39,2,"かんしゃ"],[49,1,"ゆた"]],"text":"なぜなら、この援助の働きは、聖徒たちの欠乏を補えだけではなく、神に対する多くの感謝によってますます豊かになるからである。"},{"ref":"2Cor.9.13","start":47009013,"end":47009013,"break":"none","ruby":[[7,2,"えんじょ"],[10,1,"おこな"],[13,2,"けっか"],[30,2,"ふくいん"],[33,2,"こくはく"],[36,1,"たい"],[39,2,"じゅうじゅん"],[48,1,"かれ"],[57,1,"ひと"],[61,1,"お"],[66,1,"ほどこ"],[83,1,"かれ"],[86,1,"かみ"],[88,2,"えいこう"],[91,1,"き"]],"text":"すなわち、この援助を行った結果として、あなたがたがキリストの福音の告白に対して従順であることや、彼らにも、すべての人にも、惜しみなく施しをしていることがわかってきて、彼らは神に栄光を帰し、"},{"ref":"2Cor.9.14","start":47009014,"end":47009014,"break":"none","ruby":[[10,1,"たま"],[18,1,"ゆた"],[21,1,"かみ"],[23,1,"めぐ"],[36,1,"した"],[48,1,"いの"]],"text":"そして、あなたがたに賜わったきわめて豊かな神の恵みのゆえに、あなたがたを慕い、あなたがたのために祈るのである。"},{"ref":"2Cor.9.15","start":47009015,"end":47009015,"break":"none","ruby":[[0,1,"い"],[7,2,"たまもの"],[14,1,"かみ"],[16,2,"かんしゃ"]],"text":"言いつくせない賜物のゆえに、神に感謝する。"}]