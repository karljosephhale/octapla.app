[{"ref":"Ps.136.1","start":19136001,"end":19136001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"かんしゃ"],[7,1,"しゅ"],[9,1,"めぐ"],[28,1,"た"]],"text":"主に感謝せよ、主は恵みふかく、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.2","start":19136002,"end":19136002,"break":"line","breaks":[[14,"line"]],"ruby":[[5,1,"かみ"],[7,1,"かみ"],[9,2,"かんしゃ"],[27,1,"た"]],"text":"もろもろの神の神に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.3","start":19136003,"end":19136003,"break":"line","breaks":[[14,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"しゅ"],[9,2,"かんしゃ"],[27,1,"た"]],"text":"もろもろの主の主に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.4","start":19136004,"end":19136004,"break":"line","breaks":[[17,"line"],[28,"line"]],"ruby":[[5,1,"おお"],[21,1,"もの"],[23,2,"かんしゃ"],[41,1,"た"]],"text":"ただひとり大いなるくすしきみわざをなされる者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.5","start":19136005,"end":19136005,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"ちえ"],[6,1,"てん"],[8,1,"つく"],[12,1,"もの"],[14,2,"かんしゃ"],[32,1,"た"]],"text":"知恵をもって天を造られた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.6","start":19136006,"end":19136006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ち"],[2,1,"みず"],[4,1,"うえ"],[6,1,"し"],[10,1,"もの"],[12,2,"かんしゃ"],[30,1,"た"]],"text":"地を水の上に敷かれた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.7","start":19136007,"end":19136007,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"おお"],[4,1,"ひかり"],[6,1,"つく"],[10,1,"もの"],[12,2,"かんしゃ"],[30,1,"た"]],"text":"大いなる光を造られた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.8","start":19136008,"end":19136008,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"ひる"],[11,1,"ひ"],[13,1,"つく"],[17,1,"もの"],[19,2,"かんしゃ"],[37,1,"た"]],"text":"昼をつかさどらすために日を造られた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.9","start":19136009,"end":19136009,"break":"line","breaks":[[14,"line"],[33,"line"]],"ruby":[[0,1,"よる"],[11,1,"つき"],[19,1,"ほし"],[22,1,"つく"],[26,1,"もの"],[28,2,"かんしゃ"],[46,1,"た"]],"text":"夜をつかさどらすために月と、もろもろの星とを造られた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.10","start":19136010,"end":19136010,"break":"line","breaks":[[20,"line"]],"ruby":[[9,1,"う"],[13,1,"もの"],[15,2,"かんしゃ"],[33,1,"た"]],"text":"エジプトのういごを撃たれた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.11","start":19136011,"end":19136011,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[13,1,"なか"],[16,1,"みちび"],[18,1,"だ"],[22,1,"もの"],[24,2,"かんしゃ"],[42,1,"た"]],"text":"イスラエルをエジプトびとの中から導き出された者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.12","start":19136012,"end":19136012,"break":"line","breaks":[[15,"line"],[31,"line"]],"ruby":[[0,1,"つよ"],[2,1,"て"],[4,1,"の"],[8,1,"うで"],[18,1,"すく"],[20,1,"だ"],[24,1,"もの"],[26,2,"かんしゃ"],[44,1,"た"]],"text":"強い手と伸ばした腕とをもって、これを救い出された者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.13","start":19136013,"end":19136013,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"こうかい"],[6,1,"わ"],[11,1,"もの"],[13,2,"かんしゃ"],[31,1,"た"]],"text":"紅海を二つに分けられた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.14","start":19136014,"end":19136014,"break":"line","breaks":[[23,"line"]],"ruby":[[8,1,"なか"],[10,1,"とお"],[16,1,"もの"],[18,2,"かんしゃ"],[36,1,"た"]],"text":"イスラエルにその中を通らせられた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.15","start":19136015,"end":19136015,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[5,2,"ぐんぜい"],[9,2,"こうかい"],[12,1,"う"],[14,1,"やぶ"],[18,1,"もの"],[20,2,"かんしゃ"],[38,1,"た"]],"text":"パロとその軍勢とを紅海で打ち敗られた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.16","start":19136016,"end":19136016,"break":"line","breaks":[[23,"line"]],"ruby":[[2,1,"たみ"],[4,1,"みちび"],[7,2,"あらの"],[10,1,"とお"],[16,1,"もの"],[18,2,"かんしゃ"],[36,1,"た"]],"text":"その民を導いて荒野を通らせられた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.17","start":19136017,"end":19136017,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"おお"],[4,1,"おう"],[8,1,"う"],[12,1,"もの"],[14,2,"かんしゃ"],[32,1,"た"]],"text":"大いなる王たちを撃たれた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.18","start":19136018,"end":19136018,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"な"],[3,1,"おう"],[7,1,"ころ"],[11,1,"もの"],[13,2,"かんしゃ"],[31,1,"た"]],"text":"名ある王たちを殺された者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.19","start":19136019,"end":19136019,"break":"line","breaks":[[22,"line"]],"ruby":[[6,1,"おう"],[11,1,"ころ"],[15,1,"もの"],[17,2,"かんしゃ"],[35,1,"た"]],"text":"アモリびとの王シホンを殺された者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.20","start":19136020,"end":19136020,"break":"line","breaks":[[20,"line"]],"ruby":[[5,1,"おう"],[9,1,"ころ"],[13,1,"もの"],[15,2,"かんしゃ"],[33,1,"た"]],"text":"バシャンの王オグを殺された者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.21","start":19136021,"end":19136021,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ち"],[5,1,"し"],[6,1,"ぎょう"],[10,1,"あた"],[15,1,"もの"],[17,2,"かんしゃ"],[35,1,"た"]],"text":"彼らの地を嗣業として与えられた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.22","start":19136022,"end":19136022,"break":"line","breaks":[[16,"line"],[31,"line"]],"ruby":[[11,1,"し"],[12,1,"ぎょう"],[19,1,"あた"],[24,1,"もの"],[26,2,"かんしゃ"],[44,1,"た"]],"text":"そのしもべイスラエルに嗣業としてこれを与えられた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.23","start":19136023,"end":19136023,"break":"line","breaks":[[11,"line"],[32,"line"]],"ruby":[[4,1,"いや"],[9,1,"とき"],[25,1,"もの"],[27,2,"かんしゃ"],[45,1,"た"]],"text":"われらが卑しかった時にわれらをみこころにとめられた者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.24","start":19136024,"end":19136024,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[12,1,"たす"],[14,1,"だ"],[18,1,"もの"],[20,2,"かんしゃ"],[38,1,"た"]],"text":"われらのあだからわれらを助け出された者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.25","start":19136025,"end":19136025,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"にく"],[7,1,"もの"],[9,2,"しょくもつ"],[12,1,"あた"],[17,1,"もの"],[19,2,"かんしゃ"],[37,1,"た"]],"text":"すべての肉なる者に食物を与えられる者に感謝せよ、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.136.26","start":19136026,"end":19136026,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"てん"],[2,1,"かみ"],[4,2,"かんしゃ"],[22,1,"た"]],"text":"天の神に感謝せよ、そのいつくしみはとこしえに絶えることがない。"}]