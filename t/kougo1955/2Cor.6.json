[{"ref":"2Cor.6.1","start":47006001,"end":47006001,"break":"paragraph","ruby":[[9,1,"かみ"],[11,1,"とも"],[13,1,"はたら"],[15,1,"もの"],[26,1,"すす"],[30,1,"かみ"],[32,1,"めぐ"],[40,1,"う"]],"text":"わたしたちはまた、神と共に働く者として、あなたがたに勧める。神の恵みをいたずらに受けてはならない。"},{"ref":"2Cor.6.2","start":47006002,"end":47006002,"break":"none","breaks":[[9,"stanza"],[32,"line"]],"ruby":[[0,1,"かみ"],[4,1,"い"],[15,1,"めぐ"],[18,1,"とき"],[24,1,"ねが"],[27,1,"き"],[32,1,"すくい"],[34,1,"ひ"],[40,1,"たす"],[45,1,"み"],[48,1,"いま"],[50,1,"めぐ"],[53,1,"とき"],[55,1,"み"],[58,1,"いま"],[60,1,"すくい"],[62,1,"ひ"]],"text":"神はこう言われる、「わたしは、恵みの時にあなたの願いを聞きいれ、救の日にあなたを助けた」。見よ、今は恵みの時、見よ、今は救の日である。"},{"ref":"2Cor.6.3","start":47006003,"end":47006003,"break":"none","ruby":[[2,1,"つとめ"],[8,1,"まね"],[25,1,"こと"],[29,1,"ひと"],[36,1,"あた"]],"text":"この務がそしりを招かないために、わたしたちはどんな事にも、人につまずきを与えないようにし、"},{"ref":"2Cor.6.4","start":47006004,"end":47006004,"break":"none","ruby":[[9,2,"ばあい"],[13,1,"かみ"],[15,1,"しもべ"],[20,2,"じぶん"],[23,2,"ひとびと"],[39,2,"きょくど"],[42,2,"にんく"],[47,2,"かんなん"],[52,2,"きき"],[57,1,"ゆ"],[59,1,"づ"]],"text":"かえって、あらゆる場合に、神の僕として、自分を人々にあらわしている。すなわち、極度の忍苦にも、患難にも、危機にも、行き詰まりにも、"},{"ref":"2Cor.6.5","start":47006005,"end":47006005,"break":"none","ruby":[[2,1,"う"],[11,2,"にゅうごく"],[16,2,"そうらん"],[21,2,"ろうく"],[26,2,"てつや"],[31,2,"きが"]],"text":"むち打たれることにも、入獄にも、騒乱にも、労苦にも、徹夜にも、飢餓にも、"},{"ref":"2Cor.6.6","start":47006006,"end":47006006,"break":"none","ruby":[[0,2,"しんじつ"],[3,2,"ちしき"],[6,2,"かんよう"],[10,2,"じあい"],[13,2,"せいれい"],[16,1,"いつわ"],[21,1,"あい"]],"text":"真実と知識と寛容と、慈愛と聖霊と偽りのない愛と、"},{"ref":"2Cor.6.7","start":47006007,"end":47006007,"break":"none","ruby":[[0,2,"しんり"],[3,2,"ことば"],[6,1,"かみ"],[8,1,"ちから"],[14,2,"さゆう"],[17,1,"も"],[22,1,"ぎ"],[24,2,"ぶき"]],"text":"真理の言葉と神の力とにより、左右に持っている義の武器により、"},{"ref":"2Cor.6.8","start":47006008,"end":47006008,"break":"none","ruby":[[14,2,"あくひょう"],[17,1,"う"],[22,2,"こうひょう"],[25,1,"はく"],[30,1,"かみ"],[32,1,"しもべ"],[36,2,"じぶん"],[54,1,"ひと"],[56,1,"まど"],[72,2,"しんじつ"]],"text":"ほめられても、そしられても、悪評を受けても、好評を博しても、神の僕として自分をあらわしている。わたしたちは、人を惑わしているようであるが、しかも真実であり、"},{"ref":"2Cor.6.9","start":47006009,"end":47006009,"break":"none","ruby":[[0,1,"ひと"],[2,1,"し"],[16,1,"みと"],[21,1,"し"],[36,1,"み"],[39,1,"い"],[45,1,"こ"],[61,1,"ころ"]],"text":"人に知られていないようであるが、認められ、死にかかっているようであるが、見よ、生きており、懲らしめられているようであるが、殺されず、"},{"ref":"2Cor.6.10","start":47006010,"end":47006010,"break":"none","ruby":[[0,1,"かな"],[13,1,"つね"],[15,1,"よろこ"],[21,1,"まず"],[31,1,"おお"],[34,1,"ひと"],[36,1,"と"],[40,1,"なに"],[42,1,"も"],[57,1,"もの"],[59,1,"も"]],"text":"悲しんでいるようであるが、常に喜んでおり、貧しいようであるが、多くの人を富ませ、何も持たないようであるが、すべての物を持っている。"},{"ref":"2Cor.6.11","start":47006011,"end":47006011,"break":"paragraph","ruby":[[5,2,"ひとびと"],[15,1,"む"],[25,1,"くち"],[27,1,"ひら"],[40,1,"こころ"],[42,1,"ひろ"]],"text":"コリントの人々よ。あなたがたに向かってわたしたちの口は開かれており、わたしたちの心は広くなっている。"},{"ref":"2Cor.6.12","start":47006012,"end":47006012,"break":"none","ruby":[[13,1,"こころ"],[29,2,"じぶん"],[32,1,"こころ"]],"text":"あなたがたは、わたしたちに心をせばめられていたのではなく、自分で心をせばめていたのだ。"},{"ref":"2Cor.6.13","start":47006013,"end":47006013,"break":"none","ruby":[[4,2,"こども"],[9,1,"たい"],[15,1,"い"],[28,1,"ほう"],[31,1,"こころ"],[33,1,"ひろ"],[42,1,"おう"]],"text":"わたしは子供たちに対するように言うが、どうかあなたがたの方でも心を広くして、わたしに応じてほしい。"},{"ref":"2Cor.6.14","start":47006014,"end":47006014,"break":"paragraph","ruby":[[0,3,"ふしんじゃ"],[7,1,"あ"],[15,1,"とも"],[21,1,"ぎ"],[23,2,"ふぎ"],[29,1,"かか"],[37,1,"ひかり"],[45,1,"まじ"]],"text":"不信者と、つり合わないくびきを共にするな。義と不義となんの係わりがあるか。光とやみとなんの交わりがあるか。"},{"ref":"2Cor.6.15","start":47006015,"end":47006015,"break":"none","ruby":[[13,2,"ちょうわ"],[20,2,"しんこう"],[23,1,"ふ"],[24,2,"しんこう"],[30,2,"かんけい"]],"text":"キリストとベリアルとなんの調和があるか。信仰と不信仰となんの関係があるか。"},{"ref":"2Cor.6.16","start":47006016,"end":47006016,"break":"none","breaks":[[47,"stanza"],[60,"line"],[73,"line"],[89,"line"]],"ruby":[[0,1,"かみ"],[2,1,"みや"],[4,2,"ぐうぞう"],[10,2,"いっち"],[24,1,"い"],[27,1,"かみ"],[29,1,"みや"],[34,1,"かみ"],[38,1,"おお"],[52,1,"かれ"],[55,1,"あいだ"],[57,1,"す"],[62,2,"でい"],[81,1,"かれ"],[84,1,"かみ"],[89,1,"かれ"],[96,1,"たみ"]],"text":"神の宮と偶像となんの一致があるか。わたしたちは、生ける神の宮である。神がこう仰せになっている、「わたしは彼らの間に住み、かつ出入りをするであろう。そして、わたしは彼らの神となり、彼らはわたしの民となるであろう」。"},{"ref":"2Cor.6.17","start":47006017,"end":47006017,"break":"line","breaks":[[16,"line"],[32,"line"],[50,"line"]],"ruby":[[5,1,"かれ"],[8,1,"あいだ"],[11,1,"で"],[13,1,"い"],[16,1,"かれ"],[19,2,"ぶんり"],[25,1,"しゅ"],[27,1,"い"],[36,1,"けが"],[42,1,"ふれ"],[50,1,"ふれ"],[66,1,"う"]],"text":"だから、「彼らの間から出て行き、彼らと分離せよ、と主は言われる。そして、汚れたものに触てはならない。触なければ、わたしはあなたがたを受けいれよう。"},{"ref":"2Cor.6.18","start":47006018,"end":47006018,"break":"line","breaks":[[19,"line"],[26,"line"],[45,"line"]],"ruby":[[14,1,"ちち"],[45,2,"ぜんのう"],[48,1,"しゅ"],[53,1,"い"]],"text":"そしてわたしは、あなたがたの父となり、あなたがたは、わたしのむすこ、むすめとなるであろう。全能の主が、こう言われる」。"}]