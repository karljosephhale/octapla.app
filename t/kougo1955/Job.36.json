[{"ref":"Job.36.1","start":18036001,"end":18036001,"break":"paragraph","ruby":[[4,1,"かさ"],[7,1,"い"]],"text":"エリフは重ねて言った、"},{"ref":"Job.36.2","start":18036002,"end":18036002,"break":"stanza","breaks":[[24,"line"]],"ruby":[[5,1,"ま"],[16,1,"しめ"],[26,1,"かみ"],[31,1,"い"],[35,1,"こと"]],"text":"「しばらく待て、わたしはあなたに示すことがある。なお神のために言うべき事がある。"},{"ref":"Job.36.3","start":18036003,"end":18036003,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"とお"],[10,2,"ちしき"],[13,1,"と"],[18,1,"つく"],[20,1,"ぬし"],[22,2,"せいぎ"],[25,1,"き"]],"text":"わたしは遠くからわが知識を取り、わが造り主に正義を帰する。"},{"ref":"Job.36.4","start":18036004,"end":18036004,"break":"line","breaks":[[16,"line"]],"ruby":[[8,2,"ことば"],[11,1,"いつわ"],[16,2,"ちしき"],[19,1,"まった"],[21,1,"もの"],[27,1,"とも"]],"text":"まことにわたしの言葉は偽らない。知識の全き者があなたと共にいる。"},{"ref":"Job.36.5","start":18036005,"end":18036005,"break":"stanza","breaks":[[14,"line"],[25,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[5,1,"ちから"],[8,1,"もの"],[14,1,"なに"],[17,1,"いや"],[27,1,"さと"],[30,1,"ちから"],[32,1,"おお"]],"text":"見よ、神は力ある者であるが、何をも卑しめられない、その悟りの力は大きい。"},{"ref":"Job.36.6","start":18036006,"end":18036006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[2,1,"あ"],[5,1,"もの"],[7,1,"い"],[17,1,"くる"],[20,1,"もの"],[29,1,"おこな"]],"text":"彼は悪しき者を生かしておかれない、苦しむ者のためにさばきを行われる。"},{"ref":"Job.36.7","start":18036007,"end":18036007,"break":"line","breaks":[[14,"line"],[31,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ただ"],[5,1,"もの"],[8,1,"め"],[10,1,"はな"],[14,1,"くらい"],[18,1,"おう"],[22,1,"とも"],[31,1,"かれ"],[40,1,"たっと"]],"text":"彼は正しい者から目を離さず、位にある王たちと共に、とこしえに、彼らをすわらせて、尊くされる。"},{"ref":"Job.36.8","start":18036008,"end":18036008,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"かれ"],[5,1,"あし"],[14,1,"なや"],[20,1,"とら"],[25,1,"とき"]],"text":"もし彼らが足かせにつながれ、悩みのなわに捕えられる時は、"},{"ref":"Job.36.9","start":18036009,"end":18036009,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おこな"],[13,1,"たか"],[22,1,"かれ"],[25,1,"しめ"]],"text":"彼らの行いと、とがと、その高ぶったふるまいを彼らに示し、"},{"ref":"Job.36.10","start":18036010,"end":18036010,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"みみ"],[5,1,"ひら"],[9,1,"おしえ"],[11,1,"き"],[15,1,"あく"],[17,1,"はな"],[20,1,"かえ"],[25,1,"めい"]],"text":"彼らの耳を開いて、教を聞かせ、悪を離れて帰ることを命じられる。"},{"ref":"Job.36.11","start":18036011,"end":18036011,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[2,1,"かれ"],[5,1,"き"],[8,1,"かれ"],[10,1,"つか"],[17,1,"かれ"],[22,1,"ひ"],[24,2,"こうふく"],[27,1,"す"],[33,1,"とし"],[35,1,"たの"],[38,1,"おく"]],"text":"もし彼らが聞いて彼に仕えるならば、彼らはその日を幸福に過ごし、その年を楽しく送るであろう。"},{"ref":"Job.36.12","start":18036012,"end":18036012,"break":"line","breaks":[[24,"line"]],"ruby":[[3,1,"かれ"],[6,1,"き"],[21,1,"ほろ"],[24,2,"ちしき"],[27,1,"え"],[31,1,"し"]],"text":"しかし彼らが聞かないならば、つるぎによって滅び、知識を得ないで死ぬであろう。"},{"ref":"Job.36.13","start":18036013,"end":18036013,"break":"stanza","breaks":[[20,"line"]],"ruby":[[0,1,"こころ"],[2,1,"かみ"],[4,1,"しん"],[8,1,"もの"],[12,1,"いか"],[20,1,"かみ"],[22,1,"しば"],[26,1,"とき"],[29,1,"たす"],[32,1,"よ"],[34,1,"もと"]],"text":"心に神を信じない者どもは怒りをたくわえ、神に縛られる時も、助けを呼び求めることをしない。"},{"ref":"Job.36.14","start":18036014,"end":18036014,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[3,1,"とし"],[4,1,"わか"],[8,1,"し"],[13,1,"いのち"],[15,1,"はじ"],[20,1,"おわ"]],"text":"彼らは年若くして死に、その命は恥のうちに終る。"},{"ref":"Job.36.15","start":18036015,"end":18036015,"break":"stanza","breaks":[[19,"line"]],"ruby":[[0,1,"かみ"],[2,1,"くる"],[5,1,"もの"],[9,1,"くる"],[16,1,"すく"],[19,1,"かれ"],[22,1,"みみ"],[24,2,"ぎゃっきょう"],[30,1,"ひら"]],"text":"神は苦しむ者をその苦しみによって救い、彼らの耳を逆境によって開かれる。"},{"ref":"Job.36.16","start":18036016,"end":18036016,"break":"line","breaks":[[13,"line"],[29,"line"],[45,"line"]],"ruby":[[0,1,"かみ"],[8,1,"なや"],[13,2,"そくばく"],[18,1,"ひろ"],[20,1,"ところ"],[22,1,"さそ"],[24,1,"だ"],[36,2,"しょくたく"],[39,1,"お"],[43,1,"もの"],[48,1,"こ"],[51,1,"もの"]],"text":"神はまたあなたを悩みから、束縛のない広い所に誘い出された。そしてあなたの食卓に置かれた物はすべて肥えた物であった。"},{"ref":"Job.36.17","start":18036017,"end":18036017,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[7,2,"あくにん"],[22,1,"み"],[30,2,"こうぎ"],[37,1,"とら"]],"text":"しかしあなたは悪人のうくべきさばきをおのれに満たし、さばきと公義はあなたを捕えている。"},{"ref":"Job.36.18","start":18036018,"end":18036018,"break":"line","breaks":[[12,"line"],[27,"line"]],"ruby":[[4,1,"いか"],[7,1,"さそ"],[17,1,"おちい"],[23,1,"こころ"],[34,1,"おお"],[47,1,"あやま"]],"text":"あなたは怒りに誘われて、あざけりに陥らぬように心せよ。あがないしろの大いなるがために、おのれを誤るな。"},{"ref":"Job.36.19","start":18036019,"end":18036019,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[4,1,"さけ"],[11,1,"まも"],[15,1,"なや"],[18,1,"まぬか"],[32,1,"ちから"],[39,1,"やく"],[41,1,"た"]],"text":"あなたの叫びはあなたを守って、悩みを免れさせるであろうか、いかに力をつくしても役に立たない。"},{"ref":"Job.36.20","start":18036020,"end":18036020,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"ひとびと"],[5,1,"ところ"],[8,1,"た"],[14,1,"よ"],[16,1,"した"]],"text":"人々がその所から断たれるその夜を慕ってはならない。"},{"ref":"Job.36.21","start":18036021,"end":18036021,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"つつし"],[3,1,"あく"],[5,1,"かたむ"],[18,1,"なや"],[29,1,"えら"]],"text":"慎んで悪に傾いてはならない。あなたは悩みよりもむしろこれを選んだからだ。"},{"ref":"Job.36.22","start":18036022,"end":18036022,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[7,1,"ちから"],[22,1,"かれ"],[27,1,"おし"],[30,1,"もの"]],"text":"見よ、神はその力をもってあがめられる。だれか彼のように教える者があるか。"},{"ref":"Job.36.23","start":18036023,"end":18036023,"break":"line","breaks":[[21,"line"],[37,"line"]],"ruby":[[3,1,"かれ"],[10,1,"みち"],[12,1,"さだ"],[15,1,"もの"],[29,1,"わる"],[31,1,"こと"],[37,1,"い"],[41,1,"もの"]],"text":"だれか彼のためにその道を定めた者があるか。だれか『あなたは悪い事をした』と言いうる者があるか。"},{"ref":"Job.36.24","start":18036024,"end":18036024,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かみ"],[12,1,"こと"],[14,1,"わす"],[26,2,"ひとびと"],[29,1,"うた"]],"text":"神のみわざをほめたたえる事を忘れてはならない。これは人々の歌いあがめるところである。"},{"ref":"Job.36.25","start":18036025,"end":18036025,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"ひと"],[9,1,"あお"],[11,1,"み"],[14,1,"ひと"],[16,1,"とお"],[23,1,"み"]],"text":"すべての人はこれを仰ぎ見る。人は遠くからこれを見るにすぎない。"},{"ref":"Job.36.26","start":18036026,"end":18036026,"break":"line","breaks":[[16,"line"],[28,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[5,1,"おお"],[9,1,"もの"],[21,1,"かれ"],[23,1,"し"],[30,1,"とし"],[32,1,"かず"],[34,1,"はか"],[36,1,"し"]],"text":"見よ、神は大いなる者にいまして、われわれは彼を知らない。その年の数も計り知ることができない。"},{"ref":"Job.36.27","start":18036027,"end":18036027,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[2,1,"みず"],[9,1,"ひ"],[16,1,"きり"],[24,1,"あめ"]],"text":"彼は水のしたたりを引きあげ、その霧をしたたらせて雨とされる。"},{"ref":"Job.36.28","start":18036028,"end":18036028,"break":"line","ruby":[[0,1,"そら"],[5,1,"ふ"],[10,1,"ひと"],[12,1,"うえ"],[14,1,"ゆた"],[17,1,"そそ"]],"text":"空はこれを降らせて、人の上に豊かに注ぐ。"},{"ref":"Job.36.29","start":18036029,"end":18036029,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[3,1,"くも"],[5,1,"ひろ"],[14,2,"まくや"],[25,1,"さと"]],"text":"だれか雲の広がるわけと、その幕屋のとどろくわけとを悟ることができようか。"},{"ref":"Job.36.30","start":18036030,"end":18036030,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"み"],[3,1,"かれ"],[7,1,"ひかり"],[23,1,"うみ"],[25,1,"そこ"]],"text":"見よ、彼はその光をおのれのまわりにひろげ、また海の底をおおわれる。"},{"ref":"Job.36.31","start":18036031,"end":18036031,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[9,1,"たみ"],[15,2,"しょくもつ"],[18,1,"ゆた"],[21,1,"たま"]],"text":"彼はこれらをもって民をさばき、食物を豊かに賜い、"},{"ref":"Job.36.32","start":18036032,"end":18036032,"break":"line","breaks":[[15,"line"]],"ruby":[[10,1,"て"],[12,1,"つつ"],[18,1,"めい"],[21,1,"てき"],[23,1,"う"]],"text":"いなずまをもってもろ手を包み、これに命じて敵を打たせられる。"},{"ref":"Job.36.33","start":18036033,"end":18036033,"break":"line","breaks":[[8,"line"]],"ruby":[[8,1,"あく"],[14,1,"いか"],[17,1,"も"],[20,1,"かれ"],[22,1,"あらわ"]],"text":"そのとどろきは、悪にむかって怒りに燃える彼を現す。"}]