[{"ref":"Ps.97.1","start":19097001,"end":19097001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おう"],[9,1,"ち"],[11,1,"たの"],[15,1,"うみ"],[17,1,"そ"],[20,1,"おお"],[23,2,"くにぐに"],[26,1,"よろこ"]],"text":"主は王となられた。地は楽しみ、海に沿った多くの国々は喜べ。"},{"ref":"Ps.97.2","start":19097002,"end":19097002,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"くも"],[2,1,"くら"],[16,1,"ぎ"],[18,1,"せい"],[27,1,"もとい"]],"text":"雲と暗やみとはそのまわりにあり、義と正とはそのみくらの基である。"},{"ref":"Ps.97.3","start":19097003,"end":19097003,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"ひ"],[5,1,"まえ"],[7,1,"い"],[19,1,"や"]],"text":"火はそのみ前に行き、そのまわりのあだを焼きつくす。"},{"ref":"Ps.97.4","start":19097004,"end":19097004,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"せかい"],[10,1,"てら"],[13,1,"ち"],[15,1,"み"]],"text":"主のいなずまは世界を照し、地は見ておののく。"},{"ref":"Ps.97.5","start":19097005,"end":19097005,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"やま"],[7,1,"しゅ"],[10,1,"まえ"],[13,1,"ぜん"],[14,1,"ち"],[16,1,"しゅ"],[19,1,"まえ"],[28,1,"と"]],"text":"もろもろの山は主のみ前に、全地の主のみ前に、ろうのように溶けた。"},{"ref":"Ps.97.6","start":19097006,"end":19097006,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"てん"],[9,1,"ぎ"],[20,1,"たみ"],[24,2,"えいこう"],[27,1,"み"]],"text":"もろもろの天はその義をあらわし、よろずの民はその栄光を見た。"},{"ref":"Ps.97.7","start":19097007,"end":19097007,"break":"line","breaks":[[12,"line"],[30,"line"],[40,"line"]],"ruby":[[3,1,"きざ"],[6,1,"ぞう"],[8,1,"おが"],[10,1,"もの"],[16,2,"ぐうぞう"],[26,1,"ほこ"],[28,1,"もの"],[45,1,"かみ"],[47,1,"しゅ"],[50,1,"まえ"],[54,1,"ふ"]],"text":"すべて刻んだ像を拝む者、むなしい偶像をもってみずから誇る者ははずかしめをうける。もろもろの神は主のみ前にひれ伏す。"},{"ref":"Ps.97.8","start":19097008,"end":19097008,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[19,1,"き"],[22,1,"よろこ"],[28,1,"むすめ"],[32,1,"たの"]],"text":"主よ、あなたのさばきのゆえに、シオンは聞いて喜び、ユダの娘たちは楽しむ。"},{"ref":"Ps.97.9","start":19097009,"end":19097009,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"ぜん"],[8,1,"ち"],[10,1,"うえ"],[19,1,"たか"],[27,1,"かみ"],[33,1,"おお"]],"text":"主よ、あなたは全地の上にいまして、いと高く、もろもろの神にまさって大いにあがめられます。"},{"ref":"Ps.97.10","start":19097010,"end":19097010,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"あく"],[4,1,"にく"],[6,1,"もの"],[8,1,"あい"],[13,2,"せいと"],[20,1,"まも"],[26,1,"あ"],[29,1,"もの"],[31,1,"て"],[34,1,"たす"],[36,1,"だ"]],"text":"主は悪を憎む者を愛し、その聖徒のいのちを守り、これを悪しき者の手から助け出される。"},{"ref":"Ps.97.11","start":19097011,"end":19097011,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ひかり"],[2,1,"ただ"],[5,1,"ひと"],[10,1,"あらわ"],[13,1,"よろこ"],[16,1,"こころ"],[18,1,"ただ"],[21,1,"もの"]],"text":"光は正しい人のために現れ、喜びは心の正しい者のためにあらわれる。"},{"ref":"Ps.97.12","start":19097012,"end":19097012,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[6,1,"しゅ"],[11,1,"よろこ"],[16,1,"せい"],[20,1,"な"],[22,2,"かんしゃ"]],"text":"正しき人よ、主によって喜べ、その聖なるみ名に感謝せよ。"}]