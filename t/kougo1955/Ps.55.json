[{"ref":"Ps.55.1","start":19055001,"end":19055001,"break":"paragraph","title":"聖歌隊の指揮者によって琴をもってうたわせたダビデのマスキールの歌","breaks":[[19,"line"]],"ruby":[[0,1,"かみ"],[7,1,"いのり"],[9,1,"みみ"],[11,1,"かたむ"],[23,1,"ねが"],[26,1,"さ"],[29,1,"み"],[31,1,"かく"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[11,1,"こと"],[31,1,"うた"]],"text":"神よ、わたしの祈に耳を傾けてください。わたしの願いを避けて身を隠さないでください。"},{"ref":"Ps.55.2","start":19055002,"end":19055002,"break":"line","breaks":[[24,"line"]],"ruby":[[16,1,"こた"],[28,1,"なや"],[34,1,"よわ"]],"text":"わたしにみこころをとめ、わたしに答えてください。わたしは悩みによって弱りはて、"},{"ref":"Ps.55.3","start":19055003,"end":19055003,"break":"line","breaks":[[19,"line"],[28,"line"],[42,"line"]],"ruby":[[0,1,"てき"],[2,1,"こえ"],[5,1,"あ"],[8,1,"もの"],[19,1,"き"],[21,1,"くる"],[28,1,"かれ"],[35,1,"なや"],[38,1,"のぞ"],[42,1,"いか"],[49,1,"くる"]],"text":"敵の声と、悪しき者のしえたげとによって気が狂いそうです。彼らはわたしに悩みを臨ませ、怒ってわたしを苦しめるからです。"},{"ref":"Ps.55.4","start":19055004,"end":19055004,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"こころ"],[14,1,"くる"],[18,1,"し"],[20,1,"おそ"],[27,1,"うえ"],[29,1,"お"]],"text":"わたしの心はわがうちにもだえ苦しみ、死の恐れがわたしの上に落ちました。"},{"ref":"Ps.55.5","start":19055005,"end":19055005,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おそ"],[12,1,"のぞ"],[21,1,"おそ"]],"text":"恐れとおののきがわたしに臨み、はなはだしい恐れがわたしをおおいました。"},{"ref":"Ps.55.6","start":19055006,"end":19055006,"break":"line","breaks":[[9,"line"],[30,"line"]],"ruby":[[4,1,"い"],[20,1,"つばさ"],[39,1,"と"],[41,1,"さ"],[44,1,"やす"],[47,1,"え"]],"text":"わたしは言います、「どうか、はとのように翼をもちたいものだ。そうすればわたしは飛び去って安きを得るであろう。"},{"ref":"Ps.55.7","start":19055007,"end":19055007,"break":"line","ruby":[[4,1,"とお"],[9,1,"さ"],[13,1,"の"],[15,1,"やど"]],"text":"わたしは遠くのがれ去って、野に宿ろう。〔セラ"},{"ref":"Ps.55.8","start":19055008,"end":19055008,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"いそ"],[6,2,"ひなん"]],"text":"わたしは急ぎ避難して、はやてとあらしをのがれよう」と。"},{"ref":"Ps.55.9","start":19055009,"end":19055009,"break":"line","breaks":[[22,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かれ"],[12,1,"う"],[14,1,"やぶ"],[22,1,"かれ"],[25,1,"した"],[27,2,"こんらん"],[41,1,"まち"],[46,2,"ぼうりょく"],[49,1,"あらそ"],[53,1,"み"]],"text":"主よ、彼らのはかりごとを打ち破ってください。彼らの舌を混乱させてください。わたしは町のうちに暴力と争いとを見るからです。"},{"ref":"Ps.55.10","start":19055010,"end":19055010,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ひる"],[5,1,"よる"],[7,1,"まち"],[9,2,"じょうへき"],[12,1,"うえ"],[14,1,"ある"],[20,1,"まち"],[26,2,"がいあく"],[29,1,"なや"]],"text":"彼らは昼も夜も町の城壁の上を歩きめぐり、町のうちには害悪と悩みとがあります。"},{"ref":"Ps.55.11","start":19055011,"end":19055011,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[2,1,"ほろ"],[5,1,"こと"],[7,1,"まち"],[20,1,"あざむ"],[26,2,"いちば"],[29,1,"はな"]],"text":"また滅ぼす事が町のうちにあり、しえたげと欺きとはその市場を離れることがありません。"},{"ref":"Ps.55.12","start":19055012,"end":19055012,"break":"line","breaks":[[19,"line"],[39,"line"],[62,"line"],[77,"line"]],"ruby":[[8,1,"もの"],[10,1,"てき"],[29,1,"しの"],[47,1,"たか"],[50,1,"もの"],[72,1,"み"],[74,1,"かく"],[77,1,"かれ"],[79,1,"さ"]],"text":"わたしをののしる者は敵ではありません。もしそうであるならば忍ぶことができます。わたしにむかって高ぶる者はあだではありません。もしそうであるならば身を隠して彼を避けることができます。"},{"ref":"Ps.55.13","start":19055013,"end":19055013,"break":"line","breaks":[[20,"line"]],"ruby":[[16,1,"おな"],[18,1,"もの"],[24,2,"どうりょう"],[31,1,"した"],[34,1,"とも"]],"text":"しかしそれはあなたです、わたしと同じ者、わたしの同僚、わたしの親しい友です。"},{"ref":"Ps.55.14","start":19055014,"end":19055014,"break":"line","breaks":[[15,"line"]],"ruby":[[8,1,"たの"],[11,1,"かた"],[20,1,"かみ"],[22,1,"みや"],[24,1,"のぼ"]],"text":"われらはたがいに楽しく語らい、つれだって神の宮に上りました。"},{"ref":"Ps.55.15","start":19055015,"end":19055015,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[4,1,"し"],[6,1,"かれ"],[9,1,"のぞ"],[13,1,"い"],[19,2,"よみ"],[22,1,"くだ"],[26,1,"おそ"],[32,1,"かれ"],[35,1,"はか"],[37,1,"さ"]],"text":"どうぞ、死を彼らに臨ませ、生きたままで陰府に下らせ、恐れをもって彼らを墓に去らせてください。"},{"ref":"Ps.55.16","start":19055016,"end":19055016,"break":"line","breaks":[[15,"line"]],"ruby":[[7,1,"かみ"],[9,1,"よ"],[15,1,"しゅ"],[21,1,"すく"]],"text":"しかしわたしが神に呼ばわれば、主はわたしを救われます。"},{"ref":"Ps.55.17","start":19055017,"end":19055017,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"ゆう"],[9,2,"まひる"],[16,1,"なげ"],[23,1,"しゅ"],[29,1,"こえ"],[31,1,"き"]],"text":"夕べに、あしたに、真昼にわたしが嘆きうめけば、主はわたしの声を聞かれます。"},{"ref":"Ps.55.18","start":19055018,"end":19055018,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[7,1,"せ"],[10,1,"もの"],[12,1,"おお"],[17,1,"しゅ"],[27,1,"たたか"],[35,1,"やす"],[39,1,"すく"],[41,1,"だ"]],"text":"たといわたしを攻める者が多くとも、主はわたしがたたかう戦いからわたしを安らかに救い出されます。"},{"ref":"Ps.55.19","start":19055019,"end":19055019,"break":"line","breaks":[[16,"line"],[35,"line"]],"ruby":[[0,1,"むかし"],[7,1,"ざ"],[14,1,"かみ"],[16,1,"き"],[19,1,"かれ"],[22,1,"なや"],[35,1,"かれ"],[42,1,"まも"],[46,1,"かみ"],[48,1,"おそ"]],"text":"昔からみくらに座しておられる神は聞いて彼らを悩まされるでしょう。〔セラ彼らはおきてを守らず、神を恐れないからです。"},{"ref":"Ps.55.20","start":19055020,"end":19055020,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"とも"],[8,1,"した"],[11,1,"もの"],[13,1,"て"],[15,1,"の"],[22,2,"けいやく"],[25,1,"やぶ"]],"text":"わたしの友はその親しき者に手を伸ばして、その契約を破った。"},{"ref":"Ps.55.21","start":19055021,"end":19055021,"break":"line","breaks":[[16,"line"],[27,"line"],[43,"line"]],"ruby":[[2,1,"くち"],[4,2,"ぎゅうらく"],[18,1,"こころ"],[21,1,"たたか"],[29,2,"ことば"],[32,1,"あぶら"],[46,1,"ぬ"]],"text":"その口は牛酪よりもなめらかだが、その心には戦いがある。その言葉は油よりもやわらかだが、それは抜いたつるぎである。"},{"ref":"Ps.55.22","start":19055022,"end":19055022,"break":"line","breaks":[[13,"line"],[26,"line"]],"ruby":[[4,1,"に"],[6,1,"しゅ"],[13,1,"しゅ"],[26,1,"しゅ"],[28,1,"ただ"],[31,1,"ひと"],[33,1,"うご"],[40,1,"けっ"]],"text":"あなたの荷を主にゆだねよ。主はあなたをささえられる。主は正しい人の動かされるのを決してゆるされない。"},{"ref":"Ps.55.23","start":19055023,"end":19055023,"break":"line","breaks":[[13,"line"],[27,"line"],[38,"line"],[62,"line"]],"ruby":[[3,1,"しゅ"],[10,1,"かれ"],[13,1,"ほろ"],[16,1,"あな"],[18,1,"な"],[20,1,"い"],[27,1,"ち"],[29,1,"なが"],[31,1,"もの"],[33,1,"あざむ"],[35,1,"もの"],[41,1,"ひ"],[43,1,"なか"],[46,1,"い"],[73,1,"よ"],[75,1,"たの"]],"text":"しかし主よ、あなたは彼らを滅びの穴に投げ入れられます。血を流す者と欺く者とはおのが日の半ばも生きながらえることはできません。しかしわたしはあなたに寄り頼みます。"}]