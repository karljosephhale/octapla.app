[{"ref":"2Chr.29.1","start":14029001,"end":14029001,"break":"paragraph","ruby":[[5,1,"おう"],[10,1,"とき"],[14,1,"さい"],[20,1,"ねん"],[22,1,"あいだ"],[29,1,"よ"],[31,1,"おさ"],[37,1,"はは"],[43,1,"い"],[52,1,"むすめ"]],"text":"ヒゼキヤは王となった時二十五歳で、二十九年の間エルサレムで世を治めた。その母はアビヤと言って、ゼカリヤの娘である。"},{"ref":"2Chr.29.2","start":14029002,"end":14029002,"break":"none","ruby":[[5,1,"ちち"],[19,1,"しゅ"],[21,1,"よ"],[24,1,"み"]],"text":"ヒゼキヤは父ダビデがすべてなしたように主の良しと見られることをした。"},{"ref":"2Chr.29.3","start":14029003,"end":14029003,"break":"paragraph","ruby":[[0,1,"かれ"],[4,2,"ちせい"],[7,1,"だい"],[9,1,"ねん"],[12,1,"がつ"],[14,1,"しゅ"],[16,1,"みや"],[18,1,"と"],[20,1,"ひら"],[28,1,"つくろ"]],"text":"彼はその治世の第一年の一月に主の宮の戸を開き、かつこれを繕った。"},{"ref":"2Chr.29.4","start":14029004,"end":14029004,"break":"none","ruby":[[0,1,"かれ"],[2,2,"さいし"],[10,1,"つ"],[17,1,"ひがし"],[19,2,"ひろば"],[22,1,"あつ"]],"text":"彼は祭司とレビびとを連れていって、東の広場に集め、"},{"ref":"2Chr.29.5","start":14029005,"end":14029005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[14,1,"き"],[26,1,"いま"],[28,1,"み"],[30,1,"きよ"],[40,2,"せんぞ"],[43,1,"かみ"],[45,1,"しゅ"],[47,1,"みや"],[49,1,"きよ"],[52,2,"せいじょ"],[56,1,"けが"],[59,1,"のぞ"],[61,1,"さ"]],"text":"彼らに言った、「レビびとよ、聞きなさい。あなたがたは今、身を清めて、あなたがたの先祖の神、主の宮を清め、聖所から汚れを除き去りなさい。"},{"ref":"2Chr.29.6","start":14029006,"end":14029006,"break":"none","ruby":[[5,2,"せんぞ"],[8,1,"つみ"],[10,1,"おか"],[18,1,"かみ"],[20,1,"しゅ"],[22,1,"あく"],[24,1,"み"],[31,1,"い"],[35,1,"しゅ"],[37,1,"す"],[40,1,"しゅ"],[46,1,"かお"],[56,1,"む"]],"text":"われわれの先祖は罪を犯し、われわれの神、主の悪と見られることを行って、主を捨て、主のすまいに顔をそむけ、うしろを向けた。"},{"ref":"2Chr.29.7","start":14029007,"end":14029007,"break":"none","ruby":[[2,1,"ろう"],[4,1,"と"],[6,1,"と"],[14,1,"け"],[17,2,"せいじょ"],[26,1,"かみ"],[28,1,"こう"],[34,2,"はんさい"]],"text":"また廊の戸を閉じ、ともしびを消し、聖所でイスラエルの神に香をたかず、燔祭をささげなかった。"},{"ref":"2Chr.29.8","start":14029008,"end":14029008,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"いか"],[19,1,"のぞ"],[28,1,"め"],[30,1,"み"],[36,1,"しゅ"],[38,1,"かれ"],[41,1,"おそ"],[44,1,"おどろ"],[47,2,"ものわら"]],"text":"それゆえ、主の怒りはユダとエルサレムに臨み、あなたがたが目に見るように、主は彼らを恐れと驚きと物笑いにされた。"},{"ref":"2Chr.29.9","start":14029009,"end":14029009,"break":"none","ruby":[[0,1,"み"],[8,1,"ちち"],[37,1,"つま"],[47,2,"ほりょ"]],"text":"見よ、われわれの父たちはつるぎにたおれ、われわれのむすこたち、むすめたち、妻たちはこれがために捕虜となった。"},{"ref":"2Chr.29.10","start":14029010,"end":14029010,"break":"none","ruby":[[0,1,"いま"],[12,1,"かみ"],[14,1,"しゅ"],[16,2,"けいやく"],[19,1,"むす"],[21,1,"こころざし"],[36,1,"はげ"],[39,1,"いか"],[48,1,"はな"]],"text":"今わたしは、イスラエルの神、主と契約を結ぶ志をもっている。そうすればその激しい怒りは、われわれを離れるであろう。"},{"ref":"2Chr.29.11","start":14029011,"end":14029011,"break":"none","ruby":[[2,1,"こ"],[6,1,"いま"],[8,1,"おこた"],[17,1,"しゅ"],[25,1,"えら"],[29,1,"しゅ"],[31,1,"まえ"],[33,1,"た"],[36,1,"つか"],[42,2,"じぶん"],[45,1,"つか"],[48,1,"もの"],[55,1,"こう"],[59,1,"もの"]],"text":"わが子らよ、今は怠ってはならない。主はあなたがたを選んで、主の前に立って仕えさせ、ご自分に仕える者となし、また香をたく者とされたからである」。"},{"ref":"2Chr.29.12","start":14029012,"end":14029012,"break":"none","ruby":[[8,1,"た"],[10,1,"あ"],[25,2,"しそん"],[38,1,"こ"],[50,1,"こ"],[59,2,"しそん"],[68,1,"こ"],[80,1,"こ"],[103,1,"こ"],[112,1,"こ"]],"text":"そこでレビびとは立ち上がった。すなわちコハテびとの子孫のうちでは、アマサイの子マハテおよびアザリヤの子ヨエル。メラリの子孫では、アブデの子キシおよびエハレレルの子アザリヤ。ゲルションびとのうちでは、ジンマの子ヨアおよびヨアの子エデン。"},{"ref":"2Chr.29.13","start":14029013,"end":14029013,"break":"none","ruby":[[6,2,"しそん"],[27,2,"しそん"]],"text":"エリザパンの子孫のうちでは、シムリとエイエル。アサフの子孫のうちでは、ゼカリヤとマッタニヤ。"},{"ref":"2Chr.29.14","start":14029014,"end":14029014,"break":"none","ruby":[[4,2,"しそん"],[26,2,"しそん"]],"text":"ヘマンの子孫のうちでは、エヒエルとシメイ。エドトンの子孫のうちでは、シマヤとウジエルである。"},{"ref":"2Chr.29.15","start":14029015,"end":14029015,"break":"none","ruby":[[0,1,"かれ"],[5,2,"きょうだい"],[10,1,"あつ"],[13,1,"み"],[15,1,"きよ"],[18,1,"しゅ"],[20,2,"ことば"],[25,1,"おう"],[27,2,"めいれい"],[30,1,"したが"],[34,1,"しゅ"],[36,1,"みや"],[38,1,"きよ"],[48,1,"き"]],"text":"彼らはその兄弟たちを集めて身を清め、主の言葉による王の命令に従って、主の宮を清めるためにはいって来た。"},{"ref":"2Chr.29.16","start":14029016,"end":14029016,"break":"none","ruby":[[0,2,"さいし"],[5,1,"しゅ"],[7,1,"みや"],[9,1,"おく"],[18,1,"きよ"],[21,1,"しゅ"],[23,1,"みや"],[28,1,"けが"],[31,1,"もの"],[38,1,"しゅ"],[40,1,"みや"],[42,1,"にわ"],[44,1,"はこ"],[46,1,"だ"],[58,1,"う"],[61,1,"そと"],[63,1,"だ"],[70,1,"かわ"],[72,1,"も"],[75,1,"い"]],"text":"祭司たちが主の宮の奥にはいってこれを清め、主の宮にあった汚れた物をことごとく主の宮の庭に運び出すと、レビびとはそれを受けて外に出し、キデロン川に持って行った。"},{"ref":"2Chr.29.17","start":14029017,"end":14029017,"break":"none","ruby":[[0,1,"かれ"],[3,2,"しょうがつ"],[6,2,"がんじつ"],[9,1,"きよ"],[15,1,"はじ"],[21,1,"つき"],[24,1,"か"],[26,1,"しゅ"],[28,1,"みや"],[30,1,"ろう"],[32,1,"たっ"],[40,1,"しゅ"],[42,1,"みや"],[44,1,"きよ"],[50,1,"か"],[52,1,"ついや"],[55,2,"しょうがつ"],[60,1,"にち"],[65,1,"おわ"]],"text":"彼らは正月の元日に清めることを始めて、その月の八日に主の宮の廊に達した。それから主の宮を清めるのに八日を費し、正月の十六日にこれを終った。"},{"ref":"2Chr.29.18","start":14029018,"end":14029018,"break":"none","ruby":[[3,1,"かれ"],[10,1,"おう"],[12,1,"ところ"],[14,1,"い"],[17,1,"い"],[27,1,"しゅ"],[29,1,"みや"],[36,1,"きよ"],[41,2,"はんさい"],[44,1,"だん"],[52,2,"うつわもの"],[58,1,"そな"],[64,1,"つくえ"],[72,2,"うつわもの"],[76,1,"きよ"]],"text":"そこで彼らはヒゼキヤ王の所へ行って言った、「われわれは主の宮をことごとく清め、また燔祭の壇とそのすべての器物、および供えのパンの机とそのすべての器物とを清めました。"},{"ref":"2Chr.29.19","start":14029019,"end":14029019,"break":"none","ruby":[[5,1,"おう"],[9,2,"ちせい"],[12,1,"つみ"],[14,1,"おか"],[17,1,"す"],[24,2,"うつわもの"],[28,1,"ととの"],[31,1,"きよ"],[41,1,"しゅ"],[43,2,"さいだん"],[46,1,"まえ"]],"text":"またアハズ王がその治世に罪を犯して捨てたすべての器物をも整えて清めました。それらは主の祭壇の前にあります」。"},{"ref":"2Chr.29.20","start":14029020,"end":14029020,"break":"paragraph","ruby":[[7,1,"おう"],[9,1,"あさ"],[10,1,"はや"],[12,1,"お"],[17,1,"まち"],[25,1,"あつ"],[29,1,"しゅ"],[31,1,"みや"],[33,1,"のぼ"],[36,1,"い"]],"text":"そこでヒゼキヤ王は朝早く起きいで、町のつかさたちを集めて、主の宮に上って行き、"},{"ref":"2Chr.29.21","start":14029021,"end":14029021,"break":"none","ruby":[[0,2,"おうし"],[3,1,"とう"],[5,2,"おひつじ"],[8,1,"とう"],[10,2,"こひつじ"],[13,1,"とう"],[15,1,"お"],[19,1,"とう"],[21,1,"ひ"],[28,1,"くに"],[30,2,"せいじょ"],[42,2,"ざいさい"],[51,2,"しそん"],[56,2,"さいし"],[61,1,"めい"],[67,1,"しゅ"],[69,2,"さいだん"],[72,1,"うえ"]],"text":"雄牛七頭、雄羊七頭、小羊七頭、雄やぎ七頭を引いてこさせ、国と聖所とユダのためにこれを罪祭とし、アロンの子孫である祭司たちに命じてこれを主の祭壇の上にささげさせた。"},{"ref":"2Chr.29.22","start":14029022,"end":14029022,"break":"none","ruby":[[5,2,"おうし"],[13,2,"さいし"],[20,1,"ち"],[22,1,"う"],[25,2,"さいだん"],[35,2,"おひつじ"],[45,1,"ち"],[47,2,"さいだん"],[57,2,"こひつじ"],[67,1,"ち"],[69,2,"さいだん"]],"text":"すなわち、雄牛をほふると、祭司たちはその血を受けて祭壇にふりかけ、また雄羊をほふると、その血を祭壇にふりかけ、また小羊をほふると、その血を祭壇にふりかけた。"},{"ref":"2Chr.29.23","start":14029023,"end":14029023,"break":"none","ruby":[[3,2,"ざいさい"],[6,1,"お"],[10,1,"おう"],[12,2,"かいしゅう"],[15,1,"まえ"],[17,1,"ひ"],[20,1,"き"],[25,1,"かれ"],[30,1,"うえ"],[32,1,"て"],[34,1,"お"]],"text":"そして罪祭の雄やぎを王と会衆の前に引いて来たので、彼らはその上に手を置いた。"},{"ref":"2Chr.29.24","start":14029024,"end":14029024,"break":"none","ruby":[[3,2,"さいし"],[17,1,"ち"],[19,2,"ざいさい"],[24,2,"さいだん"],[27,1,"うえ"],[38,2,"ぜんこく"],[55,1,"おう"],[62,2,"ぜんこく"],[68,2,"はんさい"],[73,2,"ざいさい"],[83,1,"めい"]],"text":"そして祭司たちはこれをほふり、その血を罪祭として祭壇の上にささげてイスラエル全国のためにあがないをした。これは王がイスラエル全国のために燔祭および罪祭をささげることを命じたためである。"},{"ref":"2Chr.29.25","start":14029025,"end":14029025,"break":"paragraph","ruby":[[0,1,"おう"],[9,1,"しゅ"],[11,1,"みや"],[13,1,"お"],[22,1,"おう"],[24,3,"せんけんしゃ"],[30,3,"よげんしゃ"],[37,2,"めいれい"],[40,1,"したが"],[52,2,"たてごと"],[57,1,"こと"],[67,1,"しゅ"],[71,3,"よげんしゃ"],[78,1,"めい"]],"text":"王はまたレビびとを主の宮に置き、ダビデおよび王の先見者ガドと預言者ナタンの命令に従って、これにシンバル、立琴および琴をとらせた。これは主がその預言者によって命じられたところである。"},{"ref":"2Chr.29.26","start":14029026,"end":14029026,"break":"none","ruby":[[13,2,"がっき"],[19,2,"さいし"],[29,1,"た"]],"text":"こうしてレビびとはダビデの楽器をとり、祭司はラッパをとって立った。"},{"ref":"2Chr.29.27","start":14029027,"end":14029027,"break":"none","ruby":[[8,2,"はんさい"],[11,2,"さいだん"],[14,1,"うえ"],[23,1,"めい"],[27,2,"はんさい"],[33,1,"はじ"],[36,1,"とき"],[38,1,"しゅ"],[40,1,"うた"],[50,1,"ふ"],[59,1,"おう"],[64,2,"がっき"],[70,1,"はじ"]],"text":"そこでヒゼキヤは燔祭を祭壇の上にささげることを命じた。燔祭をささげ始めた時、主の歌をうたい、ラッパを吹き、イスラエルの王ダビデの楽器をならし始めた。"},{"ref":"2Chr.29.28","start":14029028,"end":14029028,"break":"none","ruby":[[3,2,"かいしゅう"],[6,1,"みな"],[7,2,"れいはい"],[11,1,"うた"],[15,1,"もの"],[17,1,"うた"],[26,1,"て"],[32,1,"ふ"],[34,1,"な"],[38,2,"はんさい"],[41,1,"おわ"]],"text":"そして会衆は皆礼拝し、歌うたう者は歌をうたい、ラッパ手はラッパを吹き鳴らし、燔祭が終るまですべてこのようであったが、"},{"ref":"2Chr.29.29","start":14029029,"end":14029029,"break":"none","ruby":[[4,1,"こと"],[6,1,"おわ"],[10,1,"おう"],[14,1,"かれ"],[16,1,"とも"],[20,1,"もの"],[24,1,"み"],[30,2,"れいはい"]],"text":"ささげる事が終ると、王および彼と共にいた者はみな身をかがめて礼拝した。"},{"ref":"2Chr.29.30","start":14029030,"end":14029030,"break":"none","ruby":[[6,1,"おう"],[21,1,"めい"],[29,3,"せんけんしゃ"],[36,2,"ことば"],[42,1,"しゅ"],[51,1,"かれ"],[54,1,"よろこ"],[62,1,"とう"],[67,2,"れいはい"]],"text":"またヒゼキヤ王およびつかさたちはレビびとに命じて、ダビデと先見者アサフの言葉をもって主をさんびさせた。彼らは喜んでさんびし、頭をさげて礼拝した。"},{"ref":"2Chr.29.31","start":14029031,"end":14029031,"break":"paragraph","ruby":[[2,1,"とき"],[9,1,"い"],[23,1,"しゅ"],[25,1,"つか"],[31,1,"み"],[33,1,"きよ"],[43,1,"すす"],[49,1,"しゅ"],[51,1,"みや"],[53,2,"ぎせい"],[56,2,"かんしゃ"],[59,1,"そな"],[61,1,"もの"],[63,1,"たずさ"],[66,1,"き"],[76,2,"かいしゅう"],[79,2,"ぎせい"],[82,2,"かんしゃ"],[85,1,"そな"],[87,1,"もの"],[89,1,"たずさ"],[92,1,"き"],[97,1,"こころざし"],[100,1,"もの"],[102,1,"みな"],[103,2,"はんさい"],[106,1,"たずさ"],[109,1,"き"]],"text":"その時、ヒゼキヤは言った、「あなたがたはすでに主に仕えるために身を清めたのであるから、進みよって、主の宮に犠牲と感謝の供え物を携えて来なさい」と。そこで会衆は犠牲と感謝の供え物を携えて来た。また志ある者は皆燔祭を携えて来た。"},{"ref":"2Chr.29.32","start":14029032,"end":14029032,"break":"none","ruby":[[0,2,"かいしゅう"],[3,1,"たずさ"],[6,1,"き"],[8,2,"はんさい"],[11,1,"かず"],[13,2,"おうし"],[17,1,"とう"],[19,2,"おひつじ"],[22,1,"とう"],[24,2,"こひつじ"],[28,1,"とう"],[34,1,"みな"],[35,1,"しゅ"],[37,2,"はんさい"]],"text":"会衆の携えて来た燔祭の数は雄牛七十頭、雄羊百頭、小羊二百頭、これらは皆主に燔祭としてささげるものであった。"},{"ref":"2Chr.29.33","start":14029033,"end":14029033,"break":"none","ruby":[[2,3,"ほうのうぶつ"],[6,1,"うし"],[9,1,"とう"],[11,2,"こひつじ"],[15,1,"とう"]],"text":"また奉納物は牛六百頭、小羊三千頭であった。"},{"ref":"2Chr.29.34","start":14029034,"end":14029034,"break":"none","ruby":[[4,2,"さいし"],[7,1,"すく"],[13,2,"はんさい"],[16,1,"もの"],[18,1,"かわ"],[40,2,"きょうだい"],[53,1,"たす"],[64,1,"お"],[69,1,"かん"],[71,1,"た"],[73,2,"さいし"],[78,1,"み"],[80,1,"きよ"],[92,2,"さいし"],[100,1,"み"],[102,1,"きよ"]],"text":"ところが祭司が少なくてその燔祭の物の皮を、はぎつくすことができなかったので、その兄弟であるレビびとがこれを助けて、そのわざをなし終え、その間に他の祭司たちは身を清めた。これはレビびとが祭司たちよりも、身を清めることに、きちょうめんであったからである。"},{"ref":"2Chr.29.35","start":14029035,"end":14029035,"break":"none","ruby":[[10,2,"はんさい"],[19,3,"しゅうおんさい"],[23,2,"しぼう"],[28,2,"はんさい"],[31,2,"かんさい"],[43,1,"しゅ"],[45,1,"みや"],[47,1,"つと"],[50,2,"かいふく"]],"text":"このほかおびただしい燔祭があり、また、酬恩祭の脂肪および燔祭の灌祭もあった。こうして、主の宮の勤めは回復された。"},{"ref":"2Chr.29.36","start":14029036,"end":14029036,"break":"none","ruby":[[2,1,"こと"],[18,1,"かみ"],[25,1,"たみ"],[30,1,"そな"],[50,1,"たみ"],[52,1,"よろこ"]],"text":"この事は、にわかになされたけれども、神がこのように民のために備えをされたので、ヒゼキヤおよびすべての民は喜んだ。"}]