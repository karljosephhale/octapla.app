[{"ref":"2Chr.31.1","start":14031001,"end":14031001,"break":"paragraph","ruby":[[2,1,"こと"],[7,1,"おわ"],[10,1,"とき"],[25,1,"みな"],[30,2,"まちまち"],[33,1,"で"],[35,1,"い"],[39,2,"せきちゅう"],[42,1,"くだ"],[48,1,"ぞう"],[50,1,"き"],[52,1,"たお"],[64,1,"ぜん"],[65,1,"ち"],[82,1,"たか"],[84,1,"ところ"],[86,2,"さいだん"],[90,1,"と"],[107,2,"はかい"],[121,2,"ひとびと"],[130,2,"まちまち"],[135,2,"しょりょう"],[138,1,"かえ"]],"text":"この事がすべて終った時、そこにいたイスラエルびとは皆、ユダの町々に出て行って、石柱を砕き、アシラ像を切り倒し、ユダとベニヤミンの全地、およびエフライムとマナセにある高き所と祭壇とを取りこわし、ついにこれをことごとく破壊した。そしてイスラエルの人々はおのおのその町々、その所領に帰った。"},{"ref":"2Chr.31.2","start":14031002,"end":14031002,"break":"paragraph","ruby":[[5,2,"さいし"],[15,1,"はん"],[17,1,"さだ"],[20,1,"はん"],[30,1,"つと"],[33,1,"したが"],[37,2,"さいし"],[45,2,"はんさい"],[48,3,"しゅうおんさい"],[58,1,"しゅ"],[62,1,"もん"],[64,1,"つと"],[69,2,"かんしゃ"]],"text":"ヒゼキヤは祭司およびレビびとの班を定め、班ごとにおのおのその勤めに従って、祭司とレビびとに燔祭と酬恩祭をささげさせ、主の営の門で勤めをし、感謝をし、さんびをさせた。"},{"ref":"2Chr.31.3","start":14031003,"end":14031003,"break":"none","ruby":[[2,2,"はんさい"],[8,2,"じぶん"],[11,2,"ざいさん"],[18,1,"おう"],[20,1,"ぶん"],[22,1,"だ"],[30,2,"あさゆう"],[33,2,"はんさい"],[38,3,"あんそくにち"],[42,2,"しんげつ"],[45,1,"さだ"],[48,1,"まつり"],[52,2,"はんさい"],[58,1,"だ"],[62,1,"しゅ"],[64,2,"りっぽう"]],"text":"また燔祭のために自分の財産のうちから王の分を出した。すなわち朝夕の燔祭および安息日、新月、定めの祭などの燔祭のために出して、主の律法にしるされているとおりにした。"},{"ref":"2Chr.31.4","start":14031004,"end":14031004,"break":"none","ruby":[[8,1,"す"],[10,1,"たみ"],[13,2,"さいし"],[23,1,"ぶん"],[25,1,"あた"],[31,1,"めい"],[38,1,"かれ"],[43,1,"しゅ"],[45,2,"りっぽう"],[48,1,"み"]],"text":"またエルサレムに住む民に、祭司とレビびとにその分を与えることを命じた。これは彼らをして主の律法に身をゆだねさせるためである。"},{"ref":"2Chr.31.5","start":14031005,"end":14031005,"break":"none","ruby":[[2,2,"めいれい"],[5,1,"つた"],[19,2,"ひとびと"],[22,2,"こくもつ"],[25,1,"さけ"],[27,1,"あぶら"],[29,1,"みつ"],[34,1,"はたけ"],[41,2,"さんぶつ"],[44,2,"はつもの"],[47,1,"おお"],[59,1,"もの"],[62,1,"ぶん"],[72,1,"たずさ"],[75,1,"き"]],"text":"その命令が伝わるやいなや、イスラエルの人々は穀物、酒、油、蜜ならびに畑のもろもろの産物の初物を多くささげ、またすべての物の十分の一をおびただしく携えて来た。"},{"ref":"2Chr.31.6","start":14031006,"end":14031006,"break":"none","ruby":[[3,2,"まちまち"],[6,1,"す"],[20,2,"ひとびと"],[25,1,"うし"],[27,1,"ひつじ"],[30,1,"ぶん"],[39,1,"かみ"],[41,1,"しゅ"],[49,3,"ほうのうぶつ"],[53,1,"たずさ"],[56,1,"き"],[62,1,"つ"],[64,1,"かさ"]],"text":"ユダの町々に住んでいたイスラエルとユダの人々もまた牛、羊の十分の一ならびにその神、主にささげられた奉納物を携えて来て、これを積み重ねた。"},{"ref":"2Chr.31.7","start":14031007,"end":14031007,"break":"none","ruby":[[1,1,"がつ"],[6,1,"つ"],[8,1,"かさ"],[14,1,"はじ"],[18,1,"がつ"],[23,1,"おわ"]],"text":"三月にこれを積み重ねることを始め、七月にこれを終った。"},{"ref":"2Chr.31.8","start":14031008,"end":14031008,"break":"none","ruby":[[13,1,"き"],[18,1,"つ"],[20,1,"かさ"],[23,1,"もの"],[25,1,"み"],[27,1,"しゅ"],[31,1,"たみ"],[38,2,"しゅくふく"]],"text":"ヒゼキヤおよびつかさたちは来て、その積み重ねた物を見、主とその民イスラエルを祝福した。"},{"ref":"2Chr.31.9","start":14031009,"end":14031009,"break":"none","ruby":[[10,1,"つ"],[12,1,"かさ"],[15,1,"もの"],[20,2,"さいし"],[30,1,"と"],[32,1,"たず"],[35,1,"とき"]],"text":"そしてヒゼキヤがその積み重ねた物について祭司およびレビびとに問い尋ねた時、"},{"ref":"2Chr.31.10","start":14031010,"end":14031010,"break":"none","ruby":[[4,1,"いえ"],[7,1,"で"],[9,2,"さいし"],[12,1,"ちょう"],[18,1,"かれ"],[20,1,"こた"],[23,1,"い"],[28,1,"たみ"],[30,1,"しゅ"],[32,1,"みや"],[34,1,"そな"],[36,1,"もの"],[38,1,"たずさ"],[41,1,"く"],[46,1,"はじ"],[61,1,"あ"],[66,1,"た"],[75,1,"のこ"],[81,1,"しゅ"],[85,1,"たみ"],[87,1,"めぐ"],[110,1,"おお"],[113,1,"のこ"],[116,1,"もの"]],"text":"ザドクの家から出た祭司の長アザリヤは彼に答えて言った、「民が主の宮に供え物を携えて来ることを始めてからこのかた、われわれは飽きるほど食べたが、たくさん残りました。主がその民を恵まれたからです。それでわれわれは、このように多くの残った物をもっているのです」。"},{"ref":"2Chr.31.11","start":14031011,"end":14031011,"break":"paragraph","ruby":[[8,1,"しゅ"],[10,1,"みや"],[15,1,"しつ"],[17,1,"もう"],[23,1,"めい"],[29,1,"かれ"],[35,1,"もう"]],"text":"そこでヒゼキヤは主の宮のうちに室を設けることを命じたので、彼らはこれを設け、"},{"ref":"2Chr.31.12","start":14031012,"end":14031012,"break":"none","ruby":[[2,1,"そな"],[4,1,"もの"],[7,1,"ぶん"],[13,3,"ほうのうぶつ"],[17,2,"ちゅうじつ"],[20,1,"たずさ"],[22,1,"い"],[34,1,"もの"],[52,2,"きょうだい"],[58,1,"かれ"],[60,1,"つ"],[62,1,"もの"]],"text":"その供え物の十分の一および奉納物を忠実に携え入れた。これをつかさどる者のかしらはレビびとコナニヤで、その兄弟シメイは彼に次ぐ者となり、"},{"ref":"2Chr.31.13","start":14031013,"end":14031013,"break":"none","ruby":[[54,1,"おう"],[58,1,"かみ"],[60,1,"みや"],[70,2,"にんめい"],[86,2,"きょうだい"],[92,1,"たす"],[98,2,"かんとく"],[100,1,"しゃ"]],"text":"エヒエル、アザジヤ、ナハテ、アサヘル、エレモテ、ヨザバデ、エリエル、イスマキヤ、マハテ、ベナヤらは、ヒゼキヤ王および神の宮のつかさアザリヤの任命によって、コナニヤおよびその兄弟シメイを助けて、その監督者となった。"},{"ref":"2Chr.31.14","start":14031014,"end":14031014,"break":"none","ruby":[[0,1,"ひがし"],[2,1,"もん"],[4,1,"まも"],[6,1,"もの"],[15,1,"こ"],[20,1,"かみ"],[26,2,"じはつ"],[32,1,"もの"],[40,1,"しゅ"],[42,1,"そな"],[44,1,"もの"],[48,1,"もっと"],[50,1,"せい"],[53,1,"もの"],[55,2,"ぶんぱい"]],"text":"東の門を守る者レビびとイムナの子コレは、神にささげる自発のささげ物をつかさどり、主の供え物および最も聖なる物を分配した。"},{"ref":"2Chr.31.15","start":14031015,"end":14031015,"break":"none","ruby":[[0,1,"かれ"],[2,1,"たす"],[5,1,"もの"],[39,1,"みな"],[40,2,"さいし"],[43,2,"まちまち"],[48,2,"きょうだい"],[54,1,"はん"],[60,2,"ろうにゃく"],[66,2,"ちゅうじつ"],[69,2,"ぶんぱい"]],"text":"彼を助ける者はエデン、ミニヤミン、エシュア、シマヤ、アマリヤおよびシカニヤで、皆祭司の町々でその兄弟たちに、班によって、老若ひとしく忠実に分配した。"},{"ref":"2Chr.31.16","start":14031016,"end":14031016,"break":"none","ruby":[[6,2,"とうろく"],[12,1,"さい"],[13,2,"いじょう"],[16,2,"だんし"],[19,1,"しゅ"],[21,1,"みや"],[23,1,"い"],[28,1,"はん"],[30,1,"したが"],[33,2,"ひび"],[36,2,"しょくぶん"],[45,2,"うけもち"],[48,1,"つと"],[53,1,"もの"],[55,1,"のぞ"]],"text":"ただしすべて登録された三歳以上の男子で主の宮に入り、その班に従って日々の職分をつくし、その受持の勤めをなす者は除かれた。"},{"ref":"2Chr.31.17","start":14031017,"end":14031017,"break":"none","ruby":[[0,2,"さいし"],[3,2,"とうろく"],[8,2,"しぞく"],[20,1,"さい"],[21,2,"いじょう"],[29,2,"とうろく"],[34,1,"はん"],[41,2,"うけもち"]],"text":"祭司の登録はその氏族によってなされ、二十歳以上のレビびとの登録はその班により、その受持にしたがってなされた。"},{"ref":"2Chr.31.18","start":14031018,"end":14031018,"break":"none","ruby":[[2,2,"さいし"],[7,1,"おさ"],[9,1,"こ"],[13,1,"つま"],[23,1,"むすめ"],[25,1,"ぜん"],[26,2,"かいしゅう"],[29,1,"とも"],[31,2,"とうろく"],[36,1,"かれ"],[39,2,"ちゅうじつ"],[42,1,"み"],[44,1,"せい"],[47,1,"こと"]],"text":"また祭司はその幼な子、その妻、そのむすこ、その娘、全会衆と共に登録した。彼らは忠実に身を聖なる事にささげたからである。"},{"ref":"2Chr.31.19","start":14031019,"end":14031019,"break":"none","ruby":[[2,2,"まちまち"],[5,2,"ほうぼく"],[7,1,"ち"],[15,2,"しそん"],[20,2,"さいし"],[30,1,"まち"],[34,1,"ひと"],[36,1,"な"],[39,1,"えら"],[43,2,"さいし"],[53,1,"おとこ"],[65,2,"とうろく"],[74,1,"もの"],[79,1,"ぶん"],[81,1,"あた"]],"text":"また町々の放牧地におるアロンの子孫である祭司たちのためには、町ごとに人を名ざし選んで、祭司のうちのすべての男およびレビびとのうちの登録されたすべての者に、その分を与えさせた。"},{"ref":"2Chr.31.20","start":14031020,"end":14031020,"break":"paragraph","ruby":[[7,2,"ぜんこく"],[17,1,"よ"],[19,1,"こと"],[21,1,"ただ"],[24,1,"こと"],[26,2,"ちゅうじつ"],[29,1,"こと"],[33,1,"かみ"],[35,1,"しゅ"],[37,1,"まえ"],[39,1,"い"]],"text":"ヒゼキヤはユダ全国にこのようにし、良い事、正しい事、忠実な事をその神、主の前に行った。"},{"ref":"2Chr.31.21","start":14031021,"end":14031021,"break":"none","ruby":[[0,1,"かれ"],[4,1,"かみ"],[6,1,"もと"],[12,1,"かみ"],[14,1,"みや"],[16,1,"つとめ"],[21,2,"りっぽう"],[27,1,"いまし"],[33,1,"はじ"],[45,1,"こころ"],[51,1,"おこな"],[59,1,"と"]],"text":"彼がその神を求めるために神の宮の務につき、律法につき、戒めについて始めたわざは、ことごとく心をつくして行い、これをなし遂げた。"}]