[{"ref":"Ps.21.1","start":19021001,"end":19021001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせたダビデの歌","breaks":[[17,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"おう"],[9,1,"ちから"],[14,1,"よろこ"],[21,1,"たす"],[31,1,"おお"],[34,1,"よろこ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[20,1,"うた"]],"text":"主よ、王はあなたの力によって喜び、あなたの助けによって、いかに大きな喜びをもつことでしょう。"},{"ref":"Ps.21.2","start":19021002,"end":19021002,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"かれ"],[6,1,"こころ"],[8,1,"ねが"],[22,1,"もと"]],"text":"あなたは彼の心の願いをゆるし、そのくちびるの求めをいなまれなかった。〔セラ"},{"ref":"Ps.21.3","start":19021003,"end":19021003,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"おお"],[8,1,"めぐ"],[14,1,"かれ"],[16,1,"むか"],[25,2,"じゅんきん"],[28,1,"かんむり"]],"text":"あなたは大いなる恵みをもって彼を迎え、そのかしらに純金の冠をいただかせられる。"},{"ref":"Ps.21.4","start":19021004,"end":19021004,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かれ"],[6,1,"もと"],[18,1,"かれ"],[24,2,"よよ"],[26,1,"かぎ"],[36,1,"なが"]],"text":"彼がいのちを求めると、あなたはそれを彼にさずけ、世々限りなくそのよわいを長くされた。"},{"ref":"Ps.21.5","start":19021005,"end":19021005,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"たす"],[10,1,"かれ"],[12,2,"えいこう"],[15,1,"おお"],[23,1,"ほまれ"],[25,2,"いげん"],[29,1,"かれ"],[31,1,"あた"]],"text":"あなたの助けによって彼の栄光は大きい。あなたは誉と威厳とを彼に与えられる。"},{"ref":"Ps.21.6","start":19021006,"end":19021006,"break":"line","breaks":[[24,"line"]],"ruby":[[9,1,"かれ"],[16,1,"めぐ"],[20,1,"もの"],[25,1,"まえ"],[27,1,"よろこ"],[33,1,"たの"]],"text":"まことに、あなたは彼をとこしえに恵まれた者とし、み前に喜びをもって楽しませられる。"},{"ref":"Ps.21.7","start":19021007,"end":19021007,"break":"line","breaks":[[11,"line"],[29,"line"]],"ruby":[[0,1,"おう"],[2,1,"しゅ"],[4,2,"しんらい"],[13,1,"たか"],[15,1,"もの"],[29,1,"うご"]],"text":"王は主に信頼するゆえ、いと高き者のいつくしみをこうむって、動かされることはない。"},{"ref":"Ps.21.8","start":19021008,"end":19021008,"break":"line","breaks":[[18,"line"],[34,"line"]],"ruby":[[4,1,"て"],[11,1,"てき"],[13,1,"たず"],[15,1,"だ"],[22,1,"みぎ"],[24,1,"て"],[30,1,"にく"],[32,1,"もの"],[34,1,"たず"],[36,1,"だ"]],"text":"あなたの手はもろもろの敵を尋ね出し、あなたの右の手はあなたを憎む者を尋ね出すであろう。"},{"ref":"Ps.21.9","start":19021009,"end":19021009,"break":"line","breaks":[[8,"line"],[26,"line"],[46,"line"]],"ruby":[[4,1,"いか"],[6,1,"とき"],[8,1,"かれ"],[11,1,"も"],[14,1,"ろ"],[26,1,"しゅ"],[29,1,"いか"],[35,1,"かれ"],[46,1,"ひ"],[48,1,"かれ"],[51,1,"く"]],"text":"あなたが怒る時、彼らを燃える炉のようにするであろう。主はみ怒りによって彼らをのみつくされる。火は彼らを食いつくすであろう。"},{"ref":"Ps.21.10","start":19021010,"end":19021010,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"かれ"],[10,1,"ち"],[13,1,"た"],[16,1,"かれ"],[19,1,"たね"],[21,1,"ひと"],[23,1,"こ"],[26,1,"なか"],[29,1,"ほろ"]],"text":"あなたは彼らのすえを地から断ち、彼らの種を人の子らの中から滅ぼすであろう。"},{"ref":"Ps.21.11","start":19021011,"end":19021011,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[3,1,"かれ"],[14,1,"わる"],[16,1,"こと"],[18,1,"くわだ"],[21,1,"わる"],[29,1,"おも"],[40,1,"と"]],"text":"たとい彼らがあなたにむかって悪い事を企て、悪いはかりごとを思いめぐらしても、なし遂げることはできない。"},{"ref":"Ps.21.12","start":19021012,"end":19021012,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"かれ"],[7,1,"に"],[9,1,"はし"],[17,2,"ゆみづる"],[20,1,"は"],[24,1,"かれ"],[27,1,"かお"]],"text":"あなたは彼らを逃げ走らせ、あなたの弓弦を張って、彼らの顔をねらうであろう。"},{"ref":"Ps.21.13","start":19021013,"end":19021013,"break":"line","breaks":[[25,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"ちから"],[16,1,"たか"],[33,2,"たいのう"]],"text":"主よ、力をあらわして、みずからを高くしてください。われらはあなたの大能をうたい、かつほめたたえるでしょう。"}]