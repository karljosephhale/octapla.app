[{"ref":"Heb.9.1","start":58009001,"end":58009001,"break":"paragraph","ruby":[[3,1,"はじ"],[6,2,"けいやく"],[11,2,"れいはい"],[23,2,"きてい"],[27,2,"ちじょう"],[30,2,"せいじょ"]],"text":"さて、初めの契約にも、礼拝についてのさまざまな規定と、地上の聖所とがあった。"},{"ref":"Heb.9.2","start":58009002,"end":58009002,"break":"none","ruby":[[7,2,"まくや"],[10,1,"もう"],[17,1,"まえ"],[19,2,"ばしょ"],[23,2,"しょくだい"],[26,1,"つくえ"],[28,1,"そな"],[35,1,"お"],[46,2,"せいじょ"],[49,1,"よ"]],"text":"すなわち、まず幕屋が設けられ、その前の場所には燭台と机と供えのパンとが置かれていた。これが、聖所と呼ばれた。"},{"ref":"Heb.9.3","start":58009003,"end":58009003,"break":"none","ruby":[[2,1,"だい"],[5,1,"まく"],[7,1,"のち"],[10,1,"べつ"],[12,2,"ばしょ"],[21,3,"しせいじょ"],[25,1,"よ"]],"text":"また第二の幕の後に、別の場所があり、それは至聖所と呼ばれた。"},{"ref":"Heb.9.4","start":58009004,"end":58009004,"break":"none","ruby":[[4,1,"きん"],[6,1,"こう"],[7,1,"だん"],[9,2,"ぜんめん"],[11,1,"きん"],[18,2,"けいやく"],[21,1,"はこ"],[24,1,"お"],[30,1,"なか"],[42,1,"きん"],[48,1,"め"],[50,1,"だ"],[61,2,"けいやく"],[64,2,"いしいた"],[68,1,"い"]],"text":"そこには金の香壇と全面金でおおわれた契約の箱とが置かれ、その中にはマナのはいっている金のつぼと、芽を出したアロンのつえと、契約の石板とが入れてあり、"},{"ref":"Heb.9.5","start":58009005,"end":58009005,"break":"none","ruby":[[0,1,"はこ"],[2,1,"うえ"],[5,2,"えいこう"],[8,1,"かがや"],[19,3,"しょくざいしょ"],[42,1,"いま"],[51,1,"の"]],"text":"箱の上には栄光に輝くケルビムがあって、贖罪所をおおっていた。これらのことについては、今ここで、いちいち述べることができない。"},{"ref":"Heb.9.6","start":58009006,"end":58009006,"break":"none","ruby":[[8,2,"いじょう"],[14,1,"ととの"],[19,1,"うえ"],[22,2,"さいし"],[27,1,"つね"],[29,2,"まくや"],[32,1,"まえ"],[34,2,"ばしょ"],[41,2,"れいはい"]],"text":"これらのものが、以上のように整えられた上で、祭司たちは常に幕屋の前の場所にはいって礼拝をするのであるが、"},{"ref":"Heb.9.7","start":58009007,"end":58009007,"break":"none","ruby":[[0,2,"まくや"],[3,1,"おく"],[6,3,"だいさいし"],[10,1,"ねん"],[13,1,"ど"],[27,2,"じぶん"],[29,2,"じしん"],[32,1,"たみ"],[47,1,"ち"],[56,1,"ゆ"]],"text":"幕屋の奥には大祭司が年に一度だけはいるのであり、しかも自分自身と民とのあやまちのためにささげる血をたずさえないで行くことはない。"},{"ref":"Heb.9.8","start":58009008,"end":58009008,"break":"none","ruby":[[6,2,"せいれい"],[10,2,"ぜんぽう"],[13,2,"まくや"],[16,2,"そんざい"],[22,1,"かぎ"],[25,2,"せいじょ"],[31,1,"みち"],[35,1,"ひら"],[46,1,"あき"],[50,1,"しめ"]],"text":"それによって聖霊は、前方の幕屋が存在している限り、聖所にはいる道はまだ開かれていないことを、明らかに示している。"},{"ref":"Heb.9.9","start":58009009,"end":58009009,"break":"none","ruby":[[2,2,"まくや"],[9,1,"いま"],[11,2,"じだい"],[14,1,"たい"],[17,2,"ひゆ"],[28,1,"そな"],[30,1,"もの"],[45,2,"ぎしき"],[53,1,"もの"],[55,2,"りょうしん"],[58,1,"まっと"]],"text":"この幕屋というのは今の時代に対する比喩である。すなわち、供え物やいけにえはささげられるが、儀式にたずさわる者の良心を全うすることはできない。"},{"ref":"Heb.9.10","start":58009010,"end":58009010,"break":"none","ruby":[[7,2,"しょくもつ"],[10,1,"の"],[12,1,"もの"],[14,2,"しゅじゅ"],[17,1,"あら"],[22,1,"かん"],[25,2,"ぎょうじ"],[32,2,"かいかく"],[35,1,"とき"],[38,1,"か"],[45,1,"にく"],[47,2,"きてい"]],"text":"それらは、ただ食物と飲み物と種々の洗いごとに関する行事であって、改革の時まで課せられている肉の規定にすぎない。"},{"ref":"Heb.9.11","start":58009011,"end":58009011,"break":"paragraph","ruby":[[11,1,"あらわ"],[14,2,"しゅくふく"],[17,3,"だいさいし"],[30,1,"て"],[32,1,"つく"],[39,1,"よ"],[42,1,"ぞく"],[50,1,"おお"],[54,2,"かんぜん"],[57,2,"まくや"]],"text":"しかしキリストがすでに現れた祝福の大祭司としてこられたとき、手で造られず、この世界に属さない、さらに大きく、完全な幕屋をとおり、"},{"ref":"Heb.9.12","start":58009012,"end":58009012,"break":"none","ruby":[[6,1,"こ"],[7,1,"うし"],[10,1,"ち"],[17,2,"じしん"],[20,1,"ち"],[27,1,"ど"],[30,2,"せいじょ"],[44,2,"えいえん"],[52,1,"まっと"]],"text":"かつ、やぎと子牛との血によらず、ご自身の血によって、一度だけ聖所にはいられ、それによって永遠のあがないを全うされたのである。"},{"ref":"Heb.9.13","start":58009013,"end":58009013,"break":"none","ruby":[[6,1,"お"],[7,1,"うし"],[9,1,"ち"],[11,2,"めうし"],[14,1,"はい"],[17,1,"けが"],[20,1,"ひと"],[24,1,"うえ"],[34,2,"にくたい"],[40,1,"せい"],[41,1,"べつ"]],"text":"もし、やぎや雄牛の血や雌牛の灰が、汚れた人たちの上にまきかけられて、肉体をきよめ聖別するとすれば、"},{"ref":"Heb.9.14","start":58009014,"end":58009014,"break":"none","ruby":[[0,2,"えいえん"],[3,2,"せいれい"],[11,2,"じしん"],[14,1,"きず"],[17,1,"もの"],[21,1,"かみ"],[34,1,"ち"],[48,2,"りょうしん"],[55,1,"し"],[61,1,"と"],[63,1,"のぞ"],[66,1,"い"],[69,1,"かみ"],[71,1,"つか"],[74,1,"もの"]],"text":"永遠の聖霊によって、ご自身を傷なき者として神にささげられたキリストの血は、なおさら、わたしたちの良心をきよめて死んだわざを取り除き、生ける神に仕える者としないであろうか。"},{"ref":"Heb.9.15","start":58009015,"end":58009015,"break":"none","ruby":[[11,1,"あたら"],[14,2,"けいやく"],[17,3,"ちゅうほしゃ"],[30,1,"かれ"],[32,1,"はじ"],[35,2,"けいやく"],[41,1,"おか"],[44,2,"ざいか"],[54,1,"し"],[58,2,"けっか"],[61,1,"め"],[65,1,"もの"],[70,2,"やくそく"],[75,2,"えいえん"],[78,1,"くに"],[80,1,"う"],[82,1,"つ"]],"text":"それだから、キリストは新しい契約の仲保者なのである。それは、彼が初めの契約のもとで犯した罪過をあがなうために死なれた結果、召された者たちが、約束された永遠の国を受け継ぐためにほかならない。"},{"ref":"Heb.9.16","start":58009016,"end":58009016,"break":"paragraph","ruby":[[5,2,"ゆいごん"],[10,3,"ゆいごんしゃ"],[14,1,"し"],[16,2,"しょうめい"],[19,2,"ひつよう"]],"text":"いったい、遺言には、遺言者の死の証明が必要である。"},{"ref":"Heb.9.17","start":58009017,"end":58009017,"break":"none","ruby":[[0,2,"ゆいごん"],[3,1,"し"],[12,2,"こうりょく"],[15,1,"しょう"],[18,3,"ゆいごんしゃ"],[22,1,"い"],[27,1,"あいだ"],[30,2,"こうりょく"]],"text":"遺言は死によってのみその効力を生じ、遺言者が生きている間は、効力がない。"},{"ref":"Heb.9.18","start":58009018,"end":58009018,"break":"none","ruby":[[4,1,"はじ"],[7,2,"けいやく"],[11,1,"ち"],[13,1,"なが"],[20,2,"せいりつ"]],"text":"だから、初めの契約も、血を流すことなしに成立したのではない。"},{"ref":"Heb.9.19","start":58009019,"end":58009019,"break":"none","ruby":[[10,2,"りっぽう"],[13,1,"したが"],[20,1,"いまし"],[23,1,"たみ"],[24,2,"ぜんたい"],[27,2,"せんげん"],[34,1,"みず"],[36,2,"あかいろ"],[39,2,"ようもう"],[47,1,"ほか"],[50,1,"こ"],[51,1,"うし"],[57,1,"ち"],[59,1,"と"],[63,2,"けいやく"],[65,1,"しょ"],[67,1,"たみ"],[68,2,"ぜんたい"]],"text":"すなわち、モーセが、律法に従ってすべての戒めを民全体に宣言したとき、水と赤色の羊毛とヒソプとの外に、子牛とやぎとの血を取って、契約書と民全体とにふりかけ、"},{"ref":"Heb.9.20","start":58009020,"end":58009020,"break":"none","ruby":[[9,1,"かみ"],[17,1,"たい"],[20,1,"た"],[25,2,"けいやく"],[28,1,"ち"],[34,1,"い"]],"text":"そして、「これは、神があなたがたに対して立てられた契約の血である」と言った。"},{"ref":"Heb.9.21","start":58009021,"end":58009021,"break":"none","ruby":[[0,1,"かれ"],[5,2,"まくや"],[8,2,"ぎしき"],[10,1,"よう"],[12,2,"きぐ"],[21,2,"どうよう"],[24,1,"ち"]],"text":"彼はまた、幕屋と儀式用の器具いっさいにも、同様に血をふりかけた。"},{"ref":"Heb.9.22","start":58009022,"end":58009022,"break":"none","ruby":[[13,1,"もの"],[16,2,"りっぽう"],[19,1,"したが"],[22,1,"ち"],[38,1,"ち"],[40,1,"なが"],[49,1,"つみ"],[57,1,"え"]],"text":"こうして、ほとんどすべての物が、律法に従い、血によってきよめられたのである。血を流すことなしには、罪のゆるしはあり得ない。"},{"ref":"Heb.9.23","start":58009023,"end":58009023,"break":"paragraph","ruby":[[6,1,"てん"],[15,1,"がた"],[31,2,"ひつよう"],[38,1,"てん"],[51,1,"さら"]],"text":"このように、天にあるもののひな型は、これらのものできよめられる必要があるが、天にあるものは、これらより更にすぐれたいけにえで、きよめられねばならない。"},{"ref":"Heb.9.24","start":58009024,"end":58009024,"break":"none","ruby":[[19,2,"もけい"],[27,1,"て"],[29,1,"つく"],[32,2,"せいじょ"],[42,1,"うえ"],[45,1,"てん"],[51,1,"いま"],[62,1,"かみ"],[68,1,"で"],[70,1,"くだ"]],"text":"ところが、キリストは、ほんとうのものの模型にすぎない、手で造った聖所にはいらないで、上なる天にはいり、今やわたしたちのために神のみまえに出て下さったのである。"},{"ref":"Heb.9.25","start":58009025,"end":58009025,"break":"none","ruby":[[0,3,"だいさいし"],[5,1,"とし"],[10,2,"じぶん"],[12,2,"いがい"],[18,1,"ち"],[25,2,"せいじょ"],[50,2,"じしん"]],"text":"大祭司は、年ごとに、自分以外のものの血をたずさえて聖所にはいるが、キリストは、そのように、たびたびご自身をささげられるのではなかった。"},{"ref":"Heb.9.26","start":58009026,"end":58009026,"break":"none","ruby":[[10,1,"よ"],[12,1,"はじ"],[21,2,"くなん"],[24,1,"う"],[42,2,"じじつ"],[46,2,"じしん"],[60,1,"つみ"],[62,1,"と"],[64,1,"のぞ"],[70,1,"よ"],[72,1,"おわ"],[77,1,"ど"],[80,1,"あらわ"]],"text":"もしそうだとすれば、世の初めから、たびたび苦難を受けねばならなかったであろう。しかし事実、ご自身をいけにえとしてささげて罪を取り除くために、世の終りに、一度だけ現れたのである。"},{"ref":"Heb.9.27","start":58009027,"end":58009027,"break":"none","ruby":[[5,1,"ど"],[8,1,"し"],[14,1,"し"],[17,1,"のち"],[22,1,"う"],[30,2,"にんげん"],[33,1,"さだ"]],"text":"そして、一度だけ死ぬことと、死んだ後さばきを受けることとが、人間に定まっているように、"},{"ref":"Heb.9.28","start":58009028,"end":58009028,"break":"none","ruby":[[8,1,"おお"],[11,1,"ひと"],[13,1,"つみ"],[15,1,"お"],[22,1,"ど"],[26,2,"じしん"],[35,1,"のち"],[37,1,"かれ"],[39,1,"ま"],[41,1,"のぞ"],[46,2,"ひとびと"],[50,1,"つみ"],[52,1,"お"],[62,2,"どめ"],[65,1,"あらわ"],[69,1,"すくい"],[71,1,"あた"]],"text":"キリストもまた、多くの人の罪を負うために、一度だけご自身をささげられた後、彼を待ち望んでいる人々に、罪を負うためではなしに二度目に現れて、救を与えられるのである。"}]