[{"ref":"Isa.5.1","start":23005001,"end":23005001,"break":"paragraph","breaks":[[15,"line"],[37,"line"],[54,"line"]],"ruby":[[6,1,"あい"],[9,1,"もの"],[20,1,"はたけ"],[28,1,"あい"],[30,1,"うた"],[39,1,"あい"],[42,1,"もの"],[44,1,"つち"],[45,1,"こ"],[48,1,"こ"],[49,1,"やま"],[51,1,"うえ"],[60,1,"はたけ"]],"text":"わたしはわが愛する者のために、そのぶどう畑についてのわが愛の歌をうたおう。わが愛する者は土肥えた小山の上に、一つのぶどう畑をもっていた。"},{"ref":"Isa.5.2","start":23005002,"end":23005002,"break":"line","breaks":[[16,"line"],[28,"line"],[41,"line"],[54,"line"],[70,"line"]],"ruby":[[0,1,"かれ"],[5,1,"ほ"],[11,1,"いし"],[13,1,"のぞ"],[19,1,"よ"],[25,1,"う"],[30,1,"なか"],[32,2,"ものみ"],[38,1,"た"],[45,1,"なか"],[47,1,"さか"],[51,1,"ほ"],[54,1,"よ"],[60,1,"むす"],[64,1,"ま"],[66,1,"のぞ"],[74,1,"むす"],[80,1,"の"]],"text":"彼はそれを掘りおこし、石を除き、それに良いぶどうを植え、その中に物見やぐらを建て、またその中に酒ぶねを掘り、良いぶどうの結ぶのを待ち望んだ。ところが結んだものは野ぶどうであった。"},{"ref":"Isa.5.3","start":23005003,"end":23005003,"break":"paragraph","breaks":[[21,"line"]],"ruby":[[10,1,"す"],[12,1,"もの"],[17,2,"ひとびと"],[32,1,"はたけ"],[35,1,"あいだ"]],"text":"それで、エルサレムに住む者とユダの人々よ、どうか、わたしとぶどう畑との間をさばけ。"},{"ref":"Isa.5.4","start":23005004,"end":23005004,"break":"line","breaks":[[19,"line"],[32,"line"],[54,"line"]],"ruby":[[8,1,"はたけ"],[13,1,"こと"],[19,1,"なに"],[36,1,"よ"],[42,1,"むす"],[46,1,"ま"],[48,1,"のぞ"],[58,1,"の"],[63,1,"むす"]],"text":"わたしが、ぶどう畑になした事のほかに、何かなすべきことがあるか。わたしは良いぶどうの結ぶのを待ち望んだのに、どうして野ぶどうを結んだのか。"},{"ref":"Isa.5.5","start":23005005,"end":23005005,"break":"line","breaks":[[24,"line"],[34,"line"],[50,"line"],[73,"line"]],"ruby":[[12,1,"はたけ"],[30,1,"つ"],[44,1,"と"],[46,1,"さ"],[50,1,"く"],[52,1,"あら"],[73,1,"ふ"],[75,1,"あら"]],"text":"それで、わたしが、ぶどう畑になそうとすることを、あなたがたに告げる。わたしはそのまがきを取り去って、食い荒されるにまかせ、そのかきをとりこわして、踏み荒されるにまかせる。"},{"ref":"Isa.5.6","start":23005006,"end":23005006,"break":"line","breaks":[[11,"line"],[27,"line"],[42,"line"]],"ruby":[[7,1,"あら"],[11,1,"か"],[13,1,"こ"],[19,1,"たがや"],[37,1,"は"],[44,1,"くも"],[46,1,"めい"],[52,1,"うえ"],[54,1,"あめ"],[56,1,"ふ"]],"text":"わたしはこれを荒して、刈り込むことも、耕すこともせず、おどろと、いばらとを生えさせ、また雲に命じて、その上に雨を降らさない。"},{"ref":"Isa.5.7","start":23005007,"end":23005007,"break":"paragraph","breaks":[[21,"line"],[37,"line"],[46,"line"],[61,"line"],[67,"line"],[77,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[8,1,"はたけ"],[16,1,"いえ"],[21,1,"しゅ"],[23,1,"よろこ"],[29,1,"う"],[34,1,"もの"],[40,2,"ひとびと"],[46,1,"しゅ"],[51,2,"こうへい"],[54,1,"のぞ"],[61,1,"み"],[64,2,"りゅうけつ"],[67,2,"せいぎ"],[70,1,"のぞ"],[77,1,"み"],[80,1,"さけ"]],"text":"万軍の主のぶどう畑はイスラエルの家であり、主が喜んでそこに植えられた物は、ユダの人々である。主はこれに公平を望まれたのに、見よ、流血。正義を望まれたのに、見よ、叫び。"},{"ref":"Isa.5.8","start":23005008,"end":23005008,"break":"paragraph","breaks":[[21,"line"],[41,"line"]],"ruby":[[9,1,"かれ"],[12,1,"いえ"],[14,1,"いえ"],[16,1,"た"],[18,1,"つら"],[21,2,"たはた"],[24,2,"たはた"],[29,1,"くわ"],[33,2,"よち"],[41,2,"じぶん"],[47,1,"くに"],[52,1,"す"]],"text":"わざわいなるかな、彼らは家に家を建て連ね、田畑に田畑をまし加えて、余地をあまさず、自分ひとり、国のうちに住まおうとする。"},{"ref":"Isa.5.9","start":23005009,"end":23005009,"break":"line","breaks":[[19,"line"],[34,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[9,1,"みみ"],[11,1,"ちか"],[14,1,"い"],[20,1,"かなら"],[23,1,"おお"],[26,1,"いえ"],[28,1,"あ"],[34,1,"おお"],[37,1,"うるわ"],[40,1,"いえ"],[42,1,"す"],[44,1,"もの"]],"text":"万軍の主はわたしの耳に誓って言われた、「必ずや多くの家は荒れすたれ、大きな麗しい家も住む者がないようになる。"},{"ref":"Isa.5.10","start":23005010,"end":23005010,"break":"line","breaks":[[21,"line"]],"ruby":[[1,1,"たん"],[6,1,"はたけ"],[16,1,"み"],[18,1,"むす"],[26,1,"たね"],[36,1,"み"],[38,1,"むす"]],"text":"十反のぶどう畑もわずかに一バテの実を結び、一ホメルの種もわずかに一エパの実を結ぶ」。"},{"ref":"Isa.5.11","start":23005011,"end":23005011,"break":"paragraph","breaks":[[19,"line"],[28,"line"],[42,"line"]],"ruby":[[9,1,"かれ"],[12,1,"あさ"],[13,1,"はや"],[15,1,"お"],[19,1,"こ"],[21,1,"さけ"],[25,1,"もと"],[28,1,"よる"],[35,1,"の"],[42,1,"さけ"],[46,1,"み"],[48,1,"や"]],"text":"わざわいなるかな、彼らは朝早く起きて、濃き酒をおい求め、夜のふけるまで飲みつづけて、酒にその身を焼かれている。"},{"ref":"Isa.5.12","start":23005012,"end":23005012,"break":"line","breaks":[[16,"line"],[31,"line"],[47,"line"]],"ruby":[[0,1,"かれ"],[3,2,"しゅえん"],[7,1,"こと"],[11,2,"たてごと"],[16,1,"つづみ"],[19,1,"ふえ"],[26,1,"しゅ"],[34,1,"かれ"],[37,1,"しゅ"],[43,1,"かえり"],[48,1,"て"],[54,1,"こと"],[56,1,"め"]],"text":"彼らの酒宴には琴あり、立琴あり、鼓あり笛あり、ぶどう酒がある。しかし彼らは主のみわざを顧みず、み手のなされる事に目をとめない。"},{"ref":"Isa.5.13","start":23005013,"end":23005013,"break":"paragraph","breaks":[[24,"line"],[36,"line"]],"ruby":[[7,1,"たみ"],[9,2,"むち"],[26,1,"たっと"],[28,1,"もの"],[30,1,"う"],[33,1,"し"],[43,1,"たみ"],[53,1,"おとろ"]],"text":"それゆえ、わが民は無知のために、とりこにせられ、その尊き者は飢えて死に、そのもろもろの民は、かわきによって衰えはてる。"},{"ref":"Isa.5.14","start":23005014,"end":23005014,"break":"line","breaks":[[15,"line"],[26,"line"],[44,"line"],[67,"line"]],"ruby":[[2,2,"よみ"],[7,2,"よくぼう"],[10,1,"おお"],[17,1,"くち"],[19,1,"かぎ"],[23,1,"ひら"],[32,2,"きぞく"],[42,1,"たみ"],[46,2,"ぐんしゅう"],[56,1,"よろこ"],[63,1,"もの"],[69,1,"なか"],[71,1,"お"]],"text":"また陰府はその欲望を大きくし、その口を限りなく開き、エルサレムの貴族、そのもろもろの民、その群集およびそのうちの喜びたのしめる者はみなその中に落ちこむ。"},{"ref":"Isa.5.15","start":23005015,"end":23005015,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ひと"],[8,2,"ひとびと"],[11,1,"ひく"],[17,1,"たか"],[20,1,"もの"],[22,1,"め"],[24,1,"ひく"]],"text":"人はかがめられ、人々は低くせられ、高ぶる者の目は低くされる。"},{"ref":"Isa.5.16","start":23005016,"end":23005016,"break":"line","breaks":[[20,"line"],[32,"line"]],"ruby":[[3,2,"ばんぐん"],[6,1,"しゅ"],[8,2,"こうへい"],[20,1,"せい"],[23,1,"かみ"],[25,2,"せいぎ"],[36,1,"せい"],[39,1,"もの"],[43,1,"しめ"]],"text":"しかし万軍の主は公平によってあがめられ、聖なる神は正義によって、おのれを聖なる者として示される。"},{"ref":"Isa.5.17","start":23005017,"end":23005017,"break":"line","breaks":[[23,"line"]],"ruby":[[4,2,"こひつじ"],[7,2,"じぶん"],[10,2,"まきば"],[18,1,"くさ"],[23,1,"こ"],[26,2,"かちく"],[31,1,"こ"],[35,1,"あ"],[37,1,"あと"],[39,1,"なか"],[41,1,"しょく"],[43,1,"え"]],"text":"こうして小羊は自分の牧場におるように草をはみ、肥えた家畜および子やぎは荒れ跡の中で食を得る。"},{"ref":"Isa.5.18","start":23005018,"end":23005018,"break":"paragraph","breaks":[[9,"line"],[28,"line"]],"ruby":[[9,1,"かれ"],[12,1,"いつわ"],[21,1,"あく"],[23,1,"ひ"],[28,1,"くるま"],[30,1,"つな"],[40,1,"つみ"],[42,1,"ひ"]],"text":"わざわいなるかな、彼らは偽りのなわをもって悪を引きよせ、車の綱をもってするように罪を引きよせる。"},{"ref":"Isa.5.19","start":23005019,"end":23005019,"break":"line","breaks":[[13,"line"],[27,"line"],[38,"line"],[61,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[7,1,"かれ"],[9,1,"いそ"],[30,1,"み"],[44,2,"せいじゃ"],[47,1,"さだ"],[50,1,"こと"],[52,1,"ちか"],[64,1,"み"]],"text":"彼らは言う、「彼を急がせ、そのわざをすみやかにさせよ、それを見せてもらおう。イスラエルの聖者の定める事を近づききたらせよ、それを見せてもらおう」と。"},{"ref":"Isa.5.20","start":23005020,"end":23005020,"break":"line","breaks":[[22,"line"],[32,"line"],[46,"line"]],"ruby":[[9,1,"かれ"],[12,1,"あく"],[14,1,"よ"],[17,1,"ぜん"],[22,1,"ぜん"],[24,1,"よ"],[27,1,"あく"],[32,1,"くら"],[35,1,"ひかり"],[39,1,"ひかり"],[41,1,"くら"],[46,1,"にが"],[49,1,"あま"],[54,1,"あま"],[57,1,"にが"]],"text":"わざわいなるかな、彼らは悪を呼んで善といい、善を呼んで悪といい、暗きを光とし、光を暗しとし、苦きを甘しとし、甘きを苦しとする。"},{"ref":"Isa.5.21","start":23005021,"end":23005021,"break":"line","breaks":[[24,"line"]],"ruby":[[9,1,"かれ"],[16,1,"み"],[19,1,"かしこ"],[28,1,"かえり"]],"text":"わざわいなるかな、彼らはおのれを見て、賢しとし、みずから顧みて、さとしとする。"},{"ref":"Isa.5.22","start":23005022,"end":23005022,"break":"line","breaks":[[9,"line"],[28,"line"]],"ruby":[[9,1,"かれ"],[15,1,"しゅ"],[17,1,"の"],[22,2,"えいゆう"],[28,1,"こ"],[30,1,"さけ"],[34,1,"あ"],[41,2,"ゆうし"]],"text":"わざわいなるかな、彼らはぶどう酒を飲むことの英雄であり、濃き酒をまぜ合わせることの勇士である。"},{"ref":"Isa.5.23","start":23005023,"end":23005023,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[11,1,"あ"],[14,1,"もの"],[16,1,"ぎ"],[20,2,"ぎじん"],[26,1,"ぎ"],[28,1,"うば"]],"text":"彼らはまいないによって悪しき者を義とし、義人からその義を奪う。"},{"ref":"Isa.5.24","start":23005024,"end":23005024,"break":"line","breaks":[[21,"line"],[38,"line"],[52,"line"],[68,"line"],[82,"line"]],"ruby":[[5,1,"ひ"],[7,1,"した"],[9,1,"か"],[11,1,"かぶ"],[13,1,"く"],[15,1,"つく"],[21,1,"か"],[23,1,"くさ"],[25,1,"ほのお"],[27,1,"なか"],[29,1,"き"],[38,1,"かれ"],[41,1,"ね"],[43,1,"く"],[52,1,"かれ"],[55,1,"はな"],[63,1,"と"],[65,1,"さ"],[68,1,"かれ"],[71,2,"ばんぐん"],[74,1,"しゅ"],[76,2,"りっぽう"],[79,1,"す"],[88,2,"せいじゃ"],[91,2,"ことば"],[94,1,"あなど"]],"text":"それゆえ、火の舌が刈り株を食い尽すように、枯れ草が炎の中に消えうせるように、彼らの根は朽ちたものとなり、彼らの花はちりのように飛び去る。彼らは万軍の主の律法を捨て、イスラエルの聖者の言葉を侮ったからである。"},{"ref":"Isa.5.25","start":23005025,"end":23005025,"break":"line","breaks":[[21,"line"],[35,"line"],[42,"line"],[58,"line"],[69,"line"],[87,"line"]],"ruby":[[5,1,"しゅ"],[9,1,"たみ"],[15,1,"いか"],[18,1,"はっ"],[22,1,"て"],[24,1,"の"],[27,1,"かれ"],[30,1,"う"],[35,1,"やま"],[37,1,"ふる"],[39,1,"うご"],[42,1,"かれ"],[55,1,"なか"],[80,1,"いか"],[91,1,"て"],[93,1,"の"]],"text":"それゆえ、主はその民にむかって怒りを発し、み手を伸べて彼らを撃たれた。山は震い動き、彼らのしかばねは、ちまたの中で、あくたのようになった。それにもかかわらず、み怒りはやまず、なお、み手を伸ばされる。"},{"ref":"Isa.5.26","start":23005026,"end":23005026,"break":"paragraph","breaks":[[20,"line"],[33,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"はた"],[7,1,"とお"],[14,2,"くにたみ"],[17,1,"まね"],[20,1,"ち"],[22,1,"はて"],[25,1,"かれ"],[28,1,"よ"],[33,1,"み"],[36,1,"かれ"],[39,1,"はし"],[48,1,"く"]],"text":"主は旗をあげて遠くから一つの国民を招き、地の果から彼らを呼ばれる。見よ、彼らは走って、すみやかに来る。"},{"ref":"Isa.5.27","start":23005027,"end":23005027,"break":"line","breaks":[[20,"line"],[34,"line"],[44,"line"]],"ruby":[[2,1,"なか"],[5,1,"つか"],[8,1,"もの"],[15,1,"もの"],[24,1,"もの"],[27,1,"ねむ"],[29,1,"もの"],[36,1,"こし"],[38,1,"おび"],[52,1,"き"]],"text":"その中には疲れる者も、つまずく者もなく、まどろむ者も、眠る者もない。その腰の帯はとけず、そのくつのひもは切れていない。"},{"ref":"Isa.5.28","start":23005028,"end":23005028,"break":"line","breaks":[[19,"line"],[35,"line"]],"ruby":[[2,1,"や"],[4,1,"するど"],[9,1,"ゆみ"],[16,1,"は"],[21,1,"うま"],[27,3,"ひうちいし"],[37,1,"くるま"],[39,1,"わ"],[44,1,"かぜ"],[49,1,"おも"]],"text":"その矢は鋭く、その弓はことごとく張り、その馬のひずめは火打石のように、その車の輪はつむじ風のように思われる。"},{"ref":"Isa.5.29","start":23005029,"end":23005029,"break":"line","breaks":[[16,"line"],[27,"line"],[37,"line"]],"ruby":[[16,1,"わか"],[31,2,"えもの"],[34,1,"とら"],[40,1,"さ"],[44,1,"すく"],[46,1,"もの"]],"text":"そのほえることは、ししのように、若いししのようにほえ、うなって獲物を捕え、かすめ去っても救う者がない。"},{"ref":"Isa.5.30","start":23005030,"end":23005030,"break":"line","breaks":[[16,"line"],[28,"line"],[52,"line"]],"ruby":[[2,1,"ひ"],[6,1,"な"],[16,1,"うみ"],[18,1,"な"],[30,1,"ち"],[39,1,"み"],[42,1,"くら"],[45,1,"なや"],[52,1,"ひかり"],[54,1,"くも"],[59,1,"くら"]],"text":"その日、その鳴りどよめくことは、海の鳴りどよめくようだ。もし地をのぞむならば、見よ、暗きと悩みとがあり、光は雲によって暗くなる。"}]