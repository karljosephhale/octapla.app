[{"ref":"Jer.48.1","start":24048001,"end":24048001,"break":"paragraph","breaks":[[30,"stanza"],[52,"line"],[71,"line"]],"ruby":[[4,1,"こと"],[10,2,"ばんぐん"],[13,1,"しゅ"],[21,1,"かみ"],[25,1,"い"],[46,1,"ほろ"],[67,1,"と"]],"text":"モアブの事について、万軍の主、イスラエルの神はこう言われる、「ああ、ネボはわざわいだ、これは滅ぼされた。キリヤタイムははずかしめられて取られ、とりでは、はずかしめられてこわされた。"},{"ref":"Jer.48.2","start":24048002,"end":24048002,"break":"line","breaks":[[13,"line"],[30,"line"],[49,"line"],[67,"line"]],"ruby":[[4,1,"ほまれ"],[7,1,"き"],[9,1,"さ"],[18,2,"ひとびと"],[25,1,"がい"],[27,1,"はか"],[36,1,"くに"],[38,1,"た"],[40,1,"ほろ"],[61,1,"ほろ"],[75,1,"お"]],"text":"モアブの誉は、消え去った。ヘシボンで人々はモアブの害を図り、『さあ、この国を断ち滅ぼそう』という。マデメンよ、おまえもまた滅ぼされる、つるぎがおまえを追う。"},{"ref":"Jer.48.3","start":24048003,"end":24048003,"break":"stanza","breaks":[[15,"line"]],"ruby":[[7,1,"さけ"],[9,1,"ごえ"],[11,1,"きこ"],[16,2,"こうはい"],[19,1,"おお"],[23,2,"めつぼう"]],"text":"ホロナイムから叫び声が聞える、『荒廃と大いなる滅亡だ』という。"},{"ref":"Jer.48.4","start":24048004,"end":24048004,"break":"line","breaks":[[9,"line"]],"ruby":[[4,1,"ほろ"],[9,1,"さけ"],[18,1,"きこ"]],"text":"モアブは滅ぼされ、叫びはゾアルにまで聞える。"},{"ref":"Jer.48.5","start":24048005,"end":24048005,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[0,1,"かれ"],[3,1,"な"],[12,1,"さか"],[14,1,"のぼ"],[17,1,"かれ"],[26,1,"くだ"],[28,1,"ざか"],[32,2,"めつぼう"],[36,1,"さけ"],[39,1,"き"]],"text":"彼らは泣きながらルヒテの坂を登る。彼らはホロナイムの下り坂で、『滅亡』の叫びを聞いたからだ。"},{"ref":"Jer.48.6","start":24048006,"end":24048006,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"に"],[4,2,"じぶん"],[7,1,"み"],[9,1,"すく"],[12,2,"あらの"],[15,1,"の"]],"text":"逃げて、自分の身を救え、荒野の野ろばのようになれ。"},{"ref":"Jer.48.7","start":24048007,"end":24048007,"break":"line","breaks":[[21,"line"],[34,"line"],[55,"line"]],"ruby":[[9,2,"ざいほう"],[13,1,"たの"],[25,1,"とら"],[43,2,"さいし"],[52,1,"とも"],[55,1,"とら"],[60,1,"い"]],"text":"おまえが、とりでと財宝とを頼みにしたので、おまえも捕えられるからだ。またケモシは、その祭司とつかさたちと共に、捕えられて行く。"},{"ref":"Jer.48.8","start":24048008,"end":24048008,"break":"line","breaks":[[14,"line"],[31,"line"],[44,"line"]],"ruby":[[0,1,"ほろ"],[3,1,"もの"],[9,1,"まち"],[11,1,"く"],[17,1,"まち"],[31,1,"たに"],[33,1,"ほろ"],[36,2,"へいち"],[39,1,"あら"],[44,1,"しゅ"],[46,1,"い"]],"text":"滅ぼす者はすべての町に来る、一つの町ものがれることができない。谷は滅び、平地は荒される、主の言われたとおりである。"},{"ref":"Jer.48.9","start":24048009,"end":24048009,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"つばさ"],[6,1,"あた"],[10,1,"と"],[12,1,"さ"],[19,2,"まちまち"],[22,1,"あ"],[26,1,"す"],[28,1,"もの"]],"text":"モアブに翼を与えて、飛び去らせよ。その町々は荒れて、住む者はなくなる。"},{"ref":"Jer.48.10","start":24048010,"end":24048010,"break":"paragraph","ruby":[[0,1,"しゅ"],[5,1,"おこな"],[10,1,"おこた"],[12,1,"もの"],[28,1,"おさ"],[31,1,"ち"],[33,1,"なが"],[37,1,"もの"]],"text":"主のわざを行うことを怠る者はのろわれる。またそのつるぎを押えて血を流さない者はのろわれる。"},{"ref":"Jer.48.11","start":24048011,"end":24048011,"break":"paragraph","breaks":[[16,"line"],[33,"line"],[52,"line"],[64,"line"]],"ruby":[[6,1,"おさな"],[8,1,"とき"],[11,1,"やす"],[16,1,"さけ"],[19,1,"しず"],[25,1,"うえ"],[33,1,"うつわ"],[36,1,"うつわ"],[41,1,"うつ"],[52,1,"とら"],[54,1,"うつ"],[66,1,"あじ"],[70,1,"そん"],[75,2,"こうき"],[78,1,"かわ"]],"text":"モアブはその幼い時から安らかで、酒が、沈んだおりの上にとどまって、器から器に、くみ移されなかったように、捕え移されなかったので、その味はなお存し、その香気も変ることがない。"},{"ref":"Jer.48.12","start":24048012,"end":24048012,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"み"],[21,1,"かたむ"],[24,1,"もの"],[32,1,"ひ"],[34,1,"く"],[37,1,"かれ"],[43,1,"かたむ"],[48,1,"うつわ"],[58,1,"くだ"]],"text":"主は言われる、それゆえ見よ、わたしがこれを傾ける者どもをつかわす日が来る。彼らはこれを傾け、その器をあけ、そのかめを砕く。"},{"ref":"Jer.48.13","start":24048013,"end":24048013,"break":"none","ruby":[[2,1,"とき"],[14,1,"はじ"],[29,1,"いえ"],[33,1,"たの"],[45,1,"はじ"]],"text":"その時モアブはケモシのために恥をかく。ちょうどイスラエルの家がその頼みとしたベテルのために恥をかいたようになる。"},{"ref":"Jer.48.14","start":24048014,"end":24048014,"break":"paragraph","breaks":[[10,"line"]],"ruby":[[16,2,"ゆうし"],[20,1,"つよ"],[22,2,"せんし"]],"text":"あなたがたはどうして『われわれは勇士だ。強い戦士だ』というのか。"},{"ref":"Jer.48.15","start":24048015,"end":24048015,"break":"line","breaks":[[19,"line"],[41,"line"]],"ruby":[[6,2,"まちまち"],[9,1,"ほろ"],[12,1,"もの"],[14,1,"のぼ"],[17,1,"き"],[25,1,"ぬ"],[28,2,"わかもの"],[33,1,"くだ"],[36,1,"ころ"],[41,2,"ばんぐん"],[44,1,"しゅ"],[46,1,"な"],[49,1,"おう"],[51,1,"い"]],"text":"モアブとその町々を滅ぼす者は上って来、モアブのえり抜きの若者たちは下って殺されたと万軍の主と名のる王が言われる。"},{"ref":"Jer.48.16","start":24048016,"end":24048016,"break":"line","breaks":[[14,"line"]],"ruby":[[4,2,"さいなん"],[7,1,"ちか"],[16,2,"くなん"],[24,1,"く"]],"text":"モアブの災難は近づいている、その苦難はすみやかに来る。"},{"ref":"Jer.48.17","start":24048017,"end":24048017,"break":"line","breaks":[[13,"line"],[24,"line"],[33,"line"],[48,"line"]],"ruby":[[5,2,"しゅうい"],[10,1,"もの"],[17,1,"な"],[19,1,"し"],[21,1,"もの"],[24,1,"かれ"],[29,1,"なげ"],[37,1,"つよ"],[39,1,"しゃく"],[41,1,"うるわ"],[51,1,"お"],[56,1,"い"]],"text":"すべてその周囲にある者よ、またその名を知る者よ、彼のために嘆いて、『ああ、強き笏、麗しきつえは、ついに折れた』と言え。"},{"ref":"Jer.48.18","start":24048018,"end":24048018,"break":"stanza","breaks":[[33,"line"],[55,"line"]],"ruby":[[4,1,"す"],[6,1,"もの"],[14,1,"さか"],[17,1,"はな"],[20,1,"くだ"],[27,1,"ち"],[29,1,"ざ"],[37,1,"ほろ"],[40,1,"もの"],[46,1,"せ"],[52,1,"き"],[59,1,"しろ"],[61,1,"ほろ"]],"text":"デボンに住む者よ、ああなたの栄えを離れて下り、かわいた地に座せよ。モアブを滅ぼす者があなたに攻めのぼって来て、あなたの城を滅ぼしたからだ。"},{"ref":"Jer.48.19","start":24048019,"end":24048019,"break":"line","breaks":[[10,"line"],[25,"line"],[44,"line"]],"ruby":[[5,1,"す"],[7,1,"もの"],[10,1,"みち"],[17,1,"た"],[20,2,"みは"],[25,1,"に"],[30,1,"おとこ"],[38,1,"おんな"],[40,1,"たず"],[45,1,"なに"],[47,1,"おこ"],[54,1,"い"]],"text":"アロエルに住む者よ、道のかたわらに立って見張りし、逃げてくる男、のがれてくる女に尋ねて、『何が起ったのか』と言え。"},{"ref":"Jer.48.20","start":24048020,"end":24048020,"break":"line","breaks":[[18,"line"],[25,"line"],[36,"line"]],"ruby":[[4,1,"やぶ"],[8,1,"はじ"],[18,1,"なげ"],[20,1,"よ"],[29,1,"かわ"],[40,1,"ほろ"],[46,1,"つ"]],"text":"モアブは敗れて、恥をこうむっている。嘆き呼ばわれ。アルノン川のほとりで、モアブは滅ぼされたと告げよ。"},{"ref":"Jer.48.21","start":24048021,"end":24048021,"break":"paragraph","ruby":[[4,2,"こうげん"],[7,1,"ち"],[9,1,"のぞ"]],"text":"さばきは高原の地に臨み、ホロン、ヤハズ、メパアテ、"},{"ref":"Jer.48.22","start":24048022,"end":24048022,"break":"none","text":"デボン、ネボ、ベテ・デブラタイム、"},{"ref":"Jer.48.23","start":24048023,"end":24048023,"break":"none","text":"キリヤタイム、ベテ・ガムル、ベテ・メオン、"},{"ref":"Jer.48.24","start":24048024,"end":24048024,"break":"none","ruby":[[14,1,"ち"],[20,1,"まち"],[23,1,"とお"],[29,1,"ちか"],[36,1,"のぞ"]],"text":"ケリオテ、ボズラなどモアブの地のすべての町の、遠いものにも近いものにも、臨んだ。"},{"ref":"Jer.48.25","start":24048025,"end":24048025,"break":"none","ruby":[[4,1,"つの"],[6,1,"くだ"],[11,1,"うで"],[13,1,"お"],[17,1,"しゅ"],[19,1,"い"]],"text":"モアブの角は砕け、その腕は折れたと主は言われる。"},{"ref":"Jer.48.26","start":24048026,"end":24048026,"break":"paragraph","ruby":[[4,1,"よ"],[9,1,"かれ"],[11,1,"しゅ"],[13,1,"てき"],[16,1,"みずか"],[18,1,"たか"],[32,2,"じぶん"],[35,1,"は"],[38,1,"もの"],[40,1,"なか"],[48,1,"わら"],[50,1,"ぐさ"]],"text":"モアブを酔わせよ、彼が主に敵して自ら高ぶったからである。モアブは自分の吐いた物の中にころがって、笑い草となる。"},{"ref":"Jer.48.27","start":24048027,"end":24048027,"break":"none","ruby":[[10,1,"わら"],[12,1,"ぐさ"],[26,1,"かれ"],[31,1,"かた"],[36,1,"くび"],[38,1,"ふ"],[44,1,"かれ"],[46,2,"とうぞく"],[49,1,"なか"]],"text":"イスラエルはあなたの笑い草ではなかったか。あなたが、彼のことを語るごとに首を振ったのは、彼が盗賊の中にいたとでもいうのか。"},{"ref":"Jer.48.28","start":24048028,"end":24048028,"break":"paragraph","breaks":[[21,"line"],[35,"line"]],"ruby":[[4,1,"す"],[6,1,"もの"],[9,1,"まち"],[11,1,"さ"],[14,1,"いわ"],[16,1,"あいだ"],[18,1,"す"],[21,1,"たに"],[23,2,"いりぐち"],[31,1,"す"],[33,1,"つく"],[35,1,"やま"]],"text":"モアブに住む者よ、町を去って岩の間に住め。谷の入口のかたわらに巣を作る山ばとのようにせよ。"},{"ref":"Jer.48.29","start":24048029,"end":24048029,"break":"line","breaks":[[18,"line"],[31,"line"],[47,"line"]],"ruby":[[9,2,"こうまん"],[12,1,"こと"],[14,1,"き"],[20,2,"こうまん"],[38,2,"そんだい"],[41,2,"こうまん"],[44,2,"おうへい"],[52,1,"こころ"],[54,1,"たか"],[61,1,"き"]],"text":"われわれはモアブの高慢な事を聞いた、その高慢は、はなはだしい。すなわち、その尊大、高慢、横柄、およびその心の高ぶりのことを聞いた。"},{"ref":"Jer.48.30","start":24048030,"end":24048030,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"かれ"],[13,2,"おうちゃく"],[18,1,"し"],[21,1,"かれ"],[23,2,"じまん"],[26,1,"いつわ"],[32,1,"おこな"],[35,1,"いつわ"]],"text":"主は言われる、わたしは彼の横着なのを知る、彼の自慢は偽りで、その行いも偽りである。"},{"ref":"Jer.48.31","start":24048031,"end":24048031,"break":"line","breaks":[[19,"line"],[34,"line"]],"ruby":[[16,1,"なげ"],[23,1,"ぜん"],[24,1,"ち"],[29,1,"よ"],[40,2,"ひとびと"],[50,1,"かな"]],"text":"それゆえ、わたしはモアブのために嘆き、モアブの全地のために呼ばわる。キルヘレスの人々のためにわたしは悲しむ。"},{"ref":"Jer.48.32","start":24048032,"end":24048032,"break":"line","breaks":[[11,"line"],[30,"line"],[40,"line"],[63,"line"],[82,"line"]],"ruby":[[8,1,"き"],[22,1,"な"],[37,1,"な"],[47,1,"の"],[50,1,"うみ"],[52,1,"こ"],[59,1,"およ"],[67,1,"なつ"],[69,1,"み"],[74,2,"しゅうかく"],[77,1,"ほろ"],[80,1,"もの"],[82,1,"おそ"]],"text":"シブマのぶどうの木よ、わたしはヤゼルのために泣くのにまさっておまえのために泣く。おまえのつるは延びて海を越え、ヤゼルに及んだ。おまえの夏の実と、その収穫を滅ぼす者が襲ってきた。"},{"ref":"Jer.48.33","start":24048033,"end":24048033,"break":"line","breaks":[[22,"line"],[44,"line"],[67,"line"]],"ruby":[[0,1,"よろこ"],[3,1,"たの"],[8,1,"みの"],[10,1,"おお"],[16,1,"ち"],[18,1,"さ"],[34,1,"ところ"],[37,1,"さけ"],[44,1,"たの"],[47,1,"よ"],[57,1,"ふ"],[59,1,"もの"],[67,1,"よ"],[74,1,"よろこ"],[77,1,"よ"],[81,1,"こえ"]],"text":"喜びと楽しみは、実り多いモアブの地を去った。わたしは、ぶどうをしぼる所にも酒をなくした。楽しく呼ばわって、ぶどうを踏む者もなくなった。呼ばわっても、喜んで呼ばわる声ではない。"},{"ref":"Jer.48.34","start":24048034,"end":24048034,"break":"paragraph","ruby":[[10,1,"さけ"],[17,1,"いた"],[43,1,"いた"],[48,1,"かれ"],[53,1,"こえ"],[64,1,"みず"],[66,1,"た"]],"text":"ヘシボンとエレアレは叫ぶ。ヤハヅに至るまで、ゾアルからホロナイムとエグラテ・シリシヤに至るまで、彼らはその声をあげる。ニムリムの水も絶えたからである。"},{"ref":"Jer.48.35","start":24048035,"end":24048035,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[11,2,"ぎせい"],[14,1,"たか"],[16,1,"ところ"],[22,1,"こう"],[26,1,"かみ"],[30,1,"もの"],[39,1,"ほろ"]],"text":"主は言われる、わたしは犠牲を高き所にささげ、香をその神にたく者をモアブのうちに滅ぼす。"},{"ref":"Jer.48.36","start":24048036,"end":24048036,"break":"none","ruby":[[9,1,"こころ"],[18,1,"ふえ"],[23,1,"なげ"],[30,1,"こころ"],[38,2,"ひとびと"],[44,1,"ふえ"],[49,1,"なげ"],[52,1,"かれ"],[55,1,"え"],[57,1,"とみ"],[59,1,"き"]],"text":"それゆえ、わたしの心はモアブのために笛のように嘆き、わたしの心はキルヘレスの人々のために笛のように嘆く。彼らの獲た富が消えうせたからである。"},{"ref":"Jer.48.37","start":24048037,"end":24048037,"break":"paragraph","ruby":[[0,1,"ひと"],[4,1,"かみ"],[9,1,"みな"],[18,1,"て"],[20,1,"きず"],[25,1,"こし"],[27,2,"あらぬの"],[30,1,"つ"]],"text":"人はみな髪をそり、皆ひげをそり、みな手に傷をつけ、腰に荒布を着ける。"},{"ref":"Jer.48.38","start":24048038,"end":24048038,"break":"none","ruby":[[8,2,"やね"],[11,1,"うえ"],[14,2,"ひろば"],[20,1,"かな"],[24,1,"つつ"],[49,1,"うつわ"],[58,1,"くだ"],[67,1,"しゅ"],[69,1,"い"]],"text":"モアブではどこの屋根の上も、広場も、ただ悲しみに包まれている。これは、わたしが、だれもほしがらない器のようにモアブを砕いたからであると主は言われる。"},{"ref":"Jer.48.39","start":24048039,"end":24048039,"break":"none","ruby":[[10,1,"ほろ"],[14,2,"ひとびと"],[17,1,"なげ"],[27,1,"は"],[30,1,"かお"],[43,2,"しゅうい"],[50,1,"もの"],[52,1,"わら"],[54,1,"ぐさ"],[58,1,"おそ"]],"text":"ああ、モアブはついに滅びた。人々は嘆く。ああ、モアブは恥じて顔をそむけた。モアブはその周囲のすべての者の笑い草となり恐れとなった」。"},{"ref":"Jer.48.40","start":24048040,"end":24048040,"break":"stanza","breaks":[[9,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[10,1,"み"],[13,1,"てき"],[21,1,"はや"],[23,1,"と"],[33,1,"む"],[37,1,"つばさ"]],"text":"主はこう言われる、「見よ、敵はわしのように速く飛んできて、モアブに向かって翼をのべる。"},{"ref":"Jer.48.41","start":24048041,"end":24048041,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[0,2,"まちまち"],[3,1,"と"],[7,1,"しろ"],[9,1,"うば"],[16,1,"ひ"],[21,2,"ゆうし"],[24,1,"こころ"],[26,1,"こ"],[28,1,"う"],[30,1,"おんな"],[32,1,"こころ"]],"text":"町々は取られ、城は奪われる。その日モアブの勇士の心は子を産む女の心のようになる。"},{"ref":"Jer.48.42","start":24048042,"end":24048042,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"ほろ"],[10,1,"くに"],[12,1,"な"],[22,1,"しゅ"],[24,1,"てき"],[27,1,"みずか"],[29,1,"ほこ"]],"text":"モアブは滅ぼされて、国を成さないようになる。主に敵して自ら誇ったからである。"},{"ref":"Jer.48.43","start":24048043,"end":24048043,"break":"line","breaks":[[7,"line"],[16,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"す"],[13,1,"もの"],[16,1,"おそ"],[20,1,"あな"],[31,1,"のぞ"]],"text":"主は言われる、モアブに住む者よ、恐れと、穴と、わなとがあなたに臨んでいる。"},{"ref":"Jer.48.44","start":24048044,"end":24048044,"break":"line","breaks":[[18,"line"],[39,"line"],[58,"line"],[75,"line"]],"ruby":[[0,1,"おそ"],[6,1,"に"],[9,1,"もの"],[11,1,"あな"],[18,1,"あな"],[22,1,"のぼ"],[25,1,"で"],[27,1,"もの"],[33,1,"とら"],[50,1,"ばっ"],[55,1,"とし"],[65,1,"のぞ"],[75,1,"しゅ"],[77,1,"い"]],"text":"恐れをさけて逃げる者は穴におちいり、穴をよじ上って出る者は、わなに捕えられる。わたしがモアブに、その罰せられる年に、これらのものを臨ませるからであると主は言われる。"},{"ref":"Jer.48.45","start":24048045,"end":24048045,"break":"stanza","breaks":[[22,"line"],[44,"line"]],"ruby":[[0,1,"に"],[3,1,"もの"],[10,1,"かげ"],[13,1,"ちから"],[16,1,"た"],[28,1,"ひ"],[30,1,"で"],[36,1,"いえ"],[39,1,"ほのお"],[41,1,"で"],[48,1,"ひたい"],[50,1,"さわ"],[52,2,"ひとびと"],[55,1,"あたま"],[57,1,"いただき"],[59,1,"や"]],"text":"逃げた者はヘシボンの陰に、力なく立ちどまる。ヘシボンから火が出、シホンの家から炎が出て、モアブの額、騒ぐ人々の頭の頂を焼いたからだ。"},{"ref":"Jer.48.46","start":24048046,"end":24048046,"break":"line","breaks":[[15,"line"],[25,"line"],[40,"line"]],"ruby":[[19,1,"たみ"],[21,1,"ほろ"],[34,1,"とら"],[36,1,"うつ"],[44,1,"むすめ"],[47,1,"とら"],[49,1,"ゆ"]],"text":"モアブよ、おまえはわざわいだ。ケモシの民は滅びた。おまえのむすこらは捕え移され、おまえの娘らも捕え行かれたからである。"},{"ref":"Jer.48.47","start":24048047,"end":24048047,"break":"line","breaks":[[23,"line"],[31,"line"]],"ruby":[[3,1,"すえ"],[5,1,"ひ"],[11,1,"ふたた"],[17,1,"さか"],[23,1,"しゅ"],[25,1,"い"],[44,1,"こと"]],"text":"しかし末の日にわたしは再びモアブを栄えさせると主は言われる」。ここまではモアブのさばきの事をいったのである。"}]