[{"ref":"Lev.11.1","start":3011001,"end":3011001,"break":"paragraph","ruby":[[0,1,"しゅ"],[12,1,"い"]],"text":"主はまたモーセとアロンに言われた、"},{"ref":"Lev.11.2","start":3011002,"end":3011002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[17,1,"ち"],[25,1,"けもの"],[36,1,"た"],[45,2,"どうぶつ"],[48,1,"つぎ"]],"text":"「イスラエルの人々に言いなさい、『地にあるすべての獣のうち、あなたがたの食べることができる動物は次のとおりである。"},{"ref":"Lev.11.3","start":3011003,"end":3011003,"break":"none","ruby":[[0,1,"けもの"],[12,1,"わ"],[28,1,"まった"],[30,1,"き"],[36,2,"はんすう"],[47,1,"た"]],"text":"獣のうち、すべてひずめの分かれたもの、すなわち、ひずめの全く切れたもの、反芻するものは、これを食べることができる。"},{"ref":"Lev.11.4","start":3011004,"end":3011004,"break":"none","ruby":[[4,2,"はんすう"],[18,1,"わ"],[28,1,"つぎ"],[33,1,"た"],[55,2,"はんすう"],[68,1,"わ"],[85,1,"けが"]],"text":"ただし、反芻するもの、またはひずめの分かれたもののうち、次のものは食べてはならない。すなわち、らくだ、これは、反芻するけれども、ひずめが分かれていないから、あなたがたには汚れたものである。"},{"ref":"Lev.11.5","start":3011005,"end":3011005,"break":"none","ruby":[[0,1,"いわ"],[9,2,"はんすう"],[22,1,"わ"],[39,1,"けが"]],"text":"岩たぬき、これは、反芻するけれども、ひずめが分かれていないから、あなたがたには汚れたものである。"},{"ref":"Lev.11.6","start":3011006,"end":3011006,"break":"none","ruby":[[0,1,"の"],[9,2,"はんすう"],[22,1,"わ"],[39,1,"けが"]],"text":"野うさぎ、これは、反芻するけれども、ひずめが分かれていないから、あなたがたには汚れたものである。"},{"ref":"Lev.11.7","start":3011007,"end":3011007,"break":"none","ruby":[[0,1,"ぶた"],[10,1,"わ"],[21,1,"まった"],[23,1,"き"],[33,2,"はんすう"],[53,1,"けが"]],"text":"豚、これは、ひずめが分かれており、ひずめが全く切れているけれども、反芻することをしないから、あなたがたには汚れたものである。"},{"ref":"Lev.11.8","start":3011008,"end":3011008,"break":"none","ruby":[[14,1,"にく"],[16,1,"た"],[29,2,"したい"],[32,1,"ふ"],[53,1,"けが"]],"text":"あなたがたは、これらのものの肉を食べてはならない。またその死体に触れてはならない。これらは、あなたがたには汚れたものである。"},{"ref":"Lev.11.9","start":3011009,"end":3011009,"break":"paragraph","ruby":[[0,1,"みず"],[2,1,"なか"],[22,1,"た"],[34,1,"つぎ"],[48,1,"うみ"],[52,1,"かわ"],[59,1,"みず"],[61,1,"なか"],[86,1,"た"]],"text":"水の中にいるすべてのもののうち、あなたがたの食べることができるものは次のとおりである。すなわち、海でも、川でも、すべて水の中にいるもので、ひれと、うろこのあるものは、これを食べることができる。"},{"ref":"Lev.11.10","start":3011010,"end":3011010,"break":"none","ruby":[[3,1,"みず"],[5,1,"むら"],[17,1,"みず"],[19,1,"なか"],[23,1,"い"],[25,1,"もの"],[38,1,"うみ"],[42,1,"かわ"],[66,1,"い"]],"text":"すべて水に群がるもの、またすべての水の中にいる生き物のうち、すなわち、すべて海、また川にいて、ひれとうろこのないものは、あなたがたに忌むべきものである。"},{"ref":"Lev.11.11","start":3011011,"end":3011011,"break":"none","ruby":[[10,1,"い"],[30,1,"にく"],[32,1,"た"],[45,2,"したい"],[48,1,"い"]],"text":"これらはあなたがたに忌むべきものであるから、あなたがたはその肉を食べてはならない。またその死体は忌むべきものとしなければならない。"},{"ref":"Lev.11.12","start":3011012,"end":3011012,"break":"none","ruby":[[3,1,"みず"],[5,1,"なか"],[30,1,"い"]],"text":"すべて水の中にいて、ひれも、うろこもないものは、あなたがたに忌むべきものである。"},{"ref":"Lev.11.13","start":3011013,"end":3011013,"break":"paragraph","ruby":[[0,1,"とり"],[5,1,"つぎ"],[17,1,"い"],[27,1,"た"],[40,1,"い"]],"text":"鳥のうち、次のものは、あなたがたに忌むべきものとして、食べてはならない。それらは忌むべきものである。すなわち、はげわし、ひげはげわし、みさご、"},{"ref":"Lev.11.14","start":3011014,"end":3011014,"break":"none","ruby":[[8,1,"るい"]],"text":"とび、はやぶさの類、"},{"ref":"Lev.11.15","start":3011015,"end":3011015,"break":"none","ruby":[[9,1,"るい"]],"text":"もろもろのからすの類、"},{"ref":"Lev.11.16","start":3011016,"end":3011016,"break":"none","ruby":[[16,1,"るい"]],"text":"だちょう、よたか、かもめ、たかの類、"},{"ref":"Lev.11.17","start":3011017,"end":3011017,"break":"none","text":"ふくろう、う、みみずく、"},{"ref":"Lev.11.18","start":3011018,"end":3011018,"break":"none","text":"むらさきばん、ペリカン、はげたか、"},{"ref":"Lev.11.19","start":3011019,"end":3011019,"break":"none","ruby":[[9,1,"るい"]],"text":"こうのとり、さぎの類、やつがしら、こうもり。"},{"ref":"Lev.11.20","start":3011020,"end":3011020,"break":"paragraph","ruby":[[2,1,"はね"],[10,1,"あし"],[12,1,"ある"],[18,1,"は"],[30,1,"い"]],"text":"また羽があって四つの足で歩くすべての這うものは、あなたがたに忌むべきものである。"},{"ref":"Lev.11.21","start":3011021,"end":3011021,"break":"none","ruby":[[4,1,"はね"],[12,1,"あし"],[14,1,"ある"],[20,1,"は"],[30,1,"あし"],[36,1,"は"],[38,1,"あし"],[46,1,"ち"],[48,1,"うえ"],[56,1,"た"]],"text":"ただし、羽があって四つの足で歩くすべての這うもののうち、その足のうえに、跳ね足があり、それで地の上をはねるものは食べることができる。"},{"ref":"Lev.11.22","start":3011022,"end":3011022,"break":"none","ruby":[[9,1,"つぎ"],[14,1,"た"],[24,2,"いじゅう"],[30,1,"るい"],[32,2,"へんれき"],[38,1,"るい"],[40,1,"おお"],[45,1,"るい"],[47,1,"しょう"],[52,1,"るい"]],"text":"すなわち、そのうち次のものは食べることができる。移住いなごの類、遍歴いなごの類、大いなごの類、小いなごの類である。"},{"ref":"Lev.11.23","start":3011023,"end":3011023,"break":"none","ruby":[[4,1,"はね"],[12,1,"あし"],[14,1,"ある"],[26,1,"は"],[38,1,"い"]],"text":"しかし、羽があって四つの足で歩く、そのほかのすべての這うものは、あなたがたに忌むべきものである。"},{"ref":"Lev.11.24","start":3011024,"end":3011024,"break":"paragraph","ruby":[[6,1,"つぎ"],[8,2,"ばあい"],[11,1,"けが"],[35,2,"したい"],[38,1,"ふ"],[41,1,"もの"],[43,1,"ゆう"],[46,1,"けが"]],"text":"あなたがたは次の場合に汚れたものとなる。すなわち、すべてこれらのものの死体に触れる者は夕まで汚れる。"},{"ref":"Lev.11.25","start":3011025,"end":3011025,"break":"none","ruby":[[10,2,"したい"],[13,1,"はこ"],[15,1,"もの"],[20,2,"いふく"],[23,1,"あら"],[34,1,"かれ"],[36,1,"ゆう"],[39,1,"けが"]],"text":"すべてこれらのものの死体を運ぶ者は、その衣服を洗わなければならない。彼は夕まで汚れる。"},{"ref":"Lev.11.26","start":3011026,"end":3011026,"break":"none","ruby":[[8,1,"わ"],[12,1,"けもの"],[17,1,"き"],[19,1,"め"],[21,1,"き"],[33,2,"はんすう"],[53,1,"けが"],[69,1,"ふ"],[72,1,"もの"],[74,1,"けが"]],"text":"すべて、ひずめの分かれた獣で、その切れ目の切れていないもの、また、反芻することをしないものは、あなたがたに汚れたものである。すべて、これに触れる者は汚れる。"},{"ref":"Lev.11.27","start":3011027,"end":3011027,"break":"none","ruby":[[6,1,"あし"],[8,1,"ある"],[10,1,"けもの"],[17,1,"あし"],[19,1,"うら"],[26,1,"ある"],[31,1,"みな"],[38,1,"けが"],[52,2,"したい"],[55,1,"ふ"],[58,1,"もの"],[60,1,"ゆう"],[63,1,"けが"]],"text":"すべて四つの足で歩く獣のうち、その足の裏のふくらみで歩くものは皆あなたがたに汚れたものである。すべてその死体に触れる者は夕まで汚れる。"},{"ref":"Lev.11.28","start":3011028,"end":3011028,"break":"none","ruby":[[2,2,"したい"],[5,1,"はこ"],[7,1,"もの"],[12,2,"いふく"],[15,1,"あら"],[26,1,"かれ"],[28,1,"ゆう"],[31,1,"けが"],[45,1,"けが"]],"text":"その死体を運ぶ者は、その衣服を洗わなければならない。彼は夕まで汚れる。これは、あなたがたに汚れたものである。"},{"ref":"Lev.11.29","start":3011029,"end":3011029,"break":"paragraph","ruby":[[0,1,"ち"],[4,1,"は"],[12,1,"つぎ"],[23,1,"けが"],[52,1,"お"],[57,1,"るい"]],"text":"地にはう這うもののうち、次のものはあなたがたに汚れたものである。すなわち、もぐらねずみ、とびねずみ、とげ尾とかげの類、"},{"ref":"Lev.11.30","start":3011030,"end":3011030,"break":"none","ruby":[[4,1,"だい"]],"text":"やもり、大とかげ、とかげ、すなとかげ、カメレオン。"},{"ref":"Lev.11.31","start":3011031,"end":3011031,"break":"none","ruby":[[5,1,"は"],[23,1,"けが"],[42,1,"し"],[49,1,"ふ"],[52,1,"もの"],[54,1,"ゆう"],[57,1,"けが"]],"text":"もろもろの這うもののうち、これらはあなたがたに汚れたものである。すべてそれらのものが死んで、それに触れる者は夕まで汚れる。"},{"ref":"Lev.11.32","start":3011032,"end":3011032,"break":"none","ruby":[[9,1,"し"],[16,1,"お"],[22,1,"もの"],[27,1,"けが"],[31,1,"き"],[33,1,"うつわ"],[38,2,"いふく"],[44,1,"かわ"],[49,1,"ふくろ"],[57,2,"しごと"],[60,1,"つか"],[62,1,"うつわ"],[67,1,"みず"],[69,1,"い"],[83,1,"ゆう"],[86,1,"けが"],[97,1,"きよ"]],"text":"またそれらのものが死んで、それが落ちかかった物はすべて汚れる。木の器であれ、衣服であれ、皮であれ、袋であれ、およそ仕事に使う器はそれを水に入れなければならない。それは夕まで汚れているが、そののち清くなる。"},{"ref":"Lev.11.33","start":3011033,"end":3011033,"break":"none","ruby":[[10,1,"つち"],[12,1,"うつわ"],[14,1,"なか"],[16,1,"お"],[25,1,"なか"],[32,1,"みな"],[33,1,"けが"],[45,1,"うつわ"]],"text":"またそれらのものが、土の器の中に落ちたならば、その中にあるものは皆汚れる。あなたがたはその器をこわさなければならない。"},{"ref":"Lev.11.34","start":3011034,"end":3011034,"break":"none","ruby":[[7,1,"なか"],[11,2,"しょくもつ"],[15,2,"すいぶん"],[23,1,"けが"],[37,1,"うつわ"],[39,1,"なか"],[43,1,"の"],[45,1,"もの"],[47,1,"みな"],[48,1,"けが"]],"text":"またすべてその中にある食物で、水分のあるものは汚れる。またすべてそのような器の中にある飲み物も皆汚れる。"},{"ref":"Lev.11.35","start":3011035,"end":3011035,"break":"none","ruby":[[9,2,"したい"],[12,1,"お"],[24,1,"もの"],[29,1,"けが"],[33,2,"てんぴ"],[65,1,"けが"],[78,1,"けが"]],"text":"またそれらのものの死体が落ちかかったならば、その物はすべて汚れる。天火であれ、かまどであれ、それをこわさなければならない。これらは汚れたもので、あなたがたに汚れたものとなる。"},{"ref":"Lev.11.36","start":3011036,"end":3011036,"break":"none","ruby":[[4,1,"いずみ"],[10,1,"みず"],[12,1,"あつ"],[16,1,"みず"],[21,1,"けが"],[32,2,"したい"],[35,1,"ふ"],[38,1,"もの"],[40,1,"けが"]],"text":"ただし、泉、あるいは水の集まった水たまりは汚れない。しかし、その死体に触れる者は汚れる。"},{"ref":"Lev.11.37","start":3011037,"end":3011037,"break":"none","ruby":[[7,2,"したい"],[13,1,"たね"],[15,1,"うえ"],[17,1,"お"],[25,1,"けが"]],"text":"それらのものの死体が、まく種の上に落ちても、それは汚れない。"},{"ref":"Lev.11.38","start":3011038,"end":3011038,"break":"none","ruby":[[4,1,"たね"],[6,1,"うえ"],[8,1,"みず"],[19,1,"うえ"],[28,2,"したい"],[32,1,"お"],[48,1,"けが"]],"text":"ただし、種の上に水がかかっていて、その上にそれらのものの死体が、落ちるならば、それはあなたがたに汚れたものとなる。"},{"ref":"Lev.11.39","start":3011039,"end":3011039,"break":"paragraph","ruby":[[6,1,"た"],[9,1,"けもの"],[11,1,"し"],[14,1,"とき"],[18,2,"したい"],[21,1,"ふ"],[24,1,"もの"],[26,1,"ゆう"],[29,1,"けが"]],"text":"あなたがたの食べる獣が死んだ時、その死体に触れる者は夕まで汚れる。"},{"ref":"Lev.11.40","start":3011040,"end":3011040,"break":"none","ruby":[[2,2,"したい"],[5,1,"た"],[8,1,"もの"],[13,2,"いふく"],[16,1,"あら"],[27,1,"ゆう"],[30,1,"けが"],[36,2,"したい"],[39,1,"はこ"],[41,1,"もの"],[46,2,"いふく"],[49,1,"あら"],[60,1,"ゆう"],[63,1,"けが"]],"text":"その死体を食べる者は、その衣服を洗わなければならない。夕まで汚れる。その死体を運ぶ者も、その衣服を洗わなければならない。夕まで汚れる。"},{"ref":"Lev.11.41","start":3011041,"end":3011041,"break":"paragraph","ruby":[[3,1,"ち"],[7,1,"は"],[12,1,"い"],[25,1,"た"]],"text":"すべて地にはう這うものは忌むべきものである。これを食べてはならない。"},{"ref":"Lev.11.42","start":3011042,"end":3011042,"break":"none","ruby":[[3,1,"はら"],[6,1,"い"],[13,1,"あし"],[15,1,"ある"],[24,1,"おお"],[27,1,"あし"],[42,1,"ち"],[46,1,"は"],[61,1,"た"],[74,1,"い"]],"text":"すべて腹ばい行くもの、四つ足で歩くもの、あるいは多くの足をもつもの、すなわち、すべて地にはう這うものは、あなたがたはこれを食べてはならない。それらは忌むべきものだからである。"},{"ref":"Lev.11.43","start":3011043,"end":3011043,"break":"none","ruby":[[9,1,"は"],[24,1,"み"],[26,1,"い"],[50,1,"み"],[52,1,"けが"],[65,1,"けが"]],"text":"あなたがたはすべて這うものによって、あなたがたの身を忌むべきものとしてはならない。また、これをもって身を汚し、あるいはこれによって汚されてはならない。"},{"ref":"Lev.11.44","start":3011044,"end":3011044,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[29,2,"せいべつ"],[33,1,"せい"],[36,1,"もの"],[53,1,"せい"],[56,1,"もの"],[61,1,"ち"],[65,1,"は"],[80,1,"み"],[82,1,"けが"]],"text":"わたしはあなたがたの神、主であるから、あなたがたはおのれを聖別し、聖なる者とならなければならない。わたしは聖なる者である。地にはう這うものによって、あなたがたの身を汚してはならない。"},{"ref":"Lev.11.45","start":3011045,"end":3011045,"break":"none","ruby":[[10,1,"かみ"],[28,1,"くに"],[31,1,"みちび"],[33,1,"のぼ"],[36,1,"しゅ"],[45,1,"せい"],[48,1,"もの"],[61,1,"せい"],[64,1,"もの"]],"text":"わたしはあなたがたの神となるため、あなたがたをエジプトの国から導き上った主である。わたしは聖なる者であるから、あなたがたは聖なる者とならなければならない』」。"},{"ref":"Lev.11.46","start":3011046,"end":3011046,"break":"paragraph","ruby":[[3,1,"けもの"],[5,1,"とり"],[8,1,"みず"],[10,1,"なか"],[12,1,"うご"],[18,1,"い"],[20,1,"もの"],[23,1,"ち"],[25,1,"は"],[34,1,"かん"]],"text":"これは獣と鳥と、水の中に動くすべての生き物と、地に這うすべてのものに関するおきてであって、"},{"ref":"Lev.11.47","start":3011047,"end":3011047,"break":"none","ruby":[[0,1,"けが"],[6,1,"きよ"],[11,1,"た"],[16,1,"い"],[18,1,"もの"],[21,1,"た"],[27,1,"い"],[29,1,"もの"],[32,2,"くべつ"]],"text":"汚れたものと清いもの、食べられる生き物と、食べられない生き物とを区別するものである。"}]