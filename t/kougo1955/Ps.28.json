[{"ref":"Ps.28.1","start":19028001,"end":19028001,"break":"paragraph","title":"ダビデの歌","breaks":[[22,"line"],[35,"line"],[49,"line"],[71,"line"]],"ruby":[[0,1,"しゅ"],[15,1,"よ"],[24,1,"いわ"],[35,1,"みみ"],[55,1,"だま"],[75,1,"はか"],[77,1,"くだ"],[79,1,"もの"],[81,1,"ひと"]],"titleRuby":[[4,1,"うた"]],"text":"主よ、わたしはあなたにむかって呼ばわります。わが岩よ、わたしにむかって耳しいとならないでください。もしあなたが黙っておられるならば、おそらく、わたしは墓に下る者と等しくなるでしょう。"},{"ref":"Ps.28.2","start":19028002,"end":19028002,"break":"line","breaks":[[18,"line"],[38,"line"]],"ruby":[[12,1,"たす"],[15,1,"もと"],[22,3,"しせいじょ"],[30,1,"て"],[42,1,"ねが"],[45,1,"こえ"],[47,1,"き"]],"text":"わたしがあなたにむかって助けを求め、あなたの至聖所にむかって手をあげるとき、わたしの願いの声を聞いてください。"},{"ref":"Ps.28.3","start":19028003,"end":19028003,"break":"line","breaks":[[16,"line"],[32,"line"],[53,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[7,1,"あく"],[9,1,"おこな"],[11,1,"もの"],[14,1,"とも"],[20,1,"ひ"],[22,1,"ゆ"],[32,1,"かれ"],[37,1,"とな"],[39,1,"びと"],[46,1,"かた"],[55,1,"こころ"],[58,2,"がいあく"],[64,1,"もの"]],"text":"悪しき者および悪を行う者らと共にわたしを引き行かないでください。彼らはその隣り人とむつまじく語るけれども、その心には害悪をいだく者です。"},{"ref":"Ps.28.4","start":19028004,"end":19028004,"break":"line","breaks":[[14,"line"],[33,"line"],[51,"line"]],"ruby":[[16,1,"あ"],[19,1,"おこな"],[27,1,"かれ"],[30,1,"むく"],[35,1,"て"],[45,1,"かれ"],[48,1,"むく"],[53,1,"う"],[57,1,"ばつ"],[59,1,"かれ"],[62,1,"あた"]],"text":"どうぞ、そのわざにしたがい、その悪しき行いにしたがって彼らに報い、その手のわざにしたがって彼らに報い、その受くべき罰を彼らに与えてください。"},{"ref":"Ps.28.5","start":19028005,"end":19028005,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[0,1,"かれ"],[3,1,"しゅ"],[16,1,"て"],[22,1,"かえり"],[30,1,"しゅ"],[32,1,"かれ"],[35,1,"たお"],[39,1,"ふたた"],[41,1,"た"]],"text":"彼らは主のもろもろのみわざと、み手のわざとを顧みないゆえに、主は彼らを倒して、再び建てられることはない。"},{"ref":"Ps.28.6","start":19028006,"end":19028006,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"しゅ"],[15,1,"ねが"],[18,1,"こえ"],[20,1,"き"]],"text":"主はほむべきかな。主はわたしの願いの声を聞かれた。"},{"ref":"Ps.28.7","start":19028007,"end":19028007,"break":"line","breaks":[[10,"line"],[23,"line"],[47,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"ちから"],[8,1,"たて"],[14,1,"こころ"],[16,1,"しゅ"],[18,1,"よ"],[20,1,"たの"],[27,1,"たす"],[30,1,"え"],[39,1,"こころ"],[41,1,"おお"],[44,1,"よろこ"],[47,1,"うた"],[52,1,"しゅ"]],"text":"主はわが力、わが盾。わたしの心は主に寄り頼む。わたしは助けを得たので、わたしの心は大いに喜び、歌をもって主をほめたたえる。"},{"ref":"Ps.28.8","start":19028008,"end":19028008,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"たみ"],[6,1,"ちから"],[10,1,"あぶら"],[16,1,"もの"],[18,1,"すくい"]],"text":"主はその民の力、その油そそがれた者の救のとりでである。"},{"ref":"Ps.28.9","start":19028009,"end":19028009,"break":"line","breaks":[[23,"line"]],"ruby":[[8,1,"たみ"],[10,1,"すく"],[17,1,"し"],[18,1,"ぎょう"],[20,1,"めぐ"],[23,1,"かれ"],[26,2,"ぼくしゃ"],[38,1,"かれ"],[44,1,"みちび"]],"text":"どうぞ、あなたの民を救い、あなたの嗣業を恵み、彼らの牧者となって、とこしえに彼らをいだき導いてください。"}]