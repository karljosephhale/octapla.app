[{"ref":"Ps.56.1","start":19056001,"end":19056001,"break":"paragraph","title":"聖歌隊の指揮者によって、「遠き所におる音をたてぬはと」のしらべにあわせてうたわせたダビデのミクタムの歌。これはダビデがガテでペリシテびとに捕えられたときによんだもの","breaks":[[20,"line"],[32,"line"]],"ruby":[[0,1,"かみ"],[20,2,"ひとびと"],[27,1,"ふ"],[36,2,"ひとびと"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[13,1,"とお"],[15,1,"ところ"],[19,1,"おと"],[50,1,"うた"],[69,1,"とら"]],"text":"神よ、どうかわたしをあわれんでください。人々がわたしを踏みつけ、あだする人々がひねもすわたしをしえたげます。"},{"ref":"Ps.56.2","start":19056002,"end":19056002,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"てき"],[14,1,"ふ"],[19,1,"ほこ"],[31,1,"たたか"],[33,1,"もの"],[35,1,"おお"]],"text":"わたしの敵はひねもすわたしを踏みつけ、誇りたかぶって、わたしと戦う者が多いのです。"},{"ref":"Ps.56.3","start":19056003,"end":19056003,"break":"line","ruby":[[4,1,"おそ"],[15,1,"よ"],[17,1,"たの"]],"text":"わたしが恐れるときは、あなたに寄り頼みます。"},{"ref":"Ps.56.4","start":19056004,"end":19056004,"break":"line","breaks":[[24,"line"],[49,"line"]],"ruby":[[4,1,"かみ"],[13,2,"ことば"],[28,1,"かみ"],[30,2,"しんらい"],[37,1,"おそ"],[49,1,"にく"],[52,1,"もの"],[58,1,"なに"],[62,1,"え"]],"text":"わたしは神によって、そのみ言葉をほめたたえます。わたしは神に信頼するゆえ、恐れることはありません。肉なる者はわたしに何をなし得ましょうか。"},{"ref":"Ps.56.5","start":19056005,"end":19056005,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[11,1,"こと"],[13,2,"ぼうがい"],[19,1,"おも"]],"text":"彼らはひねもすわたしの事を妨害し、その思いはことごとくわたしにわざわいします。"},{"ref":"Ps.56.6","start":19056006,"end":19056006,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[0,1,"かれ"],[3,1,"とも"],[5,1,"あつ"],[9,1,"み"],[19,1,"あゆ"],[22,1,"め"],[39,1,"もと"]],"text":"彼らは共に集まって身をひそめ、わたしの歩みに目をとめ、わたしのいのちをうかがい求めます。"},{"ref":"Ps.56.7","start":19056007,"end":19056007,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かみ"],[3,1,"かれ"],[8,1,"つみ"],[10,1,"むく"],[13,1,"いきどお"],[24,1,"たみ"],[26,1,"たお"]],"text":"神よ、彼らにその罪を報い、憤りをもってもろもろの民を倒してください。"},{"ref":"Ps.56.8","start":19056008,"end":19056008,"break":"line","breaks":[[21,"line"],[44,"line"],[54,"line"]],"ruby":[[13,1,"かぞ"],[25,1,"なみだ"],[31,1,"かわ"],[32,1,"ぶくろ"],[47,1,"みな"],[52,1,"しょ"]],"text":"あなたはわたしのさすらいを数えられました。わたしの涙をあなたの皮袋にたくわえてください。これは皆あなたの書にしるされているではありませんか。"},{"ref":"Ps.56.9","start":19056009,"end":19056009,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"よ"],[6,1,"もと"],[9,1,"ひ"],[16,1,"てき"],[18,1,"しりぞ"],[29,1,"かみ"],[35,1,"まも"],[42,1,"し"]],"text":"わたしが呼び求める日に、わたしの敵は退きます。これによって神がわたしを守られることを知ります。"},{"ref":"Ps.56.10","start":19056010,"end":19056010,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"かみ"],[12,2,"ことば"],[21,1,"しゅ"],[29,2,"ことば"]],"text":"わたしは神によってそのみ言葉をほめたたえ、主によってそのみ言葉をほめたたえます。"},{"ref":"Ps.56.11","start":19056011,"end":19056011,"break":"line","breaks":[[25,"line"]],"ruby":[[4,1,"かみ"],[6,2,"しんらい"],[13,1,"おそ"],[25,1,"ひと"],[31,1,"なに"],[35,1,"え"]],"text":"わたしは神に信頼するゆえ、恐れることはありません。人はわたしに何をなし得ましょうか。"},{"ref":"Ps.56.12","start":19056012,"end":19056012,"break":"line","breaks":[[17,"line"],[29,"line"]],"ruby":[[0,1,"かみ"],[11,1,"た"],[14,1,"ちか"],[17,1,"はた"],[33,2,"かんしゃ"],[36,1,"そな"],[38,1,"もの"]],"text":"神よ、わたしがあなたに立てた誓いは果さなければなりません。わたしは感謝の供え物をあなたにささげます。"},{"ref":"Ps.56.13","start":19056013,"end":19056013,"break":"line","breaks":[[16,"line"],[33,"line"],[46,"line"]],"ruby":[[8,1,"たましい"],[10,1,"し"],[13,1,"すく"],[20,1,"あし"],[22,1,"まも"],[25,1,"たお"],[37,1,"ひかり"],[42,1,"かみ"],[44,1,"まえ"],[50,1,"あゆ"]],"text":"あなたはわたしの魂を死から救い、わたしの足を守って倒れることなく、いのちの光のうちで神の前にわたしを歩ませられたからです。"}]