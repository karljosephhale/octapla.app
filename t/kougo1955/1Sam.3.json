[{"ref":"1Sam.3.1","start":9003001,"end":9003001,"break":"paragraph","ruby":[[12,1,"まえ"],[15,1,"しゅ"],[17,1,"つか"],[28,1,"しゅ"],[30,2,"ことば"],[37,2,"もくし"],[40,1,"つね"]],"text":"わらべサムエルは、エリの前で、主に仕えていた。そのころ、主の言葉はまれで、黙示も常ではなかった。"},{"ref":"1Sam.3.2","start":9003002,"end":9003002,"break":"paragraph","ruby":[[10,1,"め"],[17,1,"み"],[33,2,"じぶん"],[39,1,"ね"]],"text":"さてエリは、しだいに目がかすんで、見ることができなくなり、そのとき自分のへやで寝ていた。"},{"ref":"1Sam.3.3","start":9003003,"end":9003003,"break":"none","ruby":[[0,1,"かみ"],[9,1,"き"],[18,1,"かみ"],[20,1,"はこ"],[24,1,"しゅ"],[26,2,"しんでん"],[29,1,"ね"],[33,1,"とき"]],"text":"神のともしびはまだ消えず、サムエルが神の箱のある主の神殿に寝ていた時、"},{"ref":"1Sam.3.4","start":9003004,"end":9003004,"break":"none","ruby":[[0,1,"しゅ"],[16,1,"よ"],[21,1,"かれ"],[36,1,"い"]],"text":"主は「サムエルよ、サムエルよ」と呼ばれた。彼は「はい、ここにおります」と言って、"},{"ref":"1Sam.3.5","start":9003005,"end":9003005,"break":"none","ruby":[[3,1,"ところ"],[5,1,"はし"],[11,1,"い"],[21,1,"およ"],[50,1,"い"],[59,1,"よ"],[64,1,"かえ"],[67,1,"ね"],[73,1,"かれ"],[75,1,"い"],[78,1,"ね"]],"text":"エリの所へ走っていって言った、「あなたがお呼びになりました。わたしは、ここにおります」。しかしエリは言った、「わたしは呼ばない。帰って寝なさい」。彼は行って寝た。"},{"ref":"1Sam.3.6","start":9003006,"end":9003006,"break":"none","ruby":[[0,1,"しゅ"],[22,1,"よ"],[32,1,"お"],[41,1,"い"],[44,1,"い"],[54,1,"およ"],[80,1,"い"],[85,1,"こ"],[92,1,"よ"],[100,1,"ど"],[101,1,"ね"]],"text":"主はまたかさねて「サムエルよ、サムエルよ」と呼ばれた。サムエルは起きてエリのもとへ行って言った、「あなたがお呼びになりました。わたしは、ここにおります」。エリは言った、「子よ、わたしは呼ばない。もう一度寝なさい」。"},{"ref":"1Sam.3.7","start":9003007,"end":9003007,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"し"],[13,1,"しゅ"],[15,2,"ことば"],[20,1,"かれ"],[22,1,"あらわ"]],"text":"サムエルはまだ主を知らず、主の言葉がまだ彼に現されなかった。"},{"ref":"1Sam.3.8","start":9003008,"end":9003008,"break":"none","ruby":[[0,1,"しゅ"],[5,2,"どめ"],[13,1,"よ"],[25,1,"お"],[34,1,"い"],[37,1,"い"],[47,1,"およ"],[72,1,"とき"],[77,1,"しゅ"],[83,1,"よ"],[94,1,"さと"]],"text":"主はまた三度目にサムエルを呼ばれたので、サムエルは起きてエリのもとへ行って言った、「あなたがお呼びになりました。わたしは、ここにおります」。その時、エリは主がわらべを呼ばれたのであることを悟った。"},{"ref":"1Sam.3.9","start":9003009,"end":9003009,"break":"none","ruby":[[11,1,"い"],[16,1,"い"],[19,1,"ね"],[30,1,"よ"],[41,1,"き"],[46,1,"しゅ"],[50,1,"はな"],[58,1,"い"],[70,1,"い"],[73,2,"じぶん"],[76,1,"ところ"],[78,1,"ね"]],"text":"そしてエリはサムエルに言った、「行って寝なさい。もしあなたを呼ばれたら、『しもべは聞きます。主よ、お話しください』と言いなさい」。サムエルは行って自分の所で寝た。"},{"ref":"1Sam.3.10","start":9003010,"end":9003010,"break":"paragraph","ruby":[[0,1,"しゅ"],[4,1,"た"],[7,1,"まえ"],[27,1,"よ"],[39,1,"い"],[48,1,"き"],[54,1,"はな"]],"text":"主はきて立ち、前のように、「サムエルよ、サムエルよ」と呼ばれたので、サムエルは言った、「しもべは聞きます。お話しください」。"},{"ref":"1Sam.3.11","start":9003011,"end":9003011,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[11,1,"い"],[17,1,"み"],[36,1,"こと"],[44,1,"き"],[46,1,"もの"],[51,1,"みみ"],[57,1,"な"]],"text":"その時、主はサムエルに言われた、「見よ、わたしはイスラエルのうちに一つの事をする。それを聞く者はみな、耳が二つとも鳴るであろう。"},{"ref":"1Sam.3.12","start":9003012,"end":9003012,"break":"none","ruby":[[2,1,"ひ"],[17,1,"いえ"],[22,1,"はな"],[34,1,"おわ"],[47,1,"おこな"]],"text":"その日には、わたしが、かつてエリの家について話したことを、はじめから終りまでことごとく、エリに行うであろう。"},{"ref":"1Sam.3.13","start":9003013,"end":9003013,"break":"none","ruby":[[8,1,"かれ"],[10,1,"し"],[15,2,"あくじ"],[24,1,"いえ"],[26,2,"えいきゅう"],[29,1,"ばっ"],[35,1,"つ"],[41,1,"こ"],[44,1,"かみ"],[55,1,"かれ"]],"text":"わたしはエリに、彼が知っている悪事のゆえに、その家を永久に罰することを告げる。その子らが神をけがしているのに、彼がそれをとめなかったからである。"},{"ref":"1Sam.3.14","start":9003014,"end":9003014,"break":"none","ruby":[[12,1,"いえ"],[14,1,"ちか"],[20,1,"いえ"],[22,1,"あく"],[25,2,"ぎせい"],[28,1,"そな"],[30,1,"もの"],[39,2,"えいきゅう"]],"text":"それゆえ、わたしはエリの家に誓う。エリの家の悪は、犠牲や供え物をもってしても、永久にあがなわれないであろう」。"},{"ref":"1Sam.3.15","start":9003015,"end":9003015,"break":"paragraph","ruby":[[5,1,"あさ"],[8,1,"ね"],[11,1,"しゅ"],[13,1,"みや"],[15,1,"と"],[29,1,"まぼろし"],[37,1,"かた"],[41,1,"おそ"]],"text":"サムエルは朝まで寝て、主の宮の戸をあけたが、サムエルはその幻のことをエリに語るのを恐れた。"},{"ref":"1Sam.3.16","start":9003016,"end":9003016,"break":"none","ruby":[[11,1,"よ"],[14,1,"い"],[21,1,"こ"],[34,1,"い"]],"text":"しかしエリはサムエルを呼んで言った、「わが子サムエルよ」。サムエルは言った、「はい、ここにおります」。"},{"ref":"1Sam.3.17","start":9003017,"end":9003017,"break":"none","ruby":[[3,1,"い"],[8,2,"なにごと"],[12,1,"つ"],[21,1,"かく"],[24,1,"はな"],[35,1,"つ"],[48,1,"かく"],[56,1,"い"],[67,1,"かみ"],[73,1,"ばっ"],[79,1,"おも"],[81,1,"ばっ"]],"text":"エリは言った、「何事をお告げになったのか。隠さず話してください。もしお告げになったことを一つでも隠して、わたしに言わないならば、どうぞ神があなたを罰し、さらに重く罰せられるように」。"},{"ref":"1Sam.3.18","start":9003018,"end":9003018,"break":"none","ruby":[[11,1,"こと"],[18,1,"はな"],[22,1,"なに"],[24,1,"かれ"],[26,1,"かく"],[36,1,"い"],[44,1,"しゅ"],[52,1,"しゅ"],[55,1,"よ"],[58,1,"おも"],[63,1,"おこな"]],"text":"そこでサムエルは、その事をことごとく話して、何も彼に隠さなかった。エリは言った、「それは主である。どうぞ主が、良いと思うことを行われるように」。"},{"ref":"1Sam.3.19","start":9003019,"end":9003019,"break":"paragraph","ruby":[[5,1,"そだ"],[12,1,"しゅ"],[14,1,"かれ"],[16,1,"とも"],[25,2,"ことば"],[31,1,"ち"],[33,1,"お"]],"text":"サムエルは育っていった。主が彼と共におられて、その言葉を一つも地に落ちないようにされたので、"},{"ref":"1Sam.3.20","start":9003020,"end":9003020,"break":"none","ruby":[[22,1,"ひと"],[30,1,"しゅ"],[32,3,"よげんしゃ"],[36,1,"さだ"],[44,1,"し"]],"text":"ダンからベエルシバまで、イスラエルのすべての人は、サムエルが主の預言者と定められたことを知った。"},{"ref":"1Sam.3.21","start":9003021,"end":9003021,"break":"none","ruby":[[0,1,"しゅ"],[9,1,"あらわ"],[19,1,"しゅ"],[25,1,"しゅ"],[27,2,"ことば"],[39,1,"みずか"],[42,1,"あらわ"],[56,2,"ことば"],[70,2,"ひとびと"],[73,1,"およ"]],"text":"主はふたたびシロで現れられた。すなわち主はシロで、主の言葉によって、サムエルに自らを現された。こうしてサムエルの言葉は、あまねくイスラエルの人々に及んだ。"}]