[{"ref":"Acts.19.1","start":44019001,"end":44019001,"break":"paragraph","ruby":[[11,1,"とき"],[17,2,"おくち"],[37,2,"でし"],[42,2,"であ"]],"text":"アポロがコリントにいた時、パウロは奥地をとおってエペソにきた。そして、ある弟子たちに出会って、"},{"ref":"Acts.19.2","start":44019002,"end":44019002,"break":"none","ruby":[[0,1,"かれ"],[11,2,"しんこう"],[18,1,"とき"],[21,2,"せいれい"],[24,1,"う"],[31,1,"たず"],[43,2,"せいれい"],[57,1,"き"],[70,1,"こた"]],"text":"彼らに「あなたがたは、信仰にはいった時に、聖霊を受けたのか」と尋ねたところ、「いいえ、聖霊なるものがあることさえ、聞いたことがありません」と答えた。"},{"ref":"Acts.19.3","start":44019003,"end":44019003,"break":"none","ruby":[[7,1,"な"],[18,1,"う"],[25,1,"かれ"],[31,1,"かれ"],[39,1,"な"],[49,1,"う"],[56,1,"こた"]],"text":"「では、だれの名によってバプテスマを受けたのか」と彼がきくと、彼らは「ヨハネの名によるバプテスマを受けました」と答えた。"},{"ref":"Acts.19.4","start":44019004,"end":44019004,"break":"none","ruby":[[8,1,"い"],[17,2,"くいあらた"],[27,1,"さづ"],[39,2,"じぶん"],[45,1,"く"],[59,1,"しん"],[66,2,"ひとびと"],[69,1,"すす"]],"text":"そこで、パウロが言った、「ヨハネは悔改めのバプテスマを授けたが、それによって、自分のあとに来るかた、すなわち、イエスを信じるように、人々に勧めたのである」。"},{"ref":"Acts.19.5","start":44019005,"end":44019005,"break":"none","ruby":[[0,2,"ひとびと"],[6,1,"き"],[10,1,"しゅ"],[15,1,"な"],[25,1,"う"]],"text":"人々はこれを聞いて、主イエスの名によるバプテスマを受けた。"},{"ref":"Acts.19.6","start":44019006,"end":44019006,"break":"none","ruby":[[8,1,"かれ"],[11,1,"うえ"],[13,1,"て"],[19,2,"せいれい"],[22,1,"かれ"],[33,1,"かれ"],[36,2,"いげん"],[39,1,"かた"],[44,2,"よげん"],[51,1,"だ"]],"text":"そして、パウロが彼らの上に手をおくと、聖霊が彼らにくだり、それから彼らは異言を語ったり、預言をしたりし出した。"},{"ref":"Acts.19.7","start":44019007,"end":44019007,"break":"none","ruby":[[2,1,"ひと"],[12,1,"にん"]],"text":"その人たちはみんなで十二人ほどであった。"},{"ref":"Acts.19.8","start":44019008,"end":44019008,"break":"paragraph","ruby":[[9,2,"かいどう"],[19,1,"げつ"],[25,2,"だいたん"],[28,1,"かみ"],[30,1,"くに"],[35,1,"ろん"],[40,1,"すす"]],"text":"それから、パウロは会堂にはいって、三か月のあいだ、大胆に神の国について論じ、また勧めをした。"},{"ref":"Acts.19.9","start":44019009,"end":44019009,"break":"none","ruby":[[7,1,"ひと"],[11,1,"こころ"],[21,1,"しん"],[29,2,"かいしゅう"],[32,1,"まえ"],[36,1,"みち"],[43,1,"い"],[49,1,"かれ"],[51,2,"でし"],[56,1,"ひ"],[58,1,"つ"],[64,1,"ひと"],[69,1,"はな"],[76,2,"こうどう"],[79,2,"まいにち"],[81,1,"ろん"]],"text":"ところが、ある人たちは心をかたくなにして、信じようとせず、会衆の前でこの道をあしざまに言ったので、彼は弟子たちを引き連れて、その人たちから離れ、ツラノの講堂で毎日論じた。"},{"ref":"Acts.19.10","start":44019010,"end":44019010,"break":"none","ruby":[[4,2,"ねんかん"],[7,1,"つづ"],[17,1,"す"],[22,1,"もの"],[28,1,"じん"],[34,1,"じん"],[36,1,"みな"],[38,1,"しゅ"],[40,1,"ことば"],[42,1,"き"]],"text":"それが二年間も続いたので、アジヤに住んでいる者は、ユダヤ人もギリシヤ人も皆、主の言を聞いた。"},{"ref":"Acts.19.11","start":44019011,"end":44019011,"break":"paragraph","ruby":[[0,1,"かみ"],[7,1,"て"],[13,2,"いじょう"],[16,1,"ちから"],[22,2,"つぎつぎ"]],"text":"神は、パウロの手によって、異常な力あるわざを次々になされた。"},{"ref":"Acts.19.12","start":44019012,"end":44019012,"break":"none","ruby":[[5,2,"ひとびと"],[9,1,"かれ"],[11,1,"み"],[18,1,"て"],[23,2,"まえか"],[27,1,"と"],[30,2,"びょうにん"],[40,2,"びょうき"],[43,1,"のぞ"],[47,2,"あくれい"],[50,1,"で"],[52,1,"い"]],"text":"たとえば、人々が、彼の身につけている手ぬぐいや前掛けを取って病人にあてると、その病気が除かれ、悪霊が出て行くのであった。"},{"ref":"Acts.19.13","start":44019013,"end":44019013,"break":"none","ruby":[[7,1,"じん"],[13,1,"し"],[16,2,"へんれき"],[22,1,"もの"],[27,2,"あくれい"],[36,1,"もの"],[43,1,"しゅ"],[48,1,"な"],[59,1,"の"],[61,1,"つた"],[73,1,"めい"],[77,1,"で"],[79,1,"い"],[88,1,"い"]],"text":"そこで、ユダヤ人のまじない師で、遍歴している者たちが、悪霊につかれている者にむかって、主イエスの名をとなえ、「パウロの宣べ伝えているイエスによって命じる。出て行け」と、ためしに言ってみた。"},{"ref":"Acts.19.14","start":44019014,"end":44019014,"break":"none","ruby":[[4,3,"さいしちょう"],[13,1,"もの"],[16,1,"にん"]],"text":"ユダヤの祭司長スケワという者の七人のむすこたちも、そんなことをしていた。"},{"ref":"Acts.19.15","start":44019015,"end":44019015,"break":"none","ruby":[[3,2,"あくれい"],[9,1,"たい"],[12,1,"い"],[22,2,"じぶん"],[25,1,"し"],[56,2,"なにもの"]],"text":"すると悪霊がこれに対して言った、「イエスなら自分は知っている。パウロもわかっている。だが、おまえたちは、いったい何者だ」。"},{"ref":"Acts.19.16","start":44019016,"end":44019016,"break":"none","ruby":[[4,2,"あくれい"],[13,1,"ひと"],[16,1,"かれ"],[19,1,"と"],[29,1,"おさ"],[34,1,"ま"],[41,1,"かれ"],[44,1,"きず"],[46,1,"お"],[51,1,"はだか"],[59,1,"いえ"],[61,1,"に"],[63,1,"だ"]],"text":"そして、悪霊につかれている人が、彼らに飛びかかり、みんなを押えつけて負かしたので、彼らは傷を負ったまま裸になって、その家を逃げ出した。"},{"ref":"Acts.19.17","start":44019017,"end":44019017,"break":"none","ruby":[[9,1,"す"],[18,1,"じん"],[24,1,"じん"],[26,1,"し"],[36,2,"きょうふ"],[39,1,"おそ"],[47,1,"しゅ"],[52,1,"な"]],"text":"このことがエペソに住むすべてのユダヤ人やギリシヤ人に知れわたって、みんな恐怖に襲われ、そして、主イエスの名があがめられた。"},{"ref":"Acts.19.18","start":44019018,"end":44019018,"break":"none","ruby":[[2,2,"しんじゃ"],[8,1,"もの"],[10,1,"おお"],[16,2,"じぶん"],[19,2,"こうい"],[22,1,"う"],[27,2,"こくはく"]],"text":"また信者になった者が大ぜいきて、自分の行為を打ちあけて告白した。"},{"ref":"Acts.19.19","start":44019019,"end":44019019,"break":"none","ruby":[[5,2,"まじゅつ"],[8,1,"おこな"],[13,1,"おお"],[16,1,"もの"],[19,2,"まじゅつ"],[22,1,"ほん"],[24,1,"も"],[26,1,"だ"],[37,1,"まえ"],[39,1,"や"],[41,1,"す"],[47,2,"ねだん"],[50,2,"そうけい"],[58,1,"ぎん"],[63,1,"のぼ"]],"text":"それから、魔術を行っていた多くの者が、魔術の本を持ち出してきては、みんなの前で焼き捨てた。その値段を総計したところ、銀五万にも上ることがわかった。"},{"ref":"Acts.19.20","start":44019020,"end":44019020,"break":"none","ruby":[[8,1,"しゅ"],[10,1,"ことば"],[16,1,"さか"],[26,1,"ちから"],[28,1,"ま"],[30,1,"くわ"]],"text":"このようにして、主の言はますます盛んにひろまり、また力を増し加えていった。"},{"ref":"Acts.19.21","start":44019021,"end":44019021,"break":"paragraph","ruby":[[4,1,"こと"],[9,1,"のち"],[15,2,"みたま"],[18,1,"かん"],[43,1,"い"],[45,2,"けっしん"],[54,1,"い"],[67,1,"い"],[80,1,"み"]],"text":"これらの事があった後、パウロは御霊に感じて、マケドニヤ、アカヤをとおって、エルサレムへ行く決心をした。そして言った、「わたしは、そこに行ったのち、ぜひローマをも見なければならない」。"},{"ref":"Acts.19.22","start":44019022,"end":44019022,"break":"none","ruby":[[4,2,"じぶん"],[7,1,"つか"],[12,1,"もの"],[14,1,"なか"],[41,1,"おく"],[43,1,"だ"],[49,2,"じしん"]],"text":"そこで、自分に仕えている者の中から、テモテとエラストとのふたりを、まずマケドニヤに送り出し、パウロ自身は、なおしばらくアジヤにとどまった。"},{"ref":"Acts.19.23","start":44019023,"end":44019023,"break":"paragraph","ruby":[[7,1,"みち"],[12,2,"ようい"],[17,2,"そうどう"],[20,1,"おこ"]],"text":"そのころ、この道について容易ならぬ騒動が起った。"},{"ref":"Acts.19.24","start":44019024,"end":44019024,"break":"none","ruby":[[22,4,"ぎんざいくにん"],[28,1,"ぎん"],[35,2,"しんでん"],[38,2,"もけい"],[41,1,"つく"],[45,2,"しょくにん"],[50,1,"すく"],[55,2,"りえき"],[58,1,"え"]],"text":"そのいきさつは、こうである。デメテリオという銀細工人が、銀でアルテミス神殿の模型を造って、職人たちに少なからぬ利益を得させていた。"},{"ref":"Acts.19.25","start":44019025,"end":44019025,"break":"none","ruby":[[2,1,"おとこ"],[6,2,"しょくにん"],[12,2,"どうるい"],[15,2,"しごと"],[22,1,"もの"],[26,1,"あつ"],[29,1,"い"],[34,2,"しょくん"],[44,2,"しごと"],[48,1,"かね"],[62,2,"しょうち"]],"text":"この男がその職人たちや、同類の仕事をしていた者たちを集めて言った、「諸君、われわれがこの仕事で、金もうけをしていることは、ご承知のとおりだ。"},{"ref":"Acts.19.26","start":44019026,"end":44019026,"break":"none","ruby":[[5,2,"しょくん"],[8,2,"みき"],[26,1,"て"],[28,1,"つく"],[35,2,"かみさま"],[44,1,"い"],[63,2,"ぜんたい"],[71,1,"おお"],[75,2,"ひとびと"],[78,1,"と"],[83,1,"あやま"]],"text":"しかるに、諸君の見聞きしているように、あのパウロが、手で造られたものは神様ではないなどと言って、エペソばかりか、ほとんどアジヤ全体にわたって、大ぜいの人々を説きつけて誤らせた。"},{"ref":"Acts.19.27","start":44019027,"end":44019027,"break":"none","ruby":[[6,1,"たがい"],[8,2,"しごと"],[11,2,"あくひょう"],[14,1,"た"],[27,1,"おお"],[28,2,"めがみ"],[36,1,"みや"],[38,1,"かろ"],[48,1,"ぜん"],[55,1,"ぜん"],[56,2,"せかい"],[59,1,"おが"],[66,1,"おお"],[67,2,"めがみ"],[71,2,"いこう"],[77,1,"き"]],"text":"これでは、お互の仕事に悪評が立つおそれがあるばかりか、大女神アルテミスの宮も軽んじられ、ひいては全アジヤ、いや全世界が拝んでいるこの大女神のご威光さえも、消えてしまいそうである」。"},{"ref":"Acts.19.28","start":44019028,"end":44019028,"break":"paragraph","ruby":[[3,1,"き"],[7,2,"ひとびと"],[10,1,"いか"],[13,1,"も"],[16,2,"おおごえ"],[20,1,"おお"],[30,1,"びと"],[39,1,"さけ"]],"text":"これを聞くと、人々は怒りに燃え、大声で「大いなるかな、エペソ人のアルテミス」と叫びつづけた。"},{"ref":"Acts.19.29","start":44019029,"end":44019029,"break":"none","ruby":[[4,2,"まちじゅう"],[7,1,"だい"],[8,2,"こんらん"],[11,1,"おちい"],[14,2,"ひとびと"],[21,2,"みちづ"],[32,1,"びと"],[45,1,"とら"],[54,2,"げきじょう"],[60,1,"こ"]],"text":"そして、町中が大混乱に陥り、人々はパウロの道連れであるマケドニヤ人ガイオとアリスタルコとを捕えて、いっせいに劇場へなだれ込んだ。"},{"ref":"Acts.19.30","start":44019030,"end":44019030,"break":"none","ruby":[[4,2,"ぐんしゅう"],[7,1,"なか"],[13,1,"い"],[21,2,"でし"]],"text":"パウロは群衆の中にはいって行こうとしたが、弟子たちがそれをさせなかった。"},{"ref":"Acts.19.31","start":44019031,"end":44019031,"break":"none","ruby":[[3,1,"しゅう"],[5,2,"ぎいん"],[13,2,"ゆうじん"],[19,1,"ひと"],[24,1,"かれ"],[26,1,"つかい"],[33,2,"げきじょう"],[40,1,"い"],[53,1,"たの"]],"text":"アジヤ州の議員で、パウロの友人であった人たちも、彼に使をよこして、劇場にはいって行かないようにと、しきりに頼んだ。"},{"ref":"Acts.19.32","start":44019032,"end":44019032,"break":"none","ruby":[[0,1,"なか"],[4,2,"しゅうかい"],[7,2,"こんらん"],[10,1,"おちい"],[20,1,"もの"],[31,1,"もの"],[51,3,"だいたすう"],[55,1,"もの"],[64,1,"あつ"]],"text":"中では、集会が混乱に陥ってしまって、ある者はこのことを、ほかの者はあのことを、どなりつづけていたので、大多数の者は、なんのために集まったのかも、わからないでいた。"},{"ref":"Acts.19.33","start":44019033,"end":44019033,"break":"none","ruby":[[7,1,"じん"],[12,1,"まえ"],[14,1,"お"],[16,1,"だ"],[28,1,"もの"],[31,2,"ぐんしゅう"],[34,1,"なか"],[38,1,"ひと"],[42,1,"うなが"],[48,1,"かれ"],[50,1,"て"],[52,1,"ふ"],[56,2,"ひとびと"],[59,2,"べんめい"],[62,1,"こころ"]],"text":"そこで、ユダヤ人たちが、前に押し出したアレキサンデルなる者を、群衆の中のある人たちが促したため、彼は手を振って、人々に弁明を試みようとした。"},{"ref":"Acts.19.34","start":44019034,"end":44019034,"break":"none","ruby":[[5,1,"かれ"],[10,1,"じん"],[22,1,"もの"],[30,1,"おお"],[40,1,"びと"],[50,2,"じかん"],[56,1,"さけ"]],"text":"ところが、彼がユダヤ人だとわかると、みんなの者がいっせいに「大いなるかな、エペソ人のアルテミス」と二時間ばかりも叫びつづけた。"},{"ref":"Acts.19.35","start":44019035,"end":44019035,"break":"none","ruby":[[4,1,"し"],[6,2,"しょき"],[8,1,"やく"],[10,2,"ぐんしゅう"],[13,1,"お"],[15,1,"しず"],[18,1,"い"],[27,2,"しょくん"],[33,1,"し"],[35,1,"おお"],[36,2,"めがみ"],[45,1,"あま"],[51,2,"しんたい"],[55,2,"しゅご"],[57,1,"やく"],[64,1,"し"],[68,1,"もの"]],"text":"ついに、市の書記役が群衆を押し静めて言った、「エペソの諸君、エペソ市が大女神アルテミスと、天くだったご神体との守護役であることを知らない者が、ひとりでもいるだろうか。"},{"ref":"Acts.19.36","start":44019036,"end":44019036,"break":"none","ruby":[[3,2,"ひてい"],[10,2,"じじつ"],[18,2,"しょくん"],[25,1,"しず"],[36,2,"らんぼう"],[39,2,"こうどう"]],"text":"これは否定のできない事実であるから、諸君はよろしく静かにしているべきで、乱暴な行動は、いっさいしてはならない。"},{"ref":"Acts.19.37","start":44019037,"end":44019037,"break":"none","ruby":[[0,2,"しょくん"],[5,1,"ひと"],[21,1,"かれ"],[24,1,"みや"],[26,1,"あら"],[28,1,"もの"],[37,2,"めがみ"],[43,1,"もの"]],"text":"諸君はこの人たちをここにひっぱってきたが、彼らは宮を荒す者でも、われわれの女神をそしる者でもない。"},{"ref":"Acts.19.38","start":44019038,"end":44019038,"break":"none","ruby":[[15,2,"しょくにん"],[17,2,"なかま"],[27,1,"たい"],[30,1,"うった"],[32,1,"こと"],[39,2,"さいばん"],[42,1,"ひ"],[48,2,"そうとく"],[62,1,"うった"],[64,1,"で"]],"text":"だから、もしデメテリオなりその職人仲間なりが、だれかに対して訴え事があるなら、裁判の日はあるし、総督もいるのだから、それぞれ訴え出るがよい。"},{"ref":"Acts.19.39","start":44019039,"end":44019039,"break":"none","ruby":[[4,1,"なに"],[9,2,"ようきゅう"],[14,1,"こと"],[23,2,"せいしき"],[26,2,"ぎかい"],[29,2,"かいけつ"]],"text":"しかし、何かもっと要求したい事があれば、それは正式の議会で解決してもらうべきだ。"},{"ref":"Acts.19.40","start":44019040,"end":44019040,"break":"none","ruby":[[4,2,"じけん"],[14,1,"さわ"],[17,2,"べんご"],[25,2,"りゆう"],[28,1,"まった"],[42,2,"ちあん"],[48,1,"つみ"],[50,1,"と"]],"text":"きょうの事件については、この騒ぎを弁護できるような理由が全くないのだから、われわれは治安をみだす罪に問われるおそれがある」。"},{"ref":"Acts.19.41","start":44019041,"end":44019041,"break":"none","ruby":[[2,1,"い"],[6,1,"かれ"],[10,2,"しゅうかい"],[13,2,"かいさん"]],"text":"こう言って、彼はこの集会を解散させた。"}]