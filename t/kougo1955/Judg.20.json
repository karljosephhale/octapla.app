[{"ref":"Judg.20.1","start":7020001,"end":7020001,"break":"paragraph","ruby":[[9,2,"ひとびと"],[32,1,"ち"],[38,1,"で"],[45,2,"かいしゅう"],[59,1,"しゅ"],[64,1,"あつ"]],"text":"そこでイスラエルの人々は、ダンからベエルシバまで、またギレアデの地からもみな出てきて、その会衆はひとりのようにミヅパで主のもとに集まった。"},{"ref":"Judg.20.2","start":7020002,"end":7020002,"break":"none","ruby":[[0,1,"たみ"],[2,2,"しゅりょう"],[21,2,"ぶぞく"],[24,2,"しゅりょう"],[34,1,"かみ"],[36,1,"たみ"],[38,2,"しゅうごう"],[41,1,"で"],[48,1,"お"],[53,2,"ほへい"],[59,1,"にん"]],"text":"民の首領たち、すなわちイスラエルのすべての部族の首領たちは、みずから神の民の集合に出た。つるぎを帯びている歩兵が四十万人あった。"},{"ref":"Judg.20.3","start":7020003,"end":7020003,"break":"none","ruby":[[6,2,"ひとびと"],[16,2,"ひとびと"],[23,1,"のぼ"],[29,1,"き"],[39,2,"ひとびと"],[42,1,"い"],[54,2,"あくじ"],[57,1,"おこ"],[68,1,"はな"]],"text":"ベニヤミンの人々は、イスラエルの人々がミヅパに上ったことを聞いた。イスラエルの人々は言った、「どうして、この悪事が起ったのか、われわれに話してください」。"},{"ref":"Judg.20.4","start":7020004,"end":7020004,"break":"none","ruby":[[0,1,"ころ"],[4,1,"おんな"],[6,1,"おっと"],[15,1,"こた"],[18,1,"い"],[32,2,"いっしょ"],[41,1,"ぞく"],[48,1,"い"],[51,1,"やど"]],"text":"殺された女の夫であるレビびとは答えて言った、「わたしは、めかけと一緒にベニヤミンに属するギベアへ行って宿りましたが、"},{"ref":"Judg.20.5","start":7020005,"end":7020005,"break":"none","ruby":[[4,2,"ひとびと"],[7,1,"た"],[14,1,"せ"],[17,1,"よ"],[19,1,"ま"],[28,1,"いえ"],[30,1,"と"],[32,1,"かこ"],[40,1,"ころ"],[44,1,"くわだ"],[65,1,"し"]],"text":"ギベアの人々は立ってわたしを攻め、夜の間に、わたしのおる家を取り囲んで、わたしを殺そうと企て、ついにわたしのめかけをはずかしめて、死なせました。"},{"ref":"Judg.20.6","start":7020006,"end":7020006,"break":"none","ruby":[[11,1,"とら"],[14,1,"た"],[16,1,"き"],[28,1,"し"],[29,1,"ぎょう"],[35,2,"ちほう"],[42,1,"おく"],[48,1,"かれ"],[60,1,"にく"],[71,1,"おこな"]],"text":"それでわたしはめかけを捕えて断ち切り、それをイスラエルの嗣業のすべての地方にあまねく送りました。彼らがイスラエルにおいて憎むべきみだらなことを行ったからです。"},{"ref":"Judg.20.7","start":7020007,"end":7020007,"break":"none","ruby":[[6,2,"ひとびと"],[16,1,"みな"],[17,2,"じぶん"],[20,2,"いけん"],[23,1,"かんが"],[29,1,"の"]],"text":"イスラエルの人々よ、あなたがたは皆自分の意見と考えをここに述べてください」。"},{"ref":"Judg.20.8","start":7020008,"end":7020008,"break":"paragraph","ruby":[[0,1,"たみ"],[2,1,"みな"],[10,1,"た"],[13,1,"い"],[26,2,"じぶん"],[29,2,"てんまく"],[32,1,"い"],[43,2,"じぶん"],[46,1,"いえ"],[48,1,"かえ"]],"text":"民は皆ひとりのように立って言った、「われわれはだれも自分の天幕に行きません。まただれも自分の家に帰りません。"},{"ref":"Judg.20.9","start":7020009,"end":7020009,"break":"none","ruby":[[5,1,"いま"],[10,1,"たい"],[19,1,"こと"],[34,1,"ひ"],[42,1,"せ"]],"text":"われわれが今ギベアに対してしようとする事はこれです。われわれはくじを引いて、ギベアに攻めのぼりましょう。"},{"ref":"Judg.20.10","start":7020010,"end":7020010,"break":"none","ruby":[[14,2,"ぶぞく"],[19,1,"にん"],[25,1,"にん"],[28,1,"にん"],[34,1,"にん"],[37,1,"にん"],[43,1,"にん"],[45,1,"えら"],[49,1,"たみ"],[51,2,"りょうしょく"],[58,1,"たみ"],[70,1,"い"],[104,1,"こと"],[106,1,"たい"],[110,2,"ほうふく"]],"text":"すなわちイスラエルのすべての部族から百人について十人、千人について百人、万人について千人を選んで、民の糧食をとらせ、民はベニヤミンのギベアに行って、ベニヤミンびとがイスラエルにおいておこなったすべてのみだらな事に対して、報復しましょう」。"},{"ref":"Judg.20.11","start":7020011,"end":7020011,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"みな"],[14,1,"あつ"],[18,2,"いっち"],[20,2,"けっそく"],[24,1,"まち"],[26,1,"せ"]],"text":"こうしてイスラエルの人々は皆集まり、一致結束して町を攻めようとした。"},{"ref":"Judg.20.12","start":7020012,"end":7020012,"break":"paragraph","ruby":[[11,2,"ぶぞく"],[14,2,"ひとびと"],[27,2,"ぶぞく"],[38,1,"い"],[53,1,"た"],[58,1,"こと"],[65,2,"あくじ"]],"text":"イスラエルのもろもろの部族は人々をあまねくベニヤミンの部族のうちにつかわして言わせた、「あなたがたのうちに起ったこの事は、なんたる悪事でしょうか。"},{"ref":"Judg.20.13","start":7020013,"end":7020013,"break":"none","ruby":[[3,1,"いま"],[12,1,"わる"],[14,2,"ひとびと"],[29,1,"かれ"],[32,1,"ころ"],[43,1,"あく"],[45,1,"のぞ"],[47,1,"さ"],[64,2,"ひとびと"],[69,2,"きょうだい"],[80,2,"ひとびと"],[83,2,"ことば"],[86,1,"き"]],"text":"それで今ギベアにいるあの悪い人々をわたしなさい。われわれは彼らを殺して、イスラエルから悪を除き去りましょう」。しかしベニヤミンの人々はその兄弟であるイスラエルの人々の言葉を聞きいれなかった。"},{"ref":"Judg.20.14","start":7020014,"end":7020014,"break":"none","ruby":[[10,2,"ひとびと"],[13,2,"まちまち"],[21,1,"あつ"],[25,1,"で"],[33,2,"ひとびと"],[36,1,"たたか"]],"text":"かえってベニヤミンの人々は町々からギベアに集まり、出てイスラエルの人々と戦おうとした。"},{"ref":"Judg.20.15","start":7020015,"end":7020015,"break":"none","ruby":[[2,1,"ひ"],[4,2,"まちまち"],[8,1,"あつ"],[18,2,"ひとびと"],[25,1,"お"],[30,1,"もの"],[35,1,"にん"],[46,2,"じゅうみん"],[49,1,"あつ"],[53,2,"せいへい"],[58,1,"にん"]],"text":"その日、町々から集まったベニヤミンの人々はつるぎを帯びている者二万六千人あり、ほかにギベアの住民で集まった精兵が七百人あった。"},{"ref":"Judg.20.16","start":7020016,"end":7020016,"break":"none","ruby":[[6,1,"たみ"],[11,1,"ひだり"],[15,2,"せいへい"],[20,1,"にん"],[30,1,"ぽん"],[32,1,"け"],[40,1,"いし"],[42,1,"な"]],"text":"このすべての民のうちに左ききの精兵が七百人あって、いずれも一本の毛すじをねらって石を投げても、はずれることがなかった。"},{"ref":"Judg.20.17","start":7020017,"end":7020017,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"あつ"],[13,1,"もの"],[21,1,"のぞ"],[29,1,"お"],[34,1,"もの"],[38,1,"にん"],[46,2,"ぐんじん"]],"text":"イスラエルの人々の集まった者はベニヤミンを除いて、つるぎを帯びている者四十万人あり、いずれも軍人であった。"},{"ref":"Judg.20.18","start":7020018,"end":7020018,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"た"],[23,1,"かみ"],[25,1,"たず"],[56,2,"ひとびと"],[59,1,"たたか"],[68,1,"しゅ"],[70,1,"い"]],"text":"イスラエルの人々は立ちあがってベテルにのぼり、神に尋ねた、「われわれのうち、いずれがさきにのぼって、ベニヤミンの人々と戦いましょうか」。主は言われた、「ユダがさきに」。"},{"ref":"Judg.20.19","start":7020019,"end":7020019,"break":"paragraph","ruby":[[9,2,"ひとびと"],[13,1,"あさ"],[14,1,"お"],[22,1,"たい"],[24,1,"じん"],[26,1,"と"]],"text":"そこでイスラエルの人々は、朝起きて、ギベアに対し陣を取った。"},{"ref":"Judg.20.20","start":7020020,"end":7020020,"break":"none","ruby":[[10,2,"ひとびと"],[19,1,"たたか"],[24,1,"で"],[26,1,"い"],[34,1,"かれ"],[37,1,"たい"],[40,1,"たたか"],[43,1,"そな"]],"text":"すなわちイスラエルの人々はベニヤミンと戦うために出て行って、ギベアで彼らに対して戦いの備えをしたが、"},{"ref":"Judg.20.21","start":7020021,"end":7020021,"break":"none","ruby":[[6,2,"ひとびと"],[14,1,"で"],[21,1,"ひ"],[28,2,"ひとびと"],[37,1,"にん"],[39,1,"ち"],[41,1,"う"],[43,1,"たお"]],"text":"ベニヤミンの人々はギベアから出てきて、その日イスラエルの人々のうち二万二千人を地に撃ち倒した。"},{"ref":"Judg.20.22","start":7020022,"end":7020022,"break":"none","ruby":[[9,1,"たみ"],[11,2,"ひとびと"],[14,1,"ふる"],[19,1,"はじ"],[22,1,"ひ"],[24,1,"そな"],[29,1,"ところ"],[35,1,"たたか"],[38,1,"そな"]],"text":"しかしイスラエルの民の人々は奮いたって初めの日に備えをした所にふたたび戦いの備えをした。"},{"ref":"Judg.20.23","start":7020023,"end":7020023,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"のぼ"],[15,1,"い"],[18,1,"しゅ"],[20,1,"まえ"],[22,2,"ゆうぐれ"],[26,1,"な"],[29,1,"しゅ"],[31,1,"たず"],[41,1,"ふたた"],[48,2,"きょうだい"],[59,2,"ひとびと"],[62,1,"たたか"],[65,1,"まじ"],[77,1,"しゅ"],[79,1,"い"],[85,1,"せ"]],"text":"そしてイスラエルの人々は上って行って主の前に夕暮まで泣き、主に尋ねた、「われわれは再びわれわれの兄弟であるベニヤミンの人々と戦いを交えるべきでしょうか」。主は言われた、「攻めのぼれ」。"},{"ref":"Judg.20.24","start":7020024,"end":7020024,"break":"paragraph","ruby":[[9,2,"ひとびと"],[13,1,"つぎ"],[15,1,"ひ"],[24,2,"ひとびと"],[27,1,"ところ"],[29,1,"せ"]],"text":"そこでイスラエルの人々は、次の日またベニヤミンの人々の所に攻めよせたが、"},{"ref":"Judg.20.25","start":7020025,"end":7020025,"break":"none","ruby":[[6,1,"つぎ"],[8,1,"ひ"],[16,1,"で"],[22,1,"むか"],[35,2,"ひとびと"],[44,1,"にん"],[46,1,"ち"],[48,1,"う"],[50,1,"たお"],[58,1,"みな"],[63,1,"お"],[68,1,"もの"]],"text":"ベニヤミンは次の日またギベアから出て、これを迎え、ふたたびイスラエルの人々のうち一万八千人を地に撃ち倒した。これらは皆つるぎを帯びている者であった。"},{"ref":"Judg.20.26","start":7020026,"end":7020026,"break":"none","ruby":[[16,2,"ひとびと"],[22,1,"ぜん"],[23,1,"ぐん"],[29,1,"のぼ"],[32,1,"い"],[35,1,"な"],[40,1,"ところ"],[42,1,"しゅ"],[44,1,"まえ"],[46,1,"ざ"],[52,1,"ひ"],[53,2,"ゆうぐれ"],[57,2,"だんじき"],[61,2,"はんさい"],[64,3,"しゅうおんさい"],[68,1,"しゅ"],[70,1,"まえ"]],"text":"これがためにイスラエルのすべての人々すなわち全軍はベテルに上って行って泣き、その所で主の前に座して、その日夕暮まで断食し、燔祭と酬恩祭を主の前にささげた。"},{"ref":"Judg.20.27","start":7020027,"end":7020027,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"しゅ"],[14,1,"たず"],[23,1,"かみ"],[25,2,"けいやく"],[28,1,"はこ"]],"text":"そしてイスラエルの人々は主に尋ね、――そのころ神の契約の箱はそこにあって、"},{"ref":"Judg.20.28","start":7020028,"end":7020028,"break":"none","ruby":[[4,1,"こ"],[11,1,"こ"],[24,1,"つか"],[34,1,"い"],[50,1,"で"],[58,2,"きょうだい"],[69,2,"ひとびと"],[72,1,"たたか"],[98,1,"しゅ"],[100,1,"い"],[116,1,"かれ"],[125,1,"て"]],"text":"アロンの子エレアザルの子であるピネハスが、それに仕えていた――そして言った、「われわれはなおふたたび出て、われわれの兄弟であるベニヤミンの人々と戦うべきでしょうか。あるいはやめるべきでしょうか」。主は言われた、「のぼれ。わたしはあす彼らをあなたがたの手にわたすであろう」。"},{"ref":"Judg.20.29","start":7020029,"end":7020029,"break":"paragraph","ruby":[[13,2,"しゅうい"],[16,2,"ふくへい"],[19,1,"お"]],"text":"そこでイスラエルはギベアの周囲に伏兵を置き、"},{"ref":"Judg.20.30","start":7020030,"end":7020030,"break":"none","ruby":[[9,2,"ひとびと"],[13,1,"か"],[14,1,"め"],[24,2,"ひとびと"],[31,1,"せ"],[37,1,"まえ"],[46,1,"たい"],[49,1,"そな"]],"text":"そしてイスラエルの人々は三日目にまたベニヤミンの人々のところに攻めのぼり、前のようにギベアに対して備えをした。"},{"ref":"Judg.20.31","start":7020031,"end":7020031,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"で"],[12,1,"たみ"],[14,1,"むか"],[22,1,"まち"],[28,1,"だ"],[35,1,"かれ"],[38,1,"まえ"],[43,2,"おおじ"],[46,1,"たみ"],[48,1,"う"],[56,1,"の"],[64,1,"ひと"],[68,1,"にん"],[72,1,"ころ"],[78,2,"おおじ"],[89,1,"いた"],[99,1,"いた"]],"text":"ベニヤミンの人々は出て、民を迎えたが、ついに町からおびき出されたので、彼らは前のように大路で民を撃ちはじめ、また野でイスラエルの人を三十人ばかり殺した。その大路は、一つはベテルに至り、一つはギベアに至るものであった。"},{"ref":"Judg.20.32","start":7020032,"end":7020032,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"い"],[14,1,"かれ"],[17,1,"はじ"],[29,1,"まえ"],[31,1,"う"],[33,1,"やぶ"],[48,2,"ひとびと"],[51,1,"い"],[61,1,"に"],[65,1,"かれ"],[68,1,"まち"],[71,2,"おおじ"],[77,1,"だ"]],"text":"ベニヤミンの人々は言った、「彼らは初めのように、われわれの前に撃ち破られる」。しかしイスラエルの人々は言った、「われわれは逃げて、彼らを町から大路におびき出そう」。"},{"ref":"Judg.20.33","start":7020033,"end":7020033,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"みな"],[15,1,"ところ"],[18,1,"た"],[29,1,"そな"],[37,1,"かん"],[39,1,"ま"],[41,1,"ぶ"],[52,2,"ひとびと"],[57,1,"ところ"],[68,1,"にし"],[71,1,"あらわ"],[73,1,"で"]],"text":"そしてイスラエルの人々は皆その所から立ってバアル・タマルに備えをした。その間に待ち伏せていたイスラエルの人々がその所から、すなわちゲバの西から現れ出た。"},{"ref":"Judg.20.34","start":7020034,"end":7020034,"break":"none","ruby":[[10,1,"ぜん"],[11,1,"ぐん"],[17,2,"せいへい"],[21,1,"にん"],[30,1,"おそ"],[35,1,"たたか"],[38,1,"はげ"],[53,2,"ひとびと"],[56,1,"わざわい"],[58,2,"じぶん"],[63,1,"せま"],[70,1,"し"]],"text":"すなわちイスラエルの全軍のうちから精兵一万人がきて、ギベアを襲い、その戦いは激しかった。しかしベニヤミンの人々は災の自分たちに迫っているのを知らなかった。"},{"ref":"Judg.20.35","start":7020035,"end":7020035,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"まえ"],[16,1,"う"],[18,1,"やぶ"],[31,2,"ひとびと"],[37,1,"ひ"],[51,1,"にん"],[53,1,"ころ"],[61,1,"みな"],[66,1,"お"],[71,1,"もの"]],"text":"主がイスラエルの前にベニヤミンを撃ち敗られたので、イスラエルの人々は、その日ベニヤミンびと二万五千一百人を殺した。これらは皆つるぎを帯びている者であった。"},{"ref":"Judg.20.36","start":7020036,"end":7020036,"break":"none","breaks":[[29,"paragraph"]],"ruby":[[10,2,"ひとびと"],[13,2,"じぶん"],[18,1,"う"],[20,1,"やぶ"],[26,1,"み"],[38,2,"ひとびと"],[45,1,"たい"],[48,1,"もう"],[51,2,"ふくへい"],[67,1,"さ"],[70,1,"しりぞ"]],"text":"こうしてベニヤミンの人々は自分たちの撃ち敗られたのを見た。そこでイスラエルの人々はギベアに対して設けた伏兵をたのんで、ベニヤミンびとを避けて退いた。"},{"ref":"Judg.20.37","start":7020037,"end":7020037,"break":"none","ruby":[[0,2,"ふくへい"],[3,1,"いそ"],[10,1,"つ"],[12,1,"い"],[15,1,"すす"],[25,1,"まち"],[32,1,"う"]],"text":"伏兵は急いでギベアに突き入り、進んでつるぎをもって町をことごとく撃った。"},{"ref":"Judg.20.38","start":7020038,"end":7020038,"break":"none","ruby":[[6,2,"ひとびと"],[9,2,"ふくへい"],[12,1,"あいだ"],[14,1,"さだ"],[17,2,"あいず"],[21,1,"まち"],[24,1,"おお"]],"text":"イスラエルの人々と伏兵の間に定めた合図は、町から大いなるのろしがあがるとき、"},{"ref":"Judg.20.39","start":7020039,"end":7020039,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"たたか"],[12,1,"てん"],[30,1,"はじ"],[38,2,"ひとびと"],[41,1,"う"],[46,1,"にん"],[51,1,"ころ"],[56,1,"い"],[65,1,"かれ"],[68,2,"さいしょ"],[71,1,"たたか"],[82,1,"まえ"],[84,1,"う"],[86,1,"やぶ"]],"text":"イスラエルの人々が戦いに転じることであった。さてベニヤミンは初めイスラエルの人々を撃って三十人ばかりを殺したので言った、「まことに彼らは最初の戦いのようにわれわれの前に撃ち敗られる」。"},{"ref":"Judg.20.40","start":7020040,"end":7020040,"break":"none","ruby":[[8,1,"けむり"],[10,1,"はしら"],[15,1,"まち"],[34,2,"ひとびと"],[41,1,"み"],[45,1,"まち"],[49,1,"けむり"],[54,1,"てん"]],"text":"しかし、のろしが煙の柱となって町からのぼりはじめたので、ベニヤミンの人々がうしろを見ると、町はみな煙となって天にのぼっていた。"},{"ref":"Judg.20.41","start":7020041,"end":7020041,"break":"none","ruby":[[2,1,"とき"],[9,2,"ひとびと"],[12,1,"む"],[15,1,"か"],[27,2,"ひとびと"],[30,1,"わざわい"],[32,2,"じぶん"],[37,1,"せま"],[42,1,"み"]],"text":"その時イスラエルの人々が向きを変えたので、ベニヤミンの人々は災が自分たちに迫ったのを見て、うろたえ、"},{"ref":"Judg.20.42","start":7020042,"end":7020042,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"まえ"],[12,1,"み"],[19,2,"あらの"],[22,1,"ほう"],[24,1,"む"],[30,1,"たたか"],[33,1,"かれ"],[36,1,"お"],[38,1,"せま"],[41,1,"まち"],[44,1,"で"],[48,1,"もの"],[53,1,"かれ"],[56,1,"なか"],[62,1,"ころ"]],"text":"イスラエルの人々の前から身をめぐらして荒野の方に向かったが、戦いが彼らに追い迫り、町から出てきた者どもは、彼らを中にはさんで殺した。"},{"ref":"Judg.20.43","start":7020043,"end":7020043,"break":"none","ruby":[[10,2,"ひとびと"],[19,2,"ひとびと"],[22,1,"き"],[24,1,"たお"],[27,1,"お"],[29,1,"う"],[32,1,"ふ"],[43,1,"ひがし"],[45,1,"ほう"],[50,1,"む"],[56,1,"およ"]],"text":"すなわちイスラエルの人々はベニヤミンの人々を切り倒し、追い撃ち、踏みにじって、ノハから東の方ギベアの向かいにまで及んだ。"},{"ref":"Judg.20.44","start":7020044,"end":7020044,"break":"none","ruby":[[6,1,"たお"],[9,1,"もの"],[15,1,"にん"],[20,2,"ゆうし"]],"text":"ベニヤミンの倒れた者は一万八千人で、みな勇士であった。"},{"ref":"Judg.20.45","start":7020045,"end":7020045,"break":"none","ruby":[[0,1,"かれ"],[3,1,"み"],[10,2,"あらの"],[13,1,"ほう"],[20,1,"いわ"],[23,1,"に"],[34,2,"ひとびと"],[37,2,"おおじ"],[46,1,"にん"],[48,1,"き"],[50,1,"たお"],[56,2,"ついげき"],[64,1,"いた"],[74,1,"にん"],[76,1,"ころ"]],"text":"彼らは身をめぐらして荒野の方、リンモンの岩まで逃げたが、イスラエルの人々は大路でそのうち五千人を切り倒し、なおも追撃してギドムに至り、そのうちの二千人を殺した。"},{"ref":"Judg.20.46","start":7020046,"end":7020046,"break":"none","ruby":[[6,1,"ひ"],[13,1,"たお"],[16,1,"もの"],[22,1,"お"],[27,1,"もの"],[28,1,"あ"],[36,1,"にん"],[41,2,"ゆうし"]],"text":"こうしてその日ベニヤミンの倒れた者はつるぎを帯びている者合わせて二万五千人で、みな勇士であった。"},{"ref":"Judg.20.47","start":7020047,"end":7020047,"break":"none","ruby":[[5,1,"にん"],[7,1,"もの"],[9,1,"み"],[16,2,"あらの"],[19,1,"ほう"],[26,1,"いわ"],[29,1,"に"],[35,1,"げつ"],[37,1,"あいだ"],[43,1,"いわ"],[45,1,"す"]],"text":"しかし六百人の者は身をめぐらして荒野の方、リンモンの岩まで逃げて、四か月の間リンモンの岩に住んだ。"},{"ref":"Judg.20.48","start":7020048,"end":7020048,"break":"none","ruby":[[9,2,"ひとびと"],[14,1,"み"],[26,2,"ひとびと"],[29,1,"せ"],[39,1,"ひと"],[41,1,"けもの"],[46,1,"み"],[53,1,"う"],[55,1,"ころ"],[60,1,"み"],[68,1,"まち"],[70,1,"ひ"]],"text":"そこでイスラエルの人々はまた身をかえしてベニヤミンの人々を攻め、つるぎをもって人も獣もすべて見つけたものを撃ち殺し、また見つけたすべての町に火をかけた。"}]