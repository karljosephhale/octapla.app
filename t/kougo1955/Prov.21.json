[{"ref":"Prov.21.1","start":20021001,"end":20021001,"break":"paragraph","breaks":[[16,"line"],[25,"line"]],"ruby":[[0,1,"おう"],[2,1,"こころ"],[5,1,"しゅ"],[7,1,"て"],[16,1,"みず"],[18,1,"なが"],[25,1,"しゅ"],[38,1,"みちび"]],"text":"王の心は、主の手のうちにあって、水の流れのようだ、主はみこころのままにこれを導かれる。"},{"ref":"Prov.21.2","start":20021002,"end":20021002,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ひと"],[2,1,"みち"],[4,2,"じぶん"],[7,1,"め"],[10,1,"ただ"],[13,1,"み"],[20,1,"しゅ"],[22,1,"ひと"],[24,1,"こころ"]],"text":"人の道は自分の目には正しく見える、しかし主は人の心をはかられる。"},{"ref":"Prov.21.3","start":20021003,"end":20021003,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"せいぎ"],[3,2,"こうへい"],[6,1,"おこな"],[12,2,"ぎせい"],[20,1,"しゅ"],[22,1,"よろこ"]],"text":"正義と公平を行うことは、犠牲にもまさって主に喜ばれる。"},{"ref":"Prov.21.4","start":20021004,"end":20021004,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"たか"],[3,1,"め"],[8,1,"こころ"],[12,1,"あ"],[15,1,"ひと"],[26,1,"つみ"]],"text":"高ぶる目とおごる心とは、悪しき人のともしびであって、罪である。"},{"ref":"Prov.21.5","start":20021005,"end":20021005,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"きんべん"],[3,1,"ひと"],[5,2,"けいかく"],[14,1,"ひと"],[16,1,"ゆた"],[25,1,"おこた"],[30,1,"まず"]],"text":"勤勉な人の計画は、ついにその人を豊かにする、すべて怠るものは貧しくなる。"},{"ref":"Prov.21.6","start":20021006,"end":20021006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"いつわ"],[3,1,"した"],[8,1,"たから"],[10,1,"え"],[15,1,"ふ"],[22,1,"けむり"],[24,1,"し"]],"text":"偽りの舌をもって宝を得るのは、吹きはらわれる煙、死のわなである。"},{"ref":"Prov.21.7","start":20021007,"end":20021007,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,2,"ぼうぎゃく"],[10,1,"み"],[12,1,"ほろ"],[16,1,"かれ"],[19,2,"こうへい"],[22,1,"おこな"],[27,1,"この"]],"text":"悪しき者の暴虐はその身を滅ぼす、彼らは公平を行うことを好まないからである。"},{"ref":"Prov.21.8","start":20021008,"end":20021008,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"つみ"],[4,1,"みち"],[6,1,"まが"],[12,2,"けっぱく"],[15,1,"ひと"],[17,1,"おこな"]],"text":"罪びとの道は曲っている、潔白な人の行いはまっすぐである。"},{"ref":"Prov.21.9","start":20021009,"end":20021009,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あらそ"],[3,1,"この"],[5,1,"おんな"],[7,2,"いっしょ"],[10,1,"いえ"],[17,2,"やね"]],"text":"争いを好む女と一緒に家におるよりは屋根のすみにおるほうがよい。"},{"ref":"Prov.21.10","start":20021010,"end":20021010,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"たましい"],[7,1,"あく"],[9,1,"おこな"],[14,1,"ねが"],[19,1,"とな"],[21,1,"びと"],[24,2,"こうい"],[30,1,"み"]],"text":"悪しき者の魂は悪を行うことを願う、その隣り人にも好意をもって見られない。"},{"ref":"Prov.21.11","start":20021011,"end":20021011,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[7,1,"ばつ"],[16,2,"しりょ"],[21,1,"もの"],[23,2,"ちえ"],[26,1,"え"],[29,2,"ちえ"],[33,1,"もの"],[35,1,"おしえ"],[43,2,"ちしき"],[46,1,"え"]],"text":"あざけるものが罰をうけるならば、思慮のない者は知恵を得る。知恵ある者が教をうけるならば知識を得る。"},{"ref":"Prov.21.12","start":20021012,"end":20021012,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ただ"],[3,1,"かみ"],[6,1,"あ"],[9,1,"もの"],[11,1,"いえ"],[18,1,"あ"],[21,1,"もの"],[23,1,"ほろ"],[26,1,"な"]],"text":"正しい神は、悪しき者の家をみとめて、悪しき者を滅びに投げいれられる。"},{"ref":"Prov.21.13","start":20021013,"end":20021013,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"みみ"],[2,1,"と"],[5,1,"まず"],[8,1,"もの"],[10,1,"よ"],[12,1,"こえ"],[14,1,"き"],[18,1,"もの"],[21,2,"じぶん"],[24,1,"よ"],[30,1,"き"]],"text":"耳を閉じて貧しい者の呼ぶ声を聞かない者は、自分が呼ぶときに、聞かれない。"},{"ref":"Prov.21.14","start":20021014,"end":20021014,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"おく"],[6,1,"もの"],[8,1,"いきどお"],[26,1,"はげ"],[29,1,"いか"],[32,1,"やわ"]],"text":"ひそかな贈り物は憤りをなだめる、ふところのまいないは激しい怒りを和らげる。"},{"ref":"Prov.21.15","start":20021015,"end":20021015,"break":"line","breaks":[[22,"line"]],"ruby":[[0,2,"こうぎ"],[3,1,"おこな"],[9,1,"ただ"],[12,1,"もの"],[15,1,"よろこ"],[22,1,"あく"],[24,1,"おこな"],[26,1,"もの"],[29,1,"ほろ"]],"text":"公義を行うことは、正しい者には喜びであるが、悪を行う者には滅びである。"},{"ref":"Prov.21.16","start":20021016,"end":20021016,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"さと"],[3,1,"みち"],[5,1,"はな"],[8,1,"ひと"],[11,2,"しにん"],[14,2,"しゅうかい"],[17,1,"なか"]],"text":"悟りの道を離れる人は、死人の集会の中におる。"},{"ref":"Prov.21.17","start":20021017,"end":20021017,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"かいらく"],[3,1,"この"],[5,1,"もの"],[7,1,"まず"],[10,1,"ひと"],[15,1,"さけ"],[17,1,"あぶら"],[20,1,"この"],[22,1,"もの"],[24,1,"と"]],"text":"快楽を好む者は貧しい人となり、酒と油とを好む者は富むことがない。"},{"ref":"Prov.21.18","start":20021018,"end":20021018,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"ただ"],[8,1,"もの"],[18,3,"ふしんじつ"],[22,1,"もの"],[24,1,"ただ"],[27,1,"ひと"],[29,1,"かわ"]],"text":"悪しき者は正しい者のあがないとなり、不信実な者は正しい人に代る。"},{"ref":"Prov.21.19","start":20021019,"end":20021019,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"あらそ"],[2,1,"いか"],[4,1,"おんな"],[6,1,"とも"],[14,2,"あらの"],[17,1,"す"]],"text":"争い怒る女と共におるよりは、荒野に住むほうがましだ。"},{"ref":"Prov.21.20","start":20021020,"end":20021020,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[6,1,"いえ"],[9,1,"たっと"],[11,1,"たから"],[16,1,"おろ"],[19,1,"ひと"],[27,1,"つく"]],"text":"知恵ある者の家には尊い宝があり、愚かな人はこれを、のみ尽す。"},{"ref":"Prov.21.21","start":20021021,"end":20021021,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"せいぎ"],[10,1,"お"],[12,1,"もと"],[15,1,"もの"],[18,1,"いのち"],[20,1,"ほまれ"],[23,1,"え"]],"text":"正義といつくしみとを追い求める者は、命と誉とを得る。"},{"ref":"Prov.21.22","start":20021022,"end":20021022,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[6,1,"つよ"],[8,1,"もの"],[10,1,"しろ"],[19,1,"たの"]],"text":"知恵ある者は強い者の城にのぼって、その頼みとするとりでをくずす。"},{"ref":"Prov.21.23","start":20021023,"end":20021023,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"くち"],[2,1,"した"],[5,1,"まも"],[7,1,"もの"],[11,1,"たましい"],[13,1,"まも"],[17,1,"なや"]],"text":"口と舌とを守る者はその魂を守って、悩みにあわせない。"},{"ref":"Prov.21.24","start":20021024,"end":20021024,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"たか"],[6,1,"もの"],[13,1,"もの"],[21,1,"かれ"],[23,2,"こうまん"],[25,2,"ぶれい"],[28,1,"おこな"]],"text":"高ぶりおごる者を「あざける者」となづける、彼は高慢無礼な行いをするものである。"},{"ref":"Prov.21.25","start":20021025,"end":20021025,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"もの"],[5,2,"よくぼう"],[8,2,"じぶん"],[11,1,"み"],[13,1,"ころ"],[21,1,"て"],[23,1,"はたら"]],"text":"なまけ者の欲望は自分の身を殺す、これはその手を働かせないからである。"},{"ref":"Prov.21.26","start":20021026,"end":20021026,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[9,1,"ひと"],[11,1,"もの"],[18,1,"ただ"],[21,1,"もの"],[23,1,"あた"],[26,1,"お"]],"text":"悪しき者はひねもす人の物をむさぼる、正しい者は与えて惜しまない。"},{"ref":"Prov.21.27","start":20021027,"end":20021027,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"そな"],[7,1,"もの"],[9,1,"にく"],[14,2,"あくい"],[24,1,"とき"]],"text":"悪しき者の供え物は憎まれる、悪意をもってささげる時はなおさらである。"},{"ref":"Prov.21.28","start":20021028,"end":20021028,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"いつわ"],[3,2,"しょうにん"],[6,1,"ほろ"],[14,1,"き"],[16,1,"ひと"],[18,2,"ことば"]],"text":"偽りの証人は滅ぼされる、よく聞く人の言葉はすたることがない。"},{"ref":"Prov.21.29","start":20021029,"end":20021029,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[13,1,"ただ"],[16,1,"ひと"],[20,1,"みち"]],"text":"悪しき者はあつかましくし、正しい人はその道をつつしむ。"},{"ref":"Prov.21.30","start":20021030,"end":20021030,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"む"],[7,2,"ちえ"],[10,1,"さと"],[14,1,"はか"],[23,1,"やく"],[26,1,"た"]],"text":"主に向かっては知恵も悟りも、計りごとも、なんの役にも立たない。"},{"ref":"Prov.21.31","start":20021031,"end":20021031,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"たたか"],[3,1,"ひ"],[8,1,"うま"],[10,1,"そな"],[17,2,"しょうり"],[20,1,"しゅ"]],"text":"戦いの日のために馬を備える、しかし勝利は主による。"}]