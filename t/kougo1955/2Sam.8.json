[{"ref":"2Sam.8.1","start":10008001,"end":10008001,"break":"paragraph","ruby":[[2,1,"のち"],[14,1,"う"],[21,2,"せいふく"],[39,1,"て"],[50,1,"と"]],"text":"この後ダビデはペリシテびとを撃って、これを征服した。ダビデはまたペリシテびとの手からメテグ・アンマを取った。"},{"ref":"2Sam.8.2","start":10008002,"end":10008002,"break":"paragraph","ruby":[[0,1,"かれ"],[8,1,"う"],[11,1,"かれ"],[14,1,"ち"],[16,1,"ふ"],[26,1,"かれ"],[29,1,"はか"],[38,1,"すじ"],[46,1,"ころ"],[50,1,"もの"],[52,1,"はか"],[56,1,"すじ"],[64,1,"い"],[70,1,"もの"],[72,1,"はか"],[102,1,"おさ"]],"text":"彼はまたモアブを撃ち、彼らを地に伏させ、なわをもって彼らを測った。すなわち二筋のなわをもって殺すべき者を測り、一筋のなわをもって生かしておく者を測った。そしてモアブびとは、ダビデのしもべとなって、みつぎを納めた。"},{"ref":"2Sam.8.3","start":10008003,"end":10008003,"break":"paragraph","ruby":[[10,1,"こ"],[17,1,"おう"],[29,1,"かわ"],[37,2,"せいりょく"],[40,2,"かいふく"],[48,1,"い"],[54,1,"う"]],"text":"ダビデはまたレホブの子であるゾバの王ハダデゼルが、ユフラテ川のほとりにその勢力を回復しようとして行くところを撃った。"},{"ref":"2Sam.8.4","start":10008004,"end":10008004,"break":"none","ruby":[[7,1,"かれ"],[10,2,"きへい"],[15,1,"にん"],[17,2,"ほへい"],[21,1,"にん"],[23,1,"と"],[36,2,"せんしゃ"],[39,1,"うま"],[41,1,"のこ"],[50,2,"せんしゃ"],[53,1,"うま"],[59,1,"あし"],[61,1,"すじ"],[63,1,"き"]],"text":"そしてダビデは彼から騎兵千七百人、歩兵二万人を取った。ダビデはまた一百の戦車の馬を残して、そのほかの戦車の馬はみなその足の筋を切った。"},{"ref":"2Sam.8.5","start":10008005,"end":10008005,"break":"none","ruby":[[15,1,"おう"],[22,1,"たす"],[46,1,"にん"],[48,1,"ころ"]],"text":"ダマスコのスリヤびとが、ゾバの王ハダデゼルを助けるためにきたので、ダビデはスリヤびと二万二千人を殺した。"},{"ref":"2Sam.8.6","start":10008006,"end":10008006,"break":"none","ruby":[[16,2,"しゅび"],[18,1,"たい"],[20,1,"お"],[47,1,"おさ"],[51,1,"しゅ"],[62,1,"い"],[64,1,"ところ"],[66,2,"しょうり"],[69,1,"あた"]],"text":"そしてダビデはダマスコのスリヤに守備隊を置いた。スリヤびとは、ダビデのしもべとなって、みつぎを納めた。主はダビデにすべてその行く所で勝利を与えられた。"},{"ref":"2Sam.8.7","start":10008007,"end":10008007,"break":"none","ruby":[[15,1,"も"],[20,1,"きん"],[22,1,"たて"],[24,1,"うば"],[34,1,"も"]],"text":"ダビデはハダデゼルのしもべらが持っていた金の盾を奪って、エルサレムに持ってきた。"},{"ref":"2Sam.8.8","start":10008008,"end":10008008,"break":"none","ruby":[[3,1,"おう"],[13,1,"まち"],[30,1,"おお"],[33,2,"せいどう"],[36,1,"と"]],"text":"ダビデ王はまたハダデゼルの町、ベタとベロタイから、ひじょうに多くの青銅を取った。"},{"ref":"2Sam.8.9","start":10008009,"end":10008009,"break":"paragraph","ruby":[[0,1,"とき"],[6,1,"おう"],[25,2,"ぐんぜい"],[28,1,"う"],[30,1,"やぶ"],[36,1,"き"]],"text":"時にハマテの王トイは、ダビデがハダデゼルのすべての軍勢を撃ち破ったことを聞き、"},{"ref":"2Sam.8.10","start":10008010,"end":10008010,"break":"none","ruby":[[2,1,"こ"],[10,1,"おう"],[21,1,"かれ"],[31,1,"しゅく"],[33,1,"の"],[55,1,"たたか"],[58,1,"まじ"],[73,1,"たたか"],[79,1,"う"],[81,1,"やぶ"],[94,1,"ぎん"],[96,1,"うつわ"],[98,1,"きん"],[100,1,"うつわ"],[102,2,"せいどう"],[105,1,"うつわ"],[107,1,"たずさ"]],"text":"その子ヨラムをダビデ王のもとにつかわして、彼にあいさつし、かつ祝を述べさせた。ハダデゼルはかつてしばしばトイと戦いを交えたが、ダビデがハダデゼルと戦ってこれを撃ち破ったからである。ヨラムが銀の器と金の器と青銅の器を携えてきたので、"},{"ref":"2Sam.8.11","start":10008011,"end":10008011,"break":"none","ruby":[[3,1,"おう"],[5,2,"せいふく"],[13,2,"こくみん"],[17,1,"と"],[24,2,"きんぎん"],[27,1,"とも"],[34,1,"しゅ"]],"text":"ダビデ王は征服したすべての国民から取ってささげた金銀と共にこれらをも主にささげた。"},{"ref":"2Sam.8.12","start":10008012,"end":10008012,"break":"none","ruby":[[17,2,"ひとびと"],[33,1,"え"],[35,1,"もの"],[43,1,"おう"],[48,1,"こ"],[56,1,"え"],[62,1,"もの"],[64,1,"とも"]],"text":"すなわちエドム、モアブ、アンモンの人々、ペリシテびと、アマレクから獲た物、およびゾバの王レホブの子ハダデゼルから獲たぶんどり物と共にこれをささげた。"},{"ref":"2Sam.8.13","start":10008013,"end":10008013,"break":"paragraph","ruby":[[8,2,"めいせい"],[11,1,"え"],[14,1,"かれ"],[16,1,"かえ"],[23,1,"しお"],[25,1,"たに"],[36,1,"にん"],[38,1,"う"],[40,1,"ころ"]],"text":"こうしてダビデは名声を得た。彼は帰ってきてから塩の谷でエドムびと一万八千人を撃ち殺した。"},{"ref":"2Sam.8.14","start":10008014,"end":10008014,"break":"none","ruby":[[7,2,"しゅび"],[9,1,"たい"],[11,1,"お"],[23,1,"ぜん"],[24,1,"ち"],[26,2,"しゅび"],[28,1,"たい"],[30,1,"お"],[39,1,"みな"],[52,1,"しゅ"],[63,1,"い"],[65,1,"ところ"],[67,2,"しょうり"],[70,1,"あた"]],"text":"そしてエドムに守備隊を置いた。すなわちエドムの全地に守備隊を置き、エドムびとは皆ダビデのしもべとなった。主はダビデにすべてその行く所で勝利を与えられた。"},{"ref":"2Sam.8.15","start":10008015,"end":10008015,"break":"paragraph","ruby":[[14,1,"ぜん"],[15,1,"ち"],[17,1,"おさ"],[26,1,"たみ"],[28,2,"せいぎ"],[31,2,"こうへい"],[34,1,"おこな"]],"text":"こうしてダビデはイスラエルの全地を治め、そのすべての民に正義と公平を行った。"},{"ref":"2Sam.8.16","start":10008016,"end":10008016,"break":"none","ruby":[[4,1,"こ"],[9,1,"ぐん"],[11,1,"ちょう"],[18,1,"こ"],[25,2,"しかん"]],"text":"ゼルヤの子ヨアブは軍の長、アヒルデの子ヨシャパテは史官、"},{"ref":"2Sam.8.17","start":10008017,"end":10008017,"break":"none","ruby":[[5,1,"こ"],[16,1,"こ"],[23,2,"さいし"],[30,3,"しょきかん"]],"text":"アヒトブの子ザドクとアビヤタルの子アヒメレクは祭司、セラヤは書記官、"},{"ref":"2Sam.8.18","start":10008018,"end":10008018,"break":"none","ruby":[[5,1,"こ"],[22,1,"ちょう"],[28,1,"こ"],[32,2,"さいし"]],"text":"エホヤダの子ベナヤはケレテびととペレテびとの長、ダビデの子たちは祭司であった。"}]