[{"ref":"Gen.36.1","start":1036001,"end":1036001,"break":"paragraph","ruby":[[12,2,"けいず"],[15,1,"つぎ"]],"text":"エサウ、すなわちエドムの系図は次のとおりである。"},{"ref":"Gen.36.2","start":1036002,"end":1036002,"break":"none","ruby":[[8,1,"むすめ"],[16,1,"つま"],[35,1,"むすめ"],[49,1,"こ"],[53,1,"むすめ"]],"text":"エサウはカナンの娘たちのうちから妻をめとった。すなわちヘテびとエロンの娘アダと、ヒビびとヂベオンの子アナの娘アホリバマとである。"},{"ref":"Gen.36.3","start":1036003,"end":1036003,"break":"none","ruby":[[9,1,"むすめ"],[15,1,"いもうと"]],"text":"また、イシマエルの娘ネバヨテの妹バスマテをめとった。"},{"ref":"Gen.36.4","start":1036004,"end":1036004,"break":"none","ruby":[[12,1,"う"],[25,1,"う"]],"text":"アダはエリパズをエサウに産み、バスマテはリウエルを産み、"},{"ref":"Gen.36.5","start":1036005,"end":1036005,"break":"none","ruby":[[17,1,"う"],[29,1,"こ"],[39,1,"ち"],[41,1,"かれ"],[43,1,"うま"],[46,1,"もの"]],"text":"アホリバマはエウシ、ヤラム、コラを産んだ。これらはエサウの子であって、カナンの地で彼に生れた者である。"},{"ref":"Gen.36.6","start":1036006,"end":1036006,"break":"paragraph","ruby":[[4,1,"つま"],[6,1,"こ"],[8,1,"むすめ"],[10,1,"いえ"],[16,1,"ひと"],[18,2,"かちく"],[25,1,"けもの"],[33,1,"ち"],[35,1,"え"],[41,2,"ざいさん"],[44,1,"たずさ"],[47,2,"きょうだい"],[53,1,"はな"],[59,1,"ち"],[61,1,"い"]],"text":"エサウは妻と子と娘と家のすべての人、家畜とすべての獣、またカナンの地で獲たすべての財産を携え、兄弟ヤコブを離れてほかの地へ行った。"},{"ref":"Gen.36.7","start":1036007,"end":1036007,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ざいさん"],[6,1,"おお"],[10,2,"いっしょ"],[34,1,"かれ"],[37,2,"きりゅう"],[41,1,"ち"],[43,1,"かれ"],[46,2,"かちく"],[53,1,"かれ"]],"text":"彼らの財産が多くて、一緒にいることができなかったからである。すなわち彼らが寄留した地は彼らの家畜のゆえに、彼らをささえることができなかったのである。"},{"ref":"Gen.36.8","start":1036008,"end":1036008,"break":"none","ruby":[[12,2,"さんち"],[15,1,"す"]],"text":"こうしてエサウはセイルの山地に住んだ。エサウはすなわちエドムである。"},{"ref":"Gen.36.9","start":1036009,"end":1036009,"break":"paragraph","ruby":[[4,2,"さんち"],[16,2,"せんぞ"],[22,2,"けいず"],[25,1,"つぎ"]],"text":"セイルの山地におったエドムびとの先祖エサウの系図は次のとおりである。"},{"ref":"Gen.36.10","start":1036010,"end":1036010,"break":"none","ruby":[[4,1,"こ"],[7,1,"な"],[9,1,"つぎ"],[26,1,"つま"],[30,1,"こ"],[41,1,"つま"],[47,1,"こ"]],"text":"エサウの子らの名は次のとおりである。すなわちエサウの妻アダの子はエリパズ。エサウの妻バスマテの子はリウエル。"},{"ref":"Gen.36.11","start":1036011,"end":1036011,"break":"none","ruby":[[5,1,"こ"]],"text":"エリパズの子らはテマン、オマル、ゼポ、ガタム、ケナズである。"},{"ref":"Gen.36.12","start":1036012,"end":1036012,"break":"none","ruby":[[8,1,"こ"],[29,1,"う"],[41,1,"つま"],[45,1,"こ"]],"text":"テムナはエサウの子エリパズのそばめで、アマレクをエリパズに産んだ。これらはエサウの妻アダの子らである。"},{"ref":"Gen.36.13","start":1036013,"end":1036013,"break":"none","ruby":[[5,1,"こ"],[8,1,"つぎ"],[48,1,"つま"],[54,1,"こ"]],"text":"リウエルの子らは次のとおりである。すなわちナハテ、ゼラ、シャンマ、ミザであって、これらはエサウの妻バスマテの子らである。"},{"ref":"Gen.36.14","start":1036014,"end":1036014,"break":"none","ruby":[[5,1,"こ"],[9,1,"むすめ"],[16,1,"つま"],[23,1,"こ"],[26,1,"つぎ"],[39,2,"かのじょ"],[57,1,"う"]],"text":"ヂベオンの子アナの娘で、エサウの妻アホリバマの子らは次のとおりである。すなわち彼女はエウシ、ヤラム、コラをエサウに産んだ。"},{"ref":"Gen.36.15","start":1036015,"end":1036015,"break":"paragraph","ruby":[[4,1,"こ"],[7,1,"なか"],[10,1,"ぞく"],[11,1,"ちょう"],[14,1,"もの"],[16,1,"つぎ"],[33,2,"ちょうし"],[40,1,"こ"],[47,2,"ぞくちょう"],[54,2,"ぞくちょう"],[60,2,"ぞくちょう"],[67,2,"ぞくちょう"]],"text":"エサウの子らの中で、族長たる者は次のとおりである。すなわちエサウの長子エリパズの子らはテマンの族長、オマルの族長、ゼポの族長、ケナズの族長、"},{"ref":"Gen.36.16","start":1036016,"end":1036016,"break":"none","ruby":[[3,2,"ぞくちょう"],[10,2,"ぞくちょう"],[18,2,"ぞくちょう"],[34,1,"で"],[36,2,"ぞくちょう"],[44,1,"ち"],[57,1,"こ"]],"text":"コラの族長、ガタムの族長、アマレクの族長である。これらはエリパズから出た族長で、エドムの地におった。これらはアダの子らである。"},{"ref":"Gen.36.17","start":1036017,"end":1036017,"break":"none","ruby":[[4,1,"こ"],[10,1,"こ"],[13,1,"つぎ"],[30,2,"ぞくちょう"],[36,2,"ぞくちょう"],[44,2,"ぞくちょう"],[50,2,"ぞくちょう"],[63,1,"で"],[65,2,"ぞくちょう"],[73,1,"ち"],[87,1,"つま"],[93,1,"こ"]],"text":"エサウの子リウエルの子らは次のとおりである。すなわちナハテの族長、ゼラの族長、シャンマの族長、ミザの族長。これらはリウエルから出た族長で、エドムの地におった。これらはエサウの妻バスマテの子らである。"},{"ref":"Gen.36.18","start":1036018,"end":1036018,"break":"none","ruby":[[4,1,"つま"],[11,1,"こ"],[14,1,"つぎ"],[31,2,"ぞくちょう"],[38,2,"ぞくちょう"],[44,2,"ぞくちょう"],[54,1,"むすめ"],[61,1,"つま"],[69,1,"で"],[71,2,"ぞくちょう"]],"text":"エサウの妻アホリバマの子らは次のとおりである。すなわちエウシの族長、ヤラムの族長、コラの族長。これらはアナの娘で、エサウの妻アホリバマから出た族長である。"},{"ref":"Gen.36.19","start":1036019,"end":1036019,"break":"none","ruby":[[15,1,"こ"],[19,1,"ぞく"],[20,1,"ちょう"],[23,1,"もの"]],"text":"これらはエサウすなわちエドムの子らで、族長たる者である。"},{"ref":"Gen.36.20","start":1036020,"end":1036020,"break":"paragraph","ruby":[[2,1,"ち"],[4,2,"じゅうみん"],[14,1,"こ"],[17,1,"つぎ"]],"text":"この地の住民ホリびとセイルの子らは次のとおりである。すなわちロタン、ショバル、ヂベオン、アナ、"},{"ref":"Gen.36.21","start":1036021,"end":1036021,"break":"none","ruby":[[22,1,"こ"],[29,1,"で"],[31,2,"ぞくちょう"],[39,1,"ち"]],"text":"デション、エゼル、デシャン。これらはセイルの子ホリびとから出た族長で、エドムの地におった。"},{"ref":"Gen.36.22","start":1036022,"end":1036022,"break":"none","ruby":[[4,1,"こ"],[21,1,"いもうと"]],"text":"ロタンの子らはホリ、ヘマムであり、ロタンの妹はテムナであった。"},{"ref":"Gen.36.23","start":1036023,"end":1036023,"break":"none","ruby":[[5,1,"こ"],[8,1,"つぎ"]],"text":"ショバルの子らは次のとおりである。すなわちアルワン、マナハテ、エバル、シポ、オナム。"},{"ref":"Gen.36.24","start":1036024,"end":1036024,"break":"none","ruby":[[5,1,"こ"],[8,1,"つぎ"],[32,1,"ちち"],[41,1,"か"],[46,1,"とき"],[48,2,"あらの"],[51,2,"おんせん"],[54,2,"はっけん"],[58,1,"もの"]],"text":"ヂベオンの子らは次のとおりである。すなわちアヤとアナ。このアナは父ヂベオンのろばを飼っていた時、荒野で温泉を発見した者である。"},{"ref":"Gen.36.25","start":1036025,"end":1036025,"break":"none","ruby":[[3,1,"こ"],[6,1,"つぎ"],[39,1,"むすめ"]],"text":"アナの子らは次のとおりである。すなわちデションとアホリバマ。アホリバマはアナの娘である。"},{"ref":"Gen.36.26","start":1036026,"end":1036026,"break":"none","ruby":[[5,1,"こ"],[8,1,"つぎ"]],"text":"デションの子らは次のとおりである。すなわちヘムダン、エシバン、イテラン、ケラン。"},{"ref":"Gen.36.27","start":1036027,"end":1036027,"break":"none","ruby":[[4,1,"こ"],[7,1,"つぎ"]],"text":"エゼルの子らは次のとおりである。すなわちビルハン、ザワン、アカン。"},{"ref":"Gen.36.28","start":1036028,"end":1036028,"break":"none","ruby":[[5,1,"こ"],[8,1,"つぎ"]],"text":"デシャンの子らは次のとおりである。すなわちウズとアラン。"},{"ref":"Gen.36.29","start":1036029,"end":1036029,"break":"none","ruby":[[6,1,"で"],[8,2,"ぞくちょう"],[11,1,"つぎ"],[28,2,"ぞくちょう"],[36,2,"ぞくちょう"],[44,2,"ぞくちょう"],[50,2,"ぞくちょう"]],"text":"ホリびとから出た族長は次のとおりである。すなわちロタンの族長、ショバルの族長、ヂベオンの族長、アナの族長、"},{"ref":"Gen.36.30","start":1036030,"end":1036030,"break":"none","ruby":[[5,2,"ぞくちょう"],[12,2,"ぞくちょう"],[20,2,"ぞくちょう"],[33,1,"で"],[35,2,"ぞくちょう"],[44,2,"しぞく"],[47,1,"したが"],[54,1,"ち"],[59,1,"もの"]],"text":"デションの族長、エゼルの族長、デシャンの族長。これらはホリびとから出た族長であって、その氏族に従ってセイルの地におった者である。"},{"ref":"Gen.36.31","start":1036031,"end":1036031,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"おさ"],[12,1,"おう"],[20,1,"とき"],[26,1,"ち"],[28,1,"おさ"],[31,1,"おう"],[35,1,"つぎ"]],"text":"イスラエルの人々を治める王がまだなかった時、エドムの地を治めた王たちは次のとおりである。"},{"ref":"Gen.36.32","start":1036032,"end":1036032,"break":"none","ruby":[[4,1,"こ"],[12,1,"おさ"],[17,1,"みやこ"],[19,1,"な"]],"text":"ベオルの子ベラはエドムを治め、その都の名はデナバであった。"},{"ref":"Gen.36.33","start":1036033,"end":1036033,"break":"none","ruby":[[3,1,"し"],[14,1,"こ"],[22,1,"かわ"],[25,1,"おう"]],"text":"ベラが死んで、ボズラのゼラの子ヨバブがこれに代って王となった。"},{"ref":"Gen.36.34","start":1036034,"end":1036034,"break":"none","ruby":[[4,1,"し"],[14,1,"ち"],[24,1,"かわ"],[27,1,"おう"]],"text":"ヨバブが死んで、テマンびとの地のホシャムがこれに代って王となった。"},{"ref":"Gen.36.35","start":1036035,"end":1036035,"break":"none","ruby":[[5,1,"し"],[13,1,"こ"],[21,1,"かわ"],[24,1,"おう"],[30,1,"かれ"],[36,1,"の"],[43,1,"う"],[46,1,"もの"],[53,1,"みやこ"],[55,1,"な"]],"text":"ホシャムが死んで、ベダデの子ハダデがこれに代って王となった。彼はモアブの野でミデアンを撃った者である。その都の名はアビテであった。"},{"ref":"Gen.36.36","start":1036036,"end":1036036,"break":"none","ruby":[[4,1,"し"],[20,1,"かわ"],[23,1,"おう"]],"text":"ハダデが死んで、マスレカのサムラがこれに代って王となった。"},{"ref":"Gen.36.37","start":1036037,"end":1036037,"break":"none","ruby":[[4,1,"し"],[11,1,"かわ"],[31,1,"かわ"],[34,1,"おう"]],"text":"サムラが死んでユフラテ川のほとりにあるレホボテのサウルがこれに代って王となった。"},{"ref":"Gen.36.38","start":1036038,"end":1036038,"break":"none","ruby":[[4,1,"し"],[12,1,"こ"],[24,1,"かわ"],[27,1,"おう"]],"text":"サウルが死んでアクボルの子バアル・ハナンがこれに代って王となった。"},{"ref":"Gen.36.39","start":1036039,"end":1036039,"break":"none","ruby":[[5,1,"こ"],[14,1,"し"],[25,1,"かわ"],[28,1,"おう"],[36,1,"みやこ"],[38,1,"な"],[49,1,"つま"],[51,1,"な"],[68,1,"むすめ"],[74,1,"むすめ"]],"text":"アクボルの子バアル・ハナンが死んで、ハダルがこれに代って王となった。その都の名はパウであった。その妻の名はメヘタベルといって、メザハブの娘マテレデの娘であった。"},{"ref":"Gen.36.40","start":1036040,"end":1036040,"break":"paragraph","ruby":[[5,1,"で"],[7,2,"ぞくちょう"],[10,1,"な"],[15,2,"しぞく"],[18,2,"じゅうしょ"],[21,1,"な"],[23,1,"したが"],[26,1,"い"],[29,1,"つぎ"],[46,2,"ぞくちょう"],[53,2,"ぞくちょう"],[60,2,"ぞくちょう"]],"text":"エサウから出た族長の名は、その氏族と住所と名に従って言えば次のとおりである。すなわちテムナの族長、アルワの族長、エテテの族長、"},{"ref":"Gen.36.41","start":1036041,"end":1036041,"break":"none","ruby":[[6,2,"ぞくちょう"],[12,2,"ぞくちょう"],[19,2,"ぞくちょう"]],"text":"アホリバマの族長、エラの族長、ピノンの族長、"},{"ref":"Gen.36.42","start":1036042,"end":1036042,"break":"none","ruby":[[4,2,"ぞくちょう"],[11,2,"ぞくちょう"],[19,2,"ぞくちょう"]],"text":"ケナズの族長、テマンの族長、ミブザルの族長、"},{"ref":"Gen.36.43","start":1036043,"end":1036043,"break":"none","ruby":[[6,2,"ぞくちょう"],[13,2,"ぞくちょう"],[24,2,"ぞくちょう"],[35,2,"りょうち"],[37,1,"うち"],[39,2,"じゅうしょ"],[42,1,"したが"],[60,2,"せんぞ"]],"text":"マグデエルの族長、イラムの族長。これらはエドムの族長たちであって、その領地内の住所に従っていったものである。エドムびとの先祖はエサウである。"}]