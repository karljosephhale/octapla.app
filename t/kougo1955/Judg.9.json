[{"ref":"Judg.9.1","start":7009001,"end":7009001,"break":"paragraph","ruby":[[8,1,"こ"],[19,1,"い"],[22,1,"はは"],[24,2,"みうち"],[27,1,"ひと"],[34,1,"い"],[38,1,"かれ"],[41,1,"はは"],[43,1,"ちち"],[45,1,"いえ"],[47,2,"いちぞく"],[51,1,"い"]],"text":"さてエルバアルの子アビメレクはシケムに行き、母の身内の人たちのもとに行って、彼らと母の父の家の一族とに言った、"},{"ref":"Judg.9.2","start":7009002,"end":7009002,"break":"none","ruby":[[13,2,"ひとびと"],[16,1,"みみ"],[18,1,"つ"],[37,1,"こ"],[40,1,"にん"],[48,1,"おさ"],[66,1,"おさ"],[90,2,"こつにく"],[98,1,"おぼ"]],"text":"「どうぞ、シケムのすべての人々の耳に告げてください、『エルバアルのすべての子七十人であなたがたを治めるのと、ただひとりであなたがたを治めるのと、どちらがよいか。わたしがあなたがたの骨肉であることを覚えてください』と」。"},{"ref":"Judg.9.3","start":7009003,"end":7009003,"break":"none","ruby":[[3,1,"はは"],[5,2,"みうち"],[8,1,"ひと"],[18,1,"かわ"],[25,2,"ことば"],[41,2,"ひとびと"],[44,1,"みみ"],[46,1,"つ"],[51,1,"かれ"],[54,1,"こころ"],[62,1,"かたむ"],[66,1,"かれ"],[73,2,"きょうだい"],[78,1,"い"]],"text":"そこで母の身内の人たちがアビメレクに代ってこれらの言葉をことごとくシケムのすべての人々の耳に告げると、彼らは心をアビメレクに傾け、「彼はわれわれの兄弟だ」と言って、"},{"ref":"Judg.9.4","start":7009004,"end":7009004,"break":"none","ruby":[[8,1,"みや"],[11,1,"ぎん"],[18,1,"と"],[21,1,"かれ"],[23,1,"あた"],[47,1,"もの"],[49,1,"やと"],[52,2,"じぶん"],[55,1,"したが"]],"text":"バアル・ベリテの宮から銀七十シケルを取って彼に与えた。アビメレクはそれをもって、やくざのならず者を雇って自分に従わせ、"},{"ref":"Judg.9.5","start":7009005,"end":7009005,"break":"none","ruby":[[6,1,"ちち"],[8,1,"いえ"],[10,1,"い"],[20,1,"こ"],[23,2,"じぶん"],[26,2,"きょうだい"],[33,1,"にん"],[39,1,"いし"],[41,1,"うえ"],[43,1,"ころ"],[56,1,"すえ"],[58,1,"こ"],[63,1,"み"],[65,1,"かく"],[70,1,"い"],[72,1,"のこ"]],"text":"オフラにある父の家に行って、エルバアルの子で、自分の兄弟である七十人を、一つの石の上で殺した。ただしエルバアルの末の子ヨタムは身を隠したので生き残った。"},{"ref":"Judg.9.6","start":7009006,"end":7009006,"break":"none","ruby":[[11,2,"ひとびと"],[23,2,"ひとびと"],[26,1,"あつ"],[30,1,"い"],[39,1,"いし"],[41,1,"はしら"],[53,1,"き"],[65,1,"た"],[68,1,"おう"]],"text":"そこでシケムのすべての人々とベテミロのすべての人々は集まり、行ってシケムにある石の柱のかたわらのテレビンの木のもとで、アビメレクを立てて王とした。"},{"ref":"Judg.9.7","start":7009007,"end":7009007,"break":"paragraph","ruby":[[9,1,"つ"],[12,1,"もの"],[24,1,"い"],[31,1,"やま"],[33,1,"いただき"],[35,1,"た"],[38,2,"おおごえ"],[41,1,"さけ"],[44,1,"かれ"],[47,1,"い"],[56,2,"ひとびと"],[64,1,"き"],[75,1,"かみ"],[83,1,"き"]],"text":"このことをヨタムに告げる者があったので、ヨタムは行ってゲリジム山の頂に立ち、大声に叫んで彼らに言った、「シケムの人々よ、わたしに聞きなさい。そうすれば神はあなたがたに聞かれるでしょう。"},{"ref":"Judg.9.8","start":7009008,"end":7009008,"break":"none","ruby":[[2,1,"とき"],[9,1,"き"],[11,2,"じぶん"],[16,1,"うえ"],[18,1,"おう"],[20,1,"た"],[25,1,"で"],[27,1,"い"],[34,1,"き"],[36,1,"い"],[47,1,"おう"]],"text":"ある時、もろもろの木が自分たちの上に王を立てようと出て行ってオリブの木に言った、『わたしたちの王になってください』。"},{"ref":"Judg.9.9","start":7009009,"end":7009009,"break":"none","ruby":[[7,1,"き"],[9,1,"かれ"],[12,1,"い"],[25,1,"かみ"],[27,1,"ひと"],[37,1,"もち"],[46,1,"あぶら"],[48,1,"す"],[51,1,"い"],[60,1,"き"],[62,1,"おさ"]],"text":"しかしオリブの木は彼らに言った、『わたしはどうして神と人とをあがめるために用いられるわたしの油を捨てて行って、もろもろの木を治めることができましょう』。"},{"ref":"Judg.9.10","start":7009010,"end":7009010,"break":"none","ruby":[[5,1,"き"],[14,1,"き"],[16,1,"い"],[29,1,"おう"]],"text":"もろもろの木はまたいちじくの木に言った、『きてわたしたちの王になってください』。"},{"ref":"Judg.9.11","start":7009011,"end":7009011,"break":"none","ruby":[[8,1,"き"],[10,1,"かれ"],[13,1,"い"],[30,2,"かんみ"],[38,1,"よ"],[40,2,"かじつ"],[44,1,"す"],[47,1,"い"],[56,1,"き"],[58,1,"おさ"]],"text":"しかしいちじくの木は彼らに言った、『わたしはどうしてわたしの甘味と、わたしの良い果実とを捨てて行って、もろもろの木を治めることができましょう』。"},{"ref":"Judg.9.12","start":7009012,"end":7009012,"break":"none","ruby":[[5,1,"き"],[13,1,"き"],[15,1,"い"],[28,1,"おう"]],"text":"もろもろの木はまたぶどうの木に言った、『きてわたしたちの王になってください』。"},{"ref":"Judg.9.13","start":7009013,"end":7009013,"break":"none","ruby":[[8,1,"き"],[10,1,"かれ"],[13,1,"い"],[26,1,"かみ"],[28,1,"ひと"],[31,1,"よろこ"],[42,1,"しゅ"],[44,1,"す"],[47,1,"い"],[56,1,"き"],[58,1,"おさ"]],"text":"しかし、ぶどうの木は彼らに言った、『わたしはどうして神と人とを喜ばせるわたしのぶどう酒を捨てて行って、もろもろの木を治めることができましょう』。"},{"ref":"Judg.9.14","start":7009014,"end":7009014,"break":"none","ruby":[[7,1,"き"],[13,1,"い"],[26,1,"おう"]],"text":"そこですべての木はいばらに言った、『きてわたしたちの王になってください』。"},{"ref":"Judg.9.15","start":7009015,"end":7009015,"break":"none","ruby":[[9,1,"き"],[11,1,"い"],[22,2,"しんじつ"],[29,1,"た"],[32,1,"おう"],[46,1,"かげ"],[48,1,"なん"],[50,1,"さ"],[69,1,"ひ"],[71,1,"で"],[78,2,"こうはく"],[81,1,"や"]],"text":"いばらはもろもろの木に言った、『あなたがたが真実にわたしを立てて王にするならば、きてわたしの陰に難を避けなさい。そうしなければ、いばらから火が出てレバノンの香柏を焼きつくすでしょう』。"},{"ref":"Judg.9.16","start":7009016,"end":7009016,"break":"paragraph","ruby":[[12,1,"た"],[15,1,"おう"],[23,2,"しんじつ"],[26,2,"けいい"],[55,1,"いえ"],[59,1,"あつか"],[62,1,"かれ"],[69,1,"おう"]],"text":"あなたがたがアビメレクを立てて王にしたことは、真実と敬意とをもってしたものですか。あなたがたはエルバアルとその家をよく扱い、彼のおこないに応じてしたのですか。"},{"ref":"Judg.9.17","start":7009017,"end":7009017,"break":"none","ruby":[[4,1,"ちち"],[15,1,"たたか"],[18,2,"じぶん"],[21,1,"いのち"],[23,1,"な"],[25,1,"だ"],[40,1,"て"],[43,1,"すく"],[45,1,"だ"]],"text":"わたしの父はあなたがたのために戦い、自分の命を投げ出して、あなたがたをミデアンの手から救い出したのに、"},{"ref":"Judg.9.18","start":7009018,"end":7009018,"break":"none","ruby":[[15,1,"ちち"],[17,1,"いえ"],[19,2,"はんこう"],[23,1,"おこ"],[28,1,"こ"],[31,1,"にん"],[36,1,"いし"],[38,1,"うえ"],[40,1,"ころ"],[45,2,"こしもと"],[48,1,"こ"],[61,2,"みうち"],[64,1,"もの"],[71,1,"た"],[79,2,"ひとびと"],[82,1,"おう"]],"text":"あなたがたは、きょう、わたしの父の家に反抗して起り、その子七十人を一つの石の上で殺し、その腰元の子アビメレクをあなたがたの身内の者であるゆえに立てて、シケムの人々の王にしました。"},{"ref":"Judg.9.19","start":7009019,"end":7009019,"break":"none","ruby":[[19,1,"いえ"],[28,2,"しんじつ"],[31,2,"けいい"],[57,1,"よろこ"],[63,1,"かれ"],[76,1,"よろこ"]],"text":"あなたがたが、きょう、エルバアルとその家になされたことが真実と敬意をもってしたものであるならば、アビメレクのために喜びなさい。彼もまたあなたがたのために喜ぶでしょう。"},{"ref":"Judg.9.20","start":7009020,"end":7009020,"break":"none","ruby":[[19,1,"ひ"],[21,1,"で"],[28,2,"ひとびと"],[37,1,"や"],[49,2,"ひとびと"],[59,1,"ひ"],[61,1,"で"],[69,1,"や"]],"text":"しかし、そうでなければ、アビメレクから火が出て、シケムの人々とベテミロとを焼きつくし、またシケムの人々とベテミロからも火が出てアビメレクを焼きつくすでしょう」。"},{"ref":"Judg.9.21","start":7009021,"end":7009021,"break":"none","ruby":[[8,1,"はし"],[11,1,"に"],[13,1,"さ"],[20,1,"い"],[23,2,"きょうだい"],[31,1,"かお"],[39,1,"す"]],"text":"こうしてヨタムは走って逃げ去り、ベエルに行き、兄弟アビメレクの顔をさけてそこに住んだ。"},{"ref":"Judg.9.22","start":7009022,"end":7009022,"break":"paragraph","ruby":[[7,1,"ねん"],[9,1,"あいだ"],[16,1,"おさ"]],"text":"アビメレクは三年の間イスラエルを治めたが、"},{"ref":"Judg.9.23","start":7009023,"end":7009023,"break":"none","ruby":[[0,1,"かみ"],[12,2,"ひとびと"],[15,1,"あいだ"],[17,2,"あくれい"],[32,2,"ひとびと"],[41,1,"あざむ"]],"text":"神はアビメレクとシケムの人々の間に悪霊をおくられたので、シケムの人々はアビメレクを欺くようになった。"},{"ref":"Judg.9.24","start":7009024,"end":7009024,"break":"none","ruby":[[11,1,"にん"],[13,1,"こ"],[15,1,"う"],[18,2,"ぼうぎゃく"],[21,1,"かれ"],[24,1,"ち"],[27,1,"かれ"],[30,1,"ころ"],[33,2,"きょうだい"],[41,1,"うえ"],[44,1,"かれ"],[46,1,"て"],[48,1,"つよ"],[53,2,"きょうだい"],[56,1,"ころ"],[64,2,"ひとびと"],[67,1,"うえ"],[70,1,"むく"]],"text":"これはエルバアルの七十人の子が受けた暴虐と彼らの血が、彼らを殺した兄弟アビメレクの上と、彼の手を強めてその兄弟を殺させたシケムの人々の上とに報いとなってきたのである。"},{"ref":"Judg.9.25","start":7009025,"end":7009025,"break":"none","ruby":[[4,2,"ひとびと"],[7,1,"かれ"],[9,1,"てき"],[12,1,"ま"],[14,1,"ぶ"],[18,1,"もの"],[20,2,"やまやま"],[23,1,"いただき"],[33,1,"みち"],[35,1,"とお"],[37,1,"す"],[40,1,"もの"],[42,2,"りゃくだつ"],[59,1,"つ"],[61,1,"し"]],"text":"シケムの人々は彼に敵して待ち伏せする者を山々の頂におき、すべてその道を通り過ぎる者を略奪させた。このことがアビメレクに告げ知らされた。"},{"ref":"Judg.9.26","start":7009026,"end":7009026,"break":"paragraph","ruby":[[6,1,"こ"],[13,2,"みうち"],[16,2,"ひとびと"],[19,2,"いっしょ"],[26,2,"いじゅう"],[36,2,"ひとびと"],[39,1,"かれ"],[41,2,"しんよう"]],"text":"さてエベデの子ガアルはその身内の人々と一緒にシケムに移住したが、シケムの人々は彼を信用した。"},{"ref":"Judg.9.27","start":7009027,"end":7009027,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"はたけ"],[5,1,"で"],[11,1,"と"],[13,1,"い"],[19,1,"ふ"],[21,1,"しぼ"],[24,1,"まつり"],[28,1,"かみ"],[30,1,"みや"],[32,1,"い"],[35,1,"の"],[37,1,"く"]],"text":"人々は畑に出てぶどうを取り入れ、それを踏み絞って祭をし、神の宮に行って飲み食いしてアビメレクをのろった。"},{"ref":"Judg.9.28","start":7009028,"end":7009028,"break":"none","ruby":[[7,1,"こ"],[12,1,"い"],[23,1,"なに"],[37,1,"なに"],[43,1,"かれ"],[45,1,"つか"],[64,1,"こ"],[68,2,"やくにん"],[78,2,"せんぞ"],[84,2,"いちぞく"],[87,1,"つか"],[105,1,"かれ"],[107,1,"つか"]],"text":"そしてエベデの子ガアルは言った、「アビメレクは何ものか。シケムのわれわれは何ものなれば彼に仕えなければならないのか。エルバアルの子とその役人ゼブルはシケムの先祖ハモルの一族に仕えたではないか。われわれはどうして彼に仕えなければならないのか。"},{"ref":"Judg.9.29","start":7009029,"end":7009029,"break":"none","ruby":[[5,1,"たみ"],[11,1,"て"],[13,1,"した"],[51,1,"む"],[60,2,"ぐんぜい"],[63,1,"ま"],[66,1,"で"],[72,1,"い"]],"text":"ああ、この民がわたしの手の下にあったらよいのだが。そうすればわたしはアビメレクをやめさせ、アビメレクに向かって『おまえの軍勢を増して出てこい』と言うであろう」。"},{"ref":"Judg.9.30","start":7009030,"end":7009030,"break":"paragraph","ruby":[[0,1,"まち"],[13,1,"こ"],[18,2,"ことば"],[21,1,"き"],[24,1,"いか"],[27,1,"はっ"]],"text":"町のつかさゼブルはエベデの子ガアルの言葉を聞いて怒りを発し、"},{"ref":"Judg.9.31","start":7009031,"end":7009031,"break":"none","ruby":[[0,2,"ししゃ"],[20,1,"い"],[30,1,"こ"],[37,2,"みうち"],[40,2,"ひとびと"],[50,1,"まち"],[52,1,"さわ"]],"text":"使者をアルマにおるアビメレクにつかわして言わせた、「エベデの子ガアルとその身内の人々がシケムにきて、町を騒がせ、あなたにそむかせようとしています。"},{"ref":"Judg.9.32","start":7009032,"end":7009032,"break":"none","ruby":[[12,1,"とも"],[16,2,"ひとびと"],[19,1,"よる"],[24,1,"い"],[28,1,"の"],[30,1,"み"],[32,1,"ふ"]],"text":"それであなたと、あなたと共におる人々が夜のうちに行って、野に身を伏せ、"},{"ref":"Judg.9.33","start":7009033,"end":7009033,"break":"none","ruby":[[0,1,"あさ"],[6,1,"ひ"],[14,1,"はや"],[16,1,"お"],[18,1,"で"],[20,1,"まち"],[22,1,"おそ"],[33,1,"かれ"],[35,1,"とも"],[39,1,"たみ"],[41,1,"で"],[50,2,"ていこう"],[61,1,"とき"],[66,1,"はた"],[68,1,"え"],[71,1,"かれ"],[74,1,"う"]],"text":"朝になって、日ののぼるとき、早く起き出て町を襲うならば、ガアルと、彼と共におる民は出てきて、あなたに抵抗するでしょう。その時あなたは機を得て、彼らを撃つことができるでしょう」。"},{"ref":"Judg.9.34","start":7009034,"end":7009034,"break":"paragraph","ruby":[[7,1,"かれ"],[9,1,"とも"],[17,1,"たみ"],[19,1,"よる"],[24,1,"お"],[26,1,"で"],[30,1,"くみ"],[32,1,"わか"],[35,1,"み"],[37,1,"ふ"]],"text":"アビメレクと、彼と共にいたすべての民は夜のうちに起き出て、四組に分れ、身を伏せてシケムをうかがった。"},{"ref":"Judg.9.35","start":7009035,"end":7009035,"break":"none","ruby":[[4,1,"こ"],[9,1,"で"],[12,1,"まち"],[14,1,"もん"],[16,2,"いりぐち"],[19,1,"た"],[32,1,"かれ"],[34,1,"とも"],[38,1,"たみ"],[40,1,"み"],[42,1,"ふ"],[52,1,"た"]],"text":"エベデの子ガアルが出て、町の門の入口に立ったとき、アビメレクと、彼と共にいた民が身を伏せていたところから立ちあがったので、"},{"ref":"Judg.9.36","start":7009036,"end":7009036,"break":"none","ruby":[[4,1,"たみ"],[6,1,"み"],[12,1,"い"],[24,1,"たみ"],[26,2,"やまやま"],[29,1,"いただき"],[44,1,"かれ"],[46,1,"い"],[55,2,"やまやま"],[58,1,"かげ"],[60,1,"ひと"],[65,1,"み"]],"text":"ガアルは民を見てゼブルに言った、「ごらんなさい。民が山々の頂からおりてきます」。ゼブルは彼に言った、「あなたは山々の影を人のように見るのです」。"},{"ref":"Judg.9.37","start":7009037,"end":7009037,"break":"none","ruby":[[4,1,"ふたた"],[6,1,"い"],[18,1,"たみ"],[20,1,"くに"],[22,2,"ちゅうおう"],[24,1,"ぶ"],[35,1,"くみ"],[37,1,"うらな"],[39,1,"し"],[46,1,"き"],[48,1,"ほう"]],"text":"ガアルは再び言った、「ごらんなさい。民が国の中央部からおりてきます。一組は占い師のテレビンの木の方からきます」。"},{"ref":"Judg.9.38","start":7009038,"end":7009038,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[25,1,"なに"],[35,1,"なに"],[41,1,"かれ"],[43,1,"つか"],[57,1,"い"],[64,1,"くち"],[66,1,"いま"],[83,1,"あなど"],[86,1,"たみ"],[96,1,"いま"],[98,1,"で"],[100,1,"かれ"],[103,1,"たたか"]],"text":"ゼブルは彼に言った、「あなたがかつて『アビメレクは何ものか。われわれは何ものなれば彼に仕えなければならないのか』と言ったあなたの口は今どこにありますか。これはあなたが侮った民ではありませんか。今、出て彼らと戦いなさい」。"},{"ref":"Judg.9.39","start":7009039,"end":7009039,"break":"none","ruby":[[11,2,"ひとびと"],[14,1,"ひき"],[17,1,"で"],[25,1,"たたか"]],"text":"そこでガアルはシケムの人々を率い、出てアビメレクと戦ったが、"},{"ref":"Judg.9.40","start":7009040,"end":7009040,"break":"none","ruby":[[6,1,"かれ"],[8,1,"お"],[18,1,"かれ"],[20,1,"まえ"],[23,1,"に"],[30,1,"きず"],[33,1,"たお"],[36,1,"もの"],[38,1,"おお"],[41,1,"もん"],[43,2,"いりぐち"],[48,1,"およ"]],"text":"アビメレクは彼を追ったので、ガアルは彼の前から逃げた。そして傷つき倒れる者が多く、門の入口にまで及んだ。"},{"ref":"Judg.9.41","start":7009041,"end":7009041,"break":"none","ruby":[[10,1,"ひ"],[12,1,"つづ"],[33,2,"みうち"],[36,2,"ひとびと"],[39,1,"お"],[41,1,"だ"]],"text":"こうしてアビメレクは引き続いてアルマにいたが、ゼブルはガアルとその身内の人々を追い出してシケムにおらせなかった。"},{"ref":"Judg.9.42","start":7009042,"end":7009042,"break":"paragraph","ruby":[[0,2,"よくじつ"],[3,1,"たみ"],[5,1,"はたけ"],[7,1,"で"],[22,1,"きこ"]],"text":"翌日、民が畑に出ると、そのことがアビメレクに聞えた。"},{"ref":"Judg.9.43","start":7009043,"end":7009043,"break":"none","ruby":[[6,2,"じぶん"],[9,1,"たみ"],[11,1,"ひき"],[18,1,"くみ"],[20,1,"わ"],[23,1,"の"],[25,1,"み"],[27,1,"ふ"],[40,1,"たみ"],[42,1,"まち"],[45,1,"で"],[61,1,"う"]],"text":"アビメレクは自分の民を率い、それを三組に分け、野に身を伏せて、うかがっていると、民が町から出てきたので、たちあがってこれを撃った。"},{"ref":"Judg.9.44","start":7009044,"end":7009044,"break":"none","ruby":[[7,1,"かれ"],[9,1,"とも"],[13,1,"くみ"],[15,1,"もの"],[17,1,"おそ"],[20,1,"い"],[24,1,"まち"],[26,1,"もん"],[28,2,"いりぐち"],[31,1,"た"],[34,1,"た"],[37,1,"くみ"],[39,1,"の"],[50,1,"おそ"],[57,1,"ころ"]],"text":"アビメレクと、彼と共にいた組の者は襲って行って、町の門の入口に立ち、他の二組は野にいたすべてのものを襲って、それを殺した。"},{"ref":"Judg.9.45","start":7009045,"end":7009045,"break":"none","ruby":[[8,1,"ひ"],[10,2,"しゅうじつ"],[13,1,"まち"],[15,1,"せ"],[21,1,"まち"],[23,1,"と"],[32,1,"たみ"],[34,1,"ころ"],[37,1,"まち"],[39,2,"はかい"],[44,1,"しお"]],"text":"アビメレクはその日、終日、町を攻め、ついに町を取って、そのうちの民を殺し、町を破壊して、塩をまいた。"},{"ref":"Judg.9.46","start":7009046,"end":7009046,"break":"paragraph","ruby":[[8,2,"ひとびと"],[11,1,"みな"],[15,1,"き"],[25,1,"みや"],[27,1,"とう"]],"text":"シケムのやぐらの人々は皆これを聞いて、エルベリテの宮の塔にはいった。"},{"ref":"Judg.9.47","start":7009047,"end":7009047,"break":"none","ruby":[[8,2,"ひとびと"],[11,1,"みな"],[12,1,"あつ"],[25,1,"きこ"]],"text":"シケムのやぐらの人々が皆集まったことがアビメレクに聞えたので、"},{"ref":"Judg.9.48","start":7009048,"end":7009048,"break":"none","ruby":[[6,2,"じぶん"],[9,2,"いっしょ"],[14,1,"たみ"],[21,1,"ひき"],[28,1,"さん"],[40,1,"て"],[45,1,"と"],[49,1,"き"],[51,1,"えだ"],[53,1,"き"],[55,1,"おと"],[61,1,"と"],[66,2,"じぶん"],[69,1,"かた"],[74,2,"いっしょ"],[79,1,"たみ"],[85,1,"い"],[105,1,"み"],[111,1,"いそ"]],"text":"アビメレクは自分と一緒にいた民をことごとく率いてザルモン山にのぼり、アビメレクは手におのを取って、木の枝を切り落し、それを取りあげて自分の肩にのせ、一緒にいた民にむかって言った、「あなたがたはわたしがしたことを見たとおりに急いでしなさい」。"},{"ref":"Judg.9.49","start":7009049,"end":7009049,"break":"none","ruby":[[3,1,"たみ"],[7,1,"みな"],[14,1,"えだ"],[16,1,"き"],[18,1,"おと"],[27,1,"したが"],[30,1,"い"],[34,1,"えだ"],[36,1,"とう"],[43,1,"とう"],[45,1,"ひ"],[50,1,"かれ"],[53,1,"せ"],[69,2,"ひとびと"],[79,1,"し"],[83,2,"だんじょ"],[91,1,"にん"]],"text":"そこで民もまた皆おのおのその枝を切り落し、アビメレクに従って行って、枝を塔によせかけ、塔に火をつけて彼らを攻めた。こうしてシケムのやぐらの人々もまたことごとく死んだ。男女おおよそ一千人であった。"},{"ref":"Judg.9.50","start":7009050,"end":7009050,"break":"paragraph","ruby":[[13,1,"い"],[20,1,"む"],[24,1,"じん"],[26,1,"は"],[32,1,"せ"],[34,1,"と"]],"text":"ついでアビメレクはテベツに行き、テベツに向かって陣を張り、これを攻め取ったが、"},{"ref":"Judg.9.51","start":7009051,"end":7009051,"break":"none","ruby":[[0,1,"まち"],[2,1,"なか"],[7,2,"けんご"],[22,2,"だんじょ"],[28,1,"まち"],[30,2,"ひとびと"],[33,1,"みな"],[37,1,"に"],[39,1,"こ"],[45,1,"と"],[54,2,"やね"],[57,1,"のぼ"]],"text":"町の中に一つの堅固なやぐらがあって、すべての男女すなわち町の人々が皆そこに逃げ込み、あとを閉ざして、やぐらの屋根に上ったので、"},{"ref":"Judg.9.52","start":7009052,"end":7009052,"break":"none","ruby":[[13,1,"お"],[15,1,"よ"],[21,1,"せ"],[28,2,"いりぐち"],[31,1,"ちか"],[36,1,"ひ"],[41,1,"や"]],"text":"アビメレクはやぐらのもとに押し寄せてこれを攻め、やぐらの入口に近づいて、火をつけて焼こうとしたとき、"},{"ref":"Judg.9.53","start":7009053,"end":7009053,"break":"none","ruby":[[4,1,"おんな"],[12,1,"あたま"],[18,2,"うわいし"],[21,1,"な"],[27,1,"ず"],[28,2,"がいこつ"],[31,1,"くだ"]],"text":"ひとりの女がアビメレクの頭に、うすの上石を投げて、その頭骸骨を砕いた。"},{"ref":"Judg.9.54","start":7009054,"end":7009054,"break":"none","ruby":[[6,2,"じぶん"],[9,2,"ぶき"],[12,1,"も"],[14,2,"わかもの"],[17,1,"いそ"],[19,1,"よ"],[22,1,"い"],[31,1,"ぬ"],[38,1,"ころ"],[46,2,"ひとびと"],[54,1,"おんな"],[56,1,"ころ"],[63,1,"い"],[73,2,"わかもの"],[76,1,"かれ"],[78,1,"さ"],[80,1,"とお"],[85,1,"かれ"],[87,1,"し"]],"text":"アビメレクは自分の武器を持つ若者を急ぎ呼んで言った、「つるぎを抜いてわたしを殺せ。さもないと人々はわたしを、女に殺されたのだと言うであろう」。その若者が彼を刺し通したので彼は死んだ。"},{"ref":"Judg.9.55","start":7009055,"end":7009055,"break":"none","ruby":[[6,2,"ひとびと"],[15,1,"し"],[20,1,"み"],[27,1,"さ"],[30,1,"いえ"],[32,1,"かえ"]],"text":"イスラエルの人々はアビメレクの死んだのを見て、おのおの去って家に帰った。"},{"ref":"Judg.9.56","start":7009056,"end":7009056,"break":"none","ruby":[[5,1,"かみ"],[15,2,"きょうだい"],[19,1,"にん"],[21,1,"ころ"],[25,2,"じぶん"],[28,1,"ちち"],[30,1,"たい"],[33,1,"おか"],[36,1,"あく"],[38,1,"むく"]],"text":"このように神はアビメレクがその兄弟七十人を殺して、自分の父に対して犯した悪に報いられた。"},{"ref":"Judg.9.57","start":7009057,"end":7009057,"break":"none","ruby":[[2,1,"かみ"],[8,2,"ひとびと"],[15,1,"あく"],[17,1,"かれ"],[24,1,"むく"],[40,1,"こ"],[50,1,"かれ"],[53,1,"のぞ"]],"text":"また神はシケムの人々のすべての悪を彼らのこうべに報いられた。こうしてエルバアルの子ヨタムののろいが、彼らに臨んだのである。"}]