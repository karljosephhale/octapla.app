[{"ref":"Exod.11.1","start":2011001,"end":2011001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[22,1,"わざわい"],[33,1,"うえ"],[41,1,"のち"],[43,1,"かれ"],[55,1,"さ"],[64,1,"かれ"],[66,1,"さ"],[73,1,"かれ"],[91,1,"お"],[93,1,"だ"]],"text":"主はモーセに言われた、「わたしは、なお一つの災を、パロとエジプトの上にくだし、その後、彼はあなたがたをここから去らせるであろう。彼が去らせるとき、彼はあなたがたを、ことごとくここから追い出すであろう。"},{"ref":"Exod.11.2","start":2011002,"end":2011002,"break":"none","ruby":[[4,1,"たみ"],[6,1,"みみ"],[8,1,"かた"],[12,1,"おとこ"],[14,1,"となり"],[16,1,"おとこ"],[20,1,"おんな"],[22,1,"となり"],[24,1,"おんな"],[32,1,"ぎん"],[34,1,"かざ"],[37,1,"きん"],[39,1,"かざ"],[42,1,"こ"],[44,1,"もと"]],"text":"あなたは民の耳に語って、男は隣の男から、女は隣の女から、それぞれ銀の飾り、金の飾りを請い求めさせなさい」。"},{"ref":"Exod.11.3","start":2011003,"end":2011003,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"たみ"],[11,2,"こうい"],[14,1,"え"],[28,1,"ひと"],[36,1,"くに"],[42,2,"けらい"],[47,1,"め"],[49,1,"たみ"],[51,1,"め"],[59,1,"おお"],[66,1,"み"]],"text":"主は民にエジプトびとの好意を得させられた。またモーセその人は、エジプトの国で、パロの家来たちの目と民の目とに、はなはだ大いなるものと見えた。"},{"ref":"Exod.11.4","start":2011004,"end":2011004,"break":"paragraph","ruby":[[4,1,"い"],[9,1,"しゅ"],[13,1,"おお"],[20,3,"まよなか"],[35,1,"なか"],[37,1,"で"],[39,1,"い"]],"text":"モーセは言った、「主はこう仰せられる、『真夜中ごろ、わたしはエジプトの中へ出て行くであろう。"},{"ref":"Exod.11.5","start":2011005,"end":2011005,"break":"none","ruby":[[5,1,"くに"],[15,1,"くらい"],[17,1,"ざ"],[36,1,"のち"],[50,1,"いた"],[57,1,"し"],[62,2,"かちく"],[71,1,"し"]],"text":"エジプトの国のうちのういごは、位に座するパロのういごをはじめ、ひきうすの後にいる、はしためのういごに至るまで、みな死に、また家畜のういごもみな死ぬであろう。"},{"ref":"Exod.11.6","start":2011006,"end":2011006,"break":"none","ruby":[[7,2,"ぜんこく"],[10,1,"おお"],[14,1,"さけ"],[17,1,"おこ"]],"text":"そしてエジプト全国に大いなる叫びが起るであろう。このようなことはかつてなく、また、ふたたびないであろう』と。"},{"ref":"Exod.11.7","start":2011007,"end":2011007,"break":"none","ruby":[[14,2,"ひとびと"],[23,1,"ひと"],[31,1,"けもの"],[39,1,"いぬ"],[44,1,"した"],[46,1,"な"],[62,1,"しゅ"],[80,1,"あいだ"],[82,2,"くべつ"],[97,1,"し"]],"text":"しかし、すべて、イスラエルの人々にむかっては、人にむかっても、獣にむかっても、犬さえその舌を鳴らさないであろう。これによって主がエジプトびととイスラエルびととの間の区別をされるのを、あなたがたは知るであろう。"},{"ref":"Exod.11.8","start":2011008,"end":2011008,"break":"none","ruby":[[8,2,"けらい"],[24,1,"くだ"],[32,1,"ふ"],[35,1,"い"],[51,1,"したが"],[53,1,"たみ"],[57,1,"で"],[59,1,"い"],[71,1,"のち"],[77,1,"で"],[79,1,"い"],[85,1,"かれ"],[87,1,"はげ"],[90,1,"いか"],[100,1,"で"],[102,1,"い"]],"text":"これらのあなたの家来たちは、みな、わたしのもとに下ってきて、ひれ伏して言うであろう、『あなたもあなたに従う民もみな出て行ってください』と。その後、わたしは出て行きます」。彼は激しく怒ってパロのもとから出て行った。"},{"ref":"Exod.11.9","start":2011009,"end":2011009,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[21,1,"い"],[26,1,"き"],[49,1,"くに"],[51,3,"ふしぎ"],[55,1,"ま"],[57,1,"くわ"]],"text":"主はモーセに言われた、「パロはあなたがたの言うことを聞かないであろう。それゆえ、わたしはエジプトの国に不思議を増し加えるであろう」。"},{"ref":"Exod.11.10","start":2011010,"end":2011010,"break":"paragraph","ruby":[[16,3,"ふしぎ"],[23,1,"まえ"],[25,1,"い"],[30,1,"しゅ"],[35,1,"こころ"],[48,1,"かれ"],[56,2,"ひとびと"],[61,1,"くに"],[64,1,"さ"]],"text":"モーセとアロンは、すべてこれらの不思議をパロの前に行ったが、主がパロの心をかたくなにされたので、彼はイスラエルの人々をその国から去らせなかった。"}]