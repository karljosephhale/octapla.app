[{"ref":"Ps.115.1","start":19115001,"end":19115001,"break":"paragraph","breaks":[[6,"line"],[24,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[3,2,"えいこう"],[48,1,"な"],[52,1,"き"]],"text":"主よ、栄光をわれらにではなく、われらにではなく、あなたのいつくしみと、まこととのゆえに、ただ、み名にのみ帰してください。"},{"ref":"Ps.115.2","start":19115002,"end":19115002,"break":"line","breaks":[[21,"line"]],"ruby":[[10,2,"くにたみ"],[13,1,"い"],[22,1,"かれ"],[25,1,"かみ"]],"text":"なにゆえ、もろもろの国民は言うのでしょう、「彼らの神はどこにいるのか」と。"},{"ref":"Ps.115.3","start":19115003,"end":19115003,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"かみ"],[6,1,"てん"],[15,1,"かみ"],[29,1,"こと"],[31,1,"おこな"]],"text":"われらの神は天にいらせられる。神はみこころにかなうすべての事を行われる。"},{"ref":"Ps.115.4","start":19115004,"end":19115004,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,2,"ぐうぞう"],[17,1,"ひと"],[19,1,"て"]],"text":"彼らの偶像はしろがねと、こがねで、人の手のわざである。"},{"ref":"Ps.115.5","start":19115005,"end":19115005,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"くち"],[9,1,"かた"],[19,1,"め"],[25,1,"み"]],"text":"それは口があっても語ることができない。目があっても見ることができない。"},{"ref":"Ps.115.6","start":19115006,"end":19115006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"みみ"],[6,1,"き"],[16,1,"はな"]],"text":"耳があっても聞くことができない。鼻があってもかぐことができない。"},{"ref":"Ps.115.7","start":19115007,"end":19115007,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[0,1,"て"],[6,1,"と"],[16,1,"あし"],[22,1,"ある"],[39,1,"こえ"],[41,1,"だ"]],"text":"手があっても取ることができない。足があっても歩くことができない。また、のどから声を出すこともできない。"},{"ref":"Ps.115.8","start":19115008,"end":19115008,"break":"line","breaks":[[21,"line"]],"ruby":[[3,1,"つく"],[5,1,"もの"],[11,2,"しんらい"],[15,1,"もの"],[24,1,"ひと"],[27,1,"もの"]],"text":"これを造る者と、これに信頼する者とはみな、これと等しい者になる。"},{"ref":"Ps.115.9","start":19115009,"end":19115009,"break":"line","breaks":[[14,"line"]],"ruby":[[7,1,"しゅ"],[9,2,"しんらい"],[14,1,"しゅ"],[16,1,"かれ"],[19,1,"たす"],[24,1,"かれ"],[27,1,"たて"]],"text":"イスラエルよ、主に信頼せよ。主は彼らの助け、また彼らの盾である。"},{"ref":"Ps.115.10","start":19115010,"end":19115010,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"いえ"],[7,1,"しゅ"],[9,2,"しんらい"],[14,1,"しゅ"],[16,1,"かれ"],[19,1,"たす"],[24,1,"かれ"],[27,1,"たて"]],"text":"アロンの家よ、主に信頼せよ。主は彼らの助け、また彼らの盾である。"},{"ref":"Ps.115.11","start":19115011,"end":19115011,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[5,1,"もの"],[8,1,"しゅ"],[10,2,"しんらい"],[15,1,"しゅ"],[17,1,"かれ"],[20,1,"たす"],[25,1,"かれ"],[28,1,"たて"]],"text":"主を恐れる者よ、主に信頼せよ。主は彼らの助け、また彼らの盾である。"},{"ref":"Ps.115.12","start":19115012,"end":19115012,"break":"line","breaks":[[17,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[17,1,"しゅ"],[23,1,"めぐ"],[32,1,"いえ"],[34,1,"めぐ"],[41,1,"いえ"],[43,1,"めぐ"]],"text":"主はわれらをみこころにとめられた。主はわれらを恵み、イスラエルの家を恵み、アロンの家を恵み、"},{"ref":"Ps.115.13","start":19115013,"end":19115013,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"ちい"],[6,1,"もの"],[9,1,"おお"],[13,1,"もの"],[16,1,"しゅ"],[18,1,"おそ"],[21,1,"もの"],[23,1,"めぐ"]],"text":"また、小さい者も、大いなる者も、主を恐れる者を恵まれる。"},{"ref":"Ps.115.14","start":19115014,"end":19115014,"break":"line","breaks":[[17,"line"],[34,"line"]],"ruby":[[4,1,"しゅ"],[12,1,"ま"],[14,1,"くわ"],[30,2,"しそん"],[34,1,"ま"],[36,1,"くわ"]],"text":"どうか、主があなたがたを増し加え、あなたがたと、あなたがたの子孫とを増し加えられるように。"},{"ref":"Ps.115.15","start":19115015,"end":19115015,"break":"line","breaks":[[12,"line"]],"ruby":[[0,2,"てんち"],[3,1,"つく"],[7,1,"しゅ"],[18,1,"めぐ"]],"text":"天地を造られた主によってあなたがたが恵まれるように。"},{"ref":"Ps.115.16","start":19115016,"end":19115016,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"てん"],[2,1,"しゅ"],[4,1,"てん"],[12,1,"ち"],[14,1,"ひと"],[16,1,"こ"],[19,1,"あた"]],"text":"天は主の天である。しかし地は人の子らに与えられた。"},{"ref":"Ps.115.17","start":19115017,"end":19115017,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"し"],[3,1,"もの"],[6,1,"おと"],[9,1,"ところ"],[11,1,"くだ"],[13,1,"もの"],[16,1,"しゅ"]],"text":"死んだ者も、音なき所に下る者も、主をほめたたえることはない。"},{"ref":"Ps.115.18","start":19115018,"end":19115018,"break":"line","breaks":[[22,"line"],[34,"line"]],"ruby":[[8,1,"いま"],[17,1,"いた"],[22,1,"しゅ"],[34,1,"しゅ"]],"text":"しかし、われらは今より、とこしえに至るまで、主をほめまつるであろう。主をほめたたえよ。"}]