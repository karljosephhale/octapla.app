[{"ref":"1John.4.1","start":62004001,"end":62004001,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[12,1,"れい"],[14,1,"しん"],[29,1,"れい"],[31,1,"かみ"],[34,1,"で"],[53,1,"おお"],[58,3,"よげんしゃ"],[62,1,"よ"],[64,1,"で"]],"text":"愛する者たちよ。すべての霊を信じることはしないで、それらの霊が神から出たものであるかどうか、ためしなさい。多くのにせ預言者が世に出てきているからである。"},{"ref":"1John.4.2","start":62004002,"end":62004002,"break":"none","ruby":[[11,1,"かみ"],[13,1,"れい"],[15,1,"し"],[36,2,"にくたい"],[49,2,"こくはく"],[53,1,"れい"],[59,1,"かみ"],[62,1,"で"]],"text":"あなたがたは、こうして神の霊を知るのである。すなわち、イエス・キリストが肉体をとってこられたことを告白する霊は、すべて神から出ているものであり、"},{"ref":"1John.4.3","start":62004003,"end":62004003,"break":"none","ruby":[[4,2,"こくはく"],[9,1,"れい"],[15,1,"かみ"],[18,1,"で"],[33,1,"はん"],[39,1,"れい"],[54,1,"く"],[60,1,"き"],[67,1,"いま"],[72,1,"よ"]],"text":"イエスを告白しない霊は、すべて神から出ているものではない。これは、反キリストの霊である。あなたがたは、それが来るとかねて聞いていたが、今やすでに世にきている。"},{"ref":"1John.4.4","start":62004004,"end":62004004,"break":"none","ruby":[[0,1,"こ"],[11,1,"かみ"],[14,1,"で"],[16,1,"もの"],[22,1,"かれ"],[27,1,"か"],[50,1,"よ"],[54,1,"もの"],[58,1,"おお"],[62,1,"もの"]],"text":"子たちよ。あなたがたは神から出た者であって、彼らにうち勝ったのである。あなたがたのうちにいますのは、世にある者よりも大いなる者なのである。"},{"ref":"1John.4.5","start":62004005,"end":62004005,"break":"none","ruby":[[0,1,"かれ"],[3,1,"よ"],[6,1,"で"],[18,1,"かれ"],[21,1,"よ"],[26,1,"かた"],[29,1,"よ"],[31,1,"かれ"],[34,1,"い"],[39,1,"き"]],"text":"彼らは世から出たものである。だから、彼らは世のことを語り、世も彼らの言うことを聞くのである。"},{"ref":"1John.4.6","start":62004006,"end":62004006,"break":"none","ruby":[[10,1,"かみ"],[13,1,"で"],[21,1,"かみ"],[23,1,"し"],[28,1,"もの"],[37,1,"い"],[42,1,"き"],[45,1,"かみ"],[48,1,"で"],[51,1,"もの"],[60,1,"い"],[65,1,"き"],[84,2,"しんり"],[87,1,"れい"],[89,1,"まよ"],[92,1,"れい"],[95,2,"くべつ"],[98,1,"し"]],"text":"しかし、わたしたちは神から出たものである。神を知っている者は、わたしたちの言うことを聞き、神から出ない者は、わたしたちの言うことを聞かない。これによって、わたしたちは、真理の霊と迷いの霊との区別を知るのである。"},{"ref":"1John.4.7","start":62004007,"end":62004007,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[14,1,"たがい"],[16,1,"あい"],[27,1,"あい"],[30,1,"かみ"],[33,1,"で"],[46,1,"あい"],[49,1,"もの"],[52,1,"かみ"],[55,1,"うま"],[58,1,"もの"],[64,1,"かみ"],[66,1,"し"]],"text":"愛する者たちよ。わたしたちは互に愛し合おうではないか。愛は、神から出たものなのである。すべて愛する者は、神から生れた者であって、神を知っている。"},{"ref":"1John.4.8","start":62004008,"end":62004008,"break":"none","ruby":[[0,1,"あい"],[4,1,"もの"],[7,1,"かみ"],[9,1,"し"],[14,1,"かみ"],[16,1,"あい"]],"text":"愛さない者は、神を知らない。神は愛である。"},{"ref":"1John.4.9","start":62004009,"end":62004009,"break":"none","ruby":[[0,1,"かみ"],[7,1,"こ"],[9,1,"よ"],[16,1,"かれ"],[27,1,"い"],[35,1,"くだ"],[53,1,"たい"],[56,1,"かみ"],[58,1,"あい"],[60,1,"あき"]],"text":"神はそのひとり子を世につかわし、彼によってわたしたちを生きるようにして下さった。それによって、わたしたちに対する神の愛が明らかにされたのである。"},{"ref":"1John.4.10","start":62004010,"end":62004010,"break":"none","ruby":[[6,1,"かみ"],[8,1,"あい"],[17,1,"かみ"],[25,1,"あい"],[28,1,"くだ"],[39,1,"つみ"],[49,1,"そな"],[51,1,"もの"],[56,2,"みこ"],[72,1,"あい"]],"text":"わたしたちが神を愛したのではなく、神がわたしたちを愛して下さって、わたしたちの罪のためにあがないの供え物として、御子をおつかわしになった。ここに愛がある。"},{"ref":"1John.4.11","start":62004011,"end":62004011,"break":"none","ruby":[[0,1,"あい"],[3,1,"もの"],[8,1,"かみ"],[21,1,"あい"],[24,1,"くだ"],[41,1,"たがい"],[43,1,"あい"],[45,1,"あ"]],"text":"愛する者たちよ。神がこのようにわたしたちを愛して下さったのであるから、わたしたちも互に愛し合うべきである。"},{"ref":"1John.4.12","start":62004012,"end":62004012,"break":"none","ruby":[[0,1,"かみ"],[2,1,"み"],[4,1,"もの"],[25,1,"たがい"],[27,1,"あい"],[29,1,"あ"],[34,1,"かみ"],[49,1,"かみ"],[51,1,"あい"],[62,1,"まっと"]],"text":"神を見た者は、まだひとりもいない。もしわたしたちが互に愛し合うなら、神はわたしたちのうちにいまし、神の愛がわたしたちのうちに全うされるのである。"},{"ref":"1John.4.13","start":62004013,"end":62004013,"break":"paragraph","ruby":[[0,1,"かみ"],[2,2,"みたま"],[11,1,"たま"],[28,1,"かみ"],[33,1,"かみ"],[47,1,"し"]],"text":"神が御霊をわたしたちに賜わったことによって、わたしたちが神におり、神がわたしたちにいますことを知る。"},{"ref":"1John.4.14","start":62004014,"end":62004014,"break":"none","ruby":[[7,1,"ちち"],[9,2,"みこ"],[12,1,"よ"],[14,2,"すくいぬし"],[30,1,"み"]],"text":"わたしたちは、父が御子を世の救主としておつかわしになったのを見て、そのあかしをするのである。"},{"ref":"1John.4.15","start":62004015,"end":62004015,"break":"none","ruby":[[2,1,"ひと"],[9,1,"かみ"],[11,1,"こ"],[13,2,"こくはく"],[19,1,"かみ"],[23,1,"ひと"],[34,1,"ひと"],[36,1,"かみ"]],"text":"もし人が、イエスを神の子と告白すれば、神はその人のうちにいまし、その人は神のうちにいるのである。"},{"ref":"1John.4.16","start":62004016,"end":62004016,"break":"none","ruby":[[7,1,"かみ"],[15,1,"たい"],[18,1,"も"],[25,1,"あい"],[27,1,"し"],[32,1,"しん"],[38,1,"かみ"],[40,1,"あい"],[45,1,"あい"],[52,1,"もの"],[55,1,"かみ"],[60,1,"かみ"],[62,1,"かれ"]],"text":"わたしたちは、神がわたしたちに対して持っておられる愛を知り、かつ信じている。神は愛である。愛のうちにいる者は、神におり、神も彼にいます。"},{"ref":"1John.4.17","start":62004017,"end":62004017,"break":"none","ruby":[[8,1,"よ"],[13,1,"かれ"],[18,1,"い"],[30,1,"ひ"],[32,2,"かくしん"],[35,1,"も"],[38,1,"た"],[56,1,"あい"],[64,1,"まっと"]],"text":"わたしたちもこの世にあって彼のように生きているので、さばきの日に確信を持って立つことができる。そのことによって、愛がわたしたちに全うされているのである。"},{"ref":"1John.4.18","start":62004018,"end":62004018,"break":"none","ruby":[[0,1,"あい"],[3,1,"おそ"],[9,2,"かんぜん"],[12,1,"あい"],[14,1,"おそ"],[19,1,"のぞ"],[22,1,"おそ"],[26,1,"こ"],[36,1,"おそ"],[39,1,"もの"],[43,1,"あい"],[45,1,"まっと"]],"text":"愛には恐れがない。完全な愛は恐れをとり除く。恐れには懲らしめが伴い、かつ恐れる者には、愛が全うされていないからである。"},{"ref":"1John.4.19","start":62004019,"end":62004019,"break":"none","ruby":[[6,1,"あい"],[8,1,"あ"],[13,1,"かみ"],[23,1,"あい"],[26,1,"くだ"]],"text":"わたしたちが愛し合うのは、神がまずわたしたちを愛して下さったからである。"},{"ref":"1John.4.20","start":62004020,"end":62004020,"break":"none","ruby":[[1,1,"かみ"],[3,1,"あい"],[10,1,"い"],[15,2,"きょうだい"],[18,1,"にく"],[20,1,"もの"],[23,1,"いつわ"],[25,1,"もの"],[30,1,"げん"],[32,1,"み"],[36,2,"きょうだい"],[39,1,"あい"],[43,1,"もの"],[46,1,"め"],[48,1,"み"],[52,1,"かみ"],[54,1,"あい"]],"text":"「神を愛している」と言いながら兄弟を憎む者は、偽り者である。現に見ている兄弟を愛さない者は、目に見えない神を愛することはできない。"},{"ref":"1John.4.21","start":62004021,"end":62004021,"break":"none","ruby":[[0,1,"かみ"],[2,1,"あい"],[5,1,"もの"],[8,2,"きょうだい"],[12,1,"あい"],[22,1,"いまし"],[32,1,"かみ"],[35,1,"さず"]],"text":"神を愛する者は、兄弟をも愛すべきである。この戒めを、わたしたちは神から授かっている。"}]