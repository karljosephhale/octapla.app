[{"ref":"1Chr.20.1","start":13020001,"end":13020001,"break":"paragraph","ruby":[[0,1,"はる"],[6,1,"おう"],[10,1,"たたか"],[13,1,"で"],[16,1,"およ"],[24,2,"ぐんぜい"],[27,1,"ひき"],[37,1,"ち"],[39,1,"あら"],[42,1,"い"],[48,2,"ほうい"],[79,1,"う"],[86,1,"ほろ"]],"text":"春になって、王たちが戦いに出るに及んで、ヨアブは軍勢を率いてアンモンびとの地を荒し、行ってラバを包囲した。しかしダビデはエルサレムにとどまった。ヨアブはラバを撃って、これを滅ぼした。"},{"ref":"1Chr.20.2","start":13020002,"end":13020002,"break":"none","ruby":[[7,1,"かれ"],[10,1,"おう"],[12,1,"かんむり"],[16,1,"あたま"],[19,1,"と"],[28,1,"きん"],[30,1,"おも"],[33,1,"はか"],[49,1,"なか"],[51,2,"ほうせき"],[65,1,"あたま"],[67,1,"お"],[79,1,"まち"],[85,1,"もの"],[87,2,"ひじょう"],[90,1,"おお"],[92,1,"も"],[94,1,"だ"]],"text":"そしてダビデは彼らの王の冠をその頭から取りはなした。その金の重さを量ってみると一タラント、またその中に宝石があった。これをダビデの頭に置いた。ダビデはまたその町のぶんどり物を非常に多く持ち出した。"},{"ref":"1Chr.20.3","start":13020003,"end":13020003,"break":"none","ruby":[[2,1,"かれ"],[9,1,"たみ"],[11,1,"ひ"],[13,1,"だ"],[26,1,"てつ"],[37,1,"つか"],[39,2,"しごと"],[62,2,"まちまち"],[70,1,"い"],[81,1,"たみ"],[84,1,"みな"],[91,1,"かえ"]],"text":"また彼はそのうちの民を引き出して、これをのこぎりと、鉄のつるはしと、おのを使う仕事につかせた。ダビデはアンモンびとのすべての町々にこのように行った。そしてダビデと民とは皆エルサレムに帰った。"},{"ref":"1Chr.20.4","start":13020004,"end":13020004,"break":"paragraph","ruby":[[2,1,"のち"],[14,1,"たたか"],[17,1,"た"],[23,1,"とき"],[34,2,"きょじん"],[37,2,"しそん"],[47,1,"ころ"],[58,2,"せいふく"]],"text":"この後ゲゼルでペリシテびとと戦いが起った。その時ホシャびとシベカイが巨人の子孫のひとりシパイを殺した。かれらはついに征服された。"},{"ref":"1Chr.20.5","start":13020005,"end":13020005,"break":"none","ruby":[[12,1,"たたか"],[24,1,"こ"],[40,2,"きょうだい"],[45,1,"ころ"],[54,1,"え"],[56,1,"はた"],[58,2,"まきぼう"]],"text":"ここにまたペリシテびとと戦いがあったが、ヤイルの子エルハナンはガテびとゴリアテの兄弟ラミを殺した。そのやりの柄は機の巻棒のようであった。"},{"ref":"1Chr.20.6","start":13020006,"end":13020006,"break":"none","ruby":[[5,1,"たたか"],[20,1,"せ"],[22,1,"たか"],[24,1,"ひと"],[31,1,"て"],[33,1,"ゆび"],[35,1,"あし"],[37,1,"ゆび"],[40,1,"ぽん"],[45,1,"あ"],[52,1,"ほん"],[57,1,"かれ"],[61,2,"きょじん"],[65,1,"うま"],[68,1,"もの"]],"text":"またガテに戦いがあったが、そこにひとりの背の高い人がいた。その手の指と足の指は六本ずつで、合わせて二十四本あった。彼もまた巨人から生れた者であった。"},{"ref":"1Chr.20.7","start":13020007,"end":13020007,"break":"none","ruby":[[0,1,"かれ"],[20,2,"きょうだい"],[26,1,"こ"],[35,1,"ころ"]],"text":"彼はイスラエルをののしったので、ダビデの兄弟シメアの子ヨナタンがこれを殺した。"},{"ref":"1Chr.20.8","start":13020008,"end":13020008,"break":"none","ruby":[[7,2,"きょじん"],[11,1,"うま"],[14,1,"もの"],[25,1,"て"],[29,2,"けらい"],[34,1,"て"],[36,1,"たお"]],"text":"これらはガテで巨人から生れた者であったが、ダビデの手とその家来たちの手に倒れた。"}]