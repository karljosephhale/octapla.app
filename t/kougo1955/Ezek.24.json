[{"ref":"Ezek.24.1","start":26024001,"end":26024001,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"ねん"],[5,1,"がつ"],[7,1,"か"],[10,1,"しゅ"],[12,2,"ことば"],[19,1,"のぞ"]],"text":"第九年の十月十日に、主の言葉がわたしに臨んだ、"},{"ref":"Ezek.24.2","start":26024002,"end":26024002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[12,1,"ひ"],[17,2,"こんにち"],[20,1,"な"],[22,1,"か"],[33,1,"おう"],[38,1,"ひ"],[45,2,"ほうい"]],"text":"「人の子よ、あなたはこの日すなわち今日の名を書きしるせ。バビロンの王は、この日エルサレムを包囲した。"},{"ref":"Ezek.24.3","start":26024003,"end":26024003,"break":"none","breaks":[[33,"stanza"]],"ruby":[[6,2,"はんぎゃく"],[9,1,"いえ"],[15,1,"かた"],[18,1,"い"],[21,1,"しゅ"],[24,1,"かみ"],[28,1,"い"],[47,1,"みず"],[51,1,"い"]],"text":"あなたはこの反逆の家にたとえを語って言え。主なる神はこう言われる、かますをすえ、これをすえて、水をくみ入れよ。"},{"ref":"Ezek.24.4","start":26024004,"end":26024004,"break":"line","breaks":[[13,"line"],[23,"line"],[42,"line"]],"ruby":[[2,1,"なか"],[4,1,"にく"],[6,1,"き"],[9,1,"い"],[16,1,"よ"],[18,1,"にく"],[20,1,"き"],[31,1,"かた"],[33,1,"にく"],[38,1,"い"],[42,1,"よ"],[44,1,"ほね"],[49,1,"み"]],"text":"その中に肉の切れを入れよ、すべて良い肉の切れ、すなわち、ももと肩の肉をこれに入れよ。良い骨をこれに満たせ。"},{"ref":"Ezek.24.5","start":26024005,"end":26024005,"break":"line","breaks":[[12,"line"],[23,"line"]],"ruby":[[0,1,"ひつじ"],[2,1,"もっと"],[4,1,"よ"],[9,1,"と"],[15,1,"した"],[20,1,"つ"],[25,1,"にく"],[27,1,"に"],[37,1,"なか"],[39,1,"ほね"],[41,1,"に"]],"text":"羊の最も良いものを取れ。かまの下にまきを積み、その肉を煮たぎらせ、またその中の骨を煮よ。"},{"ref":"Ezek.24.6","start":26024006,"end":26024006,"break":"paragraph","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[26,2,"りゅうけつ"],[29,1,"まち"],[47,1,"はな"],[52,1,"にく"],[60,3,"むさべつ"],[64,1,"と"],[66,1,"だ"]],"text":"それゆえ、主なる神はこう言われる、わざわいなるかな、流血の町、さびているかま。そのさびはこれを離れない。肉をひとつびとつ無差別に取り出せ。"},{"ref":"Ezek.24.7","start":26024007,"end":26024007,"break":"none","ruby":[[2,1,"なが"],[5,1,"ち"],[11,1,"なか"],[16,2,"かのじょ"],[22,1,"はだか"],[23,1,"いわ"],[25,1,"うえ"],[27,1,"なが"],[30,1,"つち"],[42,2,"じめん"],[46,1,"そそ"]],"text":"その流した血はまだその中にある。彼女はこれを裸岩の上に流し、土でこれをおおうために、地面には注がなかった。"},{"ref":"Ezek.24.8","start":26024008,"end":26024008,"break":"none","ruby":[[8,1,"いか"],[19,1,"かえ"],[27,1,"なが"],[30,1,"ち"],[42,1,"はだか"],[43,1,"いわ"],[45,1,"うえ"],[47,1,"なが"]],"text":"これは、わたしの怒りをつのらせ、あだを返すために、その流した血がおおわれないように、裸岩の上に流したのである。"},{"ref":"Ezek.24.9","start":26024009,"end":26024009,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[26,2,"りゅうけつ"],[29,1,"まち"],[44,1,"つ"],[46,1,"かさ"]],"text":"それゆえ、主なる神はこう言われる、わざわいなるかな、流血の町。わたしもまた、まきをさらに積み重ねる。"},{"ref":"Ezek.24.10","start":26024010,"end":26024010,"break":"none","ruby":[[3,1,"つ"],[5,1,"かさ"],[8,1,"ひ"],[10,1,"も"],[14,1,"にく"],[18,1,"に"],[21,1,"に"],[26,1,"ほね"],[28,1,"や"]],"text":"まきを積み重ね、火を燃やし、肉をよく煮て、煮つくし、骨を焼け。"},{"ref":"Ezek.24.11","start":26024011,"end":26024011,"break":"none","ruby":[[6,1,"あつ"],[21,2,"すみび"],[24,1,"うえ"],[26,1,"お"],[31,1,"どう"],[33,1,"や"],[37,1,"けが"],[42,1,"なか"],[44,1,"と"],[53,1,"さ"]],"text":"そしてかまを熱くするため、それをからにして炭火の上に置き、その銅を焼いて、汚れをその中に溶かし、そのさびを去れ。"},{"ref":"Ezek.24.12","start":26024012,"end":26024012,"break":"none","ruby":[[22,1,"おお"],[28,1,"ひ"],[33,1,"き"]],"text":"しかしわたしのほねおりは、むだであった。その多くのさびは火によって消えない。"},{"ref":"Ezek.24.13","start":26024013,"end":26024013,"break":"none","ruby":[[11,2,"ふけつ"],[14,2,"いんこう"],[28,1,"きよ"],[45,2,"ふけつ"],[49,1,"きよ"],[66,1,"いか"],[73,1,"も"],[76,1,"つく"],[86,1,"けが"],[90,1,"きよ"]],"text":"そのさびとは、あなたの不潔な淫行である。わたしはあなたを清めようとしたが、あなたはあなたの不潔から清められようとしないから、わたしの怒りをあなたに漏らし尽すまでは、あなたは汚れから清まることはない。"},{"ref":"Ezek.24.14","start":26024014,"end":26024014,"break":"none","ruby":[[0,1,"しゅ"],[10,1,"い"],[20,1,"かなら"],[22,1,"な"],[44,1,"お"],[50,1,"く"],[87,1,"しゅ"],[90,1,"かみ"],[92,1,"い"]],"text":"主なるわたしはこれを言った。そしてこれは必ず成る。わたしはこれをなす。わたしはやめない、惜しまない、悔いない。あなたのおこないにより、あなたのわざによって、あなたをさばくと、主なる神は言われる」。"},{"ref":"Ezek.24.15","start":26024015,"end":26024015,"break":"paragraph","ruby":[[2,1,"しゅ"],[4,2,"ことば"],[11,1,"のぞ"]],"text":"また主の言葉がわたしに臨んだ、"},{"ref":"Ezek.24.16","start":26024016,"end":26024016,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[6,1,"み"],[22,1,"め"],[24,1,"よろこ"],[26,1,"もの"],[28,1,"と"],[30,1,"さ"],[33,1,"なげ"],[42,1,"な"],[51,1,"なみだ"],[53,1,"なが"]],"text":"「人の子よ、見よ、わたしは、にわかにあなたの目の喜ぶ者を取り去る。嘆いてはならない。泣いてはならない。涙を流してはならない。"},{"ref":"Ezek.24.17","start":26024017,"end":26024017,"break":"none","ruby":[[0,1,"こえ"],[6,1,"なげ"],[9,2,"しにん"],[15,1,"なげ"],[17,1,"かな"],[30,1,"あし"],[38,1,"くち"],[45,1,"なげ"],[51,1,"た"]],"text":"声をたてずに嘆け。死人のために嘆き悲しむな。ずきんをかぶり、足にくつをはけ。口をおおうな。嘆きのパンを食べるな」。"},{"ref":"Ezek.24.18","start":26024018,"end":26024018,"break":"none","ruby":[[0,1,"あさ"],[10,2,"ひとびと"],[13,1,"かた"],[18,1,"ゆう"],[27,1,"つま"],[29,1,"し"],[33,2,"よくあさ"],[39,1,"めい"]],"text":"朝のうちに、わたしは人々に語ったが、夕べには、わたしの妻は死んだ。翌朝わたしは命じられたようにした。"},{"ref":"Ezek.24.19","start":26024019,"end":26024019,"break":"paragraph","ruby":[[0,2,"ひとびと"],[7,1,"い"],[20,1,"こと"],[31,2,"かんけい"],[47,1,"つ"]],"text":"人々はわたしに言った、「あなたがするこの事は、われわれになんの関係があるのか、それをわれわれに告げてはくれまいか」。"},{"ref":"Ezek.24.20","start":26024020,"end":26024020,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[12,1,"しゅ"],[14,2,"ことば"],[21,1,"のぞ"]],"text":"わたしは彼らに言った、「主の言葉がわたしに臨んだ、"},{"ref":"Ezek.24.21","start":26024021,"end":26024021,"break":"none","ruby":[[7,1,"いえ"],[9,1,"い"],[12,1,"しゅ"],[15,1,"かみ"],[19,1,"い"],[24,1,"み"],[37,1,"ちから"],[39,1,"ほこり"],[41,1,"め"],[43,1,"よろこ"],[46,1,"こころ"],[48,1,"のぞ"],[55,2,"せいじょ"],[58,1,"けが"],[67,1,"のこ"],[72,1,"むすめ"],[81,1,"たお"]],"text":"『イスラエルの家に言え、主なる神はこう言われる、見よ、わたしはあなたがたの力の誇、目の喜び、心の望みであるわが聖所を汚す。あなたがたが残すむすこ娘たちは、つるぎに倒れる。"},{"ref":"Ezek.24.22","start":26024022,"end":26024022,"break":"none","ruby":[[17,1,"くち"],[24,1,"なげ"],[30,1,"た"]],"text":"あなたがたもわたしがしたようにし、口をおおわず、嘆きのパンを食べず、"},{"ref":"Ezek.24.23","start":26024023,"end":26024023,"break":"none","ruby":[[0,1,"あたま"],[10,1,"あし"],[18,1,"なげ"],[22,1,"な"],[28,1,"つみ"],[30,1,"なか"],[34,1,"おとろ"],[38,1,"たがい"]],"text":"頭にずきんをかぶり、足にくつをはき、嘆かず、泣かず、その罪の中にやせ衰えて、互にうめくようになる。"},{"ref":"Ezek.24.24","start":26024024,"end":26024024,"break":"none","ruby":[[27,1,"かれ"],[45,1,"こと"],[47,1,"な"],[49,1,"とき"],[61,1,"しゅ"],[64,1,"かみ"],[71,1,"し"]],"text":"このようにエゼキエルはあなたがたのためにしるしとなる。彼がしたようにあなたがたもせよ。この事が成る時、あなたがたはわたしが主なる神であることを知るようになる』。"},{"ref":"Ezek.24.25","start":26024025,"end":26024025,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[10,1,"かれ"],[17,1,"かれ"],[20,1,"よろこ"],[23,1,"さか"],[26,1,"かれ"],[29,1,"め"],[31,1,"よろこ"],[39,1,"こころ"],[41,1,"のぞ"],[51,1,"かれ"],[57,1,"むすめ"],[61,1,"と"],[63,1,"さ"],[65,1,"ひ"]],"text":"人の子よ、わたしが、彼らのとりで、彼らの喜びと栄え、彼らの目の喜びであり、その心の望みであるもの、また彼らのむすこ娘たちを取り去る日、"},{"ref":"Ezek.24.26","start":26024026,"end":26024026,"break":"none","ruby":[[2,1,"ひ"],[4,1,"なん"],[10,1,"く"],[12,1,"もの"],[29,1,"こと"],[31,1,"つ"]],"text":"その日に難をのがれて来る者が、あなたのもとにきて、あなたに事を告げる。"},{"ref":"Ezek.24.27","start":26024027,"end":26024027,"break":"none","ruby":[[2,1,"ひ"],[16,1,"もの"],[18,1,"む"],[22,1,"くち"],[24,1,"ひら"],[27,1,"かた"],[33,2,"ちんもく"],[47,1,"かれ"],[60,1,"かれ"],[67,1,"しゅ"],[74,1,"し"]],"text":"その日あなたは、そののがれてきた者に向かって口を開き、語り、もはや沈黙しない。こうしてあなたは彼らのためにしるしとなり、彼らはわたしが主であることを知る」。"}]