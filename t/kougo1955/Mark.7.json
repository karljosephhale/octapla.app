[{"ref":"Mark.7.1","start":41007001,"end":41007001,"break":"paragraph","ruby":[[7,1,"びと"],[12,2,"りっぽう"],[14,2,"がくしゃ"],[38,1,"あつ"]],"text":"さて、パリサイ人と、ある律法学者たちとが、エルサレムからきて、イエスのもとに集まった。"},{"ref":"Mark.7.2","start":41007002,"end":41007002,"break":"none","ruby":[[3,2,"でし"],[12,2,"ふじょう"],[15,1,"て"],[21,1,"あら"],[25,1,"て"],[31,1,"た"],[36,1,"もの"],[42,1,"み"]],"text":"そして弟子たちのうちに、不浄な手、すなわち洗わない手で、パンを食べている者があるのを見た。"},{"ref":"Mark.7.3","start":41007003,"end":41007003,"break":"none","ruby":[[9,1,"びと"],[17,1,"じん"],[22,1,"むかし"],[24,1,"ひと"],[26,2,"いいつた"],[33,1,"まも"],[37,2,"ねんい"],[41,1,"て"],[43,1,"あら"],[53,2,"しょくじ"]],"text":"もともと、パリサイ人をはじめユダヤ人はみな、昔の人の言伝えをかたく守って、念入りに手を洗ってからでないと、食事をしない。"},{"ref":"Mark.7.4","start":41007004,"end":41007004,"break":"none","ruby":[[2,2,"いちば"],[6,1,"かえ"],[14,1,"み"],[16,1,"きよ"],[26,2,"しょくじ"],[41,1,"さかずき"],[43,1,"はち"],[45,2,"どうき"],[48,1,"あら"],[55,1,"むかし"],[58,1,"う"],[66,1,"まも"],[71,1,"こと"]],"text":"また市場から帰ったときには、身を清めてからでないと、食事をせず、なおそのほかにも、杯、鉢、銅器を洗うことなど、昔から受けついでかたく守っている事が、たくさんあった。"},{"ref":"Mark.7.5","start":41007005,"end":41007005,"break":"none","ruby":[[8,1,"びと"],[10,2,"りっぽう"],[12,2,"がくしゃ"],[23,1,"たず"],[35,2,"でし"],[41,1,"むかし"],[43,1,"ひと"],[45,2,"いいつた"],[49,1,"したが"],[52,1,"あゆ"],[58,2,"ふじょう"],[61,1,"て"],[66,1,"た"]],"text":"そこで、パリサイ人と律法学者たちとは、イエスに尋ねた、「なぜ、あなたの弟子たちは、昔の人の言伝えに従って歩まないで、不浄な手でパンを食べるのですか」。"},{"ref":"Mark.7.6","start":41007006,"end":41007006,"break":"none","breaks":[[49,"stanza"],[68,"line"]],"ruby":[[4,1,"い"],[20,3,"ぎぜんしゃ"],[30,1,"か"],[40,2,"てきせつ"],[43,2,"よげん"],[52,1,"たみ"],[55,1,"くち"],[64,1,"うやま"],[70,1,"こころ"],[77,1,"とお"],[79,1,"はな"]],"text":"イエスは言われた、「イザヤは、あなたがた偽善者について、こう書いているが、それは適切な預言である、『この民は、口さきではわたしを敬うが、その心はわたしから遠く離れている。"},{"ref":"Mark.7.7","start":41007007,"end":41007007,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"にんげん"],[8,1,"おしえ"],[12,1,"おし"],[15,3,"むいみ"],[23,1,"おが"]],"text":"人間のいましめを教として教え、無意味にわたしを拝んでいる』。"},{"ref":"Mark.7.8","start":41007008,"end":41007008,"break":"none","ruby":[[7,1,"かみ"],[20,2,"にんげん"],[23,2,"いいつた"],[27,2,"こしつ"]],"text":"あなたがたは、神のいましめをさしおいて、人間の言伝えを固執している」。"},{"ref":"Mark.7.9","start":41007009,"end":41007009,"break":"none","ruby":[[3,1,"い"],[16,2,"じぶん"],[21,2,"いいつた"],[25,1,"まも"],[34,1,"かみ"],[41,1,"す"]],"text":"また、言われた、「あなたがたは、自分たちの言伝えを守るために、よくも神のいましめを捨てたものだ。"},{"ref":"Mark.7.10","start":41007010,"end":41007010,"break":"none","ruby":[[4,1,"い"],[14,1,"ちち"],[16,1,"はは"],[19,1,"うやま"],[26,1,"ちち"],[30,1,"はは"],[36,1,"もの"],[39,1,"かなら"],[41,1,"し"],[43,1,"さだ"]],"text":"モーセは言ったではないか、『父と母とを敬え』、また『父または母をののしる者は、必ず死に定められる』と。"},{"ref":"Mark.7.11","start":41007011,"end":41007011,"break":"none","ruby":[[15,1,"ひと"],[17,1,"ちち"],[21,1,"はは"],[32,2,"さしあ"],[54,1,"そな"],[56,1,"もの"],[60,1,"い"]],"text":"それだのに、あなたがたは、もし人が父または母にむかって、あなたに差上げるはずのこのものはコルバン、すなわち、供え物ですと言えば、それでよいとして、"},{"ref":"Mark.7.12","start":41007012,"end":41007012,"break":"none","ruby":[[2,1,"ひと"],[4,2,"ふぼ"],[7,1,"たい"],[13,1,"なに"],[19,1,"す"],[24,1,"い"]],"text":"その人は父母に対して、もう何もしないで済むのだと言っている。"},{"ref":"Mark.7.13","start":41007013,"end":41007013,"break":"none","ruby":[[11,2,"じぶん"],[16,1,"う"],[21,2,"いいつた"],[29,1,"かみ"],[31,1,"ことば"],[33,1,"む"],[48,1,"こと"]],"text":"こうしてあなたがたは、自分たちが受けついだ言伝えによって、神の言を無にしている。また、このような事をしばしばおこなっている」。"},{"ref":"Mark.7.14","start":41007014,"end":41007014,"break":"none","ruby":[[9,1,"ふたた"],[11,2,"ぐんしゅう"],[14,1,"よ"],[16,1,"よ"],[19,1,"い"],[39,1,"い"],[44,1,"き"],[47,1,"さと"]],"text":"それから、イエスは再び群衆を呼び寄せて言われた、「あなたがたはみんな、わたしの言うことを聞いて悟るがよい。"},{"ref":"Mark.7.15","start":41007015,"end":41007015,"break":"none","ruby":[[3,1,"そと"],[6,1,"ひと"],[8,1,"なか"],[15,1,"ひと"],[33,1,"ひと"],[35,1,"なか"],[38,1,"で"],[46,1,"ひと"]],"text":"すべて外から人の中にはいって、人をけがしうるものはない。かえって、人の中から出てくるものが、人をけがすのである。〔"},{"ref":"Mark.7.16","start":41007016,"end":41007016,"break":"none","ruby":[[0,1,"き"],[2,1,"みみ"],[6,1,"もの"],[8,1,"き"]],"text":"聞く耳のある者は聞くがよい〕」。"},{"ref":"Mark.7.17","start":41007017,"end":41007017,"break":"paragraph","ruby":[[4,2,"ぐんしゅう"],[7,1,"はな"],[10,1,"いえ"],[19,2,"でし"],[26,1,"たとえ"],[31,1,"たず"]],"text":"イエスが群衆を離れて家にはいられると、弟子たちはこの譬について尋ねた。"},{"ref":"Mark.7.18","start":41007018,"end":41007018,"break":"none","ruby":[[4,1,"い"],[21,1,"にぶ"],[30,1,"そと"],[33,1,"ひと"],[35,1,"なか"],[41,1,"く"],[47,1,"ひと"],[49,1,"けが"],[51,1,"え"]],"text":"すると、言われた、「あなたがたも、そんなに鈍いのか。すべて、外から人の中にはいって来るものは、人を汚し得ないことが、わからないのか。"},{"ref":"Mark.7.19","start":41007019,"end":41007019,"break":"none","ruby":[[3,1,"ひと"],[5,1,"こころ"],[7,1,"なか"],[18,1,"はら"],[20,1,"うち"],[30,1,"そと"],[32,1,"で"],[34,1,"い"],[56,2,"しょくもつ"]],"text":"それは人の心の中にはいるのではなく、腹の中にはいり、そして、外に出て行くだけである」。イエスはこのように、どんな食物でもきよいものとされた。"},{"ref":"Mark.7.20","start":41007020,"end":41007020,"break":"none","ruby":[[3,1,"い"],[9,1,"ひと"],[12,1,"で"],[14,1,"く"],[22,1,"ひと"]],"text":"さらに言われた、「人から出て来るもの、それが人をけがすのである。"},{"ref":"Mark.7.21","start":41007021,"end":41007021,"break":"none","ruby":[[4,2,"ないぶ"],[9,1,"ひと"],[11,1,"こころ"],[13,1,"なか"],[17,1,"わる"],[19,1,"おも"],[22,1,"で"],[24,1,"く"],[27,3,"ふひんこう"],[31,1,"ぬす"],[34,2,"さつじん"]],"text":"すなわち内部から、人の心の中から、悪い思いが出て来る。不品行、盗み、殺人、"},{"ref":"Mark.7.22","start":41007022,"end":41007022,"break":"none","ruby":[[0,2,"かんいん"],[3,2,"どんよく"],[6,2,"じゃあく"],[9,1,"あざむ"],[12,2,"こうしょく"],[15,1,"ねた"],[18,1,"そし"],[21,2,"こうまん"],[24,2,"ぐち"]],"text":"姦淫、貪欲、邪悪、欺き、好色、妬み、誹り、高慢、愚痴。"},{"ref":"Mark.7.23","start":41007023,"end":41007023,"break":"none","ruby":[[4,1,"あく"],[9,2,"ないぶ"],[13,1,"で"],[18,1,"ひと"]],"text":"これらの悪はすべて内部から出てきて、人をけがすのである」。"},{"ref":"Mark.7.24","start":41007024,"end":41007024,"break":"paragraph","ruby":[[11,1,"た"],[13,1,"さ"],[20,2,"ちほう"],[23,1,"い"],[36,1,"し"],[44,1,"いえ"],[46,1,"なか"],[55,1,"かく"]],"text":"さて、イエスは、そこを立ち去って、ツロの地方に行かれた。そして、だれにも知れないように、家の中にはいられたが、隠れていることができなかった。"},{"ref":"Mark.7.25","start":41007025,"end":41007025,"break":"none","ruby":[[8,1,"れい"],[14,1,"おさな"],[16,1,"むすめ"],[20,1,"おんな"],[32,1,"き"],[42,1,"あし"],[48,1,"ふ"]],"text":"そして、けがれた霊につかれた幼い娘をもつ女が、イエスのことをすぐ聞きつけてきて、その足もとにひれ伏した。"},{"ref":"Mark.7.26","start":41007026,"end":41007026,"break":"none","ruby":[[2,1,"おんな"],[8,1,"じん"],[20,1,"うま"],[31,1,"むすめ"],[34,2,"あくれい"],[37,1,"お"],[39,1,"だ"],[48,1,"ねが"]],"text":"この女はギリシヤ人で、スロ・フェニキヤの生れであった。そして、娘から悪霊を追い出してくださいとお願いした。"},{"ref":"Mark.7.27","start":41007027,"end":41007027,"break":"none","ruby":[[4,1,"おんな"],[6,1,"い"],[14,2,"こども"],[19,2,"じゅうぶん"],[21,1,"た"],[31,2,"こども"],[39,1,"と"],[42,2,"こいぬ"],[45,1,"な"]],"text":"イエスは女に言われた、「まず子供たちに十分食べさすべきである。子供たちのパンを取って小犬に投げてやるのは、よろしくない」。"},{"ref":"Mark.7.28","start":41007028,"end":41007028,"break":"none","ruby":[[4,1,"おんな"],[6,1,"こた"],[9,1,"い"],[14,1,"しゅ"],[18,2,"ことば"],[29,2,"しょくたく"],[32,1,"した"],[36,2,"こいぬ"],[40,2,"こども"]],"text":"すると、女は答えて言った、「主よ、お言葉どおりです。でも、食卓の下にいる小犬も、子供たちのパンくずは、いただきます」。"},{"ref":"Mark.7.29","start":41007029,"end":41007029,"break":"none","ruby":[[7,1,"い"],[15,2,"ことば"],[29,1,"かえ"],[35,2,"あくれい"],[38,1,"むすめ"],[41,1,"で"]],"text":"そこでイエスは言われた、「その言葉で、じゅうぶんである。お帰りなさい。悪霊は娘から出てしまった」。"},{"ref":"Mark.7.30","start":41007030,"end":41007030,"break":"none","ruby":[[4,1,"おんな"],[6,1,"いえ"],[8,1,"かえ"],[17,1,"こ"],[19,1,"とこ"],[21,1,"うえ"],[23,1,"ね"],[28,2,"あくれい"],[31,1,"で"]],"text":"そこで、女が家に帰ってみると、その子は床の上に寝ており、悪霊は出てしまっていた。"},{"ref":"Mark.7.31","start":41007031,"end":41007031,"break":"paragraph","ruby":[[14,2,"ちほう"],[17,1,"さ"],[24,1,"へ"],[31,2,"ちほう"],[34,1,"とお"],[44,1,"うみ"]],"text":"それから、イエスはまたツロの地方を去り、シドンを経てデカポリス地方を通りぬけ、ガリラヤの海べにこられた。"},{"ref":"Mark.7.32","start":41007032,"end":41007032,"break":"none","ruby":[[3,2,"ひとびと"],[7,1,"みみ"],[9,1,"きこ"],[12,1,"くち"],[18,1,"ひと"],[25,1,"つ"],[31,1,"て"],[33,1,"お"],[47,1,"ねが"]],"text":"すると人々は、耳が聞えず口のきけない人を、みもとに連れてきて、手を置いてやっていただきたいとお願いした。"},{"ref":"Mark.7.33","start":41007033,"end":41007033,"break":"none","ruby":[[8,1,"かれ"],[13,2,"ぐんしゅう"],[16,1,"なか"],[19,1,"つ"],[21,1,"だ"],[26,1,"りょう"],[27,1,"みみ"],[29,1,"ゆび"],[33,1,"い"],[47,1,"した"],[49,1,"うるお"]],"text":"そこで、イエスは彼ひとりを群衆の中から連れ出し、その両耳に指をさし入れ、それから、つばきでその舌を潤し、"},{"ref":"Mark.7.34","start":41007034,"end":41007034,"break":"none","ruby":[[0,1,"てん"],[2,1,"あお"],[7,1,"いき"],[14,1,"ひと"],[22,1,"い"],[31,1,"ひら"],[38,2,"いみ"]],"text":"天を仰いでため息をつき、その人に「エパタ」と言われた。これは「開けよ」という意味である。"},{"ref":"Mark.7.35","start":41007035,"end":41007035,"break":"none","ruby":[[3,1,"かれ"],[5,1,"みみ"],[7,1,"ひら"],[12,1,"した"],[20,1,"と"],[29,1,"はな"]],"text":"すると彼の耳が開け、その舌のもつれもすぐ解けて、はっきりと話すようになった。"},{"ref":"Mark.7.36","start":41007036,"end":41007036,"break":"none","ruby":[[7,1,"こと"],[13,1,"い"],[22,2,"ひとびと"],[25,2,"くちど"],[34,2,"くちど"],[55,1,"い"]],"text":"イエスは、この事をだれにも言ってはならぬと、人々に口止めをされたが、口止めをすればするほど、かえって、ますます言いひろめた。"},{"ref":"Mark.7.37","start":41007037,"end":41007037,"break":"none","ruby":[[0,1,"かれ"],[11,1,"おどろ"],[14,1,"い"],[28,1,"こと"],[31,1,"なに"],[42,1,"みみ"],[44,1,"きこ"],[48,1,"もの"],[50,1,"きこ"],[61,1,"くち"],[67,1,"もの"]],"text":"彼らは、ひとかたならず驚いて言った、「このかたのなさった事は、何もかも、すばらしい。耳の聞えない者を聞えるようにしてやり、口のきけない者をきけるようにしておやりになった」。"}]