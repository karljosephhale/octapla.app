[{"ref":"Gen.1.1","start":1001001,"end":1001001,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"てん"],[8,1,"ち"],[11,2,"そうぞう"]],"text":"はじめに神は天と地とを創造された。"},{"ref":"Gen.1.2","start":1001002,"end":1001002,"break":"none","ruby":[[0,1,"ち"],[2,1,"かたち"],[14,1,"ふち"],[23,1,"かみ"],[25,1,"れい"],[27,1,"みず"]],"text":"地は形なく、むなしく、やみが淵のおもてにあり、神の霊が水のおもてをおおっていた。"},{"ref":"Gen.1.3","start":1001003,"end":1001003,"break":"paragraph","ruby":[[0,1,"かみ"],[3,1,"ひかり"],[8,1,"い"],[16,1,"ひかり"]],"text":"神は「光あれ」と言われた。すると光があった。"},{"ref":"Gen.1.4","start":1001004,"end":1001004,"break":"none","ruby":[[0,1,"かみ"],[4,1,"ひかり"],[6,1,"み"],[9,1,"よ"],[16,1,"かみ"],[20,1,"ひかり"],[26,1,"わ"]],"text":"神はその光を見て、良しとされた。神はその光とやみとを分けられた。"},{"ref":"Gen.1.5","start":1001005,"end":1001005,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ひかり"],[4,1,"ひる"],[6,1,"な"],[13,1,"よる"],[15,1,"な"],[22,1,"ゆう"],[29,1,"あさ"],[35,1,"だい"],[37,1,"にち"]],"text":"神は光を昼と名づけ、やみを夜と名づけられた。夕となり、また朝となった。第一日である。"},{"ref":"Gen.1.6","start":1001006,"end":1001006,"break":"paragraph","ruby":[[0,1,"かみ"],[4,1,"い"],[10,1,"みず"],[12,1,"あいだ"],[23,1,"みず"],[25,1,"みず"],[28,1,"わ"]],"text":"神はまた言われた、「水の間におおぞらがあって、水と水とを分けよ」。"},{"ref":"Gen.1.7","start":1001007,"end":1001007,"break":"none","ruby":[[9,1,"かみ"],[16,1,"つく"],[25,1,"した"],[27,1,"みず"],[34,1,"うえ"],[36,1,"みず"],[39,1,"わ"]],"text":"そのようになった。神はおおぞらを造って、おおぞらの下の水とおおぞらの上の水とを分けられた。"},{"ref":"Gen.1.8","start":1001008,"end":1001008,"break":"none","ruby":[[0,1,"かみ"],[9,1,"てん"],[11,1,"な"],[18,1,"ゆう"],[25,1,"あさ"],[31,1,"だい"],[33,1,"にち"]],"text":"神はそのおおぞらを天と名づけられた。夕となり、また朝となった。第二日である。"},{"ref":"Gen.1.9","start":1001009,"end":1001009,"break":"paragraph","ruby":[[0,1,"かみ"],[4,1,"い"],[10,1,"てん"],[12,1,"した"],[14,1,"みず"],[16,1,"ひと"],[18,1,"ところ"],[20,1,"あつ"],[28,1,"ち"],[30,1,"あらわ"]],"text":"神はまた言われた、「天の下の水は一つ所に集まり、かわいた地が現れよ」。そのようになった。"},{"ref":"Gen.1.10","start":1001010,"end":1001010,"break":"none","ruby":[[0,1,"かみ"],[8,1,"ち"],[10,1,"りく"],[12,1,"な"],[16,1,"みず"],[18,1,"あつ"],[22,1,"ところ"],[24,1,"うみ"],[26,1,"な"],[33,1,"かみ"],[35,1,"み"],[38,1,"よ"]],"text":"神はそのかわいた地を陸と名づけ、水の集まった所を海と名づけられた。神は見て、良しとされた。"},{"ref":"Gen.1.11","start":1001011,"end":1001011,"break":"none","ruby":[[0,1,"かみ"],[4,1,"い"],[10,1,"ち"],[12,2,"あおくさ"],[16,1,"たね"],[20,1,"くさ"],[23,2,"しゅるい"],[31,1,"たね"],[35,1,"み"],[37,1,"むす"],[39,2,"かじゅ"],[43,1,"ち"],[45,1,"うえ"]],"text":"神はまた言われた、「地は青草と、種をもつ草と、種類にしたがって種のある実を結ぶ果樹とを地の上にはえさせよ」。そのようになった。"},{"ref":"Gen.1.12","start":1001012,"end":1001012,"break":"none","ruby":[[0,1,"ち"],[2,2,"あおくさ"],[6,2,"しゅるい"],[14,1,"たね"],[18,1,"くさ"],[21,2,"しゅるい"],[29,1,"たね"],[33,1,"み"],[35,1,"むす"],[37,1,"き"],[46,1,"かみ"],[48,1,"み"],[51,1,"よ"]],"text":"地は青草と、種類にしたがって種をもつ草と、種類にしたがって種のある実を結ぶ木とをはえさせた。神は見て、良しとされた。"},{"ref":"Gen.1.13","start":1001013,"end":1001013,"break":"none","ruby":[[0,1,"ゆう"],[7,1,"あさ"],[13,1,"だい"],[15,1,"にち"]],"text":"夕となり、また朝となった。第三日である。"},{"ref":"Gen.1.14","start":1001014,"end":1001014,"break":"paragraph","ruby":[[0,1,"かみ"],[4,1,"い"],[10,1,"てん"],[17,1,"ひかり"],[22,1,"ひる"],[24,1,"よる"],[27,1,"わ"],[37,2,"きせつ"],[43,1,"ひ"],[48,1,"とし"]],"text":"神はまた言われた、「天のおおぞらに光があって昼と夜とを分け、しるしのため、季節のため、日のため、年のためになり、"},{"ref":"Gen.1.15","start":1001015,"end":1001015,"break":"none","ruby":[[0,1,"てん"],[10,1,"ち"],[12,1,"て"],[15,1,"ひかり"]],"text":"天のおおぞらにあって地を照らす光となれ」。そのようになった。"},{"ref":"Gen.1.16","start":1001016,"end":1001016,"break":"none","ruby":[[0,1,"かみ"],[5,1,"おお"],[8,1,"ひかり"],[10,1,"つく"],[13,1,"おお"],[16,1,"ひかり"],[18,1,"ひる"],[27,1,"ちい"],[30,1,"ひかり"],[32,1,"よる"],[43,1,"ほし"],[45,1,"つく"]],"text":"神は二つの大きな光を造り、大きい光に昼をつかさどらせ、小さい光に夜をつかさどらせ、また星を造られた。"},{"ref":"Gen.1.17","start":1001017,"end":1001017,"break":"none","ruby":[[0,1,"かみ"],[6,1,"てん"],[13,1,"お"],[16,1,"ち"],[18,1,"て"]],"text":"神はこれらを天のおおぞらに置いて地を照らさせ、"},{"ref":"Gen.1.18","start":1001018,"end":1001018,"break":"none","ruby":[[0,1,"ひる"],[2,1,"よる"],[12,1,"ひかり"],[18,1,"わ"],[26,1,"かみ"],[28,1,"み"],[31,1,"よ"]],"text":"昼と夜とをつかさどらせ、光とやみとを分けさせられた。神は見て、良しとされた。"},{"ref":"Gen.1.19","start":1001019,"end":1001019,"break":"none","ruby":[[0,1,"ゆう"],[7,1,"あさ"],[13,1,"だい"],[15,1,"にち"]],"text":"夕となり、また朝となった。第四日である。"},{"ref":"Gen.1.20","start":1001020,"end":1001020,"break":"paragraph","ruby":[[0,1,"かみ"],[4,1,"い"],[10,1,"みず"],[12,1,"い"],[14,1,"もの"],[16,1,"む"],[19,1,"み"],[22,1,"とり"],[24,1,"ち"],[26,1,"うえ"],[28,1,"てん"],[35,1,"と"]],"text":"神はまた言われた、「水は生き物の群れで満ち、鳥は地の上、天のおおぞらを飛べ」。"},{"ref":"Gen.1.21","start":1001021,"end":1001021,"break":"none","ruby":[[0,1,"かみ"],[2,1,"うみ"],[4,1,"おお"],[8,1,"けもの"],[11,1,"みず"],[13,1,"むら"],[20,1,"うご"],[22,1,"い"],[24,1,"もの"],[28,2,"しゅるい"],[36,2,"そうぞう"],[42,1,"つばさ"],[50,1,"とり"],[53,2,"しゅるい"],[61,2,"そうぞう"],[67,1,"かみ"],[69,1,"み"],[72,1,"よ"]],"text":"神は海の大いなる獣と、水に群がるすべての動く生き物とを、種類にしたがって創造し、また翼のあるすべての鳥を、種類にしたがって創造された。神は見て、良しとされた。"},{"ref":"Gen.1.22","start":1001022,"end":1001022,"break":"none","ruby":[[0,1,"かみ"],[6,2,"しゅくふく"],[10,1,"い"],[16,1,"う"],[24,1,"うみ"],[26,1,"みず"],[28,1,"み"],[34,1,"とり"],[36,1,"ち"]],"text":"神はこれらを祝福して言われた、「生めよ、ふえよ、海の水に満ちよ、また鳥は地にふえよ」。"},{"ref":"Gen.1.23","start":1001023,"end":1001023,"break":"none","ruby":[[0,1,"ゆう"],[7,1,"あさ"],[13,1,"だい"],[15,1,"にち"]],"text":"夕となり、また朝となった。第五日である。"},{"ref":"Gen.1.24","start":1001024,"end":1001024,"break":"paragraph","ruby":[[0,1,"かみ"],[4,1,"い"],[10,1,"ち"],[12,1,"い"],[14,1,"もの"],[16,2,"しゅるい"],[28,2,"かちく"],[32,1,"は"],[38,1,"ち"],[40,1,"けもの"],[43,2,"しゅるい"]],"text":"神はまた言われた、「地は生き物を種類にしたがっていだせ。家畜と、這うものと、地の獣とを種類にしたがっていだせ」。そのようになった。"},{"ref":"Gen.1.25","start":1001025,"end":1001025,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ち"],[4,1,"けもの"],[6,2,"しゅるい"],[14,2,"かちく"],[17,2,"しゅるい"],[27,1,"ち"],[29,1,"は"],[35,1,"もの"],[37,2,"しゅるい"],[45,1,"つく"],[50,1,"かみ"],[52,1,"み"],[55,1,"よ"]],"text":"神は地の獣を種類にしたがい、家畜を種類にしたがい、また地に這うすべての物を種類にしたがって造られた。神は見て、良しとされた。"},{"ref":"Gen.1.26","start":1001026,"end":1001026,"break":"paragraph","ruby":[[0,1,"かみ"],[4,1,"い"],[30,1,"ひと"],[32,1,"つく"],[38,1,"うみ"],[40,1,"うお"],[43,1,"そら"],[45,1,"とり"],[48,2,"かちく"],[52,1,"ち"],[58,1,"けもの"],[61,1,"ち"],[67,1,"は"],[73,1,"おさ"]],"text":"神はまた言われた、「われわれのかたちに、われわれにかたどって人を造り、これに海の魚と、空の鳥と、家畜と、地のすべての獣と、地のすべての這うものとを治めさせよう」。"},{"ref":"Gen.1.27","start":1001027,"end":1001027,"break":"none","ruby":[[0,1,"かみ"],[2,2,"じぶん"],[9,1,"ひと"],[11,2,"そうぞう"],[22,1,"かみ"],[28,2,"そうぞう"],[32,1,"おとこ"],[34,1,"おんな"],[37,2,"そうぞう"]],"text":"神は自分のかたちに人を創造された。すなわち、神のかたちに創造し、男と女とに創造された。"},{"ref":"Gen.1.28","start":1001028,"end":1001028,"break":"none","ruby":[[0,1,"かみ"],[2,1,"かれ"],[5,2,"しゅくふく"],[9,1,"い"],[15,1,"う"],[23,1,"ち"],[25,1,"み"],[29,1,"ち"],[31,1,"したが"],[38,1,"うみ"],[40,1,"うお"],[43,1,"そら"],[45,1,"とり"],[48,1,"ち"],[50,1,"うご"],[56,1,"い"],[58,1,"もの"],[61,1,"おさ"]],"text":"神は彼らを祝福して言われた、「生めよ、ふえよ、地に満ちよ、地を従わせよ。また海の魚と、空の鳥と、地に動くすべての生き物とを治めよ」。"},{"ref":"Gen.1.29","start":1001029,"end":1001029,"break":"none","ruby":[[0,1,"かみ"],[4,1,"い"],[14,1,"ぜん"],[15,1,"ち"],[23,1,"たね"],[31,1,"くさ"],[34,1,"たね"],[38,1,"み"],[40,1,"むす"],[46,1,"き"],[55,1,"あた"],[68,2,"しょくもつ"]],"text":"神はまた言われた、「わたしは全地のおもてにある種をもつすべての草と、種のある実を結ぶすべての木とをあなたがたに与える。これはあなたがたの食物となるであろう。"},{"ref":"Gen.1.30","start":1001030,"end":1001030,"break":"none","ruby":[[2,1,"ち"],[8,1,"けもの"],[10,1,"そら"],[16,1,"とり"],[18,1,"ち"],[20,1,"は"],[33,1,"いのち"],[41,2,"しょくもつ"],[50,2,"あおくさ"],[53,1,"あた"]],"text":"また地のすべての獣、空のすべての鳥、地を這うすべてのもの、すなわち命あるものには、食物としてすべての青草を与える」。そのようになった。"},{"ref":"Gen.1.31","start":1001031,"end":1001031,"break":"none","ruby":[[0,1,"かみ"],[2,1,"つく"],[9,1,"もの"],[11,1,"み"],[27,1,"よ"],[32,1,"ゆう"],[39,1,"あさ"],[45,1,"だい"],[47,1,"にち"]],"text":"神が造ったすべての物を見られたところ、それは、はなはだ良かった。夕となり、また朝となった。第六日である。"}]