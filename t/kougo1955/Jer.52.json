[{"ref":"Jer.52.1","start":24052001,"end":24052001,"break":"paragraph","ruby":[[5,1,"おう"],[15,1,"さい"],[30,1,"ねん"],[31,1,"よ"],[33,1,"おさ"],[37,1,"はは"],[39,1,"な"],[58,1,"むすめ"]],"text":"ゼデキヤは王となったとき二十一歳であったが、エルサレムで十一年世を治めた。母の名はハムタルといい、リブナのエレミヤの娘である。"},{"ref":"Jer.52.2","start":24052002,"end":24052002,"break":"none","ruby":[[14,1,"い"],[21,1,"しゅ"],[23,1,"め"],[25,1,"まえ"],[27,2,"あくじ"],[30,1,"おこな"]],"text":"ゼデキヤはエホヤキムがすべて行ったように、主の目の前に悪事を行った。"},{"ref":"Jer.52.3","start":24052003,"end":24052003,"break":"none","breaks":[[47,"paragraph"]],"ruby":[[5,1,"しゅ"],[7,1,"いか"],[28,1,"まえ"],[31,1,"す"],[33,1,"さ"],[60,1,"おう"]],"text":"たしかに、主の怒りによって、エルサレムとユダとは、そのみ前から捨て去られるようなことになった。そしてゼデキヤはバビロンの王にそむいた。"},{"ref":"Jer.52.4","start":24052004,"end":24052004,"break":"none","ruby":[[3,1,"かれ"],[5,2,"ちせい"],[9,1,"ねん"],[11,1,"がつ"],[13,1,"か"],[21,1,"おう"],[32,2,"ぐんぜい"],[35,1,"ひき"],[50,2,"ほうい"],[54,2,"しゅうい"],[57,1,"るい"],[59,1,"きず"],[65,1,"せ"]],"text":"そこで彼の治世の九年十月十日に、バビロンの王ネブカデレザルはその軍勢を率い、エルサレムにきて、これを包囲し、周囲に塁を築いてこれを攻めた。"},{"ref":"Jer.52.5","start":24052005,"end":24052005,"break":"none","ruby":[[6,1,"まち"],[8,1,"せ"],[10,1,"かこ"],[19,1,"おう"],[23,1,"ねん"],[27,1,"およ"]],"text":"こうしてこの町は攻め囲まれて、ゼデキヤ王の十一年にまで及んだが、"},{"ref":"Jer.52.6","start":24052006,"end":24052006,"break":"none","ruby":[[3,1,"がつ"],[5,1,"か"],[11,1,"まち"],[13,1,"なか"],[15,2,"しょくりょう"],[25,2,"けつぼう"],[31,1,"ち"],[33,1,"たみ"],[35,2,"しょくもつ"],[38,1,"え"]],"text":"その四月九日になって、町の中の食糧は、はなはだしく欠乏し、その地の民は食物を得ることができなくなった。"},{"ref":"Jer.52.7","start":24052007,"end":24052007,"break":"none","ruby":[[3,1,"まち"],[5,2,"じょうへき"],[11,1,"う"],[13,1,"やぶ"],[20,2,"へいし"],[27,1,"に"],[30,1,"よる"],[36,1,"おう"],[38,1,"その"],[40,1,"ちか"],[47,2,"じょうへき"],[50,1,"あいだ"],[52,1,"もん"],[55,1,"まち"],[60,1,"で"],[71,1,"まち"],[73,1,"せ"],[75,1,"かこ"],[88,1,"ほう"],[90,1,"お"],[93,1,"い"]],"text":"そして町の城壁はついに打ち破られたので、兵士たちはみな逃げ、夜のうちに、王の園の近くの、二つの城壁の間の門から町をのがれ出て、カルデヤびとが、町を攻め囲んでいるうちに、アラバの方へ落ちて行った。"},{"ref":"Jer.52.8","start":24052008,"end":24052008,"break":"none","ruby":[[10,2,"ぐんぜい"],[13,1,"おう"],[15,1,"お"],[18,1,"い"],[26,2,"へいち"],[34,1,"お"],[41,1,"かれ"],[43,2,"ぐんぜい"],[48,1,"ち"],[51,1,"かれ"],[56,1,"はな"]],"text":"しかしカルデヤびとの軍勢は王を追って行って、エリコの平地でゼデキヤに追いついたが、彼の軍勢がみな散って彼のそばを離れたので、"},{"ref":"Jer.52.9","start":24052009,"end":24052009,"break":"none","ruby":[[7,1,"おう"],[9,1,"とら"],[16,1,"ち"],[29,1,"おう"],[34,1,"ひ"],[43,1,"おう"],[45,1,"かれ"],[47,1,"つみ"],[49,1,"さだ"]],"text":"カルデヤびとは王を捕え、ハマテの地のリブラにいるバビロンの王のもとに引いていったので、王は彼の罪を定めた。"},{"ref":"Jer.52.10","start":24052010,"end":24052010,"break":"none","ruby":[[9,1,"おう"],[16,1,"こ"],[22,1,"め"],[24,1,"まえ"],[26,1,"ころ"],[48,1,"ころ"]],"text":"すなわちバビロンの王はゼデキヤの子たちをその目の前で殺させ、ユダのつかさたちをことごとくリブラで殺させ、"},{"ref":"Jer.52.11","start":24052011,"end":24052011,"break":"none","ruby":[[7,1,"め"],[23,1,"おう"],[25,1,"かれ"],[27,1,"くさり"],[38,1,"つ"],[41,1,"い"],[46,1,"し"],[48,1,"ひ"],[51,2,"ごくや"],[54,1,"い"],[57,1,"お"]],"text":"またゼデキヤの目をつぶさせた。そしてバビロンの王は彼を鎖につないでバビロンへ連れて行き、その死ぬ日まで獄屋に入れて置いた。"},{"ref":"Jer.52.12","start":24052012,"end":24052012,"break":"paragraph","ruby":[[1,1,"がつ"],[3,1,"か"],[16,1,"おう"],[25,1,"よ"],[29,1,"ねん"],[41,1,"おう"],[43,1,"つか"],[46,2,"じえい"],[49,1,"ちょう"]],"text":"五月十日に、――それはバビロンの王ネブカデレザルの世の十九年であった――バビロンの王に仕える侍衛の長ネブザラダンはエルサレムに、はいって、"},{"ref":"Jer.52.13","start":24052013,"end":24052013,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"みや"],[4,1,"おう"],[6,2,"きゅうでん"],[9,1,"や"],[22,1,"いえ"],[24,1,"や"],[28,1,"かれ"],[30,1,"おお"],[33,1,"いえ"],[37,1,"や"]],"text":"主の宮と王の宮殿を焼き、エルサレムのすべての家を焼いた。彼は大きな家をみな焼きはらった。"},{"ref":"Jer.52.14","start":24052014,"end":24052014,"break":"none","ruby":[[2,2,"じえい"],[5,1,"ちょう"],[7,1,"とも"],[18,2,"ぐんぜい"],[28,2,"しゅうい"],[31,2,"じょうへき"],[36,1,"と"]],"text":"また侍衛の長と共にいたカルデヤびとの軍勢は、エルサレムの周囲の城壁をみな取りこわした。"},{"ref":"Jer.52.15","start":24052015,"end":24052015,"break":"none","ruby":[[3,2,"じえい"],[6,1,"ちょう"],[14,1,"たみ"],[19,1,"もっと"],[21,1,"まず"],[24,1,"もの"],[25,2,"じゃっかん"],[32,1,"まち"],[37,1,"のこ"],[40,1,"もの"],[50,1,"おう"],[56,1,"ひと"],[60,1,"た"],[61,2,"こうしょう"],[66,1,"とら"],[68,1,"うつ"]],"text":"そして侍衛の長ネブザラダンは民のうちの最も貧しい者若干、そのほか町のうちに残った者、およびバビロンの王にくだった人、その他工匠たちを捕え移した。"},{"ref":"Jer.52.16","start":24052016,"end":24052016,"break":"none","ruby":[[3,2,"じえい"],[6,1,"ちょう"],[16,1,"ち"],[18,1,"もっと"],[20,1,"まず"],[23,1,"もの"],[24,2,"じゃっかん"],[27,1,"のこ"],[35,1,"つく"],[37,1,"もの"],[41,2,"のうふ"]],"text":"しかし侍衛の長ネブザラダンはその地の最も貧しい者若干を残して、ぶどうを作る者とし、農夫とした。"},{"ref":"Jer.52.17","start":24052017,"end":24052017,"break":"paragraph","ruby":[[9,1,"しゅ"],[11,1,"みや"],[13,2,"せいどう"],[16,1,"はしら"],[19,2,"せんばん"],[22,1,"だい"],[25,2,"せいどう"],[28,1,"うみ"],[30,1,"くだ"],[36,2,"せいどう"],[49,1,"はこ"]],"text":"カルデヤびとはまた主の宮の青銅の柱と、洗盤の台と、青銅の海を砕いて、その青銅をことごとくバビロンへ運び、"},{"ref":"Jer.52.18","start":24052018,"end":24052018,"break":"none","ruby":[[7,2,"じゅうのう"],[11,2,"しんき"],[19,1,"はち"],[22,1,"こう"],[24,1,"も"],[26,1,"さら"],[30,1,"みや"],[32,1,"つと"],[35,1,"もち"],[38,2,"せいどう"],[41,1,"うつわ"],[48,1,"と"],[51,1,"い"]],"text":"また、つぼと、十能と、心切りばさみと、鉢と、香を盛る皿および宮の勤めに用いる青銅の器をことごとく取って行った。"},{"ref":"Jer.52.19","start":24052019,"end":24052019,"break":"none","ruby":[[2,1,"かれ"],[5,2,"こばち"],[9,2,"しんと"],[12,1,"ざら"],[15,1,"はち"],[22,2,"しょくだい"],[26,1,"こう"],[28,1,"も"],[30,1,"さら"],[33,2,"かんさい"],[36,1,"はち"],[38,1,"と"],[42,1,"きん"],[44,1,"つく"],[47,1,"もの"],[49,1,"きん"],[54,1,"ぎん"],[56,1,"つく"],[59,1,"もの"],[61,1,"ぎん"],[66,2,"じえい"],[69,1,"ちょう"],[71,1,"はこ"],[73,1,"さ"]],"text":"また彼らは小鉢と、心取り皿と、鉢と、つぼと、燭台と、香を盛る皿と、灌祭の鉢を取った。金で作った物は金として、銀で作った物は銀として、侍衛の長は運び去った。"},{"ref":"Jer.52.20","start":24052020,"end":24052020,"break":"none","ruby":[[4,1,"おう"],[6,1,"しゅ"],[8,1,"みや"],[10,1,"つく"],[14,1,"ほん"],[16,1,"はしら"],[22,1,"うみ"],[25,1,"うみ"],[27,1,"した"],[32,2,"せいどう"],[35,1,"うし"],[38,1,"だい"],[48,1,"もの"],[50,2,"せいどう"],[53,1,"おも"],[56,1,"はか"]],"text":"ソロモン王が主の宮に造った二本の柱と、一つの海と、海の下の十二の青銅の牛と、台など、このすべての物の青銅の重さは量ることもできなかった。"},{"ref":"Jer.52.21","start":24052021,"end":24052021,"break":"none","ruby":[[3,1,"ぽん"],[5,1,"はしら"],[7,1,"たか"],[17,2,"しゅうい"],[28,1,"ゆび"],[30,1,"ほん"],[32,1,"あつ"],[38,1,"なか"]],"text":"この一本の柱の高さは十八キュビト、周囲は十二キュビトで、指四本の厚さがあり、中は、うつろであった。"},{"ref":"Jer.52.22","start":24052022,"end":24052022,"break":"none","ruby":[[2,1,"うえ"],[4,2,"せいどう"],[7,2,"ちゅうとう"],[13,2,"ちゅうとう"],[16,1,"たか"],[25,2,"ちゅうとう"],[28,2,"しゅうい"],[31,1,"あみ"],[32,2,"ざいく"],[41,1,"かざ"],[50,2,"せいどう"],[57,1,"た"],[59,1,"はしら"],[71,1,"おな"]],"text":"その上に青銅の柱頭があり、柱頭の高さは五キュビト、柱頭の周囲は網細工と、ざくろとで飾り、これらもみな青銅であった。他の柱もそのざくろも、これと同じであった。"},{"ref":"Jer.52.23","start":24052023,"end":24052023,"break":"none","ruby":[[2,2,"しほう"],[8,1,"こ"],[17,2,"しゅうい"],[20,1,"あみ"],[21,2,"ざいく"],[24,1,"うえ"],[32,1,"かず"],[35,1,"こ"]],"text":"その四方に九十六個のざくろがあり、周囲の網細工の上にあるざくろの数は百個であった。"},{"ref":"Jer.52.24","start":24052024,"end":24052024,"break":"paragraph","ruby":[[0,2,"じえい"],[3,1,"ちょう"],[5,2,"さいし"],[7,1,"ちょう"],[12,2,"じせき"],[15,2,"さいし"],[23,1,"にん"],[25,1,"もん"],[27,1,"まも"],[29,1,"もの"],[31,1,"とら"]],"text":"侍衛の長は祭司長セラヤと次席の祭司ゼパニヤと三人の門を守る者を捕え、"},{"ref":"Jer.52.25","start":24052025,"end":24052025,"break":"none","ruby":[[2,2,"へいし"],[14,2,"やくにん"],[18,1,"まち"],[22,1,"おう"],[24,2,"そっきん"],[27,1,"もの"],[29,1,"にん"],[34,1,"ち"],[36,1,"たみ"],[38,1,"つの"],[40,2,"ぐんぜい"],[43,1,"ちょう"],[45,3,"しょきかん"],[50,1,"まち"],[52,1,"なか"],[58,1,"にん"],[60,1,"もの"],[62,1,"まち"],[65,1,"とら"],[67,1,"さ"]],"text":"また兵士をつかさどるひとりの役人と、町にいた王の側近の者七人と、その地の民を募る軍勢の長の書記官と、町の中にいた六十人の者を町から捕え去った。"},{"ref":"Jer.52.26","start":24052026,"end":24052026,"break":"none","ruby":[[0,2,"じえい"],[3,1,"ちょう"],[16,1,"ひと"],[18,1,"とら"],[33,1,"おう"],[38,1,"つ"],[41,1,"い"]],"text":"侍衛の長ネブザラダンは、これらの人を捕えて、リブラにいるバビロンの王のもとに連れて行った。"},{"ref":"Jer.52.27","start":24052027,"end":24052027,"break":"none","ruby":[[5,1,"おう"],[12,1,"ち"],[18,1,"かれ"],[21,1,"う"],[23,1,"ころ"],[35,2,"じぶん"],[38,1,"ち"],[41,1,"とら"],[43,1,"うつ"]],"text":"バビロンの王は、ハマテの地のリブラで彼らを撃ち殺した。こうして、ユダは自分の地から捕え移された。"},{"ref":"Jer.52.28","start":24052028,"end":24052028,"break":"paragraph","ruby":[[8,1,"とら"],[10,1,"うつ"],[13,1,"たみ"],[15,1,"かず"],[17,1,"つぎ"],[26,1,"だい"],[28,1,"ねん"],[34,1,"ひと"],[40,1,"にん"]],"text":"ネブカデレザルが捕え移した民の数は次のとおりである。第七年にはユダヤ人三千二十三人。"},{"ref":"Jer.52.29","start":24052029,"end":24052029,"break":"none","ruby":[[12,1,"だい"],[15,1,"ねん"],[29,1,"にん"],[31,1,"とら"],[33,1,"うつ"]],"text":"またネブカデレザルはその第十八年にエルサレムから八百三十二人を捕え移した。"},{"ref":"Jer.52.30","start":24052030,"end":24052030,"break":"none","ruby":[[11,1,"ねん"],[13,2,"じえい"],[16,1,"ちょう"],[28,1,"ひと"],[34,1,"にん"],[36,1,"とら"],[38,1,"うつ"],[44,2,"そうすう"],[51,1,"にん"]],"text":"ネブカデレザルの二十三年に侍衛の長ネブザラダンは、ユダヤ人七百四十五人を捕え移した。この総数は四千六百人であった。"},{"ref":"Jer.52.31","start":24052031,"end":24052031,"break":"paragraph","ruby":[[3,1,"おう"],[10,1,"とら"],[12,1,"うつ"],[16,1,"のち"],[20,1,"ねん"],[24,1,"がつ"],[28,1,"にち"],[36,1,"おう"],[47,2,"そくい"],[50,1,"ねん"],[56,1,"おう"],[63,2,"ごくや"],[67,1,"だ"],[76,1,"あ"]],"text":"ユダの王エホヤキンが捕え移されて後三十七年の十二月二十五日に、バビロンの王エビルメロダクはその即位の年に、ユダの王エホヤキンを獄屋から出し、そのこうべを挙げさせ、"},{"ref":"Jer.52.32","start":24052032,"end":24052032,"break":"none","ruby":[[0,2,"しんせつ"],[3,1,"かれ"],[5,1,"なぐさ"],[10,1,"くらい"],[18,1,"とも"],[22,1,"おう"],[26,1,"くらい"],[30,1,"たか"]],"text":"親切に彼を慰め、その位を、バビロンで共にいる王たちの位よりも高くした。"},{"ref":"Jer.52.33","start":24052033,"end":24052033,"break":"none","ruby":[[10,2,"ごくや"],[13,1,"ふく"],[15,1,"ぬ"],[22,1,"い"],[27,1,"あいだ"],[29,2,"まいにち"],[31,1,"おう"],[33,2,"しょくたく"],[36,2,"しょくじ"]],"text":"こうしてエホヤキンは獄屋の服を脱いだ。そして生きている間は毎日王の食卓で食事し、"},{"ref":"Jer.52.34","start":24052034,"end":24052034,"break":"none","ruby":[[0,1,"かれ"],[2,2,"きゅうよ"],[11,1,"し"],[13,1,"ひ"],[16,2,"いっしょう"],[19,1,"あいだ"],[24,2,"ひび"],[27,2,"ひつよう"],[41,1,"おう"],[44,2,"きゅうよ"],[47,1,"たま"]],"text":"彼の給与としては、その死ぬ日まで一生の間、たえず日々の必要にしたがって、バビロンの王から給与を賜わった。"}]