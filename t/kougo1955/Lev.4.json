[{"ref":"Lev.4.1","start":3004001,"end":3004001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.4.2","start":3004002,"end":3004002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[19,1,"ひと"],[26,1,"つみ"],[28,1,"おか"],[31,1,"しゅ"],[58,1,"とき"],[60,1,"つぎ"]],"text":"「イスラエルの人々に言いなさい、『もし人があやまって罪を犯し、主のいましめにそむいて、してはならないことの一つをした時は次のようにしなければならない。"},{"ref":"Lev.4.3","start":3004003,"end":3004003,"break":"none","ruby":[[5,1,"あぶら"],[6,1,"そそ"],[10,2,"さいし"],[13,1,"つみ"],[15,1,"おか"],[22,1,"たみ"],[24,1,"およ"],[31,1,"かれ"],[35,1,"おか"],[38,1,"つみ"],[43,1,"おす"],[45,1,"まった"],[47,1,"こ"],[48,1,"うし"],[50,2,"ざいさい"],[55,1,"しゅ"]],"text":"すなわち、油注がれた祭司が罪を犯して、とがを民に及ぼすならば、彼はその犯した罪のために雄の全き子牛を罪祭として主にささげなければならない。"},{"ref":"Lev.4.4","start":3004004,"end":3004004,"break":"none","ruby":[[2,1,"こ"],[3,1,"うし"],[5,2,"かいけん"],[8,2,"まくや"],[11,2,"いりぐち"],[14,1,"つ"],[19,1,"しゅ"],[21,1,"まえ"],[23,1,"いた"],[28,1,"こ"],[29,1,"うし"],[31,1,"あたま"],[33,1,"て"],[35,1,"お"],[40,1,"こ"],[41,1,"うし"],[43,1,"しゅ"],[45,1,"まえ"]],"text":"その子牛を会見の幕屋の入口に連れてきて主の前に至り、その子牛の頭に手を置き、その子牛を主の前で、ほふらなければならない。"},{"ref":"Lev.4.5","start":3004005,"end":3004005,"break":"none","ruby":[[0,1,"あぶら"],[1,1,"そそ"],[5,2,"さいし"],[11,1,"こ"],[12,1,"うし"],[14,1,"ち"],[16,1,"と"],[23,2,"かいけん"],[26,2,"まくや"],[29,1,"たずさ"],[31,1,"い"]],"text":"油注がれた祭司は、その子牛の血を取って、それを会見の幕屋に携え入り、"},{"ref":"Lev.4.6","start":3004006,"end":3004006,"break":"none","ruby":[[3,2,"さいし"],[6,1,"ゆび"],[10,1,"ち"],[12,1,"ひた"],[16,2,"せいじょ"],[19,2,"たれまく"],[22,1,"まえ"],[24,1,"しゅ"],[26,1,"まえ"],[30,1,"ち"],[35,1,"そそ"]],"text":"そして祭司は指をその血に浸して、聖所の垂幕の前で主の前にその血を七たび注がなければならない。"},{"ref":"Lev.4.7","start":3004007,"end":3004007,"break":"none","ruby":[[0,2,"さいし"],[7,1,"ち"],[9,1,"と"],[12,1,"しゅ"],[14,1,"まえ"],[16,2,"かいけん"],[19,2,"まくや"],[22,1,"なか"],[26,1,"こう"],[30,2,"くんこう"],[33,2,"さいだん"],[36,1,"つの"],[42,1,"ぬ"],[55,1,"こ"],[56,1,"うし"],[58,1,"ち"],[60,1,"のこ"],[68,2,"かいけん"],[71,2,"まくや"],[74,2,"いりぐち"],[79,2,"はんさい"],[82,2,"さいだん"],[88,1,"そそ"]],"text":"祭司はまたその血を取り、主の前で会見の幕屋の中にある香ばしい薫香の祭壇の角に、それを塗らなければならない。その子牛の血の残りはことごとく会見の幕屋の入口にある燔祭の祭壇のもとに注がなければならない。"},{"ref":"Lev.4.8","start":3004008,"end":3004008,"break":"none","ruby":[[4,2,"ざいさい"],[7,1,"こ"],[8,1,"うし"],[16,2,"しぼう"],[19,1,"と"],[34,2,"ないぞう"],[40,2,"しぼう"],[43,2,"ないぞう"],[46,1,"うえ"],[52,2,"しぼう"]],"text":"またその罪祭の子牛から、すべての脂肪を取らなければならない。すなわち内臓をおおう脂肪と内臓の上のすべての脂肪、"},{"ref":"Lev.4.9","start":3004009,"end":3004009,"break":"none","ruby":[[3,2,"じんぞう"],[8,1,"うえ"],[10,1,"こし"],[18,2,"しぼう"],[25,2,"じんぞう"],[28,1,"とも"],[30,1,"と"],[34,2,"かんぞう"],[37,1,"うえ"],[39,2,"しょうよう"]],"text":"二つの腎臓とその上の腰のあたりにある脂肪、ならびに腎臓と共に取られる肝臓の上の小葉である。"},{"ref":"Lev.4.10","start":3004010,"end":3004010,"break":"none","ruby":[[3,1,"と"],[7,3,"しゅうおんさい"],[11,2,"ぎせい"],[14,2,"おうし"],[18,1,"と"],[22,1,"おな"],[40,2,"さいし"],[46,2,"はんさい"],[49,2,"さいだん"],[52,1,"うえ"],[54,1,"や"]],"text":"これを取るには酬恩祭の犠牲の雄牛から取るのと同じようにしなければならない。そして祭司はそれを燔祭の祭壇の上で焼かなければならない。"},{"ref":"Lev.4.11","start":3004011,"end":3004011,"break":"none","ruby":[[2,1,"こ"],[3,1,"うし"],[5,1,"かわ"],[13,1,"にく"],[20,1,"あたま"],[22,1,"あし"],[24,2,"ないぞう"],[27,2,"おぶつ"]],"text":"その子牛の皮とそのすべての肉、およびその頭と足と内臓と汚物など、"},{"ref":"Lev.4.12","start":3004012,"end":3004012,"break":"none","ruby":[[5,1,"こ"],[6,1,"うし"],[8,1,"のこ"],[15,2,"しゅくえい"],[18,1,"そと"],[21,1,"きよ"],[23,2,"ばしょ"],[27,1,"はい"],[28,1,"すて"],[29,1,"ば"],[31,1,"たずさ"],[33,1,"だ"],[36,1,"ひ"],[48,1,"うえ"],[50,1,"や"],[52,1,"す"],[70,1,"はい"],[71,1,"すて"],[72,1,"ば"],[74,1,"や"],[76,1,"す"]],"text":"すべてその子牛の残りは、これを宿営の外の、清い場所なる灰捨場に携え出し、火をもってこれをたきぎの上で焼き捨てなければならない。すなわちこれは灰捨場で焼き捨てらるべきである。"},{"ref":"Lev.4.13","start":3004013,"end":3004013,"break":"none","ruby":[[8,1,"ぜん"],[9,2,"かいしゅう"],[17,1,"おか"],[25,2,"かいしゅう"],[28,1,"め"],[30,1,"かく"],[37,1,"しゅ"],[69,1,"え"]],"text":"もしイスラエルの全会衆があやまちを犯し、そのことが会衆の目に隠れていても、主のいましめにそむいて、してはならないことの一つをなして、とがを得たならば、"},{"ref":"Lev.4.14","start":3004014,"end":3004014,"break":"none","ruby":[[2,1,"おか"],[5,1,"つみ"],[7,1,"あらわ"],[10,1,"とき"],[12,2,"かいしゅう"],[15,1,"おす"],[17,1,"こ"],[18,1,"うし"],[20,2,"ざいさい"],[44,2,"かいけん"],[47,2,"まくや"],[50,1,"まえ"],[52,1,"つ"]],"text":"その犯した罪が現れた時、会衆は雄の子牛を罪祭としてささげなければならない。すなわちそれを会見の幕屋の前に連れてきて、"},{"ref":"Lev.4.15","start":3004015,"end":3004015,"break":"none","ruby":[[0,2,"かいしゅう"],[3,2,"ちょうろう"],[9,1,"しゅ"],[11,1,"まえ"],[15,1,"こ"],[16,1,"うし"],[18,1,"あたま"],[20,1,"て"],[22,1,"お"],[27,1,"こ"],[28,1,"うし"],[30,1,"しゅ"],[32,1,"まえ"]],"text":"会衆の長老たちは、主の前でその子牛の頭に手を置き、その子牛を主の前で、ほふらなければならない。"},{"ref":"Lev.4.16","start":3004016,"end":3004016,"break":"none","ruby":[[4,1,"あぶら"],[5,1,"そそ"],[9,2,"さいし"],[15,1,"こ"],[16,1,"うし"],[18,1,"ち"],[20,2,"かいけん"],[23,2,"まくや"],[26,1,"たずさ"],[28,1,"い"]],"text":"そして、油注がれた祭司は、その子牛の血を会見の幕屋に携え入り、"},{"ref":"Lev.4.17","start":3004017,"end":3004017,"break":"none","ruby":[[0,2,"さいし"],[3,1,"ゆび"],[7,1,"ち"],[9,1,"ひた"],[12,2,"たれまく"],[15,1,"まえ"],[17,1,"しゅ"],[19,1,"まえ"],[24,1,"そそ"]],"text":"祭司は指をその血に浸し、垂幕の前で主の前に七たび注がなければならない。"},{"ref":"Lev.4.18","start":3004018,"end":3004018,"break":"none","ruby":[[4,1,"ち"],[6,1,"と"],[10,2,"かいけん"],[13,2,"まくや"],[16,1,"なか"],[18,1,"しゅ"],[20,1,"まえ"],[24,2,"さいだん"],[27,1,"つの"],[33,1,"ぬ"],[46,1,"ち"],[48,1,"のこ"],[56,2,"かいけん"],[59,2,"まくや"],[62,2,"いりぐち"],[67,2,"はんさい"],[70,2,"さいだん"],[76,1,"そそ"]],"text":"またその血を取って、会見の幕屋の中の主の前にある祭壇の角に、それを塗らなければならない。その血の残りはことごとく会見の幕屋の入口にある燔祭の祭壇のもとに注がなければならない。"},{"ref":"Lev.4.19","start":3004019,"end":3004019,"break":"none","ruby":[[8,2,"しぼう"],[11,1,"と"],[14,2,"さいだん"],[17,1,"うえ"],[19,1,"や"]],"text":"またそのすべての脂肪を取って祭壇の上で焼かなければならない。"},{"ref":"Lev.4.20","start":3004020,"end":3004020,"break":"none","ruby":[[4,2,"さいし"],[7,2,"ざいさい"],[10,2,"おうし"],[21,2,"おうし"],[41,2,"さいし"],[44,1,"かれ"],[61,1,"かれ"]],"text":"すなわち祭司は罪祭の雄牛にしたように、この雄牛にも、しなければならない。こうして、祭司が彼らのためにあがないをするならば、彼らはゆるされるであろう。"},{"ref":"Lev.4.21","start":3004021,"end":3004021,"break":"none","ruby":[[4,1,"かれ"],[8,2,"おうし"],[11,2,"しゅくえい"],[14,1,"そと"],[16,1,"たずさ"],[18,1,"だ"],[25,2,"おうし"],[28,1,"や"],[30,1,"す"],[40,1,"や"],[42,1,"す"],[56,2,"かいしゅう"],[59,2,"ざいさい"]],"text":"そして、彼はその雄牛を宿営の外に携え出し、はじめの雄牛を焼き捨てたように、これを焼き捨てなければならない。これは会衆の罪祭である。"},{"ref":"Lev.4.22","start":3004022,"end":3004022,"break":"paragraph","ruby":[[7,1,"もの"],[9,1,"つみ"],[11,1,"おか"],[22,1,"かみ"],[24,1,"しゅ"],[54,1,"え"]],"text":"またつかさたる者が罪を犯し、あやまって、その神、主のいましめにそむき、してはならないことの一つをして、とがを得、"},{"ref":"Lev.4.23","start":3004023,"end":3004023,"break":"none","ruby":[[4,1,"おか"],[7,1,"つみ"],[9,1,"し"],[21,1,"そな"],[23,1,"もの"],[27,1,"お"],[31,1,"まった"],[36,1,"つ"]],"text":"もしその犯した罪を知るようになったときは、供え物として雄やぎの全きものを連れてきて、"},{"ref":"Lev.4.24","start":3004024,"end":3004024,"break":"none","ruby":[[5,1,"あたま"],[7,1,"て"],[9,1,"お"],[12,2,"はんさい"],[18,2,"ばしょ"],[22,1,"しゅ"],[24,1,"まえ"],[44,2,"ざいさい"]],"text":"そのやぎの頭に手を置き、燔祭をほふる場所で、主の前にこれをほふらなければならない。これは罪祭である。"},{"ref":"Lev.4.25","start":3004025,"end":3004025,"break":"none","ruby":[[0,2,"さいし"],[3,1,"ゆび"],[7,2,"ざいさい"],[10,1,"ち"],[12,1,"と"],[15,2,"はんさい"],[18,2,"さいだん"],[21,1,"つの"],[26,1,"ぬ"],[29,1,"のこ"],[32,1,"ち"],[34,2,"はんさい"],[37,2,"さいだん"],[43,1,"そそ"]],"text":"祭司は指でその罪祭の血を取り、燔祭の祭壇の角にそれを塗り、残りの血は燔祭の祭壇のもとに注がなければならない。"},{"ref":"Lev.4.26","start":3004026,"end":3004026,"break":"none","ruby":[[9,2,"しぼう"],[13,3,"しゅうおんさい"],[17,2,"ぎせい"],[20,2,"しぼう"],[23,1,"おな"],[29,2,"さいだん"],[32,1,"うえ"],[34,1,"や"],[50,2,"さいし"],[53,1,"かれ"],[60,1,"つみ"],[73,1,"かれ"]],"text":"また、そのすべての脂肪は、酬恩祭の犠牲の脂肪と同じように、祭壇の上で焼かなければならない。こうして、祭司が彼のためにその罪のあがないをするならば、彼はゆるされるであろう。"},{"ref":"Lev.4.27","start":3004027,"end":3004027,"break":"none","ruby":[[2,2,"いっぱん"],[5,1,"ひと"],[14,1,"つみ"],[16,1,"おか"],[19,1,"しゅ"],[50,1,"え"]],"text":"また一般の人がもしあやまって罪を犯し、主のいましめにそむいて、してはならないことの一つをして、とがを得、"},{"ref":"Lev.4.28","start":3004028,"end":3004028,"break":"none","ruby":[[2,1,"おか"],[5,1,"つみ"],[7,1,"し"],[21,1,"おか"],[24,1,"つみ"],[29,1,"そな"],[31,1,"もの"],[35,1,"め"],[39,1,"まった"],[44,1,"つ"]],"text":"その犯した罪を知るようになったときは、その犯した罪のために供え物として雌やぎの全きものを連れてきて、"},{"ref":"Lev.4.29","start":3004029,"end":3004029,"break":"none","ruby":[[2,2,"ざいさい"],[5,1,"あたま"],[7,1,"て"],[9,1,"お"],[12,2,"はんさい"],[18,2,"ばしょ"],[24,2,"ざいさい"]],"text":"その罪祭の頭に手を置き、燔祭をほふる場所で、その罪祭をほふらなければならない。"},{"ref":"Lev.4.30","start":3004030,"end":3004030,"break":"none","ruby":[[3,2,"さいし"],[6,1,"ゆび"],[10,1,"ち"],[12,1,"と"],[15,2,"はんさい"],[18,2,"さいだん"],[21,1,"つの"],[26,1,"ぬ"],[29,1,"のこ"],[32,1,"ち"],[39,2,"さいだん"],[45,1,"そそ"]],"text":"そして祭司は指でその血を取り、燔祭の祭壇の角にこれを塗り、残りの血をことごとく祭壇のもとに注がなければならない。"},{"ref":"Lev.4.31","start":3004031,"end":3004031,"break":"none","ruby":[[8,2,"しぼう"],[11,3,"しゅうおんさい"],[15,2,"ぎせい"],[19,2,"しぼう"],[22,1,"と"],[26,1,"おな"],[31,1,"と"],[37,2,"さいだん"],[40,1,"うえ"],[42,1,"や"],[45,1,"しゅ"],[51,1,"こう"],[73,2,"さいし"],[76,1,"かれ"],[92,1,"かれ"]],"text":"またそのすべての脂肪は酬恩祭の犠牲から脂肪を取るのと同じように取り、これを祭壇の上で焼いて主にささげる香ばしいかおりとしなければならない。こうして祭司が彼のためにあがないをするならば、彼はゆるされるであろう。"},{"ref":"Lev.4.32","start":3004032,"end":3004032,"break":"paragraph","ruby":[[2,2,"こひつじ"],[5,2,"ざいさい"],[11,1,"そな"],[13,1,"もの"],[17,1,"つ"],[26,1,"めす"],[28,1,"まった"],[33,1,"つ"]],"text":"もし小羊を罪祭のために供え物として連れてくるならば、雌の全きものを連れてこなければならない。"},{"ref":"Lev.4.33","start":3004033,"end":3004033,"break":"none","ruby":[[2,2,"ざいさい"],[5,1,"あたま"],[7,1,"て"],[9,1,"お"],[12,2,"はんさい"],[18,2,"ばしょ"],[29,2,"ざいさい"]],"text":"その罪祭の頭に手を置き、燔祭をほふる場所で、これをほふり、罪祭としなければならない。"},{"ref":"Lev.4.34","start":3004034,"end":3004034,"break":"none","ruby":[[3,2,"さいし"],[6,1,"ゆび"],[10,2,"ざいさい"],[13,1,"ち"],[15,1,"と"],[18,2,"はんさい"],[21,2,"さいだん"],[24,1,"つの"],[29,1,"ぬ"],[32,1,"のこ"],[35,1,"ち"],[42,2,"さいだん"],[48,1,"そそ"]],"text":"そして祭司は指でその罪祭の血を取り、燔祭の祭壇の角にそれを塗り、残りの血はことごとく祭壇のもとに注がなければならない。"},{"ref":"Lev.4.35","start":3004035,"end":3004035,"break":"none","ruby":[[8,2,"しぼう"],[11,3,"しゅうおんさい"],[15,2,"ぎせい"],[19,2,"こひつじ"],[22,2,"しぼう"],[25,1,"と"],[29,1,"おな"],[34,1,"と"],[37,2,"さいし"],[43,1,"しゅ"],[49,2,"かさい"],[55,2,"さいだん"],[58,1,"うえ"],[60,1,"や"],[75,2,"さいし"],[78,1,"かれ"],[80,1,"おか"],[83,1,"つみ"],[99,1,"かれ"]],"text":"またそのすべての脂肪は酬恩祭の犠牲から小羊の脂肪を取るのと同じように取り、祭司はこれを主にささげる火祭のように祭壇の上で焼かなければならない。こうして祭司が彼の犯した罪のためにあがないをするならば、彼はゆるされるであろう。"}]