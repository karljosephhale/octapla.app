[{"ref":"Ps.130.1","start":19130001,"end":19130001,"break":"paragraph","title":"都もうでの歌","ruby":[[0,1,"しゅ"],[7,1,"ふか"],[9,1,"ふち"],[16,1,"よ"]],"titleRuby":[[0,1,"みやこ"],[5,1,"うた"]],"text":"主よ、わたしは深い淵からあなたに呼ばわる。"},{"ref":"Ps.130.2","start":19130002,"end":19130002,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"こえ"],[11,1,"き"],[18,1,"みみ"],[22,1,"ねが"],[25,1,"こえ"],[27,1,"かたむ"]],"text":"主よ、どうか、わが声を聞き、あなたの耳をわが願いの声に傾けてください。"},{"ref":"Ps.130.3","start":19130003,"end":19130003,"break":"line","breaks":[[18,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[15,2,"ふぎ"],[18,1,"め"],[29,1,"しゅ"],[35,1,"た"]],"text":"主よ、あなたがもし、もろもろの不義に目をとめられるならば、主よ、だれが立つことができましょうか。"},{"ref":"Ps.130.4","start":19130004,"end":19130004,"break":"line","breaks":[[18,"line"]],"ruby":[[18,1,"ひと"],[20,1,"おそ"]],"text":"しかしあなたには、ゆるしがあるので、人に恐れかしこまれるでしょう。"},{"ref":"Ps.130.5","start":19130005,"end":19130005,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"ま"],[8,1,"のぞ"],[15,1,"たましい"],[17,1,"ま"],[19,1,"のぞ"],[27,2,"ことば"],[38,1,"のぞ"]],"text":"わたしは主を待ち望みます、わが魂は待ち望みます。そのみ言葉によって、わたしは望みをいだきます。"},{"ref":"Ps.130.6","start":19130006,"end":19130006,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"たましい"],[4,2,"よまわ"],[8,1,"あかつき"],[10,1,"ま"],[17,2,"よまわ"],[21,1,"あかつき"],[23,1,"ま"],[30,1,"しゅ"],[32,1,"ま"],[34,1,"のぞ"]],"text":"わが魂は夜回りが暁を待つにまさり、夜回りが暁を待つにまさって主を待ち望みます。"},{"ref":"Ps.130.7","start":19130007,"end":19130007,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[7,1,"しゅ"],[12,1,"のぞ"],[19,1,"しゅ"],[34,1,"ゆた"]],"text":"イスラエルよ、主によって望みをいだけ。主には、いつくしみがあり、また豊かなあがないがあるからです。"},{"ref":"Ps.130.8","start":19130008,"end":19130008,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"しゅ"],[15,2,"ふぎ"]],"text":"主はイスラエルをそのもろもろの不義からあがなわれます。"}]