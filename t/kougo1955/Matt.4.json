[{"ref":"Matt.4.1","start":40004001,"end":40004001,"break":"paragraph","ruby":[[7,2,"みたま"],[13,2,"あらの"],[16,1,"みちび"],[21,2,"あくま"],[24,1,"こころ"]],"text":"さて、イエスは御霊によって荒野に導かれた。悪魔に試みられるためである。"},{"ref":"Matt.4.2","start":40004002,"end":40004002,"break":"none","ruby":[[6,1,"にち"],[9,1,"や"],[11,2,"だんじき"],[20,2,"くうふく"]],"text":"そして、四十日四十夜、断食をし、そののち空腹になられた。"},{"ref":"Matt.4.3","start":40004003,"end":40004003,"break":"none","ruby":[[3,1,"こころ"],[6,1,"もの"],[10,1,"い"],[21,1,"かみ"],[23,1,"こ"],[34,1,"いし"],[44,1,"めい"]],"text":"すると試みる者がきて言った、「もしあなたが神の子であるなら、これらの石がパンになるように命じてごらんなさい」。"},{"ref":"Matt.4.4","start":40004004,"end":40004004,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[14,1,"ひと"],[21,1,"い"],[31,1,"かみ"],[33,1,"くち"],[36,1,"で"],[43,1,"ことば"],[45,1,"い"],[55,1,"か"]],"text":"イエスは答えて言われた、「『人はパンだけで生きるものではなく、神の口から出る一つ一つの言で生きるものである』と書いてある」。"},{"ref":"Matt.4.5","start":40004005,"end":40004005,"break":"none","ruby":[[4,2,"あくま"],[12,1,"せい"],[15,1,"みやこ"],[17,1,"つ"],[20,1,"い"],[23,1,"みや"],[25,2,"ちょうじょう"],[28,1,"た"]],"text":"それから悪魔は、イエスを聖なる都に連れて行き、宮の頂上に立たせて"},{"ref":"Matt.4.6","start":40004006,"end":40004006,"break":"none","breaks":[[34,"stanza"],[57,"line"],[77,"line"]],"ruby":[[0,1,"い"],[11,1,"かみ"],[13,1,"こ"],[20,1,"した"],[22,1,"と"],[35,1,"かみ"],[44,2,"みつかい"],[50,1,"めい"],[61,1,"あし"],[63,1,"いし"],[65,1,"う"],[77,1,"かれ"],[84,1,"て"],[96,1,"か"]],"text":"言った、「もしあなたが神の子であるなら、下へ飛びおりてごらんなさい。『神はあなたのために御使たちにお命じになると、あなたの足が石に打ちつけられないように、彼らはあなたを手でささえるであろう』と書いてありますから」。"},{"ref":"Matt.4.7","start":40004007,"end":40004007,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[13,1,"しゅ"],[20,1,"かみ"],[22,1,"こころ"],[34,1,"か"]],"text":"イエスは彼に言われた、「『主なるあなたの神を試みてはならない』とまた書いてある」。"},{"ref":"Matt.4.8","start":40004008,"end":40004008,"break":"none","ruby":[[0,1,"つぎ"],[2,2,"あくま"],[10,2,"ひじょう"],[13,1,"たか"],[15,1,"やま"],[17,1,"つ"],[20,1,"い"],[25,1,"よ"],[31,2,"くにぐに"],[36,2,"えいが"],[40,1,"み"]],"text":"次に悪魔は、イエスを非常に高い山に連れて行き、この世のすべての国々とその栄華とを見せて"},{"ref":"Matt.4.9","start":40004009,"end":40004009,"break":"none","ruby":[[0,1,"い"],[14,1,"ふ"],[21,1,"おが"],[33,1,"みな"]],"text":"言った、「もしあなたが、ひれ伏してわたしを拝むなら、これらのものを皆あなたにあげましょう」。"},{"ref":"Matt.4.10","start":40004010,"end":40004010,"break":"none","ruby":[[7,1,"かれ"],[9,1,"い"],[20,1,"しりぞ"],[24,1,"しゅ"],[31,1,"かみ"],[33,1,"はい"],[38,1,"かみ"],[42,1,"つか"],[47,1,"か"]],"text":"するとイエスは彼に言われた、「サタンよ、退け。『主なるあなたの神を拝し、ただ神にのみ仕えよ』と書いてある」。"},{"ref":"Matt.4.11","start":40004011,"end":40004011,"break":"none","ruby":[[4,2,"あくま"],[11,1,"はな"],[13,1,"さ"],[20,2,"みつかい"],[31,1,"つか"]],"text":"そこで、悪魔はイエスを離れ去り、そして、御使たちがみもとにきて仕えた。"},{"ref":"Matt.4.12","start":40004012,"end":40004012,"break":"paragraph","ruby":[[11,1,"とら"],[17,1,"き"],[26,1,"しりぞ"]],"text":"さて、イエスはヨハネが捕えられたと聞いて、ガリラヤへ退かれた。"},{"ref":"Matt.4.13","start":40004013,"end":40004013,"break":"none","ruby":[[7,1,"さ"],[21,2,"ちほう"],[26,1,"うみ"],[29,1,"まち"],[36,1,"い"],[39,1,"す"]],"text":"そしてナザレを去り、ゼブルンとナフタリとの地方にある海べの町カペナウムに行って住まわれた。"},{"ref":"Matt.4.14","start":40004014,"end":40004014,"break":"none","ruby":[[3,3,"よげんしゃ"],[13,1,"い"],[17,1,"ことば"],[20,2,"じょうじゅ"]],"text":"これは預言者イザヤによって言われた言が、成就するためである。"},{"ref":"Matt.4.15","start":40004015,"end":40004015,"break":"stanza","breaks":[[15,"line"],[33,"line"]],"ruby":[[6,1,"ち"],[13,1,"ち"],[15,1,"うみ"],[17,1,"そ"],[19,2,"ちほう"],[27,1,"む"],[31,1,"ち"],[33,3,"いほうじん"]],"text":"「ゼブルンの地、ナフタリの地、海に沿う地方、ヨルダンの向こうの地、異邦人のガリラヤ、"},{"ref":"Matt.4.16","start":40004016,"end":40004016,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"あんこく"],[3,1,"なか"],[5,1,"す"],[10,1,"たみ"],[12,1,"おお"],[16,1,"ひかり"],[18,1,"み"],[20,1,"し"],[22,1,"ち"],[24,1,"し"],[26,1,"かげ"],[28,1,"す"],[33,2,"ひとびと"],[37,1,"ひかり"]],"text":"暗黒の中に住んでいる民は大いなる光を見、死の地、死の陰に住んでいる人々に、光がのぼった」。"},{"ref":"Matt.4.17","start":40004017,"end":40004017,"break":"line","ruby":[[2,1,"とき"],[9,1,"おしえ"],[11,1,"の"],[17,1,"い"],[23,1,"く"],[25,1,"あらた"],[29,2,"てんごく"],[32,1,"ちか"]],"text":"この時からイエスは教を宣べはじめて言われた、「悔い改めよ、天国は近づいた」。"},{"ref":"Matt.4.18","start":40004018,"end":40004018,"break":"paragraph","ruby":[[12,1,"うみ"],[15,1,"ある"],[28,2,"きょうだい"],[40,1,"よ"],[50,2,"きょうだい"],[59,1,"うみ"],[61,1,"あみ"],[63,1,"う"],[78,1,"かれ"],[81,2,"りょうし"]],"text":"さて、イエスがガリラヤの海べを歩いておられると、ふたりの兄弟、すなわち、ペテロと呼ばれたシモンとその兄弟アンデレとが、海に網を打っているのをごらんになった。彼らは漁師であった。"},{"ref":"Matt.4.19","start":40004019,"end":40004019,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[32,2,"にんげん"],[37,2,"りょうし"]],"text":"イエスは彼らに言われた、「わたしについてきなさい。あなたがたを、人間をとる漁師にしてあげよう」。"},{"ref":"Matt.4.20","start":40004020,"end":40004020,"break":"none","ruby":[[4,1,"かれ"],[10,1,"あみ"],[12,1,"す"],[20,1,"したが"]],"text":"すると、彼らはすぐに網を捨てて、イエスに従った。"},{"ref":"Matt.4.21","start":40004021,"end":40004021,"break":"none","ruby":[[4,1,"すす"],[7,1,"い"],[20,2,"きょうだい"],[33,1,"こ"],[40,2,"きょうだい"],[48,1,"ちち"],[54,2,"いっしょ"],[58,1,"ふね"],[60,1,"なか"],[62,1,"あみ"],[64,1,"つくろ"],[82,1,"かれ"],[86,1,"まね"]],"text":"そこから進んで行かれると、ほかのふたりの兄弟、すなわち、ゼベダイの子ヤコブとその兄弟ヨハネとが、父ゼベダイと一緒に、舟の中で網を繕っているのをごらんになった。そこで彼らをお招きになると、"},{"ref":"Matt.4.22","start":40004022,"end":40004022,"break":"none","ruby":[[2,1,"ふね"],[4,1,"ちち"],[15,1,"したが"],[18,1,"い"]],"text":"すぐ舟と父とをおいて、イエスに従って行った。"},{"ref":"Matt.4.23","start":40004023,"end":40004023,"break":"paragraph","ruby":[[9,1,"ぜん"],[10,1,"ち"],[12,1,"めぐ"],[14,1,"ある"],[18,1,"しょ"],[19,2,"かいどう"],[22,1,"おし"],[25,2,"みくに"],[28,2,"ふくいん"],[31,1,"の"],[33,1,"つた"],[36,1,"たみ"],[38,1,"なか"],[44,2,"びょうき"]],"text":"イエスはガリラヤの全地を巡り歩いて、諸会堂で教え、御国の福音を宣べ伝え、民の中のあらゆる病気、あらゆるわずらいをおいやしになった。"},{"ref":"Matt.4.24","start":40004024,"end":40004024,"break":"none","ruby":[[6,2,"ひょうばん"],[12,1,"ぜん"],[13,1,"ち"],[20,2,"ひとびと"],[27,1,"やまい"],[35,1,"もの"],[47,2,"びょうき"],[50,1,"くる"],[55,1,"なや"],[60,1,"もの"],[62,2,"あくれい"],[71,1,"もの"],[78,2,"ちゅうぶ"],[81,1,"もの"],[93,1,"つ"],[105,2,"ひとびと"]],"text":"そこで、その評判はシリヤ全地にひろまり、人々があらゆる病にかかっている者、すなわち、いろいろの病気と苦しみとに悩んでいる者、悪霊につかれている者、てんかん、中風の者などをイエスのところに連れてきたので、これらの人々をおいやしになった。"},{"ref":"Matt.4.25","start":40004025,"end":40004025,"break":"none","ruby":[[25,1,"およ"],[32,1,"む"],[44,2,"ぐんしゅう"],[53,1,"したが"]],"text":"こうして、ガリラヤ、デカポリス、エルサレム、ユダヤ及びヨルダンの向こうから、おびただしい群衆がきてイエスに従った。"}]