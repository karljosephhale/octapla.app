[{"ref":"Luke.11.1","start":42011001,"end":42011001,"break":"paragraph","ruby":[[9,1,"ところ"],[11,1,"いの"],[23,1,"おわ"],[29,2,"でし"],[36,1,"い"],[41,1,"しゅ"],[50,2,"でし"],[55,1,"おし"],[69,1,"いの"],[74,1,"おし"]],"text":"また、イエスはある所で祈っておられたが、それが終ったとき、弟子のひとりが言った、「主よ、ヨハネがその弟子たちに教えたように、わたしたちにも祈ることを教えてください」。"},{"ref":"Luke.11.2","start":42011002,"end":42011002,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[12,1,"いの"],[21,1,"い"],[28,1,"ちち"],[31,2,"みな"],[45,2,"みくに"]],"text":"そこで彼らに言われた、「祈るときには、こう言いなさい、『父よ、御名があがめられますように。御国がきますように。"},{"ref":"Luke.11.3","start":42011003,"end":42011003,"break":"none","ruby":[[6,1,"ひ"],[10,2,"しょくもつ"],[14,2,"ひび"],[17,1,"あた"]],"text":"わたしたちの日ごとの食物を、日々お与えください。"},{"ref":"Luke.11.4","start":42011004,"end":42011004,"break":"none","ruby":[[6,2,"ふさい"],[11,1,"もの"],[13,1,"みな"],[28,1,"つみ"],[46,1,"こころ"],[49,1,"あ"]],"text":"わたしたちに負債のある者を皆ゆるしますから、わたしたちの罪をもおゆるしください。わたしたちを試みに会わせないでください』」。"},{"ref":"Luke.11.5","start":42011005,"end":42011005,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[26,2,"ゆうじん"],[37,1,"ひと"],[43,3,"まよなか"],[47,1,"い"],[51,1,"とも"],[59,1,"か"]],"text":"そして彼らに言われた、「あなたがたのうちのだれかに、友人があるとして、その人のところへ真夜中に行き、『友よ、パンを三つ貸してください。"},{"ref":"Luke.11.6","start":42011006,"end":42011006,"break":"none","ruby":[[0,1,"とも"],[4,2,"たびさき"],[16,1,"つ"],[24,1,"なに"],[26,1,"だ"],[40,1,"い"],[43,2,"ばあい"]],"text":"友だちが旅先からわたしのところに着いたのですが、何も出すものがありませんから』と言った場合、"},{"ref":"Luke.11.7","start":42011007,"end":42011007,"break":"none","ruby":[[0,1,"かれ"],[2,1,"うち"],[7,2,"めんどう"],[20,1,"と"],[22,1,"し"],[31,2,"こども"],[40,2,"いっしょ"],[43,1,"とこ"],[56,1,"お"],[59,1,"なに"],[74,1,"い"]],"text":"彼は内から、『面倒をかけないでくれ。もう戸は締めてしまったし、子供たちもわたしと一緒に床にはいっているので、いま起きて何もあげるわけにはいかない』と言うであろう。"},{"ref":"Luke.11.8","start":42011008,"end":42011008,"break":"none","ruby":[[6,1,"き"],[12,2,"ゆうじん"],[23,1,"お"],[26,1,"あた"],[36,1,"ねが"],[41,1,"お"],[43,1,"あ"],[47,2,"ひつよう"],[53,1,"だ"]],"text":"しかし、よく聞きなさい、友人だからというのでは起きて与えないが、しきりに願うので、起き上がって必要なものを出してくれるであろう。"},{"ref":"Luke.11.9","start":42011009,"end":42011009,"break":"none","ruby":[[13,1,"い"],[16,1,"もと"],[26,1,"あた"],[36,1,"さが"],[44,1,"み"],[53,1,"もん"]],"text":"そこでわたしはあなたがたに言う。求めよ、そうすれば、与えられるであろう。捜せ、そうすれば見いだすであろう。門をたたけ、そうすれば、あけてもらえるであろう。"},{"ref":"Luke.11.10","start":42011010,"end":42011010,"break":"none","ruby":[[3,1,"もと"],[6,1,"もの"],[8,1,"え"],[10,1,"さが"],[12,1,"もの"],[14,1,"み"],[19,1,"もん"],[24,1,"もの"]],"text":"すべて求める者は得、捜す者は見いだし、門をたたく者はあけてもらえるからである。"},{"ref":"Luke.11.11","start":42011011,"end":42011011,"break":"none","ruby":[[10,1,"ちち"],[20,1,"こ"],[22,1,"うお"],[24,1,"もと"],[30,1,"うお"],[32,1,"かわ"],[38,1,"あた"]],"text":"あなたがたのうちで、父であるものは、その子が魚を求めるのに、魚の代りにへびを与えるだろうか。"},{"ref":"Luke.11.12","start":42011012,"end":42011012,"break":"none","ruby":[[0,1,"たまご"],[2,1,"もと"],[12,1,"あた"]],"text":"卵を求めるのに、さそりを与えるだろうか。"},{"ref":"Luke.11.13","start":42011013,"end":42011013,"break":"none","ruby":[[12,1,"わる"],[14,1,"もの"],[21,2,"じぶん"],[24,2,"こども"],[29,1,"よ"],[31,1,"おく"],[33,1,"もの"],[40,1,"し"],[50,1,"てん"],[52,1,"ちち"],[59,1,"もと"],[62,1,"く"],[64,1,"もの"],[66,2,"せいれい"],[69,1,"くだ"]],"text":"このように、あなたがたは悪い者であっても、自分の子供には、良い贈り物をすることを知っているとすれば、天の父はなおさら、求めて来る者に聖霊を下さらないことがあろうか」。"},{"ref":"Luke.11.14","start":42011014,"end":42011014,"break":"paragraph","ruby":[[7,2,"あくれい"],[10,1,"お"],[12,1,"だ"],[27,1,"れい"],[33,2,"あくれい"],[36,1,"で"],[38,1,"い"],[45,1,"もの"],[47,1,"い"],[58,2,"ぐんしゅう"],[61,3,"ふしぎ"],[65,1,"おも"]],"text":"さて、イエスが悪霊を追い出しておられた。それは、おしの霊であった。悪霊が出て行くと、おしが物を言うようになったので、群衆は不思議に思った。"},{"ref":"Luke.11.15","start":42011015,"end":42011015,"break":"none","ruby":[[2,1,"なか"],[6,2,"ひとびと"],[11,1,"かれ"],[13,2,"あくれい"],[29,2,"あくれい"],[34,1,"お"],[36,1,"だ"],[45,1,"い"]],"text":"その中のある人々が、「彼は悪霊のかしらベルゼブルによって、悪霊どもを追い出しているのだ」と言い、"},{"ref":"Luke.11.16","start":42011016,"end":42011016,"break":"none","ruby":[[5,2,"ひとびと"],[13,1,"こころ"],[21,1,"てん"],[29,1,"もと"]],"text":"またほかの人々は、イエスを試みようとして、天からのしるしを求めた。"},{"ref":"Luke.11.17","start":42011017,"end":42011017,"break":"none","ruby":[[8,1,"かれ"],[11,1,"おも"],[14,2,"みぬ"],[18,1,"い"],[28,1,"くに"],[30,2,"ないぶ"],[33,2,"ぶんれつ"],[38,2,"じめつ"],[48,1,"いえ"],[50,1,"わか"],[52,1,"あらそ"],[55,1,"たお"]],"text":"しかしイエスは、彼らの思いを見抜いて言われた、「おおよそ国が内部で分裂すれば自滅してしまい、また家が分れ争えば倒れてしまう。"},{"ref":"Luke.11.18","start":42011018,"end":42011018,"break":"none","ruby":[[7,2,"ないぶ"],[10,2,"ぶんれつ"],[18,1,"くに"],[24,1,"た"],[26,1,"い"],[50,2,"あくれい"],[53,1,"お"],[55,1,"だ"],[61,1,"い"]],"text":"そこでサタンも内部で分裂すれば、その国はどうして立ち行けよう。あなたがたはわたしがベルゼブルによって悪霊を追い出していると言うが、"},{"ref":"Luke.11.19","start":42011019,"end":42011019,"break":"none","ruby":[[15,2,"あくれい"],[18,1,"お"],[20,1,"だ"],[33,2,"なかま"],[42,1,"お"],[44,1,"だ"],[57,1,"かれ"],[69,1,"もの"]],"text":"もしわたしがベルゼブルによって悪霊を追い出すとすれば、あなたがたの仲間はだれによって追い出すのであろうか。だから、彼らがあなたがたをさばく者となるであろう。"},{"ref":"Luke.11.20","start":42011020,"end":42011020,"break":"none","ruby":[[8,1,"かみ"],[10,1,"ゆび"],[15,2,"あくれい"],[18,1,"お"],[20,1,"だ"],[29,1,"かみ"],[31,1,"くに"]],"text":"しかし、わたしが神の指によって悪霊を追い出しているのなら、神の国はすでにあなたがたのところにきたのである。"},{"ref":"Luke.11.21","start":42011021,"end":42011021,"break":"none","ruby":[[0,1,"つよ"],[2,1,"ひと"],[4,2,"じゅうぶん"],[7,2,"ぶそう"],[11,2,"じぶん"],[14,2,"ていたく"],[17,1,"まも"],[22,1,"かぎ"],[27,1,"も"],[29,1,"もの"],[31,2,"あんぜん"]],"text":"強い人が十分に武装して自分の邸宅を守っている限り、その持ち物は安全である。"},{"ref":"Luke.11.22","start":42011022,"end":42011022,"break":"none","ruby":[[7,1,"つよ"],[9,1,"もの"],[11,1,"おそ"],[16,1,"かれ"],[18,1,"う"],[20,1,"か"],[26,1,"たの"],[33,2,"ぶぐ"],[36,1,"うば"],[42,2,"ぶんどり"],[44,1,"ひん"],[46,1,"わ"]],"text":"しかし、もっと強い者が襲ってきて彼に打ち勝てば、その頼みにしていた武具を奪って、その分捕品を分けるのである。"},{"ref":"Luke.11.23","start":42011023,"end":42011023,"break":"none","ruby":[[4,2,"みかた"],[9,1,"もの"],[16,2,"はんたい"],[30,1,"とも"],[32,1,"あつ"],[36,1,"もの"],[39,1,"ち"]],"text":"わたしの味方でない者は、わたしに反対するものであり、わたしと共に集めない者は、散らすものである。"},{"ref":"Luke.11.24","start":42011024,"end":42011024,"break":"none","ruby":[[0,1,"けが"],[3,1,"れい"],[5,1,"ひと"],[8,1,"で"],[12,1,"やす"],[14,1,"ば"],[16,1,"もと"],[19,1,"みず"],[21,1,"な"],[23,1,"ところ"],[25,1,"ある"],[32,1,"み"],[41,1,"で"],[45,1,"もと"],[47,1,"いえ"],[49,1,"かえ"],[53,1,"い"]],"text":"汚れた霊が人から出ると、休み場を求めて水の無い所を歩きまわるが、見つからないので、出てきた元の家に帰ろうと言って、"},{"ref":"Luke.11.25","start":42011025,"end":42011025,"break":"none","ruby":[[0,1,"かえ"],[3,1,"み"],[9,1,"いえ"],[19,1,"うえ"],[21,1,"かざ"]],"text":"帰って見ると、その家はそうじがしてある上、飾りつけがしてあった。"},{"ref":"Luke.11.26","start":42011026,"end":42011026,"break":"none","ruby":[[5,1,"で"],[7,1,"い"],[11,2,"じぶん"],[13,2,"いじょう"],[16,1,"わる"],[18,1,"た"],[23,1,"れい"],[25,1,"ひ"],[27,1,"つ"],[32,1,"なか"],[41,1,"す"],[43,1,"こ"],[54,1,"ひと"],[56,1,"のち"],[58,2,"じょうたい"],[61,1,"はじ"],[69,1,"わる"]],"text":"そこでまた出て行って、自分以上に悪い他の七つの霊を引き連れてきて中にはいり、そこに住み込む。そうすると、その人の後の状態は初めよりももっと悪くなるのである」。"},{"ref":"Luke.11.27","start":42011027,"end":42011027,"break":"paragraph","ruby":[[6,1,"はな"],[16,2,"ぐんしゅう"],[19,1,"なか"],[26,1,"おんな"],[28,1,"こえ"],[30,1,"は"],[35,1,"い"],[44,1,"やど"],[47,1,"たい"],[53,1,"す"],[57,2,"ちぶさ"]],"text":"イエスがこう話しておられるとき、群衆の中からひとりの女が声を張りあげて言った、「あなたを宿した胎、あなたが吸われた乳房は、なんとめぐまれていることでしょう」。"},{"ref":"Luke.11.28","start":42011028,"end":42011028,"break":"none","ruby":[[7,1,"い"],[30,1,"かみ"],[32,1,"ことば"],[34,1,"き"],[40,1,"まも"],[42,1,"ひと"]],"text":"しかしイエスは言われた、「いや、めぐまれているのは、むしろ、神の言を聞いてそれを守る人たちである」。"},{"ref":"Luke.11.29","start":42011029,"end":42011029,"break":"paragraph","ruby":[[2,2,"ぐんしゅう"],[5,1,"むら"],[8,1,"あつ"],[19,1,"かた"],[21,1,"だ"],[29,2,"じだい"],[32,2,"じゃあく"],[35,2,"じだい"],[48,1,"もと"],[72,1,"あた"]],"text":"さて群衆が群がり集まったので、イエスは語り出された、「この時代は邪悪な時代である。それはしるしを求めるが、ヨナのしるしのほかには、なんのしるしも与えられないであろう。"},{"ref":"Luke.11.30","start":42011030,"end":42011030,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"たい"],[30,1,"ひと"],[32,1,"こ"],[36,2,"じだい"],[39,1,"たい"]],"text":"というのは、ニネベの人々に対してヨナがしるしとなったように、人の子もこの時代に対してしるしとなるであろう。"},{"ref":"Luke.11.31","start":42011031,"end":42011031,"break":"none","ruby":[[0,1,"みなみ"],[2,2,"じょおう"],[6,1,"いま"],[8,2,"じだい"],[11,2,"ひとびと"],[14,1,"とも"],[20,1,"ば"],[22,1,"た"],[26,1,"かれ"],[29,1,"つみ"],[31,1,"さだ"],[44,2,"かのじょ"],[52,2,"ちえ"],[55,1,"き"],[61,1,"ち"],[63,1,"はて"],[81,1,"み"],[92,1,"もの"]],"text":"南の女王が、今の時代の人々と共にさばきの場に立って、彼らを罪に定めるであろう。なぜなら、彼女はソロモンの知恵を聞くために、地の果からはるばるきたからである。しかし見よ、ソロモンにまさる者がここにいる。"},{"ref":"Luke.11.32","start":42011032,"end":42011032,"break":"none","ruby":[[4,2,"ひとびと"],[8,1,"いま"],[10,2,"じだい"],[13,2,"ひとびと"],[16,1,"とも"],[22,1,"ば"],[24,1,"た"],[28,1,"かれ"],[31,1,"つみ"],[33,1,"さだ"],[50,2,"ひとびと"],[56,2,"せんきょう"],[62,1,"く"],[64,1,"あらた"],[76,1,"み"],[85,1,"もの"]],"text":"ニネベの人々が、今の時代の人々と共にさばきの場に立って、彼らを罪に定めるであろう。なぜなら、ニネベの人々はヨナの宣教によって悔い改めたからである。しかし見よ、ヨナにまさる者がここにいる。"},{"ref":"Luke.11.33","start":42011033,"end":42011033,"break":"paragraph","ruby":[[15,2,"あなぐら"],[18,1,"なか"],[20,1,"ます"],[22,1,"した"],[24,1,"お"],[40,1,"く"],[42,1,"ひと"],[53,1,"み"],[60,2,"しょくだい"],[63,1,"うえ"]],"text":"だれもあかりをともして、それを穴倉の中や枡の下に置くことはしない。むしろはいって来る人たちに、そのあかりが見えるように、燭台の上におく。"},{"ref":"Luke.11.34","start":42011034,"end":42011034,"break":"none","ruby":[[4,1,"め"],[22,1,"め"],[24,1,"す"],[31,2,"ぜんしん"],[34,1,"あか"],[39,1,"め"],[51,1,"くら"]],"text":"あなたの目は、からだのあかりである。あなたの目が澄んでおれば、全身も明るいが、目がわるければ、からだも暗い。"},{"ref":"Luke.11.35","start":42011035,"end":42011035,"break":"none","ruby":[[8,1,"うち"],[11,1,"ひかり"],[13,1,"くら"],[22,2,"ちゅうい"]],"text":"だから、あなたの内なる光が暗くならないように注意しなさい。"},{"ref":"Luke.11.36","start":42011036,"end":42011036,"break":"none","ruby":[[10,2,"ぜんたい"],[13,1,"あか"],[18,1,"くら"],[20,2,"ぶぶん"],[23,1,"すこ"],[40,1,"かがや"],[47,1,"てら"],[49,1,"とき"],[55,2,"ぜんしん"],[58,1,"あか"]],"text":"もし、あなたのからだ全体が明るくて、暗い部分が少しもなければ、ちょうど、あかりが輝いてあなたを照す時のように、全身が明るくなるであろう」。"},{"ref":"Luke.11.37","start":42011037,"end":42011037,"break":"paragraph","ruby":[[4,1,"かた"],[11,1,"とき"],[19,1,"びと"],[22,2,"じぶん"],[25,1,"いえ"],[27,2,"しょくじ"],[39,1,"もう"],[41,1,"で"],[50,2,"しょくたく"]],"text":"イエスが語っておられた時、あるパリサイ人が、自分の家で食事をしていただきたいと申し出たので、はいって食卓につかれた。"},{"ref":"Luke.11.38","start":42011038,"end":42011038,"break":"none","ruby":[[5,2,"しょくぜん"],[10,1,"あら"],[24,1,"み"],[33,1,"びと"],[35,3,"ふしぎ"],[39,1,"おも"]],"text":"ところが、食前にまず洗うことをなさらなかったのを見て、そのパリサイ人が不思議に思った。"},{"ref":"Luke.11.39","start":42011039,"end":42011039,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"かれ"],[7,1,"い"],[27,1,"びと"],[30,1,"さかずき"],[32,1,"ぼん"],[34,2,"そとがわ"],[49,2,"うちがわ"],[52,2,"どんよく"],[55,2,"じゃあく"],[59,1,"み"]],"text":"そこで主は彼に言われた、「いったい、あなたがたパリサイ人は、杯や盆の外側をきよめるが、あなたがたの内側は貪欲と邪悪とで満ちている。"},{"ref":"Luke.11.40","start":42011040,"end":42011040,"break":"none","ruby":[[0,1,"おろ"],[3,1,"もの"],[8,2,"そとがわ"],[11,1,"つく"],[20,2,"うちがわ"],[23,1,"つく"]],"text":"愚かな者たちよ、外側を造ったかたは、また内側も造られたではないか。"},{"ref":"Luke.11.41","start":42011041,"end":42011041,"break":"none","ruby":[[3,2,"うちがわ"],[39,1,"きよ"]],"text":"ただ、内側にあるものをきよめなさい。そうすれば、いっさいがあなたがたにとって、清いものとなる。"},{"ref":"Luke.11.42","start":42011042,"end":42011042,"break":"paragraph","ruby":[[7,1,"ほう"],[12,1,"びと"],[29,1,"こう"],[35,2,"やさい"],[41,1,"ぶん"],[45,1,"みや"],[47,1,"おさ"],[56,1,"ぎ"],[58,1,"かみ"],[60,1,"たい"],[63,1,"あい"],[94,1,"おこな"]],"text":"しかし、あなた方パリサイ人は、わざわいである。はっか、うん香、あらゆる野菜などの十分の一を宮に納めておりながら、義と神に対する愛とをなおざりにしている。それもなおざりにはできないが、これは行わねばならない。"},{"ref":"Luke.11.43","start":42011043,"end":42011043,"break":"none","ruby":[[9,1,"びと"],[20,2,"かいどう"],[23,2,"じょうせき"],[26,2,"ひろば"],[30,2,"けいれい"],[33,1,"この"]],"text":"あなたがたパリサイ人は、わざわいである。会堂の上席や広場での敬礼を好んでいる。"},{"ref":"Luke.11.44","start":42011044,"end":42011044,"break":"none","ruby":[[15,2,"ひとめ"],[22,1,"はか"],[35,1,"うえ"],[37,1,"ある"],[41,2,"ひとびと"],[44,1,"き"]],"text":"あなたがたは、わざわいである。人目につかない墓のようなものである。その上を歩いても人々は気づかないでいる」。"},{"ref":"Luke.11.45","start":42011045,"end":42011045,"break":"paragraph","ruby":[[4,2,"りっぽう"],[6,2,"がくしゃ"],[13,1,"こた"],[16,1,"い"],[21,2,"せんせい"],[30,1,"い"],[45,2,"ぶじょく"]],"text":"ひとりの律法学者がイエスに答えて言った、「先生、そんなことを言われるのは、わたしたちまでも侮辱することです」。"},{"ref":"Luke.11.46","start":42011046,"end":42011046,"break":"none","ruby":[[3,1,"い"],[14,2,"りっぽう"],[16,2,"がくしゃ"],[28,1,"お"],[30,1,"き"],[34,2,"おもに"],[37,1,"ひと"],[39,1,"お"],[46,2,"じぶん"],[52,1,"に"],[54,1,"ゆび"],[56,1,"ぽん"],[59,1,"ふ"]],"text":"そこで言われた、「あなたがた律法学者も、わざわいである。負い切れない重荷を人に負わせながら、自分ではその荷に指一本でも触れようとしない。"},{"ref":"Luke.11.47","start":42011047,"end":42011047,"break":"none","ruby":[[15,3,"よげんしゃ"],[21,1,"ひ"],[23,1,"た"],[31,1,"かれ"],[34,1,"ころ"],[46,2,"せんぞ"]],"text":"あなたがたは、わざわいである。預言者たちの碑を建てるが、しかし彼らを殺したのは、あなたがたの先祖であったのだ。"},{"ref":"Luke.11.48","start":42011048,"end":42011048,"break":"none","ruby":[[11,2,"じぶん"],[14,2,"せんぞ"],[21,2,"どうい"],[25,2,"しょうにん"],[31,2,"せんぞ"],[34,1,"かれ"],[37,1,"ころ"],[48,1,"ひ"],[50,1,"た"]],"text":"だから、あなたがたは、自分の先祖のしわざに同意する証人なのだ。先祖が彼らを殺し、あなたがたがその碑を建てるのだから。"},{"ref":"Luke.11.49","start":42011049,"end":42011049,"break":"none","ruby":[[7,1,"かみ"],[9,2,"ちえ"],[13,1,"い"],[24,3,"よげんしゃ"],[28,2,"しと"],[32,1,"かれ"],[41,1,"かれ"],[51,1,"もの"],[53,1,"ころ"],[58,2,"はくがい"]],"text":"それゆえに、『神の知恵』も言っている、『わたしは預言者と使徒とを彼らにつかわすが、彼らはそのうちのある者を殺したり、迫害したりするであろう』。"},{"ref":"Luke.11.50","start":42011050,"end":42011050,"break":"none","ruby":[[8,1,"ち"],[11,2,"さいだん"],[14,2,"しんでん"],[18,1,"あいだ"],[20,1,"ころ"],[29,1,"ち"],[31,1,"いた"],[36,1,"よ"],[38,1,"はじ"],[42,1,"なが"],[52,3,"よげんしゃ"],[56,1,"ち"],[64,2,"じだい"],[69,2,"せきにん"],[72,1,"と"]],"text":"それで、アベルの血から祭壇と神殿との間で殺されたザカリヤの血に至るまで、世の初めから流されてきたすべての預言者の血について、この時代がその責任を問われる。"},{"ref":"Luke.11.51","start":42011051,"end":42011051,"break":"none","ruby":[[10,1,"い"],[18,2,"じだい"],[23,2,"せきにん"],[26,1,"と"]],"text":"そうだ、あなたがたに言っておく、この時代がその責任を問われるであろう。"},{"ref":"Luke.11.52","start":42011052,"end":42011052,"break":"none","ruby":[[5,2,"りっぽう"],[7,2,"がくしゃ"],[19,2,"ちしき"],[25,1,"と"],[31,2,"じぶん"],[51,1,"ひと"],[55,1,"さまた"]],"text":"あなたがた律法学者は、わざわいである。知識のかぎを取りあげて、自分がはいらないばかりか、はいろうとする人たちを妨げてきた」。"},{"ref":"Luke.11.53","start":42011053,"end":42011053,"break":"paragraph","ruby":[[7,1,"で"],[9,1,"い"],[15,2,"りっぽう"],[17,2,"がくしゃ"],[24,1,"びと"],[27,1,"はげ"],[30,1,"つ"],[32,1,"よ"],[40,1,"こと"],[42,1,"と"]],"text":"イエスがそこを出て行かれると、律法学者やパリサイ人は、激しく詰め寄り、いろいろな事を問いかけて、"},{"ref":"Luke.11.54","start":42011054,"end":42011054,"break":"none","ruby":[[4,1,"くち"],[7,1,"なに"],[9,1,"い"],[15,1,"え"]],"text":"イエスの口から何か言いがかりを得ようと、ねらいはじめた。"}]