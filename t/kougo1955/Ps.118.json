[{"ref":"Ps.118.1","start":19118001,"end":19118001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"かんしゃ"],[7,1,"しゅ"],[9,1,"めぐ"],[28,1,"た"]],"text":"主に感謝せよ、主は恵みふかく、そのいつくしみはとこしえに絶えることがない。"},{"ref":"Ps.118.2","start":19118002,"end":19118002,"break":"line","breaks":[[9,"line"]],"ruby":[[6,1,"い"],[23,1,"た"]],"text":"イスラエルは言え、「そのいつくしみはとこしえに絶えることがない」と。"},{"ref":"Ps.118.3","start":19118003,"end":19118003,"break":"line","breaks":[[9,"line"]],"ruby":[[4,1,"いえ"],[6,1,"い"],[23,1,"た"]],"text":"アロンの家は言え、「そのいつくしみはとこしえに絶えることがない」と。"},{"ref":"Ps.118.4","start":19118004,"end":19118004,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"もの"],[8,1,"い"],[25,1,"た"]],"text":"主をおそれる者は言え、「そのいつくしみはとこしえに絶えることがない」と。"},{"ref":"Ps.118.5","start":19118005,"end":19118005,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"なや"],[11,1,"しゅ"],[13,1,"よ"],[17,1,"しゅ"],[19,1,"こた"],[27,1,"ひろ"],[29,1,"ところ"],[31,1,"お"]],"text":"わたしが悩みのなかから主を呼ぶと、主は答えて、わたしを広い所に置かれた。"},{"ref":"Ps.118.6","start":19118006,"end":19118006,"break":"line","breaks":[[14,"line"],[23,"line"]],"ruby":[[0,1,"しゅ"],[6,2,"みかた"],[14,1,"おそ"],[23,1,"ひと"],[29,1,"なに"],[33,1,"え"]],"text":"主がわたしに味方されるので、恐れることはない。人はわたしに何をなし得ようか。"},{"ref":"Ps.118.7","start":19118007,"end":19118007,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[6,2,"みかた"],[14,1,"たす"],[26,1,"にく"],[28,1,"もの"],[34,1,"ねが"],[37,1,"み"]],"text":"主はわたしに味方し、わたしを助けられるので、わたしを憎む者についての願いを見るであろう。"},{"ref":"Ps.118.8","start":19118008,"end":19118008,"break":"line","ruby":[[0,1,"しゅ"],[2,1,"よ"],[4,1,"たの"],[7,1,"ひと"],[15,1,"よ"]],"text":"主に寄り頼むは人にたよるよりも良い。"},{"ref":"Ps.118.9","start":19118009,"end":19118009,"break":"line","ruby":[[0,1,"しゅ"],[2,1,"よ"],[4,1,"たの"],[12,1,"きみ"],[20,1,"よ"]],"text":"主に寄り頼むはもろもろの君にたよるよりも良い。"},{"ref":"Ps.118.10","start":19118010,"end":19118010,"break":"line","breaks":[[16,"line"]],"ruby":[[5,2,"くにたみ"],[12,1,"かこ"],[20,1,"しゅ"],[23,1,"な"],[28,1,"かれ"],[31,1,"ほろ"]],"text":"もろもろの国民はわたしを囲んだ。わたしは主のみ名によって彼らを滅ぼす。"},{"ref":"Ps.118.11","start":19118011,"end":19118011,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[7,1,"かこ"],[15,1,"かこ"],[23,1,"しゅ"],[26,1,"な"],[31,1,"かれ"],[34,1,"ほろ"]],"text":"彼らはわたしを囲んだ、わたしを囲んだ。わたしは主のみ名によって彼らを滅ぼす。"},{"ref":"Ps.118.12","start":19118012,"end":19118012,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[0,1,"かれ"],[3,1,"はち"],[12,1,"かこ"],[19,1,"ひ"],[24,1,"も"],[34,1,"しゅ"],[37,1,"な"],[42,1,"かれ"],[45,1,"ほろ"]],"text":"彼らは蜂のようにわたしを囲み、いばらの火のように燃えたった。わたしは主のみ名によって彼らを滅ぼす。"},{"ref":"Ps.118.13","start":19118013,"end":19118013,"break":"line","breaks":[[20,"line"]],"ruby":[[7,1,"お"],[11,1,"たお"],[20,1,"しゅ"],[26,1,"たす"]],"text":"わたしはひどく押されて倒れようとしたが、主はわたしを助けられた。"},{"ref":"Ps.118.14","start":19118014,"end":19118014,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"ちから"],[8,1,"うた"],[16,1,"すくい"]],"text":"主はわが力、わが歌であって、わが救となられた。"},{"ref":"Ps.118.15","start":19118015,"end":19118015,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"き"],[3,2,"しょうり"],[6,1,"よろこ"],[10,1,"うた"],[12,1,"ただ"],[15,1,"もの"],[17,2,"てんまく"],[24,1,"しゅ"],[26,1,"みぎ"],[28,1,"て"],[30,1,"いさ"]],"text":"聞け、勝利の喜ばしい歌が正しい者の天幕にある。「主の右の手は勇ましいはたらきをなし、"},{"ref":"Ps.118.16","start":19118016,"end":19118016,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"みぎ"],[4,1,"て"],[6,1,"たか"],[12,1,"しゅ"],[14,1,"みぎ"],[16,1,"て"],[18,1,"いさ"]],"text":"主の右の手は高くあがり、主の右の手は勇ましいはたらきをなす」。"},{"ref":"Ps.118.17","start":19118017,"end":19118017,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"し"],[11,1,"い"],[19,1,"しゅ"],[25,2,"ものがた"]],"text":"わたしは死ぬことなく、生きながらえて、主のみわざを物語るであろう。"},{"ref":"Ps.118.18","start":19118018,"end":19118018,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"こ"],[16,1,"し"]],"text":"主はいたくわたしを懲らされたが、死にはわたされなかった。"},{"ref":"Ps.118.19","start":19118019,"end":19118019,"break":"line","breaks":[[14,"line"]],"ruby":[[7,1,"ぎ"],[9,1,"もん"],[11,1,"ひら"],[20,1,"うち"],[27,1,"しゅ"],[29,2,"かんしゃ"]],"text":"わたしのために義の門を開け、わたしはその内にはいって、主に感謝しよう。"},{"ref":"Ps.118.20","start":19118020,"end":19118020,"break":"line","breaks":[[10,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"もん"],[10,1,"ただ"],[13,1,"もの"],[17,1,"うち"]],"text":"これは主の門である。正しい者はその内にはいるであろう。"},{"ref":"Ps.118.21","start":19118021,"end":19118021,"break":"line","breaks":[[14,"line"]],"ruby":[[8,2,"かんしゃ"],[22,1,"こた"],[28,1,"すくい"]],"text":"わたしはあなたに感謝します。あなたがわたしに答えて、わが救となられたことを。"},{"ref":"Ps.118.22","start":19118022,"end":19118022,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"いえ"],[1,1,"つく"],[5,1,"す"],[8,1,"いし"],[10,1,"すみ"],[15,1,"いし"]],"text":"家造りらの捨てた石は隅のかしら石となった。"},{"ref":"Ps.118.23","start":19118023,"end":19118023,"break":"line","breaks":[[11,"line"]],"ruby":[[3,1,"しゅ"],[9,1,"こと"],[15,1,"め"],[18,1,"おどろ"],[22,1,"こと"]],"text":"これは主のなされた事でわれらの目には驚くべき事である。"},{"ref":"Ps.118.24","start":19118024,"end":19118024,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"もう"],[10,1,"ひ"],[22,1,"ひ"],[24,1,"よろこ"],[26,1,"たの"]],"text":"これは主が設けられた日であって、われらはこの日に喜び楽しむであろう。"},{"ref":"Ps.118.25","start":19118025,"end":19118025,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"すく"],[18,1,"しゅ"],[28,1,"さか"]],"text":"主よ、どうぞわれらをお救いください。主よ、どうぞわれらを栄えさせてください。"},{"ref":"Ps.118.26","start":19118026,"end":19118026,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"な"],[11,1,"もの"],[25,1,"しゅ"],[27,1,"いえ"]],"text":"主のみ名によってはいる者はさいわいである。われらは主の家からあなたをたたえます。"},{"ref":"Ps.118.27","start":19118027,"end":19118027,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かみ"],[12,1,"てら"],[17,1,"えだ"],[19,1,"たずさ"],[22,1,"まつり"],[24,2,"ぎょうれつ"],[27,2,"さいだん"],[30,1,"つの"],[34,1,"すす"]],"text":"主は神であって、われらを照された。枝を携えて祭の行列を祭壇の角にまで進ませよ。"},{"ref":"Ps.118.28","start":19118028,"end":19118028,"break":"line","breaks":[[22,"line"]],"ruby":[[6,1,"かみ"],[16,2,"かんしゃ"],[28,1,"かみ"]],"text":"あなたはわが神、わたしはあなたに感謝します。あなたはわが神、わたしはあなたをあがめます。"},{"ref":"Ps.118.29","start":19118029,"end":19118029,"break":"line","breaks":[[15,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"かんしゃ"],[7,1,"しゅ"],[9,1,"めぐ"],[28,1,"た"]],"text":"主に感謝せよ、主は恵みふかく、そのいつくしみはとこしえに絶えることがない。"}]