[{"ref":"Matt.21.1","start":40021001,"end":40021001,"break":"paragraph","ruby":[[3,1,"かれ"],[12,1,"ちか"],[19,1,"やま"],[20,1,"ぞ"],[28,1,"つ"],[42,2,"でし"],[50,1,"い"]],"text":"さて、彼らがエルサレムに近づき、オリブ山沿いのベテパゲに着いたとき、イエスはふたりの弟子をつかわして言われた、"},{"ref":"Matt.21.2","start":40021002,"end":40021002,"break":"none","ruby":[[1,1,"む"],[5,1,"むら"],[7,1,"い"],[30,1,"こ"],[41,1,"み"],[51,1,"と"],[62,1,"ひ"]],"text":"「向こうの村へ行きなさい。するとすぐ、ろばがつながれていて、子ろばがそばにいるのを見るであろう。それを解いてわたしのところに引いてきなさい。"},{"ref":"Matt.21.3","start":40021003,"end":40021003,"break":"none","ruby":[[13,1,"なに"],[15,1,"い"],[21,1,"しゅ"],[24,1,"い"],[26,1,"よう"],[33,1,"い"],[41,1,"い"],[47,1,"わた"]],"text":"もしだれかが、あなたがたに何か言ったなら、主がお入り用なのです、と言いなさい。そう言えば、すぐ渡してくれるであろう」。"},{"ref":"Matt.21.4","start":40021004,"end":40021004,"break":"none","ruby":[[7,3,"よげんしゃ"],[14,1,"い"],[22,2,"じょうじゅ"]],"text":"こうしたのは、預言者によって言われたことが、成就するためである。"},{"ref":"Matt.21.5","start":40021005,"end":40021005,"break":"none","breaks":[[5,"stanza"],[16,"line"],[32,"line"],[47,"line"]],"ruby":[[10,1,"むすめ"],[12,1,"つ"],[16,1,"み"],[23,1,"おう"],[32,2,"にゅうわ"],[43,1,"の"],[51,1,"お"],[56,1,"こ"],[58,1,"の"]],"text":"すなわち、「シオンの娘に告げよ、見よ、あなたの王がおいでになる、柔和なおかたで、ろばに乗って、くびきを負うろばの子に乗って」。"},{"ref":"Matt.21.6","start":40021006,"end":40021006,"break":"none","ruby":[[0,2,"でし"],[5,1,"で"],[7,1,"い"],[16,1,"めい"]],"text":"弟子たちは出て行って、イエスがお命じになったとおりにし、"},{"ref":"Matt.21.7","start":40021007,"end":40021007,"break":"none","ruby":[[3,1,"こ"],[8,1,"ひ"],[19,1,"うえ"],[21,2,"じぶん"],[26,2,"うわぎ"],[42,1,"の"]],"text":"ろばと子ろばとを引いてきた。そしてその上に自分たちの上着をかけると、イエスはそれにお乗りになった。"},{"ref":"Matt.21.8","start":40021008,"end":40021008,"break":"none","ruby":[[0,2,"ぐんしゅう"],[5,1,"おお"],[8,1,"もの"],[10,2,"じぶん"],[15,2,"うわぎ"],[18,1,"みち"],[20,1,"し"],[29,1,"もの"],[33,1,"き"],[35,1,"えだ"],[37,1,"き"],[42,1,"みち"],[44,1,"し"]],"text":"群衆のうち多くの者は自分たちの上着を道に敷き、また、ほかの者たちは木の枝を切ってきて道に敷いた。"},{"ref":"Matt.21.9","start":40021009,"end":40021009,"break":"none","breaks":[[31,"stanza"],[43,"line"],[62,"line"]],"ruby":[[3,2,"ぐんしゅう"],[7,1,"まえ"],[9,1,"ゆ"],[11,1,"もの"],[17,1,"したが"],[19,1,"もの"],[22,1,"とも"],[24,1,"さけ"],[36,1,"こ"],[43,1,"しゅ"],[45,2,"みな"],[54,1,"もの"],[57,2,"しゅくふく"],[64,1,"たか"],[66,1,"ところ"]],"text":"そして群衆は、前に行く者も、あとに従う者も、共に叫びつづけた、「ダビデの子に、ホサナ。主の御名によってきたる者に、祝福あれ。いと高き所に、ホサナ」。"},{"ref":"Matt.21.10","start":40021010,"end":40021010,"break":"none","ruby":[[14,1,"い"],[21,2,"まちじゅう"],[28,1,"さわ"],[30,1,"た"],[51,1,"い"]],"text":"イエスがエルサレムにはいって行かれたとき、町中がこぞって騒ぎ立ち、「これは、いったい、どなただろう」と言った。"},{"ref":"Matt.21.11","start":40021011,"end":40021011,"break":"none","ruby":[[3,2,"ぐんしゅう"],[10,1,"ひと"],[22,1,"で"],[24,3,"よげんしゃ"],[35,1,"い"]],"text":"そこで群衆は、「この人はガリラヤのナザレから出た預言者イエスである」と言った。"},{"ref":"Matt.21.12","start":40021012,"end":40021012,"break":"paragraph","ruby":[[9,1,"みや"],[21,1,"みや"],[23,1,"にわ"],[25,1,"う"],[27,1,"か"],[33,2,"ひとびと"],[38,1,"お"],[40,1,"だ"],[45,3,"りょうがえにん"],[49,1,"だい"],[55,1,"う"],[57,1,"もの"],[59,2,"こしかけ"]],"text":"それから、イエスは宮にはいられた。そして、宮の庭で売り買いしていた人々をみな追い出し、また両替人の台や、はとを売る者の腰掛をくつがえされた。"},{"ref":"Matt.21.13","start":40021013,"end":40021013,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[17,1,"いえ"],[20,1,"いのり"],[22,1,"いえ"],[36,1,"か"],[57,2,"ごうとう"],[60,1,"す"]],"text":"そして彼らに言われた、「『わたしの家は、祈の家ととなえらるべきである』と書いてある。それだのに、あなたがたはそれを強盗の巣にしている」。"},{"ref":"Matt.21.14","start":40021014,"end":40021014,"break":"none","ruby":[[4,1,"みや"],[6,1,"にわ"],[9,2,"もうじん"],[12,1,"あし"],[25,1,"かれ"]],"text":"そのとき宮の庭で、盲人や足なえがみもとにきたので、彼らをおいやしになった。"},{"ref":"Matt.21.15","start":40021015,"end":40021015,"break":"none","ruby":[[4,3,"さいしちょう"],[8,2,"りっぽう"],[10,2,"がくしゃ"],[24,3,"ふしぎ"],[31,1,"み"],[35,1,"みや"],[37,1,"にわ"],[44,1,"こ"],[52,1,"さけ"],[57,2,"こども"],[62,1,"み"],[64,2,"りっぷく"]],"text":"しかし、祭司長、律法学者たちは、イエスがなされた不思議なわざを見、また宮の庭で「ダビデの子に、ホサナ」と叫んでいる子供たちを見て立腹し、"},{"ref":"Matt.21.16","start":40021016,"end":40021016,"break":"none","ruby":[[4,1,"い"],[11,1,"こ"],[15,1,"なに"],[17,1,"い"],[26,1,"き"],[37,1,"かれ"],[40,1,"い"],[50,1,"き"],[63,1,"おさ"],[65,1,"ご"],[67,1,"ち"],[70,1,"ご"],[74,1,"くち"],[80,1,"そな"],[91,1,"よ"]],"text":"イエスに言った、「あの子たちが何を言っているのか、お聞きですか」。イエスは彼らに言われた、「そうだ、聞いている。あなたがたは『幼な子、乳のみ子たちの口にさんびを備えられた』とあるのを読んだことがないのか」。"},{"ref":"Matt.21.17","start":40021017,"end":40021017,"break":"none","ruby":[[9,1,"かれ"],[15,1,"のこ"],[18,1,"みやこ"],[20,1,"で"],[27,1,"い"],[33,1,"よ"],[35,1,"す"]],"text":"それから、イエスは彼らをあとに残し、都を出てベタニヤに行き、そこで夜を過ごされた。"},{"ref":"Matt.21.18","start":40021018,"end":40021018,"break":"paragraph","ruby":[[0,1,"あさ"],[4,1,"みやこ"],[6,1,"かえ"],[15,2,"くうふく"]],"text":"朝はやく都に帰るとき、イエスは空腹をおぼえられた。"},{"ref":"Matt.21.19","start":40021019,"end":40021019,"break":"none","ruby":[[4,1,"みち"],[12,1,"ぽん"],[19,1,"き"],[25,1,"み"],[31,1,"い"],[39,1,"は"],[44,1,"なに"],[46,2,"みあた"],[59,1,"き"],[67,1,"いま"],[70,1,"のち"],[82,1,"み"],[93,1,"い"],[107,1,"き"],[113,1,"か"]],"text":"そして、道のかたわらに一本のいちじくの木があるのを見て、そこに行かれたが、ただ葉のほかは何も見当らなかった。そこでその木にむかって、「今から後いつまでも、おまえには実がならないように」と言われた。すると、いちじくの木はたちまち枯れた。"},{"ref":"Matt.21.20","start":40021020,"end":40021020,"break":"none","ruby":[[0,2,"でし"],[8,1,"み"],[11,1,"おどろ"],[14,1,"い"],[34,1,"か"]],"text":"弟子たちはこれを見て、驚いて言った、「いちじくがどうして、こうすぐに枯れたのでしょう」。"},{"ref":"Matt.21.21","start":40021021,"end":40021021,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[15,1,"き"],[32,1,"しん"],[35,1,"うたが"],[72,1,"やま"],[79,1,"うご"],[81,1,"だ"],[84,1,"うみ"],[86,1,"なか"],[92,1,"い"]],"text":"イエスは答えて言われた、「よく聞いておくがよい。もしあなたがたが信じて疑わないならば、このいちじくにあったようなことが、できるばかりでなく、この山にむかって、動き出して海の中にはいれと言っても、そのとおりになるであろう。"},{"ref":"Matt.21.22","start":40021022,"end":40021022,"break":"none","ruby":[[3,1,"いのり"],[8,1,"しん"],[11,1,"もと"],[20,1,"あた"]],"text":"また、祈のとき、信じて求めるものは、みな与えられるであろう」。"},{"ref":"Matt.21.23","start":40021023,"end":40021023,"break":"paragraph","ruby":[[4,1,"みや"],[14,3,"さいしちょう"],[20,1,"たみ"],[22,2,"ちょうろう"],[30,1,"おし"],[37,1,"ところ"],[41,1,"い"],[46,1,"なに"],[48,2,"けんい"],[59,1,"こと"],[76,2,"けんい"],[79,1,"さづ"]],"text":"イエスが宮にはいられたとき、祭司長たちや民の長老たちが、その教えておられる所にきて言った、「何の権威によって、これらの事をするのですか。だれが、そうする権威を授けたのですか」。"},{"ref":"Matt.21.24","start":40021024,"end":40021024,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[24,1,"たず"],[38,1,"こた"],[52,1,"なに"],[54,2,"けんい"],[64,1,"こと"],[77,1,"い"]],"text":"そこでイエスは彼らに言われた、「わたしも一つだけ尋ねよう。あなたがたがそれに答えてくれたなら、わたしも、何の権威によってこれらの事をするのか、あなたがたに言おう。"},{"ref":"Matt.21.25","start":40021025,"end":40021025,"break":"none","ruby":[[23,1,"てん"],[32,1,"ひと"],[46,1,"かれ"],[49,1,"たがい"],[51,1,"ろん"],[54,1,"い"],[61,1,"てん"],[66,1,"い"],[75,1,"かれ"],[77,1,"しん"],[91,1,"い"]],"text":"ヨハネのバプテスマはどこからきたのであったか。天からであったか、人からであったか」。すると、彼らは互に論じて言った、「もし天からだと言えば、では、なぜ彼を信じなかったのか、とイエスは言うだろう。"},{"ref":"Matt.21.26","start":40021026,"end":40021026,"break":"none","ruby":[[6,1,"ひと"],[11,1,"い"],[15,2,"ぐんしゅう"],[18,1,"おそ"],[23,2,"ひとびと"],[32,3,"よげんしゃ"],[36,1,"おも"]],"text":"しかし、もし人からだと言えば、群衆が恐ろしい。人々がみなヨハネを預言者と思っているのだから」。"},{"ref":"Matt.21.27","start":40021027,"end":40021027,"break":"none","ruby":[[3,1,"かれ"],[23,1,"こた"],[35,1,"い"],[45,1,"なに"],[47,2,"けんい"],[57,1,"こと"],[70,1,"い"]],"text":"そこで彼らは、「わたしたちにはわかりません」と答えた。すると、イエスが言われた、「わたしも何の権威によってこれらの事をするのか、あなたがたに言うまい。"},{"ref":"Matt.21.28","start":40021028,"end":40021028,"break":"paragraph","ruby":[[8,1,"おも"],[14,1,"ひと"],[20,1,"こ"],[27,1,"あに"],[33,1,"い"],[36,1,"い"],[41,1,"こ"],[51,1,"えん"],[53,1,"い"],[56,1,"はたら"]],"text":"あなたがたはどう思うか。ある人にふたりの子があったが、兄のところに行って言った、『子よ、きょう、ぶどう園へ行って働いてくれ』。"},{"ref":"Matt.21.29","start":40021029,"end":40021029,"break":"none","ruby":[[3,1,"かれ"],[12,1,"まい"],[18,1,"こた"],[23,1,"い"]],"text":"すると彼は『おとうさん、参ります』と答えたが、行かなかった。"},{"ref":"Matt.21.30","start":40021030,"end":40021030,"break":"none","ruby":[[2,1,"おとうと"],[10,1,"おな"],[15,1,"い"],[19,1,"かれ"],[28,1,"こた"],[37,1,"こころ"],[39,1,"か"],[43,1,"で"]],"text":"また弟のところにきて同じように言った。彼は『いやです』と答えたが、あとから心を変えて、出かけた。"},{"ref":"Matt.21.31","start":40021031,"end":40021031,"break":"none","ruby":[[13,1,"ちち"],[15,1,"のぞ"],[27,1,"かれ"],[30,1,"い"],[38,1,"もの"],[47,1,"い"],[55,1,"き"],[61,3,"しゅぜいにん"],[65,2,"ゆうじょ"],[76,1,"さき"],[78,1,"かみ"],[80,1,"くに"]],"text":"このふたりのうち、どちらが父の望みどおりにしたのか」。彼らは言った、「あとの者です」。イエスは言われた、「よく聞きなさい。取税人や遊女は、あなたがたより先に神の国にはいる。"},{"ref":"Matt.21.32","start":40021032,"end":40021032,"break":"none","ruby":[[23,1,"ぎ"],[25,1,"みち"],[27,1,"と"],[39,1,"かれ"],[41,1,"しん"],[53,3,"しゅぜいにん"],[57,2,"ゆうじょ"],[60,1,"かれ"],[62,1,"しん"],[75,1,"み"],[88,1,"こころ"],[92,1,"か"],[95,1,"かれ"],[97,1,"しん"]],"text":"というのは、ヨハネがあなたがたのところにきて、義の道を説いたのに、あなたがたは彼を信じなかった。ところが、取税人や遊女は彼を信じた。あなたがたはそれを見たのに、あとになっても、心をいれ変えて彼を信じようとしなかった。"},{"ref":"Matt.21.33","start":40021033,"end":40021033,"break":"paragraph","ruby":[[5,1,"たとえ"],[7,1,"き"],[15,1,"ところ"],[22,1,"いえ"],[24,2,"しゅじん"],[34,1,"えん"],[36,1,"つく"],[49,1,"なか"],[51,1,"さか"],[55,1,"あな"],[57,1,"ほ"],[64,1,"た"],[70,2,"のうふ"],[75,1,"か"],[79,1,"たび"],[81,1,"で"]],"text":"もう一つの譬を聞きなさい。ある所に、ひとりの家の主人がいたが、ぶどう園を造り、かきをめぐらし、その中に酒ぶねの穴を掘り、やぐらを立て、それを農夫たちに貸して、旅に出かけた。"},{"ref":"Matt.21.34","start":40021034,"end":40021034,"break":"none","ruby":[[0,2,"しゅうかく"],[3,2,"きせつ"],[13,1,"わ"],[15,1,"まえ"],[17,1,"う"],[19,1,"と"],[26,1,"しもべ"],[30,2,"のうふ"],[37,1,"おく"]],"text":"収穫の季節がきたので、その分け前を受け取ろうとして、僕たちを農夫のところへ送った。"},{"ref":"Matt.21.35","start":40021035,"end":40021035,"break":"none","ruby":[[4,2,"のうふ"],[12,1,"しもべ"],[26,1,"ふくろ"],[37,1,"ころ"],[46,1,"いし"],[48,1,"う"],[50,1,"ころ"]],"text":"すると、農夫たちは、その僕たちをつかまえて、ひとりを袋だたきにし、ひとりを殺し、もうひとりを石で打ち殺した。"},{"ref":"Matt.21.36","start":40021036,"end":40021036,"break":"none","ruby":[[2,1,"べつ"],[5,1,"まえ"],[9,1,"おお"],[12,1,"しもべ"],[16,1,"おく"],[21,1,"かれ"],[25,1,"おな"]],"text":"また別に、前よりも多くの僕たちを送ったが、彼らをも同じようにあしらった。"},{"ref":"Matt.21.37","start":40021037,"end":40021037,"break":"none","ruby":[[4,2,"さいご"],[12,1,"こ"],[14,1,"うやま"],[24,1,"おも"],[28,2,"しゅじん"],[33,1,"こ"],[35,1,"かれ"],[38,1,"ところ"]],"text":"しかし、最後に、わたしの子は敬ってくれるだろうと思って、主人はその子を彼らの所につかわした。"},{"ref":"Matt.21.38","start":40021038,"end":40021038,"break":"none","ruby":[[3,2,"のうふ"],[11,1,"こ"],[13,1,"み"],[15,1,"たがい"],[17,1,"い"],[27,1,"と"],[37,1,"ころ"],[43,2,"ざいさん"],[46,1,"て"],[48,1,"い"]],"text":"すると農夫たちは、その子を見て互に言った、『あれはあと取りだ。さあ、これを殺して、その財産を手に入れよう』。"},{"ref":"Matt.21.39","start":40021039,"end":40021039,"break":"none","ruby":[[3,1,"かれ"],[14,1,"えん"],[16,1,"そと"],[18,1,"ひ"],[20,1,"だ"],[23,1,"ころ"]],"text":"そして彼をつかまえて、ぶどう園の外に引き出して殺した。"},{"ref":"Matt.21.40","start":40021040,"end":40021040,"break":"none","ruby":[[5,1,"えん"],[7,2,"しゅじん"],[10,1,"かえ"],[19,2,"のうふ"]],"text":"このぶどう園の主人が帰ってきたら、この農夫たちをどうするだろうか」。"},{"ref":"Matt.21.41","start":40021041,"end":40021041,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[12,2,"あくにん"],[18,2,"みなごろ"],[25,2,"きせつ"],[30,2,"しゅうかく"],[33,1,"おさ"],[39,2,"のうふ"],[50,1,"えん"],[52,1,"か"],[54,1,"あた"]],"text":"彼らはイエスに言った、「悪人どもを、皆殺しにして、季節ごとに収穫を納めるほかの農夫たちに、そのぶどう園を貸し与えるでしょう」。"},{"ref":"Matt.21.42","start":40021042,"end":40021042,"break":"none","breaks":[[36,"stanza"],[47,"line"],[58,"line"],[71,"line"]],"ruby":[[4,1,"かれ"],[7,1,"い"],[20,2,"せいしょ"],[25,1,"よ"],[37,1,"いえ"],[38,1,"つく"],[42,1,"す"],[45,1,"いし"],[47,1,"すみ"],[52,1,"いし"],[61,1,"しゅ"],[77,1,"め"],[80,3,"ふしぎ"],[84,1,"み"]],"text":"イエスは彼らに言われた、「あなたがたは、聖書でまだ読んだことがないのか、『家造りらの捨てた石が隅のかしら石になった。これは主がなされたことで、わたしたちの目には不思議に見える』。"},{"ref":"Matt.21.43","start":40021043,"end":40021043,"break":"none","ruby":[[12,1,"い"],[16,1,"かみ"],[18,1,"くに"],[27,1,"と"],[29,1,"あ"],[35,2,"みくに"],[43,1,"み"],[45,1,"むす"],[50,3,"いほうじん"],[54,1,"あた"]],"text":"それだから、あなたがたに言うが、神の国はあなたがたから取り上げられて、御国にふさわしい実を結ぶような異邦人に与えられるであろう。"},{"ref":"Matt.21.44","start":40021044,"end":40021044,"break":"none","ruby":[[4,1,"いし"],[6,1,"うえ"],[8,1,"お"],[11,1,"もの"],[13,1,"う"],[15,1,"くだ"],[26,1,"うえ"],[28,1,"お"],[38,1,"ひと"]],"text":"またその石の上に落ちる者は打ち砕かれ、それがだれかの上に落ちかかるなら、その人はこなみじんにされるであろう」。"},{"ref":"Matt.21.45","start":40021045,"end":40021045,"break":"none","ruby":[[0,3,"さいしちょう"],[10,1,"びと"],[16,1,"たとえ"],[18,1,"き"],[24,2,"じぶん"],[35,1,"い"],[45,1,"さと"]],"text":"祭司長たちやパリサイ人たちがこの譬を聞いたとき、自分たちのことをさして言っておられることを悟ったので、"},{"ref":"Matt.21.46","start":40021046,"end":40021046,"break":"none","ruby":[[4,1,"とら"],[13,2,"ぐんしゅう"],[16,1,"おそ"],[20,2,"ぐんしゅう"],[27,3,"よげんしゃ"],[32,1,"おも"]],"text":"イエスを捕えようとしたが、群衆を恐れた。群衆はイエスを預言者だと思っていたからである。"}]