[{"ref":"Josh.12.1","start":6012001,"end":6012001,"break":"paragraph","ruby":[[7,1,"む"],[10,1,"がわ"],[12,1,"ひ"],[14,1,"で"],[16,1,"ほう"],[24,1,"たに"],[31,1,"やま"],[38,1,"ひがし"],[43,2,"ぜんど"],[56,2,"ひとびと"],[59,1,"う"],[61,1,"ほろ"],[65,1,"ち"],[67,1,"と"],[70,1,"くに"],[72,1,"おう"],[77,1,"つぎ"]],"text":"さてヨルダンの向こう側、日の出の方で、アルノンの谷からヘルモン山まで、および東アラバの全土のうちで、イスラエルの人々が撃ち滅ぼして地を取った国の王たちは、次のとおりである。"},{"ref":"Josh.12.2","start":6012002,"end":6012002,"break":"none","ruby":[[9,1,"おう"],[14,1,"かれ"],[21,1,"す"],[26,2,"りょうち"],[35,1,"たに"],[51,1,"たに"],[53,1,"なか"],[55,1,"まち"],[64,1,"なか"],[67,1,"し"],[79,1,"さかい"],[86,1,"かわ"],[88,1,"たっ"]],"text":"まず、アモリびとの王シホン。彼はヘシボンに住み、その領地は、アルノンの谷のほとりにあるアロエル、および谷の中の町から、ギレアデの半ばを占めて、アンモンびととの境であるヤボク川に達し、"},{"ref":"Josh.12.3","start":6012003,"end":6012003,"break":"none","ruby":[[0,1,"ひがし"],[2,1,"ほう"],[15,1,"みずうみ"],[18,1,"し"],[27,1,"うみ"],[32,1,"しお"],[34,1,"うみ"],[36,1,"ひがし"],[49,1,"みち"],[51,1,"へ"],[54,1,"みなみ"],[60,1,"やま"],[66,1,"たっ"]],"text":"東の方ではアラバをキンネレテの湖まで占め、またアラバの海すなわち塩の海の東におよび、ベテエシモテの道を経て、南はピスガの山のふもとに達した。"},{"ref":"Josh.12.4","start":6012004,"end":6012004,"break":"none","ruby":[[0,1,"つぎ"],[7,1,"い"],[9,1,"のこ"],[24,1,"おう"],[28,1,"かれ"],[42,1,"す"]],"text":"次にレパイムの生き残りのひとりであったバシャンの王オグ。彼はアシタロテとエデレイとに住み、"},{"ref":"Josh.12.5","start":6012005,"end":6012005,"break":"none","ruby":[[4,1,"やま"],[18,2,"ぜんど"],[21,1,"りょう"],[43,1,"さかい"],[45,1,"せっ"],[55,1,"なか"],[58,1,"りょう"],[69,1,"おう"],[74,1,"さかい"],[76,1,"せっ"]],"text":"ヘルモン山、サレカ、およびバシャンの全土を領したので、ゲシュルびと、およびマアカびとと境を接し、またギレアデの半ばを領したので、ヘシボンの王シホンと境を接していた。"},{"ref":"Josh.12.6","start":6012006,"end":6012006,"break":"none","ruby":[[0,1,"しゅ"],[16,2,"ひとびと"],[21,1,"かれ"],[24,1,"う"],[26,1,"ほろ"],[33,1,"しゅ"],[47,1,"ち"],[68,1,"はん"],[69,2,"ぶぞく"],[72,1,"あた"],[75,2,"しょゆう"]],"text":"主のしもべモーセと、イスラエルの人々とが、彼らを撃ち滅ぼし、そして主のしもべモーセは、これらの地を、ルベンびと、ガドびと、およびマナセの半部族に与えて所有とさせた。"},{"ref":"Josh.12.7","start":6012007,"end":6012007,"break":"paragraph","ruby":[[8,1,"がわ"],[10,1,"にし"],[12,1,"ほう"],[23,1,"たに"],[39,1,"のぼ"],[42,1,"い"],[44,1,"みち"],[49,1,"やま"],[53,1,"あいだ"],[68,2,"ひとびと"],[73,1,"う"],[75,1,"ほろ"],[79,1,"くに"],[81,1,"おう"],[86,1,"つぎ"],[100,1,"かれ"],[103,1,"ち"],[111,2,"ぶぞく"],[120,1,"ぶん"],[122,1,"あた"],[125,1,"し"],[126,1,"ぎょう"]],"text":"ヨルダンのこちら側、西の方にあって、レバノンの谷にあるバアルガデから、セイルへ上って行く道のハラク山までの間で、ヨシュアと、イスラエルの人々とが、撃ち滅ぼした国の王たちは、次のとおりである。ヨシュアは彼らの地をイスラエルの部族に、それぞれの分を与えて嗣業とさせた。"},{"ref":"Josh.12.8","start":6012008,"end":6012008,"break":"none","ruby":[[4,2,"さんち"],[7,2,"へいち"],[14,2,"さんぷく"],[17,2,"あらの"],[65,2,"しょりょう"]],"text":"これは、山地、平地、アラバ、山腹、荒野、およびネゲブであって、ヘテびと、アモリびと、カナンびと、ペリジびと、ヒビびと、エブスびとの所領であった。"},{"ref":"Josh.12.9","start":6012009,"end":6012009,"break":"none","ruby":[[4,1,"おう"],[20,1,"おう"]],"text":"エリコの王ひとり。ベテルのほとりのアイの王ひとり。"},{"ref":"Josh.12.10","start":6012010,"end":6012010,"break":"none","ruby":[[6,1,"おう"],[16,1,"おう"]],"text":"エルサレムの王ひとり。ヘブロンの王ひとり。"},{"ref":"Josh.12.11","start":6012011,"end":6012011,"break":"none","ruby":[[5,1,"おう"],[14,1,"おう"]],"text":"ヤルムテの王ひとり。ラキシの王ひとり。"},{"ref":"Josh.12.12","start":6012012,"end":6012012,"break":"none","ruby":[[5,1,"おう"],[14,1,"おう"]],"text":"エグロンの王ひとり。ゲゼルの王ひとり。"},{"ref":"Josh.12.13","start":6012013,"end":6012013,"break":"none","ruby":[[4,1,"おう"],[13,1,"おう"]],"text":"デビルの王ひとり。ゲデルの王ひとり。"},{"ref":"Josh.12.14","start":6012014,"end":6012014,"break":"none","ruby":[[4,1,"おう"],[13,1,"おう"]],"text":"ホルマの王ひとり。アラデの王ひとり。"},{"ref":"Josh.12.15","start":6012015,"end":6012015,"break":"none","ruby":[[4,1,"おう"],[14,1,"おう"]],"text":"リブナの王ひとり。アドラムの王ひとり。"},{"ref":"Josh.12.16","start":6012016,"end":6012016,"break":"none","ruby":[[5,1,"おう"],[14,1,"おう"]],"text":"マッケダの王ひとり。ベテルの王ひとり。"},{"ref":"Josh.12.17","start":6012017,"end":6012017,"break":"none","ruby":[[5,1,"おう"],[14,1,"おう"]],"text":"タップアの王ひとり。ヘペルの王ひとり。"},{"ref":"Josh.12.18","start":6012018,"end":6012018,"break":"none","ruby":[[4,1,"おう"],[14,1,"おう"]],"text":"アペクの王ひとり。シャロンの王ひとり。"},{"ref":"Josh.12.19","start":6012019,"end":6012019,"break":"none","ruby":[[4,1,"おう"],[13,1,"おう"]],"text":"マドンの王ひとり。ハゾルの王ひとり。"},{"ref":"Josh.12.20","start":6012020,"end":6012020,"break":"none","ruby":[[9,1,"おう"],[19,1,"おう"]],"text":"シムロン・メロンの王ひとり。アクサフの王ひとり。"},{"ref":"Josh.12.21","start":6012021,"end":6012021,"break":"none","ruby":[[5,1,"おう"],[14,1,"おう"]],"text":"タアナクの王ひとり。メギドの王ひとり。"},{"ref":"Josh.12.22","start":6012022,"end":6012022,"break":"none","ruby":[[4,1,"おう"],[20,1,"おう"]],"text":"ケデシの王ひとり。カルメルのヨクネアムの王ひとり。"},{"ref":"Josh.12.23","start":6012023,"end":6012023,"break":"none","ruby":[[3,2,"こうち"],[11,1,"おう"],[26,1,"おう"]],"text":"ドルの高地におるドルの王ひとり。ガリラヤのゴイイムの王ひとり。"},{"ref":"Josh.12.24","start":6012024,"end":6012024,"break":"none","ruby":[[4,1,"おう"],[9,1,"あ"],[16,1,"おう"]],"text":"テルザの王ひとり。合わせて三十一王である。"}]