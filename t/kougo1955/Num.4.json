[{"ref":"Num.4.1","start":4004001,"end":4004001,"break":"paragraph","ruby":[[0,1,"しゅ"],[12,1,"い"]],"text":"主はまたモーセとアロンに言われた、"},{"ref":"Num.4.2","start":4004002,"end":4004002,"break":"none","ruby":[[4,1,"こ"],[17,1,"こ"],[21,2,"そうすう"],[27,2,"しぞく"],[35,2,"ふそ"],[38,1,"いえ"],[45,1,"しら"]],"text":"「レビの子たちのうちから、コハテの子たちの総数を、その氏族により、その父祖の家にしたがって調べ、"},{"ref":"Num.4.3","start":4004003,"end":4004003,"break":"none","ruby":[[2,1,"さい"],[3,2,"いじょう"],[7,1,"さい"],[8,2,"いか"],[12,1,"つとめ"],[17,2,"かいけん"],[20,2,"まくや"],[23,1,"はたら"],[31,1,"もの"],[39,1,"かぞ"]],"text":"三十歳以上五十歳以下で、務につき、会見の幕屋で働くことのできる者を、ことごとく数えなさい。"},{"ref":"Num.4.4","start":4004004,"end":4004004,"break":"none","ruby":[[4,1,"こ"],[9,2,"かいけん"],[12,2,"まくや"],[15,1,"つとめ"],[20,1,"せい"],[23,1,"もの"],[36,1,"つぎ"]],"text":"コハテの子たちの、会見の幕屋の務は、いと聖なる物にかかわるものであって、次のとおりである。"},{"ref":"Num.4.5","start":4004005,"end":4004005,"break":"none","ruby":[[5,2,"しゅくえい"],[8,1,"すす"],[10,1,"とき"],[19,1,"こ"],[33,1,"へだ"],[36,2,"たれまく"],[39,1,"と"],[56,1,"はこ"]],"text":"すなわち、宿営の進む時に、アロンとその子たちとは、まず、はいって、隔ての垂幕を取りおろし、それをもって、あかしの箱をおおい、"},{"ref":"Num.4.6","start":4004006,"end":4004006,"break":"none","ruby":[[2,1,"うえ"],[10,1,"かわ"],[16,1,"ほどこ"],[23,1,"うえ"],[25,1,"そう"],[26,2,"あおいろ"],[29,1,"ぬの"],[36,1,"かん"],[43,1,"い"]],"text":"その上に、じゅごんの皮のおおいを施し、またその上に総青色の布をうちかけ、環にさおをさし入れる。"},{"ref":"Num.4.7","start":4004007,"end":4004007,"break":"none","ruby":[[2,1,"そな"],[8,1,"つくえ"],[10,1,"うえ"],[14,2,"あおいろ"],[17,1,"ぬの"],[26,1,"うえ"],[32,2,"にゅうこう"],[35,1,"も"],[37,1,"さかずき"],[39,1,"はち"],[44,2,"かんさい"],[47,1,"びん"],[49,1,"なら"],[54,1,"た"],[58,1,"そな"],[64,1,"お"]],"text":"また供えのパンの机の上には、青色の布をうちかけ、その上に、さら、乳香を盛る杯、鉢、および灌祭の瓶を並べ、また絶やさず供えるパンを置き、"},{"ref":"Num.4.8","start":4004008,"end":4004008,"break":"none","ruby":[[0,2,"ひいろ"],[3,1,"ぬの"],[7,1,"うえ"],[19,1,"かわ"],[41,1,"い"]],"text":"緋色の布をその上にうちかけ、じゅごんの皮のおおいをもって、これをおおい、さおをさし入れる。"},{"ref":"Num.4.9","start":4004009,"end":4004009,"break":"none","ruby":[[2,2,"あおいろ"],[5,1,"ぬの"],[7,1,"と"],[11,2,"しょくだい"],[19,1,"ひ"],[23,1,"しん"],[24,1,"き"],[30,1,"しん"],[31,1,"と"],[42,1,"もち"],[50,1,"あぶら"],[52,1,"うつわ"]],"text":"また青色の布を取って、燭台とそのともし火ざら、芯切りばさみ、芯取りざら、およびそれに用いるもろもろの油の器をおおい、"},{"ref":"Num.4.10","start":4004010,"end":4004010,"break":"none","ruby":[[5,1,"かわ"],[15,2,"しょくだい"],[25,1,"うつわ"],[31,2,"たんか"],[34,1,"の"]],"text":"じゅごんの皮のおおいのうちに、燭台とそのもろもろの器をいれて、担架に載せる。"},{"ref":"Num.4.11","start":4004011,"end":4004011,"break":"none","ruby":[[3,1,"きん"],[5,2,"さいだん"],[8,1,"うえ"],[10,2,"あおいろ"],[13,1,"ぬの"],[25,1,"かわ"],[46,1,"い"]],"text":"また、金の祭壇の上に青色の布をうちかけ、じゅごんの皮のおおいで、これをおおい、そのさおをさし入れる。"},{"ref":"Num.4.12","start":4004012,"end":4004012,"break":"none","ruby":[[2,2,"せいじょ"],[5,1,"つとめ"],[7,1,"もち"],[10,1,"つとめ"],[12,1,"うつわ"],[16,1,"と"],[19,2,"あおいろ"],[22,1,"ぬの"],[24,1,"つつ"],[32,1,"かわ"],[47,2,"たんか"],[50,1,"の"]],"text":"また聖所の務に用いる務の器をみな取り、青色の布に包み、じゅごんの皮のおおいで、これをおおって、担架に載せる。"},{"ref":"Num.4.13","start":4004013,"end":4004013,"break":"none","ruby":[[2,2,"さいだん"],[5,1,"はい"],[7,1,"と"],[9,1,"さ"],[13,1,"むらさき"],[15,1,"ぬの"],[19,2,"さいだん"],[22,1,"うえ"]],"text":"また祭壇の灰を取り去って、紫の布をその祭壇の上にうちかけ、"},{"ref":"Num.4.14","start":4004014,"end":4004014,"break":"none","ruby":[[2,1,"うえ"],[5,1,"つとめ"],[11,1,"もち"],[19,1,"うつわ"],[26,1,"ひ"],[30,1,"にく"],[34,2,"じゅうのう"],[37,1,"はち"],[42,2,"さいだん"],[49,1,"うつわ"],[51,1,"の"],[58,1,"うえ"],[66,1,"かわ"],[85,1,"い"]],"text":"その上に、務をするのに用いるもろもろの器、すなわち、火ざら、肉さし、十能、鉢、および祭壇のすべての器を載せ、またその上に、じゅごんの皮のおおいをうちかけ、そしてさおをさし入れる。"},{"ref":"Num.4.15","start":4004015,"end":4004015,"break":"none","ruby":[[0,2,"しゅくえい"],[3,1,"すす"],[14,1,"こ"],[20,2,"せいじょ"],[23,2,"せいじょ"],[30,1,"うつわ"],[38,1,"おわ"],[47,1,"のち"],[52,1,"こ"],[60,1,"はこ"],[84,1,"かれ"],[87,1,"せい"],[90,1,"もの"],[92,1,"ふ"],[101,1,"ふ"],[105,1,"し"],[112,2,"かいけん"],[115,2,"まくや"],[126,1,"もの"],[133,1,"こ"],[137,1,"はこ"]],"text":"宿営の進むとき、アロンとその子たちとが、聖所と聖所のすべての器をおおうことを終ったならば、その後コハテの子たちは、それを運ぶために、はいってこなければならない。しかし、彼らは聖なる物に触れてはならない。触れると死ぬであろう。会見の幕屋のうちの、これらの物は、コハテの子たちが運ぶものである。"},{"ref":"Num.4.16","start":4004016,"end":4004016,"break":"paragraph","ruby":[[0,2,"さいし"],[6,1,"こ"],[17,1,"あぶら"],[19,1,"こう"],[23,2,"くんこう"],[26,1,"た"],[30,1,"そな"],[33,2,"そさい"],[38,1,"そそ"],[40,1,"あぶら"],[50,2,"まくや"],[53,2,"ぜんたい"],[68,1,"せい"],[71,1,"もの"],[78,1,"ところ"],[85,1,"うつわ"]],"text":"祭司アロンの子エレアザルは、ともし油、香ばしい薫香、絶やさず供える素祭および注ぎ油をつかさどり、また幕屋の全体と、そのうちにあるすべての聖なる物、およびその所のもろもろの器をつかさどらなければならない」。"},{"ref":"Num.4.17","start":4004017,"end":4004017,"break":"paragraph","ruby":[[0,1,"しゅ"],[13,1,"い"]],"text":"主はまた、モーセとアロンに言われた、"},{"ref":"Num.4.18","start":4004018,"end":4004018,"break":"none","ruby":[[13,2,"いちぞく"],[26,1,"た"]],"text":"「あなたがたはコハテびとの一族を、レビびとのうちから絶えさせてはならない。"},{"ref":"Num.4.19","start":4004019,"end":4004019,"break":"none","ruby":[[0,1,"かれ"],[5,1,"せい"],[8,1,"もの"],[10,1,"ちか"],[13,1,"とき"],[15,1,"し"],[21,1,"いのち"],[23,1,"たも"],[50,1,"こ"],[62,1,"かれ"],[71,1,"はたら"],[88,1,"と"]],"text":"彼らがいと聖なる物に近づく時、死なないで、命を保つために、このようにしなさい、すなわち、アロンとその子たちが、まず、はいり、彼らをおのおのその働きにつかせ、そのになうべきものを取らせなさい。"},{"ref":"Num.4.20","start":4004020,"end":4004020,"break":"none","ruby":[[4,1,"かれ"],[15,1,"め"],[18,1,"せい"],[21,1,"もの"],[23,1,"み"],[31,1,"み"],[36,1,"し"]],"text":"しかし、彼らは、はいって、ひと目でも聖なる物を見てはならない。見るならば死ぬであろう」。"},{"ref":"Num.4.21","start":4004021,"end":4004021,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.4.22","start":4004022,"end":4004022,"break":"none","ruby":[[13,1,"こ"],[17,2,"そうすう"],[23,2,"ふそ"],[26,1,"いえ"],[33,2,"しぞく"],[41,1,"しら"]],"text":"「あなたはまたゲルションの子たちの総数を、その父祖の家により、その氏族にしたがって調べ、"},{"ref":"Num.4.23","start":4004023,"end":4004023,"break":"none","ruby":[[2,1,"さい"],[3,2,"いじょう"],[7,1,"さい"],[8,2,"いか"],[12,1,"つとめ"],[17,2,"かいけん"],[20,2,"まくや"],[23,1,"はたら"],[31,1,"もの"],[39,1,"かぞ"]],"text":"三十歳以上五十歳以下で、務につき、会見の幕屋で働くことのできる者を、ことごとく数えなさい。"},{"ref":"Num.4.24","start":4004024,"end":4004024,"break":"none","ruby":[[8,2,"しぞく"],[11,1,"つとめ"],[15,1,"はたら"],[21,1,"はこ"],[23,1,"もの"],[26,1,"つぎ"]],"text":"ゲルションびとの氏族の務として働くことと、運ぶ物とは次のとおりである。"},{"ref":"Num.4.25","start":4004025,"end":4004025,"break":"none","ruby":[[5,1,"かれ"],[8,2,"まくや"],[11,1,"まく"],[13,2,"かいけん"],[16,2,"まくや"],[30,1,"うえ"],[37,1,"かわ"],[47,2,"かいけん"],[50,2,"まくや"],[53,2,"いりぐち"],[60,1,"はこ"]],"text":"すなわち、彼らは幕屋の幕、会見の幕屋およびそのおおいと、その上のじゅごんの皮のおおい、ならびに会見の幕屋の入口のとばりを運び、"},{"ref":"Num.4.26","start":4004026,"end":4004026,"break":"none","ruby":[[2,1,"にわ"],[12,2,"まくや"],[15,2,"さいだん"],[22,1,"にわ"],[24,1,"もん"],[26,2,"いりぐち"],[46,1,"もち"],[53,1,"うつわ"],[55,1,"はこ"],[69,1,"かれ"],[86,1,"はたら"]],"text":"また庭のあげばり、および幕屋と祭壇のまわりの庭の門の入口のとばりと、そのひも、ならびにそれに用いるすべての器を運ばなければならない。そして彼らはすべてこれらのものについての働きをしなければならない。"},{"ref":"Num.4.27","start":4004027,"end":4004027,"break":"none","ruby":[[8,1,"こ"],[16,1,"つとめ"],[25,1,"はこ"],[31,1,"はたら"],[47,1,"こ"],[51,1,"めい"],[53,1,"したが"],[70,1,"かれ"],[78,1,"はこ"],[82,1,"もの"],[84,1,"さだ"],[91,1,"まも"]],"text":"ゲルションびとの子たちのすべての務、すなわち、その運ぶことと、働くこととは、すべてアロンとその子たちの命に従わなければならない。あなたがたは彼らにすべてその運ぶべき物を定めて、これを守らせなければならない。"},{"ref":"Num.4.28","start":4004028,"end":4004028,"break":"none","ruby":[[15,1,"こ"],[19,2,"しぞく"],[23,2,"かいけん"],[26,2,"まくや"],[31,1,"はたら"],[38,1,"かれ"],[41,1,"つとめ"],[43,2,"さいし"],[49,1,"こ"],[55,2,"しき"]],"text":"これはすなわちゲルションびとの子たちの氏族が、会見の幕屋でする働きであって、彼らの務は祭司アロンの子イタマルの指揮のもとにおかなければならない。"},{"ref":"Num.4.29","start":4004029,"end":4004029,"break":"paragraph","ruby":[[4,1,"こ"],[17,2,"しぞく"],[25,2,"そふ"],[28,1,"いえ"],[35,1,"しら"]],"text":"メラリの子たちをもまたあなたはその氏族により、その祖父の家にしたがって調べ、"},{"ref":"Num.4.30","start":4004030,"end":4004030,"break":"none","ruby":[[2,1,"さい"],[3,2,"いじょう"],[7,1,"さい"],[8,2,"いか"],[12,1,"つとめ"],[17,2,"かいけん"],[20,2,"まくや"],[23,1,"はたら"],[34,1,"もの"],[42,1,"かぞ"]],"text":"三十歳以上五十歳以下で、務につき、会見の幕屋の働きをすることのできる者を、ことごとく数えなさい。"},{"ref":"Num.4.31","start":4004031,"end":4004031,"break":"none","ruby":[[0,1,"かれ"],[3,2,"かいけん"],[6,2,"まくや"],[15,1,"つとめ"],[25,1,"はこ"],[27,2,"せきにん"],[32,1,"もの"],[34,1,"つぎ"],[48,2,"まくや"],[51,1,"わく"],[55,2,"よこぎ"],[60,1,"はしら"],[64,1,"ざ"]],"text":"彼らが会見の幕屋でするすべての務にしたがって、その運ぶ責任のある物は次のとおりである。すなわち、幕屋の枠、その横木、その柱、その座、"},{"ref":"Num.4.32","start":4004032,"end":4004032,"break":"none","ruby":[[0,1,"にわ"],[6,1,"はしら"],[10,1,"ざ"],[14,1,"くぎ"],[29,1,"うつわ"],[37,1,"もち"],[56,1,"かれ"],[59,1,"はこ"],[61,2,"せきにん"],[66,1,"うつわ"],[71,1,"な"],[76,1,"わ"],[78,1,"あ"]],"text":"庭のまわりの柱、その座、その釘、そのひも、またそのすべての器、およびそれに用いるすべてのものである。あなたがたは彼らが運ぶ責任のある器を、その名によって割り当てなければならない。"},{"ref":"Num.4.33","start":4004033,"end":4004033,"break":"none","ruby":[[11,1,"こ"],[15,2,"しぞく"],[18,1,"はたら"],[25,1,"かれ"],[28,2,"さいし"],[34,1,"こ"],[40,2,"しき"],[47,2,"かいけん"],[50,2,"まくや"],[60,1,"はたら"]],"text":"これはすなわちメラリの子たちの氏族の働きであって、彼らは祭司アロンの子イタマルの指揮のもとに、会見の幕屋で、このすべての働きをしなければならない」。"},{"ref":"Num.4.34","start":4004034,"end":4004034,"break":"paragraph","ruby":[[14,2,"かいしゅう"],[28,1,"こ"],[34,2,"しぞく"],[42,2,"ふそ"],[45,1,"いえ"],[52,1,"しら"]],"text":"そこでモーセとアロン、および会衆のつかさたちは、コハテの子たちをその氏族により、その父祖の家にしたがって調べ、"},{"ref":"Num.4.35","start":4004035,"end":4004035,"break":"none","ruby":[[2,1,"さい"],[3,2,"いじょう"],[7,1,"さい"],[8,2,"いか"],[12,1,"つとめ"],[17,2,"かいけん"],[20,2,"まくや"],[23,1,"はたら"],[31,1,"もの"],[39,1,"かぞ"]],"text":"三十歳以上五十歳以下で、務につき、会見の幕屋で働くことのできる者を、ことごとく数えたが、"},{"ref":"Num.4.36","start":4004036,"end":4004036,"break":"none","ruby":[[2,2,"しぞく"],[10,1,"かぞ"],[15,1,"もの"],[23,1,"にん"]],"text":"その氏族にしたがって数えられた者は二千七百五十人であった。"},{"ref":"Num.4.37","start":4004037,"end":4004037,"break":"none","ruby":[[14,2,"しぞく"],[17,1,"かぞ"],[22,1,"もの"],[28,2,"かいけん"],[31,2,"まくや"],[34,1,"はたら"],[42,1,"もの"],[57,1,"しゅ"],[66,1,"めい"],[80,1,"かぞ"]],"text":"これはすなわち、コハテびとの氏族の数えられた者で、すべて会見の幕屋で働くことのできる者であった。モーセとアロンが、主のモーセによって命じられたところにしたがって数えたのである。"},{"ref":"Num.4.38","start":4004038,"end":4004038,"break":"paragraph","ruby":[[8,1,"こ"],[15,2,"しぞく"],[23,2,"ふそ"],[26,1,"いえ"],[33,1,"しら"]],"text":"またゲルションの子たちを、その氏族により、その父祖の家にしたがって調べ、"},{"ref":"Num.4.39","start":4004039,"end":4004039,"break":"none","ruby":[[2,1,"さい"],[3,2,"いじょう"],[7,1,"さい"],[8,2,"いか"],[12,1,"つとめ"],[17,2,"かいけん"],[20,2,"まくや"],[23,1,"はたら"],[31,1,"もの"],[39,1,"かぞ"]],"text":"三十歳以上五十歳以下で、務につき、会見の幕屋で働くことのできる者を、ことごとく数えたが、"},{"ref":"Num.4.40","start":4004040,"end":4004040,"break":"none","ruby":[[2,2,"しぞく"],[10,2,"ふそ"],[13,1,"いえ"],[20,1,"かぞ"],[25,1,"もの"],[33,1,"にん"]],"text":"その氏族により、その父祖の家にしたがって数えられた者は二千六百三十人であった。"},{"ref":"Num.4.41","start":4004041,"end":4004041,"break":"none","ruby":[[14,1,"こ"],[18,2,"しぞく"],[21,1,"かぞ"],[26,1,"もの"],[32,2,"かいけん"],[35,2,"まくや"],[38,1,"はたら"],[46,1,"もの"],[61,1,"しゅ"],[63,1,"めい"],[70,1,"かぞ"]],"text":"これはすなわち、ゲルションの子たちの氏族の数えられた者で、すべて会見の幕屋で働くことのできる者であった。モーセとアロンが、主の命にしたがって数えたのである。"},{"ref":"Num.4.42","start":4004042,"end":4004042,"break":"paragraph","ruby":[[6,1,"こ"],[10,2,"しぞく"],[16,2,"しぞく"],[24,2,"ふそ"],[27,1,"いえ"],[34,1,"しら"]],"text":"またメラリの子たちの氏族を、その氏族により、その父祖の家にしたがって調べ、"},{"ref":"Num.4.43","start":4004043,"end":4004043,"break":"none","ruby":[[2,1,"さい"],[3,2,"いじょう"],[7,1,"さい"],[8,2,"いか"],[12,1,"つとめ"],[17,2,"かいけん"],[20,2,"まくや"],[23,1,"はたら"],[31,1,"もの"],[39,1,"かぞ"]],"text":"三十歳以上五十歳以下で、務につき、会見の幕屋で働くことのできる者を、ことごとく数えたが、"},{"ref":"Num.4.44","start":4004044,"end":4004044,"break":"none","ruby":[[2,2,"しぞく"],[10,1,"かぞ"],[15,1,"もの"],[21,1,"にん"]],"text":"その氏族にしたがって数えられた者は三千二百人であった。"},{"ref":"Num.4.45","start":4004045,"end":4004045,"break":"none","ruby":[[12,1,"こ"],[16,2,"しぞく"],[19,1,"かぞ"],[24,1,"もの"],[36,1,"しゅ"],[45,1,"めい"],[59,1,"かぞ"]],"text":"これはすなわち、メラリの子たちの氏族の数えられた者で、モーセとアロンが、主のモーセによって命じられたところにしたがって数えたのである。"},{"ref":"Num.4.46","start":4004046,"end":4004046,"break":"paragraph","ruby":[[32,2,"しぞく"],[40,2,"ふそ"],[43,1,"いえ"],[50,1,"しら"]],"text":"モーセとアロン、およびイスラエルのつかさたちは、レビびとを、その氏族により、その父祖の家にしたがって調べ、"},{"ref":"Num.4.47","start":4004047,"end":4004047,"break":"none","ruby":[[2,1,"さい"],[3,2,"いじょう"],[7,1,"さい"],[8,2,"いか"],[12,2,"かいけん"],[15,2,"まくや"],[22,1,"つとめ"],[24,1,"はたら"],[32,1,"はこ"],[34,1,"はたら"],[39,1,"もの"],[47,1,"かぞ"]],"text":"三十歳以上五十歳以下で、会見の幕屋にはいって務の働きをし、また、運ぶ働きをする者を、ことごとく数えたが、"},{"ref":"Num.4.48","start":4004048,"end":4004048,"break":"none","ruby":[[2,1,"かぞ"],[7,1,"もの"],[15,1,"にん"]],"text":"その数えられた者は八千五百八十人であった。"},{"ref":"Num.4.49","start":4004049,"end":4004049,"break":"none","ruby":[[0,1,"かれ"],[3,1,"しゅ"],[5,1,"めい"],[17,1,"にん"],[28,1,"はたら"],[38,1,"はこ"],[44,1,"う"],[46,1,"も"],[54,1,"かれ"],[57,1,"しゅ"],[63,1,"めい"],[71,1,"かぞ"]],"text":"彼らは主の命により、モーセによって任じられ、おのおのその働きにつき、かつその運ぶところを受け持った。こうして彼らは主のモーセに命じられたように数えられたのである。"}]