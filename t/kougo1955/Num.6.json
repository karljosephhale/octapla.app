[{"ref":"Num.6.1","start":4006001,"end":4006001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.6.2","start":4006002,"end":4006002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[17,1,"おとこ"],[21,1,"おんな"],[24,1,"とく"],[26,1,"ちか"],[29,1,"た"],[40,2,"せいがん"],[46,1,"み"],[48,1,"しゅ"],[50,2,"せいべつ"],[54,1,"とき"]],"text":"「イスラエルの人々に言いなさい、『男または女が、特に誓いを立て、ナジルびととなる誓願をして、身を主に聖別する時は、"},{"ref":"Num.6.3","start":4006003,"end":4006003,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"こ"],[7,1,"さけ"],[9,1,"た"],[15,1,"しゅ"],[17,1,"す"],[25,1,"こ"],[27,1,"さけ"],[29,1,"す"],[37,1,"の"],[48,1,"しる"],[50,1,"の"],[56,1,"なま"],[59,1,"ほ"],[71,1,"た"]],"text":"ぶどう酒と濃い酒を断ち、ぶどう酒の酢となったもの、濃い酒の酢となったものを飲まず、また、ぶどうの汁を飲まず、また生でも干したものでも、ぶどうを食べてはならない。"},{"ref":"Num.6.4","start":4006004,"end":4006004,"break":"none","ruby":[[8,1,"あいだ"],[19,1,"き"],[29,1,"たね"],[31,1,"かわ"],[33,1,"た"]],"text":"ナジルびとである間は、すべて、ぶどうの木からできるものは、種も皮も食べてはならない。"},{"ref":"Num.6.5","start":4006005,"end":4006005,"break":"paragraph","ruby":[[10,2,"せいがん"],[13,1,"た"],[18,1,"あいだ"],[30,1,"あたま"],[32,1,"あ"],[41,1,"み"],[43,1,"しゅ"],[45,2,"せいべつ"],[49,2,"ひかず"],[52,1,"み"],[58,1,"かれ"],[60,1,"せい"],[71,1,"かみ"],[73,1,"け"]],"text":"また、ナジルびとたる誓願を立てている間は、すべて、かみそりを頭に当ててはならない。身を主に聖別した日数の満ちるまで、彼は聖なるものであるから、髪の毛をのばしておかなければならない。"},{"ref":"Num.6.6","start":4006006,"end":4006006,"break":"paragraph","ruby":[[0,1,"み"],[2,1,"しゅ"],[4,2,"せいべつ"],[10,1,"あいだ"],[16,2,"したい"],[19,1,"ちか"]],"text":"身を主に聖別している間は、すべて死体に近づいてはならない。"},{"ref":"Num.6.7","start":4006007,"end":4006007,"break":"none","ruby":[[0,2,"ふぼ"],[3,2,"きょうだい"],[6,2,"しまい"],[9,1,"し"],[12,1,"とき"],[21,1,"み"],[23,1,"けが"],[32,1,"かみ"],[34,2,"せいべつ"],[43,1,"あたま"]],"text":"父母、兄弟、姉妹が死んだ時でも、そのために身を汚してはならない。神に聖別したしるしが、頭にあるからである。"},{"ref":"Num.6.8","start":4006008,"end":4006008,"break":"none","ruby":[[0,1,"かれ"],[10,1,"あいだ"],[16,1,"しゅ"],[18,1,"せい"],[21,1,"もの"]],"text":"彼はナジルびとである間は、すべて主の聖なる者である。"},{"ref":"Num.6.9","start":4006009,"end":4006009,"break":"paragraph","ruby":[[2,1,"ひと"],[9,1,"かれ"],[16,1,"し"],[20,1,"かれ"],[22,2,"せいべつ"],[26,1,"あたま"],[28,1,"けが"],[35,1,"かれ"],[37,1,"み"],[39,1,"きよ"],[42,1,"ひ"],[45,1,"あたま"],[63,2,"なぬか"],[65,1,"め"]],"text":"もし人がはからずも彼のかたわらに死んで、彼の聖別した頭を汚したならば、彼は身を清める日に、頭をそらなければならない。すなわち、七日目にそれをそらなければならない。"},{"ref":"Num.6.10","start":4006010,"end":4006010,"break":"none","ruby":[[4,1,"か"],[5,1,"め"],[7,1,"やま"],[11,1,"わ"],[16,1,"いえ"],[23,1,"わ"],[25,1,"たずさ"],[29,2,"かいけん"],[32,2,"まくや"],[35,2,"いりぐち"],[40,2,"さいし"],[43,1,"ところ"],[45,1,"い"]],"text":"そして八日目に山ばと二羽、または家ばとのひな二羽を携えて、会見の幕屋の入口におる祭司の所に行かなければならない。"},{"ref":"Num.6.11","start":4006011,"end":4006011,"break":"none","ruby":[[0,2,"さいし"],[6,1,"いちわ"],[8,2,"ざいさい"],[13,1,"いちわ"],[15,2,"はんさい"],[23,1,"かれ"],[25,2,"したい"],[31,1,"え"],[33,1,"つみ"],[35,1,"かれ"],[47,1,"ひ"],[49,1,"かれ"],[51,1,"あたま"],[53,2,"せいべつ"]],"text":"祭司はその一羽を罪祭に、一羽を燔祭にささげて、彼が死体によって得た罪を彼のためにあがない、その日に彼の頭を聖別しなければならない。"},{"ref":"Num.6.12","start":4006012,"end":4006012,"break":"none","ruby":[[0,1,"かれ"],[11,1,"ひ"],[13,1,"かず"],[16,1,"あらた"],[19,1,"しゅ"],[21,2,"せいべつ"],[26,1,"さい"],[28,1,"おす"],[30,2,"こひつじ"],[33,1,"たずさ"],[39,2,"けんさい"],[54,2,"いぜん"],[57,1,"ひ"],[60,1,"かれ"],[64,2,"せいべつ"],[67,1,"けが"],[73,2,"むこう"]],"text":"彼はまたナジルびとたる日の数を、改めて主に聖別し、一歳の雄の小羊を携えてきて、愆祭としなければならない。それ以前の日は、彼がその聖別を汚したので、無効になるであろう。"},{"ref":"Num.6.13","start":4006013,"end":4006013,"break":"paragraph","ruby":[[9,2,"りっぽう"],[15,2,"せいべつ"],[18,1,"ひ"],[19,1,"かず"],[21,1,"み"],[24,1,"とき"],[29,1,"ひと"],[31,2,"かいけん"],[34,2,"まくや"],[37,2,"いりぐち"],[40,1,"つ"]],"text":"これがナジルびとの律法である。聖別の日数が満ちた時は、その人を会見の幕屋の入口に連れてこなければならない。"},{"ref":"Num.6.14","start":4006014,"end":4006014,"break":"none","ruby":[[5,1,"ひと"],[7,1,"そな"],[9,1,"もの"],[11,1,"しゅ"],[31,1,"さい"],[33,1,"おす"],[35,2,"こひつじ"],[38,1,"まった"],[43,1,"とう"],[45,2,"はんさい"],[51,1,"さい"],[53,1,"めす"],[55,2,"こひつじ"],[58,1,"まった"],[63,1,"とう"],[65,2,"ざいさい"],[70,2,"おひつじ"],[73,1,"まった"],[78,1,"とう"],[80,3,"しゅうおんさい"]],"text":"そしてその人は供え物を主にささげなければならない。すなわち、一歳の雄の小羊の全きもの一頭を燔祭とし、一歳の雌の小羊の全きもの一頭を罪祭とし、雄羊の全きもの一頭を酬恩祭とし、"},{"ref":"Num.6.15","start":4006015,"end":4006015,"break":"none","ruby":[[2,1,"たね"],[3,1,"い"],[13,1,"あぶら"],[15,1,"ま"],[18,1,"つく"],[21,2,"むぎこ"],[24,2,"かし"],[27,1,"あぶら"],[29,1,"ぬ"],[32,1,"たね"],[33,1,"い"],[36,2,"せんべい"],[42,2,"そさい"],[45,2,"かんさい"],[48,1,"たずさ"]],"text":"また種入れぬパンの一かご、油を混ぜて作った麦粉の菓子、油を塗った種入れぬ煎餅、および素祭と灌祭を携えてこなければならない。"},{"ref":"Num.6.16","start":4006016,"end":4006016,"break":"none","ruby":[[0,2,"さいし"],[6,1,"しゅ"],[8,1,"まえ"],[10,1,"たずさ"],[18,2,"ざいさい"],[21,2,"はんさい"]],"text":"祭司はこれを主の前に携えてきて、その罪祭と燔祭とをささげ、"},{"ref":"Num.6.17","start":4006017,"end":4006017,"break":"none","ruby":[[2,2,"おひつじ"],[5,1,"たね"],[6,1,"い"],[16,1,"とも"],[19,3,"しゅうおんさい"],[23,2,"ぎせい"],[29,1,"しゅ"],[43,2,"さいし"],[50,2,"そさい"],[53,2,"かんさい"]],"text":"また雄羊を種入れぬパンの一かごと共に、酬恩祭の犠牲として、主にささげなければならない。祭司はまたその素祭と灌祭をもささげなければならない。"},{"ref":"Num.6.18","start":4006018,"end":4006018,"break":"none","ruby":[[8,2,"かいけん"],[11,2,"まくや"],[14,2,"いりぐち"],[18,2,"せいべつ"],[22,1,"あたま"],[29,2,"せいべつ"],[33,1,"あたま"],[35,1,"かみ"],[37,1,"と"],[44,3,"しゅうおんさい"],[48,2,"ぎせい"],[51,1,"した"],[55,1,"ひ"],[57,1,"うえ"],[59,1,"お"]],"text":"そのナジルびとは会見の幕屋の入口で、聖別した頭をそり、その聖別した頭の髪を取って、これを酬恩祭の犠牲の下にある火の上に置かなければならない。"},{"ref":"Num.6.19","start":4006019,"end":4006019,"break":"none","ruby":[[0,2,"さいし"],[5,2,"おひつじ"],[8,1,"かた"],[10,1,"に"],[21,1,"と"],[24,1,"たね"],[25,1,"い"],[28,2,"かし"],[34,1,"たね"],[35,1,"い"],[38,2,"せんべい"],[43,1,"と"],[59,2,"せいべつ"],[63,1,"あたま"],[68,1,"のち"],[72,1,"て"],[74,1,"さづ"]],"text":"祭司はその雄羊の肩の煮えたものと、かごから取った種入れぬ菓子一つと、種入れぬ煎餅一つを取って、これをナジルびとが、その聖別した頭をそった後、その手に授け、"},{"ref":"Num.6.20","start":4006020,"end":4006020,"break":"none","ruby":[[0,2,"さいし"],[3,1,"しゅ"],[5,1,"まえ"],[10,1,"ゆ"],[12,1,"うご"],[16,2,"ようさい"],[32,1,"せい"],[35,1,"もの"],[43,1,"ゆ"],[45,1,"うご"],[49,1,"むね"],[59,1,"とも"],[62,2,"さいし"],[65,1,"き"],[77,1,"のち"],[91,1,"しゅ"],[93,1,"の"]],"text":"祭司は主の前でこれを揺り動かして揺祭としなければならない。これは聖なる物であって、その揺り動かした胸と、ささげたももと共に、祭司に帰するであろう。こうして後、そのナジルびとは、ぶどう酒を飲むことができる。"},{"ref":"Num.6.21","start":4006021,"end":4006021,"break":"paragraph","ruby":[[3,2,"せいがん"],[24,1,"こと"],[30,1,"しゅ"],[36,1,"かれ"],[38,1,"そな"],[40,1,"もの"],[46,2,"りっぽう"],[59,1,"ちから"],[61,1,"およ"],[63,1,"もの"],[81,1,"かれ"],[85,1,"ちか"],[87,2,"せいがん"],[100,2,"りっぽう"],[108,1,"おこな"]],"text":"これは誓願をするナジルびとと、そのナジルびとたる事のために、主にささげる彼の供え物についての律法である。このほかにその力の及ぶ物をささげることができる。すなわち、彼はその誓う誓願のように、ナジルびとの律法にしたがって行わなければならない』」。"},{"ref":"Num.6.22","start":4006022,"end":4006022,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.6.23","start":4006023,"end":4006023,"break":"none","ruby":[[7,1,"こ"],[11,1,"い"],[30,2,"ひとびと"],[33,2,"しゅくふく"],[42,1,"い"]],"text":"「アロンとその子たちに言いなさい、『あなたがたはイスラエルの人々を祝福してこのように言わなければならない。"},{"ref":"Num.6.24","start":4006024,"end":4006024,"break":"stanza","breaks":[[15,"line"]],"ruby":[[1,1,"ねが"],[5,1,"しゅ"],[11,2,"しゅくふく"],[19,1,"まも"]],"text":"「願わくは主があなたを祝福し、あなたを守られるように。"},{"ref":"Num.6.25","start":4006025,"end":4006025,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ねが"],[4,1,"しゅ"],[7,1,"かお"],[16,1,"てら"],[23,1,"めぐ"]],"text":"願わくは主がみ顔をもってあなたを照し、あなたを恵まれるように。"},{"ref":"Num.6.26","start":4006026,"end":4006026,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ねが"],[4,1,"しゅ"],[7,1,"かお"],[13,1,"む"],[20,2,"へいあん"],[23,1,"たま"]],"text":"願わくは主がみ顔をあなたに向け、あなたに平安を賜わるように」』。"},{"ref":"Num.6.27","start":4006027,"end":4006027,"break":"paragraph","ruby":[[4,1,"かれ"],[13,2,"ひとびと"],[24,1,"な"],[26,1,"とな"],[37,1,"かれ"],[40,2,"しゅくふく"]],"text":"こうして彼らがイスラエルの人々のために、わたしの名を唱えるならば、わたしは彼らを祝福するであろう」。"}]