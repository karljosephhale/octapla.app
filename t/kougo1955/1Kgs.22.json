[{"ref":"1Kgs.22.1","start":11022001,"end":11022001,"break":"paragraph","ruby":[[10,1,"あいだ"],[12,2,"せんそう"],[19,1,"ねん"],[21,1,"へ"]],"text":"スリヤとイスラエルの間に戦争がなくて三年を経た。"},{"ref":"1Kgs.22.2","start":11022002,"end":11022002,"break":"none","ruby":[[4,1,"ねん"],[5,1,"め"],[10,1,"おう"],[23,1,"おう"],[25,1,"ところ"],[27,1,"くだ"]],"text":"しかし三年目にユダの王ヨシャパテがイスラエルの王の所へ下っていったので、"},{"ref":"1Kgs.22.3","start":11022003,"end":11022003,"break":"none","ruby":[[6,1,"おう"],[10,2,"けらい"],[15,1,"い"],[41,2,"しょゆう"],[49,1,"し"],[71,1,"おう"],[73,1,"て"],[79,1,"と"],[83,1,"だま"]],"text":"イスラエルの王はその家来たちに言った、「あなたがたは、ラモテ・ギレアデがわれわれの所有であることを知っていますか。しかもなおわれわれはスリヤの王の手からそれを取らずに黙っているのです」。"},{"ref":"1Kgs.22.4","start":11022004,"end":11022004,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[22,1,"たたか"],[31,2,"いっしょ"],[34,1,"い"],[55,1,"おう"],[57,1,"い"],[79,1,"たみ"],[85,1,"たみ"],[96,1,"うま"],[102,1,"うま"]],"text":"彼はヨシャパテに言った、「ラモテ・ギレアデで戦うためにわたしと一緒に行かれませんか」。ヨシャパテはイスラエルの王に言った、「わたしはあなたと一つです。わたしの民はあなたの民と一つです。わたしの馬はあなたの馬と一つです」。"},{"ref":"1Kgs.22.5","start":11022005,"end":11022005,"break":"paragraph","ruby":[[14,1,"おう"],[16,1,"い"],[24,1,"しゅ"],[26,2,"ことば"],[29,1,"うかが"]],"text":"ヨシャパテはまたイスラエルの王に言った、「まず、主の言葉を伺いなさい」。"},{"ref":"1Kgs.22.6","start":11022006,"end":11022006,"break":"none","ruby":[[9,1,"おう"],[11,3,"よげんしゃ"],[16,1,"にん"],[21,1,"あつ"],[25,1,"かれ"],[28,1,"い"],[46,1,"たたか"],[49,1,"い"],[63,1,"ひか"],[75,1,"かれ"],[78,1,"い"],[83,1,"のぼ"],[92,1,"しゅ"],[97,1,"おう"],[99,1,"て"]],"text":"そこでイスラエルの王は預言者四百人ばかりを集めて、彼らに言った、「わたしはラモテ・ギレアデに戦いに行くべきでしょうか、あるいは控えるべきでしょうか」。彼らは言った、「上っていきなさい。主はそれを王の手にわたされるでしょう」。"},{"ref":"1Kgs.22.7","start":11022007,"end":11022007,"break":"none","ruby":[[6,1,"い"],[21,1,"と"],[25,1,"しゅ"],[27,3,"よげんしゃ"]],"text":"ヨシャパテは言った、「ここには、われわれの問うべき主の預言者がほかにいませんか」。"},{"ref":"1Kgs.22.8","start":11022008,"end":11022008,"break":"none","ruby":[[6,1,"おう"],[14,1,"い"],[24,1,"しゅ"],[26,1,"と"],[34,1,"ひと"],[50,1,"こ"],[57,1,"かれ"],[66,1,"よ"],[68,1,"こと"],[70,2,"よげん"],[77,1,"わる"],[79,1,"こと"],[83,2,"よげん"],[94,1,"かれ"],[96,1,"にく"],[110,1,"い"],[115,1,"おう"],[120,1,"い"]],"text":"イスラエルの王はヨシャパテに言った、「われわれが主に問うことのできる人が、まだひとりいます。イムラの子ミカヤです。彼はわたしについて良い事を預言せず、ただ悪い事だけを預言するので、わたしは彼を憎んでいます」。ヨシャパテは言った、「王よ、そう言わないでください」。"},{"ref":"1Kgs.22.9","start":11022009,"end":11022009,"break":"none","ruby":[[9,1,"おう"],[11,2,"やくにん"],[14,1,"よ"],[19,1,"いそ"],[26,1,"こ"],[31,1,"つ"],[40,1,"い"]],"text":"そこでイスラエルの王は役人を呼んで、「急いでイムラの子ミカヤを連れてきなさい」と言った。"},{"ref":"1Kgs.22.10","start":11022010,"end":11022010,"break":"none","ruby":[[8,1,"おう"],[15,1,"おう"],[22,1,"おう"],[24,1,"ふく"],[26,1,"き"],[34,1,"もん"],[36,2,"いりぐち"],[39,2,"ひろば"],[49,2,"おうざ"],[56,3,"よげんしゃ"],[62,1,"みな"],[65,1,"まえ"],[67,2,"よげん"]],"text":"さてイスラエルの王およびユダの王ヨシャパテは王の服を着て、サマリヤの門の入口の広場に、おのおのその王座にすわり、預言者たちは皆その前で預言していた。"},{"ref":"1Kgs.22.11","start":11022011,"end":11022011,"break":"none","ruby":[[5,1,"こ"],[11,1,"てつ"],[13,1,"つの"],[15,1,"つく"],[18,1,"い"],[23,1,"しゅ"],[27,1,"おお"],[43,1,"つの"],[54,1,"つ"],[57,1,"かれ"],[60,1,"ほろ"]],"text":"ケナアナの子ゼデキヤは鉄の角を造って言った、「主はこう仰せられます、『あなたはこれらの角をもってスリヤびとを突いて彼らを滅ぼしなさい』」。"},{"ref":"1Kgs.22.12","start":11022012,"end":11022012,"break":"none","ruby":[[0,3,"よげんしゃ"],[6,1,"みな"],[12,2,"よげん"],[16,1,"い"],[30,1,"のぼ"],[36,2,"しょうり"],[39,1,"え"],[44,1,"しゅ"],[49,1,"おう"],[51,1,"て"]],"text":"預言者たちは皆そのように預言して言った、「ラモテ・ギレアデに上っていって勝利を得なさい。主はそれを王の手にわたされるでしょう」。"},{"ref":"1Kgs.22.13","start":11022013,"end":11022013,"break":"paragraph","ruby":[[6,1,"よ"],[12,2,"ししゃ"],[15,1,"かれ"],[17,1,"い"],[22,3,"よげんしゃ"],[28,2,"いっち"],[32,1,"おう"],[34,1,"よ"],[36,1,"こと"],[38,1,"い"],[53,1,"かれ"],[60,2,"ことば"],[69,1,"よ"],[71,1,"こと"],[73,1,"い"]],"text":"さてミカヤを呼びにいった使者は彼に言った、「預言者たちは一致して王に良い事を言いました。どうぞ、あなたも、彼らのひとりの言葉のようにして、良い事を言ってください」。"},{"ref":"1Kgs.22.14","start":11022014,"end":11022014,"break":"none","ruby":[[4,1,"い"],[9,1,"しゅ"],[11,1,"い"],[20,1,"しゅ"],[26,1,"い"],[30,1,"こと"],[32,1,"もう"]],"text":"ミカヤは言った、「主は生きておられます。主がわたしに言われる事を申しましょう」。"},{"ref":"1Kgs.22.15","start":11022015,"end":11022015,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おう"],[4,1,"ところ"],[6,1,"い"],[10,1,"おう"],[12,1,"かれ"],[14,1,"い"],[38,1,"たたか"],[41,1,"い"],[55,1,"ひか"],[67,1,"かれ"],[69,1,"おう"],[71,1,"い"],[76,1,"のぼ"],[82,2,"しょうり"],[85,1,"え"],[90,1,"しゅ"],[95,1,"おう"],[97,1,"て"]],"text":"彼が王の所へ行くと、王は彼に言った、「ミカヤよ、われわれはラモテ・ギレアデに戦いに行くべきでしょうか、あるいは控えるべきでしょうか」。彼は王に言った、「上っていって勝利を得なさい。主はそれを王の手にわたされるでしょう」。"},{"ref":"1Kgs.22.16","start":11022016,"end":11022016,"break":"none","ruby":[[3,1,"おう"],[5,1,"かれ"],[7,1,"い"],[12,1,"いく"],[19,1,"ちか"],[29,1,"しゅ"],[31,1,"な"],[39,2,"しんじつ"],[48,1,"つ"]],"text":"しかし王は彼に言った、「幾たびあなたを誓わせたら、あなたは主の名をもって、ただ真実のみをわたしに告げるでしょうか」。"},{"ref":"1Kgs.22.17","start":11022017,"end":11022017,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[17,1,"みな"],[19,2,"ぼくしゃ"],[24,1,"ひつじ"],[30,1,"やま"],[32,1,"ち"],[39,1,"み"],[47,1,"しゅ"],[54,1,"もの"],[56,2,"かいぬし"],[63,1,"かれ"],[70,1,"やす"],[77,1,"いえ"],[79,1,"かえ"],[85,1,"い"]],"text":"彼は言った、「わたしはイスラエルが皆、牧者のない羊のように、山に散っているのを見ました。すると主は『これらの者は飼主がいない。彼らをそれぞれ安らかに、その家に帰らせよ』と言われました」。"},{"ref":"1Kgs.22.18","start":11022018,"end":11022018,"break":"none","ruby":[[6,1,"おう"],[14,1,"い"],[19,1,"かれ"],[28,1,"よ"],[30,1,"こと"],[32,2,"よげん"],[39,1,"わる"],[41,1,"こと"],[45,2,"よげん"],[55,1,"つ"]],"text":"イスラエルの王はヨシャパテに言った、「彼がわたしについて良い事を預言せず、ただ悪い事だけを預言すると、あなたに告げたではありませんか」。"},{"ref":"1Kgs.22.19","start":11022019,"end":11022019,"break":"none","ruby":[[4,1,"い"],[13,1,"しゅ"],[15,2,"ことば"],[18,1,"き"],[28,1,"しゅ"],[32,2,"ぎょくざ"],[39,1,"てん"],[41,2,"ばんぐん"],[52,2,"みぎひだり"],[55,1,"た"],[62,1,"み"]],"text":"ミカヤは言った、「それゆえ主の言葉を聞きなさい。わたしは主がその玉座にすわり、天の万軍がそのかたわらに、右左に立っているのを見たが、"},{"ref":"1Kgs.22.20","start":11022020,"end":11022020,"break":"none","ruby":[[0,1,"しゅ"],[24,1,"のぼ"],[28,1,"かれ"],[30,1,"たお"],[42,1,"い"],[58,1,"こと"],[60,1,"い"],[70,1,"こと"],[72,1,"い"]],"text":"主は『だれがアハブをいざなってラモテ・ギレアデに上らせ、彼を倒れさせるであろうか』と言われました。するとひとりはこの事を言い、ひとりはほかの事を言いました。"},{"ref":"1Kgs.22.21","start":11022021,"end":11022021,"break":"none","ruby":[[2,1,"とき"],[6,1,"れい"],[8,1,"すす"],[10,1,"で"],[13,1,"しゅ"],[15,1,"まえ"],[17,1,"た"],[25,1,"かれ"],[37,1,"い"]],"text":"その時一つの霊が進み出て、主の前に立ち、『わたしが彼をいざないましょう』と言いました。"},{"ref":"1Kgs.22.22","start":11022022,"end":11022022,"break":"none","ruby":[[0,1,"しゅ"],[8,2,"ほうほう"],[17,1,"い"],[24,1,"かれ"],[31,1,"で"],[33,1,"い"],[37,1,"いつわ"],[40,1,"い"],[42,1,"れい"],[52,3,"よげんしゃ"],[56,1,"くち"],[58,1,"やど"],[66,1,"い"],[75,1,"しゅ"],[82,1,"かれ"],[93,1,"な"],[95,1,"と"],[103,1,"で"],[105,1,"い"],[117,1,"い"]],"text":"主は『どのような方法でするのか』と言われたので、彼は『わたしが出て行って、偽りを言う霊となって、すべての預言者の口に宿りましょう』と言いました。そこで主は『おまえは彼をいざなって、それを成し遂げるであろう。出て行って、そうしなさい』と言われました。"},{"ref":"1Kgs.22.23","start":11022023,"end":11022023,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"いつわ"],[8,1,"い"],[10,1,"れい"],[20,3,"よげんしゃ"],[24,1,"くち"],[26,1,"い"],[31,1,"しゅ"],[37,1,"み"],[39,1,"おこ"],[41,1,"わざわい"],[43,1,"つ"]],"text":"それで主は偽りを言う霊をあなたのすべての預言者の口に入れ、また主はあなたの身に起る災を告げられたのです」。"},{"ref":"1Kgs.22.24","start":11022024,"end":11022024,"break":"none","ruby":[[8,1,"こ"],[14,2,"ちかよ"],[26,1,"う"],[29,1,"い"],[41,1,"しゅ"],[43,1,"れい"],[49,1,"はな"],[57,1,"かた"]],"text":"するとケナアナの子ゼデキヤは近寄って、ミカヤのほおを打って言った、「どのようにして主の霊がわたしを離れて、あなたに語りましたか」。"},{"ref":"1Kgs.22.25","start":11022025,"end":11022025,"break":"none","ruby":[[4,1,"い"],[13,1,"おく"],[15,1,"あいだ"],[21,1,"み"],[23,1,"かく"],[27,1,"ひ"]],"text":"ミカヤは言った、「あなたが奥の間にはいって身を隠すその日に、わかるでしょう」。"},{"ref":"1Kgs.22.26","start":11022026,"end":11022026,"break":"none","ruby":[[6,1,"おう"],[8,1,"い"],[17,1,"とら"],[20,1,"まち"],[30,1,"おう"],[32,1,"こ"],[37,1,"ところ"],[39,1,"ひ"],[42,1,"かえ"]],"text":"イスラエルの王は言った、「ミカヤを捕え、町のつかさアモンと、王の子ヨアシの所へ引いて帰って、"},{"ref":"1Kgs.22.27","start":11022027,"end":11022027,"break":"none","ruby":[[0,1,"い"],[7,1,"おう"],[11,1,"い"],[18,1,"もの"],[20,2,"ごくや"],[23,1,"い"],[33,1,"みず"],[38,1,"かれ"],[40,1,"やしな"],[47,2,"しょうり"],[50,1,"え"],[52,1,"かえ"],[59,1,"ま"]],"text":"言いなさい、『王がこう言います、この者を獄屋に入れ、わずかのパンと水をもって彼を養い、わたしが勝利を得て帰ってくるのを待て』」。"},{"ref":"1Kgs.22.28","start":11022028,"end":11022028,"break":"none","ruby":[[4,1,"い"],[15,2,"しょうり"],[18,1,"え"],[20,1,"かえ"],[31,1,"しゅ"],[40,1,"かた"],[54,1,"かれ"],[56,1,"い"],[71,1,"たみ"],[74,1,"き"]],"text":"ミカヤは言った、「もしあなたが勝利を得て帰ってこられるならば、主がわたしによって語られなかったのです」。また彼は言った、「あなたがた、すべての民よ、聞きなさい」。"},{"ref":"1Kgs.22.29","start":11022029,"end":11022029,"break":"paragraph","ruby":[[10,1,"おう"],[15,1,"おう"],[31,1,"のぼ"]],"text":"こうしてイスラエルの王とユダの王ヨシャパテはラモテ・ギレアデに上っていった。"},{"ref":"1Kgs.22.30","start":11022030,"end":11022030,"break":"none","ruby":[[6,1,"おう"],[14,1,"い"],[23,1,"すがた"],[25,1,"か"],[29,1,"たたか"],[32,1,"い"],[41,1,"おう"],[43,1,"ふく"],[45,1,"つ"],[58,1,"おう"],[60,1,"すがた"],[62,1,"か"],[65,1,"たたか"],[68,1,"い"]],"text":"イスラエルの王はヨシャパテに言った、「わたしは姿を変えて、戦いに行きます。あなたは王の服を着けなさい」。イスラエルの王は姿を変えて戦いに行った。"},{"ref":"1Kgs.22.31","start":11022031,"end":11022031,"break":"none","ruby":[[7,1,"おう"],[12,2,"せんしゃ"],[14,1,"ちょう"],[18,1,"にん"],[20,1,"めい"],[23,1,"い"],[35,1,"ちい"],[38,1,"もの"],[41,1,"おお"],[44,1,"もの"],[47,1,"たたか"],[61,1,"おう"],[65,1,"たたか"]],"text":"さて、スリヤの王は、その戦車長三十二人に命じて言った、「あなたがたは、小さい者とも大きい者とも戦わないで、ただイスラエルの王とだけ戦いなさい」。"},{"ref":"1Kgs.22.32","start":11022032,"end":11022032,"break":"none","ruby":[[0,2,"せんしゃ"],[2,1,"ちょう"],[11,1,"み"],[28,1,"おう"],[31,1,"おも"],[37,1,"み"],[48,1,"たたか"],[62,1,"よ"]],"text":"戦車長らはヨシャパテを見たとき、これはきっとイスラエルの王だと思ったので、身をめぐらして、これと戦おうとすると、ヨシャパテは呼ばわった。"},{"ref":"1Kgs.22.33","start":11022033,"end":11022033,"break":"none","ruby":[[0,2,"せんしゃ"],[2,1,"ちょう"],[5,1,"かれ"],[13,1,"おう"],[19,1,"み"],[24,1,"かれ"],[26,1,"お"],[34,1,"ひ"],[36,1,"かえ"]],"text":"戦車長らは彼がイスラエルの王でないのを見たので、彼を追うことをやめて引き返した。"},{"ref":"1Kgs.22.34","start":11022034,"end":11022034,"break":"none","ruby":[[8,1,"ひと"],[10,1,"なに"],[11,1,"こころ"],[14,1,"ゆみ"],[26,1,"おう"],[28,2,"むねあて"],[31,2,"くさずり"],[34,1,"あいだ"],[36,1,"い"],[41,1,"かれ"],[45,2,"せんしゃ"],[48,2,"ぎょしゃ"],[51,1,"い"],[60,1,"きず"],[62,1,"う"],[66,2,"せんしゃ"],[79,2,"せんじょう"],[83,1,"はこ"],[85,1,"だ"]],"text":"しかし、ひとりの人が何心なく弓をひいて、イスラエルの王の胸当と草摺の間を射たので、彼はその戦車の御者に言った、「わたしは傷を受けた。戦車をめぐらして、わたしを戦場から運び出せ」。"},{"ref":"1Kgs.22.35","start":11022035,"end":11022035,"break":"none","ruby":[[2,1,"ひ"],[3,1,"たたか"],[6,1,"はげ"],[13,1,"おう"],[15,2,"せんしゃ"],[18,1,"なか"],[26,1,"た"],[47,2,"ゆうぐれ"],[53,1,"し"],[57,1,"きず"],[59,1,"ち"],[61,2,"せんしゃ"],[64,1,"そこ"],[66,1,"なが"]],"text":"その日戦いは激しくなった。王は戦車の中にささえられて立ち、スリヤびとにむかっていたが、ついに、夕暮になって死んだ。傷の血は戦車の底に流れた。"},{"ref":"1Kgs.22.36","start":11022036,"end":11022036,"break":"none","ruby":[[0,1,"ひ"],[2,1,"ぼっ"],[8,2,"ぐんぜい"],[11,1,"なか"],[13,1,"よ"],[17,1,"こえ"],[29,1,"まち"],[38,1,"くに"],[40,1,"かえ"]],"text":"日の没するころ、軍勢の中に呼ばわる声がした、「めいめいその町へ、めいめいその国へ帰れ」。"},{"ref":"1Kgs.22.37","start":11022037,"end":11022037,"break":"paragraph","ruby":[[0,1,"おう"],[2,1,"し"],[11,1,"たずさ"],[13,1,"い"],[18,2,"ひとびと"],[21,1,"おう"],[28,1,"ほうむ"]],"text":"王は死んで、サマリヤへ携え行かれた。人々は王をサマリヤに葬った。"},{"ref":"1Kgs.22.38","start":11022038,"end":11022038,"break":"none","ruby":[[4,2,"せんしゃ"],[12,1,"いけ"],[14,1,"あら"],[19,1,"いぬ"],[23,1,"ち"],[31,2,"ゆうじょ"],[37,1,"み"],[39,1,"あら"],[43,1,"しゅ"],[45,1,"い"],[49,2,"ことば"]],"text":"またその戦車をサマリヤの池で洗ったが、犬がその血をなめた。また遊女がそこで身を洗った。主が言われた言葉のとおりである。"},{"ref":"1Kgs.22.39","start":11022039,"end":11022039,"break":"none","ruby":[[9,2,"じせき"],[13,1,"かれ"],[21,1,"こと"],[26,1,"た"],[29,2,"ぞうげ"],[32,1,"いえ"],[37,1,"た"],[44,1,"まち"],[53,1,"おう"],[55,3,"れきだいし"],[59,1,"しょ"]],"text":"アハブのそのほかの事績と、彼がしたすべての事と、その建てた象牙の家と、その建てたすべての町は、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"1Kgs.22.40","start":11022040,"end":11022040,"break":"none","ruby":[[10,2,"せんぞ"],[13,1,"とも"],[15,1,"ねむ"],[21,1,"こ"],[27,1,"かわ"],[30,1,"おう"]],"text":"こうしてアハブはその先祖と共に眠って、その子アハジヤが代って王となった。"},{"ref":"1Kgs.22.41","start":11022041,"end":11022041,"break":"paragraph","ruby":[[3,1,"こ"],[16,1,"おう"],[21,1,"だい"],[23,1,"ねん"],[28,1,"おう"]],"text":"アサの子ヨシャパテはイスラエルの王アハブの第四年にユダの王となった。"},{"ref":"1Kgs.22.42","start":11022042,"end":11022042,"break":"none","ruby":[[6,1,"おう"],[11,1,"とき"],[16,1,"さい"],[32,1,"ねん"],[33,1,"よ"],[35,1,"おさ"],[41,1,"はは"],[43,1,"な"],[56,1,"むすめ"]],"text":"ヨシャパテは王となった時、三十五歳であったが、エルサレムで二十五年世を治めた。その母の名はアズバといい、シルヒの娘であった。"},{"ref":"1Kgs.22.43","start":11022043,"end":11022043,"break":"none","ruby":[[6,1,"ちち"],[14,1,"みち"],[16,1,"あゆ"],[22,1,"はな"],[30,1,"しゅ"],[32,1,"め"],[37,1,"こと"],[45,1,"たか"],[47,1,"ところ"],[49,1,"のぞ"],[58,1,"たみ"],[62,1,"たか"],[64,1,"ところ"],[66,2,"ぎせい"],[73,1,"こう"]],"text":"ヨシャパテは父アサのすべての道に歩み、それを離れることなく、主の目にかなう事をした。ただし高き所は除かなかったので、民はなお高き所で犠牲をささげ、香をたいた。"},{"ref":"1Kgs.22.44","start":11022044,"end":11022044,"break":"none","ruby":[[14,1,"おう"],[21,1,"むす"]],"text":"ヨシャパテはまたイスラエルの王と、よしみを結んだ。"},{"ref":"1Kgs.22.45","start":11022045,"end":11022045,"break":"paragraph","ruby":[[8,1,"た"],[10,2,"じせき"],[14,1,"かれ"],[21,2,"くんこう"],[28,2,"せんそう"],[39,1,"おう"],[41,3,"れきだいし"],[45,1,"しょ"]],"text":"ヨシャパテのその他の事績と、彼があらわした勲功およびその戦争については、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"1Kgs.22.46","start":11022046,"end":11022046,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ちち"],[6,1,"よ"],[10,1,"のこ"],[15,2,"しんでん"],[17,2,"だんしょう"],[22,1,"くに"],[28,1,"お"],[30,1,"はら"]],"text":"彼は父アサの世になお残っていた神殿男娼たちを国のうちから追い払った。"},{"ref":"1Kgs.22.47","start":11022047,"end":11022047,"break":"paragraph","ruby":[[9,1,"おう"],[14,2,"だいかん"],[17,1,"おう"]],"text":"そのころエドムには王がなく、代官が王であった。"},{"ref":"1Kgs.22.48","start":11022048,"end":11022048,"break":"none","ruby":[[11,1,"ふね"],[13,1,"つく"],[17,1,"きん"],[19,1,"え"],[28,1,"い"],[40,1,"ふね"],[51,2,"なんぱ"],[61,1,"い"]],"text":"ヨシャパテはタルシシの船を造って、金を獲るためにオフルに行かせようとしたが、その船はエジオン・ゲベルで難破したため、ついに行かなかった。"},{"ref":"1Kgs.22.49","start":11022049,"end":11022049,"break":"none","ruby":[[7,1,"こ"],[24,2,"けらい"],[31,2,"けらい"],[34,2,"いっしょ"],[37,1,"ふね"],[39,1,"い"],[47,1,"い"],[58,2,"しょうち"]],"text":"そこでアハブの子アハジヤはヨシャパテに「わたしの家来をあなたの家来と一緒に船で行かせなさい」と言ったが、ヨシャパテは承知しなかった。"},{"ref":"1Kgs.22.50","start":11022050,"end":11022050,"break":"none","ruby":[[8,2,"せんぞ"],[11,1,"とも"],[13,1,"ねむ"],[17,1,"ちち"],[22,1,"まち"],[24,2,"せんぞ"],[27,1,"とも"],[29,1,"ほうむ"],[35,1,"こ"],[40,1,"かわ"],[43,1,"おう"]],"text":"ヨシャパテはその先祖と共に眠って、父ダビデの町に先祖と共に葬られ、その子ヨラムが代って王となった。"},{"ref":"1Kgs.22.51","start":11022051,"end":11022051,"break":"paragraph","ruby":[[4,1,"こ"],[13,1,"おう"],[20,1,"だい"],[23,1,"ねん"],[36,1,"おう"],[42,1,"ねん"],[49,1,"おさ"]],"text":"アハブの子アハジヤはユダの王ヨシャパテの第十七年にサマリヤでイスラエルの王となり、二年イスラエルを治めた。"},{"ref":"1Kgs.22.52","start":11022052,"end":11022052,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[10,1,"おこな"],[15,1,"ちち"],[17,1,"みち"],[22,1,"はは"],[24,1,"みち"],[37,1,"つみ"],[39,1,"おか"],[47,1,"こ"],[54,1,"みち"],[56,1,"あゆ"]],"text":"彼は主の目の前に悪を行い、その父の道と、その母の道、およびかのイスラエルに罪を犯させたネバテの子ヤラベアムの道に歩み、"},{"ref":"1Kgs.22.53","start":11022053,"end":11022053,"break":"none","ruby":[[4,1,"つか"],[11,1,"おが"],[20,1,"かみ"],[22,1,"しゅ"],[24,1,"いか"],[32,1,"かれ"],[34,1,"ちち"]],"text":"バアルに仕えて、それを拝み、イスラエルの神、主を怒らせた。すべて彼の父がしたとおりであった。"}]