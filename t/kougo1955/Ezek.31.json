[{"ref":"Ezek.31.1","start":26031001,"end":26031001,"break":"paragraph","ruby":[[0,1,"だい"],[3,1,"ねん"],[6,1,"がつ"],[8,1,"にち"],[10,1,"しゅ"],[12,2,"ことば"],[19,1,"のぞ"]],"text":"第十一年の三月一日に主の言葉がわたしに臨んだ、"},{"ref":"Ezek.31.2","start":26031002,"end":26031002,"break":"none","breaks":[[25,"stanza"]],"ruby":[[1,1,"ひと"],[3,1,"こ"],[11,1,"おう"],[18,2,"みんしゅう"],[22,1,"い"],[31,1,"おお"],[41,1,"に"]],"text":"「人の子よ、エジプトの王パロと、その民衆とに言え、あなたはその大いなること、だれに似ているか。"},{"ref":"Ezek.31.3","start":26031003,"end":26031003,"break":"line","breaks":[[11,"line"],[25,"line"],[43,"line"]],"ruby":[[0,1,"み"],[16,2,"こうはく"],[25,1,"うるわ"],[28,1,"えだ"],[30,1,"もり"],[32,1,"かげ"],[40,1,"たか"],[45,1,"いただき"],[47,1,"くも"],[49,1,"なか"]],"text":"見よ、わたしはあなたをレバノンの香柏のようにする。麗しき枝と森の陰があり、たけが高く、その頂は雲の中にある。"},{"ref":"Ezek.31.4","start":26031004,"end":26031004,"break":"line","breaks":[[8,"line"],[19,"line"],[38,"line"]],"ruby":[[0,1,"みず"],[5,1,"そだ"],[8,2,"おおみず"],[14,1,"たか"],[21,2,"かわがわ"],[26,1,"う"],[29,1,"ところ"],[35,1,"なが"],[40,1,"なが"],[43,1,"の"],[49,1,"き"],[51,1,"おく"]],"text":"水はこれを育て、大水がこれを高くする。その川々はその植えた所をめぐって流れ、その流れを野のすべての木に送る。"},{"ref":"Ezek.31.5","start":26031005,"end":26031005,"break":"line","breaks":[[12,"line"],[27,"line"],[41,"line"]],"ruby":[[12,1,"の"],[18,1,"き"],[22,1,"たか"],[29,1,"そだ"],[33,1,"おお"],[36,1,"みず"],[41,2,"えだは"],[44,1,"しげ"],[47,1,"えだ"],[49,1,"の"]],"text":"これによってそのたけは、野のすべての木よりも高くなり、その育つとき多くの水のために枝葉は茂り、枝は伸び、"},{"ref":"Ezek.31.6","start":26031006,"end":26031006,"break":"line","breaks":[[20,"line"],[39,"line"]],"ruby":[[2,2,"えだは"],[5,1,"そら"],[11,1,"とり"],[14,1,"す"],[22,1,"えだ"],[24,1,"した"],[26,1,"の"],[32,1,"けもの"],[34,1,"こ"],[36,1,"う"],[41,1,"かげ"],[48,2,"こくみん"],[51,1,"す"]],"text":"その枝葉に空のすべての鳥が、巣をつくり、その枝の下に野のすべての獣は子を生み、その陰にもろもろの国民は住む。"},{"ref":"Ezek.31.7","start":26031007,"end":26031007,"break":"line","breaks":[[12,"line"],[30,"line"]],"ruby":[[5,1,"おお"],[14,1,"えだ"],[16,1,"なが"],[24,1,"うつく"],[32,1,"ね"],[34,1,"おお"],[37,1,"みず"]],"text":"これはその大きなことと、その枝の長いことによって美しかった。その根を多くの水に、おろしていたからである。"},{"ref":"Ezek.31.8","start":26031008,"end":26031008,"break":"line","breaks":[[21,"line"],[36,"line"],[51,"line"],[70,"line"]],"ruby":[[0,1,"かみ"],[2,1,"その"],[4,2,"こうはく"],[11,1,"きそ"],[24,1,"き"],[28,2,"えだは"],[31,1,"およ"],[42,1,"えだ"],[44,1,"くら"],[51,1,"かみ"],[53,1,"その"],[59,1,"き"],[64,1,"うるわ"],[73,1,"ひ"]],"text":"神の園の香柏も、これと競うことはできない。もみの木もその枝葉に及ばない。けやきもその枝と比べられない。神の園のすべての木も、その麗しきこと、これに比すべきものはない。"},{"ref":"Ezek.31.9","start":26031009,"end":26031009,"break":"line","breaks":[[22,"line"],[35,"line"]],"ruby":[[6,1,"えだ"],[8,1,"おお"],[16,1,"うつく"],[22,1,"かみ"],[24,1,"その"],[32,1,"き"],[34,1,"みな"]],"text":"わたしはその枝を多くして、これを美しくした。神の園にあるエデンの木は皆これをうらやんだ。"},{"ref":"Ezek.31.10","start":26031010,"end":26031010,"break":"paragraph","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[24,1,"たか"],[31,1,"いただき"],[33,1,"くも"],[35,1,"なか"],[42,1,"こころ"],[44,1,"たか"]],"text":"それゆえ、主なる神はこう言われる、これは、たけが高くなり、その頂を雲の中におき、その心が高ぶりおごるゆえ、"},{"ref":"Ezek.31.11","start":26031011,"end":26031011,"break":"none","ruby":[[13,2,"こくみん"],[16,1,"ちから"],[19,1,"もの"],[21,1,"て"],[23,1,"わた"],[26,1,"かれ"],[31,1,"たい"],[36,1,"あく"],[41,1,"ただ"],[44,2,"しょち"],[57,1,"お"],[59,1,"だ"]],"text":"わたしはこれを、もろもろの国民の力ある者の手に渡す。彼はこれに対してその悪のために正しい処置をとる。わたしはこれを追い出した。"},{"ref":"Ezek.31.12","start":26031012,"end":26031012,"break":"none","ruby":[[5,2,"こくみん"],[8,1,"もっと"],[10,1,"おそ"],[15,3,"いほうじん"],[22,1,"き"],[24,1,"たお"],[27,1,"す"],[33,1,"えだ"],[40,1,"やま"],[47,1,"たに"],[50,1,"お"],[55,2,"えだは"],[58,1,"くだ"],[62,1,"ち"],[68,1,"なが"],[74,1,"ち"],[80,1,"たみ"],[85,1,"かげ"],[87,1,"はな"],[94,1,"す"]],"text":"もろもろの国民の最も恐れている異邦人はこれを切り倒して捨てる。その枝はもろもろの山と、すべての谷とに落ち、その枝葉は砕けて、地のすべての流れにあり、地のすべての民は、その陰を離れて、これを捨てる。"},{"ref":"Ezek.31.13","start":26031013,"end":26031013,"break":"none","ruby":[[2,1,"たお"],[5,1,"ところ"],[8,1,"そら"],[15,1,"とり"],[17,1,"す"],[22,1,"えだ"],[24,1,"うえ"],[27,1,"の"],[34,1,"けもの"]],"text":"その倒れた所に、空のもろもろの鳥は住み、その枝の上に、野のもろもろの獣はいる。"},{"ref":"Ezek.31.14","start":26031014,"end":26031014,"break":"none","ruby":[[3,1,"みず"],[13,1,"き"],[18,1,"たか"],[24,1,"ほこ"],[33,1,"いただき"],[35,1,"くも"],[37,1,"なか"],[46,1,"みず"],[48,1,"うるお"],[50,1,"き"],[57,1,"たか"],[60,1,"た"],[77,1,"みな"],[79,1,"し"],[81,1,"わた"],[85,1,"した"],[87,1,"くに"],[89,1,"い"],[92,1,"あな"],[94,1,"くだ"],[96,1,"もの"],[98,1,"とも"],[100,1,"た"],[102,2,"ひとびと"]],"text":"これは水のほとりのすべての木が、その高さのために誇ることなく、その頂を雲の中におくことなく、水に潤う木が、みずから高ぶり立つことのないためである。これらは皆、死に渡され、下の国に入り、穴に下る者と共に他の人々のうちにいる。"},{"ref":"Ezek.31.15","start":26031015,"end":26031015,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[15,2,"よみ"],[18,1,"くだ"],[20,1,"ひ"],[26,1,"ふち"],[34,1,"かな"],[41,2,"かわがわ"],[52,2,"おおみず"],[76,1,"なげ"],[80,1,"の"],[86,1,"き"],[95,1,"おとろ"]],"text":"主なる神はこう言われる、これが陰府に下る日にわたしが淵をこれがために悲しませ、その川々をせきとめるので、大水はとどまる。わたしはレバノンを、これがために嘆かせ、野のすべての木を、これがために衰えさせる。"},{"ref":"Ezek.31.16","start":26031016,"end":26031016,"break":"none","ruby":[[7,1,"あな"],[9,1,"くだ"],[11,1,"もの"],[13,1,"とも"],[15,2,"よみ"],[18,1,"おと"],[20,1,"とき"],[27,2,"こくみん"],[32,1,"お"],[35,1,"ひび"],[42,1,"う"],[44,1,"ふる"],[61,1,"き"],[72,1,"うつく"],[81,1,"みず"],[83,1,"うるお"],[89,1,"した"],[91,1,"くに"],[93,1,"なぐさ"]],"text":"わたしがこれを穴に下る者と共に陰府に落す時、もろもろの国民をその落ちる響きのために、打ち震えさせる。そしてエデンのすべての木、レバノンのすぐれて美しいもの、すべて水に潤うものは、下の国で慰められる。"},{"ref":"Ezek.31.17","start":26031017,"end":26031017,"break":"none","ruby":[[0,1,"かれ"],[6,1,"とも"],[8,2,"よみ"],[11,1,"くだ"],[18,1,"ころ"],[22,1,"もの"],[28,1,"いた"],[40,2,"こくみん"],[49,1,"かげ"],[51,1,"す"],[54,1,"もの"],[56,1,"ほろ"]],"text":"彼らもこれと共に陰府に下り、つるぎで殺された者のところに至る。まことにもろもろの国民のうちで、その陰に住んだ者も滅びる。"},{"ref":"Ezek.31.18","start":26031018,"end":26031018,"break":"none","breaks":[[92,"paragraph"]],"ruby":[[4,1,"き"],[12,1,"さか"],[15,1,"おお"],[30,1,"に"],[51,1,"き"],[53,1,"とも"],[56,1,"した"],[58,1,"くに"],[60,1,"おと"],[68,1,"ころ"],[72,1,"もの"],[74,1,"とも"],[77,2,"かつれい"],[80,1,"う"],[84,1,"もの"],[89,1,"す"],[100,2,"みんしゅう"],[107,1,"しゅ"],[110,1,"かみ"],[112,1,"い"]],"text":"エデンの木のうちで、その栄えと大いなることで、あなたはどれに似ているのか。あなたはこのように、エデンの木と共に、下の国に落され、つるぎで殺された者と共に、割礼を受けない者のうちに住む。これがパロとその民衆であると、主なる神は言われる」。"}]