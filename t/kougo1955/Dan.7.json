[{"ref":"Dan.7.1","start":27007001,"end":27007001,"break":"paragraph","ruby":[[5,1,"おう"],[13,2,"がんねん"],[22,1,"とこ"],[27,1,"ゆめ"],[29,1,"み"],[33,1,"のう"],[34,1,"ちゅう"],[36,1,"まぼろし"],[38,1,"え"],[43,1,"かれ"],[47,1,"ゆめ"],[56,1,"こと"],[58,2,"たいい"],[61,1,"の"]],"text":"バビロンの王ベルシャザルの元年に、ダニエルは床にあって夢を見、また脳中に幻を得たので、彼はその夢をしるして、その事の大意を述べた。"},{"ref":"Dan.7.2","start":27007002,"end":27007002,"break":"none","ruby":[[5,1,"の"],[8,1,"い"],[17,1,"よる"],[19,1,"まぼろし"],[24,1,"み"],[27,1,"み"],[30,1,"てん"],[32,2,"しほう"],[37,1,"かぜ"],[39,2,"おおうみ"]],"text":"ダニエルは述べて言った、「わたしは夜の幻のうちに見た。見よ、天の四方からの風が大海をかきたてると、"},{"ref":"Dan.7.3","start":27007003,"end":27007003,"break":"none","ruby":[[3,1,"おお"],[6,1,"けもの"],[8,1,"うみ"],[20,1,"かたち"],[27,1,"こと"]],"text":"四つの大きな獣が海からあがってきた。その形は、おのおの異なり、"},{"ref":"Dan.7.4","start":27007004,"end":27007004,"break":"none","ruby":[[0,1,"だい"],[17,1,"つばさ"],[30,1,"み"],[38,1,"つばさ"],[40,1,"ぬ"],[48,1,"ち"],[51,1,"おこ"],[56,1,"ひと"],[62,1,"ほん"],[64,1,"あし"],[66,1,"た"],[74,1,"ひと"],[76,1,"こころ"],[78,1,"あた"]],"text":"第一のものは、ししのようで、わしの翼をもっていたが、わたしが見ていると、その翼は抜きとられ、また地から起されて、人のように二本の足で立たせられ、かつ人の心が与えられた。"},{"ref":"Dan.7.5","start":27007005,"end":27007005,"break":"none","ruby":[[0,1,"み"],[3,1,"だい"],[6,1,"けもの"],[8,1,"くま"],[26,2,"いっぽう"],[34,1,"くち"],[36,1,"は"],[38,1,"あいだ"],[42,1,"ぼん"],[44,2,"ろっこつ"],[58,1,"む"],[63,1,"お"],[70,1,"おお"],[73,1,"にく"],[75,1,"く"],[80,1,"い"],[82,1,"こえ"]],"text":"見よ、第二の獣は熊のようであった。これはそのからだの一方をあげ、その口の歯の間に、三本の肋骨をくわえていたが、これに向かって『起きあがって、多くの肉を食らえ』と言う声があった。"},{"ref":"Dan.7.6","start":27007006,"end":27007006,"break":"none","ruby":[[2,1,"のち"],[7,1,"み"],[19,1,"けもの"],[24,1,"せ"],[27,1,"とり"],[29,1,"つばさ"],[41,1,"けもの"],[47,1,"あたま"],[52,2,"しゅけん"],[55,1,"あた"]],"text":"その後わたしが見たのは、ひょうのような獣で、その背には鳥の翼が四つあった。またこの獣には四つの頭があり、主権が与えられた。"},{"ref":"Dan.7.7","start":27007007,"end":27007007,"break":"none","ruby":[[2,1,"のち"],[7,1,"よる"],[9,1,"まぼろし"],[14,1,"み"],[16,1,"だい"],[19,1,"けもの"],[22,1,"おそ"],[33,2,"ひじょう"],[36,1,"つよ"],[42,1,"おお"],[45,1,"てつ"],[47,1,"は"],[52,1,"く"],[61,1,"くだ"],[67,1,"のこ"],[70,1,"あし"],[72,1,"ふ"],[84,1,"まえ"],[86,1,"で"],[92,1,"けもの"],[94,1,"ちが"],[100,1,"つの"],[102,1,"も"]],"text":"その後わたしが夜の幻のうちに見た第四の獣は、恐ろしい、ものすごい、非常に強いもので、大きな鉄の歯があり、食らい、かつ、かみ砕いて、その残りを足で踏みつけた。これは、その前に出たすべての獣と違って、十の角を持っていた。"},{"ref":"Dan.7.8","start":27007008,"end":27007008,"break":"none","ruby":[[7,1,"つの"],[9,2,"ちゅうい"],[13,1,"み"],[21,1,"なか"],[29,1,"ちい"],[32,1,"つの"],[34,1,"で"],[42,1,"ちい"],[45,1,"つの"],[54,1,"つの"],[63,1,"ね"],[66,1,"ぬ"],[68,1,"お"],[72,1,"み"],[77,1,"ちい"],[80,1,"つの"],[84,1,"ひと"],[86,1,"め"],[91,1,"め"],[98,1,"おお"],[101,1,"こと"],[103,1,"かた"],[105,1,"くち"]],"text":"わたしが、その角を注意して見ていると、その中に、また一つの小さい角が出てきたが、この小さい角のために、さきの角のうち三つがその根から抜け落ちた。見よ、この小さい角には、人の目のような目があり、また大きな事を語る口があった。"},{"ref":"Dan.7.9","start":27007009,"end":27007009,"break":"none","breaks":[[10,"stanza"],[24,"line"],[40,"line"],[52,"line"],[75,"line"],[87,"line"]],"ruby":[[4,1,"み"],[16,1,"ざ"],[18,1,"もう"],[24,1,"ひ"],[26,1,"お"],[30,1,"もの"],[32,1,"ざ"],[42,1,"ころも"],[44,1,"ゆき"],[49,1,"しろ"],[52,1,"あたま"],[54,1,"け"],[56,1,"ま"],[64,1,"ひつじ"],[66,1,"け"],[78,1,"ざ"],[80,1,"ひ"],[82,1,"ほのお"],[89,2,"しゃりん"],[92,1,"も"],[95,1,"ひ"]],"text":"わたしが見ていると、もろもろのみ座が設けられて、日の老いたる者が座しておられた。その衣は雪のように白く、頭の毛は混じりもののない羊の毛のようであった。そのみ座は火の炎であり、その車輪は燃える火であった。"},{"ref":"Dan.7.10","start":27007010,"end":27007010,"break":"line","breaks":[[20,"line"],[30,"line"],[42,"line"],[56,"line"]],"ruby":[[0,1,"かれ"],[2,1,"まえ"],[8,1,"すじ"],[10,1,"ひ"],[12,1,"なが"],[15,1,"で"],[20,1,"かれ"],[22,1,"つか"],[25,1,"もの"],[27,2,"せんせん"],[30,1,"かれ"],[32,1,"まえ"],[37,1,"もの"],[39,2,"まんまん"],[42,2,"しんぱん"],[45,1,"おこな"],[47,1,"もの"],[51,1,"せき"],[53,1,"つ"],[61,1,"か"],[63,1,"もの"],[65,1,"ひら"]],"text":"彼の前から、ひと筋の火の流れが出てきた。彼に仕える者は千々、彼の前にはべる者は万々、審判を行う者はその席に着き、かずかずの書き物が開かれた。"},{"ref":"Dan.7.11","start":27007011,"end":27007011,"break":"none","ruby":[[7,1,"つの"],[9,1,"かた"],[11,1,"おお"],[15,2,"ことば"],[18,1,"こえ"],[24,1,"み"],[34,1,"み"],[38,1,"あいだ"],[42,1,"けもの"],[44,1,"ころ"],[61,1,"も"],[64,1,"ひ"],[66,1,"な"],[68,1,"い"]],"text":"わたしは、その角の語る大いなる言葉の声がするので見ていたが、わたしが見ている間にその獣は殺され、そのからだはそこなわれて、燃える火に投げ入れられた。"},{"ref":"Dan.7.12","start":27007012,"end":27007012,"break":"none","ruby":[[2,1,"た"],[4,1,"けもの"],[8,2,"しゅけん"],[11,1,"うば"],[19,1,"いのち"],[22,1,"とき"],[24,2,"きせつ"],[27,1,"く"],[31,1,"の"]],"text":"その他の獣はその主権を奪われたが、その命は、時と季節の来るまで延ばされた。"},{"ref":"Dan.7.13","start":27007013,"end":27007013,"break":"none","breaks":[[19,"stanza"],[32,"line"],[42,"line"],[57,"line"]],"ruby":[[6,1,"よる"],[8,1,"まぼろし"],[13,1,"み"],[19,1,"み"],[22,1,"ひと"],[24,1,"こ"],[29,1,"もの"],[32,1,"てん"],[34,1,"くも"],[36,1,"の"],[42,1,"ひ"],[44,1,"お"],[48,1,"もの"],[53,1,"く"],[59,1,"まえ"],[61,1,"みちび"]],"text":"わたしはまた夜の幻のうちに見ていると、見よ、人の子のような者が、天の雲に乗ってきて、日の老いたる者のもとに来ると、その前に導かれた。"},{"ref":"Dan.7.14","start":27007014,"end":27007014,"break":"line","breaks":[[14,"line"],[34,"line"],[49,"line"],[59,"line"]],"ruby":[[0,1,"かれ"],[2,2,"しゅけん"],[5,2,"こうえい"],[8,1,"くに"],[11,1,"たま"],[14,2,"しょみん"],[17,1,"しょ"],[18,1,"ぞく"],[20,2,"しょこく"],[22,1,"ご"],[24,1,"もの"],[26,1,"かれ"],[28,1,"つか"],[36,2,"しゅけん"],[39,2,"えいえん"],[42,2,"しゅけん"],[61,1,"くに"],[63,1,"ほろ"]],"text":"彼に主権と光栄と国とを賜い、諸民、諸族、諸国語の者を彼に仕えさせた。その主権は永遠の主権であって、なくなることがなく、その国は滅びることがない。"},{"ref":"Dan.7.15","start":27007015,"end":27007015,"break":"paragraph","ruby":[[17,1,"れい"],[19,1,"うれ"],[24,2,"のうちゅう"],[27,1,"まぼろし"],[34,1,"なや"]],"text":"そこで、われダニエル、わがうちなる霊は憂え、わが脳中の幻は、わたしを悩ましたので、"},{"ref":"Dan.7.16","start":27007016,"end":27007016,"break":"none","ruby":[[8,1,"た"],[13,1,"もの"],[19,2,"ちかよ"],[30,1,"こと"],[32,2,"しんい"],[35,1,"たず"],[44,1,"もの"],[53,1,"こと"],[55,1,"と"],[57,1,"あ"],[61,1,"つ"],[63,1,"し"]],"text":"わたしは、そこに立っている者のひとりに近寄って、このすべての事の真意を尋ねた。するとその者は、わたしにこの事の解き明かしを告げ知らせた。"},{"ref":"Dan.7.17","start":27007017,"end":27007017,"break":"none","ruby":[[6,1,"おお"],[9,1,"けもの"],[12,1,"ち"],[14,1,"おこ"],[21,1,"にん"],[23,1,"おう"]],"text":"『この四つの大きな獣は、地に起らんとする四人の王である。"},{"ref":"Dan.7.18","start":27007018,"end":27007018,"break":"none","ruby":[[10,1,"たか"],[12,1,"もの"],[14,2,"せいと"],[17,1,"くに"],[19,1,"う"],[22,2,"えいえん"],[27,1,"くに"],[29,1,"たも"],[33,2,"よよ"],[40,1,"つづ"]],"text":"しかしついには、いと高き者の聖徒が国を受け、永遠にその国を保って、世々かぎりなく続く』。"},{"ref":"Dan.7.19","start":27007019,"end":27007019,"break":"paragraph","ruby":[[11,1,"だい"],[14,1,"けもの"],[16,2,"しんい"],[19,1,"し"],[28,1,"けもの"],[30,1,"た"],[32,1,"けもの"],[34,1,"こと"],[43,1,"おそ"],[50,1,"は"],[52,1,"てつ"],[59,2,"せいどう"],[66,1,"く"],[75,1,"くだ"],[81,1,"のこ"],[84,1,"あし"],[86,1,"ふ"]],"text":"そこでわたしは、さらに第四の獣の真意を知ろうとした。その獣は他の獣と異なって、はなはだ恐ろしく、その歯は鉄、そのつめは青銅であって、食らい、かつ、かみ砕いて、その残りを足で踏みつけた。"},{"ref":"Dan.7.20","start":27007020,"end":27007020,"break":"none","ruby":[[2,1,"けもの"],[4,1,"あたま"],[10,1,"つの"],[25,1,"つの"],[27,1,"で"],[36,1,"つの"],[45,1,"つの"],[47,1,"ぬ"],[49,1,"お"],[55,1,"つの"],[58,1,"め"],[65,1,"おお"],[68,1,"こと"],[70,1,"かた"],[72,1,"くち"],[80,1,"かたち"],[85,2,"どうるい"],[93,1,"おお"],[96,1,"み"]],"text":"この獣の頭には、十の角があったが、そのほかに一つの角が出てきたので、この角のために、三つの角が抜け落ちた。この角には目があり、また大きな事を語る口があって、その形は、その同類のものよりも大きく見えた。"},{"ref":"Dan.7.21","start":27007021,"end":27007021,"break":"none","ruby":[[4,1,"み"],[12,1,"つの"],[14,2,"せいと"],[17,1,"たたか"],[21,1,"かれ"],[24,1,"か"]],"text":"わたしが見ていると、この角は聖徒と戦って、彼らに勝ったが、"},{"ref":"Dan.7.22","start":27007022,"end":27007022,"break":"none","ruby":[[3,1,"ひ"],[5,1,"お"],[9,1,"もの"],[16,1,"たか"],[18,1,"もの"],[20,2,"せいと"],[26,2,"しんぱん"],[40,1,"とき"],[47,2,"せいと"],[52,1,"くに"],[54,1,"う"]],"text":"ついに日の老いたる者がきて、いと高き者の聖徒のために審判をおこなった。そしてその時がきて、この聖徒たちは国を受けた。"},{"ref":"Dan.7.23","start":27007023,"end":27007023,"break":"stanza","breaks":[[8,"line"],[25,"line"],[39,"line"],[47,"line"]],"ruby":[[0,1,"かれ"],[4,1,"い"],[9,1,"だい"],[12,1,"けもの"],[14,2,"ちじょう"],[17,1,"だい"],[20,1,"くに"],[32,1,"くに"],[34,1,"こと"],[39,1,"ぜん"],[40,2,"せかい"],[43,2,"へいごう"],[50,1,"ふ"],[57,1,"う"],[59,1,"くだ"]],"text":"彼はこう言った、『第四の獣は地上の第四の国である。これはすべての国と異なって、全世界を併合し、これを踏みつけ、かつ打ち砕く。"},{"ref":"Dan.7.24","start":27007024,"end":27007024,"break":"line","breaks":[[19,"line"],[34,"line"],[44,"line"]],"ruby":[[2,1,"つの"],[6,1,"くに"],[9,1,"おこ"],[12,1,"にん"],[14,1,"おう"],[21,1,"のち"],[29,1,"おう"],[31,1,"おこ"],[34,1,"かれ"],[36,1,"さき"],[38,1,"もの"],[40,1,"こと"],[50,1,"にん"],[52,1,"おう"],[54,1,"たお"]],"text":"十の角はこの国から起る十人の王である。その後にまたひとりの王が起る。彼は先の者と異なり、かつ、その三人の王を倒す。"},{"ref":"Dan.7.25","start":27007025,"end":27007025,"break":"line","breaks":[[18,"line"],[34,"line"],[52,"line"],[70,"line"]],"ruby":[[0,1,"かれ"],[5,1,"たか"],[7,1,"もの"],[9,1,"てき"],[12,2,"ことば"],[15,1,"だ"],[23,1,"たか"],[25,1,"もの"],[27,2,"せいと"],[30,1,"なや"],[34,1,"かれ"],[38,1,"とき"],[40,2,"りっぽう"],[44,1,"か"],[49,1,"のぞ"],[52,2,"せいと"],[57,1,"とき"],[62,1,"とき"],[65,2,"はんとき"],[68,1,"あいだ"],[70,1,"かれ"],[72,1,"て"]],"text":"彼は、いと高き者に敵して言葉を出し、かつ、いと高き者の聖徒を悩ます。彼はまた時と律法とを変えようと望む。聖徒はひと時と、ふた時と、半時の間、彼の手にわたされる。"},{"ref":"Dan.7.26","start":27007026,"end":27007026,"break":"line","breaks":[[10,"line"],[20,"line"]],"ruby":[[3,2,"しんぱん"],[6,1,"おこな"],[10,1,"かれ"],[12,2,"しゅけん"],[15,1,"うば"],[20,2,"えいえん"],[23,1,"ほろ"],[25,1,"た"]],"text":"しかし審判が行われ、彼の主権は奪われて、永遠に滅び絶やされ、"},{"ref":"Dan.7.27","start":27007027,"end":27007027,"break":"line","breaks":[[17,"line"],[35,"line"],[49,"line"]],"ruby":[[0,1,"くに"],[2,2,"しゅけん"],[5,1,"ぜん"],[6,2,"てんか"],[9,2,"くにぐに"],[12,2,"けんい"],[19,1,"たか"],[21,1,"もの"],[23,2,"せいと"],[27,1,"たみ"],[29,1,"あた"],[35,1,"かれ"],[38,1,"くに"],[40,2,"えいえん"],[43,1,"くに"],[49,2,"しょこく"],[52,1,"もの"],[56,1,"かれ"],[59,1,"つか"],[64,1,"したが"]],"text":"国と主権と全天下の国々の権威とは、いと高き者の聖徒たる民に与えられる。彼らの国は永遠の国であって、諸国の者はみな彼らに仕え、かつ従う』。"},{"ref":"Dan.7.28","start":27007028,"end":27007028,"break":"paragraph","ruby":[[2,1,"こと"],[7,1,"おわ"],[22,1,"おも"],[29,2,"ひじょう"],[32,1,"なや"],[35,2,"かおいろ"],[38,1,"かわ"],[52,1,"こと"],[54,1,"こころ"],[56,1,"と"]],"text":"その事はここで終った。われダニエルは、これを思いまわして、非常に悩み、顔色も変った。しかし、わたしはこの事を心に留めた」。"}]