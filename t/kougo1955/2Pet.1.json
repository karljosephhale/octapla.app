[{"ref":"2Pet.1.1","start":61001001,"end":61001001,"break":"paragraph","ruby":[[9,1,"しもべ"],[12,2,"しと"],[34,1,"かみ"],[36,2,"すくいぬし"],[48,1,"ぎ"],[60,1,"おな"],[62,1,"たっと"],[64,2,"しんこう"],[67,1,"さず"],[71,2,"ひとびと"]],"text":"イエス・キリストの僕また使徒であるシメオン・ペテロから、わたしたちの神と救主イエス・キリストとの義によって、わたしたちと同じ尊い信仰を授かった人々へ。"},{"ref":"2Pet.1.2","start":61001002,"end":61001002,"break":"paragraph","ruby":[[0,1,"かみ"],[8,1,"しゅ"],[14,1,"し"],[23,1,"めぐ"],[26,2,"へいあん"],[37,1,"ゆた"],[40,1,"くわ"]],"text":"神とわたしたちの主イエスとを知ることによって、恵みと平安とが、あなたがたに豊かに加わるように。"},{"ref":"2Pet.1.3","start":61001003,"end":61001003,"break":"paragraph","ruby":[[4,2,"しんじん"],[20,1,"しゅ"],[25,2,"しんせい"],[28,1,"ちから"],[40,1,"あた"],[53,2,"じしん"],[56,2,"えいこう"],[59,1,"とく"],[72,1,"め"],[79,1,"し"],[81,2,"ちしき"]],"text":"いのちと信心とにかかわるすべてのことは、主イエスの神聖な力によって、わたしたちに与えられている。それは、ご自身の栄光と徳とによって、わたしたちを召されたかたを知る知識によるのである。"},{"ref":"2Pet.1.4","start":61001004,"end":61001004,"break":"none","ruby":[[14,1,"たっと"],[17,1,"おお"],[21,2,"やくそく"],[31,1,"あた"],[50,1,"よ"],[54,1,"よく"],[59,1,"ほろ"],[65,1,"まぬか"],[68,1,"かみ"],[70,2,"せいしつ"],[77,1,"もの"]],"text":"また、それらのものによって、尊く、大いなる約束が、わたしたちに与えられている。それは、あなたがたが、世にある欲のために滅びることを免れ、神の性質にあずかる者となるためである。"},{"ref":"2Pet.1.5","start":61001005,"end":61001005,"break":"none","ruby":[[13,1,"ちから"],[15,1,"かぎ"],[29,2,"しんこう"],[32,1,"とく"],[34,1,"くわ"],[37,1,"とく"],[39,2,"ちしき"]],"text":"それだから、あなたがたは、力の限りをつくして、あなたがたの信仰に徳を加え、徳に知識を、"},{"ref":"2Pet.1.6","start":61001006,"end":61001006,"break":"none","ruby":[[0,2,"ちしき"],[3,2,"せっせい"],[7,2,"せっせい"],[10,2,"にんたい"],[14,2,"にんたい"],[17,2,"しんじん"]],"text":"知識に節制を、節制に忍耐を、忍耐に信心を、"},{"ref":"2Pet.1.7","start":61001007,"end":61001007,"break":"none","ruby":[[0,2,"しんじん"],[3,2,"きょうだい"],[5,1,"あい"],[8,2,"きょうだい"],[10,1,"あい"],[12,1,"あい"],[14,1,"くわ"]],"text":"信心に兄弟愛を、兄弟愛に愛を加えなさい。"},{"ref":"2Pet.1.8","start":61001008,"end":61001008,"break":"none","ruby":[[13,1,"そな"],[22,1,"ゆた"],[37,1,"しゅ"],[47,1,"し"],[49,2,"ちしき"],[63,1,"おこた"],[65,1,"もの"],[67,1,"み"],[69,1,"むす"],[73,1,"もの"]],"text":"これらのものがあなたがたに備わって、いよいよ豊かになるならば、わたしたちの主イエス・キリストを知る知識について、あなたがたは、怠る者、実を結ばない者となることはないであろう。"},{"ref":"2Pet.1.9","start":61001009,"end":61001009,"break":"none","ruby":[[7,1,"そな"],[13,1,"もの"],[16,2,"もうじん"],[22,2,"きんし"],[25,1,"もの"],[30,2,"じぶん"],[33,2,"いぜん"],[36,1,"つみ"],[47,1,"わす"],[52,1,"もの"]],"text":"これらのものを備えていない者は、盲人であり、近視の者であり、自分の以前の罪がきよめられたことを忘れている者である。"},{"ref":"2Pet.1.10","start":61001010,"end":61001010,"break":"none","ruby":[[0,2,"きょうだい"],[16,1,"はげ"],[26,1,"う"],[29,1,"め"],[32,1,"えら"],[37,1,"たし"],[54,1,"けっ"],[62,1,"おちい"]],"text":"兄弟たちよ。それだから、ますます励んで、あなたがたの受けた召しと選びとを、確かなものにしなさい。そうすれば、決してあやまちに陥ることはない。"},{"ref":"2Pet.1.11","start":61001011,"end":61001011,"break":"none","ruby":[[11,1,"しゅ"],[14,2,"すくいぬし"],[25,2,"えいえん"],[28,1,"くに"],[30,1,"はい"],[32,1,"めぐ"],[42,1,"ゆた"],[45,1,"あた"]],"text":"こうして、わたしたちの主また救主イエス・キリストの永遠の国に入る恵みが、あなたがたに豊かに与えられるからである。"},{"ref":"2Pet.1.12","start":61001012,"end":61001012,"break":"paragraph","ruby":[[12,1,"すで"],[21,1,"し"],[32,1,"も"],[37,2,"しんり"],[40,1,"かた"],[42,1,"た"],[72,1,"おも"],[74,1,"おこ"]],"text":"それだから、あなたがたは既にこれらのことを知っており、また、いま持っている真理に堅く立ってはいるが、わたしは、これらのことをいつも、あなたがたに思い起させたいのである。"},{"ref":"2Pet.1.13","start":61001013,"end":61001013,"break":"none","ruby":[[6,2,"まくや"],[11,1,"あいだ"],[19,1,"おも"],[21,1,"おこ"],[26,1,"ふる"],[28,1,"た"],[35,2,"てきとう"],[38,1,"おも"]],"text":"わたしがこの幕屋にいる間、あなたがたに思い起させて、奮い立たせることが適当と思う。"},{"ref":"2Pet.1.14","start":61001014,"end":61001014,"break":"none","ruby":[[10,1,"しゅ"],[24,1,"しめ"],[27,1,"くだ"],[41,2,"まくや"],[44,1,"ぬ"],[46,1,"さ"],[48,1,"とき"],[50,2,"まぢか"],[58,1,"し"]],"text":"それは、わたしたちの主イエス・キリストもわたしに示して下さったように、わたしのこの幕屋を脱ぎ去る時が間近であることを知っているからである。"},{"ref":"2Pet.1.15","start":61001015,"end":61001015,"break":"none","ruby":[[4,1,"よ"],[6,1,"さ"],[9,1,"のち"],[30,1,"おも"],[32,1,"だ"],[39,1,"つと"]],"text":"わたしが世を去った後にも、これらのことを、あなたがたにいつも思い出させるように努めよう。"},{"ref":"2Pet.1.16","start":61001016,"end":61001016,"break":"none","ruby":[[6,1,"しゅ"],[16,1,"ちから"],[18,2,"らいりん"],[29,1,"し"],[33,1,"とき"],[42,1,"たく"],[45,1,"つく"],[47,1,"ばなし"],[49,1,"もち"],[71,2,"いこう"],[74,3,"もくげきしゃ"]],"text":"わたしたちの主イエス・キリストの力と来臨とを、あなたがたに知らせた時、わたしたちは、巧みな作り話を用いることはしなかった。わたしたちが、そのご威光の目撃者なのだからである。"},{"ref":"2Pet.1.17","start":61001017,"end":61001017,"break":"none","ruby":[[4,1,"ちち"],[7,1,"かみ"],[14,2,"えいこう"],[19,1,"う"],[29,1,"とき"],[36,2,"えいこう"],[39,1,"なか"],[42,1,"つぎ"],[48,1,"こえ"],[67,1,"あい"],[70,1,"こ"],[76,1,"こころ"],[81,1,"もの"]],"text":"イエスは父なる神からほまれと栄光とをお受けになったが、その時、おごそかな栄光の中から次のようなみ声がかかったのである、「これはわたしの愛する子、わたしの心にかなう者である」。"},{"ref":"2Pet.1.18","start":61001018,"end":61001018,"break":"none","ruby":[[10,1,"とも"],[12,1,"せい"],[15,1,"やま"],[20,1,"てん"],[23,1,"で"],[27,1,"こえ"],[29,1,"き"]],"text":"わたしたちもイエスと共に聖なる山にいて、天から出たこの声を聞いたのである。"},{"ref":"2Pet.1.19","start":61001019,"end":61001019,"break":"none","ruby":[[5,2,"よげん"],[8,2,"ことば"],[22,2,"かくじつ"],[39,1,"よる"],[41,1,"あ"],[44,2,"みょうじょう"],[58,1,"こころ"],[60,1,"なか"],[62,1,"てら"],[69,2,"よげん"],[72,2,"ことば"],[75,1,"くら"],[79,1,"かがや"],[92,1,"め"]],"text":"こうして、預言の言葉は、わたしたちにいっそう確実なものになった。あなたがたも、夜が明け、明星がのぼって、あなたがたの心の中を照すまで、この預言の言葉を暗やみに輝くともしびとして、それに目をとめているがよい。"},{"ref":"2Pet.1.20","start":61001020,"end":61001020,"break":"none","ruby":[[0,2,"せいしょ"],[3,2,"よげん"],[10,2,"じぶん"],[12,2,"かって"],[15,2,"かいしゃく"],[29,1,"だい"],[32,1,"し"]],"text":"聖書の預言はすべて、自分勝手に解釈すべきでないことを、まず第一に知るべきである。"},{"ref":"2Pet.1.21","start":61001021,"end":61001021,"break":"none","ruby":[[5,2,"よげん"],[8,1,"けっ"],[11,2,"にんげん"],[14,2,"いし"],[18,1,"で"],[27,2,"ひとびと"],[30,2,"せいれい"],[33,1,"かん"],[36,1,"かみ"],[41,1,"かた"]],"text":"なぜなら、預言は決して人間の意志から出たものではなく、人々が聖霊に感じ、神によって語ったものだからである。"}]