[{"ref":"2Kgs.10.1","start":12010001,"end":12010001,"break":"paragraph","ruby":[[11,1,"にん"],[13,2,"こども"],[24,2,"てがみ"],[37,1,"おく"],[40,1,"まち"],[49,2,"ちょうろう"],[59,2,"こども"],[62,2,"もりやく"],[68,1,"つた"],[71,1,"い"]],"text":"アハブはサマリヤに七十人の子供があった。エヒウは手紙をしたためてサマリヤに送り、町のつかさたちと、長老たちと、アハブの子供の守役たちとに伝えて言った、"},{"ref":"2Kgs.10.2","start":12010002,"end":12010002,"break":"none","ruby":[[7,2,"しゅくん"],[10,2,"こども"],[21,1,"とも"],[28,2,"せんしゃ"],[31,1,"うま"],[34,2,"けんご"],[37,1,"まち"],[39,2,"ぶき"],[51,2,"てがみ"],[63,1,"とど"]],"text":"「あなたがたの主君の子供たちがあなたがたと共におり、また戦車も馬も、堅固な町も武器もあるのだから、この手紙があなたがたのもとに届いたならば、すぐ、"},{"ref":"2Kgs.10.3","start":12010003,"end":12010003,"break":"none","ruby":[[6,2,"しゅくん"],[9,2,"こども"],[16,1,"もっと"],[23,1,"もっと"],[25,2,"てきとう"],[28,1,"もの"],[30,1,"えら"],[36,1,"ちち"],[38,1,"くらい"],[43,2,"しゅくん"],[46,1,"いえ"],[51,1,"たたか"]],"text":"あなたがたは主君の子供たちのうち最もすぐれた、最も適当な者を選んで、その父の位にすえ、主君の家のために戦いなさい」。"},{"ref":"2Kgs.10.4","start":12010004,"end":12010004,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おお"],[6,1,"おそ"],[9,1,"い"],[18,1,"おう"],[25,1,"かれ"],[27,1,"あた"],[50,1,"あた"]],"text":"彼らは大いに恐れて言った、「ふたりの王たちがすでに彼に当ることができなかったのに、われわれがどうして当ることができよう」。"},{"ref":"2Kgs.10.5","start":12010005,"end":12010005,"break":"none","ruby":[[3,2,"きゅうてい"],[10,1,"まち"],[16,2,"ちょうろう"],[21,2,"もりやく"],[30,1,"ひと"],[37,1,"い"],[66,1,"めい"],[71,1,"こと"],[85,1,"おう"],[87,1,"た"],[93,1,"この"],[106,1,"おも"]],"text":"そこで宮廷のつかさ、町のつかさ、長老たちと守役たちはエヒウに人をつかわして言った、「わたしたちは、あなたのしもべです。すべてあなたが命じられる事をいたします。わたしたちは王を立てることを好みません。あなたがよいと思われることをしてください」。"},{"ref":"2Kgs.10.6","start":12010006,"end":12010006,"break":"none","ruby":[[7,1,"ふたた"],[9,1,"かれ"],[12,2,"てがみ"],[15,1,"か"],[17,1,"おく"],[20,1,"い"],[38,2,"みかた"],[46,1,"したが"],[62,2,"しゅくん"],[65,2,"こども"],[70,1,"くび"],[72,1,"と"],[79,1,"いま"],[96,1,"も"],[110,1,"おう"],[112,2,"こども"],[118,1,"にん"],[120,1,"かれ"],[123,1,"そだ"],[128,1,"まち"],[135,2,"ひとびと"],[138,1,"とも"]],"text":"そこでエヒウは再び彼らに手紙を書き送って言った、「もしあなたがたが、わたしに味方し、わたしに従おうとするならば、あなたがたの主君の子供たちの首を取って、あすの今ごろエズレルにいるわたしのもとに持ってきなさい」。そのころ、王の子供たち七十人は彼らを育てていた町のおもだった人々と共にいた。"},{"ref":"2Kgs.10.7","start":12010007,"end":12010007,"break":"none","ruby":[[0,1,"かれ"],[5,2,"てがみ"],[8,1,"う"],[10,1,"と"],[14,1,"おう"],[16,2,"こども"],[21,1,"とら"],[29,1,"にん"],[36,1,"ころ"],[41,1,"くび"],[64,1,"おく"]],"text":"彼らはその手紙を受け取ると、王の子供たちを捕えて、その七十人をことごとく殺し、その首をかごにつめて、エズレルにいるエヒウのもとに送った。"},{"ref":"2Kgs.10.8","start":12010008,"end":12010008,"break":"none","ruby":[[0,2,"ししゃ"],[3,1,"き"],[10,1,"つ"],[14,2,"ひとびと"],[17,1,"おう"],[19,2,"こども"],[24,1,"くび"],[26,1,"も"],[35,1,"い"],[43,1,"あさ"],[49,1,"もん"],[51,2,"いりぐち"],[57,1,"やま"],[59,1,"つ"],[66,1,"い"]],"text":"使者が来て、エヒウに告げ、「人々が王の子供たちの首を持ってきました」と言うと、「あくる朝までそれを門の入口に、ふた山に積んでおけ」と言った。"},{"ref":"2Kgs.10.9","start":12010009,"end":12010009,"break":"none","ruby":[[0,1,"あさ"],[6,1,"かれ"],[8,1,"で"],[10,1,"い"],[13,1,"た"],[20,1,"たみ"],[22,1,"い"],[33,1,"ただ"],[37,2,"しゅくん"],[44,1,"かれ"],[46,1,"ころ"],[66,1,"もの"],[70,1,"ころ"]],"text":"朝になると、彼は出て行って立ち、すべての民に言った、「あなたがたは正しい。主君にそむいて彼を殺したのはわたしです。しかしこのすべての者どもを殺したのはだれですか。"},{"ref":"2Kgs.10.10","start":12010010,"end":12010010,"break":"none","ruby":[[10,1,"しゅ"],[16,1,"いえ"],[21,1,"つ"],[26,1,"しゅ"],[28,2,"ことば"],[31,1,"ひと"],[34,1,"ち"],[36,1,"お"],[43,1,"し"],[49,1,"しゅ"],[65,1,"つ"],[71,1,"こと"],[75,1,"と"]],"text":"これであなたがたは、主がアハブの家について告げられた主の言葉は一つも地に落ちないことを知りなさい。主は、そのしもべエリヤによってお告げになった事をなし遂げられたのです」。"},{"ref":"2Kgs.10.11","start":12010011,"end":12010011,"break":"none","ruby":[[13,1,"いえ"],[15,1,"ぞく"],[18,1,"もの"],[25,1,"のこ"],[30,1,"もの"],[37,1,"ころ"],[53,1,"もの"],[57,1,"した"],[60,1,"もの"],[66,2,"さいし"],[71,1,"ころ"],[75,1,"かれ"],[77,1,"ぞく"],[80,1,"もの"],[86,1,"のこ"]],"text":"こうしてエヒウは、アハブの家に属する者でエズレルに残っている者をことごとく殺し、またそのすべてのおもだった者、その親しい者およびその祭司たちを殺して、彼に属する者はひとりも残さなかった。"},{"ref":"2Kgs.10.12","start":12010012,"end":12010012,"break":"paragraph","ruby":[[6,1,"た"],[14,1,"い"],[19,2,"とちゅう"],[22,2,"ぼくしゃ"],[25,1,"あつ"],[28,1,"ば"]],"text":"さてエヒウは立ってサマリヤへ行ったが、途中、牧者の集まり場で、"},{"ref":"2Kgs.10.13","start":12010013,"end":12010013,"break":"none","ruby":[[3,1,"おう"],[9,2,"みうち"],[12,2,"ひとびと"],[15,1,"あ"],[33,1,"い"],[49,2,"みうち"],[52,1,"もの"],[57,1,"おう"],[59,2,"こども"],[65,1,"おう"],[66,1,"はは"],[68,2,"こども"],[73,2,"あんぴ"],[76,1,"と"],[81,1,"くだ"],[91,1,"こた"]],"text":"ユダの王アハジヤの身内の人々に会い、「あなたがたはどなたですか」と言うと、「わたしたちはアハジヤの身内の者ですが、王の子供たちと、王母の子供たちの安否を問うために下ってきたのです」と答えたので、"},{"ref":"2Kgs.10.14","start":12010014,"end":12010014,"break":"none","ruby":[[5,1,"かれ"],[14,1,"めい"],[21,1,"かれ"],[30,1,"あつ"],[33,1,"ば"],[35,1,"あな"],[42,1,"かれ"],[47,1,"にん"],[54,1,"ころ"],[62,1,"のこ"]],"text":"エヒウは「彼らをいけどれ」と命じた。そこで彼らをいけどって、集まり場の穴のかたわらで彼ら四十二人をことごとく殺し、ひとりをも残さなかった。"},{"ref":"2Kgs.10.15","start":12010015,"end":12010015,"break":"paragraph","ruby":[[7,1,"た"],[10,1,"い"],[15,2,"じぶん"],[18,1,"むか"],[27,1,"こ"],[33,1,"あ"],[39,1,"かれ"],[53,1,"こころ"],[64,1,"たい"],[70,2,"しんじつ"],[77,1,"い"],[87,2,"しんじつ"],[93,1,"こた"],[115,1,"て"],[121,1,"の"],[128,1,"い"],[136,1,"て"],[138,1,"の"],[143,1,"かれ"],[145,1,"ひ"],[148,2,"じぶん"],[151,1,"くるま"],[153,1,"のぼ"]],"text":"エヒウはそこを立って行ったが、自分を迎えにきたレカブの子ヨナダブに会ったので、彼にあいさつして、「あなたの心は、わたしがあなたに対するように真実ですか」と言うと、ヨナダブは「真実です」と答えた。するとエヒウは「それならば、あなたの手をわたしに伸べなさい」と言ったので、その手を伸べると、彼を引いて自分の車に上らせ、"},{"ref":"2Kgs.10.16","start":12010016,"end":12010016,"break":"none","ruby":[[5,2,"いっしょ"],[15,1,"しゅ"],[17,2,"ねっしん"],[22,1,"み"],[28,1,"い"],[35,1,"かれ"],[37,2,"じぶん"],[40,1,"くるま"],[42,1,"の"]],"text":"「わたしと一緒にきて、わたしが主に熱心なのを見なさい」と言った。そして彼を自分の車に乗せ、"},{"ref":"2Kgs.10.17","start":12010017,"end":12010017,"break":"none","ruby":[[5,1,"い"],[13,1,"ぞく"],[16,1,"もの"],[24,1,"のこ"],[29,1,"もの"],[36,1,"ころ"],[42,2,"いちぞく"],[45,1,"ほろ"],[50,1,"しゅ"],[57,1,"つ"],[63,2,"ことば"]],"text":"サマリヤへ行って、アハブに属する者で、サマリヤに残っている者をことごとく殺して、その一族を滅ぼした。主がエリヤにお告げになった言葉のとおりである。"},{"ref":"2Kgs.10.18","start":12010018,"end":12010018,"break":"paragraph","ruby":[[0,1,"つ"],[7,1,"たみ"],[14,1,"あつ"],[17,1,"かれ"],[20,1,"い"],[29,1,"すこ"],[38,1,"つか"],[47,1,"おお"],[53,1,"つか"]],"text":"次いでエヒウは民をことごとく集めて彼らに言った、「アハブは少しばかりバアルに仕えたが、エヒウは大いにこれに仕えるであろう。"},{"ref":"2Kgs.10.19","start":12010019,"end":12010019,"break":"none","ruby":[[5,1,"いま"],[14,3,"よげんしゃ"],[22,3,"れいはいしゃ"],[30,2,"さいし"],[40,1,"め"],[53,1,"もの"],[69,1,"おお"],[73,2,"ぎせい"],[97,1,"もの"],[99,1,"い"],[120,3,"れいはいしゃ"],[126,1,"ほろ"],[132,1,"いつわ"]],"text":"それゆえ、今バアルのすべての預言者、すべての礼拝者、すべての祭司をわたしのもとに召しなさい。ひとりもこない者のないようにしなさい。わたしは大いなる犠牲をバアルにささげようとしている。すべてこない者は生かしておかない」。しかしエヒウはバアルの礼拝者たちを滅ぼすために偽ってこうしたのである。"},{"ref":"2Kgs.10.20","start":12010020,"end":12010020,"break":"none","ruby":[[15,1,"せい"],[16,1,"かい"],[18,1,"もよお"],[25,1,"めい"],[31,1,"かれ"],[37,2,"ふこく"]],"text":"そしてエヒウは「バアルのために聖会を催しなさい」と命じたので、彼らはこれを布告した。"},{"ref":"2Kgs.10.21","start":12010021,"end":12010021,"break":"none","ruby":[[14,1,"ひと"],[28,3,"れいはいしゃ"],[39,1,"き"],[46,1,"のこ"],[49,1,"もの"],[60,1,"かれ"],[67,1,"みや"],[80,1,"みや"],[82,1,"たん"],[85,1,"たん"]],"text":"エヒウはあまねくイスラエルに人をつかわしたので、バアルの礼拝者たちはことごとく来た。こないで残った者はひとりもなかった。彼らはバアルの宮にはいったので、バアルの宮は端から端までいっぱいになった。"},{"ref":"2Kgs.10.22","start":12010022,"end":12010022,"break":"none","ruby":[[2,1,"とき"],[7,2,"いしょう"],[15,1,"もの"],[18,2,"さいふく"],[21,1,"と"],[23,1,"だ"],[34,3,"れいはいしゃ"],[38,1,"あた"],[43,1,"い"],[49,1,"かれ"],[55,2,"さいふく"],[58,1,"と"],[60,1,"だ"]],"text":"その時エヒウは衣装をつかさどる者に「祭服を取り出してバアルのすべての礼拝者に与えよ」と言ったので、彼らのために祭服を取り出した。"},{"ref":"2Kgs.10.23","start":12010023,"end":12010023,"break":"none","ruby":[[11,1,"こ"],[17,1,"とも"],[23,1,"みや"],[25,1,"はい"],[32,3,"れいはいしゃ"],[38,1,"い"],[43,1,"しら"],[59,3,"れいはいしゃ"],[66,1,"しゅ"]],"text":"そしてエヒウはレカブの子ヨナダブと共にバアルの宮に入り、バアルの礼拝者たちに言った、「調べてみて、ここにはただバアルの礼拝者のみで、主のしもべはひとりも、あなたがたのうちにいないようにしなさい」。"},{"ref":"2Kgs.10.24","start":12010024,"end":12010024,"break":"none","breaks":[[25,"paragraph"]],"ruby":[[4,1,"かれ"],[6,2,"ぎせい"],[9,2,"はんさい"],[33,1,"にん"],[35,1,"もの"],[37,1,"そと"],[39,1,"お"],[42,1,"い"],[57,1,"て"],[59,1,"わた"],[61,1,"もの"],[68,1,"のが"],[70,1,"もの"],[73,2,"じぶん"],[76,1,"いのち"],[83,1,"ひと"],[85,1,"いのち"],[87,1,"か"]],"text":"こうして彼は犠牲と燔祭とをささげるためにはいった。さてエヒウは八十人の者を外に置いて言った、「わたしがあなたがたの手に渡す者をひとりでも逃す者は、自分の命をもってその人の命に換えなければならない」。"},{"ref":"2Kgs.10.25","start":12010025,"end":12010025,"break":"none","ruby":[[4,2,"はんさい"],[14,1,"おわ"],[26,2,"じえい"],[29,2,"しょうこう"],[34,1,"い"],[43,1,"かれ"],[46,1,"ころ"],[53,1,"に"],[64,2,"じえい"],[67,2,"しょうこう"],[79,1,"かれ"],[82,1,"う"],[84,1,"ころ"],[90,1,"な"],[92,1,"だ"],[100,1,"みや"],[102,2,"ほんでん"],[105,1,"はい"]],"text":"こうして燔祭をささげることが終ったとき、エヒウはその侍衛と将校たちに言った、「はいって彼らを殺せ。ひとりも逃がしてはならない」。侍衛と将校たちはつるぎをもって彼らを撃ち殺し、それを投げ出して、バアルの宮の本殿に入り、"},{"ref":"2Kgs.10.26","start":12010026,"end":12010026,"break":"none","ruby":[[4,1,"みや"],[8,1,"はしら"],[10,1,"ぞう"],[12,1,"と"],[14,1,"だ"],[21,1,"や"]],"text":"バアルの宮にある柱の像を取り出して、それを焼いた。"},{"ref":"2Kgs.10.27","start":12010027,"end":12010027,"break":"none","ruby":[[2,1,"かれ"],[9,2,"せきちゅう"],[20,1,"みや"],[34,2,"こんにち"],[38,1,"のこ"]],"text":"また彼らはバアルの石柱をこわし、バアルの宮をこわして、かわやとしたが今日まで残っている。"},{"ref":"2Kgs.10.28","start":12010028,"end":12010028,"break":"paragraph","ruby":[[23,2,"いっそう"]],"text":"このようにエヒウはイスラエルのうちからバアルを一掃した。"},{"ref":"2Kgs.10.29","start":12010029,"end":12010029,"break":"none","ruby":[[13,1,"つみ"],[15,1,"おか"],[23,1,"こ"],[30,1,"つみ"],[45,1,"きん"],[47,1,"こ"],[48,1,"うし"],[50,1,"つか"]],"text":"しかしエヒウはイスラエルに罪を犯させたネバテの子ヤラベアムの罪、すなわちベテルとダンにある金の子牛に仕えることをやめなかった。"},{"ref":"2Kgs.10.30","start":12010030,"end":12010030,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[20,1,"め"],[25,1,"こと"],[27,1,"おこな"],[40,1,"おこな"],[49,1,"こころ"],[57,1,"こと"],[63,1,"いえ"],[74,2,"しそん"],[78,1,"だい"],[87,1,"くらい"],[89,1,"ざ"]],"text":"主はエヒウに言われた、「あなたはわたしの目にかなう事を行うにあたって、よくそれを行い、またわたしの心にあるすべての事をアハブの家にしたので、あなたの子孫は四代までイスラエルの位に座するであろう」。"},{"ref":"2Kgs.10.31","start":12010031,"end":12010031,"break":"none","ruby":[[13,1,"かみ"],[15,1,"しゅ"],[17,2,"りっぽう"],[20,1,"こころ"],[26,1,"まも"],[28,1,"おこな"],[42,1,"つみ"],[44,1,"おか"],[54,1,"つみ"],[56,1,"はな"]],"text":"しかしエヒウはイスラエルの神、主の律法を心をつくして守り行おうとはせず、イスラエルに罪を犯させたヤラベアムの罪を離れなかった。"},{"ref":"2Kgs.10.32","start":12010032,"end":12010032,"break":"paragraph","ruby":[[2,1,"とき"],[9,1,"しゅ"],[17,2,"りょうち"],[20,1,"き"],[22,1,"と"],[27,1,"はじ"],[52,2,"りょういき"],[55,1,"おか"]],"text":"この時にあたって、主はイスラエルの領地を切り取ることを始められた。すなわちハザエルはイスラエルのすべての領域を侵し、"},{"ref":"2Kgs.10.33","start":12010033,"end":12010033,"break":"none","ruby":[[5,1,"ひがし"],[13,1,"ぜん"],[14,1,"ち"],[33,1,"ち"],[35,1,"おか"],[42,1,"かわ"],[66,1,"およ"]],"text":"ヨルダンの東で、ギレアデの全地、カドびと、ルベンびと、マナセびとの地を侵し、アルノン川のほとりにあるアロエルからギレアデとバシャンに及んだ。"},{"ref":"2Kgs.10.34","start":12010034,"end":12010034,"break":"none","ruby":[[6,1,"た"],[8,2,"じせき"],[12,1,"かれ"],[20,1,"こと"],[26,2,"ぶゆう"],[41,1,"おう"],[43,3,"れきだいし"],[47,1,"しょ"]],"text":"エヒウのその他の事績と、彼がしたすべての事およびその武勇は、ことごとくイスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.10.35","start":12010035,"end":12010035,"break":"none","ruby":[[6,2,"せんぞ"],[11,1,"とも"],[13,1,"ねむ"],[19,1,"かれ"],[26,1,"ほうむ"],[32,1,"こ"],[39,1,"かわ"],[42,1,"おう"]],"text":"エヒウはその先祖たちと共に眠ったので、彼をサマリヤに葬った。その子エホアハズが代って王となった。"},{"ref":"2Kgs.10.36","start":12010036,"end":12010036,"break":"none","ruby":[[15,1,"おさ"],[23,1,"ねん"]],"text":"エヒウがサマリヤでイスラエルを治めたのは二十八年であった。"}]