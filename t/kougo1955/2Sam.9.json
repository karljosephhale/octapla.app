[{"ref":"2Sam.9.1","start":10009001,"end":10009001,"break":"paragraph","ruby":[[0,1,"とき"],[6,1,"い"],[15,1,"いえ"],[17,1,"ひと"],[22,1,"のこ"],[27,1,"もの"],[48,1,"ひと"],[50,1,"めぐ"],[53,1,"ほどこ"]],"text":"時にダビデは言った、「サウルの家の人で、なお残っている者があるか。わたしはヨナタンのために、その人に恵みを施そう」。"},{"ref":"2Sam.9.2","start":10009002,"end":10009002,"break":"none","ruby":[[7,1,"いえ"],[14,1,"な"],[25,2,"ひとびと"],[28,1,"かれ"],[37,1,"よ"],[39,1,"よ"],[45,1,"おう"],[47,1,"かれ"],[49,1,"い"],[63,1,"かれ"],[65,1,"い"]],"text":"さて、サウルの家にヂバという名のしもべがあったが、人々が彼をダビデのもとに呼び寄せたので、王は彼に言った、「あなたがヂバか」。彼は言った、「しもべがそうです」。"},{"ref":"2Sam.9.3","start":10009003,"end":10009003,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[11,1,"いえ"],[13,1,"ひと"],[17,1,"のこ"],[32,1,"ひと"],[34,1,"かみ"],[36,1,"めぐ"],[39,1,"ほどこ"],[43,1,"おも"],[50,1,"おう"],[52,1,"い"],[62,1,"こ"]],"text":"王は言った、「サウルの家の人がまだ残っていませんか。わたしはその人に神の恵みを施そうと思う」。ヂバは王に言った、「ヨナタンの子がまだおります。あしなえです」。"},{"ref":"2Sam.9.4","start":10009004,"end":10009004,"break":"none","ruby":[[0,1,"おう"],[2,1,"かれ"],[4,1,"い"],[11,1,"ひと"],[25,1,"おう"],[27,1,"い"],[32,1,"かれ"],[46,1,"こ"],[51,1,"いえ"]],"text":"王は彼に言った、「その人はどこにいるのか」。ヂバは王に言った、「彼はロ・デバルのアンミエルの子マキルの家におります」。"},{"ref":"2Sam.9.5","start":10009005,"end":10009005,"break":"none","ruby":[[3,1,"おう"],[5,1,"ひと"],[25,1,"こ"],[30,1,"いえ"],[34,1,"かれ"],[36,1,"つ"]],"text":"ダビデ王は人をつかわして、ロ・デバルのアンミエルの子マキルの家から、彼を連れてこさせた。"},{"ref":"2Sam.9.6","start":10009006,"end":10009006,"break":"none","ruby":[[4,1,"こ"],[10,1,"こ"],[32,1,"ふ"],[35,1,"はい"],[53,1,"い"],[59,1,"かれ"],[77,1,"こた"]],"text":"サウルの子ヨナタンの子であるメピボセテはダビデのもとにきて、ひれ伏して拝した。ダビデが、「メピボセテよ」と言ったので、彼は、「しもべは、ここにおります」と答えた。"},{"ref":"2Sam.9.7","start":10009007,"end":10009007,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[11,1,"おそ"],[32,1,"ちち"],[45,1,"めぐ"],[48,1,"ほどこ"],[59,1,"ちち"],[64,1,"ち"],[72,1,"かえ"],[83,1,"つね"],[89,2,"しょくたく"],[92,2,"しょくじ"]],"text":"ダビデは彼に言った、「恐れることはない。わたしはかならずあなたの父ヨナタンのためにあなたに恵みを施しましょう。あなたの父サウルの地をみなあなたに返します。またあなたは常にわたしの食卓で食事をしなさい」。"},{"ref":"2Sam.9.8","start":10009008,"end":10009008,"break":"none","ruby":[[0,1,"かれ"],[2,1,"はい"],[5,1,"い"],[19,1,"なん"],[28,1,"し"],[31,1,"いぬ"],[40,1,"かえり"]],"text":"彼は拝して言った、「あなたは、しもべを何とおぼしめして、死んだ犬のようなわたしを顧みられるのですか」。"},{"ref":"2Sam.9.9","start":10009009,"end":10009009,"break":"paragraph","ruby":[[0,1,"おう"],[12,1,"よ"],[15,1,"い"],[29,1,"いえ"],[31,1,"ぞく"],[34,1,"もの"],[36,1,"みな"],[46,2,"しゅじん"],[49,1,"こ"],[51,1,"あた"]],"text":"王はサウルのしもべヂバを呼んで言った、「すべてサウルとその家に属する物を皆、わたしはあなたの主人の子に与えた。"},{"ref":"2Sam.9.10","start":10009010,"end":10009010,"break":"none","ruby":[[9,1,"こ"],[22,1,"かれ"],[27,1,"ち"],[29,1,"たがや"],[37,2,"しゅじん"],[40,1,"こ"],[42,1,"た"],[45,2,"しょくもつ"],[48,1,"と"],[50,1,"い"],[68,2,"しゅじん"],[71,1,"こ"],[85,2,"しょくたく"],[88,2,"しょくじ"],[105,1,"にん"],[107,1,"おとこ"],[109,1,"こ"],[113,1,"にん"]],"text":"あなたと、あなたの子たちと、しもべたちとは、彼のために地を耕して、あなたの主人の子が食べる食物を取り入れなければならない。しかしあなたの主人の子メピボセテはいつもわたしの食卓で食事をするであろう」。ヂバには十五人の男の子と二十人のしもべがあった。"},{"ref":"2Sam.9.11","start":10009011,"end":10009011,"break":"none","ruby":[[3,1,"おう"],[5,1,"い"],[13,1,"おう"],[16,2,"しゅくん"],[23,1,"めい"],[56,1,"おう"],[58,1,"こ"],[71,2,"しょくたく"],[74,2,"しょくじ"]],"text":"ヂバは王に言った、「すべて王わが主君がしもべに命じられるとおりに、しもべはいたしましょう」。こうしてメピボセテは王の子のひとりのようにダビデの食卓で食事をした。"},{"ref":"2Sam.9.12","start":10009012,"end":10009012,"break":"none","ruby":[[7,1,"ちい"],[10,1,"こ"],[16,1,"な"],[31,1,"いえ"],[33,1,"す"],[38,1,"もの"]],"text":"メピボセテには小さい子があって、名をミカといった。そしてヂバの家に住んでいる者はみなメピボセテのしもべとなった。"},{"ref":"2Sam.9.13","start":10009013,"end":10009013,"break":"none","ruby":[[12,1,"す"],[16,1,"かれ"],[21,1,"おう"],[23,2,"しょくたく"],[26,2,"しょくじ"],[37,1,"かれ"],[39,2,"りょうあし"]],"text":"メピボセテはエルサレムに住んだ。彼がいつも王の食卓で食事をしたからである。彼は両足ともに、なえていた。"}]