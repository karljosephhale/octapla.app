[{"ref":"Ps.37.1","start":19037001,"end":19037001,"break":"paragraph","title":"ダビデの歌","breaks":[[17,"line"]],"ruby":[[0,1,"あく"],[4,1,"もの"],[10,1,"こころ"],[12,1,"なや"],[17,2,"ふぎ"],[20,1,"おこな"],[22,1,"もの"],[32,1,"おこ"]],"titleRuby":[[4,1,"うた"]],"text":"悪をなす者のゆえに、心を悩ますな。不義を行う者のゆえに、ねたみを起すな。"},{"ref":"Ps.37.2","start":19037002,"end":19037002,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[6,1,"くさ"],[11,1,"おとろ"],[14,2,"あおな"]],"text":"彼らはやがて草のように衰え、青菜のようにしおれるからである。"},{"ref":"Ps.37.3","start":19037003,"end":19037003,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"しんらい"],[6,1,"ぜん"],[8,1,"おこな"],[22,1,"くに"],[24,1,"す"],[28,1,"やす"],[31,1,"え"]],"text":"主に信頼して善を行え。そうすればあなたはこの国に住んで、安きを得る。"},{"ref":"Ps.37.4","start":19037004,"end":19037004,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"よろこ"],[11,1,"しゅ"],[17,1,"こころ"],[19,1,"ねが"]],"text":"主によって喜びをなせ。主はあなたの心の願いをかなえられる。"},{"ref":"Ps.37.5","start":19037005,"end":19037005,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"みち"],[6,1,"しゅ"],[13,1,"しゅ"],[15,2,"しんらい"],[20,1,"しゅ"]],"text":"あなたの道を主にゆだねよ。主に信頼せよ、主はそれをなしとげ、"},{"ref":"Ps.37.6","start":19037006,"end":19037006,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"ぎ"],[6,1,"ひかり"],[11,1,"あき"],[21,1,"ただ"],[27,2,"まひる"],[33,1,"あき"]],"text":"あなたの義を光のように明らかにし、あなたの正しいことを真昼のように明らかにされる。"},{"ref":"Ps.37.7","start":19037007,"end":19037007,"break":"line","breaks":[[20,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"まえ"],[8,1,"た"],[10,1,"しの"],[13,1,"しゅ"],[15,1,"ま"],[17,1,"のぞ"],[23,1,"みち"],[25,1,"あゆ"],[28,1,"さか"],[31,1,"もの"],[37,1,"わる"],[45,1,"と"],[48,1,"ひと"],[54,1,"こころ"],[56,1,"なや"]],"text":"主の前にもだし、耐え忍びて主を待ち望め。おのが道を歩んで栄える者のゆえに、悪いはかりごとを遂げる人のゆえに、心を悩ますな。"},{"ref":"Ps.37.8","start":19037008,"end":19037008,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"いか"],[6,1,"いきどお"],[9,1,"す"],[13,1,"こころ"],[15,1,"なや"],[25,1,"あく"],[27,1,"おこな"],[30,1,"いた"]],"text":"怒りをやめ、憤りを捨てよ。心を悩ますな、これはただ悪を行うに至るのみだ。"},{"ref":"Ps.37.9","start":19037009,"end":19037009,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"あく"],[2,1,"おこな"],[4,1,"もの"],[6,1,"た"],[8,1,"ほろ"],[13,1,"しゅ"],[15,1,"ま"],[17,1,"のぞ"],[19,1,"もの"],[21,1,"くに"],[23,1,"つ"]],"text":"悪を行う者は断ち滅ぼされ、主を待ち望む者は国を継ぐからである。"},{"ref":"Ps.37.10","start":19037010,"end":19037010,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[15,1,"さ"],[22,1,"かれ"],[24,1,"ところ"],[30,1,"たず"],[34,1,"かれ"]],"text":"悪しき者はただしばらくで、うせ去る。あなたは彼の所をつぶさに尋ねても彼はいない。"},{"ref":"Ps.37.11","start":19037011,"end":19037011,"break":"line","breaks":[[13,"line"]],"ruby":[[3,2,"にゅうわ"],[6,1,"もの"],[8,1,"くに"],[10,1,"つ"],[13,1,"ゆた"],[16,2,"はんえい"]],"text":"しかし柔和な者は国を継ぎ、豊かな繁栄をたのしむことができる。"},{"ref":"Ps.37.12","start":19037012,"end":19037012,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"ただ"],[8,1,"もの"],[32,1,"は"]],"text":"悪しき者は正しい者にむかってはかりごとをめぐらし、これにむかって歯がみする。"},{"ref":"Ps.37.13","start":19037013,"end":19037013,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"あ"],[8,1,"もの"],[10,1,"わら"],[15,1,"かれ"],[17,1,"ひ"],[19,1,"く"],[23,1,"み"]],"text":"しかし主は悪しき者を笑われる、彼の日の来るのを見られるからである。"},{"ref":"Ps.37.14","start":19037014,"end":19037014,"break":"line","breaks":[[18,"line"],[32,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[9,1,"ぬ"],[12,1,"ゆみ"],[14,1,"は"],[18,1,"まず"],[21,1,"もの"],[23,1,"とぼ"],[26,1,"もの"],[29,1,"たお"],[32,1,"なお"],[34,1,"あゆ"],[36,1,"もの"],[38,1,"ころ"]],"text":"悪しき者はつるぎを抜き、弓を張って、貧しい者と乏しい者とを倒し、直く歩む者を殺そうとする。"},{"ref":"Ps.37.15","start":19037015,"end":19037015,"break":"line","breaks":[[17,"line"]],"ruby":[[12,1,"むね"],[14,1,"さ"],[19,1,"ゆみ"],[21,1,"お"]],"text":"しかしそのつるぎはおのが胸を刺し、その弓は折られる。"},{"ref":"Ps.37.16","start":19037016,"end":19037016,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"も"],[7,1,"もの"],[9,1,"すく"],[15,1,"おお"],[18,1,"あ"],[22,1,"もの"],[24,1,"ゆた"]],"text":"正しい人の持ち物の少ないのは、多くの悪しきの者の豊かなのにまさる。"},{"ref":"Ps.37.17","start":19037017,"end":19037017,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"うで"],[7,1,"お"],[13,1,"しゅ"],[15,1,"ただ"],[18,1,"もの"],[20,1,"たす"]],"text":"悪しき者の腕は折られるが、主は正しい者を助けささえられるからである。"},{"ref":"Ps.37.18","start":19037018,"end":19037018,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"まった"],[4,1,"もの"],[11,1,"ひ"],[13,1,"し"],[18,1,"かれ"],[21,1,"し"],[22,1,"ぎょう"],[29,1,"つづ"]],"text":"主は全き者のもろもろの日を知られる。彼らの嗣業はとこしえに続く。"},{"ref":"Ps.37.19","start":19037019,"end":19037019,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[3,1,"わざわい"],[5,1,"とき"],[8,1,"はじ"],[20,1,"ひ"],[23,1,"あ"],[25,1,"た"]],"text":"彼らは災の時にも恥をこうむらず、ききんの日にも飽き足りる。"},{"ref":"Ps.37.20","start":19037020,"end":19037020,"break":"line","breaks":[[12,"line"],[31,"line"]],"ruby":[[4,1,"あ"],[7,1,"もの"],[9,1,"ほろ"],[12,1,"しゅ"],[14,1,"てき"],[16,2,"まきば"],[19,1,"さか"],[22,1,"か"],[28,1,"き"],[31,1,"けむり"],[36,1,"き"]],"text":"しかし、悪しき者は滅び、主の敵は牧場の栄えの枯れるように消え、煙のように消えうせる。"},{"ref":"Ps.37.21","start":19037021,"end":19037021,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"もの"],[7,1,"か"],[10,1,"かえ"],[22,1,"ただ"],[25,1,"ひと"],[27,2,"かんだい"],[31,1,"ほどこ"],[33,1,"あた"]],"text":"悪しき者は物を借りて返すことをしない。しかし正しい人は寛大で、施し与える。"},{"ref":"Ps.37.22","start":19037022,"end":19037022,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"しゅくふく"],[7,1,"もの"],[9,1,"くに"],[11,1,"つ"],[14,1,"しゅ"],[21,1,"もの"],[23,1,"た"],[25,1,"ほろ"]],"text":"主に祝福された者は国を継ぎ、主にのろわれた者は断ち滅ぼされる。"},{"ref":"Ps.37.23","start":19037023,"end":19037023,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ひと"],[2,1,"あゆ"],[5,1,"しゅ"],[10,1,"さだ"],[16,1,"しゅ"],[20,1,"い"],[22,1,"みち"],[24,1,"よろこ"]],"text":"人の歩みは主によって定められる。主はその行く道を喜ばれる。"},{"ref":"Ps.37.24","start":19037024,"end":19037024,"break":"line","breaks":[[12,"line"],[27,"line"]],"ruby":[[5,1,"ひと"],[7,1,"たお"],[12,1,"まった"],[14,1,"う"],[16,1,"ふ"],[27,1,"しゅ"],[31,1,"て"],[33,1,"たす"]],"text":"たといその人が倒れても、全く打ち伏せられることはない、主がその手を助けささえられるからである。"},{"ref":"Ps.37.25","start":19037025,"end":19037025,"break":"line","breaks":[[23,"line"],[42,"line"]],"ruby":[[8,1,"とし"],[9,1,"わか"],[13,1,"とき"],[16,2,"としお"],[20,1,"いま"],[23,1,"ただ"],[26,1,"ひと"],[28,1,"す"],[39,2,"しそん"],[42,2,"しょくもつ"],[45,1,"こ"],[52,1,"み"]],"text":"わたしは、むかし年若かった時も、年老いた今も、正しい人が捨てられ、あるいはその子孫が食物を請いあるくのを見たことがない。"},{"ref":"Ps.37.26","start":19037026,"end":19037026,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"つね"],[7,2,"かんだい"],[11,1,"もの"],[13,1,"か"],[15,1,"あた"],[20,2,"しそん"],[23,2,"しゅくふく"],[26,1,"え"]],"text":"正しい人は常に寛大で、物を貸し与え、その子孫は祝福を得る。"},{"ref":"Ps.37.27","start":19037027,"end":19037027,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"あく"],[6,1,"ぜん"],[8,1,"おこな"],[26,1,"す"]],"text":"悪をさけて、善を行え。そうすれば、あなたはとこしえに住むことができる。"},{"ref":"Ps.37.28","start":19037028,"end":19037028,"break":"line","breaks":[[8,"line"],[26,"line"],[43,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"こうぎ"],[5,1,"あい"],[10,2,"せいと"],[13,2,"みす"],[26,1,"ただ"],[29,1,"もの"],[36,1,"たす"],[38,1,"まも"],[47,1,"あ"],[50,1,"もの"],[52,2,"しそん"],[55,1,"た"],[57,1,"ほろ"]],"text":"主は公義を愛し、その聖徒を見捨てられないからである。正しい者はとこしえに助け守られる。しかし、悪しき者の子孫は断ち滅ぼされる。"},{"ref":"Ps.37.29","start":19037029,"end":19037029,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"くに"],[7,1,"つ"],[17,1,"なか"],[19,1,"す"]],"text":"正しい者は国を継ぎ、とこしえにその中に住むことができる。"},{"ref":"Ps.37.30","start":19037030,"end":19037030,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"くち"],[7,2,"ちえ"],[10,1,"かた"],[15,1,"した"],[17,2,"こうぎ"],[20,1,"の"]],"text":"正しい者の口は知恵を語り、その舌は公義を述べる。"},{"ref":"Ps.37.31","start":19037031,"end":19037031,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"こころ"],[5,1,"かみ"],[16,1,"あゆ"]],"text":"その心には神のおきてがあり、その歩みはすべることがない。"},{"ref":"Ps.37.32","start":19037032,"end":19037032,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"ただ"],[8,1,"ひと"],[18,1,"ころ"]],"text":"悪しき者は正しい人をうかがい、これを殺そうとはかる。"},{"ref":"Ps.37.33","start":19037033,"end":19037033,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ただ"],[5,1,"ひと"],[7,1,"あ"],[10,1,"もの"],[12,1,"て"],[29,1,"とき"],[34,1,"つみ"],[36,1,"さだ"]],"text":"主は正しい人を悪しき者の手にゆだねられない、またさばかれる時、これを罪に定められることはない。"},{"ref":"Ps.37.34","start":19037034,"end":19037034,"break":"line","breaks":[[14,"line"],[39,"line"],[48,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ま"],[4,1,"のぞ"],[9,1,"みち"],[11,1,"まも"],[20,1,"しゅ"],[26,1,"あ"],[30,1,"くに"],[32,1,"つ"],[43,1,"あ"],[46,1,"もの"],[48,1,"た"],[50,1,"ほろ"],[57,1,"み"]],"text":"主を待ち望め、その道を守れ。そうすれば、主はあなたを上げて、国を継がせられる。あなたは悪しき者の断ち滅ぼされるのを見るであろう。"},{"ref":"Ps.37.35","start":19037035,"end":19037035,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"あ"],[7,1,"もの"],[9,1,"か"],[11,1,"ほこ"],[20,2,"こうはく"],[33,1,"み"]],"text":"わたしは悪しき者が勝ち誇って、レバノンの香柏のようにそびえたつのを見た。"},{"ref":"Ps.37.36","start":19037036,"end":19037036,"break":"line","breaks":[[15,"line"],[26,"line"]],"ruby":[[8,1,"とお"],[10,1,"す"],[15,1,"み"],[18,1,"かれ"],[30,1,"かれ"],[32,1,"たず"],[39,1,"み"]],"text":"しかし、わたしが通り過ぎると、見よ、彼はいなかった。わたしは彼を尋ねたけれども見つからなかった。"},{"ref":"Ps.37.37","start":19037037,"end":19037037,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"まった"],[2,1,"ひと"],[4,1,"め"],[10,1,"なお"],[12,1,"ひと"],[14,1,"み"],[22,1,"ひと"],[25,2,"しそん"]],"text":"全き人に目をそそぎ、直き人を見よ。おだやかな人には子孫がある。"},{"ref":"Ps.37.38","start":19037038,"end":19037038,"break":"line","breaks":[[18,"line"]],"ruby":[[3,1,"つみ"],[5,1,"おか"],[7,1,"もの"],[11,1,"とも"],[13,1,"ほろ"],[18,1,"あ"],[21,1,"もの"],[23,2,"しそん"],[26,1,"た"]],"text":"しかし罪を犯す者どもは共に滅ぼされ、悪しき者の子孫は断たれる。"},{"ref":"Ps.37.39","start":19037039,"end":19037039,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"すくい"],[7,1,"しゅ"],[10,1,"で"],[13,1,"しゅ"],[15,1,"かれ"],[18,1,"なや"],[21,1,"とき"],[23,1,"さ"],[25,1,"どころ"]],"text":"正しい人の救は主から出る。主は彼らの悩みの時の避け所である。"},{"ref":"Ps.37.40","start":19037040,"end":19037040,"break":"line","breaks":[[16,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"たす"],[8,1,"かれ"],[11,1,"と"],[13,1,"はな"],[16,1,"かれ"],[19,1,"あ"],[22,1,"もの"],[27,1,"と"],[29,1,"はな"],[32,1,"すく"],[37,1,"かれ"],[40,1,"しゅ"],[42,1,"よ"],[44,1,"たの"]],"text":"主は彼らを助け、彼らを解き放ち、彼らを悪しき者どもから解き放って救われる。彼らは主に寄り頼むからである。"}]