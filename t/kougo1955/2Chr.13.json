[{"ref":"2Chr.13.1","start":14013001,"end":14013001,"break":"paragraph","ruby":[[5,1,"おう"],[7,1,"だい"],[10,1,"ねん"],[19,1,"おう"]],"text":"ヤラベアム王の第十八年にアビヤがユダの王となった。"},{"ref":"2Chr.13.2","start":14013002,"end":14013002,"break":"none","ruby":[[0,1,"かれ"],[3,1,"ねん"],[5,1,"あいだ"],[12,1,"よ"],[14,1,"おさ"],[18,1,"かれ"],[20,1,"はは"],[31,1,"むすめ"],[34,1,"な"]],"text":"彼は三年の間エルサレムで世を治めた。彼の母はギベアのウリエルの娘で、名をミカヤといった。"},{"ref":"2Chr.13.3","start":14013003,"end":14013003,"break":"paragraph","ruby":[[14,1,"あいだ"],[16,2,"せんそう"],[19,1,"おこ"],[30,2,"せいへい"],[34,1,"な"],[36,2,"ゆうかん"],[39,2,"ぐんぜい"],[45,1,"たたか"],[57,1,"だい"],[58,2,"ゆうし"],[62,1,"な"],[68,2,"せいへい"],[78,1,"む"],[82,1,"たたか"],[85,1,"そな"]],"text":"ここにアビヤとヤラベアムとの間に戦争が起り、アビヤは四十万の精兵から成る勇敢な軍勢をもって戦いにいで、ヤラベアムも大勇士から成る八十万の精兵をもって、これに向かって戦いの備えをした。"},{"ref":"2Chr.13.4","start":14013004,"end":14013004,"break":"none","ruby":[[0,1,"とき"],[12,2,"さんち"],[22,1,"やま"],[24,1,"うえ"],[26,1,"た"],[29,1,"い"],[48,2,"ひとびと"],[51,1,"みな"],[52,1,"き"]],"text":"時にアビヤはエフライムの山地にあるゼマライム山の上に立って言った、「ヤラベアムおよびイスラエルの人々よ皆聞け。"},{"ref":"2Chr.13.5","start":14013005,"end":14013005,"break":"none","ruby":[[12,1,"かみ"],[14,1,"しゅ"],[16,1,"しお"],[18,2,"けいやく"],[30,1,"くに"],[41,2,"しそん"],[44,1,"たま"],[51,1,"し"]],"text":"あなたがたはイスラエルの神、主が塩の契約をもってイスラエルの国をながくダビデとその子孫に賜わったことを知らないのか。"},{"ref":"2Chr.13.6","start":14013006,"end":14013006,"break":"none","ruby":[[8,1,"こ"],[14,2,"けらい"],[23,1,"こ"],[30,1,"た"],[36,2,"しゅくん"]],"text":"ところがダビデの子ソロモンの家来であるネバテの子ヤラベアムが起って、その主君にそむき、"},{"ref":"2Chr.13.7","start":14013007,"end":14013007,"break":"none","ruby":[[2,1,"いや"],[5,2,"ぶらい"],[13,1,"あつ"],[17,1,"かれ"],[28,1,"こ"],[35,1,"てき"],[46,1,"わか"],[51,2,"いし"],[54,1,"よわ"],[60,1,"あた"]],"text":"また卑しい無頼のともがらが集まって彼にくみし、ソロモンの子レハベアムに敵したが、レハベアムは若く、かつ意志が弱くてこれに当ることができなかった。"},{"ref":"2Chr.13.8","start":14013008,"end":14013008,"break":"paragraph","ruby":[[0,1,"いま"],[10,2,"たいぐん"],[25,1,"つく"],[35,1,"かみ"],[39,1,"きん"],[41,1,"こ"],[42,1,"うし"],[53,2,"しそん"],[56,1,"て"],[60,1,"しゅ"],[62,1,"くに"],[64,2,"てきたい"]],"text":"今また、あなたがたは大軍をたのみ、またヤラベアムが造って、あなたがたの神とした金の子牛をたのんで、ダビデの子孫の手にある主の国に敵対しようとしている。"},{"ref":"2Chr.13.9","start":14013009,"end":14013009,"break":"none","ruby":[[12,2,"しそん"],[17,1,"しゅ"],[19,2,"さいし"],[28,1,"お"],[34,1,"た"],[36,2,"くにぐに"],[39,1,"たみ"],[46,2,"さいし"],[49,1,"た"],[66,1,"わか"],[68,2,"おうし"],[71,1,"とう"],[73,2,"おひつじ"],[76,1,"とう"],[78,1,"たずさ"],[84,2,"じぶん"],[87,2,"せいべつ"],[91,1,"もの"],[93,1,"みな"],[96,1,"かみ"],[100,1,"もの"],[102,2,"さいし"]],"text":"またあなたがたはアロンの子孫である主の祭司とレビびととを追いだして、他の国々の民がするように祭司を立てたではないか。すなわちだれでも若い雄牛一頭、雄羊七頭を携えてきて、自分を聖別する者は皆あの神でない者の祭司とすることができた。"},{"ref":"2Chr.13.10","start":14013010,"end":14013010,"break":"none","ruby":[[13,1,"しゅ"],[20,1,"かみ"],[31,1,"かれ"],[33,1,"す"],[40,1,"しゅ"],[42,1,"つか"],[45,2,"さいし"],[52,2,"しそん"],[58,1,"はたら"],[63,1,"もの"]],"text":"しかしわれわれにおいては、主がわれわれの神であって、われわれは彼を捨てない。また主に仕える祭司はアロンの子孫であり、働きをなす者はレビびとである。"},{"ref":"2Chr.13.11","start":14013011,"end":14013011,"break":"none","ruby":[[0,1,"かれ"],[3,1,"あさ"],[6,1,"ゆう"],[10,1,"しゅ"],[12,2,"はんさい"],[21,1,"こう"],[27,1,"そな"],[33,2,"じゅんきん"],[36,1,"つくえ"],[38,1,"うえ"],[40,1,"そな"],[45,1,"きん"],[47,2,"しょくだい"],[56,1,"さら"],[58,1,"ととの"],[62,1,"ゆう"],[89,1,"かみ"],[91,1,"しゅ"],[93,1,"つとめ"],[95,1,"まも"],[108,1,"かれ"],[110,1,"す"]],"text":"彼らは朝ごと夕ごとに主に燔祭と、こうばしい香をささげ、供えのパンを純金の机の上に供え、また金の燭台とそのともしび皿を整えて、夕ごとにともすのである。このようにわれわれはわれわれの神、主の務を守っているが、あなたがたは彼を捨てた。"},{"ref":"2Chr.13.12","start":14013012,"end":14013012,"break":"none","ruby":[[0,1,"み"],[3,1,"かみ"],[14,1,"とも"],[39,2,"さいし"],[48,1,"ふ"],[61,1,"せ"],[71,2,"ひとびと"],[81,2,"せんぞ"],[84,1,"かみ"],[86,1,"しゅ"],[88,1,"てき"],[91,1,"たたか"],[106,2,"せいこう"]],"text":"見よ、神はみずからわれわれと共におられて、われわれのかしらとなられ、また、その祭司たちはラッパを吹きならして、あなたがたを攻める。イスラエルの人々よ、あなたがたの先祖の神、主に敵して戦ってはならない。あなたがたは成功しない」。"},{"ref":"2Chr.13.13","start":14013013,"end":14013013,"break":"paragraph","ruby":[[6,2,"ふくへい"],[9,1,"かれ"],[16,1,"まわ"],[23,1,"かれ"],[25,2,"ぐんたい"],[31,1,"まえ"],[36,2,"ふくへい"],[39,1,"かれ"]],"text":"ヤラベアムは伏兵を彼らのうしろに回らせたので、彼の軍隊はユダの前にあり、伏兵は彼らのうしろにあった。"},{"ref":"2Chr.13.14","start":14013014,"end":14013014,"break":"none","ruby":[[7,1,"み"],[11,1,"てき"],[13,1,"まえ"],[26,1,"しゅ"],[28,1,"む"],[32,1,"よ"],[37,2,"さいし"],[46,1,"ふ"]],"text":"ユダはうしろを見ると、敵が前とうしろとにあったので、主に向かって呼ばわり、祭司たちはラッパを吹いた。"},{"ref":"2Chr.13.15","start":14013015,"end":14013015,"break":"none","ruby":[[6,2,"ひとびと"],[12,1,"こえ"],[21,2,"ひとびと"],[27,1,"こえ"],[34,1,"かみ"],[48,2,"ひとびと"],[58,1,"まえ"],[60,1,"う"],[62,1,"やぶ"]],"text":"そこでユダの人々はときの声をあげた。ユダの人々がときの声をあげると、神はヤラベアムとイスラエルの人々をアビヤとユダの前に打ち敗られたので、"},{"ref":"2Chr.13.16","start":14013016,"end":14013016,"break":"none","ruby":[[6,2,"ひとびと"],[12,1,"まえ"],[15,1,"に"],[19,1,"かみ"],[21,1,"かれ"],[27,1,"て"],[29,1,"わた"]],"text":"イスラエルの人々はユダの前から逃げた。神が彼らをユダの手に渡されたので、"},{"ref":"2Chr.13.17","start":14013017,"end":14013017,"break":"none","ruby":[[6,1,"たみ"],[9,1,"かれ"],[18,1,"う"],[20,1,"ころ"],[30,1,"ころ"],[34,1,"たお"],[37,1,"もの"],[42,1,"にん"],[44,1,"みな"],[45,2,"せいへい"]],"text":"アビヤとその民は、彼らをおびただしく撃ち殺した。イスラエルの殺されて倒れた者は五十万人、皆精兵であった。"},{"ref":"2Chr.13.18","start":14013018,"end":14013018,"break":"none","ruby":[[8,1,"とき"],[15,2,"ひとびと"],[18,1,"う"],[20,1,"ま"],[28,2,"ひとびと"],[31,1,"かち"],[33,1,"え"],[36,1,"かれ"],[41,2,"せんぞ"],[44,1,"かみ"],[46,1,"しゅ"],[48,1,"たの"]],"text":"このように、この時イスラエルの人々は打ち負かされ、ユダの人々は勝を得た。彼らがその先祖の神、主を頼んだからである。"},{"ref":"2Chr.13.19","start":14013019,"end":14013019,"break":"none","ruby":[[10,2,"ついげき"],[14,2,"すうこ"],[17,1,"まち"],[19,1,"かれ"],[22,1,"と"],[36,2,"むらざと"],[46,2,"むらざと"],[56,2,"むらざと"]],"text":"アビヤはヤラベアムを追撃して数個の町を彼から取った。すなわちベテルとその村里、エシャナとその村里、エフロンとその村里である。"},{"ref":"2Chr.13.20","start":14013020,"end":14013020,"break":"none","ruby":[[11,1,"よ"],[14,1,"ふたた"],[16,1,"ちから"],[18,1,"え"],[27,1,"しゅ"],[29,1,"う"],[33,1,"し"]],"text":"ヤラベアムは、アビヤの世には再び力を得ることができず、主に撃たれて死んだ。"},{"ref":"2Chr.13.21","start":14013021,"end":14013021,"break":"none","ruby":[[7,1,"つよ"],[12,1,"つま"],[15,1,"にん"],[27,1,"にん"],[34,1,"にん"]],"text":"しかしアビヤは強くなり、妻十四人をめとり、むすこ二十二人、むすめ十六人をもうけた。"},{"ref":"2Chr.13.22","start":14013022,"end":14013022,"break":"none","ruby":[[6,1,"た"],[8,2,"こうい"],[16,2,"こうどう"],[19,2,"ことば"],[23,3,"よげんしゃ"],[29,2,"ちゅうしゃく"]],"text":"アビヤのその他の行為すなわちその行動と言葉は、預言者イドの注釈にしるされている。"}]