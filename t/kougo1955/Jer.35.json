[{"ref":"Jer.35.1","start":24035001,"end":24035001,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"こ"],[15,1,"とき"],[17,1,"しゅ"],[25,1,"のぞ"],[28,2,"ことば"]],"text":"ユダの王ヨシヤの子エホヤキムの時、主からエレミヤに臨んだ言葉。"},{"ref":"Jer.35.2","start":24035002,"end":24035002,"break":"none","ruby":[[7,1,"いえ"],[9,1,"い"],[13,1,"かれ"],[16,1,"かた"],[19,1,"かれ"],[22,1,"しゅ"],[24,1,"みや"],[26,2,"いっしつ"],[29,1,"つ"],[35,1,"さけ"],[37,1,"の"]],"text":"「レカブびとの家に行って、彼らと語り、彼らを主の宮の一室に連れてきて、酒を飲ませなさい」。"},{"ref":"Jer.35.3","start":24035003,"end":24035003,"break":"none","ruby":[[13,1,"こ"],[19,1,"こ"],[31,2,"きょうだい"],[52,2,"ぜんか"],[55,1,"つ"]],"text":"そこでわたしはハバジニヤの子エレミヤの子であるヤザニヤと、その兄弟と、そのむすこたち、およびレカブびとの全家を連れ、"},{"ref":"Jer.35.4","start":24035004,"end":24035004,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"みや"],[13,1,"こ"],[17,1,"しつ"],[19,1,"つ"],[35,1,"こ"],[40,1,"かみ"],[42,1,"ひと"],[50,1,"しつ"],[59,1,"しつ"],[61,1,"つぎ"],[67,1,"もん"],[69,1,"まも"],[76,1,"こ"],[82,1,"しつ"],[84,1,"うえ"]],"text":"これを主の宮にあるハナンの子たちの室に連れてきた。ハナンはイグダリヤの子であって神の人であった。その室は、つかさたちの室の次にあって、門を守るシャルムの子マアセヤの室の上にあった。"},{"ref":"Jer.35.5","start":24035005,"end":24035005,"break":"none","ruby":[[10,1,"まえ"],[12,1,"さけ"],[14,1,"み"],[21,1,"さかずき"],[23,1,"お"],[26,1,"かれ"],[31,1,"さけ"],[33,1,"の"],[40,1,"い"]],"text":"わたしはレカブびとの前に酒を満たしたつぼと杯を置き、彼らに、「酒を飲みなさい」と言ったが、"},{"ref":"Jer.35.6","start":24035006,"end":24035006,"break":"none","ruby":[[0,1,"かれ"],[3,1,"こた"],[13,1,"さけ"],[15,1,"の"],[29,1,"こ"],[38,2,"せんぞ"],[50,1,"めい"],[67,2,"しそん"],[75,1,"さけ"],[77,1,"の"]],"text":"彼らは答えた、「われわれは酒を飲みません。それは、レカブの子であるわれわれの先祖ヨナダブがわれわれに命じて、『あなたがたとあなたがたの子孫はいつまでも酒を飲んではならない。"},{"ref":"Jer.35.7","start":24035007,"end":24035007,"break":"none","ruby":[[2,1,"いえ"],[4,1,"た"],[8,1,"たね"],[19,1,"はたけ"],[21,1,"う"],[35,2,"しょゆう"],[51,1,"い"],[58,1,"あいだ"],[60,2,"まくや"],[63,1,"す"],[87,1,"やど"],[92,1,"ち"],[94,1,"なが"],[96,1,"い"],[106,1,"い"]],"text":"また家を建てず、種をまかず、またぶどう畑を植えてはならない。またこれを所有してはならない。あなたがたは生きながらえる間は幕屋に住んでいなさい。そうするならば、あなたがたはその宿っている地に長く生きることができると言ったからです』。"},{"ref":"Jer.35.8","start":24035008,"end":24035008,"break":"none","ruby":[[14,1,"こ"],[23,2,"せんぞ"],[33,1,"めい"],[36,2,"ことば"],[39,1,"したが"],[49,1,"つま"],[55,1,"むすめ"],[57,1,"い"],[64,1,"あいだ"],[66,1,"さけ"],[68,1,"の"]],"text":"こうしてわれわれは、レカブの子であるわれわれの先祖ヨナダブがすべて命じた言葉に従って、われわれも、妻も、むすこ娘も生きながらえる間、酒を飲まず、"},{"ref":"Jer.35.9","start":24035009,"end":24035009,"break":"none","ruby":[[0,1,"す"],[2,1,"いえ"],[4,1,"た"],[11,1,"はたけ"],[13,1,"はたけ"],[15,1,"たね"],[17,1,"も"]],"text":"住む家を建てず、ぶどう畑も畑も種も持たないで、"},{"ref":"Jer.35.10","start":24035010,"end":24035010,"break":"none","ruby":[[0,2,"まくや"],[3,1,"す"],[14,2,"せんぞ"],[26,1,"めい"],[33,1,"したが"],[41,1,"おこな"]],"text":"幕屋に住み、すべてわれわれの先祖ヨナダブがわれわれに命じたところに従い、そのように行いました。"},{"ref":"Jer.35.11","start":24035011,"end":24035011,"break":"none","ruby":[[8,1,"おう"],[19,1,"ち"],[21,1,"のぼ"],[26,1,"とき"],[33,1,"い"],[54,1,"い"],[65,2,"ぐんぜい"],[74,2,"ぐんぜい"],[77,1,"おそ"],[99,1,"す"]],"text":"しかしバビロンの王ネブカデレザルがこの地に上ってきた時、われわれは言いました、『さあ、われわれはエルサレムへ行こう。カルデヤびとの軍勢とスリヤびとの軍勢が恐ろしい』と。こうしてわれわれはエルサレムに住んでいるのです」。"},{"ref":"Jer.35.12","start":24035012,"end":24035012,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,2,"ことば"],[14,1,"のぞ"]],"text":"その時、主の言葉がエレミヤに臨んだ、"},{"ref":"Jer.35.13","start":24035013,"end":24035013,"break":"none","ruby":[[1,2,"ばんぐん"],[4,1,"しゅ"],[12,1,"かみ"],[16,1,"い"],[21,1,"い"],[28,2,"ひとびと"],[37,1,"す"],[39,1,"もの"],[42,1,"つ"],[46,1,"しゅ"],[48,1,"おお"],[64,2,"ことば"],[67,1,"き"],[70,1,"おしえ"],[72,1,"う"]],"text":"「万軍の主、イスラエルの神はこう言われる、行って、ユダの人々とエルサレムに住む者とに告げよ。主は仰せられる、あなたがたはわたしの言葉を聞いて教を受けないのか。"},{"ref":"Jer.35.14","start":24035014,"end":24035014,"break":"none","ruby":[[4,1,"こ"],[12,2,"しそん"],[15,1,"さけ"],[17,1,"の"],[21,1,"めい"],[24,2,"ことば"],[27,1,"まも"],[34,1,"かれ"],[37,2,"こんにち"],[40,1,"いた"],[44,1,"さけ"],[46,1,"の"],[52,2,"せんぞ"],[55,1,"いのち"],[57,1,"したが"],[81,1,"かた"],[93,1,"き"],[95,1,"したが"]],"text":"レカブの子ヨナダブがその子孫に酒を飲むなと命じた言葉は守られてきた。彼らは今日に至るまで酒を飲まず、その先祖の命に従ってきた。ところがあなたがたはわたしがしきりに語ったけれども、わたしに聞き従わなかった。"},{"ref":"Jer.35.15","start":24035015,"end":24035015,"break":"none","ruby":[[17,3,"よげんしゃ"],[39,1,"い"],[51,1,"いま"],[58,1,"わる"],[60,1,"みち"],[62,1,"はな"],[67,1,"おこな"],[70,1,"あらた"],[79,2,"かみがみ"],[82,1,"したが"],[84,1,"つか"],[122,2,"せんぞ"],[125,1,"あた"],[130,1,"ち"],[132,1,"す"],[152,1,"みみ"],[154,1,"かたむ"],[162,1,"き"]],"text":"わたしはまた、わたしのしもべである預言者たちを、しきりにあなたがたにつかわして言わせた、『あなたがたは今おのおのその悪い道を離れ、その行いを改めなさい。ほかの神々に従い仕えてはならない。そうすれば、あなたがたはわたしがあなたがたと、あなたがたの先祖に与えたこの地に住むことができる』と。しかしあなたがたは耳を傾けず、わたしに聞かなかった。"},{"ref":"Jer.35.16","start":24035016,"end":24035016,"break":"none","ruby":[[4,1,"こ"],[10,2,"しそん"],[16,2,"せんぞ"],[19,1,"かれ"],[22,1,"めい"],[25,2,"めいれい"],[28,1,"まも"],[43,1,"たみ"],[49,1,"したが"]],"text":"レカブの子ヨナダブの子孫は、その先祖が彼らに命じた命令を守っているのである。しかしこの民はわたしに従わなかった。"},{"ref":"Jer.35.17","start":24035017,"end":24035017,"break":"none","ruby":[[4,2,"ばんぐん"],[7,1,"かみ"],[9,1,"しゅ"],[17,1,"かみ"],[21,1,"おお"],[27,1,"み"],[43,1,"す"],[45,1,"もの"],[53,1,"かれ"],[56,1,"うえ"],[58,2,"せんこく"],[62,1,"わざわい"],[64,1,"くだ"],[71,1,"かれ"],[74,1,"かた"],[78,1,"き"],[82,1,"かれ"],[85,1,"よ"],[89,1,"こた"]],"text":"それゆえ万軍の神、主、イスラエルの神はこう仰せられる、見よ、わたしはユダとエルサレムに住む者とに、わたしが彼らの上に宣告した災を下す。わたしが彼らに語っても聞かず、彼らを呼んでも答えなかったからである」。"},{"ref":"Jer.35.18","start":24035018,"end":24035018,"break":"paragraph","ruby":[[15,1,"いえ"],[17,2,"ひとびと"],[20,1,"い"],[25,2,"ばんぐん"],[28,1,"しゅ"],[36,1,"かみ"],[40,1,"おお"],[52,2,"せんぞ"],[59,1,"いのち"],[61,1,"したが"],[70,1,"いまし"],[73,1,"まも"],[76,1,"かれ"],[84,1,"めい"],[87,1,"こと"],[89,1,"おこな"]],"text":"ところでエレミヤはレカブびとの家の人々に言った、「万軍の主、イスラエルの神はこう仰せられる、あなたがたは先祖ヨナダブの命に従い、そのすべての戒めを守り、彼があなたがたに命じた事を行った。"},{"ref":"Jer.35.19","start":24035019,"end":24035019,"break":"none","ruby":[[5,2,"ばんぐん"],[8,1,"しゅ"],[16,1,"かみ"],[20,1,"い"],[29,1,"こ"],[41,1,"まえ"],[43,1,"た"],[45,1,"ひと"],[52,1,"か"]],"text":"それゆえ、万軍の主、イスラエルの神はこう言われる、レカブの子ヨナダブには、わたしの前に立つ人がいつまでも欠けることはない」。"}]