[{"ref":"Titus.1.1","start":56001001,"end":56001001,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"しもべ"],[13,2,"しと"],[26,2,"しと"],[35,1,"かみ"],[37,1,"えら"],[41,1,"もの"],[45,2,"しんこう"],[48,1,"つよ"],[54,2,"しんじん"],[60,2,"しんり"],[63,2,"ちしき"],[66,1,"かれ"],[69,1,"え"]],"text":"神の僕、イエス・キリストの使徒パウロから――わたしが使徒とされたのは、神に選ばれた者たちの信仰を強め、また、信心にかなう真理の知識を彼らに得させるためであり、"},{"ref":"Titus.1.2","start":56001002,"end":56001002,"break":"none","ruby":[[0,1,"いつわ"],[5,1,"かみ"],[7,2,"えいえん"],[10,1,"むかし"],[12,2,"やくそく"],[17,2,"えいえん"],[24,1,"のぞ"],[27,1,"もとづ"]],"text":"偽りのない神が永遠の昔に約束された永遠のいのちの望みに基くのである。"},{"ref":"Titus.1.3","start":56001003,"end":56001003,"break":"none","ruby":[[0,1,"かみ"],[3,1,"さだ"],[8,1,"とき"],[10,1,"およ"],[14,2,"みことば"],[17,2,"せんきょう"],[23,1,"あき"],[43,2,"すくいぬし"],[47,1,"かみ"],[49,2,"にんめい"],[58,2,"せんきょう"]],"text":"神は、定められた時に及んで、御言を宣教によって明らかにされたが、わたしは、わたしたちの救主なる神の任命によって、この宣教をゆだねられたのである――"},{"ref":"Titus.1.4","start":56001004,"end":56001004,"break":"none","breaks":[[21,"paragraph"]],"ruby":[[0,2,"しんこう"],[3,1,"おな"],[12,2,"しんじつ"],[15,1,"こ"],[21,1,"ちち"],[24,1,"かみ"],[32,2,"すくいぬし"],[45,1,"めぐ"],[48,2,"へいあん"]],"text":"信仰を同じうするわたしの真実の子テトスへ。父なる神とわたしたちの救主キリスト・イエスから、恵みと平安とが、あなたにあるように。"},{"ref":"Titus.1.5","start":56001005,"end":56001005,"break":"paragraph","ruby":[[24,1,"めい"],[38,1,"のこ"],[46,2,"せいり"],[57,2,"まちまち"],[60,2,"ちょうろう"],[63,1,"た"]],"text":"あなたをクレテにおいてきたのは、わたしがあなたに命じておいたように、そこにし残してあることを整理してもらい、また、町々に長老を立ててもらうためにほかならない。"},{"ref":"Titus.1.6","start":56001006,"end":56001006,"break":"none","ruby":[[0,2,"ちょうろう"],[4,1,"せ"],[9,1,"てん"],[18,1,"つま"],[20,1,"おっと"],[28,1,"こ"],[32,3,"ふひんこう"],[46,3,"おやふこう"],[53,2,"しんじゃ"]],"text":"長老は、責められる点がなく、ひとりの妻の夫であって、その子たちも不品行のうわさをたてられず、親不孝をしない信者でなくてはならない。"},{"ref":"Titus.1.7","start":56001007,"end":56001007,"break":"none","ruby":[[0,2,"かんとく"],[4,1,"もの"],[7,1,"かみ"],[9,1,"つか"],[12,1,"もの"],[17,1,"せ"],[22,1,"てん"],[35,2,"かるがる"],[39,1,"いか"],[43,1,"さけ"],[45,1,"この"],[49,2,"らんぼう"],[55,1,"り"]],"text":"監督たる者は、神に仕える者として、責められる点がなく、わがままでなく、軽々しく怒らず、酒を好まず、乱暴でなく、利をむさぼらず、"},{"ref":"Titus.1.8","start":56001008,"end":56001008,"break":"none","ruby":[[5,2,"たびびと"],[13,1,"ぜん"],[15,1,"あい"],[18,1,"つつし"],[20,1,"ふか"],[23,1,"ただ"],[27,2,"しんこう"],[29,1,"ぶか"],[32,1,"じ"],[33,1,"せい"],[36,1,"もの"]],"text":"かえって、旅人をもてなし、善を愛し、慎み深く、正しく、信仰深く、自制する者であり、"},{"ref":"Titus.1.9","start":56001009,"end":56001009,"break":"none","ruby":[[0,1,"おしえ"],[6,2,"しんらい"],[11,2,"ことば"],[14,1,"まも"],[16,1,"ひと"],[31,1,"かれ"],[33,2,"けんぜん"],[36,1,"おしえ"],[41,1,"ひと"],[50,3,"はんたいしゃ"],[54,1,"あやま"],[57,2,"してき"]],"text":"教にかなった信頼すべき言葉を守る人でなければならない。それは、彼が健全な教によって人をさとし、また、反対者の誤りを指摘することができるためである。"},{"ref":"Titus.1.10","start":56001010,"end":56001010,"break":"paragraph","ruby":[[0,1,"じつ"],[3,1,"ほう"],[5,1,"ふく"],[9,1,"もの"],[11,2,"くうろん"],[14,1,"はし"],[16,1,"もの"],[18,1,"ひと"],[20,1,"こころ"],[22,1,"まど"],[25,1,"もの"],[27,1,"おお"],[36,2,"かつれい"],[41,1,"もの"],[43,1,"なか"],[45,1,"おお"]],"text":"実は、法に服さない者、空論に走る者、人の心を惑わす者が多くおり、とくに、割礼のある者の中に多い。"},{"ref":"Titus.1.11","start":56001011,"end":56001011,"break":"none","ruby":[[0,1,"かれ"],[3,1,"くち"],[5,1,"ふう"],[13,1,"かれ"],[16,1,"は"],[20,1,"り"],[26,1,"おし"],[37,1,"おし"],[41,2,"かずかず"],[44,2,"かてい"],[47,2,"はかい"]],"text":"彼らの口を封ずべきである。彼らは恥ずべき利のために、教えてはならないことを教えて、数々の家庭を破壊してしまっている。"},{"ref":"Titus.1.12","start":56001012,"end":56001012,"break":"none","breaks":[[14,"stanza"],[29,"line"],[38,"line"]],"ruby":[[3,1,"びと"],[10,3,"よげんしゃ"],[18,1,"びと"],[32,1,"わる"],[41,1,"もの"],[43,1,"く"],[51,1,"い"]],"text":"クレテ人のうちのある預言者が「クレテ人は、いつもうそつき、たちの悪いけもの、なまけ者の食いしんぼう」と言っているが、"},{"ref":"Titus.1.13","start":56001013,"end":56001013,"break":"none","ruby":[[2,2,"ひなん"],[16,1,"かれ"],[23,1,"せ"],[29,2,"しんこう"],[32,2,"けんぜん"]],"text":"この非難はあたっている。だから、彼らをきびしく責めて、その信仰を健全なものにし、"},{"ref":"Titus.1.14","start":56001014,"end":56001014,"break":"none","ruby":[[3,1,"じん"],[5,1,"つく"],[7,1,"ばなし"],[10,2,"しんり"],[20,2,"ひとびと"],[23,1,"さだ"],[29,1,"き"]],"text":"ユダヤ人の作り話や、真理からそれていった人々の定めなどに、気をとられることがないようにさせなさい。"},{"ref":"Titus.1.15","start":56001015,"end":56001015,"break":"none","ruby":[[3,1,"ひと"],[22,1,"けが"],[27,1,"ふ"],[28,2,"しんこう"],[31,1,"ひと"],[49,2,"ちせい"],[52,2,"りょうしん"],[55,1,"けが"]],"text":"きよい人には、すべてのものがきよい。しかし、汚れている不信仰な人には、きよいものは一つもなく、その知性も良心も汚れてしまっている。"},{"ref":"Titus.1.16","start":56001016,"end":56001016,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,1,"し"],[12,1,"くち"],[15,1,"い"],[19,1,"おこな"],[26,2,"ひてい"],[33,1,"かれ"],[36,1,"い"],[41,1,"もの"],[45,1,"ふ"],[46,2,"じゅうじゅん"],[49,1,"もの"],[60,1,"よ"],[65,1,"かん"],[70,3,"しっかくしゃ"]],"text":"彼らは神を知っていると、口では言うが、行いではそれを否定している。彼らは忌まわしい者、また不従順な者であって、いっさいの良いわざに関しては、失格者である。"}]