[{"ref":"Nah.3.1","start":34003001,"end":34003001,"break":"paragraph","breaks":[[15,"line"],[33,"line"]],"ruby":[[9,1,"ち"],[11,1,"なが"],[13,1,"まち"],[17,1,"なか"],[20,1,"いつわ"],[28,1,"もの"],[30,1,"み"],[33,2,"りゃくだつ"]],"text":"わざわいなるかな、血を流す町。その中には偽りと、ぶんどり物が満ち、略奪はやまない。"},{"ref":"Nah.3.2","start":34003002,"end":34003002,"break":"line","breaks":[[21,"line"]],"ruby":[[3,1,"おと"],[8,2,"しゃりん"],[15,1,"おと"],[17,1,"きこ"],[24,1,"うま"],[29,1,"はし"],[31,2,"せんしゃ"]],"text":"むちの音がする。車輪のとどろく音が聞える。かける馬があり、走る戦車がある。"},{"ref":"Nah.3.3","start":34003003,"end":34003003,"break":"line","breaks":[[7,"line"],[24,"line"],[37,"line"],[47,"line"]],"ruby":[[0,2,"きへい"],[3,2,"とつげき"],[24,1,"ころ"],[28,1,"もの"],[42,1,"やま"],[47,2,"したい"],[50,1,"かず"],[51,1,"かぎ"],[56,2,"ひとびと"],[61,2,"したい"]],"text":"騎兵は突撃し、つるぎがきらめき、やりがひらめく。殺される者はおびただしく、しかばねは山をなす。死体は数限りなく、人々はその死体につまずく。"},{"ref":"Nah.3.4","start":34003004,"end":34003004,"break":"line","breaks":[[20,"line"],[33,"line"],[48,"line"]],"ruby":[[3,1,"みな"],[9,2,"ゆうじょ"],[12,1,"おそ"],[16,2,"まりょく"],[20,1,"おお"],[23,2,"いんこう"],[35,2,"いんこう"],[41,1,"しょ"],[42,2,"こくみん"],[45,1,"う"],[50,2,"まりょく"],[56,1,"しょ"],[57,1,"ぞく"],[59,1,"う"],[61,1,"わた"]],"text":"これは皆あでやかな遊女の恐るべき魔力と、多くの淫行のためであって、その淫行をもって諸国民を売り、その魔力をもって諸族を売り渡したものである。"},{"ref":"Nah.3.5","start":34003005,"end":34003005,"break":"stanza","breaks":[[10,"line"],[24,"line"],[43,"line"],[55,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"い"],[10,1,"み"],[21,1,"のぞ"],[35,1,"かお"],[37,1,"うえ"],[47,1,"はだか"],[49,2,"しょみん"],[52,1,"み"],[59,1,"は"],[62,1,"ところ"],[64,2,"しょこく"],[67,1,"み"]],"text":"万軍の主は言われる、見よ、わたしはあなたに臨む、わたしはあなたのすそを顔の上まであげ、あなたの裸を諸民に見せ、あなたの恥じる所を諸国に見せる。"},{"ref":"Nah.3.6","start":34003006,"end":34003006,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"けが"],[9,1,"もの"],[16,1,"うえ"],[18,1,"な"],[38,1,"み"]],"text":"わたしは汚らわしい物を、あなたの上に投げかけて、あなたをはずかしめ、あなたを見ものとする。"},{"ref":"Nah.3.7","start":34003007,"end":34003007,"break":"line","breaks":[[13,"line"],[28,"line"],[39,"line"],[51,"line"],[68,"line"]],"ruby":[[7,1,"み"],[17,1,"さ"],[20,1,"に"],[22,1,"さ"],[25,1,"い"],[33,1,"ほろ"],[47,1,"なげ"],[59,2,"かのじょ"],[62,1,"なぐさ"],[65,1,"もの"],[68,1,"たず"],[70,1,"だ"],[72,1,"え"]],"text":"すべてあなたを見るものは、あなたを避けて逃げ去って言う、「ニネベは滅びた」と。だれがこのために嘆こう。わたしはどこから彼女を慰める者を、尋ね出し得よう。"},{"ref":"Nah.3.8","start":34003008,"end":34003008,"break":"line","breaks":[[16,"line"],[32,"line"],[44,"line"],[53,"line"]],"ruby":[[22,1,"かわ"],[29,1,"ざ"],[32,1,"みず"],[36,2,"しゅうい"],[44,1,"うみ"],[53,1,"みず"],[57,1,"かき"]],"text":"あなたはテーベにまさっているか。これはナイル川のかたわらに座し、水をその周囲にめぐらし、海をとりでとなし、水をその垣としている。"},{"ref":"Nah.3.9","start":34003009,"end":34003009,"break":"line","breaks":[[21,"line"],[27,"line"]],"ruby":[[2,1,"ちから"],[21,1,"かぎ"],[40,1,"たす"],[42,1,"て"]],"text":"その力はエチオピヤ、またエジプトであって、限りがない。プトびと、リビヤびともその助け手であった。"},{"ref":"Nah.3.10","start":34003010,"end":34003010,"break":"line","breaks":[[22,"line"],[44,"line"],[59,"line"]],"ruby":[[14,1,"とら"],[19,1,"い"],[24,1,"こ"],[25,1,"とも"],[38,1,"う"],[40,1,"くだ"],[46,1,"たっと"],[48,2,"ひとびと"],[54,1,"わ"],[61,1,"おお"],[65,2,"ひとびと"],[68,1,"みな"],[70,1,"くさり"]],"text":"しかし、これもとりことなって捕えられて行き、その子供もすべてのちまたのかどで打ち砕かれ、その尊い人々はくじで分けられ、その大いなる人々は皆、鎖につながれた。"},{"ref":"Nah.3.11","start":34003011,"end":34003011,"break":"line","breaks":[[16,"line"]],"ruby":[[6,1,"よ"],[11,1,"き"],[13,1,"うしな"],[20,1,"てき"],[22,1,"さ"],[25,1,"に"],[27,1,"ば"],[29,1,"もと"]],"text":"あなたもまた酔わされて気を失い、あなたは敵を避けて逃げ場を求める。"},{"ref":"Nah.3.12","start":34003012,"end":34003012,"break":"line","breaks":[[9,"line"],[29,"line"],[45,"line"]],"ruby":[[8,1,"みな"],[9,1,"はつ"],[13,1,"み"],[23,1,"き"],[39,1,"み"],[41,1,"お"],[45,1,"た"],[52,1,"もの"],[54,1,"くち"]],"text":"あなたのとりでは皆初なりの実をもつ、いちじくの木のようだ。これをゆすぶればその実は落ちて、食べようとする者の口にはいる。"},{"ref":"Nah.3.13","start":34003013,"end":34003013,"break":"line","breaks":[[21,"line"],[43,"line"]],"ruby":[[0,1,"み"],[12,2,"へいし"],[15,1,"おんな"],[25,1,"くに"],[27,1,"もん"],[33,1,"てき"],[35,1,"まえ"],[37,1,"ひろ"],[39,1,"ひら"],[43,1,"ひ"],[49,1,"かん"],[51,1,"き"],[53,1,"や"]],"text":"見よ、あなたのうちにいる兵士は女のようだ。あなたの国の門はあなたの敵の前に広く開かれ、火はあなたの貫の木を焼いた。"},{"ref":"Nah.3.14","start":34003014,"end":34003014,"break":"line","breaks":[[11,"line"],[23,"line"],[41,"line"]],"ruby":[[0,2,"ろうじょう"],[6,1,"みず"],[19,1,"かた"],[23,2,"ねんど"],[26,1,"なか"],[38,1,"ふ"],[45,1,"かた"]],"text":"籠城のために水をくめ。あなたのとりでを堅めよ。粘土の中にはいって、しっくいを踏み、れんがの型をとれ。"},{"ref":"Nah.3.15","start":34003015,"end":34003015,"break":"line","breaks":[[13,"line"],[24,"line"],[44,"stanza"],[60,"line"]],"ruby":[[2,1,"ところ"],[4,1,"ひ"],[10,1,"や"],[21,1,"き"],[38,1,"く"],[40,1,"ほろ"],[55,1,"かず"],[57,1,"ま"]],"text":"その所で火はあなたを焼き、つるぎはあなたを切る。それはいなごのようにあなたを食い滅ぼす。あなたはいなごのように数を増せ。ばったのようにふえよ。"},{"ref":"Nah.3.16","start":34003016,"end":34003016,"break":"line","breaks":[[21,"line"]],"ruby":[[4,2,"じぶん"],[7,2,"しょうにん"],[10,1,"てん"],[12,1,"ほし"],[16,1,"おお"],[25,1,"はね"],[30,1,"と"],[32,1,"さ"]],"text":"あなたは自分の商人を天の星よりも多くした。いなごは羽をはって飛び去る。"},{"ref":"Nah.3.17","start":34003017,"end":34003017,"break":"line","breaks":[[17,"line"],[35,"line"],[46,"line"],[58,"line"]],"ruby":[[4,1,"きみ"],[21,2,"がくしゃ"],[35,1,"さむ"],[37,1,"ひ"],[40,1,"かき"],[46,1,"ひ"],[48,1,"で"],[50,1,"く"],[53,1,"と"],[55,1,"さ"],[67,1,"し"]],"text":"あなたの君たちは、ばったのように、あなたの学者たちは、いなごのように、寒い日には垣にとまり、日が出て来ると飛び去る。そのありかはだれも知らない。"},{"ref":"Nah.3.18","start":34003018,"end":34003018,"break":"stanza","breaks":[[9,"line"],[31,"line"],[46,"line"]],"ruby":[[6,1,"おう"],[13,2,"ぼくしゃ"],[16,1,"ねむ"],[23,2,"きぞく"],[35,1,"たみ"],[37,1,"やま"],[39,1,"うえ"],[41,1,"ち"],[49,1,"あつ"],[52,1,"もの"]],"text":"アッスリヤの王よ、あなたの牧者は眠り、あなたの貴族はまどろむ。あなたの民は山の上に散らされ、これを集める者はない。"},{"ref":"Nah.3.19","start":34003019,"end":34003019,"break":"line","breaks":[[17,"line"],[26,"line"],[40,"line"],[54,"line"],[76,"line"]],"ruby":[[4,1,"やぶ"],[21,1,"きず"],[23,1,"おも"],[34,1,"き"],[36,1,"もの"],[38,1,"みな"],[44,1,"こと"],[49,1,"て"],[51,1,"う"],[58,1,"あく"],[60,1,"つね"],[62,1,"み"],[64,1,"う"],[73,1,"もの"]],"text":"あなたの破れは、いえることがなく、あなたの傷は重い。あなたのうわさを聞く者は皆、あなたの事について手を打つ。あなたの悪を常に身に受けなかったような者が、だれひとりあるか。"}]