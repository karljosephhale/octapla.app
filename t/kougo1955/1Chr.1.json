[{"ref":"1Chr.1.1","start":13001001,"end":13001001,"break":"paragraph","text":"アダム、セツ、エノス、"},{"ref":"1Chr.1.2","start":13001002,"end":13001002,"break":"none","text":"ケナン、マハラレル、ヤレド、"},{"ref":"1Chr.1.3","start":13001003,"end":13001003,"break":"none","text":"エノク、メトセラ、ラメク、"},{"ref":"1Chr.1.4","start":13001004,"end":13001004,"break":"none","text":"ノア、セム、ハム、ヤペテ。"},{"ref":"1Chr.1.5","start":13001005,"end":13001005,"break":"paragraph","ruby":[[4,1,"こ"]],"text":"ヤペテの子らはゴメル、マゴグ、マダイ、ヤワン、トバル、メセク、テラス。"},{"ref":"1Chr.1.6","start":13001006,"end":13001006,"break":"none","ruby":[[4,1,"こ"]],"text":"ゴメルの子らはアシケナズ、デパテ、トガルマ。"},{"ref":"1Chr.1.7","start":13001007,"end":13001007,"break":"none","ruby":[[4,1,"こ"]],"text":"ヤワンの子らはエリシャ、タルシシ、キッテム、ロダニム。"},{"ref":"1Chr.1.8","start":13001008,"end":13001008,"break":"paragraph","ruby":[[3,1,"こ"]],"text":"ハムの子らはクシ、エジプト、プテ、カナン。"},{"ref":"1Chr.1.9","start":13001009,"end":13001009,"break":"none","ruby":[[3,1,"こ"],[30,1,"こ"]],"text":"クシの子らはセバ、ハビラ、サブタ、ラアマ、サブテカ。ラアマの子らはシバとデダン。"},{"ref":"1Chr.1.10","start":13001010,"end":13001010,"break":"none","ruby":[[8,1,"う"],[17,1,"はじ"],[20,1,"よ"],[22,2,"けんりょく"],[26,1,"もの"]],"text":"クシはニムロデを生んだ。ニムロデは初めて世の権力ある者となった。"},{"ref":"1Chr.1.11","start":13001011,"end":13001011,"break":"paragraph","text":"エジプトはルデびと、アナムびと、レハブびと、ナフトびと、"},{"ref":"1Chr.1.12","start":13001012,"end":13001012,"break":"none","ruby":[[20,1,"う"],[39,1,"で"]],"text":"パテロスびと、カスルびと、カフトルびとを生んだ。カフトルびとからペリシテびとが出た。"},{"ref":"1Chr.1.13","start":13001013,"end":13001013,"break":"paragraph","ruby":[[4,2,"ちょうし"],[13,1,"う"]],"text":"カナンは長子シドンとヘテを生んだ。"},{"ref":"1Chr.1.14","start":13001014,"end":13001014,"break":"none","text":"またエブスびと、アモリびと、ギルガシびと、"},{"ref":"1Chr.1.15","start":13001015,"end":13001015,"break":"none","text":"ヒビびと、アルキびと、セニびと、"},{"ref":"1Chr.1.16","start":13001016,"end":13001016,"break":"none","ruby":[[19,1,"う"]],"text":"アルワデびと、ゼマリびと、ハマテびとを生んだ。"},{"ref":"1Chr.1.17","start":13001017,"end":13001017,"break":"paragraph","ruby":[[3,1,"こ"]],"text":"セムの子らはエラム、アシュル、アルパクサデ、ルデ、アラム、ウズ、ホル、ゲテル、メセクである。"},{"ref":"1Chr.1.18","start":13001018,"end":13001018,"break":"none","ruby":[[10,1,"う"],[20,1,"う"]],"text":"アルパクサデはシラを生み、シラはエベルを生んだ。"},{"ref":"1Chr.1.19","start":13001019,"end":13001019,"break":"none","ruby":[[8,1,"こ"],[10,1,"うま"],[18,1,"な"],[25,1,"かれ"],[27,1,"よ"],[29,1,"ち"],[31,1,"たみ"],[33,1,"ち"],[35,1,"わか"],[47,1,"おとうと"],[49,1,"な"]],"text":"エベルにふたりの子が生れた。ひとりの名はペレグ――彼の代に地の民が散り分れたからである――その弟の名はヨクタンといった。"},{"ref":"1Chr.1.20","start":13001020,"end":13001020,"break":"none","text":"ヨクタンはアルモダデ、シャレフ、ハザル・マウテ、エラ、"},{"ref":"1Chr.1.21","start":13001021,"end":13001021,"break":"none","text":"ハドラム、ウザル、デクラ、"},{"ref":"1Chr.1.22","start":13001022,"end":13001022,"break":"none","text":"エバル、アビマエル、シバ、"},{"ref":"1Chr.1.23","start":13001023,"end":13001023,"break":"none","ruby":[[12,1,"う"],[27,1,"こ"]],"text":"オフル、ハビラ、ヨバブを生んだ。これらはみなヨクタンの子である。"},{"ref":"1Chr.1.24","start":13001024,"end":13001024,"break":"paragraph","text":"セム、アルパクサデ、シラ、"},{"ref":"1Chr.1.25","start":13001025,"end":13001025,"break":"none","text":"エベル、ペレグ、リウ、"},{"ref":"1Chr.1.26","start":13001026,"end":13001026,"break":"none","text":"セルグ、ナホル、テラ、"},{"ref":"1Chr.1.27","start":13001027,"end":13001027,"break":"none","text":"アブラムすなわちアブラハムである。"},{"ref":"1Chr.1.28","start":13001028,"end":13001028,"break":"paragraph","ruby":[[6,1,"こ"]],"text":"アブラハムの子らはイサクとイシマエルである。"},{"ref":"1Chr.1.29","start":13001029,"end":13001029,"break":"none","ruby":[[0,1,"かれ"],[3,2,"しそん"],[6,1,"つぎ"],[21,2,"ちょうし"],[29,1,"つぎ"]],"text":"彼らの子孫は次のとおりである。イシマエルの長子はネバヨテ、次はケダル、アデビエル、ミブサム、"},{"ref":"1Chr.1.30","start":13001030,"end":13001030,"break":"none","text":"ミシマ、ドマ、マッサ、ハダデ、テマ、"},{"ref":"1Chr.1.31","start":13001031,"end":13001031,"break":"none","ruby":[[22,2,"しそん"]],"text":"エトル、ネフシ、ケデマ。これらはイシマエルの子孫である。"},{"ref":"1Chr.1.32","start":13001032,"end":13001032,"break":"none","ruby":[[13,2,"しそん"],[16,1,"つぎ"],[25,2,"かのじょ"],[57,1,"う"],[67,1,"こ"]],"text":"アブラハムのそばめケトラの子孫は次のとおりである。彼女はジムラン、ヨクシャン、メダン、ミデアン、イシバク、シュワを産んだ。ヨクシャンの子らはシバとデダンである。"},{"ref":"1Chr.1.33","start":13001033,"end":13001033,"break":"none","ruby":[[5,1,"こ"],[38,2,"しそん"]],"text":"ミデアンの子らはエパ、エペル、ヘノク、アビダ、エルダア。これらはみなケトラの子孫である。"},{"ref":"1Chr.1.34","start":13001034,"end":13001034,"break":"paragraph","ruby":[[10,1,"う"],[18,1,"こ"]],"text":"アブラハムはイサクを生んだ。イサクの子らはエサウとイスラエル。"},{"ref":"1Chr.1.35","start":13001035,"end":13001035,"break":"none","ruby":[[4,1,"こ"]],"text":"エサウの子らはエリパズ、リウエル、エウシ、ヤラム、コラ。"},{"ref":"1Chr.1.36","start":13001036,"end":13001036,"break":"none","ruby":[[5,1,"こ"]],"text":"エリパズの子らはテマン、オマル、ゼピ、ガタム、ケナズ、テムナ、アマレク。"},{"ref":"1Chr.1.37","start":13001037,"end":13001037,"break":"none","ruby":[[5,1,"こ"]],"text":"リウエルの子らはナハテ、ゼラ、シャンマ、ミッザ。"},{"ref":"1Chr.1.38","start":13001038,"end":13001038,"break":"paragraph","ruby":[[4,1,"こ"]],"text":"セイルの子らはロタン、ショバル、ヂベオン、アナ、デション、エゼル、デシャン。"},{"ref":"1Chr.1.39","start":13001039,"end":13001039,"break":"none","ruby":[[4,1,"こ"],[18,1,"いもうと"]],"text":"ロタンの子らはホリとホマム。ロタンの妹はテムナ。"},{"ref":"1Chr.1.40","start":13001040,"end":13001040,"break":"none","ruby":[[5,1,"こ"],[34,1,"こ"]],"text":"ショバルの子らはアルヤン、マナハテ、エバル、シピ、オナム。ヂベオンの子らはアヤとアナ。"},{"ref":"1Chr.1.41","start":13001041,"end":13001041,"break":"none","ruby":[[3,1,"こ"],[15,1,"こ"]],"text":"アナの子はデション。デションの子らはハムラン、エシバン、イテラン、ケラン。"},{"ref":"1Chr.1.42","start":13001042,"end":13001042,"break":"none","ruby":[[4,1,"こ"],[25,1,"こ"]],"text":"エゼルの子らはビルハン、ザワン、ヤカン。デシャンの子らはウズとアラン。"},{"ref":"1Chr.1.43","start":13001043,"end":13001043,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,1,"おさ"],[12,1,"おう"],[20,1,"とき"],[26,1,"ち"],[28,1,"おさ"],[31,1,"おう"],[35,1,"つぎ"],[48,1,"こ"],[54,1,"みやこ"],[56,1,"な"]],"text":"イスラエルの人々を治める王がまだなかった時、エドムの地を治めた王たちは次のとおりである。ベオルの子ベラ。その都の名はデナバといった。"},{"ref":"1Chr.1.44","start":13001044,"end":13001044,"break":"none","ruby":[[3,1,"し"],[14,1,"こ"],[19,1,"かわ"],[22,1,"おう"]],"text":"ベラが死んで、ボズラのゼラの子ヨバブが代って王となった。"},{"ref":"1Chr.1.45","start":13001045,"end":13001045,"break":"none","ruby":[[4,1,"し"],[14,1,"ち"],[21,1,"かわ"],[24,1,"おう"]],"text":"ヨバブが死んで、テマンびとの地のホシャムが代って王となった。"},{"ref":"1Chr.1.46","start":13001046,"end":13001046,"break":"none","ruby":[[5,1,"し"],[13,1,"こ"],[18,1,"かわ"],[21,1,"おう"],[27,1,"かれ"],[33,1,"の"],[40,1,"う"],[44,1,"かれ"],[46,1,"みやこ"],[48,1,"な"]],"text":"ホシャムが死んで、ベダテの子ハダデが代って王となった。彼はモアブの野でミデアンを撃った。彼の都の名はアビテといった。"},{"ref":"1Chr.1.47","start":13001047,"end":13001047,"break":"none","ruby":[[4,1,"し"],[17,1,"かわ"],[20,1,"おう"]],"text":"ハダデが死んで、マスレカのサムラが代って王となった。"},{"ref":"1Chr.1.48","start":13001048,"end":13001048,"break":"none","ruby":[[4,1,"し"],[12,1,"かわ"],[27,1,"かわ"],[30,1,"おう"]],"text":"サムラが死んで、ユフラテ川のほとりのレホボテのサウルが代って王となった。"},{"ref":"1Chr.1.49","start":13001049,"end":13001049,"break":"none","ruby":[[4,1,"し"],[13,1,"こ"],[22,1,"かわ"],[25,1,"おう"]],"text":"サウルが死んで、アクボルの子バアル・ハナンが代って王となった。"},{"ref":"1Chr.1.50","start":13001050,"end":13001050,"break":"none","ruby":[[8,1,"し"],[16,1,"かわ"],[19,1,"おう"],[25,1,"かれ"],[27,1,"みやこ"],[29,1,"な"],[38,1,"かれ"],[40,1,"つま"],[47,1,"むすめ"],[53,1,"な"],[75,1,"むすめ"]],"text":"バアル・ハナンが死んで、ハダデが代って王となった。彼の都の名はパイといった。彼の妻はマテレデの娘であって、名をメヘタベルといった。マテレデはメザハブの娘である。"},{"ref":"1Chr.1.51","start":13001051,"end":13001051,"break":"none","breaks":[[8,"paragraph"]],"ruby":[[4,1,"し"],[12,2,"ぞくちょう"],[19,1,"こう"],[24,1,"こう"],[29,1,"こう"]],"text":"ハダデも死んだ。エドムの族長は、テムナ侯、アルヤ侯、エテテ侯、"},{"ref":"1Chr.1.52","start":13001052,"end":13001052,"break":"none","ruby":[[5,1,"こう"],[9,1,"こう"],[14,1,"こう"]],"text":"アホリバマ侯、エラ侯、ピノン侯、"},{"ref":"1Chr.1.53","start":13001053,"end":13001053,"break":"none","ruby":[[3,1,"こう"],[8,1,"こう"],[14,1,"こう"]],"text":"ケナズ侯、テマン侯、ミブザル侯、"},{"ref":"1Chr.1.54","start":13001054,"end":13001054,"break":"none","ruby":[[5,1,"こう"],[10,1,"こう"],[20,2,"ぞくちょう"]],"text":"マグデエル侯、イラム侯。これらはエドムの族長である。"}]