[{"ref":"Jer.17.1","start":24017001,"end":24017001,"break":"paragraph","ruby":[[4,1,"つみ"],[7,1,"てつ"],[9,1,"ふで"],[11,3,"こんごうせき"],[27,1,"かれ"],[30,1,"こころ"],[32,1,"いしぶみ"],[35,2,"さいだん"],[38,1,"つの"],[40,1,"ほ"]],"text":"「ユダの罪は、鉄の筆、金剛石のとがりをもってしるされ、彼らの心の碑と、祭壇の角に彫りつけられている。"},{"ref":"Jer.17.2","start":24017002,"end":24017002,"break":"none","ruby":[[0,1,"かれ"],[3,2,"こども"],[8,1,"あお"],[9,1,"き"],[11,1,"した"],[14,1,"たか"],[16,1,"おか"],[18,1,"うえ"],[20,1,"の"],[22,1,"やま"],[24,1,"うえ"],[28,2,"さいだん"],[38,1,"おぼ"]],"text":"彼らの子供たちは青木の下と、高い丘の上、野の山の上にある祭壇とアシラのことを覚えている。"},{"ref":"Jer.17.3","start":24017003,"end":24017003,"break":"none","ruby":[[8,1,"とみ"],[14,1,"たから"],[22,1,"ぜん"],[23,2,"りょういき"],[26,1,"うち"],[28,1,"おか"],[31,1,"つみ"],[33,2,"だいか"],[43,1,"もの"]],"text":"わたしはあなたの富とすべての宝とを、あなたの全領域の内で犯した罪の代価として、ぶんどり物とならせる。"},{"ref":"Jer.17.4","start":24017004,"end":24017004,"break":"none","ruby":[[8,1,"あた"],[11,1,"し"],[12,1,"ぎょう"],[19,1,"て"],[41,1,"し"],[45,1,"ち"],[52,1,"てき"],[54,1,"つか"],[64,1,"いか"],[71,1,"ひ"],[73,1,"てん"],[83,1,"も"],[85,1,"つづ"]],"text":"わたしがあなたに与えた嗣業からあなたは手をはなすようになる。またわたしは、あなたの知らない地で、あなたの敵に仕えさせる。わたしの怒りによって、火は点じられ、いつまでも燃え続けるからである」。"},{"ref":"Jer.17.5","start":24017005,"end":24017005,"break":"paragraph","breaks":[[9,"stanza"],[32,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[14,1,"ひと"],[16,1,"たの"],[20,1,"にく"],[23,1,"もの"],[25,2,"じぶん"],[28,1,"うで"],[34,1,"こころ"],[36,1,"しゅ"],[38,1,"はな"],[43,1,"ひと"]],"text":"主はこう言われる、「おおよそ人を頼みとし肉なる者を自分の腕とし、その心が主を離れている人は、のろわれる。"},{"ref":"Jer.17.6","start":24017006,"end":24017006,"break":"line","breaks":[[16,"line"],[31,"line"],[45,"line"]],"ruby":[[0,1,"かれ"],[2,2,"あらの"],[5,1,"そだ"],[7,1,"ちい"],[10,1,"き"],[16,1,"なに"],[18,1,"よ"],[23,1,"く"],[27,1,"み"],[31,2,"あらの"],[35,2,"ひあ"],[40,1,"ところ"],[42,1,"す"],[45,1,"ひと"],[47,1,"す"],[51,1,"しお"],[52,1,"ち"]],"text":"彼は荒野に育つ小さい木のように、何も良いことの来るのを見ない。荒野の、干上がった所に住み、人の住まない塩地にいる。"},{"ref":"Jer.17.7","start":24017007,"end":24017007,"break":"line","breaks":[[10,"line"]],"ruby":[[4,1,"しゅ"],[10,1,"しゅ"],[12,1,"たの"],[17,1,"ひと"]],"text":"おおよそ主にたより、主を頼みとする人はさいわいである。"},{"ref":"Jer.17.8","start":24017008,"end":24017008,"break":"line","breaks":[[17,"line"],[27,"line"],[43,"line"],[52,"line"],[67,"line"]],"ruby":[[0,1,"かれ"],[2,1,"みず"],[8,1,"う"],[11,1,"き"],[19,1,"ね"],[21,1,"かわ"],[27,1,"あつ"],[34,1,"おそ"],[45,1,"は"],[47,1,"つね"],[49,1,"あお"],[56,1,"ねん"],[59,1,"うれ"],[67,1,"た"],[70,1,"み"],[72,1,"むす"]],"text":"彼は水のほとりに植えた木のようで、その根を川にのばし、暑さにあっても恐れることはない。その葉は常に青く、ひでりの年にも憂えることなく、絶えず実を結ぶ」。"},{"ref":"Jer.17.9","start":24017009,"end":24017009,"break":"stanza","breaks":[[16,"line"],[31,"line"]],"ruby":[[0,1,"こころ"],[6,1,"もの"],[10,1,"いつわ"],[22,1,"あく"],[24,1,"そ"],[40,1,"し"]],"text":"心はよろずの物よりも偽るもので、はなはだしく悪に染まっている。だれがこれを、よく知ることができようか。"},{"ref":"Jer.17.10","start":24017010,"end":24017010,"break":"line","breaks":[[21,"line"],[36,"line"]],"ruby":[[1,1,"しゅ"],[9,1,"こころ"],[11,1,"さぐ"],[14,1,"おも"],[17,1,"こころ"],[29,1,"みち"],[38,1,"おこな"],[41,1,"み"],[46,1,"むく"]],"text":"「主であるわたしは心を探り、思いを試みる。おのおのに、その道にしたがい、その行いの実によって報いをするためである」。"},{"ref":"Jer.17.11","start":24017011,"end":24017011,"break":"stanza","breaks":[[23,"line"],[36,"line"],[54,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"う"],[15,1,"たまご"],[17,1,"だ"],[23,2,"ふせい"],[26,2,"ざいさん"],[29,1,"え"],[31,1,"もの"],[38,1,"ひと"],[40,2,"いっしょう"],[43,1,"なか"],[50,1,"はな"],[56,1,"おわ"],[60,1,"おろ"],[63,1,"もの"]],"text":"しゃこが自分が産んだのではない卵を抱くように、不正な財産を得る者がある。その人は一生の半ばにそれから離れて、その終りには愚かな者となる。"},{"ref":"Jer.17.12","start":24017012,"end":24017012,"break":"stanza","breaks":[[19,"line"]],"ruby":[[0,1,"はじ"],[4,1,"たか"],[11,1,"さか"],[16,1,"ざ"],[24,2,"せいじょ"],[29,1,"ところ"]],"text":"初めから高くあげられた栄えあるみ座は、われわれの聖所のある所である。"},{"ref":"Jer.17.13","start":24017013,"end":24017013,"break":"line","breaks":[[16,"line"],[32,"line"],[52,"line"]],"ruby":[[8,1,"のぞ"],[13,1,"しゅ"],[20,1,"す"],[23,1,"もの"],[27,1,"はじ"],[36,1,"はな"],[39,1,"もの"],[41,1,"つち"],[43,1,"な"],[55,1,"い"],[58,1,"みず"],[60,1,"みなもと"],[64,1,"しゅ"],[66,1,"す"]],"text":"またイスラエルの望みである主よ、あなたを捨てる者はみな恥をかき、あなたを離れる者は土に名をしるされます。それは生ける水の源である主を捨てたからです。"},{"ref":"Jer.17.14","start":24017014,"end":24017014,"break":"stanza","breaks":[[16,"line"],[31,"line"],[43,"line"],[59,"line"]],"ruby":[[0,1,"しゅ"],[36,1,"すく"],[53,1,"すく"],[73,1,"もの"]],"text":"主よ、わたしをいやしてください、そうすれば、わたしはいえます。わたしをお救いください、そうすれば、わたしは救われます。あなたはわたしのほめたたえる者だからです。"},{"ref":"Jer.17.15","start":24017015,"end":24017015,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"かれ"],[7,1,"い"],[13,1,"しゅ"],[15,2,"ことば"],[26,1,"いま"],[31,1,"だ"],[34,1,"み"]],"text":"彼らはわたしに言います、「主の言葉はどこにあるのか。今、それを出して見せよ」と。"},{"ref":"Jer.17.16","start":24017016,"end":24017016,"break":"line","breaks":[[14,"line"],[30,"line"],[45,"line"],[56,"line"]],"ruby":[[0,1,"あく"],[21,1,"もと"],[32,1,"わざわい"],[34,1,"ひ"],[36,1,"ねが"],[66,1,"で"],[73,1,"まえ"]],"text":"悪をつかわされるようにとは、わたしはたって求めませんでした。また災の日を願わなかったのを、あなたはごぞんじです。わたしのくちびるから出たことは、み前にあります。"},{"ref":"Jer.17.17","start":24017017,"end":24017017,"break":"line","breaks":[[20,"line"]],"ruby":[[8,1,"おそ"],[20,1,"わざわい"],[37,1,"ば"]],"text":"どうか、わたしを恐れさせないでください。災のときに、あなたはわたしののがれ場です。"},{"ref":"Jer.17.18","start":24017018,"end":24017018,"break":"line","breaks":[[22,"line"],[42,"line"],[55,"line"],[74,"line"],[86,"line"]],"ruby":[[4,1,"せ"],[6,1,"なや"],[9,1,"もの"],[42,1,"かれ"],[45,1,"おそ"],[62,1,"おそ"],[74,1,"わざわい"],[76,1,"ひ"],[78,1,"かれ"],[86,1,"ほろ"],[89,1,"ばい"],[93,1,"かれ"],[96,1,"ほろ"]],"text":"わたしを攻め悩ます者をはずかしめてください。しかしわたしをはずかしめないでください。彼らを恐れさせてください。しかしわたしを恐れさせないでください。災の日を彼らにきたらせ、滅びを倍にして彼らを滅ぼしてください。"},{"ref":"Jer.17.19","start":24017019,"end":24017019,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[14,1,"い"],[21,1,"おう"],[25,2,"でい"],[36,1,"もん"],[51,1,"もん"],[53,1,"た"]],"text":"主はわたしにこう言われた、「行って、ユダの王たちの出入りするベニヤミンの門、およびエルサレムのすべての門に立って、"},{"ref":"Jer.17.20","start":24017020,"end":24017020,"break":"none","ruby":[[0,1,"い"],[11,1,"もん"],[20,1,"おう"],[34,1,"たみ"],[42,1,"す"],[48,1,"もの"],[51,1,"しゅ"],[53,2,"ことば"],[56,1,"き"]],"text":"言いなさい、『これらの門からはいるユダの王たち、およびユダのすべての民とエルサレムに住むすべての者よ、主の言葉を聞きなさい。"},{"ref":"Jer.17.21","start":24017021,"end":24017021,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"い"],[9,1,"いのち"],[11,1,"お"],[17,1,"き"],[26,3,"あんそくにち"],[30,1,"に"],[43,1,"も"],[52,1,"もん"]],"text":"主はこう言われる、命が惜しいならば気をつけるがよい。安息日に荷をたずさえ、またはそれを持ってエルサレムの門にはいってはならない。"},{"ref":"Jer.17.22","start":24017022,"end":24017022,"break":"none","ruby":[[2,3,"あんそくにち"],[12,1,"いえ"],[15,1,"に"],[17,1,"はこ"],[19,1,"だ"],[53,2,"せんぞ"],[56,1,"めい"],[62,3,"あんそくにち"],[66,2,"せいべつ"],[70,1,"まも"]],"text":"また安息日にあなたがたの家から荷を運び出してはならない。なんのわざをもしてはならない。わたしがあなたがたの先祖に命じたように安息日を聖別して守りなさい。"},{"ref":"Jer.17.23","start":24017023,"end":24017023,"break":"none","ruby":[[3,1,"かれ"],[6,1,"したが"],[9,1,"みみ"],[11,1,"かたむ"],[15,1,"き"],[21,1,"いまし"],[31,2,"ごうじょう"],[34,1,"こば"]],"text":"しかし彼らは従わず耳を傾けず、聞くことも、戒めをうけることをも強情に拒んだ。"},{"ref":"Jer.17.24","start":24017024,"end":24017024,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[19,1,"き"],[21,1,"したが"],[24,3,"あんそくにち"],[28,1,"に"],[37,1,"まち"],[39,1,"もん"],[46,3,"あんそくにち"],[50,2,"せいべつ"]],"text":"主は言われる、もしあなたがたがわたしに聞き従い、安息日に荷をたずさえてこの町の門にはいらず、安息日を聖別して、なんのわざをもしないならば、"},{"ref":"Jer.17.25","start":24017025,"end":24017025,"break":"none","ruby":[[4,1,"くらい"],[6,1,"ざ"],[9,1,"おう"],[22,2,"ひとびと"],[31,1,"す"],[33,1,"もの"],[36,1,"くるま"],[38,1,"うま"],[40,1,"の"],[45,1,"まち"],[47,1,"もん"],[65,1,"まち"],[68,1,"なが"],[70,1,"ひと"],[72,1,"す"]],"text":"ダビデの位に座する王たち、つかさたち、ユダの人々、エルサレムに住む者は、車と馬に乗ってこの町の門からはいることができる。そしてこの町には長く人が住むようになる。"},{"ref":"Jer.17.26","start":24017026,"end":24017026,"break":"none","ruby":[[2,2,"ひとびと"],[8,2,"まちまち"],[17,2,"しゅうい"],[26,1,"ち"],[28,2,"へいち"],[31,2,"さんち"],[41,1,"き"],[43,2,"はんさい"],[46,2,"ぎせい"],[49,2,"そさい"],[52,2,"にゅうこう"],[55,3,"かんしゃさい"],[64,1,"しゅ"],[66,1,"いえ"]],"text":"また人々はユダの町々やエルサレムの周囲、ベニヤミンの地、平地と山地およびネゲブから来て燔祭、犠牲、素祭、乳香、感謝祭をたずさえて主の家にはいる。"},{"ref":"Jer.17.27","start":24017027,"end":24017027,"break":"none","ruby":[[16,1,"き"],[18,1,"したが"],[24,3,"あんそくにち"],[28,2,"せいべつ"],[32,1,"まも"],[40,3,"あんそくにち"],[44,1,"に"],[57,1,"もん"],[70,1,"ひ"],[74,1,"もん"],[76,1,"なか"],[78,1,"も"],[94,2,"きゅうでん"],[97,1,"や"],[99,1,"ほろ"],[105,1,"ひ"],[107,1,"き"]],"text":"しかし、もしあなたがたがわたしに聞き従わないで、安息日を聖別して守ることをせず、安息日に荷をたずさえてエルサレムの門にはいるならば、わたしは火をその門の中に燃やして、エルサレムのもろもろの宮殿を焼き滅ぼす。その火は消えることがない』」。"}]