[{"ref":"Ezek.17.1","start":26017001,"end":26017001,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,2,"ことば"],[11,1,"のぞ"]],"text":"時に主の言葉がわたしに臨んだ、"},{"ref":"Ezek.17.2","start":26017002,"end":26017002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[12,1,"いえ"],[24,1,"かた"]],"text":"「人の子よ、イスラエルの家になぞをかけ、たとえを語って、"},{"ref":"Ezek.17.3","start":26017003,"end":26017003,"break":"none","ruby":[[0,1,"い"],[3,1,"しゅ"],[6,1,"かみ"],[10,1,"い"],[20,1,"いろ"],[22,2,"うもう"],[25,1,"おお"],[27,1,"も"],[30,1,"おお"],[33,1,"つばさ"],[36,1,"なが"],[38,2,"はね"],[42,1,"も"],[44,1,"おお"],[53,1,"き"],[56,2,"こうはく"]],"text":"言え。主なる神がこう言われる、さまざまの色の羽毛を多く持ち、大きな翼と、長い羽根とを持つ大わしがレバノンに来て、香柏のこずえにとまり、"},{"ref":"Ezek.17.4","start":26017004,"end":26017004,"break":"none","ruby":[[2,1,"わか"],[3,1,"えだ"],[5,1,"いただき"],[7,1,"つ"],[9,1,"き"],[15,2,"しょうぎょう"],[18,1,"ち"],[20,1,"はこ"],[23,2,"しょうにん"],[26,1,"まち"],[28,1,"お"]],"text":"その若枝の頂を摘み切り、これを商業の地に運び、商人の町に置いた。"},{"ref":"Ezek.17.5","start":26017005,"end":26017005,"break":"none","ruby":[[4,1,"ち"],[6,1,"たね"],[15,1,"こ"],[18,1,"つち"],[20,1,"う"],[28,1,"みず"],[30,1,"おお"],[32,1,"ところ"],[37,1,"い"],[41,1,"やなぎ"],[43,1,"う"],[52,1,"う"]],"text":"またその地の種をとって、これを肥えた土に植えた。すなわち水の多い所にもって行って、柳を植えるようにこれを植えた。"},{"ref":"Ezek.17.6","start":26017006,"end":26017006,"break":"none","ruby":[[3,2,"せいちょう"],[10,1,"ひく"],[21,1,"き"],[26,1,"えだ"],[31,1,"む"],[35,1,"ね"],[40,1,"した"],[56,1,"き"],[61,1,"えだ"],[63,1,"の"],[67,1,"は"],[69,1,"だ"]],"text":"これが成長して、たけ低く、はびこるぶどうの木となり、枝はわしに向かい、根はわしの下にあり、こうしてついにぶどうの木となり、枝を伸ばし、葉を出した。"},{"ref":"Ezek.17.7","start":26017007,"end":26017007,"break":"paragraph","ruby":[[5,1,"おお"],[8,1,"つばさ"],[11,2,"うもう"],[14,1,"おお"],[20,1,"わ"],[22,1,"おお"],[30,1,"み"],[39,1,"き"],[42,1,"うるお"],[45,1,"え"],[53,1,"ね"],[58,1,"む"],[67,1,"えだ"],[72,1,"む"],[76,1,"の"]],"text":"ここにまた大きな翼と、羽毛の多いほかの一羽の大わしがあった。見よ、このぶどうの木は、潤いを得るために、その根をわしに向かってまげ、その枝をわしに向かって伸ばした。"},{"ref":"Ezek.17.8","start":26017008,"end":26017008,"break":"none","ruby":[[3,1,"えだ"],[5,1,"だ"],[8,1,"み"],[10,1,"むす"],[21,1,"き"],[35,1,"う"],[38,2,"なえどこ"],[42,1,"みず"],[44,1,"おお"],[46,1,"よ"],[48,1,"ち"],[50,1,"うつ"],[52,1,"う"]],"text":"これが枝を出し、実を結び、みごとなぶどうの木となるために、わしはこれを植えた苗床から水の多い良い地に移し植えた。"},{"ref":"Ezek.17.9","start":26017009,"end":26017009,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[17,1,"い"],[23,1,"さか"],[37,1,"ね"],[39,1,"ぬ"],[44,1,"えだ"],[46,1,"き"],[51,2,"わかば"],[54,1,"みな"],[55,1,"か"],[71,1,"ね"],[80,1,"つよ"],[82,1,"うで"],[84,1,"おお"],[87,1,"たみ"],[89,2,"ひつよう"]],"text":"あなたは、主なる神がこう言われると言え、これは栄えるであろうか。わしはその根を抜き、その枝を切り、その若葉を皆枯らさないであろうか。これをその根からあげるには、強い腕や多くの民を必要としない。"},{"ref":"Ezek.17.10","start":26017010,"end":26017010,"break":"none","ruby":[[0,1,"み"],[6,1,"うつ"],[8,1,"う"],[17,1,"さか"],[26,2,"ひがしかぜ"],[32,1,"う"],[34,1,"とき"],[39,1,"か"],[55,1,"そだ"],[58,2,"なえどこ"],[61,1,"か"]],"text":"見よ、それが移し植えられたら、また栄えるであろうか。東風がこれを打つ時、それは枯れてしまわないであろうか。その育った苗床で枯れないであろうか」。"},{"ref":"Ezek.17.11","start":26017011,"end":26017011,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[11,1,"のぞ"]],"text":"主の言葉がまたわたしに臨んだ、"},{"ref":"Ezek.17.12","start":26017012,"end":26017012,"break":"none","ruby":[[1,2,"はんぎゃく"],[4,1,"いえ"],[6,1,"い"],[26,1,"し"],[33,1,"かれ"],[36,1,"い"],[39,1,"み"],[47,1,"おう"],[60,1,"おう"],[67,1,"とら"],[78,1,"ひ"],[81,1,"い"]],"text":"「反逆の家に言え。これらがなんであるかをあなたがたは知らないのか。彼らに言え、見よ、バビロンの王がエルサレムにきて、その王とつかさとを捕え、これをバビロンに引いて行った。"},{"ref":"Ezek.17.13","start":26017013,"end":26017013,"break":"none","ruby":[[2,1,"おう"],[4,2,"しそん"],[11,1,"とら"],[18,2,"けいやく"],[21,1,"むす"],[24,1,"ちか"],[27,1,"た"],[34,1,"くに"],[41,2,"ひとびと"],[44,1,"とら"],[47,1,"い"]],"text":"また王の子孫のひとりを捕えて、これと契約を結び、誓いを立てさせ、また国のおもだった人々を捕えて行った。"},{"ref":"Ezek.17.14","start":26017014,"end":26017014,"break":"none","ruby":[[5,1,"くに"],[7,1,"いや"],[17,1,"た"],[33,2,"けいやく"],[36,1,"まも"],[44,1,"た"]],"text":"これはこの国を卑しくして、みずから立つことができないようにし、その契約を守ることによって立たせるためである。"},{"ref":"Ezek.17.15","start":26017015,"end":26017015,"break":"none","ruby":[[3,1,"かれ"],[10,1,"おう"],[16,2,"ししゃ"],[24,1,"おく"],[28,1,"うま"],[30,1,"おお"],[33,1,"へい"],[40,1,"え"],[47,1,"かれ"],[49,2,"せいこう"],[68,1,"もの"]],"text":"しかし彼はバビロンの王にそむき、使者をエジプトに送って、馬と多くの兵とをそこから獲ようとした。彼は成功するだろうか。このようなことをなす者は、のがれることができようか。"},{"ref":"Ezek.17.16","start":26017016,"end":26017016,"break":"none","ruby":[[0,2,"けいやく"],[3,1,"やぶ"],[21,1,"しゅ"],[24,1,"かみ"],[26,1,"い"],[35,1,"い"],[41,1,"かなら"],[43,1,"かれ"],[45,2,"じぶん"],[48,1,"おう"],[53,1,"おう"],[55,1,"す"],[57,1,"ところ"],[59,1,"かれ"],[61,1,"た"],[64,1,"ちか"],[67,1,"かろ"],[73,2,"けいやく"],[76,1,"やぶ"],[79,2,"あいて"],[82,1,"おう"],[91,1,"かれ"],[93,1,"し"]],"text":"契約を破ってなおのがれることができようか。主なる神は言われる、わたしは生きている、必ず彼は自分を王となした王の住む所、彼が立てた誓いを軽んじ、その契約を破った相手の王のいるバビロンで彼は死ぬ。"},{"ref":"Ezek.17.17","start":26017017,"end":26017017,"break":"none","ruby":[[0,1,"おお"],[3,1,"いのち"],[5,1,"た"],[10,1,"るい"],[12,1,"きず"],[15,2,"うんてい"],[18,1,"た"],[27,1,"けっ"],[30,1,"おお"],[34,2,"ぐんぜい"],[38,1,"おお"],[41,1,"ひと"],[48,1,"かれ"],[50,1,"たす"],[53,1,"たたか"]],"text":"多くの命を断つために塁を築き、雲梯を建てるとき、パロは決して大いなる軍勢と、多くの人とをもって、彼を助けて戦いをしない。"},{"ref":"Ezek.17.18","start":26017018,"end":26017018,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ちか"],[5,1,"かろ"],[9,2,"けいやく"],[12,1,"やぶ"],[17,1,"て"],[19,1,"あた"],[22,1,"ちか"],[34,1,"こと"]],"text":"彼は誓いを軽んじ、契約を破り、その手を与えて誓いながら、なおこれらの事をしたゆえ、のがれることはできない。"},{"ref":"Ezek.17.19","start":26017019,"end":26017019,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[21,1,"い"],[27,1,"かれ"],[33,1,"ちか"],[36,1,"かろ"],[44,2,"けいやく"],[47,1,"やぶ"],[54,1,"かなら"],[56,1,"かれ"],[62,1,"むく"]],"text":"それゆえ、主なる神はこう言われる、わたしは生きている、彼がわたしの誓いを軽んじ、わたしの契約を破ったことを、必ず彼のこうべに報いる。"},{"ref":"Ezek.17.20","start":26017020,"end":26017020,"break":"none","ruby":[[6,1,"あみ"],[8,1,"かれ"],[10,1,"うえ"],[12,1,"う"],[17,1,"かれ"],[24,1,"とら"],[33,1,"ひ"],[36,1,"い"],[39,1,"かれ"],[49,1,"おか"],[52,2,"はんぎゃく"],[61,1,"ところ"],[63,1,"かれ"]],"text":"わたしはわが網を彼の上に打ちかけ、彼をわがわなに捕えて、バビロンに引いて行き、彼がわたしにむかって犯した反逆のために、その所で彼をさばく。"},{"ref":"Ezek.17.21","start":26017021,"end":26017021,"break":"none","ruby":[[0,1,"かれ"],[6,2,"ぐんたい"],[11,1,"ぬ"],[14,2,"へいし"],[17,1,"みな"],[22,1,"たお"],[25,1,"い"],[27,1,"のこ"],[30,1,"もの"],[32,2,"はっぽう"],[35,1,"ち"],[50,1,"しゅ"],[61,1,"かた"],[67,1,"し"]],"text":"彼のすべての軍隊のえり抜きの兵士は皆つるぎに倒れ、生き残った者は八方に散らされる。そしてあなたがたは主なるわたしが、これを語ったことを知るようになる」。"},{"ref":"Ezek.17.22","start":26017022,"end":26017022,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[19,2,"こうはく"],[22,1,"たか"],[29,1,"しょう"],[30,1,"えだ"],[39,1,"う"],[44,2,"わかめ"],[47,1,"いただき"],[50,1,"やわら"],[53,1,"め"],[55,1,"つ"],[63,1,"たか"],[69,1,"やま"],[71,1,"う"]],"text":"主なる神はこう言われる、「わたしはまた香柏の高いこずえから小枝をとって、これを植え、その若芽の頂から柔かい芽を摘みとり、これを高いすぐれた山に植える。"},{"ref":"Ezek.17.23","start":26017023,"end":26017023,"break":"none","ruby":[[10,1,"たか"],[12,1,"やま"],[17,1,"う"],[24,1,"えだ"],[26,1,"だ"],[29,1,"み"],[31,1,"むす"],[38,2,"こうはく"],[46,1,"した"],[53,2,"しゅるい"],[56,1,"けもの"],[58,1,"す"],[63,1,"えだ"],[65,1,"かげ"],[67,2,"かくしゅ"],[70,1,"とり"],[72,1,"す"]],"text":"わたしはイスラエルの高い山にこれを植える。これは枝を出し、実を結び、みごとな香柏となり、その下にもろもろの種類の獣が住み、その枝の陰に各種の鳥が巣をつくる。"},{"ref":"Ezek.17.24","start":26017024,"end":26017024,"break":"none","ruby":[[3,1,"の"],[9,1,"き"],[12,1,"しゅ"],[19,1,"たか"],[21,1,"き"],[23,1,"ひく"],[27,1,"ひく"],[29,1,"き"],[31,1,"たか"],[35,1,"みどり"],[37,1,"き"],[39,1,"か"],[43,1,"か"],[45,1,"き"],[47,1,"みどり"],[54,1,"し"],[62,1,"しゅ"],[73,1,"かた"]],"text":"そして野のすべての木は、主なるわたしが高い木を低くし、低い木を高くし、緑の木を枯らし、枯れ木を緑にすることを知るようになる。主であるわたしはこれを語り、これをするのである」。"}]