[{"ref":"Gen.17.1","start":1017001,"end":1017001,"break":"paragraph","breaks":[[27,"stanza"],[40,"line"]],"ruby":[[8,1,"さい"],[10,1,"とき"],[12,1,"しゅ"],[19,1,"あらわ"],[22,1,"い"],[32,2,"ぜんのう"],[35,1,"かみ"],[48,1,"まえ"],[50,1,"あゆ"],[53,1,"まった"],[55,1,"もの"]],"text":"アブラムの九十九歳の時、主はアブラムに現れて言われた、「わたしは全能の神である。あなたはわたしの前に歩み、全き者であれ。"},{"ref":"Gen.17.2","start":1017002,"end":1017002,"break":"line","breaks":[[14,"line"]],"ruby":[[8,2,"けいやく"],[11,1,"むす"],[14,1,"おお"],[21,2,"しそん"],[24,1,"ま"]],"text":"わたしはあなたと契約を結び、大いにあなたの子孫を増すであろう」。"},{"ref":"Gen.17.3","start":1017003,"end":1017003,"break":"none","ruby":[[8,1,"ふ"],[12,1,"かみ"],[16,1,"かれ"],[18,1,"い"]],"text":"アブラムは、ひれ伏した。神はまた彼に言われた、"},{"ref":"Gen.17.4","start":1017004,"end":1017004,"break":"stanza","breaks":[[15,"line"]],"ruby":[[9,2,"けいやく"],[12,1,"むす"],[19,1,"おお"],[22,2,"こくみん"],[25,1,"ちち"]],"text":"「わたしはあなたと契約を結ぶ。あなたは多くの国民の父となるであろう。"},{"ref":"Gen.17.5","start":1017005,"end":1017005,"break":"line","breaks":[[21,"line"],[42,"line"],[56,"line"]],"ruby":[[4,1,"な"],[16,1,"い"],[25,1,"な"],[33,1,"よ"],[50,1,"おお"],[53,2,"こくみん"],[56,1,"ちち"]],"text":"あなたの名は、もはやアブラムとは言われず、あなたの名はアブラハムと呼ばれるであろう。わたしはあなたを多くの国民の父とするからである。"},{"ref":"Gen.17.6","start":1017006,"end":1017006,"break":"none","ruby":[[8,1,"おお"],[11,2,"しそん"],[14,1,"え"],[18,2,"くにぐに"],[21,1,"たみ"],[28,1,"おこ"],[35,1,"おう"],[44,1,"で"]],"text":"わたしはあなたに多くの子孫を得させ、国々の民をあなたから起そう。また、王たちもあなたから出るであろう。"},{"ref":"Gen.17.7","start":1017007,"end":1017007,"break":"none","ruby":[[7,1,"およ"],[9,1,"のち"],[11,2,"よよ"],[14,2,"しそん"],[17,2,"けいやく"],[20,1,"た"],[24,2,"えいえん"],[27,2,"けいやく"],[36,1,"のち"],[38,2,"しそん"],[42,1,"かみ"]],"text":"わたしはあなた及び後の代々の子孫と契約を立てて、永遠の契約とし、あなたと後の子孫との神となるであろう。"},{"ref":"Gen.17.8","start":1017008,"end":1017008,"break":"none","ruby":[[8,1,"のち"],[10,2,"しそん"],[18,1,"やど"],[25,1,"ち"],[35,1,"ぜん"],[36,1,"ち"],[38,2,"えいきゅう"],[41,2,"しょゆう"],[46,1,"あた"],[57,1,"かれ"],[60,1,"かみ"]],"text":"わたしはあなたと後の子孫とにあなたの宿っているこの地、すなわちカナンの全地を永久の所有として与える。そしてわたしは彼らの神となるであろう」。"},{"ref":"Gen.17.9","start":1017009,"end":1017009,"break":"paragraph","ruby":[[0,1,"かみ"],[10,1,"い"],[20,1,"のち"],[22,2,"しそん"],[26,1,"とも"],[28,2,"よよ"],[34,2,"けいやく"],[37,1,"まも"]],"text":"神はまたアブラハムに言われた、「あなたと後の子孫とは共に代々わたしの契約を守らなければならない。あなたがたのうち"},{"ref":"Gen.17.10","start":1017010,"end":1017010,"break":"none","ruby":[[0,2,"だんし"],[5,2,"かつれい"],[31,1,"およ"],[33,1,"のち"],[35,2,"しそん"],[39,1,"あいだ"],[45,2,"けいやく"],[58,1,"まも"]],"text":"男子はみな割礼をうけなければならない。これはわたしとあなたがた及び後の子孫との間のわたしの契約であって、あなたがたの守るべきものである。"},{"ref":"Gen.17.11","start":1017011,"end":1017011,"break":"none","ruby":[[6,1,"まえ"],[8,1,"かわ"],[10,2,"かつれい"],[13,1,"う"],[38,1,"あいだ"],[40,2,"けいやく"]],"text":"あなたがたは前の皮に割礼を受けなければならない。それがわたしとあなたがたとの間の契約のしるしとなるであろう。"},{"ref":"Gen.17.12","start":1017012,"end":1017012,"break":"none","ruby":[[9,2,"だんし"],[14,2,"よよ"],[17,1,"いえ"],[19,1,"うま"],[22,1,"もの"],[27,3,"いほうじん"],[32,1,"ぎん"],[34,1,"か"],[36,1,"と"],[44,2,"しそん"],[49,1,"もの"],[52,1,"うま"],[56,1,"か"],[57,1,"め"],[59,2,"かつれい"],[62,1,"う"]],"text":"あなたがたのうちの男子はみな代々、家に生れた者も、また異邦人から銀で買い取った、あなたの子孫でない者も、生れて八日目に割礼を受けなければならない。"},{"ref":"Gen.17.13","start":1017013,"end":1017013,"break":"none","ruby":[[4,1,"いえ"],[6,1,"うま"],[9,1,"もの"],[16,1,"ぎん"],[18,1,"か"],[20,1,"と"],[23,1,"もの"],[25,1,"かなら"],[27,2,"かつれい"],[30,1,"う"],[49,2,"けいやく"],[58,1,"み"],[63,2,"えいえん"],[66,2,"けいやく"]],"text":"あなたの家に生れた者も、あなたが銀で買い取った者も必ず割礼を受けなければならない。こうしてわたしの契約はあなたがたの身にあって永遠の契約となるであろう。"},{"ref":"Gen.17.14","start":1017014,"end":1017014,"break":"none","ruby":[[0,2,"かつれい"],[3,1,"う"],[7,2,"だんし"],[14,1,"まえ"],[16,1,"かわ"],[18,1,"き"],[22,1,"もの"],[28,2,"けいやく"],[31,1,"やぶ"],[38,1,"ひと"],[40,1,"たみ"],[46,1,"た"]],"text":"割礼を受けない男子、すなわち前の皮を切らない者はわたしの契約を破るゆえ、その人は民のうちから断たれるであろう」。"},{"ref":"Gen.17.15","start":1017015,"end":1017015,"break":"paragraph","ruby":[[0,1,"かみ"],[10,1,"い"],[20,1,"つま"],[29,1,"な"],[39,1,"な"],[44,1,"い"]],"text":"神はまたアブラハムに言われた、「あなたの妻サライは、もはや名をサライといわず、名をサラと言いなさい。"},{"ref":"Gen.17.16","start":1017016,"end":1017016,"break":"none","ruby":[[4,2,"かのじょ"],[7,2,"しゅくふく"],[13,2,"かのじょ"],[28,1,"おとこ"],[30,1,"こ"],[32,1,"さづ"],[41,2,"かのじょ"],[44,2,"しゅくふく"],[48,2,"かのじょ"],[51,2,"くにぐに"],[54,1,"たみ"],[56,1,"はは"],[62,2,"かのじょ"],[72,1,"たみ"],[74,1,"おう"],[78,1,"で"]],"text":"わたしは彼女を祝福し、また彼女によって、あなたにひとりの男の子を授けよう。わたしは彼女を祝福し、彼女を国々の民の母としよう。彼女から、もろもろの民の王たちが出るであろう」。"},{"ref":"Gen.17.17","start":1017017,"end":1017017,"break":"none","ruby":[[8,1,"ふ"],[11,1,"わら"],[14,1,"こころ"],[16,1,"なか"],[18,1,"い"],[24,1,"さい"],[26,1,"もの"],[32,1,"こ"],[34,1,"うま"],[46,1,"さい"],[57,1,"う"]],"text":"アブラハムはひれ伏して笑い、心の中で言った、「百歳の者にどうして子が生れよう。サラはまた九十歳にもなって、どうして産むことができようか」。"},{"ref":"Gen.17.18","start":1017018,"end":1017018,"break":"none","ruby":[[9,1,"かみ"],[11,1,"い"],[29,1,"まえ"],[31,1,"い"]],"text":"そしてアブラハムは神に言った、「どうかイシマエルがあなたの前に生きながらえますように」。"},{"ref":"Gen.17.19","start":1017019,"end":1017019,"break":"none","ruby":[[0,1,"かみ"],[2,1,"い"],[15,1,"つま"],[23,1,"おとこ"],[25,1,"こ"],[27,1,"う"],[34,1,"な"],[40,1,"な"],[51,1,"かれ"],[53,2,"けいやく"],[56,1,"た"],[60,1,"のち"],[62,2,"しそん"],[68,2,"えいえん"],[71,2,"けいやく"]],"text":"神は言われた、「いや、あなたの妻サラはあなたに男の子を産むでしょう。名をイサクと名づけなさい。わたしは彼と契約を立てて、後の子孫のために永遠の契約としよう。"},{"ref":"Gen.17.20","start":1017020,"end":1017020,"break":"none","ruby":[[16,1,"ねが"],[19,1,"き"],[27,1,"かれ"],[29,2,"しゅくふく"],[33,1,"おお"],[36,2,"しそん"],[39,1,"え"],[43,1,"おお"],[49,1,"ま"],[56,1,"かれ"],[60,1,"にん"],[62,1,"きみ"],[66,1,"う"],[77,1,"かれ"],[79,1,"おお"],[83,2,"こくみん"]],"text":"またイシマエルについてはあなたの願いを聞いた。わたしは彼を祝福して多くの子孫を得させ、大いにそれを増すであろう。彼は十二人の君たちを生むであろう。わたしは彼を大いなる国民としよう。"},{"ref":"Gen.17.21","start":1017021,"end":1017021,"break":"none","ruby":[[7,2,"らいねん"],[10,1,"いま"],[20,1,"う"],[31,2,"けいやく"],[34,1,"た"]],"text":"しかしわたしは来年の今ごろサラがあなたに産むイサクと、わたしの契約を立てるであろう」。"},{"ref":"Gen.17.22","start":1017022,"end":1017022,"break":"paragraph","ruby":[[0,1,"かみ"],[8,1,"かた"],[10,1,"お"],[13,1,"かれ"],[15,1,"はな"]],"text":"神はアブラハムと語り終え、彼を離れて、のぼられた。"},{"ref":"Gen.17.23","start":1017023,"end":1017023,"break":"none","ruby":[[6,1,"かみ"],[8,2,"じぶん"],[11,1,"い"],[21,1,"ひ"],[24,1,"こ"],[35,1,"いえ"],[37,1,"うま"],[40,1,"もの"],[47,1,"ぎん"],[49,1,"か"],[51,1,"と"],[54,1,"もの"],[66,1,"いえ"],[68,2,"ひとびと"],[78,2,"だんし"],[81,1,"つ"],[87,1,"まえ"],[89,1,"かわ"],[91,2,"かつれい"],[94,1,"ほどこ"]],"text":"アブラハムは神が自分に言われたように、この日その子イシマエルと、すべて家に生れた者およびすべて銀で買い取った者、すなわちアブラハムの家の人々のうち、すべての男子を連れてきて、前の皮に割礼を施した。"},{"ref":"Gen.17.24","start":1017024,"end":1017024,"break":"none","ruby":[[6,1,"まえ"],[8,1,"かわ"],[10,2,"かつれい"],[13,1,"う"],[16,1,"とき"],[21,1,"さい"]],"text":"アブラハムが前の皮に割礼を受けた時は九十九歳、"},{"ref":"Gen.17.25","start":1017025,"end":1017025,"break":"none","ruby":[[2,1,"こ"],[9,1,"まえ"],[11,1,"かわ"],[13,2,"かつれい"],[16,1,"う"],[19,1,"とき"],[23,1,"さい"]],"text":"その子イシマエルが前の皮に割礼を受けた時は十三歳であった。"},{"ref":"Gen.17.26","start":1017026,"end":1017026,"break":"none","ruby":[[2,1,"ひ"],[11,1,"こ"],[18,2,"かつれい"],[21,1,"う"]],"text":"この日アブラハムとその子イシマエルは割礼を受けた。"},{"ref":"Gen.17.27","start":1017027,"end":1017027,"break":"none","ruby":[[4,1,"いえ"],[6,2,"ひとびと"],[9,1,"いえ"],[11,1,"うま"],[14,1,"もの"],[17,1,"ぎん"],[19,3,"いほうじん"],[24,1,"か"],[26,1,"と"],[29,1,"もの"],[31,1,"みな"],[33,1,"かれ"],[35,1,"とも"],[37,2,"かつれい"],[40,1,"う"]],"text":"またその家の人々は家に生れた者も、銀で異邦人から買い取った者も皆、彼と共に割礼を受けた。"}]