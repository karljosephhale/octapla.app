[{"ref":"Exod.37.1","start":2037001,"end":2037001,"break":"paragraph","ruby":[[9,1,"ざい"],[11,1,"はこ"],[13,1,"つく"],[17,1,"なが"],[25,1,"はん"],[27,1,"はば"],[34,1,"はん"],[36,1,"たか"],[44,1,"はん"]],"text":"ベザレルはアカシヤ材の箱を造った。長さは二キュビト半、幅は一キュビト半、高さは一キュビト半である。"},{"ref":"Exod.37.2","start":2037002,"end":2037002,"break":"none","ruby":[[0,2,"じゅんきん"],[4,1,"うち"],[14,2,"しゅうい"],[17,1,"きん"],[19,1,"かざ"],[21,1,"ふち"],[23,1,"つく"]],"text":"純金で、内そとをおおい、その周囲に金の飾り縁を造った。"},{"ref":"Exod.37.3","start":2037003,"end":2037003,"break":"none","ruby":[[2,1,"きん"],[4,1,"かん"],[8,1,"い"],[17,1,"と"],[30,1,"かん"],[35,1,"がわ"],[41,1,"かん"],[46,1,"がわ"],[48,1,"と"]],"text":"また金の環四つを鋳て、その四すみに取りつけた。すなわち二つの環をこちら側に、二つの環をあちら側に取りつけた。"},{"ref":"Exod.37.4","start":2037004,"end":2037004,"break":"none","ruby":[[6,1,"ざい"],[11,1,"つく"],[14,1,"きん"]],"text":"またアカシヤ材のさおを造り、金でこれをおおい、"},{"ref":"Exod.37.5","start":2037005,"end":2037005,"break":"none","ruby":[[5,1,"はこ"],[7,2,"そくめん"],[10,1,"かん"],[12,1,"とお"],[16,1,"はこ"]],"text":"そのさおを箱の側面の環に通して、箱をかつぐようにした。"},{"ref":"Exod.37.6","start":2037006,"end":2037006,"break":"none","ruby":[[2,2,"じゅんきん"],[5,3,"しょくざいしょ"],[9,1,"つく"],[13,1,"なが"],[21,1,"はん"],[23,1,"はば"],[30,1,"はん"]],"text":"また純金で贖罪所を造った。長さは二キュビト半、幅は一キュビト半である。"},{"ref":"Exod.37.7","start":2037007,"end":2037007,"break":"none","ruby":[[2,1,"きん"],[13,1,"つく"],[25,2,"うちもの"],[27,1,"つく"],[32,3,"しょくざいしょ"],[36,2,"りょうはし"],[39,1,"お"]],"text":"また金で、二つのケルビムを造った。すなわち、これを打物造りとし、贖罪所の両端に置いた。"},{"ref":"Exod.37.8","start":2037008,"end":2037008,"break":"none","ruby":[[9,1,"はし"],[21,1,"はし"],[23,1,"お"],[36,3,"しょくざいしょ"],[40,2,"いちぶ"],[48,2,"りょうはし"],[51,1,"つく"]],"text":"一つのケルブをこの端に、一つのケルブをかの端に置いた。すなわちケルビムを贖罪所の一部として、その両端に造った。"},{"ref":"Exod.37.9","start":2037009,"end":2037009,"break":"none","ruby":[[5,1,"つばさ"],[7,1,"たか"],[9,1,"の"],[14,1,"つばさ"],[16,3,"しょくざいしょ"],[24,1,"かお"],[26,1,"たがい"],[28,1,"む"],[31,1,"あ"],[44,1,"かお"],[46,3,"しょくざいしょ"],[50,1,"む"]],"text":"ケルビムは翼を高く伸べ、その翼で贖罪所をおおい、顔は互に向かい合った。すなわちケルビムの顔は贖罪所に向かっていた。"},{"ref":"Exod.37.10","start":2037010,"end":2037010,"break":"paragraph","ruby":[[6,1,"ざい"],[9,1,"つくえ"],[11,1,"つく"],[15,1,"なが"],[24,1,"はば"],[32,1,"たか"],[40,1,"はん"]],"text":"またアカシヤ材で、机を造った。長さは二キュビト、幅は一キュビト、高さは一キュビト半である。"},{"ref":"Exod.37.11","start":2037011,"end":2037011,"break":"none","ruby":[[0,2,"じゅんきん"],[12,2,"しゅうい"],[15,1,"きん"],[17,1,"かざ"],[19,1,"ふち"],[21,1,"つく"]],"text":"純金でこれをおおい、その周囲に金の飾り縁を造った。"},{"ref":"Exod.37.12","start":2037012,"end":2037012,"break":"none","ruby":[[4,2,"しゅうい"],[7,1,"て"],[8,1,"はば"],[10,1,"さん"],[12,1,"つく"],[17,2,"しゅうい"],[20,1,"さん"],[22,1,"きん"],[24,1,"かざ"],[26,1,"ふち"],[28,1,"つく"]],"text":"またその周囲に手幅の棧を造り、その周囲の棧に金の飾り縁を造った。"},{"ref":"Exod.37.13","start":2037013,"end":2037013,"break":"none","ruby":[[8,1,"きん"],[10,1,"かん"],[14,1,"い"],[22,1,"あし"],[28,1,"しょ"],[32,1,"かん"],[34,1,"と"]],"text":"またこれがために金の環四つを鋳て、その四つの足のすみ四か所にその環を取りつけた。"},{"ref":"Exod.37.14","start":2037014,"end":2037014,"break":"none","ruby":[[2,1,"かん"],[4,1,"さん"],[13,1,"つくえ"],[21,1,"い"],[24,1,"ところ"]],"text":"その環は棧のわきにあって、机をかつぐさおを入れる所とした。"},{"ref":"Exod.37.15","start":2037015,"end":2037015,"break":"none","ruby":[[6,1,"ざい"],[9,1,"つくえ"],[17,1,"つく"],[20,1,"きん"]],"text":"またアカシヤ材で、机をかつぐさおを造り、金でこれをおおった。"},{"ref":"Exod.37.16","start":2037016,"end":2037016,"break":"none","ruby":[[2,1,"つくえ"],[4,1,"うえ"],[6,1,"うつわ"],[14,1,"さら"],[16,2,"にゅうこう"],[19,1,"も"],[21,1,"はい"],[25,2,"かんさい"],[28,1,"そそ"],[33,1,"はち"],[35,1,"びん"],[38,2,"じゅんきん"],[41,1,"つく"]],"text":"また机の上の器、すなわちその皿、乳香を盛る杯および灌祭を注ぐための鉢と瓶とを純金で造った。"},{"ref":"Exod.37.17","start":2037017,"end":2037017,"break":"paragraph","ruby":[[2,2,"じゅんきん"],[5,2,"しょくだい"],[8,1,"つく"],[16,2,"うちもの"],[18,1,"つく"],[21,2,"しょくだい"],[24,1,"つく"],[29,1,"だい"],[31,1,"みき"],[33,1,"がく"],[35,1,"ふし"],[37,1,"はな"],[42,1,"つら"]],"text":"また純金の燭台を造った。すなわち打物造りで燭台を造り、その台、幹、萼、節、花を一つに連ねた。"},{"ref":"Exod.37.18","start":2037018,"end":2037018,"break":"none","ruby":[[5,1,"えだ"],[13,1,"だ"],[22,2,"しょくだい"],[28,1,"えだ"],[32,1,"がわ"],[36,2,"しょくだい"],[42,1,"えだ"],[46,1,"がわ"],[49,1,"だ"]],"text":"また六つの枝をそのわきから出させた。すなわち燭台の三つの枝をこの側から、燭台の三つの枝をかの側から出させた。"},{"ref":"Exod.37.19","start":2037019,"end":2037019,"break":"none","ruby":[[6,1,"はな"],[8,1,"かたち"],[15,1,"がく"],[18,1,"ふし"],[20,1,"はな"],[29,1,"えだ"],[43,1,"はな"],[45,1,"かたち"],[52,1,"がく"],[55,1,"ふし"],[57,1,"はな"],[66,1,"えだ"],[71,2,"しょくだい"],[75,1,"で"],[80,1,"えだ"]],"text":"あめんどうの花の形をした三つの萼が、節と花とをもって、この枝にあり、また、あめんどうの花の形をした三つの萼が、節と花とをもって、かの枝にあり、燭台から出る六つの枝をみなそのようにした。"},{"ref":"Exod.37.20","start":2037020,"end":2037020,"break":"none","ruby":[[2,2,"しょくだい"],[5,1,"みき"],[15,1,"はな"],[17,1,"かたち"],[24,1,"がく"],[29,1,"ふし"],[31,1,"はな"],[38,1,"と"]],"text":"また燭台の幹には、あめんどうの花の形をした四つの萼を、その節と花とをもたせて取りつけた。"},{"ref":"Exod.37.21","start":2037021,"end":2037021,"break":"none","ruby":[[5,1,"えだ"],[7,1,"した"],[12,1,"ふし"],[14,1,"と"],[19,1,"つぎ"],[24,1,"えだ"],[26,1,"した"],[31,1,"ふし"],[33,1,"と"],[41,1,"つぎ"],[46,1,"えだ"],[48,1,"した"],[53,1,"ふし"],[55,1,"と"],[60,2,"しょくだい"],[63,1,"みき"],[66,1,"で"],[71,1,"えだ"]],"text":"また二つの枝の下に一つの節を取りつけ、次の二つの枝の下に一つの節を取りつけ、さらに次の二つの枝の下に一つの節を取りつけ、燭台の幹から出る六つの枝に、みなそのようにした。"},{"ref":"Exod.37.22","start":2037022,"end":2037022,"break":"none","ruby":[[4,1,"ふし"],[6,1,"えだ"],[11,1,"つら"],[19,2,"じゅんきん"],[22,2,"うちもの"],[24,1,"つく"]],"text":"それらの節と枝を一つに連ね、ことごとく純金の打物造りとした。"},{"ref":"Exod.37.23","start":2037023,"end":2037023,"break":"none","ruby":[[10,1,"ざら"],[17,1,"しん"],[18,1,"き"],[25,1,"しん"],[26,1,"と"],[28,1,"ざら"],[31,2,"じゅんきん"],[34,1,"つく"]],"text":"また、それのともしび皿七つと、その芯切りばさみと、芯取り皿とを純金で造った。"},{"ref":"Exod.37.24","start":2037024,"end":2037024,"break":"none","ruby":[[4,2,"じゅんきん"],[16,2,"しょくだい"],[25,1,"うつわ"],[28,1,"つく"]],"text":"すなわち純金一タラントをもって、燭台とそのすべての器とを造った。"},{"ref":"Exod.37.25","start":2037025,"end":2037025,"break":"paragraph","ruby":[[6,1,"ざい"],[8,1,"こう"],[10,2,"さいだん"],[13,1,"つく"],[17,1,"なが"],[25,1,"はば"],[33,1,"かく"],[37,1,"たか"],[51,2,"いちぶ"],[56,1,"つの"]],"text":"またアカシヤ材で香の祭壇を造った。長さ一キュビト、幅一キュビトの四角にし、高さ二キュビトで、これにその一部として角をつけた。"},{"ref":"Exod.37.26","start":2037026,"end":2037026,"break":"none","ruby":[[6,1,"いただき"],[10,2,"しゅうい"],[13,2,"そくめん"],[18,1,"つの"],[20,2,"じゅんきん"],[29,2,"しゅうい"],[32,1,"きん"],[34,1,"かざ"],[36,1,"ふち"],[38,1,"つく"]],"text":"そして、その頂、その周囲の側面、その角を純金でおおい、その周囲に金の飾り縁を造った。"},{"ref":"Exod.37.27","start":2037027,"end":2037027,"break":"none","ruby":[[5,2,"りょうがわ"],[9,1,"かざ"],[11,1,"ふち"],[13,1,"した"],[15,1,"きん"],[17,1,"かん"],[27,1,"つく"],[40,1,"がわ"],[45,1,"つく"],[61,1,"とお"],[63,1,"ところ"]],"text":"また、その両側に、飾り縁の下に金の環二つを、そのために造った。すなわちその二つの側にこれを造った。これはそれをかつぐさおを通す所である。"},{"ref":"Exod.37.28","start":2037028,"end":2037028,"break":"none","ruby":[[9,1,"ざい"],[11,1,"つく"],[14,1,"きん"]],"text":"そのさおはアカシヤ材で造り、金でこれをおおった。"},{"ref":"Exod.37.29","start":2037029,"end":2037029,"break":"paragraph","ruby":[[2,2,"こうりょう"],[5,1,"つく"],[16,1,"せい"],[19,1,"そそ"],[21,1,"あぶら"],[23,2,"じゅんすい"],[26,2,"こうりょう"],[29,2,"くんこう"],[33,1,"つく"]],"text":"また香料を造るわざにしたがって、聖なる注ぎ油と純粋の香料の薫香とを造った。"}]