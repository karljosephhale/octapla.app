[{"ref":"Zech.1.1","start":38001001,"end":38001001,"break":"paragraph","ruby":[[5,1,"だい"],[7,1,"ねん"],[10,1,"がつ"],[13,1,"しゅ"],[15,2,"ことば"],[21,1,"こ"],[27,1,"こ"],[31,3,"よげんしゃ"],[39,1,"のぞ"]],"text":"ダリヨスの第二年の八月に、主の言葉がイドの子ベレキヤの子である預言者ゼカリヤに臨んだ、"},{"ref":"Zech.1.2","start":38001002,"end":38001002,"break":"none","ruby":[[1,1,"しゅ"],[9,2,"せんぞ"],[14,1,"たい"],[22,1,"いか"]],"text":"「主はあなたがたの先祖たちに対して、いたくお怒りになった。"},{"ref":"Zech.1.3","start":38001003,"end":38001003,"break":"none","ruby":[[5,2,"ばんぐん"],[8,1,"しゅ"],[12,1,"おお"],[19,1,"かれ"],[22,1,"つ"],[26,2,"ばんぐん"],[29,1,"しゅ"],[31,1,"おお"],[41,1,"かえ"],[60,1,"かえ"],[65,2,"ばんぐん"],[68,1,"しゅ"],[70,1,"おお"]],"text":"それゆえ、万軍の主はこう仰せられると、彼らに告げよ。万軍の主は仰せられる、わたしに帰れ、そうすれば、わたしもあなたがたに帰ろうと、万軍の主は仰せられる。"},{"ref":"Zech.1.4","start":38001004,"end":38001004,"break":"none","ruby":[[6,2,"せんぞ"],[23,1,"さき"],[25,3,"よげんしゃ"],[32,1,"かれ"],[39,1,"さけ"],[42,1,"い"],[47,2,"ばんぐん"],[50,1,"しゅ"],[54,1,"おお"],[60,1,"わる"],[62,1,"みち"],[64,1,"はな"],[67,1,"わる"],[74,1,"す"],[77,1,"かえ"],[85,1,"かれ"],[88,1,"き"],[94,1,"みみ"],[100,1,"かたむ"],[107,1,"しゅ"],[109,1,"い"]],"text":"あなたがたの先祖たちのようであってはならない。先の預言者たちは、彼らにむかって叫んで言った、『万軍の主はこう仰せられる、悪い道を離れ、悪いおこないを捨てて帰れ』と。しかし彼らは聞きいれず、耳をわたしに傾けなかったと主は言われる。"},{"ref":"Zech.1.5","start":38001005,"end":38001005,"break":"none","ruby":[[6,2,"せんぞ"],[11,1,"かれ"],[21,3,"よげんしゃ"],[27,1,"かれ"],[30,2,"えいえん"],[33,1,"い"]],"text":"あなたがたの先祖たち、彼らはどこにいるか。預言者たち、彼らは永遠に生きているのか。"},{"ref":"Zech.1.6","start":38001006,"end":38001006,"break":"none","ruby":[[13,3,"よげんしゃ"],[19,1,"めい"],[24,2,"ことば"],[30,1,"さだ"],[41,2,"せんぞ"],[46,1,"およ"],[58,1,"かれ"],[61,1,"た"],[63,1,"かえ"],[66,1,"い"],[71,2,"ばんぐん"],[74,1,"しゅ"],[81,1,"みち"],[93,1,"したが"],[107,1,"おも"],[109,1,"さだ"]],"text":"しかしわたしのしもべである預言者たちに命じたわが言葉と、わが定めとは、あなたがたの先祖たちに及んだではないか。それで彼らは立ち返って言った、『万軍の主がわれわれの道にしたがい、おこないに従って、われわれに、なそうと思い定められたように、そのとおりされたのだ』と」。"},{"ref":"Zech.1.7","start":38001007,"end":38001007,"break":"paragraph","ruby":[[5,1,"だい"],[7,1,"ねん"],[11,1,"がつ"],[23,1,"つき"],[28,1,"か"],[31,1,"しゅ"],[33,2,"ことば"],[39,1,"こ"],[45,1,"こ"],[49,3,"よげんしゃ"],[57,1,"のぞ"],[69,1,"い"]],"text":"ダリヨスの第二年の十一月、すなわちセバテという月の二十四日に、主の言葉がイドの子ベレキヤの子である預言者ゼカリヤに臨んだ。そしてゼカリヤは言った、"},{"ref":"Zech.1.8","start":38001008,"end":38001008,"break":"none","ruby":[[5,1,"よる"],[7,1,"み"],[17,1,"ひと"],[19,1,"あか"],[20,1,"うま"],[22,1,"の"],[26,2,"たにま"],[36,1,"き"],[38,1,"なか"],[40,1,"た"],[45,1,"うしろ"],[47,1,"あか"],[48,1,"うま"],[50,2,"くりげ"],[53,1,"うま"],[55,2,"しろうま"]],"text":"「わたしは夜、見ていると、ひとりの人が赤馬に乗って、谷間にあるミルトスの木の中に立ち、その後に赤馬、栗毛の馬、白馬がいた。"},{"ref":"Zech.1.9","start":38001009,"end":38001009,"break":"none","ruby":[[2,1,"とき"],[10,1,"しゅ"],[24,1,"たず"],[33,1,"かた"],[35,1,"てん"],[37,1,"つかい"],[39,1,"い"],[58,1,"しめ"]],"text":"その時わたしが『わが主よ、これらはなんですか』と尋ねると、わたしと語る天の使は言った、『これがなんであるか、あなたに示しましょう』。"},{"ref":"Zech.1.10","start":38001010,"end":38001010,"break":"none","ruby":[[9,1,"き"],[11,1,"なか"],[13,1,"た"],[18,1,"ひと"],[20,1,"こた"],[29,1,"ち"],[31,2,"みまわ"],[40,1,"しゅ"],[48,1,"もの"],[53,1,"い"]],"text":"すると、ミルトスの木の中に立っている人が答えて、『これらは地を見回らせるために、主がつかわされた者です』と言うと、"},{"ref":"Zech.1.11","start":38001011,"end":38001011,"break":"none","ruby":[[0,1,"かれ"],[3,1,"こた"],[12,1,"なか"],[14,1,"た"],[19,1,"しゅ"],[21,1,"つかい"],[23,1,"い"],[33,1,"ち"],[35,2,"みまわ"],[41,1,"ぜん"],[42,1,"ち"],[47,2,"へいおん"]],"text":"彼らは答えて、ミルトスの中に立っている主の使に言った、『われわれは地を見回ったが、全地はすべて平穏です』。"},{"ref":"Zech.1.12","start":38001012,"end":38001012,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"つかい"],[7,1,"い"],[12,2,"ばんぐん"],[15,1,"しゅ"],[36,2,"まちまち"],[46,1,"くだ"],[61,1,"いか"],[73,1,"ねん"]],"text":"すると主の使は言った、『万軍の主よ、あなたは、いつまでエルサレムとユダの町々とを、あわれんで下さらないのですか。あなたはお怒りになって、すでに七十年になりました』。"},{"ref":"Zech.1.13","start":38001013,"end":38001013,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"かた"],[8,1,"てん"],[10,1,"つかい"],[18,1,"なぐさ"],[21,2,"ことば"],[27,1,"こた"]],"text":"主はわたしと語る天の使に、ねんごろな慰めの言葉をもって答えられた。"},{"ref":"Zech.1.14","start":38001014,"end":38001014,"break":"none","ruby":[[8,1,"かた"],[10,1,"てん"],[12,1,"つかい"],[14,1,"い"],[23,1,"よ"],[28,1,"い"],[34,2,"ばんぐん"],[37,1,"しゅ"],[41,1,"おお"],[69,1,"おお"],[77,1,"おこ"]],"text":"そこで、わたしと語る天の使は言った、『あなたは呼ばわって言いなさい。万軍の主はこう仰せられます、わたしはエルサレムのため、シオンのために、大いなるねたみを起し、"},{"ref":"Zech.1.15","start":38001015,"end":38001015,"break":"none","ruby":[[0,1,"やす"],[6,2,"くにぐに"],[9,1,"たみ"],[11,1,"たい"],[15,1,"おお"],[18,1,"いか"],[30,1,"すこ"],[35,1,"いか"],[41,1,"かれ"],[45,1,"おお"],[51,1,"なや"]],"text":"安らかにいる国々の民に対して、大いに怒る。なぜなら、わたしが少しばかり怒ったのに、彼らは、大いにこれを悩ましたからであると。"},{"ref":"Zech.1.16","start":38001016,"end":38001016,"break":"none","ruby":[[5,1,"しゅ"],[9,1,"おお"],[34,1,"かえ"],[41,1,"いえ"],[45,1,"なか"],[47,1,"た"],[52,1,"はか"],[63,1,"は"],[69,2,"ばんぐん"],[72,1,"しゅ"],[74,1,"おお"]],"text":"それゆえ、主はこう仰せられます、わたしはあわれみをもってエルサレムに帰る。わたしの家はその中に建てられ、測りなわはエルサレムに張られると、万軍の主は仰せられます。"},{"ref":"Zech.1.17","start":38001017,"end":38001017,"break":"none","ruby":[[6,1,"よ"],[11,1,"い"],[17,2,"ばんぐん"],[20,1,"しゅ"],[24,1,"おお"],[33,2,"まちまち"],[36,1,"ふたた"],[38,1,"よ"],[40,1,"もの"],[42,1,"み"],[48,1,"しゅ"],[50,1,"ふたた"],[56,1,"なぐさ"],[59,1,"ふたた"],[67,1,"えら"]],"text":"あなたはまた呼ばわって言いなさい。万軍の主はこう仰せられます、わが町々は再び良い物で満ちあふれ、主は再びシオンを慰め、再びエルサレムを選ぶ』と」。"},{"ref":"Zech.1.18","start":38001018,"end":38001018,"break":"paragraph","ruby":[[4,1,"め"],[9,1,"み"],[15,1,"み"],[21,1,"つの"]],"text":"わたしが目をあげて見ていると、見よ、四つの角があった。"},{"ref":"Zech.1.19","start":38001019,"end":38001019,"break":"none","ruby":[[4,1,"かた"],[6,1,"てん"],[8,1,"つかい"],[22,1,"い"],[26,1,"かれ"],[28,1,"こた"],[31,1,"い"],[57,1,"ち"],[61,1,"つの"]],"text":"わたしと語る天の使に「これらはなんですか」と言うと、彼は答えて言った、「これらはユダ、イスラエルおよびエルサレムを散らした角です」。"},{"ref":"Zech.1.20","start":38001020,"end":38001020,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[7,1,"にん"],[9,2,"かじ"],[16,1,"しめ"]],"text":"その時、主は四人の鍛冶をわたしに示された。"},{"ref":"Zech.1.21","start":38001021,"end":38001021,"break":"none","ruby":[[9,1,"なに"],[16,1,"き"],[24,1,"い"],[28,1,"かれ"],[30,1,"こた"],[39,1,"つの"],[44,1,"ち"],[49,1,"ひと"],[53,1,"あたま"],[72,1,"にん"],[74,1,"もの"],[76,1,"き"],[80,1,"かれ"],[92,1,"ち"],[98,1,"つの"],[106,1,"ち"],[110,2,"くにぐに"],[113,1,"たみ"],[115,1,"つの"],[117,1,"な"]],"text":"わたしが「これらは何をするために来たのですか」と言うと、彼は答えた、「これらの角はユダを散らして、人にその頭をあげさせなかったものですが、この四人の者が来たのは彼らをおどし、かのユダの地にむかって角をあげ、これを散らした国々の民の角を投げうつためです」。"}]