[{"ref":"Ezek.18.1","start":26018001,"end":26018001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.18.2","start":26018002,"end":26018002,"break":"none","ruby":[[13,1,"ち"],[26,1,"もち"],[30,1,"ちち"],[35,1,"す"],[41,1,"た"],[46,2,"こども"],[51,1,"は"]],"text":"「あなたがたがイスラエルの地について、このことわざを用い、『父たちが、酢いぶどうを食べたので子供たちの歯がうく』というのはどんなわけか。"},{"ref":"Ezek.18.3","start":26018003,"end":26018003,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[14,1,"い"],[26,1,"ふたた"],[41,1,"もち"]],"text":"主なる神は言われる、わたしは生きている、あなたがたは再びイスラエルでこのことわざを用いることはない。"},{"ref":"Ezek.18.4","start":26018004,"end":26018004,"break":"none","ruby":[[0,1,"み"],[7,1,"たましい"],[19,1,"ちち"],[21,1,"たましい"],[23,1,"こ"],[25,1,"たましい"],[37,1,"つみ"],[39,1,"おか"],[42,1,"たましい"],[44,1,"かなら"],[46,1,"し"]],"text":"見よ、すべての魂はわたしのものである。父の魂も子の魂もわたしのものである。罪を犯した魂は必ず死ぬ。"},{"ref":"Ezek.18.5","start":26018005,"end":26018005,"break":"paragraph","ruby":[[0,1,"ひと"],[4,1,"ただ"],[11,2,"こうどう"],[14,2,"せいぎ"],[18,1,"おこな"]],"text":"人がもし正しくあって、公道と正義とを行い、"},{"ref":"Ezek.18.6","start":26018006,"end":26018006,"break":"none","ruby":[[0,1,"やま"],[2,1,"うえ"],[4,2,"しょくじ"],[12,1,"め"],[23,1,"いえ"],[25,2,"ぐうぞう"],[28,1,"あお"],[32,1,"とな"],[34,1,"びと"],[36,1,"つま"],[38,1,"おか"],[42,1,"けが"],[45,1,"とき"],[49,1,"おんな"],[51,1,"ちか"]],"text":"山の上で食事をせず、また目をあげてイスラエルの家の偶像を仰がず、隣り人の妻を犯さず、汚れの時にある女に近づかず、"},{"ref":"Ezek.18.7","start":26018007,"end":26018007,"break":"none","ruby":[[10,2,"しちもつ"],[13,1,"かえ"],[16,1,"けっ"],[19,1,"うば"],[23,2,"しょくもつ"],[26,1,"う"],[29,1,"もの"],[31,1,"あた"],[34,1,"はだか"],[36,1,"もの"],[38,2,"いふく"],[41,1,"き"]],"text":"だれをもしえたげず、質物を返し、決して奪わず、食物を飢えた者に与え、裸の者に衣服を着せ、"},{"ref":"Ezek.18.8","start":26018008,"end":26018008,"break":"none","ruby":[[0,2,"りそく"],[3,2,"こうり"],[9,1,"か"],[13,1,"て"],[18,1,"あく"],[20,1,"おこな"],[24,1,"ひと"],[26,1,"ひと"],[29,1,"あいだ"],[31,2,"しんじつ"],[38,1,"おこな"]],"text":"利息や高利をとって貸さず、手をひいて悪を行わず、人と人との間に真実のさばきを行い、"},{"ref":"Ezek.18.9","start":26018009,"end":26018009,"break":"none","ruby":[[4,1,"さだ"],[7,1,"あゆ"],[18,2,"ちゅうじつ"],[21,1,"まも"],[27,1,"かれ"],[29,1,"ただ"],[32,1,"ひと"],[37,1,"かれ"],[39,1,"かなら"],[41,1,"い"],[52,1,"しゅ"],[55,1,"かみ"],[57,1,"い"]],"text":"わたしの定めに歩み、わたしのおきてを忠実に守るならば、彼は正しい人である。彼は必ず生きることができると、主なる神は言われる。"},{"ref":"Ezek.18.10","start":26018010,"end":26018010,"break":"paragraph","ruby":[[3,1,"かれ"],[5,1,"こ"],[7,1,"う"],[12,1,"こ"],[14,1,"あら"],[16,1,"もの"],[19,1,"ひと"],[21,1,"ち"],[23,1,"なが"],[30,2,"ぎむ"],[37,1,"おこな"]],"text":"しかし彼が子を生み、その子が荒い者で、人の血を流し、これらの義務の一つをも行わず、"},{"ref":"Ezek.18.11","start":26018011,"end":26018011,"break":"none","ruby":[[4,1,"やま"],[6,1,"うえ"],[8,2,"しょくじ"],[13,1,"とな"],[15,1,"びと"],[17,1,"つま"],[19,1,"おか"]],"text":"かえって山の上で食事をし、隣り人の妻を犯し、"},{"ref":"Ezek.18.12","start":26018012,"end":26018012,"break":"none","ruby":[[0,1,"とぼ"],[3,1,"もの"],[5,1,"まず"],[8,1,"もの"],[15,1,"もの"],[17,1,"うば"],[20,2,"しちもつ"],[23,1,"かえ"],[27,1,"め"],[32,2,"ぐうぞう"],[35,1,"あお"],[38,1,"にく"],[42,1,"こと"]],"text":"乏しい者や貧しい者をしえたげ、物を奪い、質物を返さず、目をあげて偶像を仰ぎ、憎むべき事をおこない、"},{"ref":"Ezek.18.13","start":26018013,"end":26018013,"break":"none","ruby":[[0,2,"りそく"],[3,2,"こうり"],[9,1,"か"],[17,1,"こ"],[19,1,"い"],[28,1,"かれ"],[30,1,"い"],[41,1,"かれ"],[47,1,"にく"],[51,1,"こと"],[58,1,"かなら"],[60,1,"し"],[65,1,"ち"],[67,1,"かれ"],[68,2,"じしん"],[71,1,"き"]],"text":"利息や高利をとって貸すならば、その子は生きるであろうか。彼は生きることはできない。彼はこれらの憎むべき事をしたので、必ず死に、その血は彼自身に帰する。"},{"ref":"Ezek.18.14","start":26018014,"end":26018014,"break":"paragraph","ruby":[[3,1,"かれ"],[5,1,"こ"],[7,1,"う"],[12,1,"こ"],[14,1,"ちち"],[16,1,"おこな"],[23,1,"つみ"],[25,1,"み"],[28,1,"おそ"],[39,1,"おこな"]],"text":"しかし彼が子を生み、その子が父の行ったすべての罪を見て、恐れ、そのようなことを行わず、"},{"ref":"Ezek.18.15","start":26018015,"end":26018015,"break":"none","ruby":[[0,1,"やま"],[2,1,"うえ"],[4,2,"しょくじ"],[9,1,"め"],[20,1,"いえ"],[22,2,"ぐうぞう"],[25,1,"あお"],[29,1,"とな"],[31,1,"びと"],[33,1,"つま"],[35,1,"おか"]],"text":"山の上で食事せず、目をあげてイスラエルの家の偶像を仰がず、隣り人の妻を犯さず、"},{"ref":"Ezek.18.16","start":26018016,"end":26018016,"break":"none","ruby":[[10,2,"しちもつ"],[15,1,"と"],[19,1,"もの"],[21,1,"うば"],[29,2,"じぶん"],[32,2,"しょくもつ"],[35,1,"う"],[38,1,"もの"],[40,1,"あた"],[43,1,"はだか"],[45,1,"もの"],[47,2,"いふく"],[50,1,"き"]],"text":"だれをもしえたげず、質物をひき留めず、物を奪わず、かえって自分の食物を飢えた者に与え、裸の者に衣服を着せ、"},{"ref":"Ezek.18.17","start":26018017,"end":26018017,"break":"none","ruby":[[2,1,"て"],[7,1,"あく"],[9,1,"おこな"],[13,2,"りそく"],[16,2,"こうり"],[31,1,"おこな"],[38,1,"さだ"],[41,1,"あゆ"],[47,1,"かれ"],[51,1,"ちち"],[53,1,"あく"],[58,1,"し"],[62,1,"かなら"],[64,1,"い"]],"text":"その手をひいて悪を行わず、利息や高利をとらず、わたしのおきてを行い、わたしの定めに歩むならば、彼はその父の悪のために死なず、必ず生きる。"},{"ref":"Ezek.18.18","start":26018018,"end":26018018,"break":"none","ruby":[[5,1,"ちち"],[7,1,"ひと"],[15,2,"きょうだい"],[18,1,"もの"],[20,1,"うば"],[25,1,"たみ"],[27,1,"なか"],[29,1,"よ"],[33,1,"こと"],[35,1,"おこな"],[41,1,"み"],[44,1,"かれ"],[48,1,"あく"],[53,1,"し"]],"text":"しかしその父は人をかすめ、その兄弟の物を奪い、その民の中で良くない事を行ったゆえ、見よ、彼はその悪のために死ぬ。"},{"ref":"Ezek.18.19","start":26018019,"end":26018019,"break":"paragraph","ruby":[[14,1,"こ"],[16,1,"ちち"],[18,1,"あく"],[20,1,"お"],[28,1,"い"],[31,1,"こ"],[33,2,"こうどう"],[36,2,"せいぎ"],[40,1,"おこな"],[51,1,"さだ"],[54,1,"まも"],[65,1,"かなら"],[67,1,"い"]],"text":"しかしあなたがたは、『なぜ、子は父の悪を負わないのか』と言う。子は公道と正義とを行い、わたしのすべての定めを守っておこなったので、必ず生きるのである。"},{"ref":"Ezek.18.20","start":26018020,"end":26018020,"break":"none","ruby":[[0,1,"つみ"],[2,1,"おか"],[4,1,"たましい"],[6,1,"し"],[9,1,"こ"],[11,1,"ちち"],[13,1,"あく"],[15,1,"お"],[20,1,"ちち"],[22,1,"こ"],[24,1,"あく"],[26,1,"お"],[31,2,"ぎじん"],[34,1,"ぎ"],[38,1,"ひと"],[40,1,"き"],[43,2,"あくにん"],[46,1,"あく"],[50,1,"ひと"],[52,1,"き"]],"text":"罪を犯す魂は死ぬ。子は父の悪を負わない。父は子の悪を負わない。義人の義はその人に帰し、悪人の悪はその人に帰する。"},{"ref":"Ezek.18.21","start":26018021,"end":26018021,"break":"paragraph","ruby":[[4,2,"あくにん"],[11,1,"おこな"],[19,1,"つみ"],[21,1,"はな"],[32,1,"さだ"],[35,1,"まも"],[38,2,"こうどう"],[41,2,"せいぎ"],[45,1,"おこな"],[51,1,"かれ"],[53,1,"かなら"],[55,1,"い"],[59,1,"し"]],"text":"しかし、悪人がもしその行ったもろもろの罪を離れ、わたしのすべての定めを守り、公道と正義とを行うならば、彼は必ず生きる。死ぬことはない。"},{"ref":"Ezek.18.22","start":26018022,"end":26018022,"break":"none","ruby":[[2,1,"おか"],[14,1,"かれ"],[16,1,"たい"],[19,1,"おぼ"],[26,1,"かれ"],[33,1,"ただ"],[36,1,"こと"],[41,1,"い"]],"text":"その犯したもろもろのとがは、彼に対して覚えられない。彼はそのなした正しい事のために生きる。"},{"ref":"Ezek.18.23","start":26018023,"end":26018023,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"い"],[14,2,"あくにん"],[17,1,"し"],[19,1,"この"],[30,1,"かれ"],[39,1,"はな"],[42,1,"い"],[48,1,"この"]],"text":"主なる神は言われる、わたしは悪人の死を好むであろうか。むしろ彼がそのおこないを離れて生きることを好んでいるではないか。"},{"ref":"Ezek.18.24","start":26018024,"end":26018024,"break":"none","ruby":[[3,2,"ぎじん"],[10,1,"ぎ"],[12,1,"はな"],[15,1,"あく"],[17,1,"おこな"],[20,2,"あくにん"],[30,1,"にく"],[34,1,"こと"],[36,1,"おこな"],[42,1,"い"],[51,1,"かれ"],[53,1,"おこな"],[61,1,"ただ"],[64,1,"こと"],[66,1,"おぼ"],[73,1,"かれ"],[77,1,"おか"],[86,1,"おか"],[89,1,"つみ"],[95,1,"し"]],"text":"しかし義人がもしその義を離れて悪を行い、悪人のなすもろもろの憎むべき事を行うならば、生きるであろうか。彼が行ったもろもろの正しい事は覚えられない。彼はその犯したとがと、その犯した罪とのために死ぬ。"},{"ref":"Ezek.18.25","start":26018025,"end":26018025,"break":"paragraph","ruby":[[11,1,"しゅ"],[18,1,"ただ"],[25,1,"い"],[34,1,"いえ"],[37,1,"き"],[49,1,"ただ"],[57,1,"ただ"]],"text":"しかしあなたがたは、『主のおこないは正しくない』と言う。イスラエルの家よ、聞け。わたしのおこないは正しくないのか。正しくないのは、あなたがたのおこないではないか。"},{"ref":"Ezek.18.26","start":26018026,"end":26018026,"break":"none","ruby":[[0,2,"ぎじん"],[5,1,"ぎ"],[7,1,"はな"],[10,1,"あく"],[12,1,"おこな"],[20,1,"し"],[26,1,"かれ"],[28,2,"じぶん"],[31,1,"おこな"],[34,1,"あく"],[39,1,"し"]],"text":"義人がその義を離れて悪を行い、そのために死ぬならば、彼は自分の行った悪のために死ぬのである。"},{"ref":"Ezek.18.27","start":26018027,"end":26018027,"break":"none","ruby":[[3,2,"あくにん"],[8,1,"おこな"],[11,1,"あく"],[13,1,"はな"],[17,2,"こうどう"],[20,2,"せいぎ"],[24,1,"おこな"],[30,1,"かれ"],[32,2,"じぶん"],[35,1,"いのち"],[37,1,"すく"]],"text":"しかし悪人がその行った悪を離れて、公道と正義とを行うならば、彼は自分の命を救うことができる。"},{"ref":"Ezek.18.28","start":26018028,"end":26018028,"break":"none","ruby":[[0,1,"かれ"],[2,1,"かえり"],[8,1,"おか"],[18,1,"はな"],[25,1,"かなら"],[27,1,"い"],[31,1,"し"]],"text":"彼は省みて、その犯したすべてのとがを離れたのだから必ず生きる。死ぬことはない。"},{"ref":"Ezek.18.29","start":26018029,"end":26018029,"break":"none","ruby":[[9,1,"いえ"],[12,1,"しゅ"],[19,1,"ただ"],[26,1,"い"],[35,1,"いえ"],[52,1,"ただ"],[60,1,"ただ"]],"text":"しかしイスラエルの家は『主のおこないは正しくない』と言う。イスラエルの家よ、わたしのおこないは、はたして正しくないのか。正しくないのは、あなたがたのおこないではないか。"},{"ref":"Ezek.18.30","start":26018030,"end":26018030,"break":"paragraph","ruby":[[11,1,"いえ"],[36,1,"したが"],[44,1,"しゅ"],[47,1,"かみ"],[49,1,"い"],[54,1,"く"],[56,1,"あらた"],[73,1,"はな"],[82,1,"あく"],[90,1,"ほろ"]],"text":"それゆえ、イスラエルの家よ、わたしはあなたがたを、おのおのそのおこないに従ってさばくと、主なる神は言われる。悔い改めて、あなたがたのすべてのとがを離れよ。さもないと悪はあなたがたを滅ぼす。"},{"ref":"Ezek.18.31","start":26018031,"end":26018031,"break":"none","ruby":[[10,1,"たい"],[25,1,"す"],[27,1,"さ"],[30,1,"あたら"],[33,1,"こころ"],[36,1,"あたら"],[39,1,"れい"],[42,1,"え"],[51,1,"いえ"],[64,1,"し"]],"text":"あなたがたがわたしに対しておこなったすべてのとがを捨て去り、新しい心と、新しい霊とを得よ。イスラエルの家よ、あなたがたはどうして死んでよかろうか。"},{"ref":"Ezek.18.32","start":26018032,"end":26018032,"break":"none","ruby":[[4,2,"なにび"],[8,1,"し"],[11,1,"よろこ"],[21,1,"しゅ"],[24,1,"かみ"],[26,1,"い"],[42,1,"ひるがえ"],[45,1,"い"]],"text":"わたしは何人との死をも喜ばないのであると、主なる神は言われる。それゆえ、あなたがたは翻って生きよ」。"}]