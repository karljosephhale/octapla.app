[{"ref":"Rev.3.1","start":66003001,"end":66003001,"break":"paragraph","breaks":[[25,"paragraph"]],"ruby":[[7,2,"きょうかい"],[10,2,"みつかい"],[16,1,"か"],[26,1,"かみ"],[31,1,"れい"],[36,1,"ほし"],[39,1,"も"],[45,1,"つぎ"],[50,1,"い"],[66,1,"し"],[82,1,"い"],[92,1,"な"],[97,1,"じつ"],[99,1,"し"]],"text":"サルデスにある教会の御使に、こう書きおくりなさい。『神の七つの霊と七つの星とを持つかたが、次のように言われる。わたしはあなたのわざを知っている。すなわち、あなたは、生きているというのは名だけで、実は死んでいる。"},{"ref":"Rev.3.2","start":66003002,"end":66003002,"break":"none","ruby":[[0,1,"め"],[9,1,"し"],[16,1,"のこ"],[19,1,"もの"],[23,1,"ちから"],[47,1,"かみ"],[53,2,"かんぜん"],[60,1,"み"]],"text":"目をさましていて、死にかけている残りの者たちを力づけなさい。わたしは、あなたのわざが、わたしの神のみまえに完全であるとは見ていない。"},{"ref":"Rev.3.3","start":66003003,"end":66003003,"break":"none","ruby":[[16,1,"う"],[23,1,"き"],[28,1,"おも"],[30,1,"おこ"],[37,1,"まも"],[45,1,"く"],[47,1,"あらた"],[55,1,"め"],[71,2,"ぬすびと"],[77,1,"く"],[87,1,"とき"],[97,1,"く"],[106,1,"けっ"]],"text":"だから、あなたが、どのようにして受けたか、また聞いたかを思い起して、それを守りとおし、かつ悔い改めなさい。もし目をさましていないなら、わたしは盗人のように来るであろう。どんな時にあなたのところに来るか、あなたには決してわからない。"},{"ref":"Rev.3.4","start":66003004,"end":66003004,"break":"none","ruby":[[12,1,"ころも"],[14,1,"けが"],[18,1,"ひと"],[21,2,"すうにん"],[26,1,"かれ"],[29,1,"しろ"],[31,1,"ころも"],[33,1,"き"],[40,1,"とも"],[42,1,"あゆ"],[45,1,"つづ"],[53,1,"かれ"],[65,1,"もの"]],"text":"しかし、サルデスにはその衣を汚さない人が、数人いる。彼らは白い衣を着て、わたしと共に歩みを続けるであろう。彼らは、それにふさわしい者である。"},{"ref":"Rev.3.5","start":66003005,"end":66003005,"break":"none","ruby":[[0,2,"しょうり"],[3,1,"え"],[5,1,"もの"],[13,1,"しろ"],[15,1,"ころも"],[17,1,"き"],[34,1,"な"],[40,1,"か"],[43,1,"け"],[52,1,"けっ"],[66,1,"ちち"],[68,2,"みつかい"],[73,1,"まえ"],[78,1,"な"],[80,1,"い"]],"text":"勝利を得る者は、このように白い衣を着せられるのである。わたしは、その名をいのちの書から消すようなことを、決してしない。また、わたしの父と御使たちの前で、その名を言いあらわそう。"},{"ref":"Rev.3.6","start":66003006,"end":66003006,"break":"none","ruby":[[0,1,"みみ"],[4,1,"もの"],[7,2,"みたま"],[10,1,"しょ"],[11,2,"きょうかい"],[14,1,"い"],[19,1,"き"]],"text":"耳のある者は、御霊が諸教会に言うことを聞くがよい』。"},{"ref":"Rev.3.7","start":66003007,"end":66003007,"break":"paragraph","breaks":[[27,"paragraph"]],"ruby":[[9,2,"きょうかい"],[12,2,"みつかい"],[18,1,"か"],[28,1,"せい"],[31,1,"もの"],[38,1,"もの"],[47,1,"も"],[49,1,"もの"],[51,1,"ひら"],[58,1,"と"],[69,1,"と"],[77,1,"ひら"],[86,1,"もの"],[89,1,"つぎ"],[94,1,"い"]],"text":"ヒラデルヒヤにある教会の御使に、こう書きおくりなさい。『聖なる者、まことなる者、ダビデのかぎを持つ者、開けばだれにも閉じられることがなく、閉じればだれにも開かれることのない者が、次のように言われる。"},{"ref":"Rev.3.8","start":66003008,"end":66003008,"break":"none","ruby":[[12,1,"し"],[18,1,"み"],[30,1,"まえ"],[36,1,"と"],[46,1,"もん"],[48,1,"ひら"],[65,1,"すこ"],[69,1,"ちから"],[87,2,"ことば"],[90,1,"まも"],[97,1,"な"],[99,1,"いな"]],"text":"わたしは、あなたのわざを知っている。見よ、わたしは、あなたの前に、だれも閉じることのできない門を開いておいた。なぜなら、あなたには少ししか力がなかったにもかかわらず、わたしの言葉を守り、わたしの名を否まなかったからである。"},{"ref":"Rev.3.9","start":66003009,"end":66003009,"break":"none","ruby":[[0,1,"み"],[7,2,"かいどう"],[10,1,"ぞく"],[13,1,"もの"],[23,1,"じん"],[25,1,"じ"],[26,1,"しょう"],[36,1,"じつ"],[40,1,"じん"],[46,1,"いつわ"],[48,1,"もの"],[59,1,"み"],[62,1,"かれ"],[69,1,"あし"],[75,2,"へいふく"],[96,1,"あい"],[105,1,"かれ"],[108,1,"し"]],"text":"見よ、サタンの会堂に属する者、すなわち、ユダヤ人と自称してはいるが、その実ユダヤ人でなくて、偽る者たちに、こうしよう。見よ、彼らがあなたの足もとにきて平伏するようにし、そして、わたしがあなたを愛していることを、彼らに知らせよう。"},{"ref":"Rev.3.10","start":66003010,"end":66003010,"break":"none","ruby":[[0,2,"にんたい"],[11,2,"ことば"],[18,1,"まも"],[29,2,"ちじょう"],[32,1,"す"],[34,1,"もの"],[45,1,"ぜん"],[46,2,"せかい"],[49,1,"のぞ"],[57,2,"しれん"],[60,1,"とき"],[67,1,"ふせ"],[69,1,"まも"]],"text":"忍耐についてのわたしの言葉をあなたが守ったから、わたしも、地上に住む者たちをためすために、全世界に臨もうとしている試錬の時に、あなたを防ぎ守ろう。"},{"ref":"Rev.3.11","start":66003011,"end":66003011,"break":"none","ruby":[[8,1,"く"],[15,1,"かんむり"],[21,1,"うば"],[30,2,"じぶん"],[33,1,"も"],[41,1,"かた"],[43,1,"まも"]],"text":"わたしは、すぐに来る。あなたの冠がだれにも奪われないように、自分の持っているものを堅く守っていなさい。"},{"ref":"Rev.3.12","start":66003012,"end":66003012,"break":"none","ruby":[[0,2,"しょうり"],[3,1,"え"],[5,1,"もの"],[12,1,"かみ"],[14,2,"せいじょ"],[20,1,"はしら"],[26,1,"かれ"],[28,1,"けっ"],[32,1,"ど"],[34,1,"そと"],[36,1,"で"],[47,1,"かれ"],[49,1,"うえ"],[56,1,"かみ"],[58,2,"みな"],[66,1,"かみ"],[68,1,"みやこ"],[75,1,"てん"],[81,1,"かみ"],[88,1,"くだ"],[93,1,"あたら"],[102,1,"な"],[109,1,"あたら"],[112,1,"な"],[116,1,"か"]],"text":"勝利を得る者を、わたしの神の聖所における柱にしよう。彼は決して二度と外へ出ることはない。そして彼の上に、わたしの神の御名と、わたしの神の都、すなわち、天とわたしの神のみもとから下ってくる新しいエルサレムの名と、わたしの新しい名とを、書きつけよう。"},{"ref":"Rev.3.13","start":66003013,"end":66003013,"break":"none","ruby":[[0,1,"みみ"],[4,1,"もの"],[7,2,"みたま"],[10,1,"しょ"],[11,2,"きょうかい"],[14,1,"い"],[19,1,"き"]],"text":"耳のある者は、御霊が諸教会に言うことを聞くがよい』。"},{"ref":"Rev.3.14","start":66003014,"end":66003014,"break":"paragraph","breaks":[[26,"paragraph"]],"ruby":[[8,2,"きょうかい"],[11,2,"みつかい"],[17,1,"か"],[33,1,"もの"],[35,2,"ちゅうじつ"],[43,2,"しょうにん"],[46,1,"かみ"],[48,1,"つく"],[55,2,"こんげん"],[64,1,"つぎ"],[69,1,"い"]],"text":"ラオデキヤにある教会の御使に、こう書きおくりなさい。『アァメンたる者、忠実な、まことの証人、神に造られたものの根源であるかたが、次のように言われる。"},{"ref":"Rev.3.15","start":66003015,"end":66003015,"break":"none","ruby":[[11,1,"し"],[21,1,"つめ"],[28,1,"あつ"],[38,1,"つめ"],[42,1,"あつ"]],"text":"わたしはあなたのわざを知っている。あなたは冷たくもなく、熱くもない。むしろ、冷たいか熱いかであってほしい。"},{"ref":"Rev.3.16","start":66003016,"end":66003016,"break":"none","ruby":[[6,1,"あつ"],[12,1,"つめ"],[31,1,"くち"],[34,1,"は"],[36,1,"だ"]],"text":"このように、熱くもなく、冷たくもなく、なまぬるいので、あなたを口から吐き出そう。"},{"ref":"Rev.3.17","start":66003017,"end":66003017,"break":"none","ruby":[[5,2,"じぶん"],[8,1,"と"],[14,1,"ゆた"],[24,3,"ふじゆう"],[31,1,"い"],[38,1,"じつ"],[44,2,"じしん"],[51,1,"もの"],[59,1,"もの"],[61,1,"まず"],[64,1,"もの"],[66,1,"め"],[68,1,"み"],[72,1,"もの"],[74,1,"はだか"],[76,1,"もの"],[83,1,"き"]],"text":"あなたは、自分は富んでいる、豊かになった、なんの不自由もないと言っているが、実は、あなた自身がみじめな者、あわれむべき者、貧しい者、目の見えない者、裸な者であることに気がついていない。"},{"ref":"Rev.3.18","start":66003018,"end":66003018,"break":"none","ruby":[[8,1,"すす"],[12,1,"と"],[14,1,"もの"],[27,1,"ひ"],[29,2,"せいれん"],[34,1,"きん"],[36,1,"か"],[46,1,"はだか"],[48,1,"はじ"],[57,1,"み"],[59,1,"つ"],[66,1,"しろ"],[68,1,"ころも"],[70,1,"か"],[79,1,"み"],[90,1,"め"],[94,2,"めぐすり"],[97,1,"か"]],"text":"そこで、あなたに勧める。富む者となるために、わたしから火で精錬された金を買い、また、あなたの裸の恥をさらさないため身に着けるように、白い衣を買いなさい。また、見えるようになるため、目にぬる目薬を買いなさい。"},{"ref":"Rev.3.19","start":66003019,"end":66003019,"break":"none","ruby":[[7,1,"あい"],[12,1,"もの"],[25,1,"こ"],[38,2,"ねっしん"],[44,1,"く"],[46,1,"あらた"]],"text":"すべてわたしの愛している者を、わたしはしかったり、懲らしめたりする。だから、熱心になって悔い改めなさい。"},{"ref":"Rev.3.20","start":66003020,"end":66003020,"break":"none","ruby":[[0,1,"み"],[7,1,"と"],[9,1,"そと"],[11,1,"た"],[30,1,"こえ"],[32,1,"き"],[35,1,"と"],[49,1,"なか"],[55,1,"かれ"],[57,1,"しょく"],[59,1,"とも"],[63,1,"かれ"],[71,1,"しょく"],[73,1,"とも"]],"text":"見よ、わたしは戸の外に立って、たたいている。だれでもわたしの声を聞いて戸をあけるなら、わたしはその中にはいって彼と食を共にし、彼もまたわたしと食を共にするであろう。"},{"ref":"Rev.3.21","start":66003021,"end":66003021,"break":"none","ruby":[[0,2,"しょうり"],[3,1,"え"],[5,1,"もの"],[13,1,"とも"],[19,1,"ざ"],[39,2,"しょうり"],[42,1,"え"],[48,1,"ちち"],[50,1,"とも"],[54,2,"みざ"],[62,2,"どうよう"]],"text":"勝利を得る者には、わたしと共にわたしの座につかせよう。それはちょうど、わたしが勝利を得てわたしの父と共にその御座についたのと同様である。"},{"ref":"Rev.3.22","start":66003022,"end":66003022,"break":"none","ruby":[[0,1,"みみ"],[4,1,"もの"],[7,2,"みたま"],[10,1,"しょ"],[11,2,"きょうかい"],[14,1,"い"],[19,1,"き"]],"text":"耳のある者は、御霊が諸教会に言うことを聞くがよい』」。"}]