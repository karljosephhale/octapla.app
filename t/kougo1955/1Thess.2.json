[{"ref":"1Thess.2.1","start":52002001,"end":52002001,"break":"paragraph","ruby":[[0,2,"きょうだい"],[11,2,"じしん"],[14,1,"し"],[35,1,"ところ"],[41,1,"い"]],"text":"兄弟たちよ。あなたがた自身が知っているとおり、わたしたちがあなたがたの所にはいって行ったことは、むだではなかった。"},{"ref":"1Thess.2.2","start":52002002,"end":52002002,"break":"none","ruby":[[13,1,"し"],[29,1,"さき"],[35,1,"くる"],[63,1,"かみ"],[65,2,"ゆうき"],[68,1,"あた"],[74,1,"はげ"],[77,2,"くとう"],[83,1,"かみ"],[85,2,"ふくいん"],[94,1,"かた"]],"text":"それどころか、あなたがたが知っているように、わたしたちは、先にピリピで苦しめられ、はずかしめられたにもかかわらず、わたしたちの神に勇気を与えられて、激しい苦闘のうちに神の福音をあなたがたに語ったのである。"},{"ref":"1Thess.2.3","start":52002003,"end":52002003,"break":"none","ruby":[[11,2,"せんきょう"],[15,1,"まよ"],[18,1,"けが"],[21,1,"こころ"],[24,1,"で"]],"text":"いったい、わたしたちの宣教は、迷いや汚れた心から出たものでもなく、だましごとでもない。"},{"ref":"1Thess.2.4","start":52002004,"end":52002004,"break":"none","ruby":[[11,1,"かみ"],[13,1,"しん"],[14,1,"にん"],[16,1,"う"],[19,2,"ふくいん"],[22,1,"たく"],[29,2,"にんげん"],[32,1,"よろこ"],[49,1,"こころ"],[51,2,"みわ"],[55,1,"かみ"],[57,1,"よろこ"],[65,2,"ふくいん"],[68,1,"かた"]],"text":"かえって、わたしたちは神の信任を受けて福音を託されたので、人間に喜ばれるためではなく、わたしたちの心を見分ける神に喜ばれるように、福音を語るのである。"},{"ref":"1Thess.2.5","start":52002005,"end":52002005,"break":"none","ruby":[[13,1,"し"],[22,1,"けっ"],[30,2,"ことば"],[33,1,"もち"],[42,2,"こうじつ"],[45,1,"もう"],[64,1,"かみ"],[71,1,"くだ"]],"text":"わたしたちは、あなたがたが知っているように、決してへつらいの言葉を用いたこともなく、口実を設けて、むさぼったこともない。それは、神があかしして下さる。"},{"ref":"1Thess.2.6","start":52002006,"end":52002006,"break":"none","ruby":[[15,2,"しと"],[20,1,"おも"],[53,2,"ひとびと"],[62,2,"にんげん"],[67,2,"えいよ"],[70,1,"もと"]],"text":"また、わたしたちは、キリストの使徒として重んじられることができたのであるが、あなたがたからにもせよ、ほかの人々からにもせよ、人間からの栄誉を求めることはしなかった。"},{"ref":"1Thess.2.7","start":52002007,"end":52002007,"break":"none","ruby":[[10,1,"あいだ"],[17,1,"はは"],[21,2,"こども"],[24,1,"そだ"]],"text":"むしろ、あなたがたの間で、ちょうど母がその子供を育てるように、やさしくふるまった。"},{"ref":"1Thess.2.8","start":52002008,"end":52002008,"break":"none","ruby":[[12,1,"した"],[16,1,"おも"],[26,1,"かみ"],[28,2,"ふくいん"],[38,2,"じぶん"],[53,1,"あた"],[58,1,"ねが"],[71,1,"あい"]],"text":"このように、あなたがたを慕わしく思っていたので、ただ神の福音ばかりではなく、自分のいのちまでもあなたがたに与えたいと願ったほどに、あなたがたを愛したのである。"},{"ref":"1Thess.2.9","start":52002009,"end":52002009,"break":"none","ruby":[[0,2,"きょうだい"],[18,2,"ろうく"],[21,2,"どりょく"],[25,2,"きおく"],[53,2,"ふたん"],[61,1,"おも"],[65,2,"にちや"],[81,1,"かみ"],[83,2,"ふくいん"],[86,1,"の"],[88,1,"つた"]],"text":"兄弟たちよ。あなたがたはわたしたちの労苦と努力とを記憶していることであろう。すなわち、あなたがたのだれにも負担をかけまいと思って、日夜はたらきながら、あなたがたに神の福音を宣べ伝えた。"},{"ref":"1Thess.2.10","start":52002010,"end":52002010,"break":"none","ruby":[[11,1,"かみ"],[18,1,"くだ"],[36,2,"しんじゃ"],[39,1,"まえ"],[42,2,"しんじん"],[44,1,"ぶか"],[47,1,"ただ"],[51,1,"せ"],[66,2,"せいかつ"]],"text":"あなたがたもあかしし、神もあかしして下さるように、わたしたちはあなたがた信者の前で、信心深く、正しく、責められるところがないように、生活をしたのである。"},{"ref":"1Thess.2.11","start":52002011,"end":52002011,"break":"none","ruby":[[10,1,"し"],[19,1,"ちち"],[23,1,"こ"],[25,1,"たい"],[47,1,"たい"]],"text":"そして、あなたがたも知っているとおり、父がその子に対してするように、あなたがたのひとりびとりに対して、"},{"ref":"1Thess.2.12","start":52002012,"end":52002012,"break":"none","ruby":[[0,2,"みくに"],[5,2,"えいこう"],[9,1,"め"],[12,1,"くだ"],[16,1,"かみ"],[27,1,"ある"],[34,1,"すす"],[37,1,"はげ"]],"text":"御国とその栄光とに召して下さった神のみこころにかなって歩くようにと、勧め、励まし、また、さとしたのである。"},{"ref":"1Thess.2.13","start":52002013,"end":52002013,"break":"paragraph","ruby":[[7,1,"かんが"],[19,1,"た"],[22,1,"かみ"],[24,2,"かんしゃ"],[45,1,"と"],[48,1,"かみ"],[50,1,"ことば"],[52,1,"き"],[55,1,"とき"],[61,2,"にんげん"],[64,2,"ことば"],[74,1,"かみ"],[76,1,"ことば"],[82,2,"じじつ"],[95,1,"う"],[115,1,"かみ"],[117,1,"ことば"],[120,1,"しん"],[132,1,"はたら"]],"text":"これらのことを考えて、わたしたちがまた絶えず神に感謝しているのは、あなたがたがわたしたちの説いた神の言を聞いた時に、それを人間の言葉としてではなく、神の言として――事実そのとおりであるが――受けいれてくれたことである。そして、この神の言は、信じるあなたがたのうちに働いているのである。"},{"ref":"1Thess.2.14","start":52002014,"end":52002014,"break":"none","ruby":[[0,2,"きょうだい"],[29,1,"かみ"],[31,1,"しょ"],[32,2,"きょうかい"],[38,1,"もの"],[49,1,"かれ"],[55,1,"じん"],[60,1,"くる"],[67,1,"おな"],[81,3,"どうこくじん"],[86,1,"くる"]],"text":"兄弟たちよ。あなたがたは、ユダヤの、キリスト・イエスにある神の諸教会にならう者となった。すなわち、彼らがユダヤ人たちから苦しめられたと同じように、あなたがたもまた同国人から苦しめられた。"},{"ref":"1Thess.2.15","start":52002015,"end":52002015,"break":"none","ruby":[[3,1,"じん"],[7,1,"しゅ"],[12,3,"よげんしゃ"],[19,1,"ころ"],[28,2,"はくがい"],[32,1,"かみ"],[34,1,"よろこ"],[43,1,"ひと"],[45,1,"さか"]],"text":"ユダヤ人たちは主イエスと預言者たちとを殺し、わたしたちを迫害し、神を喜ばせず、すべての人に逆らい、"},{"ref":"1Thess.2.16","start":52002016,"end":52002016,"break":"none","ruby":[[6,3,"いほうじん"],[10,1,"すくい"],[12,1,"ことば"],[14,1,"かた"],[18,1,"さまた"],[22,1,"た"],[25,2,"じぶん"],[28,1,"つみ"],[30,1,"み"],[41,1,"かみ"],[43,1,"いか"],[46,1,"もっと"],[48,1,"はげ"],[51,1,"かれ"],[54,1,"のぞ"],[57,1,"いた"]],"text":"わたしたちが異邦人に救の言を語るのを妨げて、絶えず自分の罪を満たしている。そこで、神の怒りは最も激しく彼らに臨むに至ったのである。"},{"ref":"1Thess.2.17","start":52002017,"end":52002017,"break":"paragraph","ruby":[[0,2,"きょうだい"],[18,1,"あいだ"],[27,1,"ひ"],[29,1,"はな"],[39,1,"こころ"],[72,1,"かお"],[74,1,"み"],[78,1,"せつ"]],"text":"兄弟たちよ。わたしたちは、しばらくの間、あなたがたから引き離されていたので――心においてではなく、からだだけではあるが――なおさら、あなたがたの顔を見たいと切にこいねがった。"},{"ref":"1Thess.2.18","start":52002018,"end":52002018,"break":"none","ruby":[[17,1,"ところ"],[19,1,"い"],[37,2,"いっさい"],[42,1,"い"],[69,1,"さまた"]],"text":"だから、わたしたちは、あなたがたの所に行こうとした。ことに、このパウロは、一再ならず行こうとしたのである。それだのに、わたしたちはサタンに妨げられた。"},{"ref":"1Thess.2.19","start":52002019,"end":52002019,"break":"none","ruby":[[0,2,"じっさい"],[9,1,"しゅ"],[14,2,"らいりん"],[28,1,"のぞ"],[31,1,"よろこ"],[34,1,"ほこり"],[36,1,"かんむり"],[42,1,"もの"],[51,1,"ほか"]],"text":"実際、わたしたちの主イエスの来臨にあたって、わたしたちの望みと喜びと誇の冠となるべき者は、あなたがたを外にして、だれがあるだろうか。"},{"ref":"1Thess.2.20","start":52002020,"end":52002020,"break":"none","ruby":[[8,1,"じつ"],[23,1,"よろこ"]],"text":"あなたがたこそ、実にわたしたちのほまれであり、喜びである。"}]