[{"ref":"Isa.63.1","start":23063001,"end":23063001,"break":"paragraph","breaks":[[12,"line"],[33,"line"],[45,"line"],[65,"line"],[74,"line"]],"ruby":[[8,1,"く"],[10,1,"もの"],[12,2,"しんく"],[15,1,"ころも"],[17,1,"き"],[25,1,"く"],[27,1,"もの"],[35,1,"よそお"],[45,1,"おお"],[49,1,"ちから"],[54,1,"すす"],[56,1,"く"],[58,1,"もの"],[66,1,"ぎ"],[71,1,"かた"],[74,1,"すくい"],[76,1,"ほどこ"],[78,1,"ちから"]],"text":"「このエドムから来る者、深紅の衣を着て、ボズラから来る者はだれか。その装いは、はなやかに、大いなる力をもって進み来る者はだれか」。「義をもって語り、救を施す力あるわたしがそれだ」。"},{"ref":"Isa.63.2","start":23063002,"end":23063002,"break":"line","breaks":[[14,"line"]],"ruby":[[1,1,"なに"],[8,1,"よそお"],[11,1,"あか"],[18,1,"ころも"],[20,1,"さか"],[24,1,"ふ"],[26,1,"もの"],[31,1,"あか"]],"text":"「何ゆえあなたの装いは赤く、あなたの衣は酒ぶねを踏む者のように赤いのか」。"},{"ref":"Isa.63.3","start":23063003,"end":23063003,"break":"line","breaks":[[17,"line"],[28,"line"],[45,"line"],[61,"line"],[79,"line"],[94,"line"]],"ruby":[[9,1,"さか"],[13,1,"ふ"],[22,1,"たみ"],[32,1,"こと"],[34,1,"とも"],[38,1,"もの"],[49,1,"いか"],[55,1,"かれ"],[58,1,"ふ"],[61,1,"いきどお"],[67,1,"かれ"],[70,1,"ふ"],[79,1,"かれ"],[82,1,"ち"],[86,1,"ころも"],[96,1,"よそお"],[104,1,"けが"]],"text":"「わたしはひとりで酒ぶねを踏んだ。もろもろの民のなかに、わたしと事を共にする者はなかった。わたしは怒りによって彼らを踏み、憤りによって彼らを踏みにじったので、彼らの血がわが衣にふりかかり、わが装いをことごとく汚した。"},{"ref":"Isa.63.4","start":23063004,"end":23063004,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"ほうふく"],[3,1,"ひ"],[7,1,"こころ"],[22,1,"とし"],[24,1,"き"]],"text":"報復の日がわが心のうちにあり、わがあがないの年が来たからである。"},{"ref":"Isa.63.5","start":23063005,"end":23063005,"break":"line","breaks":[[19,"line"],[39,"line"],[58,"line"]],"ruby":[[4,1,"み"],[11,1,"たす"],[14,1,"もの"],[19,1,"あや"],[32,1,"もの"],[54,1,"か"],[60,1,"いきどお"]],"text":"わたしは見たけれども、助ける者はなく、怪しんだけれども、ささえる者はなかった。それゆえ、わがかいながわたしを勝たせ、わが憤りがわたしをささえた。"},{"ref":"Isa.63.6","start":23063006,"end":23063006,"break":"line","breaks":[[24,"line"],[37,"line"]],"ruby":[[4,1,"いか"],[16,1,"たみ"],[18,1,"ふ"],[24,1,"いきどお"],[30,1,"かれ"],[33,1,"よ"],[37,1,"かれ"],[40,1,"ち"],[43,1,"ち"],[45,1,"なが"]],"text":"わたしは怒りによって、もろもろの民を踏みにじり、憤りによって彼らを酔わせ、彼らの血を、地に流れさせた」。"},{"ref":"Isa.63.7","start":23063007,"end":23063007,"break":"paragraph","breaks":[[15,"line"],[26,"line"],[45,"line"],[58,"line"],[73,"line"],[85,"line"]],"ruby":[[4,1,"しゅ"],[26,1,"しゅ"],[35,1,"しゅ"],[37,1,"ほまれ"],[40,1,"かた"],[42,1,"つ"],[60,1,"おお"],[79,1,"いえ"],[81,1,"ほどこ"],[87,1,"おお"],[91,1,"めぐ"],[94,1,"かた"],[96,1,"つ"]],"text":"わたしは主がわれわれになされたすべてのことによって、主のいつくしみと、主の誉とを語り告げ、また、そのあわれみにより、その多くのいつくしみによって、イスラエルの家に施されたその大いなる恵みを語り告げよう。"},{"ref":"Isa.63.8","start":23063008,"end":23063008,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[12,1,"かれ"],[17,1,"たみ"],[19,1,"いつわ"],[24,1,"こ"],[35,1,"しゅ"],[37,1,"かれ"],[40,2,"すくいぬし"]],"text":"主は言われた、「まことに彼らはわが民、偽りのない子らである」と。そして主は彼らの救主となられた。"},{"ref":"Isa.63.9","start":23063009,"end":23063009,"break":"line","breaks":[[20,"line"],[36,"line"],[57,"line"],[74,"line"]],"ruby":[[0,1,"かれ"],[7,1,"なや"],[13,1,"しゅ"],[15,1,"なや"],[23,1,"まえ"],[25,1,"つかい"],[30,1,"かれ"],[33,1,"すく"],[38,1,"あい"],[49,1,"かれ"],[62,1,"ひ"],[67,1,"かれ"],[74,1,"かれ"],[77,1,"たずさ"]],"text":"彼らのすべての悩みのとき、主も悩まれて、そのみ前の使をもって彼らを救い、その愛とあわれみとによって彼らをあがない、いにしえの日、つねに彼らをもたげ、彼らを携えられた。"},{"ref":"Isa.63.10","start":23063010,"end":23063010,"break":"paragraph","breaks":[[11,"line"],[26,"line"],[42,"line"]],"ruby":[[4,1,"かれ"],[13,1,"せい"],[16,1,"れい"],[18,1,"うれ"],[26,1,"しゅ"],[34,1,"かれ"],[37,1,"てき"],[46,1,"かれ"],[49,1,"たたか"]],"text":"ところが彼らはそむいてその聖なる霊を憂えさせたので、主はひるがえって彼らの敵となり、みずから彼らと戦われた。"},{"ref":"Isa.63.11","start":23063011,"end":23063011,"break":"line","breaks":[[17,"line"],[26,"line"],[36,"line"],[53,"line"]],"ruby":[[2,1,"とき"],[4,1,"たみ"],[15,1,"ひ"],[17,1,"おも"],[19,1,"だ"],[22,1,"い"],[29,1,"む"],[32,2,"ぼくしゃ"],[36,1,"うみ"],[39,1,"たずさ"],[44,1,"もの"],[53,1,"かれ"],[56,1,"なか"],[58,1,"せい"],[61,1,"れい"],[66,1,"もの"]],"text":"その時、民はいにしえのモーセの日を思い出して言った、「その群れの牧者を、海から携えあげた者はどこにいるか。彼らの中に聖なる霊をおいた者はどこにいるか。"},{"ref":"Isa.63.12","start":23063012,"end":23063012,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[0,2,"えいこう"],[11,1,"みぎ"],[13,1,"い"],[17,1,"かれ"],[20,1,"まえ"],[22,1,"みず"],[27,1,"わ"],[41,1,"な"]],"text":"栄光のかいなをモーセの右に行かせ、彼らの前に水を二つに分けて、みずから、とこしえの名をつくり、"},{"ref":"Isa.63.13","start":23063013,"end":23063013,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"みちび"],[7,1,"うま"],[9,1,"の"],[11,1,"はし"],[25,1,"ふち"],[27,1,"とお"],[31,1,"もの"]],"text":"彼らを導いて、馬が野を走るように、つまずくことなく淵を通らせた者はどこにいるか。"},{"ref":"Isa.63.14","start":23063014,"end":23063014,"break":"line","breaks":[[12,"line"],[27,"line"],[46,"line"]],"ruby":[[0,1,"たに"],[5,2,"かちく"],[12,1,"しゅ"],[14,1,"れい"],[16,1,"かれ"],[41,1,"たみ"],[43,1,"みちび"],[50,2,"えいこう"],[53,1,"な"]],"text":"谷にくだる家畜のように、主の霊は彼らをいこわせられた。このように、あなたはおのれの民を導いてみずから栄光の名をつくられた」。"},{"ref":"Isa.63.15","start":23063015,"end":23063015,"break":"paragraph","breaks":[[12,"line"],[34,"line"],[55,"line"],[72,"line"]],"ruby":[[4,1,"てん"],[7,1,"み"],[14,1,"せい"],[17,2,"えいこう"],[38,2,"ねっしん"],[42,2,"たいのう"],[63,2,"どうじょう"]],"text":"どうか、天から見おろし、その聖なる栄光あるすみかからごらんください。あなたの熱心と、大能とはどこにありますか。あなたのせつなる同情とあわれみとはおさえられて、わたしにあらわれません。"},{"ref":"Isa.63.16","start":23063016,"end":23063016,"break":"line","breaks":[[18,"line"],[36,"line"],[49,"line"],[63,"line"],[75,"line"]],"ruby":[[14,1,"し"],[29,1,"みと"],[45,1,"ちち"],[49,1,"しゅ"],[61,1,"ちち"],[73,1,"な"],[84,1,"ぬし"]],"text":"たといアブラハムがわれわれを知らず、イスラエルがわれわれを認めなくても、あなたはわれわれの父です。主よ、あなたはわれわれの父、いにしえからあなたの名はわれわれのあながい主です。"},{"ref":"Isa.63.17","start":23063017,"end":23063017,"break":"line","breaks":[[24,"line"],[39,"line"],[58,"line"],[75,"line"],[92,"line"]],"ruby":[[0,1,"しゅ"],[15,1,"みち"],[18,1,"はな"],[20,1,"まよ"],[29,1,"こころ"],[43,1,"おそ"],[79,1,"し"],[80,1,"ぎょう"],[84,2,"ぶぞく"],[93,1,"かえ"]],"text":"主よ、なぜ、われわれをあなたの道から離れ迷わせ、われわれの心をかたくなにして、あなたを恐れないようにされるのですか。どうぞ、あなたのしもべらのために、あなたの嗣業である部族らのために、お帰りください。"},{"ref":"Isa.63.18","start":23063018,"end":23063018,"break":"line","breaks":[[10,"line"],[26,"line"]],"ruby":[[4,1,"せい"],[7,1,"たみ"],[14,2,"せいじょ"],[17,1,"え"],[19,1,"あいだ"],[38,1,"ふ"]],"text":"あなたの聖なる民が、あなたの聖所を獲て間もないのに、われわれのあだは、それを踏みにじりました。"},{"ref":"Isa.63.19","start":23063019,"end":23063019,"break":"line","breaks":[[13,"line"],[33,"line"],[43,"line"]],"ruby":[[19,1,"おさ"],[25,1,"もの"],[37,1,"な"],[50,1,"もの"]],"text":"われわれはあなたによって、いにしえから治められない者のようになり、あなたの名をもって、となえられない者のようになりました。"}]