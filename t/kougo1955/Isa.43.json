[{"ref":"Isa.43.1","start":23043001,"end":23043001,"break":"paragraph","breaks":[[49,"stanza"],[69,"line"],[83,"line"]],"ruby":[[9,2,"そうぞう"],[14,1,"しゅ"],[18,1,"い"],[34,1,"つく"],[38,1,"しゅ"],[44,1,"い"],[50,1,"おそ"],[77,1,"な"],[79,1,"よ"]],"text":"ヤコブよ、あなたを創造された主はこう言われる。イスラエルよ、あなたを造られた主はいまこう言われる、「恐れるな、わたしはあなたをあがなった。わたしはあなたの名を呼んだ、あなたはわたしのものだ。"},{"ref":"Isa.43.2","start":23043002,"end":23043002,"break":"line","breaks":[[14,"line"],[27,"line"],[37,"line"],[55,"line"],[78,"line"]],"ruby":[[4,1,"みず"],[6,1,"なか"],[8,1,"す"],[22,1,"とも"],[27,1,"かわ"],[29,1,"なか"],[31,1,"す"],[37,1,"みず"],[43,1,"うえ"],[59,1,"ひ"],[61,1,"なか"],[63,1,"い"],[68,1,"や"],[78,1,"ほのお"],[84,1,"も"]],"text":"あなたが水の中を過ぎるとき、わたしはあなたと共におる。川の中を過ぎるとき、水はあなたの上にあふれることがない。あなたが火の中を行くとき、焼かれることもなく、炎もあなたに燃えつくことがない。"},{"ref":"Isa.43.3","start":23043003,"end":23043003,"break":"line","breaks":[[15,"line"],[34,"line"],[46,"line"],[59,"line"]],"ruby":[[8,1,"かみ"],[10,1,"しゅ"],[21,2,"せいじゃ"],[28,2,"すくいぬし"],[43,1,"あた"],[73,1,"かわ"]],"text":"わたしはあなたの神、主である、イスラエルの聖者、あなたの救主である。わたしはエジプトを与えてあなたのあがないしろとし、エチオピヤとセバとをあなたの代りとする。"},{"ref":"Isa.43.4","start":23043004,"end":23043004,"break":"line","breaks":[[20,"line"],[36,"line"],[48,"line"]],"ruby":[[6,1,"め"],[8,1,"たっと"],[11,1,"おも"],[28,1,"あい"],[40,1,"かわ"],[43,1,"ひと"],[45,1,"あた"],[52,1,"いのち"],[54,1,"かわ"],[57,1,"たみ"],[59,1,"あた"]],"text":"あなたはわが目に尊く、重んぜられるもの、わたしはあなたを愛するがゆえに、あなたの代りに人を与え、あなたの命の代りに民を与える。"},{"ref":"Isa.43.5","start":23043005,"end":23043005,"break":"line","breaks":[[18,"line"],[37,"line"]],"ruby":[[0,1,"おそ"],[13,1,"とも"],[27,2,"しそん"],[30,1,"ひがし"],[37,1,"にし"],[44,1,"あつ"]],"text":"恐れるな、わたしはあなたと共におる。わたしは、あなたの子孫を東からこさせ、西からあなたを集める。"},{"ref":"Isa.43.6","start":23043006,"end":23043006,"break":"line","breaks":[[19,"line"],[35,"line"],[48,"line"]],"ruby":[[4,1,"きた"],[16,1,"い"],[19,1,"みなみ"],[26,1,"と"],[32,1,"い"],[37,1,"こ"],[40,1,"とお"],[50,1,"むすめ"],[53,1,"ち"],[55,1,"はて"]],"text":"わたしは北にむかって『ゆるせ』と言い、南にむかって『留めるな』と言う。わが子らを遠くからこさせ、わが娘らを地の果からこさせよ。"},{"ref":"Isa.43.7","start":23043007,"end":23043007,"break":"line","breaks":[[23,"line"],[42,"line"]],"ruby":[[5,1,"な"],[16,1,"もの"],[27,1,"かれ"],[32,2,"えいこう"],[38,2,"そうぞう"],[45,1,"つく"],[51,2,"した"]],"text":"すべてわが名をもってとなえられる者をこさせよ。わたしは彼らをわが栄光のために創造し、これを造り、これを仕立てた」。"},{"ref":"Isa.43.8","start":23043008,"end":23043008,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[0,1,"め"],[6,1,"め"],[13,1,"たみ"],[15,1,"みみ"],[21,1,"みみ"],[28,1,"たみ"],[30,1,"つ"],[32,1,"だ"]],"text":"目があっても目しいのような民、耳があっても耳しいのような民を連れ出せ。"},{"ref":"Isa.43.9","start":23043009,"end":23043009,"break":"line","breaks":[[10,"line"],[21,"line"],[37,"line"],[45,"line"],[62,"line"],[85,"line"]],"ruby":[[0,2,"くにぐに"],[5,1,"あい"],[15,1,"たみ"],[17,1,"あつ"],[21,1,"かれ"],[32,1,"こと"],[34,1,"つ"],[40,1,"こと"],[50,1,"き"],[64,2,"しょうにん"],[67,1,"だ"],[75,1,"ただ"],[78,1,"こと"],[80,2,"しょうめい"],[88,1,"き"],[95,2,"しんじつ"],[100,1,"い"]],"text":"国々はみな相つどい、もろもろの民は集まれ。彼らのうち、だれがこの事を告げ、さきの事どもを、われわれに聞かせることができるか。その証人を出して、おのれの正しい事を証明させ、それを聞いて「これは真実だ」と言わせよ。"},{"ref":"Isa.43.10","start":23043010,"end":23043010,"break":"line","breaks":[[19,"line"],[35,"line"],[57,"line"],[77,"line"],[93,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[16,2,"しょうにん"],[23,1,"えら"],[46,1,"し"],[54,1,"しん"],[61,1,"しゅ"],[68,1,"さと"],[82,1,"まえ"],[84,1,"つく"],[88,1,"かみ"],[98,1,"のち"]],"text":"主は言われる、「あなたがたはわが証人、わたしが選んだわがしもべである。それゆえ、あなたがたは知って、わたしを信じ、わたしが主であることを悟ることができる。わたしより前に造られた神はなく、わたしより後にもない。"},{"ref":"Isa.43.11","start":23043011,"end":23043011,"break":"line","breaks":[[12,"line"]],"ruby":[[7,1,"しゅ"],[19,1,"すく"],[21,1,"もの"]],"text":"ただわたしのみ主である。わたしのほかに救う者はいない。"},{"ref":"Isa.43.12","start":23043012,"end":23043012,"break":"line","breaks":[[22,"line"],[43,"line"]],"ruby":[[7,1,"つ"],[12,1,"すく"],[17,1,"き"],[36,1,"かみ"],[51,2,"しょうにん"],[58,1,"しゅ"],[60,1,"い"]],"text":"わたしはさきに告げ、かつ救い、かつ聞かせた。あなたがたのうちには、ほかの神はなかった。あなたがたはわが証人である」と主は言われる。"},{"ref":"Isa.43.13","start":23043013,"end":23043013,"break":"line","breaks":[[24,"line"],[40,"line"],[50,"line"]],"ruby":[[5,1,"かみ"],[10,1,"いま"],[13,1,"のち"],[19,1,"しゅ"],[26,1,"て"],[29,1,"すく"],[31,1,"だ"],[35,1,"もの"]],"text":"「わたしは神である、今より後もわたしは主である。わが手から救い出しうる者はない。わたしがおこなえば、だれが、これをとどめることができよう」。"},{"ref":"Isa.43.14","start":23043014,"end":23043014,"break":"paragraph","breaks":[[21,"line"],[30,"line"],[41,"line"],[57,"line"],[69,"line"]],"ruby":[[10,1,"もの"],[18,2,"せいじゃ"],[21,1,"しゅ"],[25,1,"い"],[45,1,"ひと"],[61,1,"かん"],[63,1,"き"],[76,1,"よろこ"],[79,1,"こえ"],[81,1,"なげ"],[84,1,"かわ"]],"text":"あなたがたをあがなう者、イスラエルの聖者、主はこう言われる、「あなたがたのために、わたしは人をバビロンにつかわし、すべての貫の木をこわし、カルデヤびとの喜びの声を嘆きに変らせる。"},{"ref":"Isa.43.15","start":23043015,"end":23043015,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"しゅ"],[12,2,"せいじゃ"],[21,3,"そうぞうしゃ"],[31,1,"おう"]],"text":"わたしは主、あなたがたの聖者、イスラエルの創造者、あなたがたの王である」。"},{"ref":"Isa.43.16","start":23043016,"end":23043016,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"うみ"],[5,2,"おおじ"],[8,1,"もう"],[11,1,"おお"],[15,1,"みず"],[17,1,"なか"],[19,1,"みち"]],"text":"海のなかに大路を設け、大いなる水の中に道をつくり、"},{"ref":"Isa.43.17","start":23043017,"end":23043017,"break":"line","breaks":[[21,"line"],[42,"line"],[63,"line"]],"ruby":[[0,2,"せんしゃ"],[5,1,"うま"],[7,2,"ぐんぜい"],[12,2,"へいし"],[15,1,"で"],[24,1,"たお"],[27,1,"お"],[42,1,"た"],[44,1,"ほろ"],[49,2,"とうしん"],[52,1,"き"],[63,1,"しゅ"],[67,1,"い"]],"text":"戦車および馬、軍勢および兵士を出てこさせ、これを倒して起きることができないようにし、絶え滅ぼして、灯心の消えうせるようにされる主はこう言われる、"},{"ref":"Isa.43.18","start":23043018,"end":23043018,"break":"line","breaks":[[24,"line"]],"ruby":[[11,1,"こと"],[13,1,"おも"],[15,1,"だ"],[35,1,"かんが"]],"text":"「あなたがたは、さきの事を思い出してはならない、また、いにしえのことを考えてはならない。"},{"ref":"Isa.43.19","start":23043019,"end":23043019,"break":"line","breaks":[[15,"line"],[24,"line"],[40,"line"],[52,"line"]],"ruby":[[0,1,"み"],[7,1,"あたら"],[10,1,"こと"],[21,1,"おこ"],[33,1,"し"],[44,2,"あらの"],[47,1,"みち"],[49,1,"もう"],[56,1,"かわ"],[58,1,"なが"]],"text":"見よ、わたしは新しい事をなす。やがてそれは起る、あなたがたはそれを知らないのか。わたしは荒野に道を設け、さばくに川を流れさせる。"},{"ref":"Isa.43.20","start":23043020,"end":23043020,"break":"line","breaks":[[12,"line"],[32,"line"],[45,"line"],[57,"line"]],"ruby":[[0,1,"の"],[2,1,"けもの"],[12,2,"やまいぬ"],[36,2,"あらの"],[39,1,"みず"],[49,1,"かわ"],[51,1,"なが"],[61,1,"えら"],[64,1,"たみ"],[66,1,"の"]],"text":"野の獣はわたしをあがめ、山犬および、だちょうもわたしをあがめる。わたしが荒野に水をいだし、さばくに川を流れさせて、わたしの選んだ民に飲ませるからだ。"},{"ref":"Isa.43.21","start":23043021,"end":23043021,"break":"line","breaks":[[17,"line"]],"ruby":[[2,1,"たみ"],[7,1,"ほまれ"],[9,1,"の"],[21,2,"じぶん"],[27,1,"つく"]],"text":"この民は、わが誉を述べさせるためにわたしが自分のために造ったものである。"},{"ref":"Isa.43.22","start":23043022,"end":23043022,"break":"paragraph","breaks":[[24,"line"]],"ruby":[[17,1,"よ"]],"text":"ところがヤコブよ、あなたはわたしを呼ばなかった。イスラエルよ、あなたはわたしをうとんじた。"},{"ref":"Isa.43.23","start":23043023,"end":23043023,"break":"line","breaks":[[22,"line"],[42,"line"],[65,"line"]],"ruby":[[4,2,"はんさい"],[7,1,"ひつじ"],[13,1,"も"],[24,2,"ぎせい"],[46,1,"そな"],[48,1,"もの"],[50,2,"おもに"],[57,1,"お"],[67,2,"にゅうこう"],[77,1,"わずら"]],"text":"あなたは燔祭の羊をわたしに持ってこなかった。また犠牲をもってわたしをあがめなかった。わたしは供え物の重荷をあなたに負わせなかった。また乳香をもってあなたを煩わさなかった。"},{"ref":"Isa.43.24","start":23043024,"end":23043024,"break":"line","breaks":[[10,"line"],[24,"line"],[43,"line"],[65,"line"]],"ruby":[[4,1,"かね"],[6,1,"だ"],[17,2,"しょうぶ"],[20,1,"か"],[24,2,"ぎせい"],[27,2,"しぼう"],[30,1,"そな"],[38,1,"あ"],[52,1,"つみ"],[54,2,"おもに"],[61,1,"お"],[69,2,"ふぎ"],[80,1,"わずら"]],"text":"あなたは金を出して、わたしのために菖蒲を買わず、犠牲の脂肪を供えて、わたしを飽かせず、かえって、あなたの罪の重荷をわたしに負わせ、あなたの不義をもって、わたしを煩わせた。"},{"ref":"Isa.43.25","start":23043025,"end":23043025,"break":"paragraph","breaks":[[15,"line"],[29,"line"]],"ruby":[[9,2,"じしん"],[22,1,"け"],[24,1,"もの"],[38,1,"つみ"],[40,1,"こころ"]],"text":"わたしこそ、わたし自身のためにあなたのとがを消す者である。わたしは、あなたの罪を心にとめない。"},{"ref":"Isa.43.26","start":23043026,"end":23043026,"break":"line","breaks":[[21,"line"],[42,"line"]],"ruby":[[5,2,"じぶん"],[8,1,"ただ"],[14,2,"しょうめい"],[21,2,"じぶん"],[27,1,"の"],[35,1,"おも"],[37,1,"だ"],[47,1,"とも"],[49,1,"ろん"]],"text":"あなたは、自分の正しいことを証明するために自分のことを述べて、わたしに思い出させよ。われわれは共に論じよう。"},{"ref":"Isa.43.27","start":23043027,"end":23043027,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"とお"],[6,2,"せんぞ"],[9,1,"つみ"],[11,1,"おか"],[18,3,"ちゅうほしゃ"]],"text":"あなたの遠い先祖は罪を犯し、あなたの仲保者らはわたしにそむいた。"},{"ref":"Isa.43.28","start":23043028,"end":23043028,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[9,2,"せいじょ"],[12,1,"きみ"],[16,1,"けが"],[23,1,"まった"],[25,1,"ほろ"]],"text":"それゆえ、わたしは聖所の君たちを汚し、ヤコブを全き滅びにわたし、イスラエルをののしらしめた。"}]