[{"ref":"Job.32.1","start":18032001,"end":18032001,"break":"paragraph","ruby":[[8,2,"じぶん"],[11,1,"ただ"],[17,2,"しゅちょう"],[28,1,"にん"],[30,1,"もの"],[35,1,"こた"]],"text":"このようにヨブが自分の正しいことを主張したので、これら三人の者はヨブに答えるのをやめた。"},{"ref":"Job.32.2","start":18032002,"end":18032002,"break":"none","ruby":[[2,1,"とき"],[5,1,"ぞく"],[16,1,"こ"],[21,1,"いか"],[24,1,"おこ"],[35,1,"かみ"],[39,2,"じぶん"],[42,1,"ただ"],[48,2,"しゅちょう"],[55,1,"かれ"],[60,1,"む"],[64,1,"いか"],[67,1,"おこ"]],"text":"その時ラム族のブズびとバラケルの子エリフは怒りを起した。すなわちヨブが神よりも自分の正しいことを主張するので、彼はヨブに向かって怒りを起した。"},{"ref":"Job.32.3","start":18032003,"end":18032003,"break":"none","ruby":[[6,1,"にん"],[8,1,"とも"],[13,1,"つみ"],[22,1,"こた"],[25,2,"ことば"],[39,1,"かれ"],[47,1,"いか"],[50,1,"おこ"]],"text":"またヨブの三人の友がヨブを罪ありとしながら、答える言葉がなかったので、エリフは彼らにむかっても怒りを起した。"},{"ref":"Job.32.4","start":18032004,"end":18032004,"break":"none","ruby":[[4,1,"かれ"],[7,1,"みな"],[9,2,"じぶん"],[14,3,"ねんちょうしゃ"],[27,2,"ものい"],[37,1,"ま"]],"text":"エリフは彼らが皆、自分よりも年長者であったので、ヨブに物言うことをひかえて待っていたが、"},{"ref":"Job.32.5","start":18032005,"end":18032005,"break":"none","ruby":[[8,1,"にん"],[10,1,"くち"],[12,1,"こた"],[15,2,"ことば"],[22,1,"み"],[24,1,"いか"],[27,1,"おこ"]],"text":"ここにエリフは三人の口に答える言葉のないのを見て怒りを起した。"},{"ref":"Job.32.6","start":18032006,"end":18032006,"break":"paragraph","breaks":[[21,"stanza"],[43,"line"],[58,"line"]],"ruby":[[9,1,"こ"],[14,1,"こた"],[17,1,"い"],[26,1,"とし"],[27,1,"わか"],[36,2,"としお"],[62,2,"いけん"],[65,1,"の"]],"text":"ブズびとバラケルの子エリフは答えて言った、「わたしは年若く、あなたがたは年老いている。それゆえ、わたしははばかって、わたしの意見を述べることをあえてしなかった。"},{"ref":"Job.32.7","start":18032007,"end":18032007,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"おも"],[9,1,"ひ"],[11,1,"かさ"],[14,1,"もの"],[16,1,"かた"],[22,1,"とし"],[24,1,"つ"],[27,1,"もの"],[29,2,"ちえ"],[32,1,"おし"]],"text":"わたしは思った、『日を重ねた者が語るべきだ、年を積んだ者が知恵を教えるべきだ』と。"},{"ref":"Job.32.8","start":18032008,"end":18032008,"break":"line","breaks":[[14,"line"]],"ruby":[[3,1,"ひと"],[9,1,"れい"],[14,3,"ぜんのうしゃ"],[18,1,"いき"],[20,1,"ひと"],[22,1,"さと"],[25,1,"あた"]],"text":"しかし人のうちには霊があり、全能者の息が人に悟りを与える。"},{"ref":"Job.32.9","start":18032009,"end":18032009,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"お"],[3,1,"もの"],[5,1,"かなら"],[9,2,"ちえ"],[20,1,"とし"],[24,1,"もの"],[26,1,"かなら"],[30,2,"どうり"]],"text":"老いた者、必ずしも知恵があるのではなく、年とった者、必ずしも道理をわきまえるのではない。"},{"ref":"Job.32.10","start":18032010,"end":18032010,"break":"line","breaks":[[18,"line"]],"ruby":[[7,1,"い"],[15,1,"き"],[26,2,"いけん"],[29,1,"の"]],"text":"ゆえにわたしは言う、『わたしに聞け、わたしもまたわが意見を述べよう』。"},{"ref":"Job.32.11","start":18032011,"end":18032011,"break":"line","breaks":[[20,"line"],[34,"line"],[53,"line"]],"ruby":[[0,1,"み"],[13,2,"ことば"],[16,2,"きたい"],[22,2,"ちえ"],[26,2,"ことば"],[29,1,"みみ"],[31,1,"かたむ"],[40,1,"い"],[44,2,"ことば"],[47,1,"さが"],[49,1,"だ"],[53,1,"ま"]],"text":"見よ、わたしはあなたがたの言葉に期待し、その知恵ある言葉に耳を傾け、あなたがたが言うべき言葉を捜し出すのを待っていた。"},{"ref":"Job.32.12","start":18032012,"end":18032012,"break":"line","breaks":[[17,"line"],[36,"line"],[43,"line"]],"ruby":[[10,1,"こころ"],[29,1,"い"],[34,1,"もの"],[45,1,"かれ"],[47,2,"ことば"],[50,1,"こた"],[53,1,"もの"]],"text":"わたしはあなたがたに心をとめたが、あなたがたのうちにヨブを言いふせる者はひとりもなく、また彼の言葉に答える者はひとりもなかった。"},{"ref":"Job.32.13","start":18032013,"end":18032013,"break":"line","breaks":[[16,"line"],[31,"line"],[48,"line"]],"ruby":[[10,1,"い"],[22,2,"ちえ"],[25,1,"み"],[31,1,"かれ"],[33,1,"か"],[43,1,"かみ"],[48,1,"ひと"]],"text":"おそらくあなたがたは言うだろう、『われわれは知恵を見いだした、彼に勝つことのできるのは神だけで、人にはできない』と。"},{"ref":"Job.32.14","start":18032014,"end":18032014,"break":"line","breaks":[[21,"line"],[37,"line"]],"ruby":[[0,1,"かれ"],[4,2,"ことば"],[11,1,"む"],[14,1,"い"],[31,2,"ことば"],[37,1,"かれ"],[39,1,"こた"]],"text":"彼はその言葉をわたしに向けて言わなかった。わたしはあなたがたの言葉をもって彼に答えることはしない。"},{"ref":"Job.32.15","start":18032015,"end":18032015,"break":"stanza","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[3,1,"おどろ"],[10,1,"こた"],[19,1,"かれ"],[27,1,"い"],[31,2,"ことば"]],"text":"彼らは驚いて、もはや答えることをせず、彼らには、もはや言うべき言葉がない。"},{"ref":"Job.32.16","start":18032016,"end":18032016,"break":"line","breaks":[[8,"line"],[31,"line"]],"ruby":[[0,1,"かれ"],[3,2,"ものい"],[8,1,"た"],[19,1,"こた"],[37,2,"いじょう"],[39,1,"ま"],[41,2,"ひつよう"]],"text":"彼らは物言わず、立ちとどまって、もはや答えるところがないので、わたしはこれ以上待つ必要があろうか。"},{"ref":"Job.32.17","start":18032017,"end":18032017,"break":"line","breaks":[[15,"line"]],"ruby":[[10,1,"ぶん"],[12,1,"こた"],[19,2,"いけん"],[22,1,"の"]],"text":"わたしもまたわたしの分を答え、わたしの意見を述べよう。"},{"ref":"Job.32.18","start":18032018,"end":18032018,"break":"line","breaks":[[11,"line"]],"ruby":[[5,2,"ことば"],[8,1,"み"],[18,1,"れい"],[24,1,"せま"]],"text":"わたしには言葉が満ち、わたしのうちの霊がわたしに迫るからだ。"},{"ref":"Job.32.19","start":18032019,"end":18032019,"break":"line","breaks":[[24,"line"],[39,"line"]],"ruby":[[0,1,"み"],[7,1,"こころ"],[9,1,"くち"],[11,1,"ひら"],[18,1,"しゅ"],[24,1,"あたら"],[30,1,"しゅ"],[32,1,"かわ"],[33,1,"ぶくろ"],[39,1,"いま"],[42,1,"は"]],"text":"見よ、わたしの心は口を開かないぶどう酒のように、新しいぶどう酒の皮袋のように、今にも張りさけようとしている。"},{"ref":"Job.32.20","start":18032020,"end":18032020,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"かた"],[8,1,"き"],[10,1,"は"],[19,1,"ひら"],[22,1,"こた"]],"text":"わたしは語って、気を晴らし、くちびるを開いて答えよう。"},{"ref":"Job.32.21","start":18032021,"end":18032021,"break":"line","breaks":[[19,"line"]],"ruby":[[12,1,"み"],[21,2,"なにび"]],"text":"わたしはだれをもかたより見ることなく、また何人とにもへつらうことをしない。"},{"ref":"Job.32.22","start":18032022,"end":18032022,"break":"line","breaks":[[19,"line"],[40,"line"]],"ruby":[[11,1,"し"],[33,1,"つく"],[35,1,"ぬし"],[37,1,"ただ"],[44,1,"ほろ"]],"text":"わたしはへつらうことを知らないからだ。もしへつらうならば、わたしの造り主は直ちにわたしを滅ぼされるであろう。"}]