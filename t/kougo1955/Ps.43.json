[{"ref":"Ps.43.1","start":19043001,"end":19043001,"break":"paragraph","breaks":[[11,"line"],[24,"line"],[37,"line"],[52,"line"]],"ruby":[[0,1,"かみ"],[11,1,"かみ"],[13,1,"おそ"],[17,1,"たみ"],[28,1,"うった"],[49,1,"ひと"],[56,1,"たす"],[58,1,"だ"]],"text":"神よ、わたしをさばき、神を恐れない民にむかって、わたしの訴えをあげつらい、たばかりをなすよこしまな人からわたしを助け出してください。"},{"ref":"Ps.43.2","start":19043002,"end":19043002,"break":"line","breaks":[[16,"line"],[32,"line"],[48,"line"]],"ruby":[[8,1,"よ"],[10,1,"たの"],[12,1,"かみ"],[22,1,"す"],[38,1,"てき"],[48,1,"かな"],[51,1,"ある"]],"text":"あなたはわたしの寄り頼む神です。なぜわたしを捨てられたのですか。なぜわたしは敵のしえたげによって悲しみ歩くのですか。"},{"ref":"Ps.43.3","start":19043003,"end":19043003,"break":"line","breaks":[[21,"line"],[42,"line"]],"ruby":[[4,1,"ひかり"],[11,1,"おく"],[18,1,"みちび"],[25,1,"せい"],[28,1,"やま"],[35,1,"す"],[40,1,"ところ"]],"text":"あなたの光とまこととを送ってわたしを導き、あなたの聖なる山と、あなたの住まわれる所にわたしをいたらせてください。"},{"ref":"Ps.43.4","start":19043004,"end":19043004,"break":"line","breaks":[[15,"line"],[34,"line"],[42,"line"]],"ruby":[[2,1,"とき"],[7,1,"かみ"],[9,2,"さいだん"],[12,1,"い"],[19,1,"おお"],[22,1,"よろこ"],[27,1,"かみ"],[29,1,"い"],[34,1,"かみ"],[39,1,"かみ"],[46,1,"こと"]],"text":"その時わたしは神の祭壇へ行き、わたしの大きな喜びである神へ行きます。神よ、わが神よ、わたしは琴をもってあなたをほめたたえます。"},{"ref":"Ps.43.5","start":19043005,"end":19043005,"break":"line","breaks":[[16,"line"],[35,"line"],[42,"line"],[53,"line"]],"ruby":[[2,1,"たましい"],[5,1,"なに"],[16,1,"なに"],[26,1,"おも"],[35,1,"かみ"],[37,1,"ま"],[39,1,"のぞ"],[50,1,"たす"],[55,1,"かみ"],[58,1,"しゅ"]],"text":"わが魂よ、何ゆえうなだれるのか。何ゆえわたしのうちに思いみだれるのか。神を待ち望め。わたしはなおわが助け、わが神なる主をほめたたえるであろう。"}]