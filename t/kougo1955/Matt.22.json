[{"ref":"Matt.22.1","start":40022001,"end":40022001,"break":"paragraph","ruby":[[7,1,"たとえ"],[9,1,"かれ"],[12,1,"かた"],[15,1,"い"]],"text":"イエスはまた、譬で彼らに語って言われた、"},{"ref":"Matt.22.2","start":40022002,"end":40022002,"break":"none","ruby":[[1,2,"てんごく"],[9,1,"おう"],[13,2,"おうじ"],[20,1,"こん"],[21,1,"えん"],[23,1,"もよお"]],"text":"「天国は、ひとりの王がその王子のために、婚宴を催すようなものである。"},{"ref":"Matt.22.3","start":40022003,"end":40022003,"break":"none","ruby":[[0,1,"おう"],[4,1,"しもべ"],[16,1,"こん"],[17,1,"えん"],[19,1,"まね"],[25,1,"ひと"],[29,1,"よ"],[37,1,"ひと"]],"text":"王はその僕たちをつかわして、この婚宴に招かれていた人たちを呼ばせたが、その人たちはこようとはしなかった。"},{"ref":"Matt.22.4","start":40022004,"end":40022004,"break":"none","ruby":[[9,1,"しもべ"],[18,1,"い"],[23,1,"まね"],[27,1,"ひと"],[31,1,"い"],[37,2,"しょくじ"],[40,2,"ようい"],[49,1,"うし"],[51,1,"こ"],[54,1,"けもの"],[66,2,"ようい"],[78,1,"こん"],[79,1,"えん"]],"text":"そこでまた、ほかの僕たちをつかわして言った、『招かれた人たちに言いなさい。食事の用意ができました。牛も肥えた獣もほふられて、すべての用意ができました。さあ、婚宴においでください』。"},{"ref":"Matt.22.5","start":40022005,"end":40022005,"break":"none","ruby":[[4,1,"かれ"],[7,1,"し"],[10,1,"かお"],[19,2,"じぶん"],[22,1,"はたけ"],[29,2,"じぶん"],[32,2,"しょうばい"],[35,1,"で"],[37,1,"い"]],"text":"しかし、彼らは知らぬ顔をして、ひとりは自分の畑に、ひとりは自分の商売に出て行き、"},{"ref":"Matt.22.6","start":40022006,"end":40022006,"break":"none","ruby":[[5,2,"ひとびと"],[11,1,"しもべ"],[20,2,"ぶじょく"],[23,1,"くわ"],[26,1,"うえ"],[28,1,"ころ"]],"text":"またほかの人々は、この僕たちをつかまえて侮辱を加えた上、殺してしまった。"},{"ref":"Matt.22.7","start":40022007,"end":40022007,"break":"none","ruby":[[3,1,"おう"],[5,2,"りっぷく"],[9,2,"ぐんたい"],[12,1,"おく"],[19,2,"ひとごろ"],[25,1,"ほろ"],[31,1,"まち"],[33,1,"や"],[35,1,"はら"]],"text":"そこで王は立腹し、軍隊を送ってそれらの人殺しどもを滅ぼし、その町を焼き払った。"},{"ref":"Matt.22.8","start":40022008,"end":40022008,"break":"none","ruby":[[4,1,"しもべ"],[8,1,"い"],[13,1,"こん"],[14,1,"えん"],[16,2,"ようい"],[26,1,"まね"],[42,2,"ひとびと"]],"text":"それから僕たちに言った、『婚宴の用意はできているが、招かれていたのは、ふさわしくない人々であった。"},{"ref":"Matt.22.9","start":40022009,"end":40022009,"break":"none","ruby":[[4,1,"まち"],[6,2,"おおどお"],[10,1,"で"],[12,1,"い"],[16,2,"であ"],[20,1,"ひと"],[26,1,"こん"],[27,1,"えん"],[29,1,"つ"]],"text":"だから、町の大通りに出て行って、出会った人はだれでも婚宴に連れてきなさい』。"},{"ref":"Matt.22.10","start":40022010,"end":40022010,"break":"none","ruby":[[4,1,"しもべ"],[8,1,"みち"],[10,1,"で"],[12,1,"い"],[16,2,"であ"],[19,1,"ひと"],[22,2,"あくにん"],[26,2,"ぜんにん"],[32,1,"あつ"],[40,1,"こん"],[41,1,"えん"],[43,1,"せき"],[45,1,"きゃく"]],"text":"そこで、僕たちは道に出て行って、出会う人は、悪人でも善人でもみな集めてきたので、婚宴の席は客でいっぱいになった。"},{"ref":"Matt.22.11","start":40022011,"end":40022011,"break":"none","ruby":[[0,1,"おう"],[2,1,"きゃく"],[4,1,"むか"],[22,2,"れいふく"],[35,1,"ひと"],[37,1,"み"]],"text":"王は客を迎えようとしてはいってきたが、そこに礼服をつけていないひとりの人を見て、"},{"ref":"Matt.22.12","start":40022012,"end":40022012,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,1,"とも"],[18,2,"れいふく"],[46,1,"かれ"],[48,1,"だま"]],"text":"彼に言った、『友よ、どうしてあなたは礼服をつけないで、ここにはいってきたのですか』。しかし、彼は黙っていた。"},{"ref":"Matt.22.13","start":40022013,"end":40022013,"break":"none","ruby":[[4,1,"おう"],[9,1,"もの"],[13,1,"い"],[20,1,"もの"],[22,2,"てあし"],[30,1,"そと"],[32,1,"くら"],[39,1,"だ"],[45,1,"な"],[47,1,"さけ"],[52,1,"は"]],"text":"そこで、王はそばの者たちに言った、『この者の手足をしばって、外の暗やみにほうり出せ。そこで泣き叫んだり、歯がみをしたりするであろう』。"},{"ref":"Matt.22.14","start":40022014,"end":40022014,"break":"none","ruby":[[0,1,"まね"],[4,1,"もの"],[6,1,"おお"],[10,1,"えら"],[14,1,"もの"],[16,1,"すく"]],"text":"招かれる者は多いが、選ばれる者は少ない」。"},{"ref":"Matt.22.15","start":40022015,"end":40022015,"break":"paragraph","ruby":[[8,1,"びと"],[24,2,"ことば"],[36,2,"そうだん"]],"text":"そのときパリサイ人たちがきて、どうかしてイエスを言葉のわなにかけようと、相談をした。"},{"ref":"Matt.22.16","start":40022016,"end":40022016,"break":"none","ruby":[[4,1,"かれ"],[7,2,"でし"],[14,1,"とう"],[16,1,"もの"],[20,1,"とも"],[35,1,"い"],[41,2,"せんせい"],[54,2,"しんじつ"],[64,2,"しんり"],[67,1,"もとづ"],[70,1,"かみ"],[72,1,"みち"],[74,1,"おし"],[80,1,"ひと"],[82,1,"わ"],[84,1,"へだ"],[106,1,"し"]],"text":"そして、彼らの弟子を、ヘロデ党の者たちと共に、イエスのもとにつかわして言わせた、「先生、わたしたちはあなたが真実なかたであって、真理に基いて神の道を教え、また、人に分け隔てをしないで、だれをもはばかられないことを知っています。"},{"ref":"Matt.22.17","start":40022017,"end":40022017,"break":"none","ruby":[[10,1,"おも"],[17,1,"こた"],[30,2,"ぜいきん"],[33,1,"おさ"]],"text":"それで、あなたはどう思われますか、答えてください。カイザルに税金を納めてよいでしょうか、いけないでしょうか」。"},{"ref":"Matt.22.18","start":40022018,"end":40022018,"break":"none","ruby":[[4,1,"かれ"],[7,2,"あくい"],[10,1,"し"],[13,1,"い"],[19,3,"ぎぜんしゃ"]],"text":"イエスは彼らの悪意を知って言われた、「偽善者たちよ、なぜわたしをためそうとするのか。"},{"ref":"Matt.22.19","start":40022019,"end":40022019,"break":"none","ruby":[[0,1,"ぜい"],[2,1,"おさ"],[5,2,"かへい"],[8,1,"み"],[15,1,"かれ"],[24,1,"も"]],"text":"税に納める貨幣を見せなさい」。彼らはデナリ一つを持ってきた。"},{"ref":"Matt.22.20","start":40022020,"end":40022020,"break":"none","ruby":[[7,1,"い"],[20,2,"しょうぞう"],[26,2,"きごう"]],"text":"そこでイエスは言われた、「これは、だれの肖像、だれの記号か」。"},{"ref":"Matt.22.21","start":40022021,"end":40022021,"break":"none","ruby":[[0,1,"かれ"],[13,1,"こた"],[24,1,"い"],[49,1,"かみ"],[54,1,"かみ"],[56,1,"かえ"]],"text":"彼らは「カイザルのです」と答えた。するとイエスは言われた、「それでは、カイザルのものはカイザルに、神のものは神に返しなさい」。"},{"ref":"Matt.22.22","start":40022022,"end":40022022,"break":"none","ruby":[[0,1,"かれ"],[6,1,"き"],[9,2,"きょうたん"],[17,1,"のこ"],[20,1,"た"],[22,1,"さ"]],"text":"彼らはこれを聞いて驚嘆し、イエスを残して立ち去った。"},{"ref":"Matt.22.23","start":40022023,"end":40022023,"break":"paragraph","ruby":[[0,2,"ふっかつ"],[11,2,"しゅちょう"],[21,1,"びと"],[28,1,"ひ"],[39,2,"しつもん"]],"text":"復活ということはないと主張していたサドカイ人たちが、その日、イエスのもとにきて質問した、"},{"ref":"Matt.22.24","start":40022024,"end":40022024,"break":"none","ruby":[[1,2,"せんせい"],[10,1,"い"],[23,1,"ひと"],[25,1,"こ"],[30,1,"し"],[38,1,"おとうと"],[40,1,"あに"],[42,1,"つま"],[49,1,"あに"],[54,1,"こ"]],"text":"「先生、モーセはこう言っています、『もし、ある人が子がなくて死んだなら、その弟は兄の妻をめとって、兄のために子をもうけねばならない』。"},{"ref":"Matt.22.25","start":40022025,"end":40022025,"break":"none","ruby":[[14,1,"にん"],[16,2,"きょうだい"],[25,2,"ちょうなん"],[28,1,"つま"],[35,1,"し"],[45,1,"こ"],[56,1,"つま"],[58,1,"おとうと"],[60,1,"のこ"]],"text":"さて、わたしたちのところに七人の兄弟がありました。長男は妻をめとったが死んでしまい、そして子がなかったので、その妻を弟に残しました。"},{"ref":"Matt.22.26","start":40022026,"end":40022026,"break":"none","ruby":[[0,2,"じなん"],[3,2,"さんなん"],[11,1,"にん"],[14,1,"おな"]],"text":"次男も三男も、ついに七人とも同じことになりました。"},{"ref":"Matt.22.27","start":40022027,"end":40022027,"break":"none","ruby":[[0,2,"さいご"],[6,1,"おんな"],[8,1,"し"]],"text":"最後に、その女も死にました。"},{"ref":"Matt.22.28","start":40022028,"end":40022028,"break":"none","ruby":[[3,2,"ふっかつ"],[6,1,"とき"],[12,1,"おんな"],[16,1,"にん"],[23,1,"つま"],[38,1,"おんな"],[40,1,"つま"]],"text":"すると復活の時には、この女は、七人のうちだれの妻なのでしょうか。みんながこの女を妻にしたのですが」。"},{"ref":"Matt.22.29","start":40022029,"end":40022029,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[19,2,"せいしょ"],[22,1,"かみ"],[24,1,"ちから"],[26,1,"し"],[33,1,"おも"],[35,1,"ちが"]],"text":"イエスは答えて言われた、「あなたがたは聖書も神の力も知らないから、思い違いをしている。"},{"ref":"Matt.22.30","start":40022030,"end":40022030,"break":"none","ruby":[[0,2,"ふっかつ"],[3,1,"とき"],[7,1,"かれ"],[29,1,"かれ"],[32,1,"てん"],[36,2,"みつかい"]],"text":"復活の時には、彼らはめとったり、とついだりすることはない。彼らは天にいる御使のようなものである。"},{"ref":"Matt.22.31","start":40022031,"end":40022031,"break":"none","ruby":[[3,2,"しにん"],[6,2,"ふっかつ"],[14,1,"かみ"],[22,1,"い"],[26,2,"ことば"],[29,1,"よ"]],"text":"また、死人の復活については、神があなたがたに言われた言葉を読んだことがないのか。"},{"ref":"Matt.22.32","start":40022032,"end":40022032,"break":"none","ruby":[[11,1,"かみ"],[17,1,"かみ"],[23,1,"かみ"],[29,1,"か"],[35,1,"かみ"],[37,1,"し"],[40,1,"もの"],[42,1,"かみ"],[48,1,"い"],[53,1,"もの"],[55,1,"かみ"]],"text":"『わたしはアブラハムの神、イサクの神、ヤコブの神である』と書いてある。神は死んだ者の神ではなく、生きている者の神である」。"},{"ref":"Matt.22.33","start":40022033,"end":40022033,"break":"none","ruby":[[0,2,"ぐんしゅう"],[6,1,"き"],[14,1,"おしえ"],[16,1,"おどろ"]],"text":"群衆はこれを聞いて、イエスの教に驚いた。"},{"ref":"Matt.22.34","start":40022034,"end":40022034,"break":"paragraph","ruby":[[7,1,"びと"],[20,1,"びと"],[24,1,"い"],[32,1,"き"],[36,2,"いっしょ"],[39,1,"あつ"]],"text":"さて、パリサイ人たちは、イエスがサドカイ人たちを言いこめられたと聞いて、一緒に集まった。"},{"ref":"Matt.22.35","start":40022035,"end":40022035,"break":"none","ruby":[[3,1,"かれ"],[6,1,"なか"],[12,2,"りっぽう"],[14,2,"がくしゃ"],[29,2,"しつもん"]],"text":"そして彼らの中のひとりの律法学者が、イエスをためそうとして質問した、"},{"ref":"Matt.22.36","start":40022036,"end":40022036,"break":"none","ruby":[[1,2,"せんせい"],[4,2,"りっぽう"],[7,1,"なか"],[21,2,"たいせつ"]],"text":"「先生、律法の中で、どのいましめがいちばん大切なのですか」。"},{"ref":"Matt.22.37","start":40022037,"end":40022037,"break":"none","ruby":[[4,1,"い"],[11,1,"こころ"],[17,2,"せいしん"],[24,1,"おも"],[32,1,"しゅ"],[39,1,"かみ"],[41,1,"あい"]],"text":"イエスは言われた、「『心をつくし、精神をつくし、思いをつくして、主なるあなたの神を愛せよ』。"},{"ref":"Matt.22.38","start":40022038,"end":40022038,"break":"none","ruby":[[7,2,"たいせつ"],[11,1,"だい"]],"text":"これがいちばん大切な、第一のいましめである。"},{"ref":"Matt.22.39","start":40022039,"end":40022039,"break":"none","ruby":[[0,1,"だい"],[6,2,"どうよう"],[13,2,"じぶん"],[16,1,"あい"],[26,1,"とな"],[28,1,"びと"],[30,1,"あい"]],"text":"第二もこれと同様である、『自分を愛するようにあなたの隣り人を愛せよ』。"},{"ref":"Matt.22.40","start":40022040,"end":40022040,"break":"none","ruby":[[13,2,"りっぽう"],[15,2,"ぜんたい"],[18,3,"よげんしゃ"]],"text":"これらの二つのいましめに、律法全体と預言者とが、かかっている」。"},{"ref":"Matt.22.41","start":40022041,"end":40022041,"break":"paragraph","ruby":[[4,1,"びと"],[8,1,"あつ"],[21,1,"かれ"],[25,1,"たず"]],"text":"パリサイ人たちが集まっていたとき、イエスは彼らにお尋ねになった、"},{"ref":"Matt.22.42","start":40022042,"end":40022042,"break":"none","ruby":[[14,1,"おも"],[21,1,"こ"],[27,1,"かれ"],[35,1,"こ"],[40,1,"こた"]],"text":"「あなたがたはキリストをどう思うか。だれの子なのか」。彼らは「ダビデの子です」と答えた。"},{"ref":"Matt.22.43","start":40022043,"end":40022043,"break":"none","ruby":[[4,1,"い"],[23,2,"みたま"],[26,1,"かん"],[34,1,"しゅ"],[36,1,"よ"]],"text":"イエスは言われた、「それではどうして、ダビデが御霊に感じてキリストを主と呼んでいるのか。"},{"ref":"Matt.22.44","start":40022044,"end":40022044,"break":"none","breaks":[[4,"stanza"],[18,"line"],[40,"line"]],"ruby":[[5,1,"しゅ"],[9,1,"しゅ"],[11,1,"おお"],[22,1,"てき"],[28,1,"あし"],[32,1,"お"],[44,1,"みぎ"],[46,1,"ざ"]],"text":"すなわち『主はわが主に仰せになった、あなたの敵をあなたの足もとに置くときまでは、わたしの右に座していなさい』。"},{"ref":"Matt.22.45","start":40022045,"end":40022045,"break":"none","ruby":[[9,2,"じしん"],[17,1,"しゅ"],[19,1,"よ"],[40,1,"こ"]],"text":"このように、ダビデ自身がキリストを主と呼んでいるなら、キリストはどうしてダビデの子であろうか」。"},{"ref":"Matt.22.46","start":40022046,"end":40022046,"break":"none","ruby":[[6,1,"こと"],[9,1,"こた"],[13,1,"もの"],[24,1,"ひ"],[31,1,"すす"],[38,2,"しつもん"],[42,1,"もの"]],"text":"イエスにひと言でも答えうる者は、なかったし、その日からもはや、進んでイエスに質問する者も、いなくなった。"}]