[{"ref":"1Chr.17.1","start":13017001,"end":13017001,"break":"paragraph","ruby":[[6,2,"じぶん"],[9,1,"いえ"],[11,1,"す"],[22,3,"よげんしゃ"],[29,1,"い"],[34,1,"み"],[41,2,"こうはく"],[44,1,"いえ"],[46,1,"す"],[53,1,"しゅ"],[55,2,"けいやく"],[58,1,"はこ"],[60,2,"てんまく"]],"text":"さてダビデは自分の家に住むようになったとき、預言者ナタンに言った、「見よ、わたしは香柏の家に住んでいるが、主の契約の箱は天幕のうちにある」。"},{"ref":"1Chr.17.2","start":13017002,"end":13017002,"break":"none","ruby":[[8,1,"い"],[13,1,"かみ"],[36,1,"こころ"],[44,1,"おこな"]],"text":"ナタンはダビデに言った、「神があなたとともにおられるから、すべてあなたの心にあるところを行いなさい」。"},{"ref":"1Chr.17.3","start":13017003,"end":13017003,"break":"paragraph","ruby":[[2,1,"よる"],[4,1,"かみ"],[6,2,"ことば"],[13,1,"のぞ"],[16,1,"い"]],"text":"その夜、神の言葉がナタンに臨んで言った、"},{"ref":"1Chr.17.4","start":13017004,"end":13017004,"break":"none","ruby":[[1,1,"い"],[15,1,"つ"],[20,1,"しゅ"],[24,1,"い"],[33,1,"す"],[35,1,"いえ"],[37,1,"た"]],"text":"「行ってわたしのしもべダビデに告げよ、『主はこう言われる、わたしの住む家を建ててはならない。"},{"ref":"1Chr.17.5","start":13017005,"end":13017005,"break":"none","ruby":[[10,1,"みちび"],[12,1,"のぼ"],[15,1,"ひ"],[18,2,"こんにち"],[23,1,"いえ"],[25,1,"す"],[30,2,"てんまく"],[34,2,"てんまく"],[38,2,"まくや"],[42,2,"まくや"],[45,1,"うつ"]],"text":"わたしはイスラエルを導き上った日から今日まで、家に住まわず、天幕から天幕に、幕屋から幕屋に移ったのである。"},{"ref":"1Chr.17.6","start":13017006,"end":13017006,"break":"none","ruby":[[14,1,"とも"],[16,1,"あゆ"],[23,1,"ところ"],[30,1,"たみ"],[32,1,"ぼく"],[38,1,"めい"],[61,1,"こと"],[84,2,"こうはく"],[87,1,"いえ"],[89,1,"た"],[97,1,"い"]],"text":"わたしがすべてのイスラエルと共に歩んだすべての所で、わたしの民を牧することを命じたイスラエルのさばきづかさのひとりに、ひと言でも、「どうしてあなたがたは、わたしのために香柏の家を建てないのか」と言ったことがあるだろうか』と。"},{"ref":"1Chr.17.7","start":13017007,"end":13017007,"break":"none","ruby":[[4,1,"いま"],[23,1,"い"],[30,2,"ばんぐん"],[33,1,"しゅ"],[37,1,"おお"],[52,2,"まきば"],[57,1,"ひつじ"],[59,1,"したが"],[64,1,"ところ"],[67,1,"と"],[75,1,"たみ"],[82,1,"きみ"]],"text":"それゆえ今あなたは、わたしのしもべダビデにこう言いなさい、『万軍の主はこう仰せられる、「わたしはあなたを牧場から、羊に従っている所から取って、わたしの民イスラエルの君とし、"},{"ref":"1Chr.17.8","start":13017008,"end":13017008,"break":"none","ruby":[[7,1,"い"],[15,1,"とも"],[28,1,"てき"],[34,1,"まえ"],[37,1,"た"],[39,1,"さ"],[49,1,"ち"],[51,1,"うえ"],[53,1,"おお"],[57,1,"もの"],[59,1,"な"],[64,1,"な"],[70,1,"え"]],"text":"あなたがどこへ行くにもあなたと共におり、あなたのすべての敵をあなたの前から断ち去った。わたしはまた地の上の大いなる者の名のような名をあなたに得させよう。"},{"ref":"1Chr.17.9","start":13017009,"end":13017009,"break":"none","ruby":[[9,1,"たみ"],[22,1,"ところ"],[24,1,"さだ"],[28,1,"かれ"],[31,1,"う"],[36,1,"かれ"],[39,2,"じぶん"],[42,1,"ところ"],[44,1,"す"],[48,1,"かさ"],[51,1,"うご"]],"text":"そしてわたしはわが民イスラエルのために一つの所を定めて、彼らを植えつけ、彼らを自分の所に住ませ、重ねて動くことのないようにしよう。"},{"ref":"1Chr.17.10","start":13017010,"end":13017010,"break":"none","ruby":[[2,1,"まえ"],[18,1,"たみ"],[25,1,"うえ"],[34,1,"た"],[37,1,"とき"],[49,1,"わる"],[51,1,"ひと"],[53,1,"かさ"],[59,1,"あら"],[86,1,"てき"],[88,2,"せいふく"],[99,1,"しゅ"],[108,1,"いえ"],[110,1,"た"],[118,1,"つ"]],"text":"また前のように、すなわちわたしがわが民イスラエルの上にさばきづかさを立てた時からこのかたのように、悪い人が重ねてこれを荒すことはないであろう。わたしはまたあなたのもろもろの敵を征服する。かつわたしは主があなたのために家を建てられることを告げる。"},{"ref":"1Chr.17.11","start":13017011,"end":13017011,"break":"none","ruby":[[4,1,"ひ"],[6,1,"み"],[13,2,"せんぞ"],[18,1,"ところ"],[20,1,"い"],[38,1,"こ"],[48,1,"こ"],[63,1,"た"],[69,2,"おうこく"],[72,1,"かた"]],"text":"あなたの日が満ち、あなたの先祖たちの所へ行かねばならぬとき、わたしはあなたの子、すなわちあなたの子らのひとりを、あなたのあとに立てて、その王国を堅くする。"},{"ref":"1Chr.17.12","start":13017012,"end":13017012,"break":"none","ruby":[[0,1,"かれ"],[9,1,"いえ"],[11,1,"た"],[23,1,"なが"],[25,1,"かれ"],[27,1,"くらい"],[29,1,"かた"]],"text":"彼はわたしのために家を建てるであろう。わたしは長く彼の位を堅くする。"},{"ref":"1Chr.17.13","start":13017013,"end":13017013,"break":"none","ruby":[[4,1,"かれ"],[6,1,"ちち"],[11,1,"かれ"],[17,1,"こ"],[48,1,"もの"],[51,1,"と"],[53,1,"さ"],[60,1,"かれ"],[64,1,"と"],[66,1,"さ"]],"text":"わたしは彼の父となり、彼はわたしの子となる。わたしは、わたしのいつくしみを、あなたのさきにあった者から取り去ったように、彼からは取り去らない。"},{"ref":"1Chr.17.14","start":13017014,"end":13017014,"break":"none","ruby":[[9,1,"かれ"],[11,1,"なが"],[17,1,"いえ"],[24,2,"おうこく"],[32,1,"かれ"],[34,1,"くらい"],[41,1,"かた"],[43,1,"た"]],"text":"かえって、わたしは彼を長くわたしの家に、わたしの王国にすえおく。彼の位はとこしえに堅く立つであろう』」。"},{"ref":"1Chr.17.15","start":13017015,"end":13017015,"break":"none","ruby":[[11,2,"ことば"],[25,1,"まぼろし"],[34,1,"かた"]],"text":"ナタンはすべてこれらの言葉のように、またすべてこの幻のようにダビデに語った。"},{"ref":"1Chr.17.16","start":13017016,"end":13017016,"break":"paragraph","ruby":[[7,1,"おう"],[14,1,"しゅ"],[16,1,"まえ"],[18,1,"ざ"],[21,1,"い"],[26,1,"しゅ"],[29,1,"かみ"],[43,1,"いえ"],[65,1,"みちび"]],"text":"そこで、ダビデ王は、はいって主の前に座して言った、「主なる神よ、わたしがだれ、わたしの家がなんであるので、あなたはこれまでわたしを導かれたのですか。"},{"ref":"1Chr.17.17","start":13017017,"end":13017017,"break":"none","ruby":[[0,1,"かみ"],[10,1,"め"],[13,1,"ちい"],[16,1,"こと"],[20,1,"しゅ"],[23,1,"かみ"],[34,1,"いえ"],[43,1,"のち"],[45,1,"こと"],[47,1,"かた"],[56,2,"よよ"],[62,1,"しめ"]],"text":"神よ、これはあなたの目には小さな事です。主なる神よ、あなたはしもべの家について、はるか後の事を語って、きたるべき代々のことを示されました。"},{"ref":"1Chr.17.18","start":13017018,"end":13017018,"break":"none","ruby":[[4,2,"めいよ"],[18,1,"うえ"],[23,1,"なに"],[25,1,"もう"],[48,1,"し"]],"text":"しもべの名誉については、ダビデはこの上あなたに何を申しあげることができましょう。あなたはしもべを知っておられるからです。"},{"ref":"1Chr.17.19","start":13017019,"end":13017019,"break":"none","ruby":[[0,1,"しゅ"],[21,1,"こころ"],[36,1,"おお"],[40,1,"こと"],[49,1,"おお"],[53,1,"こと"],[55,1,"し"]],"text":"主よ、あなたはしもべのために、またあなたの心にしたがって、このもろもろの大いなる事をなし、すべての大いなる事を知らされました。"},{"ref":"1Chr.17.20","start":13017020,"end":13017020,"break":"none","ruby":[[0,1,"しゅ"],[11,1,"みみ"],[13,1,"き"],[16,1,"ところ"],[44,1,"かみ"]],"text":"主よ、われわれがすべて耳に聞いた所によれば、あなたのようなものはなく、またあなたのほかに神はありません。"},{"ref":"1Chr.17.21","start":13017021,"end":13017021,"break":"none","ruby":[[2,2,"ちじょう"],[7,2,"こくみん"],[15,1,"たみ"],[36,1,"かみ"],[38,1,"い"],[42,2,"じぶん"],[53,1,"たみ"],[71,1,"だ"],[79,1,"たみ"],[81,1,"まえ"],[84,2,"くにぐに"],[87,1,"たみ"],[89,1,"お"],[91,1,"はら"],[94,1,"おお"],[98,1,"おそ"],[102,1,"こと"],[104,1,"い"],[108,1,"な"],[110,1,"え"]],"text":"また地上のどの国民が、あなたの民イスラエルのようでありましょうか。これは神が行って、自分のためにあがなって民とし、エジプトからあなたがあがない出されたあなたの民の前から国々の民を追い払い、大いなる恐るべき事を行って、名を得られたものではありませんか。"},{"ref":"1Chr.17.22","start":13017022,"end":13017022,"break":"none","ruby":[[8,1,"たみ"],[15,1,"なが"],[21,1,"たみ"],[29,1,"しゅ"],[36,1,"かれ"],[39,1,"かみ"]],"text":"あなたはあなたの民イスラエルを長くあなたの民とされました。主よ、あなたは彼らの神となられたのです。"},{"ref":"1Chr.17.23","start":13017023,"end":13017023,"break":"none","ruby":[[4,1,"しゅ"],[20,1,"いえ"],[25,1,"かた"],[29,2,"ことば"],[32,1,"なが"],[34,1,"かた"],[43,1,"い"]],"text":"それゆえ主よ、あなたがしもべと、しもべの家について語られた言葉を長く堅くして、あなたの言われたとおりにしてください。"},{"ref":"1Chr.17.24","start":13017024,"end":13017024,"break":"none","ruby":[[9,1,"な"],[16,1,"かた"],[35,1,"かみ"],[37,2,"ばんぐん"],[40,1,"しゅ"],[48,1,"かみ"],[54,1,"い"],[71,1,"いえ"],[77,1,"まえ"],[79,1,"かた"],[81,1,"た"]],"text":"そうすればあなたの名はとこしえに堅くされ、あがめられて、『イスラエルの神、万軍の主はイスラエルの神である』と言われ、またあなたのしもべダビデの家はあなたの前に堅く立つことができるでしょう。"},{"ref":"1Chr.17.25","start":13017025,"end":13017025,"break":"none","ruby":[[2,1,"かみ"],[9,1,"かれ"],[14,1,"いえ"],[16,1,"た"],[25,1,"しめ"],[45,1,"まえ"],[47,1,"いの"],[49,2,"ゆうき"],[52,1,"え"]],"text":"わが神よ、あなたは彼のために家を建てると、しもべに示されました。それゆえ、しもべはあなたの前に祈る勇気を得ました。"},{"ref":"1Chr.17.26","start":13017026,"end":13017026,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"かみ"],[15,1,"よ"],[17,1,"こと"],[23,2,"やくそく"]],"text":"主よ、あなたは神にいまし、この良き事をしもべに約束されました。"},{"ref":"1Chr.17.27","start":13017027,"end":13017027,"break":"none","ruby":[[14,1,"いえ"],[16,2,"しゅくふく"],[24,1,"まえ"],[26,1,"なが"],[28,1,"つづ"],[40,1,"しゅ"],[47,2,"しゅくふく"],[55,1,"なが"],[57,2,"しゅくふく"],[60,1,"う"]],"text":"それゆえどうぞいま、しもべの家を祝福し、あなたの前に長く続かせてくださるように。主よ、あなたの祝福されるものは長く祝福を受けるからです」。"}]