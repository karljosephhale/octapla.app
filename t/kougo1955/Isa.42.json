[{"ref":"Isa.42.1","start":23042001,"end":23042001,"break":"paragraph","breaks":[[14,"line"],[29,"line"],[43,"line"]],"ruby":[[4,2,"しじ"],[18,1,"よろこ"],[22,1,"えら"],[24,1,"ひと"],[26,1,"み"],[35,1,"れい"],[37,1,"かれ"],[39,1,"あた"],[43,1,"かれ"],[50,1,"くに"],[54,1,"みち"]],"text":"わたしの支持するわがしもべ、わたしの喜ぶわが選び人を見よ。わたしはわが霊を彼に与えた。彼はもろもろの国びとに道をしめす。"},{"ref":"Isa.42.2","start":23042002,"end":23042002,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"かれ"],[2,1,"さけ"],[9,1,"こえ"],[21,1,"こえ"],[27,1,"きこ"]],"text":"彼は叫ぶことなく、声をあげることなく、その声をちまたに聞えさせず、"},{"ref":"Isa.42.3","start":23042003,"end":23042003,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[2,1,"きず"],[6,1,"あし"],[8,1,"お"],[20,2,"とうしん"],[23,1,"け"],[30,2,"しんじつ"],[36,1,"みち"]],"text":"また傷ついた葦を折ることなく、ほのぐらい灯心を消すことなく、真実をもって道をしめす。"},{"ref":"Isa.42.4","start":23042004,"end":23042004,"break":"line","breaks":[[11,"line"],[23,"line"]],"ruby":[[0,1,"かれ"],[2,1,"おとろ"],[6,2,"らくたん"],[14,1,"みち"],[16,1,"ち"],[18,2,"かくりつ"],[23,2,"うみぞ"],[27,2,"くにぐに"],[32,1,"おしえ"],[34,1,"ま"],[36,1,"のぞ"]],"text":"彼は衰えず、落胆せず、ついに道を地に確立する。海沿いの国々はその教を待ち望む。"},{"ref":"Isa.42.5","start":23042005,"end":23042005,"break":"paragraph","breaks":[[12,"line"],[27,"line"],[38,"line"],[53,"line"]],"ruby":[[0,1,"てん"],[2,2,"そうぞう"],[12,1,"ち"],[17,1,"しょう"],[29,1,"うえ"],[31,1,"たみ"],[33,1,"いき"],[35,1,"あた"],[40,1,"なか"],[42,1,"あゆ"],[44,1,"もの"],[46,1,"れい"],[48,1,"あた"],[53,1,"しゅ"],[56,1,"かみ"],[60,1,"い"]],"text":"天を創造してこれをのべ、地とそれに生ずるものをひらき、その上の民に息を与え、その中を歩む者に霊を与えられる主なる神はこう言われる、"},{"ref":"Isa.42.6","start":23042006,"end":23042006,"break":"line","breaks":[[22,"line"],[43,"line"],[58,"line"]],"ruby":[[1,1,"しゅ"],[8,2,"せいぎ"],[18,1,"め"],[30,1,"て"],[39,1,"まも"],[51,1,"たみ"],[53,2,"けいやく"],[63,1,"くに"],[67,1,"ひかり"],[71,1,"あた"]],"text":"「主なるわたしは正義をもってあなたを召した。わたしはあなたの手をとり、あなたを守った。わたしはあなたを民の契約とし、もろもろの国びとの光として与え、"},{"ref":"Isa.42.7","start":23042007,"end":23042007,"break":"line","breaks":[[8,"line"],[21,"line"]],"ruby":[[0,2,"もうじん"],[3,1,"め"],[5,1,"ひら"],[8,2,"しゅうじん"],[11,2,"ちか"],[14,2,"ごくや"],[18,1,"だ"],[21,1,"くら"],[24,1,"ざ"],[27,1,"もの"],[29,2,"ごくや"],[33,1,"だ"]],"text":"盲人の目を開き、囚人を地下の獄屋から出し、暗きに座する者を獄屋から出させる。"},{"ref":"Isa.42.8","start":23042008,"end":23042008,"break":"line","breaks":[[21,"line"],[40,"line"]],"ruby":[[4,1,"しゅ"],[16,1,"な"],[27,2,"えいこう"],[33,1,"もの"],[35,1,"あた"],[45,1,"ほまれ"],[47,1,"きざ"],[50,1,"ぞう"],[52,1,"あた"]],"text":"わたしは主である、これがわたしの名である。わたしはわが栄光をほかの者に与えない。また、わが誉を刻んだ像に与えない。"},{"ref":"Isa.42.9","start":23042009,"end":23042009,"break":"line","breaks":[[16,"line"],[30,"line"],[43,"line"]],"ruby":[[0,1,"み"],[6,2,"よげん"],[10,1,"こと"],[12,1,"おこ"],[20,1,"あたら"],[23,1,"こと"],[25,1,"つ"],[32,1,"こと"],[36,1,"おこ"],[40,1,"まえ"],[56,1,"し"]],"text":"見よ、さきに預言した事は起った。わたしは新しい事を告げよう。その事がまだ起らない前に、わたしはまず、あなたがたに知らせよう」。"},{"ref":"Isa.42.10","start":23042010,"end":23042010,"break":"paragraph","breaks":[[15,"line"],[29,"line"],[41,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"あたら"],[9,1,"うた"],[15,1,"ち"],[17,1,"はて"],[20,1,"しゅ"],[29,1,"うみ"],[33,1,"なか"],[35,1,"み"],[41,2,"うみぞ"],[45,2,"くにぐに"],[51,1,"す"],[53,1,"もの"],[56,1,"な"]],"text":"主にむかって新しき歌をうたえ。地の果から主をほめたたえよ。海とその中に満ちるもの、海沿いの国々とそれに住む者とは鳴りどよめ。"},{"ref":"Isa.42.11","start":23042011,"end":23042011,"break":"line","breaks":[[15,"line"],[37,"line"],[48,"line"]],"ruby":[[0,2,"あらの"],[5,1,"なか"],[12,1,"まち"],[21,1,"す"],[28,2,"むらざと"],[31,1,"こえ"],[40,1,"たみ"],[42,1,"よろこ"],[48,1,"やま"],[50,1,"いただき"],[53,1,"よ"],[57,1,"さけ"]],"text":"荒野とその中のもろもろの町と、ケダルびとの住むもろもろの村里は声をあげよ。セラの民は喜びうたえ。山の頂から呼ばわり叫べ。"},{"ref":"Isa.42.12","start":23042012,"end":23042012,"break":"line","breaks":[[8,"line"]],"ruby":[[0,2,"えいこう"],[3,1,"しゅ"],[5,1,"き"],[10,1,"ほまれ"],[12,2,"うみぞ"],[16,2,"くにぐに"],[19,1,"かた"],[21,1,"つ"]],"text":"栄光を主に帰し、その誉を海沿いの国々で語り告げよ。"},{"ref":"Isa.42.13","start":23042013,"end":23042013,"break":"line","breaks":[[13,"line"],[27,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"ゆうし"],[8,1,"で"],[10,1,"い"],[16,1,"ひと"],[21,2,"ねっしん"],[24,1,"おこ"],[30,1,"こえ"],[35,1,"よ"],[42,1,"てき"],[48,2,"たいのう"]],"text":"主は勇士のように出て行き、いくさ人のように熱心を起し、ときの声をあげて呼ばわり、その敵にむかって大能をあらわされる。"},{"ref":"Isa.42.14","start":23042014,"end":23042014,"break":"paragraph","breaks":[[13,"line"],[28,"line"],[49,"line"]],"ruby":[[4,1,"ひさ"],[7,1,"こえ"],[9,1,"だ"],[13,1,"もく"],[28,1,"いま"],[33,1,"こ"],[35,1,"う"],[41,1,"おんな"],[46,1,"さけ"],[53,1,"いき"],[55,1,"き"]],"text":"わたしは久しく声を出さず、黙して、おのれをおさえていた。今わたしは子を産もうとする女のように叫ぶ。わたしの息は切れ、かつあえぐ。"},{"ref":"Isa.42.15","start":23042015,"end":23042015,"break":"line","breaks":[[12,"line"],[22,"line"],[33,"line"]],"ruby":[[4,1,"やま"],[6,1,"おか"],[9,1,"あら"],[16,1,"くさ"],[18,1,"か"],[27,1,"かわ"],[29,1,"しま"],[38,1,"いけ"]],"text":"わたしは山と丘とを荒し、すべての草を枯らし、もろもろの川を島とし、もろもろの池をからす。"},{"ref":"Isa.42.16","start":23042016,"end":23042016,"break":"line","breaks":[[8,"line"],[24,"line"],[35,"line"],[46,"line"],[59,"line"]],"ruby":[[4,1,"め"],[8,1,"かれ"],[13,1,"し"],[17,2,"おおじ"],[20,1,"い"],[26,1,"し"],[30,1,"みち"],[32,1,"みちび"],[35,1,"くら"],[40,1,"まえ"],[42,1,"ひかり"],[46,2,"こうてい"],[51,1,"ところ"],[53,1,"たい"],[67,1,"こと"],[74,1,"かれ"],[77,1,"す"]],"text":"わたしは目しいを彼らのまだ知らない大路に行かせ、まだ知らない道に導き、暗きをその前に光とし、高低のある所を平らにする。わたしはこれらの事をおこなって彼らを捨てない。"},{"ref":"Isa.42.17","start":23042017,"end":23042017,"break":"line","breaks":[[18,"line"],[41,"line"]],"ruby":[[0,1,"きざ"],[3,2,"ぐうぞう"],[6,1,"たの"],[9,1,"い"],[11,2,"ぐうぞう"],[31,1,"かみ"],[37,1,"い"],[39,1,"もの"],[41,1,"しりぞ"],[47,1,"おお"],[50,1,"はじ"]],"text":"刻んだ偶像に頼み、鋳た偶像にむかって「あなたがたは、われわれの神である」と言う者は退けられて、大いに恥をかく。"},{"ref":"Isa.42.18","start":23042018,"end":23042018,"break":"paragraph","breaks":[[8,"line"]],"ruby":[[0,1,"みみ"],[5,1,"き"],[8,1,"め"],[13,1,"め"],[15,1,"そそ"],[18,1,"み"]],"text":"耳しいよ、聞け。目しいよ、目を注いで見よ。"},{"ref":"Isa.42.19","start":23042019,"end":23042019,"break":"line","breaks":[[21,"line"],[45,"line"],[66,"line"]],"ruby":[[13,1,"め"],[31,2,"ししゃ"],[37,1,"みみ"],[51,2,"けんしん"],[53,1,"もの"],[58,1,"め"],[70,1,"しゅ"],[79,1,"め"]],"text":"だれか、わがしもべのほかに目しいがあるか。だれか、わがつかわす使者のような耳しいがあるか。だれか、わが献身者のような目しいがあるか。だれか、主のしもべのような目しいがあるか。"},{"ref":"Isa.42.20","start":23042020,"end":23042020,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[2,1,"おお"],[5,1,"こと"],[7,1,"み"],[10,1,"みと"],[14,1,"みみ"],[16,1,"ひら"],[20,1,"き"]],"text":"彼は多くの事を見ても認めず、耳を開いても聞かない。"},{"ref":"Isa.42.21","start":23042021,"end":23042021,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ぎ"],[14,1,"おしえ"],[16,1,"おお"],[27,2,"こうえい"],[39,1,"よろこ"]],"text":"主はおのれの義のために、その教を大いなるものとし、かつ光栄あるものとすることを喜ばれた。"},{"ref":"Isa.42.22","start":23042022,"end":23042022,"break":"line","breaks":[[20,"line"],[43,"line"],[61,"line"]],"ruby":[[7,1,"たみ"],[15,1,"うば"],[22,1,"あな"],[24,1,"なか"],[26,1,"とら"],[30,2,"ごくや"],[33,1,"なか"],[35,1,"と"],[43,1,"かれ"],[53,1,"たす"],[56,1,"もの"],[61,1,"もの"],[63,1,"うば"],[74,1,"い"],[76,1,"もの"]],"text":"ところが、この民はかすめられ、奪われて、みな穴の中に捕われ、獄屋の中に閉じこめられた。彼らはかすめられても助ける者がなく、物を奪われても「もどせ」と言う者もない。"},{"ref":"Isa.42.23","start":23042023,"end":23042023,"break":"line","breaks":[[9,"line"],[26,"line"],[35,"line"]],"ruby":[[14,1,"こと"],[16,1,"みみ"],[18,1,"かたむ"],[29,1,"こころ"],[35,1,"のち"],[43,1,"き"]],"text":"あなたがたのうち、だれがこの事に耳を傾けるだろうか、だれが心をもちいて後のためにこれを聞くだろうか。"},{"ref":"Isa.42.24","start":23042024,"end":23042024,"break":"line","breaks":[[14,"line"],[36,"line"],[46,"line"],[62,"line"],[75,"line"]],"ruby":[[4,1,"うば"],[8,1,"もの"],[18,1,"もの"],[30,1,"もの"],[39,1,"しゅ"],[51,1,"しゅ"],[57,1,"つみ"],[59,1,"おか"],[64,1,"みち"],[66,1,"あゆ"],[71,1,"この"],[79,1,"おしえ"],[81,1,"したが"],[86,1,"この"]],"text":"ヤコブを奪わせた者はだれか。かすめる者にイスラエルをわたした者はだれか。これは主ではないか。われわれは主にむかって罪を犯し、その道に歩むことを好まず、またその教に従うことを好まなかった。"},{"ref":"Isa.42.25","start":23042025,"end":23042025,"break":"line","breaks":[[14,"line"],[30,"line"],[53,"line"]],"ruby":[[5,1,"しゅ"],[7,1,"はげ"],[10,1,"いか"],[14,2,"もうれつ"],[17,1,"たたか"],[20,1,"かれ"],[23,1,"のぞ"],[33,1,"ひ"],[38,2,"しゅうい"],[41,1,"も"],[46,1,"かれ"],[49,1,"さと"],[53,1,"かれ"],[56,1,"や"],[61,1,"こころ"]],"text":"それゆえ、主は激しい怒りと、猛烈な戦いを彼らに臨ませられた。それが火のように周囲に燃えても、彼らは悟らず、彼らを焼いても、心にとめなかった。"}]