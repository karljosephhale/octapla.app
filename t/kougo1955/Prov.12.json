[{"ref":"Prov.12.1","start":20012001,"end":20012001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[0,1,"いまし"],[3,1,"あい"],[6,1,"ひと"],[8,2,"ちしき"],[11,1,"あい"],[15,1,"こら"],[19,1,"にく"],[21,1,"もの"],[23,1,"おろ"]],"text":"戒めを愛する人は知識を愛する、懲しめを憎む者は愚かである。"},{"ref":"Prov.12.2","start":20012002,"end":20012002,"break":"line","breaks":[[11,"line"]],"ruby":[[0,2,"ぜんにん"],[3,1,"しゅ"],[5,1,"めぐ"],[11,1,"わる"],[13,1,"はか"],[18,1,"もう"],[21,1,"ひと"],[23,1,"しゅ"],[25,1,"ばっ"]],"text":"善人は主の恵みをうけ、悪い計りごとを設ける人は主に罰せられる。"},{"ref":"Prov.12.3","start":20012003,"end":20012003,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ひと"],[2,1,"あく"],[7,1,"かた"],[9,1,"た"],[19,1,"ただ"],[22,1,"ひと"],[24,1,"ね"],[26,1,"うご"]],"text":"人は悪をもって堅く立つことはできない、正しい人の根は動くことはない。"},{"ref":"Prov.12.4","start":20012004,"end":20012004,"break":"line","breaks":[[13,"line"],[23,"line"]],"ruby":[[0,1,"かしこ"],[2,1,"つま"],[6,1,"おっと"],[8,1,"かんむり"],[13,1,"はじ"],[21,1,"つま"],[23,1,"おっと"],[25,1,"ほね"],[27,1,"しょう"],[30,1,"くさ"]],"text":"賢い妻はその夫の冠である、恥をこうむらせる妻は夫の骨に生じた腐れのようなものである。"},{"ref":"Prov.12.5","start":20012005,"end":20012005,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"かんが"],[8,2,"こうせい"],[14,1,"あ"],[17,1,"もの"],[19,1,"はか"],[24,1,"いつわ"]],"text":"正しい人の考えは公正である、悪しき者の計ることは偽りである。"},{"ref":"Prov.12.6","start":20012006,"end":20012006,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,2,"ことば"],[9,1,"ひと"],[11,1,"ち"],[13,1,"なが"],[22,1,"ただ"],[25,1,"ひと"],[27,1,"くち"],[29,1,"ひと"],[31,1,"すく"]],"text":"悪しき者の言葉は、人の血を流そうとうかがう、正しい人の口は人を救う。"},{"ref":"Prov.12.7","start":20012007,"end":20012007,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"たお"],[12,1,"さ"],[15,1,"ただ"],[18,1,"ひと"],[20,1,"いえ"],[22,1,"かた"],[24,1,"た"]],"text":"悪しき者は倒されて、うせ去る、正しい人の家は堅く立つ。"},{"ref":"Prov.12.8","start":20012008,"end":20012008,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ひと"],[4,1,"さと"],[18,1,"こころ"],[24,1,"もの"],[27,1,"いや"]],"text":"人はその悟りにしたがって、ほめられ、心のねじけた者は、卑しめられる。"},{"ref":"Prov.12.9","start":20012009,"end":20012009,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"みぶん"],[3,1,"ひく"],[5,1,"ひと"],[8,2,"じぶん"],[11,1,"はたら"],[13,1,"もの"],[20,1,"たか"],[24,1,"しょく"],[26,1,"とぼ"],[29,1,"もの"]],"text":"身分の低い人でも自分で働く者は、みずから高ぶって食に乏しい者にまさる。"},{"ref":"Prov.12.10","start":20012010,"end":20012010,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[7,2,"かちく"],[10,1,"いのち"],[12,1,"かえり"],[16,1,"あ"],[19,1,"もの"],[21,2,"ざんにん"]],"text":"正しい人はその家畜の命を顧みる、悪しき者は残忍をもって、あわれみとする。"},{"ref":"Prov.12.11","start":20012011,"end":20012011,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"じぶん"],[3,2,"でんち"],[6,1,"たがや"],[8,1,"もの"],[10,2,"しょくりょう"],[13,1,"あ"],[17,2,"むえき"],[20,1,"こと"],[22,1,"したが"],[24,1,"もの"],[26,2,"ちえ"]],"text":"自分の田地を耕す者は食糧に飽きる、無益な事に従う者は知恵がない。"},{"ref":"Prov.12.12","start":20012012,"end":20012012,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,2,"けんご"],[12,2,"ほうかい"],[17,1,"ただ"],[20,1,"ひと"],[22,1,"ね"],[24,1,"かた"],[26,1,"た"]],"text":"悪しき者の堅固なやぐらは崩壊する、正しい人の根は堅く立つ。"},{"ref":"Prov.12.13","start":20012013,"end":20012013,"break":"line","breaks":[[21,"line"]],"ruby":[[0,2,"あくにん"],[18,1,"おちい"],[24,1,"ただ"],[27,1,"ひと"],[29,1,"なや"]],"text":"悪人はくちびるのとがによって、わなに陥る、しかし正しい人は悩みをのがれる。"},{"ref":"Prov.12.14","start":20012014,"end":20012014,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ひと"],[4,1,"くち"],[6,1,"み"],[12,2,"こうふく"],[15,1,"み"],[17,1,"た"],[20,1,"ひと"],[22,1,"て"],[30,1,"ひと"],[32,1,"み"],[34,1,"かえ"]],"text":"人はその口の実によって、幸福に満ち足り、人の手のわざは、その人の身に帰る。"},{"ref":"Prov.12.15","start":20012015,"end":20012015,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"おろ"],[3,1,"ひと"],[5,1,"みち"],[8,2,"じぶん"],[11,1,"め"],[13,1,"ただ"],[16,1,"み"],[23,2,"ちえ"],[27,1,"もの"],[29,1,"すす"]],"text":"愚かな人の道は、自分の目に正しく見える、しかし知恵ある者は勧めをいれる。"},{"ref":"Prov.12.16","start":20012016,"end":20012016,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"おろ"],[3,1,"ひと"],[9,1,"いか"],[20,1,"かしこ"],[22,1,"ひと"],[32,1,"き"]],"text":"愚かな人は、すぐに怒りをあらわす、しかし賢い人は、はずかしめをも気にとめない。"},{"ref":"Prov.12.17","start":20012017,"end":20012017,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"しんじつ"],[3,1,"かた"],[5,1,"ひと"],[7,1,"ただ"],[10,2,"しょうげん"],[16,1,"いつわ"],[19,2,"しょうにん"],[22,1,"いつわ"],[25,1,"い"]],"text":"真実を語る人は正しい証言をなし、偽りの証人は偽りを言う。"},{"ref":"Prov.12.18","start":20012018,"end":20012018,"break":"line","breaks":[[13,"line"],[27,"line"]],"ruby":[[7,1,"さ"],[17,2,"ことば"],[20,1,"だ"],[22,1,"もの"],[30,2,"ちえ"],[34,1,"ひと"],[36,1,"した"],[38,1,"ひと"]],"text":"つるぎをもって刺すように、みだりに言葉を出す者がある、しかし知恵ある人の舌は人をいやす。"},{"ref":"Prov.12.19","start":20012019,"end":20012019,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"しんじつ"],[3,1,"い"],[16,1,"たも"],[19,1,"いつわ"],[22,1,"い"],[24,1,"した"],[35,1,"あいだ"]],"text":"真実を言うくちびるは、いつまでも保つ、偽りを言う舌は、ただ、まばたきの間だけである。"},{"ref":"Prov.12.20","start":20012020,"end":20012020,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"あく"],[6,1,"もの"],[8,1,"こころ"],[11,1,"あざむ"],[17,1,"ぜん"],[22,1,"ひと"],[25,1,"よろこ"]],"text":"悪をたくらむ者の心には欺きがあり、善をはかる人には喜びがある。"},{"ref":"Prov.12.21","start":20012021,"end":20012021,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[9,2,"がいあく"],[12,1,"しょう"],[20,1,"あ"],[23,1,"もの"],[25,1,"わざわい"],[30,1,"み"]],"text":"正しい人にはなんの害悪も生じない、しかし悪しき者は災をもって満たされる。"},{"ref":"Prov.12.22","start":20012022,"end":20012022,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"いつわ"],[3,1,"い"],[10,1,"しゅ"],[12,1,"にく"],[16,2,"しんじつ"],[19,1,"おこな"],[21,1,"もの"],[23,1,"かれ"],[25,1,"よろこ"]],"text":"偽りを言うくちびるは主に憎まれ、真実を行う者は彼に喜ばれる。"},{"ref":"Prov.12.23","start":20012023,"end":20012023,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"ひと"],[5,2,"ちしき"],[15,1,"おろ"],[18,1,"もの"],[20,2,"じぶん"],[23,1,"おろ"]],"text":"さとき人は知識をかくす、しかし愚かな者は自分の愚かなことをあらわす。"},{"ref":"Prov.12.24","start":20012024,"end":20012024,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"つと"],[2,1,"はたら"],[4,1,"もの"],[6,1,"て"],[11,1,"ひと"],[13,1,"おさ"],[17,1,"おこた"],[19,1,"もの"],[21,1,"ひと"],[23,1,"つか"]],"text":"勤め働く者の手はついに人を治める、怠る者は人に仕えるようになる。"},{"ref":"Prov.12.25","start":20012025,"end":20012025,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"こころ"],[2,1,"うれ"],[10,1,"ひと"],[21,2,"しんせつ"],[24,2,"ことば"],[29,1,"ひと"],[31,1,"よろこ"]],"text":"心に憂いがあればその人をかがませる、しかし親切な言葉はその人を喜ばせる。"},{"ref":"Prov.12.26","start":20012026,"end":20012026,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ただ"],[3,1,"ひと"],[5,1,"あく"],[7,1,"はな"],[9,1,"さ"],[15,1,"あ"],[18,1,"もの"],[20,1,"みずか"],[22,1,"みち"],[24,1,"まよ"]],"text":"正しい人は悪を離れ去る、しかし悪しき者は自ら道に迷う。"},{"ref":"Prov.12.27","start":20012027,"end":20012027,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おこた"],[2,1,"もの"],[4,2,"じぶん"],[7,2,"えもの"],[10,1,"とら"],[18,1,"つと"],[20,1,"はたら"],[22,1,"ひと"],[24,1,"たっと"],[26,1,"たから"],[28,1,"え"]],"text":"怠る者は自分の獲物を捕えない、しかし勤め働く人は尊い宝を獲る。"},{"ref":"Prov.12.28","start":20012028,"end":20012028,"break":"line","breaks":[[11,"line"]],"ruby":[[0,2,"せいぎ"],[3,1,"みち"],[6,1,"いのち"],[14,1,"あやま"],[17,1,"みち"],[19,1,"し"],[21,1,"いた"]],"text":"正義の道には命がある、しかし誤りの道は死に至る。"}]