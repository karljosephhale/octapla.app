[{"ref":"Zech.2.1","start":38002001,"end":38002001,"break":"paragraph","ruby":[[6,1,"め"],[11,1,"み"],[17,1,"み"],[24,1,"ひと"],[27,1,"はか"],[32,1,"て"],[34,1,"も"]],"text":"またわたしが目をあげて見ていると、見よ、ひとりの人が、測りなわを手に持っているので、"},{"ref":"Zech.2.2","start":38002002,"end":38002002,"break":"none","ruby":[[8,1,"い"],[16,1,"たず"],[23,1,"ひと"],[29,1,"い"],[40,1,"はか"],[46,1,"ひろ"],[50,1,"なが"],[53,1,"み"]],"text":"「あなたはどこへ行くのですか」と尋ねると、その人はわたしに言った、「エルサレムを測って、その広さと、長さを見ようとするのです」。"},{"ref":"Zech.2.3","start":38002003,"end":38002003,"break":"none","ruby":[[3,1,"み"],[10,1,"かた"],[12,1,"てん"],[14,1,"つかい"],[16,1,"で"],[18,1,"い"],[28,1,"てん"],[30,1,"つかい"],[32,1,"で"],[40,2,"であ"]],"text":"すると見よ、わたしと語る天の使が出て行くと、またひとりの天の使が出てきて、これに出会って、"},{"ref":"Zech.2.4","start":38002004,"end":38002004,"break":"none","ruby":[[0,1,"い"],[5,1,"はし"],[8,1,"い"],[14,1,"わか"],[16,1,"ひと"],[18,1,"い"],[33,1,"なか"],[36,1,"ひと"],[38,2,"かちく"],[41,1,"おお"],[48,2,"じょうへき"],[53,2,"むらざと"],[60,1,"ひと"],[62,1,"す"],[64,1,"ところ"]],"text":"言った、「走って行って、あの若い人に言いなさい、『エルサレムはその中に、人と家畜が多くなるので、城壁のない村里のように、人の住む所となるでしょう。"},{"ref":"Zech.2.5","start":38002005,"end":38002005,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"おお"],[15,2,"しゅうい"],[18,1,"ひ"],[20,2,"じょうへき"],[28,1,"なか"],[30,2,"えいこう"]],"text":"主は仰せられます、わたしはその周囲で火の城壁となり、その中で栄光となる』と」。"},{"ref":"Zech.2.6","start":38002006,"end":38002006,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"おお"],[11,1,"きた"],[13,1,"ち"],[16,1,"に"],[19,1,"き"],[35,1,"てん"],[37,2,"しほう"],[40,1,"かぜ"],[45,1,"ち"]],"text":"主は仰せられる、さあ、北の地から逃げて来なさい。わたしはあなたがたを、天の四方の風のように散らしたからである。"},{"ref":"Zech.2.7","start":38002007,"end":38002007,"break":"none","ruby":[[8,1,"むすめ"],[10,1,"とも"],[14,1,"もの"]],"text":"さあ、バビロンの娘と共にいる者よ、シオンにのがれなさい。"},{"ref":"Zech.2.8","start":38002008,"end":38002008,"break":"none","ruby":[[9,1,"もの"],[12,1,"かれ"],[14,1,"め"],[16,1,"たま"],[34,1,"とら"],[40,2,"くにぐに"],[43,1,"たみ"],[48,2,"えいこう"],[67,2,"ばんぐん"],[70,1,"しゅ"],[75,1,"おお"]],"text":"あなたがたにさわる者は、彼の目の玉にさわるのであるから、あなたがたを捕えていった国々の民に、その栄光にしたがって、わたしをつかわされた万軍の主は、こう仰せられる、"},{"ref":"Zech.2.9","start":38002009,"end":38002009,"break":"none","ruby":[[1,1,"み"],[8,1,"かれ"],[11,1,"うえ"],[13,1,"て"],[15,1,"ふ"],[18,1,"かれ"],[21,2,"じぶん"],[24,1,"つか"],[27,1,"もの"],[38,1,"とき"],[45,2,"ばんぐん"],[48,1,"しゅ"],[64,1,"し"]],"text":"「見よ、わたしは彼らの上に手を振る。彼らは自分に仕えた者のとりことなる。その時あなたがたは万軍の主が、わたしをつかわされたことを知る。"},{"ref":"Zech.2.10","start":38002010,"end":38002010,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"むすめ"],[14,1,"よろこ"],[16,1,"うた"],[23,1,"き"],[30,1,"なか"],[32,1,"す"]],"text":"主は言われる、シオンの娘よ、喜び歌え。わたしが来て、あなたの中に住むからである。"},{"ref":"Zech.2.11","start":38002011,"end":38002011,"break":"none","ruby":[[2,1,"ひ"],[6,1,"おお"],[9,2,"こくみん"],[12,1,"しゅ"],[14,1,"つら"],[23,1,"たみ"],[36,1,"なか"],[38,1,"す"]],"text":"その日には、多くの国民が主に連なって、わたしの民となる。わたしはあなたの中に住む。"},{"ref":"Zech.2.12","start":38002012,"end":38002012,"break":"none","ruby":[[4,2,"ばんぐん"],[7,1,"しゅ"],[27,1,"し"],[30,1,"しゅ"],[32,2,"せいち"],[39,2,"じぶん"],[42,1,"ぶん"],[46,1,"と"],[55,1,"ふたた"],[57,1,"えら"]],"text":"あなたは万軍の主が、わたしをあなたにつかわされたことを知る。主は聖地で、ユダを自分の分として取り、エルサレムを再び選ばれるであろう」。"},{"ref":"Zech.2.13","start":38002013,"end":38002013,"break":"none","ruby":[[3,1,"にく"],[6,1,"もの"],[9,1,"しゅ"],[11,1,"まえ"],[13,1,"しず"],[17,1,"しゅ"],[21,1,"せい"],[29,1,"た"]],"text":"すべて肉なる者よ、主の前に静まれ。主はその聖なるすみかから立ちあがられたからである。"}]