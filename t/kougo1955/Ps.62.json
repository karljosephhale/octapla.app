[{"ref":"Ps.62.1","start":19062001,"end":19062001,"break":"paragraph","title":"聖歌隊の指揮者によってエドトンのしらべにしたがってうたわせたダビデの歌","breaks":[[15,"line"]],"ruby":[[2,1,"たましい"],[10,1,"かみ"],[17,1,"すくい"],[19,1,"かみ"],[22,1,"く"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[34,1,"うた"]],"text":"わが魂はもだしてただ神をまつ。わが救は神から来る。"},{"ref":"Ps.62.2","start":19062002,"end":19062002,"break":"line","breaks":[[11,"line"],[22,"line"]],"ruby":[[0,1,"かみ"],[5,1,"いわ"],[9,1,"すくい"],[13,1,"たか"],[29,1,"うご"]],"text":"神こそわが岩、わが救、わが高きやぐらである。わたしはいたく動かされることはない。"},{"ref":"Ps.62.3","start":19062003,"end":19062003,"break":"line","breaks":[[20,"line"],[39,"line"]],"ruby":[[11,1,"ひと"],[13,1,"お"],[15,1,"せま"],[26,1,"みな"],[28,1,"かたむ"],[31,1,"いし"],[39,1,"ゆ"],[41,1,"うご"],[50,1,"ひと"],[52,1,"たお"]],"text":"あなたがたは、いつまで人に押し迫るのか。あなたがたは皆、傾いた石がきのように、揺り動くまがきのように人を倒そうとするのか。"},{"ref":"Ps.62.4","start":19062004,"end":19062004,"break":"line","breaks":[[21,"line"],[36,"line"]],"ruby":[[0,1,"かれ"],[3,1,"ひと"],[5,1,"たっと"],[7,2,"ちい"],[11,1,"おと"],[21,1,"いつわ"],[24,1,"よろこ"],[29,1,"くち"],[32,2,"しゅくふく"],[36,1,"こころ"]],"text":"彼らは人を尊い地位から落そうとのみはかり、偽りを喜び、その口では祝福し、心のうちではのろうのである。〔セラ"},{"ref":"Ps.62.5","start":19062005,"end":19062005,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"たましい"],[10,1,"かみ"],[17,1,"のぞ"],[20,1,"かみ"],[23,1,"く"]],"text":"わが魂はもだしてただ神をまつ。わが望みは神から来るからである。"},{"ref":"Ps.62.6","start":19062006,"end":19062006,"break":"line","breaks":[[11,"line"],[22,"line"]],"ruby":[[0,1,"かみ"],[5,1,"いわ"],[9,1,"すくい"],[13,1,"たか"],[26,1,"うご"]],"text":"神こそわが岩、わが救、わが高きやぐらである。わたしは動かされることはない。"},{"ref":"Ps.62.7","start":19062007,"end":19062007,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"すくい"],[6,1,"ほまれ"],[9,1,"かみ"],[14,1,"かみ"],[18,1,"ちから"],[20,1,"いわ"],[24,1,"さ"],[26,1,"どころ"]],"text":"わが救とわが誉とは神にある。神はわが力の岩、わが避け所である。"},{"ref":"Ps.62.8","start":19062008,"end":19062008,"break":"line","breaks":[[17,"line"],[35,"line"]],"ruby":[[0,1,"たみ"],[7,1,"とき"],[10,1,"かみ"],[12,2,"しんらい"],[20,1,"まえ"],[28,1,"こころ"],[30,1,"そそ"],[32,1,"だ"],[35,1,"かみ"],[41,1,"さ"],[43,1,"どころ"]],"text":"民よ、いかなる時にも神に信頼せよ。そのみ前にあなたがたの心を注ぎ出せ。神はわれらの避け所である。〔セラ"},{"ref":"Ps.62.9","start":19062009,"end":19062009,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ひく"],[2,1,"ひと"],[9,1,"たか"],[11,1,"ひと"],[13,1,"いつわ"],[19,1,"かれ"],[30,1,"かれ"],[33,1,"とも"],[35,1,"いき"],[39,1,"かる"]],"text":"低い人はむなしく、高い人は偽りである。彼らをはかりにおけば、彼らは共に息よりも軽い。"},{"ref":"Ps.62.10","start":19062010,"end":19062010,"break":"line","breaks":[[22,"line"],[47,"line"]],"ruby":[[25,1,"うば"],[35,1,"のぞ"],[47,1,"とみ"],[49,1,"ま"],[51,1,"くわ"],[60,1,"こころ"]],"text":"あなたがたは、しえたげにたよってはならない。かすめ奪うことに、むなしい望みをおいてはならない。富の増し加わるとき、これに心をかけてはならない。"},{"ref":"Ps.62.11","start":19062011,"end":19062011,"break":"line","breaks":[[11,"line"],[26,"line"]],"ruby":[[0,1,"かみ"],[6,1,"い"],[22,1,"き"],[26,1,"ちから"],[28,1,"かみ"],[30,1,"ぞく"]],"text":"神はひとたび言われた、わたしはふたたびこれを聞いた、力は神に属することを。"},{"ref":"Ps.62.12","start":19062012,"end":19062012,"break":"line","breaks":[[22,"line"],[40,"line"]],"ruby":[[0,1,"しゅ"],[15,1,"ぞく"],[26,1,"ひと"],[40,1,"むく"]],"text":"主よ、いつくしみもまたあなたに属することを。あなたは人おのおののわざにしたがって報いられるからである。"}]