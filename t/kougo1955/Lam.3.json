[{"ref":"Lam.3.1","start":25003001,"end":25003001,"break":"paragraph","breaks":[[16,"line"]],"ruby":[[4,1,"かれ"],[6,1,"いか"],[16,1,"なや"],[22,1,"ひと"]],"text":"わたしは彼の怒りのむちによって、悩みにあった人である。"},{"ref":"Lam.3.2","start":25003002,"end":25003002,"break":"line","ruby":[[0,1,"かれ"],[8,1,"た"],[12,1,"ひかり"],[16,1,"くら"],[18,1,"なか"],[20,1,"ある"]],"text":"彼はわたしをかり立てて、光のない暗い中を歩かせ、"},{"ref":"Lam.3.3","start":25003003,"end":25003003,"break":"line","breaks":[[16,"line"]],"ruby":[[6,1,"て"],[24,1,"せ"]],"text":"まことにその手をしばしばかえて、ひねもすわたしを攻められた。"},{"ref":"Lam.3.4","start":25003004,"end":25003004,"break":"line","ruby":[[0,1,"かれ"],[4,1,"にく"],[6,1,"かわ"],[8,1,"おとろ"],[15,1,"ほね"],[17,1,"くだ"]],"text":"彼はわが肉と皮を衰えさせ、わが骨を砕き、"},{"ref":"Lam.3.5","start":25003005,"end":25003005,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"くる"],[4,1,"なや"],[15,1,"かこ"],[22,1,"と"]],"text":"苦しみと悩みをもって、わたしを囲み、わたしを閉じこめ、"},{"ref":"Lam.3.6","start":25003006,"end":25003006,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"とお"],[2,1,"むかし"],[4,1,"し"],[7,1,"もの"],[13,1,"くら"],[15,1,"ところ"],[17,1,"す"]],"text":"遠い昔に死んだ者のように、暗い所に住まわせられた。"},{"ref":"Lam.3.7","start":25003007,"end":25003007,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[0,1,"かれ"],[20,1,"で"],[34,1,"おも"],[36,1,"くさり"]],"text":"彼はわたしのまわりに、かきをめぐらして、出ることのできないようにし、重い鎖でわたしをつながれた。"},{"ref":"Lam.3.8","start":25003008,"end":25003008,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"さけ"],[7,1,"たす"],[10,1,"もと"],[15,1,"かれ"],[21,1,"いのり"]],"text":"わたしは叫んで助けを求めたが、彼はわたしの祈をしりぞけ、"},{"ref":"Lam.3.9","start":25003009,"end":25003009,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"き"],[2,1,"いし"],[12,1,"い"],[14,1,"みち"],[24,2,"みちすじ"],[27,1,"ま"]],"text":"切り石をもって、わたしの行く道をふさぎ、わたしの道筋を曲げられた。"},{"ref":"Lam.3.10","start":25003010,"end":25003010,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[6,1,"たい"],[9,1,"ま"],[11,1,"ぶ"],[22,1,"ひそ"],[24,1,"かく"]],"text":"彼はわたしに対して待ち伏せするくまのように、潜み隠れるししのように、"},{"ref":"Lam.3.11","start":25003011,"end":25003011,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"みち"],[4,1,"はな"],[13,1,"ひ"],[15,1,"さ"],[19,1,"み"],[30,1,"もの"]],"text":"わが道を離れさせ、わたしを引き裂いて、見るかげもないみじめな者とし、"},{"ref":"Lam.3.12","start":25003012,"end":25003012,"break":"line","breaks":[[8,"line"]],"ruby":[[2,1,"ゆみ"],[4,1,"は"],[12,1,"や"],[14,1,"まと"]],"text":"その弓を張って、わたしを矢の的のようにされた。"},{"ref":"Lam.3.13","start":25003013,"end":25003013,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"かれ"],[4,1,"えびら"],[6,1,"や"],[12,2,"しんぞう"],[15,1,"う"],[17,1,"こ"]],"text":"彼はその箙の矢をわたしの心臓に打ち込まれた。"},{"ref":"Lam.3.14","start":25003014,"end":25003014,"break":"line","breaks":[[17,"line"]],"ruby":[[8,1,"たみ"],[10,2,"ものわら"],[21,1,"かれ"],[24,1,"うた"]],"text":"わたしはすべての民の物笑いとなり、ひねもす彼らの歌となった。"},{"ref":"Lam.3.15","start":25003015,"end":25003015,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[6,1,"にが"],[8,1,"もの"],[10,1,"あ"],[24,1,"の"]],"text":"彼はわたしを苦い物で飽かせ、にがよもぎをわたしに飲ませられた。"},{"ref":"Lam.3.16","start":25003016,"end":25003016,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[2,2,"こいし"],[13,1,"は"],[15,1,"くだ"],[18,1,"はい"],[20,1,"なか"]],"text":"彼は小石をもって、わたしの歯を砕き、灰の中にわたしをころがされた。"},{"ref":"Lam.3.17","start":25003017,"end":25003017,"break":"line","breaks":[[10,"line"]],"ruby":[[2,1,"たましい"],[4,2,"へいわ"],[7,1,"うしな"],[14,2,"こうふく"],[17,1,"わす"]],"text":"わが魂は平和を失い、わたしは幸福を忘れた。"},{"ref":"Lam.3.18","start":25003018,"end":25003018,"break":"line","breaks":[[22,"line"]],"ruby":[[7,1,"い"],[14,1,"さか"],[19,1,"さ"],[26,1,"しゅ"],[28,1,"のぞ"],[39,1,"さ"]],"text":"そこでわたしは言った、「わが栄えはうせ去り、わたしが主に望むところのものもうせ去った」と。"},{"ref":"Lam.3.19","start":25003019,"end":25003019,"break":"line","breaks":[[13,"line"]],"ruby":[[6,1,"なや"],[9,1,"くる"],[19,2,"たんじゅう"],[23,1,"こころ"],[25,1,"と"]],"text":"どうか、わが悩みと苦しみ、にがよもぎと胆汁とを心に留めてください。"},{"ref":"Lam.3.20","start":25003020,"end":25003020,"break":"line","breaks":[[14,"line"]],"ruby":[[2,1,"たましい"],[4,1,"た"],[10,1,"おも"]],"text":"わが魂は絶えずこれを思って、わがうちにうなだれる。"},{"ref":"Lam.3.21","start":25003021,"end":25003021,"break":"line","breaks":[[19,"line"]],"ruby":[[10,1,"こと"],[12,1,"こころ"],[14,1,"おも"],[16,1,"おこ"],[28,1,"のぞ"]],"text":"しかし、わたしはこの事を心に思い起す。それゆえ、わたしは望みをいだく。"},{"ref":"Lam.3.22","start":25003022,"end":25003022,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"た"],[24,1,"つ"]],"text":"主のいつくしみは絶えることがなく、そのあわれみは尽きることがない。"},{"ref":"Lam.3.23","start":25003023,"end":25003023,"break":"line","breaks":[[11,"line"]],"ruby":[[3,1,"あさ"],[7,1,"あたら"],[15,2,"しんじつ"],[18,1,"おお"]],"text":"これは朝ごとに新しく、あなたの真実は大きい。"},{"ref":"Lam.3.24","start":25003024,"end":25003024,"break":"line","breaks":[[23,"line"]],"ruby":[[2,1,"たましい"],[4,1,"い"],[8,1,"しゅ"],[14,1,"う"],[18,1,"ぶん"],[32,1,"かれ"],[34,1,"ま"],[36,1,"のぞ"]],"text":"わが魂は言う、「主はわたしの受くべき分である、それゆえ、わたしは彼を待ち望む」と。"},{"ref":"Lam.3.25","start":25003025,"end":25003025,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ま"],[8,1,"のぞ"],[10,1,"もの"],[17,1,"たず"],[19,1,"もと"],[22,1,"もの"],[28,1,"めぐ"]],"text":"主はおのれを待ち望む者と、おのれを尋ね求める者にむかって恵みふかい。"},{"ref":"Lam.3.26","start":25003026,"end":25003026,"break":"line","ruby":[[0,1,"しゅ"],[2,1,"すくい"],[4,1,"しず"],[7,1,"ま"],[9,1,"のぞ"],[15,1,"よ"]],"text":"主の救を静かに待ち望むことは、良いことである。"},{"ref":"Lam.3.27","start":25003027,"end":25003027,"break":"line","ruby":[[0,1,"ひと"],[2,1,"わか"],[4,1,"とき"],[10,1,"お"],[16,1,"よ"]],"text":"人が若い時にくびきを負うことは、良いことである。"},{"ref":"Lam.3.28","start":25003028,"end":25003028,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"お"],[21,1,"もく"]],"text":"主がこれを負わせられるとき、ひとりすわって黙しているがよい。"},{"ref":"Lam.3.29","start":25003029,"end":25003029,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"くち"],[15,1,"のぞ"]],"text":"口をちりにつけよ、あるいはなお望みがあるであろう。"},{"ref":"Lam.3.30","start":25003030,"end":25003030,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"う"],[6,1,"もの"],[11,1,"む"],[14,1,"み"],[16,1,"た"],[29,1,"う"]],"text":"おのれを撃つ者にほおを向け、満ち足りるまでに、はずかしめを受けよ。"},{"ref":"Lam.3.31","start":25003031,"end":25003031,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[12,1,"ひと"],[14,1,"す"]],"text":"主はとこしえにこのような人を捨てられないからである。"},{"ref":"Lam.3.32","start":25003032,"end":25003032,"break":"line","breaks":[[12,"line"],[26,"line"]],"ruby":[[0,1,"かれ"],[2,1,"なや"],[5,1,"あた"],[20,1,"ゆた"]],"text":"彼は悩みを与えられるが、そのいつくしみが豊かなので、またあわれみをたれられる。"},{"ref":"Lam.3.33","start":25003033,"end":25003033,"break":"line","breaks":[[9,"line"]],"ruby":[[0,1,"かれ"],[2,1,"こころ"],[5,1,"ひと"],[7,1,"こ"],[9,1,"くる"],[12,1,"なや"]],"text":"彼は心から人の子を苦しめ悩ますことをされないからである。"},{"ref":"Lam.3.34","start":25003034,"end":25003034,"break":"line","ruby":[[0,1,"ち"],[6,1,"とら"],[9,1,"びと"],[11,1,"あし"],[13,1,"した"],[15,1,"ふ"]],"text":"地のすべての捕われ人を足の下に踏みにじり、"},{"ref":"Lam.3.35","start":25003035,"end":25003035,"break":"line","ruby":[[2,1,"たか"],[4,1,"もの"],[6,1,"まえ"],[8,1,"ひと"],[10,2,"こうぎ"]],"text":"いと高き者の前に人の公義をまげ、"},{"ref":"Lam.3.36","start":25003036,"end":25003036,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ひと"],[2,1,"うった"],[14,1,"しゅ"]],"text":"人の訴えをくつがえすことは、主のよみせられないことである。"},{"ref":"Lam.3.37","start":25003037,"end":25003037,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"めい"],[17,1,"めい"],[23,1,"こと"],[25,1,"な"]],"text":"主が命じられたのでなければ、だれが命じて、その事の成ったことがあるか。"},{"ref":"Lam.3.38","start":25003038,"end":25003038,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"わざわい"],[10,1,"たか"],[12,1,"もの"],[14,1,"くち"],[17,1,"で"]],"text":"災もさいわいも、いと高き者の口から出るではないか。"},{"ref":"Lam.3.39","start":25003039,"end":25003039,"break":"line","breaks":[[22,"line"],[37,"line"]],"ruby":[[0,1,"い"],[3,1,"ひと"],[22,1,"ひと"],[24,2,"じぶん"],[27,1,"つみ"],[29,1,"ばっ"]],"text":"生ける人はどうしてつぶやかねばならないのか、人は自分の罪の罰せられるのを、つぶやくことができようか。"},{"ref":"Lam.3.40","start":25003040,"end":25003040,"break":"line","breaks":[[15,"line"]],"ruby":[[6,2,"じぶん"],[9,1,"おこな"],[12,1,"しら"],[17,1,"かえり"],[21,1,"しゅ"],[23,1,"かえ"]],"text":"われわれは、自分の行いを調べ、かつ省みて、主に帰ろう。"},{"ref":"Lam.3.41","start":25003041,"end":25003041,"break":"line","breaks":[[17,"line"]],"ruby":[[5,1,"てん"],[10,1,"かみ"],[17,1,"て"],[19,1,"とも"],[21,1,"こころ"]],"text":"われわれは天にいます神にむかって、手と共に心をもあげよう。"},{"ref":"Lam.3.42","start":25003042,"end":25003042,"break":"line","breaks":[[19,"line"]],"ruby":[[7,1,"つみ"],[9,1,"おか"]],"text":"「わたしたちは罪を犯し、そむきました、あなたはおゆるしになりませんでした。"},{"ref":"Lam.3.43","start":25003043,"end":25003043,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"いか"],[11,2,"じぶん"],[24,1,"お"],[26,1,"せ"],[29,1,"ころ"]],"text":"あなたは怒りをもってご自分をおおい、わたしたちを追い攻め、殺して、あわれまず、"},{"ref":"Lam.3.44","start":25003044,"end":25003044,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"くも"],[8,2,"じぶん"],[15,1,"いのり"],[17,1,"つう"]],"text":"また雲をもってご自分をおおい、祈を通じないようにし、"},{"ref":"Lam.3.45","start":25003045,"end":25003045,"break":"line","breaks":[[10,"line"]],"ruby":[[5,1,"たみ"],[7,1,"なか"]],"text":"もろもろの民の中に、わたしたちをちりあくたとなさいました。"},{"ref":"Lam.3.46","start":25003046,"end":25003046,"break":"line","ruby":[[0,1,"てき"]],"text":"敵はみなわたしたちをののしり、"},{"ref":"Lam.3.47","start":25003047,"end":25003047,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"おそ"],[3,1,"おと"],[5,1,"あな"],[8,2,"こうはい"],[11,2,"めつぼう"],[22,1,"のぞ"]],"text":"恐れと落し穴と、荒廃と滅亡とが、わたしたちに臨みました。"},{"ref":"Lam.3.48","start":25003048,"end":25003048,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"たみ"],[4,1,"むすめ"],[6,1,"ほろ"],[17,1,"め"],[20,1,"なみだ"],[22,1,"かわ"],[24,1,"なが"]],"text":"わが民の娘の滅びによって、わたしの目には涙の川が流れています。"},{"ref":"Lam.3.49","start":25003049,"end":25003049,"break":"line","ruby":[[2,1,"め"],[4,1,"た"],[7,1,"なみだ"],[9,1,"そそ"],[11,1,"だ"]],"text":"わが目は絶えず涙を注ぎ出して、やむことなく、"},{"ref":"Lam.3.50","start":25003050,"end":25003050,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"てん"],[5,1,"み"],[11,1,"かえり"],[16,1,"とき"],[20,1,"およ"]],"text":"主が天から見おろして、顧みられる時にまで及ぶでしょう。"},{"ref":"Lam.3.51","start":25003051,"end":25003051,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"め"],[6,1,"まち"],[12,1,"むすめ"],[14,2,"さいご"],[25,1,"いた"]],"text":"わが目はわが町のすべての娘の最期のゆえに、わたしを痛ませます。"},{"ref":"Lam.3.52","start":25003052,"end":25003052,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"てき"],[11,1,"もの"],[23,1,"とり"],[28,1,"お"]],"text":"ゆえなくわたしに敵する者どもによって、わたしは鳥のように追われました。"},{"ref":"Lam.3.53","start":25003053,"end":25003053,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[12,1,"あな"],[14,1,"なか"],[16,1,"な"],[18,1,"い"],[25,1,"うえ"],[27,1,"いし"],[29,1,"な"]],"text":"彼らは生きているわたしを穴の中に投げ入れ、わたしの上に石を投げつけました。"},{"ref":"Lam.3.54","start":25003054,"end":25003054,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"みず"],[6,1,"あたま"],[8,1,"うえ"],[19,1,"た"],[21,1,"ほろ"],[28,1,"い"]],"text":"水はわたしの頭の上にあふれ、わたしは『断ち滅ぼされた』と言いました。"},{"ref":"Lam.3.55","start":25003055,"end":25003055,"break":"line","ruby":[[0,1,"しゅ"],[7,1,"ふか"],[9,1,"あな"],[13,1,"な"],[15,1,"よ"]],"text":"主よ、わたしは深い穴からみ名を呼びました。"},{"ref":"Lam.3.56","start":25003056,"end":25003056,"break":"line","breaks":[[15,"line"]],"ruby":[[6,1,"こえ"],[8,1,"き"],[18,1,"なげ"],[21,1,"さけ"],[24,1,"みみ"]],"text":"あなたはわが声を聞かれました、『わが嘆きと叫びに耳をふさがないでください』。"},{"ref":"Lam.3.57","start":25003057,"end":25003057,"break":"line","breaks":[[16,"line"]],"ruby":[[8,1,"よ"],[20,2,"ちかよ"],[26,1,"おそ"],[32,1,"い"]],"text":"わたしがあなたに呼ばわったとき、あなたは近寄って、『恐れるな』と言われました。"},{"ref":"Lam.3.58","start":25003058,"end":25003058,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"うった"],[12,1,"と"],[22,1,"いのち"]],"text":"主よ、あなたはわが訴えを取りあげて、わたしの命をあがなわれました。"},{"ref":"Lam.3.59","start":25003059,"end":25003059,"break":"line","breaks":[[19,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[16,2,"ふぎ"],[33,1,"うった"]],"text":"主よ、あなたはわたしがこうむった不義をごらんになりました。わたしの訴えをおさばきください。"},{"ref":"Lam.3.60","start":25003060,"end":25003060,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"たい"],[11,1,"かれ"],[14,2,"ほうふく"],[18,2,"いんぼう"]],"text":"あなたはわたしに対する彼らの報復と、陰謀とを、ことごとくごらんになりました。"},{"ref":"Lam.3.61","start":25003061,"end":25003061,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"たい"],[14,1,"かれ"],[22,2,"いんぼう"],[32,1,"き"]],"text":"主よ、あなたはわたしに対する彼らのそしりと、陰謀とを、ことごとく聞かれました。"},{"ref":"Lam.3.62","start":25003062,"end":25003062,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"た"],[7,1,"さか"],[10,1,"もの"],[22,1,"おも"],[34,1,"せ"]],"text":"立ってわたしに逆らう者どものくちびると、その思いは、ひねもすわたしを攻めています。"},{"ref":"Lam.3.63","start":25003063,"end":25003063,"break":"line","breaks":[[18,"line"],[29,"line"]],"ruby":[[4,1,"かれ"],[13,1,"た"],[33,1,"かれ"],[36,1,"うた"]],"text":"どうか、彼らのすわるをも、立つをも、みそなわしてください。わたしは彼らの歌となっています。"},{"ref":"Lam.3.64","start":25003064,"end":25003064,"break":"line","ruby":[[0,1,"しゅ"],[3,1,"かれ"],[6,1,"て"],[17,1,"かれ"],[20,1,"むく"]],"text":"主よ、彼らの手のわざにしたがって、彼らに報い、"},{"ref":"Lam.3.65","start":25003065,"end":25003065,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こころ"],[20,1,"かれ"],[23,1,"そそ"]],"text":"彼らの心をかたくなにし、あなたののろいを彼らに注いでください。"},{"ref":"Lam.3.66","start":25003066,"end":25003066,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"いか"],[9,1,"かれ"],[12,1,"お"],[15,1,"あめ"],[17,1,"した"],[20,1,"かれ"],[23,1,"ほろ"]],"text":"主よ、怒りをもって彼らを追い、天が下から彼らを滅ぼしてください」。"}]