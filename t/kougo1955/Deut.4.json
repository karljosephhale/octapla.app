[{"ref":"Deut.4.1","start":5004001,"end":5004001,"break":"paragraph","ruby":[[20,1,"おし"],[23,1,"さだ"],[32,1,"き"],[39,1,"おこな"],[57,1,"い"],[72,2,"せんぞ"],[75,1,"かみ"],[77,1,"しゅ"],[79,1,"たま"],[82,1,"ち"],[92,2,"じぶん"]],"text":"イスラエルよ、いま、わたしがあなたがたに教える定めと、おきてとを聞いて、これを行いなさい。そうすれば、あなたがたは生きることができ、あなたがたの先祖の神、主が賜わる地にはいって、それを自分のものとすることができよう。"},{"ref":"Deut.4.2","start":5004002,"end":5004002,"break":"none","ruby":[[10,1,"めい"],[13,2,"ことば"],[16,1,"つ"],[18,1,"くわ"],[29,1,"へ"],[43,1,"めい"],[52,1,"かみ"],[54,1,"しゅ"],[56,2,"めいれい"],[59,1,"まも"]],"text":"わたしがあなたがたに命じる言葉に付け加えてはならない。また減らしてはならない。わたしが命じるあなたがたの神、主の命令を守ることのできるためである。"},{"ref":"Deut.4.3","start":5004003,"end":5004003,"break":"none","ruby":[[6,1,"め"],[9,1,"しゅ"],[19,1,"おこな"],[26,1,"み"],[37,1,"したが"],[40,2,"ひとびと"],[48,1,"かみ"],[50,1,"しゅ"],[66,1,"ほろ"]],"text":"あなたがたの目は、主がバアル・ペオルで行われたことを見た。ペオルのバアルに従った人々は、あなたの神、主がことごとく、あなたのうちから滅ぼしつくされたのである。"},{"ref":"Deut.4.4","start":5004004,"end":5004004,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[16,1,"したが"],[25,1,"みな"],[31,1,"い"]],"text":"しかし、あなたがたの神、主につき従ったあなたがたは皆、きょう、生きながらえている。"},{"ref":"Deut.4.5","start":5004005,"end":5004005,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"めい"],[22,1,"さだ"],[38,1,"おし"],[53,2,"じぶん"],[61,1,"ち"],[72,1,"おこな"]],"text":"わたしはわたしの神、主が命じられたとおりに、定めと、おきてとを、あなたがたに教える。あなたがたがはいって、自分のものとする地において、そのように行うためである。"},{"ref":"Deut.4.6","start":5004006,"end":5004006,"break":"none","ruby":[[10,1,"まも"],[13,1,"おこな"],[33,1,"たみ"],[41,2,"ちえ"],[46,2,"ちしき"],[49,1,"しめ"],[51,1,"こと"],[56,1,"かれ"],[67,1,"さだ"],[70,1,"き"],[77,1,"おお"],[81,2,"こくみん"],[89,2,"ちえ"],[94,2,"ちしき"],[98,1,"たみ"],[104,1,"い"]],"text":"あなたがたは、これを守って行わなければならない。これは、もろもろの民にあなたがたの知恵、また知識を示す事である。彼らは、このもろもろの定めを聞いて、『この大いなる国民は、まことに知恵あり、知識ある民である』と言うであろう。"},{"ref":"Deut.4.7","start":5004007,"end":5004007,"break":"paragraph","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[15,1,"よ"],[17,1,"もと"],[20,1,"とき"],[30,1,"ちか"],[41,1,"おお"],[45,2,"こくみん"],[54,1,"ちか"],[58,1,"かみ"]],"text":"われわれの神、主は、われわれが呼び求める時、つねにわれわれに近くおられる。いずれの大いなる国民に、このように近くおる神があるであろうか。"},{"ref":"Deut.4.8","start":5004008,"end":5004008,"break":"none","ruby":[[7,1,"おお"],[11,2,"こくみん"],[29,1,"まえ"],[31,1,"た"],[40,2,"りっぽう"],[46,1,"ただ"],[49,1,"さだ"]],"text":"また、いずれの大いなる国民に、きょう、わたしがあなたがたの前に立てるこのすべての律法のような正しい定めと、おきてとがあるであろうか。"},{"ref":"Deut.4.9","start":5004009,"end":5004009,"break":"paragraph","ruby":[[10,1,"つつし"],[18,2,"じしん"],[23,1,"まも"],[32,1,"め"],[34,1,"み"],[39,1,"わす"],[43,1,"い"],[52,1,"あいだ"],[58,1,"こと"],[64,1,"こころ"],[67,1,"はな"],[90,2,"しそん"],[93,1,"し"]],"text":"ただあなたはみずから慎み、またあなた自身をよく守りなさい。そして目に見たことを忘れず、生きながらえている間、それらの事をあなたの心から離してはならない。またそれらのことを、あなたの子孫に知らせなければならない。"},{"ref":"Deut.4.10","start":5004010,"end":5004010,"break":"none","ruby":[[16,1,"かみ"],[18,1,"しゅ"],[20,1,"まえ"],[22,1,"た"],[25,1,"ひ"],[28,1,"しゅ"],[34,1,"い"],[40,1,"たみ"],[49,1,"あつ"],[57,1,"かれ"],[64,2,"ことば"],[67,1,"き"],[71,2,"ちじょう"],[74,1,"い"],[81,1,"あいだ"],[83,1,"かれ"],[90,1,"おそ"],[96,1,"まな"],[104,1,"こ"],[105,1,"とも"],[107,1,"おし"]],"text":"あなたがホレブにおいて、あなたの神、主の前に立った日に、主はわたしに言われた、『民をわたしのもとに集めよ。わたしは彼らにわたしの言葉を聞かせ、地上に生きながらえる間、彼らにわたしを恐れることを学ばせ、またその子供を教えることのできるようにさせよう』。"},{"ref":"Deut.4.11","start":5004011,"end":5004011,"break":"none","ruby":[[9,1,"ちか"],[14,1,"やま"],[20,1,"た"],[25,1,"やま"],[27,1,"ひ"],[29,1,"や"],[35,1,"ほのお"],[37,2,"ちゅうてん"],[40,1,"たっ"],[43,2,"あんこく"],[46,1,"くも"],[48,1,"こ"],[50,1,"くも"]],"text":"そこであなたがたは近づいて、山のふもとに立ったが、山は火で焼けて、その炎は中天に達し、暗黒と雲と濃い雲とがあった。"},{"ref":"Deut.4.12","start":5004012,"end":5004012,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,1,"ひ"],[6,1,"なか"],[16,1,"かた"],[28,2,"ことば"],[31,1,"こえ"],[33,1,"き"],[41,1,"こえ"],[50,1,"かたち"],[52,1,"み"]],"text":"時に主は火の中から、あなたがたに語られたが、あなたがたは言葉の声を聞いたけれども、声ばかりで、なんの形も見なかった。"},{"ref":"Deut.4.13","start":5004013,"end":5004013,"break":"none","ruby":[[0,1,"しゅ"],[4,2,"けいやく"],[7,1,"の"],[14,1,"おこな"],[26,1,"めい"],[39,2,"じっかい"],[46,1,"しゅ"],[51,1,"に"],[52,1,"まい"],[54,1,"いし"],[56,1,"いた"],[58,1,"か"]],"text":"主はその契約を述べて、それを行うように、あなたがたに命じられた。それはすなわち十誡であって、主はそれを二枚の石の板に書きしるされた。"},{"ref":"Deut.4.14","start":5004014,"end":5004014,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[10,1,"めい"],[20,1,"さだ"],[29,1,"おし"],[43,1,"わた"],[46,1,"い"],[49,2,"じぶん"],[57,1,"ち"],[60,1,"おこな"]],"text":"その時、主はわたしに命じて、あなたがたに定めと、おきてとを教えさせられた。あなたがたが渡って行って自分のものとする地で、行わせるためであった。"},{"ref":"Deut.4.15","start":5004015,"end":5004015,"break":"paragraph","ruby":[[15,1,"ふか"],[17,1,"つつし"],[32,1,"しゅ"],[34,1,"ひ"],[36,1,"なか"],[45,1,"かた"],[49,1,"ひ"],[61,1,"かたち"],[63,1,"み"]],"text":"それゆえ、あなたがたはみずから深く慎まなければならない。ホレブで主が火の中からあなたがたに語られた日に、あなたがたはなんの形も見なかった。"},{"ref":"Deut.4.16","start":5004016,"end":5004016,"break":"none","ruby":[[9,1,"みち"],[11,1,"あやま"],[15,2,"じぶん"],[25,1,"かたち"],[27,1,"きざ"],[30,1,"ぞう"],[33,1,"つく"],[42,1,"おとこ"],[46,1,"おんな"],[48,1,"ぞう"],[50,1,"つく"]],"text":"それであなたがたは道を誤って、自分のために、どんな形の刻んだ像をも造ってはならない。男または女の像を造ってはならない。"},{"ref":"Deut.4.17","start":5004017,"end":5004017,"break":"none","ruby":[[4,1,"ち"],[6,1,"うえ"],[15,1,"けもの"],[17,1,"ぞう"],[19,1,"そら"],[21,1,"と"],[28,1,"とり"],[30,1,"ぞう"]],"text":"すなわち地の上におるもろもろの獣の像、空を飛ぶもろもろの鳥の像、"},{"ref":"Deut.4.18","start":5004018,"end":5004018,"break":"none","ruby":[[0,1,"ち"],[2,1,"は"],[9,1,"もの"],[11,1,"ぞう"],[13,1,"ち"],[15,1,"した"],[17,1,"みず"],[19,1,"なか"],[28,1,"うお"],[30,1,"ぞう"],[32,1,"つく"]],"text":"地に這うもろもろの物の像、地の下の水の中におるもろもろの魚の像を造ってはならない。"},{"ref":"Deut.4.19","start":5004019,"end":5004019,"break":"none","ruby":[[6,1,"め"],[8,1,"あ"],[11,1,"てん"],[13,1,"のぞ"],[16,1,"ひ"],[18,1,"つき"],[20,1,"ほし"],[28,1,"てん"],[30,2,"ばんしょう"],[33,1,"み"],[35,2,"ゆうわく"],[43,1,"おが"],[49,1,"つか"],[70,1,"かみ"],[72,1,"しゅ"],[74,1,"ぜん"],[75,2,"てんか"],[78,2,"ばんみん"],[81,1,"わ"]],"text":"あなたはまた目を上げて天を望み、日、月、星すなわちすべて天の万象を見、誘惑されてそれを拝み、それに仕えてはならない。それらのものは、あなたの神、主が全天下の万民に分けられたものである。"},{"ref":"Deut.4.20","start":5004020,"end":5004020,"break":"none","ruby":[[4,1,"しゅ"],[12,1,"と"],[16,1,"てつ"],[18,1,"ろ"],[29,1,"みちび"],[31,1,"だ"],[34,2,"じぶん"],[37,2,"しょゆう"],[40,1,"たみ"],[50,1,"み"]],"text":"しかし、主はあなたがたを取って、鉄の炉すなわちエジプトから導き出し、自分の所有の民とされた。きょう、見るとおりである。"},{"ref":"Deut.4.21","start":5004021,"end":5004021,"break":"none","ruby":[[4,1,"しゅ"],[20,1,"いか"],[32,1,"わた"],[35,1,"い"],[52,1,"かみ"],[54,1,"しゅ"],[56,1,"し"],[57,1,"ぎょう"],[65,1,"たま"],[68,1,"よ"],[70,1,"ち"],[86,1,"ちか"]],"text":"ところで主はあなたがたのゆえに、わたしを怒り、わたしがヨルダンを渡って行くことができないことと、あなたの神、主が嗣業としてあなたに賜わる良い地にはいることができないこととを誓われた。"},{"ref":"Deut.4.22","start":5004022,"end":5004022,"break":"none","ruby":[[6,1,"ち"],[8,1,"し"],[16,1,"わた"],[19,1,"い"],[38,1,"わた"],[41,1,"い"],[47,1,"よ"],[49,1,"ち"],[51,1,"え"]],"text":"わたしはこの地で死ぬ。ヨルダンを渡って行くことはできない。しかしあなたがたは渡って行って、あの良い地を獲るであろう。"},{"ref":"Deut.4.23","start":5004023,"end":5004023,"break":"none","ruby":[[6,1,"つつし"],[15,1,"かみ"],[17,1,"しゅ"],[25,1,"むす"],[29,2,"けいやく"],[32,1,"わす"],[40,1,"かみ"],[42,1,"しゅ"],[44,1,"きん"],[52,1,"かたち"],[54,1,"きざ"],[57,1,"ぞう"],[60,1,"つく"]],"text":"あなたがたは慎み、あなたがたの神、主があなたがたと結ばれた契約を忘れて、あなたの神、主が禁じられたどんな形の刻んだ像をも造ってはならない。"},{"ref":"Deut.4.24","start":5004024,"end":5004024,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"や"],[13,1,"ひ"],[18,1,"かみ"]],"text":"あなたの神、主は焼きつくす火、ねたむ神である。"},{"ref":"Deut.4.25","start":5004025,"end":5004025,"break":"paragraph","ruby":[[6,1,"こ"],[8,1,"う"],[11,1,"まご"],[13,1,"え"],[15,1,"なが"],[19,1,"ち"],[27,1,"みち"],[29,1,"あやま"],[36,1,"なに"],[39,1,"かたち"],[41,1,"きざ"],[44,1,"ぞう"],[46,1,"つく"],[53,1,"かみ"],[55,1,"しゅ"],[57,1,"め"],[59,1,"まえ"],[61,1,"あく"],[69,1,"いきどお"],[72,1,"ひ"],[74,1,"おこ"]],"text":"あなたがたが子を生み、孫を得、長くその地におるうちに、道を誤って、すべて何かの形に刻んだ像を造り、あなたの神、主の目の前に悪をなして、その憤りを引き起すことがあれば、"},{"ref":"Deut.4.26","start":5004026,"end":5004026,"break":"none","ruby":[[9,1,"てん"],[11,1,"ち"],[13,1,"よ"],[22,1,"たい"],[43,1,"わた"],[46,1,"い"],[49,1,"え"],[51,1,"ち"],[59,2,"ぜんめつ"],[76,1,"ところ"],[78,1,"なが"],[80,1,"いのち"],[82,1,"たも"],[91,1,"まった"],[93,1,"ほろ"]],"text":"わたしは、きょう、天と地を呼んであなたがたに対してあかしとする。あなたがたはヨルダンを渡って行って獲る地から、たちまち全滅するであろう。あなたがたはその所で長く命を保つことができず、全く滅ぼされるであろう。"},{"ref":"Deut.4.27","start":5004027,"end":5004027,"break":"none","ruby":[[0,1,"しゅ"],[8,2,"くにぐに"],[11,1,"ち"],[24,1,"しゅ"],[32,1,"お"],[38,2,"こくみん"],[51,1,"のこ"],[53,1,"もの"],[55,1,"かず"],[57,1,"すく"]],"text":"主はあなたがたを国々に散らされるであろう。そして主があなたがたを追いやられる国民のうちに、あなたがたの残る者の数は少ないであろう。"},{"ref":"Deut.4.28","start":5004028,"end":5004028,"break":"none","ruby":[[2,1,"ところ"],[10,1,"ひと"],[12,1,"て"],[14,1,"つく"],[18,1,"み"],[24,1,"き"],[30,1,"た"],[44,1,"き"],[46,1,"いし"],[48,2,"かみがみ"],[51,1,"つか"]],"text":"その所であなたがたは人が手で作った、見ることも、聞くことも、食べることも、かぐこともない木や石の神々に仕えるであろう。"},{"ref":"Deut.4.29","start":5004029,"end":5004029,"break":"none","ruby":[[6,1,"ところ"],[13,1,"かみ"],[15,1,"しゅ"],[17,1,"もと"],[22,1,"こころ"],[28,2,"せいしん"],[36,1,"しゅ"],[38,1,"もと"],[49,1,"しゅ"],[51,1,"あ"]],"text":"しかし、その所からあなたの神、主を求め、もし心をつくし、精神をつくして、主を求めるならば、あなたは主に会うであろう。"},{"ref":"Deut.4.30","start":5004030,"end":5004030,"break":"none","ruby":[[0,1,"のち"],[2,1,"ひ"],[27,1,"こと"],[34,1,"のぞ"],[45,1,"かみ"],[47,1,"しゅ"],[49,1,"た"],[51,1,"かえ"],[56,1,"こえ"],[58,1,"き"]],"text":"後の日になって、あなたがなやみにあい、これらのすべての事が、あなたに臨むとき、もしあなたの神、主に立ち帰ってその声に聞きしたがうならば、"},{"ref":"Deut.4.31","start":5004031,"end":5004031,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[14,1,"ふか"],[16,1,"かみ"],[27,1,"す"],[35,1,"ほろ"],[46,2,"せんぞ"],[49,1,"ちか"],[52,2,"けいやく"],[55,1,"わす"]],"text":"あなたの神、主はいつくしみの深い神であるから、あなたを捨てず、あなたを滅ぼさず、またあなたの先祖に誓った契約を忘れられないであろう。"},{"ref":"Deut.4.32","start":5004032,"end":5004032,"break":"paragraph","ruby":[[0,1,"こころ"],[7,1,"まえ"],[9,1,"す"],[11,1,"さ"],[14,1,"ひ"],[19,1,"と"],[22,1,"かみ"],[24,2,"ちじょう"],[27,1,"ひと"],[29,1,"つく"],[33,1,"ひ"],[41,1,"てん"],[45,1,"はし"],[51,1,"はし"],[64,1,"おお"],[68,1,"こと"],[87,1,"き"]],"text":"試みにあなたの前に過ぎ去った日について問え。神が地上に人を造られた日からこのかた、天のこの端から、かの端までに、かつてこのように大いなる事があったであろうか。このようなことを聞いたことがあったであろうか。"},{"ref":"Deut.4.33","start":5004033,"end":5004033,"break":"none","ruby":[[0,1,"ひ"],[2,1,"なか"],[5,1,"かた"],[9,1,"かみ"],[11,1,"こえ"],[17,1,"き"],[24,1,"き"],[29,1,"い"],[34,1,"たみ"]],"text":"火の中から語られる神の声をあなたが聞いたように、聞いてなお生きていた民がかつてあったであろうか。"},{"ref":"Deut.4.34","start":5004034,"end":5004034,"break":"none","ruby":[[13,1,"かみ"],[15,1,"しゅ"],[32,1,"め"],[34,1,"まえ"],[51,1,"こと"],[61,1,"こころ"],[70,3,"ふしぎ"],[75,1,"たたか"],[79,1,"つよ"],[81,1,"て"],[84,1,"の"],[88,1,"うで"],[91,1,"おお"],[95,1,"おそ"],[99,1,"こと"],[105,1,"のぞ"],[111,2,"こくみん"],[114,1,"た"],[116,2,"こくみん"],[123,1,"ひ"],[125,1,"だ"],[129,2,"じぶん"],[132,1,"たみ"],[137,1,"かみ"]],"text":"あるいはまた、あなたがたの神、主がエジプトにおいて、あなたがたの目の前に、あなたがたのためにもろもろの事をなされたように、試みと、しるしと、不思議と、戦いと、強い手と、伸ばした腕と、大いなる恐るべき事とをもって臨み、一つの国民を他の国民のうちから引き出して、自分の民とされた神が、かつてあったであろうか。"},{"ref":"Deut.4.35","start":5004035,"end":5004035,"break":"none","ruby":[[6,1,"こと"],[8,1,"しめ"],[14,1,"しゅ"],[17,1,"かみ"],[26,1,"かみ"],[33,1,"し"]],"text":"あなたにこの事を示したのは、主こそ神であって、ほかに神のないことを知らせるためであった。"},{"ref":"Deut.4.36","start":5004036,"end":5004036,"break":"none","ruby":[[4,2,"くんれん"],[12,1,"しゅ"],[14,1,"てん"],[19,1,"こえ"],[21,1,"き"],[25,2,"ちじょう"],[34,1,"おお"],[38,1,"ひ"],[40,1,"しめ"],[51,2,"ことば"],[54,1,"ひ"],[56,1,"なか"],[59,1,"で"],[63,1,"き"]],"text":"あなたを訓練するために、主は天からその声を聞かせ、地上では、またその大いなる火を示された。あなたはその言葉が火の中から出るのを聞いた。"},{"ref":"Deut.4.37","start":5004037,"end":5004037,"break":"none","ruby":[[0,1,"しゅ"],[6,2,"せんぞ"],[11,1,"あい"],[20,1,"のち"],[22,2,"しそん"],[25,1,"えら"],[28,1,"おお"],[32,1,"ちから"],[52,1,"みちび"],[54,1,"だ"]],"text":"主はあなたの先祖たちを愛されたので、その後の子孫を選び、大いなる力をもって、みずからあなたをエジプトから導き出し、"},{"ref":"Deut.4.38","start":5004038,"end":5004038,"break":"none","ruby":[[6,1,"おお"],[12,1,"つよ"],[19,2,"こくみん"],[27,1,"まえ"],[30,1,"お"],[32,1,"はら"],[41,1,"ち"],[43,1,"みちび"],[45,1,"い"],[52,1,"し"],[53,1,"ぎょう"],[61,1,"あた"],[72,2,"こんにち"],[74,1,"み"]],"text":"あなたよりも大きく、かつ強いもろもろの国民を、あなたの前から追い払い、あなたをその地に導き入れて、これを嗣業としてあなたに与えようとされること、今日見るとおりである。"},{"ref":"Deut.4.39","start":5004039,"end":5004039,"break":"none","ruby":[[13,1,"し"],[17,1,"こころ"],[30,1,"うえ"],[32,1,"てん"],[34,1,"した"],[36,1,"ち"],[42,1,"しゅ"],[45,1,"かみ"],[54,1,"かみ"]],"text":"それゆえ、あなたは、きょう知って、心にとめなければならない。上は天、下は地において、主こそ神にいまし、ほかに神のないことを。"},{"ref":"Deut.4.40","start":5004040,"end":5004040,"break":"none","ruby":[[13,1,"めい"],[16,1,"しゅ"],[18,1,"さだ"],[21,2,"めいれい"],[25,1,"まも"],[50,1,"のち"],[52,2,"しそん"],[60,1,"え"],[66,1,"かみ"],[68,1,"しゅ"],[70,2,"えいきゅう"],[77,1,"たま"],[80,1,"ち"],[86,1,"なが"],[88,1,"いのち"],[90,1,"たも"]],"text":"あなたは、きょう、わたしが命じる主の定めと命令とを守らなければならない。そうすれば、あなたとあなたの後の子孫はさいわいを得、あなたの神、主が永久にあなたに賜わる地において、長く命を保つことができるであろう」。"},{"ref":"Deut.4.41","start":5004041,"end":5004041,"break":"paragraph","ruby":[[13,1,"む"],[16,1,"がわ"],[18,1,"ひがし"],[20,1,"ほう"],[25,2,"まちまち"],[28,2,"してい"]],"text":"それからモーセはヨルダンの向こう側、東の方に三つの町々を指定した。"},{"ref":"Deut.4.42","start":5004042,"end":5004042,"break":"none","ruby":[[0,2,"かこ"],[3,1,"うら"],[19,2,"りんじん"],[22,1,"ころ"],[25,1,"もの"],[38,1,"まち"],[48,1,"いのち"],[50,1,"まっと"]],"text":"過去の恨みによるのではなく、あやまって隣人を殺した者をそこにのがれさせ、その町の一つにのがれて、命を全うさせるためであった。"},{"ref":"Deut.4.43","start":5004043,"end":5004043,"break":"none","ruby":[[14,2,"あらの"],[17,1,"なか"],[19,2,"こうち"],[67,1,"さだ"]],"text":"すなわちルベンびとのためには荒野の中の高地にあるベゼルを、ガドびとのためにはギレアデのラモテを、マナセびとのためにはバシャンのゴランを定めた。"},{"ref":"Deut.4.44","start":5004044,"end":5004044,"break":"paragraph","ruby":[[10,2,"ひとびと"],[13,1,"まえ"],[15,1,"しめ"],[18,2,"りっぽう"]],"text":"モーセがイスラエルの人々の前に示した律法はこれである。"},{"ref":"Deut.4.45","start":5004045,"end":5004045,"break":"none","ruby":[[6,2,"ひとびと"],[15,1,"で"],[24,1,"かれ"],[27,1,"の"],[35,1,"さだ"]],"text":"イスラエルの人々がエジプトから出たとき、モーセが彼らに述べたあかしと、定めと、おきてとはこれである。"},{"ref":"Deut.4.46","start":5004046,"end":5004046,"break":"none","ruby":[[9,1,"む"],[12,1,"がわ"],[20,1,"おう"],[25,1,"くに"],[33,1,"たい"],[36,1,"たに"],[44,1,"の"],[57,1,"す"],[74,2,"ひとびと"],[83,1,"で"],[87,1,"とき"],[92,1,"う"],[94,1,"やぶ"]],"text":"すなわちヨルダンの向こう側、アモリびとの王シホンの国のベテペオルに対する谷においてこれを述べた。シホンはヘシボンに住んでいたが、モーセとイスラエルの人々が、エジプトを出てきた時、これを撃ち敗って、"},{"ref":"Deut.4.47","start":5004047,"end":5004047,"break":"none","ruby":[[2,1,"くに"],[4,1,"え"],[13,1,"おう"],[17,1,"くに"],[19,1,"え"],[34,1,"おう"],[45,1,"む"],[48,1,"がわ"],[50,1,"ひがし"],[52,1,"ほう"]],"text":"その国を獲、またバシャンの王オグの国を獲た。このふたりはアモリびとの王であって、ヨルダンの向こう側、東の方におった。"},{"ref":"Deut.4.48","start":5004048,"end":5004048,"break":"none","ruby":[[0,1,"かれ"],[3,1,"え"],[5,1,"ち"],[11,1,"がわ"],[29,1,"ざん"],[39,1,"およ"]],"text":"彼らの獲た地はアルノン川のほとりにあるアロエルからシリオン山すなわちヘルモンに及び、"},{"ref":"Deut.4.49","start":5004049,"end":5004049,"break":"none","ruby":[[5,2,"ひがしがわ"],[12,2,"ぜんぶ"],[23,1,"うみ"],[25,1,"たっ"],[36,1,"およ"]],"text":"ヨルダンの東側のアラバの全部をかねて、アラバの海に達し、ピスガのふもとに及んだ。"}]