[{"ref":"Jer.13.1","start":24013001,"end":24013001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"],[14,1,"い"],[18,2,"あま"],[20,1,"ぬの"],[22,1,"おび"],[24,1,"か"],[27,1,"こし"],[29,1,"むす"],[32,1,"みず"]],"text":"主はわたしにこう言われた、「行って、亜麻布の帯を買い、腰に結べ。水につけてはならない」。"},{"ref":"Jer.13.2","start":24013002,"end":24013002,"break":"none","ruby":[[8,1,"しゅ"],[10,2,"ことば"],[13,1,"したが"],[16,1,"おび"],[18,1,"か"],[21,1,"こし"],[23,1,"むす"]],"text":"そこで、わたしは主の言葉に従い、帯を買って腰に結んだ。"},{"ref":"Jer.13.3","start":24013003,"end":24013003,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[6,1,"ふたた"],[12,1,"のぞ"],[15,1,"い"]],"text":"主の言葉は、再びわたしに臨んで言った、"},{"ref":"Jer.13.4","start":24013004,"end":24013004,"break":"none","ruby":[[5,1,"か"],[8,1,"こし"],[10,1,"むす"],[15,1,"おび"],[17,1,"て"],[19,1,"と"],[22,1,"た"],[30,1,"かわ"],[32,1,"い"],[37,1,"ところ"],[39,1,"いわ"],[41,1,"さ"],[43,1,"め"],[48,1,"かく"]],"text":"「あなたが買って腰に結んでいる帯を手に取り、立ってユフラテの川へ行き、その所の岩の裂け目にこれを隠せ」。"},{"ref":"Jer.13.5","start":24013005,"end":24013005,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"めい"],[15,1,"い"],[27,1,"かわ"],[33,1,"かく"]],"text":"わたしは主が命じられたように、行って、これをユフラテの川のほとりに隠した。"},{"ref":"Jer.13.6","start":24013006,"end":24013006,"break":"none","ruby":[[0,1,"おお"],[3,1,"ひ"],[5,1,"へ"],[10,1,"しゅ"],[16,1,"い"],[22,1,"た"],[31,1,"かわ"],[33,1,"い"],[40,1,"めい"],[47,1,"かく"],[51,1,"おび"],[55,1,"ところ"],[58,1,"と"]],"text":"多くの日を経てのち、主はわたしに言われた、「立って、ユフラテの川へ行き、あなたに命じて、そこに隠させた帯をその所から取ってきなさい」。"},{"ref":"Jer.13.7","start":24013007,"end":24013007,"break":"none","ruby":[[12,1,"かわ"],[14,1,"い"],[17,1,"ち"],[19,1,"ほ"],[23,1,"かく"],[26,1,"ところ"],[29,1,"おび"],[31,1,"と"],[33,1,"だ"],[40,1,"おび"],[49,1,"やく"],[51,1,"た"]],"text":"そこでわたしはユフラテの川へ行き、地を掘って、隠した所から帯を取り出したが、その帯はそこなわれて、役に立たなくなっていた。"},{"ref":"Jer.13.8","start":24013008,"end":24013008,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,2,"ことば"],[13,1,"のぞ"]],"text":"その時、主の言葉がわたしに臨んだ、"},{"ref":"Jer.13.9","start":24013009,"end":24013009,"break":"none","ruby":[[1,1,"しゅ"],[5,1,"おお"],[14,1,"おな"],[27,1,"たか"],[37,1,"おお"],[41,1,"たか"],[46,1,"やぶ"]],"text":"「主はこう仰せられる、これと同じように、わたしはユダの高ぶりとエルサレムの大いなる高ぶりを、破るのである。"},{"ref":"Jer.13.10","start":24013010,"end":24013010,"break":"none","ruby":[[2,1,"あ"],[5,1,"たみ"],[11,2,"ことば"],[14,1,"き"],[19,1,"こば"],[22,2,"じぶん"],[25,1,"こころ"],[27,2,"ごうじょう"],[32,1,"あゆ"],[37,1,"た"],[39,2,"かみがみ"],[42,1,"したが"],[48,1,"つか"],[54,1,"おが"],[60,1,"かれ"],[65,1,"おび"],[74,1,"やく"],[77,1,"た"]],"text":"この悪しき民はわたしの言葉を聞くことを拒み、自分の心を強情にして歩み、また他の神々に従ってこれに仕え、これを拝んでいる。彼らはこの帯のように、なんの役にも立たなくなる」。"},{"ref":"Jer.13.11","start":24013011,"end":24013011,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"おび"],[10,1,"ひと"],[12,1,"こし"],[14,1,"つ"],[30,1,"いえ"],[39,1,"いえ"],[46,1,"つ"],[57,1,"たみ"],[61,1,"な"],[65,1,"ほまれ"],[69,1,"さか"],[82,1,"かれ"],[85,1,"き"],[87,1,"したが"]],"text":"主は言われる、「帯が人の腰に着くように、イスラエルのすべての家とユダのすべての家とをわたしに着かせ、これをわたしの民とし、名とし、誉とし、栄えとしようとした。しかし彼らは聞き従おうともしなかった」。"},{"ref":"Jer.13.12","start":24013012,"end":24013012,"break":"paragraph","ruby":[[7,2,"ことば"],[10,1,"かれ"],[13,1,"かた"],[31,1,"かみ"],[35,1,"い"],[40,1,"さけ"],[48,1,"さけ"],[50,1,"み"],[56,1,"かれ"],[63,1,"い"],[71,1,"さけ"],[78,1,"さけ"],[80,1,"み"],[91,1,"し"]],"text":"「あなたはこの言葉を彼らに語らなければならない、『イスラエルの神はこう言われる、酒つぼには、みな酒が満ちる』と。彼らはあなたに言うであろう、『酒つぼに、みな酒が満ちることをわれわれが知らないことがあろうか』と。"},{"ref":"Jer.13.13","start":24013013,"end":24013013,"break":"none","ruby":[[2,1,"とき"],[8,1,"かれ"],[11,1,"い"],[23,1,"しゅ"],[27,1,"い"],[32,1,"み"],[41,1,"ち"],[43,1,"す"],[49,1,"もの"],[56,1,"くらい"],[58,1,"ざ"],[60,1,"おう"],[65,2,"さいし"],[68,3,"よげんしゃ"],[80,1,"す"],[86,1,"もの"],[88,1,"よ"],[91,1,"み"]],"text":"その時、あなたは彼らに言わなければならない、『主はこう言われる、見よ、わたしはこの地に住むすべての者と、ダビデの位に座す王たちと、祭司と預言者およびエルサレムに住むすべての者に酔いを満たし、"},{"ref":"Jer.13.14","start":24013014,"end":24013014,"break":"none","ruby":[[0,1,"かれ"],[3,1,"たがい"],[5,1,"う"],[7,1,"あ"],[10,1,"くだ"],[13,1,"ちち"],[15,1,"こ"],[27,1,"しゅ"],[29,1,"い"],[38,1,"かれ"],[47,1,"お"],[59,1,"おも"],[63,1,"ほろ"]],"text":"彼らを互に打ち当てて砕く。父と子をもそのようにすると、主は言われる。わたしは彼らをあわれまず、惜しまず、かわいそうとも思わずに滅ぼす』と」。"},{"ref":"Jer.13.15","start":24013015,"end":24013015,"break":"stanza","breaks":[[18,"line"]],"ruby":[[0,1,"みみ"],[2,1,"かたむ"],[5,1,"き"],[8,1,"たか"],[18,1,"しゅ"],[21,1,"かた"]],"text":"耳を傾けて聞け、高ぶってはならない、主がお語りになるからである。"},{"ref":"Jer.13.16","start":24013016,"end":24013016,"break":"line","breaks":[[16,"line"],[26,"line"],[43,"line"],[60,"line"],[82,"line"],[93,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"おこ"],[24,1,"あし"],[26,2,"うすくら"],[31,1,"やま"],[49,1,"かみ"],[51,1,"しゅ"],[53,2,"えいこう"],[56,1,"き"],[72,1,"ひかり"],[74,1,"のぞ"],[79,1,"あいだ"],[82,1,"しゅ"],[87,2,"あんこく"],[90,1,"か"],[96,1,"くら"]],"text":"主がまだやみを起されないうちに、またあなたがたの足が薄暗がりの山につまずかないうちに、あなたがたの神、主に栄光を帰せよ。さもないと、あなたがたが光を望んでいる間に、主はそれを暗黒に変え、それを暗やみとされるからである。"},{"ref":"Jer.13.17","start":24013017,"end":24013017,"break":"line","breaks":[[16,"line"],[29,"line"],[46,"line"],[64,"line"]],"ruby":[[8,1,"き"],[20,1,"たましい"],[26,1,"ところ"],[35,1,"たか"],[42,1,"かな"],[48,1,"しゅ"],[50,1,"む"],[68,1,"め"],[73,1,"な"],[77,1,"なみだ"],[79,1,"なが"]],"text":"もしあなたがたが聞かないならば、わたしの魂はひそかな所で、あなたがたの高ぶりのために悲しむ。また主の群れが、かすめられたために、わたしの目はいたく泣いて、涙を流すのである。"},{"ref":"Jer.13.18","start":24013018,"end":24013018,"break":"stanza","breaks":[[10,"line"],[28,"line"],[36,"line"]],"ruby":[[0,1,"おう"],[2,2,"たいこう"],[6,1,"つ"],[17,1,"ひく"],[19,1,"ざ"],[28,1,"うるわ"],[31,1,"かんむり"],[42,1,"あたま"],[45,1,"お"]],"text":"王と太后とに告げよ、「あなたがたは低い座にすわりなさい。麗しい冠はすでにあなたがたの頭から落ちてしまったからです」。"},{"ref":"Jer.13.19","start":24013019,"end":24013019,"break":"line","breaks":[[23,"line"],[35,"line"]],"ruby":[[4,2,"まちまち"],[7,1,"と"],[16,1,"ひら"],[18,1,"ひと"],[28,1,"とら"],[30,1,"うつ"],[40,1,"とら"],[42,1,"うつ"]],"text":"ネゲブの町々は閉ざされて、これを開く人がない。ユダはみな捕え移される、ことごとく捕え移される。"},{"ref":"Jer.13.20","start":24013020,"end":24013020,"break":"stanza","breaks":[[19,"line"],[30,"line"]],"ruby":[[1,1,"め"],[7,1,"きた"],[9,1,"ほう"],[14,1,"もの"],[16,1,"み"],[23,1,"たま"],[27,1,"む"],[34,1,"うるわ"],[37,1,"む"]],"text":"「目をあげて、北の方からくる者を見よ、あなたに賜わった群れ、あなたの麗しい群れはどこにいるのか。"},{"ref":"Jer.13.21","start":24013021,"end":24013021,"break":"line","breaks":[[18,"line"],[36,"line"],[51,"line"],[60,"line"]],"ruby":[[0,1,"かれ"],[7,1,"した"],[10,1,"な"],[13,1,"ひと"],[22,1,"うえ"],[24,1,"た"],[40,1,"なに"],[42,1,"い"],[55,1,"くる"],[60,1,"こ"],[62,1,"う"],[64,1,"おんな"],[66,1,"くる"]],"text":"彼らがあなたの親しみ慣れた人たちを、あなたの上に立ててかしらとするとき、あなたは何を言おうとするのか。あなたの苦しみは、子を産む女の苦しみのようでないであろうか。"},{"ref":"Jer.13.22","start":24013022,"end":24013022,"break":"line","breaks":[[10,"line"],[23,"line"],[40,"line"],[52,"line"],[67,"line"]],"ruby":[[4,1,"こころ"],[27,1,"た"],[44,1,"つみ"],[46,1,"おも"],[56,2,"きもの"],[73,1,"う"]],"text":"あなたが心のうちに、『どうしてこのようなことがわたしに起ったのか』というならば、あなたの罪が重いゆえに、あなたの着物のすそはあげられ、はずかしめを受けるのだ。"},{"ref":"Jer.13.23","start":24013023,"end":24013023,"break":"line","breaks":[[8,"line"],[25,"line"],[46,"line"],[70,"line"]],"ruby":[[10,2,"ひふ"],[13,1,"か"],[31,2,"はんてん"],[34,1,"か"],[58,1,"あく"],[60,1,"な"],[70,1,"ぜん"],[72,1,"おこな"]],"text":"エチオピヤびとはその皮膚を変えることができようか。ひょうはその斑点を変えることができようか。もしそれができるならば、悪に慣れたあなたがたも、善を行うことができる。"},{"ref":"Jer.13.24","start":24013024,"end":24013024,"break":"line","breaks":[[14,"line"]],"ruby":[[10,1,"ち"],[14,1,"の"],[16,1,"かぜ"],[18,1,"ふ"],[20,1,"ち"]],"text":"わたしはあなたがたを散らし、野の風に吹き散らされるもみがらのようにする。"},{"ref":"Jer.13.25","start":24013025,"end":24013025,"break":"line","breaks":[[22,"line"],[41,"line"],[53,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[14,1,"さづ"],[19,1,"さだ"],[26,1,"はか"],[33,1,"あた"],[36,1,"ぶん"],[49,1,"わす"],[53,1,"いつわ"],[56,1,"たの"]],"text":"主は言われる、これがあなたに授けられた定め、わたしが量ってあなたに与える分である。あなたがわたしを忘れて、偽りを頼みとしたからだ。"},{"ref":"Jer.13.26","start":24013026,"end":24013026,"break":"line","breaks":[[23,"line"]],"ruby":[[10,2,"きもの"],[16,1,"かお"],[27,1,"はじ"]],"text":"わたしはまたあなたの着物のすそを顔まであげて、あなたの恥をあらわす。"},{"ref":"Jer.13.27","start":24013027,"end":24013027,"break":"line","breaks":[[15,"line"],[28,"line"],[51,"line"],[68,"line"]],"ruby":[[8,1,"にく"],[12,1,"おこな"],[19,2,"かんいん"],[28,1,"の"],[30,1,"おか"],[32,1,"うえ"],[34,1,"おこな"],[45,1,"おこな"],[48,1,"み"],[72,1,"きよ"]],"text":"わたしはあなたの憎むべき行い、あなたの姦淫と、いななき、野の丘の上で行ったあなたのみだらな行いを見た。エルサレムよ、あなたはわざわいだ、あなたの清められるのはいつのことであろうか」。"}]