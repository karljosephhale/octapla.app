[{"ref":"Lev.16.1","start":3016001,"end":3016001,"break":"paragraph","ruby":[[8,1,"こ"],[11,1,"しゅ"],[13,1,"まえ"],[15,1,"ちか"],[19,1,"し"],[22,1,"のち"]],"text":"アロンのふたりの子が、主の前に近づいて死んだ後、"},{"ref":"Lev.16.2","start":3016002,"end":3016002,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,2,"きょうだい"],[22,1,"つ"],[26,1,"かれ"],[28,1,"とき"],[35,2,"たれまく"],[38,1,"うち"],[41,2,"せいじょ"],[44,1,"い"],[47,1,"はこ"],[49,1,"うえ"],[52,3,"しょくざいしょ"],[56,1,"まえ"],[58,1,"い"],[70,1,"かれ"],[72,1,"し"],[74,1,"まぬか"],[92,1,"くも"],[94,1,"なか"],[99,3,"しょくざいしょ"],[103,1,"うえ"],[105,1,"あらわ"]],"text":"主はモーセに言われた、「あなたの兄弟アロンに告げて、彼が時をわかたず、垂幕の内なる聖所に入り、箱の上なる贖罪所の前に行かぬようにさせなさい。彼が死を免れるためである。なぜなら、わたしは雲の中にあって贖罪所の上に現れるからである。"},{"ref":"Lev.16.3","start":3016003,"end":3016003,"break":"none","ruby":[[4,2,"せいじょ"],[14,1,"つぎ"],[33,1,"おす"],[35,1,"こ"],[36,1,"うし"],[38,2,"ざいさい"],[44,1,"と"],[47,2,"おひつじ"],[50,2,"はんさい"],[56,1,"と"]],"text":"アロンが聖所に、はいるには、次のようにしなければならない。すなわち雄の子牛を罪祭のために取り、雄羊を燔祭のために取り、"},{"ref":"Lev.16.4","start":3016004,"end":3016004,"break":"none","ruby":[[0,1,"せい"],[3,2,"あま"],[5,1,"ぬの"],[7,1,"ふく"],[9,1,"き"],[11,2,"あま"],[13,1,"ぬの"],[22,1,"み"],[28,2,"あま"],[30,1,"ぬの"],[32,1,"おび"],[37,2,"あま"],[39,1,"ぬの"],[41,2,"ぼうし"],[60,1,"せい"],[63,2,"いふく"],[69,1,"かれ"],[71,1,"みず"],[73,1,"み"],[83,1,"き"]],"text":"聖なる亜麻布の服を着、亜麻布のももひきをその身にまとい、亜麻布の帯をしめ、亜麻布の帽子をかぶらなければならない。これらは聖なる衣服である。彼は水に身をすすいで、これを着なければならない。"},{"ref":"Lev.16.5","start":3016005,"end":3016005,"break":"none","ruby":[[8,2,"ひとびと"],[11,2,"かいしゅう"],[15,1,"お"],[19,1,"とう"],[21,2,"ざいさい"],[27,1,"と"],[30,2,"おひつじ"],[33,1,"とう"],[35,2,"はんさい"],[41,1,"と"]],"text":"またイスラエルの人々の会衆から雄やぎ二頭を罪祭のために取り、雄羊一頭を燔祭のために取らなければならない。"},{"ref":"Lev.16.6","start":3016006,"end":3016006,"break":"paragraph","ruby":[[7,2,"じぶん"],[13,2,"ざいさい"],[16,2,"おうし"],[24,2,"じぶん"],[27,2,"じぶん"],[30,2,"かぞく"]],"text":"そしてアロンは自分のための罪祭の雄牛をささげて、自分と自分の家族のために、あがないをしなければならない。"},{"ref":"Lev.16.7","start":3016007,"end":3016007,"break":"none","ruby":[[7,1,"とう"],[12,1,"と"],[18,2,"かいけん"],[21,2,"まくや"],[24,2,"いりぐち"],[27,1,"しゅ"],[29,1,"まえ"],[31,1,"た"]],"text":"アロンはまた二頭のやぎを取り、それを会見の幕屋の入口で主の前に立たせ、"},{"ref":"Lev.16.8","start":3016008,"end":3016008,"break":"none","ruby":[[3,1,"とう"],[15,1,"ひ"],[36,1,"しゅ"]],"text":"その二頭のやぎのために、くじを引かなければならない。すなわち一つのくじは主のため、一つのくじはアザゼルのためである。"},{"ref":"Lev.16.9","start":3016009,"end":3016009,"break":"none","ruby":[[7,1,"しゅ"],[15,1,"あた"],[29,2,"ざいさい"]],"text":"そしてアロンは主のためのくじに当ったやぎをささげて、これを罪祭としなければならない。"},{"ref":"Lev.16.10","start":3016010,"end":3016010,"break":"none","ruby":[[15,1,"あた"],[22,1,"しゅ"],[24,1,"まえ"],[26,1,"い"],[60,2,"あらの"],[63,1,"おく"]],"text":"しかし、アザゼルのためのくじに当ったやぎは、主の前に生かしておき、これをもって、あがないをなし、これをアザゼルのために、荒野に送らなければならない。"},{"ref":"Lev.16.11","start":3016011,"end":3016011,"break":"paragraph","ruby":[[9,2,"じぶん"],[15,2,"ざいさい"],[18,2,"おうし"],[26,2,"じぶん"],[29,2,"じぶん"],[32,2,"かぞく"],[54,1,"かれ"],[56,2,"じぶん"],[62,2,"ざいさい"],[65,2,"おうし"]],"text":"すなわち、アロンは自分のための罪祭の雄牛をささげて、自分と自分の家族のために、あがないをしなければならない。彼は自分のための罪祭の雄牛をほふり、"},{"ref":"Lev.16.12","start":3016012,"end":3016012,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"まえ"],[4,2,"さいだん"],[8,2,"すみび"],[11,1,"み"],[15,2,"こうろ"],[19,1,"こま"],[25,1,"こう"],[29,2,"くんこう"],[32,1,"りょう"],[33,1,"て"],[38,1,"と"],[45,2,"たれまく"],[48,1,"うち"],[50,1,"たずさ"],[52,1,"い"]],"text":"主の前の祭壇から炭火を満たした香炉と、細かくひいた香ばしい薫香を両手いっぱい取って、これを垂幕の内に携え入り、"},{"ref":"Lev.16.13","start":3016013,"end":3016013,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"まえ"],[4,2,"くんこう"],[9,1,"ひ"],[14,2,"くんこう"],[17,1,"くも"],[24,1,"はこ"],[26,1,"うえ"],[29,3,"しょくざいしょ"],[51,1,"かれ"],[53,1,"し"],[55,1,"まぬか"]],"text":"主の前で薫香をその火にくべ、薫香の雲に、あかしの箱の上なる贖罪所をおおわせなければならない。こうして、彼は死を免れるであろう。"},{"ref":"Lev.16.14","start":3016014,"end":3016014,"break":"none","ruby":[[0,1,"かれ"],[6,2,"おうし"],[9,1,"ち"],[11,1,"と"],[14,1,"ゆび"],[22,3,"しょくざいしょ"],[26,1,"ひがし"],[28,1,"めん"],[30,1,"そそ"],[35,1,"ゆび"],[42,1,"ち"],[44,3,"しょくざいしょ"],[48,1,"まえ"],[54,1,"そそ"]],"text":"彼はまたその雄牛の血を取り、指をもってこれを贖罪所の東の面に注ぎ、また指をもってその血を贖罪所の前に、七たび注がなければならない。"},{"ref":"Lev.16.15","start":3016015,"end":3016015,"break":"paragraph","ruby":[[2,1,"たみ"],[7,2,"ざいさい"],[19,1,"ち"],[21,2,"たれまく"],[24,1,"うち"],[26,1,"たずさ"],[28,1,"い"],[33,1,"ち"],[37,2,"おうし"],[40,1,"ち"],[46,3,"しょくざいしょ"],[50,1,"うえ"],[53,3,"しょくざいしょ"],[57,1,"まえ"],[59,1,"そそ"]],"text":"また民のための罪祭のやぎをほふり、その血を垂幕の内に携え入り、その血をかの雄牛の血のように、贖罪所の上と、贖罪所の前に注ぎ、"},{"ref":"Lev.16.16","start":3016016,"end":3016016,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"けが"],[23,1,"かれ"],[31,1,"つみ"],[37,2,"せいじょ"],[60,1,"かれ"],[63,1,"けが"],[70,1,"かれ"],[73,1,"とも"],[77,2,"かいけん"],[80,2,"まくや"]],"text":"イスラエルの人々の汚れと、そのとが、すなわち、彼らのもろもろの罪のゆえに、聖所のためにあがないをしなければならない。また彼らの汚れのうちに、彼らと共にある会見の幕屋のためにも、そのようにしなければならない。"},{"ref":"Lev.16.17","start":3016017,"end":3016017,"break":"none","ruby":[[0,1,"かれ"],[2,2,"せいじょ"],[20,1,"とき"],[23,2,"じぶん"],[26,2,"じぶん"],[29,2,"かぞく"],[39,1,"ぜん"],[40,2,"かいしゅう"],[55,1,"お"],[58,1,"で"],[66,2,"かいけん"],[69,2,"まくや"],[72,1,"うち"]],"text":"彼が聖所であがないをするために、はいった時は、自分と自分の家族と、イスラエルの全会衆とのために、あがないをなし終えて出るまで、だれも会見の幕屋の内にいてはならない。"},{"ref":"Lev.16.18","start":3016018,"end":3016018,"break":"none","ruby":[[3,1,"かれ"],[5,1,"しゅ"],[7,1,"まえ"],[9,2,"さいだん"],[15,1,"で"],[49,2,"おうし"],[52,1,"ち"],[58,1,"ち"],[61,1,"と"],[64,2,"さいだん"],[71,1,"つの"]],"text":"そして彼は主の前の祭壇のもとに出てきて、これがために、あがないをしなければならない、すなわち、かの雄牛の血と、やぎの血とを取って祭壇の四すみの角につけ、"},{"ref":"Lev.16.19","start":3016019,"end":3016019,"break":"none","ruby":[[2,1,"ゆび"],[12,1,"ち"],[16,1,"うえ"],[18,1,"そそ"],[27,2,"ひとびと"],[30,1,"けが"],[33,1,"のぞ"],[39,1,"きよ"],[43,2,"せいべつ"]],"text":"また指をもって七たびその血をその上に注ぎ、イスラエルの人々の汚れを除いてこれを清くし、聖別しなければならない。"},{"ref":"Lev.16.20","start":3016020,"end":3016020,"break":"paragraph","ruby":[[4,2,"せいじょ"],[7,2,"かいけん"],[10,2,"まくや"],[13,2,"さいだん"],[28,1,"お"],[36,1,"い"],[44,1,"ひ"]],"text":"こうして聖所と会見の幕屋と祭壇とのために、あがないをなし終えたとき、かの生きているやぎを引いてこなければならない。"},{"ref":"Lev.16.21","start":3016021,"end":3016021,"break":"none","ruby":[[10,1,"い"],[18,1,"あたま"],[20,2,"りょうて"],[32,2,"ひとびと"],[40,1,"あく"],[56,1,"かれ"],[64,1,"つみ"],[68,1,"うえ"],[70,2,"こくはく"],[81,1,"あたま"],[86,1,"さだ"],[92,1,"ひと"],[94,1,"て"],[103,2,"あらの"],[106,1,"おく"]],"text":"そしてアロンは、その生きているやぎの頭に両手をおき、イスラエルの人々のもろもろの悪と、もろもろのとが、すなわち、彼らのもろもろの罪をその上に告白して、これをやぎの頭にのせ、定めておいた人の手によって、これを荒野に送らなければならない。"},{"ref":"Lev.16.22","start":3016022,"end":3016022,"break":"none","ruby":[[7,1,"かれ"],[15,1,"あく"],[22,2,"ひとざと"],[24,1,"はな"],[27,1,"ち"],[29,1,"い"],[46,2,"あらの"],[49,1,"おく"]],"text":"こうしてやぎは彼らのもろもろの悪をになって、人里離れた地に行くであろう。すなわち、そのやぎを荒野に送らなければならない。"},{"ref":"Lev.16.23","start":3016023,"end":3016023,"break":"paragraph","ruby":[[8,2,"かいけん"],[11,2,"まくや"],[14,1,"い"],[17,2,"せいじょ"],[20,1,"い"],[22,1,"とき"],[24,1,"き"],[26,2,"あま"],[28,1,"ぬの"],[30,2,"いふく"],[33,1,"ぬ"],[40,1,"お"]],"text":"そして、アロンは会見の幕屋に入り、聖所に入る時に着た亜麻布の衣服を脱いで、そこに置き、"},{"ref":"Lev.16.24","start":3016024,"end":3016024,"break":"none","ruby":[[0,1,"せい"],[3,1,"ところ"],[5,1,"みず"],[7,1,"み"],[13,1,"た"],[15,2,"いふく"],[18,1,"き"],[20,1,"で"],[25,2,"じぶん"],[28,2,"はんさい"],[31,1,"たみ"],[33,2,"はんさい"],[42,2,"じぶん"],[50,1,"たみ"]],"text":"聖なる所で水に身をすすぎ、他の衣服を着、出てきて、自分の燔祭と民の燔祭とをささげて、自分のため、また民のために、あがないをしなければならない。"},{"ref":"Lev.16.25","start":3016025,"end":3016025,"break":"none","ruby":[[2,2,"ざいさい"],[5,2,"しぼう"],[8,2,"さいだん"],[11,1,"うえ"],[13,1,"や"]],"text":"また罪祭の脂肪を祭壇の上で焼かなければならない。"},{"ref":"Lev.16.26","start":3016026,"end":3016026,"break":"none","ruby":[[10,1,"おく"],[13,1,"もの"],[15,2,"いふく"],[18,1,"あら"],[21,1,"みず"],[23,1,"み"],[39,1,"のち"],[41,2,"しゅくえい"],[44,1,"い"]],"text":"かのやぎをアザゼルに送った者は衣服を洗い、水に身をすすがなければならない。その後、宿営に入ることができる。"},{"ref":"Lev.16.27","start":3016027,"end":3016027,"break":"none","ruby":[[0,2,"せいじょ"],[17,1,"ち"],[19,1,"たずさ"],[21,1,"い"],[26,2,"ざいさい"],[29,2,"おうし"],[33,2,"ざいさい"],[41,2,"しゅくえい"],[44,1,"そと"],[46,1,"たずさ"],[48,1,"だ"],[53,1,"かわ"],[55,1,"にく"],[57,2,"おぶつ"],[62,1,"ひ"],[64,1,"や"],[66,1,"す"]],"text":"聖所で、あがないをするために、その血を携え入れられた罪祭の雄牛と、罪祭のやぎとは、宿営の外に携え出し、その皮と肉と汚物とは、火で焼き捨てなければならない。"},{"ref":"Lev.16.28","start":3016028,"end":3016028,"break":"none","ruby":[[3,1,"や"],[5,1,"もの"],[7,2,"いふく"],[10,1,"あら"],[13,1,"みず"],[15,1,"み"],[31,1,"のち"],[33,2,"しゅくえい"],[36,1,"い"]],"text":"これを焼く者は衣服を洗い、水に身をすすがなければならない。その後、宿営に入ることができる。"},{"ref":"Lev.16.29","start":3016029,"end":3016029,"break":"paragraph","ruby":[[9,2,"えいきゅう"],[12,1,"まも"],[16,1,"さだ"],[28,1,"がつ"],[36,1,"つき"],[39,1,"か"],[48,1,"み"],[50,1,"なや"],[54,1,"なに"],[56,2,"しごと"],[69,1,"くに"],[71,1,"うま"],[74,1,"もの"],[86,1,"やど"],[91,3,"きりゅうしゃ"]],"text":"これはあなたがたが永久に守るべき定めである。すなわち、七月になって、その月の十日に、あなたがたは身を悩まし、何の仕事もしてはならない。この国に生れた者も、あなたがたのうちに宿っている寄留者も、そうしなければならない。"},{"ref":"Lev.16.30","start":3016030,"end":3016030,"break":"none","ruby":[[2,1,"ひ"],[19,1,"きよ"],[41,1,"しゅ"],[43,1,"まえ"],[51,1,"つみ"],[53,1,"きよ"]],"text":"この日にあなたがたのため、あなたがたを清めるために、あがないがなされ、あなたがたは主の前に、もろもろの罪が清められるからである。"},{"ref":"Lev.16.31","start":3016031,"end":3016031,"break":"none","ruby":[[9,1,"まった"],[11,1,"やす"],[14,3,"あんそくにち"],[28,1,"み"],[30,1,"なや"],[45,2,"えいきゅう"],[48,1,"まも"],[52,1,"さだ"]],"text":"これはあなたがたの全き休みの安息日であって、あなたがたは身を悩まさなければならない。これは永久に守るべき定めである。"},{"ref":"Lev.16.32","start":3016032,"end":3016032,"break":"none","ruby":[[0,1,"あぶら"],[2,1,"そそ"],[6,1,"ちち"],[8,1,"かわ"],[11,2,"さいし"],[14,1,"しょく"],[16,1,"にん"],[21,2,"さいし"],[25,2,"あま"],[27,1,"ぬの"],[29,2,"いふく"],[37,1,"せい"],[40,2,"いふく"],[43,1,"き"]],"text":"油を注がれ、父に代って祭司の職に任じられる祭司は、亜麻布の衣服、すなわち、聖なる衣服を着て、あがないをしなければならない。"},{"ref":"Lev.16.33","start":3016033,"end":3016033,"break":"none","ruby":[[0,1,"かれ"],[2,3,"しせいじょ"],[20,2,"かいけん"],[23,2,"まくや"],[30,2,"さいだん"],[47,2,"さいし"],[56,1,"たみ"],[58,1,"ぜん"],[59,2,"かいしゅう"]],"text":"彼は至聖所のために、あがないをなし、また会見の幕屋のためと、祭壇のために、あがないをなし、また祭司たちのためと、民の全会衆のために、あがないをしなければならない。"},{"ref":"Lev.16.34","start":3016034,"end":3016034,"break":"none","breaks":[[61,"paragraph"]],"ruby":[[9,2,"えいきゅう"],[12,1,"まも"],[16,1,"さだ"],[29,2,"ひとびと"],[37,1,"つみ"],[43,1,"ねん"],[46,1,"ど"],[61,1,"かれ"],[63,1,"しゅ"],[69,1,"めい"]],"text":"これはあなたがたの永久に守るべき定めであって、イスラエルの人々のもろもろの罪のために、年に一度あがないをするものである」。彼は主がモーセに命じられたとおりにおこなった。"}]