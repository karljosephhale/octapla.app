[{"ref":"Ps.2.1","start":19002001,"end":19002001,"break":"paragraph","breaks":[[19,"line"]],"ruby":[[10,1,"くに"],[14,1,"さわ"],[24,1,"たみ"],[30,1,"こと"]],"text":"なにゆえ、もろもろの国びとは騒ぎたち、もろもろの民はむなしい事をたくらむのか。"},{"ref":"Ps.2.2","start":19002002,"end":19002002,"break":"line","breaks":[[14,"line"],[31,"line"]],"ruby":[[0,1,"ち"],[7,1,"おう"],[9,1,"た"],[11,1,"かま"],[31,1,"しゅ"],[35,1,"あぶら"],[41,1,"もの"],[44,1,"さか"],[48,1,"い"]],"text":"地のもろもろの王は立ち構え、もろもろのつかさはともに、はかり、主とその油そそがれた者とに逆らって言う、"},{"ref":"Ps.2.3","start":19002003,"end":19002003,"break":"line","breaks":[[15,"line"]],"ruby":[[5,1,"かれ"],[15,1,"かれ"],[22,1,"と"],[24,1,"す"]],"text":"「われらは彼らのかせをこわし、彼らのきずなを解き捨てるであろう」と。"},{"ref":"Ps.2.4","start":19002004,"end":19002004,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"てん"],[2,1,"ざ"],[5,1,"もの"],[7,1,"わら"],[10,1,"しゅ"],[12,1,"かれ"]],"text":"天に座する者は笑い、主は彼らをあざけられるであろう。"},{"ref":"Ps.2.5","start":19002005,"end":19002005,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"いきどお"],[11,1,"かれ"],[14,1,"かた"],[17,1,"はげ"],[20,1,"いか"],[26,1,"かれ"],[29,1,"おそ"],[31,1,"まど"],[35,1,"い"]],"text":"そして主は憤りをもって彼らに語り、激しい怒りをもって彼らを恐れ惑わせて言われる、"},{"ref":"Ps.2.6","start":19002006,"end":19002006,"break":"line","ruby":[[7,1,"おう"],[9,1,"せい"],[12,1,"やま"],[17,1,"た"]],"text":"「わたしはわが王を聖なる山シオンに立てた」と。"},{"ref":"Ps.2.7","start":19002007,"end":19002007,"break":"line","breaks":[[13,"line"],[36,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"みことのり"],[13,1,"しゅ"],[19,1,"い"],[33,1,"こ"],[48,1,"う"]],"text":"わたしは主の詔をのべよう。主はわたしに言われた、「おまえはわたしの子だ。きょう、わたしはおまえを生んだ。"},{"ref":"Ps.2.8","start":19002008,"end":19002008,"break":"line","breaks":[[19,"line"],[31,"line"]],"ruby":[[4,1,"もと"],[17,1,"くに"],[19,1,"し"],[20,1,"ぎょう"],[28,1,"あた"],[31,1,"ち"],[42,2,"しょゆう"],[47,1,"あた"]],"text":"わたしに求めよ、わたしはもろもろの国を嗣業としておまえに与え、地のはてまでもおまえの所有として与える。"},{"ref":"Ps.2.9","start":19002009,"end":19002009,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[4,1,"てつ"],[12,1,"かれ"],[15,1,"う"],[17,1,"やぶ"],[20,2,"とうこう"],[23,1,"つく"],[25,2,"うつわもの"],[31,1,"かれ"],[34,1,"う"],[36,1,"くだ"]],"text":"おまえは鉄のつえをもって彼らを打ち破り、陶工の作る器物のように彼らを打ち砕くであろう」と。"},{"ref":"Ps.2.10","start":19002010,"end":19002010,"break":"line","breaks":[[18,"line"]],"ruby":[[10,1,"おう"],[13,1,"かしこ"],[18,1,"ち"],[26,1,"いまし"]],"text":"それゆえ、もろもろの王よ、賢くあれ、地のつかさらよ、戒めをうけよ。"},{"ref":"Ps.2.11","start":19002011,"end":19002011,"break":"line","ruby":[[0,1,"おそ"],[6,1,"しゅ"],[8,1,"つか"]],"text":"恐れをもって主に仕え、おののきをもって"},{"ref":"Ps.2.12","start":19002012,"end":19002012,"break":"line","breaks":[[10,"line"],[21,"line"],[39,"line"],[58,"line"]],"ruby":[[2,1,"あし"],[4,1,"くち"],[15,1,"しゅ"],[17,1,"いか"],[27,1,"みち"],[29,1,"ほろ"],[41,1,"いきどお"],[49,1,"も"],[61,1,"しゅ"],[63,1,"よ"],[65,1,"たの"],[67,1,"もの"]],"text":"その足に口づけせよ。さもないと主は怒って、あなたがたを道で滅ぼされるであろう、その憤りがすみやかに燃えるからである。すべて主に寄り頼む者はさいわいである。"}]