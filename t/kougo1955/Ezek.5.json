[{"ref":"Ezek.5.1","start":26005001,"end":26005001,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[5,1,"するど"],[11,1,"と"],[17,2,"りはつ"],[19,1,"し"],[33,1,"あたま"],[47,1,"はか"],[53,1,"け"],[55,1,"わ"]],"text":"人の子よ、鋭いつるぎを取り、それを理髪師のかみそりとして、あなたの頭と、ひげとをそり、はかりで量って、その毛を分けなさい。"},{"ref":"Ezek.5.2","start":26005002,"end":26005002,"break":"none","ruby":[[3,1,"ぶん"],[7,2,"ほうい"],[10,2,"きかん"],[13,1,"おわ"],[15,1,"とき"],[17,1,"まち"],[19,1,"なか"],[21,1,"ひ"],[23,1,"や"],[29,1,"ぶん"],[33,1,"と"],[40,1,"まち"],[49,1,"う"],[56,1,"ぶん"],[60,1,"かぜ"],[62,1,"ち"],[77,1,"ぬ"],[81,1,"かれ"],[87,1,"お"]],"text":"その三分の一は包囲の期間の終る時、町の中で火で焼き、また三分の一を取り、つるぎで町のまわりでこれを打ち、さらに三分の一を風に散らしなさい。わたしはつるぎを抜いて、彼らのあとを追う。"},{"ref":"Ezek.5.3","start":26005003,"end":26005003,"break":"none","ruby":[[6,1,"け"],[8,1,"すこ"],[10,1,"と"],[14,1,"ころも"],[19,1,"つつ"]],"text":"あなたはその毛を少し取って、衣のすそに包み、"},{"ref":"Ezek.5.4","start":26005004,"end":26005004,"break":"none","ruby":[[8,1,"すこ"],[11,1,"と"],[14,1,"ひ"],[16,1,"なか"],[18,1,"な"],[20,1,"い"],[23,1,"ひ"],[28,1,"や"],[34,1,"ひ"],[38,1,"なか"],[41,1,"で"],[50,2,"ぜんか"],[53,1,"およ"]],"text":"またそのうちから少しを取って火の中に投げ入れ、火でこれを焼きなさい。火はその中から出て、イスラエルの全家に及ぶ。"},{"ref":"Ezek.5.5","start":26005005,"end":26005005,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[24,2,"ばんこく"],[27,1,"なか"],[29,1,"お"],[32,2,"くにぐに"],[41,1,"お"]],"text":"主なる神はこう言われる、わたしはこのエルサレムを万国の中に置き、国々をそのまわりに置いた。"},{"ref":"Ezek.5.6","start":26005006,"end":26005006,"break":"none","ruby":[[6,1,"た"],[8,2,"くにぐに"],[13,1,"あ"],[35,2,"くにぐに"],[44,1,"さだ"],[56,1,"かれ"],[67,1,"す"],[74,1,"さだ"],[77,1,"あゆ"]],"text":"エルサレムは他の国々よりも悪しく、わたしのおきてにそむき、そのまわりの国々よりもわたしの定めにそむいた。すなわち彼らはわたしのおきてを捨て、わたしの定めに歩まなかった。"},{"ref":"Ezek.5.7","start":26005007,"end":26005007,"break":"none","ruby":[[4,1,"しゅ"],[8,1,"い"],[27,3,"いほうじん"],[33,2,"きょうぼう"],[44,1,"さだ"],[47,1,"あゆ"],[59,1,"おこな"],[73,1,"まわ"],[78,3,"いほうじん"],[86,1,"まも"]],"text":"それゆえ主はこう言われる、あなたがたはそのまわりにいる異邦人よりも狂暴であって、わたしの定めに歩まず、わたしのおきてを行わず、むしろ、あなたがたの回りにいる異邦人のおきてを守っていた。"},{"ref":"Ezek.5.8","start":26005008,"end":26005008,"break":"none","ruby":[[4,1,"しゅ"],[7,1,"かみ"],[11,1,"い"],[16,1,"み"],[27,1,"せ"],[30,3,"いほうじん"],[34,1,"め"],[36,1,"まえ"],[43,1,"なか"],[49,1,"おこな"]],"text":"それゆえ主なる神はこう言われる、見よ、わたしはあなたを攻め、異邦人の目の前で、あなたの中にさばきを行う。"},{"ref":"Ezek.5.9","start":26005009,"end":26005009,"break":"none","ruby":[[9,1,"にく"],[13,1,"こと"],[27,1,"こと"],[34,1,"こと"],[40,1,"のち"],[51,1,"こと"],[57,1,"たい"]],"text":"あなたのもろもろの憎むべき事のために、わたしがまだした事のないような事、またこの後ふたたびしないような事をあなたに対してする。"},{"ref":"Ezek.5.10","start":26005010,"end":26005010,"break":"none","ruby":[[12,1,"ちち"],[16,1,"こ"],[18,1,"く"],[21,1,"こ"],[25,1,"ちち"],[27,1,"く"],[38,1,"たい"],[45,1,"おこな"],[55,1,"のこ"],[58,1,"もの"],[65,2,"しほう"],[68,1,"かぜ"],[70,1,"ち"]],"text":"それゆえ、あなたのうちで父はその子を食い、子はその父を食う。わたしはあなたに対してさばきを行い、あなたのうちの残りの者をことごとく四方の風に散らす。"},{"ref":"Ezek.5.11","start":26005011,"end":26005011,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[10,1,"い"],[19,1,"い"],[31,1,"い"],[35,1,"もの"],[40,1,"にく"],[44,1,"こと"],[55,2,"せいじょ"],[58,1,"けが"],[68,1,"かなら"],[74,1,"かず"],[76,1,"へ"],[84,1,"め"],[90,1,"お"],[93,1,"み"]],"text":"それゆえ、主なる神は言われる、わたしは生きている。あなたはその忌むべき物と、その憎むべき事とをもって、わたしの聖所を汚したので、わたしは必ずあなたの数を減らす。わたしの目はあなたを惜しみ見ず、またわたしはあなたをあわれまない。"},{"ref":"Ezek.5.12","start":26005012,"end":26005012,"break":"none","ruby":[[5,1,"ぶん"],[13,1,"なか"],[15,2,"えきびょう"],[18,1,"し"],[25,1,"ほろ"],[29,1,"ぶん"],[45,1,"たお"],[49,1,"ぶん"],[53,2,"しほう"],[56,1,"かぜ"],[58,1,"ち"],[72,1,"ぬ"],[80,1,"お"]],"text":"あなたの三分の一はあなたの中で疫病で死に、ききんで滅び、三分の一はあなたのまわりでつるぎに倒れ、三分の一は四方の風に散らされる。わたしはつるぎを抜いてそのあとを追う。"},{"ref":"Ezek.5.13","start":26005013,"end":26005013,"break":"paragraph","ruby":[[8,1,"いか"],[11,1,"も"],[14,1,"つく"],[17,1,"いきどお"],[20,1,"かれ"],[23,1,"うえ"],[25,1,"も"],[30,2,"まんぞく"],[44,1,"いきどお"],[47,1,"かれ"],[50,1,"うえ"],[52,1,"も"],[55,1,"つく"],[58,1,"とき"],[60,1,"かれ"],[63,1,"しゅ"],[71,2,"ねっしん"],[74,1,"かた"],[80,1,"し"]],"text":"こうしてわたしは怒りを漏らし尽し、憤りを彼らの上に漏らして、満足する。こうして、わたしの憤りを彼らの上に漏らし尽した時、彼らは主であるわたしが熱心に語ったことを知るであろう。"},{"ref":"Ezek.5.14","start":26005014,"end":26005014,"break":"none","ruby":[[10,2,"くにぐに"],[13,1,"なか"],[22,1,"とお"],[24,1,"もの"],[26,1,"め"],[28,1,"まえ"],[34,2,"めつぼう"],[42,1,"わた"]],"text":"わたしはまわりにある国々の中と、すべてそばを通る者の目の前であなたを滅亡とあざけりに渡す。"},{"ref":"Ezek.5.15","start":26005015,"end":26005015,"break":"none","ruby":[[4,1,"いか"],[8,1,"いきどお"],[12,1,"おも"],[14,2,"ちょうばつ"],[26,1,"たい"],[33,1,"おこな"],[35,1,"とき"],[49,2,"くにぐに"],[67,1,"いまし"],[73,1,"おどろ"],[82,1,"しゅ"],[90,1,"かた"]],"text":"わたしが怒りと、憤りと、重い懲罰とをもって、あなたに対してさばきを行う時、あなたはそのまわりにある国々のあざけりとなり、そしりとなり、戒めとなり、驚きとなる。これは主であるわたしが語るのである。"},{"ref":"Ezek.5.16","start":26005016,"end":26005016,"break":"none","ruby":[[13,1,"ほろ"],[20,1,"や"],[22,2,"めつぼう"],[25,1,"や"],[31,1,"はな"],[33,1,"とき"],[43,1,"ほろ"],[49,1,"はな"],[62,1,"うえ"],[68,1,"ま"],[70,1,"くわ"],[85,1,"う"],[87,1,"くだ"]],"text":"すなわち、わたしがあなたを滅ぼすききんの矢、滅亡の矢をあなたに放つ時、わたしはあなたを滅ぼすために放つのだ。わたしはあなたの上にききんを増し加え、あなたがつえとするパンを打ち砕く。"},{"ref":"Ezek.5.17","start":26005017,"end":26005017,"break":"none","ruby":[[12,2,"やじゅう"],[15,1,"おく"],[23,1,"こ"],[25,1,"うば"],[27,1,"と"],[32,2,"えきびょう"],[35,2,"りゅうけつ"],[42,1,"なか"],[44,1,"とお"],[58,1,"おく"],[61,1,"しゅ"],[72,1,"い"]],"text":"わたしはあなたにききんと野獣を送って、あなたの子を奪い取り、また疫病と流血にあなたの中を通らせ、またつるぎをあなたに送る。主であるわたしがこれを言う」。"}]