[{"ref":"1Kgs.14.1","start":11014001,"end":11014001,"break":"paragraph","ruby":[[10,1,"こ"],[15,2,"びょうき"]],"text":"そのころヤラベアムの子アビヤが病気になったので、"},{"ref":"1Kgs.14.2","start":11014002,"end":11014002,"break":"none","ruby":[[6,1,"つま"],[8,1,"い"],[13,1,"た"],[16,1,"すがた"],[18,1,"か"],[27,1,"つま"],[34,1,"し"],[47,1,"い"],[59,1,"たみ"],[61,1,"おう"],[73,1,"つ"],[76,3,"よげんしゃ"]],"text":"ヤラベアムは妻に言った、「立って姿を変え、ヤラベアムの妻であることの知られないようにしてシロへ行きなさい。わたしがこの民の王となることを、わたしに告げた預言者アヒヤがそこにいます。"},{"ref":"1Kgs.14.3","start":11014003,"end":11014003,"break":"none","ruby":[[3,1,"こ"],[5,2,"かし"],[7,2,"すうこ"],[19,1,"たずさ"],[22,1,"かれ"],[28,1,"い"],[34,1,"かれ"],[38,1,"こ"],[50,1,"つ"]],"text":"パン十個と菓子数個および、みつ一びんを携えて彼のところへ行きなさい。彼はこの子がどうなるかをあなたに告げるでしょう」。"},{"ref":"1Kgs.14.4","start":11014004,"end":11014004,"break":"paragraph","ruby":[[6,1,"つま"],[16,1,"た"],[22,1,"い"],[29,1,"いえ"],[31,1,"つ"],[40,2,"としお"],[47,1,"め"],[53,1,"み"]],"text":"ヤラベアムの妻はそのようにして、立ってシロへ行き、アヒヤの家に着いたが、アヒヤは年老いたため、目がかすんで見ることができなかった。"},{"ref":"1Kgs.14.5","start":11014005,"end":11014005,"break":"none","breaks":[[71,"paragraph"]],"ruby":[[3,1,"しゅ"],[9,1,"い"],[21,1,"つま"],[23,2,"こども"],[26,1,"こと"],[32,1,"たず"],[38,1,"く"],[41,2,"こども"],[44,2,"びょうき"],[52,2,"かのじょ"],[59,1,"い"],[71,2,"かのじょ"],[74,1,"く"],[79,2,"たにん"],[82,1,"よそお"]],"text":"しかし主はアヒヤに言われた、「ヤラベアムの妻が子供の事をあなたに尋ねるために来る。子供は病気だ。あなたは彼女にこうこう言わなければならない」。彼女は来るとき、他人を装っていた。"},{"ref":"1Kgs.14.6","start":11014006,"end":11014006,"break":"none","ruby":[[3,2,"かのじょ"],[6,2,"とぐち"],[24,2,"あしおと"],[27,1,"き"],[30,1,"い"],[41,1,"つま"],[54,2,"たにん"],[57,1,"よそお"],[76,1,"こと"],[78,1,"つ"],[84,1,"めい"]],"text":"しかし彼女が戸口にはいってきたとき、アヒヤはその足音を聞いて言った、「ヤラベアムの妻よ、はいりなさい。なぜ、他人を装うのですか。わたしはあなたにきびしい事を告げるよう、命じられています。"},{"ref":"1Kgs.14.7","start":11014007,"end":11014007,"break":"none","ruby":[[0,1,"い"],[9,1,"い"],[22,1,"かみ"],[24,1,"しゅ"],[28,1,"おお"],[43,1,"たみ"],[56,1,"たみ"],[63,1,"うえ"],[65,1,"た"],[68,1,"きみ"]],"text":"行ってヤラベアムに言いなさい、『イスラエルの神、主はこう仰せられる、「わたしはあなたを民のうちからあげ、わたしの民イスラエルの上に立てて君とし、"},{"ref":"1Kgs.14.8","start":11014008,"end":11014008,"break":"none","ruby":[[0,1,"くに"],[6,1,"いえ"],[9,1,"さ"],[11,1,"はな"],[22,1,"あた"],[48,2,"めいれい"],[51,1,"まも"],[54,2,"いっしん"],[61,1,"したが"],[70,1,"め"],[76,1,"こと"],[80,1,"おこな"]],"text":"国をダビデの家から裂き離して、それをあなたに与えたのに、あなたはわたしのしもべダビデが、わたしの命令を守って一心にわたしに従い、ただわたしの目にかなった事のみを行ったようにではなく、"},{"ref":"1Kgs.14.9","start":11014009,"end":11014009,"break":"none","ruby":[[6,1,"さき"],[14,1,"もの"],[20,1,"あく"],[25,1,"い"],[28,2,"じぶん"],[34,1,"た"],[36,2,"かみがみ"],[39,1,"い"],[41,1,"ぞう"],[43,1,"つく"],[50,1,"いか"],[62,1,"す"],[64,1,"さ"]],"text":"あなたよりも先にいたすべての者にまさって悪をなし、行って自分のために他の神々と鋳た像を造り、わたしを怒らせ、わたしをうしろに捨て去った。"},{"ref":"1Kgs.14.10","start":11014010,"end":11014010,"break":"none","ruby":[[5,1,"み"],[18,1,"いえ"],[20,1,"わざわい"],[22,1,"くだ"],[31,1,"ぞく"],[34,1,"おとこ"],[52,1,"もの"],[55,2,"じゆう"],[58,1,"もの"],[65,1,"た"],[68,1,"ひと"],[74,1,"のこ"],[78,1,"や"],[93,1,"いえ"],[95,1,"まった"],[97,1,"た"],[99,1,"ほろ"]],"text":"それゆえ、見よ、わたしはヤラベアムの家に災を下し、ヤラベアムに属する男は、イスラエルについて、つながれた者も、自由な者もことごとく断ち、人があくたを残りなく焼きつくすように、ヤラベアムの家を全く断ち滅ぼすであろう。"},{"ref":"1Kgs.14.11","start":11014011,"end":11014011,"break":"none","ruby":[[6,1,"ぞく"],[9,1,"もの"],[12,1,"まち"],[14,1,"し"],[16,1,"もの"],[18,1,"いぬ"],[20,1,"た"],[23,1,"の"],[25,1,"し"],[27,1,"もの"],[29,1,"そら"],[31,1,"とり"],[33,1,"た"],[41,1,"しゅ"],[46,1,"い"]],"text":"ヤラベアムに属する者は、町で死ぬ者を犬が食べ、野で死ぬ者を空の鳥が食べるであろう。主がこれを言われるのである」』。"},{"ref":"1Kgs.14.12","start":11014012,"end":11014012,"break":"none","ruby":[[4,1,"た"],[8,1,"いえ"],[10,1,"かえ"],[20,1,"あし"],[22,1,"まち"],[27,1,"とき"],[30,1,"こ"],[34,1,"し"]],"text":"あなたは立って、家へ帰りなさい。あなたの足が町にはいる時に、子どもは死にます。"},{"ref":"1Kgs.14.13","start":11014013,"end":11014013,"break":"none","ruby":[[9,1,"みな"],[11,1,"かれ"],[16,1,"かな"],[20,1,"かれ"],[22,1,"ほうむ"],[35,1,"ぞく"],[38,1,"もの"],[43,1,"かれ"],[46,1,"はか"],[48,1,"ほうむ"],[63,1,"いえ"],[69,1,"かれ"],[77,1,"かみ"],[79,1,"しゅ"],[85,1,"よ"],[87,1,"おも"]],"text":"そしてイスラエルは皆、彼のために悲しんで彼を葬るでしょう。ヤラベアムに属する者は、ただ彼だけ墓に葬られるでしょう。ヤラベアムの家のうちで、彼はイスラエルの神、主にむかって良い思いをいだいていたからです。"},{"ref":"1Kgs.14.14","start":11014014,"end":11014014,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"うえ"],[14,1,"おう"],[16,1,"おこ"],[22,1,"かれ"],[26,1,"ひ"],[33,1,"いえ"],[35,1,"た"]],"text":"主はイスラエルの上にひとりの王を起されます。彼はその日ヤラベアムの家を断つでしょう。"},{"ref":"1Kgs.14.15","start":11014015,"end":11014015,"break":"none","ruby":[[2,1,"のち"],[3,1,"しゅ"],[11,1,"う"],[15,1,"みず"],[17,1,"ゆ"],[20,1,"あし"],[36,2,"せんぞ"],[39,1,"たま"],[45,1,"よ"],[47,1,"ち"],[50,1,"ぬ"],[52,1,"さ"],[60,1,"かわ"],[62,1,"む"],[66,1,"ち"],[76,1,"かれ"],[82,1,"ぞう"],[84,1,"つく"],[87,1,"しゅ"],[89,1,"いか"]],"text":"その後主はイスラエルを撃って、水に揺らぐ葦のようにし、イスラエルを、その先祖に賜わったこの良い地から抜き去って、ユフラテ川の向こうに散らされるでしょう。彼らがアシラ像を造って主を怒らせたからです。"},{"ref":"1Kgs.14.16","start":11014016,"end":11014016,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"つみ"],[18,1,"かれ"],[24,1,"おか"],[35,1,"おか"],[41,1,"つみ"],[52,1,"す"]],"text":"主はヤラベアムの罪のゆえに、すなわち彼がみずから犯し、またイスラエルに犯させたその罪のゆえにイスラエルを捨てられるでしょう」。"},{"ref":"1Kgs.14.17","start":11014017,"end":11014017,"break":"paragraph","ruby":[[6,1,"つま"],[8,1,"た"],[11,1,"さ"],[18,1,"い"],[22,1,"いえ"],[24,2,"しきい"],[31,1,"とき"],[33,1,"こ"],[37,1,"し"]],"text":"ヤラベアムの妻は立って去り、テルザへ行って、家の敷居をまたいだ時、子どもは死んだ。"},{"ref":"1Kgs.14.18","start":11014018,"end":11014018,"break":"none","ruby":[[6,1,"みな"],[7,1,"かれ"],[9,1,"ほうむ"],[12,1,"かれ"],[17,1,"かな"],[22,1,"しゅ"],[29,3,"よげんしゃ"],[39,1,"い"],[43,2,"ことば"]],"text":"イスラエルは皆彼を葬り、彼のために悲しんだ。主がそのしもべ預言者アヒヤによって言われた言葉のとおりである。"},{"ref":"1Kgs.14.19","start":11014019,"end":11014019,"break":"none","ruby":[[8,1,"た"],[10,2,"じせき"],[13,1,"かれ"],[20,1,"たたか"],[28,1,"よ"],[30,1,"おさ"],[42,1,"おう"],[44,3,"れきだいし"],[48,1,"しょ"]],"text":"ヤラベアムのその他の事績、彼がどのように戦い、どのように世を治めたかは、イスラエルの王の歴代志の書にしるされている。"},{"ref":"1Kgs.14.20","start":11014020,"end":11014020,"break":"none","ruby":[[6,1,"よ"],[8,1,"おさ"],[11,1,"ひ"],[16,1,"ねん"],[22,1,"かれ"],[26,2,"せんぞ"],[29,1,"とも"],[31,1,"ねむ"],[37,1,"こ"],[42,1,"かわ"],[45,1,"おう"]],"text":"ヤラベアムが世を治めた日は二十二年であった。彼はその先祖と共に眠って、その子ナダブが代って王となった。"},{"ref":"1Kgs.14.21","start":11014021,"end":11014021,"break":"paragraph","ruby":[[5,1,"こ"],[15,1,"よ"],[17,1,"おさ"],[27,1,"おう"],[37,1,"さい"],[44,1,"しゅ"],[48,1,"な"],[50,1,"お"],[66,2,"ぶぞく"],[73,1,"えら"],[77,1,"まち"],[87,1,"ねん"],[88,1,"よ"],[90,1,"おさ"],[96,1,"はは"],[98,1,"な"]],"text":"ソロモンの子レハベアムはユダで世を治めた。レハベアムは王となったとき四十一歳であったが、主がその名を置くために、イスラエルのすべての部族のうちから選ばれた町エルサレムで、十七年世を治めた。その母の名はナアマといってアンモンびとであった。"},{"ref":"1Kgs.14.22","start":11014022,"end":11014022,"break":"none","ruby":[[3,2,"ひとびと"],[8,2,"せんぞ"],[11,1,"おこな"],[18,1,"こと"],[25,1,"しゅ"],[27,1,"め"],[29,1,"まえ"],[31,1,"あく"],[33,1,"おこな"],[38,1,"おか"],[41,1,"つみ"],[46,1,"しゅ"],[48,1,"いか"],[51,1,"ひ"],[53,1,"おこ"]],"text":"ユダの人々はその先祖の行ったすべての事にまさって、主の目の前に悪を行い、その犯した罪によって主の怒りを引き起した。"},{"ref":"1Kgs.14.23","start":11014023,"end":11014023,"break":"none","ruby":[[0,1,"かれ"],[7,1,"たか"],[9,1,"おか"],[11,1,"うえ"],[18,1,"あお"],[19,1,"き"],[21,1,"した"],[24,1,"たか"],[26,1,"ところ"],[28,1,"いし"],[30,1,"はしら"],[35,1,"ぞう"],[38,1,"た"]],"text":"彼らもすべての高い丘の上と、すべての青木の下に、高き所と石の柱とアシラ像とを建てたからである。"},{"ref":"1Kgs.14.24","start":11014024,"end":11014024,"break":"none","ruby":[[2,1,"くに"],[7,2,"しんでん"],[9,2,"だんしょう"],[17,1,"かれ"],[20,1,"しゅ"],[28,2,"ひとびと"],[31,1,"まえ"],[34,1,"お"],[36,1,"はら"],[40,2,"こくみん"],[47,1,"にく"],[51,1,"こと"],[56,1,"い"]],"text":"その国にはまた神殿男娼たちがいた。彼らは主がイスラエルの人々の前から追い払われた国民のすべての憎むべき事をならい行った。"},{"ref":"1Kgs.14.25","start":11014025,"end":11014025,"break":"paragraph","ruby":[[6,1,"おう"],[8,1,"だい"],[10,1,"ねん"],[17,1,"おう"],[29,1,"せ"],[31,1,"のぼ"]],"text":"レハベアムの王の第五年にエジプトの王シシャクがエルサレムに攻め上ってきて、"},{"ref":"1Kgs.14.26","start":11014026,"end":11014026,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"みや"],[4,2,"ほうもつ"],[8,1,"おう"],[10,2,"きゅうでん"],[13,2,"ほうもつ"],[16,1,"うば"],[18,1,"さ"],[22,1,"かれ"],[32,1,"うば"],[34,1,"さ"],[44,1,"つく"],[47,1,"きん"],[49,1,"たて"],[53,1,"うば"],[55,1,"さ"]],"text":"主の宮の宝物と、王の宮殿の宝物を奪い去った。彼はそれをことごとく奪い去り、またソロモンの造った金の盾をみな奪い去った。"},{"ref":"1Kgs.14.27","start":11014027,"end":11014027,"break":"none","ruby":[[8,1,"かわ"],[11,2,"せいどう"],[14,1,"たて"],[16,1,"つく"],[20,1,"おう"],[22,2,"きゅうでん"],[25,1,"もん"],[27,1,"まも"],[29,2,"じえい"],[31,1,"ちょう"],[33,1,"て"]],"text":"レハベアムはその代りに青銅の盾を造って、王の宮殿の門を守る侍衛長の手にわたした。"},{"ref":"1Kgs.14.28","start":11014028,"end":11014028,"break":"none","ruby":[[0,1,"おう"],[2,1,"しゅ"],[4,1,"みや"],[13,2,"じえい"],[19,1,"たずさ"],[28,2,"じえい"],[34,1,"も"],[36,1,"かえ"]],"text":"王が主の宮にはいるごとに、侍衛はそれを携え、また、それを侍衛のへやへ持ち帰った。"},{"ref":"1Kgs.14.29","start":11014029,"end":11014029,"break":"paragraph","ruby":[[8,1,"た"],[10,2,"じせき"],[14,1,"かれ"],[22,1,"こと"],[28,1,"おう"],[30,3,"れきだいし"],[34,1,"しょ"]],"text":"レハベアムのその他の事績と、彼がしたすべての事は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"1Kgs.14.30","start":11014030,"end":11014030,"break":"none","ruby":[[12,1,"あいだ"],[15,1,"た"],[18,2,"せんそう"]],"text":"レハベアムとヤラベアムの間には絶えず戦争があった。"},{"ref":"1Kgs.14.31","start":11014031,"end":11014031,"break":"none","ruby":[[8,2,"せんぞ"],[11,1,"とも"],[13,1,"ねむ"],[16,2,"せんぞ"],[19,1,"とも"],[25,1,"まち"],[27,1,"ほうむ"],[34,1,"はは"],[36,1,"な"],[58,1,"こ"],[64,1,"かわ"],[67,1,"おう"]],"text":"レハベアムはその先祖と共に眠って先祖と共にダビデの町に葬られた。その母の名はナアマといってアンモンびとであった。その子アビヤムが代って王となった。"}]