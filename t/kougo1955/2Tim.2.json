[{"ref":"2Tim.2.1","start":55002001,"end":55002001,"break":"paragraph","ruby":[[8,1,"こ"],[26,1,"めぐ"],[33,1,"つよ"]],"text":"そこで、わたしの子よ。あなたはキリスト・イエスにある恵みによって、強くなりなさい。"},{"ref":"2Tim.2.2","start":55002002,"end":55002002,"break":"none","ruby":[[8,1,"おお"],[11,2,"しょうにん"],[14,1,"まえ"],[21,1,"き"],[34,1,"もの"],[39,1,"おし"],[51,2,"ちゅうじつ"],[54,2,"ひとびと"]],"text":"そして、あなたが多くの証人の前でわたしから聞いたことを、さらにほかの者たちにも教えることのできるような忠実な人々に、ゆだねなさい。"},{"ref":"2Tim.2.3","start":55002003,"end":55002003,"break":"none","ruby":[[9,1,"よ"],[11,2,"へいそつ"],[21,1,"くる"],[25,1,"とも"]],"text":"キリスト・イエスの良い兵卒として、わたしと苦しみを共にしてほしい。"},{"ref":"2Tim.2.4","start":55002004,"end":55002004,"break":"none","ruby":[[0,1,"へい"],[1,1,"えき"],[3,1,"ふく"],[8,1,"もの"],[11,2,"にちじょう"],[13,2,"せいかつ"],[16,1,"こと"],[18,1,"わずら"],[31,1,"へい"],[33,1,"つの"],[36,3,"しれいかん"],[40,1,"よろこ"],[46,1,"つと"]],"text":"兵役に服している者は、日常生活の事に煩わされてはいない。ただ、兵を募った司令官を喜ばせようと努める。"},{"ref":"2Tim.2.5","start":55002005,"end":55002005,"break":"none","ruby":[[3,2,"きょうぎ"],[13,2,"きてい"],[16,1,"したが"],[19,2,"きょうぎ"],[28,2,"えいかん"],[31,1,"え"]],"text":"また、競技をするにしても、規定に従って競技をしなければ、栄冠は得られない。"},{"ref":"2Tim.2.6","start":55002006,"end":55002006,"break":"none","ruby":[[0,2,"ろうく"],[5,2,"のうふ"],[14,1,"さき"],[17,3,"せいさんぶつ"],[21,2,"ぶんぱい"]],"text":"労苦をする農夫が、だれよりも先に、生産物の分配にあずかるべきである。"},{"ref":"2Tim.2.7","start":55002007,"end":55002007,"break":"none","ruby":[[4,1,"い"],[12,1,"かんが"],[20,1,"しゅ"],[26,2,"じゅうぶん"],[29,2,"りかい"],[33,1,"ちから"],[39,1,"たま"]],"text":"わたしの言うことを、よく考えてみなさい。主は、それを十分に理解する力をあなたに賜わるであろう。"},{"ref":"2Tim.2.8","start":55002008,"end":55002008,"break":"paragraph","ruby":[[4,2,"しそん"],[9,1,"うま"],[12,2,"しにん"],[38,1,"おも"],[53,2,"ふくいん"]],"text":"ダビデの子孫として生れ、死人のうちからよみがえったイエス・キリストを、いつも思っていなさい。これがわたしの福音である。"},{"ref":"2Tim.2.9","start":55002009,"end":55002009,"break":"none","ruby":[[2,2,"ふくいん"],[13,2,"わるもの"],[19,1,"くる"],[28,1,"くさり"],[36,1,"いた"],[44,1,"かみ"],[46,1,"ことば"]],"text":"この福音のために、わたしは悪者のように苦しめられ、ついに鎖につながれるに至った。しかし、神の言はつながれてはいない。"},{"ref":"2Tim.2.10","start":55002010,"end":55002010,"break":"none","ruby":[[10,1,"えら"],[14,1,"ひと"],[30,1,"た"],[32,1,"しの"],[43,1,"かれ"],[57,1,"すくい"],[59,1,"う"],[68,1,"とも"],[70,2,"えいえん"],[73,2,"えいこう"],[76,1,"う"]],"text":"それだから、わたしは選ばれた人たちのために、いっさいのことを耐え忍ぶのである。それは、彼らもキリスト・イエスによる救を受け、また、それと共に永遠の栄光を受けるためである。"},{"ref":"2Tim.2.11","start":55002011,"end":55002011,"break":"none","ruby":[[0,1,"つぎ"],[2,2,"ことば"],[5,2,"かくじつ"],[21,1,"かれ"],[23,1,"とも"],[25,1,"し"],[33,1,"かれ"],[35,1,"とも"],[37,1,"い"]],"text":"次の言葉は確実である。「もしわたしたちが、彼と共に死んだなら、また彼と共に生きるであろう。"},{"ref":"2Tim.2.12","start":55002012,"end":55002012,"break":"none","ruby":[[2,1,"た"],[4,1,"しの"],[9,1,"かれ"],[11,1,"とも"],[13,3,"しはいしゃ"],[26,1,"かれ"],[28,1,"いな"],[33,1,"かれ"],[41,1,"いな"]],"text":"もし耐え忍ぶなら、彼と共に支配者となるであろう。もし彼を否むなら、彼もわたしたちを否むであろう。"},{"ref":"2Tim.2.13","start":55002013,"end":55002013,"break":"none","ruby":[[10,1,"ふ"],[11,2,"しんじつ"],[19,1,"かれ"],[21,1,"つね"],[23,2,"しんじつ"],[29,1,"かれ"],[31,2,"じぶん"],[34,1,"いつわ"]],"text":"たとい、わたしたちは不真実であっても、彼は常に真実である。彼は自分を偽ることが、できないのである」。"},{"ref":"2Tim.2.14","start":55002014,"end":55002014,"break":"paragraph","ruby":[[12,1,"かれ"],[15,1,"おも"],[17,1,"だ"],[25,1,"えき"],[30,1,"き"],[35,2,"ひとびと"],[38,2,"はめつ"],[52,2,"ことば"],[55,1,"あらそ"],[65,1,"かみ"],[76,1,"めい"]],"text":"あなたは、これらのことを彼らに思い出させて、なんの益もなく、聞いている人々を破滅におとしいれるだけである言葉の争いをしないように、神のみまえでおごそかに命じなさい。"},{"ref":"2Tim.2.15","start":55002015,"end":55002015,"break":"none","ruby":[[4,2,"しんり"],[7,2,"ことば"],[10,1,"ただ"],[13,1,"おし"],[16,1,"は"],[25,2,"れんたつ"],[29,1,"はたら"],[31,1,"びと"],[37,1,"かみ"],[39,2,"じぶん"],[49,1,"つと"]],"text":"あなたは真理の言葉を正しく教え、恥じるところのない錬達した働き人になって、神に自分をささげるように努めはげみなさい。"},{"ref":"2Tim.2.16","start":55002016,"end":55002016,"break":"none","ruby":[[0,2,"ぞくあく"],[5,1,"はなし"],[7,1,"さ"],[19,2,"ひとびと"],[27,3,"ふしんじん"],[31,1,"お"]],"text":"俗悪なむだ話を避けなさい。それによって人々は、ますます不信心に落ちていき、"},{"ref":"2Tim.2.17","start":55002017,"end":55002017,"break":"none","ruby":[[0,1,"かれ"],[3,2,"ことば"],[13,1,"くさ"],[26,1,"なか"]],"text":"彼らの言葉は、がんのように腐れひろがるであろう。その中にはヒメナオとピレトとがいる。"},{"ref":"2Tim.2.18","start":55002018,"end":55002018,"break":"none","ruby":[[0,1,"かれ"],[3,2,"しんり"],[11,2,"ふっかつ"],[17,1,"す"],[25,1,"い"],[34,2,"ひとびと"],[37,2,"しんこう"]],"text":"彼らは真理からはずれ、復活はすでに済んでしまったと言い、そして、ある人々の信仰をくつがえしている。"},{"ref":"2Tim.2.19","start":55002019,"end":55002019,"break":"none","ruby":[[4,1,"かみ"],[11,2,"どだい"],[25,1,"つぎ"],[27,1,"く"],[29,2,"しょういん"],[44,1,"しゅ"],[46,2,"じぶん"],[49,1,"もの"],[53,1,"し"],[60,1,"しゅ"],[62,1,"な"],[64,1,"よ"],[66,1,"もの"],[72,2,"ふぎ"],[76,1,"はな"]],"text":"しかし、神のゆるがない土台はすえられていて、それに次の句が証印として、しるされている。「主は自分の者たちを知る」。また「主の名を呼ぶ者は、すべて不義から離れよ」。"},{"ref":"2Tim.2.20","start":55002020,"end":55002020,"break":"none","ruby":[[0,1,"おお"],[3,1,"いえ"],[7,1,"きん"],[9,1,"ぎん"],[11,1,"うつわ"],[20,1,"き"],[22,1,"つち"],[24,1,"うつわ"],[38,1,"たっと"],[43,1,"もち"],[53,1,"いや"],[59,1,"もち"]],"text":"大きな家には、金や銀の器ばかりではなく、木や土の器もあり、そして、あるものは尊いことに用いられ、あるものは卑しいことに用いられる。"},{"ref":"2Tim.2.21","start":55002021,"end":55002021,"break":"none","ruby":[[2,1,"ひと"],[4,1,"いや"],[10,1,"と"],[12,1,"さ"],[15,2,"じぶん"],[25,1,"かれ"],[27,1,"たっと"],[35,1,"うつわ"],[41,2,"しゅじん"],[44,2,"やくだ"],[57,1,"よ"],[62,1,"あいだ"],[64,1,"あ"]],"text":"もし人が卑しいものを取り去って自分をきよめるなら、彼は尊いきよめられた器となって、主人に役立つものとなり、すべての良いわざに間に合うようになる。"},{"ref":"2Tim.2.22","start":55002022,"end":55002022,"break":"paragraph","ruby":[[8,1,"わか"],[10,1,"とき"],[12,2,"じょうよく"],[15,1,"さ"],[28,1,"こころ"],[33,1,"しゅ"],[35,1,"よ"],[37,1,"もと"],[40,2,"ひとびと"],[43,1,"とも"],[46,1,"ぎ"],[48,2,"しんこう"],[51,1,"あい"],[53,2,"へいわ"],[57,1,"お"],[59,1,"もと"]],"text":"そこで、あなたは若い時の情欲を避けなさい。そして、きよい心をもって主を呼び求める人々と共に、義と信仰と愛と平和とを追い求めなさい。"},{"ref":"2Tim.2.23","start":55002023,"end":55002023,"break":"none","ruby":[[0,1,"おろ"],[3,2,"むち"],[6,2,"ろんぎ"],[23,1,"し"],[34,1,"あらそ"],[37,1,"おわ"]],"text":"愚かで無知な論議をやめなさい。それは、あなたが知っているとおり、ただ争いに終るだけである。"},{"ref":"2Tim.2.24","start":55002024,"end":55002024,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"しもべ"],[5,1,"もの"],[7,1,"あらそ"],[19,1,"たい"],[23,2,"しんせつ"],[32,1,"おし"],[37,1,"しの"]],"text":"主の僕たる者は争ってはならない。だれに対しても親切であって、よく教え、よく忍び、"},{"ref":"2Tim.2.25","start":55002025,"end":55002025,"break":"none","ruby":[[0,2,"はんたい"],[4,1,"もの"],[6,2,"にゅうわ"],[9,1,"こころ"],[11,1,"おし"],[13,1,"みちび"],[25,1,"かみ"],[28,1,"かれ"],[31,2,"くいあらた"],[35,1,"こころ"],[37,1,"あた"],[41,2,"しんり"],[44,1,"し"]],"text":"反対する者を柔和な心で教え導くべきである。おそらく神は、彼らに悔改めの心を与えて、真理を知らせ、"},{"ref":"2Tim.2.26","start":55002026,"end":55002026,"break":"none","ruby":[[1,1,"ど"],[3,2,"あくま"],[6,1,"とら"],[13,1,"ほっ"],[26,1,"め"],[30,1,"かれ"],[42,1,"くだ"]],"text":"一度は悪魔に捕えられてその欲するままになっていても、目ざめて彼のわなからのがれさせて下さるであろう。"}]