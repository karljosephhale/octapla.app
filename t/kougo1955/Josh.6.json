[{"ref":"Josh.6.1","start":6006001,"end":6006001,"break":"paragraph","ruby":[[13,2,"ひとびと"],[23,1,"と"],[28,2,"でい"]],"text":"さてエリコは、イスラエルの人々のゆえに、かたく閉ざして、出入りするものがなかった。"},{"ref":"Josh.6.2","start":6006002,"end":6006002,"break":"none","ruby":[[0,1,"しゅ"],[7,1,"い"],[13,1,"み"],[27,1,"おう"],[31,1,"だい"],[32,2,"ゆうし"],[40,1,"て"]],"text":"主はヨシュアに言われた、「見よ、わたしはエリコと、その王および大勇士を、あなたの手にわたしている。"},{"ref":"Josh.6.3","start":6006003,"end":6006003,"break":"none","ruby":[[15,1,"まち"],[17,1,"めぐ"],[21,1,"まち"],[23,2,"しゅうい"],[27,1,"ど"],[28,1,"まわ"],[39,2,"むいか"],[42,1,"あいだ"]],"text":"あなたがた、いくさびとはみな、町を巡って、町の周囲を一度回らなければならない。六日の間そのようにしなければならない。"},{"ref":"Josh.6.4","start":6006004,"end":6006004,"break":"none","ruby":[[1,1,"にん"],[3,2,"さいし"],[13,2,"おひつじ"],[16,1,"つの"],[22,1,"たずさ"],[26,1,"はこ"],[28,2,"さきだ"],[43,2,"なぬか"],[45,1,"め"],[49,1,"ど"],[50,1,"まち"],[52,1,"めぐ"],[55,2,"さいし"],[64,1,"ふ"],[66,1,"な"]],"text":"七人の祭司たちは、おのおの雄羊の角のラッパを携えて、箱に先立たなければならない。そして七日目には七度町を巡り、祭司たちはラッパを吹き鳴らさなければならない。"},{"ref":"Josh.6.5","start":6006005,"end":6006005,"break":"none","ruby":[[3,2,"さいし"],[8,2,"おひつじ"],[11,1,"つの"],[13,1,"なが"],[15,1,"ふ"],[17,1,"な"],[27,1,"おと"],[36,1,"きこ"],[39,1,"とき"],[41,1,"たみ"],[45,2,"おおごえ"],[48,1,"よ"],[53,1,"さけ"],[70,1,"まち"],[72,2,"しゅうい"],[75,1,"いし"],[83,1,"お"],[86,1,"たみ"],[94,1,"すす"],[98,1,"せ"],[100,1,"のぼ"]],"text":"そして祭司たちが雄羊の角を長く吹き鳴らし、そのラッパの音が、あなたがたに聞える時、民はみな大声に呼ばわり、叫ばなければならない。そうすれば、町の周囲の石がきは、くずれ落ち、民はみなただちに進んで、攻め上ることができる」。"},{"ref":"Josh.6.6","start":6006006,"end":6006006,"break":"none","ruby":[[3,1,"こ"],[9,2,"さいし"],[14,1,"め"],[17,1,"い"],[28,2,"けいやく"],[31,1,"はこ"],[37,1,"にん"],[39,2,"さいし"],[44,2,"おひつじ"],[47,1,"つの"],[53,1,"ほん"],[55,1,"たずさ"],[59,1,"しゅ"],[61,1,"はこ"],[63,2,"さきだ"]],"text":"ヌンの子ヨシュアは祭司たちを召して言った、「あなたがたは契約の箱をかき、七人の祭司たちは雄羊の角のラッパ七本を携えて、主の箱に先立たなければならない」。"},{"ref":"Josh.6.7","start":6006007,"end":6006007,"break":"none","ruby":[[3,1,"たみ"],[5,1,"い"],[16,1,"すす"],[19,1,"い"],[22,1,"まち"],[24,1,"めぐ"],[30,2,"ぶそう"],[34,1,"もの"],[36,1,"しゅ"],[38,1,"はこ"],[40,2,"さきだ"],[44,1,"すす"]],"text":"そして民に言った、「あなたがたは進んで行って町を巡りなさい。武装した者は主の箱に先立って進まなければならない」。"},{"ref":"Josh.6.8","start":6006008,"end":6006008,"break":"paragraph","ruby":[[5,1,"たみ"],[7,1,"めい"],[15,1,"にん"],[17,2,"さいし"],[23,2,"おひつじ"],[26,1,"つの"],[32,1,"ほん"],[34,1,"たずさ"],[38,1,"しゅ"],[40,2,"さきだ"],[44,1,"すす"],[51,1,"ふ"],[53,1,"な"],[58,1,"しゅ"],[60,2,"けいやく"],[63,1,"はこ"],[70,1,"したが"]],"text":"ヨシュアが民に命じたように、七人の祭司たちは、雄羊の角のラッパ七本を携えて、主に先立って進み、ラッパを吹き鳴らした。主の契約の箱はそのあとに従った。"},{"ref":"Josh.6.9","start":6006009,"end":6006009,"break":"none","ruby":[[0,2,"ぶそう"],[4,1,"もの"],[10,1,"ふ"],[12,1,"な"],[15,2,"さいし"],[20,2,"さきだ"],[24,1,"い"],[32,1,"はこ"],[34,1,"したが"],[42,1,"た"],[44,1,"ま"],[47,1,"な"],[49,1,"ひび"]],"text":"武装した者はラッパを吹き鳴らす祭司たちに先立って行き、しんがりは箱に従った。ラッパは絶え間なく鳴り響いた。"},{"ref":"Josh.6.10","start":6006010,"end":6006010,"break":"none","ruby":[[9,1,"たみ"],[11,1,"めい"],[14,1,"い"],[25,1,"よ"],[42,1,"こえ"],[44,1,"きこ"],[57,1,"くち"],[60,2,"ことば"],[63,1,"だ"],[79,1,"よ"],[84,1,"めい"],[87,1,"ひ"],[96,1,"よ"]],"text":"しかし、ヨシュアは民に命じて言った、「あなたがたは呼ばわってはならない。あなたがたの声を聞えさせてはならない。また口から言葉を出してはならない。ただ、わたしが呼ばわれと命じる日に、あなたがたは呼ばわらなければならない」。"},{"ref":"Josh.6.11","start":6006011,"end":6006011,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"はこ"],[8,1,"も"],[12,1,"まち"],[14,1,"めぐ"],[20,2,"しゅうい"],[24,1,"ど"],[25,1,"まわ"],[30,2,"ひとびと"],[33,2,"しゅくえい"],[36,1,"かえ"],[39,1,"よる"],[41,2,"しゅくえい"],[44,1,"す"]],"text":"こうして主の箱を持って、町を巡らせ、その周囲を一度回らせた。人々は宿営に帰り、夜を宿営で過ごした。"},{"ref":"Josh.6.12","start":6006012,"end":6006012,"break":"paragraph","ruby":[[0,2,"よくあさ"],[7,1,"はや"],[9,1,"お"],[12,2,"さいし"],[17,1,"しゅ"],[19,1,"はこ"]],"text":"翌朝ヨシュアは早く起き、祭司たちは主の箱をかき、"},{"ref":"Josh.6.13","start":6006013,"end":6006013,"break":"none","ruby":[[1,1,"にん"],[3,2,"さいし"],[9,2,"おひつじ"],[12,1,"つの"],[18,1,"ほん"],[20,1,"たずさ"],[24,1,"しゅ"],[26,1,"はこ"],[28,2,"さきだ"],[32,1,"た"],[40,1,"ふ"],[42,1,"な"],[46,1,"すす"],[49,2,"ぶそう"],[53,1,"もの"],[58,2,"さきだ"],[62,1,"い"],[70,1,"しゅ"],[72,1,"はこ"],[74,1,"したが"],[82,1,"た"],[84,1,"ま"],[87,1,"な"],[89,1,"ひび"]],"text":"七人の祭司たちは、雄羊の角のラッパ七本を携えて、主の箱に先立ち、絶えず、ラッパを吹き鳴らして進み、武装した者はこれに先立って行き、しんがりは主の箱に従った。ラッパは絶え間なく鳴り響いた。"},{"ref":"Josh.6.14","start":6006014,"end":6006014,"break":"none","ruby":[[2,1,"つぎ"],[4,1,"ひ"],[8,1,"まち"],[10,2,"しゅうい"],[14,1,"ど"],[15,1,"めぐ"],[18,2,"しゅくえい"],[21,1,"かえ"],[25,2,"むいか"],[28,1,"あいだ"]],"text":"その次の日にも、町の周囲を一度巡って宿営に帰った。六日の間そのようにした。"},{"ref":"Josh.6.15","start":6006015,"end":6006015,"break":"paragraph","ruby":[[0,2,"なぬか"],[2,1,"め"],[6,2,"よあ"],[11,1,"はや"],[13,1,"お"],[16,1,"おな"],[24,1,"まち"],[27,1,"ど"],[33,1,"まち"],[36,1,"ど"],[45,1,"ひ"]],"text":"七日目には、夜明けに、早く起き、同じようにして、町を七度めぐった。町を七度めぐったのはこの日だけであった。"},{"ref":"Josh.6.16","start":6006016,"end":6006016,"break":"none","ruby":[[1,2,"どめ"],[5,2,"さいし"],[14,1,"ふ"],[17,1,"とき"],[24,1,"たみ"],[26,1,"い"],[31,1,"よ"],[39,1,"しゅ"],[43,1,"まち"],[51,1,"たま"]],"text":"七度目に、祭司たちがラッパを吹いた時、ヨシュアは民に言った、「呼ばわりなさい。主はこの町をあなたがたに賜わった。"},{"ref":"Josh.6.17","start":6006017,"end":6006017,"break":"none","ruby":[[2,1,"まち"],[7,1,"なか"],[17,1,"しゅ"],[20,3,"ほうのうぶつ"],[26,1,"ほろ"],[42,2,"ゆうじょ"],[51,1,"いえ"],[53,1,"とも"],[57,1,"もの"],[61,1,"い"],[81,1,"おく"],[84,2,"ししゃ"]],"text":"この町と、その中のすべてのものは、主への奉納物として滅ぼされなければならない。ただし遊女ラハブと、その家に共におる者はみな生かしておかなければならない。われわれが送った使者たちをかくまったからである。"},{"ref":"Josh.6.18","start":6006018,"end":6006018,"break":"none","ruby":[[10,3,"ほうのうぶつ"],[14,1,"て"],[16,1,"ふ"],[25,2,"ほうのう"],[28,1,"あた"],[33,3,"ほうのうぶつ"],[41,1,"と"],[51,2,"しゅくえい"],[55,1,"ほろ"],[69,1,"なや"]],"text":"また、あなたがたは、奉納物に手を触れてはならない。奉納に当り、その奉納物をみずから取って、イスラエルの宿営を、滅ぼさるべきものとし、それを悩ますことのないためである。"},{"ref":"Josh.6.19","start":6006019,"end":6006019,"break":"none","ruby":[[4,1,"ぎん"],[6,1,"きん"],[8,2,"せいどう"],[11,1,"てつ"],[13,1,"うつわ"],[18,1,"しゅ"],[20,1,"せい"],[23,1,"もの"],[30,1,"しゅ"],[32,1,"くら"],[34,1,"たずさ"],[36,1,"い"]],"text":"ただし、銀と金、青銅と鉄の器は、みな主に聖なる物であるから、主の倉に携え入れなければならない」。"},{"ref":"Josh.6.20","start":6006020,"end":6006020,"break":"none","ruby":[[3,1,"たみ"],[5,1,"よ"],[10,2,"さいし"],[19,1,"ふ"],[21,1,"な"],[26,1,"たみ"],[32,1,"おと"],[34,1,"き"],[37,2,"どうじ"],[43,2,"おおごえ"],[49,1,"よ"],[57,1,"いし"],[64,1,"お"],[71,1,"たみ"],[79,1,"のぼ"],[82,1,"まち"],[88,1,"まち"],[90,1,"せ"],[92,1,"と"]],"text":"そこで民は呼ばわり、祭司たちはラッパを吹き鳴らした。民はラッパの音を聞くと同時に、みな大声をあげて呼ばわったので、石がきはくずれ落ちた。そこで民はみな、すぐに上って町にはいり、町を攻め取った。"},{"ref":"Josh.6.21","start":6006021,"end":6006021,"break":"none","ruby":[[3,1,"まち"],[11,1,"おとこ"],[14,1,"おんな"],[17,1,"わか"],[19,1,"もの"],[22,1,"お"],[25,1,"もの"],[30,1,"うし"],[32,1,"ひつじ"],[51,1,"ほろ"]],"text":"そして町にあるものは、男も、女も、若い者も、老いた者も、また牛、羊、ろばをも、ことごとくつるぎにかけて滅ぼした。"},{"ref":"Josh.6.22","start":6006022,"end":6006022,"break":"paragraph","ruby":[[2,1,"とき"],[11,1,"ち"],[13,1,"さぐ"],[20,1,"ひと"],[22,1,"い"],[29,2,"ゆうじょ"],[32,1,"いえ"],[41,1,"おんな"],[43,2,"かのじょ"],[46,1,"ぞく"],[56,1,"つ"],[58,1,"だ"],[61,2,"かのじょ"],[64,1,"ちか"]],"text":"その時ヨシュアは、この地を探ったふたりの人に言った、「あの遊女の家にはいって、その女と彼女に属するすべてのものを連れ出し、彼女に誓ったようにしなさい」。"},{"ref":"Josh.6.23","start":6006023,"end":6006023,"break":"none","ruby":[[0,2,"せっこう"],[8,1,"わか"],[10,1,"ひと"],[25,2,"ふぼ"],[28,2,"きょうだい"],[35,2,"かのじょ"],[38,1,"ぞく"],[48,1,"つ"],[50,1,"だ"],[55,2,"しんぞく"],[60,1,"つ"],[62,1,"だ"],[72,2,"しゅくえい"],[75,1,"そと"],[77,1,"お"]],"text":"斥候となったその若い人たちははいって、ラハブとその父母、兄弟、そのほか彼女に属するすべてのものを連れ出し、その親族をみな連れ出して、イスラエルの宿営の外に置いた。"},{"ref":"Josh.6.24","start":6006024,"end":6006024,"break":"none","ruby":[[3,1,"ひ"],[5,1,"まち"],[9,1,"なか"],[18,1,"や"],[25,1,"ぎん"],[27,1,"きん"],[29,2,"せいどう"],[32,1,"てつ"],[34,1,"うつわ"],[37,1,"しゅ"],[39,1,"いえ"],[41,1,"くら"],[43,1,"おさ"]],"text":"そして火で町とその中のすべてのものを焼いた。ただ、銀と金、青銅と鉄の器は、主の家の倉に納めた。"},{"ref":"Josh.6.25","start":6006025,"end":6006025,"break":"none","ruby":[[4,2,"ゆうじょ"],[12,1,"ちち"],[14,1,"いえ"],[16,2,"いちぞく"],[19,2,"かのじょ"],[22,1,"ぞく"],[39,1,"い"],[53,2,"こんにち"],[66,1,"す"],[84,1,"さぐ"],[96,2,"ししゃ"]],"text":"しかし、遊女ラハブとその父の家の一族と彼女に属するすべてのものとは、ヨシュアが生かしておいたので、ラハブは今日までイスラエルのうちに住んでいる。これはヨシュアがエリコを探らせるためにつかわした使者たちをかくまったためである。"},{"ref":"Josh.6.26","start":6006026,"end":6006026,"break":"paragraph","breaks":[[61,"stanza"],[76,"line"]],"ruby":[[8,1,"とき"],[10,2,"ひとびと"],[13,1,"ちか"],[16,1,"た"],[19,1,"い"],[28,1,"た"],[38,1,"まち"],[40,2,"さいけん"],[44,1,"ひと"],[47,1,"しゅ"],[49,1,"まえ"],[63,1,"いしずえ"],[68,1,"ひと"],[70,2,"ちょうし"],[73,1,"うしな"],[78,1,"もん"],[80,1,"た"],[83,1,"ひと"],[85,1,"すえ"],[87,1,"こ"],[89,1,"うしな"]],"text":"ヨシュアは、その時、人々に誓いを立てて言った、「おおよそ立って、このエリコの町を再建する人は、主の前にのろわれるであろう。その礎をすえる人は長子を失い、その門を建てる人は末の子を失うであろう」。"},{"ref":"Josh.6.27","start":6006027,"end":6006027,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"とも"],[18,2,"めいせい"],[28,1,"ち"],[30,1,"ひろ"]],"text":"主はヨシュアと共におられ、ヨシュアの名声は、あまねくその地に広がった。"}]