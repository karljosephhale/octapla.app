[{"ref":"Num.23.1","start":4023001,"end":4023001,"break":"paragraph","ruby":[[8,1,"い"],[27,2,"さいだん"],[30,1,"きず"],[34,1,"とう"],[36,2,"おうし"],[40,1,"とう"],[42,2,"おひつじ"],[46,1,"ととの"]],"text":"バラムはバラクに言った、「わたしのために、ここに七つの祭壇を築き、七頭の雄牛と七頭の雄羊とを整えなさい」。"},{"ref":"Num.23.2","start":4023002,"end":4023002,"break":"none","ruby":[[8,1,"い"],[33,2,"さいだん"],[38,2,"おうし"],[41,1,"とう"],[43,2,"おひつじ"],[46,1,"とう"]],"text":"バラクはバラムの言ったとおりにした。そしてバラクとバラムとは、その祭壇ごとに雄牛一頭と雄羊一頭とをささげた。"},{"ref":"Num.23.3","start":4023003,"end":4023003,"break":"none","ruby":[[8,1,"い"],[17,2,"はんさい"],[25,1,"た"],[37,1,"あいだ"],[43,1,"い"],[50,1,"しゅ"],[59,1,"あ"],[75,1,"しゅ"],[81,1,"しめ"],[85,1,"こと"],[95,1,"つ"],[107,1,"かれ"],[114,1,"やま"],[116,1,"のぼ"]],"text":"バラムはバラクに言った、「あなたは燔祭のかたわらに立っていてください。その間にわたしは行ってきます。主はたぶんわたしに会ってくださるでしょう。そして、主がわたしに示される事はなんでもあなたに告げましょう」。こうして彼は一つのはげ山に登った。"},{"ref":"Num.23.4","start":4023004,"end":4023004,"break":"none","ruby":[[0,1,"かみ"],[6,1,"あ"],[17,1,"かみ"],[19,1,"い"],[31,2,"さいだん"],[34,1,"もう"],[37,2,"さいだん"],[42,2,"おうし"],[45,1,"とう"],[47,2,"おひつじ"],[50,1,"とう"]],"text":"神がバラムに会われたので、バラムは神に言った、「わたしは七つの祭壇を設け、祭壇ごとに雄牛一頭と雄羊一頭とをささげました」。"},{"ref":"Num.23.5","start":4023005,"end":4023005,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"くち"],[8,2,"ことば"],[11,1,"さづ"],[14,1,"い"],[27,1,"かえ"],[32,1,"い"]],"text":"主はバラムの口に言葉を授けて言われた、「バラクのもとに帰ってこう言いなさい」。"},{"ref":"Num.23.6","start":4023006,"end":4023006,"break":"none","ruby":[[0,1,"かれ"],[9,1,"かえ"],[34,1,"とも"],[36,2,"はんさい"],[44,1,"た"]],"text":"彼がバラクのもとに帰ってみると、バラクはモアブのすべてのつかさたちと共に燔祭のかたわらに立っていた。"},{"ref":"Num.23.7","start":4023007,"end":4023007,"break":"none","breaks":[[13,"stanza"],[32,"line"],[55,"line"],[73,"line"]],"ruby":[[6,2,"たくせん"],[9,1,"の"],[27,1,"まね"],[29,1,"よ"],[36,1,"おう"],[42,1,"ひがし"],[44,1,"やま"],[47,1,"まね"],[49,1,"よ"],[52,1,"い"]],"text":"バラムはこの託宣を述べた。「バラクはわたしをアラムから招き寄せ、モアブの王はわたしを東の山から招き寄せて言う、『きてわたしのためにヤコブをのろえ、きてイスラエルをのろえ』と。"},{"ref":"Num.23.8","start":4023008,"end":4023008,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かみ"],[7,1,"もの"],[24,1,"しゅ"],[31,1,"もの"]],"text":"神ののろわない者を、わたしがどうしてのろえよう。主ののろわない者を、わたしがどうしてのろえよう。"},{"ref":"Num.23.9","start":4023009,"end":4023009,"break":"line","breaks":[[9,"line"],[18,"line"],[31,"line"]],"ruby":[[0,1,"いわ"],[2,1,"いただき"],[9,1,"おか"],[11,1,"うえ"],[14,1,"み"],[24,1,"はな"],[27,1,"す"],[29,1,"たみ"],[36,2,"こくみん"],[42,1,"なら"]],"text":"岩の頂からながめ、丘の上から見たが、これはひとり離れて住む民、もろもろの国民のうちに並ぶものはない。"},{"ref":"Num.23.10","start":4023010,"end":4023010,"break":"line","breaks":[[13,"line"],[30,"line"],[43,"line"]],"ruby":[[7,2,"ぐんしゅう"],[10,1,"かぞ"],[19,2,"むすう"],[22,1,"たみ"],[24,1,"かぞ"],[26,1,"え"],[34,2,"ぎじん"],[40,1,"し"],[47,1,"おわ"],[50,1,"かれ"],[53,1,"おわ"]],"text":"だれがヤコブの群衆を数え、イスラエルの無数の民を数え得よう。わたしは義人のように死に、わたしの終りは彼らの終りのようでありたい」。"},{"ref":"Num.23.11","start":4023011,"end":4023011,"break":"paragraph","ruby":[[11,1,"い"],[24,1,"なに"],[37,1,"てき"],[50,1,"まね"],[64,1,"てき"],[66,2,"しゅくふく"]],"text":"そこでバラクはバラムに言った、「あなたはわたしに何をするのですか。わたしは敵をのろうために、あなたを招いたのに、あなたはかえって敵を祝福するばかりです」。"},{"ref":"Num.23.12","start":4023012,"end":4023012,"break":"none","ruby":[[4,1,"こた"],[14,1,"しゅ"],[20,1,"くち"],[22,1,"さづ"],[27,1,"こと"],[31,1,"かた"],[36,2,"ちゅうい"]],"text":"バラムは答えた、「わたしは、主がわたしの口に授けられる事だけを語るように注意すべきではないでしょうか」。"},{"ref":"Num.23.13","start":4023013,"end":4023013,"break":"paragraph","ruby":[[4,1,"かれ"],[6,1,"い"],[15,2,"いっしょ"],[25,1,"い"],[33,1,"かれ"],[50,1,"かれ"],[53,2,"いったん"],[56,1,"み"],[62,2,"ぜんたい"],[65,1,"み"],[91,1,"かれ"]],"text":"バラクは彼に言った、「わたしと一緒にほかのところへ行って、そこから彼らをごらんください。あなたはただ彼らの一端を見るだけで、全体を見ることはできないでしょうが、そこからわたしのために彼らをのろってください」。"},{"ref":"Num.23.14","start":4023014,"end":4023014,"break":"none","ruby":[[3,1,"かれ"],[9,1,"つ"],[16,1,"の"],[18,1,"い"],[25,1,"いただき"],[27,1,"のぼ"],[37,2,"さいだん"],[40,1,"きず"],[43,2,"さいだん"],[48,2,"おうし"],[51,1,"とう"],[53,2,"おひつじ"],[56,1,"とう"]],"text":"そして彼はバラムを連れてゾピムの野に行き、ピスガの頂に登って、そこに七つの祭壇を築き、祭壇ごとに雄牛一頭と雄羊一頭とをささげた。"},{"ref":"Num.23.15","start":4023015,"end":4023015,"break":"none","ruby":[[12,1,"い"],[25,2,"はんさい"],[33,1,"た"],[47,1,"む"],[51,1,"い"],[55,1,"しゅ"],[57,1,"うかが"]],"text":"ときにはバラムはバラクに言った、「あなたはここで、燔祭のかたわらに立っていてください。わたしは向こうへ行って、主に伺いますから」。"},{"ref":"Num.23.16","start":4023016,"end":4023016,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"のぞ"],[9,2,"ことば"],[12,1,"くち"],[14,1,"さづ"],[17,1,"い"],[30,1,"かえ"],[35,1,"い"]],"text":"主はバラムに臨み、言葉を口に授けて言われた、「バラクのもとに帰ってこう言いなさい」。"},{"ref":"Num.23.17","start":4023017,"end":4023017,"break":"none","ruby":[[0,1,"かれ"],[10,1,"い"],[13,1,"み"],[21,2,"はんさい"],[29,1,"た"],[42,1,"とも"],[55,1,"い"],[60,1,"しゅ"],[65,1,"い"]],"text":"彼がバラクのところへ行って見ると、バラクは燔祭のかたわらに立ち、モアブのつかさたちも共にいた。バラクはバラムに言った、「主はなんと言われましたか」。"},{"ref":"Num.23.18","start":4023018,"end":4023018,"break":"none","breaks":[[18,"stanza"],[30,"line"]],"ruby":[[11,2,"たくせん"],[14,1,"の"],[24,1,"た"],[27,1,"き"],[35,1,"こ"],[42,1,"みみ"],[44,1,"かたむ"]],"text":"そこでバラムはまたこの託宣を述べた。「バラクよ、立って聞け、チッポルの子よ、わたしに耳を傾けよ。"},{"ref":"Num.23.19","start":4023019,"end":4023019,"break":"line","breaks":[[15,"line"],[33,"line"],[52,"line"]],"ruby":[[0,1,"かみ"],[2,1,"ひと"],[7,1,"いつわ"],[17,1,"ひと"],[19,1,"こ"],[24,1,"く"],[33,1,"い"],[40,1,"おこな"],[52,1,"かた"]],"text":"神は人のように偽ることはなく、また人の子のように悔いることもない。言ったことで、行わないことがあろうか、語ったことで、しとげないことがあろうか。"},{"ref":"Num.23.20","start":4023020,"end":4023020,"break":"line","breaks":[[16,"line"],[30,"line"]],"ruby":[[0,2,"しゅくふく"],[6,1,"めい"],[19,1,"かみ"],[21,2,"しゅくふく"],[34,1,"か"]],"text":"祝福せよとの命をわたしはうけた、すでに神が祝福されたものを、わたしは変えることができない。"},{"ref":"Num.23.21","start":4023021,"end":4023021,"break":"line","breaks":[[20,"line"],[42,"line"],[55,"line"]],"ruby":[[10,1,"わざわい"],[16,1,"み"],[31,1,"なや"],[38,1,"み"],[42,1,"かれ"],[45,1,"かみ"],[47,1,"しゅ"],[49,1,"とも"],[55,1,"おう"],[61,1,"こえ"],[65,1,"なか"],[67,1,"きこ"]],"text":"だれもヤコブのうちに災のあるのを見ない、またイスラエルのうちに悩みのあるのを見ない。彼らの神、主が共にいまし、王をたたえる声がその中に聞える。"},{"ref":"Num.23.22","start":4023022,"end":4023022,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[2,1,"かれ"],[11,1,"みちび"],[13,1,"だ"],[18,1,"かれ"],[21,2,"やぎゅう"],[24,1,"つの"]],"text":"神は彼らをエジプトから導き出された、彼らは野牛の角のようだ。"},{"ref":"Num.23.23","start":4023023,"end":4023023,"break":"line","breaks":[[11,"line"],[24,"line"],[46,"line"]],"ruby":[[5,2,"まじゅつ"],[18,1,"うらな"],[24,1,"かみ"],[34,1,"とき"],[36,1,"おう"],[43,1,"つ"],[52,1,"しめ"]],"text":"ヤコブには魔術がなく、イスラエルには占いがない。神がそのなすところを時に応じてヤコブに告げ、イスラエルに示されるからだ。"},{"ref":"Num.23.24","start":4023024,"end":4023024,"break":"line","breaks":[[20,"line"],[32,"line"],[44,"line"]],"ruby":[[0,1,"み"],[5,1,"たみ"],[7,1,"め"],[14,1,"た"],[16,1,"あ"],[20,1,"お"],[27,1,"み"],[29,1,"おこ"],[37,2,"えもの"],[40,1,"く"],[46,1,"ころ"],[49,1,"もの"],[51,1,"ち"],[53,1,"の"],[58,1,"み"],[60,1,"よこ"]],"text":"見よ、この民は雌じしのように立ち上がり、雄じしのように身を起す。これはその獲物を食らい、その殺した者の血を飲むまでは身を横たえない」。"},{"ref":"Num.23.25","start":4023025,"end":4023025,"break":"paragraph","ruby":[[8,1,"い"],[17,1,"かれ"],[26,2,"しゅくふく"]],"text":"バラクはバラムに言った、「あなたは彼らをのろうことも祝福することも、やめてください」。"},{"ref":"Num.23.26","start":4023026,"end":4023026,"break":"none","ruby":[[4,1,"こた"],[11,1,"い"],[16,1,"しゅ"],[18,1,"い"],[49,1,"つ"]],"text":"バラムは答えてバラクに言った、「主の言われることは、なんでもしなければならないと、わたしはあなたに告げませんでしたか」。"},{"ref":"Num.23.27","start":4023027,"end":4023027,"break":"none","ruby":[[8,1,"い"],[36,1,"ところ"],[39,1,"つ"],[47,1,"かみ"],[64,1,"かれ"],[73,1,"ゆる"]],"text":"バラクはバラムに言った、「どうぞ、おいでください。わたしはあなたをほかの所へお連れしましょう。神はあなたがそこからわたしのために彼らをのろうことを許されるかもしれません」。"},{"ref":"Num.23.28","start":4023028,"end":4023028,"break":"none","ruby":[[11,1,"つ"],[15,2,"あらの"],[18,1,"み"],[26,1,"いただき"],[28,1,"い"]],"text":"そしてバラクはバラムを連れて、荒野を見おろすペオルの頂に行った。"},{"ref":"Num.23.29","start":4023029,"end":4023029,"break":"none","ruby":[[8,1,"い"],[26,2,"さいだん"],[29,1,"きず"],[32,2,"おうし"],[35,1,"とう"],[38,2,"おひつじ"],[41,1,"とう"],[44,1,"ととの"]],"text":"バラムはバラクに言った、「わたしのためにここに七つの祭壇を築き、雄牛七頭と、雄羊七頭とを整えなさい」。"},{"ref":"Num.23.30","start":4023030,"end":4023030,"break":"none","ruby":[[8,1,"い"],[19,2,"さいだん"],[24,2,"おうし"],[27,1,"とう"],[29,2,"おひつじ"],[32,1,"とう"]],"text":"バラクはバラムの言ったとおりにし、その祭壇ごとに雄牛一頭と雄羊一頭とをささげた。"}]