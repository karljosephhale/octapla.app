[{"ref":"Jer.12.1","start":24012001,"end":24012001,"break":"paragraph","breaks":[[17,"line"],[27,"line"],[44,"line"],[58,"line"],[67,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"ろん"],[13,1,"あらそ"],[15,1,"とき"],[21,1,"つね"],[23,1,"ただ"],[41,1,"まえ"],[51,1,"ろん"],[58,2,"あくにん"],[61,1,"みち"],[67,3,"ふしんじつ"],[71,1,"もの"],[75,2,"はんえい"]],"text":"主よ、わたしがあなたと論じ争う時、あなたは常に正しい。しかしなお、わたしはあなたの前に、さばきのことを論じてみたい。悪人の道がさかえ、不信実な者がみな繁栄するのはなにゆえですか。"},{"ref":"Jer.12.2","start":24012002,"end":24012002,"break":"line","breaks":[[15,"line"],[33,"line"],[50,"line"]],"ruby":[[4,1,"かれ"],[7,1,"う"],[15,1,"かれ"],[18,1,"ね"],[22,1,"そだ"],[26,1,"み"],[28,1,"むす"],[33,1,"かれ"],[36,1,"くち"],[43,1,"ちか"],[50,1,"こころ"],[57,1,"とお"]],"text":"あなたが彼らを植えられたので、彼らは根づき、育って、実を結びます。彼らは口ではあなたに近づきますが、心はあなたから遠ざかっています。"},{"ref":"Jer.12.3","start":24012003,"end":24012003,"break":"line","breaks":[[20,"line"],[33,"line"],[47,"line"],[71,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"し"],[18,1,"み"],[24,1,"こころ"],[30,1,"たい"],[40,1,"こころ"],[53,1,"ひつじ"],[55,1,"ひ"],[57,1,"だ"],[63,1,"かれ"],[66,1,"ひ"],[68,1,"だ"],[71,1,"ころ"],[73,1,"ひ"],[80,1,"かれ"],[83,1,"のこ"]],"text":"主よ、あなたはわたしを知り、わたしを見、わたしの心があなたに対していかにあるかを試みられます。ほふるために羊を引き出すように、彼らを引き出し、殺す日にそなえて、彼らを残しておいてください。"},{"ref":"Jer.12.4","start":24012004,"end":24012004,"break":"line","breaks":[[12,"line"],[32,"line"],[46,"line"],[57,"line"],[66,"line"]],"ruby":[[7,1,"ち"],[9,1,"なげ"],[14,1,"はたけ"],[16,2,"やさい"],[19,1,"か"],[34,1,"ち"],[36,1,"す"],[38,1,"もの"],[40,1,"あく"],[46,1,"けもの"],[48,1,"とり"],[50,1,"ほろ"],[57,2,"ひとびと"],[60,1,"い"],[67,1,"かれ"],[74,1,"おわ"],[77,1,"み"]],"text":"いつまで、この地は嘆き、どの畑の野菜も枯れていてよいでしょうか。この地に住む者の悪によって、獣と鳥は滅びうせます。人々は言いました、「彼はわれわれの終りを見ることはない」と。"},{"ref":"Jer.12.5","start":24012005,"end":24012005,"break":"stanza","breaks":[[23,"line"],[43,"line"],[61,"line"]],"ruby":[[8,2,"とほ"],[11,1,"ひと"],[13,2,"きょうそう"],[17,1,"つか"],[27,2,"きば"],[30,1,"ひと"],[32,1,"きそ"],[45,2,"あんぜん"],[48,1,"ち"],[55,1,"たお"],[66,2,"みつりん"]],"text":"「もしあなたが、徒歩の人と競争して疲れるなら、どうして騎馬の人と競うことができようか。もし安全な地で、あなたが倒れるなら、ヨルダンの密林では、どうするつもりか。"},{"ref":"Jer.12.6","start":24012006,"end":24012006,"break":"line","breaks":[[22,"line"],[46,"line"],[67,"line"]],"ruby":[[4,2,"きょうだい"],[13,1,"ちち"],[15,1,"いえ"],[26,1,"あざむ"],[29,2,"おおごえ"],[40,1,"お"],[46,1,"かれ"],[49,1,"した"],[57,1,"かた"],[67,1,"かれ"],[70,1,"しん"]],"text":"あなたの兄弟たち、あなたの父の家のものさえ、あなたを欺き、大声をあげて、あなたを追っている。彼らが親しげにあなたに語ることがあっても、彼らを信じてはならない」。"},{"ref":"Jer.12.7","start":24012007,"end":24012007,"break":"stanza","breaks":[[20,"line"]],"ruby":[[7,1,"いえ"],[9,1,"はな"],[14,1,"し"],[15,1,"ぎょう"],[17,1,"す"],[22,1,"たましい"],[24,1,"あい"],[27,1,"もの"],[29,1,"てき"],[31,1,"て"],[33,1,"わた"]],"text":"「わたしはわが家を離れ、わが嗣業を捨て、わが魂の愛する者を敵の手に渡した。"},{"ref":"Jer.12.8","start":24012008,"end":24012008,"break":"line","breaks":[[15,"line"],[29,"line"],[48,"line"]],"ruby":[[4,1,"し"],[5,1,"ぎょう"],[15,1,"はやし"],[17,1,"なか"],[36,1,"む"],[42,1,"こえ"],[59,1,"にく"]],"text":"わたしの嗣業は、わたしにとって林の中のししのようになった。これはわたしに向かってその声をあげる。それゆえわたしはこれを憎む。"},{"ref":"Jer.12.9","start":24012009,"end":24012009,"break":"line","breaks":[[16,"line"],[32,"line"],[51,"line"],[64,"line"]],"ruby":[[4,1,"し"],[5,1,"ぎょう"],[16,2,"はんてん"],[21,2,"もうきん"],[32,1,"た"],[34,2,"もうきん"],[40,1,"かこ"],[51,1,"い"],[55,1,"の"],[57,1,"けもの"],[61,1,"あつ"],[64,1,"つ"],[72,1,"た"]],"text":"わたしの嗣業は、わたしにとって、斑点のある猛禽のようではないか。他の猛禽がこれを囲んでいるではないか。行って、野の獣をみな集め、連れてきてこれを食べさせよ。"},{"ref":"Jer.12.10","start":24012010,"end":24012010,"break":"line","breaks":[[21,"line"],[33,"line"]],"ruby":[[0,1,"おお"],[3,2,"ぼくしゃ"],[15,1,"はたけ"],[17,1,"ほろ"],[25,1,"ち"],[27,1,"ふ"],[29,1,"あら"],[37,1,"うるわ"],[40,1,"ち"],[42,1,"あ"],[45,1,"の"]],"text":"多くの牧者たちはわたしのぶどう畑を滅ぼし、わたしの地を踏み荒した。わたしの麗しい地を荒れた野にした。"},{"ref":"Jer.12.11","start":24012011,"end":24012011,"break":"line","breaks":[[17,"line"],[36,"line"],[47,"line"]],"ruby":[[0,1,"かれ"],[6,1,"あ"],[8,1,"ち"],[19,1,"あ"],[21,1,"ち"],[27,1,"む"],[31,1,"なげ"],[36,1,"ぜん"],[37,1,"ち"],[39,1,"あ"],[41,1,"ち"],[58,1,"こころ"],[60,1,"と"],[63,1,"もの"]],"text":"彼らはこれを荒れ地としてしまった。その荒れ地がわたしに向かって嘆くのだ。全地は荒れ地にされた。しかし、ひとりもこれを心に留める者はない。"},{"ref":"Jer.12.12","start":24012012,"end":24012012,"break":"line","breaks":[[24,"line"],[52,"line"]],"ruby":[[0,1,"ほろ"],[3,1,"もの"],[7,2,"あらの"],[17,1,"やま"],[19,1,"うえ"],[24,1,"しゅ"],[31,1,"ち"],[36,1,"はて"],[42,1,"はて"],[46,1,"ほろ"],[52,1,"いのち"],[58,1,"やす"]],"text":"滅ぼす者どもが荒野のすべての、はげ山の上にきた。主のつるぎが、地の、この果から、かの果までを滅ぼすのだ。命あるものは安らかであることができない。"},{"ref":"Jer.12.13","start":24012013,"end":24012013,"break":"line","breaks":[[18,"line"],[32,"line"],[49,"line"]],"ruby":[[0,1,"かれ"],[3,1,"むぎ"],[13,1,"か"],[15,1,"と"],[18,2,"くろう"],[26,2,"りえき"],[32,1,"かれ"],[37,2,"しゅうかく"],[40,1,"は"],[49,1,"しゅ"],[51,1,"はげ"],[54,1,"いか"]],"text":"彼らは麦をまいて、いばらを刈り取る。苦労してもなんの利益もない。彼らはその収穫を恥じるようになる。主の激しい怒りによってである」。"},{"ref":"Jer.12.14","start":24012014,"end":24012014,"break":"paragraph","ruby":[[6,1,"たみ"],[17,1,"し"],[18,1,"ぎょう"],[20,1,"て"],[22,1,"ふ"],[29,1,"わる"],[31,1,"とな"],[33,1,"びと"],[39,1,"しゅ"],[43,1,"い"],[49,1,"み"],[56,1,"かれ"],[61,1,"ち"],[64,1,"ぬ"],[66,1,"だ"],[72,1,"いえ"],[74,1,"かれ"],[81,1,"ぬ"],[83,1,"だ"]],"text":"わたしがわが民イスラエルにつがせた嗣業に手を触れるすべての悪い隣り人について、主はこう言われる、「見よ、わたしは彼らをその地から抜き出し、ユダの家を彼らのうちから抜き出す。"},{"ref":"Jer.12.15","start":24012015,"end":24012015,"break":"none","ruby":[[5,1,"かれ"],[8,1,"ぬ"],[10,1,"だ"],[19,1,"かれ"],[34,1,"し"],[35,1,"ぎょう"],[37,1,"みちび"],[39,1,"かえ"],[50,1,"ち"],[52,1,"かえ"]],"text":"わたしは、彼らを抜き出したのちに、また彼らをあわれんで、それぞれその嗣業に導き返し、おのおのを、その地に帰らせる。"},{"ref":"Jer.12.16","start":24012016,"end":24012016,"break":"none","ruby":[[2,1,"かれ"],[9,1,"たみ"],[11,1,"みち"],[13,1,"まな"],[20,1,"な"],[27,1,"しゅ"],[29,1,"い"],[38,1,"い"],[41,1,"ちか"],[50,1,"かれ"],[57,1,"たみ"],[59,1,"おし"],[69,1,"ちか"],[82,1,"かれ"],[89,1,"たみ"],[94,1,"た"]],"text":"もし彼らがわたしの民の道を学び、わたしの名によって、『主は生きておられる』と言って誓うことが、かつて彼らがわたしの民に教えてバアルをさして誓わせたようになるならば、彼らはわたしの民のうちに建てられる。"},{"ref":"Jer.12.17","start":24012017,"end":24012017,"break":"none","ruby":[[3,1,"みみ"],[9,1,"たみ"],[23,1,"たみ"],[25,1,"ぬ"],[27,1,"だ"],[30,1,"ほろ"],[35,1,"しゅ"],[37,1,"い"]],"text":"しかし耳をかさない民があるときは、わたしはその民を抜き出して滅ぼすと、主は言われる」。"}]