[{"ref":"3John.1.1","start":64001001,"end":64001001,"break":"paragraph","ruby":[[0,2,"ちょうろう"],[9,2,"しんじつ"],[12,1,"あい"],[17,2,"しんあい"]],"text":"長老のわたしから、真実に愛している親愛なるガイオへ。"},{"ref":"3John.1.2","start":64001002,"end":64001002,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[18,1,"めぐ"],[25,1,"おな"],[40,1,"めぐ"],[62,1,"いの"]],"text":"愛する者よ。あなたのたましいがいつも恵まれていると同じく、あなたがすべてのことに恵まれ、またすこやかであるようにと、わたしは祈っている。"},{"ref":"3John.1.3","start":64001003,"end":64001003,"break":"none","ruby":[[0,2,"きょうだい"],[12,2,"しんり"],[15,1,"い"],[40,1,"よろこ"],[46,2,"じじつ"],[53,2,"しんり"],[59,1,"ある"]],"text":"兄弟たちがきて、あなたが真理に生きていることを、あかししてくれたので、ひじょうに喜んでいる。事実、あなたは真理のうちを歩いているのである。"},{"ref":"3John.1.4","start":64001004,"end":64001004,"break":"none","ruby":[[4,2,"こども"],[9,2,"しんり"],[15,1,"ある"],[23,1,"き"],[25,2,"いじょう"],[29,1,"おお"],[32,1,"よろこ"]],"text":"わたしの子供たちが真理のうちを歩いていることを聞く以上に、大きい喜びはない。"},{"ref":"3John.1.5","start":64001005,"end":64001005,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[11,2,"きょうだい"],[19,2,"たびさき"],[24,1,"もの"],[38,2,"しんじつ"]],"text":"愛する者よ。あなたが、兄弟たち、しかも旅先にある者につくしていることは、みな真実なわざである。"},{"ref":"3John.1.6","start":64001006,"end":64001006,"break":"none","ruby":[[0,1,"かれ"],[4,1,"しょ"],[5,2,"きょうかい"],[13,1,"あい"],[29,2,"ひとびと"],[33,1,"かみ"],[46,1,"おく"],[48,1,"だ"],[59,1,"ねが"]],"text":"彼らは、諸教会で、あなたの愛についてあかしをした。それらの人々を、神のみこころにかなうように送り出してくれたら、それは願わしいことである。"},{"ref":"3John.1.7","start":64001007,"end":64001007,"break":"none","ruby":[[0,1,"かれ"],[4,2,"みな"],[10,2,"たびだ"],[14,1,"もの"],[20,3,"いほうじん"],[26,1,"なに"],[28,1,"う"]],"text":"彼らは、御名のために旅立った者であって、異邦人からは何も受けていない。"},{"ref":"3John.1.8","start":64001008,"end":64001008,"break":"none","ruby":[[13,2,"しんり"],[19,3,"どうろうしゃ"],[33,2,"ひとびと"],[36,1,"たす"]],"text":"それだから、わたしたちは、真理のための同労者となるように、こういう人々を助けねばならない。"},{"ref":"3John.1.9","start":64001009,"end":64001009,"break":"paragraph","ruby":[[4,1,"すこ"],[9,2,"きょうかい"],[12,1,"か"],[53,1,"う"]],"text":"わたしは少しばかり教会に書きおくっておいたが、みんなのかしらになりたがっているデオテレペスが、わたしたちを受けいれてくれない。"},{"ref":"3John.1.10","start":64001010,"end":64001010,"break":"none","ruby":[[12,1,"い"],[15,1,"とき"],[17,1,"かれ"],[23,2,"してき"],[29,1,"おも"],[32,1,"かれ"],[34,1,"くち"],[57,2,"きょうだい"],[62,1,"う"],[73,1,"う"],[82,1,"ひと"],[86,1,"さまた"],[90,2,"きょうかい"],[94,1,"お"],[96,1,"だ"]],"text":"だから、わたしがそちらへ行った時、彼のしわざを指摘しようと思う。彼は口ぎたなくわたしたちをののしり、そればかりか、兄弟たちを受けいれようともせず、受けいれようとする人たちを妨げて、教会から追い出している。"},{"ref":"3John.1.11","start":64001011,"end":64001011,"break":"paragraph","ruby":[[0,1,"あい"],[3,1,"もの"],[6,1,"あく"],[15,1,"ぜん"],[24,1,"ぜん"],[26,1,"おこな"],[28,1,"もの"],[30,1,"かみ"],[33,1,"で"],[35,1,"もの"],[40,1,"あく"],[42,1,"おこな"],[44,1,"もの"],[46,1,"かみ"],[48,1,"み"],[55,1,"もの"]],"text":"愛する者よ。悪にならわないで、善にならいなさい。善を行う者は神から出た者であり、悪を行う者は神を見たことのない者である。"},{"ref":"3John.1.12","start":64001012,"end":64001012,"break":"none","ruby":[[15,1,"ひと"],[20,2,"しんり"],[28,2,"しょうめい"],[41,2,"しょうめい"],[56,1,"し"],[71,2,"しょうめい"],[74,2,"しんじつ"]],"text":"デメテリオについては、あらゆる人も、また真理そのものも、証明している。わたしたちも証明している。そして、あなたが知っているとおり、わたしたちの証明は真実である。"},{"ref":"3John.1.13","start":64001013,"end":64001013,"break":"paragraph","ruby":[[4,1,"か"],[22,1,"すみ"],[24,1,"ふで"],[27,1,"か"]],"text":"あなたに書きおくりたいことはたくさんあるが、墨と筆とで書くことはすまい。"},{"ref":"3John.1.14","start":64001014,"end":64001014,"break":"none","ruby":[[9,1,"あ"],[13,2,"ちょくせつ"],[18,1,"あ"]],"text":"すぐにでもあなたに会って、直接はなし合いたいものである。"},{"ref":"3John.1.15","start":64001014,"end":64001014,"break":"none","ruby":[[0,2,"へいあん"],[14,2,"ゆうじん"],[30,2,"ゆうじん"]],"text":"平安が、あなたにあるように。友人たちから、あなたによろしく。友人たちひとりびとりに、よろしく。"}]