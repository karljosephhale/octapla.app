[{"ref":"Mark.10.1","start":41010001,"end":41010001,"break":"paragraph","ruby":[[12,1,"さ"],[20,2,"ちほう"],[28,1,"む"],[31,1,"がわ"],[33,1,"い"],[39,2,"ぐんしゅう"],[44,1,"よ"],[46,1,"あつ"],[63,1,"おし"]],"text":"それから、イエスはそこを去って、ユダヤの地方とヨルダンの向こう側へ行かれたが、群衆がまた寄り集まったので、いつものように、また教えておられた。"},{"ref":"Mark.10.2","start":41010002,"end":41010002,"break":"none","ruby":[[9,1,"びと"],[13,1,"ちか"],[24,1,"こころ"],[31,2,"しつもん"],[37,1,"おっと"],[41,1,"つま"],[43,1,"だ"],[47,1,"さ"]],"text":"そのとき、パリサイ人たちが近づいてきて、イエスを試みようとして質問した、「夫はその妻を出しても差しつかえないでしょうか」。"},{"ref":"Mark.10.3","start":41010003,"end":41010003,"break":"none","ruby":[[4,1,"こた"],[7,1,"い"],[26,1,"めい"]],"text":"イエスは答えて言われた、「モーセはあなたがたになんと命じたか」。"},{"ref":"Mark.10.4","start":41010004,"end":41010004,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[13,2,"りえん"],[15,1,"じょう"],[17,1,"か"],[20,1,"つま"],[22,1,"だ"],[27,1,"ゆる"]],"text":"彼らは言った、「モーセは、離縁状を書いて妻を出すことを許しました」。"},{"ref":"Mark.10.5","start":41010005,"end":41010005,"break":"none","ruby":[[7,1,"い"],[23,1,"こころ"],[45,1,"さだ"],[48,1,"か"]],"text":"そこでイエスは言われた、「モーセはあなたがたの心が、かたくななので、あなたがたのためにこの定めを書いたのである。"},{"ref":"Mark.10.6","start":41010006,"end":41010006,"break":"none","ruby":[[4,2,"てんち"],[6,2,"そうぞう"],[9,1,"はじ"],[15,1,"かみ"],[17,1,"ひと"],[19,1,"おとこ"],[21,1,"おんな"],[24,1,"つく"]],"text":"しかし、天地創造の初めから、『神は人を男と女とに造られた。"},{"ref":"Mark.10.7","start":41010007,"end":41010007,"break":"none","ruby":[[6,1,"ひと"],[10,2,"ふぼ"],[13,1,"はな"]],"text":"それゆえに、人はその父母を離れ、"},{"ref":"Mark.10.8","start":41010008,"end":41010008,"break":"none","ruby":[[4,1,"もの"],[6,2,"いったい"],[18,1,"かれ"],[32,2,"いったい"]],"text":"ふたりの者は一体となるべきである』。彼らはもはや、ふたりではなく一体である。"},{"ref":"Mark.10.9","start":41010009,"end":41010009,"break":"none","ruby":[[4,1,"かみ"],[6,1,"あ"],[16,1,"ひと"],[18,1,"はな"]],"text":"だから、神が合わせられたものを、人は離してはならない」。"},{"ref":"Mark.10.10","start":41010010,"end":41010010,"break":"none","ruby":[[0,1,"いえ"],[9,2,"でし"],[24,1,"たず"]],"text":"家にはいってから、弟子たちはまたこのことについて尋ねた。"},{"ref":"Mark.10.11","start":41010011,"end":41010011,"break":"none","ruby":[[8,1,"い"],[19,2,"じぶん"],[22,1,"つま"],[24,1,"だ"],[27,1,"た"],[29,1,"おんな"],[34,1,"もの"],[39,1,"つま"],[41,1,"たい"],[44,2,"かんいん"],[47,1,"おこな"]],"text":"そこで、イエスは言われた、「だれでも、自分の妻を出して他の女をめとる者は、その妻に対して姦淫を行うのである。"},{"ref":"Mark.10.12","start":41010012,"end":41010012,"break":"none","ruby":[[2,1,"つま"],[7,1,"おっと"],[9,1,"わか"],[12,1,"た"],[14,1,"おとこ"],[23,2,"かんいん"],[26,1,"おこな"]],"text":"また妻が、その夫と別れて他の男にとつぐならば、姦淫を行うのである」。"},{"ref":"Mark.10.13","start":41010013,"end":41010013,"break":"paragraph","ruby":[[16,2,"ひとびと"],[19,1,"おさ"],[21,1,"ご"],[28,1,"つ"],[39,2,"でし"],[44,1,"かれ"]],"text":"イエスにさわっていただくために、人々が幼な子らをみもとに連れてきた。ところが、弟子たちは彼らをたしなめた。"},{"ref":"Mark.10.14","start":41010014,"end":41010014,"break":"none","ruby":[[3,1,"み"],[9,1,"いきどお"],[12,1,"かれ"],[15,1,"い"],[21,1,"おさ"],[23,1,"ご"],[30,1,"ところ"],[32,1,"く"],[45,1,"と"],[54,1,"かみ"],[56,1,"くに"],[63,1,"もの"],[65,1,"くに"]],"text":"それを見てイエスは憤り、彼らに言われた、「幼な子らをわたしの所に来るままにしておきなさい。止めてはならない。神の国はこのような者の国である。"},{"ref":"Mark.10.15","start":41010015,"end":41010015,"break":"none","ruby":[[2,1,"き"],[15,1,"おさ"],[17,1,"ご"],[22,1,"かみ"],[24,1,"くに"],[26,1,"う"],[31,1,"もの"],[47,1,"けっ"]],"text":"よく聞いておくがよい。だれでも幼な子のように神の国を受けいれる者でなければ、そこにはいることは決してできない」。"},{"ref":"Mark.10.16","start":41010016,"end":41010016,"break":"none","ruby":[[3,1,"かれ"],[6,1,"いだ"],[9,1,"て"],[13,1,"うえ"],[18,2,"しゅくふく"]],"text":"そして彼らを抱き、手をその上において祝福された。"},{"ref":"Mark.10.17","start":41010017,"end":41010017,"break":"paragraph","ruby":[[4,1,"みち"],[6,1,"で"],[8,1,"い"],[18,1,"ひと"],[20,1,"はし"],[22,1,"よ"],[35,1,"たず"],[42,1,"し"],[45,2,"えいえん"],[48,2,"せいめい"],[51,1,"う"],[58,1,"なに"]],"text":"イエスが道に出て行かれると、ひとりの人が走り寄り、みまえにひざまずいて尋ねた、「よき師よ、永遠の生命を受けるために、何をしたらよいでしょうか」。"},{"ref":"Mark.10.18","start":41010018,"end":41010018,"break":"none","ruby":[[4,1,"い"],[18,1,"もの"],[20,1,"い"],[25,1,"かみ"],[35,1,"もの"]],"text":"イエスは言われた、「なぜわたしをよき者と言うのか。神ひとりのほかによい者はいない。"},{"ref":"Mark.10.19","start":41010019,"end":41010019,"break":"none","ruby":[[9,1,"し"],[22,1,"ころ"],[26,2,"かんいん"],[32,1,"ぬす"],[36,2,"ぎしょう"],[39,1,"た"],[44,1,"あざむ"],[46,1,"と"],[50,1,"ちち"],[52,1,"はは"],[55,1,"うやま"]],"text":"いましめはあなたの知っているとおりである。『殺すな、姦淫するな、盗むな、偽証を立てるな。欺き取るな。父と母とを敬え』」。"},{"ref":"Mark.10.20","start":41010020,"end":41010020,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[11,2,"せんせい"],[18,1,"こと"],[23,1,"ちい"],[26,1,"とき"],[29,1,"まも"]],"text":"すると、彼は言った、「先生、それらの事はみな、小さい時から守っております」。"},{"ref":"Mark.10.21","start":41010021,"end":41010021,"break":"none","ruby":[[4,1,"かれ"],[6,1,"め"],[17,1,"い"],[27,1,"た"],[39,1,"かえ"],[43,1,"も"],[53,1,"う"],[55,1,"はら"],[59,1,"まず"],[62,2,"ひとびと"],[65,1,"ほどこ"],[77,1,"てん"],[79,1,"たから"],[81,1,"も"],[98,1,"したが"]],"text":"イエスは彼に目をとめ、いつくしんで言われた、「あなたに足りないことが一つある。帰って、持っているものをみな売り払って、貧しい人々に施しなさい。そうすれば、天に宝を持つようになろう。そして、わたしに従ってきなさい」。"},{"ref":"Mark.10.22","start":41010022,"end":41010022,"break":"none","ruby":[[4,1,"かれ"],[8,2,"ことば"],[11,1,"き"],[15,1,"かお"],[17,1,"くも"],[21,1,"かな"],[27,1,"た"],[29,1,"さ"],[38,2,"しさん"],[41,1,"も"]],"text":"すると、彼はこの言葉を聞いて、顔を曇らせ、悲しみながら立ち去った。たくさんの資産を持っていたからである。"},{"ref":"Mark.10.23","start":41010023,"end":41010023,"break":"paragraph","ruby":[[9,1,"み"],[15,2,"でし"],[20,1,"い"],[26,2,"ざいさん"],[31,1,"もの"],[33,1,"かみ"],[35,1,"くに"]],"text":"それから、イエスは見まわして、弟子たちに言われた、「財産のある者が神の国にはいるのは、なんとむずかしいことであろう」。"},{"ref":"Mark.10.24","start":41010024,"end":41010024,"break":"none","ruby":[[0,2,"でし"],[7,2,"ことば"],[10,1,"おどろ"],[12,1,"あや"],[21,1,"さら"],[23,1,"い"],[29,1,"こ"],[34,1,"かみ"],[36,1,"くに"]],"text":"弟子たちはこの言葉に驚き怪しんだ。イエスは更に言われた、「子たちよ、神の国にはいるのは、なんとむずかしいことであろう。"},{"ref":"Mark.10.25","start":41010025,"end":41010025,"break":"none","ruby":[[0,1,"と"],[5,1,"もの"],[7,1,"かみ"],[9,1,"くに"],[22,1,"はり"],[24,1,"あな"],[26,1,"とお"],[28,1,"ほう"]],"text":"富んでいる者が神の国にはいるよりは、らくだが針の穴を通る方が、もっとやさしい」。"},{"ref":"Mark.10.26","start":41010026,"end":41010026,"break":"none","ruby":[[3,1,"かれ"],[10,1,"おどろ"],[14,1,"たがい"],[16,1,"い"],[29,1,"すく"]],"text":"すると彼らはますます驚いて、互に言った、「それでは、だれが救われることができるのだろう」。"},{"ref":"Mark.10.27","start":41010027,"end":41010027,"break":"none","ruby":[[4,1,"かれ"],[7,1,"み"],[11,1,"い"],[17,1,"ひと"],[26,1,"かみ"],[33,1,"かみ"]],"text":"イエスは彼らを見つめて言われた、「人にはできないが、神にはできる。神はなんでもできるからである」。"},{"ref":"Mark.10.28","start":41010028,"end":41010028,"break":"none","ruby":[[8,1,"い"],[10,1,"だ"],[33,1,"す"],[41,1,"したが"],[44,1,"まい"]],"text":"ペテロがイエスに言い出した、「ごらんなさい、わたしたちはいっさいを捨てて、あなたに従って参りました」。"},{"ref":"Mark.10.29","start":41010029,"end":41010029,"break":"none","ruby":[[4,1,"い"],[12,1,"き"],[35,2,"ふくいん"],[42,1,"いえ"],[44,2,"きょうだい"],[47,2,"しまい"],[50,1,"はは"],[52,1,"ちち"],[54,1,"こ"],[60,1,"はたけ"],[62,1,"す"],[65,1,"もの"]],"text":"イエスは言われた、「よく聞いておくがよい。だれでもわたしのために、また福音のために、家、兄弟、姉妹、母、父、子、もしくは畑を捨てた者は、"},{"ref":"Mark.10.30","start":41010030,"end":41010030,"break":"none","ruby":[[0,1,"かなら"],[5,1,"ばい"],[7,1,"う"],[16,1,"いま"],[19,2,"じだい"],[23,1,"いえ"],[25,2,"きょうだい"],[28,2,"しまい"],[31,1,"はは"],[33,1,"こ"],[37,1,"はたけ"],[39,2,"はくがい"],[42,1,"とも"],[44,1,"う"],[55,1,"よ"],[58,2,"えいえん"],[61,2,"せいめい"],[64,1,"う"]],"text":"必ずその百倍を受ける。すなわち、今この時代では家、兄弟、姉妹、母、子および畑を迫害と共に受け、また、きたるべき世では永遠の生命を受ける。"},{"ref":"Mark.10.31","start":41010031,"end":41010031,"break":"none","ruby":[[4,1,"おお"],[7,1,"さき"],[9,1,"もの"],[20,1,"もの"],[22,1,"さき"]],"text":"しかし、多くの先の者はあとになり、あとの者は先になるであろう」。"},{"ref":"Mark.10.32","start":41010032,"end":41010032,"break":"paragraph","ruby":[[3,2,"いちどう"],[12,1,"のぼ"],[14,2,"とじょう"],[26,2,"せんとう"],[29,1,"た"],[32,1,"い"],[39,1,"かれ"],[42,1,"おどろ"],[44,1,"あや"],[48,1,"したが"],[50,1,"もの"],[54,1,"おそ"],[69,2,"でし"],[72,1,"よ"],[74,1,"よ"],[78,2,"じぶん"],[81,1,"み"],[83,1,"おこ"],[95,1,"かた"]],"text":"さて、一同はエルサレムへ上る途上にあったが、イエスが先頭に立って行かれたので、彼らは驚き怪しみ、従う者たちは恐れた。するとイエスはまた十二弟子を呼び寄せて、自分の身に起ろうとすることについて語りはじめられた、"},{"ref":"Mark.10.33","start":41010033,"end":41010033,"break":"none","ruby":[[1,1,"み"],[16,1,"のぼ"],[19,1,"い"],[23,1,"ひと"],[25,1,"こ"],[27,3,"さいしちょう"],[31,2,"りっぽう"],[33,2,"がくしゃ"],[38,1,"て"],[40,1,"ひ"],[51,1,"かれ"],[54,2,"しけい"],[57,2,"せんこく"],[61,1,"うえ"],[63,1,"かれ"],[65,3,"いほうじん"],[69,1,"ひ"]],"text":"「見よ、わたしたちはエルサレムへ上って行くが、人の子は祭司長、律法学者たちの手に引きわたされる。そして彼らは死刑を宣告した上、彼を異邦人に引きわたすであろう。"},{"ref":"Mark.10.34","start":41010034,"end":41010034,"break":"none","ruby":[[2,1,"かれ"],[18,1,"う"],[24,1,"ころ"],[34,1,"かれ"],[37,1,"か"],[39,1,"のち"]],"text":"また彼をあざけり、つばきをかけ、むち打ち、ついに殺してしまう。そして彼は三日の後によみがえるであろう」。"},{"ref":"Mark.10.35","start":41010035,"end":41010035,"break":"paragraph","ruby":[[8,1,"こ"],[28,1,"い"],[33,2,"せんせい"],[43,1,"たの"],[67,1,"ねが"]],"text":"さて、ゼベダイの子のヤコブとヨハネとがイエスのもとにきて言った、「先生、わたしたちがお頼みすることは、なんでもかなえてくださるようにお願いします」。"},{"ref":"Mark.10.36","start":41010036,"end":41010036,"break":"none","ruby":[[4,1,"かれ"],[8,1,"なに"],[17,1,"ねが"],[23,1,"い"]],"text":"イエスは彼らに「何をしてほしいと、願うのか」と言われた。"},{"ref":"Mark.10.37","start":41010037,"end":41010037,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[11,2,"えいこう"],[15,1,"う"],[31,1,"みぎ"],[38,1,"ひだり"]],"text":"すると彼らは言った、「栄光をお受けになるとき、ひとりをあなたの右に、ひとりを左にすわるようにしてください」。"},{"ref":"Mark.10.38","start":41010038,"end":41010038,"break":"none","ruby":[[4,1,"い"],[16,2,"じぶん"],[19,1,"なに"],[21,1,"もと"],[48,1,"の"],[50,1,"さかずき"],[52,1,"の"],[59,1,"う"],[68,1,"う"]],"text":"イエスは言われた、「あなたがたは自分が何を求めているのか、わかっていない。あなたがたは、わたしが飲む杯を飲み、わたしが受けるバプテスマを受けることができるか」。"},{"ref":"Mark.10.39","start":41010039,"end":41010039,"break":"none","ruby":[[0,1,"かれ"],[10,1,"こた"],[21,1,"い"],[38,1,"の"],[40,1,"さかずき"],[42,1,"の"],[49,1,"う"],[58,1,"う"]],"text":"彼らは「できます」と答えた。するとイエスは言われた、「あなたがたは、わたしが飲む杯を飲み、わたしが受けるバプテスマを受けるであろう。"},{"ref":"Mark.10.40","start":41010040,"end":41010040,"break":"none","ruby":[[8,1,"みぎ"],[10,1,"ひだり"],[36,1,"そな"],[43,2,"ひとびと"],[48,1,"ゆる"]],"text":"しかし、わたしの右、左にすわらせることは、わたしのすることではなく、ただ備えられている人々だけに許されることである」。"},{"ref":"Mark.10.41","start":41010041,"end":41010041,"break":"none","ruby":[[1,1,"にん"],[3,1,"もの"],[8,1,"き"],[24,2,"ふんがい"],[27,1,"だ"]],"text":"十人の者はこれを聞いて、ヤコブとヨハネとのことで憤慨し出した。"},{"ref":"Mark.10.42","start":41010042,"end":41010042,"break":"none","ruby":[[8,1,"かれ"],[11,1,"よ"],[13,1,"よ"],[16,1,"い"],[28,1,"し"],[37,3,"いほうじん"],[41,3,"しはいしゃ"],[45,1,"み"],[51,2,"ひとびと"],[57,1,"たみ"],[59,2,"おさめ"],[64,1,"えら"],[66,1,"ひと"],[73,1,"たみ"],[75,1,"うえ"],[77,2,"けんりょく"]],"text":"そこで、イエスは彼らを呼び寄せて言われた、「あなたがたの知っているとおり、異邦人の支配者と見られている人々は、その民を治め、また偉い人たちは、その民の上に権力をふるっている。"},{"ref":"Mark.10.43","start":41010043,"end":41010043,"break":"none","ruby":[[10,1,"あいだ"],[37,1,"あいだ"],[39,1,"えら"],[46,1,"おも"],[48,1,"もの"],[51,1,"つか"],[54,1,"ひと"]],"text":"しかし、あなたがたの間では、そうであってはならない。かえって、あなたがたの間で偉くなりたいと思う者は、仕える人となり、"},{"ref":"Mark.10.44","start":41010044,"end":41010044,"break":"none","ruby":[[6,1,"あいだ"],[17,1,"おも"],[19,1,"もの"],[26,1,"ひと"],[28,1,"しもべ"]],"text":"あなたがたの間でかしらになりたいと思う者は、すべての人の僕とならねばならない。"},{"ref":"Mark.10.45","start":41010045,"end":41010045,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[9,1,"つか"],[21,1,"つか"],[32,1,"おお"],[35,1,"ひと"],[45,2,"じぶん"],[48,1,"いのち"],[50,1,"あた"]],"text":"人の子がきたのも、仕えられるためではなく、仕えるためであり、また多くの人のあがないとして、自分の命を与えるためである」。"},{"ref":"Mark.10.46","start":41010046,"end":41010046,"break":"paragraph","ruby":[[5,1,"かれ"],[23,2,"でし"],[28,1,"おお"],[32,2,"ぐんしゅう"],[35,1,"とも"],[42,1,"で"],[55,1,"こ"],[65,2,"もうじん"],[73,1,"みち"]],"text":"それから、彼らはエリコにきた。そして、イエスが弟子たちや大ぜいの群衆と共にエリコから出かけられたとき、テマイの子、バルテマイという盲人のこじきが、道ばたにすわっていた。"},{"ref":"Mark.10.47","start":41010047,"end":41010047,"break":"none","ruby":[[14,1,"き"],[18,1,"かれ"],[25,1,"こ"],[46,1,"さけ"],[48,1,"だ"]],"text":"ところが、ナザレのイエスだと聞いて、彼は「ダビデの子イエスよ、わたしをあわれんでください」と叫び出した。"},{"ref":"Mark.10.48","start":41010048,"end":41010048,"break":"none","ruby":[[0,1,"おお"],[3,2,"ひとびと"],[6,1,"かれ"],[12,1,"だま"],[22,1,"かれ"],[28,1,"はげ"],[31,1,"さけ"],[43,1,"こ"]],"text":"多くの人々は彼をしかって黙らせようとしたが、彼はますます激しく叫びつづけた、「ダビデの子イエスよ、わたしをあわれんでください」。"},{"ref":"Mark.10.49","start":41010049,"end":41010049,"break":"none","ruby":[[4,1,"た"],[11,1,"かれ"],[13,1,"よ"],[17,1,"めい"],[27,2,"ひとびと"],[32,2,"もうじん"],[35,1,"よ"],[38,1,"い"],[43,1,"よろこ"],[46,1,"た"],[53,1,"よ"]],"text":"イエスは立ちどまって「彼を呼べ」と命じられた。そこで、人々はその盲人を呼んで言った、「喜べ、立て、おまえを呼んでおられる」。"},{"ref":"Mark.10.50","start":41010050,"end":41010050,"break":"none","ruby":[[3,1,"かれ"],[5,2,"うわぎ"],[8,1,"ぬ"],[10,1,"す"],[13,1,"おど"]],"text":"そこで彼は上着を脱ぎ捨て、踊りあがってイエスのもとにきた。"},{"ref":"Mark.10.51","start":41010051,"end":41010051,"break":"none","ruby":[[4,1,"かれ"],[10,1,"い"],[20,1,"なに"],[33,2,"もうじん"],[36,1,"い"],[41,2,"せんせい"],[44,1,"み"]],"text":"イエスは彼にむかって言われた、「わたしに何をしてほしいのか」。その盲人は言った、「先生、見えるようになることです」。"},{"ref":"Mark.10.52","start":41010052,"end":41010052,"break":"none","ruby":[[7,1,"い"],[13,1,"い"],[20,2,"しんこう"],[27,1,"すく"],[35,1,"かれ"],[42,1,"み"],[55,1,"したが"],[58,1,"い"]],"text":"そこでイエスは言われた、「行け、あなたの信仰があなたを救った」。すると彼は、たちまち見えるようになり、イエスに従って行った。"}]