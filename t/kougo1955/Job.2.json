[{"ref":"Job.2.1","start":18002001,"end":18002001,"break":"paragraph","ruby":[[2,1,"ひ"],[6,1,"かみ"],[8,1,"こ"],[12,1,"き"],[15,1,"しゅ"],[17,1,"まえ"],[19,1,"た"],[31,1,"なか"],[33,1,"き"],[36,1,"しゅ"],[38,1,"まえ"],[40,1,"た"]],"text":"ある日、また神の子たちが来て、主の前に立った。サタンもまたその中に来て、主の前に立った。"},{"ref":"Job.2.2","start":18002002,"end":18002002,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[20,1,"き"],[29,1,"しゅ"],[31,1,"こた"],[34,1,"い"],[39,1,"ち"],[41,1,"ゆ"],[53,1,"ある"]],"text":"主はサタンに言われた、「あなたはどこから来たか」。サタンは主に答えて言った、「地を行きめぐり、あちらこちら歩いてきました」。"},{"ref":"Job.2.3","start":18002003,"end":18002003,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[30,1,"まった"],[35,1,"ただ"],[39,1,"かみ"],[41,1,"おそ"],[44,1,"あく"],[46,1,"とお"],[50,1,"もの"],[52,1,"よ"],[59,1,"き"],[74,1,"すす"],[82,1,"かれ"],[84,1,"ほろ"],[93,1,"かれ"],[97,1,"かた"],[99,1,"たも"],[107,1,"まっと"]],"text":"主はサタンに言われた、「あなたは、わたしのしもべヨブのように全く、かつ正しく、神を恐れ、悪に遠ざかる者の世にないことを気づいたか。あなたは、わたしを勧めて、ゆえなく彼を滅ぼそうとしたが、彼はなお堅く保って、おのれを全うした」。"},{"ref":"Job.2.4","start":18002004,"end":18002004,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"こた"],[9,1,"い"],[14,1,"かわ"],[17,1,"かわ"],[26,1,"ひと"],[28,2,"じぶん"],[31,1,"いのち"],[39,1,"も"],[48,1,"もの"],[51,1,"あた"]],"text":"サタンは主に答えて言った、「皮には皮をもってします。人は自分の命のために、その持っているすべての物をも与えます。"},{"ref":"Job.2.5","start":18002005,"end":18002005,"break":"none","ruby":[[10,1,"て"],[12,1,"の"],[16,1,"かれ"],[18,1,"ほね"],[20,1,"にく"],[23,1,"う"],[33,1,"かれ"],[35,1,"かなら"],[41,1,"かお"],[43,1,"む"]],"text":"しかしいま、あなたの手を伸べて、彼の骨と肉とを撃ってごらんなさい。彼は必ずあなたの顔に向かって、あなたをのろうでしょう」。"},{"ref":"Job.2.6","start":18002006,"end":18002006,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"み"],[15,1,"かれ"],[21,1,"て"],[28,1,"かれ"],[30,1,"いのち"],[32,1,"たす"]],"text":"主はサタンに言われた、「見よ、彼はあなたの手にある。ただ彼の命を助けよ」。"},{"ref":"Job.2.7","start":18002007,"end":18002007,"break":"paragraph","ruby":[[4,1,"しゅ"],[6,1,"まえ"],[9,1,"で"],[11,1,"い"],[18,1,"う"],[23,1,"あし"],[25,1,"うら"],[28,1,"あたま"],[30,1,"いただき"],[37,2,"はれもの"],[43,1,"かれ"],[45,1,"なや"]],"text":"サタンは主の前から出て行って、ヨブを撃ち、その足の裏から頭の頂まで、いやな腫物をもって彼を悩ました。"},{"ref":"Job.2.8","start":18002008,"end":18002008,"break":"none","ruby":[[3,2,"とうき"],[6,2,"はへん"],[9,1,"と"],[15,2,"じぶん"],[18,1,"み"],[23,1,"はい"],[25,1,"なか"]],"text":"ヨブは陶器の破片を取り、それで自分の身をかき、灰の中にすわった。"},{"ref":"Job.2.9","start":18002009,"end":18002009,"break":"none","ruby":[[0,1,"とき"],[4,1,"つま"],[6,1,"かれ"],[8,1,"い"],[20,1,"かた"],[22,1,"たも"],[26,2,"じぶん"],[29,1,"まっと"],[38,1,"かみ"],[44,1,"し"]],"text":"時にその妻は彼に言った、「あなたはなおも堅く保って、自分を全うするのですか。神をのろって死になさい」。"},{"ref":"Job.2.10","start":18002010,"end":18002010,"break":"none","ruby":[[6,2,"かのじょ"],[9,1,"い"],[18,1,"かた"],[23,1,"おろ"],[26,1,"おんな"],[28,1,"かた"],[32,1,"おな"],[41,1,"かみ"],[44,1,"さいわい"],[54,1,"わざわい"],[75,1,"こと"],[93,1,"つみ"],[95,1,"おか"]],"text":"しかしヨブは彼女に言った、「あなたの語ることは愚かな女の語るのと同じだ。われわれは神から幸をうけるのだから、災をも、うけるべきではないか」。すべてこの事においてヨブはそのくちびるをもって罪を犯さなかった。"},{"ref":"Job.2.11","start":18002011,"end":18002011,"break":"paragraph","ruby":[[0,1,"とき"],[7,1,"にん"],[9,1,"とも"],[17,1,"わざわい"],[22,1,"のぞ"],[27,1,"き"],[35,2,"じぶん"],[38,1,"ところ"],[41,1,"たず"],[44,1,"き"],[83,1,"かれ"],[94,1,"なぐさ"],[106,2,"やくそく"]],"text":"時に、ヨブの三人の友がこのすべての災のヨブに臨んだのを聞いて、めいめい自分の所から尋ねて来た。すなわちテマンびとエリパズ、シュヒびとビルダデ、ナアマびとゾパルである。彼らはヨブをいたわり、慰めようとして、たがいに約束してきたのである。"},{"ref":"Job.2.12","start":18002012,"end":18002012,"break":"none","ruby":[[0,1,"かれ"],[3,1,"め"],[8,2,"えんぽう"],[12,1,"み"],[16,1,"かれ"],[26,1,"みと"],[40,1,"こえ"],[45,1,"な"],[52,2,"じぶん"],[55,2,"うわぎ"],[58,1,"さ"],[61,1,"てん"],[63,1,"む"],[76,2,"じぶん"],[81,1,"あたま"],[83,1,"うえ"],[87,1,"ち"]],"text":"彼らは目をあげて遠方から見たが、彼のヨブであることを認めがたいほどであったので、声をあげて泣き、めいめい自分の上着を裂き、天に向かって、ちりをうちあげ、自分たちの頭の上にまき散らした。"},{"ref":"Job.2.13","start":18002013,"end":18002013,"break":"none","ruby":[[4,2,"なぬか"],[6,2,"ななよ"],[9,1,"かれ"],[11,1,"とも"],[13,1,"ち"],[15,1,"ざ"],[23,1,"こと"],[25,1,"かれ"],[27,1,"はな"],[32,1,"もの"],[39,1,"かれ"],[41,1,"くる"],[45,2,"ひじょう"],[48,1,"おお"],[53,1,"み"]],"text":"こうして七日七夜、彼と共に地に座していて、ひと言も彼に話しかける者がなかった。彼の苦しみの非常に大きいのを見たからである。"}]