[{"ref":"Hos.2.1","start":28002001,"end":28002001,"break":"paragraph","ruby":[[6,2,"きょうだい"],[9,1,"む"],[21,1,"たみ"],[25,1,"い"],[34,2,"しまい"],[37,1,"む"],[53,1,"もの"],[57,1,"い"]],"text":"あなたがたの兄弟に向かっては「アンミ（わが民）」と言い、あなたがたの姉妹に向かっては「ルハマ（あわれまれる者）」と言え。"},{"ref":"Hos.2.2","start":28002002,"end":28002002,"break":"stanza","breaks":[[22,"line"],[35,"line"],[49,"line"],[67,"line"]],"ruby":[[7,1,"はは"],[22,2,"かのじょ"],[29,1,"つま"],[39,2,"かのじょ"],[42,1,"おっと"],[52,2,"かのじょ"],[57,1,"かお"],[60,2,"いんこう"],[63,1,"のぞ"],[69,1,"ち"],[73,1,"あいだ"],[76,2,"かんいん"],[79,1,"のぞ"]],"text":"「あなたがたの母とあげつらえ、あげつらえ――彼女はわたしの妻ではない、わたしは彼女の夫ではない――そして彼女にその顔から淫行を除かせ、その乳ぶさの間から姦淫を除かせよ。"},{"ref":"Hos.2.3","start":28002003,"end":28002003,"break":"line","breaks":[[8,"line"],[25,"line"],[38,"line"],[48,"line"],[61,"line"]],"ruby":[[12,2,"かのじょ"],[15,2,"きもの"],[21,1,"はだか"],[27,1,"うま"],[29,1,"で"],[31,1,"ひ"],[40,2,"あらの"],[54,1,"ち"],[68,2,"かのじょ"],[71,1,"ころ"]],"text":"そうでなければ、わたしは彼女の着物をはいで裸にし、その生れ出た日のようにし、また荒野のようにし、かわききった地のようにし、かわきによって彼女を殺す。"},{"ref":"Hos.2.4","start":28002004,"end":28002004,"break":"line","breaks":[[16,"line"]],"ruby":[[6,1,"こ"],[16,1,"かれ"],[19,2,"いんこう"],[22,1,"こ"]],"text":"わたしはその子らをあわれまない、彼らは淫行の子らだからである。"},{"ref":"Hos.2.5","start":28002005,"end":28002005,"break":"line","breaks":[[11,"line"],[32,"line"],[39,"line"],[58,"line"],[80,"line"]],"ruby":[[0,1,"かれ"],[3,1,"はは"],[5,2,"いんこう"],[11,1,"かれ"],[18,2,"かのじょ"],[21,1,"は"],[28,1,"おこな"],[32,2,"かのじょ"],[35,1,"い"],[46,2,"こいびと"],[54,1,"い"],[58,1,"かれ"],[64,1,"みず"],[66,1,"ひつじ"],[68,1,"け"],[70,1,"あさ"],[72,1,"あぶら"],[74,1,"の"],[76,1,"もの"],[84,1,"あた"],[87,1,"もの"]],"text":"彼らの母は淫行をなし、彼らをはらんだ彼女は恥ずべきことを行った。彼女は言った、『わたしはわが恋人たちについて行こう。彼らはパンと水と羊の毛と麻と油と飲み物とを、わたしに与える者である』と。"},{"ref":"Hos.2.6","start":28002006,"end":28002006,"break":"line","breaks":[[22,"line"],[33,"line"]],"ruby":[[13,2,"かのじょ"],[16,1,"みち"],[29,2,"かのじょ"],[35,1,"みち"]],"text":"それゆえ、わたしはいばらで彼女の道をふさぎ、かきをたてて、彼女にはその道がわからないようにする。"},{"ref":"Hos.2.7","start":28002007,"end":28002007,"break":"line","breaks":[[19,"line"],[35,"line"],[55,"line"],[64,"line"],[82,"line"]],"ruby":[[0,2,"かのじょ"],[5,2,"こいびと"],[13,1,"した"],[16,1,"い"],[22,1,"かれ"],[25,1,"お"],[35,1,"かれ"],[38,1,"たず"],[45,1,"み"],[58,2,"かのじょ"],[61,1,"い"],[69,1,"い"],[76,1,"おっと"],[78,1,"かえ"],[84,1,"とき"],[86,1,"いま"]],"text":"彼女はその恋人たちのあとを慕って行く、しかし彼らに追いつくことはない。彼らを尋ねる、しかし見いだすことはない。そこで彼女は言う、『わたしは行って、さきの夫に帰ろう。あの時は今よりもわたしによかったから』と。"},{"ref":"Hos.2.8","start":28002008,"end":28002008,"break":"line","breaks":[[16,"line"],[33,"line"],[44,"line"]],"ruby":[[0,2,"かのじょ"],[3,2,"こくもつ"],[6,1,"さけ"],[8,1,"あぶら"],[11,1,"あた"],[14,1,"もの"],[25,1,"もち"],[28,1,"ぎん"],[30,1,"きん"],[33,1,"おお"],[35,2,"かのじょ"],[38,1,"あた"],[41,1,"もの"],[54,2,"かのじょ"],[57,1,"し"]],"text":"彼女に穀物と酒と油とを与えた者、またバアルのために用いた銀と金とを多く彼女に与えた者は、わたしであったことを彼女は知らなかった。"},{"ref":"Hos.2.9","start":28002009,"end":28002009,"break":"line","breaks":[[22,"line"],[38,"line"],[54,"line"]],"ruby":[[9,2,"こくもつ"],[14,1,"とき"],[19,1,"うば"],[25,1,"しゅ"],[29,2,"きせつ"],[35,1,"うば"],[40,2,"かのじょ"],[43,1,"はだか"],[51,1,"もち"],[54,1,"ひつじ"],[56,1,"け"],[58,1,"あさ"],[61,1,"うば"],[63,1,"と"]],"text":"それゆえ、わたしは穀物をその時になって奪い、ぶどう酒をその季節になって奪い、また彼女の裸をおおうために用いる羊の毛と麻とを奪い取る。"},{"ref":"Hos.2.10","start":28002010,"end":28002010,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[4,1,"いま"],[6,2,"かのじょ"],[18,2,"こいびと"],[23,1,"め"],[25,1,"まえ"],[35,2,"かのじょ"],[42,1,"て"],[45,1,"すく"],[47,1,"もの"]],"text":"わたしは今、彼女のみだらなことをその恋人たちの目の前にあらわす。だれも彼女をわたしの手から救う者はない。"},{"ref":"Hos.2.11","start":28002011,"end":28002011,"break":"line","breaks":[[15,"line"],[28,"line"]],"ruby":[[4,2,"かのじょ"],[11,1,"たの"],[19,1,"いわい"],[21,2,"しんげつ"],[24,3,"あんそくにち"],[32,1,"まつり"]],"text":"わたしは彼女のすべての楽しみ、すなわち祝、新月、安息日、すべての祭をやめさせる。"},{"ref":"Hos.2.12","start":28002012,"end":28002012,"break":"line","breaks":[[42,"line"],[60,"line"],[67,"line"]],"ruby":[[6,2,"かのじょ"],[9,1,"さき"],[19,2,"こいびと"],[28,1,"あた"],[31,2,"ほうしゅう"],[36,1,"い"],[39,2,"かのじょ"],[46,1,"き"],[54,1,"き"],[57,1,"あら"],[63,1,"はやし"],[67,1,"の"],[69,1,"けもの"],[74,1,"く"]],"text":"わたしはまた彼女が先に『これはわたしの恋人らが、わたしに与えた報酬だ』と言った彼女のぶどうの木と、いちじくの木とを荒し、これを林とし、野の獣にこれを食わせる。"},{"ref":"Hos.2.13","start":28002013,"end":28002013,"break":"line","breaks":[[16,"line"],[37,"line"],[57,"line"]],"ruby":[[2,2,"かのじょ"],[5,2,"みみわ"],[8,2,"ほうせき"],[11,1,"み"],[13,1,"かざ"],[18,2,"こいびと"],[23,1,"した"],[26,1,"い"],[34,1,"わす"],[37,1,"こう"],[42,1,"つか"],[49,1,"まつり"],[51,1,"ひ"],[61,2,"かのじょ"],[64,1,"ばっ"],[68,1,"しゅ"],[70,1,"い"]],"text":"また彼女が耳輪と宝石で身を飾り、その恋人たちを慕って行って、わたしを忘れ、香をたいて仕えたバアルの祭の日のために、わたしは彼女を罰すると主は言われる。"},{"ref":"Hos.2.14","start":28002014,"end":28002014,"break":"stanza","breaks":[[21,"line"]],"ruby":[[5,1,"み"],[12,2,"かのじょ"],[21,2,"あらの"],[24,1,"みちび"],[27,1,"い"],[35,2,"かのじょ"],[38,1,"かた"]],"text":"それゆえ、見よ、わたしは彼女をいざなって、荒野に導いて行き、ねんごろに彼女に語ろう。"},{"ref":"Hos.2.15","start":28002015,"end":28002015,"break":"line","breaks":[[21,"line"],[38,"line"],[55,"line"],[75,"line"]],"ruby":[[2,1,"ところ"],[8,2,"かのじょ"],[16,1,"ばたけ"],[18,1,"あた"],[25,1,"たに"],[27,1,"のぞ"],[30,1,"もん"],[34,1,"あた"],[40,1,"ところ"],[42,2,"かのじょ"],[45,1,"わか"],[49,1,"ひ"],[60,1,"くに"],[67,1,"き"],[69,1,"とき"],[75,1,"こた"]],"text":"その所でわたしは彼女にそのぶどう畑を与え、アコルの谷を望みの門として与える。その所で彼女は若かった日のように、エジプトの国からのぼって来た時のように、答えるであろう。"},{"ref":"Hos.2.16","start":28002016,"end":28002016,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"ひ"],[24,1,"おっと"],[27,1,"よ"],[42,1,"よ"]],"text":"主は言われる、その日には、あなたはわたしを『わが夫』と呼び、もはや『わがバアル』とは呼ばない。"},{"ref":"Hos.2.17","start":28002017,"end":28002017,"break":"none","ruby":[[13,1,"な"],[15,2,"かのじょ"],[18,1,"くち"],[21,1,"と"],[23,1,"のぞ"],[26,1,"かさ"],[31,1,"な"]],"text":"わたしはもろもろのバアルの名を彼女の口から取り除き、重ねてその名をとなえることのないようにする。"},{"ref":"Hos.2.18","start":28002018,"end":28002018,"break":"none","ruby":[[2,1,"ひ"],[19,1,"の"],[21,1,"けもの"],[23,1,"そら"],[25,1,"とり"],[29,1,"ち"],[31,1,"は"],[36,2,"けいやく"],[39,1,"むす"],[44,1,"ゆみ"],[52,2,"せんそう"],[56,1,"ち"],[59,1,"た"],[67,1,"やす"],[71,1,"ふ"]],"text":"その日には、わたしはまたあなたのために野の獣、空の鳥および地の這うものと契約を結び、また弓と、つるぎと、戦争とを地から断って、あなたを安らかに伏させる。"},{"ref":"Hos.2.19","start":28002019,"end":28002019,"break":"none","ruby":[[6,2,"えいえん"],[17,1,"むす"],[24,2,"せいぎ"],[28,2,"こうへい"],[52,1,"むす"]],"text":"またわたしは永遠にあなたとちぎりを結ぶ。すなわち正義と、公平と、いつくしみと、あわれみとをもってちぎりを結ぶ。"},{"ref":"Hos.2.20","start":28002020,"end":28002020,"break":"none","ruby":[[4,2,"しんじつ"],[19,1,"むす"],[29,1,"しゅ"],[31,1,"し"]],"text":"わたしは真実をもって、あなたとちぎりを結ぶ。そしてあなたは主を知るであろう。"},{"ref":"Hos.2.21","start":28002021,"end":28002021,"break":"stanza","breaks":[[7,"line"],[19,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"ひ"],[14,1,"てん"],[16,1,"こた"],[19,1,"てん"],[21,1,"ち"],[23,1,"こた"]],"text":"主は言われる、その日わたしは天に答え、天は地に答える。"},{"ref":"Hos.2.22","start":28002022,"end":28002022,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ち"],[2,2,"こくもつ"],[5,1,"さけ"],[7,1,"あぶら"],[10,1,"こた"],[27,1,"こた"]],"text":"地は穀物と酒と油とに答え、またこれらのものはエズレルに答える。"},{"ref":"Hos.2.23","start":28002023,"end":28002023,"break":"line","breaks":[[18,"line"],[31,"line"],[46,"line"],[64,"line"]],"ruby":[[11,1,"かれ"],[13,1,"ち"],[24,1,"もの"],[35,1,"たみ"],[39,1,"もの"],[41,1,"む"],[55,1,"たみ"],[61,1,"い"],[64,1,"かれ"],[75,1,"かみ"],[81,1,"い"]],"text":"わたしはわたしのために彼を地にまき、あわれまれぬ者をあわれみ、わたしの民でない者に向かって、『あなたはわたしの民である』と言い、彼は『あなたはわたしの神である』と言う」。"}]