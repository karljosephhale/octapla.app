[{"ref":"Isa.24.1","start":23024001,"end":23024001,"break":"paragraph","breaks":[[15,"line"],[36,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[7,1,"ち"],[18,1,"あ"],[38,1,"たみ"],[40,1,"ち"]],"text":"見よ、主はこの地をむなしくし、これを荒れすたれさせ、これをくつがえして、その民を散らされる。"},{"ref":"Isa.24.2","start":23024002,"end":23024002,"break":"line","breaks":[[16,"line"],[28,"line"],[41,"line"],[54,"line"],[68,"line"],[81,"line"]],"ruby":[[6,1,"たみ"],[8,2,"さいし"],[20,2,"しゅじん"],[33,2,"しゅふ"],[41,1,"か"],[43,1,"もの"],[45,1,"う"],[47,1,"もの"],[54,1,"か"],[56,1,"もの"],[58,1,"か"],[61,1,"もの"],[68,3,"さいけんしゃ"],[72,3,"さいむしゃ"],[83,1,"こと"]],"text":"そして、その民も祭司もひとしく、しもべも主人もひとしく、はしためも主婦もひとしく、買う者も売る者もひとしく、貸す者も借りる者もひとしく、債権者も債務者もひとしく、この事にあう。"},{"ref":"Isa.24.3","start":23024003,"end":23024003,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ち"],[2,1,"まった"],[11,1,"まった"],[20,1,"しゅ"],[24,2,"ことば"],[27,1,"つ"]],"text":"地は全くむなしくされ、全くかすめられる。主がこの言葉を告げられたからである。"},{"ref":"Isa.24.4","start":23024004,"end":23024004,"break":"line","breaks":[[9,"line"],[18,"line"]],"ruby":[[0,1,"ち"],[2,1,"かな"],[6,1,"おとろ"],[9,1,"よ"],[15,1,"おとろ"],[18,1,"てん"],[20,1,"ち"],[22,1,"とも"]],"text":"地は悲しみ、衰え、世はしおれ、衰え、天も地と共にしおれはてる。"},{"ref":"Isa.24.5","start":23024005,"end":23024005,"break":"line","breaks":[[15,"line"],[34,"line"]],"ruby":[[0,1,"ち"],[4,1,"す"],[6,1,"たみ"],[8,1,"した"],[10,1,"けが"],[18,1,"かれ"],[21,2,"りっぽう"],[28,1,"さだ"],[31,1,"おか"],[39,2,"けいやく"],[42,1,"やぶ"]],"text":"地はその住む民の下に汚された。これは彼らが律法にそむき、定めを犯し、とこしえの契約を破ったからだ。"},{"ref":"Isa.24.6","start":23024006,"end":23024006,"break":"line","breaks":[[17,"line"],[32,"line"]],"ruby":[[9,1,"ち"],[20,1,"す"],[22,1,"もの"],[26,1,"つみ"],[28,1,"くる"],[34,1,"ち"],[36,1,"たみ"],[38,1,"や"],[47,1,"もの"],[49,1,"のこ"]],"text":"それゆえ、のろいは地をのみつくし、そこに住む者はその罪に苦しみ、また地の民は焼かれて、わずかの者が残される。"},{"ref":"Isa.24.7","start":23024007,"end":23024007,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"あたら"],[6,1,"しゅ"],[8,1,"かな"],[20,1,"こころ"],[22,1,"たの"],[25,1,"もの"],[29,1,"なげ"]],"text":"新しいぶどう酒は悲しみ、ぶどうはしおれ、心の楽しい者もみな嘆く。"},{"ref":"Isa.24.8","start":23024008,"end":23024008,"break":"line","breaks":[[8,"line"],[18,"line"]],"ruby":[[0,1,"つづみ"],[2,1,"おと"],[4,1,"しず"],[8,1,"よろこ"],[10,1,"もの"],[12,1,"さわ"],[18,1,"こと"],[20,1,"ね"],[24,1,"しず"]],"text":"鼓の音は静まり、喜ぶ者の騒ぎはやみ、琴の音もまた静まった。"},{"ref":"Isa.24.9","start":23024009,"end":23024009,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[6,1,"うた"],[12,1,"さけ"],[14,1,"の"],[18,1,"こ"],[20,1,"さけ"],[25,1,"の"],[27,1,"もの"],[29,1,"にが"]],"text":"彼らはもはや歌をうたって酒を飲まず、濃き酒はこれを飲む者に苦くなる。"},{"ref":"Isa.24.10","start":23024010,"end":23024010,"break":"line","breaks":[[10,"line"]],"ruby":[[0,2,"こんらん"],[4,1,"まち"],[6,1,"やぶ"],[14,1,"いえ"],[16,1,"と"]],"text":"混乱せる町は破られ、すべての家は閉ざされて、はいることができない。"},{"ref":"Isa.24.11","start":23024011,"end":23024011,"break":"line","breaks":[[20,"line"],[32,"line"]],"ruby":[[5,1,"さけ"],[7,2,"ふそく"],[13,1,"さけ"],[15,1,"こえ"],[24,1,"よろこ"],[27,1,"くら"],[32,1,"ち"],[34,1,"たの"],[38,1,"お"]],"text":"ちまたには酒の不足のために叫ぶ声があり、すべての喜びは暗くなり、地の楽しみは追いやられた。"},{"ref":"Isa.24.12","start":23024012,"end":23024012,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"まち"],[3,1,"あ"],[9,1,"ところ"],[12,1,"のこ"],[17,1,"もん"],[24,1,"やぶ"]],"text":"町には荒れすたれた所のみ残り、その門もこわされて破れた。"},{"ref":"Isa.24.13","start":23024013,"end":23024013,"break":"line","breaks":[[22,"line"],[40,"line"],[59,"line"]],"ruby":[[0,1,"ち"],[11,1,"たみ"],[16,1,"のこ"],[26,1,"き"],[28,1,"う"],[32,1,"のち"],[34,1,"み"],[44,2,"しゅうかく"],[47,1,"おわ"],[50,1,"のち"],[54,1,"と"],[56,1,"のこ"],[59,1,"あつ"]],"text":"地のうちで、もろもろの民のなかで残るものは、オリブの木の打たれた後の実のように、ぶどうの収穫の終った後にその採り残りを集めるときのようになる。"},{"ref":"Isa.24.14","start":23024014,"end":23024014,"break":"paragraph","breaks":[[13,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こえ"],[8,1,"よろこ"],[10,1,"うた"],[13,1,"しゅ"],[15,2,"いこう"],[22,1,"にし"],[25,1,"よろこ"],[27,1,"よ"]],"text":"彼らは声をあげて喜び歌う。主の威光のゆえに、西から喜び呼ばわる。"},{"ref":"Isa.24.15","start":23024015,"end":23024015,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"ひがし"],[7,1,"しゅ"],[13,2,"うみぞ"],[17,2,"くにぐに"],[26,1,"かみ"],[28,1,"しゅ"],[30,1,"な"]],"text":"それゆえ、東で主をあがめ、海沿いの国々でイスラエルの神、主の名をあがめよ。"},{"ref":"Isa.24.16","start":23024016,"end":23024016,"break":"line","breaks":[[21,"line"],[35,"line"],[57,"line"],[77,"line"],[86,"line"]],"ruby":[[5,1,"ち"],[7,1,"はて"],[15,1,"うた"],[17,1,"き"],[22,2,"えいこう"],[25,1,"ただ"],[28,1,"もの"],[43,1,"い"],[53,1,"おとろ"],[63,1,"おとろ"],[77,1,"あざむ"],[79,1,"もの"],[86,1,"あざむ"],[88,1,"もの"]],"text":"われわれは地の果から、さんびの歌を聞いた、「栄光は正しい者にある」と。しかし、わたしは言う、「わたしはやせ衰える、わたしはやせ衰える、わたしはわざわいだ。欺く者はあざむき、欺く者は、はなはだしくあざむく」。"},{"ref":"Isa.24.17","start":23024017,"end":23024017,"break":"paragraph","breaks":[[7,"line"]],"ruby":[[0,1,"ち"],[2,1,"す"],[4,1,"もの"],[7,1,"おそ"],[11,1,"おと"],[13,1,"あな"],[24,1,"うえ"]],"text":"地に住む者よ、恐れと、落し穴と、わなとはあなたの上にある。"},{"ref":"Isa.24.18","start":23024018,"end":23024018,"break":"line","breaks":[[18,"line"],[36,"line"]],"ruby":[[0,1,"おそ"],[3,1,"こえ"],[9,1,"もの"],[11,1,"おと"],[13,1,"あな"],[15,1,"おちい"],[18,1,"おと"],[20,1,"あな"],[23,1,"で"],[25,1,"もの"],[30,1,"とら"],[36,1,"てん"],[38,1,"まど"],[40,1,"ひら"],[43,1,"ち"],[45,1,"もとい"],[47,1,"ふる"],[49,1,"うご"]],"text":"恐れの声をのがれる者は落し穴に陥り、落し穴から出る者はわなに捕えられる。天の窓は開け、地の基が震い動くからである。"},{"ref":"Isa.24.19","start":23024019,"end":23024019,"break":"line","breaks":[[7,"line"],[12,"line"]],"ruby":[[0,1,"ち"],[2,1,"まった"],[4,1,"くだ"],[7,1,"ち"],[9,1,"さ"],[12,1,"ち"],[14,1,"はげ"],[17,1,"ふる"]],"text":"地は全く砕け、地は裂け、地は激しく震い、"},{"ref":"Isa.24.20","start":23024020,"end":23024020,"break":"line","breaks":[[15,"line"],[27,"line"],[39,"line"]],"ruby":[[0,1,"ち"],[2,1,"よ"],[15,1,"かり"],[16,2,"こや"],[24,1,"うご"],[34,1,"うえ"],[36,1,"おも"],[42,1,"たお"],[45,1,"ふたた"],[47,1,"お"]],"text":"地は酔いどれのようによろめき、仮小屋のようにゆり動く。そのとがはその上に重く、ついに倒れて再び起きあがることはない。"},{"ref":"Isa.24.21","start":23024021,"end":23024021,"break":"paragraph","breaks":[[20,"line"]],"ruby":[[2,1,"ひ"],[4,1,"しゅ"],[6,1,"てん"],[12,1,"てん"],[14,2,"ぐんぜい"],[17,1,"ばっ"],[20,1,"ち"],[22,1,"うえ"],[25,1,"ち"],[32,1,"おう"],[34,1,"ばっ"]],"text":"その日、主は天において、天の軍勢を罰し、地の上で、地のもろもろの王を罰せられる。"},{"ref":"Isa.24.22","start":23024022,"end":23024022,"break":"line","breaks":[[12,"line"],[26,"line"],[36,"line"]],"ruby":[[0,1,"かれ"],[3,2,"しゅうじん"],[6,1,"つち"],[10,1,"なか"],[12,1,"あつ"],[20,1,"あつ"],[26,2,"ごくや"],[29,1,"なか"],[31,1,"と"],[36,1,"おお"],[39,1,"ひ"],[41,1,"へ"],[43,1,"のち"],[45,1,"ばっ"]],"text":"彼らは囚人が土ろうの中に集められるように集められて、獄屋の中に閉ざされ、多くの日を経て後、罰せられる。"},{"ref":"Isa.24.23","start":23024023,"end":23024023,"break":"line","breaks":[[14,"line"],[28,"line"],[39,"line"],[53,"line"]],"ruby":[[4,2,"ばんぐん"],[7,1,"しゅ"],[13,1,"やま"],[23,1,"す"],[25,1,"おさ"],[32,2,"ちょうろう"],[37,1,"まえ"],[41,2,"えいこう"],[53,1,"つき"],[59,1,"ひ"],[61,1,"は"]],"text":"こうして万軍の主がシオンの山およびエルサレムで統べ治め、かつその長老たちの前にその栄光をあらわされるので、月はあわて、日は恥じる。"}]