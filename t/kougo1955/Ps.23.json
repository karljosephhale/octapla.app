[{"ref":"Ps.23.1","start":19023001,"end":19023001,"break":"paragraph","title":"ダビデの歌","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[6,2,"ぼくしゃ"],[18,1,"とぼ"]],"titleRuby":[[4,1,"うた"]],"text":"主はわたしの牧者であって、わたしには乏しいことがない。"},{"ref":"Ps.23.2","start":19023002,"end":19023002,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"みどり"],[8,2,"まきば"],[11,1,"ふ"],[23,1,"ともな"]],"text":"主はわたしを緑の牧場に伏させ、いこいのみぎわに伴われる。"},{"ref":"Ps.23.3","start":19023003,"end":19023003,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"たましい"],[16,1,"な"],[25,1,"ただ"],[28,1,"みち"],[30,1,"みちび"]],"text":"主はわたしの魂をいきかえらせ、み名のためにわたしを正しい道に導かれる。"},{"ref":"Ps.23.4","start":19023004,"end":19023004,"break":"line","breaks":[[18,"line"],[29,"line"],[48,"line"]],"ruby":[[7,1,"し"],[9,1,"かげ"],[11,1,"たに"],[13,1,"あゆ"],[23,1,"おそ"],[37,1,"とも"],[67,1,"なぐさ"]],"text":"たといわたしは死の陰の谷を歩むとも、わざわいを恐れません。あなたがわたしと共におられるからです。あなたのむちと、あなたのつえはわたしを慰めます。"},{"ref":"Ps.23.5","start":19023005,"end":19023005,"break":"line","breaks":[[24,"line"],[40,"line"]],"ruby":[[8,1,"てき"],[10,1,"まえ"],[17,1,"まえ"],[19,1,"えん"],[21,1,"もう"],[32,1,"あぶら"],[44,1,"さかずき"]],"text":"あなたはわたしの敵の前で、わたしの前に宴を設け、わたしのこうべに油をそそがれる。わたしの杯はあふれます。"},{"ref":"Ps.23.6","start":19023006,"end":19023006,"break":"line","breaks":[[13,"line"],[32,"line"]],"ruby":[[4,1,"い"],[13,1,"かなら"],[15,1,"めぐ"],[25,1,"ともな"],[41,1,"しゅ"],[43,1,"みや"],[45,1,"す"]],"text":"わたしの生きているかぎりは必ず恵みといつくしみとが伴うでしょう。わたしはとこしえに主の宮に住むでしょう。"}]