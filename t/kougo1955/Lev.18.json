[{"ref":"Lev.18.1","start":3018001,"end":3018001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.18.2","start":3018002,"end":3018002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[27,1,"かみ"],[29,1,"しゅ"]],"text":"「イスラエルの人々に言いなさい、『わたしはあなたがたの神、主である。"},{"ref":"Lev.18.3","start":3018003,"end":3018003,"break":"none","ruby":[[6,1,"す"],[16,1,"くに"],[18,2,"しゅうかん"],[21,2,"みなら"],[43,1,"みちび"],[45,1,"い"],[52,1,"くに"],[54,2,"しゅうかん"],[57,2,"みなら"],[69,1,"かれ"],[72,1,"さだ"],[75,1,"あゆ"]],"text":"あなたがたの住んでいたエジプトの国の習慣を見習ってはならない。またわたしがあなたがたを導き入れるカナンの国の習慣を見習ってはならない。また彼らの定めに歩んではならない。"},{"ref":"Lev.18.4","start":3018004,"end":3018004,"break":"none","ruby":[[8,1,"おこな"],[15,1,"さだ"],[18,1,"まも"],[24,1,"あゆ"],[45,1,"かみ"],[47,1,"しゅ"]],"text":"わたしのおきてを行い、わたしの定めを守り、それに歩まなければならない。わたしはあなたがたの神、主である。"},{"ref":"Lev.18.5","start":3018005,"end":3018005,"break":"none","ruby":[[10,1,"さだ"],[21,1,"まも"],[34,1,"ひと"],[40,1,"おこな"],[52,1,"い"],[64,1,"しゅ"]],"text":"あなたがたはわたしの定めとわたしのおきてを守らなければならない。もし人が、これを行うならば、これによって生きるであろう。わたしは主である。"},{"ref":"Lev.18.6","start":3018006,"end":3018006,"break":"paragraph","ruby":[[13,2,"にくしん"],[16,1,"もの"],[18,1,"ちか"],[26,1,"おか"],[39,1,"しゅ"]],"text":"あなたがたは、だれも、その肉親の者に近づいて、これを犯してはならない。わたしは主である。"},{"ref":"Lev.18.7","start":3018007,"end":3018007,"break":"none","ruby":[[4,1,"はは"],[6,1,"おか"],[22,1,"ちち"],[39,2,"かのじょ"],[46,1,"はは"],[56,1,"おか"]],"text":"あなたの母を犯してはならない。それはあなたの父をはずかしめることだからである。彼女はあなたの母であるから、これを犯してはならない。"},{"ref":"Lev.18.8","start":3018008,"end":3018008,"break":"none","ruby":[[4,1,"ちち"],[6,1,"つま"],[8,1,"おか"],[24,1,"ちち"]],"text":"あなたの父の妻を犯してはならない。それはあなたの父をはずかしめることだからである。"},{"ref":"Lev.18.9","start":3018009,"end":3018009,"break":"none","ruby":[[4,2,"しまい"],[15,1,"ちち"],[17,1,"むすめ"],[22,1,"はは"],[24,1,"むすめ"],[29,1,"いえ"],[31,1,"うま"],[40,1,"うま"],[46,1,"と"],[53,1,"おか"]],"text":"あなたの姉妹、すなわちあなたの父の娘にせよ、母の娘にせよ、家に生れたのと、よそに生れたのとを問わず、これを犯してはならない。"},{"ref":"Lev.18.10","start":3018010,"end":3018010,"break":"none","ruby":[[8,1,"むすめ"],[19,1,"むすめ"],[21,1,"むすめ"],[23,1,"おか"],[38,2,"じしん"]],"text":"あなたのむすこの娘、あるいは、あなたの娘の娘を犯してはならない。それはあなた自身をはずかしめることだからである。"},{"ref":"Lev.18.11","start":3018011,"end":3018011,"break":"none","ruby":[[4,1,"ちち"],[6,1,"つま"],[12,1,"ちち"],[17,1,"う"],[20,1,"むすめ"],[27,2,"しまい"],[38,1,"おか"]],"text":"あなたの父の妻があなたの父によって産んだ娘は、あなたの姉妹であるから、これを犯してはならない。"},{"ref":"Lev.18.12","start":3018012,"end":3018012,"break":"none","ruby":[[4,1,"ちち"],[6,2,"しまい"],[9,1,"おか"],[18,2,"かのじょ"],[25,1,"ちち"],[27,2,"にくしん"]],"text":"あなたの父の姉妹を犯してはならない。彼女はあなたの父の肉親だからである。"},{"ref":"Lev.18.13","start":3018013,"end":3018013,"break":"none","ruby":[[6,1,"はは"],[8,2,"しまい"],[11,1,"おか"],[20,2,"かのじょ"],[27,1,"はは"],[29,2,"にくしん"]],"text":"またあなたの母の姉妹を犯してはならない。彼女はあなたの母の肉親だからである。"},{"ref":"Lev.18.14","start":3018014,"end":3018014,"break":"none","ruby":[[4,1,"ちち"],[6,2,"きょうだい"],[9,1,"つま"],[11,1,"おか"],[14,1,"ちち"],[16,2,"きょうだい"],[31,2,"かのじょ"]],"text":"あなたの父の兄弟の妻を犯し、父の兄弟をはずかしめてはならない。彼女はあなたのおばだからである。"},{"ref":"Lev.18.15","start":3018015,"end":3018015,"break":"none","ruby":[[4,1,"よめ"],[6,1,"おか"],[15,2,"かのじょ"],[26,1,"つま"],[36,1,"おか"]],"text":"あなたの嫁を犯してはならない。彼女はあなたのむすこの妻であるから、これを犯してはならない。"},{"ref":"Lev.18.16","start":3018016,"end":3018016,"break":"none","ruby":[[4,2,"きょうだい"],[7,1,"つま"],[9,1,"おか"],[25,2,"きょうだい"]],"text":"あなたの兄弟の妻を犯してはならない。それはあなたの兄弟をはずかしめることだからである。"},{"ref":"Lev.18.17","start":3018017,"end":3018017,"break":"none","ruby":[[4,1,"おんな"],[8,1,"むすめ"],[11,2,"いっしょ"],[14,1,"おか"],[27,1,"おんな"],[33,1,"むすめ"],[40,1,"むすめ"],[42,1,"むすめ"],[44,1,"と"],[51,1,"おか"],[60,1,"かれ"],[67,2,"にくしん"],[78,2,"あくじ"]],"text":"あなたは女とその娘とを一緒に犯してはならない。またその女のむすこの娘、またはその娘の娘を取って、これを犯してはならない。彼らはあなたの肉親であるから、これは悪事である。"},{"ref":"Lev.18.18","start":3018018,"end":3018018,"break":"none","ruby":[[4,1,"つま"],[8,1,"い"],[18,2,"しまい"],[21,1,"と"],[25,1,"おな"],[28,1,"つま"],[36,1,"おか"]],"text":"あなたは妻のなお生きているうちにその姉妹を取って、同じく妻となし、これを犯してはならない。"},{"ref":"Lev.18.19","start":3018019,"end":3018019,"break":"paragraph","ruby":[[4,1,"つき"],[10,2,"ふじょう"],[15,1,"おんな"],[17,1,"ちか"],[25,1,"おか"]],"text":"あなたは月のさわりの不浄にある女に近づいて、これを犯してはならない。"},{"ref":"Lev.18.20","start":3018020,"end":3018020,"break":"none","ruby":[[0,1,"となり"],[2,1,"つま"],[4,1,"まじ"],[8,2,"かのじょ"],[14,1,"み"],[16,1,"けが"]],"text":"隣の妻と交わり、彼女によって身を汚してはならない。"},{"ref":"Lev.18.21","start":3018021,"end":3018021,"break":"none","ruby":[[4,1,"こ"],[28,1,"かみ"],[30,1,"な"],[32,1,"けが"],[45,1,"しゅ"]],"text":"あなたの子どもをモレクにささげてはならない。またあなたの神の名を汚してはならない。わたしは主である。"},{"ref":"Lev.18.22","start":3018022,"end":3018022,"break":"none","ruby":[[4,1,"おんな"],[6,1,"ね"],[11,1,"おとこ"],[13,1,"ね"],[24,1,"にく"]],"text":"あなたは女と寝るように男と寝てはならない。これは憎むべきことである。"},{"ref":"Lev.18.23","start":3018023,"end":3018023,"break":"none","ruby":[[4,1,"けもの"],[6,1,"まじ"],[16,1,"み"],[18,1,"けが"],[29,1,"おんな"],[31,1,"けもの"],[33,1,"まえ"],[35,1,"た"],[42,1,"まじ"],[55,1,"みち"]],"text":"あなたは獣と交わり、これによって身を汚してはならない。また女も獣の前に立って、これと交わってはならない。これは道にはずれたことである。"},{"ref":"Lev.18.24","start":3018024,"end":3018024,"break":"paragraph","ruby":[[15,1,"こと"],[20,1,"み"],[22,1,"けが"],[41,1,"まえ"],[44,1,"お"],[46,1,"はら"],[48,2,"くにぐに"],[51,1,"ひと"],[63,1,"こと"],[68,1,"けが"]],"text":"あなたがたはこれらのもろもろの事によって身を汚してはならない。わたしがあなたがたの前から追い払う国々の人は、これらのもろもろの事によって汚れ、"},{"ref":"Lev.18.25","start":3018025,"end":3018025,"break":"none","ruby":[[2,1,"ち"],[6,1,"けが"],[22,1,"あく"],[30,1,"ばっ"],[35,1,"ち"],[41,2,"じゅうみん"],[44,1,"は"],[46,1,"だ"]],"text":"その地もまた汚れている。ゆえに、わたしはその悪のためにこれを罰し、その地もまたその住民を吐き出すのである。"},{"ref":"Lev.18.26","start":3018026,"end":3018026,"break":"none","ruby":[[14,1,"さだ"],[25,1,"まも"],[37,1,"にく"],[41,1,"こと"],[47,1,"おこな"],[56,1,"くに"],[58,1,"うま"],[61,1,"もの"],[73,1,"やど"],[78,3,"きりゅうしゃ"]],"text":"ゆえに、あなたがたはわたしの定めとわたしのおきてを守り、これらのもろもろの憎むべき事の一つでも行ってはならない。国に生れた者も、あなたがたのうちに宿っている寄留者もそうである。"},{"ref":"Lev.18.27","start":3018027,"end":3018027,"break":"none","ruby":[[6,1,"さき"],[12,1,"ち"],[14,2,"ひとびと"],[27,1,"にく"],[31,1,"こと"],[33,1,"おこな"],[41,1,"ち"],[43,1,"けが"]],"text":"あなたがたの先にいたこの地の人々は、これらのもろもろの憎むべき事を行ったので、その地も汚れたからである。"},{"ref":"Lev.18.28","start":3018028,"end":3018028,"break":"none","ruby":[[12,1,"ち"],[14,1,"けが"],[20,1,"ち"],[28,1,"さき"],[32,1,"たみ"],[34,1,"は"],[36,1,"だ"],[50,1,"は"],[52,1,"だ"]],"text":"これは、あなたがたがこの地を汚して、この地があなたがたの先にいた民を吐き出したように、あなたがたをも吐き出すことのないためである。"},{"ref":"Lev.18.29","start":3018029,"end":3018029,"break":"none","ruby":[[9,1,"にく"],[13,1,"こと"],[19,1,"おこな"],[21,1,"もの"],[30,1,"おこな"],[32,1,"ひと"],[41,1,"たみ"],[47,1,"た"]],"text":"これらのもろもろの憎むべき事の一つでも行う者があれば、これを行う人は、だれでもその民のうちから断たれるであろう。"},{"ref":"Lev.18.30","start":3018030,"end":3018030,"break":"none","ruby":[[16,1,"い"],[21,1,"まも"],[24,1,"さき"],[26,1,"おこな"],[34,1,"にく"],[38,2,"ふうしゅう"],[45,1,"おこな"],[62,1,"み"],[64,1,"けが"],[83,1,"かみ"],[85,1,"しゅ"]],"text":"それゆえに、あなたがたはわたしの言いつけを守り、先に行われたこれらの憎むべき風習の一つをも行ってはならない。またこれによって身を汚してはならない。わたしはあなたがたの神、主である』」。"}]