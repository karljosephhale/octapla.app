[{"ref":"2Chr.17.1","start":14017001,"end":14017001,"break":"paragraph","ruby":[[3,1,"こ"],[13,1,"かわ"],[16,1,"おう"],[27,1,"む"],[31,2,"じぶん"],[34,1,"つよ"]],"text":"アサの子ヨシャパテがアサに代って王となり、イスラエルに向かって自分を強くし、"},{"ref":"2Chr.17.2","start":14017002,"end":14017002,"break":"none","ruby":[[7,2,"けんご"],[10,2,"まちまち"],[13,2,"ぐんたい"],[16,1,"お"],[24,1,"ち"],[30,1,"ちち"],[34,1,"と"],[43,2,"まちまち"],[46,2,"しゅび"],[48,1,"たい"],[50,1,"お"]],"text":"ユダのすべての堅固な町々に軍隊を置き、またユダの地およびその父アサが取ったエフライムの町々に守備隊を置いた。"},{"ref":"2Chr.17.3","start":14017003,"end":14017003,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"とも"],[15,1,"かれ"],[19,1,"ちち"],[24,2,"さいしょ"],[27,1,"みち"],[29,1,"あゆ"],[37,1,"もと"]],"text":"主はヨシャパテと共におられた。彼がその父ダビデの最初の道に歩んで、バアルに求めず、"},{"ref":"2Chr.17.4","start":14017004,"end":14017004,"break":"none","ruby":[[2,1,"ちち"],[4,1,"かみ"],[6,1,"もと"],[12,1,"いまし"],[15,1,"あゆ"],[24,1,"おこな"]],"text":"その父の神に求めて、その戒めに歩み、イスラエルの行いにならわなかったからである。"},{"ref":"2Chr.17.5","start":14017005,"end":14017005,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"くに"],[9,1,"かれ"],[11,1,"て"],[13,1,"かた"],[15,1,"た"],[25,2,"ひとびと"],[28,1,"みな"],[35,1,"おく"],[37,1,"もの"],[39,1,"も"],[45,1,"かれ"],[47,1,"おお"],[51,1,"とみ"],[53,1,"ほまれ"],[56,1,"え"]],"text":"それゆえ、主は国を彼の手に堅く立てられ、またユダの人々は皆ヨシャパテに贈り物を持ってきた。彼は大いなる富と誉とを得た。"},{"ref":"2Chr.17.6","start":14017006,"end":14017006,"break":"none","ruby":[[3,1,"かれ"],[5,1,"しゅ"],[7,1,"みち"],[9,1,"こころ"],[11,1,"はげ"],[18,1,"たか"],[20,1,"ところ"],[25,1,"ぞう"],[32,1,"のぞ"]],"text":"そこで彼は主の道に心を励まし、さらに高き所とアシラ像とをユダから除いた。"},{"ref":"2Chr.17.7","start":14017007,"end":14017007,"break":"paragraph","ruby":[[0,1,"かれ"],[6,2,"ちせい"],[10,1,"ねん"],[54,2,"まちまち"],[57,1,"おし"]],"text":"彼はまたその治世の三年に、つかさたちベネハイル、オバデヤ、ゼカリヤ、ネタンエルおよびミカヤをつかわしてユダの町々で教えさせ、"},{"ref":"2Chr.17.8","start":14017008,"end":14017008,"break":"none","ruby":[[2,1,"かれ"],[5,1,"とも"],[77,1,"とも"],[79,2,"さいし"]],"text":"また彼らと共にレビびとのうちからシマヤ、ネタニヤ、ゼバデヤ、アサヘル、セミラモテ、ヨナタン、アドニヤ、トビヤ、トバドニヤをつかわし、またこれらのレビびとと共に祭司エリシャマとヨラムをもつかわした。"},{"ref":"2Chr.17.9","start":14017009,"end":14017009,"break":"none","ruby":[[0,1,"かれ"],[3,1,"しゅ"],[5,2,"りっぽう"],[8,1,"しょ"],[10,1,"たずさ"],[17,1,"おしえ"],[27,2,"まちまち"],[35,2,"じゅんかい"],[40,1,"たみ"],[42,1,"あいだ"],[44,1,"おしえ"]],"text":"彼らは主の律法の書を携えて、ユダで教をなし、またユダの町々をことごとく巡回して、民の間に教をなした。"},{"ref":"2Chr.17.10","start":14017010,"end":14017010,"break":"paragraph","ruby":[[6,2,"しゅうい"],[9,2,"くにぐに"],[12,1,"みな"],[13,1,"しゅ"],[15,1,"おそ"],[24,1,"たたか"]],"text":"そこでユダの周囲の国々は皆主を恐れ、ヨシャパテと戦うことをしなかった。"},{"ref":"2Chr.17.11","start":14017011,"end":14017011,"break":"none","ruby":[[13,1,"おく"],[15,1,"もの"],[22,1,"ぎん"],[30,1,"ところ"],[32,1,"も"],[37,1,"もの"],[51,2,"おひつじ"],[57,1,"とう"],[59,1,"お"],[66,1,"とう"],[68,1,"かれ"],[70,1,"も"]],"text":"また、ペリシテびとのうちで贈り物や、みつぎの銀をヨシャパテの所に持ってくる者があり、またアラビヤびとは雄羊七千七百頭、雄やぎ七千七百頭を彼に持ってきた。"},{"ref":"2Chr.17.12","start":14017012,"end":14017012,"break":"none","ruby":[[14,1,"おお"],[23,2,"ようがい"],[28,1,"くら"],[30,1,"まち"],[32,1,"た"]],"text":"こうしてヨシャパテはますます大いになり、ユダに要害および倉の町を建て、"},{"ref":"2Chr.17.13","start":14017013,"end":14017013,"break":"none","ruby":[[3,2,"まちまち"],[6,1,"おお"],[9,2,"ぐんじゅ"],[11,1,"ひん"],[13,1,"も"],[24,1,"だい"],[25,2,"ゆうし"],[30,2,"ぐんじん"],[35,1,"も"]],"text":"ユダの町々に多くの軍需品を持ち、またエルサレムに大勇士である軍人たちを持っていた。"},{"ref":"2Chr.17.14","start":14017014,"end":14017014,"break":"none","ruby":[[0,1,"かれ"],[5,2,"しぞく"],[11,1,"かぞ"],[15,1,"つぎ"],[32,1,"で"],[35,1,"にん"],[37,1,"ちょう"],[50,1,"ぐん"],[51,1,"ちょう"],[53,1,"かれ"],[55,1,"したが"],[57,1,"だい"],[58,2,"ゆうし"],[63,1,"にん"]],"text":"彼らをその氏族によって数えれば次のとおりである。すなわちユダから出た千人の長のうちでは、アデナという軍長と彼に従う大勇士三十万人、"},{"ref":"2Chr.17.15","start":14017015,"end":14017015,"break":"none","ruby":[[2,1,"つぎ"],[4,1,"ぐん"],[5,1,"ちょう"],[11,1,"かれ"],[13,1,"したが"],[15,1,"もの"],[19,1,"まん"],[20,1,"にん"]],"text":"その次は軍長ヨハナンと彼に従う者二十八万人、"},{"ref":"2Chr.17.16","start":14017016,"end":14017016,"break":"none","ruby":[[2,1,"つぎ"],[4,1,"よろこ"],[9,1,"み"],[11,1,"しゅ"],[17,1,"もの"],[22,1,"こ"],[28,1,"かれ"],[30,1,"したが"],[32,1,"だい"],[33,2,"ゆうし"],[38,1,"にん"]],"text":"その次は喜んでその身を主にささげた者ジクリの子アマジヤと彼に従う大勇士二十万人。"},{"ref":"2Chr.17.17","start":14017017,"end":14017017,"break":"none","ruby":[[7,1,"で"],[9,1,"もの"],[23,1,"だい"],[24,2,"ゆうし"],[27,1,"かれ"],[29,1,"したが"],[31,1,"ゆみ"],[35,1,"たて"],[37,1,"も"],[39,1,"もの"],[43,1,"にん"]],"text":"ベニヤミンから出た者のうちでは、エリアダという大勇士と彼に従う弓および盾を持つ者二十万人、"},{"ref":"2Chr.17.18","start":14017018,"end":14017018,"break":"none","ruby":[[2,1,"つぎ"],[9,1,"かれ"],[11,1,"したが"],[13,1,"たたか"],[16,1,"そな"],[20,1,"もの"],[23,1,"まん"],[24,1,"にん"]],"text":"その次はヨザバデと彼に従う戦いの備えある者十八万人である。"},{"ref":"2Chr.17.19","start":14017019,"end":14017019,"break":"none","ruby":[[4,1,"みな"],[5,1,"おう"],[7,1,"つか"],[10,1,"もの"],[24,2,"ぜんこく"],[27,2,"けんご"],[30,2,"まちまち"],[34,1,"おう"],[36,2,"ちゅうざい"],[41,1,"もの"]],"text":"これらは皆王に仕える者たちで、このほかにまたユダ全国の堅固な町々に、王が駐在させた者があった。"}]