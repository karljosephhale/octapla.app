[{"ref":"Esth.6.1","start":17006001,"end":17006001,"break":"paragraph","ruby":[[2,1,"よる"],[4,1,"おう"],[6,1,"ねむ"],[20,1,"めい"],[23,2,"ひび"],[26,1,"こと"],[32,2,"きろく"],[35,1,"しょ"],[37,1,"も"],[44,1,"おう"],[46,1,"まえ"],[48,1,"よ"]],"text":"その夜、王は眠ることができなかったので、命じて日々の事をしるした記録の書を持ってこさせ、王の前で読ませたが、"},{"ref":"Esth.6.2","start":17006002,"end":17006002,"break":"none","ruby":[[2,1,"なか"],[14,1,"おう"],[16,2,"じじゅう"],[20,1,"おう"],[25,1,"と"],[27,1,"まも"],[29,1,"もの"],[55,1,"おう"],[57,1,"ころ"],[70,1,"つ"],[84,1,"み"]],"text":"その中に、モルデカイがかつて王の侍従で、王のへやの戸を守る者のうちのビグタナとテレシのふたりが、アハシュエロス王を殺そうとねらっていることを告げた、としるされているのを見いだした。"},{"ref":"Esth.6.3","start":17006003,"end":17006003,"break":"none","ruby":[[3,1,"おう"],[5,1,"い"],[12,1,"こと"],[21,2,"えいよ"],[24,2,"しゃくい"],[33,1,"あた"],[39,1,"おう"],[41,1,"つか"],[44,2,"じしん"],[49,1,"い"],[54,1,"なに"],[56,1,"かれ"],[58,1,"あた"]],"text":"そこで王は言った、「この事のために、どんな栄誉と爵位をモルデカイに与えたか」。王に仕える侍臣たちは言った、「何も彼に与えていません」。"},{"ref":"Esth.6.4","start":17006004,"end":17006004,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[7,1,"にわ"],[20,1,"とき"],[34,1,"もう"],[37,1,"き"],[45,1,"か"],[51,1,"おう"],[53,1,"もう"],[55,1,"あ"],[60,2,"おうきゅう"],[63,1,"そと"],[64,1,"にわ"]],"text":"王は言った、「庭にいるのはだれか」。この時ハマンはモルデカイのために設けた木にモルデカイを掛けることを王に申し上げようと王宮の外庭にはいってきていた。"},{"ref":"Esth.6.5","start":17006005,"end":17006005,"break":"none","ruby":[[0,1,"おう"],[2,2,"じしん"],[12,1,"にわ"],[14,1,"た"],[22,1,"おう"],[24,1,"い"],[30,1,"おう"],[44,1,"い"]],"text":"王の侍臣たちが「ハマンが庭に立っています」と王に言ったので、王は「ここへ、はいらせよ」と言った。"},{"ref":"Esth.6.6","start":17006006,"end":17006006,"break":"none","ruby":[[11,1,"く"],[14,1,"おう"],[16,1,"い"],[21,1,"おう"],[23,2,"えいよ"],[26,1,"あた"],[31,1,"おも"],[33,1,"ひと"],[52,1,"こころ"],[57,1,"い"],[62,1,"おう"],[67,2,"いがい"],[73,2,"えいよ"],[76,1,"あた"],[81,1,"おも"]],"text":"やがてハマンがはいって来ると王は言った、「王が栄誉を与えようと思う人にはどうしたらよかろうか」。ハマンは心のうちに言った、「王はわたし以外にだれに栄誉を与えようと思われるだろうか」。"},{"ref":"Esth.6.7","start":17006007,"end":17006007,"break":"none","ruby":[[4,1,"おう"],[6,1,"い"],[11,1,"おう"],[13,2,"えいよ"],[16,1,"あた"],[21,1,"おも"],[25,1,"ひと"]],"text":"ハマンは王に言った、「王が栄誉を与えようと思われる人のためには、"},{"ref":"Esth.6.8","start":17006008,"end":17006008,"break":"none","ruby":[[0,1,"おう"],[2,1,"き"],[6,2,"いふく"],[9,1,"も"],[18,1,"おう"],[20,1,"の"],[24,1,"うま"],[32,1,"あたま"],[34,2,"おうかん"],[42,1,"うま"]],"text":"王の着られた衣服を持ってこさせ、また王の乗られた馬、すなわちその頭に王冠をいただいた馬をひいてこさせ、"},{"ref":"Esth.6.9","start":17006009,"end":17006009,"break":"none","ruby":[[2,2,"いふく"],[5,1,"うま"],[8,1,"おう"],[10,1,"もっと"],[12,1,"たっと"],[14,2,"だいじん"],[21,1,"て"],[28,1,"おう"],[30,2,"えいよ"],[33,1,"あた"],[38,1,"おも"],[42,1,"ひと"],[46,2,"いふく"],[49,1,"き"],[57,1,"ひと"],[59,1,"うま"],[61,1,"の"],[64,1,"まち"],[66,2,"ひろば"],[69,1,"みちび"],[72,1,"とお"],[77,1,"おう"],[79,2,"えいよ"],[82,1,"あた"],[87,1,"おも"],[89,1,"ひと"],[102,1,"まえ"],[104,1,"よ"]],"text":"その衣服と馬とを王の最も尊い大臣のひとりの手にわたして、王が栄誉を与えようと思われる人にその衣服を着させ、またその人を馬に乗せ、町の広場を導いて通らせ、『王が栄誉を与えようと思う人にはこうするのだ』とその前に呼ばわらせなさい」。"},{"ref":"Esth.6.10","start":17006010,"end":17006010,"break":"none","ruby":[[3,1,"おう"],[9,1,"い"],[14,1,"いそ"],[21,1,"い"],[30,2,"いふく"],[33,1,"うま"],[36,1,"と"],[38,1,"よ"],[41,1,"おう"],[43,1,"もん"],[45,1,"ざ"],[53,1,"ひと"],[71,1,"い"],[80,1,"か"]],"text":"それで王はハマンに言った、「急いであなたが言ったように、その衣服と馬とを取り寄せ、王の門に座しているユダヤ人モルデカイにそうしなさい。あなたが言ったことを一つも欠いてはならない」。"},{"ref":"Esth.6.11","start":17006011,"end":17006011,"break":"none","ruby":[[7,2,"いふく"],[10,1,"うま"],[13,1,"と"],[15,1,"よ"],[26,2,"いふく"],[29,1,"き"],[32,1,"かれ"],[34,1,"うま"],[36,1,"の"],[39,1,"まち"],[41,2,"ひろば"],[44,1,"とお"],[50,1,"まえ"],[52,1,"よ"],[59,1,"おう"],[61,2,"えいよ"],[64,1,"あた"],[69,1,"おも"],[71,1,"ひと"],[82,1,"い"]],"text":"そこでハマンは衣服と馬とを取り寄せ、モルデカイにその衣服を着せ、彼を馬に乗せて町の広場を通らせ、その前に呼ばわって、「王が栄誉を与えようと思う人にはこうするのだ」と言った。"},{"ref":"Esth.6.12","start":17006012,"end":17006012,"break":"paragraph","ruby":[[10,1,"おう"],[12,1,"もん"],[14,1,"かえ"],[25,1,"うれ"],[27,1,"なや"],[30,1,"とう"],[36,1,"いそ"],[39,1,"いえ"],[41,1,"かえ"]],"text":"こうしてモルデカイは王の門に帰ってきたが、ハマンは憂え悩み、頭をおおって急いで家に帰った。"},{"ref":"Esth.6.13","start":17006013,"end":17006013,"break":"none","ruby":[[7,2,"じぶん"],[10,1,"み"],[12,1,"た"],[15,1,"こと"],[24,1,"つま"],[29,1,"とも"],[33,1,"つ"],[42,2,"ちしゃ"],[49,1,"つま"],[54,1,"かれ"],[56,1,"い"],[79,1,"ひと"],[81,1,"まえ"],[83,1,"やぶ"],[85,1,"はじ"],[88,1,"もの"],[96,1,"じん"],[98,2,"しそん"],[111,1,"かれ"],[113,1,"か"],[123,1,"かなら"],[125,1,"かれ"],[127,1,"まえ"],[129,1,"やぶ"]],"text":"そしてハマンは自分の身に起った事をことごとくその妻ゼレシと友だちに告げた。するとその知者たちおよび妻ゼレシは彼に言った、「あのモルデカイ、すなわちあなたがその人の前に敗れ始めた者が、もしユダヤ人の子孫であるならば、あなたは彼に勝つことはできない。必ず彼の前に敗れるでしょう」。"},{"ref":"Esth.6.14","start":17006014,"end":17006014,"break":"paragraph","ruby":[[0,1,"かれ"],[9,1,"はな"],[14,1,"とき"],[16,1,"おう"],[18,2,"じじゅう"],[29,1,"うなが"],[37,1,"もう"],[40,2,"しゅえん"],[43,1,"のぞ"]],"text":"彼らがなおハマンと話している時、王の侍従たちがきてハマンを促し、エステルが設けた酒宴に臨ませた。"}]