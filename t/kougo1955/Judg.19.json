[{"ref":"Judg.19.1","start":7019001,"end":7019001,"break":"paragraph","ruby":[[11,1,"おう"],[17,1,"とき"],[25,2,"さんち"],[28,1,"おく"],[39,2,"きりゅう"],[46,1,"かれ"],[62,1,"おんな"],[64,1,"むか"]],"text":"そのころ、イスラエルに王がなかった時、エフライムの山地の奥にひとりのレビびとが寄留していた。彼はユダのベツレヘムからひとりの女を迎えて、めかけとしていたが、"},{"ref":"Judg.19.2","start":7019002,"end":7019002,"break":"none","ruby":[[6,1,"いか"],[10,1,"かれ"],[16,1,"さ"],[28,1,"ちち"],[30,1,"いえ"],[32,1,"かえ"],[41,1,"げつ"],[45,1,"す"]],"text":"そのめかけは怒って、彼のところを去り、ユダのベツレヘムの父の家に帰って、そこに四か月ばかり過ごした。"},{"ref":"Judg.19.3","start":7019003,"end":7019003,"break":"none","ruby":[[3,1,"おっと"],[5,2,"かのじょ"],[12,1,"つ"],[14,1,"かえ"],[24,1,"とう"],[29,1,"したが"],[32,1,"た"],[35,2,"かのじょ"],[41,1,"お"],[44,1,"い"],[48,1,"かれ"],[50,1,"おんな"],[52,1,"ちち"],[54,1,"いえ"],[56,1,"つ"],[59,1,"とき"],[61,1,"むすめ"],[63,1,"ちち"],[65,1,"かれ"],[67,1,"み"],[70,1,"よろこ"],[73,1,"むか"]],"text":"そこで夫は彼女をなだめて連れ帰ろうと、しもべと二頭のろばを従え、立って彼女のあとを追って行った。彼が女の父の家に着いた時、娘の父は彼を見て、喜んで迎えた。"},{"ref":"Judg.19.4","start":7019004,"end":7019004,"break":"none","ruby":[[0,1,"むすめ"],[2,1,"ちち"],[11,1,"ひ"],[13,1,"と"],[19,1,"かれ"],[22,1,"か"],[23,1,"とも"],[30,1,"の"],[32,1,"く"],[39,1,"やど"]],"text":"娘の父であるしゅうとが引き留めたので、彼は三日共におり、みな飲み食いしてそこに宿った。"},{"ref":"Judg.19.5","start":7019005,"end":7019005,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[4,1,"かれ"],[7,1,"あさ"],[11,1,"お"],[14,1,"かれ"],[16,1,"た"],[18,1,"さ"],[27,1,"むすめ"],[29,1,"ちち"],[31,1,"むこ"],[33,1,"い"],[38,1,"すこ"],[40,2,"しょくじ"],[45,2,"げんき"],[55,1,"で"]],"text":"四日目に彼らは朝はやく起き、彼が立ち去ろうとしたので、娘の父は婿に言った、「少し食事をして元気をつけ、それから出かけなさい」。"},{"ref":"Judg.19.6","start":7019006,"end":7019006,"break":"none","ruby":[[7,1,"ざ"],[10,1,"とも"],[12,1,"の"],[14,1,"く"],[20,1,"むすめ"],[22,1,"ちち"],[26,1,"ひと"],[28,1,"い"],[38,2,"ひとばん"],[40,1,"と"],[44,1,"たの"],[47,1,"す"]],"text":"そこでふたりは座して共に飲み食いしたが、娘の父はその人に言った、「どうぞもう一晩泊まって楽しく過ごしなさい」。"},{"ref":"Judg.19.7","start":7019007,"end":7019007,"break":"none","ruby":[[2,1,"ひと"],[4,1,"た"],[7,1,"さ"],[34,1,"やど"]],"text":"その人は立って去ろうとしたが、しゅうとがしいたので、ついにまたそこに宿った。"},{"ref":"Judg.19.8","start":7019008,"end":7019008,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[8,1,"あさ"],[12,1,"お"],[15,1,"さ"],[23,1,"むすめ"],[25,1,"ちち"],[27,1,"い"],[36,2,"げんき"],[43,1,"ひ"],[45,1,"かたむ"],[61,1,"かれ"],[67,2,"しょくじ"]],"text":"五日目になって、朝はやく起きて去ろうとしたが、娘の父は言った、「どうぞ、元気をつけて、日が傾くまでとどまりなさい」。そこで彼らふたりは食事をした。"},{"ref":"Judg.19.9","start":7019009,"end":7019009,"break":"none","ruby":[[2,1,"ひと"],[17,1,"とも"],[19,1,"さ"],[25,1,"た"],[34,1,"むすめ"],[36,1,"ちち"],[45,1,"かれ"],[47,1,"い"],[52,1,"ひ"],[54,1,"く"],[70,1,"ばん"],[71,1,"と"],[78,1,"ひ"],[80,1,"かたむ"],[87,1,"やど"],[90,1,"たの"],[93,1,"す"],[107,1,"あさ"],[111,1,"お"],[114,2,"しゅったつ"],[118,1,"いえ"],[120,1,"かえ"]],"text":"その人がついにめかけおよびしもべと共に去ろうとして立ちあがったとき、娘の父であるしゅうとは彼に言った、「日も暮れようとしている。どうぞもう一晩泊まりなさい。日は傾いた。ここに宿って楽しく過ごしなさい。そしてあしたの朝はやく起きて出立し、家に帰りなさい」。"},{"ref":"Judg.19.10","start":7019010,"end":7019010,"break":"paragraph","ruby":[[6,1,"ひと"],[8,1,"と"],[14,1,"この"],[21,1,"た"],[24,1,"さ"],[40,1,"む"],[44,1,"つ"],[55,1,"とう"],[60,1,"かれ"],[66,2,"いっしょ"]],"text":"しかし、その人は泊まることを好まないので、立って去り、エブスすなわちエルサレムの向かいに着いた。くらをおいた二頭のろばと彼のめかけも一緒であった。"},{"ref":"Judg.19.11","start":7019011,"end":7019011,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ちか"],[14,1,"ひ"],[19,1,"ぼっ"],[29,2,"しゅじん"],[32,1,"い"],[45,1,"みち"],[47,1,"てん"],[58,1,"まち"],[68,1,"やど"]],"text":"彼らがエブスに近づいたとき、日はすでに没したので、しもべは主人に言った、「さあ、われわれは道を転じてエブスびとのこの町にはいって、そこに宿りましょう」。"},{"ref":"Judg.19.12","start":7019012,"end":7019012,"break":"none","ruby":[[0,2,"しゅじん"],[3,1,"かれ"],[5,1,"い"],[15,1,"みち"],[17,1,"てん"],[27,2,"ひとびと"],[30,1,"まち"],[34,2,"がいこく"],[36,1,"じん"],[38,1,"まち"],[56,1,"い"]],"text":"主人は彼に言った、「われわれは道を転じて、イスラエルの人々の町でない外国人の町に、はいってはならない。ギベアまで行こう」。"},{"ref":"Judg.19.13","start":7019013,"end":7019013,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[37,1,"つ"],[43,1,"やど"]],"text":"彼はまたしもべに言った、「さあ、われわれはギベアかラマか、そのうちの一つに着いてそこに宿ろう」。"},{"ref":"Judg.19.14","start":7019014,"end":7019014,"break":"none","ruby":[[0,1,"かれ"],[3,1,"すす"],[6,1,"い"],[17,1,"ぞく"],[24,1,"ちか"],[27,1,"ひ"],[29,1,"く"]],"text":"彼らは進んで行ったが、ベニヤミンに属するギベアの近くで日が暮れたので、"},{"ref":"Judg.19.15","start":7019015,"end":7019015,"break":"none","ruby":[[4,1,"い"],[7,1,"やど"],[15,1,"みち"],[17,1,"てん"],[20,1,"まち"],[29,2,"ひろば"],[32,1,"ざ"],[39,1,"かれ"],[42,1,"いえ"],[44,1,"むか"],[47,1,"と"],[53,1,"もの"]],"text":"ギベアへ行って宿ろうと、そこに道を転じ、町にはいって、その広場に座した。だれも彼らを家に迎えて泊めてくれる者がなかったからである。"},{"ref":"Judg.19.16","start":7019016,"end":7019016,"break":"paragraph","ruby":[[0,1,"とき"],[6,2,"ろうじん"],[9,2,"ゆうぐれ"],[12,1,"はたけ"],[14,2,"しごと"],[18,1,"かえ"],[26,1,"ひと"],[34,2,"さんち"],[37,1,"もの"],[44,2,"きりゅう"],[60,1,"ところ"],[62,2,"ひとびと"]],"text":"時にひとりの老人が夕暮に畑の仕事から帰ってきた。この人はエフライムの山地の者で、ギベアに寄留していたのである。ただしこの所の人々はベニヤミンびとであった。"},{"ref":"Judg.19.17","start":7019017,"end":7019017,"break":"none","ruby":[[0,1,"かれ"],[2,1,"め"],[8,1,"まち"],[10,2,"ひろば"],[13,2,"たびびと"],[20,1,"み"],[23,2,"ろうじん"],[26,1,"い"],[38,1,"い"]],"text":"彼は目をあげて、町の広場に旅人のおるのを見た。老人は言った、「あなたはどこへ行かれるのですか。どこからおいでになりましたか」。"},{"ref":"Judg.19.18","start":7019018,"end":7019018,"break":"none","ruby":[[2,1,"ひと"],[4,1,"い"],[31,2,"さんち"],[34,1,"おく"],[36,1,"い"],[51,1,"もの"],[63,1,"い"],[66,1,"いま"],[71,1,"いえ"],[73,1,"かえ"],[89,1,"いえ"],[91,1,"と"],[97,1,"もの"]],"text":"その人は言った、「われわれはユダのベツレヘムから、エフライムの山地の奥へ行くものです。わたしはあそこの者で、ユダのベツレヘムへ行き、今わたしの家に帰るところですが、だれもわたしを家に泊めてくれる者がありません。"},{"ref":"Judg.19.19","start":7019019,"end":7019019,"break":"none","ruby":[[13,2,"かいば"],[36,1,"とも"],[40,2,"わかもの"],[44,2,"しょくもつ"],[47,1,"さけ"],[53,1,"なに"],[55,1,"か"]],"text":"われわれには、ろばのわらも飼葉もあり、またわたしと、はしためと、しもべと共にいる若者との食物も酒もあって、何も欠けているものはありません」。"},{"ref":"Judg.19.20","start":7019020,"end":7019020,"break":"none","ruby":[[0,2,"ろうじん"],[3,1,"い"],[8,2,"あんしん"],[19,2,"ひつよう"],[29,1,"そな"],[38,2,"ひろば"],[41,1,"よる"],[43,1,"す"]],"text":"老人は言った、「安心しなさい。あなたの必要なものはなんでも備えましょう。ただ広場で夜を過ごしてはなりません」。"},{"ref":"Judg.19.21","start":7019021,"end":7019021,"break":"none","ruby":[[3,1,"かれ"],[5,1,"いえ"],[7,1,"つ"],[17,2,"かいば"],[20,1,"あた"],[24,1,"かれ"],[27,1,"あし"],[29,1,"あら"],[32,1,"の"],[34,1,"く"]],"text":"そして彼を家に連れていって、ろばに飼葉を与えた。彼らは足を洗って飲み食いした。"},{"ref":"Judg.19.22","start":7019022,"end":7019022,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"たの"],[6,1,"す"],[12,1,"とき"],[14,1,"まち"],[16,2,"ひとびと"],[19,1,"わる"],[21,1,"もの"],[27,1,"いえ"],[29,1,"と"],[31,1,"かこ"],[34,1,"と"],[36,1,"う"],[43,1,"いえ"],[51,2,"ろうじん"],[54,1,"い"],[63,1,"いえ"],[67,1,"ひと"],[69,1,"だ"],[82,1,"もの"],[84,1,"し"]],"text":"彼らが楽しく過ごしていた時、町の人々の悪い者どもがその家を取り囲み、戸を打ちたたいて、家のあるじである老人に言った、「あなたの家にきた人を出しなさい。われわれはその者を知るであろう」。"},{"ref":"Judg.19.23","start":7019023,"end":7019023,"break":"none","ruby":[[3,1,"いえ"],[9,1,"かれ"],[16,1,"で"],[21,1,"い"],[30,2,"きょうだい"],[43,1,"わる"],[59,1,"ひと"],[68,1,"いえ"],[87,1,"こと"]],"text":"しかし家のあるじは彼らのところに出ていって言った、「いいえ、兄弟たちよ、どうぞ、そんな悪いことをしないでください。この人はすでにわたしの家にはいったのだから、そんなつまらない事をしないでください。"},{"ref":"Judg.19.24","start":7019024,"end":7019024,"break":"none","ruby":[[3,2,"しょじょ"],[12,1,"むすめ"],[17,1,"ひと"],[27,1,"いま"],[31,1,"だ"],[53,1,"す"],[69,1,"ひと"],[82,1,"こと"]],"text":"ここに処女であるわたしの娘と、この人のめかけがいます。今それを出しますから、それをはずかしめ、あなたがたの好きなようにしなさい。しかしこの人にはそのようなつまらない事をしないでください」。"},{"ref":"Judg.19.25","start":7019025,"end":7019025,"break":"none","ruby":[[3,2,"ひとびと"],[6,1,"き"],[19,1,"ひと"],[21,2,"じぶん"],[31,1,"かれ"],[38,1,"だ"],[42,1,"かれ"],[47,1,"おんな"],[49,1,"おか"],[52,1,"あさ"],[55,2,"しゅうや"],[63,1,"ひ"],[74,1,"はな"],[76,1,"かえ"]],"text":"しかし人々が聞きいれなかったので、その人は自分のめかけをとって彼らのところに出した。彼らはその女を犯して朝まで終夜はずかしめ、日ののぼるころになって放し帰らせた。"},{"ref":"Judg.19.26","start":7019026,"end":7019026,"break":"none","ruby":[[0,1,"あさ"],[5,1,"おんな"],[7,2,"じぶん"],[10,2,"しゅじん"],[13,1,"やど"],[19,1,"ひと"],[21,1,"いえ"],[23,2,"とぐち"],[28,1,"たお"],[30,1,"ふ"],[33,1,"よる"],[41,1,"およ"]],"text":"朝になって女は自分の主人を宿してくれた人の家の戸口にきて倒れ伏し、夜のあけるまでに及んだ。"},{"ref":"Judg.19.27","start":7019027,"end":7019027,"break":"paragraph","ruby":[[0,2,"かのじょ"],[3,2,"しゅじん"],[6,1,"あさ"],[7,1,"お"],[10,1,"いえ"],[12,1,"と"],[14,1,"ひら"],[17,1,"で"],[19,2,"たびだ"],[36,1,"おんな"],[38,1,"いえ"],[40,2,"とぐち"],[44,1,"て"],[46,2,"しきい"],[52,1,"たお"]],"text":"彼女の主人は朝起きて家の戸を開き、出て旅立とうとすると、そのめかけである女が家の戸口に、手を敷居にかけて倒れていた。"},{"ref":"Judg.19.28","start":7019028,"end":7019028,"break":"none","ruby":[[0,1,"かれ"],[2,1,"おんな"],[4,1,"む"],[10,1,"お"],[14,1,"い"],[19,1,"い"],[30,1,"こたえ"],[42,1,"ひと"],[44,1,"おんな"],[49,1,"の"],[52,1,"た"],[55,2,"じぶん"],[58,1,"いえ"]],"text":"彼は女に向かって、「起きよ、行こう」と言ったけれども、なんの答もなかった。そこでその人は女をろばに乗せ、立って自分の家におもむいたが、"},{"ref":"Judg.19.29","start":7019029,"end":7019029,"break":"none","ruby":[[2,1,"いえ"],[4,1,"つ"],[10,1,"かたな"],[12,1,"と"],[19,1,"とら"],[31,1,"き"],[34,1,"た"],[36,1,"き"],[48,1,"ぜん"],[49,2,"りょういき"],[56,1,"おく"]],"text":"その家に着いたとき、刀を執り、めかけを捕えて、そのからだを十二切れに断ち切り、それをイスラエルの全領域にあまねく送った。"},{"ref":"Judg.19.30","start":7019030,"end":7019030,"break":"none","ruby":[[3,1,"み"],[10,1,"い"],[21,2,"ひとびと"],[29,1,"ち"],[32,1,"のぼ"],[37,1,"ひ"],[40,2,"こんにち"],[50,1,"こと"],[52,1,"た"],[63,1,"み"],[73,1,"こと"],[77,1,"かんが"],[80,2,"きょうぎ"],[84,1,"い"],[89,1,"き"]],"text":"それを見たものはみな言った、「イスラエルの人々がエジプトの地から上ってきた日から今日まで、このような事は起ったこともなく、また見たこともない。この事をよく考え、協議して言うことを決めよ」。"}]