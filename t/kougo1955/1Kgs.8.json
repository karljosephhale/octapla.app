[{"ref":"1Kgs.8.1","start":11008001,"end":11008001,"break":"paragraph","ruby":[[5,1,"しゅ"],[7,2,"けいやく"],[10,1,"はこ"],[16,1,"まち"],[30,1,"のぼ"],[43,2,"ちょうろう"],[53,2,"ぶぞく"],[69,2,"ひとびと"],[72,2,"しぞく"],[75,1,"ちょう"],[89,1,"おう"],[94,1,"め"],[96,1,"あつ"]],"text":"ソロモンは主の契約の箱をダビデの町、すなわちシオンからかつぎ上ろうとして、イスラエルの長老たちと、すべての部族のかしらたちと、イスラエルの人々の氏族の長たちをエルサレムでソロモン王のもとに召し集めた。"},{"ref":"1Kgs.8.2","start":11008002,"end":11008002,"break":"none","ruby":[[6,1,"ひと"],[8,1,"みな"],[14,1,"つき"],[20,1,"がつ"],[22,1,"まつり"],[28,1,"おう"],[33,1,"あつ"]],"text":"イスラエルの人は皆エタニムの月すなわち七月の祭にソロモン王のもとに集まった。"},{"ref":"1Kgs.8.3","start":11008003,"end":11008003,"break":"none","ruby":[[6,2,"ちょうろう"],[11,1,"みな"],[12,1,"き"],[17,2,"さいし"],[22,1,"はこ"],[24,1,"と"]],"text":"イスラエルの長老たちが皆来たので、祭司たちは箱を取りあげた。"},{"ref":"1Kgs.8.4","start":11008004,"end":11008004,"break":"none","ruby":[[3,1,"かれ"],[6,1,"しゅ"],[8,1,"はこ"],[11,2,"かいけん"],[14,2,"まくや"],[18,2,"まくや"],[27,1,"せい"],[30,1,"うつわ"],[35,1,"のぼ"],[43,2,"さいし"],[55,1,"もの"],[60,1,"のぼ"]],"text":"そして彼らは主の箱と、会見の幕屋と、幕屋にあるすべての聖なる器をかつぎ上った。すなわち祭司とレビびとがこれらの物をかつぎ上った。"},{"ref":"1Kgs.8.5","start":11008005,"end":11008005,"break":"none","ruby":[[4,1,"おう"],[8,1,"かれ"],[13,1,"あつ"],[23,2,"かいしゅう"],[26,1,"みな"],[27,1,"かれ"],[29,1,"とも"],[31,1,"はこ"],[33,1,"まえ"],[36,1,"ひつじ"],[38,1,"うし"],[48,1,"かず"],[50,1,"おお"],[53,1,"しら"],[59,1,"かぞ"]],"text":"ソロモン王および彼のもとに集まったイスラエルの会衆は皆彼と共に箱の前で、羊と牛をささげたが、その数が多くて調べることも数えることもできなかった。"},{"ref":"1Kgs.8.6","start":11008006,"end":11008006,"break":"none","ruby":[[0,2,"さいし"],[5,1,"しゅ"],[7,2,"けいやく"],[10,1,"はこ"],[14,2,"ばしょ"],[20,1,"い"],[28,1,"みや"],[30,2,"ほんでん"],[35,3,"しせいじょ"],[47,1,"つばさ"],[49,1,"した"],[51,1,"お"]],"text":"祭司たちは主の契約の箱をその場所にかつぎ入れた。すなわち宮の本殿である至聖所のうちのケルビムの翼の下に置いた。"},{"ref":"1Kgs.8.7","start":11008007,"end":11008007,"break":"none","ruby":[[5,1,"つばさ"],[7,1,"はこ"],[9,1,"ところ"],[11,1,"の"],[24,1,"うえ"],[27,1,"はこ"]],"text":"ケルビムは翼を箱の所に伸べていたので、ケルビムは上から箱とそのさおをおおった。"},{"ref":"1Kgs.8.8","start":11008008,"end":11008008,"break":"none","ruby":[[3,1,"なが"],[13,1,"はし"],[15,2,"ほんでん"],[18,1,"まえ"],[20,2,"せいじょ"],[24,1,"み"],[31,1,"そと"],[34,1,"み"],[46,2,"こんにち"]],"text":"さおは長かったので、さおの端が本殿の前の聖所から見えた。しかし外には見えなかった。そのさおは今日までそこにある。"},{"ref":"1Kgs.8.9","start":11008009,"end":11008009,"break":"none","ruby":[[0,1,"はこ"],[2,1,"うち"],[8,1,"いし"],[10,1,"いた"],[14,1,"なに"],[30,2,"ひとびと"],[38,1,"ち"],[41,1,"で"],[46,1,"しゅ"],[48,1,"かれ"],[51,2,"けいやく"],[54,1,"むす"],[74,1,"おさ"]],"text":"箱の内には二つの石の板のほか何もなかった。これはイスラエルの人々がエジプトの地から出たとき、主が彼らと契約を結ばれたときに、モーセがホレブで、それに納めたものである。"},{"ref":"1Kgs.8.10","start":11008010,"end":11008010,"break":"none","ruby":[[3,2,"さいし"],[8,2,"せいじょ"],[12,1,"で"],[17,1,"くも"],[19,1,"しゅ"],[21,1,"みや"],[23,1,"み"]],"text":"そして祭司たちが聖所から出たとき、雲が主の宮に満ちたので、"},{"ref":"1Kgs.8.11","start":11008011,"end":11008011,"break":"none","ruby":[[0,2,"さいし"],[5,1,"くも"],[10,1,"た"],[13,1,"つか"],[26,1,"しゅ"],[28,2,"えいこう"],[31,1,"しゅ"],[33,1,"みや"],[35,1,"み"]],"text":"祭司たちは雲のために立って仕えることができなかった。主の栄光が主の宮に満ちたからである。"},{"ref":"1Kgs.8.12","start":11008012,"end":11008012,"break":"paragraph","breaks":[[12,"stanza"],[24,"line"]],"ruby":[[8,1,"い"],[13,1,"しゅ"],[15,1,"ひ"],[17,1,"てん"],[19,1,"お"],[27,1,"しゅ"],[29,1,"みずか"],[31,1,"こ"],[33,1,"くも"],[35,1,"なか"],[37,1,"す"],[42,1,"い"]],"text":"そこでソロモンは言った、「主は日を天に置かれた。しかも主は自ら濃き雲の中に住まおうと言われた。"},{"ref":"1Kgs.8.13","start":11008013,"end":11008013,"break":"line","breaks":[[15,"line"]],"ruby":[[11,1,"たか"],[13,1,"いえ"],[25,1,"た"]],"text":"わたしはあなたのために高き家、とこしえのみすまいを建てた」。"},{"ref":"1Kgs.8.14","start":11008014,"end":11008014,"break":"none","ruby":[[0,1,"おう"],[2,1,"み"],[20,2,"かいしゅう"],[23,2,"しゅくふく"],[30,1,"とき"],[41,2,"かいしゅう"],[44,1,"た"]],"text":"王は身をめぐらして、イスラエルのすべての会衆を祝福した。その時イスラエルのすべての会衆は立っていた。"},{"ref":"1Kgs.8.15","start":11008015,"end":11008015,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[13,1,"かみ"],[15,1,"しゅ"],[24,1,"しゅ"],[28,1,"くち"],[37,1,"ちち"],[42,2,"やくそく"],[53,1,"て"],[60,1,"と"],[66,1,"しゅ"],[68,1,"い"]],"text":"彼は言った、「イスラエルの神、主はほむべきかな。主はその口をもってわたしの父ダビデに約束されたことを、その手をもってなし遂げられた。主は言われた、"},{"ref":"1Kgs.8.16","start":11008016,"end":11008016,"break":"none","ruby":[[3,1,"たみ"],[16,1,"みちび"],[18,1,"だ"],[21,1,"ひ"],[33,1,"な"],[35,1,"お"],[39,1,"みや"],[41,1,"た"],[59,2,"ぶぞく"],[69,1,"まち"],[72,1,"えら"],[89,1,"えら"],[95,1,"たみ"],[102,1,"うえ"],[104,1,"た"]],"text":"『わが民イスラエルをエジプトから導き出した日から、わたしはわたしの名を置くべき宮を建てるために、イスラエルのもろもろの部族のうちから、どの町をも選んだことがなかった。ただダビデを選んで、わが民イスラエルの上に立たせた』と。"},{"ref":"1Kgs.8.17","start":11008017,"end":11008017,"break":"none","ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"な"],[15,1,"みや"],[17,1,"た"],[28,1,"ちち"],[33,1,"こころ"]],"text":"イスラエルの神、主の名のために宮を建てることは、わたしの父ダビデの心にあった。"},{"ref":"1Kgs.8.18","start":11008018,"end":11008018,"break":"none","ruby":[[3,1,"しゅ"],[9,1,"ちち"],[14,1,"い"],[24,1,"な"],[29,1,"みや"],[31,1,"た"],[41,1,"こころ"],[51,1,"こころ"],[55,1,"こと"],[62,2,"けっこう"]],"text":"しかし主はわたしの父ダビデに言われた、『わたしの名のために宮を建てることはあなたの心にあった。あなたの心にこの事のあったのは結構である。"},{"ref":"1Kgs.8.19","start":11008019,"end":11008019,"break":"none","ruby":[[10,1,"みや"],[12,1,"た"],[25,1,"み"],[28,1,"で"],[34,1,"こ"],[40,1,"な"],[45,1,"みや"],[47,1,"た"]],"text":"けれどもあなたはその宮を建ててはならない。あなたの身から出るあなたの子がわたしの名のために宮を建てるであろう』と。"},{"ref":"1Kgs.8.20","start":11008020,"end":11008020,"break":"none","ruby":[[3,1,"しゅ"],[7,1,"い"],[11,2,"ことば"],[14,1,"おこな"],[27,1,"ちち"],[32,1,"かわ"],[35,1,"た"],[38,1,"しゅ"],[40,1,"い"],[54,1,"くらい"],[56,1,"ざ"],[65,1,"かみ"],[67,1,"しゅ"],[69,1,"な"],[74,1,"みや"],[76,1,"た"]],"text":"そして主はその言われた言葉を行われた。すなわちわたしは父ダビデに代って立ち、主が言われたように、イスラエルの位に座し、イスラエルの神、主の名のために宮を建てた。"},{"ref":"1Kgs.8.21","start":11008021,"end":11008021,"break":"none","ruby":[[9,1,"しゅ"],[11,2,"けいやく"],[14,1,"おさ"],[17,1,"はこ"],[25,2,"ばしょ"],[28,1,"もう"],[34,2,"けいやく"],[37,1,"しゅ"],[44,2,"せんぞ"],[52,1,"ち"],[55,1,"みちび"],[57,1,"だ"],[61,1,"とき"],[64,1,"かれ"],[67,1,"むす"]],"text":"わたしはまたそこに主の契約を納めた箱のために一つの場所を設けた。その契約は主がわれわれの先祖をエジプトの地から導き出された時に、彼らと結ばれたものである」。"},{"ref":"1Kgs.8.22","start":11008022,"end":11008022,"break":"paragraph","ruby":[[11,1,"ぜん"],[12,2,"かいしゅう"],[15,1,"まえ"],[18,1,"しゅ"],[20,2,"さいだん"],[23,1,"まえ"],[25,1,"た"],[28,1,"て"],[30,1,"てん"],[32,1,"の"]],"text":"ソロモンはイスラエルの全会衆の前で、主の祭壇の前に立ち、手を天に伸べて、"},{"ref":"1Kgs.8.23","start":11008023,"end":11008023,"break":"none","ruby":[[0,1,"い"],[11,1,"かみ"],[13,1,"しゅ"],[16,1,"うえ"],[18,1,"てん"],[22,1,"した"],[24,1,"ち"],[35,1,"かみ"],[47,2,"けいやく"],[50,1,"まも"],[54,1,"こころ"],[64,1,"まえ"],[66,1,"あゆ"],[84,1,"ほどこ"]],"text":"言った、「イスラエルの神、主よ、上の天にも、下の地にも、あなたのような神はありません。あなたは契約を守られ、心をつくしてあなたの前に歩むあなたのしもべらに、いつくしみを施し、"},{"ref":"1Kgs.8.24","start":11008024,"end":11008024,"break":"none","ruby":[[14,1,"ちち"],[19,2,"やくそく"],[27,1,"まも"],[38,1,"くち"],[43,2,"やくそく"],[52,1,"て"],[59,1,"と"],[68,2,"こんにち"],[70,1,"み"]],"text":"あなたのしもべであるわたしの父ダビデに約束されたことを守られました。あなたが口をもって約束されたことを、手をもってなし遂げられたことは、今日見るとおりであります。"},{"ref":"1Kgs.8.25","start":11008025,"end":11008025,"break":"none","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[30,1,"ちち"],[40,2,"やくそく"],[53,1,"まえ"],[55,1,"あゆ"],[66,2,"しそん"],[72,1,"みち"],[74,1,"つつし"],[82,1,"まえ"],[84,1,"あゆ"],[101,1,"くらい"],[103,1,"ざ"],[106,1,"ひと"],[113,1,"まえ"],[115,1,"か"],[129,1,"い"],[144,1,"まも"]],"text":"それゆえ、イスラエルの神、主よ、あなたのしもべであるわたしの父ダビデに、あなたが約束して『おまえがわたしの前に歩んだように、おまえの子孫が、その道を慎んで、わたしの前に歩むならば、おまえにはイスラエルの位に座する人が、わたしの前に欠けることはないであろう』と言われたことを、ダビデのために守ってください。"},{"ref":"1Kgs.8.26","start":11008026,"end":11008026,"break":"none","ruby":[[6,1,"かみ"],[27,1,"ちち"],[32,1,"い"],[36,2,"ことば"],[39,2,"かくにん"]],"text":"イスラエルの神よ、どうぞ、あなたのしもべであるわたしの父ダビデに言われた言葉を確認してください。"},{"ref":"1Kgs.8.27","start":11008027,"end":11008027,"break":"paragraph","ruby":[[3,1,"かみ"],[10,2,"ちじょう"],[13,1,"す"],[24,1,"み"],[27,1,"てん"],[32,1,"たか"],[34,1,"てん"],[59,1,"た"],[64,1,"みや"]],"text":"しかし神は、はたして地上に住まわれるでしょうか。見よ、天も、いと高き天もあなたをいれることはできません。ましてわたしの建てたこの宮はなおさらです。"},{"ref":"1Kgs.8.28","start":11008028,"end":11008028,"break":"none","ruby":[[5,1,"かみ"],[7,1,"しゅ"],[14,1,"いのり"],[16,1,"ねが"],[19,1,"かえり"],[35,1,"まえ"],[41,1,"さけ"],[44,1,"いのり"],[47,1,"き"]],"text":"しかしわが神、主よ、しもべの祈と願いを顧みて、しもべがきょう、あなたの前にささげる叫びと祈をお聞きください。"},{"ref":"1Kgs.8.29","start":11008029,"end":11008029,"break":"none","ruby":[[9,1,"な"],[14,1,"お"],[18,1,"い"],[22,1,"ところ"],[31,1,"みや"],[33,1,"む"],[37,2,"よるひる"],[43,1,"め"],[46,1,"ひら"],[59,1,"ところ"],[61,1,"む"],[65,1,"いの"],[67,1,"いのり"],[70,1,"き"]],"text":"あなたが『わたしの名をそこに置く』と言われた所、すなわち、この宮に向かって夜昼あなたの目をお開きください。しもべがこの所に向かって祈る祈をお聞きください。"},{"ref":"1Kgs.8.30","start":11008030,"end":11008030,"break":"none","ruby":[[9,1,"たみ"],[18,1,"ところ"],[20,1,"む"],[24,1,"いの"],[26,1,"とき"],[31,1,"ねが"],[35,1,"き"],[52,1,"てん"],[54,1,"き"],[57,1,"き"]],"text":"しもべと、あなたの民イスラエルがこの所に向かって祈る時に、その願いをお聞きください。あなたのすみかである天で聞き、聞いておゆるしください。"},{"ref":"1Kgs.8.31","start":11008031,"end":11008031,"break":"paragraph","ruby":[[2,1,"ひと"],[6,1,"とな"],[8,1,"びと"],[10,1,"たい"],[13,1,"つみ"],[15,1,"おか"],[18,1,"ちか"],[26,1,"もと"],[31,1,"とき"],[33,1,"き"],[37,1,"みや"],[43,2,"さいだん"],[46,1,"まえ"],[48,1,"ちか"]],"text":"もし人がその隣り人に対して罪を犯し、誓いをすることを求められる時、来てこの宮であなたの祭壇の前に誓うならば、"},{"ref":"1Kgs.8.32","start":11008032,"end":11008032,"break":"none","ruby":[[4,1,"てん"],[6,1,"き"],[9,1,"おこな"],[25,2,"あくにん"],[28,1,"ばっ"],[39,1,"むく"],[48,1,"き"],[51,2,"ぎじん"],[54,1,"ぎ"],[61,1,"ぎ"],[71,1,"ひと"],[73,1,"むく"]],"text":"あなたは天で聞いて行い、あなたのしもべらをさばき、悪人を罰して、そのおこないの報いをそのこうべに帰し、義人を義として、その義にしたがって、その人に報いてください。"},{"ref":"1Kgs.8.33","start":11008033,"end":11008033,"break":"paragraph","ruby":[[6,1,"たみ"],[18,1,"たい"],[21,1,"つみ"],[23,1,"おか"],[29,1,"てき"],[31,1,"まえ"],[33,1,"やぶ"],[36,1,"とき"],[42,1,"た"],[44,1,"かえ"],[52,1,"な"],[60,1,"みや"],[66,1,"いの"],[68,1,"ねが"]],"text":"もしあなたの民イスラエルが、あなたに対して罪を犯したために敵の前に敗れた時、あなたに立ち返って、あなたの名をあがめ、この宮であなたに祈り願うならば、"},{"ref":"1Kgs.8.34","start":11008034,"end":11008034,"break":"none","ruby":[[4,1,"てん"],[9,1,"き"],[16,1,"たみ"],[23,1,"つみ"],[34,1,"かれ"],[37,2,"せんぞ"],[40,1,"たま"],[44,1,"ち"],[46,1,"かれ"],[49,1,"かえ"]],"text":"あなたは天にあって聞き、あなたの民イスラエルの罪をゆるして、あなたが彼らの先祖に賜わった地に彼らを帰らせてください。"},{"ref":"1Kgs.8.35","start":11008035,"end":11008035,"break":"paragraph","ruby":[[2,1,"かれ"],[9,1,"つみ"],[11,1,"おか"],[18,1,"てん"],[20,1,"と"],[25,1,"あめ"],[34,1,"かれ"],[37,1,"くる"],[43,1,"とき"],[45,1,"かれ"],[50,1,"ところ"],[52,1,"む"],[56,1,"いの"],[63,1,"な"],[71,1,"つみ"],[73,1,"はな"]],"text":"もし彼らがあなたに罪を犯したために、天が閉ざされて雨がなく、あなたが彼らを苦しめられる時、彼らがこの所に向かって祈り、あなたの名をあがめ、その罪を離れるならば、"},{"ref":"1Kgs.8.36","start":11008036,"end":11008036,"break":"none","ruby":[[4,1,"てん"],[6,1,"き"],[21,1,"たみ"],[28,1,"つみ"],[34,1,"かれ"],[37,1,"あゆ"],[41,1,"よ"],[43,1,"みち"],[45,1,"おし"],[58,1,"たみ"],[60,1,"し"],[61,1,"ぎょう"],[65,1,"あた"],[70,1,"ち"],[72,1,"あめ"],[74,1,"ふ"]],"text":"あなたは天で聞き、あなたのしもべ、あなたの民イスラエルの罪をゆるし、彼らに歩むべき良い道を教えて、あなたが、あなたの民に嗣業として与えられた地に雨を降らせてください。"},{"ref":"1Kgs.8.37","start":11008037,"end":11008037,"break":"paragraph","ruby":[[2,1,"くに"],[16,2,"えきびょう"],[19,1,"た"],[21,1,"が"],[24,1,"くさ"],[26,1,"ほ"],[32,2,"あおむし"],[43,1,"てき"],[48,1,"まち"],[50,1,"なか"],[52,1,"せ"],[54,1,"かこ"],[68,2,"さいがい"],[74,2,"びょうき"]],"text":"もし国にききんがあるか、もしくは疫病、立ち枯れ、腐り穂、いなご、青虫があるか、もしくは敵のために町の中に攻め囲まれることがあるか、どんな災害、どんな病気があっても、"},{"ref":"1Kgs.8.38","start":11008038,"end":11008038,"break":"none","ruby":[[12,1,"たみ"],[28,1,"こころ"],[30,1,"なや"],[33,1,"し"],[39,1,"みや"],[41,1,"む"],[45,1,"て"],[47,1,"の"],[57,1,"いのり"],[62,1,"ねが"]],"text":"もし、だれでも、あなたの民イスラエルがみな、おのおのその心の悩みを知って、この宮に向かい、手を伸べるならば、どんな祈、どんな願いでも、"},{"ref":"1Kgs.8.39","start":11008039,"end":11008039,"break":"none","ruby":[[15,1,"てん"],[17,1,"き"],[26,1,"おこな"],[34,1,"ひと"],[39,1,"こころ"],[41,1,"し"],[57,1,"みち"],[64,1,"むく"],[85,1,"ひと"],[87,1,"こころ"],[89,1,"し"]],"text":"あなたは、あなたのすみかである天で聞いてゆるし、かつ行い、おのおのの人に、その心を知っておられるゆえ、そのすべての道にしたがって報いてください。ただ、あなただけ、すべての人の心を知っておられるからです。"},{"ref":"1Kgs.8.40","start":11008040,"end":11008040,"break":"none","ruby":[[10,2,"せんぞ"],[13,1,"たま"],[17,1,"ち"],[20,1,"かれ"],[23,1,"い"],[30,1,"ひ"],[32,1,"あいだ"],[34,1,"つね"],[40,1,"おそ"]],"text":"あなたが、われわれの先祖に賜わった地に、彼らの生きながらえる日の間、常にあなたを恐れさせてください。"},{"ref":"1Kgs.8.41","start":11008041,"end":11008041,"break":"paragraph","ruby":[[6,1,"たみ"],[13,1,"もの"],[22,1,"な"],[27,1,"とお"],[29,1,"くに"],[32,1,"く"],[34,3,"いほうじん"]],"text":"またあなたの民イスラエルの者でなく、あなたの名のために遠い国から来る異邦人が、"},{"ref":"1Kgs.8.42","start":11008042,"end":11008042,"break":"none","ruby":[[5,1,"かれ"],[12,1,"おお"],[16,1,"な"],[19,1,"つよ"],[21,1,"て"],[24,1,"の"],[27,1,"うで"],[33,1,"き"],[35,1,"およ"],[51,1,"みや"],[53,1,"む"],[57,1,"いの"]],"text":"――それは彼らがあなたの大いなる名と、強い手と、伸べた腕とについて聞き及ぶからです、――もしきて、この宮に向かって祈るならば、"},{"ref":"1Kgs.8.43","start":11008043,"end":11008043,"break":"none","ruby":[[15,1,"てん"],[17,1,"き"],[23,3,"いほうじん"],[31,1,"よ"],[33,1,"もと"],[56,1,"ち"],[62,1,"たみ"],[69,1,"たみ"],[84,1,"な"],[86,1,"し"],[93,1,"おそ"],[102,1,"た"],[107,1,"みや"],[113,1,"な"],[118,1,"よ"],[125,1,"し"]],"text":"あなたは、あなたのすみかである天で聞き、すべて異邦人があなたに呼び求めることをかなえさせてください。そうすれば、地のすべての民は、あなたの民イスラエルのように、あなたの名を知り、あなたを恐れ、またわたしが建てたこの宮があなたの名によって呼ばれることを知るにいたるでしょう。"},{"ref":"1Kgs.8.44","start":11008044,"end":11008044,"break":"paragraph","ruby":[[4,1,"たみ"],[6,1,"てき"],[8,1,"たたか"],[24,1,"みち"],[26,1,"とお"],[29,1,"で"],[31,1,"い"],[38,1,"かれ"],[45,1,"えら"],[49,1,"まち"],[59,1,"な"],[64,1,"た"],[67,1,"みや"],[69,1,"ほう"],[71,1,"む"],[76,1,"しゅ"],[78,1,"いの"]],"text":"あなたの民が敵と戦うために、あなたがつかわされる道を通って出て行くとき、もし彼らがあなたの選ばれた町、わたしがあなたの名のために建てた宮の方に向かって、主に祈るならば、"},{"ref":"1Kgs.8.45","start":11008045,"end":11008045,"break":"none","ruby":[[4,1,"てん"],[7,1,"かれ"],[10,1,"いのり"],[12,1,"ねが"],[15,1,"き"],[18,1,"かれ"],[22,1,"たす"]],"text":"あなたは天で、彼らの祈と願いを聞いて彼らをお助けください。"},{"ref":"1Kgs.8.46","start":11008046,"end":11008046,"break":"paragraph","ruby":[[0,1,"かれ"],[7,1,"たい"],[10,1,"つみ"],[12,1,"おか"],[23,1,"ひと"],[25,1,"つみ"],[27,1,"おか"],[31,1,"もの"],[45,1,"かれ"],[48,1,"いか"],[51,1,"かれ"],[54,1,"てき"],[60,1,"てき"],[62,1,"かれ"],[65,2,"ほりょ"],[70,2,"えんきん"],[79,1,"てき"],[81,1,"ち"],[83,1,"ひ"],[86,1,"い"],[88,1,"とき"]],"text":"彼らがあなたに対して罪を犯すことがあって、――人は罪を犯さない者はないのです、――あなたが彼らを怒り、彼らを敵にわたし、敵が彼らを捕虜として遠近にかかわらず、敵の地に引いて行く時、"},{"ref":"1Kgs.8.47","start":11008047,"end":11008047,"break":"none","ruby":[[2,1,"かれ"],[5,1,"とら"],[12,1,"ち"],[19,1,"かえり"],[22,1,"く"],[25,2,"じぶん"],[28,1,"とら"],[34,1,"もの"],[36,1,"ち"],[43,1,"ねが"],[52,1,"つみ"],[54,1,"おか"],[64,1,"あく"],[66,1,"おこな"],[73,1,"い"]],"text":"もし彼らが捕われていった地で、みずから省みて悔い、自分を捕えていった者の地で、あなたに願い、『われわれは罪を犯しました、そむいて悪を行いました』と言い、"},{"ref":"1Kgs.8.48","start":11008048,"end":11008048,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"とら"],[9,1,"てき"],[11,1,"ち"],[14,1,"こころ"],[20,2,"せいしん"],[31,1,"た"],[33,1,"かえ"],[40,1,"かれ"],[43,2,"せんぞ"],[46,1,"あた"],[51,1,"ち"],[57,1,"えら"],[61,1,"まち"],[71,1,"な"],[76,1,"た"],[79,1,"みや"],[81,1,"ほう"],[83,1,"む"],[92,1,"いの"]],"text":"自分を捕えていった敵の地で、心をつくし、精神をつくしてあなたに立ち返り、あなたが彼らの先祖に与えられた地、あなたが選ばれた町、わたしがあなたの名のために建てた宮の方に向かって、あなたに祈るならば、"},{"ref":"1Kgs.8.49","start":11008049,"end":11008049,"break":"none","ruby":[[10,1,"てん"],[13,1,"かれ"],[16,1,"いのり"],[18,1,"ねが"],[21,1,"き"],[25,1,"かれ"],[28,1,"たす"]],"text":"あなたのすみかである天で、彼らの祈と願いを聞いて、彼らを助け、"},{"ref":"1Kgs.8.50","start":11008050,"end":11008050,"break":"none","ruby":[[4,1,"たみ"],[11,1,"たい"],[14,1,"おか"],[17,1,"つみ"],[24,1,"たい"],[27,1,"い"],[43,1,"かれ"],[46,1,"とら"],[52,1,"もの"],[54,1,"まえ"],[57,1,"かれ"],[65,1,"え"],[71,2,"ひとびと"],[74,1,"かれ"]],"text":"あなたの民が、あなたに対して犯した罪と、あなたに対して行ったすべてのあやまちをゆるし、彼らを捕えていった者の前で、彼らにあわれみを得させ、その人々が彼らをあわれむようにしてください。"},{"ref":"1Kgs.8.51","start":11008051,"end":11008051,"break":"none","ruby":[[1,1,"かれ"],[15,1,"てつ"],[21,1,"なか"],[24,1,"みちび"],[26,1,"だ"],[34,1,"たみ"],[40,1,"し"],[41,1,"ぎょう"]],"text":"（彼らはあなたがエジプトから、鉄のかまどの中から導き出されたあなたの民、あなたの嗣業であるからです）。"},{"ref":"1Kgs.8.52","start":11008052,"end":11008052,"break":"none","ruby":[[8,1,"ねが"],[16,1,"たみ"],[23,1,"ねが"],[31,1,"め"],[33,1,"ひら"],[43,1,"よ"],[45,1,"もと"],[48,1,"とき"],[50,1,"かれ"],[53,1,"ねが"],[57,1,"き"]],"text":"どうぞ、しもべの願いと、あなたの民イスラエルの願いに、あなたの目を開き、すべてあなたに呼び求める時、彼らの願いをお聞きください。"},{"ref":"1Kgs.8.53","start":11008053,"end":11008053,"break":"none","ruby":[[4,1,"かれ"],[7,1,"ち"],[13,1,"たみ"],[19,1,"く"],[20,1,"べっ"],[28,1,"し"],[29,1,"ぎょう"],[39,1,"しゅ"],[42,1,"かみ"],[54,2,"せんぞ"],[63,1,"みちび"],[65,1,"だ"],[69,1,"とき"],[78,1,"い"]],"text":"あなたは彼らを地のすべての民のうちから区別して、あなたの嗣業とされたからです。主なる神よ、あなたがわれわれの先祖をエジプトから導き出された時、モーセによって言われたとおりです」。"},{"ref":"1Kgs.8.54","start":11008054,"end":11008054,"break":"paragraph","ruby":[[7,1,"いのり"],[9,1,"ねが"],[17,1,"しゅ"],[22,1,"おわ"],[30,1,"てん"],[32,1,"む"],[36,1,"て"],[38,1,"の"],[49,1,"しゅ"],[51,2,"さいだん"],[54,1,"まえ"],[57,1,"た"]],"text":"ソロモンはこの祈と願いをことごとく主にささげ終ると、それまで天に向かって手を伸べ、ひざまずいていた主の祭壇の前から立ちあがり、"},{"ref":"1Kgs.8.55","start":11008055,"end":11008055,"break":"none","ruby":[[0,1,"た"],[3,2,"おおごえ"],[12,1,"ぜん"],[13,2,"かいしゅう"],[16,2,"しゅくふく"],[20,1,"い"]],"text":"立って大声でイスラエルの全会衆を祝福して言った、"},{"ref":"1Kgs.8.56","start":11008056,"end":11008056,"break":"none","ruby":[[1,1,"しゅ"],[10,1,"しゅ"],[15,2,"やくそく"],[26,1,"たみ"],[33,2,"たいへい"],[36,1,"たま"],[53,1,"おお"],[60,1,"よ"],[62,2,"やくそく"],[65,1,"みな"]],"text":"「主はほむべきかな。主はすべて約束されたように、その民イスラエルに太平を賜わった。そのしもべモーセによって仰せられたその良き約束は皆一つもたがわなかった。"},{"ref":"1Kgs.8.57","start":11008057,"end":11008057,"break":"none","ruby":[[5,1,"かみ"],[12,2,"せんぞ"],[15,1,"とも"],[30,1,"とも"],[45,1,"はな"],[56,2,"みす"]],"text":"われわれの神がわれわれの先祖と共におられたように、われわれと共におられるように。われわれを離れず、またわれわれを見捨てられないように。"},{"ref":"1Kgs.8.58","start":11008058,"end":11008058,"break":"none","ruby":[[5,1,"こころ"],[7,1,"しゅ"],[9,1,"かたむ"],[13,1,"しゅ"],[19,1,"みち"],[21,1,"あゆ"],[30,2,"せんぞ"],[33,1,"めい"],[38,1,"いまし"],[41,1,"さだ"],[50,1,"まも"]],"text":"われわれの心を主に傾けて、主のすべての道に歩ませ、われわれの先祖に命じられた戒めと定めと、おきてとを守らせられるように。"},{"ref":"1Kgs.8.59","start":11008059,"end":11008059,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"まえ"],[8,1,"の"],[15,1,"ねが"],[18,2,"ことば"],[22,2,"にちや"],[29,1,"かみ"],[31,1,"しゅ"],[33,1,"おぼ"],[45,1,"しゅ"],[47,2,"ひび"],[50,1,"こと"],[57,1,"たす"],[60,1,"しゅ"],[62,1,"たみ"],[69,1,"たす"]],"text":"主の前にわたしが述べたこれらの願いの言葉が、日夜われわれの神、主に覚えられるように。そして主は日々の事に、しもべを助け、主の民イスラエルを助けられるように。"},{"ref":"1Kgs.8.60","start":11008060,"end":11008060,"break":"none","ruby":[[6,1,"ち"],[12,1,"たみ"],[14,1,"しゅ"],[16,1,"かみ"],[24,1,"ほか"],[26,1,"かみ"],[33,1,"し"],[36,1,"いた"]],"text":"そうすれば、地のすべての民は主が神であることと、他に神のないことを知るに至るであろう。"},{"ref":"1Kgs.8.61","start":11008061,"end":11008061,"break":"none","ruby":[[12,2,"こんにち"],[23,1,"かみ"],[25,1,"しゅ"],[27,1,"たい"],[31,1,"こころ"],[33,1,"まった"],[35,2,"しんじつ"],[41,1,"しゅ"],[43,1,"さだ"],[46,1,"あゆ"],[49,1,"しゅ"],[51,1,"いまし"],[54,1,"まも"]],"text":"それゆえ、あなたがたは、今日のようにわれわれの神、主に対して、心は全く真実であり、主の定めに歩み、主の戒めを守らなければならない」。"},{"ref":"1Kgs.8.62","start":11008062,"end":11008062,"break":"paragraph","ruby":[[3,1,"おう"],[7,1,"おう"],[9,1,"とも"],[25,1,"しゅ"],[27,1,"まえ"],[29,2,"ぎせい"]],"text":"そして王および王と共にいるすべてのイスラエルびとは主の前に犠牲をささげた。"},{"ref":"1Kgs.8.63","start":11008063,"end":11008063,"break":"none","ruby":[[5,3,"しゅうおんさい"],[11,1,"うし"],[16,1,"とう"],[18,1,"ひつじ"],[22,1,"とう"],[24,1,"しゅ"],[35,1,"おう"],[43,2,"ひとびと"],[46,1,"みな"],[47,1,"しゅ"],[49,1,"みや"],[51,2,"ほうけん"]],"text":"ソロモンは酬恩祭として牛二万二千頭、羊十二万頭を主にささげた。こうして王とイスラエルの人々は皆主の宮を奉献した。"},{"ref":"1Kgs.8.64","start":11008064,"end":11008064,"break":"none","ruby":[[2,1,"ひ"],[4,1,"おう"],[6,1,"しゅ"],[8,1,"みや"],[10,1,"まえ"],[14,1,"にわ"],[16,1,"なか"],[18,2,"せいべつ"],[24,1,"ところ"],[26,2,"はんさい"],[29,2,"そさい"],[32,3,"しゅうおんさい"],[36,2,"しぼう"],[47,1,"しゅ"],[49,1,"まえ"],[53,2,"せいどう"],[56,2,"さいだん"],[59,2,"そさい"],[62,3,"しゅうおんさい"],[66,2,"しぼう"],[70,1,"う"],[74,1,"た"]],"text":"その日、王は主の宮の前にある庭の中を聖別し、その所で燔祭と素祭と酬恩祭の脂肪をささげた。これは主の前にある青銅の祭壇が素祭と酬恩祭の脂肪とを受けるに足りなかったからである。"},{"ref":"1Kgs.8.65","start":11008065,"end":11008065,"break":"paragraph","ruby":[[2,1,"とき"],[8,2,"なぬか"],[11,1,"あいだ"],[17,1,"かみ"],[19,1,"しゅ"],[21,1,"まえ"],[23,1,"まつり"],[25,1,"おこな"],[33,2,"いりぐち"],[42,1,"かわ"],[44,1,"いた"],[61,1,"おお"],[65,2,"かいしゅう"],[68,1,"かれ"],[70,1,"とも"]],"text":"その時ソロモンは七日の間われわれの神、主の前に祭を行った。ハマテの入口からエジプトの川に至るまでのすべてのイスラエルびとの大いなる会衆が彼と共にいた。"},{"ref":"1Kgs.8.66","start":11008066,"end":11008066,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[9,1,"たみ"],[11,1,"かえ"],[16,1,"たみ"],[18,1,"おう"],[20,2,"しゅくふく"],[24,1,"しゅ"],[38,1,"たみ"],[46,1,"ほどこ"],[55,1,"めぐ"],[58,1,"よろこ"],[61,1,"こころ"],[63,1,"たの"],[69,2,"てんまく"],[72,1,"かえ"],[75,1,"い"]],"text":"八日目にソロモンは民を帰らせた。民は王を祝福し、主がそのしもべダビデと、その民イスラエルとに施されたもろもろの恵みを喜び、心に楽しんでその天幕に帰って行った。"}]