[{"ref":"Hos.14.1","start":28014001,"end":28014001,"break":"paragraph","breaks":[[7,"line"],[18,"line"]],"ruby":[[11,1,"かみ"],[13,1,"しゅ"],[15,1,"かえ"],[22,2,"じぶん"],[25,2,"ふぎ"]],"text":"イスラエルよ、あなたの神、主に帰れ。あなたは自分の不義によって、つまずいたからだ。"},{"ref":"Hos.14.2","start":28014002,"end":28014002,"break":"line","breaks":[[21,"line"],[35,"line"],[50,"line"]],"ruby":[[6,2,"ことば"],[9,1,"たずさ"],[13,1,"しゅ"],[15,1,"かえ"],[18,1,"い"],[22,2,"ふぎ"],[40,1,"う"],[56,2,"じぶん"],[64,1,"み"]],"text":"あなたがたは言葉を携えて、主に帰って言え、「不義はことごとくゆるして、よきものを受けいれてください。わたしたちは自分のくちびるの実をささげます。"},{"ref":"Hos.14.3","start":28014003,"end":28014003,"break":"line","breaks":[[16,"line"],[30,"line"],[53,"line"],[69,"line"],[82,"line"]],"ruby":[[12,1,"たす"],[22,1,"うま"],[24,1,"の"],[39,2,"じぶん"],[44,1,"て"],[49,1,"む"],[59,1,"かみ"],[63,1,"い"],[87,1,"え"]],"text":"アッスリヤはわたしたちを助けず、わたしたちは馬に乗りません。わたしたちはもはや自分たちの手のわざに向かって『われわれの神』とは言いません。みなしごはあなたによって、あわれみを得るでしょう」。"},{"ref":"Hos.14.4","start":28014004,"end":28014004,"break":"stanza","breaks":[[15,"line"],[25,"line"]],"ruby":[[4,1,"かれ"],[15,1,"よろこ"],[21,1,"あい"],[29,1,"いか"],[32,1,"かれ"],[35,1,"はな"],[37,1,"さ"]],"text":"わたしは彼らのそむきをいやし、喜んでこれを愛する。わたしの怒りは彼らを離れ去ったからである。"},{"ref":"Hos.14.5","start":28014005,"end":28014005,"break":"line","breaks":[[22,"line"],[34,"line"]],"ruby":[[10,1,"たい"],[14,1,"つゆ"],[22,1,"かれ"],[30,1,"はな"],[31,1,"さ"],[41,1,"ね"],[43,1,"は"]],"text":"わたしはイスラエルに対しては露のようになる。彼はゆりのように花咲き、ポプラのように根を張り、"},{"ref":"Hos.14.6","start":28014006,"end":28014006,"break":"line","breaks":[[11,"line"],[27,"line"]],"ruby":[[2,1,"えだ"],[4,1,"しげ"],[13,1,"うるわ"],[21,1,"き"]],"text":"その枝は茂りひろがり、その麗しさはオリブの木のように、そのかんばしさはレバノンのようになる。"},{"ref":"Hos.14.7","start":28014007,"end":28014007,"break":"line","breaks":[[16,"line"],[24,"line"],[37,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かえ"],[6,1,"き"],[11,1,"かげ"],[13,1,"す"],[16,1,"その"],[21,1,"さか"],[28,1,"き"],[33,1,"はな"],[34,1,"さ"],[50,1,"さけ"]],"text":"彼らは帰って来て、わが陰に住み、園のように栄え、ぶどうの木のように花咲き、そのかんばしさはレバノンの酒のようになる。"},{"ref":"Hos.14.8","start":28014008,"end":28014008,"break":"stanza","breaks":[[7,"line"],[26,"line"],[49,"line"],[64,"line"]],"ruby":[[11,2,"ぐうぞう"],[17,1,"かか"],[30,1,"こた"],[37,1,"かえり"],[40,1,"もの"],[53,1,"みどり"],[73,1,"み"],[75,1,"え"]],"text":"エフライムよ、わたしは偶像となんの係わりがあろうか。あなたに答え、あなたを顧みる者はわたしである。わたしは緑のいとすぎのようだ。あなたはわたしから実を得る。"},{"ref":"Hos.14.9","start":28014009,"end":28014009,"break":"stanza","breaks":[[11,"line"],[27,"line"],[37,"line"],[53,"line"],[60,"line"],[71,"line"]],"ruby":[[0,2,"ちえ"],[5,1,"もの"],[13,1,"ひと"],[22,1,"さと"],[27,1,"さと"],[31,1,"もの"],[39,1,"ひと"],[48,1,"し"],[53,1,"しゅ"],[55,1,"みち"],[57,1,"なお"],[60,1,"ただ"],[63,1,"もの"],[68,1,"あゆ"],[74,1,"つみ"]],"text":"知恵のある者はだれか。その人にこれらのことを悟らせよ。悟りある者はだれか。その人にこれらのことを知らせよ。主の道は直く、正しき者はこれを歩む。しかし罪びとはこれにつまずく。"}]