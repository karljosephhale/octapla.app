[{"ref":"Lev.26.1","start":3026001,"end":3026001,"break":"paragraph","ruby":[[6,2,"じぶん"],[13,2,"ぐうぞう"],[16,1,"つく"],[27,1,"きざ"],[30,1,"ぞう"],[32,1,"いし"],[34,1,"はしら"],[36,1,"た"],[53,1,"ち"],[55,2,"せきぞう"],[58,1,"た"],[65,1,"おが"],[84,1,"かみ"],[86,1,"しゅ"]],"text":"あなたがたは自分のために、偶像を造ってはならない。また刻んだ像も石の柱も立ててはならない。またあなたがたの地に石像を立てて、それを拝んではならない。わたしはあなたがたの神、主だからである。"},{"ref":"Lev.26.2","start":3026002,"end":3026002,"break":"none","ruby":[[10,3,"あんそくにち"],[14,1,"まも"],[23,2,"せいじょ"],[26,1,"うやま"],[41,1,"しゅ"]],"text":"あなたがたはわたしの安息日を守り、またわたしの聖所を敬わなければならない。わたしは主である。"},{"ref":"Lev.26.3","start":3026003,"end":3026003,"break":"paragraph","ruby":[[12,1,"さだ"],[15,1,"あゆ"],[22,1,"いまし"],[25,1,"まも"],[32,1,"おこな"]],"text":"もしあなたがたがわたしの定めに歩み、わたしの戒めを守って、これを行うならば、"},{"ref":"Lev.26.4","start":3026004,"end":3026004,"break":"none","ruby":[[6,2,"きせつ"],[8,2,"きせつ"],[12,1,"あめ"],[20,1,"あた"],[28,1,"ち"],[30,2,"さんぶつ"],[33,1,"だ"],[36,1,"はたけ"],[38,2,"きぎ"],[41,1,"み"],[43,1,"むす"]],"text":"わたしはその季節季節に、雨をあなたがたに与えるであろう。地は産物を出し、畑の木々は実を結ぶであろう。"},{"ref":"Lev.26.5","start":3026005,"end":3026005,"break":"none","ruby":[[6,2,"むぎう"],[15,2,"とりい"],[19,1,"とき"],[22,1,"つづ"],[29,2,"とりい"],[34,1,"たね"],[38,1,"とき"],[41,1,"つづ"],[54,1,"あ"],[62,1,"た"],[73,1,"ち"],[75,1,"やす"],[79,1,"す"]],"text":"あなたがたの麦打ちは、ぶどうの取入れの時まで続き、ぶどうの取入れは、種まきの時まで続くであろう。あなたがたは飽きるほどパンを食べ、またあなたがたの地に安らかに住むであろう。"},{"ref":"Lev.26.6","start":3026006,"end":3026006,"break":"none","ruby":[[4,1,"くに"],[6,2,"へいわ"],[9,1,"あた"],[21,1,"やす"],[25,1,"ね"],[39,1,"おそ"],[59,1,"くに"],[65,1,"わる"],[67,1,"けもの"],[69,1,"た"],[87,1,"くに"],[89,1,"い"],[91,1,"めぐ"]],"text":"わたしが国に平和を与えるから、あなたがたは安らかに寝ることができ、あなたがたを恐れさすものはないであろう。わたしはまた国のうちから悪い獣を絶やすであろう。つるぎがあなたがたの国を行き巡ることはないであろう。"},{"ref":"Lev.26.7","start":3026007,"end":3026007,"break":"none","ruby":[[6,1,"てき"],[8,1,"お"],[15,1,"かれ"],[29,1,"たお"]],"text":"あなたがたは敵を追うであろう。彼らは、あなたがたのつるぎに倒れるであろう。"},{"ref":"Lev.26.8","start":3026008,"end":3026008,"break":"none","ruby":[[7,1,"にん"],[10,1,"にん"],[12,1,"お"],[16,1,"にん"],[19,1,"にん"],[21,1,"お"],[30,1,"てき"],[36,1,"たお"]],"text":"あなたがたの五人は百人を追い、百人は万人を追い、あなたがたの敵はつるぎに倒れるであろう。"},{"ref":"Lev.26.9","start":3026009,"end":3026009,"break":"none","ruby":[[10,1,"かえり"],[13,1,"おお"],[16,1,"こ"],[18,1,"え"],[28,1,"ま"],[37,1,"むす"],[40,2,"けいやく"],[43,1,"かた"]],"text":"わたしはあなたがたを顧み、多くの子を獲させ、あなたがたを増し、あなたがたと結んだ契約を固めるであろう。"},{"ref":"Lev.26.10","start":3026010,"end":3026010,"break":"none","ruby":[[6,1,"ふる"],[8,2,"こくもつ"],[11,1,"た"],[16,1,"あいだ"],[21,1,"あたら"],[27,1,"え"],[32,1,"ふる"],[37,1,"す"]],"text":"あなたがたは古い穀物を食べている間に、また新しいものを獲て、その古いものを捨てるようになるであろう。"},{"ref":"Lev.26.11","start":3026011,"end":3026011,"break":"none","ruby":[[4,2,"まくや"],[16,1,"た"],[19,1,"こころ"],[27,1,"い"]],"text":"わたしは幕屋をあなたがたのうちに建て、心にあなたがたを忌みきらわないであろう。"},{"ref":"Lev.26.12","start":3026012,"end":3026012,"break":"none","ruby":[[13,1,"あゆ"],[22,1,"かみ"],[37,1,"たみ"]],"text":"わたしはあなたがたのうちに歩み、あなたがたの神となり、あなたがたはわたしの民となるであろう。"},{"ref":"Lev.26.13","start":3026013,"end":3026013,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[29,1,"くに"],[32,1,"みちび"],[34,1,"だ"],[38,2,"どれい"],[41,2,"みぶん"],[45,1,"と"],[47,1,"はな"],[50,1,"もの"],[69,2,"よこぎ"],[72,1,"くだ"],[81,1,"た"],[84,1,"ある"]],"text":"わたしはあなたがたの神、主であって、あなたがたをエジプトの国から導き出して、奴隷の身分から解き放った者である。わたしはあなたがたのくびきの横木を砕いて、まっすぐに立って歩けるようにしたのである。"},{"ref":"Lev.26.14","start":3026014,"end":3026014,"break":"paragraph","ruby":[[16,1,"き"],[18,1,"したが"],[30,1,"いまし"],[33,1,"まも"]],"text":"しかし、あなたがたがもしわたしに聞き従わず、またこのすべての戒めを守らず、"},{"ref":"Lev.26.15","start":3026015,"end":3026015,"break":"none","ruby":[[4,1,"さだ"],[7,1,"かろ"],[11,1,"こころ"],[21,1,"い"],[36,1,"いまし"],[39,1,"まも"],[47,2,"けいやく"],[50,1,"やぶ"]],"text":"わたしの定めを軽んじ、心にわたしのおきてを忌みきらって、わたしのすべての戒めを守らず、わたしの契約を破るならば、"},{"ref":"Lev.26.16","start":3026016,"end":3026016,"break":"none","ruby":[[33,1,"うえ"],[35,2,"きょうふ"],[38,1,"のぞ"],[42,2,"はいびょう"],[45,2,"ねつびょう"],[58,1,"め"],[60,1,"み"],[66,1,"いのち"],[70,1,"おとろ"],[86,1,"たね"],[98,1,"てき"],[103,1,"た"]],"text":"わたしはあなたがたにこのようにするであろう。すなわち、あなたがたの上に恐怖を臨ませ、肺病と熱病をもって、あなたがたの目を見えなくし、命をやせ衰えさせるであろう。あなたがたが種をまいてもむだである。敵がそれを食べるであろう。"},{"ref":"Lev.26.17","start":3026017,"end":3026017,"break":"none","ruby":[[4,1,"かお"],[15,1,"せ"],[24,1,"てき"],[26,1,"まえ"],[28,1,"う"],[48,1,"にく"],[50,1,"もの"],[58,1,"おさ"],[72,1,"お"],[74,1,"もの"],[80,1,"に"]],"text":"わたしは顔をあなたがたにむけて攻め、あなたがたは敵の前に撃ちひしがれるであろう。またあなたがたの憎む者があなたがたを治めるであろう。あなたがたは追う者もないのに逃げるであろう。"},{"ref":"Lev.26.18","start":3026018,"end":3026018,"break":"none","ruby":[[17,1,"き"],[19,1,"したが"],[37,1,"つみ"],[40,1,"ばい"],[41,1,"おも"],[43,1,"ばっ"]],"text":"それでもなお、あなたがたがわたしに聞き従わないならば、わたしはあなたがたの罪を七倍重く罰するであろう。"},{"ref":"Lev.26.19","start":3026019,"end":3026019,"break":"none","ruby":[[10,1,"ほこり"],[14,1,"ちから"],[16,1,"くだ"],[25,1,"てん"],[27,1,"てつ"],[40,1,"ち"],[42,2,"せいどう"]],"text":"わたしはあなたがたの誇とする力を砕き、あなたがたの天を鉄のようにし、あなたがたの地を青銅のようにするであろう。"},{"ref":"Lev.26.20","start":3026020,"end":3026020,"break":"none","ruby":[[6,1,"ちから"],[12,1,"ついや"],[26,1,"ち"],[28,2,"さんぶつ"],[36,1,"くに"],[41,2,"きぎ"],[44,1,"み"],[46,1,"むす"]],"text":"あなたがたの力は、むだに費されるであろう。すなわち、地は産物をいださず、国のうちの木々は実を結ばないであろう。"},{"ref":"Lev.26.21","start":3026021,"end":3026021,"break":"paragraph","ruby":[[12,1,"さか"],[16,1,"あゆ"],[23,1,"き"],[25,1,"したが"],[43,1,"つみ"],[45,1,"したが"],[49,1,"ばい"],[51,1,"わざわい"],[59,1,"くだ"]],"text":"もしあなたがたがわたしに逆らって歩み、わたしに聞き従わないならば、わたしはあなたがたの罪に従って七倍の災をあなたがたに下すであろう。"},{"ref":"Lev.26.22","start":3026022,"end":3026022,"break":"none","ruby":[[6,2,"やじゅう"],[18,1,"おく"],[34,2,"こども"],[37,1,"うば"],[42,2,"かちく"],[45,1,"ほろ"],[55,1,"かず"],[57,1,"すく"],[73,2,"おおじ"],[76,1,"あ"],[78,1,"は"]],"text":"わたしはまた野獣をあなたがたのうちに送るであろう。それはあなたがたの子供を奪い、また家畜を滅ぼし、あなたがたの数を少なくするであろう。あなたがたの大路は荒れ果てるであろう。"},{"ref":"Lev.26.23","start":3026023,"end":3026023,"break":"paragraph","ruby":[[12,1,"こら"],[16,1,"う"],[22,1,"あらた"],[30,1,"さか"],[34,1,"あゆ"]],"text":"もしあなたがたがこれらの懲しめを受けてもなお改めず、わたしに逆らって歩むならば、"},{"ref":"Lev.26.24","start":3026024,"end":3026024,"break":"none","ruby":[[12,1,"さか"],[16,1,"あゆ"],[25,1,"つみ"],[28,1,"ばい"],[29,1,"おも"],[31,1,"ばっ"]],"text":"わたしもまたあなたがたに逆らって歩み、あなたがたの罪を七倍重く罰するであろう。"},{"ref":"Lev.26.25","start":3026025,"end":3026025,"break":"none","ruby":[[10,1,"うえ"],[16,1,"のぞ"],[20,2,"いやく"],[23,1,"うら"],[26,1,"むく"],[40,2,"まちまち"],[43,1,"あつ"],[46,1,"とき"],[58,2,"えきびょう"],[61,1,"おく"],[70,1,"てき"],[72,1,"て"]],"text":"わたしはあなたがたの上につるぎを臨ませ、違約の恨みを報いるであろう。あなたがたが町々に集まる時は、あなたがたのうちに疫病を送り、あなたがたは敵の手にわたされるであろう。"},{"ref":"Lev.26.26","start":3026026,"end":3026026,"break":"none","ruby":[[18,1,"くだ"],[24,1,"にん"],[26,1,"おんな"],[38,1,"や"],[57,1,"わた"],[70,1,"た"],[74,1,"み"]],"text":"わたしがあなたがたのつえとするパンを砕くとき、十人の女が一つのかまどでパンを焼き、それをはかりにかけてあなたがたに渡すであろう。あなたがたは食べても満たされないであろう。"},{"ref":"Lev.26.27","start":3026027,"end":3026027,"break":"paragraph","ruby":[[17,1,"き"],[19,1,"したが"],[27,1,"さか"],[31,1,"あゆ"]],"text":"それでもなお、あなたがたがわたしに聞き従わず、わたしに逆らって歩むならば、"},{"ref":"Lev.26.28","start":3026028,"end":3026028,"break":"none","ruby":[[10,1,"さか"],[14,1,"いか"],[20,1,"あゆ"],[29,1,"つみ"],[32,1,"ばい"],[33,1,"おも"],[35,1,"ばっ"]],"text":"わたしもあなたがたに逆らい、怒りをもって歩み、あなたがたの罪を七倍重く罰するであろう。"},{"ref":"Lev.26.29","start":3026029,"end":3026029,"break":"none","ruby":[[6,2,"じぶん"],[13,1,"にく"],[15,1,"た"],[20,2,"じぶん"],[23,1,"むすめ"],[25,1,"にく"],[27,1,"た"]],"text":"あなたがたは自分のむすこの肉を食べ、また自分の娘の肉を食べるであろう。"},{"ref":"Lev.26.30","start":3026030,"end":3026030,"break":"none","ruby":[[10,1,"たか"],[12,1,"ところ"],[18,1,"こう"],[20,2,"さいだん"],[23,1,"たお"],[26,2,"ぐうぞう"],[29,2,"したい"],[32,1,"うえ"],[41,2,"したい"],[44,1,"な"],[46,1,"す"],[54,1,"こころ"],[62,1,"い"]],"text":"わたしはあなたがたの高き所をこぼち、香の祭壇を倒し、偶像の死体の上に、あなたがたの死体を投げ捨てて、わたしは心にあなたがたを忌みきらうであろう。"},{"ref":"Lev.26.31","start":3026031,"end":3026031,"break":"none","ruby":[[12,2,"まちまち"],[15,1,"あ"],[17,1,"ち"],[27,2,"せいじょ"],[30,1,"あ"],[54,1,"こう"]],"text":"わたしはまたあなたがたの町々を荒れ地とし、あなたがたの聖所を荒らすであろう。またわたしはあなたがたのささげる香ばしいかおりをかがないであろう。"},{"ref":"Lev.26.32","start":3026032,"end":3026032,"break":"none","ruby":[[6,1,"ち"],[8,1,"あ"],[17,1,"す"],[25,1,"てき"],[30,1,"み"],[32,1,"おどろ"]],"text":"わたしがその地を荒らすゆえ、そこに住むあなたがたの敵はそれを見て驚くであろう。"},{"ref":"Lev.26.33","start":3026033,"end":3026033,"break":"none","ruby":[[10,2,"くにぐに"],[13,1,"あいだ"],[15,1,"ち"],[23,1,"ぬ"],[33,1,"うしろ"],[35,1,"お"],[48,1,"ち"],[50,1,"あ"],[52,1,"は"],[61,2,"まちまち"],[64,1,"あ"],[66,1,"ち"]],"text":"わたしはあなたがたを国々の間に散らし、つるぎを抜いて、あなたがたの後を追うであろう。あなたがたの地は荒れ果て、あなたがたの町々は荒れ地となるであろう。"},{"ref":"Lev.26.34","start":3026034,"end":3026034,"break":"paragraph","ruby":[[6,1,"ち"],[8,1,"あ"],[10,1,"は"],[20,1,"てき"],[22,1,"くに"],[26,1,"あいだ"],[28,1,"ち"],[30,2,"あんそく"],[33,1,"たの"],[48,1,"とき"],[50,1,"ち"],[52,1,"やす"],[55,1,"え"],[58,2,"あんそく"],[61,1,"たの"]],"text":"こうしてその地が荒れ果てて、あなたがたは敵の国にある間、地は安息を楽しむであろう。すなわち、その時、地は休みを得て、安息を楽しむであろう。"},{"ref":"Lev.26.35","start":3026035,"end":3026035,"break":"none","ruby":[[3,1,"あ"],[5,1,"は"],[10,1,"ひ"],[12,1,"あいだ"],[14,1,"やす"],[30,1,"す"],[35,1,"あいだ"],[43,2,"あんそく"],[49,1,"やす"],[52,1,"え"]],"text":"それは荒れ果てている日の間、休むであろう。あなたがたがそこに住んでいる間、あなたがたの安息のときに休みを得なかったものである。"},{"ref":"Lev.26.36","start":3026036,"end":3026036,"break":"none","ruby":[[11,1,"のこ"],[16,1,"もの"],[18,1,"こころ"],[21,1,"てき"],[23,1,"くに"],[29,1,"おそ"],[42,1,"かれ"],[45,1,"こ"],[47,1,"は"],[49,1,"うご"],[51,1,"おと"],[54,1,"おどろ"],[57,1,"に"],[64,1,"さ"],[67,1,"に"],[70,1,"もの"],[75,1,"に"],[79,1,"お"],[81,1,"もの"],[90,1,"たお"]],"text":"またあなたがたのうちの残っている者の心に、敵の国でわたしは恐れをいだかせるであろう。彼らは木の葉の動く音にも驚いて逃げ、つるぎを避けて逃げる者のように逃げて、追う者もないのにころび倒れるであろう。"},{"ref":"Lev.26.37","start":3026037,"end":3026037,"break":"none","ruby":[[0,1,"かれ"],[3,1,"お"],[5,1,"もの"],[20,1,"もの"],[25,1,"お"],[27,1,"かさ"],[36,1,"たお"],[50,1,"てき"],[52,1,"まえ"],[54,1,"た"]],"text":"彼らは追う者もないのに、つるぎをのがれる者のように折り重なって、つまずき倒れるであろう。あなたがたは敵の前に立つことができないであろう。"},{"ref":"Lev.26.38","start":3026038,"end":3026038,"break":"none","ruby":[[6,2,"くにぐに"],[15,1,"ほろ"],[26,1,"てき"],[28,1,"ち"]],"text":"あなたがたは国々のうちにあって滅びうせ、あなたがたの敵の地はあなたがたをのみつくすであろう。"},{"ref":"Lev.26.39","start":3026039,"end":3026039,"break":"none","ruby":[[9,1,"のこ"],[14,1,"もの"],[23,1,"てき"],[25,1,"ち"],[27,2,"じぶん"],[30,1,"つみ"],[37,1,"おとろ"],[42,2,"せんぞ"],[47,1,"つみ"],[52,1,"かれ"],[55,1,"おな"],[62,1,"おとろ"]],"text":"あなたがたのうちの残っている者は、あなたがたの敵の地で自分の罪のゆえにやせ衰え、また先祖たちの罪のゆえに彼らと同じようにやせ衰えるであろう。"},{"ref":"Lev.26.40","start":3026040,"end":3026040,"break":"paragraph","ruby":[[4,1,"かれ"],[10,2,"じぶん"],[13,1,"つみ"],[16,2,"せんぞ"],[21,1,"つみ"],[32,2,"はんぎゃく"],[42,1,"さか"],[46,1,"あゆ"],[52,2,"こくはく"]],"text":"しかし、彼らがもし、自分の罪と、先祖たちの罪、すなわち、わたしに反逆し、またわたしに逆らって歩んだことを告白するならば、"},{"ref":"Lev.26.41","start":3026041,"end":3026041,"break":"none","ruby":[[7,1,"かれ"],[10,1,"さか"],[14,1,"あゆ"],[17,1,"かれ"],[20,1,"てき"],[22,1,"くに"],[24,1,"ひ"],[27,1,"い"],[34,1,"かれ"],[37,1,"む"],[38,2,"かつれい"],[41,1,"こころ"],[43,1,"くだ"],[52,1,"つみ"],[54,1,"ばつ"],[56,1,"う"]],"text":"たといわたしが彼らに逆らって歩み、彼らを敵の国に引いて行っても、もし彼らの無割礼の心が砕かれ、あまんじて罪の罰を受けるならば、"},{"ref":"Lev.26.42","start":3026042,"end":3026042,"break":"none","ruby":[[12,1,"むす"],[15,2,"けいやく"],[18,1,"おも"],[20,1,"おこ"],[29,1,"むす"],[32,2,"けいやく"],[43,1,"むす"],[46,2,"けいやく"],[49,1,"おも"],[51,1,"おこ"],[58,1,"ち"],[60,1,"おも"],[62,1,"おこ"]],"text":"そのときわたしはヤコブと結んだ契約を思い起し、またイサクと結んだ契約およびアブラハムと結んだ契約を思い起し、またその地を思い起すであろう。"},{"ref":"Lev.26.43","start":3026043,"end":3026043,"break":"none","ruby":[[4,1,"かれ"],[7,1,"ち"],[9,1,"はな"],[12,1,"ち"],[14,1,"あ"],[16,1,"は"],[21,1,"あいだ"],[23,1,"ち"],[27,2,"あんそく"],[30,1,"たの"],[38,1,"かれ"],[49,1,"つみ"],[51,1,"ばつ"],[53,1,"う"],[61,1,"かれ"],[72,1,"かろ"],[76,1,"こころ"],[82,1,"さだ"],[85,1,"い"]],"text":"しかし、彼らが地を離れて地が荒れ果てている間、地はその安息を楽しむであろう。彼らはまた、あまんじて罪の罰を受けるであろう。彼らがわたしのおきてを軽んじ、心にわたしの定めを忌みきらったからである。"},{"ref":"Lev.26.44","start":3026044,"end":3026044,"break":"none","ruby":[[16,1,"かれ"],[19,1,"てき"],[21,1,"くに"],[28,1,"かれ"],[31,1,"す"],[37,1,"い"],[44,1,"かれ"],[47,1,"ほろ"],[50,1,"つく"],[54,1,"かれ"],[57,1,"むす"],[64,2,"けいやく"],[67,1,"やぶ"],[84,1,"かれ"],[87,1,"かみ"],[89,1,"しゅ"]],"text":"それにもかかわらず、なおわたしは彼らが敵の国におるとき、彼らを捨てず、また忌みきらわず、彼らを滅ぼし尽さず、彼らと結んだわたしの契約を破ることをしないであろう。わたしは彼らの神、主だからである。"},{"ref":"Lev.26.45","start":3026045,"end":3026045,"break":"none","ruby":[[4,1,"かれ"],[7,2,"せんぞ"],[12,1,"むす"],[15,2,"けいやく"],[18,1,"かれ"],[24,1,"おも"],[26,1,"おこ"],[33,1,"かれ"],[42,1,"かみ"],[49,2,"くにぐに"],[52,1,"ひと"],[54,1,"め"],[56,1,"まえ"],[64,1,"ち"],[67,1,"みちび"],[69,1,"だ"],[72,1,"もの"],[81,1,"しゅ"]],"text":"わたしは彼らの先祖たちと結んだ契約を彼らのために思い起すであろう。彼らはわたしがその神となるために国々の人の目の前で、エジプトの地から導き出した者である。わたしは主である』」。"},{"ref":"Lev.26.46","start":3026046,"end":3026046,"break":"paragraph","ruby":[[4,1,"しゅ"],[10,1,"さん"],[13,2,"じぶん"],[22,2,"ひとびと"],[26,1,"あいだ"],[36,1,"た"],[41,1,"さだ"],[50,2,"りっぽう"]],"text":"これらは主が、シナイ山で、自分とイスラエルの人々との間に、モーセによって立てられた定めと、おきてと、律法である。"}]