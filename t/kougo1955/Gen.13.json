[{"ref":"Gen.13.1","start":1013001,"end":1013001,"break":"paragraph","ruby":[[5,1,"つま"],[11,1,"も"],[13,1,"もの"],[15,1,"たずさ"],[23,1,"で"],[30,1,"のぼ"],[37,1,"かれ"],[39,1,"とも"],[41,1,"のぼ"]],"text":"アブラムは妻とすべての持ち物を携え、エジプトを出て、ネゲブに上った。ロトも彼と共に上った。"},{"ref":"Gen.13.2","start":1013002,"end":1013002,"break":"paragraph","ruby":[[5,2,"かちく"],[8,2,"きんぎん"],[11,2,"ひじょう"],[14,1,"と"]],"text":"アブラムは家畜と金銀に非常に富んでいた。"},{"ref":"Gen.13.3","start":1013003,"end":1013003,"break":"none","ruby":[[0,1,"かれ"],[7,2,"たびじ"],[10,1,"すす"],[17,1,"む"],[28,1,"あいだ"],[34,2,"てんまく"],[37,1,"は"],[40,1,"ところ"],[42,1,"い"]],"text":"彼はネゲブから旅路を進めてベテルに向かい、ベテルとアイの間の、さきに天幕を張った所に行った。"},{"ref":"Gen.13.4","start":1013004,"end":1013004,"break":"none","ruby":[[4,1,"かれ"],[6,1,"はじ"],[9,1,"きず"],[12,2,"さいだん"],[15,1,"ところ"],[17,1,"い"],[22,1,"ところ"],[29,1,"しゅ"],[31,1,"な"],[33,1,"よ"]],"text":"すなわち彼が初めに築いた祭壇の所に行き、その所でアブラムは主の名を呼んだ。"},{"ref":"Gen.13.5","start":1013005,"end":1013005,"break":"none","ruby":[[5,1,"とも"],[7,1,"い"],[13,1,"ひつじ"],[15,1,"うし"],[19,2,"てんまく"],[22,1,"も"]],"text":"アブラムと共に行ったロトも羊、牛および天幕を持っていた。"},{"ref":"Gen.13.6","start":1013006,"end":1013006,"break":"none","ruby":[[2,1,"ち"],[4,1,"かれ"],[11,1,"とも"],[13,1,"す"],[27,1,"かれ"],[30,2,"ざいさん"],[33,1,"おお"],[40,1,"とも"],[42,1,"す"]],"text":"その地は彼らをささえて共に住ませることができなかった。彼らの財産が多かったため、共に住めなかったのである。"},{"ref":"Gen.13.7","start":1013007,"end":1013007,"break":"none","ruby":[[5,2,"かちく"],[8,2,"ぼくしゃ"],[16,2,"かちく"],[19,2,"ぼくしゃ"],[24,1,"あいだ"],[26,1,"あらそ"],[51,1,"ち"],[53,1,"す"]],"text":"アブラムの家畜の牧者たちとロトの家畜の牧者たちの間に争いがあった。そのころカナンびととペリジびとがその地に住んでいた。"},{"ref":"Gen.13.8","start":1013008,"end":1013008,"break":"paragraph","ruby":[[8,1,"い"],[19,2,"みうち"],[22,1,"もの"],[34,1,"あいだ"],[42,2,"ぼくしゃ"],[51,2,"ぼくしゃ"],[56,1,"あいだ"],[59,1,"あらそ"]],"text":"アブラムはロトに言った、「わたしたちは身内の者です。わたしとあなたの間にも、わたしの牧者たちとあなたの牧者たちの間にも争いがないようにしましょう。"},{"ref":"Gen.13.9","start":1013009,"end":1013009,"break":"none","ruby":[[0,1,"ぜん"],[1,1,"ち"],[7,1,"まえ"],[27,1,"わか"],[39,1,"ひだり"],[41,1,"い"],[48,1,"みぎ"],[50,1,"い"],[59,1,"みぎ"],[61,1,"い"],[68,1,"ひだり"],[70,1,"い"]],"text":"全地はあなたの前にあるではありませんか。どうかわたしと別れてください。あなたが左に行けばわたしは右に行きます。あなたが右に行けばわたしは左に行きましょう」。"},{"ref":"Gen.13.10","start":1013010,"end":1013010,"break":"none","ruby":[[3,1,"め"],[5,1,"あ"],[13,2,"ていち"],[20,1,"み"],[26,1,"しゅ"],[36,1,"ほろ"],[41,1,"まえ"],[54,1,"しゅ"],[56,1,"その"],[69,1,"ち"],[83,1,"うるお"]],"text":"ロトが目を上げてヨルダンの低地をあまねく見わたすと、主がソドムとゴモラを滅ぼされる前であったから、ゾアルまで主の園のように、またエジプトの地のように、すみずみまでよく潤っていた。"},{"ref":"Gen.13.11","start":1013011,"end":1013011,"break":"none","ruby":[[11,2,"ていち"],[19,1,"えら"],[24,1,"ひがし"],[26,1,"うつ"],[34,1,"かれ"],[37,1,"たがい"],[39,1,"わか"]],"text":"そこでロトはヨルダンの低地をことごとく選びとって東に移った。こうして彼らは互に別れた。"},{"ref":"Gen.13.12","start":1013012,"end":1013012,"break":"none","ruby":[[9,1,"ち"],[11,1,"す"],[19,2,"ていち"],[22,2,"まちまち"],[25,1,"す"],[28,2,"てんまく"],[35,1,"うつ"]],"text":"アブラムはカナンの地に住んだが、ロトは低地の町々に住み、天幕をソドムに移した。"},{"ref":"Gen.13.13","start":1013013,"end":1013013,"break":"none","ruby":[[4,2,"ひとびと"],[11,1,"しゅ"],[13,1,"たい"],[23,1,"つみ"]],"text":"ソドムの人々はわるく、主に対して、はなはだしい罪びとであった。"},{"ref":"Gen.13.14","start":1013014,"end":1013014,"break":"paragraph","ruby":[[8,1,"わか"],[11,1,"のち"],[14,1,"しゅ"],[21,1,"い"],[27,1,"め"],[38,1,"ところ"],[41,1,"きた"],[43,1,"みなみ"],[45,1,"ひがし"],[47,1,"にし"],[49,1,"み"]],"text":"ロトがアブラムに別れた後に、主はアブラムに言われた、「目をあげてあなたのいる所から北、南、東、西を見わたしなさい。"},{"ref":"Gen.13.15","start":1013015,"end":1013015,"break":"none","ruby":[[7,1,"み"],[11,1,"ち"],[14,2,"えいきゅう"],[25,2,"しそん"],[28,1,"あた"]],"text":"すべてあなたが見わたす地は、永久にあなたとあなたの子孫に与えます。"},{"ref":"Gen.13.16","start":1013016,"end":1013016,"break":"none","ruby":[[8,2,"しそん"],[11,1,"ち"],[19,1,"おお"],[27,1,"ひと"],[29,1,"ち"],[34,1,"かぞ"],[50,2,"しそん"],[53,1,"かぞ"]],"text":"わたしはあなたの子孫を地のちりのように多くします。もし人が地のちりを数えることができるなら、あなたの子孫も数えられることができましょう。"},{"ref":"Gen.13.17","start":1013017,"end":1013017,"break":"none","ruby":[[4,1,"た"],[10,1,"ち"],[17,1,"い"],[19,1,"めぐ"],[36,1,"あた"]],"text":"あなたは立って、その地をたてよこに行き巡りなさい。わたしはそれをあなたに与えます」。"},{"ref":"Gen.13.18","start":1013018,"end":1013018,"break":"none","ruby":[[5,2,"てんまく"],[8,1,"うつ"],[27,1,"き"],[34,1,"す"],[39,1,"ところ"],[41,1,"しゅ"],[43,2,"さいだん"],[46,1,"きず"]],"text":"アブラムは天幕を移してヘブロンにあるマムレのテレビンの木のかたわらに住み、その所で主に祭壇を築いた。"}]