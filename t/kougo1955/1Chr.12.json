[{"ref":"1Chr.12.1","start":13012001,"end":13012001,"break":"paragraph","ruby":[[7,1,"こ"],[29,1,"とき"],[31,1,"つぎ"],[33,2,"ひとびと"],[36,1,"かれ"],[41,1,"き"],[44,1,"かれ"],[51,1,"たす"],[54,1,"たたか"],[57,2,"ゆうし"]],"text":"ダビデがキシの子サウルにしりぞけられて、なおチクラグにいた時、次の人々が彼のもとに来た。彼らはダビデを助けて戦った勇士たちのうちにあり、"},{"ref":"1Chr.12.2","start":13012002,"end":13012002,"break":"none","ruby":[[0,1,"ゆみ"],[6,1,"もの"],[8,2,"さゆう"],[14,1,"て"],[22,1,"や"],[24,1,"い"],[26,1,"いし"],[28,1,"な"],[31,1,"もの"],[50,2,"どうぞく"]],"text":"弓をよくする者、左右いずれの手をもってもよく矢を射、石を投げる者で、ともにベニヤミンびとで、サウルの同族である。"},{"ref":"1Chr.12.3","start":13012003,"end":13012003,"break":"none","ruby":[[12,1,"つぎ"],[25,2,"しゅっしん"],[32,1,"こ"],[60,1,"こ"],[79,2,"しゅっしん"]],"text":"そのかしらはアヒエゼル、次はヨアシで、ともにギベア出身のシマアの子たちである。またエジエルとペレテで、ともにアズマウテの子たちである。またベラカおよびアナトテ出身のエヒウ。"},{"ref":"1Chr.12.4","start":13012004,"end":13012004,"break":"none","ruby":[[6,2,"しゅっしん"],[14,1,"かれ"],[18,1,"にん"],[23,2,"ゆうし"],[31,1,"にん"],[33,1,"ちょう"],[59,2,"しゅっしん"]],"text":"またギベオン出身のイシマヤ、彼は三十人のうちの勇士で、その三十人の長である。またエレミヤ、ヤハジエル、ヨハナン、ゲデラ出身のヨザバデ、"},{"ref":"1Chr.12.5","start":13012005,"end":13012005,"break":"none","text":"エルザイ、エリモテ、ベアリヤ、シマリヤ、ハリフびとシパテヤ、"},{"ref":"1Chr.12.6","start":13012006,"end":13012006,"break":"none","text":"エルカナ、イシア、アザリエル、ヨエゼル、ヤショベアムで、これらはコラびとである。"},{"ref":"1Chr.12.7","start":13012007,"end":13012007,"break":"none","ruby":[[11,1,"こ"]],"text":"またゲドルのエロハムの子たちであるヨエラおよびゼバデヤである。"},{"ref":"1Chr.12.8","start":13012008,"end":13012008,"break":"paragraph","ruby":[[9,2,"あらの"],[12,2,"ようがい"],[15,1,"き"],[25,1,"もの"],[27,1,"みな"],[28,2,"ゆうし"],[34,1,"たたか"],[36,2,"ぐんじん"],[41,1,"たて"],[49,1,"もの"],[53,1,"かお"],[58,1,"かお"],[66,1,"はや"],[71,1,"やま"]],"text":"ガドびとのうちから荒野の要害に来て、ダビデについた者は皆勇士で、よく戦う軍人、よく盾とやりをつかう者、その顔はししの顔のようで、その速いことは山にいるしかのようであった。"},{"ref":"1Chr.12.9","start":13012009,"end":13012009,"break":"none","ruby":[[0,1,"かれ"],[11,1,"つぎ"],[18,1,"だい"]],"text":"彼らのかしらはエゼル、次はオバデヤ、第三はエリアブ、"},{"ref":"1Chr.12.10","start":13012010,"end":13012010,"break":"none","ruby":[[0,1,"だい"],[9,1,"だい"]],"text":"第四はミシマンナ、第五はエレミヤ、"},{"ref":"1Chr.12.11","start":13012011,"end":13012011,"break":"none","ruby":[[0,1,"だい"],[8,1,"だい"]],"text":"第六はアッタイ、第七はエリエル、"},{"ref":"1Chr.12.12","start":13012012,"end":13012012,"break":"none","ruby":[[0,1,"だい"],[8,1,"だい"]],"text":"第八はヨナハン、第九はエルザバデ、"},{"ref":"1Chr.12.13","start":13012013,"end":13012013,"break":"none","ruby":[[0,1,"だい"],[8,1,"だい"]],"text":"第十はエレミヤ、第十一はマクバナイである。"},{"ref":"1Chr.12.14","start":13012014,"end":13012014,"break":"none","ruby":[[7,2,"しそん"],[10,2,"ぐんぜい"],[13,1,"ちょう"],[16,1,"もの"],[20,1,"もっと"],[22,1,"ちい"],[25,1,"もの"],[29,1,"にん"],[31,1,"あた"],[36,1,"もっと"],[38,1,"おお"],[42,1,"もの"],[45,1,"にん"],[47,1,"あた"]],"text":"これらはガドの子孫で軍勢の長たる者、その最も小さい者でも百人に当り、その最も大いなる者は千人に当った。"},{"ref":"1Chr.12.15","start":13012015,"end":13012015,"break":"none","ruby":[[0,2,"しょうがつ"],[10,1,"ぜん"],[11,1,"きし"],[20,1,"かれ"],[26,1,"わた"],[30,2,"たにだに"],[35,1,"もの"],[42,1,"ひがし"],[44,1,"にし"],[46,1,"に"],[48,1,"はし"]],"text":"正月、ヨルダンがその全岸にあふれたとき、彼らはこれを渡って、谷々にいる者をことごとく東に西に逃げ走らせた。"},{"ref":"1Chr.12.16","start":13012016,"end":13012016,"break":"paragraph","ruby":[[9,2,"しそん"],[15,2,"ひとびと"],[18,2,"ようがい"],[21,1,"き"]],"text":"ベニヤミンとユダの子孫のうちの人々が要害に来て、ダビデについた。"},{"ref":"1Chr.12.17","start":13012017,"end":13012017,"break":"none","ruby":[[4,1,"で"],[6,1,"かれ"],[9,1,"むか"],[12,1,"い"],[23,2,"こうい"],[34,1,"たす"],[40,1,"き"],[51,1,"こころ"],[79,1,"て"],[84,2,"あくじ"],[105,1,"あざむ"],[109,1,"てき"],[111,1,"わた"],[127,2,"せんぞ"],[130,1,"かみ"],[148,1,"せ"]],"text":"ダビデは出て彼らを迎えて言った、「あなたがたが好意をもって、わたしを助けるために来たのならば、わたしの心もあなたがたと、ひとつになりましょう。しかし、わたしの手になんの悪事もないのに、もしあなたがたが、わたしを欺いて、敵に渡すためであるならば、われわれの先祖の神がどうぞみそなわして、あなたがたを責められますように」。"},{"ref":"1Chr.12.18","start":13012018,"end":13012018,"break":"none","breaks":[[26,"stanza"],[44,"line"],[66,"line"],[80,"line"],[94,"line"]],"ruby":[[0,1,"とき"],[2,1,"れい"],[6,1,"にん"],[8,1,"ちょう"],[14,1,"のぞ"],[22,1,"い"],[49,1,"こ"],[61,1,"とも"],[66,2,"へいあん"],[75,2,"へいあん"],[84,1,"たす"],[87,1,"もの"],[89,2,"へいあん"],[98,1,"かみ"],[104,1,"たす"],[118,1,"かれ"],[121,1,"う"],[126,2,"ぶたい"],[129,1,"ちょう"]],"text":"時に霊が三十人の長アマサイに臨み、アマサイは言った、「ダビデよ、われわれはあなたのもの。エッサイの子よ、われわれはあなたと共にある。平安あれ、あなたに平安あれ。あなたを助ける者に平安あれ。あなたの神があなたを助けられる」。そこでダビデは彼らを受けいれて部隊の長とした。"},{"ref":"1Chr.12.19","start":13012019,"end":13012019,"break":"paragraph","ruby":[[14,1,"とも"],[20,1,"たたか"],[24,1,"せ"],[27,1,"き"],[37,2,"すうにん"],[66,1,"たす"],[83,1,"きみ"],[87,1,"あい"],[94,1,"かれ"],[101,1,"くび"],[109,2,"しゅくん"],[118,1,"かえ"],[126,1,"い"],[130,1,"かれ"],[132,1,"さ"]],"text":"さきにダビデがペリシテびとと共にサウルと戦おうと攻めて来たとき、マナセびと数人がダビデについた。（ただしダビデはついにペリシテびとを助けなかった。それはペリシテびとの君たちが相はかって、「彼はわれわれの首をとって、その主君サウルのもとに帰るであろう」と言って、彼を去らせたからである。）"},{"ref":"1Chr.12.20","start":13012020,"end":13012020,"break":"none","ruby":[[9,1,"い"],[54,1,"かれ"],[60,1,"みな"],[68,1,"にん"],[70,1,"ちょう"]],"text":"ダビデがチクラグへ行ったとき、マナセびとアデナ、ヨザバデ、エデアエル、ミカエル、ヨザバデ、エリウ、ヂルタイが彼についた。皆マナセびとの千人の長であった。"},{"ref":"1Chr.12.21","start":13012021,"end":13012021,"break":"none","ruby":[[0,1,"かれ"],[7,1,"たす"],[10,1,"てき"],[11,1,"ぐん"],[13,1,"あた"],[17,1,"かれ"],[20,1,"みな"],[21,1,"だい"],[22,2,"ゆうし"],[25,2,"ぐんぜい"],[28,1,"ちょう"]],"text":"彼らはダビデを助けて敵軍に当った。彼らは皆大勇士で軍勢の長であった。"},{"ref":"1Chr.12.22","start":13012022,"end":13012022,"break":"none","ruby":[[4,1,"たす"],[7,1,"もの"],[9,1,"ひ"],[11,1,"ひ"],[13,1,"くわ"],[21,2,"たいぐん"],[27,1,"かみ"],[29,2,"ぐんぜい"]],"text":"ダビデを助ける者が日に日に加わって、ついに大軍となり、神の軍勢のようになった。"},{"ref":"1Chr.12.23","start":13012023,"end":13012023,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[5,1,"したが"],[12,1,"くに"],[18,1,"あた"],[40,1,"き"],[42,2,"ぶそう"],[46,2,"ぐんたい"],[49,1,"かず"],[52,1,"つぎ"]],"text":"主の言葉に従い、サウルの国をダビデに与えようとして、ヘブロンにいるダビデのもとに来た武装した軍隊の数は、次のとおりである。"},{"ref":"1Chr.12.24","start":13012024,"end":13012024,"break":"none","ruby":[[3,2,"しそん"],[6,1,"たて"],[14,2,"ぶそう"],[18,1,"もの"],[23,1,"にん"]],"text":"ユダの子孫で盾とやりをとり、武装した者六千八百人、"},{"ref":"1Chr.12.25","start":13012025,"end":13012025,"break":"none","ruby":[[5,2,"しそん"],[11,1,"たたか"],[13,2,"ゆうし"],[18,1,"にん"]],"text":"シメオンの子孫で、よく戦う勇士七千百人、"},{"ref":"1Chr.12.26","start":13012026,"end":13012026,"break":"none","ruby":[[3,2,"しそん"],[12,1,"にん"]],"text":"レビの子孫からは四千六百人。"},{"ref":"1Chr.12.27","start":13012027,"end":13012027,"break":"none","ruby":[[9,1,"いえ"],[16,1,"かれ"],[18,1,"ぞく"],[21,1,"もの"],[27,1,"にん"]],"text":"エホヤダはアロンの家のつかさで、彼に属する者は三千七百人。"},{"ref":"1Chr.12.28","start":13012028,"end":13012028,"break":"none","ruby":[[4,1,"ねん"],[5,1,"わか"],[7,2,"ゆうし"],[11,1,"かれ"],[13,2,"しぞく"],[17,1,"で"],[19,2,"しょうぐん"],[25,1,"にん"]],"text":"ザドクは年若い勇士で、彼の氏族から出た将軍は二十二人。"},{"ref":"1Chr.12.29","start":13012029,"end":13012029,"break":"none","ruby":[[4,2,"どうぞく"],[13,2,"しそん"],[20,1,"にん"],[30,1,"おお"],[39,1,"いえ"],[41,2,"ちゅうぎ"]],"text":"サウルの同族、ベニヤミンの子孫からは三千人、ベニヤミンびとの多くはなおサウルの家に忠義をつくしていた。"},{"ref":"1Chr.12.30","start":13012030,"end":13012030,"break":"none","ruby":[[6,2,"しそん"],[15,1,"にん"],[17,1,"みな"],[18,2,"ゆうし"],[24,2,"しぞく"],[27,1,"な"],[30,2,"ひとびと"]],"text":"エフライムの子孫からは二万八百人、皆勇士で、その氏族の名ある人々であった。"},{"ref":"1Chr.12.31","start":13012031,"end":13012031,"break":"none","ruby":[[4,1,"はん"],[5,2,"ぶぞく"],[14,1,"にん"],[16,1,"みな"],[21,1,"おう"],[23,1,"た"],[30,1,"のぼ"],[33,1,"き"],[36,1,"な"],[42,1,"もの"]],"text":"マナセの半部族からは一万八千人、皆ダビデを王に立てようとして上って来て、名をつらねた者である。"},{"ref":"1Chr.12.32","start":13012032,"end":13012032,"break":"none","ruby":[[6,2,"しそん"],[13,2,"じせい"],[16,1,"つう"],[37,2,"ひとびと"],[40,1,"き"],[45,1,"ちょう"],[48,1,"もの"],[52,1,"にん"],[59,2,"きょうだい"],[64,1,"みな"],[67,2,"しき"],[70,1,"したが"]],"text":"イッサカルの子孫からはよく時勢に通じ、イスラエルのなすべきことをわきまえた人々が来た。その長たる者が二百人あって、その兄弟たちは皆その指揮に従った。"},{"ref":"1Chr.12.33","start":13012033,"end":13012033,"break":"none","ruby":[[9,1,"にん"],[11,1,"みな"],[12,2,"くんれん"],[15,1,"へ"],[17,2,"ぐんたい"],[26,2,"ぶぐ"],[29,1,"み"],[35,2,"いっしん"],[42,1,"たす"],[45,1,"もの"]],"text":"ゼブルンからは五万人、皆訓練を経た軍隊で、もろもろの武具で身をよろい、一心にダビデを助けた者である。"},{"ref":"1Chr.12.34","start":13012034,"end":13012034,"break":"none","ruby":[[7,1,"しょう"],[10,1,"もの"],[13,1,"にん"],[17,1,"たて"],[28,1,"したが"],[30,1,"もの"],[35,1,"にん"]],"text":"ナフタリからは将たる者一千人および盾とやりをとってこれに従う者三万七千人。"},{"ref":"1Chr.12.35","start":13012035,"end":13012035,"break":"none","ruby":[[7,2,"ぶそう"],[11,1,"もの"],[18,1,"にん"]],"text":"ダンびとからは武装した者二万八千六百人。"},{"ref":"1Chr.12.36","start":13012036,"end":13012036,"break":"none","ruby":[[6,1,"たたか"],[9,1,"そな"],[14,2,"じゅくれん"],[17,1,"もの"],[20,1,"にん"]],"text":"アセルからは戦いの備えをした熟練の者四万人。"},{"ref":"1Chr.12.37","start":13012037,"end":13012037,"break":"none","ruby":[[25,1,"はん"],[26,2,"ぶぞく"],[36,2,"ぶぐ"],[39,1,"み"],[45,1,"もの"],[49,1,"にん"]],"text":"またヨルダンのかなたルベンびと、ガドびと、マナセの半部族からはもろもろの武具で身をよろった者十二万人であった。"},{"ref":"1Chr.12.38","start":13012038,"end":13012038,"break":"paragraph","ruby":[[7,1,"たたか"],[10,1,"そな"],[22,2,"まごころ"],[33,1,"き"],[40,1,"ぜん"],[47,1,"おう"],[72,1,"こころ"],[84,1,"おう"]],"text":"すべてこれらの戦いの備えをしたいくさびとらは真心をもってヘブロンに来て、ダビデを全イスラエルの王にしようとした。このほかのイスラエルびともまた、心をひとつにしてダビデを王にしようとした。"},{"ref":"1Chr.12.39","start":13012039,"end":13012039,"break":"none","ruby":[[0,1,"かれ"],[16,1,"か"],[20,1,"く"],[22,1,"の"],[29,2,"きょうだい"],[34,1,"かれ"],[40,1,"そな"]],"text":"彼らはヘブロンにダビデとともに三日いて、食い飲みした。その兄弟たちは彼らのために備えをしたからである。"},{"ref":"1Chr.12.40","start":13012040,"end":13012040,"break":"none","ruby":[[2,1,"かれ"],[5,1,"ちか"],[7,2,"ひとびと"],[28,1,"とお"],[30,1,"ところ"],[32,1,"もの"],[43,2,"らば"],[46,1,"うし"],[50,2,"しょくもつ"],[53,1,"お"],[57,1,"き"],[64,2,"むぎこ"],[67,2,"しょくもつ"],[70,1,"ひ"],[76,1,"ほし"],[84,1,"しゅ"],[86,1,"あぶら"],[88,1,"うし"],[90,1,"ひつじ"],[94,1,"おお"],[96,1,"たずさ"],[99,1,"き"],[111,1,"よろこ"]],"text":"また彼らに近い人々はイッサカル、ゼブルン、ナフタリなどの遠い所の者まで、ろば、らくだ、騾馬、牛などに食物を負わせて来た。すなわち麦粉の食物、干いちじく、干ぶどう、ぶどう酒、油、牛、羊などを多く携えて来た。これはイスラエルに喜びがあったからである。"}]