[{"ref":"Deut.21.1","start":5021001,"end":5021001,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"あた"],[11,1,"え"],[17,1,"ち"],[20,1,"ころ"],[24,1,"の"],[26,1,"たお"],[31,1,"ひと"],[40,1,"ころ"],[50,1,"とき"]],"text":"あなたの神、主が与えて獲させられる地で、殺されて野に倒れている人があって、だれが殺したのかわからない時は、"},{"ref":"Deut.21.2","start":5021002,"end":5021002,"break":"none","ruby":[[0,2,"ちょうろう"],[14,1,"で"],[21,1,"ころ"],[25,1,"もの"],[29,1,"ところ"],[33,2,"しゅうい"],[36,2,"まちまち"],[41,2,"きょり"]],"text":"長老たちと、さばきびとたちが出てきて、その殺された者のある所から、周囲の町々までの距離をはからなければならない。"},{"ref":"Deut.21.3","start":5021003,"end":5021003,"break":"none","ruby":[[5,1,"ころ"],[9,1,"もの"],[13,1,"ところ"],[15,1,"もっと"],[17,1,"ちか"],[19,1,"まち"],[21,2,"ちょうろう"],[29,1,"つか"],[40,1,"お"],[44,1,"ひ"],[52,1,"わか"],[54,2,"めうし"]],"text":"そしてその殺された者のある所に最も近い町の長老たちは、まだ使わない、まだくびきを負わせて引いたことのない若い雌牛をとり、"},{"ref":"Deut.21.4","start":5021004,"end":5021004,"break":"none","ruby":[[2,1,"まち"],[4,2,"ちょうろう"],[11,2,"めうし"],[15,1,"たがや"],[21,1,"たね"],[31,1,"た"],[34,1,"みず"],[36,1,"なが"],[41,1,"たに"],[43,1,"ひ"],[52,1,"たに"],[54,2,"めうし"],[60,1,"お"]],"text":"その町の長老たちはその雌牛を、耕すことも、種まくこともしない、絶えず水の流れている谷へ引いていって、その谷で雌牛のくびを折らなければならない。"},{"ref":"Deut.21.5","start":5021005,"end":5021005,"break":"none","ruby":[[2,1,"とき"],[6,2,"しそん"],[11,2,"さいし"],[20,1,"すす"],[22,1,"で"],[32,1,"かれ"],[39,1,"かみ"],[41,1,"しゅ"],[43,2,"じぶん"],[46,1,"つか"],[53,1,"しゅ"],[55,1,"な"],[60,2,"しゅくふく"],[68,1,"えら"],[72,1,"もの"],[79,2,"ろんそう"],[87,2,"ぼうこう"],[90,1,"かれ"],[93,2,"ことば"],[99,2,"かいけつ"]],"text":"その時レビの子孫である祭司たちは、そこに進み出なければならない。彼らはあなたの神、主が自分に仕えさせ、また主の名によって祝福させるために選ばれた者で、すべての論争と、すべての暴行は彼らの言葉によって解決されるからである。"},{"ref":"Deut.21.6","start":5021006,"end":5021006,"break":"none","ruby":[[5,1,"ころ"],[9,1,"もの"],[13,1,"ところ"],[15,1,"もっと"],[17,1,"ちか"],[19,1,"まち"],[21,2,"ちょうろう"],[26,1,"みな"],[28,1,"かれ"],[31,1,"たに"],[36,1,"お"],[39,2,"めうし"],[42,1,"うえ"],[44,1,"て"],[46,1,"あら"]],"text":"そしてその殺された者のある所に最も近い町の長老たちは皆、彼らが谷でくびを折った雌牛の上で手を洗い、"},{"ref":"Deut.21.7","start":5021007,"end":5021007,"break":"none","ruby":[[0,2,"しょうげん"],[4,1,"い"],[21,1,"て"],[25,1,"ち"],[27,1,"なが"],[36,1,"め"],[41,1,"み"]],"text":"証言して言わなければならない、『われわれの手はこの血を流さず、われわれの目もそれを見なかった。"},{"ref":"Deut.21.8","start":5021008,"end":5021008,"break":"none","ruby":[[0,1,"しゅ"],[13,1,"たみ"],[29,1,"つみ"],[33,1,"もの"],[35,1,"ち"],[37,1,"なが"],[48,1,"たみ"],[72,1,"ち"],[74,1,"なが"]],"text":"主よ、あなたがあがなわれた民イスラエルをおゆるしください。罪のない者の血を流したとがを、あなたの民イスラエルのうちにとどめないでください。そして血を流したとがをおゆるしください』。"},{"ref":"Deut.21.9","start":5021009,"end":5021009,"break":"none","ruby":[[12,1,"しゅ"],[14,1,"ただ"],[18,1,"み"],[22,1,"こと"],[29,1,"つみ"],[33,1,"もの"],[35,1,"ち"],[37,1,"なが"],[54,1,"のぞ"],[56,1,"さ"]],"text":"このようにして、あなたは主が正しいと見られる事をおこない、罪のない者の血を流したとがを、あなたがたのうちから除き去らなければならない。"},{"ref":"Deut.21.10","start":5021010,"end":5021010,"break":"paragraph","ruby":[[4,1,"で"],[6,1,"てき"],[8,1,"たたか"],[10,1,"さい"],[16,1,"かみ"],[18,1,"しゅ"],[27,1,"て"],[41,2,"ほりょ"],[46,1,"とき"]],"text":"あなたが出て敵と戦う際、あなたの神、主がそれをあなたの手にわたされ、あなたがそれを捕虜とした時、"},{"ref":"Deut.21.11","start":5021011,"end":5021011,"break":"none","ruby":[[2,2,"ほりょ"],[8,1,"うつく"],[11,1,"おんな"],[17,1,"み"],[23,1,"この"],[26,1,"つま"]],"text":"もし捕虜のうちに美しい女のあるのを見て、それを好み、妻にめとろうとするならば、"},{"ref":"Deut.21.12","start":5021012,"end":5021012,"break":"none","ruby":[[2,1,"おんな"],[8,1,"いえ"],[10,1,"つ"],[13,1,"かえ"],[24,1,"おんな"],[26,1,"かみ"],[34,1,"き"]],"text":"その女をあなたの家に連れて帰らなければならない。女は髪をそり、つめを切り、"},{"ref":"Deut.21.13","start":5021013,"end":5021013,"break":"none","ruby":[[2,2,"ほりょ"],[5,2,"きもの"],[8,1,"ぬ"],[18,1,"いえ"],[23,2,"じぶん"],[26,2,"ふぼ"],[34,1,"げつ"],[39,1,"なげ"],[53,1,"のち"],[59,2,"かのじょ"],[62,1,"ところ"],[71,1,"おっと"],[76,2,"かのじょ"],[79,1,"つま"]],"text":"また捕虜の着物を脱ぎすてて、あなたの家におり、自分の父母のために一か月のあいだ嘆かなければならない。そして後、あなたは彼女の所にはいって、その夫となり、彼女を妻とすることができる。"},{"ref":"Deut.21.14","start":5021014,"end":5021014,"break":"none","ruby":[[2,1,"のち"],[9,2,"かのじょ"],[12,1,"この"],[23,2,"かのじょ"],[26,2,"じゆう"],[29,1,"さ"],[41,1,"けっ"],[44,1,"かね"],[46,1,"う"],[62,2,"かのじょ"],[76,2,"かのじょ"],[79,2,"どれい"]],"text":"その後あなたがもし彼女を好まなくなったならば、彼女を自由に去らせなければならない。決して金で売ってはならない。あなたはすでに彼女をはずかしめたのだから、彼女を奴隷のようにあしらってはならない。"},{"ref":"Deut.21.15","start":5021015,"end":5021015,"break":"paragraph","ruby":[[0,1,"ひと"],[6,1,"つま"],[17,1,"あい"],[20,1,"もの"],[26,1,"き"],[32,1,"もの"],[40,1,"あい"],[43,1,"もの"],[45,1,"き"],[51,1,"もの"],[61,1,"おとこ"],[63,1,"こ"],[65,1,"う"],[72,2,"ちょうし"],[76,1,"き"],[82,1,"おんな"],[84,1,"う"],[87,1,"もの"],[91,1,"とき"]],"text":"人がふたりの妻をもち、そのひとりは愛する者、ひとりは気にいらない者であって、その愛する者と気にいらない者のふたりが、ともに男の子を産み、もしその長子が、気にいらない女の産んだ者である時は、"},{"ref":"Deut.21.16","start":5021016,"end":5021016,"break":"none","ruby":[[2,1,"こ"],[6,2,"じぶん"],[9,2,"ざいさん"],[12,1,"つ"],[16,1,"とき"],[18,1,"き"],[24,1,"おんな"],[26,1,"う"],[29,2,"ちょうし"],[38,1,"あい"],[41,1,"おんな"],[43,1,"う"],[46,1,"こ"],[48,2,"ちょうし"]],"text":"その子たちに自分の財産を継がせる時、気にいらない女の産んだ長子をさしおいて、愛する女の産んだ子を長子とすることはできない。"},{"ref":"Deut.21.17","start":5021017,"end":5021017,"break":"none","ruby":[[0,1,"かなら"],[4,1,"き"],[10,1,"もの"],[12,1,"う"],[15,1,"こ"],[17,2,"ちょうし"],[25,1,"みと"],[28,2,"じぶん"],[31,2,"ざいさん"],[34,1,"わ"],[37,1,"とき"],[45,1,"ばい"],[47,1,"わ"],[49,1,"まえ"],[51,1,"あた"],[65,2,"じぶん"],[68,1,"ちから"],[70,1,"はじ"],[77,2,"ちょうし"],[80,2,"とっけん"],[83,1,"も"]],"text":"必ずその気にいらない者の産んだ子が長子であることを認め、自分の財産を分ける時には、これに二倍の分け前を与えなければならない。これは自分の力の初めであって、長子の特権を持っているからである。"},{"ref":"Deut.21.18","start":5021018,"end":5021018,"break":"paragraph","ruby":[[9,1,"て"],[11,1,"お"],[15,1,"こ"],[21,1,"ちち"],[23,2,"ことば"],[28,1,"はは"],[30,2,"ことば"],[34,1,"したが"],[38,2,"ふぼ"],[44,1,"こ"],[53,1,"とき"]],"text":"もし、わがままで、手に負えない子があって、父の言葉にも、母の言葉にも従わず、父母がこれを懲らしてもきかない時は、"},{"ref":"Deut.21.19","start":5021019,"end":5021019,"break":"none","ruby":[[2,2,"ふぼ"],[8,1,"とら"],[14,1,"まち"],[16,1,"もん"],[18,1,"い"],[21,1,"まち"],[23,2,"ちょうろう"],[28,1,"まえ"],[30,1,"だ"]],"text":"その父母はこれを捕えて、その町の門に行き、町の長老たちの前に出し、"},{"ref":"Deut.21.20","start":5021020,"end":5021020,"break":"none","ruby":[[0,1,"まち"],[2,2,"ちょうろう"],[7,1,"い"],[27,1,"こ"],[35,1,"て"],[37,1,"お"],[49,2,"ことば"],[52,1,"したが"],[56,2,"みも"],[60,1,"わる"],[63,1,"だい"],[64,2,"さけの"]],"text":"町の長老たちに言わなければならない、『わたしたちのこの子はわがままで、手に負えません。わたしたちの言葉に従わず、身持ちが悪く、大酒飲みです』。"},{"ref":"Deut.21.21","start":5021021,"end":5021021,"break":"none","ruby":[[5,1,"まち"],[7,1,"ひと"],[9,1,"みな"],[11,1,"かれ"],[13,1,"いし"],[15,1,"う"],[17,1,"ころ"],[30,1,"あく"],[32,1,"のぞ"],[34,1,"さ"],[57,1,"みな"],[58,1,"き"],[61,1,"おそ"]],"text":"そのとき、町の人は皆、彼を石で撃ち殺し、あなたがたのうちから悪を除き去らなければならない。そうすれば、イスラエルは皆聞いて恐れるであろう。"},{"ref":"Deut.21.22","start":5021022,"end":5021022,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"し"],[9,1,"つみ"],[11,1,"おか"],[14,1,"ころ"],[25,1,"き"],[27,1,"うえ"],[32,1,"とき"]],"text":"もし人が死にあたる罪を犯して殺され、あなたがそれを木の上にかける時は、"},{"ref":"Deut.21.23","start":5021023,"end":5021023,"break":"none","ruby":[[0,2,"よくあさ"],[6,2,"したい"],[9,1,"き"],[11,1,"うえ"],[13,1,"と"],[25,1,"かなら"],[32,1,"ひ"],[37,1,"う"],[48,1,"き"],[55,1,"もの"],[57,1,"かみ"],[64,1,"もの"],[76,1,"かみ"],[78,1,"しゅ"],[80,1,"し"],[81,1,"ぎょう"],[85,1,"たま"],[88,1,"ち"],[90,1,"けが"]],"text":"翌朝までその死体を木の上に留めておいてはならない。必ずそれをその日のうちに埋めなければならない。木にかけられた者は神にのろわれた者だからである。あなたの神、主が嗣業として賜わる地を汚してはならない。"}]