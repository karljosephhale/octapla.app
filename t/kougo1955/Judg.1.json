[{"ref":"Judg.1.1","start":7001001,"end":7001001,"break":"paragraph","ruby":[[5,1,"し"],[8,1,"のち"],[16,2,"ひとびと"],[19,1,"しゅ"],[21,1,"と"],[24,1,"い"],[41,1,"さき"],[43,1,"せ"],[45,1,"のぼ"],[55,1,"たたか"]],"text":"ヨシュアが死んだ後、イスラエルの人々は主に問うて言った、「わたしたちのうち、だれが先に攻め上って、カナンびとと戦いましょうか」。"},{"ref":"Judg.1.2","start":7001002,"end":7001002,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"のぼ"],[25,1,"くに"],[27,1,"かれ"],[29,1,"て"]],"text":"主は言われた、「ユダが上るべきである。わたしはこの国を彼の手にわたした」。"},{"ref":"Judg.1.3","start":7001003,"end":7001003,"break":"none","ruby":[[5,2,"きょうだい"],[12,1,"い"],[21,2,"いっしょ"],[29,1,"わ"],[31,1,"あ"],[36,2,"りょうち"],[39,1,"のぼ"],[42,1,"い"],[52,1,"たたか"],[73,2,"いっしょ"],[81,1,"わ"],[83,1,"あ"],[88,2,"りょうち"],[91,1,"い"],[107,1,"かれ"],[109,2,"いっしょ"],[112,1,"い"]],"text":"ユダはその兄弟シメオンに言った、「わたしと一緒に、わたしに割り当てられた領地へ上って行って、カナンびとと戦ってください。そうすればわたしもあなたと一緒に、あなたに割り当てられた領地へ行きましょう」。そこでシメオンは彼と一緒に行った。"},{"ref":"Judg.1.4","start":7001004,"end":7001004,"break":"none","ruby":[[3,1,"のぼ"],[6,1,"い"],[10,1,"しゅ"],[12,1,"かれ"],[15,1,"て"],[38,1,"かれ"],[47,1,"にん"],[49,1,"う"],[51,1,"やぶ"]],"text":"ユダが上って行くと、主は彼らの手にカナンびととペリジびととをわたされたので、彼らはベゼクで一万人を撃ち破り、"},{"ref":"Judg.1.5","start":7001005,"end":7001005,"break":"none","ruby":[[13,1,"あ"],[16,1,"かれ"],[18,1,"たたか"],[34,1,"う"],[36,1,"やぶ"]],"text":"またベゼクでアドニベゼクに会い、彼と戦ってカナンびととペリジびととを撃ち破った。"},{"ref":"Judg.1.6","start":7001006,"end":7001006,"break":"none","ruby":[[7,1,"に"],[12,1,"かれ"],[20,1,"お"],[23,1,"かれ"],[25,1,"とら"],[30,2,"てあし"],[33,2,"おやゆび"],[36,1,"き"],[38,1,"はな"]],"text":"アドニベゼクは逃げたが、彼らはそのあとを追って彼を捕え、その手足の親指を切り放った。"},{"ref":"Judg.1.7","start":7001007,"end":7001007,"break":"none","ruby":[[7,1,"い"],[17,1,"にん"],[19,1,"おう"],[23,2,"てあし"],[26,2,"おやゆび"],[29,1,"き"],[38,2,"しょくたく"],[41,1,"した"],[47,1,"ひろ"],[58,1,"かみ"],[74,1,"むく"],[83,2,"ひとびと"],[86,1,"かれ"],[94,1,"つ"],[97,1,"い"],[102,1,"かれ"],[107,1,"し"]],"text":"アドニベゼクは言った、「かつて七十人の王たちが手足の親指を切られて、わたしの食卓の下で、くずを拾ったことがあったが、神はわたしがしたように、わたしに報いられたのだ」。人々は彼をエルサレムへ連れて行ったが、彼はそこで死んだ。"},{"ref":"Judg.1.8","start":7001008,"end":7001008,"break":"paragraph","ruby":[[3,2,"ひとびと"],[12,1,"せ"],[19,1,"と"],[32,1,"う"],[35,1,"まち"],[37,1,"ひ"],[39,1,"はな"]],"text":"ユダの人々はエルサレムを攻めて、これを取り、つるぎをもってこれを撃ち、町に火を放った。"},{"ref":"Judg.1.9","start":7001009,"end":7001009,"break":"none","ruby":[[2,1,"のち"],[7,2,"ひとびと"],[10,2,"さんち"],[17,2,"へいち"],[20,1,"す"],[31,1,"たたか"],[36,1,"くだ"]],"text":"その後、ユダの人々は山地とネゲブと平地に住んでいるカナンびとと戦うために下ったが、"},{"ref":"Judg.1.10","start":7001010,"end":7001010,"break":"none","ruby":[[10,1,"す"],[21,1,"せ"],[40,1,"う"],[42,1,"やぶ"],[54,1,"な"]],"text":"ユダはまずヘブロンに住んでいるカナンびとを攻めて、セシャイとアヒマンとタルマイを撃ち破った。ヘブロンのもとの名はキリアテ・アルバであった。"},{"ref":"Judg.1.11","start":7001011,"end":7001011,"break":"paragraph","ruby":[[6,1,"すす"],[13,2,"じゅうみん"],[16,1,"せ"],[28,1,"な"]],"text":"またそこから進んでデビルの住民を攻めた。（デビルのもとの名はキリアテ・セペルであった。）"},{"ref":"Judg.1.12","start":7001012,"end":7001012,"break":"none","ruby":[[0,1,"とき"],[6,1,"い"],[20,1,"う"],[27,1,"と"],[29,1,"もの"],[37,1,"むすめ"],[42,1,"つま"],[46,1,"あた"]],"text":"時にカレブは言った、「キリアテ・セペルを撃って、これを取る者には、わたしの娘アクサを妻として与えるであろう」。"},{"ref":"Judg.1.13","start":7001013,"end":7001013,"break":"none","ruby":[[4,1,"おとうと"],[9,1,"こ"],[19,1,"と"],[29,1,"むすめ"],[34,1,"つま"],[38,1,"かれ"],[40,1,"あた"]],"text":"カレブの弟ケナズの子オテニエルがそれを取ったので、カレブは娘アクサを妻として彼に与えた。"},{"ref":"Judg.1.14","start":7001014,"end":7001014,"break":"none","ruby":[[4,1,"い"],[8,2,"かのじょ"],[11,1,"ちち"],[13,1,"はたけ"],[15,1,"もと"],[21,1,"おっと"],[40,1,"お"],[49,2,"かのじょ"],[52,1,"い"],[61,1,"なに"],[63,1,"のぞ"]],"text":"アクサは行くとき彼女の父に畑を求めることを夫にすすめられたので、アクサがろばから降りると、カレブは彼女に言った、「あなたは何を望むのか」。"},{"ref":"Judg.1.15","start":7001015,"end":7001015,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[15,1,"おく"],[17,1,"もの"],[36,1,"ち"],[48,1,"いずみ"],[64,1,"うえ"],[66,1,"いずみ"],[68,1,"した"],[70,1,"いずみ"],[73,2,"かのじょ"],[76,1,"あた"]],"text":"アクサは彼に言った、「わたしに贈り物をください。あなたはわたしをネゲブの地へやられるのですから、泉をもください」。それでカレブは上の泉と下の泉とを彼女に与えた。"},{"ref":"Judg.1.16","start":7001016,"end":7001016,"break":"paragraph","ruby":[[16,2,"しそん"],[22,2,"ひとびと"],[25,1,"とも"],[32,1,"まち"],[39,1,"ちか"],[50,1,"の"],[52,1,"のぼ"],[65,1,"とも"],[67,1,"す"]],"text":"モーセのしゅうとであるケニびとの子孫はユダの人々と共に、しゅろの町からアラドに近いネゲブにあるユダの野に上ってきて、アマレクびとと共に住んだ。"},{"ref":"Judg.1.17","start":7001017,"end":7001017,"break":"none","ruby":[[8,2,"きょうだい"],[15,1,"とも"],[17,1,"い"],[25,1,"す"],[36,1,"う"],[47,1,"ほろ"],[60,1,"まち"],[62,1,"な"],[68,1,"よ"]],"text":"そしてユダはその兄弟シメオンと共に行って、ゼパテに住んでいたカナンびとを撃ち、それをことごとく滅ぼした。これによってその町の名はホルマと呼ばれた。"},{"ref":"Judg.1.18","start":7001018,"end":7001018,"break":"none","ruby":[[10,2,"ちいき"],[21,2,"ちいき"],[31,2,"ちいき"],[34,1,"と"]],"text":"ユダはまたガザとその地域、アシケロンとその地域、エクロンとその地域を取った。"},{"ref":"Judg.1.19","start":7001019,"end":7001019,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"とも"],[20,2,"さんち"],[23,1,"て"],[25,1,"い"],[30,2,"へいち"],[33,1,"す"],[38,1,"たみ"],[40,1,"てつ"],[42,2,"せんしゃ"],[56,1,"お"],[58,1,"だ"]],"text":"主がユダと共におられたので、ユダはついに山地を手に入れたが、平地に住んでいた民は鉄の戦車をもっていたので、これを追い出すことができなかった。"},{"ref":"Judg.1.20","start":7001020,"end":7001020,"break":"none","ruby":[[0,2,"ひとびと"],[10,1,"い"],[26,1,"あた"],[38,1,"ところ"],[46,1,"にん"],[48,1,"こ"],[50,1,"お"],[52,1,"だ"]],"text":"人々はモーセがかつて言ったように、ヘブロンをカレブに与えたので、カレブはその所からアナクの三人の子を追い出した。"},{"ref":"Judg.1.21","start":7001021,"end":7001021,"break":"none","ruby":[[6,2,"ひとびと"],[15,1,"す"],[26,1,"お"],[28,1,"だ"],[43,2,"こんにち"],[53,2,"ひとびと"],[56,1,"とも"],[64,1,"す"]],"text":"ベニヤミンの人々はエルサレムに住んでいたエブスびとを追い出さなかったので、エブスびとは今日までベニヤミンの人々と共にエルサレムに住んでいる。"},{"ref":"Judg.1.22","start":7001022,"end":7001022,"break":"paragraph","ruby":[[4,2,"いちぞく"],[13,1,"せ"],[15,1,"のぼ"],[20,1,"しゅ"],[22,1,"かれ"],[25,1,"とも"]],"text":"ヨセフの一族はまたベテルに攻め上ったが、主は彼らと共におられた。"},{"ref":"Judg.1.23","start":7001023,"end":7001023,"break":"none","ruby":[[8,2,"いちぞく"],[11,1,"ひと"],[20,1,"さぐ"],[27,1,"まち"],[32,1,"な"]],"text":"すなわちヨセフの一族は人をやってベテルを探らせた。この町のもとの名はルズであった。"},{"ref":"Judg.1.24","start":7001024,"end":7001024,"break":"none","ruby":[[2,2,"せっこう"],[7,1,"まち"],[10,1,"で"],[14,1,"ひと"],[16,1,"み"],[19,1,"い"],[29,1,"まち"],[34,1,"みち"],[36,1,"おし"],[59,1,"めぐ"],[62,1,"ほどこ"]],"text":"その斥候たちは町から出てきた人を見て、言った、「どうぞこの町にはいる道を教えてください。そうすればわたしたちはあなたに恵みを施しましょう」。"},{"ref":"Judg.1.25","start":7001025,"end":7001025,"break":"none","ruby":[[0,1,"かれ"],[2,1,"まち"],[7,1,"みち"],[9,1,"おし"],[15,1,"かれ"],[25,1,"まち"],[27,1,"う"],[37,1,"ひと"],[41,2,"かぞく"],[44,2,"じゆう"],[47,1,"さ"]],"text":"彼が町にはいる道を教えたので、彼らはつるぎをもって町を撃った。しかし、かの人とその家族は自由に去らせた。"},{"ref":"Judg.1.26","start":7001026,"end":7001026,"break":"none","ruby":[[2,1,"ひと"],[9,1,"ち"],[11,1,"い"],[14,1,"まち"],[16,1,"た"],[25,1,"な"],[33,2,"こんにち"],[39,1,"な"]],"text":"その人はヘテびとの地に行って町を建て、それをルズと名づけた。これは今日までその名である。"},{"ref":"Judg.1.27","start":7001027,"end":7001027,"break":"paragraph","ruby":[[12,2,"むらざと"],[15,2,"じゅうみん"],[25,2,"むらざと"],[28,2,"じゅうみん"],[36,2,"むらざと"],[39,2,"じゅうみん"],[50,2,"むらざと"],[53,2,"じゅうみん"],[62,2,"むらざと"],[65,2,"じゅうみん"],[68,1,"お"],[70,1,"だ"],[85,1,"ひ"],[87,1,"つづ"],[92,1,"ち"],[94,1,"す"]],"text":"マナセはベテシャンとその村里の住民、タアナクとその村里の住民、ドルとその村里の住民、イブレアムとその村里の住民、メギドとその村里の住民を追い出さなかったので、カナンびとは引き続いてその地に住んでいたが、"},{"ref":"Judg.1.28","start":7001028,"end":7001028,"break":"none","ruby":[[6,1,"つよ"],[20,2,"きょうせい"],[22,2,"ろうどう"],[25,1,"ふく"],[29,1,"かれ"],[38,1,"お"],[40,1,"だ"]],"text":"イスラエルは強くなったとき、カナンびとを強制労働に服させ、彼らをことごとくは追い出さなかった。"},{"ref":"Judg.1.29","start":7001029,"end":7001029,"break":"paragraph","ruby":[[12,1,"す"],[23,1,"お"],[25,1,"だ"],[47,1,"かれ"],[53,1,"す"]],"text":"またエフライムはゲゼルに住んでいたカナンびとを追い出さなかったので、カナンびとはゲゼルにおいて彼らのうちに住んでいた。"},{"ref":"Judg.1.30","start":7001030,"end":7001030,"break":"paragraph","ruby":[[10,2,"じゅうみん"],[20,2,"じゅうみん"],[23,1,"お"],[25,1,"だ"],[40,1,"かれ"],[46,1,"す"],[49,2,"きょうせい"],[51,2,"ろうどう"],[54,1,"ふく"]],"text":"ゼブルンはキテロンの住民およびナハラルの住民を追い出さなかったので、カナンびとは彼らのうちに住んで強制労働に服した。"},{"ref":"Judg.1.31","start":7001031,"end":7001031,"break":"paragraph","ruby":[[8,2,"じゅうみん"],[39,2,"じゅうみん"],[42,1,"お"],[44,1,"だ"]],"text":"アセルはアッコの住民およびシドン、アヘラブ、アクジブ、ヘルバ、アピク、レホブの住民を追い出さなかったので、"},{"ref":"Judg.1.32","start":7001032,"end":7001032,"break":"none","ruby":[[9,1,"ち"],[11,2,"じゅうみん"],[25,1,"す"],[31,1,"かれ"],[34,1,"お"],[36,1,"だ"]],"text":"アセルびとは、その地の住民であるカナンびとのうちに住んでいた。彼らが追い出さなかったからである。"},{"ref":"Judg.1.33","start":7001033,"end":7001033,"break":"paragraph","ruby":[[11,2,"じゅうみん"],[22,2,"じゅうみん"],[25,1,"お"],[27,1,"だ"],[34,1,"ち"],[36,2,"じゅうみん"],[50,1,"す"],[71,2,"じゅうみん"],[78,1,"かれ"],[81,2,"きょうせい"],[83,2,"ろうどう"],[86,1,"ふく"]],"text":"ナフタリはベテシメシの住民およびベテアナテの住民を追い出さずに、その地の住民であるカナンびとのうちに住んでいた。しかしベテシメシとベテアナテの住民は、ついに彼らの強制労働に服した。"},{"ref":"Judg.1.34","start":7001034,"end":7001034,"break":"paragraph","ruby":[[9,2,"ひとびと"],[12,2,"さんち"],[15,1,"お"],[17,1,"こ"],[20,2,"へいち"],[23,1,"くだ"],[28,1,"ゆる"]],"text":"アモリびとはダンの人々を山地に追い込んで平地に下ることを許さなかった。"},{"ref":"Judg.1.35","start":7001035,"end":7001035,"break":"none","ruby":[[6,1,"ひ"],[8,1,"つづ"],[28,1,"す"],[39,2,"いちぞく"],[42,1,"て"],[44,1,"つよ"],[52,1,"かれ"],[55,2,"きょうせい"],[57,2,"ろうどう"],[60,1,"ふく"]],"text":"アモリびとは引き続いてハルヘレス、アヤロン、シャラビムに住んでいたが、ヨセフの一族の手が強くなったので、彼らは強制労働に服した。"},{"ref":"Judg.1.36","start":7001036,"end":7001036,"break":"none","ruby":[[6,1,"さかい"],[14,1,"さか"],[20,1,"へ"],[22,1,"うえ"],[24,1,"ほう"],[26,1,"およ"]],"text":"アモリびとの境はアクラビムの坂からセラを経て上の方に及んだ。"}]