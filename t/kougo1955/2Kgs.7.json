[{"ref":"2Kgs.7.1","start":12007001,"end":12007001,"break":"paragraph","ruby":[[5,1,"い"],[10,1,"しゅ"],[12,2,"ことば"],[15,1,"き"],[21,1,"しゅ"],[25,1,"おお"],[35,1,"いま"],[43,1,"もん"],[46,2,"むぎこ"],[57,1,"う"],[60,2,"おおむぎ"],[71,1,"う"]],"text":"エリシャは言った、「主の言葉を聞きなさい。主はこう仰せられる、『あすの今ごろサマリヤの門で、麦粉一セアを一シケルで売り、大麦二セアを一シケルで売るようになるであろう』」。"},{"ref":"2Kgs.7.2","start":12007002,"end":12007002,"break":"none","ruby":[[0,1,"とき"],[6,2,"ふくかん"],[12,1,"おう"],[16,1,"ひと"],[18,1,"て"],[28,1,"もの"],[30,1,"かみ"],[32,1,"ひと"],[34,1,"こた"],[37,1,"い"],[45,1,"しゅ"],[47,1,"てん"],[49,1,"まど"],[51,1,"ひら"],[60,1,"こと"],[77,1,"い"],[86,2,"じぶん"],[89,1,"め"],[97,1,"み"],[110,1,"た"]],"text":"時にひとりの副官すなわち王がその人の手によりかかっていた者が神の人に答えて言った、「たとい主が天に窓を開かれても、そんな事がありえましょうか」。エリシャは言った、「あなたは自分の目をもってそれを見るであろう。しかしそれを食べることはなかろう」。"},{"ref":"2Kgs.7.3","start":12007003,"end":12007003,"break":"paragraph","ruby":[[2,1,"まち"],[4,1,"もん"],[6,2,"いりぐち"],[10,1,"にん"],[14,2,"びょうにん"],[21,1,"かれ"],[24,1,"たがい"],[26,1,"い"],[43,1,"ざ"],[46,1,"し"],[48,1,"ま"]],"text":"さて町の門の入口に四人のらい病人がいたが、彼らは互に言った、「われわれはどうしてここに座して死を待たねばならないのか。"},{"ref":"2Kgs.7.4","start":12007004,"end":12007004,"break":"none","ruby":[[7,1,"まち"],[18,1,"まち"],[21,2,"しょくもつ"],[24,1,"つ"],[40,1,"し"],[53,1,"ざ"],[59,1,"し"],[68,1,"こと"],[81,2,"じんえい"],[84,1,"に"],[87,1,"い"],[93,1,"かれ"],[101,1,"い"],[115,1,"たす"],[128,1,"ころ"],[132,1,"し"]],"text":"われわれがもし町にはいろうといえば、町には食物が尽きているから、われわれはそこで死ぬであろう。しかしここに座していても死ぬのだ。いっその事、われわれはスリヤびとの陣営へ逃げて行こう。もし彼らがわれわれを生かしておいてくれるならば、助かるが、たといわれわれを殺しても死ぬばかりだ」。"},{"ref":"2Kgs.7.5","start":12007005,"end":12007005,"break":"none","ruby":[[3,1,"かれ"],[12,2,"じんえい"],[15,1,"い"],[25,1,"た"],[39,2,"じんえい"],[46,1,"い"],[49,1,"み"]],"text":"そこで彼らはスリヤびとの陣営へ行こうと、たそがれに立ちあがったが、スリヤびとの陣営のほとりに行って見ると、そこにはだれもいなかった。"},{"ref":"2Kgs.7.6","start":12007006,"end":12007006,"break":"none","ruby":[[3,1,"しゅ"],[11,2,"ぐんぜい"],[14,2,"せんしゃ"],[17,1,"おと"],[19,1,"うま"],[21,1,"おと"],[23,2,"たいぐん"],[26,1,"おと"],[28,1,"き"],[37,1,"かれ"],[40,1,"たがい"],[43,1,"み"],[52,1,"おう"],[59,1,"せ"],[71,1,"おう"],[82,1,"おう"],[86,1,"やと"],[97,1,"おそ"],[103,1,"い"]],"text":"これは主がスリヤびとの軍勢に戦車の音、馬の音、大軍の音を聞かせられたので、彼らは互に「見よ、イスラエルの王がわれわれを攻めるために、ヘテびとの王たちおよびエジプトの王たちを雇ってきて、われわれを襲うのだ」と言って、"},{"ref":"2Kgs.7.7","start":12007007,"end":12007007,"break":"none","ruby":[[5,1,"た"],[8,1,"に"],[13,2,"てんまく"],[17,1,"うま"],[23,1,"す"],[26,2,"じんえい"],[40,1,"いのち"],[42,1,"まっと"],[48,1,"に"]],"text":"たそがれに立って逃げ、その天幕と、馬と、ろばを捨て、陣営をそのままにしておいて、命を全うしようと逃げたからである。"},{"ref":"2Kgs.7.8","start":12007008,"end":12007008,"break":"none","ruby":[[5,2,"びょうにん"],[10,2,"じんえい"],[17,1,"い"],[23,2,"てんまく"],[30,1,"く"],[32,1,"の"],[40,2,"きんぎん"],[43,2,"いふく"],[46,1,"も"],[48,1,"だ"],[54,1,"かく"],[59,1,"き"],[62,1,"た"],[64,2,"てんまく"],[67,1,"はい"],[75,1,"も"],[77,1,"だ"],[83,1,"かく"]],"text":"そこでらい病人たちは陣営のほとりに行き、一つの天幕にはいって食い飲みし、そこから金銀、衣服を持ち出してそれを隠し、また来て、他の天幕に入り、そこからも持ち出してそれを隠した。"},{"ref":"2Kgs.7.9","start":12007009,"end":12007009,"break":"paragraph","ruby":[[3,1,"かれ"],[6,1,"たがい"],[8,1,"い"],[22,1,"こと"],[33,1,"よ"],[42,1,"ひ"],[49,1,"だま"],[55,2,"よあ"],[60,1,"ま"],[71,1,"ばつ"],[90,1,"い"],[93,1,"おう"],[95,2,"かぞく"],[98,1,"つ"]],"text":"そして彼らは互に言った、「われわれのしている事はよくない。きょうは良いおとずれのある日であるのに、黙っていて、夜明けまで待つならば、われわれは罰をこうむるであろう。さあ、われわれは行って王の家族に告げよう」。"},{"ref":"2Kgs.7.10","start":12007010,"end":12007010,"break":"none","ruby":[[3,1,"かれ"],[6,1,"き"],[9,1,"まち"],[11,1,"もん"],[13,1,"まも"],[15,1,"もの"],[17,1,"よ"],[20,1,"い"],[37,2,"じんえい"],[40,1,"い"],[43,1,"み"],[54,1,"すがた"],[56,1,"み"],[62,2,"ひとごえ"],[71,1,"うま"],[83,2,"てんまく"]],"text":"そこで彼らは来て、町の門を守る者を呼んで言った、「わたしたちがスリヤびとの陣営に行って見ると、そこにはだれの姿も見えず、また人声もなく、ただ、馬とろばがつないであり、天幕はそのままでした」。"},{"ref":"2Kgs.7.11","start":12007011,"end":12007011,"break":"none","ruby":[[3,1,"もん"],[5,1,"まも"],[7,1,"もの"],[9,1,"よ"],[18,1,"おう"],[20,2,"かぞく"],[26,1,"し"]],"text":"そこで門を守る者は呼ばわって、それを王の家族のうちに知らせた。"},{"ref":"2Kgs.7.12","start":12007012,"end":12007012,"break":"none","ruby":[[0,1,"おう"],[2,1,"よる"],[7,1,"お"],[11,2,"けらい"],[16,1,"い"],[32,1,"たい"],[35,1,"はか"],[40,1,"こと"],[48,1,"つ"],[53,1,"かれ"],[62,1,"う"],[69,1,"し"],[73,2,"じんえい"],[76,1,"で"],[78,1,"の"],[80,1,"かく"],[92,1,"まち"],[94,1,"で"],[106,1,"まち"],[108,1,"お"],[110,1,"い"],[115,1,"かんが"]],"text":"王は夜のうちに起きて、家来たちに言った、「スリヤびとがわれわれに対して図っている事をあなたがたに告げよう。彼らは、われわれの飢えているのを知って、陣営を出て野に隠れ、『イスラエルびとが町を出たら、いけどりにして、町に押し入ろう』と考えているのだ」。"},{"ref":"2Kgs.7.13","start":12007013,"end":12007013,"break":"none","ruby":[[0,2,"けらい"],[7,1,"こた"],[10,1,"い"],[15,2,"ひとびと"],[22,1,"のこ"],[27,1,"うま"],[32,1,"とう"],[34,1,"つ"],[49,1,"のこ"],[58,2,"ひとびと"],[65,1,"ほろ"],[76,1,"ぜん"],[77,2,"ぐんしゅう"],[80,1,"おな"],[82,2,"うんめい"],[99,1,"ひと"]],"text":"家来のひとりが答えて言った、「人々に、ここに残っている馬のうち五頭を連れてこさせてください。ここに残っているこれらの人々は、すでに滅びうせたイスラエルの全群衆と同じ運命にあうのですから。わたしたちは人をやってうかがわせましょう」。"},{"ref":"2Kgs.7.14","start":12007014,"end":12007014,"break":"none","ruby":[[3,1,"かれ"],[10,2,"きへい"],[13,1,"えら"],[17,1,"おう"],[28,1,"い"],[31,1,"み"],[35,1,"い"],[45,2,"ぐんぜい"]],"text":"そこで彼らはふたりの騎兵を選んだ。王はそれをつかわし、「行って見よ」と言って、スリヤびとの軍勢のあとをつけさせたので、"},{"ref":"2Kgs.7.15","start":12007015,"end":12007015,"break":"none","ruby":[[0,1,"かれ"],[8,1,"お"],[17,1,"い"],[22,1,"みち"],[39,1,"に"],[42,1,"とき"],[44,1,"す"],[50,2,"いふく"],[53,2,"ぶき"],[56,1,"ち"],[66,2,"ししゃ"],[69,1,"かえ"],[78,1,"おう"],[80,1,"つ"]],"text":"彼らはそのあとを追ってヨルダンまで行ったが、道にはすべて、スリヤびとがあわてて逃げる時に捨てていった衣服と武器が散らばっていた。その使者は帰ってきて、これを王に告げた。"},{"ref":"2Kgs.7.16","start":12007016,"end":12007016,"break":"paragraph","ruby":[[3,1,"たみ"],[5,1,"で"],[17,2,"じんえい"],[27,2,"むぎこ"],[38,1,"う"],[42,2,"おおむぎ"],[53,1,"う"],[57,1,"しゅ"],[59,2,"ことば"]],"text":"そこで民が出ていって、スリヤびとの陣営をかすめたので、麦粉一セアは一シケルで売られ、大麦二セアは一シケルで売られ、主の言葉のとおりになった。"},{"ref":"2Kgs.7.17","start":12007017,"end":12007017,"break":"none","ruby":[[0,1,"おう"],[2,2,"じぶん"],[7,1,"ひと"],[9,1,"て"],[22,2,"ふくかん"],[25,1,"た"],[28,1,"もん"],[30,2,"かんり"],[37,1,"たみ"],[39,1,"もん"],[41,1,"かれ"],[43,1,"ふ"],[51,1,"かれ"],[53,1,"し"],[62,1,"おう"],[64,1,"かみ"],[66,1,"ひと"],[72,1,"くだ"],[77,1,"とき"],[79,1,"かみ"],[81,1,"ひと"],[83,1,"い"]],"text":"王は自分がその人の手によりかかっていた、あの副官を立てて門を管理させたが、民は門で彼を踏みつけたので、彼は死んだ。すなわち、王が神の人のところに下ってきた時、神の人が言ったとおりであった。"},{"ref":"2Kgs.7.18","start":12007018,"end":12007018,"break":"none","ruby":[[3,1,"かみ"],[5,1,"ひと"],[7,1,"おう"],[18,1,"いま"],[27,1,"もん"],[29,2,"おおむぎ"],[40,1,"う"],[43,2,"むぎこ"],[54,1,"う"],[67,1,"い"]],"text":"これは神の人が王にむかって、「あすの今ごろ、サマリヤの門で大麦二セアを一シケルで売り、麦粉一セアを一シケルで売るようになるであろう」と言ったときに、"},{"ref":"2Kgs.7.19","start":12007019,"end":12007019,"break":"none","ruby":[[2,2,"ふくかん"],[5,1,"かみ"],[7,1,"ひと"],[9,1,"こた"],[17,1,"しゅ"],[19,1,"てん"],[21,1,"まど"],[23,1,"ひら"],[32,1,"こと"],[42,1,"い"],[55,1,"かみ"],[57,1,"ひと"],[64,2,"じぶん"],[67,1,"め"],[75,1,"み"],[88,1,"た"],[100,1,"い"]],"text":"その副官が神の人に答えて、「たとい主が天に窓を開かれても、そんな事がありえようか」と言ったからである。そのとき神の人は「あなたは自分の目をもってそれを見るであろう。しかしそれを食べることはなかろう」と言ったが、"},{"ref":"2Kgs.7.20","start":12007020,"end":12007020,"break":"none","ruby":[[8,1,"かれ"],[10,1,"のぞ"],[18,1,"たみ"],[20,1,"もん"],[22,1,"かれ"],[24,1,"ふ"],[31,1,"かれ"],[33,1,"し"]],"text":"これはそのとおり彼に臨んだ。すなわち民が門で彼を踏みつけたので彼は死んだ。"}]