[{"ref":"2Kgs.25.1","start":12025001,"end":12025001,"break":"paragraph","ruby":[[8,2,"ちせい"],[11,1,"だい"],[13,1,"ねん"],[16,1,"がつ"],[18,1,"か"],[26,1,"おう"],[40,2,"ぐんぜい"],[43,1,"ひき"],[62,1,"じん"],[64,1,"は"],[67,2,"しゅうい"],[74,1,"きず"],[80,1,"せ"]],"text":"そこでゼデキヤの治世の第九年の十月十日に、バビロンの王ネブカデネザルはもろもろの軍勢を率い、エルサレムにきて、これにむかって陣を張り、周囲にとりでを築いてこれを攻めた。"},{"ref":"2Kgs.25.2","start":12025002,"end":12025002,"break":"none","ruby":[[4,1,"まち"],[6,1,"かこ"],[15,1,"おう"],[17,1,"だい"],[20,1,"ねん"],[24,1,"およ"]],"text":"こうして町は囲まれて、ゼデキヤ王の第十一年にまで及んだが、"},{"ref":"2Kgs.25.3","start":12025003,"end":12025003,"break":"none","ruby":[[3,1,"がつ"],[5,1,"か"],[11,1,"まち"],[20,1,"はげ"],[28,1,"ち"],[30,1,"たみ"],[32,2,"しょくもつ"]],"text":"その四月九日になって、町のうちにききんが激しくなり、その地の民に食物がなくなった。"},{"ref":"2Kgs.25.4","start":12025004,"end":12025004,"break":"none","ruby":[[0,1,"まち"],[2,2,"いっかく"],[8,1,"やぶ"],[14,1,"おう"],[20,2,"へいし"],[27,1,"おう"],[29,1,"その"],[41,2,"じょうへき"],[48,1,"もん"],[50,1,"みち"],[53,1,"よる"],[58,1,"に"],[60,1,"だ"],[71,1,"まち"],[73,1,"かこ"],[78,1,"あいだ"],[85,1,"ほう"],[87,1,"お"],[89,1,"の"]],"text":"町の一角がついに破れたので、王はすべての兵士とともに、王の園のかたわらにある二つの城壁のあいだの門の道から夜のうちに逃げ出して、カルデヤびとが町を囲んでいる間に、アラバの方へ落ち延びた。"},{"ref":"2Kgs.25.5","start":12025005,"end":12025005,"break":"none","ruby":[[10,2,"ぐんぜい"],[13,1,"おう"],[15,1,"お"],[22,2,"へいち"],[25,1,"かれ"],[27,1,"お"],[33,1,"かれ"],[35,2,"ぐんぜい"],[40,1,"かれ"],[42,1,"はな"],[45,1,"ち"],[47,1,"さ"]],"text":"しかしカルデヤびとの軍勢は王を追い、エリコの平地で彼に追いついた。彼の軍勢はみな彼を離れて散り去ったので、"},{"ref":"2Kgs.25.6","start":12025006,"end":12025006,"break":"none","ruby":[[7,1,"おう"],[9,1,"とら"],[12,1,"かれ"],[25,1,"おう"],[30,1,"ひ"],[36,1,"かれ"],[38,1,"つみ"],[40,1,"さだ"]],"text":"カルデヤびとは王を捕え、彼をリブラにいるバビロンの王のもとへ引いていって彼の罪を定め、"},{"ref":"2Kgs.25.7","start":12025007,"end":12025007,"break":"none","ruby":[[5,1,"こ"],[14,1,"め"],[16,1,"まえ"],[18,1,"ころ"],[26,1,"め"],[32,1,"あし"],[44,1,"つ"],[47,1,"い"]],"text":"ゼデキヤの子たちをゼデキヤの目の前で殺し、ゼデキヤの目をえぐり、足かせをかけてバビロンへ連れて行った。"},{"ref":"2Kgs.25.8","start":12025008,"end":12025008,"break":"paragraph","ruby":[[5,1,"おう"],[14,1,"だい"],[17,1,"ねん"],[20,1,"ごがつ"],[21,2,"なぬか"],[30,1,"おう"],[32,1,"しん"],[34,2,"じえい"],[37,1,"ちょう"]],"text":"バビロンの王ネブカデネザルの第十九年の五月七日に、バビロンの王の臣、侍衛の長ネブザラダンがエルサレムにきて、"},{"ref":"2Kgs.25.9","start":12025009,"end":12025009,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"みや"],[4,1,"おう"],[6,1,"いえ"],[18,1,"いえ"],[20,1,"や"],[28,1,"ひ"],[37,1,"おお"],[40,1,"いえ"],[42,1,"や"]],"text":"主の宮と王の家とエルサレムのすべての家を焼いた。すなわち火をもってすべての大きな家を焼いた。"},{"ref":"2Kgs.25.10","start":12025010,"end":12025010,"break":"none","ruby":[[2,2,"じえい"],[5,1,"ちょう"],[7,1,"とも"],[22,2,"ぐんぜい"],[31,2,"しゅうい"],[34,2,"じょうへき"],[37,2,"はかい"]],"text":"また侍衛の長と共にいたカルデヤびとのすべての軍勢はエルサレムの周囲の城壁を破壊した。"},{"ref":"2Kgs.25.11","start":12025011,"end":12025011,"break":"none","ruby":[[3,2,"じえい"],[6,1,"ちょう"],[15,1,"まち"],[17,1,"のこ"],[21,1,"たみ"],[29,1,"おう"],[31,2,"こうふく"],[35,1,"もの"],[37,1,"のこ"],[40,2,"ぐんしゅう"],[43,1,"とら"],[45,1,"うつ"]],"text":"そして侍衛の長ネブザラダンは、町に残された民およびバビロン王に降服した者と残りの群衆を捕え移した。"},{"ref":"2Kgs.25.12","start":12025012,"end":12025012,"break":"none","ruby":[[3,2,"じえい"],[6,1,"ちょう"],[10,1,"ち"],[12,1,"まず"],[15,1,"もの"],[17,1,"のこ"],[25,1,"つく"],[27,1,"もの"],[31,2,"のうふ"]],"text":"ただし侍衛の長はその地の貧しい者を残して、ぶどうを作る者とし、農夫とした。"},{"ref":"2Kgs.25.13","start":12025013,"end":12025013,"break":"paragraph","ruby":[[9,1,"しゅ"],[11,1,"みや"],[13,2,"せいどう"],[16,1,"はしら"],[19,1,"しゅ"],[21,1,"みや"],[23,2,"せんばん"],[26,1,"だい"],[29,2,"せいどう"],[32,1,"うみ"],[34,1,"くだ"],[40,2,"せいどう"],[48,1,"はこ"]],"text":"カルデヤびとはまた主の宮の青銅の柱と、主の宮の洗盤の台と、青銅の海を砕いて、その青銅をバビロンに運び、"},{"ref":"2Kgs.25.14","start":12025014,"end":12025014,"break":"none","ruby":[[6,2,"じゅうのう"],[10,2,"しんき"],[18,1,"こう"],[20,1,"も"],[22,1,"さら"],[29,2,"しんでん"],[32,1,"つとめ"],[34,1,"もち"],[37,2,"せいどう"],[40,1,"うつわ"]],"text":"またつぼと、十能と、心切りばさみと、香を盛る皿およびすべて神殿の務に用いる青銅の器、"},{"ref":"2Kgs.25.15","start":12025015,"end":12025015,"break":"none","ruby":[[2,2,"しんと"],[5,1,"ざら"],[7,1,"はち"],[9,1,"と"],[11,1,"さ"],[15,2,"じえい"],[18,1,"ちょう"],[22,1,"きん"],[24,1,"つく"],[27,1,"もの"],[29,1,"ぎん"],[31,1,"つく"],[34,1,"もの"],[36,1,"と"],[38,1,"さ"]],"text":"また心取り皿と鉢を取り去った。侍衛の長はまた金で作った物と銀で作った物を取り去った。"},{"ref":"2Kgs.25.16","start":12025016,"end":12025016,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"みや"],[12,1,"つく"],[18,1,"はしら"],[24,1,"うみ"],[26,2,"せんばん"],[29,1,"だい"],[42,1,"うつわ"],[44,2,"せいどう"],[47,1,"おも"],[50,1,"はか"]],"text":"ソロモンが主の宮のために造った二つの柱と、一つの海と洗盤の台など、これらのもろもろの器の青銅の重さは量ることができなかった。"},{"ref":"2Kgs.25.17","start":12025017,"end":12025017,"break":"none","ruby":[[3,1,"はしら"],[5,1,"たか"],[18,1,"うえ"],[20,2,"せいどう"],[23,2,"ちゅうとう"],[29,2,"ちゅうとう"],[32,1,"たか"],[42,2,"ちゅうとう"],[45,2,"しゅうい"],[48,1,"あみ"],[49,2,"さいく"],[62,2,"せいどう"],[69,1,"た"],[71,1,"はしら"],[75,1,"あみ"],[76,2,"さいく"],[82,1,"おな"]],"text":"一つの柱の高さは十八キュビトで、その上に青銅の柱頭があり、柱頭の高さは三キュビトで、柱頭の周囲に網細工とざくろがあって、みな青銅であった。他の柱もその網細工もこれと同じであった。"},{"ref":"2Kgs.25.18","start":12025018,"end":12025018,"break":"paragraph","ruby":[[0,2,"じえい"],[3,1,"ちょう"],[5,2,"さいし"],[7,1,"ちょう"],[12,2,"じせき"],[15,2,"さいし"],[23,1,"にん"],[25,1,"もん"],[27,1,"まも"],[29,1,"もの"],[31,1,"とら"]],"text":"侍衛の長は祭司長セラヤと次席の祭司ゼパニヤと三人の門を守る者を捕え、"},{"ref":"2Kgs.25.19","start":12025019,"end":12025019,"break":"none","ruby":[[2,2,"へいし"],[14,2,"やくにん"],[18,1,"おう"],[20,1,"まえ"],[25,1,"もの"],[30,1,"まち"],[32,1,"み"],[37,1,"もの"],[39,1,"にん"],[44,1,"ち"],[46,1,"たみ"],[48,1,"つの"],[51,2,"ぐんぜい"],[54,1,"ちょう"],[56,3,"しょきかん"],[61,1,"まち"],[63,1,"み"],[70,1,"ち"],[72,1,"たみ"],[75,1,"にん"],[77,1,"まち"],[80,1,"とら"],[82,1,"さ"]],"text":"また兵士をつかさどるひとりの役人と、王の前にはべる者のうち、町で見つかった者五人と、その地の民を募った軍勢の長の書記官と、町で見つかったその地の民六十人を町から捕え去った。"},{"ref":"2Kgs.25.20","start":12025020,"end":12025020,"break":"none","ruby":[[0,2,"じえい"],[3,1,"ちょう"],[11,1,"かれ"],[14,1,"とら"],[29,1,"おう"],[34,1,"つ"],[37,1,"い"]],"text":"侍衛の長ネブザラダンは彼らを捕えて、リブラにいるバビロンの王のもとへ連れて行ったので、"},{"ref":"2Kgs.25.21","start":12025021,"end":12025021,"break":"none","ruby":[[5,1,"おう"],[11,1,"ち"],[17,1,"かれ"],[20,1,"う"],[22,1,"ころ"],[38,1,"ち"],[41,1,"とら"],[43,1,"うつ"]],"text":"バビロンの王はハマテの地のリブラで彼らを撃ち殺した。このようにしてユダはその地から捕え移された。"},{"ref":"2Kgs.25.22","start":12025022,"end":12025022,"break":"paragraph","ruby":[[7,1,"おう"],[19,1,"ち"],[21,1,"のこ"],[30,1,"たみ"],[32,1,"うえ"],[40,1,"こ"],[46,1,"こ"],[55,1,"た"],[58,2,"そうとく"]],"text":"さてバビロンの王ネブカデネザルはユダの地に残してとどまらせた民の上に、シャパンの子アヒカムの子であるゲダリヤを立てて総督とした。"},{"ref":"2Kgs.25.23","start":12025023,"end":12025023,"break":"none","ruby":[[0,1,"とき"],[2,2,"ぐんぜい"],[5,1,"ちょう"],[13,2,"ぶか"],[16,2,"ひとびと"],[25,1,"おう"],[32,2,"そうとく"],[40,1,"き"],[70,1,"こ"],[81,1,"こ"],[98,1,"こ"],[109,1,"こ"],[119,2,"ぶか"],[122,2,"ひとびと"]],"text":"時に軍勢の長たちおよびその部下の人々は、バビロンの王がゲダリヤを総督としたことを聞いて、ミヅパにいるゲダリヤのもとにきた。すなわちネタニヤの子イシマエル、カレヤの子ヨハナン、ネトパびとタンホメテの子セラヤ、マアカびとの子ヤザニヤおよびその部下の人々がゲダリヤのもとにきた。"},{"ref":"2Kgs.25.24","start":12025024,"end":12025024,"break":"none","ruby":[[5,1,"かれ"],[10,2,"ぶか"],[13,2,"ひとびと"],[16,1,"ちか"],[19,1,"い"],[46,1,"おそ"],[57,1,"ち"],[59,1,"す"],[68,1,"おう"],[70,1,"つか"],[87,2,"こうふく"],[90,1,"え"]],"text":"ゲダリヤは彼らとその部下の人々に誓って言った、「あなたがたはカルデヤびとのしもべとなることを恐れてはならない。この地に住んで、バビロンの王に仕えなさい。そうすればあなたがたは幸福を得るでしょう」。"},{"ref":"2Kgs.25.25","start":12025025,"end":12025025,"break":"none","ruby":[[5,1,"がつ"],[11,1,"おう"],[13,2,"けっとう"],[22,1,"こ"],[31,1,"こ"],[39,1,"にん"],[41,1,"もの"],[43,1,"とも"],[53,1,"う"],[55,1,"ころ"],[60,1,"かれ"],[62,1,"とも"],[73,1,"ひと"],[83,1,"ころ"]],"text":"ところが七月になって、王の血統のエリシャマの子であるネタニヤの子イシマエルは十人の者と共にきて、ゲダリヤを撃ち殺し、また彼と共にミヅパにいたユダヤ人と、カルデヤびとを殺した。"},{"ref":"2Kgs.25.26","start":12025026,"end":12025026,"break":"none","ruby":[[5,2,"だいしょう"],[8,1,"たみ"],[12,2,"ぐんぜい"],[15,1,"ちょう"],[22,1,"た"],[30,1,"い"],[34,1,"かれ"],[44,1,"おそ"]],"text":"そのため、大小の民および軍勢の長たちは、みな立ってエジプトへ行った。彼らはカルデヤびとを恐れたからである。"},{"ref":"2Kgs.25.27","start":12025027,"end":12025027,"break":"paragraph","ruby":[[3,1,"おう"],[10,1,"とら"],[12,1,"うつ"],[16,1,"のち"],[20,1,"ねん"],[24,1,"がつ"],[28,1,"にち"],[39,1,"おう"],[48,2,"ちせい"],[51,1,"だい"],[53,1,"ねん"],[56,1,"おう"],[61,1,"おう"],[68,2,"ごくや"],[72,1,"だ"]],"text":"ユダの王エホヤキンが捕え移されて後三十七年の十二月二十七日、すなわちバビロンの王エビルメロダクの治世の第一年に、王はユダの王エホヤキンを獄屋から出して"},{"ref":"2Kgs.25.28","start":12025028,"end":12025028,"break":"none","ruby":[[5,1,"かれ"],[7,1,"なぐさ"],[12,1,"くらい"],[14,1,"かれ"],[16,1,"とも"],[25,1,"おう"],[29,1,"くらい"],[33,1,"たか"]],"text":"ねんごろに彼を慰め、その位を彼と共にバビロンにいる王たちの位よりも高くした。"},{"ref":"2Kgs.25.29","start":12025029,"end":12025029,"break":"none","ruby":[[12,2,"ごくや"],[15,1,"ころも"],[17,1,"ぬ"],[20,2,"いっしょう"],[23,1,"あいだ"],[25,1,"つね"],[27,1,"おう"],[29,1,"まえ"],[31,2,"しょくじ"]],"text":"こうしてエホヤキンはその獄屋の衣を脱ぎ、一生の間、常に王の前で食事した。"},{"ref":"2Kgs.25.30","start":12025030,"end":12025030,"break":"none","ruby":[[0,1,"かれ"],[2,2,"いっしょう"],[5,1,"あいだ"],[10,2,"ひび"],[13,1,"ぶん"],[15,1,"おう"],[18,1,"たま"],[25,2,"しょくもつ"]],"text":"彼は一生の間、たえず日々の分を王から賜わって、その食物とした。"}]