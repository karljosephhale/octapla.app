[{"ref":"Ps.105.1","start":19105001,"end":19105001,"break":"paragraph","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"かんしゃ"],[9,1,"な"],[11,1,"よ"],[25,1,"たみ"],[30,1,"し"]],"text":"主に感謝し、そのみ名を呼び、そのみわざをもろもろの民のなかに知らせよ。"},{"ref":"Ps.105.2","start":19105002,"end":19105002,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"うた"],[9,1,"しゅ"],[31,1,"かた"]],"text":"主にむかって歌え、主をほめうたえ、そのすべてのくすしきみわざを語れ。"},{"ref":"Ps.105.3","start":19105003,"end":19105003,"break":"line","breaks":[[11,"line"]],"ruby":[[2,1,"せい"],[6,1,"な"],[8,1,"ほこ"],[11,1,"しゅ"],[13,1,"たず"],[15,1,"もと"],[18,1,"もの"],[20,1,"こころ"],[22,1,"よろこ"]],"text":"その聖なるみ名を誇れ。主を尋ね求める者の心を喜ばせよ。"},{"ref":"Ps.105.4","start":19105004,"end":19105004,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"ちから"],[8,1,"もと"],[18,1,"かお"],[20,1,"たず"]],"text":"主とそのみ力とを求めよ、つねにそのみ顔を尋ねよ。"},{"ref":"Ps.105.5","start":19105005,"end":19105006,"break":"line","breaks":[[15,"line"],[33,"line"],[48,"line"]],"ruby":[[11,2,"しそん"],[17,1,"えら"],[21,1,"もの"],[29,1,"こ"],[33,1,"しゅ"],[50,2,"きせき"],[57,1,"くち"],[64,1,"こころ"]],"text":"そのしもべアブラハムの子孫よ、その選ばれた者であるヤコブの子らよ、主のなされたくすしきみわざと、その奇跡と、そのみ口のさばきとを心にとめよ。"},{"ref":"Ps.105.7","start":19105007,"end":19105007,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[6,1,"かみ"],[8,1,"しゅ"],[23,1,"ぜん"],[24,1,"ち"]],"text":"彼はわれらの神、主でいらせられる。そのさばきは全地にある。"},{"ref":"Ps.105.8","start":19105008,"end":19105008,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[10,2,"けいやく"],[30,1,"よ"],[32,1,"めい"],[38,2,"ことば"]],"text":"主はとこしえに、その契約をみこころにとめられる。これはよろず代に命じられたみ言葉であって、"},{"ref":"Ps.105.9","start":19105009,"end":19105009,"break":"line","breaks":[[13,"line"]],"ruby":[[6,1,"むす"],[10,2,"けいやく"],[17,1,"ちか"],[21,2,"やくそく"]],"text":"アブラハムと結ばれた契約、イサクに誓われた約束である。"},{"ref":"Ps.105.10","start":19105010,"end":19105010,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[5,1,"かた"],[7,1,"た"],[18,1,"さだ"],[38,2,"けいやく"]],"text":"主はこれを堅く立てて、ヤコブのために定めとし、イスラエルのために、とこしえの契約として"},{"ref":"Ps.105.11","start":19105011,"end":19105011,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"い"],[18,1,"ち"],[20,1,"あた"],[30,1,"う"],[33,1,"し"],[34,1,"ぎょう"],[36,1,"わ"],[38,1,"まえ"]],"text":"言われた、「わたしはあなたにカナンの地を与えて、あなたがたの受ける嗣業の分け前とする」と。"},{"ref":"Ps.105.12","start":19105012,"end":19105012,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"かれ"],[7,1,"かず"],[9,1,"すく"],[14,1,"かぞ"],[18,1,"た"],[24,1,"ところ"],[26,1,"たび"]],"text":"このとき彼らの数は少なくて、数えるに足らず、その所で旅びととなり、"},{"ref":"Ps.105.13","start":19105013,"end":19105013,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"くに"],[7,1,"くに"],[9,1,"い"],[14,1,"くに"],[17,1,"た"],[19,1,"たみ"],[21,1,"い"]],"text":"この国からかの国へ行き、この国から他の民へ行った。"},{"ref":"Ps.105.14","start":19105014,"end":19105014,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ひと"],[4,1,"かれ"],[19,1,"かれ"],[25,1,"おう"],[29,1,"こら"]],"text":"主は人の彼らをしえたげるのをゆるさず、彼らのために王たちを懲しめて、"},{"ref":"Ps.105.15","start":19105015,"end":19105015,"break":"line","breaks":[[18,"line"],[28,"line"]],"ruby":[[0,1,"い"],[8,1,"あぶら"],[14,1,"もの"],[30,3,"よげんしゃ"],[36,1,"がい"],[38,1,"くわ"]],"text":"言われた、「わが油そそがれた者たちにさわってはならない、わが預言者たちに害を加えてはならない」と。"},{"ref":"Ps.105.16","start":19105016,"end":19105016,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ち"],[8,1,"まね"],[11,1,"ひと"],[26,1,"くだ"]],"text":"主はききんを地に招き、人のつえとするパンをことごとく砕かれた。"},{"ref":"Ps.105.17","start":19105017,"end":19105017,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"かれ"],[5,1,"まえ"],[22,1,"う"],[26,2,"どれい"]],"text":"また彼らの前にひとりをつかわされた。すなわち売られて奴隷となったヨセフである。"},{"ref":"Ps.105.18","start":19105018,"end":19105018,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[2,1,"あし"],[4,1,"あし"],[11,1,"いた"],[16,1,"かれ"],[18,1,"くび"],[20,1,"てつ"],[22,2,"くびわ"]],"text":"彼の足は足かせをもって痛められ、彼の首は鉄の首輪にはめられ、"},{"ref":"Ps.105.19","start":19105019,"end":19105019,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[2,2,"ことば"],[5,1,"な"],[7,1,"とき"],[11,1,"しゅ"],[14,2,"ことば"],[17,1,"かれ"],[19,1,"こころ"]],"text":"彼の言葉の成る時まで、主のみ言葉が彼を試みた。"},{"ref":"Ps.105.20","start":19105020,"end":19105020,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"おう"],[2,1,"ひと"],[9,1,"かれ"],[11,1,"と"],[13,1,"はな"],[16,1,"たみ"],[22,1,"かれ"],[24,2,"じゆう"],[27,1,"あた"]],"text":"王は人をつかわして彼を解き放ち、民のつかさは彼に自由を与えた。"},{"ref":"Ps.105.21","start":19105021,"end":19105021,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"おう"],[4,1,"いえ"],[14,2,"しょゆう"]],"text":"王はその家のつかさとしてその所有をことごとくつかさどらせ、"},{"ref":"Ps.105.22","start":19105022,"end":19105022,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"こころ"],[7,1,"きみ"],[11,1,"おし"],[16,2,"ちょうろう"],[21,2,"ちえ"],[24,1,"さづ"]],"text":"その心のままに君たちを教えさせ、長老たちに知恵を授けさせた。"},{"ref":"Ps.105.23","start":19105023,"end":19105023,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"とき"],[25,1,"ち"],[27,2,"きりゅう"]],"text":"その時イスラエルはエジプトにきたり、ヤコブはハムの地に寄留した。"},{"ref":"Ps.105.24","start":19105024,"end":19105024,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"たみ"],[6,1,"おお"],[9,1,"ま"],[11,1,"くわ"],[24,1,"つよ"]],"text":"主はその民を大いに増し加え、これをそのあだよりも強くされた。"},{"ref":"Ps.105.25","start":19105025,"end":19105025,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"ひとびと"],[5,1,"こころ"],[13,1,"たみ"],[15,1,"にく"],[27,2,"わるがしこ"],[30,1,"あつか"]],"text":"主は人々の心をかえて、その民を憎ませ、そのしもべたちを悪賢く扱わせられた。"},{"ref":"Ps.105.26","start":19105026,"end":19105026,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[15,1,"えら"]],"text":"主はそのしもべモーセと、そのお選びになったアロンとをつかわされた。"},{"ref":"Ps.105.27","start":19105027,"end":19105027,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[6,1,"ち"],[8,1,"しゅ"],[15,2,"きせき"],[19,1,"かれ"]],"text":"彼らはハムの地で主のしるしと、奇跡とを彼らのうちにおこなった。"},{"ref":"Ps.105.28","start":19105028,"end":19105028,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"くら"],[11,1,"ち"],[13,1,"くら"],[22,1,"かれ"],[28,2,"ことば"],[31,1,"したが"]],"text":"主は暗やみをつかわして地を暗くされた。しかし彼らはそのみ言葉に従わなかった。"},{"ref":"Ps.105.29","start":19105029,"end":19105029,"break":"line","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"みず"],[7,1,"ち"],[9,1,"かわ"],[16,1,"うお"],[18,1,"ころ"]],"text":"主は彼らの水を血に変らせて、その魚を殺された。"},{"ref":"Ps.105.30","start":19105030,"end":19105030,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"くに"],[11,1,"むら"],[15,1,"おう"],[17,2,"ねま"]],"text":"彼らの国には、かえるが群がり、王の寝間にまではいった。"},{"ref":"Ps.105.31","start":19105031,"end":19105031,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"む"],[21,1,"くに"]],"text":"主が言われると、はえの群れがきたり、ぶよが国じゅうにあった。"},{"ref":"Ps.105.32","start":19105032,"end":19105032,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"あめ"],[12,1,"かれ"],[15,1,"あた"],[27,1,"かれ"],[30,1,"くに"],[32,1,"はな"]],"text":"主は雨にかえて、ひょうを彼らに与え、きらめくいなずまを彼らの国に放たれた。"},{"ref":"Ps.105.33","start":19105033,"end":19105033,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[9,1,"き"],[17,1,"き"],[20,1,"う"],[23,1,"かれ"],[26,1,"くに"],[33,1,"き"],[35,1,"お"],[37,1,"くだ"]],"text":"主は彼らのぶどうの木と、いちじくの木とを撃ち、彼らの国のもろもろの木を折り砕かれた。"},{"ref":"Ps.105.34","start":19105034,"end":19105034,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[16,2,"むすう"],[19,1,"わか"],[25,1,"き"]],"text":"主が言われると、いなごがきたり、無数の若いいなごが来て、"},{"ref":"Ps.105.35","start":19105035,"end":19105035,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"くに"],[9,2,"あおもの"],[12,1,"く"],[20,1,"ち"],[22,1,"み"],[24,1,"く"]],"text":"彼らの国のすべての青物を食いつくし、その地の実を食いつくした。"},{"ref":"Ps.105.36","start":19105036,"end":19105036,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,1,"くに"],[15,1,"う"],[18,1,"かれ"],[25,1,"ちから"],[27,1,"はじ"],[30,1,"う"]],"text":"主は彼らの国のすべてのういごを撃ち、彼らのすべての力の初めを撃たれた。"},{"ref":"Ps.105.37","start":19105037,"end":19105037,"break":"line","breaks":[[24,"line"]],"ruby":[[3,2,"きんぎん"],[6,1,"たずさ"],[15,1,"で"],[17,1,"い"],[26,2,"ぶぞく"],[37,1,"たお"],[40,1,"もの"]],"text":"そして金銀を携えてイスラエルを出て行かせられた。その部族のうちに、ひとりの倒れる者もなかった。"},{"ref":"Ps.105.38","start":19105038,"end":19105038,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"かれ"],[8,1,"さ"],[12,1,"よろこ"],[16,1,"かれ"],[19,1,"たい"],[22,1,"おそ"],[25,1,"かれ"],[28,1,"のぞ"]],"text":"エジプトは彼らの去るのを喜んだ。彼らに対する恐れが彼らに臨んだからである。"},{"ref":"Ps.105.39","start":19105039,"end":19105039,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"くも"],[14,1,"よる"],[16,1,"ひ"],[21,1,"てら"]],"text":"主は雲をひろげておおいとし、夜は火をもって照された。"},{"ref":"Ps.105.40","start":19105040,"end":19105040,"break":"line","breaks":[[23,"line"]],"ruby":[[2,1,"かれ"],[5,1,"もと"],[16,1,"と"],[23,1,"てん"],[30,1,"ゆた"],[33,1,"かれ"],[36,1,"あた"]],"text":"また彼らの求めによって、うずらを飛びきたらせ、天から、かてを豊かに彼らに与えられた。"},{"ref":"Ps.105.41","start":19105041,"end":19105041,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"いわ"],[4,1,"ひら"],[10,1,"みず"],[17,1,"で"],[24,1,"ち"],[26,1,"かわ"],[31,1,"なが"]],"text":"主が岩を開かれると、水がほとばしり出て、かわいた地に川のように流れた。"},{"ref":"Ps.105.42","start":19105042,"end":19105042,"break":"line","breaks":[[14,"line"]],"ruby":[[3,1,"しゅ"],[7,1,"せい"],[10,2,"やくそく"],[25,1,"おぼ"]],"text":"これは主がその聖なる約束と、そのしもべアブラハムを覚えられたからである。"},{"ref":"Ps.105.43","start":19105043,"end":19105043,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"しゅ"],[8,1,"たみ"],[10,1,"みちび"],[13,1,"よろこ"],[17,1,"で"],[19,1,"い"],[25,1,"えら"],[29,1,"たみ"],[31,1,"みちび"],[34,1,"うた"],[38,1,"で"],[40,1,"い"]],"text":"こうして主はその民を導いて喜びつつ出て行かせ、その選ばれた民を導いて歌いつつ出て行かせられた。"},{"ref":"Ps.105.44","start":19105044,"end":19105044,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"くに"],[11,1,"ち"],[13,1,"かれ"],[16,1,"あた"],[24,1,"かれ"],[32,1,"たみ"],[34,2,"きんろう"],[37,1,"み"],[39,2,"じぶん"]],"text":"主はもろもろの国びとの地を彼らに与えられたので、彼らはもろもろの民の勤労の実を自分のものとした。"},{"ref":"Ps.105.45","start":19105045,"end":19105045,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[3,1,"かれ"],[6,1,"しゅ"],[8,1,"さだ"],[11,1,"まも"],[20,1,"おこな"],[28,1,"しゅ"]],"text":"これは彼らが主の定めを守り、そのおきてを行うためである。主をほめたたえよ。"}]