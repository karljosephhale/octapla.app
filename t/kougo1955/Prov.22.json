[{"ref":"Prov.22.1","start":20022001,"end":20022001,"break":"paragraph","breaks":[[13,"line"]],"ruby":[[0,2,"れいめい"],[3,1,"おお"],[7,1,"とみ"],[13,2,"おんけい"],[16,1,"ぎん"],[18,1,"きん"],[22,1,"よ"]],"text":"令名は大いなる富にまさり、恩恵は銀や金よりも良い。"},{"ref":"Prov.22.2","start":20022002,"end":20022002,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"と"],[3,1,"もの"],[5,1,"まず"],[8,1,"もの"],[11,1,"とも"],[13,1,"よ"],[24,1,"つく"],[30,1,"しゅ"]],"text":"富める者と貧しい者とは共に世におる、すべてこれを造られたのは主である。"},{"ref":"Prov.22.3","start":20022003,"end":20022003,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かしこ"],[2,1,"もの"],[4,1,"わざわい"],[6,1,"み"],[8,1,"みずか"],[10,1,"さ"],[13,2,"しりょ"],[18,1,"もの"],[20,1,"すす"],[27,1,"ばつ"]],"text":"賢い者は災を見て自ら避け、思慮のない者は進んでいって、罰をうける。"},{"ref":"Prov.22.4","start":20022004,"end":20022004,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"けんそん"],[3,1,"しゅ"],[5,1,"おそ"],[12,1,"むく"],[16,1,"とみ"],[18,1,"ほまれ"],[20,1,"いのち"]],"text":"謙遜と主を恐れることとの報いは、富と誉と命とである。"},{"ref":"Prov.22.5","start":20022005,"end":20022005,"break":"line","breaks":[[20,"line"]],"ruby":[[5,1,"もの"],[7,1,"みち"],[25,1,"まも"],[27,1,"もの"],[29,1,"とお"],[34,1,"はな"]],"text":"よこしまな者の道にはいばらとわながあり、たましいを守る者は遠くこれを離れる。"},{"ref":"Prov.22.6","start":20022006,"end":20022006,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"こ"],[4,1,"い"],[8,1,"みち"],[10,1,"したが"],[13,1,"おし"],[22,2,"としお"],[31,1,"はな"]],"text":"子をその行くべき道に従って教えよ、そうすれば年老いても、それを離れることがない。"},{"ref":"Prov.22.7","start":20022007,"end":20022007,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"と"],[3,1,"もの"],[5,1,"まず"],[8,1,"もの"],[10,1,"おさ"],[13,1,"か"],[16,1,"もの"],[18,1,"か"],[20,1,"ひと"],[22,2,"どれい"]],"text":"富める者は貧しき者を治め、借りる者は貸す人の奴隷となる。"},{"ref":"Prov.22.8","start":20022008,"end":20022008,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"あく"],[4,1,"もの"],[6,1,"わざわい"],[8,1,"か"],[13,1,"いか"]],"text":"悪をまく者は災を刈り、その怒りのつえはすたれる。"},{"ref":"Prov.22.9","start":20022009,"end":20022009,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ひと"],[2,1,"み"],[4,1,"めぐ"],[6,1,"もの"],[14,2,"じぶん"],[20,1,"まず"],[23,1,"ひと"],[25,1,"あた"]],"text":"人を見て恵む者はめぐまれる、自分のパンを貧しい人に与えるからである。"},{"ref":"Prov.22.10","start":20022010,"end":20022010,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"もの"],[6,2,"ついほう"],[11,1,"あらそ"],[16,1,"さ"]],"text":"あざける者を追放すれば争いもまた去り、かつ、いさかいも、はずかしめもなくなる。"},{"ref":"Prov.22.11","start":20022011,"end":20022011,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"こころ"],[2,2,"けっぱく"],[5,1,"あい"],[8,1,"もの"],[12,2,"ことば"],[15,2,"じょうひん"],[18,1,"もの"],[21,1,"おう"],[25,1,"とも"]],"text":"心の潔白を愛する者、その言葉の上品な者は、王がその友となる。"},{"ref":"Prov.22.12","start":20022012,"end":20022012,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"め"],[4,2,"ちしき"],[8,1,"もの"],[10,1,"まも"],[16,1,"しゅ"],[18,3,"ふしんじつ"],[22,1,"もの"],[24,2,"ことば"],[27,1,"やぶ"]],"text":"主の目は知識ある者を守る、しかし主は不信実な者の言葉を敗られる。"},{"ref":"Prov.22.13","start":20022013,"end":20022013,"break":"line","breaks":[[18,"line"]],"ruby":[[3,1,"もの"],[5,1,"い"],[27,1,"ころ"]],"text":"なまけ者は言う、「ししがそとにいる、わたしは、ちまたで殺される」と。"},{"ref":"Prov.22.14","start":20022014,"end":20022014,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"ゆうじょ"],[3,1,"くち"],[5,1,"ふか"],[7,1,"おと"],[9,1,"あな"],[14,1,"しゅ"],[16,1,"にく"],[20,1,"もの"],[24,1,"なか"],[26,1,"おちい"]],"text":"遊女の口は深い落し穴である、主に憎まれる者はその中に陥る。"},{"ref":"Prov.22.15","start":20022015,"end":20022015,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"おろ"],[6,2,"こども"],[9,1,"こころ"],[11,1,"なか"],[21,1,"こら"],[32,1,"とお"],[34,1,"お"]],"text":"愚かなことが子供の心の中につながれている、懲しめのむちは、これを遠く追いだす。"},{"ref":"Prov.22.16","start":20022016,"end":20022016,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[10,2,"じぶん"],[13,1,"とみ"],[15,1,"ま"],[21,1,"もの"],[24,1,"と"],[27,1,"もの"],[29,1,"あた"],[32,1,"もの"],[39,1,"かなら"],[41,1,"まず"]],"text":"貧しい者をしえたげて自分の富を増そうとする者と、富める者に与える者とは、ついに必ず貧しくなる。"},{"ref":"Prov.22.17","start":20022017,"end":20022017,"break":"stanza","breaks":[[21,"line"]],"ruby":[[4,1,"みみ"],[6,1,"かたむ"],[9,2,"ちえ"],[13,1,"もの"],[15,2,"ことば"],[18,1,"き"],[28,2,"ちしき"],[35,1,"こころ"],[37,1,"もち"]],"text":"あなたの耳を傾けて知恵ある者の言葉を聞き、かつ、わたしの知識にあなたの心を用いよ。"},{"ref":"Prov.22.18","start":20022018,"end":20022018,"break":"line","breaks":[[13,"line"],[36,"line"]],"ruby":[[10,1,"たも"],[28,1,"そな"],[36,1,"たの"]],"text":"これをあなたのうちに保ち、ことごとく、あなたのくちびるに備えておくなら、楽しいことである。"},{"ref":"Prov.22.19","start":20022019,"end":20022019,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"しゅ"],[7,1,"よ"],[9,1,"たの"],[37,1,"おし"]],"text":"あなたが主に、寄り頼むことのできるように、わたしはきょう、これをあなたにも教える。"},{"ref":"Prov.22.20","start":20022020,"end":20022020,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"すす"],[8,2,"ちしき"],[15,2,"ことば"]],"text":"わたしは、勧めと知識との三十の言葉をあなたのためにしるしたではないか。"},{"ref":"Prov.22.21","start":20022021,"end":20022021,"break":"line","breaks":[[22,"line"],[33,"line"]],"ruby":[[3,1,"ただ"],[9,2,"しんじつ"],[19,1,"しめ"],[31,1,"もの"],[33,2,"しんじつ"],[36,1,"こたえ"]],"text":"それは正しいこと、真実なことをあなたに示し、あなたをつかわした者に真実の答をさせるためであった。"},{"ref":"Prov.22.22","start":20022022,"end":20022022,"break":"stanza","breaks":[[23,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[6,1,"まず"],[23,1,"なや"],[25,1,"もの"],[28,1,"まち"],[30,1,"もん"]],"text":"貧しい者を、貧しいゆえに、かすめてはならない、悩む者を、町の門でおさえつけてはならない。"},{"ref":"Prov.22.23","start":20022023,"end":20022023,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"かれ"],[8,1,"うった"],[17,1,"かれ"],[24,1,"もの"],[26,1,"いのち"]],"text":"それは主が彼らの訴えをただし、かつ彼らをそこなう者の命を、そこなわれるからである。"},{"ref":"Prov.22.24","start":20022024,"end":20022024,"break":"line","ruby":[[0,1,"いか"],[2,1,"もの"],[4,1,"まじ"],[9,1,"いきどお"],[11,1,"ひと"],[13,1,"とも"],[15,1,"い"]],"text":"怒る者と交わるな、憤る人と共に行くな。"},{"ref":"Prov.22.25","start":20022025,"end":20022025,"break":"line","breaks":[[16,"line"]],"ruby":[[9,1,"みち"],[24,1,"おちい"]],"text":"それはあなたがその道にならって、みずから、わなに陥ることのないためである。"},{"ref":"Prov.22.26","start":20022026,"end":20022026,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"ひと"],[6,1,"て"],[8,1,"う"],[10,1,"もの"],[21,1,"ひと"],[23,2,"ふさい"],[26,2,"ほしょう"]],"text":"あなたは人と手を打つ者となってはならない、人の負債の保証をしてはならない。"},{"ref":"Prov.22.27","start":20022027,"end":20022027,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[4,1,"つぐな"],[18,1,"ね"],[22,2,"ねどこ"],[28,1,"ひと"],[30,1,"うば"],[32,1,"と"]],"text":"あなたが償うものがないとき、あなたの寝ている寝床までも、人が奪い取ってよかろうか。"},{"ref":"Prov.22.28","start":20022028,"end":20022028,"break":"line","ruby":[[4,2,"せんぞ"],[7,1,"た"],[10,1,"ふる"],[12,2,"じざかい"],[15,1,"うつ"]],"text":"あなたの先祖が立てた古い地境を移してはならない。"},{"ref":"Prov.22.29","start":20022029,"end":20022029,"break":"line","breaks":[[18,"line"],[33,"line"]],"ruby":[[9,1,"たく"],[12,1,"ひと"],[14,1,"み"],[23,1,"ひと"],[25,1,"おう"],[27,1,"まえ"],[29,1,"た"],[33,1,"いや"],[36,2,"ひとびと"],[39,1,"まえ"],[42,1,"た"]],"text":"あなたはそのわざに巧みな人を見るか、そのような人は王の前に立つが、卑しい人々の前には立たない。"}]