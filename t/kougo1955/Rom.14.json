[{"ref":"Rom.14.1","start":45014001,"end":45014001,"break":"paragraph","ruby":[[0,2,"しんこう"],[3,1,"よわ"],[5,1,"もの"],[7,1,"う"],[18,2,"いけん"],[21,2,"ひひょう"]],"text":"信仰の弱い者を受けいれなさい。ただ、意見を批評するためであってはならない。"},{"ref":"Rom.14.2","start":45014002,"end":45014002,"break":"none","ruby":[[2,1,"ひと"],[5,1,"なに"],[7,1,"た"],[19,1,"しん"],[26,1,"よわ"],[28,1,"ひと"],[30,2,"やさい"],[35,1,"た"]],"text":"ある人は、何を食べてもさしつかえないと信じているが、弱い人は野菜だけを食べる。"},{"ref":"Rom.14.3","start":45014003,"end":45014003,"break":"none","ruby":[[0,1,"た"],[3,1,"もの"],[5,1,"た"],[9,1,"もの"],[11,1,"かろ"],[20,1,"た"],[24,1,"もの"],[26,1,"た"],[29,1,"もの"],[41,1,"かみ"],[43,1,"かれ"],[45,1,"う"],[50,1,"くだ"]],"text":"食べる者は食べない者を軽んじてはならず、食べない者も食べる者をさばいてはならない。神は彼を受けいれて下さったのであるから。"},{"ref":"Rom.14.4","start":45014004,"end":45014004,"break":"none","ruby":[[0,2,"たにん"],[3,1,"しもべ"],[18,2,"なにもの"],[25,1,"かれ"],[27,1,"た"],[31,1,"たお"],[39,2,"しゅじん"],[53,1,"かれ"],[55,1,"た"],[63,1,"しゅ"],[65,1,"かれ"],[67,1,"た"]],"text":"他人の僕をさばくあなたは、いったい、何者であるか。彼が立つのも倒れるのも、その主人によるのである。しかし、彼は立つようになる。主は彼を立たせることができるからである。"},{"ref":"Rom.14.5","start":45014005,"end":45014005,"break":"none","ruby":[[5,1,"ひと"],[10,1,"ひ"],[14,1,"ひ"],[18,2,"だいじ"],[24,1,"かんが"],[30,1,"ひと"],[34,1,"ひ"],[36,1,"おな"],[40,1,"かんが"],[44,2,"かくじ"],[51,1,"こころ"],[53,1,"なか"],[56,2,"かくしん"],[59,1,"も"]],"text":"また、ある人は、この日がかの日よりも大事であると考え、ほかの人はどの日も同じだと考える。各自はそれぞれ心の中で、確信を持っておるべきである。"},{"ref":"Rom.14.6","start":45014006,"end":45014006,"break":"none","ruby":[[0,1,"ひ"],[2,1,"おも"],[6,1,"もの"],[9,1,"しゅ"],[14,1,"おも"],[21,1,"た"],[24,1,"もの"],[26,1,"しゅ"],[31,1,"た"],[35,1,"かみ"],[37,2,"かんしゃ"],[41,1,"た"],[50,1,"た"],[54,1,"もの"],[56,1,"しゅ"],[61,1,"た"],[70,1,"かみ"],[72,2,"かんしゃ"]],"text":"日を重んじる者は、主のために重んじる。また食べる者も主のために食べる。神に感謝して食べるからである。食べない者も主のために食べない。そして、神に感謝する。"},{"ref":"Rom.14.7","start":45014007,"end":45014007,"break":"none","ruby":[[19,2,"じぶん"],[25,1,"い"],[28,1,"もの"],[38,2,"じぶん"],[44,1,"し"],[46,1,"もの"]],"text":"すなわち、わたしたちのうち、だれひとり自分のために生きる者はなく、だれひとり自分のために死ぬ者はない。"},{"ref":"Rom.14.8","start":45014008,"end":45014008,"break":"none","ruby":[[7,1,"い"],[12,1,"しゅ"],[17,1,"い"],[20,1,"し"],[24,1,"しゅ"],[29,1,"し"],[36,1,"い"],[43,1,"し"],[56,1,"しゅ"]],"text":"わたしたちは、生きるのも主のために生き、死ぬのも主のために死ぬ。だから、生きるにしても死ぬにしても、わたしたちは主のものなのである。"},{"ref":"Rom.14.9","start":45014009,"end":45014009,"break":"none","ruby":[[11,2,"ししゃ"],[14,2,"せいしゃ"],[18,1,"しゅ"],[26,1,"し"],[29,1,"い"],[31,1,"かえ"]],"text":"なぜなら、キリストは、死者と生者との主となるために、死んで生き返られたからである。"},{"ref":"Rom.14.10","start":45014010,"end":45014010,"break":"none","ruby":[[13,2,"きょうだい"],[29,2,"きょうだい"],[32,1,"かろ"],[48,1,"かみ"],[54,1,"ざ"],[56,1,"まえ"],[58,1,"た"]],"text":"それだのに、あなたは、なぜ兄弟をさばくのか。あなたは、なぜ兄弟を軽んじるのか。わたしたちはみな、神のさばきの座の前に立つのである。"},{"ref":"Rom.14.11","start":45014011,"end":45014011,"break":"none","breaks":[[5,"stanza"],[23,"line"],[42,"line"]],"ruby":[[6,1,"しゅ"],[8,1,"い"],[17,1,"い"],[35,1,"たい"],[46,1,"した"],[49,1,"かみ"],[65,1,"か"]],"text":"すなわち、「主が言われる。わたしは生きている。すべてのひざは、わたしに対してかがみ、すべての舌は、神にさんびをささげるであろう」と書いてある。"},{"ref":"Rom.14.12","start":45014012,"end":45014012,"break":"none","ruby":[[17,1,"かみ"],[19,1,"たい"],[22,2,"じぶん"],[25,1,"い"]],"text":"だから、わたしたちひとりびとりは、神に対して自分の言いひらきをすべきである。"},{"ref":"Rom.14.13","start":45014013,"end":45014013,"break":"paragraph","ruby":[[5,2,"こんご"],[14,1,"たがい"],[19,1,"あ"],[40,1,"さまた"],[45,1,"もの"],[55,1,"もの"],[57,2,"きょうだい"],[60,1,"まえ"],[62,1,"お"],[70,1,"き"]],"text":"それゆえ、今後わたしたちは、互にさばき合うことをやめよう。むしろ、あなたがたは、妨げとなる物や、つまずきとなる物を兄弟の前に置かないことに、決めるがよい。"},{"ref":"Rom.14.14","start":45014014,"end":45014014,"break":"none","ruby":[[5,1,"しゅ"],[13,1,"し"],[17,2,"かくしん"],[26,2,"じたい"],[29,1,"けが"],[49,1,"けが"],[55,1,"かんが"],[58,1,"ひと"],[63,1,"けが"]],"text":"わたしは、主イエスにあって知りかつ確信している。それ自体、汚れているものは一つもない。ただ、それが汚れていると考える人にだけ、汚れているのである。"},{"ref":"Rom.14.15","start":45014015,"end":45014015,"break":"none","ruby":[[2,2,"しょくもつ"],[8,2,"きょうだい"],[11,1,"くる"],[26,1,"あい"],[31,1,"ある"],[46,2,"しょくもつ"],[53,2,"きょうだい"],[56,1,"ほろ"],[71,1,"かれ"],[78,1,"し"]],"text":"もし食物のゆえに兄弟を苦しめるなら、あなたは、もはや愛によって歩いているのではない。あなたの食物によって、兄弟を滅ぼしてはならない。キリストは彼のためにも、死なれたのである。"},{"ref":"Rom.14.16","start":45014016,"end":45014016,"break":"none","ruby":[[15,1,"よ"],[17,1,"こと"],[24,1,"たね"]],"text":"それだから、あなたがたにとって良い事が、そしりの種にならぬようにしなさい。"},{"ref":"Rom.14.17","start":45014017,"end":45014017,"break":"none","ruby":[[0,1,"かみ"],[2,1,"くに"],[4,2,"いんしょく"],[11,1,"ぎ"],[14,2,"へいわ"],[18,2,"せいれい"],[24,1,"よろこ"]],"text":"神の国は飲食ではなく、義と、平和と、聖霊における喜びとである。"},{"ref":"Rom.14.18","start":45014018,"end":45014018,"break":"none","ruby":[[9,1,"つか"],[12,1,"もの"],[15,1,"かみ"],[17,1,"よろこ"],[24,1,"ひと"],[27,1,"う"]],"text":"こうしてキリストに仕える者は、神に喜ばれ、かつ、人にも受けいれられるのである。"},{"ref":"Rom.14.19","start":45014019,"end":45014019,"break":"none","ruby":[[8,2,"へいわ"],[11,2,"やくだ"],[18,1,"たがい"],[20,1,"とく"],[22,1,"たか"],[29,1,"お"],[31,1,"もと"]],"text":"こういうわけで、平和に役立つことや、互の徳を高めることを、追い求めようではないか。"},{"ref":"Rom.14.20","start":45014020,"end":45014020,"break":"none","ruby":[[0,2,"しょくもつ"],[7,1,"かみ"],[13,2,"はかい"],[27,1,"もの"],[39,1,"た"],[42,1,"ひと"],[50,1,"もの"],[54,1,"あく"]],"text":"食物のことで、神のみわざを破壊してはならない。すべての物はきよい。ただ、それを食べて人をつまずかせる者には、悪となる。"},{"ref":"Rom.14.21","start":45014021,"end":45014021,"break":"none","ruby":[[0,1,"にく"],[2,1,"く"],[6,1,"さけ"],[8,1,"の"],[16,2,"きょうだい"],[29,1,"よ"]],"text":"肉を食わず、酒を飲まず、そのほか兄弟をつまずかせないのは、良いことである。"},{"ref":"Rom.14.22","start":45014022,"end":45014022,"break":"none","ruby":[[4,1,"も"],[9,2,"しんこう"],[13,1,"かみ"],[20,2,"じぶん"],[22,2,"じしん"],[25,1,"も"],[33,1,"みずか"],[35,1,"よ"],[38,1,"さだ"],[53,1,"おも"],[57,1,"ひと"]],"text":"あなたの持っている信仰を、神のみまえに、自分自身に持っていなさい。自ら良いと定めたことについて、やましいと思わない人は、さいわいである。"},{"ref":"Rom.14.23","start":45014023,"end":45014023,"break":"none","ruby":[[4,1,"うたが"],[9,1,"た"],[12,1,"もの"],[15,2,"しんこう"],[25,1,"つみ"],[27,1,"さだ"],[36,2,"しんこう"],[47,1,"つみ"]],"text":"しかし、疑いながら食べる者は、信仰によらないから、罪に定められる。すべて信仰によらないことは、罪である。"}]