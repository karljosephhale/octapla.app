[{"ref":"Matt.28.1","start":40028001,"end":40028001,"break":"paragraph","ruby":[[3,3,"あんそくにち"],[7,1,"おわ"],[11,1,"しゅう"],[13,1,"はじ"],[16,1,"ひ"],[18,1,"あ"],[20,1,"がた"],[41,1,"はか"],[43,1,"み"]],"text":"さて、安息日が終って、週の初めの日の明け方に、マグダラのマリヤとほかのマリヤとが、墓を見にきた。"},{"ref":"Matt.28.2","start":40028002,"end":40028002,"break":"none","ruby":[[4,1,"おお"],[7,2,"じしん"],[10,1,"おこ"],[17,1,"しゅ"],[19,1,"つかい"],[21,1,"てん"],[24,1,"くだ"],[33,1,"いし"],[45,1,"うえ"]],"text":"すると、大きな地震が起った。それは主の使が天から下って、そこにきて石をわきへころがし、その上にすわったからである。"},{"ref":"Matt.28.3","start":40028003,"end":40028003,"break":"none","ruby":[[2,1,"すがた"],[12,1,"かがや"],[17,1,"ころも"],[19,1,"ゆき"],[24,2,"まっしろ"]],"text":"その姿はいなずまのように輝き、その衣は雪のように真白であった。"},{"ref":"Matt.28.4","start":40028004,"end":40028004,"break":"none","ruby":[[0,2,"みは"],[8,1,"ひと"],[13,1,"おそ"],[18,1,"あま"],[20,1,"ふる"],[27,2,"しにん"]],"text":"見張りをしていた人たちは、恐ろしさの余り震えあがって、死人のようになった。"},{"ref":"Matt.28.5","start":40028005,"end":40028005,"break":"none","ruby":[[2,2,"みつかい"],[5,1,"おんな"],[13,1,"い"],[18,1,"おそ"],[33,3,"じゅうじか"],[49,1,"さが"]],"text":"この御使は女たちにむかって言った、「恐れることはない。あなたがたが十字架におかかりになったイエスを捜していることは、わたしにわかっているが、"},{"ref":"Matt.28.6","start":40028006,"end":40028006,"break":"none","ruby":[[15,1,"い"],[43,1,"おさ"],[50,2,"ばしょ"]],"text":"もうここにはおられない。かねて言われたとおりに、よみがえられたのである。さあ、イエスが納められていた場所をごらんなさい。"},{"ref":"Matt.28.7","start":40028007,"end":40028007,"break":"none","ruby":[[4,1,"いそ"],[7,1,"い"],[11,2,"でし"],[18,1,"つた"],[29,2,"しにん"],[32,1,"なか"],[43,1,"み"],[53,1,"さき"],[60,1,"い"],[69,1,"あ"],[91,1,"い"]],"text":"そして、急いで行って、弟子たちにこう伝えなさい、『イエスは死人の中からよみがえられた。見よ、あなたがたより先にガリラヤへ行かれる。そこでお会いできるであろう』。あなたがたに、これだけ言っておく」。"},{"ref":"Matt.28.8","start":40028008,"end":40028008,"break":"none","ruby":[[3,1,"おんな"],[7,1,"おそ"],[13,1,"おお"],[14,1,"よろこ"],[18,1,"いそ"],[21,1,"はか"],[23,1,"た"],[25,1,"さ"],[28,2,"でし"],[33,1,"し"],[40,1,"はし"],[43,1,"い"]],"text":"そこで女たちは恐れながらも大喜びで、急いで墓を立ち去り、弟子たちに知らせるために走って行った。"},{"ref":"Matt.28.9","start":40028009,"end":40028009,"break":"none","ruby":[[8,1,"かれ"],[11,2,"であ"],[17,2,"へいあん"],[23,1,"い"],[30,1,"かれ"],[33,2,"ちかよ"],[41,1,"あし"],[47,1,"はい"]],"text":"すると、イエスは彼らに出会って、「平安あれ」と言われたので、彼らは近寄りイエスのみ足をいだいて拝した。"},{"ref":"Matt.28.10","start":40028010,"end":40028010,"break":"none","ruby":[[9,1,"かれ"],[12,1,"い"],[18,1,"おそ"],[27,1,"い"],[30,2,"きょうだい"],[41,1,"い"],[51,1,"あ"],[60,1,"つ"]],"text":"そのとき、イエスは彼らに言われた、「恐れることはない。行って兄弟たちに、ガリラヤに行け、そこでわたしに会えるであろう、と告げなさい」。"},{"ref":"Matt.28.11","start":40028011,"end":40028011,"break":"paragraph","ruby":[[0,1,"おんな"],[4,1,"おこな"],[9,1,"あいだ"],[12,2,"ばんにん"],[20,2,"ひとびと"],[23,1,"みやこ"],[25,1,"かえ"],[34,3,"できごと"],[38,3,"さいしちょう"],[44,1,"はな"]],"text":"女たちが行っている間に、番人のうちのある人々が都に帰って、いっさいの出来事を祭司長たちに話した。"},{"ref":"Matt.28.12","start":40028012,"end":40028012,"break":"none","ruby":[[0,3,"さいしちょう"],[6,2,"ちょうろう"],[11,1,"あつ"],[15,2,"きょうぎ"],[22,2,"へいそつ"],[32,1,"かね"],[34,1,"あた"],[37,1,"い"]],"text":"祭司長たちは長老たちと集まって協議をこらし、兵卒たちにたくさんの金を与えて言った、"},{"ref":"Matt.28.13","start":40028013,"end":40028013,"break":"none","ruby":[[2,2,"でし"],[7,2,"よなか"],[18,1,"ね"],[22,1,"あいだ"],[24,1,"かれ"],[26,1,"ぬす"],[31,1,"い"]],"text":"「『弟子たちが夜中にきて、われわれの寝ている間に彼を盗んだ』と言え。"},{"ref":"Matt.28.14","start":40028014,"end":40028014,"break":"none","ruby":[[0,2,"まんいち"],[7,2,"そうとく"],[10,1,"みみ"],[23,2,"そうとく"],[26,1,"と"],[36,2,"めいわく"],[39,1,"か"]],"text":"万一このことが総督の耳にはいっても、われわれが総督に説いて、あなたがたに迷惑が掛からないようにしよう」。"},{"ref":"Matt.28.15","start":40028015,"end":40028015,"break":"none","ruby":[[4,1,"かれ"],[7,1,"かね"],[9,1,"う"],[11,1,"と"],[15,1,"おし"],[32,1,"はなし"],[35,2,"きょう"],[38,1,"いた"],[45,1,"じん"],[47,1,"あいだ"]],"text":"そこで、彼らは金を受け取って、教えられたとおりにした。そしてこの話は、今日に至るまでユダヤ人の間にひろまっている。"},{"ref":"Matt.28.16","start":40028016,"end":40028016,"break":"paragraph","ruby":[[5,1,"にん"],[7,2,"でし"],[17,1,"い"],[25,1,"かれ"],[28,1,"い"],[33,1,"めい"],[38,1,"やま"],[40,1,"のぼ"]],"text":"さて、十一人の弟子たちはガリラヤに行って、イエスが彼らに行くように命じられた山に登った。"},{"ref":"Matt.28.17","start":40028017,"end":40028017,"break":"none","ruby":[[8,1,"あ"],[11,1,"はい"],[19,1,"うたが"],[21,1,"もの"]],"text":"そして、イエスに会って拝した。しかし、疑う者もいた。"},{"ref":"Matt.28.18","start":40028018,"end":40028018,"break":"none","ruby":[[4,1,"かれ"],[7,1,"ちか"],[13,1,"い"],[24,1,"てん"],[30,1,"ち"],[42,2,"けんい"],[45,1,"さづ"]],"text":"イエスは彼らに近づいてきて言われた、「わたしは、天においても地においても、いっさいの権威を授けられた。"},{"ref":"Matt.28.19","start":40028019,"end":40028019,"break":"none","ruby":[[12,1,"い"],[20,2,"こくみん"],[23,2,"でし"],[29,1,"ちち"],[31,1,"こ"],[33,2,"せいれい"],[37,1,"な"],[43,1,"かれ"],[52,1,"ほどこ"]],"text":"それゆえに、あなたがたは行って、すべての国民を弟子として、父と子と聖霊との名によって、彼らにバプテスマを施し、"},{"ref":"Matt.28.20","start":40028020,"end":40028020,"break":"none","ruby":[[6,1,"めい"],[20,1,"まも"],[25,1,"おし"],[29,1,"み"],[36,1,"よ"],[38,1,"おわ"],[52,1,"とも"]],"text":"あなたがたに命じておいたいっさいのことを守るように教えよ。見よ、わたしは世の終りまで、いつもあなたがたと共にいるのである」。"}]