[{"ref":"Acts.23.1","start":44023001,"end":44023001,"break":"paragraph","ruby":[[4,2,"ぎかい"],[7,1,"み"],[11,1,"い"],[16,2,"きょうだい"],[26,2,"きょう"],[31,1,"かみ"],[33,1,"まえ"],[40,1,"あき"],[44,2,"りょうしん"],[52,2,"こうどう"]],"text":"パウロは議会を見つめて言った、「兄弟たちよ、わたしは今日まで、神の前に、ひたすら明らかな良心にしたがって行動してきた」。"},{"ref":"Acts.23.2","start":44023002,"end":44023002,"break":"none","ruby":[[4,3,"だいさいし"],[20,1,"た"],[25,1,"もの"],[30,1,"かれ"],[32,1,"くち"],[34,1,"う"],[37,1,"めい"]],"text":"すると、大祭司アナニヤが、パウロのそばに立っている者たちに、彼の口を打てと命じた。"},{"ref":"Acts.23.3","start":44023003,"end":44023003,"break":"none","ruby":[[18,1,"い"],[23,1,"しろ"],[25,1,"ぬ"],[29,1,"かべ"],[32,1,"かみ"],[38,1,"う"],[50,2,"りっぽう"],[69,1,"ざ"],[79,2,"りっぽう"],[91,1,"う"],[96,1,"めい"]],"text":"そのとき、パウロはアナニヤにむかって言った、「白く塗られた壁よ、神があなたを打つであろう。あなたは、律法にしたがって、わたしをさばくために座についているのに、律法にそむいて、わたしを打つことを命じるのか」。"},{"ref":"Acts.23.4","start":44023004,"end":44023004,"break":"none","ruby":[[7,1,"た"],[12,1,"もの"],[16,1,"い"],[21,1,"かみ"],[23,3,"だいさいし"],[27,1,"たい"],[30,2,"ぶれい"],[36,1,"い"]],"text":"すると、そばに立っている者たちが言った、「神の大祭司に対して無礼なことを言うのか」。"},{"ref":"Acts.23.5","start":44023005,"end":44023005,"break":"none","ruby":[[4,1,"い"],[9,2,"きょうだい"],[15,1,"かれ"],[17,3,"だいさいし"],[23,1,"し"],[30,2,"せいしょ"],[34,1,"たみ"],[40,1,"わる"],[42,1,"い"],[53,1,"か"]],"text":"パウロは言った、「兄弟たちよ、彼が大祭司だとは知らなかった。聖書に『民のかしらを悪く言ってはいけない』と、書いてあるのだった」。"},{"ref":"Acts.23.6","start":44023006,"end":44023006,"break":"paragraph","ruby":[[5,2,"ぎいん"],[8,2,"いちぶ"],[15,1,"びと"],[20,2,"いちぶ"],[27,1,"びと"],[33,1,"み"],[36,2,"ぎかい"],[39,1,"なか"],[41,1,"こえ"],[43,1,"たか"],[46,1,"い"],[51,2,"きょうだい"],[65,1,"びと"],[74,1,"びと"],[76,1,"こ"],[86,2,"しにん"],[89,2,"ふっかつ"],[92,1,"のぞ"],[105,2,"さいばん"],[108,1,"う"]],"text":"パウロは、議員の一部がサドカイ人であり、一部はパリサイ人であるのを見て、議会の中で声を高めて言った、「兄弟たちよ、わたしはパリサイ人であり、パリサイ人の子である。わたしは、死人の復活の望みをいだいていることで、裁判を受けているのである」。"},{"ref":"Acts.23.7","start":44023007,"end":44023007,"break":"none","ruby":[[0,1,"かれ"],[4,1,"い"],[15,1,"びと"],[21,1,"びと"],[24,1,"あいだ"],[26,2,"そうろん"],[29,1,"しょう"],[32,2,"かいしゅう"],[35,1,"あい"],[36,1,"わか"]],"text":"彼がこう言ったところ、パリサイ人とサドカイ人との間に争論が生じ、会衆が相分れた。"},{"ref":"Acts.23.8","start":44023008,"end":44023008,"break":"none","ruby":[[0,2,"がんらい"],[7,1,"びと"],[10,2,"ふっかつ"],[14,2,"てんし"],[18,1,"れい"],[27,2,"そんざい"],[33,1,"い"],[40,1,"びと"],[50,2,"そんざい"],[55,2,"しゅちょう"]],"text":"元来、サドカイ人は、復活とか天使とか霊とかは、いっさい存在しないと言い、パリサイ人は、それらは、みな存在すると主張している。"},{"ref":"Acts.23.9","start":44023009,"end":44023009,"break":"none","ruby":[[4,2,"おおさわ"],[16,1,"は"],[20,2,"りっぽう"],[22,2,"がくしゃ"],[27,1,"た"],[31,1,"つよ"],[33,2,"しゅちょう"],[37,1,"い"],[50,1,"ひと"],[53,1,"なに"],[55,1,"わる"],[63,1,"おも"],[71,1,"れい"],[73,2,"てんし"],[78,1,"かれ"],[80,1,"つ"],[86,1,"し"]],"text":"そこで、大騒ぎとなった。パリサイ派のある律法学者たちが立って、強く主張して言った、「われわれは、この人には何も悪いことがないと思う。あるいは、霊か天使かが、彼に告げたのかも知れない」。"},{"ref":"Acts.23.10","start":44023010,"end":44023010,"break":"none","ruby":[[5,2,"そうろん"],[8,1,"はげ"],[17,3,"せんそつちょう"],[26,1,"かれ"],[29,1,"ひ"],[31,1,"さ"],[37,1,"き"],[43,2,"へいそつ"],[49,1,"お"],[52,1,"い"],[59,1,"かれ"],[62,1,"なか"],[65,1,"ちから"],[69,1,"ひ"],[71,1,"だ"],[74,2,"へいえい"],[77,1,"つ"],[80,1,"く"],[86,1,"めい"]],"text":"こうして、争論が激しくなったので、千卒長は、パウロが彼らに引き裂かれるのを気づかって、兵卒どもに、降りて行ってパウロを彼らの中から力づくで引き出し、兵営に連れて来るように、命じた。"},{"ref":"Acts.23.11","start":44023011,"end":44023011,"break":"paragraph","ruby":[[2,1,"よ"],[4,1,"しゅ"],[10,1,"のぞ"],[13,1,"い"]],"text":"その夜、主がパウロに臨んで言われた、「しっかりせよ。あなたは、エルサレムでわたしのことをあかししたように、ローマでもあかしをしなくてはならない」。"},{"ref":"Acts.23.12","start":44023012,"end":44023012,"break":"paragraph","ruby":[[0,1,"よ"],[2,1,"あ"],[10,1,"じん"],[13,1,"もう"],[15,1,"あ"],[26,1,"ころ"],[31,2,"いんしょく"],[38,1,"た"],[42,1,"ちか"],[44,1,"あ"]],"text":"夜が明けると、ユダヤ人らは申し合わせをして、パウロを殺すまでは飲食をいっさい断つと、誓い合った。"},{"ref":"Acts.23.13","start":44023013,"end":44023013,"break":"none","ruby":[[2,2,"いんぼう"],[5,1,"くわ"],[9,1,"もの"],[14,1,"にん"]],"text":"この陰謀に加わった者は、四十人あまりであった。"},{"ref":"Acts.23.14","start":44023014,"end":44023014,"break":"none","ruby":[[0,1,"かれ"],[4,3,"さいしちょう"],[10,2,"ちょうろう"],[19,1,"い"],[25,1,"い"],[40,1,"ころ"],[45,1,"なに"],[47,1,"た"],[53,1,"かた"],[55,1,"ちか"],[57,1,"あ"]],"text":"彼らは、祭司長たちや長老たちのところに行って、こう言った。「われわれは、パウロを殺すまでは何も食べないと、堅く誓い合いました。"},{"ref":"Acts.23.15","start":44023015,"end":44023015,"break":"none","ruby":[[11,2,"ぎかい"],[14,1,"く"],[18,1,"かれ"],[25,1,"くわ"],[28,2,"とりしら"],[37,1,"み"],[56,1,"つ"],[58,1,"だ"],[64,3,"せんそつちょう"],[68,1,"たの"],[71,1,"くだ"],[97,1,"ころ"],[103,1,"て"]],"text":"ついては、あなたがたは議会と組んで、彼のことでなお詳しく取調べをするように見せかけ、パウロをあなたがたのところに連れ出すように、千卒長に頼んで下さい。われわれとしては、パウロがそこにこないうちに殺してしまう手はずをしています」。"},{"ref":"Acts.23.16","start":44023016,"end":44023016,"break":"paragraph","ruby":[[9,2,"しまい"],[12,1,"こ"],[17,2,"まちぶ"],[24,1,"みみ"],[28,2,"へいえい"],[35,1,"い"],[46,1,"し"]],"text":"ところが、パウロの姉妹の子が、この待伏せのことを耳にし、兵営にはいって行って、パウロにそれを知らせた。"},{"ref":"Acts.23.17","start":44023017,"end":44023017,"break":"none","ruby":[[8,3,"ひゃくそつちょう"],[16,1,"よ"],[19,1,"い"],[26,2,"わかもの"],[29,3,"せんそつちょう"],[37,1,"つ"],[40,1,"い"],[48,1,"なに"],[50,2,"ほうこく"]],"text":"そこでパウロは、百卒長のひとりを呼んで言った、「この若者を千卒長のところに連れて行ってください。何か報告することがあるようですから」。"},{"ref":"Acts.23.18","start":44023018,"end":44023018,"break":"none","ruby":[[2,3,"ひゃくそつちょう"],[6,2,"わかもの"],[9,1,"つ"],[12,1,"い"],[15,3,"せんそつちょう"],[19,1,"ひ"],[25,1,"い"],[30,2,"しゅうじん"],[40,2,"わかもの"],[47,1,"はな"],[67,1,"つ"],[70,1,"い"],[85,1,"よ"],[88,1,"たの"]],"text":"この百卒長は若者を連れて行き、千卒長に引きあわせて言った、「囚人のパウロが、この若者があなたに話したいことがあるので、あなたのところに連れて行ってくれるようにと、わたしを呼んで頼みました」。"},{"ref":"Acts.23.19","start":44023019,"end":44023019,"break":"none","ruby":[[3,3,"せんそつちょう"],[8,2,"わかもの"],[11,1,"て"],[13,1,"と"],[16,1,"ひと"],[25,1,"つ"],[28,1,"い"],[31,1,"たず"],[40,1,"はな"],[52,1,"なに"]],"text":"そこで千卒長は、若者の手を取り、人のいないところへ連れて行って尋ねた、「わたしに話したいことというのは、何か」。"},{"ref":"Acts.23.20","start":44023020,"end":44023020,"break":"none","ruby":[[0,2,"わかもの"],[3,1,"い"],[11,1,"じん"],[26,1,"くわ"],[29,2,"とりしら"],[36,1,"み"],[44,2,"ぎかい"],[47,1,"かれ"],[49,1,"つ"],[51,1,"だ"],[61,1,"たの"],[66,1,"き"]],"text":"若者が言った、「ユダヤ人たちが、パウロのことをもっと詳しく取調べをすると見せかけて、あす議会に彼を連れ出すように、あなたに頼むことに決めています。"},{"ref":"Acts.23.21","start":44023021,"end":44023021,"break":"none","ruby":[[4,1,"かれ"],[7,1,"たの"],[10,1,"と"],[12,1,"あ"],[17,1,"くだ"],[23,1,"にん"],[28,1,"もの"],[35,2,"まちぶ"],[46,1,"かれ"],[54,1,"ころ"],[59,2,"いんしょく"],[66,1,"た"],[70,1,"かた"],[72,1,"ちか"],[74,1,"あ"],[87,1,"て"],[101,2,"きょか"],[104,1,"ま"]],"text":"どうぞ、彼らの頼みを取り上げないで下さい。四十人あまりの者が、パウロを待伏せしているのです。彼らは、パウロを殺すまでは飲食をいっさい断つと、堅く誓い合っています。そして、いま手はずをととのえて、あなたの許可を待っているところなのです」。"},{"ref":"Acts.23.22","start":44023022,"end":44023022,"break":"none","ruby":[[3,3,"せんそつちょう"],[18,1,"し"],[30,2,"こうがい"],[37,1,"めい"],[41,2,"わかもの"],[44,1,"かえ"]],"text":"そこで千卒長は、「このことをわたしに知らせたことは、だれにも口外するな」と命じて、若者を帰した。"},{"ref":"Acts.23.23","start":44023023,"end":44023023,"break":"paragraph","ruby":[[4,1,"かれ"],[7,3,"ひゃくそつちょう"],[14,1,"よ"],[17,1,"い"],[22,2,"ほへい"],[26,1,"めい"],[28,2,"きへい"],[32,1,"めい"],[34,1,"そう"],[35,1,"へい"],[38,1,"めい"],[47,1,"む"],[49,2,"しゅっぱつ"],[58,2,"こんや"],[61,1,"じ"],[65,2,"ようい"]],"text":"それから彼は、百卒長ふたりを呼んで言った、「歩兵二百名、騎兵七十名、槍兵二百名を、カイザリヤに向け出発できるように、今夜九時までに用意せよ。"},{"ref":"Acts.23.24","start":44023024,"end":44023024,"break":"none","ruby":[[7,1,"の"],[13,1,"うま"],[15,2,"ようい"],[20,1,"かれ"],[22,2,"そうとく"],[32,2,"ぶじ"],[35,1,"つ"],[38,1,"い"]],"text":"また、パウロを乗せるために馬を用意して、彼を総督ペリクスのもとへ無事に連れて行け」。"},{"ref":"Acts.23.25","start":44023025,"end":44023025,"break":"none","ruby":[[3,1,"かれ"],[6,1,"つぎ"],[11,2,"ぶんめん"],[14,2,"てがみ"],[17,1,"か"]],"text":"さらに彼は、次のような文面の手紙を書いた。"},{"ref":"Acts.23.26","start":44023026,"end":44023026,"break":"none","ruby":[[16,2,"そうとく"],[22,2,"かっか"],[25,2,"へいあん"],[28,1,"いの"]],"text":"「クラウデオ・ルシヤ、つつしんで総督ペリクス閣下の平安を祈ります。"},{"ref":"Acts.23.27","start":44023027,"end":44023027,"break":"none","ruby":[[0,2,"ほんにん"],[11,1,"じん"],[14,1,"とら"],[22,1,"ころ"],[35,1,"かれ"],[40,2,"しみん"],[48,1,"し"],[58,2,"へいそつ"],[63,1,"ひき"],[66,1,"い"],[70,1,"かれ"],[72,1,"すく"],[74,1,"だ"]],"text":"本人のパウロが、ユダヤ人らに捕えられ、まさに殺されようとしていたのを、彼のローマ市民であることを知ったので、わたしは兵卒たちを率いて行って、彼を救い出しました。"},{"ref":"Acts.23.28","start":44023028,"end":44023028,"break":"none","ruby":[[5,1,"かれ"],[7,1,"うった"],[12,2,"りゆう"],[15,1,"し"],[19,1,"おも"],[22,1,"かれ"],[24,2,"ぎかい"],[27,1,"つ"],[30,1,"い"]],"text":"それから、彼が訴えられた理由を知ろうと思い、彼を議会に連れて行きました。"},{"ref":"Acts.23.29","start":44023029,"end":44023029,"break":"none","ruby":[[5,1,"かれ"],[10,1,"じん"],[12,2,"りっぽう"],[15,2,"もんだい"],[18,1,"うった"],[32,2,"しけい"],[37,2,"とうごく"],[40,1,"あた"],[42,1,"つみ"]],"text":"ところが、彼はユダヤ人の律法の問題で訴えられたものであり、なんら死刑または投獄に当る罪のないことがわかりました。"},{"ref":"Acts.23.30","start":44023030,"end":44023030,"break":"none","ruby":[[6,1,"ひと"],[8,1,"たい"],[11,2,"いんぼう"],[24,2,"ほうこく"],[39,1,"と"],[45,1,"かれ"],[47,2,"かっか"],[54,1,"おく"],[63,1,"うった"],[66,1,"もの"],[72,2,"かっか"],[75,1,"まえ"],[78,1,"かれ"],[80,1,"たい"],[83,1,"もうし"],[84,1,"た"],[94,1,"めい"]],"text":"しかし、この人に対して陰謀がめぐらされているとの報告がありましたので、わたしは取りあえず、彼を閣下のもとにお送りすることにし、訴える者たちには、閣下の前で、彼に対する申立てをするようにと、命じておきました」。"},{"ref":"Acts.23.31","start":44023031,"end":44023031,"break":"paragraph","ruby":[[3,2,"ほへい"],[9,1,"めい"],[21,1,"ひ"],[23,1,"と"],[27,1,"よる"],[29,1,"あいだ"],[40,1,"つ"],[43,1,"い"]],"text":"そこで歩兵たちは、命じられたとおりパウロを引き取って、夜の間にアンテパトリスまで連れて行き、"},{"ref":"Acts.23.32","start":44023032,"end":44023032,"break":"none","ruby":[[0,2,"よくじつ"],[4,2,"きへい"],[13,2,"ごそう"],[24,2,"へいえい"],[27,1,"かえ"],[30,1,"い"]],"text":"翌日は、騎兵たちにパウロを護送させることにして、兵営に帰って行った。"},{"ref":"Acts.23.33","start":44023033,"end":44023033,"break":"none","ruby":[[0,2,"きへい"],[12,1,"つ"],[16,2,"てがみ"],[19,2,"そうとく"],[22,2,"てわた"],[33,1,"かれ"],[35,1,"ひ"]],"text":"騎兵たちは、カイザリヤに着くと、手紙を総督に手渡し、さらにパウロを彼に引きあわせた。"},{"ref":"Acts.23.34","start":44023034,"end":44023034,"break":"none","ruby":[[0,2,"そうとく"],[3,2,"てがみ"],[6,1,"よ"],[19,1,"しゅう"],[21,1,"もの"],[24,1,"たず"],[32,1,"で"],[35,1,"し"]],"text":"総督は手紙を読んでから、パウロに、どの州の者かと尋ね、キリキヤの出だと知って、"},{"ref":"Acts.23.35","start":44023035,"end":44023035,"break":"none","ruby":[[1,1,"うった"],[3,1,"ひと"],[9,1,"とき"],[16,1,"しら"],[26,1,"い"],[38,2,"かんてい"],[41,1,"かれ"],[43,1,"まも"],[51,1,"めい"]],"text":"「訴え人たちがきた時に、おまえを調べることにする」と言った。そして、ヘロデの官邸に彼を守っておくように命じた。"}]