[{"ref":"2Kgs.2.1","start":12002001,"end":12002001,"break":"paragraph","ruby":[[0,1,"しゅ"],[5,1,"かぜ"],[14,1,"てん"],[16,1,"のぼ"],[25,1,"とき"],[36,1,"とも"],[43,1,"で"],[45,1,"い"]],"text":"主がつむじ風をもってエリヤを天に上らせようとされた時、エリヤはエリシャと共にギルガルを出て行った。"},{"ref":"2Kgs.2.2","start":12002002,"end":12002002,"break":"none","ruby":[[9,1,"い"],[31,1,"しゅ"],[62,1,"い"],[67,1,"しゅ"],[69,1,"い"],[84,1,"い"],[101,1,"はな"],[111,1,"かれ"],[118,1,"くだ"]],"text":"エリヤはエリシャに言った、「どうぞ、ここにとどまってください。主はわたしをベテルにつかわされるのですから」。しかしエリシャは言った、「主は生きておられます。またあなたも生きておられます。わたしはあなたを離れません」。そして彼らはベテルへ下った。"},{"ref":"2Kgs.2.3","start":12002003,"end":12002003,"break":"none","ruby":[[6,3,"よげんしゃ"],[24,1,"で"],[28,1,"かれ"],[30,1,"い"],[35,1,"しゅ"],[45,2,"しじ"],[49,2,"しゅじん"],[57,1,"と"],[63,1,"し"],[72,1,"かれ"],[74,1,"い"],[82,1,"し"],[95,1,"だま"]],"text":"ベテルにいる預言者のともがらが、エリシャのもとに出てきて彼に言った、「主がきょう、あなたの師事する主人をあなたから取られるのを知っていますか」。彼は言った、「はい、知っています。あなたがたは黙っていてください」。"},{"ref":"2Kgs.2.4","start":12002004,"end":12002004,"break":"paragraph","ruby":[[4,1,"かれ"],[6,1,"い"],[34,1,"しゅ"],[65,1,"い"],[70,1,"しゅ"],[72,1,"い"],[87,1,"い"],[104,1,"はな"],[114,1,"かれ"],[121,1,"い"]],"text":"エリヤは彼に言った、「エリシャよ、どうぞ、ここにとどまってください。主はわたしをエリコにつかわされるのですから」。しかしエリシャは言った、「主は生きておられます。またあなたも生きておられます。わたしはあなたを離れません」。そして彼らはエリコへ行った。"},{"ref":"2Kgs.2.5","start":12002005,"end":12002005,"break":"none","ruby":[[6,3,"よげんしゃ"],[26,1,"かれ"],[28,1,"い"],[33,1,"しゅ"],[43,2,"しじ"],[47,2,"しゅじん"],[55,1,"と"],[61,1,"し"],[70,1,"かれ"],[72,1,"い"],[80,1,"し"],[93,1,"だま"]],"text":"エリコにいた預言者のともがらが、エリシャのもとにきて彼に言った、「主がきょう、あなたの師事する主人をあなたから取られるのを知っていますか」。彼は言った、「はい、知っています。あなたがたは黙っていてください」。"},{"ref":"2Kgs.2.6","start":12002006,"end":12002006,"break":"paragraph","ruby":[[6,1,"かれ"],[8,1,"い"],[30,1,"しゅ"],[57,1,"かれ"],[59,1,"い"],[64,1,"しゅ"],[66,1,"い"],[81,1,"い"],[98,1,"はな"],[112,1,"すす"],[115,1,"い"]],"text":"エリヤはまた彼に言った、「どうぞ、ここにとどまってください。主はわたしをヨルダンにつかわされるのですから」。しかし彼は言った、「主は生きておられます。またあなたも生きておられます。わたしはあなたを離れません」。そしてふたりは進んで行った。"},{"ref":"2Kgs.2.7","start":12002007,"end":12002007,"break":"none","ruby":[[0,3,"よげんしゃ"],[10,1,"にん"],[12,1,"い"],[16,1,"かれ"],[28,1,"はな"],[31,1,"た"],[37,1,"かれ"],[53,1,"た"]],"text":"預言者のともがら五十人も行って、彼らにむかって、はるかに離れて立っていた。彼らふたりは、ヨルダンのほとりに立ったが、"},{"ref":"2Kgs.2.8","start":12002008,"end":12002008,"break":"none","ruby":[[4,2,"がいとう"],[7,1,"と"],[13,1,"ま"],[16,1,"みず"],[18,1,"う"],[22,1,"みず"],[24,2,"さゆう"],[27,1,"わか"],[41,1,"つち"],[43,1,"うえ"],[45,1,"わた"]],"text":"エリヤは外套を取り、それを巻いて水を打つと、水が左右に分れたので、ふたりはかわいた土の上を渡ることができた。"},{"ref":"2Kgs.2.9","start":12002009,"end":12002009,"break":"paragraph","ruby":[[0,1,"かれ"],[3,1,"わた"],[18,1,"い"],[27,1,"と"],[36,1,"はな"],[39,1,"まえ"],[51,1,"こと"],[53,1,"もと"],[65,1,"い"],[78,1,"れい"],[83,1,"ぶん"],[89,1,"つ"]],"text":"彼らが渡ったとき、エリヤはエリシャに言った、「わたしが取られて、あなたを離れる前に、あなたのしてほしい事を求めなさい」。エリシャは言った、「どうぞ、あなたの霊の二つの分をわたしに継がせてください」。"},{"ref":"2Kgs.2.10","start":12002010,"end":12002010,"break":"none","ruby":[[4,1,"い"],[18,1,"こと"],[20,1,"もと"],[35,1,"と"],[44,1,"はな"],[49,1,"み"],[70,1,"み"]],"text":"エリヤは言った、「あなたはむずかしい事を求める。あなたがもし、わたしが取られて、あなたを離れるのを見るならば、そのようになるであろう。しかし見ないならば、そのようにはならない」。"},{"ref":"2Kgs.2.11","start":12002011,"end":12002011,"break":"none","ruby":[[0,1,"かれ"],[3,1,"すす"],[8,1,"かた"],[13,1,"とき"],[15,1,"ひ"],[17,1,"くるま"],[19,1,"ひ"],[21,1,"うま"],[33,1,"へだ"],[47,1,"かぜ"],[49,1,"の"],[52,1,"てん"]],"text":"彼らが進みながら語っていた時、火の車と火の馬があらわれて、ふたりを隔てた。そしてエリヤはつむじ風に乗って天にのぼった。"},{"ref":"2Kgs.2.12","start":12002012,"end":12002012,"break":"none","breaks":[[53,"paragraph"]],"ruby":[[8,1,"み"],[13,1,"ちち"],[18,1,"ちち"],[27,2,"せんしゃ"],[33,2,"きへい"],[38,1,"さけ"],[43,1,"ふたた"],[45,1,"かれ"],[47,1,"み"],[61,2,"じぶん"],[64,2,"きもの"],[78,1,"さ"]],"text":"エリシャはこれを見て「わが父よ、わが父よ、イスラエルの戦車よ、その騎兵よ」と叫んだが、再び彼を見なかった。そこでエリシャは自分の着物をつかんで、それを二つに裂き、"},{"ref":"2Kgs.2.13","start":12002013,"end":12002013,"break":"none","ruby":[[6,1,"み"],[9,1,"お"],[12,2,"がいとう"],[15,1,"と"],[17,1,"あ"],[20,1,"かえ"],[30,1,"きし"],[32,1,"た"]],"text":"またエリヤの身から落ちた外套を取り上げ、帰ってきてヨルダンの岸に立った。"},{"ref":"2Kgs.2.14","start":12002014,"end":12002014,"break":"none","ruby":[[7,1,"み"],[10,1,"お"],[15,2,"がいとう"],[18,1,"と"],[21,1,"みず"],[23,1,"う"],[31,1,"かみ"],[33,1,"しゅ"],[46,1,"い"],[49,1,"かれ"],[51,1,"みず"],[53,1,"う"],[57,1,"みず"],[59,2,"さゆう"],[62,1,"わか"],[73,1,"わた"]],"text":"そしてエリヤの身から落ちたその外套を取って水を打ち、「エリヤの神、主はどこにおられますか」と言い、彼が水を打つと、水は左右に分れたので、エリシャは渡った。"},{"ref":"2Kgs.2.15","start":12002015,"end":12002015,"break":"paragraph","ruby":[[6,3,"よげんしゃ"],[15,1,"かれ"],[17,1,"ちか"],[21,1,"く"],[25,1,"み"],[33,1,"れい"],[40,1,"うえ"],[51,1,"い"],[58,1,"かれ"],[61,1,"き"],[63,1,"かれ"],[65,1,"むか"],[70,1,"まえ"],[72,1,"ち"],[74,1,"ふ"]],"text":"エリコにいる預言者のともがらは彼の近づいて来るのを見て、「エリヤの霊がエリシャの上にとどまっている」と言った。そして彼らは来て彼を迎え、その前に地に伏して、"},{"ref":"2Kgs.2.16","start":12002016,"end":12002016,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[12,1,"ところ"],[14,1,"ちから"],[16,1,"つよ"],[18,1,"もの"],[22,1,"にん"],[30,1,"かれ"],[43,2,"しゅじん"],[46,1,"たず"],[56,1,"しゅ"],[58,1,"れい"],[60,1,"かれ"],[62,1,"ひ"],[68,1,"かれ"],[70,1,"やま"],[72,1,"たに"],[74,1,"な"],[80,1,"し"],[105,1,"い"]],"text":"彼に言った、「しもべらの所に力の強い者が五十人います。どうぞ彼らをつかわして、あなたの主人を尋ねさせてください。主の霊が彼を引きあげて、彼を山か谷に投げたのかも知れません」。エリシャは「つかわしてはならない」と言ったが、"},{"ref":"2Kgs.2.17","start":12002017,"end":12002017,"break":"none","ruby":[[0,1,"かれ"],[2,1,"は"],[14,1,"かれ"],[26,1,"い"],[33,1,"かれ"],[38,1,"にん"],[40,1,"もの"],[48,1,"か"],[50,1,"あいだ"],[51,1,"たず"],[56,1,"かれ"],[58,1,"み"]],"text":"彼の恥じるまで、しいたので、彼は「つかわしなさい」と言った。それで彼らは五十人の者をつかわし、三日の間尋ねたが、彼を見いださなかった。"},{"ref":"2Kgs.2.18","start":12002018,"end":12002018,"break":"none","ruby":[[18,1,"とき"],[20,1,"かれ"],[23,1,"かえ"],[36,1,"かれ"],[39,1,"い"],[56,1,"い"],[65,1,"つ"]],"text":"エリシャのなおエリコにとどまっている時、彼らが帰ってきたので、エリシャは彼らに言った、「わたしは、あなたがたに、行ってはならないと告げたではないか」。"},{"ref":"2Kgs.2.19","start":12002019,"end":12002019,"break":"paragraph","ruby":[[0,1,"まち"],[2,2,"ひとびと"],[10,1,"い"],[15,1,"み"],[25,1,"まち"],[27,2,"ばしょ"],[30,1,"よ"],[33,1,"みず"],[35,1,"わる"],[42,1,"ち"],[44,2,"りゅうざん"],[47,1,"おこ"]],"text":"町の人々はエリシャに言った、「見られるとおり、この町の場所は良いが水が悪いので、この地は流産を起すのです」。"},{"ref":"2Kgs.2.20","start":12002020,"end":12002020,"break":"none","ruby":[[5,1,"い"],[10,1,"あたら"],[13,1,"さら"],[15,1,"しお"],[17,1,"も"],[25,1,"も"],[34,1,"かれ"],[37,1,"も"]],"text":"エリシャは言った、「新しい皿に塩を盛って、わたしに持ってきなさい」。彼らは持ってきた。"},{"ref":"2Kgs.2.21","start":12002021,"end":12002021,"break":"none","ruby":[[5,1,"みず"],[7,1,"みなもと"],[9,1,"で"],[11,1,"い"],[15,1,"しお"],[20,1,"な"],[22,1,"い"],[25,1,"い"],[30,1,"しゅ"],[34,1,"おお"],[47,1,"みず"],[49,1,"よ"],[51,1,"みず"],[63,1,"し"],[65,2,"りゅうざん"],[68,1,"おこ"]],"text":"エリシャは水の源へ出て行って、塩をそこに投げ入れて言った、「主はこう仰せられる、『わたしはこの水を良い水にした。もはやここには死も流産も起らないであろう』」。"},{"ref":"2Kgs.2.22","start":12002022,"end":12002022,"break":"none","ruby":[[6,1,"みず"],[13,1,"い"],[20,1,"よ"],[22,1,"みず"],[27,2,"こんにち"],[30,1,"いた"]],"text":"こうしてその水はエリシャの言ったとおりに良い水になって今日に至っている。"},{"ref":"2Kgs.2.23","start":12002023,"end":12002023,"break":"paragraph","ruby":[[0,1,"かれ"],[10,1,"のぼ"],[15,1,"のぼ"],[18,1,"い"],[20,2,"とちゅう"],[23,1,"ちい"],[26,2,"こども"],[30,1,"まち"],[33,1,"で"],[37,1,"かれ"],[44,1,"かれ"],[53,1,"あたま"],[62,1,"あたま"],[70,1,"い"]],"text":"彼はそこからベテルへ上ったが、上って行く途中、小さい子供らが町から出てきて彼をあざけり、彼にむかって「はげ頭よ、のぼれ。はげ頭よ、のぼれ」と言ったので、"},{"ref":"2Kgs.2.24","start":12002024,"end":12002024,"break":"none","ruby":[[0,1,"かれ"],[4,1,"かえ"],[7,1,"かれ"],[10,1,"み"],[12,1,"しゅ"],[14,1,"な"],[19,1,"かれ"],[30,1,"はやし"],[32,1,"なか"],[36,1,"とう"],[38,1,"め"],[42,1,"で"],[49,1,"こ"],[50,1,"とも"],[58,1,"にん"],[60,1,"さ"]],"text":"彼はふり返って彼らを見、主の名をもって彼らをのろった。すると林の中から二頭の雌ぐまが出てきて、その子供らのうち四十二人を裂いた。"},{"ref":"2Kgs.2.25","start":12002025,"end":12002025,"break":"none","ruby":[[0,1,"かれ"],[10,1,"やま"],[12,1,"い"],[24,1,"かえ"]],"text":"彼はそこからカルメル山へ行き、そこからサマリヤに帰った。"}]