[{"ref":"Prov.15.1","start":20015001,"end":20015001,"break":"paragraph","breaks":[[12,"line"]],"ruby":[[0,1,"やわら"],[3,1,"こたえ"],[5,1,"いきどお"],[12,1,"はげ"],[15,2,"ことば"],[18,1,"いか"]],"text":"柔かい答は憤りをとどめ、激しい言葉は怒りをひきおこす。"},{"ref":"Prov.15.2","start":20015002,"end":20015002,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[6,1,"した"],[8,2,"ちしき"],[14,1,"あた"],[17,1,"おろ"],[20,1,"もの"],[22,1,"くち"],[24,1,"おろ"],[27,1,"は"],[29,1,"だ"]],"text":"知恵ある者の舌は知識をわかち与え、愚かな者の口は愚かを吐き出す。"},{"ref":"Prov.15.3","start":20015003,"end":20015003,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"め"],[13,2,"あくにん"],[16,2,"ぜんにん"],[20,2,"みは"]],"text":"主の目はどこにでもあって、悪人と善人とを見張っている。"},{"ref":"Prov.15.4","start":20015004,"end":20015004,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"やさ"],[3,1,"した"],[5,1,"いのち"],[7,1,"き"],[12,2,"らんぼう"],[15,2,"ことば"],[18,1,"たましい"],[20,1,"きず"]],"text":"優しい舌は命の木である、乱暴な言葉は魂を傷つける。"},{"ref":"Prov.15.5","start":20015005,"end":20015005,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[5,1,"ちち"],[7,2,"きょうくん"],[10,1,"かろ"],[15,1,"いまし"],[18,1,"まも"],[20,1,"もの"],[22,1,"かしこ"],[24,1,"もの"]],"text":"愚かな者は父の教訓を軽んじる、戒めを守る者は賢い者である。"},{"ref":"Prov.15.6","start":20015006,"end":20015006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"いえ"],[8,1,"おお"],[11,1,"たから"],[16,1,"あ"],[19,1,"もの"],[21,2,"しょとく"],[25,1,"わずら"]],"text":"正しい者の家には多くの宝がある、悪しき者の所得には煩いがある。"},{"ref":"Prov.15.7","start":20015007,"end":20015007,"break":"line","breaks":[[19,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[11,2,"ちしき"],[19,1,"おろ"],[22,1,"もの"],[24,1,"こころ"]],"text":"知恵ある者のくちびるは知識をひろめる、愚かな者の心はそうでない。"},{"ref":"Prov.15.8","start":20015008,"end":20015008,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"そな"],[7,1,"もの"],[9,1,"しゅ"],[11,1,"にく"],[15,1,"ただ"],[18,1,"もの"],[20,1,"いのり"],[22,1,"かれ"],[24,1,"よろこ"]],"text":"悪しき者の供え物は主に憎まれ、正しい者の祈は彼に喜ばれる。"},{"ref":"Prov.15.9","start":20015009,"end":20015009,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"みち"],[7,1,"しゅ"],[9,1,"にく"],[13,2,"せいぎ"],[16,1,"もと"],[19,1,"もの"],[21,1,"かれ"],[23,1,"あい"]],"text":"悪しき者の道は主に憎まれ、正義を求める者は彼に愛せられる。"},{"ref":"Prov.15.10","start":20015010,"end":20015010,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"みち"],[2,1,"す"],[5,1,"もの"],[13,1,"こら"],[20,1,"いまし"],[23,1,"にく"],[25,1,"もの"],[27,1,"し"],[29,1,"いた"]],"text":"道を捨てる者には、きびしい懲しめがあり、戒めを憎む者は死に至る。"},{"ref":"Prov.15.11","start":20015011,"end":20015011,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"よみ"],[3,1,"ほろ"],[7,1,"しゅ"],[9,1,"め"],[11,1,"まえ"],[16,1,"ひと"],[18,1,"こころ"]],"text":"陰府と滅びとは主の目の前にあり、人の心はなおさらである。"},{"ref":"Prov.15.12","start":20015012,"end":20015012,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"もの"],[6,1,"いまし"],[14,1,"この"],[21,2,"ちえ"],[25,1,"もの"],[27,1,"ちか"]],"text":"あざける者は戒められることを好まない、また知恵ある者に近づかない。"},{"ref":"Prov.15.13","start":20015013,"end":20015013,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"こころ"],[2,1,"たの"],[9,2,"かおいろ"],[12,1,"よろこ"],[17,1,"こころ"],[19,1,"うれ"],[25,1,"き"]],"text":"心に楽しみがあれば顔色も喜ばしい、心に憂いがあれば気はふさぐ。"},{"ref":"Prov.15.14","start":20015014,"end":20015014,"break":"line","breaks":[[14,"line"]],"ruby":[[3,1,"もの"],[5,1,"こころ"],[7,2,"ちしき"],[14,1,"おろ"],[17,1,"もの"],[19,1,"くち"],[21,1,"おろ"],[25,2,"しょくもつ"]],"text":"さとき者の心は知識をたずね、愚かな者の口は愚かさを食物とする。"},{"ref":"Prov.15.15","start":20015015,"end":20015015,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"なや"],[5,1,"もの"],[7,2,"ひび"],[19,1,"こころ"],[21,1,"たの"],[24,1,"ひと"],[26,1,"つね"],[28,2,"えんかい"]],"text":"悩んでいる者の日々はことごとくつらく、心の楽しい人は常に宴会をもつ。"},{"ref":"Prov.15.16","start":20015016,"end":20015016,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"すこ"],[3,1,"もの"],[5,2,"しょゆう"],[9,1,"しゅ"],[11,1,"おそ"],[17,1,"おお"],[20,1,"たから"],[25,1,"く"],[26,1,"ろう"]],"text":"少しの物を所有して主を恐れるのは、多くの宝をもって苦労するのにまさる。"},{"ref":"Prov.15.17","start":20015017,"end":20015017,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"やさい"],[3,1,"た"],[6,1,"たがい"],[8,1,"あい"],[14,1,"こ"],[17,1,"うし"],[19,1,"た"],[22,1,"たがい"],[24,1,"にく"]],"text":"野菜を食べて互に愛するのは、肥えた牛を食べて互に憎むのにまさる。"},{"ref":"Prov.15.18","start":20015018,"end":20015018,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"いきどお"],[5,1,"もの"],[7,1,"あらそ"],[14,1,"いか"],[22,1,"もの"],[24,1,"あらそ"]],"text":"憤りやすい者は争いをおこし、怒りをおそくする者は争いをとどめる。"},{"ref":"Prov.15.19","start":20015019,"end":20015019,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"もの"],[5,1,"みち"],[19,1,"ただ"],[22,1,"もの"],[24,1,"みち"],[26,1,"たい"]],"text":"なまけ者の道には、いばらがはえしげり、正しい者の道は平らかである。"},{"ref":"Prov.15.20","start":20015020,"end":20015020,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"こ"],[6,1,"ちち"],[8,1,"よろこ"],[13,1,"おろ"],[16,1,"ひと"],[20,1,"はは"],[22,1,"かろ"]],"text":"知恵ある子は父を喜ばせる、愚かな人はその母を軽んじる。"},{"ref":"Prov.15.21","start":20015021,"end":20015021,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"むち"],[3,1,"もの"],[5,1,"おろ"],[11,1,"よろこ"],[17,1,"もの"],[24,1,"あゆ"]],"text":"無知な者は愚かなことを喜び、さとき者はまっすぐに歩む。"},{"ref":"Prov.15.22","start":20015022,"end":20015022,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"あい"],[12,2,"けいかく"],[15,1,"やぶ"],[22,1,"もの"],[24,1,"おお"],[32,1,"かなら"],[34,1,"な"]],"text":"相はかることがなければ、計画は破れる、はかる者が多ければ、それは必ず成る。"},{"ref":"Prov.15.23","start":20015023,"end":20015023,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ひと"],[2,1,"くち"],[5,1,"で"],[7,1,"この"],[11,1,"こたえ"],[16,1,"よろこ"],[19,1,"え"],[22,1,"とき"],[28,2,"ことば"],[36,1,"よ"]],"text":"人は口から出る好ましい答によって喜びを得る、時にかなった言葉は、いかにも良いものだ。"},{"ref":"Prov.15.24","start":20015024,"end":20015024,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"ひと"],[6,1,"みち"],[8,1,"のぼ"],[11,1,"いのち"],[13,1,"いた"],[22,1,"ひと"],[24,1,"した"],[28,2,"よみ"],[31,1,"はな"]],"text":"知恵ある人の道は上って命に至る、こうしてその人は下にある陰府を離れる。"},{"ref":"Prov.15.25","start":20015025,"end":20015025,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"たか"],[5,1,"もの"],[7,1,"いえ"],[9,1,"ほろ"],[17,2,"じざかい"],[20,1,"さだ"]],"text":"主は高ぶる者の家を滅ぼし、やもめの地境を定められる。"},{"ref":"Prov.15.26","start":20015026,"end":20015026,"break":"line","breaks":[[14,"line"]],"ruby":[[0,2,"あくにん"],[3,1,"はか"],[8,1,"しゅ"],[10,1,"にく"],[14,2,"けっぱく"],[17,1,"ひと"],[19,2,"ことば"],[22,1,"かれ"],[24,1,"よろこ"]],"text":"悪人の計りごとは主に憎まれ、潔白な人の言葉は彼に喜ばれる。"},{"ref":"Prov.15.27","start":20015027,"end":20015027,"break":"line","breaks":[[21,"line"]],"ruby":[[0,2,"ふせい"],[3,1,"り"],[9,1,"もの"],[13,1,"いえ"],[15,1,"わず"],[26,1,"にく"],[28,1,"もの"],[30,1,"い"]],"text":"不正な利をむさぼる者はその家を煩らわせる、まいないを憎む者は生きながらえる。"},{"ref":"Prov.15.28","start":20015028,"end":20015028,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"こころ"],[7,1,"こた"],[15,1,"かんが"],[19,1,"あ"],[22,1,"もの"],[24,1,"くち"],[26,1,"あく"],[28,1,"は"],[30,1,"だ"]],"text":"正しい者の心は答えるべきことを考える、悪しき者の口は悪を吐き出す。"},{"ref":"Prov.15.29","start":20015029,"end":20015029,"break":"line","ruby":[[0,1,"しゅ"],[2,1,"あ"],[5,1,"もの"],[7,1,"とお"],[12,1,"ただ"],[15,1,"もの"],[17,1,"いのり"],[19,1,"き"]],"text":"主は悪しき者に遠ざかり、正しい者の祈を聞かれる。"},{"ref":"Prov.15.30","start":20015030,"end":20015030,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"め"],[2,1,"ひかり"],[4,1,"こころ"],[6,1,"よろこ"],[12,1,"し"],[16,1,"ほね"],[18,1,"うるお"]],"text":"目の光は心を喜ばせ、よい知らせは骨を潤す。"},{"ref":"Prov.15.31","start":20015031,"end":20015031,"break":"line","breaks":[[17,"line"]],"ruby":[[5,1,"いまし"],[8,1,"き"],[10,1,"みみ"],[14,1,"もの"],[17,2,"ちえ"],[21,1,"もの"],[23,1,"なか"]],"text":"ためになる戒めを聞く耳をもつ者は、知恵ある者の中にとどまる。"},{"ref":"Prov.15.32","start":20015032,"end":20015032,"break":"line","breaks":[[18,"line"]],"ruby":[[0,2,"きょうくん"],[3,1,"す"],[6,1,"もの"],[12,1,"いのち"],[14,1,"かろ"],[18,1,"いまし"],[21,1,"おも"],[25,1,"もの"],[27,1,"さと"],[30,1,"え"]],"text":"教訓を捨てる者はおのれの命を軽んじ、戒めを重んじる者は悟りを得る。"},{"ref":"Prov.15.33","start":20015033,"end":20015033,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[8,2,"ちえ"],[11,2,"きょうくん"],[17,2,"けんそん"],[21,2,"えいよ"],[24,1,"さき"]],"text":"主を恐れることは知恵の教訓である、謙遜は、栄誉に先だつ。"}]