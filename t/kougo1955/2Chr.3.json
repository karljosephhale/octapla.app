[{"ref":"2Chr.3.1","start":14003001,"end":14003001,"break":"paragraph","ruby":[[15,1,"やま"],[17,1,"しゅ"],[19,1,"みや"],[21,1,"た"],[27,1,"はじ"],[34,1,"ちち"],[39,1,"しゅ"],[41,1,"あらわ"],[46,1,"ところ"],[62,1,"う"],[64,1,"ば"],[70,1,"そな"],[73,1,"ところ"]],"text":"ソロモンはエルサレムのモリアの山に主の宮を建てることを始めた。そこは父ダビデに主が現れられた所、すなわちエブスびとオルナンの打ち場にダビデが備えた所である。"},{"ref":"2Chr.3.2","start":14003002,"end":14003002,"break":"none","ruby":[[5,1,"みや"],[7,1,"た"],[9,1,"はじ"],[17,2,"ちせい"],[21,1,"ねん"],[24,1,"がつ"]],"text":"ソロモンが宮を建て始めたのは、その治世の四年の二月であった。"},{"ref":"2Chr.3.3","start":14003003,"end":14003003,"break":"none","ruby":[[5,1,"た"],[8,1,"かみ"],[10,1,"みや"],[12,1,"もとい"],[14,2,"すんぽう"],[17,1,"つぎ"],[30,1,"むかし"],[32,2,"しゃくど"],[38,1,"なが"],[47,1,"はば"]],"text":"ソロモンの建てた神の宮の基の寸法は次のとおりである。すなわち昔の尺度によれば長さ六十キュビト、幅二十キュビト、"},{"ref":"2Chr.3.4","start":14003004,"end":14003004,"break":"none","ruby":[[0,1,"みや"],[2,1,"まえ"],[4,1,"ろう"],[6,1,"みや"],[8,1,"はば"],[10,1,"したが"],[13,1,"なが"],[21,1,"たか"],[34,2,"ないぶ"],[37,2,"じゅんきん"]],"text":"宮の前の廊は宮の幅に従って長さ二十キュビト高さ百二十キュビトで、その内部は純金でおおった。"},{"ref":"2Chr.3.5","start":14003005,"end":14003005,"break":"none","ruby":[[4,2,"はいでん"],[12,1,"いた"],[14,1,"は"],[17,1,"せい"],[18,1,"きん"],[32,1,"うえ"],[38,1,"くさり"],[40,1,"かたち"],[42,1,"ほどこ"]],"text":"またその拝殿はいとすぎの板で張り、精金をもってこれをおおい、その上にしゅろと鎖の形を施した。"},{"ref":"2Chr.3.6","start":14003006,"end":14003006,"break":"none","ruby":[[2,2,"ほうせき"],[7,1,"こ"],[10,1,"みや"],[12,1,"かざ"],[18,1,"きん"],[26,1,"きん"]],"text":"また宝石をはめ込んで宮を飾った。その金はパルワイムの金であった。"},{"ref":"2Chr.3.7","start":14003007,"end":14003007,"break":"none","ruby":[[0,1,"かれ"],[4,1,"きん"],[11,1,"みや"],[18,1,"はり"],[20,2,"しきい"],[23,1,"かべ"],[27,1,"と"],[33,1,"かべ"],[35,1,"うえ"],[42,1,"ほ"]],"text":"彼はまた金をもってその宮、すなわち、梁、敷居、壁および戸をおおい、壁の上にケルビムを彫りつけた。"},{"ref":"2Chr.3.8","start":14003008,"end":14003008,"break":"none","ruby":[[0,1,"かれ"],[4,3,"しせいじょ"],[8,1,"つく"],[14,1,"なが"],[17,1,"みや"],[19,1,"なが"],[34,1,"はば"],[46,1,"かれ"],[48,1,"せい"],[49,1,"きん"]],"text":"彼はまた至聖所を造った。その長さは宮の長さにしたがって二十キュビト、幅も二十キュビトである。彼は精金六百タラントをもってこれをおおった。"},{"ref":"2Chr.3.9","start":14003009,"end":14003009,"break":"none","ruby":[[2,1,"くぎ"],[4,1,"きん"],[6,1,"おも"],[19,1,"かれ"],[23,2,"かいじょう"],[26,1,"しつ"],[28,1,"きん"]],"text":"その釘の金の重さは五十シケルであった。彼はまた階上の室も金でおおった。"},{"ref":"2Chr.3.10","start":14003010,"end":14003010,"break":"paragraph","ruby":[[0,1,"かれ"],[2,3,"しせいじょ"],[6,1,"き"],[8,1,"きざ"],[16,1,"ぞう"],[20,1,"つく"],[26,1,"きん"]],"text":"彼は至聖所に木を刻んだケルビムの像を二つ造り、これを金でおおった。"},{"ref":"2Chr.3.11","start":14003011,"end":14003011,"break":"none","ruby":[[5,1,"つばさ"],[7,1,"なが"],[10,1,"あ"],[38,1,"つばさ"],[47,1,"みや"],[49,1,"かべ"],[51,1,"とど"],[57,1,"つばさ"],[66,1,"た"],[72,1,"つばさ"],[74,1,"とど"]],"text":"ケルビムの翼の長さは合わせて二十キュビトあった。すなわち一つのケルブの一つの翼は五キュビトで、宮の壁に届き、ほかの翼も五キュビトで、他のケルブの翼に届き、"},{"ref":"2Chr.3.12","start":14003012,"end":14003012,"break":"none","ruby":[[0,1,"た"],[9,1,"つばさ"],[18,1,"みや"],[20,1,"かべ"],[22,1,"とど"],[28,1,"つばさ"],[37,1,"さき"],[43,1,"つばさ"],[45,1,"せっ"]],"text":"他のケルブの一つの翼も五キュビトで、宮の壁に届き、ほかの翼も五キュビトで、先のケルブの翼に接していた。"},{"ref":"2Chr.3.13","start":14003013,"end":14003013,"break":"none","ruby":[[9,1,"つばさ"],[11,1,"ひろ"],[29,1,"とも"],[31,1,"あし"],[33,1,"た"],[38,1,"かお"],[40,2,"はいでん"],[43,1,"む"]],"text":"これらのケルビムの翼は広げると二十キュビトあった。かれらは共に足で立ち、その顔は拝殿に向かっていた。"},{"ref":"2Chr.3.14","start":14003014,"end":14003014,"break":"none","ruby":[[7,1,"あお"],[8,1,"いと"],[10,1,"むらさき"],[11,1,"いと"],[13,1,"ひ"],[14,1,"いと"],[18,2,"あま"],[20,1,"いと"],[22,2,"たれまく"],[25,1,"つく"],[30,1,"うえ"],[37,1,"ぬ"],[39,1,"と"],[42,1,"ほどこ"]],"text":"ソロモンはまた青糸、紫糸、緋糸および亜麻糸で垂幕を造り、その上にケルビムの縫い取りを施した。"},{"ref":"2Chr.3.15","start":14003015,"end":14003015,"break":"paragraph","ruby":[[0,1,"かれ"],[2,1,"みや"],[4,1,"まえ"],[6,1,"はしら"],[9,1,"ほん"],[10,1,"つく"],[16,1,"たか"],[32,1,"はしら"],[34,1,"いただき"],[42,2,"ちゅうとう"],[45,1,"つく"]],"text":"彼は宮の前に柱を二本造った。その高さは三十五キュビト、おのおのの柱の頂に五キュビトの柱頭を造った。"},{"ref":"2Chr.3.16","start":14003016,"end":14003016,"break":"none","ruby":[[0,1,"かれ"],[2,1,"くび"],[3,1,"かざり"],[8,1,"くさり"],[10,1,"つく"],[14,1,"はしら"],[16,1,"いただき"],[26,1,"つく"],[31,1,"くさり"],[33,1,"うえ"]],"text":"彼は首飾のような鎖を造って、柱の頂につけ、ざくろ百を造ってその鎖の上につけた。"},{"ref":"2Chr.3.17","start":14003017,"end":14003017,"break":"none","ruby":[[0,1,"かれ"],[4,1,"はしら"],[6,2,"しんでん"],[9,1,"まえ"],[13,1,"ぽん"],[15,1,"みなみ"],[17,1,"ほう"],[21,1,"ぽん"],[23,1,"きた"],[25,1,"ほう"],[27,1,"た"],[30,1,"みなみ"],[32,1,"ほう"],[39,1,"な"],[43,1,"きた"],[45,1,"ほう"],[52,1,"な"]],"text":"彼はこの柱を神殿の前に、一本を南の方に、一本を北の方に立て、南の方のをヤキンと名づけ、北の方のをボアズと名づけた。"}]