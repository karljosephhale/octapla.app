[{"ref":"Isa.57.1","start":23057001,"end":23057001,"break":"paragraph","breaks":[[10,"line"],[20,"line"],[42,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"ほろ"],[10,1,"こころ"],[15,1,"ひと"],[20,1,"かみ"],[22,1,"うやま"],[24,2,"ひとびと"],[27,1,"と"],[29,1,"さ"],[35,1,"さと"],[37,1,"もの"],[42,1,"ただ"],[45,1,"もの"],[47,1,"わざわい"],[49,1,"まえ"],[51,1,"と"],[53,1,"さ"]],"text":"正しい者が滅びても、心にとめる人がなく、神を敬う人々が取り去られても、悟る者はない。正しい者は災の前に取り去られて、"},{"ref":"Isa.57.2","start":23057002,"end":23057002,"break":"line","breaks":[[11,"line"]],"ruby":[[0,2,"へいあん"],[3,1,"い"],[14,2,"しょうじき"],[17,1,"あゆ"],[19,1,"もの"],[24,1,"とこ"],[26,1,"やす"]],"text":"平安に入るからである。すべて正直に歩む者は、その床に休むことができる。"},{"ref":"Isa.57.3","start":23057003,"end":23057003,"break":"line","breaks":[[17,"line"]],"ruby":[[9,1,"おんな"],[10,3,"まほうつかい"],[14,1,"こ"],[17,2,"かんぷ"],[20,2,"ゆうじょ"],[31,2,"ちかよ"]],"text":"しかし、あなたがた女魔法使の子よ、姦夫と遊女のすえよ、こちらへ近寄れ。"},{"ref":"Isa.57.4","start":23057004,"end":23057004,"break":"line","breaks":[[22,"line"],[41,"line"],[53,"line"]],"ruby":[[14,1,"たわむ"],[29,1,"くち"],[31,1,"ひら"],[34,1,"した"],[36,1,"だ"],[47,2,"はいしん"],[50,1,"こ"],[53,1,"いつわ"]],"text":"あなたがたは、だれにむかって戯れをなすのか。だれにむかって口を開き、舌を出すのか。あなたがたは背信の子ら、偽りのすえではないか。"},{"ref":"Isa.57.5","start":23057005,"end":23057005,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[10,1,"き"],[12,1,"あいだ"],[18,1,"あお"],[19,1,"き"],[21,1,"した"],[23,1,"こころ"],[29,1,"たに"],[31,1,"なか"],[33,1,"いわ"],[39,1,"こ"],[43,1,"ころ"]],"text":"あなたがたは、かしの木の間、すべての青木の下で心をこがし、谷の中、岩のはざまで子どもを殺した。"},{"ref":"Isa.57.6","start":23057006,"end":23057006,"break":"line","breaks":[[21,"line"],[33,"line"],[52,"line"]],"ruby":[[4,1,"たに"],[11,1,"いし"],[13,2,"じぶん"],[16,1,"し"],[17,1,"ぎょう"],[24,2,"じぶん"],[27,1,"わ"],[29,1,"まえ"],[36,2,"かんさい"],[43,1,"そな"],[45,1,"もの"],[60,1,"もの"]],"text":"あなたは谷のなめらかな石を自分の嗣業とし、これを自分の分け前とし、これに灌祭をそそぎ、供え物をささげた。わたしはこれらの物によってなだめられようか。"},{"ref":"Isa.57.7","start":23057007,"end":23057007,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"たか"],[10,1,"やま"],[12,1,"うえ"],[14,2,"じぶん"],[17,1,"とこ"],[19,1,"もう"],[27,1,"のぼ"],[30,1,"い"],[33,2,"ぎせい"]],"text":"あなたは高くそびえた山の上に自分の床を設け、またそこに登って行って犠牲をささげた。"},{"ref":"Isa.57.8","start":23057008,"end":23057008,"break":"line","breaks":[[13,"line"],[25,"line"],[46,"line"],[64,"line"],[83,"line"]],"ruby":[[2,1,"と"],[6,1,"はしら"],[21,1,"お"],[33,1,"はな"],[36,2,"じぶん"],[39,1,"とこ"],[56,1,"とこ"],[66,1,"かれ"],[69,2,"けいやく"],[75,1,"かれ"],[78,1,"とこ"],[80,1,"あい"],[85,1,"はだか"],[87,1,"み"]],"text":"また戸および柱のうしろに、あなたのしるしを置いた。あなたはわたしを離れて自分の床をあらわし、それにのぼって、その床をひろくした。また彼らと契約をなし、彼らの床を愛し、その裸を見た。"},{"ref":"Isa.57.9","start":23057009,"end":23057009,"break":"line","breaks":[[20,"line"],[33,"line"],[50,"line"]],"ruby":[[8,1,"あぶら"],[10,1,"たずさ"],[17,1,"い"],[20,1,"おお"],[26,1,"もの"],[39,2,"ししゃ"],[42,1,"とお"],[50,2,"よみ"],[53,1,"ふか"],[55,1,"ところ"]],"text":"あなたは、におい油を携えてモレクに行き、多くのかおり物をささげた。またあなたの使者を遠くにつかわし、陰府の深い所にまでつかわした。"},{"ref":"Isa.57.10","start":23057010,"end":23057010,"break":"line","breaks":[[15,"line"],[33,"line"],[50,"line"]],"ruby":[[4,1,"みち"],[6,1,"なが"],[10,1,"つか"],[18,1,"のぞ"],[26,1,"い"],[40,1,"ちから"],[42,2,"かいふく"],[45,1,"え"],[50,1,"おとろ"]],"text":"あなたは道の長いのに疲れても、なお「望みがない」とは言わなかった。あなたはおのが力の回復を得たので、衰えることがなかった。"},{"ref":"Isa.57.11","start":23057011,"end":23057011,"break":"line","breaks":[[19,"line"],[40,"line"],[56,"line"]],"ruby":[[9,1,"おそ"],[13,1,"いつわ"],[16,1,"い"],[23,1,"おぼ"],[29,1,"こころ"],[44,1,"ひさ"],[47,1,"だま"],[64,1,"おそ"]],"text":"あなたはだれをおじ恐れて、偽りを言い、わたしを覚えず、また心におかなかったのか。わたしが久しく黙っていたために、あなたはわたしを恐れなかったのではなかったか。"},{"ref":"Isa.57.12","start":23057012,"end":23057012,"break":"line","breaks":[[24,"line"]],"ruby":[[8,1,"ぎ"],[18,1,"つ"],[20,1,"しめ"],[35,1,"えき"]],"text":"わたしはあなたの義と、あなたのわざを告げ示そう、しかしこれらはあなたを益しない。"},{"ref":"Isa.57.13","start":23057013,"end":23057013,"break":"line","breaks":[[10,"line"],[32,"line"],[42,"line"],[52,"line"],[70,"line"]],"ruby":[[4,1,"よ"],[8,1,"とき"],[14,1,"あつ"],[20,2,"ぐうぞう"],[27,1,"すく"],[32,1,"かぜ"],[34,1,"かれ"],[37,1,"はこ"],[39,1,"さ"],[42,1,"いき"],[44,1,"かれ"],[47,1,"と"],[49,1,"さ"],[59,1,"よ"],[61,1,"たの"],[63,1,"もの"],[65,1,"ち"],[67,1,"つ"],[72,1,"せい"],[75,1,"やま"]],"text":"あなたが呼ばわる時、あなたが集めておいた偶像にあなたを救わせよ。風は彼らを運び去り、息は彼らを取り去る。しかしわたしに寄り頼む者は地を継ぎ、わが聖なる山をまもる。"},{"ref":"Isa.57.14","start":23057014,"end":23057014,"break":"paragraph","breaks":[[7,"line"],[24,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"つち"],[10,1,"も"],[13,1,"つち"],[15,1,"も"],[18,1,"みち"],[20,1,"そな"],[26,1,"たみ"],[28,1,"みち"],[36,1,"もの"],[38,1,"と"],[40,1,"さ"]],"text":"主は言われる、「土を盛り、土を盛って道を備えよ、わが民の道から、つまずく物を取り去れ」と。"},{"ref":"Isa.57.15","start":23057015,"end":23057015,"break":"line","breaks":[[21,"line"],[42,"line"],[58,"line"],[77,"line"],[90,"line"]],"ruby":[[2,1,"たか"],[7,1,"うえ"],[10,1,"もの"],[17,1,"す"],[19,1,"もの"],[23,1,"な"],[25,1,"せい"],[33,1,"もの"],[37,1,"い"],[47,1,"たか"],[50,1,"せい"],[53,1,"ところ"],[55,1,"す"],[60,1,"こころ"],[61,1,"くだ"],[70,1,"もの"],[72,1,"とも"],[74,1,"す"],[82,1,"もの"],[84,1,"れい"],[90,1,"くだ"],[93,1,"もの"],[95,1,"こころ"]],"text":"いと高く、いと上なる者、とこしえに住む者、その名を聖ととなえられる者がこう言われる、「わたしは高く、聖なる所に住み、また心砕けて、へりくだる者と共に住み、へりくだる者の霊をいかし、砕ける者の心をいかす。"},{"ref":"Isa.57.16","start":23057016,"end":23057016,"break":"line","breaks":[[14,"line"],[24,"line"],[33,"line"]],"ruby":[[9,1,"あらそ"],[16,1,"た"],[19,1,"いか"],[24,1,"れい"],[31,1,"で"],[37,1,"いき"]],"text":"わたしはかぎりなく争わない、また絶えず怒らない。霊はわたしから出、いのちの息はわたしがつくったからだ。"},{"ref":"Isa.57.17","start":23057017,"end":23057017,"break":"line","breaks":[[13,"line"],[25,"line"],[37,"line"]],"ruby":[[0,1,"かれ"],[7,1,"つみ"],[17,1,"いか"],[20,1,"かれ"],[22,1,"う"],[27,1,"かお"],[33,1,"いか"],[40,1,"かれ"],[52,1,"こころ"],[54,1,"みち"],[56,1,"い"]],"text":"彼のむさぼりの罪のゆえに、わたしは怒って彼を打ち、わが顔をかくして怒った。しかし彼はなおそむいて、おのが心の道へ行った。"},{"ref":"Isa.57.18","start":23057018,"end":23057018,"break":"line","breaks":[[11,"line"],[21,"line"],[39,"line"]],"ruby":[[4,1,"かれ"],[6,1,"みち"],[8,1,"み"],[15,1,"かれ"],[23,1,"かれ"],[25,1,"みちび"],[28,1,"なぐさ"],[34,1,"かれ"],[36,1,"むく"],[39,1,"かな"],[43,1,"もの"],[54,1,"み"],[56,1,"つく"]],"text":"わたしは彼の道を見た。わたしは彼をいやし、また彼を導き、慰めをもって彼に報い、悲しめる者のために、くちびるの実を造ろう。"},{"ref":"Isa.57.19","start":23057019,"end":23057019,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"とお"],[2,1,"もの"],[5,1,"ちか"],[7,1,"もの"],[10,2,"へいあん"],[15,2,"へいあん"],[24,1,"かれ"],[32,1,"しゅ"],[34,1,"い"]],"text":"遠い者にも近い者にも平安あれ、平安あれ、わたしは彼をいやそう」と主は言われる。"},{"ref":"Isa.57.20","start":23057020,"end":23057020,"break":"line","breaks":[[18,"line"],[30,"line"]],"ruby":[[3,1,"あ"],[6,1,"もの"],[8,1,"なみ"],[10,1,"あら"],[12,1,"うみ"],[18,1,"しず"],[32,1,"みず"],[37,1,"どろ"],[39,2,"おぶつ"],[43,1,"だ"]],"text":"しかし悪しき者は波の荒い海のようだ。静まることができないで、その水はついに泥と汚物とを出す。"},{"ref":"Isa.57.21","start":23057021,"end":23057021,"break":"line","breaks":[[9,"line"]],"ruby":[[2,1,"かみ"],[4,1,"い"],[15,1,"もの"],[18,2,"へいあん"]],"text":"わが神は言われる、「よこしまな者には平安がない」と。"}]