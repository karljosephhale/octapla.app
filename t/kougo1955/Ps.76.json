[{"ref":"Ps.76.1","start":19076001,"end":19076001,"break":"paragraph","title":"聖歌隊の指揮者によって琴にあわせてうたわせたアサフの歌、さんび","breaks":[[9,"line"]],"ruby":[[0,1,"かみ"],[5,1,"し"],[12,1,"な"],[23,2,"いだい"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[11,1,"こと"],[26,1,"うた"]],"text":"神はユダに知られ、そのみ名はイスラエルにおいて偉大である。"},{"ref":"Ps.76.2","start":19076002,"end":19076002,"break":"line","breaks":[[12,"line"]],"ruby":[[2,2,"まくや"]],"text":"その幕屋はサレムにあり、そのすまいはシオンにある。"},{"ref":"Ps.76.3","start":19076003,"end":19076003,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"かみ"],[6,1,"ゆみ"],[8,2,"ひや"],[11,1,"お"],[14,1,"たて"],[20,1,"たたか"],[23,2,"ぶき"]],"text":"かしこで神は弓の火矢を折り、盾とつるぎと戦いの武器をこわされた。〔セラ"},{"ref":"Ps.76.4","start":19076004,"end":19076004,"break":"line","breaks":[[14,"line"]],"ruby":[[4,2,"えいきゅう"],[7,2,"やまやま"],[14,2,"こうえい"],[19,2,"いげん"]],"text":"あなたは永久の山々にまさって光栄あり、威厳がある。"},{"ref":"Ps.76.5","start":19076005,"end":19076005,"break":"line","breaks":[[21,"line"]],"ruby":[[0,2,"おお"],[4,1,"もの"],[12,1,"かれ"],[15,1,"ねむ"],[18,1,"しず"],[27,1,"みな"],[30,1,"て"],[32,1,"ほどこ"]],"text":"雄々しい者はかすめられ、彼らは眠りに沈み、いくさびとは皆その手を施すことができなかった。"},{"ref":"Ps.76.6","start":19076006,"end":19076006,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"かみ"],[19,1,"の"],[21,1,"て"],[23,1,"うま"],[26,1,"ふか"],[28,1,"ねむ"],[31,1,"おちい"]],"text":"ヤコブの神よ、あなたのとがめによって、乗り手と馬とは深い眠りに陥った。"},{"ref":"Ps.76.7","start":19076007,"end":19076007,"break":"line","breaks":[[19,"line"],[34,"line"]],"ruby":[[10,1,"おそ"],[14,1,"かた"],[23,1,"いか"],[26,1,"はっ"],[38,1,"まえ"],[40,1,"た"]],"text":"しかし、あなたこそは恐るべき方である。あなたが怒りを発せられるとき、だれがみ前に立つことができよう。"},{"ref":"Ps.76.8","start":19076008,"end":19076009,"break":"line","breaks":[[17,"line"],[36,"line"]],"ruby":[[4,1,"てん"],[11,1,"おお"],[17,1,"かみ"],[19,1,"ち"],[28,1,"もの"],[30,1,"すく"],[40,1,"た"],[47,1,"ち"],[49,1,"おそ"],[53,2,"ちんもく"]],"text":"あなたは天からさばきを仰せられた。神が地のしえたげられた者を救うために、さばきに立たれたとき、地は恐れて、沈黙した。〔セラ"},{"ref":"Ps.76.10","start":19076010,"end":19076010,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"ひと"],[6,1,"いか"],[20,1,"いか"],[23,1,"あま"],[30,1,"おび"]],"text":"まことに人の怒りはあなたをほめたたえる。怒りの余りをあなたは帯とされる。"},{"ref":"Ps.76.11","start":19076011,"end":19076011,"break":"line","breaks":[[23,"line"],[34,"line"]],"ruby":[[6,1,"かみ"],[8,1,"しゅ"],[10,1,"ちか"],[13,1,"た"],[20,1,"つぐな"],[25,2,"しゅうい"],[32,1,"もの"],[34,1,"おそ"],[38,1,"しゅ"],[40,1,"おく"],[42,1,"もの"]],"text":"あなたがたの神、主に誓いを立てて、それを償え。その周囲のすべての者は恐るべき主に贈り物をささげよ。"},{"ref":"Ps.76.12","start":19076012,"end":19076012,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"きみ"],[15,1,"た"],[20,1,"しゅ"],[22,1,"ち"],[24,1,"おう"],[28,1,"おそ"],[32,1,"もの"]],"text":"主はもろもろの君たちのいのちを断たれる。主は地の王たちの恐るべき者である。"}]