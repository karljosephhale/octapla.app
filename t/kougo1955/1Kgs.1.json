[{"ref":"1Kgs.1.1","start":11001001,"end":11001001,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"とし"],[11,1,"お"],[14,2,"よぎ"],[17,1,"き"],[21,1,"あたた"]],"text":"ダビデ王は年がすすんで老い、夜着を着せても暖まらなかったので、"},{"ref":"1Kgs.1.2","start":11001002,"end":11001002,"break":"none","ruby":[[2,2,"けらい"],[7,1,"かれ"],[9,1,"い"],[14,1,"おう"],[17,1,"しゅ"],[27,1,"わか"],[33,1,"さが"],[35,1,"もと"],[38,1,"おう"],[45,1,"おう"],[47,2,"つきそ"],[62,1,"ね"],[65,1,"おう"],[68,1,"しゅ"],[70,1,"あたた"]],"text":"その家来たちは彼に言った、「王わが主のために、ひとりの若いおとめを捜し求めて王にはべらせ、王の付添いとし、あなたのふところに寝て、王わが主を暖めさせましょう」。"},{"ref":"1Kgs.1.3","start":11001003,"end":11001003,"break":"none","ruby":[[3,1,"かれ"],[16,2,"りょうど"],[19,1,"うつく"],[26,1,"さが"],[28,1,"もと"],[44,1,"え"],[46,1,"おう"],[51,1,"つ"]],"text":"そして彼らはあまねくイスラエルの領土に美しいおとめを捜し求めて、シュナミびとアビシャグを得、王のもとに連れてきた。"},{"ref":"1Kgs.1.4","start":11001004,"end":11001004,"break":"none","ruby":[[4,2,"ひじょう"],[7,1,"うつく"],[11,1,"おう"],[13,2,"つきそ"],[20,1,"おう"],[22,1,"つか"],[27,1,"おう"],[29,2,"かのじょ"],[32,1,"し"]],"text":"おとめは非常に美しく、王の付添いとなって王に仕えたが、王は彼女を知ることがなかった。"},{"ref":"1Kgs.1.5","start":11001005,"end":11001005,"break":"paragraph","ruby":[[6,1,"こ"],[12,1,"たか"],[22,1,"おう"],[29,1,"い"],[32,2,"じぶん"],[38,2,"せんしゃ"],[41,2,"きへい"],[46,2,"じぶん"],[49,1,"まえ"],[51,1,"か"],[54,1,"もの"],[57,1,"にん"],[59,1,"そな"]],"text":"さてハギテの子アドニヤは高ぶって、「わたしは王となろう」と言い、自分のために戦車と騎兵および自分の前に駆ける者五十人を備えた。"},{"ref":"1Kgs.1.6","start":11001006,"end":11001006,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ちち"],[4,1,"かれ"],[6,1,"うま"],[14,1,"ど"],[25,1,"こと"],[33,1,"い"],[36,1,"かれ"],[58,2,"ひじょう"],[61,1,"すがた"],[63,1,"よ"],[65,1,"ひと"],[77,1,"つぎ"],[79,1,"うま"],[82,1,"もの"]],"text":"彼の父は彼が生れてこのかた一度も「なぜ、そのような事をするのか」と言って彼をたしなめたことがなかった。アドニヤもまた非常に姿の良い人であって、アブサロムの次に生れた者である。"},{"ref":"1Kgs.1.7","start":11001007,"end":11001007,"break":"none","ruby":[[0,1,"かれ"],[6,1,"こ"],[11,2,"さいし"],[20,2,"そうだん"],[27,1,"かれ"],[35,1,"したが"],[38,1,"かれ"],[40,1,"たす"]],"text":"彼がゼルヤの子ヨアブと祭司アビヤタルとに相談したので、彼らはアドニヤに従って彼を助けた。"},{"ref":"1Kgs.1.8","start":11001008,"end":11001008,"break":"none","ruby":[[3,2,"さいし"],[15,1,"こ"],[21,3,"よげんしゃ"],[45,2,"ゆうし"],[55,1,"したが"]],"text":"しかし祭司ザドクと、エホヤダの子ベナヤと、預言者ナタンおよびシメイとレイ、ならびにダビデの勇士たちはアドニヤに従わなかった。"},{"ref":"1Kgs.1.9","start":11001009,"end":11001009,"break":"paragraph","ruby":[[21,1,"いし"],[30,1,"ひつじ"],[32,1,"うし"],[34,1,"こ"],[37,2,"かちく"],[45,1,"おう"],[47,1,"こ"],[51,2,"じぶん"],[54,2,"きょうだい"],[62,1,"おう"],[64,2,"けらい"],[72,2,"ひとびと"],[80,1,"まね"]],"text":"アドニヤはエンロゲルのほとりにある「へびの石」のかたわらで、羊と牛と肥えた家畜をほふって、王の子である自分の兄弟たち、および王の家来であるユダの人々をことごとく招いた。"},{"ref":"1Kgs.1.10","start":11001010,"end":11001010,"break":"none","ruby":[[3,3,"よげんしゃ"],[16,2,"ゆうし"],[22,2,"じぶん"],[25,2,"きょうだい"],[33,1,"まね"]],"text":"しかし預言者ナタンと、ベナヤと、勇士たちと、自分の兄弟ソロモンとは招かなかった。"},{"ref":"1Kgs.1.11","start":11001011,"end":11001011,"break":"paragraph","ruby":[[0,1,"とき"],[11,1,"はは"],[17,1,"い"],[26,1,"こ"],[32,1,"おう"],[40,1,"き"],[58,1,"しゅ"]],"text":"時にナタンはソロモンの母バテシバに言った、「ハギテの子アドニヤが王となったのをお聞きになりませんでしたか。われわれの主ダビデはそれをごぞんじないのです。"},{"ref":"1Kgs.1.12","start":11001012,"end":11001012,"break":"none","ruby":[[10,1,"はか"],[15,1,"さづ"],[23,1,"いのち"],[30,1,"こ"],[36,1,"いのち"],[38,1,"すく"]],"text":"それでいま、あなたに計りごとを授けて、あなたの命と、あなたの子ソロモンの命を救うようにいたしましょう。"},{"ref":"1Kgs.1.13","start":11001013,"end":11001013,"break":"none","ruby":[[9,1,"おう"],[15,1,"い"],[20,1,"おう"],[23,1,"しゅ"],[36,1,"ちか"],[44,1,"こ"],[55,1,"つ"],[58,1,"おう"],[67,1,"くらい"],[69,1,"ざ"],[77,1,"い"],[107,1,"おう"],[118,1,"い"]],"text":"あなたはすぐダビデ王のところへ行って、『王わが主よ、あなたは、はしために誓って、おまえの子ソロモンが、わたしに次いで王となり、わたしの位に座するであろうと言われたではありませんか。そうであるのに、どうしてアドニヤが王となったのですか』と言いなさい。"},{"ref":"1Kgs.1.14","start":11001014,"end":11001014,"break":"none","ruby":[[6,1,"おう"],[8,1,"はな"],[15,1,"あいだ"],[38,1,"い"],[46,2,"ことば"],[49,2,"かくにん"]],"text":"あなたがなお王と話しておられる間に、わたしもまた、あなたのあとから、はいって行って、あなたの言葉を確認しましょう」。"},{"ref":"1Kgs.1.15","start":11001015,"end":11001015,"break":"paragraph","ruby":[[8,2,"しんしつ"],[15,1,"おう"],[17,1,"ところ"],[19,1,"い"],[24,1,"おう"],[26,2,"ひじょう"],[29,1,"お"],[45,1,"おう"],[47,1,"つか"]],"text":"そこでバテシバは寝室にはいって王の所へ行った。（王は非常に老いて、シュナミびとアビシャグが王に仕えていた）。"},{"ref":"1Kgs.1.16","start":11001016,"end":11001016,"break":"none","ruby":[[5,1,"み"],[11,1,"おう"],[13,1,"はい"],[17,1,"おう"],[19,1,"い"],[24,1,"なに"],[26,1,"よう"]],"text":"バテシバは身をかがめて王を拝した。王は言った、「何の用か」。"},{"ref":"1Kgs.1.17","start":11001017,"end":11001017,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"おう"],[5,1,"い"],[12,1,"しゅ"],[24,1,"かみ"],[26,1,"しゅ"],[37,1,"ちか"],[45,1,"こ"],[55,1,"つ"],[58,1,"おう"],[67,1,"くらい"],[69,1,"ざ"],[78,1,"い"]],"text":"彼女は王に言った、「わが主よ、あなたは、あなたの神、主をさして、はしために誓い、『おまえの子ソロモンがわたしに次いで王となり、わたしの位に座するであろう』と言われました。"},{"ref":"1Kgs.1.18","start":11001018,"end":11001018,"break":"none","ruby":[[15,1,"いま"],[21,1,"おう"],[29,1,"おう"],[32,1,"しゅ"]],"text":"そうであるのに、ごらんなさい、今アドニヤが王となりました。王わが主よ、あなたはそれをごぞんじないのです。"},{"ref":"1Kgs.1.19","start":11001019,"end":11001019,"break":"none","ruby":[[0,1,"かれ"],[2,1,"うし"],[4,1,"こ"],[7,2,"かちく"],[10,1,"ひつじ"],[21,1,"おう"],[23,1,"こ"],[30,2,"さいし"],[39,1,"ぐん"],[41,1,"ちょう"],[46,1,"まね"],[65,1,"まね"]],"text":"彼は牛と肥えた家畜と羊をたくさんほふって、王の子たち、および祭司アビヤタルと、軍の長ヨアブを招きましたが、あなたのしもべソロモンは招きませんでした。"},{"ref":"1Kgs.1.20","start":11001020,"end":11001020,"break":"none","ruby":[[0,1,"おう"],[3,1,"しゅ"],[16,1,"め"],[22,1,"そそ"],[33,1,"つ"],[37,1,"おう"],[40,1,"しゅ"],[42,1,"くらい"],[44,1,"ざ"],[50,1,"つ"],[57,1,"のぞ"]],"text":"王わが主よ、イスラエルのすべての目はあなたに注がれ、だれがあなたに次いで、王わが主の位に座すべきかを告げられるのを望んでいます。"},{"ref":"1Kgs.1.21","start":11001021,"end":11001021,"break":"none","ruby":[[0,1,"おう"],[3,1,"しゅ"],[5,2,"せんぞ"],[8,1,"とも"],[10,1,"ねむ"],[26,1,"こ"],[32,2,"むほん"],[34,1,"ひと"]],"text":"王わが主が先祖と共に眠られるとき、わたしと、わたしの子ソロモンは謀叛人とみなされるでしょう」。"},{"ref":"1Kgs.1.22","start":11001022,"end":11001022,"break":"paragraph","ruby":[[7,1,"おう"],[9,1,"はな"],[18,3,"よげんしゃ"]],"text":"バテシバがなお王と話しているうちに、預言者ナタンがはいってきた。"},{"ref":"1Kgs.1.23","start":11001023,"end":11001023,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"おう"],[5,1,"つ"],[10,3,"よげんしゃ"],[26,1,"い"],[30,1,"かれ"],[32,1,"おう"],[34,1,"まえ"],[40,1,"ち"],[42,1,"ふ"],[45,1,"おう"],[47,1,"はい"]],"text":"人々は王に告げて、「預言者ナタンがここにおります」と言った。彼は王の前にはいり、地に伏して王を拝した。"},{"ref":"1Kgs.1.24","start":11001024,"end":11001024,"break":"none","ruby":[[7,1,"い"],[12,1,"おう"],[15,1,"しゅ"],[33,1,"つ"],[36,1,"おう"],[45,1,"くらい"],[47,1,"ざ"],[56,1,"おお"]],"text":"そしてナタンは言った、「王わが主よ、あなたは、『アドニヤがわたしに次いで王となり、わたしの位に座するであろう』と仰せられましたか。"},{"ref":"1Kgs.1.25","start":11001025,"end":11001025,"break":"none","ruby":[[0,1,"かれ"],[5,1,"くだ"],[12,1,"うし"],[15,1,"こ"],[18,2,"かちく"],[21,1,"ひつじ"],[32,1,"おう"],[34,1,"こ"],[39,1,"ぐん"],[41,1,"ちょう"],[47,2,"さいし"],[55,1,"まね"],[61,1,"かれ"],[69,1,"まえ"],[71,1,"く"],[73,1,"の"],[83,2,"ばんざい"],[87,1,"い"]],"text":"彼はきょう下っていって、牛と、肥えた家畜と羊をたくさんほふって、王の子たちと、軍の長ヨアブと、祭司アビヤタルを招きました。彼らはアドニヤの前で食い飲みして、『アドニヤ万歳』と言いました。"},{"ref":"1Kgs.1.26","start":11001026,"end":11001026,"break":"none","ruby":[[19,2,"さいし"],[31,1,"こ"],[49,1,"まね"]],"text":"しかし、あなたのしもべであるわたしと、祭司ザドクと、エホヤダの子ベナヤと、あなたのしもべソロモンを招きませんでした。"},{"ref":"1Kgs.1.27","start":11001027,"end":11001027,"break":"none","ruby":[[2,1,"こと"],[4,1,"おう"],[7,1,"しゅ"],[14,1,"こと"],[37,1,"つ"],[40,1,"おう"],[43,1,"しゅ"],[45,1,"くらい"],[47,1,"ざ"],[53,1,"つ"]],"text":"この事は王わが主がさせられた事ですか。あなたはしもべたちに、だれがあなたに次いで王わが主の位に座すべきかを告げられませんでした」。"},{"ref":"1Kgs.1.28","start":11001028,"end":11001028,"break":"paragraph","ruby":[[3,1,"おう"],[5,1,"こた"],[8,1,"い"],[26,1,"よ"],[33,2,"かのじょ"],[36,1,"おう"],[38,1,"まえ"],[47,1,"おう"],[49,1,"まえ"],[51,1,"た"]],"text":"ダビデ王は答えて言った、「バテシバをわたしのところに呼びなさい」。彼女は王の前にはいってきて、王の前に立った。"},{"ref":"1Kgs.1.29","start":11001029,"end":11001029,"break":"none","ruby":[[3,1,"おう"],[5,1,"ちか"],[8,1,"い"],[17,1,"いのち"],[23,2,"くなん"],[27,1,"すく"],[31,1,"しゅ"],[33,1,"い"]],"text":"すると王は誓って言った、「わたしの命をすべての苦難から救われた主は生きておられる。"},{"ref":"1Kgs.1.30","start":11001030,"end":11001030,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[21,1,"ちか"],[29,1,"こ"],[39,1,"つ"],[42,1,"おう"],[51,1,"かわ"],[59,1,"くらい"],[61,1,"ざ"],[70,1,"い"]],"text":"わたしがイスラエルの神、主をさしてあなたに誓い、『あなたの子ソロモンがわたしに次いで王となり、わたしに代って、わたしの位に座するであろう』と言ったように、わたしはきょう、そのようにしよう」。"},{"ref":"1Kgs.1.31","start":11001031,"end":11001031,"break":"none","ruby":[[8,1,"み"],[14,1,"ち"],[16,1,"ふ"],[19,1,"おう"],[21,1,"はい"],[27,1,"しゅ"],[31,1,"おう"],[39,1,"い"],[54,1,"い"]],"text":"そこでバテシバは身をかがめ、地に伏して王を拝し、「わが主ダビデ王が、とこしえに生きながらえられますように」と言った。"},{"ref":"1Kgs.1.32","start":11001032,"end":11001032,"break":"paragraph","ruby":[[4,1,"い"],[9,2,"さいし"],[16,3,"よげんしゃ"],[30,1,"こ"],[39,1,"ところ"],[41,1,"よ"],[51,1,"かれ"],[54,1,"おう"],[56,1,"まえ"]],"text":"ダビデは言った、「祭司ザドクと、預言者ナタンおよびエホヤダの子ベナヤをわたしの所に呼びなさい」。やがて彼らは王の前にきた。"},{"ref":"1Kgs.1.33","start":11001033,"end":11001033,"break":"none","ruby":[[0,1,"おう"],[2,1,"かれ"],[5,1,"い"],[16,2,"しゅくん"],[19,2,"けらい"],[24,1,"つ"],[29,1,"こ"],[39,2,"らば"],[42,1,"の"],[45,1,"かれ"],[47,1,"みちび"],[54,1,"くだ"]],"text":"王は彼らに言った、「あなたがたの主君の家来たちを連れ、わが子ソロモンをわたしの騾馬に乗せ、彼を導いてギホンに下り、"},{"ref":"1Kgs.1.34","start":11001034,"end":11001034,"break":"none","ruby":[[2,1,"ところ"],[4,2,"さいし"],[10,3,"よげんしゃ"],[17,1,"かれ"],[19,1,"あぶら"],[21,1,"そそ"],[30,1,"おう"],[44,1,"ふ"],[53,1,"おう"],[54,2,"ばんざい"],[58,1,"い"]],"text":"その所で祭司ザドクと預言者ナタンは彼に油を注いでイスラエルの王としなさい。そしてラッパを吹いて、『ソロモン王万歳』と言いなさい。"},{"ref":"1Kgs.1.35","start":11001035,"end":11001035,"break":"none","ruby":[[11,1,"かれ"],[13,1,"したが"],[16,1,"のぼ"],[24,1,"かれ"],[33,1,"くらい"],[35,1,"ざ"],[42,1,"かわ"],[45,1,"おう"],[58,1,"かれ"],[60,1,"た"],[72,1,"うえ"],[74,2,"しゅくん"]],"text":"それから、あなたがたは彼に従って上ってきなさい。彼はきて、わたしの位に座し、わたしに代って王となるであろう。わたしは彼を立ててイスラエルとユダの上に主君とする」。"},{"ref":"1Kgs.1.36","start":11001036,"end":11001036,"break":"none","ruby":[[5,1,"こ"],[10,1,"おう"],[12,1,"こた"],[15,1,"い"],[25,1,"ねが"],[30,1,"おう"],[33,2,"しゅくん"],[36,1,"かみ"],[38,1,"しゅ"],[44,1,"おお"]],"text":"エホヤダの子ベナヤは王に答えて言った、「アァメン、願わくは、王わが主君の神、主もまたそう仰せられますように。"},{"ref":"1Kgs.1.37","start":11001037,"end":11001037,"break":"none","ruby":[[0,1,"ねが"],[5,1,"しゅ"],[7,1,"おう"],[10,2,"しゅくん"],[13,1,"とも"],[28,1,"とも"],[37,1,"くらい"],[41,2,"しゅくん"],[46,1,"おう"],[48,1,"くらい"],[52,1,"おお"]],"text":"願わくは、主が王わが主君と共におられたように、ソロモンと共におられて、その位をわが主君ダビデ王の位よりも大きくせられますように」。"},{"ref":"1Kgs.1.38","start":11001038,"end":11001038,"break":"paragraph","ruby":[[3,2,"さいし"],[9,3,"よげんしゃ"],[23,1,"こ"],[45,1,"くだ"],[48,1,"い"],[60,1,"おう"],[62,2,"らば"],[65,1,"の"],[68,1,"かれ"],[74,1,"みちび"],[77,1,"い"]],"text":"そこで祭司ザドクと預言者ナタンおよびエホヤダの子ベナヤ、ならびにケレテびとと、ペレテびとは下って行って、ソロモンをダビデ王の騾馬に乗せ、彼をギホンに導いて行った。"},{"ref":"1Kgs.1.39","start":11001039,"end":11001039,"break":"none","ruby":[[0,2,"さいし"],[6,2,"まくや"],[10,1,"あぶら"],[12,1,"つの"],[14,1,"と"],[25,1,"あぶら"],[27,1,"そそ"],[38,1,"ふ"],[40,1,"な"],[44,1,"たみ"],[46,1,"みな"],[52,1,"おう"],[53,2,"ばんざい"],[57,1,"い"]],"text":"祭司ザドクは幕屋から油の角を取ってきて、ソロモンに油を注いだ。そしてラッパを吹き鳴らし、民は皆「ソロモン王万歳」と言った。"},{"ref":"1Kgs.1.40","start":11001040,"end":11001040,"break":"none","ruby":[[0,1,"たみ"],[4,1,"かれ"],[6,1,"したが"],[9,1,"のぼ"],[12,1,"ふえ"],[14,1,"ふ"],[17,1,"おお"],[20,1,"よろこ"],[22,1,"いわ"],[26,1,"ち"],[28,1,"かれ"],[31,1,"こえ"],[33,1,"さ"]],"text":"民はみな彼に従って上り、笛を吹いて大いに喜び祝った。地は彼らの声で裂けるばかりであった。"},{"ref":"1Kgs.1.41","start":11001041,"end":11001041,"break":"paragraph","ruby":[[7,1,"かれ"],[9,1,"とも"],[13,1,"きゃく"],[17,1,"みな"],[18,2,"しょくじ"],[21,1,"おわ"],[30,1,"き"],[42,1,"おと"],[44,1,"き"],[47,1,"い"],[52,1,"まち"],[54,1,"なか"],[58,1,"さわ"],[61,1,"なに"]],"text":"アドニヤおよび彼と共にいた客たちは皆食事を終ったとき、これを聞いた。ヨアブはラッパの音を聞いて言った、「町の中のあの騒ぎは何か」。"},{"ref":"1Kgs.1.42","start":11001042,"end":11001042,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ことば"],[7,1,"おわ"],[18,2,"さいし"],[26,1,"こ"],[42,1,"かれ"],[44,1,"い"],[60,2,"ゆうかん"],[63,1,"ひと"],[68,1,"し"],[72,1,"も"]],"text":"彼の言葉のなお終らないうちに、そこへ祭司アビヤタルの子ヨナタンがきたので、アドニヤは彼に言った、「はいりなさい。あなたは勇敢な人で、よい知らせを持ってきたのでしょう」。"},{"ref":"1Kgs.1.43","start":11001043,"end":11001043,"break":"none","ruby":[[5,1,"こた"],[13,1,"い"],[22,2,"しゅくん"],[27,1,"おう"],[34,1,"おう"]],"text":"ヨナタンは答えてアドニヤに言った、「いいえ、主君ダビデ王はソロモンを王とせられました。"},{"ref":"1Kgs.1.44","start":11001044,"end":11001044,"break":"none","ruby":[[0,1,"おう"],[2,2,"さいし"],[8,3,"よげんしゃ"],[22,1,"こ"],[49,1,"とも"],[60,1,"かれ"],[68,1,"おう"],[70,2,"らば"],[73,1,"の"],[76,1,"い"]],"text":"王は祭司ザドクと預言者ナタンおよびエホヤダの子ベナヤ、ならびにケレテびとと、ペレテびとをソロモンと共につかわされたので、彼らはソロモンを王の騾馬に乗せて行き、"},{"ref":"1Kgs.1.45","start":11001045,"end":11001045,"break":"none","ruby":[[0,2,"さいし"],[6,3,"よげんしゃ"],[17,1,"かれ"],[19,1,"あぶら"],[21,1,"そそ"],[24,1,"おう"],[34,1,"かれ"],[41,1,"よろこ"],[44,1,"のぼ"],[47,1,"く"],[52,1,"まち"],[54,1,"さわ"],[66,1,"き"],[69,1,"こえ"]],"text":"祭司ザドクと預言者ナタンはギホンで彼に油を注いで王としました。そして彼らがそこから喜んで上って来るので、町が騒がしいのです。あなたが聞いた声はそれなのです。"},{"ref":"1Kgs.1.46","start":11001046,"end":11001046,"break":"none","ruby":[[9,1,"おう"],[11,1,"くらい"],[13,1,"ざ"]],"text":"こうしてソロモンは王の位に座し、"},{"ref":"1Kgs.1.47","start":11001047,"end":11001047,"break":"none","ruby":[[2,1,"おう"],[4,2,"けらい"],[12,2,"しゅくん"],[17,1,"おう"],[19,1,"いわ"],[22,1,"の"],[27,1,"ねが"],[36,1,"かみ"],[43,1,"な"],[49,1,"な"],[53,1,"たか"],[57,1,"かれ"],[59,1,"くらい"],[65,1,"くらい"],[69,1,"おお"],[81,1,"い"],[90,1,"おう"],[92,1,"ゆか"],[94,1,"うえ"],[96,1,"はい"]],"text":"かつ王の家来たちがきて、主君ダビデ王に祝いを述べて、『願わくは、あなたの神がソロモンの名をあなたの名よりも高くし、彼の位をあなたの位よりも大きくされますように』と言いました。そして王は床の上で拝されました。"},{"ref":"1Kgs.1.48","start":11001048,"end":11001048,"break":"none","ruby":[[0,1,"おう"],[6,1,"い"],[20,1,"かみ"],[22,1,"しゅ"],[31,1,"しゅ"],[41,1,"くらい"],[43,1,"ざ"],[50,1,"こ"],[52,1,"あた"],[63,1,"み"]],"text":"王はまたこう言われました、『イスラエルの神、主はほむべきかな。主はきょう、わたしの位に座するひとりの子を与えて、これをわたしに見せてくださった』と」。"},{"ref":"1Kgs.1.49","start":11001049,"end":11001049,"break":"paragraph","ruby":[[2,1,"とき"],[8,1,"とも"],[12,1,"きゃく"],[16,1,"おどろ"],[19,1,"た"],[26,2,"じぶん"],[29,1,"みち"],[31,1,"さ"],[34,1,"い"]],"text":"その時アドニヤと共にいた客はみな驚き、立っておのおの自分の道に去って行った。"},{"ref":"1Kgs.1.50","start":11001050,"end":11001050,"break":"none","ruby":[[13,1,"おそ"],[16,1,"た"],[19,1,"い"],[22,2,"さいだん"],[25,1,"つの"]],"text":"そしてアドニヤはソロモンを恐れ、立って行って祭壇の角をつかんだ。"},{"ref":"1Kgs.1.51","start":11001051,"end":11001051,"break":"none","ruby":[[2,1,"ひと"],[12,1,"つ"],[15,1,"い"],[30,1,"おそ"],[33,1,"いま"],[34,1,"かれ"],[36,2,"さいだん"],[39,1,"つの"],[55,1,"おう"],[72,1,"ころ"],[81,1,"ちか"],[93,1,"い"]],"text":"ある人がこれをソロモンに告げて言った、「アドニヤはソロモンを恐れ、今彼は祭壇の角をつかんで、『どうぞ、ソロモン王がきょう、つるぎをもってしもべを殺さないとわたしに誓ってくださるように』と言っています」。"},{"ref":"1Kgs.1.52","start":11001052,"end":11001052,"break":"none","ruby":[[5,1,"い"],[12,1,"かれ"],[16,1,"ひと"],[26,1,"かみ"],[28,1,"け"],[34,1,"ち"],[36,1,"お"],[50,1,"かれ"],[55,1,"あく"],[69,1,"かれ"],[71,1,"し"]],"text":"ソロモンは言った、「もし彼がよい人となるならば、その髪の毛ひとすじも地に落ちることはなかろう。しかし彼のうちに悪のあることがわかるならば、彼は死ななければならない」。"},{"ref":"1Kgs.1.53","start":11001053,"end":11001053,"break":"none","ruby":[[5,1,"ひと"],[12,1,"かれ"],[14,2,"さいだん"],[21,1,"くだ"],[26,1,"かれ"],[35,1,"はい"],[46,1,"かれ"],[49,1,"いえ"],[51,1,"かえ"],[58,1,"い"]],"text":"ソロモンは人をつかわして彼を祭壇からつれて下らせた。彼がきてソロモンを拝したので、ソロモンは彼に「家に帰りなさい」と言った。"}]