[{"ref":"Lev.24.1","start":3024001,"end":3024001,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Lev.24.2","start":3024002,"end":3024002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"めい"],[18,1,"くだ"],[21,1,"と"],[24,2,"じゅんすい"],[27,1,"あぶら"],[42,1,"ところ"],[44,1,"も"],[51,1,"た"]],"text":"「イスラエルの人々に命じて、オリブを砕いて採った純粋の油を、ともしびのためにあなたの所へ持ってこさせ、絶えずともしびをともさせなさい。"},{"ref":"Lev.24.3","start":3024003,"end":3024003,"break":"none","ruby":[[9,2,"かいけん"],[12,2,"まくや"],[22,2,"たれまく"],[25,1,"そと"],[28,1,"ゆう"],[31,1,"あさ"],[34,1,"た"],[45,1,"しゅ"],[47,1,"まえ"],[49,1,"ととの"],[69,2,"よよ"],[74,1,"まも"],[78,1,"さだ"]],"text":"すなわち、アロンは会見の幕屋のうちのあかしの垂幕の外で、夕から朝まで絶えず、そのともしびを主の前に整えなければならない。これはあなたがたが代々ながく守るべき定めである。"},{"ref":"Lev.24.4","start":3024004,"end":3024004,"break":"none","ruby":[[0,1,"かれ"],[2,2,"じゅんきん"],[5,2,"しょくだい"],[8,1,"うえ"],[18,1,"た"],[21,1,"しゅ"],[23,1,"まえ"],[25,1,"ととの"]],"text":"彼は純金の燭台の上に、そのともしびを絶えず主の前に整えなければならない。"},{"ref":"Lev.24.5","start":3024005,"end":3024005,"break":"paragraph","ruby":[[4,2,"むぎこ"],[7,1,"と"],[15,1,"こ"],[17,2,"かし"],[20,1,"や"],[31,2,"かし"],[34,1,"こ"],[36,2,"むぎこ"],[39,1,"ぶん"],[45,1,"もち"]],"text":"あなたは麦粉を取り、それで十二個の菓子を焼かなければならない。菓子一個に麦粉十分の二エパを用いなければならない。"},{"ref":"Lev.24.6","start":3024006,"end":3024006,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"まえ"],[10,2,"じゅんきん"],[13,1,"つくえ"],[15,1,"うえ"],[20,1,"かさ"],[23,1,"こ"],[29,1,"かさ"],[34,1,"お"]],"text":"そしてそれを主の前の純金の机の上に、ひと重ね六個ずつ、ふた重ねにして置かなければならない。"},{"ref":"Lev.24.7","start":3024007,"end":3024007,"break":"none","ruby":[[12,1,"かさ"],[15,1,"うえ"],[18,2,"じゅんすい"],[21,2,"にゅうこう"],[24,1,"お"],[33,2,"きねん"],[36,1,"ぶん"],[40,1,"しゅ"],[46,2,"かさい"]],"text":"あなたはまた、おのおのの重ねの上に、純粋の乳香を置いて、そのパンの記念の分とし、主にささげて火祭としなければならない。"},{"ref":"Lev.24.8","start":3024008,"end":3024008,"break":"none","ruby":[[0,3,"あんそくにち"],[6,1,"た"],[13,1,"しゅ"],[15,1,"まえ"],[17,1,"ととの"],[37,2,"ひとびと"],[52,2,"えいえん"],[55,2,"けいやく"]],"text":"安息日ごとに絶えず、これを主の前に整えなければならない。これはイスラエルの人々のささぐべきものであって、永遠の契約である。"},{"ref":"Lev.24.9","start":3024009,"end":3024009,"break":"none","ruby":[[9,1,"こ"],[13,1,"き"],[17,1,"かれ"],[23,1,"せい"],[26,1,"ところ"],[28,1,"た"],[44,1,"せい"],[47,1,"もの"],[53,1,"しゅ"],[55,2,"かさい"],[60,1,"かれ"],[62,1,"き"],[66,2,"えいきゅう"],[69,1,"ぶん"]],"text":"これはアロンとその子たちに帰する。彼らはこれを聖なる所で食べなければならない。これはいと聖なる物であって、主の火祭のうち彼に帰すべき永久の分である」。"},{"ref":"Lev.24.10","start":3024010,"end":3024010,"break":"paragraph","ruby":[[6,1,"おんな"],[8,1,"はは"],[19,1,"ちち"],[27,1,"もの"],[36,2,"ひとびと"],[42,1,"で"],[55,1,"おんな"],[57,1,"う"],[60,1,"こ"],[75,2,"しゅくえい"],[78,1,"なか"],[80,1,"あらそ"]],"text":"イスラエルの女を母とし、エジプトびとを父とするひとりの者が、イスラエルの人々のうちに出てきて、そのイスラエルの女の産んだ子と、ひとりのイスラエルびとが宿営の中で争いをし、"},{"ref":"Lev.24.11","start":3024011,"end":3024011,"break":"none","ruby":[[8,1,"おんな"],[10,1,"う"],[13,1,"こ"],[15,1,"しゅ"],[17,1,"な"],[19,1,"けが"],[30,2,"ひとびと"],[33,1,"かれ"],[42,1,"つ"],[50,1,"はは"],[55,2,"ぶぞく"],[62,1,"むすめ"],[65,1,"な"]],"text":"そのイスラエルの女の産んだ子が主の名を汚して、のろったので、人々は彼をモーセのもとに連れてきた。その母はダンの部族のデブリの娘で、名をシロミテといった。"},{"ref":"Lev.24.12","start":3024012,"end":3024012,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"かれ"],[5,1,"と"],[7,1,"こ"],[10,1,"お"],[14,1,"しゅ"],[16,1,"しめ"],[19,1,"う"],[24,1,"ま"]],"text":"人々は彼を閉じ込めて置いて、主の示しを受けるのを待っていた。"},{"ref":"Lev.24.13","start":3024013,"end":3024013,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"しゅ"],[8,1,"い"]],"text":"時に主はモーセに言われた、"},{"ref":"Lev.24.14","start":3024014,"end":3024014,"break":"none","ruby":[[10,1,"い"],[13,1,"もの"],[15,2,"しゅくえい"],[18,1,"そと"],[20,1,"ひ"],[22,1,"だ"],[28,1,"き"],[31,1,"もの"],[36,1,"て"],[38,1,"かれ"],[40,1,"あたま"],[42,1,"お"],[46,1,"ぜん"],[47,2,"かいしゅう"],[50,1,"かれ"],[52,1,"いし"],[54,1,"う"]],"text":"「あの、のろいごとを言った者を宿営の外に引き出し、それを聞いた者に、みな手を彼の頭に置かせ、全会衆に彼を石で撃たせなさい。"},{"ref":"Lev.24.15","start":3024015,"end":3024015,"break":"none","ruby":[[12,2,"ひとびと"],[15,1,"い"],[29,1,"かみ"],[34,1,"もの"],[39,1,"つみ"],[41,1,"お"]],"text":"あなたはまたイスラエルの人々に言いなさい、『だれでも、その神をのろう者は、その罪を負わなければならない。"},{"ref":"Lev.24.16","start":3024016,"end":3024016,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"な"],[4,1,"けが"],[6,1,"もの"],[8,1,"かなら"],[10,1,"ころ"],[19,1,"ぜん"],[20,2,"かいしゅう"],[23,1,"かなら"],[25,1,"かれ"],[27,1,"いし"],[29,1,"う"],[40,2,"たこく"],[43,1,"もの"],[49,1,"くに"],[51,1,"うま"],[54,1,"もの"],[58,1,"しゅ"],[60,1,"な"],[62,1,"けが"],[67,1,"ころ"]],"text":"主の名を汚す者は必ず殺されるであろう。全会衆は必ず彼を石で撃たなければならない。他国の者でも、この国に生れた者でも、主の名を汚すときは殺されなければならない。"},{"ref":"Lev.24.17","start":3024017,"end":3024017,"break":"none","ruby":[[5,1,"ひと"],[7,1,"う"],[9,1,"ころ"],[12,1,"もの"],[15,1,"かなら"],[17,1,"ころ"]],"text":"だれでも、人を撃ち殺した者は、必ず殺されなければならない。"},{"ref":"Lev.24.18","start":3024018,"end":3024018,"break":"none","ruby":[[0,1,"けもの"],[2,1,"う"],[4,1,"ころ"],[7,1,"もの"],[10,1,"けもの"],[17,1,"けもの"],[19,1,"つぐな"]],"text":"獣を撃ち殺した者は、獣をもってその獣を償わなければならない。"},{"ref":"Lev.24.19","start":3024019,"end":3024019,"break":"none","ruby":[[2,1,"ひと"],[4,2,"りんじん"],[7,1,"きず"],[9,1,"お"],[18,1,"ひと"],[20,2,"じぶん"],[28,2,"じぶん"]],"text":"もし人が隣人に傷を負わせるなら、その人は自分がしたように自分にされなければならない。"},{"ref":"Lev.24.20","start":3024020,"end":3024020,"break":"none","ruby":[[5,2,"こっせつ"],[9,2,"こっせつ"],[12,1,"め"],[15,1,"め"],[17,1,"は"],[20,1,"は"],[26,1,"ひと"],[28,1,"きず"],[30,1,"お"],[38,2,"じぶん"]],"text":"すなわち、骨折には骨折、目には目、歯には歯をもって、人に傷を負わせたように、自分にもされなければならない。"},{"ref":"Lev.24.21","start":3024021,"end":3024021,"break":"none","ruby":[[0,1,"けもの"],[2,1,"う"],[4,1,"ころ"],[7,1,"もの"],[12,1,"つぐな"],[15,1,"ひと"],[17,1,"う"],[19,1,"ころ"],[22,1,"もの"],[24,1,"ころ"]],"text":"獣を撃ち殺した者はそれを償い、人を撃ち殺した者は殺されなければならない。"},{"ref":"Lev.24.22","start":3024022,"end":3024022,"break":"none","ruby":[[0,2,"たこく"],[3,1,"もの"],[9,1,"くに"],[11,1,"うま"],[14,1,"もの"],[24,2,"どういつ"],[31,1,"もち"],[52,1,"かみ"],[54,1,"しゅ"]],"text":"他国の者にも、この国に生れた者にも、あなたがたは同一のおきてを用いなければならない。わたしはあなたがたの神、主だからである』」。"},{"ref":"Lev.24.23","start":3024023,"end":3024023,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"む"],[27,1,"い"],[30,1,"もの"],[32,2,"しゅくえい"],[35,1,"そと"],[37,1,"ひ"],[39,1,"だ"],[42,1,"いし"],[44,1,"う"],[48,1,"めい"],[60,2,"ひとびと"],[64,1,"しゅ"],[70,1,"めい"]],"text":"モーセがイスラエルの人々に向かい、「あの、のろいごとを言った者を宿営の外に引き出し、石で撃て」と命じたので、イスラエルの人々は、主がモーセに命じられたようにした。"}]