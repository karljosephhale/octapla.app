[{"ref":"1Cor.6.1","start":46006001,"end":46006001,"break":"paragraph","ruby":[[6,1,"なか"],[13,2,"なかま"],[16,1,"もの"],[18,1,"なに"],[20,1,"あらそ"],[23,1,"おこ"],[26,2,"ばあい"],[32,2,"せいと"],[35,1,"うった"],[41,1,"ただ"],[46,1,"もの"],[48,1,"うった"],[50,1,"で"]],"text":"あなたがたの中のひとりが、仲間の者と何か争いを起した場合、それを聖徒に訴えないで、正しくない者に訴え出るようなことをするのか。"},{"ref":"1Cor.6.2","start":46006002,"end":46006002,"break":"none","ruby":[[5,2,"せいと"],[8,1,"よ"],[28,1,"し"],[39,1,"よ"],[67,1,"ちい"],[70,2,"じけん"],[77,1,"ちから"]],"text":"それとも、聖徒は世をさばくものであることを、あなたがたは知らないのか。そして、世があなたがたによってさばかれるべきであるのに、きわめて小さい事件でもさばく力がないのか。"},{"ref":"1Cor.6.3","start":46006003,"end":46006003,"break":"none","ruby":[[6,1,"し"],[19,2,"みつかい"],[27,1,"もの"],[37,1,"よ"],[39,2,"じけん"]],"text":"あなたがたは知らないのか、わたしたちは御使をさえさばく者である。ましてこの世の事件などは、いうまでもないではないか。"},{"ref":"1Cor.6.4","start":46006004,"end":46006004,"break":"none","ruby":[[8,1,"よ"],[10,2,"じけん"],[13,1,"おこ"],[17,2,"きょうかい"],[20,1,"かろ"],[28,1,"ひと"],[33,2,"さいばん"],[36,1,"せき"]],"text":"それだのに、この世の事件が起ると、教会で軽んじられている人たちを、裁判の席につかせるのか。"},{"ref":"1Cor.6.5","start":46006005,"end":46006005,"break":"none","ruby":[[6,1,"い"],[40,1,"なか"],[44,2,"きょうだい"],[47,1,"あいだ"],[49,1,"あらそ"],[52,2,"ちゅうさい"],[65,2,"ちしゃ"]],"text":"わたしがこう言うのは、あなたがたをはずかしめるためである。いったい、あなたがたの中には、兄弟の間の争いを仲裁することができるほどの知者は、ひとりもいないのか。"},{"ref":"1Cor.6.6","start":46006006,"end":46006006,"break":"none","ruby":[[5,2,"きょうだい"],[8,2,"きょうだい"],[11,1,"うった"],[20,3,"ふしんじゃ"],[24,1,"まえ"],[26,1,"も"],[28,1,"だ"]],"text":"しかるに、兄弟が兄弟を訴え、しかもそれを不信者の前に持ち出すのか。"},{"ref":"1Cor.6.7","start":46006007,"end":46006007,"break":"none","ruby":[[5,1,"たがい"],[7,1,"うった"],[9,1,"あ"],[13,2,"じたい"],[26,2,"はいぼく"],[38,2,"ふぎ"],[41,1,"う"]],"text":"そもそも、互に訴え合うこと自体が、すでにあなたがたの敗北なのだ。なぜ、むしろ不義を受けないのか。なぜ、むしろだまされていないのか。"},{"ref":"1Cor.6.8","start":46006008,"end":46006008,"break":"none","ruby":[[11,2,"ふぎ"],[14,1,"はたら"],[20,1,"と"],[26,2,"きょうだい"],[29,1,"たい"]],"text":"しかるに、あなたがたは不義を働き、だまし取り、しかも兄弟に対してそうしているのである。"},{"ref":"1Cor.6.9","start":46006009,"end":46006009,"break":"none","ruby":[[5,1,"ただ"],[10,1,"もの"],[12,1,"かみ"],[14,1,"くに"],[26,1,"し"],[44,3,"ふひんこう"],[48,1,"もの"],[50,2,"ぐうぞう"],[53,2,"れいはい"],[57,1,"もの"],[59,2,"かんいん"],[64,1,"もの"],[66,2,"だんしょう"],[71,1,"もの"],[73,2,"なんしょく"],[78,1,"もの"],[80,1,"ぬす"],[82,1,"もの"]],"text":"それとも、正しくない者が神の国をつぐことはないのを、知らないのか。まちがってはいけない。不品行な者、偶像を礼拝する者、姦淫をする者、男娼となる者、男色をする者、盗む者、"},{"ref":"1Cor.6.10","start":46006010,"end":46006010,"break":"none","ruby":[[0,2,"どんよく"],[3,1,"もの"],[5,1,"さけ"],[7,1,"よ"],[9,1,"もの"],[14,1,"もの"],[16,2,"りゃくだつ"],[20,1,"もの"],[27,1,"かみ"],[29,1,"くに"]],"text":"貪欲な者、酒に酔う者、そしる者、略奪する者は、いずれも神の国をつぐことはないのである。"},{"ref":"1Cor.6.11","start":46006011,"end":46006011,"break":"none","ruby":[[6,1,"なか"],[10,2,"いぜん"],[16,1,"ひと"],[32,1,"しゅ"],[42,1,"な"],[56,1,"かみ"],[58,1,"れい"],[64,1,"あら"],[74,1,"ぎ"]],"text":"あなたがたの中には、以前はそんな人もいた。しかし、あなたがたは、主イエス・キリストの名によって、またわたしたちの神の霊によって、洗われ、きよめられ、義とされたのである。"},{"ref":"1Cor.6.12","start":46006012,"end":46006012,"break":"paragraph","ruby":[[12,1,"ゆる"],[30,1,"えき"],[53,1,"ゆる"],[68,1,"なに"],[73,2,"しはい"]],"text":"すべてのことは、わたしに許されている。しかし、すべてのことが益になるわけではない。すべてのことは、わたしに許されている。しかし、わたしは何ものにも支配されることはない。"},{"ref":"1Cor.6.13","start":46006013,"end":46006013,"break":"none","ruby":[[0,2,"しょくもつ"],[3,1,"はら"],[8,1,"はら"],[10,2,"しょくもつ"],[22,1,"かみ"],[31,1,"ほろ"],[43,3,"ふひんこう"],[54,1,"しゅ"],[62,1,"しゅ"]],"text":"食物は腹のため、腹は食物のためである。しかし神は、それもこれも滅ぼすであろう。からだは不品行のためではなく、主のためであり、主はからだのためである。"},{"ref":"1Cor.6.14","start":46006014,"end":46006014,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[19,1,"ちから"],[36,1,"くだ"]],"text":"そして、神は主をよみがえらせたが、その力で、わたしたちをもよみがえらせて下さるであろう。"},{"ref":"1Cor.6.15","start":46006015,"end":46006015,"break":"none","ruby":[[6,2,"じぶん"],[18,2,"したい"],[27,1,"し"],[45,2,"したい"],[48,1,"と"],[51,2,"ゆうじょ"],[54,2,"したい"],[64,1,"だん"]],"text":"あなたがたは自分のからだがキリストの肢体であることを、知らないのか。それだのに、キリストの肢体を取って遊女の肢体としてよいのか。断じていけない。"},{"ref":"1Cor.6.16","start":46006016,"end":46006016,"break":"none","ruby":[[5,2,"ゆうじょ"],[10,1,"もの"],[28,1,"し"],[40,1,"もの"],[42,2,"いったい"]],"text":"それとも、遊女につく者はそれと一つのからだになることを、知らないのか。「ふたりの者は一体となるべきである」とあるからである。"},{"ref":"1Cor.6.17","start":46006017,"end":46006017,"break":"none","ruby":[[3,1,"しゅ"],[7,1,"もの"],[10,1,"しゅ"],[15,1,"れい"]],"text":"しかし主につく者は、主と一つの霊になるのである。"},{"ref":"1Cor.6.18","start":46006018,"end":46006018,"break":"none","ruby":[[0,3,"ふひんこう"],[4,1,"さ"],[10,1,"ひと"],[12,1,"おか"],[18,1,"つみ"],[25,1,"そと"],[33,3,"ふひんこう"],[39,1,"もの"],[42,2,"じぶん"],[49,1,"たい"],[52,1,"つみ"],[54,1,"おか"]],"text":"不品行を避けなさい。人の犯すすべての罪は、からだの外にある。しかし不品行をする者は、自分のからだに対して罪を犯すのである。"},{"ref":"1Cor.6.19","start":46006019,"end":46006019,"break":"none","ruby":[[6,1,"し"],[13,2,"じぶん"],[21,1,"かみ"],[24,1,"う"],[27,2,"じぶん"],[30,1,"うち"],[32,1,"やど"],[37,2,"せいれい"],[40,1,"みや"],[56,2,"じぶん"],[58,2,"じしん"]],"text":"あなたがたは知らないのか。自分のからだは、神から受けて自分の内に宿っている聖霊の宮であって、あなたがたは、もはや自分自身のものではないのである。"},{"ref":"1Cor.6.20","start":46006020,"end":46006020,"break":"none","ruby":[[7,2,"だいか"],[10,1,"はら"],[13,1,"か"],[28,2,"じぶん"],[39,1,"かみ"],[41,2,"えいこう"]],"text":"あなたがたは、代価を払って買いとられたのだ。それだから、自分のからだをもって、神の栄光をあらわしなさい。"}]