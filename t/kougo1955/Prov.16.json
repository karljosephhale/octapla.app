[{"ref":"Prov.16.1","start":20016001,"end":20016001,"break":"paragraph","breaks":[[13,"line"]],"ruby":[[0,1,"こころ"],[8,1,"ひと"],[10,1,"ぞく"],[13,1,"した"],[15,1,"こたえ"],[17,1,"しゅ"],[20,1,"で"]],"text":"心にはかることは人に属し、舌の答は主から出る。"},{"ref":"Prov.16.2","start":20016002,"end":20016002,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"ひと"],[2,1,"みち"],[4,2,"じぶん"],[7,1,"め"],[14,1,"いさぎよ"],[17,1,"み"],[24,1,"しゅ"],[26,1,"ひと"],[28,1,"たましい"]],"text":"人の道は自分の目にことごとく潔しと見える、しかし主は人の魂をはかられる。"},{"ref":"Prov.16.3","start":20016003,"end":20016003,"break":"line","breaks":[[17,"line"]],"ruby":[[8,1,"こと"],[10,1,"しゅ"],[27,1,"はか"],[33,1,"かなら"],[35,1,"な"]],"text":"あなたのなすべき事を主にゆだねよ、そうすれば、あなたの計るところは必ず成る。"},{"ref":"Prov.16.4","start":20016004,"end":20016004,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"もの"],[14,1,"よう"],[19,1,"つく"],[22,1,"あ"],[25,1,"ひと"],[28,1,"わざわい"],[30,1,"ひ"],[35,1,"つく"]],"text":"主はすべての物をおのおのその用のために造り、悪しき人をも災の日のために造られた。"},{"ref":"Prov.16.5","start":20016005,"end":20016005,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"こころ"],[5,1,"たか"],[8,1,"もの"],[10,1,"しゅ"],[12,1,"にく"],[17,1,"たし"],[21,1,"かれ"],[23,1,"ばつ"],[25,1,"まぬか"]],"text":"すべて心に高ぶる者は主に憎まれる、確かに、彼は罰を免れない。"},{"ref":"Prov.16.6","start":20016006,"end":20016006,"break":"line","breaks":[[24,"line"]],"ruby":[[24,1,"しゅ"],[26,1,"おそ"],[36,1,"ひと"],[38,1,"あく"],[40,1,"まぬか"]],"text":"いつくしみとまことによって、とがはあがなわれる、主を恐れることによって、人は悪を免れる。"},{"ref":"Prov.16.7","start":20016007,"end":20016007,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ひと"],[2,1,"みち"],[4,1,"しゅ"],[6,1,"よろこ"],[10,1,"とき"],[12,1,"しゅ"],[16,1,"ひと"],[18,1,"てき"],[23,1,"ひと"],[25,1,"やわ"]],"text":"人の道が主を喜ばせる時、主はその人の敵をもその人と和らがせられる。"},{"ref":"Prov.16.8","start":20016008,"end":20016008,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"せいぎ"],[6,1,"え"],[16,2,"ふぎ"],[22,1,"え"],[24,1,"おお"],[27,1,"たから"]],"text":"正義によって得たわずかなものは、不義によって得た多くの宝にまさる。"},{"ref":"Prov.16.9","start":20016009,"end":20016009,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ひと"],[2,1,"こころ"],[4,2,"じぶん"],[7,1,"みち"],[9,1,"かんが"],[11,1,"はか"],[20,1,"あゆ"],[23,1,"みちび"],[25,1,"もの"],[27,1,"しゅ"]],"text":"人は心に自分の道を考え計る、しかし、その歩みを導く者は主である。"},{"ref":"Prov.16.10","start":20016010,"end":20016010,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"おう"],[8,1,"かみ"],[10,2,"けってい"],[27,1,"くち"],[29,1,"あやま"]],"text":"王のくちびるには神の決定がある、さばきをするとき、その口に誤りがない。"},{"ref":"Prov.16.11","start":20016011,"end":20016011,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ただ"],[7,1,"てん"],[12,1,"しゅ"],[20,1,"ふくろ"],[32,1,"かれ"],[34,1,"つく"]],"text":"正しいはかりと天びんとは主のものである、袋にあるふんどうもすべて彼の造られたものである。"},{"ref":"Prov.16.12","start":20016012,"end":20016012,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あく"],[2,1,"おこな"],[7,1,"おう"],[9,1,"にく"],[20,1,"くらい"],[22,2,"せいぎ"],[28,1,"かた"],[30,1,"た"]],"text":"悪を行うことは王の憎むところである、その位が正義によって堅く立っているからである。"},{"ref":"Prov.16.13","start":20016013,"end":20016013,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ただ"],[8,1,"おう"],[10,1,"よろこ"],[15,1,"かれ"],[17,1,"ただ"],[20,1,"こと"],[22,1,"い"],[24,1,"もの"],[26,1,"あい"]],"text":"正しいくちびるは王に喜ばれる、彼は正しい事を言う者を愛する。"},{"ref":"Prov.16.14","start":20016014,"end":20016014,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"おう"],[2,1,"いか"],[5,1,"し"],[7,2,"ししゃ"],[13,2,"ちえ"],[17,1,"ひと"]],"text":"王の怒りは死の使者である、知恵ある人はこれをなだめる。"},{"ref":"Prov.16.15","start":20016015,"end":20016015,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"おう"],[2,1,"かお"],[4,1,"ひかり"],[7,1,"いのち"],[12,1,"かれ"],[14,1,"めぐ"],[17,2,"はるさめ"],[24,1,"くも"]],"text":"王の顔の光には命がある、彼の恵みは春雨をもたらす雲のようだ。"},{"ref":"Prov.16.16","start":20016016,"end":20016016,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"え"],[7,1,"きん"],[9,1,"え"],[17,1,"さと"],[20,1,"え"],[24,1,"ぎん"],[26,1,"え"],[31,1,"のぞ"]],"text":"知恵を得るのは金を得るのにまさる、悟りを得るのは銀を得るよりも望ましい。"},{"ref":"Prov.16.17","start":20016017,"end":20016017,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"あく"],[2,1,"はな"],[8,1,"ただ"],[11,1,"ひと"],[13,1,"みち"],[18,2,"じぶん"],[21,1,"みち"],[23,1,"まも"],[25,1,"もの"],[29,1,"たましい"],[31,1,"まも"]],"text":"悪を離れることは正しい人の道である、自分の道を守る者はその魂を守る。"},{"ref":"Prov.16.18","start":20016018,"end":20016018,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"たか"],[4,1,"ほろ"],[12,1,"ほこ"],[14,1,"こころ"],[16,1,"たお"]],"text":"高ぶりは滅びにさきだち、誇る心は倒れにさきだつ。"},{"ref":"Prov.16.19","start":20016019,"end":20016019,"break":"line","breaks":[[19,"line"]],"ruby":[[6,1,"まず"],[9,2,"ひとびと"],[12,1,"とも"],[19,1,"たか"],[22,1,"もの"],[24,1,"とも"],[29,2,"えもの"],[32,1,"わ"]],"text":"へりくだって貧しい人々と共におるのは、高ぶる者と共にいて、獲物を分けるにまさる。"},{"ref":"Prov.16.20","start":20016020,"end":20016020,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"つつし"],[5,2,"ことば"],[12,1,"もの"],[14,1,"さか"],[18,1,"しゅ"],[20,1,"よ"],[22,1,"たの"],[24,1,"もの"]],"text":"慎んで、み言葉をおこなう者は栄える、主に寄り頼む者はさいわいである。"},{"ref":"Prov.16.21","start":20016021,"end":20016021,"break":"line","breaks":[[20,"line"],[30,"line"]],"ruby":[[0,1,"こころ"],[2,2,"ちえ"],[6,1,"もの"],[11,1,"もの"],[25,1,"あま"],[32,1,"おしえ"],[34,1,"ひと"],[36,1,"と"],[41,1,"ちから"],[43,1,"ま"]],"text":"心に知恵ある者はさとき者ととなえられる、くちびるが甘ければ、その教に人を説きつける力を増す。"},{"ref":"Prov.16.22","start":20016022,"end":20016022,"break":"line","breaks":[[17,"line"]],"ruby":[[0,2,"ちえ"],[6,1,"も"],[8,1,"もの"],[10,1,"いのち"],[12,1,"いずみ"],[21,1,"おろ"],[25,1,"おろ"],[28,1,"もの"],[30,1,"う"],[33,1,"こら"]],"text":"知恵はこれを持つ者に命の泉となる、しかし、愚かさは愚かな者の受ける懲しめである。"},{"ref":"Prov.16.23","start":20016023,"end":20016023,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"ちえ"],[4,1,"もの"],[6,1,"こころ"],[10,1,"い"],[16,1,"かしこ"],[29,1,"ひと"],[31,1,"と"],[36,1,"ちから"],[38,1,"ま"]],"text":"知恵ある者の心はその言うところを賢くし、またそのくちびるに人を説きつける力を増す。"},{"ref":"Prov.16.24","start":20016024,"end":20016024,"break":"line","breaks":[[15,"line"]],"ruby":[[5,2,"ことば"],[8,2,"はちみつ"],[15,1,"たましい"],[17,1,"あま"],[24,1,"すこ"]],"text":"ここちよい言葉は蜂蜜のように、魂に甘く、からだを健やかにする。"},{"ref":"Prov.16.25","start":20016025,"end":20016025,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"ひと"],[2,1,"み"],[4,2,"じぶん"],[7,1,"ただ"],[13,1,"みち"],[20,1,"おわ"],[26,1,"し"],[31,1,"みち"]],"text":"人が見て自分で正しいとする道があり、その終りはついに死にいたる道となるものがある。"},{"ref":"Prov.16.26","start":20016026,"end":20016026,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"もの"],[6,2,"いんしょく"],[19,1,"くち"],[21,2,"じぶん"],[24,1,"せま"]],"text":"ほねおる者は飲食のためにほねおる、その口が自分に迫るからである。"},{"ref":"Prov.16.27","start":20016027,"end":20016027,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"ひと"],[7,1,"あく"],[9,1,"くわだ"],[21,1,"はげ"],[24,1,"ひ"]],"text":"よこしまな人は悪を企てる、そのくちびるには激しい火のようなものがある。"},{"ref":"Prov.16.28","start":20016028,"end":20016028,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"いつわ"],[2,1,"もの"],[4,1,"あらそ"],[7,1,"おこ"],[12,1,"ぐち"],[15,1,"もの"],[17,1,"した"],[20,1,"とも"],[22,1,"はな"]],"text":"偽る者は争いを起し、つげ口する者は親しい友を離れさせる。"},{"ref":"Prov.16.29","start":20016029,"end":20016029,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"もの"],[9,1,"とな"],[11,1,"びと"],[21,1,"よ"],[25,1,"みち"],[27,1,"みちび"]],"text":"しえたげる者はその隣り人をいざない、これを良くない道に導く。"},{"ref":"Prov.16.30","start":20016030,"end":20016030,"break":"line","breaks":[[13,"line"]],"ruby":[[6,1,"もの"],[8,1,"あく"],[10,1,"はか"],[18,1,"ちぢ"],[21,1,"もの"],[23,2,"あくじ"],[28,1,"と"]],"text":"めくばせする者は悪を計り、くちびるを縮める者は悪事をなし遂げる。"},{"ref":"Prov.16.31","start":20016031,"end":20016031,"break":"line","breaks":[[12,"line"]],"ruby":[[4,1,"さか"],[7,1,"かんむり"],[12,1,"ただ"],[15,1,"い"],[27,1,"え"]],"text":"しらがは栄えの冠である、正しく生きることによってそれが得られる。"},{"ref":"Prov.16.32","start":20016032,"end":20016032,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"いか"],[8,1,"もの"],[10,2,"ゆうし"],[17,2,"じぶん"],[20,1,"こころ"],[22,1,"おさ"],[25,1,"もの"],[27,1,"しろ"],[29,1,"せ"],[31,1,"と"],[33,1,"もの"]],"text":"怒りをおそくする者は勇士にまさり、自分の心を治める者は城を攻め取る者にまさる。"},{"ref":"Prov.16.33","start":20016033,"end":20016033,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"ひと"],[11,1,"こと"],[13,1,"さだ"],[18,1,"まった"],[20,1,"しゅ"]],"text":"人はくじをひく、しかし事を定めるのは全く主のことである。"}]