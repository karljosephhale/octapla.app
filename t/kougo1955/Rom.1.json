[{"ref":"Rom.1.1","start":45001001,"end":45001001,"break":"paragraph","ruby":[[9,1,"しもべ"],[11,1,"かみ"],[13,2,"ふくいん"],[19,1,"えら"],[21,1,"わか"],[25,1,"め"],[29,2,"しと"]],"text":"キリスト・イエスの僕、神の福音のために選び別たれ、召されて使徒となったパウロから――"},{"ref":"Rom.1.2","start":45001002,"end":45001002,"break":"none","ruby":[[2,2,"ふくいん"],[6,1,"かみ"],[9,3,"よげんしゃ"],[18,2,"せいしょ"],[21,1,"なか"],[29,2,"やくそく"]],"text":"この福音は、神が、預言者たちにより、聖書の中で、あらかじめ約束されたものであって、"},{"ref":"Rom.1.3","start":45001003,"end":45001003,"break":"none","ruby":[[0,2,"みこ"],[3,1,"かん"],[12,2,"みこ"],[16,1,"にく"],[25,2,"しそん"],[29,1,"うま"]],"text":"御子に関するものである。御子は、肉によればダビデの子孫から生れ、"},{"ref":"Rom.1.4","start":45001004,"end":45001004,"break":"none","ruby":[[0,1,"せい"],[3,1,"れい"],[9,2,"しにん"],[14,2,"ふっかつ"],[20,1,"み"],[21,1,"ちから"],[26,1,"かみ"],[28,2,"みこ"],[31,1,"さだ"],[46,1,"しゅ"]],"text":"聖なる霊によれば、死人からの復活により、御力をもって神の御子と定められた。これがわたしたちの主イエス・キリストである。"},{"ref":"Rom.1.5","start":45001005,"end":45001005,"break":"none","ruby":[[9,2,"みな"],[20,3,"いほうじん"],[24,2,"しんこう"],[27,2,"じゅうじゅん"],[30,1,"いた"],[39,1,"かれ"],[44,1,"めぐ"],[47,2,"しと"],[50,1,"つとめ"],[53,1,"う"]],"text":"わたしたちは、その御名のために、すべての異邦人を信仰の従順に至らせるようにと、彼によって恵みと使徒の務とを受けたのであり、"},{"ref":"Rom.1.6","start":45001006,"end":45001006,"break":"none","ruby":[[9,1,"かれ"],[12,1,"なか"],[18,1,"め"],[31,1,"ぞく"],[34,1,"もの"]],"text":"あなたがたもまた、彼らの中にあって、召されてイエス・キリストに属する者となったのである――"},{"ref":"Rom.1.7","start":45001007,"end":45001007,"break":"none","breaks":[[23,"paragraph"]],"ruby":[[7,1,"かみ"],[9,1,"あい"],[13,1,"め"],[17,2,"せいと"],[19,2,"いちどう"],[29,1,"ちち"],[32,1,"かみ"],[36,1,"しゅ"],[48,1,"めぐ"],[51,2,"へいあん"]],"text":"ローマにいる、神に愛され、召された聖徒一同へ。わたしたちの父なる神および主イエス・キリストから、恵みと平安とが、あなたがたにあるように。"},{"ref":"Rom.1.8","start":45001008,"end":45001008,"break":"paragraph","ruby":[[2,1,"だい"],[17,2,"しんこう"],[20,1,"ぜん"],[21,2,"せかい"],[24,1,"い"],[26,1,"つた"],[55,2,"いちどう"],[66,1,"かみ"],[68,2,"かんしゃ"]],"text":"まず第一に、わたしは、あなたがたの信仰が全世界に言い伝えられていることを、イエス・キリストによって、あなたがた一同のために、わたしの神に感謝する。"},{"ref":"Rom.1.9","start":45001009,"end":45001010,"break":"none","ruby":[[5,1,"いのり"],[13,1,"た"],[22,1,"おぼ"],[29,2,"みむね"],[36,1,"みち"],[38,1,"ひら"],[55,1,"ところ"],[57,1,"い"],[64,1,"ねが"],[92,1,"くだ"],[102,1,"れい"],[107,2,"みこ"],[110,2,"ふくいん"],[113,1,"の"],[115,1,"つた"],[118,1,"つか"],[123,1,"かみ"]],"text":"わたしは、祈のたびごとに、絶えずあなたがたを覚え、いつかは御旨にかなって道が開かれ、どうにかして、あなたがたの所に行けるようにと願っている。このことについて、わたしのためにあかしをして下さるのは、わたしが霊により、御子の福音を宣べ伝えて仕えている神である。"},{"ref":"Rom.1.11","start":45001011,"end":45001011,"break":"none","ruby":[[11,1,"あ"],[16,2,"ねつぼう"],[29,1,"れい"],[31,2,"たまもの"],[34,2,"いくぶん"],[38,1,"わ"],[40,1,"あた"],[44,1,"ちから"]],"text":"わたしは、あなたがたに会うことを熱望している。あなたがたに霊の賜物を幾分でも分け与えて、力づけたいからである。"},{"ref":"Rom.1.12","start":45001012,"end":45001012,"break":"none","ruby":[[10,1,"なか"],[27,1,"たがい"],[29,2,"しんこう"],[36,1,"とも"],[38,1,"はげ"],[41,1,"あ"]],"text":"それは、あなたがたの中にいて、あなたがたとわたしとのお互の信仰によって、共に励まし合うためにほかならない。"},{"ref":"Rom.1.13","start":45001013,"end":45001013,"break":"none","ruby":[[0,2,"きょうだい"],[11,1,"し"],[32,3,"いほうじん"],[36,1,"あいだ"],[38,1,"え"],[50,1,"あいだ"],[53,2,"いくぶん"],[57,1,"み"],[59,1,"え"],[71,1,"ところ"],[73,1,"い"],[81,1,"くわだ"],[86,1,"いま"],[89,1,"さまた"]],"text":"兄弟たちよ。このことを知らずにいてもらいたくない。わたしはほかの異邦人の間で得たように、あなたがたの間でも幾分かの実を得るために、あなたがたの所に行こうとしばしば企てたが、今まで妨げられてきた。"},{"ref":"Rom.1.14","start":45001014,"end":45001014,"break":"none","ruby":[[10,1,"じん"],[13,2,"みかい"],[16,1,"ひと"],[20,1,"かしこ"],[22,1,"もの"],[25,2,"むち"],[28,1,"もの"],[32,1,"はた"],[36,2,"せきにん"]],"text":"わたしには、ギリシヤ人にも未開の人にも、賢い者にも無知な者にも、果すべき責任がある。"},{"ref":"Rom.1.15","start":45001015,"end":45001015,"break":"none","ruby":[[11,1,"せつ"],[14,1,"ねが"],[32,2,"ふくいん"],[35,1,"の"],[37,1,"つた"]],"text":"そこで、わたしとしての切なる願いは、ローマにいるあなたがたにも、福音を宣べ伝えることなのである。"},{"ref":"Rom.1.16","start":45001016,"end":45001016,"break":"none","ruby":[[4,2,"ふくいん"],[7,1,"はじ"],[20,1,"じん"],[30,1,"じん"],[37,1,"しん"],[40,1,"もの"],[43,1,"すくい"],[45,1,"え"],[49,1,"かみ"],[51,1,"ちから"]],"text":"わたしは福音を恥としない。それは、ユダヤ人をはじめ、ギリシヤ人にも、すべて信じる者に、救を得させる神の力である。"},{"ref":"Rom.1.17","start":45001017,"end":45001017,"break":"none","ruby":[[0,1,"かみ"],[2,1,"ぎ"],[7,2,"ふくいん"],[10,1,"なか"],[12,2,"けいじ"],[17,2,"しんこう"],[20,1,"はじ"],[23,2,"しんこう"],[26,1,"いた"],[36,2,"しんこう"],[41,2,"ぎじん"],[44,1,"い"],[49,1,"か"]],"text":"神の義は、その福音の中に啓示され、信仰に始まり信仰に至らせる。これは、「信仰による義人は生きる」と書いてあるとおりである。"},{"ref":"Rom.1.18","start":45001018,"end":45001018,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"いか"],[6,2,"ふぎ"],[12,2,"しんり"],[22,2,"にんげん"],[29,3,"ふしんじん"],[33,2,"ふぎ"],[37,1,"たい"],[41,1,"てん"],[44,2,"けいじ"]],"text":"神の怒りは、不義をもって真理をはばもうとする人間のあらゆる不信心と不義とに対して、天から啓示される。"},{"ref":"Rom.1.19","start":45001019,"end":45001019,"break":"none","ruby":[[5,1,"かみ"],[10,1,"し"],[14,1,"こと"],[19,1,"かれ"],[23,1,"あき"],[30,1,"かみ"],[35,1,"かれ"],[38,1,"あき"]],"text":"なぜなら、神について知りうる事がらは、彼らには明らかであり、神がそれを彼らに明らかにされたのである。"},{"ref":"Rom.1.20","start":45001020,"end":45001020,"break":"none","ruby":[[0,1,"かみ"],[2,1,"み"],[6,2,"せいしつ"],[14,1,"かみ"],[16,2,"えいえん"],[19,1,"ちから"],[21,2,"しんせい"],[26,2,"てんち"],[28,2,"そうぞう"],[35,1,"ひ"],[36,2,"ぞうぶつ"],[42,1,"し"],[49,1,"あき"],[53,1,"みと"],[70,1,"かれ"],[74,2,"べんかい"],[77,2,"よち"]],"text":"神の見えない性質、すなわち、神の永遠の力と神性とは、天地創造このかた、被造物において知られていて、明らかに認められるからである。したがって、彼らには弁解の余地がない。"},{"ref":"Rom.1.21","start":45001021,"end":45001021,"break":"none","ruby":[[5,1,"かれ"],[8,1,"かみ"],[10,1,"し"],[18,1,"かみ"],[27,2,"かんしゃ"],[39,1,"おも"],[51,2,"むち"],[54,1,"こころ"],[56,1,"くら"]],"text":"なぜなら、彼らは神を知っていながら、神としてあがめず、感謝もせず、かえってその思いはむなしくなり、その無知な心は暗くなったからである。"},{"ref":"Rom.1.22","start":45001022,"end":45001022,"break":"none","ruby":[[0,1,"かれ"],[3,1,"みずか"],[5,2,"ちしゃ"],[8,1,"しょう"],[14,1,"おろ"]],"text":"彼らは自ら知者と称しながら、愚かになり、"},{"ref":"Rom.1.23","start":45001023,"end":45001023,"break":"none","ruby":[[0,2,"ふきゅう"],[3,1,"かみ"],[5,2,"えいこう"],[8,1,"か"],[12,1,"く"],[15,2,"にんげん"],[18,1,"とり"],[20,1,"けもの"],[22,1,"は"],[27,1,"ぞう"],[29,1,"に"]],"text":"不朽の神の栄光を変えて、朽ちる人間や鳥や獣や這うものの像に似せたのである。"},{"ref":"Rom.1.24","start":45001024,"end":45001024,"break":"paragraph","ruby":[[4,1,"かみ"],[7,1,"かれ"],[10,1,"こころ"],[12,2,"よくじょう"],[19,2,"じぶん"],[26,1,"たがい"],[35,1,"けが"],[40,1,"まか"]],"text":"ゆえに、神は、彼らが心の欲情にかられ、自分のからだを互にはずかしめて、汚すままに任せられた。"},{"ref":"Rom.1.25","start":45001025,"end":45001025,"break":"none","ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,2,"しんり"],[8,1,"か"],[11,2,"きょぎ"],[16,3,"そうぞうしゃ"],[20,1,"かわ"],[23,1,"ひ"],[24,2,"ぞうぶつ"],[27,1,"おが"],[33,1,"つか"],[41,3,"そうぞうしゃ"],[46,2,"えいえん"]],"text":"彼らは神の真理を変えて虚偽とし、創造者の代りに被造物を拝み、これに仕えたのである。創造者こそ永遠にほむべきものである、アァメン。"},{"ref":"Rom.1.26","start":45001026,"end":45001026,"break":"paragraph","ruby":[[5,1,"かみ"],[7,1,"かれ"],[10,1,"は"],[14,2,"じょうよく"],[17,1,"まか"],[28,1,"かれ"],[31,1,"なか"],[33,1,"おんな"],[38,2,"しぜん"],[41,2,"かんけい"],[44,3,"ふしぜん"],[51,1,"か"]],"text":"それゆえ、神は彼らを恥ずべき情欲に任せられた。すなわち、彼らの中の女は、その自然の関係を不自然なものに代え、"},{"ref":"Rom.1.27","start":45001027,"end":45001027,"break":"none","ruby":[[0,1,"おとこ"],[4,1,"おな"],[9,1,"おんな"],[12,2,"しぜん"],[15,2,"かんけい"],[18,1,"す"],[22,1,"たがい"],[26,2,"じょうよく"],[29,1,"ほのお"],[31,1,"も"],[35,1,"おとこ"],[37,1,"おとこ"],[39,1,"たい"],[42,1,"は"],[57,2,"らんぎょう"],[60,2,"とうぜん"],[63,1,"むく"],[67,1,"み"],[69,1,"う"]],"text":"男もまた同じように女との自然の関係を捨てて、互にその情欲の炎を燃やし、男は男に対して恥ずべきことをなし、そしてその乱行の当然の報いを、身に受けたのである。"},{"ref":"Rom.1.28","start":45001028,"end":45001028,"break":"paragraph","ruby":[[4,1,"かれ"],[7,1,"かみ"],[9,1,"みと"],[15,1,"ただ"],[27,1,"かみ"],[29,1,"かれ"],[32,1,"ただ"],[37,1,"おも"],[51,1,"こと"],[56,1,"まか"]],"text":"そして、彼らは神を認めることを正しいとしなかったので、神は彼らを正しからぬ思いにわたし、なすべからざる事をなすに任せられた。"},{"ref":"Rom.1.29","start":45001029,"end":45001029,"break":"none","ruby":[[5,1,"かれ"],[13,2,"ふぎ"],[16,1,"あく"],[18,2,"どんよく"],[21,2,"あくい"],[33,2,"さつい"],[36,1,"あらそ"],[39,2,"さぎ"],[42,2,"あくねん"],[46,1,"み"],[54,1,"げん"],[57,1,"もの"]],"text":"すなわち、彼らは、あらゆる不義と悪と貪欲と悪意とにあふれ、ねたみと殺意と争いと詐欺と悪念とに満ち、また、ざん言する者、"},{"ref":"Rom.1.30","start":45001030,"end":45001030,"break":"none","ruby":[[3,1,"もの"],[5,1,"かみ"],[7,1,"にく"],[9,1,"もの"],[11,2,"ふそん"],[14,1,"もの"],[16,2,"こうまん"],[19,1,"もの"],[21,4,"たいげんそうご"],[27,1,"もの"],[29,2,"あくじ"],[36,1,"もの"],[38,1,"おや"],[40,1,"さか"],[43,1,"もの"]],"text":"そしる者、神を憎む者、不遜な者、高慢な者、大言壮語する者、悪事をたくらむ者、親に逆らう者となり、"},{"ref":"Rom.1.31","start":45001031,"end":45001031,"break":"none","ruby":[[0,2,"むち"],[3,3,"ふせいじつ"],[7,2,"むじょう"],[10,3,"むじひ"],[14,1,"もの"]],"text":"無知、不誠実、無情、無慈悲な者となっている。"},{"ref":"Rom.1.32","start":45001032,"end":45001032,"break":"none","ruby":[[0,1,"かれ"],[8,1,"こと"],[10,1,"おこな"],[12,1,"もの"],[16,1,"し"],[18,1,"あたい"],[24,1,"かみ"],[26,1,"さだ"],[31,1,"し"],[37,1,"みずか"],[42,1,"おこな"],[55,1,"おこな"],[57,1,"もの"],[61,2,"ぜにん"]],"text":"彼らは、こうした事を行う者どもが死に価するという神の定めをよく知りながら、自らそれを行うばかりではなく、それを行う者どもを是認さえしている。"}]