[{"ref":"Ezek.10.1","start":26010001,"end":26010001,"break":"paragraph","ruby":[[0,1,"とき"],[6,1,"み"],[12,1,"み"],[20,1,"あたま"],[22,1,"うえ"],[24,2,"おおぞら"],[40,2,"おうざ"],[43,1,"かたち"],[50,1,"うえ"],[52,1,"あらわ"]],"text":"時にわたしは見ていたが、見よ、ケルビムの頭の上の大空に、サファイヤのようなものが王座の形をして、その上に現れた。"},{"ref":"Ezek.10.2","start":26010002,"end":26010002,"break":"none","breaks":[[72,"paragraph"]],"ruby":[[0,1,"かれ"],[2,2,"あま"],[4,1,"ぬの"],[6,1,"き"],[10,1,"ひと"],[12,1,"い"],[23,1,"した"],[25,1,"まわ"],[27,1,"くるま"],[29,1,"あいだ"],[40,1,"あいだ"],[43,2,"すみび"],[53,1,"て"],[55,1,"み"],[62,2,"まちぢゅう"],[67,1,"ち"],[75,1,"かれ"],[81,1,"め"],[83,1,"まえ"]],"text":"彼は亜麻布を着たその人に言われた、「ケルビムの下の回る車の間にはいり、ケルビムの間から炭火をとってあなたの手に満たし、これを町中にまき散らせ」。そして彼はわたしの目の前ではいった。"},{"ref":"Ezek.10.3","start":26010003,"end":26010003,"break":"none","ruby":[[2,1,"ひと"],[8,1,"とき"],[15,1,"みや"],[17,2,"みなみがわ"],[20,1,"た"],[28,1,"くも"],[32,2,"うちにわ"],[35,1,"み"]],"text":"この人がはいった時、ケルビムは宮の南側に立っていた。また雲はその内庭を満たしていた。"},{"ref":"Ezek.10.4","start":26010004,"end":26010004,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"えいこう"],[10,1,"うえ"],[13,1,"みや"],[15,2,"しきい"],[18,1,"うえ"],[24,1,"みや"],[26,1,"くも"],[28,1,"み"],[31,1,"にわ"],[33,1,"しゅ"],[35,2,"えいこう"],[38,1,"かがや"],[41,1,"み"]],"text":"主の栄光はケルビムの上から宮の敷居の上にあがり、宮は雲で満ち、庭は主の栄光の輝きで満たされた。"},{"ref":"Ezek.10.5","start":26010005,"end":26010005,"break":"none","ruby":[[0,1,"とき"],[7,1,"つばさ"],[9,1,"おと"],[11,2,"たいのう"],[14,1,"かみ"],[16,1,"かた"],[20,1,"こえ"],[25,1,"そと"],[26,1,"にわ"],[30,1,"きこ"]],"text":"時にケルビムの翼の音が大能の神が語られる声のように外庭にまで聞えた。"},{"ref":"Ezek.10.6","start":26010006,"end":26010006,"break":"paragraph","ruby":[[0,1,"かれ"],[2,2,"あま"],[4,1,"ぬの"],[6,1,"き"],[10,1,"ひと"],[14,1,"まわ"],[16,1,"くるま"],[18,1,"あいだ"],[25,1,"あいだ"],[28,1,"ひ"],[30,1,"と"],[35,1,"めい"],[38,1,"とき"],[42,1,"ひと"],[49,1,"わ"],[56,1,"た"]],"text":"彼が亜麻布を着ている人に、「回る車の間、ケルビムの間から火を取れ」。と命じた時、その人ははいって、輪のかたわらに立った。"},{"ref":"Ezek.10.7","start":26010007,"end":26010007,"break":"none","ruby":[[10,1,"て"],[17,1,"あいだ"],[20,1,"の"],[29,1,"あいだ"],[33,1,"ひ"],[35,1,"と"],[38,2,"あま"],[40,1,"ぬの"],[42,1,"き"],[44,1,"ひと"],[46,1,"て"],[48,1,"お"],[55,1,"かれ"],[60,1,"と"],[63,1,"で"],[65,1,"い"]],"text":"ひとりのケルブはその手をケルビムの間から伸べて、ケルビムの間にある火を取り、亜麻布を着た人の手に置いた。すると彼はこれを取って出て行った。"},{"ref":"Ezek.10.8","start":26010008,"end":26010008,"break":"none","ruby":[[7,1,"つばさ"],[9,1,"した"],[11,1,"ひと"],[13,1,"て"],[18,1,"かたち"],[23,1,"も"],[31,1,"み"]],"text":"ケルビムはその翼の下に人の手のような形のものを持っているように見えた。"},{"ref":"Ezek.10.9","start":26010009,"end":26010009,"break":"paragraph","ruby":[[4,1,"み"],[10,1,"み"],[26,1,"わ"],[34,1,"わ"],[50,1,"た"],[52,1,"わ"],[54,1,"た"],[69,1,"わ"],[75,1,"ひか"],[77,1,"き"],[82,1,"いし"]],"text":"わたしが見ていると、見よ、ケルビムのかたわらに四つの輪があり、一つの輪はひとりのケルブのかたわらに、他の輪は他のケルブのかたわらにあった。輪のさまは、光る貴かんらん石のようであった。"},{"ref":"Ezek.10.10","start":26010010,"end":26010010,"break":"none","ruby":[[9,1,"おな"],[11,1,"かたち"],[18,1,"わ"],[20,1,"なか"],[22,1,"わ"]],"text":"そのさまは四つとも同じ形で、あたかも輪の中に輪があるようであった。"},{"ref":"Ezek.10.11","start":26010011,"end":26010011,"break":"none","ruby":[[2,1,"ゆ"],[4,1,"とき"],[6,2,"しほう"],[14,1,"い"],[19,1,"ゆ"],[21,1,"とき"],[23,1,"まわ"],[30,2,"せんとう"],[33,1,"わ"],[35,1,"む"],[41,1,"したが"],[46,1,"ゆ"],[48,1,"とき"],[50,1,"まわ"]],"text":"その行く時は四方のどこへでも行く。その行く時は回らない。ただ先頭の輪の向くところに従い、その行く時は回ることをしない。"},{"ref":"Ezek.10.12","start":26010012,"end":26010012,"break":"none","ruby":[[2,1,"わ"],[3,1,"ふち"],[7,1,"や"],[12,1,"わ"],[20,1,"め"],[22,1,"み"],[31,1,"わ"],[40,1,"も"]],"text":"その輪縁、その輻、および輪には、まわりに目が満ちていた。―その輪は四つともこれを持っていた。"},{"ref":"Ezek.10.13","start":26010013,"end":26010013,"break":"none","ruby":[[2,1,"わ"],[8,1,"き"],[13,1,"ところ"],[17,1,"まわ"],[19,1,"わ"],[22,1,"よ"]],"text":"その輪はわたしの聞いている所で、「回る輪」と呼ばれた。"},{"ref":"Ezek.10.14","start":26010014,"end":26010014,"break":"none","ruby":[[11,1,"かお"],[17,1,"だい"],[20,1,"かお"],[26,1,"かお"],[28,1,"だい"],[29,1,"に"],[31,1,"かお"],[33,1,"ひと"],[35,1,"かお"],[37,1,"だい"],[43,1,"かお"],[45,1,"だい"],[51,1,"かお"]],"text":"そのおのおのには四つの顔があった。第一の顔はケルブの顔、第二の顔は人の顔、第三はししの顔、第四はわしの顔であった。"},{"ref":"Ezek.10.15","start":26010015,"end":26010015,"break":"paragraph","ruby":[[2,1,"とき"],[19,1,"がわ"],[25,1,"み"],[27,1,"い"]],"text":"その時ケルビムはのぼった。これがケバル川でわたしが見た生きものである。"},{"ref":"Ezek.10.16","start":26010016,"end":26010016,"break":"none","ruby":[[5,1,"ゆ"],[7,1,"とき"],[9,1,"わ"],[18,1,"い"],[26,1,"つばさ"],[31,1,"ち"],[34,1,"と"],[39,1,"とき"],[42,1,"わ"],[51,1,"はな"]],"text":"ケルビムの行く時、輪もそのかたわらに行き、ケルビムが翼をあげて地から飛びあがる時は、輪もそのかたわらを離れない。"},{"ref":"Ezek.10.17","start":26010017,"end":26010017,"break":"none","ruby":[[2,1,"た"],[7,1,"とき"],[10,1,"わ"],[12,1,"た"],[23,1,"とき"],[26,1,"わ"],[28,1,"とも"],[34,1,"い"],[39,1,"れい"],[43,1,"なか"]],"text":"その立ちどまる時は、輪も立ちどまり、そののぼる時は、輪も共にのぼる。生きものの霊がその中にあるからである。"},{"ref":"Ezek.10.18","start":26010018,"end":26010018,"break":"paragraph","ruby":[[0,1,"とき"],[2,1,"しゅ"],[4,2,"えいこう"],[7,1,"みや"],[9,2,"しきい"],[13,1,"で"],[15,1,"い"],[24,1,"うえ"],[26,1,"た"]],"text":"時に主の栄光が宮の敷居から出て行って、ケルビムの上に立った。"},{"ref":"Ezek.10.19","start":26010019,"end":26010019,"break":"none","ruby":[[8,1,"つばさ"],[18,1,"め"],[20,1,"まえ"],[23,1,"ち"],[33,1,"で"],[35,1,"い"],[37,1,"とき"],[39,1,"わ"],[46,1,"とも"],[51,1,"しゅ"],[53,1,"みや"],[55,1,"ひがし"],[57,1,"もん"],[59,2,"いりぐち"],[62,1,"ところ"],[64,1,"い"],[67,1,"と"],[78,1,"かみ"],[80,2,"えいこう"],[85,1,"うえ"]],"text":"するとケルビムは翼をあげて、わたしの目の前で、地からのぼった。その出て行く時、輪もまたこれと共にあり、主の宮の東の門の入口の所へ行って止まった。イスラエルの神の栄光がその上にあった。"},{"ref":"Ezek.10.20","start":26010020,"end":26010020,"break":"paragraph","ruby":[[14,1,"がわ"],[27,1,"かみ"],[29,1,"した"],[31,1,"み"],[35,1,"い"],[60,1,"し"]],"text":"これがすなわちわたしがケバル川のほとりで、イスラエルの神の下に見たかの生きものである。わたしはそれがケルビムであることを知っていた。"},{"ref":"Ezek.10.21","start":26010021,"end":26010021,"break":"none","ruby":[[11,1,"かお"],[23,1,"つばさ"],[30,1,"ひと"],[32,1,"て"],[42,1,"つばさ"],[44,1,"した"]],"text":"これにはおのおの四つの顔があり、おのおの四つの翼があり、また人の手のようなものがその翼の下にあった。"},{"ref":"Ezek.10.22","start":26010022,"end":26010022,"break":"none","ruby":[[2,1,"かお"],[4,1,"かたち"],[10,1,"がわ"],[20,1,"み"],[27,1,"かお"],[38,1,"まえ"],[40,1,"ほう"],[47,1,"い"]],"text":"その顔の形は、ケバル川のほとりでわたしが見たそのままの顔である。おのおのその前の方にまっすぐに行った。"}]