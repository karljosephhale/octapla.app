[{"ref":"Ps.18.1","start":19018001,"end":19018001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせた主のしもべダビデの歌、すなわち主がもろもろのあだの手とサウルの手から救い出された日にダビデはこの歌の言葉を主にむかって述べて言った","ruby":[[2,1,"ちから"],[5,1,"しゅ"],[16,1,"あい"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[16,1,"しゅ"],[25,1,"うた"],[31,1,"しゅ"],[41,1,"て"],[47,1,"て"],[50,1,"すく"],[52,1,"だ"],[56,1,"ひ"],[64,1,"うた"],[66,2,"ことば"],[69,1,"しゅ"],[75,1,"の"],[78,1,"い"]],"text":"わが力なる主よ、わたしはあなたを愛します。"},{"ref":"Ps.18.2","start":19018002,"end":19018002,"break":"line","breaks":[[18,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"いわ"],[8,1,"しろ"],[14,1,"すく"],[16,1,"もの"],[20,1,"かみ"],[24,1,"よ"],[26,1,"たの"],[28,1,"いわ"],[32,1,"たて"],[36,1,"すくい"],[38,1,"つの"],[42,1,"たか"]],"text":"主はわが岩、わが城、わたしを救う者、わが神、わが寄り頼む岩、わが盾、わが救の角、わが高きやぐらです。"},{"ref":"Ps.18.3","start":19018003,"end":19018003,"break":"line","breaks":[[19,"line"]],"ruby":[[11,1,"しゅ"],[13,1,"よ"],[23,1,"てき"],[26,1,"すく"]],"text":"わたしはほめまつるべき主に呼ばわって、わたしの敵から救われるのです。"},{"ref":"Ps.18.4","start":19018004,"end":19018004,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"し"],[2,1,"つな"],[9,1,"と"],[11,1,"ま"],[14,1,"ほろ"],[17,2,"おおみず"],[25,1,"おそ"]],"text":"死の綱は、わたしを取り巻き、滅びの大水は、わたしを襲いました。"},{"ref":"Ps.18.5","start":19018005,"end":19018005,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"よみ"],[3,1,"つな"],[10,1,"かこ"],[13,1,"し"],[23,1,"た"]],"text":"陰府の綱は、わたしを囲み、死のわなは、わたしに立ちむかいました。"},{"ref":"Ps.18.6","start":19018006,"end":19018006,"break":"line","breaks":[[17,"line"],[29,"line"],[46,"line"]],"ruby":[[4,1,"なや"],[10,1,"しゅ"],[12,1,"よ"],[19,1,"かみ"],[21,1,"さけ"],[23,1,"もと"],[29,1,"しゅ"],[33,1,"みや"],[40,1,"こえ"],[42,1,"き"],[46,1,"しゅ"],[55,1,"さけ"],[60,1,"みみ"],[62,1,"たっ"]],"text":"わたしは悩みのうちに主に呼ばわり、わが神に叫び求めました。主はその宮からわたしの声を聞かれ、主にさけぶわたしの叫びがその耳に達しました。"},{"ref":"Ps.18.7","start":19018007,"end":19018007,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"ち"],[6,1,"ゆ"],[8,1,"うご"],[11,2,"やまやま"],[14,1,"もとい"],[16,1,"ふる"],[18,1,"うご"],[24,1,"しゅ"],[27,1,"いか"]],"text":"そのとき地は揺れ動き、山々の基は震い動きました。主がお怒りになったからです。"},{"ref":"Ps.18.8","start":19018008,"end":19018008,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[0,1,"けむり"],[4,1,"はな"],[7,1,"た"],[13,1,"ひ"],[17,1,"くち"],[20,1,"で"],[22,1,"や"],[28,1,"すみ"],[36,1,"も"]],"text":"煙はその鼻から立ちのぼり、火はその口から出て焼きつくし、炭はそれによって燃えあがりました。"},{"ref":"Ps.18.9","start":19018009,"end":19018009,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"てん"],[7,1,"くだ"],[11,1,"くら"],[17,1,"あし"],[19,1,"した"]],"text":"主は天をたれて下られ、暗やみがその足の下にありました。"},{"ref":"Ps.18.10","start":19018010,"end":19018010,"break":"line","ruby":[[0,1,"しゅ"],[6,1,"の"],[9,1,"と"],[12,1,"かぜ"],[14,1,"つばさ"]],"text":"主はケルブに乗って飛び、風の翼をもってかけり、"},{"ref":"Ps.18.11","start":19018011,"end":19018011,"break":"line","breaks":[[20,"line"]],"ruby":[[10,2,"じぶん"],[17,1,"お"],[20,1,"みず"],[22,1,"ふく"],[25,1,"くら"],[27,1,"こ"],[29,1,"くも"],[33,2,"まくや"]],"text":"やみをおおいとして、自分のまわりに置き、水を含んだ暗い濃き雲をその幕屋とされました。"},{"ref":"Ps.18.12","start":19018012,"end":19018012,"break":"line","breaks":[[17,"line"]],"ruby":[[3,1,"まえ"],[5,1,"かがや"],[9,1,"こ"],[11,1,"くも"],[13,1,"やぶ"],[21,1,"も"],[24,1,"すみ"],[27,1,"ふ"]],"text":"そのみ前の輝きから濃き雲を破って、ひょうと燃える炭とが降ってきました。"},{"ref":"Ps.18.13","start":19018013,"end":19018013,"break":"line","breaks":[[14,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"てん"],[6,1,"かみなり"],[16,1,"たか"],[18,1,"もの"],[21,1,"こえ"],[23,1,"だ"],[33,1,"も"],[36,1,"すみ"],[39,1,"ふ"]],"text":"主はまた天に雷をとどろかせ、いと高き者がみ声を出されると、ひょうと燃える炭とが降ってきました。"},{"ref":"Ps.18.14","start":19018014,"end":19018014,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"や"],[4,1,"はな"],[7,1,"かれ"],[10,1,"ち"],[25,1,"かれ"],[28,1,"う"],[30,1,"やぶ"]],"text":"主は矢を放って彼らを散らし、いなずまをひらめかして彼らを打ち敗られました。"},{"ref":"Ps.18.15","start":19018015,"end":19018015,"break":"line","breaks":[[17,"line"],[41,"line"]],"ruby":[[0,1,"しゅ"],[21,1,"はな"],[32,1,"うみ"],[34,1,"そこ"],[41,1,"ち"],[43,1,"もとい"]],"text":"主よ、そのとき、あなたのとがめと、あなたの鼻のいぶきとによって、海の底はあらわれ、地の基があらわになったのです。"},{"ref":"Ps.18.16","start":19018016,"end":19018016,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"たか"],[4,1,"ところ"],[8,1,"て"],[10,1,"の"],[18,1,"とら"],[21,2,"おおみず"],[29,1,"ひ"]],"text":"主は高い所からみ手を伸べて、わたしを捕え、大水からわたしを引きあげ、"},{"ref":"Ps.18.17","start":19018017,"end":19018017,"break":"line","breaks":[[19,"line"],[32,"line"]],"ruby":[[4,1,"つよ"],[6,1,"てき"],[13,1,"にく"],[15,1,"もの"],[23,1,"たす"],[25,1,"だ"],[32,1,"かれ"],[43,1,"つよ"]],"text":"わたしの強い敵と、わたしを憎む者とからわたしを助け出されました。彼らはわたしにまさって強かったからです。"},{"ref":"Ps.18.18","start":19018018,"end":19018018,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[7,1,"わざわい"],[9,1,"ひ"],[15,1,"おそ"],[24,1,"しゅ"]],"text":"彼らはわたしの災の日にわたしを襲いました。しかし主はわたしのささえとなられました。"},{"ref":"Ps.18.19","start":19018019,"end":19018019,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ひろ"],[8,1,"ところ"],[12,1,"だ"],[19,1,"よろこ"],[32,1,"たす"]],"text":"主はわたしを広い所につれ出し、わたしを喜ばれるがゆえに、わたしを助けられました。"},{"ref":"Ps.18.20","start":19018020,"end":19018020,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"ぎ"],[17,1,"むく"],[24,1,"て"],[26,1,"きよ"],[38,1,"むく"]],"text":"主はわたしの義にしたがってわたしに報い、わたしの手の清きにしたがってわたしに報いかえされました。"},{"ref":"Ps.18.21","start":19018021,"end":19018021,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"みち"],[8,1,"まも"],[11,2,"あくい"],[20,1,"かみ"],[22,1,"はな"]],"text":"わたしは主の道を守り、悪意をもって、わが神を離れたことがなかったのです、"},{"ref":"Ps.18.22","start":19018022,"end":19018022,"break":"line","breaks":[[20,"line"]],"ruby":[[14,1,"まえ"],[26,1,"さだ"],[29,1,"す"]],"text":"そのすべてのおきてはわたしの前にあって、わたしはその定めを捨てたことがなかったのです。"},{"ref":"Ps.18.23","start":19018023,"end":19018023,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"まえ"],[8,1,"か"],[18,2,"じぶん"],[21,1,"まも"],[24,1,"つみ"],[26,1,"おか"]],"text":"わたしは主の前に欠けたところがなく、自分を守って罪を犯しませんでした。"},{"ref":"Ps.18.24","start":19018024,"end":19018024,"break":"line","breaks":[[18,"line"],[38,"line"]],"ruby":[[5,1,"しゅ"],[11,1,"ぎ"],[20,1,"め"],[22,1,"まえ"],[28,1,"て"],[30,1,"きよ"],[42,1,"むく"]],"text":"このゆえに主はわたしの義にしたがい、その目の前にわたしの手の清きにしたがってわたしに報いられました。"},{"ref":"Ps.18.25","start":19018025,"end":19018025,"break":"line","breaks":[[15,"line"],[27,"line"],[40,"line"]],"ruby":[[11,1,"もの"],[22,1,"もの"],[27,1,"か"],[36,1,"もの"],[40,1,"か"],[49,1,"もの"]],"text":"あなたはいつくしみある者には、いつくしみある者となり、欠けたところのない者には、欠けたところのない者となり、"},{"ref":"Ps.18.26","start":19018026,"end":19018026,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"きよ"],[2,1,"もの"],[6,1,"きよ"],[8,1,"もの"],[17,1,"もの"],[25,1,"もの"]],"text":"清い者には、清い者となり、ひがんだ者には、ひがんだ者となられます。"},{"ref":"Ps.18.27","start":19018027,"end":19018027,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"くる"],[10,1,"たみ"],[12,1,"すく"],[19,1,"たか"],[22,1,"め"]],"text":"あなたは苦しんでいる民を救われますが、高ぶる目をひくくされるのです。"},{"ref":"Ps.18.28","start":19018028,"end":19018028,"break":"line","breaks":[[17,"line"]],"ruby":[[19,1,"かみ"],[21,1,"しゅ"],[30,1,"てら"]],"text":"あなたはわたしのともしびをともし、わが神、主はわたしのやみを照されます。"},{"ref":"Ps.18.29","start":19018029,"end":19018029,"break":"line","breaks":[[24,"line"]],"ruby":[[16,1,"てき"],[17,1,"ぐん"],[19,1,"う"],[21,1,"やぶ"],[26,1,"かみ"],[31,2,"じょうへき"],[36,1,"こ"]],"text":"まことに、わたしはあなたによって敵軍を打ち破り、わが神によって城壁をとび越えることができます。"},{"ref":"Ps.18.30","start":19018030,"end":19018030,"break":"line","breaks":[[16,"line"],[26,"line"]],"ruby":[[2,1,"かみ"],[8,1,"みち"],[10,2,"かんぜん"],[16,1,"しゅ"],[18,2,"ことば"],[21,2,"しんじつ"],[26,1,"しゅ"],[31,1,"よ"],[33,1,"たの"],[35,1,"もの"],[37,1,"たて"]],"text":"この神こそ、その道は完全であり、主の言葉は真実です。主はすべて寄り頼む者の盾です。"},{"ref":"Ps.18.31","start":19018031,"end":19018031,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"かみ"],[20,1,"かみ"],[29,1,"いわ"]],"text":"主のほかに、だれが神でしょうか。われらの神のほかに、だれが岩でしょうか。"},{"ref":"Ps.18.32","start":19018032,"end":19018032,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"かみ"],[6,1,"ちから"],[8,1,"お"],[17,1,"みち"],[19,2,"あんぜん"]],"text":"神はわたしに力を帯びさせ、わたしの道を安全にされました。"},{"ref":"Ps.18.33","start":19018033,"end":19018033,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かみ"],[6,1,"あし"],[12,1,"あし"],[24,1,"たか"],[26,1,"ところ"],[28,2,"あんぜん"],[31,1,"た"]],"text":"神はわたしの足をめじかの足のようにされ、わたしを高い所に安全に立たせ、"},{"ref":"Ps.18.34","start":19018034,"end":19018034,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"て"],[6,1,"たたか"],[9,1,"な"],[21,1,"うで"],[23,2,"せいどう"],[26,1,"ゆみ"]],"text":"わたしの手を戦いに慣らされたので、わたしの腕は青銅の弓をもひくことができます。"},{"ref":"Ps.18.35","start":19018035,"end":19018035,"break":"line","breaks":[[17,"line"],[33,"line"]],"ruby":[[6,1,"すくい"],[8,1,"たて"],[14,1,"あた"],[21,1,"みぎ"],[23,1,"て"],[37,1,"たす"],[44,1,"おお"],[48,1,"もの"]],"text":"あなたはその救の盾をわたしに与え、あなたの右の手はわたしをささえ、あなたの助けはわたしを大いなる者とされました。"},{"ref":"Ps.18.36","start":19018036,"end":19018036,"break":"line","breaks":[[20,"line"]],"ruby":[[8,1,"あゆ"],[10,1,"ところ"],[12,1,"ひろ"],[24,1,"あし"]],"text":"あなたがわたしの歩む所を広くされたので、わたしの足はすべらなかったのです。"},{"ref":"Ps.18.37","start":19018037,"end":19018037,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"てき"],[6,1,"お"],[13,1,"お"],[21,1,"ほろ"],[30,1,"かえ"]],"text":"わたしは敵を追って、これに追いつき、これを滅ぼしつくすまでは帰らなかったのです。"},{"ref":"Ps.18.38","start":19018038,"end":19018038,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[4,1,"かれ"],[7,1,"つ"],[9,1,"とお"],[15,1,"かれ"],[18,1,"た"],[34,1,"あし"],[38,1,"たお"]],"text":"わたしが彼らを突き通したので、彼らは立ちあがることができず、わたしの足もとに倒れました。"},{"ref":"Ps.18.39","start":19018039,"end":19018039,"break":"line","breaks":[[21,"line"],[41,"line"]],"ruby":[[4,1,"たたか"],[14,1,"ちから"],[16,1,"お"],[25,1,"た"],[27,1,"む"],[30,1,"もの"]],"text":"あなたは戦いのためにわたしに力を帯びさせ、わたしに立ち向かう者らをわたしのもとに、かがませられました。"},{"ref":"Ps.18.40","start":19018040,"end":19018040,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"てき"],[8,1,"うしろ"],[14,1,"む"],[28,2,"じぶん"],[31,1,"にく"],[33,1,"もの"],[35,1,"ほろ"]],"text":"あなたは敵にその後をわたしに向けさせられたので、わたしは自分を憎む者を滅ぼしました。"},{"ref":"Ps.18.41","start":19018041,"end":19018041,"break":"line","breaks":[[20,"line"],[34,"line"]],"ruby":[[0,1,"かれ"],[3,1,"たす"],[6,1,"さけ"],[8,1,"もと"],[13,1,"すく"],[15,1,"もの"],[20,1,"しゅ"],[26,1,"さけ"],[34,1,"かれ"],[37,1,"こた"]],"text":"彼らは助けを叫び求めたが、救う者はなく、主にむかって叫んだけれども、彼らに答えられなかったのです。"},{"ref":"Ps.18.42","start":19018042,"end":19018042,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"かれ"],[7,1,"かぜ"],[9,1,"まえ"],[17,1,"こま"],[20,1,"くだ"],[27,1,"どろ"],[32,1,"う"],[34,1,"す"]],"text":"わたしは彼らを風の前のちりのように細かに砕き、ちまたの泥のように打ち捨てました。"},{"ref":"Ps.18.43","start":19018043,"end":19018043,"break":"line","breaks":[[17,"line"],[39,"line"]],"ruby":[[4,1,"たみ"],[6,1,"あらそ"],[14,1,"すく"],[26,2,"くにたみ"],[43,1,"し"],[49,1,"たみ"],[55,1,"つか"]],"text":"あなたは民の争いからわたしを救い、わたしをもろもろの国民のかしらとされました。わたしの知らなかった民がわたしに仕えました。"},{"ref":"Ps.18.44","start":19018044,"end":19018044,"break":"line","breaks":[[24,"line"]],"ruby":[[0,1,"かれ"],[7,1,"こと"],[9,1,"き"],[21,1,"したが"],[24,2,"いほう"],[27,2,"ひとびと"]],"text":"彼らはわたしの事を聞くと、ただちにわたしに従い、異邦の人々はきて、わたしにへつらいました。"},{"ref":"Ps.18.45","start":19018045,"end":19018045,"break":"line","breaks":[[13,"line"]],"ruby":[[0,2,"いほう"],[3,2,"ひとびと"],[6,1,"う"],[15,1,"しろ"],[18,1,"ふる"],[23,1,"で"]],"text":"異邦の人々は打ちしおれて、その城から震えながら出てきました。"},{"ref":"Ps.18.46","start":19018046,"end":19018046,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[13,1,"いわ"],[24,1,"すくい"],[26,1,"かみ"]],"text":"主は生きておられます。わが岩はほむべきかな。わが救の神はあがむべきかな。"},{"ref":"Ps.18.47","start":19018047,"end":19018047,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[9,1,"むく"],[19,1,"たみ"],[28,1,"したが"]],"text":"神はわたしにあだを報いさせ、もろもろの民をわたしのもとに従わせ、"},{"ref":"Ps.18.48","start":19018048,"end":19018048,"break":"line","breaks":[[20,"line"],[37,"line"],[52,"line"]],"ruby":[[4,1,"てき"],[11,1,"すく"],[13,1,"だ"],[33,1,"さか"],[37,1,"おこ"],[41,1,"もの"],[43,1,"うえ"],[52,2,"ふほう"],[55,1,"ひと"],[62,1,"すく"],[64,1,"だ"]],"text":"わたしの敵からわたしを救い出されました。まことに、あなたはわたしに逆らって起りたつ者の上にわたしをあげ、不法の人からわたしを救い出されました。"},{"ref":"Ps.18.49","start":19018049,"end":19018049,"break":"line","breaks":[[8,"line"],[31,"line"]],"ruby":[[5,1,"しゅ"],[17,2,"くにたみ"],[36,1,"な"],[40,1,"うた"]],"text":"このゆえに主よ、わたしはもろもろの国民のなかであなたをたたえ、あなたのみ名をほめ歌います。"},{"ref":"Ps.18.50","start":19018050,"end":19018050,"break":"line","breaks":[[16,"line"],[38,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"おう"],[6,1,"おお"],[10,2,"しょうり"],[13,1,"あた"],[18,1,"あぶら"],[24,1,"もの"],[33,2,"しそん"],[49,1,"くわ"]],"text":"主はその王に大いなる勝利を与え、その油そそがれた者に、ダビデとその子孫とに、とこしえにいつくしみを加えられるでしょう。"}]