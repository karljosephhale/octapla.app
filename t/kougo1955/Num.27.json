[{"ref":"Num.27.1","start":4027001,"end":4027001,"break":"paragraph","ruby":[[7,1,"こ"],[12,2,"しぞく"],[22,1,"こ"],[30,1,"むすめ"],[34,1,"うった"],[49,1,"こ"],[60,1,"こ"],[70,1,"こ"],[77,1,"むすめ"],[81,1,"な"]],"text":"さて、ヨセフの子マナセの氏族のうちのヘペルの子、ゼロペハデの娘たちが訴えてきた。ヘペルはギレアデの子、ギレアデはマキルの子、マキルはマナセの子である。その娘たちは名をマアラ、ノア、ホグラ、ミルカ、テルザといったが、"},{"ref":"Num.27.2","start":4027002,"end":4027002,"break":"none","ruby":[[0,1,"かれ"],[3,2,"かいけん"],[6,2,"まくや"],[9,2,"いりぐち"],[17,2,"さいし"],[32,1,"ぜん"],[33,2,"かいしゅう"],[37,1,"まえ"],[39,1,"た"],[42,1,"い"]],"text":"彼らは会見の幕屋の入口でモーセと、祭司エレアザルと、つかさたちと全会衆との前に立って言った、"},{"ref":"Num.27.3","start":4027003,"end":4027003,"break":"none","ruby":[[7,1,"ちち"],[9,2,"あらの"],[12,1,"し"],[18,1,"かれ"],[24,2,"なかま"],[30,1,"しゅ"],[32,1,"さか"],[36,1,"もの"],[40,2,"なかま"],[47,1,"くわ"],[57,1,"かれ"],[59,2,"じぶん"],[62,1,"つみ"],[67,1,"し"],[75,1,"おとこ"],[77,1,"こ"]],"text":"「わたしたちの父は荒野で死にました。彼は、コラの仲間となって主に逆らった者どもの仲間のうちには加わりませんでした。彼は自分の罪によって死んだのですが、男の子がありませんでした。"},{"ref":"Num.27.4","start":4027004,"end":4027004,"break":"none","ruby":[[0,1,"おとこ"],[2,1,"こ"],[23,1,"ちち"],[25,1,"な"],[29,2,"しぞく"],[36,1,"けず"],[60,1,"ちち"],[62,2,"きょうだい"],[65,1,"おな"],[78,2,"しょゆう"],[80,1,"ち"],[82,1,"あた"]],"text":"男の子がないからといって、どうしてわたしたちの父の名がその氏族のうちから削られなければならないのでしょうか。わたしたちの父の兄弟と同じように、わたしたちにも所有地を与えてください」。"},{"ref":"Num.27.5","start":4027005,"end":4027005,"break":"paragraph","ruby":[[6,1,"こと"],[8,1,"しゅ"],[10,1,"まえ"],[12,1,"の"]],"text":"モーセがその事を主の前に述べると、"},{"ref":"Num.27.6","start":4027006,"end":4027006,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.27.7","start":4027007,"end":4027007,"break":"none","ruby":[[7,1,"むすめ"],[11,1,"い"],[16,1,"ただ"],[24,1,"かなら"],[26,1,"かれ"],[29,1,"ちち"],[31,2,"きょうだい"],[36,1,"おな"],[42,1,"かれ"],[46,1,"し"],[47,1,"ぎょう"],[49,2,"しょゆう"],[51,1,"ち"],[53,1,"あた"],[71,1,"ちち"],[73,1,"し"],[74,1,"ぎょう"],[76,1,"かれ"],[79,1,"わた"]],"text":"「ゼロペハデの娘たちの言うことは正しい。あなたは必ず彼らの父の兄弟たちと同じように、彼らにも嗣業の所有地を与えなければならない。すなわち、その父の嗣業を彼らに渡さなければならない。"},{"ref":"Num.27.8","start":4027008,"end":4027008,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"い"],[22,1,"ひと"],[24,1,"し"],[28,1,"おとこ"],[30,1,"こ"],[34,1,"とき"],[39,1,"し"],[40,1,"ぎょう"],[42,1,"むすめ"],[44,1,"わた"]],"text":"あなたはイスラエルの人々に言いなさい、『もし人が死んで、男の子がない時は、その嗣業を娘に渡さなければならない。"},{"ref":"Num.27.9","start":4027009,"end":4027009,"break":"none","ruby":[[4,1,"むすめ"],[8,1,"とき"],[13,1,"し"],[14,1,"ぎょう"],[16,2,"きょうだい"],[19,1,"あた"]],"text":"もしまた娘もない時は、その嗣業を兄弟に与えなければならない。"},{"ref":"Num.27.10","start":4027010,"end":4027010,"break":"none","ruby":[[2,2,"きょうだい"],[7,1,"とき"],[12,1,"し"],[13,1,"ぎょう"],[15,1,"ちち"],[17,2,"きょうだい"],[20,1,"あた"]],"text":"もし兄弟もない時は、その嗣業を父の兄弟に与えなければならない。"},{"ref":"Num.27.11","start":4027011,"end":4027011,"break":"none","ruby":[[4,1,"ちち"],[6,2,"きょうだい"],[11,1,"とき"],[16,2,"しぞく"],[22,1,"かれ"],[24,1,"もっと"],[26,1,"ちか"],[28,2,"しんぞく"],[33,1,"し"],[34,1,"ぎょう"],[36,1,"あた"],[39,2,"しょゆう"],[53,1,"しゅ"],[59,1,"めい"],[73,2,"ひとびと"],[84,1,"さだ"]],"text":"もしまた父に兄弟がない時は、その氏族のうちで彼に最も近い親族にその嗣業を与えて所有させなければならない』。主がモーセに命じられたようにイスラエルの人々は、これをおきての定めとしなければならない」。"},{"ref":"Num.27.12","start":4027012,"end":4027012,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[19,1,"やま"],[21,1,"のぼ"],[35,2,"ひとびと"],[38,1,"あた"],[41,1,"ち"],[43,1,"み"]],"text":"主はモーセに言われた、「このアバリムの山に登って、わたしがイスラエルの人々に与える地を見なさい。"},{"ref":"Num.27.13","start":4027013,"end":4027013,"break":"none","ruby":[[7,1,"み"],[12,2,"きょうだい"],[23,1,"たみ"],[25,1,"くわ"]],"text":"あなたはそれを見てから、兄弟アロンのようにその民に加えられるであろう。"},{"ref":"Num.27.14","start":4027014,"end":4027014,"break":"none","ruby":[[3,2,"かいしゅう"],[9,2,"あらの"],[12,1,"さか"],[15,1,"あらそ"],[18,1,"とき"],[30,1,"めい"],[38,1,"みず"],[45,1,"かれ"],[48,1,"め"],[50,1,"まえ"],[56,1,"せい"],[62,1,"あらわ"],[81,2,"あらの"],[94,1,"みず"]],"text":"これは会衆がチンの荒野で逆らい争った時、あなたがたはわたしの命にそむき、あの水のかたわらで彼らの目の前にわたしの聖なることを現さなかったからである」。これはチンの荒野にあるカデシのメリバの水である。"},{"ref":"Num.27.15","start":4027015,"end":4027015,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"い"]],"text":"モーセは主に言った、"},{"ref":"Num.27.16","start":4027016,"end":4027016,"break":"none","ruby":[[5,1,"にく"],[11,1,"いのち"],[13,1,"かみ"],[15,1,"しゅ"],[24,2,"かいしゅう"],[27,1,"うえ"],[33,1,"ひと"],[35,1,"た"]],"text":"「すべての肉なるものの命の神、主よ、どうぞ、この会衆の上にひとりの人を立て、"},{"ref":"Num.27.17","start":4027017,"end":4027017,"break":"none","ruby":[[0,1,"かれ"],[3,1,"まえ"],[5,2,"でい"],[10,1,"かれ"],[13,1,"みちび"],[15,1,"だ"],[18,1,"かれ"],[21,1,"みちび"],[23,1,"い"],[26,1,"もの"],[30,1,"しゅ"],[32,2,"かいしゅう"],[35,2,"ぼくしゃ"],[40,1,"ひつじ"]],"text":"彼らの前に出入りし、彼らを導き出し、彼らを導き入れる者とし、主の会衆を牧者のない羊のようにしないでください」。"},{"ref":"Num.27.18","start":4027018,"end":4027018,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"かみ"],[14,1,"れい"],[25,1,"こ"],[31,1,"えら"],[38,1,"て"],[42,1,"うえ"]],"text":"主はモーセに言われた、「神の霊のやどっているヌンの子ヨシュアを選び、あなたの手をその上におき、"},{"ref":"Num.27.19","start":4027019,"end":4027019,"break":"none","ruby":[[0,1,"かれ"],[2,2,"さいし"],[10,1,"ぜん"],[11,2,"かいしゅう"],[14,1,"まえ"],[16,1,"た"],[21,1,"かれ"],[24,1,"まえ"],[26,1,"しょく"],[28,1,"にん"]],"text":"彼を祭司エレアザルと全会衆の前に立たせて、彼らの前で職に任じなさい。"},{"ref":"Num.27.20","start":4027020,"end":4027020,"break":"none","ruby":[[3,1,"かれ"],[9,2,"けんい"],[12,1,"わ"],[14,1,"あた"],[23,2,"ひとびと"],[26,1,"ぜん"],[27,2,"かいしゅう"],[30,1,"かれ"],[32,1,"したが"]],"text":"そして彼にあなたの権威を分け与え、イスラエルの人々の全会衆を彼に従わせなさい。"},{"ref":"Num.27.21","start":4027021,"end":4027021,"break":"none","ruby":[[0,1,"かれ"],[2,2,"さいし"],[10,1,"まえ"],[12,1,"た"],[21,1,"かれ"],[34,1,"しゅ"],[36,1,"まえ"],[38,2,"はんだん"],[41,1,"もと"],[63,2,"ひとびと"],[66,1,"ぜん"],[67,2,"かいしゅう"],[77,2,"ことば"],[80,1,"したが"],[92,2,"ことば"],[95,1,"したが"]],"text":"彼は祭司エレアザルの前に立ち、エレアザルは彼のためにウリムをもって、主の前に判断を求めなければならない。ヨシュアとイスラエルの人々の全会衆とはエレアザルの言葉に従っていで、エレアザルの言葉に従ってはいらなければならない」。"},{"ref":"Num.27.22","start":4027022,"end":4027022,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"めい"],[24,1,"えら"],[28,2,"さいし"],[36,1,"ぜん"],[37,2,"かいしゅう"],[40,1,"まえ"],[42,1,"た"]],"text":"そこでモーセは主が命じられたようにし、ヨシュアを選んで、祭司エレアザルと全会衆の前に立たせ、"},{"ref":"Num.27.23","start":4027023,"end":4027023,"break":"none","ruby":[[0,1,"かれ"],[2,1,"うえ"],[4,1,"て"],[9,1,"しゅ"],[18,1,"かた"],[26,1,"かれ"],[28,2,"にんめい"]],"text":"彼の上に手をおき、主がモーセによって語られたとおりに彼を任命した。"}]