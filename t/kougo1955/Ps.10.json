[{"ref":"Ps.10.1","start":19010001,"end":19010001,"break":"paragraph","breaks":[[12,"line"],[21,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"とお"],[9,1,"はな"],[12,1,"た"],[25,1,"なや"],[28,1,"とき"],[30,1,"み"],[32,1,"かく"]],"text":"主よ、なにゆえ遠く離れて立たれるのですか。なにゆえ悩みの時に身を隠されるのですか。"},{"ref":"Ps.10.2","start":19010002,"end":19010002,"break":"line","breaks":[[22,"line"],[39,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"たか"],[9,1,"まず"],[12,1,"もの"],[14,1,"はげ"],[17,1,"せ"],[25,1,"かれ"],[30,1,"くわだ"],[43,1,"とら"]],"text":"悪しき者は高ぶって貧しい者を激しく責めます。どうぞ彼らがその企てたはかりごとにみずから捕えられますように。"},{"ref":"Ps.10.3","start":19010003,"end":19010003,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,2,"じぶん"],[8,1,"こころ"],[10,1,"ねが"],[13,1,"ほこ"],[20,1,"もの"],[22,1,"しゅ"],[30,1,"す"]],"text":"悪しき者は自分の心の願いを誇り、むさぼる者は主をのろい、かつ捨てる。"},{"ref":"Ps.10.4","start":19010004,"end":19010004,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"ほこ"],[7,1,"かお"],[12,1,"かみ"],[14,1,"もと"],[21,1,"おも"],[29,1,"かみ"]],"text":"悪しき者は誇り顔をして、神を求めない。その思いに、すべて「神はない」という。"},{"ref":"Ps.10.5","start":19010005,"end":19010005,"break":"line","breaks":[[9,"line"],[25,"line"]],"ruby":[[0,1,"かれ"],[2,1,"みち"],[4,1,"つね"],[6,1,"さか"],[17,1,"かれ"],[19,1,"はな"],[22,1,"たか"],[25,1,"かれ"],[36,2,"くちさき"],[39,1,"ふ"]],"text":"彼の道は常に栄え、あなたのさばきは彼を離れて高く、彼はそのすべてのあだを口先で吹く。"},{"ref":"Ps.10.6","start":19010006,"end":19010006,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"かれ"],[2,1,"こころ"],[4,1,"うち"],[6,1,"い"],[14,1,"うご"],[25,2,"よよ"]],"text":"彼は心の内に言う、「わたしは動かされることはなく、世々わざわいにあうことがない」と。"},{"ref":"Ps.10.7","start":19010007,"end":19010007,"break":"line","breaks":[[22,"line"]],"ruby":[[2,1,"くち"],[9,1,"あざむ"],[19,1,"み"],[24,1,"した"],[26,1,"した"],[29,2,"がいどく"],[32,2,"ふせい"]],"text":"その口はのろいと、欺きと、しえたげとに満ち、その舌の下には害毒と不正とがある。"},{"ref":"Ps.10.8","start":19010008,"end":19010008,"break":"line","breaks":[[12,"line"],[28,"line"]],"ruby":[[0,1,"かれ"],[2,2,"むらざと"],[5,1,"かく"],[7,1,"ば"],[12,1,"しの"],[17,1,"ところ"],[19,1,"つみ"],[23,1,"もの"],[25,1,"ころ"],[30,1,"め"],[32,1,"よ"],[37,1,"もの"]],"text":"彼は村里の隠れ場におり、忍びやかな所で罪のない者を殺す。その目は寄るべなき者をうかがい、"},{"ref":"Ps.10.9","start":19010009,"end":19010009,"break":"line","breaks":[[25,"line"],[43,"line"]],"ruby":[[0,1,"かく"],[2,1,"ば"],[18,1,"ま"],[20,1,"ぶ"],[25,1,"かれ"],[27,1,"まず"],[30,1,"もの"],[32,1,"とら"],[37,1,"ま"],[39,1,"ぶ"],[43,1,"まず"],[46,1,"もの"],[48,1,"あみ"],[55,1,"とら"]],"text":"隠れ場にひそむししのように、ひそかに待ち伏せする。彼は貧しい者を捕えようと待ち伏せし、貧しい者を網にひきいれて捕える。"},{"ref":"Ps.10.10","start":19010010,"end":19010010,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"よ"],[5,1,"もの"],[7,1,"かれ"],[9,1,"ちから"],[14,1,"う"],[21,1,"おとろ"],[24,1,"たお"]],"text":"寄るべなき者は彼の力によって打ちくじかれ、衰え、倒れる。"},{"ref":"Ps.10.11","start":19010011,"end":19010011,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[0,1,"かれ"],[2,1,"こころ"],[7,1,"い"],[11,1,"かみ"],[13,1,"わす"],[17,1,"かみ"],[21,1,"かお"],[23,1,"かく"],[27,1,"かみ"],[29,1,"た"],[32,1,"み"]],"text":"彼は心のうちに言う、「神は忘れた、神はその顔を隠した、神は絶えて見ることはなかろう」と。"},{"ref":"Ps.10.12","start":19010012,"end":19010012,"break":"line","breaks":[[14,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"た"],[14,1,"かみ"],[18,1,"て"],[28,1,"くる"],[31,1,"もの"],[33,1,"わす"]],"text":"主よ、立ちあがってください。神よ、み手をあげてください。苦しむ者を忘れないでください。"},{"ref":"Ps.10.13","start":19010013,"end":19010013,"break":"line","breaks":[[20,"line"]],"ruby":[[5,1,"あ"],[8,1,"もの"],[10,1,"かみ"],[12,1,"あなど"],[15,1,"こころ"],[37,1,"い"]],"text":"なにゆえ、悪しき者は神を侮り、心のうちに「あなたはとがめることをしない」と言うのですか。"},{"ref":"Ps.10.14","start":19010014,"end":19010014,"break":"line","breaks":[[21,"line"],[33,"line"],[54,"line"]],"ruby":[[10,1,"なや"],[13,1,"くる"],[18,1,"み"],[25,1,"て"],[27,1,"と"],[33,1,"よ"],[38,1,"もの"],[44,1,"み"],[66,1,"たす"]],"text":"あなたはみそなわし、悩みと苦しみとを見て、それをみ手に取られます。寄るべなき者はあなたに身をゆだねるのです。あなたはいつもみなしごを助けられました。"},{"ref":"Ps.10.15","start":19010015,"end":19010015,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,1,"あく"],[7,1,"おこな"],[9,1,"もの"],[11,1,"うで"],[13,1,"お"],[18,1,"あく"],[23,1,"のこ"],[30,1,"さぐ"],[32,1,"だ"]],"text":"悪しき者と悪を行う者の腕を折り、その悪を一つも残さないまでに探り出してください。"},{"ref":"Ps.10.16","start":19010016,"end":19010016,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"おう"],[21,2,"くにたみ"],[24,1,"ほろ"],[27,1,"しゅ"],[29,1,"くに"],[32,1,"あと"],[34,1,"た"]],"text":"主はとこしえに王でいらせられる。もろもろの国民は滅びて主の国から跡を断つでしょう。"},{"ref":"Ps.10.17","start":19010017,"end":19010017,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"にゅうわ"],[10,1,"もの"],[12,1,"ねが"],[15,1,"き"],[20,1,"こころ"],[22,1,"つよ"],[26,1,"みみ"],[28,1,"かたむ"]],"text":"主よ、あなたは柔和な者の願いを聞き、その心を強くし、耳を傾けて、"},{"ref":"Ps.10.18","start":19010018,"end":19010018,"break":"line","breaks":[[19,"line"],[29,"line"]],"ruby":[[13,1,"もの"],[23,1,"おこな"],[29,1,"ち"],[31,1,"ぞく"],[34,1,"ひと"],[36,1,"ふたた"],[38,1,"ひと"],[40,1,"おびや"]],"text":"みなしごと、しえたげられる者とのためにさばきを行われます。地に属する人は再び人を脅かすことはないでしょう。"}]