[{"ref":"Prov.30.1","start":20030001,"end":20030001,"break":"paragraph","breaks":[[16,"line"],[33,"line"]],"ruby":[[4,1,"ひと"],[8,1,"こ"],[13,2,"ことば"],[18,1,"ひと"],[25,1,"む"],[29,1,"い"],[48,1,"む"],[52,1,"い"]],"text":"マッサの人ヤケの子アグルの言葉。その人はイテエルに向かって言った、すなわちイテエルと、ウカルとに向かって言った、"},{"ref":"Prov.30.2","start":20030002,"end":20030002,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"たし"],[7,1,"ひと"],[11,1,"おろ"],[22,1,"ひと"],[24,1,"さと"]],"text":"わたしは確かに人よりも愚かであり、わたしには人の悟りがない。"},{"ref":"Prov.30.3","start":20030003,"end":20030003,"break":"line","breaks":[[19,"line"]],"ruby":[[6,2,"ちえ"],[22,1,"せい"],[25,1,"もの"],[27,1,"さと"]],"text":"わたしはまだ知恵をならうことができず、また、聖なる者を悟ることもできない。"},{"ref":"Prov.30.4","start":20030004,"end":20030004,"break":"line","breaks":[[20,"line"],[37,"line"],[51,"line"],[69,"line"],[85,"line"]],"ruby":[[0,1,"てん"],[8,1,"くだ"],[20,1,"かぜ"],[26,1,"なか"],[28,1,"あつ"],[37,1,"みず"],[39,2,"きもの"],[42,1,"つつ"],[51,1,"ち"],[57,2,"げんかい"],[60,1,"さだ"],[63,1,"もの"],[71,1,"な"],[73,1,"なに"],[78,1,"こ"],[80,1,"な"],[82,1,"なに"],[89,1,"たし"],[95,1,"し"]],"text":"天にのぼったり、下ったりしたのはだれか、風をこぶしの中に集めたのはだれか、水を着物に包んだのはだれか、地のすべての限界を定めた者はだれか、その名は何か、その子の名は何か、あなたは確かにそれを知っている。"},{"ref":"Prov.30.5","start":20030005,"end":20030005,"break":"stanza","breaks":[[13,"line"]],"ruby":[[0,1,"かみ"],[2,2,"ことば"],[7,2,"しんじつ"],[13,1,"かみ"],[15,1,"かれ"],[17,1,"よ"],[19,1,"たの"],[21,1,"もの"],[23,1,"たて"]],"text":"神の言葉はみな真実である、神は彼に寄り頼む者の盾である。"},{"ref":"Prov.30.6","start":20030006,"end":20030006,"break":"line","breaks":[[16,"line"]],"ruby":[[2,2,"ことば"],[5,1,"つ"],[7,1,"くわ"],[16,1,"かれ"],[22,1,"せ"],[29,1,"いつわ"],[31,1,"もの"]],"text":"その言葉に付け加えてはならない、彼があなたを責め、あなたを偽り者とされないためだ。"},{"ref":"Prov.30.7","start":20030007,"end":20030007,"break":"stanza","breaks":[[19,"line"]],"ruby":[[14,1,"もと"],[23,1,"し"]],"text":"わたしは二つのことをあなたに求めます、わたしの死なないうちに、これをかなえてください。"},{"ref":"Prov.30.8","start":20030008,"end":20030008,"break":"line","breaks":[[15,"line"],[30,"line"]],"ruby":[[3,1,"いつわ"],[11,1,"とお"],[15,1,"まず"],[24,1,"と"],[38,2,"しょくもつ"],[45,1,"やしな"]],"text":"うそ、偽りをわたしから遠ざけ、貧しくもなく、また富みもせず、ただなくてならぬ食物でわたしを養ってください。"},{"ref":"Prov.30.9","start":20030009,"end":20030009,"break":"line","breaks":[[18,"line"],[37,"line"],[48,"line"]],"ruby":[[0,1,"あ"],[2,1,"た"],[10,1,"し"],[19,1,"しゅ"],[27,1,"い"],[39,1,"まず"],[43,1,"ぬす"],[52,1,"かみ"],[54,1,"な"],[56,1,"よご"]],"text":"飽き足りて、あなたを知らないといい、「主とはだれか」と言うことのないため、また貧しくて盗みをし、わたしの神の名を汚すことのないためです。"},{"ref":"Prov.30.10","start":20030010,"end":20030010,"break":"stanza","breaks":[[18,"line"],[32,"line"],[48,"line"]],"ruby":[[14,2,"しゅじん"],[38,1,"かれ"],[52,1,"つみ"]],"text":"あなたは、しもべのことをその主人に、あしざまにいってはならない、そうでないと彼はあなたをのろい、あなたは罪をきせられる。"},{"ref":"Prov.30.11","start":20030011,"end":20030011,"break":"stanza","ruby":[[0,1,"よ"],[3,1,"ちち"],[11,1,"はは"],[13,2,"しゅくふく"],[18,1,"もの"]],"text":"世には父をのろったり、母を祝福しない者がある。"},{"ref":"Prov.30.12","start":20030012,"end":20030012,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"よ"],[3,2,"じぶん"],[6,1,"め"],[13,1,"きよ"],[15,1,"もの"],[24,1,"けが"],[27,1,"あら"]],"text":"世には自分の目にみずからを清い者として、なおその汚れを洗われないものがある。"},{"ref":"Prov.30.13","start":20030013,"end":20030013,"break":"line","breaks":[[17,"line"],[33,"line"]],"ruby":[[0,1,"よ"],[11,1,"ひと"],[22,1,"め"],[27,1,"たか"]],"text":"世にはまた、このような人がある――ああ、その目のいかに高きことよ、またそのまぶたのいかにつりあがっていることよ。"},{"ref":"Prov.30.14","start":20030014,"end":20030014,"break":"line","breaks":[[17,"line"],[29,"line"],[40,"line"]],"ruby":[[0,1,"よ"],[12,1,"は"],[17,1,"かたな"],[29,1,"まず"],[32,1,"もの"],[34,1,"ち"],[36,1,"うえ"],[40,1,"とぼ"],[43,1,"もの"],[45,1,"ひと"],[47,1,"なか"],[50,1,"く"],[52,1,"ほろ"]],"text":"世にはまたつるぎのような歯をもち、刀のようなきばをもって、貧しい者を地の上から、乏しい者を人の中から食い滅ぼすものがある。"},{"ref":"Prov.30.15","start":20030015,"end":20030015,"break":"stanza","breaks":[[12,"line"],[25,"line"],[42,"line"],[51,"line"]],"ruby":[[0,1,"ひる"],[6,1,"むすめ"],[13,1,"あた"],[17,1,"あた"],[25,1,"あ"],[30,1,"し"],[51,1,"みな"],[64,1,"い"]],"text":"蛭にふたりの娘があって、「与えよ、与えよ」という。飽くことを知らないものが三つある、いや、四つあって、皆「もう、たくさんです」と言わない。"},{"ref":"Prov.30.16","start":20030016,"end":20030016,"break":"line","breaks":[[19,"line"]],"ruby":[[4,2,"よみ"],[7,2,"ふにん"],[10,1,"たい"],[12,1,"みず"],[17,1,"ち"],[34,1,"ひ"]],"text":"すなわち陰府、不妊の胎、水にかわく地、「もう、たくさんだ」といわない火がそれである。"},{"ref":"Prov.30.17","start":20030017,"end":20030017,"break":"line","breaks":[[10,"line"],[27,"line"],[42,"line"]],"ruby":[[0,2,"じぶん"],[3,1,"ちち"],[10,1,"はは"],[12,1,"したが"],[16,1,"いや"],[24,1,"め"],[27,1,"たに"],[39,1,"だ"],[50,1,"た"]],"text":"自分の父をあざけり、母に従うのを卑しいこととする目は、谷のからすがこれをつつき出し、はげたかがこれを食べる。"},{"ref":"Prov.30.18","start":20030018,"end":20030018,"break":"stanza","breaks":[[23,"line"]],"ruby":[[7,3,"ふしぎ"],[37,1,"さと"]],"text":"わたしにとって不思議にたえないことが三つある、いや、四つあって、わたしには悟ることができない。"},{"ref":"Prov.30.19","start":20030019,"end":20030019,"break":"line","breaks":[[15,"line"],[26,"line"],[35,"line"]],"ruby":[[4,1,"そら"],[6,1,"と"],[13,1,"みち"],[15,1,"いわ"],[17,1,"うえ"],[19,1,"は"],[24,1,"みち"],[26,1,"うみ"],[31,1,"ふね"],[33,1,"みち"],[35,1,"おとこ"],[37,1,"おんな"],[41,1,"みち"]],"text":"すなわち空を飛ぶはげたかの道、岩の上を這うへびの道、海をはしる舟の道、男の女にあう道がそれである。"},{"ref":"Prov.30.20","start":20030020,"end":20030020,"break":"line","breaks":[[11,"line"],[27,"line"]],"ruby":[[0,2,"ゆうじょ"],[3,1,"みち"],[11,2,"かのじょ"],[14,1,"た"],[20,1,"くち"],[32,1,"なに"],[45,1,"い"]],"text":"遊女の道もまたそうだ、彼女は食べて、その口をぬぐって、「わたしは何もわるいことはしない」と言う。"},{"ref":"Prov.30.21","start":20030021,"end":20030021,"break":"stanza","breaks":[[14,"line"]],"ruby":[[0,1,"ち"],[11,1,"ふる"],[27,1,"た"]],"text":"地は三つのことによって震う、いや、四つのことによって、耐えることができない。"},{"ref":"Prov.30.22","start":20030022,"end":20030022,"break":"line","breaks":[[15,"line"]],"ruby":[[4,2,"どれい"],[8,1,"もの"],[10,1,"おう"],[15,1,"おろ"],[18,1,"もの"],[20,2,"しょくもつ"],[23,1,"あ"]],"text":"すなわち奴隷たる者が王となり、愚かな者が食物に飽き、"},{"ref":"Prov.30.23","start":20030023,"end":20030023,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"い"],[7,1,"おんな"],[9,1,"よめ"],[11,1,"い"],[19,1,"おんな"],[20,2,"しゅじん"]],"text":"忌みきらわれた女が嫁に行き、はしためが女主人のあとにすわることである。"},{"ref":"Prov.30.24","start":20030024,"end":20030024,"break":"stanza","breaks":[[14,"line"]],"ruby":[[2,2,"ちじょう"],[6,1,"ちい"],[14,2,"ひじょう"],[17,1,"かしこ"]],"text":"この地上に、小さいけれども、非常に賢いものが四つある。"},{"ref":"Prov.30.25","start":20030025,"end":20030025,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"ちから"],[7,2,"しゅるい"],[14,2,"しょくりょう"],[17,1,"なつ"],[22,1,"そな"]],"text":"ありは力のない種類だが、その食糧を夏のうちに備える。"},{"ref":"Prov.30.26","start":20030026,"end":20030026,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"いわ"],[5,1,"つよ"],[9,2,"しゅるい"],[16,1,"いえ"],[18,1,"いわ"]],"text":"岩だぬきは強くない種類だが、その家を岩につくる。"},{"ref":"Prov.30.27","start":20030027,"end":20030027,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"おう"],[15,1,"たい"],[17,1,"く"],[22,1,"た"]],"text":"いなごは王がないけれども、みな隊を組んでいで立つ。"},{"ref":"Prov.30.28","start":20030028,"end":20030028,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"て"],[15,1,"おう"],[17,2,"きゅうでん"]],"text":"やもりは手でつかまえられるが、王の宮殿におる。"},{"ref":"Prov.30.29","start":20030029,"end":20030029,"break":"stanza","breaks":[[16,"line"]],"ruby":[[0,1,"ある"],[5,2,"どうどう"],[9,1,"もの"],[27,2,"どうどう"],[30,1,"ある"]],"text":"歩きぶりの堂々たる者が三つある、いや、四つあって、みな堂々と歩く。"},{"ref":"Prov.30.30","start":20030030,"end":20030030,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"けもの"],[13,1,"つよ"],[16,1,"なに"],[20,1,"まえ"],[23,1,"しりぞ"]],"text":"すなわち獣のうちでもっとも強く、何ものの前にも退かない、しし、"},{"ref":"Prov.30.31","start":20030031,"end":20030031,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"お"],[2,1,"た"],[5,1,"ある"],[12,1,"お"],[18,1,"たみ"],[20,1,"まえ"],[26,1,"ある"],[28,1,"おう"]],"text":"尾を立てて歩くおんどり、雄やぎ、その民の前をいばって歩く王がそれである。"},{"ref":"Prov.30.32","start":20030032,"end":20030032,"break":"stanza","breaks":[[18,"line"],[32,"line"]],"ruby":[[6,1,"おろ"],[12,1,"みずか"],[14,1,"たか"],[22,2,"あくじ"],[25,1,"はか"],[36,1,"て"],[38,1,"くち"],[40,1,"あ"]],"text":"あなたがもし愚かであって自ら高ぶり、あるいは悪事を計ったならば、あなたの手を口に当てるがよい。"},{"ref":"Prov.30.33","start":20030033,"end":20030033,"break":"line","breaks":[[12,"line"],[23,"line"]],"ruby":[[0,1,"ちち"],[6,2,"ぎょうにゅう"],[9,1,"で"],[12,1,"はな"],[18,1,"ち"],[23,1,"いか"],[30,1,"あらそ"],[33,1,"おこ"]],"text":"乳をしめれば凝乳が出る、鼻をしめれば血がでる、怒りをしめれば争いが起る。"}]