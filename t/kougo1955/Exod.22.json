[{"ref":"Exod.22.1","start":2022001,"end":2022001,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"うし"],[8,1,"ひつじ"],[10,1,"ぬす"],[17,1,"ころ"],[27,1,"う"],[33,1,"かれ"],[36,1,"とう"],[38,1,"うし"],[44,1,"とう"],[46,1,"うし"],[53,1,"とう"],[55,1,"ひつじ"],[61,1,"とう"],[63,1,"ひつじ"],[68,1,"つぐな"]],"text":"もし人が牛または羊を盗んで、これを殺し、あるいはこれを売るならば、彼は一頭の牛のために五頭の牛をもって、一頭の羊のために四頭の羊をもって償わなければならない。"},{"ref":"Exod.22.2","start":2022002,"end":2022002,"break":"paragraph","ruby":[[2,1,"ぬす"],[6,1,"あな"],[16,1,"み"],[22,1,"う"],[25,1,"ころ"],[34,1,"ひと"],[37,1,"ち"],[39,1,"なが"],[42,1,"つみ"]],"text":"もし盗びとが穴をあけてはいるのを見て、これを撃って殺したときは、その人には血を流した罪はない。"},{"ref":"Exod.22.3","start":2022003,"end":2022003,"break":"none","ruby":[[3,1,"ひ"],[9,1,"のち"],[16,1,"ひと"],[18,1,"ち"],[20,1,"なが"],[23,1,"つみ"],[28,1,"かれ"],[30,1,"かなら"],[32,1,"つぐな"],[45,1,"かれ"],[47,1,"なに"],[51,1,"とき"],[54,1,"かれ"],[58,1,"ぬす"],[61,1,"もの"],[66,1,"み"],[68,1,"う"]],"text":"しかし日がのぼって後ならば、その人に血を流した罪がある。彼は必ず償わなければならない。もし彼に何もない時は、彼はその盗んだ物のために身を売られるであろう。"},{"ref":"Exod.22.4","start":2022004,"end":2022004,"break":"none","ruby":[[4,1,"ぬす"],[7,1,"もの"],[11,1,"い"],[15,1,"かれ"],[17,1,"て"],[28,1,"うし"],[33,1,"ひつじ"],[46,1,"ばい"],[50,1,"つぐな"]],"text":"もしその盗んだ物がなお生きて、彼の手もとにあれば、それは牛、ろば、羊のいずれにせよ、これを二倍にして償わなければならない。"},{"ref":"Exod.22.5","start":2022005,"end":2022005,"break":"paragraph","ruby":[[2,1,"ひと"],[4,1,"はたけ"],[11,1,"はたけ"],[16,1,"く"],[22,2,"かちく"],[25,1,"はな"],[28,2,"たにん"],[31,1,"はたけ"],[36,1,"く"],[40,1,"とき"],[43,2,"じぶん"],[46,1,"はたけ"],[48,1,"もっと"],[50,1,"よ"],[52,1,"もの"],[58,1,"はたけ"],[60,1,"もっと"],[62,1,"よ"],[64,1,"もの"],[73,1,"つぐな"]],"text":"もし人が畑またはぶどう畑のものを食わせ、その家畜を放って他人の畑のものを食わせた時は、自分の畑の最も良い物と、ぶどう畑の最も良い物をもって、これを償わなければならない。"},{"ref":"Exod.22.6","start":2022006,"end":2022006,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"で"],[11,1,"うつ"],[14,1,"つ"],[19,1,"むぎ"],[20,1,"たば"],[25,1,"た"],[26,1,"ほ"],[31,1,"はたけ"],[33,1,"や"],[42,1,"ひ"],[44,1,"も"],[48,1,"もの"],[51,1,"かなら"],[56,1,"つぐな"]],"text":"もし火が出て、いばらに移り、積みあげた麦束、または立穂、または畑を焼いたならば、その火を燃やした者は、必ずこれを償わなければならない。"},{"ref":"Exod.22.7","start":2022007,"end":2022007,"break":"paragraph","ruby":[[2,1,"ひと"],[4,2,"きんせん"],[9,2,"ぶっぴん"],[12,2,"ほかん"],[15,2,"りんじん"],[18,1,"たく"],[24,2,"りんじん"],[27,1,"いえ"],[30,1,"ぬす"],[34,1,"とき"],[38,1,"ぬす"],[42,1,"み"],[56,1,"ばい"],[60,1,"つぐな"]],"text":"もし人が金銭または物品の保管を隣人に託し、それが隣人の家から盗まれた時、その盗びとが見つけられたならば、これを二倍にして償わせなければならない。"},{"ref":"Exod.22.8","start":2022008,"end":2022008,"break":"none","ruby":[[2,1,"ぬす"],[6,1,"み"],[16,1,"いえ"],[18,2,"しゅじん"],[21,1,"かみ"],[23,1,"まえ"],[25,1,"つ"],[31,1,"かれ"],[33,2,"りんじん"],[36,1,"も"],[38,1,"もの"],[40,1,"て"],[51,1,"たし"]],"text":"もし盗びとが見つけられなければ、家の主人を神の前に連れてきて、彼が隣人の持ち物に手をかけたかどうかを、確かめなければならない。"},{"ref":"Exod.22.9","start":2022009,"end":2022009,"break":"paragraph","ruby":[[0,1,"うし"],[11,1,"ひつじ"],[16,2,"いふく"],[29,1,"うしな"],[32,1,"もの"],[43,1,"い"],[45,1,"あらそ"],[48,1,"おこ"],[60,1,"い"],[62,1,"もの"],[70,2,"そうほう"],[73,1,"い"],[75,1,"ぶん"],[78,1,"かみ"],[80,1,"まえ"],[82,1,"も"],[84,1,"だ"],[98,1,"かみ"],[100,2,"ゆうざい"],[103,1,"さだ"],[108,1,"もの"],[115,1,"ばい"],[121,2,"あいて"],[124,1,"つぐな"]],"text":"牛であれ、ろばであれ、羊であれ、衣服であれ、あるいはどんな失った物であれ、それについて言い争いが起り『これがそれです』と言う者があれば、その双方の言い分を、神の前に持ち出さなければならない。そして神が有罪と定められる者は、それを二倍にしてその相手に償わなければならない。"},{"ref":"Exod.22.10","start":2022010,"end":2022010,"break":"paragraph","ruby":[[2,1,"ひと"],[11,1,"うし"],[16,1,"ひつじ"],[24,2,"かちく"],[32,2,"りんじん"],[35,1,"あづ"],[42,1,"し"],[46,1,"きず"],[55,1,"うば"],[57,1,"さ"],[66,1,"み"],[68,1,"もの"]],"text":"もし人が、ろば、または牛、または羊、またはどんな家畜でも、それを隣人に預けて、それが死ぬか、傷つくか、あるいは奪い去られても、それを見た者がなければ、"},{"ref":"Exod.22.11","start":2022011,"end":2022011,"break":"none","ruby":[[0,2,"そうほう"],[3,1,"あいだ"],[6,2,"りんじん"],[9,1,"も"],[11,1,"もの"],[13,1,"て"],[24,1,"ちか"],[28,1,"しゅ"],[30,1,"まえ"],[50,1,"も"],[52,1,"ぬし"],[57,1,"う"],[59,1,"い"],[62,2,"りんじん"],[65,1,"つぐな"],[68,1,"およ"]],"text":"双方の間に、隣人の持ち物に手をかけなかったという誓いが、主の前になされなければならない。そうすれば、持ち主はこれを受け入れ、隣人は償うに及ばない。"},{"ref":"Exod.22.12","start":2022012,"end":2022012,"break":"none","ruby":[[12,2,"じぶん"],[15,1,"ところ"],[18,1,"ぬす"],[22,1,"とき"],[27,1,"も"],[29,1,"ぬし"],[31,1,"つぐな"]],"text":"けれども、それがまさしく自分の所から盗まれた時は、その持ち主に償わなければならない。"},{"ref":"Exod.22.13","start":2022013,"end":2022013,"break":"none","ruby":[[5,1,"さ"],[7,1,"ころ"],[11,1,"とき"],[17,2,"しょうこ"],[22,1,"も"],[25,1,"く"],[33,1,"さ"],[35,1,"ころ"],[42,1,"つぐな"],[45,1,"およ"]],"text":"もしそれが裂き殺された時は、それを証拠として持って来るならば、その裂き殺されたものは償うに及ばない。"},{"ref":"Exod.22.14","start":2022014,"end":2022014,"break":"paragraph","ruby":[[2,1,"ひと"],[4,2,"りんじん"],[8,2,"かちく"],[11,1,"か"],[18,1,"きず"],[25,1,"し"],[27,2,"ばあい"],[32,1,"も"],[34,1,"ぬし"],[39,1,"とも"],[44,1,"とき"],[47,1,"かなら"],[52,1,"つぐな"]],"text":"もし人が隣人から家畜を借りて、それが傷つき、または死ぬ場合、その持ち主がそれと共にいない時は、必ずこれを償わなければならない。"},{"ref":"Exod.22.15","start":2022015,"end":2022015,"break":"none","ruby":[[4,1,"も"],[6,1,"ぬし"],[11,1,"とも"],[20,1,"つぐな"],[23,1,"およ"],[33,2,"ちんが"],[46,1,"か"],[47,1,"ちん"],[52,1,"あ"]],"text":"もしその持ち主がそれと共におれば、それを償うに及ばない。もしそれが賃借りしたものならば、その借賃をそれに当てなければならない。"},{"ref":"Exod.22.16","start":2022016,"end":2022016,"break":"paragraph","ruby":[[2,1,"ひと"],[6,2,"こんやく"],[11,2,"しょじょ"],[14,1,"さそ"],[21,1,"ね"],[27,1,"かれ"],[29,1,"かなら"],[34,2,"はなよめ"],[36,1,"りょう"],[38,1,"はら"],[42,1,"つま"]],"text":"もし人がまだ婚約しない処女を誘って、これと寝たならば、彼は必ずこれに花嫁料を払って、妻としなければならない。"},{"ref":"Exod.22.17","start":2022017,"end":2022017,"break":"none","ruby":[[4,1,"ちち"],[11,1,"ひと"],[13,1,"あた"],[22,1,"こば"],[28,1,"かれ"],[30,2,"しょじょ"],[33,2,"はなよめ"],[35,1,"りょう"],[37,1,"あた"],[42,1,"かね"],[44,1,"はら"]],"text":"もしその父がこれをその人に与えることをかたく拒むならば、彼は処女の花嫁料に当るほどの金を払わなければならない。"},{"ref":"Exod.22.18","start":2022018,"end":2022018,"break":"paragraph","ruby":[[0,3,"まほうつかい"],[4,1,"おんな"],[10,1,"い"]],"text":"魔法使の女は、これを生かしておいてはならない。"},{"ref":"Exod.22.19","start":2022019,"end":2022019,"break":"paragraph","ruby":[[3,1,"けもの"],[5,1,"おか"],[7,1,"もの"],[10,1,"かなら"],[12,1,"ころ"]],"text":"すべて獣を犯す者は、必ず殺されなければならない。"},{"ref":"Exod.22.20","start":2022020,"end":2022020,"break":"paragraph","ruby":[[0,1,"しゅ"],[5,1,"た"],[7,2,"かみがみ"],[10,2,"ぎせい"],[17,1,"もの"],[20,1,"た"],[22,1,"ほろ"]],"text":"主のほか、他の神々に犠牲をささげる者は、断ち滅ぼされなければならない。"},{"ref":"Exod.22.21","start":2022021,"end":2022021,"break":"paragraph","ruby":[[4,2,"きりゅう"],[7,2,"たこく"],[9,1,"じん"],[11,1,"くる"],[53,1,"くに"],[56,2,"きりゅう"],[59,2,"たこく"],[61,1,"じん"]],"text":"あなたは寄留の他国人を苦しめてはならない。また、これをしえたげてはならない。あなたがたも、かつてエジプトの国で、寄留の他国人であったからである。"},{"ref":"Exod.22.22","start":2022022,"end":2022022,"break":"none","ruby":[[9,2,"かふ"],[15,2,"こじ"],[18,1,"なや"]],"text":"あなたがたはすべて寡婦、または孤児を悩ましてはならない。"},{"ref":"Exod.22.23","start":2022023,"end":2022023,"break":"none","ruby":[[6,1,"かれ"],[9,1,"なや"],[14,1,"かれ"],[25,1,"さけ"],[35,1,"かなら"],[39,1,"さけ"],[42,1,"き"]],"text":"もしあなたが彼らを悩まして、彼らがわたしにむかって叫ぶならば、わたしは必ずその叫びを聞くであろう。"},{"ref":"Exod.22.24","start":2022024,"end":2022024,"break":"none","ruby":[[7,1,"いか"],[10,1,"も"],[28,1,"ころ"],[41,1,"つま"],[43,2,"かふ"],[55,2,"こども"],[60,2,"こじ"]],"text":"そしてわたしの怒りは燃えたち、つるぎをもってあなたがたを殺すであろう。あなたがたの妻は寡婦となり、あなたがたの子供たちは孤児となるであろう。"},{"ref":"Exod.22.25","start":2022025,"end":2022025,"break":"paragraph","ruby":[[5,1,"とも"],[13,1,"たみ"],[15,1,"まず"],[18,1,"もの"],[20,1,"かね"],[22,1,"か"],[24,1,"とき"],[30,1,"たい"],[33,2,"かねか"],[53,2,"りし"],[56,1,"と"]],"text":"あなたが、共におるわたしの民の貧しい者に金を貸す時は、これに対して金貸しのようになってはならない。これから利子を取ってはならない。"},{"ref":"Exod.22.26","start":2022026,"end":2022026,"break":"none","ruby":[[2,2,"りんじん"],[5,2,"うわぎ"],[8,1,"しつ"],[10,1,"と"],[16,1,"ひ"],[18,1,"い"],[26,1,"かえ"]],"text":"もし隣人の上着を質に取るならば、日の入るまでにそれを返さなければならない。"},{"ref":"Exod.22.27","start":2022027,"end":2022027,"break":"none","ruby":[[3,1,"かれ"],[5,1,"み"],[16,1,"もの"],[18,1,"かれ"],[20,1,"はだ"],[25,2,"きもの"],[34,1,"かれ"],[36,1,"なに"],[38,1,"き"],[40,1,"ね"],[50,1,"かれ"],[60,1,"さけ"],[73,1,"き"],[88,1,"ふか"]],"text":"これは彼の身をおおう、ただ一つの物、彼の膚のための着物だからである。彼は何を着て寝ることができよう。彼がわたしにむかって叫ぶならば、わたしはこれに聞くであろう。わたしはあわれみ深いからである。"},{"ref":"Exod.22.28","start":2022028,"end":2022028,"break":"paragraph","ruby":[[4,1,"かみ"],[19,1,"たみ"],[21,1,"つかさ"]],"text":"あなたは神をののしってはならない。また民の司をのろってはならない。"},{"ref":"Exod.22.29","start":2022029,"end":2022029,"break":"paragraph","breaks":[[35,"paragraph"]],"ruby":[[4,1,"ゆた"],[7,2,"こくもつ"],[15,1,"さけ"]],"text":"あなたの豊かな穀物と、あふれる酒とをささげるに、ためらってはならない。あなたのういごを、わたしにささげなければならない。"},{"ref":"Exod.22.30","start":2022030,"end":2022030,"break":"none","ruby":[[11,1,"うし"],[13,1,"ひつじ"],[16,2,"どうよう"],[29,2,"なぬか"],[32,1,"あいだ"],[35,1,"はは"],[37,1,"とも"],[39,1,"お"],[44,1,"か"],[45,1,"め"]],"text":"あなたはまた、あなたの牛と羊をも同様にしなければならない。七日の間その母と共に置いて、八日目にそれをわたしに、ささげなければならない。"},{"ref":"Exod.22.31","start":2022031,"end":2022031,"break":"paragraph","ruby":[[11,1,"たい"],[14,1,"せい"],[17,1,"たみ"],[37,1,"の"],[39,1,"さ"],[41,1,"ころ"],[48,1,"にく"],[50,1,"た"],[62,1,"いぬ"],[64,1,"な"],[66,1,"あた"]],"text":"あなたがたは、わたしに対して聖なる民とならなければならない。あなたがたは、野で裂き殺されたものの肉を食べてはならない。それは犬に投げ与えなければならない。"}]