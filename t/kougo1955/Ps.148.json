[{"ref":"Ps.148.1","start":19148001,"end":19148001,"break":"paragraph","breaks":[[9,"line"],[26,"line"]],"ruby":[[0,1,"しゅ"],[14,1,"てん"],[17,1,"しゅ"],[31,1,"たか"],[33,1,"ところ"],[35,1,"しゅ"]],"text":"主をほめたたえよ。もろもろの天から主をほめたたえよ。もろもろの高き所で主をほめたたえよ。"},{"ref":"Ps.148.2","start":19148002,"end":19148002,"break":"line","breaks":[[17,"line"]],"ruby":[[2,2,"てんし"],[8,1,"しゅ"],[19,2,"ばんぐん"],[25,1,"しゅ"]],"text":"その天使よ、みな主をほめたたえよ。その万軍よ、みな主をほめたたえよ。"},{"ref":"Ps.148.3","start":19148003,"end":19148003,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"ひ"],[3,1,"つき"],[6,1,"しゅ"],[15,1,"かがや"],[17,1,"ほし"],[22,1,"しゅ"]],"text":"日よ、月よ、主をほめたたえよ。輝く星よ、みな主をほめたたえよ。"},{"ref":"Ps.148.4","start":19148004,"end":19148004,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"たか"],[4,1,"てん"],[7,1,"てん"],[9,1,"うえ"],[13,1,"みず"],[16,1,"しゅ"]],"text":"いと高き天よ、天の上にある水よ、主をほめたたえよ。"},{"ref":"Ps.148.5","start":19148005,"end":19148005,"break":"line","breaks":[[21,"line"]],"ruby":[[7,1,"しゅ"],[10,1,"な"],[25,1,"しゅ"],[27,1,"めい"],[33,1,"つく"]],"text":"これらのものに主のみ名をほめたたえさせよ、これらは主が命じられると造られたからである。"},{"ref":"Ps.148.6","start":19148006,"end":19148006,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[11,1,"かた"],[13,1,"さだ"],[16,1,"こ"],[28,1,"さかい"],[30,1,"さだ"]],"text":"主はこれらをとこしえに堅く定め、越えることのできないその境を定められた。"},{"ref":"Ps.148.7","start":19148007,"end":19148007,"break":"line","ruby":[[0,1,"うみ"],[2,1,"けもの"],[9,1,"ふち"],[12,1,"ち"],[15,1,"しゅ"]],"text":"海の獣よ、すべての淵よ、地から主をほめたたえよ。"},{"ref":"Ps.148.8","start":19148008,"end":19148008,"break":"line","ruby":[[0,1,"ひ"],[8,1,"ゆき"],[11,1,"しも"],[15,2,"ことば"],[18,1,"おこな"]],"text":"火よ、あられよ、雪よ、霜よ、み言葉を行うあらしよ、"},{"ref":"Ps.148.9","start":19148009,"end":19148009,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"やま"],[11,1,"おか"],[13,1,"み"],[15,1,"むす"],[17,1,"き"],[23,2,"こうはく"]],"text":"もろもろの山、すべての丘、実を結ぶ木、すべての香柏よ、"},{"ref":"Ps.148.10","start":19148010,"end":19148010,"break":"line","ruby":[[0,1,"の"],[2,1,"けもの"],[8,2,"かちく"],[11,1,"は"],[16,1,"つばさ"],[19,1,"とり"]],"text":"野の獣、すべての家畜、這うもの、翼ある鳥よ、"},{"ref":"Ps.148.11","start":19148011,"end":19148011,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"ち"],[2,1,"おう"],[10,1,"たみ"],[12,1,"きみ"],[16,1,"ち"]],"text":"地の王たち、すべての民、君たち、地のすべてのつかさよ、"},{"ref":"Ps.148.12","start":19148012,"end":19148012,"break":"line","ruby":[[0,1,"わか"],[2,2,"だんし"],[5,1,"わか"],[7,2,"じょし"],[10,1,"お"],[13,1,"ひと"],[15,1,"おさな"],[17,1,"もの"]],"text":"若い男子、若い女子、老いた人と幼い者よ、"},{"ref":"Ps.148.13","start":19148013,"end":19148013,"break":"line","breaks":[[19,"line"],[33,"line"]],"ruby":[[0,1,"かれ"],[5,1,"しゅ"],[8,1,"な"],[22,1,"な"],[24,1,"たか"],[35,2,"えいこう"],[38,1,"ち"],[40,1,"てん"],[42,1,"うえ"]],"text":"彼らをして主のみ名をほめたたえさせよ。そのみ名は高く、たぐいなく、その栄光は地と天の上にあるからである。"},{"ref":"Ps.148.14","start":19148014,"end":19148014,"break":"line","breaks":[[20,"line"],[39,"line"],[52,"line"],[64,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"たみ"],[12,1,"つの"],[27,2,"せいと"],[39,1,"しゅ"],[41,1,"ちか"],[49,2,"ひとびと"],[64,1,"しゅ"]],"text":"主はその民のために一つの角をあげられた。これはすべての聖徒のほめたたえるもの、主に近いイスラエルの人々のほめたたえるものである。主をほめたたえよ。"}]