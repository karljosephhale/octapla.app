[{"ref":"Ps.74.1","start":19074001,"end":19074001,"break":"paragraph","title":"アサフのマスキールの歌","breaks":[[25,"line"]],"ruby":[[0,1,"かみ"],[15,1,"す"],[32,1,"まき"],[34,1,"ひつじ"],[36,1,"いか"],[39,1,"も"]],"titleRuby":[[10,1,"うた"]],"text":"神よ、なぜ、われらをとこしえに捨てられるのですか。なぜ、あなたの牧の羊に怒りを燃やされるのですか。"},{"ref":"Ps.74.2","start":19074002,"end":19074002,"break":"line","breaks":[[19,"line"],[39,"line"],[58,"line"],[73,"line"]],"ruby":[[0,1,"むかし"],[5,1,"て"],[7,1,"い"],[16,2,"こうかい"],[28,1,"し"],[29,1,"ぎょう"],[31,2,"ぶぞく"],[48,1,"おも"],[50,1,"だ"],[62,1,"す"],[71,1,"やま"],[73,1,"おも"],[75,1,"だ"]],"text":"昔あなたが手に入れられたあなたの公会、すなわち、あなたの嗣業の部族となすためにあがなわれたものを思い出してください。あなたが住まわれたシオンの山を思い出してください。"},{"ref":"Ps.74.3","start":19074003,"end":19074003,"break":"line","breaks":[[25,"line"]],"ruby":[[5,1,"ほろ"],[8,1,"あと"],[15,1,"あし"],[17,1,"む"],[25,1,"てき"],[27,2,"せいじょ"],[35,1,"もの"],[37,2,"はかい"]],"text":"とこしえの滅びの跡に、あなたの足を向けてください。敵は聖所で、すべての物を破壊しました。"},{"ref":"Ps.74.4","start":19074004,"end":19074004,"break":"line","breaks":[[18,"line"]],"ruby":[[7,2,"せいじょ"],[10,1,"なか"],[18,1,"かれ"],[25,1,"た"]],"text":"あなたのあだは聖所の中でほえさけび、彼らのしるしを立てて、しるしとしました。"},{"ref":"Ps.74.5","start":19074005,"end":19074005,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かれ"],[3,1,"うえ"],[5,2,"いりぐち"],[16,1,"き"],[18,2,"こうし"],[20,1,"かき"],[22,1,"き"],[24,1,"たお"]],"text":"彼らは上の入口では、おのをもって木の格子垣を切り倒しました。"},{"ref":"Ps.74.6","start":19074006,"end":19074006,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"かれ"],[5,1,"て"],[9,1,"つち"],[15,2,"せいじょ"],[18,1,"ほ"],[20,1,"もの"],[27,1,"う"],[29,1,"おと"]],"text":"また彼らは手おのと鎚とをもって聖所の彫り物をことごとく打ち落しました。"},{"ref":"Ps.74.7","start":19074007,"end":19074007,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[7,2,"せいじょ"],[10,1,"ひ"],[16,1,"な"],[27,1,"ち"],[29,1,"たお"]],"text":"彼らはあなたの聖所に火をかけ、み名のすみかをけがして、地に倒しました。"},{"ref":"Ps.74.8","start":19074008,"end":19074008,"break":"line","breaks":[[14,"line"],[34,"line"]],"ruby":[[0,1,"かれ"],[3,1,"こころ"],[8,1,"い"],[27,1,"ほろ"],[34,1,"かれ"],[37,1,"くに"],[42,1,"かみ"],[44,2,"かいどう"],[52,1,"や"]],"text":"彼らは心のうちに言いました、「われらはことごとくこれを滅ぼそう」と。彼らは国のうちの神の会堂をことごとく焼きました。"},{"ref":"Ps.74.9","start":19074009,"end":19074009,"break":"line","breaks":[[18,"line"],[29,"line"],[50,"line"]],"ruby":[[4,2,"じぶん"],[13,1,"み"],[18,3,"よげんしゃ"],[22,1,"いま"],[36,1,"つづ"],[50,1,"し"],[52,1,"もの"]],"text":"われらは自分たちのしるしを見ません。預言者も今はいません。そしていつまで続くのか、われらのうちには、知る者がありません。"},{"ref":"Ps.74.10","start":19074010,"end":19074010,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かみ"],[20,1,"てき"],[31,1,"な"]],"text":"神よ、あだはいつまであざけるでしょうか。敵はとこしえにあなたの名をののしるでしょうか。"},{"ref":"Ps.74.11","start":19074011,"end":19074011,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[6,1,"て"],[8,1,"ひ"],[23,1,"みぎ"],[25,1,"て"],[32,1,"い"]],"text":"なぜあなたは手を引かれるのですか。なぜあなたは右の手をふところに入れておかれるのですか。"},{"ref":"Ps.74.12","start":19074012,"end":19074012,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[12,1,"おう"],[18,1,"すくい"],[20,1,"よ"],[22,1,"なか"],[24,1,"おこな"]],"text":"神はいにしえからわたしの王であって、救を世の中に行われた。"},{"ref":"Ps.74.13","start":19074013,"end":19074013,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"ちから"],[10,1,"うみ"],[16,1,"みず"],[18,1,"うえ"],[20,1,"りゅう"],[22,1,"あたま"],[24,1,"くだ"]],"text":"あなたはみ力をもって海をわかち、水の上の龍の頭を砕かれた。"},{"ref":"Ps.74.14","start":19074014,"end":19074014,"break":"line","breaks":[[16,"line"]],"ruby":[[10,1,"あたま"],[19,1,"の"],[21,1,"けもの"],[23,1,"あた"]],"text":"あなたはレビヤタンの頭をくだき、これを野の獣に与えてえじきとされた。"},{"ref":"Ps.74.15","start":19074015,"end":19074015,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"いずみ"],[6,1,"なが"],[10,1,"ひら"],[13,1,"た"],[16,1,"なが"],[24,1,"かわ"]],"text":"あなたは泉と流れとを開き、絶えず流れるもろもろの川をからされた。"},{"ref":"Ps.74.16","start":19074016,"end":19074016,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ひる"],[9,1,"よる"],[24,1,"ひかり"],[26,2,"たいよう"],[30,1,"もう"]],"text":"昼はあなたのもの、夜もまたあなたのもの。あなたは光と太陽とを設けられた。"},{"ref":"Ps.74.17","start":19074017,"end":19074017,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"ち"],[11,1,"さかい"],[13,1,"さだ"],[16,1,"なつ"],[18,1,"ふゆ"],[21,1,"つく"]],"text":"あなたは地のもろもろの境を定め、夏と冬とを造られた。"},{"ref":"Ps.74.18","start":19074018,"end":19074018,"break":"line","breaks":[[14,"line"],[33,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"てき"],[14,1,"おろ"],[17,1,"たみ"],[24,1,"な"],[35,1,"こと"],[37,1,"おも"],[39,1,"だ"]],"text":"主よ、敵はあなたをあざけり、愚かな民はあなたのみ名をののしります。この事を思い出してください。"},{"ref":"Ps.74.19","start":19074019,"end":19074019,"break":"line","breaks":[[12,"line"],[27,"line"]],"ruby":[[10,1,"たましい"],[12,1,"の"],[14,1,"けもの"],[27,1,"まず"],[30,1,"もの"],[41,1,"わす"]],"text":"どうかあなたのはとの魂を野の獣にわたさないでください。貧しい者のいのちをとこしえに忘れないでください。"},{"ref":"Ps.74.20","start":19074020,"end":19074020,"break":"line","breaks":[[17,"line"]],"ruby":[[4,2,"けいやく"],[17,1,"ち"],[19,1,"くら"],[21,1,"ところ"],[23,2,"ぼうりょく"],[30,1,"み"]],"text":"あなたの契約をかえりみてください。地の暗い所は暴力のすまいで満ちています。"},{"ref":"Ps.74.21","start":19074021,"end":19074021,"break":"line","breaks":[[21,"line"],[32,"line"]],"ruby":[[7,1,"もの"],[9,1,"は"],[21,1,"まず"],[24,1,"もの"],[26,1,"とぼ"],[29,1,"もの"],[33,1,"な"]],"text":"しえたげられる者を恥じさせないでください。貧しい者と乏しい者とにみ名をほめたたえさせてください。"},{"ref":"Ps.74.22","start":19074022,"end":19074022,"break":"line","breaks":[[19,"line"],[38,"line"]],"ruby":[[0,1,"かみ"],[3,1,"お"],[10,1,"うった"],[19,1,"おろ"],[22,1,"もの"]],"text":"神よ、起きてあなたの訴えをあげつらい、愚かな者のひねもすあなたをあざけるのをみこころにとめてください。"},{"ref":"Ps.74.23","start":19074023,"end":19074023,"break":"line","breaks":[[20,"line"],[35,"line"]],"ruby":[[7,1,"さけ"],[10,1,"わす"],[24,1,"てき"],[26,1,"た"],[32,1,"さわ"],[35,1,"わす"]],"text":"あなたのあだの叫びを忘れないでください。あなたの敵の絶えずあげる騒ぎを忘れないでください。"}]