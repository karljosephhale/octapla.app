[{"ref":"Ps.48.1","start":19048001,"end":19048001,"break":"paragraph","title":"コラの子の歌、さんび","breaks":[[12,"line"],[28,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おお"],[6,1,"かみ"],[16,1,"かみ"],[18,1,"みやこ"],[22,1,"せい"],[25,1,"やま"],[28,1,"おお"],[40,1,"かた"]],"titleRuby":[[3,1,"こ"],[5,1,"うた"]],"text":"主は大いなる神であって、われらの神の都、その聖なる山で、大いにほめたたえらるべき方である。"},{"ref":"Ps.48.2","start":19048002,"end":19048002,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"やま"],[6,1,"きた"],[8,1,"はし"],[10,1,"たか"],[20,1,"ぜん"],[21,1,"ち"],[23,1,"よろこ"],[29,1,"おお"],[33,1,"おう"],[35,1,"みやこ"]],"text":"シオンの山は北の端が高くて、うるわしく、全地の喜びであり、大いなる王の都である。"},{"ref":"Ps.48.3","start":19048003,"end":19048003,"break":"line","breaks":[[19,"line"]],"ruby":[[7,1,"との"],[12,1,"かみ"],[19,1,"たか"],[27,1,"あらわ"]],"text":"そのもろもろの殿のうちに神はみずからを高きやぐらとして現された。"},{"ref":"Ps.48.4","start":19048004,"end":19048004,"break":"line","ruby":[[0,1,"み"],[3,1,"おう"],[6,1,"あい"],[7,1,"かい"],[10,1,"とも"],[12,1,"すす"]],"text":"見よ、王らは相会して共に進んできたが、"},{"ref":"Ps.48.5","start":19048005,"end":19048005,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かれ"],[3,1,"みやこ"],[5,1,"み"],[8,1,"おどろ"],[19,1,"いそ"],[21,1,"に"],[23,1,"さ"]],"text":"彼らは都を見るや驚き、あわてふためき、急ぎ逃げ去った。"},{"ref":"Ps.48.6","start":19048006,"end":19048006,"break":"line","breaks":[[11,"line"]],"ruby":[[5,1,"かれ"],[8,1,"のぞ"],[13,1,"くる"],[17,1,"う"],[20,1,"くる"],[26,1,"おんな"]],"text":"おののきは彼らに臨み、その苦しみは産みの苦しみをする女のようであった。"},{"ref":"Ps.48.7","start":19048007,"end":19048007,"break":"line","ruby":[[4,2,"ひがしかぜ"],[7,1,"おこ"],[15,1,"ふね"],[17,1,"やぶ"]],"text":"あなたは東風を起してタルシシの舟を破られた。"},{"ref":"Ps.48.8","start":19048008,"end":19048008,"break":"line","breaks":[[14,"line"],[26,"line"],[46,"line"]],"ruby":[[7,1,"き"],[14,1,"いま"],[19,2,"ばんぐん"],[22,1,"しゅ"],[24,1,"みやこ"],[30,1,"かみ"],[32,1,"みやこ"],[37,1,"み"],[46,1,"かみ"],[55,1,"みやこ"],[57,1,"かた"]],"text":"さきにわれらが聞いたように、今われらは万軍の主の都、われらの神の都でこれを見ることができた。神はとこしえにこの都を堅くされる。〔セラ"},{"ref":"Ps.48.9","start":19048009,"end":19048009,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[11,1,"みや"],[26,1,"おも"]],"text":"神よ、われらはあなたの宮のうちであなたのいつくしみを思いました。"},{"ref":"Ps.48.10","start":19048010,"end":19048010,"break":"line","breaks":[[21,"line"],[33,"line"]],"ruby":[[0,1,"かみ"],[7,1,"ほまれ"],[15,1,"な"],[21,1,"ち"],[28,1,"およ"],[37,1,"みぎ"],[39,1,"て"],[41,2,"しょうり"],[44,1,"み"]],"text":"神よ、あなたの誉は、あなたのみ名のように、地のはてにまで及びます。あなたの右の手は勝利で満ちています。"},{"ref":"Ps.48.11","start":19048011,"end":19048011,"break":"line","breaks":[[12,"line"]],"ruby":[[16,1,"やま"],[18,1,"よろこ"],[25,1,"むすめ"],[27,1,"たの"]],"text":"あなたのさばきのゆえに、シオンの山を喜ばせ、ユダの娘を楽しませてください。"},{"ref":"Ps.48.12","start":19048012,"end":19048012,"break":"line","breaks":[[20,"line"]],"ruby":[[8,1,"ある"],[26,1,"かぞ"]],"text":"シオンのまわりを歩き、あまねくめぐって、そのやぐらを数え、"},{"ref":"Ps.48.13","start":19048013,"end":19048013,"break":"line","breaks":[[24,"line"]],"ruby":[[2,2,"じょうへき"],[5,1,"こころ"],[17,1,"との"],[33,1,"のち"],[35,1,"よ"],[37,1,"かた"],[39,1,"つた"]],"text":"その城壁に心をとめ、そのもろもろの殿をしらべよ。これはあなたがたが後の代に語り伝えるためである。"},{"ref":"Ps.48.14","start":19048014,"end":19048014,"break":"line","breaks":[[9,"line"],[26,"line"]],"ruby":[[4,1,"かみ"],[9,2,"よよ"],[20,1,"かみ"],[35,1,"みちび"]],"text":"これこそ神であり、世々かぎりなくわれらの神であって、とこしえにわれらを導かれるであろう。"}]