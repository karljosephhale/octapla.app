[{"ref":"Gen.35.1","start":1035001,"end":1035001,"break":"paragraph","ruby":[[3,1,"かみ"],[9,1,"い"],[19,1,"た"],[26,1,"のぼ"],[32,1,"す"],[43,1,"あに"],[48,1,"かお"],[50,1,"さ"],[57,1,"とき"],[63,1,"あらわ"],[66,1,"かみ"],[68,2,"さいだん"],[71,1,"つく"]],"text":"ときに神はヤコブに言われた、「あなたは立ってベテルに上り、そこに住んで、あなたがさきに兄エサウの顔を避けてのがれる時、あなたに現れた神に祭壇を造りなさい」。"},{"ref":"Gen.35.2","start":1035002,"end":1035002,"break":"none","ruby":[[7,2,"かぞく"],[12,1,"とも"],[20,1,"もの"],[22,1,"い"],[38,1,"こと"],[41,2,"かみがみ"],[44,1,"す"],[47,1,"み"],[49,1,"きよ"],[52,2,"きもの"],[55,2,"きが"]],"text":"ヤコブは、その家族および共にいるすべての者に言った、「あなたがたのうちにある異なる神々を捨て、身を清めて着物を着替えなさい。"},{"ref":"Gen.35.3","start":1035003,"end":1035003,"break":"none","ruby":[[5,1,"た"],[12,1,"のぼ"],[17,1,"ところ"],[23,2,"くなん"],[26,1,"ひ"],[42,1,"い"],[44,1,"みち"],[46,1,"とも"],[52,1,"かみ"],[54,2,"さいだん"],[57,1,"つく"]],"text":"われわれは立ってベテルに上り、その所でわたしの苦難の日にわたしにこたえ、かつわたしの行く道で共におられた神に祭壇を造ろう」。"},{"ref":"Gen.35.4","start":1035004,"end":1035004,"break":"none","ruby":[[3,1,"かれ"],[6,1,"も"],[11,1,"こと"],[14,2,"かみがみ"],[18,1,"みみ"],[25,2,"みみわ"],[37,1,"あた"],[65,1,"き"],[67,1,"した"],[69,1,"う"]],"text":"そこで彼らは持っている異なる神々と、耳につけている耳輪をことごとくヤコブに与えたので、ヤコブはこれをシケムのほとりにあるテレビンの木の下に埋めた。"},{"ref":"Gen.35.5","start":1035005,"end":1035005,"break":"paragraph","ruby":[[3,1,"かれ"],[9,1,"た"],[14,1,"おお"],[18,1,"おそ"],[21,2,"しゅうい"],[24,2,"まちまち"],[27,1,"た"],[37,1,"こ"],[43,1,"お"],[45,1,"もの"]],"text":"そして彼らは、いで立ったが、大いなる恐れが周囲の町々に起ったので、ヤコブの子らのあとを追う者はなかった。"},{"ref":"Gen.35.6","start":1035006,"end":1035006,"break":"none","ruby":[[8,1,"とも"],[16,2,"ひとびと"],[19,2,"いっしょ"],[26,1,"ち"]],"text":"こうしてヤコブは共にいたすべての人々と一緒にカナンの地にあるルズ、すなわちベテルにきた。"},{"ref":"Gen.35.7","start":1035007,"end":1035007,"break":"none","ruby":[[0,1,"かれ"],[5,2,"さいだん"],[8,1,"きず"],[13,1,"ところ"],[22,1,"な"],[27,1,"かれ"],[29,1,"あに"],[31,1,"かお"],[33,1,"さ"],[40,1,"とき"],[42,1,"かみ"],[47,1,"かれ"],[49,1,"あらわ"]],"text":"彼はそこに祭壇を築き、その所をエル・ベテルと名づけた。彼が兄の顔を避けてのがれる時、神がそこで彼に現れたからである。"},{"ref":"Gen.35.8","start":1035008,"end":1035008,"break":"none","ruby":[[0,1,"とき"],[12,1,"し"],[27,1,"き"],[29,1,"した"],[31,1,"ほうむ"],[44,1,"き"],[46,1,"な"],[56,1,"よ"]],"text":"時にリベカのうばデボラが死んで、ベテルのしもの、かしの木の下に葬られた。これによってその木の名をアロン・バクテと呼ばれた。"},{"ref":"Gen.35.9","start":1035009,"end":1035009,"break":"paragraph","ruby":[[14,1,"かえ"],[19,1,"とき"],[21,1,"かみ"],[23,1,"ふたた"],[25,1,"かれ"],[27,1,"あらわ"],[30,1,"かれ"],[32,2,"しゅくふく"]],"text":"さてヤコブがパダンアラムから帰ってきた時、神は再び彼に現れて彼を祝福された。"},{"ref":"Gen.35.10","start":1035010,"end":1035010,"break":"none","ruby":[[0,1,"かみ"],[2,1,"かれ"],[4,1,"い"],[14,1,"な"],[30,1,"な"],[39,1,"よ"],[52,1,"な"],[70,1,"かれ"],[78,1,"な"]],"text":"神は彼に言われた、「あなたの名はヤコブである。しかしあなたの名をもはやヤコブと呼んではならない。あなたの名をイスラエルとしなさい」。こうして彼をイスラエルと名づけられた。"},{"ref":"Gen.35.11","start":1035011,"end":1035011,"break":"none","breaks":[[11,"stanza"],[24,"line"],[38,"line"],[60,"line"]],"ruby":[[0,1,"かみ"],[4,1,"かれ"],[6,1,"い"],[16,2,"ぜんのう"],[19,1,"かみ"],[28,1,"う"],[41,2,"こくみん"],[46,1,"おお"],[49,2,"こくみん"],[57,1,"で"],[60,1,"おう"],[68,1,"み"],[71,1,"で"]],"text":"神はまた彼に言われた、「わたしは全能の神である。あなたは生めよ、またふえよ。一つの国民、また多くの国民があなたから出て、王たちがあなたの身から出るであろう。"},{"ref":"Gen.35.12","start":1035012,"end":1035012,"break":"line","breaks":[[21,"line"],[30,"line"]],"ruby":[[15,1,"あた"],[18,1,"ち"],[25,1,"あた"],[36,1,"のち"],[38,2,"しそん"],[43,1,"ち"],[45,1,"あた"]],"text":"わたしはアブラハムとイサクとに与えた地を、あなたに与えよう。またあなたの後の子孫にその地を与えよう」。"},{"ref":"Gen.35.13","start":1035013,"end":1035013,"break":"none","ruby":[[0,1,"かみ"],[2,1,"かれ"],[4,1,"かた"],[13,2,"ばしょ"],[17,1,"かれ"],[19,1,"はな"]],"text":"神は彼と語っておられたその場所から彼を離れてのぼられた。"},{"ref":"Gen.35.14","start":1035014,"end":1035014,"break":"none","ruby":[[7,1,"かみ"],[9,2,"じぶん"],[12,1,"かた"],[18,2,"ばしょ"],[23,1,"ぽん"],[25,1,"いし"],[27,1,"はしら"],[29,1,"た"],[34,1,"うえ"],[36,2,"かんさい"],[45,1,"あぶら"],[47,1,"そそ"]],"text":"そこでヤコブは神が自分と語られたその場所に、一本の石の柱を立て、その上に灌祭をささげ、また油を注いだ。"},{"ref":"Gen.35.15","start":1035015,"end":1035015,"break":"none","ruby":[[7,1,"かみ"],[9,2,"じぶん"],[12,1,"かた"],[18,2,"ばしょ"],[25,1,"な"]],"text":"そしてヤコブは神が自分と語られたその場所をベテルと名づけた。"},{"ref":"Gen.35.16","start":1035016,"end":1035016,"break":"paragraph","ruby":[[4,1,"かれ"],[11,1,"た"],[21,1,"い"],[23,1,"つ"],[31,1,"へだ"],[37,1,"ところ"],[43,2,"さんけ"],[50,1,"さん"],[52,1,"おも"]],"text":"こうして彼らはベテルを立ったが、エフラタに行き着くまでに、なお隔たりのある所でラケルは産気づき、その産は重かった。"},{"ref":"Gen.35.17","start":1035017,"end":1035017,"break":"none","ruby":[[2,2,"なんざん"],[5,1,"あた"],[9,2,"さんば"],[12,2,"かのじょ"],[15,1,"い"],[20,2,"しんぱい"],[33,2,"こんど"],[36,1,"おとこ"],[38,1,"こ"]],"text":"その難産に当って、産婆は彼女に言った、「心配することはありません。今度も男の子です」。"},{"ref":"Gen.35.18","start":1035018,"end":1035018,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"し"],[9,1,"たましい"],[11,1,"さ"],[17,1,"とき"],[19,1,"こ"],[21,1,"な"],[27,1,"よ"],[35,1,"ちち"],[46,1,"な"]],"text":"彼女は死にのぞみ、魂の去ろうとする時、子の名をベノニと呼んだ。しかし、父はこれをベニヤミンと名づけた。"},{"ref":"Gen.35.19","start":1035019,"end":1035019,"break":"none","ruby":[[4,1,"し"],[22,1,"みち"],[24,1,"ほうむ"]],"text":"ラケルは死んでエフラタ、すなわちベツレヘムの道に葬られた。"},{"ref":"Gen.35.20","start":1035020,"end":1035020,"break":"none","ruby":[[6,1,"はか"],[8,1,"はしら"],[10,1,"た"],[21,1,"はか"],[23,1,"はしら"],[29,2,"こんにち"],[32,1,"いた"]],"text":"ヤコブはその墓に柱を立てた。これはラケルの墓の柱であって、今日に至っている。"},{"ref":"Gen.35.21","start":1035021,"end":1035021,"break":"none","ruby":[[11,1,"た"],[23,1,"む"],[27,2,"てんまく"],[30,1,"は"]],"text":"イスラエルはまた、いで立ってミグダル・エダルの向こうに天幕を張った。"},{"ref":"Gen.35.22","start":1035022,"end":1035022,"break":"paragraph","breaks":[[57,"paragraph"]],"ruby":[[8,1,"ち"],[10,1,"す"],[15,1,"とき"],[21,1,"ちち"],[34,1,"い"],[41,1,"ね"],[53,1,"き"],[63,1,"こ"],[68,1,"にん"]],"text":"イスラエルがその地に住んでいた時、ルベンは父のそばめビルハのところへ行って、これと寝た。イスラエルはこれを聞いた。さてヤコブの子らは十二人であった。"},{"ref":"Gen.35.23","start":1035023,"end":1035023,"break":"none","ruby":[[7,1,"こ"],[14,2,"ちょうし"]],"text":"すなわちレアの子らはヤコブの長子ルベンとシメオン、レビ、ユダ、イッサカル、ゼブルン。"},{"ref":"Gen.35.24","start":1035024,"end":1035024,"break":"none","ruby":[[4,1,"こ"]],"text":"ラケルの子らはヨセフとベニヤミン。"},{"ref":"Gen.35.25","start":1035025,"end":1035025,"break":"none","ruby":[[12,1,"こ"]],"text":"ラケルのつかえめビルハの子らはダンとナフタリ。"},{"ref":"Gen.35.26","start":1035026,"end":1035026,"break":"none","ruby":[[11,1,"こ"],[29,1,"こ"],[43,1,"かれ"],[45,1,"うま"],[48,1,"もの"]],"text":"レアのつかえめジルパの子らはガドとアセル。これらはヤコブの子らであって、パダンアラムで彼に生れた者である。"},{"ref":"Gen.35.27","start":1035027,"end":1035027,"break":"paragraph","ruby":[[28,1,"ちち"],[36,1,"い"],[54,2,"きりゅう"],[58,1,"ところ"]],"text":"ヤコブはキリアテ・アルバ、すなわちヘブロンのマムレにいる父イサクのもとへ行った。ここはアブラハムとイサクとが寄留した所である。"},{"ref":"Gen.35.28","start":1035028,"end":1035028,"break":"none","ruby":[[4,1,"とし"],[9,1,"さい"]],"text":"イサクの年は百八十歳であった。"},{"ref":"Gen.35.29","start":1035029,"end":1035029,"break":"none","ruby":[[4,2,"としお"],[8,1,"ひ"],[9,1,"み"],[12,1,"いき"],[13,1,"た"],[16,1,"し"],[22,1,"たみ"],[24,1,"くわ"],[32,1,"こ"],[46,1,"ほうむ"]],"text":"イサクは年老い、日満ちて息絶え、死んで、その民に加えられた。その子エサウとヤコブとは、これを葬った。"}]