[{"ref":"2Kgs.13.1","start":12013001,"end":12013001,"break":"paragraph","ruby":[[3,1,"おう"],[9,1,"こ"],[14,1,"だい"],[18,1,"ねん"],[24,1,"こ"],[42,1,"おう"],[49,1,"ねん"],[50,1,"よ"],[52,1,"おさ"]],"text":"ユダの王アハジヤの子ヨアシの第二十三年にエヒウの子エホアハズはサマリヤでイスラエルの王となり、十七年世を治めた。"},{"ref":"2Kgs.13.2","start":12013002,"end":12013002,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[10,1,"おこな"],[19,1,"つみ"],[21,1,"おか"],[29,1,"こ"],[36,1,"つみ"],[38,1,"おこな"],[48,1,"はな"]],"text":"彼は主の目の前に悪を行い、イスラエルに罪を犯させたネバテの子ヤラベアムの罪を行いつづけて、それを離れなかった。"},{"ref":"2Kgs.13.3","start":12013003,"end":12013003,"break":"none","ruby":[[3,1,"しゅ"],[11,1,"たい"],[14,1,"いか"],[17,1,"はっ"],[26,2,"ちせい"],[29,1,"あいだ"],[31,1,"た"],[44,1,"おう"],[50,1,"て"],[63,1,"こ"],[70,1,"て"]],"text":"そこで主はイスラエルに対して怒りを発し、エホアハズの治世の間、絶えずイスラエルをスリヤの王ハザエルの手にわたし、またハザエルの子ベネハダデの手にわたされた。"},{"ref":"2Kgs.13.4","start":12013004,"end":12013004,"break":"none","ruby":[[9,1,"しゅ"],[11,1,"ねが"],[13,1,"もと"],[19,1,"しゅ"],[27,1,"き"],[39,1,"おう"],[44,1,"なや"],[55,1,"なや"],[58,1,"み"]],"text":"しかしエホアハズが主に願い求めたので、主はついにこれを聞きいれられた。スリヤの王によって悩まされたイスラエルの悩みを見られたからである。"},{"ref":"2Kgs.13.5","start":12013005,"end":12013005,"break":"none","ruby":[[3,1,"しゅ"],[9,3,"きゅうじょしゃ"],[19,1,"たま"],[32,2,"ひとびと"],[41,1,"て"],[47,1,"まえ"],[52,2,"じぶん"],[57,2,"てんまく"],[60,1,"す"]],"text":"それで主がひとりの救助者をイスラエルに賜わったので、イスラエルの人々はスリヤびとの手をのがれ、前のように自分たちの天幕に住むようになった。"},{"ref":"2Kgs.13.6","start":12013006,"end":12013006,"break":"none","ruby":[[10,1,"かれ"],[19,1,"つみ"],[21,1,"おか"],[31,1,"いえ"],[33,1,"つみ"],[35,1,"はな"],[42,1,"おこな"],[55,1,"ぞう"],[62,1,"た"]],"text":"それにもかかわらず、彼らはイスラエルに罪を犯させたヤラベアムの家の罪を離れず、それを行いつづけた。またアシラの像もサマリヤに立ったままであった。"},{"ref":"2Kgs.13.7","start":12013007,"end":12013007,"break":"none","ruby":[[7,1,"おう"],[9,1,"かれ"],[12,1,"ほろ"],[16,1,"ふ"],[18,1,"くだ"],[36,2,"ぐんぜい"],[39,1,"のこ"],[48,2,"きへい"],[52,1,"にん"],[54,2,"せんしゃ"],[57,1,"りょう"],[59,2,"ほへい"],[63,1,"にん"]],"text":"さきにスリヤの王が彼らを滅ぼし、踏み砕くちりのようにしたのでエホアハズの軍勢で残ったものは、ただ騎兵五十人、戦車十両、歩兵一万人のみであった。"},{"ref":"2Kgs.13.8","start":12013008,"end":12013008,"break":"none","ruby":[[7,1,"た"],[9,2,"じせき"],[13,1,"かれ"],[21,1,"こと"],[27,2,"ぶゆう"],[37,1,"おう"],[39,3,"れきだいし"],[43,1,"しょ"]],"text":"エホアハズその他の事績と、彼がしたすべての事およびその武勇は、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.13.9","start":12013009,"end":12013009,"break":"none","ruby":[[6,2,"せんぞ"],[11,1,"とも"],[13,1,"ねむ"],[19,1,"かれ"],[26,1,"ほうむ"],[32,1,"こ"],[37,1,"かわ"],[40,1,"おう"]],"text":"エホアハズは先祖たちと共に眠ったので、彼をサマリヤに葬った。その子ヨアシが代って王となった。"},{"ref":"2Kgs.13.10","start":12013010,"end":12013010,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"だい"],[12,1,"ねん"],[21,1,"こ"],[37,1,"おう"],[44,1,"ねん"],[45,1,"よ"],[47,1,"おさ"]],"text":"ユダの王ヨアシの第三十七年に、エホアハズの子ヨアシはサマリヤでイスラエルの王となり、十六年世を治めた。"},{"ref":"2Kgs.13.11","start":12013011,"end":12013011,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"め"],[6,1,"まえ"],[8,1,"あく"],[10,1,"おこな"],[19,1,"つみ"],[21,1,"おか"],[29,1,"こ"],[41,1,"つみ"],[43,1,"はな"],[50,1,"あゆ"]],"text":"彼は主の目の前に悪を行い、イスラエルに罪を犯させたネバテの子ヤラベアムのもろもろの罪を離れず、それに歩んだ。"},{"ref":"2Kgs.13.12","start":12013012,"end":12013012,"break":"none","ruby":[[6,1,"た"],[8,2,"じせき"],[12,1,"かれ"],[20,1,"こと"],[27,1,"おう"],[33,1,"たたか"],[38,2,"ぶゆう"],[48,1,"おう"],[50,3,"れきだいし"],[54,1,"しょ"]],"text":"ヨアシのその他の事績と、彼がしたすべての事およびユダの王アマジヤと戦ったその武勇は、イスラエルの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.13.13","start":12013013,"end":12013013,"break":"none","ruby":[[4,2,"せんぞ"],[9,1,"とも"],[11,1,"ねむ"],[23,1,"くらい"],[25,1,"ざ"],[42,1,"おう"],[46,1,"おな"],[54,1,"ほうむ"]],"text":"ヨアシは先祖たちと共に眠って、ヤラベアムがその位に座した。そしてヨアシはイスラエルの王たちと同じくサマリヤに葬られた。"},{"ref":"2Kgs.13.14","start":12013014,"end":12013014,"break":"paragraph","ruby":[[7,1,"し"],[9,2,"びょうき"],[26,1,"おう"],[31,1,"くだ"],[36,1,"かれ"],[38,1,"かお"],[40,1,"うえ"],[42,1,"なみだ"],[44,1,"なが"],[50,1,"ちち"],[55,1,"ちち"],[64,2,"せんしゃ"],[70,2,"きへい"],[75,1,"い"]],"text":"さてエリシャは死ぬ病気にかかっていたが、イスラエルの王ヨアシは下ってきて彼の顔の上に涙を流し、「わが父よ、わが父よ、イスラエルの戦車よ、その騎兵よ」と言った。"},{"ref":"2Kgs.13.15","start":12013015,"end":12013015,"break":"none","ruby":[[5,1,"かれ"],[8,1,"ゆみ"],[10,1,"や"],[12,1,"と"],[19,1,"い"],[25,1,"ゆみ"],[27,1,"や"],[29,1,"と"]],"text":"エリシャは彼に「弓と矢を取りなさい」と言ったので、弓と矢を取った。"},{"ref":"2Kgs.13.16","start":12013016,"end":12013016,"break":"none","ruby":[[13,1,"おう"],[16,1,"ゆみ"],[18,1,"て"],[27,1,"い"],[33,1,"て"],[47,2,"じぶん"],[50,1,"て"],[52,1,"おう"],[54,1,"て"],[56,1,"うえ"]],"text":"エリシャはまたイスラエルの王に「弓に手をかけなさい」と言ったので、手をかけた。するとエリシャは自分の手を王の手の上におき、"},{"ref":"2Kgs.13.17","start":12013017,"end":12013017,"break":"none","ruby":[[1,1,"ひがし"],[2,1,"む"],[5,1,"まど"],[14,1,"い"],[36,1,"い"],[42,1,"い"],[46,1,"かれ"],[48,1,"い"],[57,1,"い"],[62,1,"しゅ"],[64,1,"すくい"],[66,1,"や"],[72,1,"たい"],[75,1,"すくい"],[77,1,"や"],[93,1,"う"],[95,1,"やぶ"],[98,1,"かれ"],[101,1,"ほろ"]],"text":"「東向きの窓をあけなさい」と言ったので、それをあけると、エリシャはまた「射なさい」と言った。彼が射ると、エリシャは言った、「主の救の矢、スリヤに対する救の矢。あなたはアペクでスリヤびとを撃ち破り、彼らを滅ぼしつくすであろう」。"},{"ref":"2Kgs.13.18","start":12013018,"end":12013018,"break":"none","ruby":[[8,1,"や"],[10,1,"と"],[17,1,"い"],[26,1,"と"],[43,1,"おう"],[52,1,"ち"],[54,1,"い"],[60,1,"い"],[67,1,"ど"],[68,1,"い"]],"text":"エリシャはまた「矢を取りなさい」と言ったので、それを取った。エリシャはまたイスラエルの王に「それをもって地を射なさい」と言ったので、三度射てやめた。"},{"ref":"2Kgs.13.19","start":12013019,"end":12013019,"break":"none","ruby":[[3,1,"かみ"],[5,1,"ひと"],[7,1,"いか"],[10,1,"い"],[20,1,"ど"],[23,1,"ど"],[25,1,"い"],[50,1,"う"],[52,1,"やぶ"],[58,1,"ほろ"],[78,1,"いま"],[97,1,"う"],[99,1,"やぶ"],[107,1,"ど"]],"text":"すると神の人は怒って言った、「あなたは五度も六度も射るべきであった。そうしたならば、あなたはスリヤを撃ち破り、それを滅ぼしつくすことができたであろう。しかし今あなたはそうしなかったので、スリヤを撃ち破ることはただ三度だけであろう」。"},{"ref":"2Kgs.13.20","start":12013020,"end":12013020,"break":"paragraph","ruby":[[9,1,"し"],[12,1,"ほうむ"],[23,2,"りゃくだつ"],[25,1,"たい"],[27,1,"とし"],[29,1,"あらた"],[36,1,"くに"],[42,1,"く"],[46,1,"つね"]],"text":"こうしてエリシャは死んで葬られた。さてモアブの略奪隊は年が改まるごとに、国にはいって来るのを常とした。"},{"ref":"2Kgs.13.21","start":12013021,"end":12013021,"break":"none","ruby":[[0,1,"とき"],[7,1,"ひと"],[9,1,"ほうむ"],[15,1,"もの"],[22,2,"りゃくだつ"],[24,1,"たい"],[26,1,"み"],[33,1,"ひと"],[40,1,"はか"],[42,1,"な"],[44,1,"い"],[47,1,"さ"],[53,1,"ひと"],[60,1,"ほね"],[62,1,"ふ"],[68,1,"い"],[74,1,"た"]],"text":"時に、ひとりの人を葬ろうとする者があったが、略奪隊を見たので、その人をエリシャの墓に投げ入れて去った。その人はエリシャの骨に触れるとすぐ生きかえって立ちあがった。"},{"ref":"2Kgs.13.22","start":12013022,"end":12013022,"break":"paragraph","ruby":[[4,1,"おう"],[16,2,"いっしょう"],[19,1,"あいだ"],[27,1,"なや"]],"text":"スリヤの王ハザエルはエホアハズの一生の間、イスラエルを悩ましたが、"},{"ref":"2Kgs.13.23","start":12013023,"end":12013023,"break":"none","ruby":[[0,1,"しゅ"],[16,1,"むす"],[20,2,"けいやく"],[32,1,"めぐ"],[46,1,"かえり"],[49,1,"ほろ"],[55,1,"この"],[65,1,"まえ"],[68,1,"す"]],"text":"主はアブラハム、イサク、ヤコブと結ばれた契約のゆえにイスラエルを恵み、これをあわれみ、これを顧みて滅ぼすことを好まず、なおこれをみ前から捨てられなかった。"},{"ref":"2Kgs.13.24","start":12013024,"end":12013024,"break":"paragraph","ruby":[[4,1,"おう"],[13,1,"し"],[19,1,"こ"],[26,1,"かわ"],[29,1,"おう"]],"text":"スリヤの王ハザエルはついに死んで、その子ベネハダデが代って王となった。"},{"ref":"2Kgs.13.25","start":12013025,"end":12013025,"break":"none","ruby":[[9,1,"こ"],[15,1,"ちち"],[27,1,"せ"],[29,1,"と"],[33,2,"まちまち"],[42,1,"こ"],[49,1,"て"],[52,1,"と"],[54,1,"かえ"],[67,1,"ど"],[68,1,"かれ"],[70,1,"う"],[72,1,"やぶ"],[82,2,"まちまち"],[85,1,"と"],[87,1,"かえ"]],"text":"そこでエホアハズの子ヨアシは、父エホアハズがハザエルに攻め取られた町々を、ハザエルの子ベネハダデの手から取り返した。すなわちヨアシは三度彼を撃ち破って、イスラエルの町々を取り返した。"}]