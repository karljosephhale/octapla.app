[{"ref":"Deut.28.1","start":5028001,"end":5028001,"break":"paragraph","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[15,1,"こえ"],[19,1,"き"],[21,1,"したが"],[33,1,"めい"],[40,1,"いまし"],[43,1,"まも"],[45,1,"おこな"],[55,1,"かみ"],[57,1,"しゅ"],[63,1,"ち"],[70,2,"こくみん"],[73,1,"うえ"],[75,1,"た"]],"text":"もしあなたが、あなたの神、主の声によく聞き従い、わたしが、きょう、命じるすべての戒めを守り行うならば、あなたの神、主はあなたを地のもろもろの国民の上に立たせられるであろう。"},{"ref":"Deut.28.2","start":5028002,"end":5028002,"break":"none","ruby":[[11,1,"かみ"],[13,1,"しゅ"],[15,1,"こえ"],[17,1,"き"],[19,1,"したが"],[32,2,"しゅくふく"],[39,1,"のぞ"],[46,1,"およ"]],"text":"もし、あなたがあなたの神、主の声に聞き従うならば、このもろもろの祝福はあなたに臨み、あなたに及ぶであろう。"},{"ref":"Deut.28.3","start":5028003,"end":5028003,"break":"none","ruby":[[4,1,"まち"],[6,1,"うち"],[9,2,"しゅくふく"],[14,1,"はたけ"],[17,2,"しゅくふく"]],"text":"あなたは町の内でも祝福され、畑でも祝福されるであろう。"},{"ref":"Deut.28.4","start":5028004,"end":5028004,"break":"none","ruby":[[6,1,"み"],[9,1,"うま"],[15,1,"ち"],[17,1,"さん"],[20,1,"もの"],[22,2,"かちく"],[25,1,"う"],[34,1,"うし"],[36,1,"こ"],[38,1,"ひつじ"],[40,1,"こ"],[42,2,"しゅくふく"]],"text":"またあなたの身から生れるもの、地に産する物、家畜の産むもの、すなわち牛の子、羊の子は祝福されるであろう。"},{"ref":"Deut.28.5","start":5028005,"end":5028005,"break":"none","ruby":[[15,2,"しゅくふく"]],"text":"またあなたのかごと、こねばちは祝福されるであろう。"},{"ref":"Deut.28.6","start":5028006,"end":5028006,"break":"none","ruby":[[10,2,"しゅくふく"],[15,1,"で"],[19,2,"しゅくふく"]],"text":"あなたは、はいるにも祝福され、出るにも祝福されるであろう。"},{"ref":"Deut.28.7","start":5028007,"end":5028007,"break":"paragraph","ruby":[[0,1,"てき"],[2,1,"た"],[9,1,"せ"],[12,1,"とき"],[15,1,"しゅ"],[24,1,"う"],[26,1,"やぶ"],[37,1,"かれ"],[43,1,"みち"],[46,1,"せ"],[49,1,"く"],[57,1,"まえ"],[62,1,"みち"],[65,1,"に"],[67,1,"さ"]],"text":"敵が起ってあなたを攻める時は、主はあなたにそれを撃ち敗らせられるであろう。彼らは一つの道から攻めて来るが、あなたの前で七つの道から逃げ去るであろう。"},{"ref":"Deut.28.8","start":5028008,"end":5028008,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"めい"],[5,2,"しゅくふく"],[12,1,"くら"],[19,1,"て"],[36,1,"かみ"],[38,1,"しゅ"],[40,1,"たま"],[43,1,"ち"],[49,2,"しゅくふく"]],"text":"主は命じて祝福をあなたの倉と、あなたの手のすべてのわざにくだし、あなたの神、主が賜わる地であなたを祝福されるであろう。"},{"ref":"Deut.28.9","start":5028009,"end":5028009,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[11,1,"いまし"],[14,1,"まも"],[19,1,"みち"],[21,1,"あゆ"],[27,1,"しゅ"],[29,1,"ちか"],[40,1,"た"],[46,1,"せい"],[49,1,"たみ"]],"text":"もし、あなたの神、主の戒めを守り、その道を歩むならば、主は誓われたようにあなたを立てて、その聖なる民とされるであろう。"},{"ref":"Deut.28.10","start":5028010,"end":5028010,"break":"none","ruby":[[5,1,"ち"],[11,1,"たみ"],[13,1,"みな"],[18,1,"しゅ"],[20,1,"な"],[25,1,"とな"],[32,1,"み"],[38,1,"おそ"]],"text":"そうすれば地のすべての民は皆あなたが主の名をもって唱えられるのを見てあなたを恐れるであろう。"},{"ref":"Deut.28.11","start":5028011,"end":5028011,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"あた"],[10,2,"せんぞ"],[13,1,"ちか"],[17,1,"ち"],[20,1,"しゅ"],[22,1,"よ"],[24,1,"もの"],[34,1,"み"],[37,1,"うま"],[40,1,"もの"],[42,2,"かちく"],[45,1,"う"],[50,1,"ち"],[52,1,"さん"],[55,1,"もの"],[57,1,"ゆた"]],"text":"主があなたに与えると先祖に誓われた地で、主は良い物、すなわちあなたの身から生れる者、家畜の産むもの、地に産する物を豊かにされるであろう。"},{"ref":"Deut.28.12","start":5028012,"end":5028012,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"たから"],[6,1,"くら"],[10,1,"てん"],[19,1,"ひら"],[23,1,"あめ"],[25,2,"きせつ"],[37,1,"ち"],[39,1,"ふ"],[47,1,"て"],[56,2,"しゅくふく"],[70,1,"おお"],[73,2,"こくみん"],[76,1,"か"],[84,1,"か"]],"text":"主はその宝の蔵である天をあなたのために開いて、雨を季節にしたがってあなたの地に降らせ、あなたの手のすべてのわざを祝福されるであろう。あなたは多くの国民に貸すようになり、借りることはないであろう。"},{"ref":"Deut.28.13","start":5028013,"end":5028013,"break":"none","ruby":[[0,1,"しゅ"],[14,1,"お"],[35,1,"さか"],[38,1,"おとろ"],[59,1,"めい"],[66,1,"かみ"],[68,1,"しゅ"],[70,1,"いまし"],[73,1,"き"],[75,1,"したが"],[82,1,"まも"],[84,1,"おこな"],[94,1,"かなら"]],"text":"主はあなたをかしらとならせ、尾とはならせられないであろう。あなたはただ栄えて衰えることはないであろう。きょう、わたしが命じるあなたの神、主の戒めに聞き従って、これを守り行うならば、あなたは必ずこのようになるであろう。"},{"ref":"Deut.28.14","start":5028014,"end":5028014,"break":"none","ruby":[[8,1,"めい"],[17,2,"ことば"],[20,1,"はな"],[23,1,"みぎ"],[27,1,"ひだり"],[29,1,"まが"],[32,1,"た"],[34,2,"かみがみ"],[37,1,"したが"],[43,1,"つか"]],"text":"きょう、わたしが命じるこのすべての言葉を離れて右または左に曲り、他の神々に従い、それに仕えてはならない。"},{"ref":"Deut.28.15","start":5028015,"end":5028015,"break":"paragraph","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"こえ"],[14,1,"き"],[16,1,"したが"],[28,1,"めい"],[35,1,"いまし"],[38,1,"さだ"],[42,1,"まも"],[44,1,"おこな"],[67,1,"のぞ"],[74,1,"およ"]],"text":"しかし、あなたの神、主の声に聞き従わず、きょう、わたしが命じるすべての戒めと定めとを守り行わないならば、このもろもろののろいがあなたに臨み、あなたに及ぶであろう。"},{"ref":"Deut.28.16","start":5028016,"end":5028016,"break":"none","ruby":[[4,1,"まち"],[15,1,"はたけ"]],"text":"あなたは町のうちでものろわれ、畑でものろわれ、"},{"ref":"Deut.28.17","start":5028017,"end":5028017,"break":"none","text":"あなたのかごも、こねばちものろわれ、"},{"ref":"Deut.28.18","start":5028018,"end":5028018,"break":"none","ruby":[[4,1,"み"],[7,1,"うま"],[13,1,"ち"],[15,1,"さん"],[18,1,"もの"],[20,1,"うし"],[22,1,"こ"],[24,1,"ひつじ"],[26,1,"こ"]],"text":"あなたの身から生れるもの、地に産する物、牛の子、羊の子ものろわれるであろう。"},{"ref":"Deut.28.19","start":5028019,"end":5028019,"break":"none","ruby":[[15,1,"で"]],"text":"あなたは、はいるにものろわれ、出るにものろわれるであろう。"},{"ref":"Deut.28.20","start":5028020,"end":5028020,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"て"],[15,1,"はたら"],[23,2,"こんらん"],[27,1,"こら"],[32,1,"おく"],[43,1,"ほろ"],[53,1,"は"],[68,1,"あく"],[79,1,"す"]],"text":"主はあなたが手をくだすすべての働きにのろいと、混乱と、懲しめとを送られ、あなたはついに滅び、すみやかにうせ果てるであろう。これはあなたが悪をおこなってわたしを捨てたからである。"},{"ref":"Deut.28.21","start":5028021,"end":5028021,"break":"none","ruby":[[0,1,"しゅ"],[2,2,"えきびょう"],[9,1,"み"],[19,1,"い"],[22,1,"と"],[24,1,"ち"],[35,1,"た"],[37,1,"ほろ"]],"text":"主は疫病をあなたの身につかせ、あなたが行って取る地から、ついにあなたを断ち滅ぼされるであろう。"},{"ref":"Deut.28.22","start":5028022,"end":5028022,"break":"none","ruby":[[0,1,"しゅ"],[4,2,"はいびょう"],[7,2,"ねつびょう"],[10,2,"えんしょう"],[13,1,"あいだ"],[16,1,"ねつ"],[25,1,"た"],[27,1,"が"],[31,1,"くさ"],[33,1,"ほ"],[43,1,"う"],[63,1,"お"],[73,1,"ほろ"]],"text":"主はまた肺病と熱病と炎症と間けつ熱と、かんばつと、立ち枯れと、腐り穂とをもってあなたを撃たれるであろう。これらのものはあなたを追い、ついにあなたを滅ぼすであろう。"},{"ref":"Deut.28.23","start":5028023,"end":5028023,"break":"none","ruby":[[4,1,"あたま"],[6,1,"うえ"],[8,1,"てん"],[10,2,"せいどう"],[20,1,"した"],[22,1,"ち"],[24,1,"てつ"]],"text":"あなたの頭の上の天は青銅となり、あなたの下の地は鉄となるであろう。"},{"ref":"Deut.28.24","start":5028024,"end":5028024,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"ち"],[8,1,"あめ"],[19,1,"かわ"],[26,1,"てん"],[33,1,"うえ"],[47,1,"ほろ"]],"text":"主はあなたの地の雨を、ちりと、ほこりに変らせ、それが天からあなたの上にくだって、ついにあなたを滅ぼすであろう。"},{"ref":"Deut.28.25","start":5028025,"end":5028025,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"てき"],[8,1,"まえ"],[10,1,"やぶ"],[29,1,"みち"],[32,1,"かれ"],[35,1,"せ"],[38,1,"い"],[42,1,"かれ"],[45,1,"まえ"],[50,1,"みち"],[53,1,"に"],[55,1,"さ"],[69,1,"ち"],[76,1,"くに"],[78,1,"おそ"],[82,1,"み"]],"text":"主はあなたを敵の前で敗れさせられるであろう。あなたは一つの道から彼らを攻めて行くが、彼らの前で七つの道から逃げ去るであろう。そしてあなたは地のもろもろの国に恐るべき見せしめとなるであろう。"},{"ref":"Deut.28.26","start":5028026,"end":5028026,"break":"none","ruby":[[6,2,"したい"],[9,1,"そら"],[16,1,"とり"],[19,1,"ち"],[21,1,"けもの"],[37,1,"お"],[39,1,"はら"],[41,1,"もの"]],"text":"またあなたの死体は空のもろもろの鳥と、地の獣とのえじきとなり、しかもそれを追い払う者はないであろう。"},{"ref":"Deut.28.27","start":5028027,"end":5028027,"break":"none","ruby":[[0,1,"しゅ"],[7,2,"はれもの"],[10,2,"かいよう"],[13,3,"かいけつびょう"],[29,1,"う"]],"text":"主はエジプトの腫物と潰瘍と壊血病とひぜんとをもってあなたを撃たれ、あなたはいやされることはないであろう。"},{"ref":"Deut.28.28","start":5028028,"end":5028028,"break":"none","ruby":[[2,1,"しゅ"],[8,1,"う"],[11,1,"き"],[13,1,"くる"],[17,1,"め"],[19,1,"み"],[25,1,"こころ"],[27,2,"こんらん"]],"text":"また主はあなたを撃って気を狂わせ、目を見えなくし、心を混乱させられるであろう。"},{"ref":"Deut.28.29","start":5028029,"end":5028029,"break":"none","ruby":[[4,2,"もうじん"],[7,1,"くら"],[11,2,"てさぐ"],[20,2,"まひる"],[24,2,"てさぐ"],[38,1,"ゆ"],[40,1,"みち"],[42,1,"さか"],[53,1,"つね"],[76,1,"すく"],[78,1,"もの"]],"text":"あなたは盲人が暗やみに手探りするように、真昼にも手探りするであろう。あなたは行く道で栄えることがなく、ただ常にしえたげられ、かすめられるだけで、あなたを救う者はないであろう。"},{"ref":"Deut.28.30","start":5028030,"end":5028030,"break":"none","ruby":[[4,1,"つま"],[15,1,"ひと"],[17,2,"かのじょ"],[20,1,"ね"],[27,1,"いえ"],[29,1,"た"],[36,1,"なか"],[38,1,"す"],[50,1,"はたけ"],[52,1,"つく"],[59,1,"み"],[61,1,"つ"],[63,1,"と"]],"text":"あなたは妻をめとっても、ほかの人が彼女と寝るであろう。家を建てても、その中に住まないであろう。ぶどう畑を作っても、その実を摘み取ることがないであろう。"},{"ref":"Deut.28.31","start":5028031,"end":5028031,"break":"none","ruby":[[4,1,"うし"],[6,1,"め"],[8,1,"まえ"],[24,1,"た"],[41,1,"め"],[43,1,"まえ"],[45,1,"うば"],[51,1,"かえ"],[65,1,"ひつじ"],[67,1,"てき"],[80,1,"すく"],[87,1,"かえ"],[89,1,"もの"]],"text":"あなたの牛が目の前でほふられても、あなたはそれを食べることができず、あなたのろばが目の前で奪われても、返されないであろう。あなたの羊が敵のものになっても、それを救ってあなたに返す者はないであろう。"},{"ref":"Deut.28.32","start":5028032,"end":5028032,"break":"none","ruby":[[8,1,"むすめ"],[10,3,"たこくみん"],[24,1,"め"],[29,1,"み"],[31,2,"しゅうじつ"],[34,1,"かれ"],[37,1,"した"],[40,1,"おとろ"],[49,1,"て"],[51,1,"ほどこ"]],"text":"あなたのむすこや娘は他国民にわたされる。あなたの目はそれを見、終日、彼らを慕って衰えるが、あなたは手を施すすべもないであろう。"},{"ref":"Deut.28.33","start":5028033,"end":5028033,"break":"none","ruby":[[4,1,"ち"],[6,2,"さんぶつ"],[15,1,"ろう"],[18,1,"え"],[20,1,"もの"],[28,1,"し"],[32,1,"たみ"],[34,1,"た"],[49,1,"つね"],[58,1,"くる"]],"text":"あなたの地の産物およびあなたの労して獲た物はみなあなたの知らない民が食べるであろう。あなたは、ただ常にしえたげられ、苦しめられるのみであろう。"},{"ref":"Deut.28.34","start":5028034,"end":5028034,"break":"none","ruby":[[8,1,"め"],[10,1,"み"],[12,2,"ことがら"],[19,1,"き"],[21,1,"くる"]],"text":"こうしてあなたは目に見る事柄によって、気が狂うにいたるであろう。"},{"ref":"Deut.28.35","start":5028035,"end":5028035,"break":"none","ruby":[[0,1,"しゅ"],[14,1,"わる"],[20,1,"え"],[23,2,"はれもの"],[26,1,"しょう"],[32,1,"あし"],[34,1,"うら"],[37,1,"あたま"],[39,1,"いただき"],[43,1,"およ"]],"text":"主はあなたのひざと、はぎとに悪い、いやし得ない腫物を生じさせて、足の裏から頭の頂にまで及ぼされるであろう。"},{"ref":"Deut.28.36","start":5028036,"end":5028036,"break":"paragraph","ruby":[[0,1,"しゅ"],[10,1,"た"],[13,1,"おう"],[16,1,"たずさ"],[28,2,"せんぞ"],[31,1,"し"],[35,1,"くに"],[37,1,"うつ"],[53,1,"き"],[55,1,"いし"],[57,1,"つく"],[63,2,"かみがみ"],[66,1,"つか"]],"text":"主はあなたとあなたが立てた王とを携えて、あなたもあなたの先祖も知らない国に移されるであろう。あなたはそこで木や石で造ったほかの神々に仕えるであろう。"},{"ref":"Deut.28.37","start":5028037,"end":5028037,"break":"none","ruby":[[4,1,"しゅ"],[10,1,"お"],[21,1,"たみ"],[26,1,"おどろ"],[40,1,"わら"],[42,1,"ぐさ"]],"text":"あなたは主があなたを追いやられるもろもろの民のなかで驚きとなり、ことわざとなり、笑い草となるであろう。"},{"ref":"Deut.28.38","start":5028038,"end":5028038,"break":"none","ruby":[[4,1,"おお"],[7,1,"たね"],[9,1,"はたけ"],[11,1,"たずさ"],[14,1,"で"],[20,2,"しゅうかく"],[23,1,"すく"],[38,1,"く"]],"text":"あなたが多くの種を畑に携えて出ても、その収穫は少ないであろう。いなごがそれを食いつくすからである。"},{"ref":"Deut.28.39","start":5028039,"end":5028039,"break":"none","ruby":[[7,1,"はたけ"],[9,1,"つく"],[27,1,"しゅ"],[29,1,"の"],[40,1,"み"],[42,1,"あつ"],[55,1,"むし"],[60,1,"た"]],"text":"あなたがぶどう畑を作り、それにつちかっても、そのぶどう酒を飲むことができず、その実を集めることもないであろう。虫がそれを食べるからである。"},{"ref":"Deut.28.40","start":5028040,"end":5028040,"break":"none","ruby":[[4,1,"くに"],[15,1,"き"],[34,1,"あぶら"],[36,1,"み"],[38,1,"ぬ"],[54,1,"み"],[58,1,"お"]],"text":"あなたの国にはあまねくオリブの木があるであろう。しかし、あなたはその油を身に塗ることができないであろう。その実がみな落ちてしまうからである。"},{"ref":"Deut.28.41","start":5028041,"end":5028041,"break":"none","ruby":[[5,1,"むすめ"],[11,1,"うま"],[32,1,"かれ"],[35,1,"とら"],[40,1,"い"]],"text":"むすこや、娘があなたに生れても、あなたのものにならないであろう。彼らは捕えられて行くからである。"},{"ref":"Deut.28.42","start":5028042,"end":5028042,"break":"none","ruby":[[9,1,"き"],[14,1,"ち"],[16,2,"さんぶつ"],[24,1,"と"],[27,1,"た"]],"text":"あなたのもろもろの木、および地の産物は、いなごが取って食べるであろう。"},{"ref":"Deut.28.43","start":5028043,"end":5028043,"break":"none","ruby":[[7,2,"きりゅう"],[11,2,"たこく"],[13,1,"じん"],[20,1,"たか"],[29,1,"うえ"],[31,1,"で"],[42,1,"ひく"]],"text":"あなたのうちに寄留する他国人は、ますます高くなり、あなたの上に出て、あなたはますます低くなるであろう。"},{"ref":"Deut.28.44","start":5028044,"end":5028044,"break":"none","ruby":[[0,1,"かれ"],[6,1,"か"],[13,1,"かれ"],[15,1,"か"],[25,1,"かれ"],[38,1,"お"]],"text":"彼はあなたに貸し、あなたは彼に貸すことができない。彼はかしらとなり、あなたは尾となるであろう。"},{"ref":"Deut.28.45","start":5028045,"end":5028045,"break":"none","ruby":[[16,1,"のぞ"],[23,1,"お"],[29,1,"お"],[39,1,"ほろ"],[54,1,"かみ"],[56,1,"しゅ"],[58,1,"こえ"],[60,1,"き"],[62,1,"したが"],[70,1,"めい"],[75,1,"いまし"],[78,1,"さだ"],[87,1,"まも"]],"text":"このもろもろののろいが、あなたに臨み、あなたを追い、ついに追いついて、あなたを滅ぼすであろう。これはあなたの神、主の声に聞き従わず、あなたに命じられた戒めと定めとを、あなたが守らなかったからである。"},{"ref":"Deut.28.46","start":5028046,"end":5028046,"break":"none","ruby":[[4,1,"こと"],[6,1,"なが"],[16,2,"しそん"],[35,3,"ふしぎ"]],"text":"これらの事は長くあなたとあなたの子孫のうえにあって、しるしとなり、また不思議となるであろう。"},{"ref":"Deut.28.47","start":5028047,"end":5028047,"break":"paragraph","ruby":[[8,1,"もの"],[10,1,"ゆた"],[20,1,"かみ"],[22,1,"しゅ"],[24,1,"こころ"],[27,1,"よろこ"],[29,1,"たの"],[33,1,"つか"]],"text":"あなたがすべての物に豊かになり、あなたの神、主に心から喜び楽しんで仕えないので、"},{"ref":"Deut.28.48","start":5028048,"end":5028048,"break":"none","ruby":[[4,1,"う"],[11,1,"はだか"],[20,1,"もの"],[22,1,"とぼ"],[29,1,"しゅ"],[41,1,"てき"],[43,1,"つか"],[51,1,"てき"],[53,1,"てつ"],[76,1,"ほろ"]],"text":"あなたは飢え、かわき、裸になり、すべての物に乏しくなって、主があなたにつかわされる敵に仕えるであろう。敵は鉄のくびきをあなたのくびにかけ、ついにあなたを滅ぼすであろう。"},{"ref":"Deut.28.49","start":5028049,"end":5028049,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"とお"],[8,1,"ところ"],[12,1,"ち"],[21,1,"たみ"],[29,1,"と"],[42,1,"せ"],[65,2,"ことば"],[68,1,"し"],[72,1,"たみ"]],"text":"すなわち主は遠い所から、地のはてから一つの民を、はげたかが飛びかけるように、あなたに攻めきたらせられるであろう。これはあなたがその言葉を知らない民、"},{"ref":"Deut.28.50","start":5028050,"end":5028050,"break":"none","ruby":[[0,1,"かお"],[2,1,"おそ"],[6,1,"たみ"],[12,1,"かれ"],[15,2,"ろうじん"],[18,1,"み"],[20,1,"かえり"],[24,1,"おさな"],[26,1,"もの"]],"text":"顔の恐ろしい民であって、彼らは老人の身を顧みず、幼い者をあわれまず、"},{"ref":"Deut.28.51","start":5028051,"end":5028051,"break":"none","ruby":[[4,2,"かちく"],[7,1,"う"],[13,1,"ち"],[15,2,"さんぶつ"],[18,1,"く"],[26,1,"ほろ"],[30,2,"こくもつ"],[35,1,"さけ"],[39,1,"あぶら"],[43,1,"うし"],[45,1,"こ"],[49,1,"ひつじ"],[51,1,"こ"],[59,1,"ところ"],[61,1,"のこ"],[72,1,"まった"],[74,1,"ほろ"]],"text":"あなたの家畜が産むものや、地の産物を食って、あなたを滅ぼし、穀物をも、酒をも、油をも、牛の子をも、羊の子をも、あなたの所に残さず、ついにあなたを全く滅ぼすであろう。"},{"ref":"Deut.28.52","start":5028052,"end":5028052,"break":"none","ruby":[[2,1,"たみ"],[4,2,"ぜんこく"],[11,1,"まち"],[13,1,"せ"],[15,1,"かこ"],[25,1,"たの"],[31,2,"けんご"],[34,1,"たか"],[36,1,"いし"],[45,1,"う"],[55,1,"かみ"],[57,1,"しゅ"],[59,1,"たま"],[63,1,"くに"],[72,2,"まちまち"],[75,1,"せ"],[77,1,"かこ"]],"text":"その民は全国ですべての町を攻め囲み、ついにあなたが頼みとする、堅固な高い石がきをことごとく撃ちくずし、あなたの神、主が賜わった国のうちのすべての町々を攻め囲むであろう。"},{"ref":"Deut.28.53","start":5028053,"end":5028053,"break":"none","ruby":[[4,1,"てき"],[6,1,"かこ"],[10,1,"はげ"],[13,1,"せ"],[29,1,"かみ"],[31,1,"しゅ"],[33,1,"たま"],[41,1,"み"],[44,1,"うま"],[47,1,"もの"],[53,1,"むすめ"],[55,1,"にく"],[57,1,"た"],[61,1,"いた"]],"text":"あなたは敵に囲まれ、激しく攻めなやまされて、ついにあなたの神、主が賜わったあなたの身から生れた者、むすこ、娘の肉を食べるに至るであろう。"},{"ref":"Deut.28.54","start":5028054,"end":5028054,"break":"none","ruby":[[14,2,"おんわ"],[17,1,"おとこ"],[23,2,"じぶん"],[26,2,"きょうだい"],[29,2,"じぶん"],[37,1,"つま"],[39,2,"さいご"],[42,1,"のこ"],[47,2,"こども"],[51,2,"しょくもつ"],[54,1,"お"],[58,1,"あた"]],"text":"あなたがたのうちのやさしい、温和な男でさえも、自分の兄弟、自分のふところの妻、最後に残っている子供にも食物を惜しんで与えず、"},{"ref":"Deut.28.55","start":5028055,"end":5028055,"break":"none","ruby":[[0,2,"じぶん"],[3,2,"じぶん"],[6,2,"こども"],[9,1,"た"],[14,1,"にく"],[16,1,"すこ"],[23,2,"ひとびと"],[30,1,"あた"],[47,1,"てき"],[57,2,"まちまち"],[60,1,"かこ"],[63,1,"はげ"],[66,1,"せ"],[68,1,"なや"],[73,1,"なに"],[78,1,"ひと"],[80,1,"のこ"]],"text":"自分が自分の子供を食べ、その肉を少しでも、この人々のだれにも与えようとはしないであろう。これは敵があなたのすべての町々を囲み、激しく攻め悩まして、何をもその人に残さないからである。"},{"ref":"Deut.28.56","start":5028056,"end":5028056,"break":"none","ruby":[[16,2,"にゅうわ"],[19,1,"おんな"],[25,2,"にゅうわ"],[34,1,"あし"],[36,1,"うら"],[38,1,"つち"],[40,1,"つ"],[49,1,"もの"],[53,2,"じぶん"],[61,1,"おっと"],[68,1,"むすめ"]],"text":"またあなたがたのうちのやさしい、柔和な女、すなわち柔和で、やさしく、足の裏を土に付けようともしない者でも、自分のふところの夫や、むすこ、娘にもかくして、"},{"ref":"Deut.28.57","start":5028057,"end":5028057,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"あし"],[5,1,"あいだ"],[10,2,"ごさん"],[14,2,"じぶん"],[17,1,"う"],[19,1,"こ"],[25,1,"た"],[33,1,"てき"],[39,2,"まちまち"],[42,1,"かこ"],[45,1,"はげ"],[48,1,"せ"],[60,1,"もの"],[62,2,"けつぼう"]],"text":"自分の足の間からでる後産や、自分の産む子をひそかに食べるであろう。敵があなたの町々を囲み、激しく攻めなやまして、すべての物が欠乏するからである。"},{"ref":"Deut.28.58","start":5028058,"end":5028058,"break":"paragraph","ruby":[[9,2,"しょもつ"],[21,2,"りっぽう"],[28,2,"ことば"],[31,1,"まも"],[33,1,"おこな"],[41,1,"かみ"],[43,1,"しゅ"],[49,1,"さか"],[53,1,"おそ"],[57,1,"な"],[59,1,"おそ"]],"text":"もしあなたが、この書物にしるされているこの律法のすべての言葉を守り行わず、あなたの神、主というこの栄えある恐るべき名を恐れないならば、"},{"ref":"Deut.28.59","start":5028059,"end":5028059,"break":"none","ruby":[[0,1,"しゅ"],[8,2,"しそん"],[11,1,"うえ"],[13,1,"はげ"],[16,1,"わざわい"],[18,1,"くだ"],[29,1,"わざわい"],[38,1,"ひさ"],[44,2,"びょうき"],[47,1,"おも"],[52,1,"ひさ"]],"text":"主はあなたとその子孫の上に激しい災を下されるであろう。その災はきびしく、かつ久しく、その病気は重く、かつ久しいであろう。"},{"ref":"Deut.28.60","start":5028060,"end":5028060,"break":"none","ruby":[[0,1,"しゅ"],[9,1,"おそ"],[12,2,"びょうき"],[29,2,"びょうき"],[32,1,"ふたた"],[34,1,"のぞ"],[43,1,"み"]],"text":"主はまた、あなたが恐れた病気、すなわちエジプトのもろもろの病気を再び臨ませて、あなたの身につかせられるであろう。"},{"ref":"Deut.28.61","start":5028061,"end":5028061,"break":"none","ruby":[[4,2,"りっぽう"],[7,1,"しょ"],[19,2,"びょうき"],[28,1,"わざわい"],[32,1,"しゅ"],[38,1,"ほろ"],[48,1,"うえ"],[50,1,"くだ"]],"text":"またこの律法の書にのせてないもろもろの病気と、もろもろの災とを、主はあなたが滅びるまで、あなたの上に下されるであろう。"},{"ref":"Deut.28.62","start":5028062,"end":5028062,"break":"none","ruby":[[6,1,"てん"],[8,1,"ほし"],[13,1,"おお"],[23,1,"かみ"],[25,1,"しゅ"],[27,1,"こえ"],[29,1,"き"],[31,1,"したが"],[40,1,"のこ"],[42,1,"もの"],[44,1,"すく"]],"text":"あなたがたは天の星のように多かったが、あなたの神、主の声に聞き従わなかったから、残る者が少なくなるであろう。"},{"ref":"Deut.28.63","start":5028063,"end":5028063,"break":"none","ruby":[[3,1,"しゅ"],[11,1,"よ"],[24,1,"おお"],[30,1,"よろこ"],[38,1,"しゅ"],[40,1,"いま"],[47,1,"ほろ"],[50,1,"た"],[55,1,"よろこ"],[75,1,"と"],[77,1,"ち"],[80,1,"ぬ"],[82,1,"さ"]],"text":"さきに主があなたがたを良くあしらい、あなたがたを多くするのを喜ばれたように、主は今あなたがたを滅ぼし絶やすのを喜ばれるであろう。あなたがたは、はいって取る地から抜き去られるであろう。"},{"ref":"Deut.28.64","start":5028064,"end":5028064,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"ち"],[23,1,"たみ"],[34,1,"ち"],[46,1,"ところ"],[57,2,"せんぞ"],[62,1,"し"],[68,1,"き"],[70,1,"いし"],[72,1,"つく"],[78,2,"かみがみ"],[85,1,"つか"]],"text":"主は地のこのはてから、かのはてまでのもろもろの民のうちにあなたがたを散らされるであろう。その所で、あなたもあなたの先祖たちも知らなかった木や石で造ったほかの神々にあなたは仕えるであろう。"},{"ref":"Deut.28.65","start":5028065,"end":5028065,"break":"none","ruby":[[2,2,"くにぐに"],[5,1,"たみ"],[14,1,"やす"],[17,1,"え"],[22,1,"あし"],[24,1,"うら"],[26,1,"やす"],[29,1,"ところ"],[31,1,"え"],[41,1,"しゅ"],[45,1,"ところ"],[52,1,"こころ"],[60,1,"め"],[62,1,"おとろ"],[67,2,"せいしん"],[70,1,"う"]],"text":"その国々の民のうちであなたは安きを得ず、また足の裏を休める所も得られないであろう。主はその所で、あなたの心をおののかせ、目を衰えさせ、精神を打ちしおれさせられるであろう。"},{"ref":"Deut.28.66","start":5028066,"end":5028066,"break":"none","ruby":[[4,1,"いのち"],[6,1,"ほそ"],[8,1,"いと"],[22,2,"よるひる"],[24,1,"おそ"],[34,1,"いのち"],[42,1,"おも"]],"text":"あなたの命は細い糸にかかっているようになり、夜昼恐れおののいて、その命もおぼつかなく思うであろう。"},{"ref":"Deut.28.67","start":5028067,"end":5028067,"break":"none","ruby":[[4,1,"こころ"],[9,1,"おそ"],[13,1,"め"],[15,1,"み"],[24,1,"あさ"],[30,1,"ゆう"],[41,1,"い"],[44,1,"ゆう"],[50,1,"あさ"],[61,1,"い"]],"text":"あなたが心にいだく恐れと、目に見るものによって、朝には『ああ夕であればよいのに』と言い、夕には『ああ朝であればよいのに』と言うであろう。"},{"ref":"Deut.28.68","start":5028068,"end":5028068,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"ふね"],[8,1,"の"],[22,1,"つ"],[31,1,"ふたた"],[36,1,"み"],[45,1,"い"],[48,1,"みち"],[63,1,"つ"],[84,2,"だんじょ"],[87,2,"どれい"],[92,1,"てき"],[94,1,"う"],[103,1,"か"],[105,1,"もの"]],"text":"主はあなたを舟に乗せ、かつてわたしがあなたに告げて、『あなたは再びこれを見ることはない』と言った道によって、あなたをエジプトへ連れもどされるであろう。あなたがたはそこで男女の奴隷として敵に売られるが、だれも買う者はないであろう」。"}]