[{"ref":"Deut.18.1","start":5018001,"end":5018001,"break":"paragraph","ruby":[[7,2,"さいし"],[16,2,"ぜんぶ"],[18,1,"ぞく"],[30,1,"ぶん"],[32,1,"し"],[33,1,"ぎょう"],[35,1,"も"],[40,1,"かれ"],[43,1,"しゅ"],[51,2,"かさい"],[54,1,"もの"],[59,1,"た"],[64,1,"もの"],[67,1,"た"]],"text":"レビびとである祭司すなわちレビの全部族はイスラエルのうちに、分も嗣業も持たない。彼らは主にささげられる火祭の物と、その他のささげ物とを食べなければならない。"},{"ref":"Deut.18.2","start":5018002,"end":5018002,"break":"none","ruby":[[0,1,"かれ"],[5,2,"きょうだい"],[11,1,"し"],[12,1,"ぎょう"],[14,1,"も"],[22,1,"かれ"],[25,2,"やくそく"],[33,1,"しゅ"],[35,1,"かれ"],[38,1,"し"],[39,1,"ぎょう"]],"text":"彼らはその兄弟のうちに嗣業を持たない。かつて彼らに約束されたとおり主が彼らの嗣業である。"},{"ref":"Deut.18.3","start":5018003,"end":5018003,"break":"none","ruby":[[0,2,"さいし"],[3,1,"たみ"],[6,1,"う"],[9,1,"ぶん"],[11,1,"つぎ"],[24,2,"ぎせい"],[31,1,"もの"],[34,1,"うし"],[38,1,"ひつじ"],[44,1,"かた"],[47,2,"りょうほう"],[54,1,"い"],[57,2,"さいし"],[60,1,"あた"]],"text":"祭司が民から受ける分は次のとおりである。すなわち犠牲をささげる者は、牛でも、羊でも、その肩と、両方のほおと、胃とを祭司に与えなければならない。"},{"ref":"Deut.18.4","start":5018004,"end":5018004,"break":"none","ruby":[[2,2,"こくもつ"],[9,1,"しゅ"],[12,1,"あぶら"],[14,2,"はつもの"],[19,1,"ひつじ"],[21,1,"け"],[23,2,"はつもの"],[27,1,"かれ"],[29,1,"あた"]],"text":"また穀物と、ぶどう酒と、油の初物および羊の毛の初物をも彼に与えなければならない。"},{"ref":"Deut.18.5","start":5018005,"end":5018005,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[12,2,"ぶぞく"],[19,1,"かれ"],[21,1,"えら"],[23,1,"だ"],[27,1,"かれ"],[31,2,"しそん"],[34,1,"なが"],[36,1,"しゅ"],[38,1,"な"],[43,1,"た"],[46,1,"つか"]],"text":"あなたの神、主がすべての部族のうちから彼を選び出して、彼とその子孫を長く主の名によって立って仕えさせられるからである。"},{"ref":"Deut.18.6","start":5018006,"end":5018006,"break":"paragraph","ruby":[[11,1,"ぜん"],[12,1,"ち"],[22,1,"もの"],[26,1,"かれ"],[28,1,"やど"],[33,1,"まち"],[35,1,"で"],[38,1,"しゅ"],[40,1,"えら"],[44,2,"ばしょ"],[47,1,"い"]],"text":"レビびとはイスラエルの全地のうち、どこにいる者でも、彼が宿っている町を出て、主が選ばれる場所に行くならば、"},{"ref":"Deut.18.7","start":5018007,"end":5018007,"break":"none","ruby":[[0,1,"かれ"],[2,1,"しゅ"],[4,1,"まえ"],[6,1,"た"],[15,2,"きょうだい"],[22,1,"おな"],[30,1,"かみ"],[32,1,"しゅ"],[34,1,"な"],[39,1,"つか"]],"text":"彼は主の前に立っているすべての兄弟レビびとと同じように、その神、主の名によって仕えることができる。"},{"ref":"Deut.18.8","start":5018008,"end":5018008,"break":"none","ruby":[[0,1,"かれ"],[2,1,"た"],[5,1,"ぶん"],[7,1,"かれ"],[10,1,"おな"],[19,1,"かれ"],[26,1,"ちち"],[28,2,"いさん"],[31,1,"う"],[34,1,"え"],[36,1,"もの"],[38,1,"も"]],"text":"彼が食べる分は彼らと同じである。ただし彼はこのほかに父の遺産を売って獲た物を持つことができる。"},{"ref":"Deut.18.9","start":5018009,"end":5018009,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"たま"],[11,1,"ち"],[23,2,"くにぐに"],[26,1,"たみ"],[28,1,"にく"],[32,1,"こと"],[34,1,"なら"]],"text":"あなたの神、主が賜わる地にはいったならば、その国々の民の憎むべき事を習いおこなってはならない。"},{"ref":"Deut.18.10","start":5018010,"end":5018010,"break":"none","ruby":[[10,2,"じぶん"],[17,1,"むすめ"],[19,1,"ひ"],[21,1,"や"],[28,1,"もの"],[41,1,"うらな"],[46,1,"もの"],[48,2,"ぼくしゃ"],[51,2,"えきしゃ"],[54,3,"まほうつかい"]],"text":"あなたがたのうちに、自分のむすこ、娘を火に焼いてささげる者があってはならない。また占いをする者、卜者、易者、魔法使、"},{"ref":"Deut.18.11","start":5018011,"end":5018011,"break":"none","ruby":[[0,2,"じゅもん"],[3,1,"とな"],[6,1,"もの"],[8,2,"くちよ"],[17,2,"しにん"],[20,1,"と"],[27,1,"もの"]],"text":"呪文を唱える者、口寄せ、かんなぎ、死人に問うことをする者があってはならない。"},{"ref":"Deut.18.12","start":5018012,"end":5018012,"break":"none","ruby":[[0,1,"しゅ"],[9,1,"こと"],[13,1,"もの"],[15,1,"にく"],[32,1,"にく"],[36,1,"こと"],[45,1,"かみ"],[47,1,"しゅ"],[49,1,"かれ"],[56,1,"まえ"],[59,1,"お"],[61,1,"はら"]],"text":"主はすべてこれらの事をする者を憎まれるからである。そしてこれらの憎むべき事のゆえにあなたの神、主は彼らをあなたの前から追い払われるのである。"},{"ref":"Deut.18.13","start":5018013,"end":5018013,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[8,1,"まえ"],[14,1,"まった"],[16,1,"もの"]],"text":"あなたの神、主の前にあなたは全き者でなければならない。"},{"ref":"Deut.18.14","start":5018014,"end":5018014,"break":"none","ruby":[[4,1,"お"],[6,1,"はら"],[10,2,"くにぐに"],[13,1,"たみ"],[15,2,"ぼくしゃ"],[18,1,"うらな"],[23,1,"もの"],[25,1,"き"],[27,1,"したが"],[49,1,"かみ"],[51,1,"しゅ"],[57,1,"こと"],[59,1,"ゆる"]],"text":"あなたが追い払うかの国々の民は卜者、占いをする者に聞き従うからである。しかし、あなたには、あなたの神、主はそうする事を許されない。"},{"ref":"Deut.18.15","start":5018015,"end":5018015,"break":"paragraph","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[21,2,"どうほう"],[40,3,"よげんしゃ"],[51,1,"おこ"],[66,1,"かれ"],[68,1,"き"],[70,1,"したが"]],"text":"あなたの神、主はあなたのうちから、あなたの同胞のうちから、わたしのようなひとりの預言者をあなたのために起されるであろう。あなたがたは彼に聞き従わなければならない。"},{"ref":"Deut.18.16","start":5018016,"end":5018016,"break":"none","ruby":[[7,2,"しゅうかい"],[10,1,"ひ"],[20,1,"かみ"],[22,1,"しゅ"],[24,1,"もと"],[46,1,"し"],[60,1,"かみ"],[62,1,"しゅ"],[64,1,"こえ"],[67,1,"ど"],[73,1,"き"],[88,1,"おお"],[92,1,"ひ"],[95,1,"ど"],[97,1,"み"],[109,1,"い"]],"text":"これはあなたが集会の日にホレブであなたの神、主に求めたことである。すなわちあなたは『わたしが死ぬことのないようにわたしの神、主の声を二度とわたしに聞かせないでください。またこの大いなる火を二度と見させないでください』と言った。"},{"ref":"Deut.18.17","start":5018017,"end":5018017,"break":"none","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"かれ"],[15,1,"い"],[21,1,"ただ"]],"text":"主はわたしに言われた、『彼らが言ったことは正しい。"},{"ref":"Deut.18.18","start":5018018,"end":5018018,"break":"none","ruby":[[4,1,"かれ"],[7,2,"どうほう"],[26,3,"よげんしゃ"],[30,1,"かれ"],[36,1,"おこ"],[44,2,"ことば"],[49,1,"くち"],[51,1,"さづ"],[56,1,"かれ"],[62,1,"めい"],[74,1,"かれ"],[77,1,"つ"]],"text":"わたしは彼らの同胞のうちから、おまえのようなひとりの預言者を彼らのために起して、わたしの言葉をその口に授けよう。彼はわたしが命じることを、ことごとく彼らに告げるであろう。"},{"ref":"Deut.18.19","start":5018019,"end":5018019,"break":"none","ruby":[[0,1,"かれ"],[6,1,"な"],[16,2,"ことば"],[19,1,"かた"],[29,1,"き"],[31,1,"したが"],[35,1,"もの"],[50,1,"ばっ"]],"text":"彼がわたしの名によって、わたしの言葉を語るのに、もしこれに聞き従わない者があるならば、わたしはそれを罰するであろう。"},{"ref":"Deut.18.20","start":5018020,"end":5018020,"break":"none","ruby":[[3,3,"よげんしゃ"],[12,1,"かた"],[15,1,"めい"],[27,1,"な"],[38,1,"かた"],[45,1,"た"],[47,2,"かみがみ"],[50,1,"な"],[55,1,"かた"],[63,3,"よげんしゃ"],[67,1,"ころ"]],"text":"ただし預言者が、わたしが語れと命じないことを、わたしの名によってほしいままに語り、あるいは他の神々の名によって語るならば、その預言者は殺さなければならない』。"},{"ref":"Deut.18.21","start":5018021,"end":5018021,"break":"none","ruby":[[4,1,"こころ"],[18,2,"ことば"],[21,1,"しゅ"],[23,1,"い"],[38,1,"し"],[40,1,"え"],[46,1,"い"]],"text":"あなたは心のうちに『われわれは、その言葉が主の言われたものでないと、どうして知り得ようか』と言うであろう。"},{"ref":"Deut.18.22","start":5018022,"end":5018022,"break":"none","ruby":[[2,3,"よげんしゃ"],[10,1,"しゅ"],[12,1,"な"],[17,1,"かた"],[24,2,"ことば"],[27,2,"じょうじゅ"],[36,1,"こと"],[38,1,"おこ"],[42,1,"とき"],[48,1,"しゅ"],[50,1,"かた"],[54,2,"ことば"],[63,3,"よげんしゃ"],[73,1,"かた"],[83,3,"よげんしゃ"],[87,1,"おそ"],[91,1,"およ"]],"text":"もし預言者があって、主の名によって語っても、その言葉が成就せず、またその事が起らない時は、それは主が語られた言葉ではなく、その預言者がほしいままに語ったのである。その預言者を恐れるに及ばない。"}]