[{"ref":"1Tim.2.1","start":54002001,"end":54002001,"break":"paragraph","ruby":[[6,1,"だい"],[9,1,"すす"],[17,1,"ひと"],[23,1,"おう"],[27,1,"うえ"],[29,1,"た"],[38,2,"ひとびと"],[45,1,"ねが"],[49,1,"いのり"],[58,2,"かんしゃ"]],"text":"そこで、まず第一に勧める。すべての人のために、王たちと上に立っているすべての人々のために、願いと、祈と、とりなしと、感謝とをささげなさい。"},{"ref":"1Tim.2.2","start":54002002,"end":54002002,"break":"none","ruby":[[10,1,"やす"],[14,1,"しず"],[17,2,"いっしょう"],[21,1,"しん"],[23,2,"しんじん"],[25,1,"ぶか"],[29,2,"きんげん"],[32,1,"す"]],"text":"それはわたしたちが、安らかで静かな一生を、真に信心深くまた謹厳に過ごすためである。"},{"ref":"1Tim.2.3","start":54002003,"end":54002003,"break":"none","ruby":[[10,2,"すくいぬし"],[15,1,"かみ"],[21,1,"よ"]],"text":"これは、わたしたちの救主である神のみまえに良いことであり、また、みこころにかなうことである。"},{"ref":"1Tim.2.4","start":54002004,"end":54002004,"break":"none","ruby":[[0,1,"かみ"],[7,1,"ひと"],[9,1,"すく"],[14,2,"しんり"],[17,1,"さと"],[20,1,"いた"],[25,1,"のぞ"]],"text":"神は、すべての人が救われて、真理を悟るに至ることを望んでおられる。"},{"ref":"1Tim.2.5","start":54002005,"end":54002005,"break":"none","ruby":[[0,1,"かみ"],[2,2,"ゆいいつ"],[8,1,"かみ"],[10,1,"ひと"],[13,1,"あいだ"],[15,3,"ちゅうほしゃ"],[32,1,"ひと"]],"text":"神は唯一であり、神と人との間の仲保者もただひとりであって、それは人なるキリスト・イエスである。"},{"ref":"1Tim.2.6","start":54002006,"end":54002006,"break":"none","ruby":[[0,1,"かれ"],[7,1,"ひと"],[17,2,"じしん"],[32,1,"さだ"],[37,1,"とき"]],"text":"彼は、すべての人のあがないとしてご自身をささげられたが、それは、定められた時になされたあかしにほかならない。"},{"ref":"1Tim.2.7","start":54002007,"end":54002007,"break":"none","ruby":[[10,1,"た"],[15,3,"せんきょうしゃ"],[19,2,"しと"],[29,2,"しんじつ"],[32,1,"い"],[38,1,"いつわ"],[49,3,"いほうじん"],[53,2,"しんこう"],[56,2,"しんり"],[60,1,"おし"],[63,2,"きょうし"]],"text":"そのために、わたしは立てられて宣教者、使徒となり（わたしは真実を言っている、偽ってはいない）、また異邦人に信仰と真理とを教える教師となったのである。"},{"ref":"1Tim.2.8","start":54002008,"end":54002008,"break":"paragraph","ruby":[[0,1,"おとこ"],[3,1,"いか"],[7,1,"あらそ"],[19,2,"ばしょ"],[27,1,"て"],[32,1,"いの"]],"text":"男は、怒ったり争ったりしないで、どんな場所でも、きよい手をあげて祈ってほしい。"},{"ref":"1Tim.2.9","start":54002009,"end":54002009,"break":"none","ruby":[[3,1,"おんな"],[10,1,"み"],[16,2,"てきど"],[19,1,"つつし"],[21,1,"ぶか"],[23,1,"み"],[25,1,"かざ"],[34,1,"かみ"],[36,1,"あ"],[41,1,"きん"],[43,2,"しんじゅ"],[51,2,"こうか"],[54,2,"きもの"],[57,1,"き"]],"text":"また、女はつつましい身なりをし、適度に慎み深く身を飾るべきであって、髪を編んだり、金や真珠をつけたり、高価な着物を着たりしてはいけない。"},{"ref":"1Tim.2.10","start":54002010,"end":54002010,"break":"none","ruby":[[4,1,"よ"],[12,1,"かざ"],[21,2,"しんこう"],[24,1,"い"],[33,1,"おんな"],[35,1,"に"]],"text":"むしろ、良いわざをもって飾りとすることが、信仰を言いあらわしている女に似つかわしい。"},{"ref":"1Tim.2.11","start":54002011,"end":54002011,"break":"none","ruby":[[0,1,"おんな"],[2,1,"しず"],[10,2,"ばんじ"],[15,2,"じゅうじゅん"],[18,1,"おしえ"],[20,1,"まな"]],"text":"女は静かにしていて、万事につけ従順に教を学ぶがよい。"},{"ref":"1Tim.2.12","start":54002012,"end":54002012,"break":"none","ruby":[[0,1,"おんな"],[2,1,"おし"],[7,1,"おとこ"],[9,1,"うえ"],[11,1,"た"],[25,1,"ゆる"],[34,1,"しず"]],"text":"女が教えたり、男の上に立ったりすることを、わたしは許さない。むしろ、静かにしているべきである。"},{"ref":"1Tim.2.13","start":54002013,"end":54002013,"break":"none","ruby":[[12,1,"つく"],[23,1,"つく"]],"text":"なぜなら、アダムがさきに造られ、それからエバが造られたからである。"},{"ref":"1Tim.2.14","start":54002014,"end":54002014,"break":"none","ruby":[[6,1,"まど"],[16,1,"おんな"],[18,1,"まど"],[29,1,"おか"]],"text":"またアダムは惑わされなかったが、女は惑わされて、あやまちを犯した。"},{"ref":"1Tim.2.15","start":54002015,"end":54002015,"break":"none","ruby":[[4,1,"おんな"],[6,1,"つつし"],[8,1,"ぶか"],[11,2,"しんこう"],[14,1,"あい"],[16,1,"きよ"],[20,1,"も"],[22,1,"つづ"],[28,1,"こ"],[30,1,"う"],[38,1,"すく"]],"text":"しかし、女が慎み深く、信仰と愛と清さとを持ち続けるなら、子を産むことによって救われるであろう。"}]