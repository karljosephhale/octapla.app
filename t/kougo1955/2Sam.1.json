[{"ref":"2Sam.1.1","start":10001001,"end":10001001,"break":"paragraph","ruby":[[4,1,"し"],[7,1,"のち"],[20,1,"う"],[23,1,"かえ"],[30,1,"あいだ"]],"text":"サウルが死んだ後、ダビデはアマレクびとを撃って帰り、ふつかの間チクラグにとどまっていたが、"},{"ref":"2Sam.1.2","start":10001002,"end":10001002,"break":"none","ruby":[[1,1,"か"],[2,1,"め"],[12,1,"ひと"],[17,2,"きもの"],[20,1,"さ"],[23,1,"あたま"],[25,1,"つち"],[36,2,"じんえい"],[56,1,"ち"],[58,1,"ふ"],[61,1,"はい"]],"text":"三日目となって、ひとりの人が、その着物を裂き、頭に土をかぶって、サウルの陣営からきた。そしてダビデのもとにきて、地に伏して拝した。"},{"ref":"2Sam.1.3","start":10001003,"end":10001003,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[25,1,"かれ"],[31,1,"い"],[46,2,"じんえい"]],"text":"ダビデは彼に言った、「あなたはどこからきたのか」。彼はダビデに言った、「わたしはイスラエルの陣営から、のがれてきたのです」。"},{"ref":"2Sam.1.4","start":10001004,"end":10001004,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[11,2,"ようす"],[21,1,"はな"],[28,1,"かれ"],[30,1,"こた"],[35,1,"たみ"],[37,1,"たたか"],[41,1,"に"],[44,1,"たみ"],[46,1,"おお"],[49,1,"たお"],[52,1,"し"],[61,1,"こ"],[69,1,"し"]],"text":"ダビデは彼に言った、「様子はどうであったか話しなさい」。彼は答えた、「民は戦いから逃げ、民の多くは倒れて死に、サウルとその子ヨナタンもまた死にました」。"},{"ref":"2Sam.1.5","start":10001005,"end":10001005,"break":"none","ruby":[[4,2,"じぶん"],[7,1,"はな"],[12,2,"わかもの"],[15,1,"い"],[30,1,"こ"],[36,1,"し"],[46,1,"し"]],"text":"ダビデは自分と話している若者に言った、「あなたはサウルとその子ヨナタンが死んだのを、どうして知ったのか」。"},{"ref":"2Sam.1.6","start":10001006,"end":10001006,"break":"none","ruby":[[0,1,"かれ"],[2,1,"はな"],[7,2,"わかもの"],[10,1,"い"],[30,1,"やま"],[56,2,"せんしゃ"],[59,2,"きへい"],[63,1,"かれ"],[65,1,"せ"],[67,1,"よ"]],"text":"彼に話している若者は言った、「わたしは、はからずも、ギルボア山にいましたが、サウルはそのやりによりかかっており、戦車と騎兵とが彼に攻め寄ろうとしていました。"},{"ref":"2Sam.1.7","start":10001007,"end":10001007,"break":"none","ruby":[[2,1,"とき"],[4,1,"かれ"],[10,1,"ふ"],[12,1,"む"],[19,1,"み"],[25,1,"よ"],[46,1,"こた"]],"text":"その時、彼はうしろを振り向いてわたしを見、わたしを呼びましたので、『ここにいます』とわたしは答えました。"},{"ref":"2Sam.1.8","start":10001008,"end":10001008,"break":"none","ruby":[[0,1,"かれ"],[12,1,"い"],[31,1,"こた"]],"text":"彼は『おまえはだれか』と言いましたので、『アマレクびとです』と答えました。"},{"ref":"2Sam.1.9","start":10001009,"end":10001009,"break":"none","ruby":[[0,1,"かれ"],[8,1,"い"],[20,1,"ころ"],[32,1,"くる"],[36,1,"た"],[43,1,"いのち"]],"text":"彼はまたわたしに言いました、『そばにきて殺してください。わたしは苦しみに耐えない。まだ命があるからです』。"},{"ref":"2Sam.1.10","start":10001010,"end":10001010,"break":"none","ruby":[[16,1,"かれ"],[18,1,"ころ"],[24,1,"かれ"],[29,1,"たお"],[33,1,"い"],[45,1,"し"],[60,1,"かれ"],[62,1,"あたま"],[67,1,"かんむり"],[70,1,"うで"],[77,2,"うでわ"],[81,1,"と"],[90,1,"しゅ"],[95,1,"たずさ"]],"text":"そこで、わたしはそのそばにいって彼を殺しました。彼がすでに倒れて、生きることのできないのを知ったからです。そしてわたしは彼の頭にあった冠と、腕につけていた腕輪とを取って、それをわが主のもとに携えてきたのです」。"},{"ref":"2Sam.1.11","start":10001011,"end":10001011,"break":"paragraph","ruby":[[8,2,"じぶん"],[11,2,"きもの"],[21,1,"さ"],[24,1,"かれ"],[26,1,"とも"],[30,2,"ひとびと"],[33,1,"みな"],[34,1,"おな"]],"text":"そのときダビデは自分の着物をつかんでそれを裂き、彼と共にいた人々も皆同じようにした。"},{"ref":"2Sam.1.12","start":10001012,"end":10001012,"break":"none","ruby":[[0,1,"かれ"],[14,1,"こ"],[25,1,"しゅ"],[27,1,"たみ"],[40,1,"いえ"],[45,1,"かな"],[48,1,"な"],[52,2,"ゆうぐれ"],[56,1,"しょく"],[58,1,"た"],[65,1,"かれ"],[72,1,"たお"]],"text":"彼らはサウルのため、またその子ヨナタンのため、また主の民のため、またイスラエルの家のために悲しみ泣いて、夕暮まで食を断った。それは彼らがつるぎに倒れたからである。"},{"ref":"2Sam.1.13","start":10001013,"end":10001013,"break":"none","ruby":[[4,2,"じぶん"],[7,1,"はな"],[12,2,"わかもの"],[15,1,"い"],[27,1,"ひと"],[33,1,"かれ"],[35,1,"い"],[48,2,"きりゅう"],[51,2,"たこく"],[53,1,"じん"],[55,1,"こ"]],"text":"ダビデは自分と話していた若者に言った、「あなたはどこの人ですか」。彼は言った、「アマレクびとで、寄留の他国人の子です」。"},{"ref":"2Sam.1.14","start":10001014,"end":10001014,"break":"none","ruby":[[6,1,"かれ"],[8,1,"い"],[21,1,"て"],[23,1,"の"],[26,1,"しゅ"],[28,1,"あぶら"],[30,1,"そそ"],[34,1,"もの"],[36,1,"ころ"],[41,1,"おそ"]],"text":"ダビデはまた彼に言った、「どうしてあなたは手を伸べて主の油を注がれた者を殺すことを恐れなかったのですか」。"},{"ref":"2Sam.1.15","start":10001015,"end":10001015,"break":"none","ruby":[[8,2,"わかもの"],[11,1,"よ"],[15,2,"ちかよ"],[19,1,"かれ"],[21,1,"う"],[25,1,"い"],[32,1,"かれ"],[34,1,"う"],[39,1,"し"]],"text":"ダビデはひとりの若者を呼び、「近寄って彼を撃て」と言った。そこで彼を撃ったので死んだ。"},{"ref":"2Sam.1.16","start":10001016,"end":10001016,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[15,1,"なが"],[18,1,"ち"],[20,1,"せ"],[27,1,"き"],[35,2,"じぶん"],[38,1,"くち"],[47,1,"しゅ"],[49,1,"あぶら"],[51,1,"そそ"],[55,1,"もの"],[57,1,"ころ"],[62,1,"い"],[66,2,"じしん"],[73,2,"しょうこ"],[76,1,"た"]],"text":"ダビデは彼に言った、「あなたの流した血の責めはあなたに帰する。あなたが自分の口から、『わたしは主の油を注がれた者を殺した』と言って、自身にむかって証拠を立てたからである」。"},{"ref":"2Sam.1.17","start":10001017,"end":10001017,"break":"paragraph","ruby":[[6,1,"かな"],[10,1,"うた"],[22,1,"こ"],[31,2,"あいとう"]],"text":"ダビデはこの悲しみの歌をもって、サウルとその子ヨナタンのために哀悼した。――"},{"ref":"2Sam.1.18","start":10001018,"end":10001018,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"おし"],[16,1,"ゆみ"],[18,1,"うた"],[26,1,"しょ"],[38,1,"かれ"],[40,1,"い"]],"text":"これは、ユダの人々に教えるための弓の歌で、ヤシャルの書にしるされている。――彼は言った、"},{"ref":"2Sam.1.19","start":10001019,"end":10001019,"break":"stanza","breaks":[[16,"line"],[29,"line"]],"ruby":[[12,2,"えいこう"],[20,1,"たか"],[22,1,"ところ"],[24,1,"ころ"],[32,2,"ゆうし"],[41,1,"たお"]],"text":"「イスラエルよ、あなたの栄光は、あなたの高き所で殺された。ああ、勇士たちは、ついに倒れた。"},{"ref":"2Sam.1.20","start":10001020,"end":10001020,"break":"line","breaks":[[16,"line"],[35,"line"],[54,"line"]],"ruby":[[5,1,"こと"],[7,1,"つ"],[26,1,"つた"],[47,1,"むすめ"],[51,1,"よろこ"],[54,2,"かつれい"],[58,1,"もの"],[60,1,"むすめ"],[64,1,"か"]],"text":"ガテにこの事を告げてはいけない。アシケロンのちまたに伝えてはならない。おそらくはペリシテびとの娘たちが喜び、割礼なき者の娘たちが勝ちほこるであろう。"},{"ref":"2Sam.1.21","start":10001021,"end":10001021,"break":"line","breaks":[[8,"line"],[21,"line"],[26,"line"],[38,"line"],[54,"line"]],"ruby":[[5,1,"やま"],[8,1,"つゆ"],[14,1,"うえ"],[21,1,"し"],[23,1,"の"],[26,1,"あめ"],[32,1,"うえ"],[34,1,"ふ"],[40,1,"ところ"],[42,2,"ゆうし"],[47,1,"たて"],[49,1,"す"],[58,1,"たて"],[60,1,"あぶら"],[62,1,"ぬ"],[66,1,"す"]],"text":"ギルボアの山よ、露はおまえの上におりるな。死の野よ、雨もおまえの上に降るな。その所に勇士たちの盾は捨てられ、サウルの盾は油を塗らずに捨てられた。"},{"ref":"2Sam.1.22","start":10001022,"end":10001022,"break":"line","breaks":[[13,"line"],[24,"line"],[37,"line"]],"ruby":[[0,1,"ころ"],[3,1,"もの"],[5,1,"ち"],[7,1,"の"],[18,1,"ゆみ"],[20,1,"しりぞ"],[24,2,"ゆうし"],[27,2,"しぼう"],[30,1,"た"],[51,1,"かえ"]],"text":"殺した者の血を飲まずには、ヨナタンの弓は退かず、勇士の脂肪を食べないでは、サウルのつるぎは、むなしくは帰らなかった。"},{"ref":"2Sam.1.23","start":10001023,"end":10001023,"break":"line","breaks":[[22,"line"],[39,"line"],[47,"line"]],"ruby":[[11,1,"あい"],[17,1,"よろこ"],[22,1,"かれ"],[25,1,"い"],[31,1,"し"],[35,1,"はな"],[44,1,"はや"],[52,1,"つよ"]],"text":"サウルとヨナタンとは、愛され、かつ喜ばれた。彼らは生きるにも、死ぬにも離れず、わしよりも早く、ししよりも強かった。"},{"ref":"2Sam.1.24","start":10001024,"end":10001024,"break":"line","breaks":[[21,"line"],[33,"line"],[47,"line"]],"ruby":[[6,1,"むすめ"],[18,1,"な"],[21,1,"かれ"],[23,2,"ひいろ"],[26,2,"きもの"],[44,1,"よそお"],[53,2,"きもの"],[56,1,"きん"],[58,1,"かざ"]],"text":"イスラエルの娘たちよ、サウルのために泣け。彼は緋色の着物をもって、はなやかにあなたがたを装い、あなたがたの着物に金の飾りをつけた。"},{"ref":"2Sam.1.25","start":10001025,"end":10001025,"break":"line","breaks":[[19,"line"]],"ruby":[[3,2,"ゆうし"],[8,1,"たたか"],[15,1,"たお"],[29,1,"たか"],[31,1,"ところ"],[33,1,"ころ"]],"text":"ああ、勇士たちは戦いのさなかに倒れた。ヨナタンは、あなたの高き所で殺された。"},{"ref":"2Sam.1.26","start":10001026,"end":10001026,"break":"line","breaks":[[24,"line"],[48,"line"],[71,"line"]],"ruby":[[2,2,"きょうだい"],[20,1,"かな"],[39,1,"たの"],[42,1,"もの"],[56,1,"あい"],[61,1,"よ"],[63,1,"つね"],[71,1,"おんな"],[73,1,"あい"]],"text":"わが兄弟ヨナタンよ、あなたのためわたしは悲しむ。あなたはわたしにとって、いとも楽しい者であった。あなたがわたしを愛するのは世の常のようでなく、女の愛にもまさっていた。"},{"ref":"2Sam.1.27","start":10001027,"end":10001027,"break":"line","breaks":[[12,"line"]],"ruby":[[3,2,"ゆうし"],[8,1,"たお"],[12,1,"たたか"],[15,1,"うつわ"]],"text":"ああ、勇士たちは倒れた。戦いの器はうせた」。"}]