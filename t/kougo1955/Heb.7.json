[{"ref":"Heb.7.1","start":58007001,"end":58007001,"break":"paragraph","ruby":[[13,1,"おう"],[20,1,"たか"],[22,1,"かみ"],[24,2,"さいし"],[32,1,"おう"],[36,2,"げきは"],[40,1,"かえ"],[48,1,"むか"],[51,2,"しゅくふく"]],"text":"このメルキゼデクはサレムの王であり、いと高き神の祭司であったが、王たちを撃破して帰るアブラハムを迎えて祝福し、"},{"ref":"Heb.7.2","start":58007002,"end":58007002,"break":"none","ruby":[[3,1,"たい"],[13,1,"かれ"],[19,1,"もの"],[22,1,"ぶん"],[26,1,"わ"],[28,1,"あた"],[38,1,"な"],[40,2,"いみ"],[44,1,"だい"],[47,1,"ぎ"],[49,1,"おう"],[51,1,"つぎ"],[59,1,"おう"],[65,2,"へいわ"],[68,1,"おう"]],"text":"それに対して、アブラハムは彼にすべての物の十分の一を分け与えたのである。その名の意味は、第一に義の王、次にまたサレムの王、すなわち平和の王である。"},{"ref":"Heb.7.3","start":58007003,"end":58007003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"ちち"],[8,1,"はは"],[13,2,"けいず"],[19,2,"しょうがい"],[22,1,"はじ"],[28,2,"せいめい"],[31,1,"おわ"],[37,1,"かみ"],[39,1,"こ"],[53,2,"さいし"]],"text":"彼には父がなく、母がなく、系図がなく、生涯の初めもなく、生命の終りもなく、神の子のようであって、いつまでも祭司なのである。"},{"ref":"Heb.7.4","start":58007004,"end":58007004,"break":"paragraph","ruby":[[4,2,"ぞくちょう"],[13,1,"もっと"],[21,1,"ひん"],[24,1,"ぶん"],[28,1,"あた"],[38,1,"ひと"],[48,2,"じんぶつ"]],"text":"そこで、族長のアブラハムが最もよいぶんどり品の十分の一を与えたのだから、この人がどんなにすぐれた人物であったかが、あなたがたにわかるであろう。"},{"ref":"Heb.7.5","start":58007005,"end":58007005,"break":"none","ruby":[[6,1,"こ"],[11,2,"さいし"],[14,1,"つとめ"],[20,1,"もの"],[25,2,"きょうだい"],[30,1,"たみ"],[34,1,"おな"],[43,2,"しそん"],[57,1,"ぶん"],[61,1,"と"],[67,2,"りっぽう"],[73,1,"めい"]],"text":"さて、レビの子のうちで祭司の務をしている者たちは、兄弟である民から、同じくアブラハムの子孫であるにもかかわらず、十分の一を取るように、律法によって命じられている。"},{"ref":"Heb.7.6","start":58007006,"end":58007006,"break":"none","ruby":[[5,1,"かれ"],[8,2,"けっとう"],[11,1,"ぞく"],[17,1,"ひと"],[28,1,"ぶん"],[32,1,"う"],[37,2,"やくそく"],[40,1,"う"],[45,1,"もの"],[47,2,"しゅくふく"]],"text":"ところが、彼らの血統に属さないこの人が、アブラハムから十分の一を受けとり、約束を受けている者を祝福したのである。"},{"ref":"Heb.7.7","start":58007007,"end":58007007,"break":"none","ruby":[[0,1,"い"],[8,1,"しょう"],[11,1,"もの"],[13,1,"おお"],[16,1,"もの"],[19,2,"しゅくふく"],[22,1,"う"]],"text":"言うまでもなく、小なる者が大なる者から祝福を受けるのである。"},{"ref":"Heb.7.8","start":58007008,"end":58007008,"break":"none","ruby":[[2,1,"うえ"],[4,2,"いっぽう"],[8,1,"し"],[12,2,"にんげん"],[17,1,"ぶん"],[21,1,"う"],[28,2,"たほう"],[33,1,"かれ"],[35,1,"い"],[40,1,"もの"],[49,1,"ひと"],[55,1,"う"]],"text":"その上、一方では死ぬべき人間が、十分の一を受けているが、他方では「彼は生きている者」とあかしされた人が、それを受けている。"},{"ref":"Heb.7.9","start":58007009,"end":58007009,"break":"none","ruby":[[5,1,"ぶん"],[9,1,"う"],[27,1,"つう"],[31,1,"ぶん"],[35,1,"おさ"],[40,1,"い"]],"text":"そこで、十分の一を受けるべきレビでさえも、アブラハムを通じて十分の一を納めた、と言える。"},{"ref":"Heb.7.10","start":58007010,"end":58007010,"break":"none","ruby":[[18,1,"むか"],[21,1,"とき"],[32,2,"ふそ"],[35,1,"こし"],[37,1,"なか"]],"text":"なぜなら、メルキゼデクがアブラハムを迎えた時には、レビはまだこの父祖の腰の中にいたからである。"},{"ref":"Heb.7.11","start":58007011,"end":58007011,"break":"paragraph","ruby":[[2,1,"まっと"],[12,1,"けい"],[14,2,"さいし"],[16,1,"せい"],[21,2,"かのう"],[30,1,"たみ"],[32,2,"さいし"],[34,1,"せい"],[36,1,"もと"],[38,2,"りっぽう"],[41,1,"あた"],[56,2,"ひつよう"],[71,1,"ひと"],[76,1,"よ"],[82,1,"べつ"],[92,1,"ひと"],[96,2,"さいし"],[99,1,"た"]],"text":"もし全うされることがレビ系の祭司制によって可能であったら――民は祭司制の下に律法を与えられたのであるが――なんの必要があって、なお、「アロンに等しい」と呼ばれない、別な「メルキゼデクに等しい」祭司が立てられるのであるか。"},{"ref":"Heb.7.12","start":58007012,"end":58007012,"break":"none","ruby":[[0,2,"さいし"],[2,1,"せい"],[4,2,"へんこう"],[11,2,"りっぽう"],[15,1,"かなら"],[17,2,"へんこう"]],"text":"祭司制に変更があれば、律法にも必ず変更があるはずである。"},{"ref":"Heb.7.13","start":58007013,"end":58007013,"break":"none","ruby":[[17,2,"さいだん"],[20,2,"ほうし"],[30,1,"た"],[32,2,"ぶぞく"],[35,1,"かん"],[38,1,"い"]],"text":"さて、これらのことは、いまだかつて祭壇に奉仕したことのない、他の部族に関して言われているのである。"},{"ref":"Heb.7.14","start":58007014,"end":58007014,"break":"none","ruby":[[12,1,"しゅ"],[16,1,"ぞく"],[18,1,"なか"],[21,1,"で"],[29,1,"あき"],[44,2,"ぶぞく"],[51,2,"さいし"],[54,1,"かん"],[67,1,"い"]],"text":"というのは、わたしたちの主がユダ族の中から出られたことは、明らかであるが、モーセは、この部族について、祭司に関することでは、ひとことも言っていない。"},{"ref":"Heb.7.15","start":58007015,"end":58007015,"break":"none","ruby":[[5,1,"こと"],[15,2,"どうよう"],[22,2,"さいし"],[25,1,"た"],[41,2,"めいはく"]],"text":"そしてこの事は、メルキゼデクと同様な、ほかの祭司が立てられたことによって、ますます明白になる。"},{"ref":"Heb.7.16","start":58007016,"end":58007016,"break":"none","ruby":[[0,1,"かれ"],[3,1,"にく"],[8,1,"いまし"],[11,2,"りっぽう"],[20,1,"く"],[32,1,"ちから"],[37,1,"た"]],"text":"彼は、肉につける戒めの律法によらないで、朽ちることのないいのちの力によって立てられたのである。"},{"ref":"Heb.7.17","start":58007017,"end":58007017,"break":"none","ruby":[[8,2,"せいしょ"],[19,2,"えいえん"],[30,1,"ひと"],[33,2,"さいし"]],"text":"それについては、聖書に「あなたこそは、永遠に、メルキゼデクに等しい祭司である」とあかしされている。"},{"ref":"Heb.7.18","start":58007018,"end":58007018,"break":"none","ruby":[[8,2,"いっぽう"],[13,1,"まえ"],[15,1,"いまし"],[18,1,"よわ"],[22,2,"むえき"],[31,2,"むこう"],[37,1,"とも"]],"text":"このようにして、一方では、前の戒めが弱くかつ無益であったために無効になると共に、"},{"ref":"Heb.7.19","start":58007019,"end":58007019,"break":"none","ruby":[[1,2,"りっぽう"],[5,2,"なにごと"],[9,1,"まっと"],[12,1,"え"],[24,2,"たほう"],[36,1,"のぞ"],[39,1,"あらわ"],[51,1,"かみ"],[53,1,"ちか"]],"text":"（律法は、何事をも全うし得なかったからである）、他方では、さらにすぐれた望みが現れてきて、わたしたちを神に近づかせるのである。"},{"ref":"Heb.7.20","start":58007020,"end":58007020,"break":"none","ruby":[[2,1,"うえ"],[10,1,"ちか"],[21,2,"ひとびと"],[25,1,"ちか"],[32,2,"さいし"]],"text":"その上に、このことは誓いをもってなされた。人々は、誓いをしないで祭司とされるのであるが、"},{"ref":"Heb.7.21","start":58007021,"end":58007021,"break":"none","ruby":[[2,1,"ひと"],[4,2,"ばあい"],[8,1,"つぎ"],[13,1,"ちか"],[32,1,"かれ"],[40,1,"い"],[48,1,"しゅ"],[50,1,"ちか"],[56,1,"こころ"],[58,1,"か"],[78,2,"えいえん"],[81,2,"さいし"]],"text":"この人の場合は、次のような誓いをもってされたのである。すなわち、彼について、こう言われている、「主は誓われたが、心を変えることをされなかった。あなたこそは、永遠に祭司である」。"},{"ref":"Heb.7.22","start":58007022,"end":58007022,"break":"none","ruby":[[12,1,"さら"],[18,2,"けいやく"],[21,2,"ほしょう"]],"text":"このようにして、イエスは更にすぐれた契約の保証となられたのである。"},{"ref":"Heb.7.23","start":58007023,"end":58007023,"break":"none","ruby":[[3,1,"し"],[16,1,"つとめ"],[18,1,"つづ"],[31,1,"おお"],[34,2,"ひとびと"],[37,2,"さいし"],[40,1,"た"]],"text":"かつ、死ということがあるために、務を続けることができないので、多くの人々が祭司に立てられるのである。"},{"ref":"Heb.7.24","start":58007024,"end":58007024,"break":"none","ruby":[[3,1,"かれ"],[6,2,"えいえん"],[20,1,"かわ"],[24,2,"さいし"],[27,1,"つとめ"],[29,1,"も"]],"text":"しかし彼は、永遠にいますかたであるので、変らない祭司の務を持ちつづけておられるのである。"},{"ref":"Heb.7.25","start":58007025,"end":58007025,"break":"none","ruby":[[6,1,"かれ"],[12,1,"い"],[17,1,"かれ"],[35,1,"かれ"],[40,1,"かみ"],[42,1,"く"],[44,2,"ひとびと"],[51,1,"すく"]],"text":"そこでまた、彼は、いつも生きていて彼らのためにとりなしておられるので、彼によって神に来る人々を、いつも救うことができるのである。"},{"ref":"Heb.7.26","start":58007026,"end":58007026,"break":"paragraph","ruby":[[6,1,"せい"],[11,1,"あく"],[13,1,"けが"],[19,2,"つみびと"],[23,2,"くべつ"],[36,1,"てん"],[40,1,"たか"],[47,3,"だいさいし"]],"text":"このように、聖にして、悪も汚れもなく、罪人とは区別され、かつ、もろもろの天よりも高くされている大祭司こそ、わたしたちにとってふさわしいかたである。"},{"ref":"Heb.7.27","start":58007027,"end":58007027,"break":"none","ruby":[[0,1,"かれ"],[6,3,"だいさいし"],[16,2,"じぶん"],[19,1,"つみ"],[24,1,"つぎ"],[26,1,"たみ"],[28,1,"つみ"],[34,2,"ひび"],[46,2,"ひつよう"],[57,2,"じぶん"],[66,1,"ど"]],"text":"彼は、ほかの大祭司のように、まず自分の罪のため、次に民の罪のために、日々、いけにえをささげる必要はない。なぜなら、自分をささげて、一度だけ、それをされたからである。"},{"ref":"Heb.7.28","start":58007028,"end":58007028,"break":"none","ruby":[[0,2,"りっぽう"],[4,1,"よわ"],[7,1,"み"],[9,1,"お"],[11,2,"にんげん"],[14,1,"た"],[17,3,"だいさいし"],[25,2,"りっぽう"],[28,1,"のち"],[32,1,"ちか"],[35,2,"みことば"],[39,2,"えいえん"],[42,1,"まっと"],[47,2,"みこ"],[50,1,"た"],[54,3,"だいさいし"]],"text":"律法は、弱さを身に負う人間を立てて大祭司とするが、律法の後にきた誓いの御言は、永遠に全うされた御子を立てて、大祭司としたのである。"}]