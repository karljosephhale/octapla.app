[{"ref":"Ps.34.1","start":19034001,"end":19034001,"break":"paragraph","title":"ダビデがアビメレクの前で狂ったさまをよそおい、追われて出ていったときの歌","breaks":[[14,"line"]],"ruby":[[4,1,"つね"],[6,1,"しゅ"],[24,1,"くち"],[26,1,"た"]],"titleRuby":[[10,1,"まえ"],[12,1,"くる"],[23,1,"お"],[27,1,"で"],[35,1,"うた"]],"text":"わたしは常に主をほめまつる。そのさんびはわたしの口に絶えない。"},{"ref":"Ps.34.2","start":19034002,"end":19034002,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"たましい"],[4,1,"しゅ"],[9,1,"ほこ"],[12,1,"くる"],[15,1,"もの"],[20,1,"き"],[23,1,"よろこ"]],"text":"わが魂は主によって誇る。苦しむ者はこれを聞いて喜ぶであろう。"},{"ref":"Ps.34.3","start":19034003,"end":19034003,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"とも"],[6,1,"しゅ"],[17,1,"とも"],[20,1,"な"]],"text":"わたしと共に主をあがめよ、われらは共にみ名をほめたたえよう。"},{"ref":"Ps.34.4","start":19034004,"end":19034004,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"もと"],[12,1,"しゅ"],[18,1,"こた"],[25,1,"おそ"],[33,1,"たす"],[35,1,"だ"]],"text":"わたしが主に求めたとき、主はわたしに答え、すべての恐れからわたしを助け出された。"},{"ref":"Ps.34.5","start":19034005,"end":19034005,"break":"line","breaks":[[12,"line"],[25,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"あお"],[4,1,"み"],[7,1,"ひかり"],[9,1,"え"],[25,1,"は"],[28,1,"かお"],[30,1,"あか"]],"text":"主を仰ぎ見て、光を得よ、そうすれば、あなたがたは、恥じて顔を赤くすることはない。"},{"ref":"Ps.34.6","start":19034006,"end":19034006,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"くる"],[5,1,"もの"],[7,1,"よ"],[15,1,"しゅ"],[17,1,"き"],[25,1,"なや"],[29,1,"すく"],[31,1,"だ"]],"text":"この苦しむ者が呼ばわったとき、主は聞いて、すべての悩みから救い出された。"},{"ref":"Ps.34.7","start":19034007,"end":19034007,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,1,"しゅ"],[6,1,"おそ"],[9,1,"もの"],[15,1,"じん"],[20,1,"かれ"],[23,1,"たす"]],"text":"主の使は主を恐れる者のまわりに陣をしいて彼らを助けられる。"},{"ref":"Ps.34.8","start":19034008,"end":19034008,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"めぐ"],[10,1,"あじ"],[13,1,"し"],[16,1,"しゅ"],[18,1,"よ"],[20,1,"たの"],[22,1,"ひと"]],"text":"主の恵みふかきことを味わい知れ、主に寄り頼む人はさいわいである。"},{"ref":"Ps.34.9","start":19034009,"end":19034009,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"せいと"],[6,1,"しゅ"],[8,1,"おそ"],[12,1,"しゅ"],[14,1,"おそ"],[17,1,"もの"],[20,1,"とぼ"]],"text":"主の聖徒よ、主を恐れよ、主を恐れる者には乏しいことがないからである。"},{"ref":"Ps.34.10","start":19034010,"end":19034010,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"わか"],[5,1,"とぼ"],[11,1,"う"],[23,1,"しゅ"],[25,1,"もと"],[28,1,"もの"],[30,1,"よ"],[32,1,"もの"],[34,1,"か"]],"text":"若きししは乏しくなって飢えることがある。しかし主を求める者は良き物に欠けることはない。"},{"ref":"Ps.34.11","start":19034011,"end":19034011,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"こ"],[4,1,"き"],[10,1,"き"],[17,1,"しゅ"],[19,1,"おそ"],[32,1,"おし"]],"text":"子らよ、来てわたしに聞け、わたしは主を恐るべきことをあなたがたに教えよう。"},{"ref":"Ps.34.12","start":19034012,"end":19034012,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"み"],[16,1,"した"],[27,1,"この"],[29,1,"ひと"]],"text":"さいわいを見ようとして、いのちを慕い、ながらえることを好む人はだれか。"},{"ref":"Ps.34.13","start":19034013,"end":19034013,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"した"],[10,1,"あく"],[12,1,"い"],[30,1,"いつわ"],[33,1,"い"]],"text":"あなたの舌をおさえて悪を言わせず、あなたのくちびるをおさえて偽りを言わすな。"},{"ref":"Ps.34.14","start":19034014,"end":19034014,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"あく"],[2,1,"はな"],[5,1,"ぜん"],[17,1,"もと"],[24,1,"つと"]],"text":"悪を離れて善をおこない、やわらぎを求めて、これを努めよ。"},{"ref":"Ps.34.15","start":19034015,"end":19034015,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"め"],[4,1,"ただ"],[7,1,"ひと"],[16,1,"みみ"],[18,1,"かれ"],[21,1,"さけ"],[24,1,"かたむ"]],"text":"主の目は正しい人をかえりみ、その耳は彼らの叫びに傾く。"},{"ref":"Ps.34.16","start":19034016,"end":19034016,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かお"],[5,1,"あく"],[7,1,"おこな"],[9,1,"もの"],[17,2,"きおく"],[20,1,"ち"],[23,1,"た"],[25,1,"ほろ"]],"text":"主のみ顔は悪を行う者にむかい、その記憶を地から断ち滅ぼされる。"},{"ref":"Ps.34.17","start":19034017,"end":19034017,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[5,1,"たす"],[8,1,"さけ"],[10,1,"もと"],[16,1,"しゅ"],[18,1,"き"],[22,1,"かれ"],[31,1,"なや"],[35,1,"たす"],[37,1,"だ"]],"text":"正しい者が助けを叫び求めるとき、主は聞いて、彼らをそのすべての悩みから助け出される。"},{"ref":"Ps.34.18","start":19034018,"end":19034018,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"こころ"],[4,1,"くだ"],[7,1,"もの"],[9,1,"ちか"],[17,1,"く"],[24,1,"もの"],[26,1,"すく"]],"text":"主は心の砕けた者に近く、たましいの悔いくずおれた者を救われる。"},{"ref":"Ps.34.19","start":19034019,"end":19034019,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[6,1,"わざわい"],[8,1,"おお"],[15,1,"しゅ"],[22,1,"なか"],[25,1,"かれ"],[27,1,"たす"],[29,1,"だ"]],"text":"正しい者には災が多い。しかし、主はすべてその中から彼を助け出される。"},{"ref":"Ps.34.20","start":19034020,"end":19034020,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"ほね"],[11,1,"まも"],[22,1,"お"]],"text":"主は彼の骨をことごとく守られる。その一つだに折られることはない。"},{"ref":"Ps.34.21","start":19034021,"end":19034021,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"あく"],[2,1,"あ"],[5,1,"もの"],[7,1,"ころ"],[10,1,"ただ"],[13,1,"もの"],[15,1,"にく"],[17,1,"もの"],[19,1,"つみ"],[21,1,"さだ"]],"text":"悪は悪しき者を殺す。正しい者を憎む者は罪に定められる。"},{"ref":"Ps.34.22","start":19034022,"end":19034022,"break":"line","breaks":[[18,"line"],[31,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"いのち"],[18,1,"しゅ"],[20,1,"よ"],[22,1,"たの"],[24,1,"もの"],[31,1,"つみ"],[33,1,"さだ"]],"text":"主はそのしもべらの命をあがなわれる。主に寄り頼む者はひとりだに罪に定められることはない。"}]