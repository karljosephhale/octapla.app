[{"ref":"Jer.23.1","start":24023001,"end":24023001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[10,2,"まきば"],[13,1,"ひつじ"],[15,1,"ほろ"],[18,1,"ち"],[21,2,"ぼくしゃ"]],"text":"主は言われる、「わが牧場の羊を滅ぼし散らす牧者はわざわいである」。"},{"ref":"Jer.23.2","start":24023002,"end":24023002,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[16,1,"たみ"],[18,1,"やしな"],[20,2,"ぼくしゃ"],[28,1,"い"],[44,1,"む"],[47,1,"ち"],[54,1,"お"],[59,1,"かえり"],[66,1,"み"],[79,1,"あ"],[82,1,"おこな"],[94,1,"むく"],[99,1,"しゅ"],[101,1,"い"]],"text":"それゆえイスラエルの神、主はわが民を養う牧者についてこう言われる、「あなたがたはわたしの群れを散らし、これを追いやって顧みなかった。見よ、わたしはあなたがたの悪しき行いによってあなたがたに報いると、主は言われる。"},{"ref":"Jer.23.3","start":24023003,"end":24023003,"break":"none","ruby":[[4,1,"む"],[7,1,"のこ"],[10,1,"もの"],[13,1,"お"],[22,1,"ち"],[25,1,"あつ"],[28,1,"ふたた"],[38,1,"かえ"],[44,1,"かれ"],[47,1,"こ"],[49,1,"う"],[54,1,"かず"],[56,1,"おお"]],"text":"わたしの群れの残った者を、追いやったすべての地から集め、再びこれをそのおりに帰らせよう。彼らは子を産んでその数が多くなる。"},{"ref":"Jer.23.4","start":24023004,"end":24023004,"break":"none","ruby":[[7,1,"やしな"],[9,2,"ぼくしゃ"],[14,1,"うえ"],[16,1,"た"],[20,1,"かれ"],[23,1,"ふたた"],[25,1,"おそ"],[56,1,"しゅ"],[58,1,"い"]],"text":"わたしはこれを養う牧者をその上に立てる、彼らは再び恐れることなく、またおののくことなく、いなくなることもないと、主は言われる。"},{"ref":"Jer.23.5","start":24023005,"end":24023005,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"おお"],[8,1,"み"],[25,1,"ただ"],[28,1,"えだ"],[30,1,"おこ"],[32,1,"ひ"],[37,1,"かれ"],[39,1,"おう"],[44,1,"よ"],[46,1,"おさ"],[49,1,"さか"],[53,2,"こうへい"],[56,2,"せいぎ"],[59,1,"よ"],[61,1,"おこな"]],"text":"主は仰せられる、見よ、わたしがダビデのために一つの正しい枝を起す日がくる。彼は王となって世を治め、栄えて、公平と正義を世に行う。"},{"ref":"Jer.23.6","start":24023006,"end":24023006,"break":"none","ruby":[[2,1,"ひ"],[6,1,"すくい"],[8,1,"え"],[16,1,"やす"],[25,1,"な"],[28,1,"しゅ"],[35,2,"せいぎ"]],"text":"その日ユダは救を得、イスラエルは安らかにおる。その名は『主はわれわれの正義』ととなえられる。"},{"ref":"Jer.23.7","start":24023007,"end":24023007,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"み"],[14,2,"ひとびと"],[24,1,"たみ"],[31,1,"ち"],[34,1,"みちび"],[36,1,"だ"],[40,1,"しゅ"],[42,1,"い"],[53,1,"い"]],"text":"主は言われる、それゆえ見よ、人々は『イスラエルの民をエジプトの地から導き出された主は生きておられる』とまた言わないで、"},{"ref":"Jer.23.8","start":24023008,"end":24023008,"break":"none","ruby":[[7,1,"いえ"],[9,2,"しそん"],[12,1,"きた"],[14,1,"ち"],[22,1,"お"],[28,1,"ち"],[31,1,"みちび"],[33,1,"だ"],[37,1,"かみ"],[39,1,"い"],[50,1,"ひ"],[57,1,"とき"],[59,1,"かれ"],[62,2,"じぶん"],[65,1,"ち"],[67,1,"す"]],"text":"『イスラエルの家の子孫を北の地と、そのすべて追いやられた地から導き出された神は生きておられる』という日がくる。その時、彼らは自分の地に住んでいる」。"},{"ref":"Jer.23.9","start":24023009,"end":24023009,"break":"paragraph","breaks":[[10,"stanza"],[24,"line"],[33,"line"],[47,"line"],[61,"line"]],"ruby":[[0,3,"よげんしゃ"],[12,1,"こころ"],[21,1,"やぶ"],[26,1,"ほね"],[30,1,"ふる"],[33,1,"しゅ"],[37,1,"せい"],[40,2,"ことば"],[51,1,"よ"],[56,1,"ひと"],[61,1,"さけ"],[63,1,"う"],[65,1,"ま"],[70,1,"ひと"]],"text":"預言者たちについて。わが心はわたしのうちに破れ、わが骨はみな震う。主とその聖なる言葉のために、わたしは酔っている人のよう、酒に打ち負かされた人のようである。"},{"ref":"Jer.23.10","start":24023010,"end":24023010,"break":"line","breaks":[[21,"line"],[43,"line"]],"ruby":[[2,1,"ち"],[4,2,"かんいん"],[7,1,"おこな"],[12,1,"み"],[28,1,"ち"],[30,1,"なげ"],[33,2,"あらの"],[36,2,"まきば"],[43,1,"かれ"],[46,1,"みち"],[48,1,"わる"],[53,1,"ちから"],[55,1,"ただ"]],"text":"この地に姦淫を行うものが満ちているからだ。のろいによって地は嘆き、荒野の牧場はかわく。彼らの道は悪く、その力は正しくない。"},{"ref":"Jer.23.11","start":24023011,"end":24023011,"break":"line","breaks":[[20,"line"],[31,"line"]],"ruby":[[1,3,"よげんしゃ"],[5,2,"さいし"],[9,1,"とも"],[11,1,"かみ"],[13,1,"けが"],[15,1,"もの"],[24,1,"いえ"],[31,1,"かれ"],[34,1,"あく"],[36,1,"み"],[40,1,"しゅ"],[42,1,"い"]],"text":"「預言者と祭司とは共に神を汚す者である。わたしの家においてすら彼らの悪を見たと、主は言われる。"},{"ref":"Jer.23.12","start":24023012,"end":24023012,"break":"line","breaks":[[11,"line"],[23,"line"],[36,"line"],[51,"line"],[66,"line"]],"ruby":[[5,1,"かれ"],[8,1,"みち"],[16,2,"あんこく"],[19,1,"なか"],[28,1,"みち"],[36,1,"かれ"],[39,1,"お"],[45,1,"みち"],[47,1,"たお"],[55,1,"かれ"],[58,1,"ばっ"],[63,1,"とし"],[66,1,"わざわい"],[70,1,"うえ"],[72,1,"のぞ"],[83,1,"しゅ"],[85,1,"い"]],"text":"それゆえ、彼らの道は、おのずから暗黒の中にあるなめらかな道のようになり、彼らは押されてその道に倒れる。わたしが彼らの罰せられる年に、災をその上に臨ませるからであると、主は言われる。"},{"ref":"Jer.23.13","start":24023013,"end":24023013,"break":"line","breaks":[[16,"line"],[28,"line"],[42,"line"]],"ruby":[[9,3,"よげんしゃ"],[16,2,"ふかい"],[19,1,"こと"],[25,1,"み"],[28,1,"かれ"],[38,2,"よげん"],[44,1,"たみ"],[51,1,"まど"]],"text":"わたしはサマリヤの預言者のうちに不快な事のあるのを見た。彼らはバアルによって預言し、わが民イスラエルを惑わした。"},{"ref":"Jer.23.14","start":24023014,"end":24023014,"break":"line","breaks":[[18,"line"],[31,"line"],[46,"line"],[55,"line"],[69,"line"],[89,"line"]],"ruby":[[9,3,"よげんしゃ"],[18,1,"おそ"],[22,1,"こと"],[28,1,"み"],[31,1,"かれ"],[34,2,"かんいん"],[37,1,"おこな"],[40,1,"いつわ"],[43,1,"あゆ"],[46,2,"あくにん"],[49,1,"て"],[51,1,"つよ"],[55,1,"ひと"],[59,1,"あく"],[62,1,"はな"],[69,1,"かれ"],[91,1,"たみ"]],"text":"しかしエルサレムの預言者のうちには、恐ろしい事のあるのを見た。彼らは姦淫を行い、偽りに歩み、悪人の手を強くし、人をその悪から離れさせない。彼らはみなわたしにはソドムのようであり、その民はゴモラのようである」。"},{"ref":"Jer.23.15","start":24023015,"end":24023015,"break":"line","breaks":[[23,"line"],[46,"line"],[55,"line"],[76,"line"]],"ruby":[[4,2,"ばんぐん"],[7,1,"しゅ"],[9,3,"よげんしゃ"],[18,1,"い"],[24,1,"み"],[31,1,"かれ"],[41,1,"た"],[46,1,"どく"],[48,1,"みず"],[50,1,"の"],[55,1,"かみ"],[57,1,"けが"],[68,3,"よげんしゃ"],[73,1,"で"],[76,1,"ぜん"],[77,1,"ち"],[79,1,"およ"]],"text":"それゆえ万軍の主は預言者についてこう言われる、「見よ、わたしは彼らに、にがよもぎを食べさせ、毒の水を飲ませる。神を汚すことがエルサレムの預言者から出て、全地に及んでいるからである」。"},{"ref":"Jer.23.16","start":24023016,"end":24023016,"break":"paragraph","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[7,1,"い"],[19,2,"よげん"],[23,3,"よげんしゃ"],[27,2,"ことば"],[30,1,"き"],[39,1,"かれ"],[53,1,"のぞ"],[61,1,"しゅ"],[63,1,"くち"],[66,1,"で"],[73,2,"じぶん"],[76,1,"こころ"],[78,2,"もくし"],[81,1,"かた"]],"text":"万軍の主はこう言われる、「あなたがたに預言する預言者の言葉を聞いてはならない。彼らはあなたがたに、むなしい望みをいだかせ、主の口から出たのでない、自分の心の黙示を語るのである。"},{"ref":"Jer.23.17","start":24023017,"end":24023017,"break":"none","ruby":[[0,1,"かれ"],[3,1,"しゅ"],[5,2,"ことば"],[8,1,"かる"],[12,1,"もの"],[14,1,"む"],[18,1,"た"],[29,2,"へいあん"],[32,1,"え"],[36,1,"い"],[41,2,"じぶん"],[44,2,"ごうじょう"],[47,1,"こころ"],[54,1,"あゆ"],[60,1,"ひと"],[62,1,"む"],[74,1,"わざわい"],[81,1,"い"]],"text":"彼らは主の言葉を軽んじる者に向かって絶えず、『あなたがたは平安を得る』と言い、また自分の強情な心にしたがって歩むすべての人に向かって、『あなたがたに災はこない』と言う」。"},{"ref":"Jer.23.18","start":24023018,"end":24023018,"break":"paragraph","breaks":[[17,"line"],[34,"line"]],"ruby":[[0,1,"かれ"],[8,1,"しゅ"],[10,2,"ぎかい"],[13,1,"た"],[19,2,"ことば"],[22,2,"みき"],[27,1,"もの"],[37,1,"みみ"],[39,1,"かたむ"],[44,2,"ことば"],[47,1,"き"],[50,1,"もの"]],"text":"彼らのうちだれか主の議会に立って、その言葉を見聞きした者があろうか。だれか耳を傾けてその言葉を聞いた者があろうか。"},{"ref":"Jer.23.19","start":24023019,"end":24023019,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[5,2,"ぼうふう"],[11,1,"いきどお"],[18,1,"かぜ"],[20,1,"で"],[23,2,"あくにん"]],"text":"見よ、主の暴風がくる。憤りと、つむじ風が出て、悪人のこうべをうつ。"},{"ref":"Jer.23.20","start":24023020,"end":24023020,"break":"line","breaks":[[19,"line"],[36,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"いか"],[7,1,"こころ"],[9,1,"おも"],[11,1,"さだ"],[21,1,"と"],[28,1,"しりぞ"],[36,1,"すえ"],[38,1,"ひ"],[49,1,"あき"],[53,1,"さと"]],"text":"主の怒りは、み心に思い定められたことをなし遂げられるまで退くことはない。末の日にあなたがたはそれを明らかに悟る。"},{"ref":"Jer.23.21","start":24023021,"end":24023021,"break":"stanza","breaks":[[21,"line"],[28,"line"],[45,"line"]],"ruby":[[0,3,"よげんしゃ"],[21,1,"かれ"],[24,1,"はし"],[33,1,"かれ"],[36,1,"つ"],[45,1,"かれ"],[48,2,"よげん"]],"text":"預言者たちはわたしがつかわさなかったのに、彼らは走った。わたしが、彼らに告げなかったのに、彼らは預言した。"},{"ref":"Jer.23.22","start":24023022,"end":24023022,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[2,1,"かれ"],[9,2,"ぎかい"],[12,1,"た"],[25,1,"たみ"],[29,2,"ことば"],[32,1,"つ"],[34,1,"しめ"],[40,1,"わる"],[42,1,"みち"],[44,1,"わる"],[46,1,"おこな"],[51,1,"はな"]],"text":"もし彼らがわたしの議会に立ったのであれば、わたしの民にわが言葉を告げ示して、その悪い道と悪い行いから、離れさせたであろうに。"},{"ref":"Jer.23.23","start":24023023,"end":24023023,"break":"paragraph","ruby":[[1,1,"しゅ"],[3,1,"い"],[14,1,"ちか"],[17,1,"かみ"],[23,1,"とお"],[26,1,"かみ"]],"text":"「主は言われる、わたしはただ近くの神であって、遠くの神ではないのであるか。"},{"ref":"Jer.23.24","start":24023024,"end":24023024,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[7,1,"ひと"],[14,1,"ところ"],[16,1,"み"],[18,1,"かく"],[26,1,"み"],[45,1,"しゅ"],[47,1,"い"],[56,1,"てん"],[58,1,"ち"],[61,1,"み"]],"text":"主は言われる、人は、ひそかな所に身を隠して、わたしに見られないようにすることができようか。主は言われる、わたしは天と地とに満ちているではないか。"},{"ref":"Jer.23.25","start":24023025,"end":24023025,"break":"none","ruby":[[2,1,"な"],[7,1,"いつわ"],[10,2,"よげん"],[14,3,"よげんしゃ"],[26,1,"ゆめ"],[28,1,"み"],[35,1,"ゆめ"],[37,1,"み"],[41,1,"い"],[45,1,"き"]],"text":"わが名によって偽りを預言する預言者たちが、『わたしは夢を見た、わたしは夢を見た』と言うのを聞いた。"},{"ref":"Jer.23.26","start":24023026,"end":24023026,"break":"none","ruby":[[0,1,"いつわ"],[3,2,"よげん"],[7,3,"よげんしゃ"],[13,1,"こころ"],[20,1,"いつわ"],[31,1,"かれ"],[36,1,"こころ"],[38,1,"あざむ"],[41,2,"よげん"]],"text":"偽りを預言する預言者たちの心に、いつまで偽りがあるのであるか。彼らはその心の欺きを預言する。"},{"ref":"Jer.23.27","start":24023027,"end":24023027,"break":"none","ruby":[[0,1,"かれ"],[5,2,"せんぞ"],[12,1,"したが"],[17,1,"な"],[19,1,"わす"],[26,1,"たがい"],[28,1,"ゆめ"],[30,1,"かた"],[38,1,"たみ"],[42,1,"な"],[44,1,"わす"]],"text":"彼らはその先祖がバアルに従ってわが名を忘れたように、互に夢を語って、わたしの民にわが名を忘れさせようとする。"},{"ref":"Jer.23.28","start":24023028,"end":24023028,"break":"none","ruby":[[0,1,"ゆめ"],[4,3,"よげんしゃ"],[8,1,"ゆめ"],[10,1,"かた"],[24,2,"ことば"],[27,1,"う"],[30,1,"もの"],[32,2,"せいじつ"],[39,2,"ことば"],[42,1,"かた"],[56,1,"むぎ"],[73,1,"しゅ"],[75,1,"い"]],"text":"夢をみた預言者は夢を語るがよい。しかし、わたしの言葉を受けた者は誠実にわたしの言葉を語らなければならない。わらと麦とをくらべることができようかと、主は言われる。"},{"ref":"Jer.23.29","start":24023029,"end":24023029,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"おお"],[12,2,"ことば"],[15,1,"ひ"],[27,1,"いわ"],[29,1,"う"],[31,1,"くだ"],[33,1,"つち"]],"text":"主は仰せられる、わたしの言葉は火のようではないか。また岩を打ち砕く鎚のようではないか。"},{"ref":"Jer.23.30","start":24023030,"end":24023030,"break":"none","ruby":[[4,1,"み"],[15,2,"ことば"],[18,1,"たがい"],[20,1,"ぬす"],[22,3,"よげんしゃ"],[26,1,"てき"],[32,1,"しゅ"],[34,1,"い"]],"text":"それゆえ見よ、わたしはわたしの言葉を互に盗む預言者の敵となると、主は言われる。"},{"ref":"Jer.23.31","start":24023031,"end":24023031,"break":"none","ruby":[[0,1,"み"],[9,1,"しゅ"],[11,1,"い"],[18,1,"した"],[23,1,"かた"],[25,3,"よげんしゃ"],[29,1,"てき"],[35,1,"しゅ"],[37,1,"い"]],"text":"見よ、わたしは、『主は言いたもう』と舌をもって語る預言者の敵となると、主は言われる。"},{"ref":"Jer.23.32","start":24023032,"end":24023032,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"おお"],[8,1,"み"],[15,1,"いつわ"],[18,1,"ゆめ"],[20,2,"よげん"],[24,1,"もの"],[26,1,"てき"],[31,1,"かれ"],[37,1,"かた"],[44,1,"いつわ"],[47,2,"たいげん"],[57,1,"たみ"],[59,1,"まど"],[67,1,"かれ"],[83,1,"かれ"],[86,1,"めい"],[98,1,"かれ"],[103,1,"たみ"],[109,1,"えき"],[117,1,"しゅ"],[119,1,"い"]],"text":"主は仰せられる、見よ、わたしは偽りの夢を預言する者の敵となる。彼らはそれを語り、またその偽りと大言をもってわたしの民を惑わす。わたしが彼らをつかわしたのではなく、また彼らに命じたのでもない。それで彼らはこの民にすこしも益にならないと、主は言われる。"},{"ref":"Jer.23.33","start":24023033,"end":24023033,"break":"paragraph","ruby":[[2,1,"たみ"],[11,3,"よげんしゃ"],[18,2,"さいし"],[27,1,"しゅ"],[29,2,"おもに"],[39,1,"と"],[45,1,"かれ"],[48,1,"こた"],[63,2,"おもに"],[71,1,"しゅ"],[80,1,"す"],[84,1,"い"]],"text":"この民のひとり、または預言者、または祭司があなたに、『主の重荷はなんですか』と問うならば、彼らに答えなさい、『あなたがたがその重荷です。そして主は、あなたがたを捨てると言っておられます』と。"},{"ref":"Jer.23.34","start":24023034,"end":24023034,"break":"none","ruby":[[5,1,"しゅ"],[7,2,"おもに"],[11,1,"い"],[15,3,"よげんしゃ"],[19,2,"さいし"],[25,1,"たみ"],[34,2,"かぞく"],[37,1,"とも"],[43,1,"ばっ"]],"text":"そして、『主の重荷』と言うその預言者、祭司、または民のひとりを、その家族と共にわたしは罰する。"},{"ref":"Jer.23.35","start":24023035,"end":24023035,"break":"none","ruby":[[9,1,"たがい"],[12,1,"とな"],[14,1,"びと"],[19,2,"きょうだい"],[25,1,"い"],[37,1,"しゅ"],[42,1,"こた"],[53,1,"しゅ"],[58,1,"い"]],"text":"あなたがたは、みな互に、隣り人に、また兄弟に、こう言わなければならない、『主はなんと答えられましたか』、『主はなんと言われましたか』と。"},{"ref":"Jer.23.36","start":24023036,"end":24023036,"break":"none","ruby":[[3,1,"かさ"],[7,1,"しゅ"],[9,2,"おもに"],[13,1,"い"],[22,2,"おもに"],[25,1,"ひと"],[31,2,"じぶん"],[34,2,"ことば"],[49,1,"い"],[52,1,"かみ"],[54,2,"ばんぐん"],[57,1,"しゅ"],[65,1,"かみ"],[67,2,"ことば"],[70,1,"ま"],[73,1,"もの"]],"text":"しかし重ねて『主の重荷』と言ってはならない。重荷は人おのおのの自分の言葉だからである。あなたがたは生ける神、万軍の主なるわれわれの神の言葉を曲げる者である。"},{"ref":"Jer.23.37","start":24023037,"end":24023037,"break":"none","ruby":[[4,3,"よげんしゃ"],[10,1,"い"],[22,1,"しゅ"],[31,1,"こた"],[42,1,"しゅ"],[47,1,"い"]],"text":"あなたは預言者にこう言わなければならない、『主はあなたになんと答えられましたか』、『主はなんと言われましたか』と。"},{"ref":"Jer.23.38","start":24023038,"end":24023038,"break":"none","ruby":[[9,1,"しゅ"],[11,2,"おもに"],[15,1,"い"],[21,1,"しゅ"],[25,1,"おお"],[36,1,"ひと"],[57,1,"しゅ"],[59,2,"おもに"],[63,1,"い"],[72,1,"い"],[86,1,"しゅ"],[88,2,"おもに"],[94,2,"ことば"],[97,1,"い"]],"text":"もしあなたがたが『主の重荷』と言うならば、主はこう仰せられる、『わたしが人をあなたがたにつかわして、あなたがたは「主の重荷」と言ってはならないと言わせたのに、あなたがたは「主の重荷」という言葉を言ったので、"},{"ref":"Jer.23.39","start":24023039,"end":24023039,"break":"none","ruby":[[4,1,"かなら"],[12,1,"とら"],[14,1,"うつ"],[30,2,"せんぞ"],[34,1,"あた"],[39,1,"まち"],[54,1,"まえ"],[57,1,"す"],[59,1,"さ"]],"text":"わたしは必ずあなたがたを捕え移させ、あなたがたとあなたがたの先祖とに与えたこの町と、あなたがたとを、わたしの前から捨て去る。"},{"ref":"Jer.23.40","start":24023040,"end":24023040,"break":"none","ruby":[[4,1,"わす"],[14,2,"えいえん"],[23,2,"えいえん"],[26,1,"はじ"]],"text":"そして、忘れられることのない永遠のはずかしめと永遠の恥を、あなたがたにこうむらせる』」。"}]