[{"ref":"Mic.7.1","start":33007001,"end":33007001,"break":"paragraph","breaks":[[9,"line"],[29,"line"],[51,"line"],[63,"line"]],"ruby":[[13,1,"なつ"],[20,1,"あつ"],[23,1,"とき"],[33,2,"しゅうかく"],[36,1,"のこ"],[39,1,"あつ"],[42,1,"とき"],[51,1,"く"],[65,1,"こころ"],[67,1,"この"],[69,1,"はつ"]],"text":"わざわいなるかな、わたしは夏のくだものを集める時のように、ぶどうの収穫の残りを集める時のようになった。食らうべきぶどうはなく、わが心の好む初なりのいちじくもない。"},{"ref":"Mic.7.2","start":33007002,"end":33007002,"break":"line","breaks":[[24,"line"],[38,"line"]],"ruby":[[0,1,"かみ"],[2,1,"うやま"],[4,1,"ひと"],[6,1,"ち"],[8,1,"た"],[11,1,"ひと"],[16,1,"ただ"],[19,1,"もの"],[26,1,"ち"],[28,1,"なが"],[32,1,"ま"],[34,1,"ぶ"],[42,1,"あみ"],[49,2,"きょうだい"],[52,1,"とら"]],"text":"神を敬う人は地に絶え、人のうちに正しい者はない。みな血を流そうと待ち伏せし、おのおの網をもってその兄弟を捕える。"},{"ref":"Mic.7.3","start":33007003,"end":33007003,"break":"line","breaks":[[19,"line"],[35,"line"],[57,"line"]],"ruby":[[0,2,"りょうて"],[3,1,"わる"],[5,1,"こと"],[11,1,"つと"],[23,3,"さいばんかん"],[32,1,"もと"],[35,1,"おお"],[39,1,"ひと"],[43,1,"こころ"],[45,1,"わる"],[47,2,"よくぼう"],[50,1,"い"],[61,1,"かれ"],[66,1,"あく"],[68,2,"しく"]],"text":"両手は悪い事をしようと努めてやまない。つかさと裁判官はまいないを求め、大いなる人はその心の悪い欲望を言いあらわし、こうして彼らはその悪を仕組む。"},{"ref":"Mic.7.4","start":33007004,"end":33007004,"break":"line","breaks":[[17,"line"],[37,"line"],[47,"line"],[62,"line"]],"ruby":[[0,1,"かれ"],[3,1,"もっと"],[7,1,"もの"],[17,1,"もっと"],[19,1,"ただ"],[22,1,"もの"],[37,1,"かれ"],[40,2,"みはり"],[45,1,"ひ"],[51,1,"かれ"],[54,2,"けいばつ"],[57,1,"ひ"],[59,1,"く"],[65,1,"かれ"],[68,2,"こんらん"],[71,1,"ちか"]],"text":"彼らの最もよい者もいばらのごとく、最も正しい者もいばらのいけがきのようだ。彼らの見張びとの日、すなわち彼らの刑罰の日が来る。いまや彼らの混乱が近い。"},{"ref":"Mic.7.5","start":33007005,"end":33007005,"break":"line","breaks":[[19,"line"],[32,"line"],[47,"line"]],"ruby":[[6,1,"とな"],[8,1,"びと"],[10,1,"しん"],[19,2,"ゆうじん"],[41,1,"ね"],[43,1,"もの"],[51,1,"くち"],[53,1,"と"],[55,1,"まも"]],"text":"あなたがたは隣り人を信じてはならない。友人をたのんではならない。あなたのふところに寝る者にも、あなたの口の戸を守れ。"},{"ref":"Mic.7.6","start":33007006,"end":33007006,"break":"line","breaks":[[21,"line"],[35,"line"]],"ruby":[[4,1,"ちち"],[11,1,"むすめ"],[15,1,"はは"],[21,1,"よめ"],[35,1,"ひと"],[37,1,"てき"],[41,1,"いえ"],[43,1,"もの"]],"text":"むすこは父をいやしめ、娘はその母にそむき、嫁はそのしゅうとめにそむく。人の敵はその家の者である。"},{"ref":"Mic.7.7","start":33007007,"end":33007007,"break":"line","breaks":[[23,"line"]],"ruby":[[8,1,"しゅ"],[10,1,"あお"],[12,1,"み"],[16,1,"すくい"],[18,1,"かみ"],[20,1,"ま"],[25,1,"かみ"],[31,1,"ねが"],[34,1,"き"]],"text":"しかし、わたしは主を仰ぎ見、わが救の神を待つ。わが神はわたしの願いを聞かれる。"},{"ref":"Mic.7.8","start":33007008,"end":33007008,"break":"stanza","breaks":[[16,"line"],[34,"line"],[53,"line"]],"ruby":[[2,1,"てき"],[12,1,"よろこ"],[23,1,"たお"],[28,1,"お"],[41,1,"くら"],[45,1,"なか"],[53,1,"しゅ"],[57,1,"ひかり"]],"text":"わが敵よ、わたしについて喜ぶな。たといわたしが倒れるとも起きあがる。たといわたしが暗やみの中にすわるとも、主はわが光となられる。"},{"ref":"Mic.7.9","start":33007009,"end":33007009,"break":"line","breaks":[[12,"line"],[30,"line"],[50,"line"],[66,"line"],[84,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"うった"],[7,1,"と"],[23,1,"おこな"],[34,1,"しゅ"],[36,1,"いか"],[39,1,"お"],[50,1,"しゅ"],[52,1,"たい"],[55,1,"つみ"],[57,1,"おか"],[66,1,"しゅ"],[72,1,"ひかり"],[74,1,"みちび"],[76,1,"だ"],[88,1,"しゅ"],[90,2,"せいぎ"],[93,1,"み"]],"text":"主はわが訴えを取りあげ、わたしのためにさばきを行われるまで、わたしは主の怒りを負わなければならない。主に対して罪を犯したからである。主はわたしを光に導き出してくださる。わたしは主の正義を見るであろう。"},{"ref":"Mic.7.10","start":33007010,"end":33007010,"break":"line","breaks":[[20,"line"],[44,"line"],[57,"line"]],"ruby":[[2,1,"とき"],[8,1,"かみ"],[10,1,"しゅ"],[24,1,"い"],[29,1,"てき"],[35,1,"み"],[37,1,"はじ"],[46,1,"め"],[48,1,"かれ"],[50,1,"み"],[54,1,"わら"],[57,1,"かれ"],[59,2,"がいろ"],[62,1,"どろ"],[67,1,"ふ"]],"text":"その時「あなたの神、主はどこにいるか」とわたしに言ったわが敵は、これを見て恥をこうむり、わが目は彼を見てあざ笑う。彼は街路の泥のように踏みつけられる。"},{"ref":"Mic.7.11","start":33007011,"end":33007011,"break":"stanza","breaks":[[14,"line"]],"ruby":[[4,2,"じょうへき"],[7,1,"きず"],[9,1,"ひ"],[11,1,"く"],[16,1,"ひ"],[19,2,"くにざかい"],[22,1,"とお"],[24,1,"ひろ"]],"text":"あなたの城壁を築く日が来る。その日には国境が遠く広がる。"},{"ref":"Mic.7.12","start":33007012,"end":33007012,"break":"line","breaks":[[19,"line"],[33,"line"],[47,"line"]],"ruby":[[2,1,"ひ"],[29,1,"がわ"],[33,1,"うみ"],[36,1,"うみ"],[40,1,"やま"],[43,1,"やま"],[47,2,"ひとびと"],[54,1,"く"]],"text":"その日にはアッスリヤからエジプトまで、エジプトからユフラテ川まで、海から海まで、山から山まで、人々はあなたに来る。"},{"ref":"Mic.7.13","start":33007013,"end":33007013,"break":"line","breaks":[[16,"line"]],"ruby":[[5,1,"ち"],[9,2,"じゅうみん"],[23,1,"み"],[28,1,"あ"]],"text":"しかしかの地はその住民のゆえに、そのおこないの実によって荒れはてる。"},{"ref":"Mic.7.14","start":33007014,"end":33007014,"break":"stanza","breaks":[[20,"line"],[35,"line"],[47,"line"],[68,"line"]],"ruby":[[18,1,"たみ"],[24,1,"その"],[26,1,"なか"],[28,1,"はやし"],[39,1,"し"],[40,1,"ぎょう"],[42,1,"ひつじ"],[44,1,"ぼく"],[52,1,"ひ"],[68,1,"かれ"],[71,1,"やしな"]],"text":"どうか、あなたのつえをもってあなたの民、すなわち園の中の林にひとりおるあなたの嗣業の羊を牧し、いにしえの日のようにバシャンとギレアデで、彼らを養ってください。"},{"ref":"Mic.7.15","start":33007015,"end":33007015,"break":"stanza","breaks":[[19,"line"]],"ruby":[[9,1,"くに"],[11,1,"で"],[13,1,"とき"],[28,3,"ふしぎ"],[32,1,"こと"],[34,1,"かれ"],[37,1,"しめ"]],"text":"あなたがエジプトの国を出た時のように、わたしはもろもろの不思議な事を彼らに示す。"},{"ref":"Mic.7.16","start":33007016,"end":33007016,"break":"stanza","breaks":[[19,"line"],[28,"line"]],"ruby":[[0,2,"くにぐに"],[3,1,"たみ"],[5,1,"み"],[14,1,"ちから"],[16,1,"は"],[21,1,"て"],[23,1,"くち"],[30,1,"みみ"],[32,1,"きこ"],[35,1,"みみ"]],"text":"国々の民は見て、そのすべての力を恥じ、その手を口にあて、その耳は聞えぬ耳となる。"},{"ref":"Mic.7.17","start":33007017,"end":33007017,"break":"line","breaks":[[10,"line"],[26,"line"],[38,"line"],[61,"line"]],"ruby":[[0,1,"かれ"],[10,1,"ち"],[12,1,"は"],[26,1,"ふる"],[33,1,"しろ"],[36,1,"で"],[50,1,"かみ"],[52,1,"しゅ"],[54,1,"ちか"],[68,1,"おそ"]],"text":"彼らはへびのように、地に這うもののようにちりをなめ、震えながらその城から出、おののきつつ、われわれの神、主に近づいてきて、あなたのために恐れる。"},{"ref":"Mic.7.18","start":33007018,"end":33007018,"break":"stanza","breaks":[[17,"line"],[30,"line"],[46,"line"],[61,"line"]],"ruby":[[10,2,"ふぎ"],[19,1,"し"],[20,1,"ぎょう"],[22,1,"のこ"],[25,1,"もの"],[33,2,"みす"],[39,1,"かみ"],[46,1,"かみ"],[54,1,"よろこ"],[63,1,"いか"],[69,1,"たも"]],"text":"だれかあなたのように不義をゆるし、その嗣業の残れる者のためにとがを見過ごされる神があろうか。神はいつくしみを喜ばれるので、その怒りをながく保たず、"},{"ref":"Mic.7.19","start":33007019,"end":33007019,"break":"line","breaks":[[12,"line"],[30,"line"],[46,"line"]],"ruby":[[0,1,"ふたた"],[17,2,"ふぎ"],[20,1,"あし"],[22,1,"ふ"],[44,1,"つみ"],[46,1,"うみ"],[48,1,"ふか"],[51,1,"な"],[53,1,"い"]],"text":"再びわれわれをあわれみ、われわれの不義を足で踏みつけられる。あなたはわれわれのもろもろの罪を海の深みに投げ入れ、"},{"ref":"Mic.7.20","start":33007020,"end":33007020,"break":"line","breaks":[[21,"line"],[31,"line"]],"ruby":[[0,1,"むかし"],[8,2,"せんぞ"],[13,1,"ちか"],[21,2,"しんじつ"],[28,1,"しめ"],[43,1,"しめ"]],"text":"昔からわれわれの先祖たちに誓われたように、真実をヤコブに示し、いつくしみをアブラハムに示される。"}]