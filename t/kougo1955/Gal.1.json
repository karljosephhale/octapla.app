[{"ref":"Gal.1.1","start":48001001,"end":48001001,"break":"paragraph","ruby":[[0,2,"ひとびと"],[9,1,"ひと"],[28,1,"かれ"],[30,2,"しにん"],[33,1,"なか"],[43,1,"ちち"],[46,1,"かみ"],[52,1,"た"],[57,2,"しと"]],"text":"人々からでもなく、人によってでもなく、イエス・キリストと彼を死人の中からよみがえらせた父なる神とによって立てられた使徒パウロ、"},{"ref":"Gal.1.2","start":48001002,"end":48001002,"break":"none","ruby":[[8,1,"とも"],[12,2,"きょうだい"],[16,2,"いちどう"],[26,1,"しょ"],[27,2,"きょうかい"]],"text":"ならびにわたしと共にいる兄弟たち一同から、ガラテヤの諸教会へ。"},{"ref":"Gal.1.3","start":48001003,"end":48001003,"break":"paragraph","ruby":[[6,1,"ちち"],[9,1,"かみ"],[11,1,"しゅ"],[23,1,"めぐ"],[26,2,"へいあん"]],"text":"わたしたちの父なる神と主イエス・キリストから、恵みと平安とが、あなたがたにあるように。"},{"ref":"Gal.1.4","start":48001004,"end":48001004,"break":"none","ruby":[[12,1,"ちち"],[15,1,"かみ"],[17,2,"みむね"],[20,1,"したが"],[29,1,"いま"],[31,1,"あく"],[33,1,"よ"],[36,1,"すく"],[38,1,"だ"],[46,2,"じしん"],[55,1,"つみ"]],"text":"キリストは、わたしたちの父なる神の御旨に従い、わたしたちを今の悪の世から救い出そうとして、ご自身をわたしたちの罪のためにささげられたのである。"},{"ref":"Gal.1.5","start":48001005,"end":48001005,"break":"none","ruby":[[0,2,"えいこう"],[3,2,"よよ"],[5,1,"かぎ"],[9,1,"かみ"]],"text":"栄光が世々限りなく神にあるように、アァメン。"},{"ref":"Gal.1.6","start":48001006,"end":48001006,"break":"paragraph","ruby":[[11,1,"はや"],[25,1,"めぐ"],[28,1,"うち"],[31,1,"まね"],[41,1,"はな"],[45,1,"ちが"],[48,2,"ふくいん"],[51,1,"お"],[65,3,"ふしぎ"]],"text":"あなたがたがこんなにも早く、あなたがたをキリストの恵みの内へお招きになったかたから離れて、違った福音に落ちていくことが、わたしには不思議でならない。"},{"ref":"Gal.1.7","start":48001007,"end":48001007,"break":"none","ruby":[[3,2,"ふくいん"],[22,1,"たね"],[24,2,"ひとびと"],[35,1,"みだ"],[43,2,"ふくいん"],[46,1,"ま"]],"text":"それは福音というべきものではなく、ただ、ある種の人々があなたがたをかき乱し、キリストの福音を曲げようとしているだけのことである。"},{"ref":"Gal.1.8","start":48001008,"end":48001008,"break":"none","ruby":[[18,1,"てん"],[22,2,"みつかい"],[36,1,"の"],[38,1,"つた"],[41,2,"ふくいん"],[44,1,"はん"],[56,1,"の"],[58,1,"つた"],[66,1,"ひと"]],"text":"しかし、たといわたしたちであろうと、天からの御使であろうと、わたしたちが宣べ伝えた福音に反することをあなたがたに宣べ伝えるなら、その人はのろわるべきである。"},{"ref":"Gal.1.9","start":48001009,"end":48001009,"break":"none","ruby":[[6,1,"まえ"],[8,1,"い"],[18,1,"いま"],[23,1,"かさ"],[26,1,"い"],[33,1,"ひと"],[42,1,"う"],[47,2,"ふくいん"],[50,1,"はん"],[56,1,"の"],[58,1,"つた"],[68,1,"ひと"]],"text":"わたしたちが前に言っておいたように、今わたしは重ねて言う。もしある人が、あなたがたの受けいれた福音に反することを宣べ伝えているなら、その人はのろわるべきである。"},{"ref":"Gal.1.10","start":48001010,"end":48001010,"break":"paragraph","ruby":[[0,1,"いま"],[6,1,"ひと"],[8,1,"よろこ"],[26,1,"かみ"],[28,1,"よろこ"],[46,1,"ひと"],[48,2,"かんしん"],[51,1,"か"],[55,1,"つと"],[66,1,"いま"],[70,1,"ひと"],[72,2,"かんしん"],[75,1,"か"],[97,1,"しもべ"]],"text":"今わたしは、人に喜ばれようとしているのか、それとも、神に喜ばれようとしているのか。あるいは、人の歓心を買おうと努めているのか。もし、今もなお人の歓心を買おうとしているとすれば、わたしはキリストの僕ではあるまい。"},{"ref":"Gal.1.11","start":48001011,"end":48001011,"break":"paragraph","ruby":[[0,2,"きょうだい"],[17,1,"い"],[27,1,"の"],[29,1,"つた"],[32,2,"ふくいん"],[35,2,"にんげん"]],"text":"兄弟たちよ。あなたがたに、はっきり言っておく。わたしが宣べ伝えた福音は人間によるものではない。"},{"ref":"Gal.1.12","start":48001012,"end":48001012,"break":"none","ruby":[[8,2,"にんげん"],[12,1,"う"],[18,1,"おし"],[40,2,"けいじ"]],"text":"わたしは、それを人間から受けたのでも教えられたのでもなく、ただイエス・キリストの啓示によったのである。"},{"ref":"Gal.1.13","start":48001013,"end":48001013,"break":"none","ruby":[[3,1,"きょう"],[5,1,"しん"],[17,2,"こうどう"],[36,1,"き"],[51,1,"はげ"],[54,1,"かみ"],[56,2,"きょうかい"],[59,2,"はくがい"],[65,1,"あら"]],"text":"ユダヤ教を信じていたころのわたしの行動については、あなたがたはすでによく聞いている。すなわち、わたしは激しく神の教会を迫害し、また荒しまわっていた。"},{"ref":"Gal.1.14","start":48001014,"end":48001014,"break":"none","ruby":[[4,3,"どうこくじん"],[8,1,"なか"],[14,3,"どうねんぱい"],[18,1,"おお"],[21,1,"もの"],[30,1,"きょう"],[32,2,"しょうじん"],[36,2,"せんぞ"],[41,2,"いいつた"],[45,1,"たい"],[58,2,"ねっしん"]],"text":"そして、同国人の中でわたしと同年輩の多くの者にまさってユダヤ教に精進し、先祖たちの言伝えに対して、だれよりもはるかに熱心であった。"},{"ref":"Gal.1.15","start":48001015,"end":48001015,"break":"none","ruby":[[5,1,"はは"],[7,2,"たいない"],[12,1,"とき"],[19,1,"せい"],[20,1,"べつ"],[24,1,"めぐ"],[35,1,"め"]],"text":"ところが、母の胎内にある時からわたしを聖別し、み恵みをもってわたしをお召しになったかたが、"},{"ref":"Gal.1.16","start":48001016,"end":48001016,"break":"none","ruby":[[0,3,"いほうじん"],[4,1,"あいだ"],[6,1,"の"],[8,1,"つた"],[17,2,"みこ"],[24,1,"うち"],[26,2,"けいじ"],[30,1,"くだ"],[34,1,"とき"],[40,1,"ただ"],[44,2,"けつにく"],[47,2,"そうだん"]],"text":"異邦人の間に宣べ伝えさせるために、御子をわたしの内に啓示して下さった時、わたしは直ちに、血肉に相談もせず、"},{"ref":"Gal.1.17","start":48001017,"end":48001017,"break":"none","ruby":[[2,2,"せんぱい"],[5,2,"しと"],[10,1,"あ"],[22,1,"のぼ"],[31,1,"で"],[33,1,"い"],[41,1,"ふたた"],[48,1,"かえ"]],"text":"また先輩の使徒たちに会うためにエルサレムにも上らず、アラビヤに出て行った。それから再びダマスコに帰った。"},{"ref":"Gal.1.18","start":48001018,"end":48001018,"break":"paragraph","ruby":[[2,1,"のち"],[4,1,"ねん"],[28,1,"のぼ"],[31,1,"かれ"],[38,2,"にちかん"],[41,2,"たいざい"]],"text":"その後三年たってから、わたしはケパをたずねてエルサレムに上り、彼のもとに十五日間、滞在した。"},{"ref":"Gal.1.19","start":48001019,"end":48001019,"break":"none","ruby":[[4,1,"しゅ"],[6,2,"きょうだい"],[11,2,"いがい"],[21,2,"しと"],[25,1,"あ"]],"text":"しかし、主の兄弟ヤコブ以外には、ほかのどの使徒にも会わなかった。"},{"ref":"Gal.1.20","start":48001020,"end":48001020,"break":"none","ruby":[[3,1,"か"],[12,1,"かみ"],[18,1,"い"],[22,1,"けっ"],[25,1,"いつわ"]],"text":"ここに書いていることは、神のみまえで言うが、決して偽りではない。"},{"ref":"Gal.1.21","start":48001021,"end":48001021,"break":"none","ruby":[[2,1,"のち"],[18,2,"ちほう"],[21,1,"い"]],"text":"その後、わたしはシリヤとキリキヤとの地方に行った。"},{"ref":"Gal.1.22","start":48001022,"end":48001022,"break":"none","ruby":[[15,1,"しょ"],[16,2,"きょうかい"],[21,1,"かお"],[23,1,"し"]],"text":"しかし、キリストにあるユダヤの諸教会には、顔を知られていなかった。"},{"ref":"Gal.1.23","start":48001023,"end":48001023,"break":"none","ruby":[[2,1,"かれ"],[10,2,"じぶん"],[15,2,"はくがい"],[19,1,"もの"],[22,2,"いぜん"],[26,2,"ぼくめつ"],[38,2,"しんこう"],[42,1,"いま"],[44,1,"の"],[46,1,"つた"],[53,1,"き"]],"text":"ただ彼らは、「かつて自分たちを迫害した者が、以前には撲滅しようとしていたその信仰を、今は宣べ伝えている」と聞き、"},{"ref":"Gal.1.24","start":48001024,"end":48001024,"break":"none","ruby":[[8,1,"かみ"]],"text":"わたしのことで、神をほめたたえた。"}]