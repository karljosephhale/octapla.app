[{"ref":"Jer.27.1","start":24027001,"end":24027001,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"こ"],[14,1,"よ"],[16,1,"おさ"],[18,1,"はじ"],[26,2,"ことば"],[29,1,"しゅ"],[37,1,"のぞ"]],"text":"ユダの王ヨシヤの子ゼデキヤが世を治め始めたころ、この言葉が主からエレミヤに臨んだ。"},{"ref":"Jer.27.2","start":24027002,"end":24027002,"break":"none","ruby":[[4,1,"しゅ"],[12,1,"おお"],[19,1,"つな"],[27,1,"つく"],[38,1,"くび"]],"text":"すなわち主はこうわたしに仰せられた、「綱と、くびきとを作って、それをあなたの首につけ、"},{"ref":"Jer.27.3","start":24027003,"end":24027003,"break":"none","ruby":[[11,1,"おう"],[17,1,"ところ"],[19,1,"き"],[21,2,"ししゃ"],[34,1,"おう"],[40,1,"おう"],[49,1,"おう"],[54,1,"おう"],[60,1,"おう"],[62,1,"い"]],"text":"エルサレムにいるユダの王ゼデキヤの所に来た使者たちによって、エドムの王、モアブの王、アンモンびとの王、ツロの王、シドンの王に言いおくりなさい。"},{"ref":"Jer.27.4","start":24027004,"end":24027004,"break":"none","ruby":[[0,1,"かれ"],[3,2,"しゅくん"],[8,1,"いのち"],[10,1,"つた"],[19,2,"ばんぐん"],[22,1,"しゅ"],[30,1,"かみ"],[34,1,"おお"],[46,2,"しゅくん"],[54,1,"つ"]],"text":"彼らの主君にこの命を伝えさせなさい、『万軍の主、イスラエルの神はこう仰せられる、あなたがたは主君にこのように告げなければならない。"},{"ref":"Jer.27.5","start":24027005,"end":24027005,"break":"none","ruby":[[4,1,"おお"],[8,1,"ちから"],[10,1,"の"],[13,1,"うで"],[20,1,"ち"],[22,1,"ち"],[24,1,"うえ"],[28,1,"ひと"],[30,1,"けもの"],[37,1,"もの"],[45,1,"こころ"],[50,1,"ち"],[52,1,"ひと"],[54,1,"あた"]],"text":"わたしは大いなる力と伸べた腕とをもって、地と地の上にいる人と獣とをつくった者である。そして心のままに地を人に与える。"},{"ref":"Jer.27.6","start":24027006,"end":24027006,"break":"none","ruby":[[12,1,"くに"],[30,1,"おう"],[39,1,"て"],[41,1,"あた"],[46,1,"の"],[48,1,"けもの"],[51,1,"かれ"],[53,1,"あた"],[56,1,"かれ"],[58,1,"つか"]],"text":"いまわたしはこのすべての国を、わたしのしもべであるバビロンの王ネブカデネザルの手に与え、また野の獣をも彼に与えて彼に仕えさせた。"},{"ref":"Jer.27.7","start":24027007,"end":24027007,"break":"none","ruby":[[0,1,"かれ"],[2,1,"ち"],[4,1,"とき"],[11,3,"ばんこくみん"],[15,1,"かれ"],[19,1,"こ"],[23,1,"まご"],[25,1,"つか"],[31,1,"とき"],[39,1,"おお"],[42,1,"くに"],[44,1,"おお"],[48,1,"おう"],[53,1,"かれ"],[55,2,"じぶん"],[58,2,"どれい"]],"text":"彼の地に時がくるまで、万国民は彼とその子とその孫に仕える。その時がくるならば、多くの国と大いなる王たちとが彼を自分の奴隷にする。"},{"ref":"Jer.27.8","start":24027008,"end":24027008,"break":"paragraph","ruby":[[5,1,"おう"],[14,1,"つか"],[23,1,"おう"],[29,2,"じぶん"],[32,1,"くび"],[34,1,"お"],[38,1,"たみ"],[40,1,"くに"],[58,2,"えきびょう"],[64,1,"ばっ"],[71,1,"かれ"],[73,1,"て"],[83,1,"ほろ"],[87,1,"しゅ"],[89,1,"い"]],"text":"バビロンの王ネブカデネザルに仕えず、バビロンの王のくびきを自分の首に負わない民と国とは、わたしがつるぎと、ききんと、疫病をもって罰し、ついには彼の手によってことごとく滅ぼすと主は言われる。"},{"ref":"Jer.27.9","start":24027009,"end":24027009,"break":"none","ruby":[[10,3,"よげんしゃ"],[14,1,"うらな"],[16,1,"し"],[18,1,"ゆめ"],[21,1,"もの"],[23,1,"ほう"],[24,1,"じゅつ"],[25,1,"し"],[27,3,"まほうつかい"],[44,1,"おう"],[46,1,"つか"],[56,1,"い"],[61,1,"き"]],"text":"それで、あなたがたの預言者、占い師、夢みる者、法術師、魔法使が、「あなたがたはバビロンの王に仕えることはない」と言っても、聞いてはならない。"},{"ref":"Jer.27.10","start":24027010,"end":24027010,"break":"none","ruby":[[0,1,"かれ"],[9,1,"いつわ"],[12,2,"よげん"],[23,2,"じぶん"],[26,1,"くに"],[29,1,"とお"],[31,1,"はな"],[47,1,"お"],[49,1,"だ"],[58,1,"ほろ"]],"text":"彼らはあなたがたに偽りを預言して、あなたがたを自分の国から遠く離れさせ、わたしに、あなたがたを追い出してあなたがたを滅ぼさせるのである。"},{"ref":"Jer.27.11","start":24027011,"end":24027011,"break":"none","ruby":[[8,1,"おう"],[14,1,"くび"],[16,1,"お"],[20,1,"かれ"],[22,1,"つか"],[25,2,"こくみん"],[35,2,"ここく"],[38,1,"のこ"],[45,1,"たがや"],[52,1,"す"],[58,1,"しゅ"],[60,1,"い"]],"text":"しかしバビロンの王のくびきを首に負って、彼に仕える国民を、わたしはその故国に残らせ、それを耕して、そこに住まわせると主は言われる』」。"},{"ref":"Jer.27.12","start":24027012,"end":24027012,"break":"paragraph","ruby":[[7,1,"おう"],[14,1,"おな"],[19,1,"い"],[36,1,"おう"],[42,2,"じぶん"],[45,1,"くび"],[47,1,"お"],[51,1,"かれ"],[55,1,"たみ"],[58,1,"つか"],[64,1,"い"]],"text":"わたしはユダの王ゼデキヤにも同じように言った、「あなたがたは、バビロンの王のくびきを自分の首に負って、彼とその民とに仕え、そして生きなさい。"},{"ref":"Jer.27.13","start":24027013,"end":24027013,"break":"none","ruby":[[13,1,"たみ"],[17,1,"しゅ"],[24,1,"おう"],[26,1,"つか"],[30,2,"こくみん"],[36,1,"い"],[54,2,"えきびょう"],[57,1,"し"]],"text":"どうしてあなたと、あなたの民とが、主がバビロンの王に仕えない国民について言われたように、つるぎと、ききんと、疫病に死んでよかろうか。"},{"ref":"Jer.27.14","start":24027014,"end":24027014,"break":"none","ruby":[[11,1,"おう"],[13,1,"つか"],[28,1,"つ"],[31,3,"よげんしゃ"],[35,2,"ことば"],[38,1,"き"],[47,1,"かれ"],[56,2,"よげん"],[65,1,"いつわ"]],"text":"あなたがたはバビロンの王に仕えることはないとあなたがたに告げる預言者の言葉を聞いてはならない。彼らがあなたがたに預言していることは偽りであるからだ。"},{"ref":"Jer.27.15","start":24027015,"end":24027015,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[11,1,"かれ"],[27,1,"かれ"],[34,1,"な"],[39,1,"いつわ"],[42,2,"よげん"],[65,1,"お"],[67,1,"はら"],[83,2,"よげん"],[87,3,"よげんしゃ"],[93,1,"ほろ"]],"text":"主は言われる、わたしが彼らをつかわしたのではないのに、彼らはわたしの名によって偽って預言している。そのために、わたしはあなたがたを追い払い、あなたがたと、あなたがたに預言する預言者たちを滅ぼすようになるのだ」。"},{"ref":"Jer.27.16","start":24027016,"end":24027016,"break":"paragraph","ruby":[[6,2,"さいし"],[15,1,"たみ"],[18,1,"かた"],[21,1,"い"],[26,1,"しゅ"],[30,1,"おお"],[37,1,"み"],[40,1,"しゅ"],[42,1,"みや"],[44,1,"うつわ"],[46,1,"いま"],[60,1,"かえ"],[74,2,"よげん"],[78,3,"よげんしゃ"],[82,2,"ことば"],[85,1,"き"],[98,1,"かれ"],[107,2,"よげん"],[116,1,"いつわ"]],"text":"わたしはまた祭司とこのすべての民とに語って言った、「主はこう仰せられる、『見よ、主の宮の器は今、すみやかに、バビロンから返されてくる』とあなたがたに預言する預言者の言葉を聞いてはならない。それは、彼らがあなたがたに預言していることは偽りであるからだ。"},{"ref":"Jer.27.17","start":24027017,"end":24027017,"break":"none","ruby":[[0,1,"かれ"],[8,1,"き"],[22,1,"おう"],[24,1,"つか"],[30,1,"い"],[42,1,"まち"],[44,1,"あ"],[46,1,"ち"]],"text":"彼らのいうことを聞いてはならない。バビロンの王に仕え、そして生きなさい。どうしてこの町が荒れ地となってよかろうか。"},{"ref":"Jer.27.18","start":24027018,"end":24027018,"break":"none","ruby":[[2,1,"かれ"],[5,3,"よげんしゃ"],[13,1,"しゅ"],[15,2,"ことば"],[18,1,"かれ"],[32,1,"しゅ"],[34,1,"みや"],[39,1,"おう"],[41,2,"きゅうでん"],[51,1,"のこ"],[57,1,"うつわ"],[65,1,"うつ"],[74,2,"ばんぐん"],[77,1,"しゅ"],[85,1,"ねが"]],"text":"もし彼らが預言者であって、主の言葉が彼らのうちにあるのであれば、主の宮とユダの王の宮殿とエルサレムとに残されている器が、バビロンに移されないように、万軍の主に、とりなしを願うべきだ。"},{"ref":"Jer.27.19","start":24027019,"end":24027019,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"はしら"],[7,1,"うみ"],[9,1,"だい"],[13,1,"た"],[16,1,"まち"],[18,1,"のこ"],[23,1,"うつわ"],[31,1,"おお"]],"text":"万軍の主は柱と海と台、その他この町に残っている器について、こう仰せられる。"},{"ref":"Jer.27.20","start":24027020,"end":24027020,"break":"none","ruby":[[8,1,"おう"],[21,1,"おう"],[28,1,"こ"],[50,2,"みぶん"],[53,1,"たっと"],[55,2,"ひとびと"],[58,1,"とら"],[73,1,"うつ"],[80,1,"も"],[82,1,"さ"],[88,1,"うつわ"]],"text":"これはバビロンの王ネブカデネザルが、ユダの王エホヤキムの子エコニヤ、およびユダとエルサレムのすべての身分の尊い人々を捕えてエルサレムからバビロンに移したときに、持ち去らなかった器である。――"},{"ref":"Jer.27.21","start":24027021,"end":24027021,"break":"none","ruby":[[4,2,"ばんぐん"],[7,1,"しゅ"],[15,1,"かみ"],[18,1,"しゅ"],[20,1,"みや"],[25,1,"おう"],[27,2,"きゅうでん"],[37,1,"のこ"],[43,1,"うつわ"],[51,1,"おお"]],"text":"すなわち万軍の主、イスラエルの神は、主の宮とユダの王の宮殿とエルサレムとに残されている器について、こう仰せられる。"},{"ref":"Jer.27.22","start":24027022,"end":24027022,"break":"none","ruby":[[9,1,"たずさ"],[11,1,"い"],[19,1,"かえり"],[22,1,"ひ"],[37,1,"のち"],[53,1,"ところ"],[55,1,"たずさ"],[57,1,"かえ"],[62,1,"しゅ"],[64,1,"い"]],"text":"これらはバビロンに携え行かれ、わたしが顧みる日までそこにおかれている。その後、わたしはこれらのものを、この所に携え帰らせると主は言われる」。"}]