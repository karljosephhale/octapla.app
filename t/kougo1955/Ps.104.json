[{"ref":"Ps.104.1","start":19104001,"end":19104001,"break":"paragraph","breaks":[[14,"line"],[33,"line"]],"ruby":[[8,1,"しゅ"],[16,1,"かみ"],[18,1,"しゅ"],[28,1,"おお"],[33,1,"ほまれ"],[35,2,"いげん"],[39,1,"き"]],"text":"わがたましいよ、主をほめよ。わが神、主よ、あなたはいとも大いにして誉と威厳とを着、"},{"ref":"Ps.104.2","start":19104002,"end":19104002,"break":"line","ruby":[[0,1,"ひかり"],[2,1,"ころも"],[11,1,"てん"],[13,1,"まく"],[18,1,"は"]],"text":"光を衣のようにまとい、天を幕のように張り、"},{"ref":"Ps.104.3","start":19104003,"end":19104003,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"みず"],[2,1,"うえ"],[7,2,"たかどの"],[18,1,"くも"],[27,1,"ぐるま"],[31,1,"かぜ"],[33,1,"つばさ"],[35,1,"の"]],"text":"水の上におのが高殿のうつばりをおき、雲をおのれのいくさ車とし、風の翼に乗りあるき、"},{"ref":"Ps.104.4","start":19104004,"end":19104004,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"かぜ"],[6,2,"ししゃ"],[11,1,"ひ"],[13,1,"ほのお"]],"text":"風をおのれの使者とし、火と炎をおのれのしもべとされる。"},{"ref":"Ps.104.5","start":19104005,"end":19104005,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"ち"],[8,1,"もとい"],[10,1,"うえ"],[21,1,"うご"]],"text":"あなたは地をその基の上にすえて、とこしえに動くことのないようにされた。"},{"ref":"Ps.104.6","start":19104006,"end":19104006,"break":"line","breaks":[[24,"line"]],"ruby":[[7,1,"ころも"],[15,2,"おおみず"],[24,1,"みず"],[30,2,"やまやま"],[33,1,"うえ"],[35,1,"こ"]],"text":"あなたはこれを衣でおおうように大水でおおわれた。水はたたえて山々の上を越えた。"},{"ref":"Ps.104.7","start":19104007,"end":19104007,"break":"line","breaks":[[16,"line"]],"ruby":[[11,1,"みず"],[13,1,"しりぞ"],[20,1,"かみなり"],[22,1,"こえ"],[27,1,"みず"],[29,1,"に"],[31,1,"さ"]],"text":"あなたのとがめによって水は退き、あなたの雷の声によって水は逃げ去った。"},{"ref":"Ps.104.8","start":19104008,"end":19104008,"break":"line","breaks":[[8,"line"]],"ruby":[[0,1,"やま"],[2,1,"た"],[8,1,"たに"],[14,1,"さだ"],[19,1,"ところ"],[21,1,"しず"]],"text":"山は立ちあがり、谷はあなたが定められた所に沈んだ。"},{"ref":"Ps.104.9","start":19104009,"end":19104009,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"みず"],[6,1,"さかい"],[8,1,"さだ"],[15,1,"こ"],[21,1,"ふたた"],[23,1,"ち"]],"text":"あなたは水に境を定めて、これを越えさせず、再び地をおおうことのないようにされた。"},{"ref":"Ps.104.10","start":19104010,"end":19104010,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"いずみ"],[6,1,"たに"],[10,1,"で"],[17,2,"やまやま"],[20,1,"あいだ"],[22,1,"なが"]],"text":"あなたは泉を谷にわき出させ、それを山々の間に流れさせ、"},{"ref":"Ps.104.11","start":19104011,"end":19104011,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"の"],[7,1,"けもの"],[9,1,"の"],[16,1,"の"]],"text":"野のもろもろの獣に飲ませられる。野のろばもそのかわきをいやす。"},{"ref":"Ps.104.12","start":19104012,"end":19104012,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"そら"],[2,1,"とり"],[10,1,"す"],[17,1,"あいだ"],[23,1,"うた"]],"text":"空の鳥もそのほとりに住み、こずえの間にさえずり歌う。"},{"ref":"Ps.104.13","start":19104013,"end":19104013,"break":"line","breaks":[[24,"line"]],"ruby":[[6,2,"たかどの"],[15,1,"やま"],[17,1,"みず"],[19,1,"そそ"],[24,1,"ち"],[34,1,"み"],[39,1,"み"]],"text":"あなたはその高殿からもろもろの山に水を注がれる。地はあなたのみわざの実をもって満たされる。"},{"ref":"Ps.104.14","start":19104014,"end":19104014,"break":"line","breaks":[[17,"line"],[37,"line"]],"ruby":[[4,2,"かちく"],[10,1,"くさ"],[19,1,"ひと"],[26,2,"さいばい"],[30,2,"しょくぶつ"],[33,1,"あた"],[37,1,"ち"],[40,2,"しょくもつ"],[43,1,"だ"]],"text":"あなたは家畜のために草をはえさせ、また人のためにその栽培する植物を与えて、地から食物を出させられる。"},{"ref":"Ps.104.15","start":19104015,"end":19104015,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[4,1,"ひと"],[6,1,"こころ"],[8,1,"よろこ"],[14,1,"しゅ"],[18,1,"かお"],[27,1,"あぶら"],[29,1,"ひと"],[31,1,"こころ"],[33,1,"つよ"]],"text":"すなわち人の心を喜ばすぶどう酒、その顔をつややかにする油、人の心を強くするパンなどである。"},{"ref":"Ps.104.16","start":19104016,"end":19104016,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"き"],[5,1,"しゅ"],[8,1,"う"],[19,2,"こうはく"],[23,1,"ゆた"],[26,1,"うるお"]],"text":"主の木と、主がお植えになったレバノンの香柏とは豊かに潤され、"},{"ref":"Ps.104.17","start":19104017,"end":19104017,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"とり"],[4,1,"なか"],[6,1,"す"],[21,1,"き"]],"text":"鳥はその中に巣をつくり、こうのとりはもみの木をそのすまいとする。"},{"ref":"Ps.104.18","start":19104018,"end":19104018,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"たか"],[2,1,"やま"],[11,1,"いわ"],[13,1,"いわ"],[18,1,"かく"],[21,1,"ところ"]],"text":"高き山はやぎのすまい、岩は岩だぬきの隠れる所である。"},{"ref":"Ps.104.19","start":19104019,"end":19104019,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"つき"],[6,1,"つく"],[9,2,"きせつ"],[12,1,"さだ"],[18,1,"ひ"],[22,1,"い"],[24,1,"とき"],[26,1,"し"]],"text":"あなたは月を造って季節を定められた。日はその入る時を知っている。"},{"ref":"Ps.104.20","start":19104020,"end":19104020,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"くら"],[8,1,"つく"],[11,1,"よる"],[19,1,"とき"],[21,1,"はやし"],[23,1,"けもの"],[25,1,"みな"],[26,1,"しの"],[28,1,"で"]],"text":"あなたは暗やみを造って夜とされた。その時、林の獣は皆忍び出る。"},{"ref":"Ps.104.21","start":19104021,"end":19104021,"break":"line","ruby":[[0,1,"わか"],[11,1,"もと"],[14,1,"かみ"],[16,2,"しょくもつ"],[19,1,"もと"]],"text":"若きししはほえてえさを求め、神に食物を求める。"},{"ref":"Ps.104.22","start":19104022,"end":19104022,"break":"line","ruby":[[0,1,"ひ"],[2,1,"で"],[5,1,"しりぞ"],[11,1,"あな"],[13,1,"ね"]],"text":"日が出ると退いて、その穴に寝る。"},{"ref":"Ps.104.23","start":19104023,"end":19104023,"break":"line","ruby":[[0,1,"ひと"],[2,1,"で"],[12,2,"きんろう"],[15,1,"ゆう"],[18,1,"およ"]],"text":"人は出てわざにつき、その勤労は夕べに及ぶ。"},{"ref":"Ps.104.24","start":19104024,"end":19104024,"break":"line","breaks":[[23,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[14,1,"おお"],[33,2,"ちえ"],[39,1,"つく"],[44,1,"ち"],[50,1,"つく"],[57,1,"み"]],"text":"主よ、あなたのみわざはいかに多いことであろう。あなたはこれらをみな知恵をもって造られた。地はあなたの造られたもので満ちている。"},{"ref":"Ps.104.25","start":19104025,"end":19104025,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"おお"],[8,1,"ひろ"],[10,1,"うみ"],[17,1,"なか"],[19,2,"むすう"],[25,2,"だいしょう"],[28,1,"い"],[30,1,"もの"],[32,1,"み"]],"text":"かしこに大いなる広い海がある。その中に無数のもの、大小の生き物が満ちている。"},{"ref":"Ps.104.26","start":19104026,"end":19104026,"break":"line","breaks":[[8,"line"]],"ruby":[[3,1,"ふね"],[5,1,"はし"],[12,1,"つく"],[24,1,"なか"],[26,1,"たわむ"]],"text":"そこに舟が走り、あなたが造られたレビヤタンはその中に戯れる。"},{"ref":"Ps.104.27","start":19104027,"end":19104027,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"みな"],[8,1,"とき"],[15,2,"しょくもつ"],[19,1,"あた"],[26,2,"きたい"]],"text":"彼らは皆あなたが時にしたがって食物をお与えになるのを期待している。"},{"ref":"Ps.104.28","start":19104028,"end":19104028,"break":"line","breaks":[[22,"line"]],"ruby":[[5,1,"あた"],[12,1,"かれ"],[18,1,"あつ"],[26,1,"て"],[28,1,"ひら"],[34,1,"かれ"],[37,1,"よ"],[39,1,"もの"],[41,1,"み"]],"text":"あなたがお与えになると、彼らはそれを集める。あなたが手を開かれると、彼らは良い物で満たされる。"},{"ref":"Ps.104.29","start":19104029,"end":19104029,"break":"line","breaks":[[24,"line"],[41,"line"]],"ruby":[[5,1,"かお"],[7,1,"かく"],[13,1,"かれ"],[28,1,"かれ"],[31,1,"いき"],[33,1,"と"],[35,1,"さ"],[41,1,"かれ"],[44,1,"し"],[50,1,"かえ"]],"text":"あなたがみ顔を隠されると、彼らはあわてふためく。あなたが彼らの息を取り去られると、彼らは死んでちりに帰る。"},{"ref":"Ps.104.30","start":19104030,"end":19104030,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"れい"],[6,1,"おく"],[12,1,"かれ"],[15,1,"つく"],[24,1,"ち"],[30,1,"あら"]],"text":"あなたが霊を送られると、彼らは造られる。あなたは地のおもてを新たにされる。"},{"ref":"Ps.104.31","start":19104031,"end":19104031,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"しゅ"],[6,2,"えいこう"],[20,1,"しゅ"],[28,1,"よろこ"]],"text":"どうか、主の栄光がとこしえにあるように。主がそのみわざを喜ばれるように。"},{"ref":"Ps.104.32","start":19104032,"end":19104032,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"ち"],[4,1,"み"],[10,1,"ち"],[12,1,"ふる"],[15,1,"やま"],[17,1,"ふ"],[24,1,"けむり"]],"text":"主が地を見られると、地は震い、山に触れられると、煙をいだす。"},{"ref":"Ps.104.33","start":19104033,"end":19104033,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"い"],[11,1,"しゅ"],[17,1,"うた"],[25,1,"あいだ"],[29,1,"かみ"],[33,1,"うた"]],"text":"わたしは生きるかぎり、主にむかって歌い、ながらえる間はわが神をほめ歌おう。"},{"ref":"Ps.104.34","start":19104034,"end":19104034,"break":"line","breaks":[[21,"line"]],"ruby":[[8,1,"おも"],[11,1,"しゅ"],[13,1,"よろこ"],[25,1,"しゅ"],[30,1,"よろこ"]],"text":"どうか、わたしの思いが主に喜ばれるように。わたしは主によって喜ぶ。"},{"ref":"Ps.104.35","start":19104035,"end":19104035,"break":"line","breaks":[[18,"line"],[37,"line"],[51,"line"]],"ruby":[[4,1,"つみ"],[8,1,"ち"],[11,1,"た"],[13,1,"ほろ"],[18,1,"あ"],[21,1,"もの"],[45,1,"しゅ"],[51,1,"しゅ"]],"text":"どうか、罪びとが地から断ち滅ぼされ、悪しき者が、もはや、いなくなるように。わがたましいよ、主をほめよ。主をほめたたえよ。"}]