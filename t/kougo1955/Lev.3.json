[{"ref":"Lev.3.1","start":3003001,"end":3003001,"break":"paragraph","ruby":[[2,1,"かれ"],[4,1,"そな"],[6,1,"もの"],[8,3,"しゅうおんさい"],[12,2,"ぎせい"],[19,1,"うし"],[31,2,"しゆう"],[42,1,"まった"],[47,1,"しゅ"],[49,1,"まえ"]],"text":"もし彼の供え物が酬恩祭の犠牲であって、牛をささげるのであれば、雌雄いずれであっても、全きものを主の前にささげなければならない。"},{"ref":"Lev.3.2","start":3003002,"end":3003002,"break":"none","ruby":[[0,1,"かれ"],[4,1,"そな"],[6,1,"もの"],[8,1,"あたま"],[10,1,"て"],[12,1,"お"],[15,2,"かいけん"],[18,2,"まくや"],[21,2,"いりぐち"],[47,1,"こ"],[50,2,"さいし"],[58,1,"ち"],[60,2,"さいだん"],[63,2,"しゅうい"],[66,1,"そそ"]],"text":"彼はその供え物の頭に手を置き、会見の幕屋の入口で、これをほふらなければならない。そしてアロンの子なる祭司たちは、その血を祭壇の周囲に注ぎかけなければならない。"},{"ref":"Lev.3.3","start":3003003,"end":3003003,"break":"none","ruby":[[0,1,"かれ"],[6,3,"しゅうおんさい"],[10,2,"ぎせい"],[17,2,"かさい"],[20,1,"しゅ"],[38,2,"ないぞう"],[44,2,"しぼう"],[48,2,"ないぞう"],[51,1,"うえ"],[57,2,"しぼう"]],"text":"彼はまたその酬恩祭の犠牲のうちから火祭を主にささげなければならない。すなわち内臓をおおう脂肪と、内臓の上のすべての脂肪、"},{"ref":"Lev.3.4","start":3003004,"end":3003004,"break":"none","ruby":[[3,2,"じんぞう"],[8,1,"うえ"],[10,1,"こし"],[18,2,"しぼう"],[25,2,"じんぞう"],[28,1,"とも"],[34,2,"かんぞう"],[37,1,"うえ"],[39,2,"しょうよう"]],"text":"二つの腎臓とその上の腰のあたりにある脂肪、ならびに腎臓と共にとられる肝臓の上の小葉である。"},{"ref":"Lev.3.5","start":3003005,"end":3003005,"break":"none","ruby":[[7,1,"こ"],[11,2,"さいだん"],[14,1,"うえ"],[17,1,"ひ"],[19,1,"うえ"],[25,1,"うえ"],[27,1,"お"],[30,2,"はんさい"],[33,1,"うえ"],[39,1,"や"],[53,2,"かさい"],[60,1,"しゅ"],[66,1,"こう"]],"text":"そしてアロンの子たちは祭壇の上で、火の上のたきぎの上に置いた燔祭の上で、これを焼かなければならない。これは火祭であって、主にささげる香ばしいかおりである。"},{"ref":"Lev.3.6","start":3003006,"end":3003006,"break":"paragraph","ruby":[[2,1,"かれ"],[4,1,"そな"],[6,1,"もの"],[8,1,"しゅ"],[14,3,"しゅうおんさい"],[18,2,"ぎせい"],[25,1,"ひつじ"],[33,2,"しゆう"],[44,1,"まった"]],"text":"もし彼の供え物が主にささげる酬恩祭の犠牲で、それが羊であるならば、雌雄いずれであっても、全きものをささげなければならない。"},{"ref":"Lev.3.7","start":3003007,"end":3003007,"break":"none","ruby":[[2,2,"こひつじ"],[5,1,"そな"],[7,1,"もの"],[22,1,"しゅ"],[24,1,"まえ"],[26,1,"つ"]],"text":"もし小羊を供え物としてささげるならば、それを主の前に連れてきて、"},{"ref":"Lev.3.8","start":3003008,"end":3003008,"break":"none","ruby":[[2,1,"そな"],[4,1,"もの"],[6,1,"あたま"],[8,1,"て"],[10,1,"お"],[16,2,"かいけん"],[19,2,"まくや"],[22,1,"まえ"],[44,1,"こ"],[50,1,"ち"],[52,2,"さいだん"],[55,2,"しゅうい"],[58,1,"そそ"]],"text":"その供え物の頭に手を置き、それを会見の幕屋の前で、ほふらなければならない。そしてアロンの子たちはその血を祭壇の周囲に注ぎかけなければならない。"},{"ref":"Lev.3.9","start":3003009,"end":3003009,"break":"none","ruby":[[0,1,"かれ"],[4,3,"しゅうおんさい"],[8,2,"ぎせい"],[16,2,"かさい"],[19,1,"しゅ"],[39,2,"しぼう"],[42,2,"せぼね"],[45,1,"せっ"],[48,1,"き"],[50,1,"と"],[52,1,"あぶら"],[53,1,"お"],[55,2,"ぜんぶ"],[58,2,"ないぞう"],[64,2,"しぼう"],[67,2,"ないぞう"],[70,1,"うえ"],[76,2,"しぼう"]],"text":"彼はその酬恩祭の犠牲のうちから、火祭を主にささげなければならない。すなわちその脂肪、背骨に接して切り取る脂尾の全部、内臓をおおう脂肪と内臓の上のすべての脂肪、"},{"ref":"Lev.3.10","start":3003010,"end":3003010,"break":"none","ruby":[[3,2,"じんぞう"],[8,1,"うえ"],[10,1,"こし"],[18,2,"しぼう"],[25,2,"じんぞう"],[28,1,"とも"],[30,1,"と"],[34,2,"かんぞう"],[37,1,"うえ"],[39,2,"しょうよう"]],"text":"二つの腎臓とその上の腰のあたりにある脂肪、ならびに腎臓と共に取られる肝臓の上の小葉である。"},{"ref":"Lev.3.11","start":3003011,"end":3003011,"break":"none","ruby":[[0,2,"さいし"],[6,2,"さいだん"],[9,1,"うえ"],[11,1,"や"],[25,2,"かさい"],[32,1,"しゅ"],[38,2,"しょくもつ"]],"text":"祭司はこれを祭壇の上で焼かなければならない。これは火祭であって、主にささげる食物である。"},{"ref":"Lev.3.12","start":3003012,"end":3003012,"break":"paragraph","ruby":[[2,1,"かれ"],[4,1,"そな"],[6,1,"もの"],[21,1,"しゅ"],[23,1,"まえ"],[25,1,"つ"]],"text":"もし彼の供え物が、やぎであるならば、それを主の前に連れてきて、"},{"ref":"Lev.3.13","start":3003013,"end":3003013,"break":"paragraph","ruby":[[2,1,"あたま"],[4,1,"て"],[6,1,"お"],[12,2,"かいけん"],[15,2,"まくや"],[18,1,"まえ"],[40,1,"こ"],[47,1,"ち"],[49,2,"さいだん"],[52,2,"しゅうい"],[55,1,"そそ"]],"text":"その頭に手を置き、それを会見の幕屋の前で、ほふらなければならない。そしてアロンの子たちは、その血を祭壇の周囲に注ぎかけなければならない。"},{"ref":"Lev.3.14","start":3003014,"end":3003014,"break":"none","ruby":[[0,1,"かれ"],[10,1,"そな"],[12,1,"もの"],[14,1,"と"],[17,2,"かさい"],[22,1,"しゅ"],[40,2,"ないぞう"],[46,2,"しぼう"],[49,2,"ないぞう"],[52,1,"うえ"],[58,2,"しぼう"]],"text":"彼はまたそのうちから供え物を取り、火祭として主にささげなければならない。すなわち内臓をおおう脂肪と内臓の上のすべての脂肪、"},{"ref":"Lev.3.15","start":3003015,"end":3003015,"break":"none","ruby":[[3,2,"じんぞう"],[8,1,"うえ"],[10,1,"こし"],[18,2,"しぼう"],[25,2,"じんぞう"],[28,1,"とも"],[30,1,"と"],[34,2,"かんぞう"],[37,1,"うえ"],[39,2,"しょうよう"]],"text":"二つの腎臓とその上の腰のあたりにある脂肪、ならびに腎臓と共に取られる肝臓の上の小葉である。"},{"ref":"Lev.3.16","start":3003016,"end":3003016,"break":"none","ruby":[[0,2,"さいし"],[6,2,"さいだん"],[9,1,"うえ"],[11,1,"や"],[25,2,"かさい"],[34,2,"しょくもつ"],[41,1,"こう"],[52,2,"しぼう"],[57,1,"しゅ"],[59,1,"き"]],"text":"祭司はこれを祭壇の上で焼かなければならない。これは火祭としてささげる食物であって、香ばしいかおりである。脂肪はみな主に帰すべきものである。"},{"ref":"Lev.3.17","start":3003017,"end":3003017,"break":"none","ruby":[[6,2,"しぼう"],[9,1,"ち"],[16,1,"た"],[40,1,"す"],[42,1,"ところ"],[45,2,"よよ"],[47,1,"まも"],[51,2,"えいきゅう"],[54,1,"さだ"]],"text":"あなたがたは脂肪と血とをいっさい食べてはならない。これはあなたがたが、すべてその住む所で、代々守るべき永久の定めである』」。"}]