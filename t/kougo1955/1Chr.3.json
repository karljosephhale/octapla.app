[{"ref":"1Chr.3.1","start":13003001,"end":13003001,"break":"paragraph","ruby":[[5,1,"うま"],[12,1,"こ"],[15,1,"つぎ"],[24,2,"ちょうし"],[45,1,"うま"],[48,1,"つぎ"],[68,1,"うま"]],"text":"ヘブロンで生れたダビデの子らは次のとおりである。長子はアムノンでエズレルびとアヒノアムから生れ、次はダニエルでカルメルびとアビガイルから生れ、"},{"ref":"1Chr.3.2","start":13003002,"end":13003002,"break":"none","ruby":[[0,1,"だい"],[14,1,"おう"],[20,1,"むすめ"],[25,1,"う"],[28,1,"こ"],[30,1,"だい"],[42,1,"う"],[45,1,"こ"]],"text":"第三はアブサロムでゲシュルの王タルマイの娘マアカの産んだ子、第四はアドニヤでハギテの産んだ子、"},{"ref":"1Chr.3.3","start":13003003,"end":13003003,"break":"none","ruby":[[0,1,"だい"],[14,1,"うま"],[17,1,"だい"],[27,1,"かれ"],[29,1,"つま"],[35,1,"うま"]],"text":"第五はシパテヤでアビタルから生れ、第六はイテレアムで、彼の妻エグラから生れた。"},{"ref":"1Chr.3.4","start":13003004,"end":13003004,"break":"none","ruby":[[3,1,"にん"],[10,1,"かれ"],[12,1,"うま"],[23,1,"おう"],[33,1,"ねん"],[36,1,"げつ"],[44,1,"おう"],[56,1,"ねん"]],"text":"この六人はヘブロンで彼に生れた。ダビデがそこで王となっていたのは七年六か月、エルサレムで王となっていたのは三十三年であった。"},{"ref":"1Chr.3.5","start":13003005,"end":13003005,"break":"none","ruby":[[6,1,"うま"],[12,1,"つぎ"],[46,1,"にん"],[54,1,"むすめ"],[62,1,"うま"]],"text":"エルサレムで生れたものは次のとおりである。すなわちシメア、ショバブ、ナタン、ソロモン。この四人はアンミエルの娘バテシュアから生れた。"},{"ref":"1Chr.3.6","start":13003006,"end":13003006,"break":"none","text":"またイブハル、エリシャマ、エリペレテ、"},{"ref":"1Chr.3.7","start":13003007,"end":13003007,"break":"none","text":"ノガ、ネペグ、ヤピア、"},{"ref":"1Chr.3.8","start":13003008,"end":13003008,"break":"none","ruby":[[18,1,"にん"]],"text":"エリシャマ、エリアダ、エリペレテの九人、"},{"ref":"1Chr.3.9","start":13003009,"end":13003009,"break":"none","ruby":[[10,1,"こ"],[27,1,"う"],[30,1,"こ"],[40,1,"かれ"],[43,2,"しまい"]],"text":"これらはみなダビデの子である。このほかに、そばめどもの産んだ子らがあり、タマルは彼らの姉妹であった。"},{"ref":"1Chr.3.10","start":13003010,"end":13003010,"break":"paragraph","ruby":[[5,1,"こ"],[15,1,"こ"],[23,1,"こ"],[30,1,"こ"]],"text":"ソロモンの子はレハベアム、その子はアビヤ、その子はアサ、その子はヨシャパテ、"},{"ref":"1Chr.3.11","start":13003011,"end":13003011,"break":"none","ruby":[[2,1,"こ"],[10,1,"こ"],[19,1,"こ"]],"text":"その子はヨラム、その子はアハジヤ、その子はヨアシ、"},{"ref":"1Chr.3.12","start":13003012,"end":13003012,"break":"none","ruby":[[2,1,"こ"],[11,1,"こ"],[20,1,"こ"]],"text":"その子はアマジヤ、その子はアザリヤ、その子はヨタム、"},{"ref":"1Chr.3.13","start":13003013,"end":13003013,"break":"none","ruby":[[2,1,"こ"],[10,1,"こ"],[19,1,"こ"]],"text":"その子はアハズ、その子はヒゼキヤ、その子はマナセ、"},{"ref":"1Chr.3.14","start":13003014,"end":13003014,"break":"none","ruby":[[2,1,"こ"],[10,1,"こ"]],"text":"その子はアモン、その子はヨシヤ、"},{"ref":"1Chr.3.15","start":13003015,"end":13003015,"break":"none","ruby":[[4,1,"こ"],[7,2,"ちょうし"],[14,1,"つぎ"],[22,1,"だい"],[30,1,"だい"]],"text":"ヨシヤの子らは長子ヨハナン、次はエホヤキム、第三はゼデキヤ、第四はシャルムである。"},{"ref":"1Chr.3.16","start":13003016,"end":13003016,"break":"none","ruby":[[6,2,"しそん"],[11,1,"こ"],[20,1,"こ"]],"text":"エホヤキムの子孫はその子はエコニア、その子はゼデキヤである。"},{"ref":"1Chr.3.17","start":13003017,"end":13003017,"break":"none","ruby":[[0,2,"ほりょ"],[11,1,"こ"],[16,1,"こ"]],"text":"捕虜となったエコニヤの子らはその子シャルテル、"},{"ref":"1Chr.3.18","start":13003018,"end":13003018,"break":"none","text":"マルキラム、ペダヤ、セナザル、エカミア、ホシャマ、ネダビヤである。"},{"ref":"1Chr.3.19","start":13003019,"end":13003019,"break":"none","ruby":[[4,1,"こ"],[26,1,"こ"],[45,1,"かれ"],[48,2,"しまい"]],"text":"ペダヤの子らはゼルバベルとシメイである。ゼルバベルの子らはメシュラムとハナニヤ。シロミテは彼らの姉妹である。"},{"ref":"1Chr.3.20","start":13003020,"end":13003020,"break":"none","ruby":[[30,1,"にん"]],"text":"またハシュバ、オヘル、ベレキヤ、ハサデヤ、ユサブ・ヘセデの五人がある。"},{"ref":"1Chr.3.21","start":13003021,"end":13003021,"break":"none","ruby":[[5,1,"こ"],[20,1,"こ"],[27,1,"こ"],[35,1,"こ"],[43,1,"こ"]],"text":"ハナニヤの子らはペラテヤとエシャヤ、その子レパヤ、その子アルナン、その子オバデヤ、その子シカニヤである。"},{"ref":"1Chr.3.22","start":13003022,"end":13003022,"break":"none","ruby":[[5,1,"こ"],[16,1,"こ"],[43,1,"にん"]],"text":"シカニヤの子らはシマヤ。シマヤの子らはハットシ、イガル、バリア、ネアリヤ、シャパテの六人である。"},{"ref":"1Chr.3.23","start":13003023,"end":13003023,"break":"none","ruby":[[5,1,"こ"],[27,1,"にん"]],"text":"ネアリヤの子らはエリオエナイ、ヒゼキヤ、アズリカムの三人である。"},{"ref":"1Chr.3.24","start":13003024,"end":13003024,"break":"none","ruby":[[7,1,"こ"],[43,1,"にん"]],"text":"エリオエナイの子らはホダヤ、エリアシブ、ペラヤ、アックブ、ヨハナン、デラヤ、アナニの七人である。"}]