[{"ref":"2Thess.3.1","start":53003001,"end":53003001,"break":"paragraph","ruby":[[0,2,"さいご"],[4,2,"きょうだい"],[19,1,"いの"],[29,1,"しゅ"],[31,2,"ことば"],[41,1,"ところ"],[43,1,"おな"],[53,1,"はや"],[55,1,"ひろ"]],"text":"最後に、兄弟たちよ。わたしたちのために祈ってほしい。どうか主の言葉が、あなたがたの所と同じように、ここでも早く広まり、また、あがめられるように。"},{"ref":"2Thess.3.2","start":53003002,"end":53003002,"break":"none","ruby":[[13,3,"ふつごう"],[17,2,"あくにん"],[21,1,"すく"],[29,2,"じじつ"],[36,1,"ひと"],[38,2,"しんこう"],[41,1,"も"]],"text":"また、どうか、わたしたちが不都合な悪人から救われるように。事実、すべての人が信仰を持っているわけではない。"},{"ref":"2Thess.3.3","start":53003003,"end":53003003,"break":"none","ruby":[[4,1,"しゅ"],[6,2,"しんじつ"],[23,1,"つよ"],[26,1,"あ"],[29,1,"もの"],[32,1,"まも"],[35,1,"くだ"]],"text":"しかし、主は真実なかたであるから、あなたがたを強め、悪しき者から守って下さるであろう。"},{"ref":"2Thess.3.4","start":53003004,"end":53003004,"break":"none","ruby":[[6,1,"めい"],[9,1,"こと"],[18,1,"げん"],[20,2,"じっこう"],[30,2,"じっこう"],[47,1,"しゅ"],[52,2,"かくしん"]],"text":"わたしたちが命じる事を、あなたがたは現に実行しており、また、実行するであろうと、わたしたちは、主にあって確信している。"},{"ref":"2Thess.3.5","start":53003005,"end":53003005,"break":"none","ruby":[[4,1,"しゅ"],[12,1,"こころ"],[14,1,"みちび"],[18,1,"かみ"],[20,1,"あい"],[27,2,"にんたい"],[31,1,"も"],[35,1,"くだ"]],"text":"どうか、主があなたがたの心を導いて、神の愛とキリストの忍耐とを持たせて下さるように。"},{"ref":"2Thess.3.6","start":53003006,"end":53003006,"break":"paragraph","ruby":[[0,2,"きょうだい"],[6,1,"しゅ"],[16,1,"な"],[27,1,"めい"],[31,2,"たいだ"],[34,2,"せいかつ"],[47,1,"う"],[50,2,"いいつた"],[54,1,"したが"],[62,2,"きょうだい"],[69,1,"とお"]],"text":"兄弟たちよ。主イエス・キリストの名によってあなたがたに命じる。怠惰な生活をして、わたしたちから受けた言伝えに従わないすべての兄弟たちから、遠ざかりなさい。"},{"ref":"2Thess.3.7","start":53003007,"end":53003007,"break":"none","ruby":[[25,2,"じしん"],[28,1,"し"],[45,1,"ところ"],[49,1,"とき"],[59,2,"たいだ"],[62,2,"せいかつ"]],"text":"わたしたちに、どうならうべきであるかは、あなたがた自身が知っているはずである。あなたがたの所にいた時には、わたしたちは怠惰な生活をしなかったし、"},{"ref":"2Thess.3.8","start":53003008,"end":53003008,"break":"none","ruby":[[0,1,"ひと"],[10,1,"た"],[39,2,"ふたん"],[48,2,"にちや"],[51,2,"ろうく"],[54,2,"どりょく"],[58,1,"はたら"],[60,1,"つづ"]],"text":"人からパンをもらって食べることもしなかった。それどころか、あなたがたのだれにも負担をかけまいと、日夜、労苦し努力して働き続けた。"},{"ref":"2Thess.3.9","start":53003009,"end":53003009,"break":"none","ruby":[[12,2,"けんり"],[38,2,"みなら"],[45,1,"み"],[50,2,"もはん"],[53,1,"しめ"]],"text":"それは、わたしたちにその権利がないからではなく、ただわたしたちにあなたがたが見習うように、身をもって模範を示したのである。"},{"ref":"2Thess.3.10","start":53003010,"end":53003010,"break":"none","ruby":[[9,1,"ところ"],[13,1,"とき"],[17,1,"はたら"],[24,1,"もの"],[27,1,"た"],[42,1,"めい"]],"text":"また、あなたがたの所にいた時に、「働こうとしない者は、食べることもしてはならない」と命じておいた。"},{"ref":"2Thess.3.11","start":53003011,"end":53003011,"break":"none","ruby":[[5,1,"き"],[26,1,"もの"],[28,2,"たいだ"],[31,2,"せいかつ"],[34,1,"おく"],[37,1,"はたら"],[50,1,"うご"]],"text":"ところが、聞くところによると、あなたがたのうちのある者は怠惰な生活を送り、働かないで、ただいたずらに動きまわっているとのことである。"},{"ref":"2Thess.3.12","start":53003012,"end":53003012,"break":"none","ruby":[[4,2,"ひとびと"],[7,1,"たい"],[12,1,"しず"],[15,1,"はたら"],[18,2,"じぶん"],[21,1,"え"],[26,1,"た"],[33,1,"しゅ"],[46,1,"めい"],[50,1,"すす"]],"text":"こうした人々に対しては、静かに働いて自分で得たパンを食べるように、主イエス・キリストによって命じまた勧める。"},{"ref":"2Thess.3.13","start":53003013,"end":53003013,"break":"none","ruby":[[0,2,"きょうだい"],[18,1,"よ"],[20,1,"はたら"]],"text":"兄弟たちよ。あなたがたは、たゆまずに良い働きをしなさい。"},{"ref":"2Thess.3.14","start":53003014,"end":53003014,"break":"none","ruby":[[4,2,"てがみ"],[17,2,"ことば"],[20,1,"き"],[22,1,"したが"],[26,1,"ひと"],[37,1,"ひと"],[40,2,"ちゅうい"],[46,2,"こうさい"],[55,1,"かれ"],[57,1,"みずか"],[59,1,"は"]],"text":"もしこの手紙にしるしたわたしたちの言葉に聞き従わない人があれば、そのような人には注意をして、交際しないがよい。彼が自ら恥じるようになるためである。"},{"ref":"2Thess.3.15","start":53003015,"end":53003015,"break":"none","ruby":[[4,1,"かれ"],[6,1,"てき"],[11,1,"おも"],[17,2,"きょうだい"],[22,2,"くんかい"]],"text":"しかし、彼を敵のように思わないで、兄弟として訓戒しなさい。"},{"ref":"2Thess.3.16","start":53003016,"end":53003016,"break":"none","ruby":[[4,2,"へいわ"],[7,1,"しゅ"],[9,2,"じしん"],[19,2,"ばあい"],[30,2,"へいわ"],[33,1,"あた"],[36,1,"くだ"],[43,1,"しゅ"],[50,2,"いちどう"],[53,1,"とも"]],"text":"どうか、平和の主ご自身が、いついかなる場合にも、あなたがたに平和を与えて下さるように。主があなたがた一同と共におられるように。"},{"ref":"2Thess.3.17","start":53003017,"end":53003017,"break":"paragraph","ruby":[[6,2,"じしん"],[10,1,"て"],[19,1,"か"],[32,2,"てがみ"],[36,1,"か"],[38,1,"しるし"],[53,1,"か"]],"text":"ここでパウロ自身が、手ずからあいさつを書く。これは、わたしのどの手紙にも書く印である。わたしは、このように書く。"},{"ref":"2Thess.3.18","start":53003018,"end":53003018,"break":"none","ruby":[[10,1,"しゅ"],[20,1,"めぐ"],[29,2,"いちどう"],[32,1,"とも"]],"text":"どうか、わたしたちの主イエス・キリストの恵みが、あなたがた一同と共にあるように。"}]