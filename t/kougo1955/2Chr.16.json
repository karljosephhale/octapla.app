[{"ref":"2Chr.16.1","start":14016001,"end":14016001,"break":"paragraph","ruby":[[3,2,"ちせい"],[9,1,"ねん"],[17,1,"おう"],[26,1,"せ"],[28,1,"のぼ"],[34,1,"おう"],[38,1,"ところ"],[44,2,"でい"],[57,1,"きず"]],"text":"アサの治世の三十六年にイスラエルの王バアシャはユダに攻め上り、ユダの王アサの所にだれをも出入りさせないためにラマを築いた。"},{"ref":"2Chr.16.2","start":14016002,"end":14016002,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"みや"],[10,1,"おう"],[12,1,"いえ"],[14,2,"ほうぞう"],[18,2,"きんぎん"],[21,1,"と"],[23,1,"だ"],[31,1,"す"],[40,1,"おう"],[47,1,"おく"],[50,1,"い"]],"text":"そこでアサは主の宮と王の家の宝蔵から金銀を取り出し、ダマスコに住んでいるスリヤの王ベネハダデに贈って言った、"},{"ref":"2Chr.16.3","start":14016003,"end":14016003,"break":"none","ruby":[[5,1,"ちち"],[11,1,"ちち"],[13,1,"あいだ"],[27,1,"あいだ"],[29,2,"どうめい"],[32,1,"むす"],[47,2,"きんぎん"],[50,1,"おく"],[55,1,"い"],[69,1,"おう"],[76,2,"どうめい"],[79,1,"やぶ"],[82,1,"かれ"],[89,2,"てったい"]],"text":"「わたしの父とあなたの父の間のように、わたしとあなたの間に同盟を結びましょう。わたしはあなたに金銀を贈ります。行って、あなたとイスラエルの王バアシャとの同盟を破り、彼をわたしから撤退させてください」。"},{"ref":"2Chr.16.4","start":14016004,"end":14016004,"break":"none","ruby":[[8,1,"おう"],[10,1,"い"],[15,1,"き"],[18,2,"じぶん"],[21,2,"ぐんぜい"],[24,1,"ちょう"],[39,2,"まちまち"],[42,1,"せ"],[71,1,"くら"],[73,1,"まち"],[75,1,"う"]],"text":"ベネハダデはアサ王の言うことを聞き、自分の軍勢の長たちをつかわしてイスラエルの町々を攻め、イヨンとダンとアベル・マイムおよびナフタリのすべての倉の町を撃った。"},{"ref":"2Chr.16.5","start":14016005,"end":14016005,"break":"none","ruby":[[8,1,"き"],[15,1,"きず"],[25,2,"こうじ"],[28,1,"はい"]],"text":"バアシャはこれを聞いて、ラマを築くことをやめ、その工事を廃した。"},{"ref":"2Chr.16.6","start":14016006,"end":14016006,"break":"none","ruby":[[5,1,"おう"],[10,2,"ぜんこく"],[13,2,"ひとびと"],[16,1,"ひ"],[18,1,"つ"],[29,1,"た"],[35,1,"もち"],[38,1,"いし"],[40,2,"もくざい"],[43,1,"はこ"],[63,1,"た"]],"text":"そこでアサ王はユダの全国の人々を引き連れ、バアシャがラマを建てるために用いた石と木材を運んでこさせ、それをもってゲバとミヅパを建てた。"},{"ref":"2Chr.16.7","start":14016007,"end":14016007,"break":"paragraph","ruby":[[4,3,"せんけんしゃ"],[14,1,"おう"],[21,1,"き"],[23,1,"い"],[36,1,"おう"],[38,1,"よ"],[40,1,"たの"],[48,1,"かみ"],[50,1,"しゅ"],[52,1,"よ"],[54,1,"たの"],[66,1,"おう"],[68,2,"ぐんぜい"],[75,1,"て"]],"text":"そのころ先見者ハナニがユダの王アサのもとに来て言った、「あなたがスリヤの王に寄り頼んで、あなたの神、主に寄り頼まなかったので、スリヤ王の軍勢はあなたの手からのがれてしまった。"},{"ref":"2Chr.16.8","start":14016008,"end":14016008,"break":"none","ruby":[[17,2,"たいぐん"],[23,2,"せんしゃ"],[26,2,"きへい"],[34,1,"おお"],[51,1,"しゅ"],[53,1,"よ"],[55,1,"たの"],[61,1,"しゅ"],[63,1,"かれ"],[70,1,"て"],[72,1,"わた"]],"text":"かのエチオピヤびとと、リビアびとは大軍で、その戦車と騎兵は、はなはだ多かったではないか。しかしあなたが主に寄り頼んだので、主は彼らをあなたの手に渡された。"},{"ref":"2Chr.16.9","start":14016009,"end":14016009,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"め"],[8,1,"ぜん"],[9,1,"ち"],[11,1,"い"],[17,2,"じぶん"],[20,1,"む"],[24,1,"こころ"],[26,1,"まっと"],[30,1,"もの"],[35,1,"ちから"],[44,2,"こんど"],[47,1,"こと"],[55,1,"おろ"],[58,1,"こと"],[68,1,"のち"],[74,2,"せんそう"],[77,1,"のぞ"]],"text":"主の目はあまねく全地を行きめぐり、自分に向かって心を全うする者のために力をあらわされる。今度の事では、あなたは愚かな事をした。ゆえにこの後、あなたに戦争が臨むであろう」。"},{"ref":"2Chr.16.10","start":14016010,"end":14016010,"break":"none","ruby":[[8,3,"せんけんしゃ"],[12,1,"いか"],[16,2,"ごくや"],[19,1,"い"],[25,1,"こと"],[30,1,"はげ"],[33,1,"かれ"],[35,1,"いか"],[53,1,"たみ"],[57,1,"もの"]],"text":"するとアサはその先見者を怒って、獄屋に入れた。この事のために激しく彼を怒ったからである。アサはまたそのころ民のある者をしえたげた。"},{"ref":"2Chr.16.11","start":14016011,"end":14016011,"break":"paragraph","ruby":[[0,1,"み"],[6,2,"しじゅう"],[9,2,"こうい"],[22,1,"れつ"],[23,1,"おう"],[25,1,"しょ"]],"text":"見よ、アサの始終の行為は、ユダとイスラエルの列王の書にしるされている。"},{"ref":"2Chr.16.12","start":14016012,"end":14016012,"break":"none","ruby":[[5,2,"ちせい"],[11,1,"ねん"],[13,1,"あし"],[15,1,"や"],[20,1,"やまい"],[22,1,"はげ"],[32,1,"やまい"],[34,1,"とき"],[38,1,"しゅ"],[40,1,"もと"],[45,2,"いしゃ"],[48,1,"もと"]],"text":"アサはその治世の三十九年に足を病み、その病は激しくなったが、その病の時にも、主を求めないで医者を求めた。"},{"ref":"2Chr.16.13","start":14016013,"end":14016013,"break":"none","ruby":[[3,2,"せんぞ"],[8,1,"とも"],[10,1,"ねむ"],[15,2,"ちせい"],[21,1,"ねん"],[23,1,"し"]],"text":"アサは先祖たちと共に眠り、その治世の四十一年に死んだ。"},{"ref":"2Chr.16.14","start":14016014,"end":14016014,"break":"none","ruby":[[0,2,"ひとびと"],[3,1,"かれ"],[5,2,"じぶん"],[15,1,"まち"],[17,1,"ほ"],[23,1,"はか"],[25,1,"ほうむ"],[28,1,"せい"],[29,1,"こう"],[31,1,"じゅつ"],[36,1,"つく"],[39,2,"さまざま"],[42,2,"こうりょう"],[45,1,"み"],[49,1,"とこ"],[51,1,"よこ"],[55,1,"かれ"],[66,1,"こう"]],"text":"人々は彼が自分のためにダビデの町に掘っておいた墓に葬り、製香の術をもって造った様々の香料を満たした床に横たえ、彼のためにおびただしく香をたいた。"}]