[{"ref":"Job.20.1","start":18020001,"end":18020001,"break":"paragraph","ruby":[[12,1,"こた"],[15,1,"い"]],"text":"そこでナアマびとゾパルは答えて言った、"},{"ref":"Job.20.2","start":18020002,"end":18020002,"break":"stanza","breaks":[[24,"line"]],"ruby":[[12,1,"こた"],[18,1,"おも"],[21,1,"おこ"],[30,2,"しんじゅう"],[36,1,"さわ"],[38,1,"た"]],"text":"「これによって、わたしは答えようとの思いを起し、これがために心中しきりに騒ぎ立つ。"},{"ref":"Job.20.3","start":18020003,"end":18020003,"break":"line","breaks":[[20,"line"]],"ruby":[[14,2,"ひなん"],[17,1,"き"],[28,1,"さと"],[31,1,"れい"],[37,1,"こた"]],"text":"わたしはわたしをはずかしめる非難を聞く、しかし、わたしの悟りの霊がわたしに答えさせる。"},{"ref":"Job.20.4","start":18020004,"end":18020004,"break":"line","breaks":[[15,"line"]],"ruby":[[6,1,"こと"],[8,1,"し"],[15,1,"むかし"],[18,1,"ち"],[20,1,"うえ"],[22,1,"ひと"],[24,1,"お"]],"text":"あなたはこの事を知らないのか、昔から地の上に人の置かれてよりこのかた、"},{"ref":"Job.20.5","start":18020005,"end":18020005,"break":"line","breaks":[[18,"line"],[30,"line"]],"ruby":[[0,1,"あ"],[3,1,"ひと"],[5,1,"か"],[7,1,"ほこ"],[18,1,"かみ"],[20,1,"しん"],[24,1,"もの"],[26,1,"たの"]],"text":"悪しき人の勝ち誇はしばらくであって、神を信じない者の楽しみはただつかのまであることを。"},{"ref":"Job.20.6","start":18020006,"end":18020006,"break":"line","breaks":[[13,"line"]],"ruby":[[5,1,"たか"],[8,1,"てん"],[10,1,"たっ"],[15,1,"あたま"],[17,1,"くも"]],"text":"たといその高さが天に達し、その頭が雲におよんでも、"},{"ref":"Job.20.7","start":18020007,"end":18020007,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[6,1,"ふん"],[17,1,"ほろ"],[20,1,"かれ"],[22,1,"み"],[24,1,"もの"],[26,1,"い"],[34,1,"かれ"]],"text":"彼はおのれの糞のように、とこしえに滅び、彼を見た者は言うであろう、『彼はどこにおるか』と。"},{"ref":"Job.20.8","start":18020008,"end":18020008,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ゆめ"],[7,1,"と"],[9,1,"さ"],[13,1,"ふたた"],[15,1,"み"],[23,1,"かれ"],[25,1,"よる"],[27,1,"まぼろし"],[32,1,"お"],[34,1,"はら"]],"text":"彼は夢のように飛び去って、再び見ることはない。彼は夜の幻のように追い払われるであろう。"},{"ref":"Job.20.9","start":18020009,"end":18020009,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[2,1,"み"],[4,1,"め"],[10,1,"かれ"],[12,1,"み"],[20,1,"かれ"],[24,1,"ところ"],[26,1,"ふたた"],[28,1,"かれ"],[30,1,"み"]],"text":"彼を見た目はかさねて彼を見ることがなく、彼のいた所も再び彼を見ることがなかろう。"},{"ref":"Job.20.10","start":18020010,"end":18020010,"break":"line","breaks":[[16,"line"]],"ruby":[[2,1,"こ"],[5,1,"まず"],[8,1,"もの"],[10,1,"めぐ"],[13,1,"もと"],[18,1,"て"],[20,1,"かれ"],[22,1,"か"],[23,1,"ざい"],[25,1,"つぐな"]],"text":"その子らは貧しい者に恵みを求め、その手は彼の貨財を償うであろう。"},{"ref":"Job.20.11","start":18020011,"end":18020011,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"ほね"],[5,1,"わか"],[7,1,"ちから"],[9,1,"み"],[21,1,"かれ"],[23,1,"とも"],[28,1,"ふ"]],"text":"その骨には若い力が満ちている、しかしそれは彼と共にちりに伏すであろう。"},{"ref":"Job.20.12","start":18020012,"end":18020012,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"あく"],[5,1,"かれ"],[7,1,"くち"],[9,1,"あま"],[15,1,"した"],[17,1,"うら"]],"text":"たとい悪は彼の口に甘く、これを舌の裏にかくし、"},{"ref":"Job.20.13","start":18020013,"end":18020013,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"お"],[7,1,"す"],[15,1,"くち"],[17,1,"なか"],[19,1,"ふく"]],"text":"これを惜しんで捨てることなく、口の中に含んでいても、"},{"ref":"Job.20.14","start":18020014,"end":18020014,"break":"line","breaks":[[14,"line"]],"ruby":[[2,2,"しょくもつ"],[5,1,"かれ"],[7,1,"はら"],[9,1,"うち"],[11,1,"かわ"],[14,1,"かれ"],[16,1,"うち"],[18,2,"どくへび"],[21,1,"どく"]],"text":"その食物は彼の腹の中で変り、彼の内で毒蛇の毒となる。"},{"ref":"Job.20.15","start":18020015,"end":18020015,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"かれ"],[2,1,"か"],[3,1,"ざい"],[15,1,"は"],[17,1,"だ"],[20,1,"かみ"],[25,1,"かれ"],[27,1,"はら"],[30,1,"お"],[32,1,"だ"]],"text":"彼は貨財をのんでも、またそれを吐き出す、神がそれを彼の腹から押し出されるからだ。"},{"ref":"Job.20.16","start":18020016,"end":18020016,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"かれ"],[2,2,"どくへび"],[5,1,"どく"],[7,1,"す"],[14,1,"した"],[16,1,"かれ"],[18,1,"ころ"]],"text":"彼は毒蛇の毒を吸い、まむしの舌は彼を殺すであろう。"},{"ref":"Job.20.17","start":18020017,"end":18020017,"break":"line","ruby":[[0,1,"かれ"],[2,1,"みつ"],[4,2,"ぎょうにゅう"],[7,1,"なが"],[10,2,"かわがわ"],[13,1,"み"]],"text":"彼は蜜と凝乳の流れる川々を見ることができない。"},{"ref":"Job.20.18","start":18020018,"end":18020018,"break":"line","breaks":[[16,"line"],[29,"line"],[45,"line"]],"ruby":[[0,1,"かれ"],[7,1,"え"],[12,1,"かえ"],[19,1,"く"],[31,1,"あきな"],[37,1,"え"],[39,2,"りえき"],[45,1,"たの"]],"text":"彼はほねおって獲たものを返して、それを食うことができない。その商いによって得た利益をもって楽しむことができない。"},{"ref":"Job.20.19","start":18020019,"end":18020019,"break":"line","breaks":[[22,"line"],[33,"line"]],"ruby":[[0,1,"かれ"],[2,1,"まず"],[5,1,"もの"],[15,1,"す"],[22,1,"かれ"],[24,1,"いえ"],[26,1,"うば"],[28,1,"と"],[36,1,"た"]],"text":"彼が貧しい者をしえたげ、これを捨てたからだ。彼は家を奪い取っても、それを建てることができない。"},{"ref":"Job.20.20","start":18020020,"end":18020020,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[2,2,"よくば"],[6,1,"た"],[11,1,"し"],[19,1,"たの"],[22,1,"なに"],[23,1,"もの"],[26,1,"すく"]],"text":"彼の欲張りは足ることを知らぬゆえ、その楽しむ何物をも救うことができないであろう。"},{"ref":"Job.20.21","start":18020021,"end":18020021,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[2,1,"のこ"],[5,1,"た"],[11,1,"もの"],[28,2,"はんえい"],[34,1,"つづ"]],"text":"彼が残して食べなかった物とては一つもない。それゆえ、その繁栄はながく続かないであろう。"},{"ref":"Job.20.22","start":18020022,"end":18020022,"break":"line","breaks":[[19,"line"]],"ruby":[[2,1,"ちから"],[4,1,"み"],[9,1,"とき"],[11,1,"かれ"],[13,2,"きゅうきょう"],[16,1,"おちい"],[19,1,"なや"],[22,1,"て"],[29,1,"かれ"],[31,1,"うえ"],[33,1,"のぞ"]],"text":"その力の満ちている時、彼は窮境に陥り、悩みの手がことごとく彼の上に臨むであろう。"},{"ref":"Job.20.23","start":18020023,"end":18020023,"break":"line","breaks":[[15,"line"],[29,"line"]],"ruby":[[0,1,"かれ"],[4,1,"はら"],[6,1,"み"],[15,1,"かみ"],[19,1,"はげ"],[22,1,"いか"],[25,1,"おく"],[32,1,"かれ"],[34,1,"うえ"],[36,1,"ふ"],[38,2,"そそぎ"],[41,1,"かれ"],[43,2,"しょくもつ"]],"text":"彼がその腹を満たそうとすれば、神はその激しい怒りを送って、それを彼の上に降り注ぎ、彼の食物とされる。"},{"ref":"Job.20.24","start":18020024,"end":18020024,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[2,1,"てつ"],[4,2,"ぶき"],[7,1,"まぬか"],[12,2,"せいどう"],[15,1,"や"],[17,1,"かれ"],[19,2,"いとお"]],"text":"彼は鉄の武器を免れても、青銅の矢は彼を射通すであろう。"},{"ref":"Job.20.25","start":18020025,"end":18020025,"break":"line","breaks":[[16,"line"],[34,"line"]],"ruby":[[0,1,"かれ"],[7,1,"み"],[10,1,"ひ"],[12,1,"ぬ"],[20,1,"や"],[26,1,"きも"],[29,1,"で"],[34,1,"おそ"],[37,1,"かれ"],[39,1,"うえ"],[41,1,"のぞ"]],"text":"彼がこれをその身から引き抜けば、きらめく矢じりがその肝から出てきて、恐れが彼の上に臨む。"},{"ref":"Job.20.26","start":18020026,"end":18020026,"break":"line","breaks":[[23,"line"],[45,"line"]],"ruby":[[5,2,"あんこく"],[8,1,"かれ"],[10,2,"ほうもつ"],[23,1,"ひと"],[25,1,"ふ"],[27,1,"おこ"],[35,1,"ひ"],[37,1,"かれ"],[39,1,"や"],[47,2,"てんまく"],[50,1,"のこ"],[55,1,"もの"],[57,1,"ほろ"]],"text":"もろもろの暗黒が彼の宝物のためにたくわえられ、人が吹き起したものでない火が彼を焼きつくし、その天幕に残っている者を滅ぼすであろう。"},{"ref":"Job.20.27","start":18020027,"end":18020027,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"てん"],[2,1,"かれ"],[4,1,"つみ"],[11,1,"ち"],[13,1,"おこ"],[16,1,"かれ"],[18,1,"せ"]],"text":"天は彼の罪をあらわし、地は起って彼を攻めるであろう。"},{"ref":"Job.20.28","start":18020028,"end":18020028,"break":"line","breaks":[[13,"line"]],"ruby":[[2,1,"いえ"],[4,2,"ざいさん"],[7,1,"うば"],[9,1,"さ"],[13,1,"かみ"],[15,1,"いか"],[18,1,"ひ"],[20,1,"き"]],"text":"その家の財産は奪い去られ、神の怒りの日に消えうせるであろう。"},{"ref":"Job.20.29","start":18020029,"end":18020029,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"あ"],[6,1,"ひと"],[8,1,"かみ"],[11,1,"う"],[14,1,"ぶん"],[16,1,"かみ"],[21,1,"さだ"],[26,1,"し"],[27,1,"ぎょう"]],"text":"これが悪しき人の神から受ける分、神によって定められた嗣業である」。"}]