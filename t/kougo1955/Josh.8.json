[{"ref":"Josh.8.1","start":6008001,"end":6008001,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"い"],[13,1,"おそ"],[39,1,"みな"],[41,1,"ひき"],[44,1,"た"],[51,1,"せ"],[53,1,"のぼ"],[66,1,"おう"],[70,1,"たみ"],[74,1,"まち"],[78,1,"ち"],[84,1,"て"],[86,1,"さづ"]],"text":"主はヨシュアに言われた、「恐れてはならない、おののいてはならない。いくさびとを皆、率い、立って、アイに攻め上りなさい。わたしはアイの王とその民、その町、その地をあなたの手に授ける。"},{"ref":"Josh.8.2","start":6008002,"end":6008002,"break":"none","ruby":[[14,1,"おう"],[27,1,"おう"],[48,1,"もの"],[50,2,"かちく"],[54,2,"せんり"],[56,1,"ひん"],[89,1,"まち"],[95,2,"ふくへい"],[98,1,"お"]],"text":"あなたは、さきにエリコとその王にしたとおり、アイとその王とにしなければならない。ただし、ぶんどり物と家畜とは戦利品としてあなたがたのものとすることができるであろう。あなたはまず、町のうしろに伏兵を置きなさい」。"},{"ref":"Josh.8.3","start":6008003,"end":6008003,"break":"paragraph","ruby":[[5,1,"た"],[19,1,"とも"],[25,1,"せ"],[27,1,"のぼ"],[36,1,"だい"],[37,2,"ゆうし"],[41,1,"にん"],[43,1,"えら"],[49,1,"よる"]],"text":"ヨシュアは立って、すべてのいくさびとと共に、アイに攻め上ろうとして、まず大勇士三万人を選び、それを夜のうちにつかわした。"},{"ref":"Josh.8.4","start":6008004,"end":6008004,"break":"none","ruby":[[5,1,"かれ"],[8,1,"めい"],[11,1,"い"],[22,1,"まち"],[24,1,"む"],[29,1,"まち"],[35,1,"ふ"],[48,1,"まち"],[50,1,"とお"],[52,1,"はな"],[60,1,"そな"]],"text":"ヨシュアは彼らに命じて言った、「あなたがたは町に向かって、町のうしろに伏せていなければならない。町を遠く離れないで、みな備えをしていなければならない。"},{"ref":"Josh.8.5","start":6008005,"end":6008005,"break":"none","ruby":[[8,1,"したが"],[10,1,"たみ"],[13,1,"みな"],[14,1,"とも"],[17,1,"まち"],[19,1,"せ"],[21,1,"よ"],[29,1,"かれ"],[32,1,"まえ"],[46,1,"で"],[58,1,"かれ"],[61,1,"まえ"],[64,1,"に"]],"text":"わたしとわたしに従う民とは皆共に、町に攻め寄せよう。そして彼らが前のようにわれわれにむかって出てくるとき、われわれは彼らの前から逃げるであろう。"},{"ref":"Josh.8.6","start":6008006,"end":6008006,"break":"none","ruby":[[5,1,"かれ"],[13,1,"お"],[16,1,"で"],[35,1,"かれ"],[38,1,"まち"],[44,1,"だ"],[53,1,"かれ"],[56,1,"い"],[66,2,"ひとびと"],[71,1,"まえ"],[82,1,"まえ"],[85,1,"に"],[101,1,"かれ"],[104,1,"まえ"],[107,1,"に"]],"text":"そうすれば彼らはわれわれを追って出てくるであろうから、われわれはついに彼らを町からおびき出すことができる。彼らは言うであろう、『この人々はまた前のように、われわれの前から逃げていく』。こうしてわれわれは彼らの前から逃げるであろう。"},{"ref":"Josh.8.7","start":6008007,"end":6008007,"break":"none","ruby":[[2,1,"とき"],[10,1,"ふ"],[15,1,"ところ"],[18,1,"た"],[20,1,"あ"],[25,1,"まち"],[27,1,"と"],[44,1,"かみ"],[46,1,"しゅ"],[57,1,"て"],[59,1,"あた"]],"text":"その時、あなたがたは伏せている所から立ち上がって、町を取らなければならない。あなたがたの神、主がそれをあなたがたの手に与えられるからである。"},{"ref":"Josh.8.8","start":6008008,"end":6008008,"break":"none","ruby":[[7,1,"まち"],[9,1,"と"],[16,1,"まち"],[18,1,"ひ"],[20,1,"はな"],[23,1,"しゅ"],[25,1,"めい"],[56,1,"めい"]],"text":"あなたがたが、町を取ったならば、町に火を放ち、主が命じられたようにしなければならない。わたしはこう、あなたがたに命じるのである」。"},{"ref":"Josh.8.9","start":6008009,"end":6008009,"break":"none","ruby":[[9,1,"かれ"],[20,1,"かれ"],[26,2,"せいほう"],[36,1,"あいだ"],[38,1,"ま"],[40,1,"ぶ"],[44,2,"ばしょ"],[47,1,"い"],[50,1,"み"],[52,1,"ふ"],[63,1,"よる"],[65,1,"たみ"],[67,1,"なか"],[69,1,"やど"]],"text":"そうしてヨシュアが彼らをつかわしたので、彼らはアイの西方、ベテルとアイの間の待ち伏せする場所に行って身を伏せた。ヨシュアはその夜、民の中に宿った。"},{"ref":"Josh.8.10","start":6008010,"end":6008010,"break":"paragraph","ruby":[[5,1,"あ"],[8,1,"あさ"],[10,1,"はや"],[12,1,"お"],[16,1,"たみ"],[18,1,"あつ"],[27,2,"ちょうろう"],[32,1,"とも"],[35,1,"たみ"],[37,2,"さきだ"],[45,1,"のぼ"]],"text":"ヨシュアは明くる朝、早く起きて、民を集め、イスラエルの長老たちと共に、民に先立って、アイに上っていった。"},{"ref":"Josh.8.11","start":6008011,"end":6008011,"break":"none","ruby":[[0,1,"かれ"],[2,1,"とも"],[16,1,"のぼ"],[23,1,"まち"],[25,1,"まえ"],[27,1,"ちか"],[34,1,"きた"],[36,1,"じん"],[38,1,"と"],[42,1,"かれ"],[48,1,"あいだ"],[55,1,"たに"]],"text":"彼と共にいたいくさびとたちもみな上っていって、町の前に近づき、アイの北に陣を取った。彼らとアイの間には、一つの谷があった。"},{"ref":"Josh.8.12","start":6008012,"end":6008012,"break":"none","ruby":[[11,1,"にん"],[17,1,"まち"],[19,2,"せいほう"],[29,1,"あいだ"],[32,1,"ふ"]],"text":"ヨシュアはおおよそ五千人をとって、町の西方、ベテルとアイの間に、伏せておいた。"},{"ref":"Josh.8.13","start":6008013,"end":6008013,"break":"none","ruby":[[4,1,"たみ"],[6,2,"しゅりょく"],[9,1,"まち"],[11,1,"きた"],[21,1,"まち"],[23,1,"にし"],[36,1,"よ"],[38,1,"たに"],[40,1,"なか"],[42,1,"やど"]],"text":"こうして民の主力を町の北におき、しんがりを町の西においた。ヨシュアはその夜、谷の中で宿った。"},{"ref":"Josh.8.14","start":6008014,"end":6008014,"break":"none","ruby":[[3,1,"おう"],[8,1,"み"],[15,1,"たみ"],[17,1,"とも"],[20,1,"いそ"],[24,1,"はや"],[26,1,"お"],[33,1,"い"],[35,1,"くだ"],[37,1,"ざか"],[39,1,"すす"],[41,1,"で"],[50,1,"たたか"],[58,1,"おう"],[60,1,"まち"],[74,2,"ふくへい"],[82,1,"し"]],"text":"アイの王はこれを見て、すべての民と共に、急いで、早く起き、アラバに行く下り坂に進み出て、イスラエルと戦った。しかし、王は町のうしろに、すきをうかがう伏兵のおることを知らなかった。"},{"ref":"Josh.8.15","start":6008015,"end":6008015,"break":"none","ruby":[[15,2,"ひとびと"],[18,1,"とも"],[21,1,"かれ"],[24,1,"う"],[26,1,"やぶ"],[36,2,"あらの"],[39,2,"ほうこう"],[42,1,"に"]],"text":"ヨシュアはイスラエルのすべての人々と共に、彼らに打ち破られたふりをして、荒野の方向へ逃げだしたので、"},{"ref":"Josh.8.16","start":6008016,"end":6008016,"break":"none","ruby":[[2,1,"まち"],[4,1,"たみ"],[8,1,"よ"],[12,1,"あつ"],[16,1,"かれ"],[22,1,"お"],[33,1,"お"],[36,1,"まち"],[42,1,"だ"]],"text":"その町の民はみな呼ばわり集まって彼らのあとを追い、ヨシュアのあとを追って町からおびき出され、"},{"ref":"Josh.8.17","start":6008017,"end":6008017,"break":"none","ruby":[[9,1,"のこ"],[26,1,"で"],[37,1,"お"],[40,1,"まち"],[42,1,"あ"],[44,1,"はな"],[57,1,"お"]],"text":"アイにもベテルにも残っているものはひとりもなく、みな出てイスラエルのあとを追い、町を開け放して、イスラエルのあとを追った。"},{"ref":"Josh.8.18","start":6008018,"end":6008018,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"しゅ"],[11,1,"い"],[21,1,"て"],[34,1,"ほう"],[38,1,"の"],[50,1,"まち"],[56,1,"て"],[58,1,"あた"],[75,1,"て"],[90,1,"ほう"],[94,1,"の"]],"text":"その時、主はヨシュアに言われた、「あなたの手にあるなげやりを、アイの方にさし伸べなさい。わたしはその町をあなたの手に与えるであろう」。そこでヨシュアが手にしていたなげやりを、アイの方にさし伸べると、"},{"ref":"Josh.8.19","start":6008019,"end":6008019,"break":"none","ruby":[[0,2,"ふくへい"],[9,2,"ばしょ"],[13,1,"た"],[15,1,"あ"],[24,1,"て"],[30,2,"どうじ"],[34,1,"はし"],[37,1,"まち"],[39,1,"はい"],[45,1,"と"],[53,1,"まち"],[55,1,"ひ"]],"text":"伏兵はたちまちその場所から立ち上がり、ヨシュアが手をのべると同時に、走って町に入り、それを取って、ただちに町に火をかけた。"},{"ref":"Josh.8.20","start":6008020,"end":6008020,"break":"none","ruby":[[6,2,"ひとびと"],[16,1,"かえ"],[19,1,"み"],[23,1,"まち"],[25,1,"や"],[28,1,"けむり"],[30,1,"てん"],[32,1,"た"],[53,1,"に"],[64,2,"あらの"],[67,1,"に"],[73,1,"たみ"],[75,1,"み"],[82,1,"お"],[87,1,"もの"],[89,1,"せま"]],"text":"それでアイの人々が、うしろをふり返って見ると、町の焼ける煙が天に立ちのぼっていたので、こちらへもあちらへも逃げるすべがなかった。荒野へ逃げていった民も身をかえして、追ってきた者に迫った。"},{"ref":"Josh.8.21","start":6008021,"end":6008021,"break":"none","ruby":[[18,2,"ふくへい"],[21,1,"まち"],[23,1,"と"],[26,1,"まち"],[28,1,"や"],[31,1,"けむり"],[33,1,"た"],[35,1,"のぼ"],[39,1,"み"],[42,1,"み"],[51,2,"ひとびと"],[54,1,"う"]],"text":"ヨシュアとすべてのイスラエルびとは、伏兵が町を取り、町の焼ける煙が立ち上るのを見て、身をかえしてアイの人々を撃った。"},{"ref":"Josh.8.22","start":6008022,"end":6008022,"break":"none","ruby":[[2,1,"まち"],[4,1,"と"],[10,1,"まち"],[12,1,"で"],[14,1,"かれ"],[17,1,"む"],[24,1,"かれ"],[44,1,"なか"],[64,1,"かれ"],[67,1,"う"],[73,1,"い"],[75,1,"のこ"],[81,1,"に"]],"text":"また町を取ったものは町を出て彼らに向かったので、彼らは、こちらとあちらとからイスラエルの中にはさまれた。こうしてイスラエルびとが彼らを撃ったので、生き残ったもの、逃げおおせたものは、ひとりもなかった。"},{"ref":"Josh.8.23","start":6008023,"end":6008023,"break":"none","ruby":[[6,1,"おう"],[8,1,"い"],[24,1,"つ"]],"text":"そしてアイの王を生けどりにして、ヨシュアのもとへ連れてきた。"},{"ref":"Josh.8.24","start":6008024,"end":6008024,"break":"paragraph","ruby":[[9,2,"あらの"],[12,2,"ついげき"],[21,2,"じゅうみん"],[29,1,"の"],[31,1,"ころ"],[45,1,"のこ"],[48,1,"う"],[50,1,"たお"],[56,1,"みな"],[60,1,"かえ"],[72,1,"まち"],[74,1,"う"],[76,1,"ほろ"]],"text":"イスラエルびとは、荒野に追撃してきたアイの住民をことごとく野で殺し、つるぎをもってひとりも残さず撃ち倒してのち、皆アイに帰り、つるぎをもってその町を撃ち滅ぼした。"},{"ref":"Josh.8.25","start":6008025,"end":6008025,"break":"none","ruby":[[2,1,"ひ"],[6,2,"ひとびと"],[14,1,"たお"],[20,1,"かず"],[22,2,"だんじょ"],[32,1,"にん"]],"text":"その日アイの人々はことごとく倒れた。その数は男女あわせて一万二千人であった。"},{"ref":"Josh.8.26","start":6008026,"end":6008026,"break":"none","ruby":[[8,2,"じゅうみん"],[16,1,"ほろ"],[33,1,"の"],[36,1,"て"],[38,1,"ひ"]],"text":"ヨシュアはアイの住民をことごとく滅ぼしつくすまでは、なげやりをさし伸べた手を引っこめなかった。"},{"ref":"Josh.8.27","start":6008027,"end":6008027,"break":"none","ruby":[[6,1,"まち"],[8,2,"かちく"],[18,1,"ひん"],[28,2,"じぶん"],[33,2,"せんり"],[35,1,"ひん"],[39,1,"と"],[43,1,"しゅ"],[50,1,"めい"],[55,2,"ことば"]],"text":"ただし、その町の家畜および、ぶんどり品はイスラエルびとが自分たちの戦利品として取った。主がヨシュアに命じられた言葉にしたがったのである。"},{"ref":"Josh.8.28","start":6008028,"end":6008028,"break":"none","ruby":[[12,1,"や"],[16,2,"えいきゅう"],[19,2,"あらつか"],[29,2,"こんにち"],[33,1,"あ"],[35,1,"ち"]],"text":"こうしてヨシュアはアイを焼いて、永久に荒塚としたが、それは今日まで荒れ地となっている。"},{"ref":"Josh.8.29","start":6008029,"end":6008029,"break":"none","ruby":[[11,1,"おう"],[13,2,"ゆうがた"],[17,1,"き"],[19,1,"か"],[26,1,"ひ"],[28,1,"い"],[33,1,"めい"],[39,2,"したい"],[42,1,"き"],[45,1,"と"],[51,1,"まち"],[53,1,"もん"],[55,2,"いりぐち"],[58,1,"な"],[65,1,"うえ"],[67,1,"いし"],[69,2,"おおつか"],[72,1,"つ"],[74,1,"あ"],[84,2,"こんにち"],[88,1,"のこ"]],"text":"ヨシュアはまた、アイの王を夕方まで木に掛けてさらし、日の入るころ、命じて、その死体を木から取りおろし、町の門の入口に投げすて、その上に石の大塚を積み上げさせたが、それは今日まで残っている。"},{"ref":"Josh.8.30","start":6008030,"end":6008030,"break":"paragraph","ruby":[[11,1,"やま"],[19,1,"かみ"],[21,1,"しゅ"],[29,2,"さいだん"],[32,1,"きず"]],"text":"そしてヨシュアはエバル山にイスラエルの神、主のために一つの祭壇を築いた。"},{"ref":"Josh.8.31","start":6008031,"end":6008031,"break":"none","ruby":[[3,1,"しゅ"],[18,2,"ひとびと"],[21,1,"めい"],[36,2,"りっぽう"],[39,1,"しょ"],[52,1,"てつ"],[54,2,"どうぐ"],[57,1,"あ"],[61,2,"しぜん"],[67,1,"いし"],[69,2,"さいだん"],[76,2,"ひとびと"],[81,1,"うえ"],[84,1,"しゅ"],[86,2,"はんさい"],[93,3,"しゅうおんさい"],[97,1,"そな"]],"text":"これは主のしもべモーセがイスラエルの人々に命じたことにもとづき、モーセの律法の書にしるされているように、鉄の道具を当てない自然のままの石の祭壇であって、人々はその上で、主に燔祭をささげ、酬恩祭を供えた。"},{"ref":"Josh.8.32","start":6008032,"end":6008032,"break":"none","ruby":[[2,1,"ところ"],[16,1,"か"],[22,2,"りっぽう"],[32,2,"ひとびと"],[35,1,"まえ"],[38,1,"いし"],[40,1,"か"],[42,1,"うつ"]],"text":"その所で、ヨシュアはまたモーセの書きしるした律法を、イスラエルの人々の前で、石に書き写した。"},{"ref":"Josh.8.33","start":6008033,"end":6008033,"break":"none","ruby":[[17,2,"ほんごく"],[19,1,"じん"],[22,2,"きりゅう"],[25,2,"たこく"],[27,1,"じん"],[30,2,"ちょうろう"],[45,1,"とも"],[48,1,"しゅ"],[50,2,"けいやく"],[53,1,"はこ"],[64,2,"さいし"],[69,1,"まえ"],[72,1,"はこ"],[82,1,"わか"],[86,1,"なか"],[93,1,"やま"],[95,1,"まえ"],[98,1,"なか"],[104,1,"やま"],[106,1,"まえ"],[108,1,"た"],[115,1,"しゅ"],[127,1,"めい"],[140,1,"たみ"],[142,2,"しゅくふく"]],"text":"こうしてすべてのイスラエルびとは、本国人も、寄留の他国人も、長老、つかさびと、さばきびとと共に、主の契約の箱をかくレビびとである祭司たちの前で、箱のこなたとかなたに分れて、半ばはゲリジム山の前に、半ばはエバル山の前に立った。これは主のしもべモーセがさきに命じたように、イスラエルの民を祝福するためであった。"},{"ref":"Josh.8.34","start":6008034,"end":6008034,"break":"none","ruby":[[3,1,"のち"],[14,2,"りっぽう"],[17,1,"しょ"],[26,1,"ところ"],[34,2,"しゅくふく"],[43,1,"かん"],[46,2,"りっぽう"],[49,2,"ことば"],[57,1,"よ"]],"text":"そして後、ヨシュアはすべての律法の書にしるされている所にしたがって、祝福と、のろいとに関する律法の言葉をことごとく読んだ。"},{"ref":"Josh.8.35","start":6008035,"end":6008035,"break":"none","ruby":[[4,1,"めい"],[11,2,"ことば"],[28,1,"ぜん"],[29,2,"かいしゅう"],[34,1,"おんな"],[36,1,"こ"],[55,1,"す"],[57,2,"きりゅう"],[60,2,"たこく"],[62,1,"じん"],[64,1,"まえ"],[67,1,"よ"]],"text":"モーセが命じたすべての言葉のうち、ヨシュアがイスラエルの全会衆および女と子どもたち、ならびにイスラエルのうちに住む寄留の他国人の前で、読まなかったものは一つもなかった。"}]