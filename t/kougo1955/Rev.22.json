[{"ref":"Rev.22.1","start":66022001,"end":66022001,"break":"paragraph","ruby":[[0,2,"みつかい"],[6,2,"すいしょう"],[12,1,"かがや"],[21,1,"みず"],[23,1,"かわ"],[29,1,"み"],[38,1,"かわ"],[41,1,"かみ"],[43,2,"こひつじ"],[47,2,"みざ"],[51,1,"で"]],"text":"御使はまた、水晶のように輝いているいのちの水の川をわたしに見せてくれた。この川は、神と小羊との御座から出て、"},{"ref":"Rev.22.2","start":66022002,"end":66022002,"break":"none","ruby":[[0,1,"みやこ"],[2,2,"おおどお"],[6,2,"ちゅうおう"],[9,1,"なが"],[15,1,"かわ"],[17,2,"りょうがわ"],[25,1,"き"],[33,1,"しゅ"],[35,1,"み"],[37,1,"むす"],[42,1,"じつ"],[44,2,"まいつき"],[52,1,"き"],[54,1,"は"],[56,1,"しょ"],[57,2,"こくみん"]],"text":"都の大通りの中央を流れている。川の両側にはいのちの木があって、十二種の実を結び、その実は毎月みのり、その木の葉は諸国民をいやす。"},{"ref":"Rev.22.3","start":66022003,"end":66022003,"break":"none","ruby":[[13,1,"なに"],[20,1,"かみ"],[22,2,"こひつじ"],[26,2,"みざ"],[29,1,"みやこ"],[31,1,"なか"],[38,1,"しもべ"],[42,1,"かれ"],[44,2,"れいはい"]],"text":"のろわるべきものは、もはや何ひとつない。神と小羊との御座は都の中にあり、その僕たちは彼を礼拝し、"},{"ref":"Rev.22.4","start":66022004,"end":66022004,"break":"none","ruby":[[0,2,"みかお"],[3,1,"あお"],[5,1,"み"],[12,1,"かれ"],[15,1,"ひたい"],[19,2,"みな"]],"text":"御顔を仰ぎ見るのである。彼らの額には、御名がしるされている。"},{"ref":"Rev.22.5","start":66022005,"end":66022005,"break":"none","ruby":[[0,1,"よる"],[13,2,"たいよう"],[16,1,"ひかり"],[24,1,"しゅ"],[27,1,"かみ"],[29,1,"かれ"],[32,1,"てら"],[39,1,"かれ"],[42,2,"よよ"],[44,1,"かぎ"],[48,2,"しはい"]],"text":"夜は、もはやない。あかりも太陽の光も、いらない。主なる神が彼らを照し、そして、彼らは世々限りなく支配する。"},{"ref":"Rev.22.6","start":66022006,"end":66022006,"break":"paragraph","ruby":[[0,1,"かれ"],[9,1,"い"],[18,2,"ことば"],[21,1,"しん"],[36,3,"よげんしゃ"],[47,1,"かみ"],[50,1,"しゅ"],[57,1,"おこ"],[66,1,"しもべ"],[70,1,"しめ"],[77,2,"みつかい"]],"text":"彼はまた、わたしに言った、「これらの言葉は信ずべきであり、まことである。預言者たちのたましいの神なる主は、すぐにも起るべきことをその僕たちに示そうとして、御使をつかわされたのである。"},{"ref":"Rev.22.7","start":66022007,"end":66022007,"break":"none","ruby":[[0,1,"み"],[11,1,"く"],[16,1,"しょ"],[18,2,"よげん"],[21,2,"ことば"],[24,1,"まも"],[26,1,"もの"]],"text":"見よ、わたしは、すぐに来る。この書の預言の言葉を守る者は、さいわいである」。"},{"ref":"Rev.22.8","start":66022008,"end":66022008,"break":"paragraph","ruby":[[7,2,"みき"],[12,1,"もの"],[28,2,"みき"],[33,1,"とき"],[42,1,"しめ"],[48,2,"みつかい"],[51,1,"あし"],[57,1,"ふ"],[60,1,"はい"]],"text":"これらのことを見聞きした者は、このヨハネである。わたしが見聞きした時、それらのことを示してくれた御使の足もとにひれ伏して拝そうとすると、"},{"ref":"Rev.22.9","start":66022009,"end":66022009,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[37,2,"きょうだい"],[42,3,"よげんしゃ"],[51,1,"しょ"],[53,2,"ことば"],[56,1,"まも"],[58,1,"もの"],[63,1,"おな"],[65,1,"しもべ"],[66,2,"なかま"],[74,1,"かみ"],[78,1,"はい"]],"text":"彼は言った、「そのようなことをしてはいけない。わたしは、あなたや、あなたの兄弟である預言者たちや、この書の言葉を守る者たちと、同じ僕仲間である。ただ神だけを拝しなさい」。"},{"ref":"Rev.22.10","start":66022010,"end":66022010,"break":"paragraph","ruby":[[6,1,"い"],[13,1,"しょ"],[15,2,"よげん"],[18,2,"ことば"],[21,1,"ふう"],[30,1,"とき"],[32,1,"ちか"]],"text":"またわたしに言った、「この書の預言の言葉を封じてはならない。時が近づいているからである。"},{"ref":"Rev.22.11","start":66022011,"end":66022011,"break":"none","ruby":[[0,2,"ふぎ"],[3,1,"もの"],[8,2,"ふぎ"],[11,1,"おこな"],[14,1,"けが"],[17,1,"もの"],[22,1,"けが"],[28,1,"おこな"],[31,1,"ぎ"],[34,1,"もの"],[39,1,"ぎ"],[41,1,"おこな"],[44,1,"せい"],[47,1,"もの"],[52,1,"せい"],[58,1,"おこな"]],"text":"不義な者はさらに不義を行い、汚れた者はさらに汚れたことを行い、義なる者はさらに義を行い、聖なる者はさらに聖なることを行うままにさせよ」。"},{"ref":"Rev.22.12","start":66022012,"end":66022012,"break":"paragraph","ruby":[[1,1,"み"],[11,1,"く"],[14,1,"むく"],[17,1,"たずさ"],[32,1,"おう"],[35,1,"むく"]],"text":"「見よ、わたしはすぐに来る。報いを携えてきて、それぞれのしわざに応じて報いよう。"},{"ref":"Rev.22.13","start":66022013,"end":66022013,"break":"none","ruby":[[18,2,"さいしょ"],[21,1,"もの"],[26,2,"さいご"],[29,1,"もの"],[34,1,"はじ"],[40,1,"おわ"]],"text":"わたしはアルパであり、オメガである。最初の者であり、最後の者である。初めであり、終りである。"},{"ref":"Rev.22.14","start":66022014,"end":66022014,"break":"none","ruby":[[4,1,"き"],[10,2,"とっけん"],[13,1,"あた"],[20,1,"もん"],[26,1,"みやこ"],[35,2,"じぶん"],[38,2,"きもの"],[41,1,"あら"],[43,1,"もの"]],"text":"いのちの木にあずかる特権を与えられ、また門をとおって都にはいるために、自分の着物を洗う者たちは、さいわいである。"},{"ref":"Rev.22.15","start":66022015,"end":66022015,"break":"none","ruby":[[0,1,"いぬ"],[11,1,"もの"],[13,2,"かんいん"],[16,1,"おこな"],[18,1,"もの"],[20,2,"ひとごろ"],[24,2,"ぐうぞう"],[27,1,"おが"],[29,1,"もの"],[34,1,"いつわ"],[37,1,"この"],[44,1,"おこな"],[46,1,"もの"],[51,1,"そと"],[53,1,"だ"]],"text":"犬ども、まじないをする者、姦淫を行う者、人殺し、偶像を拝む者、また、偽りを好みかつこれを行う者はみな、外に出されている。"},{"ref":"Rev.22.16","start":66022016,"end":66022016,"break":"paragraph","ruby":[[8,1,"つかい"],[16,1,"しょ"],[17,2,"きょうかい"],[52,1,"わか"],[53,1,"えだ"],[56,2,"しそん"],[62,1,"かがや"],[64,1,"あ"],[67,2,"みょうじょう"]],"text":"わたしイエスは、使をつかわして、諸教会のために、これらのことをあなたがたにあかしした。わたしは、ダビデの若枝また子孫であり、輝く明けの明星である」。"},{"ref":"Rev.22.17","start":66022017,"end":66022017,"break":"paragraph","ruby":[[0,2,"みたま"],[3,2,"はなよめ"],[6,1,"とも"],[8,1,"い"],[23,1,"き"],[25,1,"もの"],[35,1,"い"],[47,1,"もの"],[52,1,"く"],[62,1,"みず"],[67,1,"もの"],[70,1,"あたい"],[77,1,"う"]],"text":"御霊も花嫁も共に言った、「きたりませ」。また、聞く者も「きたりませ」と言いなさい。かわいている者はここに来るがよい。いのちの水がほしい者は、価なしにそれを受けるがよい。"},{"ref":"Rev.22.18","start":66022018,"end":66022018,"break":"paragraph","ruby":[[2,1,"しょ"],[4,2,"よげん"],[7,2,"ことば"],[10,1,"き"],[16,2,"ひとびと"],[19,1,"たい"],[27,2,"けいこく"],[37,1,"か"],[39,1,"くわ"],[42,1,"もの"],[48,1,"かみ"],[52,1,"ひと"],[57,1,"しょ"],[59,1,"か"],[65,2,"さいがい"],[68,1,"くわ"]],"text":"この書の預言の言葉を聞くすべての人々に対して、わたしは警告する。もしこれに書き加える者があれば、神はその人に、この書に書かれている災害を加えられる。"},{"ref":"Rev.22.19","start":66022019,"end":66022019,"break":"none","ruby":[[7,2,"よげん"],[10,1,"しょ"],[12,2,"ことば"],[17,1,"のぞ"],[19,1,"もの"],[25,1,"かみ"],[29,1,"ひと"],[31,1,"う"],[35,1,"ふん"],[40,1,"しょ"],[42,1,"か"],[52,1,"き"],[54,1,"せい"],[57,1,"みやこ"],[63,1,"のぞ"]],"text":"また、もしこの預言の書の言葉をとり除く者があれば、神はその人の受くべき分を、この書に書かれているいのちの木と聖なる都から、とり除かれる。"},{"ref":"Rev.22.20","start":66022020,"end":66022020,"break":"paragraph","ruby":[[15,1,"おお"],[33,1,"く"],[42,1,"しゅ"]],"text":"これらのことをあかしするかたが仰せになる、「しかり、わたしはすぐに来る」。アァメン、主イエスよ、きたりませ。"},{"ref":"Rev.22.21","start":66022021,"end":66022021,"break":"paragraph","ruby":[[0,1,"しゅ"],[5,1,"めぐ"],[9,2,"いちどう"],[12,1,"もの"],[14,1,"とも"]],"text":"主イエスの恵みが、一同の者と共にあるように。"}]