[{"ref":"Isa.17.1","start":23017001,"end":23017001,"break":"paragraph","breaks":[[12,"stanza"]],"ruby":[[9,2,"たくせん"],[12,1,"み"],[20,1,"まち"],[22,1,"すがた"],[24,1,"うしな"],[28,2,"あらつか"]],"text":"ダマスコについての託宣。見よ、ダマスコは町の姿を失って、荒塚となる。"},{"ref":"Isa.17.2","start":23017002,"end":23017002,"break":"line","breaks":[[15,"line"],[36,"line"]],"ruby":[[2,2,"まちまち"],[10,1,"す"],[15,2,"かちく"],[18,1,"む"],[21,1,"す"],[23,1,"ところ"],[29,1,"ふ"],[39,1,"おびや"],[42,1,"もの"]],"text":"その町々はとこしえに捨てられ、家畜の群れの住む所となって、伏しやすむが、これを脅かす者はない。"},{"ref":"Isa.17.3","start":23017003,"end":23017003,"break":"line","breaks":[[14,"line"],[25,"line"],[44,"line"],[56,"line"]],"ruby":[[19,2,"しゅけん"],[29,1,"のこ"],[32,1,"もの"],[41,1,"こ"],[44,2,"えいこう"],[50,1,"き"],[56,2,"ばんぐん"],[59,1,"しゅ"],[61,1,"い"]],"text":"エフライムのとりではすたり、ダマスコの主権はやみ、スリヤの残れる者は、イスラエルの子らの栄光のように消えうせると万軍の主は言われる。"},{"ref":"Isa.17.4","start":23017004,"end":23017004,"break":"paragraph","breaks":[[14,"line"]],"ruby":[[2,1,"ひ"],[8,1,"さか"],[11,1,"おとろ"],[16,1,"こ"],[20,1,"にく"]],"text":"その日、ヤコブの栄えは衰え、その肥えたる肉はやせ、"},{"ref":"Isa.17.5","start":23017005,"end":23017005,"break":"line","breaks":[[20,"line"],[41,"line"]],"ruby":[[4,2,"かりい"],[7,1,"ひと"],[11,1,"か"],[15,1,"むぎ"],[17,1,"あつ"],[27,1,"ほ"],[29,1,"か"],[31,1,"と"],[46,1,"たに"],[48,1,"ほ"],[50,1,"ひろ"],[52,1,"あつ"]],"text":"あたかも刈入れ人がまだ刈らない麦を集め、かいなをもって穂を刈り取ったあとのように、レパイムの谷で穂を拾い集めたあとのようになる。"},{"ref":"Isa.17.6","start":23017006,"end":23017006,"break":"line","breaks":[[11,"line"],[25,"line"],[34,"line"],[49,"line"],[61,"line"]],"ruby":[[4,1,"き"],[6,1,"う"],[16,1,"み"],[22,1,"のこ"],[37,1,"おお"],[39,1,"き"],[41,1,"えだ"],[43,1,"のこ"],[51,1,"のこ"],[67,1,"かみ"],[69,1,"しゅ"],[71,1,"い"]],"text":"オリブの木を打つとき、二つ三つの実をこずえに残し、あるいは四つ五つをみのり多き木の枝に残すように、とり残されるものがあるとイスラエルの神、主は言われる。"},{"ref":"Isa.17.7","start":23017007,"end":23017007,"break":"paragraph","ruby":[[2,1,"ひ"],[4,2,"ひとびと"],[9,1,"つく"],[11,1,"ぬし"],[13,1,"あお"],[25,2,"せいじゃ"],[28,1,"め"]],"text":"その日、人々はその造り主を仰ぎのぞみ、イスラエルの聖者に目をとめ、"},{"ref":"Isa.17.8","start":23017008,"end":23017008,"break":"none","ruby":[[4,1,"て"],[11,2,"さいだん"],[14,1,"あお"],[25,1,"ゆび"],[27,1,"つく"],[33,1,"ぞう"],[35,1,"こう"],[37,2,"さいだん"],[41,1,"め"]],"text":"おのれの手のわざである祭壇を仰ぎのぞまず、おのれの指が造ったアシラ像と香の祭壇とに目をとめない。"},{"ref":"Isa.17.9","start":23017009,"end":23017009,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"かれ"],[7,2,"けんご"],[10,2,"まちまち"],[13,1,"むかし"],[20,1,"こ"],[26,1,"す"],[28,1,"さ"],[45,1,"あ"],[47,1,"あと"],[52,1,"あ"],[54,1,"ち"]],"text":"その日、彼らの堅固な町々は昔イスラエルの子らのゆえに捨て去られたヒビびとおよびアモリびとの荒れ跡のように荒れ地になる。"},{"ref":"Isa.17.10","start":23017010,"end":23017010,"break":"paragraph","breaks":[[19,"line"],[41,"line"],[61,"line"]],"ruby":[[9,2,"じぶん"],[12,1,"すくい"],[14,1,"かみ"],[16,1,"わす"],[19,2,"じぶん"],[22,1,"さ"],[24,1,"どころ"],[27,1,"いわ"],[29,1,"こころ"],[52,1,"うつく"],[55,2,"しょくぶつ"],[58,1,"う"],[61,1,"こと"],[64,1,"かみ"],[66,1,"き"],[68,1,"えだ"]],"text":"これはあなたがたが自分の救の神を忘れ、自分の避け所なる岩を心にとめなかったからだ。それゆえ、あなたがたは美しい植物を植え、異なる神の切り枝をさし、"},{"ref":"Isa.17.11","start":23017011,"end":23017011,"break":"line","breaks":[[15,"line"],[32,"line"]],"ruby":[[2,1,"う"],[5,1,"ひ"],[10,2,"せいちょう"],[20,1,"あさ"],[25,1,"はな"],[26,1,"さ"],[34,2,"しゅうかく"],[37,1,"かな"],[48,1,"くる"],[52,1,"ひ"],[56,1,"さ"]],"text":"その植えた日にこれを成長させ、そのまいた朝にこれを花咲かせても、その収穫は悲しみと、いやしがたい苦しみの日にとび去る。"},{"ref":"Isa.17.12","start":23017012,"end":23017012,"break":"paragraph","breaks":[[15,"line"],[37,"line"],[54,"line"]],"ruby":[[3,1,"おお"],[6,1,"たみ"],[15,1,"うみ"],[27,1,"かれ"],[45,1,"くに"],[54,2,"おおみず"],[67,1,"かれ"]],"text":"ああ、多くの民はなりどよめく、海のなりどよめくように、彼らはなりどよめく。ああ、もろもろの国はなりとどろく、大水のなりとどろくように、彼らはなりとどろく。"},{"ref":"Isa.17.13","start":23017013,"end":23017013,"break":"line","breaks":[[12,"line"],[29,"line"],[45,"line"],[55,"line"],[76,"line"]],"ruby":[[5,1,"くに"],[7,1,"おお"],[10,1,"みず"],[33,1,"かみ"],[35,1,"かれ"],[38,1,"こら"],[45,1,"かれ"],[48,1,"とお"],[55,1,"かぜ"],[57,1,"ふ"],[59,1,"さ"],[63,1,"やま"],[65,1,"うえ"],[78,2,"ぼうふう"],[83,1,"ま"],[91,1,"お"]],"text":"もろもろの国は多くの水のなりとどろくように、なりとどろく。しかし、神は彼らを懲しめられる。彼らは遠くのがれて、風に吹き去られる山の上のもみがらのように、また暴風にうず巻くちりのように追いやられる。"},{"ref":"Isa.17.14","start":23017014,"end":23017014,"break":"line","breaks":[[14,"line"],[32,"line"],[52,"line"]],"ruby":[[0,2,"ゆうぐれ"],[5,1,"み"],[8,1,"おそ"],[16,1,"よ"],[18,1,"あ"],[25,1,"かれ"],[44,1,"もの"],[46,1,"う"],[50,1,"ぶん"],[57,1,"うば"],[59,1,"もの"],[61,1,"ひ"]],"text":"夕暮には、見よ、恐れがある。まだ夜の明けないうちに彼らはうせた。これはわれわれをかすめる者の受くべき分、われわれを奪う者の引くべきくじである。"}]