[{"ref":"Josh.3.1","start":6003001,"end":6003001,"break":"paragraph","ruby":[[5,1,"あさ"],[6,1,"はや"],[8,1,"お"],[17,2,"ひとびと"],[31,2,"しゅったつ"],[41,1,"い"],[47,1,"わた"],[55,1,"やど"]],"text":"ヨシュアは朝早く起き、イスラエルの人々すべてとともにシッテムを出立して、ヨルダンに行き、それを渡らずに、そこに宿った。"},{"ref":"Josh.3.2","start":6003002,"end":6003002,"break":"none","ruby":[[1,1,"か"],[3,1,"のち"],[11,2,"しゅくえい"],[14,1,"なか"],[16,1,"い"],[18,1,"めぐ"]],"text":"三日の後、つかさたちは宿営の中を行き巡り、"},{"ref":"Josh.3.3","start":6003003,"end":6003003,"break":"none","ruby":[[0,1,"たみ"],[2,1,"めい"],[5,1,"い"],[17,2,"さいし"],[29,1,"かみ"],[31,1,"しゅ"],[33,2,"けいやく"],[36,1,"はこ"],[45,1,"み"],[59,1,"ところ"],[61,2,"しゅったつ"],[71,1,"したが"]],"text":"民に命じて言った、「レビびとである祭司たちが、あなたがたの神、主の契約の箱をかきあげるのを見るならば、あなたがたはその所を出立して、そのあとに従わなければならない。"},{"ref":"Josh.3.4","start":6003004,"end":6003004,"break":"none","ruby":[[12,1,"い"],[16,1,"みち"],[18,1,"し"],[37,1,"まえ"],[41,1,"みち"],[68,1,"はこ"],[71,1,"あいだ"],[86,2,"きょり"],[103,1,"ちか"]],"text":"そうすれば、あなたがたは行くべき道を知ることができるであろう。あなたがたは前にこの道をとおったことがないからである。しかし、あなたがたと箱との間には、おおよそ二千キュビトの距離をおかなければならない。それに近づいてはならない」。"},{"ref":"Josh.3.5","start":6003005,"end":6003005,"break":"none","ruby":[[7,1,"たみ"],[9,1,"い"],[20,1,"み"],[22,1,"きよ"],[31,1,"しゅ"],[42,3,"ふしぎ"],[46,1,"おこな"]],"text":"ヨシュアはまた民に言った、「あなたがたは身を清めなさい。あす、主があなたがたのうちに不思議を行われるからである」。"},{"ref":"Josh.3.6","start":6003006,"end":6003006,"break":"none","ruby":[[5,2,"さいし"],[10,1,"い"],[15,2,"けいやく"],[18,1,"はこ"],[23,1,"たみ"],[25,2,"さきだ"],[29,1,"わた"],[39,1,"かれ"],[42,2,"けいやく"],[45,1,"はこ"],[50,1,"たみ"],[52,2,"さきだ"],[56,1,"すす"]],"text":"ヨシュアは祭司たちに言った、「契約の箱をかき、民に先立って渡りなさい」。そこで彼らは契約の箱をかき、民に先立って進んだ。"},{"ref":"Josh.3.7","start":6003007,"end":6003007,"break":"paragraph","ruby":[[0,1,"しゅ"],[7,1,"い"],[32,1,"まえ"],[38,1,"たっと"],[40,1,"もの"],[61,1,"とも"],[81,1,"かれ"],[84,1,"し"]],"text":"主はヨシュアに言われた、「きょうからわたしはすべてのイスラエルの前にあなたを尊い者とするであろう。こうしてわたしがモーセと共にいたように、あなたとともにおることを彼らに知らせるであろう。"},{"ref":"Josh.3.8","start":6003008,"end":6003008,"break":"none","ruby":[[4,2,"けいやく"],[7,1,"はこ"],[11,2,"さいし"],[16,1,"めい"],[19,1,"い"],[43,1,"みず"],[47,1,"い"],[59,1,"なか"],[61,1,"た"]],"text":"あなたは契約の箱をかく祭司たちに命じて言わなければならない、『あなたがたは、ヨルダンの水ぎわへ行くと、すぐ、ヨルダンの中に立ちとどまらなければならない』」。"},{"ref":"Josh.3.9","start":6003009,"end":6003009,"break":"none","ruby":[[11,2,"ひとびと"],[14,1,"い"],[28,1,"ちか"],[39,1,"かみ"],[41,1,"しゅ"],[43,2,"ことば"],[46,1,"き"]],"text":"ヨシュアはイスラエルの人々に言った、「あなたがたはここに近づいて、あなたがたの神、主の言葉を聞きなさい」。"},{"ref":"Josh.3.10","start":6003010,"end":6003010,"break":"none","ruby":[[8,1,"い"],[13,1,"い"],[16,1,"かみ"],[40,1,"まえ"],[86,1,"かなら"],[88,1,"お"],[90,1,"はら"],[98,1,"つぎ"],[113,1,"し"]],"text":"そしてヨシュアは言った、「生ける神があなたがたのうちにおいでになり、あなたがたの前から、カナンびと、ヘテびと、ヒビびと、ペリジびと、ギルガシびと、アモリびと、エブスびとを、必ず追い払われることを、次のことによって、あなたがたは知るであろう。"},{"ref":"Josh.3.11","start":6003011,"end":6003011,"break":"none","ruby":[[7,1,"ぜん"],[8,1,"ち"],[10,1,"しゅ"],[12,2,"けいやく"],[15,1,"はこ"],[24,2,"さきだ"],[33,1,"わた"]],"text":"ごらんなさい。全地の主の契約の箱は、あなたがたに先立ってヨルダンを渡ろうとしている。"},{"ref":"Josh.3.12","start":6003012,"end":6003012,"break":"none","ruby":[[5,1,"いま"],[13,2,"ぶぞく"],[21,2,"ぶぞく"],[32,1,"あ"],[38,1,"にん"],[40,1,"えら"]],"text":"それゆえ、今、イスラエルの部族のうちから、部族ごとにひとりずつ、合わせて十二人を選びなさい。"},{"ref":"Josh.3.13","start":6003013,"end":6003013,"break":"none","ruby":[[0,1,"ぜん"],[1,1,"ち"],[3,1,"しゅ"],[6,1,"かみ"],[8,1,"はこ"],[12,2,"さいし"],[17,1,"あし"],[19,1,"うら"],[27,1,"みず"],[29,1,"なか"],[31,1,"ふ"],[37,1,"とき"],[44,1,"みず"],[46,1,"なが"],[56,1,"うえ"],[59,1,"なが"],[64,1,"みず"],[74,1,"たか"]],"text":"全地の主なる神の箱をかく祭司たちの足の裏が、ヨルダンの水の中に踏みとどまる時、ヨルダンの水は流れをせきとめられ、上から流れくだる水はとどまって、うず高くなるであろう」。"},{"ref":"Josh.3.14","start":6003014,"end":6003014,"break":"paragraph","ruby":[[4,1,"たみ"],[11,1,"わた"],[17,2,"てんまく"],[22,1,"た"],[25,2,"さいし"],[30,2,"けいやく"],[33,1,"はこ"],[38,1,"たみ"],[40,2,"さきだ"],[44,1,"い"]],"text":"こうして民はヨルダンを渡ろうとして天幕をいで立ち、祭司たちは契約の箱をかき、民に先立って行ったが、"},{"ref":"Josh.3.15","start":6003015,"end":6003015,"break":"none","ruby":[[0,1,"はこ"],[4,1,"もの"],[14,1,"はこ"],[18,2,"さいし"],[23,1,"あし"],[25,1,"みず"],[33,2,"どうじ"],[44,2,"かりい"],[48,1,"あいだ"],[49,1,"ぢゅう"],[51,1,"きし"],[52,2,"いちめん"]],"text":"箱をかく者がヨルダンにきて、箱をかく祭司たちの足が水ぎわにひたると同時に、――ヨルダンは刈入れの間中、岸一面にあふれるのであるが、――"},{"ref":"Josh.3.16","start":6003016,"end":6003016,"break":"none","ruby":[[0,1,"うえ"],[3,1,"なが"],[8,1,"みず"],[19,1,"とお"],[34,1,"まち"],[46,1,"たか"],[48,1,"た"],[55,1,"うみ"],[60,1,"しお"],[62,1,"うみ"],[64,1,"ほう"],[66,1,"なが"],[71,1,"みず"],[73,1,"まった"],[85,1,"たみ"],[91,1,"む"],[95,1,"わた"]],"text":"上から流れくだる水はとどまって、はるか遠くのザレタンのかたわらにある町アダムのあたりで、うず高く立ち、アラバの海すなわち塩の海の方に流れくだる水は全くせきとめられたので、民はエリコに向かって渡った。"},{"ref":"Josh.3.17","start":6003017,"end":6003017,"break":"none","ruby":[[15,1,"ち"],[17,1,"わた"],[20,1,"い"],[22,1,"あいだ"],[24,1,"しゅ"],[26,2,"けいやく"],[29,1,"はこ"],[33,2,"さいし"],[44,1,"なか"],[50,1,"ち"],[52,1,"た"],[64,1,"たみ"],[73,1,"わた"],[75,1,"おわ"]],"text":"すべてのイスラエルが、かわいた地を渡って行く間、主の契約の箱をかく祭司たちは、ヨルダンの中のかわいた地に立っていた。そしてついに民はみなヨルダンを渡り終った。"}]