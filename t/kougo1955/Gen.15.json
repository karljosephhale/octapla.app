[{"ref":"Gen.15.1","start":1015001,"end":1015001,"break":"paragraph","breaks":[[27,"stanza"],[42,"line"],[55,"line"],[66,"line"]],"ruby":[[4,1,"こと"],[6,1,"のち"],[8,1,"しゅ"],[10,2,"ことば"],[13,1,"まぼろし"],[23,1,"のぞ"],[33,1,"おそ"],[50,1,"たて"],[59,1,"う"],[62,1,"むく"],[70,1,"おお"]],"text":"これらの事の後、主の言葉が幻のうちにアブラムに臨んだ、「アブラムよ恐れてはならない、わたしはあなたの盾である。あなたの受ける報いは、はなはだ大きいであろう」。"},{"ref":"Gen.15.2","start":1015002,"end":1015002,"break":"none","ruby":[[5,1,"い"],[10,1,"しゅ"],[13,1,"かみ"],[21,1,"こ"],[30,1,"いえ"],[32,1,"つ"],[34,1,"もの"],[60,1,"なに"]],"text":"アブラムは言った、「主なる神よ、わたしには子がなく、わたしの家を継ぐ者はダマスコのエリエゼルであるのに、あなたはわたしに何をくださろうとするのですか」。"},{"ref":"Gen.15.3","start":1015003,"end":1015003,"break":"none","ruby":[[7,1,"い"],[20,1,"こ"],[22,1,"たま"],[34,1,"いえ"],[36,1,"うま"]],"text":"アブラムはまた言った、「あなたはわたしに子を賜わらないので、わたしの家に生れたしもべが、あとつぎとなるでしょう」。"},{"ref":"Gen.15.4","start":1015004,"end":1015004,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,2,"ことば"],[9,1,"かれ"],[11,1,"のぞ"],[18,1,"もの"],[45,1,"み"],[48,1,"で"],[50,1,"もの"]],"text":"この時、主の言葉が彼に臨んだ、「この者はあなたのあとつぎとなるべきではありません。あなたの身から出る者があとつぎとなるべきです」。"},{"ref":"Gen.15.5","start":1015005,"end":1015005,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"かれ"],[7,1,"そと"],[9,1,"つ"],[11,1,"だ"],[14,1,"い"],[20,1,"てん"],[22,1,"あお"],[26,1,"ほし"],[28,1,"かぞ"],[40,1,"かぞ"],[51,1,"かれ"],[53,1,"い"],[63,2,"しそん"]],"text":"そして主は彼を外に連れ出して言われた、「天を仰いで、星を数えることができるなら、数えてみなさい」。また彼に言われた、「あなたの子孫はあのようになるでしょう」。"},{"ref":"Gen.15.6","start":1015006,"end":1015006,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"しん"],[11,1,"しゅ"],[16,1,"かれ"],[18,1,"ぎ"],[20,1,"みと"]],"text":"アブラムは主を信じた。主はこれを彼の義と認められた。"},{"ref":"Gen.15.7","start":1015007,"end":1015007,"break":"paragraph","ruby":[[2,1,"しゅ"],[4,1,"かれ"],[6,1,"い"],[18,1,"ち"],[24,1,"あた"],[31,1,"つ"],[51,1,"みちび"],[53,1,"だ"],[56,1,"しゅ"]],"text":"また主は彼に言われた、「わたしはこの地をあなたに与えて、これを継がせようと、あなたをカルデヤのウルから導き出した主です」。"},{"ref":"Gen.15.8","start":1015008,"end":1015008,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,1,"しゅ"],[10,1,"かみ"],[20,1,"つ"],[28,1,"し"]],"text":"彼は言った、「主なる神よ、わたしがこれを継ぐのをどうして知ることができますか」。"},{"ref":"Gen.15.9","start":1015009,"end":1015009,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"い"],[11,1,"さい"],[13,2,"めうし"],[18,1,"さい"],[20,1,"め"],[26,1,"さい"],[28,2,"おひつじ"],[32,1,"やま"],[37,1,"いえ"],[49,1,"ところ"],[51,1,"つ"]],"text":"主は彼に言われた、「三歳の雌牛と、三歳の雌やぎと、三歳の雄羊と、山ばとと、家ばとのひなとをわたしの所に連れてきなさい」。"},{"ref":"Gen.15.10","start":1015010,"end":1015010,"break":"none","ruby":[[0,1,"かれ"],[8,1,"つ"],[17,1,"さ"],[20,1,"さ"],[26,1,"たがい"],[28,1,"む"],[31,1,"あ"],[35,1,"お"],[43,1,"とり"],[45,1,"さ"]],"text":"彼はこれらをみな連れてきて、二つに裂き、裂いたものを互に向かい合わせて置いた。ただし、鳥は裂かなかった。"},{"ref":"Gen.15.11","start":1015011,"end":1015011,"break":"none","ruby":[[0,1,"あら"],[2,1,"とり"],[4,2,"したい"],[7,1,"うえ"],[9,1,"お"],[23,1,"お"],[25,1,"はら"]],"text":"荒い鳥が死体の上に降りるとき、アブラムはこれを追い払った。"},{"ref":"Gen.15.12","start":1015012,"end":1015012,"break":"paragraph","ruby":[[0,1,"ひ"],[2,1,"い"],[12,1,"ふか"],[14,1,"ねむ"],[22,1,"とき"],[24,1,"おお"],[27,1,"おそ"],[31,1,"くら"],[35,1,"かれ"],[37,1,"のぞ"]],"text":"日の入るころ、アブラムが深い眠りにおそわれた時、大きな恐ろしい暗やみが彼に臨んだ。"},{"ref":"Gen.15.13","start":1015013,"end":1015013,"break":"none","ruby":[[0,1,"とき"],[2,1,"しゅ"],[9,1,"い"],[21,1,"こころ"],[36,2,"しそん"],[39,1,"た"],[41,1,"くに"],[43,1,"たび"],[53,2,"ひとびと"],[56,1,"つか"],[61,2,"ひとびと"],[64,1,"かれ"],[69,1,"ねん"],[71,1,"あいだ"],[73,1,"なや"]],"text":"時に主はアブラムに言われた、「あなたはよく心にとめておきなさい。あなたの子孫は他の国に旅びととなって、その人々に仕え、その人々は彼らを四百年の間、悩ますでしょう。"},{"ref":"Gen.15.14","start":1015014,"end":1015014,"break":"none","ruby":[[8,1,"かれ"],[11,1,"つか"],[16,2,"こくみん"],[27,1,"のち"],[32,1,"おお"],[35,2,"ざいさん"],[38,1,"たずさ"],[41,1,"で"],[43,1,"く"]],"text":"しかし、わたしは彼らが仕えたその国民をさばきます。その後かれらは多くの財産を携えて出て来るでしょう。"},{"ref":"Gen.15.15","start":1015015,"end":1015015,"break":"none","ruby":[[4,1,"やす"],[8,2,"せんぞ"],[14,1,"い"],[22,2,"こうれい"],[25,1,"たっ"],[28,1,"ほうむ"]],"text":"あなたは安らかに先祖のもとに行きます。そして高齢に達して葬られるでしょう。"},{"ref":"Gen.15.16","start":1015016,"end":1015016,"break":"none","ruby":[[1,1,"だい"],[2,1,"め"],[7,1,"かれ"],[13,1,"かえ"],[16,1,"く"],[29,1,"あく"],[33,1,"み"]],"text":"四代目になって彼らはここに帰って来るでしょう。アモリびとの悪がまだ満ちないからです」。"},{"ref":"Gen.15.17","start":1015017,"end":1015017,"break":"paragraph","ruby":[[3,1,"ひ"],[5,1,"い"],[8,1,"くら"],[15,1,"とき"],[17,1,"けむり"],[19,1,"た"],[25,1,"ほのお"],[27,1,"で"],[35,1,"さ"],[41,1,"あいだ"],[43,1,"とお"],[45,1,"す"]],"text":"やがて日は入り、暗やみになった時、煙の立つかまど、炎の出るたいまつが、裂いたものの間を通り過ぎた。"},{"ref":"Gen.15.18","start":1015018,"end":1015018,"break":"none","breaks":[[22,"stanza"],[42,"line"]],"ruby":[[2,1,"ひ"],[4,1,"しゅ"],[11,2,"けいやく"],[14,1,"むす"],[17,1,"い"],[29,1,"ち"],[35,2,"しそん"],[38,1,"あた"],[47,1,"かわ"],[53,2,"おおかわ"]],"text":"その日、主はアブラムと契約を結んで言われた、「わたしはこの地をあなたの子孫に与える。エジプトの川から、かの大川ユフラテまで。"},{"ref":"Gen.15.19","start":1015019,"end":1015019,"break":"none","text":"すなわちケニびと、ケニジびと、カドモニびと、"},{"ref":"Gen.15.20","start":1015020,"end":1015020,"break":"none","text":"ヘテびと、ペリジびと、レパイムびと、"},{"ref":"Gen.15.21","start":1015021,"end":1015021,"break":"none","ruby":[[25,1,"ち"],[27,1,"あた"]],"text":"アモリびと、カナンびと、ギルガシびと、エブスびとの地を与える」。"}]