[{"ref":"Dan.8.1","start":27008001,"end":27008001,"break":"paragraph","ruby":[[7,1,"さき"],[9,1,"まぼろし"],[11,1,"み"],[15,1,"のち"],[24,1,"おう"],[26,2,"ちせい"],[29,1,"だい"],[31,1,"ねん"],[37,1,"まぼろし"],[43,1,"しめ"]],"text":"われダニエルは先に幻を見たが、後またベルシャザル王の治世の第三年に、一つの幻がわたしに示された。"},{"ref":"Dan.8.2","start":27008002,"end":27008002,"break":"none","ruby":[[2,1,"まぼろし"],[4,1,"み"],[12,1,"しゅう"],[14,2,"しゅと"],[21,1,"とき"],[30,1,"かわ"]],"text":"その幻を見たのは、エラム州の首都スサにいた時であって、ウライ川のほとりにおいてであった。"},{"ref":"Dan.8.3","start":27008003,"end":27008003,"break":"none","ruby":[[4,1,"め"],[9,1,"み"],[13,1,"かわ"],[15,1,"きし"],[18,1,"ぴき"],[20,2,"おひつじ"],[23,1,"た"],[35,1,"つの"],[43,1,"つの"],[45,1,"とも"],[47,1,"なが"],[56,1,"つの"],[58,1,"た"],[60,1,"つの"],[64,1,"なが"],[71,1,"なが"],[75,1,"のち"],[77,1,"の"]],"text":"わたしが目をあげて見ると、川の岸に一匹の雄羊が立っていた。これに二つの角があって、その角は共に長かったが、一つの角は他の角よりも長かった。その長いのは後に伸びたのである。"},{"ref":"Dan.8.4","start":27008004,"end":27008004,"break":"none","ruby":[[4,1,"み"],[12,2,"おひつじ"],[16,1,"にし"],[18,1,"きた"],[20,1,"みなみ"],[26,2,"とつげき"],[35,1,"あた"],[43,1,"けもの"],[46,1,"ぴき"],[55,1,"て"],[58,1,"すく"],[60,1,"だ"],[81,1,"こころ"],[95,1,"たか"]],"text":"わたしが見ていると、その雄羊は、西、北、南にむかって突撃したが、これに当ることのできる獣は一匹もなく、またその手から救い出すことのできるものもなかった。これはその心のままにふるまい、みずから高ぶっていた。"},{"ref":"Dan.8.5","start":27008005,"end":27008005,"break":"paragraph","ruby":[[7,1,"かんが"],[10,1,"み"],[17,1,"ぴき"],[19,1,"お"],[24,1,"ぜん"],[25,1,"ち"],[31,1,"と"],[37,1,"にし"],[46,1,"あし"],[48,1,"つち"],[50,1,"ふ"],[64,1,"め"],[66,1,"あいだ"],[68,1,"いちじる"],[74,1,"つの"]],"text":"わたしがこれを考え、見ていると、一匹の雄やぎが、全地のおもてを飛びわたって西からきたが、その足は土を踏まなかった。このやぎには、目の間に著しい一つの角があった。"},{"ref":"Dan.8.6","start":27008006,"end":27008006,"break":"none","ruby":[[2,1,"もの"],[12,1,"かわ"],[14,1,"きし"],[16,1,"た"],[23,1,"み"],[31,1,"つの"],[35,2,"おひつじ"],[45,1,"はげ"],[48,1,"いか"],[54,1,"はし"],[56,1,"よ"]],"text":"この者は、さきにわたしが川の岸に立っているのを見た、あの二つの角のある雄羊にむかってきて、激しく怒ってこれに走り寄った。"},{"ref":"Dan.8.7","start":27008007,"end":27008007,"break":"none","ruby":[[4,1,"み"],[13,2,"おひつじ"],[16,2,"ちかよ"],[28,1,"いか"],[31,1,"はっ"],[34,2,"おひつじ"],[37,1,"う"],[46,1,"つの"],[48,1,"くだ"],[52,2,"おひつじ"],[60,1,"あた"],[62,1,"ちから"],[74,2,"おひつじ"],[77,1,"ち"],[79,1,"う"],[81,1,"たお"],[84,1,"ふ"],[95,2,"おひつじ"],[102,1,"ちから"],[105,1,"すく"],[109,1,"もの"]],"text":"わたしが見ていると、それが雄羊に近寄るや、これにむかって怒りを発し、雄羊を撃って、その二つの角を砕いた。雄羊には、これに当る力がなかったので、やぎは雄羊を地に打ち倒して踏みつけた。また、その雄羊を、やぎの力から救いうる者がなかった。"},{"ref":"Dan.8.8","start":27008008,"end":27008008,"break":"none","ruby":[[7,1,"お"],[18,1,"たか"],[26,1,"さか"],[32,1,"とき"],[36,1,"おお"],[39,1,"つの"],[41,1,"お"],[47,1,"かわ"],[53,1,"いちじる"],[56,1,"つの"],[58,1,"しょう"],[61,1,"てん"],[63,2,"しほう"],[66,1,"む"]],"text":"こうして、その雄やぎは、はなはだしく高ぶったが、その盛んになった時、あの大きな角が折れて、その代りに四つの著しい角が生じ、天の四方に向かった。"},{"ref":"Dan.8.9","start":27008009,"end":27008009,"break":"paragraph","ruby":[[2,1,"つの"],[12,1,"ちい"],[15,1,"つの"],[17,1,"で"],[20,1,"みなみ"],[22,1,"む"],[26,1,"ひがし"],[28,1,"む"],[32,1,"うるわ"],[35,1,"ち"],[37,1,"む"],[48,1,"おお"]],"text":"その角の一つから、一つの小さい角が出て、南に向かい、東に向かい、麗しい地に向かって、はなはだしく大きくなり、"},{"ref":"Dan.8.10","start":27008010,"end":27008010,"break":"none","ruby":[[0,1,"てん"],[2,1,"しゅう"],[3,1,"ぐん"],[5,1,"およ"],[10,1,"おお"],[16,1,"ほし"],[18,1,"しゅう"],[19,1,"ぐん"],[24,2,"すうこ"],[27,1,"ち"],[29,1,"な"],[31,1,"くだ"],[38,1,"ふ"]],"text":"天の衆群に及ぶまでに大きくなり、星の衆群のうちの数個を地に投げ下して、これを踏みつけ、"},{"ref":"Dan.8.11","start":27008011,"end":27008011,"break":"none","ruby":[[6,1,"たか"],[13,1,"しゅう"],[14,1,"ぐん"],[16,1,"しゅ"],[18,1,"てき"],[23,2,"じょうく"],[26,2,"はんさい"],[29,1,"と"],[31,1,"のぞ"],[38,2,"せいじょ"],[41,1,"たお"]],"text":"またみずから高ぶって、その衆群の主に敵し、その常供の燔祭を取り除き、かつその聖所を倒した。"},{"ref":"Dan.8.12","start":27008012,"end":27008012,"break":"none","ruby":[[5,1,"しゅう"],[6,1,"ぐん"],[9,1,"つみ"],[15,2,"じょうく"],[18,2,"はんさい"],[21,1,"とも"],[35,1,"つの"],[39,2,"しんり"],[42,1,"ち"],[44,1,"な"],[65,1,"さか"]],"text":"そしてその衆群は、罪によって、常供の燔祭と共に、これにわたされた。その角はまた真理を地に投げうち、ほしいままにふるまって、みずから栄えた。"},{"ref":"Dan.8.13","start":27008013,"end":27008013,"break":"none","ruby":[[13,2,"せいじゃ"],[16,1,"かた"],[23,1,"き"],[33,2,"せいじゃ"],[42,1,"かた"],[47,2,"せいじゃ"],[54,1,"い"],[59,2,"じょうく"],[62,2,"はんさい"],[66,1,"あら"],[73,1,"つみ"],[76,2,"せいじょ"],[81,1,"しゅう"],[82,1,"ぐん"],[90,1,"あし"],[92,1,"した"],[94,1,"ふ"],[108,1,"まぼろし"]],"text":"それから、わたしはひとりの聖者の語っているのを聞いた。またひとりの聖者があって、その語っている聖者にむかって言った、「常供の燔祭と、荒すことをなす罪と、聖所とその衆群がわたされて、足の下に踏みつけられることについて、幻にあらわれたことは、いつまでだろうか」と。"},{"ref":"Dan.8.14","start":27008014,"end":27008014,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[12,1,"ゆう"],[14,1,"あさ"],[16,1,"あいだ"],[24,2,"せいじょ"],[27,1,"きよ"],[34,1,"ただ"],[37,2,"じょうたい"],[40,1,"ふく"]],"text":"彼は言った、「二千三百の夕と朝の間である。そして聖所は清められてその正しい状態に復する」。"},{"ref":"Dan.8.15","start":27008015,"end":27008015,"break":"paragraph","ruby":[[9,1,"まぼろし"],[11,1,"み"],[16,2,"いみ"],[19,1,"し"],[23,1,"もと"],[28,1,"とき"],[30,1,"み"],[33,1,"ひと"],[38,1,"み"],[41,1,"もの"],[48,1,"まえ"],[50,1,"た"]],"text":"われダニエルはこの幻を見て、その意味を知ろうと求めていた時、見よ、人のように見える者が、わたしの前に立った。"},{"ref":"Dan.8.16","start":27008016,"end":27008016,"break":"none","ruby":[[7,1,"かわ"],[9,1,"りょう"],[10,1,"がん"],[12,1,"あいだ"],[15,1,"ひと"],[17,1,"こえ"],[19,1,"で"],[22,1,"よ"],[28,1,"き"],[42,1,"まぼろし"],[46,1,"ひと"],[48,1,"さと"]],"text":"わたしはウライ川の両岸の間から人の声が出て、呼ばわるのを聞いた、「ガブリエルよ、この幻をその人に悟らせよ」。"},{"ref":"Dan.8.17","start":27008017,"end":27008017,"break":"none","ruby":[[3,1,"かれ"],[9,1,"た"],[14,1,"ところ"],[19,1,"かれ"],[30,1,"おそ"],[36,1,"ふ"],[44,1,"かれ"],[50,1,"い"],[55,1,"ひと"],[57,1,"こ"],[60,1,"さと"],[68,1,"まぼろし"],[70,1,"おわ"],[73,1,"とき"]],"text":"すると彼はわたしの立っている所にきた。彼がきたとき、わたしは恐れて、ひれ伏した。しかし、彼はわたしに言った、「人の子よ、悟りなさい。この幻は終りの時にかかわるものです」。"},{"ref":"Dan.8.18","start":27008018,"end":27008018,"break":"paragraph","ruby":[[0,1,"かれ"],[6,1,"かた"],[11,1,"とき"],[17,1,"ち"],[21,1,"ふ"],[25,1,"ふか"],[27,1,"ねむ"],[30,1,"おちい"],[35,1,"かれ"],[41,1,"て"],[43,1,"ふ"],[50,1,"た"]],"text":"彼がわたしに語っていた時、わたしは地にひれ伏して、深い眠りに陥ったが、彼はわたしに手を触れ、わたしを立たせて、"},{"ref":"Dan.8.19","start":27008019,"end":27008019,"break":"none","ruby":[[0,1,"い"],[5,1,"み"],[12,1,"いきどお"],[15,1,"おわ"],[18,1,"とき"],[20,1,"おこ"],[32,1,"し"],[41,1,"さだ"],[46,1,"おわ"],[49,1,"とき"]],"text":"言った、「見よ、わたしは憤りの終りの時に起るべきことを、あなたに知らせよう。それは定められた終りの時にかかわるものであるから。"},{"ref":"Dan.8.20","start":27008020,"end":27008020,"break":"none","ruby":[[4,1,"み"],[12,1,"つの"],[16,2,"おひつじ"],[29,1,"おう"]],"text":"あなたが見た、あの二つの角のある雄羊は、メデアとペルシャの王です。"},{"ref":"Dan.8.21","start":27008021,"end":27008021,"break":"none","ruby":[[5,1,"お"],[14,1,"おう"],[20,1,"め"],[22,1,"あいだ"],[24,1,"おお"],[27,1,"つの"],[32,1,"だい"],[35,1,"おう"]],"text":"また、かの雄やぎはギリシヤの王です、その目の間の大きな角は、その第一の王です。"},{"ref":"Dan.8.22","start":27008022,"end":27008022,"break":"none","ruby":[[4,1,"つの"],[6,1,"お"],[12,1,"かわ"],[18,1,"つの"],[20,1,"しょう"],[28,1,"たみ"],[34,1,"くに"],[36,1,"おこ"],[46,1,"だい"],[49,1,"おう"],[54,2,"せいりょく"]],"text":"またその角が折れて、その代りに四つの角が生じたのは、その民から四つの国が起るのです。しかし、第一の王のような勢力はない。"},{"ref":"Dan.8.23","start":27008023,"end":27008023,"break":"none","ruby":[[0,1,"かれ"],[3,1,"くに"],[5,1,"おわ"],[8,1,"とき"],[13,1,"つみ"],[17,1,"つみ"],[19,1,"み"],[23,1,"およ"],[31,1,"おう"],[33,1,"おこ"],[42,1,"かお"],[44,2,"もうあく"],[48,1,"かれ"],[53,1,"と"]],"text":"彼らの国の終りの時になり、罪びとの罪が満ちるに及んで、ひとりの王が起るでしょう。その顔は猛悪で、彼はなぞを解き、"},{"ref":"Dan.8.24","start":27008024,"end":27008024,"break":"none","ruby":[[2,2,"せいりょく"],[5,1,"さか"],[12,1,"おそ"],[16,2,"はかい"],[29,2,"せいこう"],[34,2,"ゆうりょく"],[37,2,"ひとびと"],[41,2,"せいと"],[46,1,"たみ"],[48,1,"ほろ"]],"text":"その勢力は盛んであって、恐ろしい破壊をなし、そのなすところ成功して、有力な人々と、聖徒である民を滅ぼすでしょう。"},{"ref":"Dan.8.25","start":27008025,"end":27008025,"break":"none","ruby":[[0,1,"かれ"],[2,3,"わるぢえ"],[10,1,"いつわ"],[15,1,"て"],[21,1,"と"],[28,1,"こころ"],[30,1,"たか"],[34,2,"ふい"],[37,1,"おお"],[40,1,"ひと"],[42,1,"う"],[44,1,"ほろ"],[50,1,"きみ"],[52,1,"きみ"],[55,1,"もの"],[57,1,"てき"],[72,1,"かれ"],[74,2,"ひとで"],[81,1,"ほろ"]],"text":"彼は悪知恵をもって、偽りをその手におこない遂げ、みずから心に高ぶり、不意に多くの人を打ち滅ぼし、また君の君たる者に敵するでしょう。しかし、ついに彼は人手によらずに滅ぼされるでしょう。"},{"ref":"Dan.8.26","start":27008026,"end":27008026,"break":"none","ruby":[[0,1,"さき"],[2,1,"しめ"],[6,2,"あさゆう"],[9,1,"まぼろし"],[11,2,"しんじつ"],[26,1,"まぼろし"],[28,2,"ひみつ"],[47,1,"おお"],[50,1,"ひ"],[52,1,"のち"],[58,1,"こと"]],"text":"先に示された朝夕の幻は真実です。しかし、あなたはその幻を秘密にしておかなければならない。これは多くの日の後にかかわる事だから」。"},{"ref":"Dan.8.27","start":27008027,"end":27008027,"break":"paragraph","ruby":[[7,1,"つか"],[13,2,"すうじつ"],[16,1,"あいだ"],[17,1,"や"],[26,1,"のち"],[27,1,"お"],[31,1,"おう"],[33,2,"じむ"],[36,1,"と"],[50,1,"まぼろし"],[52,1,"こと"],[54,1,"おも"],[57,1,"おどろ"],[66,1,"さと"]],"text":"われダニエルは疲れはてて、数日の間病みわずらったが、後起きて、王の事務を執った。しかし、わたしはこの幻の事を思って驚いた。またこれを悟ることができなかった。"}]