[{"ref":"Ps.124.1","start":19124001,"end":19124001,"break":"paragraph","title":"ダビデがよんだ都もうでの歌","breaks":[[11,"line"]],"ruby":[[0,1,"いま"],[8,1,"い"],[11,1,"しゅ"],[19,1,"ほう"]],"titleRuby":[[7,1,"みやこ"],[12,1,"うた"]],"text":"今、イスラエルは言え、主がもしわれらの方におられなかったならば、"},{"ref":"Ps.124.2","start":19124002,"end":19124002,"break":"line","breaks":[[20,"line"]],"ruby":[[0,2,"ひとびと"],[7,1,"さか"],[11,1,"た"],[20,1,"しゅ"],[28,1,"ほう"]],"text":"人々がわれらに逆らって立ちあがったとき、主がもしわれらの方におられなかったならば、"},{"ref":"Ps.124.3","start":19124003,"end":19124003,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"かれ"],[3,1,"いか"],[14,1,"も"],[22,1,"かれ"],[29,1,"い"]],"text":"彼らの怒りがわれらにむかって燃えたったとき、彼らはわれらを生きているままで、のんだであろう。"},{"ref":"Ps.124.4","start":19124004,"end":19124004,"break":"line","breaks":[[14,"line"]],"ruby":[[2,2,"おおみず"],[9,1,"お"],[11,1,"なが"],[14,2,"げきりゅう"],[21,1,"うえ"],[23,1,"こ"]],"text":"また大水はわれらを押し流し、激流はわれらの上を越え、"},{"ref":"Ps.124.5","start":19124005,"end":19124005,"break":"line","ruby":[[2,1,"ま"],[4,1,"みず"],[10,1,"うえ"],[12,1,"こ"]],"text":"さか巻く水はわれらの上を越えたであろう。"},{"ref":"Ps.124.6","start":19124006,"end":19124006,"break":"line","breaks":[[9,"line"],[21,"line"]],"ruby":[[0,1,"しゅ"],[9,1,"しゅ"],[21,1,"かれ"],[24,1,"は"]],"text":"主はほむべきかな。主はわれらをえじきとして彼らの歯にわたされなかった。"},{"ref":"Ps.124.7","start":19124007,"end":19124007,"break":"line","breaks":[[17,"line"],[27,"line"]],"ruby":[[4,2,"やちょう"],[7,1,"とら"],[17,1,"とり"],[30,1,"やぶ"]],"text":"われらは野鳥を捕えるわなをのがれる鳥のようにのがれた。わなは破れてわれらはのがれた。"},{"ref":"Ps.124.8","start":19124008,"end":19124008,"break":"line","ruby":[[4,1,"たす"],[7,2,"てんち"],[10,1,"つく"],[14,1,"しゅ"],[17,1,"な"]],"text":"われらの助けは天地を造られた主のみ名にある。"}]