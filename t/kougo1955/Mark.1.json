[{"ref":"Mark.1.1","start":41001001,"end":41001001,"break":"paragraph","ruby":[[0,1,"かみ"],[2,1,"こ"],[12,2,"ふくいん"]],"text":"神の子イエス・キリストの福音のはじめ。"},{"ref":"Mark.1.2","start":41001002,"end":41001002,"break":"paragraph","breaks":[[10,"stanza"],[31,"line"]],"ruby":[[0,3,"よげんしゃ"],[7,1,"しょ"],[11,1,"み"],[18,1,"つかい"],[24,1,"さき"],[35,1,"みち"],[37,1,"ととの"]],"text":"預言者イザヤの書に、「見よ、わたしは使をあなたの先につかわし、あなたの道を整えさせるであろう。"},{"ref":"Mark.1.3","start":41001003,"end":41001003,"break":"line","breaks":[[14,"line"],[23,"line"]],"ruby":[[0,2,"あらの"],[3,1,"よ"],[7,1,"もの"],[9,1,"こえ"],[15,1,"しゅ"],[17,1,"みち"],[19,1,"そな"],[25,1,"みち"],[26,1,"すじ"],[38,1,"か"]],"text":"荒野で呼ばわる者の声がする、『主の道を備えよ、その道筋をまっすぐにせよ』」と書いてあるように、"},{"ref":"Mark.1.4","start":41001004,"end":41001004,"break":"none","ruby":[[10,2,"あらの"],[13,1,"あらわ"],[17,1,"つみ"],[23,1,"え"],[27,2,"くいあらた"],[37,1,"の"],[39,1,"つた"]],"text":"バプテスマのヨハネが荒野に現れて、罪のゆるしを得させる悔改めのバプテスマを宣べ伝えていた。"},{"ref":"Mark.1.5","start":41001005,"end":41001005,"break":"none","ruby":[[7,2,"ぜんど"],[16,1,"ぜん"],[17,2,"じゅうみん"],[22,1,"かれ"],[32,1,"で"],[34,1,"い"],[38,2,"じぶん"],[41,1,"つみ"],[43,2,"こくはく"],[51,1,"がわ"],[64,1,"う"]],"text":"そこで、ユダヤ全土とエルサレムの全住民とが、彼のもとにぞくぞくと出て行って、自分の罪を告白し、ヨルダン川でヨハネからバプテスマを受けた。"},{"ref":"Mark.1.6","start":41001006,"end":41001006,"break":"none","ruby":[[11,1,"け"],[16,1,"み"],[22,1,"こし"],[24,1,"かわ"],[26,1,"おび"],[35,1,"の"],[36,1,"みつ"],[39,2,"しょくもつ"]],"text":"このヨハネは、らくだの毛ごろもを身にまとい、腰に皮の帯をしめ、いなごと野蜜とを食物としていた。"},{"ref":"Mark.1.7","start":41001007,"end":41001007,"break":"none","ruby":[[0,1,"かれ"],[2,1,"の"],[4,1,"つた"],[7,1,"い"],[18,1,"ちから"],[54,1,"と"],[56,1,"ね"]],"text":"彼は宣べ伝えて言った、「わたしよりも力のあるかたが、あとからおいでになる。わたしはかがんで、そのくつのひもを解く値うちもない。"},{"ref":"Mark.1.8","start":41001008,"end":41001008,"break":"none","ruby":[[4,1,"みず"],[12,1,"さづ"],[23,2,"せいれい"],[36,1,"さづ"]],"text":"わたしは水でバプテスマを授けたが、このかたは、聖霊によってバプテスマをお授けになるであろう」。"},{"ref":"Mark.1.9","start":41001009,"end":41001009,"break":"paragraph","ruby":[[19,1,"で"],[28,1,"がわ"],[43,1,"う"]],"text":"そのころ、イエスはガリラヤのナザレから出てきて、ヨルダン川で、ヨハネからバプテスマをお受けになった。"},{"ref":"Mark.1.10","start":41001010,"end":41001010,"break":"none","ruby":[[4,1,"みず"],[6,1,"なか"],[9,1,"あ"],[18,1,"てん"],[20,1,"さ"],[24,2,"せいれい"],[33,2,"じぶん"],[36,1,"くだ"],[39,1,"く"]],"text":"そして、水の中から上がられるとすぐ、天が裂けて、聖霊がはとのように自分に下って来るのを、ごらんになった。"},{"ref":"Mark.1.11","start":41001011,"end":41001011,"break":"none","ruby":[[3,1,"てん"],[6,1,"こえ"],[21,1,"あい"],[24,1,"こ"],[30,1,"こころ"],[35,1,"もの"]],"text":"すると天から声があった、「あなたはわたしの愛する子、わたしの心にかなう者である」。"},{"ref":"Mark.1.12","start":41001012,"end":41001012,"break":"paragraph","ruby":[[8,2,"みたま"],[15,2,"あらの"],[18,1,"お"]],"text":"それからすぐに、御霊がイエスを荒野に追いやった。"},{"ref":"Mark.1.13","start":41001013,"end":41001013,"break":"none","ruby":[[6,1,"にち"],[11,2,"あらの"],[21,1,"こころ"],[32,1,"けもの"],[41,2,"みつかい"],[50,1,"つか"]],"text":"イエスは四十日のあいだ荒野にいて、サタンの試みにあわれた。そして獣もそこにいたが、御使たちはイエスに仕えていた。"},{"ref":"Mark.1.14","start":41001014,"end":41001014,"break":"paragraph","ruby":[[4,1,"とら"],[9,1,"のち"],[20,1,"い"],[23,1,"かみ"],[25,2,"ふくいん"],[28,1,"の"],[30,1,"つた"],[33,1,"い"]],"text":"ヨハネが捕えられた後、イエスはガリラヤに行き、神の福音を宣べ伝えて言われた、"},{"ref":"Mark.1.15","start":41001015,"end":41001015,"break":"none","ruby":[[1,1,"とき"],[3,1,"み"],[7,1,"かみ"],[9,1,"くに"],[11,1,"ちか"],[16,1,"く"],[18,1,"あらた"],[21,2,"ふくいん"],[24,1,"しん"]],"text":"「時は満ちた、神の国は近づいた。悔い改めて福音を信ぜよ」。"},{"ref":"Mark.1.16","start":41001016,"end":41001016,"break":"paragraph","ruby":[[12,1,"うみ"],[15,1,"ある"],[18,1,"い"],[30,2,"きょうだい"],[39,1,"うみ"],[41,1,"あみ"],[43,1,"う"],[58,1,"かれ"],[61,2,"りょうし"]],"text":"さて、イエスはガリラヤの海べを歩いて行かれ、シモンとシモンの兄弟アンデレとが、海で網を打っているのをごらんになった。彼らは漁師であった。"},{"ref":"Mark.1.17","start":41001017,"end":41001017,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[32,2,"にんげん"],[37,2,"りょうし"]],"text":"イエスは彼らに言われた、「わたしについてきなさい。あなたがたを、人間をとる漁師にしてあげよう」。"},{"ref":"Mark.1.18","start":41001018,"end":41001018,"break":"none","ruby":[[4,1,"かれ"],[10,1,"あみ"],[12,1,"す"],[20,1,"したが"]],"text":"すると、彼らはすぐに網を捨てて、イエスに従った。"},{"ref":"Mark.1.19","start":41001019,"end":41001019,"break":"none","ruby":[[2,1,"すこ"],[4,1,"すす"],[7,1,"い"],[18,1,"こ"],[25,2,"きょうだい"],[33,1,"ふね"],[35,1,"なか"],[37,1,"あみ"],[39,1,"つくろ"]],"text":"また少し進んで行かれると、ゼベダイの子ヤコブとその兄弟ヨハネとが、舟の中で網を繕っているのをごらんになった。"},{"ref":"Mark.1.20","start":41001020,"end":41001020,"break":"none","ruby":[[6,1,"かれ"],[10,1,"まね"],[17,1,"ちち"],[23,2,"やといにん"],[28,2,"いっしょ"],[31,1,"ふね"],[47,1,"い"]],"text":"そこで、すぐ彼らをお招きになると、父ゼベダイを雇人たちと一緒に舟において、イエスのあとについて行った。"},{"ref":"Mark.1.21","start":41001021,"end":41001021,"break":"paragraph","ruby":[[5,1,"かれ"],[14,1,"い"],[21,3,"あんそくにち"],[32,2,"かいどう"],[39,1,"おし"]],"text":"それから、彼らはカペナウムに行った。そして安息日にすぐ、イエスは会堂にはいって教えられた。"},{"ref":"Mark.1.22","start":41001022,"end":41001022,"break":"none","ruby":[[0,2,"ひとびと"],[6,1,"おしえ"],[8,1,"おどろ"],[12,2,"りっぽう"],[14,2,"がくしゃ"],[27,2,"けんい"],[31,1,"もの"],[37,1,"おし"]],"text":"人々は、その教に驚いた。律法学者たちのようにではなく、権威ある者のように、教えられたからである。"},{"ref":"Mark.1.23","start":41001023,"end":41001023,"break":"none","ruby":[[6,1,"とき"],[12,1,"れい"],[18,1,"もの"],[20,2,"かいどう"],[26,1,"さけ"],[29,1,"い"]],"text":"ちょうどその時、けがれた霊につかれた者が会堂にいて、叫んで言った、"},{"ref":"Mark.1.24","start":41001024,"end":41001024,"break":"none","ruby":[[23,1,"かか"],[39,1,"ほろ"],[72,1,"かみ"],[74,2,"せいじゃ"]],"text":"「ナザレのイエスよ、あなたはわたしたちとなんの係わりがあるのです。わたしたちを滅ぼしにこられたのですか。あなたがどなたであるか、わかっています。神の聖者です」。"},{"ref":"Mark.1.25","start":41001025,"end":41001025,"break":"none","ruby":[[13,1,"だま"],[18,1,"ひと"],[21,1,"で"],[23,1,"い"],[27,1,"い"]],"text":"イエスはこれをしかって、「黙れ、この人から出て行け」と言われた。"},{"ref":"Mark.1.26","start":41001026,"end":41001026,"break":"none","ruby":[[8,1,"れい"],[10,1,"かれ"],[19,2,"おおごえ"],[28,1,"ひと"],[31,1,"で"],[33,1,"い"]],"text":"すると、けがれた霊は彼をひきつけさせ、大声をあげて、その人から出て行った。"},{"ref":"Mark.1.27","start":41001027,"end":41001027,"break":"none","ruby":[[0,2,"ひとびと"],[5,1,"おどろ"],[12,1,"たがい"],[14,1,"ろん"],[17,1,"い"],[30,2,"なにごと"],[34,2,"けんい"],[38,1,"あたら"],[41,1,"おしえ"],[48,1,"れい"],[52,1,"めい"],[59,1,"かれ"],[62,1,"したが"]],"text":"人々はみな驚きのあまり、互に論じて言った、「これは、いったい何事か。権威ある新しい教だ。けがれた霊にさえ命じられると、彼らは従うのだ」。"},{"ref":"Mark.1.28","start":41001028,"end":41001028,"break":"none","ruby":[[22,1,"ぜん"],[23,2,"ちほう"],[29,1,"ところ"]],"text":"こうしてイエスのうわさは、たちまちガリラヤの全地方、いたる所にひろまった。"},{"ref":"Mark.1.29","start":41001029,"end":41001029,"break":"paragraph","ruby":[[4,2,"かいどう"],[7,1,"で"],[22,1,"つ"],[36,1,"いえ"],[42,1,"い"]],"text":"それから会堂を出るとすぐ、ヤコブとヨハネとを連れて、シモンとアンデレとの家にはいって行かれた。"},{"ref":"Mark.1.30","start":41001030,"end":41001030,"break":"none","ruby":[[15,2,"ねつびょう"],[18,1,"とこ"],[28,2,"ひとびと"],[45,1,"し"]],"text":"ところが、シモンのしゅうとめが熱病で床についていたので、人々はさっそく、そのことをイエスに知らせた。"},{"ref":"Mark.1.31","start":41001031,"end":41001031,"break":"none","ruby":[[4,2,"ちかよ"],[10,1,"て"],[15,1,"おこ"],[21,1,"ねつ"],[23,1,"ひ"],[26,1,"おんな"],[28,1,"かれ"]],"text":"イエスは近寄り、その手をとって起されると、熱が引き、女は彼らをもてなした。"},{"ref":"Mark.1.32","start":41001032,"end":41001032,"break":"paragraph","ruby":[[0,2,"ゆうぐれ"],[5,1,"ひ"],[7,1,"しず"],[11,2,"ひとびと"],[14,2,"びょうにん"],[17,2,"あくれい"],[24,1,"もの"],[37,1,"つ"]],"text":"夕暮になり日が沈むと、人々は病人や悪霊につかれた者をみな、イエスのところに連れてきた。"},{"ref":"Mark.1.33","start":41001033,"end":41001033,"break":"none","ruby":[[5,2,"まちじゅう"],[8,1,"もの"],[10,2,"とぐち"],[13,1,"あつ"]],"text":"こうして、町中の者が戸口に集まった。"},{"ref":"Mark.1.34","start":41001034,"end":41001034,"break":"none","ruby":[[10,1,"やまい"],[19,1,"おお"],[22,2,"ひとびと"],[31,1,"おお"],[34,2,"あくれい"],[37,1,"お"],[39,1,"だ"],[47,2,"あくれい"],[53,2,"ものい"],[60,1,"ゆる"],[70,1,"かれ"],[77,1,"し"]],"text":"イエスは、さまざまの病をわずらっている多くの人々をいやし、また多くの悪霊を追い出された。また、悪霊どもに、物言うことをお許しにならなかった。彼らがイエスを知っていたからである。"},{"ref":"Mark.1.35","start":41001035,"end":41001035,"break":"paragraph","ruby":[[0,1,"あさ"],[5,1,"よる"],[7,1,"あ"],[13,1,"まえ"],[20,1,"お"],[23,1,"さび"],[26,1,"ところ"],[28,1,"で"],[30,1,"い"],[36,1,"いの"]],"text":"朝はやく、夜の明けるよほど前に、イエスは起きて寂しい所へ出て行き、そこで祈っておられた。"},{"ref":"Mark.1.36","start":41001036,"end":41001036,"break":"none","ruby":[[10,2,"なかま"],[18,1,"お"]],"text":"すると、シモンとその仲間とが、あとを追ってきた。"},{"ref":"Mark.1.37","start":41001037,"end":41001037,"break":"none","ruby":[[7,1,"み"],[22,1,"さが"],[30,1,"い"]],"text":"そしてイエスを見つけて、「みんなが、あなたを捜しています」と言った。"},{"ref":"Mark.1.38","start":41001038,"end":41001038,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[17,2,"ふきん"],[20,2,"まちまち"],[27,1,"い"],[35,1,"おしえ"],[37,1,"の"],[39,1,"つた"],[53,1,"で"]],"text":"イエスは彼らに言われた、「ほかの、附近の町々にみんなで行って、そこでも教を宣べ伝えよう。わたしはこのために出てきたのだから」。"},{"ref":"Mark.1.39","start":41001039,"end":41001039,"break":"none","ruby":[[8,1,"ぜん"],[9,1,"ち"],[11,1,"めぐ"],[18,1,"しょ"],[19,2,"かいどう"],[22,1,"おしえ"],[24,1,"の"],[26,1,"つた"],[31,2,"あくれい"],[34,1,"お"],[36,1,"だ"]],"text":"そして、ガリラヤ全地を巡りあるいて、諸会堂で教を宣べ伝え、また悪霊を追い出された。"},{"ref":"Mark.1.40","start":41001040,"end":41001040,"break":"paragraph","ruby":[[6,2,"びょうにん"],[18,1,"ねが"],[30,1,"い"]],"text":"ひとりのらい病人が、イエスのところに願いにきて、ひざまずいて言った、「みこころでしたら、きよめていただけるのですが」。"},{"ref":"Mark.1.41","start":41001041,"end":41001041,"break":"none","ruby":[[4,1,"ふか"],[11,1,"て"],[13,1,"の"],[17,1,"かれ"],[40,1,"い"]],"text":"イエスは深くあわれみ、手を伸ばして彼にさわり、「そうしてあげよう、きよくなれ」と言われた。"},{"ref":"Mark.1.42","start":41001042,"end":41001042,"break":"none","ruby":[[6,1,"びょう"],[8,1,"ただ"],[11,1,"さ"],[17,1,"ひと"]],"text":"すると、らい病が直ちに去って、その人はきよくなった。"},{"ref":"Mark.1.43","start":41001043,"end":41001043,"break":"none","ruby":[[4,1,"かれ"],[10,1,"いまし"],[20,1,"さ"],[26,1,"い"],[28,1,"き"]],"text":"イエスは彼をきびしく戒めて、すぐにそこを去らせ、こう言い聞かせられた、"},{"ref":"Mark.1.44","start":41001044,"end":41001044,"break":"none","ruby":[[1,1,"なに"],[3,1,"ひと"],[5,1,"はな"],[13,2,"ちゅうい"],[22,1,"い"],[26,2,"じぶん"],[33,2,"さいし"],[36,1,"み"],[48,1,"めい"],[51,1,"もの"],[69,2,"ひとびと"],[72,2,"しょうめい"]],"text":"「何も人に話さないように、注意しなさい。ただ行って、自分のからだを祭司に見せ、それから、モーセが命じた物をあなたのきよめのためにささげて、人々に証明しなさい」。"},{"ref":"Mark.1.45","start":41001045,"end":41001045,"break":"none","ruby":[[4,1,"かれ"],[6,1,"で"],[8,1,"い"],[12,2,"じぶん"],[15,1,"み"],[17,1,"おこ"],[23,1,"さか"],[26,1,"かた"],[31,1,"い"],[50,2,"おもてだ"],[55,1,"まち"],[71,1,"そと"],[73,1,"さび"],[76,1,"ところ"],[92,2,"ひとびと"],[95,2,"ほうぼう"],[113,1,"あつ"]],"text":"しかし、彼は出て行って、自分の身に起ったことを盛んに語り、また言いひろめはじめたので、イエスはもはや表立っては町に、はいることができなくなり、外の寂しい所にとどまっておられた。しかし、人々は方々から、イエスのところにぞくぞくと集まってきた。"}]