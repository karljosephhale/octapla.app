[{"ref":"Rev.1.1","start":66001001,"end":66001001,"break":"paragraph","ruby":[[9,2,"もくし"],[14,2,"もくし"],[18,1,"かみ"],[25,1,"おこ"],[34,1,"しもべ"],[38,1,"しめ"],[47,1,"あた"],[60,2,"みつかい"],[69,1,"しもべ"],[74,1,"つた"]],"text":"イエス・キリストの黙示。この黙示は、神が、すぐにも起るべきことをその僕たちに示すためキリストに与え、そして、キリストが、御使をつかわして、僕ヨハネに伝えられたものである。"},{"ref":"Rev.1.2","start":66001002,"end":66001002,"break":"none","ruby":[[5,1,"かみ"],[7,1,"ことば"],[28,2,"じぶん"],[31,1,"み"]],"text":"ヨハネは、神の言とイエス・キリストのあかしと、すなわち、自分が見たすべてのことをあかしした。"},{"ref":"Rev.1.3","start":66001003,"end":66001003,"break":"none","ruby":[[2,2,"よげん"],[5,2,"ことば"],[8,2,"ろうどく"],[12,1,"もの"],[18,1,"き"],[24,1,"なか"],[26,1,"か"],[35,1,"まも"],[37,1,"もの"],[51,1,"とき"],[53,1,"ちか"]],"text":"この預言の言葉を朗読する者と、これを聞いて、その中に書かれていることを守る者たちとは、さいわいである。時が近づいているからである。"},{"ref":"Rev.1.4","start":66001004,"end":66001004,"break":"paragraph","ruby":[[14,2,"きょうかい"],[18,1,"いま"],[23,1,"むかし"],[46,2,"みざ"],[49,1,"まえ"],[56,1,"れい"]],"text":"ヨハネからアジヤにある七つの教会へ。今いまし、昔いまし、やがてきたるべきかたから、また、その御座の前にある七つの霊から、"},{"ref":"Rev.1.5","start":66001005,"end":66001005,"break":"none","ruby":[[3,2,"ちゅうじつ"],[6,2,"しょうにん"],[9,2,"しにん"],[12,1,"なか"],[15,2,"さいしょ"],[18,1,"うま"],[21,1,"もの"],[23,2,"ちじょう"],[26,2,"しょおう"],[29,3,"しはいしゃ"],[46,1,"めぐ"],[49,2,"へいあん"],[72,1,"あい"],[77,1,"ち"],[88,1,"つみ"],[91,2,"かいほう"]],"text":"また、忠実な証人、死人の中から最初に生れた者、地上の諸王の支配者であるイエス・キリストから、恵みと平安とが、あなたがたにあるように。わたしたちを愛し、その血によってわたしたちを罪から解放し、"},{"ref":"Rev.1.6","start":66001006,"end":66001006,"break":"none","ruby":[[9,1,"ちち"],[12,1,"かみ"],[18,2,"みくに"],[21,1,"たみ"],[25,2,"さいし"],[30,1,"くだ"],[38,2,"よよ"],[40,1,"かぎ"],[44,2,"えいこう"],[47,2,"けんりょく"]],"text":"わたしたちを、その父なる神のために、御国の民とし、祭司として下さったかたに、世々限りなく栄光と権力とがあるように、アァメン。"},{"ref":"Rev.1.7","start":66001007,"end":66001007,"break":"paragraph","ruby":[[0,1,"み"],[3,1,"かれ"],[6,1,"くも"],[8,1,"の"],[20,1,"ひと"],[22,1,"め"],[28,1,"かれ"],[30,1,"さ"],[36,1,"もの"],[41,1,"かれ"],[43,1,"あお"],[45,1,"み"],[54,2,"ちじょう"],[57,1,"しょ"],[58,1,"ぞく"],[63,1,"かれ"],[68,1,"むね"],[70,1,"う"],[73,1,"なげ"]],"text":"見よ、彼は、雲に乗ってこられる。すべての人の目、ことに、彼を刺しとおした者たちは、彼を仰ぎ見るであろう。また地上の諸族はみな、彼のゆえに胸を打って嘆くであろう。しかり、アァメン。"},{"ref":"Rev.1.8","start":66001008,"end":66001008,"break":"paragraph","ruby":[[0,1,"いま"],[5,1,"むかし"],[18,1,"もの"],[20,3,"ぜんのうしゃ"],[26,1,"しゅ"],[29,1,"かみ"],[31,1,"おお"]],"text":"今いまし、昔いまし、やがてきたるべき者、全能者にして主なる神が仰せになる、「わたしはアルパであり、オメガである」。"},{"ref":"Rev.1.9","start":66001009,"end":66001009,"break":"paragraph","ruby":[[6,2,"きょうだい"],[12,1,"とも"],[18,2,"くなん"],[21,2,"みくに"],[24,2,"にんたい"],[44,1,"かみ"],[46,1,"ことば"],[68,1,"しま"]],"text":"あなたがたの兄弟であり、共にイエスの苦難と御国と忍耐とにあずかっている、わたしヨハネは、神の言とイエスのあかしとのゆえに、パトモスという島にいた。"},{"ref":"Rev.1.10","start":66001010,"end":66001010,"break":"none","ruby":[[10,1,"しゅ"],[12,1,"ひ"],[14,2,"みたま"],[17,1,"かん"],[33,1,"ほう"],[43,1,"おお"],[46,1,"こえ"],[52,1,"き"]],"text":"ところが、わたしは、主の日に御霊に感じた。そして、わたしのうしろの方で、ラッパのような大きな声がするのを聞いた。"},{"ref":"Rev.1.11","start":66001011,"end":66001011,"break":"none","ruby":[[2,1,"こえ"],[6,1,"い"],[15,1,"み"],[22,1,"か"],[75,2,"きょうかい"],[78,1,"おく"]],"text":"その声はこう言った、「あなたが見ていることを書きものにして、それをエペソ、スミルナ、ペルガモ、テアテラ、サルデス、ヒラデルヒヤ、ラオデキヤにある七つの教会に送りなさい」。"},{"ref":"Rev.1.12","start":66001012,"end":66001012,"break":"none","ruby":[[12,1,"よ"],[19,1,"こえ"],[21,1,"み"],[42,1,"きん"],[44,2,"しょくだい"],[47,1,"め"]],"text":"そこでわたしは、わたしに呼びかけたその声を見ようとしてふりむいた。ふりむくと、七つの金の燭台が目についた。"},{"ref":"Rev.1.13","start":66001013,"end":66001013,"break":"none","ruby":[[4,2,"しょくだい"],[7,1,"あいだ"],[10,1,"あし"],[16,2,"うわぎ"],[19,1,"き"],[21,1,"むね"],[23,1,"きん"],[25,1,"おび"],[32,1,"ひと"],[34,1,"こ"],[39,1,"もの"]],"text":"それらの燭台の間に、足までたれた上着を着、胸に金の帯をしめている人の子のような者がいた。"},{"ref":"Rev.1.14","start":66001014,"end":66001014,"break":"none","ruby":[[6,1,"かみ"],[8,1,"け"],[12,1,"ゆき"],[17,1,"しろ"],[19,2,"ようもう"],[22,1,"に"],[24,2,"まっしろ"],[30,1,"め"],[32,1,"も"],[35,1,"ほのお"]],"text":"そのかしらと髪の毛とは、雪のように白い羊毛に似て真白であり、目は燃える炎のようであった。"},{"ref":"Rev.1.15","start":66001015,"end":66001015,"break":"none","ruby":[[2,1,"あし"],[5,1,"ろ"],[7,2,"せいれん"],[12,1,"ひか"],[14,1,"かがや"],[28,1,"こえ"],[30,2,"おおみず"]],"text":"その足は、炉で精錬されて光り輝くしんちゅうのようであり、声は大水のとどろきのようであった。"},{"ref":"Rev.1.16","start":66001016,"end":66001016,"break":"none","ruby":[[2,2,"みぎて"],[8,1,"ほし"],[10,1,"も"],[13,1,"くち"],[18,1,"するど"],[22,1,"は"],[30,1,"で"],[35,1,"かお"],[38,1,"つよ"],[40,1,"て"],[42,1,"かがや"],[44,2,"たいよう"]],"text":"その右手に七つの星を持ち、口からは、鋭いもろ刃のつるぎがつき出ており、顔は、強く照り輝く太陽のようであった。"},{"ref":"Rev.1.17","start":66001017,"end":66001017,"break":"paragraph","ruby":[[4,1,"かれ"],[6,1,"み"],[13,1,"あし"],[17,1,"たお"],[20,2,"しにん"],[34,1,"かれ"],[36,2,"みぎて"],[43,1,"うえ"],[48,1,"い"],[53,1,"おそ"],[62,1,"はじ"],[68,1,"おわ"]],"text":"わたしは彼を見たとき、その足もとに倒れて死人のようになった。すると、彼は右手をわたしの上において言った、「恐れるな。わたしは初めであり、終りであり、"},{"ref":"Rev.1.18","start":66001018,"end":66001018,"break":"none","ruby":[[3,1,"い"],[8,1,"もの"],[17,1,"し"],[27,1,"み"],[30,2,"よよ"],[32,1,"かぎ"],[36,1,"い"],[41,1,"もの"],[50,1,"し"],[52,2,"よみ"],[59,1,"も"]],"text":"また、生きている者である。わたしは死んだことはあるが、見よ、世々限りなく生きている者である。そして、死と黄泉とのかぎを持っている。"},{"ref":"Rev.1.19","start":66001019,"end":66001019,"break":"none","ruby":[[8,1,"み"],[13,2,"げんざい"],[19,2,"こんご"],[21,1,"おこ"],[31,1,"か"]],"text":"そこで、あなたの見たこと、現在のこと、今後起ろうとすることを、書きとめなさい。"},{"ref":"Rev.1.20","start":66001020,"end":66001020,"break":"none","ruby":[[8,2,"みぎて"],[11,1,"み"],[16,1,"ほし"],[22,1,"きん"],[24,2,"しょくだい"],[28,2,"おくぎ"],[46,1,"ほし"],[51,2,"きょうかい"],[54,2,"みつかい"],[63,2,"しょくだい"],[69,2,"きょうかい"]],"text":"あなたがわたしの右手に見た七つの星と、七つの金の燭台との奥義は、こうである。すなわち、七つの星は七つの教会の御使であり、七つの燭台は七つの教会である。"}]