[{"ref":"Job.8.1","start":18008001,"end":18008001,"break":"paragraph","ruby":[[0,1,"とき"],[12,1,"こた"],[15,1,"い"]],"text":"時にシュヒびとビルダデが答えて言った、"},{"ref":"Job.8.2","start":18008002,"end":18008002,"break":"stanza","breaks":[[22,"line"]],"ruby":[[15,1,"こと"],[17,1,"い"],[26,1,"くち"],[28,2,"ことば"],[31,1,"あら"],[33,1,"かぜ"]],"text":"「いつまであなたは、そのような事を言うのか。あなたの口の言葉は荒い風ではないか。"},{"ref":"Job.8.3","start":18008003,"end":18008003,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[2,2,"こうぎ"],[5,1,"ま"],[16,3,"ぜんのうしゃ"],[20,2,"せいぎ"],[23,1,"ま"]],"text":"神は公義を曲げられるであろうか。全能者は正義を曲げられるであろうか。"},{"ref":"Job.8.4","start":18008004,"end":18008004,"break":"line","breaks":[[18,"line"]],"ruby":[[4,1,"こ"],[8,1,"かれ"],[10,1,"つみ"],[12,1,"おか"],[18,1,"かれ"],[26,1,"て"],[28,1,"わた"]],"text":"あなたの子たちが彼に罪を犯したので、彼らをそのとがの手に渡されたのだ。"},{"ref":"Job.8.5","start":18008005,"end":18008005,"break":"line","ruby":[[6,1,"かみ"],[8,1,"もと"],[11,3,"ぜんのうしゃ"],[15,1,"いの"]],"text":"あなたがもし神に求め、全能者に祈るならば、"},{"ref":"Job.8.6","start":18008006,"end":18008006,"break":"line","breaks":[[18,"line"],[33,"line"]],"ruby":[[6,1,"きよ"],[9,1,"ただ"],[18,1,"かれ"],[20,1,"かなら"],[29,1,"た"],[37,1,"ただ"],[44,1,"さか"]],"text":"あなたがもし清く、正しくあるならば、彼は必ずあなたのために立って、あなたの正しいすみかを栄えさせられる。"},{"ref":"Job.8.7","start":18008007,"end":18008007,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"はじ"],[7,1,"ちい"],[19,1,"おわ"],[22,2,"ひじょう"],[25,1,"おお"]],"text":"あなたの初めは小さくあっても、あなたの終りは非常に大きくなるであろう。"},{"ref":"Job.8.8","start":18008008,"end":18008008,"break":"stanza","breaks":[[12,"line"]],"ruby":[[0,1,"さき"],[2,1,"よ"],[4,1,"ひと"],[6,1,"と"],[12,2,"せんぞ"],[17,1,"たず"],[23,1,"こと"],[25,1,"まな"]],"text":"先の代の人に問うてみよ、先祖たちの尋ねきわめた事を学べ。"},{"ref":"Job.8.9","start":18008009,"end":18008009,"break":"line","breaks":[[19,"line"],[26,"line"]],"ruby":[[16,1,"もの"],[19,1,"なに"],[21,1,"し"],[31,1,"よ"],[35,1,"ひ"],[38,1,"かげ"]],"text":"われわれはただ、きのうからあった者で、何も知らない、われわれの世にある日は、影のようなものである。"},{"ref":"Job.8.10","start":18008010,"end":18008010,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[7,1,"おし"],[14,1,"かた"],[19,1,"さと"],[23,2,"ことば"],[26,1,"だ"]],"text":"彼らはあなたに教え、あなたに語り、その悟りから言葉を出さないであろうか。"},{"ref":"Job.8.11","start":18008011,"end":18008011,"break":"stanza","breaks":[[22,"line"]],"ruby":[[0,1,"かみ"],[1,1,"ぐさ"],[3,1,"どろ"],[7,1,"ところ"],[9,2,"せいちょう"],[22,1,"あし"],[24,1,"みず"],[28,1,"ところ"],[32,1,"しげ"]],"text":"紙草は泥のない所に生長することができようか。葦は水のない所におい茂ることができようか。"},{"ref":"Job.8.12","start":18008012,"end":18008012,"break":"line","breaks":[[19,"line"]],"ruby":[[5,1,"あお"],[11,1,"か"],[23,1,"くさ"],[25,1,"さき"],[29,1,"か"]],"text":"これはなお青くて、まだ刈られないのに、すべての草に先だって枯れる。"},{"ref":"Job.8.13","start":18008013,"end":18008013,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"かみ"],[5,1,"わす"],[8,1,"もの"],[10,1,"みち"],[19,1,"かみ"],[21,1,"しん"],[25,1,"もの"],[27,1,"のぞ"],[30,1,"ほろ"]],"text":"すべて神を忘れる者の道はこのとおりだ。神を信じない者の望みは滅びる。"},{"ref":"Job.8.14","start":18008014,"end":18008014,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"たの"],[8,1,"た"],[14,1,"よ"],[24,1,"す"]],"text":"その頼むところは断たれ、その寄るところは、くもの巣のようだ。"},{"ref":"Job.8.15","start":18008015,"end":18008015,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"いえ"],[15,1,"いえ"],[17,1,"た"],[36,1,"た"]],"text":"その家によりかかろうとすれば、家は立たず、それにすがろうとしても、それは耐えない。"},{"ref":"Job.8.16","start":18008016,"end":18008016,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"かれ"],[2,1,"ひ"],[4,1,"まえ"],[6,2,"あおあお"],[9,1,"しげ"],[14,1,"わか"],[15,1,"えだ"],[17,1,"その"]],"text":"彼は日の前に青々と茂り、その若枝を園にはびこらせ、"},{"ref":"Job.8.17","start":18008017,"end":18008017,"break":"line","breaks":[[12,"line"]],"ruby":[[2,1,"ね"],[4,2,"いしづか"],[12,1,"いわ"],[14,1,"あいだ"],[16,1,"い"]],"text":"その根を石塚にからませ、岩の間に生きていても、"},{"ref":"Job.8.18","start":18008018,"end":18008018,"break":"line","breaks":[[15,"line"],[31,"line"]],"ruby":[[4,1,"ところ"],[7,1,"と"],[9,1,"のぞ"],[17,1,"ところ"],[19,1,"かれ"],[21,1,"こば"],[24,1,"い"],[40,1,"み"]],"text":"もしその所から取り除かれれば、その所は彼を拒んで言うであろう、『わたしはあなたを見たことがない』と。"},{"ref":"Job.8.19","start":18008019,"end":18008019,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"み"],[7,1,"かれ"],[9,1,"みち"],[11,1,"よろこ"],[23,1,"もの"],[25,1,"ち"],[28,1,"しょう"]],"text":"見よ、これこそ彼の道の喜びである、そしてほかの者が地から生じるであろう。"},{"ref":"Job.8.20","start":18008020,"end":18008020,"break":"stanza","breaks":[[16,"line"]],"ruby":[[0,1,"み"],[3,1,"かみ"],[5,1,"まった"],[7,1,"ひと"],[9,1,"す"],[18,1,"あく"],[20,1,"おこな"],[22,1,"もの"],[24,1,"て"],[26,2,"しじ"]],"text":"見よ、神は全き人を捨てられない。また悪を行う者の手を支持されない。"},{"ref":"Job.8.21","start":18008021,"end":18008021,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[2,1,"わら"],[12,1,"くち"],[14,1,"み"],[18,1,"よろこ"],[21,1,"こえ"],[35,1,"み"]],"text":"彼は笑いをもってあなたの口を満たし、喜びの声をもってあなたのくちびるを満たされる。"},{"ref":"Job.8.22","start":18008022,"end":18008022,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"にく"],[6,1,"もの"],[8,1,"はじ"],[10,1,"き"],[15,1,"あ"],[18,1,"もの"],[20,2,"てんまく"]],"text":"あなたを憎む者は恥を着せられ、悪しき者の天幕はなくなる」。"}]