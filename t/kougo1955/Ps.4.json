[{"ref":"Ps.4.1","start":19004001,"end":19004001,"break":"paragraph","title":"聖歌隊の指揮者によって琴にあわせてうたわせたダビデの歌","breaks":[[15,"line"],[33,"line"],[48,"line"],[66,"line"]],"ruby":[[4,1,"ぎ"],[6,1,"たす"],[8,1,"まも"],[12,1,"かみ"],[19,1,"よ"],[23,1,"とき"],[26,1,"こた"],[41,1,"なや"],[46,1,"とき"],[79,1,"いのり"],[82,1,"き"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[11,1,"こと"],[26,1,"うた"]],"text":"わたしの義を助け守られる神よ、わたしが呼ばわる時、お答えください。あなたはわたしが悩んでいた時、わたしをくつろがせてくださいました。わたしをあわれみ、わたしの祈をお聞きください。"},{"ref":"Ps.4.2","start":19004002,"end":19004002,"break":"line","breaks":[[25,"line"],[39,"line"]],"ruby":[[0,1,"ひと"],[2,1,"こ"],[14,1,"ほまれ"],[33,2,"ことば"],[36,1,"あい"],[39,1,"いつわ"],[42,1,"した"],[44,1,"もと"]],"text":"人の子らよ、いつまでわたしの誉をはずかしめるのか。いつまでむなしい言葉を愛し、偽りを慕い求めるのか。〔セラ"},{"ref":"Ps.4.3","start":19004003,"end":19004003,"break":"line","breaks":[[15,"line"],[39,"line"]],"ruby":[[9,1,"し"],[15,1,"しゅ"],[17,1,"かみ"],[19,1,"うやま"],[21,1,"ひと"],[24,2,"じぶん"],[30,2,"せいべつ"],[39,1,"しゅ"],[45,1,"よ"],[49,1,"とき"]],"text":"しかしあなたがたは知るがよい、主は神を敬う人をご自分のために聖別されたことを。主はわたしが呼ばわる時におききくださる。"},{"ref":"Ps.4.4","start":19004004,"end":19004004,"break":"line","breaks":[[22,"line"]],"ruby":[[6,1,"いか"],[11,1,"つみ"],[13,1,"おか"],[22,1,"とこ"],[24,1,"うえ"],[26,1,"しず"],[29,2,"じぶん"],[32,1,"こころ"],[34,1,"かた"]],"text":"あなたがたは怒っても、罪を犯してはならない。床の上で静かに自分の心に語りなさい。〔セラ"},{"ref":"Ps.4.5","start":19004005,"end":19004005,"break":"line","ruby":[[0,1,"ぎ"],[11,1,"しゅ"],[13,1,"よ"],[15,1,"たの"]],"text":"義のいけにえをささげて主に寄り頼みなさい。"},{"ref":"Ps.4.6","start":19004006,"end":19004006,"break":"line","breaks":[[8,"line"],[31,"line"],[43,"line"]],"ruby":[[0,1,"おお"],[3,1,"ひと"],[5,1,"い"],[19,1,"よ"],[21,1,"こと"],[23,1,"み"],[31,1,"しゅ"],[39,1,"かお"],[41,1,"ひかり"],[49,1,"うえ"],[51,1,"てら"]],"text":"多くの人は言う、「どうか、わたしたちに良い事が見られるように。主よ、どうか、み顔の光をわたしたちの上に照されるように」と。"},{"ref":"Ps.4.7","start":19004007,"end":19004007,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[8,1,"こころ"],[11,1,"あた"],[17,1,"よろこ"],[21,2,"こくもつ"],[28,1,"しゅ"],[30,1,"ゆた"],[33,1,"とき"],[35,1,"よろこ"]],"text":"あなたがわたしの心にお与えになった喜びは、穀物と、ぶどう酒の豊かな時の喜びにまさるものでした。"},{"ref":"Ps.4.8","start":19004008,"end":19004008,"break":"line","breaks":[[18,"line"],[40,"line"]],"ruby":[[4,1,"やす"],[8,1,"ふ"],[13,1,"ねむ"],[18,1,"しゅ"],[25,1,"やす"]],"text":"わたしは安らかに伏し、また眠ります。主よ、わたしを安らかにおらせてくださるのは、ただあなただけです。"}]