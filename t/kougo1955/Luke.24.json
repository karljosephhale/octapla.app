[{"ref":"Luke.24.1","start":42024001,"end":42024001,"break":"paragraph","ruby":[[0,1,"しゅう"],[2,1,"はじ"],[5,1,"ひ"],[7,2,"よあ"],[10,1,"まえ"],[13,1,"おんな"],[17,2,"ようい"],[24,2,"こうりょう"],[27,1,"たずさ"],[31,1,"はか"],[33,1,"い"]],"text":"週の初めの日、夜明け前に、女たちは用意しておいた香料を携えて、墓に行った。"},{"ref":"Luke.24.2","start":42024002,"end":42024002,"break":"none","ruby":[[5,1,"いし"],[7,1,"はか"]],"text":"ところが、石が墓からころがしてあるので、"},{"ref":"Luke.24.3","start":42024003,"end":42024003,"break":"none","ruby":[[0,1,"なか"],[10,1,"しゅ"],[19,2,"みあた"]],"text":"中にはいってみると、主イエスのからだが見当らなかった。"},{"ref":"Luke.24.4","start":42024004,"end":42024004,"break":"none","ruby":[[4,2,"とほう"],[14,1,"み"],[17,1,"かがや"],[20,1,"ころも"],[22,1,"き"],[28,1,"もの"],[31,1,"かれ"],[34,1,"あらわ"]],"text":"そのため途方にくれていると、見よ、輝いた衣を着たふたりの者が、彼らに現れた。"},{"ref":"Luke.24.5","start":42024005,"end":42024005,"break":"none","ruby":[[0,1,"おんな"],[4,1,"おどろ"],[6,1,"おそ"],[10,1,"かお"],[12,1,"ち"],[14,1,"ふ"],[27,1,"もの"],[29,1,"い"],[43,1,"い"],[46,1,"ほう"],[48,2,"しにん"],[51,1,"なか"]],"text":"女たちは驚き恐れて、顔を地に伏せていると、このふたりの者が言った、「あなたがたは、なぜ生きた方を死人の中にたずねているのか。"},{"ref":"Luke.24.6","start":42024006,"end":42024006,"break":"none","ruby":[[47,1,"はな"],[56,1,"おも"],[58,1,"だ"]],"text":"そのかたは、ここにはおられない。よみがえられたのだ。まだガリラヤにおられたとき、あなたがたにお話しになったことを思い出しなさい。"},{"ref":"Luke.24.7","start":42024007,"end":42024007,"break":"none","ruby":[[5,1,"ひと"],[7,1,"こ"],[9,1,"かなら"],[11,2,"つみびと"],[15,1,"て"],[17,1,"わた"],[21,3,"じゅうじか"],[34,1,"か"],[35,1,"め"],[44,1,"おお"]],"text":"すなわち、人の子は必ず罪人らの手に渡され、十字架につけられ、そして三日目によみがえる、と仰せられたではないか」。"},{"ref":"Luke.24.8","start":42024008,"end":42024008,"break":"none","ruby":[[3,1,"おんな"],[9,2,"ことば"],[12,1,"おも"],[14,1,"だ"]],"text":"そこで女たちはその言葉を思い出し、"},{"ref":"Luke.24.9","start":42024009,"end":42024009,"break":"none","ruby":[[0,1,"はか"],[3,1,"かえ"],[21,2,"でし"],[27,1,"た"],[32,1,"ひと"],[34,2,"ほうこく"]],"text":"墓から帰って、これらいっさいのことを、十一弟子や、その他みんなの人に報告した。"},{"ref":"Luke.24.10","start":42024010,"end":42024010,"break":"none","ruby":[[2,1,"おんな"],[32,1,"はは"],[41,2,"かのじょ"],[46,2,"いっしょ"],[54,1,"おんな"],[64,2,"しと"],[69,1,"はな"]],"text":"この女たちというのは、マグダラのマリヤ、ヨハンナ、およびヤコブの母マリヤであった。彼女たちと一緒にいたほかの女たちも、このことを使徒たちに話した。"},{"ref":"Luke.24.11","start":42024011,"end":42024011,"break":"none","ruby":[[5,2,"しと"],[15,1,"おろ"],[18,1,"はなし"],[23,1,"おも"],[31,1,"しん"]],"text":"ところが、使徒たちには、それが愚かな話のように思われて、それを信じなかった。〔"},{"ref":"Luke.24.12","start":42024012,"end":42024012,"break":"none","ruby":[[4,1,"た"],[7,1,"はか"],[9,1,"はし"],[12,1,"い"],[19,1,"なか"],[21,1,"み"],[25,3,"あまぬの"],[40,1,"こと"],[42,2,"しだい"],[45,3,"ふしぎ"],[49,1,"おも"],[54,1,"かえ"],[57,1,"い"]],"text":"ペテロは立って墓へ走って行き、かがんで中を見ると、亜麻布だけがそこにあったので、事の次第を不思議に思いながら帰って行った。〕"},{"ref":"Luke.24.13","start":42024013,"end":42024013,"break":"paragraph","ruby":[[2,1,"ひ"],[8,2,"でし"],[26,1,"はな"],[35,1,"むら"],[37,1,"い"]],"text":"この日、ふたりの弟子が、エルサレムから七マイルばかり離れたエマオという村へ行きながら、"},{"ref":"Luke.24.14","start":42024014,"end":42024014,"break":"none","ruby":[[7,3,"できごと"],[14,1,"たがい"],[16,1,"かた"],[18,1,"あ"]],"text":"このいっさいの出来事について互に語り合っていた。"},{"ref":"Luke.24.15","start":42024015,"end":42024015,"break":"none","ruby":[[0,1,"かた"],[2,1,"あ"],[4,1,"ろん"],[6,1,"あ"],[17,2,"じしん"],[20,1,"ちか"],[27,1,"かれ"],[30,2,"いっしょ"],[33,1,"ある"],[36,1,"い"]],"text":"語り合い論じ合っていると、イエスご自身が近づいてきて、彼らと一緒に歩いて行かれた。"},{"ref":"Luke.24.16","start":42024016,"end":42024016,"break":"none","ruby":[[4,1,"かれ"],[7,1,"め"],[20,1,"みと"]],"text":"しかし、彼らの目がさえぎられて、イエスを認めることができなかった。"},{"ref":"Luke.24.17","start":42024017,"end":42024017,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[13,1,"ある"],[18,1,"たがい"],[20,1,"かた"],[22,1,"あ"],[29,1,"はなし"],[42,1,"かれ"],[45,1,"かな"],[50,1,"かお"],[54,1,"た"]],"text":"イエスは彼らに言われた、「歩きながら互に語り合っているその話は、なんのことなのか」。彼らは悲しそうな顔をして立ちどまった。"},{"ref":"Luke.24.18","start":42024018,"end":42024018,"break":"none","ruby":[[13,1,"もの"],[16,1,"こた"],[19,1,"い"],[34,1,"と"],[52,1,"みやこ"],[58,1,"おこ"],[65,1,"ぞん"]],"text":"そのひとりのクレオパという者が、答えて言った、「あなたはエルサレムに泊まっていながら、あなただけが、この都でこのごろ起ったことをご存じないのですか」。"},{"ref":"Luke.24.19","start":42024019,"end":42024019,"break":"none","ruby":[[13,1,"い"],[19,1,"かれ"],[22,1,"い"],[46,1,"かみ"],[52,2,"みんしゅう"],[56,1,"まえ"],[63,2,"ことば"],[67,1,"ちから"],[70,3,"よげんしゃ"]],"text":"「それは、どんなことか」と言われると、彼らは言った、「ナザレのイエスのことです。あのかたは、神とすべての民衆との前で、わざにも言葉にも力ある預言者でしたが、"},{"ref":"Luke.24.20","start":42024020,"end":42024020,"break":"none","ruby":[[0,3,"さいしちょう"],[6,2,"やくにん"],[12,2,"しけい"],[15,1,"しょ"],[21,1,"ひ"],[23,1,"わた"],[26,3,"じゅうじか"]],"text":"祭司長たちや役人たちが、死刑に処するために引き渡し、十字架につけたのです。"},{"ref":"Luke.24.21","start":42024021,"end":42024021,"break":"none","ruby":[[13,1,"すく"],[19,1,"ひと"],[26,1,"のぞ"],[42,1,"うえ"],[47,1,"こと"],[49,1,"おこ"],[60,1,"か"],[61,1,"め"]],"text":"わたしたちは、イスラエルを救うのはこの人であろうと、望みをかけていました。しかもその上に、この事が起ってから、きょうが三日目なのです。"},{"ref":"Luke.24.22","start":42024022,"end":42024022,"break":"none","ruby":[[11,2,"なかま"],[16,2,"すうにん"],[19,1,"おんな"],[28,1,"おどろ"],[41,1,"かれ"],[44,1,"あさ"],[45,1,"はや"],[47,1,"はか"],[49,1,"い"]],"text":"ところが、わたしたちの仲間である数人の女が、わたしたちを驚かせました。というのは、彼らが朝早く墓に行きますと、"},{"ref":"Luke.24.23","start":42024023,"end":42024023,"break":"none","ruby":[[8,2,"みあた"],[16,1,"かえ"],[29,2,"みつかい"],[32,1,"あらわ"],[41,1,"い"],[50,1,"つ"],[54,1,"もう"]],"text":"イエスのからだが見当らないので、帰ってきましたが、そのとき御使が現れて、『イエスは生きておられる』と告げたと申すのです。"},{"ref":"Luke.24.24","start":42024024,"end":42024024,"break":"none","ruby":[[10,2,"なかま"],[13,2,"すうにん"],[16,1,"はか"],[18,1,"い"],[21,1,"み"],[26,1,"はた"],[29,1,"おんな"],[33,1,"い"],[45,2,"みあた"]],"text":"それで、わたしたちの仲間が数人、墓に行って見ますと、果して女たちが言ったとおりで、イエスは見当りませんでした」。"},{"ref":"Luke.24.25","start":42024025,"end":42024025,"break":"none","ruby":[[7,1,"い"],[16,1,"おろ"],[19,1,"こころ"],[27,3,"よげんしゃ"],[33,1,"と"],[40,1,"こと"],[42,1,"しん"],[48,1,"もの"]],"text":"そこでイエスが言われた、「ああ、愚かで心のにぶいため、預言者たちが説いたすべての事を信じられない者たちよ。"},{"ref":"Luke.24.26","start":42024026,"end":42024026,"break":"none","ruby":[[5,1,"かなら"],[12,2,"くなん"],[15,1,"う"],[21,2,"えいこう"],[24,1,"はい"]],"text":"キリストは必ず、これらの苦難を受けて、その栄光に入るはずではなかったのか」。"},{"ref":"Luke.24.27","start":42024027,"end":42024027,"break":"none","ruby":[[2,1,"い"],[14,3,"よげんしゃ"],[24,2,"せいしょ"],[26,2,"ぜんたい"],[34,2,"じしん"],[46,1,"こと"],[51,1,"と"]],"text":"こう言って、モーセやすべての預言者からはじめて、聖書全体にわたり、ご自身についてしるしてある事どもを、説きあかされた。"},{"ref":"Luke.24.28","start":42024028,"end":42024028,"break":"none","ruby":[[5,1,"かれ"],[8,1,"い"],[16,1,"むら"],[18,1,"ちか"],[30,1,"さき"],[32,1,"すす"],[34,1,"い"],[38,2,"ようす"]],"text":"それから、彼らは行こうとしていた村に近づいたが、イエスがなお先へ進み行かれる様子であった。"},{"ref":"Luke.24.29","start":42024029,"end":42024029,"break":"none","ruby":[[7,1,"ひ"],[9,1,"と"],[12,1,"い"],[23,2,"いっしょ"],[27,1,"と"],[30,1,"くだ"],[36,2,"ゆうぐれ"],[45,1,"ひ"],[49,1,"かたむ"],[62,1,"かれ"],[65,1,"とも"],[67,1,"と"],[74,1,"いえ"]],"text":"そこで、しいて引き止めて言った、「わたしたちと一緒にお泊まり下さい。もう夕暮になっており、日もはや傾いています」。イエスは、彼らと共に泊まるために、家にはいられた。"},{"ref":"Luke.24.30","start":42024030,"end":42024030,"break":"none","ruby":[[0,2,"いっしょ"],[3,2,"しょくたく"],[16,1,"と"],[19,2,"しゅくふく"],[26,1,"かれ"],[29,1,"わた"]],"text":"一緒に食卓につかれたとき、パンを取り、祝福してさき、彼らに渡しておられるうちに、"},{"ref":"Luke.24.31","start":42024031,"end":42024031,"break":"none","ruby":[[0,1,"かれ"],[3,1,"め"],[5,1,"ひら"],[31,1,"すがた"],[33,1,"み"]],"text":"彼らの目が開けて、それがイエスであることがわかった。すると、み姿が見えなくなった。"},{"ref":"Luke.24.32","start":42024032,"end":42024032,"break":"none","ruby":[[0,1,"かれ"],[3,1,"たがい"],[5,1,"い"],[10,2,"みちみち"],[13,1,"はな"],[24,2,"せいしょ"],[27,1,"と"],[29,1,"めい"],[41,1,"たがい"],[43,1,"こころ"],[45,1,"うち"],[47,1,"も"]],"text":"彼らは互に言った、「道々お話しになったとき、また聖書を説き明してくださったとき、お互の心が内に燃えたではないか」。"},{"ref":"Luke.24.33","start":42024033,"end":42024033,"break":"none","ruby":[[7,1,"た"],[16,1,"かえ"],[19,1,"み"],[25,2,"でし"],[30,2,"なかま"],[33,1,"あつ"]],"text":"そして、すぐに立ってエルサレムに帰って見ると、十一弟子とその仲間が集まっていて、"},{"ref":"Luke.24.34","start":42024034,"end":42024034,"break":"none","ruby":[[1,1,"しゅ"],[20,1,"あらわ"],[28,1,"い"]],"text":"「主は、ほんとうによみがえって、シモンに現れなさった」と言っていた。"},{"ref":"Luke.24.35","start":42024035,"end":42024035,"break":"none","ruby":[[7,1,"もの"],[10,2,"とちゅう"],[29,2,"ようす"],[46,1,"はな"]],"text":"そこでふたりの者は、途中であったことや、パンをおさきになる様子でイエスだとわかったことなどを話した。"},{"ref":"Luke.24.36","start":42024036,"end":42024036,"break":"none","ruby":[[2,1,"はな"],[13,1,"かれ"],[16,1,"なか"],[19,1,"た"],[37,1,"い"]],"text":"こう話していると、イエスが彼らの中にお立ちになった。〔そして「やすかれ」と言われた。〕"},{"ref":"Luke.24.37","start":42024037,"end":42024037,"break":"none","ruby":[[0,1,"かれ"],[3,1,"おそ"],[5,1,"おどろ"],[9,1,"れい"],[11,1,"み"],[18,1,"おも"]],"text":"彼らは恐れ驚いて、霊を見ているのだと思った。"},{"ref":"Luke.24.38","start":42024038,"end":42024038,"break":"none","ruby":[[7,1,"い"],[17,1,"まど"],[29,1,"こころ"],[31,1,"うたが"],[34,1,"おこ"]],"text":"そこでイエスが言われた、「なぜおじ惑っているのか。どうして心に疑いを起すのか。"},{"ref":"Luke.24.39","start":42024039,"end":42024039,"break":"none","ruby":[[4,1,"て"],[6,1,"あし"],[8,1,"み"],[28,1,"み"],[33,1,"れい"],[36,1,"にく"],[38,1,"ほね"],[50,1,"み"]],"text":"わたしの手や足を見なさい。まさしくわたしなのだ。さわって見なさい。霊には肉や骨はないが、あなたがたが見るとおり、わたしにはあるのだ」。〔"},{"ref":"Luke.24.40","start":42024040,"end":42024040,"break":"none","ruby":[[2,1,"い"],[6,1,"て"],[8,1,"あし"],[12,1,"み"]],"text":"こう言って、手と足とをお見せになった。〕"},{"ref":"Luke.24.41","start":42024041,"end":42024041,"break":"none","ruby":[[0,1,"かれ"],[3,1,"よろこ"],[12,1,"しん"],[19,3,"ふしぎ"],[23,1,"おも"],[38,1,"なに"],[40,2,"しょくもつ"],[48,1,"い"]],"text":"彼らは喜びのあまり、まだ信じられないで不思議に思っていると、イエスが「ここに何か食物があるか」と言われた。"},{"ref":"Luke.24.42","start":42024042,"end":42024042,"break":"none","ruby":[[0,1,"かれ"],[3,1,"や"],[6,1,"うお"]],"text":"彼らが焼いた魚の一きれをさしあげると、"},{"ref":"Luke.24.43","start":42024043,"end":42024043,"break":"none","ruby":[[7,1,"と"],[15,1,"まえ"],[17,1,"た"]],"text":"イエスはそれを取って、みんなの前で食べられた。"},{"ref":"Luke.24.44","start":42024044,"end":42024044,"break":"paragraph","ruby":[[4,1,"かれ"],[7,1,"たい"],[10,1,"い"],[20,2,"いぜん"],[28,2,"いっしょ"],[33,2,"じぶん"],[36,1,"はな"],[39,1,"き"],[43,2,"ことば"],[63,2,"りっぽう"],[66,2,"よげん"],[68,1,"しょ"],[70,2,"しへん"],[82,1,"か"],[91,1,"かなら"],[98,2,"じょうじゅ"]],"text":"それから彼らに対して言われた、「わたしが以前あなたがたと一緒にいた時分に話して聞かせた言葉は、こうであった。すなわち、モーセの律法と預言書と詩篇とに、わたしについて書いてあることは、必ずことごとく成就する」。"},{"ref":"Luke.24.45","start":42024045,"end":42024045,"break":"none","ruby":[[8,2,"せいしょ"],[11,1,"さと"],[18,1,"かれ"],[21,1,"こころ"],[23,1,"ひら"]],"text":"そこでイエスは、聖書を悟らせるために彼らの心を開いて"},{"ref":"Luke.24.46","start":42024046,"end":42024046,"break":"none","ruby":[[0,1,"い"],[21,1,"くる"],[25,1,"う"],[30,1,"か"],[31,1,"め"],[33,2,"しにん"],[36,1,"なか"]],"text":"言われた、「こう、しるしてある。キリストは苦しみを受けて、三日目に死人の中からよみがえる。"},{"ref":"Luke.24.47","start":42024047,"end":42024047,"break":"none","ruby":[[6,1,"な"],[11,1,"つみ"],[17,1,"え"],[21,2,"くいあらた"],[44,2,"こくみん"],[47,1,"の"],[49,1,"つた"]],"text":"そして、その名によって罪のゆるしを得させる悔改めが、エルサレムからはじまって、もろもろの国民に宣べ伝えられる。"},{"ref":"Luke.24.48","start":42024048,"end":42024048,"break":"none","ruby":[[11,1,"こと"],[13,2,"しょうにん"]],"text":"あなたがたは、これらの事の証人である。"},{"ref":"Luke.24.49","start":42024049,"end":42024049,"break":"none","ruby":[[0,1,"み"],[7,1,"ちち"],[9,2,"やくそく"],[24,1,"おく"],[31,1,"うえ"],[34,1,"ちから"],[36,1,"さづ"],[51,1,"みやこ"]],"text":"見よ、わたしの父が約束されたものを、あなたがたに贈る。だから、上から力を授けられるまでは、あなたがたは都にとどまっていなさい」。"},{"ref":"Luke.24.50","start":42024050,"end":42024050,"break":"paragraph","ruby":[[9,1,"かれ"],[17,1,"ちか"],[21,1,"つ"],[24,1,"い"],[27,1,"て"],[32,1,"かれ"],[35,2,"しゅくふく"]],"text":"それから、イエスは彼らをベタニヤの近くまで連れて行き、手をあげて彼らを祝福された。"},{"ref":"Luke.24.51","start":42024051,"end":42024051,"break":"none","ruby":[[0,2,"しゅくふく"],[12,1,"かれ"],[15,1,"はな"],[20,1,"てん"]],"text":"祝福しておられるうちに、彼らを離れて、〔天にあげられた。〕"},{"ref":"Luke.24.52","start":42024052,"end":42024052,"break":"none","ruby":[[0,1,"かれ"],[8,1,"はい"],[12,2,"ひじょう"],[15,1,"よろこ"],[27,1,"かえ"]],"text":"彼らは〔イエスを拝し、〕非常な喜びをもってエルサレムに帰り、"},{"ref":"Luke.24.53","start":42024053,"end":42024053,"break":"none","ruby":[[0,1,"た"],[3,1,"みや"],[8,1,"かみ"]],"text":"絶えず宮にいて、神をほめたたえていた。"}]