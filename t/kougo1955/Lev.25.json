[{"ref":"Lev.25.1","start":3025001,"end":3025001,"break":"paragraph","ruby":[[0,1,"しゅ"],[5,1,"さん"],[12,1,"い"]],"text":"主はシナイ山で、モーセに言われた、"},{"ref":"Lev.25.2","start":3025002,"end":3025002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[21,1,"あた"],[24,1,"ち"],[43,1,"ち"],[47,1,"しゅ"],[49,1,"む"],[53,2,"あんそく"],[56,1,"まも"]],"text":"「イスラエルの人々に言いなさい、『わたしが与える地に、あなたがたがはいったときは、その地にも、主に向かって安息を守らせなければならない。"},{"ref":"Lev.25.3","start":3025003,"end":3025003,"break":"none","ruby":[[1,1,"ねん"],[3,1,"あいだ"],[8,1,"はたけ"],[10,1,"たね"],[18,1,"ねん"],[20,1,"あいだ"],[24,1,"はたけ"],[26,1,"えだ"],[28,1,"か"],[30,1,"こ"],[35,1,"み"],[37,1,"あつ"]],"text":"六年の間あなたは畑に種をまき、また六年の間ぶどう畑の枝を刈り込み、その実を集めることができる。"},{"ref":"Lev.25.4","start":3025004,"end":3025004,"break":"none","ruby":[[5,1,"ねん"],[6,1,"め"],[10,1,"ち"],[12,1,"まった"],[14,1,"やす"],[17,2,"あんそく"],[20,1,"あた"],[35,1,"しゅ"],[37,1,"む"],[41,1,"まも"],[43,2,"あんそく"],[53,1,"はたけ"],[55,1,"たね"],[72,1,"はたけ"],[74,1,"えだ"],[76,1,"か"],[78,1,"こ"]],"text":"しかし、七年目には、地に全き休みの安息を与えなければならない。これは、主に向かって守る安息である。あなたは畑に種をまいてはならない。また、ぶどう畑の枝を刈り込んではならない。"},{"ref":"Lev.25.5","start":3025005,"end":3025005,"break":"none","ruby":[[4,2,"こくもつ"],[7,2,"しぜん"],[10,1,"は"],[16,1,"か"],[18,1,"と"],[38,1,"えだ"],[40,2,"てい"],[48,1,"むす"],[51,1,"み"],[53,1,"つ"],[65,1,"ち"],[70,1,"まった"],[72,1,"やす"],[75,1,"とし"]],"text":"あなたの穀物の自然に生えたものは刈り取ってはならない。また、あなたのぶどうの枝の手入れをしないで結んだ実は摘んではならない。これは地のために全き休みの年だからである。"},{"ref":"Lev.25.6","start":3025006,"end":3025006,"break":"none","ruby":[[0,2,"あんそく"],[3,1,"とし"],[5,1,"ち"],[7,2,"さんぶつ"],[17,2,"しょくもつ"],[37,2,"だんじょ"],[40,2,"どれい"],[44,2,"やといにん"],[52,1,"ところ"],[54,1,"やど"],[59,2,"たこく"],[61,1,"じん"]],"text":"安息の年の地の産物は、あなたがたの食物となるであろう。すなわち、あなたと、男女の奴隷と、雇人と、あなたの所に宿っている他国人と、"},{"ref":"Lev.25.7","start":3025007,"end":3025007,"break":"none","ruby":[[4,2,"かちく"],[12,1,"くに"],[17,1,"けもの"],[26,2,"さんぶつ"],[32,2,"しょくもつ"]],"text":"あなたの家畜と、あなたの国のうちの獣とのために、その産物はみな、食物となるであろう。"},{"ref":"Lev.25.8","start":3025008,"end":3025008,"break":"paragraph","ruby":[[4,2,"あんそく"],[7,1,"とし"],[19,1,"ねん"],[22,1,"かい"],[23,1,"かぞ"],[34,2,"あんそく"],[37,1,"とし"],[42,2,"ねんすう"],[48,1,"ねん"]],"text":"あなたは安息の年を七たび、すなわち、七年を七回数えなければならない。安息の年七たびの年数は四十九年である。"},{"ref":"Lev.25.9","start":3025009,"end":3025009,"break":"none","ruby":[[1,1,"がつ"],[4,1,"か"],[14,1,"おと"],[16,1,"ひび"],[18,1,"わた"],[35,2,"しょくざい"],[38,1,"ひ"],[46,2,"ぜんこく"],[53,1,"ひび"],[55,1,"わた"]],"text":"七月の十日にあなたはラッパの音を響き渡らせなければならない。すなわち、贖罪の日にあなたがたは全国にラッパを響き渡らせなければならない。"},{"ref":"Lev.25.10","start":3025010,"end":3025010,"break":"none","ruby":[[4,1,"ねん"],[5,1,"め"],[7,2,"せいべつ"],[12,2,"くにぢゅう"],[19,2,"じゅうみん"],[22,2,"じゆう"],[27,1,"しめ"],[40,1,"とし"],[53,1,"とし"],[72,2,"しょゆう"],[75,1,"ち"],[77,1,"かえ"],[86,2,"かぞく"],[89,1,"かえ"]],"text":"その五十年目を聖別して、国中のすべての住民に自由をふれ示さなければならない。この年はあなたがたにはヨベルの年であって、あなたがたは、おのおのその所有の地に帰り、おのおのその家族に帰らなければならない。"},{"ref":"Lev.25.11","start":3025011,"end":3025011,"break":"none","ruby":[[4,1,"ねん"],[5,1,"め"],[18,1,"とし"],[23,1,"たね"],[36,2,"しぜん"],[39,1,"は"],[45,1,"か"],[47,1,"と"],[56,2,"てい"],[64,1,"むす"],[71,1,"み"],[73,1,"つ"]],"text":"その五十年目はあなたがたにはヨベルの年である。種をまいてはならない。また自然に生えたものは刈り取ってはならない。手入れをしないで結んだぶどうの実は摘んではならない。"},{"ref":"Lev.25.12","start":3025012,"end":3025012,"break":"none","ruby":[[2,1,"とし"],[8,1,"とし"],[20,1,"せい"],[36,1,"はたけ"],[38,2,"しぜん"],[44,1,"もの"],[46,1,"た"]],"text":"この年はヨベルの年であって、あなたがたに聖であるからである。あなたがたは畑に自然にできた物を食べなければならない。"},{"ref":"Lev.25.13","start":3025013,"end":3025013,"break":"paragraph","ruby":[[6,1,"とし"],[16,2,"しょゆう"],[19,1,"ち"],[21,1,"かえ"]],"text":"このヨベルの年には、おのおのその所有の地に帰らなければならない。"},{"ref":"Lev.25.14","start":3025014,"end":3025014,"break":"none","ruby":[[4,2,"りんじん"],[7,1,"もの"],[9,1,"う"],[14,2,"りんじん"],[18,1,"もの"],[20,1,"か"],[26,1,"たがい"],[28,1,"あざむ"]],"text":"あなたの隣人に物を売り、また隣人から物を買うときは、互に欺いてはならない。"},{"ref":"Lev.25.15","start":3025015,"end":3025015,"break":"none","ruby":[[4,1,"のち"],[6,1,"とし"],[8,1,"かず"],[20,2,"りんじん"],[24,1,"か"],[27,1,"かれ"],[31,1,"はたけ"],[33,2,"さんぶつ"],[36,2,"ねんすう"],[49,1,"う"]],"text":"ヨベルの後の年の数にしたがって、あなたは隣人から買い、彼もまた畑の産物の年数にしたがって、あなたに売らなければならない。"},{"ref":"Lev.25.16","start":3025016,"end":3025016,"break":"none","ruby":[[0,1,"とし"],[2,1,"かず"],[4,1,"おお"],[6,1,"とき"],[11,1,"あたい"],[13,1,"ま"],[16,1,"とし"],[18,1,"かず"],[20,1,"すく"],[23,1,"とき"],[26,1,"あたい"],[28,1,"へ"],[40,1,"かれ"],[46,1,"う"],[50,2,"さんぶつ"],[53,1,"かず"]],"text":"年の数の多い時は、その値を増し、年の数の少ない時は、値を減らさなければならない。彼があなたに売るのは産物の数だからである。"},{"ref":"Lev.25.17","start":3025017,"end":3025017,"break":"none","ruby":[[6,1,"たがい"],[8,1,"あざむ"],[21,1,"かみ"],[23,1,"おそ"],[44,1,"かみ"],[46,1,"しゅ"]],"text":"あなたがたは互に欺いてはならない。あなたの神を恐れなければならない。わたしはあなたがたの神、主である。"},{"ref":"Lev.25.18","start":3025018,"end":3025018,"break":"paragraph","ruby":[[10,1,"さだ"],[13,1,"おこな"],[26,1,"まも"],[33,1,"おこな"],[56,1,"やす"],[62,1,"ち"],[64,1,"す"]],"text":"あなたがたはわたしの定めを行い、またわたしのおきてを守って、これを行わなければならない。そうすれば、あなたがたは安らかにその地に住むことができるであろう。"},{"ref":"Lev.25.19","start":3025019,"end":3025019,"break":"none","ruby":[[0,1,"ち"],[4,1,"み"],[6,1,"むす"],[15,1,"あ"],[23,1,"た"],[26,1,"やす"],[33,1,"す"]],"text":"地はその実を結び、あなたがたは飽きるまでそれを食べ、安らかにそこに住むことができるであろう。"},{"ref":"Lev.25.20","start":3025020,"end":3025020,"break":"none","ruby":[[2,1,"ねん"],[3,1,"め"],[5,1,"たね"],[18,2,"さんぶつ"],[21,1,"あつ"],[41,1,"なに"],[43,1,"た"],[56,1,"い"]],"text":"「七年目に種をまくことができず、また産物を集めることができないならば、わたしたちは何を食べようか」とあなたがたは言うのか。"},{"ref":"Lev.25.21","start":3025021,"end":3025021,"break":"none","ruby":[[4,1,"めい"],[8,1,"ねん"],[9,1,"め"],[18,2,"しゅくふく"],[27,1,"ねん"],[28,1,"ぶん"],[30,2,"さんぶつ"],[33,1,"みの"]],"text":"わたしは命じて六年目に、あなたがたに祝福をくだし、三か年分の産物を実らせるであろう。"},{"ref":"Lev.25.22","start":3025022,"end":3025022,"break":"none","ruby":[[7,1,"ねん"],[8,1,"め"],[10,1,"たね"],[14,1,"とき"],[20,1,"ふる"],[22,2,"さんぶつ"],[25,1,"た"],[36,1,"ねん"],[37,1,"め"],[41,2,"さんぶつ"],[56,1,"ふる"],[61,1,"た"]],"text":"あなたがたは八年目に種をまく時には、なお古い産物を食べているであろう。九年目にその産物のできるまで、あなたがたは古いものを食べることができるであろう。"},{"ref":"Lev.25.23","start":3025023,"end":3025023,"break":"none","ruby":[[0,1,"ち"],[2,2,"えいたい"],[6,1,"う"],[15,1,"ち"],[40,1,"とも"],[44,3,"きりゅうしゃ"],[50,1,"たび"]],"text":"地は永代には売ってはならない。地はわたしのものだからである。あなたがたはわたしと共にいる寄留者、また旅びとである。"},{"ref":"Lev.25.24","start":3025024,"end":3025024,"break":"none","ruby":[[6,2,"しょゆう"],[16,2,"とち"],[23,2,"とち"],[26,1,"か"],[32,1,"おう"]],"text":"あなたがたの所有としたどのような土地でも、その土地の買いもどしに応じなければならない。"},{"ref":"Lev.25.25","start":3025025,"end":3025025,"break":"paragraph","ruby":[[4,2,"きょうだい"],[7,1,"お"],[14,2,"しょゆう"],[17,1,"ち"],[19,1,"う"],[22,1,"とき"],[25,1,"かれ"],[27,2,"きんしん"],[29,1,"しゃ"],[34,2,"きょうだい"],[37,1,"う"],[43,1,"か"]],"text":"あなたの兄弟が落ちぶれてその所有の地を売った時は、彼の近親者がきて、兄弟の売ったものを買いもどさなければならない。"},{"ref":"Lev.25.26","start":3025026,"end":3025026,"break":"none","ruby":[[5,1,"ひと"],[11,1,"か"],[20,1,"ひと"],[30,1,"ひと"],[32,1,"と"],[35,2,"じぶん"],[41,1,"か"]],"text":"たといその人に、それを買いもどしてくれる人がいなくても、その人が富み、自分でそれを買いもどすことができるようになったならば、"},{"ref":"Lev.25.27","start":3025027,"end":3025027,"break":"none","ruby":[[3,1,"う"],[9,1,"とし"],[11,1,"かぞ"],[14,1,"のこ"],[17,1,"ぶん"],[19,1,"か"],[21,1,"て"],[23,1,"かえ"],[41,1,"ひと"],[45,2,"しょゆう"],[48,1,"ち"],[50,1,"かえ"]],"text":"それを売ってからの年を数えて残りの分を買い手に返さなければならない。そうすればその人はその所有の地に帰ることができる。"},{"ref":"Lev.25.28","start":3025028,"end":3025028,"break":"none","ruby":[[9,1,"か"],[27,1,"う"],[30,1,"もの"],[36,1,"とし"],[39,1,"か"],[41,1,"ぬし"],[43,1,"て"],[61,1,"ひと"],[65,2,"しょゆう"],[68,1,"ち"],[70,1,"かえ"]],"text":"しかし、もしそれを買いもどすことができないならば、その売った物はヨベルの年まで買い主の手にあり、ヨベルにはもどされて、その人はその所有の地に帰ることができるであろう。"},{"ref":"Lev.25.29","start":3025029,"end":3025029,"break":"paragraph","ruby":[[0,1,"ひと"],[2,2,"じょうへき"],[7,1,"まち"],[9,2,"じゅうたく"],[12,1,"う"],[15,1,"とき"],[18,1,"う"],[23,1,"まん"],[25,1,"ねん"],[27,1,"あいだ"],[33,1,"か"],[47,1,"かん"],[49,1,"かれ"],[51,1,"か"],[59,1,"ゆる"]],"text":"人が城壁のある町の住宅を売った時は、売ってから満一年の間は、それを買いもどすことができる。その間は彼に買いもどすことを許さなければならない。"},{"ref":"Lev.25.30","start":3025030,"end":3025030,"break":"none","ruby":[[0,1,"まん"],[2,1,"ねん"],[11,1,"か"],[18,1,"とき"],[21,2,"じょうへき"],[26,1,"まち"],[28,1,"うち"],[32,1,"いえ"],[34,2,"えいたい"],[40,1,"か"],[43,1,"ひと"],[48,1,"さだ"],[53,2,"よよ"],[56,2,"しょゆう"],[66,1,"とし"]],"text":"満一年のうちに、それを買いもどさない時は、城壁のある町の内のその家は永代にそれを買った人のものと定まって、代々の所有となり、ヨベルの年にももどされないであろう。"},{"ref":"Lev.25.31","start":3025031,"end":3025031,"break":"none","ruby":[[4,2,"しゅうい"],[7,2,"じょうへき"],[12,2,"むらむら"],[15,1,"いえ"],[20,2,"ちほう"],[23,1,"はたけ"],[25,2,"ふぞく"],[37,1,"か"],[54,1,"とし"]],"text":"しかし、周囲に城壁のない村々の家は、その地方の畑に附属するものとみなされ、買いもどすことができ、またヨベルの年には、もどされるであろう。"},{"ref":"Lev.25.32","start":3025032,"end":3025032,"break":"none","ruby":[[5,2,"まちまち"],[13,1,"かれ"],[16,2,"しょゆう"],[19,2,"まちまち"],[22,1,"いえ"],[34,1,"か"]],"text":"レビびとの町々、すなわち、彼らの所有の町々の家は、レビびとはいつでも買いもどすことができる。"},{"ref":"Lev.25.33","start":3025033,"end":3025033,"break":"none","ruby":[[13,1,"か"],[20,1,"とき"],[25,2,"しょゆう"],[28,1,"まち"],[32,1,"う"],[35,1,"いえ"],[41,1,"とし"],[59,2,"まちまち"],[62,1,"いえ"],[70,2,"ひとびと"],[76,1,"かれ"],[84,2,"しょゆう"]],"text":"レビびとのひとりが、それを買いもどさない時は、その所有の町にある売った家はヨベルの年にはもどされるであろう。レビびとの町々の家はイスラエルの人々のうちに彼らがもっている所有だからである。"},{"ref":"Lev.25.34","start":3025034,"end":3025034,"break":"none","ruby":[[4,1,"かれ"],[7,2,"まちまち"],[10,2,"しゅうい"],[13,2,"ほうぼく"],[15,1,"ち"],[17,1,"う"],[29,1,"かれ"],[32,2,"えいきゅう"],[35,2,"しょゆう"]],"text":"ただし、彼らの町々の周囲の放牧地は売ってはならない。それは彼らの永久の所有だからである。"},{"ref":"Lev.25.35","start":3025035,"end":3025035,"break":"paragraph","ruby":[[4,2,"きょうだい"],[7,1,"お"],[12,1,"くら"],[15,1,"い"],[19,1,"とき"],[22,1,"かれ"],[24,1,"たす"],[27,3,"きりゅうしゃ"],[33,1,"たび"],[47,1,"とも"],[49,1,"い"]],"text":"あなたの兄弟が落ちぶれ、暮して行けない時は、彼を助け、寄留者または旅びとのようにして、あなたと共に生きながらえさせなければならない。"},{"ref":"Lev.25.36","start":3025036,"end":3025036,"break":"none","ruby":[[0,1,"かれ"],[3,2,"りし"],[6,2,"りそく"],[9,1,"と"],[22,1,"かみ"],[24,1,"おそ"],[31,2,"きょうだい"],[38,1,"とも"],[40,1,"い"]],"text":"彼から利子も利息も取ってはならない。あなたの神を恐れ、あなたの兄弟をあなたと共に生きながらえさせなければならない。"},{"ref":"Lev.25.37","start":3025037,"end":3025037,"break":"none","ruby":[[4,2,"りし"],[7,1,"と"],[10,1,"かれ"],[12,1,"かね"],[14,1,"か"],[25,2,"りえき"],[33,2,"しょくもつ"],[36,1,"か"]],"text":"あなたは利子を取って彼に金を貸してはならない。また利益をえるために食物を貸してはならない。"},{"ref":"Lev.25.38","start":3025038,"end":3025038,"break":"none","ruby":[[10,1,"かみ"],[12,1,"しゅ"],[22,1,"ち"],[30,1,"あた"],[41,1,"かみ"],[59,1,"くに"],[62,1,"みちび"],[64,1,"だ"],[67,1,"もの"]],"text":"わたしはあなたがたの神、主であって、カナンの地をあなたがたに与え、かつあなたがたの神となるためにあなたがたをエジプトの国から導き出した者である。"},{"ref":"Lev.25.39","start":3025039,"end":3025039,"break":"paragraph","ruby":[[4,2,"きょうだい"],[7,1,"お"],[17,1,"み"],[19,1,"う"],[25,2,"どれい"],[31,1,"はたら"]],"text":"あなたの兄弟が落ちぶれて、あなたに身を売るときは、奴隷のように働かせてはならない。"},{"ref":"Lev.25.40","start":3025040,"end":3025040,"break":"none","ruby":[[0,1,"かれ"],[2,2,"やといにん"],[11,1,"たび"],[24,1,"ところ"],[34,1,"とし"],[41,1,"ところ"],[43,1,"つと"]],"text":"彼を雇人のように、また旅びとのようにしてあなたの所におらせ、ヨベルの年まであなたの所で勤めさせなさい。"},{"ref":"Lev.25.41","start":3025041,"end":3025041,"break":"none","ruby":[[2,1,"とき"],[6,1,"かれ"],[8,2,"こども"],[13,1,"とも"],[19,1,"ところ"],[22,1,"で"],[27,2,"いちぞく"],[33,1,"かえ"],[36,2,"せんぞ"],[39,2,"しょゆう"],[42,1,"ち"]],"text":"その時には、彼は子供たちと共にあなたの所から出て、その一族のもとに帰り、先祖の所有の地にもどるであろう。"},{"ref":"Lev.25.42","start":3025042,"end":3025042,"break":"none","ruby":[[0,1,"かれ"],[8,1,"くに"],[15,1,"みちび"],[17,1,"だ"],[33,1,"み"],[35,1,"う"],[38,2,"どれい"]],"text":"彼らはエジプトの国からわたしが導き出したわたしのしもべであるから、身を売って奴隷となってはならない。"},{"ref":"Lev.25.43","start":3025043,"end":3025043,"break":"none","ruby":[[4,1,"かれ"],[10,1,"つか"],[23,1,"かみ"],[25,1,"おそ"]],"text":"あなたは彼をきびしく使ってはならない。あなたの神を恐れなければならない。"},{"ref":"Lev.25.44","start":3025044,"end":3025044,"break":"none","ruby":[[6,2,"どれい"],[9,2,"だんじょ"],[18,2,"しゅうい"],[21,3,"いほうじん"],[29,1,"か"],[45,1,"かれ"],[52,2,"だんじょ"],[55,2,"どれい"],[58,1,"か"]],"text":"あなたがもつ奴隷は男女ともにあなたの周囲の異邦人のうちから買わなければならない。すなわち、彼らのうちから男女の奴隷を買うべきである。"},{"ref":"Lev.25.45","start":3025045,"end":3025045,"break":"none","ruby":[[12,1,"やど"],[17,1,"たび"],[21,2,"こども"],[29,1,"か"],[40,1,"かれ"],[51,1,"くに"],[53,1,"うま"],[63,1,"とも"],[67,2,"ひとびと"],[70,2,"かぞく"],[75,1,"か"],[87,1,"かれ"],[96,2,"しょゆう"]],"text":"また、あなたがたのうちに宿っている旅びとの子供のうちからも買うことができる。また彼らのうちあなたがたの国で生れて、あなたがたと共におる人々の家族からも買うことができる。そして彼らはあなたがたの所有となるであろう。"},{"ref":"Lev.25.46","start":3025046,"end":3025046,"break":"none","ruby":[[6,1,"かれ"],[9,1,"え"],[18,1,"のち"],[20,2,"しそん"],[23,2,"しょゆう"],[28,1,"つ"],[44,1,"かれ"],[47,1,"なが"],[55,2,"どれい"],[75,2,"きょうだい"],[86,2,"ひとびと"],[95,1,"たがい"],[101,1,"つか"]],"text":"あなたがたは彼らを獲て、あなたがたの後の子孫に所有として継がせることができる。すなわち、彼らは長くあなたがたの奴隷となるであろう。しかし、あなたがたの兄弟であるイスラエルの人々をあなたがたは互にきびしく使ってはならない。"},{"ref":"Lev.25.47","start":3025047,"end":3025047,"break":"paragraph","ruby":[[4,1,"とも"],[8,3,"きりゅうしゃ"],[14,1,"たび"],[18,1,"と"],[34,2,"きょうだい"],[37,1,"お"],[47,1,"とも"],[53,3,"きりゅうしゃ"],[57,1,"たび"],[64,3,"きりゅうしゃ"],[68,2,"いちぞく"],[75,1,"み"],[77,1,"う"],[80,2,"ばあい"]],"text":"あなたと共にいる寄留者または旅びとが富み、そのかたわらにいるあなたの兄弟が落ちぶれて、あなたと共にいるその寄留者、旅びと、または寄留者の一族のひとりに身を売った場合、"},{"ref":"Lev.25.48","start":3025048,"end":3025048,"break":"none","ruby":[[0,1,"み"],[2,1,"う"],[5,1,"のち"],[8,1,"かれ"],[10,1,"か"],[24,2,"きょうだい"],[31,1,"かれ"],[33,1,"か"]],"text":"身を売った後でも彼を買いもどすことができる。その兄弟のひとりが彼を買いもどさなければならない。"},{"ref":"Lev.25.49","start":3025049,"end":3025049,"break":"none","ruby":[[15,1,"こ"],[17,1,"かれ"],[19,1,"か"],[37,2,"いちぞく"],[40,2,"きんしん"],[43,1,"もの"],[46,1,"かれ"],[48,1,"か"],[66,2,"じぶん"],[69,1,"とみ"],[78,2,"じぶん"],[81,1,"か"]],"text":"あるいは、おじ、または、おじの子が彼を買いもどさなければならない。あるいは一族の近親の者が、彼を買いもどさなければならない。あるいは自分に富ができたならば、自分で買いもどさなければならない。"},{"ref":"Lev.25.50","start":3025050,"end":3025050,"break":"none","ruby":[[2,1,"とき"],[4,1,"かれ"],[6,2,"じぶん"],[9,1,"み"],[11,1,"う"],[14,1,"とし"],[21,1,"とし"],[28,1,"か"],[30,1,"ぬし"],[32,1,"とも"],[34,1,"かぞ"],[39,2,"ねんすう"],[46,1,"み"],[48,2,"しろきん"],[51,1,"き"],[64,2,"ねんすう"],[67,1,"やと"],[71,2,"ねんすう"],[76,1,"かぞ"]],"text":"その時、彼は自分の身を売った年からヨベルの年までを、その買い主と共に数え、その年数によって、身の代金を決めなければならない。その年数は雇われた年数として数えなければならない。"},{"ref":"Lev.25.51","start":3025051,"end":3025051,"break":"none","ruby":[[2,1,"のこ"],[5,1,"とし"],[7,1,"おお"],[9,1,"とき"],[14,2,"ねんすう"],[22,1,"か"],[26,2,"きんがく"],[29,1,"てら"],[38,1,"かね"],[40,1,"はら"]],"text":"なお残りの年が多い時は、その年数にしたがい、買われた金額に照して、あがないの金を払わなければならない。"},{"ref":"Lev.25.52","start":3025052,"end":3025052,"break":"none","ruby":[[6,1,"とし"],[10,1,"のこ"],[13,1,"とし"],[15,1,"すく"],[23,1,"ひと"],[25,1,"とも"],[27,2,"けいさん"],[33,2,"ねんすう"],[47,1,"かね"],[49,1,"はら"]],"text":"またヨベルの年までに残りの年が少なければ、その人と共に計算し、その年数にしたがって、あがないの金を払わなければならない。"},{"ref":"Lev.25.53","start":3025053,"end":3025053,"break":"none","ruby":[[0,1,"かれ"],[2,2,"ねんねん"],[4,1,"やと"],[8,1,"ひと"],[13,1,"あつか"],[29,1,"め"],[31,1,"まえ"],[33,1,"かれ"],[39,1,"つか"]],"text":"彼は年々雇われる人のように扱われなければならない。あなたの目の前で彼をきびしく使わせてはならない。"},{"ref":"Lev.25.54","start":3025054,"end":3025054,"break":"none","ruby":[[2,1,"かれ"],[26,1,"とし"],[28,1,"かれ"],[30,2,"こども"],[33,1,"とも"],[35,1,"で"],[37,1,"い"]],"text":"もし彼がこのようにしてあがなわれないならば、ヨベルの年に彼は子供と共に出て行くことができる。"},{"ref":"Lev.25.55","start":3025055,"end":3025055,"break":"none","ruby":[[6,2,"ひとびと"],[24,1,"かれ"],[36,1,"くに"],[39,1,"みちび"],[41,1,"だ"],[65,1,"かみ"],[67,1,"しゅ"]],"text":"イスラエルの人々は、わたしのしもべだからである。彼らはわたしがエジプトの国から導き出したわたしのしもべである。わたしはあなたがたの神、主である。"}]