[{"ref":"Rev.8.1","start":66008001,"end":66008001,"break":"paragraph","ruby":[[0,2,"こひつじ"],[3,1,"だい"],[6,2,"ふういん"],[9,1,"と"],[12,1,"とき"],[14,1,"はん"],[15,2,"じかん"],[20,1,"てん"],[22,1,"しず"]],"text":"小羊が第七の封印を解いた時、半時間ばかり天に静けさがあった。"},{"ref":"Rev.8.2","start":66008002,"end":66008002,"break":"none","ruby":[[9,1,"かみ"],[15,1,"た"],[21,1,"にん"],[23,2,"みつかい"],[26,1,"み"],[40,1,"かれ"],[43,1,"あた"]],"text":"それからわたしは、神のみまえに立っている七人の御使を見た。そして、七つのラッパが彼らに与えられた。"},{"ref":"Rev.8.3","start":66008003,"end":66008003,"break":"paragraph","ruby":[[3,1,"べつ"],[5,2,"みつかい"],[8,1,"で"],[13,1,"きん"],[15,2,"こうろ"],[18,1,"て"],[20,1,"も"],[23,2,"さいだん"],[26,1,"まえ"],[28,1,"た"],[37,1,"こう"],[39,1,"かれ"],[41,1,"あた"],[58,2,"せいと"],[61,1,"いのり"],[63,1,"くわ"],[67,2,"みざ"],[70,1,"まえ"],[72,1,"きん"],[74,2,"さいだん"],[77,1,"うえ"]],"text":"また、別の御使が出てきて、金の香炉を手に持って祭壇の前に立った。たくさんの香が彼に与えられていたが、これは、すべての聖徒の祈に加えて、御座の前の金の祭壇の上にささげるためのものであった。"},{"ref":"Rev.8.4","start":66008004,"end":66008004,"break":"none","ruby":[[0,1,"こう"],[2,1,"けむり"],[5,2,"みつかい"],[8,1,"て"],[12,2,"せいと"],[17,1,"いのり"],[19,1,"とも"],[21,1,"かみ"],[27,1,"た"]],"text":"香の煙は、御使の手から、聖徒たちの祈と共に神のみまえに立ちのぼった。"},{"ref":"Rev.8.5","start":66008005,"end":66008005,"break":"none","ruby":[[0,2,"みつかい"],[5,2,"こうろ"],[14,2,"さいだん"],[17,1,"ひ"],[19,1,"み"],[24,1,"ち"],[26,1,"な"],[36,1,"おお"],[39,2,"らいめい"],[48,1,"こえ"],[57,2,"じしん"],[61,1,"おこ"]],"text":"御使はその香炉をとり、これに祭壇の火を満たして、地に投げつけた。すると、多くの雷鳴と、もろもろの声と、いなずまと、地震とが起った。"},{"ref":"Rev.8.6","start":66008006,"end":66008006,"break":"paragraph","ruby":[[11,1,"も"],[17,1,"にん"],[19,2,"みつかい"],[26,1,"ふ"],[28,2,"ようい"]],"text":"そこで、七つのラッパを持っている七人の御使が、それを吹く用意をした。"},{"ref":"Rev.8.7","start":66008007,"end":66008007,"break":"paragraph","ruby":[[0,1,"だい"],[3,2,"みつかい"],[11,1,"ふ"],[13,1,"な"],[22,1,"ち"],[28,1,"ひょう"],[30,1,"ひ"],[39,2,"ちじょう"],[42,1,"ふ"],[52,1,"ち"],[55,1,"ぶん"],[59,1,"や"],[62,1,"き"],[65,1,"ぶん"],[69,1,"や"],[79,2,"あおくさ"],[82,1,"や"]],"text":"第一の御使が、ラッパを吹き鳴らした。すると、血のまじった雹と火とがあらわれて、地上に降ってきた。そして、地の三分の一が焼け、木の三分の一が焼け、また、すべての青草も焼けてしまった。"},{"ref":"Rev.8.8","start":66008008,"end":66008008,"break":"paragraph","ruby":[[0,1,"だい"],[3,2,"みつかい"],[11,1,"ふ"],[13,1,"な"],[22,1,"ひ"],[24,1,"も"],[32,1,"おお"],[35,1,"やま"],[44,1,"うみ"],[46,1,"な"],[48,1,"こ"],[57,1,"うみ"],[60,1,"ぶん"],[64,1,"ち"]],"text":"第二の御使が、ラッパを吹き鳴らした。すると、火の燃えさかっている大きな山のようなものが、海に投げ込まれた。そして、海の三分の一は血となり、"},{"ref":"Rev.8.9","start":66008009,"end":66008009,"break":"none","ruby":[[0,1,"うみ"],[2,1,"なか"],[4,1,"つく"],[8,1,"い"],[10,1,"もの"],[13,1,"ぶん"],[17,1,"し"],[20,1,"ふね"],[23,1,"ぶん"]],"text":"海の中の造られた生き物の三分の一は死に、舟の三分の一がこわされてしまった。"},{"ref":"Rev.8.10","start":66008010,"end":66008010,"break":"paragraph","ruby":[[0,1,"だい"],[3,2,"みつかい"],[11,1,"ふ"],[13,1,"な"],[30,1,"も"],[35,1,"おお"],[38,1,"ほし"],[41,1,"そら"],[44,1,"お"],[57,1,"かわ"],[60,1,"ぶん"],[66,2,"すいげん"],[70,1,"うえ"],[72,1,"お"]],"text":"第三の御使が、ラッパを吹き鳴らした。すると、たいまつのように燃えている大きな星が、空から落ちてきた。そしてそれは、川の三分の一とその水源との上に落ちた。"},{"ref":"Rev.8.11","start":66008011,"end":66008011,"break":"none","ruby":[[2,1,"ほし"],[4,1,"な"],[7,1,"にが"],[13,1,"い"],[16,1,"みず"],[19,1,"ぶん"],[24,1,"にが"],[33,1,"にが"],[39,1,"みず"],[41,1,"にが"],[54,1,"おお"],[57,1,"ひと"],[59,1,"し"]],"text":"この星の名は「苦よもぎ」と言い、水の三分の一が「苦よもぎ」のように苦くなった。水が苦くなったので、そのために多くの人が死んだ。"},{"ref":"Rev.8.12","start":66008012,"end":66008012,"break":"paragraph","ruby":[[0,1,"だい"],[3,2,"みつかい"],[11,1,"ふ"],[13,1,"な"],[22,2,"たいよう"],[26,1,"ぶん"],[31,1,"つき"],[34,1,"ぶん"],[39,1,"ほし"],[42,1,"ぶん"],[47,1,"う"],[60,1,"ぶん"],[64,1,"くら"],[69,1,"ひる"],[72,1,"ぶん"],[76,1,"あか"],[84,1,"よる"],[86,1,"おな"]],"text":"第四の御使が、ラッパを吹き鳴らした。すると、太陽の三分の一と、月の三分の一と、星の三分の一とが打たれて、これらのものの三分の一は暗くなり、昼の三分の一は明るくなくなり、夜も同じようになった。"},{"ref":"Rev.8.13","start":66008013,"end":66008013,"break":"paragraph","ruby":[[7,1,"み"],[14,1,"わ"],[19,2,"なかぞら"],[22,1,"と"],[25,1,"おお"],[28,1,"こえ"],[32,1,"い"],[36,1,"き"],[56,1,"ち"],[58,1,"す"],[60,2,"ひとびと"],[73,1,"にん"],[75,2,"みつかい"],[82,1,"ふ"],[84,1,"な"]],"text":"また、わたしが見ていると、一羽のわしが中空を飛び、大きな声でこう言うのを聞いた、「ああ、わざわいだ、わざわいだ、地に住む人々は、わざわいだ。なお三人の御使がラッパを吹き鳴らそうとしている」。"}]