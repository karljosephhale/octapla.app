[{"ref":"Mark.3.1","start":41003001,"end":41003001,"break":"paragraph","ruby":[[6,2,"かいどう"],[19,2,"かたて"],[25,1,"ひと"]],"text":"イエスがまた会堂にはいられると、そこに片手のなえた人がいた。"},{"ref":"Mark.3.2","start":41003002,"end":41003002,"break":"none","ruby":[[0,2,"ひとびと"],[7,1,"うった"],[12,1,"おも"],[16,3,"あんそくにち"],[22,1,"ひと"]],"text":"人々はイエスを訴えようと思って、安息日にその人をいやされるかどうかをうかがっていた。"},{"ref":"Mark.3.3","start":41003003,"end":41003003,"break":"none","ruby":[[8,2,"かたて"],[16,1,"ひと"],[20,1,"た"],[24,1,"なか"],[26,1,"で"],[34,1,"い"]],"text":"すると、イエスは片手のなえたその人に、「立って、中へ出てきなさい」と言い、"},{"ref":"Mark.3.4","start":41003004,"end":41003004,"break":"none","ruby":[[0,2,"ひとびと"],[9,3,"あんそくにち"],[13,1,"ぜん"],[15,1,"おこな"],[19,1,"あく"],[21,1,"おこな"],[26,1,"いのち"],[28,1,"すく"],[32,1,"ころ"],[46,1,"い"],[51,1,"かれ"],[54,1,"だま"]],"text":"人々にむかって、「安息日に善を行うのと悪を行うのと、命を救うのと殺すのと、どちらがよいか」と言われた。彼らは黙っていた。"},{"ref":"Mark.3.5","start":41003005,"end":41003005,"break":"none","ruby":[[4,1,"いか"],[7,1,"ふく"],[10,1,"かれ"],[13,1,"み"],[20,1,"こころ"],[29,1,"なげ"],[35,1,"ひと"],[38,1,"て"],[40,1,"の"],[48,1,"い"],[56,1,"て"],[58,1,"の"],[65,1,"て"],[67,1,"もと"]],"text":"イエスは怒りを含んで彼らを見まわし、その心のかたくななのを嘆いて、その人に「手を伸ばしなさい」と言われた。そこで手を伸ばすと、その手は元どおりになった。"},{"ref":"Mark.3.6","start":41003006,"end":41003006,"break":"none","ruby":[[4,1,"びと"],[8,1,"で"],[10,1,"い"],[20,1,"とう"],[22,1,"もの"],[37,1,"ころ"],[41,2,"そうだん"]],"text":"パリサイ人たちは出て行って、すぐにヘロデ党の者たちと、なんとかしてイエスを殺そうと相談しはじめた。"},{"ref":"Mark.3.7","start":41003007,"end":41003007,"break":"paragraph","ruby":[[9,2,"でし"],[14,1,"とも"],[16,1,"うみ"],[19,1,"しりぞ"],[39,2,"ぐんしゅう"],[45,1,"い"]],"text":"それから、イエスは弟子たちと共に海べに退かれたが、ガリラヤからきたおびただしい群衆がついて行った。またユダヤから、"},{"ref":"Mark.3.8","start":41003008,"end":41003008,"break":"none","ruby":[[15,1,"さら"],[22,1,"む"],[48,2,"ぐんしゅう"],[63,1,"き"]],"text":"エルサレムから、イドマヤから、更にヨルダンの向こうから、ツロ、シドンのあたりからも、おびただしい群衆が、そのなさっていることを聞いて、みもとにきた。"},{"ref":"Mark.3.9","start":41003009,"end":41003009,"break":"none","ruby":[[4,2,"ぐんしゅう"],[7,2,"じぶん"],[10,1,"お"],[12,1,"せま"],[16,1,"さ"],[23,2,"こぶね"],[26,2,"ようい"],[34,2,"でし"],[39,1,"めい"]],"text":"イエスは群衆が自分に押し迫るのを避けるために、小舟を用意しておけと、弟子たちに命じられた。"},{"ref":"Mark.3.10","start":41003010,"end":41003010,"break":"none","ruby":[[4,1,"おお"],[7,1,"ひと"],[17,2,"びょうく"],[20,1,"なや"],[22,1,"もの"],[24,1,"みな"],[37,1,"お"],[39,1,"よ"]],"text":"それは、多くの人をいやされたので、病苦に悩む者は皆イエスにさわろうとして、押し寄せてきたからである。"},{"ref":"Mark.3.11","start":41003011,"end":41003011,"break":"none","ruby":[[7,1,"れい"],[15,1,"み"],[27,1,"ふ"],[30,1,"さけ"],[40,1,"かみ"],[42,1,"こ"],[47,1,"い"]],"text":"また、けがれた霊どもはイエスを見るごとに、みまえにひれ伏し、叫んで、「あなたこそ神の子です」と言った。"},{"ref":"Mark.3.12","start":41003012,"end":41003012,"break":"none","ruby":[[4,1,"ご"],[5,2,"じしん"],[11,1,"ひと"],[24,1,"かれ"],[31,1,"いまし"]],"text":"イエスは御自身のことを人にあらわさないようにと、彼らをきびしく戒められた。"},{"ref":"Mark.3.13","start":41003013,"end":41003013,"break":"paragraph","ruby":[[6,1,"やま"],[8,1,"のぼ"],[20,1,"もの"],[24,1,"よ"],[26,1,"よ"],[34,1,"かれ"]],"text":"さてイエスは山に登り、みこころにかなった者たちを呼び寄せられたので、彼らはみもとにきた。"},{"ref":"Mark.3.14","start":41003014,"end":41003014,"break":"none","ruby":[[5,1,"にん"],[8,1,"た"],[15,1,"かれ"],[18,2,"じぶん"],[24,1,"お"],[35,2,"せんきょう"]],"text":"そこで十二人をお立てになった。彼らを自分のそばに置くためであり、さらに宣教につかわし、"},{"ref":"Mark.3.15","start":41003015,"end":41003015,"break":"none","ruby":[[2,2,"あくれい"],[5,1,"お"],[7,1,"だ"],[9,2,"けんい"],[12,1,"も"]],"text":"また悪霊を追い出す権威を持たせるためであった。"},{"ref":"Mark.3.16","start":41003016,"end":41003016,"break":"none","ruby":[[9,1,"にん"],[12,1,"た"],[32,1,"な"]],"text":"こうして、この十二人をお立てになった。そしてシモンにペテロという名をつけ、"},{"ref":"Mark.3.17","start":41003017,"end":41003017,"break":"none","ruby":[[7,1,"こ"],[17,2,"きょうだい"],[23,1,"かれ"],[38,1,"かみなり"],[40,1,"こ"],[44,1,"な"]],"text":"またゼベダイの子ヤコブと、ヤコブの兄弟ヨハネ、彼らにはボアネルゲ、すなわち、雷の子という名をつけられた。"},{"ref":"Mark.3.18","start":41003018,"end":41003018,"break":"none","ruby":[[32,1,"こ"],[41,2,"ねっしん"],[43,1,"とう"]],"text":"つぎにアンデレ、ピリポ、バルトロマイ、マタイ、トマス、アルパヨの子ヤコブ、タダイ、熱心党のシモン、"},{"ref":"Mark.3.19","start":41003019,"end":41003019,"break":"none","breaks":[[32,"paragraph"]],"ruby":[[23,2,"うらぎ"],[36,1,"いえ"]],"text":"それからイスカリオテのユダ。このユダがイエスを裏切ったのである。イエスが家にはいられると、"},{"ref":"Mark.3.20","start":41003020,"end":41003020,"break":"none","ruby":[[0,2,"ぐんしゅう"],[5,1,"あつ"],[14,2,"いちどう"],[17,2,"しょくじ"],[22,1,"ひま"]],"text":"群衆がまた集まってきたので、一同は食事をする暇もないほどであった。"},{"ref":"Mark.3.21","start":41003021,"end":41003021,"break":"none","ruby":[[0,2,"みうち"],[3,1,"もの"],[9,1,"こと"],[11,1,"き"],[19,2,"とりおさ"],[23,1,"で"],[28,1,"き"],[30,1,"くる"],[34,1,"おも"]],"text":"身内の者たちはこの事を聞いて、イエスを取押えに出てきた。気が狂ったと思ったからである。"},{"ref":"Mark.3.22","start":41003022,"end":41003022,"break":"none","ruby":[[10,1,"くだ"],[15,2,"りっぽう"],[17,2,"がくしゃ"],[24,1,"かれ"],[42,1,"い"],[46,2,"あくれい"],[59,2,"あくれい"],[64,1,"お"],[66,1,"だ"],[76,1,"い"]],"text":"また、エルサレムから下ってきた律法学者たちも、「彼はベルゼブルにとりつかれている」と言い、「悪霊どものかしらによって、悪霊どもを追い出しているのだ」とも言った。"},{"ref":"Mark.3.23","start":41003023,"end":41003023,"break":"none","ruby":[[7,1,"かれ"],[10,1,"よ"],[12,1,"よ"],[15,1,"たとえ"],[20,1,"い"],[39,1,"お"],[41,1,"だ"]],"text":"そこでイエスは彼らを呼び寄せ、譬をもって言われた、「どうして、サタンがサタンを追い出すことができようか。"},{"ref":"Mark.3.24","start":41003024,"end":41003024,"break":"none","ruby":[[2,1,"くに"],[4,2,"ないぶ"],[7,1,"わか"],[9,1,"あらそ"],[16,1,"くに"],[18,1,"た"],[20,1,"い"]],"text":"もし国が内部で分れ争うなら、その国は立ち行かない。"},{"ref":"Mark.3.25","start":41003025,"end":41003025,"break":"none","ruby":[[5,1,"いえ"],[7,1,"うち"],[10,1,"わか"],[12,1,"あらそ"],[19,1,"いえ"],[21,1,"た"],[23,1,"い"]],"text":"また、もし家が内わで分れ争うなら、その家は立ち行かないであろう。"},{"ref":"Mark.3.26","start":41003026,"end":41003026,"break":"none","ruby":[[6,2,"ないぶ"],[9,2,"たいりつ"],[12,2,"ぶんそう"],[19,1,"かれ"],[21,1,"た"],[23,1,"い"],[27,1,"ほろ"]],"text":"もしサタンが内部で対立し分争するなら、彼は立ち行けず、滅んでしまう。"},{"ref":"Mark.3.27","start":41003027,"end":41003027,"break":"none","ruby":[[7,1,"つよ"],[9,1,"ひと"],[11,1,"しば"],[22,1,"ひと"],[24,1,"いえ"],[26,1,"お"],[28,1,"い"],[31,2,"かざい"],[34,1,"うば"],[36,1,"と"],[46,1,"しば"],[58,1,"いえ"],[60,2,"りゃくだつ"]],"text":"だれでも、まず強い人を縛りあげなければ、その人の家に押し入って家財を奪い取ることはできない。縛ってからはじめて、その家を略奪することができる。"},{"ref":"Mark.3.28","start":41003028,"end":41003028,"break":"none","ruby":[[2,1,"い"],[4,1,"き"],[12,1,"ひと"],[14,1,"こ"],[21,1,"おか"],[27,1,"つみ"],[29,1,"かみ"],[34,2,"ことば"]],"text":"よく言い聞かせておくが、人の子らには、その犯すすべての罪も神をけがす言葉も、ゆるされる。"},{"ref":"Mark.3.29","start":41003029,"end":41003029,"break":"none","ruby":[[4,2,"せいれい"],[10,1,"もの"],[24,2,"えいえん"],[27,1,"つみ"],[29,1,"さだ"]],"text":"しかし、聖霊をけがす者は、いつまでもゆるされず、永遠の罪に定められる」。"},{"ref":"Mark.3.30","start":41003030,"end":41003030,"break":"none","ruby":[[2,1,"い"],[9,1,"かれ"],[21,1,"れい"],[31,1,"い"]],"text":"そう言われたのは、彼らが「イエスはけがれた霊につかれている」と言っていたからである。"},{"ref":"Mark.3.31","start":41003031,"end":41003031,"break":"paragraph","ruby":[[7,1,"はは"],[9,2,"きょうだい"],[18,1,"そと"],[20,1,"た"],[23,1,"ひと"],[32,1,"よ"]],"text":"さて、イエスの母と兄弟たちとがきて、外に立ち、人をやってイエスを呼ばせた。"},{"ref":"Mark.3.32","start":41003032,"end":41003032,"break":"none","ruby":[[4,2,"ぐんしゅう"],[11,1,"かこ"],[34,2,"ははうえ"],[37,2,"きょうだい"],[40,2,"しまい"],[46,1,"そと"],[52,1,"たず"],[62,1,"い"]],"text":"ときに、群衆はイエスを囲んですわっていたが、「ごらんなさい。あなたの母上と兄弟、姉妹たちが、外であなたを尋ねておられます」と言った。"},{"ref":"Mark.3.33","start":41003033,"end":41003033,"break":"none","ruby":[[8,1,"かれ"],[11,1,"こた"],[14,1,"い"],[24,1,"はは"],[30,2,"きょうだい"]],"text":"すると、イエスは彼らに答えて言われた、「わたしの母、わたしの兄弟とは、だれのことか」。"},{"ref":"Mark.3.34","start":41003034,"end":41003034,"break":"none","ruby":[[4,2,"じぶん"],[20,2,"ひとびと"],[23,1,"み"],[29,1,"い"],[49,1,"はは"],[55,2,"きょうだい"]],"text":"そして、自分をとりかこんで、すわっている人々を見まわして、言われた、「ごらんなさい、ここにわたしの母、わたしの兄弟がいる。"},{"ref":"Mark.3.35","start":41003035,"end":41003035,"break":"none","ruby":[[0,1,"かみ"],[7,1,"おこな"],[9,1,"もの"],[20,2,"きょうだい"],[25,2,"しまい"],[30,1,"はは"]],"text":"神のみこころを行う者はだれでも、わたしの兄弟、また姉妹、また母なのである」。"}]