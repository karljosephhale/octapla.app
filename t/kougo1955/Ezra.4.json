[{"ref":"Ezra.4.1","start":15004001,"end":15004001,"break":"paragraph","ruby":[[9,1,"てき"],[13,1,"もの"],[17,2,"ほしゅう"],[21,1,"かえ"],[26,2,"ひとびと"],[36,1,"かみ"],[38,1,"しゅ"],[43,2,"しんでん"],[46,1,"た"],[54,1,"き"]],"text":"ユダとベニヤミンの敵である者たちは捕囚から帰ってきた人々が、イスラエルの神、主のために神殿を建てていることを聞き、"},{"ref":"Ezra.4.2","start":15004002,"end":15004002,"break":"none","ruby":[[6,2,"しぞく"],[9,1,"ちょう"],[16,1,"き"],[18,1,"い"],[35,2,"いっしょ"],[41,1,"た"],[62,1,"おな"],[72,1,"かみ"],[74,2,"れいはい"],[86,1,"おう"],[106,1,"き"],[108,1,"ひ"],[121,1,"かれ"],[123,2,"ぎせい"]],"text":"ゼルバベルと氏族の長たちのもとに来て言った、「われわれも、あなたがたと一緒にこれを建てさせてください。われわれはあなたがたと同じく、あなたがたの神を礼拝します。アッスリヤの王エサル・ハドンがわれわれをここにつれて来た日からこのかた、われわれは彼に犠牲をささげてきました」。"},{"ref":"Ezra.4.3","start":15004003,"end":15004003,"break":"none","ruby":[[18,1,"た"],[26,2,"しぞく"],[29,1,"ちょう"],[34,1,"かれ"],[37,1,"い"],[54,1,"かみ"],[56,1,"みや"],[58,1,"た"],[81,1,"おう"],[85,1,"おう"],[92,1,"めい"],[113,1,"かみ"],[115,1,"しゅ"],[120,1,"た"]],"text":"しかしゼルバベル、エシュアおよびその他のイスラエルの氏族の長たちは、彼らに言った、「あなたがたは、われわれの神に宮を建てることにあずかってはなりません。ペルシャの王クロス王がわれわれに命じたように、われわれだけで、イスラエルの神、主のために建てるのです」。"},{"ref":"Ezra.4.4","start":15004004,"end":15004004,"break":"paragraph","ruby":[[5,1,"ち"],[7,1,"たみ"],[12,1,"たみ"],[14,1,"て"],[16,1,"よわ"],[23,2,"けんちく"],[26,1,"さまた"]],"text":"そこでその地の民はユダの民の手を弱らせて、その建築を妨げ、"},{"ref":"Ezra.4.5","start":15004005,"end":15004005,"break":"none","ruby":[[2,1,"くわだ"],[5,1,"やぶ"],[10,2,"やくにん"],[13,2,"ばいしゅう"],[17,1,"かれ"],[20,1,"てき"],[29,1,"おう"],[34,1,"よ"],[41,1,"おう"],[47,2,"ちせい"],[52,1,"およ"]],"text":"その企てを破るために役人を買収して彼らに敵せしめ、ペルシャ王クロスの代からペルシャ王ダリヨスの治世にまで及んだ。"},{"ref":"Ezra.4.6","start":15004006,"end":15004006,"break":"none","ruby":[[7,2,"ちせい"],[16,2,"ちせい"],[19,1,"はじ"],[23,1,"かれ"],[35,2,"じゅうみん"],[38,1,"うった"],[41,2,"こくそ"],[43,1,"じょう"],[45,1,"か"]],"text":"アハスエロスの治世、すなわちその治世の初めに、彼らはユダとエルサレムの住民を訴える告訴状を書いた。"},{"ref":"Ezra.4.7","start":15004007,"end":15004007,"break":"paragraph","ruby":[[10,1,"よ"],[32,1,"た"],[34,2,"どうりょう"],[42,1,"おう"],[51,2,"てがみ"],[54,1,"か"],[60,2,"てがみ"],[63,1,"ぶん"],[68,1,"ご"],[70,1,"か"],[74,1,"やく"]],"text":"またアルタシャスタの世にビシラム、ミテレダテ、タビエルおよびその他の同僚も、ペルシャ王アルタシャスタに手紙を書いた。その手紙の文はアラム語で書かれて訳されていた。"},{"ref":"Ezra.4.8","start":15004008,"end":15004008,"break":"none","ruby":[[0,2,"ちょうかん"],[6,3,"しょきかん"],[22,1,"おう"],[30,1,"うった"],[33,1,"つぎ"],[38,2,"てがみ"]],"text":"長官レホムと書記官シムシャイはアルタシャスタ王にエルサレムを訴えて次のような手紙をしたためた。"},{"ref":"Ezra.4.9","start":15004009,"end":15004009,"break":"none","ruby":[[4,2,"ちょうかん"],[10,3,"しょきかん"],[23,1,"た"],[25,2,"どうりょう"],[32,3,"さいばんかん"],[36,2,"ちじ"],[39,2,"やくにん"],[46,1,"ひと"],[52,2,"ひとびと"],[59,1,"ひと"],[64,2,"ひとびと"]],"text":"すなわち長官レホムと書記官シムシャイおよびその他の同僚、すなわち裁判官、知事、役人、ペルシャ人、エレクの人々、バビロン人、スサの人々すなわちエラムびと、"},{"ref":"Ezra.4.10","start":15004010,"end":15004010,"break":"none","ruby":[[5,1,"た"],[7,1,"たみ"],[12,1,"おお"],[16,1,"たっと"],[25,1,"うつ"],[33,2,"まちまち"],[38,1,"かわ"],[39,1,"む"],[45,1,"た"],[47,1,"ち"],[49,1,"す"],[53,1,"もの"]],"text":"およびその他の民すなわち大いなる尊いオスナパルが、移してサマリヤの町々および川向こうのその他の地に住ませた者どもが、"},{"ref":"Ezra.4.11","start":15004011,"end":15004011,"break":"none","ruby":[[0,1,"おく"],[3,2,"てがみ"],[6,1,"うつ"],[25,1,"おう"],[28,1,"かわ"],[29,1,"む"],[48,1,"もう"],[50,1,"あ"]],"text":"送った手紙の写しはこれである。――「アルタシャスタ王へ、川向こうのあなたのしもべども、あいさつを申し上げます。"},{"ref":"Ezra.4.12","start":15004012,"end":15004012,"break":"none","ruby":[[0,1,"おう"],[4,2,"しょうち"],[26,1,"ところ"],[28,1,"のぼ"],[31,1,"き"],[36,1,"ひと"],[45,1,"き"],[54,1,"わる"],[56,1,"まち"],[58,1,"た"],[60,1,"なお"],[65,2,"じょうへき"],[68,1,"きず"],[75,2,"きそ"]],"text":"王よ、ご承知ください。あなたのもとから、わたしたちの所に上って来たユダヤ人らはエルサレムに来て、かのそむいた悪い町を建て直し、その城壁を築きあげ、その基礎をつくろっています。"},{"ref":"Ezra.4.13","start":15004013,"end":15004013,"break":"none","ruby":[[0,1,"おう"],[6,2,"しょうち"],[17,1,"まち"],[19,1,"た"],[22,2,"じょうへき"],[25,1,"きず"],[34,1,"かれ"],[41,2,"かんぜい"],[44,2,"ぜいきん"],[47,1,"おさ"],[61,1,"おう"],[63,2,"しゅうにゅう"],[66,1,"へ"]],"text":"王よ、いまご承知ください。もしこの町を建て、城壁を築きあげるならば、彼らはみつぎ、関税、税金を納めなくなります。そうすれば王の収入が減るでしょう。"},{"ref":"Ezra.4.14","start":15004014,"end":15004014,"break":"none","ruby":[[5,2,"おうきゅう"],[8,1,"しお"],[12,1,"もの"],[18,1,"おう"],[20,3,"ふめいよ"],[24,1,"み"],[27,1,"しの"],[34,1,"ひと"],[41,1,"おう"],[44,1,"き"]],"text":"われわれは王宮の塩をはむ者ですから、王の不名誉を見るに忍びないので、人をつかわして王にお聞かせするのです。"},{"ref":"Ezra.4.15","start":15004015,"end":15004015,"break":"none","ruby":[[0,2,"れきだい"],[3,2,"きろく"],[7,1,"しら"],[16,2,"きろく"],[19,1,"しょ"],[27,1,"まち"],[33,1,"まち"],[36,2,"しょおう"],[39,1,"しょ"],[40,1,"しゅう"],[42,1,"がい"],[44,1,"およ"],[56,1,"み"],[60,1,"なか"],[62,2,"こらい"],[69,1,"おこな"],[76,1,"し"],[87,1,"まち"],[89,1,"ほろ"]],"text":"歴代の記録をお調べください。その記録の書において、この町はそむいた町で、諸王と諸州に害を及ぼしたものであることを見、その中に古来、むほんの行われたことを知られるでしょう。この町が滅ぼされたのはこれがためなのです。"},{"ref":"Ezra.4.16","start":15004016,"end":15004016,"break":"none","ruby":[[5,1,"おう"],[8,1,"おし"],[21,1,"まち"],[23,1,"た"],[28,2,"じょうへき"],[31,1,"きず"],[41,1,"おう"],[43,1,"かわ"],[44,1,"む"],[48,2,"りょうち"],[51,1,"うしな"],[54,1,"いた"]],"text":"われわれは王にお知らせいたします。もしこの町が建てられ、城壁が築きあげられたなら、王は川向こうの領地を失うに至るでしょう」。"},{"ref":"Ezra.4.17","start":15004017,"end":15004017,"break":"paragraph","ruby":[[0,1,"おう"],[2,2,"へんしょ"],[5,1,"おく"],[8,1,"い"],[13,2,"ちょうかん"],[19,3,"しょきかん"],[30,1,"た"],[38,1,"かわ"],[39,1,"む"],[46,1,"ところ"],[48,1,"す"],[53,2,"どうりょう"]],"text":"王は返書を送って言った、「長官レホム、書記官シムシャイ、その他サマリヤおよび川向こうのほかの所に住んでいる同僚に、あいさつをする。いま、"},{"ref":"Ezra.4.18","start":15004018,"end":15004018,"break":"none","ruby":[[11,1,"おく"],[14,2,"てがみ"],[22,1,"まえ"],[24,1,"あき"],[28,1,"よ"]],"text":"あなたがたがわれわれに送った手紙を、わたしの前に明らかに読ませた。"},{"ref":"Ezra.4.19","start":15004019,"end":15004019,"break":"none","ruby":[[4,2,"めいれい"],[7,1,"くだ"],[10,2,"ちょうさ"],[21,1,"まち"],[23,2,"こらい"],[26,2,"しょおう"],[33,1,"こと"],[37,1,"なか"],[39,2,"はんらん"],[52,1,"み"]],"text":"わたしは命令を下して調査させたところ、この町は古来、諸王にそむいた事、その中に反乱、むほんのあったことを見いだした。"},{"ref":"Ezra.4.20","start":15004020,"end":15004020,"break":"none","ruby":[[9,1,"おお"],[13,1,"おう"],[21,1,"かわ"],[22,1,"む"],[26,1,"ち"],[33,1,"おさ"],[40,2,"かんぜい"],[43,2,"ぜいきん"],[46,1,"おさ"]],"text":"またエルサレムには大いなる王たちがあって、川向こうの地をことごとく治め、みつぎ、関税、税金を納めさせたこともあった。"},{"ref":"Ezra.4.21","start":15004021,"end":15004021,"break":"none","ruby":[[9,2,"めいれい"],[12,1,"つた"],[18,2,"ひとびと"],[29,2,"めいれい"],[32,1,"くだ"],[39,1,"まち"],[41,1,"た"]],"text":"それであなたがたは命令を伝えて、その人々をとどめ、わたしの命令の下るまで、この町を建てさせてはならない。"},{"ref":"Ezra.4.22","start":15004022,"end":15004022,"break":"none","ruby":[[6,1,"つつし"],[17,1,"おこた"],[36,2,"そんがい"],[39,1,"ま"],[43,1,"おう"],[45,1,"がい"],[47,1,"およ"]],"text":"あなたがたは慎んでこのことについて怠ることのないようにしなさい。どうして損害を増して、王に害を及ぼしてよかろうか」。"},{"ref":"Ezra.4.23","start":15004023,"end":15004023,"break":"paragraph","ruby":[[7,1,"おう"],[9,2,"てがみ"],[12,1,"うつ"],[21,3,"しょきかん"],[32,2,"どうりょう"],[35,1,"まえ"],[37,1,"よ"],[39,1,"あ"],[47,1,"かれ"],[50,1,"いそ"],[62,1,"ひと"],[72,2,"わんりょく"],[75,2,"けんりょく"],[82,1,"かれ"]],"text":"アルタシャスタ王の手紙の写しがレホムおよび書記官シムシャイとその同僚の前に読み上げられたので、彼らは急いでエルサレムのユダヤ人のもとにおもむき、腕力と権力とをもって彼らをやめさせた。"},{"ref":"Ezra.4.24","start":15004024,"end":15004024,"break":"none","ruby":[[11,1,"かみ"],[13,1,"みや"],[15,2,"こうじ"],[18,2,"ちゅうし"],[32,1,"おう"],[38,2,"ちせい"],[42,1,"ねん"],[45,2,"ちゅうし"]],"text":"それでエルサレムにある神の宮の工事は中止された。すなわちペルシャ王ダリヨスの治世の二年まで中止された。"}]