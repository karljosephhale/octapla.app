[{"ref":"Jer.36.1","start":24036001,"end":24036001,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"こ"],[16,1,"ねん"],[18,1,"しゅ"],[23,2,"ことば"],[31,1,"のぞ"]],"text":"ユダの王ヨシヤの子エホヤキムの四年に主からこの言葉がエレミヤに臨んだ、"},{"ref":"Jer.36.2","start":24036002,"end":24036002,"break":"none","ruby":[[5,2,"まきもの"],[8,1,"と"],[19,1,"かた"],[22,1,"ひ"],[32,1,"ひ"],[35,2,"こんにち"],[38,1,"いた"],[52,2,"ばんこく"],[56,1,"かん"],[63,1,"かた"],[70,2,"ことば"]],"text":"「あなたは巻物を取り、わたしがあなたに語った日、すなわちヨシヤの日から今日に至るまで、イスラエルとユダと万国とに関してあなたに語ったすべての言葉を、それにしるしなさい。"},{"ref":"Jer.36.3","start":24036003,"end":24036003,"break":"none","ruby":[[3,1,"いえ"],[9,1,"くだ"],[21,1,"わざわい"],[23,1,"き"],[33,1,"わる"],[35,1,"みち"],[37,1,"はな"],[40,1,"かえ"],[66,1,"つみ"],[73,1,"し"]],"text":"ユダの家がわたしの下そうとしているすべての災を聞いて、おのおのその悪い道を離れて帰ることもあろう。そうすれば、わたしはそのとがとその罪をゆるすかも知れない」。"},{"ref":"Jer.36.4","start":24036004,"end":24036004,"break":"paragraph","ruby":[[12,1,"こ"],[17,1,"よ"],[30,2,"こうじゅつ"],[39,1,"しゅ"],[41,1,"かれ"],[44,1,"つ"],[50,2,"ことば"],[58,2,"まきもの"],[61,1,"か"]],"text":"そこでエレミヤはネリヤの子バルクを呼んだ。バルクはエレミヤの口述にしたがって、主が彼にお告げになった言葉をことごとく巻物に書きしるした。"},{"ref":"Jer.36.5","start":24036005,"end":24036005,"break":"none","ruby":[[12,1,"めい"],[15,1,"い"],[24,1,"しゅ"],[26,1,"みや"],[28,1,"い"],[33,1,"さまた"]],"text":"そしてエレミヤはバルクに命じて言った、「わたしは主の宮に行くことを妨げられている。"},{"ref":"Jer.36.6","start":24036006,"end":24036006,"break":"none","ruby":[[8,1,"い"],[12,2,"だんじき"],[15,1,"ひ"],[17,1,"しゅ"],[19,1,"みや"],[26,1,"たみ"],[28,1,"き"],[46,2,"こうじゅつ"],[55,2,"まきもの"],[58,2,"ひっき"],[62,1,"しゅ"],[64,2,"ことば"],[67,1,"よ"],[78,2,"ひとびと"],[83,2,"まちまち"],[87,1,"き"],[89,1,"き"],[102,1,"よ"]],"text":"それで、あなたが行って、断食の日に主の宮で、すべての民が聞いているところで、あなたがわたしの口述にしたがって、巻物に筆記した主の言葉を読みなさい。またユダの人々がその町々から来て聞いているところで、それを読みなさい。"},{"ref":"Jer.36.7","start":24036007,"end":24036007,"break":"none","ruby":[[0,1,"かれ"],[3,1,"しゅ"],[5,1,"まえ"],[7,2,"きがん"],[20,1,"わる"],[22,1,"みち"],[24,1,"はな"],[27,1,"かえ"],[36,1,"しゅ"],[40,1,"たみ"],[42,1,"たい"],[45,2,"せんこく"],[50,1,"いか"],[53,1,"いきどお"],[56,1,"おお"]],"text":"彼らは主の前に祈願をささげ、おのおのその悪い道を離れて帰ることもあろう。主がこの民に対して宣告された怒りと憤りは大きいからである」。"},{"ref":"Jer.36.8","start":24036008,"end":24036008,"break":"none","ruby":[[8,1,"こ"],[16,3,"よげんしゃ"],[24,2,"じぶん"],[27,1,"めい"],[34,1,"しゅ"],[36,1,"みや"],[41,2,"まきもの"],[44,1,"か"],[48,1,"しゅ"],[50,2,"ことば"],[53,1,"よ"]],"text":"こうしてネリヤの子バルクはすべて預言者エレミヤが自分に命じたように、主の宮で、その巻物に書かれた主の言葉を読んだ。"},{"ref":"Jer.36.9","start":24036009,"end":24036009,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"こ"],[16,1,"ねん"],[18,1,"がつ"],[30,1,"たみ"],[36,2,"まちまち"],[46,1,"き"],[52,1,"たみ"],[56,1,"しゅ"],[58,1,"まえ"],[60,2,"だんじき"],[63,1,"おこな"],[70,1,"つ"],[72,1,"しめ"]],"text":"ユダの王ヨシヤの子エホヤキムの五年九月、エルサレムのすべての民と、ユダの町々からエルサレムに来たすべての民とは、主の前に断食を行うべきことを告げ示された。"},{"ref":"Jer.36.10","start":24036010,"end":24036010,"break":"none","ruby":[[4,1,"しゅ"],[6,1,"みや"],[8,1,"うえ"],[10,1,"にわ"],[13,1,"しゅ"],[15,1,"みや"],[17,1,"あたら"],[20,1,"もん"],[22,2,"いりぐち"],[32,2,"しょき"],[39,1,"こ"],[52,2,"まきもの"],[55,1,"か"],[64,2,"ことば"],[71,1,"たみ"],[73,1,"よ"],[75,1,"き"]],"text":"バルクは主の宮の上の庭で、主の宮の新しい門の入口のかたわらにある書記シャパンの子であるゲマリヤのへやで、巻物に書かれたエレミヤの言葉をすべての民に読み聞かせた。"},{"ref":"Jer.36.11","start":24036011,"end":24036011,"break":"paragraph","ruby":[[5,1,"こ"],[14,1,"こ"],[21,2,"まきもの"],[26,1,"しゅ"],[28,2,"ことば"],[36,1,"き"]],"text":"シャパンの子であるゲマリヤの子ミカヤはその巻物にある主の言葉をことごとく聞いて、"},{"ref":"Jer.36.12","start":24036012,"end":24036012,"break":"none","ruby":[[0,1,"おう"],[2,1,"いえ"],[6,2,"しょき"],[12,1,"くだ"],[15,1,"い"],[34,2,"しょき"],[46,1,"こ"],[56,1,"こ"],[68,1,"こ"],[79,1,"こ"],[100,1,"ざ"]],"text":"王の家にある書記のへやに下って行くと、もろもろのつかさたち、すなわち書記エリシャマ、シマヤの子デラヤ、アカボルの子エルナタン、シャパンの子ゲマリヤ、ハナニヤの子ゼデキヤおよびすべてのつかさたちがそこに座していた。"},{"ref":"Jer.36.13","start":24036013,"end":24036013,"break":"none","ruby":[[8,1,"たみ"],[10,2,"まきもの"],[13,1,"よ"],[16,1,"き"],[23,2,"じぶん"],[26,1,"き"],[33,2,"ことば"],[36,1,"かれ"],[39,1,"つ"]],"text":"ミカヤはバルクが民に巻物を読んで聞かせたとき、自分の聞いたすべての言葉を彼らに告げたので、"},{"ref":"Jer.36.14","start":24036014,"end":24036014,"break":"none","ruby":[[9,1,"こ"],[15,1,"こ"],[24,1,"こ"],[41,1,"い"],[51,1,"たみ"],[53,1,"よ"],[55,1,"き"],[61,2,"まきもの"],[64,1,"て"],[66,1,"と"],[70,1,"き"],[85,1,"こ"],[90,2,"まきもの"],[93,1,"て"],[95,1,"と"],[99,1,"かれ"],[105,1,"き"]],"text":"つかさたちはクシの子セレミヤの子であるネタニヤの子エホデをバルクのもとにつかわして言わせた、「あなたが民に読み聞かせたその巻物を手に取って、来てください」。そこでネリヤの子バルクは巻物を手に取って、彼らのもとに来たので、"},{"ref":"Jer.36.15","start":24036015,"end":24036015,"break":"none","ruby":[[0,1,"かれ"],[7,1,"い"],[12,1,"ざ"],[18,1,"よ"],[34,1,"かれ"],[37,1,"よ"]],"text":"彼らはバルクに言った、「座してそれを読んでください」。バルクはそれを彼らに読みきかせた。"},{"ref":"Jer.36.16","start":24036016,"end":24036016,"break":"none","ruby":[[0,1,"かれ"],[9,2,"ことば"],[12,1,"き"],[15,1,"おそ"],[18,1,"たがい"],[20,1,"み"],[29,1,"い"],[45,2,"ことば"],[49,1,"おう"],[51,2,"ほうこく"]],"text":"彼らはそのすべての言葉を聞き、恐れて互に見かわし、バルクに言った、「われわれはこのすべての言葉を、王に報告しなければならない」。"},{"ref":"Jer.36.17","start":24036017,"end":24036017,"break":"none","ruby":[[7,1,"たず"],[10,1,"い"],[21,2,"ことば"],[36,1,"か"],[41,1,"はな"],[49,1,"かれ"],[51,2,"こうじゅつ"]],"text":"そしてバルクに尋ねて言った、「このすべての言葉を、あなたがどのようにして書いたのか話してください。彼の口述によるのですか」。"},{"ref":"Jer.36.18","start":24036018,"end":24036018,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[12,1,"かれ"],[24,2,"ことば"],[27,2,"こうじゅつ"],[41,2,"ぼくじゅう"],[44,2,"まきもの"],[47,1,"か"]],"text":"バルクは彼らに答えた、「彼がわたしにこのすべての言葉を口述したので、わたしはそれを墨汁で巻物に書いたのです」。"},{"ref":"Jer.36.19","start":24036019,"end":24036019,"break":"none","ruby":[[10,1,"い"],[15,1,"い"],[24,2,"いっしょ"],[27,1,"み"],[29,1,"かく"],[35,1,"ひと"],[37,2,"しょざい"],[40,1,"し"]],"text":"つかさたちはバルクに言った、「行って、エレミヤと一緒に身を隠しなさい。人に所在を知られてはなりません」。"},{"ref":"Jer.36.20","start":24036020,"end":24036020,"break":"paragraph","ruby":[[3,1,"かれ"],[6,2,"まきもの"],[9,2,"しょき"],[20,1,"お"],[23,1,"にわ"],[29,1,"おう"],[34,1,"い"],[44,2,"ことば"],[47,1,"おう"],[49,1,"つ"]],"text":"そこで彼らは巻物を書記エリシャマのへやに置いて庭にはいり、王のもとへ行って、このすべての言葉を王に告げたので、"},{"ref":"Jer.36.21","start":24036021,"end":24036021,"break":"none","ruby":[[0,1,"おう"],[4,2,"まきもの"],[7,1,"も"],[31,2,"しょき"],[43,2,"まきもの"],[46,1,"と"],[55,1,"おう"],[57,1,"おう"],[64,1,"た"],[79,1,"よ"]],"text":"王はその巻物を持ってこさせるためにエホデをつかわした。エホデは書記エリシャマのへやから巻物を取ってきて、それを王と王のかたわらに立っているすべてのつかさたちに読みきかせた。"},{"ref":"Jer.36.22","start":24036022,"end":24036022,"break":"none","ruby":[[0,1,"とき"],[3,1,"がつ"],[9,1,"おう"],[11,1,"ふゆ"],[13,1,"いえ"],[15,1,"ざ"],[23,1,"まえ"],[25,1,"ろ"],[30,1,"ひ"],[32,1,"も"]],"text":"時は九月であって、王は冬の家に座していた。その前に炉があって火が燃えていた。"},{"ref":"Jer.36.23","start":24036023,"end":24036023,"break":"none","ruby":[[5,1,"だん"],[8,1,"だん"],[10,1,"よ"],[14,1,"おう"],[16,2,"こがたな"],[25,1,"き"],[27,1,"と"],[30,1,"ろ"],[32,1,"ひ"],[34,1,"な"],[42,2,"まきもの"],[44,2,"ぜんぶ"],[47,1,"ろ"],[49,1,"ひ"],[51,1,"や"]],"text":"エホデが三段か四段を読むと、王は小刀をもってそれを切り取り、炉の火に投げいれ、ついに巻物全部を炉の火で焼きつくした。"},{"ref":"Jer.36.24","start":24036024,"end":24036024,"break":"none","ruby":[[0,1,"おう"],[4,2,"けらい"],[15,2,"ことば"],[18,1,"き"],[22,1,"おそ"],[30,2,"きもの"],[33,1,"さ"]],"text":"王とその家来たちはこのすべての言葉を聞いても恐れず、またその着物を裂くこともしなかった。"},{"ref":"Jer.36.25","start":24036025,"end":24036025,"break":"none","ruby":[[17,1,"おう"],[21,2,"まきもの"],[24,1,"や"],[32,1,"ねが"],[39,1,"かれ"],[41,1,"き"]],"text":"エルナタン、デラヤおよびゲマリヤが王にその巻物を焼かないようにと願ったときにも彼は聞きいれなかった。"},{"ref":"Jer.36.26","start":24036026,"end":24036026,"break":"none","ruby":[[3,1,"おう"],[5,2,"おうじ"],[18,1,"こ"],[28,1,"こ"],[35,2,"しょき"],[41,3,"よげんしゃ"],[49,1,"とら"],[56,1,"めい"],[61,1,"しゅ"],[63,1,"かれ"],[66,1,"かく"]],"text":"そして王は王子エラメルとアヅリエルの子セラヤとアブデルの子セレミヤに、書記バルクと預言者エレミヤを捕えるようにと命じたが、主は彼らを隠された。"},{"ref":"Jer.36.27","start":24036027,"end":24036027,"break":"paragraph","ruby":[[9,2,"こうじゅつ"],[17,2,"ひっき"],[21,2,"ことば"],[24,1,"の"],[27,2,"まきもの"],[30,1,"おう"],[32,1,"や"],[35,1,"のち"],[37,1,"しゅ"],[39,2,"ことば"],[47,1,"のぞ"]],"text":"バルクがエレミヤの口述にしたがって筆記した言葉を載せた巻物を王が焼いた後、主の言葉がエレミヤに臨んだ、"},{"ref":"Jer.36.28","start":24036028,"end":24036028,"break":"none","ruby":[[1,1,"た"],[3,2,"まきもの"],[6,1,"と"],[12,1,"おう"],[19,1,"や"],[23,1,"まえ"],[25,2,"まきもの"],[33,2,"ことば"],[36,1,"みな"],[40,1,"か"]],"text":"「他の巻物を取り、ユダの王エホヤキムが焼いた、前の巻物のうちにある言葉を皆それに書きしるしなさい。"},{"ref":"Jer.36.29","start":24036029,"end":24036029,"break":"none","ruby":[[5,1,"おう"],[15,1,"い"],[22,1,"しゅ"],[26,1,"おお"],[38,2,"まきもの"],[41,1,"や"],[44,1,"い"],[59,2,"まきもの"],[68,1,"おう"],[70,1,"かなら"],[72,1,"き"],[76,1,"ち"],[78,1,"ほろ"],[86,1,"ひと"],[88,1,"けもの"],[91,1,"た"],[96,1,"か"]],"text":"またユダの王エホヤキムについて言いなさい、『主はこう仰せられる、あなたはこの巻物を焼いて言った、「どうしてあなたはこの巻物に、バビロンの王が必ず来てこの地を滅ぼし、ここから人と獣とを絶やす、と書いたのか」と。"},{"ref":"Jer.36.30","start":24036030,"end":24036030,"break":"none","ruby":[[4,1,"しゅ"],[9,1,"おう"],[21,1,"い"],[26,1,"かれ"],[28,2,"しそん"],[36,1,"くらい"],[41,1,"もの"],[50,1,"かれ"],[52,2,"したい"],[55,1,"す"],[60,1,"ひる"],[62,1,"あつ"],[68,1,"よる"],[70,1,"しも"]],"text":"それゆえ主はユダの王エホヤキムについてこう言われる、彼の子孫にはダビデの位にすわる者がなくなる。また彼の死体は捨てられて昼は暑さにあい、夜は霜にあう。"},{"ref":"Jer.36.31","start":24036031,"end":24036031,"break":"none","ruby":[[6,1,"かれ"],[10,2,"しそん"],[15,2,"けらい"],[22,1,"つみ"],[27,1,"ばっ"],[33,1,"かれ"],[42,1,"たみ"],[47,2,"ひとびと"],[51,1,"わざわい"],[53,1,"くだ"],[58,1,"わざわい"],[71,1,"かた"],[79,1,"かれ"],[82,1,"き"]],"text":"わたしはまた彼とその子孫とその家来たちをその罪のために罰する。また彼らとエルサレムの民とユダの人々には災を下す。この災のことについては、すでに語ったけれども、彼らは聞くことをしなかった』」。"},{"ref":"Jer.36.32","start":24036032,"end":24036032,"break":"paragraph","ruby":[[8,1,"た"],[10,2,"まきもの"],[13,1,"と"],[20,1,"こ"],[21,2,"しょき"],[27,1,"あた"],[40,1,"おう"],[47,1,"ひ"],[52,1,"や"],[55,2,"まきもの"],[62,2,"ことば"],[71,2,"こうじゅつ"],[82,1,"か"],[90,1,"おな"],[95,2,"ことば"],[98,1,"おお"],[103,1,"くわ"]],"text":"そこでエレミヤは他の巻物を取り、ネリヤの子書記バルクに与えたので、バルクはユダの王エホヤキムが火にくべて焼いた巻物のすべての言葉を、エレミヤの口述にしたがってそれに書きしるし、また同じような言葉を多くそれに加えた。"}]