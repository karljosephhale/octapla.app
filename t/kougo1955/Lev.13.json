[{"ref":"Lev.13.1","start":3013001,"end":3013001,"break":"paragraph","ruby":[[0,1,"しゅ"],[12,1,"い"]],"text":"主はまたモーセとアロンに言われた、"},{"ref":"Lev.13.2","start":3013002,"end":3013002,"break":"none","ruby":[[1,1,"ひと"],[5,1,"み"],[7,1,"かわ"],[9,1,"しゅ"],[15,3,"ふきでもの"],[23,1,"ひか"],[25,1,"ところ"],[35,1,"み"],[37,1,"かわ"],[41,1,"びょう"],[43,2,"かんぶ"],[57,1,"ひと"],[59,2,"さいし"],[68,2,"さいし"],[76,1,"こ"],[88,1,"つ"],[91,1,"い"]],"text":"「人がその身の皮に腫、あるいは吹出物、あるいは光る所ができ、これがその身の皮にらい病の患部のようになるならば、その人を祭司アロンまたは、祭司なるアロンの子たちのひとりのもとに、連れて行かなければならない。"},{"ref":"Lev.13.3","start":3013003,"end":3013003,"break":"none","ruby":[[0,2,"さいし"],[5,1,"み"],[7,1,"かわ"],[9,2,"かんぶ"],[12,1,"み"],[16,2,"かんぶ"],[19,1,"け"],[23,1,"しろ"],[25,1,"かわ"],[30,2,"かんぶ"],[36,1,"み"],[38,1,"かわ"],[42,1,"ふか"],[44,1,"み"],[56,1,"びょう"],[58,2,"かんぶ"],[64,2,"さいし"],[67,1,"かれ"],[69,1,"み"],[75,1,"けが"],[78,1,"もの"]],"text":"祭司はその身の皮の患部を見、その患部の毛がもし白く変り、かつ患部が、その身の皮よりも深く見えるならば、それはらい病の患部である。祭司は彼を見て、これを汚れた者としなければならない。"},{"ref":"Lev.13.4","start":3013004,"end":3013004,"break":"none","ruby":[[6,1,"み"],[8,1,"かわ"],[10,1,"ひか"],[12,1,"ところ"],[14,1,"しろ"],[18,1,"かわ"],[22,1,"ふか"],[24,1,"み"],[30,1,"け"],[32,1,"しろ"],[34,1,"かわ"],[44,2,"さいし"],[49,2,"かんじゃ"],[52,2,"なぬか"],[58,1,"と"],[60,1,"お"]],"text":"もしまたその身の皮の光る所が白くて、皮よりも深く見えず、また毛も白く変っていないならば、祭司はその患者を七日のあいだ留め置かなければならない。"},{"ref":"Lev.13.5","start":3013005,"end":3013005,"break":"none","ruby":[[0,2,"なぬか"],[2,1,"め"],[4,2,"さいし"],[10,1,"み"],[15,2,"かんぶ"],[18,2,"ようす"],[21,1,"かわ"],[29,2,"かんぶ"],[32,1,"かわ"],[34,1,"ひろ"],[45,2,"さいし"],[50,1,"ひと"],[55,2,"なぬか"],[61,1,"と"],[63,1,"お"]],"text":"七日目に祭司はこれを見て、もし患部の様子に変りがなく、また患部が皮に広がっていないならば、祭司はその人をさらに七日のあいだ留め置かなければならない。"},{"ref":"Lev.13.6","start":3013006,"end":3013006,"break":"none","ruby":[[0,2,"なぬか"],[2,1,"め"],[4,2,"さいし"],[7,1,"ふたた"],[11,1,"ひと"],[13,1,"み"],[16,2,"かんぶ"],[21,1,"うす"],[27,2,"かんぶ"],[30,1,"かわ"],[32,1,"ひろ"],[43,2,"さいし"],[49,1,"きよ"],[51,1,"もの"],[66,3,"ふきでもの"],[75,1,"ひと"],[77,2,"いふく"],[80,1,"あら"],[94,1,"きよ"]],"text":"七日目に祭司は再びその人を見て、患部がもし薄らぎ、また患部が皮に広がっていないならば、祭司はこれを清い者としなければならない。これは吹出物である。その人は衣服を洗わなければならない。そして清くなるであろう。"},{"ref":"Lev.13.7","start":3013007,"end":3013007,"break":"none","ruby":[[6,1,"ひと"],[8,2,"さいし"],[11,1,"み"],[14,1,"きよ"],[16,1,"もの"],[21,1,"のち"],[26,3,"ふきでもの"],[30,1,"かわ"],[32,1,"ひろ"],[42,1,"ふたた"],[44,2,"さいし"],[49,1,"み"],[51,1,"み"]],"text":"しかし、その人が祭司に見せて清い者とされた後に、その吹出物が皮に広くひろがるならば、再び祭司にその身を見せなければならない。"},{"ref":"Lev.13.8","start":3013008,"end":3013008,"break":"none","ruby":[[0,2,"さいし"],[6,1,"み"],[11,3,"ふきでもの"],[15,1,"かわ"],[17,1,"ひろ"],[27,2,"さいし"],[32,1,"ひと"],[34,1,"けが"],[37,1,"もの"],[54,1,"びょう"]],"text":"祭司はこれを見て、その吹出物が皮に広がっているならば、祭司はその人を汚れた者としなければならない。これはらい病である。"},{"ref":"Lev.13.9","start":3013009,"end":3013009,"break":"paragraph","ruby":[[2,1,"ひと"],[6,1,"びょう"],[8,2,"かんぶ"],[19,1,"ひと"],[21,2,"さいし"],[27,1,"つ"],[30,1,"い"]],"text":"もし人にらい病の患部があるならば、その人を祭司のもとに連れて行かなければならない。"},{"ref":"Lev.13.10","start":3013010,"end":3013010,"break":"none","ruby":[[0,2,"さいし"],[6,1,"み"],[11,1,"かわ"],[13,1,"しろ"],[15,1,"しゅ"],[22,1,"け"],[24,1,"しろ"],[26,1,"かわ"],[33,1,"しゅ"],[35,1,"い"],[38,2,"なまにく"],[41,1,"み"]],"text":"祭司がこれを見て、その皮に白い腫があり、その毛も白く変り、かつその腫に生きた生肉が見えるならば、"},{"ref":"Lev.13.11","start":3013011,"end":3013011,"break":"none","ruby":[[3,1,"ふる"],[7,1,"びょう"],[11,1,"み"],[13,1,"かわ"],[24,2,"さいし"],[29,1,"ひと"],[31,1,"けが"],[34,1,"もの"],[48,1,"ひと"],[50,1,"けが"],[53,1,"もの"],[63,1,"と"],[65,1,"お"],[68,1,"およ"]],"text":"これは古いらい病がその身の皮にあるのであるから、祭司はその人を汚れた者としなければならない。その人は汚れた者であるから、これを留め置くに及ばない。"},{"ref":"Lev.13.12","start":3013012,"end":3013012,"break":"none","ruby":[[4,1,"びょう"],[6,1,"ひろ"],[8,1,"かわ"],[10,1,"で"],[17,1,"びょう"],[22,2,"かんじゃ"],[25,1,"かわ"],[27,1,"あたま"],[30,1,"あし"],[43,2,"さいし"],[46,1,"み"],[55,1,"およ"]],"text":"もしらい病が広く皮に出て、そのらい病が、その患者の皮を頭から足まで、ことごとくおおい、祭司の見るところすべてに及んでおれば、"},{"ref":"Lev.13.13","start":3013013,"end":3013013,"break":"none","ruby":[[0,2,"さいし"],[6,1,"み"],[12,1,"びょう"],[16,1,"み"],[33,2,"かんじゃ"],[36,1,"きよ"],[38,1,"もの"],[58,1,"しろ"],[60,1,"かわ"],[66,1,"かれ"],[68,1,"きよ"],[70,1,"もの"]],"text":"祭司はこれを見、もしらい病がその身をことごとくおおっておれば、その患者を清い者としなければならない。それはことごとく白く変ったから、彼は清い者である。"},{"ref":"Lev.13.14","start":3013014,"end":3013014,"break":"none","ruby":[[6,2,"なまにく"],[11,1,"ひと"],[13,1,"あらわ"],[20,1,"けが"],[23,1,"もの"]],"text":"しかし、もし生肉がその人に現れておれば、汚れた者である。"},{"ref":"Lev.13.15","start":3013015,"end":3013015,"break":"none","ruby":[[0,2,"さいし"],[5,2,"なまにく"],[8,1,"み"],[13,1,"ひと"],[15,1,"けが"],[18,1,"もの"],[30,2,"なまにく"],[33,1,"けが"],[48,1,"びょう"]],"text":"祭司はその生肉を見て、その人を汚れた者としなければならない。生肉は汚れたものであって、それはらい病である。"},{"ref":"Lev.13.16","start":3013016,"end":3013016,"break":"none","ruby":[[6,2,"なまにく"],[9,1,"ふたた"],[11,1,"しろ"],[13,1,"かわ"],[21,1,"ひと"],[23,2,"さいし"],[29,1,"い"]],"text":"もしまたその生肉が再び白く変るならば、その人は祭司のもとに行かなければならない。"},{"ref":"Lev.13.17","start":3013017,"end":3013017,"break":"none","ruby":[[0,2,"さいし"],[5,1,"ひと"],[7,1,"み"],[14,2,"かんぶ"],[17,1,"しろ"],[19,1,"かわ"],[26,2,"さいし"],[31,2,"かんじゃ"],[34,1,"きよ"],[36,1,"もの"],[50,1,"ひと"],[52,1,"きよ"],[54,1,"もの"]],"text":"祭司はその人を見て、もしその患部が白く変っておれば、祭司はその患者を清い者としなければならない。その人は清い者である。"},{"ref":"Lev.13.18","start":3013018,"end":3013018,"break":"paragraph","ruby":[[2,1,"み"],[4,1,"かわ"],[6,2,"はれもの"],[14,1,"なお"]],"text":"また身の皮に腫物があったが、直って、"},{"ref":"Lev.13.19","start":3013019,"end":3013019,"break":"none","ruby":[[2,2,"はれもの"],[5,2,"ばしょ"],[8,1,"しろ"],[10,1,"しゅ"],[15,1,"あか"],[21,1,"しろ"],[23,1,"ひか"],[25,1,"ところ"],[34,2,"さいし"],[37,1,"み"]],"text":"その腫物の場所に白い腫、または赤みをおびた白い光る所があれば、これを祭司に見せなければならない。"},{"ref":"Lev.13.20","start":3013020,"end":3013020,"break":"none","ruby":[[0,2,"さいし"],[6,1,"み"],[11,1,"かわ"],[15,1,"ひく"],[17,1,"み"],[22,1,"け"],[24,1,"しろ"],[26,1,"かわ"],[33,2,"さいし"],[38,1,"ひと"],[40,1,"けが"],[43,1,"もの"],[58,2,"はれもの"],[61,1,"た"],[66,1,"びょう"],[68,2,"かんぶ"]],"text":"祭司はこれを見て、もし皮よりも低く見え、その毛が白く変っていれば、祭司はその人を汚れた者としなければならない。それは腫物に起ったらい病の患部だからである。"},{"ref":"Lev.13.21","start":3013021,"end":3013021,"break":"none","ruby":[[4,2,"さいし"],[10,1,"み"],[17,1,"ところ"],[19,1,"しろ"],[21,1,"け"],[28,1,"かわ"],[32,1,"ひく"],[34,1,"ところ"],[43,1,"うす"],[53,2,"さいし"],[58,1,"ひと"],[60,2,"なぬか"],[66,1,"と"],[68,1,"お"]],"text":"しかし、祭司がこれを見て、もしその所に白い毛がなく、また皮よりも低い所がなく、かえって薄らいでいるならば、祭司はその人を七日のあいだ留め置かなければならない。"},{"ref":"Lev.13.22","start":3013022,"end":3013022,"break":"none","ruby":[[5,1,"かわ"],[7,1,"ひろ"],[20,2,"さいし"],[25,1,"ひと"],[27,1,"けが"],[30,1,"もの"],[45,2,"かんぶ"]],"text":"そしてもし皮に広くひろがっているならば、祭司はその人を汚れた者としなければならない。それは患部だからである。"},{"ref":"Lev.13.23","start":3013023,"end":3013023,"break":"none","ruby":[[6,1,"ひか"],[8,1,"ところ"],[14,1,"ところ"],[21,1,"ひろ"],[32,2,"はれもの"],[35,1,"あと"],[40,2,"さいし"],[45,1,"ひと"],[47,1,"きよ"],[49,1,"もの"]],"text":"しかし、その光る所がもしその所にとどまって広がらなければ、それは腫物の跡である。祭司はその人を清い者としなければならない。"},{"ref":"Lev.13.24","start":3013024,"end":3013024,"break":"paragraph","ruby":[[2,1,"み"],[4,1,"かわ"],[20,1,"い"],[23,1,"にく"],[27,1,"あか"],[33,1,"しろ"],[41,1,"しろ"],[44,1,"ひか"],[46,1,"ところ"]],"text":"また身の皮にやけどがあって、そのやけどの生きた肉がもし赤みをおびた白、または、ただ白くて光る所となるならば、"},{"ref":"Lev.13.25","start":3013025,"end":3013025,"break":"none","ruby":[[0,2,"さいし"],[6,1,"み"],[24,1,"ひか"],[26,1,"ところ"],[30,1,"け"],[32,1,"しろ"],[34,1,"かわ"],[41,1,"かわ"],[45,1,"ふか"],[47,1,"み"],[61,1,"しょう"],[66,1,"びょう"],[71,2,"さいし"],[76,1,"ひと"],[78,1,"けが"],[81,1,"もの"],[98,1,"びょう"],[100,2,"かんぶ"]],"text":"祭司はこれを見なければならない。そしてもし、その光る所にある毛が白く変って、そこが皮よりも深く見えるならば、これはやけどに生じたらい病である。祭司はその人を汚れた者としなければならない。これはらい病の患部だからである。"},{"ref":"Lev.13.26","start":3013026,"end":3013026,"break":"none","ruby":[[4,2,"さいし"],[10,1,"み"],[15,1,"ひか"],[17,1,"ところ"],[19,1,"しろ"],[21,1,"け"],[28,1,"かわ"],[32,1,"ひく"],[34,1,"ところ"],[43,1,"うす"],[53,2,"さいし"],[58,1,"ひと"],[60,2,"なぬか"],[66,1,"と"],[68,1,"お"]],"text":"けれども祭司がこれを見て、その光る所に白い毛がなく、また皮よりも低い所がなく、かえって薄らいでいるならば、祭司はその人を七日のあいだ留め置き、"},{"ref":"Lev.13.27","start":3013027,"end":3013027,"break":"none","ruby":[[0,2,"なぬか"],[2,1,"め"],[4,2,"さいし"],[7,1,"かれ"],[9,1,"み"],[21,1,"かわ"],[23,1,"ひろ"],[36,2,"さいし"],[41,1,"ひと"],[43,1,"けが"],[46,1,"もの"],[63,1,"びょう"],[65,2,"かんぶ"]],"text":"七日目に祭司は彼を見なければならない。もし皮に広くひろがっているならば、祭司はその人を汚れた者としなければならない。これはらい病の患部だからである。"},{"ref":"Lev.13.28","start":3013028,"end":3013028,"break":"none","ruby":[[4,1,"ひか"],[6,1,"ところ"],[11,1,"ところ"],[19,1,"かわ"],[21,1,"ひろ"],[31,1,"うす"],[48,1,"しゅ"],[53,2,"さいし"],[58,1,"ひと"],[60,1,"きよ"],[62,1,"もの"],[81,1,"あと"]],"text":"もしその光る所が、その所にとどまって、皮に広がらずに、かえって薄らいでいるならば、これはやけどの腫である。祭司はその人を清い者としなければならない。これはやけどの跡だからである。"},{"ref":"Lev.13.29","start":3013029,"end":3013029,"break":"paragraph","ruby":[[0,1,"おとこ"],[5,1,"おんな"],[10,1,"あたま"],[17,2,"かんぶ"],[20,1,"しょう"]],"text":"男あるいは女がもし、頭またはあごに患部が生じたならば、"},{"ref":"Lev.13.30","start":3013030,"end":3013030,"break":"none","ruby":[[0,2,"さいし"],[5,2,"かんぶ"],[8,1,"み"],[23,1,"かわ"],[27,1,"ふか"],[29,1,"み"],[37,2,"きいろ"],[40,1,"ほそ"],[42,1,"け"],[50,2,"さいし"],[55,1,"ひと"],[57,1,"けが"],[60,1,"もの"],[84,1,"あたま"],[93,1,"びょう"]],"text":"祭司はその患部を見なければならない。もしそれが皮よりも深く見え、またそこに黄色の細い毛があるならば、祭司はその人を汚れた者としなければならない。それはかいせんであって、頭またはあごのらい病だからである。"},{"ref":"Lev.13.31","start":3013031,"end":3013031,"break":"none","ruby":[[2,2,"さいし"],[12,2,"かんぶ"],[15,1,"み"],[23,1,"かわ"],[27,1,"ふか"],[29,1,"み"],[38,1,"くろ"],[40,1,"け"],[48,2,"さいし"],[58,2,"かんじゃ"],[61,2,"なぬか"],[67,1,"と"],[69,1,"お"]],"text":"また祭司がそのかいせんの患部を見て、もしそれが皮よりも深く見えず、またそこに黒い毛がないならば、祭司はそのかいせんの患者を七日のあいだ留め置き、"},{"ref":"Lev.13.32","start":3013032,"end":3013032,"break":"none","ruby":[[0,2,"なぬか"],[2,1,"め"],[4,2,"さいし"],[9,2,"かんぶ"],[12,1,"み"],[31,1,"ひろ"],[41,2,"きいろ"],[44,1,"け"],[56,1,"かわ"],[60,1,"ふか"],[62,1,"み"]],"text":"七日目に祭司はその患部を見なければならない。そのかいせんがもし広がらず、またそこに黄色の毛がなく、そのかいせんが皮よりも深く見えないならば、"},{"ref":"Lev.13.33","start":3013033,"end":3013033,"break":"none","ruby":[[2,1,"ひと"],[4,1,"み"],[37,2,"さいし"],[49,1,"もの"],[54,2,"なぬか"],[60,1,"と"],[62,1,"お"]],"text":"その人は身をそらなければならない。ただし、そのかいせんをそってはならない。祭司はそのかいせんのある者をさらに七日のあいだ留め置き、"},{"ref":"Lev.13.34","start":3013034,"end":3013034,"break":"none","ruby":[[0,2,"なぬか"],[2,1,"め"],[4,2,"さいし"],[14,1,"み"],[33,1,"かわ"],[35,1,"ひろ"],[45,1,"かわ"],[49,1,"ふか"],[51,1,"み"],[59,2,"さいし"],[64,1,"ひと"],[66,1,"きよ"],[68,1,"もの"],[82,1,"ひと"],[88,2,"いふく"],[91,1,"あら"],[105,1,"きよ"]],"text":"七日目に祭司はそのかいせんを見なければならない。もしそのかいせんが皮に広がらず、またそれが皮よりも深く見えないならば、祭司はその人を清い者としなければならない。その人はまたその衣服を洗わなければならない。そして清くなるであろう。"},{"ref":"Lev.13.35","start":3013035,"end":3013035,"break":"none","ruby":[[6,1,"かれ"],[8,1,"きよ"],[10,1,"もの"],[15,1,"のち"],[26,1,"かわ"],[28,1,"ひろ"]],"text":"しかし、もし彼が清い者とされた後に、そのかいせんが、皮に広くひろがるならば、"},{"ref":"Lev.13.36","start":3013036,"end":3013036,"break":"none","ruby":[[0,2,"さいし"],[5,1,"ひと"],[7,1,"み"],[26,1,"かわ"],[28,1,"ひろ"],[38,2,"さいし"],[41,2,"きいろ"],[44,1,"け"],[46,1,"さが"],[56,1,"ひと"],[58,1,"けが"],[61,1,"もの"]],"text":"祭司はその人を見なければならない。もしそのかいせんが皮に広がっているならば、祭司は黄色の毛を捜すまでもなく、その人は汚れた者である。"},{"ref":"Lev.13.37","start":3013037,"end":3013037,"break":"none","ruby":[[13,2,"ようす"],[16,1,"かわ"],[24,1,"くろ"],[26,1,"け"],[28,1,"しょう"],[44,1,"なお"],[52,1,"ひと"],[54,1,"きよ"],[57,2,"さいし"],[62,1,"ひと"],[64,1,"きよ"],[66,1,"もの"]],"text":"しかし、もしそのかいせんの様子に変りなく、そこに黒い毛が生じているならば、そのかいせんは直ったので、その人は清い。祭司はその人を清い者としなければならない。"},{"ref":"Lev.13.38","start":3013038,"end":3013038,"break":"paragraph","ruby":[[2,1,"おとこ"],[7,1,"おんな"],[14,1,"み"],[16,1,"かわ"],[18,1,"ひか"],[20,1,"ところ"],[26,1,"しろ"],[28,1,"ひか"],[30,1,"ところ"]],"text":"また男あるいは女がもし、その身の皮に光る所、すなわち白い光る所があるならば、"},{"ref":"Lev.13.39","start":3013039,"end":3013039,"break":"none","ruby":[[0,2,"さいし"],[6,1,"み"],[20,1,"み"],[22,1,"かわ"],[24,1,"ひか"],[26,1,"ところ"],[29,1,"にぶ"],[31,1,"しろ"],[44,1,"はく"],[50,1,"かわ"],[52,1,"しょう"],[63,1,"ひと"],[65,1,"きよ"]],"text":"祭司はこれを見なければならない。もしその身の皮の光る所が、鈍い白であるならば、これはただ白せんがその皮に生じたのであって、その人は清い。"},{"ref":"Lev.13.40","start":3013040,"end":3013040,"break":"paragraph","ruby":[[0,1,"ひと"],[6,1,"あたま"],[9,1,"け"],[11,1,"ぬ"],[13,1,"お"],[26,1,"きよ"]],"text":"人がもしその頭から毛が抜け落ちても、それがはげならば清い。"},{"ref":"Lev.13.41","start":3013041,"end":3013041,"break":"none","ruby":[[4,1,"ひたい"],[6,1,"け"],[8,1,"ぬ"],[10,1,"お"],[18,1,"ひたい"],[25,1,"きよ"]],"text":"もしその額の毛が抜け落ちても、それが額のはげならば清い。"},{"ref":"Lev.13.42","start":3013042,"end":3013042,"break":"none","ruby":[[11,1,"あたま"],[18,1,"ひたい"],[20,1,"あか"],[26,1,"しろ"],[28,2,"かんぶ"],[44,1,"あたま"],[51,1,"ひたい"],[55,1,"びょう"],[57,1,"はっ"]],"text":"けれども、もしそのはげ頭または、はげ額に赤みをおびた白い患部があるならば、それはそのはげ頭または、はげ額にらい病が発したのである。"},{"ref":"Lev.13.43","start":3013043,"end":3013043,"break":"none","ruby":[[0,2,"さいし"],[6,1,"み"],[22,1,"あたま"],[29,1,"ひたい"],[31,2,"かんぶ"],[34,1,"しゅ"],[36,1,"しろ"],[38,1,"あか"],[45,1,"み"],[47,1,"かわ"],[51,1,"びょう"]],"text":"祭司はこれを見なければならない。もしそのはげ頭または、はげ額の患部の腫が白く赤みをおびて、身の皮にらい病があらわれているならば、"},{"ref":"Lev.13.44","start":3013044,"end":3013044,"break":"none","ruby":[[2,1,"ひと"],[6,1,"びょう"],[8,1,"おか"],[12,1,"もの"],[18,1,"けが"],[21,1,"もの"],[26,2,"さいし"],[31,1,"ひと"],[33,1,"たし"],[36,1,"けが"],[39,1,"もの"],[51,2,"かんぶ"],[54,1,"あたま"]],"text":"その人はらい病に冒された者であって、汚れた者である。祭司はその人を確かに汚れた者としなければならない。患部が頭にあるからである。"},{"ref":"Lev.13.45","start":3013045,"end":3013045,"break":"paragraph","ruby":[[0,2,"かんぶ"],[7,2,"びょうにん"],[13,2,"いふく"],[16,1,"さ"],[21,1,"あたま"],[23,1,"あらわ"],[28,1,"くち"],[37,1,"けが"],[40,1,"もの"],[42,1,"けが"],[45,1,"もの"],[48,1,"よ"]],"text":"患部のあるらい病人は、その衣服を裂き、その頭を現し、その口ひげをおおって『汚れた者、汚れた者』と呼ばわらなければならない。"},{"ref":"Lev.13.46","start":3013046,"end":3013046,"break":"none","ruby":[[2,2,"かんぶ"],[5,1,"み"],[9,1,"ひ"],[11,1,"あいだ"],[13,1,"けが"],[16,1,"もの"],[30,1,"ひと"],[32,1,"けが"],[35,1,"もの"],[42,1,"はな"],[45,1,"す"],[67,2,"しゅくえい"],[70,1,"そと"]],"text":"その患部が身にある日の間は汚れた者としなければならない。その人は汚れた者であるから、離れて住まなければならない。すなわち、そのすまいは宿営の外でなければならない。"},{"ref":"Lev.13.47","start":3013047,"end":3013047,"break":"paragraph","ruby":[[2,2,"いふく"],[7,1,"びょう"],[9,2,"かんぶ"],[12,1,"しょう"],[15,1,"とき"],[21,2,"ようもう"],[24,2,"いふく"],[30,2,"あま"],[33,2,"いふく"]],"text":"また衣服にらい病の患部が生じた時は、それが羊毛の衣服であれ、亜麻の衣服であれ、"},{"ref":"Lev.13.48","start":3013048,"end":3013048,"break":"none","ruby":[[4,2,"あま"],[9,2,"ようもう"],[12,2,"たていと"],[18,2,"よこいと"],[28,1,"かわ"],[33,1,"かわ"],[35,1,"つく"],[43,1,"もの"]],"text":"あるいは亜麻または羊毛の縦糸であれ、横糸であれ、あるいは皮であれ、皮で作ったどのような物であれ、"},{"ref":"Lev.13.49","start":3013049,"end":3013049,"break":"none","ruby":[[4,2,"いふく"],[10,1,"かわ"],[16,2,"たていと"],[23,2,"よこいと"],[30,1,"かわ"],[32,1,"つく"],[40,1,"もの"],[47,2,"かんぶ"],[50,1,"あお"],[64,1,"あか"],[81,1,"びょう"],[83,2,"かんぶ"],[92,2,"さいし"],[95,1,"み"]],"text":"もしその衣服あるいは皮、あるいは縦糸、あるいは横糸、あるいは皮で作ったどのような物であれ、その患部が青みをおびているか、あるいは赤みをおびているならば、これはらい病の患部である。これを祭司に見せなければならない。"},{"ref":"Lev.13.50","start":3013050,"end":3013050,"break":"none","ruby":[[0,2,"さいし"],[5,2,"かんぶ"],[8,1,"み"],[13,2,"かんぶ"],[18,1,"もの"],[20,2,"なぬか"],[26,1,"と"],[28,1,"お"]],"text":"祭司はその患部を見て、その患部のある物を七日のあいだ留め置き、"},{"ref":"Lev.13.51","start":3013051,"end":3013051,"break":"none","ruby":[[0,2,"なぬか"],[2,1,"め"],[4,2,"かんぶ"],[7,1,"み"],[14,2,"いふく"],[21,2,"たていと"],[28,2,"よこいと"],[35,1,"かわ"],[44,1,"もち"],[51,1,"かわ"],[56,2,"かんぶ"],[59,1,"ひろ"],[71,2,"かんぶ"],[74,2,"あくせい"],[79,1,"びょう"],[88,1,"けが"],[91,1,"もの"]],"text":"七日目に患部を見て、もしその衣服、あるいは縦糸、あるいは横糸、あるいは皮、またどのように用いられている皮であれ、患部が広がっているならば、その患部は悪性のらい病であって、それは汚れた物である。"},{"ref":"Lev.13.52","start":3013052,"end":3013052,"break":"none","ruby":[[0,1,"かれ"],[4,2,"かんぶ"],[9,2,"いふく"],[16,2,"ようもう"],[22,2,"あま"],[25,2,"たていと"],[31,2,"よこいと"],[41,1,"かわ"],[43,1,"つく"],[46,1,"もの"],[48,1,"や"],[62,2,"あくせい"],[67,1,"びょう"],[76,1,"もの"],[78,1,"ひ"],[80,1,"や"]],"text":"彼はその患部のある衣服、あるいは羊毛、または亜麻の縦糸、または横糸、あるいはすべて皮で作った物を焼かなければならない。これは悪性のらい病であるから、その物を火で焼かなければならない。"},{"ref":"Lev.13.53","start":3013053,"end":3013053,"break":"paragraph","ruby":[[4,2,"さいし"],[10,1,"み"],[15,2,"かんぶ"],[20,2,"いふく"],[27,2,"たていと"],[34,2,"よこいと"],[44,1,"かわ"],[46,1,"つく"],[49,1,"もの"],[51,1,"ひろ"]],"text":"しかし、祭司がこれを見て、もし患部がその衣服、あるいは縦糸、あるいは横糸、あるいはすべて皮で作った物に広がっていないならば、"},{"ref":"Lev.13.54","start":3013054,"end":3013054,"break":"none","ruby":[[0,2,"さいし"],[3,1,"めい"],[9,2,"かんぶ"],[14,1,"もの"],[16,1,"あら"],[23,2,"なぬか"],[26,1,"あいだ"],[30,1,"と"],[32,1,"お"]],"text":"祭司は命じて、その患部のある物を洗わせ、さらに七日の間これを留め置かなければならない。"},{"ref":"Lev.13.55","start":3013055,"end":3013055,"break":"none","ruby":[[5,2,"かんぶ"],[8,1,"あら"],[11,1,"のち"],[13,2,"さいし"],[19,1,"み"],[24,2,"かんぶ"],[27,1,"いろ"],[29,1,"かわ"],[36,2,"かんぶ"],[39,1,"ひろ"],[50,1,"けが"],[53,1,"もの"],[61,1,"ひょう"],[67,1,"うら"],[73,1,"くさ"],[84,1,"ひ"],[86,1,"や"]],"text":"そしてその患部を洗った後、祭司はそれを見て、もし患部の色が変らなければ、患部が広がらなくても、それは汚れた物である。それが表にあっても裏にあっても腐れであるから、それを火で焼かなければならない。"},{"ref":"Lev.13.56","start":3013056,"end":3013056,"break":"paragraph","ruby":[[4,2,"さいし"],[10,1,"み"],[16,1,"あら"],[19,1,"のち"],[24,2,"かんぶ"],[27,1,"うす"],[37,2,"いふく"],[44,1,"かわ"],[50,2,"たていと"],[57,2,"よこいと"],[65,1,"き"],[67,1,"と"]],"text":"しかし、祭司がこれを見て、それを洗った後に、その患部が薄らいだならば、その衣服、あるいは皮、あるいは縦糸、あるいは横糸から、それを切り取らなければならない。"},{"ref":"Lev.13.57","start":3013057,"end":3013057,"break":"none","ruby":[[8,2,"いふく"],[15,2,"たていと"],[22,2,"よこいと"],[32,1,"かわ"],[34,1,"つく"],[37,1,"もの"],[42,1,"あらわ"],[50,2,"さいはつ"],[61,2,"かんぶ"],[66,1,"もの"],[68,1,"ひ"],[70,1,"や"]],"text":"しかし、なおその衣服、あるいは縦糸、あるいは横糸、あるいはすべて皮で作った物にそれが現れれば、それは再発したのである。その患部のある物を火で焼かなければならない。"},{"ref":"Lev.13.58","start":3013058,"end":3013058,"break":"none","ruby":[[2,1,"あら"],[5,2,"いふく"],[12,2,"たていと"],[19,2,"よこいと"],[29,1,"かわ"],[31,1,"つく"],[34,1,"もの"],[38,2,"かんぶ"],[41,1,"き"],[43,1,"さ"],[49,1,"ふたた"],[54,1,"あら"],[70,1,"きよ"]],"text":"また洗った衣服、あるいは縦糸、あるいは横糸、あるいはすべて皮で作った物から、患部が消え去るならば、再びそれを洗わなければならない。そうすれば清くなるであろう」。"},{"ref":"Lev.13.59","start":3013059,"end":3013059,"break":"paragraph","ruby":[[3,2,"ようもう"],[8,2,"あま"],[11,2,"いふく"],[18,2,"たていと"],[25,2,"よこいと"],[35,1,"かわ"],[37,1,"つく"],[40,1,"もの"],[42,1,"しょう"],[47,1,"びょう"],[49,2,"かんぶ"],[59,1,"きよ"],[61,1,"もの"],[68,1,"けが"],[71,1,"もの"]],"text":"これは羊毛または亜麻の衣服、あるいは縦糸、あるいは横糸、あるいはすべて皮で作った物に生じるらい病の患部について、それを清い物とし、または汚れた物とするためのおきてである。"}]