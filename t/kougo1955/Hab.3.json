[{"ref":"Hab.3.1","start":35003001,"end":35003001,"break":"paragraph","breaks":[[12,"line"]],"ruby":[[6,1,"しら"],[12,3,"よげんしゃ"],[20,1,"いのり"]],"text":"シギヨノテの調べによる、預言者ハバククの祈。"},{"ref":"Hab.3.2","start":35003002,"end":35003002,"break":"line","breaks":[[20,"line"],[42,"line"],[57,"line"],[76,"line"]],"ruby":[[0,1,"しゅ"],[14,1,"き"],[20,1,"しゅ"],[35,1,"み"],[37,1,"おそ"],[44,1,"とし"],[52,1,"あら"],[59,1,"とし"],[67,1,"し"],[76,1,"いか"],[78,1,"とき"],[86,1,"おも"]],"text":"主よ、わたしはあなたのことを聞きました。主よ、わたしはあなたのみわざを見て恐れます。この年のうちにこれを新たにし、この年のうちにこれを知らせてください。怒る時にもあわれみを思いおこしてください。"},{"ref":"Hab.3.3","start":35003003,"end":35003003,"break":"line","breaks":[[11,"line"],[26,"line"],[37,"line"]],"ruby":[[0,1,"かみ"],[11,2,"せいじゃ"],[18,1,"やま"],[28,2,"えいこう"],[31,1,"てん"],[43,1,"ち"],[45,1,"み"]],"text":"神はテマンからこられ、聖者はパランの山からこられた。その栄光は天をおおい、そのさんびは地に満ちた。〔セラ"},{"ref":"Hab.3.4","start":35003004,"end":35003004,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[2,1,"かがや"],[5,1,"ひかり"],[15,1,"ひかり"],[17,1,"かれ"],[19,1,"て"],[34,1,"ちから"],[36,1,"かく"]],"text":"その輝きは光のようであり、その光は彼の手からほとばしる。かしこにその力を隠す。"},{"ref":"Hab.3.5","start":35003005,"end":35003005,"break":"line","ruby":[[0,2,"えきびょう"],[5,1,"まえ"],[7,1,"い"],[10,2,"ねつびょう"],[15,1,"うしろ"],[17,1,"したが"]],"text":"疫病はその前に行き、熱病はその後に従う。"},{"ref":"Hab.3.6","start":35003006,"end":35003006,"break":"line","breaks":[[12,"line"],[30,"line"],[50,"line"]],"ruby":[[0,1,"かれ"],[2,1,"た"],[6,1,"ち"],[12,1,"かれ"],[14,1,"み"],[17,1,"しょ"],[18,2,"こくみん"],[35,1,"やま"],[37,1,"ち"],[42,2,"えいえん"],[45,1,"おか"],[47,1,"しず"],[50,1,"かれ"],[52,1,"みち"],[54,1,"むかし"]],"text":"彼は立って、地をはかり、彼は見て、諸国民をおののかせられる。とこしえの山は散らされ、永遠の丘は沈む。彼の道は昔のとおりである。"},{"ref":"Hab.3.7","start":35003007,"end":35003007,"break":"line","breaks":[[22,"line"]],"ruby":[[4,1,"み"],[13,2,"てんまく"],[16,1,"なや"],[27,1,"くに"],[29,1,"まく"],[31,1,"ふる"]],"text":"わたしが見ると、クシャンの天幕に悩みがあり、ミデアンの国の幕は震う。"},{"ref":"Hab.3.8","start":35003008,"end":35003008,"break":"line","breaks":[[12,"line"],[24,"line"],[41,"line"],[54,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"うま"],[9,1,"の"],[12,2,"しょうり"],[15,2,"せんしゃ"],[18,1,"の"],[22,1,"とき"],[28,1,"かわ"],[30,1,"む"],[34,1,"いか"],[41,1,"かわ"],[43,1,"む"],[47,1,"いきどお"],[58,1,"うみ"],[60,1,"む"],[64,2,"りっぷく"]],"text":"主よ、あなたが馬に乗り、勝利の戦車に乗られる時、あなたは川に向かって怒られるのか。川に向かって憤られるのか。あるいは海に向かって立腹されるのか。"},{"ref":"Hab.3.9","start":35003009,"end":35003009,"break":"line","breaks":[[13,"line"],[28,"line"]],"ruby":[[4,1,"ゆみ"],[6,1,"と"],[8,1,"だ"],[13,1,"や"],[16,1,"つる"],[32,1,"かわ"],[37,1,"ち"],[39,1,"さ"]],"text":"あなたの弓は取り出された。矢は、弦につがえられた。〔セラあなたは川をもって地を裂かれた。"},{"ref":"Hab.3.10","start":35003010,"end":35003010,"break":"line","breaks":[[12,"line"],[23,"line"]],"ruby":[[0,2,"やまやま"],[7,1,"み"],[9,1,"ふる"],[12,1,"あ"],[14,1,"くる"],[16,1,"みず"],[18,1,"なが"],[23,1,"ふち"],[25,1,"こえ"],[27,1,"だ"],[33,1,"て"],[35,1,"たか"]],"text":"山々はあなたを見て震い、荒れ狂う水は流れいで、淵は声を出して、その手を高くあげた。"},{"ref":"Hab.3.11","start":35003011,"end":35003011,"break":"line","breaks":[[16,"line"],[38,"line"]],"ruby":[[0,1,"と"],[2,1,"ゆ"],[8,1,"や"],[10,1,"ひかり"],[16,2,"でんこう"],[38,1,"ひ"],[40,1,"つき"],[48,1,"た"],[50,1,"ど"]],"text":"飛び行くあなたの矢の光のために、電光のようにきらめく、あなたのやりのために、日も月もそのすみかに立ち止まった。"},{"ref":"Hab.3.12","start":35003012,"end":35003012,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"いきどお"],[7,1,"ち"],[9,1,"ゆ"],[15,1,"いか"],[18,1,"しょ"],[19,2,"こくみん"],[22,1,"ふ"]],"text":"あなたは憤って地を行きめぐり、怒って諸国民を踏みつけられた。"},{"ref":"Hab.3.13","start":35003013,"end":35003013,"break":"line","breaks":[[15,"line"],[38,"line"],[52,"line"]],"ruby":[[8,1,"たみ"],[10,1,"すく"],[19,1,"あぶら"],[24,1,"もの"],[26,1,"すく"],[31,1,"で"],[33,1,"い"],[42,1,"あ"],[45,1,"もの"],[47,1,"あたま"],[49,1,"くだ"],[52,1,"かれ"],[54,1,"こし"],[57,1,"くび"],[60,1,"はだか"]],"text":"あなたはあなたの民を救うため、あなたの油そそいだ者を救うために出て行かれた。あなたは悪しき者の頭を砕き、彼を腰から首まで裸にされた。〔セラ"},{"ref":"Hab.3.14","start":35003014,"end":35003014,"break":"line","breaks":[[24,"line"],[39,"line"],[49,"line"]],"ruby":[[11,2,"しょうぐん"],[14,1,"くび"],[16,1,"さ"],[24,1,"かれ"],[31,1,"ち"],[42,1,"かぜ"],[47,1,"き"],[49,1,"まず"],[52,1,"もの"],[61,1,"ほろ"],[67,1,"たの"]],"text":"あなたはあなたのやりで将軍の首を刺しとおされた。彼らはわたしを散らそうとして、つむじ風のように来、貧しい者をひそかに、のみ滅ぼすことを楽しみとした。"},{"ref":"Hab.3.15","start":35003015,"end":35003015,"break":"line","breaks":[[14,"line"]],"ruby":[[8,1,"うま"],[10,1,"つか"],[14,1,"うみ"],[16,2,"おおみず"],[27,1,"ふ"]],"text":"あなたはあなたの馬を使って、海と大水のさかまくところを踏みつけられた。"},{"ref":"Hab.3.16","start":35003016,"end":35003016,"break":"line","breaks":[[21,"line"],[41,"line"],[53,"line"],[72,"line"],[90,"line"]],"ruby":[[4,1,"き"],[32,1,"こえ"],[34,1,"き"],[37,1,"ふる"],[41,1,"くさ"],[48,1,"ほね"],[50,1,"はい"],[57,1,"あゆ"],[65,1,"した"],[81,1,"せ"],[83,1,"よ"],[86,1,"たみ"],[88,1,"うえ"],[90,1,"なや"],[93,1,"ひ"],[95,1,"のぞ"],[99,1,"しず"],[102,1,"ま"]],"text":"わたしは聞いて、わたしのからだはわななき、わたしのくちびるはその声を聞いて震える。腐れはわたしの骨に入り、わたしの歩みは、わたしの下によろめく。わたしはわれわれに攻め寄せる民の上に悩みの日の臨むのを静かに待とう。"},{"ref":"Hab.3.17","start":35003017,"end":35003017,"break":"stanza","breaks":[[12,"line"],[22,"line"],[37,"line"],[47,"line"],[56,"line"]],"ruby":[[5,1,"き"],[7,1,"はな"],[8,1,"さ"],[16,1,"き"],[18,1,"みの"],[26,1,"き"],[28,1,"さん"],[37,2,"たはた"],[40,2,"しょくもつ"],[43,1,"しょう"],[51,1,"ひつじ"],[53,1,"た"],[56,2,"ぎゅうしゃ"],[60,1,"うし"]],"text":"いちじくの木は花咲かず、ぶどうの木は実らず、オリブの木の産はむなしくなり、田畑は食物を生ぜず、おりには羊が絶え、牛舎には牛がいなくなる。"},{"ref":"Hab.3.18","start":35003018,"end":35003018,"break":"line","breaks":[[17,"line"]],"ruby":[[8,1,"しゅ"],[13,1,"たの"],[19,1,"すくい"],[21,1,"かみ"],[26,1,"よろこ"]],"text":"しかし、わたしは主によって楽しみ、わが救の神によって喜ぶ。"},{"ref":"Hab.3.19","start":35003019,"end":35003019,"break":"line","breaks":[[15,"line"],[32,"line"],[47,"stanza"],[56,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[9,1,"ちから"],[19,1,"あし"],[21,1,"め"],[25,1,"あし"],[36,1,"たか"],[38,1,"ところ"],[40,1,"あゆ"],[50,1,"こと"],[52,1,"あ"],[56,2,"せいか"],[58,1,"たい"],[60,3,"しきしゃ"],[67,1,"うた"]],"text":"主なる神はわたしの力であって、わたしの足を雌じかの足のようにし、わたしに高い所を歩ませられる。これを琴に合わせ、聖歌隊の指揮者によって歌わせる。"}]