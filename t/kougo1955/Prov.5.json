[{"ref":"Prov.5.1","start":20005001,"end":20005001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[2,1,"こ"],[9,2,"ちえ"],[12,1,"こころ"],[21,1,"さと"],[24,1,"みみ"]],"text":"わが子よ、わたしの知恵に心をとめ、わたしの悟りに耳をかたむけよ。"},{"ref":"Prov.5.2","start":20005002,"end":20005002,"break":"line","breaks":[[14,"line"]],"ruby":[[8,1,"つつし"],[11,1,"まも"],[23,2,"ちしき"],[26,1,"たも"]],"text":"これは、あなたが慎みを守り、あなたのくちびるに知識を保つためである。"},{"ref":"Prov.5.3","start":20005003,"end":20005003,"break":"line","breaks":[[16,"line"]],"ruby":[[0,2,"ゆうじょ"],[8,1,"みつ"],[18,2,"ことば"],[21,1,"あぶら"]],"text":"遊女のくちびるは蜜をしたたらせ、その言葉は油よりもなめらかである。"},{"ref":"Prov.5.4","start":20005004,"end":20005004,"break":"line","breaks":[[23,"line"]],"ruby":[[8,2,"かのじょ"],[20,1,"にが"],[25,1,"は"],[34,1,"するど"]],"text":"しかしついには、彼女はにがよもぎのように苦く、もろ刃のつるぎのように鋭くなる。"},{"ref":"Prov.5.5","start":20005005,"end":20005005,"break":"line","breaks":[[9,"line"]],"ruby":[[2,1,"あし"],[4,1,"し"],[6,1,"くだ"],[11,1,"あゆ"],[14,2,"よみ"],[17,1,"みち"]],"text":"その足は死に下り、その歩みは陰府の道におもむく。"},{"ref":"Prov.5.6","start":20005006,"end":20005006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"かのじょ"],[7,1,"みち"],[9,1,"こころ"],[17,1,"みち"],[19,1,"ひと"],[21,1,"まよ"],[26,2,"かのじょ"],[32,1,"し"]],"text":"彼女はいのちの道に心をとめず、その道は人を迷わすが、彼女はそれを知らない。"},{"ref":"Prov.5.7","start":20005007,"end":20005007,"break":"stanza","breaks":[[18,"line"]],"ruby":[[0,2,"こども"],[5,1,"いま"],[10,1,"い"],[15,1,"き"],[22,1,"くち"],[24,2,"ことば"],[29,1,"はな"],[31,1,"さ"]],"text":"子供らよ、今わたしの言うことを聞け、わたしの口の言葉から、離れ去ってはならない。"},{"ref":"Prov.5.8","start":20005008,"end":20005008,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"みち"],[6,2,"かのじょ"],[10,1,"とお"],[12,1,"はな"],[17,1,"いえ"],[19,1,"もん"],[21,1,"ちか"]],"text":"あなたの道を彼女から遠く離し、その家の門に近づいてはならない。"},{"ref":"Prov.5.9","start":20005009,"end":20005009,"break":"line","breaks":[[18,"line"]],"ruby":[[9,1,"ほまれ"],[11,2,"たにん"],[22,1,"とし"],[24,3,"むじひ"],[28,1,"もの"],[34,1,"いた"]],"text":"おそらくはあなたの誉を他人にわたし、あなたの年を無慈悲な者にわたすに至る。"},{"ref":"Prov.5.10","start":20005010,"end":20005010,"break":"line","breaks":[[23,"line"]],"ruby":[[5,2,"たにん"],[12,2,"しさん"],[18,1,"み"],[27,2,"ろうく"],[30,2,"たにん"],[33,1,"いえ"],[35,1,"い"]],"text":"おそらくは他人があなたの資産によって満たされ、あなたの労苦は他人の家に行く。"},{"ref":"Prov.5.11","start":20005011,"end":20005011,"break":"line","breaks":[[13,"line"]],"ruby":[[7,1,"おわ"],[10,1,"き"],[17,1,"み"],[24,1,"ほろ"],[30,1,"な"],[32,1,"かな"]],"text":"そしてあなたの終りが来て、あなたの身と、からだが滅びるとき、泣き悲しんで、"},{"ref":"Prov.5.12","start":20005012,"end":20005012,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"い"],[12,2,"きょうくん"],[19,1,"こころ"],[21,1,"いまし"],[24,1,"かろ"]],"text":"言うであろう、「わたしは教訓をいとい、心に戒めを軽んじ、"},{"ref":"Prov.5.13","start":20005013,"end":20005013,"break":"line","breaks":[[11,"line"]],"ruby":[[0,2,"きょうし"],[3,1,"こえ"],[5,1,"き"],[7,1,"したが"],[15,1,"おし"],[18,1,"もの"],[20,1,"みみ"],[22,1,"かたむ"]],"text":"教師の声に聞き従わず、わたしを教える者に耳を傾けず、"},{"ref":"Prov.5.14","start":20005014,"end":20005014,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"あつ"],[4,1,"なか"],[6,2,"かいしゅう"],[21,2,"はめつ"],[24,1,"おちい"]],"text":"集まりの中、会衆のうちにあって、わたしは、破滅に陥りかけた」と。"},{"ref":"Prov.5.15","start":20005015,"end":20005015,"break":"line","breaks":[[17,"line"]],"ruby":[[4,2,"じぶん"],[7,1,"みず"],[12,1,"みず"],[14,1,"の"],[17,2,"じぶん"],[20,2,"いど"],[27,1,"で"],[29,1,"みず"],[31,1,"の"]],"text":"あなたは自分の水ためから水を飲み、自分の井戸から、わき出す水を飲むがよい。"},{"ref":"Prov.5.16","start":20005016,"end":20005016,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"いずみ"],[7,1,"そと"],[15,1,"みず"],[17,1,"なが"],[25,1,"なが"]],"text":"あなたの泉を、外にまきちらし、水の流れを、ちまたに流してよかろうか。"},{"ref":"Prov.5.17","start":20005017,"end":20005017,"break":"line","breaks":[[13,"line"]],"ruby":[[3,2,"じぶん"],[13,2,"たにん"],[16,1,"とも"]],"text":"それを自分だけのものとし、他人を共にあずからせてはならない。"},{"ref":"Prov.5.18","start":20005018,"end":20005018,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"いずみ"],[6,2,"しゅくふく"],[9,1,"う"],[18,1,"わか"],[20,1,"とき"],[22,1,"つま"],[24,1,"たの"]],"text":"あなたの泉に祝福を受けさせ、あなたの若い時の妻を楽しめ。"},{"ref":"Prov.5.19","start":20005019,"end":20005019,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[0,2,"かのじょ"],[3,1,"あい"],[7,1,"め"],[11,1,"うつく"],[27,1,"ち"],[34,2,"まんぞく"],[40,1,"あい"],[45,1,"つね"],[47,1,"よろこ"]],"text":"彼女は愛らしい雌じか、美しいしかのようだ。いつも、その乳ぶさをもって満足し、その愛をもって常に喜べ。"},{"ref":"Prov.5.20","start":20005020,"end":20005020,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"こ"],[9,2,"ゆうじょ"],[12,1,"まよ"],[19,1,"おんな"],[21,1,"むね"]],"text":"わが子よ、どうして遊女に迷い、みだらな女の胸をいだくのか。"},{"ref":"Prov.5.21","start":20005021,"end":20005021,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ひと"],[2,1,"みち"],[4,1,"しゅ"],[6,1,"め"],[8,1,"まえ"],[13,1,"しゅ"],[21,1,"おこな"],[24,2,"みまも"]],"text":"人の道は主の目の前にあり、主はすべて、その行いを見守られる。"},{"ref":"Prov.5.22","start":20005022,"end":20005022,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"あ"],[3,1,"もの"],[5,2,"じぶん"],[11,1,"とら"],[16,2,"じぶん"],[19,1,"つみ"]],"text":"悪しき者は自分のとがに捕えられ、自分の罪のなわにつながれる。"},{"ref":"Prov.5.23","start":20005023,"end":20005023,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[3,2,"きょうくん"],[11,1,"し"],[16,1,"おろ"],[20,1,"おお"],[29,1,"ほろ"]],"text":"彼は、教訓がないために死に、その愚かさの大きいことによって滅びる。"}]