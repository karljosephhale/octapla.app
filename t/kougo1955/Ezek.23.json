[{"ref":"Ezek.23.1","start":26023001,"end":26023001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.23.2","start":26023002,"end":26023002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[13,1,"おんな"],[23,1,"はは"],[25,1,"むすめ"]],"text":"「人の子よ、ここにふたりの女があった。ひとりの母の娘である。"},{"ref":"Ezek.23.3","start":26023003,"end":26023003,"break":"none","ruby":[[0,1,"かれ"],[8,2,"いんこう"],[14,1,"かれ"],[17,1,"わか"],[19,1,"とき"],[21,2,"いんこう"],[33,1,"ところ"],[35,1,"かれ"],[38,1,"むね"],[40,1,"お"],[46,2,"しょじょ"],[49,1,"ち"]],"text":"彼らはエジプトで淫行をした。彼らは若い時に淫行をした。すなわちその所で彼らの胸は押され、その処女の乳ぶさはいじられた。"},{"ref":"Ezek.23.4","start":26023004,"end":26023004,"break":"none","ruby":[[0,1,"かれ"],[3,1,"な"],[5,1,"あね"],[11,1,"いもうと"],[21,1,"かれ"],[38,1,"むすめ"],[42,1,"う"],[48,2,"ほんみょう"]],"text":"彼らの名は姉はアホラ、妹はアホリバである。彼らはわたしのものとなって、むすこ娘たちを産んだ。その本名はアホラはサマリヤ、アホリバはエルサレムである。"},{"ref":"Ezek.23.5","start":26023005,"end":26023005,"break":"paragraph","ruby":[[13,1,"あいだ"],[15,2,"いんこう"],[23,2,"こいびと"]],"text":"アホラはわたしのものである間に淫行をなし、その恋人なるアッスリヤびとにこがれた。"},{"ref":"Ezek.23.6","start":26023006,"end":26023006,"break":"none","ruby":[[4,1,"むらさき"],[6,1,"ころも"],[10,2,"ぐんじん"],[13,2,"ちょうかん"],[16,2,"しれい"],[18,1,"かん"],[23,1,"この"],[27,2,"わかもの"],[30,1,"うま"],[32,1,"の"],[34,1,"もの"]],"text":"すなわち紫の衣をきた軍人、長官、司令官、すべて好ましい若者、馬に乗る者たちである。"},{"ref":"Ezek.23.7","start":26023007,"end":26023007,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"かれ"],[6,2,"いんこう"],[9,1,"そな"],[13,1,"かれ"],[27,1,"ぬ"],[30,2,"ひとびと"],[36,2,"かのじょ"],[52,1,"もの"],[59,2,"ぐうぞう"],[70,1,"けが"]],"text":"彼女は彼らに淫行を供えた。彼らはすべてアッスリヤのえり抜きの人々である。彼女はまた、そのこがれたすべての者のもろもろの偶像をもって、おのれを汚した。"},{"ref":"Ezek.23.8","start":26023008,"end":26023008,"break":"none","ruby":[[0,2,"かのじょ"],[8,1,"ひ"],[21,2,"いんこう"],[24,1,"す"],[34,2,"かのじょ"],[37,1,"わか"],[39,1,"とき"],[42,1,"かれ"],[45,2,"かのじょ"],[48,1,"ね"],[52,2,"しょじょ"],[55,1,"ち"],[65,2,"じょうよく"],[68,2,"かのじょ"],[71,1,"うえ"],[73,1,"そそ"]],"text":"彼女はエジプトの日からおこなっていた、その淫行を捨てなかった。それは彼女の若い時に、彼らが彼女と寝、その処女の乳ぶさをいじり、その情欲を彼女の上に注いだからである。"},{"ref":"Ezek.23.9","start":26023009,"end":26023009,"break":"none","ruby":[[9,2,"かのじょ"],[14,2,"こいびと"],[17,1,"て"],[19,1,"わた"],[34,2,"ひとびと"],[37,1,"て"],[39,1,"わた"]],"text":"それゆえ、わたしは彼女をその恋人の手に渡し、そのこがれたアッスリヤの人々の手に渡した。"},{"ref":"Ezek.23.10","start":26023010,"end":26023010,"break":"none","ruby":[[0,1,"かれ"],[3,2,"かのじょ"],[6,1,"はだか"],[8,1,"あらわ"],[16,1,"むすめ"],[20,1,"うば"],[30,2,"かのじょ"],[33,1,"ころ"],[41,2,"かのじょ"],[44,1,"たい"],[51,1,"おこな"],[58,2,"かのじょ"],[61,1,"おんな"],[65,1,"あいだ"],[67,1,"かた"],[69,1,"くさ"]],"text":"彼らは彼女の裸を現し、そのむすこ娘たちを奪い、つるぎをもって彼女を殺した。こうして彼女に対するさばきが行われたとき、彼女は女たちの間の語り草となった。"},{"ref":"Ezek.23.11","start":26023011,"end":26023011,"break":"paragraph","ruby":[[2,1,"いもうと"],[11,1,"み"],[14,1,"あね"],[18,2,"じょうよく"],[29,1,"あね"],[31,2,"いんこう"],[36,1,"おお"],[38,2,"いんこう"]],"text":"その妹アホリバはこれを見て、姉よりも情欲をほしいままにし、姉の淫行よりも多く淫行をなし、"},{"ref":"Ezek.23.12","start":26023012,"end":26023012,"break":"none","ruby":[[6,2,"ひとびと"],[9,1,"こい"],[15,2,"ちょうかん"],[18,2,"しれい"],[20,1,"かん"],[22,2,"せいそう"],[26,2,"ぐんじん"],[29,1,"うま"],[31,1,"の"],[33,1,"もの"],[41,1,"この"],[45,2,"わかもの"]],"text":"アッスリヤの人々に恋こがれた。長官、司令官、盛装した軍人、馬に乗る者たちで、すべて好ましい若者たちである。"},{"ref":"Ezek.23.13","start":26023013,"end":26023013,"break":"none","ruby":[[4,2,"かのじょ"],[7,1,"み"],[9,1,"けが"],[14,1,"み"],[17,1,"かれ"],[20,1,"とも"],[25,1,"みち"]],"text":"わたしは彼女が身を汚したのを見た。彼らは共に一つの道をたどったが、"},{"ref":"Ezek.23.14","start":26023014,"end":26023014,"break":"none","ruby":[[0,2,"かのじょ"],[8,2,"いんこう"],[11,1,"つづ"],[14,1,"かべ"],[16,1,"えが"],[19,2,"ひとびと"],[22,1,"み"],[29,1,"しゅ"],[31,1,"えが"],[41,1,"ぞう"]],"text":"彼女はさらにその淫行を続け、壁に描いた人々を見た。すなわち朱で描いたカルデヤびとの像で、"},{"ref":"Ezek.23.15","start":26023015,"end":26023015,"break":"none","ruby":[[0,1,"こし"],[3,1,"おび"],[5,1,"むす"],[8,1,"あたま"],[35,2,"かんり"],[41,1,"すがた"],[46,1,"うま"],[49,1,"くに"],[59,1,"ひと"],[61,1,"に"]],"text":"腰には帯を結び、頭にはたれさがったずきんをいただいていた。これらはみな官吏のような姿で、その生れた国カルデヤのバビロン人に似ていた。"},{"ref":"Ezek.23.16","start":26023016,"end":26023016,"break":"none","ruby":[[0,2,"かのじょ"],[7,1,"み"],[13,1,"こい"],[18,2,"ししゃ"],[26,1,"かれ"],[32,1,"おく"]],"text":"彼女はこれらを見て、これに恋こがれ、使者をカルデヤの彼らのもとに送った。"},{"ref":"Ezek.23.17","start":26023017,"end":26023017,"break":"none","ruby":[[8,2,"ひとびと"],[11,2,"かのじょ"],[17,1,"き"],[20,1,"こい"],[22,1,"とこ"],[27,2,"じょうよく"],[33,2,"かのじょ"],[36,1,"けが"],[41,2,"かのじょ"],[44,1,"かれ"],[47,1,"けが"],[59,1,"こころ"],[61,1,"かれ"],[65,1,"はな"]],"text":"そこでバビロンの人々は彼女のもとに来て、恋の床につき、情欲をもって彼女を汚したが、彼女は彼らに汚されるにおよんで、その心は彼らから離れた。"},{"ref":"Ezek.23.18","start":26023018,"end":26023018,"break":"none","ruby":[[0,2,"かのじょ"],[5,2,"いんこう"],[8,2,"こうぜん"],[11,1,"つづ"],[16,1,"はだか"],[29,1,"こころ"],[31,2,"かのじょ"],[35,1,"はな"],[50,1,"こころ"],[53,2,"かのじょ"],[56,1,"あね"],[59,1,"はな"],[63,2,"どうよう"]],"text":"彼女がその淫行を公然と続け、その裸をさらしたので、わたしの心は彼女から離れた。これはあたかもわたしの心が、彼女の姉から離れたと同様である。"},{"ref":"Ezek.23.19","start":26023019,"end":26023019,"break":"none","ruby":[[3,2,"かのじょ"],[13,1,"ち"],[15,2,"かんいん"],[22,1,"わか"],[24,1,"ひ"],[26,1,"おぼ"],[32,2,"いんこう"],[35,1,"つづ"]],"text":"しかし彼女はなおエジプトの地で姦淫をしたその若き日を覚えて、その淫行を続け、"},{"ref":"Ezek.23.20","start":26023020,"end":26023020,"break":"none","ruby":[[2,2,"じょうふ"],[7,1,"こい"],[15,1,"ひと"],[17,1,"にく"],[23,1,"にく"],[31,1,"せい"],[33,1,"うま"],[35,1,"せい"]],"text":"その情夫たちに恋こがれた。その人の肉は、ろばの肉のごとく、その精は馬の精のようであった。"},{"ref":"Ezek.23.21","start":26023021,"end":26023021,"break":"none","ruby":[[24,1,"むね"],[26,1,"て"],[35,1,"わか"],[37,1,"ち"],[45,1,"とき"],[48,1,"わか"],[50,1,"とき"],[52,2,"いんこう"],[55,1,"した"]],"text":"このようにあなたは、かのエジプトびとが、あなたの胸に手をつけ、あなたの若い乳ぶさをおさえた時の、若い時の淫行を慕っている」。"},{"ref":"Ezek.23.22","start":26023022,"end":26023022,"break":"paragraph","ruby":[[11,1,"しゅ"],[14,1,"かみ"],[18,1,"い"],[24,1,"み"],[36,1,"こころ"],[41,1,"はな"],[48,2,"こいびと"],[52,1,"おこ"],[60,1,"せ"],[65,1,"かれ"],[68,2,"しほう"],[72,1,"き"],[78,1,"せ"]],"text":"それゆえ、アホリバよ、主なる神はこう言われる、「見よ、わたしは、あなたの心がすでに離れたあなたの恋人らを起して、あなたを攻めさせ、彼らに四方から来てあなたを攻めさせる。"},{"ref":"Ezek.23.23","start":26023023,"end":26023023,"break":"none","ruby":[[9,2,"ひとびと"],[23,2,"ひとびと"],[47,2,"ひとびと"],[50,1,"この"],[54,2,"わかもの"],[57,2,"ちょうかん"],[60,2,"しれい"],[62,1,"かん"],[64,2,"かんり"],[67,2,"ぐんじん"],[75,1,"うま"],[77,1,"の"],[79,1,"もの"]],"text":"すなわちバビロンの人々およびカルデヤのすべての人々、ペコデ、ショア、コア、アッスリヤのすべての人々、好ましい若者、長官、司令官、官吏、軍人など、すべて馬に乗る者たちである。"},{"ref":"Ezek.23.24","start":26023024,"end":26023024,"break":"none","ruby":[[0,1,"かれ"],[3,2,"せんしゃ"],[6,2,"かしゃ"],[12,1,"おお"],[15,1,"たみ"],[17,1,"ひき"],[21,1,"きた"],[28,1,"せ"],[31,1,"く"],[34,2,"おおだて"],[37,2,"こだて"],[44,1,"そな"],[48,2,"しほう"],[56,1,"せ"],[66,1,"かれ"],[80,1,"かれ"],[90,1,"したが"]],"text":"彼らは戦車、貨車、および多くの民を率いて、北からあなたに攻めて来る。大盾、小盾、かぶとを備えて、四方からあなたに攻めかかる。わたしが彼らにさばきをゆだねるゆえ、彼らは、そのおきてに従って、あなたをさばく。"},{"ref":"Ezek.23.25","start":26023025,"end":26023025,"break":"none","ruby":[[8,1,"む"],[16,1,"いきどお"],[19,1,"おこ"],[24,1,"かれ"],[27,1,"いか"],[37,1,"あつか"],[44,1,"はな"],[46,1,"みみ"],[49,1,"き"],[51,1,"おと"],[57,1,"のこ"],[60,1,"もの"],[66,1,"たお"],[70,1,"かれ"],[80,1,"むすめ"],[84,1,"うば"],[87,1,"い"],[89,1,"のこ"],[92,1,"もの"],[94,1,"ひ"],[96,1,"や"]],"text":"わたしはあなたに向かってわたしの憤りを起すゆえ、彼らは怒りをもってあなたを扱い、あなたの鼻と耳とを切り落し、そして残りの者はつるぎに倒れる。彼らはあなたのむすこ娘たちを奪い、生き残った者を火で焼く。"},{"ref":"Ezek.23.26","start":26023026,"end":26023026,"break":"none","ruby":[[0,1,"かれ"],[9,2,"いふく"],[14,1,"と"],[21,1,"うつく"],[24,1,"かざ"],[27,1,"と"],[29,1,"さ"]],"text":"彼らはまたあなたの衣服をはぎ取り、あなたの美しい飾りを取り去る。"},{"ref":"Ezek.23.27","start":26023027,"end":26023027,"break":"none","ruby":[[12,2,"いんらん"],[21,1,"ち"],[24,1,"も"],[27,1,"き"],[29,2,"いんこう"],[33,1,"と"],[35,1,"のぞ"],[38,1,"かさ"],[45,1,"め"],[55,1,"む"],[58,1,"あ"],[64,1,"かれ"],[67,1,"こと"],[69,1,"おも"]],"text":"こうしてわたしはあなたの淫乱と、エジプトの地から持って来た淫行とを取り除き、重ねてあなたの目を、エジプトびとに向けて上げさせず、彼らの事を思わないようにする。"},{"ref":"Ezek.23.28","start":26023028,"end":26023028,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[12,1,"み"],[23,1,"にく"],[25,1,"もの"],[27,1,"て"],[33,1,"こころ"],[35,1,"はな"],[38,1,"もの"],[40,1,"て"],[46,1,"わた"]],"text":"主なる神はこう言われる、見よ、わたしはあなたの憎む者の手、あなたの心の離れた者の手にあなたを渡す。"},{"ref":"Ezek.23.29","start":26023029,"end":26023029,"break":"none","ruby":[[0,1,"かれ"],[3,1,"にく"],[14,1,"あつか"],[21,2,"しょとく"],[29,1,"と"],[31,1,"さ"],[38,1,"あか"],[49,2,"いんこう"],[52,1,"はだか"],[54,1,"あらわ"],[61,2,"いんらん"],[64,2,"いんこう"]],"text":"彼らは憎しみをもってあなたを扱い、あなたの所得をことごとく取り去り、あなたを赤はだかにし、あなたの淫行の裸を現す。あなたの淫乱と淫行とのゆえに、"},{"ref":"Ezek.23.30","start":26023030,"end":26023030,"break":"none","ruby":[[9,3,"いほうじん"],[13,1,"した"],[16,2,"かんいん"],[19,1,"おこな"],[22,1,"かれ"],[25,2,"ぐうぞう"],[31,1,"み"],[33,1,"けが"],[51,1,"のぞ"]],"text":"すなわち、あなたが異邦人を慕って姦淫を行い、彼らの偶像をもって身を汚したゆえに、これらのことがあなたに臨むのだ。"},{"ref":"Ezek.23.31","start":26023031,"end":26023031,"break":"none","ruby":[[6,1,"あね"],[8,1,"みち"],[10,1,"あゆ"],[20,2,"かのじょ"],[23,1,"さかずき"]],"text":"あなたはその姉の道を歩んだので、わたしも彼女の杯をあなたにわたす。"},{"ref":"Ezek.23.32","start":26023032,"end":26023032,"break":"none","breaks":[[12,"stanza"],[29,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[16,1,"あね"],[18,1,"ふか"],[21,1,"おお"],[24,1,"さかずき"],[26,1,"の"],[29,1,"わら"],[31,1,"もの"],[46,1,"さかずき"],[53,1,"おお"]],"text":"主なる神はこう言われる、あなたは姉の深い、大きな杯を飲み、笑い物となり、あざけりとなる、この杯にはそれらが多くこもっている。"},{"ref":"Ezek.23.33","start":26023033,"end":26023033,"break":"line","breaks":[[17,"line"],[25,"line"]],"ruby":[[4,1,"よ"],[7,1,"うれ"],[11,1,"み"],[17,1,"おどろ"],[20,1,"ほろ"],[23,1,"さかずき"],[32,1,"あね"],[38,1,"さかずき"]],"text":"あなたは酔いと憂いとに満たされる。驚きと滅びの杯、これがあなたの姉サマリヤの杯である。"},{"ref":"Ezek.23.34","start":26023034,"end":26023034,"break":"line","breaks":[[17,"line"],[31,"line"]],"ruby":[[7,1,"の"],[21,1,"かみ"],[23,1,"け"],[35,1,"ち"],[51,1,"い"],[55,1,"しゅ"],[58,1,"かみ"],[60,1,"い"]],"text":"あなたはこれを飲みこれをかたむけ、あなたの髪の毛をひきむしり、あなたの乳ぶさをかきさく。わたしがこれを言うと、主なる神は言われる。"},{"ref":"Ezek.23.35","start":26023035,"end":26023035,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[25,1,"わす"],[40,1,"す"],[42,1,"さ"],[52,2,"じぶん"],[55,2,"いんらん"],[58,2,"いんこう"],[62,1,"つみ"],[64,1,"お"]],"text":"それゆえ、主なる神はこう言われる、あなたはわたしを忘れ、わたしをあなたのうしろに捨て去ったゆえ、あなたは自分の淫乱と淫行との罪を負わねばならぬ」。"},{"ref":"Ezek.23.36","start":26023036,"end":26023036,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[12,1,"ひと"],[14,1,"こ"],[41,1,"かれ"],[46,1,"にく"],[50,1,"こと"],[52,1,"つ"]],"text":"主はわたしに言われた、「人の子よ、あなたはアホラとアホリバをさばくのか。それならば彼らにその憎むべき事を告げよ。"},{"ref":"Ezek.23.37","start":26023037,"end":26023037,"break":"none","ruby":[[0,1,"かれ"],[3,2,"かんいん"],[6,1,"おこな"],[9,1,"ち"],[11,1,"かれ"],[14,1,"て"],[16,1,"うえ"],[21,1,"かれ"],[26,2,"ぐうぞう"],[29,2,"かんいん"],[32,1,"おこな"],[41,1,"う"],[44,1,"こ"],[48,2,"しょくもつ"],[54,1,"かれ"]],"text":"彼らは姦淫を行い、血が彼らの手の上にある。彼らはその偶像と姦淫を行い、またわたしに産んだ子らを、食物のために彼らにささげた。"},{"ref":"Ezek.23.38","start":26023038,"end":26023038,"break":"none","ruby":[[3,1,"かれ"],[11,1,"たい"],[27,1,"かれ"],[30,1,"おな"],[32,1,"ひ"],[38,2,"せいじょ"],[41,1,"けが"],[48,3,"あんそくにち"],[52,1,"おか"]],"text":"さらに彼らは、わたしに対してこのようにした。すなわち、彼らは同じ日にわたしの聖所を汚し、わたしの安息日を犯した。"},{"ref":"Ezek.23.39","start":26023039,"end":26023039,"break":"none","ruby":[[0,1,"かれ"],[5,1,"こ"],[9,2,"ぐうぞう"],[23,1,"おな"],[25,1,"ひ"],[32,2,"せいじょ"],[41,1,"けが"],[45,1,"み"],[48,1,"かれ"],[55,1,"いえ"],[57,1,"なか"]],"text":"彼らはその子らを、偶像にささげるためにほふった同じ日に、わたしの聖所にきて、これを汚した。見よ、彼らがわたしの家の中でしたことはこれである。"},{"ref":"Ezek.23.40","start":26023040,"end":26023040,"break":"none","ruby":[[3,1,"かれ"],[6,2,"ししゃ"],[13,1,"とお"],[17,1,"く"],[22,2,"ひとびと"],[25,1,"まね"],[29,1,"み"],[32,1,"かれ"],[45,2,"ひとびと"],[51,1,"み"],[53,1,"あら"],[56,1,"め"],[58,1,"えが"],[61,1,"かざ"],[63,1,"もの"],[65,1,"み"]],"text":"さらに彼らは使者をやって、遠くから来るように人々を招いた。見よ、彼らはきた。あなたは、この人々のために身を洗い、目を描き、飾り物を身につけ、"},{"ref":"Ezek.23.41","start":26023041,"end":26023041,"break":"none","ruby":[[0,1,"たっと"],[2,1,"とこ"],[4,1,"ざ"],[7,2,"しょくたく"],[12,1,"まえ"],[14,1,"もう"],[21,1,"こう"],[28,1,"あぶら"],[34,1,"うえ"],[36,1,"そな"]],"text":"尊い床に座し、食卓をその前に設け、わたしの香と、わたしの油とを、その上に供えた。"},{"ref":"Ezek.23.42","start":26023042,"end":26023042,"break":"none","ruby":[[9,2,"ぐんしゅう"],[12,1,"こえ"],[14,2,"かのじょ"],[17,1,"とも"],[25,2,"あらの"],[29,1,"つ"],[32,1,"き"],[34,1,"とお"],[40,1,"よ"],[46,1,"かれ"],[49,1,"とも"],[54,1,"かれ"],[57,1,"おんな"],[61,1,"て"],[63,2,"うでわ"],[71,1,"あたま"],[73,1,"うつく"],[76,1,"かんむり"]],"text":"こうして、のんきな群衆の声は彼女と共にあり、また、荒野から連れて来た通りがかりの酔いどれも、彼らと共にいた。彼らは女たちの手に腕輪をはめさせ、頭に美しい冠をいただかせた。"},{"ref":"Ezek.23.43","start":26023043,"end":26023043,"break":"paragraph","ruby":[[7,1,"い"],[11,2,"かのじょ"],[14,2,"かんいん"],[17,1,"おこな"],[19,1,"とき"],[21,2,"ひとびと"],[24,2,"かんいん"],[27,1,"おか"]],"text":"そこでわたしは言った、彼女と姦淫を行う時、人々は姦淫を犯さないであろうか。"},{"ref":"Ezek.23.44","start":26023044,"end":26023044,"break":"none","ruby":[[0,1,"ひと"],[2,2,"ゆうじょ"],[5,1,"ところ"],[14,1,"かれ"],[17,2,"かのじょ"],[20,1,"ところ"],[31,1,"かれ"],[34,2,"かんいん"],[37,1,"おこな"],[54,1,"ところ"]],"text":"人が遊女の所にはいるように、彼らは彼女の所にはいった。こうして彼らは姦淫を行うために、アホラおよびアホリバの所にはいった。"},{"ref":"Ezek.23.45","start":26023045,"end":26023045,"break":"none","ruby":[[3,1,"ただ"],[6,2,"ひとびと"],[9,2,"いんぷ"],[17,1,"ち"],[19,1,"なが"],[22,1,"おんな"],[33,1,"かれ"],[43,1,"かれ"],[46,2,"いんぷ"],[55,1,"て"],[57,1,"ち"]],"text":"しかし正しい人々は淫婦のさばきと、血を流した女のさばきとをもって、彼らをさばく。それは彼らが淫婦であって、その手に血があるからである」。"},{"ref":"Ezek.23.46","start":26023046,"end":26023046,"break":"paragraph","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[17,2,"ぐんたい"],[20,1,"かれ"],[23,1,"む"],[27,1,"せ"],[29,1,"のぼ"],[33,1,"かれ"],[36,1,"おそ"],[39,2,"りゃくだつ"],[43,1,"わた"]],"text":"主なる神はこう言われる、「わたしは軍隊を彼らに向かって攻め上らせ、彼らを恐れと略奪とに渡す。"},{"ref":"Ezek.23.47","start":26023047,"end":26023047,"break":"none","ruby":[[0,2,"ぐんたい"],[3,1,"かれ"],[6,1,"いし"],[8,1,"う"],[15,1,"き"],[23,1,"むすめ"],[27,1,"ころ"],[30,1,"ひ"],[34,1,"いえ"],[36,1,"や"]],"text":"軍隊は彼らを石で打ち、つるぎで切り、そのむすこ娘たちを殺し、火でその家を焼く。"},{"ref":"Ezek.23.48","start":26023048,"end":26023048,"break":"none","ruby":[[10,1,"ち"],[12,2,"いんらん"],[15,1,"た"],[23,1,"おんな"],[46,2,"いんらん"],[49,1,"おこな"]],"text":"こうしてわたしはこの地に淫乱を絶やす。すべての女はみずからいましめて、あなたがたがしたような淫乱を行わない。"},{"ref":"Ezek.23.49","start":26023049,"end":26023049,"break":"none","ruby":[[6,2,"いんらん"],[9,1,"むく"],[19,1,"うえ"],[33,2,"ぐうぞう"],[35,2,"れいはい"],[38,1,"つみ"],[40,1,"お"],[50,1,"しゅ"],[53,1,"かみ"],[60,1,"し"]],"text":"あなたがたの淫乱の報いは、あなたがたの上にくだり、あなたがたはその偶像礼拝の罪を負い、そしてわたしが主なる神であることを知るようになる」。"}]