[{"ref":"Isa.65.1","start":23065001,"end":23065001,"break":"paragraph","breaks":[[16,"line"],[26,"line"],[38,"line"],[51,"line"],[72,"line"]],"ruby":[[8,1,"もと"],[14,1,"もの"],[16,1,"と"],[23,1,"よろこ"],[30,1,"たず"],[36,1,"もの"],[38,1,"み"],[47,1,"よろこ"],[57,1,"な"],[59,1,"よ"],[65,2,"こくみん"],[68,1,"い"]],"text":"わたしはわたしを求めなかった者に問われることを喜び、わたしを尋ねなかった者に見いだされることを喜んだ。わたしはわが名を呼ばなかった国民に言った、「わたしはここにいる、わたしはここにいる」と。"},{"ref":"Isa.65.2","start":23065002,"end":23065002,"break":"line","breaks":[[9,"line"],[24,"line"]],"ruby":[[4,1,"みち"],[6,1,"あゆ"],[9,2,"じぶん"],[12,1,"おも"],[15,1,"したが"],[21,1,"たみ"],[32,1,"て"],[34,1,"の"],[37,1,"まね"]],"text":"よからぬ道に歩み、自分の思いに従うそむける民に、わたしはひねもす手を伸べて招いた。"},{"ref":"Isa.65.3","start":23065003,"end":23065003,"break":"line","breaks":[[19,"line"],[30,"line"]],"ruby":[[2,1,"たみ"],[9,1,"つね"],[15,1,"いか"],[19,1,"その"],[21,1,"なか"],[23,2,"ぎせい"],[34,1,"うえ"],[36,1,"こう"]],"text":"この民はまのあたり常にわたしを怒らせ、園の中で犠牲をささげ、かわらの上で香をたき、"},{"ref":"Isa.65.4","start":23065004,"end":23065004,"break":"line","breaks":[[17,"line"],[25,"line"]],"ruby":[[0,2,"はかば"],[11,1,"ところ"],[17,1,"ぶた"],[19,1,"にく"],[21,1,"く"],[25,1,"にく"],[29,1,"もの"],[39,1,"うつわ"],[41,1,"も"]],"text":"墓場にすわり、ひそかな所にやどり、豚の肉を食らい、憎むべき物の、あつものをその器に盛って、"},{"ref":"Isa.65.5","start":23065005,"end":23065005,"break":"line","breaks":[[15,"line"],[29,"line"],[50,"line"]],"ruby":[[0,1,"い"],[11,1,"た"],[19,1,"ちか"],[37,2,"くべつ"],[56,1,"はな"],[58,1,"けむり"],[64,1,"も"],[67,1,"ひ"]],"text":"言う、「あなたはそこに立って、わたしに近づいてはならない。わたしはあなたと区別されたものだから」と。これらはわが鼻の煙、ひねもす燃える火である。"},{"ref":"Isa.65.6","start":23065006,"end":23065006,"break":"line","breaks":[[17,"line"],[34,"line"]],"ruby":[[0,1,"み"],[5,1,"こと"],[9,1,"まえ"],[22,1,"だま"],[29,1,"むく"],[31,1,"かえ"],[42,1,"かれ"]],"text":"見よ、この事はわが前にしるされた、「わたしは黙っていないで報い返す。そうだ、わたしは彼らのふところに、"},{"ref":"Isa.65.7","start":23065007,"end":23065007,"break":"line","breaks":[[19,"line"],[26,"line"],[38,"line"],[53,"line"],[70,"line"]],"ruby":[[0,1,"かれ"],[3,2,"ふぎ"],[7,1,"かれ"],[10,2,"せんぞ"],[15,2,"ふぎ"],[19,1,"とも"],[21,1,"むく"],[23,1,"かえ"],[26,1,"かれ"],[29,1,"やま"],[31,1,"うえ"],[33,1,"こう"],[38,1,"おか"],[40,1,"うえ"],[57,1,"かれ"],[66,1,"はか"],[77,1,"かえ"],[81,1,"しゅ"],[83,1,"い"]],"text":"彼らの不義と、彼らの先祖たちの不義とを共に報い返す。彼らが山の上で香をたき、丘の上でわたしをそしったゆえ、わたしは彼らのさきのわざを量って、そのふところに返す」と主は言われる。"},{"ref":"Isa.65.8","start":23065008,"end":23065008,"break":"paragraph","breaks":[[9,"line"],[22,"line"],[39,"line"],[63,"line"],[87,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"い"],[10,1,"ひと"],[19,1,"なか"],[33,1,"み"],[43,1,"やぶ"],[49,1,"なか"],[51,2,"しゅくふく"],[60,1,"い"],[83,1,"おこな"],[93,1,"ほろ"]],"text":"主はこう言われる、「人がぶどうのふさの中に、ぶどうのしるのあるのを見るならば、『それを破るな、その中に祝福があるから』と言う。そのようにわたしは、わがしもべらのために行って、ことごとくは滅ぼさない。"},{"ref":"Isa.65.9","start":23065009,"end":23065009,"break":"line","breaks":[[16,"line"],[37,"line"],[54,"line"]],"ruby":[[9,2,"しそん"],[22,2,"やまやま"],[25,1,"う"],[31,1,"もの"],[41,1,"えら"],[44,1,"もの"],[49,1,"う"],[64,1,"す"]],"text":"わたしはヤコブから子孫をいだし、ユダからわが山々を受けつぐべき者をいだす。わたしが選んだ者はこれを受けつぎ、わがしもべらはそこに住む。"},{"ref":"Isa.65.10","start":23065010,"end":23065010,"break":"line","breaks":[[16,"line"],[35,"line"]],"ruby":[[5,1,"ひつじ"],[7,1,"む"],[10,2,"まきば"],[20,1,"たに"],[22,1,"うし"],[24,1,"む"],[27,1,"ふ"],[29,1,"ところ"],[39,1,"たず"],[41,1,"もと"],[46,1,"たみ"]],"text":"シャロンは羊の群れの牧場となり、アコルの谷は牛の群れの伏す所となって、わたしを尋ね求めたわが民のものとなる。"},{"ref":"Isa.65.11","start":23065011,"end":23065011,"break":"line","breaks":[[8,"line"],[18,"line"],[28,"line"],[39,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"す"],[10,1,"せい"],[13,1,"やま"],[15,1,"わす"],[18,1,"つくえ"],[20,2,"かふく"],[23,1,"かみ"],[25,1,"そな"],[28,1,"ま"],[30,1,"あ"],[34,1,"さけ"],[36,1,"も"],[39,2,"うんめい"],[42,1,"かみ"]],"text":"しかし主を捨て、わが聖なる山を忘れ、机を禍福の神に供え、混ぜ合わせた酒を盛って運命の神にささげるあなたがたよ、"},{"ref":"Isa.65.12","start":23065012,"end":23065012,"break":"line","breaks":[[11,"line"],[24,"line"],[41,"line"],[61,"line"],[75,"line"],[90,"line"]],"ruby":[[15,1,"わた"],[20,1,"さだ"],[30,1,"みな"],[51,1,"よ"],[57,1,"こた"],[65,1,"かた"],[71,1,"き"],[79,1,"め"],[81,1,"わる"],[83,1,"こと"],[94,1,"この"],[100,1,"こと"],[102,1,"えら"]],"text":"わたしは、あなたがたをつるぎに渡すことに定めた。あなたがたは皆かがんでほふられる。あなたがたはわたしが呼んだときに答えず、わたしが語ったときに聞かず、わたしの目に悪い事をおこない、わたしの好まなかった事を選んだからだ」。"},{"ref":"Isa.65.13","start":23065013,"end":23065013,"break":"paragraph","breaks":[[17,"line"],[33,"line"],[47,"line"],[61,"line"],[75,"line"],[89,"line"]],"ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[18,1,"み"],[29,1,"た"],[43,1,"う"],[47,1,"み"],[58,1,"の"],[75,1,"み"],[86,1,"よろこ"],[99,1,"は"]],"text":"それゆえ、主なる神はこう言われる、「見よ、わがしもべたちは食べる、しかし、あなたがたは飢える。見よ、わがしもべたちは飲む、しかし、あなたがたはかわく。見よ、わがしもべたちは喜ぶ、しかし、あなたがたは恥じる。"},{"ref":"Isa.65.14","start":23065014,"end":23065014,"break":"line","breaks":[[23,"line"],[45,"line"]],"ruby":[[0,1,"み"],[11,1,"こころ"],[13,1,"たの"],[20,1,"うた"],[33,1,"こころ"],[35,1,"くる"],[42,1,"さけ"],[50,1,"なや"],[56,1,"な"],[58,1,"さけ"]],"text":"見よ、わがしもべたちは心の楽しみによって歌う、しかし、あなたがたは心の苦しみによって叫び、たましいの悩みによって泣き叫ぶ。"},{"ref":"Isa.65.15","start":23065015,"end":23065015,"break":"line","breaks":[[10,"line"],[29,"line"],[45,"line"],[60,"line"]],"ruby":[[6,1,"のこ"],[8,1,"な"],[12,1,"えら"],[15,1,"もの"],[23,2,"もんく"],[29,1,"しゅ"],[32,1,"かみ"],[40,1,"ころ"],[63,1,"な"],[68,1,"よ"]],"text":"あなたがたの残す名はわが選んだ者には、のろいの文句となり、主なる神はあなたがたを殺される。しかし、おのれのしもべたちを、ほかの名をもって呼ばれる。"},{"ref":"Isa.65.16","start":23065016,"end":23065016,"break":"line","breaks":[[10,"line"],[26,"line"],[44,"line"],[65,"line"]],"ruby":[[5,1,"ち"],[17,2,"しゅくふく"],[20,1,"もと"],[23,1,"もの"],[26,2,"しんじつ"],[29,1,"かみ"],[38,2,"しゅくふく"],[41,1,"もと"],[44,1,"ち"],[49,1,"ちか"],[51,1,"もの"],[54,2,"しんじつ"],[57,1,"かみ"],[62,1,"ちか"],[68,1,"なや"],[71,1,"わす"],[80,1,"め"],[83,1,"かく"]],"text":"それゆえ、地にあっておのれのために祝福を求める者は、真実の神によっておのれの祝福を求め、地にあって誓う者は、真実の神をさして誓う。さきの悩みは忘れられて、とわが目から隠れうせるからである。"},{"ref":"Isa.65.17","start":23065017,"end":23065017,"break":"paragraph","breaks":[[24,"line"],[40,"line"]],"ruby":[[0,1,"み"],[7,1,"あたら"],[10,1,"てん"],[13,1,"あたら"],[16,1,"ち"],[19,2,"そうぞう"],[27,1,"こと"],[40,1,"こころ"],[42,1,"おも"],[44,1,"おこ"]],"text":"見よ、わたしは新しい天と、新しい地とを創造する。さきの事はおぼえられることなく、心に思い起すことはない。"},{"ref":"Isa.65.18","start":23065018,"end":23065018,"break":"line","breaks":[[24,"line"],[39,"line"],[60,"line"]],"ruby":[[14,2,"そうぞう"],[29,1,"たの"],[33,1,"よろこ"],[36,1,"え"],[39,1,"み"],[52,1,"つく"],[55,1,"よろこ"],[62,1,"たみ"],[64,1,"たの"]],"text":"しかし、あなたがたはわたしの創造するものにより、とこしえに楽しみ、喜びを得よ。見よ、わたしはエルサレムを造って喜びとし、その民を楽しみとする。"},{"ref":"Isa.65.19","start":23065019,"end":23065019,"break":"line","breaks":[[21,"line"]],"ruby":[[10,1,"よろこ"],[15,1,"たみ"],[17,1,"たの"],[21,1,"な"],[23,1,"こえ"],[25,1,"さけ"],[27,1,"こえ"],[29,1,"ふたた"],[33,1,"なか"],[35,1,"きこ"]],"text":"わたしはエルサレムを喜び、わが民を楽しむ。泣く声と叫ぶ声は再びその中に聞えることはない。"},{"ref":"Isa.65.20","start":23065020,"end":23065020,"break":"line","breaks":[[14,"line"],[31,"line"],[42,"line"],[60,"line"]],"ruby":[[3,2,"すうじつ"],[6,1,"し"],[17,1,"いのち"],[19,1,"ひ"],[21,1,"み"],[26,2,"ろうじん"],[36,1,"なか"],[43,1,"さい"],[45,1,"し"],[47,1,"もの"],[52,1,"わか"],[54,1,"もの"],[61,1,"さい"],[63,1,"し"],[65,1,"もの"],[73,1,"つみ"]],"text":"わずか数日で死ぬみどりごと、おのが命の日を満たさない老人とは、もはやその中にいない。百歳で死ぬ者も、なお若い者とせられ、百歳で死ぬ者は、のろわれた罪びととされる。"},{"ref":"Isa.65.21","start":23065021,"end":23065021,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かれ"],[3,1,"いえ"],[5,1,"た"],[12,1,"す"],[18,1,"ばたけ"],[20,1,"つく"],[26,1,"み"],[28,1,"た"]],"text":"彼らは家を建てて、それに住み、ぶどう畑を作って、その実を食べる。"},{"ref":"Isa.65.22","start":23065022,"end":23065022,"break":"line","breaks":[[18,"line"],[38,"line"],[55,"line"],[63,"line"]],"ruby":[[0,1,"かれ"],[3,1,"た"],[6,1,"ところ"],[12,1,"ひと"],[14,1,"す"],[18,1,"かれ"],[21,1,"う"],[31,1,"ひと"],[33,1,"た"],[40,1,"たみ"],[42,1,"いのち"],[45,1,"き"],[47,1,"いのち"],[57,1,"えら"],[60,1,"もの"],[65,1,"て"],[73,1,"たの"]],"text":"彼らが建てる所に、ほかの人は住まず、彼らが植えるものは、ほかの人が食べない。わが民の命は、木の命のようになり、わが選んだ者は、その手のわざをながく楽しむからである。"},{"ref":"Isa.65.23","start":23065023,"end":23065023,"break":"line","breaks":[[12,"line"],[31,"line"],[50,"line"]],"ruby":[[0,1,"かれ"],[3,2,"きんろう"],[14,1,"う"],[20,1,"こ"],[23,1,"わざわい"],[31,1,"かれ"],[34,1,"しゅ"],[36,2,"しゅくふく"],[41,1,"もの"],[52,1,"こ"],[55,1,"かれ"],[58,1,"とも"]],"text":"彼らの勤労はむだでなく、その生むところの子らは災にかからない。彼らは主に祝福された者のすえであって、その子らも彼らと共におるからである。"},{"ref":"Isa.65.24","start":23065024,"end":23065024,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かれ"],[3,1,"よ"],[15,1,"こた"],[18,1,"かれ"],[23,1,"かた"],[36,1,"き"]],"text":"彼らが呼ばないさきに、わたしは答え、彼らがなお語っているときに、わたしは聞く。"},{"ref":"Isa.65.25","start":23065025,"end":23065025,"break":"line","breaks":[[15,"line"],[30,"line"],[42,"line"],[65,"line"]],"ruby":[[5,2,"こひつじ"],[9,1,"とも"],[11,1,"く"],[18,1,"うし"],[26,1,"く"],[36,2,"しょくもつ"],[42,1,"かれ"],[47,1,"せい"],[50,1,"やま"],[75,1,"しゅ"],[77,1,"い"]],"text":"おおかみと小羊とは共に食らい、ししは牛のようにわらを食らい、へびはちりを食物とする。彼らはわが聖なる山のどこでもそこなうことなく、やぶることはない」と主は言われる。"}]