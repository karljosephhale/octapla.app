[{"ref":"1Chr.6.1","start":13006001,"end":13006001,"break":"paragraph","ruby":[[3,1,"こ"]],"text":"レビの子らはゲルション、コハテ、メラリ。"},{"ref":"1Chr.6.2","start":13006002,"end":13006002,"break":"none","ruby":[[4,1,"こ"]],"text":"コハテの子らはアムラム、イヅハル、ヘブロン、ウジエル。"},{"ref":"1Chr.6.3","start":13006003,"end":13006003,"break":"none","ruby":[[5,1,"こ"],[25,1,"こ"]],"text":"アムラムの子らはアロン、モーセ、ミリアム。アロンの子らはナダブ、アビウ、エレアザル、イタマル。"},{"ref":"1Chr.6.4","start":13006004,"end":13006004,"break":"none","ruby":[[11,1,"う"],[25,1,"う"]],"text":"エレアザルはピネハスを生み、ピネハスはアビシュアを生み、"},{"ref":"1Chr.6.5","start":13006005,"end":13006005,"break":"none","ruby":[[10,1,"う"],[20,1,"う"]],"text":"アビシュアはブッキを生み、ブッキはウジを生み、"},{"ref":"1Chr.6.6","start":13006006,"end":13006006,"break":"none","ruby":[[8,1,"う"],[21,1,"う"]],"text":"ウジはゼラヒヤを生み、ゼラヒヤはメラヨテを生み、"},{"ref":"1Chr.6.7","start":13006007,"end":13006007,"break":"none","ruby":[[10,1,"う"],[23,1,"う"]],"text":"メラヨテはアマリヤを生み、アマリヤはアヒトブを生み、"},{"ref":"1Chr.6.8","start":13006008,"end":13006008,"break":"none","ruby":[[9,1,"う"],[22,1,"う"]],"text":"アヒトブはザドクを生み、ザドクはアヒマアズを生み、"},{"ref":"1Chr.6.9","start":13006009,"end":13006009,"break":"none","ruby":[[11,1,"う"],[24,1,"う"]],"text":"アヒマアズはアザリヤを生み、アザリヤはヨナハンを生み、"},{"ref":"1Chr.6.10","start":13006010,"end":13006010,"break":"none","ruby":[[10,1,"う"],[32,1,"た"],[35,1,"みや"],[37,2,"さいし"],[40,1,"つとめ"],[44,1,"もの"]],"text":"ヨナハンはアザリヤを生んだ。このアザリヤはソロモンがエルサレムに建てた宮で祭司の務をした者である。"},{"ref":"1Chr.6.11","start":13006011,"end":13006011,"break":"none","ruby":[[10,1,"う"],[23,1,"う"]],"text":"アザリヤはアマリヤを生み、アマリヤはアヒトブを生み、"},{"ref":"1Chr.6.12","start":13006012,"end":13006012,"break":"none","ruby":[[9,1,"う"],[21,1,"う"]],"text":"アヒトブはザトクを生み、ザトクはシャルムを生み、"},{"ref":"1Chr.6.13","start":13006013,"end":13006013,"break":"none","ruby":[[10,1,"う"],[23,1,"う"]],"text":"シャルムはヒルキヤを生み、ヒルキヤはアザリヤを生み、"},{"ref":"1Chr.6.14","start":13006014,"end":13006014,"break":"none","ruby":[[9,1,"う"],[21,1,"う"]],"text":"アザリヤはセラヤを生み、セラヤはヨザダクを生んだ。"},{"ref":"1Chr.6.15","start":13006015,"end":13006015,"break":"none","ruby":[[5,1,"しゅ"],[15,1,"て"],[29,1,"ひと"],[31,1,"とら"],[33,1,"うつ"],[37,1,"とき"],[39,1,"とら"],[44,1,"い"]],"text":"ヨザダクは主がネブカデネザルの手によってユダとエルサレムの人を捕え移された時に捕えられて行った。"},{"ref":"1Chr.6.16","start":13006016,"end":13006016,"break":"paragraph","ruby":[[3,1,"こ"]],"text":"レビの子らはゲルション、コハテおよびメラリ。"},{"ref":"1Chr.6.17","start":13006017,"end":13006017,"break":"none","ruby":[[6,1,"こ"],[9,1,"な"]],"text":"ゲルションの子らの名はリブニとシメイ。"},{"ref":"1Chr.6.18","start":13006018,"end":13006018,"break":"none","ruby":[[4,1,"こ"]],"text":"コハテの子らはアムラム、イヅハル、ヘブロン、ウジエルである。"},{"ref":"1Chr.6.19","start":13006019,"end":13006019,"break":"none","ruby":[[4,1,"こ"],[25,2,"いえすじ"],[30,2,"しぞく"]],"text":"メラリの子らはマヘリとムシ。これらはレビびとのその家筋による氏族である。"},{"ref":"1Chr.6.20","start":13006020,"end":13006020,"break":"none","ruby":[[6,1,"こ"],[14,1,"こ"],[22,1,"こ"]],"text":"ゲルションの子はリブニ、その子はヤハテ、その子はジンマ、"},{"ref":"1Chr.6.21","start":13006021,"end":13006021,"break":"none","ruby":[[2,1,"こ"],[9,1,"こ"],[16,1,"こ"],[23,1,"こ"]],"text":"その子はヨア、その子はイド、その子はゼラ、その子はヤテライ。"},{"ref":"1Chr.6.22","start":13006022,"end":13006022,"break":"none","ruby":[[4,1,"こ"],[14,1,"こ"],[21,1,"こ"]],"text":"コハテの子はアミナダブ、その子はコラ、その子はアシル、"},{"ref":"1Chr.6.23","start":13006023,"end":13006023,"break":"none","ruby":[[2,1,"こ"],[11,1,"こ"],[21,1,"こ"]],"text":"その子はエルカナ、その子はエビアサフ、その子はアシル、"},{"ref":"1Chr.6.24","start":13006024,"end":13006024,"break":"none","ruby":[[2,1,"こ"],[10,1,"こ"],[19,1,"こ"],[27,1,"こ"]],"text":"その子はタハテ、その子はウリエル、その子はウジヤ、その子はシャウル。"},{"ref":"1Chr.6.25","start":13006025,"end":13006025,"break":"none","ruby":[[5,1,"こ"]],"text":"エルカナの子らはアマサイとアヒモテ、"},{"ref":"1Chr.6.26","start":13006026,"end":13006026,"break":"none","ruby":[[2,1,"こ"],[11,1,"こ"],[19,1,"こ"]],"text":"その子はエルカナ、その子はゾパイ、その子はナハテ、"},{"ref":"1Chr.6.27","start":13006027,"end":13006027,"break":"none","ruby":[[2,1,"こ"],[11,1,"こ"],[20,1,"こ"]],"text":"その子はエリアブ、その子はエロハム、その子はエルカナ。"},{"ref":"1Chr.6.28","start":13006028,"end":13006028,"break":"none","ruby":[[5,1,"こ"],[9,2,"ちょうし"],[16,1,"つぎ"]],"text":"サムエルの子らは、長子はヨエル、次はアビヤ。"},{"ref":"1Chr.6.29","start":13006029,"end":13006029,"break":"none","ruby":[[4,1,"こ"],[12,1,"こ"],[20,1,"こ"],[28,1,"こ"]],"text":"メラリの子はマヘリ、その子はリブニ、その子はシメイ、その子はウザ、"},{"ref":"1Chr.6.30","start":13006030,"end":13006030,"break":"none","ruby":[[2,1,"こ"],[10,1,"こ"],[18,1,"こ"]],"text":"その子はシメア、その子はハギヤ、その子はアサヤである。"},{"ref":"1Chr.6.31","start":13006031,"end":13006031,"break":"paragraph","ruby":[[0,2,"けいやく"],[3,1,"はこ"],[5,2,"あんち"],[16,1,"しゅ"],[18,1,"みや"],[20,1,"うた"],[25,1,"こと"],[34,2,"ひとびと"],[37,1,"つぎ"]],"text":"契約の箱を安置したのち、ダビデが主の宮で歌をうたう事をつかさどらせた人々は次のとおりである。"},{"ref":"1Chr.6.32","start":13006032,"end":13006032,"break":"none","ruby":[[0,1,"かれ"],[3,2,"かいけん"],[6,2,"まくや"],[9,1,"まえ"],[11,1,"うた"],[16,1,"つか"],[32,1,"しゅ"],[34,1,"みや"],[36,1,"た"],[43,2,"いってい"],[46,2,"ちつじょ"],[49,1,"したが"],[52,1,"つとめ"],[54,1,"おこな"]],"text":"彼らは会見の幕屋の前で歌をもって仕えたが、ソロモンがエルサレムに主の宮を建ててからは、一定の秩序に従って務を行った。"},{"ref":"1Chr.6.33","start":13006033,"end":13006033,"break":"none","ruby":[[2,1,"つとめ"],[14,1,"こ"],[17,1,"つぎ"],[32,1,"こ"],[41,1,"うた"],[46,1,"もの"],[56,1,"こ"],[67,1,"こ"]],"text":"その務をしたもの、およびその子らは次のとおりである。コハテびとの子らのうちヘマンは歌をうたう者、ヘマンはヨエルの子、ヨエルはサムエルの子、"},{"ref":"1Chr.6.34","start":13006034,"end":13006034,"break":"none","ruby":[[10,1,"こ"],[22,1,"こ"],[34,1,"こ"],[44,1,"こ"]],"text":"サムエルはエルカナの子、エルカナはエロハムの子、エロハムはエリエルの子、エリエルはトアの子、"},{"ref":"1Chr.6.35","start":13006035,"end":13006035,"break":"none","ruby":[[6,1,"こ"],[16,1,"こ"],[27,1,"こ"],[38,1,"こ"]],"text":"トアはヅフの子、ヅフはエルカナの子、エルカナはマハテの子、マハテはアマサイの子、"},{"ref":"1Chr.6.36","start":13006036,"end":13006036,"break":"none","ruby":[[10,1,"こ"],[21,1,"こ"],[32,1,"こ"],[44,1,"こ"]],"text":"アマサイはエルカナの子、エルカナはヨエルの子、ヨエルはアザリヤの子、アザリヤはゼパニヤの子、"},{"ref":"1Chr.6.37","start":13006037,"end":13006037,"break":"none","ruby":[[9,1,"こ"],[19,1,"こ"],[31,1,"こ"],[42,1,"こ"]],"text":"ゼパニヤはタハテの子、タハテはアシルの子、アシルはエビアサフの子、エビアサフはコラの子、"},{"ref":"1Chr.6.38","start":13006038,"end":13006038,"break":"none","ruby":[[8,1,"こ"],[19,1,"こ"],[28,1,"こ"],[39,1,"こ"]],"text":"コラはイヅハルの子、イヅハルはコハテの子、コハテはレビの子、レビはイスラエルの子である。"},{"ref":"1Chr.6.39","start":13006039,"end":13006039,"break":"none","ruby":[[4,2,"きょうだい"],[14,1,"みぎ"],[16,1,"た"],[29,1,"こ"],[40,1,"こ"]],"text":"ヘマンの兄弟アサフはヘマンの右に立った。アサフはベレキヤの子、ベレキヤはシメアの子、"},{"ref":"1Chr.6.40","start":13006040,"end":13006040,"break":"none","ruby":[[9,1,"こ"],[21,1,"こ"],[33,1,"こ"]],"text":"シメアはミカエルの子、ミカエルはバアセヤの子、バアセヤはマルキヤの子、"},{"ref":"1Chr.6.41","start":13006041,"end":13006041,"break":"none","ruby":[[9,1,"こ"],[18,1,"こ"],[27,1,"こ"]],"text":"マルキヤはエテニの子、エテニはゼラの子、ゼラはアダヤの子、"},{"ref":"1Chr.6.42","start":13006042,"end":13006042,"break":"none","ruby":[[8,1,"こ"],[18,1,"こ"],[28,1,"こ"]],"text":"アダヤはエタンの子、エタンはジンマの子、ジンマはシメイの子、"},{"ref":"1Chr.6.43","start":13006043,"end":13006043,"break":"none","ruby":[[8,1,"こ"],[20,1,"こ"],[31,1,"こ"]],"text":"シメイはヤハテの子、ヤハテはゲルションの子、ゲルションはレビの子である。"},{"ref":"1Chr.6.44","start":13006044,"end":13006044,"break":"none","ruby":[[2,1,"かれ"],[5,2,"きょうだい"],[14,1,"こ"],[17,1,"ひだり"],[19,1,"た"],[35,1,"こ"],[44,1,"こ"],[54,1,"こ"]],"text":"また彼らの兄弟であるメラリの子らが左に立った。そのうちのエタンはキシの子、キシはアブデの子、アブデはマルクの子、"},{"ref":"1Chr.6.45","start":13006045,"end":13006045,"break":"none","ruby":[[10,1,"こ"],[23,1,"こ"],[35,1,"こ"]],"text":"マルクはハシャビヤの子、ハシャビヤはアマジヤの子、アマジヤはヒルキヤの子、"},{"ref":"1Chr.6.46","start":13006046,"end":13006046,"break":"none","ruby":[[9,1,"こ"],[18,1,"こ"],[27,1,"こ"]],"text":"ヒルキヤはアムジの子、アムジはバニの子、バニはセメルの子、"},{"ref":"1Chr.6.47","start":13006047,"end":13006047,"break":"none","ruby":[[8,1,"こ"],[17,1,"こ"],[26,1,"こ"],[35,1,"こ"]],"text":"セメルはマヘリの子、マヘリはムシの子、ムシはメラリの子、メラリはレビの子である。"},{"ref":"1Chr.6.48","start":13006048,"end":13006048,"break":"none","ruby":[[0,1,"かれ"],[3,2,"きょうだい"],[16,1,"かみ"],[18,1,"みや"],[20,2,"まくや"],[28,1,"つとめ"],[30,1,"にん"]],"text":"彼らの兄弟であるレビびとたちは、神の宮の幕屋のもろもろの務に任じられた。"},{"ref":"1Chr.6.49","start":13006049,"end":13006049,"break":"paragraph","ruby":[[6,1,"こ"],[9,2,"はんさい"],[12,1,"だん"],[14,1,"こう"],[16,2,"さいだん"],[19,1,"うえ"],[33,3,"しせいじょ"],[70,1,"かみ"],[79,1,"めい"]],"text":"アロンとその子らは燔祭の壇と香の祭壇の上にささげることをなし、また至聖所のすべてのわざをなし、かつイスラエルのためにあがないをなした。すべて神のしもべモーセの命じたとおりである。"},{"ref":"1Chr.6.50","start":13006050,"end":13006050,"break":"none","ruby":[[4,2,"しそん"],[7,1,"つぎ"],[20,1,"こ"],[30,1,"こ"],[39,1,"こ"]],"text":"アロンの子孫は次のとおりである。アロンの子はエレアザル、その子はピネハス、その子はアビシュア、"},{"ref":"1Chr.6.51","start":13006051,"end":13006051,"break":"none","ruby":[[2,1,"こ"],[10,1,"こ"],[17,1,"こ"]],"text":"その子はブッキ、その子はウジ、その子はゼラヒヤ、"},{"ref":"1Chr.6.52","start":13006052,"end":13006052,"break":"none","ruby":[[2,1,"こ"],[11,1,"こ"],[20,1,"こ"]],"text":"その子はメラヨテ、その子はアマリヤ、その子はアヒトブ、"},{"ref":"1Chr.6.53","start":13006053,"end":13006053,"break":"none","ruby":[[2,1,"こ"],[10,1,"こ"]],"text":"その子はザドク、その子はアヒマアズである。"},{"ref":"1Chr.6.54","start":13006054,"end":13006054,"break":"paragraph","ruby":[[4,2,"しそん"],[7,1,"す"],[9,1,"ところ"],[13,1,"さかい"],[20,2,"しゅくえい"],[29,1,"つぎ"],[46,2,"しぞく"],[55,1,"え"]],"text":"アロンの子孫の住む所はその境のうちにある宿営によっていえば次のとおりである。まずコハテびとの氏族がくじによって得たところ、"},{"ref":"1Chr.6.55","start":13006055,"end":13006055,"break":"none","ruby":[[4,1,"かれ"],[7,1,"あた"],[20,1,"ち"],[31,2,"しゅうい"],[34,2,"ほうぼく"],[36,1,"ち"]],"text":"すなわち彼らが与えられたところは、ユダの地にあるヘブロンとその周囲の放牧地である。"},{"ref":"1Chr.6.56","start":13006056,"end":13006056,"break":"none","ruby":[[6,1,"まち"],[8,2,"たはた"],[13,2,"むらむら"],[22,1,"こ"],[27,1,"あた"]],"text":"ただし、その町の田畑とその村々は、エフンネの子カレブに与えられた。"},{"ref":"1Chr.6.57","start":13006057,"end":13006057,"break":"none","ruby":[[7,2,"しそん"],[10,1,"あた"],[23,1,"まち"],[40,2,"ほうぼく"],[42,1,"ち"],[59,2,"ほうぼく"],[61,1,"ち"]],"text":"そしてアロンの子孫に与えられたものは、のがれの町であるヘブロンおよびリブナとその放牧地、ヤッテルおよびエシテモアとその放牧地、"},{"ref":"1Chr.6.58","start":13006058,"end":13006058,"break":"none","ruby":[[6,2,"ほうぼく"],[8,1,"ち"],[16,2,"ほうぼく"],[18,1,"ち"]],"text":"ヒレンとその放牧地、デビルとその放牧地、"},{"ref":"1Chr.6.59","start":13006059,"end":13006059,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[19,2,"ほうぼく"],[21,1,"ち"]],"text":"アシャンとその放牧地、ベテシメシとその放牧地である。"},{"ref":"1Chr.6.60","start":13006060,"end":13006060,"break":"none","ruby":[[8,2,"ぶぞく"],[21,2,"ほうぼく"],[23,1,"ち"],[32,2,"ほうぼく"],[34,1,"ち"],[43,2,"ほうぼく"],[45,1,"ち"],[47,1,"あた"],[53,1,"かれ"],[56,1,"まち"],[64,2,"しぞく"]],"text":"またベニヤミンの部族のうちからはゲバとその放牧地、アレメテとその放牧地、アナトテとその放牧地を与えられた。彼らの町は、すべてその氏族のうちに十三あった。"},{"ref":"1Chr.6.61","start":13006061,"end":13006061,"break":"paragraph","ruby":[[6,2,"しそん"],[9,1,"のこ"],[12,1,"もの"],[14,2,"ぶぞく"],[17,2,"しぞく"],[26,1,"はん"],[27,2,"ぶぞく"],[37,1,"はん"],[38,2,"ぶぞく"],[51,1,"じゅう"],[53,1,"まち"],[55,1,"あた"]],"text":"またコハテの子孫の残りの者は部族の氏族のうちからと、半部族すなわちマナセの半部族のうちからくじによって十の町を与えられた。"},{"ref":"1Chr.6.62","start":13006062,"end":13006062,"break":"none","ruby":[[8,2,"しそん"],[13,2,"しぞく"],[25,2,"ぶぞく"],[32,2,"ぶぞく"],[40,2,"ぶぞく"],[55,2,"ぶぞく"],[65,1,"まち"],[67,1,"あた"]],"text":"またゲルションの子孫はその氏族によってイッサカルの部族、アセルの部族、ナフタリの部族、およびバシャンのマナセの部族のうちから十三の町が与えられた。"},{"ref":"1Chr.6.63","start":13006063,"end":13006063,"break":"none","ruby":[[4,2,"しそん"],[9,2,"しぞく"],[19,2,"ぶぞく"],[25,2,"ぶぞく"],[36,2,"ぶぞく"],[52,1,"まち"],[54,1,"あた"]],"text":"メラリの子孫はその氏族によってルベンの部族、ガドの部族、およびゼブルンの部族のうちからくじによって十二の町が与えられた。"},{"ref":"1Chr.6.64","start":13006064,"end":13006064,"break":"none","ruby":[[11,2,"ひとびと"],[19,2,"まちまち"],[24,2,"ほうぼく"],[26,1,"ち"],[29,1,"あた"]],"text":"このようにイスラエルの人々はレビびとに町々とその放牧地とを与えた。"},{"ref":"1Chr.6.65","start":13006065,"end":13006065,"break":"none","ruby":[[7,2,"しそん"],[10,2,"ぶぞく"],[18,2,"ぶぞく"],[21,2,"しそん"],[31,2,"しそん"],[34,2,"ぶぞく"],[44,1,"な"],[53,1,"まち"],[61,1,"あた"]],"text":"すなわちユダの子孫の部族とシメオンの部族の子孫と、ベニヤミンの子孫の部族のうちからここに名をあげたこれらの町をくじによって与えた。"},{"ref":"1Chr.6.66","start":13006066,"end":13006066,"break":"paragraph","ruby":[[4,2,"しそん"],[7,2,"しぞく"],[18,2,"ぶぞく"],[26,2,"まちまち"],[29,1,"え"],[33,2,"りょうち"]],"text":"コハテの子孫の氏族はまたエフライムの部族のうちからも町々を獲てその領地とした。"},{"ref":"1Chr.6.67","start":13006067,"end":13006067,"break":"none","ruby":[[4,1,"かれ"],[7,1,"あた"],[17,1,"まち"],[25,2,"さんち"],[36,2,"ほうぼく"],[38,1,"ち"],[46,2,"ほうぼく"],[48,1,"ち"]],"text":"すなわち彼らが与えられた、のがれの町はエフライムの山地にあるシケムとその放牧地、ゲゼルとその放牧地、"},{"ref":"1Chr.6.68","start":13006068,"end":13006068,"break":"none","ruby":[[8,2,"ほうぼく"],[10,1,"ち"],[20,2,"ほうぼく"],[22,1,"ち"]],"text":"ヨクメアムとその放牧地、ベテホロンとその放牧地、"},{"ref":"1Chr.6.69","start":13006069,"end":13006069,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[20,2,"ほうぼく"],[22,1,"ち"]],"text":"アヤロンとその放牧地、ガテリンモンとその放牧地である。"},{"ref":"1Chr.6.70","start":13006070,"end":13006070,"break":"none","ruby":[[6,1,"はん"],[7,2,"ぶぞく"],[22,2,"ほうぼく"],[24,1,"ち"],[35,2,"ほうぼく"],[37,1,"ち"],[44,2,"しそん"],[47,2,"しぞく"],[50,1,"のこ"],[56,1,"あた"]],"text":"またマナセの半部族のうちからは、アネルとその放牧地およびビレアムとその放牧地を、コハテの子孫の氏族の残りのものに与えた。"},{"ref":"1Chr.6.71","start":13006071,"end":13006071,"break":"paragraph","ruby":[[6,2,"しそん"],[9,1,"あた"],[21,1,"はん"],[22,2,"ぶぞく"],[41,2,"ほうぼく"],[43,1,"ち"],[53,2,"ほうぼく"],[55,1,"ち"]],"text":"ゲルションの子孫に与えられたものはマナセの半部族のうちからはバシャンのゴランとその放牧地、アシタロテとその放牧地。"},{"ref":"1Chr.6.72","start":13006072,"end":13006072,"break":"none","ruby":[[6,2,"ぶぞく"],[20,2,"ほうぼく"],[22,1,"ち"],[31,2,"ほうぼく"],[33,1,"ち"]],"text":"イッサカルの部族のうちからはケデシとその放牧地、ダベラテとその放牧地、"},{"ref":"1Chr.6.73","start":13006073,"end":13006073,"break":"none","ruby":[[6,2,"ほうぼく"],[8,1,"ち"],[16,2,"ほうぼく"],[18,1,"ち"]],"text":"ラモテとその放牧地、アネムとその放牧地。"},{"ref":"1Chr.6.74","start":13006074,"end":13006074,"break":"none","ruby":[[4,2,"ぶぞく"],[19,2,"ほうぼく"],[21,1,"ち"],[30,2,"ほうぼく"],[32,1,"ち"]],"text":"アセルの部族のうちからはマシャルとその放牧地、アブドンとその放牧地、"},{"ref":"1Chr.6.75","start":13006075,"end":13006075,"break":"none","ruby":[[6,2,"ほうぼく"],[8,1,"ち"],[16,2,"ほうぼく"],[18,1,"ち"]],"text":"ホコクとその放牧地、レホブとその放牧地。"},{"ref":"1Chr.6.76","start":13006076,"end":13006076,"break":"none","ruby":[[5,2,"ぶぞく"],[24,2,"ほうぼく"],[26,1,"ち"],[35,2,"ほうぼく"],[37,1,"ち"],[48,2,"ほうぼく"],[50,1,"ち"]],"text":"ナフタリの部族のうちからはガリラヤのケデシとその放牧地、ハンモンとその放牧地、キリアタイムとその放牧地である。"},{"ref":"1Chr.6.77","start":13006077,"end":13006077,"break":"none","ruby":[[16,2,"しそん"],[19,1,"あた"],[32,2,"ぶぞく"],[46,2,"ほうぼく"],[48,1,"ち"],[56,2,"ほうぼく"],[58,1,"ち"]],"text":"このほかのもの、すなわちメラリの子孫に与えられたものはゼブルンの部族のうちからリンモンとその放牧地、タボルとその放牧地、"},{"ref":"1Chr.6.78","start":13006078,"end":13006078,"break":"none","ruby":[[4,1,"ちか"],[24,1,"ひがし"],[31,2,"ぶぞく"],[39,2,"あらの"],[48,2,"ほうぼく"],[50,1,"ち"],[57,2,"ほうぼく"],[59,1,"ち"]],"text":"エリコに近いヨルダンのかなた、すなわちヨルダンの東ではルベンの部族のうちからは荒野のベゼルとその放牧地、ヤザとその放牧地、"},{"ref":"1Chr.6.79","start":13006079,"end":13006079,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[18,2,"ほうぼく"],[20,1,"ち"]],"text":"ケデモテとその放牧地、メパアテとその放牧地。"},{"ref":"1Chr.6.80","start":13006080,"end":13006080,"break":"none","ruby":[[3,2,"ぶぞく"],[22,2,"ほうぼく"],[24,1,"ち"],[34,2,"ほうぼく"],[36,1,"ち"]],"text":"ガドの部族のうちからはギレアデのラモテとその放牧地、マハナイムとその放牧地、"},{"ref":"1Chr.6.81","start":13006081,"end":13006081,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[17,2,"ほうぼく"],[19,1,"ち"]],"text":"ヘシボンとその放牧地、ヤゼルとその放牧地である。"}]