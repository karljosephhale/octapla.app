[{"ref":"2Kgs.16.1","start":12016001,"end":12016001,"break":"paragraph","ruby":[[5,1,"こ"],[9,1,"だい"],[12,1,"ねん"],[17,1,"おう"],[22,1,"こ"],[27,1,"おう"]],"text":"レマリヤの子ペカの第十七年にユダの王ヨタムの子アハズが王となった。"},{"ref":"2Kgs.16.2","start":12016002,"end":12016002,"break":"none","ruby":[[4,1,"おう"],[9,1,"とき"],[12,1,"さい"],[23,1,"ねん"],[25,1,"あいだ"],[27,1,"よ"],[29,1,"おさ"],[36,1,"かみ"],[38,1,"しゅ"],[40,1,"め"],[45,1,"こと"],[47,2,"せんぞ"],[57,1,"おこな"]],"text":"アハズは王となった時二十歳で、エルサレムで十六年の間、世を治めたが、その神、主の目にかなう事を先祖ダビデのようには行わなかった。"},{"ref":"2Kgs.16.3","start":12016003,"end":12016003,"break":"none","ruby":[[0,1,"かれ"],[8,1,"おう"],[12,1,"みち"],[14,1,"あゆ"],[19,1,"しゅ"],[27,2,"ひとびと"],[30,1,"まえ"],[33,1,"お"],[35,1,"はら"],[39,3,"いほうじん"],[43,1,"にく"],[58,2,"じぶん"],[61,1,"こ"],[63,1,"ひ"],[65,1,"や"],[71,1,"もの"]],"text":"彼はイスラエルの王たちの道に歩み、また主がイスラエルの人々の前から追い払われた異邦人の憎むべきおこないにしたがって、自分の子を火に焼いてささげ物とした。"},{"ref":"2Kgs.16.4","start":12016004,"end":12016004,"break":"none","ruby":[[2,1,"かれ"],[4,1,"たか"],[6,1,"ところ"],[10,1,"おか"],[12,1,"うえ"],[18,1,"あお"],[19,1,"き"],[21,1,"した"],[23,2,"ぎせい"],[30,1,"こう"]],"text":"かつ彼は高き所、また丘の上、すべての青木の下で犠牲をささげ、香をたいた。"},{"ref":"2Kgs.16.5","start":12016005,"end":12016005,"break":"paragraph","ruby":[[9,1,"おう"],[21,1,"こ"],[31,1,"おう"],[41,1,"せ"],[43,1,"のぼ"],[51,1,"かこ"],[56,1,"か"]],"text":"そのころ、スリヤの王レヂンおよびレマリヤの子であるイスラエルの王ペカがエルサレムに攻め上って、アハズを囲んだが、勝つことができなかった。"},{"ref":"2Kgs.16.6","start":12016006,"end":12016006,"break":"none","ruby":[[2,1,"とき"],[7,1,"おう"],[13,2,"かいふく"],[21,2,"しょりょう"],[29,2,"ひとびと"],[37,1,"お"],[39,1,"だ"],[62,1,"す"],[65,2,"こんにち"],[68,1,"いた"]],"text":"その時エドムの王はエラテを回復してエドムの所領とし、ユダの人々をエラテから追い出した。そしてエドムびとがエラテにきて、そこに住み、今日に至っている。"},{"ref":"2Kgs.16.7","start":12016007,"end":12016007,"break":"none","ruby":[[7,2,"ししゃ"],[16,1,"おう"],[31,1,"い"],[53,1,"こ"],[61,1,"おう"],[69,1,"おう"],[75,1,"せ"],[77,1,"かこ"],[87,1,"のぼ"],[93,1,"かれ"],[96,1,"て"],[103,1,"すく"],[105,1,"だ"]],"text":"そこでアハズは使者をアッスリヤの王テグラテピレセルにつかわして言わせた、「わたしはあなたのしもべ、あなたの子です。スリヤの王とイスラエルの王がわたしを攻め囲んでいます。どうぞ上ってきて、彼らの手からわたしを救い出してください」。"},{"ref":"2Kgs.16.8","start":12016008,"end":12016008,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"みや"],[11,1,"おう"],[13,1,"いえ"],[15,1,"くら"],[19,1,"きん"],[21,1,"ぎん"],[29,1,"おく"],[31,1,"もの"],[41,1,"おう"]],"text":"そしてアハズは主の宮と王の家の倉にある金と銀をとり、これを贈り物としてアッスリヤの王におくったので、"},{"ref":"2Kgs.16.9","start":12016009,"end":12016009,"break":"none","ruby":[[6,1,"おう"],[8,1,"かれ"],[10,1,"ねが"],[13,1,"き"],[29,1,"おう"],[36,1,"せ"],[38,1,"のぼ"],[45,1,"と"],[50,1,"たみ"],[55,1,"とら"],[57,1,"うつ"],[66,1,"ころ"]],"text":"アッスリヤの王は彼の願いを聞きいれた。すなわちアッスリヤの王はダマスコに攻め上って、これを取り、その民をキルに捕え移し、またレヂンを殺した。"},{"ref":"2Kgs.16.10","start":12016010,"end":12016010,"break":"paragraph","ruby":[[3,1,"おう"],[11,1,"おう"],[21,1,"あ"],[30,1,"い"],[42,2,"さいだん"],[45,1,"み"],[53,1,"おう"],[57,2,"さいだん"],[60,1,"つく"],[71,1,"くわ"],[74,2,"ずめん"],[80,1,"がた"],[83,1,"つく"],[87,2,"さいし"],[93,1,"おく"]],"text":"アハズ王はアッスリヤの王テグラテピレセルに会おうとダマスコへ行ったが、ダマスコにある祭壇を見たので、アハズ王はその祭壇の作りにしたがって、その詳しい図面と、ひな型とを作って、祭司ウリヤに送った。"},{"ref":"2Kgs.16.11","start":12016011,"end":12016011,"break":"none","ruby":[[3,2,"さいし"],[12,1,"おう"],[20,1,"おく"],[31,2,"さいだん"],[34,1,"た"],[42,2,"さいし"],[51,1,"おう"],[59,1,"かえ"],[70,1,"つく"]],"text":"そこで祭司ウリヤはアハズ王がダマスコから送ったものにしたがって祭壇を建てた。すなわち祭司ウリヤはアハズ王がダマスコから帰るまでにそのとおりに作った。"},{"ref":"2Kgs.16.12","start":12016012,"end":12016012,"break":"none","ruby":[[0,1,"おう"],[8,1,"かえ"],[16,2,"さいだん"],[19,1,"み"],[21,2,"さいだん"],[24,1,"ちか"],[30,1,"うえ"],[32,1,"のぼ"]],"text":"王はダマスコから帰ってきて、その祭壇を見、祭壇に近づいてその上に登り、"},{"ref":"2Kgs.16.13","start":12016013,"end":12016013,"break":"none","ruby":[[0,2,"はんさい"],[3,2,"そさい"],[6,1,"や"],[9,2,"かんさい"],[12,1,"そそ"],[15,3,"しゅうおんさい"],[19,1,"ち"],[21,2,"さいだん"]],"text":"燔祭と素祭を焼き、灌祭を注ぎ、酬恩祭の血を祭壇にそそぎかけた。"},{"ref":"2Kgs.16.14","start":12016014,"end":12016014,"break":"none","ruby":[[0,1,"かれ"],[4,1,"しゅ"],[6,1,"まえ"],[11,2,"せいどう"],[14,2,"さいだん"],[17,1,"みや"],[19,1,"まえ"],[22,1,"うつ"],[33,1,"あたら"],[36,2,"さいだん"],[39,1,"しゅ"],[41,1,"みや"],[43,1,"あいだ"],[46,1,"うつ"],[50,1,"あたら"],[53,2,"さいだん"],[56,1,"きた"],[58,1,"ほう"]],"text":"彼はまた主の前にあった青銅の祭壇を宮の前から移した。すなわちそれを新しい祭壇と主の宮の間から移して、新しい祭壇の北の方にすえた。"},{"ref":"2Kgs.16.15","start":12016015,"end":12016015,"break":"none","ruby":[[6,1,"おう"],[8,2,"さいし"],[14,1,"めい"],[17,1,"い"],[22,1,"あさ"],[24,2,"はんさい"],[27,1,"ゆう"],[29,2,"そさい"],[34,1,"おう"],[36,2,"はんさい"],[41,2,"そさい"],[48,2,"くにぢゅう"],[51,1,"たみ"],[53,2,"はんさい"],[58,2,"そさい"],[63,2,"かんさい"],[69,1,"おお"],[72,2,"さいだん"],[75,1,"うえ"],[77,1,"や"],[85,2,"はんさい"],[88,1,"ち"],[90,2,"ぎせい"],[93,1,"ち"],[112,2,"せいどう"],[115,2,"さいだん"],[122,1,"うかが"],[125,1,"た"],[130,1,"もち"]],"text":"そしてアハズ王は祭司ウリヤに命じて言った、「朝の燔祭と夕の素祭および王の燔祭とその素祭、ならびに国中の民の燔祭とその素祭および灌祭は、この大きな祭壇の上で焼きなさい。また燔祭の血と犠牲の血はすべてこれにそそぎかけなさい。あの青銅の祭壇をわたしは伺いを立てるのに用いよう」。"},{"ref":"2Kgs.16.16","start":12016016,"end":12016016,"break":"none","ruby":[[0,2,"さいし"],[9,1,"おう"],[14,1,"めい"]],"text":"祭司ウリヤはアハズ王がすべて命じたとおりにおこなった。"},{"ref":"2Kgs.16.17","start":12016017,"end":12016017,"break":"paragraph","ruby":[[5,1,"おう"],[7,1,"だい"],[9,2,"かがみいた"],[12,1,"き"],[14,1,"と"],[18,2,"せんばん"],[23,1,"うえ"],[26,1,"うつ"],[31,1,"うみ"],[35,1,"した"],[39,2,"せいどう"],[42,1,"うし"],[44,1,"うえ"],[52,1,"いし"],[54,1,"ざ"],[56,1,"うえ"]],"text":"またアハズ王は台の鏡板を切り取って、洗盤をその上から移し、また海をその下にある青銅の牛の上からおろして、石の座の上にすえ、"},{"ref":"2Kgs.16.18","start":12016018,"end":12016018,"break":"none","ruby":[[2,1,"みや"],[7,1,"つく"],[13,3,"あんそくにち"],[16,1,"よう"],[24,1,"みち"],[29,1,"おう"],[31,1,"もち"],[34,1,"そと"],[36,2,"いりぐち"],[45,1,"おう"],[50,1,"しゅ"],[52,1,"みや"],[55,1,"のぞ"]],"text":"また宮のうちに造られていた安息日用のおおいのある道、および王の用いる外の入口をアッスリヤの王のために主の宮から除いた。"},{"ref":"2Kgs.16.19","start":12016019,"end":12016019,"break":"none","ruby":[[6,1,"た"],[8,2,"じせき"],[15,1,"おう"],[17,3,"れきだいし"],[21,1,"しょ"]],"text":"アハズのその他の事績は、ユダの王の歴代志の書にしるされているではないか。"},{"ref":"2Kgs.16.20","start":12016020,"end":12016020,"break":"none","ruby":[[4,2,"せんぞ"],[9,1,"とも"],[11,1,"ねむ"],[19,1,"まち"],[23,2,"せんぞ"],[28,1,"とも"],[30,1,"ほうむ"],[36,1,"こ"],[42,1,"かわ"],[45,1,"おう"]],"text":"アハズは先祖たちと共に眠って、ダビデの町にその先祖たちと共に葬られ、その子ヒゼキヤが代って王となった。"}]