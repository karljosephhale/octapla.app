[{"ref":"Neh.12.1","start":16012001,"end":16012001,"break":"paragraph","ruby":[[6,1,"こ"],[20,2,"いっしょ"],[23,1,"のぼ"],[28,2,"さいし"],[36,1,"つぎ"]],"text":"シャルテルの子ゼルバベルおよびエシュアと一緒に上ってきた祭司とレビびとは次のとおりである。すなわちセラヤ、エレミヤ、エズラ、"},{"ref":"Neh.12.2","start":16012002,"end":16012002,"break":"none","text":"アマリヤ、マルク、ハットシ、"},{"ref":"Neh.12.3","start":16012003,"end":16012003,"break":"none","text":"シカニヤ、レホム、メレモテ、"},{"ref":"Neh.12.4","start":16012004,"end":16012004,"break":"none","text":"イド、ギンネトイ、アビヤ、"},{"ref":"Neh.12.5","start":16012005,"end":16012005,"break":"none","text":"ミヤミン、マアデヤ、ビルガ、"},{"ref":"Neh.12.6","start":16012006,"end":16012006,"break":"none","text":"シマヤ、ヨヤリブ、エダヤ、"},{"ref":"Neh.12.7","start":16012007,"end":16012007,"break":"none","ruby":[[22,1,"もの"],[29,2,"じだい"],[32,2,"さいし"],[39,2,"きょうだい"]],"text":"サライ、アモク、ヒルキヤ、エダヤで、これらの者はエシュアの時代に祭司およびその兄弟らのかしらであった。"},{"ref":"Neh.12.8","start":16012008,"end":16012008,"break":"paragraph","ruby":[[45,2,"きょうだい"],[49,1,"とも"],[51,2,"かんしゃ"]],"text":"レビびとではエシュア、ビンヌイ、カデミエル、セレビヤ、ユダ、マッタニヤで、マッタニヤはその兄弟らと共に感謝のことをつかさどった。"},{"ref":"Neh.12.9","start":16012009,"end":16012009,"break":"none","ruby":[[2,1,"かれ"],[5,2,"きょうだい"],[22,1,"かれ"],[25,1,"む"],[29,1,"た"],[32,1,"つと"]],"text":"また彼らの兄弟であるバグブキヤおよびウンノは彼らの向かいに立って勤めをした。"},{"ref":"Neh.12.10","start":16012010,"end":16012010,"break":"none","ruby":[[5,1,"こ"],[17,1,"こ"],[31,1,"こ"]],"text":"エシュアの子はヨアキム、ヨアキムの子はエリアシブ、エリアシブの子はヨイアダ、"},{"ref":"Neh.12.11","start":16012011,"end":16012011,"break":"none","ruby":[[5,1,"こ"],[17,1,"こ"]],"text":"ヨイアダの子はヨナタン、ヨナタンの子はヤドアである。"},{"ref":"Neh.12.12","start":16012012,"end":16012012,"break":"paragraph","ruby":[[5,2,"じだい"],[8,2,"さいし"],[11,2,"しぞく"],[14,1,"ちょう"],[19,1,"もの"],[25,2,"しぞく"],[38,2,"しぞく"]],"text":"ヨアキムの時代に祭司で氏族の長であった者はセラヤの氏族ではメラヤ、エレミヤの氏族ではハナニヤ、"},{"ref":"Neh.12.13","start":16012013,"end":16012013,"break":"none","ruby":[[4,2,"しぞく"],[19,2,"しぞく"]],"text":"エズラの氏族ではメシュラム、アマリヤの氏族ではヨハナン、"},{"ref":"Neh.12.14","start":16012014,"end":16012014,"break":"none","ruby":[[4,2,"しぞく"],[18,2,"しぞく"]],"text":"マルキの氏族ではヨナタン、シバニヤの氏族ではヨセフ、"},{"ref":"Neh.12.15","start":16012015,"end":16012015,"break":"none","ruby":[[4,2,"しぞく"],[17,2,"しぞく"]],"text":"ハリムの氏族ではアデナ、メラヨテの氏族ではヘルカイ、"},{"ref":"Neh.12.16","start":16012016,"end":16012016,"break":"none","ruby":[[3,2,"しぞく"],[18,2,"しぞく"]],"text":"イドの氏族ではゼカリヤ、ギンネトンの氏族ではメシュラム、"},{"ref":"Neh.12.17","start":16012017,"end":16012017,"break":"none","ruby":[[4,2,"しぞく"],[18,2,"しぞく"],[26,2,"しぞく"]],"text":"アビヤの氏族ではジクリ、ミニヤミンの氏族、モアデヤの氏族ではピルタイ、"},{"ref":"Neh.12.18","start":16012018,"end":16012018,"break":"none","ruby":[[4,2,"しぞく"],[17,2,"しぞく"]],"text":"ビルガの氏族ではシャンマ、シマヤの氏族ではヨナタン、"},{"ref":"Neh.12.19","start":16012019,"end":16012019,"break":"none","ruby":[[5,2,"しぞく"],[19,2,"しぞく"]],"text":"ヨヤリブの氏族ではマッテナイ、エダヤの氏族ではウジ、"},{"ref":"Neh.12.20","start":16012020,"end":16012020,"break":"none","ruby":[[4,2,"しぞく"],[16,2,"しぞく"]],"text":"サライの氏族ではカライ、アモクの氏族ではエベル、"},{"ref":"Neh.12.21","start":16012021,"end":16012021,"break":"none","ruby":[[5,2,"しぞく"],[19,2,"しぞく"]],"text":"ヒルキヤの氏族ではハシャビヤ、エダヤの氏族ではネタンエルである。"},{"ref":"Neh.12.22","start":16012022,"end":16012022,"break":"paragraph","ruby":[[32,2,"じだい"],[38,2,"しぞく"],[41,1,"ちょう"],[45,2,"とうろく"],[53,2,"さいし"],[62,1,"おう"],[68,2,"ちせい"],[72,2,"とうろく"]],"text":"レビびとについては、エリアシブ、ヨイアダ、ヨハナンおよびヤドアの時代に、その氏族の長たちが登録された。また祭司たちもペルシャ王ダリヨスの治世まで登録された。"},{"ref":"Neh.12.23","start":16012023,"end":16012023,"break":"none","ruby":[[3,2,"しそん"],[6,2,"しぞく"],[9,1,"ちょう"],[12,1,"もの"],[21,1,"こ"],[27,1,"よ"],[30,3,"れきだいし"],[34,1,"しょ"]],"text":"レビの子孫で氏族の長たる者は、エリアシブの子ヨハナンの世まで歴代志の書にしるされている。"},{"ref":"Neh.12.24","start":16012024,"end":16012024,"break":"none","ruby":[[28,1,"こ"],[40,2,"きょうだい"],[44,1,"あい"],[45,1,"む"],[48,1,"あ"],[51,1,"くみ"],[53,1,"くみ"],[55,2,"たいおう"],[59,1,"かみ"],[61,1,"ひと"],[66,2,"めいれい"],[69,1,"したが"],[76,2,"かんしゃ"]],"text":"レビびとのかしらはハシャビヤ、セレビヤおよびカデミエルの子エシュアであって、その兄弟たち相向かい合い、組と組と対応して神の人ダビデの命令に従い、さんびと感謝をささげた。"},{"ref":"Neh.12.25","start":16012025,"end":16012025,"break":"none","ruby":[[35,1,"もん"],[37,1,"まも"],[39,1,"もの"],[41,1,"もん"],[43,1,"うち"],[45,1,"くら"],[47,2,"かんとく"]],"text":"マツタニヤ、バクブキヤ、オバデヤ、メシュラム、タルモンおよびアックブは門を守る者で門の内の倉を監督した。"},{"ref":"Neh.12.26","start":16012026,"end":16012026,"break":"none","ruby":[[9,1,"こ"],[15,1,"こ"],[21,2,"じだい"],[26,2,"そうとく"],[35,2,"がくしゃ"],[40,2,"さいし"],[46,2,"じだい"],[51,2,"ひとびと"]],"text":"これらはヨザダクの子エシュアの子ヨアキムの時代、また総督ネヘミヤおよび学者である祭司エズラの時代にいた人々である。"},{"ref":"Neh.12.27","start":16012027,"end":16012027,"break":"paragraph","ruby":[[8,2,"じょうへき"],[11,2,"らくせい"],[13,1,"しき"],[15,1,"あた"],[31,1,"ところ"],[34,1,"まね"],[47,2,"かんしゃ"],[51,1,"うた"],[60,2,"たてごと"],[64,1,"こと"],[70,1,"よろこ"],[73,2,"らくせい"],[75,1,"しき"],[77,1,"おこな"]],"text":"さてエルサレムの城壁の落成式に当って、レビびとを、そのすべての所から招いてエルサレムにこさせ、感謝と、歌と、シンバルと、立琴と、琴とをもって喜んで落成式を行おうとした。"},{"ref":"Neh.12.28","start":16012028,"end":16012028,"break":"none","ruby":[[4,1,"うた"],[8,2,"ひとびと"],[17,2,"しゅうい"],[20,2,"ちほう"],[29,2,"むらむら"],[33,1,"あつ"]],"text":"そこで、歌うたう人々はエルサレムの周囲の地方、ネトパびとの村々から集まってきた。"},{"ref":"Neh.12.29","start":16012029,"end":16012029,"break":"none","ruby":[[20,2,"ちほう"],[25,1,"あつ"],[34,1,"うた"],[38,1,"もの"],[48,2,"しゅうい"],[51,2,"じぶん"],[54,2,"むらむら"],[57,1,"た"]],"text":"またベテギルガルおよびゲバとアズマウテの地方からも集まってきた。この歌うたう者たちはエルサレムの周囲に自分の村々を建てていたからである。"},{"ref":"Neh.12.30","start":16012030,"end":16012030,"break":"none","ruby":[[3,2,"さいし"],[13,1,"み"],[15,1,"きよ"],[20,1,"たみ"],[29,1,"もん"],[31,2,"じょうへき"],[35,1,"きよ"]],"text":"そして祭司とレビびとたちは身を清め、また民およびもろもろの門と城壁とを清めた。"},{"ref":"Neh.12.31","start":16012031,"end":16012031,"break":"paragraph","ruby":[[16,2,"じょうへき"],[19,1,"うえ"],[28,2,"かんしゃ"],[32,1,"もの"],[37,1,"おお"],[40,1,"くみ"],[42,1,"つく"],[46,2,"こうしん"],[57,2,"じょうへき"],[60,1,"うえ"],[62,1,"みぎ"],[64,1,"ふん"],[66,1,"もん"],[71,1,"すす"]],"text":"そこでわたしはユダのつかさたちを城壁の上にのぼらせ、また感謝する者の二つの大きな組を作って、行進させた。その一つは城壁の上を右に糞の門をさして進んだ。"},{"ref":"Neh.12.32","start":16012032,"end":16012032,"break":"none","ruby":[[5,1,"したが"],[8,1,"すす"],[11,1,"もの"],[30,1,"なか"]],"text":"そのあとに従って進んだ者はホシャヤ、およびユダのつかさたちの半ば、"},{"ref":"Neh.12.33","start":16012033,"end":16012033,"break":"none","text":"ならびにアザリヤ、エズラ、メシュラム、"},{"ref":"Neh.12.34","start":16012034,"end":16012034,"break":"none","text":"ユダ、ベニヤミン、シマヤ、エレミヤであった。"},{"ref":"Neh.12.35","start":16012035,"end":16012035,"break":"none","ruby":[[2,2,"すうにん"],[5,2,"さいし"],[15,1,"したが"],[28,1,"こ"],[43,1,"こ"],[55,1,"こ"],[67,1,"こ"],[78,1,"こ"],[89,1,"こ"]],"text":"また数人の祭司がラッパをもって従った。すなわちヨナタンの子ゼカリヤ。ヨナタンはシマヤの子、シマヤはマッタニヤの子、マッタニヤはミカヤの子、ミカヤはザックルの子、ザックルはアサフの子である。"},{"ref":"Neh.12.36","start":16012036,"end":16012036,"break":"none","ruby":[[7,2,"きょうだい"],[54,1,"かみ"],[56,1,"ひと"],[61,2,"がっき"],[64,1,"も"],[67,1,"したが"],[74,2,"がくしゃ"],[80,1,"かれ"],[83,1,"さき"],[85,1,"すす"]],"text":"またゼカリヤの兄弟たちシマヤ、アザリエル、ミラライ、ギラライ、マアイ、ネタンエル、ユダ、ハナニなどであって、神の人ダビデの楽器を持って従った。そして学者エズラは彼らの先に進んだ。"},{"ref":"Neh.12.37","start":16012037,"end":16012037,"break":"none","ruby":[[0,1,"かれ"],[3,1,"いずみ"],[5,1,"もん"],[7,1,"へ"],[15,1,"すす"],[18,2,"じょうへき"],[21,1,"のぼ"],[23,1,"くち"],[30,1,"まち"],[32,2,"かいだん"],[36,1,"のぼ"],[43,1,"いえ"],[45,1,"うえ"],[47,1,"す"],[50,1,"ひがし"],[52,1,"ほう"],[54,1,"みず"],[56,1,"もん"],[58,1,"いた"]],"text":"彼らは泉の門を経て、まっすぐに進み、城壁の上り口で、ダビデの町の階段から上り、ダビデの家の上を過ぎて東の方、水の門に至った。"},{"ref":"Neh.12.38","start":16012038,"end":16012038,"break":"paragraph","ruby":[[0,1,"た"],[3,1,"くみ"],[5,2,"かんしゃ"],[9,1,"もの"],[11,1,"ひだり"],[13,1,"すす"],[21,1,"たみ"],[23,1,"なか"],[26,1,"とも"],[28,1,"かれ"],[34,1,"したが"],[41,2,"じょうへき"],[44,1,"うえ"],[46,1,"い"],[49,1,"ろ"],[51,2,"ぼうろう"],[54,1,"うえ"],[56,1,"す"],[60,2,"じょうへき"],[63,1,"ひろ"],[65,1,"ところ"],[67,1,"いた"]],"text":"他の一組の感謝する者は左に進んだ。わたしは民の半ばと共に彼らのあとに従った。そして城壁の上を行き、炉の望楼の上を過ぎて、城壁の広い所に至り、"},{"ref":"Neh.12.39","start":16012039,"end":16012039,"break":"none","ruby":[[6,1,"もん"],[8,1,"うえ"],[10,1,"とお"],[13,1,"ふる"],[15,1,"もん"],[17,1,"す"],[20,1,"うお"],[22,1,"もん"],[31,2,"ぼうろう"],[39,2,"ぼうろう"],[42,1,"す"],[46,1,"ひつじ"],[48,1,"もん"],[50,1,"いた"],[53,2,"このえ"],[56,1,"もん"],[58,1,"た"],[60,1,"ど"]],"text":"エフライムの門の上を通り、古い門を過ぎ、魚の門およびハナネルの望楼とハンメアの望楼を過ぎて、羊の門に至り、近衛の門に立ち止まった。"},{"ref":"Neh.12.40","start":16012040,"end":16012040,"break":"none","ruby":[[5,1,"くみ"],[7,2,"かんしゃ"],[11,1,"もの"],[13,1,"かみ"],[15,1,"みや"],[21,1,"た"],[32,1,"た"],[41,1,"なか"],[48,1,"とも"],[50,1,"た"]],"text":"こうして二組の感謝する者は神の宮にはいって立った。わたしもそこに立ち、つかさたちの半ばもわたしと共に立った。"},{"ref":"Neh.12.41","start":16012041,"end":16012041,"break":"none","ruby":[[2,2,"さいし"],[47,1,"も"]],"text":"また祭司エリアキム、マアセヤ、ミニヤミン、ミカヤ、エリオエナイ、ゼカリヤ、ハナニヤらはラッパを持ち、"},{"ref":"Neh.12.42","start":16012042,"end":16012042,"break":"none","ruby":[[38,1,"とも"],[46,1,"うた"],[50,1,"もの"],[54,1,"こえ"],[55,1,"たか"],[57,1,"うた"],[69,2,"かんとく"]],"text":"マアセヤ、シマヤ、エレアザル、ウジ、ヨハナン、マルキヤ、エラムおよびエゼルも共にいた。そして歌うたう者たちは声高く歌った。エズラヒヤはその監督であった。"},{"ref":"Neh.12.43","start":16012043,"end":16012043,"break":"none","ruby":[[4,1,"かれ"],[9,1,"ひ"],[11,1,"おお"],[15,2,"ぎせい"],[22,1,"よろこ"],[26,1,"かみ"],[28,1,"かれ"],[31,1,"おお"],[34,1,"よろこ"],[36,1,"たの"],[49,3,"おんなこども"],[55,1,"よろこ"],[68,1,"よろこ"],[71,1,"こえ"],[73,1,"とお"],[77,1,"きこ"]],"text":"こうして彼らはその日、大いなる犠牲をささげて喜んだ。神が彼らを大いに喜び楽しませられたからである。女子供までも喜んだ。それでエルサレムの喜びの声は遠くまで聞えた。"},{"ref":"Neh.12.44","start":16012044,"end":16012044,"break":"paragraph","ruby":[[2,1,"ひ"],[4,1,"くら"],[19,2,"ひとびと"],[22,1,"えら"],[28,1,"もの"],[30,2,"はつもの"],[34,1,"ぶん"],[39,2,"りっぽう"],[42,1,"さだ"],[49,2,"さいし"],[59,1,"ぶん"],[61,2,"まちまち"],[64,2,"たはた"],[72,1,"と"],[74,1,"あつ"],[81,1,"い"],[98,2,"さいし"],[108,1,"つか"],[119,1,"よろこ"]],"text":"その日、倉のもろもろのへやをつかさどる人々を選び、ささげ物、初物、十分の一など律法の定めるところの祭司およびレビびとの分を町々の田畑にしたがって取り集めて、へやに入れることをつかさどらせた。これは祭司およびレビびとの仕えるのを、ユダびとが喜んだからである。"},{"ref":"Neh.12.45","start":16012045,"end":16012045,"break":"none","ruby":[[0,1,"かれ"],[11,1,"こ"],[17,2,"めいれい"],[20,1,"したが"],[24,1,"かみ"],[26,1,"つと"],[31,1,"きよ"],[33,1,"ごと"],[35,1,"つと"],[41,1,"うた"],[45,1,"もの"],[49,1,"もん"],[51,1,"まも"],[53,1,"もの"],[60,1,"い"]],"text":"彼らはダビデおよびその子ソロモンの命令に従って、神の勤めおよび清め事の勤めをした。歌うたう者および門を守る者もそのように行った。"},{"ref":"Neh.12.46","start":16012046,"end":16012046,"break":"none","ruby":[[0,1,"むかし"],[11,1,"ひ"],[15,1,"うた"],[19,1,"もの"],[31,1,"かみ"],[37,2,"かんしゃ"],[44,1,"こと"]],"text":"昔ダビデおよびアサフの日には、歌うたう者のかしらがひとりいて、神にさんびと感謝をささげる事があった。"},{"ref":"Neh.12.47","start":16012047,"end":16012047,"break":"none","ruby":[[8,1,"ひ"],[17,1,"ひ"],[31,1,"うた"],[35,1,"もの"],[37,1,"もん"],[39,1,"まも"],[41,1,"もの"],[43,2,"ひび"],[46,1,"ぶん"],[48,1,"あた"],[58,1,"もの"],[60,2,"せいべつ"],[64,1,"あた"],[77,2,"せいべつ"],[85,2,"しそん"],[88,1,"あた"]],"text":"またゼルバベルの日およびネヘミヤの日には、イスラエルびとはみな歌うたう者と門を守る者に日々の分を与え、またレビびとに物を聖別して与え、レビびとはまたこれを聖別してアロンの子孫に与えた。"}]