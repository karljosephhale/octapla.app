[{"ref":"1Tim.3.1","start":54003001,"end":54003001,"break":"paragraph","ruby":[[3,1,"ひと"],[5,2,"かんとく"],[8,1,"しょく"],[10,1,"のぞ"],[18,1,"よ"],[20,2,"しごと"],[23,1,"ねが"],[33,1,"ただ"],[36,2,"ことば"]],"text":"「もし人が監督の職を望むなら、それは良い仕事を願うことである」とは正しい言葉である。"},{"ref":"1Tim.3.2","start":54003002,"end":54003002,"break":"none","ruby":[[3,2,"かんとく"],[7,2,"ひなん"],[12,1,"ひと"],[19,1,"つま"],[21,1,"おっと"],[26,1,"みずか"],[29,1,"せい"],[32,1,"つつし"],[34,1,"ぶか"],[37,2,"れいぎ"],[39,1,"ただ"],[43,2,"たびびと"],[53,1,"おし"]],"text":"さて、監督は、非難のない人で、ひとりの妻の夫であり、自らを制し、慎み深く、礼儀正しく、旅人をもてなし、よく教えることができ、"},{"ref":"1Tim.3.3","start":54003003,"end":54003003,"break":"none","ruby":[[0,1,"さけ"],[2,1,"この"],[6,2,"らんぼう"],[12,2,"かんよう"],[19,1,"ひと"],[21,1,"あらそ"],[25,1,"かね"],[27,2,"たんぱく"]],"text":"酒を好まず、乱暴でなく、寛容であって、人と争わず、金に淡泊で、"},{"ref":"1Tim.3.4","start":54003004,"end":54003004,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"いえ"],[7,2,"おさめ"],[10,2,"きんげん"],[17,2,"こども"],[22,2,"じゅうじゅん"],[25,1,"もの"],[27,1,"そだ"],[32,1,"ひと"]],"text":"自分の家をよく治め、謹厳であって、子供たちを従順な者に育てている人でなければならない。"},{"ref":"1Tim.3.5","start":54003005,"end":54003005,"break":"none","ruby":[[0,2,"じぶん"],[3,1,"いえ"],[5,1,"おさ"],[11,2,"こころえ"],[17,1,"ひと"],[24,1,"かみ"],[26,2,"きょうかい"],[29,1,"あづ"]],"text":"自分の家を治めることも心得ていない人が、どうして神の教会を預かることができようか。"},{"ref":"1Tim.3.6","start":54003006,"end":54003006,"break":"none","ruby":[[0,1,"かれ"],[5,2,"しんじゃ"],[11,1,"あいだ"],[34,2,"こうまん"],[41,2,"あくま"],[44,1,"おな"],[46,2,"しんぱん"],[49,1,"う"],[54,1,"し"]],"text":"彼はまた、信者になって間もないものであってはならない。そうであると、高慢になって、悪魔と同じ審判を受けるかも知れない。"},{"ref":"1Tim.3.7","start":54003007,"end":54003007,"break":"none","ruby":[[6,3,"きょうかいがい"],[10,2,"ひとびと"],[16,1,"おも"],[22,1,"ひと"],[44,1,"う"],[47,2,"あくま"]],"text":"さらにまた、教会外の人々にもよく思われている人でなければならない。そうでないと、そしりを受け、悪魔のわなにかかるであろう。"},{"ref":"1Tim.3.8","start":54003008,"end":54003008,"break":"paragraph","ruby":[[3,2,"どうよう"],[7,2,"しつじ"],[10,2,"きんげん"],[17,3,"にまいじた"],[21,1,"つか"],[25,2,"おおざけ"],[28,1,"の"],[32,1,"り"]],"text":"それと同様に、執事も謹厳であって、二枚舌を使わず、大酒を飲まず、利をむさぼらず、"},{"ref":"1Tim.3.9","start":54003009,"end":54003009,"break":"none","ruby":[[3,2,"りょうしん"],[10,2,"しんこう"],[13,2,"おくぎ"],[16,1,"たも"]],"text":"きよい良心をもって、信仰の奥義を保っていなければならない。"},{"ref":"1Tim.3.10","start":54003010,"end":54003010,"break":"none","ruby":[[0,1,"かれ"],[5,1,"しら"],[11,3,"ふつごう"],[29,2,"しつじ"],[32,1,"しょく"]],"text":"彼らはまず調べられて、不都合なことがなかったなら、それから執事の職につかすべきである。"},{"ref":"1Tim.3.11","start":54003011,"end":54003011,"break":"none","ruby":[[0,1,"おんな"],[5,2,"どうよう"],[8,2,"きんげん"],[12,2,"たにん"],[20,1,"みずか"],[23,1,"せい"],[33,2,"ちゅうじつ"]],"text":"女たちも、同様に謹厳で、他人をそしらず、自らを制し、すべてのことに忠実でなければならない。"},{"ref":"1Tim.3.12","start":54003012,"end":54003012,"break":"none","ruby":[[0,2,"しつじ"],[7,1,"つま"],[9,1,"おっと"],[15,2,"こども"],[18,2,"じぶん"],[21,1,"いえ"],[26,1,"おさ"],[29,1,"もの"]],"text":"執事はひとりの妻の夫であって、子供と自分の家とをよく治める者でなければならない。"},{"ref":"1Tim.3.13","start":54003013,"end":54003013,"break":"none","ruby":[[0,2,"しつじ"],[3,1,"しょく"],[11,1,"もの"],[14,1,"よ"],[16,2,"ちい"],[19,1,"え"],[33,1,"しん"],[36,2,"しんこう"],[42,1,"おお"],[46,2,"かくしん"],[49,1,"え"]],"text":"執事の職をよくつとめた者は、良い地位を得、さらにキリスト・イエスを信じる信仰による、大いなる確信を得るであろう。"},{"ref":"1Tim.3.14","start":54003014,"end":54003014,"break":"paragraph","ruby":[[9,1,"ところ"],[13,1,"い"],[18,1,"のぞ"],[26,2,"てがみ"],[29,1,"か"]],"text":"わたしは、あなたの所にすぐ行きたいと望みながら、この手紙を書いている。"},{"ref":"1Tim.3.15","start":54003015,"end":54003015,"break":"none","ruby":[[0,2,"まんいち"],[9,2,"ばあい"],[14,1,"かみ"],[16,1,"いえ"],[21,2,"せいかつ"],[33,1,"し"],[47,1,"かみ"],[49,1,"いえ"],[56,1,"い"],[59,1,"かみ"],[61,2,"きょうかい"],[74,2,"しんり"],[77,1,"はしら"],[79,2,"しんり"],[82,2,"きそ"]],"text":"万一わたしが遅れる場合には、神の家でいかに生活すべきかを、あなたに知ってもらいたいからである。神の家というのは、生ける神の教会のことであって、それは真理の柱、真理の基礎なのである。"},{"ref":"1Tim.3.16","start":54003016,"end":54003016,"break":"none","breaks":[[20,"stanza"],[34,"line"],[45,"line"],[54,"line"],[65,"line"],[75,"line"]],"ruby":[[0,1,"たし"],[3,2,"いだい"],[11,2,"しんじん"],[14,2,"おくぎ"],[26,1,"にく"],[31,1,"あらわ"],[34,1,"れい"],[39,1,"ぎ"],[45,2,"みつかい"],[50,1,"み"],[54,1,"しょ"],[55,2,"こくみん"],[58,1,"あいだ"],[60,1,"つた"],[65,2,"せかい"],[68,1,"なか"],[70,1,"しん"],[75,2,"えいこう"],[81,1,"てん"],[83,1,"あ"]],"text":"確かに偉大なのは、この信心の奥義である、「キリストは肉において現れ、霊において義とせられ、御使たちに見られ、諸国民の間に伝えられ、世界の中で信じられ、栄光のうちに天に上げられた」。"}]