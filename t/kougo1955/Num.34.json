[{"ref":"Num.34.1","start":4034001,"end":4034001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"]],"text":"主はモーセに言われた、"},{"ref":"Num.34.2","start":4034002,"end":4034002,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"めい"],[13,1,"い"],[29,1,"ち"],[43,1,"し"],[44,1,"ぎょう"],[50,1,"ち"],[56,1,"ち"],[61,2,"ぜんいき"],[64,1,"つぎ"]],"text":"「イスラエルの人々に命じて言いなさい。あなたがたがカナンの地にはいるとき、あなたがたの嗣業となるべき地はカナンの地で、その全域は次のとおりである。"},{"ref":"Num.34.3","start":4034003,"end":4034003,"break":"none","ruby":[[0,1,"みなみ"],[2,1,"ほう"],[8,1,"せっ"],[14,2,"あらの"],[17,1,"はじ"],[21,1,"みなみ"],[23,1,"さかい"],[26,1,"ひがし"],[28,1,"しお"],[30,1,"うみ"],[32,1,"はし"],[34,1,"はじ"]],"text":"南の方はエドムに接するチンの荒野に始まり、南の境は、東は塩の海の端に始まる。"},{"ref":"Num.34.4","start":4034004,"end":4034004,"break":"none","ruby":[[2,1,"さかい"],[10,1,"さか"],[12,1,"みなみ"],[14,1,"めぐ"],[20,1,"む"],[33,1,"みなみ"],[35,1,"いた"],[46,1,"すす"],[54,1,"およ"]],"text":"その境はアクラビムの坂の南を巡ってチンに向かい、カデシ・バルネアの南に至り、ハザル・アダルに進み、アズモンに及ぶ。"},{"ref":"Num.34.5","start":4034005,"end":4034005,"break":"none","ruby":[[2,1,"さかい"],[12,1,"てん"],[20,1,"かわ"],[22,1,"いた"],[25,1,"うみ"],[27,1,"およ"],[30,1,"つ"]],"text":"その境はまたアズモンから転じてエジプトの川に至り、海に及んで尽きる。"},{"ref":"Num.34.6","start":4034006,"end":4034006,"break":"paragraph","ruby":[[0,1,"にし"],[2,1,"さかい"],[11,2,"えんがん"],[24,1,"にし"],[26,1,"さかい"]],"text":"西の境はおおうみとその沿岸で、これがあなたがたの西の境である。"},{"ref":"Num.34.7","start":4034007,"end":4034007,"break":"paragraph","ruby":[[6,1,"きた"],[8,1,"さかい"],[10,1,"つぎ"],[31,1,"やま"],[34,1,"せん"],[36,1,"ひ"]],"text":"あなたがたの北の境は次のとおりである。すなわちおおうみからホル山まで線を引き、"},{"ref":"Num.34.8","start":4034008,"end":4034008,"break":"none","ruby":[[2,1,"やま"],[9,2,"いりぐち"],[13,1,"せん"],[15,1,"ひ"],[20,1,"さかい"],[26,1,"いた"]],"text":"ホル山からハマテの入口まで線を引き、その境をゼダデに至らせ、"},{"ref":"Num.34.9","start":4034009,"end":4034009,"break":"none","ruby":[[4,1,"さかい"],[11,1,"すす"],[22,1,"いた"],[25,1,"つ"],[38,1,"きた"],[40,1,"さかい"]],"text":"またその境はジフロンに進み、ハザル・エノンに至って尽きる。これがあなたがたの北の境である。"},{"ref":"Num.34.10","start":4034010,"end":4034010,"break":"paragraph","ruby":[[6,1,"ひがし"],[8,1,"さかい"],[25,1,"せん"],[27,1,"ひ"]],"text":"あなたがたの東の境は、ハザル・エノンからシパムまで線を引き、"},{"ref":"Num.34.11","start":4034011,"end":4034011,"break":"none","ruby":[[4,1,"さかい"],[10,1,"ひがし"],[12,1,"ほう"],[24,1,"くだ"],[31,1,"さかい"],[33,1,"くだ"],[42,1,"うみ"],[44,1,"ひがし"],[46,2,"しゃめん"],[49,1,"いた"]],"text":"またその境はアインの東の方で、シパムからリブラに下り、またその境は下ってキンネレテの海の東の斜面に至り、"},{"ref":"Num.34.12","start":4034012,"end":4034012,"break":"none","ruby":[[4,1,"さかい"],[11,1,"くだ"],[14,1,"しお"],[16,1,"うみ"],[18,1,"いた"],[21,1,"つ"],[31,1,"くに"],[33,2,"しゅうい"],[36,1,"さかい"],[38,2,"いじょう"]],"text":"またその境はヨルダンに下り、塩の海に至って尽きる。あなたがたの国の周囲の境は以上のとおりである」。"},{"ref":"Num.34.13","start":4034013,"end":4034013,"break":"paragraph","ruby":[[10,2,"ひとびと"],[13,1,"めい"],[16,1,"い"],[37,1,"つ"],[41,1,"ち"],[46,1,"しゅ"],[54,2,"ぶぞく"],[57,1,"はん"],[58,2,"ぶぞく"],[62,1,"あた"],[66,1,"めい"]],"text":"モーセはイスラエルの人々に命じて言った、「これはあなたがたが、くじによって継ぐべき地である。主はこれを九つの部族と半部族とに与えよと命じられた。"},{"ref":"Num.34.14","start":4034014,"end":4034014,"break":"none","ruby":[[7,2,"しそん"],[10,2,"ぶぞく"],[16,2,"しそん"],[19,2,"ぶぞく"],[23,1,"とも"],[25,2,"ふそ"],[28,1,"いえ"],[41,1,"し"],[42,1,"ぎょう"],[44,1,"う"],[53,1,"はん"],[54,2,"ぶぞく"],[59,1,"し"],[60,1,"ぎょう"],[62,1,"う"]],"text":"それはルベンの子孫の部族とガドの子孫の部族とが共に父祖の家にしたがって、すでにその嗣業を受け、またマナセの半部族もその嗣業を受けていたからである。"},{"ref":"Num.34.15","start":4034015,"end":4034015,"break":"none","ruby":[[5,2,"ぶぞく"],[8,1,"はん"],[9,2,"ぶぞく"],[17,1,"ちか"],[32,1,"ひがし"],[34,1,"ほう"],[36,1,"ひ"],[38,1,"で"],[40,1,"ほう"],[45,1,"し"],[46,1,"ぎょう"],[48,1,"う"]],"text":"この二つの部族と半部族とはエリコに近いヨルダンのかなた、すなわち東の方、日の出る方で、その嗣業を受けた」。"},{"ref":"Num.34.16","start":4034016,"end":4034016,"break":"paragraph","ruby":[[0,1,"しゅ"],[8,1,"い"]],"text":"主はまたモーセに言われた、"},{"ref":"Num.34.17","start":4034017,"end":4034017,"break":"none","ruby":[[8,1,"し"],[9,1,"ぎょう"],[13,1,"ち"],[15,1,"わ"],[17,1,"あた"],[20,2,"ひとびと"],[23,1,"な"],[25,1,"つぎ"],[38,2,"さいし"],[50,1,"こ"]],"text":"「あなたがたに、嗣業として地を分け与える人々の名は次のとおりである。すなわち祭司エレアザルと、ヌンの子ヨシュアとである。"},{"ref":"Num.34.18","start":4034018,"end":4034018,"break":"none","ruby":[[13,2,"ぶぞく"],[27,1,"えら"],[31,1,"ち"],[33,1,"わ"],[35,1,"あた"]],"text":"あなたがたはまた、おのおの部族から、つかさひとりずつを選んで、地を分け与えさせなければならない。"},{"ref":"Num.34.19","start":4034019,"end":4034019,"break":"none","ruby":[[2,2,"ひとびと"],[5,1,"な"],[7,1,"つぎ"],[23,2,"ぶぞく"],[32,1,"こ"]],"text":"その人々の名は次のとおりである。すなわちユダの部族ではエフンネの子カレブ、"},{"ref":"Num.34.20","start":4034020,"end":4034020,"break":"none","ruby":[[5,2,"しそん"],[8,2,"ぶぞく"],[17,1,"こ"]],"text":"シメオンの子孫の部族ではアミホデの子サムエル、"},{"ref":"Num.34.21","start":4034021,"end":4034021,"break":"none","ruby":[[6,2,"ぶぞく"],[15,1,"こ"]],"text":"ベニヤミンの部族ではキスロンの子エリダデ、"},{"ref":"Num.34.22","start":4034022,"end":4034022,"break":"none","ruby":[[3,2,"しそん"],[6,2,"ぶぞく"],[14,1,"こ"]],"text":"ダンの子孫の部族ではヨグリの子つかさブッキ、"},{"ref":"Num.34.23","start":4034023,"end":4034023,"break":"none","ruby":[[4,2,"しそん"],[15,2,"ぶぞく"],[23,1,"こ"]],"text":"ヨセフの子孫、すなわちマナセの部族ではエポデの子つかさハニエル、"},{"ref":"Num.34.24","start":4034024,"end":4034024,"break":"none","ruby":[[6,2,"しそん"],[9,2,"ぶぞく"],[18,1,"こ"]],"text":"エフライムの子孫の部族ではシフタンの子つかさケムエル、"},{"ref":"Num.34.25","start":4034025,"end":4034025,"break":"none","ruby":[[5,2,"しそん"],[8,2,"ぶぞく"],[17,1,"こ"]],"text":"ゼブルンの子孫の部族ではパルナクの子つかさエリザパン、"},{"ref":"Num.34.26","start":4034026,"end":4034026,"break":"none","ruby":[[6,2,"しそん"],[9,2,"ぶぞく"],[17,1,"こ"]],"text":"イッサカルの子孫の部族ではアザンの子つかさパルテエル、"},{"ref":"Num.34.27","start":4034027,"end":4034027,"break":"none","ruby":[[4,2,"しそん"],[7,2,"ぶぞく"],[15,1,"こ"]],"text":"アセルの子孫の部族ではシロミの子つかさアヒウデ、"},{"ref":"Num.34.28","start":4034028,"end":4034028,"break":"none","ruby":[[5,2,"しそん"],[8,2,"ぶぞく"],[18,1,"こ"]],"text":"ナフタリの子孫の部族では、アミホデの子つかさパダヘル。"},{"ref":"Num.34.29","start":4034029,"end":4034029,"break":"none","ruby":[[4,1,"ち"],[12,2,"ひとびと"],[15,1,"し"],[16,1,"ぎょう"],[18,1,"わ"],[20,1,"あた"],[26,1,"しゅ"],[28,1,"めい"],[33,2,"ひとびと"],[36,2,"いじょう"]],"text":"カナンの地でイスラエルの人々に嗣業を分け与えることを主が命じられた人々は以上のとおりである」。"}]