[{"ref":"Gen.26.1","start":1026001,"end":1026001,"break":"paragraph","ruby":[[6,1,"とき"],[11,1,"はじ"],[29,1,"くに"],[54,1,"おう"],[61,1,"ところ"],[63,1,"い"]],"text":"アブラハムの時にあった初めのききんのほか、またききんがその国にあったので、イサクはゲラルにいるペリシテびとの王アビメレクの所へ行った。"},{"ref":"Gen.26.2","start":1026002,"end":1026002,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,1,"かれ"],[8,1,"あらわ"],[11,1,"い"],[22,1,"くだ"],[39,1,"しめ"],[41,1,"ち"]],"text":"その時、主は彼に現れて言われた、「エジプトへ下ってはならない。わたしがあなたに示す地にとどまりなさい。"},{"ref":"Gen.26.3","start":1026003,"end":1026003,"break":"none","ruby":[[6,1,"ち"],[23,1,"とも"],[32,2,"しゅくふく"],[40,1,"くに"],[56,2,"しそん"],[60,1,"あた"],[71,1,"ちち"],[78,1,"ちか"],[81,1,"ちか"],[84,1,"はた"]],"text":"あなたがこの地にとどまるなら、わたしはあなたと共にいて、あなたを祝福し、これらの国をことごとくあなたと、あなたの子孫とに与え、わたしがあなたの父アブラハムに誓った誓いを果そう。"},{"ref":"Gen.26.4","start":1026004,"end":1026004,"break":"none","ruby":[[10,2,"しそん"],[13,1,"ま"],[16,1,"てん"],[18,1,"ほし"],[29,2,"しそん"],[36,1,"ち"],[40,1,"あた"],[48,1,"ち"],[54,2,"こくみん"],[61,2,"しそん"],[67,2,"しゅくふく"]],"text":"またわたしはあなたの子孫を増して天の星のようにし、あなたの子孫にこれらの地をみな与えよう。そして地のすべての国民はあなたの子孫によって祝福をえるであろう。"},{"ref":"Gen.26.5","start":1026005,"end":1026005,"break":"none","ruby":[[10,2,"ことば"],[43,1,"まも"]],"text":"アブラハムがわたしの言葉にしたがってわたしのさとしと、いましめと、さだめと、おきてとを守ったからである」。"},{"ref":"Gen.26.6","start":1026006,"end":1026006,"break":"paragraph","ruby":[[12,1,"す"]],"text":"こうしてイサクはゲラルに住んだ。"},{"ref":"Gen.26.7","start":1026007,"end":1026007,"break":"none","ruby":[[2,1,"ところ"],[4,2,"ひとびと"],[7,1,"かれ"],[9,1,"つま"],[14,1,"たず"],[21,2,"かのじょ"],[28,1,"いもうと"],[33,1,"かれ"],[35,1,"い"],[43,1,"うつく"],[53,1,"ところ"],[55,2,"ひとびと"],[65,2,"じぶん"],[68,1,"ころ"],[77,1,"おも"],[86,1,"つま"],[91,1,"い"],[95,1,"おそ"]],"text":"その所の人々が彼の妻のことを尋ねたとき、「彼女はわたしの妹です」と彼は言った。リベカは美しかったので、その所の人々がリベカのゆえに自分を殺すかもしれないと思って、「わたしの妻です」と言うのを恐れたからである。"},{"ref":"Gen.26.8","start":1026008,"end":1026008,"break":"none","ruby":[[4,1,"なが"],[16,1,"ひ"],[24,1,"おう"],[31,1,"まど"],[34,1,"そと"],[49,1,"つま"],[54,1,"たわむ"],[61,1,"み"]],"text":"イサクは長らくそこにいたが、ある日ペリシテびとの王アビメレクは窓から外をながめていて、イサクがその妻リベカと戯れているのを見た。"},{"ref":"Gen.26.9","start":1026009,"end":1026009,"break":"none","ruby":[[13,1,"め"],[16,1,"い"],[21,2,"かのじょ"],[24,1,"たし"],[31,1,"つま"],[44,2,"かのじょ"],[51,1,"いもうと"],[56,1,"い"],[70,1,"かれ"],[72,1,"い"],[81,2,"かのじょ"],[87,1,"ころ"],[98,1,"おも"]],"text":"そこでアビメレクはイサクを召して言った、「彼女は確かにあなたの妻です。あなたはどうして『彼女はわたしの妹です』と言われたのですか」。イサクは彼に言った、「わたしは彼女のゆえに殺されるかもしれないと思ったからです」。"},{"ref":"Gen.26.10","start":1026010,"end":1026010,"break":"none","ruby":[[6,1,"い"],[22,1,"こと"],[37,1,"たみ"],[43,2,"かるがる"],[51,1,"つま"],[53,1,"ね"],[58,1,"こと"],[66,1,"とき"],[76,1,"つみ"],[78,1,"お"]],"text":"アビメレクは言った、「あなたはどうしてこんな事をわれわれにされたのですか。民のひとりが軽々しくあなたの妻と寝るような事があれば、その時あなたはわれわれに罪を負わせるでしょう」。"},{"ref":"Gen.26.11","start":1026011,"end":1026011,"break":"none","ruby":[[13,1,"たみ"],[15,1,"めい"],[18,1,"い"],[25,1,"ひと"],[32,1,"つま"],[37,1,"もの"],[39,1,"かなら"],[41,1,"し"]],"text":"それでアビメレクはすべての民に命じて言った、「この人、またはその妻にさわる者は必ず死ななければならない」。"},{"ref":"Gen.26.12","start":1026012,"end":1026012,"break":"paragraph","ruby":[[6,1,"ち"],[8,1,"たね"],[16,1,"とし"],[19,1,"ばい"],[21,2,"しゅうかく"],[24,1,"え"],[32,1,"しゅ"],[34,1,"かれ"],[36,2,"しゅくふく"]],"text":"イサクはその地に種をまいて、その年に百倍の収穫を得た。このように主が彼を祝福されたので、"},{"ref":"Gen.26.13","start":1026013,"end":1026013,"break":"none","ruby":[[0,1,"かれ"],[2,1,"と"],[11,1,"さか"],[14,2,"ひじょう"],[17,2,"ゆうふく"]],"text":"彼は富み、またますます栄えて非常に裕福になり、"},{"ref":"Gen.26.14","start":1026014,"end":1026014,"break":"none","ruby":[[0,1,"ひつじ"],[2,1,"む"],[5,1,"うし"],[7,1,"む"],[9,1,"およ"],[11,1,"おお"],[18,1,"も"],[36,1,"かれ"]],"text":"羊の群れ、牛の群れ及び多くのしもべを持つようになったので、ペリシテびとは彼をねたんだ。"},{"ref":"Gen.26.15","start":1026015,"end":1026015,"break":"none","ruby":[[9,1,"かれ"],[11,1,"ちち"],[18,1,"とき"],[21,1,"ちち"],[29,1,"ほ"],[36,2,"いど"],[43,1,"つち"],[45,1,"う"]],"text":"またペリシテびとは彼の父アブラハムの時に、父のしもべたちが掘ったすべての井戸をふさぎ、土で埋めた。"},{"ref":"Gen.26.16","start":1026016,"end":1026016,"break":"none","ruby":[[10,1,"い"],[31,1,"つよ"],[45,1,"ところ"],[47,1,"さ"]],"text":"アビメレクはイサクに言った、「あなたはわれわれよりも、はるかに強くなられたから、われわれの所を去ってください」。"},{"ref":"Gen.26.17","start":1026017,"end":1026017,"break":"paragraph","ruby":[[7,1,"さ"],[14,1,"たに"],[16,2,"てんまく"],[19,1,"は"],[24,1,"ところ"],[26,1,"す"]],"text":"イサクはそこを去り、ゲラルの谷に天幕を張ってその所に住んだ。"},{"ref":"Gen.26.18","start":1026018,"end":1026018,"break":"none","ruby":[[7,1,"ちち"],[14,1,"とき"],[16,2,"ひとびと"],[19,1,"ほ"],[22,1,"みず"],[24,2,"いど"],[27,1,"ふたた"],[29,1,"ほ"],[39,2,"しご"],[63,1,"ちち"],[68,1,"な"],[79,1,"な"]],"text":"そしてイサクは父アブラハムの時に人々の掘った水の井戸を再び掘った。アブラハムの死後、ペリシテびとがふさいだからである。イサクは父がつけた名にしたがってそれらに名をつけた。"},{"ref":"Gen.26.19","start":1026019,"end":1026019,"break":"none","ruby":[[13,1,"たに"],[15,1,"なか"],[17,1,"ほ"],[26,1,"で"],[28,1,"みず"],[30,2,"いど"],[33,1,"み"]],"text":"しかしイサクのしもべたちが谷の中を掘って、そこにわき出る水の井戸を見つけたとき、"},{"ref":"Gen.26.20","start":1026020,"end":1026020,"break":"none","ruby":[[4,2,"ひつじかい"],[13,1,"みず"],[25,1,"い"],[33,2,"ひつじかい"],[38,1,"あらそ"],[50,2,"いど"],[53,1,"な"],[59,1,"な"],[64,1,"かれ"],[67,1,"かれ"],[69,1,"あらそ"]],"text":"ゲラルの羊飼たちは、「この水はわれわれのものだ」と言って、イサクの羊飼たちと争ったので、イサクはその井戸の名をエセクと名づけた。彼らが彼と争ったからである。"},{"ref":"Gen.26.21","start":1026021,"end":1026021,"break":"none","ruby":[[0,1,"かれ"],[8,2,"いど"],[11,1,"ほ"],[20,1,"あらそ"],[26,1,"な"],[32,1,"な"]],"text":"彼らはまた一つの井戸を掘ったが、これをも争ったので、名をシテナと名づけた。"},{"ref":"Gen.26.22","start":1026022,"end":1026022,"break":"none","ruby":[[8,1,"うつ"],[16,2,"いど"],[19,1,"ほ"],[24,1,"かれ"],[30,1,"あらそ"],[41,1,"な"],[48,1,"な"],[52,1,"い"],[59,1,"しゅ"],[66,2,"ばしょ"],[69,1,"ひろ"],[84,1,"ち"]],"text":"イサクはそこから移ってまた一つの井戸を掘ったが、彼らはこれを争わなかったので、その名をレホボテと名づけて言った、「いま主がわれわれの場所を広げられたから、われわれはこの地にふえるであろう」。"},{"ref":"Gen.26.23","start":1026023,"end":1026023,"break":"paragraph","ruby":[[0,1,"かれ"],[12,1,"のぼ"]],"text":"彼はそこからベエルシバに上った。"},{"ref":"Gen.26.24","start":1026024,"end":1026024,"break":"none","ruby":[[2,1,"よ"],[4,1,"しゅ"],[6,1,"かれ"],[8,1,"あらわ"],[11,1,"い"],[25,1,"ちち"],[32,1,"かみ"],[41,1,"おそ"],[58,1,"とも"],[68,2,"しゅくふく"],[92,2,"しそん"],[95,1,"ま"]],"text":"その夜、主は彼に現れて言われた、「わたしはあなたの父アブラハムの神である。あなたは恐れてはならない。わたしはあなたと共におって、あなたを祝福し、わたしのしもべアブラハムのゆえにあなたの子孫を増すであろう」。"},{"ref":"Gen.26.25","start":1026025,"end":1026025,"break":"none","ruby":[[3,1,"かれ"],[7,1,"ところ"],[9,2,"さいだん"],[12,1,"きず"],[16,1,"しゅ"],[18,1,"な"],[20,1,"よ"],[26,2,"てんまく"],[29,1,"は"],[51,2,"いど"],[54,1,"ほ"]],"text":"それで彼はその所に祭壇を築いて、主の名を呼び、そこに天幕を張った。またイサクのしもべたちはそこに一つの井戸を掘った。"},{"ref":"Gen.26.26","start":1026026,"end":1026026,"break":"paragraph","ruby":[[0,1,"とき"],[10,1,"とも"],[17,2,"ぐんぜい"],[20,1,"ちょう"],[25,1,"とも"]],"text":"時にアビメレクがその友アホザテと、軍勢の長ピコルと共にゲラルからイサクのもとにきたので、"},{"ref":"Gen.26.27","start":1026027,"end":1026027,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[22,1,"にく"],[32,1,"なか"],[39,1,"お"],[41,1,"だ"],[56,1,"ところ"]],"text":"イサクは彼らに言った、「あなたがたはわたしを憎んで、あなたがたの中からわたしを追い出されたのに、どうしてわたしの所にこられたのですか」。"},{"ref":"Gen.26.28","start":1026028,"end":1026028,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[13,1,"しゅ"],[19,1,"とも"],[32,1,"み"],[46,1,"あいだ"],[62,1,"あいだ"],[67,1,"ちか"],[70,1,"た"],[78,2,"けいやく"],[81,2,"むすぼ"],[85,1,"おも"]],"text":"彼らは言った、「われわれは主があなたと共におられるのを、はっきり見ましたので、いまわれわれの間、すなわちわれわれとあなたとの間に一つの誓いを立てて、あなたと契約を結ぼうと思います。"},{"ref":"Gen.26.29","start":1026029,"end":1026029,"break":"none","ruby":[[9,1,"がい"],[11,1,"くわ"],[22,1,"よ"],[24,1,"こと"],[31,1,"やす"],[35,1,"さ"],[54,1,"わる"],[56,1,"こと"],[75,1,"しゅ"],[77,2,"しゅくふく"]],"text":"われわれはあなたに害を加えたことはなく、ただ良い事だけをして、安らかに去らせたのですから、あなたはわれわれに悪い事をしてはなりません。まことにあなたは主に祝福されたかたです」。"},{"ref":"Gen.26.30","start":1026030,"end":1026030,"break":"none","ruby":[[7,1,"かれ"],[18,1,"もう"],[22,1,"かれ"],[25,1,"の"],[27,1,"く"]],"text":"そこでイサクは彼らのためにふるまいを設けた。彼らは飲み食いし、"},{"ref":"Gen.26.31","start":1026031,"end":1026031,"break":"none","ruby":[[3,1,"あさ"],[8,1,"お"],[11,1,"たがい"],[13,1,"ちか"],[25,1,"かれ"],[28,1,"さ"],[35,1,"かれ"],[46,1,"おだ"],[50,1,"さ"]],"text":"あくる朝、はやく起きて互に誓った。こうしてイサクは彼らを去らせたので、彼らはイサクのもとから穏やかに去った。"},{"ref":"Gen.26.32","start":1026032,"end":1026032,"break":"none","ruby":[[2,1,"ひ"],[17,2,"じぶん"],[22,1,"ほ"],[25,2,"いど"],[31,1,"かれ"],[33,1,"つ"],[36,1,"い"],[47,1,"みず"],[49,1,"み"]],"text":"その日、イサクのしもべたちがきて、自分たちが掘った井戸について彼に告げて言った、「わたしたちは水を見つけました」。"},{"ref":"Gen.26.33","start":1026033,"end":1026033,"break":"none","ruby":[[10,1,"な"],[23,1,"まち"],[25,1,"な"],[27,2,"こんにち"]],"text":"イサクはそれをシバと名づけた。これによってその町の名は今日にいたるまでベエルシバといわれている。"},{"ref":"Gen.26.34","start":1026034,"end":1026034,"break":"paragraph","ruby":[[6,1,"さい"],[8,1,"とき"],[18,1,"むすめ"],[31,1,"むすめ"],[38,1,"つま"]],"text":"エサウは四十歳の時、ヘテびとベエリの娘ユデテとヘテびとエロンの娘バスマテとを妻にめとった。"},{"ref":"Gen.26.35","start":1026035,"end":1026035,"break":"none","ruby":[[0,2,"かのじょ"],[16,1,"こころ"],[18,1,"いた"]],"text":"彼女たちはイサクとリベカにとって心の痛みとなった。"}]