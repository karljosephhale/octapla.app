[{"ref":"Job.22.1","start":18022001,"end":18022001,"break":"paragraph","ruby":[[13,1,"こた"],[16,1,"い"]],"text":"そこでテマンびとエリパズは答えて言った、"},{"ref":"Job.22.2","start":18022002,"end":18022002,"break":"stanza","breaks":[[20,"line"]],"ruby":[[1,1,"ひと"],[3,1,"かみ"],[5,1,"えき"],[20,1,"かしこ"],[22,1,"ひと"],[27,2,"じしん"],[30,1,"えき"]],"text":"「人は神を益することができるであろうか。賢い人も、ただ自身を益するのみである。"},{"ref":"Job.22.3","start":18022003,"end":18022003,"break":"line","breaks":[[24,"line"],[39,"line"]],"ruby":[[4,1,"ただ"],[10,3,"ぜんのうしゃ"],[17,1,"よろこ"],[28,2,"じぶん"],[31,1,"みち"],[33,1,"まっと"],[39,1,"かれ"],[44,2,"りえき"]],"text":"あなたが正しくても、全能者になんの喜びがあろう。あなたが自分の道を全うしても、彼になんの利益があろう。"},{"ref":"Job.22.4","start":18022004,"end":18022004,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"かみ"],[6,1,"かみ"],[8,1,"おそ"],[22,1,"せ"]],"text":"神はあなたが神を恐れることのゆえに、あなたを責め、あなたをさばかれるであろうか。"},{"ref":"Job.22.5","start":18022005,"end":18022005,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"あく"],[6,1,"おお"],[19,1,"つみ"]],"text":"あなたの悪は大きいではないか。あなたの罪は、はてしがない。"},{"ref":"Job.22.6","start":18022006,"end":18022006,"break":"line","breaks":[[19,"line"]],"ruby":[[8,2,"きょうだい"],[14,1,"しち"],[19,1,"はだか"],[21,1,"もの"],[23,2,"きもの"],[28,1,"と"]],"text":"あなたはゆえなく兄弟のものを質にとり、裸な者の着物をはぎ取り、"},{"ref":"Job.22.7","start":18022007,"end":18022007,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"つか"],[3,1,"もの"],[5,1,"みず"],[7,1,"の"],[12,1,"う"],[15,1,"もの"],[17,2,"しょくもつ"],[20,1,"あた"]],"text":"疲れた者に水を飲ませず、飢えた者に食物を与えなかった。"},{"ref":"Job.22.8","start":18022008,"end":18022008,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"ちから"],[3,1,"ひと"],[5,2,"とち"],[8,1,"え"],[10,1,"な"],[13,1,"ひと"],[20,1,"す"]],"text":"力ある人は土地を得、名ある人はそのうちに住んだ。"},{"ref":"Job.22.9","start":18022009,"end":18022009,"break":"line","breaks":[[18,"line"]],"ruby":[[13,1,"さ"],[23,1,"うで"],[25,1,"お"]],"text":"あなたは、やもめをむなしく去らせた。みなしごの腕は折られた。"},{"ref":"Job.22.10","start":18022010,"end":18022010,"break":"line","breaks":[[16,"line"]],"ruby":[[16,2,"きょうふ"],[28,1,"おどろ"]],"text":"それゆえ、わなはあなたをめぐり、恐怖は、にわかにあなたを驚かす。"},{"ref":"Job.22.11","start":18022011,"end":18022011,"break":"line","breaks":[[11,"line"],[25,"line"]],"ruby":[[4,1,"ひかり"],[6,1,"くら"],[15,1,"み"],[25,2,"おおみず"]],"text":"あなたの光は暗くされ、あなたは見ることができない。大水はあなたをおおうであろう。"},{"ref":"Job.22.12","start":18022012,"end":18022012,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[2,1,"てん"],[4,1,"たか"],[16,1,"み"],[21,1,"たか"],[23,1,"ほし"],[29,1,"たか"]],"text":"神は天に高くおられるではないか。見よ、いと高き星を。いかに高いことよ。"},{"ref":"Job.22.13","start":18022013,"end":18022013,"break":"line","breaks":[[24,"line"]],"ruby":[[7,1,"い"],[11,1,"かみ"],[13,1,"なに"],[15,1,"し"],[24,1,"かれ"],[26,2,"くろくも"],[29,1,"とお"]],"text":"それであなたは言う、『神は何を知っておられるか。彼は黒雲を通して、さばくことができるのか。"},{"ref":"Job.22.14","start":18022014,"end":18022014,"break":"line","breaks":[[13,"line"],[25,"line"]],"ruby":[[0,1,"こ"],[2,1,"くも"],[4,1,"かれ"],[9,1,"かく"],[13,1,"かれ"],[15,1,"み"],[25,1,"かれ"],[27,1,"てん"],[29,2,"おおぞら"],[32,1,"あゆ"]],"text":"濃い雲が彼をおおい隠すと、彼は見ることができない。彼は天の大空を歩まれるのだ』と。"},{"ref":"Job.22.15","start":18022015,"end":18022015,"break":"line","breaks":[[13,"line"]],"ruby":[[4,1,"あ"],[7,2,"ひとびと"],[10,1,"ふ"],[18,1,"みち"],[20,1,"まも"]],"text":"あなたは悪しき人々が踏んだいにしえの道を守ろうとするのか。"},{"ref":"Job.22.16","start":18022016,"end":18022016,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"かれ"],[3,1,"とき"],[11,1,"と"],[13,1,"さ"],[19,1,"もとい"],[21,1,"かわ"],[26,1,"お"],[28,1,"なが"]],"text":"彼らは時がこないうちに取り去られ、その基は川のように押し流された。"},{"ref":"Job.22.17","start":18022017,"end":18022017,"break":"line","breaks":[[25,"line"]],"ruby":[[0,1,"かれ"],[3,1,"かみ"],[5,1,"い"],[15,1,"はな"],[28,3,"ぜんのうしゃ"],[37,1,"なに"]],"text":"彼らは神に言った、『われわれを離れてください』と、また『全能者はわれわれに何をなしえようか』と。"},{"ref":"Job.22.18","start":18022018,"end":18022018,"break":"line","breaks":[[20,"line"],[31,"line"]],"ruby":[[3,1,"かみ"],[5,1,"かれ"],[8,1,"いえ"],[10,1,"よ"],[12,1,"もの"],[14,1,"み"],[23,2,"あくにん"],[26,1,"はか"],[39,1,"ところ"]],"text":"しかし神は彼らの家を良い物で満たされた。ただし悪人の計りごとはわたしのくみする所ではない。"},{"ref":"Job.22.19","start":18022019,"end":18022019,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ただ"],[3,1,"もの"],[8,1,"み"],[10,1,"よろこ"],[13,1,"つみ"],[16,1,"もの"],[18,1,"かれ"],[23,1,"わら"],[26,1,"い"]],"text":"正しい者はこれを見て喜び、罪なき者は彼らをあざ笑って言う、"},{"ref":"Job.22.20","start":18022020,"end":18022020,"break":"line","breaks":[[18,"line"]],"ruby":[[13,1,"ほろ"],[20,1,"のこ"],[23,1,"もの"],[25,1,"ひ"],[27,1,"や"],[29,1,"ほろ"]],"text":"『まことにわれわれのあだは滅ぼされ、その残した物は火で焼き滅ぼされた』と。"},{"ref":"Job.22.21","start":18022021,"end":18022021,"break":"stanza","breaks":[[20,"line"]],"ruby":[[4,1,"かみ"],[6,1,"やわ"],[11,2,"へいあん"],[14,1,"え"],[25,2,"こうふく"],[32,1,"く"]],"text":"あなたは神と和らいで、平安を得るがよい。そうすれば幸福があなたに来るでしょう。"},{"ref":"Job.22.22","start":18022022,"end":18022022,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"かれ"],[6,1,"くち"],[9,1,"おしえ"],[11,1,"う"],[16,2,"ことば"],[23,1,"こころ"]],"text":"どうか、彼の口から教を受け、その言葉をあなたの心におさめるように。"},{"ref":"Job.22.23","start":18022023,"end":18022023,"break":"line","breaks":[[24,"line"]],"ruby":[[6,3,"ぜんのうしゃ"],[10,1,"た"],[12,1,"かえ"],[20,1,"ひく"],[28,2,"てんまく"],[32,2,"ふぎ"],[35,1,"のぞ"],[37,1,"さ"]],"text":"あなたがもし全能者に立ち返って、おのれを低くし、あなたの天幕から不義を除き去り、"},{"ref":"Job.22.24","start":18022024,"end":18022024,"break":"line","breaks":[[12,"line"]],"ruby":[[7,1,"なか"],[9,1,"お"],[20,2,"たにがわ"],[23,1,"いし"],[25,1,"なか"],[27,1,"お"]],"text":"こがねをちりの中に置き、オフルのこがねを谷川の石の中に置き、"},{"ref":"Job.22.25","start":18022025,"end":18022025,"break":"line","breaks":[[15,"line"]],"ruby":[[0,3,"ぜんのうしゃ"],[19,2,"きちょう"]],"text":"全能者があなたのこがねとなり、あなたの貴重なしろがねとなるならば、"},{"ref":"Job.22.26","start":18022026,"end":18022026,"break":"line","breaks":[[15,"line"]],"ruby":[[2,1,"とき"],[8,3,"ぜんのうしゃ"],[12,1,"よろこ"],[15,1,"かみ"],[17,1,"む"],[21,1,"かお"]],"text":"その時、あなたは全能者を喜び、神に向かって顔をあげることができる。"},{"ref":"Job.22.27","start":18022027,"end":18022027,"break":"line","breaks":[[23,"line"]],"ruby":[[4,1,"かれ"],[6,1,"いの"],[12,1,"かれ"],[18,1,"き"],[30,2,"じぶん"],[33,1,"ちか"],[36,1,"はた"]],"text":"あなたが彼に祈るならば、彼はあなたに聞かれる。そしてあなたは自分の誓いを果す。"},{"ref":"Job.22.28","start":18022028,"end":18022028,"break":"line","breaks":[[17,"line"],[29,"line"]],"ruby":[[4,1,"こと"],[10,1,"さだ"],[23,1,"こと"],[25,2,"じょうじゅ"],[33,1,"みち"],[36,1,"ひかり"],[38,1,"かがや"]],"text":"あなたが事をなそうと定めるならば、あなたはその事を成就し、あなたの道には光が輝く。"},{"ref":"Job.22.29","start":18022029,"end":18022029,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かれ"],[2,1,"たか"],[5,1,"もの"],[7,1,"ひく"],[19,1,"もの"],[21,1,"すく"]],"text":"彼は高ぶる者を低くされるが、へりくだる者を救われるからだ。"},{"ref":"Job.22.30","start":18022030,"end":18022030,"break":"line","breaks":[[13,"line"],[30,"line"]],"ruby":[[0,1,"かれ"],[2,1,"つみ"],[6,1,"もの"],[8,1,"すく"],[19,1,"て"],[21,1,"いさぎよ"],[30,1,"すく"]],"text":"彼は罪のない者を救われる。あなたはその手の潔いことによって、救われるであろう」。"}]