[{"ref":"Isa.35.1","start":23035001,"end":23035001,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[0,2,"あらの"],[8,1,"ち"],[11,1,"たの"],[19,1,"よろこ"],[22,1,"はな"],[23,1,"さ"]],"text":"荒野と、かわいた地とは楽しみ、さばくは喜びて花咲き、さふらんのように、"},{"ref":"Isa.35.2","start":23035002,"end":23035002,"break":"line","breaks":[[8,"line"],[21,"line"],[37,"line"],[59,"line"]],"ruby":[[4,1,"はな"],[5,1,"さ"],[10,1,"よろこ"],[12,1,"たの"],[18,1,"うた"],[29,1,"さか"],[32,1,"あた"],[49,1,"うるわ"],[53,1,"あた"],[59,1,"かれ"],[62,1,"しゅ"],[64,2,"えいこう"],[67,1,"み"],[74,1,"かみ"],[76,1,"うるわ"],[80,1,"み"]],"text":"さかんに花咲き、かつ喜び楽しみ、かつ歌う。これにレバノンの栄えが与えられ、カルメルおよびシャロンの麗しさが与えられる。彼らは主の栄光を見、われわれの神の麗しさを見る。"},{"ref":"Isa.35.3","start":23035003,"end":23035003,"break":"paragraph","breaks":[[15,"line"]],"ruby":[[6,1,"よわ"],[9,1,"て"],[11,1,"つよ"],[22,1,"すこ"]],"text":"あなたがたは弱った手を強くし、よろめくひざを健やかにせよ。"},{"ref":"Isa.35.4","start":23035004,"end":23035004,"break":"line","breaks":[[10,"line"],[25,"line"],[45,"line"],[58,"line"]],"ruby":[[0,1,"こころ"],[5,1,"もの"],[7,1,"い"],[11,1,"つよ"],[16,1,"おそ"],[25,1,"み"],[34,1,"かみ"],[36,2,"ほうふく"],[42,1,"のぞ"],[45,1,"かみ"],[47,1,"むく"],[58,1,"かみ"],[60,1,"き"],[69,1,"すく"]],"text":"心おののく者に言え、「強くあれ、恐れてはならない。見よ、あなたがたの神は報復をもって臨み、神の報いをもってこられる。神は来て、あなたがたを救われる」と。"},{"ref":"Isa.35.5","start":23035005,"end":23035005,"break":"paragraph","breaks":[[14,"line"]],"ruby":[[2,1,"とき"],[4,1,"め"],[8,1,"め"],[10,1,"ひら"],[14,1,"みみ"],[18,1,"みみ"]],"text":"その時、目しいの目は開かれ、耳しいの耳はあけられる。"},{"ref":"Isa.35.6","start":23035006,"end":23035006,"break":"line","breaks":[[20,"line"],[30,"line"],[43,"line"]],"ruby":[[2,1,"とき"],[4,1,"あし"],[15,1,"と"],[17,1,"はし"],[23,1,"した"],[25,1,"よろこ"],[27,1,"うた"],[33,2,"あらの"],[36,1,"みず"],[47,1,"かわ"],[49,1,"なが"]],"text":"その時、足なえは、しかのように飛び走り、おしの舌は喜び歌う。それは荒野に水がわきいで、さばくに川が流れるからである。"},{"ref":"Isa.35.7","start":23035007,"end":23035007,"break":"line","breaks":[[10,"line"],[23,"line"],[34,"line"]],"ruby":[[0,1,"や"],[3,1,"すな"],[5,1,"いけ"],[14,1,"ち"],[16,1,"みず"],[18,1,"みなもと"],[23,2,"やまいぬ"],[26,1,"ふ"],[34,1,"あし"],[39,1,"しげ"],[43,1,"ところ"]],"text":"焼けた砂は池となり、かわいた地は水の源となり、山犬の伏したすみかは、葦、よしの茂りあう所となる。"},{"ref":"Isa.35.8","start":23035008,"end":23035008,"break":"paragraph","breaks":[[9,"line"],[25,"line"],[46,"line"]],"ruby":[[3,2,"おおじ"],[11,1,"みち"],[13,1,"せい"],[16,1,"みち"],[25,1,"けが"],[28,1,"もの"],[33,1,"とお"],[35,1,"す"],[46,1,"おろ"],[50,1,"もの"],[55,1,"まよ"],[57,1,"い"]],"text":"そこに大路があり、その道は聖なる道ととなえられる。汚れた者はこれを通り過ぎることはできない、愚かなる者はそこに迷い入ることはない。"},{"ref":"Isa.35.9","start":23035009,"end":23035009,"break":"line","breaks":[[12,"line"],[31,"line"],[46,"line"]],"ruby":[[12,1,"う"],[15,1,"けもの"],[20,1,"みち"],[33,1,"ところ"],[38,1,"あ"],[55,1,"もの"],[62,1,"あゆ"]],"text":"そこには、ししはおらず、飢えた獣も、その道にのぼることはなく、その所でこれに会うことはない。ただ、あがなわれた者のみ、そこを歩む。"},{"ref":"Isa.35.10","start":23035010,"end":23035010,"break":"line","breaks":[[16,"line"],[34,"line"],[48,"line"],[61,"line"]],"ruby":[[0,1,"しゅ"],[8,1,"もの"],[10,1,"かえ"],[18,1,"あたま"],[26,1,"よろこ"],[34,1,"うた"],[45,1,"く"],[48,1,"かれ"],[51,1,"たの"],[55,1,"よろこ"],[59,1,"え"],[61,1,"かな"],[65,1,"なげ"],[69,1,"に"],[71,1,"さ"]],"text":"主にあがなわれた者は帰ってきて、その頭に、とこしえの喜びをいただき、歌うたいつつ、シオンに来る。彼らは楽しみと喜びとを得、悲しみと嘆きとは逃げ去る。"}]