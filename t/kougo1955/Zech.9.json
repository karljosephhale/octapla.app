[{"ref":"Zech.9.1","start":38009001,"end":38009001,"break":"paragraph","breaks":[[2,"line"],[17,"line"],[29,"line"]],"ruby":[[0,2,"たくせん"],[2,1,"しゅ"],[4,2,"ことば"],[12,1,"ち"],[14,1,"のぞ"],[22,1,"うえ"],[33,2,"まちまち"],[46,2,"ぶぞく"],[52,1,"しゅ"],[54,1,"ぞく"]],"text":"託宣主の言葉はハデラクの地に臨み、ダマスコの上にとどまる。アラムの町々はイスラエルのすべての部族のように主に属するからである。"},{"ref":"Zech.9.2","start":38009002,"end":38009002,"break":"line","breaks":[[19,"line"]],"ruby":[[3,1,"さかい"],[19,2,"ひじょう"],[22,1,"かしこ"],[35,2,"どうよう"]],"text":"これに境するハマテもまたそのとおりだ。非常に賢いが、ツロとシドンもまた同様である。"},{"ref":"Zech.9.3","start":38009003,"end":38009003,"break":"line","breaks":[[17,"line"],[28,"line"]],"ruby":[[3,2,"じぶん"],[14,1,"きず"],[17,1,"ぎん"],[25,1,"つ"],[28,1,"きん"],[30,1,"みち"],[34,1,"どろ"],[39,1,"つ"]],"text":"ツロは自分のために、とりでを築き、銀をちりのように積み、金を道ばたの泥のように積んだ。"},{"ref":"Zech.9.4","start":38009004,"end":38009004,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[3,1,"み"],[6,1,"しゅ"],[11,1,"せ"],[13,1,"と"],[18,1,"とみ"],[20,1,"うみ"],[22,1,"なか"],[24,1,"な"],[26,1,"い"],[35,1,"ひ"],[37,1,"や"],[39,1,"ほろ"]],"text":"しかし見よ、主はこれを攻め取り、その富を海の中に投げ入れられる。これは火で焼き滅ぼされる。"},{"ref":"Zech.9.5","start":38009005,"end":38009005,"break":"line","breaks":[[14,"line"],[28,"line"],[44,"line"],[56,"line"],[65,"line"]],"ruby":[[9,1,"み"],[11,1,"おそ"],[19,1,"み"],[24,1,"くる"],[37,1,"のぞ"],[39,1,"ところ"],[52,1,"くる"],[60,1,"おう"],[62,1,"た"],[72,1,"す"],[74,1,"もの"]],"text":"アシケロンはこれを見て恐れ、ガザもまた見てもだえ苦しみ、エクロンもまたその望む所のものがはずかしめられて苦しむ。ガザには王が絶え、アシケロンには住む者がなくなり、"},{"ref":"Zech.9.6","start":38009006,"end":38009006,"break":"line","breaks":[[14,"line"]],"ruby":[[6,2,"こんけつ"],[9,1,"たみ"],[11,1,"す"],[25,1,"ほこり"],[27,1,"た"]],"text":"アシドドには混血の民が住む。わたしはペリシテびとの誇を断つ。"},{"ref":"Zech.9.7","start":38009007,"end":38009007,"break":"line","breaks":[[14,"line"],[32,"line"],[50,"line"],[63,"line"]],"ruby":[[4,1,"くち"],[7,1,"ち"],[9,1,"と"],[11,1,"のぞ"],[16,1,"は"],[18,1,"あいだ"],[21,1,"にく"],[25,1,"もの"],[27,1,"と"],[29,1,"のぞ"],[37,1,"のこ"],[45,1,"かみ"],[47,1,"き"],[53,1,"いち"],[54,2,"みんぞく"]],"text":"またその口から血を取り除き、その歯の間から憎むべき物を取り除く。これもまた残ってわれわれの神に帰し、ユダの一民族のようになる。またエクロンはエブスびとのようになる。"},{"ref":"Zech.9.8","start":38009008,"end":38009008,"break":"line","breaks":[[21,"line"],[42,"line"],[62,"line"]],"ruby":[[2,1,"とき"],[10,1,"いえ"],[15,1,"えい"],[17,1,"は"],[21,2,"みは"],[27,1,"い"],[29,1,"き"],[32,1,"もの"],[47,1,"もの"],[54,1,"とお"],[66,1,"いま"],[68,2,"じぶん"],[71,1,"め"],[73,1,"み"]],"text":"その時わたしは、わが家のために営を張って、見張りをし、行き来する者のないようにする。しえたげる者は、かさねて通ることがない。わたしが今、自分の目で見ているからである。"},{"ref":"Zech.9.9","start":38009009,"end":38009009,"break":"stanza","breaks":[[13,"line"],[27,"line"],[45,"line"],[60,"line"],[73,"line"]],"ruby":[[4,1,"むすめ"],[7,1,"おお"],[10,1,"よろこ"],[19,1,"むすめ"],[22,1,"よ"],[27,1,"み"],[34,1,"おう"],[40,1,"ところ"],[42,1,"く"],[45,1,"かれ"],[47,1,"ぎ"],[50,1,"もの"],[55,2,"しょうり"],[58,1,"え"],[60,2,"にゅうわ"],[70,1,"の"],[81,1,"こ"],[85,1,"こ"],[86,1,"うま"],[88,1,"の"]],"text":"シオンの娘よ、大いに喜べ、エルサレムの娘よ、呼ばわれ。見よ、あなたの王はあなたの所に来る。彼は義なる者であって勝利を得、柔和であって、ろばに乗る。すなわち、ろばの子である子馬に乗る。"},{"ref":"Zech.9.10","start":38009010,"end":38009010,"break":"line","breaks":[[17,"line"],[30,"line"],[43,"line"],[56,"line"],[69,"line"]],"ruby":[[11,2,"せんしゃ"],[14,1,"た"],[24,2,"ぐんば"],[27,1,"た"],[36,1,"ゆみ"],[38,1,"た"],[43,1,"かれ"],[45,2,"くにぐに"],[48,1,"たみ"],[50,2,"へいわ"],[53,1,"つ"],[58,2,"せいじ"],[61,1,"うみ"],[64,1,"うみ"],[66,1,"およ"],[69,2,"おおかわ"],[73,1,"ち"],[75,1,"はて"],[79,1,"およ"]],"text":"わたしはエフライムから戦車を断ち、エルサレムから軍馬を断つ。また、いくさ弓も断たれる。彼は国々の民に平和を告げ、その政治は海から海に及び、大川から地の果にまで及ぶ。"},{"ref":"Zech.9.11","start":38009011,"end":38009011,"break":"stanza","breaks":[[11,"line"],[25,"line"],[39,"line"]],"ruby":[[16,2,"けいやく"],[19,1,"ち"],[31,1,"みず"],[35,1,"あな"],[43,1,"とら"],[46,1,"びと"],[48,1,"と"],[50,1,"はな"]],"text":"あなたについてはまた、あなたとの契約の血のゆえに、わたしはかの水のない穴から、あなたの捕われ人を解き放す。"},{"ref":"Zech.9.12","start":38009012,"end":38009012,"break":"line","breaks":[[21,"line"],[37,"line"]],"ruby":[[0,1,"のぞ"],[6,1,"とら"],[9,1,"びと"],[16,1,"しろ"],[18,1,"かえ"],[31,1,"つ"],[34,1,"い"],[37,1,"かなら"],[39,1,"ばい"],[50,1,"かえ"]],"text":"望みをいだく捕われ人よ、あなたの城に帰れ。わたしはきょうもなお告げて言う、必ず倍して、あなたをもとに返すことを。"},{"ref":"Zech.9.13","start":38009013,"end":38009013,"break":"line","breaks":[[18,"line"],[31,"line"],[53,"line"],[66,"line"]],"ruby":[[7,1,"は"],[13,1,"ゆみ"],[26,1,"や"],[44,1,"こ"],[47,1,"よ"],[49,1,"おこ"],[58,2,"ひとびと"],[61,1,"せ"],[70,2,"ゆうし"]],"text":"わたしはユダを張って、わが弓となし、エフライムをその矢とした。シオンよ、わたしはあなたの子らを呼び起して、ギリシヤの人々を攻めさせ、あなたを勇士のつるぎのようにさせる。"},{"ref":"Zech.9.14","start":38009014,"end":38009014,"break":"line","breaks":[[15,"line"],[32,"line"],[47,"line"]],"ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,1,"かれ"],[9,1,"うえ"],[11,1,"あらわ"],[17,1,"や"],[27,1,"い"],[32,1,"しゅ"],[35,1,"かみ"],[41,1,"ふ"],[47,1,"みなみ"],[52,1,"かぜ"],[54,1,"の"],[57,1,"で"]],"text":"その時、主は彼らの上に現れて、その矢をいなずまのように射られる。主なる神はラッパを吹きならし、南のつむじ風に乗って出てこられる。"},{"ref":"Zech.9.15","start":38009015,"end":38009015,"break":"line","breaks":[[15,"line"],[35,"line"],[56,"line"],[69,"line"]],"ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"かれ"],[8,1,"まも"],[15,1,"かれ"],[18,1,"いし"],[19,1,"な"],[24,1,"く"],[26,1,"つく"],[29,1,"ふ"],[35,1,"かれ"],[43,1,"しゅ"],[48,1,"かれ"],[51,1,"ち"],[53,1,"の"],[56,1,"はち"],[64,1,"み"],[69,2,"さいだん"],[78,1,"ひた"]],"text":"万軍の主は彼らを守られるので、彼らは石投げどもを食い尽し、踏みつける。彼らはまたぶどう酒のように彼らの血を飲み、鉢のようにそれで満たされ、祭壇のすみのように浸される。"},{"ref":"Zech.9.16","start":38009016,"end":38009016,"break":"stanza","breaks":[[18,"line"],[32,"line"]],"ruby":[[2,1,"ひ"],[4,1,"かれ"],[7,1,"かみ"],[9,1,"しゅ"],[12,1,"かれ"],[15,1,"すく"],[20,1,"たみ"],[22,1,"ひつじ"],[27,1,"やしな"],[32,1,"かれ"],[35,1,"かんむり"],[37,1,"たま"],[45,1,"ち"],[47,1,"かがや"]],"text":"その日、彼らの神、主は、彼らを救い、その民を羊のように養われる。彼らは冠の玉のように、その地に輝く。"},{"ref":"Zech.9.17","start":38009017,"end":38009017,"break":"line","breaks":[[24,"line"],[35,"line"]],"ruby":[[9,1,"うるわ"],[24,2,"こくもつ"],[27,2,"わかもの"],[30,1,"さか"],[35,1,"あたら"],[41,1,"しゅ"],[48,1,"さか"]],"text":"そのさいわい、その麗しさは、いかばかりであろう。穀物は若者を栄えさせ、新しいぶどう酒は、おとめを栄えさせる。"}]