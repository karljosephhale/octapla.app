[{"ref":"Gen.19.1","start":1019001,"end":1019001,"break":"paragraph","ruby":[[7,1,"つかい"],[9,2,"ゆうぐれ"],[16,1,"つ"],[31,1,"もん"],[43,1,"かれ"],[46,1,"み"],[49,1,"た"],[52,1,"むか"],[55,1,"ち"],[57,1,"ふ"]],"text":"そのふたりのみ使は夕暮にソドムに着いた。そのときロトはソドムの門にすわっていた。ロトは彼らを見て、立って迎え、地に伏して、"},{"ref":"Gen.19.2","start":1019002,"end":1019002,"break":"none","ruby":[[0,1,"い"],[7,1,"しゅ"],[17,1,"いえ"],[19,2,"たちよ"],[23,1,"あし"],[25,1,"あら"],[29,1,"と"],[40,1,"あさ"],[41,1,"はや"],[43,1,"お"],[47,1,"た"],[55,1,"かれ"],[58,1,"い"],[71,2,"ひろば"],[74,1,"よ"],[76,1,"す"]],"text":"言った、「わが主よ、どうぞしもべの家に立寄って足を洗い、お泊まりください。そして朝早く起きてお立ちください」。彼らは言った、「いや、われわれは広場で夜を過ごします」。"},{"ref":"Gen.19.3","start":1019003,"end":1019003,"break":"none","ruby":[[9,1,"すす"],[15,1,"かれ"],[21,1,"かれ"],[23,1,"ところ"],[25,1,"よ"],[28,1,"いえ"],[38,1,"かれ"],[49,1,"もう"],[52,1,"たね"],[53,1,"い"],[59,1,"や"],[62,1,"た"]],"text":"しかしロトがしいて勧めたので、彼らはついに彼の所に寄り、家にはいった。ロトは彼らのためにふるまいを設け、種入れぬパンを焼いて食べさせた。"},{"ref":"Gen.19.4","start":1019004,"end":1019004,"break":"none","ruby":[[4,1,"かれ"],[7,1,"ね"],[18,1,"まち"],[20,2,"ひとびと"],[24,1,"わか"],[26,1,"もの"],[28,2,"ろうじん"],[32,1,"たみ"],[36,2,"しほう"],[45,1,"いえ"],[47,1,"かこ"]],"text":"ところが彼らの寝ないうちに、ソドムの町の人々は、若い者も老人も、民がみな四方からきて、その家を囲み、"},{"ref":"Gen.19.5","start":1019005,"end":1019005,"break":"none","ruby":[[3,1,"さけ"],[6,1,"い"],[11,2,"こんや"],[17,1,"ところ"],[21,2,"ひとびと"],[37,1,"だ"],[48,1,"かれ"],[51,1,"し"]],"text":"ロトに叫んで言った、「今夜おまえの所にきた人々はどこにいるか。それをここに出しなさい。われわれは彼らを知るであろう」。"},{"ref":"Gen.19.6","start":1019006,"end":1019006,"break":"none","ruby":[[3,2,"いりぐち"],[8,1,"かれ"],[11,1,"ところ"],[13,1,"で"],[15,1,"い"],[22,1,"と"],[24,1,"と"]],"text":"ロトは入口におる彼らの所に出て行き、うしろの戸を閉じて、"},{"ref":"Gen.19.7","start":1019007,"end":1019007,"break":"none","ruby":[[0,1,"い"],[5,2,"きょうだい"],[14,1,"わる"],[16,1,"こと"]],"text":"言った、「兄弟たちよ、どうか悪い事はしないでください。"},{"ref":"Gen.19.8","start":1019008,"end":1019008,"break":"none","ruby":[[6,1,"おとこ"],[8,1,"し"],[12,1,"むすめ"],[38,1,"だ"],[45,1,"す"],[65,2,"やね"],[68,1,"した"],[76,1,"ひと"],[82,1,"なに"]],"text":"わたしにまだ男を知らない娘がふたりあります。わたしはこれをあなたがたに、さし出しますから、好きなようにしてください。ただ、わたしの屋根の下にはいったこの人たちには、何もしないでください」。"},{"ref":"Gen.19.9","start":1019009,"end":1019009,"break":"none","ruby":[[0,1,"かれ"],[3,1,"い"],[8,1,"しりぞ"],[14,1,"い"],[21,1,"おとこ"],[23,1,"わた"],[30,1,"もの"],[63,1,"かれ"],[66,1,"くわ"],[77,1,"おお"],[80,1,"がい"],[82,1,"くわ"],[88,1,"かれ"],[94,1,"み"],[96,1,"はげ"],[99,1,"せま"],[102,1,"すす"],[104,1,"よ"],[107,1,"と"],[109,1,"やぶ"]],"text":"彼らは言った、「退け」。また言った、「この男は渡ってきたよそ者であるのに、いつも、さばきびとになろうとする。それで、われわれは彼らに加えるよりも、おまえに多くの害を加えよう」。彼らはロトの身に激しく迫り、進み寄って戸を破ろうとした。"},{"ref":"Gen.19.10","start":1019010,"end":1019010,"break":"none","ruby":[[2,1,"とき"],[10,1,"て"],[12,1,"の"],[18,1,"いえ"],[20,1,"うち"],[22,1,"ひ"],[24,1,"い"],[27,1,"と"],[29,1,"と"]],"text":"その時、かのふたりは手を伸べてロトを家の内に引き入れ、戸を閉じた。"},{"ref":"Gen.19.11","start":1019011,"end":1019011,"break":"none","ruby":[[3,1,"いえ"],[5,2,"いりぐち"],[10,2,"ひとびと"],[14,2,"ろうにゃく"],[17,1,"べつ"],[20,1,"う"],[23,1,"め"],[33,1,"かれ"],[36,2,"いりぐち"],[39,1,"さが"],[43,1,"つか"]],"text":"そして家の入口におる人々を、老若の別なく打って目をくらましたので、彼らは入口を捜すのに疲れた。"},{"ref":"Gen.19.12","start":1019012,"end":1019012,"break":"paragraph","ruby":[[7,1,"い"],[19,2,"みうち"],[22,1,"もの"],[44,1,"むすめ"],[50,1,"まち"],[58,2,"みうち"],[61,1,"もの"],[64,1,"みな"],[69,1,"つ"],[71,1,"だ"]],"text":"ふたりはロトに言った、「ほかにあなたの身内の者がここにおりますか。あなたのむこ、むすこ、娘およびこの町におるあなたの身内の者を、皆ここから連れ出しなさい。"},{"ref":"Gen.19.13","start":1019013,"end":1019013,"break":"none","ruby":[[7,1,"ところ"],[9,1,"ほろ"],[23,2,"ひとびと"],[26,1,"さけ"],[29,1,"しゅ"],[31,1,"まえ"],[33,1,"おお"],[39,1,"しゅ"],[43,1,"ところ"],[45,1,"ほろ"]],"text":"われわれがこの所を滅ぼそうとしているからです。人々の叫びが主の前に大きくなり、主はこの所を滅ぼすために、われわれをつかわされたのです」。"},{"ref":"Gen.19.14","start":1019014,"end":1019014,"break":"none","ruby":[[6,1,"で"],[8,1,"い"],[14,1,"むすめ"],[26,1,"つ"],[29,1,"い"],[34,1,"た"],[39,1,"ところ"],[42,1,"で"],[47,1,"しゅ"],[51,1,"まち"],[53,1,"ほろ"],[73,1,"たわむ"],[79,1,"おも"]],"text":"そこでロトは出て行って、その娘たちをめとるむこたちに告げて言った、「立ってこの所から出なさい。主がこの町を滅ぼされます」。しかしそれはむこたちには戯むれごとに思えた。"},{"ref":"Gen.19.15","start":1019015,"end":1019015,"break":"paragraph","ruby":[[0,1,"よ"],[2,1,"あ"],[7,1,"つかい"],[14,1,"うなが"],[17,1,"い"],[23,1,"た"],[36,1,"つま"],[42,1,"むすめ"],[45,1,"つ"],[47,1,"だ"],[67,1,"まち"],[69,2,"ふぎ"],[75,1,"ほろ"]],"text":"夜が明けて、み使たちはロトを促して言った　　「立って、ここにいるあなたの妻とふたりの娘とを連れ出しなさい。そうしなければ、あなたもこの町の不義のために滅ぼされるでしょう」。"},{"ref":"Gen.19.16","start":1019016,"end":1019016,"break":"none","ruby":[[0,1,"かれ"],[11,1,"しゅ"],[13,1,"かれ"],[20,1,"ほどこ"],[33,1,"かれ"],[35,1,"て"],[40,1,"つま"],[42,1,"て"],[49,1,"むすめ"],[51,1,"て"],[53,1,"と"],[56,1,"つ"],[58,1,"だ"],[61,1,"まち"],[63,1,"そと"],[65,1,"お"]],"text":"彼はためらっていたが、主は彼にあわれみを施されたので、かのふたりは彼の手と、その妻の手と、ふたりの娘の手を取って連れ出し、町の外に置いた。"},{"ref":"Gen.19.17","start":1019017,"end":1019017,"break":"none","ruby":[[0,1,"かれ"],[3,1,"そと"],[5,1,"つ"],[7,1,"だ"],[10,1,"とき"],[17,1,"い"],[27,2,"じぶん"],[30,1,"いのち"],[32,1,"すく"],[48,1,"み"],[56,2,"ていち"],[64,1,"た"],[66,1,"ど"],[76,1,"やま"],[97,1,"ほろ"]],"text":"彼らを外に連れ出した時そのひとりは言った、「のがれて、自分の命を救いなさい。うしろをふりかえって見てはならない。低地にはどこにも立ち止まってはならない。山にのがれなさい。そうしなければ、あなたは滅びます」。"},{"ref":"Gen.19.18","start":1019018,"end":1019018,"break":"none","ruby":[[3,1,"かれ"],[6,1,"い"],[13,1,"しゅ"]],"text":"ロトは彼らに言った、「わが主よ、どうか、そうさせないでください。"},{"ref":"Gen.19.19","start":1019019,"end":1019019,"break":"none","ruby":[[11,1,"まえ"],[13,1,"めぐ"],[16,1,"え"],[29,1,"いのち"],[31,1,"すく"],[35,1,"おお"],[45,1,"ほどこ"],[59,1,"やま"],[67,1,"こと"],[75,1,"わざわい"],[77,1,"み"],[79,1,"お"],[81,1,"せま"],[88,1,"し"]],"text":"しもべはすでにあなたの前に恵みを得ました。あなたはわたしの命を救って、大いなるいつくしみを施されました。しかしわたしは山まではのがれる事ができません。災が身に追い迫ってわたしは死ぬでしょう。"},{"ref":"Gen.19.20","start":1019020,"end":1019020,"break":"none","ruby":[[2,1,"まち"],[11,1,"に"],[18,1,"ちか"],[23,1,"ちい"],[26,1,"まち"],[54,1,"ちい"],[75,1,"いのち"],[77,1,"たす"]],"text":"あの町をごらんなさい。逃げていくのに近く、また小さい町です。どうかわたしをそこにのがれさせてください。それは小さいではありませんか。そうすればわたしの命は助かるでしょう」。"},{"ref":"Gen.19.21","start":1019021,"end":1019021,"break":"none","ruby":[[1,1,"つかい"],[3,1,"かれ"],[5,1,"い"],[16,1,"こと"],[23,1,"ねが"],[34,1,"い"],[38,1,"まち"],[40,1,"ほろ"]],"text":"み使は彼に言った、「わたしはこの事でもあなたの願いをいれて、あなたの言うその町は滅ぼしません。"},{"ref":"Gen.19.22","start":1019022,"end":1019022,"break":"none","ruby":[[0,1,"いそ"],[20,1,"つ"],[30,2,"なにごと"],[54,1,"まち"],[56,1,"な"],[62,1,"よ"]],"text":"急いでそこへのがれなさい。あなたがそこに着くまでは、わたしは何事もすることができません」。これによって、その町の名はゾアルと呼ばれた。"},{"ref":"Gen.19.23","start":1019023,"end":1019023,"break":"none","ruby":[[7,1,"つ"],[10,1,"とき"],[12,1,"ひ"],[14,1,"ち"],[16,1,"うえ"]],"text":"ロトがゾアルに着いた時、日は地の上にのぼった。"},{"ref":"Gen.19.24","start":1019024,"end":1019024,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"いおう"],[5,1,"ひ"],[8,1,"しゅ"],[10,1,"ところ"],[15,1,"てん"],[26,1,"うえ"],[28,1,"ふ"]],"text":"主は硫黄と火とを主の所すなわち天からソドムとゴモラの上に降らせて、"},{"ref":"Gen.19.25","start":1019025,"end":1019025,"break":"none","ruby":[[4,1,"まち"],[11,2,"ていち"],[17,2,"まちまち"],[24,2,"じゅうみん"],[30,1,"ち"],[37,1,"もの"],[45,1,"ほろ"]],"text":"これらの町と、すべての低地と、その町々のすべての住民と、その地にはえている物を、ことごとく滅ぼされた。"},{"ref":"Gen.19.26","start":1019026,"end":1019026,"break":"none","ruby":[[6,1,"つま"],[12,1,"かえり"],[17,1,"しお"],[19,1,"はしら"]],"text":"しかしロトの妻はうしろを顧みたので塩の柱になった。"},{"ref":"Gen.19.27","start":1019027,"end":1019027,"break":"none","ruby":[[6,1,"あさ"],[7,1,"はや"],[9,1,"お"],[15,1,"しゅ"],[17,1,"まえ"],[19,1,"た"],[22,1,"ところ"],[24,1,"い"]],"text":"アブラハムは朝早く起き、さきに主の前に立った所に行って、"},{"ref":"Gen.19.28","start":1019028,"end":1019028,"break":"none","ruby":[[8,1,"ほう"],[13,2,"ていち"],[16,2,"ぜんめん"],[27,1,"ち"],[29,1,"けむり"],[36,1,"けむり"],[41,1,"た"]],"text":"ソドムとゴモラの方、および低地の全面をながめると、その地の煙が、かまどの煙のように立ちのぼっていた。"},{"ref":"Gen.19.29","start":1019029,"end":1019029,"break":"paragraph","ruby":[[4,1,"かみ"],[6,2,"ていち"],[9,2,"まちまち"],[17,1,"とき"],[26,1,"す"],[31,2,"まちまち"],[34,1,"ほろ"],[39,1,"とき"],[41,1,"かみ"],[49,1,"おぼ"],[55,1,"ほろ"],[58,1,"なか"],[64,1,"すく"],[66,1,"だ"]],"text":"こうして神が低地の町々をこぼたれた時、すなわちロトの住んでいた町々を滅ぼされた時、神はアブラハムを覚えて、その滅びの中からロトを救い出された。"},{"ref":"Gen.19.30","start":1019030,"end":1019030,"break":"paragraph","ruby":[[7,1,"で"],[9,1,"のぼ"],[16,1,"むすめ"],[18,1,"とも"],[20,1,"やま"],[22,1,"す"],[30,1,"す"],[34,1,"おそ"],[43,1,"かれ"],[49,1,"むすめ"],[51,1,"とも"],[56,1,"あな"],[58,1,"なか"],[60,1,"す"]],"text":"ロトはゾアルを出て上り、ふたりの娘と共に山に住んだ。ゾアルに住むのを恐れたからである。彼はふたりの娘と共に、ほら穴の中に住んだ。"},{"ref":"Gen.19.31","start":1019031,"end":1019031,"break":"none","ruby":[[0,1,"とき"],[2,1,"あね"],[4,1,"いもうと"],[6,1,"い"],[17,1,"ちち"],[19,1,"お"],[26,1,"ち"],[29,1,"よ"],[46,1,"ところ"],[48,1,"く"],[50,1,"おとこ"]],"text":"時に姉が妹に言った、「わたしたちの父は老い、またこの地には世のならわしのように、わたしたちの所に来る男はいません。"},{"ref":"Gen.19.32","start":1019032,"end":1019032,"break":"none","ruby":[[3,1,"ちち"],[5,1,"さけ"],[7,1,"の"],[11,1,"とも"],[13,1,"ね"],[16,1,"ちち"],[21,1,"こ"],[23,1,"のこ"]],"text":"さあ、父に酒を飲ませ、共に寝て、父によって子を残しましょう」。"},{"ref":"Gen.19.33","start":1019033,"end":1019033,"break":"none","ruby":[[0,2,"かのじょ"],[7,1,"よ"],[9,1,"ちち"],[11,1,"さけ"],[13,1,"の"],[17,1,"あね"],[23,1,"ちち"],[25,1,"とも"],[27,1,"ね"],[33,1,"むすめ"],[35,1,"ね"],[40,1,"お"],[45,1,"し"]],"text":"彼女たちはその夜、父に酒を飲ませ、姉がはいって父と共に寝た。ロトは娘が寝たのも、起きたのも知らなかった。"},{"ref":"Gen.19.34","start":1019034,"end":1019034,"break":"none","ruby":[[3,1,"ひ"],[5,1,"あね"],[7,1,"いもうと"],[9,1,"い"],[18,2,"さくや"],[21,1,"ちち"],[23,1,"ね"],[34,2,"こんや"],[39,1,"ちち"],[41,1,"さけ"],[43,1,"の"],[62,1,"とも"],[64,1,"ね"],[75,1,"ちち"],[80,1,"こ"],[82,1,"のこ"]],"text":"あくる日、姉は妹に言った、「わたしは昨夜、父と寝ました。わたしたちは今夜もまた父に酒を飲ませましょう。そしてあなたがはいって共に寝なさい。わたしたちは父によって子を残しましょう」。"},{"ref":"Gen.19.35","start":1019035,"end":1019035,"break":"none","ruby":[[0,1,"かれ"],[5,1,"よ"],[9,1,"ちち"],[11,1,"さけ"],[13,1,"の"],[17,1,"いもうと"],[19,1,"い"],[22,1,"ちち"],[24,1,"とも"],[26,1,"ね"],[32,1,"むすめ"],[34,1,"ね"],[39,1,"お"],[44,1,"し"]],"text":"彼らはその夜もまた父に酒を飲ませ、妹が行って父と共に寝た。ロトは娘の寝たのも、起きたのも知らなかった。"},{"ref":"Gen.19.36","start":1019036,"end":1019036,"break":"none","ruby":[[11,1,"むすめ"],[15,1,"ちち"]],"text":"こうしてロトのふたりの娘たちは父によってはらんだ。"},{"ref":"Gen.19.37","start":1019037,"end":1019037,"break":"none","ruby":[[0,1,"あね"],[1,1,"むすめ"],[3,1,"こ"],[5,1,"う"],[10,1,"な"],[16,1,"な"],[24,1,"いま"],[32,2,"せんぞ"]],"text":"姉娘は子を産み、その名をモアブと名づけた。これは今のモアブびとの先祖である。"},{"ref":"Gen.19.38","start":1019038,"end":1019038,"break":"none","ruby":[[0,1,"いもうと"],[4,1,"こ"],[6,1,"う"],[12,1,"な"],[20,1,"な"],[28,1,"いま"],[37,2,"せんぞ"]],"text":"妹もまた子を産んで、その名をベニアンミと名づけた。これは今のアンモンびとの先祖である。"}]