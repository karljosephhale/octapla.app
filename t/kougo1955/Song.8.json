[{"ref":"Song.8.1","start":22008001,"end":22008001,"break":"paragraph","breaks":[[9,"line"],[20,"line"],[36,"line"],[52,"line"],[63,"line"]],"ruby":[[11,1,"はは"],[13,1,"ち"],[17,1,"す"],[22,2,"きょうだい"],[47,1,"あ"],[56,1,"くち"]],"text":"どうか、あなたは、わが母の乳ぶさを吸ったわが兄弟のようになってください。わたしがそとであなたに会うとき、あなたに口づけしても、だれもわたしをいやしめないでしょう。"},{"ref":"Song.8.2","start":22008002,"end":22008002,"break":"line","breaks":[[21,"line"],[37,"line"],[56,"line"]],"ruby":[[8,1,"みちび"],[14,1,"はは"],[16,1,"いえ"],[18,1,"い"],[25,1,"う"],[28,1,"もの"],[37,2,"こうりょう"],[47,1,"しゅ"],[53,1,"えき"],[60,1,"の"]],"text":"わたしはあなたを導いて、わが母の家に行き、わたしを産んだ者のへやにはいり、香料のはいったぶどう酒、ざくろの液を、あなたに飲ませましょう。"},{"ref":"Song.8.3","start":22008003,"end":22008003,"break":"line","breaks":[[21,"line"]],"ruby":[[4,1,"かれ"],[6,1,"ひだり"],[8,1,"て"],[14,1,"あたま"],[16,1,"した"],[21,1,"みぎ"],[23,1,"て"],[29,1,"だ"]],"text":"どうか、彼の左の手がわたしの頭の下にあり、右の手がわたしを抱いてくれるように。"},{"ref":"Song.8.4","start":22008004,"end":22008004,"break":"line","breaks":[[11,"line"],[30,"line"],[45,"line"],[58,"line"]],"ruby":[[6,1,"むすめ"],[21,1,"ちか"],[25,1,"ねが"],[30,1,"あい"],[37,1,"おこ"],[50,1,"よ"],[52,1,"おこ"]],"text":"エルサレムの娘たちよ、わたしはあなたがたに誓い、お願いする、愛のおのずから起るときまでは、ことさらに呼び起すことも、さますこともしないように。"},{"ref":"Song.8.5","start":22008005,"end":22008005,"break":"stanza","breaks":[[15,"line"],[32,"stanza"],[56,"line"],[69,"line"],[86,"line"]],"ruby":[[0,2,"じぶん"],[3,1,"あい"],[6,1,"もの"],[15,2,"あらの"],[19,1,"のぼ"],[22,1,"く"],[24,1,"もの"],[36,1,"き"],[38,1,"した"],[49,1,"よ"],[60,2,"ははうえ"],[76,1,"う"],[79,1,"くる"],[90,1,"う"],[93,1,"もの"],[100,1,"う"],[103,1,"くる"]],"text":"自分の愛する者によりかかって、荒野から上って来る者はだれですか。りんごの木の下で、わたしはあなたを呼びさました。あなたの母上は、かしこで、あなたのために産みの苦しみをなし、あなたの産んだ者が、かしこで産みの苦しみをした。"},{"ref":"Song.8.6","start":22008006,"end":22008006,"break":"stanza","breaks":[[20,"line"],[41,"line"],[51,"line"],[68,"line"]],"ruby":[[8,1,"こころ"],[10,1,"お"],[13,1,"いん"],[24,1,"うで"],[26,1,"お"],[29,1,"いん"],[41,1,"あい"],[43,1,"し"],[48,1,"つよ"],[55,1,"はか"],[60,2,"ざんこく"],[75,1,"ひ"],[82,1,"もっと"],[88,1,"ほのお"]],"text":"わたしをあなたの心に置いて印のようにし、あなたの腕に置いて印のようにしてください。愛は死のように強く、ねたみは墓のように残酷だからです。そのきらめきは火のきらめき、最もはげしい炎です。"},{"ref":"Song.8.7","start":22008007,"end":22008007,"break":"line","breaks":[[15,"line"],[32,"line"],[52,"line"],[65,"line"]],"ruby":[[0,1,"あい"],[2,2,"おおみず"],[5,1,"け"],[15,2,"こうずい"],[34,1,"ひと"],[38,1,"いえ"],[40,2,"ざいさん"],[48,1,"あた"],[52,1,"あい"],[54,1,"か"]],"text":"愛は大水も消すことができない、洪水もおぼれさせることができない。もし人がその家の財産をことごとく与えて、愛に換えようとするならば、いたくいやしめられるでしょう。"},{"ref":"Song.8.8","start":22008008,"end":22008008,"break":"stanza","breaks":[[23,"line"],[40,"line"]],"ruby":[[6,1,"ちい"],[9,1,"いもうと"],[16,1,"ち"],[29,1,"いもうと"],[31,2,"えんだん"],[36,1,"ひ"],[40,2,"かのじょ"],[46,1,"なに"]],"text":"わたしたちに小さい妹がある、まだ乳ぶさがない。わたしたちの妹に縁談のある日には、彼女のために何をしてやろうか。"},{"ref":"Song.8.9","start":22008009,"end":22008009,"break":"line","breaks":[[24,"line"]],"ruby":[[0,2,"かのじょ"],[3,2,"じょうへき"],[13,1,"うえ"],[15,1,"ぎん"],[17,1,"とう"],[19,1,"た"],[24,2,"かのじょ"],[27,1,"と"],[34,2,"こうはく"],[37,1,"いた"],[42,1,"かこ"]],"text":"彼女が城壁であるなら、その上に銀の塔を建てよう。彼女が戸であるなら、香柏の板でそれを囲もう。"},{"ref":"Song.8.10","start":22008010,"end":22008010,"break":"stanza","breaks":[[16,"line"],[29,"line"],[42,"line"]],"ruby":[[4,2,"じょうへき"],[11,1,"ち"],[36,1,"かれ"],[38,1,"め"],[42,2,"へいわ"],[49,1,"もの"]],"text":"わたしは城壁、わたしの乳ぶさは、やぐらのようでありました。それでわたしは彼の目には、平和をもたらす者のようでありました。"},{"ref":"Song.8.11","start":22008011,"end":22008011,"break":"stanza","breaks":[[23,"line"],[42,"line"]],"ruby":[[15,1,"えん"],[23,1,"かれ"],[28,1,"えん"],[31,1,"まも"],[33,1,"もの"],[48,1,"み"],[53,1,"ぎん"],[57,1,"おさ"]],"text":"ソロモンはバアルハモンにぶどう園をもっていた。彼はぶどう園を、守る者どもにあずけて、おのおのその実のために銀一千を納めさせた。"},{"ref":"Song.8.12","start":22008012,"end":22008012,"break":"line","breaks":[[24,"line"],[44,"line"]],"ruby":[[12,1,"えん"],[19,1,"まえ"],[37,1,"え"],[46,1,"み"],[48,1,"まも"],[50,1,"もの"],[57,1,"え"]],"text":"わたしのものであるぶどう園は、わたしの前にある。ソロモンよ、あなたは一千を獲るでしょう、その実を守る者どもは二百を獲るでしょう。"},{"ref":"Song.8.13","start":22008013,"end":22008013,"break":"stanza","breaks":[[9,"line"],[30,"line"]],"ruby":[[0,1,"その"],[2,1,"なか"],[4,1,"す"],[6,1,"もの"],[13,1,"とも"],[21,1,"こえ"],[23,1,"みみ"],[25,1,"かたむ"],[41,1,"き"]],"text":"園の中に住む者よ、わたしの友だちはあなたの声に耳を傾けます、どうぞ、それをわたしに聞かせてください。"},{"ref":"Song.8.14","start":22008014,"end":22008014,"break":"stanza","breaks":[[16,"line"],[36,"line"]],"ruby":[[2,1,"あい"],[5,1,"もの"],[8,1,"いそ"],[21,2,"やまやま"],[24,1,"うえ"],[38,1,"わか"],[40,1,"お"]],"text":"わが愛する者よ、急いでください。かんばしい山々の上で、かもしかのように、また若い雄じかのようになってください。"}]