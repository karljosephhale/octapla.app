[{"ref":"Judg.6.1","start":7006001,"end":7006001,"break":"paragraph","ruby":[[6,2,"ひとびと"],[11,1,"しゅ"],[13,1,"まえ"],[15,1,"あく"],[25,1,"しゅ"],[27,1,"かれ"],[31,1,"ねん"],[33,1,"あいだ"],[41,1,"て"]],"text":"イスラエルの人々はまた主の前に悪をおこなったので、主は彼らを七年の間ミデアンびとの手にわたされた。"},{"ref":"Judg.6.2","start":7006002,"end":7006002,"break":"none","ruby":[[7,1,"て"],[15,1,"か"],[25,2,"ひとびと"],[39,1,"やま"],[43,2,"いわや"],[49,1,"あな"],[51,2,"ようがい"],[55,2,"じぶん"],[63,1,"つく"]],"text":"ミデアンびとの手はイスラエルに勝った。イスラエルの人々はミデアンびとのゆえに、山にある岩屋と、ほら穴と要害とを自分たちのために造った。"},{"ref":"Judg.6.3","start":7006003,"end":7006003,"break":"none","ruby":[[8,1,"たね"],[13,1,"とき"],[36,2,"とうほう"],[39,1,"たみ"],[41,1,"のぼ"],[54,1,"おそ"]],"text":"イスラエルびとが種をまいた時には、いつもミデアンびと、アマレクびとおよび東方の民が上ってきてイスラエルびとを襲い、"},{"ref":"Judg.6.4","start":7006004,"end":7006004,"break":"none","ruby":[[8,1,"む"],[12,1,"じん"],[14,1,"と"],[17,1,"ち"],[19,2,"さんぶつ"],[22,1,"あら"],[28,2,"ふきん"],[33,1,"およ"],[45,1,"いのち"],[52,1,"もの"],[54,1,"のこ"],[58,1,"ひつじ"],[60,1,"うし"],[65,1,"のこ"]],"text":"イスラエルびとに向かって陣を取り、地の産物を荒してガザの附近にまで及び、イスラエルのうちに命をつなぐべき物を残さず、羊も牛もろばも残さなかった。"},{"ref":"Judg.6.5","start":7006005,"end":7006005,"break":"none","ruby":[[0,1,"かれ"],[3,2,"かちく"],[6,2,"てんまく"],[9,1,"たずさ"],[20,1,"おお"],[22,1,"のぼ"],[37,1,"かれ"],[46,2,"むすう"],[53,1,"かれ"],[56,1,"くに"],[58,1,"あら"]],"text":"彼らが家畜と天幕を携えて、いなごのように多く上ってきたからである。すなわち彼らとそのらくだは無数であって、彼らは国を荒すためにはいってきたのであった。"},{"ref":"Judg.6.6","start":7006006,"end":7006006,"break":"none","ruby":[[20,2,"ひじょう"],[23,1,"おとろ"],[32,2,"ひとびと"],[35,1,"しゅ"],[37,1,"よ"]],"text":"こうしてイスラエルはミデアンびとのために非常に衰え、イスラエルの人々は主に呼ばわった。"},{"ref":"Judg.6.7","start":7006007,"end":7006007,"break":"paragraph","ruby":[[6,2,"ひとびと"],[20,1,"しゅ"],[22,1,"よ"]],"text":"イスラエルの人々がミデアンびとのゆえに、主に呼ばわったとき、"},{"ref":"Judg.6.8","start":7006008,"end":7006008,"break":"none","ruby":[[0,1,"しゅ"],[6,3,"よげんしゃ"],[16,2,"ひとびと"],[24,1,"かれ"],[27,1,"い"],[39,1,"かみ"],[41,1,"しゅ"],[45,1,"い"],[70,1,"みちび"],[72,1,"のぼ"],[81,2,"どれい"],[84,1,"いえ"],[87,1,"たずさ"],[89,1,"だ"]],"text":"主はひとりの預言者をイスラエルの人々につかわして彼らに言われた、「イスラエルの神、主はこう言われる、『わたしはかつてあなたがたをエジプトから導き上り、あなたがたを奴隷の家から携え出し、"},{"ref":"Judg.6.9","start":7006009,"end":7006009,"break":"none","ruby":[[7,1,"て"],[25,1,"もの"],[27,1,"て"],[30,1,"すく"],[32,1,"だ"],[41,1,"まえ"],[44,1,"かれ"],[47,1,"お"],[49,1,"はら"],[55,1,"くに"],[63,1,"あた"]],"text":"エジプトびとの手およびすべてあなたがたをしえたげる者の手から救い出し、あなたがたの前から彼らを追い払って、その国をあなたがたに与えた。"},{"ref":"Judg.6.10","start":7006010,"end":7006010,"break":"none","ruby":[[9,1,"い"],[24,1,"かみ"],[26,1,"しゅ"],[37,1,"す"],[42,1,"くに"],[50,2,"かみがみ"],[53,1,"おそ"],[78,2,"ことば"],[81,1,"したが"]],"text":"そしてあなたがたに言った、「わたしはあなたがたの神、主である。あなたがたが住んでいる国のアモリびとの神々を恐れてはならない」と。しかし、あなたがたはわたしの言葉に従わなかった』」。"},{"ref":"Judg.6.11","start":7006011,"end":7006011,"break":"paragraph","ruby":[[2,1,"しゅ"],[4,1,"つかい"],[20,1,"ぞく"],[34,1,"き"],[36,1,"した"],[38,1,"ざ"],[42,1,"とき"],[48,1,"こ"],[61,1,"め"],[63,1,"さ"],[69,1,"さか"],[73,1,"なか"],[75,1,"むぎ"],[77,1,"う"]],"text":"さて主の使がきて、アビエゼルびとヨアシに属するオフラにあるテレビンの木の下に座した。時にヨアシの子ギデオンはミデアンびとの目を避けるために酒ぶねの中で麦を打っていたが、"},{"ref":"Judg.6.12","start":7006012,"end":7006012,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"つかい"],[4,1,"かれ"],[6,1,"あらわ"],[9,1,"い"],[14,1,"だい"],[15,2,"ゆうし"],[19,1,"しゅ"],[25,1,"とも"]],"text":"主の使は彼に現れて言った、「大勇士よ、主はあなたと共におられます」。"},{"ref":"Judg.6.13","start":7006013,"end":7006013,"break":"none","ruby":[[5,1,"い"],[13,1,"きみ"],[16,1,"しゅ"],[24,1,"とも"],[42,1,"こと"],[50,1,"のぞ"],[65,2,"せんぞ"],[69,1,"しゅ"],[82,1,"みちび"],[84,1,"のぼ"],[105,1,"つ"],[114,3,"ふしぎ"],[131,1,"いま"],[133,1,"しゅ"],[141,1,"す"],[152,1,"て"]],"text":"ギデオンは言った、「ああ、君よ、主がわたしたちと共におられるならば、どうしてこれらの事がわたしたちに臨んだのでしょう。わたしたちの先祖が『主はわれわれをエジプトから導き上られたではないか』といって、わたしたちに告げたそのすべての不思議なみわざはどこにありますか。今、主はわたしたちを捨てて、ミデアンびとの手にわたされました」。"},{"ref":"Judg.6.14","start":7006014,"end":7006014,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"む"],[7,1,"かれ"],[9,1,"い"],[25,1,"ちから"],[30,1,"い"],[41,1,"て"],[50,1,"すく"],[52,1,"だ"]],"text":"主はふり向いて彼に言われた、「あなたはこのあなたの力をもって行って、ミデアンびとの手からイスラエルを救い出しなさい。わたしがあなたをつかわすのではありませんか」。"},{"ref":"Judg.6.15","start":7006015,"end":7006015,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"い"],[14,1,"しゅ"],[31,1,"すく"],[48,2,"しぞく"],[58,1,"もっと"],[60,1,"よわ"],[77,1,"ちち"],[79,2,"かぞく"],[85,1,"もっと"],[87,1,"ちい"]],"text":"ギデオンは主に言った、「ああ主よ、わたしはどうしてイスラエルを救うことができましょうか。わたしの氏族はマナセのうちで最も弱いものです。わたしはまたわたしの父の家族のうちで最も小さいものです」。"},{"ref":"Judg.6.16","start":7006016,"end":7006016,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"い"],[20,1,"とも"],[31,1,"う"],[43,1,"う"]],"text":"主は言われた、「しかし、わたしがあなたと共におるから、ひとりを撃つようにミデアンびとを撃つことができるでしょう」。"},{"ref":"Judg.6.17","start":7006017,"end":7006017,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"い"],[24,1,"まえ"],[26,1,"めぐ"],[29,1,"え"],[46,1,"かた"],[63,1,"み"]],"text":"ギデオンはまた主に言った、「わたしがもしあなたの前に恵みを得ていますならば、どうぞ、わたしと語るのがあなたであるというしるしを見せてください。"},{"ref":"Judg.6.18","start":7006018,"end":7006018,"break":"none","ruby":[[8,1,"そな"],[10,1,"もの"],[12,1,"たずさ"],[33,1,"まえ"],[35,1,"そな"],[44,1,"さ"],[55,1,"しゅ"],[57,1,"い"],[75,1,"く"],[79,1,"ま"]],"text":"どうぞ、わたしが供え物を携えてあなたのもとにもどってきて、あなたの前に供えるまで、ここを去らないでください」。主は言われた、「わたしはあなたがもどって来るまで待ちましょう」。"},{"ref":"Judg.6.19","start":7006019,"end":7006019,"break":"paragraph","ruby":[[8,2,"じぶん"],[11,1,"いえ"],[13,1,"い"],[20,1,"こ"],[22,1,"ととの"],[29,1,"こな"],[31,1,"たね"],[32,1,"い"],[42,1,"にく"],[47,1,"い"],[58,1,"も"],[66,1,"き"],[68,1,"した"],[72,1,"かれ"],[77,1,"も"],[86,1,"そな"]],"text":"そこでギデオンは自分の家に行って、やぎの子を整え、一エパの粉で種入れぬパンをつくり、肉をかごに入れ、あつものをつぼに盛り、テレビンの木の下におる彼のもとに持ってきて、それを供えた。"},{"ref":"Judg.6.20","start":7006020,"end":7006020,"break":"none","ruby":[[0,1,"かみ"],[2,1,"つかい"],[4,1,"かれ"],[6,1,"い"],[11,1,"にく"],[13,1,"たね"],[14,1,"い"],[26,1,"いわ"],[28,1,"うえ"],[30,1,"お"],[41,1,"そそ"],[48,1,"かれ"]],"text":"神の使は彼に言った、「肉と種入れぬパンをとって、この岩の上に置き、それにあつものを注ぎなさい」。彼はそのようにした。"},{"ref":"Judg.6.21","start":7006021,"end":7006021,"break":"none","ruby":[[3,1,"しゅ"],[5,1,"つかい"],[7,1,"て"],[17,1,"さき"],[19,1,"だ"],[23,1,"にく"],[25,1,"たね"],[26,1,"い"],[32,1,"ふ"],[37,1,"いわ"],[40,1,"ひ"],[42,1,"も"],[49,1,"にく"],[51,1,"たね"],[52,1,"い"],[59,1,"や"],[69,1,"しゅ"],[71,1,"つかい"],[73,1,"さ"],[76,1,"み"]],"text":"すると主の使が手にもっていたつえの先を出して、肉と種入れぬパンに触れると、岩から火が燃えあがって、肉と種入れぬパンとを焼きつくした。そして主の使は去って見えなくなった。"},{"ref":"Judg.6.22","start":7006022,"end":7006022,"break":"none","ruby":[[7,1,"ひと"],[9,1,"しゅ"],[11,1,"つかい"],[23,1,"い"],[30,1,"しゅ"],[33,1,"かみ"],[51,1,"かお"],[57,1,"しゅ"],[59,1,"つかい"],[61,1,"み"]],"text":"ギデオンはその人が主の使であったことをさとって言った、「ああ主なる神よ、どうなることでしょう。わたしは顔をあわせて主の使を見たのですから」。"},{"ref":"Judg.6.23","start":7006023,"end":7006023,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[4,1,"い"],[10,2,"あんしん"],[15,1,"おそ"],[24,1,"し"]],"text":"主は彼に言われた、「安心せよ、恐れるな。あなたは死ぬことはない」。"},{"ref":"Judg.6.24","start":7006024,"end":7006024,"break":"none","ruby":[[8,1,"しゅ"],[13,2,"さいだん"],[19,1,"きず"],[27,1,"しゅ"],[29,2,"へいあん"],[33,1,"な"],[41,2,"こんにち"]],"text":"そこでギデオンは主のために祭壇をそこに築いて、それを「主は平安」と名づけた。これは今日までアビエゼルびとのオフラにある。"},{"ref":"Judg.6.25","start":7006025,"end":7006025,"break":"paragraph","ruby":[[2,1,"よ"],[4,1,"しゅ"],[11,1,"い"],[21,1,"ちち"],[23,2,"おうし"],[27,1,"さい"],[29,1,"だい"],[32,2,"おうし"],[36,1,"と"],[43,1,"ちち"],[54,2,"さいだん"],[57,1,"う"],[75,1,"ぞう"],[77,1,"き"],[79,1,"たお"]],"text":"その夜、主はギデオンに言われた、「あなたの父の雄牛と七歳の第二の雄牛とを取り、あなたの父のもっているバアルの祭壇を打ちこわし、そのかたわらにあるアシラ像を切り倒し、"},{"ref":"Judg.6.26","start":7006026,"end":7006026,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[18,1,"いただき"],[21,1,"いし"],[23,1,"なら"],[26,2,"さいだん"],[29,1,"きず"],[32,1,"だい"],[35,2,"おうし"],[38,1,"と"],[45,1,"き"],[47,1,"たお"],[54,1,"き"],[59,2,"はんさい"]],"text":"あなたの神、主のために、このとりでの頂に、石を並べて祭壇を築き、第二の雄牛を取り、あなたが切り倒したアシラの木をもって燔祭をささげなさい」。"},{"ref":"Judg.6.27","start":7006027,"end":7006027,"break":"none","ruby":[[9,1,"にん"],[11,1,"つ"],[15,1,"しゅ"],[17,1,"い"],[34,1,"かれ"],[36,1,"ちち"],[38,2,"かぞく"],[47,1,"まち"],[49,2,"ひとびと"],[52,1,"おそ"],[58,1,"ひる"],[62,1,"おこな"],[71,1,"よる"],[75,1,"おこな"]],"text":"ギデオンはしもべ十人を連れて、主が言われたとおりにおこなった。ただし彼は父の家族のもの、および町の人々を恐れたので、昼それを行うことができず、夜それを行った。"},{"ref":"Judg.6.28","start":7006028,"end":7006028,"break":"paragraph","ruby":[[0,1,"まち"],[2,2,"ひとびと"],[5,1,"あさ"],[6,1,"はや"],[8,1,"お"],[11,1,"み"],[19,2,"さいだん"],[22,1,"う"],[39,1,"ぞう"],[41,1,"き"],[43,1,"たお"],[47,1,"あら"],[50,1,"きず"],[53,2,"さいだん"],[56,1,"うえ"],[59,1,"だい"],[62,2,"おうし"]],"text":"町の人々が朝早く起きて見ると、バアルの祭壇は打ちこわされ、そのかたわらのアシラ像は切り倒され、新たに築いた祭壇の上に、第二の雄牛がささげられてあった。"},{"ref":"Judg.6.29","start":7006029,"end":7006029,"break":"none","ruby":[[3,1,"かれ"],[6,1,"たがい"],[21,1,"い"],[24,1,"と"],[26,1,"たず"],[40,1,"こ"],[52,1,"い"]],"text":"そこで彼らは互に「これはだれのしわざか」と言って問い尋ねたすえ、「これはヨアシの子ギデオンのしわざだ」と言った。"},{"ref":"Judg.6.30","start":7006030,"end":7006030,"break":"none","ruby":[[0,1,"まち"],[2,2,"ひとびと"],[9,1,"い"],[22,1,"ひ"],[24,1,"だ"],[27,1,"ころ"],[33,1,"かれ"],[39,2,"さいだん"],[42,1,"う"],[60,1,"ぞう"],[62,1,"き"],[64,1,"たお"]],"text":"町の人々はヨアシに言った、「あなたのむすこを引き出して殺しなさい。彼はバアルの祭壇を打ちこわしそのかたわらにあったアシラ像を切り倒したのです」。"},{"ref":"Judg.6.31","start":7006031,"end":7006031,"break":"none","ruby":[[7,2,"じぶん"],[10,1,"む"],[14,1,"た"],[23,1,"もの"],[25,1,"い"],[43,1,"い"],[45,1,"あらそ"],[56,1,"かれ"],[58,2,"べんご"],[79,1,"い"],[81,1,"あらそ"],[83,1,"もの"],[89,1,"あさ"],[93,1,"ころ"],[108,1,"かみ"],[116,2,"じぶん"],[119,2,"さいだん"],[122,1,"う"],[134,1,"かれ"],[139,1,"い"],[141,1,"あらそ"]],"text":"しかしヨアシは自分に向かって立っているすべての者に言った、「あなたがたはバアルのために言い争うのですか。あるいは彼を弁護しようとなさるのですか。バアルのために言い争う者は、あすの朝までに殺されるでしょう。バアルがもし神であるならば、自分の祭壇が打ちこわされたのだから、彼みずから言い争うべきです」。"},{"ref":"Judg.6.32","start":7006032,"end":7006032,"break":"none","ruby":[[5,1,"ひ"],[8,2,"じぶん"],[11,2,"さいだん"],[14,1,"う"],[35,1,"ひと"],[37,1,"い"],[39,1,"あらそ"],[47,1,"い"],[64,1,"よ"]],"text":"そこでその日、「自分の祭壇が打ちこわされたのだから、バアルみずからその人と言い争うべきです」と言ったので、ギデオンはエルバアルと呼ばれた。"},{"ref":"Judg.6.33","start":7006033,"end":7006033,"break":"none","ruby":[[0,1,"とき"],[18,2,"とうほう"],[21,1,"たみ"],[25,1,"あつ"],[33,1,"がわ"],[35,1,"わた"],[43,1,"たに"],[45,1,"じん"],[47,1,"と"]],"text":"時にミデアンびと、アマレクびとおよび東方の民がみな集まってヨルダン川を渡り、エズレルの谷に陣を取ったが、"},{"ref":"Judg.6.34","start":7006034,"end":7006034,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"れい"],[9,1,"のぞ"],[21,1,"ふ"],[35,1,"あつ"],[39,1,"かれ"],[41,1,"したが"]],"text":"主の霊がギデオンに臨み、ギデオンがラッパを吹いたので、アビエゼルびとは集まって彼に従った。"},{"ref":"Judg.6.35","start":7006035,"end":7006035,"break":"none","ruby":[[0,1,"つぎ"],[2,1,"かれ"],[12,2,"ししゃ"],[31,1,"あつ"],[35,1,"かれ"],[37,1,"したが"],[41,1,"かれ"],[61,2,"ししゃ"],[72,2,"ひとびと"],[75,1,"のぼ"],[78,1,"かれ"],[80,1,"むか"]],"text":"次に彼があまねくマナセに使者をつかわしたので、マナセびともまた集まって彼に従った。彼がまたアセル、ゼブルンおよびナフタリに使者をつかわすと、その人々も上って彼を迎えた。"},{"ref":"Judg.6.36","start":7006036,"end":7006036,"break":"paragraph","ruby":[[5,1,"かみ"],[7,1,"い"],[19,1,"い"],[31,1,"て"],[42,1,"すく"]],"text":"ギデオンは神に言った、「あなたがかつて言われたように、わたしの手によってイスラエルを救おうとされるならば、"},{"ref":"Judg.6.37","start":7006037,"end":7006037,"break":"none","ruby":[[4,1,"ひつじ"],[6,1,"け"],[8,1,"とう"],[9,1,"ぶん"],[11,1,"う"],[13,1,"ば"],[15,1,"お"],[22,1,"つゆ"],[26,1,"ひつじ"],[28,1,"け"],[30,1,"うえ"],[38,1,"ち"],[77,1,"い"],[89,1,"て"],[101,1,"すく"],[109,1,"し"]],"text":"わたしは羊の毛一頭分を打ち場に置きますから、露がその羊の毛の上にだけあって、地がすべてかわいているようにしてください。これによってわたしは、あなたがかつて言われたように、わたしの手によってイスラエルをお救いになることを知るでしょう」。"},{"ref":"Judg.6.38","start":7006038,"end":7006038,"break":"none","ruby":[[13,1,"かれ"],[15,2,"よくあさ"],[17,1,"はや"],[19,1,"お"],[23,1,"ひつじ"],[25,1,"け"],[29,1,"よ"],[34,1,"け"],[37,1,"つゆ"],[39,1,"しぼ"],[43,1,"はち"],[45,1,"み"],[51,1,"みず"],[53,1,"で"]],"text":"すなわちそのようになった。彼が翌朝早く起きて、羊の毛をかき寄せ、その毛から露を絞ると、鉢に満ちるほどの水が出た。"},{"ref":"Judg.6.39","start":7006039,"end":7006039,"break":"none","ruby":[[5,1,"かみ"],[7,1,"い"],[17,1,"いか"],[27,1,"ねが"],[39,1,"ど"],[42,1,"い"],[58,1,"ど"],[61,1,"ひつじ"],[63,1,"け"],[82,1,"ひつじ"],[84,1,"け"],[94,1,"ち"],[102,1,"つゆ"]],"text":"ギデオンは神に言った、「わたしをお怒りにならないように願います。わたしにもう一度だけ言わせてください。どうぞ、もう一度だけ羊の毛をもってためさせてください。どうぞ、羊の毛だけをかわかして、地にはことごとく露があるようにしてください」。"},{"ref":"Judg.6.40","start":7006040,"end":7006040,"break":"none","ruby":[[0,1,"かみ"],[4,1,"よる"],[16,1,"ひつじ"],[18,1,"け"],[26,1,"ち"],[32,1,"つゆ"]],"text":"神はその夜、そうされた。すなわち羊の毛だけかわいて、地にはすべて露があった。"}]