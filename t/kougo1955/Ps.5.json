[{"ref":"Ps.5.1","start":19005001,"end":19005001,"break":"paragraph","title":"聖歌隊の指揮者によって笛にあわせてうたわせたダビデの歌","breaks":[[15,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"ことば"],[10,1,"みみ"],[12,1,"かたむ"],[19,1,"なげ"],[24,1,"こころ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[11,1,"ふえ"],[26,1,"うた"]],"text":"主よ、わたしの言葉に耳を傾け、わたしの嘆きに、み心をとめてください。"},{"ref":"Ps.5.2","start":19005002,"end":19005002,"break":"line","breaks":[[9,"line"],[26,"line"]],"ruby":[[2,1,"おう"],[6,1,"かみ"],[13,1,"さけ"],[16,1,"こえ"],[19,1,"き"],[34,1,"いの"]],"text":"わが王、わが神よ、わたしの叫びの声をお聞きください。わたしはあなたに祈っています。"},{"ref":"Ps.5.3","start":19005003,"end":19005003,"break":"line","breaks":[[23,"line"],[38,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"あさ"],[15,1,"こえ"],[17,1,"き"],[27,1,"あさ"],[43,1,"そな"],[46,1,"ま"],[48,1,"のぞ"]],"text":"主よ、朝ごとにあなたはわたしの声を聞かれます。わたしは朝ごとにあなたのためにいけにえを備えて待ち望みます。"},{"ref":"Ps.5.4","start":19005004,"end":19005004,"break":"line","breaks":[[19,"line"]],"ruby":[[4,1,"あ"],[7,1,"こと"],[9,1,"よろこ"],[13,1,"かみ"],[19,2,"あくにん"],[29,1,"み"],[31,1,"よ"]],"text":"あなたは悪しき事を喜ばれる神ではない。悪人はあなたのもとに身を寄せることはできない。"},{"ref":"Ps.5.5","start":19005005,"end":19005005,"break":"line","breaks":[[23,"line"]],"ruby":[[0,1,"たか"],[3,1,"もの"],[9,1,"め"],[11,1,"まえ"],[13,1,"た"],[30,1,"あく"],[32,1,"おこな"],[34,1,"もの"],[36,1,"にく"]],"text":"高ぶる者はあなたの目の前に立つことはできない。あなたはすべて悪を行う者を憎まれる。"},{"ref":"Ps.5.6","start":19005006,"end":19005006,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"いつわ"],[7,1,"い"],[9,1,"もの"],[11,1,"ほろ"],[17,1,"しゅ"],[19,1,"ち"],[21,1,"なが"],[23,1,"もの"],[26,1,"ひと"],[31,1,"もの"],[33,1,"い"]],"text":"あなたは偽りを言う者を滅ぼされる。主は血を流す者と、人をだます者を忌みきらわれる。"},{"ref":"Ps.5.7","start":19005007,"end":19005007,"break":"line","breaks":[[25,"line"],[34,"line"]],"ruby":[[12,1,"ゆた"],[29,1,"いえ"],[31,1,"い"],[34,1,"せい"],[37,1,"みや"],[48,1,"ふ"],[50,1,"おが"]],"text":"しかし、わたしはあなたの豊かないつくしみによって、あなたの家に入り、聖なる宮にむかって、かしこみ伏し拝みます。"},{"ref":"Ps.5.8","start":19005008,"end":19005008,"break":"line","breaks":[[14,"line"],[30,"line"]],"ruby":[[0,1,"しゅ"],[18,1,"ぎ"],[27,1,"みちび"],[34,1,"まえ"],[40,1,"みち"]],"text":"主よ、わたしのあだのゆえに、あなたの義をもってわたしを導き、わたしの前にあなたの道をまっすぐにしてください。"},{"ref":"Ps.5.9","start":19005009,"end":19005009,"break":"line","breaks":[[24,"line"],[34,"line"]],"ruby":[[0,1,"かれ"],[3,1,"くち"],[6,2,"しんじつ"],[12,1,"かれ"],[15,1,"こころ"],[18,1,"ほろ"],[29,1,"ひら"],[32,1,"はか"],[36,1,"した"],[43,1,"い"]],"text":"彼らの口には真実がなく、彼らの心には滅びがあり、そののどは開いた墓、その舌はへつらいを言うのです。"},{"ref":"Ps.5.10","start":19005010,"end":19005010,"break":"line","breaks":[[17,"line"],[38,"line"],[62,"line"]],"ruby":[[0,1,"かみ"],[6,1,"かれ"],[11,1,"つみ"],[13,1,"お"],[33,1,"たお"],[40,1,"おお"],[49,1,"かれ"],[52,1,"お"],[62,1,"かれ"]],"text":"神よ、どうか彼らにその罪を負わせ、そのはかりごとによって、みずから倒れさせ、その多くのとがのゆえに彼らを追いだしてください。彼らはあなたにそむいたからです。"},{"ref":"Ps.5.11","start":19005011,"end":19005011,"break":"line","breaks":[[21,"line"],[39,"line"],[57,"line"]],"ruby":[[11,1,"よ"],[13,1,"たの"],[15,1,"もの"],[17,1,"よろこ"],[26,1,"よろこ"],[28,1,"よ"],[43,1,"な"],[45,1,"あい"],[48,1,"もの"],[57,1,"よろこ"],[60,1,"え"],[66,1,"かれ"],[70,1,"まも"]],"text":"しかし、すべてあなたに寄り頼む者を喜ばせ、とこしえに喜び呼ばわらせてください。また、み名を愛する者があなたによって喜びを得るように、彼らをお守りください。"},{"ref":"Ps.5.12","start":19005012,"end":19005012,"break":"line","breaks":[[16,"line"],[27,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"ただ"],[10,1,"もの"],[12,2,"しゅくふく"],[16,1,"たて"],[27,1,"めぐ"],[39,1,"まも"]],"text":"主よ、あなたは正しい者を祝福し、盾をもってするように、恵みをもってこれをおおい守られます。"}]