[{"ref":"1Kgs.10.1","start":11010001,"end":11010001,"break":"paragraph","ruby":[[3,2,"じょおう"],[6,1,"しゅ"],[8,1,"な"],[19,2,"めいせい"],[22,1,"き"],[28,2,"なんもん"],[39,1,"こころ"]],"text":"シバの女王は主の名にかかわるソロモンの名声を聞いたので、難問をもってソロモンを試みようとたずねてきた。"},{"ref":"1Kgs.10.2","start":11010002,"end":11010002,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"おお"],[6,2,"じゅうしゃ"],[9,1,"つ"],[12,2,"こうりょう"],[21,1,"きん"],[23,2,"ほうせき"],[31,1,"お"],[44,2,"かのじょ"],[60,1,"こころ"],[72,1,"かれ"],[74,1,"つ"]],"text":"彼女は多くの従者を連れ、香料と、たくさんの金と宝石とをらくだに負わせてエルサレムにきた。彼女はソロモンのもとにきて、その心にあることをことごとく彼に告げたが、"},{"ref":"1Kgs.10.3","start":11010003,"end":11010003,"break":"none","ruby":[[11,1,"とい"],[13,1,"こた"],[17,1,"おう"],[19,1,"し"],[24,2,"かのじょ"],[27,2,"せつめい"]],"text":"ソロモンはそのすべての問に答えた。王が知らないで彼女に説明のできないことは一つもなかった。"},{"ref":"1Kgs.10.4","start":11010004,"end":11010004,"break":"none","ruby":[[3,2,"じょおう"],[16,2,"ちえ"],[25,1,"た"],[28,2,"きゅうでん"]],"text":"シバの女王はソロモンのもろもろの知恵と、ソロモンが建てた宮殿、"},{"ref":"1Kgs.10.5","start":11010005,"end":11010005,"break":"none","ruby":[[2,2,"しょくたく"],[5,2,"しょくもつ"],[9,2,"れつざ"],[12,2,"けらい"],[20,2,"じしん"],[25,2,"しこう"],[30,1,"かれ"],[33,2,"ふくそう"],[37,1,"かれ"],[39,2,"きゅうじ"],[47,1,"かれ"],[49,1,"しゅ"],[51,1,"みや"],[57,2,"はんさい"],[60,1,"み"],[63,1,"まった"],[65,1,"き"],[67,1,"うば"]],"text":"その食卓の食物と、列座の家来たちと、その侍臣たちの伺候ぶり、彼らの服装と、彼の給仕たち、および彼が主の宮でささげる燔祭を見て、全く気を奪われてしまった。"},{"ref":"1Kgs.10.6","start":11010006,"end":11010006,"break":"paragraph","ruby":[[0,2,"かのじょ"],[3,1,"おう"],[5,1,"い"],[14,1,"くに"],[20,1,"こと"],[27,2,"ちえ"],[33,1,"き"],[39,2,"しんじつ"]],"text":"彼女は王に言った、「わたしが国であなたの事と、あなたの知恵について聞いたことは真実でありました。"},{"ref":"1Kgs.10.7","start":11010007,"end":11010007,"break":"none","ruby":[[10,1,"め"],[12,1,"み"],[20,2,"ことば"],[23,1,"しん"],[33,2,"いまみ"],[39,2,"はんぶん"],[46,1,"し"],[64,2,"ちえ"],[67,2,"はんえい"],[74,1,"き"]],"text":"しかしわたしがきて、目に見るまでは、その言葉を信じませんでしたが、今見るとその半分もわたしは知らされていなかったのです。あなたの知恵と繁栄はわたしが聞いたうわさにまさっています。"},{"ref":"1Kgs.10.8","start":11010008,"end":11010008,"break":"none","ruby":[[4,2,"おくがた"],[16,1,"つね"],[22,1,"まえ"],[24,1,"た"],[32,2,"ちえ"],[35,1,"き"],[37,2,"けらい"]],"text":"あなたの奥方たちはさいわいです。常にあなたの前に立って、あなたの知恵を聞く家来たちはさいわいです。"},{"ref":"1Kgs.10.9","start":11010009,"end":11010009,"break":"none","ruby":[[4,1,"かみ"],[6,1,"しゅ"],[15,1,"しゅ"],[21,1,"よろこ"],[34,1,"くらい"],[46,1,"しゅ"],[48,2,"えいきゅう"],[57,1,"あい"],[69,1,"おう"],[73,2,"こうどう"],[76,2,"せいぎ"],[80,1,"おこな"]],"text":"あなたの神、主はほむべきかな。主はあなたを喜び、あなたをイスラエルの位にのぼらせられました。主は永久にイスラエルを愛せられるゆえ、あなたを王として公道と正義とを行わせられるのです」。"},{"ref":"1Kgs.10.10","start":11010010,"end":11010010,"break":"none","ruby":[[3,2,"かのじょ"],[6,1,"きん"],[17,1,"おお"],[20,2,"こうりょう"],[23,2,"ほうせき"],[27,1,"おう"],[29,1,"おく"],[36,2,"じょおう"],[43,1,"おう"],[45,1,"おく"],[51,1,"おお"],[54,2,"こうりょう"],[57,1,"ふたた"]],"text":"そして彼女は金百二十タラントおよび多くの香料と宝石とを王に贈った。シバの女王がソロモン王に贈ったような多くの香料は再びこなかった。"},{"ref":"1Kgs.10.11","start":11010011,"end":11010011,"break":"paragraph","ruby":[[5,1,"きん"],[7,1,"の"],[16,1,"ふね"],[37,1,"き"],[39,2,"ほうせき"],[43,1,"はこ"]],"text":"オフルから金を載せてきたヒラムの船は、またオフルからたくさんのびゃくだんの木と宝石とを運んできたので、"},{"ref":"1Kgs.10.12","start":11010012,"end":11010012,"break":"none","ruby":[[0,1,"おう"],[8,1,"き"],[13,1,"しゅ"],[15,1,"みや"],[17,1,"おう"],[19,2,"きゅうでん"],[25,1,"へき"],[26,1,"ちゅう"],[28,1,"つく"],[33,1,"うた"],[35,2,"ひとびと"],[41,1,"こと"],[43,2,"たてごと"],[47,1,"つく"],[62,1,"き"],[78,2,"こんにち"],[82,1,"み"]],"text":"王はびゃくだんの木をもって主の宮と王の宮殿のために壁柱を造り、また歌う人々のために琴と立琴とを造った。このようなびゃくだんの木は、かつてきたこともなく、また今日まで見たこともなかった。"},{"ref":"1Kgs.10.13","start":11010013,"end":11010013,"break":"paragraph","ruby":[[4,1,"おう"],[8,1,"ゆた"],[21,2,"じょおう"],[24,1,"おく"],[26,1,"もの"],[34,2,"かのじょ"],[37,1,"のぞ"],[50,1,"もと"],[53,1,"もの"],[55,1,"おく"],[62,2,"かのじょ"],[67,2,"けらい"],[72,1,"とも"],[74,2,"じぶん"],[77,1,"くに"],[79,1,"かえ"]],"text":"ソロモン王はその豊かなのにしたがってシバの女王に贈り物をしたほかに、彼女の望みにまかせて、すべてその求める物を贈った。そして彼女はその家来たちと共に自分の国へ帰っていった。"},{"ref":"1Kgs.10.14","start":11010014,"end":11010014,"break":"paragraph","ruby":[[3,1,"ねん"],[5,1,"あいだ"],[23,1,"きん"],[25,2,"めかた"]],"text":"さて一年の間にソロモンのところに、はいってきた金の目方は六百六十六タラントであった。"},{"ref":"1Kgs.10.15","start":11010015,"end":11010015,"break":"none","ruby":[[5,2,"ぼうえき"],[7,1,"しょう"],[11,2,"しょうにん"],[14,2,"とりひき"],[26,2,"しょおう"],[29,1,"くに"],[31,2,"だいかん"]],"text":"そのほかに貿易商および商人の取引、ならびにアラビヤの諸王と国の代官たちからも、はいってきた。"},{"ref":"1Kgs.10.16","start":11010016,"end":11010016,"break":"none","ruby":[[4,1,"おう"],[6,2,"のべきん"],[9,2,"おおだて"],[14,1,"つく"],[20,2,"おおだて"],[34,1,"きん"],[36,1,"もち"]],"text":"ソロモン王は延金の大盾二百を造った。その大盾にはおのおの六百シケルの金を用いた。"},{"ref":"1Kgs.10.17","start":11010017,"end":11010017,"break":"none","ruby":[[2,2,"のべきん"],[5,2,"こだて"],[10,1,"つく"],[16,2,"こだて"],[28,1,"きん"],[30,1,"もち"],[34,1,"おう"],[45,1,"もり"],[47,1,"いえ"],[49,1,"お"]],"text":"また延金の小盾三百を造った。その小盾にはおのおの三ミナの金を用いた。王はこれらをレバノンの森の家に置いた。"},{"ref":"1Kgs.10.18","start":11010018,"end":11010018,"break":"none","ruby":[[0,1,"おう"],[4,1,"おお"],[7,2,"ぞうげ"],[10,2,"ぎょくざ"],[13,1,"つく"],[16,2,"じゅんきん"]],"text":"王はまた大きな象牙の玉座を造り、純金をもってこれをおおった。"},{"ref":"1Kgs.10.19","start":11010019,"end":11010019,"break":"none","ruby":[[2,2,"ぎょくざ"],[8,1,"だん"],[13,2,"ぎょくざ"],[16,1,"のち"],[18,1,"こ"],[19,1,"うし"],[21,1,"あたま"],[26,2,"ざせき"],[29,2,"りょうがわ"],[34,1,"か"],[43,1,"か"],[55,1,"た"]],"text":"その玉座に六つの段があり、玉座の後に子牛の頭があり、座席の両側にひじ掛けがあって、ひじ掛けのわきに二つのししが立っていた。"},{"ref":"1Kgs.10.20","start":11010020,"end":11010020,"break":"none","ruby":[[5,1,"だん"],[12,2,"りょうがわ"],[21,1,"た"],[32,1,"もの"],[37,1,"くに"],[40,1,"つく"]],"text":"また六つの段のおのおのの両側に十二のししが立っていた。このような物はどこの国でも造られたことがなかった。"},{"ref":"1Kgs.10.21","start":11010021,"end":11010021,"break":"none","ruby":[[4,1,"おう"],[6,1,"の"],[11,1,"もち"],[14,1,"うつわ"],[16,1,"みな"],[17,1,"きん"],[30,1,"もり"],[32,1,"いえ"],[34,1,"うつわ"],[36,1,"みな"],[37,2,"じゅんきん"],[44,1,"ぎん"],[54,1,"ぎん"],[61,1,"よ"],[64,1,"かえり"]],"text":"ソロモン王が飲むときに用いた器は皆金であった。またレバノンの森の家の器も皆純金であって、銀のものはなかった。銀はソロモンの世には顧みられなかった。"},{"ref":"1Kgs.10.22","start":11010022,"end":11010022,"break":"none","ruby":[[3,1,"おう"],[5,1,"うみ"],[12,2,"せんたい"],[15,2,"しょゆう"],[24,2,"せんたい"],[27,2,"いっしょ"],[30,2,"こうかい"],[40,2,"せんたい"],[44,1,"ねん"],[47,1,"ど"],[49,1,"きん"],[51,1,"ぎん"],[53,2,"ぞうげ"],[64,1,"の"]],"text":"これは王が海にタルシシの船隊を所有して、ヒラムの船隊と一緒に航海させ、タルシシの船隊に三年に一度、金、銀、象牙、さる、くじゃくを載せてこさせたからである。"},{"ref":"1Kgs.10.23","start":11010023,"end":11010023,"break":"paragraph","ruby":[[9,1,"おう"],[11,1,"とみ"],[13,2,"ちえ"],[17,1,"ち"],[23,1,"おう"]],"text":"このようにソロモン王は富も知恵も、地のすべての王にまさっていたので、"},{"ref":"1Kgs.10.24","start":11010024,"end":11010024,"break":"none","ruby":[[0,1,"ぜん"],[1,1,"ち"],[3,2,"ひとびと"],[6,1,"かみ"],[13,1,"こころ"],[15,1,"さづ"],[20,2,"ちえ"],[23,1,"き"],[34,2,"えっけん"],[37,1,"もと"]],"text":"全地の人々は神がソロモンの心に授けられた知恵を聞こうとしてソロモンに謁見を求めた。"},{"ref":"1Kgs.10.25","start":11010025,"end":11010025,"break":"none","ruby":[[0,2,"ひとびと"],[7,1,"おく"],[9,1,"もの"],[11,1,"たずさ"],[21,1,"ぎん"],[23,1,"うつわ"],[25,1,"きん"],[27,1,"うつわ"],[29,2,"いふく"],[32,2,"もつやく"],[35,2,"こうりょう"],[38,1,"うま"],[40,2,"らば"],[44,2,"ねんねん"],[46,1,"さだ"]],"text":"人々はおのおの贈り物を携えてきた。すなわち銀の器、金の器、衣服、没薬、香料、馬、騾馬など年々定まっていた。"},{"ref":"1Kgs.10.26","start":11010026,"end":11010026,"break":"paragraph","ruby":[[5,2,"せんしゃ"],[8,2,"きへい"],[12,1,"あつ"],[17,2,"せんしゃ"],[23,1,"りょう"],[25,2,"きへい"],[43,2,"せんしゃ"],[46,1,"まち"],[54,1,"おう"],[59,1,"お"]],"text":"ソロモンは戦車と騎兵とを集めたが、戦車一千四百両、騎兵一万二千あった。ソロモンはこれを戦車の町とエルサレムの王のもとに置いた。"},{"ref":"1Kgs.10.27","start":11010027,"end":11010027,"break":"none","ruby":[[0,1,"おう"],[9,1,"ぎん"],[11,1,"いし"],[16,1,"もち"],[19,2,"こうはく"],[22,2,"へいち"],[31,1,"くわ"],[36,1,"おお"],[38,1,"もち"]],"text":"王はエルサレムで、銀を石のように用い、香柏を平地にあるいちじく桑のように多く用いた。"},{"ref":"1Kgs.10.28","start":11010028,"end":11010028,"break":"none","ruby":[[5,1,"うま"],[7,2,"ゆにゅう"],[31,1,"おう"],[33,2,"ぼうえき"],[35,1,"しょう"],[41,2,"だいか"],[44,1,"はら"],[47,1,"う"],[49,1,"と"]],"text":"ソロモンが馬を輸入したのはエジプトとクエからであった。すなわち王の貿易商はクエから代価を払って受け取ってきた。"},{"ref":"1Kgs.10.29","start":11010029,"end":11010029,"break":"none","ruby":[[6,2,"ゆにゅう"],[11,2,"せんしゃ"],[14,1,"りょう"],[16,1,"ぎん"],[23,1,"うま"],[51,1,"おう"],[53,2,"ぼうえき"],[55,1,"しょう"],[70,1,"おう"],[80,1,"おう"],[84,2,"ゆしゅつ"]],"text":"エジプトから輸入される戦車一両は銀六百シケル、馬は百五十シケルであった。このようにして、これらのものが王の貿易商によって、ヘテびとのすべての王たちおよびスリヤの王たちに輸出された。"}]