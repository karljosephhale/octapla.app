[{"ref":"Ezra.1.1","start":15001001,"end":15001001,"break":"paragraph","ruby":[[4,1,"おう"],[9,2,"がんねん"],[13,1,"しゅ"],[23,1,"くち"],[28,1,"つた"],[33,1,"しゅ"],[35,2,"ことば"],[38,2,"じょうじゅ"],[49,1,"おう"],[54,1,"こころ"],[56,2,"かんどう"],[64,1,"おう"],[66,2,"ぜんこく"],[69,2,"ふこく"],[72,1,"はっ"],[77,2,"しょうしょ"],[83,1,"つ"],[86,1,"い"]],"text":"ペルシャ王クロスの元年に、主はさきにエレミヤの口によって伝えられた主の言葉を成就するため、ペルシャ王クロスの心を感動されたので、王は全国に布告を発し、また詔書をもって告げて言った、"},{"ref":"Ezra.1.2","start":15001002,"end":15001002,"break":"paragraph","ruby":[[5,1,"おう"],[15,1,"い"],[18,1,"てん"],[20,1,"かみ"],[22,1,"しゅ"],[24,2,"ちじょう"],[27,2,"くにぐに"],[39,1,"くだ"],[44,1,"しゅ"],[46,1,"みや"],[59,1,"た"],[69,1,"めい"]],"text":"「ペルシャ王クロスはこのように言う、天の神、主は地上の国々をことごとくわたしに下さって、主の宮をユダにあるエルサレムに建てることをわたしに命じられた。"},{"ref":"Ezra.1.3","start":15001003,"end":15001003,"break":"none","ruby":[[11,1,"たみ"],[15,1,"もの"],[17,1,"みな"],[20,1,"かみ"],[22,1,"たす"],[25,1,"え"],[39,1,"のぼ"],[42,1,"い"],[51,1,"かみ"],[53,1,"しゅ"],[55,1,"みや"],[57,2,"ふっこう"],[62,1,"かれ"],[73,1,"かみ"]],"text":"あなたがたのうち、その民である者は皆その神の助けを得て、ユダにあるエルサレムに上って行き、イスラエルの神、主の宮を復興せよ。彼はエルサレムにいます神である。"},{"ref":"Ezra.1.4","start":15001004,"end":15001004,"break":"none","ruby":[[3,1,"い"],[5,1,"のこ"],[12,1,"やど"],[17,1,"もの"],[23,1,"ところ"],[25,2,"ひとびと"],[28,1,"きん"],[30,1,"ぎん"],[32,1,"か"],[33,1,"ざい"],[35,2,"かちく"],[41,1,"たす"],[59,1,"かみ"],[61,1,"みや"],[66,2,"まごころ"],[71,1,"そな"],[73,1,"もの"]],"text":"すべて生き残って、どこに宿っている者でも、その所の人々は金、銀、貨財、家畜をもって助け、そのほかにまたエルサレムにある神の宮のために真心よりの供え物をささげよ」。"},{"ref":"Ezra.1.5","start":15001005,"end":15001005,"break":"paragraph","ruby":[[12,2,"しぞく"],[15,1,"ちょう"],[17,2,"さいし"],[32,1,"かみ"],[36,1,"こころ"],[38,2,"かんどう"],[43,1,"もの"],[54,1,"しゅ"],[56,1,"みや"],[58,2,"ふっこう"],[65,1,"のぼ"],[68,1,"い"],[72,1,"た"],[74,1,"あ"]],"text":"そこでユダとベニヤミンの氏族の長、祭司およびレビびとなど、すべて神にその心を感動された者は、エルサレムにある主の宮を復興するために上って行こうと立ち上がった。"},{"ref":"Ezra.1.6","start":15001006,"end":15001006,"break":"none","ruby":[[2,2,"しゅうい"],[5,2,"ひとびと"],[8,1,"みな"],[10,1,"ぎん"],[12,1,"うつわ"],[14,1,"きん"],[16,1,"か"],[17,1,"ざい"],[19,2,"かちく"],[24,2,"たからもの"],[27,1,"あた"],[30,1,"かれ"],[33,1,"ちから"],[50,1,"もの"],[52,1,"お"]],"text":"その周囲の人々は皆、銀の器、金、貨財、家畜および宝物を与えて彼らを力づけ、そのほかにまた、もろもろの物を惜しげなくささげた。"},{"ref":"Ezra.1.7","start":15001007,"end":15001007,"break":"none","ruby":[[3,1,"おう"],[26,1,"たずさ"],[28,1,"だ"],[31,2,"じぶん"],[34,1,"かみ"],[36,1,"みや"],[38,1,"おさ"],[41,1,"しゅ"],[43,1,"みや"],[45,1,"うつわ"],[47,1,"と"],[49,1,"だ"]],"text":"クロス王はまたネブカデネザルが、さきにエルサレムから携え出して自分の神の宮に納めた主の宮の器を取り出した。"},{"ref":"Ezra.1.8","start":15001008,"end":15001008,"break":"none","ruby":[[8,1,"おう"],[13,1,"くら"],[23,1,"て"],[31,1,"と"],[33,1,"だ"],[49,1,"かぞ"],[51,1,"わた"]],"text":"すなわちペルシャ王クロスは倉づかさミテレダテの手によってこれを取り出して、ユダのつかさセシバザルに数え渡した。"},{"ref":"Ezra.1.9","start":15001009,"end":15001009,"break":"none","ruby":[[2,1,"かず"],[4,1,"つぎ"],[13,1,"きん"],[21,1,"ぎん"],[29,2,"こうろ"]],"text":"その数は次のとおりである。金のたらい一千、銀のたらい一千、香炉二十九、"},{"ref":"Ezra.1.10","start":15001010,"end":15001010,"break":"none","ruby":[[0,1,"きん"],[2,1,"はち"],[6,1,"ぎん"],[8,1,"はち"],[17,1,"た"],[19,1,"うつわ"]],"text":"金の鉢三十、銀の鉢二千四百十、その他の器一千、"},{"ref":"Ezra.1.11","start":15001011,"end":15001011,"break":"none","ruby":[[0,2,"きんぎん"],[3,1,"うつわ"],[5,1,"あ"],[27,2,"ほしゅう"],[30,1,"つ"],[45,1,"のぼ"],[48,1,"とき"],[62,1,"たずさ"],[65,1,"のぼ"]],"text":"金銀の器は合わせて五千四百六十九あったが、セシバザルは捕囚を連れてバビロンからエルサレムに上った時、これらのものをことごとく携えて上った。"}]