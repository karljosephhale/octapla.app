[{"ref":"Ezek.13.1","start":26013001,"end":26013001,"break":"paragraph","ruby":[[0,1,"しゅ"],[2,2,"ことば"],[9,1,"のぞ"]],"text":"主の言葉がわたしに臨んだ、"},{"ref":"Ezek.13.2","start":26013002,"end":26013002,"break":"none","ruby":[[1,1,"ひと"],[3,1,"こ"],[12,3,"よげんしゃ"],[18,1,"む"],[22,2,"よげん"],[31,2,"じぶん"],[34,1,"こころ"],[39,2,"よげん"],[43,2,"ひとびと"],[46,1,"む"],[51,2,"よげん"],[55,1,"い"],[65,1,"しゅ"],[67,2,"ことば"],[70,1,"き"]],"text":"「人の子よ、イスラエルの預言者たちに向かって預言せよ。すなわち自分の心のままに預言する人々に向かって、預言して言え、『あなたがたは主の言葉を聞け』。"},{"ref":"Ezek.13.3","start":26013003,"end":26013003,"break":"none","ruby":[[0,1,"しゅ"],[3,1,"かみ"],[7,1,"い"],[15,1,"み"],[20,2,"じぶん"],[23,1,"れい"],[25,1,"したが"],[27,1,"おろ"],[30,3,"よげんしゃ"]],"text":"主なる神はこう言われる、なにも見ないで、自分の霊に従う愚かな預言者たちはわざわいだ。"},{"ref":"Ezek.13.4","start":26013004,"end":26013004,"break":"none","ruby":[[11,3,"よげんしゃ"],[18,1,"あ"],[20,1,"あと"]],"text":"イスラエルよ、あなたの預言者たちは、荒れ跡にいるきつねのようだ。"},{"ref":"Ezek.13.5","start":26013005,"end":26013005,"break":"none","ruby":[[6,1,"しゅ"],[8,1,"ひ"],[10,1,"たたか"],[13,1,"た"],[18,1,"やぶ"],[20,1,"くち"],[35,1,"いえ"],[40,1,"いし"],[44,1,"きず"]],"text":"あなたがたは主の日に戦いに立つため、破れ口にのぼらず、またイスラエルの家のために石がきを築こうともしない。"},{"ref":"Ezek.13.6","start":26013006,"end":26013006,"break":"none","ruby":[[0,1,"かれ"],[3,2,"きょぎ"],[6,1,"い"],[9,1,"いつわ"],[12,1,"うらな"],[16,1,"かれ"],[19,1,"しゅ"],[21,1,"かれ"],[33,1,"しゅ"],[35,1,"い"],[41,1,"い"],[48,2,"ことば"],[51,2,"じょうじゅ"],[58,2,"きたい"]],"text":"彼らは虚偽を言い、偽りを占った。彼らは主が彼らをつかわさないのに『主が言われる』と言い、なおその言葉の成就することを期待する。"},{"ref":"Ezek.13.7","start":26013007,"end":26013007,"break":"none","ruby":[[10,1,"まぼろし"],[12,1,"み"],[14,1,"いつわ"],[17,1,"うらな"],[20,1,"かた"],[27,1,"い"],[34,1,"しゅ"],[36,1,"い"],[42,1,"い"]],"text":"あなたがたはむなしい幻を見、偽りの占いを語り、わたしが言わないのに『主が言われる』と言ったではないか」。"},{"ref":"Ezek.13.8","start":26013008,"end":26013008,"break":"paragraph","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[31,1,"かた"],[34,1,"いつわ"],[37,1,"もの"],[39,1,"み"],[54,1,"ばっ"],[58,1,"しゅ"],[61,1,"かみ"],[63,1,"い"]],"text":"それゆえ、主なる神はこう言われる、「あなたがたはむなしいことを語り、偽りの物を見るゆえ、わたしはあなたがたを罰すると主なる神は言われる。"},{"ref":"Ezek.13.9","start":26013009,"end":26013009,"break":"none","ruby":[[4,1,"て"],[11,1,"まぼろし"],[13,1,"み"],[15,1,"いつわ"],[18,1,"うらな"],[21,1,"い"],[23,3,"よげんしゃ"],[27,2,"てきたい"],[32,1,"かれ"],[37,1,"たみ"],[39,1,"かい"],[41,1,"のぞ"],[51,1,"いえ"],[53,1,"せき"],[67,1,"ち"],[94,1,"しゅ"],[97,1,"かみ"],[104,1,"し"]],"text":"わたしの手は、むなしい幻を見、偽りの占いを言う預言者に敵対する。彼らはわが民の会に臨まず、イスラエルの家の籍にしるされず、イスラエルの地に、はいることができない。そしてあなたがたはわたしが主なる神であることを知るようになる。"},{"ref":"Ezek.13.10","start":26013010,"end":26013010,"break":"none","ruby":[[0,1,"かれ"],[5,1,"たみ"],[7,1,"まど"],[11,2,"へいわ"],[19,2,"へいわ"],[23,1,"い"],[28,1,"たみ"],[30,1,"へい"],[32,1,"きず"],[34,1,"とき"],[40,3,"よげんしゃ"],[46,1,"みず"],[58,1,"ぬ"]],"text":"彼らはわが民を惑わし、平和がないのに『平和』と言い、また民が塀を築く時、これらの預言者たちは水しっくいをもってこれを塗る。"},{"ref":"Ezek.13.11","start":26013011,"end":26013011,"break":"none","ruby":[[5,1,"みず"],[11,1,"ぬ"],[13,1,"もの"],[31,1,"い"],[37,2,"おおあめ"],[40,1,"そそ"],[47,1,"ふ"],[54,1,"ふ"]],"text":"それゆえ、水しっくいを塗る者どもに『これはかならずくずれる』と言え。これに大雨が注ぎ、ひょうが降り、あらしが吹く。"},{"ref":"Ezek.13.12","start":26013012,"end":26013012,"break":"none","ruby":[[3,1,"へい"],[9,1,"とき"],[11,2,"ひとびと"],[20,1,"む"],[32,1,"ぬ"],[35,1,"みず"],[49,1,"い"]],"text":"そして塀がくずれる時、人々はあなたがたに向かって、『あなたがたが塗った水しっくいはどこにあるか』と言わないであろうか。"},{"ref":"Ezek.13.13","start":26013013,"end":26013013,"break":"none","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[23,1,"いきどお"],[29,2,"おおかぜ"],[32,1,"おこ"],[37,1,"いか"],[43,2,"おおあめ"],[46,1,"そそ"],[50,1,"いきどお"],[60,1,"ふ"],[68,1,"ほろ"]],"text":"それゆえ、主なる神はこう言われる、わたしはわが憤りをもって大風を起し、わが怒りをもって大雨を注がせ、憤りをもってひょうを降らせて、これを滅ぼす。"},{"ref":"Ezek.13.14","start":26013014,"end":26013014,"break":"none","ruby":[[12,1,"みず"],[21,1,"ぬ"],[24,1,"へい"],[34,1,"ち"],[36,1,"たお"],[41,1,"もとい"],[51,1,"たお"],[54,1,"とき"],[64,1,"なか"],[66,1,"ほろ"],[84,1,"しゅ"],[91,1,"し"]],"text":"またわたしはあなたがたが水しっくいをもって塗った塀をこわして、これを地に倒し、その基をあらわす。これが倒れる時、あなたがたはその中に滅びる。そしてあなたがたは、わたしが主であることを知るようになる。"},{"ref":"Ezek.13.15","start":26013015,"end":26013015,"break":"none","ruby":[[11,1,"へい"],[17,1,"みず"],[23,1,"ぬ"],[26,1,"もの"],[29,1,"うえ"],[36,1,"いきどお"],[39,1,"も"],[42,1,"つく"],[52,1,"い"],[55,1,"へい"],[65,1,"ぬ"],[68,1,"もの"]],"text":"こうしてわたしが、その塀と、これを水しっくいで塗った者との上に、わたしの憤りを漏らし尽して、あなたがたに言う、塀はなくなり、これを塗った者もなくなる。"},{"ref":"Ezek.13.16","start":26013016,"end":26013016,"break":"none","ruby":[[7,2,"へいわ"],[14,2,"へいわ"],[17,1,"まぼろし"],[19,1,"み"],[30,2,"よげん"],[40,3,"よげんしゃ"],[48,1,"しゅ"],[51,1,"かみ"],[53,1,"い"]],"text":"これがすなわち平和がないのに平和の幻を見、エルサレムについて預言したイスラエルの預言者であると、主なる神は言われる。"},{"ref":"Ezek.13.17","start":26013017,"end":26013017,"break":"paragraph","ruby":[[0,1,"ひと"],[2,1,"こ"],[5,1,"こころ"],[10,2,"よげん"],[18,1,"たみ"],[20,1,"むすめ"],[24,1,"たい"],[32,1,"かお"],[34,1,"む"],[37,1,"かれ"],[40,1,"む"],[44,2,"よげん"]],"text":"人の子よ、心のままに預言するあなたの民の娘たちに対して、あなたの顔を向け、彼らに向かって預言して、"},{"ref":"Ezek.13.18","start":26013018,"end":26013018,"break":"none","ruby":[[0,1,"い"],[3,1,"しゅ"],[6,1,"かみ"],[10,1,"い"],[15,1,"て"],[17,2,"ふしぶし"],[20,1,"うらな"],[25,1,"ぬ"],[35,1,"おお"],[39,1,"ひと"],[41,1,"あたま"],[47,1,"もの"],[49,1,"つく"],[56,1,"たましい"],[60,1,"と"],[66,1,"おんな"],[83,1,"たみ"],[85,1,"たましい"],[89,1,"と"],[99,2,"りえき"],[106,1,"た"],[108,1,"たましい"],[110,1,"い"]],"text":"言え、主なる神はこう言われる、手の節々に占いひもを縫いつけ、もろもろの大きさの人の頭に、かぶり物を作りかぶせて、魂をかり取ろうとする女はわざわいだ。あなたがたは、わが民の魂をかり取って、あなたがたの利益のために、他の魂を生かしおこうとするのか。"},{"ref":"Ezek.13.19","start":26013019,"end":26013019,"break":"none","ruby":[[6,1,"すこ"],[12,2,"おおむぎ"],[18,1,"すこ"],[33,1,"たみ"],[43,1,"けが"],[48,1,"いつわ"],[51,1,"き"],[58,1,"たみ"],[60,1,"いつわ"],[63,1,"の"],[67,1,"し"],[75,1,"もの"],[77,1,"し"],[81,1,"い"],[91,1,"もの"],[93,1,"い"]],"text":"あなたがたは少しばかりの大麦のため、少しばかりのパンのために、わが民のうちに、わたしを汚し、かの偽りを聞きいれるわが民に偽りを述べて、死んではならない者を死なせ、生きていてはならない者を生かす。"},{"ref":"Ezek.13.20","start":26013020,"end":26013020,"break":"paragraph","ruby":[[5,1,"しゅ"],[8,1,"かみ"],[12,1,"い"],[17,1,"み"],[30,1,"もち"],[34,1,"たましい"],[38,1,"と"],[44,1,"うらな"],[49,1,"うば"],[58,1,"うで"],[61,1,"うらな"],[66,1,"さ"],[68,1,"と"],[80,1,"と"],[86,1,"たましい"],[89,1,"とり"],[94,1,"はな"]],"text":"それゆえ、主なる神はこう言われる、見よ、わたしはあなたがたが用いて、魂をかり取るところの占いひもを奪い、あなたがたの腕から占いひもを裂き取って、あなたがたがかり取るところの魂を、鳥のように放ちやる。"},{"ref":"Ezek.13.21","start":26013021,"end":26013021,"break":"none","ruby":[[16,1,"もの"],[18,1,"さ"],[23,1,"たみ"],[31,1,"て"],[34,1,"すく"],[37,1,"かれ"],[40,1,"ふたた"],[48,2,"えもの"],[70,1,"しゅ"],[77,1,"し"]],"text":"わたしはまたあなたがたの、かぶり物を裂き、わが民をあなたがたの手から救う。彼らは再びあなたがたの獲物とはならない。そしてあなたがたはわたしが主であることを知るようになる。"},{"ref":"Ezek.13.22","start":26013022,"end":26013022,"break":"none","ruby":[[6,1,"いつわ"],[12,1,"ただ"],[15,1,"もの"],[17,1,"こころ"],[19,1,"なや"],[31,1,"なや"],[47,2,"あくにん"],[53,1,"いのち"],[55,1,"すく"],[63,1,"あ"],[66,1,"みち"],[69,1,"はな"],[76,1,"とき"],[87,1,"すす"]],"text":"あなたがたは偽りをもって正しい者の心を悩ました。わたしはこれを悩まさなかった。またあなたがたは悪人が、その命を救うために、その悪しき道から離れようとする時、それをしないように勧める。"},{"ref":"Ezek.13.23","start":26013023,"end":26013023,"break":"none","ruby":[[11,1,"かさ"],[18,1,"まぼろし"],[20,1,"み"],[29,1,"うらな"],[53,1,"たみ"],[62,1,"て"],[65,1,"すく"],[67,1,"だ"],[85,1,"しゅ"],[92,1,"し"]],"text":"それゆえ、あなたがたは重ねてむなしい幻を見ることができず、占いをすることができないようになる。わたしはわが民を、あなたがたの手から救い出す。そのとき、あなたがたはわたしが主であることを知るようになる」。"}]