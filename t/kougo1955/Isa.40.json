[{"ref":"Isa.40.1","start":23040001,"end":23040001,"break":"paragraph","breaks":[[13,"line"]],"ruby":[[6,1,"かみ"],[8,1,"い"],[14,1,"なぐさ"],[20,1,"たみ"],[22,1,"なぐさ"]],"text":"あなたがたの神は言われる、「慰めよ、わが民を慰めよ、"},{"ref":"Isa.40.2","start":23040002,"end":23040002,"break":"line","breaks":[[22,"line"],[32,"line"],[45,"line"],[63,"line"]],"ruby":[[11,1,"かた"],[17,1,"よ"],[24,2,"ふくえき"],[27,1,"き"],[29,1,"おわ"],[52,1,"つみ"],[58,1,"ばい"],[60,2,"けいばつ"],[63,1,"しゅ"],[65,1,"て"],[68,1,"う"]],"text":"ねんごろにエルサレムに語り、これに呼ばわれ、その服役の期は終り、そのとがはすでにゆるされ、そのもろもろの罪のために二倍の刑罰を主の手から受けた」。"},{"ref":"Isa.40.3","start":23040003,"end":23040003,"break":"line","breaks":[[11,"line"],[22,"line"],[38,"line"]],"ruby":[[0,1,"よ"],[4,1,"もの"],[6,1,"こえ"],[12,2,"あらの"],[15,1,"しゅ"],[17,1,"みち"],[19,1,"そな"],[32,1,"かみ"],[38,2,"おおじ"]],"text":"呼ばわる者の声がする、「荒野に主の道を備え、さばくに、われわれの神のために、大路をまっすぐにせよ。"},{"ref":"Isa.40.4","start":23040004,"end":23040004,"break":"line","breaks":[[13,"line"],[29,"line"],[42,"line"]],"ruby":[[5,1,"たに"],[7,1,"たか"],[18,1,"やま"],[20,1,"おか"],[23,1,"ひく"],[29,1,"たか"],[30,1,"そこ"],[34,1,"ち"],[36,1,"たい"],[42,1,"けわ"],[45,1,"ところ"],[47,2,"へいち"]],"text":"もろもろの谷は高くせられ、もろもろの山と丘とは低くせられ、高底のある地は平らになり、険しい所は平地となる。"},{"ref":"Isa.40.5","start":23040005,"end":23040005,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[4,1,"しゅ"],[6,2,"えいこう"],[14,1,"ひと"],[16,1,"みな"],[23,1,"み"],[29,1,"しゅ"],[31,1,"くち"],[33,1,"かた"]],"text":"こうして主の栄光があらわれ、人は皆ともにこれを見る。これは主の口が語られたのである」。"},{"ref":"Isa.40.6","start":23040006,"end":23040006,"break":"line","breaks":[[13,"line"],[36,"line"],[44,"line"]],"ruby":[[0,1,"こえ"],[2,1,"きこ"],[7,1,"よ"],[17,1,"い"],[25,1,"よ"],[37,1,"ひと"],[41,1,"くさ"],[46,1,"うるわ"],[54,1,"の"],[56,1,"はな"]],"text":"声が聞える、「呼ばわれ」。わたしは言った、「なんと呼ばわりましょうか」。「人はみな草だ。その麗しさは、すべて野の花のようだ。"},{"ref":"Isa.40.7","start":23040007,"end":23040007,"break":"line","breaks":[[12,"line"],[23,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"いき"],[6,1,"うえ"],[8,1,"ふ"],[12,1,"くさ"],[14,1,"か"],[17,1,"はな"],[27,1,"ひと"],[29,1,"くさ"]],"text":"主の息がその上に吹けば、草は枯れ、花はしぼむ。たしかに人は草だ。"},{"ref":"Isa.40.8","start":23040008,"end":23040008,"break":"line","breaks":[[11,"line"],[25,"line"]],"ruby":[[0,1,"くさ"],[2,1,"か"],[5,1,"はな"],[20,1,"かみ"],[22,2,"ことば"],[30,1,"かわ"]],"text":"草は枯れ、花はしぼむ。しかし、われわれの神の言葉はとこしえに変ることはない」。"},{"ref":"Isa.40.9","start":23040009,"end":23040009,"break":"line","breaks":[[17,"line"],[25,"line"],[44,"line"],[52,"line"],[62,"line"],[75,"line"]],"ruby":[[11,1,"つた"],[14,1,"もの"],[17,1,"たか"],[19,1,"やま"],[38,1,"つた"],[41,1,"もの"],[44,1,"つよ"],[46,1,"こえ"],[52,1,"こえ"],[57,1,"おそ"],[70,1,"まち"],[72,1,"い"],[82,1,"かみ"],[84,1,"み"]],"text":"よきおとずれをシオンに伝える者よ、高い山にのぼれ。よきおとずれをエルサレムに伝える者よ、強く声をあげよ、声をあげて恐れるな。ユダのもろもろの町に言え、「あなたがたの神を見よ」と。"},{"ref":"Isa.40.10","start":23040010,"end":23040010,"break":"line","breaks":[[18,"line"],[28,"line"],[43,"line"]],"ruby":[[0,1,"み"],[3,1,"しゅ"],[6,1,"かみ"],[8,2,"たいのう"],[20,1,"うで"],[22,1,"よ"],[24,1,"おさ"],[28,1,"み"],[33,1,"むく"],[36,1,"しゅ"],[38,1,"とも"],[50,1,"むく"],[57,1,"まえ"]],"text":"見よ、主なる神は大能をもってこられ、その腕は世を治める。見よ、その報いは主と共にあり、そのはたらきの報いは、そのみ前にある。"},{"ref":"Isa.40.11","start":23040011,"end":23040011,"break":"line","breaks":[[16,"line"],[29,"line"],[44,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"ぼくしゃ"],[10,1,"む"],[13,1,"やしな"],[22,2,"こひつじ"],[36,1,"い"],[39,1,"たずさ"],[44,1,"ちち"],[46,1,"の"],[59,1,"みちび"]],"text":"主は牧者のようにその群れを養い、そのかいなに小羊をいだき、そのふところに入れて携えゆき、乳を飲ませているものをやさしく導かれる。"},{"ref":"Isa.40.12","start":23040012,"end":23040012,"break":"paragraph","breaks":[[19,"line"],[31,"line"],[41,"line"],[61,"line"]],"ruby":[[13,1,"うみ"],[19,1,"ゆび"],[21,1,"の"],[25,1,"てん"],[31,1,"ち"],[36,1,"ます"],[38,1,"も"],[55,1,"やま"],[74,1,"おか"]],"text":"だれが、たなごころをもって海をはかり、指を伸ばして天をはかり、地のちりを枡に盛り、てんびんをもって、もろもろの山をはかり、はかりをもって、もろもろの丘をはかったか。"},{"ref":"Isa.40.13","start":23040013,"end":23040013,"break":"line","breaks":[[11,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"れい"],[8,1,"みちび"],[13,3,"そうだんやく"],[20,1,"しゅ"],[22,1,"おし"]],"text":"だれが、主の霊を導き、その相談役となって主を教えたか。"},{"ref":"Isa.40.14","start":23040014,"end":23040014,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[0,1,"しゅ"],[5,2,"そうだん"],[9,1,"さと"],[12,1,"え"],[19,1,"しゅ"],[21,2,"こうぎ"],[24,1,"みち"],[26,1,"おし"],[29,2,"ちしき"],[32,1,"おし"],[35,1,"さと"],[38,1,"みち"],[40,1,"しめ"]],"text":"主はだれと相談して悟りを得たか。だれが主に公義の道を教え、知識を教え、悟りの道を示したか。"},{"ref":"Isa.40.15","start":23040015,"end":23040015,"break":"line","breaks":[[24,"line"],[41,"line"]],"ruby":[[0,1,"み"],[8,2,"こくみん"],[15,1,"ひと"],[28,1,"うえ"],[36,1,"おも"],[41,1,"み"],[44,1,"しゅ"],[46,2,"しまじま"]],"text":"見よ、もろもろの国民は、おけの一しずくのように、はかりの上のちりのように思われる。見よ、主は島々を、ほこりのようにあげられる。"},{"ref":"Isa.40.16","start":23040016,"end":23040016,"break":"line","breaks":[[15,"line"]],"ruby":[[10,1,"た"],[19,1,"けもの"],[22,2,"はんさい"],[25,1,"た"]],"text":"レバノンは、たきぎに足りない、またその獣は、燔祭に足りない。"},{"ref":"Isa.40.17","start":23040017,"end":23040017,"break":"line","breaks":[[23,"line"],[41,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"まえ"],[12,2,"こくみん"],[15,1,"な"],[23,1,"かれ"],[26,1,"しゅ"],[32,1,"な"],[51,1,"おも"]],"text":"主のみ前には、もろもろの国民は無きにひとしい。彼らは主によって、無きもののように、むなしいもののように思われる。"},{"ref":"Isa.40.18","start":23040018,"end":23040018,"break":"line","breaks":[[19,"line"]],"ruby":[[10,1,"かみ"],[22,1,"ぞう"],[24,2,"ひかく"]],"text":"それで、あなたがたは神をだれとくらべ、どんな像と比較しようとするのか。"},{"ref":"Isa.40.19","start":23040019,"end":23040019,"break":"line","breaks":[[12,"line"],[29,"line"]],"ruby":[[0,2,"ぐうぞう"],[3,3,"さいくにん"],[7,1,"い"],[9,1,"つく"],[12,2,"かじ"],[16,1,"きん"],[38,1,"ぎん"],[40,1,"くさり"],[42,1,"つく"]],"text":"偶像は細工人が鋳て造り、鍛冶が、金をもって、それをおおい、また、これがために銀の鎖を造る。"},{"ref":"Isa.40.20","start":23040020,"end":23040020,"break":"line","breaks":[[13,"line"],[26,"line"],[37,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[9,1,"もの"],[13,1,"く"],[21,1,"き"],[23,1,"えら"],[26,1,"たく"],[29,3,"さいくにん"],[33,1,"もと"],[37,1,"うご"],[44,1,"ぞう"],[46,1,"た"]],"text":"貧しい者は、ささげ物として朽ちることのない木を選び、巧みな細工人を求めて、動くことのない像を立たせる。"},{"ref":"Isa.40.21","start":23040021,"end":23040021,"break":"line","breaks":[[14,"line"],[28,"line"],[49,"line"],[60,"line"]],"ruby":[[6,1,"し"],[20,1,"き"],[28,1,"はじ"],[39,1,"つた"],[49,1,"ち"],[51,1,"もとい"],[56,1,"とき"],[66,1,"さと"]],"text":"あなたがたは知らなかったか。あなたがたは聞かなかったか。初めから、あなたがたに伝えられなかったか。地の基をおいた時から、あなたがたは悟らなかったか。"},{"ref":"Isa.40.22","start":23040022,"end":23040022,"break":"line","breaks":[[14,"line"],[32,"line"],[45,"line"]],"ruby":[[0,1,"しゅ"],[2,2,"ちきゅう"],[8,1,"うえ"],[10,1,"ざ"],[14,1,"ち"],[16,1,"す"],[18,1,"もの"],[27,1,"み"],[32,1,"しゅ"],[34,1,"てん"],[36,1,"まく"],[48,1,"す"],[52,2,"てんまく"],[58,1,"は"]],"text":"主は地球のはるか上に座して、地に住む者をいなごのように見られる。主は天を幕のようにひろげ、これを住むべき天幕のように張り、"},{"ref":"Isa.40.23","start":23040023,"end":23040023,"break":"line","breaks":[[19,"line"]],"ruby":[[8,1,"きみ"],[10,1,"な"],[19,1,"ち"]],"text":"また、もろもろの君を無きものとせられ、地のつかさたちを、むなしくされる。"},{"ref":"Isa.40.24","start":23040024,"end":23040024,"break":"line","breaks":[[23,"line"],[43,"line"],[62,"line"]],"ruby":[[0,1,"かれ"],[9,1,"う"],[25,1,"みき"],[32,1,"ち"],[34,1,"ね"],[43,1,"かみ"],[47,1,"うえ"],[49,1,"ふ"],[55,1,"かれ"],[58,1,"か"],[72,1,"かぜ"],[76,1,"さ"]],"text":"彼らは、かろうじて植えられ、かろうじてまかれ、その幹がかろうじて地に根をおろしたとき、神がその上を吹かれると、彼らは枯れて、わらのように、つむじ風にまき去られる。"},{"ref":"Isa.40.25","start":23040025,"end":23040025,"break":"line","breaks":[[8,"line"],[31,"line"]],"ruby":[[0,2,"せいじゃ"],[3,1,"い"]],"text":"聖者は言われる、「それで、あなたがたは、わたしをだれにくらべ、わたしは、だれにひとしいというのか」。"},{"ref":"Isa.40.26","start":23040026,"end":23040026,"break":"line","breaks":[[8,"line"],[28,"line"],[45,"line"],[59,"line"],[72,"line"],[85,"line"]],"ruby":[[0,1,"め"],[2,1,"たか"],[19,2,"そうぞう"],[25,1,"み"],[28,1,"しゅ"],[30,1,"かず"],[36,2,"ばんぐん"],[52,1,"な"],[54,1,"よ"],[61,1,"いきお"],[64,1,"おお"],[76,1,"ちから"],[78,1,"つよ"],[88,1,"か"]],"text":"目を高くあげて、だれが、これらのものを創造したかを見よ。主は数をしらべて万軍をひきいだし、おのおのをその名で呼ばれる。その勢いの大いなるにより、またその力の強きがゆえに、一つも欠けることはない。"},{"ref":"Isa.40.27","start":23040027,"end":23040027,"break":"paragraph","breaks":[[13,"line"],[31,"line"],[46,"line"]],"ruby":[[5,1,"なに"],[16,1,"みち"],[18,1,"しゅ"],[20,1,"かく"],[27,1,"い"],[38,1,"なに"],[49,1,"うった"],[54,1,"かみ"],[56,1,"かえり"],[64,1,"い"]],"text":"ヤコブよ、何ゆえあなたは、「わが道は主に隠れている」と言うか。イスラエルよ、何ゆえあなたは、「わが訴えはわが神に顧みられない」と言うか。"},{"ref":"Isa.40.28","start":23040028,"end":23040028,"break":"line","breaks":[[12,"line"],[24,"line"],[45,"line"],[62,"line"]],"ruby":[[4,1,"し"],[16,1,"き"],[24,1,"しゅ"],[31,1,"かみ"],[33,1,"ち"],[35,1,"はて"],[37,3,"そうぞうしゃ"],[45,1,"よわ"],[54,1,"つか"],[64,2,"ちえ"]],"text":"あなたは知らなかったか、あなたは聞かなかったか。主はとこしえの神、地の果の創造者であって、弱ることなく、また疲れることなく、その知恵ははかりがたい。"},{"ref":"Isa.40.29","start":23040029,"end":23040029,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"よわ"],[3,1,"もの"],[6,1,"ちから"],[8,1,"あた"],[11,1,"いきお"],[16,1,"もの"],[19,1,"つよ"],[22,1,"ま"],[24,1,"くわ"]],"text":"弱った者には力を与え、勢いのない者には強さを増し加えられる。"},{"ref":"Isa.40.30","start":23040030,"end":23040030,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"ねん"],[1,1,"わか"],[3,1,"もの"],[5,1,"よわ"],[10,1,"つか"],[13,2,"そうねん"],[16,1,"もの"],[18,1,"つか"],[23,1,"たお"]],"text":"年若い者も弱り、かつ疲れ、壮年の者も疲れはてて倒れる。"},{"ref":"Isa.40.31","start":23040031,"end":23040031,"break":"line","breaks":[[19,"line"],[41,"line"],[53,"line"]],"ruby":[[3,1,"しゅ"],[5,1,"ま"],[7,1,"のぞ"],[9,1,"もの"],[11,1,"あら"],[15,1,"ちから"],[17,1,"え"],[25,1,"つばさ"],[41,1,"はし"],[45,1,"つか"],[53,1,"ある"],[57,1,"よわ"]],"text":"しかし主を待ち望む者は新たなる力を得、わしのように翼をはって、のぼることができる。走っても疲れることなく、歩いても弱ることはない。"}]