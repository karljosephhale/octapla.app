[{"ref":"Rom.8.1","start":45008001,"end":45008001,"break":"paragraph","ruby":[[8,1,"いま"],[21,1,"もの"],[23,1,"つみ"],[25,1,"さだ"]],"text":"こういうわけで、今やキリスト・イエスにある者は罪に定められることがない。"},{"ref":"Rom.8.2","start":45008002,"end":45008002,"break":"none","ruby":[[20,2,"みたま"],[23,2,"ほうそく"],[27,1,"つみ"],[29,1,"し"],[32,2,"ほうそく"],[40,2,"かいほう"]],"text":"なぜなら、キリスト・イエスにあるいのちの御霊の法則は、罪と死との法則からあなたを解放したからである。"},{"ref":"Rom.8.3","start":45008003,"end":45008003,"break":"none","ruby":[[0,2,"りっぽう"],[3,1,"にく"],[7,2,"むりょく"],[20,1,"え"],[25,1,"こと"],[28,1,"かみ"],[32,1,"と"],[35,1,"くだ"],[45,2,"みこ"],[49,1,"つみ"],[51,1,"にく"],[53,1,"さま"],[55,1,"つみ"],[65,1,"にく"],[70,1,"つみ"],[72,1,"ばっ"]],"text":"律法が肉により無力になっているためになし得なかった事を、神はなし遂げて下さった。すなわち、御子を、罪の肉の様で罪のためにつかわし、肉において罪を罰せられたのである。"},{"ref":"Rom.8.4","start":45008004,"end":45008004,"break":"none","ruby":[[3,2,"りっぽう"],[6,2,"ようきゅう"],[10,1,"にく"],[15,1,"れい"],[20,1,"ある"],[32,1,"み"]],"text":"これは律法の要求が、肉によらず霊によって歩くわたしたちにおいて、満たされるためである。"},{"ref":"Rom.8.5","start":45008005,"end":45008005,"break":"none","ruby":[[5,1,"にく"],[7,1,"したが"],[9,1,"もの"],[11,1,"にく"],[16,1,"おも"],[19,1,"れい"],[21,1,"したが"],[23,1,"もの"],[25,1,"れい"],[30,1,"おも"]],"text":"なぜなら、肉に従う者は肉のことを思い、霊に従う者は霊のことを思うからである。"},{"ref":"Rom.8.6","start":45008006,"end":45008006,"break":"none","ruby":[[0,1,"にく"],[2,1,"おも"],[5,1,"し"],[11,1,"れい"],[13,1,"おも"],[21,2,"へいあん"]],"text":"肉の思いは死であるが、霊の思いは、いのちと平安とである。"},{"ref":"Rom.8.7","start":45008007,"end":45008007,"break":"none","ruby":[[5,1,"にく"],[7,1,"おも"],[10,1,"かみ"],[12,1,"てき"],[29,1,"かみ"],[31,2,"りっぽう"],[34,1,"したが"],[38,1,"いな"],[40,1,"したが"],[42,1,"え"]],"text":"なぜなら、肉の思いは神に敵するからである。すなわち、それは神の律法に従わず、否、従い得ないのである。"},{"ref":"Rom.8.8","start":45008008,"end":45008008,"break":"none","ruby":[[3,1,"にく"],[7,1,"もの"],[10,1,"かみ"],[12,1,"よろこ"]],"text":"また、肉にある者は、神を喜ばせることができない。"},{"ref":"Rom.8.9","start":45008009,"end":45008009,"break":"none","ruby":[[4,1,"かみ"],[6,2,"みたま"],[15,1,"うち"],[17,1,"やど"],[31,1,"にく"],[41,1,"れい"],[58,1,"れい"],[60,1,"も"],[64,1,"ひと"],[73,1,"ひと"]],"text":"しかし、神の御霊があなたがたの内に宿っているなら、あなたがたは肉におるのではなく、霊におるのである。もし、キリストの霊を持たない人がいるなら、その人はキリストのものではない。"},{"ref":"Rom.8.10","start":45008010,"end":45008010,"break":"none","ruby":[[14,1,"うち"],[27,1,"つみ"],[32,1,"し"],[39,1,"れい"],[41,1,"ぎ"],[46,1,"い"]],"text":"もし、キリストがあなたがたの内におられるなら、からだは罪のゆえに死んでいても、霊は義のゆえに生きているのである。"},{"ref":"Rom.8.11","start":45008011,"end":45008011,"break":"none","ruby":[[7,2,"しにん"],[10,1,"なか"],[23,2,"みたま"],[33,1,"うち"],[35,1,"やど"],[52,2,"しにん"],[55,1,"なか"],[75,1,"うち"],[77,1,"やど"],[82,2,"みたま"],[95,1,"し"],[105,1,"い"]],"text":"もし、イエスを死人の中からよみがえらせたかたの御霊が、あなたがたの内に宿っているなら、キリスト・イエスを死人の中からよみがえらせたかたは、あなたがたの内に宿っている御霊によって、あなたがたの死ぬべきからだをも、生かしてくださるであろう。"},{"ref":"Rom.8.12","start":45008012,"end":45008012,"break":"paragraph","ruby":[[6,2,"きょうだい"],[19,1,"はた"],[23,2,"せきにん"],[26,1,"お"],[31,1,"もの"],[37,1,"にく"],[39,1,"したが"],[42,1,"い"],[45,2,"せきにん"],[48,1,"にく"],[50,1,"たい"],[53,1,"お"]],"text":"それゆえに、兄弟たちよ。わたしたちは、果すべき責任を負っている者であるが、肉に従って生きる責任を肉に対して負っているのではない。"},{"ref":"Rom.8.13","start":45008013,"end":45008013,"break":"none","ruby":[[8,1,"にく"],[10,1,"したが"],[13,1,"い"],[25,1,"し"],[27,1,"ほか"],[41,1,"れい"],[50,1,"はたら"],[53,1,"ころ"],[64,1,"い"]],"text":"なぜなら、もし、肉に従って生きるなら、あなたがたは死ぬ外はないからである。しかし、霊によってからだの働きを殺すなら、あなたがたは生きるであろう。"},{"ref":"Rom.8.14","start":45008014,"end":45008014,"break":"none","ruby":[[3,1,"かみ"],[5,2,"みたま"],[8,1,"みちび"],[14,1,"もの"],[22,1,"かみ"],[24,1,"こ"]],"text":"すべて神の御霊に導かれている者は、すなわち、神の子である。"},{"ref":"Rom.8.15","start":45008015,"end":45008015,"break":"none","ruby":[[6,1,"ふたた"],[8,1,"おそ"],[16,2,"どれい"],[19,1,"れい"],[21,1,"う"],[30,1,"こ"],[33,2,"みぶん"],[36,1,"さづ"],[39,1,"れい"],[41,1,"う"],[51,1,"れい"],[67,1,"ちち"],[71,1,"よ"]],"text":"あなたがたは再び恐れをいだかせる奴隷の霊を受けたのではなく、子たる身分を授ける霊を受けたのである。その霊によって、わたしたちは「アバ、父よ」と呼ぶのである。"},{"ref":"Rom.8.16","start":45008016,"end":45008016,"break":"none","ruby":[[0,2,"みたま"],[13,1,"れい"],[15,1,"とも"],[24,1,"かみ"],[26,1,"こ"],[38,1,"くだ"]],"text":"御霊みずから、わたしたちの霊と共に、わたしたちが神の子であることをあかしして下さる。"},{"ref":"Rom.8.17","start":45008017,"end":45008017,"break":"none","ruby":[[2,1,"こ"],[8,3,"そうぞくにん"],[16,1,"かみ"],[18,3,"そうぞくにん"],[31,2,"えいこう"],[34,1,"とも"],[41,2,"くなん"],[45,1,"とも"],[51,2,"いじょう"],[59,2,"きょうどう"],[62,3,"そうぞくにん"]],"text":"もし子であれば、相続人でもある。神の相続人であって、キリストと栄光を共にするために苦難をも共にしている以上、キリストと共同の相続人なのである。"},{"ref":"Rom.8.18","start":45008018,"end":45008018,"break":"paragraph","ruby":[[4,1,"おも"],[7,1,"いま"],[11,1,"とき"],[13,1,"くる"],[27,1,"あらわ"],[35,2,"えいこう"],[38,1,"くら"],[43,1,"い"],[46,1,"た"]],"text":"わたしは思う。今のこの時の苦しみは、やがてわたしたちに現されようとする栄光に比べると、言うに足りない。"},{"ref":"Rom.8.19","start":45008019,"end":45008019,"break":"none","ruby":[[0,1,"ひ"],[1,2,"ぞうぶつ"],[5,1,"じつ"],[8,1,"せつ"],[11,1,"おも"],[14,1,"かみ"],[16,1,"こ"],[20,2,"しゅつげん"],[23,1,"ま"],[25,1,"のぞ"]],"text":"被造物は、実に、切なる思いで神の子たちの出現を待ち望んでいる。"},{"ref":"Rom.8.20","start":45008020,"end":45008020,"break":"none","ruby":[[5,1,"ひ"],[6,2,"ぞうぶつ"],[9,2,"きょむ"],[12,1,"ふく"],[18,2,"じぶん"],[21,2,"いし"],[32,2,"ふくじゅう"]],"text":"なぜなら、被造物が虚無に服したのは、自分の意志によるのではなく、服従させたかたによるのであり、"},{"ref":"Rom.8.21","start":45008021,"end":45008021,"break":"none","ruby":[[3,1,"ひ"],[4,2,"ぞうぶつ"],[6,2,"じしん"],[11,1,"ほろ"],[19,2,"かいほう"],[25,1,"かみ"],[27,1,"こ"],[31,2,"えいこう"],[34,2,"じゆう"],[37,1,"はい"],[39,1,"のぞ"],[42,1,"のこ"]],"text":"かつ、被造物自身にも、滅びのなわめから解放されて、神の子たちの栄光の自由に入る望みが残されているからである。"},{"ref":"Rom.8.22","start":45008022,"end":45008022,"break":"none","ruby":[[0,1,"じつ"],[3,1,"ひ"],[4,2,"ぞうぶつ"],[6,2,"ぜんたい"],[10,1,"いま"],[12,1,"いた"],[17,1,"とも"],[22,1,"とも"],[24,1,"う"],[27,1,"くる"],[31,1,"つづ"],[46,1,"し"]],"text":"実に、被造物全体が、今に至るまで、共にうめき共に産みの苦しみを続けていることを、わたしたちは知っている。"},{"ref":"Rom.8.23","start":45008023,"end":45008023,"break":"none","ruby":[[9,2,"みたま"],[12,2,"さいしょ"],[15,1,"み"],[17,1,"も"],[27,2,"じしん"],[31,1,"こころ"],[33,1,"うち"],[42,1,"こ"],[45,2,"みぶん"],[48,1,"さづ"],[74,1,"ま"],[76,1,"のぞ"]],"text":"それだけではなく、御霊の最初の実を持っているわたしたち自身も、心の内でうめきながら、子たる身分を授けられること、すなわち、からだのあがなわれることを待ち望んでいる。"},{"ref":"Rom.8.24","start":45008024,"end":45008024,"break":"none","ruby":[[9,1,"のぞ"],[15,1,"すく"],[30,1,"め"],[32,1,"み"],[35,1,"のぞ"],[38,1,"のぞ"],[50,1,"げん"],[52,1,"み"],[56,1,"こと"],[66,1,"のぞ"],[68,1,"ひと"]],"text":"わたしたちは、この望みによって救われているのである。しかし、目に見える望みは望みではない。なぜなら、現に見ている事を、どうして、なお望む人があろうか。"},{"ref":"Rom.8.25","start":45008025,"end":45008025,"break":"none","ruby":[[9,1,"み"],[15,1,"のぞ"],[26,2,"にんたい"],[34,1,"ま"],[36,1,"のぞ"]],"text":"もし、わたしたちが見ないことを望むなら、わたしたちは忍耐して、それを待ち望むのである。"},{"ref":"Rom.8.26","start":45008026,"end":45008026,"break":"paragraph","ruby":[[0,2,"みたま"],[5,1,"おな"],[11,1,"よわ"],[19,1,"たす"],[22,1,"くだ"],[39,1,"いの"],[53,2,"みたま"],[60,2,"ことば"],[69,1,"せつ"],[94,1,"くだ"]],"text":"御霊もまた同じように、弱いわたしたちを助けて下さる。なぜなら、わたしたちはどう祈ったらよいかわからないが、御霊みずから、言葉にあらわせない切なるうめきをもって、わたしたちのためにとりなして下さるからである。"},{"ref":"Rom.8.27","start":45008027,"end":45008027,"break":"none","ruby":[[4,1,"ひと"],[6,1,"こころ"],[8,1,"さぐ"],[10,1,"し"],[16,2,"みたま"],[19,1,"おも"],[32,1,"し"],[45,2,"みたま"],[49,2,"せいと"],[56,1,"かみ"],[58,2,"みむね"],[71,1,"くだ"]],"text":"そして、人の心を探り知るかたは、御霊の思うところがなんであるかを知っておられる。なぜなら、御霊は、聖徒のために、神の御旨にかなうとりなしをして下さるからである。"},{"ref":"Rom.8.28","start":45008028,"end":45008028,"break":"none","ruby":[[0,1,"かみ"],[3,1,"かみ"],[5,1,"あい"],[8,1,"もの"],[18,2,"けいかく"],[21,1,"したが"],[24,1,"め"],[28,1,"もの"],[32,1,"とも"],[34,1,"はたら"],[38,2,"ばんじ"],[41,1,"えき"],[50,1,"くだ"],[63,1,"し"]],"text":"神は、神を愛する者たち、すなわち、ご計画に従って召された者たちと共に働いて、万事を益となるようにして下さることを、わたしたちは知っている。"},{"ref":"Rom.8.29","start":45008029,"end":45008029,"break":"none","ruby":[[0,1,"かみ"],[7,1,"し"],[14,1,"もの"],[19,1,"さら"],[21,2,"みこ"],[28,1,"に"],[45,1,"さだ"],[48,1,"くだ"],[57,2,"みこ"],[60,1,"おお"],[63,2,"きょうだい"],[66,1,"なか"],[68,2,"ちょうし"]],"text":"神はあらかじめ知っておられる者たちを、更に御子のかたちに似たものとしようとして、あらかじめ定めて下さった。それは、御子を多くの兄弟の中で長子とならせるためであった。"},{"ref":"Rom.8.30","start":45008030,"end":45008030,"break":"none","ruby":[[9,1,"さだ"],[12,1,"もの"],[16,1,"さら"],[18,1,"め"],[21,1,"め"],[24,1,"もの"],[28,1,"さら"],[30,1,"ぎ"],[34,1,"ぎ"],[38,1,"もの"],[44,1,"さら"],[46,2,"えいこう"],[49,1,"あた"],[52,1,"くだ"]],"text":"そして、あらかじめ定めた者たちを更に召し、召した者たちを更に義とし、義とした者たちには、更に栄光を与えて下さったのである。"},{"ref":"Rom.8.31","start":45008031,"end":45008031,"break":"paragraph","ruby":[[9,1,"こと"],[18,1,"い"],[26,1,"かみ"],[34,2,"みかた"],[51,1,"てき"],[53,1,"え"]],"text":"それでは、これらの事について、なんと言おうか。もし、神がわたしたちの味方であるなら、だれがわたしたちに敵し得ようか。"},{"ref":"Rom.8.32","start":45008032,"end":45008032,"break":"none","ruby":[[1,2,"じしん"],[4,2,"みこ"],[9,1,"お"],[25,1,"もの"],[30,1,"し"],[32,1,"わた"],[45,2,"みこ"],[52,2,"ばんぶつ"],[56,1,"たま"]],"text":"ご自身の御子をさえ惜しまないで、わたしたちすべての者のために死に渡されたかたが、どうして、御子のみならず万物をも賜わらないことがあろうか。"},{"ref":"Rom.8.33","start":45008033,"end":45008033,"break":"none","ruby":[[4,1,"かみ"],[6,1,"えら"],[10,1,"もの"],[14,1,"うった"],[20,1,"かみ"],[22,1,"かれ"],[25,1,"ぎ"]],"text":"だれが、神の選ばれた者たちを訴えるのか。神は彼らを義とされるのである。"},{"ref":"Rom.8.34","start":45008034,"end":45008034,"break":"none","ruby":[[10,1,"つみ"],[12,1,"さだ"],[28,1,"し"],[32,1,"いな"],[41,1,"かみ"],[43,1,"みぎ"],[45,1,"ざ"],[65,1,"くだ"]],"text":"だれが、わたしたちを罪に定めるのか。キリスト・イエスは、死んで、否、よみがえって、神の右に座し、また、わたしたちのためにとりなして下さるのである。"},{"ref":"Rom.8.35","start":45008035,"end":45008035,"break":"none","ruby":[[9,1,"あい"],[18,1,"はな"],[26,2,"かんなん"],[30,2,"くのう"],[34,2,"はくがい"],[38,1,"う"],[42,1,"はだか"],[45,2,"きなん"],[49,1,"つるぎ"]],"text":"だれが、キリストの愛からわたしたちを離れさせるのか。患難か、苦悩か、迫害か、飢えか、裸か、危難か、剣か。"},{"ref":"Rom.8.36","start":45008036,"end":45008036,"break":"stanza","breaks":[[17,"line"],[27,"line"]],"ruby":[[14,2,"しゅうじつ"],[17,1,"し"],[19,1,"さだ"],[32,1,"ひつじ"],[37,1,"み"],[45,1,"か"]],"text":"「わたしたちはあなたのために終日、死に定められており、ほふられる羊のように見られている」と書いてあるとおりである。"},{"ref":"Rom.8.37","start":45008037,"end":45008037,"break":"none","ruby":[[10,1,"あい"],[13,1,"くだ"],[38,1,"こと"],[43,1,"か"],[45,1,"え"],[47,1,"あま"]],"text":"しかし、わたしたちを愛して下さったかたによって、わたしたちは、これらすべての事において勝ち得て余りがある。"},{"ref":"Rom.8.38","start":45008038,"end":45008038,"break":"none","ruby":[[4,2,"かくしん"],[9,1,"し"],[11,1,"せい"],[14,2,"てんし"],[17,3,"しはいしゃ"],[22,2,"げんざい"],[28,2,"しょうらい"],[35,1,"ちから"]],"text":"わたしは確信する。死も生も、天使も支配者も、現在のものも将来のものも、力あるものも、"},{"ref":"Rom.8.39","start":45008039,"end":45008039,"break":"none","ruby":[[0,1,"たか"],[5,1,"ふか"],[13,1,"た"],[17,1,"ひ"],[18,2,"ぞうぶつ"],[28,1,"しゅ"],[41,1,"かみ"],[43,1,"あい"],[53,1,"ひ"],[55,1,"はな"]],"text":"高いものも深いものも、その他どんな被造物も、わたしたちの主キリスト・イエスにおける神の愛から、わたしたちを引き離すことはできないのである。"}]