[{"ref":"2Chr.25.1","start":14025001,"end":14025001,"break":"paragraph","ruby":[[5,1,"おう"],[10,1,"とき"],[14,1,"さい"],[20,1,"ねん"],[22,1,"あいだ"],[29,1,"よ"],[31,1,"おさ"],[37,1,"はは"],[45,1,"もの"],[48,1,"な"]],"text":"アマジヤは王となった時二十五歳で、二十九年の間エルサレムで世を治めた。その母はエルサレムの者で、名をエホアダンといった。"},{"ref":"2Chr.25.2","start":14025002,"end":14025002,"break":"none","ruby":[[5,1,"しゅ"],[7,1,"よ"],[10,1,"み"],[17,1,"おこな"],[22,1,"まった"],[24,1,"こころ"]],"text":"アマジヤは主の良しと見られることを行ったが、全き心をもってではなかった。"},{"ref":"2Chr.25.3","start":14025003,"end":14025003,"break":"none","ruby":[[0,1,"かれ"],[3,1,"くに"],[5,1,"かれ"],[7,1,"て"],[12,1,"つよ"],[20,1,"ちち"],[24,1,"おう"],[26,2,"さつがい"],[30,2,"けらい"],[35,1,"ころ"]],"text":"彼は、国が彼の手のうちに強くなったとき、父ヨアシ王を殺害した家来たちを殺した。"},{"ref":"2Chr.25.4","start":14025004,"end":14025004,"break":"none","ruby":[[5,1,"こ"],[6,1,"とも"],[10,1,"ころ"],[24,2,"りっぽう"],[27,1,"しょ"],[36,1,"ところ"],[38,1,"したが"],[50,1,"しゅ"],[52,1,"めい"],[57,1,"ちち"],[59,1,"こ"],[64,1,"ころ"],[75,1,"こ"],[77,1,"ちち"],[82,1,"ころ"],[97,2,"じぶん"],[100,1,"つみ"],[105,1,"ころ"],[116,1,"い"]],"text":"しかしその子供たちは殺さなかった。これはモーセの律法の書にしるされている所に従ったのであって、そこに主は命じて、「父は子のゆえに殺されるべきではない。子は父のゆえに殺されるべきではない。おのおの自分の罪のゆえに殺されるべきである」と言われている。"},{"ref":"2Chr.25.5","start":14025005,"end":14025005,"break":"paragraph","ruby":[[8,2,"ひとびと"],[11,1,"あつ"],[16,2,"しぞく"],[19,1,"したが"],[24,1,"にん"],[26,1,"ちょう"],[28,2,"ふぞく"],[37,1,"にん"],[39,1,"ちょう"],[41,2,"ふぞく"],[60,1,"い"],[69,1,"さい"],[70,2,"いじょう"],[73,1,"もの"],[75,1,"かぞ"],[85,1,"たて"],[90,1,"たたか"],[93,1,"のぞ"],[97,2,"せいへい"],[102,1,"にん"],[104,1,"え"]],"text":"アマジヤはユダの人々を集め、その氏族に従って、千人の長に付属させ、または百人の長に付属させた。ユダとベニヤミンのすべてに行った。そして二十歳以上の者を数えたところ、やりと盾をとって戦いに臨みうる精兵三十万人を得た。"},{"ref":"2Chr.25.6","start":14025006,"end":14025006,"break":"none","ruby":[[0,1,"かれ"],[4,1,"ぎん"],[21,1,"だい"],[22,2,"ゆうし"],[26,1,"にん"],[28,1,"やと"]],"text":"彼はまた銀百タラントをもってイスラエルから大勇士十万人を雇った。"},{"ref":"2Chr.25.7","start":14025007,"end":14025007,"break":"none","ruby":[[2,1,"とき"],[4,1,"かみ"],[6,1,"ひと"],[8,1,"かれ"],[10,1,"ところ"],[12,1,"き"],[14,1,"い"],[19,1,"おう"],[28,2,"ぐんぜい"],[35,1,"とも"],[37,1,"い"],[48,1,"しゅ"],[72,2,"ひとびと"],[76,1,"とも"]],"text":"その時、神の人が彼の所に来て言った、「王よ、イスラエルの軍勢をあなたと共に行かせてはいけません。主はイスラエルびと、すなわちエフライムのすべての人々とは共におられないからです。"},{"ref":"2Chr.25.8","start":14025008,"end":14025008,"break":"none","ruby":[[11,2,"ほうほう"],[14,1,"たたか"],[17,1,"つよ"],[23,1,"おも"],[29,1,"かみ"],[35,1,"てき"],[37,1,"まえ"],[39,1,"たお"],[48,1,"かみ"],[51,1,"たす"],[54,1,"ちから"],[61,1,"たお"],[63,1,"ちから"]],"text":"もしあなたがこのような方法で戦いに強くなろうと思うならば、神はあなたを敵の前に倒されるでしょう。神には助ける力があり、また倒す力があるからです」。"},{"ref":"2Chr.25.9","start":14025009,"end":14025009,"break":"none","ruby":[[5,1,"かみ"],[7,1,"ひと"],[9,1,"い"],[28,2,"ぐんたい"],[31,1,"あた"],[50,1,"かみ"],[52,1,"ひと"],[54,1,"こた"],[59,1,"しゅ"],[66,1,"おお"],[76,1,"あた"]],"text":"アマジヤは神の人に言った、「それではわたしがイスラエルの軍隊に与えた百タラントをどうしましょうか」。神の人は答えた、「主はそれよりも多いものをあなたにお与えになることができます」。"},{"ref":"2Chr.25.10","start":14025010,"end":14025010,"break":"none","ruby":[[15,1,"き"],[17,2,"じぶん"],[20,1,"くわ"],[24,2,"ぐんたい"],[27,2,"ぶんり"],[31,1,"かえ"],[38,1,"かれ"],[44,1,"たい"],[47,1,"はげ"],[50,1,"いか"],[53,1,"はっ"],[56,1,"ひ"],[61,1,"いか"],[64,2,"じぶん"],[67,1,"ところ"],[69,1,"かえ"]],"text":"そこでアマジヤはエフライムから来て自分に加わった軍隊を分離して帰らせたので、彼らはユダに対して激しい怒りを発し、火のように怒って自分の所に帰った。"},{"ref":"2Chr.25.11","start":14025011,"end":14025011,"break":"none","ruby":[[8,2,"ゆうき"],[11,1,"だ"],[16,1,"たみ"],[18,1,"ひき"],[21,1,"しお"],[23,1,"たに"],[25,1,"い"],[35,1,"にん"],[37,1,"う"],[39,1,"ころ"]],"text":"しかしアマジヤは勇気を出し、その民を率いて塩の谷へ行き、セイルびと一万人を撃ち殺した。"},{"ref":"2Chr.25.12","start":14025012,"end":14025012,"break":"none","ruby":[[5,2,"ひとびと"],[15,1,"にん"],[22,1,"いわ"],[24,1,"いただき"],[26,1,"ひ"],[29,1,"い"],[32,1,"いわ"],[34,1,"いただき"],[37,1,"かれ"],[40,1,"な"],[42,1,"おと"],[48,1,"みな"],[54,1,"くだ"]],"text":"またユダの人々はこのほかに一万人をいけどり、岩の頂に引いて行って岩の頂から彼らを投げ落したので、皆こなごなに砕けた。"},{"ref":"2Chr.25.13","start":14025013,"end":14025013,"break":"none","ruby":[[9,2,"じぶん"],[12,1,"とも"],[14,1,"たたか"],[17,1,"い"],[23,1,"き"],[29,2,"へいそつ"],[52,2,"まちまち"],[55,1,"おそ"],[60,1,"にん"],[62,1,"ころ"],[65,1,"おお"],[68,1,"もの"],[70,1,"うば"],[72,1,"と"]],"text":"ところがアマジヤが自分と共に戦いに行かせないで帰してやった兵卒らが、サマリヤからベテホロンまでの、ユダの町々を襲って三千人を殺し、多くの物を奪い取った。"},{"ref":"2Chr.25.14","start":14025014,"end":14025014,"break":"paragraph","ruby":[[11,1,"ころ"],[14,1,"かえ"],[17,1,"とき"],[25,2,"かみがみ"],[28,1,"たずさ"],[37,2,"あんち"],[41,2,"じぶん"],[44,1,"かみ"],[51,2,"れいはい"],[61,1,"もの"]],"text":"アマジヤはエドムびとを殺して帰った時、セイルびとの神々を携えてきて、これを安置して自分の神とし、これを礼拝し、これにささげ物をなした。"},{"ref":"2Chr.25.15","start":14025015,"end":14025015,"break":"none","ruby":[[5,1,"しゅ"],[12,1,"む"],[16,1,"いか"],[19,1,"はっ"],[22,3,"よげんしゃ"],[26,1,"かれ"],[33,1,"い"],[43,1,"たみ"],[45,2,"かみがみ"],[48,2,"じぶん"],[51,1,"たみ"],[57,1,"て"],[60,1,"すく"],[85,1,"もと"]],"text":"それゆえ、主はアマジヤに向かって怒りを発し、預言者を彼につかわして言わせられた、「かの民の神々は自分の民をあなたの手から救うことができなかったのに、あなたはどうしてそれを求めたのか」。"},{"ref":"2Chr.25.16","start":14025016,"end":14025016,"break":"none","ruby":[[0,1,"かれ"],[4,1,"おう"],[6,1,"かた"],[10,1,"おう"],[12,1,"かれ"],[25,1,"おう"],[27,2,"こもん"],[51,1,"ころ"],[65,1,"い"],[71,3,"よげんしゃ"],[78,1,"い"],[89,1,"こと"],[91,1,"い"],[103,1,"き"],[112,1,"かみ"],[118,1,"ほろ"],[123,1,"さだ"],[135,1,"し"]],"text":"彼がこう王に語ると、王は彼に、「われわれはあなたを王の顧問にしたのですか。やめなさい。あなたはどうして殺されようとするのですか」と言ったので、預言者はやめて言った、「あなたはこの事を行って、わたしのいさめを聞きいれないゆえ、神はあなたを滅ぼそうと定められたことをわたしは知っています」。"},{"ref":"2Chr.25.17","start":14025017,"end":14025017,"break":"paragraph","ruby":[[6,1,"おう"],[12,2,"きょうぎ"],[15,2,"けっか"],[18,1,"ひと"],[24,1,"こ"],[31,1,"こ"],[41,1,"おう"],[60,1,"たがい"],[62,1,"かお"],[71,1,"い"]],"text":"そこでユダの王アマジヤは協議の結果、人をエヒウの子エホアハズの子であるイスラエルの王ヨアシにつかわし、「さあ、われわれは互に顔をあわせよう」と言わせたところ、"},{"ref":"2Chr.25.18","start":14025018,"end":14025018,"break":"none","ruby":[[6,1,"おう"],[14,1,"おう"],[20,1,"い"],[22,1,"おく"],[45,2,"こうはく"],[54,1,"むすめ"],[64,1,"つま"],[66,1,"あた"],[71,1,"い"],[73,1,"おく"],[86,2,"やじゅう"],[89,1,"とお"],[102,1,"ふ"],[104,1,"たお"]],"text":"イスラエルの王ヨアシはユダの王アマジヤに言い送った、「レバノンのいばらが、かつてレバノンの香柏に、『あなたの娘をわたしのむすこの妻に与えよ』と言い送ったところが、レバノンの野獣が通りかかって、そのいばらを踏み倒した。"},{"ref":"2Chr.25.19","start":14025019,"end":14025019,"break":"none","ruby":[[5,1,"み"],[16,1,"う"],[18,1,"やぶ"],[23,1,"い"],[26,1,"こころ"],[28,1,"ほこ"],[30,1,"たか"],[44,2,"じぶん"],[47,1,"いえ"],[67,1,"わざわい"],[69,1,"ひ"],[71,1,"おこ"],[75,2,"じぶん"],[81,1,"とも"],[83,1,"ほろ"]],"text":"あなたは『見よ、わたしはエドムを撃ち破った』と言って心に誇り高ぶっている。しかしあなたは自分の家にとどまっていなさい。どうしてあなたは災を引き起して、自分もユダも共に滅びようとするのか」。"},{"ref":"2Chr.25.20","start":14025020,"end":14025020,"break":"paragraph","ruby":[[8,1,"き"],[20,1,"かみ"],[23,1,"で"],[31,1,"かれ"],[38,2,"かみがみ"],[41,1,"もと"],[46,1,"かみ"],[48,1,"かれ"],[51,1,"てき"],[53,1,"て"],[55,1,"わた"]],"text":"しかしアマジヤは聞きいれなかった。これは神から出たのであって、彼らがエドムの神々を求めたので神は彼らを敵の手に渡されるためである。"},{"ref":"2Chr.25.21","start":14025021,"end":14025021,"break":"none","ruby":[[9,1,"おう"],[14,1,"のぼ"],[17,1,"き"],[32,1,"おう"],[38,1,"かお"],[40,1,"あ"]],"text":"そこでイスラエルの王ヨアシは上って来て、ユダのベテシメシでユダの王アマジヤと顔を合わせたが、"},{"ref":"2Chr.25.22","start":14025022,"end":14025022,"break":"none","ruby":[[9,1,"う"],[11,1,"やぶ"],[21,2,"てんまく"],[24,1,"に"],[26,1,"かえ"]],"text":"ユダはイスラエルに撃ち破られ、おのおのその天幕に逃げ帰った。"},{"ref":"2Chr.25.23","start":14025023,"end":14025023,"break":"none","ruby":[[2,1,"とき"],[9,1,"おう"],[20,1,"こ"],[25,1,"こ"],[32,1,"おう"],[44,1,"とら"],[54,1,"ひ"],[57,1,"い"],[66,2,"じょうへき"],[74,1,"もん"],[78,1,"すみ"],[80,1,"もん"]],"text":"その時イスラエルの王ヨアシはエホアハズの子ヨアシの子であるユダの王アマジヤをベテシメシで捕えて、エルサレムに引いて行き、エルサレムの城壁をエフライム門から、隅の門まで四百キュビトほどをこわし、"},{"ref":"2Chr.25.24","start":14025024,"end":14025024,"break":"none","ruby":[[2,1,"かみ"],[4,1,"みや"],[17,1,"まも"],[26,2,"きんぎん"],[36,2,"うつわもの"],[42,1,"おう"],[44,1,"いえ"],[46,2,"ざいほう"],[49,1,"うば"],[54,2,"ひとじち"],[66,1,"かえ"]],"text":"また神の宮のうちで、オベデエドムが守っていたすべての金銀およびもろもろの器物ならびに王の家の財宝を奪い、また人質をとって、サマリヤに帰った。"},{"ref":"2Chr.25.25","start":14025025,"end":14025025,"break":"paragraph","ruby":[[3,1,"おう"],[8,1,"こ"],[20,1,"おう"],[27,1,"こ"],[32,1,"し"],[35,1,"のち"],[40,1,"ねん"],[41,1,"い"]],"text":"ユダの王ヨアシの子アマジヤはイスラエルの王エホアハズの子ヨアシが死んで後なお十五年生きながらえた。"},{"ref":"2Chr.25.26","start":14025026,"end":14025026,"break":"none","ruby":[[7,1,"た"],[9,2,"しじゅう"],[12,2,"こうい"],[25,1,"れつ"],[26,1,"おう"],[28,1,"しょ"]],"text":"アマジヤのその他の始終の行為は、ユダとイスラエルの列王の書にしるされているではないか。"},{"ref":"2Chr.25.27","start":14025027,"end":14025027,"break":"none","ruby":[[10,1,"しゅ"],[12,1,"したが"],[19,1,"とき"],[23,2,"ひとびと"],[35,1,"とう"],[37,1,"むす"],[40,1,"かれ"],[42,1,"てき"],[48,1,"かれ"],[54,1,"に"],[57,1,"い"],[64,2,"ひとびと"],[71,1,"ひと"],[77,1,"かれ"],[81,1,"ところ"],[83,1,"ころ"]],"text":"アマジヤがそむいて、主に従わなくなった時から、人々はエルサレムにおいて党を結び、彼に敵したので、彼はラキシに逃げて行ったが、その人々はラキシに人をやって、彼をその所で殺させた。"},{"ref":"2Chr.25.28","start":14025028,"end":14025028,"break":"none","ruby":[[0,2,"ひとびと"],[6,1,"うま"],[8,1,"お"],[12,1,"も"],[21,1,"まち"],[25,2,"せんぞ"],[30,1,"とも"],[35,1,"ほうむ"]],"text":"人々はこれを馬に負わせて持ってきて、ユダの町でその先祖たちと共にこれを葬った。"}]