[{"ref":"1Sam.17.1","start":9017001,"end":9017001,"break":"paragraph","ruby":[[10,1,"ぐん"],[12,1,"あつ"],[15,1,"たたか"],[24,1,"ぞく"],[30,1,"あつ"],[42,1,"あいだ"],[54,2,"じんど"]],"text":"さてペリシテびとは、軍を集めて戦おうとし、ユダに属するソコに集まって、ソコとアゼカの間にあるエペス・ダミムに陣取った。"},{"ref":"1Sam.17.2","start":9017002,"end":9017002,"break":"none","ruby":[[10,2,"ひとびと"],[13,1,"あつ"],[20,1,"たに"],[22,2,"じんど"],[33,1,"たい"],[36,2,"せんれつ"]],"text":"サウルとイスラエルの人々は集まってエラの谷に陣取り、ペリシテびとに対して戦列をしいた。"},{"ref":"1Sam.17.3","start":9017003,"end":9017003,"break":"none","ruby":[[7,1,"む"],[11,1,"やま"],[13,1,"うえ"],[15,1,"た"],[28,1,"やま"],[30,1,"うえ"],[32,1,"た"],[38,1,"かん"],[40,1,"たに"]],"text":"ペリシテびとは向こうの山の上に立ち、イスラエルはこちらの山の上に立った。その間に谷があった。"},{"ref":"1Sam.17.4","start":9017004,"end":9017004,"break":"none","ruby":[[0,1,"とき"],[10,1,"じん"],[24,1,"な"],[27,1,"たたか"],[33,1,"もの"],[35,1,"で"],[40,1,"み"],[50,1,"はん"]],"text":"時に、ペリシテびとの陣から、ガテのゴリアテという名の、戦いをいどむ者が出てきた。身のたけは六キュビト半。"},{"ref":"1Sam.17.5","start":9017005,"end":9017005,"break":"none","ruby":[[0,1,"あたま"],[3,2,"せいどう"],[10,1,"いただ"],[13,1,"み"],[27,1,"き"],[38,2,"せいどう"],[41,1,"おも"]],"text":"頭には青銅のかぶとを頂き、身には、うろことじのよろいを着ていた。そのよろいは青銅で重さ五千シケル。"},{"ref":"1Sam.17.6","start":9017006,"end":9017006,"break":"none","ruby":[[2,1,"あし"],[5,2,"せいどう"],[10,1,"とう"],[12,1,"つ"],[15,1,"かた"],[18,2,"せいどう"],[21,1,"な"],[26,2,"せお"]],"text":"また足には青銅のすね当を着け、肩には青銅の投げやりを背負っていた。"},{"ref":"1Sam.17.7","start":9017007,"end":9017007,"break":"none","ruby":[[0,1,"て"],[2,1,"も"],[10,1,"え"],[13,1,"はた"],[15,2,"まきぼう"],[27,1,"ほ"],[29,1,"てつ"],[41,1,"かれ"],[43,1,"まえ"],[47,1,"たて"],[49,1,"と"],[51,1,"もの"],[53,1,"すす"]],"text":"手に持っているやりの柄は、機の巻棒のようであり、やりの穂の鉄は六百シケルであった。彼の前には、盾を執る者が進んだ。"},{"ref":"1Sam.17.8","start":9017008,"end":9017008,"break":"none","ruby":[[5,1,"た"],[14,2,"せんれつ"],[17,1,"む"],[21,1,"さけ"],[30,2,"せんれつ"],[37,1,"で"],[65,2,"けらい"],[85,1,"えら"],[97,1,"くだ"]],"text":"ゴリアテは立ってイスラエルの戦列に向かって叫んだ、「なにゆえ戦列をつくって出てきたのか。わたしはペリシテびと、おまえたちはサウルの家来ではないか。おまえたちから、ひとりを選んで、わたしのところへ下ってこさせよ。"},{"ref":"1Sam.17.9","start":9017009,"end":9017009,"break":"none","ruby":[[4,1,"ひと"],[6,1,"たたか"],[13,1,"ころ"],[34,2,"けらい"],[47,1,"か"],[52,1,"ひと"],[54,1,"ころ"],[71,2,"けらい"],[77,1,"つか"]],"text":"もしその人が戦ってわたしを殺すことができたら、われわれはおまえたちの家来となる。しかしわたしが勝ってその人を殺したら、おまえたちは、われわれの家来になって仕えなければならない」。"},{"ref":"1Sam.17.10","start":9017010,"end":9017010,"break":"none","ruby":[[11,1,"い"],[30,2,"せんれつ"],[41,1,"だ"],[49,1,"たたか"]],"text":"またこのペリシテびとは言った、「わたしは、きょうイスラエルの戦列にいどむ。ひとりを出して、わたしと戦わせよ」。"},{"ref":"1Sam.17.11","start":9017011,"end":9017011,"break":"none","ruby":[[14,1,"ひと"],[26,2,"ことば"],[29,1,"き"],[32,1,"おどろ"],[40,1,"おそ"]],"text":"サウルとイスラエルのすべての人は、ペリシテびとのこの言葉を聞いて驚き、ひじょうに恐れた。"},{"ref":"1Sam.17.12","start":9017012,"end":9017012,"break":"paragraph","ruby":[[31,1,"な"],[33,1,"ひと"],[35,1,"こ"],[40,1,"ひと"],[42,1,"はち"],[43,1,"にん"],[45,1,"こ"],[56,1,"よ"],[59,1,"とし"],[61,1,"すす"],[68,2,"としお"]],"text":"さて、ダビデはユダのベツレヘムにいたエフラタびとエッサイという名の人の子で、この人に八人の子があったが、サウルの世には年が進んで、すでに年老いていた。"},{"ref":"1Sam.17.13","start":9017013,"end":9017013,"break":"none","ruby":[[5,1,"こ"],[11,1,"うえ"],[14,1,"にん"],[20,1,"したが"],[23,2,"せんそう"],[26,1,"で"],[31,1,"たたか"],[34,1,"で"],[37,1,"にん"],[39,1,"こ"],[41,1,"な"],[44,2,"ちょうし"],[55,1,"つぎ"],[66,1,"だい"],[74,1,"い"]],"text":"エッサイの子らのうち、上の三人はサウルに従って戦争に出た。その戦いに出た三人の子の名は、長子をエリアブといい、次をアビナダブといい、第三をシャンマと言った。"},{"ref":"1Sam.17.14","start":9017014,"end":9017014,"break":"none","ruby":[[4,1,"すえ"],[6,1,"こ"],[12,1,"あに"],[14,1,"にん"]],"text":"ダビデは末の子であって、兄三人はサウルにしたがった。"},{"ref":"1Sam.17.15","start":9017015,"end":9017015,"break":"none","ruby":[[8,1,"ところ"],[11,1,"い"],[27,1,"ちち"],[29,1,"ひつじ"],[31,1,"か"]],"text":"ダビデはサウルの所から行ったりきたりして、ベツレヘムで父の羊を飼っていた。"},{"ref":"1Sam.17.16","start":9017016,"end":9017016,"break":"none","ruby":[[11,1,"にち"],[13,1,"あいだ"],[15,2,"あさゆう"],[17,1,"で"],[22,1,"かれ"],[25,1,"まえ"],[27,1,"た"]],"text":"あのペリシテびとは四十日の間、朝夕出てきて、彼らの前に立った。"},{"ref":"1Sam.17.17","start":9017017,"end":9017017,"break":"paragraph","ruby":[[0,1,"とき"],[10,1,"こ"],[15,1,"い"],[20,1,"あに"],[31,1,"むぎ"],[40,1,"こ"],[49,1,"いそ"],[52,2,"じんえい"],[57,1,"あに"],[59,1,"ところ"],[61,1,"も"]],"text":"時に、エッサイはその子ダビデに言った、「兄たちのため、このいり麦一エパと、この十個のパンをとって、急いで陣営にいる兄の所へ持っていきなさい。"},{"ref":"1Sam.17.18","start":9017018,"end":9017018,"break":"none","ruby":[[6,2,"かんらく"],[9,1,"と"],[14,1,"にん"],[16,1,"ちょう"],[21,1,"い"],[24,1,"あに"],[28,2,"あんぴ"],[31,1,"み"]],"text":"またこの十の乾酪を取って、千人の長にもって行き、兄たちの安否を見とどけて、そのしるしをもらってきなさい」。"},{"ref":"1Sam.17.19","start":9017019,"end":9017019,"break":"paragraph","ruby":[[6,1,"かれ"],[21,1,"ひと"],[27,1,"たに"],[36,1,"たたか"]],"text":"さてサウルと彼らおよびイスラエルのすべての人は、エラの谷でペリシテびとと戦っていた。"},{"ref":"1Sam.17.20","start":9017020,"end":9017020,"break":"none","ruby":[[4,1,"あさ"],[8,1,"お"],[12,1,"ひつじ"],[14,2,"ばんにん"],[17,1,"たく"],[25,1,"めい"],[31,2,"しょくりょう"],[33,1,"ひん"],[35,1,"たずさ"],[38,1,"い"],[42,1,"かれ"],[44,2,"じんえい"],[47,1,"つ"],[50,1,"とき"],[52,2,"ぐんぜい"],[59,1,"こえ"],[64,2,"せんせん"],[67,1,"で"]],"text":"ダビデは朝はやく起きて、羊を番人に託し、エッサイが命じたように食料品を携えて行った。彼が陣営に着いた時、軍勢は、ときの声をあげて戦線に出ようとしていた。"},{"ref":"1Sam.17.21","start":9017021,"end":9017021,"break":"none","ruby":[[17,2,"せんれつ"],[20,1,"し"],[24,1,"ぐん"],[26,1,"ぐん"],[28,1,"む"],[30,1,"あ"]],"text":"そしてイスラエルとペリシテびととは戦列を敷いて、軍と軍と向き合った。"},{"ref":"1Sam.17.22","start":9017022,"end":9017022,"break":"none","ruby":[[4,2,"にもつ"],[12,2,"にもつ"],[15,1,"まも"],[17,1,"もの"],[23,2,"せんれつ"],[26,1,"ほう"],[28,1,"はし"],[32,1,"あに"],[36,1,"ところ"],[38,1,"い"],[41,1,"かれ"],[44,2,"あんぴ"],[47,1,"たず"]],"text":"ダビデは荷物をおろして、荷物を守る者にあずけ、戦列の方へ走って、兄たちの所へ行き、彼らの安否を尋ねた。"},{"ref":"1Sam.17.23","start":9017023,"end":9017023,"break":"none","ruby":[[0,1,"あに"],[4,1,"かた"],[9,1,"とき"],[18,2,"せんれつ"],[34,1,"な"],[46,1,"たたか"],[52,1,"もの"],[54,1,"のぼ"],[60,1,"まえ"],[62,1,"おな"],[64,2,"ことば"],[67,1,"い"],[80,1,"き"]],"text":"兄たちと語っている時、ペリシテびとの戦列から、ガテのペリシテびとで、名をゴリアテという、あの戦いをいどむ者が上ってきて、前と同じ言葉を言ったので、ダビデはそれを聞いた。"},{"ref":"1Sam.17.24","start":9017024,"end":9017024,"break":"paragraph","ruby":[[10,1,"ひと"],[15,1,"ひと"],[17,1,"み"],[20,1,"さ"],[23,1,"に"],[31,1,"おそ"]],"text":"イスラエルのすべての人は、その人を見て、避けて逃げ、ひじょうに恐れた。"},{"ref":"1Sam.17.25","start":9017025,"end":9017025,"break":"none","ruby":[[6,2,"ひとびと"],[11,1,"い"],[25,1,"のぼ"],[30,1,"ひと"],[32,1,"み"],[36,1,"たし"],[51,1,"のぼ"],[59,1,"かれ"],[61,1,"ころ"],[63,1,"ひと"],[66,1,"おう"],[68,1,"おお"],[72,1,"とみ"],[74,1,"あた"],[77,1,"と"],[83,1,"むすめ"],[85,1,"あた"],[90,1,"ちち"],[92,1,"いえ"],[104,1,"ぜい"],[106,1,"まぬか"]],"text":"イスラエルの人々はまた言った、「あなたがたは、あの上ってきた人を見たか。確かにイスラエルにいどむために上ってきたのだ。彼を殺す人は、王が大いなる富を与えて富ませ、その娘を与え、その父の家にはイスラエルのうちで税を免れさせるであろう」。"},{"ref":"1Sam.17.26","start":9017026,"end":9017026,"break":"none","ruby":[[9,1,"た"],[14,2,"ひとびと"],[17,1,"い"],[31,1,"ころ"],[40,1,"はじ"],[45,1,"ひと"],[61,2,"かつれい"],[72,2,"なにもの"],[78,1,"い"],[81,1,"かみ"],[83,1,"ぐん"]],"text":"ダビデはかたわらに立っている人々に言った、「このペリシテびとを殺し、イスラエルの恥をすすぐ人には、どうされるのですか。この割礼なきペリシテびとは何者なので、生ける神の軍をいどむのか」。"},{"ref":"1Sam.17.27","start":9017027,"end":9017027,"break":"none","ruby":[[0,1,"たみ"],[2,1,"まえ"],[4,1,"おな"],[11,1,"かれ"],[13,1,"ころ"],[15,1,"ひと"],[29,1,"こた"]],"text":"民は前と同じように、「彼を殺す人にはこうされるであろう」と答えた。"},{"ref":"1Sam.17.28","start":9017028,"end":9017028,"break":"paragraph","ruby":[[0,1,"うえ"],[2,1,"あに"],[12,2,"ひとびと"],[15,1,"かた"],[19,1,"き"],[27,1,"む"],[30,1,"いか"],[33,1,"はっ"],[36,1,"い"],[47,1,"くだ"],[55,1,"の"],[63,1,"ひつじ"],[68,1,"たく"],[83,1,"わる"],[85,1,"こころ"],[94,1,"たたか"],[97,1,"み"],[102,1,"くだ"]],"text":"上の兄エリアブはダビデが人々と語るのを聞いて、ダビデに向かい怒りを発して言った、「なんのために下ってきたのか。野にいるわずかの羊はだれに託したのか。あなたのわがままと悪い心はわかっている。戦いを見るために下ってきたのだ」。"},{"ref":"1Sam.17.29","start":9017029,"end":9017029,"break":"none","ruby":[[4,1,"い"],[13,1,"いま"],[15,1,"なに"],[31,1,"こと"]],"text":"ダビデは言った、「わたしが今、何をしたというのですか。ただひと言いっただけではありませんか」。"},{"ref":"1Sam.17.30","start":9017030,"end":9017030,"break":"none","ruby":[[4,1,"む"],[11,1,"ひと"],[13,1,"まえ"],[18,1,"かた"],[25,1,"たみ"],[29,1,"おな"],[34,1,"こた"]],"text":"またふり向いて、ほかの人に前のように語ったところ、民はまた同じように答えた。"},{"ref":"1Sam.17.31","start":9017031,"end":9017031,"break":"paragraph","ruby":[[0,2,"ひとびと"],[7,1,"かた"],[10,2,"ことば"],[13,1,"き"],[24,1,"つ"],[34,1,"かれ"],[36,1,"よ"],[38,1,"よ"]],"text":"人々はダビデの語った言葉を聞いて、それをサウルに告げたので、サウルは彼を呼び寄せた。"},{"ref":"1Sam.17.32","start":9017032,"end":9017032,"break":"none","ruby":[[8,1,"い"],[16,1,"かれ"],[21,1,"き"],[23,1,"おと"],[37,1,"い"],[49,1,"たたか"]],"text":"ダビデはサウルに言った、「だれも彼のゆえに気を落してはなりません。しもべが行ってあのペリシテびとと戦いましょう」。"},{"ref":"1Sam.17.33","start":9017033,"end":9017033,"break":"none","ruby":[[8,1,"い"],[13,1,"い"],[26,1,"たたか"],[40,2,"ねんしょう"],[45,1,"かれ"],[47,1,"わか"],[49,1,"とき"],[53,2,"ぐんじん"]],"text":"サウルはダビデに言った、「行って、あのペリシテびとと戦うことはできない。あなたは年少だが、彼は若い時からの軍人だからです」。"},{"ref":"1Sam.17.34","start":9017034,"end":9017034,"break":"none","ruby":[[11,1,"い"],[20,1,"ちち"],[22,1,"ひつじ"],[24,1,"か"],[47,1,"む"],[50,2,"こひつじ"],[53,1,"と"],[56,1,"とき"]],"text":"しかしダビデはサウルに言った、「しもべは父の羊を飼っていたのですが、しし、あるいはくまがきて、群れの小羊を取った時、"},{"ref":"1Sam.17.35","start":9017035,"end":9017035,"break":"none","ruby":[[9,1,"お"],[16,1,"う"],[19,2,"こひつじ"],[24,1,"くち"],[27,1,"すく"],[37,1,"けもの"],[51,1,"とき"],[66,1,"う"],[68,1,"ころ"]],"text":"わたしはそのあとを追って、これを撃ち、小羊をその口から救いだしました。その獣がわたしにとびかかってきた時は、ひげをつかまえて、それを撃ち殺しました。"},{"ref":"1Sam.17.36","start":9017036,"end":9017036,"break":"none","ruby":[[15,1,"ころ"],[23,2,"かつれい"],[35,1,"い"],[38,1,"かみ"],[40,1,"ぐん"],[54,1,"けもの"],[57,1,"とう"]],"text":"しもべはすでに、ししと、くまを殺しました。この割礼なきペリシテびとも、生ける神の軍をいどんだのですから、あの獣の一頭のようになるでしょう」。"},{"ref":"1Sam.17.37","start":9017037,"end":9017037,"break":"none","ruby":[[6,1,"い"],[28,1,"すく"],[30,1,"だ"],[34,1,"しゅ"],[53,1,"て"],[56,1,"すく"],[58,1,"だ"],[76,1,"い"],[81,1,"い"],[90,1,"しゅ"],[96,1,"とも"]],"text":"ダビデはまた言った、「ししのつめ、くまのつめからわたしを救い出された主は、またわたしを、このペリシテびとの手から救い出されるでしょう」。サウルはダビデに言った、「行きなさい。どうぞ主があなたと共におられるように」。"},{"ref":"1Sam.17.38","start":9017038,"end":9017038,"break":"none","ruby":[[7,2,"じぶん"],[13,1,"ころも"],[19,1,"き"],[22,2,"せいどう"],[32,1,"あたま"],[52,1,"み"]],"text":"そしてサウルは自分のいくさ衣をダビデに着せ、青銅のかぶとを、その頭にかぶらせ、また、うろことじのよろいを身にまとわせた。"},{"ref":"1Sam.17.39","start":9017039,"end":9017039,"break":"none","ruby":[[8,1,"ころも"],[10,1,"うえ"],[17,1,"お"],[20,1,"い"],[38,1,"な"],[63,1,"い"],[79,1,"つ"],[93,1,"な"]],"text":"ダビデは、いくさ衣の上に、つるぎを帯びて行こうとしたが、できなかった。それに慣れていなかったからである。そこでダビデはサウルに言った、「わたしはこれらのものを着けていくことはできません。慣れていないからです」。"},{"ref":"1Sam.17.40","start":9017040,"end":9017040,"break":"none","ruby":[[8,1,"ぬ"],[13,1,"て"],[21,2,"たにま"],[30,1,"いし"],[32,1,"こ"],[34,1,"えら"],[39,2,"じぶん"],[42,1,"も"],[47,2,"ひつじかい"],[50,1,"ふくろ"],[52,1,"い"],[55,1,"て"],[57,1,"いし"],[58,1,"な"],[61,1,"と"],[74,1,"ちか"]],"text":"ダビデはそれらを脱ぎすて、手につえをとり、谷間からなめらかな石五個を選びとって自分の持っている羊飼の袋に入れ、手に石投げを執って、あのペリシテびとに近づいた。"},{"ref":"1Sam.17.41","start":9017041,"end":9017041,"break":"paragraph","ruby":[[9,1,"すす"],[18,1,"ちか"],[28,1,"と"],[30,1,"もの"],[32,1,"かれ"],[34,1,"まえ"]],"text":"そのペリシテびとは進んできてダビデに近づいた。そのたてを執る者が彼の前にいた。"},{"ref":"1Sam.17.42","start":9017042,"end":9017042,"break":"none","ruby":[[7,1,"み"],[16,1,"み"],[21,1,"あなど"],[27,1,"わか"],[30,2,"けっしょく"],[36,1,"すがた"],[38,1,"うつく"]],"text":"ペリシテびとは見まわしてダビデを見、これを侮った。まだ若くて血色がよく、姿が美しかったからである。"},{"ref":"1Sam.17.43","start":9017043,"end":9017043,"break":"none","ruby":[[11,1,"い"],[19,1,"も"],[23,1,"む"],[35,1,"いぬ"],[51,2,"かみがみ"],[54,1,"な"]],"text":"ペリシテびとはダビデに言った、「つえを持って、向かってくるが、わたしは犬なのか」。ペリシテびとは、また神々の名によってダビデをのろった。"},{"ref":"1Sam.17.44","start":9017044,"end":9017044,"break":"none","ruby":[[11,1,"い"],[19,1,"む"],[30,1,"にく"],[33,1,"そら"],[35,1,"とり"],[37,1,"の"],[39,1,"けもの"]],"text":"ペリシテびとはダビデに言った、「さあ、向かってこい。おまえの肉を、空の鳥、野の獣のえじきにしてくれよう」。"},{"ref":"1Sam.17.45","start":9017045,"end":9017045,"break":"none","ruby":[[11,1,"い"],[29,1,"な"],[34,1,"も"],[42,1,"む"],[54,2,"ばんぐん"],[57,1,"しゅ"],[59,1,"な"],[81,1,"ぐん"],[83,1,"かみ"],[85,1,"な"],[95,1,"た"],[97,1,"む"]],"text":"ダビデはペリシテびとに言った、「おまえはつるぎと、やりと、投げやりを持って、わたしに向かってくるが、わたしは万軍の主の名、すなわち、おまえがいどんだ、イスラエルの軍の神の名によって、おまえに立ち向かう。"},{"ref":"1Sam.17.46","start":9017046,"end":9017046,"break":"none","ruby":[[4,1,"しゅ"],[15,1,"て"],[36,1,"う"],[40,1,"くび"],[52,2,"ぐんぜい"],[55,1,"し"],[65,1,"そら"],[67,1,"とり"],[69,1,"ち"],[71,2,"やじゅう"],[87,1,"かみ"],[96,1,"ぜん"],[97,1,"ち"],[99,1,"し"]],"text":"きょう、主は、おまえをわたしの手にわたされるであろう。わたしは、おまえを撃って、首をはね、ペリシテびとの軍勢の死かばねを、きょう、空の鳥、地の野獣のえじきにし、イスラエルに、神がおられることを全地に知らせよう。"},{"ref":"1Sam.17.47","start":9017047,"end":9017047,"break":"none","ruby":[[4,1,"ぜん"],[5,2,"かいしゅう"],[9,1,"しゅ"],[11,1,"すくい"],[13,1,"ほどこ"],[25,1,"もち"],[34,1,"し"],[43,1,"たたか"],[46,1,"しゅ"],[48,1,"たたか"],[55,1,"しゅ"],[62,1,"て"],[70,1,"わた"]],"text":"またこの全会衆も、主は救を施すのに、つるぎとやりを用いられないことを知るであろう。この戦いは主の戦いであって、主がわれわれの手におまえたちを渡されるからである」。"},{"ref":"1Sam.17.48","start":9017048,"end":9017048,"break":"paragraph","ruby":[[9,1,"た"],[11,1,"あ"],[15,1,"ちか"],[25,1,"た"],[27,1,"む"],[38,1,"いそ"],[40,2,"せんせん"],[43,1,"はし"],[45,1,"で"],[55,1,"た"],[57,1,"む"]],"text":"そのペリシテびとが立ち上がり、近づいてきてダビデに立ち向かったので、ダビデは急ぎ戦線に走り出て、ペリシテびとに立ち向かった。"},{"ref":"1Sam.17.49","start":9017049,"end":9017049,"break":"none","ruby":[[4,1,"て"],[6,1,"ふくろ"],[8,1,"い"],[14,1,"なか"],[20,1,"いし"],[22,1,"と"],[25,1,"いし"],[26,1,"な"],[29,1,"な"],[40,1,"ひたい"],[42,1,"う"],[48,1,"いし"],[52,1,"ひたい"],[54,1,"つ"],[56,1,"はい"],[64,1,"ち"],[66,1,"たお"]],"text":"ダビデは手を袋に入れて、その中から一つの石を取り、石投げで投げて、ペリシテびとの額を撃ったので、石はその額に突き入り、うつむきに地に倒れた。"},{"ref":"1Sam.17.50","start":9017050,"end":9017050,"break":"paragraph","ruby":[[8,1,"いし"],[9,1,"な"],[12,1,"いし"],[24,1,"か"],[34,1,"う"],[41,1,"ころ"],[49,1,"て"]],"text":"こうしてダビデは石投げと石をもってペリシテびとに勝ち、ペリシテびとを撃って、これを殺した。ダビデの手につるぎがなかったので、"},{"ref":"1Sam.17.51","start":9017051,"end":9017051,"break":"none","ruby":[[4,1,"はし"],[16,1,"うえ"],[18,1,"の"],[27,1,"と"],[35,1,"ぬ"],[47,1,"かれ"],[49,1,"ころ"],[54,1,"くび"],[65,2,"ひとびと"],[71,2,"ゆうし"],[74,1,"し"],[79,1,"み"],[81,1,"に"]],"text":"ダビデは走りよってペリシテびとの上に乗り、そのつるぎを取って、さやから抜きはなし、それをもって彼を殺し、その首をはねた。ペリシテの人々は、その勇士が死んだのを見て逃げた。"},{"ref":"1Sam.17.52","start":9017052,"end":9017052,"break":"none","ruby":[[9,2,"ひとびと"],[12,1,"た"],[32,2,"ついげき"],[46,1,"もん"],[50,1,"およ"],[65,2,"ふしょう"],[67,1,"しゃ"],[87,1,"い"],[89,1,"みち"],[91,1,"うえ"],[93,1,"たお"]],"text":"イスラエルとユダの人々は立ちあがり、ときをあげて、ペリシテびとを追撃し、ガテおよびエクロンの門にまで及んだ。そのためペリシテびとの負傷者は、シャライムからガテおよびエクロンに行く道の上に倒れた。"},{"ref":"1Sam.17.53","start":9017053,"end":9017053,"break":"none","ruby":[[6,2,"ひとびと"],[16,2,"ついげき"],[19,1,"お"],[22,1,"かえ"],[27,2,"じんえい"],[30,2,"りゃくだつ"]],"text":"イスラエルの人々はペリシテびとの追撃を終えて帰り、その陣営を略奪した。"},{"ref":"1Sam.17.54","start":9017054,"end":9017054,"break":"none","ruby":[[14,1,"くび"],[16,1,"と"],[25,1,"も"],[28,1,"い"],[35,2,"ぶき"],[38,2,"じぶん"],[41,2,"てんまく"],[44,1,"お"]],"text":"ダビデは、あのペリシテびとの首を取ってエルサレムへ持って行ったが、その武器は自分の天幕に置いた。"},{"ref":"1Sam.17.55","start":9017055,"end":9017055,"break":"paragraph","ruby":[[17,1,"む"],[21,1,"で"],[27,1,"み"],[30,1,"ぐん"],[32,1,"ちょう"],[38,1,"い"],[51,2,"わかもの"],[57,1,"こ"],[66,1,"い"],[71,1,"おう"],[85,1,"ちか"],[94,1,"し"]],"text":"サウルはダビデがあのペリシテびとに向かって出ていくのを見て、軍の長アブネルに言った、「アブネルよ、この若者はだれの子か」。アブネルは言った、「王よ、あなたのいのちにかけて誓います。わたしは知らないのです」。"},{"ref":"1Sam.17.56","start":9017056,"end":9017056,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[9,2,"わかもの"],[15,1,"こ"],[18,1,"たず"]],"text":"王は言った、「この若者がだれの子か、尋ねてみよ」。"},{"ref":"1Sam.17.57","start":9017057,"end":9017057,"break":"none","ruby":[[14,1,"ころ"],[17,1,"かえ"],[22,1,"とき"],[37,1,"くび"],[39,1,"て"],[41,1,"も"],[46,1,"かれ"],[53,1,"まえ"],[55,1,"つ"],[58,1,"い"]],"text":"ダビデが、あのペリシテびとを殺して帰ってきた時、アブネルは、ペリシテびとの首を手に持っている彼を、サウルの前に連れて行った。"},{"ref":"1Sam.17.58","start":9017058,"end":9017058,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[11,2,"わかもの"],[22,1,"こ"],[30,1,"こた"],[55,1,"こ"]],"text":"サウルは彼に言った、「若者よ、あなたはだれの子か」。ダビデは答えた、「あなたのしもべ、ベツレヘムびとエッサイの子です」。"}]