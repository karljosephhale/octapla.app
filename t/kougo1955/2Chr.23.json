[{"ref":"2Chr.23.1","start":14023001,"end":14023001,"break":"paragraph","ruby":[[0,1,"だい"],[2,1,"ねん"],[13,2,"ゆうき"],[24,1,"こ"],[35,1,"こ"],[46,1,"こ"],[56,1,"こ"],[66,1,"こ"],[77,1,"にん"],[79,1,"ちょう"],[83,1,"まね"],[86,2,"けいやく"],[89,1,"むす"]],"text":"第七年になって、エホヤダは勇気をだしてエロハムの子アザリヤ、ヨハナンの子イシマエル、オベデの子アザリヤ、アダヤの子マアセヤ、ジクリの子エリシャパテなどの百人の長たちを招いて契約を結ばせた。"},{"ref":"2Chr.23.2","start":14023002,"end":14023002,"break":"none","ruby":[[3,1,"かれ"],[9,1,"い"],[23,1,"まち"],[31,1,"あつ"],[42,2,"しぞく"],[45,1,"ちょう"],[49,1,"あつ"],[59,1,"き"]],"text":"そこで彼らはユダを行きめぐって、ユダのすべての町からレビびとを集め、またイスラエルの氏族の長たちを集めて、エルサレムに来た。"},{"ref":"2Chr.23.3","start":14023003,"end":14023003,"break":"none","ruby":[[5,2,"かいしゅう"],[8,1,"みな"],[9,1,"かみ"],[11,1,"みや"],[13,1,"おう"],[15,2,"けいやく"],[18,1,"むす"],[24,1,"とき"],[30,1,"かれ"],[33,1,"い"],[38,1,"しゅ"],[44,2,"しそん"],[53,1,"い"],[61,1,"おう"],[63,1,"こ"],[65,1,"くらい"]],"text":"そしてその会衆は皆神の宮で王と契約を結んだ。その時エホヤダは彼らに言った、「主がダビデの子孫のことについて言われたように、王の子が位につくべきです。"},{"ref":"2Chr.23.4","start":14023004,"end":14023004,"break":"none","ruby":[[10,1,"こと"],[26,2,"さいし"],[36,3,"あんそくにち"],[44,1,"く"],[46,1,"もの"],[50,1,"ぶん"],[54,1,"もん"],[56,1,"まも"],[58,1,"もの"]],"text":"あなたがたのなすべき事はこれです。すなわちあなたがた祭司およびレビびとの安息日にはいって来る者の、三分の一は門を守る者となり、"},{"ref":"2Chr.23.5","start":14023005,"end":14023005,"break":"none","ruby":[[1,1,"ぶん"],[5,1,"おう"],[7,1,"いえ"],[13,1,"ぶん"],[17,1,"いしずえ"],[19,1,"もん"],[24,1,"たみ"],[26,1,"みな"],[28,1,"しゅ"],[30,1,"みや"],[32,1,"にわ"]],"text":"三分の一は王の家におり、三分の一は礎の門におり、民は皆、主の宮の庭にいなさい。"},{"ref":"2Chr.23.6","start":14023006,"end":14023006,"break":"none","ruby":[[0,2,"さいし"],[4,1,"つと"],[21,1,"しゅ"],[23,1,"みや"],[36,1,"かれ"],[39,1,"せい"],[42,1,"もの"],[59,1,"たみ"],[61,1,"みな"],[63,1,"しゅ"],[65,2,"めいれい"],[68,1,"まも"]],"text":"祭司と、勤めをするレビびとのほかは、だれも主の宮に、はいってはならない。彼らは聖なる者であるから、はいることができる。民は皆、主の命令を守らなければならない。"},{"ref":"2Chr.23.7","start":14023007,"end":14023007,"break":"none","ruby":[[9,1,"て"],[11,2,"ぶき"],[17,1,"おう"],[23,1,"た"],[34,1,"みや"],[39,1,"もの"],[44,1,"ころ"],[56,1,"おう"],[61,1,"とき"],[64,1,"で"],[66,1,"とき"],[70,1,"おう"],[72,1,"とも"]],"text":"レビびとはめいめい手に武器をとって王のまわりに立たなければならない。宮にはいる者をすべて殺しなさい。あなたがたは王がはいる時にも出る時にも、王と共にいなさい」。"},{"ref":"2Chr.23.8","start":14023008,"end":14023008,"break":"paragraph","ruby":[[13,2,"ひとびと"],[17,2,"さいし"],[27,1,"めい"],[33,1,"おこな"],[42,1,"くみ"],[44,1,"もの"],[47,3,"あんそくにち"],[55,1,"く"],[59,1,"もの"],[62,3,"あんそくにち"],[66,1,"で"],[68,1,"い"],[72,1,"もの"],[74,1,"ひき"],[80,2,"さいし"],[87,1,"くみ"],[89,1,"もの"],[91,1,"さ"]],"text":"そこでレビびとおよびユダの人々は、祭司エホヤダがすべて命じたように行い、めいめいその組の者で、安息日にはいって来るべき者と、安息日に出て行くべき者を率いていた。祭司エホヤダが組の者を去らせなかったからである。"},{"ref":"2Chr.23.9","start":14023009,"end":14023009,"break":"none","ruby":[[2,2,"さいし"],[10,1,"かみ"],[12,1,"みや"],[19,1,"おう"],[26,2,"おおだて"],[29,2,"こだて"],[33,1,"にん"],[35,1,"ちょう"],[39,1,"わた"]],"text":"また祭司エホヤダは、神の宮にあるダビデ王のやりおよび大盾、小盾を百人の長たちに渡し、"},{"ref":"2Chr.23.10","start":14023010,"end":14023010,"break":"none","ruby":[[2,1,"おう"],[4,1,"まも"],[14,1,"たみ"],[20,1,"て"],[22,2,"ぶき"],[29,1,"みや"],[31,2,"みなみがわ"],[35,2,"きたがわ"],[43,2,"さいだん"],[46,1,"みや"],[48,1,"そ"],[51,1,"た"]],"text":"また王を守るために、すべての民にめいめい手に武器をとらせ、宮の南側から北側にわたって、祭壇と宮に沿って立たせた。"},{"ref":"2Chr.23.11","start":14023011,"end":14023011,"break":"none","ruby":[[4,1,"おう"],[6,1,"こ"],[8,1,"つ"],[10,1,"だ"],[17,1,"かんむり"],[29,1,"しょ"],[31,1,"わた"],[34,1,"おう"],[48,1,"こ"],[52,1,"かれ"],[54,1,"あぶら"],[56,1,"そそ"],[64,1,"おう"],[65,2,"ばんざい"],[69,1,"い"]],"text":"こうして王の子を連れ出して、これに冠をいただかせ、あかしの書を渡して王となし、エホヤダおよびその子たちが彼に油を注いだ。そして「王万歳」と言った。"},{"ref":"2Chr.23.12","start":14023012,"end":14023012,"break":"paragraph","ruby":[[5,1,"たみ"],[7,1,"はし"],[12,1,"おう"],[17,1,"こえ"],[19,1,"き"],[25,1,"しゅ"],[27,1,"みや"],[29,1,"い"],[32,1,"たみ"],[34,1,"ところ"],[36,1,"い"]],"text":"アタリヤは民の走りながら王をほめる声を聞いたので、主の宮に入り、民の所へ行って、"},{"ref":"2Chr.23.13","start":14023013,"end":14023013,"break":"none","ruby":[[0,1,"み"],[4,1,"おう"],[6,2,"いりぐち"],[9,1,"はしら"],[16,1,"た"],[19,1,"おう"],[27,2,"しょうぐん"],[35,1,"て"],[37,1,"た"],[45,1,"くに"],[47,1,"たみ"],[49,1,"みな"],[50,1,"よろこ"],[57,1,"ふ"],[60,1,"うた"],[65,1,"もの"],[67,2,"がっき"],[88,1,"ころも"],[90,1,"さ"],[94,2,"はんぎゃく"],[98,2,"はんぎゃく"],[103,1,"さけ"]],"text":"見ると、王は入口で柱のかたわらに立ち、王のかたわらには将軍たちとラッパ手が立っており、また国の民は皆喜んでラッパを吹き、歌をうたう者は楽器をもってさんびしていたので、アタリヤは衣を裂いて「反逆だ、反逆だ」と叫んだ。"},{"ref":"2Chr.23.14","start":14023014,"end":14023014,"break":"none","ruby":[[2,1,"とき"],[8,2,"ぐんぜい"],[11,2,"とうそつ"],[16,1,"にん"],[18,1,"ちょう"],[22,1,"よ"],[24,1,"だ"],[28,1,"れつ"],[30,1,"あいだ"],[33,2,"かのじょ"],[36,1,"つ"],[38,1,"だ"],[41,2,"かのじょ"],[44,1,"したが"],[46,1,"もの"],[52,1,"ころ"],[56,1,"い"],[60,2,"さいし"],[63,2,"かのじょ"],[66,1,"しゅ"],[68,1,"みや"],[70,1,"ころ"],[79,1,"い"]],"text":"その時エホヤダは軍勢を統率する百人の長たちを呼び出し、「列の間から彼女を連れ出せ、彼女に従う者をつるぎで殺せ」と言った。祭司が彼女を主の宮で殺してはならないと言ったからである。"},{"ref":"2Chr.23.15","start":14023015,"end":14023015,"break":"none","ruby":[[3,2,"ひとびと"],[6,2,"かのじょ"],[9,1,"て"],[14,1,"おう"],[16,1,"いえ"],[18,1,"うま"],[20,1,"もん"],[22,2,"いりぐち"],[26,1,"つ"],[29,1,"い"],[34,1,"ところ"],[36,2,"かのじょ"],[39,1,"ころ"]],"text":"そこで人々は彼女に手をかけ、王の家の馬の門の入口まで連れて行き、その所で彼女を殺した。"},{"ref":"2Chr.23.16","start":14023016,"end":14023016,"break":"paragraph","ruby":[[5,2,"じぶん"],[12,1,"たみ"],[14,1,"おう"],[17,1,"あいだ"],[20,1,"かれ"],[23,1,"みな"],[25,1,"しゅ"],[27,1,"たみ"],[33,2,"けいやく"],[36,1,"むす"]],"text":"エホヤダは自分とすべての民と王との間に、彼らは皆、主の民となるとの契約を結んだ。"},{"ref":"2Chr.23.17","start":14023017,"end":14023017,"break":"none","ruby":[[7,1,"たみ"],[13,1,"いえ"],[15,1,"い"],[28,2,"さいだん"],[33,1,"ぞう"],[36,1,"う"],[38,1,"くだ"],[45,2,"さいし"],[52,2,"さいだん"],[55,1,"まえ"],[57,1,"ころ"]],"text":"そこですべての民はバアルの家に行って、それをこわし、その祭壇とその像とを打ち砕き、バアルの祭司マッタンを祭壇の前で殺した。"},{"ref":"2Chr.23.18","start":14023018,"end":14023018,"break":"none","ruby":[[7,1,"しゅ"],[9,1,"みや"],[11,2,"しゅえい"],[15,2,"さいし"],[23,2,"しき"],[29,1,"お"],[40,1,"むかし"],[49,2,"りっぽう"],[63,1,"よろこ"],[66,1,"うた"],[72,1,"しゅ"],[74,2,"はんさい"],[85,1,"しゅ"],[87,1,"みや"],[89,2,"はいち"],[100,1,"いま"],[107,1,"れい"]],"text":"エホヤダはまた主の宮の守衛を、祭司とレビびとの指揮のもとに置いた。このレビびとは昔ダビデがモーセの律法にしるされているように、喜びと歌とをもって主に燔祭をささげるために、主の宮に配置したものであって、今そのダビデの例にならったものである。"},{"ref":"2Chr.23.19","start":14023019,"end":14023019,"break":"none","ruby":[[0,1,"かれ"],[4,1,"しゅ"],[6,1,"みや"],[13,1,"もん"],[15,2,"もんえい"],[18,1,"お"],[21,1,"けが"],[24,1,"もの"],[26,1,"なに"],[31,1,"けが"],[34,1,"もの"]],"text":"彼はまた主の宮のもろもろの門に門衛を置き、汚れた者は何によって汚れた者でも、はいらせないようにした。"},{"ref":"2Chr.23.20","start":14023020,"end":14023020,"break":"none","ruby":[[10,1,"にん"],[12,1,"ちょう"],[16,2,"きぞく"],[21,1,"たみ"],[31,1,"くに"],[37,1,"たみ"],[39,1,"ひき"],[43,1,"しゅ"],[45,1,"みや"],[48,1,"おう"],[50,1,"つ"],[52,1,"くだ"],[55,1,"うえ"],[57,1,"もん"],[60,1,"おう"],[62,1,"いえ"],[64,1,"すす"],[67,1,"おう"],[69,1,"くに"],[71,1,"くらい"]],"text":"こうしてエホヤダは百人の長たち、貴族たち、民のつかさたちおよび国のすべての民を率いて、主の宮から王を連れ下り、上の門から王の家に進み、王を国の位につかせた。"},{"ref":"2Chr.23.21","start":14023021,"end":14023021,"break":"none","ruby":[[0,1,"くに"],[2,1,"たみ"],[4,1,"みな"],[5,1,"よろこ"],[9,1,"まち"],[20,1,"ころ"],[24,1,"のち"],[26,1,"おだ"]],"text":"国の民は皆喜んだ。町はアタリヤがつるぎで殺された後、穏やかであった。"}]