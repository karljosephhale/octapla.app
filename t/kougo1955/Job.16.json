[{"ref":"Job.16.1","start":18016001,"end":18016001,"break":"paragraph","ruby":[[6,1,"こた"],[9,1,"い"]],"text":"そこでヨブは答えて言った、"},{"ref":"Job.16.2","start":18016002,"end":18016002,"break":"stanza","breaks":[[19,"line"],[36,"line"]],"ruby":[[10,1,"こと"],[12,2,"かずおお"],[15,1,"き"],[25,1,"みな"],[26,1,"ひと"],[28,1,"なぐさ"],[40,1,"ひと"],[42,1,"わずら"],[45,1,"もの"]],"text":"「わたしはこのような事を数多く聞いた。あなたがたは皆人を慰めようとして、かえって人を煩わす者だ。"},{"ref":"Job.16.3","start":18016003,"end":18016003,"break":"line","breaks":[[17,"line"]],"ruby":[[4,2,"ことば"],[21,1,"なに"],[23,1,"げき"],[26,1,"こたえ"]],"text":"むなしき言葉に、はてしがあろうか。あなたは何に激して答をするのか。"},{"ref":"Job.16.4","start":18016004,"end":18016004,"break":"line","breaks":[[22,"line"],[41,"line"],[61,"line"]],"ruby":[[13,1,"かた"],[34,1,"かわ"],[45,2,"ことば"],[48,1,"ね"],[58,1,"せ"],[67,1,"む"],[71,1,"あたま"],[73,1,"ふ"]],"text":"わたしもあなたがたのように語ることができる。もしあなたがたがわたしと代ったならば、わたしは言葉を練って、あなたがたを攻め、あなたがたに向かって頭を振ることができる。"},{"ref":"Job.16.5","start":18016005,"end":18016005,"break":"line","breaks":[[18,"line"]],"ruby":[[2,1,"くち"],[14,1,"つよ"],[23,1,"なぐさ"],[36,1,"くる"],[40,1,"やわ"]],"text":"また口をもって、あなたがたを強くし、くちびるの慰めをもって、あなたがたの苦しみを和らげることができる。"},{"ref":"Job.16.6","start":18016006,"end":18016006,"break":"stanza","breaks":[[12,"line"],[28,"line"],[40,"line"]],"ruby":[[7,1,"かた"],[16,1,"くる"],[20,1,"やわ"],[35,1,"しの"],[51,1,"さ"]],"text":"たといわたしは語っても、わたしの苦しみは和らげられない。たといわたしは忍んでも、どれほどそれがわたしを去るであろうか。"},{"ref":"Job.16.7","start":18016007,"end":18016007,"break":"line","breaks":[[17,"line"]],"ruby":[[4,1,"かみ"],[6,1,"いま"],[11,1,"つか"],[17,1,"かれ"],[32,1,"あら"]],"text":"まことに神は今わたしを疲れさせた。彼はわたしのやからをことごとく荒した。"},{"ref":"Job.16.8","start":18016008,"end":18016008,"break":"line","breaks":[[14,"line"],[30,"line"],[54,"line"]],"ruby":[[0,1,"かれ"],[9,1,"よ"],[21,1,"たい"],[24,2,"しょうこ"],[38,1,"おとろ"],[41,1,"すがた"],[43,1,"た"],[51,1,"せ"],[58,1,"かお"],[64,2,"しょうめい"]],"text":"彼はわたしを、しわ寄らせた。これがわたしに対する証拠である。またわたしのやせ衰えた姿が立って、わたしを攻め、わたしの顔にむかって証明する。"},{"ref":"Job.16.9","start":18016009,"end":18016009,"break":"line","breaks":[[21,"line"],[38,"line"]],"ruby":[[0,1,"かれ"],[2,1,"いか"],[11,1,"さ"],[18,1,"にく"],[25,1,"む"],[29,1,"は"],[33,1,"な"],[42,1,"てき"],[44,1,"め"],[46,1,"するど"],[55,1,"せ"]],"text":"彼は怒ってわたしをかき裂き、わたしを憎み、わたしに向かって歯をかみ鳴らした。わたしの敵は目を鋭くして、わたしを攻める。"},{"ref":"Job.16.10","start":18016010,"end":18016010,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[0,2,"ひとびと"],[7,1,"む"],[11,1,"くち"],[13,1,"は"],[16,1,"あなど"],[26,1,"う"],[32,1,"あつ"],[40,1,"せ"]],"text":"人々はわたしに向かって口を張り、侮ってわたしのほおを打ち、ともに集まってわたしを攻める。"},{"ref":"Job.16.11","start":18016011,"end":18016011,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"かみ"],[11,1,"もの"],[13,1,"わた"],[16,2,"あくにん"],[19,1,"て"],[21,1,"な"]],"text":"神はわたしをよこしまな者に渡し、悪人の手に投げいれられる。"},{"ref":"Job.16.12","start":18016012,"end":18016012,"break":"line","breaks":[[14,"line"],[25,"line"],[40,"line"]],"ruby":[[4,1,"やす"],[14,1,"かれ"],[20,1,"き"],[22,1,"さ"],[25,1,"くび"],[27,1,"とら"],[35,1,"う"],[37,1,"くだ"],[44,1,"た"],[47,1,"まと"]],"text":"わたしは安らかであったのに、彼はわたしを切り裂き、首を捕えて、わたしを打ち砕き、わたしを立てて的とされた。"},{"ref":"Job.16.13","start":18016013,"end":18016013,"break":"line","breaks":[[12,"line"],[29,"line"]],"ruby":[[2,2,"しゃしゅ"],[9,1,"かこ"],[12,1,"かれ"],[14,3,"むじひ"],[23,1,"こし"],[25,2,"いとお"],[33,1,"きも"],[35,1,"ち"],[37,1,"なが"],[39,1,"だ"]],"text":"その射手はわたしを囲む。彼は無慈悲にもわたしの腰を射通し、わたしの肝を地に流れ出させられる。"},{"ref":"Job.16.14","start":18016014,"end":18016014,"break":"line","breaks":[[21,"line"]],"ruby":[[0,1,"かれ"],[6,1,"う"],[8,1,"やぶ"],[12,1,"やぶ"],[15,1,"やぶ"],[18,1,"くわ"],[21,2,"ゆうし"]],"text":"彼はわたしを打ち破って、破れに破れを加え、勇士のようにわたしに、はせかかられる。"},{"ref":"Job.16.15","start":18016015,"end":18016015,"break":"line","breaks":[[14,"line"]],"ruby":[[4,2,"あらぬの"],[7,1,"はだ"],[9,1,"ぬ"],[18,1,"つの"],[23,1,"ふ"]],"text":"わたしは荒布を膚に縫いつけ、わたしの角をちりに伏せた。"},{"ref":"Job.16.16","start":18016016,"end":18016016,"break":"line","breaks":[[14,"line"]],"ruby":[[4,1,"かお"],[6,1,"な"],[9,1,"あか"],[23,1,"ふか"]],"text":"わたしの顔は泣いて赤くなり、わたしのまぶたには深いやみがある。"},{"ref":"Job.16.17","start":18016017,"end":18016017,"break":"line","breaks":[[17,"line"]],"ruby":[[8,1,"て"],[11,2,"ぼうぎゃく"],[21,1,"いのり"],[23,1,"きよ"]],"text":"しかし、わたしの手には暴虐がなく、わたしの祈は清い。"},{"ref":"Job.16.18","start":18016018,"end":18016018,"break":"stanza","breaks":[[18,"line"]],"ruby":[[0,1,"ち"],[7,1,"ち"],[22,1,"さけ"],[26,1,"やす"],[28,1,"ところ"],[30,1,"え"]],"text":"地よ、わたしの血をおおってくれるな。わたしの叫びに、休む所を得させるな。"},{"ref":"Job.16.19","start":18016019,"end":18016019,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"み"],[3,1,"いま"],[10,2,"しょうにん"],[13,1,"てん"],[25,2,"ほしょう"],[32,1,"もの"],[34,1,"たか"],[36,1,"ところ"]],"text":"見よ、今でもわたしの証人は天にある。わたしのために保証してくれる者は高い所にある。"},{"ref":"Job.16.20","start":18016020,"end":18016020,"break":"line","breaks":[[15,"line"]],"ruby":[[4,1,"とも"],[22,1,"め"],[24,1,"かみ"],[26,1,"む"],[30,1,"なみだ"],[32,1,"そそ"]],"text":"わたしの友はわたしをあざける、しかしわたしの目は神に向かって涙を注ぐ。"},{"ref":"Job.16.21","start":18016021,"end":18016021,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"かれ"],[5,1,"ひと"],[10,1,"かみ"],[12,2,"べんろん"],[16,1,"ひと"],[20,1,"とも"],[23,1,"あいだ"]],"text":"どうか彼が人のために神と弁論し、人とその友との間をさばいてくれるように。"},{"ref":"Job.16.22","start":18016022,"end":18016022,"break":"line","breaks":[[8,"line"]],"ruby":[[0,2,"すうねん"],[2,1,"す"],[4,1,"さ"],[12,1,"かえ"],[15,2,"たびじ"],[18,1,"い"]],"text":"数年過ぎ去れば、わたしは帰らぬ旅路に行くであろう。"}]