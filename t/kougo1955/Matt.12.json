[{"ref":"Matt.12.1","start":40012001,"end":40012001,"break":"paragraph","ruby":[[7,3,"あんそくにち"],[16,2,"むぎばたけ"],[19,1,"なか"],[21,1,"とお"],[29,2,"でし"],[35,2,"くうふく"],[44,1,"ほ"],[46,1,"つ"],[49,1,"た"]],"text":"そのころ、ある安息日に、イエスは麦畑の中を通られた。すると弟子たちは、空腹であったので、穂を摘んで食べはじめた。"},{"ref":"Matt.12.2","start":40012002,"end":40012002,"break":"none","ruby":[[4,1,"びと"],[11,1,"み"],[18,1,"い"],[34,2,"でし"],[40,3,"あんそくにち"]],"text":"パリサイ人たちがこれを見て、イエスに言った、「ごらんなさい、あなたの弟子たちが、安息日にしてはならないことをしています」。"},{"ref":"Matt.12.3","start":40012003,"end":40012003,"break":"none","ruby":[[7,1,"かれ"],[10,1,"い"],[29,1,"とも"],[31,1,"もの"],[36,1,"う"],[46,1,"なに"],[51,1,"よ"]],"text":"そこでイエスは彼らに言われた、「あなたがたは、ダビデとその供の者たちとが飢えたとき、ダビデが何をしたか読んだことがないのか。"},{"ref":"Matt.12.4","start":40012004,"end":40012004,"break":"none","ruby":[[5,1,"かみ"],[7,1,"いえ"],[14,2,"さいし"],[22,2,"じぶん"],[25,1,"とも"],[27,1,"もの"],[31,1,"た"],[38,1,"そな"],[44,1,"た"]],"text":"すなわち、神の家にはいって、祭司たちのほか、自分も供の者たちも食べてはならぬ供えのパンを食べたのである。"},{"ref":"Matt.12.5","start":40012005,"end":40012005,"break":"none","ruby":[[3,3,"あんそくにち"],[7,2,"みやづか"],[15,2,"さいし"],[20,3,"あんそくにち"],[24,1,"やぶ"],[28,1,"つみ"],[39,2,"りっぽう"],[42,1,"よ"]],"text":"また、安息日に宮仕えをしている祭司たちは安息日を破っても罪にはならないことを、律法で読んだことがないのか。"},{"ref":"Matt.12.6","start":40012006,"end":40012006,"break":"none","ruby":[[6,1,"い"],[12,1,"みや"],[16,1,"おお"],[20,1,"もの"]],"text":"あなたがたに言っておく。宮よりも大いなる者がここにいる。"},{"ref":"Matt.12.7","start":40012007,"end":40012007,"break":"none","ruby":[[5,1,"この"],[34,2,"いみ"],[37,1,"し"],[51,1,"つみ"],[55,1,"もの"]],"text":"『わたしが好むのは、あわれみであって、いけにえではない』とはどういう意味か知っていたなら、あなたがたは罪のない者をとがめなかったであろう。"},{"ref":"Matt.12.8","start":40012008,"end":40012008,"break":"none","ruby":[[0,1,"ひと"],[2,1,"こ"],[4,3,"あんそくにち"],[8,1,"しゅ"]],"text":"人の子は安息日の主である」。"},{"ref":"Matt.12.9","start":40012009,"end":40012009,"break":"paragraph","ruby":[[7,1,"さ"],[11,1,"かれ"],[14,2,"かいどう"]],"text":"イエスはそこを去って、彼らの会堂にはいられた。"},{"ref":"Matt.12.10","start":40012010,"end":40012010,"break":"none","ruby":[[9,2,"かたて"],[15,1,"ひと"],[20,2,"ひとびと"],[27,1,"うった"],[32,1,"おも"],[37,3,"あんそくにち"],[41,1,"ひと"],[59,1,"たず"]],"text":"すると、そのとき、片手のなえた人がいた。人々はイエスを訴えようと思って、「安息日に人をいやしても、さしつかえないか」と尋ねた。"},{"ref":"Matt.12.11","start":40012011,"end":40012011,"break":"none","ruby":[[4,1,"かれ"],[7,1,"い"],[24,1,"ぴき"],[26,1,"ひつじ"],[28,1,"も"],[33,1,"ひと"],[46,3,"あんそくにち"],[50,1,"あな"],[52,1,"お"],[60,1,"て"],[65,1,"ひ"],[67,1,"あ"]],"text":"イエスは彼らに言われた、「あなたがたのうちに、一匹の羊を持っている人があるとして、もしそれが安息日に穴に落ちこんだなら、手をかけて引き上げてやらないだろうか。"},{"ref":"Matt.12.12","start":40012012,"end":40012012,"break":"none","ruby":[[0,1,"ひと"],[2,1,"ひつじ"],[27,3,"あんそくにち"],[31,1,"よ"],[41,1,"ただ"]],"text":"人は羊よりも、はるかにすぐれているではないか。だから、安息日に良いことをするのは、正しいことである」。"},{"ref":"Matt.12.13","start":40012013,"end":40012013,"break":"none","ruby":[[9,1,"ひと"],[13,1,"て"],[15,1,"の"],[23,1,"い"],[31,1,"て"],[33,1,"の"],[41,1,"て"],[46,1,"よ"]],"text":"そしてイエスはその人に、「手を伸ばしなさい」と言われた。そこで手を伸ばすと、ほかの手のように良くなった。"},{"ref":"Matt.12.14","start":40012014,"end":40012014,"break":"none","ruby":[[4,1,"びと"],[8,1,"で"],[10,1,"い"],[24,1,"ころ"],[28,2,"そうだん"]],"text":"パリサイ人たちは出て行って、なんとかしてイエスを殺そうと相談した。"},{"ref":"Matt.12.15","start":40012015,"end":40012015,"break":"none","ruby":[[7,1,"し"],[14,1,"さ"],[17,1,"い"],[26,1,"おお"],[29,2,"ひとびと"],[40,1,"かれ"],[43,1,"みな"]],"text":"イエスはこれを知って、そこを去って行かれた。ところが多くの人々がついてきたので、彼らを皆いやし、"},{"ref":"Matt.12.16","start":40012016,"end":40012016,"break":"none","ruby":[[3,2,"じぶん"],[9,2,"ひとびと"],[23,1,"かれ"],[26,1,"いまし"]],"text":"そして自分のことを人々にあらわさないようにと、彼らを戒められた。"},{"ref":"Matt.12.17","start":40012017,"end":40012017,"break":"none","ruby":[[3,3,"よげんしゃ"],[10,1,"い"],[13,2,"ことば"],[17,2,"じょうじゅ"]],"text":"これは預言者イザヤの言った言葉が、成就するためである、"},{"ref":"Matt.12.18","start":40012018,"end":40012018,"break":"stanza","breaks":[[13,"line"],[28,"line"],[43,"line"]],"ruby":[[1,1,"み"],[8,1,"えら"],[11,1,"しもべ"],[17,1,"こころ"],[23,1,"あい"],[26,1,"もの"],[32,1,"かれ"],[38,1,"れい"],[40,1,"さづ"],[46,1,"かれ"],[48,2,"せいぎ"],[51,3,"いほうじん"],[55,1,"の"],[57,1,"つた"]],"text":"「見よ、わたしが選んだ僕、わたしの心にかなう、愛する者。わたしは彼にわたしの霊を授け、そして彼は正義を異邦人に宣べ伝えるであろう。"},{"ref":"Matt.12.19","start":40012019,"end":40012019,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"かれ"],[2,1,"あらそ"],[6,1,"さけ"],[14,1,"こえ"],[16,2,"おおじ"],[19,1,"き"],[21,1,"もの"]],"text":"彼は争わず、叫ばず、またその声を大路で聞く者はない。"},{"ref":"Matt.12.20","start":40012020,"end":40012020,"break":"line","breaks":[[16,"line"],[32,"line"]],"ruby":[[0,1,"かれ"],[2,2,"せいぎ"],[5,1,"か"],[8,1,"え"],[12,1,"とき"],[22,1,"あし"],[24,1,"お"],[32,1,"けむ"],[37,2,"とうしん"],[40,1,"け"]],"text":"彼が正義に勝ちを得させる時まで、いためられた葦を折ることがなく、煙っている燈心を消すこともない。"},{"ref":"Matt.12.21","start":40012021,"end":40012021,"break":"line","ruby":[[0,3,"いほうじん"],[4,1,"かれ"],[6,1,"な"],[8,1,"のぞ"],[11,1,"お"]],"text":"異邦人は彼の名に望みを置くであろう」。"},{"ref":"Matt.12.22","start":40012022,"end":40012022,"break":"paragraph","ruby":[[5,2,"ひとびと"],[8,2,"あくれい"],[15,2,"もうじん"],[21,1,"つ"],[33,1,"かれ"],[40,1,"もの"],[42,1,"い"],[47,1,"め"],[49,1,"み"]],"text":"そのとき、人々が悪霊につかれた盲人のおしを連れてきたので、イエスは彼をいやして、物を言い、また目が見えるようにされた。"},{"ref":"Matt.12.23","start":40012023,"end":40012023,"break":"none","ruby":[[3,2,"ぐんしゅう"],[8,1,"おどろ"],[11,1,"い"],[18,1,"ひと"],[29,1,"こ"]],"text":"すると群衆はみな驚いて言った、「この人が、あるいはダビデの子ではあるまいか」。"},{"ref":"Matt.12.24","start":40012024,"end":40012024,"break":"none","ruby":[[8,1,"びと"],[16,1,"き"],[19,1,"い"],[26,1,"ひと"],[28,2,"あくれい"],[31,1,"お"],[33,1,"だ"],[45,2,"あくれい"]],"text":"しかし、パリサイ人たちは、これを聞いて言った、「この人が悪霊を追い出しているのは、まったく悪霊のかしらベルゼブルによるのだ」。"},{"ref":"Matt.12.25","start":40012025,"end":40012025,"break":"none","ruby":[[4,1,"かれ"],[7,1,"おも"],[10,2,"みぬ"],[14,1,"い"],[25,2,"ないぶ"],[28,1,"わか"],[30,1,"あらそ"],[32,1,"くに"],[34,2,"じめつ"],[38,1,"うち"],[41,1,"わか"],[43,1,"あらそ"],[45,1,"まち"],[47,1,"いえ"],[49,1,"た"],[51,1,"い"]],"text":"イエスは彼らの思いを見抜いて言われた、「おおよそ、内部で分れ争う国は自滅し、内わで分れ争う町や家は立ち行かない。"},{"ref":"Matt.12.26","start":40012026,"end":40012026,"break":"none","ruby":[[10,1,"お"],[12,1,"だ"],[21,1,"うち"],[24,1,"わか"],[26,1,"あらそ"],[41,1,"くに"],[47,1,"た"],[49,1,"い"]],"text":"もしサタンがサタンを追い出すならば、それは内わで分れ争うことになる。それでは、その国はどうして立ち行けよう。"},{"ref":"Matt.12.27","start":40012027,"end":40012027,"break":"none","ruby":[[15,2,"あくれい"],[18,1,"お"],[20,1,"だ"],[33,2,"なかま"],[42,1,"お"],[44,1,"だ"],[57,1,"かれ"],[69,1,"もの"]],"text":"もしわたしがベルゼブルによって悪霊を追い出すとすれば、あなたがたの仲間はだれによって追い出すのであろうか。だから、彼らがあなたがたをさばく者となるであろう。"},{"ref":"Matt.12.28","start":40012028,"end":40012028,"break":"none","ruby":[[8,1,"かみ"],[10,1,"れい"],[15,2,"あくれい"],[18,1,"お"],[20,1,"だ"],[29,1,"かみ"],[31,1,"くに"]],"text":"しかし、わたしが神の霊によって悪霊を追い出しているのなら、神の国はすでにあなたがたのところにきたのである。"},{"ref":"Matt.12.29","start":40012029,"end":40012029,"break":"none","ruby":[[9,1,"つよ"],[11,1,"ひと"],[13,1,"しば"],[29,1,"ひと"],[31,1,"いえ"],[33,1,"お"],[35,1,"い"],[38,2,"かざい"],[41,1,"うば"],[43,1,"と"],[54,1,"しば"],[66,1,"いえ"],[68,2,"りゃくだつ"]],"text":"まただれでも、まず強い人を縛りあげなければ、どうして、その人の家に押し入って家財を奪い取ることができようか。縛ってから、はじめてその家を掠奪することができる。"},{"ref":"Matt.12.30","start":40012030,"end":40012030,"break":"none","ruby":[[4,2,"みかた"],[9,1,"もの"],[16,2,"はんたい"],[30,1,"とも"],[32,1,"あつ"],[36,1,"もの"],[39,1,"ち"]],"text":"わたしの味方でない者は、わたしに反対するものであり、わたしと共に集めない者は、散らすものである。"},{"ref":"Matt.12.31","start":40012031,"end":40012031,"break":"none","ruby":[[10,1,"い"],[16,1,"ひと"],[22,1,"おか"],[28,1,"つみ"],[30,1,"かみ"],[32,1,"けが"],[34,2,"ことば"],[48,2,"せいれい"],[51,1,"けが"],[53,2,"ことば"]],"text":"だから、あなたがたに言っておく。人には、その犯すすべての罪も神を汚す言葉も、ゆるされる。しかし、聖霊を汚す言葉は、ゆるされることはない。"},{"ref":"Matt.12.32","start":40012032,"end":40012032,"break":"none","ruby":[[2,1,"ひと"],[4,1,"こ"],[6,1,"たい"],[9,1,"い"],[11,1,"さか"],[14,1,"もの"],[31,2,"せいれい"],[34,1,"たい"],[37,1,"い"],[39,1,"さか"],[42,1,"もの"],[47,1,"よ"],[56,1,"よ"]],"text":"また人の子に対して言い逆らう者は、ゆるされるであろう。しかし、聖霊に対して言い逆らう者は、この世でも、きたるべき世でも、ゆるされることはない。"},{"ref":"Matt.12.33","start":40012033,"end":40012033,"break":"none","ruby":[[0,1,"き"],[2,1,"よ"],[9,1,"み"],[11,1,"よ"],[16,1,"き"],[18,1,"わる"],[25,1,"み"],[27,1,"わる"],[33,1,"き"],[37,1,"み"]],"text":"木が良ければ、その実も良いとし、木が悪ければ、その実も悪いとせよ。木はその実でわかるからである。"},{"ref":"Matt.12.34","start":40012034,"end":40012034,"break":"none","ruby":[[4,1,"こ"],[14,1,"わる"],[16,1,"もの"],[27,1,"よ"],[32,1,"かた"],[48,1,"こころ"],[59,1,"くち"],[61,1,"かた"]],"text":"まむしの子らよ。あなたがたは悪い者であるのに、どうして良いことを語ることができようか。おおよそ、心からあふれることを、口が語るものである。"},{"ref":"Matt.12.35","start":40012035,"end":40012035,"break":"none","ruby":[[0,2,"ぜんにん"],[5,1,"くら"],[8,1,"よ"],[10,1,"もの"],[12,1,"と"],[14,1,"だ"],[17,2,"あくにん"],[20,1,"わる"],[22,1,"くら"],[25,1,"わる"],[27,1,"もの"],[29,1,"と"],[31,1,"だ"]],"text":"善人はよい倉から良い物を取り出し、悪人は悪い倉から悪い物を取り出す。"},{"ref":"Matt.12.36","start":40012036,"end":40012036,"break":"none","ruby":[[6,1,"い"],[10,2,"しんぱん"],[13,1,"ひ"],[17,1,"ひと"],[21,1,"かた"],[23,2,"むえき"],[26,2,"ことば"],[29,1,"たい"],[33,1,"い"],[35,1,"ひら"]],"text":"あなたがたに言うが、審判の日には、人はその語る無益な言葉に対して、言い開きをしなければならないであろう。"},{"ref":"Matt.12.37","start":40012037,"end":40012037,"break":"none","ruby":[[5,2,"じぶん"],[8,2,"ことば"],[14,1,"ただ"],[23,2,"じぶん"],[26,2,"ことば"],[32,1,"つみ"]],"text":"あなたは、自分の言葉によって正しいとされ、また自分の言葉によって罪ありとされるからである」。"},{"ref":"Matt.12.38","start":40012038,"end":40012038,"break":"paragraph","ruby":[[5,2,"りっぽう"],[7,2,"がくしゃ"],[14,1,"びと"],[21,2,"ひとびと"],[32,1,"い"],[37,2,"せんせい"],[56,1,"み"]],"text":"そのとき、律法学者、パリサイ人のうちのある人々がイエスにむかって言った、「先生、わたしたちはあなたから、しるしを見せていただきとうございます」。"},{"ref":"Matt.12.39","start":40012039,"end":40012039,"break":"none","ruby":[[4,1,"かれ"],[7,1,"こた"],[10,1,"い"],[16,2,"じゃあく"],[19,2,"ふぎ"],[22,2,"じだい"],[30,1,"もと"],[38,3,"よげんしゃ"],[60,1,"あた"]],"text":"すると、彼らに答えて言われた、「邪悪で不義な時代は、しるしを求める。しかし、預言者ヨナのしるしのほかには、なんのしるしも与えられないであろう。"},{"ref":"Matt.12.40","start":40012040,"end":40012040,"break":"none","ruby":[[9,1,"か"],[11,1,"ばん"],[13,2,"たいぎょ"],[16,1,"はら"],[18,1,"うち"],[26,1,"ひと"],[28,1,"こ"],[31,1,"か"],[33,1,"ばん"],[35,1,"ち"],[37,1,"なか"]],"text":"すなわち、ヨナが三日三晩、大魚の腹の中にいたように、人の子も三日三晩、地の中にいるであろう。"},{"ref":"Matt.12.41","start":40012041,"end":40012041,"break":"none","ruby":[[4,2,"ひとびと"],[8,1,"いま"],[10,2,"じだい"],[13,2,"ひとびと"],[16,1,"とも"],[22,1,"ば"],[24,1,"た"],[28,1,"かれ"],[31,1,"つみ"],[33,1,"さだ"],[50,2,"ひとびと"],[56,2,"せんきょう"],[62,1,"く"],[64,1,"あらた"],[76,1,"み"],[85,1,"もの"]],"text":"ニネベの人々が、今の時代の人々と共にさばきの場に立って、彼らを罪に定めるであろう。なぜなら、ニネベの人々はヨナの宣教によって悔い改めたからである。しかし見よ、ヨナにまさる者がここにいる。"},{"ref":"Matt.12.42","start":40012042,"end":40012042,"break":"none","ruby":[[0,1,"みなみ"],[2,2,"じょおう"],[6,1,"いま"],[8,2,"じだい"],[11,2,"ひとびと"],[14,1,"とも"],[20,1,"ば"],[22,1,"た"],[26,1,"かれ"],[29,1,"つみ"],[31,1,"さだ"],[44,2,"かのじょ"],[52,2,"ちえ"],[55,1,"き"],[60,1,"ち"],[62,1,"はて"],[81,1,"み"],[92,1,"もの"]],"text":"南の女王が、今の時代の人々と共にさばきの場に立って、彼らを罪に定めるであろう。なぜなら、彼女はソロモンの知恵を聞くために地の果から、はるばるきたからである。しかし見よ、ソロモンにまさる者がここにいる。"},{"ref":"Matt.12.43","start":40012043,"end":40012043,"break":"none","ruby":[[0,1,"けが"],[3,1,"れい"],[5,1,"ひと"],[8,1,"で"],[12,1,"やす"],[14,1,"ば"],[16,1,"もと"],[19,1,"みず"],[21,1,"な"],[23,1,"ところ"],[25,1,"ある"],[32,1,"み"]],"text":"汚れた霊が人から出ると、休み場を求めて水の無い所を歩きまわるが、見つからない。"},{"ref":"Matt.12.44","start":40012044,"end":40012044,"break":"none","ruby":[[4,1,"で"],[8,1,"もと"],[10,1,"いえ"],[12,1,"かえ"],[16,1,"い"],[19,1,"かえ"],[22,1,"み"],[28,1,"いえ"],[44,1,"うえ"],[46,1,"かざ"]],"text":"そこで、出てきた元の家に帰ろうと言って帰って見ると、その家はあいていて、そうじがしてある上、飾りつけがしてあった。"},{"ref":"Matt.12.45","start":40012045,"end":40012045,"break":"none","ruby":[[5,1,"で"],[7,1,"い"],[11,2,"じぶん"],[13,2,"いじょう"],[16,1,"わる"],[18,1,"た"],[23,1,"れい"],[25,2,"いっしょ"],[28,1,"ひ"],[30,1,"つ"],[35,1,"なか"],[44,1,"す"],[46,1,"こ"],[57,1,"ひと"],[62,2,"じょうたい"],[65,1,"はじ"],[73,1,"わる"],[87,1,"いま"],[89,2,"じだい"]],"text":"そこでまた出て行って、自分以上に悪い他の七つの霊を一緒に引き連れてきて中にはいり、そこに住み込む。そうすると、その人ののちの状態は初めよりももっと悪くなるのである。よこしまな今の時代も、このようになるであろう」。"},{"ref":"Matt.12.46","start":40012046,"end":40012046,"break":"paragraph","ruby":[[6,2,"ぐんしゅう"],[9,1,"はな"],[21,1,"はは"],[23,2,"きょうだい"],[34,1,"はな"],[38,1,"おも"],[41,1,"そと"],[43,1,"た"]],"text":"イエスがまだ群衆に話しておられるとき、その母と兄弟たちとが、イエスに話そうと思って外に立っていた。"},{"ref":"Matt.12.47","start":40012047,"end":40012047,"break":"none","ruby":[[6,1,"ひと"],[12,1,"い"],[28,2,"ははうえ"],[31,2,"きょうだい"],[41,1,"はな"],[45,1,"おも"],[49,1,"そと"],[51,1,"た"]],"text":"それで、ある人がイエスに言った、「ごらんなさい。あなたの母上と兄弟がたが、あなたに話そうと思って、外に立っておられます」。"},{"ref":"Matt.12.48","start":40012048,"end":40012048,"break":"none","ruby":[[4,1,"し"],[11,1,"もの"],[13,1,"こた"],[16,1,"い"],[26,1,"はは"],[41,2,"きょうだい"]],"text":"イエスは知らせてくれた者に答えて言われた、「わたしの母とは、だれのことか。わたしの兄弟とは、だれのことか」。"},{"ref":"Matt.12.49","start":40012049,"end":40012049,"break":"none","ruby":[[4,2,"でし"],[9,1,"ほう"],[11,1,"て"],[15,1,"の"],[18,1,"い"],[38,1,"はは"],[44,2,"きょうだい"]],"text":"そして、弟子たちの方に手をさし伸べて言われた、「ごらんなさい。ここにわたしの母、わたしの兄弟がいる。"},{"ref":"Matt.12.50","start":40012050,"end":40012050,"break":"none","ruby":[[0,1,"てん"],[9,1,"ちち"],[16,1,"おこな"],[18,1,"もの"],[29,2,"きょうだい"],[34,2,"しまい"],[39,1,"はは"]],"text":"天にいますわたしの父のみこころを行う者はだれでも、わたしの兄弟、また姉妹、また母なのである」。"}]