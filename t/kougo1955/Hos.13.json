[{"ref":"Hos.13.1","start":28013001,"end":28013001,"break":"paragraph","breaks":[[11,"line"],[20,"line"],[38,"line"]],"ruby":[[6,2,"ものい"],[11,2,"ひとびと"],[20,1,"かれ"],[28,1,"なか"],[30,2,"じぶん"],[33,1,"たか"],[41,1,"かれ"],[50,1,"つみ"],[52,1,"おか"],[55,1,"し"]],"text":"エフライムが物言えば、人々はおののいた。彼はイスラエルの中に自分を高くした。しかし彼はバアルによって罪を犯して死んだ。"},{"ref":"Hos.13.2","start":28013002,"end":28013002,"break":"line","breaks":[[19,"line"],[36,"line"],[45,"line"],[58,"line"],[64,"line"]],"ruby":[[3,1,"かれ"],[6,1,"いま"],[14,1,"つみ"],[16,1,"おか"],[21,1,"ぎん"],[26,2,"じぶん"],[32,1,"ぞう"],[34,1,"い"],[36,1,"たく"],[39,2,"ぐうぞう"],[42,1,"つく"],[48,1,"みな"],[49,2,"こうじん"],[58,1,"かれ"],[61,1,"い"],[67,2,"ぎせい"],[75,2,"ひとびと"],[78,1,"こ"],[79,1,"うし"],[81,1,"くち"]],"text":"そして彼らは今もなおますます罪を犯し、その銀をもって自分のために像を鋳、巧みに偶像を造る。これは皆工人のわざである。彼らは言う、これに犠牲をささげよ、人々は子牛に口づけせよと。"},{"ref":"Hos.13.3","start":28013003,"end":28013003,"break":"line","breaks":[[15,"line"],[31,"line"],[53,"line"]],"ruby":[[4,1,"かれ"],[7,1,"あさ"],[9,1,"きり"],[20,1,"き"],[25,1,"つゆ"],[31,1,"う"],[33,1,"ば"],[36,1,"かぜ"],[38,1,"ふ"],[40,1,"さ"],[55,1,"まど"],[58,1,"で"],[60,1,"い"],[62,1,"けむり"]],"text":"それゆえ彼らは朝の霧のように、すみやかに消えうせる露のように、打ち場から風に吹き去られるもみがらのように、また窓から出て行く煙のようになる。"},{"ref":"Hos.13.4","start":28013004,"end":28013004,"break":"stanza","breaks":[[20,"line"],[31,"line"],[49,"line"]],"ruby":[[9,1,"くに"],[11,1,"で"],[24,1,"かみ"],[26,1,"しゅ"],[42,1,"かみ"],[44,1,"し"],[56,1,"すく"],[58,1,"もの"]],"text":"わたしはエジプトの国を出てからこのかた、あなたの神、主である。あなたはわたしのほかに神を知らない。わたしのほかに救う者はない。"},{"ref":"Hos.13.5","start":28013005,"end":28013005,"break":"line","breaks":[[17,"line"]],"ruby":[[4,2,"あらの"],[14,1,"ち"],[21,1,"し"]],"text":"わたしは荒野で、またかわいた地で、あなたを知った。"},{"ref":"Hos.13.6","start":28013006,"end":28013006,"break":"line","breaks":[[12,"line"]],"ruby":[[3,1,"かれ"],[6,1,"た"],[9,1,"あ"],[12,1,"あ"],[18,1,"こころ"],[20,1,"たか"],[28,1,"わす"]],"text":"しかし彼らは食べて飽き、飽きて、その心が高ぶり、わたしを忘れた。"},{"ref":"Hos.13.7","start":28013007,"end":28013007,"break":"line","breaks":[[17,"line"],[26,"line"]],"ruby":[[9,1,"かれ"],[12,1,"む"],[33,1,"みち"],[40,1,"ひそ"]],"text":"それゆえ、わたしは彼らに向かって、ししのようになり、ひょうのように道のかたわらに潜んでうかがう。"},{"ref":"Hos.13.8","start":28013008,"end":28013008,"break":"line","breaks":[[23,"line"],[32,"line"],[51,"line"]],"ruby":[[4,1,"こ"],[6,1,"と"],[10,1,"くま"],[15,1,"かれ"],[18,2,"であ"],[25,1,"むね"],[34,1,"ところ"],[46,1,"く"],[48,1,"つく"],[51,1,"の"],[53,1,"けもの"],[63,1,"やぶ"]],"text":"わたしは子を取られた熊のように彼らに出会って、その胸をかきさき、その所で、ししのようにこれを食い尽し、野の獣のようにこれをかき破る。"},{"ref":"Hos.13.9","start":28013009,"end":28013009,"break":"stanza","breaks":[[19,"line"]],"ruby":[[15,1,"ほろ"],[26,1,"たす"]],"text":"イスラエルよ、わたしはあなたを滅ぼす。だれがあなたを助けることができよう。"},{"ref":"Hos.13.10","start":28013010,"end":28013010,"break":"line","breaks":[[23,"line"],[70,"line"]],"ruby":[[4,1,"たす"],[11,1,"おう"],[13,1,"いま"],[35,1,"おう"],[37,1,"きみ"],[42,1,"あた"],[47,1,"い"],[54,2,"ほご"],[70,1,"いま"]],"text":"あなたを助けるあなたの王は今、どこにいるのか。あなたがかつて「わたしに王と君たちとを与えよ」と言ったあなたを保護すべき、すべてのつかさたちは今、どこにいるのか。"},{"ref":"Hos.13.11","start":28013011,"end":28013011,"break":"line","breaks":[[20,"line"]],"ruby":[[4,1,"いか"],[14,1,"おう"],[16,1,"あた"],[22,1,"いきどお"],[31,1,"うば"],[33,1,"と"]],"text":"わたしは怒りをもってあなたに王を与えた、また憤りをもってこれを奪い取った。"},{"ref":"Hos.13.12","start":28013012,"end":28013012,"break":"line","breaks":[[15,"line"]],"ruby":[[6,2,"ふぎ"],[9,1,"つつ"],[17,1,"つみ"],[19,1,"つ"]],"text":"エフライムの不義は包みおかれ、その罪は積みたくわえられてある。"},{"ref":"Hos.13.13","start":28013013,"end":28013013,"break":"line","breaks":[[15,"line"],[27,"line"]],"ruby":[[0,1,"こ"],[2,1,"う"],[4,1,"おんな"],[6,1,"くる"],[10,1,"かれ"],[12,1,"のぞ"],[15,1,"かれ"],[17,2,"ちえ"],[22,1,"こ"],[27,1,"うま"],[30,1,"とき"],[32,1,"き"],[35,1,"かれ"],[37,1,"さん"],[38,1,"もん"]],"text":"子を産む女の苦しみが彼に臨む。彼は知恵のない子である。生れる時が来ても彼は産門にあらわれない。"},{"ref":"Hos.13.14","start":28013014,"end":28013014,"break":"stanza","breaks":[[14,"line"],[26,"line"],[45,"line"],[62,"line"],[81,"line"]],"ruby":[[4,1,"かれ"],[7,2,"よみ"],[10,1,"ちから"],[26,1,"かれ"],[29,1,"し"],[45,1,"し"],[52,1,"わざわい"],[62,2,"よみ"],[70,1,"ほろ"],[91,1,"め"],[94,1,"かく"]],"text":"わたしは彼らを陰府の力から、あがなうことがあろうか。彼らを死から、あがなうことがあろうか。死よ、おまえの災はどこにあるのか。陰府よ、おまえの滅びはどこにあるのか。あわれみは、わたしの目から隠されている。"},{"ref":"Hos.13.15","start":28013015,"end":28013015,"break":"stanza","breaks":[[15,"line"],[24,"line"],[37,"line"],[58,"line"]],"ruby":[[3,1,"かれ"],[5,1,"あし"],[10,1,"さか"],[15,2,"ひがしかぜ"],[18,1,"ふ"],[21,1,"く"],[24,1,"しゅ"],[26,1,"かぜ"],[28,2,"あらの"],[32,1,"ふ"],[34,1,"おこ"],[45,1,"みなもと"],[52,1,"いずみ"],[65,1,"たっと"],[67,1,"もの"],[69,2,"ほうこ"],[75,1,"うば"]],"text":"たとい彼は葦のように栄えても、東風が吹いて来る。主の風が荒野から吹き起る。これがためにその源はかれ、その泉はかわく。それはすべての尊い物の宝庫をかすめ奪う。"},{"ref":"Hos.13.16","start":28013016,"end":28013016,"break":"line","breaks":[[16,"line"],[30,"line"],[42,"line"]],"ruby":[[7,1,"かみ"],[18,1,"つみ"],[20,1,"お"],[27,1,"たお"],[32,1,"おさ"],[34,1,"ご"],[36,1,"な"],[38,1,"くだ"],[48,1,"おんな"],[50,1,"ひ"],[52,1,"さ"]],"text":"サマリヤはその神にそむいたので、その罪を負い、つるぎに倒れ、その幼な子は投げ砕かれ、そのはらめる女は引き裂かれる。"}]