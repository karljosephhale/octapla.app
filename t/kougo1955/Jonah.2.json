[{"ref":"Jonah.2.1","start":32002001,"end":32002001,"break":"paragraph","ruby":[[3,1,"うお"],[5,1,"はら"],[7,1,"うち"],[12,1,"かみ"],[14,1,"しゅ"],[16,1,"いの"]],"text":"ヨナは魚の腹の中からその神、主に祈って、"},{"ref":"Jonah.2.2","start":32002002,"end":32002002,"break":"none","breaks":[[4,"stanza"],[24,"line"],[36,"line"],[52,"line"]],"ruby":[[0,1,"い"],[9,1,"なや"],[16,1,"しゅ"],[18,1,"よ"],[24,1,"しゅ"],[30,1,"こた"],[40,2,"よみ"],[43,1,"はら"],[45,1,"うち"],[48,1,"さけ"],[60,1,"こえ"],[62,1,"き"]],"text":"言った、「わたしは悩みのうちから主に呼ばわると、主はわたしに答えられた。わたしが陰府の腹の中から叫ぶと、あなたはわたしの声を聞かれた。"},{"ref":"Jonah.2.3","start":32002003,"end":32002003,"break":"line","breaks":[[12,"line"],[26,"line"],[37,"line"]],"ruby":[[8,1,"ふち"],[10,1,"なか"],[12,1,"うみ"],[16,1,"なか"],[18,1,"な"],[20,1,"い"],[26,2,"おおみず"],[41,1,"なみ"],[43,2,"おおなみ"],[46,1,"みな"],[52,1,"うえ"],[54,1,"こ"],[57,1,"い"]],"text":"あなたはわたしを淵の中、海のまん中に投げ入れられた。大水はわたしをめぐり、あなたの波と大波は皆、わたしの上を越えて行った。"},{"ref":"Jonah.2.4","start":32002004,"end":32002004,"break":"line","breaks":[[8,"line"],[29,"line"]],"ruby":[[4,1,"い"],[17,1,"まえ"],[20,1,"お"],[33,1,"ふたた"],[39,1,"せい"],[42,1,"みや"],[44,1,"のぞ"]],"text":"わたしは言った、『わたしはあなたの前から追われてしまった、どうして再びあなたの聖なる宮を望みえようか』。"},{"ref":"Jonah.2.5","start":32002005,"end":32002005,"break":"line","breaks":[[18,"line"],[29,"line"]],"ruby":[[0,1,"みず"],[10,1,"たましい"],[18,1,"ふち"],[24,1,"と"],[26,1,"かこ"],[29,2,"かいそう"],[32,1,"やま"],[34,2,"ねもと"],[41,1,"あたま"]],"text":"水がわたしをめぐって魂にまでおよび、淵はわたしを取り囲み、海草は山の根元でわたしの頭にまといついた。"},{"ref":"Jonah.2.6","start":32002006,"end":32002006,"break":"line","breaks":[[9,"line"],[28,"line"],[38,"line"]],"ruby":[[4,1,"ち"],[6,1,"くだ"],[9,1,"ち"],[11,1,"かん"],[13,1,"き"],[22,1,"うえ"],[33,1,"かみ"],[35,1,"しゅ"],[44,1,"いのち"],[46,1,"あな"],[49,1,"すく"]],"text":"わたしは地に下り、地の貫の木はいつもわたしの上にあった。しかしわが神、主よ、あなたはわが命を穴から救いあげられた。"},{"ref":"Jonah.2.7","start":32002007,"end":32002007,"break":"line","breaks":[[19,"line"],[29,"line"],[42,"line"]],"ruby":[[2,1,"たましい"],[11,1,"よわ"],[23,1,"しゅ"],[33,1,"いのり"],[39,1,"いた"],[46,1,"せい"],[49,1,"みや"],[51,1,"たっ"]],"text":"わが魂がわたしのうちに弱っているとき、わたしは主をおぼえ、わたしの祈はあなたに至り、あなたの聖なる宮に達した。"},{"ref":"Jonah.2.8","start":32002008,"end":32002008,"break":"line","breaks":[[15,"line"]],"ruby":[[4,2,"ぐうぞう"],[7,1,"こころ"],[9,1,"よ"],[12,1,"もの"],[21,2,"ちゅうせつ"],[24,1,"す"]],"text":"むなしい偶像に心を寄せる者は、そのまことの忠節を捨てる。"},{"ref":"Jonah.2.9","start":32002009,"end":32002009,"break":"line","breaks":[[16,"line"],[38,"line"]],"ruby":[[7,2,"かんしゃ"],[10,1,"こえ"],[20,2,"ぎせい"],[31,1,"ちか"],[38,1,"すくい"],[40,1,"しゅ"]],"text":"しかしわたしは感謝の声をもって、あなたに犠牲をささげ、わたしの誓いをはたす。救は主にある」。"},{"ref":"Jonah.2.10","start":32002010,"end":32002010,"break":"line","ruby":[[0,1,"しゅ"],[2,1,"うお"],[5,1,"めい"],[14,1,"うお"],[19,1,"りく"],[21,1,"は"],[23,1,"だ"]],"text":"主は魚にお命じになったので、魚はヨナを陸に吐き出した。"}]