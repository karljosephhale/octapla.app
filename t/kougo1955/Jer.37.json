[{"ref":"Jer.37.1","start":24037001,"end":24037001,"break":"paragraph","ruby":[[4,1,"こ"],[16,1,"こ"],[21,1,"かわ"],[24,1,"おう"],[35,1,"おう"],[44,1,"かれ"],[49,1,"ち"],[51,1,"おう"]],"text":"ヨシヤの子ゼデキヤはエホヤキムの子コニヤに代って王となった。バビロンの王ネブカデレザルが彼をユダの地の王としたのである。"},{"ref":"Jer.37.2","start":24037002,"end":24037002,"break":"none","ruby":[[0,1,"かれ"],[4,2,"けらい"],[12,1,"ち"],[14,2,"ひとびと"],[18,1,"しゅ"],[20,3,"よげんしゃ"],[31,1,"かた"],[35,2,"ことば"],[38,1,"き"],[40,1,"したが"]],"text":"彼もその家来たちも、その地の人々も、主が預言者エレミヤによって語られた言葉に聞き従わなかった。"},{"ref":"Jer.37.3","start":24037003,"end":24037003,"break":"paragraph","ruby":[[4,1,"おう"],[11,1,"こ"],[22,1,"こ"],[23,2,"さいし"],[30,3,"よげんしゃ"],[59,1,"かみ"],[61,1,"しゅ"],[63,1,"いの"],[72,1,"い"]],"text":"ゼデキヤ王はセレミヤの子ユカルと、マアセヤの子祭司ゼパニヤを預言者エレミヤにつかわして、「われわれのために、われわれの神、主に祈ってください」と言わせた。"},{"ref":"Jer.37.4","start":24037004,"end":24037004,"break":"none","ruby":[[5,1,"たみ"],[7,1,"なか"],[9,2,"でい"],[19,2,"ごくや"],[22,1,"い"]],"text":"エレミヤは民の中に出入りしていた。まだ獄屋に入れられなかったからである。"},{"ref":"Jer.37.5","start":24037005,"end":24037005,"break":"none","ruby":[[3,2,"ぐんぜい"],[12,1,"で"],[14,1,"き"],[25,1,"せ"],[27,1,"かこ"],[41,2,"じょうほう"],[44,1,"き"],[53,1,"しりぞ"]],"text":"パロの軍勢がエジプトから出て来たので、エルサレムを攻め囲んでいたカルデヤびとはその情報を聞いてエルサレムを退いた。"},{"ref":"Jer.37.6","start":24037006,"end":24037006,"break":"none","ruby":[[2,1,"とき"],[4,1,"しゅ"],[6,2,"ことば"],[9,3,"よげんしゃ"],[17,1,"のぞ"]],"text":"その時、主の言葉は預言者エレミヤに臨んだ、"},{"ref":"Jer.37.7","start":24037007,"end":24037007,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[13,1,"い"],[33,1,"もと"],[39,1,"おう"],[43,1,"い"],[56,1,"すく"],[61,1,"で"],[68,2,"ぐんぜい"],[73,1,"くに"],[79,1,"かえ"]],"text":"「イスラエルの神、主はこう言われる、あなたがたをつかわしてわたしに求めたユダの王にこう言いなさい、『あなたがたを救うために出てきたパロの軍勢はその国エジプトに帰ろうとしている。"},{"ref":"Jer.37.8","start":24037008,"end":24037008,"break":"none","ruby":[[7,1,"ふたた"],[9,1,"き"],[13,1,"まち"],[15,1,"せ"],[18,1,"たたか"],[24,1,"と"],[27,1,"ひ"],[29,1,"や"],[31,1,"ほろ"]],"text":"カルデヤびとが再び来てこの町を攻めて戦い、これを取って火で焼き滅ぼす。"},{"ref":"Jer.37.9","start":24037009,"end":24037009,"break":"none","ruby":[[0,1,"しゅ"],[4,1,"い"],[32,1,"はな"],[34,1,"さ"],[41,2,"じぶん"],[44,1,"あざむ"],[53,1,"かれ"],[56,1,"さ"]],"text":"主はこう言われる、あなたがたは、「カルデヤびとはきっとわれわれを離れ去る」といって自分を欺いてはならない。彼らは去ることはない。"},{"ref":"Jer.37.10","start":24037010,"end":24037010,"break":"none","ruby":[[9,2,"じぶん"],[12,1,"せ"],[15,1,"たたか"],[24,1,"ぜん"],[25,1,"ぐん"],[27,1,"う"],[29,1,"やぶ"],[35,2,"てんまく"],[41,2,"ふしょう"],[43,1,"もの"],[47,1,"のこ"],[52,1,"かれ"],[55,1,"た"],[57,1,"あ"],[61,1,"ひ"],[65,1,"まち"],[67,1,"や"],[69,1,"ほろ"]],"text":"たといあなたがたが自分を攻めて戦うカルデヤびとの全軍を撃ち破って、その天幕のうちに負傷者のみを残しても、彼らは立ち上がって火でこの町を焼き滅ぼす』」。"},{"ref":"Jer.37.11","start":24037011,"end":24037011,"break":"paragraph","ruby":[[9,2,"ぐんぜい"],[15,2,"ぐんぜい"],[18,1,"く"],[22,1,"き"],[31,1,"しりぞ"]],"text":"さてカルデヤびとの軍勢がパロの軍勢の来るのを聞いてエルサレムを退いたとき、"},{"ref":"Jer.37.12","start":24037012,"end":24037012,"break":"none","ruby":[[12,1,"ち"],[14,1,"たみ"],[19,2,"じぶん"],[22,1,"わ"],[24,1,"まえ"],[26,1,"う"],[28,1,"と"],[39,1,"た"],[44,1,"ち"],[46,1,"い"]],"text":"エレミヤは、ベニヤミンの地で民のうちに自分の分け前を受け取るため、エルサレムを立ってその地へ行こうと、"},{"ref":"Jer.37.13","start":24037013,"end":24037013,"break":"none","ruby":[[6,1,"もん"],[8,1,"つ"],[22,1,"こ"],[28,1,"こ"],[36,1,"な"],[38,2,"ばんぺい"],[44,3,"よげんしゃ"],[52,1,"とら"],[67,1,"がわ"],[69,2,"だっそう"],[81,1,"い"]],"text":"ベニヤミンの門に着いたとき、そこにハナニヤの子セレミヤの子でイリヤという名の番兵がいて、預言者エレミヤを捕え、「あなたはカルデヤびとの側に脱走しようとしている」と言った。"},{"ref":"Jer.37.14","start":24037014,"end":24037014,"break":"none","ruby":[[5,1,"い"],[30,1,"がわ"],[32,2,"だっそう"],[52,1,"き"],[61,1,"とら"],[74,1,"ひ"],[77,1,"い"]],"text":"エレミヤは言った、「それはまちがいだ。わたしはカルデヤびとの側に脱走しようとしていない」。しかしイリヤは聞かず、エレミヤを捕えて、つかさたちのもとへ引いて行った。"},{"ref":"Jer.37.15","start":24037015,"end":24037015,"break":"none","ruby":[[6,1,"いか"],[15,1,"う"],[21,2,"しょき"],[28,1,"いえ"],[30,2,"ごくや"],[39,1,"いえ"],[41,2,"ごくや"]],"text":"つかさたちは怒って、エレミヤを打ちたたき、書記ヨナタンの家の獄屋にいれた。この家が獄屋になっていたからである。"},{"ref":"Jer.37.16","start":24037016,"end":24037016,"break":"paragraph","ruby":[[5,2,"ちか"],[8,2,"ごくや"],[19,1,"おお"],[22,1,"ひ"],[24,1,"おく"]],"text":"エレミヤが地下の獄屋にはいって、そこに多くの日を送ってのち、"},{"ref":"Jer.37.17","start":24037017,"end":24037017,"break":"none","ruby":[[4,1,"おう"],[6,1,"ひと"],[13,1,"かれ"],[15,1,"つ"],[23,1,"おう"],[25,2,"じぶん"],[28,1,"いえ"],[34,1,"かれ"],[36,1,"たず"],[39,1,"い"],[44,1,"しゅ"],[47,1,"なに"],[50,2,"ことば"],[68,1,"こた"],[75,1,"い"],[89,1,"おう"],[91,1,"て"],[93,1,"ひ"],[95,1,"わた"]],"text":"ゼデキヤ王は人をつかわし、彼を連れてこさせた。王は自分の家でひそかに彼に尋ねて言った、「主から何かお言葉があったか」。エレミヤはあったと答えた。そして言った、「あなたはバビロンの王の手に引き渡されます」。"},{"ref":"Jer.37.18","start":24037018,"end":24037018,"break":"none","ruby":[[11,1,"おう"],[13,1,"い"],[22,2,"ごくや"],[45,2,"けらい"],[55,1,"たみ"],[63,1,"つみ"],[65,1,"おか"]],"text":"エレミヤはまたゼデキヤ王に言った、「わたしが獄屋にいれられたのは、あなたに、またはあなたの家来に、あるいはこの民に、どのような罪を犯したからなのですか。"},{"ref":"Jer.37.19","start":24037019,"end":24037019,"break":"none","ruby":[[6,2,"よげん"],[17,1,"おう"],[29,1,"ち"],[32,1,"せ"],[40,1,"い"],[51,3,"よげんしゃ"],[55,1,"いま"]],"text":"あなたがたに預言して、『バビロンの王はあなたがたをも、この地をも攻めにこない』と言っていたあなたがたの預言者は今どこにいるのですか。"},{"ref":"Jer.37.20","start":24037020,"end":24037020,"break":"none","ruby":[[0,1,"おう"],[5,1,"きみ"],[11,1,"いま"],[13,1,"き"],[24,1,"ねが"],[28,1,"き"],[42,2,"しょき"],[49,1,"いえ"],[51,1,"かえ"],[76,1,"ころ"]],"text":"王なるわが君よ、どうぞ今お聞きください。わたしの願いをお聞きとどけください。わたしを書記ヨナタンの家へ帰らせないでください。そうでないと、わたしはそこで殺されるでしょう」。"},{"ref":"Jer.37.21","start":24037021,"end":24037021,"break":"none","ruby":[[7,1,"おう"],[9,1,"めい"],[11,1,"くだ"],[19,2,"かんし"],[22,1,"にわ"],[24,1,"い"],[35,1,"つく"],[37,1,"もの"],[39,1,"まち"],[42,2,"まいにち"],[47,1,"こ"],[49,1,"かれ"],[51,1,"あた"],[60,1,"まち"],[71,1,"つづ"],[84,2,"かんし"],[87,1,"にわ"]],"text":"そこでゼデキヤ王は命を下し、エレミヤを監視の庭に入れさせ、かつ、パンを造る者の町から毎日パン一個を彼に与えさせた。これは町にパンがなくなるまで続いた。こうしてエレミヤは監視の庭にいた。"}]