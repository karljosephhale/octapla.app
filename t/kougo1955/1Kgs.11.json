[{"ref":"1Kgs.11.1","start":11011001,"end":11011001,"break":"paragraph","ruby":[[4,1,"おう"],[6,1,"おお"],[9,2,"がいこく"],[12,1,"おんな"],[14,1,"あい"],[25,1,"むすめ"],[57,1,"おんな"],[59,1,"あい"]],"text":"ソロモン王は多くの外国の女を愛した。すなわちパロの娘、モアブびと、アンモンびと、エドムびと、シドンびと、ヘテびとの女を愛した。"},{"ref":"1Kgs.11.2","start":11011002,"end":11011002,"break":"none","ruby":[[0,1,"しゅ"],[9,2,"こくみん"],[22,2,"ひとびと"],[25,1,"い"],[37,1,"かれ"],[40,1,"まじ"],[50,1,"かれ"],[61,1,"まじ"],[71,1,"かれ"],[74,1,"かなら"],[82,1,"こころ"],[84,1,"てん"],[87,1,"かれ"],[90,2,"かみがみ"],[93,1,"したが"],[112,1,"かれ"],[115,1,"あい"],[118,1,"はな"]],"text":"主はかつてこれらの国民について、イスラエルの人々に言われた、「あなたがたは彼らと交わってはならない。彼らもまたあなたがたと交わってはならない。彼らは必ずあなたがたの心を転じて彼らの神々に従わせるからである」。しかしソロモンは彼らを愛して離れなかった。"},{"ref":"1Kgs.11.3","start":11011003,"end":11011003,"break":"none","ruby":[[0,1,"かれ"],[3,2,"おうひ"],[9,1,"つま"],[12,1,"にん"],[19,1,"にん"],[27,1,"つま"],[31,1,"かれ"],[33,1,"こころ"],[35,1,"てん"]],"text":"彼には王妃としての妻七百人、そばめ三百人があった。その妻たちが彼の心を転じたのである。"},{"ref":"1Kgs.11.4","start":11011004,"end":11011004,"break":"none","ruby":[[5,2,"としお"],[9,1,"とき"],[13,1,"つま"],[17,1,"かれ"],[19,1,"こころ"],[21,1,"てん"],[24,1,"た"],[26,2,"かみがみ"],[29,1,"したが"],[36,1,"かれ"],[38,1,"こころ"],[40,1,"ちち"],[45,1,"こころ"],[54,1,"かみ"],[56,1,"しゅ"],[58,2,"しんじつ"]],"text":"ソロモンが年老いた時、その妻たちが彼の心を転じて他の神々に従わせたので、彼の心は父ダビデの心のようには、その神、主に真実でなかった。"},{"ref":"1Kgs.11.5","start":11011005,"end":11011005,"break":"none","ruby":[[14,2,"めがみ"],[22,1,"したが"],[32,1,"かみ"],[36,1,"にく"],[40,1,"もの"],[46,1,"したが"]],"text":"これはソロモンがシドンびとの女神アシタロテに従い、アンモンびとの神である憎むべき者ミルコムに従ったからである。"},{"ref":"1Kgs.11.6","start":11011006,"end":11011006,"break":"none","ruby":[[10,1,"しゅ"],[12,1,"め"],[14,1,"まえ"],[16,1,"あく"],[18,1,"おこな"],[21,1,"ちち"],[29,1,"まった"],[32,1,"しゅ"],[34,1,"したが"]],"text":"このようにソロモンは主の目の前に悪を行い、父ダビデのように全くは主に従わなかった。"},{"ref":"1Kgs.11.7","start":11011007,"end":11011007,"break":"none","ruby":[[12,1,"かみ"],[16,1,"にく"],[20,1,"もの"],[36,2,"ひとびと"],[39,1,"かみ"],[43,1,"にく"],[47,1,"もの"],[61,1,"ひがし"],[63,1,"やま"],[65,1,"たか"],[67,1,"ところ"],[69,1,"きず"]],"text":"そしてソロモンはモアブの神である憎むべき者ケモシのために、またアンモンの人々の神である憎むべき者モレクのためにエルサレムの東の山に高き所を築いた。"},{"ref":"1Kgs.11.8","start":11011008,"end":11011008,"break":"none","ruby":[[0,1,"かれ"],[4,2,"がいこく"],[11,1,"つま"],[26,2,"かのじょ"],[33,2,"かみがみ"],[36,1,"こう"],[41,2,"ぎせい"]],"text":"彼はまた外国のすべての妻たちのためにもそうしたので、彼女たちはその神々に香をたき、犠牲をささげた。"},{"ref":"1Kgs.11.9","start":11011009,"end":11011009,"break":"paragraph","ruby":[[10,1,"こころ"],[12,1,"てん"],[22,1,"かみ"],[24,1,"しゅ"],[26,1,"はな"],[32,1,"しゅ"],[34,1,"かれ"],[36,1,"いか"],[45,1,"しゅ"],[51,1,"ど"],[52,1,"かれ"],[54,1,"あらわ"]],"text":"このようにソロモンの心が転じて、イスラエルの神、主を離れたため、主は彼を怒られた。すなわち主がかつて二度彼に現れ、"},{"ref":"1Kgs.11.10","start":11011010,"end":11011010,"break":"none","ruby":[[2,1,"こと"],[7,1,"かれ"],[10,1,"た"],[12,2,"かみがみ"],[15,1,"したが"],[24,1,"めい"],[32,1,"かれ"],[34,1,"しゅ"],[36,1,"めい"],[44,1,"まも"]],"text":"この事について彼に、他の神々に従ってはならないと命じられたのに、彼は主の命じられたことを守らなかったからである。"},{"ref":"1Kgs.11.11","start":11011011,"end":11011011,"break":"none","ruby":[[5,1,"しゅ"],[12,1,"い"],[25,2,"ほんしん"],[35,1,"めい"],[38,2,"けいやく"],[41,1,"さだ"],[45,1,"まも"],[58,1,"かなら"],[65,1,"くに"],[67,1,"さ"],[69,1,"はな"],[80,2,"けらい"],[83,1,"あた"]],"text":"それゆえ、主はソロモンに言われた、「これがあなたの本心であり、わたしが命じた契約と定めとを守らなかったので、わたしは必ずあなたから国を裂き離して、それをあなたの家来に与える。"},{"ref":"1Kgs.11.12","start":11011012,"end":11011012,"break":"none","ruby":[[7,1,"ちち"],[20,1,"よ"],[35,1,"こ"],[37,1,"て"],[43,1,"さ"],[45,1,"はな"]],"text":"しかしあなたの父ダビデのために、あなたの世にはそれをしないが、あなたの子の手からそれを裂き離す。"},{"ref":"1Kgs.11.13","start":11011013,"end":11011013,"break":"none","ruby":[[8,1,"くに"],[16,1,"さ"],[18,1,"はな"],[43,1,"えら"],[58,2,"ぶぞく"],[65,1,"こ"],[67,1,"あた"]],"text":"ただし、わたしは国をことごとくは裂き離さず、わたしのしもべダビデのために、またわたしが選んだエルサレムのために一つの部族をあなたの子に与えるであろう」。"},{"ref":"1Kgs.11.14","start":11011014,"end":11011014,"break":"paragraph","ruby":[[4,1,"しゅ"],[15,1,"おこ"],[24,1,"てき"],[30,1,"かれ"],[36,1,"おう"],[37,1,"いえ"],[39,1,"もの"]],"text":"こうして主はエドムびとハダデを起して、ソロモンの敵とされた。彼はエドムの王家の者であった。"},{"ref":"1Kgs.11.15","start":11011015,"end":11011015,"break":"none","ruby":[[15,1,"ぐん"],[17,1,"ちょう"],[22,1,"のぼ"],[29,2,"せんし"],[33,1,"もの"],[35,1,"ほうむ"],[42,2,"だんし"],[50,1,"う"],[52,1,"ころ"],[55,1,"とき"]],"text":"さきにダビデはエドムにいたが、軍の長ヨアブが上っていって、戦死した者を葬り、エドムの男子をことごとく打ち殺した時、"},{"ref":"1Kgs.11.16","start":11011016,"end":11011016,"break":"none","ruby":[[11,2,"ひとびと"],[14,1,"とも"],[18,1,"げつ"],[32,2,"だんし"],[40,1,"た"]],"text":"（ヨアブはイスラエルの人々と共に六か月そこにとどまって、エドムの男子をことごとく断った）。"},{"ref":"1Kgs.11.17","start":11011017,"end":11011017,"break":"none","ruby":[[6,1,"ちち"],[14,2,"すうにん"],[23,1,"とも"],[25,1,"に"],[33,1,"い"],[42,1,"とき"],[49,2,"しょうねん"]],"text":"ハダデはその父のしもべである数人のエドムびとと共に逃げてエジプトへ行こうとした。その時ハダデはまだ少年であった。"},{"ref":"1Kgs.11.18","start":11011018,"end":11011018,"break":"none","ruby":[[0,1,"かれ"],[8,1,"た"],[15,1,"い"],[23,2,"ひとびと"],[26,1,"ともな"],[34,1,"い"],[42,1,"おう"],[50,1,"い"],[57,1,"かれ"],[59,1,"いえ"],[61,1,"あた"],[64,2,"しょくりょう"],[67,1,"さだ"],[72,2,"とち"],[75,1,"あた"]],"text":"彼らがミデアンを立ってパランへ行き、パランから人々を伴ってエジプトへ行き、エジプトの王パロのところへ行くと、パロは彼に家を与え、食糧を定め、かつ土地を与えた。"},{"ref":"1Kgs.11.19","start":11011019,"end":11011019,"break":"none","ruby":[[4,1,"おお"],[10,1,"こころ"],[22,2,"じぶん"],[25,1,"つま"],[27,1,"いもうと"],[32,2,"おうひ"],[39,1,"いもうと"],[41,1,"つま"],[45,1,"かれ"],[47,1,"あた"]],"text":"ハダデは大いにパロの心にかなったので、パロは自分の妻の妹すなわち王妃タペネスの妹を妻として彼に与えた。"},{"ref":"1Kgs.11.20","start":11011020,"end":11011020,"break":"none","ruby":[[5,1,"いもうと"],[7,1,"かれ"],[9,1,"おとこ"],[11,1,"こ"],[17,1,"う"],[30,1,"こ"],[35,1,"いえ"],[40,2,"ちばな"],[55,1,"いえ"],[61,1,"こ"],[67,2,"いっしょ"]],"text":"タペネスの妹は彼に男の子ゲヌバテを産んだので、タペネスはその子をパロの家のうちで乳離れさせた。ゲヌバテはパロの家で、パロの子どもたちと一緒にいた。"},{"ref":"1Kgs.11.21","start":11011021,"end":11011021,"break":"none","ruby":[[18,2,"せんぞ"],[21,1,"とも"],[23,1,"ねむ"],[30,1,"ぐん"],[32,1,"ちょう"],[37,1,"し"],[43,1,"き"],[56,1,"い"],[65,1,"さ"],[70,1,"くに"],[72,1,"かえ"]],"text":"さてハダデはエジプトで、ダビデがその先祖と共に眠ったことと、軍の長ヨアブが死んだことを聞いたので、ハダデはパロに言った、「わたしを去らせて、国へ帰らせてください」。"},{"ref":"1Kgs.11.22","start":11011022,"end":11011022,"break":"none","ruby":[[3,1,"かれ"],[5,1,"い"],[14,1,"とも"],[22,2,"ふそく"],[28,1,"くに"],[30,1,"かえ"],[35,1,"もと"],[44,1,"かれ"],[46,1,"い"],[58,1,"かえ"]],"text":"パロは彼に言った、「わたしと共にいて、なんの不足があって国へ帰ることを求めるのですか」。彼は言った、「ただ、わたしを帰らせてください」。"},{"ref":"1Kgs.11.23","start":11011023,"end":11011023,"break":"paragraph","ruby":[[0,1,"かみ"],[9,1,"こ"],[14,1,"おこ"],[22,1,"てき"],[28,1,"かれ"],[32,2,"しゅじん"],[37,1,"おう"],[47,1,"に"],[49,1,"さ"],[52,1,"もの"]],"text":"神はまたエリアダの子レゾンを起してソロモンの敵とされた。彼はその主人ゾバの王ハダデゼルのもとを逃げ去った者であった。"},{"ref":"1Kgs.11.24","start":11011024,"end":11011024,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"ころ"],[13,1,"のち"],[15,1,"かれ"],[17,2,"ひとびと"],[20,2,"じぶん"],[27,1,"あつ"],[30,2,"りゃくだつ"],[32,1,"たい"],[34,2,"しゅりょう"],[41,1,"かれ"],[49,1,"い"],[56,1,"す"],[64,1,"かれ"],[66,1,"おう"]],"text":"ダビデがゾバの人々を殺した後、彼は人々を自分のまわりに集めて略奪隊の首領となった。彼らはダマスコへ行って、そこに住み、ダマスコで彼を王とした。"},{"ref":"1Kgs.11.25","start":11011025,"end":11011025,"break":"none","ruby":[[0,1,"かれ"],[7,2,"いっしょう"],[10,1,"あいだ"],[18,1,"てき"],[33,1,"がい"],[44,1,"にく"],[51,1,"おさ"]],"text":"彼はソロモンの一生の間、イスラエルの敵となって、ハダデがしたように害をなし、イスラエルを憎んでスリヤを治めた。"},{"ref":"1Kgs.11.26","start":11011026,"end":11011026,"break":"paragraph","ruby":[[15,1,"こ"],[27,2,"けらい"],[37,1,"はは"],[39,1,"な"],[48,2,"かふ"],[55,1,"かれ"],[61,1,"て"],[66,1,"おう"],[68,1,"てき"]],"text":"ゼレダのエフライムびとネバテの子ヤラベアムはソロモンの家来であったが、その母の名はゼルヤといって寡婦であった。彼もまたその手をあげて王に敵した。"},{"ref":"1Kgs.11.27","start":11011027,"end":11011027,"break":"none","ruby":[[0,1,"かれ"],[2,1,"て"],[8,1,"おう"],[10,1,"てき"],[13,2,"じじょう"],[30,1,"きず"],[33,1,"ちち"],[38,1,"まち"],[40,1,"やぶ"],[42,1,"くち"]],"text":"彼が手をあげて、王に敵した事情はこうである。ソロモンはミロを築き、父ダビデの町の破れ口をふさいでいた。"},{"ref":"1Kgs.11.28","start":11011028,"end":11011028,"break":"none","ruby":[[6,2,"ひじょう"],[9,2,"しゅわん"],[14,1,"ひと"],[28,2,"わかもの"],[33,1,"はたら"],[37,1,"み"],[40,1,"かれ"],[46,1,"いえ"],[52,2,"きょうせい"],[54,2,"ろうどう"],[57,2,"かんとく"]],"text":"ヤラベアムは非常に手腕のある人であったが、ソロモンはこの若者がよく働くのを見て、彼にヨセフの家のすべての強制労働の監督をさせた。"},{"ref":"1Kgs.11.29","start":11011029,"end":11011029,"break":"none","ruby":[[17,1,"で"],[29,3,"よげんしゃ"],[36,1,"みち"],[38,1,"かれ"],[40,1,"あ"],[48,1,"あたら"],[51,2,"きもの"],[54,1,"き"],[62,1,"かれ"],[70,1,"の"]],"text":"そのころ、ヤラベアムがエルサレムを出たとき、シロびとである預言者アヒヤが道で彼に会った。アヒヤは新しい着物を着ていた。そして彼らふたりだけが野にいた。"},{"ref":"1Kgs.11.30","start":11011030,"end":11011030,"break":"none","ruby":[[4,1,"き"],[8,2,"きもの"],[21,1,"き"],[24,1,"さ"]],"text":"アヒヤは着ている着物をつかんで、それを十二切れに裂き、"},{"ref":"1Kgs.11.31","start":11011031,"end":11011031,"break":"none","ruby":[[6,1,"い"],[16,1,"き"],[19,1,"と"],[31,1,"かみ"],[33,1,"しゅ"],[37,1,"い"],[43,1,"み"],[50,1,"くに"],[57,1,"て"],[60,1,"さ"],[62,1,"はな"],[71,2,"ぶぞく"],[74,1,"あた"]],"text":"ヤラベアムに言った、「あなたは十切れを取りなさい。イスラエルの神、主はこう言われる、『見よ、わたしは国をソロモンの手から裂き離して、あなたに十部族を与えよう。"},{"ref":"1Kgs.11.32","start":11011032,"end":11011032,"break":"none","ruby":[[4,1,"かれ"],[37,2,"ぶぞく"],[44,1,"えら"],[47,1,"まち"],[61,2,"ぶぞく"]],"text":"（ただし彼はわたしのしもべダビデのために、またわたしがイスラエルのすべての部族のうちから選んだ町エルサレムのために、一つの部族をもつであろう）。"},{"ref":"1Kgs.11.33","start":11011033,"end":11011033,"break":"none","ruby":[[3,1,"かれ"],[9,1,"す"],[19,2,"めがみ"],[32,1,"かみ"],[43,2,"ひとびと"],[46,1,"かみ"],[52,1,"おが"],[55,1,"ちち"],[68,1,"みち"],[70,1,"あゆ"],[78,1,"め"],[83,1,"こと"],[85,1,"おこな"],[92,1,"さだ"],[100,1,"まも"]],"text":"それは彼がわたしを捨てて、シドンびとの女神アシタロテと、モアブの神ケモシと、アンモンの人々の神ミルコムを拝み、父ダビデのように、わたしの道に歩んで、わたしの目にかなう事を行い、わたしの定めと、おきてを守ることをしなかったからである。"},{"ref":"1Kgs.11.34","start":11011034,"end":11011034,"break":"none","ruby":[[8,1,"くに"],[16,1,"かれ"],[18,1,"て"],[21,1,"と"],[30,1,"えら"],[50,2,"めいれい"],[53,1,"さだ"],[57,1,"まも"],[67,1,"かれ"],[77,2,"いっしょう"],[80,1,"あいだ"],[82,1,"きみ"]],"text":"しかし、わたしは国をことごとくは彼の手から取らない。わたしが選んだ、わたしのしもべダビデが、わたしの命令と定めとを守ったので、わたしは彼のためにソロモンを一生の間、君としよう。"},{"ref":"1Kgs.11.35","start":11011035,"end":11011035,"break":"none","ruby":[[10,1,"こ"],[12,1,"て"],[15,1,"くに"],[17,1,"と"],[24,2,"ぶぞく"],[31,1,"あた"]],"text":"そして、わたしはその子の手から国を取って、その十部族をあなたに与える。"},{"ref":"1Kgs.11.36","start":11011036,"end":11011036,"break":"none","ruby":[[2,1,"こ"],[8,2,"ぶぞく"],[11,1,"あた"],[19,1,"な"],[21,1,"お"],[26,1,"えら"],[29,1,"まち"],[53,1,"まえ"],[55,1,"つね"],[65,1,"たも"]],"text":"その子には一つの部族を与えて、わたしの名を置くために選んだ町エルサレムで、わたしのしもべダビデに、わたしの前に常に一つのともしびを保たせるであろう。"},{"ref":"1Kgs.11.37","start":11011037,"end":11011037,"break":"none","ruby":[[8,1,"えら"],[18,1,"こころ"],[20,1,"のぞ"],[26,1,"おさ"],[36,1,"うえ"],[38,1,"おう"]],"text":"わたしがあなたを選び、あなたはすべて心の望むところを治めて、イスラエルの上に王となるであろう。"},{"ref":"1Kgs.11.38","start":11011038,"end":11011038,"break":"none","ruby":[[12,1,"めい"],[19,1,"こと"],[21,1,"き"],[29,1,"みち"],[31,1,"あゆ"],[38,1,"め"],[43,1,"こと"],[45,1,"おこな"],[69,1,"さだ"],[72,1,"いまし"],[76,1,"まも"],[90,1,"とも"],[106,1,"た"],[120,2,"けんご"],[123,1,"いえ"],[125,1,"た"],[139,1,"あた"]],"text":"もし、あなたが、わたしの命じるすべての事を聞いて、わたしの道に歩み、わたしの目にかなう事を行い、わたしのしもべダビデがしたように、わたしの定めと戒めとを守るならば、わたしはあなたと共にいて、わたしがダビデのために建てたように、あなたのために堅固な家を建てて、イスラエルをあなたに与えよう。"},{"ref":"1Kgs.11.39","start":11011039,"end":11011039,"break":"none","ruby":[[13,2,"しそん"],[16,1,"くる"],[24,2,"えいきゅう"]],"text":"わたしはこのためにダビデの子孫を苦しめる。しかし永久にではない』」。"},{"ref":"1Kgs.11.40","start":11011040,"end":11011040,"break":"none","ruby":[[11,1,"ころ"],[25,1,"た"],[41,1,"おう"],[51,1,"い"],[60,1,"し"]],"text":"ソロモンはヤラベアムを殺そうとしたが、ヤラベアムは立ってエジプトにのがれ、エジプト王シシャクのところへ行って、ソロモンの死ぬまでエジプトにいた。"},{"ref":"1Kgs.11.41","start":11011041,"end":11011041,"break":"paragraph","ruby":[[10,2,"じせき"],[14,1,"かれ"],[22,1,"こと"],[28,2,"ちえ"],[37,2,"じせき"],[40,1,"しょ"]],"text":"ソロモンのそのほかの事績と、彼がしたすべての事およびその知恵は、ソロモンの事績の書にしるされているではないか。"},{"ref":"1Kgs.11.42","start":11011042,"end":11011042,"break":"none","ruby":[[17,1,"ぜん"],[18,1,"ち"],[20,1,"おさ"],[23,1,"ひ"],[27,1,"ねん"]],"text":"ソロモンがエルサレムでイスラエルの全地を治めた日は四十年であった。"},{"ref":"1Kgs.11.43","start":11011043,"end":11011043,"break":"none","ruby":[[7,2,"せんぞ"],[10,1,"とも"],[12,1,"ねむ"],[16,1,"ちち"],[21,1,"まち"],[23,1,"ほうむ"],[29,1,"こ"],[36,1,"かわ"],[39,1,"おう"]],"text":"ソロモンはその先祖と共に眠って、父ダビデの町に葬られ、その子レハベアムが代って王となった。"}]