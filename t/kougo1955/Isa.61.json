[{"ref":"Isa.61.1","start":23061001,"end":23061001,"break":"paragraph","breaks":[[15,"line"],[30,"line"],[50,"line"],[71,"line"],[82,"line"]],"ruby":[[0,1,"しゅ"],[3,1,"かみ"],[5,1,"れい"],[11,1,"のぞ"],[18,1,"しゅ"],[24,1,"あぶら"],[26,1,"そそ"],[30,1,"まず"],[33,1,"もの"],[35,2,"ふくいん"],[38,1,"の"],[40,1,"つた"],[59,1,"こころ"],[65,1,"もの"],[71,1,"とら"],[74,1,"びと"],[76,2,"ほうめん"],[79,1,"つ"],[82,1,"しば"],[88,1,"もの"],[90,2,"かいほう"],[93,1,"つ"]],"text":"主なる神の霊がわたしに臨んだ。これは主がわたしに油を注いで、貧しい者に福音を宣べ伝えることをゆだね、わたしをつかわして心のいためる者をいやし、捕われ人に放免を告げ、縛られている者に解放を告げ、"},{"ref":"Isa.61.2","start":23061002,"end":23061002,"break":"line","breaks":[[7,"line"],[25,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"めぐ"],[5,1,"とし"],[12,1,"かみ"],[14,2,"ほうふく"],[17,1,"ひ"],[20,1,"つ"],[32,1,"かな"],[35,1,"もの"],[37,1,"なぐさ"]],"text":"主の恵みの年とわれわれの神の報復の日とを告げさせ、また、すべての悲しむ者を慰め、"},{"ref":"Isa.61.3","start":23061003,"end":23061003,"break":"line","breaks":[[17,"line"],[27,"line"],[42,"line"],[51,"line"],[68,"line"],[89,"line"],[103,"line"]],"ruby":[[4,1,"なか"],[6,1,"かな"],[9,1,"もの"],[11,1,"よろこ"],[14,1,"あた"],[17,1,"はい"],[22,1,"かんむり"],[24,1,"あた"],[27,1,"かな"],[34,1,"よろこ"],[37,1,"あぶら"],[39,1,"あた"],[42,1,"うれ"],[45,1,"こころ"],[55,1,"ころも"],[57,1,"あた"],[73,1,"かれ"],[76,1,"ぎ"],[81,1,"き"],[89,1,"しゅ"],[93,2,"えいこう"],[103,1,"う"],[108,1,"もの"]],"text":"シオンの中の悲しむ者に喜びを与え、灰にかえて冠を与え、悲しみにかえて喜びの油を与え、憂いの心にかえて、さんびの衣を与えさせるためである。こうして、彼らは義のかしの木ととなえられ、主がその栄光をあらわすために植えられた者ととなえられる。"},{"ref":"Isa.61.4","start":23061004,"end":23061004,"break":"paragraph","breaks":[[19,"line"],[33,"line"],[44,"line"]],"ruby":[[0,1,"かれ"],[8,1,"あ"],[11,1,"ところ"],[13,1,"た"],[22,1,"あ"],[28,1,"ところ"],[30,1,"おこ"],[33,1,"あ"],[36,2,"まちまち"],[39,1,"あら"],[44,2,"よよ"],[50,1,"ところ"],[52,1,"ふたた"],[54,1,"た"]],"text":"彼らはいにしえの荒れた所を建てなおし、さきに荒れすたれた所を興し、荒れた町々を新たにし、世々すたれた所を再び建てる。"},{"ref":"Isa.61.5","start":23061005,"end":23061005,"break":"line","breaks":[[19,"line"],[38,"line"]],"ruby":[[0,2,"がいこく"],[2,1,"じん"],[4,1,"た"],[13,1,"む"],[16,1,"か"],[19,3,"いほうじん"],[29,1,"はたけ"],[31,1,"たがや"],[33,1,"もの"],[42,1,"つく"],[44,1,"もの"]],"text":"外国人は立ってあなたがたの群れを飼い、異邦人はあなたがたの畑を耕す者となり、ぶどうを作る者となる。"},{"ref":"Isa.61.6","start":23061006,"end":23061006,"break":"line","breaks":[[21,"line"],[35,"line"],[47,"line"]],"ruby":[[10,1,"しゅ"],[12,2,"さいし"],[26,1,"かみ"],[28,2,"やくしゃ"],[31,1,"よ"],[40,1,"くに"],[42,1,"とみ"],[44,1,"た"],[47,1,"かれ"],[50,1,"たから"],[52,1,"え"],[54,1,"よろこ"]],"text":"しかし、あなたがたは主の祭司ととなえられ、われわれの神の役者と呼ばれ、もろもろの国の富を食べ、彼らの宝を得て喜ぶ。"},{"ref":"Isa.61.7","start":23061007,"end":23061007,"break":"line","breaks":[[19,"line"],[28,"line"],[49,"line"],[68,"line"],[76,"line"]],"ruby":[[10,1,"う"],[13,1,"はじ"],[20,1,"ばい"],[22,2,"たまもの"],[25,1,"う"],[40,1,"し"],[41,1,"ぎょう"],[43,1,"え"],[45,1,"たの"],[62,1,"ち"],[69,1,"ばい"],[71,2,"たまもの"],[74,1,"え"],[81,1,"よろこ"],[84,1,"え"]],"text":"あなたがたは、さきに受けた恥にかえて、二倍の賜物を受け、はずかしめにかえて、その嗣業を得て楽しむ。それゆえ、あなたがたはその地にあって、二倍の賜物を獲、とこしえの喜びを得る。"},{"ref":"Isa.61.8","start":23061008,"end":23061008,"break":"line","breaks":[[13,"line"],[22,"line"],[37,"line"]],"ruby":[[0,1,"しゅ"],[7,2,"こうへい"],[10,1,"あい"],[13,2,"ごうだつ"],[16,2,"じゃあく"],[19,1,"にく"],[22,2,"しんじつ"],[28,1,"かれ"],[31,1,"むく"],[34,1,"あた"],[37,1,"かれ"],[46,2,"けいやく"],[49,1,"むす"]],"text":"主なるわたしは公平を愛し、強奪と邪悪を憎み、真実をもって彼らに報いを与え、彼らと、とこしえの契約を結ぶからである。"},{"ref":"Isa.61.9","start":23061009,"end":23061009,"break":"line","breaks":[[20,"line"],[41,"line"],[51,"line"]],"ruby":[[0,1,"かれ"],[3,2,"しそん"],[12,1,"くに"],[14,1,"なか"],[16,1,"し"],[20,1,"かれ"],[23,1,"こ"],[32,1,"たみ"],[34,1,"なか"],[36,1,"し"],[47,1,"み"],[49,1,"もの"],[54,1,"しゅ"],[56,2,"しゅくふく"],[61,1,"たみ"],[68,1,"みと"]],"text":"彼らの子孫は、もろもろの国の中で知られ、彼らの子らは、もろもろの民の中に知られる。すべてこれを見る者はこれが主の祝福された民であることを認める。"},{"ref":"Isa.61.10","start":23061010,"end":23061010,"break":"paragraph","breaks":[[12,"line"],[24,"line"],[37,"line"],[48,"line"],[58,"line"]],"ruby":[[4,1,"しゅ"],[6,1,"おお"],[9,1,"よろこ"],[14,1,"たましい"],[18,1,"かみ"],[20,1,"たの"],[24,1,"しゅ"],[30,1,"すくい"],[32,1,"ころも"],[34,1,"き"],[37,1,"ぎ"],[39,2,"うわぎ"],[48,2,"はなむこ"],[51,1,"かんむり"],[58,2,"はなよめ"],[61,2,"ほうぎょく"],[67,1,"かざ"]],"text":"わたしは主を大いに喜び、わが魂はわが神を楽しむ。主がわたしに救の衣を着せ、義の上衣をまとわせて、花婿が冠をいただき、花嫁が宝玉をもって飾るようにされたからである。"},{"ref":"Isa.61.11","start":23061011,"end":23061011,"break":"line","breaks":[[23,"line"],[34,"line"]],"ruby":[[0,1,"ち"],[2,1,"め"],[8,1,"その"],[16,1,"は"],[23,1,"しゅ"],[26,1,"かみ"],[28,1,"ぎ"],[30,1,"ほまれ"],[39,1,"くに"],[41,1,"まえ"],[44,1,"は"]],"text":"地が芽をいだし、園がまいたものを生やすように、主なる神は義と誉とを、もろもろの国の前に、生やされる。"}]