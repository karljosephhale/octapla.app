[{"ref":"1Chr.26.1","start":13026001,"end":13026001,"break":"paragraph","ruby":[[0,1,"もん"],[2,1,"まも"],[4,1,"もの"],[6,1,"くみ"],[8,1,"つぎ"],[35,2,"しそん"],[44,1,"こ"]],"text":"門を守る者の組は次のとおりである。すなわちコラびとのうちでは、アサフの子孫のうちのコレの子メシレミヤ。"},{"ref":"1Chr.26.2","start":13026002,"end":13026002,"break":"none","ruby":[[6,1,"こ"],[11,2,"ちょうし"],[19,1,"つぎ"],[27,1,"だい"],[35,1,"だい"]],"text":"メシレミヤの子たちは、長子はゼカリヤ、次はエデアエル、第三はゼバデヤ、第四はヤテニエル、"},{"ref":"1Chr.26.3","start":13026003,"end":13026003,"break":"none","ruby":[[0,1,"だい"],[7,1,"だい"],[15,1,"だい"]],"text":"第五はエラム、第六はヨハナン、第七はエリヨエナイである。"},{"ref":"1Chr.26.4","start":13026004,"end":13026004,"break":"none","ruby":[[8,1,"こ"],[13,2,"ちょうし"],[20,1,"つぎ"],[27,1,"だい"],[33,1,"だい"],[40,1,"だい"]],"text":"オベデ・エドムの子たちは、長子はシマヤ、次はヨザバデ、第三はヨア、第四はサカル、第五はネタネル、"},{"ref":"1Chr.26.5","start":13026005,"end":13026005,"break":"none","ruby":[[0,1,"だい"],[9,1,"だい"],[18,1,"だい"],[30,1,"かみ"],[32,1,"かれ"],[34,2,"しゅくふく"]],"text":"第六はアンミエル、第七はイッサカル、第八はピウレタイである。神が彼を祝福されたからである。"},{"ref":"1Chr.26.6","start":13026006,"end":13026006,"break":"none","ruby":[[0,1,"かれ"],[2,1,"こ"],[8,2,"すうにん"],[11,1,"こ"],[13,1,"うま"],[16,2,"ゆうのう"],[19,2,"ひとびと"],[30,1,"ちち"],[32,1,"いえ"],[34,1,"おさ"],[37,1,"もの"]],"text":"彼の子シマヤにも数人の子が生れ、有能な人々であったので、その父の家を治める者となった。"},{"ref":"1Chr.26.7","start":13026007,"end":13026007,"break":"none","ruby":[[8,1,"こ"],[38,2,"きょうだい"],[49,1,"ちから"],[52,2,"ひとびと"]],"text":"すなわちシマヤの子たちはオテニ、レパエル、オベデ、エルザバデで、エルザバデの兄弟エリウとセマキヤは力ある人々であった。"},{"ref":"1Chr.26.8","start":13026008,"end":13026008,"break":"none","ruby":[[4,1,"みな"],[13,2,"しそん"],[19,1,"かれ"],[24,1,"こ"],[32,2,"きょうだい"],[37,1,"とも"],[41,1,"つと"],[44,1,"てき"],[47,1,"ちから"],[50,2,"ひとびと"],[54,1,"あ"],[61,1,"にん"],[73,1,"ぞく"],[76,1,"もの"]],"text":"これらは皆オベデ・エドムの子孫である。彼らはその子たちおよびその兄弟たちと共にその勤めに適した力ある人々で、合わせて六十二人、みなオベデ・エドムに属する者である。"},{"ref":"1Chr.26.9","start":13026009,"end":13026009,"break":"none","ruby":[[7,1,"こ"],[11,2,"きょうだい"],[15,1,"あ"],[21,1,"にん"],[26,1,"みな"],[27,1,"ちから"],[30,2,"ひとびと"]],"text":"メシレミヤにも子たちと兄弟たち合わせて十八人あって、皆力ある人々であった。"},{"ref":"1Chr.26.10","start":13026010,"end":13026010,"break":"none","ruby":[[4,2,"しそん"],[10,1,"こ"],[31,2,"ちょうし"],[41,1,"ちち"]],"text":"メラリの子孫ホサにも子たちがあった。そのかしらはシムリ、これは長子ではなかったが、父はこれをかしらにしたのであった。"},{"ref":"1Chr.26.11","start":13026011,"end":13026011,"break":"none","ruby":[[0,1,"つぎ"],[7,1,"だい"],[15,1,"だい"],[29,1,"こ"],[33,2,"きょうだい"],[38,1,"あ"],[44,1,"にん"]],"text":"次はヒルキヤ、第三はテバリヤ、第四はゼカリヤである。ホサの子たちと兄弟たちは合わせて十三人である。"},{"ref":"1Chr.26.12","start":13026012,"end":13026012,"break":"paragraph","ruby":[[4,1,"もん"],[6,1,"まも"],[8,1,"もの"],[10,1,"くみ"],[12,1,"ちょう"],[15,2,"ひとびと"],[24,2,"きょうだい"],[29,2,"どうよう"],[32,1,"つとめ"],[38,1,"しゅ"],[40,1,"みや"],[42,1,"つか"]],"text":"これらは門を守る者の組の長たる人々であって、その兄弟たちと同様に務をなして、主の宮に仕えた。"},{"ref":"1Chr.26.13","start":13026013,"end":13026013,"break":"none","ruby":[[0,1,"かれ"],[7,1,"もん"],[12,1,"しょう"],[15,1,"もの"],[18,1,"だい"],[21,1,"もの"],[23,1,"ひと"],[29,2,"しぞく"],[40,1,"ひ"]],"text":"彼らはそれぞれ門のために小なる者も、大なる者も等しく、その氏族にしたがってくじを引いた。"},{"ref":"1Chr.26.14","start":13026014,"end":13026014,"break":"none","ruby":[[0,1,"ひがし"],[2,1,"もん"],[12,1,"あた"],[18,1,"かれ"],[20,1,"こ"],[22,2,"しりょ"],[24,1,"ふか"],[26,1,"ぎ"],[27,1,"し"],[39,1,"ひ"],[44,1,"きた"],[46,1,"もん"],[54,1,"あた"]],"text":"東の門のくじはシレミヤに当った。また彼の子で思慮深い議士ゼカリヤのためにくじを引いたが、北の門のくじがこれに当った。"},{"ref":"1Chr.26.15","start":13026015,"end":13026015,"break":"none","ruby":[[9,1,"みなみ"],[11,1,"もん"],[18,1,"こ"],[23,1,"くら"]],"text":"オベデ・エドムには南の門のくじ、その子たちには倉のくじ、"},{"ref":"1Chr.26.16","start":13026016,"end":13026016,"break":"none","ruby":[[9,1,"にし"],[11,1,"もん"],[16,1,"あた"],[23,1,"さか"],[25,2,"おおじ"],[36,1,"もん"],[47,1,"まも"],[49,1,"もの"],[51,1,"まも"],[53,1,"もの"],[56,2,"あいたい"]],"text":"シュパムとホサには西の門のくじが当った。これは坂の大路にあるシャレケテの門のかたわらにあった。守る者と守る者とが相対していた。"},{"ref":"1Chr.26.17","start":13026017,"end":13026017,"break":"none","ruby":[[0,1,"ひがし"],[2,1,"ほう"],[5,2,"まいにち"],[8,1,"にん"],[10,1,"きた"],[12,1,"ほう"],[15,2,"まいにち"],[18,1,"にん"],[20,1,"みなみ"],[22,1,"ほう"],[25,2,"まいにち"],[28,1,"にん"],[30,1,"くら"],[34,1,"にん"],[37,1,"にん"]],"text":"東の方には毎日六人、北の方には毎日四人、南の方には毎日四人、倉には二人と二人、"},{"ref":"1Chr.26.18","start":13026018,"end":13026018,"break":"none","ruby":[[0,1,"にし"],[2,1,"ほう"],[9,2,"おおじ"],[13,1,"にん"],[21,1,"にん"]],"text":"西の方パルバルには大路に四人、パルバルに二人。"},{"ref":"1Chr.26.19","start":13026019,"end":13026019,"break":"none","ruby":[[0,1,"もん"],[2,1,"まも"],[4,1,"もの"],[6,1,"くみ"],[8,2,"いじょう"],[19,2,"しそん"],[26,2,"しそん"]],"text":"門を守る者の組は以上のとおりで、コラの子孫とメラリの子孫であった。"},{"ref":"1Chr.26.20","start":13026020,"end":13026020,"break":"paragraph","ruby":[[11,1,"かみ"],[13,1,"みや"],[15,1,"くら"],[19,1,"せい"],[22,1,"もの"],[24,1,"くら"]],"text":"レビびとのうちアヒヤは神の宮の倉および聖なる物の倉をつかさどった。"},{"ref":"1Chr.26.21","start":13026021,"end":13026021,"break":"none","ruby":[[4,2,"しそん"],[15,1,"で"],[25,2,"しそん"],[37,2,"しぞく"],[40,1,"ちょう"]],"text":"ラダンの子孫すなわちラダンから出たゲルションびとの子孫で、ゲルションびとの氏族の長はエヒエリである。"},{"ref":"1Chr.26.22","start":13026022,"end":13026022,"break":"paragraph","ruby":[[13,2,"きょうだい"],[19,1,"こ"],[23,1,"しゅ"],[25,1,"みや"],[27,1,"くら"]],"text":"エヒエリ、ゼタムおよびその兄弟ヨエルの子たちは主の宮の倉をつかさどった。"},{"ref":"1Chr.26.23","start":13026023,"end":13026023,"break":"none","ruby":[[32,1,"つぎ"]],"text":"アムラムびと、イヅハルびと、ヘブロンびと、ウジエルびとのうちでは次のとおりであった。"},{"ref":"1Chr.26.24","start":13026024,"end":13026024,"break":"none","ruby":[[8,1,"こ"],[15,1,"こ"],[21,1,"くら"]],"text":"すなわちモーセの子ゲルショムの子シブエルは倉のつかさであった。"},{"ref":"1Chr.26.25","start":13026025,"end":13026025,"break":"none","ruby":[[2,2,"きょうだい"],[12,1,"で"],[14,1,"もの"],[19,1,"こ"],[28,1,"こ"],[36,1,"こ"],[44,1,"こ"],[52,1,"こ"]],"text":"その兄弟でエリエゼルから出た者は、その子はレハビヤ、その子はエサヤ、その子はヨラム、その子はジクリ、その子はシロミテである。"},{"ref":"1Chr.26.26","start":13026026,"end":13026026,"break":"none","ruby":[[9,2,"きょうだい"],[18,1,"せい"],[21,1,"もの"],[23,1,"くら"],[38,1,"おう"],[41,2,"しぞく"],[44,1,"ちょう"],[48,1,"にん"],[50,1,"ちょう"],[54,1,"にん"],[56,1,"ちょう"],[59,1,"ぐん"],[61,1,"ちょう"]],"text":"このシロミテとその兄弟たちはすべての聖なる物の倉をつかさどった。これはダビデ王と、氏族の長と、千人の長と、百人の長と、軍の長たちのささげたものである。"},{"ref":"1Chr.26.27","start":13026027,"end":13026027,"break":"none","ruby":[[4,1,"かれ"],[7,1,"たたか"],[10,1,"え"],[16,1,"もの"],[22,1,"しゅ"],[24,1,"みや"],[26,2,"しゅうぜん"]],"text":"すなわち彼らが戦いで獲たぶんどり物のうちから主の宮の修繕のためにささげたものである。"},{"ref":"1Chr.26.28","start":13026028,"end":13026028,"break":"none","ruby":[[5,3,"せんけんしゃ"],[16,1,"こ"],[24,1,"こ"],[34,1,"こ"],[45,1,"もの"],[57,1,"もの"],[66,2,"きょうだい"],[71,2,"かんり"]],"text":"またすべて先見者サムエル、キシの子サウル、ネルの子アブネル、ゼルヤの子ヨアブなどがささげた物。すべてこれらのささげ物はシロミテとその兄弟たちが管理した。"},{"ref":"1Chr.26.29","start":13026029,"end":13026029,"break":"paragraph","ruby":[[19,1,"こ"],[44,2,"がいじ"],[50,1,"えら"]],"text":"イヅハルびとのうちでは、ケナニヤとその子たちが、つかさおよびさばきびととしてイスラエルの外事のために選ばれた。"},{"ref":"1Chr.26.30","start":13026030,"end":13026030,"break":"none","ruby":[[22,2,"きょうだい"],[26,2,"ゆうし"],[31,1,"にん"],[50,1,"にし"],[52,1,"ほう"],[60,2,"かんとく"],[66,1,"しゅ"],[72,1,"こと"],[74,1,"おこな"],[77,1,"おう"],[79,2,"ほうし"]],"text":"ヘブロンびとのうちでは、ハシャビヤおよびその兄弟など勇士千七百人があって、ヨルダンのこなた、すなわち西の方でイスラエルの監督となり、主のすべての事を行い、王に奉仕した。"},{"ref":"1Chr.26.31","start":13026031,"end":13026031,"break":"none","ruby":[[12,2,"けいず"],[15,2,"しぞく"],[32,1,"ちょう"],[43,2,"ちせい"],[46,1,"だい"],[49,1,"ねん"],[51,1,"かれ"],[54,1,"たず"],[56,1,"もと"],[68,1,"かれ"],[75,1,"だい"],[76,2,"ゆうし"],[79,1,"え"]],"text":"ヘブロンびとのうちでは、系図と氏族によってエリヤがヘブロンびとの長であったが、ダビデの治世の第四十年に彼らを尋ね求め、ギレアデのヤゼルで彼らのうちから大勇士を得た。"},{"ref":"1Chr.26.32","start":13026032,"end":13026032,"break":"none","ruby":[[3,1,"おう"],[5,1,"かれ"],[9,2,"きょうだい"],[13,2,"しぞく"],[16,1,"ちょう"],[23,1,"にん"],[25,2,"ゆうし"],[45,1,"はん"],[46,2,"ぶぞく"],[49,2,"かんとく"],[58,1,"かみ"],[63,1,"こと"],[65,1,"おう"],[67,1,"こと"]],"text":"ダビデ王は彼とその兄弟など氏族の長たち二千七百人の勇士をルベンびと、ガドびと、マナセびとの半部族の監督となし、すべて神につける事と王の事とをつかさどらせた。"}]