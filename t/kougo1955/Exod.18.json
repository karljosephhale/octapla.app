[{"ref":"Exod.18.1","start":2018001,"end":2018001,"break":"paragraph","ruby":[[17,2,"さいし"],[24,1,"かみ"],[32,1,"たみ"],[47,1,"こと"],[49,1,"しゅ"],[63,1,"みちび"],[65,1,"だ"],[72,1,"き"]],"text":"さて、モーセのしゅうと、ミデアンの祭司エテロは、神がモーセと、み民イスラエルとにされたすべての事、主がイスラエルをエジプトから導き出されたことを聞いた。"},{"ref":"Exod.18.2","start":2018002,"end":2018002,"break":"none","ruby":[[20,1,"おく"],[22,1,"かえ"],[32,1,"つま"]],"text":"それでモーセのしゅうと、エテロは、さきに送り返されていたモーセの妻チッポラと、"},{"ref":"Exod.18.3","start":2018003,"end":2018003,"break":"none","ruby":[[6,1,"こ"],[9,1,"つ"],[21,1,"な"],[43,2,"がいこく"],[46,3,"きりゅうしゃ"],[57,1,"い"]],"text":"そのふたりの子とを連れてきた。そのひとりの名はゲルショムといった。モーセが、「わたしは外国で寄留者となっている」と言ったからである。"},{"ref":"Exod.18.4","start":2018004,"end":2018004,"break":"none","ruby":[[7,1,"な"],[24,1,"ちち"],[26,1,"かみ"],[32,1,"たす"],[51,1,"すく"],[57,1,"い"]],"text":"ほかのひとりの名はエリエゼルといった。「わたしの父の神はわたしの助けであって、パロのつるぎからわたしを救われた」と言ったからである。"},{"ref":"Exod.18.5","start":2018005,"end":2018005,"break":"none","ruby":[[22,2,"さいし"],[25,1,"ともな"],[29,2,"あらの"],[32,1,"い"],[35,1,"かみ"],[37,1,"やま"],[39,2,"しゅくえい"],[49,1,"ところ"]],"text":"こうしてモーセのしゅうと、エテロは、モーセの妻子を伴って、荒野に行き、神の山に宿営しているモーセの所にきた。"},{"ref":"Exod.18.6","start":2018006,"end":2018006,"break":"none","ruby":[[2,1,"とき"],[6,1,"ひと"],[12,1,"い"],[42,1,"つま"],[50,1,"こ"],[52,1,"つ"],[60,1,"ところ"]],"text":"その時、ある人がモーセに言った、「ごらんなさい。あなたのしゅうと、エテロは、あなたの妻とそのふたりの子を連れて、あなたの所にこられます」。"},{"ref":"Exod.18.7","start":2018007,"end":2018007,"break":"none","ruby":[[12,2,"でむか"],[17,1,"み"],[23,1,"かれ"],[25,1,"くち"],[31,1,"たがい"],[33,2,"あんぴ"],[36,1,"と"],[39,1,"とも"],[41,2,"てんまく"]],"text":"そこでモーセはしゅうとを出迎えて、身をかがめ、彼に口づけして、互に安否を問い、共に天幕にはいった。"},{"ref":"Exod.18.8","start":2018008,"end":2018008,"break":"none","ruby":[[8,1,"しゅ"],[38,1,"こと"],[40,1,"みち"],[42,2,"であ"],[50,1,"くる"],[56,1,"しゅ"],[58,1,"かれ"],[61,1,"すく"],[74,2,"ものがた"]],"text":"そしてモーセは、主がイスラエルのために、パロとエジプトびととにされたすべての事、道で出会ったすべての苦しみ、また主が彼らを救われたことを、しゅうとに物語ったので、"},{"ref":"Exod.18.9","start":2018009,"end":2018009,"break":"none","ruby":[[4,1,"しゅ"],[19,1,"て"],[22,1,"すく"],[24,1,"だ"],[33,1,"めぐ"],[36,1,"たま"],[43,1,"よろこ"]],"text":"エテロは主がイスラエルをエジプトびとの手から救い出して、もろもろの恵みを賜わったことを喜んだ。"},{"ref":"Exod.18.10","start":2018010,"end":2018010,"break":"paragraph","ruby":[[7,1,"い"],[12,1,"しゅ"],[21,1,"しゅ"],[36,1,"て"],[42,1,"て"],[45,1,"すく"],[47,1,"だ"],[50,1,"たみ"],[59,1,"て"],[61,1,"した"],[64,1,"すく"],[66,1,"だ"]],"text":"そしてエテロは言った、「主はほむべきかな。主はあなたがたをエジプトびとの手と、パロの手から救い出し、民をエジプトびとの手の下から救い出された。"},{"ref":"Exod.18.11","start":2018011,"end":2018011,"break":"none","ruby":[[0,1,"いま"],[7,1,"し"],[11,1,"じつ"],[13,1,"かれ"],[28,2,"こうまん"],[38,1,"しゅ"],[44,2,"かみがみ"],[51,1,"おお"]],"text":"今こそわたしは知った。実に彼らはイスラエルびとにむかって高慢にふるまったが、主はあらゆる神々にまさって大いにいますことを」。"},{"ref":"Exod.18.12","start":2018012,"end":2018012,"break":"none","ruby":[[15,2,"はんさい"],[18,2,"ぎせい"],[21,1,"かみ"],[23,1,"そな"],[36,2,"ちょうろう"],[55,1,"とも"],[57,1,"かみ"],[59,1,"まえ"],[61,2,"しょくじ"]],"text":"そしてモーセのしゅうとエテロは燔祭と犠牲を神に供え、アロンとイスラエルの長老たちもみなきて、モーセのしゅうとと共に神の前で食事をした。"},{"ref":"Exod.18.13","start":2018013,"end":2018013,"break":"paragraph","ruby":[[3,1,"ひ"],[8,1,"ざ"],[11,1,"たみ"],[19,1,"たみ"],[21,1,"あさ"],[24,1,"ばん"],[36,1,"た"]],"text":"あくる日モーセは座して民をさばいたが、民は朝から晩まで、モーセのまわりに立っていた。"},{"ref":"Exod.18.14","start":2018014,"end":2018014,"break":"none","ruby":[[10,1,"かれ"],[15,1,"たみ"],[24,1,"み"],[27,1,"い"],[36,1,"たみ"],[60,1,"ざ"],[63,1,"たみ"],[67,1,"あさ"],[70,1,"ばん"],[82,1,"た"]],"text":"モーセのしゅうとは、彼がすべて民にしていることを見て、言った、「あなたが民にしているこのことはなんですか。あなたひとりが座し、民はみな朝から晩まで、あなたのまわりに立っているのはなぜですか」。"},{"ref":"Exod.18.15","start":2018015,"end":2018015,"break":"none","ruby":[[9,1,"い"],[14,1,"たみ"],[16,1,"かみ"],[18,1,"うかが"],[29,1,"ところ"],[31,1,"く"]],"text":"モーセはしゅうとに言った、「民が神に伺おうとして、わたしの所に来るからです。"},{"ref":"Exod.18.16","start":2018016,"end":2018016,"break":"none","ruby":[[0,1,"かれ"],[3,1,"こと"],[13,1,"ところ"],[23,2,"そうご"],[26,1,"あいだ"],[33,1,"かみ"],[35,1,"さだ"],[38,2,"はんけつ"],[41,1,"し"]],"text":"彼らは事があれば、わたしの所にきます。わたしは相互の間をさばいて、神の定めと判決を知らせるのです」。"},{"ref":"Exod.18.17","start":2018017,"end":2018017,"break":"none","ruby":[[9,1,"かれ"],[11,1,"い"],[27,1,"よ"]],"text":"モーセのしゅうとは彼に言った、「あなたのしていることは良くない。"},{"ref":"Exod.18.18","start":2018018,"end":2018018,"break":"none","ruby":[[9,2,"いっしょ"],[16,1,"たみ"],[19,1,"かなら"],[21,1,"つか"],[23,1,"は"],[40,1,"おも"],[41,1,"す"]],"text":"あなたも、あなたと一緒にいるこの民も、必ず疲れ果てるであろう。このことはあなたに重過ぎるから、ひとりですることができない。"},{"ref":"Exod.18.19","start":2018019,"end":2018019,"break":"none","ruby":[[0,1,"いま"],[5,1,"い"],[10,1,"き"],[24,2,"じょげん"],[32,1,"かみ"],[38,1,"とも"],[51,1,"たみ"],[56,1,"かみ"],[58,1,"まえ"],[63,2,"じけん"],[66,1,"かみ"],[68,1,"の"]],"text":"今わたしの言うことを聞きなさい。わたしはあなたに助言する。どうか神があなたと共にいますように。あなたは民のために神の前にいて、事件を神に述べなさい。"},{"ref":"Exod.18.20","start":2018020,"end":2018020,"break":"none","ruby":[[4,1,"かれ"],[7,1,"さだ"],[10,2,"はんけつ"],[13,1,"おし"],[16,1,"かれ"],[19,1,"あゆ"],[23,1,"みち"],[30,1,"こと"],[32,1,"かれ"],[35,1,"し"]],"text":"あなたは彼らに定めと判決を教え、彼らの歩むべき道と、なすべき事を彼らに知らせなさい。"},{"ref":"Exod.18.21","start":2018021,"end":2018021,"break":"none","ruby":[[7,1,"たみ"],[14,2,"ゆうのう"],[17,1,"ひと"],[20,1,"かみ"],[22,1,"おそ"],[25,2,"せいじつ"],[28,2,"ふぎ"],[31,1,"り"],[33,1,"にく"],[35,1,"ひと"],[37,1,"えら"],[43,1,"たみ"],[45,1,"うえ"],[47,1,"た"],[52,1,"にん"],[54,1,"ちょう"],[57,1,"にん"],[59,1,"ちょう"],[63,1,"にん"],[65,1,"ちょう"],[68,1,"にん"],[70,1,"ちょう"]],"text":"また、すべての民のうちから、有能な人で、神を恐れ、誠実で不義の利を憎む人を選び、それを民の上に立てて、千人の長、百人の長、五十人の長、十人の長としなさい。"},{"ref":"Exod.18.22","start":2018022,"end":2018022,"break":"none","ruby":[[0,2,"へいそ"],[3,1,"かれ"],[6,1,"たみ"],[13,2,"だいじ"],[24,1,"ところ"],[26,1,"も"],[33,1,"しょう"],[34,2,"じけん"],[40,1,"かれ"],[59,2,"みがる"],[68,1,"とも"],[70,1,"かれ"],[74,1,"に"],[76,1,"お"]],"text":"平素は彼らに民をさばかせ、大事件はすべてあなたの所に持ってこさせ、小事件はすべて彼らにさばかせなさい。こうしてあなたを身軽にし、あなたと共に彼らに、荷を負わせなさい。"},{"ref":"Exod.18.23","start":2018023,"end":2018023,"break":"none","ruby":[[9,1,"こと"],[11,1,"おこな"],[14,1,"かみ"],[22,1,"めい"],[35,1,"た"],[46,1,"たみ"],[53,1,"やす"],[59,1,"ところ"],[61,1,"かえ"]],"text":"あなたが、もしこの事を行い、神もまたあなたに命じられるならば、あなたは耐えることができ、この民もまた、みな安んじてその所に帰ることができよう」。"},{"ref":"Exod.18.24","start":2018024,"end":2018024,"break":"paragraph","ruby":[[9,2,"ことば"],[12,1,"したが"],[18,1,"い"]],"text":"モーセはしゅうとの言葉に従い、すべて言われたようにした。"},{"ref":"Exod.18.25","start":2018025,"end":2018025,"break":"none","ruby":[[23,2,"ゆうのう"],[26,1,"ひと"],[28,1,"えら"],[32,1,"たみ"],[34,1,"うえ"],[36,1,"ちょう"],[40,1,"た"],[44,1,"にん"],[46,1,"ちょう"],[49,1,"にん"],[51,1,"ちょう"],[55,1,"にん"],[57,1,"ちょう"],[60,1,"にん"],[62,1,"ちょう"]],"text":"すなわち、モーセはすべてのイスラエルのうちから有能な人を選んで、民の上に長として立て、千人の長、百人の長、五十人の長、十人の長とした。"},{"ref":"Exod.18.26","start":2018026,"end":2018026,"break":"none","ruby":[[0,2,"へいそ"],[3,1,"かれ"],[6,1,"たみ"],[17,2,"じけん"],[24,1,"も"],[31,1,"ちい"],[34,2,"じけん"],[40,1,"かれ"]],"text":"平素は彼らが民をさばき、むずかしい事件はモーセに持ってきたが、小さい事件はすべて彼らみずからさばいた。"},{"ref":"Exod.18.27","start":2018027,"end":2018027,"break":"none","ruby":[[13,1,"おく"],[15,1,"かえ"],[23,1,"くに"],[25,1,"かえ"],[28,1,"い"]],"text":"こうしてモーセはしゅうとを送り返したので、その国に帰って行った。"}]