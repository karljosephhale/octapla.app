[{"ref":"Ps.66.1","start":19066001,"end":19066001,"break":"paragraph","title":"聖歌隊の指揮者によってうたわせた歌、さんび","ruby":[[0,1,"ぜん"],[1,1,"ち"],[4,1,"かみ"],[10,1,"よろこ"],[12,1,"よ"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[16,1,"うた"]],"text":"全地よ、神にむかって喜び呼ばわれ。"},{"ref":"Ps.66.2","start":19066002,"end":19066002,"break":"line","breaks":[[11,"line"]],"ruby":[[3,1,"な"],[5,2,"えいこう"],[8,1,"うた"],[11,1,"さか"]],"text":"そのみ名の栄光を歌え。栄えあるさんびをささげよ。"},{"ref":"Ps.66.3","start":19066003,"end":19066003,"break":"line","breaks":[[6,"line"],[27,"line"]],"ruby":[[0,1,"かみ"],[2,1,"つ"],[20,1,"おそ"],[27,1,"おお"],[32,1,"ちから"],[42,1,"てき"],[45,1,"まえ"],[47,2,"くっぷく"]],"text":"神に告げよ。「あなたのもろもろのみわざは恐るべきかな。大いなるみ力によって、あなたの敵はみ前に屈服し、"},{"ref":"Ps.66.4","start":19066004,"end":19066004,"break":"line","breaks":[[20,"line"]],"ruby":[[0,1,"ぜん"],[1,1,"ち"],[7,1,"おが"],[21,1,"な"]],"text":"全地はあなたを拝み、あなたをほめうたい、み名をほめうたうであろう」と。〔セラ"},{"ref":"Ps.66.5","start":19066005,"end":19066005,"break":"line","breaks":[[12,"line"]],"ruby":[[0,1,"き"],[3,1,"かみ"],[9,1,"み"],[12,1,"ひと"],[14,1,"こ"],[28,1,"おそ"]],"text":"来て、神のみわざを見よ。人の子らにむかってなされることは恐るべきかな。"},{"ref":"Ps.66.6","start":19066006,"end":19066006,"break":"line","breaks":[[18,"line"],[30,"line"]],"ruby":[[0,1,"かみ"],[2,1,"うみ"],[4,1,"か"],[12,1,"ち"],[18,2,"ひとびと"],[21,2,"とほ"],[24,1,"かわ"],[26,1,"わた"],[32,1,"ところ"],[38,1,"かみ"],[40,1,"よろこ"]],"text":"神は海を変えて、かわいた地とされた。人々は徒歩で川を渡った。その所でわれらは神を喜んだ。"},{"ref":"Ps.66.7","start":19066007,"end":19066007,"break":"line","breaks":[[19,"line"],[37,"line"]],"ruby":[[0,1,"かみ"],[2,2,"たいのう"],[14,1,"す"],[16,1,"おさ"],[21,1,"め"],[28,2,"くにたみ"],[31,2,"かんし"],[40,1,"もの"],[47,1,"たか"]],"text":"神は大能をもって、とこしえに統べ治め、その目はもろもろの国民を監視される。そむく者はみずからを高くしてはならない。〔セラ"},{"ref":"Ps.66.8","start":19066008,"end":19066008,"break":"line","breaks":[[18,"line"]],"ruby":[[5,1,"たみ"],[12,1,"かみ"],[18,1,"かみ"],[26,1,"こえ"],[28,1,"きこ"]],"text":"もろもろの民よ、われらの神をほめよ。神をほめたたえる声を聞えさせよ。"},{"ref":"Ps.66.9","start":19066009,"end":19066009,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"かみ"],[6,1,"い"],[19,1,"あし"]],"text":"神はわれらを生きながらえさせ、われらの足のすべるのをゆるされない。"},{"ref":"Ps.66.10","start":19066010,"end":19066010,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"かみ"],[11,1,"こころ"],[19,1,"ね"],[29,1,"ね"]],"text":"神よ、あなたはわれらを試み、しろがねを練るように、われらを練られた。"},{"ref":"Ps.66.11","start":19066011,"end":19066011,"break":"line","breaks":[[15,"line"]],"ruby":[[8,1,"あみ"],[19,1,"こし"],[21,1,"おも"],[23,1,"に"],[25,1,"お"]],"text":"あなたはわれらを網にひきいれ、われらの腰に重き荷を置き、"},{"ref":"Ps.66.12","start":19066012,"end":19066012,"break":"line","breaks":[[21,"line"],[37,"line"]],"ruby":[[0,2,"ひとびと"],[7,1,"あたま"],[9,1,"うえ"],[11,1,"の"],[13,1,"こ"],[25,1,"ひ"],[27,1,"なか"],[29,1,"みず"],[31,1,"なか"],[33,1,"とお"],[48,1,"ひろ"],[50,1,"ところ"],[52,1,"みちび"],[54,1,"だ"]],"text":"人々にわれらの頭の上を乗り越えさせられた。われらは火の中、水の中を通った。しかしあなたはわれらを広い所に導き出された。"},{"ref":"Ps.66.13","start":19066013,"end":19066013,"break":"line","breaks":[[19,"line"]],"ruby":[[4,2,"はんさい"],[14,1,"いえ"],[16,1,"い"],[23,1,"ちか"],[30,1,"はた"]],"text":"わたしは燔祭をもってあなたの家に行き、わたしの誓いをあなたに果します。"},{"ref":"Ps.66.14","start":19066014,"end":19066014,"break":"line","breaks":[[16,"line"],[33,"line"]],"ruby":[[7,1,"なや"],[25,1,"い"],[27,1,"だ"],[37,1,"くち"],[39,2,"やくそく"]],"text":"これはわたしが悩みにあったとき、わたしのくちびるの言い出したもの、わたしの口が約束したものです。"},{"ref":"Ps.66.15","start":19066015,"end":19066015,"break":"line","breaks":[[13,"line"],[33,"line"]],"ruby":[[4,1,"こ"],[10,2,"はんさい"],[13,2,"おひつじ"],[21,1,"けむり"],[23,1,"とも"],[33,2,"おうし"],[36,1,"お"]],"text":"わたしは肥えたものの燔祭を雄羊のいけにえの煙と共にあなたにささげ、雄牛と雄やぎとをささげます。〔セラ"},{"ref":"Ps.66.16","start":19066016,"end":19066016,"break":"line","breaks":[[16,"line"]],"ruby":[[3,1,"かみ"],[5,1,"おそ"],[8,1,"もの"],[11,1,"き"],[13,1,"き"],[16,1,"かみ"],[32,1,"つ"]],"text":"すべて神を恐れる者よ、来て聞け。神がわたしのためになされたことを告げよう。"},{"ref":"Ps.66.17","start":19066017,"end":19066017,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"こえ"],[9,1,"かみ"],[11,1,"よ"],[18,1,"した"],[23,1,"かみ"]],"text":"わたしは声をあげて神に呼ばわり、わが舌をもって神をあがめた。"},{"ref":"Ps.66.18","start":19066018,"end":19066018,"break":"line","breaks":[[21,"line"]],"ruby":[[6,1,"こころ"],[8,2,"ふぎ"],[21,1,"しゅ"],[24,1,"き"]],"text":"もしわたしが心に不義をいだいていたならば、主はお聞きにならないであろう。"},{"ref":"Ps.66.19","start":19066019,"end":19066019,"break":"line","breaks":[[17,"line"]],"ruby":[[8,1,"かみ"],[11,1,"き"],[19,1,"いのり"],[21,1,"こえ"]],"text":"しかし、まことに神はお聞きになり、わが祈の声にみこころをとめられた。"},{"ref":"Ps.66.20","start":19066020,"end":19066020,"break":"line","breaks":[[9,"line"],[21,"line"]],"ruby":[[0,1,"かみ"],[9,1,"かみ"],[13,1,"いのり"],[34,1,"と"],[36,1,"さ"]],"text":"神はほむべきかな。神はわが祈をしりぞけず、そのいつくしみをわたしから取り去られなかった。"}]