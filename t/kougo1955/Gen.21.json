[{"ref":"Gen.21.1","start":1021001,"end":1021001,"break":"paragraph","ruby":[[0,1,"しゅ"],[6,1,"い"],[16,1,"かえり"],[19,1,"つ"],[30,1,"おこな"]],"text":"主は、さきに言われたようにサラを顧み、告げられたようにサラに行われた。"},{"ref":"Gen.21.2","start":1021002,"end":1021002,"break":"none","ruby":[[8,1,"かみ"],[16,1,"つ"],[21,1,"とき"],[27,2,"としお"],[37,1,"おとこ"],[39,1,"こ"],[41,1,"う"]],"text":"サラはみごもり、神がアブラハムに告げられた時になって、年老いたアブラハムに男の子を産んだ。"},{"ref":"Gen.21.3","start":1021003,"end":1021003,"break":"none","ruby":[[6,1,"うま"],[9,1,"こ"],[14,1,"う"],[17,1,"おとこ"],[19,1,"こ"],[21,1,"な"],[27,1,"な"]],"text":"アブラハムは生れた子、サラが産んだ男の子の名をイサクと名づけた。"},{"ref":"Gen.21.4","start":1021004,"end":1021004,"break":"none","ruby":[[6,1,"かみ"],[8,1,"めい"],[17,1,"か"],[18,1,"め"],[22,1,"こ"],[27,2,"かつれい"],[30,1,"ほどこ"]],"text":"アブラハムは神が命じられたように八日目にその子イサクに割礼を施した。"},{"ref":"Gen.21.5","start":1021005,"end":1021005,"break":"none","ruby":[[8,1,"こ"],[13,1,"うま"],[16,1,"とき"],[18,1,"さい"]],"text":"アブラハムはその子イサクが生れた時百歳であった。"},{"ref":"Gen.21.6","start":1021006,"end":1021006,"break":"none","ruby":[[6,1,"い"],[11,1,"かみ"],[17,1,"わら"],[27,1,"き"],[29,1,"もの"],[31,1,"みな"],[39,1,"わら"]],"text":"そしてサラは言った、「神はわたしを笑わせてくださった。聞く者は皆わたしのことで笑うでしょう」。"},{"ref":"Gen.21.7","start":1021007,"end":1021007,"break":"none","ruby":[[2,1,"い"],[10,1,"こ"],[12,1,"ちち"],[14,1,"の"],[32,1,"い"],[34,1,"え"],[51,1,"かれ"],[53,1,"とし"],[60,1,"こ"],[62,1,"う"]],"text":"また言った、「サラが子に乳を飲ませるだろうと、だれがアブラハムに言い得たであろう。それなのに、わたしは彼が年とってから、子を産んだ」。"},{"ref":"Gen.21.8","start":1021008,"end":1021008,"break":"paragraph","ruby":[[8,1,"そだ"],[11,2,"ちばな"],[21,2,"ちばな"],[26,1,"ひ"],[34,1,"さか"],[42,1,"もう"]],"text":"さて、おさなごは育って乳離れした。イサクが乳離れした日にアブラハムは盛んなふるまいを設けた。"},{"ref":"Gen.21.9","start":1021009,"end":1021009,"break":"none","ruby":[[8,1,"おんな"],[19,1,"う"],[22,1,"こ"],[25,2,"じぶん"],[28,1,"こ"],[33,1,"あそ"],[37,1,"み"]],"text":"サラはエジプトの女ハガルのアブラハムに産んだ子が、自分の子イサクと遊ぶのを見て、"},{"ref":"Gen.21.10","start":1021010,"end":1021010,"break":"none","ruby":[[6,1,"い"],[20,1,"こ"],[22,1,"お"],[24,1,"だ"],[39,1,"こ"],[45,1,"こ"],[50,1,"とも"],[53,2,"よつぎ"],[60,1,"もの"]],"text":"アブラハムに言った、「このはしためとその子を追い出してください。このはしための子はわたしの子イサクと共に、世継となるべき者ではありません」。"},{"ref":"Gen.21.11","start":1021011,"end":1021011,"break":"none","ruby":[[2,1,"こと"],[13,1,"こ"],[18,2,"ひじょう"],[21,2,"しんぱい"]],"text":"この事で、アブラハムはその子のために非常に心配した。"},{"ref":"Gen.21.12","start":1021012,"end":1021012,"break":"none","ruby":[[0,1,"かみ"],[8,1,"い"],[37,2,"しんぱい"],[54,1,"い"],[62,1,"き"],[74,1,"うま"],[77,1,"もの"],[84,2,"しそん"],[87,1,"とな"]],"text":"神はアブラハムに言われた、「あのわらべのため、またあなたのはしためのために心配することはない。サラがあなたに言うことはすべて聞きいれなさい。イサクに生れる者が、あなたの子孫と唱えられるからです。"},{"ref":"Gen.21.13","start":1021013,"end":1021013,"break":"none","ruby":[[9,1,"こ"],[15,1,"こ"],[29,2,"こくみん"]],"text":"しかし、はしための子もあなたの子ですから、これをも、一つの国民とします」。"},{"ref":"Gen.21.14","start":1021014,"end":1021014,"break":"none","ruby":[[9,1,"あ"],[12,1,"あさ"],[16,1,"お"],[23,1,"みず"],[25,1,"かわ"],[26,1,"ぶくろ"],[29,1,"と"],[36,1,"あた"],[40,1,"かた"],[42,1,"お"],[48,1,"こ"],[50,1,"つ"],[53,1,"さ"],[62,1,"さ"],[71,2,"あらの"]],"text":"そこでアブラハムは明くる朝はやく起きて、パンと水の皮袋とを取り、ハガルに与えて、肩に負わせ、その子を連れて去らせた。ハガルは去ってベエルシバの荒野にさまよった。"},{"ref":"Gen.21.15","start":1021015,"end":1021015,"break":"paragraph","ruby":[[3,1,"かわ"],[4,1,"ぶくろ"],[6,1,"みず"],[8,1,"つ"],[14,2,"かのじょ"],[19,1,"こ"],[21,1,"き"],[23,1,"した"]],"text":"やがて皮袋の水が尽きたので、彼女はその子を木の下におき、"},{"ref":"Gen.21.16","start":1021016,"end":1021016,"break":"none","ruby":[[7,1,"こ"],[9,1,"し"],[13,1,"み"],[16,1,"しの"],[22,1,"い"],[26,1,"や"],[28,1,"とど"],[32,1,"はな"],[35,1,"い"],[38,2,"こども"],[41,1,"ほう"],[43,1,"む"],[51,2,"かのじょ"],[54,2,"こども"],[57,1,"ほう"],[59,1,"む"],[69,2,"こども"],[72,1,"こえ"],[77,1,"な"]],"text":"「わたしはこの子の死ぬのを見るに忍びない」と言って、矢の届くほど離れて行き、子供の方に向いてすわった。彼女が子供の方に向いてすわったとき、子供は声をあげて泣いた。"},{"ref":"Gen.21.17","start":1021017,"end":1021017,"break":"none","ruby":[[0,1,"かみ"],[6,1,"こえ"],[8,1,"き"],[12,1,"かみ"],[14,1,"つかい"],[16,1,"てん"],[23,1,"よ"],[26,1,"い"],[43,1,"おそ"],[52,1,"かみ"],[64,1,"こえ"],[66,1,"き"]],"text":"神はわらべの声を聞かれ、神の使は天からハガルを呼んで言った、「ハガルよ、どうしたのか。恐れてはいけない。神はあそこにいるわらべの声を聞かれた。"},{"ref":"Gen.21.18","start":1021018,"end":1021018,"break":"none","ruby":[[0,1,"た"],[3,1,"い"],[10,1,"と"],[12,1,"あ"],[19,1,"て"],[21,1,"だ"],[31,1,"かれ"],[33,1,"おお"],[37,2,"こくみん"]],"text":"立って行き、わらべを取り上げてあなたの手に抱きなさい。わたしは彼を大いなる国民とするであろう」。"},{"ref":"Gen.21.19","start":1021019,"end":1021019,"break":"none","ruby":[[0,1,"かみ"],[6,1,"め"],[8,1,"ひら"],[15,2,"かのじょ"],[18,1,"みず"],[20,2,"いど"],[27,1,"み"],[30,2,"かのじょ"],[33,1,"い"],[36,1,"かわ"],[37,1,"ぶくろ"],[39,1,"みず"],[41,1,"み"],[49,1,"の"]],"text":"神がハガルの目を開かれたので、彼女は水の井戸のあるのを見た。彼女は行って皮袋に水を満たし、わらべに飲ませた。"},{"ref":"Gen.21.20","start":1021020,"end":1021020,"break":"none","ruby":[[0,1,"かみ"],[6,1,"とも"],[16,2,"せいちょう"],[21,1,"かれ"],[23,2,"あらの"],[26,1,"す"],[29,1,"ゆみ"],[31,1,"い"],[33,1,"もの"]],"text":"神はわらべと共にいまし、わらべは成長した。彼は荒野に住んで弓を射る者となった。"},{"ref":"Gen.21.21","start":1021021,"end":1021021,"break":"none","ruby":[[0,1,"かれ"],[6,2,"あらの"],[9,1,"す"],[13,1,"はは"],[15,1,"かれ"],[25,1,"くに"],[28,1,"つま"],[30,1,"むか"]],"text":"彼はパランの荒野に住んだ。母は彼のためにエジプトの国から妻を迎えた。"},{"ref":"Gen.21.22","start":1021022,"end":1021022,"break":"paragraph","ruby":[[12,2,"ぐんぜい"],[15,1,"ちょう"],[26,1,"い"],[35,2,"なにごと"],[44,1,"かみ"],[50,1,"とも"]],"text":"そのころアビメレクとその軍勢の長ピコルはアブラハムに言った、「あなたが何事をなさっても、神はあなたと共におられる。"},{"ref":"Gen.21.23","start":1021023,"end":1021023,"break":"none","ruby":[[5,1,"いま"],[19,1,"こ"],[23,1,"まご"],[26,1,"あざむ"],[32,1,"かみ"],[41,1,"ちか"],[57,2,"しんせつ"],[81,2,"きりゅう"],[84,1,"ち"]],"text":"それゆえ、今ここでわたしをも、わたしの子をも、孫をも欺かないと、神をさしてわたしに誓ってください。わたしがあなたに親切にしたように、あなたもわたしと、このあなたの寄留の地とに、しなければなりません」。"},{"ref":"Gen.21.24","start":1021024,"end":1021024,"break":"none","ruby":[[6,1,"い"],[15,1,"ちか"]],"text":"アブラハムは言った、「わたしは誓います」。"},{"ref":"Gen.21.25","start":1021025,"end":1021025,"break":"paragraph","ruby":[[12,2,"けらい"],[18,1,"みず"],[20,2,"いど"],[23,1,"うば"],[25,1,"と"],[40,1,"せ"]],"text":"アブラハムはアビメレクの家来たちが、水の井戸を奪い取ったことについてアビメルクを責めた。"},{"ref":"Gen.21.26","start":1021026,"end":1021026,"break":"none","ruby":[[9,1,"い"],[19,1,"こと"],[28,1,"し"],[42,1,"つ"],[60,1,"き"]],"text":"しかしアビメレクは言った、「だれがこの事をしたかわたしは知りません。あなたもわたしに告げたことはなく、わたしもきょうまで聞きませんでした」。"},{"ref":"Gen.21.27","start":1021027,"end":1021027,"break":"none","ruby":[[9,1,"ひつじ"],[11,1,"うし"],[14,1,"と"],[23,1,"あた"],[30,2,"けいやく"],[33,1,"むす"]],"text":"そこでアブラハムは羊と牛とを取ってアビメレクに与え、ふたりは契約を結んだ。"},{"ref":"Gen.21.28","start":1021028,"end":1021028,"break":"none","ruby":[[6,1,"めす"],[8,2,"こひつじ"],[11,1,"とう"],[13,1,"わ"],[16,1,"お"]],"text":"アブラハムが雌の小羊七頭を分けて置いたところ、"},{"ref":"Gen.21.29","start":1021029,"end":1021029,"break":"none","ruby":[[12,1,"い"],[25,1,"めす"],[27,2,"こひつじ"],[30,1,"とう"],[32,1,"わ"],[35,1,"お"]],"text":"アビメレクはアブラハムに言った、「あなたがこれらの雌の小羊七頭を分けて置いたのは、なんのためですか」。"},{"ref":"Gen.21.30","start":1021030,"end":1021030,"break":"none","ruby":[[6,1,"い"],[19,1,"て"],[26,1,"めす"],[28,2,"こひつじ"],[31,1,"とう"],[33,1,"う"],[35,1,"と"],[45,2,"いど"],[48,1,"ほ"],[54,2,"しょうこ"]],"text":"アブラハムは言った、「あなたはわたしの手からこれらの雌の小羊七頭を受け取って、わたしがこの井戸を掘ったことの証拠としてください」。"},{"ref":"Gen.21.31","start":1021031,"end":1021031,"break":"none","ruby":[[8,1,"ところ"],[16,1,"な"],[21,1,"かれ"],[30,1,"ちか"]],"text":"これによってその所をベエルシバと名づけた。彼らがふたりそこで誓いをしたからである。"},{"ref":"Gen.21.32","start":1021032,"end":1021032,"break":"none","ruby":[[5,1,"かれ"],[14,2,"けいやく"],[17,1,"むす"],[28,2,"ぐんぜい"],[31,1,"ちょう"],[36,1,"た"],[44,1,"ち"],[46,1,"かえ"]],"text":"このように彼らはベエルシバで契約を結び、アビメレクとその軍勢の長ピコルは立ってペリシテの地に帰った。"},{"ref":"Gen.21.33","start":1021033,"end":1021033,"break":"none","ruby":[[13,1,"ぽん"],[21,1,"き"],[23,1,"う"],[28,1,"ところ"],[30,2,"えいえん"],[33,1,"かみ"],[35,1,"しゅ"],[37,1,"な"],[39,1,"よ"]],"text":"アブラハムはベエルシバに一本のぎょりゅうの木を植え、その所で永遠の神、主の名を呼んだ。"},{"ref":"Gen.21.34","start":1021034,"end":1021034,"break":"none","ruby":[[10,1,"なが"],[12,1,"あいだ"],[20,1,"ち"]],"text":"こうしてアブラハムは長い間ペリシテびとの地にとどまった。"}]