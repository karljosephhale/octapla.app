[{"ref":"Ps.117.1","start":19117001,"end":19117001,"break":"paragraph","breaks":[[17,"line"]],"ruby":[[5,1,"くに"],[8,1,"しゅ"],[22,1,"たみ"],[25,1,"しゅ"]],"text":"もろもろの国よ、主をほめたたえよ。もろもろの民よ、主をたたえまつれ。"},{"ref":"Ps.117.2","start":19117002,"end":19117002,"break":"line","breaks":[[24,"line"],[44,"line"]],"ruby":[[4,1,"たま"],[15,1,"おお"],[24,1,"しゅ"],[35,1,"た"],[44,1,"しゅ"]],"text":"われらに賜わるそのいつくしみは大きいからである。主のまことはとこしえに絶えることがない。主をほめたたえよ。"}]