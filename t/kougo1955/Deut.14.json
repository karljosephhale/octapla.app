[{"ref":"Deut.14.1","start":5014001,"end":5014001,"break":"paragraph","ruby":[[12,1,"かみ"],[14,1,"しゅ"],[16,2,"こども"],[22,1,"し"],[25,1,"ひと"],[30,2,"じぶん"],[33,1,"み"],[35,1,"きず"],[48,1,"ひたい"],[50,1,"かみ"]],"text":"あなたがたはあなたがたの神、主の子供である。死んだ人のために自分の身に傷をつけてはならない。また額の髪をそってはならない。"},{"ref":"Deut.14.2","start":5014002,"end":5014002,"break":"none","ruby":[[8,1,"かみ"],[10,1,"しゅ"],[12,1,"せい"],[15,1,"たみ"],[23,1,"しゅ"],[25,1,"ち"],[35,1,"たみ"],[45,1,"えら"],[49,2,"じぶん"],[52,1,"たから"],[54,1,"たみ"]],"text":"あなたはあなたの神、主の聖なる民だからである。主は地のおもてのすべての民のうちからあなたを選んで、自分の宝の民とされた。"},{"ref":"Deut.14.3","start":5014003,"end":5014003,"break":"paragraph","ruby":[[0,1,"い"],[4,1,"もの"],[14,1,"た"]],"text":"忌むべき物は、どんなものでも食べてはならない。"},{"ref":"Deut.14.4","start":5014004,"end":5014004,"break":"none","ruby":[[6,1,"た"],[15,1,"けもの"],[17,1,"つぎ"],[30,1,"うし"],[32,1,"ひつじ"]],"text":"あなたがたの食べることができる獣は次のとおりである。すなわち牛、羊、やぎ、"},{"ref":"Deut.14.5","start":5014005,"end":5014005,"break":"none","ruby":[[0,1,"お"],[13,1,"の"],[26,2,"やぎ"]],"text":"雄じか、かもしか、こじか、野やぎ、くじか、おおじか、野羊など、"},{"ref":"Deut.14.6","start":5014006,"end":5014006,"break":"none","ruby":[[0,1,"けもの"],[13,1,"わか"],[26,1,"き"],[33,2,"はんすう"],[40,1,"た"]],"text":"獣のうち、すべて、ひずめの分れたもの、ひずめが二つに切れたもので、反芻するものは食べることができる。"},{"ref":"Deut.14.7","start":5014007,"end":5014007,"break":"none","ruby":[[4,2,"はんすう"],[16,1,"わか"],[25,1,"つぎ"],[30,1,"た"],[48,1,"の"],[56,1,"いわ"],[65,2,"はんすう"],[78,1,"わか"],[86,1,"けが"]],"text":"ただし、反芻するものと、ひずめの分れたもののうち、次のものは食べてはならない。すなわち、らくだ、野うさぎ、および岩だぬき、これらは反芻するけれども、ひずめが分れていないから汚れたものである。"},{"ref":"Deut.14.8","start":5014008,"end":5014008,"break":"none","ruby":[[2,1,"ぶた"],[12,1,"わか"],[22,2,"はんすう"],[30,1,"けが"],[41,1,"にく"],[43,1,"た"],[56,2,"したい"],[59,1,"ふ"]],"text":"また豚、これは、ひずめが分れているけれども、反芻しないから、汚れたものである。その肉を食べてはならない。またその死体に触れてはならない。"},{"ref":"Deut.14.9","start":5014009,"end":5014009,"break":"paragraph","ruby":[[0,1,"みず"],[2,1,"なか"],[10,1,"もの"],[15,1,"つぎ"],[20,1,"た"],[53,1,"た"]],"text":"水の中にいるすべての物のうち、次のものは食べることができる。すなわち、すべて、ひれと、うろこのあるものは、食べることができる。"},{"ref":"Deut.14.10","start":5014010,"end":5014010,"break":"none","ruby":[[18,1,"た"],[30,1,"けが"]],"text":"すべて、ひれと、うろこのないものは、食べてはならない。これは汚れたものである。"},{"ref":"Deut.14.11","start":5014011,"end":5014011,"break":"paragraph","ruby":[[3,1,"きよ"],[5,1,"とり"],[7,1,"た"]],"text":"すべて清い鳥は食べることができる。"},{"ref":"Deut.14.12","start":5014012,"end":5014012,"break":"none","ruby":[[4,1,"つぎ"],[9,1,"た"]],"text":"ただし、次のものは食べてはならない。すなわち、はげわし、ひげはげわし、みさご、"},{"ref":"Deut.14.13","start":5014013,"end":5014013,"break":"none","ruby":[[0,1,"くろ"],[12,1,"るい"]],"text":"黒とび、はやぶさ、とびの類。"},{"ref":"Deut.14.14","start":5014014,"end":5014014,"break":"none","ruby":[[0,2,"かくしゅ"],[7,1,"るい"]],"text":"各種のからすの類。"},{"ref":"Deut.14.15","start":5014015,"end":5014015,"break":"none","ruby":[[5,1,"よる"],[16,1,"るい"]],"text":"だちょう、夜たか、かもめ、たかの類。"},{"ref":"Deut.14.16","start":5014016,"end":5014016,"break":"none","text":"ふくろう、みみずく、むらさきばん、"},{"ref":"Deut.14.17","start":5014017,"end":5014017,"break":"none","text":"ペリカン、はげたか、う、"},{"ref":"Deut.14.18","start":5014018,"end":5014018,"break":"none","ruby":[[9,1,"るい"]],"text":"こうのとり、さぎの類。やつがしら、こうもり。"},{"ref":"Deut.14.19","start":5014019,"end":5014019,"break":"none","ruby":[[5,1,"はね"],[10,1,"は"],[15,1,"けが"],[27,1,"た"]],"text":"またすべて羽があって這うものは汚れたものである。それを食べてはならない。"},{"ref":"Deut.14.20","start":5014020,"end":5014020,"break":"none","ruby":[[3,1,"つばさ"],[7,1,"きよ"],[12,1,"た"]],"text":"すべて翼のある清いものは食べることができる。"},{"ref":"Deut.14.21","start":5014021,"end":5014021,"break":"paragraph","breaks":[[92,"paragraph"]],"ruby":[[3,2,"しぜん"],[6,1,"し"],[12,1,"た"],[21,1,"まち"],[23,1,"うち"],[27,2,"きりゅう"],[30,2,"たこく"],[32,1,"じん"],[38,1,"あた"],[41,1,"た"],[58,2,"がいこく"],[60,1,"じん"],[62,1,"う"],[77,1,"かみ"],[79,1,"しゅ"],[81,1,"せい"],[84,1,"たみ"],[92,1,"こ"],[98,1,"はは"],[100,1,"ちち"],[102,1,"に"]],"text":"すべて自然に死んだものは食べてはならない。町の内におる寄留の他国人に、それを与えて食べさせることができる。またそれを外国人に売ってもよい。あなたはあなたの神、主の聖なる民だからである。子やぎをその母の乳で煮てはならない。"},{"ref":"Deut.14.22","start":5014022,"end":5014022,"break":"paragraph","ruby":[[4,2,"まいとし"],[7,1,"はたけ"],[9,1,"たね"],[14,1,"え"],[20,2,"さんぶつ"],[24,1,"ぶん"],[28,1,"かなら"],[30,1,"と"],[32,1,"わ"]],"text":"あなたは毎年、畑に種をまいて獲るすべての産物の十分の一を必ず取り分けなければならない。"},{"ref":"Deut.14.23","start":5014023,"end":5014023,"break":"none","ruby":[[7,1,"かみ"],[9,1,"しゅ"],[11,1,"まえ"],[17,1,"しゅ"],[21,1,"な"],[23,1,"お"],[28,1,"えら"],[32,2,"ばしょ"],[36,2,"こくもつ"],[43,1,"しゅ"],[46,1,"あぶら"],[50,1,"ぶん"],[55,1,"うし"],[57,1,"ひつじ"],[63,1,"た"],[70,1,"つね"],[76,1,"かみ"],[78,1,"しゅ"],[80,1,"おそ"],[86,1,"まな"]],"text":"そしてあなたの神、主の前、すなわち主がその名を置くために選ばれる場所で、穀物と、ぶどう酒と、油との十分の一と、牛、羊のういごを食べ、こうして常にあなたの神、主を恐れることを学ばなければならない。"},{"ref":"Deut.14.24","start":5014024,"end":5014024,"break":"none","ruby":[[6,1,"みち"],[12,1,"とお"],[19,1,"かみ"],[21,1,"しゅ"],[25,1,"な"],[27,1,"お"],[32,1,"えら"],[36,2,"ばしょ"],[40,2,"ひじょう"],[43,1,"とお"],[45,1,"はな"],[55,1,"かみ"],[57,1,"しゅ"],[63,1,"めぐ"],[73,1,"たずさ"],[76,1,"い"]],"text":"ただし、その道があまりに遠く、あなたの神、主がその名を置くために選ばれる場所が、非常に遠く離れていて、あなたの神、主があなたを恵まれるとき、それを携えて行くことができないならば、"},{"ref":"Deut.14.25","start":5014025,"end":5014025,"break":"none","ruby":[[6,1,"もの"],[8,1,"かね"],[10,1,"か"],[15,1,"かね"],[17,1,"つつ"],[20,1,"て"],[22,1,"と"],[29,1,"かみ"],[31,1,"しゅ"],[33,1,"えら"],[37,2,"ばしょ"],[40,1,"い"]],"text":"あなたはその物を金に換え、その金を包んで手に取り、あなたの神、主が選ばれる場所に行き、"},{"ref":"Deut.14.26","start":5014026,"end":5014026,"break":"none","ruby":[[2,1,"かね"],[11,1,"この"],[13,1,"もの"],[15,1,"か"],[30,1,"うし"],[32,1,"ひつじ"],[37,1,"しゅ"],[39,1,"こ"],[41,1,"さけ"],[52,1,"ほっ"],[55,1,"もの"],[57,1,"か"],[62,1,"ところ"],[68,1,"かみ"],[70,1,"しゅ"],[72,1,"まえ"],[77,1,"た"],[80,2,"かぞく"],[83,1,"とも"],[85,1,"たの"]],"text":"その金をすべてあなたの好む物に換えなければならない。すなわち牛、羊、ぶどう酒、濃い酒など、すべてあなたの欲する物に換え、その所であなたの神、主の前でそれを食べ、家族と共に楽しまなければならない。"},{"ref":"Deut.14.27","start":5014027,"end":5014027,"break":"none","ruby":[[0,1,"まち"],[2,1,"うち"],[11,1,"す"],[20,1,"かれ"],[31,1,"ぶん"],[36,1,"し"],[37,1,"ぎょう"],[39,1,"も"],[43,1,"もの"]],"text":"町の内におるレビびとを捨ててはならない。彼はあなたがたのうちに分がなく、嗣業を持たない者だからである。"},{"ref":"Deut.14.28","start":5014028,"end":5014028,"break":"paragraph","ruby":[[1,1,"ねん"],[3,1,"おわ"],[11,1,"とし"],[13,2,"さんぶつ"],[17,1,"ぶん"],[27,1,"も"],[29,1,"だ"],[33,1,"まち"],[35,1,"うち"]],"text":"三年の終りごとに、その年の産物の十分の一を、ことごとく持ち出して、町の内にたくわえ、"},{"ref":"Deut.14.29","start":5014029,"end":5014029,"break":"none","ruby":[[9,1,"わ"],[11,1,"まえ"],[16,1,"し"],[17,1,"ぎょう"],[19,1,"も"],[31,1,"まち"],[33,1,"うち"],[37,2,"きりゅう"],[40,2,"たこく"],[42,1,"じん"],[45,2,"こじ"],[49,2,"かふ"],[52,1,"よ"],[59,1,"た"],[64,2,"まんぞく"],[87,1,"かみ"],[89,1,"しゅ"],[95,1,"て"],[97,1,"おこな"],[103,1,"こと"],[109,2,"しゅくふく"]],"text":"あなたがたのうちに分け前がなく、嗣業を持たないレビびと、および町の内におる寄留の他国人と、孤児と、寡婦を呼んで、それを食べさせ、満足させなければならない。そうすれば、あなたの神、主はあなたが手で行うすべての事にあなたを祝福されるであろう。"}]