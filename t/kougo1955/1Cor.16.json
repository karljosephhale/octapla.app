[{"ref":"1Cor.16.1","start":46016001,"end":46016001,"break":"paragraph","ruby":[[0,2,"せいと"],[6,2,"けんきん"],[23,1,"しょ"],[24,2,"きょうかい"],[27,1,"めい"]],"text":"聖徒たちへの献金については、わたしはガラテヤの諸教会に命じておいたが、あなたがたもそのとおりにしなさい。"},{"ref":"1Cor.16.2","start":46016002,"end":46016002,"break":"none","ruby":[[1,1,"しゅう"],[3,1,"はじ"],[6,1,"ひ"],[27,2,"しゅうにゅう"],[30,1,"おう"],[33,1,"て"],[49,1,"つ"],[52,1,"とき"],[57,1,"はじ"],[60,1,"あつ"]],"text":"一週の初めの日ごとに、あなたがたはそれぞれ、いくらでも収入に応じて手もとにたくわえておき、わたしが着いた時になって初めて集めることのないようにしなさい。"},{"ref":"1Cor.16.3","start":46016003,"end":46016003,"break":"none","ruby":[[4,2,"とうちゃく"],[16,1,"えら"],[19,2,"ひとびと"],[22,2,"てがみ"],[34,1,"おく"],[36,1,"もの"],[38,1,"も"],[49,1,"おく"],[51,1,"だ"]],"text":"わたしが到着したら、あなたがたが選んだ人々に手紙をつけ、あなたがたの贈り物を持たせて、エルサレムに送り出すことにしよう。"},{"ref":"1Cor.16.4","start":46016004,"end":46016004,"break":"none","ruby":[[6,1,"ゆ"],[8,1,"ほう"],[15,2,"いっしょ"],[18,1,"ゆ"]],"text":"もしわたしも行く方がよければ、一緒に行くことになろう。"},{"ref":"1Cor.16.5","start":46016005,"end":46016005,"break":"none","ruby":[[11,2,"つうか"],[28,1,"ゆ"],[43,2,"つうか"]],"text":"わたしは、マケドニヤを通過してから、あなたがたのところに行くことになろう。マケドニヤは通過するだけだが、"},{"ref":"1Cor.16.6","start":46016006,"end":46016006,"break":"none","ruby":[[6,1,"ところ"],[13,2,"たいざい"],[27,1,"ふゆ"],[29,1,"す"],[34,1,"し"],[52,1,"い"],[65,1,"おく"]],"text":"あなたがたの所では、たぶん滞在するようになり、あるいは冬を過ごすかも知れない。そうなれば、わたしがどこへゆくにしても、あなたがたに送ってもらえるだろう。"},{"ref":"1Cor.16.7","start":46016007,"end":46016007,"break":"none","ruby":[[4,1,"いま"],[12,1,"たび"],[18,1,"あ"],[23,1,"この"],[30,1,"しゅ"],[33,1,"ゆる"],[50,1,"ところ"],[52,2,"たいざい"],[58,1,"のぞ"]],"text":"わたしは今、あなたがたに旅のついでに会うことは好まない。もし主のお許しがあれば、しばらくあなたがたの所に滞在したいと望んでいる。"},{"ref":"1Cor.16.8","start":46016008,"end":46016008,"break":"none","ruby":[[3,3,"ごじゅんせつ"],[14,2,"たいざい"],[29,2,"ゆうりょく"],[32,1,"はたら"],[35,1,"もん"],[44,1,"おお"],[47,1,"ひら"]],"text":"しかし五旬節までは、エペソに滞在するつもりだ。というのは、有力な働きの門がわたしのために大きく開かれているし、"},{"ref":"1Cor.16.9","start":46016009,"end":46016009,"break":"none","ruby":[[2,2,"てきたい"],[6,1,"もの"],[8,1,"おお"]],"text":"また敵対する者も多いからである。"},{"ref":"1Cor.16.10","start":46016010,"end":46016010,"break":"paragraph","ruby":[[6,1,"つ"],[17,1,"ところ"],[19,2,"ふあん"],[24,1,"す"],[40,1,"かれ"],[46,2,"どうよう"],[50,1,"しゅ"],[53,1,"よう"]],"text":"もしテモテが着いたら、あなたがたの所で不安なしに過ごせるようにしてあげてほしい。彼はわたしと同様に、主のご用にあたっているのだから。"},{"ref":"1Cor.16.11","start":46016011,"end":46016011,"break":"none","ruby":[[3,1,"かれ"],[5,1,"かろ"],[23,1,"ところ"],[25,1,"く"],[34,1,"かれ"],[36,1,"やす"],[40,1,"おく"],[42,1,"だ"],[53,1,"かれ"],[55,2,"きょうだい"],[60,2,"いっしょ"],[63,1,"く"],[67,1,"ま"]],"text":"だれも彼を軽んじてはいけない。そして、わたしの所に来るように、どうか彼を安らかに送り出してほしい。わたしは彼が兄弟たちと一緒に来るのを待っている。"},{"ref":"1Cor.16.12","start":46016012,"end":46016012,"break":"none","ruby":[[0,2,"きょうだい"],[11,2,"きょうだい"],[16,2,"いっしょ"],[25,1,"ところ"],[27,1,"い"],[37,1,"すす"],[46,1,"かれ"],[50,1,"いま"],[51,1,"ゆ"],[53,2,"いし"],[57,1,"まった"],[62,2,"てきとう"],[65,2,"きかい"],[72,1,"い"]],"text":"兄弟アポロについては、兄弟たちと一緒にあなたがたの所に行くように、たびたび勧めてみた。しかし彼には、今行く意志は、全くない。適当な機会があれば、行くだろう。"},{"ref":"1Cor.16.13","start":46016013,"end":46016013,"break":"paragraph","ruby":[[0,1,"め"],[11,2,"しんこう"],[14,1,"た"],[20,1,"おとこ"],[25,1,"つよ"]],"text":"目をさましていなさい。信仰に立ちなさい。男らしく、強くあってほしい。"},{"ref":"1Cor.16.14","start":46016014,"end":46016014,"break":"none","ruby":[[9,1,"あい"],[14,1,"おこな"]],"text":"いっさいのことを、愛をもって行いなさい。"},{"ref":"1Cor.16.15","start":46016015,"end":46016015,"break":"paragraph","ruby":[[0,2,"きょうだい"],[12,1,"すす"],[22,1,"し"],[36,1,"いえ"],[42,2,"はつほ"],[49,1,"かれ"],[52,1,"み"],[57,2,"せいと"],[60,2,"ほうし"]],"text":"兄弟たちよ。あなたがたに勧める。あなたがたが知っているように、ステパナの家はアカヤの初穂であって、彼らは身をもって聖徒に奉仕してくれた。"},{"ref":"1Cor.16.16","start":46016016,"end":46016016,"break":"none","ruby":[[9,2,"ひとびと"],[18,1,"かれ"],[21,1,"とも"],[23,1,"はたら"],[25,1,"とも"],[27,1,"ろう"],[30,2,"ひとびと"],[35,1,"したが"]],"text":"どうか、このような人々と、またすべて彼らと共に働き共に労する人々とに、従ってほしい。"},{"ref":"1Cor.16.17","start":46016017,"end":46016017,"break":"none","ruby":[[29,1,"よろこ"],[35,1,"かれ"],[44,1,"た"],[48,1,"ところ"],[50,1,"み"]],"text":"わたしは、ステパナとポルトナトとアカイコとがきてくれたのを喜んでいる。彼らはあなたがたの足りない所を満たし、"},{"ref":"1Cor.16.18","start":46016018,"end":46016018,"break":"none","ruby":[[4,1,"こころ"],[12,1,"こころ"],[16,1,"やす"],[30,2,"ひとびと"],[34,1,"おも"]],"text":"わたしの心とあなたがたの心とを、安らかにしてくれた。こうした人々は、重んじなければならない。"},{"ref":"1Cor.16.19","start":46016019,"end":46016019,"break":"paragraph","ruby":[[4,1,"しょ"],[5,2,"きょうかい"],[32,1,"いえ"],[34,2,"きょうかい"],[39,1,"しゅ"],[44,1,"こころ"]],"text":"アジヤの諸教会から、あなたがたによろしく。アクラとプリスカとその家の教会から、主にあって心からよろしく。"},{"ref":"1Cor.16.20","start":46016020,"end":46016020,"break":"none","ruby":[[4,2,"きょうだい"],[22,1,"たがい"],[28,2,"せっぷん"]],"text":"すべての兄弟たちから、よろしく。あなたがたも互に、きよい接吻をもってあいさつをかわしなさい。"},{"ref":"1Cor.16.21","start":46016021,"end":46016021,"break":"paragraph","ruby":[[8,1,"て"]],"text":"ここでパウロが、手ずからあいさつをしるす。"},{"ref":"1Cor.16.22","start":46016022,"end":46016022,"break":"none","ruby":[[2,1,"しゅ"],[4,1,"あい"],[8,1,"もの"],[30,1,"しゅ"]],"text":"もし主を愛さない者があれば、のろわれよ。マラナ・タ（われらの主よ、きたりませ）。"},{"ref":"1Cor.16.23","start":46016023,"end":46016023,"break":"none","ruby":[[0,1,"しゅ"],[5,1,"めぐ"],[15,1,"とも"]],"text":"主イエスの恵みが、あなたがたと共にあるように。"},{"ref":"1Cor.16.24","start":46016024,"end":46016024,"break":"none","ruby":[[4,1,"あい"],[25,2,"いちどう"],[28,1,"とも"]],"text":"わたしの愛が、キリスト・イエスにあって、あなたがた一同と共にあるように。"}]