[{"ref":"Zech.5.1","start":38005001,"end":38005001,"break":"paragraph","ruby":[[6,1,"め"],[11,1,"み"],[17,1,"と"],[22,2,"まきもの"],[25,1,"み"]],"text":"わたしがまた目をあげて見ていると、飛んでいる巻物を見た。"},{"ref":"Zech.5.2","start":38005002,"end":38005002,"break":"none","ruby":[[0,1,"かれ"],[7,1,"なに"],[9,1,"み"],[14,1,"い"],[21,1,"と"],[26,2,"まきもの"],[29,1,"み"],[35,1,"なが"],[47,1,"はば"],[58,1,"こた"]],"text":"彼がわたしに「何を見るか」と言ったので、「飛んでいる巻物を見ます。その長さは二十キュビト、その幅は十キュビトです」と答えた。"},{"ref":"Zech.5.3","start":38005003,"end":38005003,"break":"none","ruby":[[3,1,"かれ"],[12,1,"い"],[20,1,"ぜん"],[21,1,"ち"],[27,1,"で"],[29,1,"い"],[36,2,"ことば"],[44,1,"ぬす"],[46,1,"もの"],[51,1,"てら"],[54,1,"のぞ"],[56,1,"さ"],[63,1,"いつわ"],[65,1,"ちか"],[67,1,"もの"],[73,1,"てら"],[76,1,"のぞ"],[78,1,"さ"]],"text":"すると彼はまた、わたしに言った、「これは全地のおもてに出て行く、のろいの言葉です。すべて盗む者はこれに照して除き去られ、すべて偽り誓う者は、これに照して除き去られるのです。"},{"ref":"Zech.5.4","start":38005004,"end":38005004,"break":"none","ruby":[[0,2,"ばんぐん"],[3,1,"しゅ"],[5,1,"おお"],[19,1,"で"],[21,1,"い"],[29,1,"ぬす"],[31,1,"もの"],[33,1,"いえ"],[35,1,"はい"],[44,1,"な"],[49,1,"いつわ"],[51,1,"ちか"],[53,1,"もの"],[55,1,"いえ"],[57,1,"はい"],[62,1,"いえ"],[64,1,"なか"],[66,1,"やど"],[75,1,"き"],[77,1,"いし"],[79,1,"とも"],[81,1,"ほろ"]],"text":"万軍の主は仰せられます、わたしはこれを出て行かせる。これは盗む者の家に入り、またわたしの名をさして偽り誓う者の家に入り、その家の中に宿って、これをその木と石と共に滅ぼすと」。"},{"ref":"Zech.5.5","start":38005005,"end":38005005,"break":"paragraph","ruby":[[4,1,"かた"],[6,1,"てん"],[8,1,"つかい"],[10,1,"すす"],[13,1,"き"],[21,1,"め"],[29,1,"で"],[33,1,"もの"],[43,1,"み"],[49,1,"い"]],"text":"わたしと語る天の使は進んで来て、わたしに「目をあげて、この出てきた物が、なんであるかを見なさい」と言った。"},{"ref":"Zech.5.6","start":38005006,"end":38005006,"break":"none","ruby":[[15,1,"い"],[19,1,"かれ"],[24,1,"で"],[28,1,"もの"],[33,1,"ます"],[38,1,"い"],[47,1,"ぜん"],[48,1,"ち"],[50,1,"つみ"],[55,1,"い"]],"text":"わたしが「これはなんですか」と言うと、彼は「この出てきた物は、エパ枡です」と言い、また「これは全地の罪です」と言った。"},{"ref":"Zech.5.7","start":38005007,"end":38005007,"break":"none","ruby":[[3,1,"み"],[6,1,"なまり"],[11,1,"と"],[22,1,"ます"],[24,1,"なか"],[30,1,"おんな"]],"text":"そして見よ、鉛のふたを取りあげると、そのエパ枡の中にひとりの女がすわっていた。"},{"ref":"Zech.5.8","start":38005008,"end":38005008,"break":"none","ruby":[[3,1,"かれ"],[9,2,"ざいあく"],[16,1,"い"],[22,1,"おんな"],[26,1,"ます"],[28,1,"なか"],[30,1,"お"],[32,1,"い"],[35,1,"なまり"],[37,1,"おも"],[43,1,"ます"],[45,1,"くち"],[47,1,"な"]],"text":"すると彼は「これは罪悪である」と言って、その女をエパ枡の中に押し入れ、鉛の重しを、その枡の口に投げかぶせた。"},{"ref":"Zech.5.9","start":38005009,"end":38005009,"break":"none","ruby":[[8,1,"め"],[13,1,"み"],[23,1,"おんな"],[25,1,"で"],[40,1,"つばさ"],[45,1,"つばさ"],[52,1,"つばさ"],[54,1,"かぜ"],[63,1,"ます"],[65,1,"てん"],[67,1,"ち"],[70,1,"あいだ"],[72,1,"も"]],"text":"それからわたしが目をあげて見ていると、ふたりの女が出てきた。これに、こうのとりの翼のような翼があり、その翼に風をはらんで、エパ枡を天と地との間に持ちあげた。"},{"ref":"Zech.5.10","start":38005010,"end":38005010,"break":"none","ruby":[[9,1,"かた"],[11,1,"てん"],[13,1,"つかい"],[15,1,"い"],[20,1,"かれ"],[25,1,"ます"],[31,1,"も"],[34,1,"い"]],"text":"わたしは、わたしと語る天の使に言った、「彼らはエパ枡を、どこへ持って行くのですか」。"},{"ref":"Zech.5.11","start":38005011,"end":38005011,"break":"none","ruby":[[0,1,"かれ"],[6,1,"い"],[15,1,"ち"],[18,1,"おんな"],[25,1,"いえ"],[27,1,"た"],[37,1,"た"],[44,1,"かれ"],[49,1,"ます"],[60,2,"どだい"],[63,1,"うえ"],[65,1,"お"]],"text":"彼はわたしに言った、「シナルの地で、女たちのために家を建てるのです。それが建てられると、彼らはエパ枡をそこにすえ、それの土台の上に置くのです」。"}]