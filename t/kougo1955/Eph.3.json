[{"ref":"Eph.3.1","start":49003001,"end":49003001,"break":"paragraph","ruby":[[13,3,"いほうじん"],[29,2,"しゅうじん"]],"text":"こういうわけで、あなたがた異邦人のためにキリスト・イエスの囚人となっているこのパウロ――"},{"ref":"Eph.3.2","start":49003002,"end":49003002,"break":"none","ruby":[[13,1,"かみ"],[16,1,"たま"],[20,1,"めぐ"],[23,1,"つとめ"],[39,1,"き"]],"text":"わたしがあなたがたのために神から賜わった恵みの務について、あなたがたはたしかに聞いたであろう。"},{"ref":"Eph.3.3","start":49003003,"end":49003003,"break":"none","ruby":[[8,2,"かんたん"],[11,1,"か"],[25,2,"けいじ"],[31,2,"おくぎ"],[34,1,"し"]],"text":"すなわち、すでに簡単に書きおくったように、わたしは啓示によって奥義を知らされたのである。"},{"ref":"Eph.3.4","start":49003004,"end":49003004,"break":"none","ruby":[[9,1,"よ"],[18,2,"おくぎ"],[27,2,"りかい"]],"text":"あなたがたはそれを読めば、キリストの奥義をわたしがどう理解しているかがわかる。"},{"ref":"Eph.3.5","start":49003005,"end":49003005,"break":"none","ruby":[[2,2,"おくぎ"],[10,2,"みたま"],[16,1,"かれ"],[18,1,"せい"],[21,2,"しと"],[26,3,"よげんしゃ"],[33,2,"けいじ"],[42,1,"まえ"],[44,2,"じだい"],[49,1,"ひと"],[51,1,"こ"],[54,1,"たい"],[63,1,"し"]],"text":"この奥義は、いまは、御霊によって彼の聖なる使徒たちと預言者たちとに啓示されているが、前の時代には、人の子らに対して、そのように知らされてはいなかったのである。"},{"ref":"Eph.3.6","start":49003006,"end":49003006,"break":"none","ruby":[[4,3,"いほうじん"],[9,2,"ふくいん"],[33,1,"とも"],[35,1,"かみ"],[37,1,"くに"],[41,1,"もの"],[46,1,"とも"],[58,1,"とも"],[60,2,"やくそく"],[67,1,"もの"]],"text":"それは、異邦人が、福音によりキリスト・イエスにあって、わたしたちと共に神の国をつぐ者となり、共に一つのからだとなり、共に約束にあずかる者となることである。"},{"ref":"Eph.3.7","start":49003007,"end":49003007,"break":"none","ruby":[[5,1,"かみ"],[7,1,"ちから"],[13,1,"はたら"],[17,2,"じぶん"],[20,1,"あた"],[25,1,"かみ"],[27,1,"めぐ"],[30,2,"たまもの"],[36,2,"ふくいん"],[39,1,"しもべ"]],"text":"わたしは、神の力がわたしに働いて、自分に与えられた神の恵みの賜物により、福音の僕とされたのである。"},{"ref":"Eph.3.8","start":49003008,"end":49003008,"break":"none","ruby":[[5,2,"せいと"],[13,1,"もっと"],[15,1,"ちい"],[18,1,"もの"],[28,1,"めぐ"],[31,1,"あた"],[47,3,"むじんぞう"],[51,1,"とみ"],[53,3,"いほうじん"],[57,1,"の"],[59,1,"つた"]],"text":"すなわち、聖徒たちのうちで最も小さい者であるわたしにこの恵みが与えられたが、それは、キリストの無尽蔵の富を異邦人に宣べ伝え、"},{"ref":"Eph.3.9","start":49003009,"end":49003009,"break":"none","ruby":[[0,1,"さら"],[5,2,"ばんぶつ"],[8,1,"つく"],[10,1,"しゅ"],[14,1,"かみ"],[16,1,"なか"],[18,2,"よよ"],[20,1,"かく"],[26,2,"おくぎ"],[33,1,"つとめ"],[46,1,"あき"],[50,1,"しめ"]],"text":"更にまた、万物の造り主である神の中に世々隠されていた奥義にあずかる務がどんなものであるかを、明らかに示すためである。"},{"ref":"Eph.3.10","start":49003010,"end":49003010,"break":"none","ruby":[[3,1,"いま"],[5,2,"てんじょう"],[15,2,"しはい"],[18,2,"けんい"],[22,2,"きょうかい"],[30,1,"かみ"],[32,2,"たしゅ"],[34,2,"たよう"],[37,2,"ちえ"],[40,1,"し"],[43,1,"いた"]],"text":"それは今、天上にあるもろもろの支配や権威が、教会をとおして、神の多種多様な知恵を知るに至るためであって、"},{"ref":"Eph.3.11","start":49003011,"end":49003011,"break":"none","ruby":[[6,1,"しゅ"],[19,2,"じつげん"],[24,1,"かみ"],[26,2,"えいえん"],[29,2,"もくてき"]],"text":"わたしたちの主キリスト・イエスにあって実現された神の永遠の目的にそうものである。"},{"ref":"Eph.3.12","start":49003012,"end":49003012,"break":"none","ruby":[[2,1,"しゅ"],[19,1,"かれ"],[21,1,"たい"],[24,2,"しんこう"],[31,2,"かくしん"],[37,2,"だいたん"],[40,1,"かみ"],[42,1,"ちか"]],"text":"この主キリストにあって、わたしたちは、彼に対する信仰によって、確信をもって大胆に神に近づくことができるのである。"},{"ref":"Eph.3.13","start":49003013,"end":49003013,"break":"none","ruby":[[17,1,"う"],[22,2,"かんなん"],[25,1,"み"],[28,2,"らくたん"],[46,2,"かんなん"],[56,2,"こうえい"]],"text":"だから、あなたがたのためにわたしが受けている患難を見て、落胆しないでいてもらいたい。わたしの患難は、あなたがたの光栄なのである。"},{"ref":"Eph.3.14","start":49003014,"end":49003014,"break":"paragraph","text":"こういうわけで、わたしはひざをかがめて、"},{"ref":"Eph.3.15","start":49003015,"end":49003015,"break":"none","ruby":[[0,2,"てんじょう"],[5,2,"ちじょう"],[12,1,"ちち"],[15,1,"よ"],[28,1,"みなもと"],[31,1,"ちち"],[33,1,"いの"]],"text":"天上にあり地上にあって「父」と呼ばれているあらゆるものの源なる父に祈る。"},{"ref":"Eph.3.16","start":49003016,"end":49003016,"break":"none","ruby":[[3,1,"ちち"],[8,2,"えいこう"],[11,1,"とみ"],[18,2,"みたま"],[24,1,"ちから"],[35,1,"うち"],[38,1,"ひと"],[40,1,"つよ"],[44,1,"くだ"]],"text":"どうか父が、その栄光の富にしたがい、御霊により、力をもってあなたがたの内なる人を強くして下さるように、"},{"ref":"Eph.3.17","start":49003017,"end":49003017,"break":"none","ruby":[[3,2,"しんこう"],[21,1,"こころ"],[26,1,"す"],[35,1,"あい"],[37,1,"ね"],[40,1,"あい"],[42,1,"もとい"],[46,2,"せいかつ"]],"text":"また、信仰によって、キリストがあなたがたの心のうちに住み、あなたがたが愛に根ざし愛を基として生活することにより、"},{"ref":"Eph.3.18","start":49003018,"end":49003018,"break":"none","ruby":[[4,2,"せいと"],[7,1,"とも"],[12,1,"ひろ"],[15,1,"なが"],[18,1,"たか"],[21,1,"ふか"],[24,2,"りかい"]],"text":"すべての聖徒と共に、その広さ、長さ、高さ、深さを理解することができ、"},{"ref":"Eph.3.19","start":49003019,"end":49003019,"break":"none","ruby":[[2,2,"じんち"],[9,1,"こ"],[17,1,"あい"],[19,1,"し"],[23,1,"かみ"],[25,1,"み"],[47,1,"み"],[57,1,"いの"]],"text":"また人知をはるかに越えたキリストの愛を知って、神に満ちているもののすべてをもって、あなたがたが満たされるように、と祈る。"},{"ref":"Eph.3.20","start":49003020,"end":49003020,"break":"paragraph","ruby":[[13,1,"はたら"],[15,1,"ちから"],[27,1,"もと"],[31,1,"おも"],[47,1,"こ"],[54,1,"くだ"]],"text":"どうか、わたしたちのうちに働く力によって、わたしたちが求めまた思うところのいっさいを、はるかに越えてかなえて下さることができるかたに、"},{"ref":"Eph.3.21","start":49003021,"end":49003021,"break":"none","ruby":[[0,2,"きょうかい"],[22,2,"えいこう"],[25,2,"よよ"],[27,1,"かぎ"]],"text":"教会により、また、キリスト・イエスによって、栄光が世々限りなくあるように、アァメン。"}]