[{"ref":"Josh.21.1","start":6021001,"end":6021001,"break":"paragraph","ruby":[[0,1,"とき"],[5,2,"ぞくちょう"],[11,2,"さいし"],[22,1,"こ"],[36,2,"ぶぞく"],[39,2,"ぞくちょう"]],"text":"時にレビの族長たちは、祭司エレアザル、ヌンの子ヨシュアおよびイスラエルの部族の族長たちのもとにきて、"},{"ref":"Josh.21.2","start":6021002,"end":6021002,"break":"none","ruby":[[4,1,"ち"],[9,1,"かれ"],[12,1,"い"],[17,1,"しゅ"],[28,1,"す"],[32,2,"まちまち"],[35,1,"あた"],[45,1,"ぞく"],[48,2,"ほうぼく"],[50,1,"ち"],[53,2,"かちく"],[59,1,"あた"],[73,1,"めい"]],"text":"カナンの地のシロで彼らに言った、「主はかつて、われわれに住むべき町々を与えることと、それに属する放牧地を、家畜のために与えることを、モーセによって命じられました」。"},{"ref":"Josh.21.3","start":6021003,"end":6021003,"break":"none","ruby":[[9,2,"ひとびと"],[13,1,"しゅ"],[15,1,"いのち"],[23,2,"じぶん"],[28,1,"し"],[29,1,"ぎょう"],[36,1,"つぎ"],[38,2,"まちまち"],[44,2,"ほうぼく"],[46,1,"ち"],[55,1,"あた"]],"text":"それでイスラエルの人々は、主の命にしたがって、自分たちの嗣業のうちから、次の町々と、その放牧地とを、レビびとに与えた。"},{"ref":"Josh.21.4","start":6021004,"end":6021004,"break":"paragraph","ruby":[[8,2,"しぞく"],[18,1,"ひ"],[22,2,"さいし"],[28,2,"しそん"],[53,2,"ぶぞく"],[61,2,"ぶぞく"],[73,2,"ぶぞく"],[84,1,"まち"],[86,1,"え"]],"text":"まずコハテびとの氏族のために、くじを引いた。祭司アロンの子孫であるこれらのレビびとは、くじによって、ユダの部族、シメオンの部族、およびベニヤミンの部族のうちから、十三の町を獲た。"},{"ref":"Josh.21.5","start":6021005,"end":6021005,"break":"paragraph","ruby":[[2,1,"た"],[24,2,"ぶぞく"],[27,2,"しぞく"],[33,2,"ぶぞく"],[43,1,"はん"],[44,2,"ぶぞく"],[54,1,"まち"],[56,1,"え"]],"text":"その他のコハテびとは、くじによって、エフライムの部族の氏族、ダンの部族、およびマナセの半部族のうちから、十の町を獲た。"},{"ref":"Josh.21.6","start":6021006,"end":6021006,"break":"paragraph","ruby":[[24,2,"ぶぞく"],[27,2,"しぞく"],[34,2,"ぶぞく"],[42,2,"ぶぞく"],[59,1,"はん"],[60,2,"ぶぞく"],[71,1,"まち"],[73,1,"え"]],"text":"またゲルションびとは、くじによって、イッサカルの部族の氏族、アセルの部族、ナフタリの部族、およびバシャンにあるマナセの半部族のうちから、十三の町を獲た。"},{"ref":"Josh.21.7","start":6021007,"end":6021007,"break":"paragraph","ruby":[[11,2,"しぞく"],[24,2,"ぶぞく"],[30,2,"ぶぞく"],[41,2,"ぶぞく"],[52,1,"まち"],[54,1,"え"]],"text":"またメラリびとは、その氏族にしたがって、ルベンの部族、ガドの部族、およびゼブルンの部族のうちから、十二の町を獲た。"},{"ref":"Josh.21.8","start":6021008,"end":6021008,"break":"paragraph","ruby":[[6,2,"ひとびと"],[10,1,"しゅ"],[19,1,"めい"],[33,1,"まち"],[38,2,"ほうぼく"],[40,1,"ち"],[56,1,"あた"]],"text":"イスラエルの人々は、主がモーセによって命じられたとおりに、これらの町と、その放牧地とを、くじによって、レビびとに与えた。"},{"ref":"Josh.21.9","start":6021009,"end":6021009,"break":"paragraph","ruby":[[5,2,"ぶぞく"],[14,2,"ぶぞく"],[22,1,"つぎ"],[24,1,"な"],[29,2,"まちまち"],[32,1,"あた"]],"text":"まずユダの部族と、シメオンの部族のうちから、次に名をあげる町々を与えた。"},{"ref":"Josh.21.10","start":6021010,"end":6021010,"break":"none","ruby":[[9,1,"ぞく"],[18,2,"しぞく"],[31,2,"しそん"],[34,1,"あた"],[40,2,"さいしょ"],[46,1,"かれ"],[49,1,"あた"]],"text":"これらはレビびとに属するコハテびとの氏族の一つである、アロンの子孫に与えられた。最初のくじが彼らに当ったからである。"},{"ref":"Josh.21.11","start":6021011,"end":6021011,"break":"none","ruby":[[7,2,"さんち"],[33,2,"しゅうい"],[36,2,"ほうぼく"],[38,1,"ち"],[40,1,"かれ"],[43,1,"あた"],[57,1,"ちち"]],"text":"すなわちユダの山地にあるキリアテ・アルバすなわちヘブロンおよびその周囲の放牧地を彼らに与えた。このアルバはアナクの父であった。"},{"ref":"Josh.21.12","start":6021012,"end":6021012,"break":"none","ruby":[[6,1,"まち"],[8,1,"はたけ"],[14,1,"ぞく"],[17,2,"むらむら"],[30,1,"こ"],[39,1,"う"],[42,2,"しょゆう"]],"text":"ただし、この町の畑と、それに属する村々とは、すでにエフンネの子カレブが、それを受けて所有していた。"},{"ref":"Josh.21.13","start":6021013,"end":6021013,"break":"paragraph","ruby":[[0,2,"さいし"],[6,2,"しそん"],[9,1,"あた"],[15,1,"ひと"],[17,1,"ころ"],[20,1,"もの"],[27,1,"まち"],[38,2,"ほうぼく"],[40,1,"ち"],[48,2,"ほうぼく"],[50,1,"ち"]],"text":"祭司アロンの子孫に与えたのは、人を殺した者の、のがれる町であるヘブロンとその放牧地、リブナとその放牧地、"},{"ref":"Josh.21.14","start":6021014,"end":6021014,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[19,2,"ほうぼく"],[21,1,"ち"]],"text":"ヤッテルとその放牧地、エシテモアとその放牧地、"},{"ref":"Josh.21.15","start":6021015,"end":6021015,"break":"none","ruby":[[6,2,"ほうぼく"],[8,1,"ち"],[16,2,"ほうぼく"],[18,1,"ち"]],"text":"ホロンとその放牧地、デビルとその放牧地、"},{"ref":"Josh.21.16","start":6021016,"end":6021016,"break":"none","ruby":[[6,2,"ほうぼく"],[8,1,"ち"],[16,2,"ほうぼく"],[18,1,"ち"],[28,2,"ほうぼく"],[30,1,"ち"],[37,1,"まち"],[48,2,"ぶぞく"],[55,1,"わ"],[57,1,"あた"]],"text":"アインとその放牧地、ユッタとその放牧地、ベテシメシとその放牧地など、九つの町であって、この二つの部族のうちから分け与えたものである。"},{"ref":"Josh.21.17","start":6021017,"end":6021017,"break":"none","ruby":[[8,2,"ぶぞく"],[23,2,"ほうぼく"],[25,1,"ち"],[32,2,"ほうぼく"],[34,1,"ち"]],"text":"またベニヤミンの部族のうちから、ギベオンとその放牧地、ゲバとその放牧地、"},{"ref":"Josh.21.18","start":6021018,"end":6021018,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[18,2,"ほうぼく"],[20,1,"ち"],[27,1,"まち"],[29,1,"あた"]],"text":"アナトテとその放牧地、アルモンとその放牧地など、四つの町を与えた。"},{"ref":"Josh.21.19","start":6021019,"end":6021019,"break":"none","ruby":[[4,2,"しそん"],[9,2,"さいし"],[14,1,"まち"],[17,1,"あ"],[31,1,"ぞく"],[34,2,"ほうぼく"],[36,1,"ち"]],"text":"アロンの子孫である祭司たちの町は、合わせて十三であって、それに属する放牧地があった。"},{"ref":"Josh.21.20","start":6021020,"end":6021020,"break":"paragraph","ruby":[[2,1,"た"],[17,2,"しぞく"],[34,2,"ぶぞく"],[41,1,"まち"],[43,1,"え"]],"text":"その他のコハテびとであるレビびとの氏族は、くじによって、エフライムの部族のうちから町を獲た。"},{"ref":"Josh.21.21","start":6021021,"end":6021021,"break":"none","ruby":[[7,1,"まち"],[10,1,"ひと"],[12,1,"ころ"],[23,1,"まち"],[33,2,"さんち"],[42,2,"ほうぼく"],[44,1,"ち"],[52,2,"ほうぼく"],[54,1,"ち"]],"text":"すなわち、その町は、人を殺したものの、のがれる町であるエフライムの山地のシケムとその放牧地、ゲゼルとその放牧地、"},{"ref":"Josh.21.22","start":6021022,"end":6021022,"break":"none","ruby":[[8,2,"ほうぼく"],[10,1,"ち"],[20,2,"ほうぼく"],[22,1,"ち"],[29,1,"まち"]],"text":"キブザイムとその放牧地、ベテホロンとその放牧地など、四つの町である。"},{"ref":"Josh.21.23","start":6021023,"end":6021023,"break":"none","ruby":[[5,2,"ぶぞく"],[12,1,"わ"],[14,1,"あた"],[17,1,"まち"],[27,2,"ほうぼく"],[29,1,"ち"],[38,2,"ほうぼく"],[40,1,"ち"]],"text":"またダンの部族のうちから分け与えた町は、エルテケとその放牧地、ギベトンとその放牧地、"},{"ref":"Josh.21.24","start":6021024,"end":6021024,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[20,2,"ほうぼく"],[22,1,"ち"],[29,1,"まち"]],"text":"アヤロンとその放牧地、ガテリンモンとその放牧地など、四つの町である。"},{"ref":"Josh.21.25","start":6021025,"end":6021025,"break":"none","ruby":[[6,1,"はん"],[7,2,"ぶぞく"],[14,1,"わ"],[16,1,"あた"],[19,1,"まち"],[29,2,"ほうぼく"],[31,1,"ち"],[45,2,"ほうぼく"],[47,1,"ち"],[54,1,"まち"]],"text":"またマナセの半部族のうちから分け与えた町は、タアナクとその放牧地、およびガテリンモンとその放牧地など、二つの町である。"},{"ref":"Josh.21.26","start":6021026,"end":6021026,"break":"none","ruby":[[2,1,"た"],[10,2,"しぞく"],[13,1,"まち"],[16,1,"あ"],[29,1,"ぞく"],[32,2,"ほうぼく"],[34,1,"ち"]],"text":"その他のコハテびとの氏族の町は、合わせて十であって、それに属する放牧地があった。"},{"ref":"Josh.21.27","start":6021027,"end":6021027,"break":"paragraph","ruby":[[15,2,"しぞく"],[21,1,"あた"],[26,1,"まち"],[33,1,"はん"],[34,2,"ぶぞく"],[43,1,"ひと"],[45,1,"ころ"],[48,1,"もの"],[55,1,"まち"],[70,2,"ほうぼく"],[72,1,"ち"],[85,2,"ほうぼく"],[87,1,"ち"],[94,1,"まち"]],"text":"ゲルションびとであるレビびとの氏族の一つに与えられた町は、マナセの半部族のうちからは、人を殺した者の、のがれる町であるバシャンのゴランとその放牧地、およびベエシテラとその放牧地など、二つの町である。"},{"ref":"Josh.21.28","start":6021028,"end":6021028,"break":"none","ruby":[[6,2,"ぶぞく"],[22,2,"ほうぼく"],[24,1,"ち"],[33,2,"ほうぼく"],[35,1,"ち"]],"text":"イッサカルの部族のうちからは、キションとその放牧地、ダベラテとその放牧地、"},{"ref":"Josh.21.29","start":6021029,"end":6021029,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[20,2,"ほうぼく"],[22,1,"ち"],[29,1,"まち"]],"text":"ヤルムテとその放牧地、エンガンニムとその放牧地など、四つの町である。"},{"ref":"Josh.21.30","start":6021030,"end":6021030,"break":"none","ruby":[[4,2,"ぶぞく"],[20,2,"ほうぼく"],[22,1,"ち"],[31,2,"ほうぼく"],[33,1,"ち"]],"text":"アセルの部族のうちからは、ミシャルとその放牧地、アブドンとその放牧地、"},{"ref":"Josh.21.31","start":6021031,"end":6021031,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[17,2,"ほうぼく"],[19,1,"ち"],[26,1,"まち"]],"text":"ヘルカテとその放牧地、レホブとその放牧地など、四つの町である。"},{"ref":"Josh.21.32","start":6021032,"end":6021032,"break":"none","ruby":[[5,2,"ぶぞく"],[14,1,"ひと"],[16,1,"ころ"],[19,1,"もの"],[26,1,"まち"],[41,2,"ほうぼく"],[43,1,"ち"],[55,2,"ほうぼく"],[57,1,"ち"],[66,2,"ほうぼく"],[68,1,"ち"],[75,1,"まち"]],"text":"ナフタリの部族のうちからは、人を殺した者の、のがれる町であるガリラヤのケデシとその放牧地、ハンモテ・ドルとその放牧地、カルタンとその放牧地など、三つの町である。"},{"ref":"Josh.21.33","start":6021033,"end":6021033,"break":"none","ruby":[[11,2,"しぞく"],[19,1,"え"],[21,1,"まち"],[24,1,"あ"],[31,1,"まち"],[40,1,"ぞく"],[43,2,"ほうぼく"],[45,1,"ち"]],"text":"ゲルションびとが、その氏族にしたがって獲た町は、合わせて十三の町であって、それに属する放牧地があった。"},{"ref":"Josh.21.34","start":6021034,"end":6021034,"break":"paragraph","ruby":[[2,1,"た"],[18,2,"しぞく"],[21,1,"あた"],[26,1,"まち"],[34,2,"ぶぞく"],[51,2,"ほうぼく"],[53,1,"ち"],[61,2,"ほうぼく"],[63,1,"ち"]],"text":"その他のレビびとである、メラリびとの氏族に与えられた町は、ゼブルンの部族のうちからは、ヨクネアムとその放牧地、カルタとその放牧地、"},{"ref":"Josh.21.35","start":6021035,"end":6021035,"break":"none","ruby":[[6,2,"ほうぼく"],[8,1,"ち"],[17,2,"ほうぼく"],[19,1,"ち"],[26,1,"まち"]],"text":"デムナとその放牧地、ナハラルとその放牧地など、四つの町である。"},{"ref":"Josh.21.36","start":6021036,"end":6021036,"break":"none","ruby":[[4,2,"ぶぞく"],[19,2,"ほうぼく"],[21,1,"ち"],[29,2,"ほうぼく"],[31,1,"ち"]],"text":"ルベンの部族のうちからは、ベゼルとその放牧地、ヤハヅとその放牧地、"},{"ref":"Josh.21.37","start":6021037,"end":6021037,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[18,2,"ほうぼく"],[20,1,"ち"],[27,1,"まち"]],"text":"ケデモテとその放牧地、メパアテとその放牧地など、四つの町である。"},{"ref":"Josh.21.38","start":6021038,"end":6021038,"break":"none","ruby":[[3,2,"ぶぞく"],[12,1,"ひと"],[14,1,"ころ"],[17,1,"もの"],[24,1,"まち"],[39,2,"ほうぼく"],[41,1,"ち"],[51,2,"ほうぼく"],[53,1,"ち"]],"text":"ガドの部族のうちからは、人を殺した者の、のがれる町であるギレアデのラモテとその放牧地、マハナイムとその放牧地、"},{"ref":"Josh.21.39","start":6021039,"end":6021039,"break":"none","ruby":[[7,2,"ほうぼく"],[9,1,"ち"],[17,2,"ほうぼく"],[19,1,"ち"],[23,1,"あ"],[30,1,"まち"]],"text":"ヘシボンとその放牧地、ヤゼルとその放牧地など、合わせて四つの町である。"},{"ref":"Josh.21.40","start":6021040,"end":6021040,"break":"none","ruby":[[26,2,"しぞく"],[41,1,"え"],[43,1,"まち"],[49,1,"あ"]],"text":"これらはみな、ほかのレビびとであるメラリびとが、その氏族にしたがって、くじをもって獲た町であって、合わせて十二であった。"},{"ref":"Josh.21.41","start":6021041,"end":6021041,"break":"paragraph","ruby":[[6,2,"ひとびと"],[9,2,"しょゆう"],[21,1,"も"],[24,2,"まちまち"],[28,1,"あ"],[43,1,"ぞく"],[46,2,"ほうぼく"],[48,1,"ち"]],"text":"イスラエルの人々の所有のうちに、レビびとが持った町々は、合わせて四十八であって、それに属する放牧地があった。"},{"ref":"Josh.21.42","start":6021042,"end":6021042,"break":"none","ruby":[[4,2,"まちまち"],[14,2,"しゅうい"],[17,2,"ほうぼく"],[19,1,"ち"],[29,2,"まちまち"]],"text":"これらの町々は、それぞれその周囲に放牧地があった。これらの町々はみなそうであった。"},{"ref":"Josh.21.43","start":6021043,"end":6021043,"break":"paragraph","ruby":[[6,1,"しゅ"],[15,1,"あた"],[22,2,"せんぞ"],[27,1,"ちか"],[31,1,"ち"],[39,1,"あた"],[47,1,"かれ"],[53,1,"え"],[59,1,"す"]],"text":"このように、主が、イスラエルに与えると、その先祖たちに誓われた地を、ことごとく与えられたので、彼らはそれを獲て、そこに住んだ。"},{"ref":"Josh.21.44","start":6021044,"end":6021044,"break":"none","ruby":[[0,1,"しゅ"],[2,1,"かれ"],[5,2,"せんぞ"],[10,1,"ちか"],[18,2,"しほう"],[21,2,"あんそく"],[24,1,"たま"],[35,1,"てき"],[44,1,"かれ"],[47,2,"てむ"],[51,1,"もの"],[58,1,"しゅ"],[60,1,"てき"],[67,1,"かれ"],[70,1,"て"],[72,1,"わた"]],"text":"主は彼らの先祖たちに誓われたように、四方に安息を賜わったので、すべての敵のうち、ひとりも彼らに手向かう者はなかった。主が敵をことごとく彼らの手に渡されたからである。"},{"ref":"Josh.21.45","start":6021045,"end":6021045,"break":"none","ruby":[[0,1,"しゅ"],[8,1,"いえ"],[10,2,"やくそく"],[19,1,"よ"],[37,2,"じつげん"]],"text":"主がイスラエルの家に約束されたすべての良いことは、一つとしてたがわず、みな実現した。"}]