[{"ref":"Prov.19.1","start":20019001,"end":20019001,"break":"paragraph","breaks":[[11,"line"]],"ruby":[[0,1,"ただ"],[3,1,"あゆ"],[5,1,"まず"],[8,1,"もの"],[11,1,"まが"],[17,1,"い"],[19,1,"おろ"],[22,1,"もの"]],"text":"正しく歩む貧しい者は、曲ったことを言う愚かな者にまさる。"},{"ref":"Prov.19.2","start":20019002,"end":20019002,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ひと"],[2,2,"ちしき"],[9,1,"よ"],[14,1,"あし"],[16,1,"いそ"],[18,1,"もの"],[20,1,"みち"],[22,1,"まよ"]],"text":"人が知識のないのは良くない、足で急ぐ者は道に迷う。"},{"ref":"Prov.19.3","start":20019003,"end":20019003,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ひと"],[2,2,"じぶん"],[5,1,"おろ"],[12,1,"みち"],[23,1,"こころ"],[28,1,"しゅ"]],"text":"人は自分の愚かさによって道につまずき、かえって心のうちに主をうらむ。"},{"ref":"Prov.19.4","start":20019004,"end":20019004,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"とみ"],[2,1,"おお"],[5,1,"あたら"],[8,1,"とも"],[10,1,"つく"],[16,1,"まず"],[19,1,"ひと"],[23,1,"とも"],[25,1,"す"]],"text":"富は多くの新しい友を作る、しかし貧しい人はその友に捨てられる。"},{"ref":"Prov.19.5","start":20019005,"end":20019005,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"いつわ"],[3,2,"しょうにん"],[6,1,"ばつ"],[8,1,"まぬか"],[13,1,"いつわ"],[18,1,"もの"]],"text":"偽りの証人は罰を免れない、偽りをいう者はのがれることができない。"},{"ref":"Prov.19.6","start":20019006,"end":20019006,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"きまえ"],[5,1,"ひと"],[10,1,"もの"],[12,1,"おお"],[15,1,"ひと"],[19,1,"おく"],[21,1,"もの"],[25,1,"ひと"],[27,1,"とも"]],"text":"気前のよい人にこびる者は多い、人はみな贈り物をする人の友となる。"},{"ref":"Prov.19.7","start":20019007,"end":20019007,"break":"line","breaks":[[20,"line"],[42,"line"],[56,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[7,2,"きょうだい"],[17,1,"にく"],[25,1,"とも"],[30,1,"とお"],[42,2,"ことば"],[51,1,"よ"],[56,1,"さ"],[59,1,"かえ"]],"text":"貧しい者はその兄弟すらもみなこれを憎む、ましてその友はこれに遠ざからないであろうか。言葉をかけてこれを呼んでも、去って帰らないのである。"},{"ref":"Prov.19.8","start":20019008,"end":20019008,"break":"line","breaks":[[15,"line"]],"ruby":[[0,2,"ちえ"],[3,1,"え"],[5,1,"もの"],[7,2,"じぶん"],[10,1,"たましい"],[12,1,"あい"],[15,1,"さと"],[18,1,"たも"],[20,1,"もの"],[22,1,"さいわい"],[24,1,"え"]],"text":"知恵を得る者は自分の魂を愛し、悟りを保つ者は幸を得る。"},{"ref":"Prov.19.9","start":20019009,"end":20019009,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"いつわ"],[3,2,"しょうにん"],[6,1,"ばつ"],[8,1,"まぬか"],[13,1,"いつわ"],[18,1,"もの"],[20,1,"ほろ"]],"text":"偽りの証人は罰を免れない、偽りをいう者は滅びる。"},{"ref":"Prov.19.10","start":20019010,"end":20019010,"break":"line","breaks":[[19,"line"],[31,"line"],[51,"line"]],"ruby":[[0,1,"おろ"],[3,1,"もの"],[11,1,"くら"],[36,1,"もの"],[39,1,"きみ"],[42,1,"もの"],[44,1,"おさ"]],"text":"愚かな者が、ぜいたくな暮しをするのは、ふさわしいことではない、しもべたる者が、君たる者を治めるなどは、なおさらである。"},{"ref":"Prov.19.11","start":20019011,"end":20019011,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"さと"],[3,1,"ひと"],[5,1,"いか"],[8,1,"しの"],[23,1,"ひと"],[25,1,"ほまれ"]],"text":"悟りは人に怒りを忍ばせる、あやまちをゆるすのは人の誉である。"},{"ref":"Prov.19.12","start":20019012,"end":20019012,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"おう"],[2,1,"いか"],[20,1,"めぐ"],[23,1,"くさ"],[25,1,"うえ"],[29,1,"つゆ"]],"text":"王の怒りは、ししのほえるようであり、その恵みは草の上におく露のようである。"},{"ref":"Prov.19.13","start":20019013,"end":20019013,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"おろ"],[3,1,"こ"],[7,1,"ちち"],[9,1,"わざわい"],[14,1,"つま"],[16,1,"あらそ"],[21,2,"あまも"],[25,1,"た"]],"text":"愚かな子はその父の災である、妻の争うのは、雨漏りの絶えないのとひとしい。"},{"ref":"Prov.19.14","start":20019014,"end":20019014,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"いえ"],[2,1,"とみ"],[5,2,"せんぞ"],[16,1,"かしこ"],[18,1,"つま"],[20,1,"しゅ"],[23,1,"たま"]],"text":"家と富とは先祖からうけつぐもの、賢い妻は主から賜わるものである。"},{"ref":"Prov.19.15","start":20019015,"end":20019015,"break":"line","breaks":[[11,"line"]],"ruby":[[0,1,"おこた"],[3,1,"ひと"],[5,2,"じゅくすい"],[14,1,"もの"],[16,1,"う"]],"text":"怠りは人を熟睡させる、なまけ者は飢える。"},{"ref":"Prov.19.16","start":20019016,"end":20019016,"break":"line","breaks":[[15,"line"]],"ruby":[[0,1,"いまし"],[3,1,"まも"],[5,1,"もの"],[7,2,"じぶん"],[10,1,"たましい"],[12,1,"まも"],[16,2,"ことば"],[19,1,"かろ"],[23,1,"もの"],[25,1,"し"]],"text":"戒めを守る者は自分の魂を守る、み言葉を軽んじる者は死ぬ。"},{"ref":"Prov.19.17","start":20019017,"end":20019017,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"まず"],[3,1,"もの"],[9,1,"もの"],[11,1,"しゅ"],[13,1,"か"],[20,1,"ほどこ"],[23,1,"しゅ"],[25,1,"つぐな"]],"text":"貧しい者をあわれむ者は主に貸すのだ、その施しは主が償われる。"},{"ref":"Prov.19.18","start":20019018,"end":20019018,"break":"line","breaks":[[18,"line"]],"ruby":[[0,1,"のぞ"],[9,2,"じぶん"],[12,1,"こ"],[14,1,"こ"],[21,1,"ほろ"],[24,1,"こころ"],[26,1,"おこ"]],"text":"望みのあるうちに、自分の子を懲らせ、これを滅ぼす心を起してはならない。"},{"ref":"Prov.19.19","start":20019019,"end":20019019,"break":"line","breaks":[[16,"line"],[29,"line"]],"ruby":[[0,1,"いか"],[5,1,"はげ"],[8,1,"もの"],[10,1,"ばつ"],[19,1,"かれ"],[21,1,"すく"],[34,1,"かえ"]],"text":"怒ることの激しい者は罰をうける、たとい彼を救ってやっても、さらにくり返さねばならない。"},{"ref":"Prov.19.20","start":20019020,"end":20019020,"break":"line","breaks":[[13,"line"]],"ruby":[[0,1,"すす"],[3,1,"き"],[6,2,"きょうくん"],[23,2,"ちえ"],[27,1,"もの"]],"text":"勧めを聞き、教訓をうけよ、そうすれば、ついには知恵ある者となる。"},{"ref":"Prov.19.21","start":20019021,"end":20019021,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"ひと"],[2,1,"こころ"],[5,1,"おお"],[8,2,"けいかく"],[19,1,"しゅ"],[23,1,"むね"],[27,1,"かた"],[29,1,"た"]],"text":"人の心には多くの計画がある、しかしただ主の、み旨だけが堅く立つ。"},{"ref":"Prov.19.22","start":20019022,"end":20019022,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"ひと"],[2,1,"のぞ"],[14,1,"ふか"],[22,1,"まず"],[25,1,"ひと"],[27,1,"いつわ"],[32,1,"ひと"]],"text":"人に望ましいのは、いつくしみ深いことである、貧しい人は偽りをいう人にまさる。"},{"ref":"Prov.19.23","start":20019023,"end":20019023,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"おそ"],[8,1,"ひと"],[10,1,"いのち"],[12,1,"いた"],[16,1,"つね"],[18,1,"あ"],[20,1,"た"],[24,1,"わざわい"]],"text":"主を恐れることは人を命に至らせ、常に飽き足りて、災にあうことはない。"},{"ref":"Prov.19.24","start":20019024,"end":20019024,"break":"line","breaks":[[15,"line"]],"ruby":[[3,1,"もの"],[6,1,"て"],[8,1,"さら"],[10,1,"い"],[18,1,"くち"],[20,1,"も"]],"text":"なまけ者は、手を皿に入れても、それを口に持ってゆくことをしない。"},{"ref":"Prov.19.25","start":20019025,"end":20019025,"break":"line","breaks":[[24,"line"]],"ruby":[[4,1,"もの"],[6,1,"う"],[14,2,"しりょ"],[19,1,"もの"],[21,1,"つつし"],[27,1,"もの"],[29,1,"いまし"],[38,1,"かれ"],[40,2,"ちしき"],[43,1,"え"]],"text":"あざける者を打て、そうすれば思慮のない者も慎む。さとき者を戒めよ、そうすれば彼は知識を得る。"},{"ref":"Prov.19.26","start":20019026,"end":20019026,"break":"line","breaks":[[19,"line"]],"ruby":[[0,1,"ちち"],[2,2,"らんぼう"],[10,1,"はは"],[12,1,"お"],[14,1,"だ"],[16,1,"もの"],[19,1,"はじ"],[35,1,"こ"]],"text":"父に乱暴をはたらき、母を追い出す者は、恥をきたらし、はずかしめをまねく子である。"},{"ref":"Prov.19.27","start":20019027,"end":20019027,"break":"line","breaks":[[21,"line"]],"ruby":[[2,1,"こ"],[5,2,"ちしき"],[8,2,"ことば"],[15,1,"ひと"],[17,1,"まよ"],[21,2,"きょうくん"],[24,1,"き"]],"text":"わが子よ、知識の言葉をはなれて人を迷わせる教訓を聞くことをやめよ。"},{"ref":"Prov.19.28","start":20019028,"end":20019028,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"わる"],[2,2,"しょうにん"],[14,1,"あ"],[17,1,"もの"],[19,1,"くち"],[21,1,"あく"],[27,1,"く"]],"text":"悪い証人はさばきをあざけり、悪しき者の口は悪をむさぼり食う。"},{"ref":"Prov.19.29","start":20019029,"end":20019029,"break":"line","breaks":[[18,"line"]],"ruby":[[8,1,"もの"],[13,1,"そな"],[21,1,"おろ"],[24,1,"もの"],[26,1,"せ"],[31,1,"そな"]],"text":"さばきはあざける者のために備えられ、むちは愚かな者の背のために備えられる。"}]