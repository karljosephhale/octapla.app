[{"ref":"John.13.1","start":43013001,"end":43013001,"break":"paragraph","ruby":[[0,2,"すぎこし"],[3,1,"まつり"],[5,1,"まえ"],[15,1,"よ"],[17,1,"さ"],[20,1,"ちち"],[26,1,"い"],[30,2,"じぶん"],[33,1,"とき"],[40,1,"し"],[43,1,"よ"],[47,2,"じぶん"],[50,1,"もの"],[54,1,"あい"],[58,1,"かれ"],[61,2,"さいご"],[65,1,"あい"],[67,1,"とお"]],"text":"過越の祭の前に、イエスは、この世を去って父のみもとに行くべき自分の時がきたことを知り、世にいる自分の者たちを愛して、彼らを最後まで愛し通された。"},{"ref":"John.13.2","start":43013002,"end":43013002,"break":"none","ruby":[[0,2,"ゆうしょく"],[6,2,"あくま"],[16,1,"こ"],[27,1,"こころ"],[34,2,"うらぎ"],[41,1,"おも"],[44,1,"い"]],"text":"夕食のとき、悪魔はすでにシモンの子イスカリオテのユダの心に、イエスを裏切ろうとする思いを入れていたが、"},{"ref":"John.13.3","start":43013003,"end":43013003,"break":"none","ruby":[[5,1,"ちち"],[14,2,"じぶん"],[17,1,"て"],[20,1,"あた"],[32,2,"じぶん"],[35,1,"かみ"],[38,1,"で"],[43,1,"かみ"],[57,1,"おも"]],"text":"イエスは、父がすべてのものを自分の手にお与えになったこと、また、自分は神から出てきて、神にかえろうとしていることを思い、"},{"ref":"John.13.4","start":43013004,"end":43013004,"break":"none","ruby":[[0,2,"ゆうしょく"],[3,1,"せき"],[6,1,"た"],[8,1,"あ"],[13,2,"うわぎ"],[16,1,"ぬ"],[19,1,"て"],[27,1,"こし"],[29,1,"ま"]],"text":"夕食の席から立ち上がって、上着を脱ぎ、手ぬぐいをとって腰に巻き、"},{"ref":"John.13.5","start":43013005,"end":43013005,"break":"none","ruby":[[4,1,"みず"],[10,1,"い"],[14,2,"でし"],[19,1,"あし"],[21,1,"あら"],[24,1,"こし"],[26,1,"ま"],[29,1,"て"],[36,1,"はじ"]],"text":"それから水をたらいに入れて、弟子たちの足を洗い、腰に巻いた手ぬぐいでふき始められた。"},{"ref":"John.13.6","start":43013006,"end":43013006,"break":"none","ruby":[[13,1,"ばん"],[22,1,"かれ"],[30,1,"しゅ"],[41,1,"あし"],[44,1,"あら"],[55,1,"い"]],"text":"こうして、シモン・ペテロの番になった。すると彼はイエスに、「主よ、あなたがわたしの足をお洗いになるのですか」と言った。"},{"ref":"John.13.7","start":43013007,"end":43013007,"break":"none","ruby":[[4,1,"かれ"],[6,1,"こた"],[9,1,"い"],[26,1,"いま"]],"text":"イエスは彼に答えて言われた、「わたしのしていることは今あなたにはわからないが、あとでわかるようになるだろう」。"},{"ref":"John.13.8","start":43013008,"end":43013008,"break":"none","ruby":[[8,1,"い"],[17,1,"あし"],[19,1,"けっ"],[22,1,"あら"],[27,1,"くだ"],[36,1,"かれ"],[38,1,"こた"],[55,1,"あし"],[57,1,"あら"],[75,1,"かか"]],"text":"ペテロはイエスに言った、「わたしの足を決して洗わないで下さい」。イエスは彼に答えられた、「もしわたしがあなたの足を洗わないなら、あなたはわたしとなんの係わりもなくなる」。"},{"ref":"John.13.9","start":43013009,"end":43013009,"break":"none","ruby":[[12,1,"い"],[17,1,"しゅ"],[23,1,"あし"],[35,1,"て"],[37,1,"あたま"]],"text":"シモン・ペテロはイエスに言った、「主よ、では、足だけではなく、どうぞ、手も頭も」。"},{"ref":"John.13.10","start":43013010,"end":43013010,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[19,1,"あら"],[22,1,"もの"],[25,1,"あし"],[30,1,"あら"],[32,2,"ひつよう"],[38,2,"ぜんしん"]],"text":"イエスは彼に言われた、「すでにからだを洗った者は、足のほかは洗う必要がない。全身がきれいなのだから。あなたがたはきれいなのだ。しかし、みんながそうなのではない」。"},{"ref":"John.13.11","start":43013011,"end":43013011,"break":"none","ruby":[[4,2,"じぶん"],[7,2,"うらぎ"],[10,1,"もの"],[12,1,"し"],[40,1,"い"]],"text":"イエスは自分を裏切る者を知っておられた。それで、「みんながきれいなのではない」と言われたのである。"},{"ref":"John.13.12","start":43013012,"end":43013012,"break":"paragraph","ruby":[[4,1,"かれ"],[7,1,"あし"],[9,1,"あら"],[15,2,"うわぎ"],[25,1,"せき"],[32,1,"かれ"],[35,1,"い"]],"text":"こうして彼らの足を洗ってから、上着をつけ、ふたたび席にもどって、彼らに言われた、「わたしがあなたがたにしたことがわかるか。"},{"ref":"John.13.13","start":43013013,"end":43013013,"break":"none","ruby":[[10,2,"きょうし"],[15,1,"しゅ"],[17,1,"よ"],[25,1,"い"],[29,1,"ただ"]],"text":"あなたがたはわたしを教師、また主と呼んでいる。そう言うのは正しい。わたしはそのとおりである。"},{"ref":"John.13.14","start":43013014,"end":43013014,"break":"none","ruby":[[4,1,"しゅ"],[11,2,"きょうし"],[27,1,"あし"],[29,1,"あら"],[46,1,"たがい"],[48,1,"あし"],[50,1,"あら"],[52,1,"あ"]],"text":"しかし、主であり、また教師であるわたしが、あなたがたの足を洗ったからには、あなたがたもまた、互に足を洗い合うべきである。"},{"ref":"John.13.15","start":43013015,"end":43013015,"break":"none","ruby":[[33,2,"てほん"],[36,1,"しめ"]],"text":"わたしがあなたがたにしたとおりに、あなたがたもするように、わたしは手本を示したのだ。"},{"ref":"John.13.16","start":43013016,"end":43013016,"break":"none","ruby":[[10,1,"い"],[16,1,"しもべ"],[20,2,"しゅじん"],[39,1,"もの"],[46,1,"もの"]],"text":"よくよくあなたがたに言っておく。僕はその主人にまさるものではなく、つかわされた者はつかわした者にまさるものではない。"},{"ref":"John.13.17","start":43013017,"end":43013017,"break":"none","ruby":[[19,1,"おこな"]],"text":"もしこれらのことがわかっていて、それを行うなら、あなたがたはさいわいである。"},{"ref":"John.13.18","start":43013018,"end":43013018,"break":"none","ruby":[[5,2,"ぜんぶ"],[8,1,"もの"],[16,1,"い"],[31,2,"じぶん"],[34,1,"えら"],[37,1,"ひと"],[41,1,"し"],[59,1,"た"],[64,1,"もの"],[88,2,"せいしょ"],[91,2,"じょうじゅ"]],"text":"あなたがた全部の者について、こう言っているのではない。わたしは自分が選んだ人たちを知っている。しかし、『わたしのパンを食べている者が、わたしにむかってそのかかとをあげた』とある聖書は成就されなければならない。"},{"ref":"John.13.19","start":43013019,"end":43013019,"break":"none","ruby":[[7,1,"おこ"],[11,1,"いま"],[23,1,"い"],[33,1,"こと"],[35,1,"おこ"],[60,1,"しん"]],"text":"そのことがまだ起らない今のうちに、あなたがたに言っておく。いよいよ事が起ったとき、わたしがそれであることを、あなたがたが信じるためである。"},{"ref":"John.13.20","start":43013020,"end":43013020,"break":"none","ruby":[[10,1,"い"],[24,1,"もの"],[26,1,"う"],[31,1,"もの"],[38,1,"う"],[52,1,"う"],[57,1,"もの"],[74,1,"う"]],"text":"よくよくあなたがたに言っておく。わたしがつかわす者を受けいれる者は、わたしを受けいれるのである。わたしを受けいれる者は、わたしをつかわされたかたを、受けいれるのである」。"},{"ref":"John.13.21","start":43013021,"end":43013021,"break":"paragraph","ruby":[[11,1,"い"],[15,1,"のち"],[19,1,"こころ"],[21,1,"さわ"],[29,1,"い"],[45,1,"い"],[69,2,"うらぎ"]],"text":"イエスがこれらのことを言われた後、その心が騒ぎ、おごそかに言われた、「よくよくあなたがたに言っておく。あなたがたのうちのひとりが、わたしを裏切ろうとしている」。"},{"ref":"John.13.22","start":43013022,"end":43013022,"break":"none","ruby":[[0,2,"でし"],[11,1,"い"],[17,1,"さっ"],[23,1,"たがい"],[25,1,"かお"],[27,2,"みあ"]],"text":"弟子たちはだれのことを言われたのか察しかねて、互に顔を見合わせた。"},{"ref":"John.13.23","start":43013023,"end":43013023,"break":"none","ruby":[[0,2,"でし"],[14,1,"あい"],[21,1,"もの"],[25,1,"むね"],[27,1,"ちか"],[29,1,"せき"]],"text":"弟子たちのひとりで、イエスの愛しておられた者が、み胸に近く席についていた。"},{"ref":"John.13.24","start":43013024,"end":43013024,"break":"none","ruby":[[12,1,"かれ"],[14,2,"あいず"],[19,1,"い"],[39,1,"し"]],"text":"そこで、シモン・ペテロは彼に合図をして言った、「だれのことをおっしゃったのか、知らせてくれ」。"},{"ref":"John.13.25","start":43013025,"end":43013025,"break":"none","ruby":[[2,2,"でし"],[13,1,"むね"],[23,1,"しゅ"],[36,1,"たず"]],"text":"その弟子はそのままイエスの胸によりかかって、「主よ、だれのことですか」と尋ねると、"},{"ref":"John.13.26","start":43013026,"end":43013026,"break":"none","ruby":[[4,1,"こた"],[19,2,"しょくもつ"],[26,1,"あた"],[29,1,"もの"],[47,2,"しょくもつ"],[56,1,"あ"],[63,1,"こ"],[75,1,"あた"]],"text":"イエスは答えられた、「わたしが一きれの食物をひたして与える者が、それである」。そして、一きれの食物をひたしてとり上げ、シモンの子イスカリオテのユダにお与えになった。"},{"ref":"John.13.27","start":43013027,"end":43013027,"break":"none","ruby":[[6,2,"しょくもつ"],[9,1,"う"],[36,1,"かれ"],[38,1,"い"],[56,1,"いま"]],"text":"この一きれの食物を受けるやいなや、サタンがユダにはいった。そこでイエスは彼に言われた、「しようとしていることを、今すぐするがよい」。"},{"ref":"John.13.28","start":43013028,"end":43013028,"break":"none","ruby":[[0,1,"せき"],[2,1,"とも"],[8,1,"もの"],[20,1,"い"],[33,1,"もの"]],"text":"席を共にしていた者のうち、なぜユダにこう言われたのか、わかっていた者はひとりもなかった。"},{"ref":"John.13.29","start":43013029,"end":43013029,"break":"none","ruby":[[2,2,"ひとびと"],[9,2,"かねい"],[27,1,"かれ"],[31,1,"まつり"],[36,2,"ひつよう"],[42,1,"か"],[46,1,"い"],[57,1,"まず"],[60,1,"もの"],[62,1,"なに"],[64,1,"ほどこ"],[76,1,"おも"]],"text":"ある人々は、ユダが金入れをあずかっていたので、イエスが彼に、「祭のために必要なものを買え」と言われたか、あるいは、貧しい者に何か施させようとされたのだと思っていた。"},{"ref":"John.13.30","start":43013030,"end":43013030,"break":"none","ruby":[[7,2,"しょくもつ"],[10,1,"う"],[18,1,"で"],[20,1,"い"],[24,1,"とき"],[26,1,"よる"]],"text":"ユダは一きれの食物を受けると、すぐに出て行った。時は夜であった。"},{"ref":"John.13.31","start":43013031,"end":43013031,"break":"paragraph","ruby":[[3,1,"かれ"],[5,1,"で"],[7,1,"い"],[15,1,"い"],[21,1,"いま"],[23,1,"ひと"],[25,1,"こ"],[27,2,"えいこう"],[30,1,"う"],[34,1,"かみ"],[38,1,"かれ"],[43,2,"えいこう"],[47,1,"う"]],"text":"さて、彼が出て行くと、イエスは言われた、「今や人の子は栄光を受けた。神もまた彼によって栄光をお受けになった。"},{"ref":"John.13.32","start":43013032,"end":43013032,"break":"none","ruby":[[0,1,"かれ"],[5,2,"えいこう"],[9,1,"う"],[19,1,"かみ"],[21,2,"じしん"],[24,1,"かれ"],[26,2,"えいこう"],[30,1,"さづ"],[45,1,"さづ"]],"text":"彼によって栄光をお受けになったのなら、神ご自身も彼に栄光をお授けになるであろう。すぐにもお授けになるであろう。"},{"ref":"John.13.33","start":43013033,"end":43013033,"break":"none","ruby":[[0,1,"こ"],[22,2,"いっしょ"],[38,1,"さが"],[51,1,"じん"],[55,1,"い"],[62,1,"いま"],[70,1,"い"],[84,1,"い"],[86,1,"ところ"],[88,1,"く"]],"text":"子たちよ、わたしはまだしばらく、あなたがたと一緒にいる。あなたがたはわたしを捜すだろうが、すでにユダヤ人たちに言ったとおり、今あなたがたにも言う、『あなたがたはわたしの行く所に来ることはできない』。"},{"ref":"John.13.34","start":43013034,"end":43013034,"break":"none","ruby":[[5,1,"あたら"],[19,1,"あた"],[23,1,"たがい"],[25,1,"あい"],[27,1,"あ"],[43,1,"あい"],[56,1,"たがい"],[58,1,"あい"],[60,1,"あ"]],"text":"わたしは、新しいいましめをあなたがたに与える、互に愛し合いなさい。わたしがあなたがたを愛したように、あなたがたも互に愛し合いなさい。"},{"ref":"John.13.35","start":43013035,"end":43013035,"break":"none","ruby":[[0,1,"たがい"],[2,1,"あい"],[4,1,"あ"],[27,2,"でし"],[40,1,"もの"],[42,1,"みと"]],"text":"互に愛し合うならば、それによって、あなたがたがわたしの弟子であることを、すべての者が認めるであろう」。"},{"ref":"John.13.36","start":43013036,"end":43013036,"break":"paragraph","ruby":[[12,1,"い"],[17,1,"しゅ"],[39,1,"こた"],[54,1,"い"],[61,1,"いま"],[66,1,"く"],[92,1,"く"]],"text":"シモン・ペテロがイエスに言った、「主よ、どこへおいでになるのですか」。イエスは答えられた、「あなたはわたしの行くところに、今はついて来ることはできない。しかし、あとになってから、ついて来ることになろう」。"},{"ref":"John.13.37","start":43013037,"end":43013037,"break":"none","ruby":[[8,1,"い"],[13,1,"しゅ"],[19,1,"いま"],[27,1,"い"],[50,1,"いのち"],[52,1,"す"]],"text":"ペテロはイエスに言った、「主よ、なぜ、今あなたについて行くことができないのですか。あなたのためには、命も捨てます」。"},{"ref":"John.13.38","start":43013038,"end":43013038,"break":"none","ruby":[[4,1,"こた"],[18,1,"いのち"],[20,1,"す"],[24,1,"い"],[37,1,"い"],[43,1,"にわとり"],[45,1,"な"],[47,1,"まえ"],[59,1,"ど"],[60,1,"し"],[65,1,"い"]],"text":"イエスは答えられた、「わたしのために命を捨てると言うのか。よくよくあなたに言っておく。鶏が鳴く前に、あなたはわたしを三度知らないと言うであろう」。"}]