[{"ref":"Mic.4.1","start":33004001,"end":33004001,"break":"paragraph","breaks":[[8,"line"],[27,"line"],[34,"line"],[50,"line"]],"ruby":[[0,1,"すえ"],[2,1,"ひ"],[8,1,"しゅ"],[10,1,"いえ"],[12,1,"やま"],[19,1,"やま"],[27,1,"かた"],[29,1,"た"],[39,1,"みね"],[43,1,"たか"],[55,1,"たみ"],[60,1,"なが"]],"text":"末の日になって、主の家の山はもろもろの山のかしらとして堅く立てられ、もろもろの峰よりも高くあげられ、もろもろの民はこれに流れくる。"},{"ref":"Mic.4.2","start":33004002,"end":33004002,"break":"line","breaks":[[11,"line"],[27,"line"],[39,"line"],[53,"line"],[68,"line"],[78,"line"]],"ruby":[[0,1,"おお"],[3,2,"くにたみ"],[6,1,"き"],[8,1,"い"],[20,1,"しゅ"],[22,1,"やま"],[24,1,"のぼ"],[31,1,"かみ"],[33,1,"いえ"],[35,1,"い"],[39,1,"かれ"],[43,1,"みち"],[50,1,"おし"],[60,1,"みち"],[62,1,"あゆ"],[68,2,"りっぽう"],[76,1,"で"],[78,1,"しゅ"],[80,2,"ことば"],[90,1,"で"]],"text":"多くの国民は来て言う、「さあ、われわれは主の山に登り、ヤコブの神の家に行こう。彼はその道をわれわれに教え、われわれはその道に歩もう」と。律法はシオンから出、主の言葉はエルサレムから出るからである。"},{"ref":"Mic.4.3","start":33004003,"end":33004003,"break":"line","breaks":[[13,"line"],[32,"line"],[53,"line"],[69,"line"],[85,"line"]],"ruby":[[0,1,"かれ"],[2,1,"おお"],[5,1,"たみ"],[7,1,"あいだ"],[13,1,"とお"],[15,1,"ところ"],[18,1,"つよ"],[20,2,"くにぐに"],[26,2,"ちゅうさい"],[35,1,"かれ"],[42,1,"う"],[58,1,"う"],[69,1,"くに"],[71,1,"くに"],[85,1,"ふたた"],[87,1,"たたか"],[93,1,"まな"]],"text":"彼は多くの民の間をさばき、遠い所まで強い国々のために仲裁される。そこで彼らはつるぎを打ちかえて、すきとし、そのやりを打ちかえて、かまとし、国は国にむかってつるぎをあげず、再び戦いのことを学ばない。"},{"ref":"Mic.4.4","start":33004004,"end":33004004,"break":"line","breaks":[[17,"line"],[31,"line"],[44,"line"]],"ruby":[[0,1,"かれ"],[3,1,"みな"],[10,1,"き"],[12,1,"した"],[14,1,"ざ"],[24,1,"き"],[26,1,"した"],[31,1,"かれ"],[34,1,"おそ"],[39,1,"もの"],[47,2,"ばんぐん"],[50,1,"しゅ"],[54,1,"くち"],[56,1,"かた"]],"text":"彼らは皆そのぶどうの木の下に座し、そのいちじくの木の下にいる。彼らを恐れさせる者はない。これは万軍の主がその口で語られたことである。"},{"ref":"Mic.4.5","start":33004005,"end":33004005,"break":"stanza","breaks":[[22,"line"],[30,"line"]],"ruby":[[4,1,"たみ"],[12,1,"かみ"],[14,1,"な"],[19,1,"あゆ"],[35,1,"かみ"],[37,1,"しゅ"],[39,1,"な"],[50,1,"あゆ"]],"text":"すべての民はおのおのその神の名によって歩む。しかしわれわれはわれわれの神、主の名によって、とこしえに歩む。"},{"ref":"Mic.4.6","start":33004006,"end":33004006,"break":"stanza","breaks":[[13,"line"],[29,"line"],[43,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[9,1,"ひ"],[19,1,"あし"],[24,1,"もの"],[26,1,"あつ"],[33,1,"お"],[39,1,"もの"],[47,1,"くる"],[51,1,"もの"],[53,1,"あつ"]],"text":"主は言われる、その日には、わたしはかの足のなえた者を集め、またかの追いやられた者およびわたしが苦しめた者を集め、"},{"ref":"Mic.4.7","start":33004007,"end":33004007,"break":"line","breaks":[[16,"line"],[34,"line"],[51,"line"]],"ruby":[[2,1,"あし"],[7,1,"もの"],[9,1,"のこ"],[12,1,"たみ"],[16,1,"とお"],[18,1,"お"],[24,1,"もの"],[26,1,"つよ"],[28,2,"くにたみ"],[34,1,"しゅ"],[40,1,"やま"],[43,1,"いま"],[51,1,"かれ"],[54,1,"おさ"]],"text":"その足のなえた者を残れる民とし、遠く追いやられた者を強い国民とする。主はシオンの山で、今よりとこしえに彼らを治められる。"},{"ref":"Mic.4.8","start":33004008,"end":33004008,"break":"stanza","breaks":[[18,"line"],[34,"line"],[48,"line"]],"ruby":[[0,1,"ひつじ"],[2,1,"む"],[13,1,"むすめ"],[15,1,"やま"],[18,2,"いぜん"],[21,2,"しゅけん"],[28,1,"かえ"],[44,1,"むすめ"],[46,1,"くに"],[52,1,"かえ"]],"text":"羊の群れのやぐら、シオンの娘の山よ、以前の主権はあなたに帰ってくる。すなわちエルサレムの娘の国はあなたに帰ってくる。"},{"ref":"Mic.4.9","start":33004009,"end":33004009,"break":"stanza","breaks":[[16,"line"],[30,"line"],[44,"line"]],"ruby":[[0,1,"いま"],[5,1,"なに"],[11,1,"さけ"],[23,1,"おう"],[34,2,"そうだん"],[36,2,"あいて"],[39,1,"た"],[44,2,"さんぷ"],[50,1,"はげ"],[53,1,"いた"],[60,1,"とら"]],"text":"今あなたは何ゆえわめき叫ぶのか、あなたのうちに王がないのか。あなたの相談相手は絶えはて、産婦のように激しい痛みがあなたを捕えたのか。"},{"ref":"Mic.4.10","start":33004010,"end":33004010,"break":"line","breaks":[[7,"line"],[21,"line"],[37,"line"],[53,"line"],[66,"line"]],"ruby":[[4,1,"むすめ"],[7,2,"さんぷ"],[13,1,"くる"],[25,1,"いま"],[27,1,"まち"],[29,1,"で"],[31,1,"の"],[42,1,"い"],[55,1,"ところ"],[61,1,"すく"],[66,1,"しゅ"],[70,1,"ところ"],[76,1,"てき"],[78,1,"て"]],"text":"シオンの娘よ、産婦のように苦しんでうめけ。あなたは今、町を出て野にやどり、バビロンに行かなければならない。その所であなたは救われる。主はその所であなたを敵の手からあがなわれる。"},{"ref":"Mic.4.11","start":33004011,"end":33004011,"break":"stanza","breaks":[[23,"line"],[39,"line"]],"ruby":[[2,1,"おお"],[5,2,"くにたみ"],[12,1,"さか"],[16,1,"あつ"],[20,1,"い"],[31,1,"けが"],[44,1,"め"],[50,1,"み"],[54,1,"わら"]],"text":"いま多くの国民はあなたに逆らい、集まって言う、「どうかシオンが汚されるように、われわれの目がシオンを見てあざ笑うように」と。"},{"ref":"Mic.4.12","start":33004012,"end":33004012,"break":"line","breaks":[[15,"line"],[27,"line"],[47,"line"]],"ruby":[[3,1,"かれ"],[6,1,"しゅ"],[8,1,"おも"],[11,1,"し"],[19,2,"けいかく"],[22,1,"さと"],[31,1,"しゅ"],[33,1,"むぎ"],[34,1,"たば"],[36,1,"う"],[38,1,"ば"],[40,1,"あつ"],[47,1,"かれ"],[50,1,"あつ"],[58,1,"さと"]],"text":"しかし彼らは主の思いを知らず、またその計画を悟らない。すなわち主が麦束を打ち場に集めるように、彼らを集められることを悟らない。"},{"ref":"Mic.4.13","start":33004013,"end":33004013,"break":"line","breaks":[[16,"line"],[31,"line"],[46,"line"],[60,"line"],[75,"line"]],"ruby":[[4,1,"むすめ"],[7,1,"た"],[10,1,"う"],[24,1,"つの"],[26,1,"てつ"],[39,2,"せいどう"],[50,1,"おお"],[53,1,"たみ"],[55,1,"う"],[57,1,"くだ"],[60,1,"かれ"],[67,1,"もの"],[69,1,"しゅ"],[75,1,"かれ"],[78,1,"とみ"],[80,1,"ぜん"],[81,1,"ち"],[83,1,"しゅ"]],"text":"シオンの娘よ、立って打ちこなせ。わたしはあなたの角を鉄となし、あなたのひずめを青銅としよう。あなたは多くの民を打ち砕き、彼らのぶんどり物を主にささげ、彼らの富を全地の主にささげる。"}]