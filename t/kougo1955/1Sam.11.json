[{"ref":"1Sam.11.1","start":9011001,"end":9011001,"break":"paragraph","ruby":[[10,1,"のぼ"],[25,1,"せ"],[27,1,"かこ"],[35,2,"ひとびと"],[42,1,"い"],[52,2,"けいやく"],[55,1,"むす"],[75,1,"つか"]],"text":"アンモンびとナハシは上ってきて、ヤベシ・ギレアデを攻め囲んだ。ヤベシの人々はナハシに言った、「われわれと契約を結びなさい。そうすればわれわれはあなたに仕えます」。"},{"ref":"1Sam.11.2","start":9011002,"end":9011002,"break":"none","ruby":[[13,1,"かれ"],[16,1,"い"],[21,1,"つぎ"],[23,2,"じょうけん"],[32,2,"けいやく"],[35,1,"むす"],[58,1,"みぎ"],[60,1,"め"],[65,1,"と"],[69,1,"ぜん"]],"text":"しかしアンモンびとナハシは彼らに言った、「次の条件であなたがたと契約を結ぼう。すなわち、わたしが、あなたがたすべての右の目をえぐり取って、全イスラエルをはずかしめるということだ」。"},{"ref":"1Sam.11.3","start":9011003,"end":9011003,"break":"none","ruby":[[4,2,"ちょうろう"],[9,1,"かれ"],[11,1,"い"],[21,2,"なぬか"],[24,2,"ゆうよ"],[27,1,"あた"],[36,1,"ぜん"],[37,2,"りょうど"],[40,2,"ししゃ"],[43,1,"おく"],[48,1,"ゆる"],[66,1,"すく"],[68,1,"もの"],[72,1,"とき"],[74,2,"こうふく"]],"text":"ヤベシの長老たちは彼に言った、「われわれに七日の猶予を与え、イスラエルの全領土に使者を送ることを許してください。そしてもしわれわれを救う者がない時は降伏します」。"},{"ref":"1Sam.11.4","start":9011004,"end":9011004,"break":"none","ruby":[[4,2,"ししゃ"],[21,1,"こと"],[23,1,"たみ"],[25,1,"みみ"],[27,1,"つ"],[33,1,"たみ"],[37,1,"こえ"],[42,1,"な"]],"text":"こうして使者が、サウルのギベアにきて、この事を民の耳に告げたので、民はみな声をあげて泣いた。"},{"ref":"1Sam.11.5","start":9011005,"end":9011005,"break":"paragraph","ruby":[[2,1,"とき"],[7,1,"はたけ"],[10,1,"うし"],[28,1,"い"],[33,1,"たみ"],[35,1,"な"],[51,2,"ひとびと"],[54,1,"かれ"],[60,2,"ひとびと"],[63,1,"こと"],[65,1,"つ"]],"text":"その時サウルは畑から牛のあとについてきた。そしてサウルは言った、「民が泣いているのは、どうしたのか」。人々は彼にヤベシの人々の事を告げた。"},{"ref":"1Sam.11.6","start":9011006,"end":9011006,"break":"none","ruby":[[6,2,"ことば"],[9,1,"き"],[12,1,"とき"],[14,1,"かみ"],[16,1,"れい"],[18,1,"はげ"],[21,1,"かれ"],[23,1,"うえ"],[25,1,"のぞ"],[31,1,"かれ"],[33,1,"いか"],[42,1,"も"]],"text":"サウルがこの言葉を聞いた時、神の霊が激しく彼の上に臨んだので、彼の怒りははなはだしく燃えた。"},{"ref":"1Sam.11.7","start":9011007,"end":9011007,"break":"none","ruby":[[0,1,"かれ"],[7,1,"うし"],[15,1,"き"],[17,1,"さ"],[20,2,"ししゃ"],[23,1,"て"],[34,1,"ぜん"],[35,2,"りょうど"],[38,1,"おく"],[41,1,"い"],[64,1,"したが"],[67,1,"で"],[70,1,"もの"],[75,1,"うし"],[91,1,"たみ"],[93,1,"しゅ"],[95,1,"おそ"],[106,1,"で"]],"text":"彼は一くびきの牛をとり、それを切り裂き、使者の手によってイスラエルの全領土に送って言わせた、「だれであってもサウルとサムエルとに従って出ない者は、その牛がこのようにされるであろう」。民は主を恐れて、ひとりのように出てきた。"},{"ref":"1Sam.11.8","start":9011008,"end":9011008,"break":"none","ruby":[[11,1,"かぞ"],[22,2,"ひとびと"],[32,2,"ひとびと"]],"text":"サウルはベゼクでそれを数えたが、イスラエルの人々は三十万、ユダの人々は三万であった。"},{"ref":"1Sam.11.9","start":9011009,"end":9011009,"break":"none","ruby":[[3,2,"ひとびと"],[9,2,"ししゃ"],[14,1,"い"],[28,1,"ひと"],[32,1,"い"],[42,1,"ひ"],[44,1,"あつ"],[57,1,"すくい"],[59,1,"え"],[69,2,"ししゃ"],[72,1,"かえ"],[80,2,"ひとびと"],[83,1,"つ"],[89,1,"かれ"],[92,1,"よろこ"]],"text":"そして人々は、きた使者たちに言った、「ヤベシ・ギレアデの人にこう言いなさい、『あす、日の暑くなるころ、あなたがたは救を得るであろう』と」。使者が帰って、ヤベシの人々に告げたので、彼らは喜んだ。"},{"ref":"1Sam.11.10","start":9011010,"end":9011010,"break":"none","ruby":[[7,2,"ひとびと"],[10,1,"い"],[23,2,"こうふく"],[40,1,"よ"],[43,1,"おも"]],"text":"そこでヤベシの人々は言った、「あす、われわれは降伏します。なんでも、あなたがたが良いと思うことを、われわれにしてください」。"},{"ref":"1Sam.11.11","start":9011011,"end":9011011,"break":"none","ruby":[[0,1,"あ"],[3,1,"ひ"],[9,1,"たみ"],[14,2,"ぶたい"],[17,1,"わ"],[25,1,"てき"],[27,2,"じんえい"],[30,1,"せ"],[32,1,"い"],[35,1,"ひ"],[37,1,"あつ"],[53,1,"ころ"],[57,1,"い"],[59,1,"のこ"],[62,1,"もの"],[76,2,"いっしょ"]],"text":"明くる日、サウルは民を三つの部隊に分け、あかつきに敵の陣営に攻め入り、日の暑くなるころまで、アンモンびとを殺した。生き残った者はちりぢりになって、ふたり一緒にいるものはなかった。"},{"ref":"1Sam.11.12","start":9011012,"end":9011012,"break":"paragraph","ruby":[[2,1,"とき"],[4,1,"たみ"],[11,1,"い"],[34,1,"おさ"],[47,1,"い"],[63,2,"ひとびと"],[66,1,"ひ"],[68,1,"だ"],[83,2,"ひとびと"],[86,1,"ころ"]],"text":"その時、民はサムエルに言った、「さきに、『サウルがどうしてわれわれを治めることができようか』と言ったものはだれでしょうか。その人々を引き出してください。われわれはその人々を殺します」。"},{"ref":"1Sam.11.13","start":9011013,"end":9011013,"break":"none","ruby":[[7,1,"い"],[12,1,"しゅ"],[24,1,"すくい"],[26,1,"ほどこ"],[40,1,"ひと"],[42,1,"ころ"]],"text":"しかしサウルは言った、「主はきょう、イスラエルに救を施されたのですから、きょうは人を殺してはなりません」。"},{"ref":"1Sam.11.14","start":9011014,"end":9011014,"break":"none","ruby":[[8,1,"たみ"],[10,1,"い"],[23,1,"い"],[31,2,"おうこく"],[34,2,"いっしん"]],"text":"そこでサムエルは民に言った、「さあ、ギルガルへ行って、あそこで王国を一新しよう」。"},{"ref":"1Sam.11.15","start":9011015,"end":9011015,"break":"none","ruby":[[4,1,"たみ"],[13,1,"い"],[19,1,"ところ"],[21,1,"しゅ"],[23,1,"まえ"],[29,1,"おう"],[33,3,"しゅうおんさい"],[37,1,"しゅ"],[39,1,"まえ"],[55,2,"ひとびと"],[58,1,"みな"],[62,1,"ところ"],[64,1,"おお"],[67,1,"いわ"]],"text":"こうして民はみなギルガルへ行って、その所で主の前にサウルを王とし、酬恩祭を主の前にささげ、サウルとイスラエルの人々は皆、その所で大いに祝った。"}]