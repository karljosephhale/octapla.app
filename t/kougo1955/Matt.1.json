[{"ref":"Matt.1.1","start":40001001,"end":40001001,"break":"paragraph","ruby":[[6,1,"こ"],[14,1,"こ"],[25,2,"けいず"]],"text":"アブラハムの子であるダビデの子、イエス・キリストの系図。"},{"ref":"Matt.1.2","start":40001002,"end":40001002,"break":"paragraph","ruby":[[10,1,"ちち"],[23,1,"ちち"],[34,2,"きょうだい"],[40,1,"ちち"]],"text":"アブラハムはイサクの父であり、イサクはヤコブの父、ヤコブはユダとその兄弟たちとの父、"},{"ref":"Matt.1.3","start":40001003,"end":40001003,"break":"none","ruby":[[17,1,"ちち"],[28,1,"ちち"],[39,1,"ちち"]],"text":"ユダはタマルによるパレスとザラとの父、パレスはエスロンの父、エスロンはアラムの父、"},{"ref":"Matt.1.4","start":40001004,"end":40001004,"break":"none","ruby":[[10,1,"ちち"],[23,1,"ちち"],[35,1,"ちち"]],"text":"アラムはアミナダブの父、アミナダブはナアソンの父、ナアソンはサルモンの父、"},{"ref":"Matt.1.5","start":40001005,"end":40001005,"break":"none","ruby":[[15,1,"ちち"],[30,1,"ちち"],[41,1,"ちち"]],"text":"サルモンはラハブによるボアズの父、ボアズはルツによるオベデの父、オベデはエッサイの父、"},{"ref":"Matt.1.6","start":40001006,"end":40001006,"break":"none","breaks":[[16,"paragraph"]],"ruby":[[8,1,"おう"],[10,1,"ちち"],[24,1,"つま"],[33,1,"ちち"]],"text":"エッサイはダビデ王の父であった。ダビデはウリヤの妻によるソロモンの父であり、"},{"ref":"Matt.1.7","start":40001007,"end":40001007,"break":"none","ruby":[[11,1,"ちち"],[23,1,"ちち"],[32,1,"ちち"]],"text":"ソロモンはレハベアムの父、レハベアムはアビヤの父、アビヤはアサの父、"},{"ref":"Matt.1.8","start":40001008,"end":40001008,"break":"none","ruby":[[8,1,"ちち"],[19,1,"ちち"],[29,1,"ちち"]],"text":"アサはヨサパテの父、ヨサパテはヨラムの父、ヨラムはウジヤの父、"},{"ref":"Matt.1.9","start":40001009,"end":40001009,"break":"none","ruby":[[8,1,"ちち"],[18,1,"ちち"],[29,1,"ちち"]],"text":"ウジヤはヨタムの父、ヨタムはアハズの父、アハズはヒゼキヤの父、"},{"ref":"Matt.1.10","start":40001010,"end":40001010,"break":"none","ruby":[[9,1,"ちち"],[19,1,"ちち"],[29,1,"ちち"]],"text":"ヒゼキヤはマナセの父、マナセはアモンの父、アモンはヨシヤの父、"},{"ref":"Matt.1.11","start":40001011,"end":40001011,"break":"none","ruby":[[9,1,"うつ"],[23,2,"きょうだい"],[29,1,"ちち"]],"text":"ヨシヤはバビロンへ移されたころ、エコニヤとその兄弟たちとの父となった。"},{"ref":"Matt.1.12","start":40001012,"end":40001012,"break":"paragraph","ruby":[[5,1,"うつ"],[22,1,"ちち"],[39,1,"ちち"]],"text":"バビロンへ移されたのち、エコニヤはサラテルの父となった。サラテルはゾロバベルの父、"},{"ref":"Matt.1.13","start":40001013,"end":40001013,"break":"none","ruby":[[11,1,"ちち"],[24,1,"ちち"],[36,1,"ちち"]],"text":"ゾロバベルはアビウデの父、アビウデはエリヤキムの父、エリヤキムはアゾルの父、"},{"ref":"Matt.1.14","start":40001014,"end":40001014,"break":"none","ruby":[[8,1,"ちち"],[18,1,"ちち"],[29,1,"ちち"]],"text":"アゾルはサドクの父、サドクはアキムの父、アキムはエリウデの父、"},{"ref":"Matt.1.15","start":40001015,"end":40001015,"break":"none","ruby":[[11,1,"ちち"],[23,1,"ちち"],[33,1,"ちち"]],"text":"エリウデはエレアザルの父、エレアザルはマタンの父、マタンはヤコブの父、"},{"ref":"Matt.1.16","start":40001016,"end":40001016,"break":"none","ruby":[[8,1,"おっと"],[13,1,"ちち"],[40,1,"うま"]],"text":"ヤコブはマリヤの夫ヨセフの父であった。このマリヤからキリストといわれるイエスがお生れになった。"},{"ref":"Matt.1.17","start":40001017,"end":40001017,"break":"paragraph","ruby":[[17,1,"だい"],[19,1,"あ"],[25,1,"だい"],[37,1,"うつ"],[46,1,"だい"],[57,1,"うつ"],[72,1,"だい"]],"text":"だから、アブラハムからダビデまでの代は合わせて十四代、ダビデからバビロンへ移されるまでは十四代、そして、バビロンへ移されてからキリストまでは十四代である。"},{"ref":"Matt.1.18","start":40001018,"end":40001018,"break":"paragraph","ruby":[[9,2,"たんじょう"],[12,2,"しだい"],[22,1,"はは"],[31,2,"こんやく"],[41,2,"いっしょ"],[48,1,"まえ"],[51,2,"せいれい"],[57,2,"みおも"]],"text":"イエス・キリストの誕生の次第はこうであった。母マリヤはヨセフと婚約していたが、まだ一緒にならない前に、聖霊によって身重になった。"},{"ref":"Matt.1.19","start":40001019,"end":40001019,"break":"none","ruby":[[0,1,"おっと"],[5,1,"ただ"],[8,1,"ひと"],[16,2,"かのじょ"],[22,1,"おおや"],[30,1,"この"],[38,2,"りえん"],[44,2,"けっしん"]],"text":"夫ヨセフは正しい人であったので、彼女のことが公けになることを好まず、ひそかに離縁しようと決心した。"},{"ref":"Matt.1.20","start":40001020,"end":40001020,"break":"none","ruby":[[0,1,"かれ"],[7,1,"おも"],[19,1,"しゅ"],[21,1,"つかい"],[23,1,"ゆめ"],[25,1,"あらわ"],[28,1,"い"],[37,1,"こ"],[43,2,"しんぱい"],[53,1,"つま"],[57,1,"むか"],[66,2,"たいない"],[69,1,"やど"],[77,2,"せいれい"]],"text":"彼がこのことを思いめぐらしていたとき、主の使が夢に現れて言った、「ダビデの子ヨセフよ、心配しないでマリヤを妻として迎えるがよい。その胎内に宿っているものは聖霊によるのである。"},{"ref":"Matt.1.21","start":40001021,"end":40001021,"break":"none","ruby":[[0,2,"かのじょ"],[3,1,"おとこ"],[5,1,"こ"],[7,1,"う"],[16,1,"な"],[22,1,"な"],[29,1,"かれ"],[36,1,"たみ"],[45,1,"つみ"],[48,1,"すく"],[50,1,"もの"]],"text":"彼女は男の子を産むであろう。その名をイエスと名づけなさい。彼は、おのれの民をそのもろもろの罪から救う者となるからである」。"},{"ref":"Matt.1.22","start":40001022,"end":40001022,"break":"none","ruby":[[10,1,"おこ"],[16,1,"しゅ"],[18,3,"よげんしゃ"],[25,1,"い"],[32,2,"じょうじゅ"]],"text":"すべてこれらのことが起ったのは、主が預言者によって言われたことの成就するためである。すなわち、"},{"ref":"Matt.1.23","start":40001023,"end":40001023,"break":"stanza","breaks":[[24,"line"]],"ruby":[[1,1,"み"],[13,1,"おとこ"],[15,1,"こ"],[17,1,"う"],[26,1,"な"],[35,1,"よ"],[50,1,"かみ"],[55,1,"とも"],[64,2,"いみ"]],"text":"「見よ、おとめがみごもって男の子を産むであろう。その名はインマヌエルと呼ばれるであろう」。これは、「神われらと共にいます」という意味である。"},{"ref":"Matt.1.24","start":40001024,"end":40001024,"break":"none","ruby":[[4,1,"ねむ"],[11,1,"のち"],[14,1,"しゅ"],[16,1,"つかい"],[18,1,"めい"],[30,1,"つま"],[32,1,"むか"]],"text":"ヨセフは眠りからさめた後に、主の使が命じたとおりに、マリヤを妻に迎えた。"},{"ref":"Matt.1.25","start":40001025,"end":40001025,"break":"none","ruby":[[4,1,"こ"],[6,1,"うま"],[13,2,"かのじょ"],[16,1,"し"],[32,1,"こ"],[38,1,"な"]],"text":"しかし、子が生れるまでは、彼女を知ることはなかった。そして、その子をイエスと名づけた。"}]