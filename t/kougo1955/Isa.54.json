[{"ref":"Isa.54.1","start":23054001,"end":23054001,"break":"paragraph","breaks":[[18,"line"],[33,"line"],[45,"line"],[54,"line"]],"ruby":[[1,1,"こ"],[3,1,"う"],[15,1,"うた"],[18,1,"う"],[21,1,"くる"],[30,1,"もの"],[33,1,"こえ"],[35,1,"はな"],[38,1,"うた"],[45,1,"おっと"],[49,1,"もの"],[51,1,"こ"],[58,1,"もの"],[60,1,"こ"],[64,1,"おお"],[68,1,"しゅ"],[70,1,"い"]],"text":"「子を産まなかったうまずめよ、歌え。産みの苦しみをしなかった者よ、声を放って歌いよばわれ。夫のない者の子は、とついだ者の子よりも多い」と主は言われる。"},{"ref":"Isa.54.2","start":23054002,"end":23054002,"break":"line","breaks":[[15,"line"],[31,"line"],[49,"line"]],"ruby":[[5,2,"てんまく"],[8,2,"ばしょ"],[11,1,"ひろ"],[23,1,"まく"],[25,1,"は"],[31,1,"お"],[43,1,"つな"],[45,1,"なが"],[53,1,"くい"],[55,2,"きょうこ"]],"text":"「あなたの天幕の場所を広くし、あなたのすまいの幕を張りひろげ、惜しむことなく、あなたの綱を長くし、あなたの杭を強固にせよ。"},{"ref":"Isa.54.3","start":23054003,"end":23054003,"break":"line","breaks":[[13,"line"],[29,"line"]],"ruby":[[4,1,"みぎ"],[6,1,"ひだり"],[17,2,"しそん"],[25,1,"くに"],[27,1,"え"],[29,1,"あ"],[35,2,"まちまち"],[39,2,"じゅうみん"],[42,1,"み"]],"text":"あなたは右に左にひろがり、あなたの子孫はもろもろの国を獲、荒れすたれた町々をも住民で満たすからだ。"},{"ref":"Isa.54.4","start":23054004,"end":23054004,"break":"line","breaks":[[9,"line"],[22,"line"],[36,"line"],[55,"line"],[68,"line"],[83,"line"]],"ruby":[[0,1,"おそ"],[13,1,"は"],[59,1,"わか"],[61,1,"とき"],[63,1,"はじ"],[65,1,"わす"],[68,2,"かふ"],[74,1,"とき"],[83,1,"ふたた"],[85,1,"おも"],[87,1,"だ"]],"text":"恐れてはならない。あなたは恥じることがない。あわてふためいてはならない。あなたは、はずかしめられることがない。あなたは若い時の恥を忘れ、寡婦であった時のはずかしめを、再び思い出すことがない。"},{"ref":"Isa.54.5","start":23054005,"end":23054005,"break":"line","breaks":[[20,"line"],[29,"line"],[42,"line"],[55,"line"]],"ruby":[[4,1,"つく"],[8,1,"もの"],[14,1,"おっと"],[22,1,"な"],[24,2,"ばんぐん"],[27,1,"しゅ"],[39,1,"もの"],[48,2,"せいじゃ"],[55,1,"ぜん"],[56,1,"ち"],[58,1,"かみ"]],"text":"あなたを造られた者はあなたの夫であって、その名は万軍の主。あなたをあがなわれる者は、イスラエルの聖者であって、全地の神ととなえられる。"},{"ref":"Isa.54.6","start":23054006,"end":23054006,"break":"line","breaks":[[11,"line"],[32,"line"],[44,"line"]],"ruby":[[0,1,"す"],[5,1,"こころ"],[6,1,"かな"],[9,1,"つま"],[13,1,"わか"],[15,1,"とき"],[21,1,"だ"],[25,1,"つま"],[27,1,"まね"],[32,1,"しゅ"],[38,1,"まね"],[48,1,"かみ"],[50,1,"い"]],"text":"捨てられて心悲しむ妻、また若い時にとついで出された妻を招くように主はあなたを招かれた」とあなたの神は言われる。"},{"ref":"Isa.54.7","start":23054007,"end":23054007,"break":"line","breaks":[[21,"line"]],"ruby":[[13,1,"す"],[21,1,"おお"],[37,1,"あつ"]],"text":"「わたしはしばしばあなたを捨てたけれども、大いなるあわれみをもってあなたを集める。"},{"ref":"Isa.54.8","start":23054008,"end":23054008,"break":"line","breaks":[[11,"line"],[26,"line"],[41,"line"],[51,"line"]],"ruby":[[4,1,"いきどお"],[16,1,"かお"],[18,1,"かく"],[61,1,"しゅ"],[63,1,"い"]],"text":"あふれる憤りをもって、しばしわが顔を隠したけれども、とこしえのいつくしみをもって、あなたをあわれむ」とあなたをあがなわれる主は言われる。"},{"ref":"Isa.54.9","start":23054009,"end":23054009,"break":"line","breaks":[[20,"line"],[31,"line"],[48,"line"],[69,"line"]],"ruby":[[14,1,"とき"],[27,2,"こうずい"],[31,1,"ふたた"],[33,1,"ち"],[43,1,"ちか"],[58,1,"ふたた"],[64,1,"いか"],[69,1,"ふたた"],[75,1,"せ"],[80,1,"ちか"]],"text":"「このことはわたしにはノアの時のようだ。わたしはノアの洪水を、再び地にあふれさせないと誓ったが、そのように、わたしは再びあなたを怒らない、再びあなたを責めないと誓った。"},{"ref":"Isa.54.10","start":23054010,"end":23054010,"break":"line","breaks":[[12,"line"],[32,"line"],[52,"line"]],"ruby":[[0,1,"やま"],[2,1,"うつ"],[5,1,"おか"],[7,1,"うご"],[25,1,"うつ"],[32,2,"へいあん"],[35,1,"あた"],[40,2,"けいやく"],[43,1,"うご"],[62,1,"しゅ"],[64,1,"い"]],"text":"山は移り、丘は動いても、わがいつくしみはあなたから移ることなく、平安を与えるわが契約は動くことがない」とあなたをあわれまれる主は言われる。"},{"ref":"Isa.54.11","start":23054011,"end":23054011,"break":"paragraph","breaks":[[19,"line"],[28,"line"],[51,"line"]],"ruby":[[1,1,"くる"],[19,1,"なぐさ"],[22,1,"え"],[25,1,"もの"],[28,1,"み"],[46,1,"いし"],[61,1,"もとい"]],"text":"「苦しみをうけ、あらしにもてあそばれ、慰めを得ない者よ、見よ、わたしはアンチモニーであなたの石をすえ、サファイヤであなたの基をおき、"},{"ref":"Isa.54.12","start":23054012,"end":23054012,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[8,2,"せんとう"],[11,1,"つく"],[14,2,"こうぎょく"],[21,1,"もん"],[23,1,"つく"],[30,2,"じょうへき"],[38,2,"ほうせき"],[41,1,"つく"]],"text":"めのうであなたの尖塔を造り、紅玉であなたの門を造り、あなたの城壁をことごとく宝石で造る。"},{"ref":"Isa.54.13","start":23054013,"end":23054013,"break":"line","breaks":[[16,"line"]],"ruby":[[4,1,"こ"],[9,1,"しゅ"],[11,1,"おしえ"],[20,1,"こ"],[23,1,"おお"],[26,1,"さか"]],"text":"あなたの子らはみな主に教をうけ、あなたの子らは大いに栄える。"},{"ref":"Isa.54.14","start":23054014,"end":23054014,"break":"line","breaks":[[14,"line"],[34,"line"],[45,"line"]],"ruby":[[4,1,"ぎ"],[9,1,"かた"],[11,1,"た"],[20,1,"とお"],[25,1,"おそ"],[36,2,"きょうふ"],[40,1,"とお"],[52,1,"ちか"]],"text":"あなたは義をもって堅く立ち、しえたげから遠ざかって恐れることはない。また恐怖から遠ざかる、それはあなたに近づくことがないからである。"},{"ref":"Isa.54.15","start":23054015,"end":23054015,"break":"line","breaks":[[14,"line"],[26,"line"]],"ruby":[[3,1,"あらそ"],[6,1,"おこ"],[8,1,"もの"],[33,1,"あらそ"],[35,1,"もの"],[45,1,"たお"]],"text":"たとい争いを起す者があってもわたしによるのではない。すべてあなたと争う者は、あなたのゆえに倒れる。"},{"ref":"Isa.54.16","start":23054016,"end":23054016,"break":"line","breaks":[[13,"line"],[32,"line"],[42,"line"]],"ruby":[[0,1,"み"],[3,2,"すみび"],[6,1,"ふ"],[15,2,"もくてき"],[21,2,"ぶき"],[24,1,"つく"],[26,1,"だ"],[28,2,"かじ"],[36,2,"そうぞう"],[40,1,"もの"],[44,1,"あら"],[46,1,"ほろ"],[49,1,"もの"],[56,2,"そうぞう"],[60,1,"もの"]],"text":"見よ、炭火を吹きおこして、その目的にかなう武器を造り出す鍛冶は、わたしが創造した者、また荒し滅ぼす者も、わたしが創造した者である。"},{"ref":"Isa.54.17","start":23054017,"end":23054017,"break":"line","breaks":[[21,"line"],[31,"line"],[53,"line"],[64,"line"],[83,"line"],[102,"line"]],"ruby":[[7,1,"せ"],[13,1,"つく"],[17,2,"ぶき"],[23,2,"もくてき"],[26,1,"たっ"],[38,1,"さか"],[41,1,"た"],[45,1,"あらそ"],[47,1,"うった"],[50,1,"した"],[57,1,"と"],[59,1,"やぶ"],[67,1,"しゅ"],[74,1,"う"],[77,1,"し"],[78,1,"ぎょう"],[85,1,"かれ"],[93,1,"う"],[96,1,"ぎ"],[102,1,"しゅ"],[104,1,"い"]],"text":"すべてあなたを攻めるために造られる武器は、その目的を達しない。すべてあなたに逆らい立って、争い訴える舌は、あなたに説き破られる。これが主のしもべらの受ける嗣業であり、また彼らがわたしから受ける義である」と主は言われる。"}]