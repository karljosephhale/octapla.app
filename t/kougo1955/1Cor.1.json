[{"ref":"1Cor.1.1","start":46001001,"end":46001001,"break":"paragraph","ruby":[[0,1,"かみ"],[2,2,"みむね"],[7,1,"め"],[20,2,"しと"],[31,2,"きょうだい"]],"text":"神の御旨により召されてキリスト・イエスの使徒となったパウロと、兄弟ソステネから、"},{"ref":"1Cor.1.2","start":46001002,"end":46001002,"break":"none","ruby":[[7,1,"かみ"],[9,2,"きょうかい"],[23,1,"しゅ"],[33,2,"みな"],[36,1,"いた"],[38,1,"ところ"],[40,1,"よ"],[42,1,"もと"],[51,2,"ひとびと"],[54,1,"とも"],[75,2,"せいと"],[80,1,"め"],[104,1,"しゅ"],[111,1,"かれ"],[114,1,"しゅ"]],"text":"コリントにある神の教会、すなわち、わたしたちの主イエス・キリストの御名を至る所で呼び求めているすべての人々と共に、キリスト・イエスにあってきよめられ、聖徒として召されたかたがたへ。このキリストは、わたしたちの主であり、また彼らの主であられる。"},{"ref":"1Cor.1.3","start":46001003,"end":46001003,"break":"paragraph","ruby":[[6,1,"ちち"],[9,1,"かみ"],[11,1,"しゅ"],[23,1,"めぐ"],[26,2,"へいあん"]],"text":"わたしたちの父なる神と主イエス・キリストから、恵みと平安とが、あなたがたにあるように。"},{"ref":"1Cor.1.4","start":46001004,"end":46001004,"break":"paragraph","ruby":[[23,1,"あた"],[28,1,"かみ"],[30,1,"めぐ"],[33,1,"おも"],[40,1,"かみ"],[42,2,"かんしゃ"]],"text":"わたしは、あなたがたがキリスト・イエスにあって与えられた神の恵みを思って、いつも神に感謝している。"},{"ref":"1Cor.1.5","start":46001005,"end":46001005,"break":"none","ruby":[[32,2,"ことば"],[40,2,"ちしき"],[44,1,"めぐ"]],"text":"あなたがたはキリストにあって、すべてのことに、すなわち、すべての言葉にもすべての知識にも恵まれ、"},{"ref":"1Cor.1.6","start":46001006,"end":46001006,"break":"none","ruby":[[22,1,"たし"]],"text":"キリストのためのあかしが、あなたがたのうちに確かなものとされ、"},{"ref":"1Cor.1.7","start":46001007,"end":46001007,"break":"none","ruby":[[11,1,"めぐ"],[14,2,"たまもの"],[22,1,"か"],[37,1,"しゅ"],[47,1,"あらわ"],[52,1,"ま"],[54,1,"のぞ"]],"text":"こうして、あなたがたは恵みの賜物にいささかも欠けることがなく、わたしたちの主イエス・キリストの現れるのを待ち望んでいる。"},{"ref":"1Cor.1.8","start":46001008,"end":46001008,"break":"none","ruby":[[0,1,"しゅ"],[11,2,"さいご"],[15,1,"かた"],[28,1,"しゅ"],[38,1,"ひ"],[41,1,"せ"],[52,1,"もの"],[56,1,"くだ"]],"text":"主もまた、あなたがたを最後まで堅くささえて、わたしたちの主イエス・キリストの日に、責められるところのない者にして下さるであろう。"},{"ref":"1Cor.1.9","start":46001009,"end":46001009,"break":"none","ruby":[[0,1,"かみ"],[2,2,"しんじつ"],[17,1,"かみ"],[22,1,"め"],[26,2,"みこ"],[35,1,"しゅ"],[46,1,"まじ"]],"text":"神は真実なかたである。あなたがたは神によって召され、御子、わたしたちの主イエス・キリストとの交わりに、はいらせていただいたのである。"},{"ref":"1Cor.1.10","start":46001010,"end":46001010,"break":"paragraph","ruby":[[2,2,"きょうだい"],[14,1,"しゅ"],[24,1,"な"],[36,1,"すす"],[42,1,"かた"],[53,1,"たがい"],[55,1,"あいだ"],[57,2,"ぶんそう"],[67,1,"おな"],[69,1,"こころ"],[71,1,"おな"],[73,1,"おも"],[80,1,"かた"],[82,1,"むす"],[84,1,"あ"]],"text":"さて兄弟たちよ。わたしたちの主イエス・キリストの名によって、あなたがたに勧める。みな語ることを一つにし、お互の間に分争がないようにし、同じ心、同じ思いになって、堅く結び合っていてほしい。"},{"ref":"1Cor.1.11","start":46001011,"end":46001011,"break":"none","ruby":[[4,2,"きょうだい"],[10,1,"じつ"],[17,1,"いえ"],[19,1,"もの"],[31,1,"あいだ"],[33,1,"あらそ"],[39,1,"き"]],"text":"わたしの兄弟たちよ。実は、クロエの家の者たちから、あなたがたの間に争いがあると聞かされている。"},{"ref":"1Cor.1.12","start":46001012,"end":46001012,"break":"none","ruby":[[4,1,"い"],[62,1,"い"],[64,1,"あ"]],"text":"はっきり言うと、あなたがたがそれぞれ、「わたしはパウロにつく」「わたしはアポロに」「わたしはケパに」「わたしはキリストに」と言い合っていることである。"},{"ref":"1Cor.1.13","start":46001013,"end":46001013,"break":"none","ruby":[[11,1,"わ"],[33,3,"じゅうじか"],[66,1,"な"],[77,1,"う"]],"text":"キリストは、いくつにも分けられたのか。パウロは、あなたがたのために十字架につけられたことがあるのか。それとも、あなたがたは、パウロの名によってバプテスマを受けたのか。"},{"ref":"1Cor.1.14","start":46001014,"end":46001014,"break":"none","ruby":[[4,2,"かんしゃ"],[20,2,"いがい"],[45,1,"さづ"]],"text":"わたしは感謝しているが、クリスポとガイオ以外には、あなたがたのうちのだれにも、バプテスマを授けたことがない。"},{"ref":"1Cor.1.15","start":46001015,"end":46001015,"break":"none","ruby":[[13,1,"な"],[24,1,"う"],[35,1,"い"]],"text":"それはあなたがたがわたしの名によってバプテスマを受けたのだと、だれにも言われることのないためである。"},{"ref":"1Cor.1.16","start":46001016,"end":46001016,"break":"none","ruby":[[10,1,"いえ"],[12,1,"もの"],[24,1,"さづ"],[48,1,"さづ"],[51,1,"おぼ"]],"text":"もっとも、ステパナの家の者たちには、バプテスマを授けたことがある。しかし、そのほかには、だれにも授けた覚えがない。"},{"ref":"1Cor.1.17","start":46001017,"end":46001017,"break":"none","ruby":[[29,1,"さづ"],[39,2,"ふくいん"],[42,1,"の"],[44,1,"つた"],[56,2,"ちえ"],[59,2,"ことば"],[62,1,"もち"],[66,1,"の"],[68,1,"つた"],[87,3,"じゅうじか"],[91,2,"むりょく"]],"text":"いったい、キリストがわたしをつかわされたのは、バプテスマを授けるためではなく、福音を宣べ伝えるためであり、しかも知恵の言葉を用いずに宣べ伝えるためであった。それは、キリストの十字架が無力なものになってしまわないためなのである。"},{"ref":"1Cor.1.18","start":46001018,"end":46001018,"break":"paragraph","ruby":[[0,3,"じゅうじか"],[4,1,"ことば"],[7,1,"ほろ"],[9,1,"い"],[11,1,"もの"],[14,1,"おろ"],[21,1,"すくい"],[35,1,"かみ"],[37,1,"ちから"]],"text":"十字架の言は、滅び行く者には愚かであるが、救にあずかるわたしたちには、神の力である。"},{"ref":"1Cor.1.19","start":46001019,"end":46001019,"break":"none","breaks":[[9,"stanza"],[24,"line"]],"ruby":[[5,2,"せいしょ"],[14,2,"ちしゃ"],[17,2,"ちえ"],[20,1,"ほろ"],[24,1,"かしこ"],[26,1,"もの"],[28,1,"かしこ"],[42,1,"か"]],"text":"すなわち、聖書に、「わたしは知者の知恵を滅ぼし、賢い者の賢さをむなしいものにする」と書いてある。"},{"ref":"1Cor.1.20","start":46001020,"end":46001020,"break":"none","ruby":[[0,2,"ちしゃ"],[10,2,"がくしゃ"],[22,1,"よ"],[24,2,"ろんしゃ"],[34,1,"かみ"],[38,1,"よ"],[40,2,"ちえ"],[44,1,"おろ"]],"text":"知者はどこにいるか。学者はどこにいるか。この世の論者はどこにいるか。神はこの世の知恵を、愚かにされたではないか。"},{"ref":"1Cor.1.21","start":46001021,"end":46001021,"break":"none","ruby":[[2,1,"よ"],[5,2,"じぶん"],[8,2,"ちえ"],[14,1,"かみ"],[16,1,"みと"],[20,1,"いた"],[31,1,"かみ"],[33,2,"ちえ"],[46,1,"かみ"],[49,2,"せんきょう"],[52,1,"おろ"],[60,1,"しん"],[63,1,"もの"],[65,1,"すく"]],"text":"この世は、自分の知恵によって神を認めるに至らなかった。それは、神の知恵にかなっている。そこで神は、宣教の愚かさによって、信じる者を救うこととされたのである。"},{"ref":"1Cor.1.22","start":46001022,"end":46001022,"break":"none","ruby":[[3,1,"じん"],[9,1,"こ"],[16,1,"じん"],[18,2,"ちえ"],[21,1,"もと"]],"text":"ユダヤ人はしるしを請い、ギリシヤ人は知恵を求める。"},{"ref":"1Cor.1.23","start":46001023,"end":46001023,"break":"none","ruby":[[10,3,"じゅうじか"],[24,1,"の"],[26,1,"つた"],[41,1,"じん"],[53,3,"いほうじん"],[58,1,"おろ"]],"text":"しかしわたしたちは、十字架につけられたキリストを宣べ伝える。このキリストは、ユダヤ人にはつまずかせるもの、異邦人には愚かなものであるが、"},{"ref":"1Cor.1.24","start":46001024,"end":46001024,"break":"none","ruby":[[0,1,"め"],[4,1,"もの"],[5,2,"じしん"],[16,1,"じん"],[23,1,"じん"],[27,1,"かみ"],[29,1,"ちから"],[31,1,"かみ"],[33,2,"ちえ"]],"text":"召された者自身にとっては、ユダヤ人にもギリシヤ人にも、神の力、神の知恵たるキリストなのである。"},{"ref":"1Cor.1.25","start":46001025,"end":46001025,"break":"none","ruby":[[0,1,"かみ"],[2,1,"おろ"],[6,1,"ひと"],[10,1,"かしこ"],[13,1,"かみ"],[15,1,"よわ"],[18,1,"ひと"],[22,1,"つよ"]],"text":"神の愚かさは人よりも賢く、神の弱さは人よりも強いからである。"},{"ref":"1Cor.1.26","start":46001026,"end":46001026,"break":"paragraph","ruby":[[0,2,"きょうだい"],[12,1,"め"],[16,1,"とき"],[21,1,"かんが"],[30,2,"にんげん"],[32,1,"てき"],[36,2,"ちえ"],[41,1,"もの"],[43,1,"おお"],[49,2,"けんりょく"],[54,1,"もの"],[56,1,"おお"],[62,2,"みぶん"],[65,1,"たか"],[67,1,"もの"],[69,1,"おお"]],"text":"兄弟たちよ。あなたがたが召された時のことを考えてみるがよい。人間的には、知恵のある者が多くはなく、権力のある者も多くはなく、身分の高い者も多くはいない。"},{"ref":"1Cor.1.27","start":46001027,"end":46001027,"break":"none","ruby":[[5,1,"かみ"],[8,2,"ちしゃ"],[23,1,"よ"],[25,1,"おろ"],[28,1,"もの"],[30,1,"えら"],[33,1,"つよ"],[35,1,"もの"],[49,1,"よ"],[51,1,"よわ"],[53,1,"もの"],[55,1,"えら"]],"text":"それだのに神は、知者をはずかしめるために、この世の愚かな者を選び、強い者をはずかしめるために、この世の弱い者を選び、"},{"ref":"1Cor.1.28","start":46001028,"end":46001028,"break":"none","ruby":[[0,2,"ゆうりょく"],[3,1,"もの"],[5,2,"むりょく"],[8,1,"もの"],[18,1,"よ"],[20,2,"みぶん"],[23,1,"ひく"],[25,1,"もの"],[27,1,"かろ"],[35,1,"もの"],[42,1,"な"],[45,1,"ひと"],[48,1,"もの"],[54,1,"えら"]],"text":"有力な者を無力な者にするために、この世で身分の低い者や軽んじられている者、すなわち、無きに等しい者を、あえて選ばれたのである。"},{"ref":"1Cor.1.29","start":46001029,"end":46001029,"break":"none","ruby":[[7,2,"にんげん"],[12,1,"かみ"],[18,1,"ほこ"]],"text":"それは、どんな人間でも、神のみまえに誇ることがないためである。"},{"ref":"1Cor.1.30","start":46001030,"end":46001030,"break":"none","ruby":[[20,1,"かみ"],[34,1,"かみ"],[36,1,"た"],[48,2,"ちえ"],[54,1,"ぎ"],[56,1,"せい"]],"text":"あなたがたがキリスト・イエスにあるのは、神によるのである。キリストは神に立てられて、わたしたちの知恵となり、義と聖とあがないとになられたのである。"},{"ref":"1Cor.1.31","start":46001031,"end":46001031,"break":"none","ruby":[[5,1,"ほこ"],[7,1,"もの"],[9,1,"しゅ"],[11,1,"ほこ"],[15,1,"か"]],"text":"それは、「誇る者は主を誇れ」と書いてあるとおりである。"}]