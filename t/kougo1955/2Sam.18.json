[{"ref":"2Sam.18.1","start":10018001,"end":10018001,"break":"paragraph","ruby":[[6,2,"じぶん"],[9,1,"とも"],[13,1,"たみ"],[15,1,"しら"],[21,1,"うえ"],[24,1,"にん"],[26,1,"ちょう"],[29,1,"にん"],[31,1,"ちょう"],[33,1,"た"]],"text":"さてダビデは自分と共にいる民を調べて、その上に千人の長、百人の長を立てた。"},{"ref":"2Sam.18.2","start":10018002,"end":10018002,"break":"none","ruby":[[7,1,"たみ"],[15,1,"ぶん"],[23,1,"て"],[27,1,"ぶん"],[35,1,"こ"],[40,2,"きょうだい"],[48,1,"て"],[52,1,"ぶん"],[65,1,"て"],[76,1,"おう"],[78,1,"たみ"],[80,1,"い"],[91,1,"かなら"],[99,2,"いっしょ"],[102,1,"で"]],"text":"そしてダビデは民をつかわし、三分の一をヨアブの手に、三分の一をゼルヤの子ヨアブの兄弟アビシャイの手に、三分の一をガテびとイッタイの手にあずけた。こうして王は民に言った、「わたしもまた必ずあなたがたと一緒に出ます」。"},{"ref":"2Sam.18.3","start":10018003,"end":10018003,"break":"none","ruby":[[3,1,"たみ"],[5,1,"い"],[14,1,"で"],[35,1,"に"],[40,1,"かれ"],[48,1,"こころ"],[59,1,"なか"],[62,1,"し"],[72,1,"こころ"],[98,1,"ひと"],[113,1,"まち"],[115,1,"なか"],[123,1,"たす"],[130,1,"ほう"]],"text":"しかし民は言った、「あなたは出てはなりません。それはわれわれがどんなに逃げても、彼らはわれわれに心をとめず、われわれの半ばが死んでも、われわれに心をとめないからです。しかしあなたはわれわれの一万に等しいのです。それゆえあなたは町の中からわれわれを助けてくださる方がよろしい」。"},{"ref":"2Sam.18.4","start":10018004,"end":10018004,"break":"none","ruby":[[0,1,"おう"],[2,1,"かれ"],[5,1,"い"],[16,1,"もっと"],[18,1,"よ"],[21,1,"おも"],[41,1,"おう"],[43,1,"もん"],[50,1,"た"],[53,1,"たみ"],[55,1,"みな"],[61,1,"にん"],[68,1,"にん"],[73,1,"で"],[75,1,"い"]],"text":"王は彼らに言った、「あなたがたの最も良いと思うことをわたしはしましょう」。こうして王は門のかたわらに立ち、民は皆あるいは百人、あるいは千人となって出て行った。"},{"ref":"2Sam.18.5","start":10018005,"end":10018005,"break":"none","ruby":[[0,1,"おう"],[19,1,"めい"],[31,2,"わかもの"],[44,1,"あつか"],[51,1,"い"],[55,1,"おう"],[63,1,"こと"],[72,1,"ちょう"],[76,1,"めい"],[81,1,"とき"],[83,1,"たみ"],[85,1,"みな"],[86,1,"き"]],"text":"王はヨアブ、アビシャイおよびイッタイに命じて、「わたしのため、若者アブサロムをおだやかに扱うように」と言った。王がアブサロムの事についてすべての長たちに命じている時、民は皆聞いていた。"},{"ref":"2Sam.18.6","start":10018006,"end":10018006,"break":"paragraph","ruby":[[4,1,"たみ"],[12,1,"む"],[16,1,"の"],[18,1,"で"],[20,1,"い"],[29,1,"もり"],[31,1,"たたか"]],"text":"こうして民はイスラエルに向かって野に出て行き、エフライムの森で戦ったが、"},{"ref":"2Sam.18.7","start":10018007,"end":10018007,"break":"none","ruby":[[6,1,"たみ"],[10,1,"ところ"],[16,2,"けらい"],[21,1,"まえ"],[23,1,"やぶ"],[29,1,"ひ"],[32,1,"ところ"],[34,3,"せんししゃ"],[38,1,"おお"],[44,1,"およ"]],"text":"イスラエルの民はその所でダビデの家来たちの前に敗れた。その日その所に戦死者が多く、二万に及んだ。"},{"ref":"2Sam.18.8","start":10018008,"end":10018008,"break":"none","ruby":[[3,1,"たたか"],[12,1,"ち"],[18,1,"ひろ"],[25,1,"ひ"],[27,1,"もり"],[29,1,"ほろ"],[33,1,"もの"],[40,1,"ほろ"],[44,1,"もの"],[48,1,"おお"]],"text":"そして戦いはあまねくその地のおもてに広がった。この日、森の滅ぼした者は、つるぎの滅ぼした者よりも多かった。"},{"ref":"2Sam.18.9","start":10018009,"end":10018009,"break":"paragraph","ruby":[[12,2,"けらい"],[17,1,"い"],[19,1,"あ"],[25,1,"とき"],[32,2,"らば"],[35,1,"の"],[42,2,"らば"],[45,1,"おお"],[51,1,"き"],[54,1,"しげ"],[57,1,"えだ"],[59,1,"した"],[61,1,"とお"],[73,1,"あたま"],[80,1,"き"],[87,1,"かれ"],[89,2,"てんち"],[92,1,"あいだ"],[101,2,"らば"],[104,1,"かれ"],[106,1,"す"],[109,1,"す"],[112,1,"い"]],"text":"さてアブサロムはダビデの家来たちに行き会った。その時アブサロムは騾馬に乗っていたが、騾馬は大きいかしの木の、茂った枝の下を通ったので、アブサロムの頭がそのかしの木にかかって、彼は天地の間につりさがった。騾馬は彼を捨てて過ぎて行った。"},{"ref":"2Sam.18.10","start":10018010,"end":10018010,"break":"none","ruby":[[4,1,"ひと"],[9,1,"み"],[15,1,"つ"],[18,1,"い"],[37,1,"き"],[47,1,"み"]],"text":"ひとりの人がそれを見てヨアブに告げて言った、「わたしはアブサロムが、かしの木にかかっているのを見ました」。"},{"ref":"2Sam.18.11","start":10018011,"end":10018011,"break":"none","ruby":[[7,1,"つ"],[10,1,"ひと"],[12,1,"い"],[24,1,"み"],[45,1,"かれ"],[49,1,"ところ"],[52,1,"ち"],[54,1,"う"],[56,1,"おと"],[73,1,"ぎん"],[79,1,"おび"],[81,1,"すじ"],[83,1,"あた"]],"text":"ヨアブはそれを告げた人に言った、「あなたはそれを見たというのか。それなら、どうしてあなたは彼をその所で、地に撃ち落さなかったのか。わたしはあなたに銀十シケルと帯一筋を与えたであろうに」。"},{"ref":"2Sam.18.12","start":10018012,"end":10018012,"break":"none","ruby":[[2,1,"ひと"],[8,1,"い"],[20,1,"て"],[22,1,"ぎん"],[28,1,"う"],[33,1,"て"],[35,1,"だ"],[38,1,"おう"],[40,1,"こ"],[42,1,"てき"],[53,1,"おう"],[60,1,"き"],[93,2,"わかもの"],[101,2,"ほご"],[107,1,"めい"]],"text":"その人はヨアブに言った、「たといわたしの手に銀千シケルを受けても、手を出して王の子に敵することはしません。王はわれわれが聞いているところで、あなたとアビシャイとイッタイに、『わたしのため若者アブサロムを保護せよ』と命じられたからです。"},{"ref":"2Sam.18.13","start":10018013,"end":10018013,"break":"none","ruby":[[10,1,"かれ"],[12,1,"いのち"],[25,2,"なにごと"],[28,1,"おう"],[30,1,"かく"],[52,1,"た"],[59,1,"せ"]],"text":"もしわたしがそむいて彼の命をそこなったのであれば、何事も王に隠れることはありませんから、あなたはみずから立ってわたしを責められたでしょう」。"},{"ref":"2Sam.18.14","start":10018014,"end":10018014,"break":"none","ruby":[[17,1,"とも"],[32,1,"い"],[36,1,"て"],[39,1,"すじ"],[41,1,"な"],[46,1,"と"],[54,1,"き"],[63,1,"い"],[74,2,"しんぞう"],[80,1,"つ"],[82,1,"とお"]],"text":"そこで、ヨアブは「こうしてあなたと共にとどまってはおられない」と言って、手に三筋の投げやりを取り、あのかしの木にかかって、なお生きているアブサロムの心臓にこれを突き通した。"},{"ref":"2Sam.18.15","start":10018015,"end":10018015,"break":"none","ruby":[[4,2,"ぶき"],[7,1,"と"],[10,1,"にん"],[12,2,"わかもの"],[17,1,"と"],[19,1,"ま"],[29,1,"う"],[31,1,"ころ"]],"text":"ヨアブの武器を執る十人の若者たちは取り巻いて、アブサロムを撃ち殺した。"},{"ref":"2Sam.18.16","start":10018016,"end":10018016,"break":"paragraph","ruby":[[12,1,"ふ"],[18,1,"たみ"],[29,1,"お"],[37,1,"かえ"],[45,1,"たみ"],[47,1,"ひ"]],"text":"こうしてヨアブがラッパを吹いたので、民はイスラエルのあとを追うことをやめて帰った。ヨアブが民を引きとめたからである。"},{"ref":"2Sam.18.17","start":10018017,"end":10018017,"break":"none","ruby":[[0,2,"ひとびと"],[9,1,"と"],[13,1,"もり"],[15,1,"なか"],[17,1,"おお"],[20,1,"あな"],[22,1,"な"],[29,1,"うえ"],[36,1,"おお"],[39,2,"いしづか"],[42,1,"つ"],[44,1,"あ"],[65,2,"てんまく"],[68,1,"に"],[70,1,"かえ"]],"text":"人々はアブサロムを取って、森の中の大きな穴に投げいれ、その上にひじょうに大きい石塚を積み上げた。そしてイスラエルはみなおのおのその天幕に逃げ帰った。"},{"ref":"2Sam.18.18","start":10018018,"end":10018018,"break":"none","ruby":[[8,1,"い"],[13,1,"あいだ"],[16,1,"おう"],[18,1,"たに"],[20,2,"じぶん"],[29,1,"はしら"],[31,1,"た"],[38,1,"かれ"],[46,2,"じぶん"],[49,1,"な"],[51,1,"つた"],[54,1,"こ"],[60,1,"おも"],[69,1,"かれ"],[73,1,"はしら"],[75,2,"じぶん"],[78,1,"な"],[86,1,"はしら"],[88,2,"こんにち"],[98,1,"いしぶみ"]],"text":"さてアブサロムは生きている間に、王の谷に自分のために一つの柱を建てた。それは彼が、「わたしは自分の名を伝える子がない」と思ったからである。彼はその柱に自分の名をつけた。その柱は今日までアブサロムの碑ととなえられている。"},{"ref":"2Sam.18.19","start":10018019,"end":10018019,"break":"paragraph","ruby":[[6,1,"こ"],[13,1,"い"],[22,1,"はし"],[25,1,"い"],[29,1,"しゅ"],[31,1,"おう"],[33,1,"てき"],[35,1,"て"],[38,1,"すく"],[40,1,"だ"],[49,1,"おう"],[51,1,"つた"]],"text":"さてザドクの子アヒマアズは言った、「わたしは走って行って、主が王を敵の手から救い出されたおとずれを王に伝えましょう」。"},{"ref":"2Sam.18.20","start":10018020,"end":10018020,"break":"none","ruby":[[4,1,"かれ"],[6,1,"い"],[21,1,"つた"],[35,1,"つた"],[44,1,"ひ"],[55,1,"おう"],[57,1,"こ"],[59,1,"し"],[70,1,"つた"]],"text":"ヨアブは彼に言った、「きょうは、おとずれを伝えてはならない。おとずれを伝えるのは、ほかの日にしなさい。きょうは王の子が死んだので、おとずれを伝えてはならない」。"},{"ref":"2Sam.18.21","start":10018021,"end":10018021,"break":"none","ruby":[[9,1,"い"],[14,1,"い"],[22,1,"み"],[24,1,"こと"],[26,1,"おう"],[28,1,"つ"],[44,1,"れい"],[48,1,"はし"],[51,1,"い"]],"text":"ヨアブはクシびとに言った、「行って、あなたの見た事を王に告げなさい」。クシびとはヨアブに礼をして走って行った。"},{"ref":"2Sam.18.22","start":10018022,"end":10018022,"break":"none","ruby":[[4,1,"こ"],[11,1,"かさ"],[18,1,"い"],[23,2,"なにごと"],[46,1,"はし"],[49,1,"い"],[63,1,"い"],[68,1,"こ"],[76,1,"むく"],[79,1,"え"],[95,1,"はし"],[98,1,"い"]],"text":"ザドクの子アヒマアズは重ねてヨアブに言った、「何事があろうとも、わたしにもクシびとのあとから走って行かせてください」。ヨアブは言った、「子よ、おとずれの報いを得られないのに、どうしてあなたは走って行こうとするのか」。"},{"ref":"2Sam.18.23","start":10018023,"end":10018023,"break":"none","ruby":[[0,1,"かれ"],[2,1,"い"],[7,2,"なにごと"],[20,1,"はし"],[23,1,"い"],[33,1,"かれ"],[35,1,"い"],[40,1,"はし"],[43,1,"い"],[59,2,"ていち"],[62,1,"みち"],[64,1,"はし"],[67,1,"い"],[75,1,"お"],[77,1,"こ"]],"text":"彼は言った、「何事があろうとも、わたしは走って行きます」。ヨアブは彼に言った、「走って行きなさい」。そこでアヒマアズは低地の道を走って行き、クシびとを追い越した。"},{"ref":"2Sam.18.24","start":10018024,"end":10018024,"break":"paragraph","ruby":[[0,1,"とき"],[9,1,"もん"],[11,1,"あいだ"],[23,2,"みは"],[27,1,"もの"],[29,2,"じょうへき"],[32,1,"もん"],[34,2,"やね"],[41,1,"め"],[46,1,"み"],[58,1,"はし"],[63,1,"もの"]],"text":"時にダビデは二つの門の間にすわっていた。そして見張りの者が城壁の門の屋根にのぼり、目をあげて見ていると、ただひとりで走ってくる者があった。"},{"ref":"2Sam.18.25","start":10018025,"end":10018025,"break":"none","ruby":[[0,2,"みは"],[4,1,"もの"],[6,1,"よ"],[11,1,"おう"],[13,1,"つ"],[19,1,"おう"],[21,1,"い"],[37,1,"くち"],[54,1,"ひと"],[56,1,"いそ"],[61,1,"ちか"]],"text":"見張りの者が呼ばわって王に告げたので、王は言った、「もしひとりならば、その口におとずれがあるであろう」。その人は急いできて近づいた。"},{"ref":"2Sam.18.26","start":10018026,"end":10018026,"break":"none","ruby":[[0,2,"みは"],[4,1,"もの"],[15,1,"はし"],[22,1,"み"],[27,1,"もん"],[29,1,"ほう"],[31,1,"よ"],[36,1,"い"],[41,1,"み"],[53,1,"はし"],[56,1,"く"],[58,1,"もの"],[66,1,"おう"],[68,1,"い"],[73,1,"かれ"],[82,1,"も"]],"text":"見張りの者は、ほかにまたひとり走ってくるのを見たので、門の方に呼ばわって言った、「見よ、ほかにただひとりで走って来る者があります」。王は言った、「彼もまたおとずれを持ってくるのだ」。"},{"ref":"2Sam.18.27","start":10018027,"end":10018027,"break":"none","ruby":[[0,2,"みは"],[4,1,"もの"],[6,1,"い"],[13,1,"さき"],[15,1,"はし"],[18,1,"く"],[20,1,"ひと"],[26,1,"こ"],[39,1,"おう"],[41,1,"い"],[46,1,"かれ"],[48,1,"よ"],[50,1,"ひと"],[53,1,"よ"],[60,1,"も"]],"text":"見張りの者は言った、「まっ先に走って来る人はザドクの子アヒマアズのようです」。王は言った、「彼は良い人だ。良いおとずれを持ってくるであろう」。"},{"ref":"2Sam.18.28","start":10018028,"end":10018028,"break":"paragraph","ruby":[[0,1,"とき"],[8,1,"よ"],[13,1,"おう"],[15,1,"い"],[20,2,"へいあん"],[38,1,"おう"],[40,1,"まえ"],[42,1,"ち"],[46,1,"ふ"],[49,1,"い"],[58,1,"かみ"],[60,1,"しゅ"],[69,1,"しゅ"],[71,1,"おう"],[75,1,"きみ"],[77,1,"てき"],[80,1,"て"],[85,2,"ひとびと"],[88,1,"ひ"],[90,1,"わた"]],"text":"時にアヒマアズは呼ばわって王に言った、「平安でいらせられますように」。そして王の前に地にひれ伏して言った、「あなたの神、主はほむべきかな。主は王、わが君に敵して手をあげた人々を引き渡されました」。"},{"ref":"2Sam.18.29","start":10018029,"end":10018029,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[7,2,"わかもの"],[15,2,"へいあん"],[28,1,"こた"],[45,1,"とき"],[51,1,"おお"],[54,1,"さわ"],[57,1,"み"],[63,2,"なにごと"],[70,1,"し"]],"text":"王は言った、「若者アブサロムは平安ですか」。アヒマアズは答えた、「ヨアブがしもべをつかわす時、わたしは大きな騒ぎを見ましたが、何事であったか知りません」。"},{"ref":"2Sam.18.30","start":10018030,"end":10018030,"break":"none","ruby":[[0,1,"おう"],[2,1,"い"],[10,1,"い"],[17,1,"た"],[26,1,"かれ"],[31,1,"い"],[34,1,"た"]],"text":"王は言った、「わきへ行って、そこに立っていなさい」。彼はわきへ行って立った。"},{"ref":"2Sam.18.31","start":10018031,"end":10018031,"break":"paragraph","ruby":[[2,1,"とき"],[21,1,"い"],[28,1,"きみ"],[30,1,"おう"],[32,1,"よ"],[40,1,"う"],[49,1,"しゅ"],[62,1,"てき"],[65,1,"た"],[68,1,"もの"],[72,1,"て"],[80,1,"すく"],[82,1,"だ"]],"text":"その時クシびとがきた。そしてそのクシびとは言った、「わが君、王が良いおとずれをお受けくださるよう。主はきょう、すべてあなたに敵して立った者どもの手から、あなたを救い出されたのです」。"},{"ref":"2Sam.18.32","start":10018032,"end":10018032,"break":"none","ruby":[[0,1,"おう"],[7,1,"い"],[12,2,"わかもの"],[20,2,"へいあん"],[32,1,"こた"],[37,1,"おう"],[41,1,"きみ"],[43,1,"てき"],[55,1,"てき"],[58,1,"た"],[61,1,"がい"],[69,1,"もの"],[74,2,"わかもの"]],"text":"王はクシびとに言った、「若者アブサロムは平安ですか」。クシびとは答えた、「王、わが君の敵、およびすべてあなたに敵して立ち、害をしようとする者は、あの若者のようになりますように」。"},{"ref":"2Sam.18.33","start":10018033,"end":10018033,"break":"none","ruby":[[0,1,"おう"],[7,1,"かな"],[11,1,"もん"],[13,1,"うえ"],[18,1,"のぼ"],[21,1,"な"],[25,1,"かれ"],[27,1,"い"],[37,1,"い"],[44,1,"こ"],[54,1,"こ"],[58,1,"こ"],[73,1,"かわ"],[76,1,"し"],[94,1,"こ"],[99,1,"こ"]],"text":"王はひじょうに悲しみ、門の上のへやに上って泣いた。彼は行きながらこのように言った、「わが子アブサロムよ。わが子、わが子アブサロムよ。ああ、わたしが代って死ねばよかったのに。アブサロム、わが子よ、わが子よ」。"}]