[{"ref":"Dan.3.1","start":27003001,"end":27003001,"break":"paragraph","ruby":[[7,1,"おう"],[12,1,"きん"],[14,1,"ぞう"],[16,1,"つく"],[22,1,"たか"],[34,1,"はば"],[43,1,"かれ"],[52,1,"しゅう"],[57,2,"へいや"],[60,1,"た"]],"text":"ネブカデネザル王は一つの金の像を造った。その高さは六十キュビト、その幅は六キュビトで、彼はこれをバビロン州のドラの平野に立てた。"},{"ref":"Dan.3.2","start":27003002,"end":27003002,"break":"none","ruby":[[10,1,"おう"],[13,2,"そうとく"],[16,2,"ちょうかん"],[19,2,"ちじ"],[22,2,"さんぎ"],[25,1,"くら"],[26,1,"かん"],[28,2,"ほうかん"],[31,2,"こうそう"],[36,1,"しょ"],[37,1,"しゅう"],[39,2,"かんり"],[44,1,"め"],[46,1,"あつ"],[56,1,"おう"],[58,1,"た"],[63,1,"ぞう"],[65,2,"らくせい"],[67,1,"しき"],[69,1,"のぞ"]],"text":"そしてネブカデネザル王は、総督、長官、知事、参議、庫官、法官、高僧および諸州の官吏たちを召し集め、ネブカデネザル王の立てたこの像の落成式に臨ませようとした。"},{"ref":"Dan.3.3","start":27003003,"end":27003003,"break":"none","ruby":[[4,2,"そうとく"],[7,2,"ちょうかん"],[10,2,"ちじ"],[13,2,"さんぎ"],[16,1,"こ"],[17,1,"かん"],[19,2,"ほうかん"],[22,2,"こうそう"],[27,1,"しょ"],[28,1,"しゅう"],[30,2,"かんり"],[43,1,"おう"],[45,1,"た"],[48,1,"ぞう"],[50,2,"らくせい"],[52,1,"しき"],[54,1,"のぞ"],[67,1,"た"],[70,1,"ぞう"],[72,1,"まえ"],[74,1,"た"]],"text":"そこで、総督、長官、知事、参議、庫官、法官、高僧および諸州の官吏たちは、ネブカデネザル王の立てた像の落成式に臨み、そのネブカデネザルの立てた像の前に立った。"},{"ref":"Dan.3.4","start":27003004,"end":27003004,"break":"none","ruby":[[0,1,"とき"],[2,2,"でんれい"],[4,1,"しゃ"],[6,2,"おおごえ"],[9,1,"よ"],[14,1,"い"],[19,2,"しょみん"],[22,1,"しょ"],[23,1,"ぞく"],[25,2,"しょこく"],[27,1,"ご"],[29,1,"もの"],[40,1,"めい"]],"text":"時に伝令者は大声に呼ばわって言った、「諸民、諸族、諸国語の者よ、あなたがたにこう命じられる。"},{"ref":"Dan.3.5","start":27003005,"end":27003005,"break":"none","ruby":[[0,2,"つのぶえ"],[3,2,"よこぶえ"],[6,1,"こと"],[8,3,"さんかくごと"],[12,2,"たてごと"],[15,2,"かざぶえ"],[26,2,"がっき"],[29,1,"ね"],[31,1,"き"],[33,1,"とき"],[38,1,"ふ"],[48,1,"おう"],[50,1,"た"],[53,1,"きん"],[55,1,"ぞう"],[57,1,"おが"]],"text":"角笛、横笛、琴、三角琴、立琴、風笛などの、もろもろの楽器の音を聞く時は、ひれ伏してネブカデネザル王の立てた金の像を拝まなければならない。"},{"ref":"Dan.3.6","start":27003006,"end":27003006,"break":"none","ruby":[[6,1,"ふ"],[9,1,"おが"],[13,1,"もの"],[20,1,"ひ"],[22,1,"も"],[25,1,"ろ"],[27,1,"なか"],[29,1,"な"],[31,1,"こ"]],"text":"だれでもひれ伏して拝まない者は、ただちに火の燃える炉の中に投げ込まれる」と。"},{"ref":"Dan.3.7","start":27003007,"end":27003007,"break":"none","ruby":[[3,1,"たみ"],[9,2,"つのぶえ"],[12,2,"よこぶえ"],[15,1,"こと"],[17,3,"さんかくごと"],[21,2,"たてごと"],[24,2,"かざぶえ"],[35,2,"がっき"],[38,1,"ね"],[40,1,"き"],[44,2,"しょみん"],[47,1,"しょ"],[48,1,"ぞく"],[50,2,"しょこく"],[52,1,"ご"],[54,1,"もの"],[63,1,"ふ"],[74,1,"おう"],[76,1,"た"],[79,1,"きん"],[81,1,"ぞう"],[83,1,"おが"]],"text":"そこで民らはみな、角笛、横笛、琴、三角琴、立琴、風笛などの、もろもろの楽器の音を聞くや、諸民、諸族、諸国語の者たちはみな、ひれ伏して、ネブカデネザル王の立てた金の像を拝んだ。"},{"ref":"Dan.3.8","start":27003008,"end":27003008,"break":"paragraph","ruby":[[2,1,"とき"],[14,1,"すす"],[22,1,"ひと"],[29,1,"うった"]],"text":"その時、あるカルデヤびとらが進みきて、ユダヤ人をあしざまに訴えた。"},{"ref":"Dan.3.9","start":27003009,"end":27003009,"break":"none","ruby":[[4,1,"かれ"],[14,1,"おう"],[16,1,"い"],[21,1,"おう"],[29,1,"い"]],"text":"すなわち彼らはネブカデネザル王に言った、「王よ、とこしえに生きながらえられますように。"},{"ref":"Dan.3.10","start":27003010,"end":27003010,"break":"none","ruby":[[0,1,"おう"],[7,2,"めいれい"],[10,1,"だ"],[13,1,"おお"],[25,2,"つのぶえ"],[28,2,"よこぶえ"],[31,1,"こと"],[33,3,"さんかくごと"],[37,2,"たてごと"],[40,2,"かざぶえ"],[51,2,"がっき"],[54,1,"ね"],[56,1,"き"],[58,1,"もの"],[60,1,"みな"],[64,1,"ふ"],[67,1,"きん"],[69,1,"ぞう"],[71,1,"おが"]],"text":"王よ、あなたは命令を出して仰せられました。すべて、角笛、横笛、琴、三角琴、立琴、風笛などの、もろもろの楽器の音を聞く者は皆、ひれ伏して金の像を拝まなければならない。"},{"ref":"Dan.3.11","start":27003011,"end":27003011,"break":"none","ruby":[[9,1,"ふ"],[12,1,"おが"],[16,1,"もの"],[21,1,"ひ"],[23,1,"も"],[26,1,"ろ"],[28,1,"なか"],[30,1,"な"],[32,1,"こ"]],"text":"また、だれでもひれ伏して拝まない者はみな、火の燃える炉の中に投げ込まれると。"},{"ref":"Dan.3.12","start":27003012,"end":27003012,"break":"none","ruby":[[7,2,"にんめい"],[16,1,"しゅう"],[18,2,"じむ"],[35,1,"ひと"],[60,1,"おう"],[65,2,"ひとびと"],[72,1,"たっと"],[80,2,"かみがみ"],[84,1,"つか"],[92,1,"た"],[97,1,"きん"],[99,1,"ぞう"],[102,1,"おが"]],"text":"ここにあなたが任命して、バビロン州の事務をつかさどらせられているユダヤ人シャデラク、メシャクおよびアベデネゴがおります。王よ、この人々はあなたを尊ばず、あなたの神々にも仕えず、あなたの立てられた金の像をも拝もうとしません」。"},{"ref":"Dan.3.13","start":27003013,"end":27003013,"break":"paragraph","ruby":[[11,1,"いか"],[15,1,"いきどお"],[38,1,"つ"],[44,1,"めい"],[52,2,"ひとびと"],[55,1,"おう"],[57,1,"まえ"],[59,1,"つ"]],"text":"そこでネブカデネザルは怒りかつ憤って、シャデラク、メシャクおよびアベデネゴを連れてこいと命じたので、この人々を王の前に連れてきた。"},{"ref":"Dan.3.14","start":27003014,"end":27003014,"break":"none","ruby":[[8,1,"かれ"],[11,1,"い"],[42,2,"かみがみ"],[45,1,"つか"],[55,1,"た"],[58,1,"きん"],[60,1,"ぞう"],[62,1,"おが"]],"text":"ネブカデネザルは彼らに言った、「シャデラク、メシャク、アベデネゴよ、あなたがたがわが神々に仕えず、またわたしの立てた金の像を拝まないとは、ほんとうなのか。"},{"ref":"Dan.3.15","start":27003015,"end":27003015,"break":"none","ruby":[[9,2,"つのぶえ"],[12,2,"よこぶえ"],[15,1,"こと"],[17,3,"さんかくごと"],[21,2,"たてごと"],[24,2,"かざぶえ"],[35,2,"がっき"],[38,1,"ね"],[40,1,"き"],[47,1,"ふ"],[55,1,"た"],[58,1,"ぞう"],[65,1,"おが"],[83,1,"おが"],[99,1,"ひ"],[101,1,"も"],[104,1,"ろ"],[106,1,"なか"],[108,1,"な"],[110,1,"こ"],[122,1,"かみ"],[129,1,"て"],[138,1,"すく"]],"text":"あなたがたがもし、角笛、横笛、琴、三角琴、立琴、風笛などの、もろもろの楽器の音を聞くときにひれ伏して、わたしが立てた像を、ただちに拝むならば、それでよろしい。しかし、拝むことをしないならば、ただちに火の燃える炉の中に投げ込まれる。いったい、どの神が、わたしの手からあなたがたを救うことができようか」。"},{"ref":"Dan.3.16","start":27003016,"end":27003016,"break":"paragraph","ruby":[[19,1,"おう"],[21,1,"こた"],[24,1,"い"],[40,1,"こと"],[47,1,"こた"],[51,2,"ひつよう"]],"text":"シャデラク、メシャクおよびアベデネゴは王に答えて言った、「ネブカデネザルよ、この事について、お答えする必要はありません。"},{"ref":"Dan.3.17","start":27003017,"end":27003017,"break":"none","ruby":[[18,1,"つか"],[23,1,"かみ"],[28,1,"ひ"],[30,1,"も"],[33,1,"ろ"],[43,1,"すく"],[45,1,"だ"],[57,1,"おう"],[64,1,"て"],[74,1,"すく"],[76,1,"だ"]],"text":"もしそんなことになれば、わたしたちの仕えている神は、その火の燃える炉から、わたしたちを救い出すことができます。また王よ、あなたの手から、わたしたちを救い出されます。"},{"ref":"Dan.3.18","start":27003018,"end":27003018,"break":"none","ruby":[[11,1,"おう"],[15,2,"しょうち"],[32,2,"かみがみ"],[35,1,"つか"],[45,1,"た"],[48,1,"きん"],[50,1,"ぞう"],[52,1,"おが"]],"text":"たといそうでなくても、王よ、ご承知ください。わたしたちはあなたの神々に仕えず、またあなたの立てた金の像を拝みません」。"},{"ref":"Dan.3.19","start":27003019,"end":27003019,"break":"paragraph","ruby":[[11,1,"いか"],[14,1,"み"],[41,2,"かおいろ"],[44,1,"か"],[47,1,"ろ"],[49,2,"へいじょう"],[55,1,"ばい"],[56,1,"あつ"],[61,1,"めい"]],"text":"そこでネブカデネザルは怒りに満ち、シャデラク、メシャクおよびアベデネゴにむかって、顔色を変え、炉を平常よりも七倍熱くせよと命じた。"},{"ref":"Dan.3.20","start":27003020,"end":27003020,"break":"none","ruby":[[4,2,"ぐんぜい"],[7,1,"なか"],[9,1,"ちから"],[11,1,"つよ"],[13,2,"ひとびと"],[16,1,"よ"],[39,1,"しば"],[43,1,"かれ"],[46,1,"ひ"],[48,1,"も"],[51,1,"ろ"],[53,1,"なか"],[55,1,"な"],[57,1,"こ"],[60,1,"めい"]],"text":"またその軍勢の中の力の強い人々を呼んで、シャデラク、メシャクおよびアベデネゴを縛って、彼らを火の燃える炉の中に投げ込めと命じた。"},{"ref":"Dan.3.21","start":27003021,"end":27003021,"break":"none","ruby":[[5,2,"ひとびと"],[9,2,"がいとう"],[12,2,"したぎ"],[15,2,"ぼうし"],[20,1,"た"],[22,2,"いふく"],[27,1,"しば"],[32,1,"ひ"],[34,1,"も"],[37,1,"ろ"],[39,1,"なか"],[41,1,"な"],[43,1,"こ"]],"text":"そこでこの人々は、外套、下着、帽子、その他の衣服のまま縛られて、火の燃える炉の中に投げ込まれた。"},{"ref":"Dan.3.22","start":27003022,"end":27003022,"break":"none","ruby":[[0,1,"おう"],[2,2,"めいれい"],[12,1,"ろ"],[21,1,"ねっ"],[48,1,"ひ"],[56,2,"ひとびと"],[62,2,"かえん"],[65,1,"や"],[67,1,"ころ"]],"text":"王の命令はきびしく、かつ炉は、はなはだしく熱していたので、シャデラク、メシャクおよびアベデネゴを引きつれていった人々は、その火炎に焼き殺された。"},{"ref":"Dan.3.23","start":27003023,"end":27003023,"break":"none","ruby":[[18,1,"にん"],[20,1,"しば"],[28,1,"ひ"],[30,1,"も"],[33,1,"ろ"],[35,1,"なか"],[37,1,"お"],[39,1,"こ"]],"text":"シャデラク、メシャク、アベデネゴの三人は縛られたままで、火の燃える炉の中に落ち込んだ。"},{"ref":"Dan.3.24","start":27003024,"end":27003024,"break":"paragraph","ruby":[[2,1,"とき"],[11,1,"おう"],[13,1,"おどろ"],[16,1,"いそ"],[18,1,"た"],[24,2,"だいじん"],[29,1,"い"],[42,1,"にん"],[44,1,"しば"],[48,1,"ひ"],[50,1,"なか"],[52,1,"な"],[54,1,"い"],[64,1,"かれ"],[67,1,"おう"],[69,1,"こた"],[72,1,"い"],[77,1,"おう"]],"text":"その時、ネブカデネザル王は驚いて急ぎ立ちあがり、大臣たちに言った、「われわれはあの三人を縛って、火の中に投げ入れたではないか」。彼らは王に答えて言った、「王よ、そのとおりです」。"},{"ref":"Dan.3.25","start":27003025,"end":27003025,"break":"none","ruby":[[0,1,"おう"],[2,1,"こた"],[5,1,"い"],[18,1,"み"],[23,1,"にん"],[25,1,"もの"],[34,1,"ひ"],[36,1,"なか"],[38,1,"ある"],[48,1,"がい"],[51,1,"う"],[60,1,"だい"],[63,1,"もの"],[65,2,"ようす"],[68,1,"かみ"],[70,1,"こ"]],"text":"王は答えて言った、「しかし、わたしの見るのに四人の者がなわめなしに、火の中を歩いているが、なんの害をも受けていない。その第四の者の様子は神の子のようだ」。"},{"ref":"Dan.3.26","start":27003026,"end":27003026,"break":"paragraph","ruby":[[14,1,"ひ"],[16,1,"も"],[19,1,"ろ"],[21,2,"いりぐち"],[24,2,"ちかよ"],[32,1,"たか"],[34,1,"かみ"],[57,1,"で"],[65,1,"い"],[90,1,"ひ"],[92,1,"なか"],[95,1,"で"]],"text":"そこでネブカデネザルは、その火の燃える炉の入口に近寄って、「いと高き神のしもべシャデラク、メシャク、アベデネゴよ、出てきなさい」と言ったので、シャデラク、メシャク、アベデネゴはその火の中から出てきた。"},{"ref":"Dan.3.27","start":27003027,"end":27003027,"break":"none","ruby":[[0,2,"そうとく"],[3,2,"ちょうかん"],[6,2,"ちじ"],[11,1,"おう"],[13,2,"だいじん"],[18,1,"あつ"],[27,2,"ひとびと"],[30,1,"み"],[34,1,"ひ"],[36,1,"かれ"],[39,1,"み"],[45,1,"ちから"],[52,1,"あたま"],[54,1,"け"],[56,1,"や"],[62,2,"がいとう"],[72,1,"ひ"],[81,1,"つ"]],"text":"総督、長官、知事および王の大臣たちも集まってきて、この人々を見たが、火は彼らの身にはなんの力もなく、その頭の毛は焼けず、その外套はそこなわれず、火のにおいもこれに付かなかった。"},{"ref":"Dan.3.28","start":27003028,"end":27003028,"break":"none","ruby":[[8,1,"い"],[30,1,"かみ"],[39,1,"かみ"],[43,2,"ししゃ"],[52,2,"じぶん"],[55,1,"よ"],[57,1,"たの"],[64,1,"すく"],[70,1,"かれ"],[73,2,"じぶん"],[76,1,"かみ"],[77,2,"いがい"],[80,1,"かみ"],[82,1,"つか"],[85,1,"おが"],[94,1,"おう"],[96,2,"めいれい"],[99,2,"むし"],[103,2,"じぶん"],[106,1,"み"],[109,1,"す"]],"text":"ネブカデネザルは言った、「シャデラク、メシャク、アベデネゴの神はほむべきかな。神はその使者をつかわして、自分に寄り頼むしもべらを救った。また彼らは自分の神以外の神に仕え、拝むよりも、むしろ王の命令を無視し、自分の身をも捨てようとしたのだ。"},{"ref":"Dan.3.29","start":27003029,"end":27003029,"break":"none","ruby":[[9,2,"めいれい"],[12,1,"くだ"],[15,2,"しょみん"],[18,1,"しょ"],[19,1,"ぞく"],[21,2,"しょこく"],[23,1,"ご"],[25,1,"もの"],[51,1,"かみ"],[57,1,"もの"],[67,1,"み"],[69,1,"き"],[71,1,"さ"],[77,1,"いえ"],[79,1,"ほろ"],[97,1,"すくい"],[99,1,"ほどこ"],[107,1,"かみ"]],"text":"それでわたしはいま命令を下す。諸民、諸族、諸国語の者のうちだれでも、シャデラク、メシャク、アベデネゴの神をののしる者があるならば、その身は切り裂かれ、その家は滅ぼされなければならない。このように救を施すことのできる神は、ほかにないからだ」。"},{"ref":"Dan.3.30","start":27003030,"end":27003030,"break":"none","ruby":[[5,1,"おう"],[26,1,"くらい"],[28,1,"すす"],[36,1,"しゅう"]],"text":"こうして、王はシャデラク、メシャクおよびアベデネゴの位を進めて、バビロン州におらせた。"}]