[{"ref":"Ps.12.1","start":19012001,"end":19012001,"break":"paragraph","title":"聖歌隊の指揮者によってシェミニテにあわせてうたわせたダビデの歌","breaks":[[20,"line"]],"ruby":[[0,1,"しゅ"],[4,1,"たす"],[11,1,"かみ"],[13,1,"うやま"],[15,1,"ひと"],[17,1,"た"],[20,2,"ちゅうしん"],[23,1,"もの"],[25,1,"ひと"],[27,1,"こ"],[34,1,"き"]],"titleRuby":[[0,2,"せいか"],[2,1,"たい"],[4,3,"しきしゃ"],[30,1,"うた"]],"text":"主よ、お助けください。神を敬う人は絶え、忠信な者は人の子らのなかから消えうせました。"},{"ref":"Ps.12.2","start":19012002,"end":19012002,"break":"line","breaks":[[16,"line"]],"ruby":[[0,1,"ひと"],[6,1,"とな"],[8,1,"びと"],[10,1,"いつわ"],[13,1,"かた"],[37,1,"かた"]],"text":"人はみなその隣り人に偽りを語り、へつらいのくちびると、ふたごころとをもって語る。"},{"ref":"Ps.12.3","start":19012003,"end":19012003,"break":"line","breaks":[[17,"line"]],"ruby":[[0,1,"しゅ"],[17,1,"おお"],[20,1,"こと"],[22,1,"かた"],[24,1,"した"],[27,1,"た"]],"text":"主はすべてのへつらいのくちびると、大きな事を語る舌とを断たれるように。"},{"ref":"Ps.12.4","start":19012004,"end":19012004,"break":"line","breaks":[[24,"line"],[45,"line"]],"ruby":[[0,1,"かれ"],[3,1,"い"],[13,1,"した"],[18,1,"かち"],[20,1,"え"],[54,2,"しゅじん"]],"text":"彼らは言う、「わたしたちは舌をもって勝を得よう、わたしたちのくちびるはわたしたちのものだ、だれがわたしたちの主人であるか」と。"},{"ref":"Ps.12.5","start":19012005,"end":19012005,"break":"line","breaks":[[19,"line"],[43,"line"]],"ruby":[[0,1,"しゅ"],[2,1,"い"],[8,1,"まず"],[11,1,"もの"],[19,1,"とぼ"],[22,1,"もの"],[24,1,"なげ"],[36,1,"た"],[43,1,"かれ"],[48,1,"した"],[50,1,"もと"],[53,2,"あんぜん"],[56,1,"ところ"],[58,1,"お"]],"text":"主は言われる、「貧しい者がかすめられ、乏しい者が嘆くゆえに、わたしはいま立ちあがって、彼らをその慕い求める安全な所に置こう」と。"},{"ref":"Ps.12.6","start":19012006,"end":19012006,"break":"line","breaks":[[14,"line"]],"ruby":[[0,1,"しゅ"],[6,1,"きよ"],[8,2,"ことば"],[14,1,"ち"],[16,1,"もう"],[19,1,"ろ"],[21,1,"ね"],[31,1,"ぎん"]],"text":"主のことばは清き言葉である。地に設けた炉で練り、七たびきよめた銀のようである。"},{"ref":"Ps.12.7","start":19012007,"end":19012007,"break":"line","breaks":[[10,"line"]],"ruby":[[0,1,"しゅ"],[7,1,"たも"],[17,2,"ひとびと"],[21,1,"まぬか"]],"text":"主よ、われらを保ち、とこしえにこの人々から免れさせてください。"},{"ref":"Ps.12.8","start":19012008,"end":19012008,"break":"line","breaks":[[22,"line"]],"ruby":[[0,1,"いや"],[3,1,"こと"],[5,1,"ひと"],[7,1,"こ"],[20,1,"とき"],[22,1,"あ"],[25,1,"もの"],[30,1,"ところ"],[38,1,"ある"]],"text":"卑しい事が人の子のなかにあがめられている時、悪しき者はいたる所でほしいままに歩いています。"}]